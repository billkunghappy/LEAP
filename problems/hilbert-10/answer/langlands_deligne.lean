                ξ m * IntermediateField.inclusion hM₁'K₁ s)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₂ := bE' - 1
    let m := a_lam - bE'
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let s := - e_Δ (p - 1)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let n := u_M₁' * b
    let W_fn : ℕ → E' := fun i =>
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
    let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
    let L_val := W_K₁ + IntermediateField.inclusion hM₁'K₁ b
    let D_norm := L_val ^ p - L_val
    let A_star := (Δ : K₁) - L_val
    L_val ≠ 0 ∧ D_norm ≠ 0 ∧
    valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ D_norm = -(((p * p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ A_star = -(((p * p * m : ℕ) : ℤ)) ∧
    (∀ m' < p,
      L_val + ξ m' ≠ 0 ∧ valL F K₁ (L_val + ξ m') = -(((p * p * m : ℕ) : ℤ))) ∧
    (∀ i ∈ Finset.Icc 1 (p - 1),
      let W_teich :=
        IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
            (∑ m' ∈ Finset.range p,
              ((Δ : K₁) + ξ m') ^ i * W_K₁ *
                (IntermediateField.inclusion hM₁'K₁ b + ξ m') *
                (L_val + ξ m')⁻¹) -
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
            IntermediateField.inclusion hM₁'K₁ (s * (1 + u_M₁' * b)⁻¹ ^ 2) *
            (∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ i)
      IntermediateField.inclusion hE'K₁ (W_fn i) - W_teich = 0 ∨
        ((1 + p * t₂ : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hE'K₁ (W_fn i) - W_teich)) :=
by
  intro p t₂ m b s u W z u_M₁' n W_fn W_K₁ L_val D_norm A_star
  obtain ⟨_, _, _, _, _, _, _, hvalK₁_add, _, _, _⟩ := ld_valL_and_unitGroup_props F K₁
  obtain ⟨hL_ne0, hD_ne0, hL_val, hD_val, hA_val, hL_xi_val,
      hW_ne0, hW_val, _, _, hΔ_xi_val, hwt_rew, hs_wt_rew, hfb_val⟩ :=
    ld_ch12_wild_odd_tot_ram_lval_and_rat_weight_identities F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hval_LE' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      Δ hΔ_val α γ hα_val hγ_val ξ hξ0 hξ_props
  obtain ⟨hf_conj_diff, hW_shift_teich⟩ :=
    ld_ch12_wild_odd_tot_ram_conj_norm_weight_perturbations_and_teich_sum F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hval_E'K₁ hval_M₁'K₁ Δ e_Δ he_Δ_val α γ w₂ hw₂_val
      ξ Δ_conj hξ0 hξ_props hΔ_conj_approx
      hL_ne0 hL_val hL_xi_val hW_ne0 hW_val hΔ_xi_val hwt_rew hs_wt_rew
  have hW_fn_shift :=
    ld_ch12_wild_odd_tot_ram_linear_conj_pow_to_shifted_sum F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_E'K₁ Δ hΔ_val hΔ_tr_top e_Δ α γ w₂ hw₂_val
      ξ Δ_conj hξ0 hξ_props hξ_pow_sum hΔ_conj_val
      hW_conj_sum hTr_top_conj_sum hΔ_conj_approx
      hΔ_xi_val hfb_val hf_conj_diff
  refine ⟨hL_ne0, hD_ne0, hL_val, hD_val, hA_val, hL_xi_val, ?_⟩
  intro i hi W_teich
  have h1 := hW_fn_shift i hi
  have h2 := hW_shift_teich i hi
  dsimp only at h1 h2
  set f_conj : ℕ → K₁ := fun m' =>
    IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m')) *
      (IntermediateField.inclusion hM₁'K₁ (1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m')))⁻¹
  set W_shift :=
    ∑ m' ∈ Finset.range p,
      IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
        ((Δ : K₁) + ξ m') ^ i * f_conj m'
  have hrew : IntermediateField.inclusion hE'K₁ (W_fn i) - W_teich =
      (IntermediateField.inclusion hE'K₁ (W_fn i) - W_shift) + (W_shift - W_teich) := by
    ring
  rw [hrew]
  exact hvalK₁_add ((1 + p * t₂ : ℕ) : ℤ) _ _ h1 h2

theorem ld_ch12_wild_odd_tot_ram_diamond_power_basis_and_trace_compat (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (ϖ_E' : E'ˣ) (hϖ_E' : valL F E' (ϖ_E' : E') = 1) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p ∧
    (E' ≤ M₁' → ∀ y : E',
      IntermediateField.inclusion hM₁'K₁ (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y)) =
        ((p : ℕ) : K₁) * IntermediateField.inclusion hE'K₁ y) ∧
    (¬ (E' ≤ M₁') →
      (∀ y : E',
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hLM₁' (traceLM F hLE' y)) ∧
      (∀ w : K₁, ∃ z : Fin p → M₁',
        w = ∑ k : Fin p,
          IntermediateField.inclusion hE'K₁ (((ϖ_E' : E') ^ (k : ℕ))) *
            IntermediateField.inclusion hM₁'K₁ (z k))) :=
by
  intro p
  have hPrimePowerBasis : ∀ (p₀ : ℕ), Nat.Prime p₀ →
      ∀ (K₀ L₀ : Type u) [Field K₀] [Field L₀] [Algebra K₀ L₀]
        [FiniteDimensional K₀ L₀] (α₀ : L₀),
        Module.finrank K₀ L₀ = p₀ →
        (∀ z₀ : K₀, algebraMap K₀ L₀ z₀ ≠ α₀) →
        LinearIndependent K₀ (fun k : Fin p₀ => α₀ ^ (k : ℕ)) := by
    clear p hPrime hval_LE' hval_M₁'K₁ hval_norm_M₁'K₁ hϖ_E' ϖ_E'
      hLE' hLM₁' hE'K₁ hM₁'K₁
      ‹FiniteDimensional F K₁› ‹FiniteDimensional F M₁'›
      ‹FiniteDimensional F E'› ‹FiniteDimensional F L›
      K₁ M₁' E' L
      ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F› ‹Field F› F
    intro p₀ hPrime₀ K₀ L₀ _ _ _ _ α₀ hdeg₀ hα₀_not_alg
    let F_α : IntermediateField K₀ L₀ := IntermediateField.adjoin K₀ ({α₀} : Set L₀)
    have hα_not_bot : α₀ ∉ (⊥ : IntermediateField K₀ L₀) := by
      intro hbot
      rcases IntermediateField.mem_bot.mp hbot with ⟨z₀, hz₀⟩
      exact hα₀_not_alg z₀ hz₀
    have hF_α_ne_bot : F_α ≠ ⊥ := by
      intro heq
      apply hα_not_bot
      rw [← heq]
      exact IntermediateField.mem_adjoin_simple_self K₀ α₀
    have hfinrank_ne1 : Module.finrank K₀ ↥F_α ≠ 1 := by
      intro h1
      have hbot_eq : (⊥ : IntermediateField K₀ L₀) = F_α := by
        apply IntermediateField.eq_of_le_of_finrank_le bot_le
        rw [h1, IntermediateField.finrank_bot]
      exact hF_α_ne_bot hbot_eq.symm
    have hdvd_p : Module.finrank K₀ ↥F_α ∣ p₀ := by
      refine ⟨Module.finrank ↥F_α L₀, ?_⟩
      rw [← hdeg₀, ← Module.finrank_mul_finrank K₀ ↥F_α L₀]
    have hfinrank_F_α : Module.finrank K₀ ↥F_α = p₀ :=
      (hPrime₀.eq_one_or_self_of_dvd _ hdvd_p).resolve_left hfinrank_ne1
    have hint : IsIntegral K₀ α₀ := Algebra.IsIntegral.isIntegral α₀
    let PB := IntermediateField.adjoin.powerBasis hint
    have hPB_dim : PB.dim = p₀ := by
      rw [IntermediateField.adjoin.powerBasis_dim hint, ← IntermediateField.adjoin.finrank hint]
      exact hfinrank_F_α
    let e_dim : Fin PB.dim ≃ Fin p₀ := (Fin.castOrderIso hPB_dim).toEquiv
    let B_Fα : Module.Basis (Fin p₀) K₀ ↥F_α := PB.basis.reindex e_dim
    have hBFα_val : ∀ k : Fin p₀, (B_Fα k : L₀) = α₀ ^ (k : ℕ) := by
      intro k
      dsimp [B_Fα]
      rw [Module.Basis.reindex_apply, PB.basis_eq_pow]
      have hgen : F_α.val PB.gen = α₀ := by
        rw [IntermediateField.adjoin.powerBasis_gen hint]
        rfl
      have hexp : ((e_dim.symm k : Fin PB.dim) : ℕ) = (k : ℕ) := rfl
      change F_α.val (PB.gen ^ ((e_dim.symm k : Fin PB.dim) : ℕ)) = α₀ ^ (k : ℕ)
      rw [map_pow, hgen, hexp]
    rw [Fintype.linearIndependent_iff]
    intro d hd
    have hsum_Fα : (∑ k : Fin p₀, d k • B_Fα k) = 0 := by
      apply Subtype.ext
      have h1 : F_α.val (∑ k : Fin p₀, d k • B_Fα k) = ∑ k : Fin p₀, d k • (α₀ ^ (k : ℕ)) := by
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro k _
        change d k • (B_Fα k : L₀) = d k • (α₀ ^ (k : ℕ))
        rw [hBFα_val k]
      change F_α.val (∑ k : Fin p₀, d k • B_Fα k) = 0
      rw [h1, hd]
    exact Fintype.linearIndependent_iff.mp B_Fα.linearIndependent d hsum_Fα

  set S_LE' := IntermediateField.extendScalars hLE'
  set S_M₁'K₁ := IntermediateField.extendScalars hM₁'K₁
  have hp_pos : 0 < p := hPrime.pos

  have hval_field : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 1 = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) := by
    intro M _
    have halg : ∀ z : M,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F M = (minpoly F z).natDegree * m := by
      clear hval_LE' hval_M₁'K₁ hval_norm_M₁'K₁ hϖ_E'
        ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq M.val M.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F M (-1) = 0 := by
      have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F M ((-1 : M) * (-1 : M)) = relVal F M (-1) + relVal F M (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : M) * (-1 : M) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : M, relVal F M (-x) = relVal F M x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : M) = (-1 : M) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul : relVal F M ((u : M) * ((u⁻¹ : Mˣ) : M)) =
          relVal F M (u : M) + relVal F M ((u⁻¹ : Mˣ) : M) :=
        hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : M := algebraMap F M π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F M x₀ = (Module.finrank F M : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F M := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F M, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖ₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    have hdiv : ∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F M : ℤ)
        set q : ℤ := valL F M x
        set r : ℤ := relVal F M x % f
        have hediv : f * q + r = relVal F M x := Int.mul_ediv_add_emod (relVal F M x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M x) hfM_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M x) hfM_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          let y : M := x * (((ϖM ^ (-q) : Mˣ) : M))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F M y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q), hrel_ϖM]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F M := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval1 : valL F M 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg : ∀ x : M, valL F M (-x) = valL F M x := by
      intro x
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_surj : ∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m := by
      intro m
      refine ⟨ϖM ^ m, ?_⟩
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv, hrel_zpow ϖM m, hrel_ϖM, mul_comm]
    have hval_add : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : M,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : M, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F M z ≤ valL F M w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F M) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfM_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : M) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F M x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F M y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    exact ⟨hval1, hval_neg, hval_mul, hval_surj, hval_add⟩

  let e_LE' : E' ≃ₐ[F] S_LE' :=
    { toExtendScalars F hLE' with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE').mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F S_LE' := Module.Finite.equiv e_LE'.toLinearEquiv
  haveI : IsScalarTower F L S_LE' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L S_LE' := Module.Finite.of_restrictScalars_finite F L S_LE'

  let e_M₁'K₁ : K₁ ≃ₐ[F] S_M₁'K₁ :=
    { toExtendScalars F hM₁'K₁ with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hM₁'K₁).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F S_M₁'K₁ := Module.Finite.equiv e_M₁'K₁.toLinearEquiv
  haveI : IsScalarTower F M₁' S_M₁'K₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M₁' S_M₁'K₁ := Module.Finite.of_restrictScalars_finite F M₁' S_M₁'K₁

  obtain ⟨hval1_M₁', _, hval_mul_M₁', hval_surj_M₁', _⟩ := hval_field M₁'
  obtain ⟨hval1_E', hval_neg_E', hval_mul_E', _, hval_add_E'⟩ := hval_field E'

  have hval_pow_M₁' : ∀ (z : M₁') (n : ℕ), z ≠ 0 → valL F M₁' (z ^ n) = (n : ℤ) * valL F M₁' z := by
    intro z n hz
    induction n with
    | zero => simp [hval1_M₁']
    | succ n ih =>
      rw [pow_succ, hval_mul_M₁' (z ^ n) z (pow_ne_zero n hz) hz, ih]
      push_cast
      ring

  have hval_pow_E' : ∀ (y : E') (n : ℕ), y ≠ 0 → valL F E' (y ^ n) = (n : ℤ) * valL F E' y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_E']
    | succ n ih =>
      rw [pow_succ, hval_mul_E' (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring

  have hdeg_M₁'K₁ : Module.finrank M₁' S_M₁'K₁ = p := by
    obtain ⟨c, hc⟩ := hval_surj_M₁' 1
    set d := Module.finrank M₁' S_M₁'K₁
    have hnorm_c : normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ (c : M₁')) = (c : M₁') ^ d := by
      change Algebra.norm M₁' (algebraMap M₁' S_M₁'K₁ (c : M₁')) = (c : M₁') ^ d
      exact Algebra.norm_algebraMap (c : M₁')
    have hval_lhs : valL F M₁' (normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ (c : M₁'))) = (p : ℤ) := by
      rw [hval_norm_M₁'K₁, hval_M₁'K₁, hc, mul_one]
    have hval_rhs : valL F M₁' ((c : M₁') ^ d) = (d : ℤ) := by
      rw [hval_pow_M₁' (c : M₁') d (Units.ne_zero c), hc, mul_one]
    have heq_int : (d : ℤ) = (p : ℤ) := by
      rw [← hval_rhs, ← hnorm_c, hval_lhs]
    exact Nat.cast_injective heq_int

  have hLeCase : E' ≤ M₁' → ∀ y : E',
      IntermediateField.inclusion hM₁'K₁ (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y)) =
        ((p : ℕ) : K₁) * IntermediateField.inclusion hE'K₁ y := by
    intro hE'M₁' y
    let z : M₁' := IntermediateField.inclusion hE'M₁' y
    have hyz : IntermediateField.inclusion hE'K₁ y = IntermediateField.inclusion hM₁'K₁ z :=
      Subtype.ext rfl
    have htr_z : traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ z) = ((p : ℕ) : M₁') * z := by
      change Algebra.trace M₁' S_M₁'K₁ (algebraMap M₁' S_M₁'K₁ z) = ((p : ℕ) : M₁') * z
      rw [Algebra.trace_algebraMap z, hdeg_M₁'K₁, nsmul_eq_mul]
    rw [hyz, htr_z, map_mul, map_natCast]

  have hval_strict_E' : ∀ (y₁ y₂ : E'),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F E' y₁ + 1 ≤ valL F E' y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F E' (y₁ + y₂) = valL F E' y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F E' y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F E' y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F E' (y₁ + y₂) :=
      hval_add_E' v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F E' (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F E' (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_E']
          exact hge
      have hy₁_gt := hval_add_E' (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F E' (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F E' (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  let t_term (c : Fin p → L) (i : Fin p) : E' :=
    IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ))
  let v_term (c : Fin p → L) (i : Fin p) : ℤ :=
    (p : ℤ) * valL F L (c i) + (i.1 : ℤ)

  have ht_term_zero : ∀ (c : Fin p → L) (i : Fin p), c i = 0 → t_term c i = 0 := by
    intro c i hci
    dsimp [t_term]
    rw [hci, map_zero, zero_mul]

  have ht_term_nz : ∀ (c : Fin p → L) (i : Fin p),
      c i ≠ 0 → t_term c i ≠ 0 ∧ valL F E' (t_term c i) = v_term c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hLE' (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hLE').toRingHom).ne hci
    have hpow_ne : ((ϖ_E' : E') ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_E')
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term, v_term]
    rw [hval_mul_E' _ _ hinc_ne hpow_ne, hval_LE' (c i),
      hval_pow_E' (ϖ_E' : E') (i : ℕ) (Units.ne_zero ϖ_E'), hϖ_E', mul_one]

  have hv_term_inj : ∀ (c : Fin p → L) (i j : Fin p),
      v_term c i = v_term c j → i = j := by
    intro c i j hij
    have hmod : ∀ k : Fin p, v_term c k % (p : ℤ) = (k.1 : ℤ) := by
      intro k
      dsimp [v_term]
      have hcomm : (p : ℤ) * valL F L (c k) + (k.1 : ℤ) =
          (k.1 : ℤ) + (p : ℤ) * valL F L (c k) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_ge : ∀ (c : Fin p → L) (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term c i) →
        ((∑ i ∈ S, t_term c i) = 0 ∨ m ≤ valL F E' (∑ i ∈ S, t_term c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term c a = 0 ∨ m ≤ valL F E' (t_term c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_zero c a hca)
        · right
          rw [(ht_term_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_E' m (t_term c a) (∑ i ∈ s, t_term c i) ha_t hs_t

  have hsum_min_nz : ∀ (c : Fin p → L) (i : Fin p),
      c i ≠ 0 →
        ∃ i₀ : Fin p, c i₀ ≠ 0 ∧ v_term c i₀ ≤ v_term c i ∧
          (∑ j : Fin p, t_term c j) ≠ 0 ∧
          valL F E' (∑ j : Fin p, t_term c j) = v_term c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin p) := (Finset.univ : Finset (Fin p)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term c i₀ ≤ v_term c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
        c j = 0 ∨ v_term c i₀ + 1 ≤ v_term c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term c i₀ ≤ v_term c j := hi₀_min j hj_mem
        have hne_v : v_term c i₀ ≠ v_term c j := fun heq => hj_ne (hv_term_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_ge c ((Finset.univ : Finset (Fin p)).erase i₀)
      (v_term c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_E' (t_term c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hlin_zero : ∀ (c : Fin p → L),
      (∑ i : Fin p, t_term c i) = 0 → ∀ i : Fin p, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_nz c i hci
    exact hsum_ne hsum0

  let b_E' : Fin p → S_LE' := fun i => (toExtendScalars F hLE' (ϖ_E' : E')) ^ (i : ℕ)
  have hli_E' : LinearIndependent L b_E' := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hLE' (∑ i : Fin p, t_term c i) =
        ∑ i : Fin p, c i • b_E' i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term, b_E']
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin p, t_term c i) = 0 := by
      apply e_LE'.injective
      change toExtendScalars F hLE' (∑ i : Fin p, t_term c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero c hsum0

  haveI : Nonempty (Fin p) := ⟨⟨0, hp_pos⟩⟩
  have hcard_E' : Fintype.card (Fin p) = Module.finrank L S_LE' := Fintype.card_fin p
  let B_E' : Module.Basis (Fin p) L S_LE' :=
    basisOfLinearIndependentOfCardEqFinrank hli_E' hcard_E'

  have hBasis_E' : ∀ y : E', ∃ c : Fin p → L,
      y = ∑ i : Fin p, t_term c i := by
    intro y
    let c : Fin p → L := fun i => B_E'.repr (toExtendScalars F hLE' y) i
    refine ⟨c, ?_⟩
    apply e_LE'.injective
    change toExtendScalars F hLE' y = toExtendScalars F hLE' (∑ i : Fin p, t_term c i)
    have hrepr := (B_E'.sum_repr (toExtendScalars F hLE' y)).symm
    rw [hrepr, map_sum]
    apply Finset.sum_congr rfl
    intro i _
    dsimp [B_E', c, t_term, b_E']
    rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_E' hcard_E', map_mul, map_pow]
    rfl

  refine ⟨hdeg_M₁'K₁, hLeCase, ?_⟩
  intro hnot
  have hϖ_not_mem : (ϖ_E' : E').1 ∉ M₁' := by
    intro hϖM
    apply hnot
    intro x hx
    let y : E' := ⟨x, hx⟩
    obtain ⟨c, hy_eq⟩ := hBasis_E' y
    have hx_eq : x = ∑ i : Fin p, (c i).1 * ((ϖ_E' : E').1 ^ (i : ℕ)) := by
      have h1 : y.1 = (∑ i : Fin p, t_term c i).1 := congrArg Subtype.val hy_eq
      change x = E'.val (∑ i : Fin p, t_term c i) at h1
      rw [map_sum] at h1
      exact h1
    rw [hx_eq]
    apply M₁'.sum_mem
    intro i _
    exact M₁'.mul_mem (hLM₁' (c i).2) (pow_mem hϖM (i : ℕ))

  let α : S_M₁'K₁ := toExtendScalars F hM₁'K₁ (IntermediateField.inclusion hE'K₁ (ϖ_E' : E'))
  let b_K₁ : Fin p → S_M₁'K₁ := fun k => α ^ (k : ℕ)
  have hli_K₁ : LinearIndependent M₁' b_K₁ := by
    apply hPrimePowerBasis p hPrime M₁' S_M₁'K₁ α hdeg_M₁'K₁
    intro z₀ hz₀
    have hval_eq : z₀.1 = (ϖ_E' : E').1 := congrArg Subtype.val hz₀
    exact hϖ_not_mem (hval_eq ▸ z₀.2)

  have hcard_K₁ : Fintype.card (Fin p) = Module.finrank M₁' S_M₁'K₁ :=
    (Fintype.card_fin p).trans hdeg_M₁'K₁.symm
  let B_K₁ : Module.Basis (Fin p) M₁' S_M₁'K₁ :=
    basisOfLinearIndependentOfCardEqFinrank hli_K₁ hcard_K₁

  refine ⟨?_, ?_⟩
  · intro y
    let y_E' : S_LE' := toExtendScalars F hLE' y
    let y_K₁ : S_M₁'K₁ := toExtendScalars F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y)
    have hrepr_eq : ∀ (k i : Fin p),
        B_K₁.repr (y_K₁ * B_K₁ k) i =
          IntermediateField.inclusion hLM₁' (B_E'.repr (y_E' * B_E' k) i) := by
      intro k i
      let c_k : Fin p → L := fun j => B_E'.repr (y_E' * B_E' k) j
      let d_k : Fin p → M₁' := fun j => IntermediateField.inclusion hLM₁' (c_k j)
      have hyE'_sum : y_E' * B_E' k = ∑ j : Fin p, c_k j • B_E' j :=
        (B_E'.sum_repr (y_E' * B_E' k)).symm
      have hyE'_val : (y_E' * B_E' k).1 =
          ∑ j : Fin p, (c_k j).1 * (B_E' j).1 := by
        have h1 : S_LE'.val (y_E' * B_E' k) = S_LE'.val (∑ j : Fin p, c_k j • B_E' j) :=
          congrArg S_LE'.val hyE'_sum
        rw [map_sum] at h1
        exact h1
      have hyK₁_sum : y_K₁ * B_K₁ k = B_K₁.equivFun.symm d_k := by
        rw [B_K₁.equivFun_symm_apply]
        apply Subtype.ext
        have h2 : (∑ j : Fin p, d_k j • B_K₁ j).1 =
            ∑ j : Fin p, (d_k j).1 * (B_K₁ j).1 := by
          change S_M₁'K₁.val (∑ j : Fin p, d_k j • B_K₁ j) = _
          rw [map_sum]
          rfl
        rw [h2]
        have hB_E'_k : (B_E' k).1 = ((ϖ_E' : E').1 ^ (k : ℕ)) := by
          dsimp [B_E']
          rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_E' hcard_E']
          rfl
        have hB_K₁_k : (B_K₁ k).1 = ((ϖ_E' : E').1 ^ (k : ℕ)) := by
          dsimp [B_K₁]
          rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K₁ hcard_K₁]
          rfl
        have h_lhs : (y_K₁ * B_K₁ k).1 = (y_E' * B_E' k).1 := by
          change y.1 * (B_K₁ k).1 = y.1 * (B_E' k).1
          rw [hB_K₁_k, hB_E'_k]
        rw [h_lhs, hyE'_val]
        apply Finset.sum_congr rfl
        intro j _
        have hB_E'_j : (B_E' j).1 = ((ϖ_E' : E').1 ^ (j : ℕ)) := by
          dsimp [B_E']
          rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_E' hcard_E']
          rfl
        have hB_K₁_j : (B_K₁ j).1 = ((ϖ_E' : E').1 ^ (j : ℕ)) := by
          dsimp [B_K₁]
          rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K₁ hcard_K₁]
          rfl
        change (c_k j).1 * (B_E' j).1 = (c_k j).1 * (B_K₁ j).1
        rw [hB_E'_j, hB_K₁_j]
      have h_equiv : B_K₁.equivFun (y_K₁ * B_K₁ k) = d_k := by
        rw [hyK₁_sum, LinearEquiv.apply_symm_apply]
      have h_apply := congrFun h_equiv i
      rw [B_K₁.equivFun_apply] at h_apply
      exact h_apply
    change Algebra.trace M₁' S_M₁'K₁ y_K₁ =
      IntermediateField.inclusion hLM₁' (Algebra.trace L S_LE' y_E')
    rw [Algebra.trace_eq_matrix_trace B_K₁, Algebra.trace_eq_matrix_trace B_E']
    simp only [Matrix.trace, Matrix.diag, map_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul]
    exact hrepr_eq i i
  · intro w
    let z : Fin p → M₁' := fun k => B_K₁.repr (toExtendScalars F hM₁'K₁ w) k
    refine ⟨z, ?_⟩
    apply e_M₁'K₁.injective
    change toExtendScalars F hM₁'K₁ w =
      toExtendScalars F hM₁'K₁
        (∑ k : Fin p,
          IntermediateField.inclusion hE'K₁ (((ϖ_E' : E') ^ (k : ℕ))) *
            IntermediateField.inclusion hM₁'K₁ (z k))
    have hrepr := (B_K₁.sum_repr (toExtendScalars F hM₁'K₁ w)).symm
    rw [hrepr, map_sum]
    apply Finset.sum_congr rfl
    intro k _
    dsimp [B_K₁]
    rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K₁ hcard_K₁]
    apply Subtype.ext
    change (z k).1 * ((ϖ_E' : E').1 ^ (k : ℕ)) = ((ϖ_E' : E').1 ^ (k : ℕ)) * (z k).1
    exact mul_comm _ _

theorem ld_ch12_wild_odd_tot_ram_ultrametric_gram_schmidt_orthogonalization (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (p : ℕ) (hp_pos : 0 < p)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) = (p : ℤ) * valL F L x)
    (n : ℕ) (z : Fin n → M₁') (M_cap : ℤ) :
    ∃ (w : Fin n → M₁') (c : Fin n → Fin n → L) (r : Fin n → M₁'),
      (∀ k : Fin n,
        z k = (∑ j : Fin n, IntermediateField.inclusion hLM₁' (c k j) * w j) + r k) ∧
      (∀ k : Fin n, r k = 0 ∨ M_cap ≤ valL F M₁' (r k)) ∧
      (∀ (a : Fin n → L) (B : ℤ),
        ((∑ j : Fin n, IntermediateField.inclusion hLM₁' (a j) * w j) = 0 ∨
          B ≤ valL F M₁' (∑ j : Fin n, IntermediateField.inclusion hLM₁' (a j) * w j)) →
        ∀ j : Fin n,
          a j = 0 ∨ w j = 0 ∨ B ≤ (p : ℤ) * valL F L (a j) + valL F M₁' (w j)) :=
by
  have halg : ∀ z : M₁',
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F M₁' = (minpoly F z).natDegree * m := by
    clear hval_LM₁' ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq M₁'.val M₁'.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  have hrel0 : relVal F M₁' 0 = 0 := by
    unfold relVal
    rw [Algebra.norm_zero, haddVal0]
  have hrel1 : relVal F M₁' 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x y : M₁', x ≠ 0 → y ≠ 0 → relVal F M₁' (x * y) = relVal F M₁' x + relVal F M₁' y := by
    intro x y hx hy
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ hnx hny]
  have hrel_neg1 : relVal F M₁' (-1) = 0 := by
    have hne : (-1 : M₁') ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hsq : relVal F M₁' ((-1 : M₁') * (-1 : M₁')) = relVal F M₁' (-1) + relVal F M₁' (-1) :=
      hrel_mul (-1) (-1) hne hne
    have h1 : (-1 : M₁') * (-1 : M₁') = 1 := by ring
    rw [h1, hrel1] at hsq
    omega
  have hrel_neg : ∀ x : M₁', relVal F M₁' (-x) = relVal F M₁' x := by
    intro x
    by_cases hx : x = 0
    · simp [hx]
    · have hne1 : (-1 : M₁') ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hneg_eq : (-x : M₁') = (-1 : M₁') * x := by ring
      rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
  have hrel_inv : ∀ u : M₁'ˣ, relVal F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - relVal F M₁' (u : M₁') := by
    intro u
    have hmul : relVal F M₁' ((u : M₁') * ((u⁻¹ : M₁'ˣ) : M₁')) =
        relVal F M₁' (u : M₁') + relVal F M₁' ((u⁻¹ : M₁'ˣ) : M₁') :=
      hrel_mul (u : M₁') ((u⁻¹ : M₁'ˣ) : M₁') (Units.ne_zero u) (Units.ne_zero u⁻¹)
    rw [Units.mul_inv, hrel1] at hmul
    omega
  have hrel_pow : ∀ (u : M₁'ˣ) (n : ℕ),
      relVal F M₁' (((u ^ n : M₁'ˣ) : M₁')) = (n : ℤ) * relVal F M₁' (u : M₁') := by
    intro u n
    induction n with
    | zero =>
      simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hrel_zpow : ∀ (u : M₁'ˣ) (m : ℤ),
      relVal F M₁' (((u ^ m : M₁'ˣ) : M₁')) = m * relVal F M₁' (u : M₁') := by
    intro u m
    cases m with
    | ofNat n =>
      change relVal F M₁' (((u ^ (n : ℤ) : M₁'ˣ) : M₁')) = (n : ℤ) * relVal F M₁' (u : M₁')
      rw [zpow_natCast, hrel_pow]
    | negSucc n =>
      rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
      push_cast
      ring
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : M₁' := algebraMap F M₁' π
  have hx₀_ne : x₀ ≠ 0 := by
    simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F M₁' x₀ = (Module.finrank F M₁' : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M₁') hπ_ne, hadd_π, mul_one]
  have hfin_pos : 0 < Module.finrank F M₁' := Module.finrank_pos
  let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M₁', x ≠ 0 ∧ relVal F M₁' x = k}
  have hS_nonempty : S.Nonempty := ⟨Module.finrank F M₁', hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfL_mem : resDeg F M₁' ∈ S := Nat.sInf_mem hS_nonempty
  obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
  let ϖL : M₁'ˣ := Units.mk0 ϖ₀ hϖ₀_ne
  have hrel_ϖL : relVal F M₁' (ϖL : M₁') = (resDeg F M₁' : ℤ) := hrel_ϖ₀
  have hfL_int_pos : (0 : ℤ) < (resDeg F M₁' : ℤ) := Nat.cast_pos.mpr hfL_pos
  have hfL_int_ne : (resDeg F M₁' : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
  have hdiv : ∀ x : M₁', relVal F M₁' x = (resDeg F M₁' : ℤ) * valL F M₁' x := by
    intro x
    by_cases hx : x = 0
    · unfold valL
      rw [hx, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M₁' : ℤ)
      set q : ℤ := valL F M₁' x
      set r : ℤ := relVal F M₁' x % f
      have hediv : f * q + r = relVal F M₁' x := Int.mul_ediv_add_emod (relVal F M₁' x) f
      have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M₁' x) hfL_int_ne
      have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M₁' x) hfL_int_pos
      have hr_zero : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
        let y : M₁' := x * (((ϖL ^ (-q) : M₁'ˣ) : M₁'))
        have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
        have hrel_y : relVal F M₁' y = r := by
          dsimp [y]
          rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
          linarith
        let k : ℕ := r.toNat
        have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M₁' := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M₁' ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  have hval_neg_M₁' : ∀ x : M₁', valL F M₁' (-x) = valL F M₁' x := by
    intro x
    apply mul_left_cancel₀ hfL_int_ne
    rw [← hdiv (-x), ← hdiv x, hrel_neg]
  have hval_mul_M₁' : ∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y := by
    intro x y hx hy
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
  have hval_add_M₁' : ∀ (k : ℤ) (x y : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x + y = 0 ∨ k ≤ valL F M₁' (x + y)) := by
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
      Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
    have hspec_pow : ∀ z : M₁',
        (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M₁') =
          ‖Algebra.norm F z‖ := by
      intro z
      obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
      have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
          ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
        rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
      have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
        rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
        exact_mod_cast minpoly.natDegree_pos hz
      rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
         ← Real.rpow_natCast]
      congr 1
      push_cast
      rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
