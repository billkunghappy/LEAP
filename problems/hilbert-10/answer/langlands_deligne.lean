      have hCancelU : tateEps F U 1 ψU * tateEps F L νU ψ ≠ 0 :=
        mul_ne_zero hEpsU1_ne0 hEpsνU_ne0
      apply mul_right_cancel₀ hCancelU
      calc (tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ * tateEps F L νE ψ) *
            (tateEps F U 1 ψU * tateEps F L νU ψ)
        _ = (tateEps F E χE' ψE * tateEps F U 1 ψU * tateEps F L νE ψ) *
              (tateEps F M₁ 1 ψM₁ * tateEps F L νU ψ) := by ring
        _ = (tateEps F U χU' ψU * tateEps F E 1 ψE * tateEps F L νU ψ) *
              (tateEps F M₁ 1 ψM₁ * tateEps F L νU ψ) := by
            rw [hRed_EU]
        _ = (tateEps F U χU' ψU * tateEps F M₁ 1 ψM₁ * tateEps F L νU ψ) *
              (tateEps F E 1 ψE * tateEps F L νU ψ) := by ring
        _ = (tateEps F M₁ χM₁' ψM₁ * tateEps F U 1 ψU * tateEps F L νM₁ ψ) *
              (tateEps F E 1 ψE * tateEps F L νU ψ) := by
            rw [← hRed_M₁U]
        _ = (tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE * tateEps F L νM₁ ψ) *
              (tateEps F U 1 ψU * tateEps F L νU ψ) := by ring
  calc tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ)
    _ = (tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ * tateEps F L νE ψ) *
          tateEps F L 1 ψ := by
        rw [hProdE]
        ring
    _ = (tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE * tateEps F L νM₁ ψ) *
          tateEps F L 1 ψ := by
        rw [hRed_EM₁]
    _ = tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) := by
        rw [hProdM₁]
        ring

theorem ld_ch12_wild_dyadic_biquadratic_trace_norm_and_missing_coset (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    (∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y)) ∧
    (∀ (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F L] [FiniteDimensional F E']
      [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
      (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁),
      IsGaloisExt F L K₁ →
      IsGaloisExt F L E' → IsGaloisExt F L M₁' →
      IsGaloisExt F E' K₁ → IsGaloisExt F M₁' K₁ →
      Module.finrank L (IntermediateField.extendScalars hLE') = 2 →
      Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 →
      Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 →
      Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 →
      E' ⊓ M₁' = L → E' ⊔ M₁' = K₁ →
      (∀ C : K₁,
        traceLM F hLE' (normLM F hE'K₁ C) + normLM F hLE' (traceLM F hE'K₁ C) =
          traceLM F hLM₁' (normLM F hM₁'K₁ C) + normLM F hLM₁' (traceLM F hM₁'K₁ C)) ∧
      (∀ (ψ : AddChar L (Ω F)) (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ)
        (νE' νM₁' : Lˣ →* (Ω F)ˣ),
        (∀ y : Lˣ, y ∈ Set.range (Units.map (normLM F hLE')) → νE' y = 1) →
        (∀ z : Lˣ, z ∈ Set.range (Units.map (normLM F hLM₁')) → νM₁' z = 1) →
        θE'.comp (Units.map (normLM F hE'K₁)) = θM₁'.comp (Units.map (normLM F hM₁'K₁)) →
        (∀ x : Lˣ,
          θE' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) * νE' x =
            θM₁' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) * νM₁' x) →
        ∀ (α : Lˣ) (C : K₁ˣ)
          (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0)
          (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0),
          let ψE' := traceChar F hLE' ψ
          let ψM₁' := traceChar F hLM₁' ψ
          let cE' : E'ˣ :=
            Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
              (Units.map (normLM F hE'K₁) C)⁻¹
          let cνE' : Lˣ :=
            α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹
          let cM₁' : M₁'ˣ :=
            Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
              (Units.map (normLM F hM₁'K₁) C)⁻¹
          let cνM₁' : Lˣ :=
            α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹
          (θE' cE' : Ω F) * (νE' cνE' : Ω F) *
              ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L)) =
            (θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
              ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)) ∧
          ∀ (C' : K₁ˣ)
            (htE'' : traceLM F hE'K₁ (C' : K₁) ≠ 0)
            (htM₁'' : traceLM F hM₁'K₁ (C' : K₁) ≠ 0),
            let uE' : E'ˣ := Units.map (normLM F hE'K₁) (C' * C⁻¹)
            let wE' : Lˣ :=
              Units.map (normLM F hLE')
                (Units.mk0 (traceLM F hE'K₁ (C' : K₁)) htE'' *
                  (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE')⁻¹)
            let uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) (C' * C⁻¹)
            let wM₁' : Lˣ :=
              Units.map (normLM F hLM₁')
                (Units.mk0 (traceLM F hM₁'K₁ (C' : K₁)) htM₁'' *
                  (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁')⁻¹)
            (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) *
                (νE' wE' : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
              (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) *
                (νM₁' wM₁' : Ω F)⁻¹ * ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)))) ∧
    (∀ (k_L : Type u) [Field k_L] [Fintype k_L],
      (2 : k_L) = 0 →
      ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
      ∀ (d₁ d₂ a₁ a₂ : k_L), d₁ ≠ 0 → d₂ ≠ 0 → a₁ ≠ 0 → a₂ ≠ 0 → a₁ ≠ a₂ →
      ∀ (p₁ p₂ : k_L →+ k_L) (H₁ H₂ Q : k_L → Ω F),
        (∀ z : k_L, p₁ z = 0 ↔ (z = 0 ∨ z = a₁)) →
        (∀ z : k_L, p₂ z = 0 ↔ (z = 0 ∨ z = a₂)) →
        H₁ 0 = 1 → H₂ 0 = 1 →
        (∀ x y : k_L, H₁ (x + y) = H₁ x * H₁ y * ψ₀ (d₁ * x * y)) →
        (∀ x y : k_L, H₂ (x + y) = H₂ x * H₂ y * ψ₀ (d₂ * x * y)) →
        (∀ z : k_L, H₁ (p₁ z) = Q z) →
        (∀ z : k_L, H₂ (p₂ z) = Q z) →
        (∑ x : k_L, H₁ x) = (∑ x : k_L, H₂ x)) :=
by
  refine ⟨?_, ?_, ?_⟩
  · have hQuad_gen : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L],
        Module.finrank K L = 2 →
        (∀ x : K, Algebra.trace K L (algebraMap K L x) = (2 : K) * x) ∧
        (∀ (x : K) (y : L),
          Algebra.norm K (algebraMap K L x + y) =
            x ^ 2 + x * Algebra.trace K L y + Algebra.norm K y ∧
          Algebra.norm K (algebraMap K L x - y) =
            x ^ 2 - x * Algebra.trace K L y + Algebra.norm K y) := by
      clear * -
      intro K L _ _ _ _ hdeg
      refine ⟨?_, ?_⟩
      · intro x
        rw [Algebra.trace_algebraMap, hdeg, nsmul_eq_mul, Nat.cast_two]
      · intro x y
        let b : Module.Basis (Fin 2) K L :=
          (Module.finBasis K L).reindex (finCongr hdeg)
        let A : Matrix (Fin 2) (Fin 2) K := Algebra.leftMulMatrix b y
        let X : Matrix (Fin 2) (Fin 2) K := Algebra.leftMulMatrix b (algebraMap K L x)
        have htr_y : Algebra.trace K L y = A 0 0 + A 1 1 := by
          rw [Algebra.trace_eq_matrix_trace b y, Matrix.trace_fin_two A]
        have hnorm_y : Algebra.norm K y = A 0 0 * A 1 1 - A 0 1 * A 1 0 := by
          rw [Algebra.norm_eq_matrix_det b y, Matrix.det_fin_two A]
        have hX_eq : X = algebraMap K (Matrix (Fin 2) (Fin 2) K) x :=
          AlgHom.commutes (Algebra.leftMulMatrix b) x
        have hX00 : X 0 0 = x := by
          rw [hX_eq]
          simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
        have hX11 : X 1 1 = x := by
          rw [hX_eq]
          simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
        have hX01 : X 0 1 = 0 := by
          have h01 : (0 : Fin 2) ≠ 1 := by decide
          rw [hX_eq]
          simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h01]
        have hX10 : X 1 0 = 0 := by
          have h10 : (1 : Fin 2) ≠ 0 := by decide
          rw [hX_eq]
          simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h10]
        refine ⟨?_, ?_⟩
        · rw [Algebra.norm_eq_matrix_det b (algebraMap K L x + y), map_add]
          change (X + A).det = _
          rw [Matrix.det_fin_two, htr_y, hnorm_y]
          simp only [Matrix.add_apply, hX00, hX11, hX01, hX10]
          ring
        · rw [Algebra.norm_eq_matrix_det b (algebraMap K L x - y), map_sub]
          change (X - A).det = _
          rw [Matrix.det_fin_two, htr_y, hnorm_y]
          simp only [Matrix.sub_apply, hX00, hX11, hX01, hX10]
          ring
    intro M₀ M₂ _ _ hM₀M₂ hdeg
    let M₂' : IntermediateField M₀ (AlgebraicClosure F) := IntermediateField.extendScalars hM₀M₂
    haveI : FiniteDimensional F M₂' := ‹FiniteDimensional F M₂›
    haveI : IsScalarTower F M₀ M₂' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional M₀ M₂' := Module.Finite.of_restrictScalars_finite F M₀ M₂'
    obtain ⟨htr, hnorm⟩ := hQuad_gen M₀ M₂' hdeg
    refine ⟨htr, fun x y => hnorm x (toExtendScalars F hM₀M₂ y)⟩
  · have htr_smul_gen : ∀ (K S : Type u) [CommRing K] [CommRing S] [Algebra K S] (a : K) (y : S),
        Algebra.trace K S (algebraMap K S a * y) = a * Algebra.trace K S y := by
      clear * -
      intro K S _ _ _ a y
      rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
    have helper_deg2_trace_norm : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [FiniteDimensional k K₀]
        [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        Module.finrank k K₀ = 2 →
        (∃ σ : Ω_bar ≃ₐ[k] Ω_bar, ¬ ∀ x ∈ K₀, σ x = x) ∧
        (∀ σ : Ω_bar ≃ₐ[k] Ω_bar, (¬ ∀ x ∈ K₀, σ x = x) →
          ∀ y : K₀,
            algebraMap k Ω_bar (Algebra.trace k K₀ y) = y.1 + σ y.1 ∧
            algebraMap k Ω_bar (Algebra.norm k y) = y.1 * σ y.1) := by
      clear * -
      intro k Ω_bar _ _ _ _ K₀ _ hSepK₀ h_norm_fix hdeg
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      have hGal_KN : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      haveI : IsGalois k K_N := hGal_KN
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      have hGal_K₀ : IsGalois k ↥K₀ := IsGalois.of_algEquiv e_KN
      haveI : IsGalois k ↥K₀ := hGal_K₀
      have hNorm_K₀ : Normal k ↥K₀ := IsGalois.to_normal
      haveI : Normal k ↥K₀ := hNorm_K₀
      let G := (K₀ ≃ₐ[k] K₀)
      have hcard_G : Fintype.card G = 2 :=
        (Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank k K₀)).trans hdeg
      have hres_apply : ∀ (σ : Ω_bar ≃ₐ[k] Ω_bar) (z : K₀),
          (((AlgEquiv.restrictNormalHom ↥K₀ σ) z : ↥K₀) : Ω_bar) = σ z.1 := by
        intro σ z
        rw [AlgEquiv.restrictNormalHom_apply]
      have hres_eq_one_iff : ∀ σ : Ω_bar ≃ₐ[k] Ω_bar,
          AlgEquiv.restrictNormalHom ↥K₀ σ = 1 ↔ ∀ x ∈ K₀, σ x = x := by
        intro σ
        constructor
        · intro h1 x hx
          let z : K₀ := ⟨x, hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥K₀ σ) z = z := by rw [h1, AlgEquiv.one_apply]
          have hval : (((AlgEquiv.restrictNormalHom ↥K₀ σ) z : ↥K₀) : Ω_bar) = x :=
            congrArg Subtype.val hz
          rwa [hres_apply σ z] at hval
        · intro hfix
          apply AlgEquiv.ext
          intro z
          apply Subtype.ext
          rw [hres_apply σ z]
          exact hfix z.1 z.2
      refine ⟨?_, ?_⟩
      · have h1lt : 1 < Fintype.card G := by omega
        obtain ⟨g₀, hg₀⟩ := Fintype.exists_ne_of_one_lt_card h1lt (1 : G)
        obtain ⟨σ, hσ⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g₀
        refine ⟨σ, ?_⟩
        rw [← hres_eq_one_iff σ]
        intro h1
        exact hg₀ (hσ.symm.trans h1)
      · intro σ hσ y
        let g : G := AlgEquiv.restrictNormalHom ↥K₀ σ
        have hg_ne : g ≠ 1 := fun h1 => hσ ((hres_eq_one_iff σ).mp h1)
        have h1_ne_g : (1 : G) ≠ g := hg_ne.symm
        have huniv : (Finset.univ : Finset G) = {1, g} := by
          symm
          apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
          rw [Finset.card_univ, hcard_G, Finset.card_pair h1_ne_g]
        have htr_aut := congrArg (K₀.val : K₀ →+* Ω_bar)
          (trace_eq_sum_automorphisms (K := k) (L := K₀) y)
        have hnorm_aut := congrArg (K₀.val : K₀ →+* Ω_bar)
          (Algebra.norm_eq_prod_automorphisms k y)
        rw [map_sum, huniv, Finset.sum_pair h1_ne_g] at htr_aut
        rw [map_prod, huniv, Finset.prod_pair h1_ne_g] at hnorm_aut
        have h1_y : (K₀.val : K₀ →+* Ω_bar) ((1 : G) y) = y.1 := rfl
        have hg_y : (K₀.val : K₀ →+* Ω_bar) (g y) = σ y.1 := hres_apply σ y
        have htr_lhs : (K₀.val : K₀ →+* Ω_bar)
            ((algebraMap k K₀) (Algebra.trace k K₀ y)) = algebraMap k Ω_bar (Algebra.trace k K₀ y) := rfl
        have hnorm_lhs : (K₀.val : K₀ →+* Ω_bar)
            ((algebraMap k K₀) (Algebra.norm k y)) = algebraMap k Ω_bar (Algebra.norm k y) := rfl
        rw [htr_lhs, h1_y, hg_y] at htr_aut
        rw [hnorm_lhs, h1_y, hg_y] at hnorm_aut
        exact ⟨htr_aut, hnorm_aut⟩
    have hDeg2Inv : ∀ (A B : IntermediateField F (AlgebraicClosure F))
        [FiniteDimensional F A] [FiniteDimensional F B]
        (hAB : A ≤ B),
        IsGaloisExt F A B →
        Module.finrank A (IntermediateField.extendScalars hAB) = 2 →
        (∃ σ ∈ A.fixingSubgroup, σ ∉ B.fixingSubgroup) ∧
        (∀ σ ∈ A.fixingSubgroup, σ ∉ B.fixingSubgroup →
          ∀ y : B,
            (traceLM F hAB y : AlgebraicClosure F) = y.1 + σ y.1 ∧
            (normLM F hAB y : AlgebraicClosure F) = y.1 * σ y.1) := by
      intro A B _ _ hAB hGalAB hdegAB
      let B' : IntermediateField A (AlgebraicClosure F) := IntermediateField.extendScalars hAB
      haveI : FiniteDimensional F B' := ‹FiniteDimensional F B›
      haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : FiniteDimensional A B' := Module.Finite.of_restrictScalars_finite F A B'
      have hSepAB' : Algebra.IsSeparable A B' := hGalAB.2.2.2 hAB
      haveI : Algebra.IsSeparable A B' := hSepAB'
      haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
      haveI : Normal A (AlgebraicClosure F) := Normal.tower_top_of_normal F A (AlgebraicClosure F)
      have hB'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[A] AlgebraicClosure F),
          (∀ x ∈ B', τ x = x) → ∀ x ∈ B', (σ * τ * σ⁻¹) x = x := by
        intro σ τ hτ
        let σ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm σ
        let τ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm τ
        have hτB : τ_F.1 ∈ B.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro x hx
