      ((α⁻¹ : Lˣ) : L) * (β₂ * (1 - 4 * g) * t₀ ^ 2) by ring] at hsub
  have hE'_scaled_odd : ∀ t₁ : L, (t₁ = 0 ∨ 3 * (r : ℤ) - 1 ≤ 2 * valL F L t₁) →
      ψ (((α⁻¹ : Lˣ) : L) * (β₂ * (1 - 4 * g) * (t₁ + g * t₁ ^ 2))) = 1 := by
    intro t₁ ht₁
    have ht₁_sq : t₁ ^ 2 = 0 ∨ (3 * (r : ℤ) - 1) ≤ valL F L (t₁ ^ 2) := hP_sq_iff.mp ht₁
    set A := t₁ + g * t₁ ^ 2
    set t₀ := -(2 * (g * t₁))
    have ht₀ : t₀ = 0 ∨ (r : ℤ) ≤ 2 * valL F L t₀ := by
      rw [hP_sq_iff, show t₀ ^ 2 = 4 * (g * (g * t₁ ^ 2)) by dsimp [t₀]; ring]
      exact hP_mono (r : ℤ) (hP_mul hP_4 (hP_mul hP_g (hP_mul hP_g ht₁_sq))) (by omega)
    have hrem : β₂ * (1 - 4 * g) * A - (β₂ * A + β₂ * (2 * t₀ + t₀ ^ 2)) = 0 ∨
        2 * (r : ℤ) ≤ valL F L (β₂ * (1 - 4 * g) * A - (β₂ * A + β₂ * (2 * t₀ + t₀ ^ 2))) := by
      rw [show β₂ * (1 - 4 * g) * A - (β₂ * A + β₂ * (2 * t₀ + t₀ ^ 2)) =
        -(8 * (β₂ * (g * (g * t₁ ^ 2)))) by dsimp [A, t₀]; ring]
      exact hP_mono (2 * (r : ℤ))
        (hP_neg (hP_mul hP_8 (hP_mul hP_β₂ (hP_mul hP_g (hP_mul hP_g ht₁_sq))))) (by omega)
    rw [hψ_eq_2r _ _ hrem, mul_add, AddChar.map_add_eq_mul, hE'_odd t₁ ht₁, hE'_sq t₀ ht₀, mul_one]
  have hM₁'_scaled_sq : ∀ s₀ : L, (s₀ = 0 ∨ (a : ℤ) ≤ 2 * valL F L s₀) →
      ψ (((α⁻¹ : Lˣ) : L) * (β₁ * (1 + 4 * f) * s₀ ^ 2)) = 1 := by
    intro s₀ hs₀
    have hs₀_sq : s₀ ^ 2 = 0 ∨ (a : ℤ) ≤ valL F L (s₀ ^ 2) := hP_sq_iff.mp hs₀
    have hds₀ : d * s₀ = 0 ∨ (r : ℤ) ≤ 2 * valL F L (d * s₀) := by
      rw [hP_sq_iff, show (d * s₀) ^ 2 = d ^ 2 * s₀ ^ 2 by ring]
      exact hP_mono (r : ℤ) (hP_mul hP_d2 hs₀_sq) (by omega)
    have hrem : β₁ * (1 + 4 * f) * s₀ ^ 2 - β₂ * (1 - 4 * g) * (d * s₀) ^ 2 = 0 ∨
