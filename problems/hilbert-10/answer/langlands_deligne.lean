    apply hcν₂_0_stat u _ hu
    rw [hr_half_eq]
    exact hu_val
  have hcν₂_inv_eq : ((c_ν₂⁻¹ : Lˣ) : L) = ((α⁻¹ : Lˣ) : L) * β₂ := by
    dsimp [c_ν₂]
    rw [mul_inv_rev, inv_inv, Units.val_mul, Units.val_mk0, mul_comm]
  have hcν₂_stat : ∀ u : L, (u = 0 ∨ (r : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
