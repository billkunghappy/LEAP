    rw [h0, zero_mul] at h1u_Q_mul
    exact hV_ne h1u_Q_mul.symm
  have hV_unit_eq : Units.mk0 V hV_ne = Units.mk0 (1 + u_Q) hu_Q * Units.mk0 Q hQ_ne := by
    apply Units.ext
