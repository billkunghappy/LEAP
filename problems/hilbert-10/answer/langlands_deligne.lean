    let q : L := ε * ((u_d⁻¹ : Lˣ) : L)
    have hq_val : q = 0 ∨ (1 : ℤ) ≤ valL F L q := by
      have h := hval_mul_ge_L 1 0 ε ((u_d⁻¹ : Lˣ) : L) hε_val (Or.inr (le_of_eq hud_inv_val0.symm))
      simpa [q] using h
    have h1q_unit := hunit_of_gt0_L q hq_val
    have hd_inv : d * ((u_d⁻¹ : Lˣ) : L) = 1 := by
