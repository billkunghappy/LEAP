            ((recChar F rec M₁' χM₁')
                (Units.mk0 (1 + (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s) hs_M) : Ω F)⁻¹ *
              (traceChar F hLM₁' ψ)
                (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s)) :
    tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ) *
      tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
      tateEps F L νE' ψ =
    tateEps F M₁' (recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ) *
      tateEps F E' 1 (traceChar F hLE' ψ) *
      tateEps F L νM₁' ψ :=
by
