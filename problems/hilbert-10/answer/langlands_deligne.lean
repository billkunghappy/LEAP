    if hr : 1 + (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a_bar) ≠ 0 then
      (θE' (Units.mk0 (1 + (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a_bar)) hr) : Ω F)⁻¹ *
        ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a_bar))
    else 0
  let H_M₁' : k_L → Ω F := fun a_bar =>
    if hr : 1 + (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a_bar) ≠ 0 then
      (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a_bar)) hr) : Ω F)⁻¹ *
        ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a_bar))
    else 0
  have hdegE'K₁_2 : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 :=
    hdegE'K₁.trans hdeg2
  have hdegM₁'K₁_2 : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 :=
    hdegM₁'K₁.trans hdeg2
  have htr_M₁'_π : traceLM F hM₁'K₁ (π ^ t₂) = 0 ∨
      (r₀₁ : ℤ) ≤ valL F M₁' (traceLM F hM₁'K₁ (π ^ t₂)) := by
    apply htr_M₁'K₁ (r₀₁ : ℤ) (π ^ t₂)
    right
    rw [hval_π_pow t₂]
    omega
  have hH_eq : ∀ u : k_L, H_E' u = H_M₁' (u ^ 2) := by
    intro u
    set s : L := liftL u
    set s2 : L := liftL (u ^ 2)
    have hs_int : s = 0 ∨ 0 ≤ valL F L s := (hliftL u).1
    have hs_res : resL s = u := (hliftL u).2
    have hs2_int : s2 = 0 ∨ 0 ≤ valL F L s2 := (hliftL (u ^ 2)).1
    have hs2_res : resL s2 = u ^ 2 := (hliftL (u ^ 2)).2
    set y_s : E' := IntermediateField.inclusion hLE' s
    set z_s : M₁' := IntermediateField.inclusion hLM₁' s
    set z_s2 : M₁' := IntermediateField.inclusion hLM₁' s2
    set z : K₁ := IntermediateField.inclusion hE'K₁ y_s
    have hz_eq_M₁' : z = IntermediateField.inclusion hM₁'K₁ z_s := rfl
    have hy_s_int : y_s = 0 ∨ 0 ≤ valL F E' y_s := by
      rcases hs_int with h0 | hge
      · left; dsimp [y_s]; rw [h0, map_zero]
      · right; dsimp [y_s]; rw [hval_LE']; omega
    have hz_int : z = 0 ∨ 0 ≤ valL F K₁ z := by
      rcases hy_s_int with h0 | hge
      · left; dsimp [z]; rw [h0, map_zero]
      · right; dsimp [z]; rw [hval_E'K₁]; omega
    have hcrit := hCritPullback z hz_int
    have hz_ne : 1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z ≠ 0 := hcrit.1
    have hcrit_eq := hcrit.2 hz_ne
    set wz : K₁ˣ := Units.mk0 (1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z) hz_ne
    set uE' : E'ˣ := Units.map (normLM F hE'K₁) wz
    set uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) wz
    
    set w₁_E' : E' := (uE' : E') - 1
    set w₂_E' : E' := (δ₂ : E') * y_s
    have hw₁_E'_ne : 1 + w₁_E' ≠ 0 := by
      dsimp [w₁_E']; rw [add_sub_cancel]; exact Units.ne_zero uE'
    have huE'_mk0 : Units.mk0 (1 + w₁_E') hw₁_E'_ne = uE' := by
      ext; dsimp [w₁_E']; ring
    have hw₁_E'_exp : w₁_E' = w₂_E' + normLM F hE'K₁ (π ^ t₂) * y_s ^ 2 := by
      change normLM F hE'K₁ (1 + π ^ t₂ * IntermediateField.inclusion hE'K₁ y_s) - 1 =
        traceLM F hE'K₁ (π ^ t₂) * y_s + normLM F hE'K₁ (π ^ t₂) * y_s ^ 2
      exact hnorm_1_add_mul E' hE'K₁ hdegE'K₁_2 (π ^ t₂) y_s
    have hw₂_E'_d : w₂_E' = 0 ∨ (d₂ : ℤ) ≤ valL F E' w₂_E' := by
      rcases hy_s_int with h0 | hge
      · left; dsimp [w₂_E']; rw [h0, mul_zero]
      · by_cases hy0 : y_s = 0
        · left; dsimp [w₂_E']; rw [hy0, mul_zero]
        · right; dsimp [w₂_E']
          rw [hval_mul_E' _ _ (Units.ne_zero δ₂) hy0, hδ₂_val]; omega
    have hw₁₂_E'_r₀ : w₁_E' - w₂_E' = 0 ∨ (r₀₂ : ℤ) ≤ valL F E' (w₁_E' - w₂_E') := by
      have hsub : w₁_E' - w₂_E' = normLM F hE'K₁ (π ^ t₂) * (y_s * y_s) := by
        rw [hw₁_E'_exp, sq]; ring
      rw [hsub]
      have hnorm_val : valL F E' (normLM F hE'K₁ (π ^ t₂)) = (t₂ : ℤ) := by
        rw [(hval_normK₁ (π ^ t₂)).1, hval_π_pow t₂]
      by_cases hy0 : y_s = 0
      · left; rw [hy0, mul_zero, mul_zero]
      · right
        have hys_ge := hy_s_int.resolve_left hy0
        have hnorm_ne : normLM F hE'K₁ (π ^ t₂) ≠ 0 :=
          Units.ne_zero (Units.map (normLM F hE'K₁) (ϖ_K₁ ^ t₂))
        rw [hval_mul_E' _ _ hnorm_ne (mul_ne_zero hy0 hy0),
          hval_mul_E' _ _ hy0 hy0, hnorm_val]
        omega
    have hLHS_perturb := h_stat_perturb E' ψE' θE' cE' m₂ d₂ r₀₂
      (by omega) (by omega) (by omega) hcE'_val
      (fun w hw => hcE'_stat w (by
        rcases hw with rfl | hw
        · exact Or.inl rfl
        · right
          change (((m₂ + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w
          exact hw))
      hSpecE'
      ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
        by assumption, hval_add_E', by assumption, hunit_ge1_E', hunit_val0_E'⟩
      w₁_E' w₂_E' hw₂_E'_d hw₁₂_E'_r₀ hw₁_E'_ne
    rw [huE'_mk0] at hLHS_perturb
    have hLHS_eq : (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) =
        H_E' u := by
      dsimp [H_E', w₂_E', y_s, s] at hLHS_perturb ⊢
      rw [hLHS_perturb]
      congr 1; ext hr; rw [← mul_assoc]
    
    set w₁_M₁' : M₁' := (uM₁' : M₁') - 1
    set w₂_M₁' : M₁' := (δ₁ : M₁') * z_s2
    have hw₁_M₁'_ne : 1 + w₁_M₁' ≠ 0 := by
      dsimp [w₁_M₁']; rw [add_sub_cancel]; exact Units.ne_zero uM₁'
    have huM₁'_mk0 : Units.mk0 (1 + w₁_M₁') hw₁_M₁'_ne = uM₁' := by
      ext; dsimp [w₁_M₁']; ring
    have hw₁_M₁'_exp : w₁_M₁' = traceLM F hM₁'K₁ (π ^ t₂) * z_s + (δ₁ : M₁') * z_s ^ 2 := by
      change normLM F hM₁'K₁ (1 + π ^ t₂ * z) - 1 =
        traceLM F hM₁'K₁ (π ^ t₂) * z_s + normLM F hM₁'K₁ (π ^ t₂) * z_s ^ 2
      rw [hz_eq_M₁']
      exact hnorm_1_add_mul M₁' hM₁'K₁ hdegM₁'K₁_2 (π ^ t₂) z_s
    have hz_s_int : z_s = 0 ∨ 0 ≤ valL F M₁' z_s := by
      rcases hs_int with h0 | hge
      · left; dsimp [z_s]; rw [h0, map_zero]
      · right; dsimp [z_s]; rw [hval_LM₁']; omega
    have hz_s2_int : z_s2 = 0 ∨ 0 ≤ valL F M₁' z_s2 := by
      rcases hs2_int with h0 | hge
      · left; dsimp [z_s2]; rw [h0, map_zero]
      · right; dsimp [z_s2]; rw [hval_LM₁']; omega
    have hw₂_M₁'_d : w₂_M₁' = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' w₂_M₁' := by
      by_cases hz2_0 : z_s2 = 0
      · left; dsimp [w₂_M₁']; rw [hz2_0, mul_zero]
      · right; dsimp [w₂_M₁']
        have hge := hz_s2_int.resolve_left hz2_0
        rw [hval_mul_M₁' _ _ (Units.ne_zero δ₁) hz2_0, hδ₁_val]; omega
    have hs_sq_sub : s ^ 2 - s2 = 0 ∨ 1 ≤ valL F L (s ^ 2 - s2) := by
      have hs_sq_int : s ^ 2 = 0 ∨ 0 ≤ valL F L (s ^ 2) := by
        by_cases hs0 : s = 0
        · left; rw [hs0, sq, mul_zero]
        · right; rw [sq, hval_mul_L s s hs0 hs0]
          have hge := hs_int.resolve_left hs0; omega
      have hneg_s2_int : -s2 = 0 ∨ 0 ≤ valL F L (-s2) := by
        rcases hs2_int with h0 | hge
        · left; rw [h0, neg_zero]
        · right; rwa [hval_neg_L]
      have hsub_int : s ^ 2 - s2 = 0 ∨ 0 ≤ valL F L (s ^ 2 - s2) := by
        rw [sub_eq_add_neg]; exact hval_add_L 0 (s ^ 2) (-s2) hs_sq_int hneg_s2_int
      have hres_zero : resL (s ^ 2 - s2) = 0 := by
        rw [sub_eq_add_neg, (hresL_ring (s ^ 2) (-s2) hs_sq_int hneg_s2_int).1,
          (hresL_ring s2 0 hs2_int (Or.inl rfl)).2.2,
          sq, (hresL_ring s s hs_int hs_int).2.1, ← sq, hs_res, hs2_res, add_neg_cancel]
      exact (hresL_ker (s ^ 2 - s2) hsub_int).mp hres_zero
    have hw₁₂_M₁'_r₀ : w₁_M₁' - w₂_M₁' = 0 ∨ (r₀₁ : ℤ) ≤ valL F M₁' (w₁_M₁' - w₂_M₁') := by
      have hsub_eq : w₁_M₁' - w₂_M₁' =
          traceLM F hM₁'K₁ (π ^ t₂) * z_s +
            (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (s ^ 2 - s2) := by
        rw [hw₁_M₁'_exp]
        dsimp [w₂_M₁', z_s, z_s2]
        rw [map_sub (IntermediateField.inclusion hLM₁'),
          map_pow (IntermediateField.inclusion hLM₁')]; ring
      rw [hsub_eq]
      have hterm1 : traceLM F hM₁'K₁ (π ^ t₂) * z_s = 0 ∨
          (r₀₁ : ℤ) ≤ valL F M₁' (traceLM F hM₁'K₁ (π ^ t₂) * z_s) := by
        by_cases htr0 : traceLM F hM₁'K₁ (π ^ t₂) = 0
        · left; rw [htr0, zero_mul]
        · by_cases hzs0 : z_s = 0
          · left; rw [hzs0, mul_zero]
          · right
            have h1 := htr_M₁'_π.resolve_left htr0
            have h2 := hz_s_int.resolve_left hzs0
            rw [hval_mul_M₁' _ _ htr0 hzs0]; omega
      have hterm2 : (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (s ^ 2 - s2) = 0 ∨
          (r₀₁ : ℤ) ≤ valL F M₁' ((δ₁ : M₁') * IntermediateField.inclusion hLM₁' (s ^ 2 - s2)) := by
        rcases hs_sq_sub with h0 | hge
        · left; rw [h0, map_zero, mul_zero]
        · by_cases hsub0 : IntermediateField.inclusion hLM₁' (s ^ 2 - s2) = 0
          · left; rw [hsub0, mul_zero]
          · right
            rw [hval_mul_M₁' _ _ (Units.ne_zero δ₁) hsub0, hδ₁_val, hval_LM₁']
            omega
      exact hval_add_M₁' (r₀₁ : ℤ) _ _ hterm1 hterm2
    have hRHS_perturb := h_stat_perturb M₁' ψM₁' θM₁' cM₁' m₁ d₁ r₀₁
      (by omega) (by omega) (by omega) hcM₁'_val
      (fun w hw => hcM₁'_stat w (by
        rcases hw with rfl | hw
        · exact Or.inl rfl
        · right
          change (((m₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' w
          exact hw))
      hSpecM₁'
      ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
        by assumption, hval_add_M₁', by assumption, hunit_ge1_M₁', hunit_val0_M₁'⟩
      w₁_M₁' w₂_M₁' hw₂_M₁'_d hw₁₂_M₁'_r₀ hw₁_M₁'_ne
    rw [huM₁'_mk0] at hRHS_perturb
    have hRHS_eq : (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) =
        H_M₁' (u ^ 2) := by
      dsimp [H_M₁', w₂_M₁', z_s2, s2] at hRHS_perturb ⊢
      rw [hRHS_perturb]
      congr 1; ext hr; rw [← mul_assoc]
    rw [← hLHS_eq, ← hRHS_eq]
    exact hcrit_eq
  have hfrob_inj : Function.Injective (fun a_bar : k_L => a_bar ^ 2) := by
    intro a_bar b_bar hab
    have hsub_sq : (a_bar - b_bar) ^ 2 = 0 := by
      calc (a_bar - b_bar) ^ 2
        _ = (a_bar ^ 2 - b_bar ^ 2) - (2 : k_L) * (a_bar * b_bar - b_bar ^ 2) := by ring
        _ = 0 - 0 * (a_bar * b_bar - b_bar ^ 2) := by rw [sub_eq_zero.mpr hab, hchar2_kL]
        _ = 0 := by ring
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hsub_sq)
  have hfrob_bij : Function.Bijective (fun a_bar : k_L => a_bar ^ 2) :=
    (Fintype.bijective_iff_injective_and_card _).mpr ⟨hfrob_inj, rfl⟩
  have hsum_eq : (∑ a_bar : k_L, H_E' a_bar) = ∑ a_bar : k_L, H_M₁' a_bar :=
    Fintype.sum_bijective (fun a_bar : k_L => a_bar ^ 2) hfrob_bij H_E' H_M₁' hH_eq
  exact ⟨δ₁, δ₂, hδ₁_val, hδ₂_val, hsum_eq⟩

theorem ld_ch12_wild_dyadic_even_breaks_equal_polar_quad_and_missing_coset (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (heq : condExp F L νM₁' = condExp F L νE')
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hMissingCoset :
      ∀ (k_L : Type u) [Field k_L] [Fintype k_L],
        (2 : k_L) = 0 →
        ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
        ∀ (d₁ d₂ a₁ a₂ : k_L), d₁ ≠ 0 → d₂ ≠ 0 → a₁ ≠ 0 → a₂ ≠ 0 → a₁ ≠ a₂ →
        ∀ (p₁ p₂ : k_L →+ k_L) (H₁ H₂ Q : k_L → Ω F),
          (∀ z : k_L, p₁ z = 0 ↔ (z = 0 ∨ z = a₁)) →
          (∀ z : k_L, p₂ z = 0 ↔ (z = 0 ∨ z = a₂)) →
          H₁ 0 = 1 → H₂ 0 = 1 →
          (∀ x y : k_L, H₁ (x + y) = H₁ x * H₁ y * ψ₀ (d₁ * x * y)) →
          (∀ x y : k_L, H₂ (x + y) = H₂ x * H₂ y * ψ₀ (d₂ * x * y)) →
          (∀ z : k_L, H₁ (p₁ z) = Q z) →
          (∀ z : k_L, H₂ (p₂ z) = Q z) →
          (∑ x : k_L, H₁ x) = (∑ x : k_L, H₂ x))
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
    (hm2_min : condExp F E' (recChar F rec E' χE') =
      condExp F L νM₁' + condExp F L νE' - 1)
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1))
    (hSpecE' : ∀ y : E',
      (y = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' y) →
        (traceChar F hLE' ψ) y = 1)
    (hSpecM₁' : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
        (traceChar F hLM₁' ψ) z = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
