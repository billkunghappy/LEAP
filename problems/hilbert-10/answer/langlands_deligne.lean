    have hcancel : (8 : M₁')⁻¹ * ((8 : M₁') * u_M) = u_M := inv_mul_cancel_left₀ h8_M₁'_ne u_M
    rw [← hcancel]
    simpa only [zero_add] using
      hval_mul_bound_M₁' 0 (d_U : ℤ) (8 : M₁')⁻¹ ((8 : M₁') * u_M)
