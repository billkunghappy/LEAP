          have h := hvalM_mul_bound (d_U : ℤ) (d_U : ℤ) w w hw hw
          simpa [sq, two_mul] using h
        have hw3 : w ^ 3 = 0 ∨ 3 * (d_U : ℤ) ≤ valL F M₁' (w ^ 3) := by
          have h := hvalM_mul_bound (2 * (d_U : ℤ)) (d_U : ℤ) (w ^ 2) w hw2 hw
          have hpow3 : w ^ 2 * w = w ^ 3 := by ring
          have h3 : 2 * (d_U : ℤ) + (d_U : ℤ) = 3 * (d_U : ℤ) := by ring
          rw [hpow3, h3] at h
          exact h
        have hi2_w : i2 * w = 0 ∨ (d_U : ℤ) ≤ valL F M₁' (i2 * w) := by
          have h := hvalM_mul_bound 0 (d_U : ℤ) i2 w (Or.inr (by rw [hvalM_i2])) hw
          simpa using h
        have hi2_w2 : i2 ^ 3 * (w ^ 2) = 0 ∨ (d_U : ℤ) ≤ valL F M₁' (i2 ^ 3 * (w ^ 2)) := by
          have h := hvalM_mul_bound 0 (2 * (d_U : ℤ)) (i2 ^ 3) (w ^ 2)
            (Or.inr (by rw [hvalM_i2_pow 3])) hw2
          exact h.imp id (fun hle => by omega)
        have hz_val : z = 0 ∨ (d_U : ℤ) ≤ valL F M₁' z :=
          hvalM_add (d_U : ℤ) (i2 * w) (i2 ^ 3 * (w ^ 2)) hi2_w hi2_w2
        have hi2_6_w : i2 ^ 6 * w = 0 ∨ 0 ≤ valL F M₁' (i2 ^ 6 * w) := by
          have h := hvalM_mul_bound 0 (d_U : ℤ) (i2 ^ 6) w
            (Or.inr (by rw [hvalM_i2_pow 6])) hw
          exact h.imp id (fun hle => by omega)
        have hfac_int : i2 ^ 3 + i2 ^ 6 * w = 0 ∨ 0 ≤ valL F M₁' (i2 ^ 3 + i2 ^ 6 * w) :=
          hvalM_add 0 (i2 ^ 3) (i2 ^ 6 * w) (Or.inr (by rw [hvalM_i2_pow 3])) hi2_6_w
        have hrem_3dU : rem_w = 0 ∨ 3 * (d_U : ℤ) ≤ valL F M₁' rem_w := by
          have h := hvalM_mul_bound (3 * (d_U : ℤ)) 0 (w ^ 3) (i2 ^ 3 + i2 ^ 6 * w) hw3 hfac_int
          rw [add_zero] at h
          dsimp [rem_w]
          rcases h with h0 | hle
          · exact Or.inl (by rw [h0, neg_zero])
          · right; rw [hvalM_neg]; exact hle
        have hrem_m : rem_w = 0 ∨ (mM₁' : ℤ) ≤ valL F M₁' rem_w :=
          hrem_3dU.imp id (fun hle => le_trans hm_le_3dU hle)
        have hΔ_rem_val : Δ_k * rem_w = 0 ∨ -n ≤ valL F M₁' (Δ_k * rem_w) := by
          have h := hvalM_mul_bound (- (mM₁' : ℤ) - n) (mM₁' : ℤ) Δ_k rem_w hΔ_val0 hrem_m
          have hsum : - (mM₁' : ℤ) - n + (mM₁' : ℤ) = -n := by ring
          rw [hsum] at h
          exact h
        have hψ_rem : ψM₁' (Δ_k * rem_w) = 1 := hψM_triv (Δ_k * rem_w) hΔ_rem_val
        have hquad_id : 2 * z - z ^ 2 = w + rem_w := by
          dsimp [z, rem_w]
          linear_combination (-i2 ^ 3 * w ^ 3 + i2 ^ 2 * w ^ 2 + w) * h2_mul_i2
        have h1 := hΔ_quad_triv z hz_val
        rw [hquad_id, mul_add, AddChar.map_add_eq_mul, hψ_rem, mul_one] at h1
        exact h1
      
      have havg_id : IntermediateField.inclusion hLM₁' β_L - u₀ =
          ∑ k ∈ Finset.range p, ((σ₀ ^ k) u₀ - u₀) * (σ₀ ^ k) y₁ := by
        have h1 := hσ₀_tr (u₀ * y₁)
        have h2 := hσ₀_tr y₁
        rw [hy₁_tr, map_one] at h2
        calc IntermediateField.inclusion hLM₁' β_L - u₀
            = IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (u₀ * y₁)) - u₀ * 1 := by
              dsimp [β_L]; ring
          _ = (∑ k ∈ Finset.range p, (σ₀ ^ k) (u₀ * y₁)) -
                u₀ * (∑ k ∈ Finset.range p, (σ₀ ^ k) y₁) := by rw [h1, ← h2]
          _ = (∑ k ∈ Finset.range p, (σ₀ ^ k) u₀ * (σ₀ ^ k) y₁) -
                (∑ k ∈ Finset.range p, u₀ * (σ₀ ^ k) y₁) := by
              simp_rw [map_mul, Finset.mul_sum]
          _ = ∑ k ∈ Finset.range p, ((σ₀ ^ k) u₀ - u₀) * (σ₀ ^ k) y₁ := by
              rw [← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl fun k _ => ?_
              ring
      rw [havg_id]
      apply hvalM_sum (Finset.range p) (fun k => ((σ₀ ^ k) u₀ - u₀) * (σ₀ ^ k) y₁) (-n - (d_U : ℤ))
      intro k _
      have hy₁_k : (σ₀ ^ k) y₁ = 0 ∨ 0 ≤ valL F M₁' ((σ₀ ^ k) y₁) := by
        rcases hy₁_int with rfl | hy₁_ge0
        · exact Or.inl (map_zero (σ₀ ^ k))
        · right; rw [hσ₀_pow_val k y₁]; exact hy₁_ge0
      have h := hvalM_mul_bound (-n - (d_U : ℤ)) 0 ((σ₀ ^ k) u₀ - u₀) ((σ₀ ^ k) y₁) (hΔ_bound k) hy₁_k
      simpa using h
  
  set diff : M₁' := IntermediateField.inclusion hLM₁' β_L - u₀
  have hβ_incl_ne0 : IntermediateField.inclusion hLM₁' β_L ≠ 0 := by
    intro h0
    have hdiff_eq : diff = -u₀ := by
      dsimp [diff]
      rw [h0, zero_sub]
    have hdiff_ne0 : diff ≠ 0 := by
      rw [hdiff_eq]
      exact neg_ne_zero.mpr hu₀_ne0
    have hge : -n - (d_U : ℤ) ≤ valL F M₁' diff := hdiff_bound.resolve_left hdiff_ne0
    rw [hdiff_eq, hvalM_neg, hu₀_val] at hge
    omega
  have hβ_L_ne0 : β_L ≠ 0 := fun h0 => hβ_incl_ne0 (by rw [h0, map_zero])
  have hβ_incl_val : valL F M₁' (IntermediateField.inclusion hLM₁' β_L) = - (mM₁' : ℤ) - n := by
    have hsum_eq : u₀ + diff = IntermediateField.inclusion hLM₁' β_L := by
      dsimp [diff]; ring
    have hge : - (mM₁' : ℤ) - n ≤ valL F M₁' (IntermediateField.inclusion hLM₁' β_L) := by
      have hadd := hvalM_add (- (mM₁' : ℤ) - n) u₀ diff
        (Or.inr (by rw [hu₀_val]))
        (hdiff_bound.imp id (fun h => by omega))
      rw [hsum_eq] at hadd
      exact hadd.resolve_left hβ_incl_ne0
    have hle : valL F M₁' (IntermediateField.inclusion hLM₁' β_L) ≤ - (mM₁' : ℤ) - n := by
      by_contra hlt
      have hsub_eq : IntermediateField.inclusion hLM₁' β_L - diff = u₀ := by
        dsimp [diff]; ring
      have hsub := hvalM_sub (- (mM₁' : ℤ) - n + 1) (IntermediateField.inclusion hLM₁' β_L) diff
        (Or.inr (by omega))
        (hdiff_bound.imp id (fun h => by omega))
      rw [hsub_eq] at hsub
      have hu₀_ge : - (mM₁' : ℤ) - n + 1 ≤ valL F M₁' u₀ := hsub.resolve_left hu₀_ne0
      rw [hu₀_val] at hu₀_ge
      omega
    omega
  let u_β : Lˣ := Units.mk0 β_L hβ_L_ne0
  let c_L : Lˣ := u_β⁻¹
  let cM₁' : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_L
  have hcM₁'_inv_coe : ((cM₁'⁻¹ : M₁'ˣ) : M₁') = IntermediateField.inclusion hLM₁' β_L := by
    have h1 : cM₁'⁻¹ = Units.map (IntermediateField.inclusion hLM₁').toMonoidHom u_β := by
      dsimp [cM₁', c_L]
      rw [← map_inv, inv_inv]
    rw [h1]
    rfl
  have hcM₁'_val : valL F M₁' (cM₁' : M₁') = (mM₁' : ℤ) + n := by
    have h := hvalM_inv (cM₁'⁻¹)
    rw [inv_inv, hcM₁'_inv_coe, hβ_incl_val] at h
    linarith
  have hc_L_val : valL F L (c_L : L) = (mM₁' : ℤ) + condExpChar F L ψ := by
    have h1 : valL F M₁' (cM₁' : M₁') = valL F L (c_L : L) := hval_LM₁' (c_L : L)
    rw [← h1, hcM₁'_val, hnM₁'_eq]
  refine ⟨htr_incl, c_L, hc_L_val, hcM₁'_val, ?_⟩
  intro z hz_val hz
  have h2_minus_z : 2 - z = 0 ∨ 0 ≤ valL F M₁' (2 - z) :=
    hvalM_sub 0 (2 : M₁') z (Or.inr (by rw [hvalM_2])) (hz_val.imp id (fun h => by omega))
  have hquad_val : 2 * z - z ^ 2 = 0 ∨ (d_U : ℤ) ≤ valL F M₁' (2 * z - z ^ 2) := by
    have hfac : 2 * z - z ^ 2 = z * (2 - z) := by ring
    rw [hfac]
    have h := hvalM_mul_bound (d_U : ℤ) 0 z (2 - z) hz_val h2_minus_z
    simpa using h
  have hdiff_quad_val : diff * (2 * z - z ^ 2) = 0 ∨ -n ≤ valL F M₁' (diff * (2 * z - z ^ 2)) := by
    have h := hvalM_mul_bound (-n - (d_U : ℤ)) (d_U : ℤ) diff (2 * z - z ^ 2) hdiff_bound hquad_val
    have hsum : -n - (d_U : ℤ) + (d_U : ℤ) = -n := by ring
    rw [hsum] at h
    exact h
  have hψ_diff : ψM₁' (diff * (2 * z - z ^ 2)) = 1 := hψM_triv (diff * (2 * z - z ^ 2)) hdiff_quad_val
  have hsplit_c : ((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2) =
      u₀ * (2 * z - z ^ 2) + diff * (2 * z - z ^ 2) := by
    rw [hcM₁'_inv_coe]
    dsimp [diff]
    ring
  rw [hsplit_c, AddChar.map_add_eq_mul, hψ_diff, mul_one]
  exact hc_U_stat z hz_val hz

theorem ld_unramified_charpoly_norm_poly_expansion (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p)
    (hval1 : valL F E' 1 = 0)
    (hval_mul : ∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y)
    (hval_surj : ∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = (p : ℤ) * valL F K₁ w)
    (w₁ : K₁) (hw₁_tr : traceLM F hE'K₁ w₁ = 1) :
    (∀ (a : E') (w : K₁),
      traceLM F hE'K₁ (IntermediateField.inclusion hE'K₁ a * w) =
        a * traceLM F hE'K₁ w) ∧
    Module.finrank E' (IntermediateField.extendScalars hE'K₁) = p ∧
    ∃ c : ℕ → E',
      c p = normLM F hE'K₁ w₁ ∧
      ∀ t : E',
        normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ t * w₁) =
          1 + t + ∑ r ∈ Finset.Icc 2 p, c r * t ^ r :=
by
  letI : Algebra E' E' := Algebra.id E'
  letI : Module E' E' := Semiring.toModule
  letI : DistribMulAction E' E' := Semiring.toModule.toDistribMulAction
  letI : MulAction E' E' := Semiring.toModule.toDistribMulAction.toMulAction
  letI : DistribSMul E' E' := Semiring.toModule.toDistribMulAction.toDistribSMul
  letI : SMulZeroClass E' E' := Semiring.toModule.toDistribMulAction.toDistribSMul.toSMulZeroClass
  letI : SMul E' E' := Semiring.toModule.toDistribMulAction.toMulAction.toSMul
  letI : IsScalarTower E' E' E' := IsScalarTower.left E'
  letI : SMulCommClass E' E' E' := Algebra.to_smulCommClass
  let S := IntermediateField.extendScalars hE'K₁
  let ι_S : K₁ →+* S := toExtendScalars F hE'K₁
  haveI : FiniteDimensional E' S := by
    haveI : FiniteDimensional F S := ‹FiniteDimensional F K₁›
    haveI : IsScalarTower F E' S := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F E' S
  have htr_lin : ∀ (a : E') (w : K₁),
      traceLM F hE'K₁ (IntermediateField.inclusion hE'K₁ a * w) =
        a * traceLM F hE'K₁ w := by
    intro a w
    have hsmul : ι_S (IntermediateField.inclusion hE'K₁ a * w) = a • ι_S w := rfl
    change (Algebra.trace E' S) (ι_S (IntermediateField.inclusion hE'K₁ a * w)) =
      a * (Algebra.trace E' S) (ι_S w)
    rw [hsmul, LinearMap.map_smul, smul_eq_mul]
  have hfinrank : Module.finrank E' S = p := by
    set n := Module.finrank E' S
    obtain ⟨ϖ, hϖ_val⟩ := hval_surj 1
    have hϖ_ne0 : (ϖ : E') ≠ 0 := Units.ne_zero ϖ
    have hpow_val : ∀ k : ℕ, (ϖ : E') ^ k ≠ 0 ∧ valL F E' ((ϖ : E') ^ k) = (k : ℤ) := by
      intro k
      induction k with
      | zero =>
        rw [pow_zero]
        exact ⟨one_ne_zero, by rw [hval1, Nat.cast_zero]⟩
      | succ k ih =>
        rw [pow_succ]
        have hne : (ϖ : E') ^ k * (ϖ : E') ≠ 0 := mul_ne_zero ih.1 hϖ_ne0
        refine ⟨hne, ?_⟩
        rw [hval_mul ((ϖ : E') ^ k) (ϖ : E') ih.1 hϖ_ne0, ih.2, hϖ_val, Nat.cast_add, Nat.cast_one]
    have halg_ϖ : ι_S (IntermediateField.inclusion hE'K₁ (ϖ : E')) =
        algebraMap E' S (ϖ : E') := rfl
    have hnorm_ϖ : normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ (ϖ : E')) =
        (ϖ : E') ^ n := by
      change (Algebra.norm E') (ι_S (IntermediateField.inclusion hE'K₁ (ϖ : E'))) = (ϖ : E') ^ n
      rw [halg_ϖ, Algebra.norm_algebraMap]
    have hval_lhs :
        valL F E' (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ (ϖ : E'))) = (p : ℤ) := by
      rw [hval_norm_E'K₁, hval_E'K₁, hϖ_val, mul_one]
    have hval_rhs :
        valL F E' (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ (ϖ : E'))) = (n : ℤ) := by
      rw [hnorm_ϖ, (hpow_val n).2]
    have heq_int : (n : ℤ) = (p : ℤ) := hval_rhs.symm.trans hval_lhs
    omega
  let ι := Module.Free.ChooseBasisIndex E' S
  letI : DecidableEq ι := inferInstanceAs (DecidableEq (Module.Free.ChooseBasisIndex E' S))
  letI : Fintype ι := inferInstanceAs (Fintype (Module.Free.ChooseBasisIndex E' S))
  let b : Module.Basis ι E' S := Module.Free.chooseBasis E' S
  have hcard_ι : Fintype.card ι = p := by
    rw [← Module.finrank_eq_card_chooseBasisIndex E' S, hfinrank]
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  haveI : Nonempty ι := Fintype.card_pos_iff.mp (by omega)
  let A : Matrix ι ι E' := Algebra.leftMulMatrix b (ι_S w₁)
  let M : Matrix ι ι E' := -A
  let P : Polynomial E' := M.charpoly
  have hP_monic : P.Monic := Matrix.charpoly_monic M
  have hP_deg : P.natDegree = p :=
    (Matrix.charpoly_natDegree_eq_dim M).trans hcard_ι
  let c : ℕ → E' := fun r => P.coeff (p - r)
  have hc0 : c 0 = 1 := by
    change P.coeff (p - 0) = 1
    rw [Nat.sub_zero, ← hP_deg, hP_monic.coeff_natDegree]
  have hc1 : c 1 = 1 := by
    have htr_M : M.trace = - P.coeff (p - 1) := by
      rw [← hcard_ι]
      exact Matrix.trace_eq_neg_charpoly_coeff M
    have htr_A : A.trace = 1 := by
      have h1 : (Algebra.trace E' S) (ι_S w₁) = A.trace :=
        Algebra.trace_eq_matrix_trace b (ι_S w₁)
      exact h1.symm.trans hw₁_tr
    have htr_neg : M.trace = -1 := by
      change (-A).trace = -1
      rw [Matrix.trace_neg, htr_A]
    change P.coeff (p - 1) = 1
    exact neg_inj.mp (htr_M.symm.trans htr_neg)
  have hcp : c p = normLM F hE'K₁ w₁ := by
    change P.coeff (p - p) = normLM F hE'K₁ w₁
    rw [Nat.sub_self]
    have hdet_M1 : M.det = (-1 : E') ^ p * P.coeff 0 := by
      rw [← hcard_ι]
      exact Matrix.det_eq_sign_charpoly_coeff M
    have hdet_A : A.det = normLM F hE'K₁ w₁ :=
      (Algebra.norm_eq_matrix_det b (ι_S w₁)).symm
    have hdet_M2 : M.det = (-1 : E') ^ p * normLM F hE'K₁ w₁ := by
      change (-A).det = (-1 : E') ^ p * normLM F hE'K₁ w₁
      rw [Matrix.det_neg, hcard_ι, hdet_A]
    have hsign_eq : (-1 : E') ^ p * P.coeff 0 = (-1 : E') ^ p * normLM F hE'K₁ w₁ :=
      hdet_M1.symm.trans hdet_M2
    have hsign_sq : (-1 : E') ^ p * (-1 : E') ^ p = 1 := by
      rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
    calc P.coeff 0
      _ = ((-1 : E') ^ p * (-1 : E') ^ p) * P.coeff 0 := by rw [hsign_sq, one_mul]
      _ = (-1 : E') ^ p * ((-1 : E') ^ p * P.coeff 0) := by rw [mul_assoc]
      _ = (-1 : E') ^ p * ((-1 : E') ^ p * normLM F hE'K₁ w₁) := by rw [hsign_eq]
      _ = ((-1 : E') ^ p * (-1 : E') ^ p) * normLM F hE'K₁ w₁ := by rw [← mul_assoc]
      _ = normLM F hE'K₁ w₁ := by rw [hsign_sq, one_mul]
  have hrange_split : ∀ t : E',
      (∑ r ∈ Finset.range (p + 1), c r * t ^ r) =
        1 + t + ∑ r ∈ Finset.Icc 2 p, c r * t ^ r := by
    intro t
    have hset : Finset.range (p + 1) = insert 0 (insert 1 (Finset.Icc 2 p)) := by
      ext r
      simp only [Finset.mem_range, Finset.mem_insert, Finset.mem_Icc]
      omega
    have h0_not_mem : 0 ∉ insert 1 (Finset.Icc 2 p) := by
      simp only [Finset.mem_insert, Finset.mem_Icc]
      omega
    have h1_not_mem : 1 ∉ Finset.Icc 2 p := by
      simp only [Finset.mem_Icc]
      omega
    rw [hset, Finset.sum_insert h0_not_mem, Finset.sum_insert h1_not_mem,
      hc0, hc1, pow_zero, pow_one, mul_one, one_mul, add_assoc]
  refine ⟨htr_lin, hfinrank, c, hcp, ?_⟩
  intro t
  by_cases ht : t = 0
  · rw [ht]
    have hlhs : normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ 0 * w₁) = 1 := by
      rw [map_zero, zero_mul, add_zero, map_one]
    have hsum0 : (∑ r ∈ Finset.Icc 2 p, c r * (0 : E') ^ r) = 0 := by
      apply Finset.sum_eq_zero
      intro r hr
      have hr_ne0 : r ≠ 0 := by
        have := (Finset.mem_Icc.mp hr).1
        omega
      rw [zero_pow hr_ne0, mul_zero]
    rw [hlhs, hsum0, add_zero, add_zero]
  · have hι_eq : ι_S (1 + IntermediateField.inclusion hE'K₁ t * w₁) =
        1 + algebraMap E' S t * ι_S w₁ := rfl
    have hleft_t : Algebra.leftMulMatrix b (algebraMap E' S t) = Matrix.scalar ι t := by
      have hc : Algebra.leftMulMatrix b (algebraMap E' S t) = algebraMap E' (Matrix ι ι E') t :=
        (Algebra.leftMulMatrix b).commutes' t
      rw [hc, Matrix.algebraMap_eq_diagonal, Matrix.scalar_apply]
      rfl
    have hnorm_det :
        normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ t * w₁) =
          (1 + Matrix.scalar ι t * A).det := by
      change (Algebra.norm E') (ι_S (1 + IntermediateField.inclusion hE'K₁ t * w₁)) = _
      rw [hι_eq, Algebra.norm_eq_matrix_det b]
      change ((Algebra.leftMulMatrix b).toRingHom (1 + algebraMap E' S t * ι_S w₁)).det = _
      rw [RingHom.map_add, RingHom.map_one, RingHom.map_mul]
      change (1 + (Algebra.leftMulMatrix b) (algebraMap E' S t) * A).det = _
      rw [hleft_t]
    have hmat_eq : Matrix.scalar ι t * (Matrix.scalar ι t⁻¹ - M) =
        1 + Matrix.scalar ι t * A := by
      change Matrix.scalar ι t * (Matrix.scalar ι t⁻¹ - (-A)) = 1 + Matrix.scalar ι t * A
      rw [sub_neg_eq_add, mul_add, ← RingHom.map_mul (Matrix.scalar ι), mul_inv_cancel₀ ht,
        RingHom.map_one (Matrix.scalar ι)]
    have hdet_t : (Matrix.scalar ι t).det = t ^ p := by
      rw [Matrix.scalar_apply, Matrix.det_diagonal, Finset.prod_const, Finset.card_univ, hcard_ι]
    have hdet_eval : (1 + Matrix.scalar ι t * A).det = t ^ p * Polynomial.eval (t⁻¹) P := by
      rw [← hmat_eq, Matrix.det_mul, hdet_t, ← Matrix.eval_charpoly M (t⁻¹)]
    have heval_sum :
        t ^ p * Polynomial.eval (t⁻¹) P =
          ∑ r ∈ Finset.range (p + 1), c r * t ^ r := by
      rw [Polynomial.eval_eq_sum_range, hP_deg, Finset.mul_sum]
      rw [← Finset.sum_range_reflect (fun i => t ^ p * (P.coeff i * (t⁻¹) ^ i)) (p + 1)]
      refine Finset.sum_congr rfl fun r hr => ?_
      have hr_le : r ≤ p := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
      have hsub_eq : p + 1 - 1 - r = p - r := by omega
      rw [hsub_eq]
      have hpow_cancel : t ^ p * (t⁻¹) ^ (p - r) = t ^ r := by
        calc t ^ p * (t⁻¹) ^ (p - r)
          _ = (t ^ r * t ^ (p - r)) * (t⁻¹) ^ (p - r) := by
              rw [← pow_add, Nat.add_sub_of_le hr_le]
          _ = t ^ r * (t ^ (p - r) * (t⁻¹) ^ (p - r)) := by rw [mul_assoc]
          _ = t ^ r * (t * t⁻¹) ^ (p - r) := by rw [← mul_pow]
          _ = t ^ r * 1 ^ (p - r) := by rw [mul_inv_cancel₀ ht]
          _ = t ^ r := by rw [one_pow, mul_one]
      change t ^ p * (c r * (t⁻¹) ^ (p - r)) = c r * t ^ r
      rw [mul_left_comm, hpow_cancel]
    rw [hnorm_det, hdet_eval, heval_sum, hrange_split t]

theorem ld_unramified_poly_coeff_integrality_and_odd_cancel (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))))
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = (p : ℤ) * valL F K₁ w)
    (k_E' : Type u) [Field k_E'] [Fintype k_E'] (resE' : E' → k_E')
    (hresE'_0 : resE' 0 = 0) (hresE'_1 : resE' 1 = 1)
    (hresE'_ring : ∀ x₁ x₂ : E', (x₁ = 0 ∨ 0 ≤ valL F E' x₁) → (x₂ = 0 ∨ 0 ≤ valL F E' x₂) →
      resE' (x₁ + x₂) = resE' x₁ + resE' x₂ ∧
      resE' (x₁ * x₂) = resE' x₁ * resE' x₂ ∧
      resE' (-x₁) = -resE' x₁)
    (hresE'_ker : ∀ x : E', (x = 0 ∨ 0 ≤ valL F E' x) →
      (resE' x = 0 ↔ (x = 0 ∨ 1 ≤ valL F E' x)))
    (hresE'_surj : ∀ a : k_E', ∃ x : E', (x = 0 ∨ 0 ≤ valL F E' x) ∧ resE' x = a)
    (hp_zero_k : ((p : ℕ) : k_E') = 0)
    (hp_val_E' : ((p : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((p : ℕ) : E'))
    (w₁ : K₁) (hw₁_int : w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) (hw₁_tr : traceLM F hE'K₁ w₁ = 1)
    (htr_lin : ∀ (a : E') (w : K₁),
      traceLM F hE'K₁ (IntermediateField.inclusion hE'K₁ a * w) = a * traceLM F hE'K₁ w)
    (c : ℕ → E') (hcp : c p = normLM F hE'K₁ w₁)
    (hc_poly : ∀ t : E',
      normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ t * w₁) =
        1 + t + ∑ r ∈ Finset.Icc 2 p, c r * t ^ r) :
    (2 : E') ≠ 0 ∧
    valL F E' (2 : E') = 0 ∧
    (∀ r ∈ Finset.Icc 2 p, c r = 0 ∨ 0 ≤ valL F E' (c r)) ∧
    (∀ (d : ℕ) (t : E'), (t = 0 ∨ (d : ℤ) ≤ valL F E' t) →
      let y := IntermediateField.inclusion hE'K₁ t * w₁
      let R_pos := normLM F hE'K₁ (1 + y) - (1 + traceLM F hE'K₁ y)
      let R_neg := normLM F hE'K₁ (1 - y) - (1 + traceLM F hE'K₁ (-y))
      R_pos - R_neg = 0 ∨ (3 * d : ℤ) ≤ valL F E' (R_pos - R_neg)) :=
by
  rcases hvalE'_props with ⟨hvalE'0, hvalE'1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv,
    hvalE'_surj, hvalE'_add⟩
  rcases hvalK₁_props with ⟨hvalK₁0, hvalK₁1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_add⟩
  have hvalE'_weaken : ∀ (k₁ k₂ : ℤ) (x : E'), k₁ ≤ k₂ →
      (x = 0 ∨ k₂ ≤ valL F E' x) → (x = 0 ∨ k₁ ≤ valL F E' x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hvalE'_neg_ge : ∀ (k : ℤ) (x : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (-x = 0 ∨ k ≤ valL F E' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right
      rw [hvalE'_neg]
      exact hx
  have hvalE'_sub_ge : ∀ (k : ℤ) (x y : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
        (x - y = 0 ∨ k ≤ valL F E' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hvalE'_add k x (-y) hx (hvalE'_neg_ge k y hy)
  have hvalE'_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : E'),
      (x = 0 ∨ k₁ ≤ valL F E' x) → (y = 0 ∨ k₂ ≤ valL F E' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F E' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rcases hx with rfl | hx
        · exact False.elim (hx0 rfl)
        · rcases hy with rfl | hy
          · exact False.elim (hy0 rfl)
          · rw [hvalE'_mul x y hx0 hy0]
            omega
  have hvalE'_pow_ge : ∀ (r : ℕ) (k : ℤ) (x : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (x ^ r = 0 ∨ (r : ℤ) * k ≤ valL F E' (x ^ r)) := by
    intro r k x hx
    induction' r with r ih
    · right
      simp [hvalE'1]
    · rw [pow_succ']
      have hmul := hvalE'_mul_ge k ((r : ℤ) * k) x (x ^ r) hx ih
      have heq : k + (r : ℤ) * k = ((r + 1 : ℕ) : ℤ) * k := by push_cast; ring
      rw [← heq]
      exact hmul
  have hvalE'_sum_ge : ∀ (k : ℤ) (S : Finset ℕ) (g : ℕ → E'),
      (∀ i ∈ S, g i = 0 ∨ k ≤ valL F E' (g i)) →
        ((∑ i ∈ S, g i) = 0 ∨ k ≤ valL F E' (∑ i ∈ S, g i)) := by
    intro k S g hg
    induction' S using Finset.induction_on with a S ha ih
    · simp
    · rw [Finset.sum_insert ha]
      exact hvalE'_add k (g a) (∑ i ∈ S, g i)
        (hg a (Finset.mem_insert_self a S))
        (ih (fun i hi => hg i (Finset.mem_insert_of_mem hi)))
  have hresE'_pow : ∀ (r : ℕ) (u : E'), (u = 0 ∨ 0 ≤ valL F E' u) →
      ((u ^ r = 0 ∨ 0 ≤ valL F E' (u ^ r)) ∧ resE' (u ^ r) = (resE' u) ^ r) := by
    intro r u hu
    induction' r with r ih
    · refine ⟨Or.inr (by simp [hvalE'1]), ?_⟩
      simp [hresE'_1]
    · rw [pow_succ', pow_succ']
      have hpow_int : u * u ^ r = 0 ∨ 0 ≤ valL F E' (u * u ^ r) := by
        have h := hvalE'_mul_ge 0 0 u (u ^ r) hu ih.1
        simpa using h
      refine ⟨hpow_int, ?_⟩
      rw [(hresE'_ring u (u ^ r) hu ih.1).2.1, ih.2]
  have hresE'_sum : ∀ (S : Finset ℕ) (g : ℕ → E'),
      (∀ i ∈ S, g i = 0 ∨ 0 ≤ valL F E' (g i)) →
        (((∑ i ∈ S, g i) = 0 ∨ 0 ≤ valL F E' (∑ i ∈ S, g i)) ∧
          resE' (∑ i ∈ S, g i) = ∑ i ∈ S, resE' (g i)) := by
    intro S g hg
    induction' S using Finset.induction_on with a S ha ih
    · simp [hresE'_0]
    · have ha_int := hg a (Finset.mem_insert_self a S)
      have hS_int := ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      refine ⟨hvalE'_add 0 (g a) (∑ i ∈ S, g i) ha_int hS_int.1, ?_⟩
      rw [(hresE'_ring (g a) (∑ i ∈ S, g i) ha_int hS_int.1).1, hS_int.2]
  have hringChar : ringChar k_E' = p := CharP.ringChar_of_prime_eq_zero hPrime hp_zero_k
  haveI : CharP k_E' p := hringChar ▸ ringChar.charP k_E'
  have h1_int : (1 : E') = 0 ∨ 0 ≤ valL F E' (1 : E') := Or.inr (by omega)
  have h2_eq : (2 : E') = 1 + 1 := by ring
  have h2_int : (2 : E') = 0 ∨ 0 ≤ valL F E' (2 : E') := by
    rw [h2_eq]
    exact hvalE'_add 0 1 1 h1_int h1_int
  have hres_2 : resE' (2 : E') = ((2 : ℕ) : k_E') := by
    rw [h2_eq, (hresE'_ring 1 1 h1_int h1_int).1, hresE'_1]
    norm_num
  have hres_2_ne0 : resE' (2 : E') ≠ 0 := by
    rw [hres_2]
    intro h0
    have hdvd : p ∣ 2 := (CharP.cast_eq_zero_iff k_E' p 2).mp h0
    have hle2 : p ≤ 2 := Nat.le_of_dvd (by decide) hdvd
    have hge2 : 2 ≤ p := hPrime.two_le
    omega
  have h2_not_ker : ¬ ((2 : E') = 0 ∨ 1 ≤ valL F E' (2 : E')) := by
    intro hker
    exact hres_2_ne0 ((hresE'_ker (2 : E') h2_int).mpr hker)
  have h2_ne0 : (2 : E') ≠ 0 := fun h0 => h2_not_ker (Or.inl h0)
  have hval_2 : valL F E' (2 : E') = 0 := by
    rcases h2_int with h0 | hge0
    · exact False.elim (h2_ne0 h0)
    · have hlt1 : ¬ (1 ≤ valL F E' (2 : E')) := fun hge1 => h2_not_ker (Or.inr hge1)
      omega
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_le_card : p ≤ Fintype.card k_E' := by
    let φ : ZMod p →+* k_E' := ZMod.castHom (dvd_refl p) k_E'
    have hinj : Function.Injective φ := φ.injective
    have hle := Fintype.card_le_of_injective φ hinj
    rwa [ZMod.card p] at hle
  have hp3 : 3 ≤ p := by
    have hge2 := hPrime.two_le
    omega
  have hw₁_val_ge0 : 0 ≤ valL F K₁ w₁ := by
    rcases hw₁_int with rfl | hw
    · omega
    · exact hw
  have hcp_val_ge0 : 0 ≤ valL F E' (c p) := by
    rw [hcp, hval_norm_E'K₁ w₁]
    exact mul_nonneg (by omega) hw₁_val_ge0
  have hcp_int : c p = 0 ∨ 0 ≤ valL F E' (c p) := Or.inr hcp_val_ge0
  let S : Finset ℕ := Finset.Icc 2 (p - 1)
  have hE_tilde_int : ∀ u : E', (u = 0 ∨ 0 ≤ valL F E' u) →
      (∑ r ∈ S, c r * u ^ r) = 0 ∨ 0 ≤ valL F E' (∑ r ∈ S, c r * u ^ r) := by
    intro u hu
    have hu_K₁ : IntermediateField.inclusion hE'K₁ u = 0 ∨
        0 ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ u) := by
      rcases hu with rfl | hu_ge
      · left; simp
      · right; rw [hval_E'K₁ u]; exact hu_ge
    have huw₁_K₁ : IntermediateField.inclusion hE'K₁ u * w₁ = 0 ∨
        0 ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ u * w₁) := by
      by_cases h1 : IntermediateField.inclusion hE'K₁ u = 0
      · left; rw [h1, zero_mul]
      · by_cases h2 : w₁ = 0
        · left; rw [h2, mul_zero]
        · right
          rw [hvalK₁_mul _ _ h1 h2]
          rcases hu_K₁ with h0 | hu_ge
          · exact False.elim (h1 h0)
          · omega
    have h1_K₁ : (1 : K₁) = 0 ∨ 0 ≤ valL F K₁ (1 : K₁) := Or.inr (by omega)
    have h1uw₁_K₁ : 1 + IntermediateField.inclusion hE'K₁ u * w₁ = 0 ∨
        0 ≤ valL F K₁ (1 + IntermediateField.inclusion hE'K₁ u * w₁) :=
      hvalK₁_add 0 1 _ h1_K₁ huw₁_K₁
    have h1uw₁_val_ge0 : 0 ≤ valL F K₁ (1 + IntermediateField.inclusion hE'K₁ u * w₁) := by
      rcases h1uw₁_K₁ with h0 | hge
      · rw [h0, hvalK₁0]
      · exact hge
    have hnorm_int : normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ u * w₁) = 0 ∨
        0 ≤ valL F E' (normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ u * w₁)) := by
      right
      rw [hval_norm_E'K₁]
      exact mul_nonneg (by omega) h1uw₁_val_ge0
    have hsplit : ∑ r ∈ Finset.Icc 2 p, c r * u ^ r =
        (∑ r ∈ S, c r * u ^ r) + c p * u ^ p := by
      have hp_eq : p = (p - 1) + 1 := by omega
      have hle : 2 ≤ (p - 1) + 1 := by omega
      conv_lhs => rw [hp_eq]
      rw [Finset.sum_Icc_succ_top hle, ← hp_eq]
    have hpoly_u := hc_poly u
    rw [hsplit] at hpoly_u
    have hsum_eq : ∑ r ∈ S, c r * u ^ r =
        normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ u * w₁) -
          (1 + u + c p * u ^ p) := by
      linear_combination -hpoly_u
    rw [hsum_eq]
    have h1u_int : 1 + u = 0 ∨ 0 ≤ valL F E' (1 + u) := hvalE'_add 0 1 u h1_int hu
    have hcpu_int : c p * u ^ p = 0 ∨ 0 ≤ valL F E' (c p * u ^ p) := by
      have h := hvalE'_mul_ge 0 0 (c p) (u ^ p) hcp_int (hresE'_pow p u hu).1
      simpa using h
    have hrhs_int : 1 + u + c p * u ^ p = 0 ∨ 0 ≤ valL F E' (1 + u + c p * u ^ p) :=
      hvalE'_add 0 (1 + u) (c p * u ^ p) h1u_int hcpu_int
    exact hvalE'_sub_ge 0 _ _ hnorm_int hrhs_int
  have hc_S_int : ∀ r ∈ S, c r = 0 ∨ 0 ≤ valL F E' (c r) := by
    intro r_bad hr_bad
    by_contra hbad
    push_neg at hbad
    rcases hbad with ⟨_, hc_bad_lt0⟩
    let V : Finset ℤ := S.image (fun r => valL F E' (c r))
    have hV_ne : V.Nonempty := ⟨valL F E' (c r_bad), Finset.mem_image_of_mem _ hr_bad⟩
    let m_min : ℤ := V.min' hV_ne
    have hm_min_le_bad : m_min ≤ valL F E' (c r_bad) :=
      Finset.min'_le V _ (Finset.mem_image_of_mem _ hr_bad)
    have hm_min_lt0 : m_min < 0 := lt_of_le_of_lt hm_min_le_bad hc_bad_lt0
    have hm_min_le : ∀ r ∈ S, c r = 0 ∨ m_min ≤ valL F E' (c r) := by
      intro r hr
      exact Or.inr (Finset.min'_le V _ (Finset.mem_image_of_mem _ hr))
    have hm_min_mem : m_min ∈ V := Finset.min'_mem V hV_ne
    rcases Finset.mem_image.mp hm_min_mem with ⟨r₀, hr₀_S, hr₀_val⟩
    have hcr₀_ne0 : c r₀ ≠ 0 := by
      intro h0
      rw [h0, hvalE'0] at hr₀_val
      omega
    obtain ⟨π₀, hπ₀_val⟩ := hvalE'_surj (-m_min)
    let b : ℕ → E' := fun r => (π₀ : E') * c r
    have hπ₀_ge : (π₀ : E') = 0 ∨ -m_min ≤ valL F E' (π₀ : E') := Or.inr (by omega)
    have hb_int : ∀ r ∈ S, b r = 0 ∨ 0 ≤ valL F E' (b r) := by
      intro r hr
      have h := hvalE'_mul_ge (-m_min) m_min (π₀ : E') (c r) hπ₀_ge (hm_min_le r hr)
      have heq : -m_min + m_min = 0 := by omega
      rw [heq] at h
      exact h
    have hbr₀_ne0 : b r₀ ≠ 0 := mul_ne_zero (Units.ne_zero π₀) hcr₀_ne0
    have hbr₀_val0 : valL F E' (b r₀) = 0 := by
      change valL F E' ((π₀ : E') * c r₀) = 0
      rw [hvalE'_mul (π₀ : E') (c r₀) (Units.ne_zero π₀) hcr₀_ne0, hπ₀_val, hr₀_val]
      omega
    have hres_br₀_ne0 : resE' (b r₀) ≠ 0 := by
      intro h0
      have hker := (hresE'_ker (b r₀) (hb_int r₀ hr₀_S)).mp h0
      rcases hker with hzero | hge1
      · exact hbr₀_ne0 hzero
      · omega
    have hres_sum_zero : ∀ u : E', (u = 0 ∨ 0 ≤ valL F E' u) →
        ∑ r ∈ S, resE' (b r) * (resE' u) ^ r = 0 := by
      intro u hu
      have hterm_int : ∀ r ∈ S, b r * u ^ r = 0 ∨ 0 ≤ valL F E' (b r * u ^ r) := by
        intro r hr
        have h := hvalE'_mul_ge 0 0 (b r) (u ^ r) (hb_int r hr) (hresE'_pow r u hu).1
        simpa using h
      have hterm_res : ∀ r ∈ S, resE' (b r * u ^ r) = resE' (b r) * (resE' u) ^ r := by
        intro r hr
        rw [(hresE'_ring (b r) (u ^ r) (hb_int r hr) (hresE'_pow r u hu).1).2.1,
          (hresE'_pow r u hu).2]
      have hsum_res := (hresE'_sum S (fun r => b r * u ^ r) hterm_int).2
      have hsum_congr : ∑ r ∈ S, resE' (b r * u ^ r) =
          ∑ r ∈ S, resE' (b r) * (resE' u) ^ r :=
        Finset.sum_congr rfl fun r hr => hterm_res r hr
      rw [← hsum_congr, ← hsum_res]
      have hsum_eq_mul : ∑ r ∈ S, b r * u ^ r = (π₀ : E') * ∑ r ∈ S, c r * u ^ r := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun r _ => ?_
        dsimp [b]
        ring
      have hprod_ge1 : (π₀ : E') * (∑ r ∈ S, c r * u ^ r) = 0 ∨
          1 ≤ valL F E' ((π₀ : E') * (∑ r ∈ S, c r * u ^ r)) := by
        have h := hvalE'_mul_ge (-m_min) 0 (π₀ : E') (∑ r ∈ S, c r * u ^ r)
          hπ₀_ge (hE_tilde_int u hu)
        exact hvalE'_weaken 1 (-m_min + 0) _ (by omega) h
      rw [← hsum_eq_mul] at hprod_ge1
      exact (hresE'_ker (∑ r ∈ S, b r * u ^ r)
        (hresE'_sum S (fun r => b r * u ^ r) hterm_int).1).mpr hprod_ge1
    let E_bar : Polynomial k_E' := ∑ r ∈ S, Polynomial.monomial r (resE' (b r))
    have hE_bar_coeff_r₀ : E_bar.coeff r₀ = resE' (b r₀) := by
      simp [E_bar, Polynomial.finset_sum_coeff, Polynomial.coeff_monomial, hr₀_S]
    have hE_bar_ne0 : E_bar ≠ 0 := by
      intro h0
      rw [h0, Polynomial.coeff_zero] at hE_bar_coeff_r₀
      exact hres_br₀_ne0 hE_bar_coeff_r₀.symm
    have hE_bar_deg : E_bar.natDegree ≤ p - 1 := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      rw [Polynomial.finset_sum_coeff]
      refine Finset.sum_eq_zero fun r hr => ?_
      rw [Polynomial.coeff_monomial]
      have hr_le : r ≤ p - 1 := (Finset.mem_Icc.mp hr).2
      have hr_ne : r ≠ N := by omega
      simp [hr_ne]
    have hsub_roots : (Finset.univ : Finset k_E').val ⊆ E_bar.roots := by
      rw [Multiset.subset_iff]
      intro a _
      rw [Polynomial.mem_roots hE_bar_ne0, Polynomial.IsRoot.def, Polynomial.eval_finset_sum]
      obtain ⟨u, hu_int, hu_res⟩ := hresE'_surj a
      have heval_eq : (∑ r ∈ S, Polynomial.eval a (Polynomial.monomial r (resE' (b r)))) =
          ∑ r ∈ S, resE' (b r) * (resE' u) ^ r := by
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [Polynomial.eval_monomial, hu_res]
      rw [heval_eq]
      exact hres_sum_zero u hu_int
    have hcard_le : Fintype.card k_E' ≤ E_bar.natDegree := by
      have h := Polynomial.card_le_degree_of_subset_roots hsub_roots
      simpa using h
    omega
  have hc_int : ∀ r ∈ Finset.Icc 2 p, c r = 0 ∨ 0 ≤ valL F E' (c r) := by
    intro r hr
    rcases Finset.mem_Icc.mp hr with ⟨hr2, hrp⟩
    by_cases hr_eq : r = p
    · rw [hr_eq]
      exact hcp_int
    · exact hc_S_int r (Finset.mem_Icc.mpr ⟨hr2, by omega⟩)
  refine ⟨h2_ne0, hval_2, hc_int, ?_⟩
  intro d t ht y R_pos R_neg
  have htr_y : traceLM F hE'K₁ y = t := by
    dsimp [y]
    rw [htr_lin t w₁, hw₁_tr, mul_one]
  have hy_neg : -y = IntermediateField.inclusion hE'K₁ (-t) * w₁ := by
    dsimp [y]
    rw [map_neg, neg_mul]
  have htr_neg_y : traceLM F hE'K₁ (-y) = -t := by
    rw [hy_neg, htr_lin (-t) w₁, hw₁_tr, mul_one]
  have h1_sub_y : 1 - y = 1 + IntermediateField.inclusion hE'K₁ (-t) * w₁ := by
    rw [sub_eq_add_neg, hy_neg]
  have hR_pos_eq : R_pos = ∑ r ∈ Finset.Icc 2 p, c r * t ^ r := by
    dsimp [R_pos]
    rw [htr_y, hc_poly t]
    ring
  have hR_neg_eq : R_neg = ∑ r ∈ Finset.Icc 2 p, c r * (-t) ^ r := by
    dsimp [R_neg]
    rw [htr_neg_y, h1_sub_y, hc_poly (-t)]
    ring
  have hdiff_eq : R_pos - R_neg =
      ∑ r ∈ Finset.Icc 2 p, c r * (t ^ r - (-t) ^ r) := by
    rw [hR_pos_eq, hR_neg_eq, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun r _ => ?_
    ring
  rw [hdiff_eq]
  apply hvalE'_sum_ge (3 * d : ℤ) (Finset.Icc 2 p)
  intro r hr
  by_cases hr2 : r = 2
  · left
    rw [hr2]
    ring
  · have hr3 : 3 ≤ r := by
      have hge2 := (Finset.mem_Icc.mp hr).1
      omega
    have hrd_ge : (3 * d : ℤ) ≤ (r : ℤ) * (d : ℤ) := by
      have hr3_z : (3 : ℤ) ≤ (r : ℤ) := by exact_mod_cast hr3
      have hd_z : (0 : ℤ) ≤ (d : ℤ) := by omega
      nlinarith
    have htr_ge : t ^ r = 0 ∨ (3 * d : ℤ) ≤ valL F E' (t ^ r) :=
      hvalE'_weaken (3 * d : ℤ) ((r : ℤ) * (d : ℤ)) (t ^ r) hrd_ge
        (hvalE'_pow_ge r (d : ℤ) t ht)
    have hneg_t_ge : -t = 0 ∨ (d : ℤ) ≤ valL F E' (-t) := hvalE'_neg_ge (d : ℤ) t ht
    have hneg_tr_ge : (-t) ^ r = 0 ∨ (3 * d : ℤ) ≤ valL F E' ((-t) ^ r) :=
      hvalE'_weaken (3 * d : ℤ) ((r : ℤ) * (d : ℤ)) ((-t) ^ r) hrd_ge
        (hvalE'_pow_ge r (d : ℤ) (-t) hneg_t_ge)
    have hsub_tr_ge : t ^ r - (-t) ^ r = 0 ∨ (3 * d : ℤ) ≤ valL F E' (t ^ r - (-t) ^ r) :=
      hvalE'_sub_ge (3 * d : ℤ) (t ^ r) ((-t) ^ r) htr_ge hneg_tr_ge
    have hmul_ge := hvalE'_mul_ge 0 (3 * d : ℤ) (c r) (t ^ r - (-t) ^ r)
      (hc_int r hr) hsub_tr_ge
    simpa using hmul_ge

theorem ld_unramified_even_odd_norm_trace_congruence (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p)
    (h2_ne0 : (2 : E') ≠ 0) (hval_2 : valL F E' (2 : E') = 0)
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))))
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hnorm_lin_E'K₁ : ∀ (d : ℕ), 1 ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w))))
    (htr_lin : ∀ (a : E') (w : K₁),
      traceLM F hE'K₁ (IntermediateField.inclusion hE'K₁ a * w) = a * traceLM F hE'K₁ w)
    (w₁ : K₁) (hw₁_int : w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) (hw₁_tr : traceLM F hE'K₁ w₁ = 1)
    (d : ℕ) (hd : 1 ≤ d) :
    (∀ y : K₁, (y = 0 ∨ (d : ℤ) ≤ valL F K₁ y) →
      let R_pos := normLM F hE'K₁ (1 + y) - (1 + traceLM F hE'K₁ y)
      let R_neg := normLM F hE'K₁ (1 - y) - (1 + traceLM F hE'K₁ (-y))
      (R_pos - R_neg = 0 ∨ (3 * d : ℤ) ≤ valL F E' (R_pos - R_neg)) →
      let u_E := normLM F hE'K₁ (1 + y) - 1
      1 + y ≠ 0 ∧
      (u_E = 0 ∨ (d : ℤ) ≤ valL F E' u_E) ∧
      1 + u_E ≠ 0 ∧
      ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * y - y ^ 2) = 0 ∨
        (3 * d : ℤ) ≤ valL F E' ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * y - y ^ 2)))) ∧
    (∀ x : E', (x = 0 ∨ (d : ℤ) ≤ valL F E' x) →
      let q_x := (2 : E')⁻¹ * (2 * x - x ^ 2)
      let α := traceLM F hE'K₁ (w₁ ^ 2)
      let t := q_x + (2 : E')⁻¹ * α * q_x ^ 2
      let y := IntermediateField.inclusion hE'K₁ t * w₁
      (t = 0 ∨ (d : ℤ) ≤ valL F E' t) ∧
      (y = 0 ∨ (d : ℤ) ≤ valL F K₁ y) ∧
      (traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2) = 0 ∨
        (3 * d : ℤ) ≤ valL F E' (traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2)))) :=
by
  rcases hvalE'_props with ⟨hvalE'0, hvalE'1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, hvalE'_add⟩
  rcases hvalK₁_props with ⟨hvalK₁0, hvalK₁1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_add⟩
  have hvalE'_mono : ∀ {k₁ k₂ : ℤ} {z : E'}, k₁ ≤ k₂ →
      (z = 0 ∨ k₂ ≤ valL F E' z) → (z = 0 ∨ k₁ ≤ valL F E' z) := by
    intro k₁ k₂ z hk hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hz)
  have hvalK₁_mono : ∀ {k₁ k₂ : ℤ} {z : K₁}, k₁ ≤ k₂ →
      (z = 0 ∨ k₂ ≤ valL F K₁ z) → (z = 0 ∨ k₁ ≤ valL F K₁ z) := by
    intro k₁ k₂ z hk hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hz)
  have hvalE'_neg_bound : ∀ {k : ℤ} (z : E'),
      (z = 0 ∨ k ≤ valL F E' z) → (-z = 0 ∨ k ≤ valL F E' (-z)) := by
    intro k z hz
    rcases hz with rfl | hz
    · simp
    · rw [hvalE'_neg]
      exact Or.inr hz
  have hvalK₁_neg_bound : ∀ {k : ℤ} (z : K₁),
      (z = 0 ∨ k ≤ valL F K₁ z) → (-z = 0 ∨ k ≤ valL F K₁ (-z)) := by
    intro k z hz
    rcases hz with rfl | hz
    · simp
    · rw [hvalK₁_neg]
      exact Or.inr hz
  have hvalE'_sub : ∀ (k : ℤ) (a b : E'),
      (a = 0 ∨ k ≤ valL F E' a) → (b = 0 ∨ k ≤ valL F E' b) →
      (a - b = 0 ∨ k ≤ valL F E' (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    exact hvalE'_add k a (-b) ha (hvalE'_neg_bound b hb)
  have hvalK₁_sub : ∀ (k : ℤ) (a b : K₁),
      (a = 0 ∨ k ≤ valL F K₁ a) → (b = 0 ∨ k ≤ valL F K₁ b) →
      (a - b = 0 ∨ k ≤ valL F K₁ (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    exact hvalK₁_add k a (-b) ha (hvalK₁_neg_bound b hb)
  have hvalE'_mul_bound : ∀ {k₁ k₂ : ℤ} (a b : E'),
      (a = 0 ∨ k₁ ≤ valL F E' a) → (b = 0 ∨ k₂ ≤ valL F E' b) →
      (a * b = 0 ∨ k₁ + k₂ ≤ valL F E' (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases hab : a * b = 0
    · exact Or.inl hab
    · have ha0 : a ≠ 0 := fun h => hab (by rw [h, zero_mul])
      have hb0 : b ≠ 0 := fun h => hab (by rw [h, mul_zero])
      rcases ha with rfl | ha
      · exact False.elim (ha0 rfl)
      · rcases hb with rfl | hb
        · exact False.elim (hb0 rfl)
        · right
          rw [hvalE'_mul a b ha0 hb0]
          omega
  have hvalK₁_mul_bound : ∀ {k₁ k₂ : ℤ} (a b : K₁),
      (a = 0 ∨ k₁ ≤ valL F K₁ a) → (b = 0 ∨ k₂ ≤ valL F K₁ b) →
      (a * b = 0 ∨ k₁ + k₂ ≤ valL F K₁ (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases hab : a * b = 0
    · exact Or.inl hab
    · have ha0 : a ≠ 0 := fun h => hab (by rw [h, zero_mul])
      have hb0 : b ≠ 0 := fun h => hab (by rw [h, mul_zero])
      rcases ha with rfl | ha
      · exact False.elim (ha0 rfl)
      · rcases hb with rfl | hb
        · exact False.elim (hb0 rfl)
        · right
          rw [hvalK₁_mul a b ha0 hb0]
          omega
  have h1_add_ne0_E' : ∀ (z : E'), (z = 0 ∨ (d : ℤ) ≤ valL F E' z) → 1 + z ≠ 0 := by
    intro z hz h0
    have hz_eq : z = -1 := by linear_combination h0
    rw [hz_eq] at hz
    rcases hz with hneg1 | hval
    · exact neg_ne_zero.mpr one_ne_zero hneg1
    · rw [hvalE'_neg1] at hval
      omega
  have h1_add_ne0_K₁ : ∀ (z : K₁), (z = 0 ∨ (d : ℤ) ≤ valL F K₁ z) → 1 + z ≠ 0 := by
    intro z hz h0
    have hz_eq : z = -1 := by linear_combination h0
    rw [hz_eq] at hz
    rcases hz with hneg1 | hval
    · exact neg_ne_zero.mpr one_ne_zero hneg1
    · rw [hvalK₁_neg1] at hval
      omega
  have hinv2_int : (2 : E')⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F E' ((2 : E')⁻¹) := by
    right
    let u₂ : E'ˣ := Units.mk0 (2 : E') h2_ne0
    have hu₂ : ((u₂⁻¹ : E'ˣ) : E') = (2 : E')⁻¹ := Units.val_inv_eq_inv_val u₂
    have h1 := hvalE'_inv u₂
    rw [hu₂] at h1
    change valL F E' ((2 : E')⁻¹) = - valL F E' (2 : E') at h1
    rw [h1, hval_2]
    omega
  refine ⟨?_, ?_⟩
  · intro y hy R_pos R_neg hR_diff u_E
    have hy1 : 1 + y ≠ 0 := h1_add_ne0_K₁ y hy
    set tr_y := traceLM F hE'K₁ y
    have htry : tr_y = 0 ∨ (d : ℤ) ≤ valL F E' tr_y := htr_bound_E'K₁ (d : ℤ) y hy
    have hR_pos : R_pos = 0 ∨ (2 * d : ℤ) ≤ valL F E' R_pos := hnorm_lin_E'K₁ d hd y hy
    have hR_pos_d : R_pos = 0 ∨ (d : ℤ) ≤ valL F E' R_pos :=
      hvalE'_mono (by omega : (d : ℤ) ≤ (2 * d : ℤ)) hR_pos
    have huE_eq : u_E = tr_y + R_pos := by
      change normLM F hE'K₁ (1 + y) - 1 =
        traceLM F hE'K₁ y + (normLM F hE'K₁ (1 + y) - (1 + traceLM F hE'K₁ y))
      ring
    have huE : u_E = 0 ∨ (d : ℤ) ≤ valL F E' u_E := by
      rw [huE_eq]
      exact hvalE'_add (d : ℤ) tr_y R_pos htry hR_pos_d
    have huE1 : 1 + u_E ≠ 0 := h1_add_ne0_E' u_E huE
    refine ⟨hy1, huE, huE1, ?_⟩
    have hnegy : -y = 0 ∨ (d : ℤ) ≤ valL F K₁ (-y) := hvalK₁_neg_bound y hy
    have hR_neg : R_neg = 0 ∨ (2 * d : ℤ) ≤ valL F E' R_neg := by
      have hsub : (1 : K₁) - y = 1 + (-y) := sub_eq_add_neg 1 y
      change normLM F hE'K₁ (1 - y) - (1 + traceLM F hE'K₁ (-y)) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 - y) - (1 + traceLM F hE'K₁ (-y)))
      rw [hsub]
      exact hnorm_lin_E'K₁ d hd (-y) hnegy
    have hy2 : y ^ 2 = 0 ∨ ((2 * d : ℕ) : ℤ) ≤ valL F K₁ (y ^ 2) := by
      have hmul := hvalK₁_mul_bound y y hy hy
      rw [← sq] at hmul
      exact hvalK₁_mono (by push_cast; omega : ((2 * d : ℕ) : ℤ) ≤ (d : ℤ) + (d : ℤ)) hmul
    have hnegy2 : -(y ^ 2) = 0 ∨ ((2 * d : ℕ) : ℤ) ≤ valL F K₁ (-(y ^ 2)) :=
      hvalK₁_neg_bound (y ^ 2) hy2
    set R_sq := normLM F hE'K₁ (1 + (-(y ^ 2))) - (1 + traceLM F hE'K₁ (-(y ^ 2)))
    have hR_sq_4d : R_sq = 0 ∨ (2 * (2 * d : ℕ) : ℤ) ≤ valL F E' R_sq :=
      hnorm_lin_E'K₁ (2 * d) (by omega) (-(y ^ 2)) hnegy2
    have hR_sq : R_sq = 0 ∨ (3 * d : ℤ) ≤ valL F E' R_sq :=
      hvalE'_mono (by push_cast; omega : (3 * d : ℤ) ≤ (2 * (2 * d : ℕ) : ℤ)) hR_sq_4d
    set N_pos := normLM F hE'K₁ (1 + y)
    set N_neg := normLM F hE'K₁ (1 - y)
    set N_sq := normLM F hE'K₁ (1 + (-(y ^ 2)))
    have h_mult : N_pos * N_neg = N_sq := by
      change normLM F hE'K₁ (1 + y) * normLM F hE'K₁ (1 - y) = normLM F hE'K₁ (1 + (-(y ^ 2)))
      rw [← map_mul (normLM F hE'K₁) (1 + y) (1 - y)]
      congr 1
      ring
    set tr_y2 := traceLM F hE'K₁ (y ^ 2)
    have htr_negy : traceLM F hE'K₁ (-y) = -tr_y := map_neg (traceLM F hE'K₁) y
    have htr_negy2 : traceLM F hE'K₁ (-(y ^ 2)) = -tr_y2 := map_neg (traceLM F hE'K₁) (y ^ 2)
    have htr_quad : traceLM F hE'K₁ (2 * y - y ^ 2) = 2 * tr_y - tr_y2 := by
      have h2y : (2 : K₁) * y = y + y := two_mul y
      rw [map_sub (traceLM F hE'K₁) (2 * y) (y ^ 2), h2y, map_add (traceLM F hE'K₁) y y]
      change tr_y + tr_y - tr_y2 = 2 * tr_y - tr_y2
      ring
    have hR_neg_eq : R_neg = N_neg - (1 - tr_y) := by
      change normLM F hE'K₁ (1 - y) - (1 + traceLM F hE'K₁ (-y)) = N_neg - (1 - tr_y)
      rw [htr_negy]
      ring
    have hR_sq_eq : R_sq = N_sq - (1 - tr_y2) := by
      change normLM F hE'K₁ (1 + (-(y ^ 2))) - (1 + traceLM F hE'K₁ (-(y ^ 2))) = N_sq - (1 - tr_y2)
      rw [htr_negy2]
      ring
    have h_id1 : (2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * y - y ^ 2) =
        (R_pos - R_neg) - tr_y * (R_pos + R_neg) - R_pos * R_pos - R_pos * R_neg + R_sq := by
      rw [htr_quad, hR_neg_eq, hR_sq_eq]
      change (2 * (N_pos - 1) - (N_pos - 1) ^ 2) - (2 * tr_y - tr_y2) =
        ((N_pos - (1 + tr_y)) - (N_neg - (1 - tr_y))) -
          tr_y * ((N_pos - (1 + tr_y)) + (N_neg - (1 - tr_y))) -
          (N_pos - (1 + tr_y)) * (N_pos - (1 + tr_y)) -
          (N_pos - (1 + tr_y)) * (N_neg - (1 - tr_y)) +
          (N_sq - (1 - tr_y2))
      rw [← h_mult]
      ring
    have hR_sum : R_pos + R_neg = 0 ∨ (2 * d : ℤ) ≤ valL F E' (R_pos + R_neg) :=
      hvalE'_add (2 * d : ℤ) R_pos R_neg hR_pos hR_neg
    have hterm2 : tr_y * (R_pos + R_neg) = 0 ∨ (3 * d : ℤ) ≤ valL F E' (tr_y * (R_pos + R_neg)) :=
      hvalE'_mono (by omega : (3 * d : ℤ) ≤ (d : ℤ) + (2 * d : ℤ))
        (hvalE'_mul_bound tr_y (R_pos + R_neg) htry hR_sum)
    have hterm3 : R_pos * R_pos = 0 ∨ (3 * d : ℤ) ≤ valL F E' (R_pos * R_pos) :=
      hvalE'_mono (by omega : (3 * d : ℤ) ≤ (2 * d : ℤ) + (2 * d : ℤ))
        (hvalE'_mul_bound R_pos R_pos hR_pos hR_pos)
    have hterm4 : R_pos * R_neg = 0 ∨ (3 * d : ℤ) ≤ valL F E' (R_pos * R_neg) :=
      hvalE'_mono (by omega : (3 * d : ℤ) ≤ (2 * d : ℤ) + (2 * d : ℤ))
        (hvalE'_mul_bound R_pos R_neg hR_pos hR_neg)
    rw [h_id1]
    have hs1 := hvalE'_sub (3 * d : ℤ) (R_pos - R_neg) (tr_y * (R_pos + R_neg)) hR_diff hterm2
    have hs2 := hvalE'_sub (3 * d : ℤ) _ (R_pos * R_pos) hs1 hterm3
    have hs3 := hvalE'_sub (3 * d : ℤ) _ (R_pos * R_neg) hs2 hterm4
    exact hvalE'_add (3 * d : ℤ) _ R_sq hs3 hR_sq
  · intro x hx q_x α t y
    have h2x : 2 * x = 0 ∨ (d : ℤ) ≤ valL F E' (2 * x) := by
      rw [two_mul x]
      exact hvalE'_add (d : ℤ) x x hx hx
    have hx2 : x ^ 2 = 0 ∨ (d : ℤ) ≤ valL F E' (x ^ 2) := by
      have hmul := hvalE'_mul_bound x x hx hx
      rw [← sq] at hmul
      exact hvalE'_mono (by omega : (d : ℤ) ≤ (d : ℤ) + (d : ℤ)) hmul
    have h2x_sub_x2 : 2 * x - x ^ 2 = 0 ∨ (d : ℤ) ≤ valL F E' (2 * x - x ^ 2) :=
      hvalE'_sub (d : ℤ) (2 * x) (x ^ 2) h2x hx2
    have hqx : q_x = 0 ∨ (d : ℤ) ≤ valL F E' q_x :=
      hvalE'_mono (by omega : (d : ℤ) ≤ 0 + (d : ℤ))
        (hvalE'_mul_bound ((2 : E')⁻¹) (2 * x - x ^ 2) hinv2_int h2x_sub_x2)
    have hw₁_sq : w₁ ^ 2 = 0 ∨ (0 : ℤ) ≤ valL F K₁ (w₁ ^ 2) := by
      have hmul := hvalK₁_mul_bound w₁ w₁ hw₁_int hw₁_int
      rw [← sq] at hmul
      exact hvalK₁_mono (by omega : (0 : ℤ) ≤ 0 + 0) hmul
    have hα : α = 0 ∨ (0 : ℤ) ≤ valL F E' α := htr_bound_E'K₁ 0 (w₁ ^ 2) hw₁_sq
    have hqx2 : q_x ^ 2 = 0 ∨ (2 * d : ℤ) ≤ valL F E' (q_x ^ 2) := by
      have hmul := hvalE'_mul_bound q_x q_x hqx hqx
      rw [← sq] at hmul
      exact hvalE'_mono (by omega : (2 * d : ℤ) ≤ (d : ℤ) + (d : ℤ)) hmul
    have hinv2_α : (2 : E')⁻¹ * α = 0 ∨ (0 : ℤ) ≤ valL F E' ((2 : E')⁻¹ * α) :=
      hvalE'_mono (by omega : (0 : ℤ) ≤ 0 + 0)
        (hvalE'_mul_bound ((2 : E')⁻¹) α hinv2_int hα)
    have hquad_term : (2 : E')⁻¹ * α * q_x ^ 2 = 0 ∨
        (d : ℤ) ≤ valL F E' ((2 : E')⁻¹ * α * q_x ^ 2) :=
      hvalE'_mono (by omega : (d : ℤ) ≤ 0 + (2 * d : ℤ))
        (hvalE'_mul_bound ((2 : E')⁻¹ * α) (q_x ^ 2) hinv2_α hqx2)
    have ht : t = 0 ∨ (d : ℤ) ≤ valL F E' t :=
      hvalE'_add (d : ℤ) q_x ((2 : E')⁻¹ * α * q_x ^ 2) hqx hquad_term
    have hincl_t : IntermediateField.inclusion hE'K₁ t = 0 ∨
        (d : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ t) := by
      rcases ht with h0 | ht_val
      · left
        rw [h0, map_zero]
      · right
        rw [hval_E'K₁ t]
        exact ht_val
    have hy : y = 0 ∨ (d : ℤ) ≤ valL F K₁ y :=
      hvalK₁_mono (by omega : (d : ℤ) ≤ (d : ℤ) + 0)
        (hvalK₁_mul_bound (IntermediateField.inclusion hE'K₁ t) w₁ hincl_t hw₁_int)
    refine ⟨ht, hy, ?_⟩
    have htr_y : traceLM F hE'K₁ y = t := by
      change traceLM F hE'K₁ (IntermediateField.inclusion hE'K₁ t * w₁) = t
      rw [htr_lin t w₁, hw₁_tr, mul_one]
    have hy2_eq : y ^ 2 = IntermediateField.inclusion hE'K₁ (t ^ 2) * w₁ ^ 2 := by
      change (IntermediateField.inclusion hE'K₁ t * w₁) ^ 2 =
        IntermediateField.inclusion hE'K₁ (t ^ 2) * w₁ ^ 2
      rw [mul_pow, map_pow]
    have htr_y2 : traceLM F hE'K₁ (y ^ 2) = t ^ 2 * α := by
      rw [hy2_eq, htr_lin (t ^ 2) (w₁ ^ 2)]
    have htr_2y_y2 : traceLM F hE'K₁ (2 * y - y ^ 2) = 2 * t - t ^ 2 * α := by
      have h2y : (2 : K₁) * y = y + y := two_mul y
      rw [map_sub (traceLM F hE'K₁) (2 * y) (y ^ 2), h2y, map_add (traceLM F hE'K₁) y y,
        htr_y, htr_y2]
      ring
    have h2_inv : (2 : E') * (2 : E')⁻¹ = 1 := mul_inv_cancel₀ h2_ne0
    have h_id2 : traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2) =
        - (α ^ 2 * q_x ^ 3) - ((2 : E')⁻¹) ^ 2 * (α ^ 3 * q_x ^ 4) := by
      rw [htr_2y_y2]
      change (2 * ((2 : E')⁻¹ * (2 * x - x ^ 2) + (2 : E')⁻¹ * α * q_x ^ 2) -
          (q_x + (2 : E')⁻¹ * α * q_x ^ 2) ^ 2 * α) -
          (2 * x - x ^ 2) =
        - (α ^ 2 * q_x ^ 3) - ((2 : E')⁻¹) ^ 2 * (α ^ 3 * q_x ^ 4)
      linear_combination (2 * x - x ^ 2 + α * q_x ^ 2 - α ^ 2 * q_x ^ 3) * h2_inv
    have hα2 : α ^ 2 = 0 ∨ (0 : ℤ) ≤ valL F E' (α ^ 2) := by
      have hmul := hvalE'_mul_bound α α hα hα
      rw [← sq] at hmul
      exact hvalE'_mono (by omega : (0 : ℤ) ≤ 0 + 0) hmul
    have hα3 : α ^ 3 = 0 ∨ (0 : ℤ) ≤ valL F E' (α ^ 3) := by
      have hpow : α ^ 3 = α ^ 2 * α := by ring
      rw [hpow]
      exact hvalE'_mono (by omega : (0 : ℤ) ≤ 0 + 0) (hvalE'_mul_bound (α ^ 2) α hα2 hα)
    have hqx3 : q_x ^ 3 = 0 ∨ (3 * d : ℤ) ≤ valL F E' (q_x ^ 3) := by
      have hpow : q_x ^ 3 = q_x ^ 2 * q_x := by ring
      rw [hpow]
      exact hvalE'_mono (by omega : (3 * d : ℤ) ≤ (2 * d : ℤ) + (d : ℤ))
        (hvalE'_mul_bound (q_x ^ 2) q_x hqx2 hqx)
    have hqx4 : q_x ^ 4 = 0 ∨ (3 * d : ℤ) ≤ valL F E' (q_x ^ 4) := by
      have hpow : q_x ^ 4 = q_x ^ 3 * q_x := by ring
      rw [hpow]
      exact hvalE'_mono (by omega : (3 * d : ℤ) ≤ (3 * d : ℤ) + (d : ℤ))
        (hvalE'_mul_bound (q_x ^ 3) q_x hqx3 hqx)
    have hinv2_sq : ((2 : E')⁻¹) ^ 2 = 0 ∨ (0 : ℤ) ≤ valL F E' (((2 : E')⁻¹) ^ 2) := by
      have hmul := hvalE'_mul_bound ((2 : E')⁻¹) ((2 : E')⁻¹) hinv2_int hinv2_int
      rw [← sq] at hmul
      exact hvalE'_mono (by omega : (0 : ℤ) ≤ 0 + 0) hmul
    have hterm_cub : - (α ^ 2 * q_x ^ 3) = 0 ∨
        (3 * d : ℤ) ≤ valL F E' (- (α ^ 2 * q_x ^ 3)) :=
      hvalE'_neg_bound (α ^ 2 * q_x ^ 3)
        (hvalE'_mono (by omega : (3 * d : ℤ) ≤ 0 + (3 * d : ℤ))
          (hvalE'_mul_bound (α ^ 2) (q_x ^ 3) hα2 hqx3))
    have hα3_qx4 : α ^ 3 * q_x ^ 4 = 0 ∨ (3 * d : ℤ) ≤ valL F E' (α ^ 3 * q_x ^ 4) :=
      hvalE'_mono (by omega : (3 * d : ℤ) ≤ 0 + (3 * d : ℤ))
        (hvalE'_mul_bound (α ^ 3) (q_x ^ 4) hα3 hqx4)
    have hterm_quart : ((2 : E')⁻¹) ^ 2 * (α ^ 3 * q_x ^ 4) = 0 ∨
        (3 * d : ℤ) ≤ valL F E' (((2 : E')⁻¹) ^ 2 * (α ^ 3 * q_x ^ 4)) :=
      hvalE'_mono (by omega : (3 * d : ℤ) ≤ 0 + (3 * d : ℤ))
        (hvalE'_mul_bound (((2 : E')⁻¹) ^ 2) (α ^ 3 * q_x ^ 4) hinv2_sq hα3_qx4)
    rw [h_id2]
    exact hvalE'_sub (3 * d : ℤ) (- (α ^ 2 * q_x ^ 3))
      (((2 : E')⁻¹) ^ 2 * (α ^ 3 * q_x ^ 4)) hterm_cub hterm_quart

theorem ld_unramified_norm_quad_log_congruence (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_eq : p = EllipticRootNumber.p F) (hp_odd : EllipticRootNumber.p F ≠ 2)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = (p : ℤ) * valL F K₁ w)
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hnorm_lin_E'K₁ : ∀ (d : ℕ), 1 ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w))))
    (w₁ : K₁) (hw₁_int : w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) (hw₁_tr : traceLM F hE'K₁ w₁ = 1)
    (d : ℕ) (hd : 1 ≤ d)
    (x : E') (hx_val : x = 0 ∨ (d : ℤ) ≤ valL F E' x) :
    ∃ y : K₁,
      (y = 0 ∨ (d : ℤ) ≤ valL F K₁ y) ∧
      1 + y ≠ 0 ∧
      let u_E := normLM F hE'K₁ (1 + y) - 1
      (u_E = 0 ∨ (d : ℤ) ≤ valL F E' u_E) ∧
      1 + u_E ≠ 0 ∧
      ((2 * u_E - u_E ^ 2) - (2 * x - x ^ 2) = 0 ∨
        (3 * d : ℤ) ≤ valL F E' ((2 * u_E - u_E ^ 2) - (2 * x - x ^ 2))) ∧
      (traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2) = 0 ∨
        (3 * d : ℤ) ≤ valL F E' (traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2))) :=
by
  obtain ⟨hvalE'0, hvalE'1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, hvalE'_surj,
    hvalE'_add, _, _, _⟩ := ld_valL_and_unitGroup_props F E'
  obtain ⟨hvalK₁0, hvalK₁1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, hvalK₁_surj,
    hvalK₁_add, _, _, _⟩ := ld_valL_and_unitGroup_props F K₁
  have hvalE'_props8 : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) :=
    ⟨hvalE'0, hvalE'1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, hvalE'_surj, hvalE'_add⟩
  have hvalE'_props7 : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) :=
    ⟨hvalE'0, hvalE'1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, hvalE'_add⟩
  have hvalK₁_props6 : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) :=
    ⟨hvalK₁0, hvalK₁1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_add⟩
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F E'
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F E' hvalE'0 hvalE'_neg hvalE'_mul hvalE'_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_E', hField_kE', hFintype_kE', resE', hresE'_0, hresE'_1, hresE'_ring,
    hresE'_ker, hresE'_surj⟩ :=
    ld_valL_residue_field_exists F E' hvalE'0 hvalE'1 hvalE'_neg1 hvalE'_neg hvalE'_mul
      hvalE'_inv hvalE'_add S₁ hS₁
  letI : Field k_E' := hField_kE'
  letI : Fintype k_E' := hFintype_kE'
  obtain ⟨_, hp_zero_k', hp_val_E''⟩ :=
    ld_valL_residue_field_card_eq_qL F E' hvalE'_props8
      ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩
      k_E' resE' hresE'_0 hresE'_1 hresE'_ring hresE'_ker hresE'_surj
  have hp_zero_k : ((p : ℕ) : k_E') = 0 := by rw [hp_eq]; exact hp_zero_k'
  have hp_val_E' : ((p : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((p : ℕ) : E') := by
    rw [hp_eq]; exact hp_val_E''
  have hp_odd' : p ≠ 2 := by rw [hp_eq]; exact hp_odd
  obtain ⟨htr_lin, _, c, hcp, hc_poly⟩ :=
    ld_unramified_charpoly_norm_poly_expansion F E' K₁ hE'K₁ p hPrime
      hvalE'1 hvalE'_mul hvalE'_surj hval_E'K₁ hval_norm_E'K₁ w₁ hw₁_tr
  obtain ⟨h2_ne0, hval_2, _, hodd_cancel⟩ :=
    ld_unramified_poly_coeff_integrality_and_odd_cancel F E' K₁ hE'K₁ p hPrime hp_odd'
      hvalE'_props8 hvalK₁_props6 hval_E'K₁ hval_norm_E'K₁
      k_E' resE' hresE'_0 hresE'_1 hresE'_ring hresE'_ker hresE'_surj
      hp_zero_k hp_val_E' w₁ hw₁_int hw₁_tr htr_lin c hcp hc_poly
  obtain ⟨hnorm_tr_diff, ht_and_tr⟩ :=
    ld_unramified_even_odd_norm_trace_congruence F E' K₁ hE'K₁ p hPrime
      h2_ne0 hval_2 hvalE'_props7 hvalK₁_props6 hval_E'K₁
      htr_bound_E'K₁ hnorm_lin_E'K₁ htr_lin w₁ hw₁_int hw₁_tr d hd
  set q_x : E' := (2 : E')⁻¹ * (2 * x - x ^ 2)
  set α : E' := traceLM F hE'K₁ (w₁ ^ 2)
  set t : E' := q_x + (2 : E')⁻¹ * α * q_x ^ 2
  set y : K₁ := IntermediateField.inclusion hE'K₁ t * w₁
  obtain ⟨ht_val, hy_val, htr_quad⟩ := ht_and_tr x hx_val
  obtain ⟨hy_ne0, hu_E_val, hu_E_ne0, hu_tr_diff⟩ :=
    hnorm_tr_diff y hy_val (hodd_cancel d t ht_val)
  set u_E : E' := normLM F hE'K₁ (1 + y) - 1
  have hu_E_quad : (2 * u_E - u_E ^ 2) - (2 * x - x ^ 2) = 0 ∨
      (3 * d : ℤ) ≤ valL F E' ((2 * u_E - u_E ^ 2) - (2 * x - x ^ 2)) := by
    have hsum := hvalE'_add (3 * d : ℤ)
      ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * y - y ^ 2))
      (traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2))
      hu_tr_diff htr_quad
    have heq : ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * y - y ^ 2)) +
        (traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2)) =
        (2 * u_E - u_E ^ 2) - (2 * x - x ^ 2) := by ring
    rw [heq] at hsum
    exact hsum
  exact ⟨y, hy_val, hy_ne0, hu_E_val, hu_E_ne0, hu_E_quad, htr_quad⟩

theorem ld_wild_norm_quad_pullback_and_tower_trace (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ) (hp_def : p = Module.finrank L (IntermediateField.extendScalars hLE'))
    (hPrime : Nat.Prime p) (hp_odd : EllipticRootNumber.p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (T mM₁' mE' : ℕ) (hT_ge2 : 2 ≤ T) (hStable : 2 * T ≤ mM₁')
    (hmE'_eq : mE' = T + p * (mM₁' - T))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (T : ℤ))
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hq_norm_tr_K₁ : ∀ (h : ℕ) (w : K₁),
      (w = 0 ∨ (((T + p * h) / 2 : ℕ) : ℤ) ≤ valL F K₁ w) →
      let u := normLM F hM₁'K₁ (1 + w) - 1
      let q_w := (2 : K₁)⁻¹ * (2 * w - w ^ 2)
      (2 * u - u ^ 2) - (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w) = 0 ∨
        ((T + h : ℕ) : ℤ) ≤
          valL F M₁' ((2 * u - u ^ 2) -
            (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w))) :
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    (∀ (a : L) (w : K₁),
      ψM₁' (IntermediateField.inclusion hLM₁' a * traceLM F hM₁'K₁ w) =
        ψE' (IntermediateField.inclusion hLE' a * traceLM F hE'K₁ w)) ∧
    (∀ (c : E'ˣ) (a b : E'),
      valL F E' (c : E') = (mE' : ℤ) + condExpChar F E' ψE' →
      (a - b = 0 ∨ (mE' : ℤ) ≤ valL F E' (a - b)) →
      ψE' (((c⁻¹ : E'ˣ) : E') * a) = ψE' (((c⁻¹ : E'ˣ) : E') * b)) ∧
    (∀ (c : M₁'ˣ) (a b : M₁'),
      valL F M₁' (c : M₁') = (mM₁' : ℤ) + condExpChar F M₁' ψM₁' →
      (a - b = 0 ∨ (mM₁' : ℤ) ≤ valL F M₁' (a - b)) →
      ψM₁' (((c⁻¹ : M₁'ˣ) : M₁') * a) = ψM₁' (((c⁻¹ : M₁'ˣ) : M₁') * b)) ∧
    (∀ y : K₁, (y = 0 ∨ ((mE' / 2 : ℕ) : ℤ) ≤ valL F K₁ y) →
      let u_M := normLM F hM₁'K₁ (1 + y) - 1
      (u_M = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' u_M) ∧
      1 + u_M ≠ 0 ∧
      ((2 * u_M - u_M ^ 2) - traceLM F hM₁'K₁ (2 * y - y ^ 2) = 0 ∨
        (mM₁' : ℤ) ≤ valL F M₁' ((2 * u_M - u_M ^ 2) - traceLM F hM₁'K₁ (2 * y - y ^ 2)))) :=
by
  
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  haveI : IsScalarTower F M₁' (IntermediateField.extendScalars hM₁'K₁) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional F (IntermediateField.extendScalars hM₁'K₁) :=
    inferInstanceAs (FiniteDimensional F K₁)
