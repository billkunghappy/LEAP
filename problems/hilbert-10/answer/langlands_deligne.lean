theorem ld_ch12_wild_dyadic_even_breaks_higher_cond_simultaneous_stationary_origin (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
