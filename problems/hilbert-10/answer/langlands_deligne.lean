    let a_coeff : Fin (r + 1) → M_C := fun k => f₁ k + f₂ k
    let P_poly : M_C → M_C := fun z =>
      z ^ q + ∑ j : Fin (r + 1), (a_coeff j) * (z ^ ((p F) ^ (j : ℕ)))
    refine ⟨P_poly, a_coeff, ?_, ?_, ?_, ?_⟩
    · 
      intro k
      have hf₁ : P_MC 0 (f₁ k) := by
        dsimp [f₁]
        split_ifs with hk
        · exact hPMC_mul0 0 (hc_int ⟨k.1, hk⟩) (hPMC_pow hb0_MC_int ((p F) ^ k.1))
        · exact hPMC_pow hb0_MC_int ((p F) ^ r)
      have hf₂ : P_MC 0 (f₂ k) := by
        dsimp [f₂]
        split_ifs with hk0
        · exact hPMC_zero 0
        · exact hc_int ⟨k.1 - 1, by omega⟩
      exact hPMC_add 0 hf₁ hf₂
    · 
      have ha0_val : a_coeff ⟨0, Nat.succ_pos r⟩ = c_coeff ⟨0, hr_pos⟩ * b₀_MC := by
        have hr_0lt : 0 < r := hr_pos
        dsimp [a_coeff, f₁, f₂]
        rw [dif_pos hr_0lt, pow_one, add_zero]
      let Δ_b₀ : M_1 := b₀ - IntermediateField.inclusion hMC_M1 b₀_MC
      have hΔ_b₀ : P_M1 1 Δ_b₀ := hb0_diff
      let w_rem : M_1 := Δ_b₀ * ((ϖ_M1 ^ t : M_1ˣ) : M_1)
      have hw_rem : P_M1 (t + 1 : ℤ) w_rem := hPM1_mul_ϖt hΔ_b₀
      have hb₀_mul : b₀ * ((ϖ_M1 ^ t : M_1ˣ) : M_1) = traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K) := by
        change ((((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) * traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K)) *
            ((ϖ_M1 ^ t : M_1ˣ) : M_1) = traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K)
        have hinv : (((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) * ((ϖ_M1 ^ t : M_1ˣ) : M_1) = 1 :=
          Units.inv_mul (ϖ_M1 ^ t)
        linear_combination (traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K)) * hinv
      have htr_K_split : traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) =
          b₀_MC * traceLM F hMC_M1 ((ϖ_M1 ^ t : M_1ˣ) : M_1) + traceLM F hMC_M1 w_rem := by
        rw [htrace_trans ((ϖ_K ^ t : Kˣ) : K), ← hb₀_mul]
        have hsplit : b₀ * ((ϖ_M1 ^ t : M_1ˣ) : M_1) =
