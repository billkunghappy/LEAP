        rwa [add_zero] at hmul
      
      have hgh_sum := hvalL_add (bE' : ℤ) _ _ hg_eq hh_eq
      have htr_x_sub : trLE' (x * (1 - s₀)) = trLE' x - trLE' (x * s₀) := by
        have h1 : x * (1 - s₀) = x - x * s₀ := by ring
        rw [h1, trLE'.map_sub]
      have hgh_ring :
          (g_fn z_k - ((p - 1 : ℕ) : R_L) * trLE' (x * (1 - s₀))) + (h_fn z_k - C_0) =
