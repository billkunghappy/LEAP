      intro r hr
      rcases Nat.eq_or_lt_of_le (Finset.mem_Icc.mp hr).2 with rfl | hlt
      · exact hd_top
      · exact ih d hd_low r
          (Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp hr).1, Nat.lt_succ_iff.mp hlt⟩)
  have hp_mem : p ∈ Finset.Icc 1 (p * p) :=
    Finset.mem_Icc.mpr ⟨hPrime.pos, Nat.le_mul_self p⟩
  have hAp_eq_Bp : A p = B p :=
    sub_eq_zero.mp (hpoly_zero_L (p * p) (fun w => A w - B w) hdiff_sum_zero p hp_mem)
