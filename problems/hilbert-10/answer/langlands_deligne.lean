theorem ld_ch14_lemma_14_2b_wild_semidirect_stickelberger_2p (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hDegSum : (D_orb.map fun t => Module.finrank L (IntermediateField.extendScalars t.le)).sum =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (h_ge2 : 2 ≤ condExp F L (recChar F rec L χL_ext))
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L (recChar F rec L χL_ext)),
      (recChar F rec L χL_ext) u = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E
        (condExp F E ((recChar F rec L χL_ext).comp (Units.map (normLM F hLE)))),
      ((recChar F rec L χL_ext).comp (Units.map (normLM F hLE))) u = 1)
    (hOrb_rec : ∀ t ∈ D_orb,
      FiniteDimensional F t.field ∧
      IsGaloisExt F t.field K ∧
      IsGaloisExt F t.field M_C ∧
      Algebra.IsSeparable L (IntermediateField.extendScalars t.le) ∧
      IsAdmissibleChar F t.field (traceChar F t.le ψ) ∧
      (recChar F rec t.field t.χ) ^ (p F) = 1 ∧
      recChar F rec t.field t.χ ≠ 1 ∧
      (∀ u ∈ unitGroup F t.field (condExp F t.field (recChar F rec t.field t.χ)),
        (recChar F rec t.field t.χ) u = 1) ∧
      (∀ u ∈ unitGroup F t.field
          (condExp F t.field
            (recChar F rec t.field t.χ *
              (recChar F rec L χL_ext).comp (Units.map (normLM F t.le)))),
        (recChar F rec t.field t.χ *
