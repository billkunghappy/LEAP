        have hinc_ne : ιE y ≠ 0 := (map_ne_zero_iff ιE ιE.injective).mpr hy0
        rw [hvK_mul _ _ hinc_ne (hvK_Δ_pow k).1, hv_EK y, (hvK_Δ_pow k).2]
        have hp_pos : (0 : ℤ) ≤ (p : ℤ) := Nat.cast_nonneg p
