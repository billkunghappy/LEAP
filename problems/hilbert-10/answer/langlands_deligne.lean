        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : L, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F L z ≤ valL F L w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F L) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfL_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : L) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F L x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F L y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    exact ⟨hfL_pos, hdiv, hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩

  obtain ⟨hresDeg_K_pos, hdiv_K, hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv,
    hvalK_surj, hvalK_add⟩ := h_valL_props K

  have h_addVal_props :
      addVal F 1 = 0 ∧
      (∀ a : F, addVal F (-a) = addVal F a) ∧
      (∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b) ∧
      (∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a) ∧
      (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        (algebraMap F K a = 0 ∨ 0 ≤ valL F K (algebraMap F K a))) ∧
      (∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F K a = 0 ∨ 1 ≤ valL F K (algebraMap F K a))) ∧
      ∃ R_F : Finset F,
        (∀ r ∈ R_F, r = 0 ∨ 0 ≤ addVal F r) ∧
        (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
          ∃ r ∈ R_F, a - r = 0 ∨ 1 ≤ addVal F (a - r)) := by
    clear! L M_C E hp_prime r_exp
    set φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have haddVal1 : addVal F 1 = 0 := by
      unfold addVal
      rw [dif_neg one_ne_zero]
      have hφ1 : φ (valuation F 1) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr one_ne_zero)
      have hunz1 : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz1, toAdd_one, neg_zero]
    have haddVal_neg : ∀ a : F, addVal F (-a) = addVal F a := by
      intro a
      by_cases ha : a = 0
      · simp [ha]
      · have hna : -a ≠ 0 := neg_ne_zero.mpr ha
        unfold addVal
        simp [ha, hna, Valuation.map_neg]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hφa : φ (valuation F a) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      have hφb : φ (valuation F b) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hb)
      have hφab : φ (valuation F (a * b)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hab)
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_inv : ∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a := by
      intro a ha
      have hainv : a⁻¹ ≠ 0 := inv_ne_zero ha
      have hmul := haddVal_mul a a⁻¹ ha hainv
      rw [mul_inv_cancel₀ ha, haddVal1] at hmul
      omega
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hφa : φ (valuation F a) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      have hφan : φ (valuation F (a ^ n)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr han)
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := fun h0 => hφπ_ne (by simp [h0])
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : K := algebraMap F K π
    have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F K x₀ = (Module.finrank F K : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F K) hπ_ne, hadd_π, mul_one]
    set S_deg : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : K, x ≠ 0 ∧ relVal F K x = k}
    have hmem_deg : Module.finrank F K ∈ S_deg :=
      ⟨Module.finrank_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfK_le : resDeg F K ≤ Module.finrank F K := Nat.sInf_le hmem_deg
    have hvalK_alg : ∀ a : F, a ≠ 0 →
        valL F K (algebraMap F K a) =
          ((Module.finrank F K : ℤ) * addVal F a) / (resDeg F K : ℤ) := by
      intro a ha
      unfold valL relVal
      rw [Algebra.norm_algebraMap, haddVal_pow a (Module.finrank F K) ha]
    have halg0 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        (algebraMap F K a = 0 ∨ 0 ≤ valL F K (algebraMap F K a)) := by
      intro a ha_opt
      by_cases ha : a = 0
      · left; simp [ha]
      · right
        have ha0 : 0 ≤ addVal F a := ha_opt.resolve_left ha
        rw [hvalK_alg a ha]
        exact Int.ediv_nonneg (mul_nonneg (Nat.cast_nonneg _) ha0) (Nat.cast_nonneg _)
    have halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F K a = 0 ∨ 1 ≤ valL F K (algebraMap F K a)) := by
      intro a ha_opt
      by_cases ha : a = 0
      · left; simp [ha]
      · right
        have ha1 : 1 ≤ addVal F a := ha_opt.resolve_left ha
        rw [hvalK_alg a ha]
        have hfK_posZ : (0 : ℤ) < (resDeg F K : ℤ) := Nat.cast_pos.mpr hresDeg_K_pos
        have hfK_leZ : (resDeg F K : ℤ) ≤ (Module.finrank F K : ℤ) := Nat.cast_le.mpr hfK_le
        exact Int.le_ediv_of_mul_le hfK_posZ (by nlinarith)
    have hmem_O : ∀ a : F, a ∈ 𝒪[F] ↔ (a = 0 ∨ 0 ≤ addVal F a) := by
      intro a
      by_cases ha : a = 0
      · simp [ha]
      · have hφa : φ (valuation F a) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
        have hle_iff : valuation F a ≤ 1 ↔ 0 ≤ addVal F a := by
          rw [← map_le_map_iff φ, map_one, ← WithZero.coe_unzero hφa, ← WithZero.coe_one,
            WithZero.coe_le_coe, ← Multiplicative.toAdd_le, toAdd_one]
          unfold addVal
          rw [dif_neg ha]
          omega
        rw [Valuation.mem_integer_iff, hle_iff]
        simp [ha]
    have hres_zero : ∀ x : 𝒪[F],
        IsLocalRing.residue 𝒪[F] x = 0 ↔ ((x : F) = 0 ∨ 1 ≤ addVal F (x : F)) := by
      intro x
      have hker : IsLocalRing.residue 𝒪[F] x = 0 ↔ valuation F (x : F) < 1 := by
        rw [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one]
      by_cases hx : (x : F) = 0
      · rw [hker]
        simp [hx, zero_lt_one]
      · have hφx : φ (valuation F (x : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hx)
        have hlt_iff : valuation F (x : F) < 1 ↔ 1 ≤ addVal F (x : F) := by
          rw [← map_lt_map_iff φ, map_one, ← WithZero.coe_unzero hφx, ← WithZero.coe_one,
            WithZero.coe_lt_coe, ← Multiplicative.toAdd_lt, toAdd_one]
          unfold addVal
          rw [dif_neg hx]
          omega
        rw [hker, hlt_iff]
        simp [hx]
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    let s : 𝓀[F] → 𝒪[F] := Function.surjInv (IsLocalRing.residue_surjective (R := 𝒪[F]))
    have hs_eq : ∀ c : 𝓀[F], IsLocalRing.residue 𝒪[F] (s c) = c :=
      Function.surjInv_eq (IsLocalRing.residue_surjective (R := 𝒪[F]))
    let R_F : Finset F := Finset.univ.image (fun c : 𝓀[F] => ((s c : 𝒪[F]) : F))
    have hRF_0 : ∀ r ∈ R_F, r = 0 ∨ 0 ≤ addVal F r := by
      intro r hr
      rcases Finset.mem_image.mp hr with ⟨c, _, rfl⟩
      exact (hmem_O ((s c : 𝒪[F]) : F)).mp (s c).2
    have hRF_mod1 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        ∃ r ∈ R_F, a - r = 0 ∨ 1 ≤ addVal F (a - r) := by
      intro a ha_opt
      have ha_mem : a ∈ 𝒪[F] := (hmem_O a).mpr ha_opt
      let x : 𝒪[F] := ⟨a, ha_mem⟩
      let c : 𝓀[F] := IsLocalRing.residue 𝒪[F] x
      refine ⟨((s c : 𝒪[F]) : F), Finset.mem_image.mpr ⟨c, Finset.mem_univ c, rfl⟩, ?_⟩
      have hres_diff : IsLocalRing.residue 𝒪[F] (x - s c) = 0 := by
        rw [map_sub, hs_eq c, sub_self]
      have hdiff := (hres_zero (x - s c)).mp hres_diff
      simpa [x] using hdiff
    exact ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩

  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halgK0, halgK1,
    R_F, hRF_0, hRF_mod1⟩ := h_addVal_props

  have h_S₁_K : ∃ S₁ : Finset K,
      ∀ x : K, (x = 0 ∨ 0 ≤ valL F K x) →
        ∃ s ∈ S₁, x - s = 0 ∨ (1 : ℤ) ≤ valL F K (x - s) := by
    clear! L M_C E hp_prime r_exp
    have hP_neg : ∀ (k : ℤ) (x : K),
        (x = 0 ∨ k ≤ valL F K x) → (-x = 0 ∨ k ≤ valL F K (-x)) := by
      rintro k x (rfl | hx)
      · exact Or.inl neg_zero
      · right
        rw [hvalK_neg]
        exact hx
    have hP_sub : ∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x - y = 0 ∨ k ≤ valL F K (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      exact hvalK_add k x (-y) hx (hP_neg k y hy)
    have hP_sum : ∀ (k : ℤ) {m : ℕ} (A_fin : Finset (Fin m)) (f : Fin m → K),
        (∀ i ∈ A_fin, f i = 0 ∨ k ≤ valL F K (f i)) →
          ((∑ i ∈ A_fin, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ A_fin, f i)) := by
      intro k m A_fin f
      induction A_fin using Finset.induction_on with
      | empty =>
        intro _
        exact Or.inl Finset.sum_empty
      | @insert j s hj ih =>
        intro hf
        rw [Finset.sum_insert hj]
        exact hvalK_add k (f j) (∑ i ∈ s, f i)
          (hf j (Finset.mem_insert_self j s))
          (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
    have hP_smul1 : ∀ (a : F) (x : K),
        (a = 0 ∨ 1 ≤ addVal F a) → (x = 0 ∨ 0 ≤ valL F K x) →
          (a • x = 0 ∨ (1 : ℤ) ≤ valL F K (a • x)) := by
      intro a x ha hx
      rw [Algebra.smul_def]
      by_cases ha0 : algebraMap F K a = 0
      · left
        rw [ha0, zero_mul]
      · by_cases hx0 : x = 0
        · left
          rw [hx0, mul_zero]
        · right
          have ha_ge : (1 : ℤ) ≤ valL F K (algebraMap F K a) := (halgK1 a ha).resolve_left ha0
          have hx_ge : 0 ≤ valL F K x := hx.resolve_left hx0
          rw [hvalK_mul _ _ ha0 hx0]
          omega
    have hP_smul01 : ∀ (a : F) (x : K),
        (a = 0 ∨ 0 ≤ addVal F a) → (x = 0 ∨ (1 : ℤ) ≤ valL F K x) →
          (a • x = 0 ∨ (1 : ℤ) ≤ valL F K (a • x)) := by
      intro a x ha hx
      rw [Algebra.smul_def]
      by_cases ha0 : algebraMap F K a = 0
      · left
        rw [ha0, zero_mul]
      · by_cases hx0 : x = 0
        · left
          rw [hx0, mul_zero]
        · right
          have ha_ge : 0 ≤ valL F K (algebraMap F K a) := (halgK0 a ha).resolve_left ha0
          have hx_ge : (1 : ℤ) ≤ valL F K x := hx.resolve_left hx0
          rw [hvalK_mul _ _ ha0 hx0]
          omega
    by_contra h_no_S₁
    have h_avoid : ∀ S₁ : Finset K, ∃ x : K,
        (x = 0 ∨ 0 ≤ valL F K x) ∧
        ∀ s ∈ S₁, ¬ (x - s = 0 ∨ (1 : ℤ) ≤ valL F K (x - s)) := by
      intro S₁
      by_contra h_all
      apply h_no_S₁
      refine ⟨S₁, fun x hx => ?_⟩
      by_contra h_none
      exact h_all ⟨x, hx, fun s hs hxs => h_none ⟨s, hs, hxs⟩⟩
    have h_seq : ∀ m : ℕ, ∃ v : Fin m → K,
        (∀ i : Fin m, v i = 0 ∨ 0 ≤ valL F K (v i)) ∧
        (∀ c : Fin m → F,
          (∀ i : Fin m, c i = 0 ∨ 0 ≤ addVal F (c i)) →
          ((∑ i : Fin m, c i • v i) = 0 ∨ (1 : ℤ) ≤ valL F K (∑ i : Fin m, c i • v i)) →
          ∀ i : Fin m, c i = 0 ∨ 1 ≤ addVal F (c i)) := by
      intro m
      induction m with
      | zero =>
        exact ⟨Fin.elim0, fun i => Fin.elim0 i, fun _ _ _ i => Fin.elim0 i⟩
      | succ m ih =>
        rcases ih with ⟨v, hv0, hv_ind⟩
        let S_m : Finset K :=
          (Fintype.piFinset (fun _ : Fin m => R_F)).image
            (fun r : Fin m → F => ∑ i : Fin m, r i • v i)
        obtain ⟨v₀, hv₀_0, hv₀_not⟩ := h_avoid S_m
        refine ⟨Fin.cons v₀ v, ?_, ?_⟩
        · intro i
          refine Fin.cases ?_ ?_ i
          · rw [Fin.cons_zero]
            exact hv₀_0
          · intro j
            rw [Fin.cons_succ]
            exact hv0 j
        · intro c hc0 hsum
          have hsum' : (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) = 0 ∨
              (1 : ℤ) ≤ valL F K (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) := by
            simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ] at hsum
            exact hsum
          have hc0_1 : c 0 = 0 ∨ 1 ≤ addVal F (c 0) := by
            by_contra hc0_not1
            have hc0_ne : c 0 ≠ 0 := fun h0 => hc0_not1 (Or.inl h0)
            have hc0_lt1 : ¬ (1 ≤ addVal F (c 0)) := fun h1 => hc0_not1 (Or.inr h1)
            have hc0_ge0 : 0 ≤ addVal F (c 0) := (hc0 0).resolve_left hc0_ne
            have hc0_val : addVal F (c 0) = 0 := by omega
            have hc0_inv_ne : (c 0)⁻¹ ≠ 0 := inv_ne_zero hc0_ne
            have hc0_inv_val : addVal F (c 0)⁻¹ = 0 := by
              rw [haddVal_inv (c 0) hc0_ne, hc0_val, neg_zero]
            have hc0_inv_0 : (c 0)⁻¹ = 0 ∨ 0 ≤ addVal F (c 0)⁻¹ := Or.inr (by omega)
            let a : Fin m → F := fun i => - ((c 0)⁻¹ * c i.succ)
            have ha0 : ∀ i : Fin m, a i = 0 ∨ 0 ≤ addVal F (a i) := by
              intro i
              by_cases hci : c i.succ = 0
              · left
                dsimp [a]
                rw [hci, mul_zero, neg_zero]
              · right
                dsimp [a]
                rw [haddVal_neg, haddVal_mul _ _ hc0_inv_ne hci, hc0_inv_val, zero_add]
                exact (hc0 i.succ).resolve_left hci
            let r : Fin m → F := fun i => (hRF_mod1 (a i) (ha0 i)).choose
            have hr_mem : ∀ i : Fin m, r i ∈ R_F :=
              fun i => (hRF_mod1 (a i) (ha0 i)).choose_spec.1
            have hr_mod : ∀ i : Fin m, a i - r i = 0 ∨ 1 ≤ addVal F (a i - r i) :=
              fun i => (hRF_mod1 (a i) (ha0 i)).choose_spec.2
            let s : K := ∑ i : Fin m, r i • v i
            have hs_mem : s ∈ S_m :=
              Finset.mem_image.mpr ⟨r, Fintype.mem_piFinset.mpr hr_mem, rfl⟩
            have hid : v₀ - s =
                (c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) +
                  ∑ i : Fin m, (a i - r i) • v i := by
              have h1 : (c 0)⁻¹ • (c 0 • v₀) = v₀ := by
                rw [smul_smul, inv_mul_cancel₀ hc0_ne, one_smul]
              have h2 : ∀ i : Fin m,
                  (c 0)⁻¹ • (c i.succ • v i) + (a i - r i) • v i =
                    -(r i • v i) := by
                intro i
                dsimp [a]
                rw [smul_smul, sub_smul, neg_smul]
                abel
              dsimp [s]
              rw [smul_add, h1, Finset.smul_sum, add_assoc, ← Finset.sum_add_distrib,
                Finset.sum_congr rfl fun i _ => h2 i, Finset.sum_neg_distrib, sub_eq_add_neg]
            have hterm1 : (c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) = 0 ∨
                (1 : ℤ) ≤ valL F K ((c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i)) :=
              hP_smul01 (c 0)⁻¹ _ hc0_inv_0 hsum'
            have hterm2 : (∑ i : Fin m, (a i - r i) • v i) = 0 ∨
                (1 : ℤ) ≤ valL F K (∑ i : Fin m, (a i - r i) • v i) :=
              hP_sum 1 Finset.univ (fun i => (a i - r i) • v i)
                (fun i _ => hP_smul1 (a i - r i) (v i) (hr_mod i) (hv0 i))
            have hv₀_s : v₀ - s = 0 ∨ (1 : ℤ) ≤ valL F K (v₀ - s) := by
              rw [hid]
              exact hvalK_add 1 _ _ hterm1 hterm2
            exact hv₀_not s hs_mem hv₀_s
          have hc0_v0 : c 0 • v₀ = 0 ∨ (1 : ℤ) ≤ valL F K (c 0 • v₀) :=
            hP_smul1 (c 0) v₀ hc0_1 hv₀_0
          have hsum_tail : (∑ i : Fin m, c i.succ • v i) = 0 ∨
              (1 : ℤ) ≤ valL F K (∑ i : Fin m, c i.succ • v i) := by
            have hsub := hP_sub 1 (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) (c 0 • v₀) hsum' hc0_v0
            rwa [add_sub_cancel_left] at hsub
          have hc_succ : ∀ i : Fin m, c i.succ = 0 ∨ 1 ≤ addVal F (c i.succ) :=
            hv_ind (fun i => c i.succ) (fun i => hc0 i.succ) hsum_tail
          intro i
          exact Fin.cases hc0_1 hc_succ i
    let m : ℕ := Module.finrank F K + 1
    obtain ⟨v, _, hv_ind⟩ := h_seq m
    have hli : LinearIndependent F v := by
      rw [Fintype.linearIndependent_iff]
      intro g hg i₀
      by_contra hgi₀
      let A_fin : Finset (Fin m) := Finset.univ.filter (fun i => g i ≠ 0)
      have hi₀ : i₀ ∈ A_fin := Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hgi₀⟩
      obtain ⟨i_star, hi_star_mem, hi_star_min⟩ :=
        Finset.exists_min_image A_fin (fun i => addVal F (g i)) ⟨i₀, hi₀⟩
      have hgi_star : g i_star ≠ 0 := (Finset.mem_filter.mp hi_star_mem).2
      let c : Fin m → F := fun i => (g i_star)⁻¹ * g i
      have hc0 : ∀ i : Fin m, c i = 0 ∨ 0 ≤ addVal F (c i) := by
        intro i
        by_cases hgi : g i = 0
        · left
          dsimp [c]
          rw [hgi, mul_zero]
        · right
          have hi_mem : i ∈ A_fin := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hgi⟩
          have hle : addVal F (g i_star) ≤ addVal F (g i) := hi_star_min i hi_mem
          dsimp [c]
          rw [haddVal_mul _ _ (inv_ne_zero hgi_star) hgi, haddVal_inv _ hgi_star]
          omega
      have hsum_c : (∑ i : Fin m, c i • v i) = 0 := by
        calc (∑ i : Fin m, c i • v i)
          _ = ∑ i : Fin m, (g i_star)⁻¹ • (g i • v i) :=
              Finset.sum_congr rfl (fun i _ => by dsimp [c]; rw [smul_smul])
          _ = (g i_star)⁻¹ • ∑ i : Fin m, g i • v i := (Finset.smul_sum).symm
          _ = 0 := by rw [hg, smul_zero]
      have hc_star : c i_star = 0 ∨ 1 ≤ addVal F (c i_star) :=
        hv_ind c hc0 (Or.inl hsum_c) i_star
      have hc_star_eq : c i_star = 1 := inv_mul_cancel₀ hgi_star
      rw [hc_star_eq, haddVal1] at hc_star
      rcases hc_star with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    have hcard := LinearIndependent.fintype_card_le_finrank hli
    rw [Fintype.card_fin] at hcard
    omega

  obtain ⟨S₁_K, hS₁_K⟩ := h_S₁_K

  have h_res_K :
      ∃ (k_K : Type u) (_ : Field k_K) (_ : Fintype k_K) (resK : K → k_K),
        resK 0 = 0 ∧ resK 1 = 1 ∧
        (∀ x₁ x₂ : K, (x₁ = 0 ∨ 0 ≤ valL F K x₁) → (x₂ = 0 ∨ 0 ≤ valL F K x₂) →
          resK (x₁ + x₂) = resK x₁ + resK x₂ ∧
          resK (x₁ * x₂) = resK x₁ * resK x₂ ∧
          resK (-x₁) = -resK x₁) ∧
        (∀ x : K, (x = 0 ∨ 0 ≤ valL F K x) → (resK x = 0 ↔ (x = 0 ∨ 1 ≤ valL F K x))) ∧
        (∀ a : k_K, ∃ x : K, (x = 0 ∨ 0 ≤ valL F K x) ∧ resK x = a) := by
    have hMain : ∀ (E : Type u) [Field E] (v : E → ℤ),
        v 1 = 0 →
        (∀ x : E, v (-x) = v x) →
        (∀ x y : E, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
        (∀ u : Eˣ, v ((u⁻¹ : Eˣ) : E) = - v (u : E)) →
        (∀ (k : ℤ) (x y : E), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) →
          (x + y = 0 ∨ k ≤ v (x + y))) →
        ∀ (S : Finset E),
        (∀ x : E, (x = 0 ∨ 0 ≤ v x) → ∃ s ∈ S, x - s = 0 ∨ (1 : ℤ) ≤ v (x - s)) →
        ∃ (k_E : Type u) (_ : Field k_E) (_ : Fintype k_E) (resE : E → k_E),
          resE 0 = 0 ∧ resE 1 = 1 ∧
          (∀ x₁ x₂ : E, (x₁ = 0 ∨ 0 ≤ v x₁) → (x₂ = 0 ∨ 0 ≤ v x₂) →
            resE (x₁ + x₂) = resE x₁ + resE x₂ ∧
            resE (x₁ * x₂) = resE x₁ * resE x₂ ∧
            resE (-x₁) = -resE x₁) ∧
          (∀ x : E, (x = 0 ∨ 0 ≤ v x) → (resE x = 0 ↔ (x = 0 ∨ 1 ≤ v x))) ∧
          (∀ a : k_E, ∃ x : E, (x = 0 ∨ 0 ≤ v x) ∧ resE x = a) := by
      clear * -
      intro E _ v hv1 hv_neg hv_mul hv_inv hv_add S hS
      let 𝒪_E : Subring E :=
        { carrier := {x : E | x = 0 ∨ 0 ≤ v x}
          zero_mem' := Or.inl rfl
          one_mem' := Or.inr (by rw [hv1])
          add_mem' := fun {x y} hx hy => hv_add 0 x y hx hy
          neg_mem' := fun {x} hx =>
            hx.elim (fun h0 => Or.inl (by rw [h0, neg_zero]))
              (fun hge => Or.inr (by rw [hv_neg]; exact hge))
          mul_mem' := fun {x y} hx hy => by
            by_cases hx0 : x = 0
            · exact Or.inl (by rw [hx0, zero_mul])
            · by_cases hy0 : y = 0
              · exact Or.inl (by rw [hy0, mul_zero])
              · exact Or.inr (by
                  rw [hv_mul x y hx0 hy0]
                  have h1 := hx.resolve_left hx0
                  have h2 := hy.resolve_left hy0
                  omega) }
      let 𝔭_E : Ideal 𝒪_E :=
        { carrier := {x : 𝒪_E | (x : E) = 0 ∨ (1 : ℤ) ≤ v (x : E)}
          zero_mem' := Or.inl rfl
          add_mem' := fun {x y} hx hy => hv_add 1 x.1 y.1 hx hy
          smul_mem' := fun c {x} hx => by
            by_cases hc0 : (c : E) = 0
            · exact Or.inl (by change (c : E) * (x : E) = 0; rw [hc0, zero_mul])
            · by_cases hx0 : (x : E) = 0
              · exact Or.inl (by change (c : E) * (x : E) = 0; rw [hx0, mul_zero])
              · exact Or.inr (by
                  change (1 : ℤ) ≤ v ((c : E) * (x : E))
                  rw [hv_mul c.1 x.1 hc0 hx0]
                  have h1 := c.2.resolve_left hc0
                  have h2 := hx.resolve_left hx0
                  omega) }
      have hIsField : IsField (𝒪_E ⧸ 𝔭_E) := by
        refine ⟨⟨0, 1, ?_⟩, fun a b => mul_comm a b, ?_⟩
        · intro h01
          have h1 : (1 : 𝒪_E) ∈ 𝔭_E := Ideal.Quotient.eq_zero_iff_mem.mp h01.symm
          rcases h1 with h10 | h1ge
          · exact one_ne_zero h10
          · change (1 : ℤ) ≤ v 1 at h1ge
            rw [hv1] at h1ge
            omega
        · intro a ha
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
          have hxI : x ∉ 𝔭_E := fun h => ha (Ideal.Quotient.eq_zero_iff_mem.mpr h)
          have hx0 : (x : E) ≠ 0 := fun h => hxI (Or.inl h)
          have hxlt : ¬ ((1 : ℤ) ≤ v (x : E)) := fun h => hxI (Or.inr h)
          have hxge : 0 ≤ v (x : E) := x.2.resolve_left hx0
          have hvx : v (x : E) = 0 := by omega
          let u : Eˣ := Units.mk0 (x : E) hx0
          have hvu : v ((u⁻¹ : Eˣ) : E) = 0 := by
            rw [hv_inv u]
            change - v (x : E) = 0
            omega
          let y : 𝒪_E := ⟨((u⁻¹ : Eˣ) : E), Or.inr (by omega)⟩
          refine ⟨Ideal.Quotient.mk 𝔭_E y, ?_⟩
          rw [← map_mul]
          have hxy : x * y = 1 := Subtype.ext (Units.mul_inv u)
          rw [hxy, map_one]
      haveI hMax : 𝔭_E.IsMaximal := Ideal.Quotient.maximal_of_isField 𝔭_E hIsField
      let k_E : Type u := 𝒪_E ⧸ 𝔭_E
      letI hField_kE : Field k_E := Ideal.Quotient.field 𝔭_E
      let resE : E → k_E := fun x =>
        if hx : x = 0 ∨ 0 ≤ v x then Ideal.Quotient.mk 𝔭_E ⟨x, hx⟩ else 0
      have hresE_eq : ∀ (x : E) (hx : x = 0 ∨ 0 ≤ v x),
          resE x = Ideal.Quotient.mk 𝔭_E ⟨x, hx⟩ :=
        fun x hx => dif_pos hx
      have hresE_0 : resE 0 = 0 := by
        rw [hresE_eq 0 (Or.inl rfl)]
        exact map_zero (Ideal.Quotient.mk 𝔭_E)
      have hresE_1 : resE 1 = 1 := by
        rw [hresE_eq 1 (Or.inr (by rw [hv1]))]
        exact map_one (Ideal.Quotient.mk 𝔭_E)
      have hresE_ring : ∀ x₁ x₂ : E,
          (x₁ = 0 ∨ 0 ≤ v x₁) → (x₂ = 0 ∨ 0 ≤ v x₂) →
            resE (x₁ + x₂) = resE x₁ + resE x₂ ∧
            resE (x₁ * x₂) = resE x₁ * resE x₂ ∧
            resE (-x₁) = -resE x₁ := by
        intro x₁ x₂ hx₁ hx₂
        have hadd : x₁ + x₂ = 0 ∨ 0 ≤ v (x₁ + x₂) := 𝒪_E.add_mem hx₁ hx₂
        have hmul : x₁ * x₂ = 0 ∨ 0 ≤ v (x₁ * x₂) := 𝒪_E.mul_mem hx₁ hx₂
        have hneg : -x₁ = 0 ∨ 0 ≤ v (-x₁) := 𝒪_E.neg_mem hx₁
        refine ⟨?_, ?_, ?_⟩
        · rw [hresE_eq (x₁ + x₂) hadd, hresE_eq x₁ hx₁, hresE_eq x₂ hx₂]
          exact map_add (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
        · rw [hresE_eq (x₁ * x₂) hmul, hresE_eq x₁ hx₁, hresE_eq x₂ hx₂]
          exact map_mul (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
        · rw [hresE_eq (-x₁) hneg, hresE_eq x₁ hx₁]
          exact map_neg (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩
      have hresE_ker : ∀ x : E,
          (x = 0 ∨ 0 ≤ v x) → (resE x = 0 ↔ (x = 0 ∨ 1 ≤ v x)) := by
        intro x hx
        rw [hresE_eq x hx, Ideal.Quotient.eq_zero_iff_mem]
        rfl
      have hresE_surj : ∀ a : k_E, ∃ x : E, (x = 0 ∨ 0 ≤ v x) ∧ resE x = a := by
        intro a
        obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.Quotient.mk_surjective a
        exact ⟨x, hx, hresE_eq x hx⟩
      let f : k_E → S := fun a =>
        let x_a := (hresE_surj a).choose
        let hx_a := (hresE_surj a).choose_spec.1
        let hs := hS x_a hx_a
        ⟨hs.choose, hs.choose_spec.1⟩
      have hf_left : ∀ a : k_E, resE (f a : E) = a := by
        intro a
        set x_a := (hresE_surj a).choose
        have hx_a : x_a = 0 ∨ 0 ≤ v x_a := (hresE_surj a).choose_spec.1
        have hres_a : resE x_a = a := (hresE_surj a).choose_spec.2
        have hd₁ : x_a - (f a : E) = 0 ∨ (1 : ℤ) ≤ v (x_a - (f a : E)) :=
          (hS x_a hx_a).choose_spec.2
        have hd₀ : x_a - (f a : E) = 0 ∨ 0 ≤ v (x_a - (f a : E)) :=
          hd₁.elim Or.inl (fun h => Or.inr (by omega))
        have hs₀ : (f a : E) = 0 ∨ 0 ≤ v (f a : E) := by
          have h_eq : (f a : E) = x_a + -(x_a - (f a : E)) := by ring
          rw [h_eq]
          exact 𝒪_E.add_mem hx_a (𝒪_E.neg_mem hd₀)
        have hres_d : resE (x_a - (f a : E)) = 0 :=
          (hresE_ker (x_a - (f a : E)) hd₀).mpr hd₁
        have h_sum : x_a = (x_a - (f a : E)) + (f a : E) := by ring
        have h_add' := (hresE_ring (x_a - (f a : E)) (f a : E) hd₀ hs₀).1
        rw [← h_sum, hres_a, hres_d, zero_add] at h_add'
        exact h_add'.symm
      have hf_inj : Function.Injective f := by
        intro a₁ a₂ h
        have hval : (f a₁ : E) = (f a₂ : E) := congrArg Subtype.val h
        rw [← hf_left a₁, ← hf_left a₂, hval]
      haveI hFin_kE' : Finite k_E := Finite.of_injective f hf_inj
      letI hFin_kE : Fintype k_E := Fintype.ofFinite k_E
      exact ⟨k_E, hField_kE, hFin_kE, resE, hresE_0, hresE_1, hresE_ring, hresE_ker, hresE_surj⟩
    exact hMain ↥K (valL F K) hvalK1 hvalK_neg hvalK_mul hvalK_inv hvalK_add S₁_K hS₁_K

  obtain ⟨k_K, hField_kK, hFin_kK, resK, hresK_0, hresK_1,
    hresK_ring, hresK_ker, hresK_surj⟩ := h_res_K
  letI : Field k_K := hField_kK
  letI : Fintype k_K := hFin_kK

  let P_K : ℤ → K → Prop := fun k w => w = 0 ∨ k ≤ valL F K w
  have hPK_zero : ∀ k : ℤ, P_K k 0 := fun _ => Or.inl rfl
  have hPK_one : P_K 0 1 := Or.inr (by omega)
  have hPK_neg : ∀ (k : ℤ) {w : K}, P_K k w → P_K k (-w) := by
    intro k w hw
    rcases hw with rfl | hw
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hvalK_neg]; exact hw)
  have hPK_add : ∀ (k : ℤ) {w₁ w₂ : K}, P_K k w₁ → P_K k w₂ → P_K k (w₁ + w₂) :=
    fun k {w₁ w₂} h1 h2 => hvalK_add k w₁ w₂ h1 h2
  have hPK_sub : ∀ (k : ℤ) {w₁ w₂ : K}, P_K k w₁ → P_K k w₂ → P_K k (w₁ - w₂) := by
    intro k w₁ w₂ h1 h2
    rw [sub_eq_add_neg]
    exact hPK_add k h1 (hPK_neg k h2)
  have hPK_mul : ∀ {k₁ k₂ : ℤ} {w₁ w₂ : K}, P_K k₁ w₁ → P_K k₂ w₂ → P_K (k₁ + k₂) (w₁ * w₂) := by
    intro k₁ k₂ w₁ w₂ h1 h2
    by_cases hw₁ : w₁ = 0
    · exact Or.inl (by rw [hw₁, zero_mul])
    · by_cases hw₂ : w₂ = 0
      · exact Or.inl (by rw [hw₂, mul_zero])
      · right
        rw [hvalK_mul w₁ w₂ hw₁ hw₂]
        have h1' := h1.resolve_left hw₁
        have h2' := h2.resolve_left hw₂
        omega
  have hPK_pow : ∀ (m : ℕ) {w : K}, P_K 0 w → P_K 0 (w ^ m) := by
    intro m w hw
    induction m with
    | zero => rw [pow_zero]; exact hPK_one
    | succ m ih =>
      rw [pow_succ]
      simpa using hPK_mul ih hw

  intro q
  have hq_gt1 : 1 < q := by
    change 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    rw [hq_eq]
    exact one_lt_pow₀ hp_prime.one_lt (by omega)

  let φ_iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hp_res : IsLocalRing.residue 𝒪[F] (p F : 𝒪[F]) = 0 := by
    rw [map_natCast]
    exact CharP.cast_eq_zero 𝓀[F] (p F)
  have hp_val_lt : valuation F (p F : F) < 1 := by
    have hker : IsLocalRing.residue 𝒪[F] (p F : 𝒪[F]) = 0 ↔
        valuation F ((p F : 𝒪[F]) : F) < 1 := by
      rw [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one]
    simpa using hker.mp hp_res
  have hp_addVal : (p F : F) = 0 ∨ 1 ≤ addVal F (p F : F) := by
    by_cases hp0 : (p F : F) = 0
    · exact Or.inl hp0
    · right
      have hφp : φ_iso (valuation F (p F : F)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
      have hlt_iff : valuation F (p F : F) < 1 ↔ 1 ≤ addVal F (p F : F) := by
        rw [← map_lt_map_iff φ_iso, map_one, ← WithZero.coe_unzero hφp, ← WithZero.coe_one,
          WithZero.coe_lt_coe, ← Multiplicative.toAdd_lt, toAdd_one]
        unfold addVal
        rw [dif_neg hp0]
        omega
      exact hlt_iff.mp hp_val_lt
  have hp_valK : (p F : K) = 0 ∨ 1 ≤ valL F K (p F : K) := by
    have h1 := halgK1 (p F : F) hp_addVal
    rwa [map_natCast] at h1

  have h_ef_rel : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      ∃ (e_AB f_AB : ℕ),
        1 ≤ e_AB ∧
        1 ≤ f_AB ∧
        e_AB * f_AB = Module.finrank A (IntermediateField.extendScalars hAB) ∧
        resDeg F B = f_AB * resDeg F A ∧
        (∀ w : B, valL F A (normLM F hAB w) = (f_AB : ℤ) * valL F B w) ∧
        (∀ x : A, valL F B (IntermediateField.inclusion hAB x) = (e_AB : ℤ) * valL F A x) := by
    clear! L K M_C E hp_prime r_exp q
    intro A B _ _ hAB
    obtain ⟨hresDeg_A_pos, hdiv_A, hvalA0, hvalA1, _, _, hvalA_mul, _, hvalA_surj, _⟩ :=
      h_valL_props A
    obtain ⟨hresDeg_B_pos, hdiv_B, hvalB0, hvalB1, _, _, hvalB_mul, _, hvalB_surj, _⟩ :=
      h_valL_props B
    have hfA_int_pos : (0 : ℤ) < (resDeg F A : ℤ) := Nat.cast_pos.mpr hresDeg_A_pos
    have hfA_int_ne : (resDeg F A : ℤ) ≠ 0 := ne_of_gt hfA_int_pos
    have hfB_int_pos : (0 : ℤ) < (resDeg F B : ℤ) := Nat.cast_pos.mpr hresDeg_B_pos
    let B' : IntermediateField A (AlgebraicClosure F) := IntermediateField.extendScalars hAB
    let e_B : B ≃ₐ[F] B' :=
      { toExtendScalars F hAB with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hAB).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F B' := Module.Finite.equiv e_B.toLinearEquiv
    haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional A B' := Module.Finite.of_restrictScalars_finite F A B'
    let n_AB : ℕ := Module.finrank A B'
    have hn_AB_pos : 0 < n_AB := Module.finrank_pos
    have hrelVal_norm : ∀ w : B, relVal F A (normLM F hAB w) = relVal F B w := by
      intro w
      change addVal F (Algebra.norm F (Algebra.norm A (toExtendScalars F hAB w))) =
        addVal F (Algebra.norm F w)
      have h1 : Algebra.norm F (Algebra.norm A (toExtendScalars F hAB w)) =
          Algebra.norm F (toExtendScalars F hAB w) := Algebra.norm_norm
      have h2 : Algebra.norm F w = Algebra.norm F (toExtendScalars F hAB w) :=
        Algebra.norm_eq_of_algEquiv e_B w
      rw [h1, ← h2]
    have hnorm_inc : ∀ x : A,
        normLM F hAB (IntermediateField.inclusion hAB x) = x ^ n_AB := by
      intro x
      change Algebra.norm A (algebraMap A B' x) = x ^ n_AB
      exact Algebra.norm_algebraMap x
    have hvalA_pow : ∀ (x : A) (k : ℕ), x ≠ 0 → valL F A (x ^ k) = (k : ℤ) * valL F A x := by
      intro x k hx
      induction k with
      | zero => simp [hvalA1]
      | succ k ih =>
        rw [pow_succ, hvalA_mul (x ^ k) x (pow_ne_zero k hx) hx, ih]
        push_cast
        ring
    obtain ⟨ϖ_A, hϖ_A⟩ := hvalA_surj 1
    obtain ⟨ϖ_B, hϖ_B⟩ := hvalB_surj 1
    set e_Z : ℤ := valL F B (IntermediateField.inclusion hAB (ϖ_A : A))
    set f_Z : ℤ := valL F A (normLM F hAB (ϖ_B : B))
    have h_resDeg_rel : (resDeg F B : ℤ) = (resDeg F A : ℤ) * f_Z := by
      calc (resDeg F B : ℤ)
        _ = (resDeg F B : ℤ) * valL F B (ϖ_B : B) := by rw [hϖ_B, mul_one]
        _ = relVal F B (ϖ_B : B) := (hdiv_B (ϖ_B : B)).symm
        _ = relVal F A (normLM F hAB (ϖ_B : B)) := (hrelVal_norm (ϖ_B : B)).symm
        _ = (resDeg F A : ℤ) * f_Z := hdiv_A (normLM F hAB (ϖ_B : B))
    have hf_Z_pos : 1 ≤ f_Z := by nlinarith
    have hf_Z_ne : f_Z ≠ 0 := by omega
    have h_val_norm_Z : ∀ w : B, valL F A (normLM F hAB w) = f_Z * valL F B w := by
      intro w
      apply mul_left_cancel₀ hfA_int_ne
      calc (resDeg F A : ℤ) * valL F A (normLM F hAB w)
        _ = relVal F A (normLM F hAB w) := (hdiv_A (normLM F hAB w)).symm
        _ = relVal F B w := hrelVal_norm w
        _ = (resDeg F B : ℤ) * valL F B w := hdiv_B w
        _ = (resDeg F A : ℤ) * (f_Z * valL F B w) := by rw [h_resDeg_rel, mul_assoc]
    have h_fe_Z : (n_AB : ℤ) = f_Z * e_Z := by
      calc (n_AB : ℤ)
        _ = (n_AB : ℤ) * valL F A (ϖ_A : A) := by rw [hϖ_A, mul_one]
        _ = valL F A ((ϖ_A : A) ^ n_AB) := (hvalA_pow (ϖ_A : A) n_AB (Units.ne_zero ϖ_A)).symm
        _ = valL F A (normLM F hAB (IntermediateField.inclusion hAB (ϖ_A : A))) := by
            rw [hnorm_inc (ϖ_A : A)]
        _ = f_Z * e_Z := h_val_norm_Z (IntermediateField.inclusion hAB (ϖ_A : A))
    have hn_AB_Z : (1 : ℤ) ≤ (n_AB : ℤ) := by exact_mod_cast hn_AB_pos
    have he_Z_pos : 1 ≤ e_Z := by nlinarith
    have h_val_alg_Z : ∀ x : A,
        valL F B (IntermediateField.inclusion hAB x) = e_Z * valL F A x := by
      intro x
      by_cases hx : x = 0
      · rw [hx, map_zero, hvalB0, hvalA0, mul_zero]
      · apply mul_left_cancel₀ hf_Z_ne
        calc f_Z * valL F B (IntermediateField.inclusion hAB x)
          _ = valL F A (normLM F hAB (IntermediateField.inclusion hAB x)) :=
              (h_val_norm_Z (IntermediateField.inclusion hAB x)).symm
          _ = valL F A (x ^ n_AB) := by rw [hnorm_inc x]
          _ = (n_AB : ℤ) * valL F A x := hvalA_pow x n_AB hx
          _ = f_Z * (e_Z * valL F A x) := by rw [h_fe_Z, mul_assoc]
    let e_AB : ℕ := e_Z.toNat
    let f_AB : ℕ := f_Z.toNat
    have he_cast : (e_AB : ℤ) = e_Z := Int.toNat_of_nonneg (by omega)
    have hf_cast : (f_AB : ℤ) = f_Z := Int.toNat_of_nonneg (by omega)
    have he_pos : 1 ≤ e_AB := by omega
    have hf_pos : 1 ≤ f_AB := by omega
    have hef_eq : e_AB * f_AB = n_AB := by
      have h1 : ((e_AB * f_AB : ℕ) : ℤ) = (n_AB : ℤ) := by
        push_cast
        rw [he_cast, hf_cast, h_fe_Z, mul_comm]
      exact Nat.cast_injective h1
    have hres_eq : resDeg F B = f_AB * resDeg F A := by
      have h1 : (resDeg F B : ℤ) = ((f_AB * resDeg F A : ℕ) : ℤ) := by
        push_cast
        rw [hf_cast, h_resDeg_rel, mul_comm]
      exact Nat.cast_injective h1
    refine ⟨e_AB, f_AB, he_pos, hf_pos, hef_eq, hres_eq, ?_, ?_⟩
    · intro w
      rw [hf_cast]
      exact h_val_norm_Z w
    · intro x
      rw [he_cast]
      exact h_val_alg_Z x

  have h_ef_MCK := h_ef_rel M_C K hM_CK

  have hresK_nat : ∀ n : ℕ, P_K 0 (n : K) ∧ resK (n : K) = (n : k_K) := by
    intro n
    induction n with
    | zero =>
      refine ⟨Or.inl Nat.cast_zero, ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresK_0]
    | succ n ih =>
      have hval_succ : P_K 0 ((n + 1 : ℕ) : K) := by
        rw [Nat.cast_succ]
        exact hPK_add 0 ih.1 hPK_one
      refine ⟨hval_succ, ?_⟩
      rw [Nat.cast_succ, (hresK_ring (n : K) 1 ih.1 hPK_one).1, ih.2, hresK_1, Nat.cast_succ]

  have hresK_pow : ∀ {w : K}, P_K 0 w →
      ∀ n : ℕ, P_K 0 (w ^ n) ∧ resK (w ^ n) = (resK w) ^ n := by
    intro w hw n
    induction n with
    | zero =>
      refine ⟨Or.inr (by rw [pow_zero, hvalK1]), ?_⟩
      rw [pow_zero, pow_zero, hresK_1]
    | succ n ih =>
      have hval_succ : P_K 0 (w ^ (n + 1)) := hPK_pow (n + 1) hw
      refine ⟨hval_succ, ?_⟩
      rw [pow_succ, (hresK_ring (w ^ n) w ih.1 hw).2.1, ih.2, pow_succ]

  have hresK_sub : ∀ {x y : K}, P_K 0 x → P_K 0 y → resK (x - y) = resK x - resK y := by
    intro x y hx hy
    rw [sub_eq_add_neg, (hresK_ring x (-y) hx (hPK_neg 0 hy)).1,
      (hresK_ring y 0 hy (hPK_zero 0)).2.2, ← sub_eq_add_neg]

  have hresK_eq_iff : ∀ {x y : K}, P_K 0 x → P_K 0 y → (resK x = resK y ↔ P_K 1 (x - y)) := by
    intro x y hx hy
    rw [← sub_eq_zero, ← hresK_sub hx hy, hresK_ker (x - y) (hPK_sub 0 hx hy)]

  have hPK_hom : ∀ (ρ : K →+* K), (∀ w : K, valL F K (ρ w) = valL F K w) →
      ∀ (k : ℤ) {w : K}, P_K k w → P_K k (ρ w) := by
    intro ρ hρ k w hw
    rcases hw with rfl | hw
    · exact Or.inl (map_zero ρ)
    · exact Or.inr (by rw [hρ w]; exact hw)

  have hPK1_hom_iff : ∀ (ρ : K →+* K), (∀ w : K, valL F K (ρ w) = valL F K w) →
      ∀ {w : K}, P_K 1 (ρ w) ↔ P_K 1 w := by
    intro ρ hρ w
    dsimp [P_K]
    rw [map_eq_zero, hρ w]

  have hresK_hom_congr : ∀ (ρ : K →+* K) (hρ : ∀ w : K, valL F K (ρ w) = valL F K w)
      {x y : K}, P_K 0 x → P_K 0 y → resK x = resK y → resK (ρ x) = resK (ρ y) := by
    intro ρ hρ x y hx hy hxy
    rw [hresK_eq_iff (hPK_hom ρ hρ 0 hx) (hPK_hom ρ hρ 0 hy), ← map_sub ρ]
    exact hPK_hom ρ hρ 1 ((hresK_eq_iff hx hy).mp hxy)

  have hresK_hom_pow : ∀ (ρ : K →+* K) (hρ : ∀ w : K, valL F K (ρ w) = valL F K w)
      {x : K}, P_K 0 x → ∀ m : ℕ, resK (ρ (x ^ m)) = (resK (ρ x)) ^ m := by
    intro ρ hρ x hx m
    rw [map_pow ρ x m]
    exact (hresK_pow (hPK_hom ρ hρ 0 hx) m).2

  obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := k_Kˣ)
  obtain ⟨z₀, hz₀_0, hz₀_res⟩ := hresK_surj (g₀ : k_K)

  have hresK_hom_z₀_ne0 : ∀ (ρ : K →+* K), (∀ w : K, valL F K (ρ w) = valL F K w) →
      resK (ρ z₀) ≠ 0 := by
    intro ρ hρ h0
    have hP1_ρz₀ : P_K 1 (ρ z₀) := (hresK_ker (ρ z₀) (hPK_hom ρ hρ 0 hz₀_0)).mp h0
    have hP1_z₀ : P_K 1 z₀ := (hPK1_hom_iff ρ hρ).mp hP1_ρz₀
    have hres_z₀_0 : resK z₀ = 0 := (hresK_ker z₀ hz₀_0).mpr hP1_z₀
    rw [hz₀_res] at hres_z₀_0
    exact Units.ne_zero g₀ hres_z₀_0

  have h_gen_pow : ∀ (a : k_K), a ≠ 0 → ∃ m : ℕ, resK (z₀ ^ m) = a := by
    intro a ha
    obtain ⟨m, hm⟩ := hg₀ (Units.mk0 a ha)
    refine ⟨m, ?_⟩
    rw [(hresK_pow hz₀_0 m).2, hz₀_res]
    have hm_val := congrArg Units.val hm
    rwa [Units.val_pow_eq_pow_val, Units.val_mk0] at hm_val

  have h_res_comm : ∀ (σ τ : K →+* K),
      (∀ w : K, valL F K (σ w) = valL F K w) →
      (∀ w : K, valL F K (τ w) = valL F K w) →
      ∀ w : K, P_K 0 w → P_K 1 (σ (τ w) - τ (σ w)) := by
    intro σ τ hσ hτ w hw
    obtain ⟨j, hj⟩ := h_gen_pow (resK (σ z₀)) (hresK_hom_z₀_ne0 σ hσ)
    obtain ⟨k, hk⟩ := h_gen_pow (resK (τ z₀)) (hresK_hom_z₀_ne0 τ hτ)
    have h_pow_comm : ∀ (ρ₁ ρ₂ : K →+* K)
        (hρ₁ : ∀ x : K, valL F K (ρ₁ x) = valL F K x)
        (hρ₂ : ∀ x : K, valL F K (ρ₂ x) = valL F K x)
        (e₁ e₂ m : ℕ),
        resK (z₀ ^ e₁) = resK (ρ₁ z₀) →
        resK (z₀ ^ e₂) = resK (ρ₂ z₀) →
        resK (ρ₁ (ρ₂ (z₀ ^ m))) = (resK z₀) ^ (e₁ * (e₂ * m)) := by
      intro ρ₁ ρ₂ hρ₁ hρ₂ e₁ e₂ m he₁ he₂
      have h1 : resK (ρ₂ (z₀ ^ m)) = resK (z₀ ^ (e₂ * m)) := by
        rw [hresK_hom_pow ρ₂ hρ₂ hz₀_0 m, ← he₂, (hresK_pow hz₀_0 e₂).2,
          (hresK_pow hz₀_0 (e₂ * m)).2, pow_mul]
      have h2 : resK (ρ₁ (ρ₂ (z₀ ^ m))) = resK (ρ₁ (z₀ ^ (e₂ * m))) :=
        hresK_hom_congr ρ₁ hρ₁ (hPK_hom ρ₂ hρ₂ 0 (hPK_pow m hz₀_0))
          (hPK_pow (e₂ * m) hz₀_0) h1
      rw [h2, hresK_hom_pow ρ₁ hρ₁ hz₀_0 (e₂ * m), ← he₁, (hresK_pow hz₀_0 e₁).2, ← pow_mul]
    have h_stw : P_K 0 (σ (τ w)) := hPK_hom σ hσ 0 (hPK_hom τ hτ 0 hw)
    have h_tsw : P_K 0 (τ (σ w)) := hPK_hom τ hτ 0 (hPK_hom σ hσ 0 hw)
    rw [← hresK_eq_iff h_stw h_tsw]
    by_cases hw0 : resK w = 0
    · have hw_zero : resK w = resK 0 := by rw [hw0, hresK_0]
      have h1 : resK (σ (τ w)) = resK (σ (τ 0)) :=
        hresK_hom_congr σ hσ (hPK_hom τ hτ 0 hw) (hPK_hom τ hτ 0 (hPK_zero 0))
          (hresK_hom_congr τ hτ hw (hPK_zero 0) hw_zero)
      have h2 : resK (τ (σ w)) = resK (τ (σ 0)) :=
        hresK_hom_congr τ hτ (hPK_hom σ hσ 0 hw) (hPK_hom σ hσ 0 (hPK_zero 0))
          (hresK_hom_congr σ hσ hw (hPK_zero 0) hw_zero)
      rw [h1, h2, map_zero, map_zero, map_zero]
    · obtain ⟨m, hm⟩ := h_gen_pow (resK w) hw0
      have h1 : resK (σ (τ w)) = resK (σ (τ (z₀ ^ m))) :=
        hresK_hom_congr σ hσ (hPK_hom τ hτ 0 hw) (hPK_hom τ hτ 0 (hPK_pow m hz₀_0))
          (hresK_hom_congr τ hτ hw (hPK_pow m hz₀_0) hm.symm)
      have h2 : resK (τ (σ w)) = resK (τ (σ (z₀ ^ m))) :=
        hresK_hom_congr τ hτ (hPK_hom σ hσ 0 hw) (hPK_hom σ hσ 0 (hPK_pow m hz₀_0))
          (hresK_hom_congr σ hσ hw (hPK_pow m hz₀_0) hm.symm)
      rw [h1, h2, h_pow_comm σ τ hσ hτ j k m hj hk, h_pow_comm τ σ hτ hσ k j m hk hj,
        mul_left_comm j k m]

  have hp_kK : (p F : k_K) = 0 := by
    rw [← (hresK_nat (p F)).2]
    exact (hresK_ker (p F : K) (hresK_nat (p F)).1).mpr hp_valK

  have hchoose_kK : ∀ k : ℕ, 0 < k → k < p F → ((p F).choose k : k_K) = 0 := by
    intro k hk0 hkp
    have hdvd : p F ∣ (p F).choose k := Nat.Prime.dvd_choose_self hp_prime (ne_of_gt hk0) hkp
    rcases hdvd with ⟨c, hc⟩
    rw [hc, Nat.cast_mul, hp_kK, zero_mul]

  have hfrob_add : ∀ a b : k_K, (a + b) ^ (p F) = a ^ (p F) + b ^ (p F) := by
    intro a b
    have hp_gt1 : 1 < p F := hp_prime.one_lt
    have hp_eq : p F + 1 = (p F - 1) + 1 + 1 := by omega
    have hp1 : (p F - 1) + 1 = p F := by omega
    rw [add_pow a b (p F), hp_eq, Finset.sum_range_succ, Finset.sum_range_succ']
    have hmid : (∑ k ∈ Finset.range (p F - 1),
        a ^ (k + 1) * b ^ (p F - (k + 1)) * ((p F).choose (k + 1) : k_K)) = 0 := by
      apply Finset.sum_eq_zero
      intro k hk
      have hlt : k < p F - 1 := Finset.mem_range.mp hk
      rw [hchoose_kK (k + 1) (by omega) (by omega), mul_zero]
    simp only [hmid, zero_add, hp1, Nat.sub_self, Nat.sub_zero, pow_zero, mul_one, one_mul,
      Nat.choose_self, Nat.choose_zero_right, Nat.cast_one]
    exact add_comm (b ^ (p F)) (a ^ (p F))

  have hfrob_inj : Function.Injective (fun a : k_K => a ^ (p F)) := by
    intro a b hab
    dsimp at hab
    have hbd : (b + (a - b)) ^ (p F) = b ^ (p F) + (a - b) ^ (p F) := hfrob_add b (a - b)
    rw [add_sub_cancel, hab] at hbd
    have hzero : (a - b) ^ (p F) = 0 := by linear_combination -hbd
    exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hzero)

  have hfrob_surj_p : Function.Surjective (fun a : k_K => a ^ (p F)) :=
    Finite.surjective_of_injective hfrob_inj

  have h_pow_p_mod1 : ∀ u : K, P_K 0 u → P_K 1 (u ^ (p F) - 1) → P_K 1 (u - 1) := by
    intro u hu hup
    have hres_up : (resK u) ^ (p F) = (1 : k_K) ^ (p F) := by
      rw [one_pow, ← hresK_1, ← (hresK_pow hu (p F)).2]
      exact (hresK_eq_iff (hPK_pow (p F) hu) hPK_one).mpr hup
    have hres_u1 : resK u = resK 1 := by
      rw [hresK_1]
      exact hfrob_inj hres_up
    exact (hresK_eq_iff hu hPK_one).mp hres_u1

  have hfrob_pow_surj : ∀ m : ℕ, Function.Surjective (fun a : k_K => a ^ ((p F) ^ m)) := by
    intro m
    induction m with
    | zero =>
      intro b
      refine ⟨b, ?_⟩
      simp
    | succ m ih =>
      intro b
      obtain ⟨c, hc⟩ := ih b
      obtain ⟨a, ha⟩ := hfrob_surj_p c
      dsimp only at hc ha
      refine ⟨a, ?_⟩
      dsimp only
      rw [pow_succ', pow_mul, ha, hc]

  have hfrob_surj_kK_q : Function.Surjective (fun a : k_K => a ^ q) := by
    change Function.Surjective (fun a : k_K => a ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    rw [hq_eq]
    exact hfrob_pow_surj r_exp

  have h_frob_surj_q : ∀ w : K, P_K 0 w →
      ∃ w₁ : K, P_K 0 w₁ ∧ P_K 1 (w - w₁ ^ q) := by
    intro w hw
    obtain ⟨a₀, ha₀⟩ := hfrob_surj_kK_q (resK w)
    dsimp only at ha₀
    obtain ⟨w₁, hw₁_0, hw₁_res⟩ := hresK_surj a₀
    refine ⟨w₁, hw₁_0, ?_⟩
    rw [← hresK_eq_iff hw (hPK_pow q hw₁_0), (hresK_pow hw₁_0 q).2, hw₁_res, ha₀]

  have h_gcd_roots_bound : ∀ (α : Type u) [Fintype α] (m n : ℕ), 0 < m →
      ∀ u : α → K,
        (∀ a : α, P_K 0 (u a)) →
        (∀ a : α, P_K 1 ((u a) ^ m - 1)) →
        (∀ a : α, P_K 1 ((u a) ^ n - 1)) →
        (∀ a₁ a₂ : α, P_K 1 (u a₁ - u a₂) → a₁ = a₂) →
        Fintype.card α ≤ m.gcd n := by
    intro α _ m n hm_pos u hu0 hu_m hu_n hu_inj
    set d : ℕ := m.gcd n
    have hd_pos : 0 < d := Nat.gcd_pos_of_pos_left n hm_pos
    let q_u : α → k_K := fun a => resK (u a)
    have hq_u_inj : Function.Injective q_u := by
      intro a₁ a₂ hq
      exact hu_inj a₁ a₂ ((hresK_eq_iff (hu0 a₁) (hu0 a₂)).mp hq)
    have hq_pow_eq1 : ∀ (a : α) (k : ℕ), P_K 1 ((u a) ^ k - 1) → (q_u a) ^ k = 1 := by
      intro a k hk
      rw [← hresK_1, ← (hresK_pow (hu0 a) k).2]
      exact (hresK_eq_iff (hPK_pow k (hu0 a)) hPK_one).mpr hk
    have hq_u_d : ∀ a : α, (q_u a) ^ d = 1 := by
      intro a
      have hm1 : (q_u a) ^ m = 1 := hq_pow_eq1 a m (hu_m a)
      have hn1 : (q_u a) ^ n = 1 := hq_pow_eq1 a n (hu_n a)
      have hne0 : q_u a ≠ 0 := by
        intro h0
        rw [h0, zero_pow (ne_of_gt hm_pos)] at hm1
        exact zero_ne_one hm1
      let v_a : k_Kˣ := Units.mk0 (q_u a) hne0
      have hvm : v_a ^ m = 1 := Units.ext (by rw [Units.val_pow_eq_pow_val, Units.val_mk0, hm1, Units.val_one])
      have hvn : v_a ^ n = 1 := Units.ext (by rw [Units.val_pow_eq_pow_val, Units.val_mk0, hn1, Units.val_one])
      have hvd : v_a ^ d = 1 := pow_gcd_eq_one.mpr ⟨hvm, hvn⟩
      have hvd_val := congrArg Units.val hvd
      rwa [Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_one] at hvd_val
    let P_d : Polynomial k_K := Polynomial.X ^ d - Polynomial.C 1
    have hPd_ne : P_d ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hd_pos (1 : k_K)
    have hPd_deg : P_d.natDegree = d := Polynomial.natDegree_X_pow_sub_C
    have hq_mem : ∀ a : α, q_u a ∈ P_d.roots.toFinset := by
      intro a
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hPd_ne, Polynomial.IsRoot.def]
      dsimp [P_d]
      rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        hq_u_d a, sub_self]
    let q_sub : α → P_d.roots.toFinset := fun a => ⟨q_u a, hq_mem a⟩
    have hq_sub_inj : Function.Injective q_sub :=
      fun a₁ a₂ h => hq_u_inj (congrArg Subtype.val h)
    calc Fintype.card α ≤ Fintype.card P_d.roots.toFinset :=
          Fintype.card_le_of_injective q_sub hq_sub_inj
      _ = P_d.roots.toFinset.card := Fintype.card_coe _
      _ ≤ P_d.roots.card := Multiset.toFinset_card_le _
      _ ≤ P_d.natDegree := Polynomial.card_roots' P_d
      _ = d := hPd_deg

  have h_diamond : ∀ (k e_MCL e_KE : ℕ),
      1 ≤ k →
      Nat.Coprime k q →
      1 ≤ e_MCL → e_MCL ≤ k →
      1 ≤ e_KE → e_KE ≤ k →
      k ∣ q * e_MCL →
      (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z) →
      (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (e_MCL : ℤ) * valL F L x) →
      (∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (e_KE : ℤ) * valL F E y) →
      e_MCL = k ∧
      e_KE = k ∧
      resDeg F E = resDeg F L := by
    intro k e_MCL e_KE hk_ge1 hcop_kq he_MCL_ge1 he_MCL_le he_KE_ge1 he_KE_le hk_dvd_qe
      hValAlgK hValMC_L hValK_E
    have hk_dvd_eMCL : k ∣ e_MCL := Nat.Coprime.dvd_of_dvd_mul_left hcop_kq hk_dvd_qe
    have hk_le_eMCL : k ≤ e_MCL := Nat.le_of_dvd (by omega) hk_dvd_eMCL
    have he_MCL_eq : e_MCL = k := le_antisymm he_MCL_le hk_le_eMCL
    obtain ⟨e_LE, f_LE, he_LE_pos, hf_LE_pos, hef_LE_eq, hres_LE, _, hincl_LE⟩ :=
      h_ef_rel L E hLE
    have hef_LE_q : e_LE * f_LE = q := hef_LE_eq.trans hFinE_eq
    obtain ⟨_, _, _, _, _, _, _, _, hvalL_surj, _⟩ := h_valL_props L
    obtain ⟨ϖ_L, hϖ_L⟩ := hvalL_surj 1
    have h_incl_diamond :
        IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C (ϖ_L : L)) =
          IntermediateField.inclusion hEK (IntermediateField.inclusion hLE (ϖ_L : L)) := by
      apply Subtype.ext
      rfl
    have h_val_diamond : (q : ℤ) * (k : ℤ) = (e_KE : ℤ) * (e_LE : ℤ) := by
      have h1 := congrArg (valL F K) h_incl_diamond
      rw [hValAlgK, hValMC_L, hValK_E, hincl_LE, hϖ_L, mul_one, mul_one, he_MCL_eq] at h1
      exact h1
    have h_nat_diamond : q * k = e_KE * e_LE := by exact_mod_cast h_val_diamond
    have he_LE_le_q : e_LE ≤ q := by nlinarith
    have he_KE_eq : e_KE = k := by nlinarith
    have he_LE_eq : e_LE = q := by nlinarith
    have hf_LE_eq : f_LE = 1 := by nlinarith
    have hres_EL : resDeg F E = resDeg F L := by
      rw [hres_LE, hf_LE_eq, one_mul]
    exact ⟨he_MCL_eq, he_KE_eq, hres_EL⟩

  exact ⟨hq_gt1, hp_valK, h_ef_MCK, h_res_comm, h_frob_surj_q, h_pow_p_mod1,
    h_gcd_roots_bound, h_diamond⟩

theorem ld_ch14_wild_inertia_jump_and_total_ramification (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M_C K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K)
    (hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (e_MCK f_MCK : ℕ) (he_pos : 1 ≤ e_MCK) (hf_pos : 1 ≤ f_MCK)
    (hef_eq : e_MCK * f_MCK = Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hres_f : resDeg F K = f_MCK * resDeg F M_C)
    (hnorm_f : ∀ w : K, valL F M_C (normLM F hM_CK w) = (f_MCK : ℤ) * valL F K w)
    (hincl_e : ∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (e_MCK : ℤ) * valL F M_C z)
    (G : Type u) [Group G] [Fintype G] (C H : Subgroup G)
    (act : G → K → K)
    [C.Normal]
    (hcard_C : Nat.card C = Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hH_gt1 : 1 < Nat.card H)
    (hC_exp : ∀ c ∈ C, c ^ (p F) = 1)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (hC_min_norm : ∀ N : Subgroup G, N.Normal → N = ⊥ ∨ C ≤ N)
    (hact_one : ∀ w : K, act 1 w = w)
    (hact_mul : ∀ (g₁ g₂ : G) (w : K), act (g₁ * g₂) w = act g₁ (act g₂ w))
    (hact_ring : ∀ g : G,
      act g 0 = 0 ∧ act g 1 = 1 ∧
      (∀ w₁ w₂ : K,
        act g (w₁ + w₂) = act g w₁ + act g w₂ ∧
        act g (w₁ * w₂) = act g w₁ * act g w₂ ∧
        act g (-w₁) = -act g w₁))
    (hact_faithful : ∀ g : G, (∀ w : K, act g w = w) → g = 1)
    (hact_val : ∀ (g : G) (w : K), valL F K (act g w) = valL F K w)
    (hC_mem_iff : ∀ g : G,
      g ∈ C ↔ ∀ z : M_C,
        act g (IntermediateField.inclusion hM_CK z) =
          IntermediateField.inclusion hM_CK z)
    (hact_trace_MCK : ∀ w : K,
      IntermediateField.inclusion hM_CK (traceLM F hM_CK w) = ∑ c : C, act c.1 w)
    (hact_norm_MCK : ∀ w : K,
      IntermediateField.inclusion hM_CK (normLM F hM_CK w) = ∏ c : C, act c.1 w)
    (h_res_comm : ∀ (σ τ : K →+* K),
      (∀ w : K, valL F K (σ w) = valL F K w) →
      (∀ w : K, valL F K (τ w) = valL F K w) →
      ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
        (σ (τ w) - τ (σ w) = 0 ∨ 1 ≤ valL F K (σ (τ w) - τ (σ w))))
    (h_frob_surj_q : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ w₁ : K, (w₁ = 0 ∨ 0 ≤ valL F K w₁) ∧
        (w - w₁ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 0 ∨
          1 ≤ valL F K (w - w₁ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (h_pow_p_mod1 : ∀ u : K, (u = 0 ∨ 0 ≤ valL F K u) →
      (u ^ (p F) - 1 = 0 ∨ 1 ≤ valL F K (u ^ (p F) - 1)) →
      (u - 1 = 0 ∨ 1 ≤ valL F K (u - 1))) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    qL F K = qL F M_C ∧
    resDeg F K = resDeg F M_C ∧
    (∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w) ∧
    (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z) ∧
    (∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z))) ∧
    ∃ (t : ℕ) (G₀ : Subgroup G),
      1 ≤ t ∧
      G₀.Normal ∧
      C ≤ G₀ ∧
      (∀ g : G,
        g ∈ G₀ ↔ ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
          (act g w - w = 0 ∨ 1 ≤ valL F K (act g w - w))) ∧
      (∀ c ∈ C, ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
        (act c w - w = 0 ∨ (t + 1 : ℤ) ≤ valL F K (act c w - w))) ∧
      (∀ c ∈ C, c ≠ 1 → ∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
        (ϖ_K : K) - act c (ϖ_K : K) ≠ 0 ∧
        valL F K ((ϖ_K : K) - act c (ϖ_K : K)) = (t + 1 : ℤ)) :=
by
  classical
  have h_valL_props : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L],
      valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) := by
    clear! M_C K e_MCK f_MCK G
    intro L _
    have halg : ∀ z : L,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F L = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq L.val L.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
