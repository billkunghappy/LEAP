theorem ld_ch14_stickelberger_p_power_assembly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    (hLE : L ≤ E) (hp_ne2 : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hμ'_pow : ∀ i : Fin D_orb.length, (μ'_orb i) ^ (p F) = 1)
    (hStatPowEven : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ → condExp F M θ % 2 = 0 →
      ∀ (c'_θ : Mˣ),
        valL F M (c'_θ : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M →
        (∀ x : M, (x = 0 ∨ ((condExp F M θ - 1 : ℕ) : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c'_θ⁻¹ : Mˣ) : M) * x)) →
        ∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ k : ℕ, k₀ ≤ k →
          (tateEps F M θ ψ_M) ^ ((p F) ^ k) =
            ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
              ((p F) ^ k) *
              (θ c'_θ : Ω F) ^ ((p F) ^ k))
    (hStatPowOdd : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ → p F ≠ 2 → condExp F M θ % 2 = 1 →
      ∀ (c'_θ : Mˣ),
        valL F M (c'_θ : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M →
        (∀ x : M, (x = 0 ∨ ((condExp F M θ - 1 : ℕ) : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c'_θ⁻¹ : Mˣ) : M) * x)) →
        ∀ (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M),
          resM 0 = 0 → resM 1 = 1 →
          (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
            resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
            resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
            resM (-x₁) = -resM x₁) →
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) →
          (∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a) →
