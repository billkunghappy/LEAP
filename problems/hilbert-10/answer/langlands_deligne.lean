            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q), hrel_ϖM]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F M := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F M 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
