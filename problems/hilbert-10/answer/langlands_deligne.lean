        · right; exact hge
      have hA_eq : (A : ℤ) = (ℓ : ℤ) * (a : ℤ) - ((ℓ : ℤ) - 1) := by
        dsimp [A]
        have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
        rw [ha_sub]
        ring
      have htr_val : traceLM F hLK y = 0 ∨ (a : ℤ) ≤ valL F L (traceLM F hLK y) := by
        apply hTraceBound (a : ℤ) y
        rcases hy_val with hy0 | hge
        · exact Or.inl hy0
        · exact Or.inr (by linarith)
      let r : L := normLM F hLK (1 + y) - (1 + traceLM F hLK y)
      have hr_val : r = 0 ∨ (a : ℤ) ≤ valL F L r := by
        have hy_val1 : y = 0 ∨ 1 ≤ valL F K y := by
          rcases hy_val with hy0 | hge
          · exact Or.inl hy0
          · exact Or.inr (by omega)
        rcases hNormRem y hy_val1 with hr0 | hrem
        · exact Or.inl hr0
        · by_cases hy0 : y = 0
          · left
            dsimp [r]
            rw [hy0, add_zero, map_one, map_zero, add_zero, sub_self]
          · right
            have hy_geA : (A : ℤ) ≤ valL F K y := hy_val.resolve_left hy0
            have hA_int : (A : ℤ) = (ℓ : ℤ) * ((a : ℤ) - 1) + 1 := by
              dsimp [A]
              have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
              rw [ha_sub]
            have h2A : (ℓ : ℤ) * ((a : ℤ) - 1) < 2 * valL F K y := by
              nlinarith
            have hlt_mul : (ℓ : ℤ) * ((a : ℤ) - 1) < (ℓ : ℤ) * valL F L r :=
              lt_of_lt_of_le h2A hrem
            have hlt_a : (a : ℤ) - 1 < valL F L r := by
              nlinarith
            omega
      have hnorm_sub : (((Units.map (normLM F hLK) w : Lˣ) : L)) - 1 = traceLM F hLK y + r := by
        change normLM F hLK (w : K) - 1 = traceLM F hLK y + r
        rw [hwy]
        dsimp [r]
        ring
      have hnorm_mem : Units.map (normLM F hLK) w ∈ unitGroup F L a := by
        rw [hunit_ge1_L a ha_pos]
        rcases hval_add_L (a : ℤ) (traceLM F hLK y) r htr_val hr_val with h0 | hge
        · left
          rw [← sub_eq_zero, hnorm_sub]
          exact h0
        · right
          rw [hnorm_sub]
          exact hge
      exact hχ'_triv_a (Units.map (normLM F hLK) w) hnorm_mem
    have hA_le_aK : A ≤ condExp F K χ'K := by
      by_cases ha1 : a = 1
      · have hA1 : A = 1 := by dsimp [A]; rw [ha1]; rfl
        by_contra hlt
        have haK0 : condExp F K χ'K = 0 := by omega
        have hχ'K_triv0 : ∀ w ∈ unitGroup F K 0, χ'K w = 1 := by
          intro w hw
          have h := hχ'K_cond w
          rw [haK0] at h
          exact h hw
        have hker_sub : ∀ v ∈ unitGroup F L 0, ν₁ v = 1 → χ' v = 1 := by
          intro v hv hνv
          obtain ⟨w, rfl⟩ := (hν₁_ker v).mpr hνv
          have hw_val : valL F K (w : K) = 0 := by
            rw [hValNorm (w : K)]
            exact (hunit0_L (Units.map (normLM F hLK) w)).mp hv
          exact hχ'K_triv0 w ((hunit0_K w).mpr hw_val)
        have hν₁_cond1 : condExp F L ν₁ = 1 := by
          rw [← pow_one ν₁]
          exact hν₁_cond_eq 1 hℓ_gt1 one_ne_zero
        obtain ⟨u₁, hu₁_mem, hu₁_ne⟩ := ((hSpecL ν₁).2.2.1 (by omega)).2
        have hu₁_mem0 : u₁ ∈ unitGroup F L 0 := by
          rw [hν₁_cond1] at hu₁_mem
          exact hu₁_mem
        have hu₁_pow_mem0 : u₁ ^ ℓ ∈ unitGroup F L 0 := Subgroup.pow_mem _ hu₁_mem0 ℓ
        have hν₁_u₁_pow : ν₁ (u₁ ^ ℓ) = 1 := by
          rw [map_pow, ← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
        have hχ'_u₁_pow : χ' (u₁ ^ ℓ) = 1 := hker_sub (u₁ ^ ℓ) hu₁_pow_mem0 hν₁_u₁_pow
        have hχ'_u₁_inv_pow : ((χ' u₁)⁻¹) ^ ℓ = 1 := by
          rw [inv_pow, ← map_pow, hχ'_u₁_pow, inv_one]
        obtain ⟨j, hj, hνj_u₁⟩ := hroot_exh u₁ hu₁_ne (χ' u₁)⁻¹ hχ'_u₁_inv_pow
        have htwist_u₁ : (ν₁ ^ j * χ') u₁ = 1 := by
          rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hνj_u₁, inv_mul_cancel]
        have htwist_triv0 : ∀ u ∈ unitGroup F L 0, (ν₁ ^ j * χ') u = 1 := by
          intro u hu
          have hνu_pow : (ν₁ u) ^ ℓ = 1 := by
            rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
          obtain ⟨k, _, hνk_u⟩ := hroot_exh u₁ hu₁_ne (ν₁ u) hνu_pow
          let v : Lˣ := u * (u₁ ^ k)⁻¹
          have hv_mem0 : v ∈ unitGroup F L 0 :=
            Subgroup.mul_mem _ hu (Subgroup.inv_mem _ (Subgroup.pow_mem _ hu₁_mem0 k))
          have hν_v : ν₁ v = 1 := by
            dsimp [v]
            rw [map_mul, map_inv, map_pow, hνk_u, mul_inv_cancel]
          have hχ'_v : χ' v = 1 := hker_sub v hv_mem0 hν_v
          have htwist_v : (ν₁ ^ j * χ') v = 1 := by
            rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hν_v, hχ'_v, one_pow, mul_one]
          have hu_eq : u = v * u₁ ^ k := by
            dsimp [v]
            exact (inv_mul_cancel_right u (u₁ ^ k)).symm
          rw [hu_eq, map_mul, map_pow, htwist_v, htwist_u₁, one_pow, mul_one]
        have hcond_twist_0 : condExp F L (ν₁ ^ j * χ') = 0 :=
          Nat.eq_zero_of_le_zero (Nat.sInf_le htwist_triv0)
        have hcond_twist_a : condExp F L (ν₁ ^ j * χ') = a := hCondTwist j hj
        omega
      · have ha2 : 2 ≤ a := by omega
        have hA_ge2 : 2 ≤ A - 1 := by
          dsimp [A]
          have : 1 ≤ a - 1 := by omega
          nlinarith
        obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := ((hSpecL χ').2.2.1 (by omega)).2
        have hu₀_val_ne1 : (u₀ : L) ≠ 1 := by
          intro h1
          apply hu₀_ne1
          have hu₀_eq1 : u₀ = 1 := Units.ext h1
          rw [hu₀_eq1, map_one]
        let x₀ : L := (u₀ : L) - 1
        have hx₀_ne0 : x₀ ≠ 0 := sub_ne_zero.mpr hu₀_val_ne1
        have hx₀_val : ((a - 1 : ℕ) : ℤ) ≤ valL F L x₀ :=
          ((hunit_ge1_L (a - 1) (by omega) u₀).mp hu₀_mem).resolve_left hu₀_val_ne1
        let y₀ : K := y_x x₀
        have hy₀_ne0 : y₀ ≠ 0 := hy_x_ne0 hx₀_ne0
        have hy₀_tr : traceLM F hLK y₀ = x₀ := hy_x_tr x₀
        have hy₀_val : (ℓ : ℤ) * ((a - 1 : ℕ) : ℤ) ≤ valL F K y₀ := by
          rw [hy_x_val hx₀_ne0]
          exact mul_le_mul_of_nonneg_left hx₀_val (by omega)
        have hA_sub1_int : ((A - 1 : ℕ) : ℤ) = (ℓ : ℤ) * ((a - 1 : ℕ) : ℤ) := by
          dsimp [A]
        have hy₀_ge2 : (2 : ℤ) ≤ valL F K y₀ := by
          have : (2 : ℤ) ≤ ((A - 1 : ℕ) : ℤ) := by exact_mod_cast hA_ge2
          linarith
        have h1y₀_ne0 : 1 + y₀ ≠ 0 := by
          intro h0
          have hy₀_eq : y₀ = -1 := eq_neg_of_add_eq_zero_right h0
          have hval : valL F K y₀ = 0 := by rw [hy₀_eq, hval_neg1_K]
          omega
        let w₀ : Kˣ := Units.mk0 (1 + y₀) h1y₀_ne0
        have hw₀_mem : w₀ ∈ unitGroup F K (A - 1) := by
          rw [hunit_ge1_K (A - 1) (by omega) w₀]
          right
          have hsub : (w₀ : K) - 1 = y₀ := by change (1 + y₀) - 1 = y₀; ring
          rw [hsub, hA_sub1_int]
          exact hy₀_val
        let v₀ : Lˣ := Units.map (normLM F hLK) w₀
        let δ₀ : L := (v₀ : L) - (u₀ : L)
        have hδ₀_eq : δ₀ = normLM F hLK (1 + y₀) - (1 + traceLM F hLK y₀) := by
          change normLM F hLK (1 + y₀) - (u₀ : L) = normLM F hLK (1 + y₀) - (1 + traceLM F hLK y₀)
          rw [hy₀_tr]
          dsimp [x₀]
          ring
        have hδ₀_val : δ₀ = 0 ∨ (a : ℤ) ≤ valL F L δ₀ := by
          rw [hδ₀_eq]
          rcases hNormRem y₀ (Or.inr (by omega)) with h0 | hrem
          · exact Or.inl h0
          · right
            have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
            have h2y₀ : (ℓ : ℤ) * (a : ℤ) ≤ 2 * valL F K y₀ := by
              nlinarith
            have hle_mul : (ℓ : ℤ) * (a : ℤ) ≤ (ℓ : ℤ) * valL F L (normLM F hLK (1 + y₀) - (1 + traceLM F hLK y₀)) :=
              le_trans h2y₀ hrem
            nlinarith
        let h_u : Lˣ := v₀ * u₀⁻¹
        have hh_u_sub : (h_u : L) - 1 = δ₀ * ((u₀⁻¹ : Lˣ) : L) := by
          dsimp [h_u, δ₀]
          rw [sub_mul, Units.mul_inv]
        have hu₀_inv_val0 : valL F L ((u₀⁻¹ : Lˣ) : L) = 0 := by
          rw [hval_inv_L u₀, hunit_val0_L (a - 1) u₀ hu₀_mem, neg_zero]
        have hh_u_mem : h_u ∈ unitGroup F L a := by
          rw [hunit_ge1_L a ha_pos h_u]
          rcases hδ₀_val with hδ0 | hδge
          · left
            rw [← sub_eq_zero, hh_u_sub, hδ0, zero_mul]
          · by_cases hδ0 : δ₀ = 0
            · left
              rw [← sub_eq_zero, hh_u_sub, hδ0, zero_mul]
            · right
              rw [hh_u_sub, hval_mul_L δ₀ ((u₀⁻¹ : Lˣ) : L) hδ0 (Units.ne_zero _),
                hu₀_inv_val0, add_zero]
              exact hδge
        have hχ'_hu : χ' h_u = 1 := hχ'_triv_a h_u hh_u_mem
        have hv₀_eq : v₀ = h_u * u₀ := by
          dsimp [h_u]
          exact (inv_mul_cancel_right v₀ u₀).symm
        have hχ'K_w₀ : χ'K w₀ ≠ 1 := by
          change χ' v₀ ≠ 1
          rw [hv₀_eq, map_mul, hχ'_hu, one_mul]
          exact hu₀_ne1
        by_contra hlt
        have hle_sub1 : condExp F K χ'K ≤ A - 1 := by omega
        have hw₀_cond : w₀ ∈ unitGroup F K (condExp F K χ'K) :=
          hunit_anti_K hle_sub1 hw₀_mem
        exact hχ'K_w₀ (hχ'K_cond w₀ hw₀_cond)
    exact ⟨hCondTwist, le_antisymm haK_le_A hA_le_aK⟩
  exact ⟨hCondψK, hT0, hCondPos⟩

theorem ld_tame_ramified_uniformizer_and_conductors (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hRam : condExp F L ν₁ ≠ 0)
    (hNeP : Module.finrank L (IntermediateField.extendScalars hLK) ≠ p F) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
    FiniteDimensional F L ∧
    FiniteDimensional F K ∧
    IsAdmissibleChar F K (traceChar F hLK ψ) ∧
    (∀ u ∈ unitGroup F L 1, ν₁ u = 1) ∧
    (∀ j < ℓ, j ≠ 0 → condExp F L (ν₁ ^ j) = 1) ∧
    resDeg F K = resDeg F L ∧
    (∀ y : K, valL F K y = valL F L (normLM F hLK y)) ∧
    (∀ x : L, valL F K (IntermediateField.inclusion hLK x) = (ℓ : ℤ) * valL F L x) ∧
    condExpChar F K (traceChar F hLK ψ) = (ℓ : ℤ) * (condExpChar F L ψ + 1) - 1 ∧
    (∃ ϖ_K : Kˣ,
      valL F K (ϖ_K : K) = 1 ∧
      valL F L ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) = 1 ∧
      ν₁ (Units.map (normLM F hLK) ϖ_K) = 1 ∧
      (ℓ = 2 →
        traceLM F hLK (ϖ_K : K) = 0 ∧
        (ϖ_K : K) ^ 2 = - IntermediateField.inclusion hLK ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L))) ∧
    (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨ 1 ≤ valL F K (y - IntermediateField.inclusion hLK x))) ∧
    (∀ (m : ℤ) (y : K),
      (y = 0 ∨ (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) ∧
    (∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
      normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        2 * valL F K y ≤ (ℓ : ℤ) * valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y))) ∧
    (condExp F L χ' = 0 →
      tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
      tateEps F K 1 (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j * χ') ψ)) ∧
    (1 ≤ condExp F L χ' →
      (∀ j < ℓ, condExp F L (ν₁ ^ j * χ') = condExp F L χ') ∧
      condExp F K (χ'.comp (Units.map (normLM F hLK))) = ℓ * (condExp F L χ' - 1) + 1) :=
by
  have hFinK : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F K := hFinK
  have hFinL : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  haveI : FiniteDimensional F L := hFinL
  have hψK : IsAdmissibleChar F K (traceChar F hLK ψ) :=
    ld_traceChar_admissible F L K hLK hAb.2.2 ψ hψ
  have hp : Nat.Prime (p F) := (ld_frob_pow_on_primeToP_roots F).1
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalK_props := ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, _, haddVal_mul, _, _, halg1, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  have hp_valL : ((p F : ℕ) : L) = 0 ∨ 1 ≤ valL F L ((p F : ℕ) : L) := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] (p F : 𝒪[F]) = 0 := by
      rw [map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (p F)
    have hker : valuation F ((p F : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    have hpF : (p F : F) = 0 ∨ 1 ≤ addVal F (p F : F) := by
      by_cases hp0 : (p F : F) = 0
      · exact Or.inl hp0
      · right
        have hφp : φ (valuation F (p F : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
        have hlt : φ (valuation F (p F : F)) < 1 := by
          rw [← map_one φ, map_lt_map_iff φ]
          exact hker
        rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
          ← Multiplicative.toAdd_lt, toAdd_one] at hlt
        unfold addVal
        rw [dif_neg hp0]
        omega
    simpa using halg1 (p F : F) hpF
  obtain ⟨⟨hℓ_ne0, hℓ_val0⟩, hν₁_triv1, hν₁_cond_eq, hroot_exh,
    hResDeg, hValNorm, hValAlg, ⟨ϖ_K₀, hϖ_K₀⟩, hResSurj⟩ :=
    ld_tame_unit_triv_val_and_residue_surj F L K hLK hPrime ν₁
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hRam hNeP hp hp_valL
      haddVal1 haddVal_mul hvalL_props hvalK_props
  obtain ⟨hTraceBound, hNormRem, hUniformizer⟩ :=
    ld_tame_galois_trace_norm_bounds_and_uniformizer F L K hLK hGal hPrime ν₁
      hν₁_ker hℓ_ne0 hℓ_val0 hValNorm hValAlg ϖ_K₀ hϖ_K₀ hvalL_props hvalK_props
  obtain ⟨hCondψK, hT0, hCondPos⟩ :=
    ld_tame_conductor_formulas_and_unramified_twist F L K hLK hPrime ψ hψ hψK ν₁ χ'
      hν₁_pow hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond
      hℓ_ne0 hℓ_val0 hν₁_triv1 hν₁_cond_eq hroot_exh
      hValNorm hValAlg hTraceBound hNormRem hvalL_props hvalK_props
      (ld_condExp_and_condExpChar_spec F L ψ hψ)
      (ld_condExp_and_condExpChar_spec F K (traceChar F hLK ψ) hψK)
      (ld_unitCoset_finite F L)
  exact ⟨hFinL, hFinK, hψK, hν₁_triv1, hν₁_cond_eq, hResDeg, hValNorm, hValAlg,
    hCondψK, hUniformizer, hResSurj, hTraceBound, hNormRem, hT0, hCondPos⟩

theorem ld_finite_field_cyclic_char_and_zeta (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ)
    (ν_k : kˣ →* (Ω F)ˣ)
    (hν_pow : ν_k ^ ℓ = 1) (hν_ne : ν_k ≠ 1) :
    (∀ j ∈ (Finset.range ℓ).erase 0, ν_k ^ j ≠ 1) ∧
    (∃ ζ : k,
      ζ ≠ 0 ∧
      ζ ^ ℓ = 1 ∧
      (∀ r : ℕ, 1 ≤ r → r < ℓ → ζ ^ r ≠ 1) ∧
      (∏ m ∈ Finset.range ℓ, ζ ^ m) = (-1 : k) ^ (ℓ - 1)) ∧
    (∀ u : kˣ,
      (∑ j ∈ Finset.range ℓ, ((ν_k ^ j) u : Ω F)) =
        ((Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card : Ω F) ∧
      ((∃ y : k, y ^ ℓ = (u : k)) →
        (Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card = ℓ)) :=
by
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  have h_ord_ν : orderOf ν_k = ℓ := orderOf_eq_prime hν_pow hν_ne
  have hν_ne_pow : ∀ j ∈ (Finset.range ℓ).erase 0, ν_k ^ j ≠ 1 := by
    intro j hj
    have hj_ne : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < orderOf ν_k := by
      rw [h_ord_ν]
      exact Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    exact pow_ne_one_of_lt_orderOf hj_ne hj_lt
  obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := kˣ)
  have h_ord_g₀ : orderOf g₀ = Fintype.card kˣ := by
    rw [orderOf_eq_card_of_forall_mem_powers hg₀, Nat.card_eq_fintype_card]
  have hν_g₀_ne : ν_k g₀ ≠ 1 := by
    intro h1
    apply hν_ne
    ext u
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff u g₀).mp (hg₀ u)
    rw [map_pow, h1, one_pow, MonoidHom.one_apply]
  have hν_g₀_pow : (ν_k g₀) ^ ℓ = 1 := by
    rw [← MonoidHom.pow_apply, hν_pow, MonoidHom.one_apply]
  have h_ord_νg₀ : orderOf (ν_k g₀) = ℓ := orderOf_eq_prime hν_g₀_pow hν_g₀_ne
  have h_dvd_card : ℓ ∣ Fintype.card kˣ := by
    rw [← h_ord_νg₀]
    apply orderOf_dvd_of_pow_eq_one
    rw [← map_pow, pow_card_eq_one, map_one]
  let q₁ : ℕ := Fintype.card kˣ
  have hq₁_pos : 0 < q₁ := Fintype.card_pos
  let d₀ : ℕ := q₁ / ℓ
  have hd₀_mul : d₀ * ℓ = q₁ := Nat.div_mul_cancel h_dvd_card
  have h_two_le : 2 ≤ ℓ := hPrime.two_le
  have hd₀_ne0 : d₀ ≠ 0 := by
    intro h0
    have hq0 : q₁ = 0 := by rw [← hd₀_mul, h0, zero_mul]
    omega
  have hd₀_lt : d₀ < q₁ := by
    have h1 : d₀ * 2 ≤ d₀ * ℓ := Nat.mul_le_mul_left d₀ h_two_le
    omega
  let ζ_u : kˣ := g₀ ^ d₀
  let ζ : k := (ζ_u : k)
  have hζ_ne : ζ ≠ 0 := Units.ne_zero ζ_u
  have hζu_pow : ζ_u ^ ℓ = 1 := by
    dsimp [ζ_u]
    rw [← pow_mul, hd₀_mul, pow_card_eq_one]
  have hζ_pow : ζ ^ ℓ = 1 := by
    dsimp [ζ]
    rw [← Units.val_pow_eq_pow_val, hζu_pow, Units.val_one]
  have hζu_ne1 : ζ_u ≠ 1 := by
    apply pow_ne_one_of_lt_orderOf hd₀_ne0
    rw [h_ord_g₀]
    exact hd₀_lt
  have h_ord_ζu : orderOf ζ_u = ℓ := orderOf_eq_prime hζu_pow hζu_ne1
  have hζu_prim : ∀ r : ℕ, 1 ≤ r → r < ℓ → ζ_u ^ r ≠ 1 := by
    intro r hr1 hr_lt
    apply pow_ne_one_of_lt_orderOf (by omega)
    rw [h_ord_ζu]
    exact hr_lt
  have hζ_prim : ∀ r : ℕ, 1 ≤ r → r < ℓ → ζ ^ r ≠ 1 := by
    intro r hr1 hr_lt h_eq
    apply hζu_prim r hr1 hr_lt
    ext
    rw [Units.val_pow_eq_pow_val, Units.val_one]
    exact h_eq
  have hζ_prod : (∏ m ∈ Finset.range ℓ, ζ ^ m) = (-1 : k) ^ (ℓ - 1) := by
    rw [Finset.prod_pow_eq_pow_sum, Finset.sum_range_id]
    rcases hPrime.eq_two_or_odd with rfl | hodd
    · norm_num
      have h_ne1 : ζ ≠ 1 := by
        simpa using hζ_prim 1 le_rfl (by omega)
      exact (sq_eq_one_iff.mp hζ_pow).resolve_left h_ne1
    · have h_sub : ℓ - 1 = 2 * ((ℓ - 1) / 2) := by omega
      have h_eq : ℓ * (ℓ - 1) = 2 * (ℓ * ((ℓ - 1) / 2)) := by
        calc ℓ * (ℓ - 1) = ℓ * (2 * ((ℓ - 1) / 2)) := by rw [← h_sub]
          _ = 2 * (ℓ * ((ℓ - 1) / 2)) := by ring
      have h_div : ℓ * (ℓ - 1) / 2 = ℓ * ((ℓ - 1) / 2) := by omega
      rw [h_div, pow_mul, hζ_pow, one_pow, h_sub, pow_mul, neg_one_sq, one_pow]
  have h_card_eq_ell : ∀ u : kˣ, (∃ y : k, y ^ ℓ = (u : k)) →
      (Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card = ℓ := by
    intro u ⟨y₀, hy₀⟩
    have hy₀_ne : y₀ ≠ 0 := by
      intro h0
      rw [h0, zero_pow hPrime.ne_zero] at hy₀
      exact Units.ne_zero u hy₀.symm
    let f : ℕ → k := fun m => y₀ * ζ ^ m
    have h_sub : (Finset.range ℓ).image f ⊆ Finset.univ.filter (fun y : k => y ^ ℓ = (u : k)) := by
      intro y hy
      rcases Finset.mem_image.mp hy with ⟨m, _, rfl⟩
      rw [Finset.mem_filter]
      refine ⟨Finset.mem_univ _, ?_⟩
      dsimp [f]
      rw [mul_pow, hy₀, ← pow_mul, mul_comm m ℓ, pow_mul, hζ_pow, one_pow, mul_one]
    have h_inj : Set.InjOn f (Finset.range ℓ) := by
      intro m₁ hm₁ m₂ hm₂ hf
      rw [Finset.mem_coe, Finset.mem_range] at hm₁ hm₂
      have hζ_eq : ζ ^ m₁ = ζ ^ m₂ := mul_left_cancel₀ hy₀_ne hf
      have hζu_eq : ζ_u ^ m₁ = ζ_u ^ m₂ := by
        ext
        rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
        exact hζ_eq
      by_contra hm_ne
      rcases lt_or_gt_of_ne hm_ne with hlt | hgt
      · have h_add : m₁ + (m₂ - m₁) = m₂ := Nat.add_sub_of_le (le_of_lt hlt)
        have h_mul : ζ_u ^ m₁ * 1 = ζ_u ^ m₁ * ζ_u ^ (m₂ - m₁) := by
          rw [mul_one, ← pow_add, h_add, hζu_eq]
        have h_pow1 : ζ_u ^ (m₂ - m₁) = 1 := (mul_left_cancel h_mul).symm
        exact hζu_prim (m₂ - m₁) (by omega) (by omega) h_pow1
      · have h_add : m₂ + (m₁ - m₂) = m₁ := Nat.add_sub_of_le (le_of_lt hgt)
        have h_mul : ζ_u ^ m₂ * 1 = ζ_u ^ m₂ * ζ_u ^ (m₁ - m₂) := by
          rw [mul_one, ← pow_add, h_add, ← hζu_eq]
        have h_pow1 : ζ_u ^ (m₁ - m₂) = 1 := (mul_left_cancel h_mul).symm
        exact hζu_prim (m₁ - m₂) (by omega) (by omega) h_pow1
    have h_le : ℓ ≤ (Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card := by
      calc ℓ = (Finset.range ℓ).card := (Finset.card_range ℓ).symm
        _ = ((Finset.range ℓ).image f).card := (Finset.card_image_of_injOn h_inj).symm
        _ ≤ (Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card := Finset.card_le_card h_sub
    let P : Polynomial k := Polynomial.X ^ ℓ - Polynomial.C (u : k)
    have hP_monic : P.Monic := Polynomial.monic_X_pow_sub_C (u : k) hPrime.ne_zero
    have hP_ne : P ≠ 0 := hP_monic.ne_zero
    have hP_deg : P.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    have h_sub_roots : Finset.univ.filter (fun y : k => y ^ ℓ = (u : k)) ⊆ P.roots.toFinset := by
      intro y hy
      have hy_eq : y ^ ℓ = (u : k) := (Finset.mem_filter.mp hy).2
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      simp [P, hy_eq]
    have h_ge : (Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card ≤ ℓ := by
      calc (Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card
        _ ≤ P.roots.toFinset.card := Finset.card_le_card h_sub_roots
        _ ≤ P.roots.card := Multiset.toFinset_card_le P.roots
        _ ≤ P.natDegree := Polynomial.card_roots' P
        _ = ℓ := hP_deg
    exact le_antisymm h_ge h_le
  have h_ker_iff : ∀ u : kˣ, (∃ y : k, y ^ ℓ = (u : k)) ↔ ν_k u = 1 := by
    intro u
    constructor
    · rintro ⟨y, hy⟩
      have hy_ne : y ≠ 0 := by
        intro h0
        rw [h0, zero_pow hPrime.ne_zero] at hy
        exact Units.ne_zero u hy.symm
      let y_u : kˣ := Units.mk0 y hy_ne
      have hy_u : y_u ^ ℓ = u := by
        ext
        rw [Units.val_pow_eq_pow_val, Units.val_mk0]
        exact hy
      rw [← hy_u, map_pow, ← MonoidHom.pow_apply, hν_pow, MonoidHom.one_apply]
    · intro hν_u
      obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff u g₀).mp (hg₀ u)
      have h_pow_m : (ν_k g₀) ^ m = 1 := by
        rw [← map_pow, hν_u]
      have h_dvd_m : ℓ ∣ m := by
        rw [← h_ord_νg₀]
        exact orderOf_dvd_of_pow_eq_one h_pow_m
      rcases h_dvd_m with ⟨c, rfl⟩
      refine ⟨((g₀ ^ c : kˣ) : k), ?_⟩
      rw [← Units.val_pow_eq_pow_val, ← pow_mul, mul_comm c ℓ]
  have h_sum : ∀ u : kˣ,
      (∑ j ∈ Finset.range ℓ, ((ν_k ^ j) u : Ω F)) =
        ((Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card : Ω F) := by
    intro u
    by_cases hex : ∃ y : k, y ^ ℓ = (u : k)
    · have hν_u : ν_k u = 1 := (h_ker_iff u).mp hex
      have h_lhs : (∑ j ∈ Finset.range ℓ, ((ν_k ^ j) u : Ω F)) = (ℓ : Ω F) := by
        have h_term : ∀ j ∈ Finset.range ℓ, ((ν_k ^ j) u : Ω F) = 1 := by
          intro j _
          rw [MonoidHom.pow_apply, hν_u, one_pow, Units.val_one]
        rw [Finset.sum_congr rfl h_term, Finset.sum_const, Finset.card_range, nsmul_one]
      rw [h_lhs, h_card_eq_ell u hex]
    · have hν_u_ne : ν_k u ≠ 1 := (h_ker_iff u).not.mp hex
      let α : Ω F := (ν_k u : Ω F)
      have hα_ne1 : α ≠ 1 := by
        intro h1
        apply hν_u_ne
        ext
        exact h1
      have hα_sub : α - 1 ≠ 0 := sub_ne_zero.mpr hα_ne1
      have hα_pow : α ^ ℓ = 1 := by
        dsimp [α]
        rw [← Units.val_pow_eq_pow_val, ← MonoidHom.pow_apply, hν_pow,
          MonoidHom.one_apply, Units.val_one]
      have h_lhs_eq : (∑ j ∈ Finset.range ℓ, ((ν_k ^ j) u : Ω F)) = ∑ j ∈ Finset.range ℓ, α ^ j := by
        apply Finset.sum_congr rfl
        intro j _
        dsimp [α]
      have h_geom : (∑ j ∈ Finset.range ℓ, α ^ j) * (α - 1) = 0 := by
        rw [geom_sum_mul, hα_pow, sub_self]
      have h_lhs0 : (∑ j ∈ Finset.range ℓ, α ^ j) = 0 :=
        (mul_eq_zero.mp h_geom).resolve_right hα_sub
      have h_empty : Finset.univ.filter (fun y : k => y ^ ℓ = (u : k)) = ∅ := by
        rw [Finset.filter_eq_empty_iff]
        intro y _ hy
        exact hex ⟨y, hy⟩
      rw [h_lhs_eq, h_lhs0, h_empty, Finset.card_empty, Nat.cast_zero]
  exact ⟨hν_ne_pow, ⟨ζ, hζ_ne, hζ_pow, hζ_prim, hζ_prod⟩, fun u => ⟨h_sum u, h_card_eq_ell u⟩⟩

theorem ld_monic_deg_and_von_mangoldt_newton (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k] :
    ∃ (M : ℕ → Finset (Polynomial k)) (Λ : Polynomial k → ℕ),
      (∀ (d : ℕ) (f : Polynomial k), f ∈ M d ↔ f.Monic ∧ f.natDegree = d) ∧
      M 0 = {1} ∧
      (∀ (μ : Polynomial k → Ω F),
        (∑ f ∈ M 1, μ f) = ∑ x : k, μ (Polynomial.X - Polynomial.C x)) ∧
      (∀ (P : Polynomial k) (m : ℕ), P.Monic → Irreducible P → 1 ≤ m →
        Λ (P ^ m) = P.natDegree) ∧
      (∀ (Q : Polynomial k), Λ Q ≠ 0 →
        ∃ (P : Polynomial k) (m : ℕ), P.Monic ∧ Irreducible P ∧ 1 ≤ m ∧ Q = P ^ m) ∧
      (∀ (μ : Polynomial k → Ω F),
        (∀ f g : Polynomial k, f.Monic → g.Monic → μ (f * g) = μ f * μ g) →
        ∀ (n : ℕ),
          (∑ d ∈ Finset.Icc 1 n,
            (∑ Q ∈ M d, (Λ Q : Ω F) * μ Q) * (∑ B ∈ M (n - d), μ B)) =
            (n : Ω F) * (∑ P ∈ M n, μ P)) ∧
      (∀ (d : ℕ), 1 ≤ d →
        (∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0), Λ G) =
          (Fintype.card k) ^ d - 1) ∧
      (∀ (β : kˣ →* (Ω F)ˣ), β ≠ 1 → ∀ (d : ℕ), 1 ≤ d →
        (∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0),
          (Λ G : Ω F) *
            (if h : (-1 : k) ^ d * G.coeff 0 ≠ 0 then
              (β (Units.mk0 ((-1 : k) ^ d * G.coeff 0) h) : Ω F)
            else 0)) = 0) ∧
      (∀ (α : kˣ →* (Ω F)ˣ) (ψ_k : AddChar k (Ω F)), ψ_k ≠ 1 →
        ∀ (d : ℕ), 1 ≤ d →
          (∑ G ∈ M d,
            (Λ G : Ω F) *
              ((if h : (-1 : k) ^ G.natDegree * G.coeff 0 ≠ 0 then
                  (α (Units.mk0 ((-1 : k) ^ G.natDegree * G.coeff 0) h) : Ω F)
                else 0) *
                ψ_k (-G.nextCoeff))) =
            (-1 : Ω F) ^ (d - 1) *
              (∑ x : kˣ, (α x : Ω F) * ψ_k (x : k)) ^ d) :=
by
  let polyPhi : ∀ d : ℕ, (Fin d → k) → Polynomial k := fun d c =>
    Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)
  have coeff_polyPhi_lt : ∀ {d : ℕ} (c : Fin d → k) {j : ℕ} (hj : j < d),
      (polyPhi d c).coeff j = c ⟨j, hj⟩ := by
    intro d c j hj
    dsimp [polyPhi]
    rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
      Polynomial.finset_sum_coeff]
    rw [Finset.sum_eq_single ⟨j, hj⟩]
    · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
    · intro b _ hb
      have hbj : j ≠ (b : ℕ) := by
        intro h
        apply hb
        ext
        exact h.symm
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hbj, mul_zero]
    · intro h
      exact False.elim (h (Finset.mem_univ _))
  have coeff_polyPhi_eq : ∀ {d : ℕ} (c : Fin d → k),
      (polyPhi d c).coeff d = 1 := by
    intro d c
    dsimp [polyPhi]
    rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_pos rfl,
      Polynomial.finset_sum_coeff]
    suffices h : (∑ i : Fin d, (Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)).coeff d) = 0 by
      rw [h, add_zero]
    apply Finset.sum_eq_zero
    intro i _
    have hid : d ≠ (i : ℕ) := by omega
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hid, mul_zero]
  have coeff_polyPhi_gt : ∀ {d : ℕ} (c : Fin d → k) {j : ℕ} (hj : d < j),
      (polyPhi d c).coeff j = 0 := by
    intro d c j hj
    dsimp [polyPhi]
    rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
      Polynomial.finset_sum_coeff]
    apply Finset.sum_eq_zero
    intro i _
    have hij : j ≠ (i : ℕ) := by omega
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hij, mul_zero]
  have polyPhi_injective : ∀ d : ℕ, Function.Injective (polyPhi d) := by
    intro d c₁ c₂ h
    funext i
    have h1 := coeff_polyPhi_lt c₁ i.isLt
    have h2 := coeff_polyPhi_lt c₂ i.isLt
    have hi : (⟨(i : ℕ), i.isLt⟩ : Fin d) = i := Fin.ext rfl
    rw [hi] at h1 h2
    rw [← h1, ← h2, h]
  have polyPhi_monic_and_natDegree : ∀ {d : ℕ} (c : Fin d → k),
      (polyPhi d c).Monic ∧ (polyPhi d c).natDegree = d := by
    intro d c
    have hle : (polyPhi d c).natDegree ≤ d := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      exact coeff_polyPhi_gt c hN
    have hge : d ≤ (polyPhi d c).natDegree := by
      apply Polynomial.le_natDegree_of_ne_zero
      rw [coeff_polyPhi_eq]
      exact one_ne_zero
    have hdeg : (polyPhi d c).natDegree = d := le_antisymm hle hge
    refine ⟨?_, hdeg⟩
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg, coeff_polyPhi_eq]
  have eq_polyPhi_of_monic_natDegree : ∀ {d : ℕ} {f : Polynomial k},
      f.Monic → f.natDegree = d → polyPhi d (fun i : Fin d => f.coeff (i : ℕ)) = f := by
    intro d f hf_mon hf_deg
    ext j
    rcases lt_trichotomy j d with hlt | rfl | hgt
    · exact coeff_polyPhi_lt _ hlt
    · rw [coeff_polyPhi_eq]
      have hlead : f.coeff j = f.leadingCoeff := by rw [Polynomial.leadingCoeff, hf_deg]
      rw [hlead, hf_mon.leadingCoeff]
    · rw [coeff_polyPhi_gt _ hgt, Polynomial.coeff_eq_zero_of_natDegree_lt (hf_deg ▸ hgt)]
  let M : ℕ → Finset (Polynomial k) := fun d => Finset.univ.image (polyPhi d)
  have hM_mem : ∀ (d : ℕ) (f : Polynomial k), f ∈ M d ↔ f.Monic ∧ f.natDegree = d := by
    intro d f
    simp only [M, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨c, rfl⟩
      exact polyPhi_monic_and_natDegree c
    · rintro ⟨hf_mon, hf_deg⟩
      exact ⟨fun i => f.coeff (i : ℕ), eq_polyPhi_of_monic_natDegree hf_mon hf_deg⟩
  have hM_card : ∀ d : ℕ, (M d).card = (Fintype.card k) ^ d := by
    intro d
    simp only [M]
    rw [Finset.card_image_of_injective _ (polyPhi_injective d), Finset.card_univ,
      Fintype.card_fun, Fintype.card_fin]
  have hM_zero : M 0 = {1} := by
    ext f
    rw [hM_mem, Finset.mem_singleton]
    constructor
    · rintro ⟨hf_mon, hf_deg⟩
      rw [(eq_polyPhi_of_monic_natDegree hf_mon hf_deg).symm]
      dsimp [polyPhi]
      rw [pow_zero, Finset.univ_eq_empty, Finset.sum_empty, add_zero]
    · rintro rfl
      exact ⟨Polynomial.monic_one, Polynomial.natDegree_one⟩
  have hM_one : ∀ (μ : Polynomial k → Ω F),
      (∑ f ∈ M 1, μ f) = ∑ x : k, μ (Polynomial.X - Polynomial.C x) := by
    intro μ
    let ψ₁ : k → Polynomial k := fun x => Polynomial.X - Polynomial.C x
    have hψ₁_inj : Function.Injective ψ₁ := by
      intro x₁ x₂ h
      have hc := congr_arg (fun p : Polynomial k => p.coeff 0) h
      simp only [ψ₁, Polynomial.coeff_sub, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero,
        zero_sub, neg_inj] at hc
      exact hc
    have hM1 : M 1 = Finset.univ.image ψ₁ := by
      ext f
      rw [hM_mem, Finset.mem_image]
      constructor
      · rintro ⟨hf_mon, hf_deg⟩
        refine ⟨-f.coeff 0, Finset.mem_univ _, ?_⟩
        have hphi := eq_polyPhi_of_monic_natDegree hf_mon hf_deg
        dsimp [polyPhi] at hphi
        simp only [Fin.sum_univ_one, Fin.val_zero, pow_zero, mul_one, pow_one] at hphi
        simp only [ψ₁, map_neg, sub_neg_eq_add]
        exact hphi
      · rintro ⟨x, _, rfl⟩
        exact ⟨Polynomial.monic_X_sub_C x, Polynomial.natDegree_X_sub_C x⟩
    rw [hM1, Finset.sum_image (fun x _ y _ h => hψ₁_inj h)]
  have hM_deg_sum : ∀ (d : ℕ) (μ : Polynomial k → Ω F),
      (∑ f ∈ M d, μ f) = ∑ c : Fin d → k, μ (polyPhi d c) := by
    intro d μ
    simp only [M]
    rw [Finset.sum_image (fun x _ y _ h => polyPhi_injective d h)]
  clear_value M
  have prime_pow_base_unique : ∀ (P₁ P₂ : Polynomial k) (k₁ k₂ : ℕ),
      P₁.Monic → Irreducible P₁ → 1 ≤ k₁ →
      P₂.Monic → Irreducible P₂ → 1 ≤ k₂ →
      P₁ ^ k₁ = P₂ ^ k₂ → P₁ = P₂ := by
    intro P₁ P₂ k₁ k₂ hP₁_mon hP₁_irr hk₁ hP₂_mon hP₂_irr _hk₂ heq
    have hdvd_pow : P₁ ∣ P₂ ^ k₂ := heq ▸ dvd_pow_self P₁ (by omega)
    have hP₁_prime : Prime P₁ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hP₁_irr
    have hdvd : P₁ ∣ P₂ := hP₁_prime.dvd_of_dvd_pow hdvd_pow
    have hassoc : Associated P₁ P₂ :=
      (Irreducible.dvd_irreducible_iff_associated hP₁_irr hP₂_irr).mp hdvd
    exact Polynomial.eq_of_monic_of_associated hP₁_mon hP₂_mon hassoc
  let isPolyPrimePow : Polynomial k → Prop := fun Q =>
    ∃ P : Polynomial k, P.Monic ∧ Irreducible P ∧ ∃ m : ℕ, 1 ≤ m ∧ Q = P ^ m
  let Λ : Polynomial k → ℕ := fun Q =>
    if h : isPolyPrimePow Q then h.choose.natDegree else 0
  have hΛ_prime_pow : ∀ (P : Polynomial k) (m : ℕ), P.Monic → Irreducible P → 1 ≤ m →
      Λ (P ^ m) = P.natDegree := by
    intro P m hP_mon hP_irr hm
    have h : isPolyPrimePow (P ^ m) := ⟨P, hP_mon, hP_irr, m, hm, rfl⟩
    dsimp [Λ]
    rw [dif_pos h]
    rcases h.choose_spec with ⟨hP'_mon, hP'_irr, m', hm', heq⟩
    have hP_eq : h.choose = P :=
      prime_pow_base_unique h.choose P m' m hP'_mon hP'_irr hm' hP_mon hP_irr hm heq.symm
    rw [hP_eq]
  have hΛ_ne_zero : ∀ (Q : Polynomial k), Λ Q ≠ 0 →
      ∃ (P : Polynomial k) (m : ℕ), P.Monic ∧ Irreducible P ∧ 1 ≤ m ∧ Q = P ^ m := by
    intro Q hne
    have hpp : isPolyPrimePow Q := by
      by_contra hnot
      apply hne
      dsimp [Λ]
      exact dif_neg hnot
    rcases hpp with ⟨P, hP_mon, hP_irr, m, hm, hQ⟩
    exact ⟨P, m, hP_mon, hP_irr, hm, hQ⟩
  have monic_irreducible_natDegree_pos : ∀ {P : Polynomial k},
      P.Monic → Irreducible P → 0 < P.natDegree := by
    intro P hP_mon hP_irr
    by_contra h
    have h0 : P.natDegree = 0 := by omega
    have h1 : P = 1 := by
      rw [Polynomial.eq_C_of_natDegree_eq_zero h0]
      have hc : P.coeff 0 = P.leadingCoeff := by rw [Polynomial.leadingCoeff, h0]
      rw [hc, hP_mon.leadingCoeff, map_one]
    exact hP_irr.ne_one h1
  obtain ⟨polyPrimePowDivs, mem_polyPrimePowDivs, sum_polyPrimePowDivs_eq, polyPrimePowDivs_deg0⟩ :
      ∃ (polyPrimePowDivs : Polynomial k → Finset (Polynomial k)),
        (∀ {F_p : Polynomial k}, F_p.Monic → ∀ (Q : Polynomial k),
          Q ∈ polyPrimePowDivs F_p ↔ isPolyPrimePow Q ∧ Q ∣ F_p) ∧
        (∀ {n : ℕ} {F_p : Polynomial k}, F_p ∈ M n →
          (∑ d ∈ Finset.Icc 1 n, ∑ Q ∈ (M d).filter (fun Q => Q ∣ F_p), Λ Q) =
            ∑ Q ∈ polyPrimePowDivs F_p, Λ Q) ∧
        (∀ {F_p : Polynomial k}, F_p.natDegree = 0 → polyPrimePowDivs F_p = ∅) := by
    let ppDivs : Polynomial k → Finset (Polynomial k) := fun F_p =>
      ((Finset.Icc 1 F_p.natDegree).biUnion (fun d => (M d).filter (fun Q => Q ∣ F_p))).filter
        isPolyPrimePow
    refine ⟨ppDivs, ?_, ?_, ?_⟩
    · intro F_p hF_mon Q
      dsimp [ppDivs]
      rw [Finset.mem_filter, Finset.mem_biUnion]
      constructor
      · rintro ⟨⟨d, _, hd⟩, hpp⟩
        rw [Finset.mem_filter] at hd
        exact ⟨hpp, hd.2⟩
      · rintro ⟨hpp, hdvd⟩
        refine ⟨?_, hpp⟩
        rcases hpp with ⟨R, hR_mon, hR_irr, m, hm, rfl⟩
        have hRm_mon : (R ^ m).Monic := hR_mon.pow m
        have hR_pos : 0 < R.natDegree := monic_irreducible_natDegree_pos hR_mon hR_irr
        have hRm_pos : 1 ≤ (R ^ m).natDegree := by
          rw [hR_mon.natDegree_pow m]
          exact Nat.mul_pos hm hR_pos
        have hRm_le : (R ^ m).natDegree ≤ F_p.natDegree :=
          Polynomial.natDegree_le_of_dvd hdvd hF_mon.ne_zero
        refine ⟨(R ^ m).natDegree, Finset.mem_Icc.mpr ⟨hRm_pos, hRm_le⟩, ?_⟩
        rw [Finset.mem_filter, hM_mem]
        exact ⟨⟨hRm_mon, rfl⟩, hdvd⟩
    · intro n F_p hF
      have hF_deg : F_p.natDegree = n := ((hM_mem n F_p).mp hF).2
      dsimp [ppDivs]
      rw [hF_deg]
      have hdisj : Set.PairwiseDisjoint (↑(Finset.Icc 1 n) : Set ℕ)
          (fun d => (M d).filter (fun Q => Q ∣ F_p)) := by
        intro d₁ _ d₂ _ hne
        rw [Function.onFun, Finset.disjoint_left]
        intro Q hQ₁ hQ₂
        rw [Finset.mem_filter, hM_mem] at hQ₁ hQ₂
        exact hne (hQ₁.1.2.symm.trans hQ₂.1.2)
      rw [← Finset.sum_biUnion hdisj]
      symm
      apply Finset.sum_filter_of_ne
      intro Q _ hne
      by_contra hnot
      dsimp [Λ] at hne
      rw [dif_neg hnot] at hne
      exact hne rfl
    · intro F_p hF0
      dsimp [ppDivs]
      rw [hF0, Finset.Icc_eq_empty (by omega), Finset.biUnion_empty, Finset.filter_empty]
  have prime_pow_dvd_of_dvd_mul_left : ∀ {R P : Polynomial k},
      R.Monic → Irreducible R → ¬ R ∣ P → ∀ (m : ℕ) {G : Polynomial k},
      R ^ m ∣ P * G → R ^ m ∣ G := by
    intro R P hR_mon hR_irr hRP_ndvd m
    have hR_prime : Prime R := UniqueFactorizationMonoid.irreducible_iff_prime.mp hR_irr
    induction m with
    | zero =>
      intro G _
      rw [pow_zero]
      exact one_dvd G
    | succ m ih =>
      intro G hdvd
      rw [pow_succ'] at hdvd ⊢
      have hR_dvd_PG : R ∣ P * G := dvd_of_mul_right_dvd hdvd
      rcases hR_prime.dvd_or_dvd hR_dvd_PG with hRP | ⟨G', rfl⟩
      · exact False.elim (hRP_ndvd hRP)
      · have hPRG : P * (R * G') = R * (P * G') := mul_left_comm P R G'
        rw [hPRG] at hdvd
        have hdvd' : R ^ m ∣ P * G' := (mul_dvd_mul_iff_left hR_mon.ne_zero).mp hdvd
        exact mul_dvd_mul_left R (ih hdvd')
  have sum_polyPrimePowDivs_mul_irreducible : ∀ {P G : Polynomial k},
      P.Monic → Irreducible P → G.Monic →
      (∑ Q ∈ polyPrimePowDivs (P * G), Λ Q) =
        P.natDegree + ∑ Q ∈ polyPrimePowDivs G, Λ Q := by
    intro P G hP_mon hP_irr hG_mon
    have hPG_mon : (P * G).Monic := hP_mon.mul hG_mon
    rw [← Finset.sum_filter_add_sum_filter_not (polyPrimePowDivs (P * G)) (fun Q => P ∣ Q),
      ← Finset.sum_filter_add_sum_filter_not (polyPrimePowDivs G) (fun Q => P ∣ Q)]
    have h_not_dvd : (polyPrimePowDivs (P * G)).filter (fun Q => ¬ P ∣ Q) =
        (polyPrimePowDivs G).filter (fun Q => ¬ P ∣ Q) := by
      ext Q
      rw [Finset.mem_filter, Finset.mem_filter,
        mem_polyPrimePowDivs hPG_mon, mem_polyPrimePowDivs hG_mon]
      refine ⟨?_, fun ⟨⟨hpp, hdvd⟩, hndvd⟩ => ⟨⟨hpp, dvd_mul_of_dvd_right hdvd P⟩, hndvd⟩⟩
      rintro ⟨⟨hpp, hdvd⟩, hndvd⟩
      refine ⟨⟨hpp, ?_⟩, hndvd⟩
      rcases hpp with ⟨R, hR_mon, hR_irr, m, hm, rfl⟩
      have hRP_ndvd : ¬ R ∣ P := by
        intro hRP
        have hassoc := (Irreducible.dvd_irreducible_iff_associated hR_irr hP_irr).mp hRP
        have hRP_eq := Polynomial.eq_of_monic_of_associated hR_mon hP_mon hassoc
        exact hndvd (hRP_eq ▸ dvd_pow_self R (by omega))
      exact prime_pow_dvd_of_dvd_mul_left hR_mon hR_irr hRP_ndvd m hdvd
    have h_base_P : ∀ Q : Polynomial k, isPolyPrimePow Q → P ∣ Q →
        ∃ m : ℕ, 1 ≤ m ∧ Q = P ^ m := by
      intro Q hpp hPQ
      rcases hpp with ⟨R, hR_mon, hR_irr, m, hm, rfl⟩
      have hP_prime : Prime P := UniqueFactorizationMonoid.irreducible_iff_prime.mp hP_irr
      have hPR : P ∣ R := hP_prime.dvd_of_dvd_pow hPQ
      have hassoc := (Irreducible.dvd_irreducible_iff_associated hP_irr hR_irr).mp hPR
      have hPR_eq := Polynomial.eq_of_monic_of_associated hP_mon hR_mon hassoc
      exact ⟨m, hm, by rw [hPR_eq]⟩
    let S₁ := (polyPrimePowDivs (P * G)).filter (fun Q => P ∣ Q)
    let S₀ := (polyPrimePowDivs G).filter (fun Q => P ∣ Q)
    have hS₁_eq : S₁ = insert P (S₀.image (fun Q' => P * Q')) := by
      ext Q
      simp only [S₁, S₀, Finset.mem_filter, Finset.mem_insert, Finset.mem_image,
        mem_polyPrimePowDivs hPG_mon, mem_polyPrimePowDivs hG_mon]
      constructor
      · rintro ⟨⟨hpp, hdvd⟩, hPQ⟩
        obtain ⟨m, hm, rfl⟩ := h_base_P Q hpp hPQ
        rcases eq_or_lt_of_le hm with rfl | hm2
        · left; exact pow_one P
        · right
          obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
          have hm'1 : 1 ≤ m' := by omega
          refine ⟨P ^ m', ⟨⟨⟨P, hP_mon, hP_irr, m', hm'1, rfl⟩, ?_⟩, dvd_pow_self P (by omega)⟩, ?_⟩
          · rw [pow_succ'] at hdvd
            exact (mul_dvd_mul_iff_left hP_mon.ne_zero).mp hdvd
          · rw [pow_succ']
      · rintro (hQP | ⟨Q', ⟨⟨hpp, hdvd⟩, hPQ'⟩, rfl⟩)
        · rw [hQP]
          exact ⟨⟨⟨P, hP_mon, hP_irr, 1, le_rfl, (pow_one P).symm⟩, dvd_mul_right P G⟩, dvd_rfl⟩
        · obtain ⟨m, hm1, rfl⟩ := h_base_P Q' hpp hPQ'
          refine ⟨⟨⟨P, hP_mon, hP_irr, m + 1, by omega, by rw [pow_succ']⟩,
            mul_dvd_mul_left P hdvd⟩, dvd_mul_right P (P ^ m)⟩
    have hP_not_mem : P ∉ S₀.image (fun Q' => P * Q') := by
      rw [Finset.mem_image]
      rintro ⟨Q', hQ'_mem, hPQ'_eq⟩
      simp only [S₀, Finset.mem_filter, mem_polyPrimePowDivs hG_mon] at hQ'_mem
      obtain ⟨m, hm1, rfl⟩ := h_base_P Q' hQ'_mem.1.1 hQ'_mem.2
      have hdeg := congr_arg Polynomial.natDegree hPQ'_eq
      rw [← pow_succ', hP_mon.natDegree_pow] at hdeg
      have hP_pos : 0 < P.natDegree := monic_irreducible_natDegree_pos hP_mon hP_irr
      have h_gt : P.natDegree < (m + 1) * P.natDegree :=
        lt_mul_of_one_lt_left hP_pos (by omega)
      omega
    have h_dvd_sum : (∑ Q ∈ S₁, Λ Q) =
        P.natDegree + ∑ Q' ∈ S₀, Λ Q' := by
      rw [hS₁_eq, Finset.sum_insert hP_not_mem,
        Finset.sum_image (fun Q₁ _ Q₂ _ h => mul_right_injective₀ hP_mon.ne_zero h)]
      have hΛP : Λ P = P.natDegree := by
        have h1 := hΛ_prime_pow P 1 hP_mon hP_irr le_rfl
        rw [pow_one] at h1
        exact h1
      rw [hΛP]
      congr 1
      apply Finset.sum_congr rfl
      intro Q' hQ'_mem
      simp only [S₀, Finset.mem_filter, mem_polyPrimePowDivs hG_mon] at hQ'_mem
      obtain ⟨m, hm1, rfl⟩ := h_base_P Q' hQ'_mem.1.1 hQ'_mem.2
      rw [← pow_succ', hΛ_prime_pow P (m + 1) hP_mon hP_irr (by omega),
        hΛ_prime_pow P m hP_mon hP_irr hm1]
    rw [h_not_dvd, h_dvd_sum, add_assoc]
  have hΛ_div_sum : ∀ (n : ℕ) (P_poly : Polynomial k), P_poly ∈ M n →
      (∑ d ∈ Finset.Icc 1 n, ∑ Q ∈ (M d).filter (fun Q => Q ∣ P_poly), Λ Q) = n := by
    intro n
    induction' n using Nat.strong_induction_on with n ih
    intro F_poly hF
    rw [sum_polyPrimePowDivs_eq hF]
    have hF_prop : F_poly.Monic ∧ F_poly.natDegree = n := (hM_mem n F_poly).mp hF
    rcases Nat.eq_zero_or_pos n with rfl | hn_pos
    · rw [polyPrimePowDivs_deg0 hF_prop.2, Finset.sum_empty]
    · obtain ⟨P₀, hP₀_irr, ⟨G₀, hF_eq⟩⟩ :=
        Polynomial.exists_irreducible_of_natDegree_pos (hF_prop.2 ▸ hn_pos)
      have hP₀_ne : P₀ ≠ 0 := hP₀_irr.ne_zero
      let c : k := P₀.leadingCoeff
      have hc_ne : c ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hP₀_ne
      let P : Polynomial k := Polynomial.C c⁻¹ * P₀
      let G : Polynomial k := Polynomial.C c * G₀
      have hPG_eq : F_poly = P * G := by
        calc F_poly = P₀ * G₀ := hF_eq
          _ = (Polynomial.C c⁻¹ * P₀) * (Polynomial.C c * G₀) := by
            rw [mul_mul_mul_comm, ← Polynomial.C.map_mul, inv_mul_cancel₀ hc_ne, map_one, one_mul]
      have hP_mon : P.Monic := by
        rw [Polynomial.Monic.def, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
          inv_mul_cancel₀ hc_ne]
      have hP_irr : Irreducible P := by
        have hassoc : Associated P₀ P :=
          ⟨Units.map Polynomial.C.toMonoidHom (Units.mk0 c⁻¹ (inv_ne_zero hc_ne)), by
            change P₀ * Polynomial.C c⁻¹ = Polynomial.C c⁻¹ * P₀
            rw [mul_comm]⟩
        exact hassoc.irreducible hP₀_irr
      have hG_mon : G.Monic := by
        have hF_mon : (P * G).Monic := hPG_eq ▸ hF_prop.1
        rw [Polynomial.Monic.def]
        calc G.leadingCoeff = 1 * G.leadingCoeff := (one_mul _).symm
          _ = P.leadingCoeff * G.leadingCoeff := by rw [hP_mon.leadingCoeff]
          _ = (P * G).leadingCoeff := (Polynomial.leadingCoeff_mul P G).symm
          _ = 1 := hF_mon.leadingCoeff
      have hP_pos : 0 < P.natDegree := monic_irreducible_natDegree_pos hP_mon hP_irr
      have hdeg_add : P.natDegree + G.natDegree = n := by
        rw [← hP_mon.natDegree_mul hG_mon, ← hPG_eq, hF_prop.2]
      have hG_lt : G.natDegree < n := by omega
      have hG_mem : G ∈ M G.natDegree := (hM_mem G.natDegree G).mpr ⟨hG_mon, rfl⟩
      have ihG := ih G.natDegree hG_lt G hG_mem
      rw [sum_polyPrimePowDivs_eq hG_mem] at ihG
      rw [hPG_eq, sum_polyPrimePowDivs_mul_irreducible hP_mon hP_irr hG_mon, ihG, hdeg_add]
  have newton_conv_general : ∀ {R' : Type} [CommRing R'] (μ : Polynomial k → R'),
      (∀ f g : Polynomial k, f.Monic → g.Monic → μ (f * g) = μ f * μ g) →
      ∀ (n : ℕ),
        (∑ d ∈ Finset.Icc 1 n,
          (∑ Q ∈ M d, (Λ Q : R') * μ Q) * (∑ B ∈ M (n - d), μ B)) =
          (n : R') * (∑ P ∈ M n, μ P) := by
    intro R' _ μ hμ_mul n
    have h_bij : ∀ d ≤ n, ∀ Q ∈ M d,
        (M n).filter (fun P => Q ∣ P) = (M (n - d)).image (fun B => Q * B) := by
      intro d hd Q hQ_mem
      have hQ : Q.Monic ∧ Q.natDegree = d := (hM_mem d Q).mp hQ_mem
      ext P
      rw [Finset.mem_filter, Finset.mem_image]
      constructor
      · rintro ⟨hP_mem, ⟨B, rfl⟩⟩
        have hP : (Q * B).Monic ∧ (Q * B).natDegree = n := (hM_mem n (Q * B)).mp hP_mem
        have hB_mon : B.Monic := by
          rw [Polynomial.Monic.def]
          calc B.leadingCoeff = 1 * B.leadingCoeff := (one_mul _).symm
            _ = Q.leadingCoeff * B.leadingCoeff := by rw [hQ.1.leadingCoeff]
            _ = (Q * B).leadingCoeff := (Polynomial.leadingCoeff_mul Q B).symm
            _ = 1 := hP.1.leadingCoeff
        have hB_deg : B.natDegree = n - d := by
          have hdeg := hQ.1.natDegree_mul hB_mon
          omega
        exact ⟨B, (hM_mem (n - d) B).mpr ⟨hB_mon, hB_deg⟩, rfl⟩
      · rintro ⟨B, hB_mem, rfl⟩
        have hB : B.Monic ∧ B.natDegree = n - d := (hM_mem (n - d) B).mp hB_mem
        refine ⟨(hM_mem n (Q * B)).mpr ⟨hQ.1.mul hB.1, ?_⟩, dvd_mul_right Q B⟩
        rw [hQ.1.natDegree_mul hB.1, hQ.2, hB.2]
        omega
    have h_term : ∀ d ∈ Finset.Icc 1 n,
        (∑ Q ∈ M d, (Λ Q : R') * μ Q) * (∑ B ∈ M (n - d), μ B) =
          ∑ P ∈ M n, (∑ Q ∈ (M d).filter (fun Q => Q ∣ P), (Λ Q : R')) * μ P := by
      intro d hd_mem
      have hd : d ≤ n := (Finset.mem_Icc.mp hd_mem).2
      rw [Finset.sum_mul]
      have h1 : ∀ Q ∈ M d,
          ((Λ Q : R') * μ Q) * (∑ B ∈ M (n - d), μ B) =
            ∑ P ∈ M n, if Q ∣ P then (Λ Q : R') * μ P else 0 := by
        intro Q hQ_mem
        have hQ : Q.Monic ∧ Q.natDegree = d := (hM_mem d Q).mp hQ_mem
        rw [Finset.mul_sum]
        have h2 : (∑ B ∈ M (n - d), ((Λ Q : R') * μ Q) * μ B) =
            ∑ B ∈ M (n - d), (Λ Q : R') * μ (Q * B) := by
          apply Finset.sum_congr rfl
          intro B hB_mem
          have hB : B.Monic ∧ B.natDegree = n - d := (hM_mem (n - d) B).mp hB_mem
          rw [mul_assoc, ← hμ_mul Q B hQ.1 hB.1]
        rw [h2, ← Finset.sum_image (f := fun P => (Λ Q : R') * μ P)
          (fun B₁ _ B₂ _ h => mul_right_injective₀ hQ.1.ne_zero h),
          ← h_bij d hd Q hQ_mem, Finset.sum_filter]
      rw [Finset.sum_congr rfl h1, Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro P _
      rw [← Finset.sum_filter, Finset.sum_mul]
    rw [Finset.sum_congr rfl h_term, Finset.sum_comm]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro P hP_mem
    have hsum : (∑ d ∈ Finset.Icc 1 n, ∑ Q ∈ (M d).filter (fun Q => Q ∣ P), (Λ Q : R')) = (n : R') := by
      have hnat := congr_arg (Nat.cast (R := R')) (hΛ_div_sum n P hP_mem)
      push_cast at hnat
      exact hnat
    rw [← Finset.sum_mul, hsum]
  have hNewton : ∀ (μ : Polynomial k → Ω F),
      (∀ f g : Polynomial k, f.Monic → g.Monic → μ (f * g) = μ f * μ g) →
      ∀ (n : ℕ),
        (∑ d ∈ Finset.Icc 1 n,
          (∑ Q ∈ M d, (Λ Q : Ω F) * μ Q) * (∑ B ∈ M (n - d), μ B)) =
          (n : Ω F) * (∑ P ∈ M n, μ P) :=
    fun μ hμ_mul n => newton_conv_general μ hμ_mul n
  let q_k : ℕ := Fintype.card k
  let μ₁ : Polynomial k → ℤ := fun _ => 1
  let S₁ : ℕ → ℤ := fun d => ∑ Q ∈ M d, (Λ Q : ℤ) * μ₁ Q
  let A₁ : ℕ → ℤ := fun m => ∑ B ∈ M m, μ₁ B
  have hA₁ : ∀ m, A₁ m = (q_k : ℤ) ^ m := by
    intro m
    simp only [A₁, μ₁, q_k, Finset.sum_const, Int.nsmul_eq_mul, mul_one, hM_card m, Nat.cast_pow]
  have hS₁_ind : ∀ n, 1 ≤ n → S₁ n = (q_k : ℤ) ^ n := by
    intro n
    induction' n using Nat.strong_induction_on with n ih
    intro hn
    have hconv : (∑ d ∈ Finset.Icc 1 n, S₁ d * A₁ (n - d)) = (n : ℤ) * A₁ n :=
      newton_conv_general μ₁ (fun _ _ _ _ => (mul_one 1).symm) n
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ m + 1), tsub_self, hA₁ 0, pow_zero, mul_one,
      hA₁ (m + 1)] at hconv
    have hsum_prev : (∑ d ∈ Finset.Icc 1 m, S₁ d * A₁ (m + 1 - d)) =
        (m : ℤ) * (q_k : ℤ) ^ (m + 1) := by
      have hcongr : ∀ d ∈ Finset.Icc 1 m, S₁ d * A₁ (m + 1 - d) = (q_k : ℤ) ^ (m + 1) := by
        intro d hd_mem
        rw [Finset.mem_Icc] at hd_mem
        rw [ih d (by omega) hd_mem.1, hA₁ (m + 1 - d), ← pow_add]
        congr 1
        omega
      rw [Finset.sum_congr rfl hcongr, Finset.sum_const, Nat.card_Icc,
        Nat.add_sub_cancel, Int.nsmul_eq_mul]
    rw [hsum_prev] at hconv
    have h_rhs : ((m + 1 : ℕ) : ℤ) * (q_k : ℤ) ^ (m + 1) =
        (m : ℤ) * (q_k : ℤ) ^ (m + 1) + (q_k : ℤ) ^ (m + 1) := by
      push_cast
      ring
    rw [h_rhs] at hconv
    exact add_left_cancel hconv
  have hΛ_sum_all : ∀ (d : ℕ), 1 ≤ d → (∑ G ∈ M d, Λ G) = (Fintype.card k) ^ d := by
    intro d hd
    have hS₁_d := hS₁_ind d hd
    simp only [S₁, μ₁, q_k, mul_one] at hS₁_d
    exact_mod_cast hS₁_d
  have hΛ_sum_nz : ∀ (d : ℕ), 1 ≤ d →
      (∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0), Λ G) =
        (Fintype.card k) ^ d - 1 := by
    intro d hd
    have hall := hΛ_sum_all d hd
    rw [← Finset.sum_filter_add_sum_filter_not (M d) (fun G => G.coeff 0 ≠ 0)] at hall
    have h_zero_sum : (∑ G ∈ (M d).filter (fun G => ¬ G.coeff 0 ≠ 0), Λ G) = 1 := by
      rw [Finset.sum_eq_single (Polynomial.X ^ d)]
      · have hX_mon : (Polynomial.X : Polynomial k).Monic := Polynomial.monic_X
        have hX_irr : Irreducible (Polynomial.X : Polynomial k) := Polynomial.irreducible_X
        rw [hΛ_prime_pow Polynomial.X d hX_mon hX_irr hd, Polynomial.natDegree_X]
      · intro G hG_mem hne
        rw [Finset.mem_filter, hM_mem, not_not] at hG_mem
        rcases hG_mem with ⟨⟨hG_mon, hG_deg⟩, hG_c0⟩
        by_contra hΛG_ne
        obtain ⟨P, m, hP_mon, hP_irr, hm, rfl⟩ := hΛ_ne_zero G hΛG_ne
        have hX_dvd_Pm : (Polynomial.X : Polynomial k) ∣ P ^ m :=
          Polynomial.X_dvd_iff.mpr hG_c0
        have hX_prime : Prime (Polynomial.X : Polynomial k) :=
          UniqueFactorizationMonoid.irreducible_iff_prime.mp Polynomial.irreducible_X
        have hX_dvd_P : (Polynomial.X : Polynomial k) ∣ P :=
          hX_prime.dvd_of_dvd_pow hX_dvd_Pm
        have hassoc : Associated (Polynomial.X : Polynomial k) P :=
          (Irreducible.dvd_irreducible_iff_associated Polynomial.irreducible_X hP_irr).mp hX_dvd_P
        have hXP : (Polynomial.X : Polynomial k) = P :=
          Polynomial.eq_of_monic_of_associated Polynomial.monic_X hP_mon hassoc
        subst hXP
        rw [Polynomial.Monic.natDegree_pow Polynomial.monic_X m,
          Polynomial.natDegree_X, mul_one] at hG_deg
        exact hne (congr_arg (fun e => (Polynomial.X : Polynomial k) ^ e) hG_deg)
      · intro hnot_mem
        exfalso
        apply hnot_mem
        rw [Finset.mem_filter, hM_mem, not_not]
        refine ⟨⟨Polynomial.monic_X_pow d, Polynomial.natDegree_X_pow d⟩, ?_⟩
        rw [Polynomial.coeff_X_pow, if_neg (by omega)]
    rw [h_zero_sum] at hall
    omega
  let μ_β : (kˣ →* (Ω F)ˣ) → Polynomial k → Ω F := fun β G =>
    if h : (-1 : k) ^ G.natDegree * G.coeff 0 ≠ 0 then
      (β (Units.mk0 ((-1 : k) ^ G.natDegree * G.coeff 0) h) : Ω F)
    else 0
  have hμ_β_one : ∀ β : kˣ →* (Ω F)ˣ, μ_β β 1 = 1 := by
    intro β
    dsimp [μ_β]
    rw [Polynomial.natDegree_one, Polynomial.coeff_one_zero, pow_zero, mul_one,
      dif_pos one_ne_zero]
    have h_u1 : Units.mk0 (1 : k) one_ne_zero = 1 := by ext; rfl
    rw [h_u1, map_one, Units.val_one]
  have hμ_β_mul : ∀ (β : kˣ →* (Ω F)ˣ) (f g : Polynomial k),
      f.Monic → g.Monic → μ_β β (f * g) = μ_β β f * μ_β β g := by
    intro β f g hf hg
    dsimp [μ_β]
    have hdeg : (f * g).natDegree = f.natDegree + g.natDegree := hf.natDegree_mul hg
    have hc0 : (f * g).coeff 0 = f.coeff 0 * g.coeff 0 := Polynomial.mul_coeff_zero f g
    have hprod_c : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 =
        ((-1 : k) ^ f.natDegree * f.coeff 0) * ((-1 : k) ^ g.natDegree * g.coeff 0) := by
      rw [hdeg, hc0, pow_add]
      ring
    set cf := (-1 : k) ^ f.natDegree * f.coeff 0
    set cg := (-1 : k) ^ g.natDegree * g.coeff 0
    by_cases hcf : cf = 0
    · have hcfg : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 = 0 := by
        rw [hprod_c, hcf, zero_mul]
      rw [dif_neg (not_not.mpr hcfg), dif_neg (not_not.mpr hcf), zero_mul]
    · by_cases hcg : cg = 0
      · have hcfg : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 = 0 := by
          rw [hprod_c, hcg, mul_zero]
        rw [dif_neg (not_not.mpr hcfg), dif_neg (not_not.mpr hcg), mul_zero]
      · have hcfg : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 ≠ 0 := by
          rw [hprod_c]
          exact mul_ne_zero hcf hcg
        rw [dif_pos hcfg, dif_pos hcf, dif_pos hcg]
        have hu : Units.mk0 ((-1 : k) ^ (f * g).natDegree * (f * g).coeff 0) hcfg =
            Units.mk0 cf hcf * Units.mk0 cg hcg := by
          ext
          exact hprod_c
        rw [hu, map_mul, Units.val_mul]
  have hμ_β_polyPhi : ∀ (β : kˣ →* (Ω F)ˣ) {m : ℕ} (hm : 1 ≤ m) (c : Fin m → k),
      μ_β β (polyPhi m c) =
        if h : (-1 : k) ^ m * c ⟨0, hm⟩ ≠ 0 then
          (β (Units.mk0 ((-1 : k) ^ m * c ⟨0, hm⟩) h) : Ω F)
        else 0 := by
    intro β m hm c
    dsimp [μ_β]
    rw [(polyPhi_monic_and_natDegree c).2, coeff_polyPhi_lt c hm]
  have hμ_β_scale : ∀ (β : kˣ →* (Ω F)ˣ) (u₀ : kˣ) (d : ℕ) (x : k),
      (if h : (-1 : k) ^ d * ((u₀ : k) * x) ≠ 0 then
        (β (Units.mk0 ((-1 : k) ^ d * ((u₀ : k) * x)) h) : Ω F)
      else 0) =
      (β u₀ : Ω F) *
        (if h : (-1 : k) ^ d * x ≠ 0 then
          (β (Units.mk0 ((-1 : k) ^ d * x) h) : Ω F)
        else 0) := by
    intro β u₀ d x
    have hmul : (-1 : k) ^ d * ((u₀ : k) * x) = (u₀ : k) * ((-1 : k) ^ d * x) := by ring
    by_cases hx : (-1 : k) ^ d * x = 0
    · have hux : (-1 : k) ^ d * ((u₀ : k) * x) = 0 := by rw [hmul, hx, mul_zero]
      rw [dif_neg (not_not.mpr hux), dif_neg (not_not.mpr hx), mul_zero]
    · have hux : (-1 : k) ^ d * ((u₀ : k) * x) ≠ 0 := by
        rw [hmul]
        exact mul_ne_zero (Units.ne_zero u₀) hx
      rw [dif_pos hux, dif_pos hx]
      have hu : Units.mk0 ((-1 : k) ^ d * ((u₀ : k) * x)) hux =
          u₀ * Units.mk0 ((-1 : k) ^ d * x) hx := by
        ext
        exact hmul
      rw [hu, map_mul, Units.val_mul]
  have hΛ_char_orth : ∀ (β : kˣ →* (Ω F)ˣ), β ≠ 1 → ∀ (d : ℕ), 1 ≤ d →
      (∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0),
        (Λ G : Ω F) *
          (if h : (-1 : k) ^ d * G.coeff 0 ≠ 0 then
            (β (Units.mk0 ((-1 : k) ^ d * G.coeff 0) h) : Ω F)
          else 0)) = 0 := by
    intro β hβ d hd
    obtain ⟨u₀, hu₀⟩ : ∃ u₀ : kˣ, β u₀ ≠ 1 := DFunLike.ne_iff.mp hβ
    have hu₀_val : (β u₀ : Ω F) ≠ 1 := by
      intro h
      exact hu₀ (Units.ext h)
    have hA_β_van : ∀ m : ℕ, 1 ≤ m → (∑ B ∈ M m, μ_β β B) = 0 := by
      intro m hm
      rw [hM_deg_sum m (μ_β β)]
      set i₀ : Fin m := ⟨0, hm⟩
      let e : (Fin m → k) ≃ (Fin m → k) :=
        { toFun := fun c => Function.update c i₀ ((u₀ : k) * c i₀)
          invFun := fun c => Function.update c i₀ (((u₀⁻¹ : kˣ) : k) * c i₀)
          left_inv := fun c => by
            simp only [Function.update_self, Units.inv_mul_cancel_left,
              Function.update_idem, Function.update_eq_self]
          right_inv := fun c => by
            simp only [Function.update_self, Units.mul_inv_cancel_left,
              Function.update_idem, Function.update_eq_self] }
      have hscale : ∀ c : Fin m → k,
          μ_β β (polyPhi m (e c)) = (β u₀ : Ω F) * μ_β β (polyPhi m c) := by
        intro c
        rw [hμ_β_polyPhi β hm (e c), hμ_β_polyPhi β hm c]
        have he0 : e c i₀ = (u₀ : k) * c i₀ := Function.update_self i₀ ((u₀ : k) * c i₀) c
        change (if h : (-1 : k) ^ m * (e c i₀) ≠ 0 then
            (β (Units.mk0 ((-1 : k) ^ m * (e c i₀)) h) : Ω F)
          else 0) = _
        rw [he0, hμ_β_scale β u₀ m (c i₀)]
      set S_m : Ω F := ∑ c : Fin m → k, μ_β β (polyPhi m c)
      have hS_eq : (β u₀ : Ω F) * S_m = S_m := by
        calc (β u₀ : Ω F) * S_m = ∑ c : Fin m → k, (β u₀ : Ω F) * μ_β β (polyPhi m c) := by
              dsimp [S_m]
              rw [Finset.mul_sum]
          _ = ∑ c : Fin m → k, μ_β β (polyPhi m (e c)) := by
              refine Finset.sum_congr rfl fun c _ => ?_
              exact (hscale c).symm
          _ = S_m := Fintype.sum_equiv e
              (fun c => μ_β β (polyPhi m (e c))) (fun c => μ_β β (polyPhi m c)) (fun _ => rfl)
      have hsub0 : ((β u₀ : Ω F) - 1) * S_m = 0 := by
        calc ((β u₀ : Ω F) - 1) * S_m = (β u₀ : Ω F) * S_m - S_m := by ring
          _ = 0 := sub_eq_zero.mpr hS_eq
      exact (mul_eq_zero.mp hsub0).resolve_left (sub_ne_zero.mpr hu₀_val)
    have hconv := hNewton (μ_β β) (hμ_β_mul β) d
    rw [hA_β_van d hd, mul_zero] at hconv
    rw [Finset.sum_eq_single d] at hconv
    · rw [tsub_self, hM_zero, Finset.sum_singleton, hμ_β_one β, mul_one] at hconv
      rw [← Finset.sum_filter_add_sum_filter_not (M d) (fun G => G.coeff 0 ≠ 0)] at hconv
      have h_zero_c0 : (∑ G ∈ (M d).filter (fun G => ¬ G.coeff 0 ≠ 0),
          (Λ G : Ω F) * μ_β β G) = 0 := by
        apply Finset.sum_eq_zero
        intro G hG
        rw [Finset.mem_filter, not_not] at hG
        dsimp [μ_β]
        have h0 : (-1 : k) ^ G.natDegree * G.coeff 0 = 0 := by rw [hG.2, mul_zero]
        rw [dif_neg (not_not.mpr h0), mul_zero]
      rw [h_zero_c0, add_zero] at hconv
      refine Eq.trans ?_ hconv
      apply Finset.sum_congr rfl
      intro G hG
      have hG_deg : G.natDegree = d := ((hM_mem d G).mp (Finset.mem_filter.mp hG).1).2
      dsimp [μ_β]
      rw [hG_deg]
    · intro j hj_mem hjd
      rw [Finset.mem_Icc] at hj_mem
      rw [hA_β_van (d - j) (by omega), mul_zero]
    · intro hd_not_mem
      exact False.elim (hd_not_mem (Finset.mem_Icc.mpr ⟨hd, le_rfl⟩))
  have hΛ_dh : ∀ (α : kˣ →* (Ω F)ˣ) (ψ_k : AddChar k (Ω F)), ψ_k ≠ 1 →
      ∀ (d : ℕ), 1 ≤ d →
        (∑ G ∈ M d,
          (Λ G : Ω F) *
            ((if h : (-1 : k) ^ G.natDegree * G.coeff 0 ≠ 0 then
                (α (Units.mk0 ((-1 : k) ^ G.natDegree * G.coeff 0) h) : Ω F)
              else 0) *
              ψ_k (-G.nextCoeff))) =
          (-1 : Ω F) ^ (d - 1) *
            (∑ x : kˣ, (α x : Ω F) * ψ_k (x : k)) ^ d := by
    intro α ψ_k hψ_k d hd
    let lam_α : Polynomial k → Ω F := fun G => μ_β α G * ψ_k (-G.nextCoeff)
    have hlam_one : lam_α 1 = 1 := by
      dsimp [lam_α]
      have hnext1 : (1 : Polynomial k).nextCoeff = 0 := by
        rw [← Polynomial.C_1, Polynomial.nextCoeff_C_eq_zero]
      rw [hμ_β_one α, hnext1, neg_zero, AddChar.map_zero_eq_one, mul_one]
    have hlam_mul : ∀ f g : Polynomial k,
        f.Monic → g.Monic → lam_α (f * g) = lam_α f * lam_α g := by
      intro f g hf hg
      dsimp [lam_α]
      rw [hμ_β_mul α f g hf hg, hf.nextCoeff_mul hg, neg_add, AddChar.map_add_eq_mul]
      ring
    set a₁ : Ω F := ∑ x : kˣ, (α x : Ω F) * ψ_k (x : k)
    let S_lam : ℕ → Ω F := fun n => ∑ G ∈ M n, (Λ G : Ω F) * lam_α G
    let A_lam : ℕ → Ω F := fun m => ∑ B ∈ M m, lam_α B
    have hA0 : A_lam 0 = 1 := by
      dsimp [A_lam]
      rw [hM_zero, Finset.sum_singleton, hlam_one]
    have hA1 : A_lam 1 = a₁ := by
      dsimp [A_lam, a₁]
      rw [hM_one lam_α]
      rw [← Finset.sum_erase_add Finset.univ (fun y : k => lam_α (Polynomial.X - Polynomial.C y))
        (Finset.mem_univ (0 : k))]
      have h0 : lam_α (Polynomial.X - Polynomial.C (0 : k)) = 0 := by
        dsimp [lam_α, μ_β]
        have hc0 : (Polynomial.X - Polynomial.C (0 : k)).coeff 0 = 0 := by
          rw [map_zero, sub_zero, Polynomial.coeff_X_zero]
        have hmul0 : (-1 : k) ^ (Polynomial.X - Polynomial.C (0 : k)).natDegree *
            (Polynomial.X - Polynomial.C (0 : k)).coeff 0 = 0 := by
          rw [hc0, mul_zero]
        rw [dif_neg (not_not.mpr hmul0), zero_mul]
      rw [h0, add_zero]
      symm
      refine Finset.sum_bij (fun (x : kˣ) _ => (x : k)) ?_ ?_ ?_ ?_
      · intro x _
        exact Finset.mem_erase.mpr ⟨Units.ne_zero x, Finset.mem_univ _⟩
      · intro x₁ _ x₂ _ h
        exact Units.ext h
      · intro y hy
        have hy0 : y ≠ 0 := (Finset.mem_erase.mp hy).1
        exact ⟨Units.mk0 y hy0, Finset.mem_univ _, Units.val_mk0 hy0⟩
      · intro x _
        dsimp [lam_α, μ_β]
        have hdeg1 : (Polynomial.X - Polynomial.C (x : k)).natDegree = 1 :=
          Polynomial.natDegree_X_sub_C (x : k)
        have hc0 : (Polynomial.X - Polynomial.C (x : k)).coeff 0 = -(x : k) := by
          rw [Polynomial.coeff_sub, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero, zero_sub]
        have hnext : (Polynomial.X - Polynomial.C (x : k)).nextCoeff = -(x : k) :=
          Polynomial.nextCoeff_X_sub_C (x : k)
        have hprod : (-1 : k) ^ (Polynomial.X - Polynomial.C (x : k)).natDegree *
            (Polynomial.X - Polynomial.C (x : k)).coeff 0 = (x : k) := by
          rw [hdeg1, hc0]
          ring
        have hx_ne : (-1 : k) ^ (Polynomial.X - Polynomial.C (x : k)).natDegree *
            (Polynomial.X - Polynomial.C (x : k)).coeff 0 ≠ 0 := by
          rw [hprod]
          exact Units.ne_zero x
        have hu_eq : Units.mk0 ((-1 : k) ^ (Polynomial.X - Polynomial.C (x : k)).natDegree *
            (Polynomial.X - Polynomial.C (x : k)).coeff 0) hx_ne = x := by
          ext
          exact hprod
        rw [dif_pos hx_ne, hu_eq, hnext, neg_neg]
    obtain ⟨a₀, ha₀⟩ : ∃ a₀ : k, ψ_k a₀ ≠ 1 := by
      obtain ⟨a₀, ha₀⟩ := DFunLike.ne_iff.mp hψ_k
      exact ⟨a₀, by rwa [AddChar.one_apply] at ha₀⟩
    have hAvan : ∀ m : ℕ, 2 ≤ m → A_lam m = 0 := by
      intro m hm2
      dsimp [A_lam]
      rw [hM_deg_sum m lam_α]
      have hm1 : 1 ≤ m := by omega
      set i₀ : Fin m := ⟨0, hm1⟩
      set i_top : Fin m := ⟨m - 1, by omega⟩
      have hi_ne : i₀ ≠ i_top := by
        intro h
        have hval := congrArg Fin.val h
        dsimp [i₀, i_top] at hval
        omega
      have hlam_polyPhi : ∀ c : Fin m → k,
          lam_α (polyPhi m c) =
            (if h : (-1 : k) ^ m * c i₀ ≠ 0 then
              (α (Units.mk0 ((-1 : k) ^ m * c i₀) h) : Ω F)
            else 0) * ψ_k (-c i_top) := by
        intro c
        dsimp [lam_α]
        rw [hμ_β_polyPhi α hm1 c]
        congr 1
        have hdeg : (polyPhi m c).natDegree = m := (polyPhi_monic_and_natDegree c).2
        have hdeg_pos : 0 < (polyPhi m c).natDegree := by omega
        have hnext : (polyPhi m c).nextCoeff = c i_top := by
          rw [Polynomial.nextCoeff_of_natDegree_pos hdeg_pos]
          simp only [hdeg]
          exact coeff_polyPhi_lt c (by omega)
        rw [hnext]
      let e : (Fin m → k) ≃ (Fin m → k) :=
        { toFun := fun c => Function.update c i_top (c i_top - a₀)
          invFun := fun c => Function.update c i_top (c i_top + a₀)
          left_inv := fun c => by
            simp only [Function.update_self, sub_add_cancel, Function.update_idem,
              Function.update_eq_self]
          right_inv := fun c => by
            simp only [Function.update_self, add_sub_cancel_right, Function.update_idem,
              Function.update_eq_self] }
      have hshift : ∀ c : Fin m → k,
          lam_α (polyPhi m (e c)) = ψ_k a₀ * lam_α (polyPhi m c) := by
        intro c
        rw [hlam_polyPhi (e c), hlam_polyPhi c]
        have he0 : e c i₀ = c i₀ := Function.update_of_ne hi_ne (c i_top - a₀) c
        have he_top : e c i_top = c i_top - a₀ := Function.update_self i_top (c i_top - a₀) c
        have hneg_sub : -(c i_top - a₀) = a₀ + -c i_top := by ring
        rw [he0, he_top, hneg_sub, AddChar.map_add_eq_mul]
        ring
      set S_m : Ω F := ∑ c : Fin m → k, lam_α (polyPhi m c)
      have hS_eq : ψ_k a₀ * S_m = S_m := by
        calc ψ_k a₀ * S_m = ∑ c : Fin m → k, ψ_k a₀ * lam_α (polyPhi m c) := by
              dsimp [S_m]
              rw [Finset.mul_sum]
          _ = ∑ c : Fin m → k, lam_α (polyPhi m (e c)) := by
              refine Finset.sum_congr rfl fun c _ => ?_
              exact (hshift c).symm
          _ = S_m := Fintype.sum_equiv e
              (fun c => lam_α (polyPhi m (e c))) (fun c => lam_α (polyPhi m c)) (fun _ => rfl)
      have hsub0 : (ψ_k a₀ - 1) * S_m = 0 := by
        calc (ψ_k a₀ - 1) * S_m = ψ_k a₀ * S_m - S_m := by ring
          _ = 0 := sub_eq_zero.mpr hS_eq
      exact (mul_eq_zero.mp hsub0).resolve_left (sub_ne_zero.mpr ha₀)
    have hS_lam_ind : ∀ n : ℕ, 1 ≤ n → S_lam n = (-1 : Ω F) ^ (n - 1) * a₁ ^ n := by
      intro n
      induction n with
      | zero => intro h; omega
      | succ m ih =>
        intro _
        have hconv : (∑ j ∈ Finset.Icc 1 (m + 1), S_lam j * A_lam (m + 1 - j)) =
            ((m + 1 : ℕ) : Ω F) * A_lam (m + 1) :=
          hNewton lam_α hlam_mul (m + 1)
        rcases Nat.eq_zero_or_pos m with rfl | hm_pos
        · simp only [zero_add, Finset.Icc_self, Finset.sum_singleton, tsub_self, hA0, mul_one,
            Nat.cast_one, hA1, one_mul] at hconv
          rw [Nat.sub_self, pow_zero, pow_one, one_mul, hconv]
        · rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ m + 1), tsub_self, hA0, mul_one,
            hAvan (m + 1) (by omega), mul_zero] at hconv
          have hsum_single : (∑ j ∈ Finset.Icc 1 m, S_lam j * A_lam (m + 1 - j)) =
              S_lam m * a₁ := by
            rw [Finset.sum_eq_single m]
            · have hsub : m + 1 - m = 1 := by omega
              rw [hsub, hA1]
            · intro j hj_mem hjm
              rw [Finset.mem_Icc] at hj_mem
              rw [hAvan (m + 1 - j) (by omega), mul_zero]
            · intro hm_not_mem
              exact False.elim (hm_not_mem (Finset.mem_Icc.mpr ⟨hm_pos, le_rfl⟩))
          rw [hsum_single] at hconv
          have hSm1 : S_lam (m + 1) = - (S_lam m * a₁) := eq_neg_of_add_eq_zero_right hconv
          rw [hSm1, ih hm_pos]
          have hm_eq : m = (m - 1) + 1 := by omega
          conv_rhs => rw [Nat.add_sub_cancel, hm_eq, pow_succ (-1 : Ω F) (m - 1), ← hm_eq,
            pow_succ a₁ m]
          ring
    exact hS_lam_ind d hd
  exact ⟨M, Λ, hM_mem, hM_zero, hM_one, hΛ_prime_pow, hΛ_ne_zero,
    hNewton, hΛ_sum_nz, hΛ_char_orth, hΛ_dh⟩

theorem ld_norm_poly_operator_and_deg_ell_split (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ) (hNeChar : (ℓ : k) ≠ 0)
    (ζ : k) (hζ_ne : ζ ≠ 0) (hζ_pow : ζ ^ ℓ = 1)
