  have hfix_sup_K₁ : E.fixingSubgroup ⊓ M₁.fixingSubgroup = K₁.fixingSubgroup := by
    rw [← IntermediateField.fixingSubgroup_sup, h_sup]
  have hπ_HE : ∀ w : relWeil F L, π w ∈ H_E ↔ μE w = 1 :=
    fun w => (h_mem_fixing E hLE hEK₁ w).symm.trans (hμE_ker w)
  have hπ_HM₁ : ∀ w : relWeil F L, π w ∈ H_M₁ ↔ μM₁ w = 1 :=
    fun w => (h_mem_fixing M₁ hLM₁ hM₁K₁ w).symm.trans (hμM₁_ker w)
  have hπ_eq_one : ∀ w : relWeil F L, π w = 1 ↔ (μE w = 1 ∧ μM₁ w = 1) := by
    intro w
    rw [← Subgroup.mem_bot, ← h_fixing_K₁, ← h_mem_fixing K₁ hLK₁ le_rfl w,
      ← hfix_sup_K₁, Subgroup.mem_inf, hμE_ker w, hμM₁_ker w]
  
  have h_prim_of_order : ∀ (ζ : (Ω F)ˣ), ζ ^ ℓ = 1 → ζ ≠ 1 →
