      rw [Polynomial.coeff_zero_prod]
      have h_c0 : ∀ m ∈ Finset.range ℓ, (σ m P).coeff 0 = ((ζ ^ m) ^ d)⁻¹ * P.coeff 0 := by
        intro m _
        rw [hσ_coeff, hP_deg, pow_zero, mul_one, inv_pow, pow_mul]
      rw [Finset.prod_congr rfl h_c0, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range,
