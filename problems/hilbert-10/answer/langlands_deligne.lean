      rw [show β₁ * (1 + 4 * f) * s₀ ^ 2 - β₂ * (1 - 4 * g) * (d * s₀) ^ 2 = Δ_even * s₀ ^ 2 by
        dsimp [Δ_even]; ring]
      exact hP_mono (2 * (r : ℤ)) (hP_mul hΔ_even hs₀_sq) (by omega)
    rw [hψ_eq_2r _ _ hrem]
    exact hE'_scaled_sq (d * s₀) hds₀
  have hM₁'_scaled_odd : ∀ s₁ : L, (s₁ = 0 ∨ 3 * (a : ℤ) - 1 ≤ 2 * valL F L s₁) →
      ψ (((α⁻¹ : Lˣ) : L) * (β₁ * (1 + 4 * f) * (s₁ + f * s₁ ^ 2))) = 1 := by
    intro s₁ hs₁
    have hs₁_a : s₁ = 0 ∨ (a : ℤ) ≤ valL F L s₁ := hP_half (a : ℤ) hs₁ (by omega)
    have hs₁_sq : s₁ ^ 2 = 0 ∨ (3 * (a : ℤ) - 1) ≤ valL F L (s₁ ^ 2) := hP_sq_iff.mp hs₁
    set B := s₁ + f * s₁ ^ 2
    have hB_val : B = 0 ∨ (a : ℤ) ≤ valL F L B :=
      hP_add (a : ℤ) hs₁_a (hP_mul hP_f hs₁_sq) (by omega) (by omega)
    set t₁ := f * g⁻¹ * s₁
    have ht₁ : t₁ = 0 ∨ 3 * (r : ℤ) - 1 ≤ 2 * valL F L t₁ := by
      rw [hP_sq_iff, show t₁ ^ 2 = f * (f * (g⁻¹ * (g⁻¹ * s₁ ^ 2))) by dsimp [t₁]; ring]
      exact hP_mono (3 * (r : ℤ) - 1)
        (hP_mul hP_f (hP_mul hP_f (hP_mul hP_ginv (hP_mul hP_ginv hs₁_sq)))) (by omega)
    set A := t₁ + g * t₁ ^ 2
    have hA_eq : A = g⁻¹ * (f * B) := by
      dsimp [A, B, t₁]
      calc f * g⁻¹ * s₁ + g * (f * g⁻¹ * s₁) ^ 2
        _ = g⁻¹ * f * s₁ + g⁻¹ * f ^ 2 * (g * g⁻¹) * s₁ ^ 2 := by ring
        _ = g⁻¹ * (f * (s₁ + f * s₁ ^ 2)) := by rw [mul_inv_cancel₀ hg_ne]; ring
    have hrem : β₁ * (1 + 4 * f) * B - β₂ * (1 - 4 * g) * A = 0 ∨
        2 * (r : ℤ) ≤ valL F L (β₁ * (1 + 4 * f) * B - β₂ * (1 - 4 * g) * A) := by
