    exact ⟨hfi_eq ▸ hf₀_pos, hfi_eq ▸ hfin_eq⟩
  have hf_pos : ∀ i : Fin D_orb.length, 1 ≤ f_i i := fun i => (hf_spec i).1
  have hu_sum : (∑ i : Fin D_orb.length, f_i i) = u := by
    have hsum_k : k * (∑ i : Fin D_orb.length, f_i i) = k * u := by
      rw [Finset.mul_sum]
      calc ∑ i : Fin D_orb.length, k * f_i i
          = ∑ i : Fin D_orb.length,
              Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            exact (hf_spec i).2.symm
        _ = q - 1 := hDegSum
        _ = k * u := hqu
    exact Nat.eq_of_mul_eq_mul_left hk_ge1 hsum_k
  have hFi_card : ∀ i : Fin D_orb.length,
      Fintype.card (k_Fi i) = (Fintype.card k_L) ^ (f_i i) ∧
      Module.finrank k_L (k_Fi i) = f_i i := by
    intro i
    obtain ⟨hcard_i, hfin_i, _⟩ := hFi_alg i
    rw [hcard_kL]
    exact ⟨hcard_i, hfin_i⟩
  obtain ⟨hΘ_val_res, k_M, hField_kM, hFin_kM, ι_res, ψ_M, a_bar, U₀_bar, β, φ_bar,
      hchar_kM, hψ_0, hψ_add, hψ_ne, _, hU₀_ne, hβ_inj, hβ_ne, hβ_P,
      hφ_alg, hθ_pow, h_half, h_fiber_norm, hβ_prod_s1⟩ :=
    ld_ch14_odd_p_mc_residue_and_orbit_embeddings F L K M_C hLM_C hM_CK ψ hψ hψMC
      D_orb hFinFi hFiMC μ'_orb ν_all σ_all idx_all hν_props hν_prod
      t k ht_ge1 hk_ge1 hk_dvd hValAlgMCL hnMC hFi_ram
      P_poly ϖ_K ϖ_MC ϖ_L hϖ_MC hϖ_L r_exp hr_exp_pos a_coeff hq_pow ha_int ha0_tr hTr_val0 hP_def
      c'_μ hc_μ_val k_L resL k_Fi resFi hresL_map hresFi_map hp_char hFi_alg
      u_all_0 hu_all_0_def hu_all_0_prod hu_all_0_val hu_all_0_P hu_all_0_inj
  letI : Field k_M := hField_kM
  letI : Fintype k_M := hFin_kM
  have hP_ξ_ne : P_ξ ≠ 0 := by
    dsimp only [P_ξ]
    rw [Finset.prod_ne_zero_iff]
    intro i _
    exact Algebra.norm_ne_zero_iff.mpr (hΘ_val_res i).2
  have hβ_cofactor : ∀ j₀ : Fin (q - 1),
      β j₀ * (∏ j ∈ Finset.univ.erase j₀, (β j₀ - β j)) = ∏ j : Fin (q - 1), β j :=
    ld_ch14_odd_p_linear_poly_root_cofactor_eq_prod F k_M (p F) r_exp q hp hp_ne2
      hr_exp_pos hq_pow hchar_kM ψ_M hψ_0 hψ_add hψ_ne a_bar β hβ_inj hβ_ne hβ_P
  let θ_orb : ∀ i : Fin D_orb.length, k_Fi i :=
    fun i => resFi i ((Θ_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)
  have hθ_ne : ∀ i : Fin D_orb.length, θ_orb i ≠ 0 := fun i => (hΘ_val_res i).2
  obtain ⟨h_not_both_even, h_norm_pow, hβ_prod_s3, w, hw_inj, hw_frob, hw_prod, hw_cof_raw⟩ :=
    ld_ch14_odd_p_finite_field_orbit_pigeonhole_and_norm_pow
      k_L k_M ι_res D_orb.length f_i hf_pos k_Fi hFi_card
      q t k u hq_ge3 hq_odd hk_ge1 hqu hu_sum idx_all φ_bar hφ_alg
      U₀_bar hU₀_ne β hβ_inj hβ_ne θ_orb hθ_ne hθ_pow h_half
  have h_res_norm : ∀ i : Fin D_orb.length, ∀ w_u : ((D_orb.get i).field)ˣ,
      valL F (D_orb.get i).field (w_u : (D_orb.get i).field) = 0 →
      resL ((Units.map (normLM F (D_orb.get i).le) w_u : Lˣ) : L) =
        (Algebra.norm k_L (resFi i (w_u : (D_orb.get i).field))) ^ k := by
    intro i w_u hw_val
    apply ι_res.injective
    rw [← h_fiber_norm i w_u hw_val, h_norm_pow i (resFi i (w_u : (D_orb.get i).field))]
  have hP_ξ_eq : P_ξ =
      (-1 : k_L) ^ u *
        resL (((c₀ ^ (q - 1) * (ϖ_L ^ (u * t)) *
          (∏ i : Fin D_orb.length,
            Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L)) := by
    have hU_pow_ne : U₀_bar ^ (u * t) ≠ 0 := pow_ne_zero (u * t) hU₀_ne
    have h_eq_kM :
        (U₀_bar ^ (u * t)) * (ι_res ((-1 : k_L) ^ u * P_ξ)) =
        (U₀_bar ^ (u * t)) *
          ι_res (resL (((c₀ ^ (q - 1) * (ϖ_L ^ (u * t)) *
            (∏ i : Fin D_orb.length,
              Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L))) := by
      calc (U₀_bar ^ (u * t)) * (ι_res ((-1 : k_L) ^ u * P_ξ))
          = (-1 : k_M) ^ u * (U₀_bar ^ (u * t)) * ι_res P_ξ := by
            rw [map_mul, map_pow, map_neg, map_one]
            ring
        _ = ∏ j : Fin (q - 1), β j := hβ_prod_s3.symm
        _ = (U₀_bar ^ (u * t)) *
              ι_res (resL (((c₀ ^ (q - 1) * (ϖ_L ^ (u * t)) *
                (∏ i : Fin D_orb.length,
                  Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L))) := hβ_prod_s1
    have h_eq_L :
        (-1 : k_L) ^ u * P_ξ =
          resL (((c₀ ^ (q - 1) * (ϖ_L ^ (u * t)) *
            (∏ i : Fin D_orb.length,
              Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L)) :=
      ι_res.injective (mul_left_cancel₀ hU_pow_ne h_eq_kM)
    calc P_ξ = ((-1 : k_L) ^ u) ^ 2 * P_ξ := by
          rw [← pow_mul, mul_comm u 2, pow_mul, neg_one_sq, one_pow, one_mul]
      _ = (-1 : k_L) ^ u * ((-1 : k_L) ^ u * P_ξ) := by ring
      _ = (-1 : k_L) ^ u *
            resL (((c₀ ^ (q - 1) * (ϖ_L ^ (u * t)) *
              (∏ i : Fin D_orb.length,
                Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L)) := by
          rw [h_eq_L]
  have hw_cofactor : ∀ (i₀ : Fin D_orb.length) (s₀ : Fin (f_i i₀)),
      (k : k_M) * (w i₀ s₀) *
        (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
        (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) =
        (-1 : k_M) ^ u * ι_res P_ξ := by
    intro i₀ s₀
    obtain ⟨j₀, hj₀⟩ := hw_cof_raw i₀ s₀
    rw [hβ_cofactor j₀, hβ_prod_s3] at hj₀
    have hU_pow_ne : U₀_bar ^ (u * t) ≠ 0 := pow_ne_zero (u * t) hU₀_ne
    apply mul_left_cancel₀ hU_pow_ne
    calc (U₀_bar ^ (u * t)) *
          ((k : k_M) * (w i₀ s₀) *
            (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
            (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)))
        = (k : k_M) * (U₀_bar ^ (u * t)) * (w i₀ s₀) *
            (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
            (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) := by ring
      _ = (-1 : k_M) ^ u * (U₀_bar ^ (u * t)) * ι_res P_ξ := hj₀.symm
      _ = (U₀_bar ^ (u * t)) * ((-1 : k_M) ^ u * ι_res P_ξ) := by ring
  have h_master_sign :=
    ld_ch14_odd_p_vandermonde_orbit_master_sign
      k_L k_M ι_res (p F) hp hp_ne2 hp_char D_orb.length u k hu_pos f_i hf_pos hu_sum
      P_ξ hP_ξ_ne w hw_inj hw_frob hw_prod hw_cofactor
  exact ⟨h_not_both_even, hΘ_val_res, h_res_norm, hP_ξ_ne, hP_ξ_eq, h_master_sign⟩

theorem ld_ch14_odd_p_orbit_val_and_supercrit_unit_res (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M]
    (hLM : L ≤ M)
    (ψ : AddChar L (Ω F))
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (μ θ : Mˣ →* (Ω F)ˣ)
    (t k f_M : ℕ) (hk_ge1 : 1 ≤ k) (hf_M_ge1 : 1 ≤ f_M)
    (hfinrank_LM : Module.finrank L (IntermediateField.extendScalars hLM) = k * f_M)
    (hq_M : qL F M = (qL F L) ^ f_M)
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (ϖ_M : Mˣ) (hϖ_M : valL F M (ϖ_M : M) = 1)
    (c'_χ' : Lˣ) (c'_μ c'_θ : Mˣ)
    (hc_μ_val : valL F M (c'_μ : M) =
      ((t + 1 : ℕ) : ℤ) + ((k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1)))
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (resL : L → k_L) (resM : M → k_M)
    (hresL_map : IsResidueFieldMap F L k_L resL)
    (hresM_map : IsResidueFieldMap F M k_M resM)
    (hcard_kL : Fintype.card k_L = qL F L)
    (hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resM (IntermediateField.inclusion hLM x) = algebraMap k_L k_M (resL x)) :
    let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
    let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
    let ι : Lˣ →* Mˣ := Units.map (IntermediateField.inclusion hLM).toMonoidHom
    let ε : Mˣ := (ϖ_M ^ k) * (ι ϖ_L)⁻¹
    let v₀ : Mˣ := ι c₀ * c'_μ⁻¹ * (ϖ_M ^ t)
    let Θ : Mˣ := (ι c₀ * c'_μ⁻¹) ^ k * (ι ϖ_L) ^ t
    let v_μ : Mˣ := ι c₀ * c'_μ⁻¹ * (ϖ_M ^ (2 * (condExp F M μ / 2)))
    let v_θ : Mˣ := ι c₀ * c'_θ⁻¹ * (ϖ_M ^ (2 * (condExp F M θ / 2)))
    (∀ z : M, valL F L (normLM F hLM z) = (f_M : ℤ) * valL F M z) ∧
    (∀ x : L, valL F M (IntermediateField.inclusion hLM x) = (k : ℤ) * valL F L x) ∧
    valL F M (ε : M) = 0 ∧
    resM (ε : M) ≠ 0 ∧
    valL F M (v₀ : M) = 0 ∧
    resM (v₀ : M) ≠ 0 ∧
    resM (Θ : M) * (resM (ε : M)) ^ t = (resM (v₀ : M)) ^ k ∧
    (condExp F M μ = t + 1 → (t + 1) % 2 = 1 → k = 1 →
      resM (v_μ : M) = resM (Θ : M) * ((resM (ε : M)) ^ (t / 2)) ^ 2) ∧
    (valL F L (u_χ' : L) = 0 →
      resL (u_χ' : L) ≠ 0 →
      condExp F M θ = k * (condExp F L χ' - 1) + 1 →
      (k * (condExp F L χ' - 1) + 1) % 2 = 1 →
      c'_θ * (ι c'_χ')⁻¹ ∈ unitGroup F M 1 →
      resM (v_θ : M) =
        (algebraMap k_L k_M (resL (u_χ' : L)))⁻¹ *
          (resM (ε : M)) ^ (condExp F L χ' - 1)) :=
by
  intro c₀ u_χ' ι ε v₀ Θ v_μ v_θ
  obtain ⟨haddVal1, _, haddVal_mul, _, _, _, _⟩ := ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨hvalL_0, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hvalM_0, hvalM_1, _, hvalM_neg, hvalM_mul, hvalM_inv, hvalM_surj, hvalM_add,
    _, hunit_ge1_M, hunit_val0_M⟩ :=
    ld_valL_and_unitGroup_props F M
  obtain ⟨hresL_0, hresL_1, hresL_ring, hresL_ker, _⟩ := hresL_map
  obtain ⟨hresM_0, hresM_1, hresM_ring, hresM_ker, _⟩ := hresM_map

  
  have hqL_gt1 : 1 < qL F L := by
    rw [← hcard_kL]
    exact Fintype.one_lt_card
  have hq_pos : 0 < q F := q_pos F
  have hq_ge2 : 2 ≤ q F := by
    by_contra hlt
    have hq_eq1 : q F = 1 := by omega
    have hqL_eq1 : qL F L = 1 := by
      unfold qL
      rw [hq_eq1, one_pow]
    omega
  have hresDeg_LM : resDeg F M = resDeg F L * f_M := by
    have hpow : (q F) ^ (resDeg F M) = (q F) ^ (resDeg F L * f_M) := by
      calc (q F) ^ (resDeg F M) = qL F M := rfl
        _ = (qL F L) ^ f_M := hq_M
        _ = ((q F) ^ (resDeg F L)) ^ f_M := rfl
        _ = (q F) ^ (resDeg F L * f_M) := (pow_mul (q F) (resDeg F L) f_M).symm
    exact Nat.pow_right_injective hq_ge2 hpow

  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hrelVal_div : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E],
      (∀ m : ℤ, ∃ c : Eˣ, valL F E (c : E) = m) →
      0 < resDeg F E ∧ ∀ z : E, relVal F E z = (resDeg F E : ℤ) * valL F E z := by
    intro E _ hsurj
    have hrel0 : relVal F E 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F E 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : E, x ≠ 0 → y ≠ 0 → relVal F E (x * y) = relVal F E x + relVal F E y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Eˣ, relVal F E ((u⁻¹ : Eˣ) : E) = - relVal F E (u : E) := by
      intro u
      have hmul := hrel_mul (u : E) ((u⁻¹ : Eˣ) : E) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Eˣ) (n : ℕ),
        relVal F E (((u ^ n : Eˣ) : E)) = (n : ℤ) * relVal F E (u : E) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Eˣ) (m : ℤ),
        relVal F E (((u ^ m : Eˣ) : E)) = m * relVal F E (u : E) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F E (((u ^ (n : ℤ) : Eˣ) : E)) = (n : ℤ) * relVal F E (u : E)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {d : ℕ | 0 < d ∧ ∃ x : E, x ≠ 0 ∧ relVal F E x = d}
    have hres_ne : resDeg F E ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F E = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfE_mem : resDeg F E ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfE_pos, ϖE₀, hϖE₀_ne, hrel_ϖE₀⟩ := hfE_mem
    let ϖE : Eˣ := Units.mk0 ϖE₀ hϖE₀_ne
    have hrel_ϖE : relVal F E (ϖE : E) = (resDeg F E : ℤ) := hrel_ϖE₀
    have hfE_int_pos : (0 : ℤ) < (resDeg F E : ℤ) := Nat.cast_pos.mpr hfE_pos
    have hfE_int_ne : (resDeg F E : ℤ) ≠ 0 := ne_of_gt hfE_int_pos
    refine ⟨hfE_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F E : ℤ)
      set q_z : ℤ := valL F E z
      set r_z : ℤ := relVal F E z % f
      have hediv : f * q_z + r_z = relVal F E z := Int.mul_ediv_add_emod (relVal F E z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F E z) hfE_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F E z) hfE_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : E := z * (((ϖE ^ (-q_z) : Eˣ) : E))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F E y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖE (-q_z), hrel_ϖE]
          linarith
        let d : ℕ := r_z.toNat
        have hd_eq : (d : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hd_pos : 0 < d := by omega
        have hd_lt : d < resDeg F E := by omega
        have hd_mem : d ∈ S := ⟨hd_pos, y, hy_ne, by omega⟩
        have hle : resDeg F E ≤ d := Nat.sInf_le hd_mem
        omega
      linarith

  obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hvalL_surj
  obtain ⟨_, hdiv_M⟩ := hrelVal_div M hvalM_surj
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hresDeg_L_pos)

  let M' := IntermediateField.extendScalars hLM
  let eF : M ≃ₐ[F] M' :=
    { toExtendScalars F hLM with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F M' := Module.Finite.equiv eF.toLinearEquiv
  haveI : IsScalarTower F L M' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L M' := Module.Finite.of_restrictScalars_finite F L M'

  have hrelVal_norm : ∀ z : M, relVal F L (normLM F hLM z) = relVal F M z := by
    intro z
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLM z))) =
      addVal F (Algebra.norm F z)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLM z)) =
        Algebra.norm F (toExtendScalars F hLM z) := Algebra.norm_norm
    have h2 : Algebra.norm F z = Algebra.norm F (toExtendScalars F hLM z) :=
      Algebra.norm_eq_of_algEquiv eF z
    rw [h1, ← h2]

  have hValNorm_LM : ∀ z : M, valL F L (normLM F hLM z) = (f_M : ℤ) * valL F M z := by
    intro z
    have h := hrelVal_norm z
    rw [hdiv_L (normLM F hLM z), hdiv_M z, hresDeg_LM, Nat.cast_mul] at h
    apply mul_left_cancel₀ hfL_int_ne
    linarith

  have hvalL_pow : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero =>
      rw [pow_zero, hvalL_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ, hvalL_mul (x ^ n) x (pow_ne_zero n hx) hx, ih, Nat.cast_add, Nat.cast_one,
        add_one_mul]

  have hValAlg_LM : ∀ x : L, valL F M (IntermediateField.inclusion hLM x) = (k : ℤ) * valL F L x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, map_zero, hvalM_0, hvalL_0, mul_zero]
    · have hto_eq : toExtendScalars F hLM (IntermediateField.inclusion hLM x) =
          algebraMap L M' x := Subtype.ext rfl
      have hnorm_inc : normLM F hLM (IntermediateField.inclusion hLM x) = x ^ (k * f_M) := by
        change Algebra.norm L (toExtendScalars F hLM (IntermediateField.inclusion hLM x)) = x ^ (k * f_M)
        rw [hto_eq, Algebra.norm_algebraMap, hfinrank_LM]
      have h1 := hValNorm_LM (IntermediateField.inclusion hLM x)
      rw [hnorm_inc, hvalL_pow x (k * f_M) hx, Nat.cast_mul] at h1
      have hf_ne0 : (f_M : ℤ) ≠ 0 := by omega
      apply mul_left_cancel₀ hf_ne0
      linarith

  
  have hvalL_unit_pow : ∀ (u : Lˣ) (n : ℕ),
      valL F L ((u ^ n : Lˣ) : L) = (n : ℤ) * valL F L (u : L) := by
    intro u n
    rw [Units.val_pow_eq_pow_val, hvalL_pow (u : L) n (Units.ne_zero u)]

  have hvalL_unit_zpow : ∀ (u : Lˣ) (m : ℤ),
      valL F L ((u ^ m : Lˣ) : L) = m * valL F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F L ((u ^ (n : ℤ) : Lˣ) : L) = (n : ℤ) * valL F L (u : L)
      rw [zpow_natCast, hvalL_unit_pow]
    | negSucc n =>
      rw [zpow_negSucc, hvalL_inv (u ^ (n + 1)), hvalL_unit_pow u (n + 1), Int.negSucc_eq]
      push_cast
      ring

  have hvalM_unit_pow : ∀ (w : Mˣ) (n : ℕ),
      valL F M ((w ^ n : Mˣ) : M) = (n : ℤ) * valL F M (w : M) := by
    intro w n
    induction n with
    | zero =>
      rw [pow_zero, Units.val_one, hvalM_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hvalM_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih,
        Nat.cast_add, Nat.cast_one, add_one_mul]

  have hvalM_iota : ∀ u : Lˣ, valL F M ((ι u : Mˣ) : M) = (k : ℤ) * valL F L (u : L) :=
    fun u => hValAlg_LM (u : L)

  have hresM_unit_ne0 : ∀ w : Mˣ, valL F M (w : M) = 0 → resM (w : M) ≠ 0 := by
    intro w hw h0
    have hker := (hresM_ker (w : M) (Or.inr (by omega))).mp h0
    rcases hker with hw0 | hw1
    · exact Units.ne_zero w hw0
    · omega

  have hresM_unit_mul : ∀ w₁ w₂ : Mˣ,
      valL F M (w₁ : M) = 0 → valL F M (w₂ : M) = 0 →
      valL F M ((w₁ * w₂ : Mˣ) : M) = 0 ∧
      resM ((w₁ * w₂ : Mˣ) : M) = resM (w₁ : M) * resM (w₂ : M) := by
    intro w₁ w₂ hw₁ hw₂
    refine ⟨?_, ?_⟩
    · rw [Units.val_mul, hvalM_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hw₁, hw₂, add_zero]
    · rw [Units.val_mul, (hresM_ring (w₁ : M) (w₂ : M) (Or.inr (by omega)) (Or.inr (by omega))).2.1]

  have hresM_unit_pow : ∀ (w : Mˣ), valL F M (w : M) = 0 →
      ∀ n : ℕ, valL F M ((w ^ n : Mˣ) : M) = 0 ∧ resM ((w ^ n : Mˣ) : M) = (resM (w : M)) ^ n := by
    intro w hw n
    induction n with
    | zero =>
      rw [pow_zero, pow_zero, Units.val_one, hvalM_1, hresM_1]
      exact ⟨rfl, rfl⟩
    | succ n ih =>
      rw [pow_succ, pow_succ]
      have hmul := hresM_unit_mul (w ^ n) w ih.1 hw
      exact ⟨hmul.1, by rw [hmul.2, ih.2]⟩

  have hval_c₀ : valL F L (c₀ : L) = 1 + condExpChar F L ψ := by
    dsimp only [c₀]
    rw [hvalL_unit_zpow ϖ_L (1 + condExpChar F L ψ), hϖ_L, mul_one]

  have hval_ιc₀ : valL F M ((ι c₀ : Mˣ) : M) = (k : ℤ) * (1 + condExpChar F L ψ) := by
    rw [hvalM_iota c₀, hval_c₀]

  have hval_ιϖ_L : valL F M ((ι ϖ_L : Mˣ) : M) = (k : ℤ) := by
    rw [hvalM_iota ϖ_L, hϖ_L, mul_one]

  have hval_ε : valL F M (ε : M) = 0 := by
    dsimp only [ε]
    rw [Units.val_mul, hvalM_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalM_unit_pow ϖ_M k, hϖ_M, hvalM_inv (ι ϖ_L), hval_ιϖ_L]
    ring

  have hres_ε : resM (ε : M) ≠ 0 := hresM_unit_ne0 ε hval_ε

  have hval_c0_mu : valL F M ((ι c₀ * c'_μ⁻¹ : Mˣ) : M) = - (t : ℤ) := by
    rw [Units.val_mul, hvalM_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hval_ιc₀, hvalM_inv c'_μ, hc_μ_val]
    push_cast
    ring

  have hval_v₀ : valL F M (v₀ : M) = 0 := by
    dsimp only [v₀]
    rw [Units.val_mul, hvalM_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hval_c0_mu, hvalM_unit_pow ϖ_M t, hϖ_M]
    ring

  have hres_v₀ : resM (v₀ : M) ≠ 0 := hresM_unit_ne0 v₀ hval_v₀

  have hval_Θ : valL F M (Θ : M) = 0 := by
    dsimp only [Θ]
    rw [Units.val_mul, hvalM_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalM_unit_pow (ι c₀ * c'_μ⁻¹) k, hval_c0_mu, hvalM_unit_pow (ι ϖ_L) t, hval_ιϖ_L]
    ring

  have hΘ_ε_eq : Θ * ε ^ t = v₀ ^ k := by
    apply Units.ext
    have h_cancel : ((ι ϖ_L : Mˣ) : M) ^ t * ((((ι ϖ_L)⁻¹ : Mˣ) : M) ^ t) = 1 := by
      rw [← mul_pow, Units.mul_inv, one_pow]
    have h_pow_comm : ((ϖ_M : M) ^ k) ^ t = ((ϖ_M : M) ^ t) ^ k := by
      rw [← pow_mul, mul_comm k t, pow_mul]
    calc (((Θ * ε ^ t : Mˣ) : M))
      _ = (((ι c₀ * c'_μ⁻¹ : Mˣ) : M) ^ k * ((ϖ_M : M) ^ k) ^ t) *
            (((ι ϖ_L : Mˣ) : M) ^ t * ((((ι ϖ_L)⁻¹ : Mˣ) : M) ^ t)) := by
          dsimp only [Θ, ε]
          simp only [Units.val_mul, Units.val_pow_eq_pow_val]
          ring
      _ = (((ι c₀ * c'_μ⁻¹ : Mˣ) : M) ^ k * ((ϖ_M : M) ^ t) ^ k) := by
          rw [h_cancel, mul_one, h_pow_comm]
      _ = (((v₀ ^ k : Mˣ) : M)) := by
          dsimp only [v₀]
          simp only [Units.val_mul, Units.val_pow_eq_pow_val]
          ring

  have hres_Θ_ε : resM (Θ : M) * (resM (ε : M)) ^ t = (resM (v₀ : M)) ^ k := by
    calc resM (Θ : M) * (resM (ε : M)) ^ t
      _ = resM (Θ : M) * resM ((ε ^ t : Mˣ) : M) := by rw [← (hresM_unit_pow ε hval_ε t).2]
      _ = resM ((Θ * ε ^ t : Mˣ) : M) := (hresM_unit_mul Θ (ε ^ t) hval_Θ (hresM_unit_pow ε hval_ε t).1).2.symm
      _ = resM ((v₀ ^ k : Mˣ) : M) := by rw [hΘ_ε_eq]
      _ = (resM (v₀ : M)) ^ k := (hresM_unit_pow v₀ hval_v₀ k).2

  have hv_μ_res : condExp F M μ = t + 1 → (t + 1) % 2 = 1 → k = 1 →
      resM (v_μ : M) = resM (Θ : M) * ((resM (ε : M)) ^ (t / 2)) ^ 2 := by
    intro hμ_cond ht_odd hk1
    have hexp_μ : 2 * (condExp F M μ / 2) = t := by omega
    have ht_div : t = (t / 2) * 2 := by omega
    have hv_μ_eq : v_μ = v₀ := by
      dsimp only [v_μ, v₀]
      rw [hexp_μ]
    have hpow_ε : (resM (ε : M)) ^ t = ((resM (ε : M)) ^ (t / 2)) ^ 2 := by
      conv_lhs => rw [ht_div]
      exact pow_mul (resM (ε : M)) (t / 2) 2
    rw [hv_μ_eq, ← pow_one (resM (v₀ : M)), ← hk1, ← hres_Θ_ε, hpow_ε]

  have hv_θ_res : valL F L (u_χ' : L) = 0 →
      resL (u_χ' : L) ≠ 0 →
      condExp F M θ = k * (condExp F L χ' - 1) + 1 →
      (k * (condExp F L χ' - 1) + 1) % 2 = 1 →
      c'_θ * (ι c'_χ')⁻¹ ∈ unitGroup F M 1 →
      resM (v_θ : M) =
        (algebraMap k_L k_M (resL (u_χ' : L)))⁻¹ *
          (resM (ε : M)) ^ (condExp F L χ' - 1) := by
    intro hu_val hu_res hθ_cond hθ_odd hδ_mem
    set a := condExp F L χ'
    set δ : Mˣ := c'_θ * (ι c'_χ')⁻¹
    have hexp_θ : 2 * (condExp F M θ / 2) = k * (a - 1) := by omega
    have hι_u_inv : ι (u_χ'⁻¹) = (ι c'_χ')⁻¹ * ((ι ϖ_L) ^ (a - 1) * ι c₀) := by
      dsimp only [u_χ']
      rw [map_inv, map_mul, map_inv, map_mul, map_pow, mul_inv_rev, inv_inv]
    have hδ_inv : δ⁻¹ = ι c'_χ' * c'_θ⁻¹ := by
      dsimp only [δ]
      rw [mul_inv_rev, inv_inv]
    have hε_pow : ε ^ (a - 1) = ϖ_M ^ (k * (a - 1)) * ((ι ϖ_L) ^ (a - 1))⁻¹ := by
      dsimp only [ε]
      rw [mul_pow, ← pow_mul, inv_pow]
    have hv_θ_eq : v_θ = δ⁻¹ * ι (u_χ'⁻¹) * ε ^ (a - 1) := by
      apply Units.ext
      have h_cancel_c : ((ι c'_χ' : Mˣ) : M) * (((ι c'_χ')⁻¹ : Mˣ) : M) = 1 := Units.mul_inv _
      have h_cancel_ϖ : (((ι ϖ_L) ^ (a - 1) : Mˣ) : M) *
          ((((ι ϖ_L) ^ (a - 1))⁻¹ : Mˣ) : M) = 1 := Units.mul_inv _
      calc ((v_θ : Mˣ) : M)
        _ = ((ι c₀ : Mˣ) : M) * ((c'_θ⁻¹ : Mˣ) : M) * ((ϖ_M ^ (k * (a - 1)) : Mˣ) : M) := by
            dsimp only [v_θ]
            rw [hexp_θ, Units.val_mul, Units.val_mul]
        _ = (((ι c₀ : Mˣ) : M) * ((c'_θ⁻¹ : Mˣ) : M) * ((ϖ_M ^ (k * (a - 1)) : Mˣ) : M)) *
              (((ι c'_χ' : Mˣ) : M) * (((ι c'_χ')⁻¹ : Mˣ) : M)) *
              ((((ι ϖ_L) ^ (a - 1) : Mˣ) : M) * ((((ι ϖ_L) ^ (a - 1))⁻¹ : Mˣ) : M)) := by
            rw [h_cancel_c, h_cancel_ϖ, mul_one, mul_one]
        _ = ((δ⁻¹ * ι (u_χ'⁻¹) * ε ^ (a - 1) : Mˣ) : M) := by
            rw [hδ_inv, hι_u_inv, hε_pow]
            simp only [Units.val_mul]
            ring
    have hδ_inv_mem : δ⁻¹ ∈ unitGroup F M 1 := Subgroup.inv_mem _ hδ_mem
    have hval_δ_inv : valL F M ((δ⁻¹ : Mˣ) : M) = 0 := hunit_val0_M 1 δ⁻¹ hδ_inv_mem
    have hres_δ_inv : resM ((δ⁻¹ : Mˣ) : M) = 1 := by
      have hmem1 := (hunit_ge1_M 1 le_rfl δ⁻¹).mp hδ_inv_mem
      have hsub_int : (((δ⁻¹ : Mˣ) : M) - 1 = 0 ∨ 0 ≤ valL F M (((δ⁻¹ : Mˣ) : M) - 1)) := by
        rcases hmem1 with h1 | hge1
        · left; rw [h1, sub_self]
        · right; omega
      have hres_sub0 : resM (((δ⁻¹ : Mˣ) : M) - 1) = 0 :=
        (hresM_ker (((δ⁻¹ : Mˣ) : M) - 1) hsub_int).mpr
          (hmem1.imp (fun h1 => by rw [h1, sub_self]) id)
      have heq : ((δ⁻¹ : Mˣ) : M) = (((δ⁻¹ : Mˣ) : M) - 1) + 1 := by ring
      rw [heq, (hresM_ring (((δ⁻¹ : Mˣ) : M) - 1) 1 hsub_int (Or.inr (by rw [hvalM_1]))).1,
        hres_sub0, hresM_1, zero_add]
    have hval_u_inv : valL F L ((u_χ'⁻¹ : Lˣ) : L) = 0 := by
      rw [hvalL_inv u_χ', hu_val, neg_zero]
    have hresL_u_inv : resL ((u_χ'⁻¹ : Lˣ) : L) = (resL (u_χ' : L))⁻¹ := by
      have hmul1 : resL (u_χ' : L) * resL ((u_χ'⁻¹ : Lˣ) : L) = 1 := by
        rw [← (hresL_ring (u_χ' : L) ((u_χ'⁻¹ : Lˣ) : L)
          (Or.inr (by omega)) (Or.inr (by omega))).2.1, Units.mul_inv, hresL_1]
      exact eq_inv_of_mul_eq_one_right hmul1
    have hval_ιu_inv : valL F M ((ι (u_χ'⁻¹) : Mˣ) : M) = 0 := by
      rw [hvalM_iota (u_χ'⁻¹), hval_u_inv, mul_zero]
    have hres_ιu_inv : resM ((ι (u_χ'⁻¹) : Mˣ) : M) =
        (algebraMap k_L k_M (resL (u_χ' : L)))⁻¹ := by
      change resM (IntermediateField.inclusion hLM ((u_χ'⁻¹ : Lˣ) : L)) = _
      rw [hres_alg ((u_χ'⁻¹ : Lˣ) : L) (Or.inr (by omega)), hresL_u_inv, map_inv₀]
    have hmul_12 := hresM_unit_mul δ⁻¹ (ι (u_χ'⁻¹)) hval_δ_inv hval_ιu_inv
    have hpow_ε := hresM_unit_pow ε hval_ε (a - 1)
    have hmul_123 := hresM_unit_mul (δ⁻¹ * ι (u_χ'⁻¹)) (ε ^ (a - 1)) hmul_12.1 hpow_ε.1
    rw [hv_θ_eq, hmul_123.2, hmul_12.2, hres_δ_inv, one_mul, hres_ιu_inv, hpow_ε.2]

  exact ⟨hValNorm_LM, hValAlg_LM, hval_ε, hres_ε, hval_v₀, hres_v₀, hres_Θ_ε, hv_μ_res, hv_θ_res⟩

theorem ld_ch14_odd_p_regime_one_quad_gauss_balance (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    (hLE : L ≤ E)
    (ψ : AddChar L (Ω F))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hqE : qL F E = qL F L)
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k) (hk_even_or1 : k = 1 ∨ 2 ∣ k)
    (hnot_even : ¬ (2 ∣ t ∧ 2 ∣ k))
    (hk_le_t : k * (condExp F L χ' - 1) ≤ t)
    (hFi_b : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1)
    (hFi_c : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) = t + 1)
    (ha_E_eq : condExp F E (χ'.comp (Units.map (normLM F hLE))) = condExp F L χ')
    (ϖ_L : Lˣ)
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_orb_val : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      valL F F_i (c'_θ i : F_i) =
        (condExp F F_i θ_i : ℤ) + condExpChar F F_i ψ_Fi)
    (hsub_cong : k * (condExp F L χ' - 1) < t →
      ∀ i : Fin D_orb.length,
        c'_θ i * (c'_μ i)⁻¹ ∈ unitGroup F (D_orb.get i).field 1)
    (k_L k_E : Type u) [Field k_L] [Fintype k_L] [Field k_E] [Fintype k_E]
    (resL : L → k_L) (ψ_0L : AddChar k_L (Ω F)) (ψ_0E : AddChar k_E (Ω F))
    (k_Fi : Fin D_orb.length → Type u)
    [∀ i, Field (k_Fi i)] [∀ i, Fintype (k_Fi i)] [∀ i, Algebra k_L (k_Fi i)]
    (resFi : ∀ i : Fin D_orb.length, (D_orb.get i).field → k_Fi i)
    (ϖ_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (ψ_0μ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (ψ_0θ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (hresL_map : IsResidueFieldMap F L k_L resL)
    (hresFi_map : ∀ i : Fin D_orb.length,
      IsResidueFieldMap F (D_orb.get i).field (k_Fi i) (resFi i))
    (hcard_kL : Fintype.card k_L = qL F L)
    (G_L : Ω F)
    (hL_gauss :
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
      valL F L (u_χ' : L) = 0 ∧
      resL (u_χ' : L) ≠ 0 ∧
      (condExp F L χ' % 2 = 1 →
        oddStatGaussFactor F L χ' k_L ψ_0L =
          ((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)))
    (hE_gauss :
      let a_E := condExp F E (χ'.comp (Units.map (normLM F hLE)))
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let u_E_norm : Lˣ :=
        (ϖ_L ^ (a_E - 1))⁻¹ * c₀⁻¹ * c'_χ' *
          (∏ i : Fin D_orb.length,
            Units.map (normLM F (D_orb.get i).le) (c'_θ i * (c'_μ i)⁻¹))
      a_E % 2 = 1 →
        oddStatGaussFactor F E (χ'.comp (Units.map (normLM F hLE))) k_E ψ_0E =
          ((quadraticChar k_L (resL (u_E_norm : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L))
    (hFi_gauss : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      let f_i := Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let v_μ : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_μ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i (μ'_orb i) / 2)))
      let v_θ : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_θ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i θ_i / 2)))
      (condExp F F_i (μ'_orb i) % 2 = 1 →
        valL F F_i (v_μ : F_i) = 0 ∧
        resFi i (v_μ : F_i) ≠ 0 ∧
        oddStatGaussFactor F F_i (μ'_orb i) (k_Fi i) (ψ_0μ i) =
          (((-1 : ℤ) ^ (f_i - 1) *
            quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_μ : F_i))) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i) ∧
      (condExp F F_i θ_i % 2 = 1 →
        valL F F_i (v_θ : F_i) = 0 ∧
        resFi i (v_θ : F_i) ≠ 0 ∧
        oddStatGaussFactor F F_i θ_i (k_Fi i) (ψ_0θ i) =
          (((-1 : ℤ) ^ (f_i - 1) *
            quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_θ : F_i))) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i))
    (hNormVal0 : ∀ i : Fin D_orb.length, ∀ w : ((D_orb.get i).field)ˣ,
      valL F (D_orb.get i).field (w : (D_orb.get i).field) = 0 →
      valL F L ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L) = 0)
    (hNormRes : ∀ i : Fin D_orb.length, ∀ w : ((D_orb.get i).field)ˣ,
      valL F (D_orb.get i).field (w : (D_orb.get i).field) = 0 →
      resL ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L) =
        (Algebra.norm k_L (resFi i (w : (D_orb.get i).field))) ^ k) :
    ((statHalfCondFactor F E (traceChar F hLE ψ) (χ'.comp (Units.map (normLM F hLE))) *
        (qL F L : Ω F) ^ condExpChar F L ψ *
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field
            (traceChar F (D_orb.get i).le ψ) (μ'_orb i))) ^ (p F)) *
      oddStatGaussFactor F E (χ'.comp (Units.map (normLM F hLE))) k_E ψ_0E *
      (∏ i : Fin D_orb.length,
        oddStatGaussFactor F (D_orb.get i).field (μ'_orb i) (k_Fi i) (ψ_0μ i)) =
    (((qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
        statHalfCondFactor F L ψ χ' *
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field
            (traceChar F (D_orb.get i).le ψ)
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))))) ^ (p F)) *
      oddStatGaussFactor F L χ' k_L ψ_0L *
      (∏ i : Fin D_orb.length,
        oddStatGaussFactor F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (k_Fi i) (ψ_0θ i)) :=
by
  have h_valL_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) := by
    intro M _
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F M (-1) = 0 := by
      have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F M ((-1 : M) * (-1 : M)) = relVal F M (-1) + relVal F M (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : M) * (-1 : M) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : M, relVal F M (-x) = relVal F M x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : M) = (-1 : M) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul : relVal F M ((u : M) * ((u⁻¹ : Mˣ) : M)) =
          relVal F M (u : M) + relVal F M ((u⁻¹ : Mˣ) : M) :=
        hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : M := algebraMap F M π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F M x₀ = (Module.finrank F M : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F M := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F M, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖ₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    have hdiv : ∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F M : ℤ)
        set q_v : ℤ := valL F M x
        set r : ℤ := relVal F M x % f
        have hediv : f * q_v + r = relVal F M x := Int.mul_ediv_add_emod (relVal F M x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M x) hfM_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M x) hfM_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : M := x * (((ϖM ^ (-q_v) : Mˣ) : M))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F M y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q_v), hrel_ϖM]
            linarith
          let k_r : ℕ := r.toNat
          have hk_eq : (k_r : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k_r := by omega
          have hk_lt : k_r < resDeg F M := by omega
          have hk_mem : k_r ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k_r := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F M 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval1 : valL F M 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg1 : valL F M (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg : ∀ x : M, valL F M (-x) = valL F M x := by
      intro x
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
      intro u
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv⟩

  
  have h_unit1_res : ∀ (i : Fin D_orb.length) (u : ((D_orb.get i).field)ˣ),
      u ∈ unitGroup F (D_orb.get i).field 1 →
      resFi i (u : (D_orb.get i).field) = 1 := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    obtain ⟨_, hval1, _, _, hval_mul, hval_inv⟩ := h_valL_props (D_orb.get i).field
    obtain ⟨hres0, hres1, hres_ring, hres_ker, _⟩ := hresFi_map i
    let H₁ : Subgroup ((D_orb.get i).field)ˣ := {
      carrier := {u : ((D_orb.get i).field)ˣ |
        valL F (D_orb.get i).field (u : (D_orb.get i).field) = 0 ∧
        resFi i (u : (D_orb.get i).field) = 1}
      one_mem' := ⟨by change valL F (D_orb.get i).field (1 : (D_orb.get i).field) = 0; exact hval1,
        by change resFi i (1 : (D_orb.get i).field) = 1; exact hres1⟩
      mul_mem' := by
        intro u v ⟨hu_val, hu_res⟩ ⟨hv_val, hv_res⟩
        refine ⟨?_, ?_⟩
        · change valL F (D_orb.get i).field ((u : (D_orb.get i).field) * (v : (D_orb.get i).field)) = 0
          rw [hval_mul _ _ (Units.ne_zero u) (Units.ne_zero v), hu_val, hv_val, add_zero]
        · change resFi i ((u : (D_orb.get i).field) * (v : (D_orb.get i).field)) = 1
          rw [(hres_ring (u : (D_orb.get i).field) (v : (D_orb.get i).field)
            (Or.inr (by omega)) (Or.inr (by omega))).2.1, hu_res, hv_res, mul_one]
      inv_mem' := by
        intro u ⟨hu_val, hu_res⟩
        have hinv_val : valL F (D_orb.get i).field ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 0 := by
          rw [hval_inv u, hu_val, neg_zero]
        refine ⟨hinv_val, ?_⟩
        have hmul : resFi i (u : (D_orb.get i).field) *
            resFi i ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 1 := by
          rw [← (hres_ring (u : (D_orb.get i).field)
            ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)
            (Or.inr (by omega)) (Or.inr (by omega))).2.1,
            Units.mul_inv, hres1]
        rw [hu_res, one_mul] at hmul
        exact hmul
    }
    have hcl : unitGroup F (D_orb.get i).field 1 ≤ H₁ := by
      unfold unitGroup
      rw [Subgroup.closure_le]
      intro u hu
      simp only [Set.mem_setOf_eq, one_ne_zero, ↓reduceIte, Nat.cast_one] at hu
      rcases hu with hu1 | hu_ge1
      · exact ⟨by rw [hu1, hval1], by rw [hu1, hres1]⟩
      · have h_ge0 : 0 ≤ valL F (D_orb.get i).field (u : (D_orb.get i).field) := by
          by_contra hlt
          push_neg at hlt
          have hinv_ge1 : 1 ≤ valL F (D_orb.get i).field ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) := by
            rw [hval_inv u]; omega
          have hux_ge1 : ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1) = 0 ∨
              1 ≤ valL F (D_orb.get i).field (((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1)) := by
            by_cases hx0 : (u : (D_orb.get i).field) - 1 = 0
            · left; rw [hx0, mul_zero]
            · right
              rw [hval_mul _ _ (Units.ne_zero u⁻¹) hx0]
              omega
          have hres_uinv : resFi i ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 0 :=
            (hres_ker ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)
              (Or.inr (by omega))).mpr (Or.inr hinv_ge1)
          have hux_int : ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1) = 0 ∨
              0 ≤ valL F (D_orb.get i).field (((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1)) := by
            rcases hux_ge1 with h0 | h1
            · exact Or.inl h0
            · exact Or.inr (by omega)
          have hres_ux : resFi i (((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1)) = 0 :=
            (hres_ker (((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1))
              hux_int).mpr hux_ge1
          have hsum_eq : ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1) +
              ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 1 := by
            have hmul1 : ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * (u : (D_orb.get i).field) = 1 :=
              Units.inv_mul u
            linear_combination hmul1
          have hres_sum := (hres_ring
            (((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * ((u : (D_orb.get i).field) - 1))
            ((u⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)
            hux_int (Or.inr (by omega))).1
          rw [hsum_eq, hres1, hres_ux, hres_uinv, add_zero] at hres_sum
          exact one_ne_zero hres_sum
        have hx_res0 : resFi i ((u : (D_orb.get i).field) - 1) = 0 :=
          (hres_ker ((u : (D_orb.get i).field) - 1) (Or.inr (by omega))).mpr (Or.inr hu_ge1)
        have hu_res1 : resFi i (u : (D_orb.get i).field) = 1 := by
          have heq : (u : (D_orb.get i).field) = ((u : (D_orb.get i).field) - 1) + 1 :=
            (sub_add_cancel (u : (D_orb.get i).field) 1).symm
          rw [heq, (hres_ring ((u : (D_orb.get i).field) - 1) 1
            (Or.inr (by omega)) (Or.inr (by rw [hval1]))).1,
            hx_res0, hres1, zero_add]
        have hu_val0 : valL F (D_orb.get i).field (u : (D_orb.get i).field) = 0 := by
          by_contra hne0
          have hge1 : 1 ≤ valL F (D_orb.get i).field (u : (D_orb.get i).field) := by omega
          have hres0' : resFi i (u : (D_orb.get i).field) = 0 :=
            (hres_ker (u : (D_orb.get i).field) (Or.inr h_ge0)).mpr (Or.inr hge1)
          rw [hu_res1] at hres0'
          exact one_ne_zero hres0'
        exact ⟨hu_val0, hu_res1⟩
    intro u hu
    exact (hcl hu).2

  
  let q_0 : Ω F := (qL F L : Ω F)
  let χ'_E := χ'.comp (Units.map (normLM F hLE))
  let θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
    fun i => μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
  have hqL_pos : 0 < qL F L := by
    rw [← hcard_kL]
    exact Fintype.card_pos
  have hq0_ne : q_0 ≠ 0 := by
    dsimp [q_0]
    exact_mod_cast hqL_pos.ne'
  have h_stat_EL :
      statHalfCondFactor F E (traceChar F hLE ψ) χ'_E * q_0 ^ condExpChar F L ψ =
      (qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) * statHalfCondFactor F L ψ χ' := by
    unfold statHalfCondFactor
    rw [hqE, ha_E_eq, zpow_add₀ hq0_ne, zpow_add₀ hq0_ne]
    ring
  have h_stat_orb :
      (∏ i : Fin D_orb.length,
        statHalfCondFactor F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) (μ'_orb i)) =
      (∏ i : Fin D_orb.length,
        statHalfCondFactor F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) (θ_orb i)) := by
    apply Finset.prod_congr rfl
    intro i _
    unfold statHalfCondFactor
    rw [hFi_b i, hFi_c i]
  have h_pref_eq :
      (statHalfCondFactor F E (traceChar F hLE ψ) χ'_E *
        (qL F L : Ω F) ^ condExpChar F L ψ *
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field
            (traceChar F (D_orb.get i).le ψ) (μ'_orb i))) ^ (p F) =
      ((qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
        statHalfCondFactor F L ψ χ' *
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field
            (traceChar F (D_orb.get i).le ψ) (θ_orb i))) ^ (p F) := by
    rw [h_stat_EL, h_stat_orb]

  
  let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
  let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
  let a_E := condExp F E χ'_E
  let u_E_norm : Lˣ :=
    (ϖ_L ^ (a_E - 1))⁻¹ * c₀⁻¹ * c'_χ' *
      (∏ i : Fin D_orb.length,
        Units.map (normLM F (D_orb.get i).le) (c'_θ i * (c'_μ i)⁻¹))
  let w_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
    fun i => c'_θ i * (c'_μ i)⁻¹
  let v_μ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ := fun i =>
    Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
      (c'_μ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F (D_orb.get i).field (μ'_orb i) / 2)))
  let v_θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ := fun i =>
    Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
      (c'_θ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F (D_orb.get i).field (θ_orb i) / 2)))
  have hw_val0 : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (w_orb i : (D_orb.get i).field) = 0 := by
    intro i
    let F_i := (D_orb.get i).field
    haveI : FiniteDimensional F F_i := hFinFi i
    obtain ⟨_, _, _, _, hval_mul, hval_inv⟩ := h_valL_props F_i
    have hc_μ := (hc_orb_val i).1
    have hc_θ := (hc_orb_val i).2
    dsimp only [w_orb]
    rw [Units.val_mul, hval_mul _ _ (Units.ne_zero (c'_θ i)) (Units.ne_zero (c'_μ i)⁻¹),
      hval_inv (c'_μ i), hc_θ, hc_μ, hFi_b i, hFi_c i]
    omega
  have hw_res_ne0 : ∀ i : Fin D_orb.length,
      resFi i (w_orb i : (D_orb.get i).field) ≠ 0 := by
    intro i h0
    have hval0 := hw_val0 i
    obtain ⟨_, _, _, hres_ker, _⟩ := hresFi_map i
    rcases (hres_ker _ (Or.inr (by omega))).mp h0 with h_eq0 | h_ge1
    · exact Units.ne_zero (w_orb i) h_eq0
    · omega
  have hv_μ_eq : ∀ i : Fin D_orb.length, v_μ_orb i = w_orb i * v_θ_orb i := by
    intro i
    dsimp only [v_μ_orb, v_θ_orb, w_orb, θ_orb]
    rw [hFi_b i, hFi_c i]
    symm
    calc (c'_θ i * (c'_μ i)⁻¹) *
        (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_θ i)⁻¹ * ((ϖ_Fi i) ^ (2 * ((t + 1) / 2))))
      _ = Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_θ i * ((c'_θ i)⁻¹ * (c'_μ i)⁻¹)) * ((ϖ_Fi i) ^ (2 * ((t + 1) / 2))) := by ac_rfl
      _ = Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_μ i)⁻¹ * ((ϖ_Fi i) ^ (2 * ((t + 1) / 2))) := by rw [mul_inv_cancel_left]
  have hv_μ_res : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (v_θ_orb i : (D_orb.get i).field) = 0 →
      resFi i (v_μ_orb i : (D_orb.get i).field) =
        resFi i (w_orb i : (D_orb.get i).field) *
          resFi i (v_θ_orb i : (D_orb.get i).field) := by
    intro i hv_θ_val
    have hw_val := hw_val0 i
    obtain ⟨_, _, hres_ring, _, _⟩ := hresFi_map i
    rw [hv_μ_eq i, Units.val_mul,
      (hres_ring _ _ (Or.inr (by omega)) (Or.inr (by omega))).2.1]

  
  let g_orb : Fin D_orb.length → Lˣ :=
    fun i => Units.map (normLM F (D_orb.get i).le) (w_orb i)
  obtain ⟨_, hvalL_1, _, _, hvalL_mul, _⟩ := h_valL_props L
  obtain ⟨_, hresL_1, hresL_ring, _, _⟩ := hresL_map
  have h_prod_res : ∀ (s : Finset (Fin D_orb.length)),
      valL F L (((∏ i ∈ s, g_orb i : Lˣ) : L)) = 0 ∧
      resL (((∏ i ∈ s, g_orb i : Lˣ) : L)) =
        ∏ i ∈ s, (Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field))) ^ k := by
    intro s
    induction' s using Finset.induction_on with j s' hj ih
    · simp only [Finset.prod_empty, Units.val_one]
      exact ⟨hvalL_1, hresL_1⟩
    · rw [Finset.prod_insert hj, Finset.prod_insert hj, Units.val_mul]
      have hj_val : valL F L (g_orb j : L) = 0 := hNormVal0 j (w_orb j) (hw_val0 j)
      have hj_res : resL (g_orb j : L) =
          (Algebra.norm k_L (resFi j (w_orb j : (D_orb.get j).field))) ^ k :=
        hNormRes j (w_orb j) (hw_val0 j)
      have hs'_val : valL F L (((∏ i ∈ s', g_orb i : Lˣ) : L)) = 0 := ih.1
      refine ⟨?_, ?_⟩
      · rw [hvalL_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hj_val, hs'_val, add_zero]
      · rw [(hresL_ring _ _ (Or.inr (by omega)) (Or.inr (by omega))).2.1, hj_res, ih.2]
  have hu_E_eq : u_E_norm = u_χ' * (∏ i : Fin D_orb.length, g_orb i) := by
    dsimp only [u_E_norm, u_χ', g_orb, w_orb, a_E, χ'_E]
    rw [ha_E_eq, mul_inv_rev]
    ac_rfl
  have hu_E_res : resL (u_E_norm : L) =
      resL (u_χ' : L) *
        ∏ i : Fin D_orb.length,
          (Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field))) ^ k := by
    have hu_val0 : valL F L (u_χ' : L) = 0 := hL_gauss.1
    have hprod_val0 : valL F L (((∏ i : Fin D_orb.length, g_orb i : Lˣ) : L)) = 0 :=
      (h_prod_res Finset.univ).1
    rw [hu_E_eq, Units.val_mul,
      (hresL_ring _ _ (Or.inr (by omega)) (Or.inr (by omega))).2.1,
      (h_prod_res Finset.univ).2]

  
  rcases lt_or_eq_of_le hk_le_t with h_lt | h_eq
  · 
    have hw_res1 : ∀ i : Fin D_orb.length,
        resFi i (w_orb i : (D_orb.get i).field) = 1 :=
      fun i => h_unit1_res i (w_orb i) (hsub_cong h_lt i)
    have hu_E_res_sub : resL (u_E_norm : L) = resL (u_χ' : L) := by
      rw [hu_E_res]
      have hprod1 : (∏ i : Fin D_orb.length,
          (Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field))) ^ k) = 1 := by
        apply Finset.prod_eq_one
        intro i _
        rw [hw_res1 i, map_one, one_pow]
      rw [hprod1, mul_one]
    have hΓ_EL_eq :
        oddStatGaussFactor F E χ'_E k_E ψ_0E = oddStatGaussFactor F L χ' k_L ψ_0L := by
      by_cases ha_odd : condExp F L χ' % 2 = 1
      · have haE_odd : condExp F E χ'_E % 2 = 1 := by rw [ha_E_eq]; exact ha_odd
        rw [hE_gauss haE_odd, hL_gauss.2.2 ha_odd, hu_E_res_sub]
      · unfold oddStatGaussFactor
        rw [ha_E_eq, if_neg ha_odd, if_neg ha_odd]
    have hΓ_orb_eq :
        (∏ i : Fin D_orb.length,
          oddStatGaussFactor F (D_orb.get i).field (μ'_orb i) (k_Fi i) (ψ_0μ i)) =
        (∏ i : Fin D_orb.length,
          oddStatGaussFactor F (D_orb.get i).field (θ_orb i) (k_Fi i) (ψ_0θ i)) := by
      apply Finset.prod_congr rfl
      intro i _
      by_cases hb_odd : (t + 1) % 2 = 1
      · have hb_i : condExp F (D_orb.get i).field (μ'_orb i) % 2 = 1 := by
          rw [hFi_b i]; exact hb_odd
        have hc_i : condExp F (D_orb.get i).field (θ_orb i) % 2 = 1 := by
          rw [hFi_c i]; exact hb_odd
        have hv_θ_val0 : valL F (D_orb.get i).field (v_θ_orb i : (D_orb.get i).field) = 0 :=
          ((hFi_gauss i).2 hc_i).1
        have hv_res_eq : resFi i (v_μ_orb i : (D_orb.get i).field) =
            resFi i (v_θ_orb i : (D_orb.get i).field) := by
          rw [hv_μ_res i hv_θ_val0, hw_res1 i, one_mul]
        rw [((hFi_gauss i).1 hb_i).2.2, ((hFi_gauss i).2 hc_i).2.2, hv_res_eq]
      · unfold oddStatGaussFactor
        rw [hFi_b i, hFi_c i, if_neg hb_odd, if_neg hb_odd]
    rw [h_pref_eq, hΓ_EL_eq, hΓ_orb_eq]
  · 
    rcases Nat.mod_two_eq_zero_or_one (t + 1) with hb_even | hb_odd
    · 
      have hb_not_odd : (t + 1) % 2 ≠ 1 := by omega
      have ha_not_odd : condExp F L χ' % 2 ≠ 1 := by
        intro ha_odd
        have ha1_even : (condExp F L χ' - 1) % 2 = 0 := by omega
        have ht_even : t % 2 = 0 := by
          rw [← h_eq, Nat.mul_mod, ha1_even, mul_zero, Nat.zero_mod]
        omega
      have hΓ_E_1 : oddStatGaussFactor F E χ'_E k_E ψ_0E = 1 := by
        unfold oddStatGaussFactor
        rw [ha_E_eq, if_neg ha_not_odd]
      have hΓ_L_1 : oddStatGaussFactor F L χ' k_L ψ_0L = 1 := by
        unfold oddStatGaussFactor
        rw [if_neg ha_not_odd]
      have hΓ_μ_1 : (∏ i : Fin D_orb.length,
          oddStatGaussFactor F (D_orb.get i).field (μ'_orb i) (k_Fi i) (ψ_0μ i)) = 1 := by
        apply Finset.prod_eq_one
        intro i _
        unfold oddStatGaussFactor
        rw [hFi_b i, if_neg hb_not_odd]
      have hΓ_θ_1 : (∏ i : Fin D_orb.length,
          oddStatGaussFactor F (D_orb.get i).field (θ_orb i) (k_Fi i) (ψ_0θ i)) = 1 := by
        apply Finset.prod_eq_one
        intro i _
        unfold oddStatGaussFactor
        rw [hFi_c i, if_neg hb_not_odd]
      rw [h_pref_eq, hΓ_E_1, hΓ_L_1, hΓ_μ_1, hΓ_θ_1]
    · 
      have ht_dvd2 : 2 ∣ t := Nat.dvd_of_mod_eq_zero (by omega)
      have hk1 : k = 1 := by
        rcases hk_even_or1 with hk1 | hk_dvd2
        · exact hk1
        · exact False.elim (hnot_even ⟨ht_dvd2, hk_dvd2⟩)
      have ha_eq_t1 : condExp F L χ' = t + 1 := by
        have h1 : 1 * (condExp F L χ' - 1) = t := by rw [← h_eq, hk1]
        omega
      have ha_odd : condExp F L χ' % 2 = 1 := by
        rw [ha_eq_t1]; exact hb_odd
      have haE_odd : condExp F E χ'_E % 2 = 1 := by
        rw [ha_E_eq]; exact ha_odd
      let s_w : Fin D_orb.length → Ω F := fun i =>
        ((quadraticChar k_L (Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field))) : ℤ) : Ω F)
      have hs_w_sq : ∀ i : Fin D_orb.length, s_w i * s_w i = 1 := by
        intro i
        have hnorm_ne0 : Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field)) ≠ 0 :=
          ((hw_res_ne0 i).isUnit.map (Algebra.norm k_L)).ne_zero
        have hsq1 : (quadraticChar k_L (Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field)))) ^ 2 = 1 :=
          quadraticChar_sq_one hnorm_ne0
        dsimp only [s_w]
        rw [← Int.cast_mul, ← sq, hsq1, Int.cast_one]
      have hS_sq : (∏ i : Fin D_orb.length, s_w i) * (∏ i : Fin D_orb.length, s_w i) = 1 := by
        rw [← Finset.prod_mul_distrib]
        apply Finset.prod_eq_one
        intro i _
        exact hs_w_sq i
      have hΓ_E_rel :
          oddStatGaussFactor F E χ'_E k_E ψ_0E =
          (∏ i : Fin D_orb.length, s_w i) * oddStatGaussFactor F L χ' k_L ψ_0L := by
        rw [hE_gauss haE_odd, hL_gauss.2.2 ha_odd, hu_E_res]
        have hprod_k1 :
            (∏ i : Fin D_orb.length,
              (Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field))) ^ k) =
            ∏ i : Fin D_orb.length,
              Algebra.norm k_L (resFi i (w_orb i : (D_orb.get i).field)) := by
          apply Finset.prod_congr rfl
          intro i _
          rw [hk1, pow_one]
        rw [hprod_k1, map_mul, map_prod, Int.cast_mul, Int.cast_prod]
        dsimp only [s_w]
        ring
      have hΓ_orb_rel :
          (∏ i : Fin D_orb.length,
            oddStatGaussFactor F (D_orb.get i).field (μ'_orb i) (k_Fi i) (ψ_0μ i)) =
          (∏ i : Fin D_orb.length, s_w i) *
            (∏ i : Fin D_orb.length,
              oddStatGaussFactor F (D_orb.get i).field (θ_orb i) (k_Fi i) (ψ_0θ i)) := by
        rw [← Finset.prod_mul_distrib]
        apply Finset.prod_congr rfl
        intro i _
        have hb_i : condExp F (D_orb.get i).field (μ'_orb i) % 2 = 1 := by
          rw [hFi_b i]; exact hb_odd
        have hc_i : condExp F (D_orb.get i).field (θ_orb i) % 2 = 1 := by
          rw [hFi_c i]; exact hb_odd
        have hv_θ_val0 : valL F (D_orb.get i).field (v_θ_orb i : (D_orb.get i).field) = 0 :=
          ((hFi_gauss i).2 hc_i).1
        have hv_res_eq :
            (k : k_Fi i) * resFi i (v_μ_orb i : (D_orb.get i).field) =
            resFi i (w_orb i : (D_orb.get i).field) *
              ((k : k_Fi i) * resFi i (v_θ_orb i : (D_orb.get i).field)) := by
          rw [hv_μ_res i hv_θ_val0]
          ring
        have h1 : oddStatGaussFactor F (D_orb.get i).field (μ'_orb i) (k_Fi i) (ψ_0μ i) =
            (((-1 : ℤ) ^ (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k - 1) *
              quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_μ_orb i : (D_orb.get i).field))) : ℤ) : Ω F) *
              ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^
                (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k) :=
          ((hFi_gauss i).1 hb_i).2.2
        have h2 : oddStatGaussFactor F (D_orb.get i).field (θ_orb i) (k_Fi i) (ψ_0θ i) =
            (((-1 : ℤ) ^ (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k - 1) *
              quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_θ_orb i : (D_orb.get i).field))) : ℤ) : Ω F) *
              ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^
                (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k) :=
          ((hFi_gauss i).2 hc_i).2.2
        rw [h1, h2, hv_res_eq, map_mul, map_mul, Int.cast_mul, Int.cast_mul, Int.cast_mul]
        dsimp only [s_w]
        ring
      rw [h_pref_eq, hΓ_E_rel, hΓ_orb_rel]
      linear_combination
        ((qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
          statHalfCondFactor F L ψ χ' *
          (∏ i : Fin D_orb.length,
            statHalfCondFactor F (D_orb.get i).field
              (traceChar F (D_orb.get i).le ψ) (θ_orb i))) ^ (p F) *
        oddStatGaussFactor F L χ' k_L ψ_0L *
        (∏ i : Fin D_orb.length,
          oddStatGaussFactor F (D_orb.get i).field (θ_orb i) (k_Fi i) (ψ_0θ i)) *
        hS_sq

theorem ld_ch14_odd_p_supercrit_orbit_gauss_prod_eval (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    (hLE : L ≤ E)
    (ψ : AddChar L (Ω F))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (q_MCK : ℕ)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      q_MCK - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hq_odd : q_MCK % 2 = 1) (hq_ge3 : 3 ≤ q_MCK)
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k) (hk_even_or1 : k = 1 ∨ 2 ∣ k)
    (hk_dvd : k ∣ (q_MCK - 1))
    (hFi_b : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1)
    (hFi_c : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) =
        k * (condExp F L χ' - 1) + 1)
    (ϖ_L : Lˣ)
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (k_L k_E : Type u) [Field k_L] [Fintype k_L] [Field k_E] [Fintype k_E]
    (resL : L → k_L) (ψ_0L : AddChar k_L (Ω F)) (ψ_0E : AddChar k_E (Ω F))
    (k_Fi : Fin D_orb.length → Type u)
    [∀ i, Field (k_Fi i)] [∀ i, Fintype (k_Fi i)] [∀ i, Algebra k_L (k_Fi i)]
    (resFi : ∀ i : Fin D_orb.length, (D_orb.get i).field → k_Fi i)
    (ϖ_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (ψ_0μ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (ψ_0θ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (G_L : Ω F)
    (hL_gauss :
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
      valL F L (u_χ' : L) = 0 ∧
      resL (u_χ' : L) ≠ 0 ∧
      (condExp F L χ' % 2 = 1 →
        oddStatGaussFactor F L χ' k_L ψ_0L =
          ((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)))
    (hFi_gauss : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      let f_i := Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let v_μ : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_μ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i (μ'_orb i) / 2)))
      let v_θ : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_θ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i θ_i / 2)))
      1 ≤ f_i ∧
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
      qL F F_i = (qL F L) ^ f_i ∧
      Module.finrank k_L (k_Fi i) = f_i ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resFi i (IntermediateField.inclusion (D_orb.get i).le x) =
          algebraMap k_L (k_Fi i) (resL x)) ∧
      (condExp F F_i (μ'_orb i) % 2 = 1 →
        valL F F_i (v_μ : F_i) = 0 ∧
        resFi i (v_μ : F_i) ≠ 0 ∧
        oddStatGaussFactor F F_i (μ'_orb i) (k_Fi i) (ψ_0μ i) =
          (((-1 : ℤ) ^ (f_i - 1) *
            quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_μ : F_i))) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i) ∧
      (condExp F F_i θ_i % 2 = 1 →
        valL F F_i (v_θ : F_i) = 0 ∧
        resFi i (v_θ : F_i) ≠ 0 ∧
        oddStatGaussFactor F F_i θ_i (k_Fi i) (ψ_0θ i) =
          (((-1 : ℤ) ^ (f_i - 1) *
            quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_θ : F_i))) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i))
    (hE_super :
      let a_E := condExp F E (χ'.comp (Units.map (normLM F hLE)))
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
      let u_E_norm : Lˣ :=
        (ϖ_L ^ (a_E - 1))⁻¹ * c₀⁻¹ * c'_χ' *
          (∏ i : Fin D_orb.length,
            Units.map (normLM F (D_orb.get i).le) (c'_θ i * (c'_μ i)⁻¹))
      (a_E % 2 = 1 →
        oddStatGaussFactor F E (χ'.comp (Units.map (normLM F hLE))) k_E ψ_0E =
          ((quadraticChar k_L (resL (u_E_norm : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)) ∧
      resL (u_E_norm : L) =
        (resL (u_χ' : L)) ^ q_MCK *
          resL (((c₀ ^ (q_MCK - 1) * (ϖ_L ^ (((q_MCK - 1) / k) * t)) *
            (∏ i : Fin D_orb.length,
              Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L)))
    (hMaster :
