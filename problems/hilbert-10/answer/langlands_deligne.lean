    omega
  have hu_M₁'_ne0 : u_M₁' ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLM₁')).mpr hu_L_ne0
  have hu_K₁_ne0 : u_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hM₁'K₁)).mpr hu_M₁'_ne0
  have hu_K₁_val : valL F K₁ u_K₁ = ((p * p * m_exp : ℕ) : ℤ) := by
