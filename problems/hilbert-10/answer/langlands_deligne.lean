    rw [hval_inv_L c_νE', hc_νE'_val]
  have hβ_ne0 : β ≠ 0 := mul_ne_zero (mul_ne_zero hα₀_ne0 h2_ne0) htr_x_star_ne0
  have hβ_val : valL F L β = -(condExpChar F L ψ + 1) := by
