        · intro u _ hu
          obtain ⟨r₀, hr₀⟩ : ∃ r₀ : Fin M, u r₀ ≠ 0 := by
            by_contra hall
            push_neg at hall
            exact hu (funext hall)
          apply Finset.prod_eq_zero (Finset.mem_univ r₀)
          exact hψ1_orth ((ℓ : k) * u r₀) (mul_ne_zero hNeChar hr₀)
        · intro habs
          exact False.elim (habs (Finset.mem_univ _))
      simp_rw [hinner_uv, ← Finset.sum_mul, mul_comm _ ((Fintype.card k : Ω F) ^ M)]
  obtain ⟨hφ_prod, hφ_coord⟩ := hs3
  have hpow_sum : (∑ x : k, φ_L x) ^ ℓ = ∑ x : Fin ℓ → k, ∏ j : Fin ℓ, φ_L (x j) := by
    calc (∑ x : k, φ_L x) ^ ℓ
        = ∏ _j : Fin ℓ, (∑ x : k, φ_L x) := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ = ∑ x : Fin ℓ → k, ∏ j : Fin ℓ, φ_L (x j) :=
          Fintype.prod_sum (fun (_ : Fin ℓ) (x : k) => φ_L x)
  have hbij_V : (∑ x : Fin ℓ → k, ∏ j : Fin ℓ, φ_L (x j)) =
      ∑ y : Fin ℓ → k, ∏ j : Fin ℓ, φ_L (V y j) := by
    refine Finset.sum_bij' (fun x _ => V_inv x) (fun y _ => V y)
      (fun _ _ => Finset.mem_univ _) (fun _ _ => Finset.mem_univ _)
      (fun x _ => hV_right x) (fun y _ => hV_left y) ?_
    intro x _
    dsimp only
    rw [hV_right x]
  have hterm_V : ∀ y : Fin ℓ → k,
      (∏ j : Fin ℓ, φ_L (V y j)) =
        (φ_L (y ⟨0, hPrime.pos⟩)) ^ ℓ *
          ψ_1 (∑ r : Fin ((ℓ - 1) / 2),
            (ℓ : k) *
              y ⟨(r.1 + 1) % ℓ, Nat.mod_lt _ hPrime.pos⟩ *
              y ⟨(ℓ - 1 - r.1) % ℓ, Nat.mod_lt _ hPrime.pos⟩) := by
    intro y
    have h1 : (∏ j : Fin ℓ, φ_L (V y j)) = ∏ j : Fin ℓ, φ_L (y ⟨0, hPrime.pos⟩ + z y j.1) :=
      Finset.prod_congr rfl fun j _ => by rw [hV_decomp y j]
    rw [h1, hφ_prod (y ⟨0, hPrime.pos⟩) (z y) (hz_sum y), hz_quad y]
  rw [hpow_sum, hbij_V]
  simp_rw [hterm_V]
  exact hφ_coord

theorem ld_finite_field_deg_two_quadratic_gauss_and_hasse (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (hNe2 : (2 : k) ≠ 0)
    (ν_tilde ψ_1 : k → Ω F)
    (hν_0 : ν_tilde 0 = 0)
    (hν_1 : ν_tilde 1 = 1)
    (hν_mul : ∀ a b : k, ν_tilde (a * b) = ν_tilde a * ν_tilde b)
    (hν_pow : ∀ a : k, a ≠ 0 → (ν_tilde a) ^ 2 = 1)
    (hν_ne : ∃ a₀ : k, a₀ ≠ 0 ∧ ν_tilde a₀ ≠ 1)
    (hψ1_0 : ψ_1 0 = 1)
    (hψ1_add : ∀ x y : k, ψ_1 (x + y) = ψ_1 x * ψ_1 y)
    (hψ1_ne : ∃ x₀ : k, ψ_1 x₀ ≠ 1) :
    (∑ a : k, ν_tilde a * ψ_1 a) = (∑ x : k, ψ_1 (x ^ 2)) ∧
    (∑ x : k, ψ_1 (x ^ 2)) * (∑ a : k, ν_tilde a * ψ_1 a) =
      ν_tilde (-1) * (Fintype.card k : Ω F) ∧
    (∀ (φ_L : k → Ω F),
      φ_L 0 = 1 →
      (∀ x y : k, φ_L (x + y) = φ_L x * φ_L y * ψ_1 (x * y)) →
      (∑ x : k, φ_L x) ^ 2 =
        (∑ u : k, (φ_L u) ^ 2) * (∑ a : k, ν_tilde a * ψ_1 a)) :=
by
  suffices h_gen : ∀ (R : Type) [Field R]
      (ν_tilde ψ_1 : k → R)
      (hν_0 : ν_tilde 0 = 0)
      (hν_1 : ν_tilde 1 = 1)
      (hν_mul : ∀ a b : k, ν_tilde (a * b) = ν_tilde a * ν_tilde b)
      (hν_pow : ∀ a : k, a ≠ 0 → (ν_tilde a) ^ 2 = 1)
      (hν_ne : ∃ a₀ : k, a₀ ≠ 0 ∧ ν_tilde a₀ ≠ 1)
      (hψ1_0 : ψ_1 0 = 1)
      (hψ1_add : ∀ x y : k, ψ_1 (x + y) = ψ_1 x * ψ_1 y)
      (hψ1_ne : ∃ x₀ : k, ψ_1 x₀ ≠ 1),
      (∑ a : k, ν_tilde a * ψ_1 a) = (∑ x : k, ψ_1 (x ^ 2)) ∧
      (∑ x : k, ψ_1 (x ^ 2)) * (∑ a : k, ν_tilde a * ψ_1 a) =
        ν_tilde (-1) * (Fintype.card k : R) ∧
      (∀ (φ_L : k → R),
        φ_L 0 = 1 →
        (∀ x y : k, φ_L (x + y) = φ_L x * φ_L y * ψ_1 (x * y)) →
        (∑ x : k, φ_L x) ^ 2 =
          (∑ u : k, (φ_L u) ^ 2) * (∑ a : k, ν_tilde a * ψ_1 a)) by
    exact h_gen (Ω F) ν_tilde ψ_1 hν_0 hν_1 hν_mul hν_pow hν_ne hψ1_0 hψ1_add hψ1_ne
  clear * - hNe2
  intro R _ ν_tilde ψ_1 hν_0 hν_1 hν_mul hν_pow hν_ne hψ1_0 hψ1_add hψ1_ne
  have hν_pm1 : ∀ a : k, a ≠ 0 → (ν_tilde a = 1 ∨ ν_tilde a = -1) := by
    intro a ha
    exact sq_eq_one_iff.mp (hν_pow a ha)
  obtain ⟨x₀, hψ1_x₀⟩ := hψ1_ne
  have hψ1_orth : ∀ c : k, (∑ b : k, ψ_1 (c * b)) = if c = 0 then (Fintype.card k : R) else 0 := by
    intro c
    by_cases hc : c = 0
    · simp [hc, hψ1_0]
    · rw [if_neg hc]
      have hshift : (∑ b : k, ψ_1 (c * b)) = ∑ b : k, ψ_1 (c * (b + c⁻¹ * x₀)) := by
        exact (Fintype.sum_equiv (Equiv.addRight (c⁻¹ * x₀))
          (fun b => ψ_1 (c * (b + c⁻¹ * x₀)))
          (fun b => ψ_1 (c * b))
          (fun b => rfl)).symm
      have hterm : ∀ b : k, ψ_1 (c * (b + c⁻¹ * x₀)) = ψ_1 (c * b) * ψ_1 x₀ := by
        intro b
        have hcb : c * (b + c⁻¹ * x₀) = c * b + x₀ := by
          rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hc, one_mul]
        rw [hcb, hψ1_add]
      have hmul : (∑ b : k, ψ_1 (c * b)) = (∑ b : k, ψ_1 (c * b)) * ψ_1 x₀ := by
        calc (∑ b : k, ψ_1 (c * b))
            = ∑ b : k, ψ_1 (c * (b + c⁻¹ * x₀)) := hshift
          _ = ∑ b : k, (ψ_1 (c * b) * ψ_1 x₀) := Finset.sum_congr rfl (fun b _ => hterm b)
          _ = (∑ b : k, ψ_1 (c * b)) * ψ_1 x₀ := (Finset.sum_mul _ _ _).symm
      have hsub : (∑ b : k, ψ_1 (c * b)) * (ψ_1 x₀ - 1) = 0 := by
        linear_combination -hmul
      exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hψ1_x₀)
  have hψ1_sum : (∑ a : k, ψ_1 a) = 0 := by
    have h1 := hψ1_orth 1
    simp only [one_mul, one_ne_zero, ↓reduceIte] at h1
    exact h1
  obtain ⟨a₀, ha₀, hν_a₀⟩ := hν_ne
  have hν_sum : (∑ u : k, ν_tilde u) = 0 := by
    have hshift : (∑ u : k, ν_tilde u) = ∑ u : k, ν_tilde (u * a₀) := by
      exact (Fintype.sum_equiv (Equiv.mulRight₀ a₀ ha₀)
        (fun u => ν_tilde (u * a₀)) (fun u => ν_tilde u) (fun u => rfl)).symm
    have hmul : (∑ u : k, ν_tilde u) = (∑ u : k, ν_tilde u) * ν_tilde a₀ := by
      calc (∑ u : k, ν_tilde u)
          = ∑ u : k, ν_tilde (u * a₀) := hshift
        _ = ∑ u : k, (ν_tilde u * ν_tilde a₀) := Finset.sum_congr rfl (fun u _ => hν_mul u a₀)
        _ = (∑ u : k, ν_tilde u) * ν_tilde a₀ := (Finset.sum_mul _ _ _).symm
    have hsub : (∑ u : k, ν_tilde u) * (ν_tilde a₀ - 1) = 0 := by
      linear_combination -hmul
    exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hν_a₀)
  set S₀ : Finset k := Finset.univ.erase 0
  set Q : Finset k := S₀.image (fun x : k => x ^ 2)
  set S_pos : Finset k := S₀.filter (fun a : k => ν_tilde a = 1)
  set S_neg : Finset k := S₀.filter (fun a : k => ¬ ν_tilde a = 1)
  have hQ_sub : Q ⊆ S_pos := by
    intro a ha
    rw [Finset.mem_image] at ha
    rcases ha with ⟨x, hx, rfl⟩
    have hx0 : x ≠ 0 := Finset.ne_of_mem_erase hx
    rw [Finset.mem_filter, Finset.mem_erase]
    refine ⟨⟨pow_ne_zero 2 hx0, Finset.mem_univ _⟩, ?_⟩
    rw [sq, hν_mul, ← sq, hν_pow x hx0]
  have hne_neg : ∀ x : k, x ≠ 0 → x ≠ -x := by
    intro x hx h_eq
    have h2x : (2 : k) * x = 0 := by
      calc (2 : k) * x = x + x := two_mul x
        _ = x + (-x) := by conv_rhs => rw [← h_eq]
        _ = 0 := add_neg_cancel x
    exact mul_ne_zero hNe2 hx h2x
  have hfiber_univ : ∀ x₀ : k, x₀ ≠ 0 →
      Finset.univ.filter (fun x : k => x ^ 2 = x₀ ^ 2) = {x₀, -x₀} := by
    intro x₀ _
    ext x
    simp [sq_eq_sq_iff_eq_or_eq_neg]
  have hfiber_S₀ : ∀ x₀ : k, x₀ ≠ 0 →
      S₀.filter (fun x : k => x ^ 2 = x₀ ^ 2) = {x₀, -x₀} := by
    intro x₀ hx₀
    ext x
    simp only [S₀, Finset.mem_filter, Finset.mem_erase, Finset.mem_univ, and_true,
      sq_eq_sq_iff_eq_or_eq_neg, Finset.mem_insert, Finset.mem_singleton]
    constructor
    · exact fun h => h.2
    · rintro (rfl | rfl)
      · exact ⟨hx₀, Or.inl rfl⟩
      · exact ⟨neg_ne_zero.mpr hx₀, Or.inr rfl⟩
  have hcard_Q : S₀.card = 2 * Q.card := by
    have hmaps : Set.MapsTo (fun x : k => x ^ 2) (S₀ : Set k) (Q : Set k) := by
      intro x hx
      exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx))
    have hsum := Finset.card_eq_sum_card_fiberwise hmaps
    have hterm : ∀ a ∈ Q, (S₀.filter (fun x : k => x ^ 2 = a)).card = 2 := by
      intro a ha
      rw [Finset.mem_image] at ha
      rcases ha with ⟨x₀, hx₀, rfl⟩
      have hx₀_ne : x₀ ≠ 0 := Finset.ne_of_mem_erase hx₀
      rw [hfiber_S₀ x₀ hx₀_ne]
      exact Finset.card_pair (hne_neg x₀ hx₀_ne)
    rw [hsum, Finset.sum_congr rfl hterm, Finset.sum_const, smul_eq_mul, mul_comm]
  have hν_a₀_eq : ν_tilde a₀ = -1 := (hν_pm1 a₀ ha₀).resolve_left hν_a₀
  have hν_a₀_inv : ν_tilde a₀⁻¹ = -1 := by
    have h1 : ν_tilde a₀ * ν_tilde a₀⁻¹ = 1 := by
      rw [← hν_mul, mul_inv_cancel₀ ha₀, hν_1]
    rw [hν_a₀_eq] at h1
    linear_combination -h1
  have hcard_pos_neg : S_pos.card = S_neg.card := by
    apply Finset.card_bij' (fun a _ => a₀ * a) (fun b _ => a₀⁻¹ * b)
    · intro a ha
      rw [Finset.mem_filter, Finset.mem_erase] at ha ⊢
      refine ⟨⟨mul_ne_zero ha₀ ha.1.1, Finset.mem_univ _⟩, ?_⟩
      rw [hν_mul, ha.2, mul_one]
      exact hν_a₀
    · intro b hb
      rw [Finset.mem_filter, Finset.mem_erase] at hb ⊢
      have hb_eq : ν_tilde b = -1 := (hν_pm1 b hb.1.1).resolve_left hb.2
      refine ⟨⟨mul_ne_zero (inv_ne_zero ha₀) hb.1.1, Finset.mem_univ _⟩, ?_⟩
      rw [hν_mul, hν_a₀_inv, hb_eq]
      ring
    · intro a _
      exact inv_mul_cancel_left₀ ha₀ a
    · intro b _
      exact mul_inv_cancel_left₀ ha₀ b
  have hcard_S₀_pos : S₀.card = 2 * S_pos.card := by
    have hpart := Finset.card_filter_add_card_filter_not (s := S₀) (fun a : k => ν_tilde a = 1)
    change S_pos.card + S_neg.card = S₀.card at hpart
    omega
  have hQ_eq : Q = S_pos := by
    apply Finset.eq_of_subset_of_card_le hQ_sub
    omega
  have hfiber_card : ∀ a : k,
      ((Finset.univ.filter (fun x : k => x ^ 2 = a)).card : R) = 1 + ν_tilde a := by
    intro a
    by_cases ha0 : a = 0
    · subst ha0
      have h0 : Finset.univ.filter (fun x : k => x ^ 2 = 0) = {0} := by
        ext x
        simp
      rw [h0, Finset.card_singleton, Nat.cast_one, hν_0, add_zero]
    · by_cases hνa : ν_tilde a = 1
      · have ha_pos : a ∈ S_pos := by
          rw [Finset.mem_filter, Finset.mem_erase]
          exact ⟨⟨ha0, Finset.mem_univ _⟩, hνa⟩
        rw [← hQ_eq, Finset.mem_image] at ha_pos
        rcases ha_pos with ⟨x₀, hx₀, rfl⟩
        have hx₀_ne : x₀ ≠ 0 := Finset.ne_of_mem_erase hx₀
        rw [hfiber_univ x₀ hx₀_ne, Finset.card_pair (hne_neg x₀ hx₀_ne), hνa]
        norm_num
      · have ha_not_Q : a ∉ Q := by
          rw [hQ_eq, Finset.mem_filter]
          exact fun h => hνa h.2
        have hempty : Finset.univ.filter (fun x : k => x ^ 2 = a) = ∅ := by
          rw [Finset.filter_eq_empty_iff]
          intro x _ hx_sq
          apply ha_not_Q
          rw [Finset.mem_image]
          refine ⟨x, ?_, hx_sq⟩
          rw [Finset.mem_erase]
          refine ⟨?_, Finset.mem_univ _⟩
          intro hx0
          apply ha0
          rw [← hx_sq, hx0, sq, mul_zero]
        have hνa_neg1 : ν_tilde a = -1 := (hν_pm1 a ha0).resolve_left hνa
        rw [hempty, Finset.card_empty, Nat.cast_zero, hνa_neg1, add_neg_cancel]
  have hConj1 : (∑ a : k, ν_tilde a * ψ_1 a) = (∑ x : k, ψ_1 (x ^ 2)) := by
    have hfib := Finset.sum_fiberwise_of_maps_to
      (s := Finset.univ) (t := Finset.univ) (g := fun x : k => x ^ 2)
      (fun x _ => Finset.mem_univ _) (fun x : k => ψ_1 (x ^ 2))
    have hinner : ∀ a : k,
        (∑ x ∈ Finset.univ.filter (fun x : k => x ^ 2 = a), ψ_1 (x ^ 2)) =
          ψ_1 a + ν_tilde a * ψ_1 a := by
      intro a
      have hcongr :
          (∑ x ∈ Finset.univ.filter (fun x : k => x ^ 2 = a), ψ_1 (x ^ 2)) =
            ∑ x ∈ Finset.univ.filter (fun x : k => x ^ 2 = a), ψ_1 a := by
        refine Finset.sum_congr rfl (fun x hx => ?_)
        rw [(Finset.mem_filter.mp hx).2]
      rw [hcongr, Finset.sum_const, nsmul_eq_mul, hfiber_card a, add_mul, one_mul]
    calc (∑ a : k, ν_tilde a * ψ_1 a)
        = (∑ a : k, ψ_1 a) + (∑ a : k, ν_tilde a * ψ_1 a) := by rw [hψ1_sum, zero_add]
      _ = ∑ a : k, (ψ_1 a + ν_tilde a * ψ_1 a) := (Finset.sum_add_distrib).symm
      _ = ∑ a : k, ∑ x ∈ Finset.univ.filter (fun x : k => x ^ 2 = a), ψ_1 (x ^ 2) :=
          Finset.sum_congr rfl (fun a _ => (hinner a).symm)
      _ = ∑ x : k, ψ_1 (x ^ 2) := hfib
  have hConj2 :
      (∑ x : k, ψ_1 (x ^ 2)) * (∑ a : k, ν_tilde a * ψ_1 a) =
        ν_tilde (-1) * (Fintype.card k : R) := by
    set G : R := ∑ a : k, ν_tilde a * ψ_1 a
    rw [← hConj1]
    have hG_S₀ : G = ∑ b ∈ S₀, ν_tilde b * ψ_1 b := by
      have her := Finset.add_sum_erase Finset.univ (fun b : k => ν_tilde b * ψ_1 b) (Finset.mem_univ 0)
      dsimp only at her
      rw [hν_0, zero_mul, zero_add] at her
      exact her.symm
    have hGG_b : ∀ b ∈ S₀,
        G * (ν_tilde b * ψ_1 b) = ∑ u : k, ν_tilde u * ψ_1 ((u + 1) * b) := by
      intro b hb
      have hb0 : b ≠ 0 := Finset.ne_of_mem_erase hb
      have hG_reindex : G = ∑ u : k, ν_tilde (u * b) * ψ_1 (u * b) := by
        exact (Fintype.sum_equiv (Equiv.mulRight₀ b hb0)
          (fun u => ν_tilde (u * b) * ψ_1 (u * b))
          (fun a => ν_tilde a * ψ_1 a) (fun u => rfl)).symm
      rw [hG_reindex, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun u _ => ?_)
      have hν_ub : ν_tilde (u * b) * ν_tilde b = ν_tilde u := by
        calc ν_tilde (u * b) * ν_tilde b
            = ν_tilde u * (ν_tilde b) ^ 2 := by rw [hν_mul, sq]; ring
          _ = ν_tilde u := by rw [hν_pow b hb0, mul_one]
      have hψ_ub : ψ_1 (u * b) * ψ_1 b = ψ_1 ((u + 1) * b) := by
        rw [← hψ1_add, add_one_mul]
      calc (ν_tilde (u * b) * ψ_1 (u * b)) * (ν_tilde b * ψ_1 b)
          = (ν_tilde (u * b) * ν_tilde b) * (ψ_1 (u * b) * ψ_1 b) := by ring
        _ = ν_tilde u * ψ_1 ((u + 1) * b) := by rw [hν_ub, hψ_ub]
    have hGG_comm :
        G * G = ∑ u : k, ν_tilde u * (∑ b ∈ S₀, ψ_1 ((u + 1) * b)) := by
      calc G * G
          = G * (∑ b ∈ S₀, ν_tilde b * ψ_1 b) := congrArg (G * ·) hG_S₀
        _ = ∑ b ∈ S₀, G * (ν_tilde b * ψ_1 b) := Finset.mul_sum _ _ _
        _ = ∑ b ∈ S₀, ∑ u : k, ν_tilde u * ψ_1 ((u + 1) * b) :=
            Finset.sum_congr rfl hGG_b
        _ = ∑ u : k, ∑ b ∈ S₀, ν_tilde u * ψ_1 ((u + 1) * b) := Finset.sum_comm
        _ = ∑ u : k, ν_tilde u * (∑ b ∈ S₀, ψ_1 ((u + 1) * b)) :=
            Finset.sum_congr rfl (fun u _ => (Finset.mul_sum _ _ _).symm)
    have hinner_S₀ : ∀ u : k,
        ν_tilde u * (∑ b ∈ S₀, ψ_1 ((u + 1) * b)) =
          ν_tilde u * (∑ b : k, ψ_1 ((u + 1) * b)) - ν_tilde u := by
      intro u
      have her := Finset.add_sum_erase Finset.univ (fun b : k => ψ_1 ((u + 1) * b)) (Finset.mem_univ 0)
      dsimp only at her
      rw [mul_zero, hψ1_0] at her
      have hsub : (∑ b ∈ S₀, ψ_1 ((u + 1) * b)) = (∑ b : k, ψ_1 ((u + 1) * b)) - 1 := by
        rw [← her, add_sub_cancel_left]
      rw [hsub, mul_sub, mul_one]
    have hGG_univ :
        G * G = ∑ u : k, ν_tilde u * (∑ b : k, ψ_1 ((u + 1) * b)) := by
      rw [hGG_comm, Finset.sum_congr rfl (fun u _ => hinner_S₀ u),
        Finset.sum_sub_distrib, hν_sum, sub_zero]
    rw [hGG_univ]
    rw [← Finset.add_sum_erase Finset.univ
      (fun u : k => ν_tilde u * (∑ b : k, ψ_1 ((u + 1) * b))) (Finset.mem_univ (-1 : k))]
    have h_neg1 :
        ν_tilde (-1) * (∑ b : k, ψ_1 ((-1 + 1) * b)) = ν_tilde (-1) * (Fintype.card k : R) := by
      rw [neg_add_cancel, hψ1_orth 0, if_pos rfl]
    have h_rest :
        (∑ u ∈ Finset.univ.erase (-1 : k), ν_tilde u * (∑ b : k, ψ_1 ((u + 1) * b))) = 0 := by
      refine Finset.sum_eq_zero (fun u hu => ?_)
      have hu_ne : u ≠ -1 := Finset.ne_of_mem_erase hu
      have hu1_ne : u + 1 ≠ 0 := fun h => hu_ne (add_eq_zero_iff_eq_neg.mp h)
      rw [hψ1_orth (u + 1), if_neg hu1_ne, mul_zero]
    rw [h_neg1, h_rest, add_zero]
  refine ⟨hConj1, hConj2, ?_⟩
  intro φ_L _ hφ_add
  have hφ_uv : ∀ u v : k, φ_L (u + v) * φ_L (u - v) = (φ_L u) ^ 2 * ψ_1 (v ^ 2) := by
    intro u v
    have h1 : φ_L ((u + v) + (u - v)) =
        φ_L (u + v) * φ_L (u - v) * ψ_1 (u ^ 2 - v ^ 2) := by
      rw [hφ_add (u + v) (u - v)]
      congr 2
      ring
    have h2 : φ_L ((u + v) + (u - v)) = (φ_L u) ^ 2 * ψ_1 (u ^ 2) := by
      have huv : (u + v) + (u - v) = u + u := by ring
      rw [huv, hφ_add u u, sq, sq]
    have h3 : φ_L (u + v) * φ_L (u - v) * ψ_1 (u ^ 2 - v ^ 2) =
        (φ_L u) ^ 2 * ψ_1 (u ^ 2) := h1.symm.trans h2
    have h4 := congrArg (· * ψ_1 (v ^ 2 - u ^ 2)) h3
    dsimp only at h4
    have hL : φ_L (u + v) * φ_L (u - v) * ψ_1 (u ^ 2 - v ^ 2) * ψ_1 (v ^ 2 - u ^ 2) =
        φ_L (u + v) * φ_L (u - v) := by
      rw [mul_assoc (φ_L (u + v) * φ_L (u - v)), ← hψ1_add]
      have h0 : (u ^ 2 - v ^ 2) + (v ^ 2 - u ^ 2) = 0 := by ring
      rw [h0, hψ1_0, mul_one]
    have hR : (φ_L u) ^ 2 * ψ_1 (u ^ 2) * ψ_1 (v ^ 2 - u ^ 2) =
        (φ_L u) ^ 2 * ψ_1 (v ^ 2) := by
      rw [mul_assoc ((φ_L u) ^ 2), ← hψ1_add]
      have hv : u ^ 2 + (v ^ 2 - u ^ 2) = v ^ 2 := by ring
      rw [hv]
    exact hL.symm.trans (h4.trans hR)
  let e : k × k ≃ k × k :=
    { toFun := fun p => (p.1 + p.2, p.1 - p.2)
      invFun := fun q => ((2 : k)⁻¹ * (q.1 + q.2), (2 : k)⁻¹ * (q.1 - q.2))
      left_inv := by
        rintro ⟨u, v⟩
        ext <;> dsimp only
        · have h : u + v + (u - v) = (2 : k) * u := by ring
          rw [h, ← mul_assoc, inv_mul_cancel₀ hNe2, one_mul]
        · have h : u + v - (u - v) = (2 : k) * v := by ring
          rw [h, ← mul_assoc, inv_mul_cancel₀ hNe2, one_mul]
      right_inv := by
        rintro ⟨x, y⟩
        ext <;> dsimp only
        · have h : (2 : k)⁻¹ * (x + y) + (2 : k)⁻¹ * (x - y) = ((2 : k) * (2 : k)⁻¹) * x := by ring
          rw [h, mul_inv_cancel₀ hNe2, one_mul]
        · have h : (2 : k)⁻¹ * (x + y) - (2 : k)⁻¹ * (x - y) = ((2 : k) * (2 : k)⁻¹) * y := by ring
          rw [h, mul_inv_cancel₀ hNe2, one_mul] }
  have hsum_e :
      (∑ p : k × k, φ_L (p.1 + p.2) * φ_L (p.1 - p.2)) =
        ∑ q : k × k, φ_L q.1 * φ_L q.2 := by
    exact Fintype.sum_equiv e
      (fun p : k × k => φ_L (p.1 + p.2) * φ_L (p.1 - p.2))
      (fun q : k × k => φ_L q.1 * φ_L q.2)
      (fun p => rfl)
  calc (∑ x : k, φ_L x) ^ 2
      = (∑ x : k, φ_L x) * (∑ y : k, φ_L y) := sq _
    _ = ∑ x : k, ∑ y : k, φ_L x * φ_L y := Finset.sum_mul_sum _ _ _ _
    _ = ∑ q : k × k, φ_L q.1 * φ_L q.2 :=
        (Fintype.sum_prod_type (fun q : k × k => φ_L q.1 * φ_L q.2)).symm
    _ = ∑ p : k × k, φ_L (p.1 + p.2) * φ_L (p.1 - p.2) := hsum_e.symm
    _ = ∑ u : k, ∑ v : k, φ_L (u + v) * φ_L (u - v) :=
        Fintype.sum_prod_type (fun p : k × k => φ_L (p.1 + p.2) * φ_L (p.1 - p.2))
    _ = ∑ u : k, ∑ v : k, (φ_L u) ^ 2 * ψ_1 (v ^ 2) :=
        Finset.sum_congr rfl (fun u _ => Finset.sum_congr rfl (fun v _ => hφ_uv u v))
    _ = (∑ u : k, (φ_L u) ^ 2) * (∑ v : k, ψ_1 (v ^ 2)) := (Finset.sum_mul_sum _ _ _ _).symm
    _ = (∑ u : k, (φ_L u) ^ 2) * (∑ a : k, ν_tilde a * ψ_1 a) := by rw [hConj1]

theorem ld_tame_fml_higher_conductor (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_triv1 : ∀ u ∈ unitGroup F L 1, ν₁ u = 1)
    (hν₁_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      j ≠ 0 → condExp F L (ν₁ ^ j) = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hNeP : Module.finrank L (IntermediateField.extendScalars hLK) ≠ p F)
    (hResDeg : resDeg F K = resDeg F L)
    (hValNorm : ∀ y : K, valL F K y = valL F L (normLM F hLK y))
    (hValAlg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hCondψK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) = 1)
    (hν₁_ϖ : ν₁ (Units.map (normLM F hLK) ϖ_K) = 1)
    (hϖ_deg2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2 →
      traceLM F hLK (ϖ_K : K) = 0 ∧
      (ϖ_K : K) ^ 2 = - IntermediateField.inclusion hLK ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L))
    (hResSurj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)))
    (hTraceBound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
        ((Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) - 1) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hNormRem : ∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
      normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        2 * valL F K y ≤
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
            valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)))
    (ha2 : 2 ≤ condExp F L χ')
    (hCondTwist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L (ν₁ ^ j * χ') = condExp F L χ')
    (hCondχ'K : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      Module.finrank L (IntermediateField.extendScalars hLK) * (condExp F L χ' - 1) + 1)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0)))) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  have halg_deg2_even : ∀ (QK QL C W X P S1 S2 V : Ω F) (d D : ℕ),
      (C ^ d) ^ 2 = C ^ D * C →
      S1 * S2 = V * C →
      V ^ 2 = 1 →
      (QK * C ^ D * X ^ 2 * P ^ 2 * S1) * (QL ^ 2 * W * V * S2) =
        QK * (W * (QL * C ^ d * X * P) ^ 2) := by
    clear * -
    intro QK QL C W X P S1 S2 V d D hC hS hV
    calc (QK * C ^ D * X ^ 2 * P ^ 2 * S1) * (QL ^ 2 * W * V * S2)
        = QK * C ^ D * X ^ 2 * P ^ 2 * (QL ^ 2 * W * V) * (S1 * S2) := by ring
      _ = QK * C ^ D * X ^ 2 * P ^ 2 * (QL ^ 2 * W * V) * (V * C) := by rw [hS]
      _ = QK * (W * (QL ^ 2 * (C ^ D * C) * X ^ 2 * P ^ 2)) * V ^ 2 := by ring
      _ = QK * (W * (QL * C ^ d * X * P) ^ 2) := by
          rw [hV, mul_one, ← hC]
          ring
  have halg_deg2_odd : ∀ (QK QL C W X P S1 S2 G : Ω F) (d D : ℕ),
      (C ^ d) ^ 2 = C ^ D →
      S1 ^ 2 = S2 * G →
      (QK * C ^ D * X ^ 2 * P ^ 2 * S2) * (QL ^ 2 * W * G) =
        QK * (W * (QL * C ^ d * X * P * S1) ^ 2) := by
    clear * -
    intro QK QL C W X P S1 S2 G d D hC hS
    calc (QK * C ^ D * X ^ 2 * P ^ 2 * S2) * (QL ^ 2 * W * G)
        = QK * W * QL ^ 2 * C ^ D * X ^ 2 * P ^ 2 * (S2 * G) := by ring
      _ = QK * W * QL ^ 2 * (C ^ d) ^ 2 * X ^ 2 * P ^ 2 * S1 ^ 2 := by rw [← hS, hC]
      _ = QK * (W * (QL * C ^ d * X * P * S1) ^ 2) := by ring
  have halg_odd_even : ∀ (QK QL C X P : Ω F) (ℓ d D M : ℕ),
      (C ^ d) ^ ℓ = C ^ D * C ^ M →
      (QK * C ^ D * X ^ ℓ * P ^ ℓ) * (QL ^ ℓ * C ^ M) =
        QK * (QL * C ^ d * X * P) ^ ℓ := by
    clear * -
    intro QK QL C X P ℓ d D M hC
    rw [mul_pow, mul_pow, mul_pow, hC]
    ring
  have halg_odd_odd : ∀ (QK QL C X P S1 S2 : Ω F) (ℓ d D M : ℕ),
      (C ^ d) ^ ℓ = C ^ D →
      S1 ^ ℓ = C ^ M * S2 →
      (QK * C ^ D * X ^ ℓ * P ^ ℓ * S2) * (QL ^ ℓ * C ^ M) =
        QK * (QL * C ^ d * X * P * S1) ^ ℓ := by
    clear * -
    intro QK QL C X P S1 S2 ℓ d D M hC hS
    rw [mul_pow, mul_pow, mul_pow, mul_pow, hC, hS]
    ring
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalK := ld_valL_and_unitGroup_props F K
  obtain ⟨hadd1, hadd_neg, hadd_mul, hadd_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L hvalL.1 hvalL.2.2.2.1 hvalL.2.2.2.2.1
    hvalL.2.2.2.2.2.2.2.1 hadd1 hadd_neg hadd_mul hadd_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hvalL.1 hvalL.2.1 hvalL.2.2.1 hvalL.2.2.2.1
      hvalL.2.2.2.2.1 hvalL.2.2.2.2.2.1 hvalL.2.2.2.2.2.2.2.1 S₁ hS₁
  obtain ⟨c_χ', hc_val, hc_stat⟩ := (hStat L ψ hψ χ' ha2).1
  have hχ'_cond0 : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1 := by
    intro u hu
    have hu' : u ∈ unitGroup F L (condExp F L (ν₁ ^ 0 * χ')) := by
      rwa [hCondTwist 0 hPrime.pos]
    have h0 := hχ'_cond 0 hPrime.pos u hu'
    rwa [MonoidHom.mul_apply, MonoidHom.pow_apply, pow_zero, one_mul] at h0
  obtain ⟨heps_K1, heps_L0, hν_triv_d, liftL, R_L, R_K, c_K,
    hliftL, hRL_int, hRL_dist, hRL_mod, hRL_card, hRL_sum,
    hRK_int, hRK_dist, hRK_mod, hRK_card, hRK_sum,
    hc_K_inv, hA2, hcK_val, hcK_stat, hcK_χ, hcK_ψ⟩ :=
    ld_tame_higher_cond_stationary_transfer_and_rep_finset F L K hLK hPrime ψ ν₁ χ'
      hν₁_triv1 hχ'_cond0 hValAlg hCondψK hResSurj hTraceBound hNormRem ha2 hCondχ'K
      hvalL hvalK k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      c_χ' hc_val hc_stat
  have hStatL := (hStat L ψ hψ χ' ha2).2 c_χ' hc_val hc_stat
  have hStatK := (hStat K (traceChar F hLK ψ) hψK (χ'.comp (Units.map (normLM F hLK))) hA2).2
    c_K hcK_val hcK_stat
  have htwist_prod :
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) =
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          (ν₁ c_χ' : Ω F) ^ j) *
          (tateEps F L χ' ψ) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) := by
    have hterm : ∀ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ = (ν₁ c_χ' : Ω F) ^ j * tateEps F L χ' ψ := by
      intro j _
      have h := (hStatL.1 (ν₁ ^ j) (hν_triv_d j)).2
      rw [h, MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
    rw [Finset.prod_congr rfl hterm, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range]
  have hSpecL_full := ld_condExp_and_condExpChar_spec F L ψ hψ ν₁
  have hSpecK_full := ld_condExp_and_condExpChar_spec F K (traceChar F hLK ψ) hψK 1
  have hGauss1 : ∀ (j : ℕ), j < Module.finrank L (IntermediateField.extendScalars hLK) → j ≠ 0 →
      ∀ (c_M : Lˣ), valL F L (c_M : L) = 1 + condExpChar F L ψ →
      ∀ (χ_tilde ψ_tilde : k_L → Ω F),
        χ_tilde 0 = 0 →
        (∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde (resL (u : L)) = ((ν₁ ^ j) u : Ω F)⁻¹) →
        (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
          ψ_tilde (resL x) = ψ (((c_M⁻¹ : Lˣ) : L) * x)) →
        tateEps F L (ν₁ ^ j) ψ =
          (qL F L : Ω F) ^ condExpChar F L ψ * ((ν₁ ^ j) c_M : Ω F) *
            (∑ a_k : k_L, χ_tilde a_k * ψ_tilde a_k) := by
    intro j hj hj0 c_M hc_M χ_tilde ψ_tilde hχ0 hχu hψi
    have hcond_j : condExp F L (ν₁ ^ j) = 1 := hν₁_cond_eq j hj hj0
    have htate_j := (ld_condExp_and_condExpChar_spec F L ψ hψ (ν₁ ^ j)).2.2.2
    have hFin_j : Set.Finite {u : Lˣ ⧸ unitGroup F L (condExp F L (ν₁ ^ j)) |
        valL F L ((cosetRep u : Lˣ) : L) = 0} := by
      rw [hcond_j]
      exact ld_unitCoset_finite F L 1 le_rfl
    exact ld_cond_one_tateEps_eq_residue_gauss_sum F L ψ (ν₁ ^ j) hcond_j htate_j hFin_j
      ⟨hvalL.1, hvalL.2.1, hvalL.2.2.1, hvalL.2.2.2.1, hvalL.2.2.2.2.1,
       hvalL.2.2.2.2.2.1, hvalL.2.2.2.2.2.2.2.1, hvalL.2.2.2.2.2.2.2.2.2.1,
       hvalL.2.2.2.2.2.2.2.2.2.2⟩
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj c_M hc_M χ_tilde ψ_tilde hχ0 hχu hψi
  obtain ⟨hNeChar, ν_tilde, ψ_1, hν_0, hν_1, hν_mul, hν_pow, hν_ne,
    hψ1_0, hψ1_add, hψ1_ne, hprod_odd, hprod_deg2, hHasse_odd, hK_deg2_even⟩ :=
    ld_tame_higher_cond_residue_chars_and_hasse_phases F L K hLK hPrime ψ ν₁ χ'
      hν₁_pow hν₁_ne hν₁_triv1 hν₁_cond_eq hχ'_cond0 hValAlg hCondψK
      ϖ_K hϖ_K hϖ_L hν₁_ϖ hϖ_deg2 hResSurj ha2 hCondχ'K
      hvalL hvalK
      ⟨hSpecL_full.1, hSpecL_full.2.1, hSpecL_full.2.2.1⟩
      ⟨hSpecK_full.1, hSpecK_full.2.1⟩
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hGauss1 heps_L0 liftL R_L R_K hliftL hRL_sum hRK_sum
      c_χ' c_K hc_val hc_stat hc_K_inv
  by_cases hℓ2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2
  · have hNe2 : (2 : k_L) ≠ 0 := by
      rw [← Nat.cast_two, ← hℓ2]
      exact hNeChar
    have hν_pow2 : ∀ x : k_L, x ≠ 0 → (ν_tilde x) ^ 2 = 1 := by
      intro x hx
      rw [← hℓ2]
      exact hν_pow x hx
    obtain ⟨hG_eq_sq, hsq_mul_G, hHasse2⟩ :=
      ld_finite_field_deg_two_quadratic_gauss_and_hasse F k_L hNe2 ν_tilde ψ_1
        hν_0 hν_1 hν_mul hν_pow2 hν_ne hψ1_0 hψ1_add hψ1_ne
    have hprod_W2 :
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          (ν₁ c_χ' : Ω F) ^ j) = (ν₁ c_χ' : Ω F) := by
      rw [hℓ2, Finset.prod_range_succ, Finset.prod_range_one, pow_zero, pow_one, one_mul]
    rcases Nat.mod_two_eq_zero_or_one (condExp F L χ') with ha_even | ha_odd
    · obtain ⟨δ_L, δ_K2, hδ_L, hδ_K2, hsum_K2⟩ := hK_deg2_even hℓ2 ha_even
      have heps_L := (hStatL.2 R_L δ_L hRL_int hRL_dist hRL_mod hδ_L).1 ha_even
      have hA_arith :
          condExp F K (χ'.comp (Units.map (normLM F hLK))) % 2 = 1 ∧
          2 * (condExp F L χ' / 2) =
