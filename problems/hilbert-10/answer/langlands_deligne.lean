    have hg_L_eq : g_L s_sq = H_ν (Φ₂ p).2 :=
      hg_L_congr s_sq (liftL (Φ₂ p).2) hs_sq_int (hliftL (Φ₂ p).2).1 hs_sq_sub
    rw [← hg_M₁'_eq, ← hg_E'_eq, ← hg_L_eq]
    exact hpt
  have hfrob_inj : Function.Injective (fun a : k_L => a ^ 2) := by
    intro a b hab
    have hsub_sq : (a - b) ^ 2 = 0 := by
      calc (a - b) ^ 2
        _ = (a ^ 2 - b ^ 2) - (2 : k_L) * (a * b - b ^ 2) := by ring
        _ = 0 - 0 * (a * b - b ^ 2) := by rw [sub_eq_zero.mpr hab, hchar2]
        _ = 0 := by ring
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hsub_sq)
  have hΦ₁_inj : Function.Injective Φ₁ := by
    intro p q hpq
    obtain ⟨h1, h2⟩ := Prod.ext_iff.mp hpq
    dsimp [Φ₁] at h1 h2
    have hp2_eq : p.2 = q.2 := hfrob_inj h2
    rw [h2] at h1
    have hp1_sq : p.1 ^ 2 = q.1 ^ 2 := add_right_cancel h1
    have hp1_eq : p.1 = q.1 := hfrob_inj hp1_sq
    exact Prod.ext hp1_eq hp2_eq
  have hΦ₁_bij : Function.Bijective Φ₁ :=
    (Fintype.bijective_iff_injective_and_card Φ₁).mpr ⟨hΦ₁_inj, rfl⟩
  have hΦ₂_inj : Function.Injective Φ₂ := by
    intro p q hpq
    obtain ⟨h1, h2⟩ := Prod.ext_iff.mp hpq
    dsimp [Φ₂] at h1 h2
    have hlin := hfrob_inj h2
    rw [h1] at hlin
    have hp1_eq : p.1 = q.1 := add_right_cancel hlin
    exact Prod.ext hp1_eq h1
  have hΦ₂_bij : Function.Bijective Φ₂ :=
    (Fintype.bijective_iff_injective_and_card Φ₂).mpr ⟨hΦ₂_inj, rfl⟩
  have hsum_Φ₁ : (∑ p : k_L × k_L, H_M (Φ₁ p)) = ∑ p : k_L × k_L, H_M p :=
    Fintype.sum_bijective Φ₁ hΦ₁_bij (fun p => H_M (Φ₁ p)) H_M (fun _ => rfl)
  have hsum_Φ₂ :
      (∑ p : k_L × k_L, H_E (Φ₂ p).1 * H_ν (Φ₂ p).2) =
        ∑ p : k_L × k_L, H_E p.1 * H_ν p.2 :=
    Fintype.sum_bijective Φ₂ hΦ₂_bij
      (fun p => H_E (Φ₂ p).1 * H_ν (Φ₂ p).2)
      (fun p => H_E p.1 * H_ν p.2)
      (fun _ => rfl)
  change (∑ p : k_L × k_L, H_M p) = (∑ a : k_L, H_E a) * (∑ a : k_L, H_ν a)
  calc (∑ p : k_L × k_L, H_M p)
    _ = ∑ p : k_L × k_L, H_M (Φ₁ p) := hsum_Φ₁.symm
    _ = ∑ p : k_L × k_L, H_E (Φ₂ p).1 * H_ν (Φ₂ p).2 :=
      Finset.sum_congr rfl (fun p _ => hH_pointwise p)
    _ = ∑ p : k_L × k_L, H_E p.1 * H_ν p.2 := hsum_Φ₂
    _ = ∑ a : k_L, ∑ b : k_L, H_E a * H_ν b := Fintype.sum_prod_type _
    _ = (∑ a : k_L, H_E a) * (∑ b : k_L, H_ν b) := (Finset.sum_mul_sum _ _ _ _).symm

theorem ld_ch12_wild_dyadic_unramified_min_cond_branch (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hmE'_ge2 : 2 ≤ condExp F E' θE')
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hMinEq : condExp F M₁' θM₁' = condExp F L νE')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hqM₁' : qL F M₁' = (qL F L) ^ 2)
    (hqE' : qL F E' = qL F L)
    (heps_M₁'_1 : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
      (qL F M₁' : Ω F) ^ (condExpChar F M₁' (traceChar F hLM₁' ψ)))
    (heps_E'_1 : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F E' : Ω F) ^ (condExpChar F E' (traceChar F hLE' ψ)))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = 2 * valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (d : M₁') (c : L) (σ_U : M₁' ≃ₐ[F] M₁')
    (hd_val : valL F M₁' d = 0) (hc_val : valL F L c = 0)
    (hd_tr : traceLM F hLM₁' d = 1) (hd_norm : normLM F hLM₁' d = -c)
    (hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c)
    (hσ_U_L : ∀ x : L,
      σ_U (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ_U_val : ∀ z : M₁', valL F M₁' (σ_U z) = valL F M₁' z)
    (hσ_U_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + σ_U z)
    (c_ν : Lˣ) (x : E') (C : K₁ˣ) (cM₁' : M₁'ˣ) (cE' : E'ˣ)
    (hC_eq : (C : K₁) =
      IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)
    (hx_int : x = 0 ∨ 0 ≤ valL F E' x)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u))
    (heps_νM₁' : tateEps F L νM₁' ψ =
      (qL F L : Ω F) ^ (condExpChar F L ψ) * (-1 : Ω F) ^ (condExp F L νE') * (νM₁' c_ν : Ω F))
    (hcM₁'_eq : cM₁' = (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) *
      (Units.map (normLM F hM₁'K₁) C)⁻¹)
    (hcM₁'_val : valL F M₁' (cM₁' : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
    (hcE'_eq : cE' = (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) *
      (Units.map (normLM F hE'K₁) C)⁻¹)
    (hcE'_val : valL F E' (cE' : E') =
      (condExp F E' θE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ y : E',
      (y = 0 ∨ (((condExp F E' θE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      ∀ hy : 1 + y ≠ 0,
        (θE' (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * y))
    (hPrefactor :
      (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) =
        (-1 : Ω F) ^ (condExp F L νE') * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) *
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')))
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hBiquadE2 : ∀ C' : K₁,
      traceLM F hLE' (normLM F hE'K₁ C') + normLM F hLE' (traceLM F hE'K₁ C') =
        traceLM F hLM₁' (normLM F hM₁'K₁ C') + normLM F hLM₁' (traceLM F hM₁'K₁ C')) :
    tateEps F E' θE' (traceChar F hLE' ψ) *
      tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
      tateEps F L νE' ψ =
    tateEps F M₁' θM₁' (traceChar F hLM₁' ψ) *
      tateEps F E' 1 (traceChar F hLE' ψ) *
      tateEps F L νM₁' ψ :=
by
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ :=
    ld_valL_mod_one_finset F L hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1
      hvalL_props.2.2.2.2.2.2.2.1 haddVal1 haddVal_neg haddVal_mul haddVal_inv
      halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hk_L_field, hk_L_fintype, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hvalL_props.1 hvalL_props.2.1 hvalL_props.2.2.1
      hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.1
      hvalL_props.2.2.2.2.2.2.2.1 S₁ hS₁
  letI : Field k_L := hk_L_field
  letI : Fintype k_L := hk_L_fintype
  have hRamE' : condExp F L νE' ≠ 0 := by omega
  obtain ⟨_, _, _, _, _, _, _, _, ϖ_E', ϖ_L, hϖ_norm, hϖ_E', hϖ_L, hBasis⟩ :=
    ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hRamE' hWild
      haddVal1 haddVal_mul halg1 hvalL_props hvalE'_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  have hSpecL := ld_condExp_and_condExpChar_spec F L ψ hψ νE'
  have hSpecE' := ld_condExp_and_condExpChar_spec F E' (traceChar F hLE' ψ) hψE' θE'
  have hSpecM₁' := ld_condExp_and_condExpChar_spec F M₁' (traceChar F hLM₁' ψ) hψM₁' θM₁'
  have hSpecL_ν : ∀ u ∈ unitGroup F L (condExp F L νE'), νE' u = 1 :=
    (hSpecL.2.2.1 (by omega)).1
  have hSpecE'_θ : ∀ u ∈ unitGroup F E' (condExp F E' θE'), θE' u = 1 :=
    (hSpecE'.2.2.1 (by omega)).1
  have hSpecM₁'_θ : ∀ u ∈ unitGroup F M₁' (condExp F M₁' θM₁'), θM₁' u = 1 :=
    (hSpecM₁'.2.2.1 (by omega)).1
  obtain ⟨hchar2, h2_val, x_0, δ_T, δ_E, δ_U, liftL,
      hx0_int, hx_x0, hδ_T_val, hδ_E_val, hδ_U_val, hδ_norm, hδ_U_eq, hliftL, hRed⟩ :=
    ld_ch12_wild_dyadic_unramified_min_cond_res_setup_and_even_reduction F L E' M₁'
      hLE' hLM₁' hdeg2 hdegM₁' ψ hψ hψE' hψM₁' νE' νM₁' hbE'_ge2
      θE' θM₁' hmE'_ge2 hmM₁'_ge2 hMinEq hmE'_eq heps_M₁'_1 heps_E'_1
      hval_LM₁' hval_LE' htr_bound_LM₁' htr_bound_LE'
      d σ_U hd_val hd_tr hσ_U_val hσ_U_tr
      c_ν x cM₁' cE' hx_int hc_ν_val hc_ν_stat heps_νM₁'
      hcM₁'_val hcM₁'_stat hcE'_val hcE'_stat hPrefactor
      hQuadNorm hvalL_props hvalE'_props hvalM₁'_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      ϖ_E' ϖ_L hϖ_norm hϖ_E' hϖ_L hBasis
      (fun E _ ψ_E hψE θ hm => ld_tame_stationary_phase_and_stable_twist F E ψ_E hψE θ hm)
  apply hRed
  intro hT_odd
  exact ld_ch12_wild_dyadic_unramified_min_cond_odd_hasse_bijection F L E' M₁'
    hLE' hLM₁' hdeg2 hdegM₁' ψ νE' hbE'_ge2 hT_odd θE' θM₁' hMinEq hmE'_eq
    hval_LM₁' hval_LE' d c hd_val hc_val hd_tr hd_sq
    c_ν cM₁' cE' hc_ν_val hc_ν_stat hcM₁'_val hcM₁'_stat hcE'_val hcE'_stat
    hQuadNorm hvalL_props hvalE'_props hvalM₁'_props
    hSpecL.1 hSpecL_ν hSpecE'.1 hSpecE'_θ hSpecM₁'.1 hSpecM₁'_θ
    k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
    hchar2 h2_val x_0 hx0_int δ_T δ_E δ_U hδ_T_val hδ_E_val hδ_U_val liftL hliftL
    (fun r₁ r₂ hr₁ hr₂ =>
      ld_ch12_wild_dyadic_unramified_min_cond_odd_biquad_pointwise_factor F L E' M₁' K₁
        hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' hdegE'K₁ hdegM₁'K₁
        ψ νE' hνE'_ker hbE'_ge2 hT_odd θE' θM₁' θK₁ hχE'_comp hχM₁'_comp hMinEq hmE'_eq
        hval_LM₁' hval_norm_LM₁' hval_LE' hval_norm_LE' htr_bound_LM₁' htr_bound_LE'
        hDiamond_E' hDiamond_M₁' d c hd_val hc_val hd_tr hd_norm hd_sq
        c_ν x C cM₁' cE' hC_eq hx_int hc_ν_val hc_ν_stat
        hcM₁'_eq hcM₁'_stat hcE'_eq hcE'_stat hQuadNorm hBiquadE2
        hvalL_props hvalE'_props hvalM₁'_props
        hSpecL.1 hSpecL_ν hSpecE'_θ hSpecM₁'_θ
        h2_val x_0 hx0_int hx_x0 δ_T δ_E δ_U
        hδ_T_val hδ_E_val hδ_U_val hδ_norm hδ_U_eq r₁ r₂ hr₁ hr₂)

theorem ld_ch12_wild_dyadic_unramified_subfield_branch (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
