      intro g b₁ b₂
      have hb : b₁ + b₂ = resK (sK b₁ + sK b₂) := by
        rw [(hresK_ring (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)).1, hsK_res b₁, hsK_res b₂]
      rw [hb, hπ₀_eq g (sK b₁ + sK b₂) (hintK_add (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)),
        map_add (act_LK g) (sK b₁) (sK b₂),
        (hresK_ring (act_LK g (sK b₁)) (act_LK g (sK b₂))
          (hintK_act g (sK b₁) (hsK_int b₁)) (hintK_act g (sK b₂) (hsK_int b₂))).1]
    have hπ₀_mul : ∀ (g : G_LK) (b₁ b₂ : k_K), π₀ g (b₁ * b₂) = π₀ g b₁ * π₀ g b₂ := by
      intro g b₁ b₂
      have hb : b₁ * b₂ = resK (sK b₁ * sK b₂) := by
        rw [(hresK_ring (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)).2.1, hsK_res b₁, hsK_res b₂]
      rw [hb, hπ₀_eq g (sK b₁ * sK b₂) (hintK_mul (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)),
        map_mul (act_LK g) (sK b₁) (sK b₂),
        (hresK_ring (act_LK g (sK b₁)) (act_LK g (sK b₂))
          (hintK_act g (sK b₁) (hsK_int b₁)) (hintK_act g (sK b₂) (hsK_int b₂))).2.1]
    let π_ring : G_LK → (k_K →+* k_K) := fun g =>
      { toFun := π₀ g
        map_one' := hπ₀_1 g
        map_mul' := hπ₀_mul g
        map_zero' := hπ₀_0 g
        map_add' := hπ₀_add g }
    obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := k_Kˣ)
    have h_pow_gen : ∀ w : k_K, w ≠ 0 → ∃ m : ℕ, w = (g₀ : k_K) ^ m := by
      intro w hw
      obtain ⟨m, hm⟩ := hg₀ (Units.mk0 w hw)
      exact ⟨m, (congrArg Units.val hm).symm⟩
    have hπ₀_comm : ∀ (g₁ g₂ : G_LK) (b : k_K), π₀ g₁ (π₀ g₂ b) = π₀ g₂ (π₀ g₁ b) := by
      intro g₁ g₂ b
      have hg₀_ne : (g₀ : k_K) ≠ 0 := Units.ne_zero g₀
      have hg₁_ne : π_ring g₁ (g₀ : k_K) ≠ 0 := (map_ne_zero (π_ring g₁)).mpr hg₀_ne
      have hg₂_ne : π_ring g₂ (g₀ : k_K) ≠ 0 := (map_ne_zero (π_ring g₂)).mpr hg₀_ne
      obtain ⟨j, hj⟩ := h_pow_gen (π_ring g₁ (g₀ : k_K)) hg₁_ne
      obtain ⟨k, hk⟩ := h_pow_gen (π_ring g₂ (g₀ : k_K)) hg₂_ne
      change π_ring g₁ (π_ring g₂ b) = π_ring g₂ (π_ring g₁ b)
      by_cases hb0 : b = 0
      · simp [hb0]
      · obtain ⟨m, hm⟩ := h_pow_gen b hb0
        rw [hm, map_pow, hk, ← pow_mul, map_pow, hj, ← pow_mul,
          map_pow, hj, ← pow_mul, map_pow, hk, ← pow_mul]
        congr 1
        ring
    have hπ₀_comm_triv : ∀ (g₁ g₂ : G_LK) (b : k_K),
        π₀ (g₁ * g₂ * g₁⁻¹ * g₂⁻¹) b = b := by
      intro g₁ g₂ b
      have h1 : g₁ * g₂ * g₁⁻¹ * g₂⁻¹ = (g₁ * g₂) * (g₁⁻¹ * g₂⁻¹) := by group
      have h2 : (g₂ * g₁) * (g₁⁻¹ * g₂⁻¹) = 1 := by group
      rw [h1, hπ₀_mul_act, hπ₀_mul_act, hπ₀_comm g₁ g₂, ← hπ₀_mul_act, ← hπ₀_mul_act, h2, hπ₀_one]
    have hresK_comm_triv : ∀ (g₁ g₂ : G_LK) (y : K), (y = 0 ∨ 0 ≤ valL F K y) →
        resK (act_LK (g₁ * g₂ * g₁⁻¹ * g₂⁻¹) y) = resK y := by
      intro g₁ g₂ y hy
      rw [← hπ₀_eq (g₁ * g₂ * g₁⁻¹ * g₂⁻¹) y hy, hπ₀_comm_triv g₁ g₂ (resK y)]
    let H_MC : Subgroup G_LK :=
      { carrier := {g : G_LK | ∀ z : M_C,
          act_LK g (IntermediateField.inclusion hM_CK z) = IntermediateField.inclusion hM_CK z}
        one_mem' := fun z => by simp
        mul_mem' := fun {g₁ g₂} hg₁ hg₂ z => by
          change (act_LK g₁ * act_LK g₂) (IntermediateField.inclusion hM_CK z) = _
          rw [AlgEquiv.mul_apply, hg₂ z, hg₁ z]
        inv_mem' := fun {g} hg z => by
          have h := congrArg (act_LK g⁻¹) (hg z).symm
          rwa [← AlgEquiv.mul_apply, ← map_mul, inv_mul_cancel, map_one, AlgEquiv.one_apply] at h }
    let act_H : H_MC → K → K := fun g y => act_LK g.1 y
    have hact_H_ring : ∀ g : H_MC,
        act_H g 0 = 0 ∧ act_H g 1 = 1 ∧
        (∀ y₁ y₂ : K,
          act_H g (y₁ + y₂) = act_H g y₁ + act_H g y₂ ∧
          act_H g (y₁ * y₂) = act_H g y₁ * act_H g y₂ ∧
          act_H g (-y₁) = -act_H g y₁) := by
      intro g
      refine ⟨map_zero (act_LK g.1), map_one (act_LK g.1), fun y₁ y₂ =>
        ⟨map_add (act_LK g.1) y₁ y₂, map_mul (act_LK g.1) y₁ y₂, map_neg (act_LK g.1) y₁⟩⟩
    have hact_H_incl : ∀ (g : H_MC) (z : M_C),
        act_H g (IntermediateField.inclusion hM_CK z) = IntermediateField.inclusion hM_CK z :=
      fun g z => g.2 z
    have hact_H_faithful : ∀ g : H_MC, (∀ y : K, act_H g y = y) → g = 1 := by
      intro g hg
      apply Subtype.ext
      apply hact_LK_inj
      change act_LK g.1 = act_LK 1
      rw [map_one]
      exact AlgEquiv.ext hg
    have hact_H_val : ∀ (g : H_MC) (y : K), valL F K (act_H g y) = valL F K y :=
      fun g y => hval_act_LK g.1 y
    intro σ hσ
    apply hCentralizer σ hσ
    intro τ hτ
    have hτL : τ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM_C hτ
    set γ : AbsGal F := σ * τ * σ⁻¹ * τ⁻¹
    have hγL : γ ∈ L.fixingSubgroup :=
      mul_mem (mul_mem (mul_mem hσ hτL) (inv_mem hσ)) (inv_mem hτL)
    have hγMC : γ ∈ M_C.fixingSubgroup :=
      mul_mem (hMin.1.2.2.1 σ hσ τ hτ) (inv_mem hτ)
    have hγ_HMC : res_LK ⟨γ, hγL⟩ ∈ H_MC := by
      intro z
      apply Subtype.ext
      rw [hres_LK_val ⟨γ, hγL⟩ (IntermediateField.inclusion hM_CK z)]
      exact (IntermediateField.mem_fixingSubgroup_iff M_C γ).mp hγMC z.1 z.2
    have hγ_sub : (⟨γ, hγL⟩ : ↥(L.fixingSubgroup)) =
        (⟨σ, hσ⟩ : ↥(L.fixingSubgroup)) * ⟨τ, hτL⟩ * (⟨σ, hσ⟩)⁻¹ * (⟨τ, hτL⟩)⁻¹ :=
      Subtype.ext rfl
    have hγ_comm : res_LK ⟨γ, hγL⟩ =
        res_LK ⟨σ, hσ⟩ * res_LK ⟨τ, hτL⟩ * (res_LK ⟨σ, hσ⟩)⁻¹ * (res_LK ⟨τ, hτL⟩)⁻¹ := by
      rw [hγ_sub, map_mul, map_mul, map_mul, map_inv, map_inv]
    have hγ_res_triv : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
        resK (act_H ⟨res_LK ⟨γ, hγL⟩, hγ_HMC⟩ y) = resK y := by
      intro y hy
      change resK (act_LK (res_LK ⟨γ, hγL⟩) y) = resK y
      rw [hγ_comm]
      exact hresK_comm_triv (res_LK ⟨σ, hσ⟩) (res_LK ⟨τ, hτL⟩) y hy
    have hγ_eq_one_H : (⟨res_LK ⟨γ, hγL⟩, hγ_HMC⟩ : H_MC) = 1 :=
      hInertiaTriv hval_alg_MCK H_MC act_H hact_H_ring hact_H_incl hact_H_faithful hact_H_val
        ⟨res_LK ⟨γ, hγL⟩, hγ_HMC⟩ hγ_res_triv
    have hγ_eq_one : res_LK ⟨γ, hγL⟩ = 1 := congrArg Subtype.val hγ_eq_one_H
    exact (hres_LK_eq_one_iff ⟨γ, hγL⟩).mp hγ_eq_one

  
  have hGal_MC_norm : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ M_C.fixingSubgroup,
      σ * τ * σ⁻¹ ∈ M_C.fixingSubgroup := hMin.1.2.2.1
  have hSep_LMC : Algebra.IsSeparable L (IntermediateField.extendScalars hLM_C) := hMin.1.2.2.2 hLM_C
  clear! K ν₀ k_K haddVal1 haddVal_mul hvalL_props hvalMC_props
  let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
  have hFin_L_MC' : FiniteDimensional L ↥M_C' := by
    let e_MC : M_C ≃ₐ[F] ↥M_C' :=
      { toFun := fun x => ⟨x.1, (IntermediateField.mem_extendScalars hLM_C).mpr x.2⟩
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM_C).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F ↥M_C' := Module.Finite.equiv e_MC.toLinearEquiv
    haveI : IsScalarTower F L ↥M_C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F L ↥M_C'
  haveI : FiniteDimensional L ↥M_C' := hFin_L_MC'
  haveI : Algebra.IsSeparable L ↥M_C' := hSep_LMC
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  have hMC'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
      (∀ x ∈ M_C', τ x = x) → ∀ x ∈ M_C', (σ * τ * σ⁻¹) x = x := by
    intro σ τ hτ
    let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
    let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
    have hτMC : τ_F.1 ∈ M_C.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hLM_C).mpr hx)
    have hconjMC : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
      hGal_MC_norm σ_F.1 σ_F.2 τ_F.1 hτMC
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjMC
    exact hconjMC x ((IntermediateField.mem_extendScalars hLM_C).mp hx)
  haveI : IsGalois L ↥M_C' := helper_isGalois L (AlgebraicClosure F) M_C' hMC'_norm_fix
  haveI : Normal L ↥M_C' := IsGalois.to_normal
  let G_MC := (↥M_C' ≃ₐ[L] ↥M_C')
  letI : Fintype G_MC := AlgEquiv.fintype L ↥M_C'
  have hcard_GMC : Fintype.card G_MC = Module.finrank L ↥M_C' := by
    rw [← Nat.card_eq_fintype_card]
    exact IsGalois.card_aut_eq_finrank L ↥M_C'
  have h1lt_GMC : 1 < Fintype.card G_MC := hcard_GMC.symm ▸ hf_H_gt1
  haveI : Nontrivial G_MC := Fintype.one_lt_card_iff_nontrivial.mp h1lt_GMC
  obtain ⟨ρ, hρ_ne⟩ := exists_ne (1 : G_MC)
  obtain ⟨σ₀, hσ₀⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) ρ
  let σ_F : ↥(L.fixingSubgroup) := (IntermediateField.fixingSubgroupEquiv L).symm σ₀
  have hσ_MC : σ_F.1 ∈ M_C.fixingSubgroup := hL_le_MC σ_F.1 σ_F.2
  have hρ_eq_one : ρ = 1 := by
    apply AlgEquiv.ext
    intro z
    apply Subtype.ext
    have hz_MC : z.1 ∈ M_C := (IntermediateField.mem_extendScalars hLM_C).mp z.2
    have h1 : ((ρ z : ↥M_C') : AlgebraicClosure F) = σ₀ z.1 := by
      rw [← hσ₀]
      exact AlgEquiv.restrictNormalHom_apply M_C' σ₀ z
    rw [h1]
    exact (IntermediateField.mem_fixingSubgroup_iff M_C σ_F.1).mp hσ_MC z.1 hz_MC
  exact hρ_ne hρ_eq_one

theorem ld_ch13_tame_z0_lift_and_unramified_mc (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hCentralizer : ∀ σ ∈ L.fixingSubgroup,
      (∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) →
      σ ∈ M_C.fixingSubgroup)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hℓ_ne0 : (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : M_C) ≠ 0)
    (hℓ_val0 : valL F M_C (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : M_C) = 0)
    (hValNorm_MCK : ∀ y : K, valL F K y = valL F M_C (normLM F hM_CK y))
    (hValAlg_MCK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (ϖ_K₀ : Kˣ) (hϖ_K₀ : valL F K (ϖ_K₀ : K) = 1)
    (hResSurj_MCK : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (y - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hM_CK z)))
    (haddVal1 : addVal F 1 = 0)
    (haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalMC_props : valL F M_C 0 = 0 ∧ valL F M_C 1 = 0 ∧ valL F M_C (-1) = 0 ∧
      (∀ x : M_C, valL F M_C (-x) = valL F M_C x) ∧
      (∀ x y : M_C, x ≠ 0 → y ≠ 0 → valL F M_C (x * y) = valL F M_C x + valL F M_C y) ∧
      (∀ u : M_Cˣ, valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = - valL F M_C (u : M_C)) ∧
      (∀ m : ℤ, ∃ c : M_Cˣ, valL F M_C (c : M_C) = m) ∧
      (∀ (k : ℤ) (x y : M_C),
        (x = 0 ∨ k ≤ valL F M_C x) → (y = 0 ∨ k ≤ valL F M_C y) →
          (x + y = 0 ∨ k ≤ valL F M_C (x + y))) ∧
      (∀ u : M_Cˣ, u ∈ unitGroup F M_C 0 ↔ valL F M_C (u : M_C) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M_Cˣ,
        u ∈ unitGroup F M_C a ↔ ((u : M_C) = 1 ∨ (a : ℤ) ≤ valL F M_C ((u : M_C) - 1))) ∧
      (∀ (a : ℕ) (u : M_Cˣ), u ∈ unitGroup F M_C a → valL F M_C (u : M_C) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0)) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    (∃ z₀ : M_Cˣ,
      valL F M_C (z₀ : M_C) = 0 ∧
      z₀ ^ ℓ ∈ unitGroup F M_C 1 ∧
      z₀ ∉ unitGroup F M_C 1 ∧
      ∀ σ ∈ L.fixingSubgroup, σ ∉ M_C.fixingSubgroup →
        ∀ hσz : (σ : AbsGal F) (z₀ : AlgebraicClosure F) ∈ M_C,
          (⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - (z₀ : M_C) ≠ 0 ∧
          valL F M_C ((⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - (z₀ : M_C)) = 0) ∧
    resDeg F M_C = f_H * resDeg F L ∧
    qL F M_C = (qL F L) ^ f_H ∧
    (∀ z : M_C, valL F L (normLM F hLM_C z) = (f_H : ℤ) * valL F M_C z) ∧
    (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x) ∧
    (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z))) ∧
    (∀ (d : ℕ), 1 ≤ d → ∀ z : M_C, (z = 0 ∨ (d : ℤ) ≤ valL F M_C z) →
      (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)))) ∧
    (∃ y₁ : M_C, (y₁ = 0 ∨ 0 ≤ valL F M_C y₁) ∧ traceLM F hLM_C y₁ = 1) ∧
    FiniteDimensional L (IntermediateField.extendScalars hLM_C) ∧
    ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → M_C → M_C),
      Fintype.card G = f_H ∧
      (∀ z : M_C, act 1 z = z) ∧
      (∀ (σ τ : G) (z : M_C), act (σ * τ) z = act σ (act τ z)) ∧
      (∀ σ : G,
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
          act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
          act σ (-z₁) = -act σ z₁)) ∧
      (∀ (σ : G) (x : L),
        act σ (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x) ∧
      (∀ σ : G, (∀ z : M_C, act σ z = z) → σ = 1) ∧
      (∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z) ∧
      (∀ z : M_C, IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G, act σ z) ∧
      (∀ z : M_C, IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G, act σ z) ∧
      (∀ (σ : G), σ ≠ 1 → ∃ τ ∈ L.fixingSubgroup, τ ∉ M_C.fixingSubgroup ∧
        ∀ z : M_C, ∃ hτz : (τ : AbsGal F) (z : AlgebraicClosure F) ∈ M_C,
          act σ z = ⟨(τ : AbsGal F) (z : AlgebraicClosure F), hτz⟩) :=
by
  let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k K₀ := by
    intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN

  have hs1 : ∃ z₀ : M_Cˣ,
      valL F M_C (z₀ : M_C) = 0 ∧
      z₀ ^ ℓ ∈ unitGroup F M_C 1 ∧
      z₀ ∉ unitGroup F M_C 1 ∧
      ∀ σ ∈ L.fixingSubgroup, σ ∉ M_C.fixingSubgroup →
        ∀ hσz : (σ : AbsGal F) (z₀ : AlgebraicClosure F) ∈ M_C,
          (⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - (z₀ : M_C) ≠ 0 ∧
          valL F M_C ((⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - (z₀ : M_C)) = 0 := by
    obtain ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv, hvalMC_surj,
      hvalMC_add, hunitMC0, hunitMCa, hunitMC_val0⟩ := hvalMC_props
    obtain ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj,
      hvalK_add, hunitK0, hunitKa, hunitK_val0⟩ := hvalK_props
    have hvalK_algEquiv : ∀ (φ : K ≃ₐ[F] K) (y : K), valL F K (φ y) = valL F K y := by
      intro φ y
      unfold valL relVal
      rw [Algebra.norm_eq_of_algEquiv φ y]

    have hC_package :
        (∃ (C : Type u) (_ : Group C) (_ : Fintype C) (act_C : C → K → K)
           (res_MC : M_C.fixingSubgroup →* C),
          Fintype.card C = ℓ ∧
          (∀ y : K, act_C 1 y = y) ∧
          (∀ (σ τ : C) (y : K), act_C (σ * τ) y = act_C σ (act_C τ y)) ∧
          (∀ τ : C,
            act_C τ 0 = 0 ∧ act_C τ 1 = 1 ∧
            (∀ y₁ y₂ : K,
              act_C τ (y₁ + y₂) = act_C τ y₁ + act_C τ y₂ ∧
              act_C τ (y₁ * y₂) = act_C τ y₁ * act_C τ y₂ ∧
              act_C τ (-y₁) = -act_C τ y₁ ∧
              act_C τ (y₁ - y₂) = act_C τ y₁ - act_C τ y₂)) ∧
          (∀ (τ : C) (z : M_C),
            act_C τ (IntermediateField.inclusion hM_CK z) = IntermediateField.inclusion hM_CK z) ∧
          (∀ τ : C, (∀ y : K, act_C τ y = y) → τ = 1) ∧
          (∀ (τ : C) (y : K), valL F K (act_C τ y) = valL F K y) ∧
          Function.Surjective res_MC ∧
          (∀ (g : M_C.fixingSubgroup) (y : K),
            ((act_C (res_MC g) y : K) : AlgebraicClosure F) = (g.1 : AbsGal F) (y : AlgebraicClosure F))) ∧
        (∀ σ ∈ L.fixingSubgroup, ∀ x ∈ K, (σ : AbsGal F) x ∈ K) := by
      haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
      refine ⟨?_, ?_⟩
      · let K_MC' : IntermediateField M_C (AlgebraicClosure F) := IntermediateField.extendScalars hM_CK
        let e_K_MC : K ≃ₐ[F] K_MC' :=
          { toExtendScalars F hM_CK with
            invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hM_CK).mp y.2⟩
            left_inv := fun _ => rfl
            right_inv := fun _ => rfl
            commutes' := fun _ => rfl }
        haveI : FiniteDimensional F K_MC' := Module.Finite.equiv e_K_MC.toLinearEquiv
        haveI : IsScalarTower F M_C K_MC' := IsScalarTower.of_algebraMap_eq fun _ => rfl
        haveI : FiniteDimensional M_C K_MC' := Module.Finite.of_restrictScalars_finite F M_C K_MC'
        haveI : Normal M_C (AlgebraicClosure F) := Normal.tower_top_of_normal F M_C (AlgebraicClosure F)
        have hGalMCK' : IsGalois M_C ↥K_MC' := by
          haveI : Algebra.IsSeparable M_C K_MC' := hGalMCK.2.2.2 hM_CK
          refine helper_isGalois M_C (AlgebraicClosure F) K_MC' (fun σ τ hτ => ?_)
          let σ_F : M_C.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_C).symm σ
          let τ_F : M_C.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_C).symm τ
          have hτK : τ_F.1 ∈ K.fixingSubgroup := by
            rw [IntermediateField.mem_fixingSubgroup_iff]
            intro x hx
            exact hτ x ((IntermediateField.mem_extendScalars hM_CK).mpr hx)
          have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
            hGalMCK.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
          intro x hx
          rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
          exact hconjK x ((IntermediateField.mem_extendScalars hM_CK).mp hx)
        haveI : IsGalois M_C ↥K_MC' := hGalMCK'
        haveI : Normal M_C ↥K_MC' := IsGalois.to_normal
        let C₀ : Type u := (K_MC' ≃ₐ[M_C] K_MC')
        let fromExtendScalars_K : K_MC' →+* K := e_K_MC.symm.toRingHom
        let act_C₀ : C₀ → K → K := fun τ y => fromExtendScalars_K (τ (toExtendScalars F hM_CK y))
        let res_MC₀ : M_C.fixingSubgroup →* C₀ :=
          (AlgEquiv.restrictNormalHom ↥K_MC').comp (IntermediateField.fixingSubgroupEquiv M_C).toMonoidHom
        refine ⟨C₀, inferInstance, inferInstance, act_C₀, res_MC₀,
          Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank M_C K_MC'),
          fun _ => rfl, fun _ _ _ => rfl, ?_, ?_, ?_, ?_,
          (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
            (IntermediateField.fixingSubgroupEquiv M_C).surjective, ?_⟩
        · intro τ
          refine ⟨by change fromExtendScalars_K (τ 0) = 0; rw [map_zero, map_zero],
            by change fromExtendScalars_K (τ 1) = 1; rw [map_one, map_one],
            fun y₁ y₂ => ⟨?_, ?_, ?_, ?_⟩⟩
          · change fromExtendScalars_K (τ (toExtendScalars F hM_CK y₁ + toExtendScalars F hM_CK y₂)) = _
            rw [map_add, map_add]
          · change fromExtendScalars_K (τ (toExtendScalars F hM_CK y₁ * toExtendScalars F hM_CK y₂)) = _
            rw [map_mul, map_mul]
          · change fromExtendScalars_K (τ (-toExtendScalars F hM_CK y₁)) = _
            rw [map_neg, map_neg]
          · change fromExtendScalars_K (τ (toExtendScalars F hM_CK y₁ - toExtendScalars F hM_CK y₂)) = _
            rw [map_sub, map_sub]
        · intro τ z
          change fromExtendScalars_K (τ (algebraMap M_C K_MC' z)) = IntermediateField.inclusion hM_CK z
          rw [τ.commutes z]
          rfl
        · intro τ h
          apply AlgEquiv.ext
          intro y
          exact congrArg (toExtendScalars F hM_CK) (h (fromExtendScalars_K y))
        · intro τ y
          let φ_τ : K ≃ₐ[F] K := e_K_MC.trans ((τ.restrictScalars F).trans e_K_MC.symm)
          exact hvalK_algEquiv φ_τ y
        · intro g y
          change (((AlgEquiv.restrictNormalHom ↥K_MC' (IntermediateField.fixingSubgroupEquiv M_C g))
            (toExtendScalars F hM_CK y) : ↥K_MC') : AlgebraicClosure F) = (g.1 : AbsGal F) (y : AlgebraicClosure F)
          rw [AlgEquiv.restrictNormalHom_apply]
          rfl
      · let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
        let e_K_L : K ≃ₐ[F] K' :=
          { toExtendScalars F hLK with
            invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLK).mp y.2⟩
            left_inv := fun _ => rfl
            right_inv := fun _ => rfl
            commutes' := fun _ => rfl }
        haveI : FiniteDimensional F K' := Module.Finite.equiv e_K_L.toLinearEquiv
        haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
        haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
        haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
        have hGalLK' : IsGalois L ↥K' := by
          haveI : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
          refine helper_isGalois L (AlgebraicClosure F) K' (fun σ τ hτ => ?_)
          let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
          let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
          have hτK : τ_F.1 ∈ K.fixingSubgroup := by
            rw [IntermediateField.mem_fixingSubgroup_iff]
            intro x hx
            exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
          have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
            hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
          intro x hx
          rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
          exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
        haveI : IsGalois L ↥K' := hGalLK'
        haveI : Normal L ↥K' := IsGalois.to_normal
        intro σ hσL x hx
        let σ_L : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F :=
          IntermediateField.fixingSubgroupEquiv L ⟨σ, hσL⟩
        let y : K' := ⟨x, (IntermediateField.mem_extendScalars hLK).mpr hx⟩
        have h1 : (((AlgEquiv.restrictNormalHom ↥K' σ_L) y : ↥K') : AlgebraicClosure F) = (σ : AbsGal F) x := by
          rw [AlgEquiv.restrictNormalHom_apply]
          rfl
        rw [← h1]
        exact (IntermediateField.mem_extendScalars hLK).mp ((AlgEquiv.restrictNormalHom ↥K' σ_L) y).2

    obtain ⟨⟨C, hGroupC, hFinC, act_C, res_MC, hcard_C, hactC_one, hactC_mul,
      hactC_ring, hactC_incl, hactC_faithful, hactC_val, hres_MC_surj, hres_MC_apply⟩,
      hσ_maps_K⟩ := hC_package
    letI : Group C := hGroupC
    letI : Fintype C := hFinC
    letI : Group ↥M_C.fixingSubgroup := Subgroup.toGroup M_C.fixingSubgroup

    let P_K : ℤ → K → Prop := fun k y => y = 0 ∨ k ≤ valL F K y
    let P_MC : ℤ → M_C → Prop := fun k z => z = 0 ∨ k ≤ valL F M_C z
    have hPK_zero : ∀ k : ℤ, P_K k 0 := fun _ => Or.inl rfl
    have hPK_one : P_K 0 1 := Or.inr (by omega)
    have hPK_neg : ∀ (k : ℤ) {y : K}, P_K k y → P_K k (-y) := by
      intro k y hy
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hvalK_neg]; exact hy)
    have hPK_add : ∀ (k : ℤ) {y₁ y₂ : K}, P_K k y₁ → P_K k y₂ → P_K k (y₁ + y₂) :=
      fun k {y₁ y₂} h1 h2 => hvalK_add k y₁ y₂ h1 h2
    have hPK_sub : ∀ (k : ℤ) {y₁ y₂ : K}, P_K k y₁ → P_K k y₂ → P_K k (y₁ - y₂) := by
      intro k y₁ y₂ h1 h2
      rw [sub_eq_add_neg]
      exact hPK_add k h1 (hPK_neg k h2)
    have hPK_mul : ∀ {k₁ k₂ : ℤ} {y₁ y₂ : K}, P_K k₁ y₁ → P_K k₂ y₂ → P_K (k₁ + k₂) (y₁ * y₂) := by
      intro k₁ k₂ y₁ y₂ h1 h2
      by_cases hy₁ : y₁ = 0
      · exact Or.inl (by rw [hy₁, zero_mul])
      · by_cases hy₂ : y₂ = 0
        · exact Or.inl (by rw [hy₂, mul_zero])
        · right
          rw [hvalK_mul y₁ y₂ hy₁ hy₂]
          have h1' := h1.resolve_left hy₁
          have h2' := h2.resolve_left hy₂
          omega
    have hPK_mono : ∀ {k₁ k₂ : ℤ} {y : K}, k₁ ≤ k₂ → P_K k₂ y → P_K k₁ y := by
      intro k₁ k₂ y hle hy
      rcases hy with rfl | hy
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hy)
    have hPK_natCast : ∀ m : ℕ, P_K 0 (m : K) := by
      intro m
      induction m with
      | zero => rw [Nat.cast_zero]; exact hPK_zero 0
      | succ m ih => rw [Nat.cast_succ]; exact hPK_add 0 ih hPK_one
    have hPK_map : ∀ (k : ℤ) (φ : K ≃ₐ[F] K) (y : K), P_K k (φ y) ↔ P_K k y := by
      intro k φ y
      dsimp [P_K]
      rw [map_eq_zero, hvalK_algEquiv φ y]
    have hPK_act : ∀ (k : ℤ) (τ : C) (y : K), P_K k (act_C τ y) ↔ P_K k y := by
      intro k τ y
      dsimp [P_K]
      have h0 : act_C τ y = 0 ↔ y = 0 := by
        refine ⟨fun h => ?_, fun h => by rw [h, (hactC_ring τ).1]⟩
        have h1 := congrArg (act_C τ⁻¹) h
        rw [← hactC_mul, inv_mul_cancel, hactC_one, (hactC_ring τ⁻¹).1] at h1
        exact h1
      rw [h0, hactC_val τ y]
    have hPK_inc : ∀ (k : ℤ) {z : M_C}, 0 ≤ k → P_MC k z → P_K k (IntermediateField.inclusion hM_CK z) := by
      intro k z hk hz
      rcases hz with rfl | hz
      · exact Or.inl (map_zero _)
      · right
        rw [hValAlg_MCK z]
        have hℓ_ge1 : (1 : ℤ) ≤ (ℓ : ℤ) := by exact_mod_cast hPrime_MCK.pos
        nlinarith
    have hPMC_of_inc1 : ∀ {z : M_C}, P_K 1 (IntermediateField.inclusion hM_CK z) → P_MC 1 z := by
      intro z hz
      by_cases hz0 : z = 0
      · exact Or.inl hz0
      · right
        have h_inc_ne0 : IntermediateField.inclusion hM_CK z ≠ 0 :=
          fun h => hz0 ((map_eq_zero_iff _ (IntermediateField.inclusion hM_CK).injective).mp h)
        have hge1 : 1 ≤ valL F K (IntermediateField.inclusion hM_CK z) := hz.resolve_left h_inc_ne0
        rw [hValAlg_MCK z] at hge1
        have hℓ_pos : (0 : ℤ) < (ℓ : ℤ) := by exact_mod_cast hPrime_MCK.pos
        by_contra hlt
        have hle0 : valL F M_C z ≤ 0 := by omega
        have hprod_le0 : (ℓ : ℤ) * valL F M_C z ≤ 0 := by nlinarith
        dsimp [ℓ] at hprod_le0
        omega

    set π : K := (ϖ_K₀ : K)
    set π_inv : K := ((ϖ_K₀⁻¹ : Kˣ) : K)
    have hπ_mul : π * π_inv = 1 := by exact_mod_cast Units.mul_inv ϖ_K₀
    have hπ_inv_mul : π_inv * π = 1 := by exact_mod_cast Units.inv_mul ϖ_K₀
    have hPK1_π : P_K 1 π := Or.inr (by omega)
    have hPK0_π : P_K 0 π := Or.inr (by omega)
    have hπ_inv_val : valL F K π_inv = -1 := by
      dsimp [π_inv]
      rw [hvalK_inv ϖ_K₀, hϖ_K₀]
    have hPK_div_pi : ∀ (k : ℤ) {y : K}, P_K (k + 1) y → P_K k (π_inv * y) := by
      intro k y hy
      have h1 := hPK_mul (Or.inr (by omega) : P_K (-1) π_inv) hy
      simpa [show (-1 : ℤ) + (k + 1) = k by omega] using h1

    let u_ℓ_MC : M_Cˣ := Units.mk0 (ℓ : M_C) hℓ_ne0
    let inv_ℓ : K := IntermediateField.inclusion hM_CK ((u_ℓ_MC⁻¹ : M_Cˣ) : M_C)
    have hinv_ℓ_0 : P_K 0 inv_ℓ := by
      refine hPK_inc 0 (le_refl 0) (Or.inr ?_)
      rw [hvalMC_inv u_ℓ_MC, Units.val_mk0, hℓ_val0, neg_zero]
    have hinv_ℓ_mul : inv_ℓ * (ℓ : K) = 1 := by
      dsimp [inv_ℓ]
      rw [← map_natCast (IntermediateField.inclusion hM_CK) ℓ, ← map_mul]
      have h1 : ((u_ℓ_MC⁻¹ : M_Cˣ) : M_C) * (ℓ : M_C) = 1 := by
        exact_mod_cast Units.inv_mul u_ℓ_MC
      rw [h1, map_one]

    let δ : C → K → K := fun τ y => act_C τ y - y
    let C_sub : ℕ → C → Prop := fun i τ => ∀ y : K, P_K 0 y → P_K (i + 1 : ℤ) (δ τ y)
    have hC_sub0 : ∀ τ : C, C_sub 0 τ := by
      intro τ y hy
      obtain ⟨z, _, hyz⟩ := hResSurj_MCK y hy
      set r : K := y - IntermediateField.inclusion hM_CK z
      have hδ_eq : δ τ y = act_C τ r - r := by
        dsimp [δ, r]
        rw [((hactC_ring τ).2.2 y _).2.2.2, hactC_incl τ z]
        ring
      rw [hδ_eq]
      simpa using hPK_sub 1 ((hPK_act 1 τ r).mpr hyz) hyz
    have hC_sub1_of_pi : ∀ {τ : C}, P_K 2 (δ τ π) → C_sub 1 τ := by
      intro τ hτπ y hy
      obtain ⟨z, _, hyz⟩ := hResSurj_MCK y hy
      set y₁ : K := π_inv * (y - IntermediateField.inclusion hM_CK z)
      have hy₁_0 : P_K 0 y₁ := hPK_div_pi 0 hyz
      have hy_eq : y = IntermediateField.inclusion hM_CK z + π * y₁ := by
        dsimp [y₁]
        rw [← mul_assoc, hπ_mul, one_mul]
        ring
      have hδ_eq : δ τ y = δ τ π * act_C τ y₁ + π * δ τ y₁ := by
        conv_lhs => rw [hy_eq]
        dsimp [δ]
        rw [((hactC_ring τ).2.2 _ _).1, hactC_incl τ z, ((hactC_ring τ).2.2 π y₁).2.1]
        ring
      have ht1 : P_K (2 + 0) (δ τ π * act_C τ y₁) :=
        hPK_mul hτπ ((hPK_act 0 τ y₁).mpr hy₁_0)
      have ht2 : P_K (1 + 1) (π * δ τ y₁) :=
        hPK_mul hPK1_π (hC_sub0 τ y₁ hy₁_0)
      rw [hδ_eq]
      exact hPK_add 2 (by simpa using ht1) (by simpa using ht2)
    have h_delta_step : ∀ {i : ℕ}, 1 ≤ i → ∀ {τ : C}, C_sub i τ →
        ∀ {w : K}, P_K (i + 1 : ℤ) w → P_K (i + 2 : ℤ) (δ τ w) := by
      intro i hi τ hτ w hw
      set y₁ : K := π_inv * w
      have hy₁_i : P_K (i : ℤ) y₁ := hPK_div_pi (i : ℤ) hw
      have hy₁_1 : P_K 1 y₁ := hPK_mono (by omega) hy₁_i
      have hy₁_0 : P_K 0 y₁ := hPK_mono (by omega) hy₁_i
      have hw_eq : w = π * y₁ := by
        dsimp [y₁]
        rw [← mul_assoc, hπ_mul, one_mul]
      have h_leib : δ τ w = δ τ π * act_C τ y₁ + π * δ τ y₁ := by
        conv_lhs => rw [hw_eq]
        dsimp [δ]
        rw [((hactC_ring τ).2.2 π y₁).2.1]
        ring
      have ht1 : P_K ((i + 1 : ℤ) + 1) (δ τ π * act_C τ y₁) :=
        hPK_mul (hτ π hPK0_π) ((hPK_act 1 τ y₁).mpr hy₁_1)
      have ht2 : P_K (1 + (i + 1 : ℤ)) (π * δ τ y₁) :=
        hPK_mul hPK1_π (hτ y₁ hy₁_0)
      rw [h_leib]
      exact hPK_add (i + 2 : ℤ)
        (by simpa [show (i + 1 : ℤ) + 1 = (i + 2 : ℤ) by ring] using ht1)
        (by simpa [show (1 : ℤ) + (i + 1 : ℤ) = (i + 2 : ℤ) by ring] using ht2)
    have h_pow_delta : ∀ {i : ℕ}, 1 ≤ i → ∀ {τ : C}, C_sub i τ →
        ∀ (m : ℕ) {y : K}, P_K 0 y → P_K (i + 2 : ℤ) (δ (τ ^ m) y - (m : K) * δ τ y) := by
      intro i hi τ hτ m
      induction m with
      | zero =>
        intro y _
        dsimp [δ]
        rw [pow_zero, hactC_one, Nat.cast_zero, zero_mul, sub_self, sub_zero]
        exact hPK_zero (i + 2 : ℤ)
      | succ m ih =>
        intro y hy
        have h_id : δ (τ ^ (m + 1)) y - ((m + 1 : ℕ) : K) * δ τ y =
            act_C τ (δ (τ ^ m) y - (m : K) * δ τ y) + (m : K) * δ τ (δ τ y) := by
          dsimp [δ]
          have h_nat : ∀ k : ℕ, act_C τ (k : K) = (k : K) := by
            intro k
            have h1 : (k : K) = IntermediateField.inclusion hM_CK (k : M_C) := by simp
            rw [h1, hactC_incl]
          rw [pow_succ', hactC_mul τ (τ ^ m) y, ((hactC_ring τ).2.2 _ _).2.2.2,
            ((hactC_ring τ).2.2 _ _).2.1, ((hactC_ring τ).2.2 _ _).2.2.2, h_nat m, Nat.cast_succ]
          ring
        have ht1 : P_K (i + 2 : ℤ) (act_C τ (δ (τ ^ m) y - (m : K) * δ τ y)) :=
          (hPK_act (i + 2 : ℤ) τ _).mpr (ih hy)
        have ht2 : P_K (0 + (i + 2 : ℤ)) ((m : K) * δ τ (δ τ y)) :=
          hPK_mul (hPK_natCast m) (h_delta_step hi hτ (hτ y hy))
        rw [h_id]
        exact hPK_add (i + 2 : ℤ) ht1 (by simpa using ht2)
    have hC_exp : ∀ τ : C, τ ^ ℓ = 1 := by
      intro τ
      dsimp [ℓ] at hcard_C ⊢
      rw [← hcard_C]
      exact pow_card_eq_one
    have h_C_step : ∀ {i : ℕ}, 1 ≤ i → ∀ {τ : C}, C_sub i τ → C_sub (i + 1) τ := by
      intro i hi τ hτ y hy
      have hpow : P_K (i + 2 : ℤ) (δ (τ ^ ℓ) y - (ℓ : K) * δ τ y) :=
        h_pow_delta hi hτ ℓ hy
      have h_zero : δ (τ ^ ℓ) y = 0 := by
        dsimp [δ]
        rw [hC_exp τ, hactC_one, sub_self]
      rw [h_zero, zero_sub] at hpow
      have hℓ_δ : P_K (i + 2 : ℤ) ((ℓ : K) * δ τ y) := by
        have hneg := hPK_neg (i + 2 : ℤ) hpow
        rwa [neg_neg] at hneg
      have hmul : P_K (0 + (i + 2 : ℤ)) (inv_ℓ * ((ℓ : K) * δ τ y)) :=
        hPK_mul hinv_ℓ_0 hℓ_δ
      rw [← mul_assoc, hinv_ℓ_mul, one_mul, zero_add] at hmul
      simpa [show ((i + 1 : ℕ) : ℤ) + 1 = (i + 2 : ℤ) by push_cast; ring] using hmul
    have h_C_sep : ∀ τ : C, (∀ i : ℕ, C_sub i τ) → τ = 1 := by
      intro τ hτ
      by_contra hne
      have hex0 : ∃ y₀ : K, act_C τ y₀ ≠ y₀ := by
        by_contra hall
        push_neg at hall
        exact hne (hactC_faithful τ hall)
      obtain ⟨y₀, hy₀⟩ := hex0
      have hy₀_ne : y₀ ≠ 0 := by
        intro h0
        rw [h0, (hactC_ring τ).1] at hy₀
        exact hy₀ rfl
      have hex_O : ∃ y : K, P_K 0 y ∧ act_C τ y ≠ y := by
        by_cases hval_ge : 0 ≤ valL F K y₀
        · exact ⟨y₀, Or.inr hval_ge, hy₀⟩
        · let u₀ : Kˣ := Units.mk0 y₀ hy₀_ne
          set y : K := ((u₀⁻¹ : Kˣ) : K)
          have hy_val : 0 ≤ valL F K y := by
            dsimp [y]
            rw [hvalK_inv u₀, Units.val_mk0]
            omega
          have hy_ne : act_C τ y ≠ y := by
            intro h_eq
            have h_mul1 : act_C τ (y₀ * y) = 1 := by
              have h1 : y₀ * y = 1 := by exact_mod_cast Units.mul_inv u₀
              rw [h1, (hactC_ring τ).2.1]
            rw [((hactC_ring τ).2.2 y₀ y).2.1, h_eq] at h_mul1
            have h_mul2 : y₀ * y = 1 := by exact_mod_cast Units.mul_inv u₀
            have h_cancel : act_C τ y₀ = y₀ := by
              calc act_C τ y₀ = act_C τ y₀ * (y₀ * y) := by rw [h_mul2, mul_one]
                _ = (act_C τ y₀ * y) * y₀ := by ring
                _ = 1 * y₀ := by rw [h_mul1]
                _ = y₀ := one_mul y₀
            exact hy₀ h_cancel
          exact ⟨y, Or.inr hy_val, hy_ne⟩
      obtain ⟨y, hyP, hτy_ne⟩ := hex_O
      set d : K := δ τ y
      have hd_ne : d ≠ 0 := sub_ne_zero.mpr hτy_ne
      set i₀ : ℕ := (valL F K d).toNat
      have hd_mem : P_K (i₀ + 1 : ℤ) d := hτ i₀ y hyP
      have hd_le : (i₀ + 1 : ℤ) ≤ valL F K d := hd_mem.resolve_left hd_ne
      omega
    have h_triv_of_pi : ∀ {τ : C}, P_K 2 (δ τ π) → τ = 1 := by
      intro τ hτπ
      have h1 : C_sub 1 τ := hC_sub1_of_pi hτπ
      have hall_succ : ∀ k : ℕ, C_sub (k + 1) τ := by
        intro k
        induction k with
        | zero => exact h1
        | succ k ih => exact h_C_step (by omega) ih
      apply h_C_sep τ
      intro i
      cases i with
      | zero => exact hC_sub0 τ
      | succ k => exact hall_succ k

    let u : C → K := fun τ => act_C τ π * π_inv
    have hu_one : u 1 = 1 := by
      dsimp [u]
      rw [hactC_one, hπ_mul]
    have hu_val0 : ∀ τ : C, u τ ≠ 0 ∧ valL F K (u τ) = 0 := by
      intro τ
      have h1_ne : act_C τ π ≠ 0 := by
        intro h0
        have hv := hactC_val τ π
        rw [h0, hvalK0, hϖ_K₀] at hv
        omega
      have h2_ne : π_inv ≠ 0 := Units.ne_zero ϖ_K₀⁻¹
      refine ⟨mul_ne_zero h1_ne h2_ne, ?_⟩
      dsimp [u]
      rw [hvalK_mul _ _ h1_ne h2_ne, hactC_val τ π, hϖ_K₀, hπ_inv_val]
      omega
    have hu_P0 : ∀ τ : C, P_K 0 (u τ) := fun τ => Or.inr (by rw [(hu_val0 τ).2])
    have hu_mul : ∀ τ : C, u τ * π = act_C τ π := by
      intro τ
      dsimp [u]
      rw [mul_assoc, hπ_inv_mul, mul_one]
    have hu_hom_mod1 : ∀ σ τ : C, P_K 1 (u (σ * τ) - u σ * u τ) := by
      intro σ τ
      have h_id : u (σ * τ) - u σ * u τ = δ σ (u τ) * u σ := by
        have h1 : act_C (σ * τ) π = act_C σ (u τ) * (u σ * π) := by
          rw [hactC_mul, ← hu_mul τ, ((hactC_ring σ).2.2 (u τ) π).2.1, hu_mul σ]
        dsimp [u, δ]
        rw [h1]
        calc act_C σ (u τ) * (u σ * π) * π_inv - act_C σ π * π_inv * u τ
            = act_C σ (u τ) * u σ * (π * π_inv) - u σ * u τ := by dsimp [u]; ring
          _ = (act_C σ (u τ) - u τ) * u σ := by rw [hπ_mul]; ring
      rw [h_id]
      simpa using hPK_mul (hC_sub0 σ (u τ) (hu_P0 τ)) (hu_P0 σ)
    have hu_pow_mod1 : ∀ (τ : C) (m : ℕ), P_K 1 (u (τ ^ m) - (u τ) ^ m) := by
      intro τ m
      induction m with
      | zero =>
        rw [pow_zero, pow_zero, hu_one, sub_self]
        exact hPK_zero 1
      | succ m ih =>
        have h_id : u (τ ^ (m + 1)) - (u τ) ^ (m + 1) =
            (u (τ * τ ^ m) - u τ * u (τ ^ m)) + u τ * (u (τ ^ m) - (u τ) ^ m) := by
          rw [pow_succ', pow_succ']
          ring
        rw [h_id]
        exact hPK_add 1 (hu_hom_mod1 τ (τ ^ m)) (by simpa using hPK_mul (hu_P0 τ) ih)
    have hu_pow_ℓ : ∀ τ : C, P_K 1 ((u τ) ^ ℓ - 1) := by
      intro τ
      have h1 : P_K 1 (u (τ ^ ℓ) - (u τ) ^ ℓ) := hu_pow_mod1 τ ℓ
      rw [hC_exp τ, hu_one] at h1
      have hneg := hPK_neg 1 h1
      rwa [neg_sub] at hneg
    have hu_inj : ∀ τ₁ τ₂ : C, P_K 1 (u τ₁ - u τ₂) → τ₁ = τ₂ := by
      intro τ₁ τ₂ hdiff
      have hmul_π : P_K (1 + 1) ((u τ₁ - u τ₂) * π) := hPK_mul hdiff hPK1_π
      have h_act_diff : (u τ₁ - u τ₂) * π = act_C τ₁ π - act_C τ₂ π := by
        rw [sub_mul, hu_mul, hu_mul]
      rw [h_act_diff] at hmul_π
      have hmap : P_K 2 (act_C τ₂⁻¹ (act_C τ₁ π - act_C τ₂ π)) :=
        (hPK_act 2 τ₂⁻¹ _).mpr hmul_π
      have h_δ : act_C τ₂⁻¹ (act_C τ₁ π - act_C τ₂ π) = δ (τ₂⁻¹ * τ₁) π := by
        dsimp [δ]
        rw [((hactC_ring τ₂⁻¹).2.2 _ _).2.2.2, ← hactC_mul, ← hactC_mul, inv_mul_cancel, hactC_one]
      rw [h_δ] at hmap
      exact (inv_mul_eq_one.mp (h_triv_of_pi hmap)).symm

    have hcard_gt1 : 1 < Fintype.card C := by
      rw [hcard_C]
      exact hPrime_MCK.one_lt
    haveI : Nontrivial C := Fintype.one_lt_card_iff_nontrivial.mp hcard_gt1
    obtain ⟨τ₀, hτ₀_ne1⟩ := exists_ne (1 : C)
    obtain ⟨z_raw, hz_raw_P0, hz_raw_mod⟩ := hResSurj_MCK (u τ₀) (hu_P0 τ₀)
    have hz_raw_ne0 : z_raw ≠ 0 := by
      intro h0
      rw [h0, map_zero, sub_zero] at hz_raw_mod
      have hge1 : 1 ≤ valL F K (u τ₀) := hz_raw_mod.resolve_left (hu_val0 τ₀).1
      rw [(hu_val0 τ₀).2] at hge1
      omega
    have hz_raw_val0 : valL F M_C z_raw = 0 := by
      have hge0 : 0 ≤ valL F M_C z_raw := hz_raw_P0.resolve_left hz_raw_ne0
      by_contra hne0
      have hge1 : 1 ≤ valL F M_C z_raw := by omega
      have hinc_P1 : P_K 1 (IntermediateField.inclusion hM_CK z_raw) :=
        hPK_inc 1 (by omega) (Or.inr hge1)
      have hu_P1 : P_K 1 (u τ₀) := by
        have heq : u τ₀ = (u τ₀ - IntermediateField.inclusion hM_CK z_raw) +
            IntermediateField.inclusion hM_CK z_raw := by ring
        rw [heq]
        exact hPK_add 1 hz_raw_mod hinc_P1
      have hu_ge1 : 1 ≤ valL F K (u τ₀) := hu_P1.resolve_left (hu_val0 τ₀).1
      rw [(hu_val0 τ₀).2] at hu_ge1
      omega
    let z₀ : M_Cˣ := Units.mk0 z_raw hz_raw_ne0
    have hz₀_val : valL F M_C (z₀ : M_C) = 0 := hz_raw_val0
    have ha_pow_P0 : ∀ m : ℕ, P_K 0 ((u τ₀) ^ m) := by
      intro m
      induction m with
      | zero => rw [pow_zero]; exact hPK_one
      | succ m ihm => rw [pow_succ']; simpa using hPK_mul (hu_P0 τ₀) ihm
    have h_pow_congr : ∀ m : ℕ,
        P_K 1 ((u τ₀) ^ m - (IntermediateField.inclusion hM_CK (z₀ : M_C)) ^ m) := by
      intro m
      induction m with
      | zero =>
        rw [pow_zero, pow_zero, sub_self]
        exact hPK_zero 1
      | succ m ih =>
        set a := u τ₀
        set b := IntermediateField.inclusion hM_CK (z₀ : M_C)
        have h_id : a ^ (m + 1) - b ^ (m + 1) = (a - b) * a ^ m + b * (a ^ m - b ^ m) := by
          rw [pow_succ', pow_succ']
          ring
        have hb_P0 : P_K 0 b := hPK_inc 0 (le_refl 0) hz_raw_P0
        rw [h_id]
        exact hPK_add 1
          (by simpa using hPK_mul hz_raw_mod (ha_pow_P0 m))
          (by simpa using hPK_mul hb_P0 ih)
    have hz₀_pow : z₀ ^ ℓ ∈ unitGroup F M_C 1 := by
      rw [hunitMCa 1 (le_refl 1) (z₀ ^ ℓ)]
      have h1 : P_K 1 ((u τ₀) ^ ℓ - (IntermediateField.inclusion hM_CK (z₀ : M_C)) ^ ℓ) :=
        h_pow_congr ℓ
      have h2 : P_K 1 ((u τ₀) ^ ℓ - 1) := hu_pow_ℓ τ₀
      have hdiff : P_K 1 (IntermediateField.inclusion hM_CK ((z₀ ^ ℓ : M_Cˣ) : M_C) - 1) := by
        have h_eq : IntermediateField.inclusion hM_CK ((z₀ ^ ℓ : M_Cˣ) : M_C) - 1 =
            ((u τ₀) ^ ℓ - 1) - ((u τ₀) ^ ℓ - (IntermediateField.inclusion hM_CK (z₀ : M_C)) ^ ℓ) := by
          rw [Units.val_pow_eq_pow_val, map_pow]
          ring
        rw [h_eq]
        exact hPK_sub 1 h2 h1
      rw [← map_one (IntermediateField.inclusion hM_CK), ← map_sub] at hdiff
      have hMC1 : P_MC 1 (((z₀ ^ ℓ : M_Cˣ) : M_C) - 1) := hPMC_of_inc1 hdiff
      rcases hMC1 with h0 | hge1
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge1
    have hz₀_not1 : z₀ ∉ unitGroup F M_C 1 := by
      intro hmem
      rw [hunitMCa 1 (le_refl 1) z₀] at hmem
      have hMC1 : P_MC 1 ((z₀ : M_C) - 1) := by
        rcases hmem with h1 | hge1
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge1
      have hK1 : P_K 1 (IntermediateField.inclusion hM_CK (z₀ : M_C) - u 1) := by
        rw [hu_one, ← map_one (IntermediateField.inclusion hM_CK), ← map_sub]
        exact hPK_inc 1 (by omega) hMC1
      have hu_diff : P_K 1 (u τ₀ - u 1) := by
        have h_eq : u τ₀ - u 1 =
            (u τ₀ - IntermediateField.inclusion hM_CK (z₀ : M_C)) +
              (IntermediateField.inclusion hM_CK (z₀ : M_C) - u 1) := by ring
        rw [h_eq]
        exact hPK_add 1 hz_raw_mod hK1
      exact hτ₀_ne1 (hu_inj τ₀ 1 hu_diff)

    have hres_MC_ker : ∀ g : M_C.fixingSubgroup, g.1 ∈ K.fixingSubgroup ↔ res_MC g = 1 := by
      intro g
      rw [IntermediateField.mem_fixingSubgroup_iff]
      refine ⟨fun hg => hactC_faithful (res_MC g) (fun y => Subtype.ext ?_), fun h1 x hx => ?_⟩
      · rw [hres_MC_apply g y]
        exact hg y.1 y.2
      · let y : K := ⟨x, hx⟩
        have h2 := hres_MC_apply g y
        rw [h1, hactC_one] at h2
        exact h2.symm

    refine ⟨z₀, hz₀_val, hz₀_pow, hz₀_not1, ?_⟩
    intro σ hσL hσ_not_MC hσz
    let z_σ : M_C := ⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩
    let φ_σ : K ≃ₐ[F] K :=
      { toFun := fun y => ⟨(σ : AbsGal F) y.1, hσ_maps_K σ hσL y.1 y.2⟩
        invFun := fun y => ⟨(σ⁻¹ : AbsGal F) y.1, hσ_maps_K σ⁻¹ (L.fixingSubgroup.inv_mem hσL) y.1 y.2⟩
        left_inv := fun y => Subtype.ext (by
          change (σ⁻¹ * σ : AbsGal F) y.1 = y.1
          rw [inv_mul_cancel, AlgEquiv.one_apply])
        right_inv := fun y => Subtype.ext (by
          change (σ * σ⁻¹ : AbsGal F) y.1 = y.1
          rw [mul_inv_cancel, AlgEquiv.one_apply])
        map_mul' := fun y₁ y₂ => Subtype.ext (map_mul (σ : AbsGal F) y₁.1 y₂.1)
        map_add' := fun y₁ y₂ => Subtype.ext (map_add (σ : AbsGal F) y₁.1 y₂.1)
        commutes' := fun r => Subtype.ext ((σ : AbsGal F).commutes r) }
    have hφ_σ_apply : ∀ y : K, ((φ_σ y : K) : AlgebraicClosure F) = (σ : AbsGal F) (y : AlgebraicClosure F) :=
      fun _ => rfl
    obtain ⟨g₀, hg₀⟩ := hres_MC_surj τ₀
    let c_σ : M_C.fixingSubgroup →* M_C.fixingSubgroup :=
      { toFun := fun g => ⟨σ * g.1 * σ⁻¹, hMin.1.2.2.1 σ hσL g.1 g.2⟩
        map_one' := Subtype.ext (by
          change σ * 1 * σ⁻¹ = 1
          rw [mul_one, mul_inv_cancel])
        map_mul' := fun g₁ g₂ => Subtype.ext (by
          change σ * (g₁.1 * g₂.1) * σ⁻¹ = (σ * g₁.1 * σ⁻¹) * (σ * g₂.1 * σ⁻¹)
          group) }
    let res_MC_conj : M_C.fixingSubgroup →* C := res_MC.comp c_σ
    let τ₁ : C := res_MC_conj g₀
    have h_conj_act : ∀ y : K, act_C τ₁ (φ_σ y) = φ_σ (act_C τ₀ y) := by
      intro y
      apply Subtype.ext
      change ((act_C (res_MC (c_σ g₀)) (φ_σ y) : K) : AlgebraicClosure F) =
        ((φ_σ (act_C τ₀ y) : K) : AlgebraicClosure F)
      rw [hres_MC_apply (c_σ g₀) (φ_σ y),
        hφ_σ_apply y, hφ_σ_apply (act_C τ₀ y), ← hg₀, hres_MC_apply g₀ y]
      have h_grp : σ * g₀.1 * σ⁻¹ * σ = σ * g₀.1 := by group
      change ((σ * g₀.1 * σ⁻¹ * σ : AbsGal F) y.1) = ((σ * g₀.1 : AbsGal F) y.1)
      rw [h_grp]
    set v_σ : K := φ_σ.symm π * π_inv
    have hv_σ_val0 : v_σ ≠ 0 ∧ valL F K v_σ = 0 := by
      have h1_ne : φ_σ.symm π ≠ 0 := by
        rw [map_ne_zero]
        exact Units.ne_zero ϖ_K₀
      have h2_ne : π_inv ≠ 0 := Units.ne_zero ϖ_K₀⁻¹
      refine ⟨mul_ne_zero h1_ne h2_ne, ?_⟩
      dsimp [v_σ]
      rw [hvalK_mul _ _ h1_ne h2_ne, hvalK_algEquiv φ_σ.symm π, hϖ_K₀, hπ_inv_val]
      omega
    have hv_σ_P0 : P_K 0 v_σ := Or.inr (by rw [hv_σ_val0.2])
    let u_vσ : Kˣ := Units.mk0 v_σ hv_σ_val0.1
    have hv_σ_inv_P0 : P_K 0 v_σ⁻¹ := by
      right
      have h1 : ((u_vσ⁻¹ : Kˣ) : K) = v_σ⁻¹ := by
        rw [Units.val_inv_eq_inv_val, Units.val_mk0]
      rw [← h1, hvalK_inv u_vσ, Units.val_mk0, hv_σ_val0.2, neg_zero]
    have hv_σ_mul : v_σ * π = φ_σ.symm π := by
      dsimp [v_σ]
      rw [mul_assoc, hπ_inv_mul, mul_one]
    have hφ_vσ_ne0 : φ_σ v_σ ≠ 0 := (map_ne_zero φ_σ).mpr hv_σ_val0.1
    have hu_τ₁_diff : P_K 1 (u τ₁ - φ_σ (u τ₀)) := by
      have h_act_vσ : act_C τ₁ π = φ_σ (act_C τ₀ v_σ * (u τ₀ * π)) := by
        calc act_C τ₁ π = act_C τ₁ (φ_σ (φ_σ.symm π)) := by rw [φ_σ.apply_symm_apply]
          _ = φ_σ (act_C τ₀ (φ_σ.symm π)) := h_conj_act (φ_σ.symm π)
          _ = φ_σ (act_C τ₀ (v_σ * π)) := by rw [hv_σ_mul]
          _ = φ_σ (act_C τ₀ v_σ * (u τ₀ * π)) := by
            rw [((hactC_ring τ₀).2.2 v_σ π).2.1, hu_mul τ₀]
      have h_π_φ : φ_σ π * π_inv = (φ_σ v_σ)⁻¹ := by
        apply mul_right_cancel₀ hφ_vσ_ne0
        rw [inv_mul_cancel₀ hφ_vσ_ne0]
        calc φ_σ π * π_inv * φ_σ v_σ = (φ_σ v_σ * φ_σ π) * π_inv := by ring
          _ = φ_σ (v_σ * π) * π_inv := by rw [← map_mul]
          _ = φ_σ (φ_σ.symm π) * π_inv := by rw [hv_σ_mul]
          _ = π * π_inv := by rw [φ_σ.apply_symm_apply]
          _ = 1 := hπ_mul
      have h_id : u τ₁ - φ_σ (u τ₀) = φ_σ (δ τ₀ v_σ * v_σ⁻¹ * u τ₀) := by
        have h_lhs : u τ₁ = act_C τ₁ π * π_inv := rfl
        have h_rhs : φ_σ (δ τ₀ v_σ * v_σ⁻¹ * u τ₀) =
            (φ_σ (act_C τ₀ v_σ) - φ_σ v_σ) * (φ_σ v_σ)⁻¹ * φ_σ (u τ₀) := by
          dsimp [δ]
          rw [map_mul, map_mul, map_sub, map_inv₀]
        rw [h_lhs, h_act_vσ, map_mul, map_mul, h_rhs]
        calc φ_σ (act_C τ₀ v_σ) * (φ_σ (u τ₀) * φ_σ π) * π_inv - φ_σ (u τ₀)
            = φ_σ (act_C τ₀ v_σ) * (φ_σ π * π_inv) * φ_σ (u τ₀) - φ_σ (u τ₀) := by ring
          _ = (φ_σ (act_C τ₀ v_σ) * (φ_σ v_σ)⁻¹ - 1) * φ_σ (u τ₀) := by
              rw [h_π_φ]; ring
          _ = ((φ_σ (act_C τ₀ v_σ) - φ_σ v_σ) * (φ_σ v_σ)⁻¹) * φ_σ (u τ₀) := by
              congr 1
              rw [sub_mul, mul_inv_cancel₀ hφ_vσ_ne0]
      rw [h_id, (hPK_map 1 φ_σ _)]
      have h1 : P_K 1 (δ τ₀ v_σ) := hC_sub0 τ₀ v_σ hv_σ_P0
      have h2 : P_K (1 + 0) (δ τ₀ v_σ * v_σ⁻¹) := hPK_mul h1 hv_σ_inv_P0
      simpa using hPK_mul h2 (hu_P0 τ₀)
    have hφ_z₀ : φ_σ (IntermediateField.inclusion hM_CK (z₀ : M_C)) =
        IntermediateField.inclusion hM_CK z_σ := by
      apply Subtype.ext
      rfl
    have hu_τ₁_mod : P_K 1 (u τ₁ - IntermediateField.inclusion hM_CK z_σ) := by
      have h_φ_mod : P_K 1 (φ_σ (u τ₀) - IntermediateField.inclusion hM_CK z_σ) := by
        rw [← hφ_z₀, ← map_sub, hPK_map 1 φ_σ]
        exact hz_raw_mod
      have h_eq : u τ₁ - IntermediateField.inclusion hM_CK z_σ =
          (u τ₁ - φ_σ (u τ₀)) + (φ_σ (u τ₀) - IntermediateField.inclusion hM_CK z_σ) := by ring
      rw [h_eq]
      exact hPK_add 1 hu_τ₁_diff h_φ_mod

    have h_not_P1_diff : ¬ P_MC 1 (z_σ - (z₀ : M_C)) := by
      intro hP1
      have hinc_P1 : P_K 1 (IntermediateField.inclusion hM_CK z_σ -
          IntermediateField.inclusion hM_CK (z₀ : M_C)) := by
        rw [← map_sub]
        exact hPK_inc 1 (by omega) hP1
      have hu_diff : P_K 1 (u τ₁ - u τ₀) := by
        have h_eq : u τ₁ - u τ₀ =
            (u τ₁ - IntermediateField.inclusion hM_CK z_σ) +
            (IntermediateField.inclusion hM_CK z_σ - IntermediateField.inclusion hM_CK (z₀ : M_C)) -
            (u τ₀ - IntermediateField.inclusion hM_CK (z₀ : M_C)) := by ring
        rw [h_eq]
        exact hPK_sub 1 (hPK_add 1 hu_τ₁_mod hinc_P1) hz_raw_mod
      have hτ₁_eq : τ₁ = τ₀ := hu_inj τ₁ τ₀ hu_diff
      haveI : Fact (Nat.Prime ℓ) := ⟨hPrime_MCK⟩
      have h_ord : orderOf τ₀ = ℓ :=
        orderOf_eq_prime (hC_exp τ₀) hτ₀_ne1
      have h_card_zpow : Nat.card (Subgroup.zpowers τ₀) = Nat.card C := by
        rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card,
          Fintype.card_zpowers, h_ord, hcard_C]
      have h_zpow_top : Subgroup.zpowers τ₀ = ⊤ :=
        Subgroup.eq_top_of_card_eq (Subgroup.zpowers τ₀) h_card_zpow
      have h_comm_all : ∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup := by
        intro τ hτMC
        let g : M_C.fixingSubgroup := ⟨τ, hτMC⟩
        have hg_mem : res_MC g ∈ Subgroup.zpowers τ₀ := by
          rw [h_zpow_top]
          exact Subgroup.mem_top (res_MC g)
        obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hg_mem
        let h : M_C.fixingSubgroup := g * (g₀ ^ k)⁻¹
        have h_res_h : res_MC h = 1 := by
          dsimp [h]
          rw [map_mul, map_inv, map_zpow, hg₀, hk, mul_inv_cancel]
        have hh_K : h.1 ∈ K.fixingSubgroup := (hres_MC_ker h).mpr h_res_h
        have hc_h_K : σ * h.1 * σ⁻¹ ∈ K.fixingSubgroup := hGal.2.2.1 σ hσL h.1 hh_K
        have h_res_ch : res_MC_conj h = 1 :=
          (hres_MC_ker ⟨σ * h.1 * σ⁻¹, hMin.1.2.2.1 σ hσL h.1 h.2⟩).mp hc_h_K
        have h_res_cg : res_MC_conj g = res_MC g := by
          dsimp [h] at h_res_ch
          rw [map_mul, map_inv, map_zpow] at h_res_ch
          change res_MC_conj g * (τ₁ ^ k)⁻¹ = 1 at h_res_ch
          rw [hτ₁_eq, hk, mul_inv_eq_one] at h_res_ch
          exact h_res_ch
        let comm : M_C.fixingSubgroup :=
          ⟨σ * τ * σ⁻¹ * τ⁻¹, M_C.fixingSubgroup.mul_mem
            (hMin.1.2.2.1 σ hσL τ hτMC) (M_C.fixingSubgroup.inv_mem hτMC)⟩
        have h_comm_ker : res_MC comm = 1 := by
          have h_eq : comm = ⟨σ * g.1 * σ⁻¹, hMin.1.2.2.1 σ hσL g.1 g.2⟩ * g⁻¹ :=
            Subtype.ext rfl
          rw [h_eq, map_mul, map_inv]
          change res_MC_conj g * (res_MC g)⁻¹ = 1
          rw [h_res_cg, mul_inv_cancel]
        exact (hres_MC_ker comm).mpr h_comm_ker
      exact hσ_not_MC (hCentralizer σ hσL h_comm_all)

    have hz_σ_P0 : P_MC 0 z_σ := by
      have h_inc_P0 : P_K 0 (IntermediateField.inclusion hM_CK z_σ) := by
        rw [← hφ_z₀, hPK_map 0 φ_σ]
        exact hPK_inc 0 (le_refl 0) hz_raw_P0
      by_cases hzσ0 : z_σ = 0
      · exact Or.inl hzσ0
      · right
        have h_inc_ne0 : IntermediateField.inclusion hM_CK z_σ ≠ 0 :=
          fun h => hzσ0 ((map_eq_zero_iff _ (IntermediateField.inclusion hM_CK).injective).mp h)
        have hge0 : 0 ≤ valL F K (IntermediateField.inclusion hM_CK z_σ) :=
          h_inc_P0.resolve_left h_inc_ne0
        rw [hValAlg_MCK z_σ] at hge0
        have hℓ_pos : (0 : ℤ) < (ℓ : ℤ) := by exact_mod_cast hPrime_MCK.pos
        by_contra hlt
        have hle_neg1 : valL F M_C z_σ ≤ -1 := by omega
        have hprod_lt0 : (ℓ : ℤ) * valL F M_C z_σ < 0 := by nlinarith
        dsimp [ℓ] at hprod_lt0
        omega
    have hdiff_P0 : P_MC 0 (z_σ - (z₀ : M_C)) := by
      rw [sub_eq_add_neg]
      refine hvalMC_add 0 z_σ (-(z₀ : M_C)) hz_σ_P0 ?_
      right
      rw [hvalMC_neg, hz₀_val]
    change ¬ (z_σ - (z₀ : M_C) = 0 ∨ 1 ≤ valL F M_C (z_σ - (z₀ : M_C))) at h_not_P1_diff
    push_neg at h_not_P1_diff
    obtain ⟨hdiff_ne0, hdiff_lt1⟩ := h_not_P1_diff
    have hdiff_ge0 : 0 ≤ valL F M_C (z_σ - (z₀ : M_C)) := hdiff_P0.resolve_left hdiff_ne0
    dsimp [z_σ] at hdiff_ge0 hdiff_lt1
    exact ⟨hdiff_ne0, by omega⟩

  have hs2 : FiniteDimensional L (IntermediateField.extendScalars hLM_C) ∧
      ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → M_C → M_C),
        Fintype.card G = f_H ∧
        (∀ z : M_C, act 1 z = z) ∧
        (∀ (σ τ : G) (z : M_C), act (σ * τ) z = act σ (act τ z)) ∧
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ z₁ z₂ : M_C,
            act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
            act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
            act σ (-z₁) = -act σ z₁)) ∧
        (∀ (σ : G) (x : L),
          act σ (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x) ∧
        (∀ σ : G, (∀ z : M_C, act σ z = z) → σ = 1) ∧
        (∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z) ∧
        (∀ z : M_C, IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G, act σ z) ∧
        (∀ z : M_C, IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G, act σ z) ∧
        (∀ (σ : G), σ ≠ 1 → ∃ τ ∈ L.fixingSubgroup, τ ∉ M_C.fixingSubgroup ∧
          ∀ z : M_C, ∃ hτz : (τ : AbsGal F) (z : AlgebraicClosure F) ∈ M_C,
            act σ z = ⟨(τ : AbsGal F) (z : AlgebraicClosure F), hτz⟩) := by
    have hGalLMC : IsGaloisExt F L M_C := hMin.1
    let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
    let e_MC : M_C ≃ₐ[F] M_C' :=
      { toExtendScalars F hLM_C with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM_C).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    have hFinLMC' : FiniteDimensional L M_C' := by
      haveI : FiniteDimensional F M_C' := Module.Finite.equiv e_MC.toLinearEquiv
      haveI : IsScalarTower F L M_C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
      exact Module.Finite.of_restrictScalars_finite F L M_C'
    haveI : FiniteDimensional L M_C' := hFinLMC'
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hGalLMC' : IsGalois L ↥M_C' := by
      haveI : Algebra.IsSeparable L M_C' := hGalLMC.2.2.2 hLM_C
      refine helper_isGalois L (AlgebraicClosure F) M_C' (fun σ τ hτ => ?_)
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτMC : τ_F.1 ∈ M_C.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLM_C).mpr hx)
      have hconjMC : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
        hGalLMC.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτMC
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjMC
      exact hconjMC x ((IntermediateField.mem_extendScalars hLM_C).mp hx)
    haveI : IsGalois L ↥M_C' := hGalLMC'
    haveI : Normal L ↥M_C' := IsGalois.to_normal
    let G : Type u := (M_C' ≃ₐ[L] M_C')
    have hcard_G : Fintype.card G = Module.finrank L M_C' :=
      Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank L M_C')
    let fromExtendScalars : M_C' →+* M_C := e_MC.symm.toRingHom
    let act : G → M_C → M_C := fun σ z => fromExtendScalars (σ (toExtendScalars F hLM_C z))
    have hact_one : ∀ z : M_C, act 1 z = z := fun _ => rfl
    have hact_mul : ∀ (σ τ : G) (z : M_C), act (σ * τ) z = act σ (act τ z) := fun _ _ _ => rfl
    have hact_ring : ∀ σ : G,
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
          act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
          act σ (-z₁) = -act σ z₁) := by
      intro σ
      refine ⟨by change fromExtendScalars (σ 0) = 0; rw [map_zero, map_zero],
        by change fromExtendScalars (σ 1) = 1; rw [map_one, map_one],
        fun z₁ z₂ => ⟨?_, ?_, ?_⟩⟩
      · change fromExtendScalars (σ (toExtendScalars F hLM_C z₁ + toExtendScalars F hLM_C z₂)) = _
        rw [map_add, map_add]
      · change fromExtendScalars (σ (toExtendScalars F hLM_C z₁ * toExtendScalars F hLM_C z₂)) = _
        rw [map_mul, map_mul]
      · change fromExtendScalars (σ (-toExtendScalars F hLM_C z₁)) = _
        rw [map_neg, map_neg]
    have hact_incl : ∀ (σ : G) (x : L),
        act σ (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x := by
      intro σ x
      change fromExtendScalars (σ (algebraMap L M_C' x)) = IntermediateField.inclusion hLM_C x
      rw [σ.commutes x]
      rfl
    have hact_faithful : ∀ σ : G, (∀ z : M_C, act σ z = z) → σ = 1 := by
      intro σ h
      apply AlgEquiv.ext
      intro y
      exact congrArg (toExtendScalars F hLM_C) (h (fromExtendScalars y))
    have hact_val : ∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z := by
      intro σ z
      let φ_σ : M_C ≃ₐ[F] M_C := e_MC.trans ((σ.restrictScalars F).trans e_MC.symm)
      have hφ : φ_σ z = act σ z := rfl
      unfold valL relVal
      rw [← hφ, Algebra.norm_eq_of_algEquiv φ_σ z]
    have hact_trace : ∀ z : M_C,
        IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G, act σ z := by
      intro z
      have h1 := congrArg fromExtendScalars
        (trace_eq_sum_automorphisms (K := L) (L := M_C') (toExtendScalars F hLM_C z))
      exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hLM_C z)) Finset.univ)
    have hact_norm : ∀ z : M_C,
        IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G, act σ z := by
      intro z
      have h1 := congrArg fromExtendScalars
        (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLM_C z))
      exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hLM_C z)) Finset.univ)
    have hact_lift : ∀ (σ : G), σ ≠ 1 → ∃ τ ∈ L.fixingSubgroup, τ ∉ M_C.fixingSubgroup ∧
        ∀ z : M_C, ∃ hτz : (τ : AbsGal F) (z : AlgebraicClosure F) ∈ M_C,
          act σ z = ⟨(τ : AbsGal F) (z : AlgebraicClosure F), hτz⟩ := by
      intro σ hσ
      obtain ⟨σ_L, hσ_L⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) σ
      let τ_sub : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ_L
      have hτ_act : ∀ z : M_C, ((act σ z : M_C) : AlgebraicClosure F) =
          (τ_sub.1 : AbsGal F) (z : AlgebraicClosure F) := by
        intro z
        have h1 : σ (toExtendScalars F hLM_C z) =
            (AlgEquiv.restrictNormalHom ↥M_C' σ_L) (toExtendScalars F hLM_C z) := by
          rw [hσ_L]
        have h2 : ((σ (toExtendScalars F hLM_C z) : ↥M_C') : AlgebraicClosure F) =
            σ_L (z : AlgebraicClosure F) := by
          rw [h1, AlgEquiv.restrictNormalHom_apply]
          rfl
        exact h2
      have hτ_not_MC : τ_sub.1 ∉ M_C.fixingSubgroup := by
        intro hmem
        rw [IntermediateField.mem_fixingSubgroup_iff] at hmem
        apply hσ
        apply hact_faithful
        intro z
        apply Subtype.ext
        rw [hτ_act z]
        exact hmem (z : AlgebraicClosure F) z.2
      refine ⟨τ_sub.1, τ_sub.2, hτ_not_MC, fun z => ?_⟩
      have hmem : (τ_sub.1 : AbsGal F) (z : AlgebraicClosure F) ∈ M_C := by
        rw [← hτ_act z]
        exact (act σ z).2
      refine ⟨hmem, Subtype.ext (hτ_act z)⟩
    exact ⟨hFinLMC', G, inferInstance, inferInstance, act, hcard_G, hact_one, hact_mul,
      hact_ring, hact_incl, hact_faithful, hact_val, hact_trace, hact_norm, hact_lift⟩

  obtain ⟨z₀, hz₀_val, hz₀_pow, hz₀_not1, hz₀_move⟩ := hs1
  obtain ⟨hFinLMC', G, hGroupG, hFinG, act, hcard_G, hact_one, hact_mul,
    hact_ring, hact_incl, hact_faithful, hact_val, hact_trace, hact_norm, hact_lift⟩ := hs2
  letI : Group G := hGroupG
  letI : Fintype G := hFinG
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLM_C) := hFinLMC'
  have hz₀_act_move : ∀ σ : G, σ ≠ 1 →
      act σ (z₀ : M_C) - (z₀ : M_C) ≠ 0 ∧ valL F M_C (act σ (z₀ : M_C) - (z₀ : M_C)) = 0 := by
    intro σ hσ
    obtain ⟨τ, hτL, hτMC, hτ_act⟩ := hact_lift σ hσ
    obtain ⟨hτz, hact_eq⟩ := hτ_act (z₀ : M_C)
    rw [hact_eq]
    exact hz₀_move τ hτL hτMC hτz

  have hs3 :
      resDeg F M_C = f_H * resDeg F L ∧
      qL F M_C = (qL F L) ^ f_H ∧
      (∀ z : M_C, valL F L (normLM F hLM_C z) = (f_H : ℤ) * valL F M_C z) ∧
      (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z))) ∧
      (∀ (d : ℕ), 1 ≤ d → ∀ z : M_C, (z = 0 ∨ (d : ℤ) ≤ valL F M_C z) →
        (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
          (2 * d : ℤ) ≤ valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)))) ∧
      (∃ y₁ : M_C, (y₁ = 0 ∨ 0 ≤ valL F M_C y₁) ∧ traceLM F hLM_C y₁ = 1) := by
    obtain ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj,
      hvalL_add, _, _, _⟩ := hvalL_props
    obtain ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv, hvalMC_surj,
      hvalMC_add, _, _, _⟩ := hvalMC_props
    let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
    let P_MC : ℤ → M_C → Prop := fun k z => z = 0 ∨ k ≤ valL F M_C z
    let P_L : ℤ → L → Prop := fun k x => x = 0 ∨ k ≤ valL F L x
    have hPMC_zero : ∀ k : ℤ, P_MC k 0 := fun _ => Or.inl rfl
    have hPMC_one : P_MC 0 1 := Or.inr (by omega)
    have hPMC_neg : ∀ (k : ℤ) {z : M_C}, P_MC k z → P_MC k (-z) := by
      intro k z hz
      rcases hz with rfl | hz
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hvalMC_neg]; exact hz)
    have hPMC_add : ∀ (k : ℤ) {z₁ z₂ : M_C}, P_MC k z₁ → P_MC k z₂ → P_MC k (z₁ + z₂) :=
      fun k {z₁ z₂} h1 h2 => hvalMC_add k z₁ z₂ h1 h2
    have hPMC_sub : ∀ (k : ℤ) {z₁ z₂ : M_C}, P_MC k z₁ → P_MC k z₂ → P_MC k (z₁ - z₂) := by
      intro k z₁ z₂ h1 h2
      rw [sub_eq_add_neg]
      exact hPMC_add k h1 (hPMC_neg k h2)
    have hPMC_mul : ∀ {k₁ k₂ : ℤ} {z₁ z₂ : M_C}, P_MC k₁ z₁ → P_MC k₂ z₂ → P_MC (k₁ + k₂) (z₁ * z₂) := by
      intro k₁ k₂ z₁ z₂ h1 h2
      by_cases hz₁ : z₁ = 0
      · exact Or.inl (by rw [hz₁, zero_mul])
      · by_cases hz₂ : z₂ = 0
        · exact Or.inl (by rw [hz₂, mul_zero])
        · right
          rw [hvalMC_mul z₁ z₂ hz₁ hz₂]
          have h1' := h1.resolve_left hz₁
          have h2' := h2.resolve_left hz₂
          omega
    have hPMC_mul0 : ∀ {k : ℤ} {z₁ z₂ : M_C}, P_MC k z₁ → P_MC 0 z₂ → P_MC k (z₁ * z₂) := by
      intro k z₁ z₂ h1 h2
      simpa using hPMC_mul h1 h2
    have hPMC_sum_nat : ∀ (T : Finset ℕ) (f : ℕ → M_C) (k : ℤ),
        (∀ a ∈ T, P_MC k (f a)) → P_MC k (∑ a ∈ T, f a) := by
      intro T f k hT
      induction' T using Finset.induction_on with a T' ha ih
      · exact Or.inl Finset.sum_empty
      · rw [Finset.sum_insert ha]
        exact hPMC_add k (hT a (Finset.mem_insert_self a T'))
          (ih (fun b hb => hT b (Finset.mem_insert_of_mem hb)))
    have hPMC_sum_G : ∀ (T : Finset G) (f : G → M_C) (k : ℤ),
        (∀ a ∈ T, P_MC k (f a)) → P_MC k (∑ a ∈ T, f a) := by
      intro T f k hT
      induction' T using Finset.induction_on with a T' ha ih
      · exact Or.inl Finset.sum_empty
      · rw [Finset.sum_insert ha]
        exact hPMC_add k (hT a (Finset.mem_insert_self a T'))
          (ih (fun b hb => hT b (Finset.mem_insert_of_mem hb)))
    have hz₀_pow_P0 : ∀ j : ℕ, P_MC 0 ((z₀ : M_C) ^ j) := by
      intro j
      induction j with
      | zero => rw [pow_zero]; exact hPMC_one
      | succ j ih =>
        rw [pow_succ']
        exact hPMC_mul0 (Or.inr (by omega)) ih

    let S : Finset G := (Finset.univ : Finset G).erase 1
    let Q : Polynomial M_C := ∏ τ ∈ S, (Polynomial.X - Polynomial.C (act τ (z₀ : M_C)))
    let Δ : M_C := ∏ τ ∈ S, ((z₀ : M_C) - act τ (z₀ : M_C))
    have h_factor_val : ∀ τ ∈ S,
        (z₀ : M_C) - act τ (z₀ : M_C) ≠ 0 ∧ valL F M_C ((z₀ : M_C) - act τ (z₀ : M_C)) = 0 := by
      intro τ hτ
      have hne1 : τ ≠ 1 := (Finset.mem_erase.mp hτ).1
      obtain ⟨hne, hval⟩ := hz₀_act_move τ hne1
      have hneg_eq : (z₀ : M_C) - act τ (z₀ : M_C) = -(act τ (z₀ : M_C) - (z₀ : M_C)) := by ring
      refine ⟨?_, ?_⟩
      · rw [hneg_eq, neg_ne_zero]
        exact hne
      · rw [hneg_eq, hvalMC_neg]
        exact hval
    have hΔ_props : Δ ≠ 0 ∧ valL F M_C Δ = 0 := by
      suffices h : ∀ T : Finset G,
          (∀ τ ∈ T, (z₀ : M_C) - act τ (z₀ : M_C) ≠ 0 ∧ valL F M_C ((z₀ : M_C) - act τ (z₀ : M_C)) = 0) →
          (∏ τ ∈ T, ((z₀ : M_C) - act τ (z₀ : M_C))) ≠ 0 ∧
            valL F M_C (∏ τ ∈ T, ((z₀ : M_C) - act τ (z₀ : M_C))) = 0 by
        exact h S h_factor_val
      intro T
      induction' T using Finset.induction_on with τ T' hτ ih
      · intro _
        rw [Finset.prod_empty]
        exact ⟨one_ne_zero, hvalMC1⟩
      · intro hT
        rw [Finset.prod_insert hτ]
        obtain ⟨h1_ne, h1_val⟩ := hT τ (Finset.mem_insert_self τ T')
        obtain ⟨h2_ne, h2_val⟩ := ih (fun σ hσ => hT σ (Finset.mem_insert_of_mem hσ))
        refine ⟨mul_ne_zero h1_ne h2_ne, ?_⟩
        rw [hvalMC_mul _ _ h1_ne h2_ne, h1_val, h2_val, add_zero]
    have hΔ_ne0 : Δ ≠ 0 := hΔ_props.1
    have hΔ_val0 : valL F M_C Δ = 0 := hΔ_props.2
    let u_Δ : M_Cˣ := Units.mk0 Δ hΔ_ne0
    have hΔ_inv_val0 : valL F M_C Δ⁻¹ = 0 := by
      have h1 : ((u_Δ⁻¹ : M_Cˣ) : M_C) = Δ⁻¹ := by
        rw [Units.val_inv_eq_inv_val, Units.val_mk0]
      rw [← h1, hvalMC_inv u_Δ, Units.val_mk0, hΔ_val0, neg_zero]
    have hΔ_inv_P0 : P_MC 0 Δ⁻¹ := Or.inr (by omega)

    let IsIntPoly : Polynomial M_C → Prop := fun A => ∀ j : ℕ, P_MC 0 (A.coeff j)
    have hInt_one : IsIntPoly 1 := by
      intro j
      rw [Polynomial.coeff_one]
      split_ifs
      · exact hPMC_one
      · exact hPMC_zero 0
    have hInt_linear : ∀ a : M_C, P_MC 0 a → IsIntPoly (Polynomial.X - Polynomial.C a) := by
      intro a ha j
      rw [Polynomial.coeff_sub, Polynomial.coeff_X, Polynomial.coeff_C]
      have hX : P_MC 0 (if 1 = j then (1 : M_C) else 0) := by
        split_ifs
        · exact hPMC_one
        · exact hPMC_zero 0
      have hC : P_MC 0 (if j = 0 then a else 0) := by
        split_ifs
        · exact ha
        · exact hPMC_zero 0
      exact hPMC_sub 0 hX hC
    have hInt_mul : ∀ {A B : Polynomial M_C}, IsIntPoly A → IsIntPoly B → IsIntPoly (A * B) := by
      intro A B hA hB j
      rw [Polynomial.coeff_mul]
      suffices h : ∀ T : Finset (ℕ × ℕ), P_MC 0 (∑ p ∈ T, A.coeff p.1 * B.coeff p.2) by
        exact h (Finset.antidiagonal j)
      intro T
      induction' T using Finset.induction_on with p T' hp ih
      · exact Or.inl Finset.sum_empty
      · rw [Finset.sum_insert hp]
        have h1 : P_MC 0 (A.coeff p.1) := hA p.1
        have h2 : P_MC 0 (B.coeff p.2) := hB p.2
        exact hPMC_add 0 (hPMC_mul0 h1 h2) ih
    have hQ_int : IsIntPoly Q := by
      suffices h : ∀ T : Finset G, IsIntPoly (∏ τ ∈ T, (Polynomial.X - Polynomial.C (act τ (z₀ : M_C)))) by
        exact h S
      intro T
      induction' T using Finset.induction_on with τ T' hτ ih
      · rw [Finset.prod_empty]
        exact hInt_one
      · rw [Finset.prod_insert hτ]
        have h_act_P0 : P_MC 0 (act τ (z₀ : M_C)) := Or.inr (by rw [hact_val τ (z₀ : M_C), hz₀_val])
        exact hInt_mul (hInt_linear (act τ (z₀ : M_C)) h_act_P0) ih

    let n : ℕ := Q.natDegree + 1
    let φ : G → (M_C →+* M_C) := fun σ =>
      { toFun := act σ
        map_one' := (hact_ring σ).2.1
        map_mul' := fun x y => ((hact_ring σ).2.2 x y).2.1
        map_zero' := (hact_ring σ).1
        map_add' := fun x y => ((hact_ring σ).2.2 x y).1 }
    have h_orth : ∀ σ : G,
        (∑ j ∈ Finset.range n, act σ (Q.coeff j) * (z₀ : M_C) ^ j) = if σ = 1 then Δ else 0 := by
      intro σ
      have h_sum : (∑ j ∈ Finset.range n, act σ (Q.coeff j) * (z₀ : M_C) ^ j) =
          Polynomial.eval (z₀ : M_C) (Polynomial.map (φ σ) Q) := by
        rw [Polynomial.eval_map, Polynomial.eval₂_eq_sum_range]
        rfl
      have h_prod : Polynomial.eval (z₀ : M_C) (Polynomial.map (φ σ) Q) =
          ∏ τ ∈ S, ((z₀ : M_C) - act (σ * τ) (z₀ : M_C)) := by
        dsimp [Q]
        rw [Polynomial.map_prod, Polynomial.eval_prod]
        refine Finset.prod_congr rfl fun τ _ => ?_
        rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
          Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
        change (z₀ : M_C) - act σ (act τ (z₀ : M_C)) = (z₀ : M_C) - act (σ * τ) (z₀ : M_C)
        rw [hact_mul]
      rw [h_sum, h_prod]
      split_ifs with hσ
      · subst hσ
        dsimp [Δ]
        refine Finset.prod_congr rfl fun τ _ => ?_
        rw [one_mul]
      · apply Finset.prod_eq_zero (i := σ⁻¹)
        · exact Finset.mem_erase.mpr ⟨inv_ne_one.mpr hσ, Finset.mem_univ σ⁻¹⟩
        · rw [mul_inv_cancel, hact_one, sub_self]

    have h_lagrange : ∀ w : M_C,
        w = ∑ j ∈ Finset.range n,
          IntermediateField.inclusion hLM_C (traceLM F hLM_C (w * Q.coeff j * Δ⁻¹)) * (z₀ : M_C) ^ j := by
      intro w
      have h_step : ∀ σ : G,
          (∑ j ∈ Finset.range n, act σ (w * Q.coeff j * Δ⁻¹) * (z₀ : M_C) ^ j) =
            if σ = 1 then w else 0 := by
        intro σ
        have h_lhs : (∑ j ∈ Finset.range n, act σ (w * Q.coeff j * Δ⁻¹) * (z₀ : M_C) ^ j) =
            act σ (w * Δ⁻¹) * (∑ j ∈ Finset.range n, act σ (Q.coeff j) * (z₀ : M_C) ^ j) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          have h_mul1 := ((hact_ring σ).2.2 (w * Δ⁻¹) (Q.coeff j)).2.1
          have h_eq : w * Q.coeff j * Δ⁻¹ = w * Δ⁻¹ * Q.coeff j := by ring
          rw [h_eq, h_mul1, mul_assoc]
        rw [h_lhs, h_orth σ]
        split_ifs with hσ
        · subst hσ
          rw [hact_one, inv_mul_cancel_right₀ hΔ_ne0 w]
        · rw [mul_zero]
      have h_sum_G : (∑ σ : G, ∑ j ∈ Finset.range n, act σ (w * Q.coeff j * Δ⁻¹) * (z₀ : M_C) ^ j) = w := by
        calc (∑ σ : G, ∑ j ∈ Finset.range n, act σ (w * Q.coeff j * Δ⁻¹) * (z₀ : M_C) ^ j)
          _ = ∑ σ : G, (if σ = 1 then w else 0) := by
            refine Finset.sum_congr rfl fun σ _ => h_step σ
          _ = w := by simp
      rw [Finset.sum_comm] at h_sum_G
      conv_lhs => rw [← h_sum_G]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← Finset.sum_mul, hact_trace (w * Q.coeff j * Δ⁻¹)]

    have haddVal0 : addVal F 0 = 0 := dif_pos rfl
    have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
        (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
        0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
      intro M _ hsurj
      have hrel0 : relVal F M 0 = 0 := by
        unfold relVal
        rw [Algebra.norm_zero, haddVal0]
      have hrel1 : relVal F M 1 = 0 := by
        unfold relVal
        rw [map_one, haddVal1]
      have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
        intro x y hx hy
        unfold relVal
        rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
      have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
        intro u
        have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
        rw [Units.mul_inv, hrel1] at hmul
        omega
      have hrel_pow : ∀ (u : Mˣ) (k : ℕ),
          relVal F M (((u ^ k : Mˣ) : M)) = (k : ℤ) * relVal F M (u : M) := by
        intro u k
        induction k with
        | zero => simp [hrel1]
        | succ k ih =>
          rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
          push_cast
          ring
      have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
          relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
        intro u m
        cases m with
        | ofNat k =>
          change relVal F M (((u ^ (k : ℤ) : Mˣ) : M)) = (k : ℤ) * relVal F M (u : M)
          rw [zpow_natCast, hrel_pow]
        | negSucc k =>
          rw [zpow_negSucc, hrel_inv (u ^ (k + 1)), hrel_pow u (k + 1), Int.negSucc_eq]
          push_cast
          ring
      let S_M : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
      have hres_ne : resDeg F M ≠ 0 := by
        intro h0
        obtain ⟨c₁, hc₁⟩ := hsurj 1
        unfold valL at hc₁
        rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
        omega
      have hS_nonempty : S_M.Nonempty := by
        by_contra hne
        have hempty : S_M = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
        have h0 : resDeg F M = 0 := by
          unfold resDeg
          change sInf S_M = 0
          rw [hempty, Nat.sInf_empty]
        exact hres_ne h0
      have hfM_mem : resDeg F M ∈ S_M := Nat.sInf_mem hS_nonempty
      obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
      let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
      have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
      have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
      have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
      refine ⟨hfM_pos, fun z => ?_⟩
      by_cases hz : z = 0
      · unfold valL
        rw [hz, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F M : ℤ)
        set q_z : ℤ := valL F M z
        set r_z : ℤ := relVal F M z % f
        have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
        have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
        have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
        have hr_zero : r_z = 0 := by
          by_contra hr_ne
          let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
          have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
          have hrel_y : relVal F M y = r_z := by
            dsimp [y]
            rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
            linarith
          let k : ℕ := r_z.toNat
          have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F M := by omega
          have hk_mem : k ∈ S_M := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hvalL_surj
    obtain ⟨hresDeg_MC_pos, hdiv_MC⟩ := hrelVal_div M_C hvalMC_surj
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hresDeg_L_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hfMC_int_pos : (0 : ℤ) < (resDeg F M_C : ℤ) := Nat.cast_pos.mpr hresDeg_MC_pos
    have hfMC_int_ne : (resDeg F M_C : ℤ) ≠ 0 := ne_of_gt hfMC_int_pos

    let e_MC : M_C ≃ₐ[F] M_C' :=
      { toExtendScalars F hLM_C with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM_C).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F M_C' := Module.Finite.equiv e_MC.toLinearEquiv
    haveI : IsScalarTower F L M_C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hrelVal_norm : ∀ z : M_C, relVal F L (normLM F hLM_C z) = relVal F M_C z := by
      intro z
      change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLM_C z))) =
        addVal F (Algebra.norm F z)
      have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLM_C z)) =
          Algebra.norm F (toExtendScalars F hLM_C z) := Algebra.norm_norm
      have h2 : Algebra.norm F z = Algebra.norm F (toExtendScalars F hLM_C z) :=
        Algebra.norm_eq_of_algEquiv e_MC z
      rw [h1, ← h2]
    have hnorm_inc : ∀ x : L,
        normLM F hLM_C (IntermediateField.inclusion hLM_C x) = x ^ f_H := by
      intro x
      change Algebra.norm L (algebraMap L M_C' x) = x ^ f_H
      exact Algebra.norm_algebraMap x
    have hvalL_pow : ∀ (x : L) (k : ℕ), x ≠ 0 → valL F L (x ^ k) = (k : ℤ) * valL F L x := by
      intro x k hx
      induction k with
      | zero => rw [pow_zero, hvalL1, Nat.cast_zero, zero_mul]
      | succ k ih =>
        rw [pow_succ', hvalL_mul x (x ^ k) hx (pow_ne_zero k hx), ih]
        push_cast
        ring

    obtain ⟨ϖ_L, hϖ_L⟩ := hvalL_surj 1
    obtain ⟨ϖ_MC, hϖ_MC⟩ := hvalMC_surj 1
    set e : ℤ := valL F M_C (IntermediateField.inclusion hLM_C (ϖ_L : L))
    set f : ℤ := valL F L (normLM F hLM_C (ϖ_MC : M_C))
    have h_resDeg_rel : (resDeg F M_C : ℤ) = (resDeg F L : ℤ) * f := by
      have h1 := hrelVal_norm (ϖ_MC : M_C)
      rw [hdiv_L, hdiv_MC, hϖ_MC, mul_one] at h1
      exact h1.symm
    have h_val_norm_f : ∀ z : M_C, valL F L (normLM F hLM_C z) = f * valL F M_C z := by
      intro z
      have h1 := hrelVal_norm z
      rw [hdiv_L, hdiv_MC, h_resDeg_rel, mul_assoc] at h1
      exact mul_left_cancel₀ hfL_int_ne h1
    have h_fe : (f_H : ℤ) = f * e := by
      have h1 := h_val_norm_f (IntermediateField.inclusion hLM_C (ϖ_L : L))
      rw [hnorm_inc (ϖ_L : L), hvalL_pow (ϖ_L : L) f_H (Units.ne_zero ϖ_L), hϖ_L, mul_one] at h1
      exact h1
    have hf_pos : 0 < f := by
      by_contra hle
      have h0 : (resDeg F M_C : ℤ) ≤ 0 := by nlinarith [h_resDeg_rel, hfL_int_pos]
      omega
    have he_pos : 1 ≤ e := by
      have hfH_pos : (1 : ℤ) < (f_H : ℤ) := by exact_mod_cast hf_H_gt1
      by_contra hle
      have he0 : e ≤ 0 := by omega
      have h0 : (f_H : ℤ) ≤ 0 := by nlinarith [h_fe, hf_pos, he0]
      omega
    have h_val_alg_e : ∀ x : L,
        valL F M_C (IntermediateField.inclusion hLM_C x) = e * valL F L x := by
      intro x
      have h1 := h_val_norm_f (IntermediateField.inclusion hLM_C x)
      by_cases hx : x = 0
      · subst hx
        rw [map_zero, hvalMC0, hvalL0, mul_zero]
      · rw [hnorm_inc x, hvalL_pow x f_H hx, h_fe, mul_assoc] at h1
        exact (mul_left_cancel₀ (ne_of_gt hf_pos) h1).symm

    have hinj : Function.Injective (IntermediateField.inclusion hLM_C) :=
      (IntermediateField.inclusion hLM_C).injective
    have h_trace_P_MC : ∀ (m : ℤ) (z : M_C), P_MC m z →
        P_MC m (IntermediateField.inclusion hLM_C (traceLM F hLM_C z)) := by
      intro m z hz
      rw [hact_trace z]
      refine hPMC_sum_G Finset.univ (fun σ => act σ z) m (fun σ _ => ?_)
      rcases hz with rfl | hge
      · exact Or.inl (hact_ring σ).1
      · exact Or.inr (by rw [hact_val σ z]; exact hge)

    have he_le1 : e ≤ 1 := by
      let w : M_C := (ϖ_MC : M_C)
      have hw_P1 : P_MC 1 w := Or.inr (by rw [hϖ_MC])
      have h_term_e : ∀ j ∈ Finset.range n,
          P_MC e (IntermediateField.inclusion hLM_C (traceLM F hLM_C (w * Q.coeff j * Δ⁻¹)) * (z₀ : M_C) ^ j) := by
        intro j _
        set a_j : L := traceLM F hLM_C (w * Q.coeff j * Δ⁻¹)
        have hw_term_P1 : P_MC 1 (w * Q.coeff j * Δ⁻¹) :=
          hPMC_mul0 (hPMC_mul0 hw_P1 (hQ_int j)) hΔ_inv_P0
        have ha_P1 : P_MC 1 (IntermediateField.inclusion hLM_C a_j) :=
          h_trace_P_MC 1 (w * Q.coeff j * Δ⁻¹) hw_term_P1
        have ha_Pe : P_MC e (IntermediateField.inclusion hLM_C a_j) := by
          by_cases ha0 : a_j = 0
          · exact Or.inl (by rw [ha0, map_zero])
          · right
            have h_inc_ne0 : IntermediateField.inclusion hLM_C a_j ≠ 0 :=
              fun h => ha0 ((map_eq_zero_iff _ hinj).mp h)
            have hge1 : 1 ≤ valL F M_C (IntermediateField.inclusion hLM_C a_j) :=
              ha_P1.resolve_left h_inc_ne0
            rw [h_val_alg_e a_j] at hge1 ⊢
            have hval_ge1 : 1 ≤ valL F L a_j := by
              by_contra hlt
              have hle0 : valL F L a_j ≤ 0 := by omega
              have hprod_le0 : e * valL F L a_j ≤ 0 := by nlinarith [he_pos, hle0]
              omega
            nlinarith [he_pos, hval_ge1]
        exact hPMC_mul0 ha_Pe (hz₀_pow_P0 j)
      have hw_Pe : P_MC e w := by
        rw [h_lagrange w]
        exact hPMC_sum_nat (Finset.range n) _ e h_term_e
      have hw_ge : e ≤ valL F M_C w := hw_Pe.resolve_left (Units.ne_zero ϖ_MC)
      rwa [hϖ_MC] at hw_ge
    have he_eq1 : e = 1 := le_antisymm he_le1 he_pos
    have hf_eq : f = (f_H : ℤ) := by
      rw [he_eq1, mul_one] at h_fe
      exact h_fe.symm

    have hResDeg_LMC : resDeg F M_C = f_H * resDeg F L := by
      have h1 : (resDeg F M_C : ℤ) = ((f_H * resDeg F L : ℕ) : ℤ) := by
        rw [h_resDeg_rel, hf_eq, Nat.cast_mul, mul_comm]
      exact Nat.cast_injective h1
    have hqMC : qL F M_C = (qL F L) ^ f_H := by
      unfold qL
      rw [hResDeg_LMC, mul_comm, pow_mul]
    have hValNorm_LMC : ∀ z : M_C, valL F L (normLM F hLM_C z) = (f_H : ℤ) * valL F M_C z := by
      intro z
      rw [h_val_norm_f z, hf_eq]
    have hValAlg_LMC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x := by
      intro x
      rw [h_val_alg_e x, he_eq1, one_mul]
    have hTraceBound_LMC : ∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)) := by
      intro m z hz
      have h1 := h_trace_P_MC m z hz
      rcases h1 with h0 | hge
      · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLM_C) hinj).mp h0)
      · rw [hValAlg_LMC (traceLM F hLM_C z)] at hge
        exact Or.inr hge
    have hring_id : ∀ (z S_sum P : M_C),
        (1 + z) * P - (1 + (z + S_sum)) =
          (P - (1 + S_sum)) + z * S_sum + z * (P - (1 + S_sum)) :=
      fun _ _ _ => by ring
    have hNormLin_LMC : ∀ (d : ℕ), 1 ≤ d → ∀ z : M_C, (z = 0 ∨ (d : ℤ) ≤ valL F M_C z) →
        (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
          (2 * d : ℤ) ≤ valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z))) := by
      intro d _ y hy
      have hy_act : ∀ σ : G, act σ y = 0 ∨ (d : ℤ) ≤ valL F M_C (act σ y) := by
        intro σ
        rcases hy with rfl | hge
        · exact Or.inl (by rw [(hact_ring σ).1])
        · exact Or.inr (by rw [hact_val σ y]; exact hge)
      have h_ind : ∀ T : Finset G,
          ((∑ σ ∈ T, act σ y) = 0 ∨ (d : ℤ) ≤ valL F M_C (∑ σ ∈ T, act σ y)) ∧
          ((∏ σ ∈ T, (1 + act σ y)) - (1 + ∑ σ ∈ T, act σ y) = 0 ∨
            (2 * d : ℤ) ≤ valL F M_C ((∏ σ ∈ T, (1 + act σ y)) - (1 + ∑ σ ∈ T, act σ y))) := by
        intro T
        induction' T using Finset.induction_on with τ T' hτ ih
        · exact ⟨Or.inl Finset.sum_empty,
            Or.inl (by rw [Finset.prod_empty, Finset.sum_empty, add_zero, sub_self])⟩
        · rw [Finset.sum_insert hτ, Finset.prod_insert hτ]
          let z := act τ y
          let S_sum := ∑ σ ∈ T', act σ y
          let P := ∏ σ ∈ T', (1 + act σ y)
          let R := P - (1 + S_sum)
          have ih1 : S_sum = 0 ∨ (d : ℤ) ≤ valL F M_C S_sum := ih.1
          have ih2 : R = 0 ∨ (2 * d : ℤ) ≤ valL F M_C R := ih.2
          have hz : z = 0 ∨ (d : ℤ) ≤ valL F M_C z := hy_act τ
          have hsum : z + S_sum = 0 ∨ (d : ℤ) ≤ valL F M_C (z + S_sum) :=
            hvalMC_add (d : ℤ) z S_sum hz ih1
          refine ⟨hsum, ?_⟩
          rw [hring_id z S_sum P]
          change (R + z * S_sum + z * R = 0) ∨ (2 * d : ℤ) ≤ valL F M_C (R + z * S_sum + z * R)
          have hzS : z * S_sum = 0 ∨ (2 * d : ℤ) ≤ valL F M_C (z * S_sum) := by
            by_cases hz0 : z = 0
            · exact Or.inl (by rw [hz0, zero_mul])
            · by_cases hS0 : S_sum = 0
              · exact Or.inl (by rw [hS0, mul_zero])
              · right
                rw [hvalMC_mul z S_sum hz0 hS0]
                have h1 := hz.resolve_left hz0
                have h2 := ih1.resolve_left hS0
                omega
          have hzR : z * R = 0 ∨ (2 * d : ℤ) ≤ valL F M_C (z * R) := by
            by_cases hz0 : z = 0
            · exact Or.inl (by rw [hz0, zero_mul])
            · by_cases hR0 : R = 0
              · exact Or.inl (by rw [hR0, mul_zero])
              · right
                rw [hvalMC_mul z R hz0 hR0]
                have h1 := hz.resolve_left hz0
                have h2 := ih2.resolve_left hR0
                omega
          exact hvalMC_add (2 * d : ℤ) (R + z * S_sum) (z * R)
            (hvalMC_add (2 * d : ℤ) R (z * S_sum) ih2 hzS) hzR
      have h_univ := (h_ind Finset.univ).2
      have hprod_eq : (∏ σ : G, (1 + act σ y)) =
          IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + y)) := by
        rw [hact_norm (1 + y)]
        refine Finset.prod_congr rfl fun σ _ => ?_
        rw [((hact_ring σ).2.2 1 y).1, (hact_ring σ).2.1]
      have h_diff_eq : (∏ σ : G, (1 + act σ y)) - (1 + ∑ σ : G, act σ y) =
          IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + y) - (1 + traceLM F hLM_C y)) := by
        rw [hprod_eq, ← hact_trace y]
        simp only [map_sub, map_add, map_one]
      rw [h_diff_eq] at h_univ
      rcases h_univ with h0 | hge
      · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLM_C) hinj).mp h0)
      · rw [hValAlg_LMC (normLM F hLM_C (1 + y) - (1 + traceLM F hLM_C y))] at hge
        exact Or.inr hge

    have hy₁_ex : ∃ y₁ : M_C, (y₁ = 0 ∨ 0 ≤ valL F M_C y₁) ∧ traceLM F hLM_C y₁ = 1 := by
      let t : ℕ → L := fun j => traceLM F hLM_C (1 * Q.coeff j * Δ⁻¹)
      have ht_P0 : ∀ j : ℕ, P_L 0 (t j) := by
        intro j
        refine hTraceBound_LMC 0 (1 * Q.coeff j * Δ⁻¹) ?_
        rw [one_mul]
        exact hPMC_mul0 (hQ_int j) hΔ_inv_P0
      have hex_j0 : ∃ j₀ ∈ Finset.range n, ¬ P_L 1 (t j₀) := by
        by_contra hall
        push_neg at hall
        have h_one_P1 : P_MC 1 1 := by
          rw [h_lagrange 1]
          refine hPMC_sum_nat (Finset.range n) _ 1 (fun j hj => ?_)
          have htj : P_L 1 (t j) := hall j hj
          have h_inc_P1 : P_MC 1 (IntermediateField.inclusion hLM_C (t j)) := by
            rcases htj with h0 | hge
            · exact Or.inl (by rw [h0, map_zero])
            · exact Or.inr (by rw [hValAlg_LMC (t j)]; exact hge)
          exact hPMC_mul0 h_inc_P1 (hz₀_pow_P0 j)
        rcases h_one_P1 with h10 | hge1
        · exact one_ne_zero h10
        · rw [hvalMC1] at hge1
          omega
      obtain ⟨j₀, _, hnot_P1⟩ := hex_j0
      have htj0_P0 : P_L 0 (t j₀) := ht_P0 j₀
      change ¬ (t j₀ = 0 ∨ 1 ≤ valL F L (t j₀)) at hnot_P1
      push_neg at hnot_P1
      obtain ⟨htj0_ne0, htj0_lt1⟩ := hnot_P1
      have htj0_ge0 : 0 ≤ valL F L (t j₀) := htj0_P0.resolve_left htj0_ne0
      have htj0_val0 : valL F L (t j₀) = 0 := by omega
      let u_t : Lˣ := Units.mk0 (t j₀) htj0_ne0
      have hut_inv_val0 : valL F L (t j₀)⁻¹ = 0 := by
        have h1 : ((u_t⁻¹ : Lˣ) : L) = (t j₀)⁻¹ := by
          rw [Units.val_inv_eq_inv_val, Units.val_mk0]
        rw [← h1, hvalL_inv u_t, Units.val_mk0, htj0_val0, neg_zero]
      let y₁ : M_C := IntermediateField.inclusion hLM_C (t j₀)⁻¹ * (1 * Q.coeff j₀ * Δ⁻¹)
      have hy₁_P0 : P_MC 0 y₁ := by
        have h1 : P_MC 0 (IntermediateField.inclusion hLM_C (t j₀)⁻¹) :=
          Or.inr (by rw [hValAlg_LMC (t j₀)⁻¹, hut_inv_val0])
        have h2 : P_MC 0 (1 * Q.coeff j₀ * Δ⁻¹) := by
          rw [one_mul]
          exact hPMC_mul0 (hQ_int j₀) hΔ_inv_P0
        exact hPMC_mul0 h1 h2
      have hy₁_tr : traceLM F hLM_C y₁ = 1 := by
        apply hinj
        rw [hact_trace y₁]
        have h_pull : (∑ σ : G, act σ y₁) =
            IntermediateField.inclusion hLM_C (t j₀)⁻¹ *
              ∑ σ : G, act σ (1 * Q.coeff j₀ * Δ⁻¹) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun σ _ => ?_
          dsimp [y₁]
          rw [((hact_ring σ).2.2 _ _).2.1, hact_incl σ (t j₀)⁻¹]
        rw [h_pull, ← hact_trace (1 * Q.coeff j₀ * Δ⁻¹)]
        change IntermediateField.inclusion hLM_C (t j₀)⁻¹ *
          IntermediateField.inclusion hLM_C (t j₀) = IntermediateField.inclusion hLM_C 1
        rw [← map_mul, inv_mul_cancel₀ htj0_ne0]
      exact ⟨y₁, hy₁_P0, hy₁_tr⟩

    exact ⟨hResDeg_LMC, hqMC, hValNorm_LMC, hValAlg_LMC, hTraceBound_LMC, hNormLin_LMC, hy₁_ex⟩

  obtain ⟨hResDeg_LMC, hqMC, hValNorm_LMC, hValAlg_LMC, hTraceBound_LMC, hNormLin_LMC, hy₁_ex⟩ := hs3
  exact ⟨⟨z₀, hz₀_val, hz₀_pow, hz₀_not1, hz₀_move⟩,
    hResDeg_LMC, hqMC, hValNorm_LMC, hValAlg_LMC, hTraceBound_LMC, hNormLin_LMC, hy₁_ex,
    hFinLMC', G, hGroupG, hFinG, act, hcard_G, hact_one, hact_mul,
    hact_ring, hact_incl, hact_faithful, hact_val, hact_trace, hact_norm, hact_lift⟩

theorem ld_ch13_tame_branch_E_invariants_and_uniformizer (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (r : ℕ)
    (hr_mul : r * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (hν_ker : ∀ (i : Fin r) (z : M_Cˣ),
      z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1)
    (hResDeg_MCK : resDeg F K = resDeg F M_C)
    (hValNorm_MCK : ∀ y : K, valL F K y = valL F M_C (normLM F hM_CK y))
    (hValAlg_MCK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hTraceBound_MCK : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1) ≤ valL F K y) →
      (traceLM F hM_CK y = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK y)))
    (hNormRem_MCK : ∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
      normLM F hM_CK (1 + y) - (1 + traceLM F hM_CK y) = 0 ∨
        2 * valL F K y ≤
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) *
            valL F M_C (normLM F hM_CK (1 + y) - (1 + traceLM F hM_CK y)))
    (hResDeg_LMC : resDeg F M_C =
      Module.finrank L (IntermediateField.extendScalars hLM_C) * resDeg F L)
    (hValAlg_LMC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x)
    (haddVal1 : addVal F 1 = 0)
    (haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))))
    (hvalE_props : valL F E 0 = 0 ∧ valL F E 1 = 0 ∧ valL F E (-1) = 0 ∧
      (∀ x : E, valL F E (-x) = valL F E x) ∧
      (∀ x y : E, x ≠ 0 → y ≠ 0 → valL F E (x * y) = valL F E x + valL F E y) ∧
      (∀ u : Eˣ, valL F E ((u⁻¹ : Eˣ) : E) = - valL F E (u : E)) ∧
      (∀ m : ℤ, ∃ c : Eˣ, valL F E (c : E) = m) ∧
      (∀ (k : ℤ) (x y : E),
        (x = 0 ∨ k ≤ valL F E x) → (y = 0 ∨ k ≤ valL F E y) →
          (x + y = 0 ∨ k ≤ valL F E (x + y))))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y)))) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    (∃ ϖ_L : Lˣ,
      valL F L (ϖ_L : L) = 1 ∧
      ∀ i : Fin r, (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom ϖ_L) = 1) ∧
    resDeg F E = resDeg F L ∧
    qL F E = qL F L ∧
    (∀ y : E, valL F E y = valL F L (normLM F hLE y)) ∧
    (∀ x : L, valL F E (IntermediateField.inclusion hLE x) = (ℓ : ℤ) * valL F L x) ∧
    (∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x))) ∧
    (∀ (m : ℤ) (y : E), (y = 0 ∨ (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ valL F E y) →
      (traceLM F hLE y = 0 ∨ m ≤ valL F L (traceLM F hLE y))) ∧
    (∀ y : E, (y = 0 ∨ 1 ≤ valL F E y) →
      normLM F hLE (1 + y) - (1 + traceLM F hLE y) = 0 ∨
        2 * valL F E y ≤ (ℓ : ℤ) * valL F L (normLM F hLE (1 + y) - (1 + traceLM F hLE y))) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L⟩
  rcases hvalE_props with ⟨hval0_E, hval1_E, hval_neg1_E, hval_neg_E, hval_mul_E,
    hval_inv_E, hval_surj_E, hval_add_E⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, hval_surj_K, hval_add_K⟩

  let K_MC' := IntermediateField.extendScalars hM_CK
  let E' := IntermediateField.extendScalars hLE
  let K_E' := IntermediateField.extendScalars hEK
  set ℓ : ℕ := Module.finrank M_C K_MC'
  set f_H : ℕ := Module.finrank L (IntermediateField.extendScalars hLM_C)
  have hℓ_pos : 0 < ℓ := hPrime_MCK.pos
  have hℓ_ge2 : 2 ≤ ℓ := hPrime_MCK.two_le
  have hℓ_int_pos : (0 : ℤ) < (ℓ : ℤ) := Nat.cast_pos.mpr hℓ_pos
  have hℓ_int_ne : (ℓ : ℤ) ≠ 0 := ne_of_gt hℓ_int_pos
  have hr_mul_int : (r : ℤ) * (f_H : ℤ) = (ℓ : ℤ) - 1 := by
    have h1 : 1 ≤ ℓ := Nat.succ_le_of_lt hℓ_pos
    zify [h1] at hr_mul
    exact hr_mul
  have hfH_int_pos : (0 : ℤ) < (f_H : ℤ) := by
    have hr_nonneg : (0 : ℤ) ≤ (r : ℤ) := Nat.cast_nonneg r
    have hfH_nonneg : (0 : ℤ) ≤ (f_H : ℤ) := Nat.cast_nonneg f_H
    have hℓ_ge2_int : (2 : ℤ) ≤ (ℓ : ℤ) := by exact_mod_cast hℓ_ge2
    nlinarith

  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring

  have hval_pow_E : ∀ (x : E) (n : ℕ), x ≠ 0 → valL F E (x ^ n) = (n : ℤ) * valL F E x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_E]
    | succ n ih =>
      rw [pow_succ, hval_mul_E (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring

  have hval_pow_K : ∀ (x : K) (n : ℕ), x ≠ 0 → valL F K (x ^ n) = (n : ℤ) * valL F K x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring

  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q_z : ℤ := valL F M z
      set r_z : ℤ := relVal F M z % f
      have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
          linarith
        let k : ℕ := r_z.toNat
        have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith

  obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hval_surj_L
  obtain ⟨hresDeg_E_pos, hdiv_E⟩ := hrelVal_div E hval_surj_E
  obtain ⟨hresDeg_K_pos, hdiv_K⟩ := hrelVal_div K hval_surj_K
  have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hresDeg_L_pos
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
  have hfE_int_pos : (0 : ℤ) < (resDeg F E : ℤ) := Nat.cast_pos.mpr hresDeg_E_pos

  let eF_E : E ≃ₐ[F] E' :=
    { toExtendScalars F hLE with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F E' := Module.Finite.equiv eF_E.toLinearEquiv
  haveI : IsScalarTower F L E' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L E' := Module.Finite.of_restrictScalars_finite F L E'

  have hrelVal_norm_LE : ∀ y : E, relVal F L (normLM F hLE y) = relVal F E y := by
    intro y
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLE y))) =
      addVal F (Algebra.norm F y)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLE y)) =
        Algebra.norm F (toExtendScalars F hLE y) := Algebra.norm_norm
    have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hLE y) :=
      Algebra.norm_eq_of_algEquiv eF_E y
    rw [h1, ← h2]

  have hnorm_inc_LE : ∀ x : L,
      normLM F hLE (IntermediateField.inclusion hLE x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (algebraMap L E' x) = x ^ ℓ
    rw [Algebra.norm_algebraMap, hFinE_eq]

  let eF_KE : K ≃ₐ[F] K_E' :=
    { toExtendScalars F hEK with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hEK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K_E' := Module.Finite.equiv eF_KE.toLinearEquiv
  haveI : IsScalarTower F E K_E' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional E K_E' := Module.Finite.of_restrictScalars_finite F E K_E'
  set d_EK : ℕ := Module.finrank E K_E'

  have hrelVal_norm_EK : ∀ w : K, relVal F E (normLM F hEK w) = relVal F K w := by
    intro w
    change addVal F (Algebra.norm F (Algebra.norm E (toExtendScalars F hEK w))) =
      addVal F (Algebra.norm F w)
    have h1 : Algebra.norm F (Algebra.norm E (toExtendScalars F hEK w)) =
        Algebra.norm F (toExtendScalars F hEK w) := Algebra.norm_norm
    have h2 : Algebra.norm F w = Algebra.norm F (toExtendScalars F hEK w) :=
      Algebra.norm_eq_of_algEquiv eF_KE w
    rw [h1, ← h2]

  have hnorm_inc_EK : ∀ y : E,
      normLM F hEK (IntermediateField.inclusion hEK y) = y ^ d_EK := by
    intro y
    change Algebra.norm E (algebraMap E K_E' y) = y ^ d_EK
    exact Algebra.norm_algebraMap y

  let eF_KMC : K ≃ₐ[F] K_MC' :=
    { toExtendScalars F hM_CK with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hM_CK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K_MC' := Module.Finite.equiv eF_KMC.toLinearEquiv
  haveI : IsScalarTower F M_C K_MC' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M_C K_MC' := Module.Finite.of_restrictScalars_finite F M_C K_MC'

  obtain ⟨ϖ_L₀, hϖ_L₀⟩ := hval_surj_L 1
  obtain ⟨ϖ_E, hϖ_E⟩ := hval_surj_E 1
  obtain ⟨ϖ_K₀, hϖ_K₀⟩ := hval_surj_K 1

  set f_E : ℤ := valL F L (normLM F hLE (ϖ_E : E))
  set e_E : ℤ := valL F E (IntermediateField.inclusion hLE (ϖ_L₀ : L))
  set m_K : ℤ := valL F E (normLM F hEK (ϖ_K₀ : K))

  have hresDeg_E_eq_fE : (resDeg F E : ℤ) = (resDeg F L : ℤ) * f_E := by
    calc (resDeg F E : ℤ)
      _ = (resDeg F E : ℤ) * valL F E (ϖ_E : E) := by rw [hϖ_E, mul_one]
      _ = relVal F E (ϖ_E : E) := (hdiv_E (ϖ_E : E)).symm
      _ = relVal F L (normLM F hLE (ϖ_E : E)) := (hrelVal_norm_LE (ϖ_E : E)).symm
      _ = (resDeg F L : ℤ) * f_E := hdiv_L _

  have hfE_pos : 0 < f_E := by nlinarith

  have hfE_eE_mul : (resDeg F L : ℤ) * (f_E * e_E) = (resDeg F L : ℤ) * (ℓ : ℤ) := by
    calc (resDeg F L : ℤ) * (f_E * e_E)
      _ = ((resDeg F L : ℤ) * f_E) * e_E := (mul_assoc _ _ _).symm
      _ = (resDeg F E : ℤ) * e_E := by rw [← hresDeg_E_eq_fE]
      _ = relVal F E (IntermediateField.inclusion hLE (ϖ_L₀ : L)) := (hdiv_E _).symm
      _ = relVal F L (normLM F hLE (IntermediateField.inclusion hLE (ϖ_L₀ : L))) :=
          (hrelVal_norm_LE _).symm
      _ = relVal F L ((ϖ_L₀ : L) ^ ℓ) := by rw [hnorm_inc_LE]
      _ = (resDeg F L : ℤ) * valL F L ((ϖ_L₀ : L) ^ ℓ) := hdiv_L _
      _ = (resDeg F L : ℤ) * (ℓ : ℤ) := by
          rw [hval_pow_L (ϖ_L₀ : L) ℓ (Units.ne_zero ϖ_L₀), hϖ_L₀, mul_one]

  have hfE_eE : f_E * e_E = (ℓ : ℤ) := mul_left_cancel₀ hfL_int_ne hfE_eE_mul

  have hResDeg_K : resDeg F K = f_H * resDeg F L := hResDeg_MCK.trans hResDeg_LMC
  have hResDeg_K_int : (resDeg F K : ℤ) = (f_H : ℤ) * (resDeg F L : ℤ) := by
    exact_mod_cast hResDeg_K

  have hfE_mK_mul : (resDeg F L : ℤ) * (f_H : ℤ) = (resDeg F L : ℤ) * (f_E * m_K) := by
    calc (resDeg F L : ℤ) * (f_H : ℤ)
      _ = (f_H : ℤ) * (resDeg F L : ℤ) := mul_comm _ _
      _ = (resDeg F K : ℤ) * valL F K (ϖ_K₀ : K) := by rw [← hResDeg_K_int, hϖ_K₀, mul_one]
      _ = relVal F K (ϖ_K₀ : K) := (hdiv_K (ϖ_K₀ : K)).symm
      _ = relVal F E (normLM F hEK (ϖ_K₀ : K)) := (hrelVal_norm_EK (ϖ_K₀ : K)).symm
      _ = (resDeg F E : ℤ) * m_K := hdiv_E _
      _ = ((resDeg F L : ℤ) * f_E) * m_K := by rw [hresDeg_E_eq_fE]
      _ = (resDeg F L : ℤ) * (f_E * m_K) := mul_assoc _ _ _

  have hfE_mK : f_E * m_K = (f_H : ℤ) := (mul_left_cancel₀ hfL_int_ne hfE_mK_mul).symm

  have hbezout : f_E * (e_E - (r : ℤ) * m_K) = 1 := by
    calc f_E * (e_E - (r : ℤ) * m_K)
      _ = f_E * e_E - (r : ℤ) * (f_E * m_K) := by ring
      _ = (ℓ : ℤ) - (r : ℤ) * (f_H : ℤ) := by rw [hfE_eE, hfE_mK]
      _ = 1 := by linarith

  have hd_ge1 : 1 ≤ e_E - (r : ℤ) * m_K := by nlinarith
  have hfE_eq1 : f_E = 1 := by nlinarith

  have hResDeg_LE : resDeg F E = resDeg F L := by
    have h1 : (resDeg F E : ℤ) = (resDeg F L : ℤ) := by
      rw [hresDeg_E_eq_fE, hfE_eq1, mul_one]
    exact Nat.cast_injective h1

  have hqE : qL F E = qL F L := by
    unfold qL
    rw [hResDeg_LE]

  have hValNorm_LE : ∀ y : E, valL F E y = valL F L (normLM F hLE y) := by
    intro y
    apply mul_left_cancel₀ hfL_int_ne
    calc (resDeg F L : ℤ) * valL F E y
      _ = (resDeg F E : ℤ) * valL F E y := by rw [hResDeg_LE]
      _ = relVal F E y := (hdiv_E y).symm
      _ = relVal F L (normLM F hLE y) := (hrelVal_norm_LE y).symm
      _ = (resDeg F L : ℤ) * valL F L (normLM F hLE y) := hdiv_L (normLM F hLE y)

  have hValAlg_LE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) = (ℓ : ℤ) * valL F L x := by
    intro x
    by_cases hx0 : x = 0
    · rw [hx0, map_zero, hval0_E, hval0_L, mul_zero]
    · rw [hValNorm_LE (IntermediateField.inclusion hLE x), hnorm_inc_LE x, hval_pow_L x ℓ hx0]

  have hEK_rel : ∀ y : E,
      (f_H : ℤ) * valL F K (IntermediateField.inclusion hEK y) = (d_EK : ℤ) * valL F E y := by
    intro y
    by_cases hy0 : y = 0
    · rw [hy0, map_zero, hval0_K, hval0_E, mul_zero, mul_zero]
    · apply mul_left_cancel₀ hfL_int_ne
      calc (resDeg F L : ℤ) * ((f_H : ℤ) * valL F K (IntermediateField.inclusion hEK y))
        _ = ((f_H : ℤ) * (resDeg F L : ℤ)) * valL F K (IntermediateField.inclusion hEK y) := by ring
        _ = (resDeg F K : ℤ) * valL F K (IntermediateField.inclusion hEK y) := by rw [← hResDeg_K_int]
        _ = relVal F K (IntermediateField.inclusion hEK y) := (hdiv_K _).symm
        _ = relVal F E (normLM F hEK (IntermediateField.inclusion hEK y)) :=
            (hrelVal_norm_EK _).symm
        _ = relVal F E (y ^ d_EK) := by rw [hnorm_inc_EK]
        _ = (resDeg F E : ℤ) * valL F E (y ^ d_EK) := hdiv_E _
        _ = (resDeg F L : ℤ) * ((d_EK : ℤ) * valL F E y) := by
            rw [hResDeg_LE, hval_pow_E y d_EK hy0]

  have hinc_ϖL₀_eq : IntermediateField.inclusion hEK (IntermediateField.inclusion hLE (ϖ_L₀ : L)) =
      IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C (ϖ_L₀ : L)) :=
    Subtype.ext rfl

  have hvalK_ϖL₀ : valL F K (IntermediateField.inclusion hEK (IntermediateField.inclusion hLE (ϖ_L₀ : L))) =
      (ℓ : ℤ) := by
    rw [hinc_ϖL₀_eq, hValAlg_MCK, hValAlg_LMC, hϖ_L₀, mul_one]

  have hvalE_ϖL₀ : valL F E (IntermediateField.inclusion hLE (ϖ_L₀ : L)) = (ℓ : ℤ) := by
    rw [hValAlg_LE, hϖ_L₀, mul_one]

  have hdEK_eq : (d_EK : ℤ) = (f_H : ℤ) := by
    have hsp := hEK_rel (IntermediateField.inclusion hLE (ϖ_L₀ : L))
    rw [hvalK_ϖL₀, hvalE_ϖL₀] at hsp
    nlinarith

  have hValAlg_EK : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = valL F E y := by
    intro y
    have hsp := hEK_rel y
    rw [hdEK_eq] at hsp
    nlinarith

  
  have hval_strict_E : ∀ (y₁ y₂ : E),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F E y₁ + 1 ≤ valL F E y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F E (y₁ + y₂) = valL F E y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F E y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F E y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F E (y₁ + y₂) :=
      hval_add_E v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F E (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F E (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_E]
          exact hge
      have hy₁_gt := hval_add_E (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F E (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F E (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  let t_term_E (c : Fin ℓ → L) (i : Fin ℓ) : E :=
    IntermediateField.inclusion hLE (c i) * ((ϖ_E : E) ^ (i : ℕ))
  let v_term_E (c : Fin ℓ → L) (i : Fin ℓ) : ℤ :=
    (ℓ : ℤ) * valL F L (c i) + (i.1 : ℤ)

  have ht_term_E_zero : ∀ (c : Fin ℓ → L) (i : Fin ℓ), c i = 0 → t_term_E c i = 0 := by
    intro c i hci
    dsimp [t_term_E]
    rw [hci, map_zero, zero_mul]

  have ht_term_E_nz : ∀ (c : Fin ℓ → L) (i : Fin ℓ),
      c i ≠ 0 → t_term_E c i ≠ 0 ∧ valL F E (t_term_E c i) = v_term_E c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hLE (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hLE).toRingHom).ne hci
    have hpow_ne : ((ϖ_E : E) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_E)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term_E, v_term_E]
    rw [hval_mul_E _ _ hinc_ne hpow_ne, hValAlg_LE (c i),
      hval_pow_E (ϖ_E : E) (i : ℕ) (Units.ne_zero ϖ_E), hϖ_E, mul_one]

  have hv_term_E_inj : ∀ (c : Fin ℓ → L) (i j : Fin ℓ),
      v_term_E c i = v_term_E c j → i = j := by
    intro c i j hij
    have hmod : ∀ k : Fin ℓ, v_term_E c k % (ℓ : ℤ) = (k.1 : ℤ) := by
      intro k
      dsimp [v_term_E]
      have hcomm : (ℓ : ℤ) * valL F L (c k) + (k.1 : ℤ) =
          (k.1 : ℤ) + (ℓ : ℤ) * valL F L (c k) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_E_ge : ∀ (c : Fin ℓ → L) (S : Finset (Fin ℓ)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term_E c i) →
        ((∑ i ∈ S, t_term_E c i) = 0 ∨ m ≤ valL F E (∑ i ∈ S, t_term_E c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term_E c a = 0 ∨ m ≤ valL F E (t_term_E c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_E_zero c a hca)
        · right
          rw [(ht_term_E_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_E m (t_term_E c a) (∑ i ∈ s, t_term_E c i) ha_t hs_t

  have hsum_min_E_nz : ∀ (c : Fin ℓ → L) (i : Fin ℓ),
      c i ≠ 0 →
        ∃ i₀ : Fin ℓ, c i₀ ≠ 0 ∧ v_term_E c i₀ ≤ v_term_E c i ∧
          (∑ j : Fin ℓ, t_term_E c j) ≠ 0 ∧
          valL F E (∑ j : Fin ℓ, t_term_E c j) = v_term_E c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin ℓ) := (Finset.univ : Finset (Fin ℓ)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term_E c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term_E c i₀ ≤ v_term_E c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin ℓ)).erase i₀,
        c j = 0 ∨ v_term_E c i₀ + 1 ≤ v_term_E c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term_E c i₀ ≤ v_term_E c j := hi₀_min j hj_mem
        have hne_v : v_term_E c i₀ ≠ v_term_E c j := fun heq => hj_ne (hv_term_E_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_E_ge c ((Finset.univ : Finset (Fin ℓ)).erase i₀)
      (v_term_E c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_E_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_E (t_term_E c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin ℓ)).erase i₀, t_term_E c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term_E c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hval_sum_E_iff : ∀ (c : Fin ℓ → L) (m : ℤ),
      ((∑ i : Fin ℓ, t_term_E c i) = 0 ∨ m ≤ valL F E (∑ i : Fin ℓ, t_term_E c i)) ↔
        ∀ i : Fin ℓ, c i = 0 ∨ m ≤ v_term_E c i := by
    intro c m
    refine ⟨?_, fun hall => hval_sum_E_ge c Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hci : c i = 0
    · exact Or.inl hci
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_E_nz c i hci
      have hm_le : m ≤ valL F E (∑ j : Fin ℓ, t_term_E c j) := hsum.resolve_left hsum_ne
      omega

  have hlin_zero_E : ∀ (c : Fin ℓ → L),
      (∑ i : Fin ℓ, t_term_E c i) = 0 → ∀ i : Fin ℓ, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_E_nz c i hci
    exact hsum_ne hsum0

  let b_E : Fin ℓ → E' := fun i => (toExtendScalars F hLE (ϖ_E : E)) ^ (i : ℕ)
  have hli_E : LinearIndependent L b_E := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hLE (∑ i : Fin ℓ, t_term_E c i) =
        ∑ i : Fin ℓ, c i • b_E i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term_E, b_E]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin ℓ, t_term_E c i) = 0 := by
      apply eF_E.injective
      change toExtendScalars F hLE (∑ i : Fin ℓ, t_term_E c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero_E c hsum0

  haveI : Nonempty (Fin ℓ) := ⟨⟨0, hℓ_pos⟩⟩
  have hcard_E : Fintype.card (Fin ℓ) = Module.finrank L E' :=
    (Fintype.card_fin ℓ).trans hFinE_eq.symm
  let B_E : Module.Basis (Fin ℓ) L E' := basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E

  have hResSurj_LE : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)) := by
    intro y hy
    let c : Fin ℓ → L := fun i => B_E.repr (toExtendScalars F hLE y) i
    have hy_eq : y = ∑ i : Fin ℓ, t_term_E c i := by
      apply eF_E.injective
      change toExtendScalars F hLE y = toExtendScalars F hLE (∑ i : Fin ℓ, t_term_E c i)
      have hrepr := (B_E.sum_repr (toExtendScalars F hLE y)).symm
      rw [hrepr, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [B_E, c, t_term_E, b_E]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E, map_mul, map_pow]
      rfl
    have hc0 : ∀ i : Fin ℓ, c i = 0 ∨ 0 ≤ v_term_E c i :=
      (hval_sum_E_iff c 0).mp (hy_eq ▸ hy)
    let i_zero : Fin ℓ := ⟨0, hℓ_pos⟩
    let x : L := c i_zero
    have hx_int : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc0 i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (ℓ : ℤ) * valL F L x + 0 at hge
        nlinarith
    let c_rem : Fin ℓ → L := fun i => if i = i_zero then 0 else c i
    have hy_sub_eq : y - IntermediateField.inclusion hLE x = ∑ i : Fin ℓ, t_term_E c_rem i := by
      have ht_zero : t_term_E c i_zero = IntermediateField.inclusion hLE x := by
        dsimp [t_term_E, i_zero, x]
        rw [pow_zero, mul_one]
      have hsplit_c := (Finset.add_sum_erase Finset.univ (t_term_E c) (Finset.mem_univ i_zero)).symm
      have hsplit_rem := (Finset.add_sum_erase Finset.univ (t_term_E c_rem) (Finset.mem_univ i_zero)).symm
      have hrem_zero : t_term_E c_rem i_zero = 0 :=
        ht_term_E_zero c_rem i_zero (if_pos rfl)
      have herase_eq : (∑ i ∈ (Finset.univ : Finset (Fin ℓ)).erase i_zero, t_term_E c i) =
          ∑ i ∈ (Finset.univ : Finset (Fin ℓ)).erase i_zero, t_term_E c_rem i := by
        apply Finset.sum_congr rfl
        intro i hi
        have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
        dsimp [t_term_E, c_rem]
        rw [if_neg hi_ne]
      rw [hy_eq, hsplit_c, ht_zero, add_sub_cancel_left, herase_eq, hsplit_rem, hrem_zero, zero_add]
    have hrem_ge1 : ∀ i : Fin ℓ, c_rem i = 0 ∨ 1 ≤ v_term_E c_rem i := by
      intro i
      by_cases hi0 : i = i_zero
      · left
        dsimp [c_rem]
        rw [if_pos hi0]
      · dsimp [c_rem, v_term_E]
        rw [if_neg hi0]
        rcases hc0 i with hci0 | hge
        · exact Or.inl hci0
        · right
          dsimp [v_term_E] at hge
          have hi_pos : (1 : ℤ) ≤ (i.1 : ℤ) := by
            have hne_val : i.1 ≠ 0 := fun h0 => hi0 (Fin.ext h0)
            omega
          have hi_lt : (i.1 : ℤ) < (ℓ : ℤ) := Nat.cast_lt.mpr i.2
          have hval_nonneg : 0 ≤ valL F L (c i) := by
            by_contra hneg
            have hle_neg1 : valL F L (c i) ≤ -1 := by omega
            nlinarith
          nlinarith
    refine ⟨x, hx_int, ?_⟩
    rw [hy_sub_eq]
    exact (hval_sum_E_iff c_rem 1).mpr hrem_ge1

  
  let ϖ_K : Kˣ := Units.map (IntermediateField.inclusion hEK).toMonoidHom ϖ_E
  have hϖ_K_coe : (ϖ_K : K) = IntermediateField.inclusion hEK (ϖ_E : E) := rfl
  have hϖ_K : valL F K (ϖ_K : K) = 1 := by
    rw [hϖ_K_coe, hValAlg_EK (ϖ_E : E), hϖ_E]

  have hval_strict_K : ∀ (y₁ y₂ : K),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F K y₁ + 1 ≤ valL F K y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F K (y₁ + y₂) = valL F K y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F K y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F K y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F K (y₁ + y₂) :=
      hval_add_K v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F K (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F K (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_K]
          exact hge
      have hy₁_gt := hval_add_K (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  let t_term_K (c : Fin ℓ → M_C) (i : Fin ℓ) : K :=
    IntermediateField.inclusion hM_CK (c i) * ((ϖ_K : K) ^ (i : ℕ))
  let v_term_K (c : Fin ℓ → M_C) (i : Fin ℓ) : ℤ :=
    (ℓ : ℤ) * valL F M_C (c i) + (i.1 : ℤ)

  have ht_term_K_zero : ∀ (c : Fin ℓ → M_C) (i : Fin ℓ), c i = 0 → t_term_K c i = 0 := by
    intro c i hci
    dsimp [t_term_K]
    rw [hci, map_zero, zero_mul]

  have ht_term_K_nz : ∀ (c : Fin ℓ → M_C) (i : Fin ℓ),
      c i ≠ 0 → t_term_K c i ≠ 0 ∧ valL F K (t_term_K c i) = v_term_K c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hM_CK (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hM_CK).toRingHom).ne hci
    have hpow_ne : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term_K, v_term_K]
    rw [hval_mul_K _ _ hinc_ne hpow_ne, hValAlg_MCK (c i),
      hval_pow_K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_one]

  have hv_term_K_inj : ∀ (c : Fin ℓ → M_C) (i j : Fin ℓ),
      v_term_K c i = v_term_K c j → i = j := by
    intro c i j hij
    have hmod : ∀ k : Fin ℓ, v_term_K c k % (ℓ : ℤ) = (k.1 : ℤ) := by
      intro k
      dsimp [v_term_K]
      have hcomm : (ℓ : ℤ) * valL F M_C (c k) + (k.1 : ℤ) =
          (k.1 : ℤ) + (ℓ : ℤ) * valL F M_C (c k) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_K_ge : ∀ (c : Fin ℓ → M_C) (S : Finset (Fin ℓ)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term_K c i) →
        ((∑ i ∈ S, t_term_K c i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, t_term_K c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term_K c a = 0 ∨ m ≤ valL F K (t_term_K c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_K_zero c a hca)
        · right
          rw [(ht_term_K_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K m (t_term_K c a) (∑ i ∈ s, t_term_K c i) ha_t hs_t

  have hsum_min_K_nz : ∀ (c : Fin ℓ → M_C) (i : Fin ℓ),
      c i ≠ 0 →
        ∃ i₀ : Fin ℓ, c i₀ ≠ 0 ∧ v_term_K c i₀ ≤ v_term_K c i ∧
          (∑ j : Fin ℓ, t_term_K c j) ≠ 0 ∧
          valL F K (∑ j : Fin ℓ, t_term_K c j) = v_term_K c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin ℓ) := (Finset.univ : Finset (Fin ℓ)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term_K c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term_K c i₀ ≤ v_term_K c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin ℓ)).erase i₀,
        c j = 0 ∨ v_term_K c i₀ + 1 ≤ v_term_K c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term_K c i₀ ≤ v_term_K c j := hi₀_min j hj_mem
        have hne_v : v_term_K c i₀ ≠ v_term_K c j := fun heq => hj_ne (hv_term_K_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_K_ge c ((Finset.univ : Finset (Fin ℓ)).erase i₀)
      (v_term_K c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_K_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_K (t_term_K c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin ℓ)).erase i₀, t_term_K c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term_K c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hlin_zero_K : ∀ (c : Fin ℓ → M_C),
      (∑ i : Fin ℓ, t_term_K c i) = 0 → ∀ i : Fin ℓ, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_K_nz c i hci
    exact hsum_ne hsum0

  let b_K : Fin ℓ → K_MC' := fun i => (toExtendScalars F hM_CK (ϖ_K : K)) ^ (i : ℕ)
  have hli_K : LinearIndependent M_C b_K := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hM_CK (∑ i : Fin ℓ, t_term_K c i) =
        ∑ i : Fin ℓ, c i • b_K i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term_K, b_K]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin ℓ, t_term_K c i) = 0 := by
      apply eF_KMC.injective
      change toExtendScalars F hM_CK (∑ i : Fin ℓ, t_term_K c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero_K c hsum0

  have hcard_K : Fintype.card (Fin ℓ) = Module.finrank M_C K_MC' := Fintype.card_fin ℓ
  let B_K : Module.Basis (Fin ℓ) M_C K_MC' := basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K

  
  have hrepr_compat : ∀ (y : E) (i : Fin ℓ),
      B_K.repr (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) i =
        IntermediateField.inclusion hLM_C (B_E.repr (toExtendScalars F hLE y) i) := by
    intro y i
    let c : Fin ℓ → L := B_E.equivFun (toExtendScalars F hLE y)
    let c_MC : Fin ℓ → M_C := fun j => IntermediateField.inclusion hLM_C (c j)
    have hsum_E : ∑ j : Fin ℓ, c j • B_E j = toExtendScalars F hLE y := by
      rw [← B_E.equivFun_symm_apply c]
      exact B_E.equivFun.symm_apply_apply (toExtendScalars F hLE y)
    have hterm_coe : ∀ j : Fin ℓ,
        ((c_MC j • B_K j : K_MC') : AlgebraicClosure F) =
          ((c j • B_E j : E') : AlgebraicClosure F) := by
      intro j
      dsimp [B_K, B_E, c_MC, b_K, b_E, ϖ_K]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K,
        coe_basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E]
      rfl
    have hsum_K : ∑ j : Fin ℓ, c_MC j • B_K j =
        toExtendScalars F hM_CK (IntermediateField.inclusion hEK y) := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finset_sum]
      have hsum_E_coe : ((∑ j : Fin ℓ, c j • B_E j : E') : AlgebraicClosure F) = y.1 :=
        congrArg Subtype.val hsum_E
      rw [AddSubmonoidClass.coe_finset_sum] at hsum_E_coe
      calc ∑ j : Fin ℓ, ((c_MC j • B_K j : K_MC') : AlgebraicClosure F)
        _ = ∑ j : Fin ℓ, ((c j • B_E j : E') : AlgebraicClosure F) := by
            apply Finset.sum_congr rfl
            intro j _
            exact hterm_coe j
        _ = y.1 := hsum_E_coe
    rw [← B_K.equivFun_symm_apply c_MC] at hsum_K
    have hfun := congrArg B_K.equivFun hsum_K
    rw [B_K.equivFun.apply_symm_apply c_MC] at hfun
    have hi := congrFun hfun.symm i
    simpa [Module.Basis.equivFun_apply, c_MC, c] using hi

  have hMat_compat : ∀ y : E,
      Algebra.leftMulMatrix B_K (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) =
        (IntermediateField.inclusion hLM_C).toRingHom.mapMatrix
          (Algebra.leftMulMatrix B_E (toExtendScalars F hLE y)) := by
    intro y
    apply Matrix.ext
    intro i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply,
      Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul]
    have hmul_E : toExtendScalars F hLE y * B_E j =
        toExtendScalars F hLE (y * (ϖ_E : E) ^ (j : ℕ)) := by
      dsimp [B_E, b_E]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E, map_mul, map_pow]
    have hmul_K : toExtendScalars F hM_CK (IntermediateField.inclusion hEK y) * B_K j =
        toExtendScalars F hM_CK (IntermediateField.inclusion hEK (y * (ϖ_E : E) ^ (j : ℕ))) := by
      dsimp [B_K]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K]
      dsimp [b_K]
      rw [hϖ_K_coe, map_mul, map_pow, map_mul, map_pow]
    rw [hmul_E, hmul_K]
    exact hrepr_compat (y * (ϖ_E : E) ^ (j : ℕ)) i

  
  have htrace_compat : ∀ y : E,
      traceLM F hM_CK (IntermediateField.inclusion hEK y) =
        IntermediateField.inclusion hLM_C (traceLM F hLE y) := by
    intro y
    change Algebra.trace M_C K_MC' (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) =
      IntermediateField.inclusion hLM_C (Algebra.trace L E' (toExtendScalars F hLE y))
    rw [Algebra.trace_eq_matrix_trace B_K, Algebra.trace_eq_matrix_trace B_E, hMat_compat y]
    simp [Matrix.trace, Matrix.diag]

  have hnorm_compat : ∀ y : E,
      normLM F hM_CK (IntermediateField.inclusion hEK y) =
        IntermediateField.inclusion hLM_C (normLM F hLE y) := by
    intro y
    change Algebra.norm M_C (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) =
      IntermediateField.inclusion hLM_C (Algebra.norm L (toExtendScalars F hLE y))
    rw [Algebra.norm_eq_matrix_det B_K, Algebra.norm_eq_matrix_det B_E, hMat_compat y]
    exact ((IntermediateField.inclusion hLM_C).toRingHom.map_det _).symm

  
  let ϖ_L : Lˣ := Units.map (normLM F hLE) ϖ_E
  have hϖ_L_val : valL F L (ϖ_L : L) = 1 := by
    change valL F L (normLM F hLE (ϖ_E : E)) = 1
    rw [← hValNorm_LE (ϖ_E : E), hϖ_E]

  have hϖ_L_ν : ∀ i : Fin r,
      (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom ϖ_L) = 1 := by
    intro i
    apply (hν_ker i _).mp
    refine ⟨ϖ_K, ?_⟩
    apply Units.ext
    exact hnorm_compat (ϖ_E : E)

  have hTraceBound_LE : ∀ (m : ℤ) (y : E),
      (y = 0 ∨ (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ valL F E y) →
        (traceLM F hLE y = 0 ∨ m ≤ valL F L (traceLM F hLE y)) := by
    intro m y hy
    let y_K : K := IntermediateField.inclusion hEK y
    have hy_K : y_K = 0 ∨ (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ valL F K y_K := by
      rcases hy with rfl | hge
      · exact Or.inl (map_zero _)
      · right
        dsimp [y_K]
        rw [hValAlg_EK y]
        exact hge
    have hMC := hTraceBound_MCK m y_K hy_K
    dsimp [y_K] at hMC
    rw [htrace_compat y] at hMC
    rcases hMC with h0 | hge
    · left
      exact (RingHom.injective (IntermediateField.inclusion hLM_C).toRingHom)
        (h0.trans (map_zero _).symm)
    · right
      rw [hValAlg_LMC (traceLM F hLE y)] at hge
      exact hge

  have hNormRem_LE : ∀ y : E, (y = 0 ∨ 1 ≤ valL F E y) →
      normLM F hLE (1 + y) - (1 + traceLM F hLE y) = 0 ∨
        2 * valL F E y ≤ (ℓ : ℤ) * valL F L (normLM F hLE (1 + y) - (1 + traceLM F hLE y)) := by
    intro y hy
    let y_K : K := IntermediateField.inclusion hEK y
    have hy_K : y_K = 0 ∨ 1 ≤ valL F K y_K := by
      rcases hy with rfl | hge
      · exact Or.inl (map_zero _)
      · right
        dsimp [y_K]
        rw [hValAlg_EK y]
        exact hge
    have hrem_compat : normLM F hM_CK (1 + y_K) - (1 + traceLM F hM_CK y_K) =
        IntermediateField.inclusion hLM_C
          (normLM F hLE (1 + y) - (1 + traceLM F hLE y)) := by
      have h1y : (1 : K) + y_K = IntermediateField.inclusion hEK (1 + y) := by
        dsimp [y_K]
        rw [map_add, map_one]
      rw [h1y, hnorm_compat (1 + y), htrace_compat y]
      rfl
    have hMC := hNormRem_MCK y_K hy_K
    rw [hrem_compat] at hMC
    rcases hMC with h0 | hge
    · left
      exact (RingHom.injective (IntermediateField.inclusion hLM_C).toRingHom)
        (h0.trans (map_zero _).symm)
    · right
      dsimp [y_K] at hge
      rw [hValAlg_EK y, hValAlg_LMC] at hge
      exact hge

  exact ⟨⟨ϖ_L, hϖ_L_val, hϖ_L_ν⟩, hResDeg_LE, hqE, hValNorm_LE, hValAlg_LE,
    hResSurj_LE, hTraceBound_LE, hNormRem_LE⟩

theorem ld_ch13_tame_diamond_conductors_and_unramified_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hr_mul : r * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1)
    (hχ'MC_cond : ∀ u ∈ unitGroup F M_C (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C)))),
      (χ'.comp (Units.map (normLM F hLM_C))) u = 1)
    (hν_props : ∀ i : Fin r,
      (ν_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      ν_orb i ≠ 1 ∧
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)), ((ν_orb i) ^ k) u = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
          ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1))
    (hν_cond1 : ∀ i : Fin r,
      condExp F M_C (ν_orb i) = 1 ∧
      (∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1))
    (z₀ : M_Cˣ) (hz₀_val : valL F M_C (z₀ : M_C) = 0)
    (hz₀_pow : z₀ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) ∈ unitGroup F M_C 1)
    (hValNorm_LMC : ∀ z : M_C, valL F L (normLM F hLM_C z) =
      (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) * valL F M_C z)
    (hValAlg_LMC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x)
    (hTraceBound_LMC : ∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hNormLin_LMC : ∀ (d : ℕ), 1 ≤ d → ∀ z : M_C, (z = 0 ∨ (d : ℤ) ≤ valL F M_C z) →
      (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z))))
    (y₁ : M_C) (hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M_C y₁) (hy₁_tr : traceLM F hLM_C y₁ = 1)
    (G : Type u) [Group G] [Fintype G] (act : G → M_C → M_C)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hact_val : ∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z)
    (hact_norm : ∀ z : M_C, IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G, act σ z)
    (hz₀_act_move : ∀ σ : G, σ ≠ 1 →
      act σ (z₀ : M_C) - (z₀ : M_C) ≠ 0 ∧ valL F M_C (act σ (z₀ : M_C) - (z₀ : M_C)) = 0)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] (resL : L → k_L) (resM : M_C → k_M)
    (hfinrank_res : Module.finrank k_L k_M =
      Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
      resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
      resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
      resM (-z₁) = -resM z₁)
    (hresM_ker : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) → (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M_C z)))
    (hresM_surj : ∀ b : k_M, ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧ resM z = b)
    (hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resM (IntermediateField.inclusion hLM_C x) = algebraMap k_L k_M (resL x))
    (π_res : G →* (k_M ≃ₐ[k_L] k_M))
    (hπ_inj : Function.Injective π_res)
    (hπ_res : ∀ (σ : G) (z : M_C), (z = 0 ∨ 0 ≤ valL F M_C z) →
      π_res σ (resM z) = resM (act σ z))
    (hℓ_ne0_L : (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : L) ≠ 0)
    (hℓ_val0_L : valL F L (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : L) = 0)
    (hValNorm_LE : ∀ y : E, valL F E y = valL F L (normLM F hLE y))
    (hValAlg_LE : ∀ x : L, valL F E (IntermediateField.inclusion hLE x) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hTraceBound_LE : ∀ (m : ℤ) (y : E),
      (y = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1) ≤ valL F E y) →
      (traceLM F hLE y = 0 ∨ m ≤ valL F L (traceLM F hLE y)))
    (hNormRem_LE : ∀ y : E, (y = 0 ∨ 1 ≤ valL F E y) →
      normLM F hLE (1 + y) - (1 + traceLM F hLE y) = 0 ∨
        2 * valL F E y ≤
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) *
            valL F L (normLM F hLE (1 + y) - (1 + traceLM F hLE y)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalMC_props : valL F M_C 0 = 0 ∧ valL F M_C 1 = 0 ∧ valL F M_C (-1) = 0 ∧
      (∀ x : M_C, valL F M_C (-x) = valL F M_C x) ∧
      (∀ x y : M_C, x ≠ 0 → y ≠ 0 → valL F M_C (x * y) = valL F M_C x + valL F M_C y) ∧
      (∀ u : M_Cˣ, valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = - valL F M_C (u : M_C)) ∧
      (∀ m : ℤ, ∃ c : M_Cˣ, valL F M_C (c : M_C) = m) ∧
      (∀ (k : ℤ) (x y : M_C),
        (x = 0 ∨ k ≤ valL F M_C x) → (y = 0 ∨ k ≤ valL F M_C y) →
          (x + y = 0 ∨ k ≤ valL F M_C (x + y))) ∧
      (∀ u : M_Cˣ, u ∈ unitGroup F M_C 0 ↔ valL F M_C (u : M_C) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M_Cˣ,
        u ∈ unitGroup F M_C a ↔ ((u : M_C) = 1 ∨ (a : ℤ) ≤ valL F M_C ((u : M_C) - 1))) ∧
      (∀ (a : ℕ) (u : M_Cˣ), u ∈ unitGroup F M_C a → valL F M_C (u : M_C) = 0))
    (hvalE_props : valL F E 0 = 0 ∧ valL F E 1 = 0 ∧ valL F E (-1) = 0 ∧
      (∀ x : E, valL F E (-x) = valL F E x) ∧
      (∀ x y : E, x ≠ 0 → y ≠ 0 → valL F E (x * y) = valL F E x + valL F E y) ∧
      (∀ u : Eˣ, valL F E ((u⁻¹ : Eˣ) : E) = - valL F E (u : E)) ∧
      (∀ m : ℤ, ∃ c : Eˣ, valL F E (c : E) = m) ∧
      (∀ (k : ℤ) (x y : E),
        (x = 0 ∨ k ≤ valL F E x) → (y = 0 ∨ k ≤ valL F E y) →
          (x + y = 0 ∨ k ≤ valL F E (x + y))) ∧
      (∀ u : Eˣ, u ∈ unitGroup F E 0 ↔ valL F E (u : E) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Eˣ,
        u ∈ unitGroup F E a ↔ ((u : E) = 1 ∨ (a : ℤ) ≤ valL F E ((u : E) - 1))) ∧
      (∀ (a : ℕ) (u : Eˣ), u ∈ unitGroup F E a → valL F E (u : E) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecMC : ∀ (θM : M_Cˣ →* (Ω F)ˣ),
      (∀ z : M_C, (z = 0 ∨ -condExpChar F M_C (traceChar F hLM_C ψ) ≤ valL F M_C z) →
        traceChar F hLM_C ψ z = 1) ∧
      (∃ z₁ : M_C, z₁ ≠ 0 ∧ -(condExpChar F M_C (traceChar F hLM_C ψ) + 1) ≤ valL F M_C z₁ ∧
        traceChar F hLM_C ψ z₁ ≠ 1) ∧
      (condExp F M_C θM ≠ 0 →
        (∀ u ∈ unitGroup F M_C (condExp F M_C θM), θM u = 1) ∧
        (∃ u₀ ∈ unitGroup F M_C (condExp F M_C θM - 1), θM u₀ ≠ 1)) ∧
      valL F M_C ((tateElt F M_C θM (traceChar F hLM_C ψ) : M_Cˣ) : M_C) =
        (condExp F M_C θM : ℤ) + condExpChar F M_C (traceChar F hLM_C ψ))
    (hSpecE : ∀ (θE : Eˣ →* (Ω F)ˣ),
      (∀ y : E, (y = 0 ∨ -condExpChar F E (traceChar F hLE ψ) ≤ valL F E y) →
        traceChar F hLE ψ y = 1) ∧
      (∃ y₁ : E, y₁ ≠ 0 ∧ -(condExpChar F E (traceChar F hLE ψ) + 1) ≤ valL F E y₁ ∧
        traceChar F hLE ψ y₁ ≠ 1) ∧
      (condExp F E θE ≠ 0 →
        (∀ w ∈ unitGroup F E (condExp F E θE), θE w = 1) ∧
        (∃ w₀ ∈ unitGroup F E (condExp F E θE - 1), θE w₀ ≠ 1)) ∧
      valL F E ((tateElt F E θE (traceChar F hLE ψ) : Eˣ) : E) =
        (condExp F E θE : ℤ) + condExpChar F E (traceChar F hLE ψ))
    (hFinMC : ∀ (a : ℕ), 1 ≤ a →
      Set.Finite {u : M_Cˣ ⧸ unitGroup F M_C a | valL F M_C ((cosetRep u : M_Cˣ) : M_C) = 0}) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    condExpChar F M_C (traceChar F hLM_C ψ) = condExpChar F L ψ ∧
    condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ' ∧
    (2 ≤ condExp F L χ' →
      ∀ i : Fin r, condExp F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ') ∧
    condExpChar F E (traceChar F hLE ψ) = (ℓ : ℤ) * (condExpChar F L ψ + 1) - 1 ∧
    (1 ≤ condExp F L χ' →
      condExp F E (χ'.comp (Units.map (normLM F hLE))) = ℓ * (condExp F L χ' - 1) + 1) ∧
    (condExp F L χ' = 0 →
      tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
        tateEps F L 1 ψ *
        (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
      tateEps F E 1 (traceChar F hLE ψ) *
        tateEps F L χ' ψ *
        (∏ i : Fin r,
          tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
            (traceChar F hLM_C ψ))) :=
by
  let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime_MCK⟩
  have hℓ_pos : 0 < ℓ := hPrime_MCK.pos
  have hℓ_gt1 : 1 < ℓ := hPrime_MCK.one_lt
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL_props
  obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC, hval_surj_MC,
    hval_add_MC, hunit0_MC, hunit_ge1_MC, hunit_val0_MC⟩ := hvalMC_props
  obtain ⟨hval0_E, hval1_E, hval_neg1_E, hval_neg_E, hval_mul_E, hval_inv_E, hval_surj_E,
    hval_add_E, hunit0_E, hunit_ge1_E, hunit_val0_E⟩ := hvalE_props
  have hval_pow_L : ∀ (u : Lˣ) (k : ℕ), valL F L (((u ^ k : Lˣ) : L)) = (k : ℤ) * valL F L (u : L) := by
    intro u k
    induction k with
    | zero => rw [pow_zero, Units.val_one, hval1_L, Nat.cast_zero, zero_mul]
    | succ k ih =>
      rw [pow_succ', Units.val_mul, hval_mul_L (u : L) _ (Units.ne_zero u) (Units.ne_zero _), ih]
      push_cast
      ring
  have hunit_anti_L : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F L m₂ ≤ unitGroup F L m₁ := by
    intro m₁ m₂ hle u hu
    by_cases hm₁ : m₁ = 0
    · subst hm₁
      exact (hunit0_L u).mpr (hunit_val0_L m₂ u hu)
    · rw [hunit_ge1_L m₁ (by omega) u]
      rcases (hunit_ge1_L m₂ (by omega) u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  have hunit_anti_MC : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F M_C m₂ ≤ unitGroup F M_C m₁ := by
    intro m₁ m₂ hle w hw
    by_cases hm₁ : m₁ = 0
    · subst hm₁
      exact (hunit0_MC w).mpr (hunit_val0_MC m₂ w hw)
    · rw [hunit_ge1_MC m₁ (by omega) w]
      rcases (hunit_ge1_MC m₂ (by omega) w).mp hw with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  have hunit_anti_E : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F E m₂ ≤ unitGroup F E m₁ := by
    intro m₁ m₂ hle w hw
    by_cases hm₁ : m₁ = 0
    · subst hm₁
      exact (hunit0_E w).mpr (hunit_val0_E m₂ w hw)
    · rw [hunit_ge1_E m₁ (by omega) w]
      rcases (hunit_ge1_E m₂ (by omega) w).mp hw with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  have hresL_sub : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    have hx₂_neg : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := by
      rcases hx₂ with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_L]; exact hge
    rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ hx₂_neg).1, (hresL_ring x₂ x₂ hx₂ hx₂).2.2, sub_eq_add_neg]
  have hresM_sub : ∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
      resM (z₁ - z₂) = resM z₁ - resM z₂ := by
    intro z₁ z₂ hz₁ hz₂
    have hz₂_neg : -z₂ = 0 ∨ 0 ≤ valL F M_C (-z₂) := by
      rcases hz₂ with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_MC]; exact hge
    rw [sub_eq_add_neg, (hresM_ring z₁ (-z₂) hz₁ hz₂_neg).1, (hresM_ring z₂ z₂ hz₂ hz₂).2.2, sub_eq_add_neg]
  have hint_mul_L : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ hx₁ hx₂
    by_cases h1 : x₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : x₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rw [hval_mul_L x₁ x₂ h1 h2]
        have := hx₁.resolve_left h1
        have := hx₂.resolve_left h2
        omega
  have hint_mul_MC : ∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
      (z₁ * z₂ = 0 ∨ 0 ≤ valL F M_C (z₁ * z₂)) := by
    intro z₁ z₂ hz₁ hz₂
    by_cases h1 : z₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : z₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rw [hval_mul_MC z₁ z₂ h1 h2]
        have := hz₁.resolve_left h1
        have := hz₂.resolve_left h2
        omega
  have hresL_pow : ∀ (x : L) (m : ℕ), (x = 0 ∨ 0 ≤ valL F L x) →
      (x ^ m = 0 ∨ 0 ≤ valL F L (x ^ m)) ∧ resL (x ^ m) = (resL x) ^ m := by
    intro x m hx
    induction m with
    | zero =>
      rw [pow_zero, pow_zero]
      exact ⟨Or.inr (by rw [hval1_L]), hresL_1⟩
    | succ m ih =>
      rw [pow_succ, pow_succ]
      exact ⟨hint_mul_L (x ^ m) x ih.1 hx, by rw [(hresL_ring (x ^ m) x ih.1 hx).2.1, ih.2]⟩
  have hresM_pow : ∀ (z : M_C) (m : ℕ), (z = 0 ∨ 0 ≤ valL F M_C z) →
      (z ^ m = 0 ∨ 0 ≤ valL F M_C (z ^ m)) ∧ resM (z ^ m) = (resM z) ^ m := by
    intro z m hz
    induction m with
    | zero =>
      rw [pow_zero, pow_zero]
      exact ⟨Or.inr (by rw [hval1_MC]), hresM_1⟩
    | succ m ih =>
      rw [pow_succ, pow_succ]
      exact ⟨hint_mul_MC (z ^ m) z ih.1 hz, by rw [(hresM_ring (z ^ m) z ih.1 hz).2.1, ih.2]⟩

  
  let M_C' := IntermediateField.extendScalars hLM_C
  have htrace_inc_mul_MC : ∀ (x : L) (z : M_C),
      traceLM F hLM_C (IntermediateField.inclusion hLM_C x * z) = x * traceLM F hLM_C z := by
    letI : Module L L := Semiring.toModule
    intro x z
    exact (Algebra.trace L M_C').map_smul' x (toExtendScalars F hLM_C z)
  have hy₁_ne : y₁ ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hy₁_tr
    exact zero_ne_one hy₁_tr
  have hy₁_ge0 : (0 : ℤ) ≤ valL F M_C y₁ := hy₁_int.resolve_left hy₁_ne
  set ψMC : AddChar M_C (Ω F) := traceChar F hLM_C ψ
  have hψMC_apply : ∀ z : M_C, ψMC z = ψ (traceLM F hLM_C z) := fun _ => rfl
  have hcondChar_MC : condExpChar F M_C ψMC = condExpChar F L ψ := by
    set nL : ℤ := condExpChar F L ψ
    set nMC : ℤ := condExpChar F M_C ψMC
    have hL_triv := (hSpecL 1).1
    obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_nontriv⟩ := (hSpecL 1).2.1
    have hMC_triv := (hSpecMC 1).1
    obtain ⟨z₁, hz₁_ne, hz₁_val, hz₁_nontriv⟩ := (hSpecMC 1).2.1
    have hnL_le_nMC : nL ≤ nMC := by
      by_contra hlt
      have hle : -nL ≤ -(nMC + 1) := by omega
      have htr := hTraceBound_LMC (-(nMC + 1)) z₁ (Or.inr hz₁_val)
      have htr' : traceLM F hLM_C z₁ = 0 ∨ -nL ≤ valL F L (traceLM F hLM_C z₁) := by
        rcases htr with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (le_trans hle hge)
      exact hz₁_nontriv (hL_triv (traceLM F hLM_C z₁) htr')
    have hnMC_le_nL : nMC ≤ nL := by
      by_contra hlt
      have hle : -nMC ≤ -(nL + 1) := by omega
      let y_x₁ : M_C := IntermediateField.inclusion hLM_C x₁ * y₁
      have hinc_ne : IntermediateField.inclusion hLM_C x₁ ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hLM_C).toRingHom).ne hx₁_ne
      have hy_val : -nMC ≤ valL F M_C y_x₁ := by
        dsimp [y_x₁]
        rw [hval_mul_MC _ _ hinc_ne hy₁_ne, hValAlg_LMC x₁]
        omega
      have hy_triv : ψMC y_x₁ = 1 := hMC_triv y_x₁ (Or.inr hy_val)
      rw [hψMC_apply, htrace_inc_mul_MC x₁ y₁, hy₁_tr, mul_one] at hy_triv
      exact hx₁_nontriv hy_triv
    omega

  have hπ_bij : Function.Bijective π_res := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨hπ_inj, ?_⟩
    have hcard_aut : Fintype.card (k_M ≃ₐ[k_L] k_M) = Module.finrank k_L k_M := by
      rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank k_L k_M]
    rw [hcard_aut, hfinrank_res, hcard_G]
  have hresM_prod_act : ∀ (z : M_C), (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∀ (T : Finset G),
        ((∏ σ ∈ T, act σ z) = 0 ∨ 0 ≤ valL F M_C (∏ σ ∈ T, act σ z)) ∧
        resM (∏ σ ∈ T, act σ z) = ∏ σ ∈ T, π_res σ (resM z) := by
    intro z hz T
    induction T using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty, Finset.prod_empty]
      exact ⟨Or.inr (by rw [hval1_MC]), hresM_1⟩
    | @insert σ₀ S hσ₀ ih =>
      rw [Finset.prod_insert hσ₀, Finset.prod_insert hσ₀]
      have hact_int : act σ₀ z = 0 ∨ 0 ≤ valL F M_C (act σ₀ z) := by
        rcases hz with rfl | hge
        · right; rw [hact_val, hval0_MC]
        · right; rw [hact_val]; exact hge
      refine ⟨hint_mul_MC _ _ hact_int ih.1, ?_⟩
      rw [(hresM_ring _ _ hact_int ih.1).2.1, ← hπ_res σ₀ z hz, ih.2]
  have hres_norm : ∀ (z : M_C), (z = 0 ∨ 0 ≤ valL F M_C z) →
      resL (normLM F hLM_C z) = Algebra.norm k_L (resM z) := by
    intro z hz
    have hnorm_int : normLM F hLM_C z = 0 ∨ 0 ≤ valL F L (normLM F hLM_C z) := by
      rcases hz with rfl | hge
      · right; rw [hValNorm_LMC 0, hval0_MC, mul_zero]
      · right
        rw [hValNorm_LMC z]
        exact mul_nonneg (Nat.cast_nonneg _) hge
    apply (algebraMap k_L k_M).injective
    rw [← hres_alg (normLM F hLM_C z) hnorm_int, hact_norm z,
      (hresM_prod_act z hz Finset.univ).2, Algebra.norm_eq_prod_automorphisms k_L (resM z)]
    exact Fintype.prod_bijective π_res hπ_bij (fun σ => π_res σ (resM z)) (fun τ => τ (resM z)) (fun _ => rfl)
  have hnorm_surj_mod1 : ∀ u₀ ∈ unitGroup F L 0,
      ∃ w₀ ∈ unitGroup F M_C 0, Units.map (normLM F hLM_C) w₀ * u₀⁻¹ ∈ unitGroup F L 1 := by
    intro u₀ hu₀
    have hu₀_val : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀
    have hu₀_int : (u₀ : L) = 0 ∨ 0 ≤ valL F L (u₀ : L) := Or.inr (by omega)
    have hres_u₀_ne0 : resL (u₀ : L) ≠ 0 := by
      intro h0
      rcases (hresL_ker (u₀ : L) hu₀_int).mp h0 with h | h
      · exact Units.ne_zero u₀ h
      · omega
    obtain ⟨b₀, hb₀⟩ := FiniteField.norm_surjective k_L k_M (resL (u₀ : L))
    have hb₀_ne0 : b₀ ≠ 0 := by
      intro h0
      rw [h0, Algebra.norm_zero] at hb₀
      exact hres_u₀_ne0 hb₀.symm
    obtain ⟨z₀', hz₀'_int, hz₀'_res⟩ := hresM_surj b₀
    have hz₀'_not_ker : ¬ (z₀' = 0 ∨ 1 ≤ valL F M_C z₀') := by
      rw [← hresM_ker z₀' hz₀'_int, hz₀'_res]
      exact hb₀_ne0
    have hz₀'_ne0 : z₀' ≠ 0 := fun h0 => hz₀'_not_ker (Or.inl h0)
    have hz₀'_val0 : valL F M_C z₀' = 0 := by
      have hge0 := hz₀'_int.resolve_left hz₀'_ne0
      omega
    let w₀ : M_Cˣ := Units.mk0 z₀' hz₀'_ne0
    have hw₀_mem0 : w₀ ∈ unitGroup F M_C 0 := (hunit0_MC w₀).mpr hz₀'_val0
    let v₀ : Lˣ := Units.map (normLM F hLM_C) w₀
    have hv₀_val0 : valL F L (v₀ : L) = 0 := by
      change valL F L (normLM F hLM_C z₀') = 0
      rw [hValNorm_LMC z₀', hz₀'_val0, mul_zero]
    have hv₀_int : (v₀ : L) = 0 ∨ 0 ≤ valL F L (v₀ : L) := Or.inr (by omega)
    have hdiff_int : (v₀ : L) - (u₀ : L) = 0 ∨ 0 ≤ valL F L ((v₀ : L) - (u₀ : L)) := by
      have hu₀_neg_int : -(u₀ : L) = 0 ∨ 0 ≤ valL F L (-(u₀ : L)) := by
        right; rw [hval_neg_L, hu₀_val]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 (v₀ : L) (-(u₀ : L)) hv₀_int hu₀_neg_int
    have hres_diff : resL ((v₀ : L) - (u₀ : L)) = 0 := by
      rw [hresL_sub (v₀ : L) (u₀ : L) hv₀_int hu₀_int]
      change resL (normLM F hLM_C z₀') - resL (u₀ : L) = 0
      rw [hres_norm z₀' hz₀'_int, hz₀'_res, hb₀, sub_self]
    have hdiff_val1 : (v₀ : L) - (u₀ : L) = 0 ∨ 1 ≤ valL F L ((v₀ : L) - (u₀ : L)) :=
      (hresL_ker _ hdiff_int).mp hres_diff
    refine ⟨w₀, hw₀_mem0, ?_⟩
    rw [hunit_ge1_L 1 le_rfl (v₀ * u₀⁻¹)]
    have hsub_eq : (((v₀ * u₀⁻¹ : Lˣ) : L)) - 1 = ((v₀ : L) - (u₀ : L)) * ((u₀⁻¹ : Lˣ) : L) := by
      rw [Units.val_mul, sub_mul, Units.mul_inv]
    by_cases h0 : (v₀ : L) - (u₀ : L) = 0
    · left
      have : (((v₀ * u₀⁻¹ : Lˣ) : L)) - 1 = 0 := by rw [hsub_eq, h0, zero_mul]
      exact sub_eq_zero.mp this
    · right
      rw [hsub_eq, hval_mul_L _ _ h0 (Units.ne_zero u₀⁻¹), hval_inv_L u₀, hu₀_val, neg_zero, add_zero]
      exact hdiff_val1.resolve_left h0

  set χ'MC : M_Cˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLM_C))
  set aL : ℕ := condExp F L χ'
  set aMC : ℕ := condExp F M_C χ'MC
  have hnorm_unit_MC : ∀ (m : ℕ) (w : M_Cˣ),
      w ∈ unitGroup F M_C m → Units.map (normLM F hLM_C) w ∈ unitGroup F L m := by
    intro m w hw
    by_cases hm : m = 0
    · subst hm
      have hw0 : valL F M_C (w : M_C) = 0 := (hunit0_MC w).mp hw
      rw [hunit0_L]
      change valL F L (normLM F hLM_C (w : M_C)) = 0
      rw [hValNorm_LMC (w : M_C), hw0, mul_zero]
    · have hm1 : 1 ≤ m := by omega
      rw [hunit_ge1_L m hm1]
      let z : M_C := (w : M_C) - 1
      have hz : z = 0 ∨ (m : ℤ) ≤ valL F M_C z := by
        rcases (hunit_ge1_MC m hm1 w).mp hw with h1 | hge
        · left; dsimp [z]; rw [h1, sub_self]
        · exact Or.inr hge
      have htr_z := hTraceBound_LMC (m : ℤ) z hz
      have hlin_z := hNormLin_LMC m hm1 z hz
      let δ : L := normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)
      have hδ : δ = 0 ∨ (m : ℤ) ≤ valL F L δ := by
        rcases hlin_z with h0 | hge
        · exact Or.inl h0
        · right
          have h2m : (m : ℤ) ≤ (2 * m : ℤ) := by omega
          exact le_trans h2m hge
      have hsum := hval_add_L (m : ℤ) δ (traceLM F hLM_C z) hδ htr_z
      have h1z : 1 + z = (w : M_C) := by dsimp [z]; ring
      have hsum_eq : δ + traceLM F hLM_C z = normLM F hLM_C (w : M_C) - 1 := by
        dsimp [δ]; rw [h1z]; ring
      rw [hsum_eq] at hsum
      change (normLM F hLM_C (w : M_C) = 1) ∨ (m : ℤ) ≤ valL F L (normLM F hLM_C (w : M_C) - 1)
      rcases hsum with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
  have haMC_le_aL : aMC ≤ aL := by
    apply Nat.sInf_le
    intro w hw
    exact hχ'_cond (Units.map (normLM F hLM_C) w) (hnorm_unit_MC aL w hw)
  have haL_le_aMC : aL ≤ aMC := by
    by_cases haL0 : aL = 0
    · omega
    · obtain ⟨_, u₀, hu₀_mem, hu₀_ne1⟩ := (hSpecL χ').2.2.1 haL0
      have hex_w₀ : ∃ w₀ ∈ unitGroup F M_C (aL - 1), χ'MC w₀ ≠ 1 := by
        by_cases haL1 : aL = 1
        · have hu₀_0 : u₀ ∈ unitGroup F L 0 := by
            change u₀ ∈ unitGroup F L (aL - 1) at hu₀_mem
            simpa [haL1] using hu₀_mem
          obtain ⟨w₀, hw₀_0, hw₀_mod1⟩ := hnorm_surj_mod1 u₀ hu₀_0
          refine ⟨w₀, ?_, ?_⟩
          · simpa [haL1] using hw₀_0
          · let h_u : Lˣ := Units.map (normLM F hLM_C) w₀ * u₀⁻¹
            have hh_u_triv : χ' h_u = 1 := by
              apply hχ'_cond
              rw [haL1]
              exact hw₀_mod1
            have hv₀_eq : Units.map (normLM F hLM_C) w₀ = h_u * u₀ := by
              dsimp [h_u]
              exact (inv_mul_cancel_right _ _).symm
            change χ' (Units.map (normLM F hLM_C) w₀) ≠ 1
            rw [hv₀_eq, map_mul, hh_u_triv, one_mul]
            exact hu₀_ne1
        · have haL2 : 2 ≤ aL := by omega
          set d : ℕ := aL - 1
          have hd1 : 1 ≤ d := by omega
          have hu₀_ne_one : (u₀ : L) ≠ 1 := by
            intro h1
            have hu1 : u₀ = 1 := Units.ext h1
            rw [hu1, map_one] at hu₀_ne1
            exact hu₀_ne1 rfl
          set x₀ : L := (u₀ : L) - 1
          have hx₀_ne : x₀ ≠ 0 := sub_ne_zero.mpr hu₀_ne_one
          have hx₀_val : (d : ℤ) ≤ valL F L x₀ :=
            ((hunit_ge1_L d hd1 u₀).mp hu₀_mem).resolve_left hu₀_ne_one
          set z₀' : M_C := IntermediateField.inclusion hLM_C x₀ * y₁
          have hinc_x₀_ne : IntermediateField.inclusion hLM_C x₀ ≠ 0 :=
            (RingHom.injective (IntermediateField.inclusion hLM_C).toRingHom).ne hx₀_ne
          have hz₀'_ne : z₀' ≠ 0 := mul_ne_zero hinc_x₀_ne hy₁_ne
          have hz₀'_val : (d : ℤ) ≤ valL F M_C z₀' := by
            dsimp [z₀']
            rw [hval_mul_MC _ _ hinc_x₀_ne hy₁_ne, hValAlg_LMC x₀]
            omega
          have hz₀'_tr : traceLM F hLM_C z₀' = x₀ := by
            dsimp [z₀']
            rw [htrace_inc_mul_MC x₀ y₁, hy₁_tr, mul_one]
          have h1z₀'_ne : (1 : M_C) + z₀' ≠ 0 := by
            intro h0
            have hz_neg1 : z₀' = -1 := eq_neg_of_add_eq_zero_right h0
            have hval_z : valL F M_C z₀' = 0 := by rw [hz_neg1, hval_neg1_MC]
            omega
          let w₀ : M_Cˣ := Units.mk0 (1 + z₀') h1z₀'_ne
          have hw₀_mem : w₀ ∈ unitGroup F M_C d := by
            rw [hunit_ge1_MC d hd1 w₀]
            right
            have hw₀_sub : (w₀ : M_C) - 1 = z₀' := by
              change (1 + z₀') - 1 = z₀'
              ring
            rw [hw₀_sub]
            exact hz₀'_val
          let v₀ : Lˣ := Units.map (normLM F hLM_C) w₀
          set δ₀ : L := (v₀ : L) - (u₀ : L)
          have hδ₀_eq : δ₀ = normLM F hLM_C (1 + z₀') - (1 + traceLM F hLM_C z₀') := by
            dsimp [δ₀, v₀, w₀, x₀]
            rw [hz₀'_tr]
            ring
          have hδ₀_val : δ₀ = 0 ∨ (aL : ℤ) ≤ valL F L δ₀ := by
            rw [hδ₀_eq]
            rcases hNormLin_LMC d hd1 z₀' (Or.inr hz₀'_val) with h0 | hge
            · exact Or.inl h0
            · right
              have h2d : (aL : ℤ) ≤ (2 * d : ℤ) := by omega
              exact le_trans h2d hge
          let h : Lˣ := v₀ * u₀⁻¹
          have hh_mem : h ∈ unitGroup F L aL := by
            rw [hunit_ge1_L aL (by omega) h]
            have hh_sub : (h : L) - 1 = δ₀ * ((u₀⁻¹ : Lˣ) : L) := by
              dsimp [h, δ₀]
              rw [sub_mul, Units.mul_inv]
            by_cases hδ₀_0 : δ₀ = 0
            · left
              have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hδ₀_0, zero_mul]
              exact sub_eq_zero.mp hsub0
            · right
              rw [hh_sub, hval_mul_L δ₀ ((u₀⁻¹ : Lˣ) : L) hδ₀_0 (Units.ne_zero u₀⁻¹),
                hval_inv_L u₀, hunit_val0_L d u₀ hu₀_mem, neg_zero, add_zero]
              exact hδ₀_val.resolve_left hδ₀_0
          have hv₀_eq : v₀ = h * u₀ := by
            dsimp [h]
            rw [inv_mul_cancel_right]
          refine ⟨w₀, hw₀_mem, ?_⟩
          change χ' v₀ ≠ 1
          rw [hv₀_eq, map_mul, hχ'_cond h hh_mem, one_mul]
          exact hu₀_ne1
      obtain ⟨w₀, hw₀_mem, hw₀_ne1⟩ := hex_w₀
      by_contra hlt
      have hle : aMC ≤ aL - 1 := by omega
      have hw₀_aMC : w₀ ∈ unitGroup F M_C aMC := hunit_anti_MC hle hw₀_mem
      exact hw₀_ne1 (hχ'MC_cond w₀ hw₀_aMC)
  have hcond_MC : aMC = aL := le_antisymm haMC_le_aL haL_le_aMC

  have hcond_νχ_MC : 2 ≤ aL →
      ∀ i : Fin r, condExp F M_C (ν_orb i * χ'MC) = aL := by
    intro haL2 i
    have hν_triv1 : ∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1 := (hν_cond1 i).2
    have hχ'MC_triv : ∀ w ∈ unitGroup F M_C aL, χ'MC w = 1 := by
      intro w hw
      rw [← hcond_MC] at hw
      exact hχ'MC_cond w hw
    apply le_antisymm
    · apply Nat.sInf_le
      intro w hw
      have hw1 : w ∈ unitGroup F M_C 1 := hunit_anti_MC (by omega) hw
      rw [MonoidHom.mul_apply, hν_triv1 w hw1, hχ'MC_triv w hw, mul_one]
    · obtain ⟨w₀, hw₀_mem, hw₀_ne1⟩ := ((hSpecMC χ'MC).2.2.1 (by omega)).2
      change w₀ ∈ unitGroup F M_C (aMC - 1) at hw₀_mem
      rw [hcond_MC] at hw₀_mem
      have hw₀_1 : w₀ ∈ unitGroup F M_C 1 := hunit_anti_MC (by omega) hw₀_mem
      have htw_ne1 : (ν_orb i * χ'MC) w₀ ≠ 1 := by
        rw [MonoidHom.mul_apply, hν_triv1 w₀ hw₀_1, one_mul]
        exact hw₀_ne1
      by_contra hlt
      have hle : condExp F M_C (ν_orb i * χ'MC) ≤ aL - 1 := by omega
      have hw₀_cond : w₀ ∈ unitGroup F M_C (condExp F M_C (ν_orb i * χ'MC)) :=
        hunit_anti_MC hle hw₀_mem
      have h1_eq : (ν_orb i) ^ 1 * χ'MC = ν_orb i * χ'MC := by rw [pow_one]
      have htriv := (hν_props i).2.2.2.2 1 hℓ_gt1 w₀ (by rw [h1_eq]; exact hw₀_cond)
      rw [h1_eq] at htriv
      exact htw_ne1 htriv

  
  have hNotDvd : ¬ (ℓ ∣ (Fintype.card k_L - 1)) := by
    intro ⟨m, hm⟩
    have hz₀_int : (z₀ : M_C) = 0 ∨ 0 ≤ valL F M_C (z₀ : M_C) := Or.inr (by omega)
    have hz₀_pow_int : (((z₀ ^ ℓ : M_Cˣ) : M_C)) = 0 ∨ 0 ≤ valL F M_C (((z₀ ^ ℓ : M_Cˣ) : M_C)) := by
      right
      rw [hunit_val0_MC 1 (z₀ ^ ℓ) hz₀_pow]
    have hz₀_pow_sub_int : (((z₀ ^ ℓ : M_Cˣ) : M_C)) - 1 = 0 ∨
        0 ≤ valL F M_C ((((z₀ ^ ℓ : M_Cˣ) : M_C)) - 1) := by
      rw [sub_eq_add_neg]
      exact hval_add_MC 0 _ (-1) hz₀_pow_int (Or.inr (by rw [hval_neg1_MC]))
    have hz₀_pow_ker : (((z₀ ^ ℓ : M_Cˣ) : M_C)) - 1 = 0 ∨
        1 ≤ valL F M_C ((((z₀ ^ ℓ : M_Cˣ) : M_C)) - 1) := by
      rcases (hunit_ge1_MC 1 le_rfl (z₀ ^ ℓ)).mp hz₀_pow with h1 | hge
      · left; exact sub_eq_zero.mpr h1
      · right; exact hge
    have hres_z₀_pow : (resM (z₀ : M_C)) ^ ℓ = 1 := by
      have h0 : resM ((((z₀ ^ ℓ : M_Cˣ) : M_C)) - 1) = 0 :=
        (hresM_ker _ hz₀_pow_sub_int).mpr hz₀_pow_ker
      rw [hresM_sub _ 1 hz₀_pow_int (Or.inr (by rw [hval1_MC])), hresM_1, sub_eq_zero] at h0
      rw [← (hresM_pow (z₀ : M_C) ℓ hz₀_int).2]
      exact h0
    have hcard_kL_pos : 0 < Fintype.card k_L := Fintype.card_pos
    have hres_z₀_card : (resM (z₀ : M_C)) ^ (Fintype.card k_L) = resM (z₀ : M_C) := by
      have hsub1 : Fintype.card k_L - 1 + 1 = Fintype.card k_L := Nat.sub_add_cancel hcard_kL_pos
      rw [← hsub1, pow_succ, hm, pow_mul, hres_z₀_pow, one_pow, one_mul]
    let frob : (k_M ≃ₐ[k_L] k_M) := FiniteField.frobeniusAlgEquivOfAlgebraic k_L k_M
    have hfrob_z₀ : frob (resM (z₀ : M_C)) = resM (z₀ : M_C) := by
      change (FiniteField.frobeniusAlgEquivOfAlgebraic k_L k_M) (resM (z₀ : M_C)) = resM (z₀ : M_C)
      rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply k_L k_M, hres_z₀_card]
    have hfrob_pow_z₀ : ∀ n : ℕ, (frob ^ n) (resM (z₀ : M_C)) = resM (z₀ : M_C) := by
      intro n
      induction n with
      | zero => rfl
      | succ n ih =>
        rw [pow_succ, AlgEquiv.mul_apply, hfrob_z₀, ih]
    have hcard_G_gt1 : 1 < Fintype.card G := by omega
    obtain ⟨σ, hσ_ne1⟩ := Fintype.exists_ne_of_one_lt_card hcard_G_gt1 (1 : G)
    obtain ⟨i, hi⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow k_L k_M).2 (π_res σ)
    have hπ_σ_z₀ : π_res σ (resM (z₀ : M_C)) = resM (z₀ : M_C) := by
      rw [← hi]
      exact hfrob_pow_z₀ (i : ℕ)
    have hact_σ_int : act σ (z₀ : M_C) = 0 ∨ 0 ≤ valL F M_C (act σ (z₀ : M_C)) := by
      right; rw [hact_val, hz₀_val]
    have hdiff_σ_int : act σ (z₀ : M_C) - (z₀ : M_C) = 0 ∨
        0 ≤ valL F M_C (act σ (z₀ : M_C) - (z₀ : M_C)) := by
      right; rw [(hz₀_act_move σ hσ_ne1).2]
    have hres_diff_σ : resM (act σ (z₀ : M_C) - (z₀ : M_C)) = 0 := by
      rw [hresM_sub _ _ hact_σ_int hz₀_int, ← hπ_res σ (z₀ : M_C) hz₀_int, hπ_σ_z₀, sub_self]
    rcases (hresM_ker _ hdiff_σ_int).mp hres_diff_σ with h0 | hge1
    · exact (hz₀_act_move σ hσ_ne1).1 h0
    · have hval0 := (hz₀_act_move σ hσ_ne1).2
      omega

  let E' := IntermediateField.extendScalars hLE
  let u_ℓ : Lˣ := Units.mk0 (ℓ : L) hℓ_ne0_L
  have hℓ_inv_ne0 : ((ℓ : L)⁻¹) ≠ 0 := inv_ne_zero hℓ_ne0_L
  have hℓ_inv_val0 : valL F L ((ℓ : L)⁻¹) = 0 := by
    have hu : ((u_ℓ⁻¹ : Lˣ) : L) = (ℓ : L)⁻¹ := rfl
    rw [← hu, hval_inv_L u_ℓ]
    change - valL F L (ℓ : L) = 0
    rw [hℓ_val0_L, neg_zero]
  have hto_incl_LE : ∀ x : L, toExtendScalars F hLE (IntermediateField.inclusion hLE x) = algebraMap L E' x :=
    fun _ => rfl
  have htrace_incl_LE : ∀ x : L, traceLM F hLE (IntermediateField.inclusion hLE x) = (ℓ : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change Algebra.trace L E' (toExtendScalars F hLE (IntermediateField.inclusion hLE x)) = (ℓ : L) * x
    rw [hto_incl_LE x, Algebra.trace_algebraMap x, hFinE_eq, nsmul_eq_mul]
  let y_x : L → E := fun x => IntermediateField.inclusion hLE ((ℓ : L)⁻¹ * x)
  have hy_x_tr : ∀ x : L, traceLM F hLE (y_x x) = x := by
    intro x
    dsimp [y_x]
    rw [htrace_incl_LE, ← mul_assoc, mul_inv_cancel₀ hℓ_ne0_L, one_mul]
  have hy_x_ne0 : ∀ {x : L}, x ≠ 0 → y_x x ≠ 0 := by
    intro x hx
    dsimp [y_x]
    rw [← map_zero (IntermediateField.inclusion hLE)]
    exact (IntermediateField.inclusion hLE).injective.ne (mul_ne_zero hℓ_inv_ne0 hx)
  have hy_x_val : ∀ {x : L}, x ≠ 0 → valL F E (y_x x) = (ℓ : ℤ) * valL F L x := by
    intro x hx
    dsimp [y_x]
    rw [hValAlg_LE, hval_mul_L ((ℓ : L)⁻¹) x hℓ_inv_ne0 hx, hℓ_inv_val0, zero_add]
  let ψE := traceChar F hLE ψ
  have hψE_app : ∀ y : E, ψE y = ψ (traceLM F hLE y) := fun _ => rfl
  let n := condExpChar F L ψ
  let nE := condExpChar F E ψE
  have hcondChar_E : nE = (ℓ : ℤ) * (n + 1) - 1 := by
    have hle1 : nE ≤ (ℓ : ℤ) * (n + 1) - 1 := by
      obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩ := (hSpecL 1).2.1
      let y₁' := y_x x₁
      have hy₁'_ψ : ψE y₁' ≠ 1 := by
        rw [hψE_app, hy_x_tr]
        exact hx₁_ψ
      have hy₁'_val : -(((ℓ : ℤ) * (n + 1) - 1) + 1) ≤ valL F E y₁' := by
        rw [hy_x_val hx₁_ne0]
        have : (ℓ : ℤ) * (-(n + 1)) ≤ (ℓ : ℤ) * valL F L x₁ :=
          mul_le_mul_of_nonneg_left hx₁_val (by omega)
        linarith
      by_contra hlt
      push_neg at hlt
      have htriv : ψE y₁' = 1 := (hSpecE 1).1 y₁' (Or.inr (by change -nE ≤ valL F E y₁'; omega))
      exact hy₁'_ψ htriv
    have hle2 : (ℓ : ℤ) * (n + 1) - 1 ≤ nE := by
      obtain ⟨y₂, hy₂_ne0, hy₂_val, hy₂_ψ⟩ := (hSpecE 1).2.1
      by_contra hlt
      push_neg at hlt
      have hbound : (ℓ : ℤ) * (-n) - ((ℓ : ℤ) - 1) ≤ valL F E y₂ := by
        have : -((ℓ : ℤ) * (n + 1) - 1) ≤ -(nE + 1) := by omega
        linarith
      have htr_val := hTraceBound_LE (-n) y₂ (Or.inr hbound)
      have htriv : ψE y₂ = 1 := by
        rw [hψE_app]
        apply (hSpecL 1).1 (traceLM F hLE y₂)
        rcases htr_val with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by change -n ≤ valL F L (traceLM F hLE y₂); omega)
      exact hy₂_ψ htriv
    omega

  let χ'E : Eˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLE))
  have hcond_E : 1 ≤ condExp F L χ' →
      condExp F E χ'E = ℓ * (condExp F L χ' - 1) + 1 := by
    intro ha_pos
    let a := condExp F L χ'
    let A := ℓ * (a - 1) + 1
    have hA_pos : 1 ≤ A := by omega
    have hχ'_triv_a : ∀ u ∈ unitGroup F L a, χ' u = 1 := hχ'_cond
    have haE_le_A : condExp F E χ'E ≤ A := by
      apply Nat.sInf_le
      intro w hw
      let y : E := (w : E) - 1
      have hwy : (w : E) = 1 + y := by dsimp [y]; ring
      have hy_val : y = 0 ∨ (A : ℤ) ≤ valL F E y := by
        rcases (hunit_ge1_E A hA_pos w).mp hw with h1 | hge
        · left; dsimp [y]; rw [h1, sub_self]
        · right; exact hge
      have hA_eq : (A : ℤ) = (ℓ : ℤ) * (a : ℤ) - ((ℓ : ℤ) - 1) := by
        dsimp [A]
        have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
        rw [ha_sub]
        ring
      have htr_val : traceLM F hLE y = 0 ∨ (a : ℤ) ≤ valL F L (traceLM F hLE y) := by
        apply hTraceBound_LE (a : ℤ) y
        rcases hy_val with hy0 | hge
        · exact Or.inl hy0
        · exact Or.inr (by linarith)
      let rem : L := normLM F hLE (1 + y) - (1 + traceLM F hLE y)
      have hrem_val : rem = 0 ∨ (a : ℤ) ≤ valL F L rem := by
        have hy_val1 : y = 0 ∨ 1 ≤ valL F E y := by
          rcases hy_val with hy0 | hge
          · exact Or.inl hy0
          · exact Or.inr (by omega)
        rcases hNormRem_LE y hy_val1 with hr0 | hrem
        · exact Or.inl hr0
        · by_cases hy0 : y = 0
          · left
            dsimp [rem]
            rw [hy0, add_zero, map_one, map_zero, add_zero, sub_self]
          · right
            have hy_geA : (A : ℤ) ≤ valL F E y := hy_val.resolve_left hy0
            have hA_int : (A : ℤ) = (ℓ : ℤ) * ((a : ℤ) - 1) + 1 := by
              dsimp [A]
              have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
              rw [ha_sub]
            have h2A : (ℓ : ℤ) * ((a : ℤ) - 1) < 2 * valL F E y := by nlinarith
            have hlt_mul : (ℓ : ℤ) * ((a : ℤ) - 1) < (ℓ : ℤ) * valL F L rem :=
              lt_of_lt_of_le h2A hrem
            have hlt_a : (a : ℤ) - 1 < valL F L rem := by nlinarith
            omega
      have hnorm_sub : (((Units.map (normLM F hLE) w : Lˣ) : L)) - 1 = traceLM F hLE y + rem := by
        change normLM F hLE (w : E) - 1 = traceLM F hLE y + rem
        rw [hwy]
        dsimp [rem]
        ring
      have hnorm_mem : Units.map (normLM F hLE) w ∈ unitGroup F L a := by
        rw [hunit_ge1_L a ha_pos]
        rcases hval_add_L (a : ℤ) (traceLM F hLE y) rem htr_val hrem_val with h0 | hge
        · left
          rw [← sub_eq_zero, hnorm_sub]
          exact h0
        · right
          rw [hnorm_sub]
          exact hge
      exact hχ'_triv_a (Units.map (normLM F hLE) w) hnorm_mem
    have hA_le_aE : A ≤ condExp F E χ'E := by
      by_cases ha1 : a = 1
      · have hA1 : A = 1 := by dsimp [A]; rw [ha1]; rfl
        by_contra hlt
        have haE0 : condExp F E χ'E = 0 := by omega
        have hχ'E_triv0 : ∀ w ∈ unitGroup F E 0, χ'E w = 1 := by
          intro w hw
          have h := hχ'E_cond w
          rw [haE0] at h
          exact h hw
        obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := ((hSpecL χ').2.2.1 (by omega)).2
        have hu₀_mem0 : u₀ ∈ unitGroup F L 0 := by
          change u₀ ∈ unitGroup F L (a - 1) at hu₀_mem
          simpa [ha1] using hu₀_mem
        have hu₀_val0 : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀_mem0
        let w₀ : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom u₀
        have hw₀_val0 : valL F E (w₀ : E) = 0 := by
          change valL F E (IntermediateField.inclusion hLE (u₀ : L)) = 0
          rw [hValAlg_LE (u₀ : L), hu₀_val0, mul_zero]
        have hw₀_mem0 : w₀ ∈ unitGroup F E 0 := (hunit0_E w₀).mpr hw₀_val0
        have hnorm_w₀ : Units.map (normLM F hLE) w₀ = u₀ ^ ℓ := by
          apply Units.ext
          change Algebra.norm L (toExtendScalars F hLE (IntermediateField.inclusion hLE (u₀ : L))) = (u₀ : L) ^ ℓ
          rw [hto_incl_LE (u₀ : L), Algebra.norm_algebraMap (u₀ : L), hFinE_eq]
        have hχ'_u₀_pow : (χ' u₀) ^ ℓ = 1 := by
          rw [← map_pow, ← hnorm_w₀]
          exact hχ'E_triv0 w₀ hw₀_mem0
        have hord_u₀ : orderOf (χ' u₀) = ℓ := orderOf_eq_prime hχ'_u₀_pow hu₀_ne1
        have hu₀_int : (u₀ : L) = 0 ∨ 0 ≤ valL F L (u₀ : L) := Or.inr (by omega)
        have hres_u₀_ne0 : resL (u₀ : L) ≠ 0 := by
          intro h0
          rcases (hresL_ker (u₀ : L) hu₀_int).mp h0 with h | h
          · exact Units.ne_zero u₀ h
          · omega
        let M_card := Fintype.card k_L - 1
        have hres_u₀_card : (resL (u₀ : L)) ^ M_card = 1 :=
          FiniteField.pow_card_sub_one_eq_one (resL (u₀ : L)) hres_u₀_ne0
        have hu₀_card_int : (((u₀ ^ M_card : Lˣ) : L)) = 0 ∨ 0 ≤ valL F L (((u₀ ^ M_card : Lˣ) : L)) :=
          (hresL_pow (u₀ : L) M_card hu₀_int).1
        have hu₀_card_sub_int : (((u₀ ^ M_card : Lˣ) : L)) - 1 = 0 ∨
            0 ≤ valL F L ((((u₀ ^ M_card : Lˣ) : L)) - 1) := by
          rw [sub_eq_add_neg]
          exact hval_add_L 0 _ (-1) hu₀_card_int (Or.inr (by rw [hval_neg1_L]))
        have hres_card_sub : resL ((((u₀ ^ M_card : Lˣ) : L)) - 1) = 0 := by
          rw [hresL_sub _ 1 hu₀_card_int (Or.inr (by rw [hval1_L])),
            Units.val_pow_eq_pow_val, (hresL_pow (u₀ : L) M_card hu₀_int).2,
            hres_u₀_card, hresL_1, sub_self]
        have hu₀_card_mem1 : u₀ ^ M_card ∈ unitGroup F L 1 := by
          rw [hunit_ge1_L 1 le_rfl (u₀ ^ M_card)]
          rcases (hresL_ker _ hu₀_card_sub_int).mp hres_card_sub with h0 | hge1
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hge1
        have hχ'_u₀_card : (χ' u₀) ^ M_card = 1 := by
          rw [← map_pow]
          apply hχ'_triv_a
          rw [ha1]
          exact hu₀_card_mem1
        have hdvd : ℓ ∣ M_card := by
          rw [← hord_u₀]
          exact orderOf_dvd_iff_pow_eq_one.mpr hχ'_u₀_card
        exact hNotDvd hdvd
      · have ha2 : 2 ≤ a := by omega
        have hA_ge2 : 2 ≤ A - 1 := by
          dsimp [A]
          have : 1 ≤ a - 1 := by omega
          nlinarith
        obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := ((hSpecL χ').2.2.1 (by omega)).2
        have hu₀_val_ne1 : (u₀ : L) ≠ 1 := by
          intro h1
          apply hu₀_ne1
          have hu₀_eq1 : u₀ = 1 := Units.ext h1
          rw [hu₀_eq1, map_one]
        let x₀ : L := (u₀ : L) - 1
        have hx₀_ne0 : x₀ ≠ 0 := sub_ne_zero.mpr hu₀_val_ne1
        have hx₀_val : ((a - 1 : ℕ) : ℤ) ≤ valL F L x₀ :=
          ((hunit_ge1_L (a - 1) (by omega) u₀).mp hu₀_mem).resolve_left hu₀_val_ne1
        let y₀ : E := y_x x₀
        have hy₀_ne0 : y₀ ≠ 0 := hy_x_ne0 hx₀_ne0
        have hy₀_tr : traceLM F hLE y₀ = x₀ := hy_x_tr x₀
        have hy₀_val : (ℓ : ℤ) * ((a - 1 : ℕ) : ℤ) ≤ valL F E y₀ := by
          rw [hy_x_val hx₀_ne0]
          exact mul_le_mul_of_nonneg_left hx₀_val (by omega)
        have hA_sub1_int : ((A - 1 : ℕ) : ℤ) = (ℓ : ℤ) * ((a - 1 : ℕ) : ℤ) := by
          dsimp [A]
        have hy₀_ge2 : (2 : ℤ) ≤ valL F E y₀ := by
          have : (2 : ℤ) ≤ ((A - 1 : ℕ) : ℤ) := by exact_mod_cast hA_ge2
          linarith
        have h1y₀_ne0 : 1 + y₀ ≠ 0 := by
          intro h0
          have hy₀_eq : y₀ = -1 := eq_neg_of_add_eq_zero_right h0
          have hval : valL F E y₀ = 0 := by rw [hy₀_eq, hval_neg1_E]
          omega
        let w₀ : Eˣ := Units.mk0 (1 + y₀) h1y₀_ne0
        have hw₀_mem : w₀ ∈ unitGroup F E (A - 1) := by
          rw [hunit_ge1_E (A - 1) (by omega) w₀]
          right
          have hsub : (w₀ : E) - 1 = y₀ := by change (1 + y₀) - 1 = y₀; ring
          rw [hsub, hA_sub1_int]
          exact hy₀_val
        let v₀ : Lˣ := Units.map (normLM F hLE) w₀
        let δ₀ : L := (v₀ : L) - (u₀ : L)
        have hδ₀_eq : δ₀ = normLM F hLE (1 + y₀) - (1 + traceLM F hLE y₀) := by
          change normLM F hLE (1 + y₀) - (u₀ : L) = normLM F hLE (1 + y₀) - (1 + traceLM F hLE y₀)
          rw [hy₀_tr]
          dsimp [x₀]
          ring
        have hδ₀_val : δ₀ = 0 ∨ (a : ℤ) ≤ valL F L δ₀ := by
          rw [hδ₀_eq]
          rcases hNormRem_LE y₀ (Or.inr (by omega)) with h0 | hrem
          · exact Or.inl h0
          · right
            have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
            have h2y₀ : (ℓ : ℤ) * (a : ℤ) ≤ 2 * valL F E y₀ := by nlinarith
            have hle_mul : (ℓ : ℤ) * (a : ℤ) ≤ (ℓ : ℤ) * valL F L (normLM F hLE (1 + y₀) - (1 + traceLM F hLE y₀)) :=
              le_trans h2y₀ hrem
            nlinarith
        let h_u : Lˣ := v₀ * u₀⁻¹
        have hh_u_sub : (h_u : L) - 1 = δ₀ * ((u₀⁻¹ : Lˣ) : L) := by
          dsimp [h_u, δ₀]
          rw [sub_mul, Units.mul_inv]
        have hu₀_inv_val0 : valL F L ((u₀⁻¹ : Lˣ) : L) = 0 := by
          rw [hval_inv_L u₀, hunit_val0_L (a - 1) u₀ hu₀_mem, neg_zero]
        have hh_u_mem : h_u ∈ unitGroup F L a := by
          rw [hunit_ge1_L a ha_pos h_u]
          rcases hδ₀_val with hδ0 | hδge
          · left
            rw [← sub_eq_zero, hh_u_sub, hδ0, zero_mul]
          · by_cases hδ0 : δ₀ = 0
            · left
              rw [← sub_eq_zero, hh_u_sub, hδ0, zero_mul]
            · right
              rw [hh_u_sub, hval_mul_L δ₀ ((u₀⁻¹ : Lˣ) : L) hδ0 (Units.ne_zero _),
                hu₀_inv_val0, add_zero]
              exact hδge
        have hχ'_hu : χ' h_u = 1 := hχ'_triv_a h_u hh_u_mem
        have hv₀_eq : v₀ = h_u * u₀ := by
          dsimp [h_u]
          exact (inv_mul_cancel_right v₀ u₀).symm
        have hχ'E_w₀ : χ'E w₀ ≠ 1 := by
          change χ' v₀ ≠ 1
          rw [hv₀_eq, map_mul, hχ'_hu, one_mul]
          exact hu₀_ne1
        by_contra hlt
        have hle_sub1 : condExp F E χ'E ≤ A - 1 := by omega
        have hw₀_cond : w₀ ∈ unitGroup F E (condExp F E χ'E) :=
          hunit_anti_E hle_sub1 hw₀_mem
        exact hχ'E_w₀ (hχ'E_cond w₀ hw₀_cond)
    exact le_antisymm haE_le_A hA_le_aE

  
  have hT0 : condExp F L χ' = 0 →
      tateEps F E χ'E ψE * tateEps F L 1 ψ * (∏ i : Fin r, tateEps F M_C (ν_orb i) ψMC) =
      tateEps F E 1 ψE * tateEps F L χ' ψ *
        (∏ i : Fin r, tateEps F M_C (ν_orb i * χ'MC) ψMC) := by
    intro ha0
    have hχ'_triv0 : ∀ u ∈ unitGroup F L 0, χ' u = 1 := by
      intro u hu
      have h := hχ'_cond u
      change u ∈ unitGroup F L (condExp F L χ') → χ' u = 1 at h
      rw [ha0] at h
      exact h hu
    have hχ'MC_triv0 : ∀ w ∈ unitGroup F M_C 0, χ'MC w = 1 := by
      intro w hw
      have hw_val : valL F M_C (w : M_C) = 0 := (hunit0_MC w).mp hw
      have hnorm_val : valL F L (((Units.map (normLM F hLM_C) w : Lˣ) : L)) = 0 := by
        change valL F L (normLM F hLM_C (w : M_C)) = 0
        rw [hValNorm_LMC (w : M_C), hw_val, mul_zero]
      exact hχ'_triv0 (Units.map (normLM F hLM_C) w) ((hunit0_L _).mpr hnorm_val)
    have hcond_1L : condExp F L 1 = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    have hcond_1E : condExp F E 1 = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    have hcond_χ'E0 : condExp F E χ'E = 0 := by
      apply Nat.eq_zero_of_le_zero
      apply Nat.sInf_le
      intro w hw
      have hw_val : valL F E (w : E) = 0 := (hunit0_E w).mp hw
      have hnorm_val : valL F L (((Units.map (normLM F hLE) w : Lˣ) : L)) = 0 := by
        change valL F L (normLM F hLE (w : E)) = 0
        rw [← hValNorm_LE (w : E), hw_val]
      exact hχ'_triv0 (Units.map (normLM F hLE) w) ((hunit0_L _).mpr hnorm_val)
    have hcond_twist_i : ∀ i : Fin r, condExp F M_C (ν_orb i * χ'MC) = 1 := by
      intro i
      have hle : condExp F M_C (ν_orb i * χ'MC) ≤ 1 := by
        apply Nat.sInf_le
        intro u hu
        have hu0 : u ∈ unitGroup F M_C 0 := hunit_anti_MC (Nat.zero_le 1) hu
        rw [MonoidHom.mul_apply, (hν_cond1 i).2 u hu, hχ'MC_triv0 u hu0, mul_one]
      have hne0 : condExp F M_C (ν_orb i * χ'MC) ≠ 0 := by
        intro h0
        have hνi_triv0 : ∀ u ∈ unitGroup F M_C 0, (ν_orb i) u = 1 := by
          intro u hu
          have h1_eq : (ν_orb i) ^ 1 * χ'MC = ν_orb i * χ'MC := by rw [pow_one]
          have h := (hν_props i).2.2.2.2 1 hℓ_gt1 u
          rw [h1_eq, h0] at h
          have h1 := h hu
          rw [MonoidHom.mul_apply, hχ'MC_triv0 u hu, mul_one] at h1
          exact h1
        have hνi_cond0 : condExp F M_C (ν_orb i) = 0 :=
          Nat.eq_zero_of_le_zero (Nat.sInf_le hνi_triv0)
        have hνi_cond1 : condExp F M_C (ν_orb i) = 1 := (hν_cond1 i).1
        omega
      omega
    let nMC := condExpChar F M_C ψMC
    have htateEps_MC_eq : ∀ (θ : M_Cˣ →* (Ω F)ˣ) (a : ℕ) (c : M_Cˣ),
        condExp F M_C θ = a → tateElt F M_C θ ψMC = c →
        tateEps F M_C θ ψMC =
          (qL F M_C : Ω F) ^ nMC *
            if a = 0 then (θ c : Ω F)
            else
              ∑ᶠ (u : M_Cˣ ⧸ unitGroup F M_C a) (_ : valL F M_C ((cosetRep u : M_Cˣ) : M_C) = 0),
                ((θ (c⁻¹ * (cosetRep u : M_Cˣ)) : Ω F)⁻¹ *
                  ψMC (((c⁻¹ * (cosetRep u : M_Cˣ) : M_Cˣ) : M_C))) := by
      intro θ a c ha hc
      subst ha
      subst hc
      rfl
    have hfin_sum_MC : ∀ (f : M_Cˣ ⧸ unitGroup F M_C 1 → Ω F),
        (∑ᶠ (u : M_Cˣ ⧸ unitGroup F M_C 1) (_ : valL F M_C ((cosetRep u : M_Cˣ) : M_C) = 0), f u) =
        ∑ u ∈ (hFinMC 1 le_rfl).toFinset, f u :=
      fun f => finsum_mem_eq_finite_toFinset_sum f (hFinMC 1 le_rfl)
    let c₀ : Lˣ := tateElt F L 1 ψ
    have hc₀_val : valL F L (c₀ : L) = n := by
      have h := (hSpecL 1).2.2.2
      rw [hcond_1L, Nat.cast_zero, zero_add] at h
      exact h
    have htate_L : tateEps F L χ' ψ = (χ' c₀ : Ω F) * tateEps F L 1 ψ := by
      have hc_χ' : tateElt F L χ' ψ = c₀ := by
        dsimp [c₀]
        unfold tateElt
        rw [ha0, hcond_1L]
      have h1 : tateEps F L χ' ψ = (qL F L : Ω F) ^ n * (χ' c₀ : Ω F) := by
        unfold tateEps
        rw [if_pos ha0, hc_χ']
      have h2 : tateEps F L 1 ψ = (qL F L : Ω F) ^ n * 1 := by
        unfold tateEps
        rw [if_pos hcond_1L, MonoidHom.one_apply, Units.val_one]
      rw [h1, h2]
      ring
    let cE : Eˣ := tateElt F E 1 ψE
    let vE : Lˣ := Units.map (normLM F hLE) cE
    have htate_E : tateEps F E χ'E ψE = (χ' vE : Ω F) * tateEps F E 1 ψE := by
      have hc_χ'E : tateElt F E χ'E ψE = cE := by
        dsimp [cE]
        unfold tateElt
        rw [hcond_χ'E0, hcond_1E]
      have h1 : tateEps F E χ'E ψE = (qL F E : Ω F) ^ nE * (χ'E cE : Ω F) := by
        unfold tateEps
        rw [if_pos hcond_χ'E0, hc_χ'E]
      have h2 : tateEps F E 1 ψE = (qL F E : Ω F) ^ nE * 1 := by
        unfold tateEps
        rw [if_pos hcond_1E, MonoidHom.one_apply, Units.val_one]
      change tateEps F E χ'E ψE = (χ'E cE : Ω F) * tateEps F E 1 ψE
      rw [h1, h2]
      ring
    have hvE_val : valL F L (vE : L) = (ℓ : ℤ) * (n + 1) - 1 := by
      change valL F L (normLM F hLE (cE : E)) = (ℓ : ℤ) * (n + 1) - 1
      rw [← hValNorm_LE (cE : E)]
      have h := (hSpecE 1).2.2.2
      rw [hcond_1E, Nat.cast_zero, zero_add] at h
      have h1 : valL F E (cE : E) = nE := h
      rw [h1, hcondChar_E]
    let i₀ : Fin r := ⟨0, hr_pos⟩
    let c₁ : M_Cˣ := tateElt F M_C (ν_orb i₀) ψMC
    let v₁ : Lˣ := Units.map (normLM F hLM_C) c₁
    have hc₁_val : valL F M_C (c₁ : M_C) = 1 + n := by
      have h := (hSpecMC (ν_orb i₀)).2.2.2
      rw [(hν_cond1 i₀).1, Nat.cast_one, hcondChar_MC] at h
      exact h
    have hv₁_val : valL F L (v₁ : L) = (f_H : ℤ) * (1 + n) := by
      change valL F L (normLM F hLM_C (c₁ : M_C)) = (f_H : ℤ) * (1 + n)
      rw [hValNorm_LMC (c₁ : M_C), hc₁_val]
    have htate_MC : ∀ i : Fin r,
        tateEps F M_C (ν_orb i * χ'MC) ψMC = (χ' v₁ : Ω F) * tateEps F M_C (ν_orb i) ψMC := by
      intro i
      have hcond_i : condExp F M_C (ν_orb i) = 1 := (hν_cond1 i).1
      have hcond_ti : condExp F M_C (ν_orb i * χ'MC) = 1 := hcond_twist_i i
      have hc_i : tateElt F M_C (ν_orb i) ψMC = c₁ := by
        dsimp [c₁]
        unfold tateElt
        rw [hcond_i, (hν_cond1 i₀).1]
      have hc_ti : tateElt F M_C (ν_orb i * χ'MC) ψMC = c₁ := by
        dsimp [c₁]
        unfold tateElt
        rw [hcond_ti, (hν_cond1 i₀).1]
      rw [htateEps_MC_eq (ν_orb i * χ'MC) 1 c₁ hcond_ti hc_ti,
        htateEps_MC_eq (ν_orb i) 1 c₁ hcond_i hc_i,
        if_neg Nat.one_ne_zero, if_neg Nat.one_ne_zero, hfin_sum_MC, hfin_sum_MC]
      have hsum_eq :
          ∑ u ∈ (hFinMC 1 le_rfl).toFinset,
            ((((ν_orb i * χ'MC) (c₁⁻¹ * cosetRep u) : (Ω F)ˣ) : Ω F)⁻¹ *
              ψMC (((c₁⁻¹ * cosetRep u : M_Cˣ) : M_C))) =
          (χ' v₁ : Ω F) *
            ∑ u ∈ (hFinMC 1 le_rfl).toFinset,
              ((((ν_orb i) (c₁⁻¹ * cosetRep u) : (Ω F)ˣ) : Ω F)⁻¹ *
                ψMC (((c₁⁻¹ * cosetRep u : M_Cˣ) : M_C))) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro u hu
        have hu_val : valL F M_C ((cosetRep u : M_Cˣ) : M_C) = 0 :=
          (Set.Finite.mem_toFinset (hFinMC 1 le_rfl)).mp hu
        have hu_mem0 : (cosetRep u : M_Cˣ) ∈ unitGroup F M_C 0 := (hunit0_MC _).mpr hu_val
        have hχ'MC_u : χ'MC (cosetRep u) = 1 := hχ'MC_triv0 _ hu_mem0
        have hterm : ((ν_orb i * χ'MC) (c₁⁻¹ * cosetRep u)) =
            (χ' v₁)⁻¹ * ((ν_orb i) (c₁⁻¹ * cosetRep u)) := by
          rw [MonoidHom.mul_apply, map_mul χ'MC, hχ'MC_u, mul_one, map_inv, mul_comm]
          rfl
        rw [hterm, Units.val_mul, mul_inv, Units.val_inv_eq_inv_val, inv_inv]
        ring
      rw [hsum_eq]
      ring
    have hprod_MC :
        (∏ i : Fin r, tateEps F M_C (ν_orb i * χ'MC) ψMC) =
        ((χ' (v₁ ^ r) : Ω F)) * (∏ i : Fin r, tateEps F M_C (ν_orb i) ψMC) := by
      have hcongr :
          (∏ i : Fin r, tateEps F M_C (ν_orb i * χ'MC) ψMC) =
          (∏ i : Fin r, ((χ' v₁ : Ω F) * tateEps F M_C (ν_orb i) ψMC)) :=
        Finset.prod_congr rfl (fun i _ => htate_MC i)
      rw [hcongr, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
        map_pow, Units.val_pow_eq_pow_val]
    have hr_mul_int : (r : ℤ) * (f_H : ℤ) = (ℓ : ℤ) - 1 := by
      have h1 : ((r * f_H : ℕ) : ℤ) = ((ℓ - 1 : ℕ) : ℤ) := by rw [hr_mul]
      omega
    have hc01_val : valL F L (((c₀ * v₁ ^ r : Lˣ) : L)) = (ℓ : ℤ) * (n + 1) - 1 := by
      rw [Units.val_mul, hval_mul_L (c₀ : L) _ (Units.ne_zero _) (Units.ne_zero _),
        hval_pow_L v₁ r, hc₀_val, hv₁_val, ← mul_assoc, hr_mul_int]
      ring
    let u_ratio : Lˣ := vE * (c₀ * v₁ ^ r)⁻¹
    have hu_ratio_val : valL F L (u_ratio : L) = 0 := by
      change valL F L (((vE * (c₀ * v₁ ^ r)⁻¹ : Lˣ) : L)) = 0
      rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_inv_L (c₀ * v₁ ^ r), hvE_val, hc01_val, add_neg_cancel]
    have hχ'_ratio : χ' u_ratio = 1 := hχ'_triv0 u_ratio ((hunit0_L u_ratio).mpr hu_ratio_val)
    have hχ'_vE : χ' vE = χ' c₀ * χ' (v₁ ^ r) := by
      have heq : vE = u_ratio * (c₀ * v₁ ^ r) := by
        dsimp [u_ratio]
        exact (inv_mul_cancel_right _ _).symm
      rw [heq, map_mul, hχ'_ratio, one_mul, map_mul]
    rw [htate_E, htate_L, hprod_MC, hχ'_vE, Units.val_mul]
    ring

  exact ⟨hcondChar_MC, hcond_MC, hcond_νχ_MC, hcondChar_E, hcond_E, hT0⟩

theorem ld_ch13_tame_diamond_ramification_and_conductors (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K)
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hAbLMC : IsAbelianExt F hLM_C)
    (hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE))
    (hCentralizer : ∀ σ ∈ L.fixingSubgroup,
      (∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) →
      σ ∈ M_C.fixingSubgroup)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_tame : ¬ (p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hr_mul : r * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (hcard_Hf : ((Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
      (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1)).card =
      Module.finrank L (IntermediateField.extendScalars hLM_C))
    (χ' : Lˣ →* (Ω F)ˣ) (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1)
    (hχ'MC_cond : ∀ u ∈ unitGroup F M_C (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C)))),
      (χ'.comp (Units.map (normLM F hLM_C))) u = 1)
    (hν_props : ∀ i : Fin r,
      (ν_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      ν_orb i ≠ 1 ∧
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)), ((ν_orb i) ^ k) u = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
          ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1))
    (hν_orb_sum : ∀ (ν₀ : M_Cˣ →* (Ω F)ˣ),
      ν₀ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 → ν₀ ≠ 1 →
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1) →
      ∀ z : M_Cˣ,
        1 + (∑ i : Fin r,
          ∑ c ∈ (Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
            (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
              (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1),
            (((ν_orb i) ^ c) z : Ω F)) =
          ∑ j ∈ Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK)),
            ((ν₀ ^ j) z : Ω F)) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    (∀ i : Fin r,
      condExp F M_C (ν_orb i) = 1 ∧
      (∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1)) ∧
    (∃ ϖ_L : Lˣ,
      valL F L (ϖ_L : L) = 1 ∧
      ∀ i : Fin r, (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom ϖ_L) = 1) ∧
    (∃ z₀ : M_Cˣ,
      valL F M_C (z₀ : M_C) = 0 ∧
      z₀ ^ ℓ ∈ unitGroup F M_C 1 ∧
      z₀ ∉ unitGroup F M_C 1 ∧
      ∀ σ ∈ L.fixingSubgroup, σ ∉ M_C.fixingSubgroup →
        ∀ hσz : (σ : AbsGal F) (z₀ : AlgebraicClosure F) ∈ M_C,
          (⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - (z₀ : M_C) ≠ 0 ∧
          valL F M_C ((⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - (z₀ : M_C)) = 0) ∧
    resDeg F M_C = f_H * resDeg F L ∧
    qL F M_C = (qL F L) ^ f_H ∧
    (∀ z : M_C, valL F L (normLM F hLM_C z) = (f_H : ℤ) * valL F M_C z) ∧
    (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x) ∧
    (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z))) ∧
    (∀ (d : ℕ), 1 ≤ d → ∀ z : M_C, (z = 0 ∨ (d : ℤ) ≤ valL F M_C z) →
      (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)))) ∧
    condExpChar F M_C (traceChar F hLM_C ψ) = condExpChar F L ψ ∧
    condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ' ∧
    (2 ≤ condExp F L χ' →
      ∀ i : Fin r, condExp F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ') ∧
    resDeg F E = resDeg F L ∧
    qL F E = qL F L ∧
    (∀ y : E, valL F E y = valL F L (normLM F hLE y)) ∧
    (∀ x : L, valL F E (IntermediateField.inclusion hLE x) = (ℓ : ℤ) * valL F L x) ∧
    (∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨ 1 ≤ valL F E (y - IntermediateField.inclusion hLE x))) ∧
    (∀ (m : ℤ) (y : E), (y = 0 ∨ (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ valL F E y) →
      (traceLM F hLE y = 0 ∨ m ≤ valL F L (traceLM F hLE y))) ∧
    (∀ y : E, (y = 0 ∨ 1 ≤ valL F E y) →
      normLM F hLE (1 + y) - (1 + traceLM F hLE y) = 0 ∨
        2 * valL F E y ≤ (ℓ : ℤ) * valL F L (normLM F hLE (1 + y) - (1 + traceLM F hLE y))) ∧
    condExpChar F E (traceChar F hLE ψ) = (ℓ : ℤ) * (condExpChar F L ψ + 1) - 1 ∧
    (1 ≤ condExp F L χ' →
      condExp F E (χ'.comp (Units.map (normLM F hLE))) = ℓ * (condExp F L χ' - 1) + 1) ∧
    (condExp F L χ' = 0 →
      tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
        tateEps F L 1 ψ *
        (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
      tateEps F E 1 (traceChar F hLE ψ) *
        tateEps F L χ' ψ *
        (∏ i : Fin r,
          tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
            (traceChar F hLM_C ψ))) :=
by
  haveI : CharP 𝓀[F] (p F) := ringChar.of_eq rfl
  haveI : Finite 𝓀[F] :=
    IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  have hp_ne : p F ≠ 0 := CharP.char_ne_zero_of_finite 𝓀[F] (p F)
  haveI : NeZero (p F) := ⟨hp_ne⟩
  have hp : Nat.Prime (p F) := (CharP.char_is_prime_of_pos 𝓀[F] (p F)).1
  have hNeP : Module.finrank M_C (IntermediateField.extendScalars hM_CK) ≠ p F := by
    intro hEq
    apply h_tame
    rw [hEq]
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalMC_props := ld_valL_and_unitGroup_props F M_C
  have hvalE_props := ld_valL_and_unitGroup_props F E
  have hvalK_props := ld_valL_and_unitGroup_props F K
  obtain ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv, hvalMC_surj, hvalMC_add, _⟩ :=
    ld_valL_and_unitGroup_props F M_C
  obtain ⟨hvalE0, hvalE1, hvalE_neg1, hvalE_neg, hvalE_mul, hvalE_inv, hvalE_surj, hvalE_add, _⟩ :=
    ld_valL_and_unitGroup_props F E
  obtain ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add, _⟩ :=
    ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halgL0, halgL1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨_, _, _, _, halgMC0, halgMC1, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F M_C
  obtain ⟨_, _, _, _, halgK0, halgK1, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F K
  have hp_valMC : ((p F : ℕ) : M_C) = 0 ∨ 1 ≤ valL F M_C ((p F : ℕ) : M_C) := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] (p F : 𝒪[F]) = 0 := by
      rw [map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (p F)
    have hker : valuation F ((p F : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    have hpF : (p F : F) = 0 ∨ 1 ≤ addVal F (p F : F) := by
      by_cases hp0 : (p F : F) = 0
      · exact Or.inl hp0
      · right
        have hφp : φ (valuation F (p F : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
