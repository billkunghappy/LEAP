      exact hPrime
    have hξM₁_ker : ∀ z : M₁ˣ, z ∈ Set.range (Units.map (normLM F hM₁K₁)) ↔ ξM₁ z = 1 :=
      (hξM₁_pack 0 hPrime.pos).1
    have hξM₁_cond : ∀ j < Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁),
        ∀ u ∈ unitGroup F M₁ (condExp F M₁ (ξM₁ ^ j)), (ξM₁ ^ j) u = 1 := by
      intro j hj
      rw [hdegM₁K₁] at hj
      exact (hξM₁_pack j hj).2.1
    have hχM₁'_cond : ∀ j < Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁),
        ∀ u ∈ unitGroup F M₁ (condExp F M₁ (ξM₁ ^ j * χM₁')), (ξM₁ ^ j * χM₁') u = 1 := by
      intro j hj
      rw [hdegM₁K₁] at hj
      exact (hξM₁_pack j hj).2.2.1
    have hχM₁'K₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (χM₁'.comp (Units.map (normLM F hM₁K₁)))),
        (χM₁'.comp (Units.map (normLM F hM₁K₁))) u = 1 := by
      rw [hχM₁'_norm]
      exact hχK₁'_cond
    have hEq2₀ := ld_ch12_unshifted_cyclic_fml F M₁ K₁ hM₁K₁ hGalM₁K₁ hAbM₁K₁ hPrime_M₁K₁ ψM₁ hψM₁
      ξM₁ χM₁' (hdegM₁K₁.symm ▸ hξM₁_pow) hξM₁_ne hξM₁_ker hξM₁_cond hχM₁'_cond hχM₁'K₁_cond
    have hEq2_prod : (∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k * χM₁') ψM₁) =
        (tateEps F M₁ χM₁' ψM₁) ^ ℓ := by
      calc (∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k * χM₁') ψM₁)
        _ = ∏ _k ∈ Finset.range ℓ, tateEps F M₁ χM₁' ψM₁ :=
            Finset.prod_congr rfl fun k hk => (hξM₁_pack k (Finset.mem_range.mp hk)).2.2.2.2
        _ = (tateEps F M₁ χM₁' ψM₁) ^ ℓ := by
            rw [Finset.prod_const, Finset.card_range]
    have hEq2 : tateEps F K₁ χK₁' ψK₁ * (∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k) ψM₁) =
        tateEps F K₁ 1 ψK₁ * (tateEps F M₁ χM₁' ψM₁) ^ ℓ := by
      have h := hEq2₀
      dsimp only at h
      rw [hdegM₁K₁, hχM₁'_norm, htr_M₁K₁, hEq2_prod] at h
      exact h
    have hcomp_ξE : ∀ j : ℕ, (νM₁ ^ j).comp (Units.map (normLM F hLE)) = ξE ^ j := by
      intro j
      ext y
      rfl
    have hcomp_ξM₁ : ∀ k : ℕ, (νE ^ k).comp (Units.map (normLM F hLM₁)) = ξM₁ ^ k := by
      intro k
      ext z
      rfl
    have hEq3_term : ∀ j ∈ Finset.range ℓ,
        tateEps F E (ξE ^ j) ψE * (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ) =
          tateEps F E 1 ψE * (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) := by
      intro j hj
      have hj_lt : j < ℓ := Finset.mem_range.mp hj
      have h1 : ∀ k < ℓ,
          ∀ u ∈ unitGroup F L (condExp F L (νE ^ k * νM₁ ^ j)), (νE ^ k * νM₁ ^ j) u = 1 :=
        fun k hk => hνE_νM₁_cond k hk j hj_lt
      have h2 : ∀ u ∈ unitGroup F E (condExp F E ((νM₁ ^ j).comp (Units.map (normLM F hLE)))),
          ((νM₁ ^ j).comp (Units.map (normLM F hLE))) u = 1 := by
        rw [hcomp_ξE j]
        exact (hξE_pack j hj_lt).2.1
      have h := hFML_E (νM₁ ^ j) h1 h2
      rw [hcomp_ξE j] at h
      exact h
    have hEq3 : (∏ j ∈ Finset.range ℓ, tateEps F E (ξE ^ j) ψE) *
          (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ) ^ ℓ =
        (tateEps F E 1 ψE) ^ ℓ *
          (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) := by
      calc (∏ j ∈ Finset.range ℓ, tateEps F E (ξE ^ j) ψE) *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ) ^ ℓ
        _ = (∏ j ∈ Finset.range ℓ, tateEps F E (ξE ^ j) ψE) *
              (∏ _j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ) := by
            rw [Finset.prod_const, Finset.card_range]
        _ = ∏ j ∈ Finset.range ℓ,
              (tateEps F E (ξE ^ j) ψE * (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ)) :=
            (Finset.prod_mul_distrib).symm
        _ = ∏ j ∈ Finset.range ℓ,
              (tateEps F E 1 ψE * (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ)) :=
            Finset.prod_congr rfl hEq3_term
        _ = (∏ _j ∈ Finset.range ℓ, tateEps F E 1 ψE) *
              (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) :=
            Finset.prod_mul_distrib
        _ = (tateEps F E 1 ψE) ^ ℓ *
              (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) := by
            rw [Finset.prod_const, Finset.card_range]
    have hEq4_term : ∀ k ∈ Finset.range ℓ,
        tateEps F M₁ (ξM₁ ^ k) ψM₁ * (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) =
          tateEps F M₁ 1 ψM₁ * (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) := by
      intro k hk
      have hk_lt : k < ℓ := Finset.mem_range.mp hk
      have h1 : ∀ j < ℓ,
          ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j * νE ^ k)), (νM₁ ^ j * νE ^ k) u = 1 :=
        fun j hj => hνM₁_νE_cond j hj k hk_lt
      have h2 : ∀ u ∈ unitGroup F M₁ (condExp F M₁ ((νE ^ k).comp (Units.map (normLM F hLM₁)))),
          ((νE ^ k).comp (Units.map (normLM F hLM₁))) u = 1 := by
        rw [hcomp_ξM₁ k]
        exact (hξM₁_pack k hk_lt).2.1
      have h := hFML_M₁ (νE ^ k) h1 h2
      rw [hcomp_ξM₁ k] at h
      have hcomm : (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j * νE ^ k) ψ) =
          ∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ :=
        Finset.prod_congr rfl fun j _ => by rw [mul_comm (νM₁ ^ j) (νE ^ k)]
      rw [hcomm] at h
      exact h
    have hEq4 : (∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k) ψM₁) *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) ^ ℓ =
        (tateEps F M₁ 1 ψM₁) ^ ℓ *
          (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) := by
      calc (∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k) ψM₁) *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) ^ ℓ
        _ = (∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k) ψM₁) *
              (∏ _k ∈ Finset.range ℓ, ∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) := by
            rw [Finset.prod_const, Finset.card_range]
        _ = ∏ k ∈ Finset.range ℓ,
              (tateEps F M₁ (ξM₁ ^ k) ψM₁ * (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ)) :=
            (Finset.prod_mul_distrib).symm
        _ = ∏ k ∈ Finset.range ℓ,
              (tateEps F M₁ 1 ψM₁ * (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ)) :=
            Finset.prod_congr rfl hEq4_term
        _ = (∏ _k ∈ Finset.range ℓ, tateEps F M₁ 1 ψM₁) *
              (∏ k ∈ Finset.range ℓ, ∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) :=
            Finset.prod_mul_distrib
        _ = (tateEps F M₁ 1 ψM₁) ^ ℓ *
              (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ) := by
            rw [Finset.prod_const, Finset.card_range, Finset.prod_comm]
    set P₂ := ∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k * νM₁ ^ j) ψ
    have hCancelK₁ : tateEps F K₁ 1 ψK₁ ≠ 0 := ld_tateEps_ne_zero F K₁ ψK₁ hψK₁ 1
    apply mul_left_cancel₀ hCancelK₁
    calc tateEps F K₁ 1 ψK₁ *
          (tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ)) ^ ℓ
      _ = (tateEps F K₁ 1 ψK₁ * (tateEps F E χE' ψE) ^ ℓ) *
            (tateEps F M₁ 1 ψM₁) ^ ℓ *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ) ^ ℓ := by ring
      _ = (tateEps F K₁ χK₁' ψK₁ * (∏ j ∈ Finset.range ℓ, tateEps F E (ξE ^ j) ψE)) *
            (tateEps F M₁ 1 ψM₁) ^ ℓ *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ) ^ ℓ := by rw [← hEq1]
      _ = tateEps F K₁ χK₁' ψK₁ *
            ((∏ j ∈ Finset.range ℓ, tateEps F E (ξE ^ j) ψE) *
              (∏ k ∈ Finset.range ℓ, tateEps F L (νE ^ k) ψ) ^ ℓ) *
            (tateEps F M₁ 1 ψM₁) ^ ℓ := by ring
      _ = tateEps F K₁ χK₁' ψK₁ * ((tateEps F E 1 ψE) ^ ℓ * P₂) *
            (tateEps F M₁ 1 ψM₁) ^ ℓ := by rw [hEq3]
      _ = tateEps F K₁ χK₁' ψK₁ * (tateEps F E 1 ψE) ^ ℓ *
            ((tateEps F M₁ 1 ψM₁) ^ ℓ * P₂) := by ring
      _ = tateEps F K₁ χK₁' ψK₁ * (tateEps F E 1 ψE) ^ ℓ *
            ((∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k) ψM₁) *
              (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) ^ ℓ) := by rw [← hEq4]
      _ = (tateEps F K₁ χK₁' ψK₁ * (∏ k ∈ Finset.range ℓ, tateEps F M₁ (ξM₁ ^ k) ψM₁)) *
            (tateEps F E 1 ψE) ^ ℓ *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) ^ ℓ := by ring
      _ = (tateEps F K₁ 1 ψK₁ * (tateEps F M₁ χM₁' ψM₁) ^ ℓ) *
            (tateEps F E 1 ψE) ^ ℓ *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) ^ ℓ := by rw [hEq2]
      _ = tateEps F K₁ 1 ψK₁ *
          (tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ)) ^ ℓ := by ring
  have hRed : tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ) =
      tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) →
      evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, E, hLE, χE⟩ =
        evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, M₁, hLM₁, χM₁⟩ := by
    intro h_sml
    apply Units.ext
    have hCancel : tateEps F E 1 ψE * tateEps F M₁ 1 ψM₁ ≠ 0 :=
      mul_ne_zero (ld_tateEps_ne_zero F E ψE hψE 1) (ld_tateEps_ne_zero F M₁ ψM₁ hψM₁ 1)
    apply mul_right_cancel₀ hCancel
    calc (evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, E, hLE, χE⟩ : Ω F) *
          (tateEps F E 1 ψE * tateEps F M₁ 1 ψM₁)
      _ = ((evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, E, hLE, χE⟩ : Ω F) *
            tateEps F E 1 ψE) * tateEps F M₁ 1 ψM₁ := by ring
      _ = (tateEps F E χE' ψE * (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ)) *
            tateEps F M₁ 1 ψM₁ := by rw [hf_elim_E]
      _ = tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ) := by ring
      _ = tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) := h_sml
      _ = (tateEps F M₁ χM₁' ψM₁ * (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ)) *
            tateEps F E 1 ψE := by ring
      _ = ((evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, M₁, hLM₁, χM₁⟩ : Ω F) *
            tateEps F M₁ 1 ψM₁) * tateEps F E 1 ψE := by rw [← hf_elim_M₁]
      _ = (evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, M₁, hLM₁, χM₁⟩ : Ω F) *
          (tateEps F E 1 ψE * tateEps F M₁ 1 ψM₁) := by ring
  exact ⟨hFinL, hFinE, hFinM₁, hFinK₁, hAbLE, hAbLM₁, hAbEK₁, hAbM₁K₁,
    hψE, hψM₁, hψK₁, ⟨νE, νM₁, hνE_pow, hνE_ne, hνE_ker, hνE_cond,
    hνM₁_pow, hνM₁_ne, hνM₁_ker, hνM₁_cond, hNormFact, hχE'_norm, hχM₁'_norm,
    hχK₁'_cond, hcond_χE'_pos, hξE_pack, hcond_χM₁'_pos, hξM₁_pack,
    hCommonRest, hFML_E, hFML_M₁, hThirdSubfield, hLHS_ne0, hRHS_ne0, hPow, hRed⟩⟩

theorem ld_ch12_tame_branch_weil_lift_and_unram_unit_conj (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E] [FiniteDimensional F K₁]
    (hLE : L ≤ E) (hEK₁ : E ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalEK₁ : IsGaloisExt F E K₁)
    (hAbLE : IsAbelianExt F hLE) (hAbEK₁ : IsAbelianExt F hEK₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hAutInv : ∀ (g : relWeil F L),
      ∃ (σ_g : E ≃ₐ[F] E) (χE_g : relWeil F E →* (Ω F)ˣ),
        (∀ y : E, (σ_g y : AlgebraicClosure F) = (g : AbsGal F) (y : AlgebraicClosure F)) ∧
        (∀ x : L, σ_g (IntermediateField.inclusion hLE x) = IntermediateField.inclusion hLE x) ∧
        (∀ (w : relWeil F E)
          (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F E),
          χE_g w = χE ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩) ∧
        IsWeilRep F E (charRep F E χE_g) ∧
        (∀ y : Eˣ,
          (recChar F rec E χE_g) (Units.map σ_g.toRingEquiv.toMonoidHom y) =
            (recChar F rec E χE) y) ∧
        condExp F E (recChar F rec E χE_g) = condExp F E (recChar F rec E χE) ∧
        tateEps F E (recChar F rec E χE_g) (traceChar F hLE ψ) =
          tateEps F E (recChar F rec E χE) (traceChar F hLE ψ))
    (νE : Lˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    let χE' := recChar F rec E χE
    (∃ μE : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L μE) ∧
      (∀ w : relWeil F L, (w : AbsGal F) ∈ E.fixingSubgroup ↔ μE w = 1) ∧
      μE ^ ℓ = 1 ∧
      ∀ x : Lˣ, νE x = μE (rec.recMap L x)) ∧
    (condExp F L νE = 0 →
      ∀ (σ : E ≃ₐ[F] E),
        (∀ x : L, σ (IntermediateField.inclusion hLE x) = IntermediateField.inclusion hLE x) →
        σ ≠ 1 →
        ∃ y₀ ∈ unitGroup F E 0,
          χE' (Units.map σ.toRingEquiv.toMonoidHom y₀) ≠ χE' y₀) :=
by
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
  set χE' := recChar F rec E χE
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  haveI : Module.Finite L (IntermediateField.extendScalars hLE) :=
    Module.finite_of_finrank_pos hPrime.pos
  
  have hrec_ker : ∀ x : Lˣ, (rec.recMap L x : AbsGal F) ∈ E.fixingSubgroup ↔ νE x = 1 := by
    intro x
    rw [rec.ker_rec L E hLE hAbLE x, ← hνE_ker x]
    refine ⟨?_, ?_⟩
    · rintro ⟨y, hy⟩
      have hy_ne : y ≠ 0 := by
        intro h0
        have hnorm0 : normLM F hLE y = 0 := by
          rw [h0]
          exact Algebra.norm_zero (R := L) (S := IntermediateField.extendScalars hLE)
        rw [hnorm0] at hy
        exact Units.ne_zero x hy.symm
      exact ⟨Units.mk0 y hy_ne, Units.ext hy⟩
    · rintro ⟨y, rfl⟩
      exact ⟨(y : E), rfl⟩
  choose xw hxw using rec.surj_rec L E hLE hAbLE
  have h_indep : ∀ (w : relWeil F L) (x : Lˣ),
      (((rec.recMap L x)⁻¹ * w : relWeil F L) : AbsGal F) ∈ E.fixingSubgroup →
      νE (xw w) = νE x := by
    intro w x hx
    set x₁ := xw w
    set x₂ := x
    have h1 : (((rec.recMap L x₁ : AbsGal F)⁻¹ * (w : AbsGal F)) *
        ((rec.recMap L x₂ : AbsGal F)⁻¹ * (w : AbsGal F))⁻¹) ∈ E.fixingSubgroup :=
      E.fixingSubgroup.mul_mem (hxw w) (E.fixingSubgroup.inv_mem hx)
    have h2 : ((rec.recMap L x₂ : AbsGal F)⁻¹ *
        ((rec.recMap L x₁ : AbsGal F) * (rec.recMap L (x₁⁻¹ * x₂) : AbsGal F))) ∈
        E.fixingSubgroup := by
      have hmul := rec.mul_rec L E hLE hAbLE x₁ (x₁⁻¹ * x₂)
      rw [mul_inv_cancel_left] at hmul
      exact hmul
    have h3 : (rec.recMap L (x₁⁻¹ * x₂) : AbsGal F) ∈ E.fixingSubgroup := by
      have hprod := E.fixingSubgroup.mul_mem h1 h2
