        have h_eq := congr_arg Units.val (hg c hc)
        rwa [hψ_on_C ⟨g⁻¹ * c.1 * g, hc⟩, hψ_on_C c] at h_eq
    exact ⟨lam, M_lam, hC_le, ψ_lam, w_bar,
      h_nontriv, h_m_eq_c, h_H_triv, h_stab_psi, hM_lam, hw_bar_ne, hw_bar_C, hw_bar_M⟩
  
  have h_orbit_sub :
      ∀ {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q]
        (σ : Representation (Ω F) G Q)
        (lam : C → Ω F) (M_lam : Subgroup G)
        (hM_lam : ∀ g : G, g ∈ M_lam ↔ ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C), lam ⟨g⁻¹ * c.1 * g, hc⟩ = lam c)
        (ψ_lam : M_lam →* (Ω F)ˣ) (w_bar : Q) (hw_ne : w_bar ≠ 0)
        (hw_C : ∀ c : C, σ c.1 w_bar = lam c • w_bar)
        (hw_M : ∀ k : M_lam, σ k.1 w_bar = (ψ_lam k : Ω F) • w_bar),
