      have h7 := hneg_K₁ _ _ h6
      rcases h7 with h0 | hle
      · exact Or.inl h0
      · right
        apply le_trans _ hle
        rw [← sub_nonneg]
        have hid :
            v_wt + (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + 0 +
                - 3 * (p : ℤ) * (p : ℤ) * (m : ℤ) +
                - ((p - 1 : ℕ) : ℤ) * (p : ℤ) * (p : ℤ) * (m : ℤ) +
