    have hψ_es : ψ (((c_τ⁻¹ : Lˣ) : L) * e_s) = 1 := by
      apply hψ_triv
      by_cases he0 : e_s = 0
      · exact Or.inl (by rw [he0, mul_zero])
      · rcases he_s_val with he0' | he_ge
        · exact absurd he0' he0
        · right
          rw [hval_mul_L _ _ (Units.ne_zero _) he0, hval_inv_L c_τ, hc_τ_val, hb_eq]
          omega
    have hdecomp_xs : ((c_τ⁻¹ : Lˣ) : L) * x_s =
        ((c₁⁻¹ : Lˣ) : L) * ((u_τ : L) * (T_t * s + s ^ p)) + ((c_τ⁻¹ : Lˣ) : L) * e_s := by
      rw [hx_s_def, mul_add, ← mul_assoc, ← hc₁_u_τ, mul_assoc]
    rw [hdecomp_xs, AddChar.map_add_eq_mul, hψ_es, mul_one] at hψ_xs
    exact hψ_xs

  
  obtain ⟨r, hr_int, hr_frob⟩ := hfrob_surj (u_τ : L) hu_τ_int
  set r₀ : k_L := resL r
  have hr₀_pow : r₀ ^ p = a_τ := by
    have hres_eq := (hresL_eq_iff (u_τ : L) (r ^ p) hu_τ_int (hvalL_pow_int r p hr_int).1).mpr hr_frob
    rw [(hvalL_pow_int r p hr_int).2] at hres_eq
    exact hres_eq.symm
  have hr₀_ne : r₀ ≠ 0 := by
    intro h0
    apply ha_τ_ne
    rw [← hr₀_pow, h0, zero_pow hp_ne_zero]
  set b₀ : k_L := - (r₀ ^ (p - 1) * μ) with hb₀_def
  have hb₀_ne : b₀ ≠ 0 :=
    neg_ne_zero.mpr (mul_ne_zero (pow_ne_zero _ hr₀_ne) hμ_ne)
  have hb₀_pow : b₀ ^ p = - (a_τ ^ (p - 1) * μ ^ p) := by
    calc b₀ ^ p
      _ = (-1 : k_L) ^ p * (r₀ ^ (p - 1) * μ) ^ p := by
          rw [hb₀_def, ← neg_one_mul, mul_pow]
      _ = - ((r₀ ^ p) ^ (p - 1) * μ ^ p) := by
          rw [hneg1_pow_p, mul_pow, ← pow_mul, mul_comm (p - 1) p, pow_mul, neg_one_mul]
      _ = - (a_τ ^ (p - 1) * μ ^ p) := by rw [hr₀_pow]
  obtain ⟨v, hv_int, hv_res⟩ := hresL_surj b₀⁻¹
  have hv_ne : v ≠ 0 := by
    intro h0
    apply inv_ne_zero hb₀_ne
    rw [← hv_res, h0, hresL_0]
  have hv_val : valL F L v = 0 := by
    rcases hv_int with rfl | hv_ge0
    · exact absurd rfl hv_ne
    · by_contra hv_ne0
      have hv_ge1 : 1 ≤ valL F L v := by omega
      have hres0 : resL v = 0 := (hresL_ker v (Or.inr hv_ge0)).mpr (Or.inr hv_ge1)
      rw [hv_res] at hres0
      exact inv_ne_zero hb₀_ne hres0
  set v₀ : Lˣ := Units.mk0 v hv_ne
  have hv₀_val : valL F L (v₀ : L) = 0 := hv_val
  have hv₀_int : (v₀ : L) = 0 ∨ 0 ≤ valL F L (v₀ : L) := Or.inr (by rw [hv₀_val])
  have hv₀_res : resL (v₀ : L) = b₀⁻¹ := hv_res
  have hv₀_inv_val : valL F L ((v₀⁻¹ : Lˣ) : L) = 0 := by
    rw [hval_inv_L v₀, hv₀_val, neg_zero]
  have hv₀_inv_int : ((v₀⁻¹ : Lˣ) : L) = 0 ∨ 0 ≤ valL F L ((v₀⁻¹ : Lˣ) : L) :=
    Or.inr (by rw [hv₀_inv_val])
  have hv₀_inv_res : resL ((v₀⁻¹ : Lˣ) : L) = b₀ := by
    have hmul : resL ((v₀⁻¹ : Lˣ) : L) * b₀⁻¹ = 1 := by
      rw [← hv₀_res, ← (hresL_ring _ _ hv₀_inv_int hv₀_int).2.1, ← Units.val_mul,
        inv_mul_cancel, Units.val_one, hresL_1]
    calc resL ((v₀⁻¹ : Lˣ) : L)
      _ = (resL ((v₀⁻¹ : Lˣ) : L) * b₀⁻¹) * b₀ := by
          rw [mul_assoc, inv_mul_cancel₀ hb₀_ne, mul_one]
      _ = b₀ := by rw [hmul, one_mul]
  set c_K : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom (c₁ * v₀) * δ₁ with hc_K_def
  have hc_K_val : valL F K (c_K : K) = 1 + condExpChar F K (traceChar F hLK ψ) := by
    rw [hc_K_def, Units.val_mul, hval_mul_K _ _ (Units.ne_zero _) (Units.ne_zero _)]
    change valL F K (IntermediateField.inclusion hLK ((c₁ * v₀ : Lˣ) : L)) + valL F K (δ₁ : K) = _
    rw [hval_alg, Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
      hc₁_val, hv₀_val, add_zero, hδ₁_val, hnK, hb_eq, hp1_cast]
    push_cast
    ring
  set W : Lˣ := u_τ ^ (p - 1) * v₀ ^ p * u_δ with hW_def
  have hW_eq : Units.map (normLM F hLK) c_K * (c₁ * c_τ ^ (p - 1))⁻¹ = W := by
    apply Units.ext
    rw [hc_K_def, hW_def, hu_τ_def, hu_δ_def, map_mul, hnorm_inc_unit (c₁ * v₀),
      mul_pow, mul_pow, mul_pow, ← pow_mul, mul_comm t (p - 1)]
    have hc₁_p : c₁ ^ p = c₁ ^ (p - 1) * c₁ := by
      conv_lhs => rw [← Nat.sub_add_cancel hp_pos]
      rw [pow_add, pow_one]
    rw [hc₁_p, mul_inv_rev]
    simp only [Units.val_mul]
    have h_c₁ : (c₁ : L) * ((c₁⁻¹ : Lˣ) : L) = 1 := Units.mul_inv c₁
    have h_ϖ : ((ϖ_L ^ ((p - 1) * t) : Lˣ) : L) * (((ϖ_L ^ ((p - 1) * t))⁻¹ : Lˣ) : L) = 1 :=
      Units.mul_inv (ϖ_L ^ ((p - 1) * t))
    calc ((c₁ ^ (p - 1) : Lˣ) : L) * (c₁ : L) * ((v₀ ^ p : Lˣ) : L) *
          ((Units.map (normLM F hLK) δ₁ : Lˣ) : L) *
          ((((c_τ ^ (p - 1))⁻¹ : Lˣ) : L) * ((c₁⁻¹ : Lˣ) : L))
      _ = ((c₁ ^ (p - 1) : Lˣ) : L) * ((c₁ : L) * ((c₁⁻¹ : Lˣ) : L)) *
          (((c_τ ^ (p - 1))⁻¹ : Lˣ) : L) * ((v₀ ^ p : Lˣ) : L) *
          ((Units.map (normLM F hLK) δ₁ : Lˣ) : L) * 1 := by ring
      _ = ((c₁ ^ (p - 1) : Lˣ) : L) * 1 *
          (((c_τ ^ (p - 1))⁻¹ : Lˣ) : L) * ((v₀ ^ p : Lˣ) : L) *
          ((Units.map (normLM F hLK) δ₁ : Lˣ) : L) *
          (((ϖ_L ^ ((p - 1) * t) : Lˣ) : L) * (((ϖ_L ^ ((p - 1) * t))⁻¹ : Lˣ) : L)) := by
          rw [h_c₁, h_ϖ]
      _ = ((c₁ ^ (p - 1) : Lˣ) : L) * ((ϖ_L ^ ((p - 1) * t) : Lˣ) : L) *
          (((c_τ⁻¹ ^ (p - 1) : Lˣ) : L)) * ((v₀ ^ p : Lˣ) : L) *
          (((Units.map (normLM F hLK) δ₁ : Lˣ) : L) * (((ϖ_L ^ ((p - 1) * t))⁻¹ : Lˣ) : L)) := by
          rw [inv_pow]
          ring
  set U_norm : Lˣ := Units.map (normLM F hLK) c_K * (c₁ * ((-1 : Lˣ) * c_τ ^ (p - 1)))⁻¹ with hU_norm_def
  have hU_norm_eq : U_norm = W * (-1 : Lˣ)⁻¹ := by
    apply Units.ext
    rw [← hW_eq, hU_norm_def, mul_inv_rev, mul_inv_rev, mul_inv_rev]
    simp only [Units.val_mul]
    ring
  have hW_val : valL F L (W : L) = 0 := by
    rw [hW_def, Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
      Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalL_unit_pow u_τ (p - 1), hu_τ_val, mul_zero,
      hvalL_unit_pow v₀ p, hv₀_val, mul_zero, hu_δ_val, add_zero, add_zero]
  have hW_int : (W : L) = 0 ∨ 0 ≤ valL F L (W : L) := Or.inr (by rw [hW_val])
  have hW_res : resL (W : L) = -1 := by
    have h1_int : ((u_τ ^ (p - 1) : Lˣ) : L) = 0 ∨ 0 ≤ valL F L ((u_τ ^ (p - 1) : Lˣ) : L) := by
      rw [Units.val_pow_eq_pow_val]
      exact (hvalL_pow_int (u_τ : L) (p - 1) hu_τ_int).1
    have h2_int : ((v₀ ^ p : Lˣ) : L) = 0 ∨ 0 ≤ valL F L ((v₀ ^ p : Lˣ) : L) := by
      rw [Units.val_pow_eq_pow_val]
      exact (hvalL_pow_int (v₀ : L) p hv₀_int).1
    have h12_int : ((u_τ ^ (p - 1) * v₀ ^ p : Lˣ) : L) = 0 ∨
        0 ≤ valL F L ((u_τ ^ (p - 1) * v₀ ^ p : Lˣ) : L) := by
      rw [Units.val_mul]
      exact hvalL_mul_int _ _ h1_int h2_int
    rw [hW_def, Units.val_mul, (hresL_ring _ _ h12_int hu_δ_int).2.1,
      Units.val_mul, (hresL_ring _ _ h1_int h2_int).2.1,
      Units.val_pow_eq_pow_val, (hvalL_pow_int (u_τ : L) (p - 1) hu_τ_int).2,
      Units.val_pow_eq_pow_val, (hvalL_pow_int (v₀ : L) p hv₀_int).2,
      hv₀_res, hu_δ_res]
    have hb₀_pow_ne : b₀ ^ p ≠ 0 := pow_ne_zero p hb₀_ne
    calc a_τ ^ (p - 1) * (b₀⁻¹) ^ p * μ ^ p
      _ = (a_τ ^ (p - 1) * μ ^ p) * (b₀ ^ p)⁻¹ := by
          rw [inv_pow]
          ring
      _ = (- (b₀ ^ p)) * (b₀ ^ p)⁻¹ := by
          rw [hb₀_pow, neg_neg]
      _ = -1 := by
          rw [neg_mul, mul_inv_cancel₀ hb₀_pow_ne]
  have hc_K_norm : U_norm ∈ unitGroup F L 1 := by
    rw [hunit_ge1_L 1 le_rfl U_norm]
    have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hval1_L])
    have hneg1_int : (-1 : L) = 0 ∨ 0 ≤ valL F L (-1 : L) := Or.inr (by rw [hval_neg1_L])
    have hres_neg1 : resL (-1 : L) = -1 := by
      rw [(hresL_ring 1 1 h1_int h1_int).2.2, hresL_1]
    have hW_sub : (W : L) - (-1 : L) = 0 ∨ 1 ≤ valL F L ((W : L) - (-1 : L)) :=
      (hresL_eq_iff (W : L) (-1 : L) hW_int hneg1_int).mp (hW_res.trans hres_neg1.symm)
    have hU_sub : (U_norm : L) - 1 = ((W : L) - (-1 : L)) * (((-1 : Lˣ)⁻¹ : Lˣ) : L) := by
      rw [hU_norm_eq, Units.val_mul]
      have h_inv_one : (-1 : L) * (((-1 : Lˣ)⁻¹ : Lˣ) : L) = 1 :=
        Units.mul_inv (-1 : Lˣ)
      calc (W : L) * (((-1 : Lˣ)⁻¹ : Lˣ) : L) - 1
        _ = (W : L) * (((-1 : Lˣ)⁻¹ : Lˣ) : L) - (-1 : L) * (((-1 : Lˣ)⁻¹ : Lˣ) : L) := by
            rw [h_inv_one]
        _ = ((W : L) - (-1 : L)) * (((-1 : Lˣ)⁻¹ : Lˣ) : L) := by ring
    by_cases h0 : (W : L) - (-1 : L) = 0
    · left
      rw [← sub_eq_zero, hU_sub, h0, zero_mul]
    · rcases hW_sub with h0' | hge1
      · exact absurd h0' h0
      · right
        rw [hU_sub, hval_mul_L _ _ h0 (Units.ne_zero _), hval_inv_L (-1 : Lˣ)]
        change (1 : ℤ) ≤ valL F L ((W : L) - (-1 : L)) + - valL F L (-1 : L)
        rw [hval_neg1_L]
        omega

  
  refine ⟨c_K, hc_K_val, hc_K_norm, ?_⟩
  intro y hy x hx hres_xy
  have hc_K_inv_y : ((c_K⁻¹ : Kˣ) : K) * y =
      IntermediateField.inclusion hLK (((c₁⁻¹ : Lˣ) : L) * ((v₀⁻¹ : Lˣ) : L)) * (y * y₁) := by
    have hc_K_inv : c_K⁻¹ =
        δ₁⁻¹ * Units.map (IntermediateField.inclusion hLK).toMonoidHom (c₁⁻¹ * v₀⁻¹) := by
      rw [hc_K_def, mul_inv_rev, ← map_inv, mul_inv_rev, mul_comm v₀⁻¹ c₁⁻¹]
    rw [hc_K_inv, Units.val_mul, hδ₁_inv_coe]
    change (y₁ * IntermediateField.inclusion hLK (((c₁⁻¹ * v₀⁻¹ : Lˣ) : L))) * y = _
    rw [Units.val_mul]
    ring
  set w_K : L := ((v₀⁻¹ : Lˣ) : L) * traceLM F hLK (y * y₁) with hw_K_def
  have hψK_eq : (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y) =
      ψ (((c₁⁻¹ : Lˣ) : L) * w_K) := by
    change ψ (traceLM F hLK (((c_K⁻¹ : Kˣ) : K) * y)) = _
    rw [hc_K_inv_y, htrace_smul, mul_assoc]
  have htr_yy₁ := htr_y₁_res y hy
  have hw_K_int : w_K = 0 ∨ 0 ≤ valL F L w_K :=
    hvalL_mul_int _ _ hv₀_inv_int htr_yy₁.1
  have hw_K_res : resL w_K = b₀ * resK y := by
    rw [hw_K_def, (hresL_ring _ _ hv₀_inv_int htr_yy₁.1).2.1, hv₀_inv_res, htr_yy₁.2]
  obtain ⟨s, hs_int, hs_res⟩ := hresL_surj (r₀⁻¹ * resK y)
  set w₁ : L := - ((u_τ : L) * (T_t * s)) with hw₁_def
  set w₂ : L := (u_τ : L) * s ^ p with hw₂_def
  have hw₁_pos_int : (u_τ : L) * (T_t * s) = 0 ∨ 0 ≤ valL F L ((u_τ : L) * (T_t * s)) :=
    hvalL_mul_int _ _ hu_τ_int (hvalL_mul_int T_t s hTt_int hs_int)
  have hw₁_int : w₁ = 0 ∨ 0 ≤ valL F L w₁ := hvalL_neg_int _ hw₁_pos_int
  have hw₂_int : w₂ = 0 ∨ 0 ≤ valL F L w₂ :=
    hvalL_mul_int _ _ hu_τ_int (hvalL_pow_int s p hs_int).1
  have hw₁_res : resL w₁ = resL w_K := by
    rw [hw₁_def, (hresL_ring _ _ hw₁_pos_int hw₁_pos_int).2.2,
      (hresL_ring _ _ hu_τ_int (hvalL_mul_int T_t s hTt_int hs_int)).2.1,
      (hresL_ring T_t s hTt_int hs_int).2.1, hTt_res, hs_res, hw_K_res]
    have hr₀_p : a_τ = r₀ ^ (p - 1) * r₀ := by
      rw [← hr₀_pow, ← pow_succ, Nat.sub_add_cancel hp_pos]
    rw [hb₀_def]
    calc - (a_τ * (μ * (r₀⁻¹ * resK y)))
      _ = - ((r₀ ^ (p - 1) * (r₀ * r₀⁻¹)) * μ * resK y) := by
          rw [hr₀_p]
          ring
      _ = - (r₀ ^ (p - 1) * μ) * resK y := by
          rw [mul_inv_cancel₀ hr₀_ne, mul_one]
          ring
  have hw₂_res : resL w₂ = resL x := by
    rw [hw₂_def, (hresL_ring _ _ hu_τ_int (hvalL_pow_int s p hs_int).1).2.1,
      (hvalL_pow_int s p hs_int).2, hs_res, mul_pow, inv_pow, hr₀_pow]
    change a_τ * (a_τ⁻¹ * resK y ^ p) = resL x
    rw [← mul_assoc, mul_inv_cancel₀ ha_τ_ne, one_mul, hres_xy]
  have hψ_wK_w₁ : ψ (((c₁⁻¹ : Lˣ) : L) * w_K) = ψ (((c₁⁻¹ : Lˣ) : L) * w₁) :=
    hψ_c₁_congr w_K w₁ hw_K_int hw₁_int hw₁_res.symm
  have hψ_w₂_x : ψ (((c₁⁻¹ : Lˣ) : L) * w₂) = ψ (((c₁⁻¹ : Lˣ) : L) * x) :=
    hψ_c₁_congr w₂ x hw₂_int hx hw₂_res
  have hw₁_w₂_sum : ((c₁⁻¹ : Lˣ) : L) * w₂ =
      ((c₁⁻¹ : Lˣ) : L) * ((u_τ : L) * (T_t * s + s ^ p)) + ((c₁⁻¹ : Lˣ) : L) * w₁ := by
    rw [hw₁_def, hw₂_def]
    ring
  have hψ_w₁_w₂ : ψ (((c₁⁻¹ : Lˣ) : L) * w₁) = ψ (((c₁⁻¹ : Lˣ) : L) * w₂) := by
    rw [hw₁_w₂_sum, AddChar.map_add_eq_mul, hstat_shift s hs_int, one_mul]
  rw [hψK_eq, hψ_wK_w₁, hψ_w₁_w₂, hψ_w₂_x]

theorem ld_wild_cond_one_gauss_frob_comparison (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hqK : qL F K = qL F L)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (ha1 : condExp F L χ' = 1)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (hFinL1 : Set.Finite {u : Lˣ ⧸ unitGroup F L (condExp F L χ') |
      valL F L ((cosetRep u : Lˣ) : L) = 0})
    (hFinK1 : Set.Finite {w : Kˣ ⧸ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))) |
      valL F K ((cosetRep w : Kˣ) : K) = 0})
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (resK : K → k_L)
    (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (hresK_surj : ∀ a : k_L, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = a)
    (hresK_norm : ∀ w : Kˣ, valL F K (w : K) = 0 →
      resL ((Units.map (normLM F hLK) w : Lˣ) : L) =
        (resK (w : K)) ^ (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hGauss : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)) (χ_M : Mˣ →* (Ω F)ˣ),
      condExp F M χ_M = 1 →
      valL F M ((tateElt F M χ_M ψ_M : Mˣ) : M) =
        (condExp F M χ_M : ℤ) + condExpChar F M ψ_M →
      Set.Finite {u : Mˣ ⧸ unitGroup F M (condExp F M χ_M) |
        valL F M ((cosetRep u : Mˣ) : M) = 0} →
      (valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
        (∀ x : M, valL F M (-x) = valL F M x) ∧
        (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
        (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
        (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
          u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
        (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0)) →
      ∀ (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M),
        resM 0 = 0 → resM 1 = 1 →
        (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
          resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
          resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
          resM (-x₁) = -resM x₁) →
        (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
          (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) →
        (∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a) →
        ∀ (c_M : Mˣ), valL F M (c_M : M) = 1 + condExpChar F M ψ_M →
        ∀ (χ_tilde ψ_tilde : k_M → Ω F),
          χ_tilde 0 = 0 →
          (∀ u : Mˣ, valL F M (u : M) = 0 → χ_tilde (resM (u : M)) = (χ_M u : Ω F)⁻¹) →
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            ψ_tilde (resM x) = ψ_M (((c_M⁻¹ : Mˣ) : M) * x)) →
          tateEps F M χ_M ψ_M =
            (qL F M : Ω F) ^ condExpChar F M ψ_M * (χ_M c_M : Ω F) *
              (∑ a : k_M, χ_tilde a * ψ_tilde a))
    (u_pref : Lˣ) (c_K : Kˣ)
    (hc_K_val : valL F K (c_K : K) = 1 + condExpChar F K (traceChar F hLK ψ))
    (hc_K_norm : Units.map (normLM F hLK) c_K * (tateElt F L χ' ψ * u_pref)⁻¹ ∈ unitGroup F L 1)
    (hc_K_psi : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resL x = (resK y) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) →
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y) =
          ψ ((((tateElt F L χ' ψ)⁻¹ : Lˣ) : L) * x)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      tateEps F L 1 ψ =
    tateEps F K 1 (traceChar F hLK ψ) *
      tateEps F L χ' ψ * (χ' u_pref : Ω F) :=
by
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    _, hunit_ge1_L, hunit_val0_L⟩ := hvalL_props
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, _, hval_add_K,
    _, hunit_ge1_K, hunit_val0_K⟩ := hvalK_props
  have htate_L1 : tateEps F L 1 ψ = (qL F L : Ω F) ^ condExpChar F L ψ := by
    have hcond_L1 : condExp F L (1 : Lˣ →* (Ω F)ˣ) = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    rw [tateEps, if_pos hcond_L1, MonoidHom.one_apply, Units.val_one, mul_one]
  have htate_K1 : tateEps F K 1 (traceChar F hLK ψ) =
      (qL F L : Ω F) ^ condExpChar F K (traceChar F hLK ψ) := by
    have hcond_K1 : condExp F K (1 : Kˣ →* (Ω F)ˣ) = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    rw [tateEps, if_pos hcond_K1, MonoidHom.one_apply, Units.val_one, mul_one, hqK]
  set c_1 : Lˣ := tateElt F L χ' ψ
  have hψ_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1 :=
    (hSpecL χ').1
  have hχ'_triv : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1 :=
    ((hSpecL χ').2.2.1 (by omega)).1
  have hc_1_tate : valL F L (c_1 : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ :=
    (hSpecL χ').2.2.2
  have hc_1_val : valL F L (c_1 : L) = 1 + condExpChar F L ψ := by
    rw [hc_1_tate, ha1]
    norm_num
  set s_L : k_L → L := fun a => (hresL_surj a).choose
  have hs_L_int : ∀ a : k_L, s_L a = 0 ∨ 0 ≤ valL F L (s_L a) :=
    fun a => (hresL_surj a).choose_spec.1
  have hs_L_res : ∀ a : k_L, resL (s_L a) = a :=
    fun a => (hresL_surj a).choose_spec.2
  have hs_L_ne : ∀ (a : k_L), a ≠ 0 → s_L a ≠ 0 := by
    intro a ha h0
    apply ha
    rw [← hs_L_res a, h0, hresL_0]
  have hs_L_val0 : ∀ (a : k_L), a ≠ 0 → valL F L (s_L a) = 0 := by
    intro a ha
    have hne : s_L a ≠ 0 := hs_L_ne a ha
    have hge0 : 0 ≤ valL F L (s_L a) := (hs_L_int a).resolve_left hne
    by_contra hne0
    have hge1 : 1 ≤ valL F L (s_L a) := by omega
    have hres0 : resL (s_L a) = 0 := (hresL_ker (s_L a) (hs_L_int a)).mpr (Or.inr hge1)
    rw [hs_L_res a] at hres0
    exact ha hres0
  set χ_tilde : k_L → Ω F := fun a =>
    if ha : a = 0 then 0 else (χ' (Units.mk0 (s_L a) (hs_L_ne a ha)) : Ω F)⁻¹
  set ψ_tilde : k_L → Ω F := fun a =>
    ψ (((c_1⁻¹ : Lˣ) : L) * s_L a)
  have hχ_zero : χ_tilde 0 = 0 := dif_pos rfl
  have hχ_unit : ∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde (resL (u : L)) = (χ' u : Ω F)⁻¹ := by
    intro u hu
    set a := resL (u : L)
    have hu_int : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
    have ha : a ≠ 0 := by
      intro h0
      rcases (hresL_ker (u : L) hu_int).mp h0 with hu0 | hu1
      · exact Units.ne_zero u hu0
      · omega
    change (if ha' : a = 0 then 0 else (χ' (Units.mk0 (s_L a) (hs_L_ne a ha')) : Ω F)⁻¹) =
      (χ' u : Ω F)⁻¹
    rw [dif_neg ha]
    set v_a : Lˣ := Units.mk0 (s_L a) (hs_L_ne a ha)
    have hv_a_val : valL F L (v_a : L) = 0 := hs_L_val0 a ha
    have hv_a_int : (v_a : L) = 0 ∨ 0 ≤ valL F L (v_a : L) := hs_L_int a
    have hv_a_res : resL (v_a : L) = a := hs_L_res a
    have hneg_va_int : -(v_a : L) = 0 ∨ 0 ≤ valL F L (-(v_a : L)) := by
      rw [neg_eq_zero, hval_neg_L]
      exact hv_a_int
    set d : L := (u : L) - (v_a : L)
    have hd_eq : d = (u : L) + -(v_a : L) := sub_eq_add_neg _ _
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      rw [hd_eq]
      exact hval_add_L 0 (u : L) (-(v_a : L)) hu_int hneg_va_int
    have hd_res : resL d = 0 := by
      rw [hd_eq, (hresL_ring (u : L) (-(v_a : L)) hu_int hneg_va_int).1,
        (hresL_ring (v_a : L) 0 hv_a_int (Or.inl rfl)).2.2, hv_a_res]
      exact add_neg_cancel a
    have hd_val : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set h : Lˣ := v_a⁻¹ * u
    have hh_sub : (h : L) - 1 = ((v_a⁻¹ : Lˣ) : L) * d := by
      have hv_inv : ((v_a⁻¹ : Lˣ) : L) * (v_a : L) = 1 := Units.inv_mul v_a
      calc
        (h : L) - 1 = ((v_a⁻¹ : Lˣ) : L) * (u : L) - ((v_a⁻¹ : Lˣ) : L) * (v_a : L) := by
          rw [hv_inv]; rfl
        _ = ((v_a⁻¹ : Lˣ) : L) * d := by ring
    have hh_mem : h ∈ unitGroup F L (condExp F L χ') := by
      rw [hunit_ge1_L (condExp F L χ') (by omega) h, ha1]
      rcases hd_val with hd0 | hd1
      · left
        have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        rw [hh_sub]
        have hd_ne : d ≠ 0 := by
          intro h0
          rw [h0, hval0_L] at hd1
          omega
        rw [hval_mul_L ((v_a⁻¹ : Lˣ) : L) d (Units.ne_zero v_a⁻¹) hd_ne,
          hval_inv_L v_a, hv_a_val]
        omega
    have hχ_h : χ' h = 1 := hχ'_triv h hh_mem
    have hu_eq : v_a * h = u := mul_inv_cancel_left v_a u
    have hχ_eq : χ' u = χ' v_a := by
      rw [← hu_eq, map_mul, hχ_h, mul_one]
    rw [hχ_eq]
  have hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ (((c_1⁻¹ : Lˣ) : L) * x) := by
    intro x hx
    set a := resL x
    have hsa_int : s_L a = 0 ∨ 0 ≤ valL F L (s_L a) := hs_L_int a
    have hneg_sa_int : -(s_L a) = 0 ∨ 0 ≤ valL F L (-(s_L a)) := by
      rw [neg_eq_zero, hval_neg_L]
      exact hsa_int
    set d : L := x - s_L a
    have hd_eq : d = x + -(s_L a) := sub_eq_add_neg _ _
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      rw [hd_eq]
      exact hval_add_L 0 x (-(s_L a)) hx hneg_sa_int
    have hd_res : resL d = 0 := by
      rw [hd_eq, (hresL_ring x (-(s_L a)) hx hneg_sa_int).1,
        (hresL_ring (s_L a) 0 hsa_int (Or.inl rfl)).2.2, hs_L_res a]
      exact add_neg_cancel a
    have hd_val : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set w : L := ((c_1⁻¹ : Lˣ) : L) * d
    have hw_val : w = 0 ∨ -condExpChar F L ψ ≤ valL F L w := by
      rcases hd_val with hd0 | hd1
      · left; simp [w, hd0]
      · right
        have hd_ne : d ≠ 0 := by
          intro h0
          rw [h0, hval0_L] at hd1
          omega
        rw [hval_mul_L ((c_1⁻¹ : Lˣ) : L) d (Units.ne_zero c_1⁻¹) hd_ne,
          hval_inv_L c_1, hc_1_val]
        omega
    have hψ_w : ψ w = 1 := hψ_triv w hw_val
    have hx_split : ((c_1⁻¹ : Lˣ) : L) * x = ((c_1⁻¹ : Lˣ) : L) * s_L a + w := by
      simp only [w, d]
      ring
    change ψ (((c_1⁻¹ : Lˣ) : L) * s_L a) = ψ (((c_1⁻¹ : Lˣ) : L) * x)
    rw [hx_split, ψ.map_add_eq_mul, hψ_w, mul_one]
  have htate_L := hGauss L ψ χ' ha1 hc_1_tate hFinL1
    ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_add_L,
      hunit_ge1_L, hunit_val0_L⟩
    k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
    c_1 hc_1_val χ_tilde ψ_tilde hχ_zero hχ_unit hψ_int
  set p := Module.finrank L (IntermediateField.extendScalars hLK)
  set χ'_K : Kˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLK))
  set ψ_K : AddChar K (Ω F) := traceChar F hLK ψ
  have hcond_K : condExp F K χ'_K = 1 := haK.trans ha1
  set χ_tilde_K : k_L → Ω F := fun b => χ_tilde (b ^ p)
  set ψ_tilde_K : k_L → Ω F := fun b => ψ_tilde (b ^ p)
  have hχK_zero : χ_tilde_K 0 = 0 := by
    change χ_tilde ((0 : k_L) ^ p) = 0
    rw [zero_pow hPrime.ne_zero, hχ_zero]
  have hχK_unit : ∀ w : Kˣ, valL F K (w : K) = 0 →
      χ_tilde_K (resK (w : K)) = (χ'_K w : Ω F)⁻¹ := by
    intro w hw
    set u_w : Lˣ := Units.map (normLM F hLK) w
    have hu_w_val : valL F L (u_w : L) = 0 := by
      change valL F L (normLM F hLK (w : K)) = 0
      rw [hval_norm (w : K), hw]
    have hres_eq : resL (u_w : L) = (resK (w : K)) ^ p := hresK_norm w hw
    change χ_tilde ((resK (w : K)) ^ p) = (χ' u_w : Ω F)⁻¹
    rw [← hres_eq]
    exact hχ_unit u_w hu_w_val
  have hψK_int : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ψ_tilde_K (resK y) = ψ_K (((c_K⁻¹ : Kˣ) : K) * y) := by
    intro y hy
    change ψ (((c_1⁻¹ : Lˣ) : L) * s_L ((resK y) ^ p)) =
      ψ_K (((c_K⁻¹ : Kˣ) : K) * y)
    exact (hc_K_psi y hy (s_L ((resK y) ^ p)) (hs_L_int _) (hs_L_res _)).symm
  have htate_K := hGauss K ψ_K χ'_K hcond_K (hSpecK χ'_K).2.2.2 hFinK1
    ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_add_K,
      hunit_ge1_K, hunit_val0_K⟩
    k_L resK hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
    c_K hc_K_val χ_tilde_K ψ_tilde_K hχK_zero hχK_unit hψK_int
  rw [hqK] at htate_K
  have hresL_pow : ∀ (s : L), (s = 0 ∨ 0 ≤ valL F L s) →
      ∀ (m : ℕ), (s ^ m = 0 ∨ 0 ≤ valL F L (s ^ m)) ∧ resL (s ^ m) = (resL s) ^ m := by
    intro s hs m
    induction m with
    | zero =>
      rw [pow_zero, pow_zero, hresL_1]
      exact ⟨Or.inr (by rw [hval1_L]), rfl⟩
    | succ m ih =>
      rw [pow_succ, pow_succ]
      have hsm_int : s ^ m * s = 0 ∨ 0 ≤ valL F L (s ^ m * s) := by
        rcases ih.1 with h0 | hge0
        · left; rw [h0, zero_mul]
        · rcases hs with hs0 | hsge0
          · left; rw [hs0, mul_zero]
          · by_cases hsm_ne : s ^ m = 0
            · left; rw [hsm_ne, zero_mul]
            · by_cases hs_ne : s = 0
              · left; rw [hs_ne, mul_zero]
              · right
                rw [hval_mul_L (s ^ m) s hsm_ne hs_ne]
                omega
      refine ⟨hsm_int, ?_⟩
      rw [(hresL_ring (s ^ m) s ih.1 hs).2.1, ih.2]
  have hfrob_surj_kL : Function.Surjective (fun b : k_L => b ^ p) := by
    intro a
    obtain ⟨s, hs_int, hs_frob⟩ := hfrob_surj (s_L a) (hs_L_int a)
    have hsp := hresL_pow s hs_int p
    have hneg_sp_int : -(s ^ p) = 0 ∨ 0 ≤ valL F L (-(s ^ p)) := by
      rw [neg_eq_zero, hval_neg_L]
      exact hsp.1
    set d : L := s_L a - s ^ p
    have hd_eq : d = s_L a + -(s ^ p) := sub_eq_add_neg _ _
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      rw [hd_eq]
      exact hval_add_L 0 (s_L a) (-(s ^ p)) (hs_L_int a) hneg_sp_int
    have hd_res0 : resL d = 0 := (hresL_ker d hd_int).mpr hs_frob
    have hd_res_calc : resL d = a - (resL s) ^ p := by
      rw [hd_eq, (hresL_ring (s_L a) (-(s ^ p)) (hs_L_int a) hneg_sp_int).1,
        (hresL_ring (s ^ p) 0 hsp.1 (Or.inl rfl)).2.2, hs_L_res a, hsp.2]
      ring
    rw [hd_res_calc] at hd_res0
    exact ⟨resL s, (sub_eq_zero.mp hd_res0).symm⟩
  have hfrob_bij : Function.Bijective (fun b : k_L => b ^ p) :=
    (Fintype.bijective_iff_surjective_and_card (fun b : k_L => b ^ p)).mpr ⟨hfrob_surj_kL, rfl⟩
  have hsum_eq : (∑ b : k_L, χ_tilde_K b * ψ_tilde_K b) =
      (∑ a : k_L, χ_tilde a * ψ_tilde a) :=
    Equiv.sum_comp (Equiv.ofBijective (fun b : k_L => b ^ p) hfrob_bij)
      (fun a => χ_tilde a * ψ_tilde a)
  have hχ_cK : (χ'_K c_K : Ω F) = (χ' c_1 : Ω F) * (χ' u_pref : Ω F) := by
    have hmem : Units.map (normLM F hLK) c_K * (c_1 * u_pref)⁻¹ ∈
        unitGroup F L (condExp F L χ') := ha1.symm ▸ hc_K_norm
    have h1 : χ' (Units.map (normLM F hLK) c_K * (c_1 * u_pref)⁻¹) = 1 :=
      hχ'_triv _ hmem
    rw [map_mul, map_inv, mul_inv_eq_one, map_mul] at h1
    exact_mod_cast h1
  change tateEps F K χ'_K ψ_K * tateEps F L 1 ψ =
    tateEps F K 1 ψ_K * tateEps F L χ' ψ * (χ' u_pref : Ω F)
  rw [htate_K, htate_L, htate_K1, htate_L1, hsum_eq, hχ_cK]
  ring

theorem ld_wild_low_cond_one_endpoint (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
