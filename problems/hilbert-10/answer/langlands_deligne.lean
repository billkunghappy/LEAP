        map_add' := fun x y => Subtype.ext (map_add σ_K x.1 y.1)
        commutes' := fun c => Subtype.ext (σ_K.commutes c) }
    obtain ⟨n₀, hn₀⟩ := (FiniteField.bijective_frobeniusAlgHom_pow 𝓀[F] K_res).2 φ_res
    let k : ℕ := n₀.1
    have hfrob_pow : ∀ (j : ℕ) (y : K_res),
        (((FiniteField.frobeniusAlgHom 𝓀[F] K_res ^ j) y : K_res) : K) = y.1 ^ ((q F) ^ j) := by
      intro j
      induction j with
      | zero =>
        intro y
        rw [pow_zero, AlgHom.one_apply, pow_zero, pow_one]
      | succ j ih =>
        intro y
        rw [pow_succ', AlgHom.mul_apply, FiniteField.frobeniusAlgHom_apply, hq_card,
          IntermediateField.coe_pow, ih y, ← pow_mul, ← pow_succ]
    let y₀ : K_res := ⟨ζbar, hζbar_mem⟩
    have hφ_y₀ : ((φ_res y₀ : K_res) : K) = ζbar ^ ((q F) ^ k) := by
      rw [← hn₀]
      exact hfrob_pow k y₀
    have hres_eq_qk : res ⟨σ₀ ζ₀, hσz₀⟩ = res (z₀ ^ ((q F) ^ k)) := by
      rw [hres_σ]
      change ((φ_res y₀ : K_res) : K) = res (z₀ ^ ((q F) ^ k))
      rw [hφ_y₀, map_pow]
    have hσ₀_N : (σ₀ ζ₀) ^ N = 1 := by
      rw [← map_pow, hζ₀, map_one]
    have hqk_N : ((z₀ ^ ((q F) ^ k) : R) : AlgebraicClosure F) ^ N = 1 := by
      rw [R.coe_pow, ← pow_mul, mul_comm ((q F) ^ k) N, pow_mul, hζ₀, one_pow]
    refine ⟨k, ?_⟩
    have hinj := hinj_roots N hN_pos hN_res ⟨σ₀ ζ₀, hσz₀⟩ (z₀ ^ ((q F) ^ k)) hσ₀_N hqk_N hres_eq_qk
    rwa [R.coe_pow] at hinj
  obtain ⟨haeval, hσ₀_gen⟩ := hs3
  refine ⟨hN_F, ?_, ?_⟩
  · obtain ⟨τ, hτ_ζ₀⟩ := horbit ζ₀ haeval
    refine ⟨τ, fun ζ hζ => ?_⟩
    obtain ⟨m, rfl⟩ := hζ₀_gen ζ hζ
    rw [map_pow, hτ_ζ₀, pow_right_comm]
  · intro σ₀
    have hσ₀_N : (σ₀ ζ₀) ^ N = 1 := by
      rw [← map_pow, hζ₀, map_one]
    obtain ⟨k, hk_ζ₀⟩ := hσ₀_gen σ₀ (hζ₀_gen (σ₀ ζ₀) hσ₀_N)
    refine ⟨k, fun ζ hζ => ?_⟩
    obtain ⟨r, rfl⟩ := hζ₀_gen ζ hζ
    rw [map_pow, hk_ζ₀, pow_right_comm]

theorem ld_relWeil_quotient_card_eq_finrank (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hp : Nat.Prime (p F))
    (hFrob : ∀ (N : ℕ), 0 < N → ¬ p F ∣ N →
      (N : F) ≠ 0 ∧
      (∃ τ : AbsGal F, ∀ ζ : AlgebraicClosure F, ζ ^ N = 1 → τ ζ = ζ ^ (q F)) ∧
      (∀ σ₀ : AbsGal F, ∃ k : ℕ, ∀ ζ : AlgebraicClosure F, ζ ^ N = 1 → σ₀ ζ = ζ ^ ((q F) ^ k)))
    (M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (h' : M ≤ E) (hSep : Algebra.IsSeparable M (IntermediateField.extendScalars h')) :
    Finite (relWeil F M ⧸ (relWeil F E).subgroupOf (relWeil F M)) ∧
    Nat.card (relWeil F M ⧸ (relWeil F E).subgroupOf (relWeil F M)) =
      Module.finrank M (IntermediateField.extendScalars h') :=
by
  let S : Set (AlgebraicClosure F) := {ζ | IsPrimeToPRootOfUnity F ζ}
  let U : IntermediateField F (AlgebraicClosure F) := unramifiedClosure F
  have hU_def : U = IntermediateField.adjoin F S := rfl
  have hS_pow : ∀ {ζ : AlgebraicClosure F}, ζ ∈ S → ∀ d : ℕ, ζ ^ d ∈ S := by
    rintro ζ ⟨n, hn, hpn, hζ⟩ d
    refine ⟨n, hn, hpn, ?_⟩
    rw [← pow_mul, mul_comm, pow_mul, hζ, one_pow]
  have hS_map : ∀ (K : Type u) [Field K] [Algebra F K] [Algebra K (AlgebraicClosure F)]
      [IsScalarTower F K (AlgebraicClosure F)]
      (σ : AlgebraicClosure F →ₐ[K] AlgebraicClosure F) {ζ : AlgebraicClosure F},
      ζ ∈ S → σ ζ ∈ S := by
    rintro K _ _ _ _ σ ζ ⟨n, hn, hpn, hζ⟩
    refine ⟨n, hn, hpn, ?_⟩
    rw [← map_pow, hζ, map_one]
  have hGalois_adjoin : ∀ (K : Type u) [Field K] [Algebra F K] [Algebra K (AlgebraicClosure F)]
      [IsScalarTower F K (AlgebraicClosure F)],
      IsGalois K ↥(IntermediateField.adjoin K S) := by
    intro K _ _ _ _
    haveI : Normal K (AlgebraicClosure F) :=
      Normal.tower_top_of_normal F K (AlgebraicClosure F)
    have hNorm : Normal K ↥(IntermediateField.adjoin K S) := by
      rw [IntermediateField.normal_iff_forall_map_le]
      intro σ
      rw [IntermediateField.adjoin_map, IntermediateField.adjoin_le_iff]
      rintro y ⟨ζ, hζ, rfl⟩
      exact IntermediateField.subset_adjoin K S (hS_map K σ hζ)
    have hSepK : Algebra.IsSeparable K ↥(IntermediateField.adjoin K S) := by
      rw [IntermediateField.isSeparable_adjoin_iff_isSeparable]
      rintro ζ ⟨n, hn, hpn, hζ⟩
      have hnF : (n : F) ≠ 0 := (hFrob n hn hpn).1
      have hnK : (n : K) ≠ 0 := by
        intro h0
        apply hnF
        apply (algebraMap F K).injective
        rw [map_natCast, h0, map_zero]
      have hsep_poly : (Polynomial.X ^ n - Polynomial.C (1 : K)).Separable :=
        Polynomial.separable_X_pow_sub_C (1 : K) hnK one_ne_zero
      have hdvd : minpoly K ζ ∣ Polynomial.X ^ n - Polynomial.C (1 : K) := by
        apply minpoly.dvd K ζ
        simp [hζ]
      exact hsep_poly.of_dvd hdvd
    exact @IsGalois.mk K _ ↥(IntermediateField.adjoin K S) _ _ hSepK hNorm
  haveI hGalU : IsGalois F ↥U := hGalois_adjoin F
  haveI hNormU : Normal F ↥U := hGalU.to_normal
  
  have hs1 : ∀ σ₀ : AbsGal F,
      ∃ (ψ : AbsGal F) (k : ℕ),
        ψ ∈ (E ⊓ U).fixingSubgroup ∧
        ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
          ψ ζ = σ₀⁻¹ (ζ ^ ((q F) ^ k)) := by
    haveI hCompU : CompactSpace (↥U ≃ₐ[F] ↥U) :=
      InfiniteGalois.instCompactSpaceAlgEquivOfIsGalois F ↥U
    have hex_frob : ∃ τ : AbsGal F, ∀ ζ : AlgebraicClosure F, ζ ∈ S → τ ζ = ζ ^ (q F) := by
      let u_S : S → ↥U := fun ζ => ⟨ζ.1, IntermediateField.subset_adjoin F S ζ.2⟩
      let A : S → Set (↥U ≃ₐ[F] ↥U) := fun ζ =>
        {τ_U | (τ_U (u_S ζ) : AlgebraicClosure F) = ζ.1 ^ (q F)}
      have hA_closed : ∀ ζ : S, IsClosed (A ζ) := by
        intro ζ
        by_cases hne : (A ζ).Nonempty
        · rcases hne with ⟨τ₁, hτ₁⟩
          have hA_eq : A ζ = (fun τ_U : ↥U ≃ₐ[F] ↥U => τ₁⁻¹ * τ_U) ⁻¹'
              ((IntermediateField.adjoin F ({u_S ζ} : Set ↥U)).fixingSubgroup :
                Set (↥U ≃ₐ[F] ↥U)) := by
            ext τ_U
            simp only [A, Set.mem_setOf_eq, Set.mem_preimage, SetLike.mem_coe,
              IntermediateField.mem_fixingSubgroup_iff]
            constructor
            · intro hτ x hx
              have hle : IntermediateField.adjoin F ({u_S ζ} : Set ↥U) ≤
                  IntermediateField.fixedField (Subgroup.zpowers (τ₁⁻¹ * τ_U)) := by
                rw [IntermediateField.adjoin_le_iff]
                rintro y (rfl : y = u_S ζ)
                rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
                intro g hg
                rcases Subgroup.mem_zpowers_iff.mp hg with ⟨m, rfl⟩
                have hfix1 : (τ₁⁻¹ * τ_U) (u_S ζ) = u_S ζ := by
                  have h1 : τ_U (u_S ζ) = τ₁ (u_S ζ) := by
                    apply Subtype.ext
                    change (τ_U (u_S ζ) : AlgebraicClosure F) = (τ₁ (u_S ζ) : AlgebraicClosure F)
                    rw [hτ, hτ₁]
                  rw [AlgEquiv.mul_apply, h1, ← AlgEquiv.mul_apply, inv_mul_cancel,
                    AlgEquiv.one_apply]
                have hfix_zpow : ∀ m : ℤ, ((τ₁⁻¹ * τ_U) ^ m) (u_S ζ) = u_S ζ := by
                  intro m
                  induction m using Int.induction_on with
                  | zero => rfl
                  | succ k ih =>
                    rw [zpow_add_one, AlgEquiv.mul_apply, hfix1, ih]
                  | pred k ih =>
                    have hinv : (τ₁⁻¹ * τ_U)⁻¹ (u_S ζ) = u_S ζ := by
                      conv_lhs => rw [← hfix1]
                      rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
                    rw [sub_eq_add_neg, zpow_add, zpow_neg_one, AlgEquiv.mul_apply, hinv, ih]
                exact hfix_zpow m
              have hx' := hle hx
              rw [IntermediateField.mem_fixedField_iff] at hx'
              exact hx' (τ₁⁻¹ * τ_U) (Subgroup.mem_zpowers _)
            · intro hfix
              have hu : (τ₁⁻¹ * τ_U) (u_S ζ) = u_S ζ :=
                hfix (u_S ζ) (IntermediateField.subset_adjoin F _ (Set.mem_singleton _))
              have hu' : τ_U (u_S ζ) = τ₁ (u_S ζ) := by
                have h2 := congr_arg τ₁ hu
                rw [AlgEquiv.mul_apply, ← AlgEquiv.mul_apply, mul_inv_cancel,
                  AlgEquiv.one_apply] at h2
                exact h2
              change (τ_U (u_S ζ) : AlgebraicClosure F) = ζ.1 ^ (q F)
              rw [hu', hτ₁]
          rw [hA_eq]
          exact (InfiniteGalois.fixingSubgroup_isClosed
            (IntermediateField.adjoin F ({u_S ζ} : Set ↥U))).preimage (continuous_mul_left τ₁⁻¹)
        · rw [Set.not_nonempty_iff_eq_empty.mp hne]
          exact isClosed_empty
      have hA_fip : ∀ s : Finset S, (⋂ ζ ∈ s, A ζ).Nonempty := by
        intro s
        let N : ℕ := ∏ ζ ∈ s, ζ.2.choose
        have hN_pos : 0 < N := by
          apply Finset.prod_pos
          intro ζ _
          exact ζ.2.choose_spec.1
        have hpN : ¬ p F ∣ N := by
          rw [hp.prime.dvd_finset_prod_iff]
          rintro ⟨ζ, _, hdiv⟩
          exact ζ.2.choose_spec.2.1 hdiv
        obtain ⟨τ_N, hτ_N⟩ := (hFrob N hN_pos hpN).2.1
        refine ⟨AlgEquiv.restrictNormalHom ↥U τ_N, Set.mem_iInter₂.mpr ?_⟩
        intro ζ hζs
        dsimp only [A, Set.mem_setOf_eq]
        rw [AlgEquiv.restrictNormalHom_apply U τ_N (u_S ζ)]
        apply hτ_N ζ.1
        rcases Finset.dvd_prod_of_mem (fun x : S => x.2.choose) hζs with ⟨c, hc⟩
        change ζ.1 ^ (∏ x ∈ s, x.2.choose) = 1
        rw [hc, pow_mul, ζ.2.choose_spec.2.2, one_pow]
      obtain ⟨τ_U, hτ_U⟩ := CompactSpace.iInter_nonempty hA_closed hA_fip
      obtain ⟨τ, hτ⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) τ_U
      refine ⟨τ, fun ζ hζ => ?_⟩
      have hmem := Set.mem_iInter.mp hτ_U ⟨ζ, hζ⟩
      dsimp only [A, Set.mem_setOf_eq] at hmem
      have happ : (τ_U (u_S ⟨ζ, hζ⟩) : AlgebraicClosure F) = τ ζ := by
        rw [← hτ]
        exact AlgEquiv.restrictNormalHom_apply U τ (u_S ⟨ζ, hζ⟩)
      rw [← happ, hmem]
    obtain ⟨τ, hτ_frob⟩ := hex_frob
    have hτ_pow : ∀ (k : ℕ) {ζ : AlgebraicClosure F}, ζ ∈ S → (τ ^ k) ζ = ζ ^ ((q F) ^ k) := by
      intro k
      induction k with
      | zero =>
        intro ζ _
        simp
      | succ k ih =>
        intro ζ hζ
        rw [pow_succ', AlgEquiv.mul_apply, ih hζ, hτ_frob _ (hS_pow hζ ((q F) ^ k)),
          ← pow_mul, ← pow_succ]
    let K_cyc : ℕ → IntermediateField F (AlgebraicClosure F) :=
      fun N => IntermediateField.adjoin F {ζ : AlgebraicClosure F | ζ ^ N = 1}
    have hK_mono : ∀ {N₁ N₂ : ℕ}, N₁ ∣ N₂ → K_cyc N₁ ≤ K_cyc N₂ := by
      intro N₁ N₂ ⟨c, hc⟩
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      apply IntermediateField.subset_adjoin F {ζ : AlgebraicClosure F | ζ ^ N₂ = 1}
      change ζ ^ N₂ = 1
      change ζ ^ N₁ = 1 at hζ
      rw [hc, pow_mul, hζ, one_pow]
    let U' : IntermediateField F (AlgebraicClosure F) :=
      { carrier := {x : AlgebraicClosure F | ∃ N : ℕ, 0 < N ∧ ¬ p F ∣ N ∧ x ∈ K_cyc N}
        algebraMap_mem' := fun r => ⟨1, zero_lt_one, hp.not_dvd_one, (K_cyc 1).algebraMap_mem r⟩
        zero_mem' := ⟨1, zero_lt_one, hp.not_dvd_one, (K_cyc 1).zero_mem⟩
        one_mem' := ⟨1, zero_lt_one, hp.not_dvd_one, (K_cyc 1).one_mem⟩
        add_mem' := by
          rintro a b ⟨N₁, hN₁, hp₁, ha⟩ ⟨N₂, hN₂, hp₂, hb⟩
          refine ⟨N₁ * N₂, Nat.mul_pos hN₁ hN₂, mt hp.dvd_mul.mp (not_or.mpr ⟨hp₁, hp₂⟩), ?_⟩
          exact (K_cyc (N₁ * N₂)).add_mem (hK_mono (dvd_mul_right N₁ N₂) ha)
            (hK_mono (dvd_mul_left N₂ N₁) hb)
        mul_mem' := by
          rintro a b ⟨N₁, hN₁, hp₁, ha⟩ ⟨N₂, hN₂, hp₂, hb⟩
          refine ⟨N₁ * N₂, Nat.mul_pos hN₁ hN₂, mt hp.dvd_mul.mp (not_or.mpr ⟨hp₁, hp₂⟩), ?_⟩
          exact (K_cyc (N₁ * N₂)).mul_mem (hK_mono (dvd_mul_right N₁ N₂) ha)
            (hK_mono (dvd_mul_left N₂ N₁) hb)
        inv_mem' := by
          rintro a ⟨N, hN, hpN, ha⟩
          exact ⟨N, hN, hpN, (K_cyc N).inv_mem ha⟩ }
    have hU_le_U' : U ≤ U' := by
      rw [hU_def, IntermediateField.adjoin_le_iff]
      rintro ζ ⟨N, hN, hpN, hζ⟩
      exact ⟨N, hN, hpN, IntermediateField.subset_adjoin F _ hζ⟩
    haveI : FiniteDimensional F ↥(E ⊓ U) := inferInstance
    let b₀ := Module.finBasis F ↥(E ⊓ U)
    have hb₀_mem : ∀ i : Fin (Module.finrank F ↥(E ⊓ U)),
        ∃ N : ℕ, 0 < N ∧ ¬ p F ∣ N ∧ (b₀ i : AlgebraicClosure F) ∈ K_cyc N :=
      fun i => hU_le_U' ((b₀ i).2.2)
    let N_i : Fin (Module.finrank F ↥(E ⊓ U)) → ℕ := fun i => (hb₀_mem i).choose
    let N₀ : ℕ := ∏ i : Fin (Module.finrank F ↥(E ⊓ U)), N_i i
    have hN₀_pos : 0 < N₀ := Finset.prod_pos fun i _ => (hb₀_mem i).choose_spec.1
    have hpN₀ : ¬ p F ∣ N₀ := by
      rw [hp.prime.dvd_finset_prod_iff]
      rintro ⟨i, _, hdiv⟩
      exact (hb₀_mem i).choose_spec.2.1 hdiv
    have hE₀_le_K : E ⊓ U ≤ K_cyc N₀ := by
      intro x hx
      have hx_eq : x = ∑ i : Fin (Module.finrank F ↥(E ⊓ U)),
          (b₀.repr ⟨x, hx⟩ i) • (b₀ i : AlgebraicClosure F) := by
        calc x = ((⟨x, hx⟩ : ↥(E ⊓ U)) : AlgebraicClosure F) := rfl
          _ = ((∑ i, (b₀.repr ⟨x, hx⟩ i) • b₀ i : ↥(E ⊓ U)) : AlgebraicClosure F) := by
            rw [Module.Basis.sum_repr b₀ ⟨x, hx⟩]
          _ = ∑ i : Fin (Module.finrank F ↥(E ⊓ U)),
              (b₀.repr ⟨x, hx⟩ i) • (b₀ i : AlgebraicClosure F) := by
            rw [AddSubmonoidClass.coe_finset_sum]
            rfl
      rw [hx_eq]
      apply Submodule.sum_mem (K_cyc N₀).toSubalgebra.toSubmodule
      intro i _
      apply Submodule.smul_mem (K_cyc N₀).toSubalgebra.toSubmodule
      have hdvd : N_i i ∣ N₀ := Finset.dvd_prod_of_mem N_i (Finset.mem_univ i)
      exact hK_mono hdvd (hb₀_mem i).choose_spec.2.2
    intro σ₀
    obtain ⟨k, hk⟩ := (hFrob N₀ hN₀_pos hpN₀).2.2 σ₀
    let ψ : AbsGal F := σ₀⁻¹ * (τ ^ k)
    refine ⟨ψ, k, ?_, ?_⟩
    · have hK_le : K_cyc N₀ ≤ IntermediateField.fixedField (Subgroup.zpowers ψ) := by
        rw [IntermediateField.adjoin_le_iff]
        intro ζ hζ
        rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
        intro g hg
        rcases Subgroup.mem_zpowers_iff.mp hg with ⟨m, rfl⟩
        have hζS : ζ ∈ S := ⟨N₀, hN₀_pos, hpN₀, hζ⟩
        have hψζ : ψ ζ = ζ := by
          change (σ₀⁻¹ * (τ ^ k)) ζ = ζ
          rw [AlgEquiv.mul_apply, hτ_pow k hζS, ← hk ζ hζ, ← AlgEquiv.mul_apply,
            inv_mul_cancel, AlgEquiv.one_apply]
        have hψ_zpow : ∀ m : ℤ, (ψ ^ m) ζ = ζ := by
          intro m
          induction m using Int.induction_on with
          | zero => rfl
          | succ d ih => rw [zpow_add_one, AlgEquiv.mul_apply, hψζ, ih]
          | pred d ih =>
            have hinv : ψ⁻¹ ζ = ζ := by
              conv_lhs => rw [← hψζ]
              rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
            rw [sub_eq_add_neg, zpow_add, zpow_neg_one, AlgEquiv.mul_apply, hinv, ih]
        exact hψ_zpow m
      intro x
      have hx := hK_le (hE₀_le_K x.2)
      rw [IntermediateField.mem_fixedField_iff] at hx
      exact hx ψ (Subgroup.mem_zpowers ψ)
    · intro ζ hζ
      change (σ₀⁻¹ * (τ ^ k)) ζ = σ₀⁻¹ (ζ ^ ((q F) ^ k))
      rw [AlgEquiv.mul_apply, hτ_pow k hζ]
  
  have h_amalg : ∀ (K : Type u) [Field K] [Algebra F K] [Algebra K (AlgebraicClosure F)]
      [IsScalarTower F K (AlgebraicClosure F)] (ψ : AbsGal F),
      (∀ x : AlgebraicClosure F, x ∈ U → (∃ e : K, algebraMap K (AlgebraicClosure F) e = x) → ψ x = x) →
      ∃ δ_bar : AlgebraicClosure F ≃ₐ[K] AlgebraicClosure F,
        ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → δ_bar ζ = ψ ζ := by
    intro K _ _ _ _ ψ hψ
    let L_K : IntermediateField K (AlgebraicClosure F) := IntermediateField.adjoin K S
    haveI hGalLK : IsGalois K ↥L_K := hGalois_adjoin K
    haveI hNormLK : Normal K ↥L_K := hGalLK.to_normal
    haveI hCompLK : CompactSpace (↥L_K ≃ₐ[K] ↥L_K) :=
      InfiniteGalois.instCompactSpaceAlgEquivOfIsGalois K ↥L_K
    haveI : TotallySeparatedSpace (↥U ≃ₐ[F] ↥U) := instTotallySeparatedSpaceAlgEquivOfIsIntegral
    have hU_le_LK : ∀ x ∈ U, x ∈ L_K := by
      have hle : U ≤ L_K.restrictScalars F := by
        rw [hU_def, IntermediateField.adjoin_le_iff]
        intro ζ hζ
        exact IntermediateField.subset_adjoin K S hζ
      exact fun x hx => hle hx
    have hLK_maps_U : ∀ (δ₀ : ↥L_K ≃ₐ[K] ↥L_K) (x : ↥U),
        (δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F) ∈ U := by
      intro δ₀ x
      haveI : Normal K (AlgebraicClosure F) :=
        Normal.tower_top_of_normal F K (AlgebraicClosure F)
      obtain ⟨δ_bar, hδ_bar⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) δ₀
      let δ_F : AbsGal F :=
        { δ_bar with
          commutes' := fun r => by
            rw [IsScalarTower.algebraMap_apply F K (AlgebraicClosure F) r]
            exact δ_bar.commutes (algebraMap F K r) }
      have h_eq : (δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F) = δ_F x.1 := by
        have h1 := AlgEquiv.restrictNormalHom_apply L_K δ_bar ⟨x.1, hU_le_LK x.1 x.2⟩
        rw [hδ_bar] at h1
        exact h1
      rw [h_eq, ← AlgEquiv.restrictNormalHom_apply U δ_F x]
      exact ((AlgEquiv.restrictNormalHom ↥U δ_F) x).2
    let Φ_res : (↥L_K ≃ₐ[K] ↥L_K) →* (↥U ≃ₐ[F] ↥U) :=
      { toFun := fun δ₀ =>
          { toFun := fun x => ⟨(δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F), hLK_maps_U δ₀ x⟩
            invFun := fun x => ⟨(δ₀⁻¹ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F), hLK_maps_U δ₀⁻¹ x⟩
            left_inv := fun x => by
              apply Subtype.ext
              have h1 : (⟨(δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F),
                  hU_le_LK _ (hLK_maps_U δ₀ x)⟩ : ↥L_K) = δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ := rfl
              change (δ₀⁻¹ ⟨(δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F),
                hU_le_LK _ (hLK_maps_U δ₀ x)⟩ : AlgebraicClosure F) = x.1
              rw [h1, ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
            right_inv := fun x => by
              apply Subtype.ext
              have h1 : (⟨(δ₀⁻¹ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F),
                  hU_le_LK _ (hLK_maps_U δ₀⁻¹ x)⟩ : ↥L_K) = δ₀⁻¹ ⟨x.1, hU_le_LK x.1 x.2⟩ := rfl
              change (δ₀ ⟨(δ₀⁻¹ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F),
                hU_le_LK _ (hLK_maps_U δ₀⁻¹ x)⟩ : AlgebraicClosure F) = x.1
              rw [h1, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
            map_mul' := fun x y => by
              apply Subtype.ext
              have hxy : (⟨(x * y).1, hU_le_LK (x * y).1 (x * y).2⟩ : ↥L_K) =
                  ⟨x.1, hU_le_LK x.1 x.2⟩ * ⟨y.1, hU_le_LK y.1 y.2⟩ := rfl
              change (δ₀ ⟨(x * y).1, hU_le_LK (x * y).1 (x * y).2⟩ : AlgebraicClosure F) =
                (δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F) *
                  (δ₀ ⟨y.1, hU_le_LK y.1 y.2⟩ : AlgebraicClosure F)
              rw [hxy, map_mul]
              rfl
            map_add' := fun x y => by
              apply Subtype.ext
              have hxy : (⟨(x + y).1, hU_le_LK (x + y).1 (x + y).2⟩ : ↥L_K) =
                  ⟨x.1, hU_le_LK x.1 x.2⟩ + ⟨y.1, hU_le_LK y.1 y.2⟩ := rfl
              change (δ₀ ⟨(x + y).1, hU_le_LK (x + y).1 (x + y).2⟩ : AlgebraicClosure F) =
                (δ₀ ⟨x.1, hU_le_LK x.1 x.2⟩ : AlgebraicClosure F) +
                  (δ₀ ⟨y.1, hU_le_LK y.1 y.2⟩ : AlgebraicClosure F)
              rw [hxy, map_add]
              rfl
            commutes' := fun r => by
              apply Subtype.ext
              have halg : (⟨(algebraMap F ↥U r : AlgebraicClosure F),
                  hU_le_LK _ (algebraMap F ↥U r).2⟩ : ↥L_K) =
                  algebraMap K ↥L_K (algebraMap F K r) := by
                apply Subtype.ext
                exact IsScalarTower.algebraMap_apply F K (AlgebraicClosure F) r
              change (δ₀ ⟨(algebraMap F ↥U r : AlgebraicClosure F),
                hU_le_LK _ (algebraMap F ↥U r).2⟩ : AlgebraicClosure F) =
                (algebraMap F ↥U r : AlgebraicClosure F)
              rw [halg, δ₀.commutes]
              exact (IsScalarTower.algebraMap_apply F K (AlgebraicClosure F) r).symm }
        map_one' := by
          ext x
          rfl
        map_mul' := fun δ₁ δ₂ => by
          ext x
          rfl }
    have hΦ_cont : Continuous Φ_res := by
      apply continuous_of_continuousAt_one Φ_res
      rw [ContinuousAt, map_one]
      intro V hV
      rw [Filter.mem_map]
      obtain ⟨K', hK'_fin, hK'_sub⟩ := (krullTopology_mem_nhds_one_iff F ↥U V).mp hV
      haveI : FiniteDimensional F ↥K' := hK'_fin
      let b' := Module.finBasis F ↥K'
      let ι_ULK : ↥U →ₗ[F] ↥L_K :=
        { toFun := fun x => ⟨x.1, hU_le_LK x.1 x.2⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      let S' : Set ↥L_K := Set.range (fun i : Fin (Module.finrank F ↥K') => ι_ULK (b' i : ↥U))
      haveI : Finite ↥S' := Set.finite_range _
      let K'' : IntermediateField K ↥L_K := IntermediateField.adjoin K S'
      haveI : FiniteDimensional K ↥K'' :=
        IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
      rw [krullTopology_mem_nhds_one_iff K ↥L_K (Φ_res ⁻¹' V)]
      refine ⟨K'', inferInstance, ?_⟩
      intro δ₀ hδ₀
      apply hK'_sub
      rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff] at hδ₀ ⊢
      intro y hy
      have hy_eq : y = ∑ i : Fin (Module.finrank F ↥K'), (b'.repr ⟨y, hy⟩ i) • (b' i : ↥U) := by
        calc y = ((⟨y, hy⟩ : ↥K') : ↥U) := rfl
          _ = ((∑ i, (b'.repr ⟨y, hy⟩ i) • b' i : ↥K') : ↥U) := by
            rw [Module.Basis.sum_repr b' ⟨y, hy⟩]
          _ = ∑ i : Fin (Module.finrank F ↥K'), (b'.repr ⟨y, hy⟩ i) • (b' i : ↥U) := by
            rw [AddSubmonoidClass.coe_finset_sum]
            rfl
      rw [hy_eq, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [map_smul]
      congr 1
      apply Subtype.ext
      have hmemS' : ι_ULK (b' i : ↥U) ∈ K'' :=
        IntermediateField.subset_adjoin K S' ⟨i, rfl⟩
      have hfix_i := hδ₀ (ι_ULK (b' i : ↥U)) hmemS'
      change (δ₀ (ι_ULK (b' i : ↥U)) : AlgebraicClosure F) = (ι_ULK (b' i : ↥U) : AlgebraicClosure F)
      exact congr_arg Subtype.val hfix_i
    have hH_closed : IsClosed (Φ_res.range : Set (↥U ≃ₐ[F] ↥U)) := by
      rw [MonoidHom.coe_range]
      exact (isCompact_range hΦ_cont).isClosed
    let H_closed : ClosedSubgroup (↥U ≃ₐ[F] ↥U) := ⟨Φ_res.range, hH_closed⟩
    have h_gal_U : (IntermediateField.fixedField Φ_res.range).fixingSubgroup = Φ_res.range :=
      InfiniteGalois.fixingSubgroup_fixedField H_closed
    have h_gal_LK : IntermediateField.fixedField (⊤ : Subgroup (↥L_K ≃ₐ[K] ↥L_K)) =
        (⊥ : IntermediateField K ↥L_K) := by
      rw [← IntermediateField.fixingSubgroup_bot]
      exact InfiniteGalois.fixedField_fixingSubgroup (⊥ : IntermediateField K ↥L_K)
    let ψ_U : ↥U ≃ₐ[F] ↥U := AlgEquiv.restrictNormalHom ↥U ψ
    have hψ_U_mem : ψ_U ∈ Φ_res.range := by
      rw [← h_gal_U, IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      rw [IntermediateField.mem_fixedField_iff] at hx
      have hx_LK : (⟨x.1, hU_le_LK x.1 x.2⟩ : ↥L_K) ∈
          IntermediateField.fixedField (⊤ : Subgroup (↥L_K ≃ₐ[K] ↥L_K)) := by
        rw [IntermediateField.mem_fixedField_iff]
        intro δ₀ _
        have h1 := hx (Φ_res δ₀) ⟨δ₀, rfl⟩
        apply Subtype.ext
        change ((Φ_res δ₀) x : AlgebraicClosure F) = (x : AlgebraicClosure F)
        exact congr_arg Subtype.val h1
      rw [h_gal_LK, IntermediateField.mem_bot] at hx_LK
      rcases hx_LK with ⟨e, he⟩
      have he_val : algebraMap K (AlgebraicClosure F) e = x.1 :=
        congr_arg Subtype.val he
      apply Subtype.ext
      change (ψ_U x : AlgebraicClosure F) = x.1
      rw [AlgEquiv.restrictNormalHom_apply U ψ x]
      exact hψ x.1 x.2 ⟨e, he_val⟩
    rcases hψ_U_mem with ⟨δ₀, hδ₀⟩
    haveI : Normal K (AlgebraicClosure F) :=
      Normal.tower_top_of_normal F K (AlgebraicClosure F)
    obtain ⟨δ_bar, hδ_bar⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) δ₀
    refine ⟨δ_bar, fun ζ hζ => ?_⟩
    let u_ζ : ↥U := ⟨ζ, IntermediateField.subset_adjoin F S hζ⟩
    have h1 : δ_bar ζ = (δ₀ ⟨ζ, hU_le_LK ζ u_ζ.2⟩ : AlgebraicClosure F) := by
      have happ := AlgEquiv.restrictNormalHom_apply L_K δ_bar ⟨ζ, hU_le_LK ζ u_ζ.2⟩
      rw [hδ_bar] at happ
      exact happ.symm
    have h2 : (δ₀ ⟨ζ, hU_le_LK ζ u_ζ.2⟩ : AlgebraicClosure F) = (Φ_res δ₀ u_ζ : AlgebraicClosure F) := rfl
    have h3 : (Φ_res δ₀ u_ζ : AlgebraicClosure F) = (ψ_U u_ζ : AlgebraicClosure F) := by
      rw [hδ₀]
    have h4 : (ψ_U u_ζ : AlgebraicClosure F) = ψ ζ :=
      AlgEquiv.restrictNormalHom_apply U ψ u_ζ
    rw [h1, h2, h3, h4]
  have hs2 : ∀ (ψ : AbsGal F), ψ ∈ (E ⊓ U).fixingSubgroup →
      ∃ δ : AbsGal F, δ ∈ E.fixingSubgroup ∧
        ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → δ ζ = ψ ζ := by
    intro ψ hψ
    obtain ⟨δ_bar, hδ_bar⟩ := h_amalg ↥E ψ (by
      rintro x hxU ⟨e, rfl⟩
      exact hψ ⟨(e : AlgebraicClosure F), ⟨e.2, hxU⟩⟩)
    let δ := (IntermediateField.fixingSubgroupEquiv E).symm δ_bar
    exact ⟨δ.1, δ.2, hδ_bar⟩
  have hLift : ∀ σ₀ : AbsGal F,
      ∃ (δ : AbsGal F) (k : ℕ),
        δ ∈ E.fixingSubgroup ∧
        ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
          δ ζ = σ₀⁻¹ (ζ ^ ((q F) ^ k)) := by
    intro σ₀
    obtain ⟨ψ, k, hψ_fix, hψ_frob⟩ := hs1 σ₀
    obtain ⟨δ, hδ_fix, hδ_eq⟩ := hs2 ψ hψ_fix
    refine ⟨δ, k, hδ_fix, fun ζ hζ => ?_⟩
    rw [hδ_eq ζ hζ, hψ_frob ζ hζ]
  let G_M := relWeil F M
  let H_EM := (relWeil F E).subgroupOf G_M
  let S_EM := IntermediateField.extendScalars h'
  let e_F : E ≃ₐ[F] S_EM :=
    { toFun := toExtendScalars F h'
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h').mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F S_EM := Module.Finite.equiv e_F.toLinearEquiv
  haveI : IsScalarTower F M S_EM := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M S_EM := Module.Finite.of_restrictScalars_finite F M S_EM
  letI : Fintype (S_EM →ₐ[M] AlgebraicClosure F) :=
    minpoly.AlgHom.fintype M S_EM (AlgebraicClosure F)
  let resMap : G_M ⧸ H_EM → (S_EM →ₐ[M] AlgebraicClosure F) := fun u =>
    { toFun := fun x => ((cosetRep u : G_M) : AbsGal F) x.1
      map_one' := map_one ((cosetRep u : G_M) : AbsGal F)
      map_mul' := fun x y => map_mul ((cosetRep u : G_M) : AbsGal F) x.1 y.1
      map_zero' := map_zero ((cosetRep u : G_M) : AbsGal F)
      map_add' := fun x y => map_add ((cosetRep u : G_M) : AbsGal F) x.1 y.1
      commutes' := fun r => (cosetRep u).2.2 r }
  have hinj : Function.Injective resMap := by
    intro u₁ u₂ h_eq
    let g₁ : G_M := cosetRep u₁
    let g₂ : G_M := cosetRep u₂
    have h_mem : g₁⁻¹ * g₂ ∈ H_EM := by
      rw [Subgroup.mem_subgroupOf]
      refine ⟨(g₁⁻¹ * g₂).2.1, ?_⟩
      intro y
      let y_E : S_EM := ⟨y.1, (IntermediateField.mem_extendScalars h').mpr y.2⟩
      have hy : (g₁ : AbsGal F) y.1 = (g₂ : AbsGal F) y.1 := AlgHom.congr_fun h_eq y_E
      change ((g₁ : AbsGal F)⁻¹ * (g₂ : AbsGal F)) y.1 = y.1
      rw [AlgEquiv.mul_apply, ← hy, ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
    have hq : (g₁ : G_M ⧸ H_EM) = (g₂ : G_M ⧸ H_EM) := QuotientGroup.eq.mpr h_mem
    have h1 : (g₁ : G_M ⧸ H_EM) = u₁ := Quotient.out_eq u₁
    have h2 : (g₂ : G_M ⧸ H_EM) = u₂ := Quotient.out_eq u₂
    rw [← h1, ← h2, hq]
  have hsurj : Function.Surjective resMap := by
    intro ι
    haveI : Normal M (AlgebraicClosure F) :=
      Normal.tower_top_of_normal F M (AlgebraicClosure F)
    obtain ⟨φ, hφ⟩ :=
      IsAlgClosed.surjective_restrictDomain_of_isAlgebraic
        (K := M) (L := S_EM) (M := AlgebraicClosure F) (E := AlgebraicClosure F) ι
    let σ_M : AlgebraicClosure F ≃ₐ[M] AlgebraicClosure F :=
      Normal.algHomEquivAut M (AlgebraicClosure F) (AlgebraicClosure F) φ
    let σ₀_sub := (IntermediateField.fixingSubgroupEquiv M).symm σ_M
    let σ₀ : AbsGal F := σ₀_sub.1
    have hσ₀_M : σ₀ ∈ M.fixingSubgroup := σ₀_sub.2
    have hσ_M_φ :
        (Normal.algHomEquivAut M (AlgebraicClosure F) (AlgebraicClosure F)).symm σ_M = φ :=
      (Normal.algHomEquivAut M (AlgebraicClosure F) (AlgebraicClosure F)).symm_apply_apply φ
    have hσ₀_ι : ∀ x : S_EM, σ₀ x.1 = ι x := by
      intro x
      have h1 : σ₀ x.1 = σ_M x.1 := rfl
      have h2 : σ_M x.1 =
          ((Normal.algHomEquivAut M (AlgebraicClosure F) (AlgebraicClosure F)).symm σ_M) x.1 := by
        rw [Normal.algHomEquivAut_symm_apply]
        rfl
      rw [h1, h2, hσ_M_φ, ← hφ]
      rfl
    obtain ⟨δ, k, hδ_fix, hδ_frob⟩ := hLift σ₀
    let w₀ : AbsGal F := σ₀ * δ
    have hw₀_M : w₀ ∈ M.fixingSubgroup :=
      Subgroup.mul_mem _ hσ₀_M (IntermediateField.fixingSubgroup_le h' hδ_fix)
    have hw₀_weil : w₀ ∈ weilGroup F := by
      apply Subgroup.subset_closure
      refine ⟨(k : ℤ), ?_⟩
      intro ζ hζ
      have hneg : (-(k : ℤ)).toNat = 0 :=
        Int.toNat_of_nonpos (Int.neg_nonpos_of_nonneg (Int.natCast_nonneg k))
      have hpos : (k : ℤ).toNat = k := Int.toNat_natCast k
      rw [hneg, hpos, pow_zero, pow_one]
      change σ₀ (δ ζ) = ζ ^ ((q F) ^ k)
      rw [hδ_frob ζ hζ, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    let w : G_M := ⟨w₀, hw₀_weil, hw₀_M⟩
    let u : G_M ⧸ H_EM := QuotientGroup.mk w
    refine ⟨u, ?_⟩
    have hout : ((cosetRep u : G_M) : G_M ⧸ H_EM) = u := Quotient.out_eq u
    have hrel : (cosetRep u)⁻¹ * w ∈ H_EM := QuotientGroup.eq.mp hout
    have hfix_E : ((cosetRep u : G_M) : AbsGal F)⁻¹ * w₀ ∈ E.fixingSubgroup := hrel.2
    ext x
    have hx_E : x.1 ∈ E := (IntermediateField.mem_extendScalars h').mp x.2
    have h_eq_x : ((cosetRep u : G_M) : AbsGal F) x.1 = w₀ x.1 := by
      have h1 := hfix_E ⟨x.1, hx_E⟩
      change (((cosetRep u : G_M) : AbsGal F)⁻¹ * w₀) x.1 = x.1 at h1
      have h2 := congr_arg ((cosetRep u : G_M) : AbsGal F) h1
      rw [AlgEquiv.mul_apply, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply] at h2
      exact h2.symm
    change ((cosetRep u : G_M) : AbsGal F) x.1 = ι x
    rw [h_eq_x]
    change σ₀ (δ x.1) = ι x
    have hδx : δ x.1 = x.1 := hδ_fix ⟨x.1, hx_E⟩
    rw [hδx, hσ₀_ι x]
  have hFin : Finite (G_M ⧸ H_EM) := Finite.of_injective resMap hinj
  refine ⟨hFin, ?_⟩
  let e_bij : (G_M ⧸ H_EM) ≃ (S_EM →ₐ[M] AlgebraicClosure F) :=
    Equiv.ofBijective resMap ⟨hinj, hsurj⟩
  rw [Nat.card_congr e_bij, Nat.card_eq_fintype_card,
    AlgHom.card M S_EM (AlgebraicClosure F)]

theorem ld_monomial_deg_eq_finrank (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    {V : Type u} [AddCommGroup V] [Module (Ω F) V]
    (σ : Representation (Ω F) (relWeil F M) V) (hσ : IsWeilRep F M σ)
    (D : List (MonomialTerm F M))
    (hD : IsMonomialDecomp F M (fun w => LinearMap.trace (Ω F) V (σ w)) D) :
    monomialListDeg F M D = (Module.finrank (Ω F) V : ℤ) :=
by
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  haveI : FiniteDimensional (Ω F) V := hσ.1
  have h1 : LinearMap.trace (Ω F) V (σ 1) = monomialListTrace F M D 1 := hD.2 1
  have hlhs : LinearMap.trace (Ω F) V (σ 1) = ((Module.finrank (Ω F) V : ℤ) : Ω F) := by
    rw [map_one, LinearMap.trace_one, Int.cast_natCast]
  have hrhs : ∀ (L : List (MonomialTerm F M)), (∀ t ∈ L, t.Wf F M) →
      monomialListTrace F M L 1 = ((monomialListDeg F M L : ℤ) : Ω F) := by
    intro L hLWf
    induction L with
    | nil =>
      simp [monomialListTrace, monomialListDeg]
    | cons t tl ih =>
      have ht : t.Wf F M := hLWf t (by simp)
      have htl : ∀ t' ∈ tl, t'.Wf F M := fun t' ht' => hLWf t' (by simp [ht'])
      haveI : FiniteDimensional F t.field := ht.1
      have hSep_t : Algebra.IsSeparable M (IntermediateField.extendScalars t.le) := ht.2.1
      obtain ⟨hFin_t, hCard_t⟩ :=
        ld_relWeil_quotient_card_eq_finrank F hp hFrob M t.field t.le hSep_t
      have htr_t := ld_indLM_charRep_trace_one_eq_card F M t.field t.le t.χ hFin_t
      rw [hCard_t] at htr_t
      have hterm : t.trace F M 1 = ((t.deg F M : ℤ) : Ω F) := by
        simp only [MonomialTerm.trace, MonomialTerm.deg]
        rw [htr_t, zsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
      have hih := ih htl
      simp only [monomialListTrace, monomialListDeg, List.map_cons, List.sum_cons] at hih ⊢
      rw [hterm, hih, Int.cast_add]
  have heq : ((monomialListDeg F M D : ℤ) : Ω F) = ((Module.finrank (Ω F) V : ℤ) : Ω F) := by
    rw [← hrhs D hD.1, ← h1, hlhs]
  exact Int.cast_injective heq

theorem ld_trace_exact_and_char (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      {V₁ V V₂ : Type u} [AddCommGroup V₁] [Module (Ω F) V₁] [AddCommGroup V] [Module (Ω F) V]
      [AddCommGroup V₂] [Module (Ω F) V₂]
      (σ₁ : Representation (Ω F) (relWeil F L) V₁) (σ : Representation (Ω F) (relWeil F L) V)
      (σ₂ : Representation (Ω F) (relWeil F L) V₂),
      IsWeilRep F L σ₁ → IsWeilRep F L σ → IsWeilRep F L σ₂ →
      ∀ (f : V₁ →ₗ[Ω F] V) (g : V →ₗ[Ω F] V₂),
        (∀ w, f ∘ₗ σ₁ w = σ w ∘ₗ f) → (∀ w, g ∘ₗ σ w = σ₂ w ∘ₗ g) →
        Function.Injective f → Function.Surjective g → LinearMap.range f = LinearMap.ker g →
        ∀ w : relWeil F L,
          LinearMap.trace (Ω F) V (σ w) =
            LinearMap.trace (Ω F) V₁ (σ₁ w) + LinearMap.trace (Ω F) V₂ (σ₂ w)) ∧
    (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (χ : relWeil F L →* (Ω F)ˣ), IsWeilRep F L (charRep F L χ) →
      IsMonomialDecomp F L (fun w => LinearMap.trace (Ω F) _ (charRep F L χ w))
        [⟨1, L, le_rfl, χ⟩]) ∧
    (∀ (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (h : L ≤ M), Algebra.IsSeparable L (IntermediateField.extendScalars h) →
      ∀ {V : Type u} [AddCommGroup V] [Module (Ω F) V]
        (σ : Representation (Ω F) (relWeil F M) V), IsWeilRep F M σ →
      ∀ (D : List (MonomialTerm F M)),
        IsMonomialDecomp F M (fun w => LinearMap.trace (Ω F) V (σ w)) D →
        IsMonomialDecomp F L (fun w => LinearMap.trace (Ω F) _ (indLM F h σ w))
          (D.map (MonomialTerm.restrict F h)) ∧
        monomialListDeg F M D = (Module.finrank (Ω F) V : ℤ)) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro L _ V₁ V V₂ _ _ _ _ _ _ σ₁ σ σ₂ hσ₁ hσ hσ₂ f g hf hg hinj hsurj hker w
    haveI : FiniteDimensional (Ω F) V₁ := hσ₁.1
    haveI : FiniteDimensional (Ω F) V := hσ.1
    haveI : FiniteDimensional (Ω F) V₂ := hσ₂.1
    obtain ⟨s, hs⟩ :=
      LinearMap.exists_rightInverse_of_surjective g (LinearMap.range_eq_top.mpr hsurj)
    have hmem : ∀ v : V, ((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ g) v ∈ LinearMap.range f := by
      intro v
      rw [hker, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, map_sub,
        ← LinearMap.comp_apply, ← LinearMap.comp_assoc, hs, LinearMap.id_comp, sub_self]
    let ef := LinearEquiv.ofInjective f hinj
    let p : V →ₗ[Ω F] V₁ :=
      ef.symm.toLinearMap ∘ₗ
        LinearMap.codRestrict (LinearMap.range f) ((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ g) hmem
    have hfp : f ∘ₗ p = (LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ g := by
      ext v
      change (ef (ef.symm ⟨((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ g) v, hmem v⟩)).1 =
        ((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ g) v
      rw [LinearEquiv.apply_symm_apply]
    have hpf : p ∘ₗ f = LinearMap.id := by
      ext x
      apply hinj
      have h1 : (f ∘ₗ p) (f x) = ((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ g) (f x) := by rw [hfp]
      have hgf : g (f x) = 0 := by
        rw [← LinearMap.mem_ker, ← hker]
        exact LinearMap.mem_range_self f x
      simpa [hgf] using h1
    have hfp_id : f ∘ₗ p + s ∘ₗ g = LinearMap.id := by
      rw [hfp, sub_add_cancel]
    have hdecomp : σ w = (f ∘ₗ σ₁ w) ∘ₗ p + (σ w ∘ₗ s) ∘ₗ g := by
      calc σ w = σ w ∘ₗ LinearMap.id := (LinearMap.comp_id _).symm
        _ = σ w ∘ₗ (f ∘ₗ p + s ∘ₗ g) := by rw [hfp_id]
        _ = (σ w ∘ₗ f) ∘ₗ p + (σ w ∘ₗ s) ∘ₗ g := by
          rw [LinearMap.comp_add, LinearMap.comp_assoc, LinearMap.comp_assoc]
        _ = (f ∘ₗ σ₁ w) ∘ₗ p + (σ w ∘ₗ s) ∘ₗ g := by rw [hf w]
    have htr1 : LinearMap.trace (Ω F) V ((f ∘ₗ σ₁ w) ∘ₗ p) = LinearMap.trace (Ω F) V₁ (σ₁ w) := by
      rw [LinearMap.trace_comp_comm', ← LinearMap.comp_assoc, hpf, LinearMap.id_comp]
    have htr2 : LinearMap.trace (Ω F) V ((σ w ∘ₗ s) ∘ₗ g) = LinearMap.trace (Ω F) V₂ (σ₂ w) := by
      rw [LinearMap.trace_comp_comm', ← LinearMap.comp_assoc, hg w, LinearMap.comp_assoc, hs,
        LinearMap.comp_id]
    rw [hdecomp, map_add, htr1, htr2]
  · intro L _ χ hχ
    refine ⟨?_, ?_⟩
    · intro t ht
      rw [List.mem_singleton] at ht
      subst ht
      refine ⟨‹FiniteDimensional F L›, ?_, hχ⟩
      refine ⟨fun x => ?_⟩
      let xL : L := ⟨x.1, (IntermediateField.mem_extendScalars (le_rfl : L ≤ L)).mp x.2⟩
      have hx : algebraMap L (IntermediateField.extendScalars (le_rfl : L ≤ L)) xL = x := rfl
      rw [← hx]
      exact isSeparable_algebraMap xL
    · intro w
      simp only [monomialListTrace, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
        add_zero, MonomialTerm.trace, one_smul]
      let G := relWeil F L
      let H := G.subgroupOf G
      let σ := charRep F L χ
      let e_sub := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F (le_rfl : L ≤ L))
      let ρ := σ.comp e_sub.toMonoidHom
      let e : indSpace H ρ ≃ₗ[Ω F] ULift.{u} (Ω F) :=
        { toFun := fun f => f.1 1
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl
          invFun := fun v => ⟨fun g => σ g v, fun h g => by
            change σ ((h : G) * g) v = σ (e_sub h) (σ g v)
            have he : e_sub h = (h : G) := rfl
            rw [he, map_mul, Module.End.mul_apply]⟩
          left_inv := fun f => Subtype.ext (funext fun g => by
            have hf := f.2 ⟨g, Subgroup.mem_subgroupOf.mpr g.2⟩ 1
            have he : e_sub ⟨g, Subgroup.mem_subgroupOf.mpr g.2⟩ = g := rfl
            change (σ g (f.1 1) : ULift.{u} (Ω F)) = f.1 g
            rw [← he]
            simpa [mul_one] using hf.symm)
          right_inv := fun v => by
            change σ 1 v = v
            rw [map_one]
            rfl }
      have hconj : e.conj (indLM F (le_rfl : L ≤ L) σ w) = σ w := by
        apply LinearMap.ext
        intro v
        change (e.symm v).1 (1 * w) = σ w v
        rw [one_mul]
        rfl
      have htr := LinearMap.trace_conj' (indLM F (le_rfl : L ≤ L) σ w) e
      rw [hconj] at htr
      exact htr
  · intro L M _ h hSep V _ _ σ hσ D hD
    refine ⟨⟨?_, fun w => ld_indLM_trace_decomp F L M h hSep σ hσ D hD w⟩,
      ld_monomial_deg_eq_finrank F M σ hσ D hD⟩
    intro t ht
    rw [List.mem_map] at ht
    rcases ht with ⟨t₀, ht₀, rfl⟩
    obtain ⟨hFin, hSepM, hWeil⟩ := hD.1 t₀ ht₀
    refine ⟨hFin, ?_, hWeil⟩
    letI algME : Algebra (IntermediateField.extendScalars h)
        (IntermediateField.extendScalars (h.trans t₀.le)) :=
      inferInstanceAs (Algebra M (IntermediateField.extendScalars t₀.le))
    letI : SMul (IntermediateField.extendScalars h)
        (IntermediateField.extendScalars (h.trans t₀.le)) :=
      algME.toSMul
    haveI : IsScalarTower L (IntermediateField.extendScalars h)
        (IntermediateField.extendScalars (h.trans t₀.le)) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.IsSeparable L (IntermediateField.extendScalars h) := hSep
    haveI : Algebra.IsSeparable (IntermediateField.extendScalars h)
        (IntermediateField.extendScalars (h.trans t₀.le)) := hSepM
    exact Algebra.IsSeparable.trans L (IntermediateField.extendScalars h)
      (IntermediateField.extendScalars (h.trans t₀.le))

theorem ld_irreducible_weil_rep_untwist (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] {V : Type u} [AddCommGroup V] [Module (Ω F) V] [Nontrivial V]
    (σ : Representation (Ω F) (relWeil F L) V) (hσ : IsWeilRep F L σ)
    (h_irr : ∀ W : Submodule (Ω F) V,
      (∀ w : relWeil F L, W ≤ Submodule.comap (σ w) W) → W = ⊥ ∨ W = ⊤) :
    ∃ (K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
      (_ : FiniteDimensional F K) (_ : IsGalois L (IntermediateField.extendScalars hLK))
      (G₀ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
      (π : relWeil F L →* G₀)
      (ω : relWeil F L →* (Ω F)ˣ)
      (bar_σ : Representation (Ω F) G₀ V),
      (∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
        (((π w : G₀) : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) x : AlgebraicClosure F) =
          (w : AbsGal F) (x : AlgebraicClosure F)) ∧
      Function.Surjective π ∧
      (∀ w : relWeil F L, (w : AbsGal F) ∈ inertia F → ω w = 1) ∧
      (∀ w : relWeil F L, σ w = (ω w : Ω F) • bar_σ (π w)) :=
by
  
  have h_gal_closure : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (E₁ : IntermediateField k Ω_bar) [FiniteDimensional k E₁],
      ∃ (K' : IntermediateField k Ω_bar),
        FiniteDimensional k K' ∧ IsGalois k K' ∧
        ∀ x ∈ E₁, ∃ n : ℕ, x ^ (ringExpChar Ω_bar ^ n) ∈ K' := by
    intro k Ω_bar _ _ _ _ E₁ _
    let N : IntermediateField k Ω_bar := IntermediateField.normalClosure k E₁ Ω_bar
    haveI : Normal k N := normalClosure.normal k E₁ Ω_bar
    haveI : FiniteDimensional k N := normalClosure.is_finiteDimensional k E₁ Ω_bar
    have hE₁_le_N : E₁ ≤ N := IntermediateField.le_normalClosure E₁
    let K_sep : IntermediateField k N := separableClosure k N
    haveI : IsGalois k K_sep := separableClosure.isGalois k N
    let K' : IntermediateField k Ω_bar := K_sep.map N.val
    let e_K : ↥K_sep ≃ₐ[k] ↥K' := K_sep.equivMap N.val
    have hGal : IsGalois k K' := IsGalois.of_algEquiv e_K
    have hK'N : K' ≤ N := by
      rintro x ⟨z, _, rfl⟩
      exact z.2
    have hFinK' : FiniteDimensional k K' :=
      FiniteDimensional.of_injective (IntermediateField.inclusion hK'N).toLinearMap
        (IntermediateField.inclusion hK'N).injective
    refine ⟨K', hFinK', hGal, ?_⟩
    haveI : Algebra.IsAlgebraic k N := Algebra.IsAlgebraic.of_finite k N
    haveI : IsPurelyInseparable K_sep N := separableClosure.isPurelyInseparable k N
    intro x hxE₁
    let x_N : N := ⟨x, hE₁_le_N hxE₁⟩
    let q := ringExpChar Ω_bar
    haveI : ExpChar K_sep q :=
      RingHom.expChar (N.val.comp K_sep.val).toRingHom (N.val.comp K_sep.val).injective q
    obtain ⟨n, y, hy⟩ := IsPurelyInseparable.pow_mem K_sep q x_N
    refine ⟨n, ?_⟩
    have hy_val : x ^ (q ^ n) = N.val (K_sep.val y) := (congr_arg N.val hy).symm
    rw [hy_val]
    exact ⟨K_sep.val y, y.2, rfl⟩
  have h_krull_galois : ∀ (U : Set (AbsGal F)), U ∈ nhds (1 : AbsGal F) →
      ∃ (K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
        (_ : FiniteDimensional F K) (_ : IsGalois L (IntermediateField.extendScalars hLK)),
        (K.fixingSubgroup : Set (AbsGal F)) ⊆ U := by
    intro U hU
    rw [krullTopology_mem_nhds_one_iff] at hU
    rcases hU with ⟨K₀, hFinK₀, hK₀_sub⟩
    haveI : FiniteDimensional F K₀ := hFinK₀
    let K₁ : IntermediateField F (AlgebraicClosure F) := L ⊔ K₀
    have hLK₁ : L ≤ K₁ := le_sup_left
    have hK₀K₁ : K₀ ≤ K₁ := le_sup_right
    haveI : FiniteDimensional F K₁ := IntermediateField.finiteDimensional_sup L K₀
    let E₁ : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK₁
    have hFinE₁ : FiniteDimensional L E₁ := by
      haveI : FiniteDimensional F E₁ := ‹FiniteDimensional F K₁›
      exact FiniteDimensional.right F L E₁
    haveI : FiniteDimensional L E₁ := hFinE₁
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    obtain ⟨K', hFinK', hGalK', hK'_pow⟩ := h_gal_closure L (AlgebraicClosure F) E₁
    let K : IntermediateField F (AlgebraicClosure F) := K'.restrictScalars F
    have hLK : L ≤ K := fun x hx => K'.algebraMap_mem ⟨x, hx⟩
    haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) := hFinK'
    have hFinK : FiniteDimensional F K :=
      FiniteDimensional.trans F L (IntermediateField.extendScalars hLK)
    refine ⟨K, hLK, hFinK, hGalK', ?_⟩
    intro g hg
    apply hK₀_sub
    rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff] at hg ⊢
    intro x hx
    have hxE₁ : x ∈ E₁ := (IntermediateField.mem_extendScalars hLK₁).mpr (hK₀K₁ hx)
    obtain ⟨n, hxn⟩ := hK'_pow x hxE₁
    have hg_pow : g (x ^ (ringExpChar (AlgebraicClosure F) ^ n)) =
        x ^ (ringExpChar (AlgebraicClosure F) ^ n) := hg _ hxn
    rw [map_pow] at hg_pow
    have h_sub : (g x - x) ^ (ringExpChar (AlgebraicClosure F) ^ n) = 0 := by
      rw [sub_pow_expChar_pow, hg_pow, sub_self]
    exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero h_sub)
  
  have h_absGal_comm : ∀ a b : AbsGal F, a * b * a⁻¹ * b⁻¹ ∈ inertia F := by
    have h_comm_root : ∀ (n : ℕ), 0 < n → ∀ (f₁ f₂ : AbsGal F) (z : AlgebraicClosure F),
        z ^ n = 1 → f₁ (f₂ z) = f₂ (f₁ z) := by
      intro n hn f₁ f₂ z hz
      haveI : NeZero n := ⟨hn.ne'⟩
      obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := rootsOfUnity n (AlgebraicClosure F))
      have h_pow : ∀ w : AlgebraicClosure F, w ^ n = 1 →
          ∃ m : ℕ, w = ((g₀ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ m := by
        intro w hw
        have hw0 : w ≠ 0 := by
          intro h0
          rw [h0, zero_pow hn.ne'] at hw
          exact zero_ne_one hw
        let uw : (AlgebraicClosure F)ˣ := Units.mk0 w hw0
        have huw : uw ∈ rootsOfUnity n (AlgebraicClosure F) := by
          rw [mem_rootsOfUnity]
          ext
          simp [uw, hw]
        obtain ⟨m, hm⟩ := hg₀ ⟨uw, huw⟩
        refine ⟨m, ?_⟩
        have hm' := congr_arg
          (fun u : rootsOfUnity n (AlgebraicClosure F) => ((u : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)) hm
        simpa [uw] using hm'.symm
      let ζ₀ : AlgebraicClosure F := ((g₀ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)
      have hζ₀ : ζ₀ ^ n = 1 := by
        have h1 : (g₀ : (AlgebraicClosure F)ˣ) ^ n = 1 := (mem_rootsOfUnity n _).mp g₀.2
        simpa [ζ₀, Units.val_pow_eq_pow_val] using congr_arg Units.val h1
      have hf₁ζ₀ : (f₁ ζ₀) ^ n = 1 := by rw [← map_pow, hζ₀, map_one]
      have hf₂ζ₀ : (f₂ ζ₀) ^ n = 1 := by rw [← map_pow, hζ₀, map_one]
      obtain ⟨j, hj⟩ := h_pow (f₁ ζ₀) hf₁ζ₀
      obtain ⟨k, hk⟩ := h_pow (f₂ ζ₀) hf₂ζ₀
      obtain ⟨m, hm⟩ := h_pow z hz
      change f₁ ζ₀ = ζ₀ ^ j at hj
      change f₂ ζ₀ = ζ₀ ^ k at hk
      change z = ζ₀ ^ m at hm
      calc f₁ (f₂ z) = f₁ (f₂ (ζ₀ ^ m)) := by rw [hm]
        _ = f₁ ((f₂ ζ₀) ^ m) := by rw [map_pow]
        _ = f₁ ((ζ₀ ^ k) ^ m) := by rw [hk]
        _ = (f₁ ζ₀) ^ (k * m) := by rw [← pow_mul, map_pow]
        _ = (ζ₀ ^ j) ^ (k * m) := by rw [hj]
        _ = ζ₀ ^ (j * (k * m)) := by rw [← pow_mul]
        _ = ζ₀ ^ (k * (j * m)) := by rw [mul_left_comm]
        _ = (ζ₀ ^ k) ^ (j * m) := by rw [pow_mul]
        _ = (f₂ ζ₀) ^ (j * m) := by rw [← hk]
        _ = f₂ ((ζ₀ ^ j) ^ m) := by rw [← map_pow, pow_mul]
        _ = f₂ ((f₁ ζ₀) ^ m) := by rw [← hj]
        _ = f₂ (f₁ (ζ₀ ^ m)) := by rw [← map_pow]
        _ = f₂ (f₁ z) := by rw [← hm]
    intro a b
    unfold inertia unramifiedClosure
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy =>
      rcases hy with ⟨n, hn, _, hyn⟩
      let z := a⁻¹ (b⁻¹ y)
      have hz : z ^ n = 1 := by
        simp only [z, ← map_pow, hyn, map_one]
      have h1 : a (b z) = b (a z) := h_comm_root n hn a b z hz
      change a (b z) = y
      rw [h1]
      simp [z]
    | algebraMap y =>
      exact (a * b * a⁻¹ * b⁻¹).commutes y
    | add y z _ _ hy hz =>
      rw [map_add, hy, hz]
    | inv y _ hy =>
      rw [map_inv₀, hy]
    | mul y z _ _ hy hz =>
      rw [map_mul, hy, hz]
  
  haveI : FiniteDimensional (Ω F) V := hσ.1
  rcases hσ.2 with ⟨U, hU_nhds, hU_triv⟩
  obtain ⟨K, hLK, hFinK, hGal, hK_sub⟩ := h_krull_galois U hU_nhds
  haveI : FiniteDimensional F K := hFinK
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  haveI : IsGalois L K' := hGal
  haveI : Normal L K' := IsGalois.to_normal
  let res : relWeil F L →* (K' ≃ₐ[L] K') :=
    (AlgEquiv.restrictNormalHom K').comp
      ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
        (Subgroup.inclusion (inf_le_right : relWeil F L ≤ L.fixingSubgroup)))
  have h_res_apply : ∀ (w : relWeil F L) (x : K'),
      ((res w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) := by
    intro w x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv L) ⟨w.1, w.2.2⟩) x : K') : AlgebraicClosure F) =
      (w : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  let G₀ : Subgroup (K' ≃ₐ[L] K') := res.range
  let π : relWeil F L →* G₀ := res.rangeRestrict
  have hsurj : Function.Surjective π := res.rangeRestrict_surjective
  let N : Subgroup (relWeil F L) := res.ker
  let I : Subgroup (relWeil F L) := (inertia F).subgroupOf (relWeil F L)
  have hN_le_U : ∀ w ∈ N, (w : AbsGal F) ∈ U := by
    intro w hw
    apply hK_sub
    rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
    have h1 : ((res w x : K') : AlgebraicClosure F) = (w : AbsGal F) z := h_res_apply w x
    have h2 : res w = 1 := hw
    rw [← h1, h2]
    rfl
  have h_comm : ∀ (g : relWeil F L) (n : N),
      σ g * σ (n : relWeil F L) = σ (n : relWeil F L) * σ g := by
    intro g n
    let u : relWeil F L := g * (n : relWeil F L) * g⁻¹ * (n : relWeil F L)⁻¹
    have hu_N : u ∈ N :=
      N.mul_mem (res.normal_ker.conj_mem (n : relWeil F L) n.2 g) (N.inv_mem n.2)
    have hu_U : (u : AbsGal F) ∈ U := hN_le_U u hu_N
    have hu_I : (u : AbsGal F) ∈ inertia F := h_absGal_comm g.1 (n : relWeil F L).1
    have hσu : σ u = 1 := hU_triv u hu_U hu_I
    have h_grp : u * (n : relWeil F L) * g = g * (n : relWeil F L) := by
      dsimp [u]
      group
    have h_map := congr_arg σ h_grp
    rw [map_mul, map_mul, hσu, one_mul, map_mul] at h_map
    exact h_map.symm
  
  have h_scal : ∀ n : N, ∃ c : Ω F, σ (n : relWeil F L) = c • (1 : V →ₗ[Ω F] V) := by
    intro n
    obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue (σ (n : relWeil F L))
    obtain ⟨v, hv_mem, hv_ne⟩ := hc.exists_hasEigenvector
    have hW_ne_bot : Module.End.eigenspace (σ (n : relWeil F L)) c ≠ ⊥ := by
      intro hbot
      change v ∈ Module.End.eigenspace (σ (n : relWeil F L)) c at hv_mem
      rw [hbot] at hv_mem
      exact hv_ne hv_mem
    have hW_inv : ∀ g : relWeil F L, Module.End.eigenspace (σ (n : relWeil F L)) c ≤
        Submodule.comap (σ g) (Module.End.eigenspace (σ (n : relWeil F L)) c) := by
      intro g x hx
      rw [Submodule.mem_comap, Module.End.mem_eigenspace_iff]
      rw [Module.End.mem_eigenspace_iff] at hx
      have h1 : (σ (n : relWeil F L) * σ g) x = (σ g * σ (n : relWeil F L)) x := by
        rw [h_comm g n]
      change σ (n : relWeil F L) (σ g x) = σ g (σ (n : relWeil F L) x) at h1
      rw [h1, hx, map_smul]
    have hW_top : Module.End.eigenspace (σ (n : relWeil F L)) c = ⊤ :=
      (h_irr _ hW_inv).resolve_left hW_ne_bot
    refine ⟨c, LinearMap.ext fun x => ?_⟩
    have hx : x ∈ Module.End.eigenspace (σ (n : relWeil F L)) c :=
      hW_top.symm ▸ Submodule.mem_top
    rw [Module.End.mem_eigenspace_iff] at hx
    simpa using hx
  choose c hc using h_scal
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
  have h_inj : ∀ a b : Ω F, a • (1 : V →ₗ[Ω F] V) = b • (1 : V →ₗ[Ω F] V) → a = b := by
    intro a b hab
    have h1 := LinearMap.congr_fun hab v₀
    simp only [LinearMap.smul_apply, Module.End.one_apply] at h1
    have h2 : (a - b) • v₀ = 0 := by rw [sub_smul, h1, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h2).resolve_right hv₀)
  have hc_one : c 1 = 1 := by
    apply h_inj
    rw [← hc 1, Subgroup.coe_one, map_one, one_smul]
  have hc_mul : ∀ n₁ n₂ : N, c (n₁ * n₂) = c n₁ * c n₂ := by
    intro n₁ n₂
    apply h_inj
    rw [← hc (n₁ * n₂), Subgroup.coe_mul, map_mul, hc n₁, hc n₂, smul_mul_smul_comm, mul_one]
  let χ : N →* (Ω F)ˣ :=
    { toFun := fun n =>
        { val := c n
          inv := c n⁻¹
          val_inv := by rw [← hc_mul, mul_inv_cancel, hc_one]
          inv_val := by rw [← hc_mul, inv_mul_cancel, hc_one] }
      map_one' := Units.ext hc_one
      map_mul' := fun n₁ n₂ => Units.ext (hc_mul n₁ n₂) }
  have hχ_I : ∀ n : N, (n : relWeil F L) ∈ I → χ n = 1 := by
    intro n hnI
    have hσn : σ (n : relWeil F L) = 1 :=
      hU_triv (n : relWeil F L) (hN_le_U (n : relWeil F L) n.2) hnI
    apply Units.ext
    apply h_inj
    change c n • (1 : V →ₗ[Ω F] V) = (1 : Ω F) • (1 : V →ₗ[Ω F] V)
    rw [← hc n, hσn, one_smul]
  
  have h_comm_I : ∀ a b : relWeil F L, a * b * a⁻¹ * b⁻¹ ∈ I :=
    fun a b => h_absGal_comm a.1 b.1
  haveI : I.Normal := ⟨fun g hg i => by
    have h1 : i * g * i⁻¹ * g⁻¹ ∈ I := h_comm_I i g
    have h2 : (i * g * i⁻¹ * g⁻¹) * g = i * g * i⁻¹ := by group
    rw [← h2]
    exact I.mul_mem h1 hg⟩
  let Γ := relWeil F L ⧸ I
  let π_I : relWeil F L →* Γ := QuotientGroup.mk' I
  have hΓ_comm : ∀ x y : Γ, x * y = y * x := by
    intro x y
    refine QuotientGroup.induction_on x fun a => QuotientGroup.induction_on y fun b => ?_
    change π_I a * π_I b = π_I b * π_I a
    have h1 : π_I (a * b * a⁻¹ * b⁻¹) = 1 := (QuotientGroup.eq_one_iff _).mpr (h_comm_I a b)
    rw [map_mul, map_mul, map_mul, map_inv, map_inv] at h1
    exact mul_inv_eq_one.mp (by
      calc (π_I a * π_I b) * (π_I b * π_I a)⁻¹
          = π_I a * π_I b * (π_I a)⁻¹ * (π_I b)⁻¹ := by group
        _ = 1 := h1)
  letI : CommGroup Γ := { (inferInstance : Group Γ) with mul_comm := hΓ_comm }
  let φ : N →* Γ := π_I.comp N.subtype
  let M : Subgroup Γ := φ.range
  have h_ker_φ : φ.ker ≤ χ.ker := by
    intro n hn
    rw [MonoidHom.mem_ker] at hn ⊢
    have hnI : (n : relWeil F L) ∈ I := (QuotientGroup.eq_one_iff (n : relWeil F L)).mp hn
    exact hχ_I n hnI
  let bar_χ : M →* (Ω F)ˣ :=
    (QuotientGroup.lift φ.ker χ h_ker_φ).comp
      (QuotientGroup.quotientKerEquivRange φ).symm.toMonoidHom
  have h_bar_χ : ∀ n : N, bar_χ (φ.rangeRestrict n) = χ n := by
    intro n
    have h1 : (QuotientGroup.quotientKerEquivRange φ).symm (φ.rangeRestrict n) =
        (n : N ⧸ φ.ker) := by
      apply (QuotientGroup.quotientKerEquivRange φ).injective
      simp
      rfl
    change (QuotientGroup.lift φ.ker χ h_ker_φ)
      ((QuotientGroup.quotientKerEquivRange φ).symm (φ.rangeRestrict n)) = χ n
    rw [h1]
    rfl
  letI : DivisibleBy (Additive (Ω F)ˣ) ℕ :=
    { div := fun x n =>
        if hn : n = 0 then 0
        else
          let hpos : 0 < n := Nat.pos_of_ne_zero hn
          let z := (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val hpos).choose
          have hz_pow : z ^ n = (Additive.toMul x).val :=
            (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val hpos).choose_spec
          have hz_ne : z ≠ 0 := by
            intro h0
            have h1 : z ^ n = 0 := h0.symm ▸ zero_pow hn
            rw [hz_pow] at h1
            exact (Units.ne_zero (Additive.toMul x)) h1
          Additive.ofMul (Units.mk0 z hz_ne)
      div_zero := fun x => dif_pos rfl
      div_cancel := fun {n} x hn => by
        dsimp only
        rw [dif_neg hn]
        apply Additive.toMul.injective
        rw [toMul_nsmul, toMul_ofMul]
        ext
        rw [Units.val_pow_eq_pow_val, Units.val_mk0]
        exact (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val
          (Nat.pos_of_ne_zero hn)).choose_spec }
  letI : DivisibleBy (Additive (Ω F)ˣ) ℤ :=
    AddGroup.divisibleByIntOfDivisibleByNat (Additive (Ω F)ˣ)
  have hBaer : Module.Baer ℤ (Additive (Ω F)ˣ) := Module.Baer.of_divisible (Additive (Ω F)ˣ)
  let f_add : Additive M →+ Additive Γ := MonoidHom.toAdditive M.subtype
  let g_add : Additive M →+ Additive (Ω F)ˣ := MonoidHom.toAdditive bar_χ
  have hf_inj : Function.Injective f_add := M.subtype_injective
  obtain ⟨h_add, hh_add⟩ := hBaer.extension_property_addMonoidHom f_add hf_inj g_add
  let bar_ω : Γ →* (Ω F)ˣ := MonoidHom.toAdditive.symm h_add
  let ω : relWeil F L →* (Ω F)ˣ := bar_ω.comp π_I
  have hω_I : ∀ w : relWeil F L, (w : AbsGal F) ∈ inertia F → ω w = 1 := by
    intro w hw
    change bar_ω (π_I w) = 1
    have h1 : π_I w = 1 := (QuotientGroup.eq_one_iff w).mpr hw
    rw [h1, map_one]
  have hω_N : ∀ n : N, ω (n : relWeil F L) = χ n := by
    intro n
    change bar_ω (φ n) = χ n
    have h1 : φ n = M.subtype (φ.rangeRestrict n) := rfl
    rw [h1]
    have h2 : bar_ω (M.subtype (φ.rangeRestrict n)) = bar_χ (φ.rangeRestrict n) :=
      DFunLike.congr_fun hh_add (Additive.ofMul (φ.rangeRestrict n))
    rw [h2, h_bar_χ n]
  
  let σ' : Representation (Ω F) (relWeil F L) V :=
    { toFun := fun w => ((ω w)⁻¹ : (Ω F)ˣ).val • σ w
      map_one' := by simp
      map_mul' := fun w₁ w₂ => by
        ext x
        simp only [map_mul, mul_inv_rev, Units.val_mul, Module.End.mul_apply,
          LinearMap.smul_apply, smul_smul, map_smul] }
  have h_ker_le : res.ker ≤ σ'.ker := by
    intro w hw
    rw [MonoidHom.mem_ker]
    change ((ω w)⁻¹ : (Ω F)ˣ).val • σ w = 1
    have hwN : w ∈ N := hw
    have h1 : ω w = χ ⟨w, hwN⟩ := hω_N ⟨w, hwN⟩
    have h2 : σ w = (χ ⟨w, hwN⟩ : Ω F) • (1 : V →ₗ[Ω F] V) := hc ⟨w, hwN⟩
    rw [h1, h2, smul_smul, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul]
  let bar_σ : Representation (Ω F) G₀ V :=
    (QuotientGroup.lift res.ker σ' h_ker_le).comp
      (QuotientGroup.quotientKerEquivRange res).symm.toMonoidHom
  refine ⟨K, hLK, hFinK, hGal, G₀, π, ω, bar_σ, h_res_apply, hsurj, hω_I, ?_⟩
  intro w
  have h_bar_σ : bar_σ (π w) = σ' w := by
    have h1 : (QuotientGroup.quotientKerEquivRange res).symm (π w) =
        (w : relWeil F L ⧸ res.ker) := by
      apply (QuotientGroup.quotientKerEquivRange res).injective
      simp [π]
      rfl
    change (QuotientGroup.lift res.ker σ' h_ker_le)
      ((QuotientGroup.quotientKerEquivRange res).symm (π w)) = σ' w
    rw [h1]
    rfl
  rw [h_bar_σ]
  change σ w = (ω w : Ω F) • (((ω w)⁻¹ : (Ω F)ˣ).val • σ w)
  rw [smul_smul, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_smul]

theorem ld_indCharTrace_one_eq_fixedCosetCount (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (H : Subgroup G) (g : G) :
    indCharTrace F H 1 g = (fixedCosetCount H g : Ω F) :=
by
  let u_G : G → (G ⧸ H) := fun x => QuotientGroup.mk x⁻¹
  let r_G : G → G := fun x => cosetRep (u_G x)
  have h_xr_G : ∀ x : G, x * r_G x ∈ H := by
    intro x
    have hq : (QuotientGroup.mk (cosetRep (u_G x)) : G ⧸ H) = QuotientGroup.mk x⁻¹ :=
      Quotient.out_eq (u_G x)
    rw [QuotientGroup.eq] at hq
    have h_inv := H.inv_mem hq
    have h_eq : ((cosetRep (u_G x))⁻¹ * x⁻¹)⁻¹ = x * r_G x := by
      dsimp [r_G]
      group
    rwa [h_eq] at h_inv
  have hu_mul_G : ∀ (y : H) (x : G), u_G ((y : G) * x) = u_G x := by
    intro y x
    dsimp [u_G]
    rw [QuotientGroup.eq]
    have h_eq : (((y : G) * x)⁻¹)⁻¹ * x⁻¹ = (y : G) := by
      rw [inv_inv, mul_inv_cancel_right]
    rw [h_eq]
    exact y.2
  have hr_mul_G : ∀ (y : H) (x : G), r_G ((y : G) * x) = r_G x := by
    intro y x
    exact congr_arg cosetRep (hu_mul_G y x)
  have hu_rep_G : ∀ u₀ : G ⧸ H, u_G (cosetRep u₀)⁻¹ = u₀ := by
    intro u₀
    dsimp [u_G]
    rw [inv_inv]
    exact Quotient.out_eq u₀
  have hr_rep_G : ∀ u₀ : G ⧸ H, r_G (cosetRep u₀)⁻¹ = cosetRep u₀ := by
    intro u₀
    exact congr_arg cosetRep (hu_rep_G u₀)
  let e_coset : (G ⧸ H) × H ≃ G :=
    { toFun := fun p => (p.2 : G) * (cosetRep p.1)⁻¹
      invFun := fun x => (u_G x, ⟨x * r_G x, h_xr_G x⟩)
      left_inv := by
        rintro ⟨u₀, y⟩
        ext
        · dsimp
          rw [hu_mul_G, hu_rep_G]
        · dsimp
          rw [hr_mul_G, hr_rep_G, mul_assoc, inv_mul_cancel, mul_one]
      right_inv := by
        intro x
        dsimp [r_G]
        exact mul_inv_cancel_right x (cosetRep (u_G x)) }
  have h_fiber : ∀ (u₀ : G ⧸ H) (y : H),
      (if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ H then
        (((1 : H →* (Ω F)ˣ) ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : (Ω F)ˣ) : Ω F)
      else 0) = if g • u₀ = u₀ then (1 : Ω F) else 0 := by
    intro u₀ y
    let c : G := (cosetRep u₀)⁻¹ * g * cosetRep u₀
    have h_conj_eq : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ = (y : G) * c * (y : G)⁻¹ := by
      dsimp [e_coset, c]
      group
    have hc_iff : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ H ↔ c ∈ H := by
      rw [h_conj_eq]
      constructor
      · intro h_mem
        have h1 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) ∈ H :=
          H.mul_mem (H.mul_mem (H.inv_mem y.2) h_mem) y.2
        have h2 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) = c := by group
        rwa [h2] at h1
      · intro hc
        exact H.mul_mem (H.mul_mem y.2 hc) (H.inv_mem y.2)
    have hu₀_iff : c ∈ H ↔ g • u₀ = u₀ := by
      have h_out : (QuotientGroup.mk (cosetRep u₀) : G ⧸ H) = u₀ := Quotient.out_eq u₀
      have h_smul : g • (QuotientGroup.mk (cosetRep u₀) : G ⧸ H) =
          QuotientGroup.mk (g * cosetRep u₀) := rfl
      rw [← h_out, h_smul, eq_comm, QuotientGroup.eq]
      dsimp [c]
      rw [mul_assoc]
    have hx_iff : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ H ↔ g • u₀ = u₀ :=
      hc_iff.trans hu₀_iff
    by_cases hfix : g • u₀ = u₀
    · have hx : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ H := hx_iff.mpr hfix
      rw [dif_pos hx, if_pos hfix]
      simp
    · have hx : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∉ H := fun h => hfix (hx_iff.mp h)
      rw [dif_neg hx, if_neg hfix]
  have h_sum_G : (∑ x : G,
      if h : x * g * x⁻¹ ∈ H then
        (((1 : H →* (Ω F)ˣ) ⟨x * g * x⁻¹, h⟩ : (Ω F)ˣ) : Ω F)
      else 0) = (Nat.card H : Ω F) * ∑ u₀ : G ⧸ H, (if g • u₀ = u₀ then (1 : Ω F) else 0) := by
    rw [← Fintype.sum_equiv e_coset _ _ (fun _ => rfl), Fintype.sum_prod_type]
    have h_inner : ∀ u₀ : G ⧸ H,
        (∑ y : H,
          if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ H then
            (((1 : H →* (Ω F)ˣ) ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : (Ω F)ˣ) : Ω F)
          else 0) = (Nat.card H : Ω F) * (if g • u₀ = u₀ then (1 : Ω F) else 0) := by
      intro u₀
      rw [Finset.sum_congr rfl (fun y _ => h_fiber u₀ y)]
      rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
    rw [Finset.sum_congr rfl (fun u₀ _ => h_inner u₀), ← Finset.mul_sum]
  unfold indCharTrace fixedCosetCount
  rw [h_sum_G]
  have h_card_pos : 0 < Nat.card H := Nat.card_pos
  have h_card_ne : (Nat.card H : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_pos.ne'
  rw [inv_mul_cancel_left₀ h_card_ne]
  rw [Finset.sum_boole]
  rw [← Fintype.card_subtype (fun u₀ : G ⧸ H => g • u₀ = u₀)]
  rw [← Nat.card_eq_fintype_card]
  exact (Int.cast_natCast (Nat.card {u : G ⧸ H | g • u = u})).symm

theorem ld_inQESpan_subring (G : Type u) [Group G] [Fintype G] :
    InQESpan (0 : G → ℤ) ∧
    (∀ (H : Subgroup G), IsQuasiElementary H → InQESpan (fixedCosetCount H)) ∧
    (∀ (c : ℤ) (f : G → ℤ), InQESpan f → InQESpan (fun g => c * f g)) ∧
    (∀ (f₁ f₂ : G → ℤ), InQESpan f₁ → InQESpan f₂ → InQESpan (fun g => f₁ g + f₂ g)) ∧
    (∀ (f₁ f₂ : G → ℤ), InQESpan f₁ → InQESpan f₂ → InQESpan (fun g => f₁ g - f₂ g)) ∧
    (∀ (f₁ f₂ : G → ℤ), InQESpan f₁ → InQESpan f₂ → InQESpan (fun g => f₁ g * f₂ g)) :=
by
  have h_zero : InQESpan (0 : G → ℤ) :=
    ⟨[], ⟨by simp, fun g => by simp⟩⟩
  have h_gen : ∀ (H : Subgroup G), IsQuasiElementary H → InQESpan (fixedCosetCount H) := by
    intro H hH
    refine ⟨[((1 : ℤ), H)], ⟨?_, ?_⟩⟩
    · intro p hp
      simp only [List.mem_singleton] at hp
      subst hp
      exact hH
    · intro g
      simp
  have h_list_smul : ∀ (c : ℤ) (L : List (ℤ × Subgroup G)) (g : G),
      ((L.map fun p => (c * p.1, p.2)).map fun q => q.1 * fixedCosetCount q.2 g).sum =
        c * (L.map fun p => p.1 * fixedCosetCount p.2 g).sum := by
    intro c L g
    induction L with
    | nil => simp
    | cons hd tl ih =>
      simp only [List.map_cons, List.sum_cons]
      rw [ih]
      ring
  have h_smul : ∀ (c : ℤ) (f : G → ℤ), InQESpan f → InQESpan (fun g => c * f g) := by
    intro c f ⟨L, hL_wf, hL_sum⟩
    refine ⟨L.map fun p => (c * p.1, p.2), ⟨?_, ?_⟩⟩
    · intro q hq
      rcases List.mem_map.mp hq with ⟨p, hp, rfl⟩
      exact hL_wf p hp
    · intro g
      rw [h_list_smul c L g, hL_sum g]
  have h_add : ∀ (f₁ f₂ : G → ℤ), InQESpan f₁ → InQESpan f₂ → InQESpan (fun g => f₁ g + f₂ g) := by
    intro f₁ f₂ ⟨L₁, hL₁_wf, hL₁_sum⟩ ⟨L₂, hL₂_wf, hL₂_sum⟩
    refine ⟨L₁ ++ L₂, ⟨?_, ?_⟩⟩
    · intro p hp
      rcases List.mem_append.mp hp with hp | hp
      · exact hL₁_wf p hp
      · exact hL₂_wf p hp
    · intro g
      rw [List.map_append, List.sum_append, hL₁_sum g, hL₂_sum g]
  have h_sub : ∀ (f₁ f₂ : G → ℤ), InQESpan f₁ → InQESpan f₂ → InQESpan (fun g => f₁ g - f₂ g) := by
    intro f₁ f₂ hf₁ hf₂
    have h_eq : (fun g => f₁ g - f₂ g) = (fun g => f₁ g + (-1 : ℤ) * f₂ g) := by
      funext g
      ring
    rw [h_eq]
    exact h_add f₁ (fun g => (-1 : ℤ) * f₂ g) hf₁ (h_smul (-1) f₂ hf₂)
  have h_qe_of_inj : ∀ {H₁ K : Subgroup G}, IsQuasiElementary H₁ →
      ∀ (e : K →* H₁), Function.Injective e → IsQuasiElementary K := by
    intro H₁ K ⟨p, C, hp, hC_norm, hC_cyc, hP⟩ e he
    let C_K : Subgroup K := C.comap e
    haveI : C_K.Normal := Subgroup.normal_comap e
    let e_C : C_K →* C :=
      { toFun := fun x => ⟨e x.1, x.2⟩
        map_one' := Subtype.ext (map_one e)
        map_mul' := fun x y => Subtype.ext (map_mul e x.1 y.1) }
    have he_C : Function.Injective e_C := by
      intro x y hxy
      apply Subtype.ext
      apply he
      exact congrArg Subtype.val hxy
    have hCK_cyc : IsCyclic C_K := @isCyclic_of_injective _ _ _ _ hC_cyc e_C he_C
    let φ : K →* (H₁ ⧸ C) := (QuotientGroup.mk' C).comp e
    have hker : C_K = φ.ker := by
      ext x
      simp only [C_K, φ, Subgroup.mem_comap, MonoidHom.mem_ker, MonoidHom.comp_apply,
        QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    let ψ : (K ⧸ C_K) →* (H₁ ⧸ C) :=
      (QuotientGroup.kerLift φ).comp (QuotientGroup.quotientMulEquivOfEq hker).toMonoidHom
    have hψ_inj : Function.Injective ψ :=
      (QuotientGroup.kerLift_injective φ).comp (QuotientGroup.quotientMulEquivOfEq hker).injective
    have hP_K : IsPGroup p (K ⧸ C_K) := hP.of_injective ψ hψ_inj
    exact ⟨p, C_K, hp, inferInstance, hCK_cyc, hP_K⟩
  have h_stab_qe : ∀ (H₁ H₂ : Subgroup G), IsQuasiElementary H₁ →
      ∀ (x : (G ⧸ H₁) × (G ⧸ H₂)), IsQuasiElementary (MulAction.stabilizer G x) := by
    intro H₁ H₂ hH₁ x
    let K := MulAction.stabilizer G x
    let a₁ : G := Quotient.out x.1
    have ha₁ : (a₁ : G ⧸ H₁) = x.1 := QuotientGroup.out_eq' x.1
    have h_mem : ∀ k : K, a₁⁻¹ * k.1 * a₁ ∈ H₁ := by
      intro k
      have hk : k.1 • x = x := MulAction.mem_stabilizer_iff.mp k.2
      have hk1 : k.1 • x.1 = x.1 := congrArg Prod.fst hk
      rw [← ha₁] at hk1
      change ((k.1 * a₁ : G) : G ⧸ H₁) = (a₁ : G ⧸ H₁) at hk1
      have hk2 : a₁⁻¹ * (k.1 * a₁) ∈ H₁ := QuotientGroup.eq.mp hk1.symm
      rwa [← mul_assoc] at hk2
    let e : K →* H₁ :=
      { toFun := fun k => ⟨a₁⁻¹ * k.1 * a₁, h_mem k⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun k₁ k₂ => Subtype.ext (by dsimp; group) }
    have he : Function.Injective e := by
      intro k₁ k₂ hk
      have hk_val : a₁⁻¹ * k₁.1 * a₁ = a₁⁻¹ * k₂.1 * a₁ := congrArg Subtype.val hk
      apply Subtype.ext
      calc k₁.1 = a₁ * (a₁⁻¹ * k₁.1 * a₁) * a₁⁻¹ := by group
        _ = a₁ * (a₁⁻¹ * k₂.1 * a₁) * a₁⁻¹ := by rw [hk_val]
        _ = k₂.1 := by group
    exact h_qe_of_inj hH₁ e he
  have h_mul_gen : ∀ (H₁ H₂ : Subgroup G), IsQuasiElementary H₁ →
      InQESpan (fun g => fixedCosetCount H₁ g * fixedCosetCount H₂ g) := by
    intro H₁ H₂ hH₁
    let X := (G ⧸ H₁) × (G ⧸ H₂)
    let Ω_X := Quotient (MulAction.orbitRel G X)
    let Φ_X : (Σ ω : Ω_X, G ⧸ MulAction.stabilizer G ω.out) → X :=
      fun p => MulAction.ofQuotientStabilizer G p.1.out p.2
    have hΦ_orb : ∀ (ω : Ω_X) (u : G ⧸ MulAction.stabilizer G ω.out),
        (Quotient.mk'' (Φ_X ⟨ω, u⟩) : Ω_X) = ω := by
      intro ω u
      have h_mem : Φ_X ⟨ω, u⟩ ∈ MulAction.orbit G ω.out :=
        MulAction.ofQuotientStabilizer_mem_orbit G ω.out u
      have h_rel : (MulAction.orbitRel G X) (Φ_X ⟨ω, u⟩) ω.out := by
        rwa [MulAction.orbitRel_apply]
      have h_mk : (Quotient.mk'' (Φ_X ⟨ω, u⟩) : Ω_X) = Quotient.mk'' ω.out :=
        Quotient.eq''.mpr h_rel
      exact h_mk.trans (Quotient.out_eq' ω)
    have hΦ_inj : Function.Injective Φ_X := by
      intro ⟨ω₁, u₁⟩ ⟨ω₂, u₂⟩ h
      have hω : ω₁ = ω₂ := by
        rw [← hΦ_orb ω₁ u₁, ← hΦ_orb ω₂ u₂, h]
      subst hω
      have hu : u₁ = u₂ := MulAction.injective_ofQuotientStabilizer G ω₁.out h
      subst hu
      rfl
    have hΦ_surj : Function.Surjective Φ_X := by
      intro x
      let ω : Ω_X := Quotient.mk'' x
      have h_eq : (Quotient.mk'' x : Ω_X) = Quotient.mk'' ω.out :=
        (Quotient.out_eq' ω).symm
      have h_orb : x ∈ MulAction.orbit G ω.out := by
        rw [← MulAction.orbitRel_apply]
        exact Quotient.eq''.mp h_eq
      rcases MulAction.mem_orbit_iff.mp h_orb with ⟨a, ha⟩
      refine ⟨⟨ω, (a : G ⧸ MulAction.stabilizer G ω.out)⟩, ?_⟩
      change MulAction.ofQuotientStabilizer G ω.out (a : G ⧸ MulAction.stabilizer G ω.out) = x
      rw [MulAction.ofQuotientStabilizer_mk G ω.out a, ha]
    have hΦ_smul : ∀ (g : G) (ω : Ω_X) (u : G ⧸ MulAction.stabilizer G ω.out),
        g • Φ_X ⟨ω, u⟩ = Φ_X ⟨ω, g • u⟩ := by
      intro g ω u
      exact (MulAction.ofQuotientStabilizer_smul G ω.out g u).symm
    let L_prod : List (ℤ × Subgroup G) :=
      (Finset.univ : Finset Ω_X).toList.map fun ω => ((1 : ℤ), MulAction.stabilizer G ω.out)
    refine ⟨L_prod, ⟨?_, ?_⟩⟩
    · intro p hp
      rcases List.mem_map.mp hp with ⟨ω, _, rfl⟩
      exact h_stab_qe H₁ H₂ hH₁ ω.out
    · intro g
      have h_list_sum :
          (L_prod.map fun p => p.1 * fixedCosetCount p.2 g).sum =
            ∑ ω : Ω_X, fixedCosetCount (MulAction.stabilizer G ω.out) g := by
        dsimp [L_prod]
        rw [List.map_map]
        have h_fn : ((fun p : ℤ × Subgroup G => p.1 * fixedCosetCount p.2 g) ∘
            fun ω : Ω_X => ((1 : ℤ), MulAction.stabilizer G ω.out)) =
            fun ω : Ω_X => fixedCosetCount (MulAction.stabilizer G ω.out) g := by
          funext ω
          simp
        rw [h_fn, ← Finset.sum_map_toList]
      rw [h_list_sum]
      let Ψ_g : (Σ ω : Ω_X, {u : G ⧸ MulAction.stabilizer G ω.out | g • u = u}) →
          {x : X | g • x = x} :=
        fun p => ⟨Φ_X ⟨p.1, p.2.1⟩, by
          show g • Φ_X ⟨p.1, p.2.1⟩ = Φ_X ⟨p.1, p.2.1⟩
          rw [hΦ_smul g p.1 p.2.1, p.2.2]⟩
      have hΨ_inj : Function.Injective Ψ_g := by
        intro ⟨ω₁, ⟨u₁, hu₁⟩⟩ ⟨ω₂, ⟨u₂, hu₂⟩⟩ h
        have hΦ : Φ_X ⟨ω₁, u₁⟩ = Φ_X ⟨ω₂, u₂⟩ := congrArg Subtype.val h
        have h_pair : (⟨ω₁, u₁⟩ : Σ ω : Ω_X, G ⧸ MulAction.stabilizer G ω.out) = ⟨ω₂, u₂⟩ :=
          hΦ_inj hΦ
        have hω : ω₁ = ω₂ := congrArg Sigma.fst h_pair
        subst hω
        have hu : u₁ = u₂ := MulAction.injective_ofQuotientStabilizer G ω₁.out hΦ
        subst hu
        rfl
      have hΨ_surj : Function.Surjective Ψ_g := by
        intro ⟨x, hx⟩
        rcases hΦ_surj x with ⟨⟨ω, u⟩, hxu⟩
        have hu_fix : g • u = u := by
          apply MulAction.injective_ofQuotientStabilizer G ω.out
          calc Φ_X ⟨ω, g • u⟩ = g • Φ_X ⟨ω, u⟩ := (hΦ_smul g ω u).symm
            _ = g • x := by rw [hxu]
            _ = x := hx
            _ = Φ_X ⟨ω, u⟩ := hxu.symm
        refine ⟨⟨ω, ⟨u, hu_fix⟩⟩, Subtype.ext hxu⟩
      have h_card_sigma :
          (Nat.card {x : X | g • x = x} : ℤ) =
            ∑ ω : Ω_X, fixedCosetCount (MulAction.stabilizer G ω.out) g := by
        have h_bij := Nat.card_congr (Equiv.ofBijective Ψ_g ⟨hΨ_inj, hΨ_surj⟩).symm
        rw [h_bij, Nat.card_eq_fintype_card, Fintype.card_sigma, Nat.cast_sum]
        refine Finset.sum_congr rfl fun ω _ => ?_
        simp [fixedCosetCount, Nat.card_eq_fintype_card]
      rw [← h_card_sigma]
      let e_prod : {x : X | g • x = x} ≃
          {u₁ : G ⧸ H₁ | g • u₁ = u₁} × {u₂ : G ⧸ H₂ | g • u₂ = u₂} :=
        { toFun := fun x =>
            (⟨x.1.1, (Prod.ext_iff.mp x.2).1⟩, ⟨x.1.2, (Prod.ext_iff.mp x.2).2⟩)
          invFun := fun p => ⟨(p.1.1, p.2.1), Prod.ext p.1.2 p.2.2⟩
          left_inv := fun ⟨⟨_, _⟩, _⟩ => rfl
          right_inv := fun ⟨⟨_, _⟩, ⟨_, _⟩⟩ => rfl }
      have h_card_prod :
          Nat.card {x : X | g • x = x} =
            Nat.card {u₁ : G ⧸ H₁ | g • u₁ = u₁} * Nat.card {u₂ : G ⧸ H₂ | g • u₂ = u₂} :=
        (Nat.card_congr e_prod).trans (Nat.card_prod _ _)
      rw [h_card_prod, Nat.cast_mul]
      rfl
  have h_mul_gen_left : ∀ (H₁ : Subgroup G), IsQuasiElementary H₁ →
      ∀ (L₂ : List (ℤ × Subgroup G)), (∀ p ∈ L₂, IsQuasiElementary p.2) →
      InQESpan (fun g => fixedCosetCount H₁ g * (L₂.map fun p => p.1 * fixedCosetCount p.2 g).sum) := by
    intro H₁ hH₁ L₂
    induction L₂ with
    | nil =>
      intro _
      have h_eq : (fun g => fixedCosetCount H₁ g *
          (([].map fun p : ℤ × Subgroup G => p.1 * fixedCosetCount p.2 g).sum)) = (0 : G → ℤ) := by
        funext g
        simp
      rw [h_eq]
      exact h_zero
    | cons q tl ih =>
      intro hL₂
      have htl_wf : ∀ p ∈ tl, IsQuasiElementary p.2 := fun p hp => hL₂ p (by simp [hp])
      have h_eq : (fun g => fixedCosetCount H₁ g *
          (((q :: tl).map fun p => p.1 * fixedCosetCount p.2 g).sum)) =
          (fun g => q.1 * (fixedCosetCount H₁ g * fixedCosetCount q.2 g) +
            fixedCosetCount H₁ g * (tl.map fun p => p.1 * fixedCosetCount p.2 g).sum) := by
        funext g
        simp only [List.map_cons, List.sum_cons]
        ring
      rw [h_eq]
      exact h_add _ _ (h_smul q.1 _ (h_mul_gen H₁ q.2 hH₁)) (ih htl_wf)
  have h_mul_lists : ∀ (L₁ : List (ℤ × Subgroup G)), (∀ p ∈ L₁, IsQuasiElementary p.2) →
      ∀ (f₂ : G → ℤ), InQESpan f₂ →
      InQESpan (fun g => (L₁.map fun p => p.1 * fixedCosetCount p.2 g).sum * f₂ g) := by
    intro L₁
    induction L₁ with
    | nil =>
      intro _ f₂ _
      have h_eq : (fun g => (([].map fun p : ℤ × Subgroup G => p.1 * fixedCosetCount p.2 g).sum) * f₂ g) =
          (0 : G → ℤ) := by
        funext g
        simp
      rw [h_eq]
      exact h_zero
    | cons p tl ih =>
      intro hL₁ f₂ hf₂
      have hp_wf : IsQuasiElementary p.2 := hL₁ p (by simp)
      have htl_wf : ∀ q ∈ tl, IsQuasiElementary q.2 := fun q hq => hL₁ q (by simp [hq])
      rcases hf₂ with ⟨L₂, hL₂_wf, hL₂_sum⟩
      have h_eq : (fun g => (((p :: tl).map fun q => q.1 * fixedCosetCount q.2 g).sum) * f₂ g) =
          (fun g => p.1 * (fixedCosetCount p.2 g * (L₂.map fun q => q.1 * fixedCosetCount q.2 g).sum) +
            (tl.map fun q => q.1 * fixedCosetCount q.2 g).sum * f₂ g) := by
        funext g
        simp only [List.map_cons, List.sum_cons, hL₂_sum g]
        ring
      rw [h_eq]
      exact h_add _ _ (h_smul p.1 _ (h_mul_gen_left p.2 hp_wf L₂ hL₂_wf))
        (ih htl_wf f₂ ⟨L₂, hL₂_wf, hL₂_sum⟩)
  have h_mul : ∀ (f₁ f₂ : G → ℤ), InQESpan f₁ → InQESpan f₂ → InQESpan (fun g => f₁ g * f₂ g) := by
    intro f₁ f₂ ⟨L₁, hL₁_wf, hL₁_sum⟩ hf₂
    have h_eq : (fun g => f₁ g * f₂ g) =
        (fun g => (L₁.map fun p => p.1 * fixedCosetCount p.2 g).sum * f₂ g) := by
      funext g
      rw [hL₁_sum g]
    rw [h_eq]
    exact h_mul_lists L₁ hL₁_wf f₂ hf₂
  exact ⟨h_zero, h_gen, h_smul, h_add, h_sub, h_mul⟩

theorem ld_cyclic_fixedCosetCount_props (G : Type u) [Group G] [Fintype G] :
    HasCyclicFixedCosetProps G :=
by
  intro y₀
  set C₀ := Subgroup.zpowers y₀
  set n := Nat.card C₀
  have h_fixed_iff : ∀ (H : Subgroup G) (g x : G),
      g • (x : G ⧸ H) = (x : G ⧸ H) ↔ x⁻¹ * g * x ∈ H := by
    intro H g x
    change ((g * x : G) : G ⧸ H) = (x : G ⧸ H) ↔ _
    rw [eq_comm, QuotientGroup.eq, ← mul_assoc]
  have h_card_conj : ∀ (a x : G),
      Nat.card (Subgroup.zpowers (x * a * x⁻¹)) = Nat.card (Subgroup.zpowers a) := by
    intro a x
    rw [Nat.card_zpowers, Nat.card_zpowers, ← MulAut.conj_apply, MulEquiv.orderOf_eq]
  have h_card_conj_inv : ∀ (a x : G),
      Nat.card (Subgroup.zpowers (x⁻¹ * a * x)) = Nat.card (Subgroup.zpowers a) := by
    intro a x
    simpa [inv_inv] using h_card_conj a x⁻¹
  haveI : IsCyclic C₀ := Subgroup.isCyclic_zpowers y₀
  have h1 : IsQuasiElementary C₀ := by
    refine ⟨2, (⊤ : Subgroup C₀), Nat.fact_prime_two, inferInstance, inferInstance, ?_⟩
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    refine ⟨0, ?_⟩
    rw [pow_zero, pow_one]
    exact QuotientGroup.eq.mpr (Subgroup.mem_top _)
  have h2 : ∀ g : G, n < Nat.card (Subgroup.zpowers g) → fixedCosetCount C₀ g = 0 := by
    intro g h_lt
    unfold fixedCosetCount
    rw [Nat.cast_eq_zero]
    haveI : IsEmpty {u : G ⧸ C₀ | g • u = u} := by
      refine ⟨fun ⟨u, hu⟩ => ?_⟩
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective u
      have hx : x⁻¹ * g * x ∈ C₀ := (h_fixed_iff C₀ g x).mp hu
      have h_le : Subgroup.zpowers (x⁻¹ * g * x) ≤ C₀ := Subgroup.zpowers_le.mpr hx
      have h_card_le : Nat.card (Subgroup.zpowers (x⁻¹ * g * x)) ≤ n :=
        Subgroup.card_le_of_le h_le
      rw [h_card_conj_inv g x] at h_card_le
      omega
    exact Nat.card_of_isEmpty
  have h3 : ∀ g : G, Nat.card (Subgroup.zpowers g) = n →
      (¬ ∃ x : G, x * g * x⁻¹ ∈ C₀) → fixedCosetCount C₀ g = 0 := by
    intro g _ h_no
    unfold fixedCosetCount
    rw [Nat.cast_eq_zero]
    haveI : IsEmpty {u : G ⧸ C₀ | g • u = u} := by
      refine ⟨fun ⟨u, hu⟩ => ?_⟩
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective u
      have hx : x⁻¹ * g * x ∈ C₀ := (h_fixed_iff C₀ g x).mp hu
      exact h_no ⟨x⁻¹, by simpa [inv_inv] using hx⟩
    exact Nat.card_of_isEmpty
  have h4 : ∀ g : G, Nat.card (Subgroup.zpowers g) = n →
      (∃ x : G, x * g * x⁻¹ ∈ C₀) →
      ∀ H : Subgroup G, fixedCosetCount H g = fixedCosetCount H y₀ := by
    intro g h_card ⟨x, hx⟩ H
    have h_le : Subgroup.zpowers (x * g * x⁻¹) ≤ C₀ := Subgroup.zpowers_le.mpr hx
    have h_card_eq : Nat.card (Subgroup.zpowers (x * g * x⁻¹)) = n := by
      rw [h_card_conj g x, h_card]
    have h_zpow_eq : Subgroup.zpowers (x * g * x⁻¹) = C₀ :=
      Subgroup.eq_of_le_of_card_ge h_le (by omega)
    have h_coset : ∀ u : G ⧸ H,
        u ∈ {u : G ⧸ H | g • u = u} ↔ MulAction.toPerm x u ∈ {u : G ⧸ H | y₀ • u = u} := by
      intro u
      obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective u
      simp only [Set.mem_setOf_eq, MulAction.toPerm_apply]
      change g • (z : G ⧸ H) = (z : G ⧸ H) ↔ y₀ • ((x * z : G) : G ⧸ H) = ((x * z : G) : G ⧸ H)
      rw [h_fixed_iff H g z, h_fixed_iff H y₀ (x * z)]
      let K_z : Subgroup G := H.comap (MulAut.conj (x * z)⁻¹).toMonoidHom
      have h_mem_Kz : ∀ w : G, w ∈ K_z ↔ (x * z)⁻¹ * w * (x * z)⁻¹⁻¹ ∈ H := by
        intro w
        rfl
      have h_lhs : z⁻¹ * g * z ∈ H ↔ x * g * x⁻¹ ∈ K_z := by
        rw [h_mem_Kz]
        have h_grp : (x * z)⁻¹ * (x * g * x⁻¹) * (x * z)⁻¹⁻¹ = z⁻¹ * g * z := by group
        rw [h_grp]
      have h_rhs : (x * z)⁻¹ * y₀ * (x * z) ∈ H ↔ y₀ ∈ K_z := by
        rw [h_mem_Kz]
        have h_grp : (x * z)⁻¹ * y₀ * (x * z)⁻¹⁻¹ = (x * z)⁻¹ * y₀ * (x * z) := by group
        rw [h_grp]
      rw [h_lhs, h_rhs, ← Subgroup.zpowers_le, h_zpow_eq, Subgroup.zpowers_le]
    unfold fixedCosetCount
    congr 1
    exact Nat.card_congr (Equiv.subtypeEquiv (MulAction.toPerm x) h_coset)
  have h_norm_iff : ∀ x : G, x⁻¹ * y₀ * x ∈ C₀ ↔ x ∈ C₀.normalizer := by
    intro x
    constructor
    · intro hy
      have h_le : Subgroup.zpowers (x⁻¹ * y₀ * x) ≤ C₀ := Subgroup.zpowers_le.mpr hy
      have h_card_eq : Nat.card (Subgroup.zpowers (x⁻¹ * y₀ * x)) = n := h_card_conj_inv y₀ x
      have h_eq : Subgroup.zpowers (x⁻¹ * y₀ * x) = C₀ :=
        Subgroup.eq_of_le_of_card_ge h_le (by omega)
      rw [Subgroup.mem_normalizer_iff]
      intro c
      let K₁ : Subgroup G := C₀.comap (MulAut.conj x).toMonoidHom
      let K₂ : Subgroup G := C₀.comap (MulAut.conj x⁻¹).toMonoidHom
      have hK₁ : C₀ ≤ K₁ := by
        rw [← h_eq, Subgroup.zpowers_le]
        change x * (x⁻¹ * y₀ * x) * x⁻¹ ∈ C₀
        have h_grp : x * (x⁻¹ * y₀ * x) * x⁻¹ = y₀ := by group
        rw [h_grp]
        exact Subgroup.mem_zpowers y₀
      have hK₂ : C₀ ≤ K₂ := by
        rw [Subgroup.zpowers_le]
        change x⁻¹ * y₀ * x⁻¹⁻¹ ∈ C₀
        simpa [inv_inv] using hy
      constructor
      · intro hc
        exact hK₁ hc
      · intro hc
        have hc2 : x * c * x⁻¹ ∈ K₂ := hK₂ hc
        change x⁻¹ * (x * c * x⁻¹) * x⁻¹⁻¹ ∈ C₀ at hc2
        have h_grp : x⁻¹ * (x * c * x⁻¹) * x⁻¹⁻¹ = c := by group
        rwa [h_grp] at hc2
    · intro hx
      have hx_inv : x⁻¹ ∈ C₀.normalizer := Subgroup.inv_mem _ hx
      have h_mem := (Subgroup.mem_normalizer_iff.mp hx_inv y₀).mp (Subgroup.mem_zpowers y₀)
      simpa [inv_inv] using h_mem
  have h5 : fixedCosetCount C₀ y₀ = (C₀.relIndex C₀.normalizer : ℤ) := by
    let N₀ := C₀.normalizer
    let C_N := C₀.subgroupOf N₀
    have h_fix : ∀ k : N₀, y₀ • (k.1 : G ⧸ C₀) = (k.1 : G ⧸ C₀) := by
      intro k
      rw [h_fixed_iff C₀ y₀ k.1, h_norm_iff k.1]
      exact k.2
    let ι : N₀ ⧸ C_N → {u : G ⧸ C₀ | y₀ • u = u} :=
      fun q => Quotient.liftOn' q (fun k => ⟨(k.1 : G ⧸ C₀), h_fix k⟩) (by
        intro a b hab
        apply Subtype.ext
        change (a.1 : G ⧸ C₀) = (b.1 : G ⧸ C₀)
        rw [QuotientGroup.eq]
        have hab' : a⁻¹ * b ∈ C_N := QuotientGroup.leftRel_apply.mp hab
        exact Subgroup.mem_subgroupOf.mp hab')
    have hinj : Function.Injective ι := by
      intro q₁ q₂ hq
      refine Quotient.inductionOn₂' q₁ q₂ (fun a b hab => ?_) hq
      have hab' : (a.1 : G ⧸ C₀) = (b.1 : G ⧸ C₀) := Subtype.ext_iff.mp hab
      rw [QuotientGroup.eq] at hab'
      change ((a : N₀) : N₀ ⧸ C_N) = ((b : N₀) : N₀ ⧸ C_N)
      rw [QuotientGroup.eq]
      exact Subgroup.mem_subgroupOf.mpr hab'
    have hsurj : Function.Surjective ι := by
      rintro ⟨u, hu⟩
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective u
      have hx : x ∈ N₀ := (h_norm_iff x).mp ((h_fixed_iff C₀ y₀ x).mp hu)
      refine ⟨((⟨x, hx⟩ : N₀) : N₀ ⧸ C_N), ?_⟩
      rfl
    unfold fixedCosetCount
    congr 1
    rw [← Nat.card_congr (Equiv.ofBijective ι ⟨hinj, hsurj⟩)]
    exact (Subgroup.index_eq_card C_N).symm
  have h6 : 0 < fixedCosetCount C₀ y₀ := by
    rw [h5, Nat.cast_pos]
    change 0 < (C₀.subgroupOf C₀.normalizer).index
    rw [Subgroup.index_eq_card]
    exact Nat.card_pos
  have h7 : fixedCosetCount C₀ y₀ ∣ (Fintype.card G : ℤ) := by
    rw [h5]
    apply Nat.cast_dvd_cast
    have h_rel := Subgroup.relIndex_mul_index (Subgroup.le_normalizer : C₀ ≤ C₀.normalizer)
    have h_ind := Subgroup.index_mul_card C₀
    refine ⟨C₀.normalizer.index * Nat.card C₀, ?_⟩
    calc Fintype.card G = Nat.card G := Nat.card_eq_fintype_card.symm
      _ = C₀.index * Nat.card C₀ := h_ind.symm
      _ = (C₀.relIndex C₀.normalizer * C₀.normalizer.index) * Nat.card C₀ := by rw [← h_rel]
      _ = C₀.relIndex C₀.normalizer * (C₀.normalizer.index * Nat.card C₀) := by ring
  exact ⟨h1, h2, h3, h4, h5, h6, h7⟩

theorem ld_artin_divisibility_inQESpan (G : Type u) [Group G] [Fintype G]
    (h_cyc : HasCyclicFixedCosetProps G)
    (Φ : G → ℤ) (hΦ : InQESpan Φ)
    (h_div : ∀ g : G, ((Fintype.card G : ℤ) ^ (Fintype.card G)) ∣ (1 - Φ g)) :
    InQESpan (fun _ : G => 1) :=
by
  have h_add_qe : ∀ (f : G → ℤ) (c : ℤ) (H : Subgroup G),
      InQESpan f → IsQuasiElementary H →
      InQESpan (fun g => f g + c * fixedCosetCount H g) := by
    intro f c H ⟨L, hL_wf, hL_sum⟩ hH
    refine ⟨(c, H) :: L, ?_, ?_⟩
    · intro p hp
      rw [List.mem_cons] at hp
      rcases hp with rfl | hp
      · exact hH
      · exact hL_wf p hp
    · intro g
      simp only [List.map_cons, List.sum_cons]
      rw [hL_sum g, add_comm]
  have h_span_congr : ∀ (f : G → ℤ) (g y₀ : G),
      InQESpan f →
      (∀ H : Subgroup G, fixedCosetCount H g = fixedCosetCount H y₀) →
      f g = f y₀ := by
    intro f g y₀ ⟨L, _, hL_sum⟩ h_eq
    rw [← hL_sum g, ← hL_sum y₀]
    congr 1
    exact List.map_congr_left (fun p _ => by rw [h_eq p.2])
  let M : ℤ := (Fintype.card G : ℤ)
  have h_level : ∀ (m : ℕ) (Φ₀ : G → ℤ),
      InQESpan Φ₀ →
      (∀ g : G, m < Nat.card (Subgroup.zpowers g) → 1 - Φ₀ g = 0) →
      (∀ g : G, (M ^ m) ∣ (1 - Φ₀ g)) →
      InQESpan (fun _ : G => 1) := by
    intro m
    induction m with
    | zero =>
      intro Φ₀ hΦ₀ h_gt₀ _
      have h_fn : Φ₀ = (fun _ : G => 1) := by
        funext g
        have hg_pos : 0 < Nat.card (Subgroup.zpowers g) := Nat.card_pos
        exact (sub_eq_zero.mp (h_gt₀ g hg_pos)).symm
      rwa [← h_fn]
    | succ m ih_m =>
      intro Φ₀ hΦ₀ h_gt₀ h_div₀
      have h_clear : ∀ (k : ℕ) (Φ₁ : G → ℤ),
          InQESpan Φ₁ →
          (∀ g : G, m + 1 < Nat.card (Subgroup.zpowers g) → 1 - Φ₁ g = 0) →
          (∀ g : G, Nat.card (Subgroup.zpowers g) = m + 1 → (M ^ (m + 1)) ∣ (1 - Φ₁ g)) →
          (∀ g : G, (M ^ m) ∣ (1 - Φ₁ g)) →
          (Finset.univ.filter (fun g : G => Nat.card (Subgroup.zpowers g) = m + 1 ∧ 1 - Φ₁ g ≠ 0)).card = k →
          InQESpan (fun _ : G => 1) := by
        intro k
        induction' k using Nat.strong_induction_on with k ih_k
        intro Φ₁ hΦ₁ h_gt₁ h_eq_div₁ h_all_div₁ hk
        set B := Finset.univ.filter (fun g : G => Nat.card (Subgroup.zpowers g) = m + 1 ∧ 1 - Φ₁ g ≠ 0)
        rcases Nat.eq_zero_or_pos k with rfl | hk_pos
        · refine ih_m Φ₁ hΦ₁ ?_ h_all_div₁
          intro g hg
          rcases Nat.eq_or_lt_of_le (Nat.succ_le_of_lt hg) with h_eq | h_lt
          · by_contra h_ne
            have hg_B : g ∈ B := Finset.mem_filter.mpr ⟨Finset.mem_univ g, h_eq.symm, h_ne⟩
            have hB_empty : B = ∅ := Finset.card_eq_zero.mp hk
            rw [hB_empty] at hg_B
            exact Finset.notMem_empty g hg_B
          · exact h_gt₁ g h_lt
        · have hB_pos : 0 < B.card := hk.symm ▸ hk_pos
          obtain ⟨y₀, hy₀⟩ := Finset.card_pos.mp hB_pos
          have hy₀_prop := (Finset.mem_filter.mp hy₀).2
          have hy₀_card : Nat.card (Subgroup.zpowers y₀) = m + 1 := hy₀_prop.1
          set C₀ := Subgroup.zpowers y₀
          rcases h_cyc y₀ with ⟨hC₀_qe, hC₀_gt, hC₀_not_conj, hC₀_conj, _, _, hC₀_dvd⟩
          set d₀ := fixedCosetCount C₀ y₀
          obtain ⟨q₀, hM_eq⟩ := hC₀_dvd
          obtain ⟨r, hr⟩ := h_eq_div₁ y₀ hy₀_card
          let c : ℤ := q₀ * M ^ m * r
          have hc_mul : c * d₀ = 1 - Φ₁ y₀ := by
            have hM_eq' : M = d₀ * q₀ := hM_eq
            dsimp [c]
            rw [hr, pow_succ', hM_eq']
            ring
          have hc_dvd : (M ^ m) ∣ c := ⟨q₀ * r, by dsimp [c]; ring⟩
          let Φ₂ : G → ℤ := fun g => Φ₁ g + c * fixedCosetCount C₀ g
          set B₂ := Finset.univ.filter (fun g : G => Nat.card (Subgroup.zpowers g) = m + 1 ∧ 1 - Φ₂ g ≠ 0)
          have hΦ₂ : InQESpan Φ₂ := h_add_qe Φ₁ c C₀ hΦ₁ hC₀_qe
          have h_gt₂ : ∀ g : G, m + 1 < Nat.card (Subgroup.zpowers g) → 1 - Φ₂ g = 0 := by
            intro g hg
            have h_fc : fixedCosetCount C₀ g = 0 := hC₀_gt g (hy₀_card.symm ▸ hg)
            dsimp [Φ₂]
            rw [h_fc, mul_zero, add_zero]
            exact h_gt₁ g hg
          have h_conj_zero : ∀ g : G, Nat.card (Subgroup.zpowers g) = m + 1 →
              (∃ x : G, x * g * x⁻¹ ∈ C₀) → 1 - Φ₂ g = 0 := by
            intro g hg h_conj
            have h_all_H : ∀ H : Subgroup G, fixedCosetCount H g = fixedCosetCount H y₀ :=
              hC₀_conj g (hy₀_card.symm ▸ hg) h_conj
            have hΦ_eq : Φ₁ g = Φ₁ y₀ := h_span_congr Φ₁ g y₀ hΦ₁ h_all_H
            have h_fc_eq : fixedCosetCount C₀ g = d₀ := h_all_H C₀
            dsimp [Φ₂]
            rw [hΦ_eq, h_fc_eq, hc_mul]
            ring
          have h_eq_div₂ : ∀ g : G, Nat.card (Subgroup.zpowers g) = m + 1 → (M ^ (m + 1)) ∣ (1 - Φ₂ g) := by
            intro g hg
            by_cases h_conj : ∃ x : G, x * g * x⁻¹ ∈ C₀
            · rw [h_conj_zero g hg h_conj]
              exact dvd_zero _
            · have h_fc : fixedCosetCount C₀ g = 0 := hC₀_not_conj g (hy₀_card.symm ▸ hg) h_conj
              dsimp [Φ₂]
              rw [h_fc, mul_zero, add_zero]
              exact h_eq_div₁ g hg
          have h_all_div₂ : ∀ g : G, (M ^ m) ∣ (1 - Φ₂ g) := by
            intro g
            have h_sub : 1 - Φ₂ g = (1 - Φ₁ g) - c * fixedCosetCount C₀ g := by
              dsimp [Φ₂]
              ring
            rw [h_sub]
            exact dvd_sub (h_all_div₁ g) (dvd_mul_of_dvd_left hc_dvd _)
          have hB₂_sub : B₂ ⊆ B := by
            intro g hg
            have hg_prop := (Finset.mem_filter.mp hg).2
            have hg_card : Nat.card (Subgroup.zpowers g) = m + 1 := hg_prop.1
            have hg_ne₂ : 1 - Φ₂ g ≠ 0 := hg_prop.2
            have h_not_conj : ¬ ∃ x : G, x * g * x⁻¹ ∈ C₀ :=
              fun h_conj => hg_ne₂ (h_conj_zero g hg_card h_conj)
            have h_fc : fixedCosetCount C₀ g = 0 := hC₀_not_conj g (hy₀_card.symm ▸ hg_card) h_not_conj
            have hg_ne₁ : 1 - Φ₁ g ≠ 0 := by
              intro h_zero
              apply hg_ne₂
              dsimp [Φ₂]
              rw [h_fc, mul_zero, add_zero, h_zero]
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ g, hg_card, hg_ne₁⟩
          have hy₀_not_B₂ : y₀ ∉ B₂ := by
            intro hy₀_B₂
            have hy₀_ne₂ := (Finset.mem_filter.mp hy₀_B₂).2.2
            have hy₀_conj : ∃ x : G, x * y₀ * x⁻¹ ∈ C₀ := ⟨1, by simp [C₀, Subgroup.mem_zpowers]⟩
            exact hy₀_ne₂ (h_conj_zero y₀ hy₀_card hy₀_conj)
          have hB₂_ssub : B₂ ⊂ B :=
            (Finset.ssubset_iff_of_subset hB₂_sub).mpr ⟨y₀, hy₀, hy₀_not_B₂⟩
          have hB₂_lt : B₂.card < k := hk ▸ Finset.card_lt_card hB₂_ssub
          exact ih_k B₂.card hB₂_lt Φ₂ hΦ₂ h_gt₂ h_eq_div₂ h_all_div₂ rfl
      refine h_clear _ Φ₀ hΦ₀ h_gt₀ (fun g _ => h_div₀ g) (fun g => ?_) rfl
      exact dvd_trans ⟨M, pow_succ M m⟩ (h_div₀ g)
  refine h_level (Fintype.card G) Φ hΦ (fun g hg => ?_) h_div
  have h_le : Nat.card (Subgroup.zpowers g) ≤ Fintype.card G := by
    rw [← Nat.card_eq_fintype_card]
    exact Subgroup.card_le_card_group (Subgroup.zpowers g)
  exact absurd hg (not_lt_of_ge h_le)

theorem ld_prime_congruence_inQESpan (G : Type u) [Group G] [Fintype G]
    (h_cyc : HasCyclicFixedCosetProps G)
    (p : ℕ) [Fact p.Prime] :
    ∃ Φ_p : G → ℤ, InQESpan Φ_p ∧ ∀ g : G, (p : ℤ) ∣ (1 - Φ_p g) :=
by
  have h_s1 : ∀ (Φ : G → ℤ), InQESpan Φ → ∀ (g : G),
      (p : ℤ) ∣ (Φ g - Φ (g ^ (p ^ Fintype.card G))) := by
    intro Φ hΦ g
    set m := Fintype.card G
    set y := g ^ (p ^ m)
    have h_pow_fix : ∀ (H : Subgroup G) (u : G ⧸ H), g • u = u → ∀ k : ℕ, (g ^ k) • u = u := by
      intro H u hu k
      induction k with
      | zero => simp
      | succ k ih => rw [pow_succ', mul_smul, ih, hu]
    have h_single : ∀ H : Subgroup G, (p : ℤ) ∣ (fixedCosetCount H g - fixedCosetCount H y) := by
      intro H
      let α := {u : G ⧸ H // y • u = u}
      have hy_comm : y * g = g * y := by
        dsimp [y]
        rw [← pow_succ, ← pow_succ']
      let f : Function.End α := fun x =>
        ⟨g • x.1, by
          rw [← mul_smul, hy_comm, mul_smul, x.2]⟩
      have hf_pow : ∀ (k : ℕ) (x : α), ((f ^ k) x).1 = (g ^ k) • x.1 := by
        intro k
        induction k with
        | zero =>
          intro x
          rw [pow_zero, pow_zero, one_smul]
          rfl
        | succ k ih =>
          intro x
          rw [pow_succ' f k, pow_succ' g k, mul_smul]
          exact congrArg (g • ·) (ih x)
      have hf_pm : f ^ (p ^ m) = 1 := by
        funext x
        apply Subtype.ext
        rw [hf_pow (p ^ m) x]
        exact x.2
      have h_mod := Equiv.Perm.card_fixedPoints_modEq (f := f) (hp := ‹Fact p.Prime›) hf_pm
      have h_dvd : (p : ℤ) ∣ ((Fintype.card (Function.fixedPoints f) : ℤ) - (Fintype.card α : ℤ)) :=
        Nat.ModEq.dvd h_mod
      let e_fix : Function.fixedPoints f ≃ {u : G ⧸ H // g • u = u} :=
        { toFun := fun x => ⟨x.1.1, congrArg Subtype.val x.2⟩
          invFun := fun u => ⟨⟨u.1, h_pow_fix H u.1 u.2 (p ^ m)⟩, Subtype.ext u.2⟩
          left_inv := fun x => Subtype.ext (Subtype.ext rfl)
          right_inv := fun u => Subtype.ext rfl }
      have h_card1 : (Fintype.card (Function.fixedPoints f) : ℤ) = fixedCosetCount H g := by
        dsimp [fixedCosetCount]
        rw [Nat.card_eq_fintype_card, Fintype.card_congr e_fix]
      have h_card2 : (Fintype.card α : ℤ) = fixedCosetCount H y := by
        dsimp [fixedCosetCount, α]
        rw [Nat.card_eq_fintype_card]
      rwa [h_card1, h_card2] at h_dvd
    rcases hΦ with ⟨L_qe, hL_wf, hL_sum⟩
    rw [← hL_sum g, ← hL_sum y]
    clear hL_wf hL_sum
    induction L_qe with
    | nil => simp
    | cons q tl ih =>
      simp only [List.map_cons, List.sum_cons]
      have h_eq :
          (q.1 * fixedCosetCount q.2 g + (List.map (fun p => p.1 * fixedCosetCount p.2 g) tl).sum) -
            (q.1 * fixedCosetCount q.2 y + (List.map (fun p => p.1 * fixedCosetCount p.2 y) tl).sum) =
          q.1 * (fixedCosetCount q.2 g - fixedCosetCount q.2 y) +
            ((List.map (fun p => p.1 * fixedCosetCount p.2 g) tl).sum -
              (List.map (fun p => p.1 * fixedCosetCount p.2 y) tl).sum) := by ring
      rw [h_eq]
      exact dvd_add (dvd_mul_of_dvd_right (h_single q.2) q.1) ih
  have h_s2 : ∀ (g : G),
      Nat.Coprime p (Nat.card (Subgroup.zpowers (g ^ (p ^ Fintype.card G)))) := by
    intro g
    set m := Fintype.card G
    set d := orderOf g
    have hp : p.Prime := ‹Fact p.Prime›.out
    have hd_pos : 0 < d := orderOf_pos g
    have hd_le : d ≤ m := orderOf_le_card_univ
    rw [Nat.card_zpowers, orderOf_pow, (Nat.Prime.coprime_iff_not_dvd hp)]
    intro h_dvd
    obtain ⟨k, hk_le, hk_eq⟩ := (Nat.dvd_prime_pow hp).mp (Nat.gcd_dvd_right d (p ^ m))
    have hpk_dvd_d : p ^ k ∣ d := hk_eq ▸ Nat.gcd_dvd_left d (p ^ m)
    rw [hk_eq] at h_dvd
    have h_mul_dvd : p * p ^ k ∣ (d / p ^ k) * p ^ k := Nat.mul_dvd_mul_right h_dvd (p ^ k)
    rw [Nat.div_mul_cancel hpk_dvd_d, ← pow_succ'] at h_mul_dvd
    have hk_lt : k < m := by
      apply lt_of_le_of_ne hk_le
      intro hk_m
      rw [hk_m] at hpk_dvd_d
      have h_pm_le : p ^ m ≤ d := Nat.le_of_dvd hd_pos hpk_dvd_d
      have h_lt_self : m < p ^ m := Nat.lt_pow_self hp.one_lt
      omega
    have h_pow_dvd : p ^ (k + 1) ∣ p ^ m := Nat.pow_dvd_pow p hk_lt
    have h_dvd_gcd : p ^ (k + 1) ∣ d.gcd (p ^ m) := Nat.dvd_gcd h_mul_dvd h_pow_dvd
    rw [hk_eq] at h_dvd_gcd
    have hpk_pos : 0 < p ^ k := Nat.pow_pos hp.pos
    have h_le : p ^ (k + 1) ≤ p ^ k := Nat.le_of_dvd hpk_pos h_dvd_gcd
    have hp_ge : 2 ≤ p := hp.two_le
    rw [pow_succ] at h_le
    nlinarith
  have h_s3 : ∀ (y₀ : G), Nat.Coprime p (Nat.card (Subgroup.zpowers y₀)) →
      ∃ H₀ : Subgroup G,
        IsQuasiElementary H₀ ∧
        (∀ y : G, Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
          Nat.card (Subgroup.zpowers y₀) < Nat.card (Subgroup.zpowers y) →
          fixedCosetCount H₀ y = 0) ∧
        (∀ y : G, Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
          Nat.card (Subgroup.zpowers y) = Nat.card (Subgroup.zpowers y₀) →
          (¬ ∃ x : G, x * y * x⁻¹ ∈ Subgroup.zpowers y₀) →
          fixedCosetCount H₀ y = 0) ∧
        ∃ b : ℤ, (p : ℤ) ∣ (1 - b * fixedCosetCount H₀ y₀) := by
    intro y₀ hy₀
    let C₀ : Subgroup G := Subgroup.zpowers y₀
    let N₀ : Subgroup G := C₀.normalizer
    let C_N : Subgroup N₀ := C₀.subgroupOf N₀
    haveI : C_N.Normal := Subgroup.normal_in_normalizer
    let Q₀ := N₀ ⧸ C_N
    let P₀ : Sylow p Q₀ := Classical.arbitrary (Sylow p Q₀)
    let H_N : Subgroup N₀ := P₀.1.comap (QuotientGroup.mk' C_N)
    let H₀ : Subgroup G := H_N.map N₀.subtype
    have h_le : H₀ ≤ N₀ := Subgroup.map_subtype_le H_N
    have hC₀_le_N₀ : C₀ ≤ N₀ := Subgroup.le_normalizer
    have hC₀H₀ : C₀ ≤ H₀ := by
      intro c hc
      refine ⟨⟨c, hC₀_le_N₀ hc⟩, ?_, rfl⟩
      change QuotientGroup.mk' C_N ⟨c, hC₀_le_N₀ hc⟩ ∈ P₀.1
      have h_one : QuotientGroup.mk' C_N ⟨c, hC₀_le_N₀ hc⟩ = 1 := (QuotientGroup.eq_one_iff _).mpr hc
      rw [h_one]
      exact P₀.1.one_mem
    let φ : H₀ →* Q₀ := (QuotientGroup.mk' C_N).comp (Subgroup.inclusion h_le)
    have hφ_mem : ∀ x : H₀, φ x ∈ P₀.1 := by
      intro x
      rcases x.2 with ⟨n, hn, hn_eq⟩
      have h_inc : Subgroup.inclusion h_le x = n := Subtype.ext hn_eq.symm
      change QuotientGroup.mk' C_N (Subgroup.inclusion h_le x) ∈ P₀.1
      rw [h_inc]
      exact hn
    let ψ : H₀ →* P₀.1 := φ.codRestrict P₀.1 hφ_mem
    have h_ker : ψ.ker = C₀.subgroupOf H₀ := by
      ext x
      rw [MonoidHom.ker_codRestrict, MonoidHom.mem_ker]
      change ((Subgroup.inclusion h_le x : N₀) : Q₀) = 1 ↔ x ∈ C₀.subgroupOf H₀
      rw [QuotientGroup.eq_one_iff]
      rfl
    have hψ_surj : Function.Surjective ψ := by
      intro z
      obtain ⟨n, hn⟩ := QuotientGroup.mk'_surjective C_N z.1
      have hn_H : n ∈ H_N := by
        change QuotientGroup.mk' C_N n ∈ P₀.1
        rw [hn]
        exact z.2
      refine ⟨⟨n.1, ⟨n, hn_H, rfl⟩⟩, ?_⟩
      apply Subtype.ext
      change QuotientGroup.mk' C_N n = z.1
      exact hn
    have hH₀_qe : IsQuasiElementary H₀ := by
      refine ⟨p, ψ.ker, ‹Fact p.Prime›, ψ.normal_ker, ?_, ?_⟩
      · rw [h_ker]
        exact (Subgroup.subgroupOfEquivOfLe hC₀H₀).isCyclic.mpr inferInstance
      · exact IsPGroup.of_injective P₀.isPGroup' (QuotientGroup.kerLift ψ) (QuotientGroup.kerLift_injective ψ)
    have h_kerLift_bij : Function.Bijective (QuotientGroup.kerLift ψ) := by
      refine ⟨QuotientGroup.kerLift_injective ψ, fun z => ?_⟩
      obtain ⟨x, rfl⟩ := hψ_surj z
      exact ⟨(x : H₀ ⧸ ψ.ker), rfl⟩
    have h_card_quot : Nat.card (H₀ ⧸ ψ.ker) = Nat.card P₀.1 :=
      Nat.card_congr (Equiv.ofBijective (QuotientGroup.kerLift ψ) h_kerLift_bij)
    have h_card_ker : Nat.card ψ.ker = Nat.card C₀ := by
      rw [h_ker]
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hC₀H₀).toEquiv
    have h_card_H₀ : Nat.card H₀ = Nat.card P₀.1 * Nat.card C₀ := by
      rw [Subgroup.card_eq_card_quotient_mul_card_subgroup ψ.ker, h_card_quot, h_card_ker]
    have h_coset_fiber : ∀ (H : Subgroup G) (g : G),
        (Nat.card {x : G | x⁻¹ * g * x ∈ H} : ℤ) = fixedCosetCount H g * (Nat.card H : ℤ) := by
      intro H g
      have h_out_mul : ∀ (u : G ⧸ H) (h : H), (((Quotient.out u * h.1 : G) : G ⧸ H)) = u := by
        intro u h
        have hq : (((Quotient.out u * h.1 : G) : G ⧸ H)) = ((Quotient.out u : G) : G ⧸ H) := by
          rw [QuotientGroup.eq]
          simp [h.2]
        rw [hq, QuotientGroup.out_eq']
      let e_fib : {x : G // x⁻¹ * g * x ∈ H} ≃ {u : G ⧸ H // g • u = u} × H :=
        { toFun := fun x =>
            (⟨(x.1 : G ⧸ H), by
                change ((g * x.1 : G) : G ⧸ H) = (x.1 : G ⧸ H)
                rw [eq_comm, QuotientGroup.eq, ← mul_assoc]
                exact x.2⟩,
              ⟨(Quotient.out (x.1 : G ⧸ H))⁻¹ * x.1,
                QuotientGroup.eq.mp (QuotientGroup.out_eq' (x.1 : G ⧸ H))⟩)
          invFun := fun p =>
            ⟨Quotient.out p.1.1 * p.2.1, by
              have h_u : (((Quotient.out p.1.1 * p.2.1 : G) : G ⧸ H)) = p.1.1 := h_out_mul p.1.1 p.2
              have h_fix : (((Quotient.out p.1.1 * p.2.1 : G) : G ⧸ H)) =
                  ((g * (Quotient.out p.1.1 * p.2.1) : G) : G ⧸ H) := by
                change _ = g • (((Quotient.out p.1.1 * p.2.1 : G) : G ⧸ H))
                rw [h_u]
                exact p.1.2.symm
              have h_mem := QuotientGroup.eq.mp h_fix
              rwa [← mul_assoc] at h_mem⟩
          left_inv := fun x => Subtype.ext (mul_inv_cancel_left (Quotient.out (x.1 : G ⧸ H)) x.1)
          right_inv := fun p => by
            rcases p with ⟨⟨u, hu⟩, h⟩
            have h_u : (((Quotient.out u * h.1 : G) : G ⧸ H)) = u := h_out_mul u h
            ext
            · exact h_u
            · dsimp only
              rw [h_u, inv_mul_cancel_left] }
      dsimp [fixedCosetCount]
      rw [← Nat.cast_mul, Nat.card_congr e_fib, Nat.card_prod]
    have h_conj_iff : ∀ (y : G), Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
        ∀ x : G, x⁻¹ * y * x ∈ H₀ ↔ x⁻¹ * y * x ∈ C₀ := by
      intro y hy x
      constructor
      · intro hx
        let h : H₀ := ⟨x⁻¹ * y * x, hx⟩
        have h_ord_h : orderOf h = orderOf y := by
          have h1 : orderOf h = orderOf (x⁻¹ * y * x) := Subgroup.orderOf_mk (x⁻¹ * y * x) hx
          have h2 : orderOf (x⁻¹ * y * x) = orderOf y := by
            simpa [MulAut.conj_apply] using (MulAut.conj x⁻¹).orderOf_eq y
          exact h1.trans h2
        have h_dvd_y : orderOf (ψ h) ∣ orderOf y := h_ord_h ▸ orderOf_map_dvd ψ h
        obtain ⟨k, hk⟩ := P₀.isPGroup' (ψ h)
        have h_dvd_pk : orderOf (ψ h) ∣ p ^ k := orderOf_dvd_of_pow_eq_one hk
        rw [Nat.card_zpowers] at hy
        have h_cop_pk : Nat.Coprime (p ^ k) (orderOf y) := hy.pow_left k
        have h_dvd_one : orderOf (ψ h) ∣ 1 := by
          rw [← h_cop_pk.gcd_eq_one]
          exact Nat.dvd_gcd h_dvd_pk h_dvd_y
        have h_ψh_one : ψ h = 1 := orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_one h_dvd_one)
        have h_in_ker : h ∈ ψ.ker := h_ψh_one
        rw [h_ker] at h_in_ker
        exact h_in_ker
      · intro hx
        exact hC₀H₀ hx
    have h_fixed_rel : ∀ (y : G), Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
        (Nat.card P₀.1 : ℤ) * fixedCosetCount H₀ y = fixedCosetCount C₀ y := by
      intro y hy
      have h_set_eq : {x : G | x⁻¹ * y * x ∈ H₀} = {x : G | x⁻¹ * y * x ∈ C₀} := by
        ext x
        exact h_conj_iff y hy x
      have h_eq_fib : fixedCosetCount H₀ y * (Nat.card H₀ : ℤ) =
          fixedCosetCount C₀ y * (Nat.card C₀ : ℤ) := by
        rw [← h_coset_fiber H₀ y, ← h_coset_fiber C₀ y, h_set_eq]
      rw [h_card_H₀, Nat.cast_mul, ← mul_assoc] at h_eq_fib
      have hC₀_ne : (Nat.card C₀ : ℤ) ≠ 0 := by
        have : 0 < Nat.card C₀ := Nat.card_pos
        omega
      have h_eq2 := mul_right_cancel₀ hC₀_ne h_eq_fib
      linarith
    have hP₀_ne : (Nat.card P₀.1 : ℤ) ≠ 0 := by
      have : 0 < Nat.card P₀.1 := Nat.card_pos
      omega
    have h_cyc_y₀ := h_cyc y₀
    refine ⟨H₀, hH₀_qe, ?_, ?_, ?_⟩
    · intro y hy h_lt
      have h_C₀_zero : fixedCosetCount C₀ y = 0 := h_cyc_y₀.2.1 y h_lt
      have h_rel := h_fixed_rel y hy
      rw [h_C₀_zero] at h_rel
      exact (mul_eq_zero.mp h_rel).resolve_left hP₀_ne
    · intro y hy h_eq h_nconj
      have h_C₀_zero : fixedCosetCount C₀ y = 0 := h_cyc_y₀.2.2.1 y h_eq h_nconj
      have h_rel := h_fixed_rel y hy
      rw [h_C₀_zero] at h_rel
      exact (mul_eq_zero.mp h_rel).resolve_left hP₀_ne
    · have h_C₀_y₀ : fixedCosetCount C₀ y₀ = (Nat.card P₀.1 : ℤ) * (P₀.1.index : ℤ) := by
        rw [h_cyc_y₀.2.2.2.2.1]
        dsimp [Subgroup.relIndex, C_N]
        rw [Subgroup.index_eq_card, ← Subgroup.card_mul_index P₀.1, Nat.cast_mul]
      have h_H₀_y₀ : fixedCosetCount H₀ y₀ = (P₀.1.index : ℤ) := by
        have h_rel := h_fixed_rel y₀ hy₀
        rw [h_C₀_y₀] at h_rel
        exact mul_left_cancel₀ hP₀_ne h_rel
      have hp_idx : Nat.Coprime p P₀.1.index :=
        (Nat.Prime.coprime_iff_not_dvd ‹Fact p.Prime›.out).mpr (Sylow.not_dvd_index P₀)
      refine ⟨p.gcdB P₀.1.index, p.gcdA P₀.1.index, ?_⟩
      have h_bez := Nat.gcd_eq_gcd_ab p P₀.1.index
      rw [hp_idx.gcd_eq_one, Nat.cast_one] at h_bez
      rw [h_H₀_y₀]
      linarith
  have h_s4 : ∃ Φ_p : G → ℤ, InQESpan Φ_p ∧
      ∀ y : G, Nat.Coprime p (Nat.card (Subgroup.zpowers y)) → (p : ℤ) ∣ (1 - Φ_p y) := by
    have h_add_qe : ∀ (Φ : G → ℤ), InQESpan Φ →
        ∀ (H₀ : Subgroup G), IsQuasiElementary H₀ →
        ∀ (c : ℤ), InQESpan (fun g => Φ g + c * fixedCosetCount H₀ g) := by
      intro Φ ⟨L_qe, hL_wf, hL_sum⟩ H₀ hH₀ c
      refine ⟨(c, H₀) :: L_qe, ?_, ?_⟩
      · intro q hq
        rw [List.mem_cons] at hq
        rcases hq with rfl | hq
        · exact hH₀
        · exact hL_wf q hq
      · intro g
        simp only [List.map_cons, List.sum_cons, hL_sum g]
        ring
    have h_conj_inv : ∀ (Φ : G → ℤ), InQESpan Φ →
        ∀ (y y₀ : G), Nat.card (Subgroup.zpowers y) = Nat.card (Subgroup.zpowers y₀) →
        (∃ x : G, x * y * x⁻¹ ∈ Subgroup.zpowers y₀) →
        Φ y = Φ y₀ := by
      intro Φ ⟨L_qe, _, hL_sum⟩ y y₀ h_card h_conj
      have h_eq_H : ∀ H : Subgroup G, fixedCosetCount H y = fixedCosetCount H y₀ :=
        (h_cyc y₀).2.2.2.1 y h_card h_conj
      rw [← hL_sum y, ← hL_sum y₀]
      congr 1
      apply List.map_congr_left
      intro q _
      rw [h_eq_H q.2]
    have h_clear_level : ∀ (n : ℕ) (k : ℕ) (Φ : G → ℤ),
        InQESpan Φ →
        (∀ y : G, Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
          n < Nat.card (Subgroup.zpowers y) → (p : ℤ) ∣ (1 - Φ y)) →
        (Finset.univ.filter (fun y : G =>
          Nat.Coprime p (Nat.card (Subgroup.zpowers y)) ∧
          Nat.card (Subgroup.zpowers y) = n ∧
          ¬ ((p : ℤ) ∣ (1 - Φ y)))).card = k →
        ∃ Φ_star : G → ℤ, InQESpan Φ_star ∧
          ∀ y : G, Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
            n ≤ Nat.card (Subgroup.zpowers y) → (p : ℤ) ∣ (1 - Φ_star y) := by
      intro n k
      induction' k using Nat.strong_induction_on with k ih
      intro Φ hΦ h_gt hk
      let B := fun (Ψ : G → ℤ) => Finset.univ.filter (fun y : G =>
        Nat.Coprime p (Nat.card (Subgroup.zpowers y)) ∧
        Nat.card (Subgroup.zpowers y) = n ∧
        ¬ ((p : ℤ) ∣ (1 - Ψ y)))
      rcases Nat.eq_zero_or_pos k with rfl | hk_pos
      · refine ⟨Φ, hΦ, fun y hy_cop hy_le => ?_⟩
        rcases lt_or_eq_of_le hy_le with hy_lt | hy_eq
        · exact h_gt y hy_cop hy_lt
        · by_contra h_ndvd
          have hy_mem : y ∈ B Φ :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ y, hy_cop, hy_eq.symm, h_ndvd⟩
          have h_empty : B Φ = ∅ := Finset.card_eq_zero.mp hk
          rw [h_empty] at hy_mem
          exact Finset.notMem_empty y hy_mem
      · have hB_nonempty : (B Φ).Nonempty := Finset.card_pos.mp (hk.symm ▸ hk_pos)
        obtain ⟨y₀, hy₀_mem⟩ := hB_nonempty
        have hy₀_props : Nat.Coprime p (Nat.card (Subgroup.zpowers y₀)) ∧
            Nat.card (Subgroup.zpowers y₀) = n ∧
            ¬ ((p : ℤ) ∣ (1 - Φ y₀)) := (Finset.mem_filter.mp hy₀_mem).2
        rcases hy₀_props with ⟨hy₀_cop, hy₀_card, hy₀_ndvd⟩
        obtain ⟨H₀, hH₀_qe, hH₀_gt, hH₀_eq, b, hb⟩ := h_s3 y₀ hy₀_cop
        let c : ℤ := (1 - Φ y₀) * b
        let Φ₁ : G → ℤ := fun g => Φ g + c * fixedCosetCount H₀ g
        have hΦ₁ : InQESpan Φ₁ := h_add_qe Φ hΦ H₀ hH₀_qe c
        have hΦ₁_gt : ∀ y : G, Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
            n < Nat.card (Subgroup.zpowers y) → (p : ℤ) ∣ (1 - Φ₁ y) := by
          intro y hy_cop hy_lt
          have h_zero : fixedCosetCount H₀ y = 0 := hH₀_gt y hy_cop (hy₀_card.symm ▸ hy_lt)
          dsimp [Φ₁]
          rw [h_zero, mul_zero, add_zero]
          exact h_gt y hy_cop hy_lt
        have hy₀_div : (p : ℤ) ∣ (1 - Φ₁ y₀) := by
          have h_id : 1 - Φ₁ y₀ = (1 - Φ y₀) * (1 - b * fixedCosetCount H₀ y₀) := by
            dsimp [Φ₁, c]
            ring
          rw [h_id]
          exact dvd_mul_of_dvd_right hb (1 - Φ y₀)
        have h_ssub : B Φ₁ ⊂ B Φ := by
          rw [Finset.ssubset_iff_subset_ne]
          refine ⟨?_, ?_⟩
          · intro y hy_mem1
            have hy1 : Nat.Coprime p (Nat.card (Subgroup.zpowers y)) ∧
                Nat.card (Subgroup.zpowers y) = n ∧
                ¬ ((p : ℤ) ∣ (1 - Φ₁ y)) := (Finset.mem_filter.mp hy_mem1).2
            rcases hy1 with ⟨hy_cop, hy_card, hy_ndvd1⟩
            have h_not_conj : ¬ ∃ x : G, x * y * x⁻¹ ∈ Subgroup.zpowers y₀ := by
              intro h_conj
              have h_card_eq : Nat.card (Subgroup.zpowers y) = Nat.card (Subgroup.zpowers y₀) :=
                hy_card.trans hy₀_card.symm
              have h_Φ₁_eq : Φ₁ y = Φ₁ y₀ := h_conj_inv Φ₁ hΦ₁ y y₀ h_card_eq h_conj
              rw [h_Φ₁_eq] at hy_ndvd1
              exact hy_ndvd1 hy₀_div
            have h_zero : fixedCosetCount H₀ y = 0 :=
              hH₀_eq y hy_cop (hy_card.trans hy₀_card.symm) h_not_conj
            have h_Φ₁_eq_Φ : Φ₁ y = Φ y := by
              dsimp [Φ₁]
              rw [h_zero, mul_zero, add_zero]
            rw [h_Φ₁_eq_Φ] at hy_ndvd1
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ y, hy_cop, hy_card, hy_ndvd1⟩
          · intro h_eq_set
            have hy₀_mem1 : y₀ ∈ B Φ₁ := h_eq_set ▸ hy₀_mem
            have hy₀_ndvd1 : ¬ ((p : ℤ) ∣ (1 - Φ₁ y₀)) := (Finset.mem_filter.mp hy₀_mem1).2.2.2
            exact hy₀_ndvd1 hy₀_div
        have hk₁_lt : (B Φ₁).card < k := hk ▸ Finset.card_lt_card h_ssub
        exact ih (B Φ₁).card hk₁_lt Φ₁ hΦ₁ hΦ₁_gt rfl
    have h_outer : ∀ d : ℕ, ∃ Φ : G → ℤ, InQESpan Φ ∧
        ∀ y : G, Nat.Coprime p (Nat.card (Subgroup.zpowers y)) →
          Fintype.card G - d < Nat.card (Subgroup.zpowers y) → (p : ℤ) ∣ (1 - Φ y) := by
      intro d
      induction d with
      | zero =>
        refine ⟨0, ⟨[], by simp, by simp⟩, fun y _ hy_lt => ?_⟩
        have h_le : Nat.card (Subgroup.zpowers y) ≤ Fintype.card G := by
          rw [Nat.card_zpowers]
          exact orderOf_le_card_univ
        omega
      | succ d ih_d =>
        rcases ih_d with ⟨Φ_d, hΦ_d, h_gt_d⟩
        obtain ⟨Φ_next, hΦ_next, h_le_next⟩ :=
          h_clear_level (Fintype.card G - d) _ Φ_d hΦ_d h_gt_d rfl
        refine ⟨Φ_next, hΦ_next, fun y hy_cop hy_lt => ?_⟩
        apply h_le_next y hy_cop
        omega
    obtain ⟨Φ_p, hΦ_p, h_all⟩ := h_outer (Fintype.card G)
    refine ⟨Φ_p, hΦ_p, fun y hy_cop => ?_⟩
    apply h_all y hy_cop
    rw [Nat.sub_self]
    exact Nat.card_pos
  obtain ⟨Φ_p, hΦ_p, h_cop_div⟩ := h_s4
  refine ⟨Φ_p, hΦ_p, fun g => ?_⟩
  have h1 : (p : ℤ) ∣ (1 - Φ_p (g ^ (p ^ Fintype.card G))) :=
    h_cop_div (g ^ (p ^ Fintype.card G)) (h_s2 g)
  have h2 : (p : ℤ) ∣ (Φ_p g - Φ_p (g ^ (p ^ Fintype.card G))) :=
    h_s1 Φ_p hΦ_p g
  have h_sub : 1 - Φ_p g =
      (1 - Φ_p (g ^ (p ^ Fintype.card G))) - (Φ_p g - Φ_p (g ^ (p ^ Fintype.card G))) := by
    ring
  rw [h_sub]
  exact dvd_sub h1 h2

theorem ld_solomon_quasi_elementary_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G] :
    ∃ (L_qe : List (ℤ × Subgroup G)),
      (∀ p ∈ L_qe, IsQuasiElementary p.2) ∧
      ∀ g : G,
        (L_qe.map fun p => p.1 • indCharTrace F p.2 1 g).sum = 1 :=
by
  have h_sub := ld_inQESpan_subring G
  have h_cyc := ld_cyclic_fixedCosetCount_props G
  have h_all_N : ∀ N : ℕ, 0 < N →
      ∃ Φ : G → ℤ, InQESpan Φ ∧ ∀ g : G, (N : ℤ) ∣ (1 - Φ g) := by
    intro N
    induction' N using Nat.strong_induction_on with N ih
    intro hN_pos
    by_cases hN1 : N = 1
    · subst hN1
      refine ⟨0, h_sub.1, fun g => by simp⟩
    · obtain ⟨p, hp_prime, hp_dvd⟩ := Nat.exists_prime_and_dvd hN1
      rcases hp_dvd with ⟨M, rfl⟩
      have hp_ge : 2 ≤ p := hp_prime.two_le
      have hM_pos : 0 < M := Nat.pos_of_mul_pos_left hN_pos
      have hM_lt : M < p * M := by nlinarith
      haveI : Fact p.Prime := ⟨hp_prime⟩
      obtain ⟨Φ_p, hΦ_p, hp_div⟩ := ld_prime_congruence_inQESpan G h_cyc p
      obtain ⟨Φ_M, hΦ_M, hM_div⟩ := ih M hM_lt hM_pos
      let Φ : G → ℤ := fun g => (Φ_p g + Φ_M g) - Φ_p g * Φ_M g
      have hΦ : InQESpan Φ :=
        h_sub.2.2.2.2.1 _ _ (h_sub.2.2.2.1 _ _ hΦ_p hΦ_M) (h_sub.2.2.2.2.2 _ _ hΦ_p hΦ_M)
      refine ⟨Φ, hΦ, fun g => ?_⟩
      have h_id : 1 - Φ g = (1 - Φ_p g) * (1 - Φ_M g) := by
        dsimp [Φ]
        ring
      rw [h_id, Nat.cast_mul]
      exact mul_dvd_mul (hp_div g) (hM_div g)
  have hG_pos : 0 < Fintype.card G := Fintype.card_pos
  have hPow_pos : 0 < (Fintype.card G) ^ (Fintype.card G) := Nat.pow_pos hG_pos
  obtain ⟨Φ_top, hΦ_top, h_div_top⟩ := h_all_N ((Fintype.card G) ^ (Fintype.card G)) hPow_pos
  have h_div_cast : ∀ g : G, ((Fintype.card G : ℤ) ^ (Fintype.card G)) ∣ (1 - Φ_top g) := by
    intro g
    have h := h_div_top g
    rwa [Nat.cast_pow] at h
  obtain ⟨L_qe, hL_wf, hL_sum⟩ :=
    ld_artin_divisibility_inQESpan G h_cyc Φ_top hΦ_top h_div_cast
  refine ⟨L_qe, hL_wf, fun g => ?_⟩
  have h_cast_list : ∀ (L : List (ℤ × Subgroup G)),
      (L.map fun p => p.1 • indCharTrace F p.2 1 g).sum =
        (((L.map fun p => p.1 * fixedCosetCount p.2 g).sum : ℤ) : Ω F) := by
    intro L
    induction L with
    | nil => simp
    | cons p tl ih_L =>
      simp only [List.map_cons, List.sum_cons, Int.cast_add, Int.cast_mul] at ih_L ⊢
      rw [ld_indCharTrace_one_eq_fixedCosetCount F G p.2 g, zsmul_eq_mul, ih_L]
  rw [h_cast_list L_qe, hL_sum g, Int.cast_one]

theorem ld_quasi_elementary_abelian_normal_exists (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (H : Subgroup G) (hH : IsQuasiElementary H) :
    (∀ (H' : Subgroup G), H' ≤ H → IsQuasiElementary H') ∧
    (∀ {V : Type u} [AddCommGroup V] [Module (Ω F) V]
      (τ : Representation (Ω F) H V),
      (∀ x y : H, τ x ∘ₗ τ y = τ y ∘ₗ τ x) ∨
      ∃ (A : Subgroup H) (_ : A.Normal),
        (∀ a b : A, τ a.1 ∘ₗ τ b.1 = τ b.1 ∘ₗ τ a.1) ∧
        ∃ a ∈ A, ∃ h : H, τ a ∘ₗ τ h ≠ τ h ∘ₗ τ a) :=
by
  rcases hH with ⟨p, C, hp, hC_norm, hC_cyc, hP⟩
  haveI : Fact p.Prime := hp
  haveI : C.Normal := hC_norm
  refine ⟨?_, ?_⟩
  · intro H' hle
    let ι : H' →* H := Subgroup.inclusion hle
    have hι : Function.Injective ι := Subgroup.inclusion_injective hle
    let C' : Subgroup H' := C.comap ι
    have hC'_norm : C'.Normal := @Subgroup.normal_comap H' _ H _ C hC_norm ι
    haveI : C'.Normal := hC'_norm
    let e_C : C' →* C :=
      { toFun := fun x => ⟨ι x.1, x.2⟩
        map_one' := Subtype.ext (map_one ι)
        map_mul' := fun x y => Subtype.ext (map_mul ι x.1 y.1) }
    have he_C : Function.Injective e_C := by
      intro x y hxy
      exact Subtype.ext (hι (congrArg Subtype.val hxy))
    have hC'_cyc : IsCyclic C' := @isCyclic_of_injective C' C _ _ hC_cyc e_C he_C
    let ϕ : H' →* H ⧸ C := (QuotientGroup.mk' C).comp ι
    have hC'_ker : C' ≤ ϕ.ker := by
      intro x hx
      rw [MonoidHom.mem_ker, MonoidHom.comp_apply]
      exact (QuotientGroup.eq_one_iff (ι x)).mpr hx
    let bar_ϕ : H' ⧸ C' →* H ⧸ C := QuotientGroup.lift C' ϕ hC'_ker
    have hbar_inj : Function.Injective bar_ϕ := by
      rw [injective_iff_map_eq_one]
      intro q hq
      refine QuotientGroup.induction_on q (fun x => ?_) hq
      intro hx
      rw [QuotientGroup.lift_mk', MonoidHom.comp_apply] at hx
      exact (QuotientGroup.eq_one_iff x).mpr ((QuotientGroup.eq_one_iff (ι x)).mp hx)
    exact ⟨p, C', hp, hC'_norm, hC'_cyc, IsPGroup.of_injective hP bar_ϕ hbar_inj⟩
  · intro V _ _ τ
    have hτ_comp : ∀ x y : H, τ x ∘ₗ τ y = τ (x * y) := fun x y => by
      rw [map_mul, Module.End.mul_eq_comp]
    have hτ_cong : ∀ a b c d : H, τ b = τ c → τ (a * b * d) = τ (a * c * d) := by
      intro a b c d hbc
      rw [← hτ_comp, ← hτ_comp a b, hbc, hτ_comp a c, hτ_comp]
    by_cases h_ab : ∀ x y : H, τ x ∘ₗ τ y = τ y ∘ₗ τ x
    · exact Or.inl h_ab
    · refine Or.inr ?_
      let Z_τ : Subgroup H :=
        { carrier := {z : H | ∀ h : H, τ z ∘ₗ τ h = τ h ∘ₗ τ z}
          one_mem' := fun h => by rw [hτ_comp, hτ_comp, one_mul, mul_one]
          mul_mem' := fun {z₁ z₂} hz₁ hz₂ h => by
            rw [map_mul, Module.End.mul_eq_comp, LinearMap.comp_assoc, hz₂ h,
              ← LinearMap.comp_assoc, hz₁ h, LinearMap.comp_assoc]
          inv_mem' := fun {z} hz h => by
            rw [hτ_comp, hτ_comp]
            have h1 : τ (z * h) = τ (h * z) := by rw [← hτ_comp z h, ← hτ_comp h z, hz h]
            have h2 := hτ_cong z⁻¹ (h * z) (z * h) z⁻¹ h1.symm
            have hg1 : z⁻¹ * (h * z) * z⁻¹ = z⁻¹ * h := by group
            have hg2 : z⁻¹ * (z * h) * z⁻¹ = h * z⁻¹ := by group
            rwa [hg1, hg2] at h2 }
      have hZ_norm : Z_τ.Normal := ⟨fun z hz g h => by
        change τ (g * z * g⁻¹) ∘ₗ τ h = τ h ∘ₗ τ (g * z * g⁻¹)
        rw [hτ_comp, hτ_comp]
        have h1 : τ (z * (g⁻¹ * h * g)) = τ ((g⁻¹ * h * g) * z) := by
          rw [← hτ_comp z (g⁻¹ * h * g), ← hτ_comp (g⁻¹ * h * g) z, hz (g⁻¹ * h * g)]
        have h2 := hτ_cong g (z * (g⁻¹ * h * g)) ((g⁻¹ * h * g) * z) g⁻¹ h1
        have hg1 : g * (z * (g⁻¹ * h * g)) * g⁻¹ = g * z * g⁻¹ * h := by group
        have hg2 : g * ((g⁻¹ * h * g) * z) * g⁻¹ = h * (g * z * g⁻¹) := by group
        rwa [hg1, hg2] at h2⟩
      haveI : Z_τ.Normal := hZ_norm
      by_cases hCZ : C ≤ Z_τ
      · let π_Z : H →* H ⧸ Z_τ := QuotientGroup.mk' Z_τ
        have hπ_Z_eq_one : ∀ x : H, π_Z x = 1 ↔ x ∈ Z_τ := fun x => QuotientGroup.eq_one_iff x
        have hC_ker : C ≤ π_Z.ker := by
          intro x hx
          rw [MonoidHom.mem_ker, hπ_Z_eq_one]
          exact hCZ hx
        let f_quot : H ⧸ C →* H ⧸ Z_τ := QuotientGroup.lift C π_Z hC_ker
        have hf_surj : Function.Surjective f_quot := by
          intro q
          obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective Z_τ q
          exact ⟨QuotientGroup.mk' C x, QuotientGroup.lift_mk' C hC_ker x⟩
        have hP_Z : IsPGroup p (H ⧸ Z_τ) := IsPGroup.of_surjective hP f_quot hf_surj
        have h_nontriv : Nontrivial (H ⧸ Z_τ) := by
          push_neg at h_ab
          rcases h_ab with ⟨x₀, y₀, hxy₀⟩
          have hx₀ : x₀ ∉ Z_τ := fun hx => hxy₀ (hx y₀)
          have h_ne : π_Z x₀ ≠ 1 := by
            rwa [ne_eq, hπ_Z_eq_one]
          exact (nontrivial_iff_exists_ne (1 : H ⧸ Z_τ)).mpr ⟨π_Z x₀, h_ne⟩
        haveI : Nontrivial (H ⧸ Z_τ) := h_nontriv
        have h_cent : ⊥ < Subgroup.center (H ⧸ Z_τ) := hP_Z.bot_lt_center
        rw [bot_lt_iff_ne_bot, Subgroup.ne_bot_iff_exists_ne_one] at h_cent
        rcases h_cent with ⟨q₀, hq₀_ne⟩
        obtain ⟨z₀, hz₀⟩ := QuotientGroup.mk'_surjective Z_τ q₀.1
        have hz₀_ne_one : π_Z z₀ ≠ 1 := by
          change QuotientGroup.mk' Z_τ z₀ ≠ 1
          rw [hz₀]
          exact fun h => hq₀_ne (Subtype.ext h)
        have hz₀_not_Z : z₀ ∉ Z_τ := by
          rwa [ne_eq, hπ_Z_eq_one] at hz₀_ne_one
        have hz₀_cent : π_Z z₀ ∈ Subgroup.center (H ⧸ Z_τ) := by
          change QuotientGroup.mk' Z_τ z₀ ∈ Subgroup.center (H ⧸ Z_τ)
          rw [hz₀]
          exact q₀.2
        let A : Subgroup H := (Subgroup.zpowers (π_Z z₀)).comap π_Z
        have hA_norm : A.Normal := ⟨fun a ha g => by
          change π_Z (g * a * g⁻¹) ∈ Subgroup.zpowers (π_Z z₀)
          change π_Z a ∈ Subgroup.zpowers (π_Z z₀) at ha
          rcases Subgroup.mem_zpowers_iff.mp ha with ⟨k, hk⟩
          have h_cent_a : π_Z a ∈ Subgroup.center (H ⧸ Z_τ) :=
            hk ▸ Subgroup.zpow_mem _ hz₀_cent k
          have h_comm : π_Z g * π_Z a = π_Z a * π_Z g :=
            Subgroup.mem_center_iff.mp h_cent_a (π_Z g)
          rw [map_mul, map_mul, map_inv, h_comm, mul_inv_cancel_right]
          exact ha⟩
        have hA_ab : ∀ a b : A, τ a.1 ∘ₗ τ b.1 = τ b.1 ∘ₗ τ a.1 := by
          intro a b
          rcases Subgroup.mem_zpowers_iff.mp a.2 with ⟨m, hm⟩
          rcases Subgroup.mem_zpowers_iff.mp b.2 with ⟨n, hn⟩
          let u : H := (z₀ ^ m)⁻¹ * a.1
          let v : H := (z₀ ^ n)⁻¹ * b.1
          have hu : u ∈ Z_τ := by
            rw [← hπ_Z_eq_one]
            change π_Z ((z₀ ^ m)⁻¹ * a.1) = 1
            rw [map_mul, map_inv, map_zpow, hm, inv_mul_cancel]
          have hv : v ∈ Z_τ := by
            rw [← hπ_Z_eq_one]
            change π_Z ((z₀ ^ n)⁻¹ * b.1) = 1
            rw [map_mul, map_inv, map_zpow, hn, inv_mul_cancel]
          have ha_eq : a.1 = z₀ ^ m * u := by
            dsimp [u]
            group
          have hb_eq : b.1 = z₀ ^ n * v := by
            dsimp [v]
            group
          have h_zm_zn : τ (z₀ ^ m) ∘ₗ τ (z₀ ^ n) = τ (z₀ ^ n) ∘ₗ τ (z₀ ^ m) := by
            rw [hτ_comp, hτ_comp, zpow_mul_comm z₀ m n]
          calc τ a.1 ∘ₗ τ b.1
              = (τ (z₀ ^ m) ∘ₗ τ u) ∘ₗ (τ (z₀ ^ n) ∘ₗ τ v) := by
                rw [ha_eq, hb_eq, hτ_comp (z₀ ^ m) u, hτ_comp (z₀ ^ n) v]
            _ = τ (z₀ ^ m) ∘ₗ (τ u ∘ₗ τ (z₀ ^ n)) ∘ₗ τ v := by
                simp only [LinearMap.comp_assoc]
            _ = τ (z₀ ^ m) ∘ₗ (τ (z₀ ^ n) ∘ₗ τ u) ∘ₗ τ v := by
                rw [hu (z₀ ^ n)]
            _ = (τ (z₀ ^ m) ∘ₗ τ (z₀ ^ n)) ∘ₗ (τ u ∘ₗ τ v) := by
                simp only [LinearMap.comp_assoc]
            _ = (τ (z₀ ^ n) ∘ₗ τ (z₀ ^ m)) ∘ₗ (τ v ∘ₗ τ u) := by
                rw [h_zm_zn, hu v]
            _ = τ (z₀ ^ n) ∘ₗ (τ (z₀ ^ m) ∘ₗ τ v) ∘ₗ τ u := by
                simp only [LinearMap.comp_assoc]
            _ = τ (z₀ ^ n) ∘ₗ (τ v ∘ₗ τ (z₀ ^ m)) ∘ₗ τ u := by
                rw [← hv (z₀ ^ m)]
            _ = (τ (z₀ ^ n) ∘ₗ τ v) ∘ₗ (τ (z₀ ^ m) ∘ₗ τ u) := by
                simp only [LinearMap.comp_assoc]
            _ = τ b.1 ∘ₗ τ a.1 := by
                rw [hτ_comp (z₀ ^ n) v, hτ_comp (z₀ ^ m) u, ← hb_eq, ← ha_eq]
        have hz₀_A : z₀ ∈ A := by
          change π_Z z₀ ∈ Subgroup.zpowers (π_Z z₀)
          exact Subgroup.mem_zpowers (π_Z z₀)
        have h_not_all : ¬ ∀ h : H, τ z₀ ∘ₗ τ h = τ h ∘ₗ τ z₀ := hz₀_not_Z
        push_neg at h_not_all
        rcases h_not_all with ⟨h, hh⟩
        exact ⟨A, hA_norm, hA_ab, ⟨z₀, hz₀_A, h, hh⟩⟩
      · letI : CommGroup C := @IsCyclic.commGroup C _ hC_cyc
        have hC_ab : ∀ a b : C, τ a.1 ∘ₗ τ b.1 = τ b.1 ∘ₗ τ a.1 := by
          intro a b
          have hab : a.1 * b.1 = b.1 * a.1 := congrArg Subtype.val (mul_comm a b)
          rw [hτ_comp, hτ_comp, hab]
        obtain ⟨a, haC, haZ⟩ := Set.not_subset.mp hCZ
        have h_not_all : ¬ ∀ h : H, τ a ∘ₗ τ h = τ h ∘ₗ τ a := haZ
        push_neg at h_not_all
        rcases h_not_all with ⟨h, hh⟩
        exact ⟨C, hC_norm, hC_ab, ⟨a, haC, h, hh⟩⟩

theorem ld_abelian_rep_irr_trace_eq_char (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (H : Type u) [Group H]
    {V : Type u} [AddCommGroup V] [Module (Ω F) V] [FiniteDimensional (Ω F) V] [Nontrivial V]
    (τ : Representation (Ω F) H V)
    (h_irr : ∀ W : Submodule (Ω F) V,
      (∀ h : H, W ≤ Submodule.comap (τ h) W) → W = ⊥ ∨ W = ⊤)
    (h_ab : ∀ x y : H, τ x ∘ₗ τ y = τ y ∘ₗ τ x) :
    ∃ ψ : H →* (Ω F)ˣ,
      ∀ h : H, LinearMap.trace (Ω F) V (τ h) = (ψ h : Ω F) :=
by
  have h_scal : ∀ h : H, ∃ c : Ω F, τ h = c • (1 : V →ₗ[Ω F] V) := by
    intro h
    obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue (τ h)
    obtain ⟨v, hv_mem, hv_ne⟩ := hc.exists_hasEigenvector
    have hW_ne_bot : Module.End.eigenspace (τ h) c ≠ ⊥ := by
      intro hbot
      change v ∈ Module.End.eigenspace (τ h) c at hv_mem
      rw [hbot] at hv_mem
      exact hv_ne hv_mem
    have hW_inv : ∀ g : H, Module.End.eigenspace (τ h) c ≤
        Submodule.comap (τ g) (Module.End.eigenspace (τ h) c) := by
      intro g x hx
      rw [Submodule.mem_comap, Module.End.mem_eigenspace_iff]
      rw [Module.End.mem_eigenspace_iff] at hx
      have h1 : (τ h ∘ₗ τ g) x = (τ g ∘ₗ τ h) x := by
        rw [h_ab h g]
      change τ h (τ g x) = τ g (τ h x) at h1
      rw [h1, hx, map_smul]
    have hW_top : Module.End.eigenspace (τ h) c = ⊤ :=
      (h_irr _ hW_inv).resolve_left hW_ne_bot
    refine ⟨c, LinearMap.ext fun x => ?_⟩
    have hx : x ∈ Module.End.eigenspace (τ h) c :=
      hW_top.symm ▸ Submodule.mem_top
    rw [Module.End.mem_eigenspace_iff] at hx
    simpa using hx
  choose c hc using h_scal
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
  have h_inj : ∀ a b : Ω F, a • (1 : V →ₗ[Ω F] V) = b • (1 : V →ₗ[Ω F] V) → a = b := by
    intro a b hab
    have h1 := LinearMap.congr_fun hab v₀
    simp only [LinearMap.smul_apply, Module.End.one_apply] at h1
    have h2 : (a - b) • v₀ = 0 := by rw [sub_smul, h1, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h2).resolve_right hv₀)
  have hc_one : c 1 = 1 := by
    apply h_inj
    rw [← hc 1, map_one, one_smul]
  have hc_mul : ∀ x y : H, c (x * y) = c x * c y := by
    intro x y
    apply h_inj
    rw [← hc (x * y), map_mul, hc x, hc y, smul_mul_smul_comm, mul_one]
  let ψ : H →* (Ω F)ˣ :=
    { toFun := fun h =>
        { val := c h
          inv := c h⁻¹
          val_inv := by rw [← hc_mul, mul_inv_cancel, hc_one]
          inv_val := by rw [← hc_mul, inv_mul_cancel, hc_one] }
      map_one' := Units.ext hc_one
      map_mul' := fun x y => Units.ext (hc_mul x y) }
  let W₀ : Submodule (Ω F) V := Submodule.span (Ω F) {v₀}
  have hW₀_ne_bot : W₀ ≠ ⊥ := by
    intro hbot
    have hv₀_mem : v₀ ∈ W₀ := Submodule.mem_span_singleton_self v₀
    rw [hbot, Submodule.mem_bot] at hv₀_mem
    exact hv₀ hv₀_mem
  have hW₀_inv : ∀ h : H, W₀ ≤ Submodule.comap (τ h) W₀ := by
    intro h x hx
    rw [Submodule.mem_comap, hc h, LinearMap.smul_apply, Module.End.one_apply]
    exact W₀.smul_mem (c h) hx
  have hW₀_top : W₀ = ⊤ :=
    (h_irr W₀ hW₀_inv).resolve_left hW₀_ne_bot
  have h_finrank : Module.finrank (Ω F) V = 1 := by
    rw [← finrank_top (Ω F) V, ← hW₀_top, finrank_span_singleton hv₀]
  refine ⟨ψ, fun h => ?_⟩
  rw [hc h, LinearMap.map_smul, LinearMap.trace_one, h_finrank]
  simp [ψ]

theorem ld_clifford_noncentral_abelian_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (H : Type u) [Group H] [Fintype H]
    {V : Type u} [AddCommGroup V] [Module (Ω F) V] [FiniteDimensional (Ω F) V] [Nontrivial V]
    (τ : Representation (Ω F) H V)
    (h_irr : ∀ W : Submodule (Ω F) V,
      (∀ h : H, W ≤ Submodule.comap (τ h) W) → W = ⊥ ∨ W = ⊤)
    (A : Subgroup H) [A.Normal]
    (hA_ab : ∀ a b : A, τ a.1 ∘ₗ τ b.1 = τ b.1 ∘ₗ τ a.1)
    (hA_nc : ∃ a ∈ A, ∃ h : H, τ a ∘ₗ τ h ≠ τ h ∘ₗ τ a) :
    ∃ (H₀ : Subgroup H) (W : Submodule (Ω F) V) (τ₀ : Representation (Ω F) H₀ W),
      Nat.card H₀ < Nat.card H ∧
      ∀ h : H,
        LinearMap.trace (Ω F) V (τ h) =
          (Nat.card H₀ : Ω F)⁻¹ *
            ∑ y : H,
              if hy : y * h * y⁻¹ ∈ H₀ then
                LinearMap.trace (Ω F) W (τ₀ ⟨y * h * y⁻¹, hy⟩)
              else 0 :=
by
  
  let E : Finset A → (A → Ω F) → Submodule (Ω F) V := fun S μ =>
    { carrier := {v : V | ∀ a ∈ S, τ a.1 v = μ a • v}
      zero_mem' := fun a _ => by simp
      add_mem' := fun {x y} hx hy a ha => by
        change τ a.1 (x + y) = μ a • (x + y)
        rw [map_add, hx a ha, hy a ha, smul_add]
      smul_mem' := fun c {x} hx a ha => by
        change τ a.1 (c • x) = μ a • (c • x)
        rw [map_smul, hx a ha, smul_comm c (μ a)] }
  have h_fin : ∀ S : Finset A, ∃ μ : A → Ω F, E S μ ≠ ⊥ := by
    intro S
    induction' S using Finset.induction_on with b S₀ hb ih
    · obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
      refine ⟨0, (Submodule.ne_bot_iff _).mpr ⟨v₀, ?_, hv₀⟩⟩
      intro a ha
      simp at ha
    · rcases ih with ⟨μ₀, hW₀_ne⟩
      let W₀ := E S₀ μ₀
      have hW₀_inv : ∀ x ∈ W₀, τ b.1 x ∈ W₀ := by
        intro x hx a ha
        have h_comm : (τ a.1 ∘ₗ τ b.1) x = (τ b.1 ∘ₗ τ a.1) x := by
          rw [hA_ab a b]
        change τ a.1 (τ b.1 x) = τ b.1 (τ a.1 x) at h_comm
        have hxa : τ a.1 x = μ₀ a • x := hx a ha
        change τ a.1 (τ b.1 x) = μ₀ a • τ b.1 x
        rw [h_comm, hxa, map_smul]
      haveI : Nontrivial W₀ := Submodule.nontrivial_iff_ne_bot.mpr hW₀_ne
      let f_b : W₀ →ₗ[Ω F] W₀ := (τ b.1).restrict hW₀_inv
      obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue f_b
      obtain ⟨w, hw_mem, hw_ne⟩ := hc.exists_hasEigenvector
      have hw_eq : f_b w = c • w := Module.End.mem_eigenspace_iff.mp hw_mem
      have h_bw : τ b.1 w.1 = c • w.1 := congr_arg Subtype.val hw_eq
      have hw_val_ne : w.1 ≠ 0 := fun h0 => hw_ne (Subtype.ext h0)
      let μ : A → Ω F := Function.update μ₀ b c
      refine ⟨μ, (Submodule.ne_bot_iff _).mpr ⟨w.1, ?_, hw_val_ne⟩⟩
      intro a ha
      change τ a.1 w.1 = μ a • w.1
      rcases Finset.mem_insert.mp ha with rfl | ha_S₀
      · dsimp only [μ]
        rw [Function.update_self]
        exact h_bw
      · have hab : a ≠ b := fun h => hb (h ▸ ha_S₀)
        dsimp only [μ]
        rw [Function.update_of_ne hab]
        exact w.2 a ha_S₀
  obtain ⟨lam, h_ne_bot⟩ := h_fin Finset.univ
  obtain ⟨v₀, hv₀_mem, hv₀_ne⟩ := (Submodule.ne_bot_iff _).mp h_ne_bot
  have hlam : ∀ a : A, τ a.1 v₀ = lam a • v₀ := fun a => hv₀_mem a (Finset.mem_univ a)
  have h_indep : ∀ {ι : Type u} [DecidableEq ι] (μ : ι → (A → Ω F)),
      Function.Injective μ →
      ∀ (S : Finset ι) (f : ι → V),
        (∀ i ∈ S, ∀ a : A, τ a.1 (f i) = μ i a • f i) →
        ∑ i ∈ S, f i = 0 →
        ∀ i ∈ S, f i = 0 := by
    intro ι _ μ hμ_inj S
    induction' S using Finset.induction_on with i₀ S₀ hi₀ ih
    · intro f _ _ i hi
      simp at hi
    · intro f hf hsum
      rw [Finset.sum_insert hi₀] at hsum
      have h_ann : ∀ (a : A) (i : ι), i ∈ S₀ → (μ i a - μ i₀ a) • f i = 0 := by
        intro a
        apply ih (fun i => (μ i a - μ i₀ a) • f i)
        · intro i hi b
          have hfi : τ b.1 (f i) = μ i b • f i := hf i (Finset.mem_insert_of_mem hi) b
          rw [map_smul, hfi, smul_comm]
        · have h_term : ∀ i ∈ S₀, (μ i a - μ i₀ a) • f i = τ a.1 (f i) - μ i₀ a • f i := by
            intro i hi
            rw [sub_smul, hf i (Finset.mem_insert_of_mem hi) a]
          have h_sum_eq : (∑ i ∈ S₀, (μ i a - μ i₀ a) • f i) =
              ∑ i ∈ S₀, (τ a.1 (f i) - μ i₀ a • f i) :=
            Finset.sum_congr rfl h_term
          have h_i₀ : τ a.1 (f i₀) - μ i₀ a • f i₀ = 0 := by
            rw [hf i₀ (Finset.mem_insert_self i₀ S₀) a, sub_self]
          rw [h_sum_eq, Finset.sum_sub_distrib, ← map_sum, ← Finset.smul_sum]
          calc τ a.1 (∑ x ∈ S₀, f x) - μ i₀ a • ∑ x ∈ S₀, f x
              = (τ a.1 (f i₀) - μ i₀ a • f i₀) +
                  (τ a.1 (∑ x ∈ S₀, f x) - μ i₀ a • ∑ x ∈ S₀, f x) := by
                rw [h_i₀, zero_add]
            _ = τ a.1 (f i₀ + ∑ x ∈ S₀, f x) - μ i₀ a • (f i₀ + ∑ x ∈ S₀, f x) := by
                rw [map_add, smul_add]
                abel
            _ = 0 := by
                rw [hsum, map_zero, smul_zero, sub_self]
      have hS₀ : ∀ i ∈ S₀, f i = 0 := by
        intro i hi
        have h_ne : i ≠ i₀ := fun h => hi₀ (h ▸ hi)
        have hμ_ne : μ i ≠ μ i₀ := hμ_inj.ne h_ne
        obtain ⟨a, ha⟩ := Function.ne_iff.mp hμ_ne
        have h_sub_ne : μ i a - μ i₀ a ≠ 0 := sub_ne_zero.mpr ha
        exact (smul_eq_zero.mp (h_ann a i hi)).resolve_left h_sub_ne
      have h_sum_zero : ∑ i ∈ S₀, f i = 0 := Finset.sum_eq_zero hS₀
      have h_fi₀ : f i₀ = 0 := by
        rw [h_sum_zero, add_zero] at hsum
        exact hsum
      intro i hi
      rcases Finset.mem_insert.mp hi with rfl | hi_S₀
      · exact h_fi₀
      · exact hS₀ i hi_S₀
  
  have hA_norm : A.Normal := inferInstance
  have h_conj : ∀ (x : H) (a : A), x⁻¹ * a.1 * x ∈ A := by
    intro x a
    have h1 := hA_norm.conj_mem a.1 a.2 x⁻¹
    simpa [mul_assoc] using h1
  let shift : H → (A → Ω F) → (A → Ω F) :=
    fun x μ a => μ ⟨x⁻¹ * a.1 * x, h_conj x a⟩
  have h_shift_one : ∀ μ : A → Ω F, shift 1 μ = μ := by
    intro μ
    funext a
    dsimp only [shift]
    congr 1
    apply Subtype.ext
    group
  have h_shift_mul : ∀ (x y : H) (μ : A → Ω F), shift (x * y) μ = shift x (shift y μ) := by
    intro x y μ
    funext a
    dsimp only [shift]
    congr 1
    apply Subtype.ext
    group
  have h_shift_vec : ∀ (x : H) (μ : A → Ω F) (v : V),
      (∀ a : A, τ a.1 v = μ a • v) →
      ∀ a : A, τ a.1 (τ x v) = shift x μ a • (τ x v) := by
    intro x μ v hv a
    have h_grp : a.1 * x = x * (x⁻¹ * a.1 * x) := by group
    calc τ a.1 (τ x v)
        = (τ a.1 * τ x) v := rfl
      _ = τ (a.1 * x) v := by rw [← map_mul]
      _ = τ (x * (x⁻¹ * a.1 * x)) v := by rw [h_grp]
      _ = τ x (τ (x⁻¹ * a.1 * x) v) := by rw [map_mul, Module.End.mul_apply]
      _ = τ x (shift x μ a • v) := by rw [hv ⟨x⁻¹ * a.1 * x, h_conj x a⟩]
      _ = shift x μ a • (τ x v) := map_smul (τ x) (shift x μ a) v
  let W : Submodule (Ω F) V :=
    { carrier := {v : V | ∀ a : A, τ a.1 v = lam a • v}
      zero_mem' := fun a => by simp
      add_mem' := fun {x y} hx hy a => by
        change τ a.1 (x + y) = lam a • (x + y)
        rw [map_add, hx a, hy a, smul_add]
      smul_mem' := fun c {x} hx a => by
        change τ a.1 (c • x) = lam a • (c • x)
        rw [map_smul, hx a, smul_comm c (lam a)] }
  have hv₀_W : v₀ ∈ W := hlam
  let H₀ : Subgroup H :=
    { carrier := {x : H | shift x lam = lam}
      one_mem' := h_shift_one lam
      mul_mem' := fun {x y} hx hy => by
        change shift (x * y) lam = lam
        rw [h_shift_mul, hy, hx]
      inv_mem' := fun {x} hx => by
        change shift x⁻¹ lam = lam
        have h1 : shift x⁻¹ (shift x lam) = shift x⁻¹ lam := by rw [hx]
        rw [← h_shift_mul, inv_mul_cancel, h_shift_one] at h1
        exact h1.symm }
  have hW_inv : ∀ k : H₀, W ≤ Submodule.comap (τ k.1) W := by
    intro k v hv a
    change τ a.1 (τ k.1 v) = lam a • (τ k.1 v)
    have h1 := h_shift_vec k.1 lam v hv a
    have hk : shift k.1 lam = lam := k.2
    rw [hk] at h1
    exact h1
  let τ₀ : Representation (Ω F) H₀ W := subRep (τ.comp H₀.subtype) W hW_inv
  have hτ₀ : ∀ (k : H₀) (w : W), (τ₀ k w).1 = τ k.1 w.1 := fun _ _ => rfl
  have hH₀_ne_top : H₀ ≠ ⊤ := by
    intro h_top
    have hW_H : ∀ h : H, W ≤ Submodule.comap (τ h) W := by
      intro h
      have hh : h ∈ H₀ := h_top.symm ▸ Subgroup.mem_top h
      exact hW_inv ⟨h, hh⟩
    have hW_ne_bot : W ≠ ⊥ := (Submodule.ne_bot_iff W).mpr ⟨v₀, hv₀_W, hv₀_ne⟩
    have hW_top : W = ⊤ := (h_irr W hW_H).resolve_left hW_ne_bot
    rcases hA_nc with ⟨a₀, ha₀, h₀, h_nc⟩
    apply h_nc
    apply LinearMap.ext
    intro v
    have hv_W : v ∈ W := hW_top.symm ▸ Submodule.mem_top
    have hτv_W : τ h₀ v ∈ W := hW_top.symm ▸ Submodule.mem_top
    have h1 : τ a₀ (τ h₀ v) = lam ⟨a₀, ha₀⟩ • (τ h₀ v) := hτv_W ⟨a₀, ha₀⟩
    have h2 : τ a₀ v = lam ⟨a₀, ha₀⟩ • v := hv_W ⟨a₀, ha₀⟩
    change τ a₀ (τ h₀ v) = τ h₀ (τ a₀ v)
    rw [h1, h2, map_smul]
  have h_card_le : Nat.card H₀ ≤ Nat.card H :=
    Nat.le_of_dvd Nat.card_pos (Subgroup.card_subgroup_dvd_card H₀)
  have h_card_ne : Nat.card H₀ ≠ Nat.card H :=
    fun h_eq => hH₀_ne_top (Subgroup.eq_top_of_card_eq H₀ h_eq)
  have h_card_lt : Nat.card H₀ < Nat.card H :=
    lt_of_le_of_ne h_card_le h_card_ne
  let Ψ : ((H ⧸ H₀) → W) →ₗ[Ω F] V :=
    ∑ u : H ⧸ H₀, ((τ (cosetRep u)).comp W.subtype).comp
      (LinearMap.proj (R := Ω F) (φ := fun _ => W) u)
  have hΨ_apply : ∀ φ : (H ⧸ H₀) → W, Ψ φ = ∑ u : H ⧸ H₀, τ (cosetRep u) (φ u).1 := by
    intro φ
    dsimp only [Ψ]
    rw [LinearMap.sum_apply]
    rfl
  have hΨ_single : ∀ (u : H ⧸ H₀) (w : W),
      Ψ (LinearMap.single (Ω F) (fun _ => W) u w) = τ (cosetRep u) w.1 := by
    intro u w
    rw [hΨ_apply, Finset.sum_eq_single u]
    · rw [LinearMap.single_apply, Pi.single_eq_same]
    · intro u' _ hu'
      rw [LinearMap.single_apply, Pi.single_eq_of_ne hu', Submodule.coe_zero, map_zero]
    · intro hu
      exact False.elim (hu (Finset.mem_univ u))
  have hΨ_inj : Function.Injective Ψ := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro φ hφ
    rw [LinearMap.mem_ker, hΨ_apply] at hφ
    let μ_coset : (H ⧸ H₀) → (A → Ω F) := fun u => shift (cosetRep u) lam
    have hμ_inj : Function.Injective μ_coset := by
      intro u₁ u₂ h_eq
      change shift (cosetRep u₁) lam = shift (cosetRep u₂) lam at h_eq
      have h1 : shift (cosetRep u₁)⁻¹ (shift (cosetRep u₁) lam) =
          shift (cosetRep u₁)⁻¹ (shift (cosetRep u₂) lam) := by
        rw [h_eq]
      rw [← h_shift_mul, ← h_shift_mul, inv_mul_cancel, h_shift_one] at h1
      have h_mem : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ H₀ := h1.symm
      have hq : (QuotientGroup.mk (cosetRep u₁) : H ⧸ H₀) = QuotientGroup.mk (cosetRep u₂) :=
        QuotientGroup.eq.mpr h_mem
      have h_out₁ : (QuotientGroup.mk (cosetRep u₁) : H ⧸ H₀) = u₁ := Quotient.out_eq u₁
      have h_out₂ : (QuotientGroup.mk (cosetRep u₂) : H ⧸ H₀) = u₂ := Quotient.out_eq u₂
      rw [← h_out₁, ← h_out₂, hq]
    have h_terms : ∀ u ∈ (Finset.univ : Finset (H ⧸ H₀)),
        ∀ a : A, τ a.1 (τ (cosetRep u) (φ u).1) = μ_coset u a • (τ (cosetRep u) (φ u).1) := by
      intro u _ a
      exact h_shift_vec (cosetRep u) lam (φ u).1 (φ u).2 a
    have h_zero := h_indep μ_coset hμ_inj Finset.univ (fun u => τ (cosetRep u) (φ u).1) h_terms hφ
    funext u
    have hu : τ (cosetRep u) (φ u).1 = 0 := h_zero u (Finset.mem_univ u)
    have hu' : τ (cosetRep u)⁻¹ (τ (cosetRep u) (φ u).1) = 0 := by
      rw [hu, map_zero]
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply] at hu'
    exact Subtype.ext hu'
  have hΨ_surj : Function.Surjective Ψ := by
    rw [← LinearMap.range_eq_top]
    have h_range_inv : ∀ h : H, LinearMap.range Ψ ≤ Submodule.comap (τ h) (LinearMap.range Ψ) := by
      intro h x hx
      rcases LinearMap.mem_range.mp hx with ⟨φ, rfl⟩
      rw [Submodule.mem_comap, hΨ_apply, map_sum]
      apply Submodule.sum_mem (LinearMap.range Ψ)
      intro u _
      let u' : H ⧸ H₀ := QuotientGroup.mk (h * cosetRep u)
      have hout : (QuotientGroup.mk (cosetRep u') : H ⧸ H₀) = u' := Quotient.out_eq u'
      have hk_mem : (cosetRep u')⁻¹ * (h * cosetRep u) ∈ H₀ := QuotientGroup.eq.mp hout
      let k : H₀ := ⟨(cosetRep u')⁻¹ * (h * cosetRep u), hk_mem⟩
      have h_grp : h * cosetRep u = cosetRep u' * k.1 := by
        dsimp only [k]
        group
      have h_eq : τ h (τ (cosetRep u) (φ u).1) =
          Ψ (LinearMap.single (Ω F) (fun _ => W) u' (τ₀ k (φ u))) := by
        rw [hΨ_single, hτ₀, ← Module.End.mul_apply, ← map_mul, h_grp, map_mul, Module.End.mul_apply]
      rw [h_eq]
      exact LinearMap.mem_range_self Ψ _
    have h_range_ne_bot : LinearMap.range Ψ ≠ ⊥ := by
      intro h_bot
      let w₀ : W := ⟨v₀, hv₀_W⟩
      let u₀ : H ⧸ H₀ := QuotientGroup.mk 1
      have h_mem : Ψ (LinearMap.single (Ω F) (fun _ => W) u₀ w₀) ∈ LinearMap.range Ψ :=
        LinearMap.mem_range_self Ψ _
      rw [h_bot, Submodule.mem_bot, hΨ_single] at h_mem
      have h_v₀ : τ (cosetRep u₀)⁻¹ (τ (cosetRep u₀) v₀) = 0 := by
        rw [h_mem, map_zero]
      rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply] at h_v₀
      exact hv₀_ne h_v₀
    exact (h_irr (LinearMap.range Ψ) h_range_inv).resolve_left h_range_ne_bot
  let e : ((H ⧸ H₀) → W) ≃ₗ[Ω F] V := LinearEquiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩
  have he : ∀ (u : H ⧸ H₀) (w : W),
      e (LinearMap.single (Ω F) (fun _ => W) u w) = τ (cosetRep u) w.1 :=
    hΨ_single
  
  refine ⟨H₀, W, τ₀, h_card_lt, fun h => ?_⟩
  have h_coset_trace : LinearMap.trace (Ω F) V (τ h) =
      ∑ u : H ⧸ H₀,
        if hm : (cosetRep u)⁻¹ * h * cosetRep u ∈ H₀ then
          LinearMap.trace (Ω F) W (τ₀ ⟨(cosetRep u)⁻¹ * h * cosetRep u, hm⟩)
        else 0 := by
    let T : ((H ⧸ H₀) → W) →ₗ[Ω F] ((H ⧸ H₀) → W) := e.symm.conj (τ h)
    have htr_conj : LinearMap.trace (Ω F) V (τ h) =
        LinearMap.trace (Ω F) ((H ⧸ H₀) → W) T :=
      (LinearMap.trace_conj' (τ h) e.symm).symm
    have hT_sum : T = ∑ u : H ⧸ H₀,
        (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u) ∘ₗ
          LinearMap.proj (R := Ω F) (φ := fun _ => W) u := by
      apply LinearMap.ext
      intro φ
      have hφ : (∑ u : H ⧸ H₀, LinearMap.single (Ω F) (fun _ => W) u (φ u)) = φ := by
        ext u₁
        simpa [LinearMap.single_apply] using
          congr_fun (Finset.univ_sum_single φ) u₁
      calc T φ = T (∑ u : H ⧸ H₀, LinearMap.single (Ω F) (fun _ => W) u (φ u)) := by rw [hφ]
        _ = ∑ u : H ⧸ H₀, T (LinearMap.single (Ω F) (fun _ => W) u (φ u)) := map_sum T _ _
        _ = (∑ u : H ⧸ H₀,
              (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u) ∘ₗ
                LinearMap.proj (R := Ω F) (φ := fun _ => W) u) φ := by
          rw [LinearMap.sum_apply]
          rfl
    rw [htr_conj, hT_sum, map_sum]
    apply Finset.sum_congr rfl
    intro u _
    rw [LinearMap.trace_comp_comm']
    let u' : H ⧸ H₀ := QuotientGroup.mk (h * cosetRep u)
    have hout' : (QuotientGroup.mk (cosetRep u') : H ⧸ H₀) = u' := Quotient.out_eq u'
    have hk_mem : (cosetRep u')⁻¹ * (h * cosetRep u) ∈ H₀ := QuotientGroup.eq.mp hout'
    let k : H₀ := ⟨(cosetRep u')⁻¹ * (h * cosetRep u), hk_mem⟩
    have hT_single : ∀ w : W,
        T (LinearMap.single (Ω F) (fun _ => W) u w) =
          LinearMap.single (Ω F) (fun _ => W) u' (τ₀ k w) := by
      intro w
      have h_grp : h * cosetRep u = cosetRep u' * k.1 := by
        dsimp only [k]
        group
      have h_apply : τ h (e (LinearMap.single (Ω F) (fun _ => W) u w)) =
          e (LinearMap.single (Ω F) (fun _ => W) u' (τ₀ k w)) := by
        rw [he, he, hτ₀, ← Module.End.mul_apply, ← map_mul, h_grp, map_mul, Module.End.mul_apply]
      change e.symm (τ h (e (LinearMap.single (Ω F) (fun _ => W) u w))) = _
      rw [h_apply, LinearEquiv.symm_apply_apply]
    have hu_iff : u = u' ↔ (cosetRep u)⁻¹ * h * cosetRep u ∈ H₀ := by
      have hout : (QuotientGroup.mk (cosetRep u) : H ⧸ H₀) = u := Quotient.out_eq u
      conv_lhs => rw [← hout]
      dsimp only [u']
      rw [QuotientGroup.eq, mul_assoc]
    by_cases hm : (cosetRep u)⁻¹ * h * cosetRep u ∈ H₀
    · rw [dif_pos hm]
      have hu_eq : u' = u := (hu_iff.mpr hm).symm
      have h_comp : LinearMap.proj (R := Ω F) (φ := fun _ => W) u ∘ₗ
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u) =
          τ₀ ⟨(cosetRep u)⁻¹ * h * cosetRep u, hm⟩ := by
        apply LinearMap.ext
        intro w
        change (T (LinearMap.single (Ω F) (fun _ => W) u w)) u = _
        rw [hT_single w, LinearMap.single_apply, hu_eq, Pi.single_eq_same]
        have hk_eq : k = ⟨(cosetRep u)⁻¹ * h * cosetRep u, hm⟩ := by
          apply Subtype.ext
          dsimp only [k]
          rw [hu_eq, mul_assoc]
        rw [hk_eq]
      rw [h_comp]
    · rw [dif_neg hm]
      have hu_ne : u ≠ u' := fun h_eq => hm (hu_iff.mp h_eq)
      have h_comp : LinearMap.proj (R := Ω F) (φ := fun _ => W) u ∘ₗ
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u) = 0 := by
        apply LinearMap.ext
        intro w
        change (T (LinearMap.single (Ω F) (fun _ => W) u w)) u = 0
        rw [hT_single w, LinearMap.single_apply, Pi.single_eq_of_ne hu_ne]
      rw [h_comp, map_zero]
  rw [h_coset_trace]
  
  let u_of : H → H ⧸ H₀ := fun y => QuotientGroup.mk y⁻¹
  let r_of : H → H := fun y => cosetRep (u_of y)
  have h_yr_mem : ∀ y : H, y * r_of y ∈ H₀ := by
    intro y
    have hout : (QuotientGroup.mk (r_of y) : H ⧸ H₀) = u_of y := Quotient.out_eq (u_of y)
    have hrel : (r_of y)⁻¹ * y⁻¹ ∈ H₀ := QuotientGroup.eq.mp hout
    have hinv : (y * r_of y)⁻¹ ∈ H₀ := by
      rw [mul_inv_rev]
      exact hrel
    exact (Subgroup.inv_mem_iff H₀).mp hinv
  have hu_mul : ∀ (z : H₀) (y : H), u_of ((z : H) * y) = u_of y := by
    intro z y
    apply QuotientGroup.eq.mpr
    rw [inv_inv, mul_inv_cancel_right]
    exact z.2
  have hu_rep_inv : ∀ u₀ : H ⧸ H₀, u_of (cosetRep u₀)⁻¹ = u₀ := by
    intro u₀
    dsimp only [u_of]
    rw [inv_inv]
    exact Quotient.out_eq u₀
  have hr_rep_inv : ∀ u₀ : H ⧸ H₀, r_of (cosetRep u₀)⁻¹ = cosetRep u₀ := by
    intro u₀
    dsimp only [r_of]
    rw [hu_rep_inv u₀]
  let e_prod : (H ⧸ H₀) × H₀ ≃ H :=
    { toFun := fun p => (p.2 : H) * (cosetRep p.1)⁻¹
      invFun := fun y => (u_of y, ⟨y * r_of y, h_yr_mem y⟩)
      left_inv := fun ⟨u₀, z⟩ => by
        dsimp only
        have hu1 : u_of ((z : H) * (cosetRep u₀)⁻¹) = u₀ := by
          rw [hu_mul z (cosetRep u₀)⁻¹, hu_rep_inv u₀]
        have hr1 : r_of ((z : H) * (cosetRep u₀)⁻¹) = cosetRep u₀ := by
          dsimp only [r_of]
          rw [hu1]
        ext
        · exact hu1
        · change ((z : H) * (cosetRep u₀)⁻¹) * r_of ((z : H) * (cosetRep u₀)⁻¹) = z.1
          rw [hr1, inv_mul_cancel_right]
      right_inv := fun y => by
        dsimp only [r_of]
        exact mul_inv_cancel_right y (r_of y) }
  have h_term_inv : ∀ (u₀ : H ⧸ H₀) (z : H₀),
      (if hy : e_prod (u₀, z) * h * (e_prod (u₀, z))⁻¹ ∈ H₀ then
        LinearMap.trace (Ω F) W (τ₀ ⟨e_prod (u₀, z) * h * (e_prod (u₀, z))⁻¹, hy⟩)
      else 0) =
      (if hm : (cosetRep u₀)⁻¹ * h * cosetRep u₀ ∈ H₀ then
        LinearMap.trace (Ω F) W (τ₀ ⟨(cosetRep u₀)⁻¹ * h * cosetRep u₀, hm⟩)
      else 0) := by
    intro u₀ z
    let y : H := e_prod (u₀, z)
    let x₀ : H := (cosetRep u₀)⁻¹ * h * cosetRep u₀
    have hy_eq : y * h * y⁻¹ = (z : H) * x₀ * (z : H)⁻¹ := by
      change (z : H) * (cosetRep u₀)⁻¹ * h * ((z : H) * (cosetRep u₀)⁻¹)⁻¹ =
        (z : H) * ((cosetRep u₀)⁻¹ * h * cosetRep u₀) * (z : H)⁻¹
      group
    have h_mem_iff : y * h * y⁻¹ ∈ H₀ ↔ x₀ ∈ H₀ := by
      rw [hy_eq, mul_assoc]
      rw [Subgroup.mul_mem_cancel_left H₀ z.2]
      exact Subgroup.mul_mem_cancel_right H₀ (Subgroup.inv_mem H₀ z.2)
    by_cases hm : x₀ ∈ H₀
    · have hy : y * h * y⁻¹ ∈ H₀ := h_mem_iff.mpr hm
      rw [dif_pos hy, dif_pos hm]
      have h_sub_eq : (⟨y * h * y⁻¹, hy⟩ : H₀) = z * ⟨x₀, hm⟩ * z⁻¹ := by
        apply Subtype.ext
        change y * h * y⁻¹ = (z : H) * x₀ * (z : H)⁻¹
        exact hy_eq
      have h_map : τ₀ ⟨y * h * y⁻¹, hy⟩ = (τ₀ z ∘ₗ τ₀ ⟨x₀, hm⟩) ∘ₗ τ₀ z⁻¹ := by
        rw [h_sub_eq, map_mul, map_mul]
        rfl
      rw [h_map, LinearMap.trace_comp_comm', ← LinearMap.comp_assoc]
      have h_inv : τ₀ z⁻¹ ∘ₗ τ₀ z = LinearMap.id := by
        rw [← Module.End.mul_eq_comp, ← map_mul, inv_mul_cancel, map_one, Module.End.one_eq_id]
      rw [h_inv, LinearMap.id_comp]
    · have hy : ¬ (y * h * y⁻¹ ∈ H₀) := fun hy' => hm (h_mem_iff.mp hy')
      rw [dif_neg hy, dif_neg hm]
  have h_sum_H :
      (∑ y : H,
        if hy : y * h * y⁻¹ ∈ H₀ then
          LinearMap.trace (Ω F) W (τ₀ ⟨y * h * y⁻¹, hy⟩)
        else 0) =
      (Nat.card H₀ : Ω F) *
        ∑ u₀ : H ⧸ H₀,
          if hm : (cosetRep u₀)⁻¹ * h * cosetRep u₀ ∈ H₀ then
            LinearMap.trace (Ω F) W (τ₀ ⟨(cosetRep u₀)⁻¹ * h * cosetRep u₀, hm⟩)
          else 0 := by
    rw [← Fintype.sum_equiv e_prod
      (fun p =>
        if hy : e_prod p * h * (e_prod p)⁻¹ ∈ H₀ then
          LinearMap.trace (Ω F) W (τ₀ ⟨e_prod p * h * (e_prod p)⁻¹, hy⟩)
        else 0)
      _ (fun _ => rfl)]
    rw [Fintype.sum_prod_type]
    have h_inner : ∀ u₀ : H ⧸ H₀,
        (∑ z : H₀,
          if hy : e_prod (u₀, z) * h * (e_prod (u₀, z))⁻¹ ∈ H₀ then
            LinearMap.trace (Ω F) W (τ₀ ⟨e_prod (u₀, z) * h * (e_prod (u₀, z))⁻¹, hy⟩)
          else 0) =
        (Nat.card H₀ : Ω F) *
          (if hm : (cosetRep u₀)⁻¹ * h * cosetRep u₀ ∈ H₀ then
            LinearMap.trace (Ω F) W (τ₀ ⟨(cosetRep u₀)⁻¹ * h * cosetRep u₀, hm⟩)
          else 0) := by
      intro u₀
      have h_congr :
          (∑ z : H₀,
            if hy : e_prod (u₀, z) * h * (e_prod (u₀, z))⁻¹ ∈ H₀ then
              LinearMap.trace (Ω F) W (τ₀ ⟨e_prod (u₀, z) * h * (e_prod (u₀, z))⁻¹, hy⟩)
            else 0) =
          ∑ _z : H₀,
            (if hm : (cosetRep u₀)⁻¹ * h * cosetRep u₀ ∈ H₀ then
              LinearMap.trace (Ω F) W (τ₀ ⟨(cosetRep u₀)⁻¹ * h * cosetRep u₀, hm⟩)
            else 0) :=
        Finset.sum_congr rfl fun z _ => h_term_inv u₀ z
      rw [h_congr, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
    rw [Finset.sum_congr rfl fun u₀ _ => h_inner u₀, ← Finset.mul_sum]
  rw [h_sum_H]
  have h_card_pos : 0 < Nat.card H₀ := Nat.card_pos
  have h_card_ne_zero : (Nat.card H₀ : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_pos.ne'
  exact (inv_mul_cancel_left₀ h_card_ne_zero _).symm

theorem ld_indRepTrace_properties (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G] :
    (∀ (H : Subgroup G) {V : Type u} [AddCommGroup V] [Module (Ω F) V] [FiniteDimensional (Ω F) V]
      (ρ : Representation (Ω F) G V) (g : G),
      LinearMap.trace (Ω F) V (ρ g) * indCharTrace F H 1 g =
        indRepTrace F H (ρ.comp H.subtype) g) ∧
    (∀ (H : Subgroup G) {V : Type u} [AddCommGroup V] [Module (Ω F) V] [FiniteDimensional (Ω F) V]
      (τ : Representation (Ω F) H V) (W : Submodule (Ω F) V)
      (hW : ∀ h : H, W ≤ Submodule.comap (τ h) W) (g : G),
      indRepTrace F H τ g =
        indRepTrace F H (subRep τ W hW) g + indRepTrace F H (quotRep τ W hW) g) ∧
    (∀ (H : Subgroup G) (H₀ : Subgroup H)
      {V W : Type u} [AddCommGroup V] [Module (Ω F) V] [AddCommGroup W] [Module (Ω F) W]
      (τ : Representation (Ω F) H V) (τ₀ : Representation (Ω F) H₀ W),
      (∀ h : H,
        LinearMap.trace (Ω F) V (τ h) =
          (Nat.card H₀ : Ω F)⁻¹ *
            ∑ y : H,
              if hy : y * h * y⁻¹ ∈ H₀ then
                LinearMap.trace (Ω F) W (τ₀ ⟨y * h * y⁻¹, hy⟩)
              else 0) →
      ∀ g : G,
        indRepTrace F H τ g =
          indRepTrace F (Subgroup.map H.subtype H₀)
            (τ₀.comp (Subgroup.equivMapOfInjective H₀ H.subtype H.subtype_injective).symm.toMonoidHom) g) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro H V _ _ _ ρ g
    have h_conj : ∀ x : G,
        LinearMap.trace (Ω F) V (ρ (x * g * x⁻¹)) = LinearMap.trace (Ω F) V (ρ g) := by
      intro x
      have h1 : ρ (x * g * x⁻¹) = (ρ x ∘ₗ ρ g) ∘ₗ ρ x⁻¹ := by
        rw [map_mul, map_mul, Module.End.mul_eq_comp, Module.End.mul_eq_comp]
      have h2 : ρ x⁻¹ ∘ₗ (ρ x ∘ₗ ρ g) = ρ g := by
        rw [← Module.End.mul_eq_comp, ← Module.End.mul_eq_comp, ← map_mul, ← map_mul,
          inv_mul_cancel_left]
      rw [h1, LinearMap.trace_comp_comm' (ρ x⁻¹) (ρ x ∘ₗ ρ g), h2]
    unfold indCharTrace indRepTrace
    rw [mul_left_comm, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun x _ => ?_
    split_ifs with h
    · simp only [MonoidHom.one_apply, Units.val_one, mul_one, MonoidHom.comp_apply]
      exact (h_conj x).symm
    · simp
  · intro H V _ _ _ τ W hW g
    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective W.mkQ (Submodule.range_mkQ W)
    have hmem : ∀ v : V, ((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ W.mkQ) v ∈ W := by
      intro v
      have hker : ((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ W.mkQ) v ∈ LinearMap.ker W.mkQ := by
        rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply,
          LinearMap.comp_apply, map_sub]
        change W.mkQ v - (W.mkQ ∘ₗ s) (W.mkQ v) = 0
        rw [hs, LinearMap.id_apply, sub_self]
      rwa [Submodule.ker_mkQ W] at hker
    let p : V →ₗ[Ω F] W :=
      LinearMap.codRestrict W ((LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ W.mkQ) hmem
    have hfp : W.subtype ∘ₗ p = (LinearMap.id : V →ₗ[Ω F] V) - s ∘ₗ W.mkQ := by
      ext v
      rfl
    have hpf : p ∘ₗ W.subtype = LinearMap.id := by
      ext w
      change ((p (W.subtype w) : W) : V) = w.1
      rw [LinearMap.codRestrict_apply, LinearMap.sub_apply, LinearMap.id_apply,
        LinearMap.comp_apply, Submodule.coe_subtype, Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero W).mpr w.2, map_zero, sub_zero]
    have hfp_id : W.subtype ∘ₗ p + s ∘ₗ W.mkQ = LinearMap.id := by
      rw [hfp, sub_add_cancel]
    have htr_add : ∀ h : H,
        LinearMap.trace (Ω F) V (τ h) =
          LinearMap.trace (Ω F) W (subRep τ W hW h) +
            LinearMap.trace (Ω F) (V ⧸ W) (quotRep τ W hW h) := by
      intro h
      have hf_comm : W.subtype ∘ₗ subRep τ W hW h = τ h ∘ₗ W.subtype := by
        ext x
        rfl
      have hq_comm : W.mkQ ∘ₗ τ h = quotRep τ W hW h ∘ₗ W.mkQ := by
        ext x
        rfl
      have h_decomp : τ h =
          (W.subtype ∘ₗ subRep τ W hW h) ∘ₗ p + (τ h ∘ₗ s) ∘ₗ W.mkQ := by
        calc τ h = τ h ∘ₗ LinearMap.id := (LinearMap.comp_id (τ h)).symm
          _ = τ h ∘ₗ (W.subtype ∘ₗ p + s ∘ₗ W.mkQ) := by rw [hfp_id]
          _ = (τ h ∘ₗ W.subtype) ∘ₗ p + (τ h ∘ₗ s) ∘ₗ W.mkQ := by
            rw [LinearMap.comp_add, LinearMap.comp_assoc, LinearMap.comp_assoc]
          _ = (W.subtype ∘ₗ subRep τ W hW h) ∘ₗ p + (τ h ∘ₗ s) ∘ₗ W.mkQ := by
            rw [hf_comm]
      have htr1 : LinearMap.trace (Ω F) V ((W.subtype ∘ₗ subRep τ W hW h) ∘ₗ p) =
          LinearMap.trace (Ω F) W (subRep τ W hW h) := by
        rw [LinearMap.trace_comp_comm' p (W.subtype ∘ₗ subRep τ W hW h),
          ← LinearMap.comp_assoc, hpf, LinearMap.id_comp]
      have htr2 : LinearMap.trace (Ω F) V ((τ h ∘ₗ s) ∘ₗ W.mkQ) =
          LinearMap.trace (Ω F) (V ⧸ W) (quotRep τ W hW h) := by
        rw [LinearMap.trace_comp_comm' W.mkQ (τ h ∘ₗ s),
          ← LinearMap.comp_assoc, hq_comm, LinearMap.comp_assoc, hs, LinearMap.comp_id]
      rw [h_decomp, map_add, htr1, htr2]
    unfold indRepTrace
    have h_sum : (∑ x : G,
        if h : x * g * x⁻¹ ∈ H then
          LinearMap.trace (Ω F) V (τ ⟨x * g * x⁻¹, h⟩)
        else 0) =
      (∑ x : G,
        if h : x * g * x⁻¹ ∈ H then
          LinearMap.trace (Ω F) W (subRep τ W hW ⟨x * g * x⁻¹, h⟩)
        else 0) +
      (∑ x : G,
        if h : x * g * x⁻¹ ∈ H then
          LinearMap.trace (Ω F) (V ⧸ W) (quotRep τ W hW ⟨x * g * x⁻¹, h⟩)
        else 0) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun x _ => ?_
      split_ifs with h
      · exact htr_add ⟨x * g * x⁻¹, h⟩
      · simp
    rw [h_sum, mul_add]
  · intro H H₀ V W _ _ _ _ τ τ₀ h_tr g
    let H' : Subgroup G := Subgroup.map H.subtype H₀
    let e₀ := Subgroup.equivMapOfInjective H₀ H.subtype H.subtype_injective
    let e := e₀.symm
    let τ' : Representation (Ω F) H' W := τ₀.comp e.toMonoidHom
    let B : G → Ω F := fun z =>
      if hz' : z * g * z⁻¹ ∈ H' then
        LinearMap.trace (Ω F) W (τ' ⟨z * g * z⁻¹, hz'⟩)
      else 0
    have h_conj_G : ∀ (x : G) (y : H),
        ((y : G) * x) * g * ((y : G) * x)⁻¹ = (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ := by
      intro x y
      group
    have h_term : ∀ (x : G) (y : H),
        (if hx : x * g * x⁻¹ ∈ H then
          if hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ H₀ then
            LinearMap.trace (Ω F) W (τ₀ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩)
          else 0
        else 0) = B ((y : G) * x) := by
      intro x y
      dsimp only [B]
      by_cases hz' : ((y : G) * x) * g * ((y : G) * x)⁻¹ ∈ H'
      · have hz_H : ((y : G) * x) * g * ((y : G) * x)⁻¹ ∈ H :=
          Subgroup.map_subtype_le H₀ hz'
        have hx : x * g * x⁻¹ ∈ H := by
          have h_eq : x * g * x⁻¹ = (y : G)⁻¹ * (((y : G) * x) * g * ((y : G) * x)⁻¹) * (y : G) := by
            group
          rw [h_eq]
          exact H.mul_mem (H.mul_mem (H.inv_mem y.2) hz_H) y.2
        have hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ H₀ := by
          rcases Subgroup.mem_map.mp hz' with ⟨u, hu, hu_eq⟩
          have hu_sub : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ = u := by
            ext
            change (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ = (u : G)
            rw [← h_conj_G x y]
            exact hu_eq.symm
          exact hu_sub.symm ▸ hu
        have he_eq : e ⟨((y : G) * x) * g * ((y : G) * x)⁻¹, hz'⟩ =
            ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ := by
          apply (MulEquiv.symm_apply_eq e₀).mpr
          ext
          change ((y : G) * x) * g * ((y : G) * x)⁻¹ = (y : G) * (x * g * x⁻¹) * (y : G)⁻¹
          exact h_conj_G x y
        rw [dif_pos hx, dif_pos hy, dif_pos hz']
        change LinearMap.trace (Ω F) W (τ₀ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩) =
          LinearMap.trace (Ω F) W (τ₀ (e ⟨((y : G) * x) * g * ((y : G) * x)⁻¹, hz'⟩))
        rw [he_eq]
      · rw [dif_neg hz']
        split_ifs with hx hy
        · exfalso
          apply hz'
          rw [Subgroup.mem_map]
          refine ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy, ?_⟩
          change (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ = ((y : G) * x) * g * ((y : G) * x)⁻¹
          exact (h_conj_G x y).symm
        · rfl
        · rfl
    have h_summand : ∀ x : G,
        (if hx : x * g * x⁻¹ ∈ H then
          LinearMap.trace (Ω F) V (τ ⟨x * g * x⁻¹, hx⟩)
        else 0) =
        (Nat.card H₀ : Ω F)⁻¹ * ∑ y : H, B ((y : G) * x) := by
      intro x
      have h_sum_y : (∑ y : H, B ((y : G) * x)) =
          ∑ y : H,
            (if hx : x * g * x⁻¹ ∈ H then
              if hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ H₀ then
                LinearMap.trace (Ω F) W (τ₀ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩)
              else 0
            else 0) :=
        Finset.sum_congr rfl fun y _ => (h_term x y).symm
      rw [h_sum_y]
      by_cases hx : x * g * x⁻¹ ∈ H
      · rw [dif_pos hx, h_tr ⟨x * g * x⁻¹, hx⟩]
        congr 1
        refine Finset.sum_congr rfl fun y _ => ?_
        rw [dif_pos hx]
      · rw [dif_neg hx]
        have h0 : (∑ y : H,
            if hx' : x * g * x⁻¹ ∈ H then
              if hy : y * ⟨x * g * x⁻¹, hx'⟩ * y⁻¹ ∈ H₀ then
                LinearMap.trace (Ω F) W (τ₀ ⟨y * ⟨x * g * x⁻¹, hx'⟩ * y⁻¹, hy⟩)
              else 0
            else 0) = 0 := by
          refine Finset.sum_eq_zero fun y _ => ?_
          rw [dif_neg hx]
        rw [h0, mul_zero]
    have h_shift : ∀ y : H, (∑ x : G, B ((y : G) * x)) = ∑ z : G, B z := by
      intro y
      exact Fintype.sum_equiv (Equiv.mulLeft (y : G)) (fun x => B ((y : G) * x)) B (fun x => rfl)
    have h_card_H' : Nat.card H' = Nat.card H₀ := Subgroup.card_subtype H H₀
    have h_card_H_pos : 0 < Nat.card H := Nat.card_pos
    have h_card_H_ne : (Nat.card H : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_H_pos.ne'
    change indRepTrace F H τ g = indRepTrace F H' τ' g
    unfold indRepTrace
    have h_lhs : (∑ x : G,
        if h : x * g * x⁻¹ ∈ H then
          LinearMap.trace (Ω F) V (τ ⟨x * g * x⁻¹, h⟩)
        else 0) =
      (Nat.card H₀ : Ω F)⁻¹ * ((Nat.card H : Ω F) * ∑ z : G, B z) := by
      calc (∑ x : G,
          if h : x * g * x⁻¹ ∈ H then
            LinearMap.trace (Ω F) V (τ ⟨x * g * x⁻¹, h⟩)
          else 0)
        _ = ∑ x : G, ((Nat.card H₀ : Ω F)⁻¹ * ∑ y : H, B ((y : G) * x)) :=
          Finset.sum_congr rfl fun x _ => h_summand x
        _ = (Nat.card H₀ : Ω F)⁻¹ * ∑ x : G, ∑ y : H, B ((y : G) * x) := by
          rw [← Finset.mul_sum]
        _ = (Nat.card H₀ : Ω F)⁻¹ * ∑ y : H, ∑ x : G, B ((y : G) * x) := by
          rw [Finset.sum_comm]
        _ = (Nat.card H₀ : Ω F)⁻¹ * ∑ _y : H, ∑ z : G, B z := by
          congr 1
          refine Finset.sum_congr rfl fun y _ => h_shift y
        _ = (Nat.card H₀ : Ω F)⁻¹ * ((Nat.card H : Ω F) * ∑ z : G, B z) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
    rw [h_lhs, ← h_card_H']
    change (Nat.card H : Ω F)⁻¹ * ((Nat.card H' : Ω F)⁻¹ * ((Nat.card H : Ω F) * ∑ z : G, B z)) =
      (Nat.card H' : Ω F)⁻¹ * ∑ z : G, B z
    calc (Nat.card H : Ω F)⁻¹ * ((Nat.card H' : Ω F)⁻¹ * ((Nat.card H : Ω F) * ∑ z : G, B z))
      _ = ((Nat.card H : Ω F)⁻¹ * (Nat.card H : Ω F)) * ((Nat.card H' : Ω F)⁻¹ * ∑ z : G, B z) := by
        ring
      _ = 1 * ((Nat.card H' : Ω F)⁻¹ * ∑ z : G, B z) := by
        rw [inv_mul_cancel₀ h_card_H_ne]
      _ = (Nat.card H' : Ω F)⁻¹ * ∑ z : G, B z := one_mul _

theorem ld_quasi_elementary_monomial_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (H : Subgroup G) (hH : IsQuasiElementary H)
    {V : Type u} [AddCommGroup V] [Module (Ω F) V] [FiniteDimensional (Ω F) V]
    (ρ : Representation (Ω F) G V) :
    ∃ (L_mon : List (ℤ × Σ (M : Subgroup G), (M →* (Ω F)ˣ))),
      ∀ g : G,
        LinearMap.trace (Ω F) V (ρ g) * indCharTrace F H 1 g =
          (L_mon.map fun p => p.1 • indCharTrace F p.2.1 p.2.2 g).sum :=
by
  obtain ⟨h_proj, h_add, h_trans⟩ := ld_indRepTrace_properties F G
  suffices h_ind : ∀ (N : ℕ) (H : Subgroup G), IsQuasiElementary H →
      ∀ {V : Type u} [AddCommGroup V] [Module (Ω F) V] [FiniteDimensional (Ω F) V]
        (τ : Representation (Ω F) H V),
      Nat.card H + Module.finrank (Ω F) V = N →
      ∃ (L_mon : List (ℤ × Σ (M : Subgroup G), (M →* (Ω F)ˣ))),
        ∀ g : G,
          indRepTrace F H τ g =
            (L_mon.map fun p => p.1 • indCharTrace F p.2.1 p.2.2 g).sum by
    obtain ⟨L_mon, hL_mon⟩ := h_ind (Nat.card H + Module.finrank (Ω F) V) H hH
      (ρ.comp H.subtype) rfl
    refine ⟨L_mon, fun g => ?_⟩
    rw [h_proj H ρ g, hL_mon g]
  intro N
  induction' N using Nat.strong_induction_on with N ih
  intro H hH V _ _ _ τ hN
  rcases Nat.eq_zero_or_pos (Module.finrank (Ω F) V) with hd_zero | hd_pos
  · haveI : Subsingleton V := Module.finrank_zero_iff.mp hd_zero
    refine ⟨[], fun g => ?_⟩
    have htr : ∀ h : H, LinearMap.trace (Ω F) V (τ h) = 0 := by
      intro h
      have h0 : τ h = 0 := Subsingleton.elim _ _
      rw [h0, map_zero]
    simp only [indRepTrace, htr, dite_eq_ite, ite_self, Finset.sum_const_zero, mul_zero,
      List.map_nil, List.sum_nil]
  · by_cases h_irr : ∀ W : Submodule (Ω F) V,
        (∀ h : H, W ≤ Submodule.comap (τ h) W) → W = ⊥ ∨ W = ⊤
    · haveI : Nontrivial V := Module.nontrivial_of_finrank_pos hd_pos
      obtain ⟨h_qe_sub, h_dic⟩ := ld_quasi_elementary_abelian_normal_exists F G H hH
      rcases h_dic τ with h_ab | ⟨A, hA_norm, hA_ab, hA_nc⟩
      · obtain ⟨ψ, hψ⟩ := ld_abelian_rep_irr_trace_eq_char F H τ h_irr h_ab
        refine ⟨[(1, ⟨H, ψ⟩)], fun g => ?_⟩
        simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero, one_smul,
          indRepTrace, indCharTrace]
        congr 1
        refine Finset.sum_congr rfl fun x _ => ?_
        split_ifs with hx
        · exact hψ ⟨x * g * x⁻¹, hx⟩
        · rfl
      · haveI : A.Normal := hA_norm
        obtain ⟨H₀, W, τ₀, h_card_lt, h_tr⟩ :=
          ld_clifford_noncentral_abelian_reduction F H τ h_irr A hA_ab hA_nc
        let H' : Subgroup G := Subgroup.map H.subtype H₀
        let e := (Subgroup.equivMapOfInjective H₀ H.subtype H.subtype_injective).symm
        let τ' : Representation (Ω F) H' W := τ₀.comp e.toMonoidHom
        have hH'_le : H' ≤ H := by
          intro x hx
          rcases Subgroup.mem_map.mp hx with ⟨y, _, rfl⟩
          exact y.2
        have hH'_qe : IsQuasiElementary H' := h_qe_sub H' hH'_le
        have h_card_eq : Nat.card H' = Nat.card H₀ :=
          Nat.card_congr e.toEquiv
        have hW_le : Module.finrank (Ω F) W ≤ Module.finrank (Ω F) V :=
          Submodule.finrank_le W
        have hN_lt : Nat.card H' + Module.finrank (Ω F) W < N := by omega
        obtain ⟨L_mon, hL_mon⟩ := ih (Nat.card H' + Module.finrank (Ω F) W) hN_lt H' hH'_qe τ' rfl
        refine ⟨L_mon, fun g => ?_⟩
        rw [h_trans H H₀ τ τ₀ h_tr g]
        exact hL_mon g
    · push_neg at h_irr
      rcases h_irr with ⟨W, hW_inv, hW_bot, hW_top⟩
      have hW_lt : Module.finrank (Ω F) W < Module.finrank (Ω F) V :=
        Submodule.finrank_lt hW_top
      haveI : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hW_bot
      have hW_pos : 0 < Module.finrank (Ω F) W := Module.finrank_pos
      have h_add_dim : Module.finrank (Ω F) (V ⧸ W) + Module.finrank (Ω F) W =
          Module.finrank (Ω F) V :=
        Submodule.finrank_quotient_add_finrank W
      have hVW_lt : Module.finrank (Ω F) (V ⧸ W) < Module.finrank (Ω F) V := by omega
      have hN₁ : Nat.card H + Module.finrank (Ω F) W < N := by omega
      have hN₂ : Nat.card H + Module.finrank (Ω F) (V ⧸ W) < N := by omega
      obtain ⟨L₁, hL₁⟩ := ih (Nat.card H + Module.finrank (Ω F) W) hN₁ H hH (subRep τ W hW_inv) rfl
      obtain ⟨L₂, hL₂⟩ := ih (Nat.card H + Module.finrank (Ω F) (V ⧸ W)) hN₂ H hH (quotRep τ W hW_inv) rfl
      refine ⟨L₁ ++ L₂, fun g => ?_⟩
      rw [h_add H τ W hW_inv g, hL₁ g, hL₂ g, List.map_append, List.sum_append]

theorem ld_galois_quotient_monomial_lift (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (G₀ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    [Fintype G₀]
    (π : relWeil F L →* G₀)
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      (((π w : G₀) : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) x : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    (ω : relWeil F L →* (Ω F)ˣ)
    (hω : ∀ w : relWeil F L, (w : AbsGal F) ∈ inertia F → ω w = 1)
    (n : ℤ) (H : Subgroup G₀) (ψ : H →* (Ω F)ˣ) :
    ∃ t : MonomialTerm F L,
      t.Wf F L ∧
      ∀ w : relWeil F L,
        t.trace F L w = n • ((ω w : Ω F) * indCharTrace F H ψ (π w)) :=
by
  
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  haveI : FiniteDimensional F K' := inferInstanceAs (FiniteDimensional F K)
  haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
  let H_gal : Subgroup (K' ≃ₐ[L] K') := H.map G₀.subtype
  let E₀ : IntermediateField L K' := IntermediateField.fixedField H_gal
  let E_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.lift E₀
  let E : IntermediateField F (AlgebraicClosure F) := E_L.restrictScalars F
  have hLE : L ≤ E := by
    intro z hz
    exact (IntermediateField.mem_restrictScalars F).mpr (E_L.algebraMap_mem ⟨z, hz⟩)
  have hEK : E ≤ K := by
    intro z hz
    have hz_EL : z ∈ E_L := (IntermediateField.mem_restrictScalars F).mp hz
    have hz_K' : z ∈ K' := IntermediateField.lift_le E₀ hz_EL
    exact (IntermediateField.mem_extendScalars hLK).mp hz_K'
  haveI : FiniteDimensional F E :=
    Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
      (IntermediateField.inclusion hEK).injective
  have hSep_E : Algebra.IsSeparable L (IntermediateField.extendScalars hLE) := by
    let E' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE
    refine ⟨fun x => ?_⟩
    have hxE : (x : AlgebraicClosure F) ∈ E := (IntermediateField.mem_extendScalars hLE).mp x.2
    have hxK' : (x : AlgebraicClosure F) ∈ K' :=
      (IntermediateField.mem_extendScalars hLK).mpr (hEK hxE)
    let x_K : K' := ⟨x.1, hxK'⟩
    have h_sep_K : IsSeparable L x_K := Algebra.IsSeparable.isSeparable L x_K
    have h_min_E : minpoly L (x : AlgebraicClosure F) = minpoly L x :=
      minpoly.algHom_eq E'.val E'.val.injective x
    have h_min_K : minpoly L (x_K : AlgebraicClosure F) = minpoly L x_K :=
      minpoly.algHom_eq K'.val K'.val.injective x_K
    have h_min_eq : minpoly L x = minpoly L x_K := by
      rw [← h_min_E, ← h_min_K]
    unfold IsSeparable at h_sep_K ⊢
