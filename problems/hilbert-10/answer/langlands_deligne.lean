      rw [← Nat.cast_mul, hr_mul, Nat.cast_sub hq₀_prime.one_le, Nat.cast_one]
    exact h_cast
  have hDtameE_props : ∀ t ∈ D_tame_E,
      t.coeff = 1 ∧
      t.field = E_L' ∧
      t.χ ^ (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) = 1 ∧
      (∃ htK : t.field ≤ E₁, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E' ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ E_L', restrictWeilChar F htM t.χ ≠ 1) := by
    intro t ht
    rw [List.mem_ofFn] at ht
    rcases ht with ⟨i, rfl⟩
    refine ⟨rfl, rfl, ?_, ?_, ?_, ?_⟩
    · change (restrictWeilChar F hL'E_L' (μ_orb i)) ^
          (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) = 1
      rw [hFinEL'E₁, ← hFinL'M₁]
      apply MonoidHom.ext
      intro w
      change (μ_orb i (Subgroup.inclusion (relWeil_antitone F hL'E_L') w)) ^
          (Module.finrank L' (IntermediateField.extendScalars hL'M₁)) = 1
      have hpow := (hμ_props i).2.2.1
      have h_app : ((μ_orb i) ^ (Module.finrank L' (IntermediateField.extendScalars hL'M₁)))
          (Subgroup.inclusion (relWeil_antitone F hL'E_L') w) = 1 := by
        rw [hpow, MonoidHom.one_apply]
      exact h_app
    · refine ⟨hE_L'E₁, ?_⟩
      apply MonoidHom.ext
      intro w
      change μ_orb i (Subgroup.inclusion (relWeil_antitone F hL'E_L')
        (Subgroup.inclusion (relWeil_antitone F hE_L'E₁) w)) = 1
      have h_sub_eq :
          Subgroup.inclusion (relWeil_antitone F hL'E_L')
            (Subgroup.inclusion (relWeil_antitone F hE_L'E₁) w) =
          Subgroup.inclusion (relWeil_antitone F hL'M₁)
            (Subgroup.inclusion (relWeil_antitone F hM₁_le_E₁) w) := Subtype.ext rfl
      rw [h_sub_eq]
      change restrictWeilChar F hL'M₁ (μ_orb i)
          (Subgroup.inclusion (relWeil_antitone F hM₁_le_E₁) w) = 1
      rw [(hμ_props i).2.1, MonoidHom.one_apply]
    · refine ⟨le_sup_right, ?_⟩
      apply MonoidHom.ext
      intro w
      change μ_orb i (Subgroup.inclusion (relWeil_antitone F hL'E_L')
        (Subgroup.inclusion (relWeil_antitone F (le_sup_right : E_L' ≤ E' ⊔ E_L')) w)) = 1
      have h_sub_eq :
          Subgroup.inclusion (relWeil_antitone F hL'E_L')
            (Subgroup.inclusion (relWeil_antitone F (le_sup_right : E_L' ≤ E' ⊔ E_L')) w) =
          Subgroup.inclusion (relWeil_antitone F hL'M₁)
            (Subgroup.inclusion (relWeil_antitone F hM₁_le_sup) w) := Subtype.ext rfl
      rw [h_sub_eq]
      change restrictWeilChar F hL'M₁ (μ_orb i)
          (Subgroup.inclusion (relWeil_antitone F hM₁_le_sup) w) = 1
      rw [(hμ_props i).2.1, MonoidHom.one_apply]
    · intro htM h_triv
      apply (hμ_props i).2.2.2
      apply MonoidHom.ext
      intro x
      obtain ⟨m₀, y₀, hxy⟩ := h_weil_fact (Subgroup.inclusion (relWeil_antitone F hLL') x)
      let m₁ : relWeil F M₁ := Subgroup.inclusion (relWeil_antitone F hM₁MC) m₀
      let m_L' : relWeil F L' := Subgroup.inclusion (relWeil_antitone F hL'M₁) m₁
      have hy_gal : (y₀ : AbsGal F) = (m_L' : AbsGal F)⁻¹ * (x : AbsGal F) := by
        have hxy_gal : (m_L' : AbsGal F) * (y₀ : AbsGal F) = (x : AbsGal F) :=
          congrArg Subtype.val hxy
        rw [← hxy_gal, inv_mul_cancel_left]
      have hy_L' : (y₀ : AbsGal F) ∈ L'.fixingSubgroup := by
        rw [hy_gal]
        exact (m_L'⁻¹ * x).2.2
      have hy_EL' : (y₀ : AbsGal F) ∈ E_L'.fixingSubgroup := by
        rw [← hEL'_sup, IntermediateField.fixingSubgroup_sup]
        exact ⟨y₀.2.2, hy_L'⟩
      let y₁ : relWeil F E_L' := ⟨y₀.1, y₀.2.1, hy_EL'⟩
      have hx_eq : x = m_L' * Subgroup.inclusion (relWeil_antitone F hL'E_L') y₁ := by
        apply Subtype.ext
        change (x : AbsGal F) = (m_L' : AbsGal F) * (y₀ : AbsGal F)
        rw [hy_gal, mul_inv_cancel_left]
      have hm_triv : μ_orb i m_L' = 1 := by
        change restrictWeilChar F hL'M₁ (μ_orb i) m₁ = 1
        rw [(hμ_props i).2.1, MonoidHom.one_apply]
      have hy_triv : μ_orb i (Subgroup.inclusion (relWeil_antitone F hL'E_L') y₁) = 1 := by
        have h_sub_y : Subgroup.inclusion (relWeil_antitone F htM) y₁ = y₁ := Subtype.ext rfl
        have h_app : (restrictWeilChar F htM (term_E i).χ) y₁ = 1 := by
          rw [h_triv, MonoidHom.one_apply]
        change μ_orb i (Subgroup.inclusion (relWeil_antitone F hL'E_L')
          (Subgroup.inclusion (relWeil_antitone F htM) y₁)) = 1 at h_app
        rw [h_sub_y] at h_app
        exact h_app
      rw [hx_eq, map_mul, hm_triv, hy_triv, mul_one, MonoidHom.one_apply]
  have hν_props : ∀ ν' ∈ ν_list, restrictWeilChar F hL'MC ν' = 1 ∧ ν' ^ q₀ = 1 := by
    intro ν' hν'
    rw [List.mem_ofFn] at hν'
    rcases hν' with ⟨i, rfl⟩
    refine ⟨?_, ?_⟩
    · apply MonoidHom.ext
      intro w
      change μ_orb i (Subgroup.inclusion (relWeil_antitone F hL'M₁)
        (Subgroup.inclusion (relWeil_antitone F hM₁MC) w)) = 1
      change restrictWeilChar F hL'M₁ (μ_orb i)
        (Subgroup.inclusion (relWeil_antitone F hM₁MC) w) = 1
      rw [(hμ_props i).2.1, MonoidHom.one_apply]
    · rw [← hFinL'M₁]
      exact (hμ_props i).2.2.1
  have hEval_un :
      evalMonomialList F rec (fun _ _ _ => 1) L ψ D_tame =
        (ν_list.map (fun ν' =>
          tateEpsUnit F L' (recChar F rec L' ν') (traceChar F hLL' ψ))).prod := by
    have h_cons :
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_tame) =
          tateEpsUnit F L (recChar F rec L 1) ψ *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ D_tame := by
      simp only [evalMonomialList, List.map_cons, List.prod_cons, evalMonomialTerm,
        htr_self_L, mul_one, zpow_one]
    have h_eq := h_cons.symm.trans hμ_eval_un
    have h_cancel := mul_left_cancel h_eq
    rw [h_cancel]
    simp only [ν_list, List.map_ofFn, List.prod_ofFn, Function.comp_apply]
  have hEval_tw :
      evalMonomialList F rec (fun _ _ _ => 1) L ψ
          (D_tame.map (twistMonomialTerm F L χL_ext)) =
        (ν_list.map (fun ν' =>
          tateEpsUnit F L'
            (recChar F rec L' (ν' * restrictWeilChar F hLL' χL_ext))
            (traceChar F hLL' ψ))).prod := by
    have h_rest_self :
        (1 : relWeil F L →* (Ω F)ˣ) * restrictWeilChar F (le_rfl : L ≤ L) χL_ext = χL_ext :=
      MonoidHom.ext fun _ => one_mul _
    have h_cons :
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
            ((⟨1, L, le_rfl, 1⟩ :: D_tame).map (twistMonomialTerm F L χL_ext)) =
          tateEpsUnit F L (recChar F rec L χL_ext) ψ *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ
              (D_tame.map (twistMonomialTerm F L χL_ext)) := by
      simp only [evalMonomialList, List.map_cons, List.prod_cons, twistMonomialTerm,
        evalMonomialTerm, h_rest_self, htr_self_L, mul_one, zpow_one]
    have h_eq := h_cons.symm.trans hμ_eval_tw
    have h_cancel := mul_left_cancel h_eq
    rw [h_cancel]
    simp only [ν_list, List.map_ofFn, List.prod_ofFn, Function.comp_apply]
  have hEvalE_un :
      evalMonomialList F rec (fun _ _ _ => 1) E (traceChar F hLE ψ) D_tame_E =
        (ν_list.map (fun ν' =>
          tateEpsUnit F E_L'
            (recChar F rec E_L' (restrictWeilChar F hL'E_L' ν'))
            (traceChar F (hLL'.trans hL'E_L') ψ))).prod := by
    simp only [D_tame_E, ν_list, evalMonomialList, List.map_ofFn, List.prod_ofFn,
      Function.comp_apply, term_E, evalMonomialTerm, mul_one, zpow_one, htr_EL']
    rfl
  have hEvalE_tw :
      evalMonomialList F rec (fun _ _ _ => 1) E (traceChar F hLE ψ)
          (D_tame_E.map (twistMonomialTerm F E (restrictWeilChar F hLE χL_ext))) =
        (ν_list.map (fun ν' =>
          tateEpsUnit F E_L'
            (recChar F rec E_L'
              (restrictWeilChar F hL'E_L' (ν' * restrictWeilChar F hLL' χL_ext)))
            (traceChar F (hLL'.trans hL'E_L') ψ))).prod := by
    have h_char_eq : ∀ i : Fin r,
        restrictWeilChar F hL'E_L' (μ_orb i) *
          restrictWeilChar F hEE_L' (restrictWeilChar F hLE χL_ext) =
        restrictWeilChar F hL'E_L' (μ_orb i * restrictWeilChar F hLL' χL_ext) := by
      intro i
      apply MonoidHom.ext
      intro w
      rfl
    simp only [D_tame_E, ν_list, evalMonomialList, List.map_map, List.map_ofFn, List.prod_ofFn,
      Function.comp_apply, term_E, twistMonomialTerm, evalMonomialTerm, mul_one, zpow_one,
      htr_EL', h_char_eq]
    rfl
  exact ⟨D_tame_E, ν_list, hrE_eq, hν_len, hDtameE_sub, hDtameE_deg, hDtameE_props,
    hν_props, hEval_un, hEval_tw, hEvalE_un, hEvalE_tw⟩

theorem ld_ch14_tame_subdiamond_and_Dtame_E_construction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (χL_ext : relWeil F L →* (Ω F)ˣ)
    (hp_prime : Nat.Prime (p F))
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀) (hq₀_ne_p : q₀ ≠ p F)
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (hG_mul : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
    (h_mem_C : ∀ w : relWeil F L, w ∈ (relWeil F M_C).subgroupOf (relWeil F L) ↔ π w ∈ C)
    (h_sub_MC : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      C ≤ M → (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ M_C)
    (h_sub_lt : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      M < ⊤ → L < (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F)
    (h_field_top : (IntermediateField.lift (IntermediateField.fixedField (⊤ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)))).restrictScalars F = L)
    (h_field_C : (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F = M_C)
    (h_mem_sup : ∀ (M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)) (w : relWeil F L),
      w ∈ (relWeil F (E ⊔ (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F)).subgroupOf
        (relWeil F L) →
      π w ∈ H ∧ π w ∈ M) :
    ((∃ (H' : Subgroup H),
        H'.Normal ∧
        (∀ a b : H, a * b * a⁻¹ * b⁻¹ ∈ H') ∧
        H'.index = q₀) →
      ∃ (F' : IntermediateField F (AlgebraicClosure F)) (hLF' : L ≤ F'),
        F' ≤ M_C ∧
        L < F' ∧
        IsGaloisExt F L F' ∧
        IsAbelianExt F hLF' ∧
        Module.finrank L (IntermediateField.extendScalars hLF') = q₀) ∧
    (∀ (N₁ H_L' H_F' : Subgroup H),
      N₁.Normal →
      H_L'.Normal →
      N₁ ≤ H_L' →
      N₁ ≤ H_F' →
      (∀ h : H, h ∈ H_F' → h ∈ H_L' → h ∈ N₁) →
      (∀ h : H, ∃ x ∈ H_F', ∃ y ∈ H_L', h = x * y) →
      1 < H_L'.index →
      H_F'.index = q₀ →
      (N₁.subgroupOf H_L').index = q₀ →
      (∀ a ∈ H_L', ∀ b ∈ H_L', a * b * a⁻¹ * b⁻¹ ∈ N₁) →
      (∀ h ∈ H_F', (∀ c ∈ H_L', h * c * h⁻¹ * c⁻¹ ∈ N₁) → h ∈ N₁) →
      (∀ M : Subgroup H, N₁ ≤ M → M.Normal → M ≤ N₁ ∨ H_L' ≤ M) →
      ∃ (L' F' M₁ E_L' E' E₁ : IntermediateField F (AlgebraicClosure F))
        (hLL' : L ≤ L') (hL'M₁ : L' ≤ M₁) (hM₁MC : M₁ ≤ M_C)
        (hLF' : L ≤ F') (hF'M₁ : F' ≤ M₁)
        (hEE_L' : E ≤ E_L') (hE_L'E₁ : E_L' ≤ E₁)
        (hEE' : E ≤ E') (hE'E₁ : E' ≤ E₁)
        (hL'E_L' : L' ≤ E_L') (hF'E' : F' ≤ E') (hE_L'K : E_L' ≤ K) (hE'K : E' ≤ K)
        (D_tame : List (MonomialTerm F L))
        (D_tame_E : List (MonomialTerm F E)),
        let hLM₁ : L ≤ M₁ := hLL'.trans hL'M₁
        let hEM₁ : E ≤ E₁ := hEE_L'.trans hE_L'E₁
        let hL'MC : L' ≤ M_C := hL'M₁.trans hM₁MC
        L < L' ∧
        L < F' ∧
        F' ⊓ L' = L ∧
        F' ⊔ L' = M₁ ∧
        E' ⊓ E_L' = E ∧
        E' ⊔ E_L' = E₁ ∧
        E < E_L' ∧
        E ⊔ L' = E_L' ∧
        E ⊔ F' = E' ∧
        IsGaloisExt F L M₁ ∧
        IsGaloisExt F E E₁ ∧
        traceChar F hEE' (traceChar F hLE ψ) = traceChar F (hLF'.trans hF'E') ψ ∧
        IsMinimalAbelianNormalSubfield F L M₁ hLM₁ L' hLL' hL'M₁ ∧
        IsMinimalAbelianNormalSubfield F E E₁ hEM₁ E_L' hEE_L' hE_L'E₁ ∧
        ¬ (p F ∣ Module.finrank L' (IntermediateField.extendScalars hL'M₁)) ∧
        Nat.Prime (Module.finrank L' (IntermediateField.extendScalars hL'M₁)) ∧
        Module.finrank L (IntermediateField.extendScalars hLF') =
          Module.finrank L' (IntermediateField.extendScalars hL'M₁) ∧
        ¬ (p F ∣ Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) ∧
        Nat.Prime (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) ∧
        Module.finrank E (IntermediateField.extendScalars hEE') =
          Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁) ∧
        IsSubMonomialDecomp F L L' F' hLF' (⟨1, L, le_rfl, 1⟩ :: D_tame) ∧
        monomialListDeg F L D_tame =
          (Module.finrank L' (IntermediateField.extendScalars hL'M₁) : ℤ) - 1 ∧
        (∀ t ∈ D_tame,
          t.coeff = 1 ∧
          t.field = L' ∧
          t.χ ^ (Module.finrank L' (IntermediateField.extendScalars hL'M₁)) = 1 ∧
          (∃ htK : t.field ≤ M₁, restrictWeilChar F htK t.χ = 1) ∧
          (∃ htE : t.field ≤ F' ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
          (∀ htM : t.field ≤ L', restrictWeilChar F htM t.χ ≠ 1)) ∧
        IsSubMonomialDecomp F E E_L' E' hEE' (⟨1, E, le_rfl, 1⟩ :: D_tame_E) ∧
        monomialListDeg F E D_tame_E =
          (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁) : ℤ) - 1 ∧
        (∀ t ∈ D_tame_E,
          t.coeff = 1 ∧
          t.field = E_L' ∧
          t.χ ^ (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) = 1 ∧
          (∃ htK : t.field ≤ E₁, restrictWeilChar F htK t.χ = 1) ∧
          (∃ htE : t.field ≤ E' ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
          (∀ htM : t.field ≤ E_L', restrictWeilChar F htM t.χ ≠ 1)) ∧
        1 ≤ D_tame.length ∧
        D_tame_E.length = D_tame.length ∧
        D_tame.length * H_L'.index = q₀ - 1 ∧
        (∃ ν_list : List (relWeil F L' →* (Ω F)ˣ),
          ν_list.length = D_tame.length ∧
          (∀ ν' ∈ ν_list, restrictWeilChar F hL'MC ν' = 1 ∧ ν' ^ q₀ = 1) ∧
          evalMonomialList F rec (fun _ _ _ => 1) L ψ D_tame =
            (ν_list.map (fun ν' =>
              tateEpsUnit F L' (recChar F rec L' ν') (traceChar F hLL' ψ))).prod ∧
          evalMonomialList F rec (fun _ _ _ => 1) L ψ
              (D_tame.map (twistMonomialTerm F L χL_ext)) =
            (ν_list.map (fun ν' =>
              tateEpsUnit F L'
                (recChar F rec L' (ν' * restrictWeilChar F hLL' χL_ext))
                (traceChar F hLL' ψ))).prod ∧
          evalMonomialList F rec (fun _ _ _ => 1) E (traceChar F hLE ψ) D_tame_E =
            (ν_list.map (fun ν' =>
              tateEpsUnit F E_L'
                (recChar F rec E_L' (restrictWeilChar F hL'E_L' ν'))
                (traceChar F (hLL'.trans hL'E_L') ψ))).prod ∧
          evalMonomialList F rec (fun _ _ _ => 1) E (traceChar F hLE ψ)
              (D_tame_E.map (twistMonomialTerm F E (restrictWeilChar F hLE χL_ext))) =
            (ν_list.map (fun ν' =>
              tateEpsUnit F E_L'
                (recChar F rec E_L'
                  (restrictWeilChar F hL'E_L' (ν' * restrictWeilChar F hLL' χL_ext)))
                (traceChar F (hLL'.trans hL'E_L') ψ))).prod) ∧
        (∀ w : relWeil F L,
          w ∈ (relWeil F L').subgroupOf (relWeil F L) ↔
            ∃ h ∈ H_L', ∃ c ∈ C, π w = h.1 * c) ∧
        (∀ w : relWeil F L,
          w ∈ (relWeil F F').subgroupOf (relWeil F L) ↔
            ∃ h ∈ H_F', ∃ c ∈ C, π w = h.1 * c) ∧
        (∀ w : relWeil F L,
          w ∈ (relWeil F M₁).subgroupOf (relWeil F L) ↔
            ∃ h ∈ N₁, ∃ c ∈ C, π w = h.1 * c) ∧
        (∀ x : IntermediateField.extendScalars hLK,
          (x : AlgebraicClosure F) ∈ L' ↔ ∀ h ∈ H_L', ∀ c ∈ C, (h.1 * c) x = x) ∧
        (∀ x : IntermediateField.extendScalars hLK,
          (x : AlgebraicClosure F) ∈ F' ↔ ∀ h ∈ H_F', ∀ c ∈ C, (h.1 * c) x = x) ∧
        (∀ x : IntermediateField.extendScalars hLK,
          (x : AlgebraicClosure F) ∈ M₁ ↔ ∀ h ∈ N₁, ∀ c ∈ C, (h.1 * c) x = x)) :=
by
  obtain ⟨hBranchA, proj_H, _, hproj_id, hproj_surj, hproj_ker, hcomap_mem,
      h_field_H, h_bounds, h_le_iff, h_eq_iff, h_lt_iff, h_sup_eq_inf, h_inf_eq_sup,
      h_finrank_relIndex, h_weil_fieldOf, h_fix_fieldOf, h_gal_fieldOf, h_ab_fieldOf,
      h_exists_norm_sub, h_min_of_prime⟩ :=
    ld_ch14_semidirect_galois_correspondence_and_branch_A F L K M_C E hLK hLM_C hM_CK hLE hEK
      hGal q₀ hq₀_prime π C H hπ hsurj hC_ab hG_mul hZ_H h_mem_H h_sub_MC h_sub_lt
  refine ⟨hBranchA, ?_⟩
  intro N₁ H_L' H_F' hN₁_norm hHL'_norm hN₁_le_HL' hN₁_le_HF' hHF'_HL'_inf hHF'_HL'_mul
    hHL'_idx_gt1 hHF'_idx_eq hN₁_HL'_idx_eq hHL'_comm hZ_HF' _
  obtain ⟨L', F', M₁, E_L', E', E₁, hLL', hL'M₁, hM₁MC, hLF', hF'M₁,
      hEE_L', hE_L'E₁, hEE', hE'E₁, hL'E_L', hF'E', hE_L'K, hE'K,
      hLL'_lt, hLF'_lt, hF'L'_inf, hF'L'_sup, hE'EL'_inf, hE'EL'_sup,
      hEEL'_lt, hEL'_sup, hEF'_sup, _,
      hGalLM₁, hGalEE₁, hMinLM₁, hMinEE₁,
      hFinL'M₁_eq, hFinLF'_eq, hFinLL'_eq, hFinEL'E₁_eq, hFinEE'_eq, hFinEEL'_eq,
      hCore_M₁, hWeil_L', hWeil_F', hWeil_M₁, hFix_L', hFix_F', hFix_M₁⟩ :=
    ld_ch14_tame_subdiamond_fields_and_galois_props F L K M_C E hLK q₀ hq₀_prime π C H
      h_sub_MC h_field_top proj_H hproj_id hproj_surj hproj_ker hcomap_mem h_field_H
      h_bounds h_le_iff h_eq_iff h_lt_iff h_sup_eq_inf h_inf_eq_sup h_finrank_relIndex
      h_weil_fieldOf h_fix_fieldOf h_gal_fieldOf h_ab_fieldOf h_exists_norm_sub h_min_of_prime
      N₁ H_L' H_F' hN₁_norm hHL'_norm hN₁_le_HL' hN₁_le_HF' hHF'_HL'_inf hHF'_HL'_mul
      hHL'_idx_gt1 hHF'_idx_eq hN₁_HL'_idx_eq hHL'_comm hZ_HF'
  have h_ndvd_q₀ : ¬ (p F ∣ q₀) := by
    intro hdvd
    rcases (Nat.dvd_prime hq₀_prime).mp hdvd with h1 | heq
    · exact hp_prime.ne_one h1
    · exact hq₀_ne_p heq.symm
  have hTameL' : ¬ (p F ∣ Module.finrank L' (IntermediateField.extendScalars hL'M₁)) := by
