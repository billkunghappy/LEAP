      ∃ r ∈ R_M₁', z - r = 0 ∨ 1 ≤ valL F M₁' (z - r) := by
    intro z hz
    obtain ⟨s₀, s₁, hz_eq, hz_iff⟩ := hM₁'_coords z
    obtain ⟨hs₀_0, hs₁_0⟩ := (hz_iff 0).mp hz
    have hs₀_int : s₀ = 0 ∨ 0 ≤ valL F L s₀ := by
      rcases hs₀_0 with h0 | hge
      · exact Or.inl h0
      · right; omega
    have hs₁_ge1 : s₁ = 0 ∨
        1 ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ) := by
      rcases hs₁_0 with h0 | hge
      · exact Or.inl h0
      · right; omega
    have hz_sub_s0 : z - ι_M s₀ = ι_M s₁ * x := by
      rw [hz_eq, add_sub_cancel_left]
    have hzs0_val : z - ι_M s₀ = 0 ∨ 1 ≤ valL F M₁' (z - ι_M s₀) := by
      rw [hz_sub_s0]
      rcases eq_or_ne s₁ 0 with h0 | hne0
      · exact Or.inl (by rw [h0, map_zero, zero_mul])
      · right
        have hge1 := hs₁_ge1.resolve_left hne0
        have hι_ne : ι_M s₁ ≠ 0 := (map_ne_zero_iff ι_M ι_M.injective).mpr hne0
        rw [hval_mul_M₁' (ι_M s₁) x hι_ne hx_ne, hval_LM₁' s₁, hx_val]
        omega
    obtain ⟨r_L, hr_L_mem, hsr⟩ := hRL_surj s₀ hs₀_int
    refine ⟨ι_M r_L, Finset.mem_image_of_mem _ hr_L_mem, ?_⟩
    have hsr_M₁' : ι_M s₀ - ι_M r_L = 0 ∨ 1 ≤ valL F M₁' (ι_M s₀ - ι_M r_L) := by
      rw [← map_sub]
      rcases hsr with h0 | hge1
      · exact Or.inl (by rw [h0, map_zero])
      · right
        rw [hval_LM₁' (s₀ - r_L)]
        omega
    have hadd_eq : z - ι_M r_L = (z - ι_M s₀) + (ι_M s₀ - ι_M r_L) := by ring
    rw [hadd_eq]
    exact hval_add_M₁' 1 _ _ hzs0_val hsr_M₁'
  set θE' := recChar F rec E' χE'
  set θM₁' := recChar F rec M₁' χM₁'
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  set m₂ := condExp F E' θE'
  set m₁ := condExp F M₁' θM₁'
  set T₂ := condExp F L νE'
  set T₁ := condExp F L νM₁'
  set d₂ := m₂ / 2
  set d₁ := m₁ / 2
  set r := T₂ / 2
  set a := T₁ / 2
  have hm2_even : m₂ % 2 = 0 := by omega
  have hd_sum : d₂ + r = d₁ + a := by omega
  obtain ⟨δE', hδE'⟩ := hval_surj_E' (d₂ : ℤ)
  obtain ⟨δM₁', hδM₁'⟩ := hval_surj_M₁' (d₁ : ℤ)
  obtain ⟨δνE', hδνE'⟩ := hval_surj_L (r : ℤ)
  obtain ⟨δνM₁', hδνM₁'⟩ := hval_surj_L (a : ℤ)
  have hEpsE' :=
    (((hStat E' ψE' hψE' θE' hmE'_ge2).2 cE' hcE'_val hcE'_stat).2
      R_E' δE' hRE'_int hRE'_sep hRE'_surj hδE').1 hm2_even
  have hEpsM₁' :=
    (((hStat M₁' ψM₁' hψM₁' θM₁' hmM₁'_ge2).2 cM₁' hcM₁'_val hcM₁'_stat).2
      R_M₁' δM₁' hRM₁'_int hRM₁'_sep hRM₁'_surj hδM₁').1 hm1_even
  have hEpsνE' :=
    (((hStat L ψ hψ νE' hbE'_ge2).2 cνE' hcνE'_val hcνE'_stat).2
      R_L δνE' hRL_int hRL_sep hRL_surj hδνE').1 hT2_even
  have hEpsνM₁' :=
    (((hStat L ψ hψ νM₁' hbM₁'_ge2).2 cνM₁' hcνM₁'_val hcνM₁'_stat).2
      R_L δνM₁' hRL_int hRL_sep hRL_surj hδνM₁').1 hT1_even
  have hq_pow :
      (qL F L : Ω F) ^ d₂ * (qL F L : Ω F) ^ r =
        (qL F L : Ω F) ^ d₁ * (qL F L : Ω F) ^ a := by
    rw [← pow_add, ← pow_add, hd_sum]
  rw [hEpsE', hEpsM₁', hEpsνE', hEpsνM₁', heps1_E', heps1_M₁', hqE', hqM₁',
    hRE'_card, hRM₁'_card, hRL_card]
  calc ((qL F L : Ω F) ^ condExpChar F E' ψE' * (qL F L : Ω F) ^ d₂ *
          (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E'))) *
        ((qL F L : Ω F) ^ condExpChar F M₁' ψM₁') *
        ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ r *
          (νE' cνE' : Ω F) * ψ (((cνE'⁻¹ : Lˣ) : L)))
    _ = (qL F L : Ω F) ^ condExpChar F E' ψE' *
          (qL F L : Ω F) ^ condExpChar F M₁' ψM₁' *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F L : Ω F) ^ d₂ * (qL F L : Ω F) ^ r) *
          ((θE' cE' : Ω F) * (νE' cνE' : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L))) := by ring
    _ = (qL F L : Ω F) ^ condExpChar F E' ψE' *
          (qL F L : Ω F) ^ condExpChar F M₁' ψM₁' *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F L : Ω F) ^ d₁ * (qL F L : Ω F) ^ a) *
          ((θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L))) := by
        rw [hq_pow, hPrefactor]
    _ = ((qL F L : Ω F) ^ condExpChar F M₁' ψM₁' * (qL F L : Ω F) ^ d₁ *
          (θM₁' cM₁' : Ω F) * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁'))) *
        ((qL F L : Ω F) ^ condExpChar F E' ψE') *
        ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ a *
          (νM₁' cνM₁' : Ω F) * ψ (((cνM₁'⁻¹ : Lˣ) : L))) := by ring

theorem ld_ch12_wild_dyadic_tot_ram_even_breaks_higher_cond (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hνE'M₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (hNormFactor : ∀ x : Lˣ, ∃ (y : E'ˣ) (z : M₁'ˣ),
      x = Units.map (normLM F hLE') y * Units.map (normLM F hLM₁') z)
    (hχE'_comp : (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁)
    (hχM₁'_comp : (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
      (recChar F rec K₁ χK₁) u = 1)
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
        (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
      condExp F E' (ξE' ^ j * recChar F rec E' χE') =
        condExp F E' (recChar F rec E' χE') ∧
      tateEps F E' (ξE' ^ j * recChar F rec E' χE') (traceChar F hLE' ψ) =
        tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁')),
        (ξM₁' ^ j * recChar F rec M₁' χM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') =
        condExp F M₁' (recChar F rec M₁' χM₁') ∧
      tateEps F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ) =
        tateEps F M₁' (recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ))
    (hCommonRest : ∀ x : Lˣ,
      (recChar F rec E' χE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) *
        νE' x =
      (recChar F rec M₁' χM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) *
        νM₁' x)
    (hFML_E' : ∀ (lam_L : Lˣ →* (Ω F)ˣ),
      (∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
        ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * lam_L)), (νE' ^ j * lam_L) u = 1) →
      (∀ u ∈ unitGroup F E' (condExp F E' (lam_L.comp (Units.map (normLM F hLE')))),
        (lam_L.comp (Units.map (normLM F hLE'))) u = 1) →
      tateEps F E' (lam_L.comp (Units.map (normLM F hLE'))) (traceChar F hLE' ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')),
          tateEps F L (νE' ^ j) ψ) =
      tateEps F E' 1 (traceChar F hLE' ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')),
          tateEps F L (νE' ^ j * lam_L) ψ))
    (hFML_M₁' : ∀ (lam_L : Lˣ →* (Ω F)ˣ),
      (∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
        ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * lam_L)), (νM₁' ^ j * lam_L) u = 1) →
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (lam_L.comp (Units.map (normLM F hLM₁')))),
        (lam_L.comp (Units.map (normLM F hLM₁'))) u = 1) →
      tateEps F M₁' (lam_L.comp (Units.map (normLM F hLM₁'))) (traceChar F hLM₁' ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')),
          tateEps F L (νM₁' ^ j) ψ) =
      tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')),
          tateEps F L (νM₁' ^ j * lam_L) ψ))
    (hPow' :
      (tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ) *
          tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
          tateEps F L νE' ψ) ^ 2 =
        (tateEps F M₁' (recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ) *
          tateEps F E' 1 (traceChar F hLE' ψ) *
          tateEps F L νM₁' ψ) ^ 2)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hBiquadE2 : ∀ C : K₁,
      traceLM F hLE' (normLM F hE'K₁ C) + normLM F hLE' (traceLM F hE'K₁ C) =
        traceLM F hLM₁' (normLM F hM₁'K₁ C) + normLM F hLM₁' (traceLM F hM₁'K₁ C))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hqE' : qL F E' = qL F L)
    (hqM₁' : qL F M₁' = qL F L)
    (hqK₁ : qL F K₁ = qL F L)
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_normK₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w ∧
      valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (heps1_E' : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F L : Ω F) ^ condExpChar F E' (traceChar F hLE' ψ))
    (heps1_M₁' : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
