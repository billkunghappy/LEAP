    have hmk_trM₁' : Units.mk0 (traceLM F hM₁'K₁ (C' : K₁)) htM₁'' * utM₁'⁻¹ =
        Units.mk0 (1 + vM₁') hvM₁'_1ne := by
      apply Units.ext
      rw [Units.val_mul, Units.val_mk0, Units.val_mk0, htrC'_M₁', mul_right_comm,
        Units.mul_inv, one_mul]
    have hCO := (hCommonOrigin α C htE' htM₁').2 C' htE'' htM₁''
    have hC'C_inv : C' * C⁻¹ = W := by
      change C * W * C⁻¹ = W
      rw [mul_right_comm, mul_inv_cancel, one_mul]
    let wE' : Lˣ := Units.map (normLM F hLE') (Units.mk0 (1 + vE') hvE'_1ne)
    let wM₁' : Lˣ := Units.map (normLM F hLM₁') (Units.mk0 (1 + vM₁') hvM₁'_1ne)
    have hνE'_w : νE' wE' = 1 := (hνE'_ker wE').mp ⟨Units.mk0 (1 + vE') hvE'_1ne, rfl⟩
    have hνM₁'_w : νM₁' wM₁' = 1 := (hνM₁'_ker wM₁').mp ⟨Units.mk0 (1 + vM₁') hvM₁'_1ne, rfl⟩
    have hwE'_b : (wE' : L) - 1 = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((wE' : L) - 1) := by
      rw [hT2_half]
      exact hNormLE' vE' hvE'_b hvE'_1ne
    have hwM₁'_b : (wM₁' : L) - 1 = 0 ∨ (((condExp F L νM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((wM₁' : L) - 1) := by
      rw [hT1_half]
      exact hNormLM₁' vM₁' hvM₁'_b hvM₁'_1ne
    have hwE'_1add : 1 + ((wE' : L) - 1) = (wE' : L) := add_sub_cancel 1 (wE' : L)
    have hwE'_1ne : 1 + ((wE' : L) - 1) ≠ 0 := by rw [hwE'_1add]; exact Units.ne_zero wE'
    have hmk_wE' : Units.mk0 (1 + ((wE' : L) - 1)) hwE'_1ne = wE' := Units.ext hwE'_1add
    have hψ_wE' : ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) = 1 := by
      have h := (hcνE'_stat ((wE' : L) - 1) hwE'_b hwE'_1ne).symm
      rw [hmk_wE', hνE'_w, Units.val_one] at h
      exact h
    have hwM₁'_1add : 1 + ((wM₁' : L) - 1) = (wM₁' : L) := add_sub_cancel 1 (wM₁' : L)
    have hwM₁'_1ne : 1 + ((wM₁' : L) - 1) ≠ 0 := by rw [hwM₁'_1add]; exact Units.ne_zero wM₁'
    have hmk_wM₁' : Units.mk0 (1 + ((wM₁' : L) - 1)) hwM₁'_1ne = wM₁' := Units.ext hwM₁'_1add
    have hψ_wM₁' : ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)) = 1 := by
      have h := (hcνM₁'_stat ((wM₁' : L) - 1) hwM₁'_b hwM₁'_1ne).symm
      rw [hmk_wM₁', hνM₁'_w, Units.val_one] at h
      exact h
    dsimp only at hCO
    rw [hC'C_inv, hmk_trE', hmk_trM₁'] at hCO
    change (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) *
        (νE' wE' : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
      (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) *
        (νM₁' wM₁' : Ω F)⁻¹ * ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)) at hCO
    rw [hνE'_w, hνM₁'_w, hψ_wE', hψ_wM₁', Units.val_one, inv_one, mul_one, mul_one,
      mul_one, mul_one] at hCO
    exact hCO
  have hCritPullback : ∀ z : K₁, (z = 0 ∨ 0 ≤ valL F K₁ z) →
      let t₂ := 2 * r - 1
      1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z ≠ 0 ∧
      ∀ hz : 1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z ≠ 0,
        let wz : K₁ˣ := Units.mk0 (1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z) hz
        let uE' : E'ˣ := Units.map (normLM F hE'K₁) wz
        let uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) wz
        (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) =
          (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) := by
    intro z hz t₂
    have hZ_b : ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z = 0 ∨
        2 * (r : ℤ) - 1 ≤ valL F K₁ (((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z) := by
      have hϖ_b : ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) = 0 ∨
          2 * (r : ℤ) - 1 ≤ valL F K₁ ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) := by
        right; rw [hK₁_pow, hϖ_K₁]; dsimp [t₂]; omega
      exact (hK₁_mul_b _ _ _ _ hϖ_b hz).imp id (fun h => by omega)
    have hZ_1ne : 1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z ≠ 0 :=
      hK₁_1add _ (hZ_b.imp id (fun h => by omega))
    exact ⟨hZ_1ne, fun hz' => hMasterTransfer _ hZ_b hz'⟩
  have hcE'_stat : ∀ w : E', (w = 0 ∨ (((m₂ + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ∀ hw : 1 + w ≠ 0,
        (θE' (Units.mk0 (1 + w) hw) : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * w) := by
    clear * - a r m₁ m₂ ψE' ψM₁' θE' θM₁' C_val C cE' cM₁'
      ha_ge1 hr_ge_a hT1_eq hT2_eq hm₁_half hm₂_eq hm₂_half hθE'_triv hSpecE'
      hvalE'_props hvalM₁'_props hvalK₁_props
      hE'_mul_b hE'_ug_mono hK₁_ug_mono
      hnorm_surj_gt_E'K₁ hnorm_le_M₁'K₁
      hcE'_val hcM₁'_stat hMasterTransfer
    have hNorm2r : ∀ W ∈ unitGroup F K₁ (2 * r),
        let uE' : E'ˣ := Units.map (normLM F hE'K₁) W
        (θE' uE' : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) := by
      intro W hW uE'
      have hZ_b : (W : K₁) - 1 = 0 ∨ 2 * (r : ℤ) - 1 ≤ valL F K₁ ((W : K₁) - 1) := by
        have hmem := (hvalK₁_props.2.2.2.2.2.2.2.2.2.1 (2 * r) (by omega) W).mp hW
        rcases hmem with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · right; push_cast at hge; omega
      have h1Z_eq : 1 + ((W : K₁) - 1) = (W : K₁) := add_sub_cancel 1 (W : K₁)
      have h1Z : 1 + ((W : K₁) - 1) ≠ 0 := by rw [h1Z_eq]; exact Units.ne_zero W
      have hmk_W : Units.mk0 (1 + ((W : K₁) - 1)) h1Z = W := Units.ext h1Z_eq
      let uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) W
      have huM₁'_mem : uM₁' ∈ unitGroup F M₁' (2 * r) :=
        hnorm_le_M₁'K₁ (2 * r) (by omega) W hW
      let zM₁' : M₁' := (uM₁' : M₁') - 1
      have hzM₁'_b : zM₁' = 0 ∨ (((m₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' zM₁' := by
        rw [hm₁_half]
        have hmem := (hvalM₁'_props.2.2.2.2.2.2.2.2.2.1 (2 * r) (by omega) uM₁').mp huM₁'_mem
        rcases hmem with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      have h1zM₁'_eq : 1 + zM₁' = (uM₁' : M₁') := add_sub_cancel 1 (uM₁' : M₁')
      have h1zM₁' : 1 + zM₁' ≠ 0 := by rw [h1zM₁'_eq]; exact Units.ne_zero uM₁'
      have hmk_uM₁' : Units.mk0 (1 + zM₁') h1zM₁' = uM₁' := Units.ext h1zM₁'_eq
      have hstat_M₁' := hcM₁'_stat zM₁' hzM₁'_b h1zM₁'
      rw [hmk_uM₁'] at hstat_M₁'
      have hMT := hMasterTransfer ((W : K₁) - 1) hZ_b h1Z
      dsimp only at hMT
      rw [hmk_W] at hMT
      change (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) =
        (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * zM₁') at hMT
      rw [← hstat_M₁', inv_mul_cancel₀ (Units.ne_zero _)] at hMT
      exact (inv_mul_eq_one₀ (Units.ne_zero _)).mp hMT
    have hψE'_vanish : ∀ y : E', (y = 0 ∨ (m₂ : ℤ) ≤ valL F E' y) →
        ψE' (((cE'⁻¹ : E'ˣ) : E') * y) = 1 := by
      intro y hy
      have hcE'_inv_b : ((cE'⁻¹ : E'ˣ) : E') = 0 ∨
          -((m₂ : ℤ) + condExpChar F E' (traceChar F hLE' ψ)) ≤ valL F E' ((cE'⁻¹ : E'ˣ) : E') := by
        right; rw [hvalE'_props.2.2.2.2.2.1 cE', hcE'_val]
      rcases hE'_mul_b _ _ _ _ hcE'_inv_b hy with h0 | hge
      · exact hSpecE' _ (Or.inl h0)
      · exact hSpecE' _ (Or.inr (by omega))
    have hΦ_mul : ∀ u₁ u₂ : E'ˣ,
        u₁ ∈ unitGroup F E' (a + r) → u₂ ∈ unitGroup F E' (a + r) →
        ψE' (((cE'⁻¹ : E'ˣ) : E') * (((u₁ * u₂ : E'ˣ) : E') - 1)) =
          ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u₁ : E') - 1)) *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u₂ : E') - 1)) := by
      intro u₁ u₂ hu₁ hu₂
      let w₁ : E' := (u₁ : E') - 1
      let w₂ : E' := (u₂ : E') - 1
      have hw₁_b : w₁ = 0 ∨ ((a + r : ℕ) : ℤ) ≤ valL F E' w₁ := by
        rcases (hvalE'_props.2.2.2.2.2.2.2.2.2.1 (a + r) (by omega) u₁).mp hu₁ with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      have hw₂_b : w₂ = 0 ∨ ((a + r : ℕ) : ℤ) ≤ valL F E' w₂ := by
        rcases (hvalE'_props.2.2.2.2.2.2.2.2.2.1 (a + r) (by omega) u₂).mp hu₂ with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      have hw₁₂_b : w₁ * w₂ = 0 ∨ (m₂ : ℤ) ≤ valL F E' (w₁ * w₂) :=
        (hE'_mul_b _ _ w₁ w₂ hw₁_b hw₂_b).imp id (fun h => by omega)
      have hsplit : ((cE'⁻¹ : E'ˣ) : E') * (((u₁ * u₂ : E'ˣ) : E') - 1) =
          (((cE'⁻¹ : E'ˣ) : E') * w₁ + ((cE'⁻¹ : E'ˣ) : E') * w₂) +
            ((cE'⁻¹ : E'ˣ) : E') * (w₁ * w₂) := by
        rw [Units.val_mul]
        dsimp [w₁, w₂]
        ring
      rw [hsplit, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, hψE'_vanish _ hw₁₂_b, mul_one]
    have hInd : ∀ (k : ℕ) (r_lvl : ℕ), a + r ≤ r_lvl → m₂ - r_lvl = k →
        ∀ u ∈ unitGroup F E' r_lvl,
          (θE' u : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u : E') - 1)) := by
      intro k
      induction k with
      | zero =>
        intro r_lvl hr hk u hu
        have hr_ge : m₂ ≤ r_lvl := by omega
        have hu_m₂ : u ∈ unitGroup F E' m₂ := hE'_ug_mono m₂ r_lvl (by omega) hr_ge u hu
        have hθ1 : θE' u = 1 := hθE'_triv u hu_m₂
        have hw_b : (u : E') - 1 = 0 ∨ (m₂ : ℤ) ≤ valL F E' ((u : E') - 1) := by
          rcases (hvalE'_props.2.2.2.2.2.2.2.2.2.1 m₂ (by omega) u).mp hu_m₂ with h1 | hge
          · exact Or.inl (sub_eq_zero.mpr h1)
          · exact Or.inr hge
        rw [hθ1, Units.val_one, hψE'_vanish _ hw_b]
      | succ k ih =>
        intro r_lvl hr hk u hu
        obtain ⟨W, hW_mem, hv_mem⟩ := hnorm_surj_gt_E'K₁ r_lvl (by omega) u hu
        let v : E'ˣ := (Units.map (normLM F hE'K₁) W) * u⁻¹
        let uW : E'ˣ := Units.map (normLM F hE'K₁) W
        have hW_2r : W ∈ unitGroup F K₁ (2 * r) :=
          hK₁_ug_mono (2 * r) _ (by omega) (by omega) W hW_mem
        have hv_inv_mem : v⁻¹ ∈ unitGroup F E' (r_lvl + 1) := Subgroup.inv_mem _ hv_mem
        have hv_inv_ar : v⁻¹ ∈ unitGroup F E' (a + r) :=
          hE'_ug_mono (a + r) (r_lvl + 1) (by omega) (by omega) v⁻¹ hv_inv_mem
        have hu_ar : u ∈ unitGroup F E' (a + r) :=
          hE'_ug_mono (a + r) r_lvl (by omega) hr u hu
        have hv_ar : v ∈ unitGroup F E' (a + r) :=
          hE'_ug_mono (a + r) (r_lvl + 1) (by omega) (by omega) v hv_mem
        have huW_ar : uW ∈ unitGroup F E' (a + r) := by
          have heq : v * u = uW := inv_mul_cancel_right uW u
          rw [← heq]
          exact Subgroup.mul_mem _ hv_ar hu_ar
        have hu_eq : u = v⁻¹ * uW := by
          dsimp [v, uW]
          group
        have h_ih := ih (r_lvl + 1) (by omega) (by omega) v⁻¹ hv_inv_mem
        have h_W := hNorm2r W hW_2r
        rw [hu_eq, map_mul, Units.val_mul, h_ih, h_W, ← hΦ_mul v⁻¹ uW hv_inv_ar huW_ar]
    intro w hw hw1
    let u : E'ˣ := Units.mk0 (1 + w) hw1
    have hu_mem : u ∈ unitGroup F E' (a + r) := by
      rw [hvalE'_props.2.2.2.2.2.2.2.2.2.1 (a + r) (by omega) u]
      have hsub : (u : E') - 1 = w := add_sub_cancel_left 1 w
      rw [hsub]
      rw [hm₂_half] at hw
      rcases hw with rfl | hge
      · left; exact add_zero 1
      · right; exact hge
    have hres := hInd (m₂ - (a + r)) (a + r) (le_refl _) rfl u hu_mem
    have hsub : (u : E') - 1 = w := add_sub_cancel_left 1 w
    rwa [hsub] at hres
  exact ⟨C, htE', htM₁', hC_val_eq, hcE'_val, hcE'_stat, hcM₁'_val, hcM₁'_stat,
    hcνE'_val, hcνE'_stat, hcνM₁'_val, hcνM₁'_stat, hCritPullback⟩

theorem ld_ch12_wild_dyadic_even_breaks_simultaneous_stationary_origin (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ)
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
    (hm2_min : condExp F E' (recChar F rec E' χE') =
      condExp F L νM₁' + condExp F L νE' - 1)
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' (recChar F rec E' χE')),
      (recChar F rec E' χE') u = 1)
    (hθM₁'_triv : ∀ u ∈ unitGroup F M₁' (condExp F M₁' (recChar F rec M₁' χM₁')),
      (recChar F rec M₁' χM₁') u = 1)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hCommonOrigin :
      ∀ (α : Lˣ) (C : K₁ˣ)
        (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0)
        (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0),
        let ψE' := traceChar F hLE' ψ
        let ψM₁' := traceChar F hLM₁' ψ
        let θE' := recChar F rec E' χE'
        let θM₁' := recChar F rec M₁' χM₁'
        let cE' : E'ˣ :=
          Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
            (Units.map (normLM F hE'K₁) C)⁻¹
        let cνE' : Lˣ :=
          α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹
        let cM₁' : M₁'ˣ :=
          Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
            (Units.map (normLM F hM₁'K₁) C)⁻¹
        let cνM₁' : Lˣ :=
          α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹
        (θE' cE' : Ω F) * (νE' cνE' : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L)) =
          (θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)) ∧
        ∀ (C' : K₁ˣ)
          (htE'' : traceLM F hE'K₁ (C' : K₁) ≠ 0)
          (htM₁'' : traceLM F hM₁'K₁ (C' : K₁) ≠ 0),
          let uE' : E'ˣ := Units.map (normLM F hE'K₁) (C' * C⁻¹)
          let wE' : Lˣ :=
            Units.map (normLM F hLE')
              (Units.mk0 (traceLM F hE'K₁ (C' : K₁)) htE'' *
                (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE')⁻¹)
          let uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) (C' * C⁻¹)
          let wM₁' : Lˣ :=
            Units.map (normLM F hLM₁')
              (Units.mk0 (traceLM F hM₁'K₁ (C' : K₁)) htM₁'' *
                (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁')⁻¹)
          (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) *
              (νE' wE' : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
            (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) *
              (νM₁' wM₁' : Ω F)⁻¹ * ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)))
    (hStatM₁' : ∃ c_θ₁ : M₁'ˣ,
