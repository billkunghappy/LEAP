        linear_combination h1
      have hdecomp :
          (N_fn m - B_fn m) - b * T_lin * ξ_base m =
            (B_fn m - b) * (T_lin * ξ_base m) + B_fn m * (ν_fn m - T_lin * ξ_base m) := by
