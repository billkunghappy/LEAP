      exact hP_mono (by omega) (hP_mul (hP_sq hP_δb) (hP_mul hx₂ h12))
    have hν_eq : ν₁ (u₂ * w) = ν₁ u₁ := hν₁_congr hu₁_val hpoly_Pb
    have hν_mul : (ν₁ u₁ : Ω F) = (ν₁ u₂ : Ω F) * (ν₁ w : Ω F) := by
      rw [← hν_eq, map_mul, Units.val_mul]
    have hν_w : (ν₁ w : Ω F) = ψ (A * ((δ_b : L) * (x₁ - x₂))) :=
      hc_ν₁_stat ((δ_b : L) * (x₁ - x₂)) hδ12_stat hw_ne
    have hψ_split : ψ (A * (δ_b : L) * x₁) =
