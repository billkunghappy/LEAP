          ∑ u₀ : G₀ ⧸ H,
            if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then
              (ψ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩ : Ω F)
            else 0 := by
      rw [← Fintype.sum_equiv e_coset _ _ (fun _ => rfl), Fintype.sum_prod_type]
      conv_lhs =>
        arg 2
        ext u₀
        arg 2
        ext y
        rw [h_summand u₀ y]
      conv_lhs =>
        arg 2
        ext u₀
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
      rw [← Finset.mul_sum]
    unfold indCharTrace
    rw [h_sum_G]
    have hH_ne : (Nat.card H : Ω F) ≠ 0 :=
      Nat.cast_ne_zero.mpr (Nat.card_pos (α := H)).ne'
    exact inv_mul_cancel_left₀ hH_ne _
  refine ⟨t, ht_wf, fun w => ?_⟩
  change n • LinearMap.trace (Ω F) (indSpace H_E ρ_E) (indRep H_E ρ_E w) = _
  rw [h_trace_coset w, h_ind_eq (π w)]

theorem ld_brauer_monomial_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] {V : Type u} [AddCommGroup V] [Module (Ω F) V]
    (σ : Representation (Ω F) (relWeil F L) V) (hσ : IsWeilRep F L σ) :
    ∃ D : List (MonomialTerm F L),
      IsMonomialDecomp F L (fun w => LinearMap.trace (Ω F) V (σ w)) D :=
by
  have htrace_append : ∀ (D₁ D₂ : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (D₁ ++ D₂) w =
        monomialListTrace F L D₁ w + monomialListTrace F L D₂ w := by
    intro D₁ D₂ w
    simp [monomialListTrace, List.map_append, List.sum_append]
  obtain ⟨htrace_exact, _, _⟩ := ld_trace_exact_and_char F
  suffices h_ind : ∀ (d : ℕ) {V : Type u} [AddCommGroup V] [Module (Ω F) V]
      (σ : Representation (Ω F) (relWeil F L) V),
      IsWeilRep F L σ →
      Module.finrank (Ω F) V = d →
      ∃ D : List (MonomialTerm F L),
        IsMonomialDecomp F L (fun w => LinearMap.trace (Ω F) V (σ w)) D by
    exact h_ind (Module.finrank (Ω F) V) σ hσ rfl
  intro d
  induction' d using Nat.strong_induction_on with d ih
  intro V _ _ σ hσ hd
  haveI : FiniteDimensional (Ω F) V := hσ.1
  rcases Nat.eq_zero_or_pos d with rfl | hd_pos
  · haveI : Subsingleton V := Module.finrank_zero_iff.mp hd
    refine ⟨[], ⟨by simp, fun w => ?_⟩⟩
    have hw : σ w = 0 := Subsingleton.elim _ _
    simp [monomialListTrace, hw]
  · by_cases h_irr : ∀ W : Submodule (Ω F) V,
        (∀ w : relWeil F L, W ≤ Submodule.comap (σ w) W) → W = ⊥ ∨ W = ⊤
    · have hV_pos : 0 < Module.finrank (Ω F) V := hd.symm ▸ hd_pos
      haveI : Nontrivial V := Module.nontrivial_of_finrank_pos hV_pos
      obtain ⟨K, hLK, hFinK, hGal, G₀, π, ω, bar_σ, hπ, hsurj, hω, hσ_eq⟩ :=
        ld_irreducible_weil_rep_untwist F L σ hσ h_irr
      haveI : FiniteDimensional F K := hFinK
      haveI : IsGalois L (IntermediateField.extendScalars hLK) := hGal
      haveI : FiniteDimensional F (IntermediateField.extendScalars hLK) := hFinK
      haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) :=
        FiniteDimensional.right F L (IntermediateField.extendScalars hLK)
      haveI : Fintype G₀ := inferInstance
      have h_lift_list : ∀ (a : ℤ) (L_mon : List (ℤ × Σ (M : Subgroup G₀), (M →* (Ω F)ˣ))),
          ∃ D : List (MonomialTerm F L),
            (∀ t ∈ D, t.Wf F L) ∧
            ∀ w : relWeil F L,
              monomialListTrace F L D w =
                a • ((ω w : Ω F) *
                  (L_mon.map fun q => q.1 • indCharTrace F q.2.1 q.2.2 (π w)).sum) := by
        intro a L_mon
        induction L_mon with
        | nil =>
          refine ⟨[], ⟨by simp, fun w => by simp [monomialListTrace]⟩⟩
        | cons q tl ih_mon =>
          rcases ih_mon with ⟨D_tl, hD_tl_wf, hD_tl_tr⟩
          obtain ⟨t_q, ht_q_wf, ht_q_tr⟩ :=
            ld_galois_quotient_monomial_lift F L K hLK G₀ π hπ hsurj ω hω
              (a * q.1) q.2.1 q.2.2
          refine ⟨t_q :: D_tl, ⟨?_, ?_⟩⟩
          · intro t ht
            rw [List.mem_cons] at ht
            rcases ht with rfl | ht
            · exact ht_q_wf
            · exact hD_tl_wf t ht
          · intro w
            simp only [monomialListTrace, List.map_cons, List.sum_cons] at hD_tl_tr ⊢
            rw [ht_q_tr w, hD_tl_tr w]
            simp only [zsmul_eq_mul, Int.cast_mul]
            ring
      have h_qe_list : ∀ (L_sub : List (ℤ × Subgroup G₀)),
          (∀ p ∈ L_sub, IsQuasiElementary p.2) →
          ∃ D : List (MonomialTerm F L),
            (∀ t ∈ D, t.Wf F L) ∧
            ∀ w : relWeil F L,
              monomialListTrace F L D w =
                (ω w : Ω F) * LinearMap.trace (Ω F) V (bar_σ (π w)) *
                  (L_sub.map fun p => p.1 • indCharTrace F p.2 1 (π w)).sum := by
        intro L_sub h_sub
        induction L_sub with
        | nil =>
          refine ⟨[], ⟨by simp, fun w => by simp [monomialListTrace]⟩⟩
        | cons p tl ih_qe =>
          have hp : IsQuasiElementary p.2 := h_sub p (by simp)
          have htl : ∀ p' ∈ tl, IsQuasiElementary p'.2 :=
            fun p' hp' => h_sub p' (by simp [hp'])
          obtain ⟨D_tl, hD_tl_wf, hD_tl_tr⟩ := ih_qe htl
          obtain ⟨L_mon, hL_mon⟩ :=
            ld_quasi_elementary_monomial_decomp F G₀ p.2 hp bar_σ
          obtain ⟨D_hd, hD_hd_wf, hD_hd_tr⟩ := h_lift_list p.1 L_mon
          refine ⟨D_hd ++ D_tl, ⟨?_, ?_⟩⟩
          · intro t ht
            rw [List.mem_append] at ht
            rcases ht with ht | ht
            · exact hD_hd_wf t ht
            · exact hD_tl_wf t ht
          · intro w
            rw [htrace_append, hD_hd_tr w, hD_tl_tr w, ← hL_mon (π w)]
            simp only [List.map_cons, List.sum_cons, zsmul_eq_mul]
            ring
      obtain ⟨L_qe, hL_qe_wf, hL_qe_sum⟩ := ld_solomon_quasi_elementary_decomp F G₀
      obtain ⟨D, hD_wf, hD_tr⟩ := h_qe_list L_qe hL_qe_wf
      refine ⟨D, ⟨hD_wf, fun w => ?_⟩⟩
      dsimp only
      rw [hD_tr w, hL_qe_sum (π w), mul_one, hσ_eq w, map_smul, smul_eq_mul]
    · push_neg at h_irr
      rcases h_irr with ⟨W, hW_inv, hW_bot, hW_top⟩
      let σ₁ : Representation (Ω F) (relWeil F L) W :=
        { toFun := fun w => (σ w).restrict (fun x hx => hW_inv w hx)
          map_one' := by
            ext x
            simp
          map_mul' := fun w₁ w₂ => by
            ext x
            simp [Module.End.mul_apply] }
      let σ₂ : Representation (Ω F) (relWeil F L) (V ⧸ W) :=
        { toFun := fun w => Submodule.mapQ W W (σ w) (hW_inv w)
          map_one' := LinearMap.ext fun q => Submodule.Quotient.induction_on W q fun x => by
            change Submodule.Quotient.mk (σ 1 x) = Submodule.Quotient.mk x
            rw [map_one, Module.End.one_apply]
          map_mul' := fun w₁ w₂ => LinearMap.ext fun q => Submodule.Quotient.induction_on W q fun x => by
            change Submodule.Quotient.mk (σ (w₁ * w₂) x) = Submodule.Quotient.mk (σ w₁ (σ w₂ x))
            rw [map_mul, Module.End.mul_apply] }
      rcases hσ.2 with ⟨U, hU_nhds, hU_triv⟩
      have hσ₁ : IsWeilRep F L σ₁ := by
        refine ⟨inferInstance, U, hU_nhds, fun w hwU hwI => ?_⟩
        have hw := hU_triv w hwU hwI
        ext x
        change (σ w x.1 : V) = x.1
        rw [hw, Module.End.one_apply]
      have hσ₂ : IsWeilRep F L σ₂ := by
        refine ⟨inferInstance, U, hU_nhds, fun w hwU hwI => ?_⟩
        have hw := hU_triv w hwU hwI
        apply LinearMap.ext
        intro q
        refine Submodule.Quotient.induction_on W q fun x => ?_
        change Submodule.Quotient.mk (σ w x) = Submodule.Quotient.mk x
        rw [hw, Module.End.one_apply]
      have hW_lt : Module.finrank (Ω F) W < d := hd ▸ Submodule.finrank_lt hW_top
      haveI : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hW_bot
      have hW_pos : 0 < Module.finrank (Ω F) W := Module.finrank_pos
      have h_add : Module.finrank (Ω F) (V ⧸ W) + Module.finrank (Ω F) W = d :=
        hd ▸ Submodule.finrank_quotient_add_finrank W
      have hVW_lt : Module.finrank (Ω F) (V ⧸ W) < d := by omega
      obtain ⟨D₁, hD₁⟩ := ih (Module.finrank (Ω F) W) hW_lt σ₁ hσ₁ rfl
      obtain ⟨D₂, hD₂⟩ := ih (Module.finrank (Ω F) (V ⧸ W)) hVW_lt σ₂ hσ₂ rfl
      have hf_comm : ∀ w, W.subtype ∘ₗ σ₁ w = σ w ∘ₗ W.subtype := fun w => by
        ext x
        rfl
      have hg_comm : ∀ w, W.mkQ ∘ₗ σ w = σ₂ w ∘ₗ W.mkQ := fun w => by
        ext x
        rfl
      have h_exact : LinearMap.range W.subtype = LinearMap.ker W.mkQ :=
        (Submodule.range_subtype W).trans (Submodule.ker_mkQ W).symm
      refine ⟨D₁ ++ D₂, ⟨?_, ?_⟩⟩
      · intro t ht
        rw [List.mem_append] at ht
        rcases ht with ht | ht
        · exact hD₁.1 t ht
        · exact hD₂.1 t ht
      · intro w
        dsimp only
        have htr := htrace_exact L σ₁ σ σ₂ hσ₁ hσ hσ₂ W.subtype W.mkQ
          hf_comm hg_comm (Submodule.subtype_injective W) (Submodule.mkQ_surjective W) h_exact w
        have h1 : LinearMap.trace (Ω F) W (σ₁ w) = monomialListTrace F L D₁ w := hD₁.2 w
        have h2 : LinearMap.trace (Ω F) (V ⧸ W) (σ₂ w) = monomialListTrace F L D₂ w := hD₂.2 w
        rw [htr, h1, h2, htrace_append]

theorem ld_traceChar_admissible (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (h : L ≤ M) (hSep : Algebra.IsSeparable L (IntermediateField.extendScalars h))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ) :
    IsAdmissibleChar F M (traceChar F h ψ) :=
by
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  
  have hs1 : Function.Surjective (traceLM F h) ∧
      ∀ y : M, ∃ s : Multiset (AlgebraicClosure F),
        ((traceLM F h y : L) : AlgebraicClosure F) = s.sum ∧
        ∀ r ∈ s, minpoly F r = minpoly F (y : AlgebraicClosure F) := by
    let S := IntermediateField.extendScalars h
    let eF : M ≃ₐ[F] S := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    haveI : FiniteDimensional F S := Module.Finite.equiv eF.toLinearEquiv
    haveI : FiniteDimensional L S := Module.Finite.of_restrictScalars_finite F L S
    refine ⟨?_, ?_⟩
    · intro x
      obtain ⟨y', hy'⟩ := @Algebra.trace_surjective L S _ _ _ _ hSep x
      refine ⟨eF.symm y', ?_⟩
      change Algebra.trace L S (toExtendScalars F h (eF.symm y')) = x
      have he : toExtendScalars F h (eF.symm y') = y' := rfl
      rw [he, hy']
    · intro y
      let y' : S := toExtendScalars F h y
      have hsplit : ((minpoly L y').map (algebraMap L (AlgebraicClosure F))).Splits :=
        IsAlgClosed.splits _
      have htr := trace_eq_sum_roots hsplit
      rw [← Multiset.sum_nsmul] at htr
      refine ⟨_, htr, ?_⟩
      intro r hr
      have hr_root : r ∈ (minpoly L y').aroots (AlgebraicClosure F) :=
        (Multiset.mem_nsmul.mp hr).2
      have haeval_L : Polynomial.aeval r (minpoly L y') = 0 :=
        (Polynomial.mem_aroots.mp hr_root).2
      have hmin_eq : minpoly L (y : AlgebraicClosure F) = minpoly L y' := by
        have hval : S.val y' = (y : AlgebraicClosure F) := rfl
        rw [← hval]
        exact minpoly.algHom_eq S.val S.val.injective y'
      rw [← hmin_eq] at haeval_L
      let q := minpoly F (y : AlgebraicClosure F)
      have hq_aeval : Polynomial.aeval (y : AlgebraicClosure F) (q.map (algebraMap F L)) = 0 := by
        rw [Polynomial.aeval_map_algebraMap, minpoly.aeval]
      have hdvd : minpoly L (y : AlgebraicClosure F) ∣ q.map (algebraMap F L) :=
        minpoly.dvd L (y : AlgebraicClosure F) hq_aeval
      have hr_q_map : Polynomial.aeval r (q.map (algebraMap F L)) = 0 :=
        Polynomial.aeval_eq_zero_of_dvd_aeval_eq_zero hdvd haeval_L
      have hr_q : Polynomial.aeval r q = 0 := by
        rwa [Polynomial.aeval_map_algebraMap] at hr_q_map
      have hy_int : IsIntegral F (y : AlgebraicClosure F) := Algebra.IsIntegral.isIntegral _
      exact (minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hy_int) hr_q
        (minpoly.monic hy_int)).symm
  
  have halg : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (z : K),
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F K = (minpoly F z).natDegree * m := by
    clear! L M
    clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
    intro K _ z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq K.val K.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  have hs2 : ∀ (x : L) (y : M) (s : Multiset (AlgebraicClosure F)),
      (x : AlgebraicClosure F) = s.sum →
      (∀ r ∈ s, minpoly F r = minpoly F (y : AlgebraicClosure F)) →
      valuation F ((Algebra.norm F x) ^ (Module.finrank F M)) ≤
        valuation F ((Algebra.norm F y) ^ (Module.finrank F L)) := by
    intro x y s hs_sum hs_min
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
      Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
    have hspec_pow : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (z : K),
        (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F K) =
          ‖Algebra.norm F z‖ := by
      intro K _ z
      obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg K z
      have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
          ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
        rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
      have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
        rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
        exact_mod_cast minpoly.natDegree_pos hz
      rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
         ← Real.rpow_natCast]
      congr 1
      push_cast
      rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
    have hsum_le : spectralNorm F (AlgebraicClosure F) s.sum ≤
        spectralNorm F (AlgebraicClosure F) (y : AlgebraicClosure F) := by
      clear hs_sum
      induction s using Multiset.induction_on with
      | empty =>
        rw [Multiset.sum_zero, spectralNorm_zero]
        exact spectralNorm_nonneg _
      | cons a t ih =>
        rw [Multiset.sum_cons]
        have ha_min : minpoly F a = minpoly F (y : AlgebraicClosure F) :=
          hs_min a (Multiset.mem_cons_self a t)
        have ha_spec : spectralNorm F (AlgebraicClosure F) a =
            spectralNorm F (AlgebraicClosure F) (y : AlgebraicClosure F) := by
          change spectralValue (minpoly F a) = spectralValue (minpoly F (y : AlgebraicClosure F))
          rw [ha_min]
        have ht : ∀ r ∈ t, minpoly F r = minpoly F (y : AlgebraicClosure F) :=
          fun r hr => hs_min r (Multiset.mem_cons_of_mem hr)
        calc spectralNorm F (AlgebraicClosure F) (a + t.sum)
          _ ≤ max (spectralNorm F (AlgebraicClosure F) a)
                (spectralNorm F (AlgebraicClosure F) t.sum) :=
              isNonarchimedean_spectralNorm _ _
          _ ≤ spectralNorm F (AlgebraicClosure F) (y : AlgebraicClosure F) :=
              max_le (le_of_eq ha_spec) (ih ht)
    have hx_le_y : spectralNorm F (AlgebraicClosure F) (x : AlgebraicClosure F) ≤
        spectralNorm F (AlgebraicClosure F) (y : AlgebraicClosure F) := by
      rw [hs_sum]
      exact hsum_le
    have hpow_le :
        (spectralNorm F (AlgebraicClosure F) (x : AlgebraicClosure F)) ^
          (Module.finrank F L * Module.finrank F M) ≤
        (spectralNorm F (AlgebraicClosure F) (y : AlgebraicClosure F)) ^
          (Module.finrank F L * Module.finrank F M) :=
      pow_le_pow_left₀ (spectralNorm_nonneg _) hx_le_y _
    have hnorm_pow_le :
        ‖(Algebra.norm F x) ^ (Module.finrank F M)‖ ≤
          ‖(Algebra.norm F y) ^ (Module.finrank F L)‖ := by
      rw [norm_pow, norm_pow, ← hspec_pow L x, ← hspec_pow M y, ← pow_mul, ← pow_mul,
        mul_comm (Module.finrank F M) (Module.finrank F L)]
      exact hpow_le
    have hv_eq : ∀ a : F, ‖a‖ = ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
        (valuation F a) : ℝ) := fun a => rfl
    rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hnorm_pow_le
    exact (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
      hnorm_pow_le
  
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b → addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  have hresDeg_pos : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K],
      0 < resDeg F K := by
    intro K _
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x : K := algebraMap F K π
    have hx_ne : x ≠ 0 := by
      simp [x, hπ_ne]
    have hrel_x : relVal F K x = (Module.finrank F K : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F K) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F K := Module.finrank_pos
    have hmem : Module.finrank F K ∈ {k : ℕ | 0 < k ∧ ∃ x : K, x ≠ 0 ∧ relVal F K x = k} :=
      ⟨hfin_pos, x, hx_ne, hrel_x⟩
    exact (Nat.sInf_mem ⟨Module.finrank F K, hmem⟩).1
  
  obtain ⟨hsurj, hsum_roots⟩ := hs1
  refine ⟨?_, ?_⟩
  · intro h1
    have hψ_ne := hψ.1
    rw [DFunLike.ne_iff] at hψ_ne
    obtain ⟨x₀, hx₀⟩ := hψ_ne
    obtain ⟨y₀, hy₀⟩ := hsurj x₀
    apply hx₀
    have hy1 : traceChar F h ψ y₀ = 1 := by
      rw [h1]
      rfl
    change ψ (traceLM F h y₀) = 1 at hy1
    rwa [hy₀] at hy1
  · obtain ⟨d_L, hd_L⟩ := hψ.2
    let d_M : ℤ := max d_L 1 * (resDeg F L + 1 : ℤ) * (Module.finrank F M : ℤ)
    refine ⟨d_M, fun y hy => ?_⟩
    change ψ (traceLM F h y) = 1
    by_cases htr : traceLM F h y = 0
    · rw [htr, AddChar.map_zero_eq_one]
    · have hy_ne : y ≠ 0 := by
        intro hy0
        apply htr
        rw [hy0, map_zero]
      set x := traceLM F h y
      have hx_norm : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr htr
      have hy_norm : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy_ne
      obtain ⟨s, hs_sum, hs_min⟩ := hsum_roots y
      have hval_pow := hs2 x y s hs_sum hs_min
      have hadd_ineq := hval_le _ _ (pow_ne_zero _ hx_norm) hval_pow
      rw [haddVal_pow _ _ hx_norm, haddVal_pow _ _ hy_norm] at hadd_ineq
      change (Module.finrank F L : ℤ) * relVal F M y ≤
        (Module.finrank F M : ℤ) * relVal F L x at hadd_ineq
      have hfL_pos : (0 : ℤ) < (resDeg F L : ℤ) := by exact_mod_cast hresDeg_pos L
      have hfM_pos : (0 : ℤ) < (resDeg F M : ℤ) := by exact_mod_cast hresDeg_pos M
      have hfinL_pos : (0 : ℤ) < (Module.finrank F L : ℤ) := by exact_mod_cast Module.finrank_pos
      have hfinM_pos : (0 : ℤ) < (Module.finrank F M : ℤ) := by exact_mod_cast Module.finrank_pos
      have hy_rel : d_M * (resDeg F M : ℤ) ≤ relVal F M y :=
        (Int.le_ediv_iff_mul_le hfM_pos).mp hy
      have hd_M_pos : 0 < d_M := by
        have hmax_pos : (0 : ℤ) < max d_L 1 := by omega
        have hfL1_pos : (0 : ℤ) < (resDeg F L + 1 : ℤ) := by omega
        exact mul_pos (mul_pos hmax_pos hfL1_pos) hfinM_pos
      have hy_rel_ge : d_M ≤ relVal F M y := by
        nlinarith
      have hx_rel_ge : max d_L 1 * (resDeg F L : ℤ) ≤ relVal F L x := by
        have hstep1 : d_M ≤ (Module.finrank F L : ℤ) * d_M := by nlinarith
        have hstep2 : (Module.finrank F L : ℤ) * d_M ≤ (Module.finrank F L : ℤ) * relVal F M y := by
          nlinarith
        have hstep3 : max d_L 1 * (resDeg F L : ℤ) * (Module.finrank F M : ℤ) ≤ d_M := by
          dsimp [d_M]
          nlinarith
        nlinarith
      have hx_val_ge : d_L ≤ valL F L x := by
        have hmax_le : max d_L 1 ≤ valL F L x :=
          (Int.le_ediv_iff_mul_le hfL_pos).mpr hx_rel_ge
        exact le_trans (le_max_left d_L 1) hmax_le
      exact hd_L x hx_val_ge

theorem ld_valL_and_unitGroup_props (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    valL F L 0 = 0 ∧
    valL F L 1 = 0 ∧
    valL F L (-1) = 0 ∧
    (∀ x : L, valL F L (-x) = valL F L x) ∧
    (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
    (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
    (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
    (∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
    (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
    (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
      u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
    (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0) :=
by
  have halg : ∀ z : L,
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F L = (minpoly F z).natDegree * m := by
    clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq L.val L.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  have hrel0 : relVal F L 0 = 0 := by
    unfold relVal
    rw [Algebra.norm_zero, haddVal0]
  have hrel1 : relVal F L 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ hnx hny]
  have hrel_neg1 : relVal F L (-1) = 0 := by
    have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
      hrel_mul (-1) (-1) hne hne
    have h1 : (-1 : L) * (-1 : L) = 1 := by ring
    rw [h1, hrel1] at hsq
    omega
  have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
    intro x
    by_cases hx : x = 0
    · simp [hx]
    · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hneg_eq : (-x : L) = (-1 : L) * x := by ring
      rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
  have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
    intro u
    have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
        relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
      hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
    rw [Units.mul_inv, hrel1] at hmul
    omega
  have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
      relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
    intro u n
    induction n with
    | zero =>
      simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
      relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
      rw [zpow_natCast, hrel_pow]
    | negSucc n =>
      rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
      push_cast
      ring
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : L := algebraMap F L π
  have hx₀_ne : x₀ ≠ 0 := by
    simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
  have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
  let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
  have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
  obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
  let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
  have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
  have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
  have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
    intro x
    by_cases hx : x = 0
    · unfold valL
      rw [hx, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F L : ℤ)
      set q : ℤ := valL F L x
      set r : ℤ := relVal F L x % f
      have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
      have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
      have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
      have hr_zero : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
        let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
        have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
        have hrel_y : relVal F L y = r := by
          dsimp [y]
          rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
          linarith
        let k : ℕ := r.toNat
        have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F L := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  have hval0 : valL F L 0 = 0 := by
    have h := hdiv 0
    rw [hrel0] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hval1 : valL F L 1 = 0 := by
    have h := hdiv 1
    rw [hrel1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hval_neg1 : valL F L (-1) = 0 := by
    have h := hdiv (-1)
    rw [hrel_neg1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
    intro x
    apply mul_left_cancel₀ hfL_int_ne
    rw [← hdiv (-x), ← hdiv x, hrel_neg]
  have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
  have hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L) := by
    intro u
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
  have hval_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m := by
    intro m
    refine ⟨ϖL ^ m, ?_⟩
    apply mul_left_cancel₀ hfL_int_ne
    rw [← hdiv, hrel_zpow ϖL m, hrel_ϖL, mul_comm]
  have hval_add : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
      Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
    have hspec_pow : ∀ z : L,
        (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
          ‖Algebra.norm F z‖ := by
      intro z
      obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
      have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
          ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
        rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
      have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
        rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
        exact_mod_cast minpoly.natDegree_pos hz
      rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
         ← Real.rpow_natCast]
      congr 1
      push_cast
      rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
    have hspec_le : ∀ w z : L, w ≠ 0 →
        spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
          spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
        z ≠ 0 ∧ valL F L z ≤ valL F L w := by
      intro w z hw hle
      have hpow_le :
          (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F L) ≤
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) :=
        pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
      rw [hspec_pow w, hspec_pow z] at hpow_le
      have hv_eq : ∀ a : F, ‖a‖ =
          ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
            (valuation F a) : ℝ) := fun a => rfl
      rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
      have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
        (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
          hpow_le
      have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
      obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
      have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
      refine ⟨hz, ?_⟩
      exact Int.ediv_le_ediv hfL_int_pos hrel_le
    intro k x y hx hy
    by_cases hxy : x + y = 0
    · exact Or.inl hxy
    · right
      have hcoe : ((x + y : L) : AlgebraicClosure F) =
          (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
      have hna := isNonarchimedean_spectralNorm (K := F)
        (x : AlgebraicClosure F) (y : AlgebraicClosure F)
      rw [← hcoe, le_max_iff] at hna
      rcases hna with hle_x | hle_y
      · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
        have hkx : k ≤ valL F L x := hx.resolve_left hx_ne
        exact le_trans hkx hval_x
      · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
        have hky : k ≤ valL F L y := hy.resolve_left hy_ne
        exact le_trans hky hval_y
  have hgen_val0 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
      ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1)) → valL F L (u : L) = 0 := by
    intro a ha u hu
    rcases hu with hu1 | hua
    · rw [hu1, hval1]
    · have h_ge0 : (0 : ℤ) ≤ valL F L (u : L) := by
        have hadd := hval_add 0 ((u : L) - 1) 1 (Or.inr (by omega)) (Or.inr (by rw [hval1]))
        have heq : ((u : L) - 1) + 1 = (u : L) := sub_add_cancel (u : L) 1
        rw [heq] at hadd
        exact hadd.resolve_left (Units.ne_zero u)
      have h_le0 : valL F L (u : L) ≤ 0 := by
        by_contra hlt
        have hge1 : (1 : ℤ) ≤ valL F L (-(u : L)) := by
          rw [hval_neg]
          omega
        have hadd := hval_add 1 ((u : L) - 1) (-(u : L)) (Or.inr (by omega)) (Or.inr hge1)
        have heq : ((u : L) - 1) + (-(u : L)) = -1 := by ring
        rw [heq, hval_neg1] at hadd
        have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have h10 : (1 : ℤ) ≤ 0 := hadd.resolve_left hne
        omega
      omega
  have hunit0 : ∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0 := by
    let H₀ : Subgroup Lˣ := {
      carrier := {u : Lˣ | valL F L (u : L) = 0}
      one_mem' := by
        change valL F L ((1 : Lˣ) : L) = 0
        rw [Units.val_one, hval1]
      mul_mem' := by
        intro u v hu hv
        change valL F L ((u * v : Lˣ) : L) = 0
        rw [Units.val_mul, hval_mul _ _ (Units.ne_zero u) (Units.ne_zero v), hu, hv, add_zero]
      inv_mem' := by
        intro u hu
        change valL F L ((u⁻¹ : Lˣ) : L) = 0
        rw [hval_inv u, hu, neg_zero]
    }
    have hcl_le : unitGroup F L 0 ≤ H₀ := by
      unfold unitGroup
      rw [Subgroup.closure_le]
      intro u hu
      simpa [H₀] using hu
    have hle_cl : H₀ ≤ unitGroup F L 0 := by
      intro u hu
      unfold unitGroup
      apply Subgroup.subset_closure
      simpa [H₀] using hu
    intro u
    exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
  have hunit_ge1 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
      u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1)) := by
    intro a ha
    have ha0 : a ≠ 0 := by omega
    let Ha : Subgroup Lˣ := {
      carrier := {u : Lˣ | (u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1)}
      one_mem' := Or.inl Units.val_one
      mul_mem' := by
        intro u v hu hv
        change ((u * v : Lˣ) : L) = 1 ∨ (a : ℤ) ≤ valL F L (((u * v : Lˣ) : L) - 1)
        have hu0 : valL F L (u : L) = 0 := hgen_val0 a ha u hu
        have hterm1 : (u : L) * ((v : L) - 1) = 0 ∨
            (a : ℤ) ≤ valL F L ((u : L) * ((v : L) - 1)) := by
          by_cases hsub : (v : L) - 1 = 0
          · left
            rw [hsub, mul_zero]
          · right
            have hv1 : (v : L) ≠ 1 := sub_ne_zero.mp hsub
            have hva : (a : ℤ) ≤ valL F L ((v : L) - 1) := hv.resolve_left hv1
            rw [hval_mul (u : L) ((v : L) - 1) (Units.ne_zero u) hsub, hu0, zero_add]
            exact hva
        have hterm2 : (u : L) - 1 = 0 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1) := by
          rcases hu with hu1 | hua
          · exact Or.inl (sub_eq_zero.mpr hu1)
          · exact Or.inr hua
        have hadd := hval_add (a : ℤ) ((u : L) * ((v : L) - 1)) ((u : L) - 1) hterm1 hterm2
        have hsplit : (u : L) * ((v : L) - 1) + ((u : L) - 1) = ((u * v : Lˣ) : L) - 1 := by
          rw [Units.val_mul]
          ring
        rw [hsplit] at hadd
        rcases hadd with h0 | hle
        · exact Or.inl (sub_eq_zero.mp h0)
        · exact Or.inr hle
      inv_mem' := by
        intro u hu
        change ((u⁻¹ : Lˣ) : L) = 1 ∨ (a : ℤ) ≤ valL F L (((u⁻¹ : Lˣ) : L) - 1)
        have hu0 : valL F L (u : L) = 0 := hgen_val0 a ha u hu
        have hu_inv0 : valL F L ((u⁻¹ : Lˣ) : L) = 0 := by
          rw [hval_inv u, hu0, neg_zero]
        have hinv_split : (((u⁻¹ : Lˣ) : L) - 1) = - (((u⁻¹ : Lˣ) : L) * ((u : L) - 1)) := by
          have hmul : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := Units.inv_mul u
          linear_combination hmul
        by_cases hsub : (u : L) - 1 = 0
        · left
          apply sub_eq_zero.mp
          rw [hinv_split, hsub, mul_zero, neg_zero]
        · right
          have hu1 : (u : L) ≠ 1 := sub_ne_zero.mp hsub
          have hua : (a : ℤ) ≤ valL F L ((u : L) - 1) := hu.resolve_left hu1
          rw [hinv_split, hval_neg,
            hval_mul ((u⁻¹ : Lˣ) : L) ((u : L) - 1) (Units.ne_zero u⁻¹) hsub,
            hu_inv0, zero_add]
          exact hua
    }
    have hcl_le : unitGroup F L a ≤ Ha := by
      unfold unitGroup
      rw [Subgroup.closure_le]
      intro u hu
      simpa [Ha, ha0] using hu
    have hle_cl : Ha ≤ unitGroup F L a := by
      intro u hu
      unfold unitGroup
      apply Subgroup.subset_closure
      simpa [Ha, ha0] using hu
    intro u
    exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
  have hunit_val0 : ∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0 := by
    intro a u hu
    by_cases ha : a = 0
    · rw [ha] at hu
      exact (hunit0 u).mp hu
    · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
      exact hgen_val0 a ha1 u ((hunit_ge1 a ha1 u).mp hu)
  exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
    hval_add, hunit0, hunit_ge1, hunit_val0⟩

theorem ld_condExp_and_condExpChar_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χ' : Lˣ →* (Ω F)ˣ) :
    (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
    (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
    (condExp F L χ' ≠ 0 →
      (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
      (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1)) ∧
    valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ :=
by
  set Sψ : Set ℤ := {d : ℤ | ∀ x : L, -d ≤ valL F L x → ψ x = 1}
  have hne_ψ : Sψ.Nonempty := by
    obtain ⟨d₀, hd₀⟩ := hψ.2
    refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
    simpa using hx
  have hbdd_ψ : BddAbove Sψ := by
    have hne1 : ∃ x₀ : L, ψ x₀ ≠ 1 := by
      rcases DFunLike.ne_iff.mp hψ.1 with ⟨x₀, hx₀⟩
      exact ⟨x₀, by simpa [AddChar.one_apply] using hx₀⟩
    obtain ⟨x₀, hx₀⟩ := hne1
    refine ⟨-valL F L x₀ - 1, fun d hd => ?_⟩
    by_contra hlt
    have hle : -d ≤ valL F L x₀ := by omega
    exact hx₀ (hd x₀ hle)
  have hmem_ψ : condExpChar F L ψ ∈ Sψ := Int.csSup_mem hne_ψ hbdd_ψ
  have hconj1 : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1 := by
    intro x hx
    rcases hx with rfl | hx
    · exact AddChar.map_zero_eq_one ψ
    · exact hmem_ψ x hx
  have hconj2 : ∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1 := by
    have hnot : condExpChar F L ψ + 1 ∉ Sψ :=
      notMem_of_csSup_lt (lt_add_one (condExpChar F L ψ)) hbdd_ψ
    change ¬ (∀ x : L, -(condExpChar F L ψ + 1) ≤ valL F L x → ψ x = 1) at hnot
    push_neg at hnot
    obtain ⟨x₁, hx₁_val, hx₁_ne1⟩ := hnot
    refine ⟨x₁, ?_, hx₁_val, hx₁_ne1⟩
    rintro rfl
    exact hx₁_ne1 (AddChar.map_zero_eq_one ψ)
  have hconj3 : condExp F L χ' ≠ 0 →
      (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
      (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1) := by
    intro ha
    set Sχ : Set ℕ := {a : ℕ | ∀ u ∈ unitGroup F L a, χ' u = 1}
    have hne_χ : Sχ.Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro hemp
      apply ha
      change sInf Sχ = 0
      exact Nat.sInf_eq_zero.mpr (Or.inr hemp)
    have hmem_χ : condExp F L χ' ∈ Sχ := Nat.sInf_mem hne_χ
    have hnot_χ : condExp F L χ' - 1 ∉ Sχ := by
      have hlt : condExp F L χ' - 1 < sInf Sχ := by
        change condExp F L χ' - 1 < condExp F L χ'
        omega
      exact notMem_of_lt_csInf hlt (OrderBot.bddBelow Sχ)
    change ¬ (∀ u ∈ unitGroup F L (condExp F L χ' - 1), χ' u = 1) at hnot_χ
    push_neg at hnot_χ
    exact ⟨hmem_χ, hnot_χ⟩
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have haddVal_zpow : ∀ (a : F), a ≠ 0 → ∀ (m : ℤ), addVal F (a ^ m) = m * addVal F a := by
    intro a ha m
    have ham : a ^ m ≠ 0 := zpow_ne_zero m ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero φ).mpr ((Valuation.ne_zero_iff _).mpr ha)
    unfold addVal
    rw [dif_neg ham, dif_neg ha]
    have hunz : ∀ (h1 : φ (valuation F (a ^ m)) ≠ 0) (h2 : φ (valuation F a) ≠ 0),
        WithZero.unzero h1 = (WithZero.unzero h2) ^ m := by
      intro h1 h2
      rw [← WithZero.coe_inj, WithZero.coe_zpow, WithZero.coe_unzero, WithZero.coe_unzero,
        ← map_zpow₀ φ, ← map_zpow₀ (valuation F)]
    rw [hunz _ hφa, toAdd_zpow]
    ring
  obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective
    (φ.symm ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)))
  have hφπ : φ (valuation F π) =
      ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
    rw [hπ_val, φ.apply_symm_apply]
  have hπ_ne : π ≠ 0 := by
    intro h0
    rw [h0, map_zero, map_zero] at hφπ
    exact WithZero.coe_ne_zero hφπ.symm
  have haddVal_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz_π : ∀ (h1 : φ (valuation F π) ≠ 0),
        WithZero.unzero h1 = Multiplicative.ofAdd (-1 : ℤ) := by
      intro h1
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz_π, toAdd_ofAdd, neg_neg]
  have hne_deg : {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = (k : ℤ)}.Nonempty := by
    refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L π, ?_, ?_⟩
    · exact (map_ne_zero (algebraMap F L)).mpr hπ_ne
    · unfold relVal
      rw [Algebra.norm_algebraMap, ← zpow_natCast, haddVal_zpow π hπ_ne (Module.finrank F L : ℤ),
        haddVal_π, mul_one]
  have hmem_deg : resDeg F L ∈ {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = (k : ℤ)} :=
    Nat.sInf_mem hne_deg
  obtain ⟨hres_pos, ϖ₀, hϖ₀_ne, hϖ₀_val⟩ := hmem_deg
  set m : ℤ := (condExp F L χ' : ℤ) + condExpChar F L ψ
  set ϖ : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
  set c₀ : Lˣ := ϖ ^ m
  have hc₀_norm : Algebra.norm F (c₀ : L) = (Algebra.norm F ϖ₀) ^ m := by
    let N_hom : Lˣ →* F := (Units.coeHom F).comp (Units.map (Algebra.norm F : L →* F))
    change N_hom (ϖ ^ m) = (N_hom ϖ) ^ m
    exact map_zpow N_hom ϖ m
  have hϖ₀_norm_ne : Algebra.norm F ϖ₀ ≠ 0 := Algebra.norm_ne_zero_iff.mpr hϖ₀_ne
  have hc₀_relVal : relVal F L (c₀ : L) = m * (resDeg F L : ℤ) := by
    unfold relVal
    rw [hc₀_norm, haddVal_zpow (Algebra.norm F ϖ₀) hϖ₀_norm_ne m]
    change m * relVal F L ϖ₀ = m * (resDeg F L : ℤ)
    rw [hϖ₀_val]
  have hc₀_valL : valL F L (c₀ : L) = m := by
    unfold valL
    rw [hc₀_relVal, Int.mul_ediv_cancel _ (Nat.cast_ne_zero.mpr hres_pos.ne')]
  have hconj4 : valL F L ((tateElt F L χ' ψ : Lˣ) : L) = m :=
    Classical.epsilon_spec (p := fun c : Lˣ => valL F L (c : L) = m) ⟨c₀, hc₀_valL⟩
  exact ⟨hconj1, hconj2, hconj3, hconj4⟩

theorem ld_addVal_finset_and_algebraMap_valL (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    addVal F 1 = 0 ∧
    (∀ a : F, addVal F (-a) = addVal F a) ∧
    (∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b) ∧
    (∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a) ∧
    (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 0 ≤ valL F L (algebraMap F L a))) ∧
    (∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a))) ∧
    ∃ R_F : Finset F,
      (∀ r ∈ R_F, r = 0 ∨ 0 ≤ addVal F r) ∧
      (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        ∃ r ∈ R_F, a - r = 0 ∨ 1 ≤ addVal F (a - r)) :=
by
  set φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have haddVal1 : addVal F 1 = 0 := by
    unfold addVal
    rw [dif_neg one_ne_zero]
    have hφ1 : φ (valuation F 1) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr one_ne_zero)
    have hunz1 : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz1, toAdd_one, neg_zero]
  have haddVal_neg : ∀ a : F, addVal F (-a) = addVal F a := by
    intro a
    by_cases ha : a = 0
    · simp [ha]
    · have hna : -a ≠ 0 := neg_ne_zero.mpr ha
      unfold addVal
      simp [ha, hna, Valuation.map_neg]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hφa : φ (valuation F a) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    have hφb : φ (valuation F b) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hb)
    have hφab : φ (valuation F (a * b)) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hab)
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_inv : ∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a := by
    intro a ha
    have hainv : a⁻¹ ≠ 0 := inv_ne_zero ha
    have hmul := haddVal_mul a a⁻¹ ha hainv
    rw [mul_inv_cancel₀ ha, haddVal1] at hmul
    omega
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hφa : φ (valuation F a) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    have hφan : φ (valuation F (a ^ n)) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr han)
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := fun h0 => hφπ_ne (by simp [h0])
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : L := algebraMap F L π
  have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
  set S_deg : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
  have hmem_deg : Module.finrank F L ∈ S_deg :=
    ⟨Module.finrank_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfL_pos : 0 < resDeg F L := (Nat.sInf_mem ⟨Module.finrank F L, hmem_deg⟩).1
  have hfL_le : resDeg F L ≤ Module.finrank F L := Nat.sInf_le hmem_deg
  have hvalL_alg : ∀ a : F, a ≠ 0 →
      valL F L (algebraMap F L a) =
        ((Module.finrank F L : ℤ) * addVal F a) / (resDeg F L : ℤ) := by
    intro a ha
    unfold valL relVal
    rw [Algebra.norm_algebraMap, haddVal_pow a (Module.finrank F L) ha]
  have halg0 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 0 ≤ valL F L (algebraMap F L a)) := by
    intro a ha_opt
    by_cases ha : a = 0
    · left; simp [ha]
    · right
      have ha0 : 0 ≤ addVal F a := ha_opt.resolve_left ha
      rw [hvalL_alg a ha]
      exact Int.ediv_nonneg (mul_nonneg (Nat.cast_nonneg _) ha0) (Nat.cast_nonneg _)
  have halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)) := by
    intro a ha_opt
    by_cases ha : a = 0
    · left; simp [ha]
    · right
      have ha1 : 1 ≤ addVal F a := ha_opt.resolve_left ha
      rw [hvalL_alg a ha]
      have hfL_posZ : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
      have hfL_leZ : (resDeg F L : ℤ) ≤ (Module.finrank F L : ℤ) := Nat.cast_le.mpr hfL_le
      exact Int.le_ediv_of_mul_le hfL_posZ (by nlinarith)
  have hmem_O : ∀ a : F, a ∈ 𝒪[F] ↔ (a = 0 ∨ 0 ≤ addVal F a) := by
    intro a
    by_cases ha : a = 0
    · simp [ha]
    · have hφa : φ (valuation F a) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      have hle_iff : valuation F a ≤ 1 ↔ 0 ≤ addVal F a := by
        rw [← map_le_map_iff φ, map_one, ← WithZero.coe_unzero hφa, ← WithZero.coe_one,
          WithZero.coe_le_coe, ← Multiplicative.toAdd_le, toAdd_one]
        unfold addVal
        rw [dif_neg ha]
        omega
      rw [Valuation.mem_integer_iff, hle_iff]
      simp [ha]
  have hres_zero : ∀ x : 𝒪[F],
      IsLocalRing.residue 𝒪[F] x = 0 ↔ ((x : F) = 0 ∨ 1 ≤ addVal F (x : F)) := by
    intro x
    have hker : IsLocalRing.residue 𝒪[F] x = 0 ↔ valuation F (x : F) < 1 := by
      rw [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one]
    by_cases hx : (x : F) = 0
    · rw [hker]
      simp [hx, zero_lt_one]
    · have hφx : φ (valuation F (x : F)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hx)
      have hlt_iff : valuation F (x : F) < 1 ↔ 1 ≤ addVal F (x : F) := by
        rw [← map_lt_map_iff φ, map_one, ← WithZero.coe_unzero hφx, ← WithZero.coe_one,
          WithZero.coe_lt_coe, ← Multiplicative.toAdd_lt, toAdd_one]
        unfold addVal
        rw [dif_neg hx]
        omega
      rw [hker, hlt_iff]
      simp [hx]
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  let s : 𝓀[F] → 𝒪[F] := Function.surjInv (IsLocalRing.residue_surjective (R := 𝒪[F]))
  have hs_eq : ∀ c : 𝓀[F], IsLocalRing.residue 𝒪[F] (s c) = c :=
    Function.surjInv_eq (IsLocalRing.residue_surjective (R := 𝒪[F]))
  let R_F : Finset F := Finset.univ.image (fun c : 𝓀[F] => ((s c : 𝒪[F]) : F))
  have hRF_0 : ∀ r ∈ R_F, r = 0 ∨ 0 ≤ addVal F r := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨c, _, rfl⟩
    exact (hmem_O ((s c : 𝒪[F]) : F)).mp (s c).2
  have hRF_mod1 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
      ∃ r ∈ R_F, a - r = 0 ∨ 1 ≤ addVal F (a - r) := by
    intro a ha_opt
    have ha_mem : a ∈ 𝒪[F] := (hmem_O a).mpr ha_opt
    let x : 𝒪[F] := ⟨a, ha_mem⟩
    let c : 𝓀[F] := IsLocalRing.residue 𝒪[F] x
    refine ⟨((s c : 𝒪[F]) : F), Finset.mem_image.mpr ⟨c, Finset.mem_univ c, rfl⟩, ?_⟩
    have hres_diff : IsLocalRing.residue 𝒪[F] (x - s c) = 0 := by
      rw [map_sub, hs_eq c, sub_self]
    have hdiff := (hres_zero (x - s c)).mp hres_diff
    simpa [x] using hdiff
  exact ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩

theorem ld_valL_mod_one_finset (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (hval0 : valL F L 0 = 0)
    (hval_neg : ∀ x : L, valL F L (-x) = valL F L x)
    (hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y)
    (hval_add : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x + y = 0 ∨ k ≤ valL F L (x + y)))
    (haddVal1 : addVal F 1 = 0)
    (haddVal_neg : ∀ a : F, addVal F (-a) = addVal F a)
    (haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b)
    (haddVal_inv : ∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a)
    (halg0 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 0 ≤ valL F L (algebraMap F L a)))
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (R_F : Finset F)
    (hRF_0 : ∀ r ∈ R_F, r = 0 ∨ 0 ≤ addVal F r)
    (hRF_mod1 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
      ∃ r ∈ R_F, a - r = 0 ∨ 1 ≤ addVal F (a - r)) :
    ∃ S₁ : Finset L,
      ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ∃ s ∈ S₁, x - s = 0 ∨ (1 : ℤ) ≤ valL F L (x - s) :=
by
  have hP_neg : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    rintro k x (rfl | hx)
    · exact Or.inl neg_zero
    · right
      rw [hval_neg]
      exact hx
  have hP_sub : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add k x (-y) hx (hP_neg k y hy)
  have hP_sum : ∀ (k : ℤ) {m : ℕ} (A : Finset (Fin m)) (f : Fin m → L),
      (∀ i ∈ A, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ A, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ A, f i)) := by
    intro k m A f
    induction A using Finset.induction_on with
    | empty =>
      intro _
      exact Or.inl Finset.sum_empty
    | @insert j s hj ih =>
      intro hf
      rw [Finset.sum_insert hj]
      exact hval_add k (f j) (∑ i ∈ s, f i)
        (hf j (Finset.mem_insert_self j s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have hP_smul1 : ∀ (a : F) (x : L),
      (a = 0 ∨ 1 ≤ addVal F a) → (x = 0 ∨ 0 ≤ valL F L x) →
        (a • x = 0 ∨ (1 : ℤ) ≤ valL F L (a • x)) := by
    intro a x ha hx
    rw [Algebra.smul_def]
    by_cases ha0 : algebraMap F L a = 0
    · left
      rw [ha0, zero_mul]
    · by_cases hx0 : x = 0
      · left
        rw [hx0, mul_zero]
      · right
        have ha_ge : (1 : ℤ) ≤ valL F L (algebraMap F L a) := (halg1 a ha).resolve_left ha0
        have hx_ge : 0 ≤ valL F L x := hx.resolve_left hx0
        rw [hval_mul _ _ ha0 hx0]
        omega
  have hP_smul01 : ∀ (a : F) (x : L),
      (a = 0 ∨ 0 ≤ addVal F a) → (x = 0 ∨ (1 : ℤ) ≤ valL F L x) →
        (a • x = 0 ∨ (1 : ℤ) ≤ valL F L (a • x)) := by
    intro a x ha hx
    rw [Algebra.smul_def]
    by_cases ha0 : algebraMap F L a = 0
    · left
      rw [ha0, zero_mul]
    · by_cases hx0 : x = 0
      · left
        rw [hx0, mul_zero]
      · right
        have ha_ge : 0 ≤ valL F L (algebraMap F L a) := (halg0 a ha).resolve_left ha0
        have hx_ge : (1 : ℤ) ≤ valL F L x := hx.resolve_left hx0
        rw [hval_mul _ _ ha0 hx0]
        omega
  by_contra h_no_S₁
  have h_avoid : ∀ S₁ : Finset L, ∃ x : L,
      (x = 0 ∨ 0 ≤ valL F L x) ∧
      ∀ s ∈ S₁, ¬ (x - s = 0 ∨ (1 : ℤ) ≤ valL F L (x - s)) := by
    intro S₁
    by_contra h_all
    apply h_no_S₁
    refine ⟨S₁, fun x hx => ?_⟩
    by_contra h_none
    exact h_all ⟨x, hx, fun s hs hxs => h_none ⟨s, hs, hxs⟩⟩
  have h_seq : ∀ m : ℕ, ∃ v : Fin m → L,
      (∀ i : Fin m, v i = 0 ∨ 0 ≤ valL F L (v i)) ∧
      (∀ c : Fin m → F,
        (∀ i : Fin m, c i = 0 ∨ 0 ≤ addVal F (c i)) →
        ((∑ i : Fin m, c i • v i) = 0 ∨ (1 : ℤ) ≤ valL F L (∑ i : Fin m, c i • v i)) →
        ∀ i : Fin m, c i = 0 ∨ 1 ≤ addVal F (c i)) := by
    intro m
    induction m with
    | zero =>
      exact ⟨Fin.elim0, fun i => Fin.elim0 i, fun _ _ _ i => Fin.elim0 i⟩
    | succ m ih =>
      rcases ih with ⟨v, hv0, hv_ind⟩
      let S_m : Finset L :=
        (Fintype.piFinset (fun _ : Fin m => R_F)).image
          (fun r : Fin m → F => ∑ i : Fin m, r i • v i)
      obtain ⟨v₀, hv₀_0, hv₀_not⟩ := h_avoid S_m
      refine ⟨Fin.cons v₀ v, ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ ?_ i
        · rw [Fin.cons_zero]
          exact hv₀_0
        · intro j
          rw [Fin.cons_succ]
          exact hv0 j
      · intro c hc0 hsum
        have hsum' : (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) = 0 ∨
            (1 : ℤ) ≤ valL F L (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) := by
          simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ] at hsum
          exact hsum
        have hc0_1 : c 0 = 0 ∨ 1 ≤ addVal F (c 0) := by
          by_contra hc0_not1
          have hc0_ne : c 0 ≠ 0 := fun h0 => hc0_not1 (Or.inl h0)
          have hc0_lt1 : ¬ (1 ≤ addVal F (c 0)) := fun h1 => hc0_not1 (Or.inr h1)
          have hc0_ge0 : 0 ≤ addVal F (c 0) := (hc0 0).resolve_left hc0_ne
          have hc0_val : addVal F (c 0) = 0 := by omega
          have hc0_inv_ne : (c 0)⁻¹ ≠ 0 := inv_ne_zero hc0_ne
          have hc0_inv_val : addVal F (c 0)⁻¹ = 0 := by
            rw [haddVal_inv (c 0) hc0_ne, hc0_val, neg_zero]
          have hc0_inv_0 : (c 0)⁻¹ = 0 ∨ 0 ≤ addVal F (c 0)⁻¹ := Or.inr (by omega)
          let a : Fin m → F := fun i => - ((c 0)⁻¹ * c i.succ)
          have ha0 : ∀ i : Fin m, a i = 0 ∨ 0 ≤ addVal F (a i) := by
            intro i
            by_cases hci : c i.succ = 0
            · left
              dsimp [a]
              rw [hci, mul_zero, neg_zero]
            · right
              dsimp [a]
              rw [haddVal_neg, haddVal_mul _ _ hc0_inv_ne hci, hc0_inv_val, zero_add]
              exact (hc0 i.succ).resolve_left hci
          let r : Fin m → F := fun i => (hRF_mod1 (a i) (ha0 i)).choose
          have hr_mem : ∀ i : Fin m, r i ∈ R_F :=
            fun i => (hRF_mod1 (a i) (ha0 i)).choose_spec.1
          have hr_mod : ∀ i : Fin m, a i - r i = 0 ∨ 1 ≤ addVal F (a i - r i) :=
            fun i => (hRF_mod1 (a i) (ha0 i)).choose_spec.2
          let s : L := ∑ i : Fin m, r i • v i
          have hs_mem : s ∈ S_m :=
            Finset.mem_image.mpr ⟨r, Fintype.mem_piFinset.mpr hr_mem, rfl⟩
          have hid : v₀ - s =
              (c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) +
                ∑ i : Fin m, (a i - r i) • v i := by
            have h1 : (c 0)⁻¹ • (c 0 • v₀) = v₀ := by
              rw [smul_smul, inv_mul_cancel₀ hc0_ne, one_smul]
            have h2 : ∀ i : Fin m,
                (c 0)⁻¹ • (c i.succ • v i) + (a i - r i) • v i =
                  -(r i • v i) := by
              intro i
              dsimp [a]
              rw [smul_smul, sub_smul, neg_smul]
              abel
            dsimp [s]
            rw [smul_add, h1, Finset.smul_sum, add_assoc, ← Finset.sum_add_distrib,
              Finset.sum_congr rfl fun i _ => h2 i, Finset.sum_neg_distrib, sub_eq_add_neg]
          have hterm1 : (c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) = 0 ∨
              (1 : ℤ) ≤ valL F L ((c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i)) :=
            hP_smul01 (c 0)⁻¹ _ hc0_inv_0 hsum'
          have hterm2 : (∑ i : Fin m, (a i - r i) • v i) = 0 ∨
              (1 : ℤ) ≤ valL F L (∑ i : Fin m, (a i - r i) • v i) :=
            hP_sum 1 Finset.univ (fun i => (a i - r i) • v i)
              (fun i _ => hP_smul1 (a i - r i) (v i) (hr_mod i) (hv0 i))
          have hv₀_s : v₀ - s = 0 ∨ (1 : ℤ) ≤ valL F L (v₀ - s) := by
            rw [hid]
            exact hval_add 1 _ _ hterm1 hterm2
          exact hv₀_not s hs_mem hv₀_s
        have hc0_v0 : c 0 • v₀ = 0 ∨ (1 : ℤ) ≤ valL F L (c 0 • v₀) :=
          hP_smul1 (c 0) v₀ hc0_1 hv₀_0
        have hsum_tail : (∑ i : Fin m, c i.succ • v i) = 0 ∨
            (1 : ℤ) ≤ valL F L (∑ i : Fin m, c i.succ • v i) := by
          have hsub := hP_sub 1 (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) (c 0 • v₀) hsum' hc0_v0
          rwa [add_sub_cancel_left] at hsub
        have hc_succ : ∀ i : Fin m, c i.succ = 0 ∨ 1 ≤ addVal F (c i.succ) :=
          hv_ind (fun i => c i.succ) (fun i => hc0 i.succ) hsum_tail
        intro i
        exact Fin.cases hc0_1 hc_succ i
  let m : ℕ := Module.finrank F L + 1
  obtain ⟨v, _, hv_ind⟩ := h_seq m
  have hli : LinearIndependent F v := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i₀
    by_contra hgi₀
    let A : Finset (Fin m) := Finset.univ.filter (fun i => g i ≠ 0)
    have hi₀ : i₀ ∈ A := Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hgi₀⟩
    obtain ⟨i_star, hi_star_mem, hi_star_min⟩ :=
      Finset.exists_min_image A (fun i => addVal F (g i)) ⟨i₀, hi₀⟩
    have hgi_star : g i_star ≠ 0 := (Finset.mem_filter.mp hi_star_mem).2
    let c : Fin m → F := fun i => (g i_star)⁻¹ * g i
    have hc0 : ∀ i : Fin m, c i = 0 ∨ 0 ≤ addVal F (c i) := by
      intro i
      by_cases hgi : g i = 0
      · left
        dsimp [c]
        rw [hgi, mul_zero]
      · right
        have hi_mem : i ∈ A := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hgi⟩
        have hle : addVal F (g i_star) ≤ addVal F (g i) := hi_star_min i hi_mem
        dsimp [c]
        rw [haddVal_mul _ _ (inv_ne_zero hgi_star) hgi, haddVal_inv _ hgi_star]
        omega
    have hsum_c : (∑ i : Fin m, c i • v i) = 0 := by
      calc (∑ i : Fin m, c i • v i)
        _ = ∑ i : Fin m, (g i_star)⁻¹ • (g i • v i) :=
            Finset.sum_congr rfl (fun i _ => by dsimp [c]; rw [smul_smul])
        _ = (g i_star)⁻¹ • ∑ i : Fin m, g i • v i := (Finset.smul_sum).symm
        _ = 0 := by rw [hg, smul_zero]
    have hc_star : c i_star = 0 ∨ 1 ≤ addVal F (c i_star) :=
      hv_ind c hc0 (Or.inl hsum_c) i_star
    have hc_star_eq : c i_star = 1 := inv_mul_cancel₀ hgi_star
    rw [hc_star_eq, haddVal1] at hc_star
    rcases hc_star with h10 | h1le0
    · exact one_ne_zero h10
    · omega
  have hcard := LinearIndependent.fintype_card_le_finrank hli
  rw [Fintype.card_fin] at hcard
  omega

theorem ld_valL_mod_pow_finset (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y)
    (hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L))
    (hval_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m)
    (S₁ : Finset L)
    (hS₁ : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s ∈ S₁, x - s = 0 ∨ (1 : ℤ) ≤ valL F L (x - s))
    (a : ℕ) :
    ∃ S_a : Finset L,
      ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ∃ s ∈ S_a, x - s = 0 ∨ (a : ℤ) ≤ valL F L (x - s) :=
by
  induction a with
  | zero =>
    refine ⟨{0}, fun x hx => ⟨0, Finset.mem_singleton_self 0, ?_⟩⟩
    simpa using hx
  | succ k ih =>
    classical
    obtain ⟨S_k, hS_k⟩ := ih
    obtain ⟨c_k, hc_k⟩ := hval_surj (k : ℤ)
    let S_next : Finset L := (S_k ×ˢ S₁).image (fun p : L × L => p.1 + (c_k : L) * p.2)
    refine ⟨S_next, fun x hx => ?_⟩
    obtain ⟨s₀, hs₀_mem, hs₀⟩ := hS_k x hx
    set y : L := ((c_k⁻¹ : Lˣ) : L) * (x - s₀)
    have hy : y = 0 ∨ 0 ≤ valL F L y := by
      by_cases hsub0 : x - s₀ = 0
      · left
        simp [y, hsub0]
      · right
        have hk_le : (k : ℤ) ≤ valL F L (x - s₀) := hs₀.resolve_left hsub0
        have hval_y : valL F L y = -(k : ℤ) + valL F L (x - s₀) := by
          rw [show y = ((c_k⁻¹ : Lˣ) : L) * (x - s₀) from rfl,
            hval_mul ((c_k⁻¹ : Lˣ) : L) (x - s₀) (Units.ne_zero _) hsub0,
            hval_inv c_k, hc_k]
        omega
    obtain ⟨s₁, hs₁_mem, hs₁⟩ := hS₁ y hy
    refine ⟨s₀ + (c_k : L) * s₁, ?_, ?_⟩
    · exact Finset.mem_image.mpr ⟨(s₀, s₁), Finset.mem_product.mpr ⟨hs₀_mem, hs₁_mem⟩, rfl⟩
    · have hc_mul_inv : (c_k : L) * ((c_k⁻¹ : Lˣ) : L) = 1 := by
        exact_mod_cast Units.mul_inv c_k
      have hcy : (c_k : L) * y = x - s₀ := by
        calc (c_k : L) * (((c_k⁻¹ : Lˣ) : L) * (x - s₀))
          _ = ((c_k : L) * ((c_k⁻¹ : Lˣ) : L)) * (x - s₀) := by ring
          _ = 1 * (x - s₀) := by rw [hc_mul_inv]
          _ = x - s₀ := one_mul (x - s₀)
      have hxs_eq : x - (s₀ + (c_k : L) * s₁) = (c_k : L) * (y - s₁) := by
        linear_combination -hcy
      by_cases hys1 : y - s₁ = 0
      · left
        rw [hxs_eq, hys1, mul_zero]
      · right
        have h1_le : (1 : ℤ) ≤ valL F L (y - s₁) := hs₁.resolve_left hys1
        have hval_xs : valL F L (x - (s₀ + (c_k : L) * s₁)) =
            (k : ℤ) + valL F L (y - s₁) := by
          rw [hxs_eq, hval_mul (c_k : L) (y - s₁) (Units.ne_zero c_k) hys1, hc_k]
        omega

theorem ld_unitCoset_finite (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (a : ℕ) (ha : 1 ≤ a) :
    Set.Finite {u : Lˣ ⧸ unitGroup F L a | valL F L ((cosetRep u : Lˣ) : L) = 0} :=
by
  obtain ⟨hval0, _, _, hval_neg, hval_mul, hval_inv, hval_surj, hval_add, _, hunit_ge1, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L hval0 hval_neg hval_mul hval_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨S_a, hS_a⟩ := ld_valL_mod_pow_finset F L hval_mul hval_inv hval_surj S₁ hS₁ a
  set U_a : Set (Lˣ ⧸ unitGroup F L a) :=
    {u : Lˣ ⧸ unitGroup F L a | valL F L ((cosetRep u : Lˣ) : L) = 0}
  have hex : ∀ u : U_a, ∃ s ∈ S_a,
      ((cosetRep u.1 : Lˣ) : L) - s = 0 ∨
        (a : ℤ) ≤ valL F L (((cosetRep u.1 : Lˣ) : L) - s) := by
    intro u
    apply hS_a ((cosetRep u.1 : Lˣ) : L)
    right
    rw [u.2]
  let f : U_a → S_a := fun u => ⟨(hex u).choose, (hex u).choose_spec.1⟩
  have hf_spec : ∀ u : U_a,
      ((cosetRep u.1 : Lˣ) : L) - (f u : L) = 0 ∨
        (a : ℤ) ≤ valL F L (((cosetRep u.1 : Lˣ) : L) - (f u : L)) :=
    fun u => (hex u).choose_spec.2
  have hf_inj : Function.Injective f := by
    intro u₁ u₂ hfeq
    have hs_eq : ((f u₁ : S_a) : L) = ((f u₂ : S_a) : L) := congrArg Subtype.val hfeq
    set s : L := (f u₁ : L)
    set r₁ : Lˣ := cosetRep u₁.1
    set r₂ : Lˣ := cosetRep u₂.1
    have h₁ : (r₁ : L) - s = 0 ∨ (a : ℤ) ≤ valL F L ((r₁ : L) - s) := hf_spec u₁
    have h₂ : (r₂ : L) - s = 0 ∨ (a : ℤ) ≤ valL F L ((r₂ : L) - s) := by
      simpa [s, r₂, hs_eq] using hf_spec u₂
    have h₂_neg : s - (r₂ : L) = 0 ∨ (a : ℤ) ≤ valL F L (s - (r₂ : L)) := by
      have hneg_eq : -((r₂ : L) - s) = s - (r₂ : L) := by ring
      rcases h₂ with h₂0 | h₂ge
      · left
        rw [← hneg_eq, h₂0, neg_zero]
      · right
        rw [← hneg_eq, hval_neg]
        exact h₂ge
    have hdiff : (r₁ : L) - (r₂ : L) = 0 ∨ (a : ℤ) ≤ valL F L ((r₁ : L) - (r₂ : L)) := by
      have hadd_eq : ((r₁ : L) - s) + (s - (r₂ : L)) = (r₁ : L) - (r₂ : L) := by ring
      simpa [hadd_eq] using hval_add (a : ℤ) ((r₁ : L) - s) (s - (r₂ : L)) h₁ h₂_neg
    set h : Lˣ := r₂⁻¹ * r₁
    have hh_sub : (h : L) - 1 = ((r₂⁻¹ : Lˣ) : L) * ((r₁ : L) - (r₂ : L)) := by
      have hinv_mul : ((r₂⁻¹ : Lˣ) : L) * (r₂ : L) = 1 := by
        exact_mod_cast Units.inv_mul r₂
      calc (h : L) - 1
        _ = ((r₂⁻¹ : Lˣ) : L) * (r₁ : L) - ((r₂⁻¹ : Lˣ) : L) * (r₂ : L) := by
            rw [Units.val_mul, hinv_mul]
        _ = ((r₂⁻¹ : Lˣ) : L) * ((r₁ : L) - (r₂ : L)) := by ring
    have hh_alt : (h : L) = 1 ∨ (a : ℤ) ≤ valL F L ((h : L) - 1) := by
      rcases hdiff with hdiff0 | hdiff_ge
      · left
        have h0 : (h : L) - 1 = 0 := by rw [hh_sub, hdiff0, mul_zero]
        exact sub_eq_zero.mp h0
      · by_cases hdiff0 : (r₁ : L) - (r₂ : L) = 0
        · left
          have h0 : (h : L) - 1 = 0 := by rw [hh_sub, hdiff0, mul_zero]
          exact sub_eq_zero.mp h0
        · right
          rw [hh_sub, hval_mul ((r₂⁻¹ : Lˣ) : L) ((r₁ : L) - (r₂ : L))
            (Units.ne_zero _) hdiff0, hval_inv r₂, u₂.2, neg_zero, zero_add]
          exact hdiff_ge
    have hh_mem : r₂⁻¹ * r₁ ∈ unitGroup F L a := (hunit_ge1 a ha h).mpr hh_alt
    have hmk_eq : QuotientGroup.mk (s := unitGroup F L a) r₂ =
        QuotientGroup.mk (s := unitGroup F L a) r₁ :=
      QuotientGroup.eq.mpr hh_mem
    have hout₁ : QuotientGroup.mk (s := unitGroup F L a) r₁ = u₁.1 :=
      QuotientGroup.out_eq' u₁.1
    have hout₂ : QuotientGroup.mk (s := unitGroup F L a) r₂ = u₂.1 :=
      QuotientGroup.out_eq' u₂.1
    rw [hout₁, hout₂] at hmk_eq
    exact Subtype.ext hmk_eq.symm
  haveI : Finite U_a := Finite.of_injective f hf_inj
  exact Set.finite_coe_iff.mp ‹Finite U_a›

theorem ld_unitCoset_addChar_orthogonality (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (a : ℕ) (ha : 1 ≤ a) (c : Lˣ)
    (hc : valL F L (c : L) = (a : ℤ) + condExpChar F L ψ) :
    ∃ (N_A N_M : ℕ), 0 < N_A ∧
      ∀ (w : Lˣ ⧸ unitGroup F L a),
        valL F L ((cosetRep w : Lˣ) : L) = 0 →
        (∑ᶠ (v : Lˣ ⧸ unitGroup F L a) (_ : valL F L ((cosetRep v : Lˣ) : L) = 0),
          ψ (((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) * ((cosetRep v : Lˣ) : L))) =
          (if w = 1 then (N_A : Ω F) else 0) -
            (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0) :=
by
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, _, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ne1⟩, _, _⟩ :=
    ld_condExp_and_condExpChar_spec F L ψ hψ 1
  have hfin : Set.Finite {u : Lˣ ⧸ unitGroup F L a | valL F L ((cosetRep u : Lˣ) : L) = 0} :=
    ld_unitCoset_finite F L a ha
  set U := hfin.toFinset
  have hmem_U : ∀ v : Lˣ ⧸ unitGroup F L a, v ∈ U ↔ valL F L ((cosetRep v : Lˣ) : L) = 0 := by
    intro v
    simp [U, Set.Finite.mem_toFinset]
  let Pₐ : AddSubgroup L := {
    carrier := {x : L | x = 0 ∨ (a : ℤ) ≤ valL F L x}
    zero_mem' := Or.inl rfl
    add_mem' := fun {x y} hx hy => hval_add (a : ℤ) x y hx hy
    neg_mem' := fun {x} hx => by
      rcases hx with rfl | hx
      · left; exact neg_zero
      · right; rw [hval_neg]; exact hx
  }
  have hPₐ : ∀ x : L, x ∈ Pₐ ↔ (x = 0 ∨ (a : ℤ) ≤ valL F L x) := fun _ => Iff.rfl
  let φ_unit : (Lˣ ⧸ unitGroup F L a) → L ⧸ Pₐ :=
    fun v => QuotientAddGroup.mk ((cosetRep v : Lˣ) : L)
  let φ_shift : (Lˣ ⧸ unitGroup F L a) → L ⧸ Pₐ :=
    fun v => QuotientAddGroup.mk (((cosetRep v : Lˣ) : L) - 1)
  set S_unit : Finset (L ⧸ Pₐ) := U.image φ_unit
  set S_shift : Finset (L ⧸ Pₐ) := U.image φ_shift
  set S_A : Finset (L ⧸ Pₐ) := S_unit ∪ S_shift
  set S_M : Finset (L ⧸ Pₐ) := S_A \ S_unit
  have hunit_perturb : ∀ (r d : L),
      (r ≠ 0 ∧ valL F L r = 0) → (d = 0 ∨ (1 : ℤ) ≤ valL F L d) →
      (r + d ≠ 0 ∧ valL F L (r + d) = 0) := by
    intro r d ⟨hr_ne, hr_val⟩ hd
    have hrd_ne : r + d ≠ 0 := by
      intro hrd0
      have hd_eq : d = -r := eq_neg_of_add_eq_zero_right hrd0
      rcases hd with hd0 | hd1
      · exact hr_ne (neg_eq_zero.mp (hd_eq.symm.trans hd0))
      · rw [hd_eq, hval_neg, hr_val] at hd1
        omega
    have hd0 : d = 0 ∨ (0 : ℤ) ≤ valL F L d := by
      rcases hd with hd0 | hd1
      · exact Or.inl hd0
      · exact Or.inr (by omega)
    have hrd_ge0 : (0 : ℤ) ≤ valL F L (r + d) :=
      (hval_add 0 r d (Or.inr (by omega)) hd0).resolve_left hrd_ne
    have hrd_lt1 : ¬ ((1 : ℤ) ≤ valL F L (r + d)) := by
      intro hrd_ge1
      have hnd : -d = 0 ∨ (1 : ℤ) ≤ valL F L (-d) := by
        rcases hd with hd0 | hd1
        · left; rw [hd0, neg_zero]
        · right; rw [hval_neg]; exact hd1
      have hr_ge1 := hval_add 1 (r + d) (-d) (Or.inr hrd_ge1) hnd
      rw [add_neg_cancel_right] at hr_ge1
      have hr_ge1' : (1 : ℤ) ≤ valL F L r := hr_ge1.resolve_left hr_ne
      omega
    exact ⟨hrd_ne, by omega⟩
  have hS_unit_inj : Set.InjOn φ_unit (U : Set (Lˣ ⧸ unitGroup F L a)) := by
    intro v₁ hv₁ v₂ hv₂ hφ
    rw [Finset.mem_coe, hmem_U] at hv₁ hv₂
    have hdiff_mem : -((cosetRep v₁ : Lˣ) : L) + ((cosetRep v₂ : Lˣ) : L) ∈ Pₐ :=
      QuotientAddGroup.eq.mp hφ
    rw [hPₐ] at hdiff_mem
    set r₁ : Lˣ := cosetRep v₁
    set r₂ : Lˣ := cosetRep v₂
    set d : L := -(r₁ : L) + (r₂ : L)
    set h : Lˣ := r₁⁻¹ * r₂
    have hh_sub : (h : L) - 1 = ((r₁⁻¹ : Lˣ) : L) * d := by
      have hinv_mul : ((r₁⁻¹ : Lˣ) : L) * (r₁ : L) = 1 := by
        exact_mod_cast Units.inv_mul r₁
      calc (h : L) - 1
        _ = ((r₁⁻¹ : Lˣ) : L) * (r₂ : L) - ((r₁⁻¹ : Lˣ) : L) * (r₁ : L) := by
            rw [Units.val_mul, hinv_mul]
        _ = ((r₁⁻¹ : Lˣ) : L) * d := by dsimp [d]; ring
    have hh_alt : (h : L) = 1 ∨ (a : ℤ) ≤ valL F L ((h : L) - 1) := by
      by_cases hd0 : d = 0
      · left
        have h0 : (h : L) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp h0
      · right
        have hda : (a : ℤ) ≤ valL F L d := hdiff_mem.resolve_left hd0
        rw [hh_sub, hval_mul ((r₁⁻¹ : Lˣ) : L) d (Units.ne_zero _) hd0,
          hval_inv r₁, hv₁, neg_zero, zero_add]
        exact hda
    have hh_mem : r₁⁻¹ * r₂ ∈ unitGroup F L a := (hunit_ge1 a ha h).mpr hh_alt
    have hmk_eq : QuotientGroup.mk (s := unitGroup F L a) r₁ =
        QuotientGroup.mk (s := unitGroup F L a) r₂ :=
      QuotientGroup.eq.mpr hh_mem
    have hout₁ : QuotientGroup.mk (s := unitGroup F L a) r₁ = v₁ := QuotientGroup.out_eq' v₁
    have hout₂ : QuotientGroup.mk (s := unitGroup F L a) r₂ = v₂ := QuotientGroup.out_eq' v₂
    rwa [hout₁, hout₂] at hmk_eq
  have hmem_S_unit : ∀ x : L,
      (QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S_unit ↔ (x ≠ 0 ∧ valL F L x = 0) := by
    intro x
    constructor
    · intro hx_mem
      rw [Finset.mem_image] at hx_mem
      rcases hx_mem with ⟨v, hv, hvx⟩
      rw [hmem_U] at hv
      set r : L := ((cosetRep v : Lˣ) : L)
      set d : L := -r + x
      have hd_mem : d ∈ Pₐ := QuotientAddGroup.eq.mp hvx
      rw [hPₐ] at hd_mem
      have hd1 : d = 0 ∨ (1 : ℤ) ≤ valL F L d := by
        rcases hd_mem with hd0 | hda
        · exact Or.inl hd0
        · exact Or.inr (by omega)
      have hpert := hunit_perturb r d ⟨Units.ne_zero _, hv⟩ hd1
      have hrx : r + d = x := add_neg_cancel_left r x
      rwa [hrx] at hpert
    · rintro ⟨hx_ne, hx_val⟩
      let u_x : Lˣ := Units.mk0 x hx_ne
      let v : Lˣ ⧸ unitGroup F L a := QuotientGroup.mk (s := unitGroup F L a) u_x
      set r : Lˣ := cosetRep v
      set h : Lˣ := r⁻¹ * u_x
      have hout : QuotientGroup.mk (s := unitGroup F L a) r = v := QuotientGroup.out_eq' v
      have hh_mem : h ∈ unitGroup F L a := QuotientGroup.eq.mp hout
      have hh_val : valL F L (h : L) = 0 := hunit_val0 a h hh_mem
      have hr_eq : (r : L) * (h : L) = x := by
        have hmul : r * h = u_x := by simp [h]
        simpa [u_x] using congrArg Units.val hmul
      have hr_val : valL F L (r : L) = 0 := by
        have h1 := congrArg (valL F L) hr_eq
        rw [hval_mul (r : L) (h : L) (Units.ne_zero _) (Units.ne_zero _), hh_val, add_zero,
          hx_val] at h1
        exact h1
      have hv_U : v ∈ U := (hmem_U v).mpr hr_val
      rw [Finset.mem_image]
      refine ⟨v, hv_U, ?_⟩
      change (QuotientAddGroup.mk (r : L) : L ⧸ Pₐ) = QuotientAddGroup.mk x
      rw [QuotientAddGroup.eq, hPₐ]
      have hdiff : -(r : L) + x = (r : L) * ((h : L) - 1) := by
        linear_combination -hr_eq
      rw [hdiff]
      rcases (hunit_ge1 a ha h).mp hh_mem with hh1 | hha
      · left
        rw [hh1, sub_self, mul_zero]
      · by_cases hsub0 : (h : L) - 1 = 0
        · left
          rw [hsub0, mul_zero]
        · right
          rw [hval_mul (r : L) ((h : L) - 1) (Units.ne_zero _) hsub0, hr_val, zero_add]
          exact hha
  have hmem_S_shift : ∀ x : L,
      (QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S_shift ↔ (x + 1 ≠ 0 ∧ valL F L (x + 1) = 0) := by
    intro x
    rw [← hmem_S_unit (x + 1)]
    simp only [S_shift, S_unit, Finset.mem_image, φ_shift, φ_unit]
    refine exists_congr fun v => and_congr_right fun _ => ?_
    rw [QuotientAddGroup.eq, QuotientAddGroup.eq]
    have heq : -(((cosetRep v : Lˣ) : L) - 1) + x = -((cosetRep v : Lˣ) : L) + (x + 1) := by ring
    rw [heq]
  have hS_A_mem : ∀ x : L,
      (QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S_A ↔ (x = 0 ∨ (0 : ℤ) ≤ valL F L x) := by
    intro x
    rw [show S_A = S_unit ∪ S_shift from rfl, Finset.mem_union, hmem_S_unit, hmem_S_shift]
    constructor
    · rintro (⟨_, hx0⟩ | ⟨_, hx1⟩)
      · exact Or.inr (by omega)
      · have hadd := hval_add 0 (x + 1) (-1) (Or.inr (by omega)) (Or.inr (by rw [hval_neg1]))
        have hx_eq : (x + 1) + (-1 : L) = x := by ring
        rwa [hx_eq] at hadd
    · intro hx
      by_cases h0 : x ≠ 0 ∧ valL F L x = 0
      · exact Or.inl h0
      · right
        have hx1 : x = 0 ∨ (1 : ℤ) ≤ valL F L x := by
          rcases hx with rfl | hx_ge0
          · exact Or.inl rfl
          · by_cases hxz : x = 0
            · exact Or.inl hxz
            · have hne0 : valL F L x ≠ 0 := fun hv => h0 ⟨hxz, hv⟩
              exact Or.inr (by omega)
        have hpert := hunit_perturb 1 x ⟨one_ne_zero, hval1⟩ hx1
        rwa [add_comm 1 x] at hpert
  have hS_M_mem : ∀ x : L,
      (QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S_M ↔ (x = 0 ∨ (1 : ℤ) ≤ valL F L x) := by
    intro x
    rw [show S_M = S_A \ S_unit from rfl, Finset.mem_sdiff, hS_A_mem, hmem_S_unit]
    constructor
    · rintro ⟨hx0 | hx_ge0, hnot⟩
      · exact Or.inl hx0
      · by_cases hx0 : x = 0
        · exact Or.inl hx0
        · have hne0 : valL F L x ≠ 0 := fun hv => hnot ⟨hx0, hv⟩
          exact Or.inr (by omega)
    · intro hx1
      refine ⟨?_, ?_⟩
      · rcases hx1 with rfl | hx_ge1
        · exact Or.inl rfl
        · exact Or.inr (by omega)
      · rintro ⟨hx_ne, hx_val⟩
        have hx_ge1 : (1 : ℤ) ≤ valL F L x := hx1.resolve_left hx_ne
        omega
  have h0_mem : (QuotientAddGroup.mk 0 : L ⧸ Pₐ) ∈ S_A := (hS_A_mem 0).mpr (Or.inl rfl)
  have hNA_pos : 0 < S_A.card := Finset.card_pos.mpr ⟨_, h0_mem⟩
  refine ⟨S_A.card, S_M.card, hNA_pos, fun w hw => ?_⟩
  set n : ℤ := condExpChar F L ψ
  set r : L := ((cosetRep w : Lˣ) : L)
  set z : L := ((c⁻¹ : Lˣ) : L) * (r - 1)
  have hcinv_val : valL F L ((c⁻¹ : Lˣ) : L) = -((a : ℤ) + n) := by
    rw [hval_inv c, hc]
  have hz_bound : ∀ m : ℤ,
      (r - 1 = 0 ∨ m ≤ valL F L (r - 1)) ↔ (z = 0 ∨ m - ((a : ℤ) + n) ≤ valL F L z) := by
    intro m
    by_cases hr1 : r - 1 = 0
    · have hz0 : z = 0 := by dsimp [z]; rw [hr1, mul_zero]
      simp [hr1, hz0]
    · have hz_ne : z ≠ 0 := mul_ne_zero (Units.ne_zero _) hr1
      have hz_val : valL F L z = -((a : ℤ) + n) + valL F L (r - 1) := by
        dsimp [z]
        rw [hval_mul ((c⁻¹ : Lˣ) : L) (r - 1) (Units.ne_zero _) hr1, hcinv_val]
      simp only [hr1, hz_ne, false_or, hz_val]
      omega
  have htriv_iff : ∀ k : ℤ,
      (∀ x : L, (x = 0 ∨ k ≤ valL F L x) → ψ (z * x) = 1) ↔
        (z = 0 ∨ -(n + k) ≤ valL F L z) := by
    intro k
    constructor
    · intro htriv
      by_contra hnot
      push_neg at hnot
      rcases hnot with ⟨hz_ne, hz_lt⟩
      let u_z : Lˣ := Units.mk0 z hz_ne
      have huz_inv : ((u_z⁻¹ : Lˣ) : L) = z⁻¹ := by
        rw [Units.val_inv_eq_inv_val, Units.val_mk0]
      have hzinv_val : valL F L z⁻¹ = -valL F L z := by
        rw [← huz_inv, hval_inv u_z, Units.val_mk0]
      set x : L := z⁻¹ * x₁
      have hx_ne : z⁻¹ ≠ 0 := inv_ne_zero hz_ne
      have hx_val : k ≤ valL F L x := by
        dsimp [x]
        rw [hval_mul z⁻¹ x₁ hx_ne hx₁_ne, hzinv_val]
        omega
      have hzx1 : ψ (z * x) = 1 := htriv x (Or.inr hx_val)
      have hzx_eq : z * x = x₁ := mul_inv_cancel_left₀ hz_ne x₁
      rw [hzx_eq] at hzx1
      exact hx₁_ne1 hzx1
    · intro hz_ge x hx
      apply hψ_triv (z * x)
      rcases hz_ge with hzz | hz_ge
      · left; rw [hzz, zero_mul]
      · rcases hx with rfl | hx_ge
        · left; exact mul_zero z
        · by_cases hz0 : z = 0
          · left; rw [hz0, zero_mul]
          · by_cases hx0 : x = 0
            · left; rw [hx0, mul_zero]
            · right
              rw [hval_mul z x hz0 hx0]
              omega
  have hr1_ge0 : r - 1 = 0 ∨ (0 : ℤ) ≤ valL F L (r - 1) := by
    have hadd := hval_add 0 r (-1) (Or.inr (by omega)) (Or.inr (by rw [hval_neg1]))
    have heq : r + (-1 : L) = r - 1 := by ring
    rwa [heq] at hadd
  have hz_a : ∀ y : L, (y = 0 ∨ (a : ℤ) ≤ valL F L y) → ψ (z * y) = 1 := by
    have hz_ge : z = 0 ∨ -(n + (a : ℤ)) ≤ valL F L z := by
      have h1 := (hz_bound 0).mp hr1_ge0
      rcases h1 with hz0 | hle
      · exact Or.inl hz0
      · exact Or.inr (by omega)
    exact (htriv_iff (a : ℤ)).mpr hz_ge
  have hz_0 : (∀ x : L, (x = 0 ∨ (0 : ℤ) ≤ valL F L x) → ψ (z * x) = 1) ↔ w = 1 := by
    rw [htriv_iff 0]
    have h1 : (z = 0 ∨ -(n + 0) ≤ valL F L z) ↔
        (z = 0 ∨ (a : ℤ) - ((a : ℤ) + n) ≤ valL F L z) := by
      refine or_congr_right ?_
      omega
    have hout : QuotientGroup.mk (s := unitGroup F L a) (cosetRep w) = w :=
      QuotientGroup.out_eq' w
    rw [h1, ← hz_bound (a : ℤ), sub_eq_zero, ← hunit_ge1 a ha (cosetRep w),
      ← QuotientGroup.eq_one_iff, hout]
  have hz_1 : (∀ x : L, (x = 0 ∨ (1 : ℤ) ≤ valL F L x) → ψ (z * x) = 1) ↔
      cosetRep w ∈ unitGroup F L (a - 1) := by
    rw [htriv_iff 1]
    have h1 : (z = 0 ∨ -(n + 1) ≤ valL F L z) ↔
        (z = 0 ∨ ((a : ℤ) - 1) - ((a : ℤ) + n) ≤ valL F L z) := by
      refine or_congr_right ?_
      omega
    rw [h1, ← hz_bound ((a : ℤ) - 1), sub_eq_zero]
    by_cases ha1 : a - 1 = 0
    · have ha_eq : (a : ℤ) - 1 = 0 := by omega
      rw [ha1, ha_eq, hunit0 (cosetRep w)]
      have hr1_ge0' : r = 1 ∨ (0 : ℤ) ≤ valL F L (r - 1) := by
        rwa [← sub_eq_zero]
      exact ⟨fun _ => hw, fun _ => hr1_ge0'⟩
    · have ha1_ge : 1 ≤ a - 1 := Nat.one_le_iff_ne_zero.mpr ha1
      have ha_cast : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
      rw [hunit_ge1 (a - 1) ha1_ge (cosetRep w), ha_cast]
  let f : L ⧸ Pₐ → Ω F := fun q => ψ (z * Quotient.out q)
  have hf_mk : ∀ x : L, f (QuotientAddGroup.mk x) = ψ (z * x) := by
    intro x
    set rx : L := Quotient.out (QuotientAddGroup.mk x : L ⧸ Pₐ)
    have hout : (QuotientAddGroup.mk rx : L ⧸ Pₐ) = QuotientAddGroup.mk x :=
      QuotientAddGroup.out_eq' _
    have hd : -rx + x ∈ Pₐ := QuotientAddGroup.eq.mp hout
    have hzd : ψ (z * (-rx + x)) = 1 := hz_a (-rx + x) ((hPₐ _).mp hd)
    have hsplit : z * x = z * rx + z * (-rx + x) := by ring
    calc f (QuotientAddGroup.mk x)
      _ = ψ (z * rx) * 1 := (mul_one _).symm
      _ = ψ (z * rx) * ψ (z * (-rx + x)) := by rw [hzd]
      _ = ψ (z * x) := by rw [← AddChar.map_add_eq_mul, ← hsplit]
  have hf_add : ∀ q₁ q₂ : L ⧸ Pₐ, f (q₁ + q₂) = f q₁ * f q₂ := by
    intro q₁ q₂
    refine Quotient.inductionOn₂ q₁ q₂ fun x₁ x₂ => ?_
    change f (QuotientAddGroup.mk x₁ + QuotientAddGroup.mk x₂) =
      f (QuotientAddGroup.mk x₁) * f (QuotientAddGroup.mk x₂)
    rw [← QuotientAddGroup.mk_add, hf_mk (x₁ + x₂), mul_add, AddChar.map_add_eq_mul,
      hf_mk x₁, hf_mk x₂]
  have hsum_S : ∀ (k : ℤ) (S : Finset (L ⧸ Pₐ)),
      (∀ x : L, (QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S ↔ (x = 0 ∨ k ≤ valL F L x)) →
      (∑ q ∈ S, f q) =
        if (∀ x : L, (x = 0 ∨ k ≤ valL F L x) → ψ (z * x) = 1) then (S.card : Ω F) else 0 := by
    intro k S hS
    have hS_add : ∀ {q₁ q₂ : L ⧸ Pₐ}, q₁ ∈ S → q₂ ∈ S → q₁ + q₂ ∈ S := by
      intro q₁ q₂
      refine Quotient.inductionOn₂ q₁ q₂ fun x₁ x₂ hx₁ hx₂ => ?_
      change (QuotientAddGroup.mk x₁ : L ⧸ Pₐ) ∈ S at hx₁
      change (QuotientAddGroup.mk x₂ : L ⧸ Pₐ) ∈ S at hx₂
      change (QuotientAddGroup.mk x₁ : L ⧸ Pₐ) + QuotientAddGroup.mk x₂ ∈ S
      rw [← QuotientAddGroup.mk_add, hS]
      exact hval_add k x₁ x₂ ((hS x₁).mp hx₁) ((hS x₂).mp hx₂)
    have hS_neg : ∀ {q : L ⧸ Pₐ}, q ∈ S → -q ∈ S := by
      intro q
      refine Quotient.inductionOn q fun x hx => ?_
      change (QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S at hx
      change -(QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S
      rw [← QuotientAddGroup.mk_neg, hS]
      rcases (hS x).mp hx with rfl | hx_ge
      · left; exact neg_zero
      · right; rw [hval_neg]; exact hx_ge
    split_ifs with htriv
    · have h1 : ∀ q ∈ S, f q = 1 := by
        intro q
        refine Quotient.inductionOn q fun x hx => ?_
        change (QuotientAddGroup.mk x : L ⧸ Pₐ) ∈ S at hx
        change f (QuotientAddGroup.mk x) = 1
        rw [hf_mk x]
        exact htriv x ((hS x).mp hx)
      rw [Finset.sum_congr rfl h1, Finset.sum_const, nsmul_one]
    · push_neg at htriv
      rcases htriv with ⟨x₀, hx₀, hx₀_ne⟩
      set q₀ : L ⧸ Pₐ := QuotientAddGroup.mk x₀
      have hq₀ : q₀ ∈ S := (hS x₀).mpr hx₀
      have hfq₀ : f q₀ ≠ 1 := by
        change f (QuotientAddGroup.mk x₀) ≠ 1
        rw [hf_mk x₀]
        exact hx₀_ne
      have hshift : (∑ q ∈ S, f q) = f q₀ * (∑ q ∈ S, f q) := by
        calc (∑ q ∈ S, f q)
          _ = ∑ q ∈ S, f (q₀ + q) := by
              exact (Finset.sum_bij' (fun q _ => q₀ + q) (fun u _ => -q₀ + u)
                (fun q hq => hS_add hq₀ hq) (fun u hu => hS_add (hS_neg hq₀) hu)
                (fun q _ => neg_add_cancel_left q₀ q) (fun u _ => add_neg_cancel_left q₀ u)
                (fun q _ => rfl)).symm
          _ = ∑ q ∈ S, f q₀ * f q := Finset.sum_congr rfl fun q _ => hf_add q₀ q
          _ = f q₀ * ∑ q ∈ S, f q := (Finset.mul_sum S f (f q₀)).symm
      have hdiff : (f q₀ - 1) * (∑ q ∈ S, f q) = 0 := by
        linear_combination -hshift
      exact (mul_eq_zero.mp hdiff).resolve_left (sub_ne_zero.mpr hfq₀)
  have hsum_A := hsum_S 0 S_A hS_A_mem
  have hsum_M := hsum_S 1 S_M hS_M_mem
  have hS_sub : S_unit ⊆ S_A := Finset.subset_union_left
  have hsum_unit : (∑ v ∈ U, ψ (z * ((cosetRep v : Lˣ) : L))) =
      (∑ q ∈ S_A, f q) - (∑ q ∈ S_M, f q) := by
    calc (∑ v ∈ U, ψ (z * ((cosetRep v : Lˣ) : L)))
      _ = ∑ v ∈ U, f (φ_unit v) :=
          Finset.sum_congr rfl fun v _ => (hf_mk ((cosetRep v : Lˣ) : L)).symm
      _ = ∑ q ∈ S_unit, f q := (Finset.sum_image hS_unit_inj).symm
      _ = (∑ q ∈ S_A, f q) - (∑ q ∈ S_M, f q) :=
          eq_sub_of_add_eq' (Finset.sum_sdiff hS_sub)
  rw [show (∑ᶠ (v : Lˣ ⧸ unitGroup F L a) (_ : valL F L ((cosetRep v : Lˣ) : L) = 0),
        ψ (z * ((cosetRep v : Lˣ) : L))) =
      ∑ v ∈ U, ψ (z * ((cosetRep v : Lˣ) : L)) from
    finsum_mem_eq_finite_toFinset_sum
      (fun v => ψ (z * ((cosetRep v : Lˣ) : L))) hfin]
  rw [hsum_unit, hsum_A, hsum_M, if_congr hz_0 rfl rfl, if_congr hz_1 rfl rfl]

theorem ld_tateEps_ne_zero (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χ' : Lˣ →* (Ω F)ˣ) :
    tateEps F L χ' ψ ≠ 0 :=
by
  have hq_pos : 0 < qL F L := pow_pos (q_pos F) (resDeg F L)
  have hq_ne : (qL F L : Ω F) ^ condExpChar F L ψ ≠ 0 :=
    zpow_ne_zero _ (Nat.cast_ne_zero.mpr hq_pos.ne')
  unfold tateEps
  apply mul_ne_zero hq_ne
  split_ifs with ha
  · exact Units.ne_zero _
  · have ha_ge : 1 ≤ condExp F L χ' := Nat.one_le_iff_ne_zero.mpr ha
    set a := condExp F L χ'
    set n := condExpChar F L ψ
    set c := tateElt F L χ' ψ
    obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, _, hval_add,
      hunit0, hunit_ge1, hunit_val0⟩ := ld_valL_and_unitGroup_props F L
    obtain ⟨hψ_triv, _, hχ_spec, hc⟩ := ld_condExp_and_condExpChar_spec F L ψ hψ χ'
    obtain ⟨hχ_triv, ⟨u₀, hu₀_mem, hu₀_ne⟩⟩ := hχ_spec ha
    have hfin : Set.Finite {u : Lˣ ⧸ unitGroup F L a | valL F L ((cosetRep u : Lˣ) : L) = 0} :=
      ld_unitCoset_finite F L a ha_ge
    obtain ⟨N_A, N_M, hNA_pos, hOrth⟩ :=
      ld_unitCoset_addChar_orthogonality F L ψ hψ a ha_ge c hc
    set U := hfin.toFinset
    have hmem_U : ∀ u : Lˣ ⧸ unitGroup F L a, u ∈ U ↔ valL F L ((cosetRep u : Lˣ) : L) = 0 := by
      intro u
      simp [U, Set.Finite.mem_toFinset]
    have hout : ∀ u : Lˣ ⧸ unitGroup F L a,
        QuotientGroup.mk (s := unitGroup F L a) (cosetRep u) = u :=
      fun u => QuotientGroup.out_eq' u
    have hcoset_mk : ∀ x : Lˣ,
        (cosetRep (QuotientGroup.mk (s := unitGroup F L a) x))⁻¹ * x ∈ unitGroup F L a := by
      intro x
      exact QuotientGroup.eq.mp (hout _)
    have hval_mk : ∀ x : Lˣ,
        valL F L ((cosetRep (QuotientGroup.mk (s := unitGroup F L a) x) : Lˣ) : L) =
          valL F L (x : L) := by
      intro x
      set r := cosetRep (QuotientGroup.mk (s := unitGroup F L a) x)
      set h := r⁻¹ * x
      have hh : valL F L (h : L) = 0 := hunit_val0 a h (hcoset_mk x)
      have hx_eq : (x : L) = (r : L) * (h : L) := by
        have : x = r * h := by simp [h]
        exact congrArg Units.val this
      rw [hx_eq, hval_mul (r : L) (h : L) (Units.ne_zero r) (Units.ne_zero h), hh, add_zero]
    have hχ_mk : ∀ x : Lˣ,
        χ' (cosetRep (QuotientGroup.mk (s := unitGroup F L a) x)) = χ' x := by
      intro x
      set r := cosetRep (QuotientGroup.mk (s := unitGroup F L a) x)
      set h := r⁻¹ * x
      have hh : χ' h = 1 := hχ_triv h (hcoset_mk x)
      have hx_eq : x = r * h := by simp [h]
      rw [hx_eq, map_mul, hh, mul_one]
    have hU_one : (1 : Lˣ ⧸ unitGroup F L a) ∈ U := by
      rw [hmem_U]
      change valL F L ((cosetRep (QuotientGroup.mk (s := unitGroup F L a) 1) : Lˣ) : L) = 0
      rw [hval_mk 1, Units.val_one, hval1]
    have hU_mul : ∀ {v w : Lˣ ⧸ unitGroup F L a}, v ∈ U → w ∈ U → v * w ∈ U := by
      intro v w hv hw
      rw [hmem_U] at hv hw ⊢
      have hvw : v * w = QuotientGroup.mk (s := unitGroup F L a) (cosetRep v * cosetRep w) := by
        rw [QuotientGroup.mk_mul, hout, hout]
      rw [hvw, hval_mk (cosetRep v * cosetRep w), Units.val_mul,
        hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hv, hw, add_zero]
    have hU_inv : ∀ {v : Lˣ ⧸ unitGroup F L a}, v ∈ U → v⁻¹ ∈ U := by
      intro v hv
      rw [hmem_U] at hv ⊢
      have hvinv : v⁻¹ = QuotientGroup.mk (s := unitGroup F L a) (cosetRep v)⁻¹ := by
        rw [QuotientGroup.mk_inv, hout]
      rw [hvinv, hval_mk (cosetRep v)⁻¹, hval_inv (cosetRep v), hv, neg_zero]
    have hsum_mul_left : ∀ {v : Lˣ ⧸ unitGroup F L a}, v ∈ U →
        ∀ (f : Lˣ ⧸ unitGroup F L a → Ω F),
        (∑ u ∈ U, f u) = ∑ w ∈ U, f (v * w) := by
      intro v hv f
      exact (Finset.sum_bij' (fun w _ => v * w) (fun u _ => v⁻¹ * u)
        (fun w hw => hU_mul hv hw) (fun u hu => hU_mul (hU_inv hv) hu)
        (fun w _ => inv_mul_cancel_left v w) (fun u _ => mul_inv_cancel_left v u)
        (fun w _ => rfl)).symm
    have hχ_mul : ∀ v w : Lˣ ⧸ unitGroup F L a,
        χ' (cosetRep (v * w)) = χ' (cosetRep v) * χ' (cosetRep w) := by
      intro v w
      have hvw : v * w = QuotientGroup.mk (s := unitGroup F L a) (cosetRep v * cosetRep w) := by
        rw [QuotientGroup.mk_mul, hout, hout]
      rw [hvw, hχ_mk (cosetRep v * cosetRep w), map_mul]
    have hχ_one : χ' (cosetRep (1 : Lˣ ⧸ unitGroup F L a)) = 1 := by
      change χ' (cosetRep (QuotientGroup.mk (s := unitGroup F L a) 1)) = 1
      rw [hχ_mk 1, map_one]
    have hterm_χ : ∀ v w : Lˣ ⧸ unitGroup F L a,
        (χ' (c⁻¹ * cosetRep (v * w)) : Ω F)⁻¹ * (χ' (c⁻¹ * cosetRep v) : Ω F) =
          (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) := by
      intro v w
      have hmul : χ' (c⁻¹ * cosetRep (v * w)) = χ' (c⁻¹ * cosetRep v) * χ' (cosetRep w) := by
        rw [map_mul, map_mul, hχ_mul v w, mul_assoc]
      rw [hmul, Units.val_mul, Units.val_inv_eq_inv_val, mul_inv_rev, mul_assoc,
        inv_mul_cancel₀ (Units.ne_zero _), mul_one]
    have hterm_ψ : ∀ {v w : Lˣ ⧸ unitGroup F L a}, v ∈ U → w ∈ U →
        ψ (((c⁻¹ * cosetRep (v * w) : Lˣ) : L)) * ψ (- (((c⁻¹ * cosetRep v : Lˣ) : L))) =
          ψ (((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) * ((cosetRep v : Lˣ) : L)) := by
      intro v w hv hw
      have hvw_mem : v * w ∈ U := hU_mul hv hw
      rw [hmem_U] at hv hw hvw_mem
      set r := cosetRep (v * w)
      set h := r⁻¹ * (cosetRep v * cosetRep w)
      have hh_mem : h ∈ unitGroup F L a := by
        have hvw : v * w = QuotientGroup.mk (s := unitGroup F L a) (cosetRep v * cosetRep w) := by
          rw [QuotientGroup.mk_mul, hout, hout]
        exact QuotientGroup.eq.mp ((hout (v * w)).trans hvw)
      have hh_alt : (h : L) = 1 ∨ (a : ℤ) ≤ valL F L ((h : L) - 1) :=
        (hunit_ge1 a ha_ge h).mp hh_mem
      set δ : L := - (((c⁻¹ * r : Lˣ) : L) * ((h : L) - 1))
      have hδ_triv : ψ δ = 1 := by
        apply hψ_triv δ
        rcases hh_alt with hh1 | hha
        · left
          simp [δ, hh1]
        · by_cases hsub0 : (h : L) - 1 = 0
          · left
            simp [δ, hsub0]
          · right
            have hcr_ne : ((c⁻¹ * r : Lˣ) : L) ≠ 0 := Units.ne_zero _
            have hcr_val : valL F L ((c⁻¹ * r : Lˣ) : L) = - ((a : ℤ) + n) := by
              rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
                hval_inv c, hc, hvw_mem, add_zero]
            rw [show δ = - (((c⁻¹ * r : Lˣ) : L) * ((h : L) - 1)) from rfl,
              hval_neg, hval_mul _ _ hcr_ne hsub0, hcr_val]
            omega
      have hr_mul : (r * h : Lˣ) = cosetRep v * cosetRep w := by simp [h]
      have hr_val : (r : L) * (h : L) = ((cosetRep v : Lˣ) : L) * ((cosetRep w : Lˣ) : L) := by
        exact_mod_cast congrArg Units.val hr_mul
      have hsplit : ((c⁻¹ * r : Lˣ) : L) + (- (((c⁻¹ * cosetRep v : Lˣ) : L))) =
          δ + ((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) * ((cosetRep v : Lˣ) : L) := by
        simp only [δ, Units.val_mul]
        linear_combination ((c⁻¹ : Lˣ) : L) * hr_val
      rw [← AddChar.map_add_eq_mul, hsplit, AddChar.map_add_eq_mul, hδ_triv, one_mul]
    rw [show (∑ᶠ (u : Lˣ ⧸ unitGroup F L a) (_ : valL F L ((cosetRep u : Lˣ) : L) = 0),
          ((χ' (c⁻¹ * cosetRep u) : Ω F)⁻¹ * ψ (((c⁻¹ * cosetRep u : Lˣ) : L)))) =
        ∑ u ∈ U, ((χ' (c⁻¹ * cosetRep u) : Ω F)⁻¹ * ψ (((c⁻¹ * cosetRep u : Lˣ) : L))) from
      finsum_mem_eq_finite_toFinset_sum _ hfin]
    set S := ∑ u ∈ U, ((χ' (c⁻¹ * cosetRep u) : Ω F)⁻¹ * ψ (((c⁻¹ * cosetRep u : Lˣ) : L)))
    set S' := ∑ v ∈ U, ((χ' (c⁻¹ * cosetRep v) : Ω F) * ψ (- (((c⁻¹ * cosetRep v : Lˣ) : L))))
    have hprod : S * S' =
        ∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
          ((if w = 1 then (N_A : Ω F) else 0) -
            (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0)) := by
      calc S * S'
        _ = ∑ v ∈ U, ∑ u ∈ U,
              (((χ' (c⁻¹ * cosetRep u) : Ω F)⁻¹ * ψ (((c⁻¹ * cosetRep u : Lˣ) : L))) *
                ((χ' (c⁻¹ * cosetRep v) : Ω F) * ψ (- (((c⁻¹ * cosetRep v : Lˣ) : L))))) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun v _ => ?_
            rw [Finset.sum_mul]
        _ = ∑ v ∈ U, ∑ w ∈ U,
              ((((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
                ψ (((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) * ((cosetRep v : Lˣ) : L))) := by
            refine Finset.sum_congr rfl fun v hv => ?_
            rw [hsum_mul_left hv]
            refine Finset.sum_congr rfl fun w hw => ?_
            calc (((χ' (c⁻¹ * cosetRep (v * w)) : Ω F)⁻¹ *
                    ψ (((c⁻¹ * cosetRep (v * w) : Lˣ) : L))) *
                  ((χ' (c⁻¹ * cosetRep v) : Ω F) * ψ (- (((c⁻¹ * cosetRep v : Lˣ) : L)))))
              _ = ((χ' (c⁻¹ * cosetRep (v * w)) : Ω F)⁻¹ * (χ' (c⁻¹ * cosetRep v) : Ω F)) *
                    (ψ (((c⁻¹ * cosetRep (v * w) : Lˣ) : L)) *
                      ψ (- (((c⁻¹ * cosetRep v : Lˣ) : L)))) := by ring
              _ = (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
                    ψ (((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) *
                      ((cosetRep v : Lˣ) : L)) := by
                rw [hterm_χ v w, hterm_ψ hv hw]
        _ = ∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
              (∑ v ∈ U, ψ (((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) *
                ((cosetRep v : Lˣ) : L))) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun w _ => ?_
            rw [← Finset.mul_sum]
        _ = ∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
              ((if w = 1 then (N_A : Ω F) else 0) -
                (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0)) := by
            refine Finset.sum_congr rfl fun w hw => ?_
            congr 1
            rw [← finsum_mem_eq_finite_toFinset_sum
              (fun v => ψ (((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) *
                ((cosetRep v : Lˣ) : L))) hfin]
            exact hOrth w ((hmem_U w).mp hw)
    have hsub_unit : unitGroup F L a ≤ unitGroup F L (a - 1) := by
      intro u hu
      by_cases ha1 : a - 1 = 0
      · rw [ha1, hunit0]
        exact hunit_val0 a u hu
      · have ha1_ge : 1 ≤ a - 1 := Nat.one_le_iff_ne_zero.mpr ha1
        rw [hunit_ge1 (a - 1) ha1_ge]
        rcases (hunit_ge1 a ha_ge u).mp hu with hu1 | hua
        · exact Or.inl hu1
        · right
          omega
    have hmem_am1_mk : ∀ x : Lˣ,
        cosetRep (QuotientGroup.mk (s := unitGroup F L a) x) ∈ unitGroup F L (a - 1) ↔
          x ∈ unitGroup F L (a - 1) := by
      intro x
      set r := cosetRep (QuotientGroup.mk (s := unitGroup F L a) x)
      set h := r⁻¹ * x
      have hh : h ∈ unitGroup F L (a - 1) := hsub_unit (hcoset_mk x)
      have hx_eq : x = r * h := by simp [h]
      rw [hx_eq]
      exact (Subgroup.mul_mem_cancel_right (unitGroup F L (a - 1)) hh).symm
    set T := ∑ w ∈ U,
      if cosetRep w ∈ unitGroup F L (a - 1) then (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) else 0
    have hT_zero : T = 0 := by
      set w₀ : Lˣ ⧸ unitGroup F L a := QuotientGroup.mk u₀
      have hw₀_U : w₀ ∈ U := by
        rw [hmem_U, hval_mk u₀]
        exact hunit_val0 (a - 1) u₀ hu₀_mem
      have hw₀_am1 : ∀ w : Lˣ ⧸ unitGroup F L a,
          cosetRep (w₀ * w) ∈ unitGroup F L (a - 1) ↔ cosetRep w ∈ unitGroup F L (a - 1) := by
        intro w
        have hww : w₀ * w = QuotientGroup.mk (s := unitGroup F L a) (u₀ * cosetRep w) := by
          change QuotientGroup.mk (s := unitGroup F L a) u₀ * w = _
          rw [QuotientGroup.mk_mul, hout w]
        rw [hww, hmem_am1_mk (u₀ * cosetRep w)]
        exact Subgroup.mul_mem_cancel_left (unitGroup F L (a - 1)) hu₀_mem
      have hw₀_χ : ∀ w : Lˣ ⧸ unitGroup F L a,
          χ' (cosetRep (w₀ * w)) = χ' u₀ * χ' (cosetRep w) := by
        intro w
        rw [hχ_mul w₀ w, hχ_mk u₀]
      have hT_eq : T = (((χ' u₀)⁻¹ : (Ω F)ˣ) : Ω F) * T := by
        calc T
          _ = ∑ w ∈ U, if cosetRep (w₀ * w) ∈ unitGroup F L (a - 1) then
                (((χ' (cosetRep (w₀ * w)))⁻¹ : (Ω F)ˣ) : Ω F) else 0 := by
              exact hsum_mul_left hw₀_U _
          _ = ∑ w ∈ U, (((χ' u₀)⁻¹ : (Ω F)ˣ) : Ω F) *
                (if cosetRep w ∈ unitGroup F L (a - 1) then
                  (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) else 0) := by
              refine Finset.sum_congr rfl fun w _ => ?_
              rw [hw₀_am1 w, hw₀_χ w, mul_inv_rev, mul_comm (χ' (cosetRep w))⁻¹, Units.val_mul]
              split_ifs <;> ring
          _ = (((χ' u₀)⁻¹ : (Ω F)ˣ) : Ω F) * T := by
              rw [← Finset.mul_sum]
      have hdiff : ((((χ' u₀)⁻¹ : (Ω F)ˣ) : Ω F) - 1) * T = 0 := by
        linear_combination - hT_eq
      have hne1 : (((χ' u₀)⁻¹ : (Ω F)ˣ) : Ω F) - 1 ≠ 0 := by
        intro h0
        have h1 : (((χ' u₀)⁻¹ : (Ω F)ˣ) : Ω F) = ((1 : (Ω F)ˣ) : Ω F) := by
          rw [Units.val_one]
          exact sub_eq_zero.mp h0
        have h2 : (χ' u₀)⁻¹ = 1 := Units.ext h1
        exact hu₀_ne (inv_eq_one.mp h2)
      exact (mul_eq_zero.mp hdiff).resolve_left hne1
    have hsum1 : (∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
        (if w = 1 then (N_A : Ω F) else 0)) = (N_A : Ω F) := by
      have h1 : (∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
          (if w = 1 then (N_A : Ω F) else 0)) =
          ∑ w ∈ U, if w = 1 then (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) * (N_A : Ω F) else 0 := by
        refine Finset.sum_congr rfl fun w _ => ?_
        split_ifs <;> ring
      rw [h1, Finset.sum_ite_eq' U 1, if_pos hU_one, hχ_one, inv_one, Units.val_one, one_mul]
    have hsum2 : (∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
        (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0)) = (N_M : Ω F) * T := by
      have h2 : (∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
          (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0)) =
          ∑ w ∈ U, (N_M : Ω F) *
            (if cosetRep w ∈ unitGroup F L (a - 1) then
              (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) else 0) := by
        refine Finset.sum_congr rfl fun w _ => ?_
        split_ifs <;> ring
      rw [h2, ← Finset.mul_sum]
    have hprod_eq : S * S' = (N_A : Ω F) := by
      have hsub_sum : (∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
          ((if w = 1 then (N_A : Ω F) else 0) -
            (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0))) =
          (∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
            (if w = 1 then (N_A : Ω F) else 0)) -
          (∑ w ∈ U, (((χ' (cosetRep w))⁻¹ : (Ω F)ˣ) : Ω F) *
            (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0)) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun w _ => mul_sub _ _ _
      rw [hprod, hsub_sum, hsum1, hsum2, hT_zero, mul_zero, sub_zero]
    have hNA_ne : (N_A : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hNA_pos.ne'
    rw [← hprod_eq] at hNA_ne
    exact left_ne_zero_of_mul hNA_ne

theorem ld_tateEps_char_and_traceChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F) :
    (∀ (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (h : L ≤ M), Algebra.IsSeparable L (IntermediateField.extendScalars h) →
      FiniteDimensional F L ∧
      ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
        IsAdmissibleChar F M (traceChar F h ψ) ∧
        traceChar F (le_rfl : L ≤ L) ψ = ψ ∧
        ∀ (E : IntermediateField F (AlgebraicClosure F)) (h' : M ≤ E),
          traceChar F (h.trans h') ψ = traceChar F h' (traceChar F h ψ)) ∧
    (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
      ∀ (χ : relWeil F L →* (Ω F)ˣ), IsWeilRep F L (charRep F L χ) →
      ∀ (χ' : Lˣ →* (Ω F)ˣ), (∀ x : Lˣ, χ' x = χ (rec.recMap L x)) →
        recChar F rec L χ = χ' ∧
        (tateEpsUnit F L (recChar F rec L χ) ψ : Ω F) = tateEps F L χ' ψ) :=
by
  have htrace_self : ∀ (L : IntermediateField F (AlgebraicClosure F)) (x : L),
      traceLM F (le_rfl : L ≤ L) x = x := by
    intro L x
    let e : L ≃ₐ[L] IntermediateField.extendScalars (le_rfl : L ≤ L) :=
      AlgEquiv.ofBijective (Algebra.ofId L (IntermediateField.extendScalars (le_rfl : L ≤ L)))
        ⟨(algebraMap L _).injective,
         fun y => ⟨⟨y.1, (IntermediateField.mem_extendScalars le_rfl).mp y.2⟩, rfl⟩⟩
    have he : toExtendScalars F (le_rfl : L ≤ L) x = e x := rfl
    change Algebra.trace L (IntermediateField.extendScalars (le_rfl : L ≤ L))
      (toExtendScalars F le_rfl x) = x
    rw [he, Algebra.trace_eq_of_algEquiv e x, Algebra.trace_self_apply]
  have htrace_trans_aux : ∀ (K L M E : Type u) [Field K] [Field L] [Field M] [Field E]
      [Algebra K L] [Algebra K M] [Algebra K E]
      (algLM : Algebra L M) (algME : Algebra M E) (algLE : Algebra L E)
      (h1 : ∀ x : K, @algebraMap L M _ _ algLM (algebraMap K L x) = algebraMap K M x)
      (h2 : ∀ x : L, @algebraMap M E _ _ algME (@algebraMap L M _ _ algLM x) =
        @algebraMap L E _ _ algLE x)
      [FiniteDimensional K M] (z : E),
      @Algebra.trace L E _ _ algLE z =
        @Algebra.trace L M _ _ algLM (@Algebra.trace M E _ _ algME z) := by
    intro K L M E _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L M := algLM
    letI : Algebra M E := algME
    letI : Algebra L E := algLE
    haveI : IsScalarTower K L M := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L M E := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L M := Module.Finite.of_restrictScalars_finite K L M
    by_cases hFin : FiniteDimensional M E
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M E = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L E = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L E := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L M E)
      simp [htr1, htr2]
  have htrace_eq_inclusion : ∀ {L M : IntermediateField F (AlgebraicClosure F)}
      (h : L ≤ M) (y : M),
      @Algebra.trace L M _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
    intro L M h y
    letI : Algebra L M := (IntermediateField.inclusion h).toAlgebra
    let e : M ≃ₐ[L] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm
  have htrace_trans : ∀ (L M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (h : L ≤ M) (h' : M ≤ E) (z : E),
      traceLM F (h.trans h') z = traceLM F h (traceLM F h' z) := by
    intro L M E _ h h' z
    rw [← htrace_eq_inclusion (h.trans h') z,
        ← htrace_eq_inclusion h' z,
        ← htrace_eq_inclusion h]
    exact htrace_trans_aux F L M E
      (IntermediateField.inclusion h).toAlgebra
      (IntermediateField.inclusion h').toAlgebra
      (IntermediateField.inclusion (h.trans h')).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z
  refine ⟨?_, ?_⟩
  · intro L M _ h hSep
    have hFinL : FiniteDimensional F L :=
      Module.Finite.of_injective (IntermediateField.inclusion h).toLinearMap
        (IntermediateField.inclusion h).injective
    refine ⟨hFinL, fun ψ hψ => ⟨ld_traceChar_admissible F L M h hSep ψ hψ, ?_, ?_⟩⟩
    · ext x
      simp [traceChar, htrace_self L x]
    · intro E h'
      ext z
      simp [traceChar, htrace_trans L M E h h' z]
  · intro L _ ψ hψ χ _ χ' hχ'
    have hex : ∃ χ'' : Lˣ →* (Ω F)ˣ, ∀ x : Lˣ, χ'' x = χ (rec.recMap L x) := ⟨χ', hχ'⟩
    have hspec : ∀ x : Lˣ, recChar F rec L χ x = χ (rec.recMap L x) :=
      Classical.epsilon_spec hex
    have hrec : recChar F rec L χ = χ' := by
      ext x
      rw [hspec x, hχ' x]
    refine ⟨hrec, ?_⟩
    rw [hrec]
    have hne : tateEps F L χ' ψ ≠ 0 := ld_tateEps_ne_zero F L ψ hψ χ'
    simp [tateEpsUnit, hne]

theorem ld_galois_closure_directed_system (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    (∀ (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
      IsGaloisExt F L K →
      Module.finrank L (IntermediateField.extendScalars hLK) ≤ 1 → K ≤ L) ∧
    (∀ (L M K : IntermediateField F (AlgebraicClosure F)) (h₁ : L ≤ M) (hMK : M ≤ K),
      IsGaloisExt F L K →
      IsGaloisExt F M K ∧
      Module.finrank M (IntermediateField.extendScalars hMK) ≤
        Module.finrank L (IntermediateField.extendScalars (h₁.trans hMK))) ∧
    (∀ (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E),
      Algebra.IsSeparable L (IntermediateField.extendScalars hLE) →
      ∃ K : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K ∧ E ≤ K) ∧
    (∀ (L K₁ K₂ : IntermediateField F (AlgebraicClosure F)),
      IsGaloisExt F L K₁ → IsGaloisExt F L K₂ →
      ∃ K : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K ∧ K₁ ≤ K ∧ K₂ ≤ K) ∧
    (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (D : List (MonomialTerm F L)),
      (∀ t ∈ D, t.Wf F L) →
      ∃ K : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K ∧ ∀ t ∈ D, t.field ≤ K) :=
by
  have hSep_iff : ∀ (L E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E),
      Algebra.IsSeparable L (IntermediateField.extendScalars hLE) ↔
        E ≤ IntermediateField.restrictScalars F (separableClosure L (AlgebraicClosure F)) := by
    intro L E hLE
    let S := IntermediateField.extendScalars hLE
    have hmin : ∀ x : S, IsSeparable L x.1 ↔ IsSeparable L x := by
      intro x
      change (minpoly L (S.val x)).Separable ↔ (minpoly L x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hLE).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E := (IntermediateField.mem_extendScalars hLE).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hDeg1 : ∀ (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
      IsGaloisExt F L K →
      Module.finrank L (IntermediateField.extendScalars hLK) ≤ 1 → K ≤ L := by
    intro L K hLK hGal hfin
    haveI : FiniteDimensional F K := hGal.2.1
    haveI : IsScalarTower F L (IntermediateField.extendScalars hLK) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hmul : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) =
        Module.finrank F K :=
      Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLK)
    have hle : Module.finrank F K ≤ Module.finrank F L := by
      calc Module.finrank F K
        _ = Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) := hmul.symm
        _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hfin
        _ = Module.finrank F L := mul_one _
    exact (IntermediateField.eq_of_le_of_finrank_le hLK hle).ge
  have hGalTower : ∀ (L M K : IntermediateField F (AlgebraicClosure F)) (h₁ : L ≤ M) (hMK : M ≤ K),
      IsGaloisExt F L K →
      IsGaloisExt F M K ∧
      Module.finrank M (IntermediateField.extendScalars hMK) ≤
        Module.finrank L (IntermediateField.extendScalars (h₁.trans hMK)) := by
    intro L M K h₁ hMK hGal
    have hLK : L ≤ K := h₁.trans hMK
    haveI : FiniteDimensional F K := hGal.2.1
    refine ⟨⟨hMK, hGal.2.1, ?_, ?_⟩, ?_⟩
    · intro σ hσ τ hτ
      exact hGal.2.2.1 σ (IntermediateField.fixingSubgroup_le h₁ hσ) τ hτ
    · intro h
      rw [hSep_iff]
      intro z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      have hzL : IsSeparable L z := by
        have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) hz
        exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
      exact IsSeparable.tower_top (↥(IntermediateField.extendScalars h₁)) hzL
    · haveI : FiniteDimensional F M :=
        Module.Finite.of_injective (IntermediateField.inclusion hMK).toLinearMap
          (IntermediateField.inclusion hMK).injective
      haveI : FiniteDimensional F L :=
        Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
          (IntermediateField.inclusion hLK).injective
      haveI : IsScalarTower F L (IntermediateField.extendScalars h₁) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower F M (IntermediateField.extendScalars hMK) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower F L (IntermediateField.extendScalars hLK) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      have h1 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars h₁) =
          Module.finrank F M :=
        Module.finrank_mul_finrank F L (IntermediateField.extendScalars h₁)
      have h2 : Module.finrank F M * Module.finrank M (IntermediateField.extendScalars hMK) =
          Module.finrank F K :=
        Module.finrank_mul_finrank F M (IntermediateField.extendScalars hMK)
      have h3 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) =
          Module.finrank F K :=
        Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLK)
      have hposL : 0 < Module.finrank F L := Module.finrank_pos
      have hposM : 0 < Module.finrank F M := Module.finrank_pos
      have hposLM : 0 < Module.finrank L (IntermediateField.extendScalars h₁) := by
        by_contra h0
        have h0' : Module.finrank L (IntermediateField.extendScalars h₁) = 0 :=
          Nat.eq_zero_of_not_pos h0
        rw [h0', mul_zero] at h1
        exact (ne_of_gt hposM) h1.symm
      have hmul_eq : Module.finrank F L *
          (Module.finrank L (IntermediateField.extendScalars h₁) *
            Module.finrank M (IntermediateField.extendScalars hMK)) =
          Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) := by
        rw [← mul_assoc, h1, h2, h3]
      have hdeg_eq : Module.finrank L (IntermediateField.extendScalars h₁) *
          Module.finrank M (IntermediateField.extendScalars hMK) =
          Module.finrank L (IntermediateField.extendScalars hLK) :=
        Nat.eq_of_mul_eq_mul_left hposL hmul_eq
      rw [← hdeg_eq]
      exact Nat.le_mul_of_pos_left _ hposLM
  have hGalClos : ∀ (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (hLE : L ≤ E),
      Algebra.IsSeparable L (IntermediateField.extendScalars hLE) →
      ∃ K : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K ∧ E ≤ K := by
    intro L E _ hLE hSep
    let K : IntermediateField F (AlgebraicClosure F) :=
      ⨆ σ : L.fixingSubgroup, E.map (σ.1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
    have hEK : E ≤ K := by
      have hid : ((1 : L.fixingSubgroup).1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) =
          AlgHom.id F (AlgebraicClosure F) := rfl
      calc E = E.map (AlgHom.id F (AlgebraicClosure F)) := (IntermediateField.map_id E).symm
        _ = E.map ((1 : L.fixingSubgroup).1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := by
          rw [hid]
        _ ≤ K := le_iSup (fun σ : L.fixingSubgroup =>
          E.map (σ.1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) 1
    have hLK : L ≤ K := hLE.trans hEK
    have hK_le_nc : K ≤ IntermediateField.normalClosure F E (AlgebraicClosure F) := by
      rw [IntermediateField.normalClosure_def'']
      exact iSup_le fun σ => le_iSup
        (fun f : AbsGal F => E.map (f : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) σ.1
    haveI : FiniteDimensional F (IntermediateField.normalClosure F E (AlgebraicClosure F)) :=
      normalClosure.is_finiteDimensional F E (AlgebraicClosure F)
    haveI : FiniteDimensional F K :=
      Module.Finite.of_injective (IntermediateField.inclusion hK_le_nc).toLinearMap
        (IntermediateField.inclusion hK_le_nc).injective
    have hK_comap : ∀ γ : L.fixingSubgroup,
        K ≤ K.comap (γ.1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := by
      intro γ
      refine iSup_le fun ρ => ?_
      rw [← IntermediateField.map_le_iff_le_comap, IntermediateField.map_map]
      have hcomp : (γ.1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp
          (ρ.1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) =
          ((γ * ρ).1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := rfl
      rw [hcomp]
      exact le_iSup (fun σ : L.fixingSubgroup =>
        E.map (σ.1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) (γ * ρ)
    refine ⟨K, ⟨hLK, inferInstance, ?_, ?_⟩, hEK⟩
    · intro σ hσ τ hτ x
      let γ : L.fixingSubgroup := ⟨σ, hσ⟩⁻¹
      have hx_inv : σ⁻¹ x.1 ∈ K := hK_comap γ x.2
      have hτ_fix : τ (σ⁻¹ x.1) = σ⁻¹ x.1 := hτ ⟨σ⁻¹ x.1, hx_inv⟩
      change (σ * τ * σ⁻¹) x.1 = x.1
      simp only [AlgEquiv.mul_apply]
      rw [hτ_fix]
      exact σ.apply_symm_apply x.1
    · intro h
      rw [hSep_iff]
      refine iSup_le fun σ => ?_
      rw [IntermediateField.map_le_iff_le_comap]
      intro e he
      change (σ.1 : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) e ∈
        IntermediateField.restrictScalars F (separableClosure L (AlgebraicClosure F))
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      have he_sep : IsSeparable L e := by
        have he' := (hSep_iff L E hLE).mp hSep he
        exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp he')
      let fL : AlgebraicClosure F →ₐ[L] AlgebraicClosure F :=
        { toRingHom := (σ.1 : AlgebraicClosure F →+* AlgebraicClosure F)
          commutes' := fun x => σ.2 x }
      change (minpoly L (fL e)).Separable
      rw [minpoly.algHom_eq fL σ.1.injective e]
      exact he_sep
  have hGalSup : ∀ (L K₁ K₂ : IntermediateField F (AlgebraicClosure F)),
      IsGaloisExt F L K₁ → IsGaloisExt F L K₂ →
      ∃ K : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K ∧ K₁ ≤ K ∧ K₂ ≤ K := by
    intro L K₁ K₂ hGal₁ hGal₂
    haveI : FiniteDimensional F K₁ := hGal₁.2.1
    haveI : FiniteDimensional F K₂ := hGal₂.2.1
    haveI : FiniteDimensional F ↥(K₁ ⊔ K₂) :=
      IntermediateField.finiteDimensional_sup K₁ K₂
    refine ⟨K₁ ⊔ K₂, ⟨hGal₁.1.trans le_sup_left, inferInstance, ?_, ?_⟩,
      le_sup_left, le_sup_right⟩
    · intro σ hσ τ hτ
      rw [IntermediateField.fixingSubgroup_sup] at hτ ⊢
      exact ⟨hGal₁.2.2.1 σ hσ τ hτ.1, hGal₂.2.2.1 σ hσ τ hτ.2⟩
    · intro h
      rw [hSep_iff]
      exact sup_le ((hSep_iff L K₁ hGal₁.1).mp (hGal₁.2.2.2 hGal₁.1))
        ((hSep_iff L K₂ hGal₂.1).mp (hGal₂.2.2.2 hGal₂.1))
  have hGalList : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (D : List (MonomialTerm F L)),
      (∀ t ∈ D, t.Wf F L) →
      ∃ K : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K ∧ ∀ t ∈ D, t.field ≤ K := by
    intro L _ D hWf
    induction D with
    | nil =>
      have hSepL : Algebra.IsSeparable L (IntermediateField.extendScalars (le_rfl : L ≤ L)) := by
        refine ⟨fun x => ?_⟩
        let xL : L := ⟨x.1, (IntermediateField.mem_extendScalars (le_rfl : L ≤ L)).mp x.2⟩
        have hx : algebraMap L (IntermediateField.extendScalars (le_rfl : L ≤ L)) xL = x := rfl
        rw [← hx]
        exact isSeparable_algebraMap xL
      obtain ⟨K, hGal, _⟩ := hGalClos L L le_rfl hSepL
      refine ⟨K, hGal, fun t ht => ?_⟩
      nomatch ht
    | cons t tl ih =>
      have ht : t.Wf F L := hWf t List.mem_cons_self
      have htl : ∀ t' ∈ tl, t'.Wf F L := fun t' ht' => hWf t' (List.mem_cons_of_mem t ht')
      haveI : FiniteDimensional F t.field := ht.1
      obtain ⟨K₁, hGal₁, htK₁⟩ := hGalClos L t.field t.le ht.2.1
      obtain ⟨K₂, hGal₂, htlK₂⟩ := ih htl
      obtain ⟨K, hGal, hK₁K, hK₂K⟩ := hGalSup L K₁ K₂ hGal₁ hGal₂
      refine ⟨K, hGal, fun t' ht' => ?_⟩
      rw [List.mem_cons] at ht'
      rcases ht' with rfl | ht'
      · exact htK₁.trans hK₁K
      · exact (htlK₂ t' ht').trans hK₂K
  exact ⟨hDeg1, hGalTower, hGalClos, hGalSup, hGalList⟩

theorem ld_lambda_base_shift (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L M K : IntermediateField F (AlgebraicClosure F))
    (h₁ : L ≤ M) (hMK : M ≤ K) (hGal : IsGaloisExt F L K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf : IsLambdaFuncOn F rec L K ψ f) :
    IsAdmissibleChar F M (traceChar F h₁ ψ) ∧
    IsLambdaFuncOn F rec M K (traceChar F h₁ ψ) (shiftLamFunc F M f) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F M :=
    Module.Finite.of_injective (IntermediateField.inclusion hMK).toLinearMap
      (IntermediateField.inclusion hMK).injective
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion h₁).toLinearMap
      (IntermediateField.inclusion h₁).injective
  have hSep₁ : Algebra.IsSeparable L (IntermediateField.extendScalars h₁) := by
    letI algMK : Algebra (IntermediateField.extendScalars h₁)
        (IntermediateField.extendScalars (h₁.trans hMK)) :=
      inferInstanceAs (Algebra M (IntermediateField.extendScalars hMK))
    letI : SMul (IntermediateField.extendScalars h₁)
        (IntermediateField.extendScalars (h₁.trans hMK)) :=
      algMK.toSMul
    haveI : IsScalarTower L (IntermediateField.extendScalars h₁)
        (IntermediateField.extendScalars (h₁.trans hMK)) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.IsSeparable L (IntermediateField.extendScalars (h₁.trans hMK)) :=
      hGal.2.2.2 (h₁.trans hMK)
    exact Algebra.isSeparable_tower_bot_of_isSeparable L
      (IntermediateField.extendScalars h₁)
      (IntermediateField.extendScalars (h₁.trans hMK))
  have hψM : IsAdmissibleChar F M (traceChar F h₁ ψ) :=
    ld_traceChar_admissible F L M h₁ hSep₁ ψ hψ
  refine ⟨hψM, ?_, ?_⟩
  · unfold shiftLamFunc
    rw [dif_pos (le_rfl : M ≤ M)]
    haveI : IsScalarTower F M (IntermediateField.extendScalars (le_rfl : M ≤ M)) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hmul : Module.finrank F M *
        Module.finrank M (IntermediateField.extendScalars (le_rfl : M ≤ M)) =
        Module.finrank F M :=
      Module.finrank_mul_finrank F M (IntermediateField.extendScalars (le_rfl : M ≤ M))
    have hposM : 0 < Module.finrank F M := Module.finrank_pos
    have hfin1 : Module.finrank M (IntermediateField.extendScalars (le_rfl : M ≤ M)) = 1 :=
      Nat.eq_of_mul_eq_mul_left hposM (hmul.trans (mul_one _).symm)
    rw [hfin1, pow_one, mul_inv_cancel]
  · intro D hD hDK
    have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
        [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
        (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
        (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
        (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
          @algebraMap L₀ E₀ _ _ algLE x)
        [FiniteDimensional K₀ M₀] (z : E₀),
        @Algebra.trace L₀ E₀ _ _ algLE z =
          @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
      intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
      letI : Algebra L₀ M₀ := algLM
      letI : Algebra M₀ E₀ := algME
      letI : Algebra L₀ E₀ := algLE
      haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
      haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
      haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
      by_cases hFin : FiniteDimensional M₀ E₀
      · exact (Algebra.trace_trace z).symm
      · have htr1 : Algebra.trace M₀ E₀ = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          exact hFin (Module.Finite.of_basis b)
        have htr2 : Algebra.trace L₀ E₀ = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
          exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
        simp [htr1, htr2]
    have htrace_eq_inclusion : ∀ {L' M' : IntermediateField F (AlgebraicClosure F)}
        (h : L' ≤ M') (y : M'),
        @Algebra.trace L' M' _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
      intro L' M' h y
      letI : Algebra L' M' := (IntermediateField.inclusion h).toAlgebra
      let e : M' ≃ₐ[L'] IntermediateField.extendScalars h := {
        toFun := toExtendScalars F h
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl
      }
      exact (Algebra.trace_eq_of_algEquiv e y).symm
    have htraceChar_trans : ∀ (E : IntermediateField F (AlgebraicClosure F)) (h' : M ≤ E),
        traceChar F (h₁.trans h') ψ = traceChar F h' (traceChar F h₁ ψ) := by
      intro E h'
      ext z
      simp only [traceChar, AddChar.compAddMonoidHom_apply, AddMonoidHom.comp_apply]
      congr 1
      rw [← htrace_eq_inclusion (h₁.trans h') z,
          ← htrace_eq_inclusion h' z,
          ← htrace_eq_inclusion h₁]
      exact htrace_trans_aux F L M E
        (IntermediateField.inclusion h₁).toAlgebra
        (IntermediateField.inclusion h').toAlgebra
        (IntermediateField.inclusion (h₁.trans h')).toAlgebra
        (fun _ => rfl)
        (fun _ => rfl)
        z
    have heval_shift : ∀ (L_M : List (MonomialTerm F M)),
        evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) L_M *
          (f M) ^ (monomialListDeg F M L_M) =
        evalMonomialList F rec (fun _ E _ => f E) L ψ (L_M.map (MonomialTerm.restrict F h₁)) := by
      intro L_M
      induction L_M with
      | nil =>
        simp [evalMonomialList, monomialListDeg]
      | cons t tl ih =>
        have hterm : evalMonomialTerm F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) t *
            (f M) ^ (t.deg F M) =
          evalMonomialTerm F rec (fun _ E _ => f E) L ψ (t.restrict F h₁) := by
          simp only [evalMonomialTerm, MonomialTerm.restrict, MonomialTerm.deg]
          unfold shiftLamFunc
          rw [dif_pos t.le, ← htraceChar_trans t.field t.le]
          set A := tateEpsUnit F t.field (recChar F rec t.field t.χ) (traceChar F (h₁.trans t.le) ψ)
          set d := Module.finrank M (IntermediateField.extendScalars t.le)
          rw [← mul_assoc, mul_zpow, inv_zpow, ← zpow_natCast (f M) d, ← zpow_mul,
            mul_comm (d : ℤ) t.coeff, mul_assoc, inv_mul_cancel, mul_one]
        simp only [evalMonomialList, monomialListDeg, List.map_cons, List.prod_cons, List.sum_cons] at ih ⊢
        rw [zpow_add, ← ih]
        calc (evalMonomialTerm F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) t *
              evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) tl) *
              ((f M) ^ (t.deg F M) * (f M) ^ (monomialListDeg F M tl))
          _ = (evalMonomialTerm F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) t *
                (f M) ^ (t.deg F M)) *
              (evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) tl *
                (f M) ^ (monomialListDeg F M tl)) := by ac_rfl
          _ = evalMonomialTerm F rec (fun _ E _ => f E) L ψ (t.restrict F h₁) *
              (evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) tl *
                (f M) ^ (monomialListDeg F M tl)) := by rw [hterm]
    let σ₀ : Representation (Ω F) (relWeil F M) PUnit.{u+1} := 1
    have hσ₀ : IsWeilRep F M σ₀ :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
    have htr₀ : (fun w : relWeil F M => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) = 0 := by
      ext w
      have hw : σ₀ w = 0 := Subsingleton.elim _ _
      rw [hw, map_zero, Pi.zero_apply]
    have hD₀ : IsMonomialDecomp F M (fun w => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) D := by
      rw [htr₀]
      exact hD
    have hDeg : monomialListDeg F M D = 0 := by
      rw [ld_monomial_deg_eq_finrank F M σ₀ hσ₀ D hD₀, Module.finrank_zero_of_subsingleton,
        Nat.cast_zero]
    have hD_L : IsMonomialDecomp F L 0 (D.map (MonomialTerm.restrict F h₁)) := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rw [List.mem_map] at ht
        rcases ht with ⟨t₀, ht₀, rfl⟩
        obtain ⟨hFin, hSepM, hWeil⟩ := hD.1 t₀ ht₀
        refine ⟨hFin, ?_, hWeil⟩
        letI algME : Algebra (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) :=
          inferInstanceAs (Algebra M (IntermediateField.extendScalars t₀.le))
        letI : SMul (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) :=
          algME.toSMul
        haveI : IsScalarTower L (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) :=
          IsScalarTower.of_algebraMap_eq fun _ => rfl
        haveI : Algebra.IsSeparable L (IntermediateField.extendScalars h₁) := hSep₁
        haveI : Algebra.IsSeparable (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) := hSepM
        exact Algebra.IsSeparable.trans L (IntermediateField.extendScalars h₁)
          (IntermediateField.extendScalars (h₁.trans t₀.le))
      · intro w
        rw [Pi.zero_apply, ← ld_indLM_trace_decomp F L M h₁ hSep₁ σ₀ hσ₀ D hD₀ w]
        let tr := LinearMap.trace (Ω F)
          (indSpace ((relWeil F M).subgroupOf (relWeil F L))
            (σ₀.comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F h₁)).toMonoidHom))
        have hw : indLM F h₁ σ₀ w + indLM F h₁ σ₀ w = indLM F h₁ σ₀ w :=
          LinearMap.ext fun _ => Subtype.ext (funext fun _ => Subsingleton.elim _ _)
        have h0 : tr (indLM F h₁ σ₀ w + indLM F h₁ σ₀ w) =
            tr (indLM F h₁ σ₀ w) + tr (indLM F h₁ σ₀ w) :=
          tr.map_add' (indLM F h₁ σ₀ w) (indLM F h₁ σ₀ w)
        rw [hw] at h0
        calc (0 : Ω F) = tr (indLM F h₁ σ₀ w) - tr (indLM F h₁ σ₀ w) := (sub_self _).symm
          _ = (tr (indLM F h₁ σ₀ w) + tr (indLM F h₁ σ₀ w)) - tr (indLM F h₁ σ₀ w) :=
            congrArg (· - tr (indLM F h₁ σ₀ w)) h0
          _ = tr (indLM F h₁ σ₀ w) := add_sub_cancel_right _ _
    have hDK_L : ∀ t ∈ D.map (MonomialTerm.restrict F h₁), t.field ≤ K := by
      intro t ht
      rw [List.mem_map] at ht
      rcases ht with ⟨t₀, ht₀, rfl⟩
      exact hDK t₀ ht₀
    have hEq := heval_shift D
    rw [hDeg, zpow_zero, mul_one, hf.2 _ hD_L hDK_L] at hEq
    exact hEq

theorem ld_local_galois_abelian_normal_subgroup (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hdeg : 1 < Module.finrank L (IntermediateField.extendScalars hLK)) :
    ∃ (C : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)),
      C.Normal ∧ (∃ c ∈ C, c ≠ 1) ∧ (∀ a ∈ C, ∀ b ∈ C, a * b = b * a) :=
by
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear! F L K
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : AlgEquiv.restrictNormalHom N τ z = z := hh z hx
        have h1 : ((AlgEquiv.restrictNormalHom N τ z : N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have helper_residue : ∀ (E : Type u) [Field E] (v : E → ℤ) (p₀ : ℕ),
      Nat.Prime p₀ →
      v 0 = 0 →
      v 1 = 0 →
      (∀ x : E, v (-x) = v x) →
      (∀ x y : E, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
      (∀ u : Eˣ, v ((u⁻¹ : Eˣ) : E) = - v (u : E)) →
      (∀ (k : ℤ) (x y : E), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) → (x + y = 0 ∨ k ≤ v (x + y))) →
      ((p₀ : E) = 0 ∨ 1 ≤ v (p₀ : E)) →
      ∀ (S₁ : Finset E),
        (∀ x : E, (x = 0 ∨ 0 ≤ v x) → ∃ s ∈ S₁, x - s = 0 ∨ (1 : ℤ) ≤ v (x - s)) →
        (∀ (σ τ : E →+* E), (∀ x : E, v (σ x) = v x) → (∀ x : E, v (τ x) = v x) →
          ∀ x : E, (x = 0 ∨ 0 ≤ v x) →
            (σ (τ x) - τ (σ x) = 0 ∨ (1 : ℤ) ≤ v (σ (τ x) - τ (σ x)))) ∧
        (∀ x : E, (x = 0 ∨ 0 ≤ v x) →
          ∃ s : E, (s = 0 ∨ 0 ≤ v s) ∧
            (x - s ^ p₀ = 0 ∨ (1 : ℤ) ≤ v (x - s ^ p₀))) ∧
        (∀ a d : E, (a = 0 ∨ 0 ≤ v a) → (d = 0 ∨ (1 : ℤ) ≤ v d) →
          ((a + d) ^ p₀ - a ^ p₀ = 0 ∨ (2 : ℤ) ≤ v ((a + d) ^ p₀ - a ^ p₀))) := by
    clear! F L K
    intro E _ v p₀ hp _ hv1 hv_neg hv_mul hv_inv hv_add hP_p S₁ hS₁
    let P : ℤ → E → Prop := fun k x => x = 0 ∨ k ≤ v x
    have hP_map : ∀ (k : ℤ) (φ : E →+* E), (∀ x : E, v (φ x) = v x) →
        ∀ x : E, P k (φ x) ↔ P k x := by
      intro k φ hφ x
      dsimp [P]
      rw [map_eq_zero, hφ x]
    have hP_zero : ∀ k : ℤ, P k 0 := fun _ => Or.inl rfl
    have hP_one : P 0 1 := Or.inr (by omega)
    have hP_neg : ∀ (k : ℤ) {x : E}, P k x → P k (-x) := by
      intro k x hx
      rcases hx with rfl | hx
      · left; exact neg_zero
      · right; rw [hv_neg]; exact hx
    have hP_add : ∀ (k : ℤ) {x y : E}, P k x → P k y → P k (x + y) :=
      fun k {x y} hx hy => hv_add k x y hx hy
    have hP_sub : ∀ (k : ℤ) {x y : E}, P k x → P k y → P k (x - y) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
