by
  intro z s_sq C_z
  set T : ℕ := condExp F L νE'
  set d_T : ℕ := T / 2
  set r_T : ℕ := (T + 1) / 2
  have hd_T_ge1 : 1 ≤ d_T := by omega
  have hr_T_ge1 : 1 ≤ r_T := by omega
  have hr_T_eq : r_T = d_T + 1 := by omega
  have hd_r_sum : (d_T : ℤ) + (r_T : ℤ) = (T : ℤ) := by omega
