          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (r₀ : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) - 1) ≤ valL F K y :=
        Or.inr (le_trans h_tr_thresh hy_val)
      have ht_cond : traceLM F hLK y = 0 ∨ (r₀ : ℤ) ≤ valL F L (traceLM F hLK y) :=
        hTraceBound (r₀ : ℤ) y hy_tr_cond
      set t : L := traceLM F hLK y
      have ht_ge1 : t = 0 ∨ 1 ≤ valL F L t := by
        rcases ht_cond with h0 | hval
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have ht_ne : 1 + t ≠ 0 := by
        rcases ht_ge1 with h0 | hval
        · rw [h0, add_zero]
          exact one_ne_zero
        · intro h1t
          have ht_eq_neg1 : t = -1 := eq_neg_of_add_eq_zero_right h1t
          rw [ht_eq_neg1, hval_neg1_L] at hval
          omega
      have ht_val0 : valL F L (1 + t) = 0 := by
        rcases ht_ge1 with h0 | hval
        · rw [h0, add_zero, hval1_L]
        · have h1t_int : 1 + t = 0 ∨ 0 ≤ valL F L (1 + t) := by
            apply hval_add_L 0 1 t (Or.inr (by rw [hval1_L]))
            exact Or.inr (by omega)
          have hge0 : 0 ≤ valL F L (1 + t) := h1t_int.resolve_left ht_ne
          by_contra hne0
          have hge1 : 1 ≤ valL F L (1 + t) := by omega
          have h1_ge1 : (1 : L) = 0 ∨ 1 ≤ valL F L 1 := by
            have heq : (1 : L) = (1 + t) - t := by ring
            rw [heq]
            exact hvalL_sub 1 (1 + t) t (Or.inr hge1) (Or.inr hval)
          rcases h1_ge1 with h10 | h1v
          · exact one_ne_zero h10
          · rw [hval1_L] at h1v
            omega
      have hy_ge1 : y = 0 ∨ 1 ≤ valL F K y := Or.inr (by omega)
      have hΔ_raw := hNormRem y hy_ge1
      set Δ : L := normLM F hLK (1 + y) - (1 + t)
      have hΔ_cond : Δ = 0 ∨ (a : ℤ) ≤ valL F L Δ := by
        rcases hΔ_raw with h0 | hval
        · exact Or.inl h0
        · right
          have h2R₀_ge : (ℓ : ℤ) * ((a : ℤ) - 1) + 1 ≤ 2 * (R₀ : ℤ) := by
            have h2R₀ : A ≤ 2 * R₀ := by
              change A ≤ 2 * ((A + 1) / 2)
              omega
            have hA_z : (A : ℤ) = (ℓ : ℤ) * ((a : ℤ) - 1) + 1 := by
              have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
              calc (A : ℤ) = ((ℓ * (a - 1) + 1 : ℕ) : ℤ) := congrArg Nat.cast hA_eq
                _ = (ℓ : ℤ) * ((a - 1 : ℕ) : ℤ) + 1 := by push_cast; ring
                _ = (ℓ : ℤ) * ((a : ℤ) - 1) + 1 := by rw [ha_sub]
            omega
          have hℓ_Δ : (ℓ : ℤ) * ((a : ℤ) - 1) + 1 ≤ (ℓ : ℤ) * valL F L Δ := by
            have : 2 * (R₀ : ℤ) ≤ 2 * valL F K y := by omega
            have hval' : 2 * valL F K y ≤ (ℓ : ℤ) * valL F L Δ := hval
            omega
          by_contra hlt
          have hle : valL F L Δ ≤ (a : ℤ) - 1 := by omega
          have hmul_le : (ℓ : ℤ) * valL F L Δ ≤ (ℓ : ℤ) * ((a : ℤ) - 1) :=
            mul_le_mul_of_nonneg_left hle (Nat.cast_nonneg ℓ)
          omega
      let u_t : Lˣ := Units.mk0 (1 + t) ht_ne
      let u_y : Lˣ := Units.map (normLM F hLK) (Units.mk0 (1 + y) hy)
      let u_Δ : Lˣ := u_t⁻¹ * u_y
      have hu_t_inv_val : valL F L ((u_t⁻¹ : Lˣ) : L) = 0 := by
        rw [hval_inv_L u_t]
        change - valL F L (1 + t) = 0
        rw [ht_val0, neg_zero]
      have hu_Δ_sub : (u_Δ : L) - 1 = ((u_t⁻¹ : Lˣ) : L) * Δ := by
        have hu_t_mul : ((u_t⁻¹ : Lˣ) : L) * (1 + t) = 1 := u_t.inv_mul
        have hu_y_coe : (u_y : L) = (1 + t) + Δ := by
          change normLM F hLK (1 + y) = (1 + t) + (normLM F hLK (1 + y) - (1 + t))
          ring
        calc (u_Δ : L) - 1 = ((u_t⁻¹ : Lˣ) : L) * (u_y : L) - ((u_t⁻¹ : Lˣ) : L) * (1 + t) := by
              rw [Units.val_mul, hu_t_mul]
          _ = ((u_t⁻¹ : Lˣ) : L) * ((1 + t) + Δ) - ((u_t⁻¹ : Lˣ) : L) * (1 + t) := by
              rw [hu_y_coe]
          _ = ((u_t⁻¹ : Lˣ) : L) * Δ := by ring
      have hu_Δ_mem : u_Δ ∈ unitGroup F L a := by
        apply (hunit_ge1_L a (by omega) u_Δ).mpr
        rcases hΔ_cond with h0 | hval
        · left
          apply sub_eq_zero.mp
          rw [hu_Δ_sub, h0, mul_zero]
        · by_cases hΔ0 : Δ = 0
          · left
            apply sub_eq_zero.mp
            rw [hu_Δ_sub, hΔ0, mul_zero]
          · right
            rw [hu_Δ_sub, hval_mul_L ((u_t⁻¹ : Lˣ) : L) Δ (Units.ne_zero _) hΔ0,
              hu_t_inv_val, zero_add]
            exact hval
      have hχ'_uΔ : χ' u_Δ = 1 := hχ'_cond0 u_Δ hu_Δ_mem
      have hu_y_eq : u_y = u_t * u_Δ := (mul_inv_cancel_left u_t u_y).symm
      have hχ'_uy : (χ' u_y : Ω F) = (χ' u_t : Ω F) := by
        rw [hu_y_eq, map_mul, hχ'_uΔ, mul_one]
      have hstat_t : (χ' u_t : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * t) :=
        hc_stat t ht_cond ht_ne
      have hψ_eq : ψ (((c_χ'⁻¹ : Lˣ) : L) * t) =
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y) := by
        unfold traceChar
        rw [AddChar.compAddMonoidHom_apply, hc_K_inv, htrace_smul ((c_χ'⁻¹ : Lˣ) : L) y]
      exact hχ'_uy.trans (hstat_t.trans hψ_eq)
  exact ⟨heps_K1, heps_L0, hν_triv_d, liftL, R_L, R_K, c_K,
    hliftL, hRL_int, hRL_dist, hRL_mod, hRL_card, hRL_sum,
    hRK_int, hRK_dist, hRK_mod, hRK_card, hRK_sum,
    hc_K_inv, hA2, hcK_val, hcK_stat, hcK_χ, hcK_ψ⟩

theorem ld_tame_higher_cond_residue_chars_and_hasse_phases (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_triv1 : ∀ u ∈ unitGroup F L 1, ν₁ u = 1)
    (hν₁_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      j ≠ 0 → condExp F L (ν₁ ^ j) = 1)
    (hχ'_cond0 : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hValAlg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hCondψK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) = 1)
    (hν₁_ϖ : ν₁ (Units.map (normLM F hLK) ϖ_K) = 1)
    (hϖ_deg2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2 →
      traceLM F hLK (ϖ_K : K) = 0 ∧
      (ϖ_K : K) ^ 2 = - IntermediateField.inclusion hLK ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L))
    (hResSurj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)))
    (ha2 : 2 ≤ condExp F L χ')
    (hCondχ'K : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      Module.finrank L (IntermediateField.extendScalars hLK) * (condExp F L χ' - 1) + 1)
    (hvalL : valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK : valL F K 0 = 0 ∧
      valL F K 1 = 0 ∧
      valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L ν₁ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L ν₁), ν₁ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L ν₁ - 1), ν₁ u₀ ≠ 1)))
    (hSpecK : (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        (traceChar F hLK ψ) y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        (traceChar F hLK ψ) y₁ ≠ 1))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hGauss1 : ∀ (j : ℕ), j < Module.finrank L (IntermediateField.extendScalars hLK) →
      j ≠ 0 →
      ∀ (c_M : Lˣ), valL F L (c_M : L) = 1 + condExpChar F L ψ →
      ∀ (χ_tilde ψ_tilde : k_L → Ω F),
        χ_tilde 0 = 0 →
        (∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde (resL (u : L)) = ((ν₁ ^ j) u : Ω F)⁻¹) →
        (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
          ψ_tilde (resL x) = ψ (((c_M⁻¹ : Lˣ) : L) * x)) →
        tateEps F L (ν₁ ^ j) ψ =
          (qL F L : Ω F) ^ condExpChar F L ψ * ((ν₁ ^ j) c_M : Ω F) *
            (∑ a : k_L, χ_tilde a * ψ_tilde a))
    (heps_L0 : tateEps F L (ν₁ ^ 0) ψ = (qL F L : Ω F) ^ condExpChar F L ψ)
    (liftL : k_L → L) (R_L : Finset L) (R_K : Finset K)
    (hliftL : ∀ b : k_L, (liftL b = 0 ∨ 0 ≤ valL F L (liftL b)) ∧ resL (liftL b) = b)
    (hRL_sum : ∀ g : L → Ω F, (∑ r ∈ R_L, g r) = ∑ b : k_L, g (liftL b))
    (hRK_sum : ∀ g_K : K → Ω F,
      (∑ r ∈ R_K, g_K r) = ∑ b : k_L, g_K (IntermediateField.inclusion hLK (liftL b)))
    (c_χ' : Lˣ) (c_K : Kˣ)
    (hc_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_K_inv : ((c_K⁻¹ : Kˣ) : K) = IntermediateField.inclusion hLK ((c_χ'⁻¹ : Lˣ) : L)) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
    let a := condExp F L χ'
    let d := a / 2
    let A := condExp F K (χ'.comp (Units.map (normLM F hLK)))
    let D := A / 2
    (ℓ : k_L) ≠ 0 ∧
    ∃ (ν_tilde ψ_1 : k_L → Ω F),
      ν_tilde 0 = 0 ∧
      ν_tilde 1 = 1 ∧
      (∀ x y : k_L, ν_tilde (x * y) = ν_tilde x * ν_tilde y) ∧
      (∀ x : k_L, x ≠ 0 → (ν_tilde x) ^ ℓ = 1) ∧
      (∃ x₀ : k_L, x₀ ≠ 0 ∧ ν_tilde x₀ ≠ 1) ∧
      ψ_1 0 = 1 ∧
      (∀ x y : k_L, ψ_1 (x + y) = ψ_1 x * ψ_1 y) ∧
      (∃ x₀ : k_L, ψ_1 x₀ ≠ 1) ∧
      (ℓ ≠ 2 →
        (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
          ((qL F L : Ω F) ^ condExpChar F L ψ) ^ ℓ *
            (∏ j ∈ (Finset.range ℓ).erase 0, (ν₁ c_χ' : Ω F) ^ j) *
            (∏ j ∈ (Finset.range ℓ).erase 0, (∑ b : k_L, (ν_tilde b) ^ j * ψ_1 b))) ∧
      (ℓ = 2 →
        (a % 2 = 0 →
          (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
            ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              (ν₁ c_χ' : Ω F) * ν_tilde (-1) *
              (∑ b : k_L, ν_tilde b * ψ_1 b)) ∧
        (a % 2 = 1 →
          (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
            ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              (ν₁ c_χ' : Ω F) *
              (∑ b : k_L, ν_tilde b * ψ_1 b))) ∧
      (a % 2 = 1 →
        ∃ (δ_L : Lˣ) (δ_K : Kˣ) (φ_L : k_L → Ω F),
          valL F L (δ_L : L) = (d : ℤ) ∧
          valL F K (δ_K : K) = (D : ℤ) ∧
          φ_L 0 = 1 ∧
          (∀ x y : k_L, φ_L (x + y) = φ_L x * φ_L y * ψ_1 (x * y)) ∧
          (∑ r ∈ R_L,
            if hr : 1 + (δ_L : L) * r ≠ 0 then
              (χ' (Units.mk0 (1 + (δ_L : L) * r) hr) : Ω F)⁻¹ *
                ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * r)
            else 0) = (∑ b : k_L, φ_L b) ∧
          (∑ r ∈ R_K,
            if hr : 1 + (δ_K : K) * r ≠ 0 then
              ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + (δ_K : K) * r) hr) : Ω F)⁻¹ *
                (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * r)
            else 0) = (∑ b : k_L, (φ_L b) ^ ℓ)) ∧
      (ℓ = 2 → a % 2 = 0 →
        ∃ (δ_L : Lˣ) (δ_K2 : Kˣ),
          valL F L (δ_L : L) = (d : ℤ) ∧
          valL F K (δ_K2 : K) = (D : ℤ) ∧
          (∑ r ∈ R_K,
            if hr : 1 + (δ_K2 : K) * r ≠ 0 then
              ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + (δ_K2 : K) * r) hr) : Ω F)⁻¹ *
                (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K2 : K) * r)
            else 0) = (∑ b : k_L, ψ_1 (b ^ 2))) :=
by
  classical
  have hnorm_deg2_gen : ∀ (E : Type u) [Field E] (M : Type u) [Field M] [Algebra E M],
      Module.finrank E M = 2 →
      ∀ (w' : M) (π : E), w' ^ 2 = algebraMap E M π →
      (∀ c : E, c • (1 : M) ≠ w') →
      ∀ a₀ : E, Algebra.norm E ((1 : M) + a₀ • w') = 1 - a₀ ^ 2 * π := by
    clear * -
    intro E _ M _ _ hℓ2 w' π hw_sq hnot_in a₀
    have hlin : LinearIndependent E ![(1 : M), w'] := by
      rw [LinearIndependent.pair_iff' (one_ne_zero : (1 : M) ≠ 0)]
      exact hnot_in
    let B : Module.Basis (Fin 2) E M :=
      basisOfLinearIndependentOfCardEqFinrank hlin (by simp [hℓ2])
    have hB0 : B 0 = 1 := by
      rw [coe_basisOfLinearIndependentOfCardEqFinrank]
      rfl
    have hB1 : B 1 = w' := by
      rw [coe_basisOfLinearIndependentOfCardEqFinrank]
      rfl
    have h01 : (0 : Fin 2) ≠ 1 := by decide
    have h10 : (1 : Fin 2) ≠ 0 := by decide
    set z : M := (1 : M) + a₀ • w'
    have hz0 : z * B 0 = (1 : E) • B 0 + a₀ • B 1 := by
      dsimp only [z]
      rw [hB0, hB1, mul_one, one_smul]
    have hz1 : z * B 1 = (a₀ * π) • B 0 + (1 : E) • B 1 := by
      dsimp only [z]
      rw [hB0, hB1, add_mul, one_mul, smul_mul_assoc, ← sq, hw_sq,
        Algebra.algebraMap_eq_smul_one, smul_smul, one_smul, add_comm]
    have hrepr00 : (B.repr (z * B 0)) 0 = 1 := by
      rw [hz0, map_add, map_smul, map_smul, B.repr_self, B.repr_self,
        Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply,
        Finsupp.single_eq_same, Finsupp.single_eq_of_ne h01, smul_eq_mul, smul_eq_mul]
      ring
    have hrepr01 : (B.repr (z * B 0)) 1 = a₀ := by
      rw [hz0, map_add, map_smul, map_smul, B.repr_self, B.repr_self,
        Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply,
        Finsupp.single_eq_of_ne h10, Finsupp.single_eq_same, smul_eq_mul, smul_eq_mul]
      ring
    have hrepr10 : (B.repr (z * B 1)) 0 = a₀ * π := by
      rw [hz1, map_add, map_smul, map_smul, B.repr_self, B.repr_self,
        Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply,
        Finsupp.single_eq_same, Finsupp.single_eq_of_ne h01, smul_eq_mul, smul_eq_mul]
      ring
    have hrepr11 : (B.repr (z * B 1)) 1 = 1 := by
      rw [hz1, map_add, map_smul, map_smul, B.repr_self, B.repr_self,
        Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply,
        Finsupp.single_eq_of_ne h10, Finsupp.single_eq_same, smul_eq_mul, smul_eq_mul]
      ring
    rw [Algebra.norm_eq_matrix_det B, Matrix.det_fin_two,
      Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul,
      Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul,
      hrepr00, hrepr11, hrepr10, hrepr01]
    ring
  have htrace_deg2_gen : ∀ (E : Type u) [Field E] (M : Type u) [Field M] [Algebra E M],
      ∀ (w' : M), Algebra.trace E M w' = 0 →
      ∀ c : E, Algebra.trace E M (c • w') = 0 := by
    clear * -
    intro E _ M _ _ w' hw c
    rw [LinearMap.map_smul, hw, smul_zero]
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
  set a := condExp F L χ'
  set d := a / 2
  set A := condExp F K (χ'.comp (Units.map (normLM F hLK)))
  set D := A / 2
  have hℓ_ge2 : 2 ≤ ℓ := hPrime.two_le
  have hℓ_pos : 0 < ℓ := hPrime.pos
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, _, hval_add_K,
    hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := hvalK
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, hν₁_cond_spec⟩ := hSpecL
  obtain ⟨hψK_triv, ⟨y₁, hy₁_ne, hy₁_val, hy₁_ψK⟩⟩ := hSpecK

  have hvalL_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    have hneg₂ : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_L k x₁ (-x₂) hx₁ hneg₂

  have hvalK_sub : ∀ (k : ℤ) (y₁ y₂ : K),
      (y₁ = 0 ∨ k ≤ valL F K y₁) → (y₂ = 0 ∨ k ≤ valL F K y₂) →
        (y₁ - y₂ = 0 ∨ k ≤ valL F K (y₁ - y₂)) := by
    intro k y₁ y₂ hy₁ hy₂
    have hneg₂ : -y₂ = 0 ∨ k ≤ valL F K (-y₂) := by
      rcases hy₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_K]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_K k y₁ (-y₂) hy₁ hneg₂

  have hvalL_mul_int : ∀ (x₁ x₂ : L) (k₁ k₂ : ℤ),
      (x₁ = 0 ∨ k₁ ≤ valL F L x₁) → (x₂ = 0 ∨ k₂ ≤ valL F L x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ k₁ k₂ hx₁ hx₂
    by_cases hx₁0 : x₁ = 0
    · left; rw [hx₁0, zero_mul]
    · by_cases hx₂0 : x₂ = 0
      · left; rw [hx₂0, mul_zero]
      · right
        have h1 := hx₁.resolve_left hx₁0
        have h2 := hx₂.resolve_left hx₂0
        rw [hval_mul_L x₁ x₂ hx₁0 hx₂0]
        omega

  have hvalK_mul_int : ∀ (y₁ y₂ : K) (k₁ k₂ : ℤ),
      (y₁ = 0 ∨ k₁ ≤ valL F K y₁) → (y₂ = 0 ∨ k₂ ≤ valL F K y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F K (y₁ * y₂)) := by
    intro y₁ y₂ k₁ k₂ hy₁ hy₂
    by_cases hy₁0 : y₁ = 0
    · left; rw [hy₁0, zero_mul]
    · by_cases hy₂0 : y₂ = 0
      · left; rw [hy₂0, mul_zero]
      · right
        have h1 := hy₁.resolve_left hy₁0
        have h2 := hy₂.resolve_left hy₂0
        rw [hval_mul_K y₁ y₂ hy₁0 hy₂0]
        omega

  have hvalL_pow_unit : ∀ (u : Lˣ) (m : ℕ),
      valL F L ((u ^ m : Lˣ) : L) = (m : ℤ) * valL F L (u : L) := by
    intro u m
    induction m with
    | zero =>
      rw [pow_zero, Units.val_one, hval1_L, Nat.cast_zero, zero_mul]
    | succ m ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul_L ((u ^ m : Lˣ) : L) (u : L) (Units.ne_zero _) (Units.ne_zero _),
        ih, Nat.cast_succ]
      ring

  have hvalK_pow_unit : ∀ (u : Kˣ) (m : ℕ),
      valL F K ((u ^ m : Kˣ) : K) = (m : ℤ) * valL F K (u : K) := by
    intro u m
    induction m with
    | zero =>
      rw [pow_zero, Units.val_one, hval1_K, Nat.cast_zero, zero_mul]
    | succ m ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul_K ((u ^ m : Kˣ) : K) (u : K) (Units.ne_zero _) (Units.ne_zero _),
        ih, Nat.cast_succ]
      ring

  
  set ϖ_L : Lˣ := Units.map (normLM F hLK) ϖ_K
  set π_L : Lˣ := if ℓ = 2 then -ϖ_L else ϖ_L
  have hπ_L : valL F L (π_L : L) = 1 := by
    dsimp only [π_L]
    split_ifs with hℓ2
    · rw [Units.val_neg, hval_neg_L, hϖ_L]
    · exact hϖ_L
  have hπ_pow_val : ∀ m : ℕ, valL F L ((π_L ^ m : Lˣ) : L) = (m : ℤ) := by
    intro m
    rw [hvalL_pow_unit, hπ_L, mul_one]
  have hϖK_pow_val : ∀ m : ℕ, valL F K ((ϖ_K ^ m : Kˣ) : K) = (m : ℤ) := by
    intro m
    rw [hvalK_pow_unit, hϖ_K, mul_one]
  have hπ_odd : ℓ ≠ 2 → ν₁ π_L = 1 := by
    intro h
    dsimp only [π_L]
    rw [if_neg h, hν₁_ϖ]
  have hπ_even : ℓ = 2 → ν₁ π_L = ν₁ (-1) := by
    intro h
    dsimp only [π_L]
    rw [if_pos h, ← neg_one_mul, map_mul, hν₁_ϖ, mul_one]
  have hϖ_sq_π : ℓ = 2 →
      traceLM F hLK (ϖ_K : K) = 0 ∧
      (ϖ_K : K) ^ 2 = IntermediateField.inclusion hLK (π_L : L) := by
    intro h
    obtain ⟨htr, hsq⟩ := hϖ_deg2 h
    refine ⟨htr, ?_⟩
    dsimp only [π_L]
    rw [if_pos h, Units.val_neg, map_neg]
    exact hsq

  set c₁ : Lˣ := c_χ' * (π_L ^ (a - 1))⁻¹
  have hc₁_inv_eq : c₁⁻¹ = c_χ'⁻¹ * (π_L ^ (a - 1)) := by
    dsimp only [c₁]
    rw [mul_inv_rev, inv_inv, mul_comm]
  have hc₁_inv_coe : ((c₁⁻¹ : Lˣ) : L) = ((c_χ'⁻¹ : Lˣ) : L) * ((π_L ^ (a - 1) : Lˣ) : L) := by
    rw [hc₁_inv_eq, Units.val_mul]
  have hc₁_val : valL F L (c₁ : L) = 1 + condExpChar F L ψ := by
    dsimp only [c₁]
    rw [Units.val_mul,
      hval_mul_L (c_χ' : L) (((π_L ^ (a - 1))⁻¹ : Lˣ) : L) (Units.ne_zero _) (Units.ne_zero _),
      hc_val, hval_inv_L, hπ_pow_val]
    omega

  
  have hliftL_int : ∀ b : k_L, liftL b = 0 ∨ 0 ≤ valL F L (liftL b) :=
    fun b => (hliftL b).1
  have hliftL_res : ∀ b : k_L, resL (liftL b) = b :=
    fun b => (hliftL b).2
  have hliftL_ne : ∀ b : k_L, b ≠ 0 → liftL b ≠ 0 := by
    intro b hb h0
    apply hb
    rw [← hliftL_res b, h0, hresL_0]
  have hliftL_val0 : ∀ b : k_L, b ≠ 0 → valL F L (liftL b) = 0 := by
    intro b hb
    have hge0 : 0 ≤ valL F L (liftL b) := (hliftL_int b).resolve_left (hliftL_ne b hb)
    by_contra hne
    have hge1 : 1 ≤ valL F L (liftL b) := by omega
    have hres0 : resL (liftL b) = 0 := (hresL_ker (liftL b) (hliftL_int b)).mpr (Or.inr hge1)
    rw [hliftL_res b] at hres0
    exact hb hres0

  set ψ_1 : k_L → Ω F := fun b => ψ (((c₁⁻¹ : Lˣ) : L) * liftL b)
  have hψ1_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_1 (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x) := by
    intro x hx_int
    set b : k_L := resL x
    set dx : L := x - liftL b
    have hdx_int : dx = 0 ∨ 0 ≤ valL F L dx :=
      hvalL_sub 0 x (liftL b) hx_int (hliftL_int b)
    have hneg_lift_int : -(liftL b) = 0 ∨ 0 ≤ valL F L (-(liftL b)) := by
      rcases hliftL_int b with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_L]; exact hge
    have hdx_res : resL dx = 0 := by
      dsimp only [dx]
      rw [sub_eq_add_neg, (hresL_ring x (-(liftL b)) hx_int hneg_lift_int).1,
        (hresL_ring (liftL b) (liftL b) (hliftL_int b) (hliftL_int b)).2.2, hliftL_res b,
        add_neg_cancel]
    have hdx1 : dx = 0 ∨ 1 ≤ valL F L dx := (hresL_ker dx hdx_int).mp hdx_res
    set wx : L := ((c₁⁻¹ : Lˣ) : L) * dx
    have hwx_cond : wx = 0 ∨ -condExpChar F L ψ ≤ valL F L wx := by
      by_cases hdx0 : dx = 0
      · left; dsimp only [wx]; rw [hdx0, mul_zero]
      · right
        have hdx_ge1 : 1 ≤ valL F L dx := hdx1.resolve_left hdx0
        dsimp only [wx]
        rw [hval_mul_L ((c₁⁻¹ : Lˣ) : L) dx (Units.ne_zero _) hdx0, hval_inv_L c₁, hc₁_val]
        omega
    have hψ_wx : ψ wx = 1 := hψ_triv wx hwx_cond
    have hx_decomp : ((c₁⁻¹ : Lˣ) : L) * x = ((c₁⁻¹ : Lˣ) : L) * liftL b + wx := by
      dsimp only [wx, dx]; ring
    rw [hx_decomp, ψ.map_add_eq_mul, hψ_wx, mul_one]

  have hψ1_spec : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_1 (resL x) = ψ (((c_χ'⁻¹ : Lˣ) : L) * ((π_L ^ (a - 1) : Lˣ) : L) * x) := by
    intro x hx
    rw [hψ1_int x hx, hc₁_inv_coe]

  have hψ1_0 : ψ_1 0 = 1 := by
    rw [← hresL_0, hψ1_int 0 (Or.inl rfl), mul_zero, ψ.map_zero_eq_one]

  have hψ1_add : ∀ x y : k_L, ψ_1 (x + y) = ψ_1 x * ψ_1 y := by
    intro x y
    have hxy_int : liftL x + liftL y = 0 ∨ 0 ≤ valL F L (liftL x + liftL y) :=
      hval_add_L 0 (liftL x) (liftL y) (hliftL_int x) (hliftL_int y)
    have hxy_res : resL (liftL x + liftL y) = x + y := by
      rw [(hresL_ring (liftL x) (liftL y) (hliftL_int x) (hliftL_int y)).1,
        hliftL_res x, hliftL_res y]
    rw [← hxy_res, hψ1_int (liftL x + liftL y) hxy_int, mul_add, ψ.map_add_eq_mul]

  have hψ1_ne : ∃ x₀ : k_L, ψ_1 x₀ ≠ 1 := by
    set z₁ : L := (c₁ : L) * x₁
    have hz₁_val : 0 ≤ valL F L z₁ := by
      dsimp only [z₁]
      rw [hval_mul_L (c₁ : L) x₁ (Units.ne_zero c₁) hx₁_ne, hc₁_val]
      omega
    have hinv_c₁ : ((c₁⁻¹ : Lˣ) : L) * (c₁ : L) = 1 := by exact_mod_cast Units.inv_mul c₁
    refine ⟨resL z₁, ?_⟩
    rw [hψ1_int z₁ (Or.inr hz₁_val)]
    dsimp only [z₁]
    rw [← mul_assoc, hinv_c₁, one_mul]
    exact hx₁_ψ

  
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = x ^ ℓ
    rw [hto_inc x]
    exact Algebra.norm_algebraMap x
  have htrace_inc : ∀ x : L,
      traceLM F hLK (IntermediateField.inclusion hLK x) = (ℓ : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = (ℓ : L) * x
    rw [hto_inc x, Algebra.trace_algebraMap x, nsmul_eq_mul]

  
  have hnat_int_resL : ∀ m : ℕ,
      ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      refine ⟨Or.inl (Nat.cast_zero), ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ m ih =>
      have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hval1_L])
      have hm1_int : ((m : L) + 1) = 0 ∨ 0 ≤ valL F L ((m : L) + 1) :=
        hval_add_L 0 (m : L) 1 ih.1 h1_int
      refine ⟨by simpa [Nat.cast_succ] using hm1_int, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1, Nat.cast_succ]

  set c₁_K : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom c₁
  have hc₁_K_coe : (c₁_K : K) = IntermediateField.inclusion hLK (c₁ : L) := rfl
  have hc₁_K_inv_coe : ((c₁_K⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_K_val : valL F K (c₁_K : K) = 1 + condExpChar F K (traceChar F hLK ψ) := by
    rw [hc₁_K_coe, hValAlg (c₁ : L), hc₁_val, hCondψK]
    ring

  have hNeChar : (ℓ : k_L) ≠ 0 := by
    intro hℓ0
    set y₀ : K := (c₁_K : K) * y₁
    have hy₀_val : 0 ≤ valL F K y₀ := by
      dsimp only [y₀]
      rw [hval_mul_K (c₁_K : K) y₁ (Units.ne_zero c₁_K) hy₁_ne, hc₁_K_val]
      omega
    obtain ⟨x₀, hx₀_int, hy₀_x₀⟩ := hResSurj y₀ (Or.inr hy₀_val)
    set z : K := y₀ - IntermediateField.inclusion hLK x₀
    set wz : K := ((c₁_K⁻¹ : Kˣ) : K) * z
    have hwz_cond : wz = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K wz := by
      by_cases hz0 : z = 0
      · left; dsimp only [wz]; rw [hz0, mul_zero]
      · right
        have hz_ge1 : 1 ≤ valL F K z := hy₀_x₀.resolve_left hz0
        dsimp only [wz]
        rw [hval_mul_K ((c₁_K⁻¹ : Kˣ) : K) z (Units.ne_zero _) hz0, hval_inv_K c₁_K, hc₁_K_val]
        omega
    have hψK_wz : (traceChar F hLK ψ) wz = 1 := hψK_triv wz hwz_cond
    have hinv_c₁K : ((c₁_K⁻¹ : Kˣ) : K) * (c₁_K : K) = 1 := by exact_mod_cast Units.inv_mul c₁_K
    have hy₁_decomp : y₁ = IntermediateField.inclusion hLK (((c₁⁻¹ : Lˣ) : L) * x₀) + wz := by
      have hy₁_eq : y₁ = ((c₁_K⁻¹ : Kˣ) : K) * y₀ := by
        dsimp only [y₀]
        rw [← mul_assoc, hinv_c₁K, one_mul]
      rw [hy₁_eq]
      dsimp only [wz, z]
      rw [hc₁_K_inv_coe, map_mul]
      ring
    have htr_inc_cx₀ :
        (traceChar F hLK ψ) (IntermediateField.inclusion hLK (((c₁⁻¹ : Lˣ) : L) * x₀)) =
          ψ (((c₁⁻¹ : Lˣ) : L) * ((ℓ : L) * x₀)) := by
      change ψ (traceLM F hLK (IntermediateField.inclusion hLK (((c₁⁻¹ : Lˣ) : L) * x₀))) = _
      rw [htrace_inc]
      congr 1
      ring
    have hℓ_int : (ℓ : L) = 0 ∨ 0 ≤ valL F L (ℓ : L) := (hnat_int_resL ℓ).1
    have hℓ_res : resL (ℓ : L) = (ℓ : k_L) := (hnat_int_resL ℓ).2
    have hℓx₀_int : (ℓ : L) * x₀ = 0 ∨ 0 ≤ valL F L ((ℓ : L) * x₀) := by
      simpa using hvalL_mul_int (ℓ : L) x₀ 0 0 hℓ_int hx₀_int
    have hℓx₀_res : resL ((ℓ : L) * x₀) = (ℓ : k_L) * resL x₀ := by
      rw [(hresL_ring (ℓ : L) x₀ hℓ_int hx₀_int).2.1, hℓ_res]
    have heval : (traceChar F hLK ψ) y₁ = 1 := by
      rw [hy₁_decomp, (traceChar F hLK ψ).map_add_eq_mul, hψK_wz, mul_one, htr_inc_cx₀,
        ← hψ1_int ((ℓ : L) * x₀) hℓx₀_int, hℓx₀_res, hℓ0, zero_mul, hψ1_0]
    exact hy₁_ψK heval

  
  set ν_tilde : k_L → Ω F := fun b =>
    if hb : b = 0 then 0 else (ν₁ (Units.mk0 (liftL b) (hliftL_ne b hb)) : Ω F)⁻¹

  have hν_unit : ∀ u : Lˣ, valL F L (u : L) = 0 →
      ν_tilde (resL (u : L)) = (ν₁ u : Ω F)⁻¹ := by
    intro u hu_val
    have hu_int : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
    set b : k_L := resL (u : L)
    have hb_ne : b ≠ 0 := by
      intro hb0
      rcases (hresL_ker (u : L) hu_int).mp hb0 with h0 | hge1
      · exact Units.ne_zero u h0
      · omega
    set vu : Lˣ := Units.mk0 (liftL b) (hliftL_ne b hb_ne)
    have hvu_val0 : valL F L (vu : L) = 0 := hliftL_val0 b hb_ne
    have hvu_int : (vu : L) = 0 ∨ 0 ≤ valL F L (vu : L) := hliftL_int b
    set du : L := (u : L) - (vu : L)
    have hdu_int : du = 0 ∨ 0 ≤ valL F L du := hvalL_sub 0 (u : L) (vu : L) hu_int hvu_int
    have hneg_vu_int : -(vu : L) = 0 ∨ 0 ≤ valL F L (-(vu : L)) := by
      right; rw [hval_neg_L, hvu_val0]
    have hdu_res : resL du = 0 := by
      dsimp only [du]
      rw [sub_eq_add_neg, (hresL_ring (u : L) (-(vu : L)) hu_int hneg_vu_int).1,
        (hresL_ring (vu : L) (vu : L) hvu_int hvu_int).2.2]
      change b + -resL (liftL b) = 0
      rw [hliftL_res b, add_neg_cancel]
    have hdu1 : du = 0 ∨ 1 ≤ valL F L du := (hresL_ker du hdu_int).mp hdu_res
    set hu_q : Lˣ := vu⁻¹ * u
    have hhu_sub : (hu_q : L) - 1 = ((vu⁻¹ : Lˣ) : L) * du := by
      have hinv : ((vu⁻¹ : Lˣ) : L) * (vu : L) = 1 := by exact_mod_cast Units.inv_mul vu
      calc (hu_q : L) - 1 = ((vu⁻¹ : Lˣ) : L) * (u : L) - ((vu⁻¹ : Lˣ) : L) * (vu : L) := by
            rw [Units.val_mul, hinv]
        _ = ((vu⁻¹ : Lˣ) : L) * du := by dsimp only [du]; ring
    have hhu_mem : hu_q ∈ unitGroup F L 1 := by
      rw [hunit_ge1_L 1 le_rfl hu_q]
      by_cases hdu0 : du = 0
      · left
        have hsub0 : (hu_q : L) - 1 = 0 := by rw [hhu_sub, hdu0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hdu_ge1 : 1 ≤ valL F L du := hdu1.resolve_left hdu0
        rw [hhu_sub, hval_mul_L ((vu⁻¹ : Lˣ) : L) du (Units.ne_zero _) hdu0,
          hval_inv_L vu, hvu_val0]
        omega
    have hν₁_hu : ν₁ hu_q = 1 := hν₁_triv1 hu_q hhu_mem
    have hν₁_u : ν₁ u = ν₁ vu := by
      have huv : vu * hu_q = u := mul_inv_cancel_left vu u
      rw [← huv, map_mul, hν₁_hu, mul_one]
    dsimp only [ν_tilde]
    rw [dif_neg hb_ne, hν₁_u]

  have hν_0 : ν_tilde 0 = 0 := dif_pos rfl

  have hν_1 : ν_tilde 1 = 1 := by
    have h1 := hν_unit 1 (by rw [Units.val_one, hval1_L])
    rw [Units.val_one, hresL_1, map_one, Units.val_one, inv_one] at h1
    exact h1

  have hν_mul : ∀ x y : k_L, ν_tilde (x * y) = ν_tilde x * ν_tilde y := by
    intro x y
    by_cases hx : x = 0
    · rw [hx, zero_mul, hν_0, zero_mul]
    · by_cases hy : y = 0
      · rw [hy, mul_zero, hν_0, mul_zero]
      · set ux : Lˣ := Units.mk0 (liftL x) (hliftL_ne x hx)
        set uy : Lˣ := Units.mk0 (liftL y) (hliftL_ne y hy)
        have hux_val : valL F L (ux : L) = 0 := hliftL_val0 x hx
        have huy_val : valL F L (uy : L) = 0 := hliftL_val0 y hy
        have huxy_val : valL F L ((ux * uy : Lˣ) : L) = 0 := by
          rw [Units.val_mul, hval_mul_L (ux : L) (uy : L) (Units.ne_zero _) (Units.ne_zero _),
            hux_val, huy_val, add_zero]
        have huxy_res : resL ((ux * uy : Lˣ) : L) = x * y := by
          change resL (liftL x * liftL y) = x * y
          rw [(hresL_ring (liftL x) (liftL y) (hliftL_int x) (hliftL_int y)).2.1,
            hliftL_res x, hliftL_res y]
        have hxy := hν_unit (ux * uy) huxy_val
        have hx' := hν_unit ux hux_val
        have hy' := hν_unit uy huy_val
        have hux_res : resL (ux : L) = x := hliftL_res x
        have huy_res : resL (uy : L) = y := hliftL_res y
        rw [huxy_res, map_mul, Units.val_mul, mul_inv] at hxy
        rw [hux_res] at hx'
        rw [huy_res] at hy'
        rw [hxy, hx', hy']

  have hν_pow : ∀ x : k_L, x ≠ 0 → (ν_tilde x) ^ ℓ = 1 := by
    intro x hx
    set ux : Lˣ := Units.mk0 (liftL x) (hliftL_ne x hx)
    have hux := hν_unit ux (hliftL_val0 x hx)
    have hux_res : resL (ux : L) = x := hliftL_res x
    rw [hux_res] at hux
    rw [hux, inv_pow, ← Units.val_pow_eq_pow_val, ← MonoidHom.pow_apply, hν₁_pow,
      MonoidHom.one_apply, Units.val_one, inv_one]

  have hν_ne : ∃ x₀ : k_L, x₀ ≠ 0 ∧ ν_tilde x₀ ≠ 1 := by
    have hν₁_pow1 : ν₁ ^ 1 = ν₁ := by
      apply MonoidHom.ext
      intro u
      rw [MonoidHom.pow_apply, pow_one]
    have hcond_ν₁ : condExp F L ν₁ = 1 := by
      have h1 := hν₁_cond_eq 1 hPrime.one_lt one_ne_zero
      rwa [hν₁_pow1] at h1
    obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := (hν₁_cond_spec (by omega)).2
    rw [hcond_ν₁] at hu₀_mem
    have hu₀_val0 : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀_mem
    have hu₀_int : (u₀ : L) = 0 ∨ 0 ≤ valL F L (u₀ : L) := Or.inr (by omega)
    have hres_u₀_ne : resL (u₀ : L) ≠ 0 := by
      intro h0
      rcases (hresL_ker (u₀ : L) hu₀_int).mp h0 with h1 | h2
      · exact Units.ne_zero u₀ h1
      · omega
    refine ⟨resL (u₀ : L), hres_u₀_ne, ?_⟩
    rw [hν_unit u₀ hu₀_val0]
    intro hinv1
    have hval1 : (ν₁ u₀ : Ω F) = 1 := inv_eq_one.mp hinv1
    exact hu₀_ne (Units.ext hval1)

  
  have hGauss_j : ∀ j ∈ (Finset.range ℓ).erase 0,
      tateEps F L (ν₁ ^ j) ψ =
        (qL F L : Ω F) ^ condExpChar F L ψ *
          ((ν₁ c₁ : Ω F) ^ j * (∑ b : k_L, (ν_tilde b) ^ j * ψ_1 b)) := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < ℓ := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hχj_0 : (ν_tilde 0) ^ j = 0 := by rw [hν_0, zero_pow hj_ne0]
    have hχj_unit : ∀ u : Lˣ, valL F L (u : L) = 0 →
        (ν_tilde (resL (u : L))) ^ j = ((ν₁ ^ j) u : Ω F)⁻¹ := by
      intro u hu
      rw [hν_unit u hu, inv_pow, MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
    have hG := hGauss1 j hj_lt hj_ne0 c₁ hc₁_val (fun b => (ν_tilde b) ^ j) ψ_1
      hχj_0 hχj_unit hψ1_int
    rw [hG, MonoidHom.pow_apply, Units.val_pow_eq_pow_val, mul_assoc]

  have hprod_gen :
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
        ((qL F L : Ω F) ^ condExpChar F L ψ) ^ ℓ *
          (∏ j ∈ (Finset.range ℓ).erase 0, (ν₁ c₁ : Ω F) ^ j) *
          (∏ j ∈ (Finset.range ℓ).erase 0, (∑ b : k_L, (ν_tilde b) ^ j * ψ_1 b)) := by
    have h0_mem : 0 ∈ Finset.range ℓ := Finset.mem_range.mpr hℓ_pos
    rw [← Finset.mul_prod_erase (Finset.range ℓ) (fun j => tateEps F L (ν₁ ^ j) ψ) h0_mem,
      heps_L0, Finset.prod_congr rfl hGauss_j, Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_const, Finset.card_erase_of_mem h0_mem, Finset.card_range,
      ← mul_assoc, ← mul_assoc, ← pow_succ', Nat.sub_add_cancel hℓ_pos]

  have hprod_odd : ℓ ≠ 2 →
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
        ((qL F L : Ω F) ^ condExpChar F L ψ) ^ ℓ *
          (∏ j ∈ (Finset.range ℓ).erase 0, (ν₁ c_χ' : Ω F) ^ j) *
          (∏ j ∈ (Finset.range ℓ).erase 0, (∑ b : k_L, (ν_tilde b) ^ j * ψ_1 b)) := by
    intro hℓ2
    have hν₁_c₁ : ν₁ c₁ = ν₁ c_χ' := by
      dsimp only [c₁]
      rw [map_mul, map_inv, map_pow, hπ_odd hℓ2, one_pow, inv_one, mul_one]
    rw [hprod_gen, hν₁_c₁]

  have hprod_deg2 : ℓ = 2 →
      (a % 2 = 0 →
        (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
          ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
            (ν₁ c_χ' : Ω F) * ν_tilde (-1) *
            (∑ b : k_L, ν_tilde b * ψ_1 b)) ∧
      (a % 2 = 1 →
        (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
          ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
            (ν₁ c_χ' : Ω F) *
            (∑ b : k_L, ν_tilde b * ψ_1 b)) := by
    intro hℓ2
    have h1_mem : (1 : ℕ) ∈ (Finset.range ℓ).erase 0 := by
      rw [hℓ2]
      decide
    have hG1 := hGauss_j 1 h1_mem
    have hprod_2 :
        (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
          ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
            (ν₁ c₁ : Ω F) *
            (∑ b : k_L, ν_tilde b * ψ_1 b) := by
      rw [hℓ2, Finset.prod_range_succ, Finset.prod_range_one, heps_L0, hG1]
      simp only [pow_one]
      ring
    have hres_neg1 : resL (((-1 : Lˣ) : L)) = -1 := by
      have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by rw [hval1_L])
      rw [Units.val_neg, Units.val_one, (hresL_ring 1 1 h1_int h1_int).2.2, hresL_1]
    have hν_neg1 : ν_tilde (-1) = (ν₁ (-1) : Ω F)⁻¹ := by
      rw [← hres_neg1]
      exact hν_unit (-1) (by rw [Units.val_neg, Units.val_one, hval_neg1_L])
    have hν_neg1_sq : (ν_tilde (-1)) ^ 2 = 1 := by
      rw [sq, ← hν_mul (-1) (-1), neg_one_mul, neg_neg, hν_1]
    have hν₁_c₁_eq : (ν₁ c₁ : Ω F) = (ν₁ c_χ' : Ω F) * (ν_tilde (-1)) ^ (a - 1) := by
      dsimp only [c₁]
      rw [map_mul, Units.val_mul, map_inv, map_pow, hπ_even hℓ2,
        Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val, ← inv_pow, ← hν_neg1]
    constructor
    · intro ha_even
      have ha_sub_odd : a - 1 = 2 * (a / 2 - 1) + 1 := by omega
      have hpow_odd : (ν_tilde (-1)) ^ (a - 1) = ν_tilde (-1) := by
        rw [ha_sub_odd, pow_add, pow_mul, hν_neg1_sq, one_pow, pow_one, one_mul]
      rw [hprod_2, hν₁_c₁_eq, hpow_odd]
      ring
    · intro ha_odd
      have ha_sub_even : a - 1 = 2 * (a / 2) := by omega
      have hpow_even : (ν_tilde (-1)) ^ (a - 1) = 1 := by
        rw [ha_sub_even, pow_mul, hν_neg1_sq, one_pow]
      rw [hprod_2, hν₁_c₁_eq, hpow_even, mul_one]

  
  have h1_add_p1_ne_val0_L : ∀ z : L, (z = 0 ∨ 1 ≤ valL F L z) →
      1 + z ≠ 0 ∧ valL F L (1 + z) = 0 := by
    intro z hz
    have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by rw [hval1_L])
    have hz_int : z = 0 ∨ 0 ≤ valL F L z := by
      rcases hz with rfl | hge1
      · left; rfl
      · right; omega
    have hne : 1 + z ≠ 0 := by
      intro h0
      have hz_neg1 : z = -1 := eq_neg_of_add_eq_zero_right h0
      rcases hz with rfl | hge1
      · exact one_ne_zero (neg_eq_zero.mp hz_neg1.symm)
      · rw [hz_neg1, hval_neg1_L] at hge1
        omega
    have hge0 : 0 ≤ valL F L (1 + z) := (hval_add_L 0 1 z h1_int hz_int).resolve_left hne
    refine ⟨hne, ?_⟩
    by_contra hne0
    have hge1 : 1 ≤ valL F L (1 + z) := by omega
    have h1_sub : (1 : L) = (1 + z) - z := by ring
    have h1_ge1 : (1 : L) = 0 ∨ 1 ≤ valL F L 1 := by
      rw [h1_sub]
      exact hvalL_sub 1 (1 + z) z (Or.inr hge1) hz
    rcases h1_ge1 with h10 | h1_val
    · exact one_ne_zero h10
    · rw [hval1_L] at h1_val
      omega

  have h1_add_p1_ne_K : ∀ z : K, (z = 0 ∨ 1 ≤ valL F K z) → 1 + z ≠ 0 := by
    intro z hz h0
    have hz_neg1 : z = -1 := eq_neg_of_add_eq_zero_right h0
    rcases hz with rfl | hge1
    · exact one_ne_zero (neg_eq_zero.mp hz_neg1.symm)
    · rw [hz_neg1, hval_neg1_K] at hge1
      omega

  have hχ'_eq_of_sub_val : ∀ (u v : Lˣ), valL F L (u : L) = 0 →
      ((v : L) - (u : L) = 0 ∨ (a : ℤ) ≤ valL F L ((v : L) - (u : L))) →
      χ' v = χ' u := by
    intro u v hu_val hsub
    set q_u : Lˣ := u⁻¹ * v
    have hq_sub : (q_u : L) - 1 = ((u⁻¹ : Lˣ) : L) * ((v : L) - (u : L)) := by
      have hinv : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := by exact_mod_cast Units.inv_mul u
      calc (q_u : L) - 1 = ((u⁻¹ : Lˣ) : L) * (v : L) - ((u⁻¹ : Lˣ) : L) * (u : L) := by
            rw [Units.val_mul, hinv]
        _ = ((u⁻¹ : Lˣ) : L) * ((v : L) - (u : L)) := by ring
    have hq_mem : q_u ∈ unitGroup F L a := by
      rw [hunit_ge1_L a (by omega) q_u]
      rcases hsub with hd0 | hd_ge
      · left
        have h0 : (q_u : L) - 1 = 0 := by rw [hq_sub, hd0, mul_zero]
        exact sub_eq_zero.mp h0
      · right
        have hd_ne : (v : L) - (u : L) ≠ 0 := by
          intro h0; rw [h0, hval0_L] at hd_ge; omega
        rw [hq_sub, hval_mul_L ((u⁻¹ : Lˣ) : L) _ (Units.ne_zero _) hd_ne, hval_inv_L u, hu_val]
        omega
    have hχ_q : χ' q_u = 1 := hχ'_cond0 q_u hq_mem
    have huv : u * q_u = v := mul_inv_cancel_left u v
    rw [← huv, map_mul, hχ_q, mul_one]

  
  have hHasse_odd : a % 2 = 1 →
      ∃ (δ_L : Lˣ) (δ_K : Kˣ) (φ_L : k_L → Ω F),
        valL F L (δ_L : L) = (d : ℤ) ∧
        valL F K (δ_K : K) = (D : ℤ) ∧
        φ_L 0 = 1 ∧
        (∀ x y : k_L, φ_L (x + y) = φ_L x * φ_L y * ψ_1 (x * y)) ∧
        (∑ r ∈ R_L,
          if hr : 1 + (δ_L : L) * r ≠ 0 then
            (χ' (Units.mk0 (1 + (δ_L : L) * r) hr) : Ω F)⁻¹ *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * r)
          else 0) = (∑ b : k_L, φ_L b) ∧
        (∑ r ∈ R_K,
          if hr : 1 + (δ_K : K) * r ≠ 0 then
            ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + (δ_K : K) * r) hr) : Ω F)⁻¹ *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * r)
          else 0) = (∑ b : k_L, (φ_L b) ^ ℓ) := by
    intro ha_odd
    have hd_ge1 : 1 ≤ d := by omega
    have ha_eq : a = 2 * d + 1 := by omega
    have ha_sub1 : a - 1 = d + d := by omega
    have hr₀_eq : (a + 1) / 2 = d + 1 := by omega
    have hD_eq : D = ℓ * d := by
      dsimp only [D]
      rw [hCondχ'K]
      have hmul : ℓ * (a - 1) + 1 = 2 * (ℓ * d) + 1 := by
        rw [ha_sub1]
        ring
      omega
    set δ_L : Lˣ := π_L ^ d
    set δ_K : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom δ_L
    have hδ_L_val : valL F L (δ_L : L) = (d : ℤ) := hπ_pow_val d
    have hδ_K_coe : (δ_K : K) = IntermediateField.inclusion hLK (δ_L : L) := rfl
    have hδ_K_val : valL F K (δ_K : K) = (D : ℤ) := by
      rw [hδ_K_coe, hValAlg (δ_L : L), hδ_L_val, hD_eq, Nat.cast_mul]
    have hπ_a1_coe : ((π_L ^ (a - 1) : Lˣ) : L) = (δ_L : L) * (δ_L : L) := by
      rw [ha_sub1, pow_add, Units.val_mul]

    have hδx_p1 : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ((δ_L : L) * x = 0 ∨ (d : ℤ) ≤ valL F L ((δ_L : L) * x)) ∧
        ((δ_L : L) * x = 0 ∨ 1 ≤ valL F L ((δ_L : L) * x)) := by
      intro x hx
      have h1 : (δ_L : L) * x = 0 ∨ (d : ℤ) ≤ valL F L ((δ_L : L) * x) := by
        simpa using hvalL_mul_int (δ_L : L) x (d : ℤ) 0 (Or.inr (by omega)) hx
      refine ⟨h1, ?_⟩
      rcases h1 with h0 | hge
      · left; exact h0
      · right; omega

    have hδ2x_p : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ((δ_L : L) * (δ_L : L) * x = 0 ∨ (2 * d : ℤ) ≤ valL F L ((δ_L : L) * (δ_L : L) * x)) ∧
        ((δ_L : L) * (δ_L : L) * x = 0 ∨ 1 ≤ valL F L ((δ_L : L) * (δ_L : L) * x)) := by
      intro x hx
      have hδ2 : (δ_L : L) * (δ_L : L) = 0 ∨ (d + d : ℤ) ≤ valL F L ((δ_L : L) * (δ_L : L)) :=
        hvalL_mul_int (δ_L : L) (δ_L : L) (d : ℤ) (d : ℤ) (Or.inr (by omega)) (Or.inr (by omega))
      have h1 : (δ_L : L) * (δ_L : L) * x = 0 ∨
          (d + d + 0 : ℤ) ≤ valL F L ((δ_L : L) * (δ_L : L) * x) :=
        hvalL_mul_int ((δ_L : L) * (δ_L : L)) x (d + d : ℤ) 0 hδ2 hx
      refine ⟨?_, ?_⟩
      · rcases h1 with h0 | hge
        · left; exact h0
        · right; omega
      · rcases h1 with h0 | hge
        · left; exact h0
        · right; omega

    set Φ : L → Ω F := fun x =>
      if hx : 1 + (δ_L : L) * x ≠ 0 then
        (χ' (Units.mk0 (1 + (δ_L : L) * x) hx) : Ω F)⁻¹ *
          ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x)
      else 0
    set φ_L : k_L → Ω F := fun b => Φ (liftL b)

    have hΦ_0 : Φ 0 = 1 := by
      dsimp only [Φ]
      have h10 : (1 : L) + (δ_L : L) * 0 ≠ 0 := by rw [mul_zero, add_zero]; exact one_ne_zero
      rw [dif_pos h10]
      have hmk1 : Units.mk0 ((1 : L) + (δ_L : L) * 0) h10 = 1 := by
        apply Units.ext; simp
      rw [hmk1, map_one, Units.val_one, inv_one, mul_zero, ψ.map_zero_eq_one, mul_one]

    have hΦ_congr : ∀ x₁ x₂ : L,
        (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL x₁ = resL x₂ → Φ x₁ = Φ x₂ := by
      intro x₁ x₂ hx₁ hx₂ hres_eq
      set d12 : L := x₁ - x₂
      have hd12_int : d12 = 0 ∨ 0 ≤ valL F L d12 := hvalL_sub 0 x₁ x₂ hx₁ hx₂
      have hneg_x₂_int : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := by
        rcases hx₂ with rfl | hge
        · left; exact neg_zero
        · right; rw [hval_neg_L]; exact hge
      have hd12_res : resL d12 = 0 := by
        dsimp only [d12]
        rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ hneg_x₂_int).1,
          (hresL_ring x₂ x₂ hx₂ hx₂).2.2, hres_eq, add_neg_cancel]
      have hd12_p1 : d12 = 0 ∨ 1 ≤ valL F L d12 := (hresL_ker d12 hd12_int).mp hd12_res
      have hδd12_val : (δ_L : L) * d12 = 0 ∨ (d + 1 : ℤ) ≤ valL F L ((δ_L : L) * d12) :=
        hvalL_mul_int (δ_L : L) d12 (d : ℤ) 1 (Or.inr (by omega)) hd12_p1
      have h1_x₁ := h1_add_p1_ne_val0_L ((δ_L : L) * x₁) (hδx_p1 x₁ hx₁).2
      have h1_x₂ := h1_add_p1_ne_val0_L ((δ_L : L) * x₂) (hδx_p1 x₂ hx₂).2
      have h1_d12 := h1_add_p1_ne_val0_L ((δ_L : L) * d12) (hδx_p1 d12 hd12_int).2
      set u₁ : Lˣ := Units.mk0 (1 + (δ_L : L) * x₁) h1_x₁.1
      set u₂ : Lˣ := Units.mk0 (1 + (δ_L : L) * x₂) h1_x₂.1
      set w12 : Lˣ := Units.mk0 (1 + (δ_L : L) * d12) h1_d12.1
      have hpoly1 : ((u₂ * w12 : Lˣ) : L) - (u₁ : L) =
          (δ_L : L) * ((δ_L : L) * d12) * x₂ := by
        change (1 + (δ_L : L) * x₂) * (1 + (δ_L : L) * (x₁ - x₂)) - (1 + (δ_L : L) * x₁) = _
        ring
      have hrem1_val : ((u₂ * w12 : Lˣ) : L) - (u₁ : L) = 0 ∨
          (a : ℤ) ≤ valL F L (((u₂ * w12 : Lˣ) : L) - (u₁ : L)) := by
        rw [hpoly1]
        have hstep1 : (δ_L : L) * ((δ_L : L) * d12) = 0 ∨
            (d + (d + 1) : ℤ) ≤ valL F L ((δ_L : L) * ((δ_L : L) * d12)) :=
          hvalL_mul_int (δ_L : L) ((δ_L : L) * d12) (d : ℤ) (d + 1 : ℤ)
            (Or.inr (by omega)) hδd12_val
        have hstep2 := hvalL_mul_int ((δ_L : L) * ((δ_L : L) * d12)) x₂ (d + (d + 1) : ℤ) 0
          hstep1 hx₂
        rcases hstep2 with h0 | hge
        · left; exact h0
        · right; omega
      have hχ_u1 : χ' u₁ = χ' u₂ * χ' w12 := by
        rw [← map_mul]
        exact (hχ'_eq_of_sub_val u₁ (u₂ * w12) h1_x₁.2 hrem1_val).symm
      have hstat_w12 : (χ' w12 : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * ((δ_L : L) * d12)) := by
        apply hc_stat ((δ_L : L) * d12)
        rcases hδd12_val with h0 | hge
        · left; exact h0
        · right; omega
      have hψ_split : ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₁) =
          ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₂) *
            ψ (((c_χ'⁻¹ : Lˣ) : L) * ((δ_L : L) * d12)) := by
        rw [← ψ.map_add_eq_mul]
        congr 1
        dsimp only [d12]
        ring
      have hinv_cancel : (χ' w12 : Ω F)⁻¹ * (χ' w12 : Ω F) = 1 := by
        rw [← Units.val_inv_eq_inv_val, ← Units.val_mul, inv_mul_cancel, Units.val_one]
      dsimp only [Φ]
      rw [dif_pos h1_x₁.1, dif_pos h1_x₂.1]
      change (χ' u₁ : Ω F)⁻¹ * ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₁) =
        (χ' u₂ : Ω F)⁻¹ * ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₂)
      rw [hχ_u1, Units.val_mul, mul_inv, hψ_split, ← hstat_w12]
      calc ((χ' u₂ : Ω F)⁻¹ * (χ' w12 : Ω F)⁻¹) *
            (ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₂) * (χ' w12 : Ω F))
          = (χ' u₂ : Ω F)⁻¹ * ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₂) *
              ((χ' w12 : Ω F)⁻¹ * (χ' w12 : Ω F)) := by ring
        _ = (χ' u₂ : Ω F)⁻¹ * ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₂) := by
          rw [hinv_cancel, mul_one]

    have hΦ_add : ∀ x₁ x₂ : L,
        (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        Φ (x₁ + x₂) = Φ x₁ * Φ x₂ * ψ_1 (resL x₁ * resL x₂) := by
      intro x₁ x₂ hx₁ hx₂
      have hx_add : x₁ + x₂ = 0 ∨ 0 ≤ valL F L (x₁ + x₂) := hval_add_L 0 x₁ x₂ hx₁ hx₂
      have hx_mul : x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂) := by
        simpa using hvalL_mul_int x₁ x₂ 0 0 hx₁ hx₂
      have h1_x₁ := h1_add_p1_ne_val0_L ((δ_L : L) * x₁) (hδx_p1 x₁ hx₁).2
      have h1_x₂ := h1_add_p1_ne_val0_L ((δ_L : L) * x₂) (hδx_p1 x₂ hx₂).2
      have h1_add := h1_add_p1_ne_val0_L ((δ_L : L) * (x₁ + x₂)) (hδx_p1 (x₁ + x₂) hx_add).2
      have h1_quad := h1_add_p1_ne_val0_L ((δ_L : L) * (δ_L : L) * (x₁ * x₂))
        (hδ2x_p (x₁ * x₂) hx_mul).2
      set u₁ : Lˣ := Units.mk0 (1 + (δ_L : L) * x₁) h1_x₁.1
      set u₂ : Lˣ := Units.mk0 (1 + (δ_L : L) * x₂) h1_x₂.1
      set u12 : Lˣ := Units.mk0 (1 + (δ_L : L) * (x₁ + x₂)) h1_add.1
      set wq : Lˣ := Units.mk0 (1 + (δ_L : L) * (δ_L : L) * (x₁ * x₂)) h1_quad.1
      have hu12_val0 : valL F L ((u₁ * u₂ : Lˣ) : L) = 0 := by
        rw [Units.val_mul, hval_mul_L (u₁ : L) (u₂ : L) (Units.ne_zero _) (Units.ne_zero _)]
        change valL F L (1 + (δ_L : L) * x₁) + valL F L (1 + (δ_L : L) * x₂) = 0
        rw [h1_x₁.2, h1_x₂.2, add_zero]
      have hpoly2 : ((u12 * wq : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L) =
          (δ_L : L) * ((δ_L : L) * (δ_L : L) * (x₁ * x₂)) * (x₁ + x₂) := by
        change (1 + (δ_L : L) * (x₁ + x₂)) * (1 + (δ_L : L) * (δ_L : L) * (x₁ * x₂)) -
          (1 + (δ_L : L) * x₁) * (1 + (δ_L : L) * x₂) = _
        ring
      have hrem2_val : ((u12 * wq : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L) = 0 ∨
          (a : ℤ) ≤ valL F L (((u12 * wq : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L)) := by
        rw [hpoly2]
        have hstep1 := hvalL_mul_int (δ_L : L) ((δ_L : L) * (δ_L : L) * (x₁ * x₂))
          (d : ℤ) (2 * d : ℤ) (Or.inr (by omega)) (hδ2x_p (x₁ * x₂) hx_mul).1
        have hstep2 := hvalL_mul_int ((δ_L : L) * ((δ_L : L) * (δ_L : L) * (x₁ * x₂)))
          (x₁ + x₂) (d + 2 * d : ℤ) 0 hstep1 hx_add
        rcases hstep2 with h0 | hge
        · left; exact h0
        · right; omega
      have hχ_prod : χ' u12 * χ' wq = χ' u₁ * χ' u₂ := by
        rw [← map_mul, ← map_mul]
        exact hχ'_eq_of_sub_val (u₁ * u₂) (u12 * wq) hu12_val0 hrem2_val
      have hχ_u12_inv : (χ' u12 : Ω F)⁻¹ =
          (χ' u₁ : Ω F)⁻¹ * (χ' u₂ : Ω F)⁻¹ * (χ' wq : Ω F) := by
        have h1 : χ' u12 = χ' u₁ * χ' u₂ * (χ' wq)⁻¹ := eq_mul_inv_of_mul_eq hχ_prod
        rw [h1, Units.val_mul, Units.val_mul, Units.val_inv_eq_inv_val,
          mul_inv, mul_inv, inv_inv]
      have hstat_wq : (χ' wq : Ω F) = ψ_1 (resL x₁ * resL x₂) := by
        have hstat : (χ' wq : Ω F) =
            ψ (((c_χ'⁻¹ : Lˣ) : L) * ((δ_L : L) * (δ_L : L) * (x₁ * x₂))) := by
          apply hc_stat ((δ_L : L) * (δ_L : L) * (x₁ * x₂))
          rcases (hδ2x_p (x₁ * x₂) hx_mul).1 with h0 | hge
          · left; exact h0
          · right; omega
        have hres_mul : resL (x₁ * x₂) = resL x₁ * resL x₂ :=
          (hresL_ring x₁ x₂ hx₁ hx₂).2.1
        rw [hstat, ← hres_mul, hψ1_spec (x₁ * x₂) hx_mul, hπ_a1_coe]
        congr 1
        ring
      have hψ_add_x : ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * (x₁ + x₂)) =
          ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₁) *
            ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₂) := by
        rw [mul_add, ψ.map_add_eq_mul]
      dsimp only [Φ]
      rw [dif_pos h1_add.1, dif_pos h1_x₁.1, dif_pos h1_x₂.1]
      change (χ' u12 : Ω F)⁻¹ * ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * (x₁ + x₂)) =
        ((χ' u₁ : Ω F)⁻¹ * ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₁)) *
          ((χ' u₂ : Ω F)⁻¹ * ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x₂)) *
          ψ_1 (resL x₁ * resL x₂)
      rw [hχ_u12_inv, hstat_wq, hψ_add_x]
      ring

    have hφ_0 : φ_L 0 = 1 := by
      dsimp only [φ_L]
      rw [hΦ_congr (liftL 0) 0 (hliftL_int 0) (Or.inl rfl)
        ((hliftL_res 0).trans hresL_0.symm), hΦ_0]

    have hφ_add : ∀ x y : k_L, φ_L (x + y) = φ_L x * φ_L y * ψ_1 (x * y) := by
      intro x y
      dsimp only [φ_L]
      have hxy_int : liftL x + liftL y = 0 ∨ 0 ≤ valL F L (liftL x + liftL y) :=
        hval_add_L 0 (liftL x) (liftL y) (hliftL_int x) (hliftL_int y)
      have hxy_res : resL (liftL (x + y)) = resL (liftL x + liftL y) := by
        rw [hliftL_res (x + y),
          (hresL_ring (liftL x) (liftL y) (hliftL_int x) (hliftL_int y)).1,
          hliftL_res x, hliftL_res y]
      rw [hΦ_congr (liftL (x + y)) (liftL x + liftL y) (hliftL_int (x + y)) hxy_int hxy_res,
        hΦ_add (liftL x) (liftL y) (hliftL_int x) (hliftL_int y),
        hliftL_res x, hliftL_res y]

    have hsum_L :
        (∑ r ∈ R_L,
          if hr : 1 + (δ_L : L) * r ≠ 0 then
            (χ' (Units.mk0 (1 + (δ_L : L) * r) hr) : Ω F)⁻¹ *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * r)
          else 0) = (∑ b : k_L, φ_L b) :=
      hRL_sum Φ

    have hsum_K :
        (∑ r ∈ R_K,
          if hr : 1 + (δ_K : K) * r ≠ 0 then
            ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + (δ_K : K) * r) hr) : Ω F)⁻¹ *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * r)
          else 0) = (∑ b : k_L, (φ_L b) ^ ℓ) := by
      rw [hRK_sum]
      refine Finset.sum_congr rfl ?_
      intro b _
      set x : L := liftL b
      have hx_int : x = 0 ∨ 0 ≤ valL F L x := hliftL_int b
      have h1_x := h1_add_p1_ne_val0_L ((δ_L : L) * x) (hδx_p1 x hx_int).2
      have hinc_1_x : 1 + (δ_K : K) * IntermediateField.inclusion hLK x =
          IntermediateField.inclusion hLK (1 + (δ_L : L) * x) := by
        rw [hδ_K_coe, map_add, map_one, map_mul]
      have hrK : 1 + (δ_K : K) * IntermediateField.inclusion hLK x ≠ 0 := by
        rw [hinc_1_x]
        exact (map_ne_zero (IntermediateField.inclusion hLK)).mpr h1_x.1
      dsimp only [φ_L, Φ]
      rw [dif_pos hrK, dif_pos h1_x.1]
      have hnorm_unit :
          Units.map (normLM F hLK)
            (Units.mk0 (1 + (δ_K : K) * IntermediateField.inclusion hLK x) hrK) =
            (Units.mk0 (1 + (δ_L : L) * x) h1_x.1) ^ ℓ := by
        apply Units.ext
        change normLM F hLK (1 + (δ_K : K) * IntermediateField.inclusion hLK x) =
          (1 + (δ_L : L) * x) ^ ℓ
        rw [hinc_1_x, hnorm_inc]
      have hχK_term :
          (((χ'.comp (Units.map (normLM F hLK)))
            (Units.mk0 (1 + (δ_K : K) * IntermediateField.inclusion hLK x) hrK) : Ω F)⁻¹) =
            ((χ' (Units.mk0 (1 + (δ_L : L) * x) h1_x.1) : Ω F)⁻¹) ^ ℓ := by
        rw [MonoidHom.comp_apply, hnorm_unit, map_pow, Units.val_pow_eq_pow_val, inv_pow]
      have hψK_term :
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * IntermediateField.inclusion hLK x) =
            (ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x)) ^ ℓ := by
        have hinc_prod :
            ((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * IntermediateField.inclusion hLK x =
              IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x) := by
          rw [hc_K_inv, hδ_K_coe, ← map_mul, ← map_mul]
        rw [hinc_prod]
        change ψ (traceLM F hLK (IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L) * (δ_L : L) * x))) = _
        rw [htrace_inc, ← nsmul_eq_mul, AddChar.map_nsmul_eq_pow]
      rw [hχK_term, hψK_term, mul_pow]

    exact ⟨δ_L, δ_K, φ_L, hδ_L_val, hδ_K_val, hφ_0, hφ_add, hsum_L, hsum_K⟩

  
  have hK_deg2_even : ℓ = 2 → a % 2 = 0 →
      ∃ (δ_L : Lˣ) (δ_K2 : Kˣ),
        valL F L (δ_L : L) = (d : ℤ) ∧
        valL F K (δ_K2 : K) = (D : ℤ) ∧
        (∑ r ∈ R_K,
          if hr : 1 + (δ_K2 : K) * r ≠ 0 then
            ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + (δ_K2 : K) * r) hr) : Ω F)⁻¹ *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K2 : K) * r)
          else 0) = (∑ b : k_L, ψ_1 (b ^ 2)) := by
    intro hℓ2 ha_even
    obtain ⟨htr_ϖ, hsq_ϖ⟩ := hϖ_sq_π hℓ2
    have hd_ge1 : 1 ≤ d := by omega
    have ha_eq : a = 2 * d := by omega
    have ha_sub1 : a - 1 = 2 * (d - 1) + 1 := by omega
    have hr₀_eq : (a + 1) / 2 = d := by omega
    have hD_eq : D = a - 1 := by
      dsimp only [D]
      rw [hCondχ'K, hℓ2]
      omega
    set δ_L : Lˣ := π_L ^ d
    set δ_K2 : Kˣ := ϖ_K ^ (a - 1)
    have hδ_L_val : valL F L (δ_L : L) = (d : ℤ) := hπ_pow_val d
    have hδ_K2_val : valL F K (δ_K2 : K) = (D : ℤ) := by
      rw [hϖK_pow_val (a - 1), hD_eq]
    have hδ_K2_decomp :
        (δ_K2 : K) = IntermediateField.inclusion hLK (((π_L ^ (d - 1) : Lˣ) : L)) * (ϖ_K : K) := by
      change ((ϖ_K ^ (a - 1) : Kˣ) : K) = _
      rw [Units.val_pow_eq_pow_val, ha_sub1, pow_add, pow_mul, pow_one, hsq_ϖ,
        ← map_pow, Units.val_pow_eq_pow_val]

    
    set w' : K' := toExtendScalars F hLK (ϖ_K : K)
    have hw'_sq : w' ^ 2 = algebraMap L K' (π_L : L) := by
      dsimp only [w']
      rw [← map_pow, hsq_ϖ, hto_inc]
    have hsmul_inc : ∀ (c : L) (y : K),
        toExtendScalars F hLK (IntermediateField.inclusion hLK c * y) =
          c • toExtendScalars F hLK y := by
      intro c y
      rw [map_mul, hto_inc c, Algebra.smul_def]
    have hnot_in : ∀ c : L, c • (1 : K') ≠ w' := by
      intro c hc
      have hinc_eq : IntermediateField.inclusion hLK c = (ϖ_K : K) := by
        have h1 : toExtendScalars F hLK (IntermediateField.inclusion hLK c) =
            toExtendScalars F hLK (ϖ_K : K) := by
          rw [hto_inc c, Algebra.algebraMap_eq_smul_one, hc]
        exact (toExtendScalars F hLK).injective h1
      by_cases hc0 : c = 0
      · rw [hc0, map_zero] at hinc_eq
        exact Units.ne_zero ϖ_K hinc_eq.symm
      · have hval_eq : valL F K (IntermediateField.inclusion hLK c) = valL F K (ϖ_K : K) :=
          congrArg (valL F K) hinc_eq
        rw [hValAlg c, hℓ2, hϖ_K] at hval_eq
        omega

    have hnorm_deg2 : ∀ a₀ : L,
        normLM F hLK (1 + IntermediateField.inclusion hLK a₀ * (ϖ_K : K)) =
          1 - a₀ ^ 2 * (π_L : L) := by
      intro a₀
      change Algebra.norm L (toExtendScalars F hLK (1 + IntermediateField.inclusion hLK a₀ * (ϖ_K : K))) = _
      rw [map_add, map_one, hsmul_inc a₀ (ϖ_K : K)]
      exact hnorm_deg2_gen L K' hℓ2 w' (π_L : L) hw'_sq hnot_in a₀

    have htrace_deg2 : ∀ c : L,
        traceLM F hLK (IntermediateField.inclusion hLK c * (ϖ_K : K)) = 0 := by
      intro c
      change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK c * (ϖ_K : K))) = 0
      rw [hsmul_inc c (ϖ_K : K)]
      exact htrace_deg2_gen L K' w' htr_ϖ c

    refine ⟨δ_L, δ_K2, hδ_L_val, hδ_K2_val, ?_⟩
    rw [hRK_sum]
    refine Finset.sum_congr rfl ?_
    intro b _
    set x : L := liftL b
    have hx_int : x = 0 ∨ 0 ≤ valL F L x := hliftL_int b
    have hx_sq_int : x ^ 2 = 0 ∨ 0 ≤ valL F L (x ^ 2) := by
      rw [sq]
      simpa using hvalL_mul_int x x 0 0 hx_int hx_int
    set a₀ : L := ((π_L ^ (d - 1) : Lˣ) : L) * x
    have hy_eq : (δ_K2 : K) * IntermediateField.inclusion hLK x =
        IntermediateField.inclusion hLK a₀ * (ϖ_K : K) := by
      dsimp only [a₀]
      rw [hδ_K2_decomp, map_mul]
      ring
    have hy_p1 : (δ_K2 : K) * IntermediateField.inclusion hLK x = 0 ∨
        1 ≤ valL F K ((δ_K2 : K) * IntermediateField.inclusion hLK x) := by
      have hinc_int : IntermediateField.inclusion hLK x = 0 ∨
          0 ≤ valL F K (IntermediateField.inclusion hLK x) := by
        rcases hx_int with hx0 | hge0
        · left; rw [hx0, map_zero]
        · right; rw [hValAlg x]; exact mul_nonneg (by omega) hge0
      have h1 := hvalK_mul_int (δ_K2 : K) (IntermediateField.inclusion hLK x) (D : ℤ) 0
        (Or.inr (by omega)) hinc_int
      rcases h1 with h0 | hge
      · left; exact h0
      · right; omega
    have hrK : 1 + (δ_K2 : K) * IntermediateField.inclusion hLK x ≠ 0 :=
      h1_add_p1_ne_K ((δ_K2 : K) * IntermediateField.inclusion hLK x) hy_p1
    rw [dif_pos hrK]
    have htr_term :
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K2 : K) * IntermediateField.inclusion hLK x) = 1 := by
      have harg_eq :
          ((c_K⁻¹ : Kˣ) : K) * (δ_K2 : K) * IntermediateField.inclusion hLK x =
            IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L) * a₀) * (ϖ_K : K) := by
        rw [hc_K_inv, mul_assoc, hy_eq, ← mul_assoc, ← map_mul]
      rw [harg_eq]
      change ψ (traceLM F hLK (IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L) * a₀) * (ϖ_K : K))) = 1
      rw [htrace_deg2, ψ.map_zero_eq_one]
    have ha₀_sq_π : a₀ ^ 2 * (π_L : L) = ((π_L ^ (a - 1) : Lˣ) : L) * (x ^ 2) := by
      have hπ_pow_eq : ((π_L ^ (a - 1) : Lˣ) : L) =
          (((π_L ^ (d - 1) : Lˣ) : L)) ^ 2 * (π_L : L) := by
        rw [ha_sub1, pow_add, pow_mul', pow_one, Units.val_mul, Units.val_pow_eq_pow_val]
      dsimp only [a₀]
      rw [hπ_pow_eq]
      ring
    set z_L : L := ((π_L ^ (a - 1) : Lˣ) : L) * (x ^ 2)
    have hz_L_val : z_L = 0 ∨ (a - 1 : ℤ) ≤ valL F L z_L := by
      have h1 := hvalL_mul_int ((π_L ^ (a - 1) : Lˣ) : L) (x ^ 2) ((a - 1 : ℕ) : ℤ) 0
        (Or.inr (by rw [hπ_pow_val (a - 1)])) hx_sq_int
      dsimp only [z_L]
      rcases h1 with h0 | hge
      · left; exact h0
      · right; omega
    have hneg_z_val : -z_L = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L (-z_L) := by
      rcases hz_L_val with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_L]; omega
    have h1_neg_z_ne : 1 + (-z_L) ≠ 0 := by
      apply (h1_add_p1_ne_val0_L (-z_L) ?_).1
      rcases hneg_z_val with h0 | hge
      · left; exact h0
      · right; omega
    have hnorm_unit_eq :
        Units.map (normLM F hLK)
          (Units.mk0 (1 + (δ_K2 : K) * IntermediateField.inclusion hLK x) hrK) =
          Units.mk0 (1 + (-z_L)) h1_neg_z_ne := by
      apply Units.ext
      change normLM F hLK (1 + (δ_K2 : K) * IntermediateField.inclusion hLK x) = 1 + (-z_L)
      rw [hy_eq, hnorm_deg2 a₀, ha₀_sq_π]
      dsimp only [z_L]
      ring
    have hstat_neg_z :
        (χ' (Units.mk0 (1 + (-z_L)) h1_neg_z_ne) : Ω F)⁻¹ =
          ψ (((c_χ'⁻¹ : Lˣ) : L) * z_L) := by
      rw [hc_stat (-z_L) hneg_z_val h1_neg_z_ne, mul_neg, AddChar.map_neg_eq_inv, inv_inv]
    have hres_x_sq : resL (x ^ 2) = b ^ 2 := by
      rw [sq, sq, (hresL_ring x x hx_int hx_int).2.1, hliftL_res b]
    rw [htr_term, mul_one, MonoidHom.comp_apply, hnorm_unit_eq, hstat_neg_z,
      ← hres_x_sq, hψ1_spec (x ^ 2) hx_sq_int]
    dsimp only [z_L]
    rw [← mul_assoc]

  exact ⟨hNeChar, ν_tilde, ψ_1, hν_0, hν_1, hν_mul, hν_pow, hν_ne,
    hψ1_0, hψ1_add, hψ1_ne, hprod_odd, hprod_deg2, hHasse_odd, hK_deg2_even⟩

theorem ld_finite_field_odd_prime_gauss_and_vandermonde_hasse (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ) (hOdd : ℓ ≠ 2) (hNeChar : (ℓ : k) ≠ 0)
    (ν_tilde ψ_1 : k → Ω F)
    (hν_0 : ν_tilde 0 = 0)
    (hν_1 : ν_tilde 1 = 1)
    (hν_mul : ∀ a b : k, ν_tilde (a * b) = ν_tilde a * ν_tilde b)
    (hν_pow : ∀ a : k, a ≠ 0 → (ν_tilde a) ^ ℓ = 1)
    (hν_ne : ∃ a₀ : k, a₀ ≠ 0 ∧ ν_tilde a₀ ≠ 1)
    (hψ1_0 : ψ_1 0 = 1)
    (hψ1_add : ∀ x y : k, ψ_1 (x + y) = ψ_1 x * ψ_1 y)
    (hψ1_ne : ∃ x₀ : k, ψ_1 x₀ ≠ 1) :
    (∀ w : Ω F, w ^ ℓ = 1 →
      (∏ j ∈ Finset.range ℓ, w ^ j) = 1 ∧
      (∏ j ∈ (Finset.range ℓ).erase 0, w ^ j) = 1) ∧
    (∏ j ∈ (Finset.range ℓ).erase 0,
      (∑ a : k, (ν_tilde a) ^ j * ψ_1 a)) =
      (Fintype.card k : Ω F) ^ ((ℓ - 1) / 2) ∧
    (∀ (φ_L : k → Ω F),
      φ_L 0 = 1 →
      (∀ x y : k, φ_L (x + y) = φ_L x * φ_L y * ψ_1 (x * y)) →
      (∑ x : k, φ_L x) ^ ℓ =
        (Fintype.card k : Ω F) ^ ((ℓ - 1) / 2) * (∑ x : k, (φ_L x) ^ ℓ)) :=
by
  have hs1 :
      (∀ w : Ω F, w ^ ℓ = 1 →
        (∏ j ∈ Finset.range ℓ, w ^ j) = 1 ∧
        (∏ j ∈ (Finset.range ℓ).erase 0, w ^ j) = 1) ∧
      (∀ c : k, c ≠ 0 → (∑ b : k, ψ_1 (c * b)) = 0) ∧
      (∏ j ∈ (Finset.range ℓ).erase 0,
        (∑ a : k, (ν_tilde a) ^ j * ψ_1 a)) =
        (Fintype.card k : Ω F) ^ ((ℓ - 1) / 2) := by
    haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
    have hℓ_odd : ℓ % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime).resolve_left hOdd
    set M := (ℓ - 1) / 2
    have hℓ_eq : ℓ = 2 * M + 1 := by omega
    have hsum_range : ∑ j ∈ Finset.range ℓ, j = ℓ * M := by
      rw [Finset.sum_range_id]
      have h1 : ℓ - 1 = 2 * M := by omega
      rw [h1, Nat.mul_comm 2 M, ← Nat.mul_assoc, Nat.mul_div_cancel _ (by omega : 0 < 2)]
    have hroot : ∀ w : Ω F, w ^ ℓ = 1 →
        (∏ j ∈ Finset.range ℓ, w ^ j) = 1 ∧
        (∏ j ∈ (Finset.range ℓ).erase 0, w ^ j) = 1 := by
      intro w hw
      have hp1 : (∏ j ∈ Finset.range ℓ, w ^ j) = 1 := by
        rw [Finset.prod_pow_eq_pow_sum, hsum_range, pow_mul, hw, one_pow]
      refine ⟨hp1, ?_⟩
      have h0 : 0 ∈ Finset.range ℓ := Finset.mem_range.mpr hPrime.pos
      have hp2 := Finset.mul_prod_erase (Finset.range ℓ) (fun j => w ^ j) h0
      dsimp only at hp2
      rw [pow_zero, one_mul, hp1] at hp2
      exact hp2
    have hψ1_orth : ∀ c : k, c ≠ 0 → (∑ b : k, ψ_1 (c * b)) = 0 := by
      intro c hc
      obtain ⟨x₀, hx₀⟩ := hψ1_ne
      have hshift : (∑ b : k, ψ_1 (c * b)) = (∑ b : k, ψ_1 (c * b)) * ψ_1 x₀ := by
        conv_lhs =>
          rw [← Fintype.sum_equiv (Equiv.addRight (c⁻¹ * x₀))
            (fun b => ψ_1 (c * (b + c⁻¹ * x₀))) (fun b => ψ_1 (c * b)) (fun _ => rfl)]
        have hterm : ∀ b : k, ψ_1 (c * (b + c⁻¹ * x₀)) = ψ_1 (c * b) * ψ_1 x₀ := by
          intro b
          have h1 : c * (b + c⁻¹ * x₀) = c * b + x₀ := by
            rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hc, one_mul]
          rw [h1, hψ1_add]
        simp_rw [hterm, ← Finset.sum_mul]
      have hsub : (∑ b : k, ψ_1 (c * b)) * (ψ_1 x₀ - 1) = 0 := by
        calc (∑ b : k, ψ_1 (c * b)) * (ψ_1 x₀ - 1)
            = (∑ b : k, ψ_1 (c * b)) * ψ_1 x₀ - (∑ b : k, ψ_1 (c * b)) := by ring
          _ = 0 := sub_eq_zero.mpr hshift.symm
      exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hx₀)
    have hν_orth : ∀ j : ℕ, 1 ≤ j → j < ℓ → (∑ u : k, (ν_tilde u) ^ j) = 0 := by
      intro j hj1 hj2
      obtain ⟨a₀, ha₀, hν_a₀⟩ := hν_ne
      have hord : orderOf (ν_tilde a₀) = ℓ :=
        orderOf_eq_prime (hν_pow a₀ ha₀) hν_a₀
      have hj_ne : (ν_tilde a₀) ^ j ≠ 1 := by
        apply pow_ne_one_of_lt_orderOf (by omega)
        rw [hord]
        exact hj2
      have hshift : (∑ u : k, (ν_tilde u) ^ j) = (∑ u : k, (ν_tilde u) ^ j) * (ν_tilde a₀) ^ j := by
        conv_lhs =>
          rw [← Fintype.sum_equiv (Equiv.mulRight₀ a₀ ha₀)
            (fun u => (ν_tilde (u * a₀)) ^ j) (fun u => (ν_tilde u) ^ j) (fun _ => rfl)]
        have hterm : ∀ u : k, (ν_tilde (u * a₀)) ^ j = (ν_tilde u) ^ j * (ν_tilde a₀) ^ j := by
          intro u
          rw [hν_mul, mul_pow]
        simp_rw [hterm, ← Finset.sum_mul]
      have hsub : (∑ u : k, (ν_tilde u) ^ j) * ((ν_tilde a₀) ^ j - 1) = 0 := by
        calc (∑ u : k, (ν_tilde u) ^ j) * ((ν_tilde a₀) ^ j - 1)
            = (∑ u : k, (ν_tilde u) ^ j) * (ν_tilde a₀) ^ j - (∑ u : k, (ν_tilde u) ^ j) := by ring
          _ = 0 := sub_eq_zero.mpr hshift.symm
      exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hj_ne)
    have hν_neg1 : ν_tilde (-1) = 1 := by
      have hsq : (ν_tilde (-1)) ^ 2 = 1 := by
        rw [sq, ← hν_mul, neg_one_mul, neg_neg, hν_1]
      have hpow : (ν_tilde (-1)) ^ ℓ = 1 := hν_pow (-1) (neg_ne_zero.mpr one_ne_zero)
      calc ν_tilde (-1)
          = ν_tilde (-1) * 1 ^ M := by rw [one_pow, mul_one]
        _ = ν_tilde (-1) * ((ν_tilde (-1)) ^ 2) ^ M := by rw [hsq]
        _ = (ν_tilde (-1)) ^ (2 * M + 1) := by rw [← pow_mul, ← pow_succ']
        _ = (ν_tilde (-1)) ^ ℓ := by rw [← hℓ_eq]
        _ = 1 := hpow
    set G : ℕ → Ω F := fun j => ∑ a : k, (ν_tilde a) ^ j * ψ_1 a
    have hG_pair : ∀ j ∈ Finset.Ico 1 (M + 1), G j * G (ℓ - j) = (Fintype.card k : Ω F) := by
      intro j hj
      rw [Finset.mem_Ico] at hj
      have hj_pos : j ≠ 0 := by omega
      have hlj_pos : ℓ - j ≠ 0 := by omega
      have hG_erase : G (ℓ - j) = ∑ b ∈ (Finset.univ : Finset k).erase 0, (ν_tilde b) ^ (ℓ - j) * ψ_1 b := by
        have h0 := Finset.add_sum_erase (Finset.univ : Finset k)
          (fun b => (ν_tilde b) ^ (ℓ - j) * ψ_1 b) (Finset.mem_univ 0)
        dsimp only at h0
        rw [hν_0, zero_pow hlj_pos, zero_mul, zero_add] at h0
        exact h0.symm
      have hinner : ∀ b ∈ (Finset.univ : Finset k).erase 0,
          G j * ((ν_tilde b) ^ (ℓ - j) * ψ_1 b) =
            ∑ u : k, (ν_tilde u) ^ j * ψ_1 ((u + 1) * b) := by
        intro b hb
        have hb0 : b ≠ 0 := (Finset.mem_erase.mp hb).1
        have hre : G j = ∑ u : k, (ν_tilde (u * b)) ^ j * ψ_1 (u * b) := by
          exact (Fintype.sum_equiv (Equiv.mulRight₀ b hb0)
            (fun u => (ν_tilde (u * b)) ^ j * ψ_1 (u * b))
            (fun a => (ν_tilde a) ^ j * ψ_1 a) (fun _ => rfl)).symm
        rw [hre, Finset.sum_mul]
        refine Finset.sum_congr rfl fun u _ => ?_
        have hν_b : (ν_tilde b) ^ j * (ν_tilde b) ^ (ℓ - j) = 1 := by
          rw [← pow_add, Nat.add_sub_of_le (by omega : j ≤ ℓ), hν_pow b hb0]
        calc (ν_tilde (u * b)) ^ j * ψ_1 (u * b) * ((ν_tilde b) ^ (ℓ - j) * ψ_1 b)
            = (ν_tilde u) ^ j * ((ν_tilde b) ^ j * (ν_tilde b) ^ (ℓ - j)) * (ψ_1 (u * b) * ψ_1 b) := by
              rw [hν_mul, mul_pow]; ring
          _ = (ν_tilde u) ^ j * 1 * ψ_1 (u * b + b) := by rw [hν_b, ← hψ1_add]
          _ = (ν_tilde u) ^ j * ψ_1 ((u + 1) * b) := by rw [mul_one, add_one_mul]
      calc G j * G (ℓ - j)
          = ∑ b ∈ (Finset.univ : Finset k).erase 0, G j * ((ν_tilde b) ^ (ℓ - j) * ψ_1 b) := by
            rw [hG_erase, Finset.mul_sum]
        _ = ∑ b ∈ (Finset.univ : Finset k).erase 0, ∑ u : k, (ν_tilde u) ^ j * ψ_1 ((u + 1) * b) :=
            Finset.sum_congr rfl hinner
        _ = ∑ u : k, (ν_tilde u) ^ j * (∑ b ∈ (Finset.univ : Finset k).erase 0, ψ_1 ((u + 1) * b)) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun u _ => (Finset.mul_sum _ _ _).symm
        _ = ∑ u : k, ((ν_tilde u) ^ j * (∑ b : k, ψ_1 ((u + 1) * b)) - (ν_tilde u) ^ j) := by
            refine Finset.sum_congr rfl fun u _ => ?_
            have h0 := Finset.add_sum_erase (Finset.univ : Finset k)
              (fun b => ψ_1 ((u + 1) * b)) (Finset.mem_univ 0)
            dsimp only at h0
            rw [mul_zero, hψ1_0] at h0
            have h1 : (∑ b ∈ (Finset.univ : Finset k).erase 0, ψ_1 ((u + 1) * b)) =
                (∑ b : k, ψ_1 ((u + 1) * b)) - 1 := eq_sub_of_add_eq' h0
            rw [h1, mul_sub, mul_one]
        _ = (∑ u : k, (ν_tilde u) ^ j * (∑ b : k, ψ_1 ((u + 1) * b))) -
              (∑ u : k, (ν_tilde u) ^ j) := Finset.sum_sub_distrib _ _
        _ = (Fintype.card k : Ω F) := by
            rw [hν_orth j hj.1 (by omega), sub_zero]
            rw [Finset.sum_eq_single (-1 : k)]
            · simp [hν_neg1, hψ1_0]
            · intro u _ hu
              have hu1 : u + 1 ≠ 0 := by
                intro h
                apply hu
                exact eq_neg_of_add_eq_zero_left h
              rw [hψ1_orth (u + 1) hu1, mul_zero]
            · intro habs
              exact False.elim (habs (Finset.mem_univ _))
    refine ⟨hroot, hψ1_orth, ?_⟩
    have herase : (Finset.range ℓ).erase 0 = Finset.Ico 1 ℓ := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_Ico]
      omega
    rw [herase, ← Finset.prod_Ico_consecutive G (by omega : 1 ≤ M + 1) (by omega : M + 1 ≤ ℓ)]
    have hrev : (∏ j ∈ Finset.Ico (M + 1) ℓ, G j) = ∏ j ∈ Finset.Ico 1 (M + 1), G (ℓ - j) := by
      refine Finset.prod_bij' (fun j _ => ℓ - j) (fun j _ => ℓ - j) ?_ ?_ ?_ ?_ ?_
      · intro j hj; dsimp only; rw [Finset.mem_Ico] at hj ⊢; omega
      · intro j hj; dsimp only; rw [Finset.mem_Ico] at hj ⊢; omega
      · intro j hj; dsimp only; rw [Finset.mem_Ico] at hj; omega
      · intro j hj; dsimp only; rw [Finset.mem_Ico] at hj; omega
      · intro j hj; dsimp only; rw [Finset.mem_Ico] at hj; congr 1; omega
    rw [hrev, ← Finset.prod_mul_distrib, Finset.prod_congr rfl hG_pair, Finset.prod_const,
      Nat.card_Ico, Nat.add_sub_cancel]
  obtain ⟨hroot_prod, hψ1_orth, hGauss_refl⟩ := hs1
  have hs2 :
      ∃ (V V_inv : (Fin ℓ → k) → (Fin ℓ → k)) (z : (Fin ℓ → k) → ℕ → k),
        (∀ x : Fin ℓ → k, V (V_inv x) = x) ∧
        (∀ y : Fin ℓ → k, V_inv (V y) = y) ∧
        (∀ (y : Fin ℓ → k) (j : Fin ℓ),
          V y j = y ⟨0, hPrime.pos⟩ + z y j.1) ∧
        (∀ y : Fin ℓ → k, (∑ j ∈ Finset.range ℓ, z y j) = 0) ∧
        (∀ y : Fin ℓ → k,
          - (∑ j ∈ Finset.range ℓ, ∑ i ∈ Finset.range j, z y i * z y j) =
            ∑ r : Fin ((ℓ - 1) / 2),
              (ℓ : k) *
                y ⟨(r.1 + 1) % ℓ, Nat.mod_lt _ hPrime.pos⟩ *
                y ⟨(ℓ - 1 - r.1) % ℓ, Nat.mod_lt _ hPrime.pos⟩) := by
    haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
    obtain ⟨a₀, ha₀, hν_a₀⟩ := hν_ne
    let u₀ : kˣ := Units.mk0 a₀ ha₀
    have hu₀_ν : ∀ n : ℕ, ν_tilde ((u₀ ^ n : kˣ) : k) = (ν_tilde a₀) ^ n := by
      intro n
      induction n with
      | zero => simp [hν_1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hν_mul, ih, pow_succ]
        rfl
    have hord_ν : orderOf (ν_tilde a₀) = ℓ := orderOf_eq_prime (hν_pow a₀ ha₀) hν_a₀
    set m₀ := orderOf u₀
    have hm₀_pow : (ν_tilde a₀) ^ m₀ = 1 := by
      rw [← hu₀_ν m₀, pow_orderOf_eq_one, Units.val_one, hν_1]
    have h_dvd : ℓ ∣ m₀ := by
      rw [← hord_ν]
      exact orderOf_dvd_of_pow_eq_one hm₀_pow
    have hm₀_pos : 0 < m₀ := orderOf_pos u₀
    set d₀ := m₀ / ℓ
    have hd₀_mul : d₀ * ℓ = m₀ := Nat.div_mul_cancel h_dvd
    have hℓ_two : 2 ≤ ℓ := hPrime.two_le
    have hd₀_pos : 0 < d₀ := by nlinarith
    have hd₀_lt : d₀ < m₀ := by nlinarith
    let ζ_u : kˣ := u₀ ^ d₀
    let ζ : k := (ζ_u : k)
    have hζ_u_pow : ζ_u ^ ℓ = 1 := by
      dsimp only [ζ_u]
      rw [← pow_mul, hd₀_mul, pow_orderOf_eq_one]
    have hζ_u_ne : ζ_u ≠ 1 := pow_ne_one_of_lt_orderOf hd₀_pos.ne' hd₀_lt
    have hord_ζ : orderOf ζ_u = ℓ := orderOf_eq_prime hζ_u_pow hζ_u_ne
    have hζ_pow : ζ ^ ℓ = 1 := by
      dsimp only [ζ]
      rw [← Units.val_pow_eq_pow_val, hζ_u_pow, Units.val_one]
    have hζ_eq_one_iff : ∀ a : ℕ, ζ ^ a = 1 ↔ ℓ ∣ a := by
      intro a
      rw [← hord_ζ, orderOf_dvd_iff_pow_eq_one]
      constructor
      · intro h
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, Units.val_one]
        exact h
      · intro h
        dsimp only [ζ]
        rw [← Units.val_pow_eq_pow_val, h, Units.val_one]
    have h_not_dvd_of_lt : ∀ a : ℕ, 0 < a → a < 2 * ℓ → a ≠ ℓ → ¬ (ℓ ∣ a) := by
      rintro a ha1 ha2 ha_ne ⟨_ | _ | c, rfl⟩
      · omega
      · omega
      · nlinarith
    have hζ_geom_eq : ∀ a : ℕ, ℓ ∣ a → (∑ j ∈ Finset.range ℓ, (ζ ^ a) ^ j) = (ℓ : k) := by
      intro a ha
      rw [(hζ_eq_one_iff a).mpr ha]
      simp
    have hζ_geom_ne : ∀ a : ℕ, ¬ (ℓ ∣ a) → (∑ j ∈ Finset.range ℓ, (ζ ^ a) ^ j) = 0 := by
      intro a ha
      have hne : ζ ^ a ≠ 1 := fun h => ha ((hζ_eq_one_iff a).mp h)
      have h1 := geom_sum_mul (ζ ^ a) ℓ
      rw [← pow_mul, mul_comm a ℓ, pow_mul, hζ_pow, one_pow, sub_self] at h1
      exact (mul_eq_zero.mp h1).resolve_right (sub_ne_zero.mpr hne)
    have hζ_inv : ∀ (a b : ℕ), a ≤ ℓ → ζ ^ ((ℓ - a) * b) * ζ ^ (a * b) = 1 := by
      intro a b ha
      rw [← pow_add, ← Nat.add_mul, Nat.sub_add_cancel ha, pow_mul, hζ_pow, one_pow]
    have hζ_symm : ∀ (a b : ℕ), a ≤ ℓ → b ≤ ℓ → ζ ^ ((ℓ - a) * b) = ζ ^ ((ℓ - b) * a) := by
      intro a b ha hb
      calc ζ ^ ((ℓ - a) * b)
          = ζ ^ ((ℓ - a) * b) * (ζ ^ ((ℓ - b) * a) * ζ ^ (b * a)) := by
            rw [hζ_inv b a hb, mul_one]
        _ = ζ ^ ((ℓ - b) * a) * (ζ ^ ((ℓ - a) * b) * ζ ^ (a * b)) := by
            rw [mul_comm b a]; ring
        _ = ζ ^ ((ℓ - b) * a) := by
            rw [hζ_inv a b ha, mul_one]
    have h_orth_fin : ∀ (a b : Fin ℓ),
        (∑ j : Fin ℓ, (ζ ^ (a.1 + (ℓ - b.1))) ^ j.1) = if a = b then (ℓ : k) else 0 := by
      intro a b
      rw [Fin.sum_univ_eq_sum_range (fun j => (ζ ^ (a.1 + (ℓ - b.1))) ^ j) ℓ]
      by_cases hab : a = b
      · subst hab
        rw [if_pos rfl]
        apply hζ_geom_eq
        have hb := a.2
        have h1 : a.1 + (ℓ - a.1) = ℓ := by omega
        rw [h1]
      · rw [if_neg hab]
        apply hζ_geom_ne
        have ha := a.2
        have hb := b.2
        have hne_val : a.1 ≠ b.1 := fun h => hab (Fin.ext h)
        exact h_not_dvd_of_lt (a.1 + (ℓ - b.1)) (by omega) (by omega) (by omega)
    let V : (Fin ℓ → k) → (Fin ℓ → k) :=
      fun y j => ∑ m : Fin ℓ, ζ ^ (j.1 * m.1) * y m
    let V_inv : (Fin ℓ → k) → (Fin ℓ → k) :=
      fun x m => (ℓ : k)⁻¹ * ∑ j : Fin ℓ, ζ ^ ((ℓ - m.1) * j.1) * x j
    let z : (Fin ℓ → k) → ℕ → k :=
      fun y j => ∑ m ∈ Finset.Ico 1 ℓ, ζ ^ (j * m) * y ⟨m % ℓ, Nat.mod_lt m hPrime.pos⟩
    refine ⟨V, V_inv, z, ?_, ?_, ?_, ?_, ?_⟩
    · intro x
      funext j₁
      dsimp only [V, V_inv]
      have h1 : (∑ m : Fin ℓ, ζ ^ (j₁.1 * m.1) * ((ℓ : k)⁻¹ * ∑ j₂ : Fin ℓ, ζ ^ ((ℓ - m.1) * j₂.1) * x j₂)) =
          ∑ j₂ : Fin ℓ, (ℓ : k)⁻¹ * ((∑ m : Fin ℓ, (ζ ^ (j₁.1 + (ℓ - j₂.1))) ^ m.1) * x j₂) := by
        simp_rw [← mul_assoc, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun j₂ _ => ?_
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun m _ => ?_
        have hj₂ : j₂.1 ≤ ℓ := le_of_lt j₂.2
        have hm : m.1 ≤ ℓ := le_of_lt m.2
        rw [hζ_symm m.1 j₂.1 hm hj₂, ← pow_mul, add_mul, pow_add]
        ring
      rw [h1, ← Finset.mul_sum]
      simp_rw [h_orth_fin j₁, ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
      exact inv_mul_cancel_left₀ hNeChar (x j₁)
    · intro y
      funext m₁
      dsimp only [V, V_inv]
      have h1 : (ℓ : k)⁻¹ * (∑ j : Fin ℓ, ζ ^ ((ℓ - m₁.1) * j.1) * ∑ m₂ : Fin ℓ, ζ ^ (j.1 * m₂.1) * y m₂) =
          (ℓ : k)⁻¹ * ∑ m₂ : Fin ℓ, (∑ j : Fin ℓ, (ζ ^ (m₂.1 + (ℓ - m₁.1))) ^ j.1) * y m₂ := by
        congr 1
        simp_rw [Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun m₂ _ => ?_
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← pow_mul, add_mul, pow_add, mul_comm j.1 m₂.1]
        ring
      rw [h1]
      simp_rw [h_orth_fin _ m₁, ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
