    have hge : valL F K₁ w₁ ≤ valL F K₁ (w₁ + w₂) := hsum_ge.resolve_left hsum_ne
    have hlt : ¬ (valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := fun hle => hnot_gt (Or.inr hle)
    exact ⟨hsum_ne, by omega⟩
  have val_incl_E'K₁ : ∀ {m : ℤ} {y : E'},
      (y = 0 ∨ m ≤ valL F E' y) →
      IntermediateField.inclusion hE'K₁ y = 0 ∨
        (p : ℤ) * m ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ y) := by
    intro m y hy
    rcases hy with rfl | hy
    · exact Or.inl (map_zero _)
    · right
      rw [hval_E'K₁ y]
      exact mul_le_mul_of_nonneg_left hy (Nat.cast_nonneg p)
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := hPrime.pos
  have ht₁_ge1 : 1 ≤ t₁ := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by omega
  have ht_le : t₁ ≤ t₂ := by omega
  set P₂ : ℤ := ((p * (p - 1) * t₂ : ℕ) : ℤ)
  set M_low : ℤ := (((p - 1) * (p - 1) * t₁ : ℕ) : ℤ)
  set M_bin : ℤ := P₂ - (((p - 1) * t₁ : ℕ) : ℤ)
  have hM_low_ge4 : (4 : ℤ) ≤ M_low := by
    have h1 : 4 ≤ (p - 1) * (p - 1) * t₁ := by
      have hp1 : 2 * 2 ≤ (p - 1) * (p - 1) := Nat.mul_le_mul (by omega) (by omega)
      calc 4 = 4 * 1 := by ring
        _ ≤ ((p - 1) * (p - 1)) * t₁ := Nat.mul_le_mul hp1 ht₁_ge1
    dsimp [M_low]
    exact_mod_cast h1
  have hM_low_le_bin : M_low ≤ M_bin := by
    have h1 : (p - 1) * (p - 1) * t₁ + (p - 1) * t₁ ≤ p * (p - 1) * t₂ := by
      have heq : (p - 1) * (p - 1) * t₁ + (p - 1) * t₁ = ((p - 1) + 1) * (p - 1) * t₁ := by ring
      have hp1 : (p - 1) + 1 = p := Nat.sub_add_cancel hp_pos
      rw [heq, hp1]
      exact Nat.mul_le_mul_left (p * (p - 1)) ht_le
    have h1z : M_low + (((p - 1) * t₁ : ℕ) : ℤ) ≤ P₂ := by
      dsimp [M_low, P₂]
      exact_mod_cast h1
    change M_low ≤ P₂ - (((p - 1) * t₁ : ℕ) : ℤ)
    linarith
  have hM_bin_le_P₂ : M_bin ≤ P₂ := by
    dsimp [M_bin]
    omega
  have hM_bin_ge4 : (4 : ℤ) ≤ M_bin := le_trans hM_low_ge4 hM_low_le_bin
  have hM_bin_eq : P₂ - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) = M_bin := by
    dsimp [M_bin]
  have hchoose_val : ∀ (j : ℕ), 0 < j → j < p →
      ((Nat.choose p j : ℕ) : K₁) = 0 ∨ P₂ ≤ valL F K₁ ((Nat.choose p j : ℕ) : K₁) := by
    intro j hj_pos hj_lt
    obtain ⟨q, hq⟩ := Nat.Prime.dvd_choose_self hPrime (by omega) hj_lt
    rw [hq, Nat.cast_mul]
    exact val_mono_K₁ (by omega) (val_mul_K₁ hp_valK₁ (val_natCast_K₁ q))
  have hbinom_decomp : ∀ (x y : K₁),
      (x + y) ^ p - (x ^ p + y ^ p) =
        ∑ k ∈ Finset.range (p - 1),
          x ^ (k + 1) * y ^ (p - (k + 1)) * ((Nat.choose p (k + 1) : ℕ) : K₁) := by
    intro x y
    let g : ℕ → K₁ := fun j => x ^ j * y ^ (p - j) * ((Nat.choose p j : ℕ) : K₁)
    have h1 : (x + y) ^ p = ∑ j ∈ Finset.range (p + 1), g j := add_pow x y p
    have h2 : ∑ j ∈ Finset.range (p + 1), g j = (∑ j ∈ Finset.range p, g j) + g p :=
      Finset.sum_range_succ g p
    have hgp : g p = x ^ p := by
      dsimp [g]
      rw [Nat.sub_self, pow_zero, Nat.choose_self, Nat.cast_one, mul_one, mul_one]
    have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp_pos).symm
    have h3 : ∑ j ∈ Finset.range p, g j =
        (∑ k ∈ Finset.range (p - 1), g (k + 1)) + g 0 := by
      conv_lhs => rw [hp_eq]
      exact Finset.sum_range_succ' g (p - 1)
    have hg0 : g 0 = y ^ p := by
      dsimp [g]
      rw [pow_zero, Nat.choose_zero_right, Nat.cast_one, one_mul, mul_one]
    rw [h1, h2, hgp, h3, hg0]
    ring
  have hbinom_cross : ∀ (x y : K₁) (vx vy M : ℤ),
      (x = 0 ∨ vx ≤ valL F K₁ x) →
      (y = 0 ∨ vy ≤ valL F K₁ y) →
      (∀ k < p - 1, M ≤ ((k + 1 : ℕ) : ℤ) * vx + ((p - (k + 1) : ℕ) : ℤ) * vy + P₂) →
      (x + y) ^ p - (x ^ p + y ^ p) = 0 ∨ M ≤ valL F K₁ ((x + y) ^ p - (x ^ p + y ^ p)) := by
    intro x y vx vy M hx hy hM
