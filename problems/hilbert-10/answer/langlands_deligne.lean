by
  classical
  
  have hIterFrobSurj : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (hp_prime : Nat.Prime (p F))
      (hval1 : valL F M 1 = 0)
      (hval_neg : ∀ x : M, valL F M (-x) = valL F M x)
      (hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y)
      (hval_add : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y)))
      (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 1 ≤ valL F M (algebraMap F M a)))
      (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M)
      (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
      (hresM_ring : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
        resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
        resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
        resM (-x₁) = -resM x₁)
      (hresM_ker : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x)))
      (hresM_surj : ∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a)
      (m : ℕ) (x : M), (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ s : M, (s = 0 ∨ 0 ≤ valL F M s) ∧
        (x - s ^ ((p F) ^ m) = 0 ∨ 1 ≤ valL F M (x - s ^ ((p F) ^ m))) := by
    intro M _ hp_prime hval1 hval_neg hval_mul hval_add halg1
      k_M _ _ resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj m x hx
    let PM (k : ℤ) (z : M) : Prop := z = 0 ∨ k ≤ valL F M z
    have hPM_zero : ∀ k : ℤ, PM k 0 := fun _ => Or.inl rfl
    have hPM_one : PM 0 1 := Or.inr (by rw [hval1])
    have hPM_neg : ∀ {k : ℤ} {z : M}, PM k z → PM k (-z) := by
      intro k z hz
      rcases hz with rfl | hz
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg]; exact hz)
    have hPM_add : ∀ {k : ℤ} {z₁ z₂ : M}, PM k z₁ → PM k z₂ → PM k (z₁ + z₂) :=
      fun hz₁ hz₂ => hval_add _ _ _ hz₁ hz₂
    have hPM_sub : ∀ {k : ℤ} {z₁ z₂ : M}, PM k z₁ → PM k z₂ → PM k (z₁ - z₂) := by
      intro k z₁ z₂ hz₁ hz₂
      rw [sub_eq_add_neg]
      exact hPM_add hz₁ (hPM_neg hz₂)
    have hPM_mul : ∀ {k₁ k₂ : ℤ} {z₁ z₂ : M}, PM k₁ z₁ → PM k₂ z₂ → PM (k₁ + k₂) (z₁ * z₂) := by
      intro k₁ k₂ z₁ z₂ hz₁ hz₂
      by_cases hz₁0 : z₁ = 0
      · left; rw [hz₁0, zero_mul]
      · by_cases hz₂0 : z₂ = 0
        · left; rw [hz₂0, mul_zero]
        · right
          rw [hval_mul z₁ z₂ hz₁0 hz₂0]
          have h1 := hz₁.resolve_left hz₁0
          have h2 := hz₂.resolve_left hz₂0
          omega
    have hresM_pow : ∀ (z : M) (n : ℕ), PM 0 z → PM 0 (z ^ n) ∧ resM (z ^ n) = (resM z) ^ n := by
      intro z n hz
      induction n with
      | zero =>
        rw [pow_zero, pow_zero, hresM_1]
        exact ⟨hPM_one, rfl⟩
      | succ n ih =>
        have hpow_int : PM 0 (z ^ (n + 1)) := by
          rw [pow_succ, ← zero_add (0 : ℤ)]
          exact hPM_mul ih.1 hz
        refine ⟨hpow_int, ?_⟩
        rw [pow_succ, (hresM_ring (z ^ n) z ih.1 hz).2.1, ih.2, pow_succ]
    have hresM_nat : ∀ n : ℕ, PM 0 (n : M) ∧ resM (n : M) = (n : k_M) := by
      intro n
      induction n with
      | zero =>
        refine ⟨Or.inl Nat.cast_zero, ?_⟩
        rw [Nat.cast_zero, Nat.cast_zero, hresM_0]
      | succ n ih =>
        have hval_succ : PM 0 ((n + 1 : ℕ) : M) := by
          rw [Nat.cast_succ]
          exact hPM_add ih.1 hPM_one
        refine ⟨hval_succ, ?_⟩
        rw [Nat.cast_succ, (hresM_ring (n : M) 1 ih.1 hPM_one).1, ih.2, hresM_1, Nat.cast_succ]
    have hp_valM : PM 1 ((p F : ℕ) : M) := by
      let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      have hres0 : IsLocalRing.residue 𝒪[F] ((p F : ℕ) : 𝒪[F]) = 0 := by
        rw [map_natCast]
        exact CharP.cast_eq_zero 𝓀[F] (p F)
      have hker : valuation F (((p F : ℕ) : 𝒪[F]) : F) < 1 := by
        rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
      have hpF : ((p F : ℕ) : F) = 0 ∨ 1 ≤ addVal F ((p F : ℕ) : F) := by
        by_cases hp0 : ((p F : ℕ) : F) = 0
        · exact Or.inl hp0
        · right
          have hφp : φ (valuation F ((p F : ℕ) : F)) ≠ 0 :=
            (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
          have hlt : φ (valuation F ((p F : ℕ) : F)) < 1 := by
            rw [← map_one φ, map_lt_map_iff φ]
            exact hker
          rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
            ← Multiplicative.toAdd_lt, toAdd_one] at hlt
          unfold addVal
          rw [dif_neg hp0]
          omega
      have h := halg1 ((p F : ℕ) : F) hpF
      rwa [map_natCast (algebraMap F M) (p F)] at h
    have hp_kM : ((p F : ℕ) : k_M) = 0 := by
      rw [← (hresM_nat (p F)).2]
      exact (hresM_ker ((p F : ℕ) : M) (hresM_nat (p F)).1).mpr hp_valM
    have hfrob_p_inj : Function.Injective (fun a : k_M => a ^ (p F)) := by
      intro a₁ a₂ h
      change a₁ ^ (p F) = a₂ ^ (p F) at h
      set d : k_M := a₁ - a₂
      have ha₁_eq : a₁ = a₂ + d := by dsimp [d]; ring
      have h_exp : (a₂ + d) ^ (p F) =
          (∑ j ∈ Finset.range (p F), a₂ ^ j * d ^ (p F - j) * ((p F).choose j : k_M)) +
            a₂ ^ (p F) := by
        have h1 := add_pow a₂ d (p F)
        rw [Finset.sum_range_succ] at h1
        simp only [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one] at h1
        exact h1
      have h_sum_single :
          (∑ j ∈ Finset.range (p F), a₂ ^ j * d ^ (p F - j) * ((p F).choose j : k_M)) =
            d ^ (p F) := by
        have h0 : (∑ j ∈ Finset.range (p F), a₂ ^ j * d ^ (p F - j) * ((p F).choose j : k_M)) =
            a₂ ^ 0 * d ^ (p F - 0) * ((p F).choose 0 : k_M) := by
          refine Finset.sum_eq_single 0 ?_ ?_
          · intro j hj hj0
            rw [Finset.mem_range] at hj
            rcases Nat.Prime.dvd_choose_self hp_prime hj0 hj with ⟨c, hc⟩
            have hch0 : ((p F).choose j : k_M) = 0 := by
              rw [hc, Nat.cast_mul, hp_kM, zero_mul]
            rw [hch0, mul_zero]
          · intro hnot
            exact False.elim (hnot (Finset.mem_range.mpr hp_prime.pos))
        simpa using h0
      have hd_pow : d ^ (p F) = 0 := by
        rw [ha₁_eq, h_exp, h_sum_single] at h
        linear_combination h
      exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hd_pow)
    have hfrob_p_surj : Function.Surjective (fun a : k_M => a ^ (p F)) :=
      Finite.surjective_of_injective hfrob_p_inj
    have hfrob_m_surj : ∀ n : ℕ, Function.Surjective (fun a : k_M => a ^ ((p F) ^ n)) := by
      intro n
      induction n with
      | zero =>
        intro b
        exact ⟨b, by simp⟩
      | succ n ih =>
        intro b
        obtain ⟨c, hc⟩ := ih b
        obtain ⟨a, ha⟩ := hfrob_p_surj c
        refine ⟨a, ?_⟩
        dsimp only at ha hc ⊢
        rw [pow_succ', pow_mul, ha, hc]
    obtain ⟨a, ha⟩ := hfrob_m_surj m (resM x)
    dsimp only at ha
    obtain ⟨s, hs_int, hs_res⟩ := hresM_surj a
    refine ⟨s, hs_int, ?_⟩
    have hs_pow := hresM_pow s ((p F) ^ m) hs_int
    have hdiff_int : PM 0 (x - s ^ ((p F) ^ m)) := hPM_sub hx hs_pow.1
    have hdiff_res : resM (x - s ^ ((p F) ^ m)) = 0 := by
      rw [sub_eq_add_neg, (hresM_ring x (-(s ^ ((p F) ^ m))) hx (hPM_neg hs_pow.1)).1,
        (hresM_ring (s ^ ((p F) ^ m)) 0 hs_pow.1 (hPM_zero 0)).2.2,
        hs_pow.2, hs_res, ha, add_neg_cancel]
    exact (hresM_ker (x - s ^ ((p F) ^ m)) hdiff_int).mp hdiff_res

  
  have helper_isGalois : ∀ (k₀ Ω_bar : Type u) [Field k₀] [Field Ω_bar] [Algebra k₀ Ω_bar]
      [Normal k₀ Ω_bar] (K₀ : IntermediateField k₀ Ω_bar) [hSepK₀ : Algebra.IsSeparable k₀ K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k₀] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k₀ K₀ := by
    intro k₀ Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k₀ Ω_bar := separableClosure k₀ Ω_bar
    haveI : IsGalois k₀ N := separableClosure.isGalois k₀ Ω_bar
    haveI : Normal k₀ N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k₀ x := @Algebra.IsSeparable.isSeparable k₀ K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k₀ z = minpoly k₀ x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k₀ z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k₀ N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
