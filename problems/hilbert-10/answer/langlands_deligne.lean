theorem ld_ch12_wild_odd_tot_ram_q3_trunc_log_and_norm_conv_eval (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bM₁' : ℤ))
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (θ₁ : M₁'ˣ →* (Ω F)ˣ)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (α β γ : Lˣ) (w₁ A₁ C₁ : M₁'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hβ_val : valL F L (β : L) = -(bM₁' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₁_val : valL F M₁' (w₁ : M₁') = -((a_lam - bM₁' : ℕ) : ℤ))
    (hw₁_norm : Units.map (normLM F hLM₁') w₁ = γ * β⁻¹)
    (hA₁_eq : (A₁ : M₁') = IntermediateField.inclusion hLM₁' (γ : L) +
      IntermediateField.inclusion hLM₁' (α : L) * normLM F hM₁'K₁ (Δ : K₁))
    (hC₁_eq : (C₁ : M₁') = (A₁ : M₁') -
      IntermediateField.inclusion hLM₁' (β : L) * (w₁ : M₁'))
    (hθ₁_log :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let mM₁'_θ₁ := bM₁' + p * (a_lam - bM₁')
      let q_θ₁ := (mM₁'_θ₁ + p - 1) / p
      ∀ z : M₁', (z = 0 ∨ (q_θ₁ : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 - z ≠ 0,
          (θ₁ (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
            (traceChar F hLM₁' ψ) (2 * (C₁ : M₁') *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j)))
    (hConv_M₁' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let ct := (bM₁' - 1 + p - 1) / p
      ∀ z : M₁', (z = 0 ∨ (ct : ℤ) ≤ valL F M₁' z) →
        (traceChar F hLM₁' ψ) (2 * IntermediateField.inclusion hLM₁' (β : L) * z) =
          ψ (- 2 * (β : L) * normLM F hLM₁' z))
    (hψ_triv : ∀ x : L,
      (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hψM₁'_triv : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
      (traceChar F hLM₁' ψ) z = 1)
    (s_LM₁' : M₁' → ℕ → L)
    (hs_LM₁'_val : ∀ (w : M₁') (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F M₁' w) →
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤
            (r : ℤ) * q →
        (s_LM₁' w r = 0 ∨ m ≤ valL F L (s_LM₁' w r)))
    (hs_LM₁'_norm_one_add : ∀ w : M₁',
      normLM F hLM₁' (1 + w) - 1 =
        (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          s_LM₁' w r) + normLM F hLM₁' w)
    (h1n_ne0 :
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let n := IntermediateField.inclusion hLM₁' u * b
      1 + n ≠ 0)
    (h1n_val0 :
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let n := IntermediateField.inclusion hLM₁' u * b
      valL F M₁' (1 + n) = 0) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let ψM₁' := traceChar F hLM₁' ψ
    let a := normLM F hE'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let v := (β : L) * ((α⁻¹ : Lˣ) : L)
    let D := 1 + u ^ p * normLM F hLE' a
    D ≠ 0 ∧ valL F L D = 0 ∧
    ((ψM₁' (- 2 * IntermediateField.inclusion hLM₁' (β : L) * (w₁ : M₁')) *
        (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2)⁻¹) ^ 2 =
      ψ (2 * (α : L) * (- W * (v * u) ^ (p - 1) * D⁻¹)) :=
by
  intro p ψM₁' a u W v D
  let b : M₁' := normLM F hM₁'K₁ (Δ : K₁)
  let n : M₁' := IntermediateField.inclusion hLM₁' u * b
  let t₁ : ℕ := bM₁' - 1
  let m : ℕ := a_lam - bE'
  let h₀ : ℕ := a_lam - bM₁'
  let ι_LM₁' := IntermediateField.inclusion hLM₁'
  let ι_M₁'K₁ := IntermediateField.inclusion hM₁'K₁

  
  have hp_ne2 : p ≠ 2 := by
    change Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2
    rw [hWild]
    exact hp_odd
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by
    change 3 ≤ Module.finrank L (IntermediateField.extendScalars hLE')
    omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hh₀_ge1 : 1 ≤ h₀ := by dsimp [h₀]; omega
  have hm_le_h₀ : m ≤ h₀ := by dsimp [m, h₀]; omega
  have hp_pos_int : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos

  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_exists,
    hvalL_add, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv, _,
    hvalM₁'_add, _⟩ := ld_valL_and_unitGroup_props F M₁'

  have hval_helpers : ∀ {M : Type u} [Field M] (v : M → ℤ),
      v 1 = 0 →
      v (-1) = 0 →
      (∀ x : M, v (-x) = v x) →
      (∀ x y : M, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
      (∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) → (x + y = 0 ∨ k ≤ v (x + y))) →
      (∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y))) ∧
      (∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) →
        (x - y = 0 ∨ k ≤ v (x - y))) ∧
      (∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x))) ∧
      (∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M)) ∧
      (∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M)) ∧
      (∀ (x : M) (r : ℕ), x ≠ 0 → x ^ r ≠ 0 ∧ v (x ^ r) = (r : ℤ) * v x) ∧
      (∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ v ((-1 : M) ^ r) = 0) ∧
      (∀ x : M, (x = 0 ∨ 1 ≤ v x) → 1 + x ≠ 0 ∧ v (1 + x) = 0) := by
    intro M _ v hv1 hvneg1 h_neg h_mul h_add
    have hmul_b : ∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y)) := by
      intro m₁ m₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          have hvx : m₁ ≤ v x := hx.resolve_left hx0
          have hvy : m₂ ≤ v y := hy.resolve_left hy0
          rw [h_mul x y hx0 hy0]
          linarith
    have hsub_b : ∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) →
        (x - y = 0 ∨ k ≤ v (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      apply h_add k x (-y) hx
      rcases hy with rfl | hvy
      · left; exact neg_zero
      · right; rwa [h_neg]
    have hsum_b : ∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x)) := by
      intro α s f k hs
      induction s using Finset.induction_on with
      | empty => exact Or.inl Finset.sum_empty
      | @insert x s' hx ih =>
        rw [Finset.sum_insert hx]
        exact h_add k (f x) (∑ y ∈ s', f y)
          (hs x (Finset.mem_insert_self x s'))
          (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
    have hnat_b : ∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M) := by
      intro n
      induction n with
      | zero => left; simp
      | succ m ih =>
        rw [Nat.cast_succ]
        exact h_add 0 (m : M) 1 ih (Or.inr (by rw [hv1]))
    have hint_b : ∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M) := by
      intro z
      cases z with
      | ofNat n => simpa using hnat_b n
      | negSucc n =>
        rw [Int.cast_negSucc]
        rcases hnat_b (n + 1) with h0 | hge
        · left; exact neg_eq_zero.mpr h0
        · right; rw [h_neg]; exact hge
    have hpow_b : ∀ (x : M) (r : ℕ), x ≠ 0 → x ^ r ≠ 0 ∧ v (x ^ r) = (r : ℤ) * v x := by
      intro x r hx
      induction r with
      | zero =>
        rw [pow_zero, Nat.cast_zero, zero_mul]
        exact ⟨one_ne_zero, hv1⟩
      | succ r ih =>
        rw [pow_succ]
        have hne : x ^ r * x ≠ 0 := mul_ne_zero ih.1 hx
        refine ⟨hne, ?_⟩
        rw [h_mul (x ^ r) x ih.1 hx, ih.2]
        push_cast
        ring
    have hneg1_pow_b : ∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ v ((-1 : M) ^ r) = 0 := by
      intro r
      have h := hpow_b (-1 : M) r (neg_ne_zero.mpr one_ne_zero)
      rw [hvneg1, mul_zero] at h
      exact h
    have hone_add_b : ∀ x : M, (x = 0 ∨ 1 ≤ v x) → 1 + x ≠ 0 ∧ v (1 + x) = 0 := by
      intro x hx
      have hx0 : x = 0 ∨ 0 ≤ v x := by
        rcases hx with rfl | hge
        · exact Or.inl rfl
        · exact Or.inr (by omega)
      have hge0 : 1 + x = 0 ∨ 0 ≤ v (1 + x) :=
        h_add 0 1 x (Or.inr (by rw [hv1])) hx0
      have hnot1 : ¬ (1 + x = 0 ∨ 1 ≤ v (1 + x)) := by
        intro hbad
        have h1 : (1 + x) - x = 0 ∨ 1 ≤ v ((1 + x) - x) := hsub_b 1 (1 + x) x hbad hx
        rw [add_sub_cancel_right, hv1] at h1
        rcases h1 with h10 | h1le0
        · exact one_ne_zero h10
        · omega
      have hne0 : 1 + x ≠ 0 := fun h0 => hnot1 (Or.inl h0)
      have hv_ge0 : 0 ≤ v (1 + x) := hge0.resolve_left hne0
      have hv_lt1 : v (1 + x) < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot1 (Or.inr hge1)
      exact ⟨hne0, by omega⟩
    exact ⟨hmul_b, hsub_b, hsum_b, hnat_b, hint_b, hpow_b, hneg1_pow_b, hone_add_b⟩

  obtain ⟨hmul_L, hsub_L, hsum_L, _, _, hpow_L, _, hone_add_L⟩ :=
    hval_helpers (valL F L) hvalL_1 hvalL_neg1 hvalL_neg hvalL_mul hvalL_add
  obtain ⟨hmul_M₁', hsub_M₁', hsum_M₁', hnat_M₁', hint_M₁', hpow_M₁', _, hone_add_M₁'⟩ :=
    hval_helpers (valL F M₁') hvalM₁'_1 hvalM₁'_neg1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_add

  have hvalL_inv0 : ∀ (x : L) (hx : x ≠ 0), valL F L (x⁻¹) = - valL F L x := by
    intro x hx
    have h := hvalL_inv (Units.mk0 x hx)
    rwa [Units.val_inv_eq_inv_val] at h
  have hvalM₁'_inv0 : ∀ (z : M₁') (hz : z ≠ 0), valL F M₁' (z⁻¹) = - valL F M₁' z := by
    intro z hz
    have h := hvalM₁'_inv (Units.mk0 z hz)
    rwa [Units.val_inv_eq_inv_val] at h

  
  have hα_ne0 : (α : L) ≠ 0 := Units.ne_zero α
  have hβ_ne0 : (β : L) ≠ 0 := Units.ne_zero β
  have hγ_ne0 : (γ : L) ≠ 0 := Units.ne_zero γ
  have hγ_inv_ne0 : ((γ⁻¹ : Lˣ) : L) ≠ 0 := Units.ne_zero (γ⁻¹)
  have hu_ne0 : u ≠ 0 := mul_ne_zero hα_ne0 hγ_inv_ne0
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) hα_ne0 hγ_inv_ne0, hvalL_inv γ, hα_val, hγ_val]
    omega
  have hvu_eq : v * u = (β : L) * ((γ⁻¹ : Lˣ) : L) := by
    have hα_inv : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    dsimp [v, u]
    linear_combination ((β : L) * ((γ⁻¹ : Lˣ) : L)) * hα_inv
  have hvu_ne0 : v * u ≠ 0 := by
    rw [hvu_eq]
    exact mul_ne_zero hβ_ne0 hγ_inv_ne0
  have hvu_val : valL F L (v * u) = (h₀ : ℤ) := by
    dsimp [h₀]
    rw [hvu_eq, hvalL_mul (β : L) ((γ⁻¹ : Lˣ) : L) hβ_ne0 hγ_inv_ne0, hvalL_inv γ, hβ_val, hγ_val]
    omega
  have hαW_eq : (α : L) * W = (γ : L) := by
    have hα_inv : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    dsimp [W]
    linear_combination (γ : L) * hα_inv

  have hNa_val : valL F L (normLM F hLE' a) = -(t₁ : ℤ) := by
    dsimp [a, t₁]
    rw [hval_norm_LE', hval_norm_E'K₁, hΔ_val]
  have hNa_ne0 : normLM F hLE' a ≠ 0 := by
    intro h0
    rw [h0, hvalL_0] at hNa_val
    omega
  obtain ⟨hu_pow_ne0, hu_pow_val⟩ := hpow_L u p hu_ne0
  have hupNa_ne0 : u ^ p * normLM F hLE' a ≠ 0 := mul_ne_zero hu_pow_ne0 hNa_ne0
  have hupNa_val : valL F L (u ^ p * normLM F hLE' a) = (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    rw [hvalL_mul (u ^ p) (normLM F hLE' a) hu_pow_ne0 hNa_ne0, hu_pow_val, hu_val, hNa_val]
    ring
  have hpm_ge1 : 1 ≤ (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    have h_lt : (t₁ : ℤ) < (p : ℤ) * (m : ℤ) := by exact_mod_cast hpm_gt_t₁
    omega
  obtain ⟨hD_ne0, hD_val0⟩ :=
    hone_add_L (u ^ p * normLM F hLE' a) (Or.inr (by rw [hupNa_val]; exact hpm_ge1))
  have hD_inv_ne0 : D⁻¹ ≠ 0 := inv_ne_zero hD_ne0
  have hD_inv_val0 : valL F L (D⁻¹) = 0 := by
    rw [hvalL_inv0 D hD_ne0, hD_val0, neg_zero]

  
  have hnorm_incl_raw : ∀ x : L,
      normLM F hLM₁' (ι_LM₁' x) =
        x ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) := by
    intro x
    change Algebra.norm L (toExtendScalars F hLM₁' (IntermediateField.inclusion hLM₁' x)) = _
    have hext : toExtendScalars F hLM₁' (IntermediateField.inclusion hLM₁' x) =
        algebraMap L (IntermediateField.extendScalars hLM₁') x := rfl
    rw [hext, Algebra.norm_algebraMap]
  have hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = p := by
    obtain ⟨c, hc_val⟩ := hvalL_exists 1
    have hc_ne0 : (c : L) ≠ 0 := Units.ne_zero c
    let dM := Module.finrank L (IntermediateField.extendScalars hLM₁')
    have h1 : valL F L (normLM F hLM₁' (ι_LM₁' (c : L))) = (p : ℤ) := by
      rw [hval_norm_LM₁', hval_LM₁', hc_val, mul_one]
    have h2 : valL F L (normLM F hLM₁' (ι_LM₁' (c : L))) = (dM : ℤ) := by
      rw [hnorm_incl_raw (c : L), (hpow_L (c : L) dM hc_ne0).2, hc_val, mul_one]
    have h3 : (dM : ℤ) = (p : ℤ) := h2.symm.trans h1
    exact_mod_cast h3
  have hnorm_incl : ∀ x : L, normLM F hLM₁' (ι_LM₁' x) = x ^ p := by
    intro x
    rw [hnorm_incl_raw x, hdegM₁']

  
  have hp_valM₁' : ((p : ℕ) : M₁') = 0 ∨ 1 ≤ valL F M₁' ((p : ℕ) : M₁') := by
    have hincl_p : ι_M₁'K₁ ((p : ℕ) : M₁') = ((p : ℕ) : K₁) := map_natCast ι_M₁'K₁ p
    rcases hp_valK₁ with h0 | hge
    · left
      have h0_eq : ι_M₁'K₁ ((p : ℕ) : M₁') = ι_M₁'K₁ 0 := by
        rw [hincl_p, map_zero]
        exact h0
      exact ι_M₁'K₁.injective h0_eq
    · right
      rw [← hincl_p, hval_M₁'K₁ ((p : ℕ) : M₁')] at hge
      have hp_le : (p : ℤ) * 1 ≤ ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) := by
        have h_nat : p * 1 ≤ p * (p - 1) * (bE' - 1) := by
          have h1 : 1 ≤ (p - 1) * (bE' - 1) := Nat.mul_pos (by omega) (by omega)
          have h2 : p * 1 ≤ p * ((p - 1) * (bE' - 1)) := Nat.mul_le_mul_left p h1
          rwa [← mul_assoc] at h2
        exact_mod_cast h_nat
      have hmul_le : (p : ℤ) * 1 ≤ (p : ℤ) * valL F M₁' ((p : ℕ) : M₁') := le_trans hp_le hge
      exact le_of_mul_le_mul_left hmul_le hp_pos_int

  have hcoprime_val_M₁' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      ((k : ℕ) : M₁') ≠ 0 ∧ valL F M₁' ((k : ℕ) : M₁') = 0 := by
    intro k hk
    obtain ⟨hk1, hkp1⟩ := Finset.mem_Icc.mp hk
    have hnot_ge1 : ¬ (((k : ℕ) : M₁') = 0 ∨ 1 ≤ valL F M₁' ((k : ℕ) : M₁')) := by
      intro hk_bad
      have hndvd : ¬ (p ∣ k) := Nat.not_dvd_of_pos_of_lt hk1 (by omega)
      have hcop : Nat.Coprime p k := (Nat.Prime.coprime_iff_not_dvd hPrime).mpr hndvd
      have hgcd : Nat.gcd k p = 1 := Nat.Coprime.gcd_eq_one hcop.symm
      have hbez_int : (1 : ℤ) = (k : ℤ) * Nat.gcdA k p + (p : ℤ) * Nat.gcdB k p := by
        have h := Nat.gcd_eq_gcd_ab k p
        rw [hgcd] at h
        simpa using h
      have hbez_M₁' : (1 : M₁') =
          ((k : ℕ) : M₁') * (Nat.gcdA k p : M₁') + ((p : ℕ) : M₁') * (Nat.gcdB k p : M₁') := by
        have h := congrArg (Int.cast : ℤ → M₁') hbez_int
        push_cast at h
        exact h
      have hterm1 : ((k : ℕ) : M₁') * (Nat.gcdA k p : M₁') = 0 ∨
          1 ≤ valL F M₁' (((k : ℕ) : M₁') * (Nat.gcdA k p : M₁')) := by
        have h := hmul_M₁' 1 0 ((k : ℕ) : M₁') (Nat.gcdA k p : M₁') hk_bad (hint_M₁' (Nat.gcdA k p))
        rwa [add_zero] at h
      have hterm2 : ((p : ℕ) : M₁') * (Nat.gcdB k p : M₁') = 0 ∨
          1 ≤ valL F M₁' (((p : ℕ) : M₁') * (Nat.gcdB k p : M₁')) := by
        have h := hmul_M₁' 1 0 ((p : ℕ) : M₁') (Nat.gcdB k p : M₁') hp_valM₁' (hint_M₁' (Nat.gcdB k p))
        rwa [add_zero] at h
      have hsum := hvalM₁'_add 1 _ _ hterm1 hterm2
      rw [← hbez_M₁', hvalM₁'_1] at hsum
      rcases hsum with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    rcases hnat_M₁' k with hk0 | hk_ge0
    · exact False.elim (hnot_ge1 (Or.inl hk0))
    · refine ⟨fun hk0 => hnot_ge1 (Or.inl hk0), ?_⟩
      have hk_lt1 : valL F M₁' ((k : ℕ) : M₁') < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot_ge1 (Or.inr hge1)
      omega

  have h2_mem : (2 : ℕ) ∈ Finset.Icc 1 (p - 1) := by
    rw [Finset.mem_Icc]; omega
  obtain ⟨h2_M₁'_ne0_nat, h2_M₁'_val0_nat⟩ := hcoprime_val_M₁' h2_mem
  have h2_M₁'_ne0 : (2 : M₁') ≠ 0 := by simpa using h2_M₁'_ne0_nat
  have h2_M₁'_val0 : valL F M₁' (2 : M₁') = 0 := by simpa using h2_M₁'_val0_nat
  have h2_L_ne0 : (2 : L) ≠ 0 := by
    intro h0
    apply h2_M₁'_ne0
    have h : ι_LM₁' (2 : L) = ι_LM₁' 0 := congrArg ι_LM₁' h0
    rw [map_ofNat, map_zero] at h
    exact h
  have h2_L_val0 : valL F L (2 : L) = 0 := by
    have h := hval_LM₁' (2 : L)
    have hcast : ι_LM₁' (2 : L) = (2 : M₁') := map_ofNat ι_LM₁' 2
    rw [hcast, h2_M₁'_val0] at h
    have hp_ne0 : (p : ℤ) ≠ 0 := ne_of_gt hp_pos_int
    exact (mul_eq_zero.mp h.symm).resolve_left hp_ne0

  
  have hγu_eq : (γ : L) * u = (α : L) := by
    have hγ_inv : (γ : L) * ((γ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv γ
    dsimp [u]
    linear_combination (α : L) * hγ_inv
  have hA₁_fac : (A₁ : M₁') = ι_LM₁' (γ : L) * (1 + n) := by
    dsimp [n, b, ι_LM₁']
    rw [hA₁_eq, ← hγu_eq, map_mul]
    ring
  have hγ_M₁'_ne0 : ι_LM₁' (γ : L) ≠ 0 := (map_ne_zero ι_LM₁').mpr hγ_ne0
  have hγ_M₁'_val : valL F M₁' (ι_LM₁' (γ : L)) =
      (p : ℤ) * (-(a_lam : ℤ) - condExpChar F L ψ) := by
    rw [hval_LM₁' (γ : L), hγ_val]
  have hA₁_ne0 : (A₁ : M₁') ≠ 0 := Units.ne_zero A₁
  have hA₁_val : valL F M₁' (A₁ : M₁') =
      (p : ℤ) * (-(a_lam : ℤ) - condExpChar F L ψ) := by
    rw [hA₁_fac, hvalM₁'_mul (ι_LM₁' (γ : L)) (1 + n) hγ_M₁'_ne0 h1n_ne0,
      hγ_M₁'_val, h1n_val0, add_zero]
  have hA₁_inv_ne0 : ((A₁⁻¹ : M₁'ˣ) : M₁') ≠ 0 := Units.ne_zero (A₁⁻¹)
  have hA₁_inv_val : valL F M₁' ((A₁⁻¹ : M₁'ˣ) : M₁') =
      - ((p : ℤ) * (-(a_lam : ℤ) - condExpChar F L ψ)) := by
    rw [hvalM₁'_inv A₁, hA₁_val]
  have hβ_M₁'_ne0 : ι_LM₁' (β : L) ≠ 0 := (map_ne_zero ι_LM₁').mpr hβ_ne0
  have hβ_M₁'_val : valL F M₁' (ι_LM₁' (β : L)) =
      (p : ℤ) * (-(bM₁' : ℤ) - condExpChar F L ψ) := by
    rw [hval_LM₁' (β : L), hβ_val]
  have hw₁_ne0 : (w₁ : M₁') ≠ 0 := Units.ne_zero w₁

  let z₃ : M₁' := ι_LM₁' (β : L) * (w₁ : M₁') * ((A₁⁻¹ : M₁'ˣ) : M₁')
  have hz₃_ne0 : z₃ ≠ 0 := mul_ne_zero (mul_ne_zero hβ_M₁'_ne0 hw₁_ne0) hA₁_inv_ne0
  have hz₃_val : valL F M₁' z₃ = ((p - 1 : ℕ) : ℤ) * (h₀ : ℤ) := by
    dsimp [z₃, h₀]
    rw [hvalM₁'_mul _ _ (mul_ne_zero hβ_M₁'_ne0 hw₁_ne0) hA₁_inv_ne0,
      hvalM₁'_mul _ _ hβ_M₁'_ne0 hw₁_ne0, hβ_M₁'_val, hw₁_val, hA₁_inv_val]
    have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
    have hh₀_cast : ((a_lam - bM₁' : ℕ) : ℤ) = (a_lam : ℤ) - (bM₁' : ℤ) :=
      Nat.cast_sub (by omega)
    rw [hp1_cast, hh₀_cast]
    ring

  have hA₁_mul_inv : (A₁ : M₁') * ((A₁⁻¹ : M₁'ˣ) : M₁') = 1 := Units.mul_inv A₁
  have hCA_val : ((C₁ * A₁⁻¹ : M₁'ˣ) : M₁') = 1 - z₃ := by
    change (C₁ : M₁') * ((A₁⁻¹ : M₁'ˣ) : M₁') = 1 - z₃
    dsimp [z₃]
    rw [hC₁_eq]
    linear_combination hA₁_mul_inv
  have hz₃_1_ne0 : 1 - z₃ ≠ 0 := by
    rw [← hCA_val]
    exact Units.ne_zero (C₁ * A₁⁻¹)
  have hmk0_z₃ : Units.mk0 (1 - z₃) hz₃_1_ne0 = C₁ * A₁⁻¹ :=
    Units.ext hCA_val.symm
  have hA₁_z₃ : (A₁ : M₁') * z₃ = ι_LM₁' (β : L) * (w₁ : M₁') := by
    dsimp [z₃]
    linear_combination (ι_LM₁' (β : L) * (w₁ : M₁')) * hA₁_mul_inv
  have hC₁_fac : (C₁ : M₁') = (A₁ : M₁') * (1 - z₃) := by
    rw [hC₁_eq, ← hA₁_z₃]
    ring
  have hz₃_ge1 : 1 ≤ valL F M₁' z₃ := by
    rw [hz₃_val]
    have h_nat : 1 ≤ (p - 1) * h₀ := Nat.mul_pos (by omega) (by omega)
    exact_mod_cast h_nat
  have h1_sub_z₃_val0 : valL F M₁' (1 - z₃) = 0 := by
    have h := (hone_add_M₁' (-z₃) (Or.inr (by rw [hvalM₁'_neg]; exact hz₃_ge1))).2
    rwa [← sub_eq_add_neg] at h
  have hC₁_val : valL F M₁' (C₁ : M₁') = valL F M₁' (A₁ : M₁') := by
    rw [hC₁_fac, hvalM₁'_mul (A₁ : M₁') (1 - z₃) hA₁_ne0 hz₃_1_ne0, h1_sub_z₃_val0, add_zero]

  
  have hpm_le_ph₀ : p * m ≤ p * h₀ := Nat.mul_le_mul_left p hm_le_h₀
  have hbM₁'_le_ph₀ : bM₁' ≤ p * h₀ := by omega
  have hh₀_le_p2h₀ : h₀ ≤ (p - 2) * h₀ := Nat.le_mul_of_pos_left h₀ (by omega)
  have hph₀_le_pp2h₀ : p * h₀ ≤ p * ((p - 2) * h₀) := Nat.mul_le_mul_left p hh₀_le_p2h₀
  have hp1_split : (p - 1) * h₀ = (p - 2) * h₀ + h₀ := by
    have h : p - 1 = (p - 2) + 1 := by omega
    rw [h, add_mul, one_mul]
  have hpp1_split : p * ((p - 1) * h₀) = p * ((p - 2) * h₀) + p * h₀ := by
    rw [hp1_split, mul_add]

  let mM₁'_θ₁ : ℕ := bM₁' + p * h₀
  let q_θ₁ : ℕ := (mM₁'_θ₁ + p - 1) / p
  have hq_θ₁_nat : q_θ₁ ≤ (p - 1) * h₀ := by
    dsimp [q_θ₁, mM₁'_θ₁]
    by_contra h_not
    push_neg at h_not
    have h1 : ((p - 1) * h₀ + 1) * p ≤ ((bM₁' + p * h₀ + p - 1) / p) * p :=
      Nat.mul_le_mul_right p h_not
    have h2 : ((bM₁' + p * h₀ + p - 1) / p) * p ≤ bM₁' + p * h₀ + p - 1 :=
      Nat.div_mul_le_self (bM₁' + p * h₀ + p - 1) p
    have h3 : ((p - 1) * h₀ + 1) * p = p * ((p - 1) * h₀) + p := by ring
    omega
  have hq_θ₁_le : (q_θ₁ : ℤ) ≤ valL F M₁' z₃ := by
    rw [hz₃_val]
    exact_mod_cast hq_θ₁_nat

  have hθ₁_sq_raw :
      (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2 =
        ψM₁' (2 * (C₁ : M₁') * (∑ j ∈ Finset.Icc 1 (p - 1), (((j : ℕ) : M₁')⁻¹ * z₃ ^ j))) := by
    rw [← hmk0_z₃]
    exact hθ₁_log z₃ (Or.inr hq_θ₁_le) hz₃_1_ne0

  have hIcc_split : Finset.Icc 1 (p - 1) = insert 1 (insert 2 (Finset.Icc 3 (p - 1))) := by
    ext j
    simp only [Finset.mem_Icc, Finset.mem_insert]
    omega
  have h1_not_mem : (1 : ℕ) ∉ insert 2 (Finset.Icc 3 (p - 1)) := by
    simp only [Finset.mem_insert, Finset.mem_Icc]
    omega
  have h2_not_mem : (2 : ℕ) ∉ Finset.Icc 3 (p - 1) := by
    simp only [Finset.mem_Icc]
    omega
  let S_ge3 : M₁' := ∑ j ∈ Finset.Icc 3 (p - 1), (((j : ℕ) : M₁')⁻¹ * z₃ ^ j)
  have hsum_split :
      (∑ j ∈ Finset.Icc 1 (p - 1), (((j : ℕ) : M₁')⁻¹ * z₃ ^ j)) =
        z₃ + (2 : M₁')⁻¹ * z₃ ^ 2 + S_ge3 := by
    rw [hIcc_split, Finset.sum_insert h1_not_mem, Finset.sum_insert h2_not_mem]
    dsimp [S_ge3]
    simp only [Nat.cast_one, inv_one, one_mul, pow_one, Nat.cast_ofNat]
    ring

  let R_θ₁ : M₁' := - ((A₁ : M₁') * z₃ ^ 3) + 2 * (C₁ : M₁') * S_ge3
  have h2_inv_cancel_M₁' : (2 : M₁') * (2 : M₁')⁻¹ = 1 := mul_inv_cancel₀ h2_M₁'_ne0
  have hlog_arg_eq :
      2 * (C₁ : M₁') * (∑ j ∈ Finset.Icc 1 (p - 1), (((j : ℕ) : M₁')⁻¹ * z₃ ^ j)) =
        (2 * (A₁ : M₁') * z₃ - (A₁ : M₁') * z₃ ^ 2) + R_θ₁ := by
    rw [hsum_split]
    dsimp [R_θ₁]
    rw [hC₁_fac]
    linear_combination ((A₁ : M₁') * (1 - z₃) * z₃ ^ 2) * h2_inv_cancel_M₁'

  have hmM₁'_le_3 : mM₁'_θ₁ ≤ 3 * ((p - 1) * h₀) := by
    dsimp [mM₁'_θ₁]
    have h_mul : p * h₀ ≤ (2 * p - 3) * h₀ := Nat.mul_le_mul_right h₀ (by omega)
    have h_id : p * h₀ + (2 * p - 3) * h₀ = 3 * ((p - 1) * h₀) := by
      rw [← add_mul, ← mul_assoc]
      congr 1
      omega
    omega

  have hS_ge3_val : S_ge3 = 0 ∨ (mM₁'_θ₁ : ℤ) ≤ valL F M₁' S_ge3 := by
    apply @hsum_M₁' ℕ (Finset.Icc 3 (p - 1))
      (fun j => (((j : ℕ) : M₁')⁻¹ * z₃ ^ j)) (mM₁'_θ₁ : ℤ)
    intro j hj
    obtain ⟨hj3, hjp1⟩ := Finset.mem_Icc.mp hj
    have hj_Icc1 : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hjp1⟩
    obtain ⟨hj_ne0, hj_val0⟩ := hcoprime_val_M₁' hj_Icc1
    have hj_inv_ne0 : (((j : ℕ) : M₁')⁻¹) ≠ 0 := inv_ne_zero hj_ne0
    have hj_inv_val0 : valL F M₁' (((j : ℕ) : M₁')⁻¹) = 0 := by
      rw [hvalM₁'_inv0 ((j : ℕ) : M₁') hj_ne0, hj_val0, neg_zero]
    obtain ⟨hz₃_j_ne0, hz₃_j_val⟩ := hpow_M₁' z₃ j hz₃_ne0
    right
    rw [hvalM₁'_mul (((j : ℕ) : M₁')⁻¹) (z₃ ^ j) hj_inv_ne0 hz₃_j_ne0,
      hj_inv_val0, zero_add, hz₃_j_val, hz₃_val]
    have hj_le : 3 * ((p - 1) * h₀) ≤ j * ((p - 1) * h₀) :=
      Nat.mul_le_mul_right ((p - 1) * h₀) hj3
    have hm_le_j : mM₁'_θ₁ ≤ j * ((p - 1) * h₀) := le_trans hmM₁'_le_3 hj_le
    exact_mod_cast hm_le_j

  have hz₃_3_val : valL F M₁' (z₃ ^ 3) = (3 * ((p - 1) * h₀) : ℕ) := by
    rw [(hpow_M₁' z₃ 3 hz₃_ne0).2, hz₃_val]
    push_cast
    ring
  have hcond_M₁'_split :
      valL F M₁' (A₁ : M₁') + (mM₁'_θ₁ : ℤ) = - condExpChar F M₁' ψM₁' := by
    dsimp [ψM₁', mM₁'_θ₁, h₀]
    rw [hA₁_val, hnM₁'_eq]
    have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
    have hh₀_cast : ((a_lam - bM₁' : ℕ) : ℤ) = (a_lam : ℤ) - (bM₁' : ℤ) :=
      Nat.cast_sub (by omega)
    push_cast
    rw [hp1_cast, hh₀_cast]
    ring

  have hR_θ₁_val : R_θ₁ = 0 ∨ - condExpChar F M₁' ψM₁' ≤ valL F M₁' R_θ₁ := by
    dsimp [R_θ₁]
    have hterm1 : - ((A₁ : M₁') * z₃ ^ 3) = 0 ∨
        - condExpChar F M₁' ψM₁' ≤ valL F M₁' (- ((A₁ : M₁') * z₃ ^ 3)) := by
      right
      rw [hvalM₁'_neg, hvalM₁'_mul (A₁ : M₁') (z₃ ^ 3) hA₁_ne0 (hpow_M₁' z₃ 3 hz₃_ne0).1,
        hz₃_3_val, ← hcond_M₁'_split]
      have h_le : (mM₁'_θ₁ : ℤ) ≤ ((3 * ((p - 1) * h₀) : ℕ) : ℤ) := by exact_mod_cast hmM₁'_le_3
      omega
    have h2C₁_val : 2 * (C₁ : M₁') = 0 ∨
        valL F M₁' (A₁ : M₁') ≤ valL F M₁' (2 * (C₁ : M₁')) := by
      right
      rw [hvalM₁'_mul (2 : M₁') (C₁ : M₁') h2_M₁'_ne0 (Units.ne_zero C₁),
        h2_M₁'_val0, zero_add, hC₁_val]
    have hterm2 : 2 * (C₁ : M₁') * S_ge3 = 0 ∨
        - condExpChar F M₁' ψM₁' ≤ valL F M₁' (2 * (C₁ : M₁') * S_ge3) := by
      have h := hmul_M₁' (valL F M₁' (A₁ : M₁')) (mM₁'_θ₁ : ℤ)
        (2 * (C₁ : M₁')) S_ge3 h2C₁_val hS_ge3_val
      rwa [hcond_M₁'_split] at h
    exact hvalM₁'_add (- condExpChar F M₁' ψM₁') _ _ hterm1 hterm2

  have hψM₁'_R : ψM₁' R_θ₁ = 1 := hψM₁'_triv R_θ₁ hR_θ₁_val
  have hθ₁_sq_trunc :
      (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2 =
        ψM₁' (2 * (A₁ : M₁') * z₃ - (A₁ : M₁') * z₃ ^ 2) := by
    rw [hθ₁_sq_raw, hlog_arg_eq, AddChar.map_add_eq_mul, hψM₁'_R, mul_one]

  
  let y : M₁' := ι_LM₁' ((β : L) * ((γ⁻¹ : Lˣ) : L)) * (w₁ : M₁') ^ 2 * (1 + n)⁻¹
  have hA₁_inv_fac : ((A₁⁻¹ : M₁'ˣ) : M₁') = ι_LM₁' ((γ⁻¹ : Lˣ) : L) * (1 + n)⁻¹ := by
    have hγ_inv : (γ : L) * ((γ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv γ
    have hγ_inv_M₁' : ι_LM₁' (γ : L) * ι_LM₁' ((γ⁻¹ : Lˣ) : L) = 1 := by
      rw [← map_mul, hγ_inv, map_one]
    have h1n_inv : (1 + n) * (1 + n)⁻¹ = 1 := mul_inv_cancel₀ h1n_ne0
    have hmul1 : (A₁ : M₁') * (ι_LM₁' ((γ⁻¹ : Lˣ) : L) * (1 + n)⁻¹) = 1 := by
      rw [hA₁_fac]
      linear_combination (1 + n) * (1 + n)⁻¹ * hγ_inv_M₁' + h1n_inv
    have hinv_eq : (A₁ : M₁')⁻¹ = ι_LM₁' ((γ⁻¹ : Lˣ) : L) * (1 + n)⁻¹ :=
      (eq_inv_of_mul_eq_one_right hmul1).symm
    rw [Units.val_inv_eq_inv_val, hinv_eq]

  have hy_eq_w₁z₃ : y = (w₁ : M₁') * z₃ := by
    dsimp [y, z₃]
    rw [hA₁_inv_fac, map_mul]
    ring
  have hA₁_z₃_sq : (A₁ : M₁') * z₃ ^ 2 = ι_LM₁' (β : L) * y := by
    calc (A₁ : M₁') * z₃ ^ 2 = ((A₁ : M₁') * z₃) * z₃ := by ring
      _ = (ι_LM₁' (β : L) * (w₁ : M₁')) * z₃ := by rw [hA₁_z₃]
      _ = ι_LM₁' (β : L) * ((w₁ : M₁') * z₃) := by ring
      _ = ι_LM₁' (β : L) * y := by rw [hy_eq_w₁z₃]

  have hy_ne0 : y ≠ 0 := by
    rw [hy_eq_w₁z₃]
    exact mul_ne_zero hw₁_ne0 hz₃_ne0
  have hy_val : valL F M₁' y = ((p - 2 : ℕ) : ℤ) * (h₀ : ℤ) := by
    rw [hy_eq_w₁z₃, hvalM₁'_mul (w₁ : M₁') z₃ hw₁_ne0 hz₃_ne0, hw₁_val, hz₃_val]
    have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
    have hp2_cast : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := Nat.cast_sub (by omega)
    dsimp [h₀] at *
    rw [hp1_cast, hp2_cast]
    ring

  let ct : ℕ := (bM₁' - 1 + p - 1) / p
  have hct_nat : ct ≤ (p - 2) * h₀ := by
    dsimp [ct]
    by_contra h_not
    push_neg at h_not
    have h1 : ((p - 2) * h₀ + 1) * p ≤ ((bM₁' - 1 + p - 1) / p) * p :=
      Nat.mul_le_mul_right p h_not
    have h2 : ((bM₁' - 1 + p - 1) / p) * p ≤ bM₁' - 1 + p - 1 :=
      Nat.div_mul_le_self (bM₁' - 1 + p - 1) p
    have h3 : ((p - 2) * h₀ + 1) * p = p * ((p - 2) * h₀) + p := by ring
    omega
  have hct_le : (ct : ℤ) ≤ valL F M₁' y := by
    rw [hy_val]
    exact_mod_cast hct_nat

  let X₁ : M₁' := 2 * ι_LM₁' (β : L) * (w₁ : M₁')
  let X₂ : M₁' := ι_LM₁' (β : L) * y
  have hθ₁_sq_X : (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2 = ψM₁' (X₁ + (-X₂)) := by
    rw [hθ₁_sq_trunc]
    congr 1
    dsimp [X₁, X₂]
    linear_combination 2 * hA₁_z₃ - hA₁_z₃_sq
  have hprod_X :
      ψM₁' (- 2 * ι_LM₁' (β : L) * (w₁ : M₁')) * (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2 =
        ψM₁' (-X₂) := by
    have hneg_X₁ : - 2 * ι_LM₁' (β : L) * (w₁ : M₁') = - X₁ := by dsimp [X₁]; ring
    rw [hneg_X₁, hθ₁_sq_X, ← AddChar.map_add_eq_mul]
    congr 1
    ring
  have hinv_X₂ : (ψM₁' (-X₂))⁻¹ = ψM₁' X₂ := by
    symm
    apply eq_inv_of_mul_eq_one_left
    rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
  have hLHS_conv :
      ((ψM₁' (- 2 * ι_LM₁' (β : L) * (w₁ : M₁')) * (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2)⁻¹) ^ 2 =
        ψ (- 2 * (β : L) * normLM F hLM₁' y) := by
    rw [hprod_X, hinv_X₂, sq, ← AddChar.map_add_eq_mul]
    have h2X₂ : X₂ + X₂ = 2 * ι_LM₁' (β : L) * y := by dsimp [X₂]; ring
    rw [h2X₂]
    exact hConv_M₁' y (Or.inr hct_le)

  
  let N₁n : L := normLM F hLM₁' (1 + n)
  have h1n_inv_mul : (1 + n) * (1 + n)⁻¹ = 1 := mul_inv_cancel₀ h1n_ne0
  have hN₁n_mul_inv : N₁n * normLM F hLM₁' ((1 + n)⁻¹) = 1 := by
    dsimp [N₁n]
    rw [← map_mul, h1n_inv_mul, map_one]
  have hN₁n_ne0 : N₁n ≠ 0 := fun h0 => by
    rw [h0, zero_mul] at hN₁n_mul_inv
    exact zero_ne_one hN₁n_mul_inv
  have hnorm_1n_inv : normLM F hLM₁' ((1 + n)⁻¹) = N₁n⁻¹ :=
    eq_inv_of_mul_eq_one_right hN₁n_mul_inv
  have hN₁n_val0 : valL F L N₁n = 0 := by
    dsimp [N₁n]
    rw [hval_norm_LM₁' (1 + n), h1n_val0]
  have hN₁n_inv_ne0 : N₁n⁻¹ ≠ 0 := inv_ne_zero hN₁n_ne0
  have hN₁n_inv_val0 : valL F L (N₁n⁻¹) = 0 := by
    rw [hvalL_inv0 N₁n hN₁n_ne0, hN₁n_val0, neg_zero]

  have hw₁_norm_coe : normLM F hLM₁' (w₁ : M₁') = (γ : L) * ((β⁻¹ : Lˣ) : L) :=
    congrArg Units.val hw₁_norm
  have hnorm_y :
      normLM F hLM₁' y =
        (v * u) ^ (p - 1) * ((β : L) * ((γ⁻¹ : Lˣ) : L)) *
          ((γ : L) * ((β⁻¹ : Lˣ) : L)) ^ 2 * N₁n⁻¹ := by
    dsimp [y]
    rw [map_mul, map_mul, hnorm_incl ((β : L) * ((γ⁻¹ : Lˣ) : L)),
      map_pow, hw₁_norm_coe, hnorm_1n_inv, ← hvu_eq]
    have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp_pos).symm
    conv_lhs => rw [hp_eq, pow_succ]
  have hβγ_cancel :
      (β : L) * ((β : L) * ((γ⁻¹ : Lˣ) : L)) * ((γ : L) * ((β⁻¹ : Lˣ) : L)) ^ 2 = (γ : L) := by
    calc (β : L) * ((β : L) * ((γ⁻¹ : Lˣ) : L)) * ((γ : L) * ((β⁻¹ : Lˣ) : L)) ^ 2
        = ((β : L) * ((β⁻¹ : Lˣ) : L)) ^ 2 * ((γ : L) * ((γ⁻¹ : Lˣ) : L)) * (γ : L) := by ring
      _ = 1 ^ 2 * 1 * (γ : L) := by rw [Units.mul_inv β, Units.mul_inv γ]
      _ = (γ : L) := by ring
  have hnorm_y_arg :
      - 2 * (β : L) * normLM F hLM₁' y =
        2 * (α : L) * (- W * (v * u) ^ (p - 1) * N₁n⁻¹) := by
    calc - 2 * (β : L) * normLM F hLM₁' y
        = - 2 * (v * u) ^ (p - 1) *
            ((β : L) * ((β : L) * ((γ⁻¹ : Lˣ) : L)) * ((γ : L) * ((β⁻¹ : Lˣ) : L)) ^ 2) * N₁n⁻¹ := by
          rw [hnorm_y]; ring
      _ = - 2 * (v * u) ^ (p - 1) * ((α : L) * W) * N₁n⁻¹ := by
          rw [hβγ_cancel, hαW_eq]
      _ = 2 * (α : L) * (- W * (v * u) ^ (p - 1) * N₁n⁻¹) := by ring

  
  have hnorm_n_eq : normLM F hLM₁' n = u ^ p * normLM F hLE' a := by
    dsimp [n, b, a]
    rw [map_mul, hnorm_incl u, ← (hTowerNormTr (Δ : K₁)).1]
  have hN₁n_sub_D : N₁n - D = ∑ r ∈ Finset.Icc 1 (p - 1), s_LM₁' n r := by
    have h1 := hs_LM₁'_norm_one_add n
    change N₁n - 1 = (∑ r ∈ Finset.Icc 1 (p - 1), s_LM₁' n r) + normLM F hLM₁' n at h1
    rw [hnorm_n_eq] at h1
    dsimp [D]
    linear_combination h1

  have huM₁'_ne0 : ι_LM₁' u ≠ 0 := (map_ne_zero ι_LM₁').mpr hu_ne0
  have huM₁'_val : valL F M₁' (ι_LM₁' u) = (p : ℤ) * (m : ℤ) := by
    rw [hval_LM₁' u, hu_val]
  have hb_val : valL F M₁' b = -(t₁ : ℤ) := by
    dsimp [b, t₁]
    rw [hval_norm_M₁'K₁ (Δ : K₁), hΔ_val]
  have hb_ne0 : b ≠ 0 := by
    intro h0
    rw [h0, hvalM₁'_0] at hb_val
    omega
  have hn_ne0 : n ≠ 0 := mul_ne_zero huM₁'_ne0 hb_ne0
  let q_n : ℤ := (p : ℤ) * (m : ℤ) - (t₁ : ℤ)
  have hn_val : valL F M₁' n = q_n := by
    dsimp [n, q_n]
    rw [hvalM₁'_mul (ι_LM₁' u) b huM₁'_ne0 hb_ne0, huM₁'_val, hb_val]
    ring

  let m_target : ℤ := (a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) * (h₀ : ℤ)
  have hN₁n_D_val : N₁n - D = 0 ∨ m_target ≤ valL F L (N₁n - D) := by
    rw [hN₁n_sub_D]
    apply @hsum_L ℕ (Finset.Icc 1 (p - 1)) (fun r => s_LM₁' n r) m_target
    intro r hr
    obtain ⟨hr1, _⟩ := Finset.mem_Icc.mp hr
    apply hs_LM₁'_val n r hr q_n m_target (Or.inr (le_of_eq hn_val.symm))
    have hr_ge1 : (1 : ℤ) ≤ (r : ℤ) := by exact_mod_cast hr1
    have hqn_ge1 : (1 : ℤ) ≤ q_n := hpm_ge1
    have hrq_ge1 : (1 : ℤ) ≤ (r : ℤ) * q_n := by nlinarith
    have hbM₁'_le_int : (bM₁' : ℤ) ≤ (p : ℤ) * (((p - 2 : ℕ) : ℤ) * (h₀ : ℤ)) := by
      have h_nat : bM₁' ≤ p * ((p - 2) * h₀) := le_trans hbM₁'_le_ph₀ hph₀_le_pp2h₀
      exact_mod_cast h_nat
    have hlhs_eq :
        (p : ℤ) * m_target - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) =
          (bM₁' : ℤ) - (p : ℤ) * (((p - 2 : ℕ) : ℤ) * (h₀ : ℤ)) := by
      dsimp [m_target, h₀]
      have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
      have hp2_cast : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := Nat.cast_sub (by omega)
      have hh₀_cast : ((a_lam - bM₁' : ℕ) : ℤ) = (a_lam : ℤ) - (bM₁' : ℤ) :=
        Nat.cast_sub (by omega)
      rw [hp1_cast, hp2_cast, hh₀_cast]
      ring
    linarith

  
  have hinv_diff : - N₁n⁻¹ = - D⁻¹ + N₁n⁻¹ * D⁻¹ * (N₁n - D) := by
    calc - N₁n⁻¹ = - (N₁n⁻¹ * (D * D⁻¹)) + (N₁n * N₁n⁻¹) * D⁻¹ - 1 * D⁻¹ := by
          rw [mul_inv_cancel₀ hD_ne0, mul_inv_cancel₀ hN₁n_ne0]; ring
      _ = - D⁻¹ + N₁n⁻¹ * D⁻¹ * (N₁n - D) := by ring
  let R_L : L := 2 * (γ : L) * (v * u) ^ (p - 1) * N₁n⁻¹ * D⁻¹ * (N₁n - D)
  have hdenom_replace :
      2 * (α : L) * (- W * (v * u) ^ (p - 1) * N₁n⁻¹) =
        2 * (α : L) * (- W * (v * u) ^ (p - 1) * D⁻¹) + R_L := by
    calc 2 * (α : L) * (- W * (v * u) ^ (p - 1) * N₁n⁻¹)
        = 2 * ((α : L) * W) * (v * u) ^ (p - 1) * (- N₁n⁻¹) := by ring
      _ = 2 * ((α : L) * W) * (v * u) ^ (p - 1) * (- D⁻¹ + N₁n⁻¹ * D⁻¹ * (N₁n - D)) := by
          rw [hinv_diff]
      _ = 2 * (α : L) * (- W * (v * u) ^ (p - 1) * D⁻¹) +
            2 * ((α : L) * W) * (v * u) ^ (p - 1) * N₁n⁻¹ * D⁻¹ * (N₁n - D) := by ring
      _ = 2 * (α : L) * (- W * (v * u) ^ (p - 1) * D⁻¹) + R_L := by
          dsimp [R_L]; rw [hαW_eq]

  obtain ⟨hvu_p1_ne0, hvu_p1_val⟩ := hpow_L (v * u) (p - 1) hvu_ne0
  have hpref_ne0 : 2 * (γ : L) * (v * u) ^ (p - 1) * N₁n⁻¹ * D⁻¹ ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero h2_L_ne0 hγ_ne0) hvu_p1_ne0) hN₁n_inv_ne0)
      hD_inv_ne0
  have hpref_val :
      valL F L (2 * (γ : L) * (v * u) ^ (p - 1) * N₁n⁻¹ * D⁻¹) =
        -(a_lam : ℤ) - condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (h₀ : ℤ) := by
    rw [hvalL_mul _ D⁻¹ (mul_ne_zero (mul_ne_zero (mul_ne_zero h2_L_ne0 hγ_ne0) hvu_p1_ne0) hN₁n_inv_ne0) hD_inv_ne0,
      hvalL_mul _ N₁n⁻¹ (mul_ne_zero (mul_ne_zero h2_L_ne0 hγ_ne0) hvu_p1_ne0) hN₁n_inv_ne0,
      hvalL_mul _ ((v * u) ^ (p - 1)) (mul_ne_zero h2_L_ne0 hγ_ne0) hvu_p1_ne0,
      hvalL_mul (2 : L) (γ : L) h2_L_ne0 hγ_ne0,
      h2_L_val0, hγ_val, hvu_p1_val, hvu_val, hN₁n_inv_val0, hD_inv_val0]
    ring

  have hR_L_val : R_L = 0 ∨ - condExpChar F L ψ ≤ valL F L R_L := by
    dsimp [R_L]
    have h := hmul_L
      (-(a_lam : ℤ) - condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (h₀ : ℤ))
      m_target
      (2 * (γ : L) * (v * u) ^ (p - 1) * N₁n⁻¹ * D⁻¹)
      (N₁n - D)
      (Or.inr (le_of_eq hpref_val.symm))
      hN₁n_D_val
    have hsum_eq :
        (-(a_lam : ℤ) - condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (h₀ : ℤ)) + m_target =
          - condExpChar F L ψ := by
      dsimp [m_target]
      ring
    rwa [hsum_eq] at h

  have hψ_R_L : ψ R_L = 1 := hψ_triv R_L hR_L_val
  have hConj3 :
      ((ψM₁' (- 2 * ι_LM₁' (β : L) * (w₁ : M₁')) * (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2)⁻¹) ^ 2 =
        ψ (2 * (α : L) * (- W * (v * u) ^ (p - 1) * D⁻¹)) := by
    rw [hLHS_conv, hnorm_y_arg, hdenom_replace, AddChar.map_add_eq_mul, hψ_R_L, mul_one]

  exact ⟨hD_ne0, hD_val0, hConj3⟩

theorem ld_ch12_wild_odd_tot_ram_q1_q3_trunc_log_and_trace_symm_comp (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
