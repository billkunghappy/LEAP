  have hr_T_eq : r_T = d_T + 1 := by omega
  have hT_eq : d_T + r_T = T := by omega
  have h2d_T_ge_r_T : r_T ≤ 2 * d_T := by omega
  have h2r_T_sub_T : 2 * (r_T : ℤ) - (T : ℤ) ≤ (d_T : ℤ) := by omega
  have hmM₁'_T : condExp F M₁' θM₁' = T := hMinEq
  have hmE'_T : condExp F E' θE' = T := by omega
  have hdegE'K₁_2 : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 :=
