      Module.finrank A (IntermediateField.extendScalars hAK₁) = ℓ → A ≠ K₁ := by
    intro A _ hAK₁ hdegAK₁ h_eq
    have hmul := hFinrank_tower hAK₁
    rw [hdegAK₁, h_eq] at hmul
