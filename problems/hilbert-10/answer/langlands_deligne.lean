    obtain ⟨hP_mon, hP_deg⟩ := (hM_mem d P).mp hP
    set R := ∏ m ∈ Finset.range ℓ, σ m P
    have hR_inv : τ ζ R = R := by
      dsimp [R, σ]
      rw [Finset.prod_mul_distrib, map_mul, map_prod, map_prod]
      congr 1
      · apply Finset.prod_congr rfl
        intro m _
        exact hτ_C ζ _
