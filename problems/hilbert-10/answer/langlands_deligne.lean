  have h2r_sub_T : 2 * (r_T : ℤ) - (T : ℤ) ≤ (d_T : ℤ) := by omega
  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    _, hvalL_add, hunitL_0, hunitL_mem, hunitL_val⟩ := hvalL_props
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv,
