            if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
              ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
            else 0)) =
      (∑ r ∈ R_L,
        if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
            ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
        else 0) *
        (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          (∑ r ∈ R_L,
            if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
              ((ν₁ ^ j * χ') (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c_twist j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
            else 0)))
    (hNonDyadicBoundary : ¬ (Module.finrank L (IntermediateField.extendScalars hLK) = 2 ∧
      condExp F L χ' = condExp F L ν₁ ∧ condExp F L ν₁ % 2 = 1)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
