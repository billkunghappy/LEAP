      rw [h_fix_map K_χ β] at hβ
      rw [h_fix_map K_χ (α * β * α⁻¹)]
      have h_grp : γ₀⁻¹ * (α * β * α⁻¹) * γ₀ =
          (γ₀⁻¹ * α * γ₀) * (γ₀⁻¹ * β * γ₀) * (γ₀⁻¹ * α * γ₀)⁻¹ := by group
      rw [h_grp]
      exact hAbFsKχ.1 (γ₀⁻¹ * α * γ₀) hα (γ₀⁻¹ * β * γ₀) hβ
    · intro α hα β hβ
      rw [h_fix_map F_s α] at hα
      rw [h_fix_map F_s β] at hβ
      rw [h_fix_map K_χ (α * β * α⁻¹ * β⁻¹)]
      have h_grp : γ₀⁻¹ * (α * β * α⁻¹ * β⁻¹) * γ₀ =
          (γ₀⁻¹ * α * γ₀) * (γ₀⁻¹ * β * γ₀) * (γ₀⁻¹ * α * γ₀)⁻¹ * (γ₀⁻¹ * β * γ₀)⁻¹ := by group
      rw [h_grp]
      exact hAbFsKχ.2.1 (γ₀⁻¹ * α * γ₀) hα (γ₀⁻¹ * β * γ₀) hβ
  have hχg_ker_Kχg : ∀ u : relWeil F F_g,
      (u : AbsGal F) ∈ K_χg.fixingSubgroup ↔ χ_g u = 1 := by
    intro u
    rw [h_fix_map K_χ (u : AbsGal F)]
    exact hχ_ker_Kχ (conjHom_g u)
  let S_χs := IntermediateField.extendScalars hFsKχ
  let S_χg := IntermediateField.extendScalars hFgKχg
  let e₂_χ : S_χs ≃+* S_χg :=
    { toFun := fun x =>
        ⟨(ϕ_Kχ ⟨x.1, (IntermediateField.mem_extendScalars hFsKχ).mp x.2⟩).1,
          (IntermediateField.mem_extendScalars hFgKχg).mpr
            (ϕ_Kχ ⟨x.1, (IntermediateField.mem_extendScalars hFsKχ).mp x.2⟩).2⟩
      invFun := fun y =>
        ⟨(ϕ_Kχ.symm ⟨y.1, (IntermediateField.mem_extendScalars hFgKχg).mp y.2⟩).1,
          (IntermediateField.mem_extendScalars hFsKχ).mpr
            (ϕ_Kχ.symm ⟨y.1, (IntermediateField.mem_extendScalars hFgKχg).mp y.2⟩).2⟩
      left_inv := fun x => Subtype.ext (congrArg Subtype.val (ϕ_Kχ.symm_apply_apply ⟨x.1, _⟩))
      right_inv := fun y => Subtype.ext (congrArg Subtype.val (ϕ_Kχ.apply_symm_apply ⟨y.1, _⟩))
      map_mul' := fun x y => Subtype.ext (congrArg Subtype.val (map_mul ϕ_Kχ ⟨x.1, _⟩ ⟨y.1, _⟩))
      map_add' := fun x y => Subtype.ext (congrArg Subtype.val (map_add ϕ_Kχ ⟨x.1, _⟩ ⟨y.1, _⟩)) }
  have h_comm_Kχ : (algebraMap F_g S_χg).comp (e₁ : F_s →+* F_g) =
      (e₂_χ : S_χs →+* S_χg).comp (algebraMap F_s S_χs) := by
    apply RingHom.ext
    intro m
    apply Subtype.ext
    change ((ϕ_g m : F_g) : AlgebraicClosure F) =
      ((ϕ_Kχ ⟨m.1, hFsKχ m.2⟩ : K_χg) : AlgebraicClosure F)
    rw [IntermediateField.coe_equivMap_apply, IntermediateField.coe_equivMap_apply]
  have hμ_ker_imp : ∀ z₀ : F_sˣ,
      μ' z₀ = 1 → μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z₀) = 1 := by
    intro z₀ hz₀
    rw [hμ'_rec z₀, ← hχ_ker_Kχ (rec.recMap F_s z₀),
      rec.ker_rec F_s K_χ hFsKχ hAbFsKχ z₀] at hz₀
    rcases hz₀ with ⟨y, hy⟩
    have hy_norm : normLM F hFgKχg (ϕ_Kχ y) = ϕ_g (z₀ : F_s) := by
      have h_norm_eq : Algebra.norm F_s (toExtendScalars F hFsKχ y) =
          e₁.symm (Algebra.norm F_g (e₂_χ (toExtendScalars F hFsKχ y))) :=
        Algebra.norm_eq_of_equiv_equiv e₁ e₂_χ h_comm_Kχ (toExtendScalars F hFsKχ y)
      have he₂_y : e₂_χ (toExtendScalars F hFsKχ y) = toExtendScalars F hFgKχg (ϕ_Kχ y) := rfl
      have h1 : normLM F hFsKχ y = e₁.symm (normLM F hFgKχg (ϕ_Kχ y)) := by
        change Algebra.norm F_s (toExtendScalars F hFsKχ y) = _
        rw [h_norm_eq, he₂_y]
        rfl
      rw [hy] at h1
      calc normLM F hFgKχg (ϕ_Kχ y) = e₁ (e₁.symm (normLM F hFgKχg (ϕ_Kχ y))) :=
            (e₁.apply_symm_apply _).symm
        _ = ϕ_g (z₀ : F_s) := congrArg (⇑e₁) h1.symm
    let z₀_g : F_gˣ := Units.map ϕ_g.toRingEquiv.toMonoidHom z₀
    have hz₀_g_mem : (z₀_g : F_g) ∈ Set.range (normLM F hFgKχg) := ⟨ϕ_Kχ y, hy_norm⟩
    have hz₀_g_fix : (rec.recMap F_g z₀_g : AbsGal F) ∈ K_χg.fixingSubgroup :=
      (rec.ker_rec F_g K_χg hFgKχg hAbFgKχg z₀_g).mpr hz₀_g_mem
    rw [hμ'_g_rec z₀_g]
    exact (hχg_ker_Kχg (rec.recMap F_g z₀_g)).mp hz₀_g_fix
  have hex_w₀ : ∃ w₀ : M_Cˣ, μ' (Units.map (normLM F hFsMC) w₀) ≠ 1 := by
    by_contra h_all
    push_neg at h_all
    apply hμ_comp_ne1
    exact MonoidHom.ext h_all
  obtain ⟨w₀, hw₀⟩ := hex_w₀
  let x₀ : F_sˣ := Units.map (normLM F hFsMC) w₀
  let ζ : Ω F := (μ' x₀ : Ω F)
  have hζ_ne1 : ζ ≠ 1 := fun h => hw₀ (Units.ext h)
  have hμ'_pow_apply : ∀ z : F_sˣ, (μ' z) ^ (p F) = 1 := by
    intro z
    change ((μ' ^ (p F)) z) = 1
    rw [hμ_pow, MonoidHom.one_apply]
  have hζ_pow : ζ ^ (p F) = 1 := by
    change ((μ' x₀ : Ω F) ^ (p F)) = 1
    rw [← Units.val_pow_eq_pow_val, hμ'_pow_apply x₀, Units.val_one]
  have hζ_prim : IsPrimitiveRoot ζ (p F) :=
    IsPrimitiveRoot.iff_orderOf.mpr (orderOf_eq_prime hζ_pow hζ_ne1)
  haveI : NeZero (p F) := ⟨hp.ne_zero⟩
  have hμ_eq_all : ∀ z : F_sˣ,
      μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z) = μ' z := by
    intro z
    have hz_pow : (μ' z : Ω F) ^ (p F) = 1 := by
      rw [← Units.val_pow_eq_pow_val, hμ'_pow_apply z, Units.val_one]
    obtain ⟨k, _, hk⟩ := hζ_prim.eq_pow_of_pow_eq_one hz_pow
    have hx₀_k : μ' (x₀ ^ k) = μ' z := by
      apply Units.ext
      rw [map_pow, Units.val_pow_eq_pow_val]
      exact hk
    let z₀ : F_sˣ := z * (x₀ ^ k)⁻¹
    have hz₀_ker : μ' z₀ = 1 := by
      dsimp [z₀]
      rw [map_mul, map_inv, hx₀_k, mul_inv_cancel]
    have hz₀_g : μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z₀) = 1 := hμ_ker_imp z₀ hz₀_ker
    have hz_decomp : z = z₀ * x₀ ^ k := by
      dsimp [z₀]
      exact (inv_mul_cancel_right z (x₀ ^ k)).symm
    have hx₀_g : μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom x₀) = μ' x₀ := hμ_MC_eq w₀
    calc μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z)
        = μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom (z₀ * x₀ ^ k)) := by rw [← hz_decomp]
      _ = μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z₀) *
            (μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom x₀)) ^ k := by
          rw [map_mul, map_pow, map_mul, map_pow]
      _ = 1 * (μ' x₀) ^ k := by rw [hz₀_g, hx₀_g]
      _ = μ' (x₀ ^ k) := by rw [one_mul, map_pow]
      _ = μ' z := hx₀_k
  
  have hWeil_mul : ∀ (M : IntermediateField F (AlgebraicClosure F))
      {χ₁ χ₂ : relWeil F M →* (Ω F)ˣ},
      IsWeilRep F M (charRep F M χ₁) → IsWeilRep F M (charRep F M χ₂) →
      IsWeilRep F M (charRep F M (χ₁ * χ₂)) := by
    rintro M χ₁ χ₂ ⟨hfin, U₁, hU₁, htriv₁⟩ ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    have hmul : charRep F M (χ₁ * χ₂) w = charRep F M χ₁ w * charRep F M χ₂ w := by
      apply LinearMap.ext
      intro v
      change ((χ₁ * χ₂) w : Ω F) • v = (χ₁ w : Ω F) • ((χ₂ w : Ω F) • v)
      rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
    rw [hmul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  have hWeil_rest : ∀ {M₁ M₂ : IntermediateField F (AlgebraicClosure F)} (hM : M₁ ≤ M₂)
      {χ : relWeil F M₁ →* (Ω F)ˣ},
      IsWeilRep F M₁ (charRep F M₁ χ) →
      IsWeilRep F M₂ (charRep F M₂ (restrictWeilChar F hM χ)) := by
    rintro M₁ M₂ hM χ ⟨hfin, U, hU, htriv⟩
    refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
    exact htriv (Subgroup.inclusion (relWeil_antitone F hM) w) hwU hwI
  set χ' := recChar F rec L χL_ext
  obtain ⟨χ₀', hχ₀'_rec, _, hχ₀'_sep⟩ := hSepRec_all L χL_ext hχL_ext
  have hχ'_eq : χ' = χ₀' := (htateEps L ψ hψ χL_ext hχL_ext χ₀' hχ₀'_rec).1
  have hχ'_Fs_rec : ∀ z : F_sˣ,
      (χ'.comp (Units.map (normLM F hLFs))) z =
        (restrictWeilChar F hLFs χL_ext) (rec.recMap F_s z) := by
    rw [hχ'_eq]; exact (hχ₀'_sep F_s hLFs hSepLFs).1
  have hχ'_Fg_rec : ∀ y : F_gˣ,
      (χ'.comp (Units.map (normLM F hLFg))) y =
        (restrictWeilChar F hLFg χL_ext) (rec.recMap F_g y) := by
    rw [hχ'_eq]; exact (hχ₀'_sep F_g hLFg hSepLFg).1
  have hχs_tw_weil :
      IsWeilRep F F_s (charRep F F_s (χ_s * restrictWeilChar F hLFs χL_ext)) :=
    hWeil_mul F_s hχ_s_weil (hWeil_rest hLFs hχL_ext)
  have hμ'_tw_rec : ∀ z : F_sˣ,
      (μ' * χ'.comp (Units.map (normLM F hLFs))) z =
        (χ_s * restrictWeilChar F hLFs χL_ext) (rec.recMap F_s z) := by
    intro z
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hμ'_rec z, hχ'_Fs_rec z]
  have hμ'_tw_eq :
      recChar F rec F_s (χ_s * restrictWeilChar F hLFs χL_ext) =
        μ' * χ'.comp (Units.map (normLM F hLFs)) :=
    (htateEps F_s (traceChar F hLFs ψ) hψ_Fs (χ_s * restrictWeilChar F hLFs χL_ext)
      hχs_tw_weil (μ' * χ'.comp (Units.map (normLM F hLFs))) hμ'_tw_rec).1
  have hμ'_tw_cond : ∀ u ∈ unitGroup F F_s
      (condExp F F_s (recChar F rec F_s (χ_s * restrictWeilChar F hLFs χL_ext))),
      (recChar F rec F_s (χ_s * restrictWeilChar F hLFs χL_ext)) u = 1 := by
    rw [hμ'_tw_eq]
    exact hWeil_unit_triv F_s (χ_s * restrictWeilChar F hLFs χL_ext) hχs_tw_weil
      (μ' * χ'.comp (Units.map (normLM F hLFs))) hμ'_tw_rec
  have hχg_tw_weil :
      IsWeilRep F F_g (charRep F F_g (χ_g * restrictWeilChar F hLFg χL_ext)) :=
    hWeil_mul F_g hχ_g_weil (hWeil_rest hLFg hχL_ext)
  have hμ'_g_tw_rec : ∀ y : F_gˣ,
      (μ'_g * χ'.comp (Units.map (normLM F hLFg))) y =
        (χ_g * restrictWeilChar F hLFg χL_ext) (rec.recMap F_g y) := by
    intro y
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hμ'_g_rec y, hχ'_Fg_rec y]
  have hμ'_g_tw_eq :
      recChar F rec F_g (χ_g * restrictWeilChar F hLFg χL_ext) =
        μ'_g * χ'.comp (Units.map (normLM F hLFg)) :=
    (htateEps F_g (traceChar F hLFg ψ) hψ_Fg (χ_g * restrictWeilChar F hLFg χL_ext)
      hχg_tw_weil (μ'_g * χ'.comp (Units.map (normLM F hLFg))) hμ'_g_tw_rec).1
  have hμ_tw_eq_all : ∀ z : F_sˣ,
      (recChar F rec F_g (χ_g * restrictWeilChar F hLFg χL_ext))
        (Units.map ϕ_g.toRingEquiv.toMonoidHom z) =
        (recChar F rec F_s (χ_s * restrictWeilChar F hLFs χL_ext)) z := by
    intro z
    rw [hμ'_g_tw_eq, hμ'_tw_eq, MonoidHom.mul_apply, MonoidHom.mul_apply,
      MonoidHom.comp_apply, MonoidHom.comp_apply, hμ_eq_all z, hnormLM_L_ϕg z]
  have hEps_un :
      tateEpsUnit F F_g (recChar F rec F_g χ_g) (traceChar F hLFg ψ) =
        tateEpsUnit F F_s (recChar F rec F_s χ_s) (traceChar F hLFs ψ) :=
    (ld_ch13_2_tateEpsUnit_algEquiv_invariance F F_s F_g ϕ_g
      (traceChar F hLFs ψ) hψ_Fs (traceChar F hLFg ψ) htraceChar_ϕg
      μ' hμ'_cond μ'_g hμ_eq_all).2
  have hEps_tw :
      tateEpsUnit F F_g
          (recChar F rec F_g (χ_g * restrictWeilChar F hLFg χL_ext))
          (traceChar F hLFg ψ) =
        tateEpsUnit F F_s
          (recChar F rec F_s (χ_s * restrictWeilChar F hLFs χL_ext))
          (traceChar F hLFs ψ) :=
    (ld_ch13_2_tateEpsUnit_algEquiv_invariance F F_s F_g ϕ_g
      (traceChar F hLFs ψ) hψ_Fs (traceChar F hLFg ψ) htraceChar_ϕg
      (recChar F rec F_s (χ_s * restrictWeilChar F hLFs χL_ext)) hμ'_tw_cond
      (recChar F rec F_g (χ_g * restrictWeilChar F hLFg χL_ext)) hμ_tw_eq_all).2
  exact ⟨hLFg, hFgMC, χ_g, hχ_g_apply, hmem_Fg, hχ_g_weil, hχ_g_pow,
    hχ_g_restK, hχ_g_restE, hχ_g_neMC, hEps_un, hEps_tw⟩

theorem ld_ch14_semidirect_projH_and_lhs_trace_restriction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K E L' F' E_L' E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLE : L ≤ E) (hEK : E ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hLL' : L ≤ L') (hLF' : L ≤ F')
    (hL'E_L' : L' ≤ E_L') (hF'E' : F' ≤ E') (hE_L'K : E_L' ≤ K) (hE'K : E' ≤ K)
    (hEL'_sup : E ⊔ L' = E_L') (hEF'_sup : E ⊔ F' = E')
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hsurj : Function.Surjective π)
    [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (hG_mul : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
    (H_L' H_F' : Subgroup H)
    (h_mem_L' : ∀ w : relWeil F L,
      w ∈ (relWeil F L').subgroupOf (relWeil F L) ↔ ∃ h ∈ H_L', ∃ c ∈ C, π w = h.1 * c)
    (h_mem_F' : ∀ w : relWeil F L,
      w ∈ (relWeil F F').subgroupOf (relWeil F L) ↔ ∃ h ∈ H_F', ∃ c ∈ C, π w = h.1 * c) :
    FiniteDimensional F L' ∧
    Algebra.IsSeparable L (IntermediateField.extendScalars hLL') ∧
    FiniteDimensional F F' ∧
    Algebra.IsSeparable L (IntermediateField.extendScalars hLF') ∧
    (⟨1, L', le_rfl, 1⟩ : MonomialTerm F L').Wf F L' ∧
    (⟨1, F', le_rfl, 1⟩ : MonomialTerm F F').Wf F F' ∧
    (∀ w : relWeil F L',
      (⟨1, L', le_rfl, 1⟩ : MonomialTerm F L').trace F L' w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLL') w)) ∧
    (∀ w : relWeil F F',
      (⟨1, F', le_rfl, 1⟩ : MonomialTerm F F').trace F F' w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLF') w)) ∧
    (∀ w : relWeil F L',
      (⟨1, E_L', hL'E_L', 1⟩ : MonomialTerm F L').trace F L' w =
        (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLL') w)) ∧
    (∀ w : relWeil F F',
      (⟨1, E', hF'E', 1⟩ : MonomialTerm F F').trace F F' w =
        (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLF') w)) ∧
    ∃ projH : (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) →* H,
      (∀ h : H, projH h.1 = h) ∧
      (∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
        g ∈ C ↔ projH g = 1) ∧
      (∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
        (projH g).1⁻¹ * g ∈ C) ∧
      (∀ (S : Subgroup H)
        (g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
        projH g ∈ S ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c) :=
by
  let G := (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)
  have hHC_disj : ∀ g : G, g ∈ H → g ∈ C → g = 1 :=
    fun g hgH hgC => hZ_H g hgH (hC_ab g hgC)
  have h_uniq : ∀ (g : G) (h₁ h₂ : H),
      h₁.1⁻¹ * g ∈ C → h₂.1⁻¹ * g ∈ C → h₁ = h₂ := by
    intro g h₁ h₂ hc₁ hc₂
    have h_in_C : (h₁⁻¹ * h₂).1 ∈ C := by
      have heq : (h₁⁻¹ * h₂).1 = (h₁.1⁻¹ * g) * (h₂.1⁻¹ * g)⁻¹ := by
        change h₁.1⁻¹ * h₂.1 = (h₁.1⁻¹ * g) * (h₂.1⁻¹ * g)⁻¹
        group
      rw [heq]
      exact C.mul_mem hc₁ (C.inv_mem hc₂)
    have h_eq1 : (h₁⁻¹ * h₂).1 = 1 := hHC_disj (h₁⁻¹ * h₂).1 (h₁⁻¹ * h₂).2 h_in_C
    have h_sub1 : h₁⁻¹ * h₂ = 1 := Subtype.ext h_eq1
    exact inv_mul_eq_one.mp h_sub1
  let projH_fun : G → H := fun g => ⟨(hG_mul g).choose, (hG_mul g).choose_spec.1⟩
  have hprojH_mul_C : ∀ g : G, (projH_fun g).1⁻¹ * g ∈ C := by
    intro g
    obtain ⟨c, hcC, hgc⟩ := (hG_mul g).choose_spec.2
    have heq : (projH_fun g).1⁻¹ * g = c :=
      calc (projH_fun g).1⁻¹ * g
          = (hG_mul g).choose⁻¹ * ((hG_mul g).choose * c) := congrArg ((hG_mul g).choose⁻¹ * ·) hgc
        _ = c := inv_mul_cancel_left (hG_mul g).choose c
    rwa [heq]
  have hprojH_eq_iff : ∀ (g : G) (h : H), h.1⁻¹ * g ∈ C ↔ projH_fun g = h :=
    fun g h => ⟨fun hc => h_uniq g (projH_fun g) h (hprojH_mul_C g) hc,
      fun heq => heq ▸ hprojH_mul_C g⟩
  let projH : G →* H :=
    { toFun := projH_fun
      map_one' := (hprojH_eq_iff 1 1).mp (by simp [C.one_mem])
      map_mul' := fun g₁ g₂ => (hprojH_eq_iff (g₁ * g₂) (projH_fun g₁ * projH_fun g₂)).mp (by
        have hc₁ : (projH_fun g₁).1⁻¹ * g₁ ∈ C := hprojH_mul_C g₁
        have hc₂ : (projH_fun g₂).1⁻¹ * g₂ ∈ C := hprojH_mul_C g₂
        have hconj : (projH_fun g₂).1⁻¹ * ((projH_fun g₁).1⁻¹ * g₁) *
            ((projH_fun g₂).1⁻¹)⁻¹ ∈ C :=
          Subgroup.Normal.conj_mem ‹C.Normal› _ hc₁ (projH_fun g₂).1⁻¹
        have heq : (projH_fun g₁ * projH_fun g₂).1⁻¹ * (g₁ * g₂) =
            ((projH_fun g₂).1⁻¹ * ((projH_fun g₁).1⁻¹ * g₁) * ((projH_fun g₂).1⁻¹)⁻¹) *
              ((projH_fun g₂).1⁻¹ * g₂) := by
          change ((projH_fun g₁).1 * (projH_fun g₂).1)⁻¹ * (g₁ * g₂) = _
          group
        rw [heq]
        exact C.mul_mem hconj hc₂) }
  have hprojH_id : ∀ h : H, projH h.1 = h :=
    fun h => (hprojH_eq_iff h.1 h).mp (by simp [C.one_mem])
  have hprojH_C : ∀ g : G, g ∈ C ↔ projH g = 1 := by
    intro g
    change g ∈ C ↔ projH_fun g = 1
    rw [← hprojH_eq_iff g 1]
    simp
  have hprojH_sub : ∀ (S : Subgroup H) (g : G),
      projH g ∈ S ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c := by
    intro S g
    constructor
    · intro hgS
      refine ⟨projH g, hgS, (projH g).1⁻¹ * g, hprojH_mul_C g, ?_⟩
      group
    · rintro ⟨h, hhS, c, hcC, rfl⟩
      have hc : h.1⁻¹ * (h.1 * c) ∈ C := by rwa [inv_mul_cancel_left]
      have heq : projH (h.1 * c) = h := (hprojH_eq_iff (h.1 * c) h).mp hc
      rwa [heq]
  have hProjH_pkg :
      ∃ projH : G →* H,
        (∀ h : H, projH h.1 = h) ∧
        (∀ g : G, g ∈ C ↔ projH g = 1) ∧
        (∀ g : G, (projH g).1⁻¹ * g ∈ C) ∧
        (∀ (S : Subgroup H) (g : G),
          projH g ∈ S ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c) :=
    ⟨projH, hprojH_id, hprojH_C, hprojH_mul_C, hprojH_sub⟩
  have h_weil_fact : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A)
      (S : Subgroup H)
      (h_mem_A : ∀ w : relWeil F L,
        w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ ∃ h ∈ S, ∃ c ∈ C, π w = h.1 * c)
      (x : relWeil F L),
      ∃ (m : relWeil F E) (y : relWeil F A),
        Subgroup.inclusion (relWeil_antitone F hLE) m *
          Subgroup.inclusion (relWeil_antitone F hLA) y = x := by
    intro A hLA S h_mem_A x
    obtain ⟨h, hhH, c, hcC, hπx⟩ := hG_mul (π x)
    obtain ⟨m₀, hm₀⟩ := hsurj h
    have hm₀_E : m₀ ∈ (relWeil F E).subgroupOf (relWeil F L) :=
      (h_mem_H m₀).mpr (hm₀.symm ▸ hhH)
    let m : relWeil F E := ⟨m₀.1, hm₀_E⟩
    let y₀ : relWeil F L := m₀⁻¹ * x
    have hy₀_A : y₀ ∈ (relWeil F A).subgroupOf (relWeil F L) := by
      rw [h_mem_A]
      refine ⟨1, S.one_mem, c, hcC, ?_⟩
      change π (m₀⁻¹ * x) = (1 : H).1 * c
      rw [map_mul, map_inv, hm₀, hπx, Subgroup.coe_one, one_mul, inv_mul_cancel_left]
    let y : relWeil F A := ⟨y₀.1, hy₀_A⟩
    refine ⟨m, y, ?_⟩
    apply Subtype.ext
    change m₀.1 * (m₀⁻¹ * x).1 = x.1
    exact mul_inv_cancel_left m₀.1 x.1
  have hWf_sub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A), A ≤ K →
      FiniteDimensional F A ∧
      Algebra.IsSeparable L (IntermediateField.extendScalars hLA) ∧
      (⟨1, A, le_rfl, 1⟩ : MonomialTerm F A).Wf F A := by
    intro A hLA hAK
    have hFinA : FiniteDimensional F A :=
      Module.Finite.of_injective (IntermediateField.inclusion hAK).toLinearMap
        (IntermediateField.inclusion hAK).injective
    have hSepLA : Algebra.IsSeparable L (IntermediateField.extendScalars hLA) := by
      refine ⟨fun x => ?_⟩
      let A_L := IntermediateField.extendScalars hLA
      let K_L := IntermediateField.extendScalars hLK
      have hxA : (x : AlgebraicClosure F) ∈ A :=
        (IntermediateField.mem_extendScalars hLA).mp x.2
      let x_K : K_L := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hAK hxA)⟩
      have hsep_xK : IsSeparable L x_K := Algebra.IsSeparable.isSeparable L x_K
      have hmin_KL : minpoly L (x : AlgebraicClosure F) = minpoly L x_K :=
        minpoly.algHom_eq K_L.val K_L.val.injective x_K
      have hmin_AL : minpoly L (x : AlgebraicClosure F) = minpoly L x :=
        minpoly.algHom_eq A_L.val A_L.val.injective x
      change (minpoly L x).Separable
      rw [← hmin_AL, hmin_KL]
      exact hsep_xK
    have hSepAA : Algebra.IsSeparable A (IntermediateField.extendScalars (le_rfl : A ≤ A)) := by
      refine ⟨fun x => ?_⟩
      let xA : A := ⟨x.1, (IntermediateField.mem_extendScalars (le_rfl : A ≤ A)).mp x.2⟩
      have hx : algebraMap A (IntermediateField.extendScalars (le_rfl : A ≤ A)) xA = x := rfl
      rw [← hx]
      exact isSeparable_algebraMap xA
    have hWeilA : IsWeilRep F A (charRep F A 1) := by
      refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm,
        Set.univ, Filter.univ_mem, fun w _ _ => ?_⟩
      apply LinearMap.ext
      intro v
      change ((1 : relWeil F A →* (Ω F)ˣ) w : Ω F) • v = v
      rw [MonoidHom.one_apply, Units.val_one, one_smul]
    exact ⟨hFinA, hSepLA, hFinA, hSepAA, hWeilA⟩
  have hTrace_sup : ∀ (E₀ A E_A : IntermediateField F (AlgebraicClosure F))
      (hLE₀ : L ≤ E₀) (hLA : L ≤ A) (hAE_A : A ≤ E_A),
      E₀ ⊔ A = E_A →
      (∀ x : relWeil F L, ∃ (m : relWeil F E₀) (y : relWeil F A),
        Subgroup.inclusion (relWeil_antitone F hLE₀) m *
          Subgroup.inclusion (relWeil_antitone F hLA) y = x) →
      ∀ w : relWeil F A,
        (⟨1, E_A, hAE_A, 1⟩ : MonomialTerm F A).trace F A w =
          (⟨1, E₀, hLE₀, 1⟩ : MonomialTerm F L).trace F L
            (Subgroup.inclusion (relWeil_antitone F hLA) w) := by
    intro E₀ A E_A hLE₀ hLA hAE_A hEA_sup h_fact w
    let G_L := relWeil F L
    let G_E₀ := relWeil F E₀
    let G_A := relWeil F A
    let ι_E₀ : G_E₀ →* G_L := Subgroup.inclusion (relWeil_antitone F hLE₀)
    let ι_A : G_A →* G_L := Subgroup.inclusion (relWeil_antitone F hLA)
    choose m_E₀ y_A h_decomp using h_fact
    let H_E₀ : Subgroup G_L := G_E₀.subgroupOf G_L
    let H_EA_A : Subgroup G_A := (relWeil F E_A).subgroupOf G_A
    let W_V := ULift.{u} (Ω F)
    let e_E₀ : H_E₀ ≃* G_E₀ := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE₀)
    let e_EA_A : H_EA_A ≃* relWeil F E_A :=
      Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hAE_A)
    let ρ_E₀ : Representation (Ω F) H_E₀ W_V := (charRep F E₀ 1).comp e_E₀.toMonoidHom
    let ρ_EA : Representation (Ω F) H_EA_A W_V := (charRep F E_A 1).comp e_EA_A.toMonoidHom
    have hρ_E₀_apply : ∀ (h : H_E₀) (v : W_V), ρ_E₀ h v = v := by
      intro h v
      change ((1 : G_E₀ →* (Ω F)ˣ) (e_E₀ h) : Ω F) • v = v
      rw [MonoidHom.one_apply, Units.val_one, one_smul]
    have hρ_EA_apply : ∀ (h' : H_EA_A) (v : W_V), ρ_EA h' v = v := by
      intro h' v
      change ((1 : relWeil F E_A →* (Ω F)ˣ) (e_EA_A h') : Ω F) • v = v
      rw [MonoidHom.one_apply, Units.val_one, one_smul]
    have hE₀E_A : E₀ ≤ E_A := hEA_sup ▸ le_sup_left
    have h_uniq_EA : ∀ (φ : indSpace H_EA_A ρ_EA) (m₁ m₂ : G_E₀) (y₁ y₂ : G_A),
        ι_E₀ m₁ * ι_A y₁ = ι_E₀ m₂ * ι_A y₂ →
        φ.1 y₁ = φ.1 y₂ := by
      intro φ m₁ m₂ y₁ y₂ heq
      have heq_gal : (m₁ : AbsGal F) * (y₁ : AbsGal F) = (m₂ : AbsGal F) * (y₂ : AbsGal F) :=
        congrArg Subtype.val heq
      let δ_gal : AbsGal F := (m₂ : AbsGal F)⁻¹ * (m₁ : AbsGal F)
      have hδ_eq_y : δ_gal = (y₂ : AbsGal F) * (y₁ : AbsGal F)⁻¹ := by
        dsimp [δ_gal]
        calc (m₂ : AbsGal F)⁻¹ * (m₁ : AbsGal F)
            = (m₂ : AbsGal F)⁻¹ * ((m₁ : AbsGal F) * (y₁ : AbsGal F)) * (y₁ : AbsGal F)⁻¹ := by group
          _ = (m₂ : AbsGal F)⁻¹ * ((m₂ : AbsGal F) * (y₂ : AbsGal F)) * (y₁ : AbsGal F)⁻¹ := by
            rw [heq_gal]
          _ = (y₂ : AbsGal F) * (y₁ : AbsGal F)⁻¹ := by group
      have hδ_weil : δ_gal ∈ weilGroup F := (m₂⁻¹ * m₁).2.1
      have hδ_E₀ : δ_gal ∈ E₀.fixingSubgroup := (m₂⁻¹ * m₁).2.2
      have hδ_A : δ_gal ∈ A.fixingSubgroup := by
        rw [hδ_eq_y]
        exact (y₂ * y₁⁻¹).2.2
      have hδ_EA : δ_gal ∈ E_A.fixingSubgroup := by
        rw [← hEA_sup, IntermediateField.fixingSubgroup_sup]
        exact ⟨hδ_E₀, hδ_A⟩
      let δ_A : G_A := ⟨δ_gal, hδ_weil, hδ_A⟩
      let δ_sub : H_EA_A := ⟨δ_A, ⟨hδ_weil, hδ_EA⟩⟩
      have hy₂_eq : y₂ = (δ_sub : G_A) * y₁ := by
        apply Subtype.ext
        change (y₂ : AbsGal F) = δ_gal * (y₁ : AbsGal F)
        rw [hδ_eq_y, inv_mul_cancel_right]
      rw [hy₂_eq, φ.2 δ_sub y₁, hρ_EA_apply]
    let Φ_ind : indSpace H_E₀ ρ_E₀ ≃ₗ[Ω F] indSpace H_EA_A ρ_EA :=
      { toFun := fun f =>
          ⟨fun y => f.1 (ι_A y), fun h' y => by
            have h_sub_mem : ι_A (h' : G_A) ∈ H_E₀ :=
              ⟨(h' : G_A).2.1, IntermediateField.fixingSubgroup_le hE₀E_A h'.2.2⟩
            have h_eq := f.2 ⟨ι_A (h' : G_A), h_sub_mem⟩ (ι_A y)
            rw [hρ_E₀_apply] at h_eq
            change f.1 (ι_A ((h' : G_A) * y)) = ρ_EA h' (f.1 (ι_A y))
            rw [map_mul, hρ_EA_apply]
            exact h_eq⟩
        map_add' := fun _ _ => Subtype.ext (funext fun _ => rfl)
        map_smul' := fun _ _ => Subtype.ext (funext fun _ => rfl)
        invFun := fun φ =>
          ⟨fun x => φ.1 (y_A x), fun h x => by
            dsimp only
            rw [hρ_E₀_apply]
            have h_eq : ι_E₀ (m_E₀ ((h : G_L) * x)) * ι_A (y_A ((h : G_L) * x)) =
                ι_E₀ (e_E₀ h * m_E₀ x) * ι_A (y_A x) := by
              rw [h_decomp ((h : G_L) * x), map_mul, mul_assoc, h_decomp x]
              rfl
            exact h_uniq_EA φ (m_E₀ ((h : G_L) * x)) (e_E₀ h * m_E₀ x)
              (y_A ((h : G_L) * x)) (y_A x) h_eq⟩
        left_inv := fun f => by
          apply Subtype.ext
          funext x
          dsimp only
          have h_sub : ι_E₀ (m_E₀ x) ∈ H_E₀ := (m_E₀ x).2
          have h_eq := f.2 ⟨ι_E₀ (m_E₀ x), h_sub⟩ (ι_A (y_A x))
          rw [hρ_E₀_apply] at h_eq
          rw [← h_eq, h_decomp x]
        right_inv := fun φ => by
          apply Subtype.ext
          funext y
          dsimp only
          have h_eq : ι_E₀ (m_E₀ (ι_A y)) * ι_A (y_A (ι_A y)) = ι_E₀ 1 * ι_A y := by
            rw [h_decomp (ι_A y), map_one, one_mul]
          exact h_uniq_EA φ (m_E₀ (ι_A y)) 1 (y_A (ι_A y)) y h_eq }
    simp only [MonomialTerm.trace, one_smul]
    have h_conj : Φ_ind.conj (indLM F hLE₀ (charRep F E₀ 1) (ι_A w)) =
        indLM F hAE_A (charRep F E_A 1) w := by
      apply LinearMap.ext
      intro φ
      apply Subtype.ext
      funext y
      have h1 : ((Φ_ind.conj (indLM F hLE₀ (charRep F E₀ 1) (ι_A w))) φ).1 y =
          (Φ_ind.symm φ).1 (ι_A y * ι_A w) := rfl
      have h2 : ((indLM F hAE_A (charRep F E_A 1) w) φ).1 y = φ.1 (y * w) := rfl
      have h3 : (Φ_ind.symm φ).1 (ι_A (y * w)) = (Φ_ind (Φ_ind.symm φ)).1 (y * w) := rfl
      rw [h1, h2, ← map_mul, h3, Φ_ind.apply_symm_apply]
    have h_tr := LinearMap.trace_conj' (indLM F hLE₀ (charRep F E₀ 1) (ι_A w)) Φ_ind
    rw [h_conj] at h_tr
    exact h_tr
  obtain ⟨hFinL', hSepLL', hWfL'⟩ := hWf_sub L' hLL' (hL'E_L'.trans hE_L'K)
  obtain ⟨hFinF', hSepLF', hWfF'⟩ := hWf_sub F' hLF' (hF'E'.trans hE'K)
  have htr_head_L' : ∀ w : relWeil F L',
      (⟨1, L', le_rfl, 1⟩ : MonomialTerm F L').trace F L' w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLL') w) :=
    hTrace_sup L L' L' le_rfl hLL' le_rfl (sup_eq_right.mpr hLL')
      (fun x => ⟨x, 1, mul_one x⟩)
  have htr_head_F' : ∀ w : relWeil F F',
      (⟨1, F', le_rfl, 1⟩ : MonomialTerm F F').trace F F' w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLF') w) :=
    hTrace_sup L F' F' le_rfl hLF' le_rfl (sup_eq_right.mpr hLF')
      (fun x => ⟨x, 1, mul_one x⟩)
  have htr_EL' : ∀ w : relWeil F L',
      (⟨1, E_L', hL'E_L', 1⟩ : MonomialTerm F L').trace F L' w =
        (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLL') w) :=
    hTrace_sup E L' E_L' hLE hLL' hL'E_L' hEL'_sup (h_weil_fact L' hLL' H_L' h_mem_L')
  have htr_E' : ∀ w : relWeil F F',
      (⟨1, E', hF'E', 1⟩ : MonomialTerm F F').trace F F' w =
        (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLF') w) :=
    hTrace_sup E F' E' hLE hLF' hF'E' hEF'_sup (h_weil_fact F' hLF' H_F' h_mem_F')
  exact ⟨hFinL', hSepLL', hFinF', hSepLF', hWfL', hWfF',
    htr_head_L', htr_head_F', htr_EL', htr_E', hProjH_pkg⟩

theorem ld_ch14_metacyclic_double_coset_constant_fibers_iff (H : Type u) [Group H] [Fintype H]
    (N₁ H_L' H_F' K_t : Subgroup H) [N₁.Normal] [H_L'.Normal]
    (hN₁_le_HL' : N₁ ≤ H_L') (hN₁_le_HF' : N₁ ≤ H_F')
    (hHF'_HL'_inf : ∀ h : H, h ∈ H_F' → h ∈ H_L' → h ∈ N₁)
    (hHF'_HL'_mul : ∀ h : H, ∃ x ∈ H_F', ∃ y ∈ H_L', h = x * y)
    (hKt_le : K_t ≤ H_F')
    (r : ℕ) (c_rep : Fin r → H)
    (hc_rep : ∀ a : Fin r, c_rep a ∈ H_L' ∧ c_rep a ∉ N₁)
    (hc_orbit : ∀ y ∈ H_L', y ∉ N₁ →
      ∃ (a₀ : Fin r) (g₀ : H),
        g₀ ∈ H_F' ∧
        ∀ (a : Fin r) (g : H), g ∈ H_F' →
          (g * (c_rep a)⁻¹ * g⁻¹ * y⁻¹ ∈ N₁ ↔ a = a₀ ∧ g⁻¹ * g₀ ∈ N₁)) :
    ∃ (h_rep : List H),
      (∀ k ∈ K_t, k ∈ H_L' ↔ k ∈ N₁) ∧
      (∀ b : Fin h_rep.length, h_rep.get b ∈ H_F') ∧
      (∀ u : H,
        Nat.card {p : K_t × Fin h_rep.length × H_L' //
          p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1 = u} =
        Nat.card ↥(K_t ⊓ N₁)) ∧
      (∀ u : H, u ∉ H_F' →
        Nat.card {p : K_t × Fin r × Fin h_rep.length × H_F' //
          p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u} =
        Nat.card ↥(K_t ⊓ N₁)) ∧
      (∀ (a : Fin r) (b : Fin h_rep.length) (x : H) (g : H),
        x ∈ H_F' → g ∈ H_F' →
        (((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ↔
          ((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ⊓ N₁)) :=
by
  classical
  have hKt_N₁ : ∀ k ∈ K_t, k ∈ H_L' ↔ k ∈ N₁ := fun k hk =>
    ⟨fun hkL => hHF'_HL'_inf k (hKt_le hk) hkL, fun hkN => hN₁_le_HL' hkN⟩
  let M_t : Subgroup H :=
    { carrier := {h : H | ∃ k ∈ K_t, ∃ n ∈ N₁, h = k * n}
      one_mem' := ⟨1, K_t.one_mem, 1, N₁.one_mem, (mul_one 1).symm⟩
      mul_mem' := by
        rintro _ _ ⟨k₁, hk₁, n₁, hn₁, rfl⟩ ⟨k₂, hk₂, n₂, hn₂, rfl⟩
        refine ⟨k₁ * k₂, K_t.mul_mem hk₁ hk₂,
          (k₂⁻¹ * n₁ * (k₂⁻¹)⁻¹) * n₂,
          N₁.mul_mem (‹N₁.Normal›.conj_mem n₁ hn₁ k₂⁻¹) hn₂, ?_⟩
        group
      inv_mem' := by
        rintro _ ⟨k, hk, n, hn, rfl⟩
        refine ⟨k⁻¹, K_t.inv_mem hk, k * n⁻¹ * k⁻¹,
          ‹N₁.Normal›.conj_mem n⁻¹ (N₁.inv_mem hn) k, ?_⟩
        group }
  have hMt_mem : ∀ h : H, h ∈ M_t ↔ ∃ k ∈ K_t, ∃ n ∈ N₁, h = k * n := fun _ => Iff.rfl
  let M_t' : Subgroup H_F' := M_t.subgroupOf H_F'
  let Q_t := H_F' ⧸ M_t'
  let m_t : ℕ := Fintype.card Q_t
  let e_t : Fin m_t ≃ Q_t := (Fintype.equivFin Q_t).symm
  let h_fn : Fin m_t → H := fun i => (Quotient.out (e_t i) : H_F').1
  let h_rep : List H := List.ofFn h_fn
  let e_b : Fin h_rep.length ≃ Q_t := (finCongr (List.length_ofFn)).trans e_t
  have hh_rep : ∀ b : Fin h_rep.length, h_rep.get b ∈ H_F' := by
    intro b
    rw [List.get_ofFn]
    exact (Quotient.out (e_t (Fin.cast (List.length_ofFn) b)) : H_F').2
  have he_b_mk : ∀ b : Fin h_rep.length,
      (QuotientGroup.mk (s := M_t') ⟨h_rep.get b, hh_rep b⟩ : Q_t) = e_b b := by
    intro b
    have h_sub : (⟨h_rep.get b, hh_rep b⟩ : H_F') = Quotient.out (e_b b) :=
      Subtype.ext (List.get_ofFn h_fn b)
    rw [h_sub]
    exact Quotient.out_eq (e_b b)
  have h_coset_iff : ∀ (b : Fin h_rep.length) (x : H_F'),
      (h_rep.get b)⁻¹ * x.1 ∈ M_t ↔ b = e_b.symm (QuotientGroup.mk (s := M_t') x) := by
    intro b x
    have h1 : (h_rep.get b)⁻¹ * x.1 ∈ M_t ↔
        (⟨h_rep.get b, hh_rep b⟩ : H_F')⁻¹ * x ∈ M_t' := Iff.rfl
    rw [h1, ← QuotientGroup.eq (s := M_t'), he_b_mk]
    exact ⟨fun h => e_b.injective (by rw [h, e_b.apply_symm_apply]),
      fun h => by rw [h, e_b.apply_symm_apply]⟩
  have hF_card : ∀ g₀ : H, g₀ ∈ H_F' →
      Nat.card {q : K_t × Fin h_rep.length // (q.1.1 * (h_rep.get q.2)⁻¹)⁻¹ * g₀ ∈ N₁} =
        Nat.card ↥(K_t ⊓ N₁) := by
    intro g₀ hg₀
    have hN₁_rot : ∀ (k h_b : H),
        (k * h_b⁻¹)⁻¹ * g₀ ∈ N₁ ↔ k⁻¹ * (g₀ * h_b) ∈ N₁ := by
      intro k h_b
      constructor
      · intro h
        have hc := ‹N₁.Normal›.conj_mem _ h h_b⁻¹
        have heq : h_b⁻¹ * ((k * h_b⁻¹)⁻¹ * g₀) * (h_b⁻¹)⁻¹ = k⁻¹ * (g₀ * h_b) := by group
        rwa [heq] at hc
      · intro h
        have hc := ‹N₁.Normal›.conj_mem _ h h_b
        have heq : h_b * (k⁻¹ * (g₀ * h_b)) * h_b⁻¹ = (k * h_b⁻¹)⁻¹ * g₀ := by group
        rwa [heq] at hc
    let q₀ : Q_t := QuotientGroup.mk (s := M_t') ⟨g₀⁻¹, H_F'.inv_mem hg₀⟩
    let b₀ : Fin h_rep.length := e_b.symm q₀
    let h₀ : H := h_rep.get b₀
    have hh₀_inv : h₀⁻¹ * g₀⁻¹ ∈ M_t :=
      (h_coset_iff b₀ ⟨g₀⁻¹, H_F'.inv_mem hg₀⟩).mpr rfl
    have hg₀h₀_Mt : g₀ * h₀ ∈ M_t := by
      have hinv := M_t.inv_mem hh₀_inv
      have heq : (h₀⁻¹ * g₀⁻¹)⁻¹ = g₀ * h₀ := by group
      rwa [heq] at hinv
    rcases (hMt_mem (g₀ * h₀)).mp hg₀h₀_Mt with ⟨k₀, hk₀, n₀, hn₀, hk₀n₀⟩
    have hk₀_N₁ : k₀⁻¹ * (g₀ * h₀) ∈ N₁ := by
      have heq : k₀⁻¹ * (g₀ * h₀) = n₀ := by rw [hk₀n₀]; group
      rwa [heq]
    have h_fwd : ∀ q : {q : K_t × Fin h_rep.length // (q.1.1 * (h_rep.get q.2)⁻¹)⁻¹ * g₀ ∈ N₁},
        q.1.2 = b₀ ∧ k₀⁻¹ * q.1.1.1 ∈ K_t ⊓ N₁ := by
      rintro ⟨⟨k, b⟩, hq⟩
      dsimp only at hq ⊢
      have hk_N₁ : k.1⁻¹ * (g₀ * h_rep.get b) ∈ N₁ := (hN₁_rot k.1 (h_rep.get b)).mp hq
      have h_in_Mt : g₀ * h_rep.get b ∈ M_t := by
        refine ⟨k.1, k.2, k.1⁻¹ * (g₀ * h_rep.get b), hk_N₁, ?_⟩
        group
      have h_inv_Mt : (h_rep.get b)⁻¹ * g₀⁻¹ ∈ M_t := by
        have hinv := M_t.inv_mem h_in_Mt
        have heq : (g₀ * h_rep.get b)⁻¹ = (h_rep.get b)⁻¹ * g₀⁻¹ := by group
        rwa [heq] at hinv
      have hb_eq : b = b₀ := (h_coset_iff b ⟨g₀⁻¹, H_F'.inv_mem hg₀⟩).mp h_inv_Mt
      refine ⟨hb_eq, K_t.mul_mem (K_t.inv_mem hk₀) k.2, ?_⟩
      have hk_N₁' : k.1⁻¹ * (g₀ * h₀) ∈ N₁ := by
        dsimp only [h₀]
        rwa [← hb_eq]
      have hprod := N₁.mul_mem hk₀_N₁ (N₁.inv_mem hk_N₁')
      have heq : (k₀⁻¹ * (g₀ * h₀)) * (k.1⁻¹ * (g₀ * h₀))⁻¹ = k₀⁻¹ * k.1 := by group
      rwa [heq] at hprod
    have h_bwd : ∀ z : ↥(K_t ⊓ N₁),
        ((k₀ * z.1) * (h_rep.get b₀)⁻¹)⁻¹ * g₀ ∈ N₁ := by
      intro z
      rw [hN₁_rot]
      have hprod := N₁.mul_mem (N₁.inv_mem z.2.2) hk₀_N₁
      have heq : z.1⁻¹ * (k₀⁻¹ * (g₀ * h₀)) = (k₀ * z.1)⁻¹ * (g₀ * h_rep.get b₀) := by
        dsimp only [h₀]
        group
      rwa [← heq]
    let e_F : {q : K_t × Fin h_rep.length // (q.1.1 * (h_rep.get q.2)⁻¹)⁻¹ * g₀ ∈ N₁} ≃
        ↥(K_t ⊓ N₁) :=
      { toFun := fun q => ⟨k₀⁻¹ * q.1.1.1, (h_fwd q).2⟩
        invFun := fun z => ⟨(⟨k₀ * z.1, K_t.mul_mem hk₀ z.2.1⟩, b₀), h_bwd z⟩
        left_inv := fun q => by
          apply Subtype.ext
          apply Prod.ext
          · apply Subtype.ext
            dsimp only
            group
          · exact (h_fwd q).1.symm
        right_inv := fun z => by
          apply Subtype.ext
          dsimp only
          group }
    exact Nat.card_congr e_F
  have hFib1 : ∀ u : H,
      Nat.card {p : K_t × Fin h_rep.length × H_L' //
        p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1 = u} =
      Nat.card ↥(K_t ⊓ N₁) := by
    intro u
    rcases hHF'_HL'_mul u with ⟨x₀, hx₀, y₀, hy₀, hu⟩
    have h_fwd1 : ∀ p : {p : K_t × Fin h_rep.length × H_L' //
        p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1 = u},
        (p.1.1.1 * (h_rep.get p.1.2.1)⁻¹)⁻¹ * x₀ ∈ N₁ := by
      rintro ⟨⟨k, b, y⟩, hp⟩
      dsimp only at hp ⊢
      set g := k.1 * (h_rep.get b)⁻¹
      have hg : g ∈ H_F' := H_F'.mul_mem (hKt_le k.2) (H_F'.inv_mem (hh_rep b))
      have heq : g⁻¹ * x₀ = y.1 * y₀⁻¹ := by
        calc g⁻¹ * x₀ = g⁻¹ * (x₀ * y₀) * y₀⁻¹ := by group
          _ = g⁻¹ * u * y₀⁻¹ := by rw [← hu]
          _ = g⁻¹ * (g * y.1) * y₀⁻¹ := by rw [← hp]
          _ = y.1 * y₀⁻¹ := by group
      have h_HF' : g⁻¹ * x₀ ∈ H_F' := H_F'.mul_mem (H_F'.inv_mem hg) hx₀
      have h_HL' : g⁻¹ * x₀ ∈ H_L' := by
        rw [heq]
        exact H_L'.mul_mem y.2 (H_L'.inv_mem hy₀)
      exact hHF'_HL'_inf (g⁻¹ * x₀) h_HF' h_HL'
    have h_bwd1 : ∀ q : {q : K_t × Fin h_rep.length //
        (q.1.1 * (h_rep.get q.2)⁻¹)⁻¹ * x₀ ∈ N₁},
        (q.1.1.1 * (h_rep.get q.1.2)⁻¹)⁻¹ * u ∈ H_L' := by
      rintro ⟨⟨k, b⟩, hq⟩
      dsimp only at hq ⊢
      set g := k.1 * (h_rep.get b)⁻¹
      have heq : g⁻¹ * u = (g⁻¹ * x₀) * y₀ := by rw [hu]; group
      rw [heq]
      exact H_L'.mul_mem (hN₁_le_HL' hq) hy₀
    let e_Fib1 : {p : K_t × Fin h_rep.length × H_L' //
        p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1 = u} ≃
        {q : K_t × Fin h_rep.length // (q.1.1 * (h_rep.get q.2)⁻¹)⁻¹ * x₀ ∈ N₁} :=
      { toFun := fun p => ⟨(p.1.1, p.1.2.1), h_fwd1 p⟩
        invFun := fun q =>
          ⟨(q.1.1, q.1.2, ⟨(q.1.1.1 * (h_rep.get q.1.2)⁻¹)⁻¹ * u, h_bwd1 q⟩),
            by dsimp only; group⟩
        left_inv := by
          rintro ⟨⟨k, b, y⟩, hp⟩
          apply Subtype.ext
          apply Prod.ext
          · rfl
          · apply Prod.ext
            · rfl
            · apply Subtype.ext
              dsimp only at hp ⊢
              rw [← hp]
              group
        right_inv := fun q => rfl }
    rw [Nat.card_congr e_Fib1, hF_card x₀ hx₀]
  have hFib2 : ∀ u : H, u ∉ H_F' →
      Nat.card {p : K_t × Fin r × Fin h_rep.length × H_F' //
        p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u} =
      Nat.card ↥(K_t ⊓ N₁) := by
    intro u hu_not_HF'
    rcases hHF'_HL'_mul u with ⟨x₀, hx₀, y₀, hy₀, hu⟩
    let y₁ : H := x₀ * y₀ * x₀⁻¹
    have hy₁_eq : u = y₁ * x₀ := by rw [hu]; dsimp only [y₁]; group
    have hy₁_HL' : y₁ ∈ H_L' := ‹H_L'.Normal›.conj_mem y₀ hy₀ x₀
    have hy₁_not_N₁ : y₁ ∉ N₁ := by
      intro hy₁_N₁
      apply hu_not_HF'
      rw [hy₁_eq]
      exact H_F'.mul_mem (hN₁_le_HF' hy₁_N₁) hx₀
    rcases hc_orbit y₁ hy₁_HL' hy₁_not_N₁ with ⟨a₀, g₀, hg₀, h_orb⟩
    have h_fwd2 : ∀ p : {p : K_t × Fin r × Fin h_rep.length × H_F' //
        p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u},
        p.1.2.1 = a₀ ∧ (p.1.1.1 * (h_rep.get p.1.2.2.1)⁻¹)⁻¹ * g₀ ∈ N₁ := by
      rintro ⟨⟨k, a, b, x⟩, hp⟩
      dsimp only at hp ⊢
      set g := k.1 * (h_rep.get b)⁻¹
      have hg : g ∈ H_F' := H_F'.mul_mem (hKt_le k.2) (H_F'.inv_mem (hh_rep b))
      let t := y₁⁻¹ * (g * (c_rep a)⁻¹ * g⁻¹)
      have ht_eq : x₀ * x.1⁻¹ * g⁻¹ = t := by
        calc x₀ * x.1⁻¹ * g⁻¹ = y₁⁻¹ * (y₁ * x₀) * x.1⁻¹ * g⁻¹ := by group
          _ = y₁⁻¹ * u * x.1⁻¹ * g⁻¹ := by rw [← hy₁_eq]
          _ = y₁⁻¹ * (k.1 * (c_rep a * h_rep.get b)⁻¹ * x.1) * x.1⁻¹ * g⁻¹ := by rw [← hp]
          _ = t := by dsimp only [t, g]; group
      have ht_HF' : t ∈ H_F' := by
        rw [← ht_eq]
        exact H_F'.mul_mem (H_F'.mul_mem hx₀ (H_F'.inv_mem x.2)) (H_F'.inv_mem hg)
      have ht_HL' : t ∈ H_L' :=
        H_L'.mul_mem (H_L'.inv_mem hy₁_HL')
          (‹H_L'.Normal›.conj_mem (c_rep a)⁻¹ (H_L'.inv_mem (hc_rep a).1) g)
      have ht_N₁ : t ∈ N₁ := hHF'_HL'_inf t ht_HF' ht_HL'
      have h_conj : g * (c_rep a)⁻¹ * g⁻¹ * y₁⁻¹ ∈ N₁ := by
        have hc := ‹N₁.Normal›.conj_mem t ht_N₁ y₁
        have heq : y₁ * t * y₁⁻¹ = g * (c_rep a)⁻¹ * g⁻¹ * y₁⁻¹ := by dsimp only [t]; group
        rwa [heq] at hc
      exact (h_orb a g hg).mp h_conj
    have h_bwd2 : ∀ q : {q : K_t × Fin h_rep.length //
        (q.1.1 * (h_rep.get q.2)⁻¹)⁻¹ * g₀ ∈ N₁},
        (q.1.1.1 * (c_rep a₀ * h_rep.get q.1.2)⁻¹)⁻¹ * u ∈ H_F' := by
      rintro ⟨⟨k, b⟩, hq⟩
      dsimp only at hq ⊢
      set g := k.1 * (h_rep.get b)⁻¹
      have hg : g ∈ H_F' := H_F'.mul_mem (hKt_le k.2) (H_F'.inv_mem (hh_rep b))
      have hz : g * (c_rep a₀)⁻¹ * g⁻¹ * y₁⁻¹ ∈ N₁ := (h_orb a₀ g hg).mpr ⟨rfl, hq⟩
      let t' := y₁⁻¹ * (g * (c_rep a₀)⁻¹ * g⁻¹ * y₁⁻¹)⁻¹ * (y₁⁻¹)⁻¹
      have ht'_N₁ : t' ∈ N₁ := ‹N₁.Normal›.conj_mem _ (N₁.inv_mem hz) y₁⁻¹
      have heq : (k.1 * (c_rep a₀ * h_rep.get b)⁻¹)⁻¹ * u = g⁻¹ * t' * x₀ := by
        rw [hy₁_eq]
        dsimp only [t', g]
        group
      rw [heq]
      exact H_F'.mul_mem (H_F'.mul_mem (H_F'.inv_mem hg) (hN₁_le_HF' ht'_N₁)) hx₀
    let e_Fib2 : {p : K_t × Fin r × Fin h_rep.length × H_F' //
        p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u} ≃
        {q : K_t × Fin h_rep.length // (q.1.1 * (h_rep.get q.2)⁻¹)⁻¹ * g₀ ∈ N₁} :=
      { toFun := fun p => ⟨(p.1.1, p.1.2.2.1), (h_fwd2 p).2⟩
        invFun := fun q =>
          ⟨(q.1.1, a₀, q.1.2,
              ⟨(q.1.1.1 * (c_rep a₀ * h_rep.get q.1.2)⁻¹)⁻¹ * u, h_bwd2 q⟩),
            by dsimp only; group⟩
        left_inv := by
          rintro ⟨⟨k, a, b, x⟩, hp⟩
          have ha : a = a₀ := (h_fwd2 ⟨(k, a, b, x), hp⟩).1
          apply Subtype.ext
          apply Prod.ext
          · rfl
          · apply Prod.ext
            · exact ha.symm
            · apply Prod.ext
              · rfl
              · apply Subtype.ext
                dsimp only at hp ⊢
                rw [← ha, ← hp]
                group
        right_inv := fun q => rfl }
    rw [Nat.card_congr e_Fib2, hF_card g₀ hg₀]
  have hConj_Kt : ∀ (a : Fin r) (b : Fin h_rep.length) (x : H) (g : H),
      x ∈ H_F' → g ∈ H_F' →
      (((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ↔
        ((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ⊓ N₁) := by
    intro a b x g hx hg
    set w := (c_rep a * h_rep.get b)⁻¹ * x
    set z := w * g * w⁻¹
    refine ⟨fun hz => ⟨hz, ?_⟩, fun hz => hz.1⟩
    let h_b := h_rep.get b
    let c_a := c_rep a
    let g' := x * g * x⁻¹
    have hg' : g' ∈ H_F' := H_F'.mul_mem (H_F'.mul_mem hx hg) (H_F'.inv_mem hx)
    let t := (g')⁻¹ * h_b * z * h_b⁻¹
    have ht_HF' : t ∈ H_F' :=
      H_F'.mul_mem (H_F'.mul_mem (H_F'.mul_mem (H_F'.inv_mem hg') (hh_rep b)) (hKt_le hz))
        (H_F'.inv_mem (hh_rep b))
    let y := c_a⁻¹
    have ht_eq : t = (g')⁻¹ * c_a⁻¹ * ((g')⁻¹)⁻¹ * y⁻¹ := by
      dsimp only [t, z, w, g', h_b, c_a, y]
      group
    have hy_HL' : y ∈ H_L' := H_L'.inv_mem (hc_rep a).1
    have ht_HL' : t ∈ H_L' := by
      rw [ht_eq]
      exact H_L'.mul_mem (‹H_L'.Normal›.conj_mem c_a⁻¹ hy_HL' (g')⁻¹) (H_L'.inv_mem hy_HL')
    have ht_N₁ : (g')⁻¹ * (c_rep a)⁻¹ * ((g')⁻¹)⁻¹ * y⁻¹ ∈ N₁ := by
      rw [← ht_eq]
      exact hHF'_HL'_inf t ht_HF' ht_HL'
    have hy_not_N₁ : y ∉ N₁ := by
      intro hy_N₁
      apply (hc_rep a).2
      have hinv := N₁.inv_mem hy_N₁
      have heq : y⁻¹ = c_rep a := by dsimp only [y, c_a]; group
      rwa [heq] at hinv
    rcases hc_orbit y hy_HL' hy_not_N₁ with ⟨a₀, g₀, hg₀, h_orb⟩
    have h1_in_N₁ : (1 : H) * (c_rep a)⁻¹ * (1 : H)⁻¹ * y⁻¹ ∈ N₁ := by
      have heq : (1 : H) * (c_rep a)⁻¹ * (1 : H)⁻¹ * y⁻¹ = 1 := by dsimp only [y, c_a]; group
      rw [heq]
      exact N₁.one_mem
    have h1_g₀ : (1 : H)⁻¹ * g₀ ∈ N₁ := ((h_orb a 1 H_F'.one_mem).mp h1_in_N₁).2
    have hg'_g₀ : ((g')⁻¹)⁻¹ * g₀ ∈ N₁ := ((h_orb a (g')⁻¹ (H_F'.inv_mem hg')).mp ht_N₁).2
    have hg'_N₁ : g' ∈ N₁ := by
      have hprod := N₁.mul_mem hg'_g₀ (N₁.inv_mem h1_g₀)
      have heq : (((g')⁻¹)⁻¹ * g₀) * ((1 : H)⁻¹ * g₀)⁻¹ = g' := by group
      rwa [heq] at hprod
    have hz_N₁ := ‹N₁.Normal›.conj_mem g' hg'_N₁ (c_rep a * h_rep.get b)⁻¹
    have hz_eq : (c_rep a * h_rep.get b)⁻¹ * g' * ((c_rep a * h_rep.get b)⁻¹)⁻¹ = z := by
      dsimp only [z, w, g']
      group
    rwa [hz_eq] at hz_N₁
  exact ⟨h_rep, hKt_N₁, hh_rep, hFib1, hFib2, hConj_Kt⟩

theorem ld_ch14_semidirect_galois_correspondence_and_branch_A (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hGal : IsGaloisExt F L K)
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀)
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (hG_mul : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
    (h_sub_MC : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      C ≤ M → (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ M_C)
    (h_sub_lt : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      M < ⊤ → L < (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F) :
    let K' := IntermediateField.extendScalars hLK
    let G := (K' ≃ₐ[L] K')
    let fieldOf : Subgroup G → IntermediateField F (AlgebraicClosure F) :=
      fun M => (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F
    ((∃ (H' : Subgroup H),
        H'.Normal ∧
        (∀ a b : H, a * b * a⁻¹ * b⁻¹ ∈ H') ∧
        H'.index = q₀) →
      ∃ (F' : IntermediateField F (AlgebraicClosure F)) (hLF' : L ≤ F'),
        F' ≤ M_C ∧
        L < F' ∧
        IsGaloisExt F L F' ∧
        IsAbelianExt F hLF' ∧
        Module.finrank L (IntermediateField.extendScalars hLF') = q₀) ∧
    (∃ proj_H : G →* H,
      (∀ (h : H) (c : G), c ∈ C → proj_H (h.1 * c) = h) ∧
      (∀ h : H, proj_H h.1 = h) ∧
      Function.Surjective proj_H ∧
      (∀ g : G, proj_H g = 1 ↔ g ∈ C) ∧
      (∀ (S : Subgroup H) (g : G), g ∈ S.comap proj_H ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c) ∧
      fieldOf H = E ∧
