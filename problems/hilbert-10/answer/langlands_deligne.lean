        rw [h_const_G, ← Nat.cast_sum, hFiber_M m hm G hG, Nat.cast_mul]
        have hG_c : (-1 : k_M) ^ m * G.coeff 0 ≠ 0 :=
          mul_ne_zero (pow_ne_zero m (neg_ne_zero.mpr one_ne_zero)) hG_nz
        set u_G := Units.mk0 ((-1 : k_M) ^ m * G.coeff 0) hG_c
        have h_card : ((Finset.univ.filter (fun y : k_M => y ^ ℓ = (-1 : k_M) ^ m * G.coeff 0)).card : Ω F) =
            1 + ∑ i : Fin r, ∑ c ∈ H_f, (((μ_tilde i) ^ c) u_G : Ω F) :=
          ((hμ_orb_sum u_G).trans (hν_orth u_G).1).symm
        rw [h_card, mul_add, mul_one, add_mul]
        congr 1
        rw [Finset.mul_sum, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro i _hi
        rw [Finset.mul_sum, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro c _hc
        rw [mul_assoc]
        congr 1
        dsimp only [lam_M]
        have hG_c' : (-1 : k_M) ^ G.natDegree * G.coeff 0 ≠ 0 := by
          rw [hG_deg]
          exact hG_c
        rw [dif_pos hG_c', dif_pos hG_c', ← mul_assoc]
        congr 1
        have hu_eq : Units.mk0 ((-1 : k_M) ^ G.natDegree * G.coeff 0) hG_c' = u_G := by
          ext
          rw [Units.val_mk0, Units.val_mk0, hG_deg]
        rw [hu_eq, MonoidHom.mul_apply, Units.val_mul]
      rw [Finset.sum_congr rfl h_fiber_eval, Finset.sum_add_distrib]
      have h_restore : ∀ β : k_Mˣ →* (Ω F)ˣ,
          (∑ G ∈ M_M_nz, (Λ_M G : Ω F) * lam_M β G) =
            (-1 : Ω F) ^ (m - 1) * (∑ y : k_Mˣ, (β y : Ω F) * ψ_M (y : k_M)) ^ m := by
        intro β
        have h_eq : (∑ G ∈ M_M_nz, (Λ_M G : Ω F) * lam_M β G) =
            ∑ G ∈ M_M m, (Λ_M G : Ω F) * lam_M β G := by
          symm
          rw [← Finset.sum_filter_add_sum_filter_not (M_M m) (fun G => G.coeff 0 ≠ 0)]
          have h_zero : ∑ G ∈ (M_M m).filter (fun G => ¬ G.coeff 0 ≠ 0),
              (Λ_M G : Ω F) * lam_M β G = 0 := by
            apply Finset.sum_eq_zero
            intro G hG
            rw [Finset.mem_filter] at hG
            rw [hlam_c0_zero β G (not_not.mp hG.2), mul_zero]
          rw [h_zero, add_zero]
        rw [h_eq]
        exact hΛ_M_dh β ψ_M hψ_M m hm
      rw [h_restore α_M]
      congr 1
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro i _hi
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro c _hc
      exact h_restore ((μ_tilde i) ^ c * α_M)
  intro α d hd hd_le
  by_cases hdvd : f_H ∣ d
  · rw [if_pos hdvd]
    set m := d / f_H
    have hd_eq : d = f_H * m := (Nat.mul_div_cancel' hdvd).symm
    have hm : 1 ≤ m := by
      rcases Nat.eq_zero_or_pos m with hm0 | hmp
      · exfalso
        rw [hm0, mul_zero] at hd_eq
        omega
      · exact hmp
    conv_lhs => rw [hd_eq]
    rw [(h_s1 α m hm).1, h_s3.2 _ m hm, (h_s1 α m hm).2, ← hd_eq]
    congr 1
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _hi
    exact h_s2 α i m
  · rw [if_neg hdvd, add_zero]
    exact h_s3.1 α d hd hd_le hdvd

theorem ld_ch13_finite_field_orbit_davenport_hasse_product (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (ℓ f_H r : ℕ) (hPrime : Nat.Prime ℓ) (hOdd : ℓ ≠ 2)
    (hf_H_gt1 : 1 < f_H) (hr_pos : 1 ≤ r) (hr_mul : r * f_H = ℓ - 1)
    (hfinrank : Module.finrank k_L k_M = f_H)
    (hNeChar : (ℓ : k_L) ≠ 0)
    (hNotDvd : ∀ d : ℕ, 1 ≤ d → d < f_H → ¬ (ℓ ∣ ((Fintype.card k_L) ^ d - 1)))
    (hcard_Hf : ((Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1)).card = f_H)
    (ψ_k : AddChar k_L (Ω F)) (hψ_k : ψ_k ≠ 1)
    (χ_k : k_Lˣ →* (Ω F)ˣ) (μ_tilde : Fin r → (k_Mˣ →* (Ω F)ˣ))
    (hμ_props : ∀ i : Fin r, (μ_tilde i) ^ ℓ = 1 ∧ μ_tilde i ≠ 1)
    (hμ_orb_sum : ∀ y : k_Mˣ,
      1 + (∑ i : Fin r,
        ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
          (((μ_tilde i) ^ c) y : Ω F)) =
        ∑ j ∈ Finset.range ℓ, (((μ_tilde ⟨0, hr_pos⟩) ^ j) y : Ω F)) :
    (((χ_k (Units.mk0 (ℓ : k_L) hNeChar))⁻¹) ^ ℓ : Ω F) *
      (∑ x : k_Lˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k_L)) *
      (∏ i : Fin r,
        (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) *
          ψ_k (Algebra.trace k_L k_M (y : k_M)))) =
    (∑ x : k_Lˣ, (χ_k x : Ω F) * ψ_k (x : k_L)) *
      (∏ i : Fin r,
        (∑ y : k_Mˣ, ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
          ψ_k (Algebra.trace k_L k_M (y : k_M)))) :=
by
  have hν_props := hμ_props ⟨0, hr_pos⟩
  obtain ⟨hν_ne_pow, ⟨ζ, hζ_ne, hζ_pow, hζ_prim, hζ_prod⟩, hν_orth⟩ :=
    ld_finite_field_cyclic_char_and_zeta F k_M ℓ hPrime (μ_tilde ⟨0, hr_pos⟩) hν_props.1 hν_props.2
  obtain ⟨M_L, Λ_L, hM_L_mem, hM_L_zero, _hM_L_one, hΛ_L_prime_pow, hΛ_L_ne_zero,
      hNewton_L, hΛ_L_sum_nz, _hΛ_L_char_orth, hΛ_L_dh⟩ :=
    ld_monic_deg_and_von_mangoldt_newton F k_L
  obtain ⟨M_M, Λ_M, hM_M_mem, _hM_M_zero, _hM_M_one, hΛ_M_prime_pow, hΛ_M_ne_zero,
      _hNewton_M, hΛ_M_sum_nz, hΛ_M_char_orth, hΛ_M_dh⟩ :=
    ld_monic_deg_and_von_mangoldt_newton F k_M
  obtain ⟨σ_M, 𝒩_ℓ_M, hσ_coeff, hσ_mem, hσ_mul, hσ_zero, hσ_add, hσ_expand, hσ_irr,
      h𝒩_M_prop, h𝒩_M_one, h𝒩_M_mul, h𝒩_M_nextCoeff⟩ :=
    ld_ch13_norm_poly_operator_with_coeff_and_nextCoeff F k_M ℓ hPrime
      ζ hζ_ne hζ_pow hζ_prim hζ_prod M_M hM_M_mem
  have hFiber_M :=
    ld_norm_poly_von_mangoldt_fiber_sum F k_M ℓ hPrime (μ_tilde ⟨0, hr_pos⟩) hν_ne_pow hν_orth
      M_M Λ_M hM_M_mem hΛ_M_prime_pow hΛ_M_ne_zero hΛ_M_sum_nz hΛ_M_char_orth
      σ_M 𝒩_ℓ_M hσ_mem hσ_mul hσ_zero hσ_add hσ_expand hσ_irr h𝒩_M_prop h𝒩_M_mul
  obtain ⟨τ_L, 𝒩_ℓ_L, N_Γ, hτ_pow, hτ_pow_fH, hτ_poly_fix, hτ_σ_comm, _hτ_N_comm,
      h𝒩_L_map, h𝒩_L_prop, h𝒩_L_one, h𝒩_L_mul, h𝒩_L_deg_ell, hN_Gamma_map, hN_Gamma_prop⟩ :=
    ld_ch13_frob_norm_poly_and_galois_norm F k_L k_M ℓ f_H hPrime hf_H_gt1 hfinrank hNeChar
      ζ hζ_ne hζ_pow hζ_prim M_L hM_L_mem M_M hM_M_mem σ_M 𝒩_ℓ_M
      hσ_coeff hσ_mem h𝒩_M_prop h𝒩_M_one h𝒩_M_mul h𝒩_M_nextCoeff
  have hN_Gamma_mem_c0 : ∀ (m : ℕ) (Q : Polynomial k_M), Q ∈ M_M m →
      N_Γ Q ∈ M_L (f_H * m) ∧
      (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 =
        Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0) :=
    fun m Q hQ => ⟨(hN_Gamma_prop m Q hQ).1, (hN_Gamma_prop m Q hQ).2.1⟩
  obtain ⟨hIrrFrobFix, hFiber_Gamma⟩ :=
    ld_ch13_galois_norm_irreducible_orbit_and_fiber_sum F k_L k_M f_H hf_H_gt1 hfinrank
      M_L Λ_L hM_L_mem hΛ_L_prime_pow hΛ_L_sum_nz
      M_M Λ_M hM_M_mem hΛ_M_prime_pow hΛ_M_ne_zero hΛ_M_sum_nz
      τ_L N_Γ hτ_pow_fH hτ_poly_fix hN_Gamma_map hN_Gamma_mem_c0
  have hFiber_L_nondiv :=
    ld_ch13_norm_poly_nondiv_deg_fiber_sum F k_L k_M ℓ f_H hPrime hf_H_gt1 hNotDvd
      ζ hζ_ne hζ_pow hζ_prim M_L Λ_L hM_L_mem hΛ_L_prime_pow hΛ_L_ne_zero
      M_M hM_M_mem σ_M 𝒩_ℓ_M hσ_coeff hσ_mem hσ_mul hσ_zero hσ_add hσ_expand hσ_irr h𝒩_M_prop
      τ_L 𝒩_ℓ_L hτ_pow_fH hτ_σ_comm h𝒩_L_map h𝒩_L_prop h𝒩_L_one h𝒩_L_mul hIrrFrobFix
  have h𝒩_M_prop' : ∀ (d : ℕ) (P : Polynomial k_M), P ∈ M_M d →
      𝒩_ℓ_M P ∈ M_M d ∧
      (-1 : k_M) ^ d * (𝒩_ℓ_M P).coeff 0 = ((-1 : k_M) ^ d * P.coeff 0) ^ ℓ :=
    fun d P hP => ⟨(h𝒩_M_prop d P hP).1, (h𝒩_M_prop d P hP).2.2⟩
  have hPowerSum :=
    ld_ch13_orbit_gauss_frob_and_power_sums F k_L k_M ℓ f_H r hPrime hf_H_gt1 hr_pos hfinrank
      hNotDvd hcard_Hf ψ_k hψ_k μ_tilde hμ_props hμ_orb_sum
      ζ hζ_ne hζ_pow hζ_prim hν_orth
      M_L Λ_L hM_L_mem hΛ_L_dh M_M Λ_M hM_M_mem hΛ_M_dh
      𝒩_ℓ_M h𝒩_M_prop' hFiber_M τ_L 𝒩_ℓ_L N_Γ hτ_pow hτ_pow_fH h𝒩_L_prop
      hN_Gamma_prop hFiber_Gamma hFiber_L_nondiv
  have hPascalNewton : ∀ (G_orb : Fin r → Ω F),
      ∃ E_r : ℕ → Ω F,
        E_r 0 = 1 ∧
        E_r r = (∏ i : Fin r, G_orb i) ∧
        (∀ k : ℕ, 1 ≤ k →
          (∑ j ∈ Finset.Icc 1 k,
            (∑ i : Fin r, (-1 : Ω F) ^ (j - 1) * (G_orb i) ^ j) * E_r (k - j)) =
            (k : Ω F) * E_r k) := by
    intro G_orb
    let g : ℕ → Ω F := fun i => if h : i < r then G_orb ⟨i, h⟩ else 0
    have hg_fin : ∀ i : Fin r, G_orb i = g i.1 := fun i => by simp [g, i.2]
    let E : ℕ → ℕ → Ω F := elemSymmRange g
    have hE_zero : ∀ m : ℕ, E m 0 = 1 := by
      intro m
      cases m <;> rfl
    have hE_succ_zero : ∀ k : ℕ, E 0 (k + 1) = 0 := fun _ => rfl
    have hE_succ_succ : ∀ m k : ℕ, E (m + 1) (k + 1) = E m (k + 1) + g m * E m k := fun _ _ => rfl
    have hE_gt : ∀ m n : ℕ, m < n → E m n = 0 := by
      intro m
      induction m with
      | zero =>
        intro n hn
        cases n with
        | zero => omega
        | succ k => exact hE_succ_zero k
      | succ m ih =>
        intro n hn
        cases n with
        | zero => omega
        | succ k =>
          rw [hE_succ_succ, ih (k + 1) (by omega), ih k (by omega), mul_zero, add_zero]
    have hE_diag : ∀ m : ℕ, E m m = ∏ j ∈ Finset.range m, g j := by
      intro m
      induction m with
      | zero => rw [hE_zero 0, Finset.prod_range_zero]
      | succ m ih =>
        rw [hE_succ_succ, hE_gt m (m + 1) (by omega), zero_add, ih, Finset.prod_range_succ, mul_comm]
    have hIcc_eq_range : ∀ (n : ℕ) (f : ℕ → Ω F),
        (∑ d ∈ Finset.Icc 1 n, f d) = ∑ i ∈ Finset.range n, f (i + 1) := by
      intro n f
      induction n with
      | zero => simp
      | succ k ih =>
        rw [Finset.sum_Icc_succ_top (Nat.le_add_left 1 k), Finset.sum_range_succ, ih]
    let C : ℕ → (ℕ → Ω F) → ℕ → Ω F := fun m c n =>
      ∑ i ∈ Finset.range n, c i * E m (n - (i + 1))
    have hC_add : ∀ (m : ℕ) (c₁ c₂ : ℕ → Ω F) (n : ℕ),
        C m (fun i => c₁ i + c₂ i) n = C m c₁ n + C m c₂ n := by
      intro m c₁ c₂ n
      dsimp [C]
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i _
      ring
    have hC_succ : ∀ (m : ℕ) (c : ℕ → Ω F) (k : ℕ),
        C (m + 1) c (k + 1) = C m c (k + 1) + g m * C m c k := by
      intro m c k
      dsimp [C]
      rw [Finset.sum_range_succ, Finset.sum_range_succ, Nat.sub_self, hE_zero (m + 1), hE_zero m]
      have h_sum : (∑ i ∈ Finset.range k, c i * E (m + 1) (k + 1 - (i + 1))) =
          (∑ i ∈ Finset.range k, c i * E m (k + 1 - (i + 1))) +
            g m * (∑ i ∈ Finset.range k, c i * E m (k - (i + 1))) := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i < k := Finset.mem_range.mp hi
        have h_sub : k + 1 - (i + 1) = (k - (i + 1)) + 1 := by omega
        rw [h_sub, hE_succ_succ]
        ring
      rw [h_sum]
      ring
    let q_x : Ω F → ℕ → Ω F := fun x i => (-1 : Ω F) ^ i * x ^ (i + 1)
    have hC_single : ∀ (m : ℕ) (x : Ω F) (k : ℕ),
        C m (q_x x) (k + 1) + x * C m (q_x x) k = x * E m k := by
      intro m x k
      dsimp [C, q_x]
      rw [Finset.sum_range_succ', Finset.mul_sum, add_right_comm, ← Finset.sum_add_distrib]
      have h_zero : (∑ i ∈ Finset.range k,
          ((-1 : Ω F) ^ (i + 1) * x ^ (i + 1 + 1) * E m (k + 1 - (i + 1 + 1)) +
            x * ((-1 : Ω F) ^ i * x ^ (i + 1) * E m (k - (i + 1))))) = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        have h_sub : k + 1 - (i + 1 + 1) = k - (i + 1) := by omega
        rw [h_sub, pow_succ (-1 : Ω F) i, pow_succ x (i + 1)]
        ring
      rw [h_zero, zero_add, Nat.add_sub_cancel, pow_zero, pow_one, one_mul]
    let Q : ℕ → ℕ → Ω F := fun m i => ∑ j ∈ Finset.range m, (-1 : Ω F) ^ i * (g j) ^ (i + 1)
    have hNewton_E : ∀ m n : ℕ, C m (Q m) n = (n : Ω F) * E m n := by
      intro m
      induction m with
      | zero =>
        intro n
        have h_lhs : C 0 (Q 0) n = 0 := by
          dsimp [C, Q]
          apply Finset.sum_eq_zero
          intro i _
          exact zero_mul _
        rw [h_lhs]
        cases n with
        | zero => simp
        | succ k => rw [hE_succ_zero k, mul_zero]
      | succ m ih =>
        intro n
        cases n with
        | zero =>
          dsimp [C]
          simp
        | succ k =>
          have hQ_succ : Q (m + 1) = fun i => Q m i + q_x (g m) i := by
            ext i
            dsimp [Q, q_x]
            rw [Finset.sum_range_succ]
          have h1 := hC_single m (g m) k
          rw [hQ_succ, hC_add, hC_succ, hC_succ, ih (k + 1), ih k, hE_succ_succ]
          push_cast
          linear_combination h1
    refine ⟨E r, hE_zero r, ?_, ?_⟩
    · rw [hE_diag r, ← Fin.prod_univ_eq_prod_range]
      exact Finset.prod_congr rfl (fun i _ => (hg_fin i).symm)
    · intro k _
      rw [hIcc_eq_range, ← hNewton_E r k]
      dsimp [C, Q]
      apply Finset.sum_congr rfl
      intro i _
      congr 1
      rw [← Fin.sum_univ_eq_sum_range (fun j => (-1 : Ω F) ^ i * g j ^ (i + 1)) r]
      exact Finset.sum_congr rfl (fun s _ => by rw [hg_fin s])
  have hFullRec : ∀ (g₀ : Ω F) (G_orb : Fin r → Ω F) (E_r : ℕ → Ω F),
      E_r 0 = 1 →
      E_r r = (∏ i : Fin r, G_orb i) →
      (∀ k : ℕ, 1 ≤ k →
        (∑ j ∈ Finset.Icc 1 k,
          (∑ i : Fin r, (-1 : Ω F) ^ (j - 1) * (G_orb i) ^ j) * E_r (k - j)) =
          (k : Ω F) * E_r k) →
      ∃ E_full : ℕ → Ω F,
        E_full 0 = 1 ∧
        E_full (r * f_H + 1) = g₀ * (∏ i : Fin r, G_orb i) ∧
        (∀ n : ℕ, 1 ≤ n →
          (∑ d ∈ Finset.Icc 1 n,
            ((-1 : Ω F) ^ (d - 1) * g₀ ^ d +
              (if f_H ∣ d then
                (f_H : Ω F) * ∑ i : Fin r, (-1 : Ω F) ^ (d / f_H - 1) * (G_orb i) ^ (d / f_H)
               else 0)) *
              E_full (n - d)) =
            (n : Ω F) * E_full n) := by
    intro g₀ G_orb E_r hEr0 hErr hEr_rec
    have hf_H_pos : 0 < f_H := by omega
    let Q_r : ℕ → Ω F := fun j => ∑ i : Fin r, (-1 : Ω F) ^ (j - 1) * (G_orb i) ^ j
    let B : ℕ → Ω F := fun n => if f_H ∣ n then E_r (n / f_H) else 0
    let E_full : ℕ → Ω F := fun n => match n with
      | 0 => 1
      | k + 1 => B (k + 1) + g₀ * B k
    let S_B : ℕ → Ω F := fun d => if f_H ∣ d then (f_H : Ω F) * Q_r (d / f_H) else 0
    have hB0 : B 0 = 1 := by
      dsimp [B]
      rw [Nat.zero_div, hEr0]
    have hB_rec : ∀ n : ℕ, (∑ d ∈ Finset.Icc 1 n, S_B d * B (n - d)) = (n : Ω F) * B n := by
      intro n
      rcases Nat.eq_zero_or_pos n with rfl | hn_pos
      · simp
      · by_cases h_dvd : f_H ∣ n
        · rcases h_dvd with ⟨k, rfl⟩
          have hk_pos : 1 ≤ k := by
            rcases Nat.eq_zero_or_pos k with rfl | hk
            · simp at hn_pos
            · exact hk
          have h_filter : (∑ d ∈ Finset.Icc 1 (f_H * k), S_B d * B (f_H * k - d)) =
              ∑ d ∈ (Finset.Icc 1 (f_H * k)).filter (fun d => f_H ∣ d), S_B d * B (f_H * k - d) := by
            rw [Finset.sum_filter]
            apply Finset.sum_congr rfl
            intro d _
            by_cases hd : f_H ∣ d
            · rw [if_pos hd]
            · change S_B d * B (f_H * k - d) = if f_H ∣ d then S_B d * B (f_H * k - d) else 0
              rw [if_neg hd]
              dsimp [S_B]
              rw [if_neg hd, zero_mul]
          rw [h_filter]
          have h_bij : (∑ d ∈ (Finset.Icc 1 (f_H * k)).filter (fun d => f_H ∣ d), S_B d * B (f_H * k - d)) =
              ∑ j ∈ Finset.Icc 1 k, (f_H : Ω F) * (Q_r j * E_r (k - j)) := by
            refine (Finset.sum_bij (fun (j : ℕ) _ => f_H * j) ?_ ?_ ?_ ?_).symm
            · intro j hj
              rw [Finset.mem_filter, Finset.mem_Icc]
              rw [Finset.mem_Icc] at hj
              refine ⟨⟨?_, ?_⟩, dvd_mul_right f_H j⟩
              · calc 1 = 1 * 1 := by ring
                  _ ≤ f_H * j := Nat.mul_le_mul (by omega) hj.1
              · exact Nat.mul_le_mul_left f_H hj.2
            · intro j₁ _ j₂ _ h_eq
              exact Nat.eq_of_mul_eq_mul_left hf_H_pos h_eq
            · intro d hd
              rw [Finset.mem_filter, Finset.mem_Icc] at hd
              rcases hd.2 with ⟨j, rfl⟩
              refine ⟨j, Finset.mem_Icc.mpr ⟨?_, ?_⟩, rfl⟩
              · rcases Nat.eq_zero_or_pos j with rfl | hj_pos
                · have := hd.1.1; simp at this
                · exact hj_pos
              · exact Nat.le_of_mul_le_mul_left hd.1.2 hf_H_pos
            · intro j hj
              rw [Finset.mem_Icc] at hj
              dsimp [S_B, B]
              have h_div1 : f_H * j / f_H = j := Nat.mul_div_cancel_left j hf_H_pos
              have h_sub : f_H * k - f_H * j = f_H * (k - j) := (Nat.mul_sub_left_distrib f_H k j).symm
              have h_dvd2 : f_H ∣ f_H * k - f_H * j := by
                rw [h_sub]
                exact dvd_mul_right f_H (k - j)
              have h_div2 : (f_H * k - f_H * j) / f_H = k - j := by
                rw [h_sub, Nat.mul_div_cancel_left (k - j) hf_H_pos]
              rw [if_pos (dvd_mul_right f_H j), if_pos h_dvd2, h_div1, h_div2, mul_assoc]
          rw [h_bij, ← Finset.mul_sum, hEr_rec k hk_pos]
          dsimp [B]
          rw [if_pos (dvd_mul_right f_H k), Nat.mul_div_cancel_left k hf_H_pos]
          push_cast
          ring
        · dsimp [B]
          rw [if_neg h_dvd, mul_zero]
          apply Finset.sum_eq_zero
          intro d hd
          rw [Finset.mem_Icc] at hd
          by_cases hd_dvd : f_H ∣ d
          · have h_not_dvd : ¬ (f_H ∣ (n - d)) := by
              intro h_sub_dvd
              have h_add := Nat.dvd_add hd_dvd h_sub_dvd
              rw [Nat.add_sub_of_le hd.2] at h_add
              exact h_dvd h_add
            rw [if_neg h_not_dvd, mul_zero]
          · dsimp [S_B]
            rw [if_neg hd_dvd, zero_mul]
    have hIcc_eq_range : ∀ (n : ℕ) (f : ℕ → Ω F),
        (∑ d ∈ Finset.Icc 1 n, f d) = ∑ i ∈ Finset.range n, f (i + 1) := by
      intro n f
      induction n with
      | zero => simp
      | succ k ih =>
        rw [Finset.sum_Icc_succ_top (Nat.le_add_left 1 k), Finset.sum_range_succ, ih]
    have hq_rec : ∀ k : ℕ,
        (∑ d ∈ Finset.Icc 1 (k + 1), (-1 : Ω F) ^ (d - 1) * g₀ ^ d * E_full (k + 1 - d)) =
          g₀ * B k := by
      intro k
      rw [hIcc_eq_range (k + 1)]
      rw [Finset.sum_range_succ]
      have h_top : (-1 : Ω F) ^ (k + 1 - 1) * g₀ ^ (k + 1) * E_full (k + 1 - (k + 1)) =
          (-1 : Ω F) ^ k * g₀ ^ (k + 1) * B 0 := by
        rw [Nat.add_sub_cancel, Nat.sub_self, hB0]
      have h_sum_split : (∑ i ∈ Finset.range k,
          (-1 : Ω F) ^ (i + 1 - 1) * g₀ ^ (i + 1) * E_full (k + 1 - (i + 1))) =
          (∑ i ∈ Finset.range k, (-1 : Ω F) ^ i * g₀ ^ (i + 1) * B (k - i)) +
            ∑ i ∈ Finset.range k, (-1 : Ω F) ^ i * g₀ ^ (i + 1) * (g₀ * B (k - (i + 1))) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i < k := Finset.mem_range.mp hi
        have h_sub1 : k + 1 - (i + 1) = (k - (i + 1)) + 1 := by omega
        have h_sub2 : (k - (i + 1)) + 1 = k - i := by omega
        rw [Nat.add_sub_cancel, h_sub1]
        change (-1 : Ω F) ^ i * g₀ ^ (i + 1) * (B ((k - (i + 1)) + 1) + g₀ * B (k - (i + 1))) = _
        rw [h_sub2]
        ring
      rw [h_top, h_sum_split, add_right_comm]
      have h_recomb : (∑ i ∈ Finset.range k, (-1 : Ω F) ^ i * g₀ ^ (i + 1) * B (k - i)) +
          (-1 : Ω F) ^ k * g₀ ^ (k + 1) * B 0 =
          ∑ i ∈ Finset.range (k + 1), (-1 : Ω F) ^ i * g₀ ^ (i + 1) * B (k - i) := by
        rw [Finset.sum_range_succ, Nat.sub_self]
      rw [h_recomb, Finset.sum_range_succ', add_right_comm, ← Finset.sum_add_distrib]
      have h_cancel : (∑ i ∈ Finset.range k,
          ((-1 : Ω F) ^ (i + 1) * g₀ ^ (i + 1 + 1) * B (k - (i + 1)) +
            (-1 : Ω F) ^ i * g₀ ^ (i + 1) * (g₀ * B (k - (i + 1))))) = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        rw [pow_succ (-1 : Ω F) i, pow_succ g₀ (i + 1)]
        ring
      rw [h_cancel, zero_add, Nat.sub_zero, pow_zero, pow_one, one_mul]
    have hSB_full : ∀ k : ℕ,
        (∑ d ∈ Finset.Icc 1 (k + 1), S_B d * E_full (k + 1 - d)) =
          ((k + 1 : ℕ) : Ω F) * B (k + 1) + g₀ * ((k : Ω F) * B k) := by
      intro k
      rw [Finset.sum_Icc_succ_top (Nat.le_add_left 1 k)]
      have h_top : S_B (k + 1) * E_full (k + 1 - (k + 1)) = S_B (k + 1) * B (k + 1 - (k + 1)) := by
        rw [Nat.sub_self, hB0]
      have h_sum_split : (∑ d ∈ Finset.Icc 1 k, S_B d * E_full (k + 1 - d)) =
          (∑ d ∈ Finset.Icc 1 k, S_B d * B (k + 1 - d)) +
            g₀ * ∑ d ∈ Finset.Icc 1 k, S_B d * B (k - d) := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro d hd
        rw [Finset.mem_Icc] at hd
        have h_sub1 : k + 1 - d = (k - d) + 1 := by omega
        rw [h_sub1]
        change S_B d * (B ((k - d) + 1) + g₀ * B (k - d)) = _
        ring
      rw [h_top, h_sum_split, add_right_comm, ← Finset.sum_Icc_succ_top (Nat.le_add_left 1 k),
        hB_rec (k + 1), hB_rec k]
    refine ⟨E_full, rfl, ?_, ?_⟩
    · change B (r * f_H + 1) + g₀ * B (r * f_H) = g₀ * (∏ i : Fin r, G_orb i)
      have h_not_dvd : ¬ (f_H ∣ (r * f_H + 1)) := by
        rw [Nat.dvd_iff_mod_eq_zero, add_comm, mul_comm r f_H, Nat.add_mul_mod_self_left,
          Nat.mod_eq_of_lt hf_H_gt1]
        exact one_ne_zero
      have hB1 : B (r * f_H + 1) = 0 := if_neg h_not_dvd
      have hB2 : B (r * f_H) = ∏ i : Fin r, G_orb i := by
        dsimp [B]
        rw [mul_comm r f_H, if_pos (dvd_mul_right f_H r), Nat.mul_div_cancel_left r hf_H_pos, hErr]
      rw [hB1, hB2, zero_add]
    · intro n hn1
      rcases Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0) with ⟨k, rfl⟩
      have h_split : (∑ d ∈ Finset.Icc 1 (k + 1),
          ((-1 : Ω F) ^ (d - 1) * g₀ ^ d + S_B d) * E_full (k + 1 - d)) =
          (∑ d ∈ Finset.Icc 1 (k + 1), (-1 : Ω F) ^ (d - 1) * g₀ ^ d * E_full (k + 1 - d)) +
            ∑ d ∈ Finset.Icc 1 (k + 1), S_B d * E_full (k + 1 - d) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro d _
        ring
      change (∑ d ∈ Finset.Icc 1 (k + 1),
          ((-1 : Ω F) ^ (d - 1) * g₀ ^ d + S_B d) * E_full (k + 1 - d)) =
          ((k + 1 : ℕ) : Ω F) * (B (k + 1) + g₀ * B k)
      rw [h_split, hq_rec k, hSB_full k]
      push_cast
      ring
  have hStretchedNewton : ∀ (g₀ : Ω F) (G_orb : Fin r → Ω F) (A : ℕ → Ω F),
      A 0 = 1 →
      (∀ n : ℕ, 1 ≤ n → n ≤ ℓ →
        (∑ d ∈ Finset.Icc 1 n,
          ((-1 : Ω F) ^ (d - 1) * g₀ ^ d +
            (if f_H ∣ d then
              (f_H : Ω F) * ∑ i : Fin r, (-1 : Ω F) ^ (d / f_H - 1) * (G_orb i) ^ (d / f_H)
             else 0)) *
            A (n - d)) =
          (n : Ω F) * A n) →
      A ℓ = g₀ * ∏ i : Fin r, G_orb i := by
    intro g₀ G_orb A hA0 hA_rec
    obtain ⟨E_r, hEr0, hErr, hEr_rec⟩ := hPascalNewton G_orb
    obtain ⟨E_full, hE0, hE_top, hE_rec⟩ := hFullRec g₀ G_orb E_r hEr0 hErr hEr_rec
    let S : ℕ → Ω F := fun d =>
      (-1 : Ω F) ^ (d - 1) * g₀ ^ d +
        (if f_H ∣ d then
          (f_H : Ω F) * ∑ i : Fin r, (-1 : Ω F) ^ (d / f_H - 1) * (G_orb i) ^ (d / f_H)
         else 0)
    have h_eq : ∀ n : ℕ, n ≤ ℓ → A n = E_full n := by
      intro n
      induction' n using Nat.strong_induction_on with n ih
      intro hn_le
      rcases Nat.eq_zero_or_pos n with rfl | hn_pos
      · rw [hA0, hE0]
      · have hn1 : 1 ≤ n := hn_pos
        have hA := (hA_rec n hn1 hn_le).symm
        have hE := (hE_rec n hn1).symm
        have h_sum_eq : (∑ d ∈ Finset.Icc 1 n, S d * A (n - d)) =
            ∑ d ∈ Finset.Icc 1 n, S d * E_full (n - d) := by
          apply Finset.sum_congr rfl
          intro d hd
          rw [Finset.mem_Icc] at hd
          rw [ih (n - d) (by omega) (by omega)]
        have h_mul : (n : Ω F) * A n = (n : Ω F) * E_full n := by
          rw [hA, h_sum_eq, ← hE]
        exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr (by omega)) h_mul
    have h_ell_eq : r * f_H + 1 = ℓ := by
      have := hPrime.pos
      omega
    rw [h_eq ℓ le_rfl, ← h_ell_eq, hE_top]
  let lam_α : (k_Lˣ →* (Ω F)ˣ) → Polynomial k_L → Ω F := fun α G =>
    (if h : (-1 : k_L) ^ G.natDegree * G.coeff 0 ≠ 0 then
      (α (Units.mk0 ((-1 : k_L) ^ G.natDegree * G.coeff 0) h) : Ω F)
    else 0) * ψ_k (-G.nextCoeff)
  let μ_α : (k_Lˣ →* (Ω F)ˣ) → Polynomial k_L → Ω F := fun α P => lam_α α (𝒩_ℓ_L P)
  have hlam_one : ∀ α : k_Lˣ →* (Ω F)ˣ, lam_α α 1 = 1 := by
    intro α
    dsimp [lam_α]
    have h1_deg : (1 : Polynomial k_L).natDegree = 0 := Polynomial.natDegree_one
    have h1_c0 : (1 : Polynomial k_L).coeff 0 = 1 := Polynomial.coeff_one_zero
    have h1_next : (1 : Polynomial k_L).nextCoeff = 0 := by
      rw [← Polynomial.C_1, Polynomial.nextCoeff_C_eq_zero]
    rw [h1_deg, h1_c0, h1_next, pow_zero, mul_one, dif_pos one_ne_zero, neg_zero,
      AddChar.map_zero_eq_one, mul_one]
    have h_u1 : Units.mk0 (1 : k_L) one_ne_zero = 1 := by ext; rfl
    rw [h_u1, map_one, Units.val_one]
  have hlam_mul : ∀ (α : k_Lˣ →* (Ω F)ˣ) (f g : Polynomial k_L),
      f.Monic → g.Monic → lam_α α (f * g) = lam_α α f * lam_α α g := by
    intro α f g hf hg
    dsimp [lam_α]
    have hdeg : (f * g).natDegree = f.natDegree + g.natDegree := hf.natDegree_mul hg
    have hc0 : (f * g).coeff 0 = f.coeff 0 * g.coeff 0 := Polynomial.mul_coeff_zero f g
    have hnext : (f * g).nextCoeff = f.nextCoeff + g.nextCoeff := hf.nextCoeff_mul hg
    have hprod_c : (-1 : k_L) ^ (f * g).natDegree * (f * g).coeff 0 =
        ((-1 : k_L) ^ f.natDegree * f.coeff 0) * ((-1 : k_L) ^ g.natDegree * g.coeff 0) := by
      rw [hdeg, hc0, pow_add]
      ring
    have hψ_mul : ψ_k (-(f * g).nextCoeff) = ψ_k (-f.nextCoeff) * ψ_k (-g.nextCoeff) := by
      rw [hnext, neg_add, AddChar.map_add_eq_mul]
    rw [hψ_mul]
    set cf := (-1 : k_L) ^ f.natDegree * f.coeff 0
    set cg := (-1 : k_L) ^ g.natDegree * g.coeff 0
    have h_if : (if h : (-1 : k_L) ^ (f * g).natDegree * (f * g).coeff 0 ≠ 0 then
        (α (Units.mk0 ((-1 : k_L) ^ (f * g).natDegree * (f * g).coeff 0) h) : Ω F) else 0) =
      (if h : cf ≠ 0 then (α (Units.mk0 cf h) : Ω F) else 0) *
      (if h : cg ≠ 0 then (α (Units.mk0 cg h) : Ω F) else 0) := by
      by_cases hcf : cf = 0
      · have hcfg : (-1 : k_L) ^ (f * g).natDegree * (f * g).coeff 0 = 0 := by
          rw [hprod_c, hcf, zero_mul]
        rw [dif_neg (not_not.mpr hcfg), dif_neg (not_not.mpr hcf), zero_mul]
      · by_cases hcg : cg = 0
        · have hcfg : (-1 : k_L) ^ (f * g).natDegree * (f * g).coeff 0 = 0 := by
            rw [hprod_c, hcg, mul_zero]
          rw [dif_neg (not_not.mpr hcfg), dif_neg (not_not.mpr hcg), mul_zero]
        · have hcfg : (-1 : k_L) ^ (f * g).natDegree * (f * g).coeff 0 ≠ 0 := by
            rw [hprod_c]
            exact mul_ne_zero hcf hcg
          rw [dif_pos hcfg, dif_pos hcf, dif_pos hcg]
          have hu : Units.mk0 ((-1 : k_L) ^ (f * g).natDegree * (f * g).coeff 0) hcfg =
              Units.mk0 cf hcf * Units.mk0 cg hcg := by
            ext
            exact hprod_c
          rw [hu, map_mul, Units.val_mul]
    rw [h_if]
    ring
  have hμ_mul : ∀ (α : k_Lˣ →* (Ω F)ˣ) (f g : Polynomial k_L),
      f.Monic → g.Monic → μ_α α (f * g) = μ_α α f * μ_α α g := by
    intro α f g hf hg
    dsimp [μ_α]
    have hfM : f ∈ M_L f.natDegree := (hM_L_mem f.natDegree f).mpr ⟨hf, rfl⟩
    have hgM : g ∈ M_L g.natDegree := (hM_L_mem g.natDegree g).mpr ⟨hg, rfl⟩
    have hNf : (𝒩_ℓ_L f).Monic := ((hM_L_mem f.natDegree (𝒩_ℓ_L f)).mp (h𝒩_L_prop f.natDegree f hfM).1).1
    have hNg : (𝒩_ℓ_L g).Monic := ((hM_L_mem g.natDegree (𝒩_ℓ_L g)).mp (h𝒩_L_prop g.natDegree g hgM).1).1
    rw [h𝒩_L_mul f g hf hg, hlam_mul α (𝒩_ℓ_L f) (𝒩_ℓ_L g) hNf hNg]
  have hMaster : ∀ α : k_Lˣ →* (Ω F)ˣ,
      (((α (Units.mk0 (ℓ : k_L) hNeChar))⁻¹) ^ ℓ : Ω F) *
        (∑ x : k_Lˣ, ((α ^ ℓ) x : Ω F) * ψ_k (x : k_L)) *
        (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff)) =
      (∑ x : k_Lˣ, (α x : Ω F) * ψ_k (x : k_L)) *
        (∏ i : Fin r,
          (∑ y : k_Mˣ,
            ((μ_tilde i * α.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
              ψ_k (Algebra.trace k_L k_M (y : k_M)))) := by
    intro α
    rw [← h𝒩_L_deg_ell α ψ_k]
    let A : ℕ → Ω F := fun n => ∑ P ∈ M_L n, μ_α α P
    let g₀ : Ω F := ∑ x : k_Lˣ, (α x : Ω F) * ψ_k (x : k_L)
    let G_orb : Fin r → Ω F := fun i =>
      ∑ y : k_Mˣ,
        ((μ_tilde i * α.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
          ψ_k (Algebra.trace k_L k_M (y : k_M))
    change A ℓ = g₀ * ∏ i : Fin r, G_orb i
    apply hStretchedNewton g₀ G_orb A
    · dsimp [A, μ_α]
      rw [hM_L_zero, Finset.sum_singleton, h𝒩_L_one, hlam_one α]
    · intro n hn1 hn_le
      have hN := hNewton_L (μ_α α) (hμ_mul α) n
      rw [← hN]
      apply Finset.sum_congr rfl
      intro d hd
      rw [Finset.mem_Icc] at hd
      rw [hPowerSum α d hd.1 (hd.2.trans hn_le)]
  have hψ_sum_units : (∑ x : k_Lˣ, ψ_k (x : k_L)) = -1 := by
    have hψ_ne0 : ψ_k ≠ 0 := by rwa [← AddChar.one_eq_zero]
    have h_univ : (∑ y : k_L, ψ_k y) = 0 := by
      rw [AddChar.sum_eq_ite ψ_k, if_neg hψ_ne0]
    have h_split : (∑ y : k_L, ψ_k y) = ψ_k 0 + ∑ y ∈ Finset.univ.erase (0 : k_L), ψ_k y := by
      rw [add_comm, Finset.sum_erase_add _ _ (Finset.mem_univ (0 : k_L))]
    have h_bij : (∑ x : k_Lˣ, ψ_k (x : k_L)) = ∑ y ∈ Finset.univ.erase (0 : k_L), ψ_k y := by
      refine Finset.sum_bij (fun (x : k_Lˣ) _ => (x : k_L)) ?_ ?_ ?_ ?_
      · intro x _
        exact Finset.mem_erase.mpr ⟨Units.ne_zero x, Finset.mem_univ _⟩
      · intro x₁ _ x₂ _ h
        exact Units.ext h
      · intro y hy
        have hy0 : y ≠ 0 := (Finset.mem_erase.mp hy).1
        exact ⟨Units.mk0 y hy0, Finset.mem_univ _, Units.val_mk0 hy0⟩
      · intro x _
        rfl
    rw [h_bij]
    rw [h_split, AddChar.map_zero_eq_one] at h_univ
    exact eq_neg_of_add_eq_zero_right h_univ
  have h1 := hMaster 1
  have h1_lhs : (((((1 : k_Lˣ →* (Ω F)ˣ) (Units.mk0 (ℓ : k_L) hNeChar))⁻¹) ^ ℓ : Ω F) *
      (∑ x : k_Lˣ, (((1 : k_Lˣ →* (Ω F)ˣ) ^ ℓ) x : Ω F) * ψ_k (x : k_L)) *
      (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff))) =
      (-1 : Ω F) * (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff)) := by
    have h_sum1 : (∑ x : k_Lˣ, (((1 : k_Lˣ →* (Ω F)ˣ) ^ ℓ) x : Ω F) * ψ_k (x : k_L)) = -1 := by
      rw [← hψ_sum_units]
      apply Finset.sum_congr rfl
      intro x _
      rw [MonoidHom.pow_apply, MonoidHom.one_apply, one_pow, Units.val_one, one_mul]
    rw [MonoidHom.one_apply, inv_one, Units.val_one, one_pow, one_mul, h_sum1]
  have h1_rhs : ((∑ x : k_Lˣ, ((1 : k_Lˣ →* (Ω F)ˣ) x : Ω F) * ψ_k (x : k_L)) *
      (∏ i : Fin r,
        (∑ y : k_Mˣ,
          ((μ_tilde i * (1 : k_Lˣ →* (Ω F)ˣ).comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
            ψ_k (Algebra.trace k_L k_M (y : k_M))))) =
      (-1 : Ω F) *
        (∏ i : Fin r,
          (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) *
            ψ_k (Algebra.trace k_L k_M (y : k_M)))) := by
    have h_sum1 : (∑ x : k_Lˣ, ((1 : k_Lˣ →* (Ω F)ˣ) x : Ω F) * ψ_k (x : k_L)) = -1 := by
      rw [← hψ_sum_units]
      apply Finset.sum_congr rfl
      intro x _
      rw [MonoidHom.one_apply, Units.val_one, one_mul]
    rw [h_sum1]
    congr 1
    apply Finset.prod_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro y _
    congr 1
    rw [MonoidHom.mul_apply, MonoidHom.comp_apply, MonoidHom.one_apply, mul_one]
  rw [h1_lhs, h1_rhs] at h1
  have hC_eq : (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff)) =
      ∏ i : Fin r,
        (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) *
          ψ_k (Algebra.trace k_L k_M (y : k_M))) :=
    mul_left_cancel₀ (neg_ne_zero.mpr one_ne_zero) h1
  rw [← hC_eq]
  exact hMaster χ_k

theorem ld_ch13_finite_field_orbit_gauss_and_vandermonde_hasse (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (ℓ f_H r : ℕ) (hPrime : Nat.Prime ℓ) (hOdd : ℓ ≠ 2)
    (hf_H_gt1 : 1 < f_H) (hr_pos : 1 ≤ r) (hr_mul : r * f_H = ℓ - 1)
    (hfinrank : Module.finrank k_L k_M = f_H)
