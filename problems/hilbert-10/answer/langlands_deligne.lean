by
  have hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0) := by
    intro M _
    have halg : ∀ z : M,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F M = (minpoly F z).natDegree * m := by
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq M.val M.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F M (-1) = 0 := by
      have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F M ((-1 : M) * (-1 : M)) = relVal F M (-1) + relVal F M (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : M) * (-1 : M) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : M, relVal F M (-x) = relVal F M x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : M) = (-1 : M) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul : relVal F M ((u : M) * ((u⁻¹ : Mˣ) : M)) =
          relVal F M (u : M) + relVal F M ((u⁻¹ : Mˣ) : M) :=
        hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : M := algebraMap F M π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F M x₀ = (Module.finrank F M : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F M := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F M, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖ₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    have hdiv : ∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F M : ℤ)
        set q_x : ℤ := valL F M x
        set r : ℤ := relVal F M x % f
        have hediv : f * q_x + r = relVal F M x := Int.mul_ediv_add_emod (relVal F M x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M x) hfM_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M x) hfM_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : M := x * (((ϖM ^ (-q_x) : Mˣ) : M))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F M y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q_x), hrel_ϖM]
            linarith
          let k_r : ℕ := r.toNat
          have hk_eq : (k_r : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k_r := by omega
          have hk_lt : k_r < resDeg F M := by omega
          have hk_mem : k_r ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k_r := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F M 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval1 : valL F M 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg1 : valL F M (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg : ∀ x : M, valL F M (-x) = valL F M x := by
      intro x
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
      intro u
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_surj : ∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m := by
      intro m
      refine ⟨ϖM ^ m, ?_⟩
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv, hrel_zpow ϖM m, hrel_ϖM, mul_comm]
    have hval_add : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : M,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : M, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F M z ≤ valL F M w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F M) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfM_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : M) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F M x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F M y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    have hgen_val0 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1)) → valL F M (u : M) = 0 := by
      intro a ha u hu
      rcases hu with hu1 | hua
      · rw [hu1, hval1]
      · have h_ge0 : (0 : ℤ) ≤ valL F M (u : M) := by
          have hadd := hval_add 0 ((u : M) - 1) 1 (Or.inr (by omega)) (Or.inr (by rw [hval1]))
          have heq : ((u : M) - 1) + 1 = (u : M) := sub_add_cancel (u : M) 1
          rw [heq] at hadd
          exact hadd.resolve_left (Units.ne_zero u)
        have h_le0 : valL F M (u : M) ≤ 0 := by
          by_contra hlt
          have hge1 : (1 : ℤ) ≤ valL F M (-(u : M)) := by
            rw [hval_neg]
            omega
          have hadd := hval_add 1 ((u : M) - 1) (-(u : M)) (Or.inr (by omega)) (Or.inr hge1)
          have heq : ((u : M) - 1) + (-(u : M)) = -1 := by ring
          rw [heq, hval_neg1] at hadd
          have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
          have h10 : (1 : ℤ) ≤ 0 := hadd.resolve_left hne
          omega
        omega
    have hunit0 : ∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0 := by
      let H₀ : Subgroup Mˣ := {
        carrier := {u : Mˣ | valL F M (u : M) = 0}
        one_mem' := by
          change valL F M ((1 : Mˣ) : M) = 0
          rw [Units.val_one, hval1]
        mul_mem' := by
          intro u v hu hv
          change valL F M ((u * v : Mˣ) : M) = 0
          rw [Units.val_mul, hval_mul _ _ (Units.ne_zero u) (Units.ne_zero v), hu, hv, add_zero]
        inv_mem' := by
          intro u hu
          change valL F M ((u⁻¹ : Mˣ) : M) = 0
          rw [hval_inv u, hu, neg_zero]
      }
      have hcl_le : unitGroup F M 0 ≤ H₀ := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [H₀] using hu
      have hle_cl : H₀ ≤ unitGroup F M 0 := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [H₀] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_ge1 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1)) := by
      intro a ha
      have ha0 : a ≠ 0 := by omega
      let Ha : Subgroup Mˣ := {
        carrier := {u : Mˣ | (u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1)}
        one_mem' := Or.inl Units.val_one
        mul_mem' := by
          intro u v hu hv
          change ((u * v : Mˣ) : M) = 1 ∨ (a : ℤ) ≤ valL F M (((u * v : Mˣ) : M) - 1)
          have hu0 : valL F M (u : M) = 0 := hgen_val0 a ha u hu
          have hterm1 : (u : M) * ((v : M) - 1) = 0 ∨
              (a : ℤ) ≤ valL F M ((u : M) * ((v : M) - 1)) := by
            by_cases hsub : (v : M) - 1 = 0
            · left
              rw [hsub, mul_zero]
            · right
              have hv1 : (v : M) ≠ 1 := sub_ne_zero.mp hsub
              have hva : (a : ℤ) ≤ valL F M ((v : M) - 1) := hv.resolve_left hv1
              rw [hval_mul (u : M) ((v : M) - 1) (Units.ne_zero u) hsub, hu0, zero_add]
              exact hva
          have hterm2 : (u : M) - 1 = 0 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1) := by
            rcases hu with hu1 | hua
            · exact Or.inl (sub_eq_zero.mpr hu1)
            · exact Or.inr hua
          have hadd := hval_add (a : ℤ) ((u : M) * ((v : M) - 1)) ((u : M) - 1) hterm1 hterm2
          have hsplit : (u : M) * ((v : M) - 1) + ((u : M) - 1) = ((u * v : Mˣ) : M) - 1 := by
            rw [Units.val_mul]
            ring
          rw [hsplit] at hadd
          rcases hadd with h0 | hle
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hle
        inv_mem' := by
          intro u hu
          change ((u⁻¹ : Mˣ) : M) = 1 ∨ (a : ℤ) ≤ valL F M (((u⁻¹ : Mˣ) : M) - 1)
          have hu0 : valL F M (u : M) = 0 := hgen_val0 a ha u hu
          have hu_inv0 : valL F M ((u⁻¹ : Mˣ) : M) = 0 := by
            rw [hval_inv u, hu0, neg_zero]
          have hinv_split : (((u⁻¹ : Mˣ) : M) - 1) = - (((u⁻¹ : Mˣ) : M) * ((u : M) - 1)) := by
            have hmul : ((u⁻¹ : Mˣ) : M) * (u : M) = 1 := Units.inv_mul u
            linear_combination hmul
          by_cases hsub : (u : M) - 1 = 0
          · left
            apply sub_eq_zero.mp
            rw [hinv_split, hsub, mul_zero, neg_zero]
          · right
            have hu1 : (u : M) ≠ 1 := sub_ne_zero.mp hsub
            have hua : (a : ℤ) ≤ valL F M ((u : M) - 1) := hu.resolve_left hu1
            rw [hinv_split, hval_neg,
              hval_mul ((u⁻¹ : Mˣ) : M) ((u : M) - 1) (Units.ne_zero u⁻¹) hsub,
              hu_inv0, zero_add]
            exact hua
      }
      have hcl_le : unitGroup F M a ≤ Ha := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [Ha, ha0] using hu
      have hle_cl : Ha ≤ unitGroup F M a := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [Ha, ha0] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_val0 : ∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0 := by
      intro a u hu
      by_cases ha : a = 0
      · rw [ha] at hu
        exact (hunit0 u).mp hu
      · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
        exact hgen_val0 a ha1 u ((hunit_ge1 a ha1 u).mp hu)
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
      hval_add, hunit0, hunit_ge1, hunit_val0⟩

  have hSpec_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
      (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) := by
    intro M _ ψ_M hψ_M
    set Sψ : Set ℤ := {d : ℤ | ∀ x : M, -d ≤ valL F M x → ψ_M x = 1}
    have hne_ψ : Sψ.Nonempty := by
      obtain ⟨d₀, hd₀⟩ := hψ_M.2
      refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
      simpa using hx
    have hbdd_ψ : BddAbove Sψ := by
      have hne1 : ∃ x₀ : M, ψ_M x₀ ≠ 1 := by
        rcases DFunLike.ne_iff.mp hψ_M.1 with ⟨x₀, hx₀⟩
        exact ⟨x₀, by simpa [AddChar.one_apply] using hx₀⟩
      obtain ⟨x₀, hx₀⟩ := hne1
      refine ⟨-valL F M x₀ - 1, fun d hd => ?_⟩
      by_contra hlt
      have hle : -d ≤ valL F M x₀ := by omega
      exact hx₀ (hd x₀ hle)
    have hmem_ψ : condExpChar F M ψ_M ∈ Sψ := Int.csSup_mem hne_ψ hbdd_ψ
    have hconj1 : ∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1 := by
      intro x hx
      rcases hx with rfl | hx
      · exact AddChar.map_zero_eq_one ψ_M
      · exact hmem_ψ x hx
    have hconj2 : ∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1 := by
      have hnot : condExpChar F M ψ_M + 1 ∉ Sψ :=
        notMem_of_csSup_lt (lt_add_one (condExpChar F M ψ_M)) hbdd_ψ
      change ¬ (∀ x : M, -(condExpChar F M ψ_M + 1) ≤ valL F M x → ψ_M x = 1) at hnot
      push_neg at hnot
      obtain ⟨x₁, hx₁_val, hx₁_ne1⟩ := hnot
      refine ⟨x₁, ?_, hx₁_val, hx₁_ne1⟩
      rintro rfl
      exact hx₁_ne1 (AddChar.map_zero_eq_one ψ_M)
    exact ⟨hconj1, hconj2⟩

  have hNormFilt : ∀ (i : Fin D_orb.length) (m : ℕ), 1 ≤ m →
      ∀ u ∈ unitGroup F (D_orb.get i).field (k * (m - 1) + 1),
        Units.map (normLM F (D_orb.get i).le) u ∈ unitGroup F L m := by
    intro i m hm u hu
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    obtain ⟨_, _, _, _, _, _, _, _, _, hunit_ge1_L, _⟩ := hval_all L
    obtain ⟨_, _, _, _, _, _, _, _, _, hunit_ge1_MC, _⟩ := hval_all M_C
    obtain ⟨_, _, _, _, _, _, _, _, _, hunit_ge1_Fi, _⟩ := hval_all (D_orb.get i).field
    set r : ℕ := k * (m - 1) + 1
    have hr : 1 ≤ r := by omega
    have hσ_symm_val : ∀ j (z : M_C), valL F M_C ((σ_all j).symm z) = valL F M_C z := by
      intro j z
      have h1 := (hν_props j).2.2.2.1 ((σ_all j).symm z)
      rw [AlgEquiv.apply_symm_apply] at h1
      exact h1.symm
    let c_single : ∀ i' : Fin D_orb.length, ((D_orb.get i').field)ˣ :=
      fun i' => if h : i' = i then h ▸ u else 1
    have hc_single_mem : ∀ i' : Fin D_orb.length,
        Units.map (IntermediateField.inclusion (hFiMC i')).toMonoidHom (c_single i') ∈
          unitGroup F M_C r := by
      intro i'
      rcases eq_or_ne i' i with rfl | hne
      · have hcs : c_single i' = u := dif_pos rfl
        rw [hcs, hunit_ge1_MC r hr]
        rcases (hunit_ge1_Fi r hr u).mp hu with hu1 | hur
        · left
          change IntermediateField.inclusion (hFiMC i') (u : (D_orb.get i').field) = 1
          rw [hu1, map_one]
        · right
          change (r : ℤ) ≤ valL F M_C (IntermediateField.inclusion (hFiMC i') (u : (D_orb.get i').field) - 1)
          rw [← map_one (IntermediateField.inclusion (hFiMC i')), ← map_sub,
            (hFi_ram i').2.2.1 ((u : (D_orb.get i').field) - 1)]
          exact hur
      · have hcs : c_single i' = 1 := dif_neg hne
        rw [hcs, map_one]
        exact Subgroup.one_mem _
    have hσ_symm_mem : ∀ j (w : M_Cˣ), w ∈ unitGroup F M_C r →
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom w ∈ unitGroup F M_C r := by
      intro j w hw
      rw [hunit_ge1_MC r hr] at hw ⊢
      rcases hw with hw1 | hwr
      · left
        change (σ_all j).symm (w : M_C) = 1
        rw [hw1, map_one]
      · right
        change (r : ℤ) ≤ valL F M_C ((σ_all j).symm (w : M_C) - 1)
        rw [← map_one (σ_all j).symm, ← map_sub, hσ_symm_val j ((w : M_C) - 1)]
        exact hwr
    have hlhs_mem :
        (∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_single (idx_all j)))) ∈ unitGroup F M_C r :=
      Subgroup.prod_mem _ fun j _ => hσ_symm_mem j _ (hc_single_mem (idx_all j))
    have hprod_rhs :
        (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_single i')) =
          Units.map (normLM F (D_orb.get i).le) u := by
      rw [Finset.prod_eq_single i]
      · have hcs : c_single i = u := dif_pos rfl
        rw [hcs]
      · intro i' _ hne
        have hcs : c_single i' = 1 := dif_neg hne
        rw [hcs, map_one]
      · intro hi
        exact False.elim (hi (Finset.mem_univ i))
    rw [hν_prod c_single, hprod_rhs] at hlhs_mem
    let v : Lˣ := Units.map (normLM F (D_orb.get i).le) u
    change Units.map (IntermediateField.inclusion hLM_C).toMonoidHom v ∈ unitGroup F M_C r at hlhs_mem
    rw [hunit_ge1_L m hm]
    rcases (hunit_ge1_MC r hr _).mp hlhs_mem with hv1 | hvr
    · left
      apply (IntermediateField.inclusion hLM_C).injective
      rw [map_one]
      exact hv1
    · right
      change (r : ℤ) ≤ valL F M_C (IntermediateField.inclusion hLM_C (v : L) - 1) at hvr
      rw [← map_one (IntermediateField.inclusion hLM_C), ← map_sub,
        hValAlgMCL ((v : L) - 1)] at hvr
      have hcast : (r : ℤ) = (k : ℤ) * ((m - 1 : ℕ) : ℤ) + 1 := by
        simp [r]
      rw [hcast] at hvr
      change (m : ℤ) ≤ valL F L ((v : L) - 1)
      by_contra hlt
      have hle_m1 : valL F L ((v : L) - 1) ≤ ((m - 1 : ℕ) : ℤ) := by omega
      have hmul_le : (k : ℤ) * valL F L ((v : L) - 1) ≤ (k : ℤ) * ((m - 1 : ℕ) : ℤ) :=
        mul_le_mul_of_nonneg_left hle_m1 (by omega)
      omega

  have hχ'Fi_top : ∀ (i : Fin D_orb.length),
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let c'_χ'_Fi : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
      ∀ x : F_i, (x = 0 ∨ ((k * (condExp F L χ' - 1) : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          ((χ'.comp (Units.map (normLM F (D_orb.get i).le))) (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) := by
    have htrace_inc_mul : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
        (hAB : A ≤ B) (x : A) (z : B),
        traceLM F hAB (IntermediateField.inclusion hAB x * z) = x * traceLM F hAB z := by
      intro A B hAB x z
      let B' := IntermediateField.extendScalars hAB
      letI : Module A A := Semiring.toModule
      have hsmul : toExtendScalars F hAB (IntermediateField.inclusion hAB x * z) =
          x • toExtendScalars F hAB z := by
        rw [map_mul, Algebra.smul_def]
        rfl
      change (Algebra.trace A B') (toExtendScalars F hAB (IntermediateField.inclusion hAB x * z)) =
        x * (Algebra.trace A B') (toExtendScalars F hAB z)
      rw [hsmul]
      exact (Algebra.trace A B').map_smul' x (toExtendScalars F hAB z)

    have htrace_trans_aux : ∀ (K₀ A B C : Type u) [Field K₀] [Field A] [Field B] [Field C]
        [Algebra K₀ A] [Algebra K₀ B] [Algebra K₀ C]
        (algAB : Algebra A B) (algBC : Algebra B C) (algAC : Algebra A C)
        (h1 : ∀ x : K₀, @algebraMap A B _ _ algAB (algebraMap K₀ A x) = algebraMap K₀ B x)
        (h2 : ∀ x : A, @algebraMap B C _ _ algBC (@algebraMap A B _ _ algAB x) =
          @algebraMap A C _ _ algAC x)
        [FiniteDimensional K₀ B] (z : C),
        @Algebra.trace A C _ _ algAC z =
          @Algebra.trace A B _ _ algAB (@Algebra.trace B C _ _ algBC z) := by
      intro K₀ A B C _ _ _ _ _ _ _ algAB algBC algAC h1 h2 _ z
      letI : Algebra A B := algAB
      letI : Algebra B C := algBC
      letI : Algebra A C := algAC
      haveI : IsScalarTower K₀ A B := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
      haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
      haveI : FiniteDimensional A B := Module.Finite.of_restrictScalars_finite K₀ A B
      by_cases hFin : FiniteDimensional B C
      · exact (Algebra.trace_trace z).symm
      · have htr1 : Algebra.trace B C = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          exact hFin (Module.Finite.of_basis b)
        have htr2 : Algebra.trace A C = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          haveI : Module.Finite A C := Module.Finite.of_basis b
          exact hFin (Module.Finite.of_restrictScalars_finite A B C)
        simp [htr1, htr2]

    have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
        (h : A ≤ B) (y : B),
        @Algebra.trace A B _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
      intro A B h y
      letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
      let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
        toFun := toExtendScalars F h
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl
      }
      exact (Algebra.trace_eq_of_algEquiv e y).symm

    have htrace_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F B]
        (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (z : C),
        traceLM F hAC z = traceLM F hAB (traceLM F hBC z) := by
      intro A B C _ hAB hBC hAC z
      have hEq : hAC = hAB.trans hBC := Subsingleton.elim _ _
      subst hEq
      rw [← htrace_eq_inclusion (hAB.trans hBC) z,
          ← htrace_eq_inclusion hBC z,
          ← htrace_eq_inclusion hAB]
      exact htrace_trans_aux F A B C
        (IntermediateField.inclusion hAB).toAlgebra
        (IntermediateField.inclusion hBC).toAlgebra
        (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
        (fun _ => rfl)
        (fun _ => rfl)
        z

    have htraceChar_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F B]
        (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (ψA : AddChar A (Ω F)),
        traceChar F hAC ψA = traceChar F hBC (traceChar F hAB ψA) := by
      intro A B C _ hAB hBC hAC ψA
      ext z
      simp [traceChar, htrace_trans hAB hBC hAC z]

    have hnorm_trans_aux : ∀ (K₀ A B C : Type u) [Field K₀] [Field A] [Field B] [Field C]
        [Algebra K₀ A] [Algebra K₀ B] [Algebra K₀ C]
        (algAB : Algebra A B) (algBC : Algebra B C) (algAC : Algebra A C)
        (h1 : ∀ x : K₀, @algebraMap A B _ _ algAB (algebraMap K₀ A x) = algebraMap K₀ B x)
        (h2 : ∀ x : A, @algebraMap B C _ _ algBC (@algebraMap A B _ _ algAB x) =
          @algebraMap A C _ _ algAC x)
        (h3 : ∀ x : K₀, @algebraMap B C _ _ algBC (algebraMap K₀ B x) = algebraMap K₀ C x)
        [FiniteDimensional K₀ B] [FiniteDimensional K₀ C] (z : C),
        @Algebra.norm A C _ _ algAC z =
          @Algebra.norm A B _ _ algAB (@Algebra.norm B C _ _ algBC z) := by
      intro K₀ A B C _ _ _ _ _ _ _ algAB algBC algAC h1 h2 h3 _ _ z
      letI : Algebra A B := algAB
      letI : Algebra B C := algBC
      letI : Algebra A C := algAC
      haveI : IsScalarTower K₀ A B := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
      haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
      haveI : IsScalarTower K₀ B C := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h3 x).symm)
      haveI : FiniteDimensional A B := Module.Finite.of_restrictScalars_finite K₀ A B
      haveI : FiniteDimensional B C := Module.Finite.of_restrictScalars_finite K₀ B C
      exact (Algebra.norm_norm (a := z)).symm

    have hnorm_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
        (h : A ≤ B) (y : B),
        @Algebra.norm A B _ _ (IntermediateField.inclusion h).toAlgebra y = normLM F h y := by
      intro A B h y
      letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
      let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
        toFun := toExtendScalars F h
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl
      }
      exact (Algebra.norm_eq_of_algEquiv e y).symm

    have hnorm_units_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)}
        [FiniteDimensional F B] [FiniteDimensional F C]
        (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (w : Cˣ),
        Units.map (normLM F hAC) w =
          Units.map (normLM F hAB) (Units.map (normLM F hBC) w) := by
      intro A B C _ _ hAB hBC hAC w
      apply Units.ext
      change normLM F hAC (w : C) = normLM F hAB (normLM F hBC (w : C))
      have hEq : hAC = hAB.trans hBC := Subsingleton.elim _ _
      subst hEq
      rw [← hnorm_eq_inclusion (hAB.trans hBC) (w : C),
          ← hnorm_eq_inclusion hBC (w : C),
          ← hnorm_eq_inclusion hAB]
      exact hnorm_trans_aux F A B C
        (IntermediateField.inclusion hAB).toAlgebra
        (IntermediateField.inclusion hBC).toAlgebra
        (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
        (fun _ => rfl)
        (fun _ => rfl)
        (fun _ => rfl)
        (w : C)

    obtain ⟨hval0_L, hval1_L, hval_neg1_L, _, hval_mul_L, hval_inv_L, _,
      hval_add_L, _, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
    obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, _, hval_mul_MC, hval_inv_MC, _,
      hval_add_MC, _, hunit_ge1_MC, _⟩ := hval_all M_C

    let M_C_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
    let e_MC_L : M_C ≃ₐ[F] M_C_L :=
      { toExtendScalars F hLM_C with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM_C).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F M_C_L := Module.Finite.equiv e_MC_L.toLinearEquiv
    haveI : IsScalarTower F L M_C_L := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hFinLMC' : FiniteDimensional L M_C_L := Module.Finite.of_restrictScalars_finite F L M_C_L
    haveI : FiniteDimensional L M_C_L := hFinLMC'

    have hGalLMC' : IsGalois L ↥M_C_L := by
      have hSepLMC' : Algebra.IsSeparable L M_C_L := hGalMC.2.2.2 hLM_C
      haveI : Algebra.IsSeparable L M_C_L := hSepLMC'
      have helper_isGalois : ∀ (k₀ Ω_bar : Type u) [Field k₀] [Field Ω_bar] [Algebra k₀ Ω_bar]
          [Normal k₀ Ω_bar] (K₀ : IntermediateField k₀ Ω_bar) [hSepK₀ : Algebra.IsSeparable k₀ K₀],
          (∀ (σ τ : Ω_bar ≃ₐ[k₀] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
          IsGalois k₀ K₀ := by
        intro k₀ Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
        let N : IntermediateField k₀ Ω_bar := separableClosure k₀ Ω_bar
        haveI : IsGalois k₀ N := separableClosure.isGalois k₀ Ω_bar
        haveI : Normal k₀ N := IsGalois.to_normal
        have hK₀N : K₀ ≤ N := by
          intro z hz
          rw [mem_separableClosure_iff]
          let x : K₀ := ⟨z, hz⟩
          have hx : IsSeparable k₀ x := @Algebra.IsSeparable.isSeparable k₀ K₀ _ _ _ hSepK₀ x
          have hmin : minpoly k₀ z = minpoly k₀ x := minpoly.algHom_eq K₀.val K₀.val.injective x
          change (minpoly k₀ z).Separable
          rw [hmin]
          exact hx
        let K_N : IntermediateField k₀ N := K₀.comap N.val
        have hKN_map : K_N.map N.val = K₀ := by
          ext z
          refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
          rintro ⟨y, hy, rfl⟩
          exact hy
        have hKN_norm : K_N.fixingSubgroup.Normal := by
          refine ⟨fun h hh g => ?_⟩
          obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
          obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
          rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
          have hτ_fix : ∀ x ∈ K₀, τ x = x := by
            intro x hx
            let z : N := ⟨x, hK₀N hx⟩
            have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
            have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
            rwa [AlgEquiv.restrictNormalHom_apply] at h1
          intro y hy
          apply Subtype.ext
          rw [← map_inv, ← map_mul, ← map_mul]
          change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
          rw [AlgEquiv.restrictNormalHom_apply]
          exact h_norm_fix σ τ hτ_fix y.1 hy
        haveI : K_N.fixingSubgroup.Normal := hKN_norm
        haveI : IsGalois k₀ K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
        let e_KN : ↥K_N ≃ₐ[k₀] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
        exact IsGalois.of_algEquiv e_KN
      haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
      haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
      have hMC_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
          (∀ x ∈ M_C_L, τ x = x) → ∀ x ∈ M_C_L, (σ * τ * σ⁻¹) x = x := by
        intro σ τ hτ
        let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
        let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
        have hτMC : τ_F.1 ∈ M_C.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro x hx
          exact hτ x ((IntermediateField.mem_extendScalars hLM_C).mpr hx)
        have hconjMC : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
          hGalMC.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτMC
        intro x hx
        rw [IntermediateField.mem_fixingSubgroup_iff] at hconjMC
        exact hconjMC x ((IntermediateField.mem_extendScalars hLM_C).mp hx)
      exact helper_isGalois L (AlgebraicClosure F) M_C_L hMC_norm_fix
    haveI : IsGalois L ↥M_C_L := hGalLMC'
    let G_MC : Type u := (M_C_L ≃ₐ[L] M_C_L)
    let fromExtendScalars_L : M_C_L →+* M_C := e_MC_L.symm.toRingHom
    let act_MC : G_MC → M_C → M_C := fun σ z => fromExtendScalars_L (σ (toExtendScalars F hLM_C z))
    have hact_MC_ring : ∀ σ : G_MC,
        act_MC σ 0 = 0 ∧ act_MC σ 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act_MC σ (z₁ + z₂) = act_MC σ z₁ + act_MC σ z₂ ∧
          act_MC σ (z₁ * z₂) = act_MC σ z₁ * act_MC σ z₂) := by
      intro σ
      refine ⟨by change fromExtendScalars_L (σ 0) = 0; rw [map_zero, map_zero],
        by change fromExtendScalars_L (σ 1) = 1; rw [map_one, map_one],
        fun z₁ z₂ => ⟨?_, ?_⟩⟩
      · change fromExtendScalars_L (σ (toExtendScalars F hLM_C z₁ + toExtendScalars F hLM_C z₂)) = _
        rw [map_add, map_add]
      · change fromExtendScalars_L (σ (toExtendScalars F hLM_C z₁ * toExtendScalars F hLM_C z₂)) = _
        rw [map_mul, map_mul]
    have hact_MC_val : ∀ (σ : G_MC) (z : M_C), valL F M_C (act_MC σ z) = valL F M_C z := by
      intro σ z
      let φ_σ : M_C ≃ₐ[F] M_C := e_MC_L.trans ((σ.restrictScalars F).trans e_MC_L.symm)
      have hφ : φ_σ z = act_MC σ z := rfl
      unfold valL relVal
      rw [← hφ, Algebra.norm_eq_of_algEquiv φ_σ z]
    have hact_MC_trace : ∀ z : M_C,
        IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G_MC, act_MC σ z := by
      intro z
      have h1 := congrArg fromExtendScalars_L
        (trace_eq_sum_automorphisms (K := L) (L := M_C_L) (toExtendScalars F hLM_C z))
      exact h1.trans (map_sum fromExtendScalars_L (fun σ : G_MC => σ (toExtendScalars F hLM_C z)) Finset.univ)
    have hact_MC_norm : ∀ z : M_C,
        IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G_MC, act_MC σ z := by
      intro z
      have h1 := congrArg fromExtendScalars_L
        (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLM_C z))
      exact h1.trans (map_prod fromExtendScalars_L (fun σ : G_MC => σ (toExtendScalars F hLM_C z)) Finset.univ)
    have hinj_LMC : Function.Injective (IntermediateField.inclusion hLM_C) :=
      (IntermediateField.inclusion hLM_C).injective
    have hring_id : ∀ (a S_sum P : M_C),
        (1 + a) * P - (1 + (a + S_sum)) =
          (P - (1 + S_sum)) + a * S_sum + a * (P - (1 + S_sum)) :=
      fun _ _ _ => by ring
    have hNormRemMCL : ∀ z : M_C, 1 ≤ valL F M_C z →
        normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
          2 * valL F M_C z ≤
            (k : ℤ) * valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)) := by
      intro z hd
      let d : ℤ := valL F M_C z
      have hz_act : ∀ σ : G_MC, act_MC σ z = 0 ∨ d ≤ valL F M_C (act_MC σ z) := by
        intro σ
        exact Or.inr (by rw [hact_MC_val σ z])
      have h_ind : ∀ S : Finset G_MC,
          ((∑ σ ∈ S, act_MC σ z) = 0 ∨ d ≤ valL F M_C (∑ σ ∈ S, act_MC σ z)) ∧
          ((∏ σ ∈ S, (1 + act_MC σ z)) - (1 + ∑ σ ∈ S, act_MC σ z) = 0 ∨
            2 * d ≤ valL F M_C ((∏ σ ∈ S, (1 + act_MC σ z)) - (1 + ∑ σ ∈ S, act_MC σ z))) := by
        intro S
        induction' S using Finset.induction_on with τ S' hτ ih
        · exact ⟨Or.inl Finset.sum_empty,
            Or.inl (by rw [Finset.prod_empty, Finset.sum_empty, add_zero, sub_self])⟩
        · rw [Finset.sum_insert hτ, Finset.prod_insert hτ]
          let a := act_MC τ z
          let S_sum := ∑ σ ∈ S', act_MC σ z
          let P := ∏ σ ∈ S', (1 + act_MC σ z)
          let R := P - (1 + S_sum)
          have ih1 : S_sum = 0 ∨ d ≤ valL F M_C S_sum := ih.1
          have ih2 : R = 0 ∨ 2 * d ≤ valL F M_C R := ih.2
          have ha : a = 0 ∨ d ≤ valL F M_C a := hz_act τ
          have hsum : a + S_sum = 0 ∨ d ≤ valL F M_C (a + S_sum) :=
            hval_add_MC d a S_sum ha ih1
          refine ⟨hsum, ?_⟩
          rw [hring_id a S_sum P]
          change (R + a * S_sum + a * R = 0) ∨ 2 * d ≤ valL F M_C (R + a * S_sum + a * R)
          have haS : a * S_sum = 0 ∨ 2 * d ≤ valL F M_C (a * S_sum) := by
            by_cases ha0 : a = 0
            · exact Or.inl (by rw [ha0, zero_mul])
            · by_cases hS0 : S_sum = 0
              · exact Or.inl (by rw [hS0, mul_zero])
              · right
                rw [hval_mul_MC a S_sum ha0 hS0]
                have h1 := ha.resolve_left ha0
                have h2 := ih1.resolve_left hS0
                omega
          have haR : a * R = 0 ∨ 2 * d ≤ valL F M_C (a * R) := by
            by_cases ha0 : a = 0
            · exact Or.inl (by rw [ha0, zero_mul])
            · by_cases hR0 : R = 0
              · exact Or.inl (by rw [hR0, mul_zero])
              · right
                rw [hval_mul_MC a R ha0 hR0]
                have h1 := ha.resolve_left ha0
                have h2 := ih2.resolve_left hR0
                omega
          exact hval_add_MC (2 * d) (R + a * S_sum) (a * R)
            (hval_add_MC (2 * d) R (a * S_sum) ih2 haS) haR
      have h_univ := (h_ind Finset.univ).2
      have hprod_eq : (∏ σ : G_MC, (1 + act_MC σ z)) =
          IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + z)) := by
        rw [hact_MC_norm (1 + z)]
        refine Finset.prod_congr rfl fun σ _ => ?_
        rw [((hact_MC_ring σ).2.2 1 z).1, (hact_MC_ring σ).2.1]
      have h_diff_eq : (∏ σ : G_MC, (1 + act_MC σ z)) - (1 + ∑ σ : G_MC, act_MC σ z) =
          IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)) := by
        rw [hprod_eq, ← hact_MC_trace z]
        simp only [map_sub, map_add, map_one]
      rw [h_diff_eq] at h_univ
      rcases h_univ with h0 | hge
      · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLM_C) hinj_LMC).mp h0)
      · rw [hValAlgMCL (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z))] at hge
        exact Or.inr hge

    set a := condExp F L χ'
    have hχ'MC_top : ∀ z : M_C, ((k * (a - 1) : ℕ) : ℤ) ≤ valL F M_C z →
        ∀ hz : 1 + z ≠ 0,
          (χ' (Units.map (normLM F hLM_C) (Units.mk0 (1 + z) hz)) : Ω F) =
            (traceChar F hLM_C ψ)
              (IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z) := by
      intro z hz_val hz
      have hka_cast : ((k * (a - 1) : ℕ) : ℤ) = (k : ℤ) * ((a - 1 : ℕ) : ℤ) := by
        simp [Nat.cast_mul]
      have hz_ge1 : 1 ≤ valL F M_C z := by
        have h1 : (1 : ℤ) ≤ ((k * (a - 1) : ℕ) : ℤ) := by
          exact_mod_cast Nat.mul_pos hk_ge1 (by omega)
        omega
      let t_z : L := traceLM F hLM_C z
      have htr_z : t_z = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F L t_z := by
        apply hTrBoundMCL ((a - 1 : ℕ) : ℤ) z
        right
        rw [hka_cast] at hz_val
        omega
      have h1tz : 1 + t_z ≠ 0 := by
        intro h0
        have htz_neg1 : t_z = -1 := eq_neg_of_add_eq_zero_right h0
        rcases htr_z with htz0 | htz_ge
        · rw [htz0] at htz_neg1
          exact one_ne_zero (neg_eq_zero.mp htz_neg1.symm)
        · rw [htz_neg1, hval_neg1_L] at htz_ge
          omega
      let u_tz : Lˣ := Units.mk0 (1 + t_z) h1tz
      have hu_tz_mem : u_tz ∈ unitGroup F L (a - 1) := by
        rw [hunit_ge1_L (a - 1) (by omega)]
        rcases htr_z with htz0 | htz_ge
        · left
          change 1 + t_z = 1
          rw [htz0, add_zero]
        · right
          have hsub : (u_tz : L) - 1 = t_z := by change (1 + t_z) - 1 = t_z; ring
          rw [hsub]
          exact htz_ge
      have hu_tz_inv_val0 : valL F L ((u_tz⁻¹ : Lˣ) : L) = 0 := by
        rw [hval_inv_L u_tz, hunit_val0_L (a - 1) u_tz hu_tz_mem, neg_zero]
      let δ_L : L := normLM F hLM_C (1 + z) - (1 + t_z)
      have hδ_L_val : δ_L = 0 ∨ (a : ℤ) ≤ valL F L δ_L := by
        rcases hNormRemMCL z hz_ge1 with h0 | h2z
        · exact Or.inl h0
        · right
          change 2 * valL F M_C z ≤ (k : ℤ) * valL F L δ_L at h2z
          rw [hka_cast] at hz_val
          have h2a : (a : ℤ) ≤ 2 * ((a - 1 : ℕ) : ℤ) := by omega
          have hmul_ka : (k : ℤ) * (a : ℤ) ≤ 2 * ((k : ℤ) * ((a - 1 : ℕ) : ℤ)) := by
            calc (k : ℤ) * (a : ℤ) ≤ (k : ℤ) * (2 * ((a - 1 : ℕ) : ℤ)) :=
                  mul_le_mul_of_nonneg_left h2a (by omega)
              _ = 2 * ((k : ℤ) * ((a - 1 : ℕ) : ℤ)) := by ring
          have hmul_le : (k : ℤ) * (a : ℤ) ≤ (k : ℤ) * valL F L δ_L := by linarith
          exact le_of_mul_le_mul_left hmul_le (by omega)
      let w_z : M_Cˣ := Units.mk0 (1 + z) hz
      let v_rem_L : Lˣ := Units.map (normLM F hLM_C) w_z * u_tz⁻¹
      have hv_rem_L_mem : v_rem_L ∈ unitGroup F L a := by
        rw [hunit_ge1_L a (by omega)]
        have hv_sub : (v_rem_L : L) - 1 = δ_L * ((u_tz⁻¹ : Lˣ) : L) := by
          have hinv : (u_tz : L) * ((u_tz⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_tz
          calc (v_rem_L : L) - 1 =
                normLM F hLM_C (1 + z) * ((u_tz⁻¹ : Lˣ) : L) -
                  (u_tz : L) * ((u_tz⁻¹ : Lˣ) : L) := by
                rw [hinv]; rfl
            _ = δ_L * ((u_tz⁻¹ : Lˣ) : L) := by
                change normLM F hLM_C (1 + z) * ((u_tz⁻¹ : Lˣ) : L) -
                  (1 + t_z) * ((u_tz⁻¹ : Lˣ) : L) = _
                dsimp [δ_L]
                ring
        rw [hv_sub]
        rcases hδ_L_val with hδ0 | hδ_ge
        · left
          have h0 : δ_L * ((u_tz⁻¹ : Lˣ) : L) = 0 := by rw [hδ0, zero_mul]
          exact sub_eq_zero.mp (by rw [hv_sub, h0])
        · right
          have hδ_ne0 : δ_L ≠ 0 := by
            intro h0
            rw [h0, hval0_L] at hδ_ge
            omega
          rw [hval_mul_L δ_L _ hδ_ne0 (Units.ne_zero u_tz⁻¹), hu_tz_inv_val0, add_zero]
          exact hδ_ge
      have hχ'_rem : χ' v_rem_L = 1 := hχ'_cond v_rem_L hv_rem_L_mem
      have hnw_eq : Units.map (normLM F hLM_C) w_z = v_rem_L * u_tz := by
        dsimp [v_rem_L]
        exact (inv_mul_cancel_right _ u_tz).symm
      have hχ'_eq : χ' (Units.map (normLM F hLM_C) w_z) = χ' u_tz := by
        rw [hnw_eq, map_mul, hχ'_rem, one_mul]
      rw [hχ'_eq, hc_L_top t_z htr_z h1tz]
      change ψ (((c'_χ'⁻¹ : Lˣ) : L) * traceLM F hLM_C z) =
        ψ (traceLM F hLM_C (IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z))
      rw [htrace_inc_mul hLM_C ((c'_χ'⁻¹ : Lˣ) : L) z]

    intro i
    dsimp only
    set F_i := (D_orb.get i).field
    haveI : FiniteDimensional F F_i := hFinFi i
    set ψ_Fi := traceChar F (D_orb.get i).le ψ
    set ψ_MC := traceChar F hLM_C ψ
    set c'_χ'_Fi : F_iˣ :=
      Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
    obtain ⟨hval0_Fi, hval1_Fi, hval_neg1_Fi, _, hval_mul_Fi, hval_inv_Fi, _,
      hval_add_Fi, _, hunit_ge1_Fi, hunit_val0_Fi⟩ := hval_all F_i
    have hValAlgFiMC_i := (hFi_ram i).2.2.1
    have hTrBoundFiMC_i := (hFi_ram i).2.2.2.2.1
    have hNormLinFiMC_i := (hFi_ram i).2.2.2.2.2.1
    have hnFi_i := (hFi_ram i).2.2.2.2.2.2.1
    have hn_eq : condExpChar F M_C ψ_MC = condExpChar F F_i ψ_Fi := hnMC.trans hnFi_i.symm
    set n₁ := condExpChar F M_C ψ_MC
    obtain ⟨_, ⟨z₁, hz₁_ne0, hz₁_val, hz₁_ψ⟩⟩ := hSpec_all M_C ψ_MC hψMC
    obtain ⟨hFi_triv, _⟩ := hSpec_all F_i ψ_Fi (hψFi i)
    have hψMC_eq_Fi : ψ_MC = traceChar F (hFiMC i) ψ_Fi :=
      htraceChar_trans (D_orb.get i).le (hFiMC i) hLM_C ψ
    let t₁ : F_i := traceLM F (hFiMC i) z₁
    have hψ_t₁ : ψ_Fi t₁ ≠ 1 := by
      have h1 : ψ_Fi t₁ = ψ_MC z₁ := by
        change ψ_Fi (traceLM F (hFiMC i) z₁) = ψ_MC z₁
        rw [hψMC_eq_Fi]
        rfl
      rw [h1]
      exact hz₁_ψ
    have ht₁_ne0 : t₁ ≠ 0 := by
      intro h0
      rw [h0, AddChar.map_zero_eq_one] at hψ_t₁
      exact hψ_t₁ rfl
    have ht₁_val_le : valL F F_i t₁ ≤ -(n₁ + 1) := by
      by_contra hgt
      have hge : -condExpChar F F_i ψ_Fi ≤ valL F F_i t₁ := by
        rw [← hn_eq]
        omega
      exact hψ_t₁ (hFi_triv t₁ (Or.inr hge))
    have ht₁_val_ge : -(n₁ + 1) ≤ valL F F_i t₁ :=
      (hTrBoundFiMC_i (-(n₁ + 1)) z₁ (Or.inr hz₁_val)).resolve_left ht₁_ne0
    have ht₁_val : valL F F_i t₁ = -(n₁ + 1) := le_antisymm ht₁_val_le ht₁_val_ge
    let u_t1 : F_iˣ := Units.mk0 t₁ ht₁_ne0
    let y_Fi : M_C := IntermediateField.inclusion (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i) * z₁
    have hinc_t1_inv_ne0 : IntermediateField.inclusion (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i) ≠ 0 :=
      (IntermediateField.inclusion (hFiMC i)).injective.ne (Units.ne_zero u_t1⁻¹)
    have hy_Fi_ne0 : y_Fi ≠ 0 := mul_ne_zero hinc_t1_inv_ne0 hz₁_ne0
    have hy_Fi_val0 : 0 ≤ valL F M_C y_Fi := by
      have hmul := hval_mul_MC (IntermediateField.inclusion (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i)) z₁
        hinc_t1_inv_ne0 hz₁_ne0
      change valL F M_C y_Fi = _ at hmul
      rw [hmul, hValAlgFiMC_i ((u_t1⁻¹ : F_iˣ) : F_i), hval_inv_Fi u_t1]
      change 0 ≤ -valL F F_i t₁ + valL F M_C z₁
      omega
    have hy_Fi_tr : traceLM F (hFiMC i) y_Fi = 1 :=
      (htrace_inc_mul (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i) z₁).trans (Units.inv_mul u_t1)

    intro x hx_val hx
    by_cases hx0 : x = 0
    · subst hx0
      have hmk1 : Units.mk0 (1 + (0 : F_i)) hx = 1 := by
        apply Units.ext
        change (1 : F_i) + 0 = 1
        ring
      rw [hmk1, map_one, Units.val_one, mul_zero, AddChar.map_zero_eq_one]
    · have hx_ge : ((k * (a - 1) : ℕ) : ℤ) ≤ valL F F_i x := hx_val.resolve_left hx0
      let x_MC : M_C := IntermediateField.inclusion (hFiMC i) x
      have hx_MC_ne0 : x_MC ≠ 0 := (IntermediateField.inclusion (hFiMC i)).injective.ne hx0
      let z : M_C := x_MC * y_Fi
      have hz_ne0 : z ≠ 0 := mul_ne_zero hx_MC_ne0 hy_Fi_ne0
      have hz_val : ((k * (a - 1) : ℕ) : ℤ) ≤ valL F M_C z := by
        have hmul := hval_mul_MC x_MC y_Fi hx_MC_ne0 hy_Fi_ne0
        change valL F M_C z = valL F M_C (IntermediateField.inclusion (hFiMC i) x) + valL F M_C y_Fi at hmul
        rw [hmul, hValAlgFiMC_i x]
        linarith [hx_ge, hy_Fi_val0]
      have hka_ge1 : (1 : ℤ) ≤ ((k * (a - 1) : ℕ) : ℤ) := by
        have h1 : 1 ≤ k * (a - 1) := Nat.mul_pos hk_ge1 (by omega)
        exact_mod_cast h1
      have hz_ge1 : 1 ≤ valL F M_C z := by omega
      have hz1 : 1 + z ≠ 0 := by
        intro h0
        have hz_neg1 : z = -1 := eq_neg_of_add_eq_zero_right h0
        rw [hz_neg1, hval_neg1_MC] at hz_ge1
        omega
      have htr_z : traceLM F (hFiMC i) z = x := by
        have h1 := htrace_inc_mul (hFiMC i) x y_Fi
        change traceLM F (hFiMC i) z = x * traceLM F (hFiMC i) y_Fi at h1
        rw [h1, hy_Fi_tr, mul_one]
      let u_x : F_iˣ := Units.mk0 (1 + x) hx
      have hu_x_mem : u_x ∈ unitGroup F F_i (k * (a - 1)) := by
        rw [hunit_ge1_Fi (k * (a - 1)) (by exact_mod_cast hka_ge1)]
        right
        have hsub : (u_x : F_i) - 1 = x := by change (1 + x) - 1 = x; ring
        rw [hsub]
        exact hx_ge
      have hu_x_inv_val0 : valL F F_i ((u_x⁻¹ : F_iˣ) : F_i) = 0 := by
        rw [hval_inv_Fi u_x, hunit_val0_Fi (k * (a - 1)) u_x hu_x_mem, neg_zero]
      let δ_Fi : F_i := normLM F (hFiMC i) (1 + z) - (1 + x)
      have hδ_Fi_val : δ_Fi = 0 ∨ ((k * (a - 1) + 1 : ℕ) : ℤ) ≤ valL F F_i δ_Fi := by
        have hlin := hNormLinFiMC_i z (Or.inr hz_ge1)
        rw [htr_z] at hlin
        rcases hlin with h0 | h2z
        · exact Or.inl h0
        · right
          change 2 * valL F M_C z ≤ valL F F_i δ_Fi at h2z
          omega
      let w_z : M_Cˣ := Units.mk0 (1 + z) hz1
      let v_rem_Fi : F_iˣ := Units.map (normLM F (hFiMC i)) w_z * u_x⁻¹
      have hv_rem_Fi_mem : v_rem_Fi ∈ unitGroup F F_i (k * (a - 1) + 1) := by
        rw [hunit_ge1_Fi (k * (a - 1) + 1) (by omega)]
        have hv_sub : (v_rem_Fi : F_i) - 1 = δ_Fi * ((u_x⁻¹ : F_iˣ) : F_i) := by
          have hinv : (u_x : F_i) * ((u_x⁻¹ : F_iˣ) : F_i) = 1 := Units.mul_inv u_x
          calc (v_rem_Fi : F_i) - 1 =
                normLM F (hFiMC i) (1 + z) * ((u_x⁻¹ : F_iˣ) : F_i) -
                  (u_x : F_i) * ((u_x⁻¹ : F_iˣ) : F_i) := by
                rw [hinv]; rfl
            _ = δ_Fi * ((u_x⁻¹ : F_iˣ) : F_i) := by
                change normLM F (hFiMC i) (1 + z) * ((u_x⁻¹ : F_iˣ) : F_i) -
                  (1 + x) * ((u_x⁻¹ : F_iˣ) : F_i) = _
                dsimp [δ_Fi]
                ring
        rw [hv_sub]
        rcases hδ_Fi_val with hδ0 | hδ_ge
        · left
          have h0 : δ_Fi * ((u_x⁻¹ : F_iˣ) : F_i) = 0 := by rw [hδ0, zero_mul]
          exact sub_eq_zero.mp (by rw [hv_sub, h0])
        · right
          have hδ_ne0 : δ_Fi ≠ 0 := by
            intro h0
            rw [h0, hval0_Fi] at hδ_ge
            omega
          rw [hval_mul_Fi δ_Fi _ hδ_ne0 (Units.ne_zero u_x⁻¹), hu_x_inv_val0, add_zero]
          exact hδ_ge
      have hχ'_rem_Fi : (χ'.comp (Units.map (normLM F (D_orb.get i).le))) v_rem_Fi = 1 :=
        hχ'_cond _ (hNormFilt i a (by omega) v_rem_Fi hv_rem_Fi_mem)
      have hu_x_eq : u_x = v_rem_Fi⁻¹ * Units.map (normLM F (hFiMC i)) w_z := by
        dsimp [v_rem_Fi]
        rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
      have hχ'_ux :
          (χ'.comp (Units.map (normLM F (D_orb.get i).le))) u_x =
            χ' (Units.map (normLM F hLM_C) w_z) := by
        rw [hu_x_eq, map_mul, map_inv, hχ'_rem_Fi, inv_one, one_mul]
        change χ' (Units.map (normLM F (D_orb.get i).le) (Units.map (normLM F (hFiMC i)) w_z)) = _
        rw [← hnorm_units_trans (D_orb.get i).le (hFiMC i) hLM_C w_z]
      change ((χ'.comp (Units.map (normLM F (D_orb.get i).le))) u_x : Ω F) = _
      rw [hχ'_ux, hχ'MC_top z hz_val hz1]
      have hinc_comp :
          IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z =
            IntermediateField.inclusion (hFiMC i) (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) * y_Fi := by
        have hinc_eq :
            IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) =
              IntermediateField.inclusion (hFiMC i) ((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) := rfl
        change IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) *
            (IntermediateField.inclusion (hFiMC i) x * y_Fi) = _
        rw [hinc_eq, map_mul, mul_assoc]
      change ψ_MC (IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z) = _
      rw [hinc_comp, hψMC_eq_Fi]
      change ψ_Fi (traceLM F (hFiMC i)
        (IntermediateField.inclusion (hFiMC i) (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) * y_Fi)) = _
      rw [htrace_inc_mul (hFiMC i) (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) y_Fi, hy_Fi_tr, mul_one]

  have hFi_regimes :
      let a := condExp F L χ'
      (k * (a - 1) ≤ t →
        (∀ i : Fin D_orb.length,
          condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) = t + 1) ∧
        (k * (a - 1) < t →
          ∀ i : Fin D_orb.length,
            c'_θ i * (c'_μ i)⁻¹ ∈ unitGroup F (D_orb.get i).field 1)) ∧
      (t < k * (a - 1) →
        (∀ i : Fin D_orb.length,
          condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) =
            k * (a - 1) + 1) ∧
        (∀ i : Fin D_orb.length,
          c'_θ i *
            (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ')⁻¹ ∈
            unitGroup F (D_orb.get i).field 1)) := by
    dsimp only
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    set a := condExp F L χ'
    let θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
      fun i => μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
    obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _,
      hval_add_L, _, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
    obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC, _,
      hval_add_MC, _, hunit_ge1_MC, hunit_val0_MC⟩ := hval_all M_C

    have hval_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
        (u : Mˣ) (n : ℕ), valL F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * valL F M (u : M) := by
      intro M _ u n
      obtain ⟨_, hval1_M, _, _, hval_mul_M, _, _, _, _, _, _⟩ := hval_all M
      induction n with
      | zero => rw [pow_zero, Units.val_one, hval1_M, Nat.cast_zero, zero_mul]
      | succ n ih =>
        rw [pow_succ', Units.val_mul, hval_mul_M (u : M) _ (Units.ne_zero u) (Units.ne_zero _), ih]
        push_cast
        ring

    have hval_zpow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
        (u : Mˣ) (m : ℤ), valL F M (((u ^ m : Mˣ) : M)) = m * valL F M (u : M) := by
      intro M _ u m
      obtain ⟨_, _, _, _, _, hval_inv_M, _, _, _, _, _⟩ := hval_all M
      cases m with
      | ofNat n =>
        change valL F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * valL F M (u : M)
        exact hval_pow M u n
      | negSucc n =>
        change valL F M ((((u ^ (n + 1))⁻¹ : Mˣ) : M)) = (Int.negSucc n) * valL F M (u : M)
        rw [hval_inv_M, hval_pow M u (n + 1), Int.negSucc_eq]
        push_cast
        ring

    have hval_prod : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
        {ι : Type} (S : Finset ι) (g : ι → Mˣ),
        valL F M (((∏ x ∈ S, g x : Mˣ) : M)) = ∑ x ∈ S, valL F M (g x : M) := by
      intro M _ ι S g
      obtain ⟨_, hval1_M, _, _, hval_mul_M, _, _, _, _, _, _⟩ := hval_all M
      induction S using Finset.induction_on with
      | empty => rw [Finset.prod_empty, Finset.sum_empty, Units.val_one, hval1_M]
      | @insert x s hx ih =>
        rw [Finset.prod_insert hx, Finset.sum_insert hx, Units.val_mul,
          hval_mul_M (g x : M) _ (Units.ne_zero (g x)) (Units.ne_zero _), ih]

    have hσ_symm_val : ∀ j (z : M_C), valL F M_C ((σ_all j).symm z) = valL F M_C z := by
      intro j z
      have h1 := (hν_props j).2.2.2.1 ((σ_all j).symm z)
      rw [AlgEquiv.apply_symm_apply] at h1
      exact h1.symm

    have hσ_symm_incl : ∀ j (x : L),
        (σ_all j).symm (IntermediateField.inclusion hLM_C x) =
          IntermediateField.inclusion hLM_C x := by
      intro j x
      have h1 := congrArg (σ_all j).symm ((hν_props j).2.2.1 x)
      rw [AlgEquiv.symm_apply_apply] at h1
      exact h1.symm

    have hnorm_unit_inc_LFi : ∀ (i : Fin D_orb.length) (u : Lˣ),
        Units.map (normLM F (D_orb.get i).le)
          (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom u) =
          u ^ (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) := by
      intro i u
      let F_i_L := IntermediateField.extendScalars (D_orb.get i).le
      apply Units.ext
      change Algebra.norm L (algebraMap L F_i_L (u : L)) =
        (u : L) ^ (Module.finrank L F_i_L)
      exact Algebra.norm_algebraMap (u : L)

    have hfiber_two : ∀ i : Fin D_orb.length,
        ∃ j₁ j₂ : Fin (q - 1), idx_all j₁ = i ∧ idx_all j₂ = i ∧ j₁ ≠ j₂ := by
      intro i
      set F_i := (D_orb.get i).field
      haveI : FiniteDimensional F F_i := hFinFi i
      let F_i_L := IntermediateField.extendScalars (D_orb.get i).le
      let d_i := Module.finrank L F_i_L
      let e_Fi_L : F_i ≃ₐ[F] F_i_L :=
        { toExtendScalars F (D_orb.get i).le with
          invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars (D_orb.get i).le).mp y.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          commutes' := fun _ => rfl }
      haveI : FiniteDimensional F F_i_L := Module.Finite.equiv e_Fi_L.toLinearEquiv
      haveI : IsScalarTower F L F_i_L := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : FiniteDimensional L F_i_L := Module.Finite.of_restrictScalars_finite F L F_i_L
      have hd_pos : 0 < d_i := Module.finrank_pos
      have hd_ne1 : d_i ≠ 1 := by
        intro h1
        have hbot : F_i_L = ⊥ := IntermediateField.finrank_eq_one_iff.mp h1
        have hle : F_i ≤ L := by
          intro x hx
          have hmem : (x : AlgebraicClosure F) ∈ F_i_L :=
            (IntermediateField.mem_extendScalars (D_orb.get i).le).mpr hx
          rw [hbot, IntermediateField.mem_bot] at hmem
          obtain ⟨y, hy⟩ := hmem
          rw [← hy]
          exact y.2
        exact not_le_of_gt (hLtFi i) hle
      have hd_ge2 : 2 ≤ d_i := by omega
      let c_ϖ : ∀ i' : Fin D_orb.length, ((D_orb.get i').field)ˣ :=
        fun i' => if h : i' = i then
          h ▸ Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom ϖ_L
        else 1
      have hc_ϖ_val : ∀ i' : Fin D_orb.length,
          valL F M_C
            (((Units.map (IntermediateField.inclusion (hFiMC i')).toMonoidHom (c_ϖ i') : M_Cˣ) : M_C)) =
            if i' = i then (k : ℤ) else 0 := by
        intro i'
        rcases eq_or_ne i' i with rfl | hne
        · have hc : c_ϖ i' =
              Units.map (IntermediateField.inclusion (D_orb.get i').le).toMonoidHom ϖ_L :=
            dif_pos rfl
          rw [if_pos rfl, hc]
          change valL F M_C (IntermediateField.inclusion hLM_C (ϖ_L : L)) = (k : ℤ)
          rw [hValAlgMCL (ϖ_L : L), hϖ_L, mul_one]
        · have hc : c_ϖ i' = 1 := dif_neg hne
          rw [if_neg hne, hc, map_one, Units.val_one, hval1_MC]
      have hlhs_val :
          valL F M_C
            (((∏ j : Fin (q - 1),
              Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
                (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                  (c_ϖ (idx_all j))) : M_Cˣ) : M_C)) =
            ((Finset.univ.filter (fun j : Fin (q - 1) => idx_all j = i)).card : ℤ) * (k : ℤ) := by
        rw [hval_prod M_C Finset.univ (fun j : Fin (q - 1) =>
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_ϖ (idx_all j))))]
        have hsum_eq :
            (∑ j : Fin (q - 1),
              valL F M_C
                (((Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
                  (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                    (c_ϖ (idx_all j))) : M_Cˣ) : M_C))) =
            ∑ j : Fin (q - 1), (if idx_all j = i then (k : ℤ) else 0) := by
          refine Finset.sum_congr rfl fun j _ => ?_
          change valL F M_C
            ((σ_all j).symm
              (((Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (c_ϖ (idx_all j)) : M_Cˣ) : M_C))) = _
          rw [hσ_symm_val j, hc_ϖ_val (idx_all j)]
        have hsum_ite :
            (∑ j : Fin (q - 1), (if idx_all j = i then (k : ℤ) else 0)) =
            (∑ j : Fin (q - 1), (if idx_all j = i then (1 : ℤ) else 0)) * (k : ℤ) := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun j _ => ?_
          split_ifs <;> ring
        rw [hsum_eq, hsum_ite, Finset.sum_boole]
      have hprod_rhs :
          (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_ϖ i')) =
            ϖ_L ^ d_i := by
        rw [Finset.prod_eq_single i]
        · have hc : c_ϖ i =
              Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom ϖ_L :=
            dif_pos rfl
          rw [hc, hnorm_unit_inc_LFi i ϖ_L]
        · intro i' _ hne
          have hc : c_ϖ i' = 1 := dif_neg hne
          rw [hc, map_one]
        · intro hi
          exact False.elim (hi (Finset.mem_univ i))
      have hrhs_val :
          valL F M_C
            (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
              (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_ϖ i')) : M_Cˣ) : M_C)) =
            (d_i : ℤ) * (k : ℤ) := by
        rw [hprod_rhs]
        change valL F M_C (IntermediateField.inclusion hLM_C (((ϖ_L ^ d_i : Lˣ) : L))) = _
        rw [hValAlgMCL, hval_pow L ϖ_L d_i, hϖ_L, mul_one, mul_comm]
      have heq_val :
          valL F M_C
            (((∏ j : Fin (q - 1),
              Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
                (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                  (c_ϖ (idx_all j))) : M_Cˣ) : M_C)) =
          valL F M_C
            (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
              (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_ϖ i')) : M_Cˣ) : M_C)) :=
        congrArg (fun u : M_Cˣ => valL F M_C (u : M_C)) (hν_prod c_ϖ)
      rw [hlhs_val, hrhs_val] at heq_val
      have hcard_eq : (Finset.univ.filter (fun j : Fin (q - 1) => idx_all j = i)).card = d_i := by
        apply Nat.cast_injective (R := ℤ)
        exact mul_right_cancel₀ (by omega) heq_val
      have hcard_gt1 : 1 < (Finset.univ.filter (fun j : Fin (q - 1) => idx_all j = i)).card := by
        omega
      rw [Finset.one_lt_card_iff] at hcard_gt1
      obtain ⟨j₁, j₂, hj₁, hj₂, hne⟩ := hcard_gt1
      rw [Finset.mem_filter] at hj₁ hj₂
      exact ⟨j₁, j₂, hj₁.2, hj₂.2, hne⟩

    let c'_χ'_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
      fun i => Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
    let α_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
      fun i => c'_χ'_Fi i * (c'_μ i)⁻¹

    have hc'_χ'_Fi_val : ∀ i : Fin D_orb.length,
        valL F (D_orb.get i).field (c'_χ'_Fi i : (D_orb.get i).field) =
          (k : ℤ) * ((a : ℤ) + condExpChar F L ψ) := by
      intro i
      rw [← (hFi_ram i).2.2.1]
      change valL F M_C (IntermediateField.inclusion hLM_C (c'_χ' : L)) = _
      rw [hValAlgMCL (c'_χ' : L), hc_L_val]

    have hc'_χ'_Fi_val_Fi : ∀ i : Fin D_orb.length,
        valL F (D_orb.get i).field (c'_χ'_Fi i : (D_orb.get i).field) =
          ((k * (a - 1) + 1 : ℕ) : ℤ) +
            condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) := by
      intro i
      rw [hc'_χ'_Fi_val i, (hFi_ram i).2.2.2.2.2.2.1]
      have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
      push_cast
      rw [ha_sub]
      ring

    have hc_μ_val_L : ∀ i : Fin D_orb.length,
        valL F (D_orb.get i).field (c'_μ i : (D_orb.get i).field) =
          (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) := by
      intro i
      rw [(hc_orb i).2.2.1, (hFi_ram i).1, (hFi_ram i).2.2.2.2.2.2.1]
      push_cast
      ring

    have hα_val : ∀ i : Fin D_orb.length,
        valL F (D_orb.get i).field (α_orb i : (D_orb.get i).field) =
          (k : ℤ) * ((a - 1 : ℕ) : ℤ) - (t : ℤ) := by
      intro i
      set F_i := (D_orb.get i).field
      haveI : FiniteDimensional F F_i := hFinFi i
      obtain ⟨_, _, _, _, hval_mul_Fi, hval_inv_Fi, _, _, _, _, _⟩ := hval_all F_i
      change valL F F_i ((c'_χ'_Fi i : F_i) * (((c'_μ i)⁻¹ : F_iˣ) : F_i)) = _
      rw [hval_mul_Fi _ _ (Units.ne_zero _) (Units.ne_zero _),
        hc'_χ'_Fi_val i, hval_inv_Fi (c'_μ i), hc_μ_val_L i]
      have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
      rw [ha_sub]
      ring

    have hcrit_unit : k * (a - 1) = t →
        ∀ i : Fin D_orb.length,
          let F_i := (D_orb.get i).field
          let α_i := α_orb i
          1 + ((α_i⁻¹ : F_iˣ) : F_i) ≠ 0 ∧
          valL F F_i (1 + ((α_i⁻¹ : F_iˣ) : F_i)) = 0 := by
      intro hcrit i
      dsimp only
      set F_i := (D_orb.get i).field
      haveI : FiniteDimensional F F_i := hFinFi i
      obtain ⟨hval0_Fi, hval1_Fi, hval_neg1_Fi, hval_neg_Fi, hval_mul_Fi, hval_inv_Fi, _,
        hval_add_Fi, _, _, _⟩ := hval_all F_i
      have hα_val0 : valL F F_i (α_orb i : F_i) = 0 := by
        rw [hα_val i]
        have h1 : (k : ℤ) * ((a - 1 : ℕ) : ℤ) = (t : ℤ) := by exact_mod_cast hcrit
        omega
      have hα_inv_val0 : valL F F_i (((α_orb i)⁻¹ : F_iˣ) : F_i) = 0 := by
        rw [hval_inv_Fi (α_orb i), hα_val0, neg_zero]
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let u_ϖ1 : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (c'_χ' * c₀⁻¹)
      let u_ϖ2 : M_Cˣ := (ϖ_MC ^ t)⁻¹
      let u_ϖ_0 : M_Cˣ := u_ϖ1 * u_ϖ2
      have hc₀_val : valL F L (c₀ : L) = 1 + condExpChar F L ψ := by
        change valL F L ((ϖ_L ^ (1 + condExpChar F L ψ) : Lˣ) : L) = _
        rw [hval_zpow L ϖ_L, hϖ_L, mul_one]
      have hu_ϖ_val0 : valL F M_C (u_ϖ_0 : M_C) = 0 := by
        change valL F M_C ((u_ϖ1 : M_C) * (u_ϖ2 : M_C)) = 0
        rw [hval_mul_MC _ _ (Units.ne_zero u_ϖ1) (Units.ne_zero u_ϖ2)]
        have h1 : valL F M_C (u_ϖ1 : M_C) = (k : ℤ) * ((a - 1 : ℕ) : ℤ) := by
          change valL F M_C (IntermediateField.inclusion hLM_C (((c'_χ' * c₀⁻¹ : Lˣ) : L))) = _
          rw [hValAlgMCL, Units.val_mul, hval_mul_L _ _ (Units.ne_zero c'_χ') (Units.ne_zero c₀⁻¹),
            hc_L_val, hval_inv_L c₀, hc₀_val]
          have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
          rw [ha_sub]
          ring
        have h2 : valL F M_C (u_ϖ2 : M_C) = -(t : ℤ) := by
          change valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) = _
          rw [hval_inv_MC (ϖ_MC ^ t), hval_pow M_C ϖ_MC t, hϖ_MC, mul_one]
        rw [h1, h2]
        have h3 : (k : ℤ) * ((a - 1 : ℕ) : ℤ) = (t : ℤ) := by exact_mod_cast hcrit
        omega
      have hcomm_group_0 : ∀ (cMC c0MC wMC mJ : M_Cˣ),
          ((cMC * c0MC⁻¹) * wMC⁻¹) * (c0MC * wMC * mJ⁻¹) = cMC * mJ⁻¹ := by
        intro cMC c0MC wMC mJ
        calc ((cMC * c0MC⁻¹) * wMC⁻¹) * (c0MC * wMC * mJ⁻¹) =
              (c0MC⁻¹ * c0MC) * (wMC⁻¹ * wMC) * (cMC * mJ⁻¹) := by ac_rfl
          _ = cMC * mJ⁻¹ := by rw [inv_mul_cancel, inv_mul_cancel, one_mul, one_mul]
      have hu_ϖ_mul : ∀ j : Fin (q - 1),
          u_ϖ_0 * u_all_0 j =
            Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
              (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (α_orb (idx_all j))) := by
        intro j
        rw [hu_all_0_def j]
        dsimp only [u_ϖ_0, u_ϖ1, u_ϖ2, c₀]
        rw [map_mul, map_inv, hcomm_group_0]
        apply Units.ext
        change IntermediateField.inclusion hLM_C (c'_χ' : L) *
            ((σ_all j).symm
              (IntermediateField.inclusion (hFiMC (idx_all j))
                (((c'_μ (idx_all j))⁻¹ : ((D_orb.get (idx_all j)).field)ˣ) :
                  (D_orb.get (idx_all j)).field))) =
          (σ_all j).symm
            (IntermediateField.inclusion (hFiMC (idx_all j))
              ((c'_χ'_Fi (idx_all j) : (D_orb.get (idx_all j)).field) *
                (((c'_μ (idx_all j))⁻¹ : ((D_orb.get (idx_all j)).field)ˣ) :
                  (D_orb.get (idx_all j)).field)))
        have hinc_c :
            IntermediateField.inclusion (hFiMC (idx_all j))
              (c'_χ'_Fi (idx_all j) : (D_orb.get (idx_all j)).field) =
            IntermediateField.inclusion hLM_C (c'_χ' : L) := rfl
        rw [map_mul, map_mul, hinc_c, hσ_symm_incl j (c'_χ' : L)]
      have hnot_p1 : ¬ (1 + (α_orb i : F_i) = 0 ∨ 1 ≤ valL F F_i (1 + (α_orb i : F_i))) := by
        intro h1α
        obtain ⟨j₁, j₂, hj₁, hj₂, hne⟩ := hfiber_two i
        let z_i : M_C := IntermediateField.inclusion (hFiMC i) (1 + (α_orb i : F_i))
        have hz_i_val : z_i = 0 ∨ 1 ≤ valL F M_C z_i := by
          rcases h1α with h0 | hge
          · left
            change IntermediateField.inclusion (hFiMC i) (1 + (α_orb i : F_i)) = 0
            rw [h0, map_zero]
          · right
            change 1 ≤ valL F M_C (IntermediateField.inclusion (hFiMC i) (1 + (α_orb i : F_i)))
            rw [(hFi_ram i).2.2.1 (1 + (α_orb i : F_i))]
            exact hge
        have hfib_eq : ∀ j : Fin (q - 1), idx_all j = i →
            (u_ϖ_0 : M_C) * (u_all_0 j : M_C) = (σ_all j).symm z_i - 1 := by
          intro j hj
          have h1 := congrArg (fun u : M_Cˣ => (u : M_C)) (hu_ϖ_mul j)
          change (u_ϖ_0 : M_C) * (u_all_0 j : M_C) =
            (σ_all j).symm
              (((Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (α_orb (idx_all j)) : M_Cˣ) : M_C)) at h1
          have hinc_eq :
              (((Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (α_orb (idx_all j)) : M_Cˣ) : M_C)) =
                z_i - 1 := by
            rcases eq_or_ne (idx_all j) i with h_eq | h_ne
            · cases h_eq
              dsimp [z_i]
              rw [map_add, map_one]
              ring
            · exact False.elim (h_ne hj)
          rw [h1, hinc_eq, map_sub, map_one]
        have hdiff_eq :
            (u_ϖ_0 : M_C) * ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C)) =
              (σ_all j₁).symm z_i + (-(σ_all j₂).symm z_i) := by
          calc (u_ϖ_0 : M_C) * ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C)) =
                (u_ϖ_0 : M_C) * (u_all_0 j₁ : M_C) - (u_ϖ_0 : M_C) * (u_all_0 j₂ : M_C) := mul_sub _ _ _
            _ = ((σ_all j₁).symm z_i - 1) - ((σ_all j₂).symm z_i - 1) := by
                rw [hfib_eq j₁ hj₁, hfib_eq j₂ hj₂]
            _ = (σ_all j₁).symm z_i + (-(σ_all j₂).symm z_i) := by ring
        have hσ_z : ∀ j : Fin (q - 1),
            (σ_all j).symm z_i = 0 ∨ 1 ≤ valL F M_C ((σ_all j).symm z_i) := by
          intro j
          rcases hz_i_val with h0 | hge
          · exact Or.inl (by rw [h0, map_zero])
          · exact Or.inr (by rw [hσ_symm_val j z_i]; exact hge)
        have hneg_σ_z :
            (-(σ_all j₂).symm z_i) = 0 ∨ 1 ≤ valL F M_C (-(σ_all j₂).symm z_i) := by
          rcases hσ_z j₂ with h0 | hge
          · exact Or.inl (by rw [h0, neg_zero])
          · exact Or.inr (by rw [hval_neg_MC]; exact hge)
        have hprod_diff :
            (u_ϖ_0 : M_C) * ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C)) = 0 ∨
              1 ≤ valL F M_C ((u_ϖ_0 : M_C) * ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C))) := by
          rw [hdiff_eq]
          exact hval_add_MC 1 ((σ_all j₁).symm z_i) (-(σ_all j₂).symm z_i) (hσ_z j₁) hneg_σ_z
        have hu_diff :
            (u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C) = 0 ∨
              1 ≤ valL F M_C ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C)) := by
          rcases hprod_diff with h0 | hge
          · left
            exact (mul_eq_zero.mp h0).resolve_left (Units.ne_zero u_ϖ_0)
          · right
            have hne0 : (u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C) ≠ 0 := by
              intro h0
              rw [h0, mul_zero, hval0_MC] at hge
              omega
            rw [hval_mul_MC (u_ϖ_0 : M_C) _ (Units.ne_zero u_ϖ_0) hne0, hu_ϖ_val0, zero_add] at hge
            exact hge
        exact hne (hu_all_0_inj j₁ j₂ hu_diff)
      have h1α_ne0 : 1 + (α_orb i : F_i) ≠ 0 := fun h0 => hnot_p1 (Or.inl h0)
      have h1α_le0 : valL F F_i (1 + (α_orb i : F_i)) ≤ 0 := by
        by_contra hgt
        exact hnot_p1 (Or.inr (by omega))
      have h1α_ge0 : 0 ≤ valL F F_i (1 + (α_orb i : F_i)) :=
        (hval_add_Fi 0 1 (α_orb i : F_i) (Or.inr (by rw [hval1_Fi])) (Or.inr (by rw [hα_val0]))).resolve_left
          h1α_ne0
      have h1α_val0 : valL F F_i (1 + (α_orb i : F_i)) = 0 := le_antisymm h1α_le0 h1α_ge0
      have hinv_id : 1 + (((α_orb i)⁻¹ : F_iˣ) : F_i) =
          (((α_orb i)⁻¹ : F_iˣ) : F_i) * (1 + (α_orb i : F_i)) := by
        have hmul : (((α_orb i)⁻¹ : F_iˣ) : F_i) * (α_orb i : F_i) = 1 := Units.inv_mul (α_orb i)
        linear_combination -hmul
      have h1α_inv_ne0 : 1 + (((α_orb i)⁻¹ : F_iˣ) : F_i) ≠ 0 := by
        rw [hinv_id]
        exact mul_ne_zero (Units.ne_zero (α_orb i)⁻¹) h1α_ne0
      refine ⟨h1α_inv_ne0, ?_⟩
      rw [hinv_id, hval_mul_Fi _ _ (Units.ne_zero (α_orb i)⁻¹) h1α_ne0, hα_inv_val0, h1α_val0, add_zero]

    have hFi_ultrametric : ∀ i : Fin D_orb.length,
        let F_i := (D_orb.get i).field
        let ψ_Fi := traceChar F (D_orb.get i).le ψ
        let θ_i := θ_orb i
        let m₀ := max t (k * (a - 1))
        let S_i : F_i := (((c'_μ i)⁻¹ : F_iˣ) : F_i) + (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i)
        let Δ_i : F_i := (((c'_θ i)⁻¹ : F_iˣ) : F_i) - S_i
        condExp F F_i θ_i = m₀ + 1 ∧
        (Δ_i = 0 ∨ -((m₀ : ℤ) + condExpChar F F_i ψ_Fi) ≤ valL F F_i Δ_i) := by
      intro i
      dsimp only
      set F_i := (D_orb.get i).field
      haveI : FiniteDimensional F F_i := hFinFi i
      set ψ_Fi := traceChar F (D_orb.get i).le ψ
      set θ_i := θ_orb i
      set c_i := condExp F F_i θ_i
      set n_Fi := condExpChar F F_i ψ_Fi
      set m₀ := max t (k * (a - 1))
      set M := max (c_i - 1) m₀
      set S_i : F_i := (((c'_μ i)⁻¹ : F_iˣ) : F_i) + (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i)
      set Δ_i : F_i := (((c'_θ i)⁻¹ : F_iˣ) : F_i) - S_i
      obtain ⟨hval0_Fi, hval1_Fi, hval_neg1_Fi, hval_neg_Fi, hval_mul_Fi, hval_inv_Fi, _,
        hval_add_Fi, _, hunit_ge1_Fi, _⟩ := hval_all F_i
      have hc_i_ge2 : 2 ≤ c_i := (hc_orb i).2.1
      have hm₀_ge1 : 1 ≤ m₀ := le_trans ht_ge1 (le_max_left t (k * (a - 1)))
      have hM_ge1 : 1 ≤ M := le_trans hm₀_ge1 (le_max_right (c_i - 1) m₀)
