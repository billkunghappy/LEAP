      rcases h5 with h0 | hle
      · exact Or.inl h0
      · right
        apply le_trans _ hle
        rw [← sub_nonneg]
        have hid :
            v_wt + (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + - 2 * (p : ℤ) * (p : ℤ) * (m : ℤ) +
                - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) + - (p : ℤ) * (t₁ : ℤ) +
                2 * (p : ℤ) * (p : ℤ) * (m : ℤ) - K =
              2 * (a_p + 2) * a_pm + (2 * a_p + 3) + (a_p ^ 2 + 4 * a_p + 2) * (t₁ : ℤ) +
                (2 * a_p + 3) * (p : ℤ) * a_d := by
          dsimp [v_wt]
