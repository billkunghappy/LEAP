theorem ld_ch10_fml_tame_ramified (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hRam : condExp F L ν₁ ≠ 0)
    (hNeP : Module.finrank L (IntermediateField.extendScalars hLK) ≠ p F) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  obtain ⟨hFinL, hFinK, hψK, hν₁_triv1, hν₁_cond_eq, hResDeg, hValNorm, hValAlg,
      hCondψK, ⟨ϖ_K, hϖ_K, hϖ_L, hν₁_ϖ, hϖ_deg2⟩, hResSurj, hTraceBound, hNormRem,
      hT0, hCondPos⟩ :=
    ld_tame_ramified_uniformizer_and_conductors F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hRam hNeP
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F K := hFinK
  by_cases ha0 : condExp F L χ' = 0
  · exact hT0 ha0
  · have ha_pos : 1 ≤ condExp F L χ' := Nat.one_le_iff_ne_zero.mpr ha0
    obtain ⟨hCondTwist, hCondχ'K⟩ := hCondPos ha_pos
    by_cases ha1 : condExp F L χ' = 1
    · exact ld_tame_fml_cond_one F L K hLK hPrime ψ hψ hψK
        ν₁ χ' hν₁_pow hν₁_ne hν₁_triv1 hν₁_cond_eq hχ'_cond hχ'K_cond hNeP
        hResDeg hValNorm hValAlg hCondψK ϖ_K hϖ_K hϖ_L hν₁_ϖ hResSurj ha1
        (fun j hj => (hCondTwist j hj).trans ha1)
        (by rw [hCondχ'K, ha1]; simp)
        (fun k _ _ hNeChar ψ_k hψ_k ν_k χ_k hν_pow hν_ne _ =>
          ld_finite_field_davenport_hasse_inv_product F k _ hPrime hNeChar ψ_k hψ_k ν_k χ_k hν_pow hν_ne)
    · have ha2 : 2 ≤ condExp F L χ' := by omega
      exact ld_tame_fml_higher_conductor F L K hLK hPrime ψ hψ hψK
        ν₁ χ' hν₁_pow hν₁_ne hν₁_triv1 hν₁_cond_eq hχ'_cond hχ'K_cond hNeP
        hResDeg hValNorm hValAlg hCondψK
        ϖ_K hϖ_K hϖ_L hν₁_ϖ hϖ_deg2 hResSurj hTraceBound hNormRem ha2 hCondTwist hCondχ'K
        (fun E _ ψ_E hψE θ hm => ld_tame_stationary_phase_and_stable_twist F E ψ_E hψE θ hm)

theorem ld_wild_total_ramification_and_power_basis (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hRam : condExp F L ν₁ ≠ 0)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (haddVal1 : addVal F 1 = 0)
    (haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    2 ≤ condExp F L ν₁ ∧
    (∀ j < p, 0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁) ∧
    qL F K = qL F L ∧
    (∀ y : K, valL F L (normLM F hLK y) = valL F K y) ∧
    (∀ x : L, valL F K (IntermediateField.inclusion hLK x) = (p : ℤ) * valL F L x) ∧
    (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧ (x - s ^ p = 0 ∨ 1 ≤ valL F L (x - s ^ p))) ∧
    (∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m, u ^ p ∈ unitGroup F L (m + 1)) ∧
    (∀ u₁ : Lˣ, ν₁ u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ, ξ ^ p = 1 → ∃ k < p, (ν₁ u₁) ^ k = ξ) ∧
    ∃ (ϖ_K : Kˣ) (ϖ_L : Lˣ),
      Units.map (normLM F hLK) ϖ_K = ϖ_L ∧
      valL F K (ϖ_K : K) = 1 ∧
      valL F L (ϖ_L : L) = 1 ∧
      ∀ y : K, ∃ c : Fin p → L,
        y = ∑ i : Fin p, IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
        ∀ (m : ℤ),
          (y = 0 ∨ m ≤ valL F K y) ↔
            ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F L (c i) + (i : ℤ) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, hval_surj_K, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  set K' := IntermediateField.extendScalars hLK
  set p := Module.finrank L K'
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_int_pos : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
  have hp_int_ne : (p : ℤ) ≠ 0 := ne_of_gt hp_int_pos

  
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_pow_K : ∀ (y : K) (n : ℕ), y ≠ 0 → valL F K (y ^ n) = (n : ℤ) * valL F K y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_pow_ge_L : ∀ (n : ℕ) (m : ℤ) (x : L),
      (x = 0 ∨ m ≤ valL F L x) → (x ^ n = 0 ∨ (n : ℤ) * m ≤ valL F L (x ^ n)) := by
    intro n m x hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hval1_L]
      simp
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge_L ((n : ℤ) * m) m (x ^ n) x ih hx
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * m = (n : ℤ) * m + m := by push_cast; ring
        rw [heq]
        exact hge
  have hval_finset_sum_L : ∀ (S : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_L k (f a) (∑ i ∈ s, f i) ha_val hs_val

  
  have hp_valL : (p : L) = 0 ∨ 1 ≤ valL F L (p : L) := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] (p : 𝒪[F]) = 0 := by
      rw [hEqP, map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (EllipticRootNumber.p F)
    have hker : valuation F ((p : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    have hpF : (p : F) = 0 ∨ 1 ≤ addVal F (p : F) := by
      by_cases hp0 : (p : F) = 0
      · exact Or.inl hp0
      · right
        have hφp : φ (valuation F (p : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
        have hlt : φ (valuation F (p : F)) < 1 := by
          rw [← map_one φ, map_lt_map_iff φ]
          exact hker
        rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
          ← Multiplicative.toAdd_lt, toAdd_one] at hlt
        unfold addVal
        rw [dif_neg hp0]
        omega
    have halg_p := halg1 (p : F) hpF
    rwa [map_natCast (algebraMap F L) p] at halg_p

  have hres_nat : ∀ n : ℕ, ((n : L) = 0 ∨ 0 ≤ valL F L (n : L)) ∧ resL (n : L) = (n : k_L) := by
    intro n
    induction n with
    | zero =>
      refine ⟨Or.inl Nat.cast_zero, ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ n ih =>
      have h1 : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by rw [hval1_L])
      have hval_succ : ((n + 1 : ℕ) : L) = 0 ∨ 0 ≤ valL F L ((n + 1 : ℕ) : L) := by
        rw [Nat.cast_succ]
        exact hval_add_L 0 (n : L) 1 ih.1 h1
      refine ⟨hval_succ, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (n : L) 1 ih.1 h1).1, ih.2, hresL_1, Nat.cast_succ]

  have hres_pow : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
      ∀ n : ℕ, (x ^ n = 0 ∨ 0 ≤ valL F L (x ^ n)) ∧ resL (x ^ n) = (resL x) ^ n := by
    intro x hx n
    induction n with
    | zero =>
      refine ⟨Or.inr (by rw [pow_zero, hval1_L]), ?_⟩
      rw [pow_zero, pow_zero, hresL_1]
    | succ n ih =>
      have hval_succ : x ^ (n + 1) = 0 ∨ 0 ≤ valL F L (x ^ (n + 1)) := by
        rw [pow_succ]
        simpa using hval_mul_ge_L 0 0 (x ^ n) x ih.1 hx
      refine ⟨hval_succ, ?_⟩
      rw [pow_succ, (hresL_ring (x ^ n) x ih.1 hx).2.1, ih.2, pow_succ]

  have hp_kL : (p : k_L) = 0 := by
    rw [← (hres_nat p).2]
    exact (hresL_ker (p : L) (hres_nat p).1).mpr hp_valL

  have hchoose_kL : ∀ k : ℕ, 0 < k → k < p → (p.choose k : k_L) = 0 := by
    intro k hk0 hkp
    have hdvd : p ∣ p.choose k := Nat.Prime.dvd_choose_self hPrime (ne_of_gt hk0) hkp
    rcases hdvd with ⟨c, hc⟩
    rw [hc, Nat.cast_mul, hp_kL, zero_mul]

  have hfrob_add : ∀ b d : k_L, (b + d) ^ p = b ^ p + d ^ p := by
    intro b d
    have hp_eq : p + 1 = (p - 1) + 1 + 1 := by omega
    have hp1 : (p - 1) + 1 = p := by omega
    rw [add_pow b d p, hp_eq, Finset.sum_range_succ, Finset.sum_range_succ']
    have hmid : (∑ k ∈ Finset.range (p - 1),
        b ^ (k + 1) * d ^ (p - (k + 1)) * (p.choose (k + 1) : k_L)) = 0 := by
      apply Finset.sum_eq_zero
      intro k hk
      have hlt : k < p - 1 := Finset.mem_range.mp hk
      rw [hchoose_kL (k + 1) (by omega) (by omega), mul_zero]
    simp only [hmid, zero_add, hp1, Nat.sub_self, Nat.sub_zero, pow_zero, mul_one, one_mul,
      Nat.choose_self, Nat.choose_zero_right, Nat.cast_one]
    exact add_comm (d ^ p) (b ^ p)

  have hfrob_inj : Function.Injective (fun a : k_L => a ^ p) := by
    intro a b hab
    dsimp at hab
    have hbd : (b + (a - b)) ^ p = b ^ p + (a - b) ^ p := hfrob_add b (a - b)
    rw [add_sub_cancel, hab] at hbd
    have hzero : (a - b) ^ p = 0 := by linear_combination -hbd
    exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hzero)

  have hfrob_surj_kL : Function.Surjective (fun a : k_L => a ^ p) :=
    Finite.surjective_of_injective hfrob_inj

  have hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧ (x - s ^ p = 0 ∨ 1 ≤ valL F L (x - s ^ p)) := by
    intro x hx
    obtain ⟨a₀, ha₀⟩ := hfrob_surj_kL (resL x)
    obtain ⟨s, hs_val, hs_res⟩ := hresL_surj a₀
    have hsp := hres_pow s hs_val p
    have hneg_sp : -(s ^ p) = 0 ∨ 0 ≤ valL F L (-(s ^ p)) := by
      rcases hsp.1 with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right
        rw [hval_neg_L]
        exact hge
    have hsub_val : x - s ^ p = 0 ∨ 0 ≤ valL F L (x - s ^ p) := by
      rw [sub_eq_add_neg]
      exact hval_add_L 0 x (-(s ^ p)) hx hneg_sp
    have hsub_res : resL (x - s ^ p) = 0 := by
      rw [sub_eq_add_neg, (hresL_ring x (-(s ^ p)) hx hneg_sp).1,
        (hresL_ring (s ^ p) 0 hsp.1 (Or.inl rfl)).2.2, hsp.2, hs_res]
      dsimp at ha₀
      rw [ha₀, add_neg_cancel]
    exact ⟨s, hs_val, (hresL_ker (x - s ^ p) hsub_val).mp hsub_res⟩

  have hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m,
      u ^ p ∈ unitGroup F L (m + 1) := by
    intro m hm u hu
    let x : L := (u : L) - 1
    have hx : x = 0 ∨ (m : ℤ) ≤ valL F L x := by
      rcases (hunit_ge1_L m hm u).mp hu with h1 | hge
      · left
        dsimp [x]
        rw [h1, sub_self]
      · exact Or.inr hge
    have hu_eq : (u : L) = x + 1 := by
      dsimp [x]
      ring
    have hpow_sub : ((u ^ p : Lˣ) : L) - 1 =
        ∑ k ∈ Finset.range p, (x ^ (k + 1) * (p.choose (k + 1) : L)) := by
      rw [Units.val_pow_eq_pow_val, hu_eq, add_pow x 1 p, Finset.sum_range_succ']
      simp [one_pow]
    have hsum_val : (∑ k ∈ Finset.range p, (x ^ (k + 1) * (p.choose (k + 1) : L))) = 0 ∨
        ((m + 1 : ℕ) : ℤ) ≤
          valL F L (∑ k ∈ Finset.range p, (x ^ (k + 1) * (p.choose (k + 1) : L))) := by
      apply hval_finset_sum_L (Finset.range p) _ ((m + 1 : ℕ) : ℤ)
      intro k _
      by_cases hk0 : k = 0
      · subst hk0
        simp only [zero_add, pow_one, Nat.choose_one_right]
        have hmul := hval_mul_ge_L (m : ℤ) 1 x (p : L) hx hp_valL
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          push_cast
          omega
      · have hx_pow := hval_pow_ge_L (k + 1) (m : ℤ) x hx
        have hx_pow' : x ^ (k + 1) = 0 ∨ ((m + 1 : ℕ) : ℤ) ≤ valL F L (x ^ (k + 1)) := by
          rcases hx_pow with h0 | hge
          · exact Or.inl h0
          · right
            have hle : ((m + 1 : ℕ) : ℤ) ≤ ((k + 1 : ℕ) : ℤ) * (m : ℤ) := by
              have hk1 : 1 ≤ k := Nat.pos_of_ne_zero hk0
              push_cast
              nlinarith
            exact le_trans hle hge
        have hmul := hval_mul_ge_L ((m + 1 : ℕ) : ℤ) 0
          (x ^ (k + 1)) (p.choose (k + 1) : L) hx_pow' (hres_nat _).1
        simpa using hmul
    rw [hunit_ge1_L (m + 1) (by omega) (u ^ p), hpow_sub]
    rcases hsum_val with h0 | hge
    · left
      exact sub_eq_zero.mp (hpow_sub.trans h0)
    · exact Or.inr hge

  
  have hb_ge2 : 2 ≤ condExp F L ν₁ := by
    by_contra hlt
    have hc1 : condExp F L ν₁ = 1 := by omega
    have htriv1 : ∀ w ∈ unitGroup F L 1, ν₁ w = 1 := by
      intro w hw
      have h := hν₁_cond 1 hp_gt1 w
      rw [pow_one ν₁, hc1] at h
      exact h hw
    have htriv0 : ∀ u ∈ unitGroup F L 0, ν₁ u = 1 := by
      intro u hu
      have hu_val : valL F L (u : L) = 0 := (hunit0_L u).mp hu
      obtain ⟨s, hs_val, hdiff⟩ := hfrob_surj (u : L) (Or.inr (by omega))
      have hs_not_ge1 : ¬ (s = 0 ∨ 1 ≤ valL F L s) := by
        intro hs1
        have hsp_ge1 : s ^ p = 0 ∨ 1 ≤ valL F L (s ^ p) := by
          have h := hval_pow_ge_L p 1 s hs1
          rcases h with h0 | hge
          · exact Or.inl h0
          · right
            omega
        have hu_ge1 := hval_add_L 1 ((u : L) - s ^ p) (s ^ p) hdiff hsp_ge1
        rw [sub_add_cancel] at hu_ge1
        rcases hu_ge1 with hu0 | huge1
        · exact Units.ne_zero u hu0
        · omega
      have hs_ne0 : s ≠ 0 := fun h0 => hs_not_ge1 (Or.inl h0)
      have hs_val0 : valL F L s = 0 := by
        have hge0 := hs_val.resolve_left hs_ne0
        have hnot1 : ¬ (1 ≤ valL F L s) := fun h1 => hs_not_ge1 (Or.inr h1)
        omega
      let v_s : Lˣ := Units.mk0 s hs_ne0
      have hvs_pow_inv_val : valL F L ((((v_s ^ p)⁻¹ : Lˣ) : L)) = 0 := by
        rw [hval_inv_L (v_s ^ p), Units.val_pow_eq_pow_val, hval_pow_L (v_s : L) p (Units.ne_zero v_s)]
        change - ((p : ℤ) * valL F L s) = 0
        rw [hs_val0, mul_zero, neg_zero]
      let w : Lˣ := u * (v_s ^ p)⁻¹
      have hw_sub : (w : L) - 1 = ((u : L) - s ^ p) * ((((v_s ^ p)⁻¹ : Lˣ) : L)) := by
        change (u : L) * ((((v_s ^ p)⁻¹ : Lˣ) : L)) - 1 =
          ((u : L) - ((v_s ^ p : Lˣ) : L)) * ((((v_s ^ p)⁻¹ : Lˣ) : L))
        rw [sub_mul, Units.mul_inv]
      have hw_mem1 : w ∈ unitGroup F L 1 := by
        rw [hunit_ge1_L 1 le_rfl w]
        have hmul := hval_mul_ge_L 1 0 ((u : L) - s ^ p) ((((v_s ^ p)⁻¹ : Lˣ) : L))
          hdiff (Or.inr (by omega))
        rw [add_zero, ← hw_sub] at hmul
        rcases hmul with h0 | hge
        · exact Or.inl (sub_eq_zero.mp h0)
        · exact Or.inr hge
      have hu_eq : u = w * (v_s ^ p) := by
        dsimp [w]
        rw [inv_mul_cancel_right]
      rw [hu_eq, map_mul, htriv1 w hw_mem1, one_mul, map_pow, ← MonoidHom.pow_apply,
        hν₁_pow, MonoidHom.one_apply]
    have hc0 : condExp F L ν₁ ≤ 0 := Nat.sInf_le htriv0
    exact hRam (Nat.eq_zero_of_le_zero hc0)

  have hν_cond_eq : ∀ j < p, 0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁ := by
    intro j hj_lt hj_pos
    have hcop_j : Nat.Coprime p j :=
      (Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt hj_pos hj_lt)
    have hiff : ∀ u : Lˣ, (ν₁ ^ j) u = 1 ↔ ν₁ u = 1 := by
      intro u
      refine ⟨fun hj1 => ?_, fun h1 => by rw [MonoidHom.pow_apply, h1, one_pow]⟩
      have hp1 : (ν₁ u) ^ p = 1 := by
        rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
      have hj1' : (ν₁ u) ^ j = 1 := by
        rwa [← MonoidHom.pow_apply]
      have hgcd := (pow_gcd_eq_one (a := ν₁ u) (m := p) (n := j)).mpr ⟨hp1, hj1'⟩
      rwa [hcop_j.gcd_eq_one, pow_one] at hgcd
    unfold condExp
    congr 1
    ext a
    simp only [Set.mem_setOf_eq, hiff]

  have hroot_exh : ∀ u₁ : Lˣ, ν₁ u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ, ξ ^ p = 1 →
      ∃ k < p, (ν₁ u₁) ^ k = ξ := by
    intro u₁ hu₁_ne ξ hξ
    set ζ : (Ω F)ˣ := ν₁ u₁
    have hζ_pow : ζ ^ p = 1 := by
      dsimp [ζ]
      rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
    have hord : orderOf ζ = p := orderOf_eq_prime hζ_pow hu₁_ne
    let ϕ : Fin p → Ω F := fun i => ((ζ ^ (i : ℕ) : (Ω F)ˣ) : Ω F)
    have hpow_inj_le : ∀ {a b : ℕ}, a ≤ b → b < p → ζ ^ a = ζ ^ b → a = b := by
      intro a b hab hb heq
      have hsub : ζ ^ (b - a) * ζ ^ a = 1 * ζ ^ a := by
        rw [← pow_add, Nat.sub_add_cancel hab, one_mul, heq]
      have hpow_sub : ζ ^ (b - a) = 1 := mul_right_cancel hsub
      have hdvd : p ∣ b - a := by
        rw [← hord]
        exact orderOf_dvd_iff_pow_eq_one.mpr hpow_sub
      have hlt : b - a < p := by omega
      have hzero : b - a = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      omega
    have hϕ_inj : Function.Injective ϕ := by
      intro i j hij
      have hζ_ij : ζ ^ (i : ℕ) = ζ ^ (j : ℕ) := Units.ext hij
      rcases le_total (i : ℕ) (j : ℕ) with hle | hle
      · exact Fin.ext (hpow_inj_le hle j.2 hζ_ij)
      · exact Fin.ext (hpow_inj_le hle i.2 hζ_ij.symm).symm
    let P : Polynomial (Ω F) := Polynomial.X ^ p - Polynomial.C 1
    have hP_ne : P ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hp_pos 1
    have hP_deg : P.natDegree = p := Polynomial.natDegree_X_pow_sub_C
    let S_img : Finset (Ω F) := (Finset.univ : Finset (Fin p)).image ϕ
    let R_fin : Finset (Ω F) := P.roots.toFinset
    have hsub_roots : S_img ⊆ R_fin := by
      intro z hz
      rcases Finset.mem_image.mp hz with ⟨i, _, rfl⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P, ϕ]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← pow_mul, mul_comm (i : ℕ) p, pow_mul, ← Units.val_pow_eq_pow_val,
        hζ_pow, Units.val_one, one_pow]
    have hcard_le : R_fin.card ≤ S_img.card := by
      calc R_fin.card
        _ ≤ P.roots.card := Multiset.toFinset_card_le P.roots
        _ ≤ P.natDegree := Polynomial.card_roots' P
        _ = p := hP_deg
        _ = (Finset.univ : Finset (Fin p)).card := (Fintype.card_fin p).symm
        _ = S_img.card := (Finset.card_image_of_injective _ hϕ_inj).symm
    have hS_eq_R : S_img = R_fin := Finset.eq_of_subset_of_card_le hsub_roots hcard_le
    have hξ_mem : (ξ : Ω F) ∈ R_fin := by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← Units.val_pow_eq_pow_val, hξ, Units.val_one]
    rw [← hS_eq_R] at hξ_mem
    rcases Finset.mem_image.mp hξ_mem with ⟨i, _, hi⟩
    exact ⟨i.1, i.2, Units.ext hi⟩

  have hex_u0 : ∃ u₀ ∈ unitGroup F L 0, ν₁ u₀ ≠ 1 := by
    by_contra h_all
    push_neg at h_all
    have hc0 : condExp F L ν₁ ≤ 0 := Nat.sInf_le h_all
    exact hRam (Nat.eq_zero_of_le_zero hc0)
  obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := hex_u0
  obtain ⟨ϖ₀, hϖ₀⟩ := hval_surj_L 1
  have hν₁_ϖ₀_pow : (ν₁ ϖ₀) ^ p = 1 := by
    rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
  obtain ⟨k₀, _, hk₀⟩ := hroot_exh u₀ hu₀_ne (ν₁ ϖ₀) hν₁_ϖ₀_pow
  let ϖ_L : Lˣ := ϖ₀ * (u₀ ^ k₀)⁻¹
  have hϖ_L : valL F L (ϖ_L : L) = 1 := by
    have hu₀_val : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀_mem
    change valL F L (((ϖ₀ * (u₀ ^ k₀)⁻¹ : Lˣ) : L)) = 1
    rw [Units.val_mul, hval_mul_L (ϖ₀ : L) _ (Units.ne_zero ϖ₀) (Units.ne_zero _),
      hval_inv_L (u₀ ^ k₀), Units.val_pow_eq_pow_val, hval_pow_L (u₀ : L) k₀ (Units.ne_zero u₀),
      hϖ₀, hu₀_val, mul_zero, neg_zero, add_zero]
  have hν₁_ϖ_L : ν₁ ϖ_L = 1 := by
    dsimp [ϖ_L]
    rw [map_mul, map_inv, map_pow, hk₀, mul_inv_cancel]
  obtain ⟨ϖ_K, hϖ_norm⟩ := (hν₁_ker ϖ_L).mpr hν₁_ϖ_L

  
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q_z : ℤ := valL F M z
      set r_z : ℤ := relVal F M z % f
      have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
          linarith
        let k : ℕ := r_z.toNat
        have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hval_surj_L
  obtain ⟨hresDeg_K_pos, hdiv_K⟩ := hrelVal_div K hval_surj_K
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hresDeg_L_pos)

  let eF : K ≃ₐ[F] K' :=
    { toExtendScalars F hLK with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K' := Module.Finite.equiv eF.toLinearEquiv
  haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'

  have hrelVal_norm : ∀ y : K, relVal F L (normLM F hLK y) = relVal F K y := by
    intro y
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y))) =
      addVal F (Algebra.norm F y)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y)) =
        Algebra.norm F (toExtendScalars F hLK y) := Algebra.norm_norm
    have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hLK y) :=
      Algebra.norm_eq_of_algEquiv eF y
    rw [h1, ← h2]

  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ p := by
    intro x
    change Algebra.norm L (algebraMap L K' x) = x ^ p
    exact Algebra.norm_algebraMap x

  have hResDeg : resDeg F K = resDeg F L := by
    apply le_antisymm
    · have hcoe : normLM F hLK (ϖ_K : K) = (ϖ_L : L) := congrArg Units.val hϖ_norm
      have hrel_lift : relVal F K (ϖ_K : K) = (resDeg F L : ℤ) := by
        rw [← hrelVal_norm (ϖ_K : K), hcoe, hdiv_L (ϖ_L : L), hϖ_L, mul_one]
      have hmem : resDeg F L ∈ {k : ℕ | 0 < k ∧ ∃ y : K, y ≠ 0 ∧ relVal F K y = (k : ℤ)} :=
        ⟨hresDeg_L_pos, (ϖ_K : K), Units.ne_zero ϖ_K, hrel_lift⟩
      exact Nat.sInf_le hmem
    · obtain ⟨c₁, hc₁⟩ := hval_surj_K 1
      have hrel_c₁ : (resDeg F K : ℤ) =
          (resDeg F L : ℤ) * valL F L (normLM F hLK (c₁ : K)) := by
        calc (resDeg F K : ℤ)
          _ = (resDeg F K : ℤ) * valL F K (c₁ : K) := by rw [hc₁, mul_one]
          _ = relVal F K (c₁ : K) := (hdiv_K (c₁ : K)).symm
          _ = relVal F L (normLM F hLK (c₁ : K)) := (hrelVal_norm (c₁ : K)).symm
          _ = (resDeg F L : ℤ) * valL F L (normLM F hLK (c₁ : K)) := hdiv_L _
      have hdvd_int : (resDeg F L : ℤ) ∣ (resDeg F K : ℤ) := ⟨_, hrel_c₁⟩
      have hdvd_nat : resDeg F L ∣ resDeg F K := Int.ofNat_dvd.mp hdvd_int
      exact Nat.le_of_dvd hresDeg_K_pos hdvd_nat

  have hqK : qL F K = qL F L := by
    unfold qL
    rw [hResDeg]

  have hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y := by
    intro y
    apply mul_left_cancel₀ hfL_int_ne
    calc (resDeg F L : ℤ) * valL F L (normLM F hLK y)
      _ = relVal F L (normLM F hLK y) := (hdiv_L (normLM F hLK y)).symm
      _ = relVal F K y := hrelVal_norm y
      _ = (resDeg F K : ℤ) * valL F K y := hdiv_K y
      _ = (resDeg F L : ℤ) * valL F K y := by rw [hResDeg]

  have hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) = (p : ℤ) * valL F L x := by
    intro x
    by_cases hx0 : x = 0
    · rw [hx0, map_zero, hval0_K, hval0_L, mul_zero]
    · rw [← hval_norm (IntermediateField.inclusion hLK x), hnorm_inc x, hval_pow_L x p hx0]

  have hϖ_K : valL F K (ϖ_K : K) = 1 := by
    have hcoe : normLM F hLK (ϖ_K : K) = (ϖ_L : L) := congrArg Units.val hϖ_norm
    rw [← hval_norm (ϖ_K : K), hcoe, hϖ_L]

  have hval_strict_K : ∀ (y₁ y₂ : K),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F K y₁ + 1 ≤ valL F K y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F K (y₁ + y₂) = valL F K y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F K y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F K y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F K (y₁ + y₂) :=
      hval_add_K v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F K (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F K (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_K]
          exact hge
      have hy₁_gt := hval_add_K (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  let t_term (c : Fin p → L) (i : Fin p) : K :=
    IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ))
  let v_term (c : Fin p → L) (i : Fin p) : ℤ :=
    (p : ℤ) * valL F L (c i) + (i.1 : ℤ)

  have ht_term_zero : ∀ (c : Fin p → L) (i : Fin p), c i = 0 → t_term c i = 0 := by
    intro c i hci
    dsimp [t_term]
    rw [hci, map_zero, zero_mul]

  have ht_term_nz : ∀ (c : Fin p → L) (i : Fin p),
      c i ≠ 0 → t_term c i ≠ 0 ∧ valL F K (t_term c i) = v_term c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hLK (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hci
    have hpow_ne : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term, v_term]
    rw [hval_mul_K _ _ hinc_ne hpow_ne, hval_alg (c i),
      hval_pow_K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_one]

  have hv_term_inj : ∀ (c : Fin p → L) (i j : Fin p),
      v_term c i = v_term c j → i = j := by
    intro c i j hij
    have hmod : ∀ k : Fin p, v_term c k % (p : ℤ) = (k.1 : ℤ) := by
      intro k
      dsimp [v_term]
      have hcomm : (p : ℤ) * valL F L (c k) + (k.1 : ℤ) =
          (k.1 : ℤ) + (p : ℤ) * valL F L (c k) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_ge : ∀ (c : Fin p → L) (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term c i) →
        ((∑ i ∈ S, t_term c i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, t_term c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term c a = 0 ∨ m ≤ valL F K (t_term c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_zero c a hca)
        · right
          rw [(ht_term_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K m (t_term c a) (∑ i ∈ s, t_term c i) ha_t hs_t

  have hsum_min_nz : ∀ (c : Fin p → L) (i : Fin p),
      c i ≠ 0 →
        ∃ i₀ : Fin p, c i₀ ≠ 0 ∧ v_term c i₀ ≤ v_term c i ∧
          (∑ j : Fin p, t_term c j) ≠ 0 ∧
          valL F K (∑ j : Fin p, t_term c j) = v_term c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin p) := (Finset.univ : Finset (Fin p)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term c i₀ ≤ v_term c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
        c j = 0 ∨ v_term c i₀ + 1 ≤ v_term c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term c i₀ ≤ v_term c j := hi₀_min j hj_mem
        have hne_v : v_term c i₀ ≠ v_term c j := fun heq => hj_ne (hv_term_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_ge c ((Finset.univ : Finset (Fin p)).erase i₀)
      (v_term c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_K (t_term c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hval_sum_iff : ∀ (c : Fin p → L) (m : ℤ),
      ((∑ i : Fin p, t_term c i) = 0 ∨ m ≤ valL F K (∑ i : Fin p, t_term c i)) ↔
        ∀ i : Fin p, c i = 0 ∨ m ≤ v_term c i := by
    intro c m
    refine ⟨?_, fun hall => hval_sum_ge c Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hci : c i = 0
    · exact Or.inl hci
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_nz c i hci
      have hm_le : m ≤ valL F K (∑ j : Fin p, t_term c j) := hsum.resolve_left hsum_ne
      omega

  have hlin_zero : ∀ (c : Fin p → L),
      (∑ i : Fin p, t_term c i) = 0 → ∀ i : Fin p, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_nz c i hci
    exact hsum_ne hsum0

  let b_vec : Fin p → K' := fun i => (toExtendScalars F hLK (ϖ_K : K)) ^ (i : ℕ)
  have hli : LinearIndependent L b_vec := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hLK (∑ i : Fin p, t_term c i) =
        ∑ i : Fin p, c i • b_vec i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term, b_vec]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin p, t_term c i) = 0 := by
      apply eF.injective
      change toExtendScalars F hLK (∑ i : Fin p, t_term c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero c hsum0

  haveI : Nonempty (Fin p) := ⟨⟨0, hp_pos⟩⟩
  have hcard : Fintype.card (Fin p) = Module.finrank L K' := Fintype.card_fin p
  let B : Module.Basis (Fin p) L K' := basisOfLinearIndependentOfCardEqFinrank hli hcard

  have hBasis : ∀ y : K, ∃ c : Fin p → L,
      y = ∑ i : Fin p, IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F L (c i) + (i : ℤ) := by
    intro y
    let c : Fin p → L := fun i => B.repr (toExtendScalars F hLK y) i
    have hy_eq : y = ∑ i : Fin p, t_term c i := by
      apply eF.injective
      change toExtendScalars F hLK y = toExtendScalars F hLK (∑ i : Fin p, t_term c i)
      have hrepr := (B.sum_repr (toExtendScalars F hLK y)).symm
      rw [hrepr, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [B, c, t_term, b_vec]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli hcard, map_mul, map_pow]
      rfl
    refine ⟨c, hy_eq, fun m => ?_⟩
    rw [hy_eq]
    exact hval_sum_iff c m

  exact ⟨hb_ge2, hν_cond_eq, hqK, hval_norm, hval_alg, hfrob_surj, hunit_pow_p, hroot_exh,
    ϖ_K, ϖ_L, hϖ_norm, hϖ_K, hϖ_L, hBasis⟩

theorem ld_wild_galois_aut_and_ramification_jump (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (haddVal1 : addVal F 1 = 0)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → K → K)
      (t : ℕ) (w_star : Kˣ),
      Fintype.card G = p ∧
      (∀ y : K, act 1 y = y) ∧
      (∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y)) ∧
      (∀ σ : G,
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ y₁ y₂ : K,
          act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
          act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
          act σ (-y₁) = -act σ y₁)) ∧
      (∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
        IntermediateField.inclusion hLK x) ∧
      (∀ σ : G, (∀ y : K, act σ y = y) → σ = 1) ∧
      (∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y) ∧
      (∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y) ∧
      (∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y) ∧
      1 ≤ t ∧
      w_star ∈ unitGroup F K t ∧
      w_star ∉ unitGroup F K (t + 1) ∧
      Units.map (normLM F hLK) w_star = 1 ∧
      (∀ τ : G, τ ≠ 1 →
        (ϖ_K : K) - act τ (ϖ_K : K) ≠ 0 ∧
        valL F K ((ϖ_K : K) - act τ (ϖ_K : K)) = (t + 1 : ℤ)) :=
by
  
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, hval_surj_K, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  set p := Module.finrank L K'
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_int_pos : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
  have hp_int_ne : (p : ℤ) ≠ 0 := ne_of_gt hp_int_pos

  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_pow_K : ∀ (y : K) (n : ℕ), y ≠ 0 → valL F K (y ^ n) = (n : ℤ) * valL F K y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_mul_ge_K : ∀ (k₁ k₂ : ℤ) (x y : K),
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F K x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F K y := hy.resolve_left hy0
        rw [hval_mul_K x y hx0 hy0]
        omega
  have hval_pow_ge_L : ∀ (n : ℕ) (m : ℤ) (x : L),
      (x = 0 ∨ m ≤ valL F L x) → (x ^ n = 0 ∨ (n : ℤ) * m ≤ valL F L (x ^ n)) := by
    intro n m x hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hval1_L]
      simp
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge_L ((n : ℤ) * m) m (x ^ n) x ih hx
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * m = (n : ℤ) * m + m := by push_cast; ring
        rw [heq]
        exact hge
  have hval_finset_sum_L : ∀ (S : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_L k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hval_finset_sum_K : ∀ {ι : Type} [DecidableEq ι] (S : Finset ι) (f : ι → K) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ S, f i)) := by
    intro ι _ S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K k (f a) (∑ i ∈ s, f i) ha_val hs_val

  
  have hFinLK' : FiniteDimensional L K' := by
    haveI : FiniteDimensional F K' := ‹FiniteDimensional F K›
    haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F L K'
  haveI : FiniteDimensional L K' := hFinLK'
  have hGalLK' : IsGalois L ↥K' := by
    have hSepLK' : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    haveI : Algebra.IsSeparable L K' := hSepLK'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
    exact helper_isGalois L (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois L ↥K' := hGalLK'
  let G : Type u := (K' ≃ₐ[L] K')

  
  have hcard_G : Fintype.card G = p :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank L K')
  let fromExtendScalars : K' →+* K :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLK).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → K → K := fun σ y => fromExtendScalars (σ (toExtendScalars F hLK y))
  let φ : G → (K →+* K) := fun σ =>
    fromExtendScalars.comp (σ.toRingHom.comp (toExtendScalars F hLK))
  have hφ_apply : ∀ (σ : G) (y : K), φ σ y = act σ y := fun _ _ => rfl
  have hact_one : ∀ y : K, act 1 y = y := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun y₁ y₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x := by
    intro σ x
    change fromExtendScalars (σ (algebraMap L K' x)) = IntermediateField.inclusion hLK x
    rw [σ.commutes x]
    rfl
  have hact_faithful : ∀ σ : G, (∀ y : K, act σ y = y) → σ = 1 := by
    intro σ h
    apply AlgEquiv.ext
    intro z
    exact congrArg (toExtendScalars F hLK) (h (fromExtendScalars z))

  
  have hact_trace : ∀ y : K,
      IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := L) (L := K') (toExtendScalars F hLK y))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hLK y)) Finset.univ)
  have hact_norm : ∀ y : K,
      IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLK y))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hLK y)) Finset.univ)
  have hinj : Function.Injective (IntermediateField.inclusion hLK) :=
    (IntermediateField.inclusion hLK).injective
  have hnorm_act : ∀ (σ : G) (y : K), normLM F hLK (act σ y) = normLM F hLK y := by
    intro σ y
    apply hinj
    rw [hact_norm (act σ y), hact_norm y]
    have hmul : (∏ τ : G, act τ (act σ y)) = ∏ τ : G, act (τ * σ) y := by
      refine Finset.prod_congr rfl fun τ _ => ?_
      rw [hact_mul]
    rw [hmul]
    exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => act τ y)
  have hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y := by
    intro σ y
    rw [← hval_norm (act σ y), hnorm_act σ y, hval_norm y]

  
  set π : K := (ϖ_K : K)
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_K
  have hπ_val : valL F K π = 1 := hϖ_K
  have hπ_faithful : ∀ τ : G, act τ π = π → τ = 1 := by
    intro τ hτ
    apply hact_faithful τ
    intro y
    obtain ⟨c, hy_eq, _⟩ := hBasis y
    have h1 : act τ y = φ τ y := rfl
    rw [h1, hy_eq, map_sum (φ τ)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul (φ τ), map_pow (φ τ), hφ_apply, hact_incl τ (c i), hφ_apply, hτ]
  have hπ_diff_ne0 : ∀ τ : G, τ ≠ 1 → act τ π - π ≠ 0 ∧ π - act τ π ≠ 0 := by
    intro τ hτ
    have hne : act τ π ≠ π := fun h => hτ (hπ_faithful τ h)
    exact ⟨sub_ne_zero.mpr hne, sub_ne_zero.mpr (Ne.symm hne)⟩

  have hterm_val : ∀ (a : L) (i : ℕ) (m : ℤ),
      (a = 0 ∨ m ≤ (p : ℤ) * valL F L a + (i : ℤ)) →
      (IntermediateField.inclusion hLK a * (π ^ i) = 0 ∨
        m ≤ valL F K (IntermediateField.inclusion hLK a * (π ^ i))) := by
    intro a i m ha
    rcases ha with rfl | hge
    · left
      rw [map_zero, zero_mul]
    · by_cases ha0 : a = 0
      · left
        rw [ha0, map_zero, zero_mul]
      · right
        have hincl_ne0 : IntermediateField.inclusion hLK a ≠ 0 :=
          (map_ne_zero_iff (IntermediateField.inclusion hLK) hinj).mpr ha0
        have hpow_ne0 : π ^ i ≠ 0 := pow_ne_zero i hπ_ne0
        rw [hval_mul_K _ _ hincl_ne0 hpow_ne0, hval_alg a, hval_pow_K π i hπ_ne0, hπ_val, mul_one]
        exact hge

  
  have hp_valL : (p : L) = 0 ∨ 1 ≤ valL F L (p : L) := by
    let φ_iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] (p : 𝒪[F]) = 0 := by
      rw [hEqP, map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (EllipticRootNumber.p F)
    have hker : valuation F ((p : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    have hpF : (p : F) = 0 ∨ 1 ≤ addVal F (p : F) := by
      by_cases hp0 : (p : F) = 0
      · exact Or.inl hp0
      · right
        have hφp : φ_iso (valuation F (p : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
        have hlt : φ_iso (valuation F (p : F)) < 1 := by
          rw [← map_one φ_iso, map_lt_map_iff φ_iso]
          exact hker
        rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
          ← Multiplicative.toAdd_lt, toAdd_one] at hlt
        unfold addVal
        rw [dif_neg hp0]
        omega
    have halg_p := halg1 (p : F) hpF
    rwa [map_natCast (algebraMap F L) p] at halg_p

  have hnat_valL : ∀ n : ℕ, (n : L) = 0 ∨ 0 ≤ valL F L (n : L) := by
    intro n
    induction n with
    | zero => exact Or.inl Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_L 0 (n : L) 1 ih (Or.inr (by rw [hval1_L]))

  have hchoose_valL : ∀ k : ℕ, 0 < k → k < p →
      (p.choose k : L) = 0 ∨ 1 ≤ valL F L (p.choose k : L) := by
    intro k hk0 hkp
    obtain ⟨m, hm⟩ := Nat.Prime.dvd_choose_self hPrime (ne_of_gt hk0) hkp
    rw [hm, Nat.cast_mul]
    simpa using hval_mul_ge_L 1 0 (p : L) (m : L) hp_valL (hnat_valL m)

  have hjump_ge2 : ∀ τ : G, τ ≠ 1 → 2 ≤ valL F K (act τ π - π) := by
    intro τ hτ
    let i₁ : Fin p := ⟨1, hp_gt1⟩
    obtain ⟨c, hτπ_eq, hτπ_val_iff⟩ := hBasis (act τ π)
    have hci_1 : ∀ i : Fin p, c i = 0 ∨ 1 ≤ (p : ℤ) * valL F L (c i) + (i : ℤ) :=
      (hτπ_val_iff 1).mp (Or.inr (by rw [hact_val τ π, hπ_val]))
    have hc1_int : c i₁ = 0 ∨ 0 ≤ valL F L (c i₁) := by
      rcases hci_1 i₁ with h0 | hge
      · exact Or.inl h0
      · right
        change 1 ≤ (p : ℤ) * valL F L (c i₁) + 1 at hge
        nlinarith
    let r₁ : K := act τ π - IntermediateField.inclusion hLK (c i₁) * π
    have hr₁_eq : r₁ = ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₁,
        IntermediateField.inclusion hLK (c i) * (π ^ (i : ℕ)) := by
      have hsplit := Finset.add_sum_erase (Finset.univ : Finset (Fin p))
        (fun i : Fin p => IntermediateField.inclusion hLK (c i) * (π ^ (i : ℕ)))
        (Finset.mem_univ i₁)
      have hi1_term : IntermediateField.inclusion hLK (c i₁) * (π ^ (i₁ : ℕ)) =
          IntermediateField.inclusion hLK (c i₁) * π := by
        change IntermediateField.inclusion hLK (c i₁) * (π ^ 1) = _
        rw [pow_one]
      dsimp only at hsplit
      dsimp [r₁]
      rw [hτπ_eq, ← hsplit, hi1_term]
      ring
    have hr₁_val : r₁ = 0 ∨ 2 ≤ valL F K r₁ := by
      rw [hr₁_eq]
      apply hval_finset_sum_K ((Finset.univ : Finset (Fin p)).erase i₁) _ 2
      intro i hi
      have hi_ne : i ≠ i₁ := Finset.ne_of_mem_erase hi
      have hi_val_ne1 : (i : ℕ) ≠ 1 := fun h => hi_ne (Fin.ext h)
      have hi_lt_p : (i : ℕ) < p := i.2
      apply hterm_val (c i) (i : ℕ) 2
      rcases hci_1 i with h0 | hge
      · exact Or.inl h0
      · right
        have hp_int_ge2 : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
        by_cases hi0 : (i : ℕ) = 0
        · rw [hi0, Nat.cast_zero, add_zero] at hge ⊢
          have hv1 : 1 ≤ valL F L (c i) := by
            by_contra hlt
            have hv_le : valL F L (c i) ≤ 0 := by omega
            nlinarith
          nlinarith
        · have hi_ge2 : 2 ≤ (i : ℕ) := by omega
          have hi_int_ge2 : (2 : ℤ) ≤ ((i : ℕ) : ℤ) := by exact_mod_cast hi_ge2
          have hi_int_lt_p : ((i : ℕ) : ℤ) < (p : ℤ) := by exact_mod_cast hi_lt_p
          have hv0 : 0 ≤ valL F L (c i) := by
            by_contra hlt
            have hv_le : valL F L (c i) ≤ -1 := by omega
            nlinarith
          nlinarith

    let d : ℕ → K := fun k => act (τ ^ k) π - IntermediateField.inclusion hLK ((c i₁) ^ k) * π
    have hd_val : ∀ k : ℕ, d k = 0 ∨ 2 ≤ valL F K (d k) := by
      intro k
      induction k with
      | zero =>
        left
        dsimp [d]
        rw [pow_zero, pow_zero, hact_one, map_one, one_mul, sub_self]
      | succ k ih =>
        have hd_step : d (k + 1) =
            act τ (d k) + IntermediateField.inclusion hLK ((c i₁) ^ k) * r₁ := by
          dsimp [d, r₁]
          rw [pow_succ' τ k, hact_mul, pow_succ (c i₁) k]
          have hsub : act τ (act (τ ^ k) π - IntermediateField.inclusion hLK ((c i₁) ^ k) * π) =
              act τ (act (τ ^ k) π) - act τ (IntermediateField.inclusion hLK ((c i₁) ^ k) * π) :=
            map_sub (φ τ) _ _
          rw [hsub, (hact_ring τ).2.2 _ _ |>.2.1, hact_incl τ ((c i₁) ^ k), map_mul]
          ring
        have hterm1 : act τ (d k) = 0 ∨ 2 ≤ valL F K (act τ (d k)) := by
          rcases ih with h0 | hge
          · left
            rw [h0, (hact_ring τ).1]
          · right
            rw [hact_val τ (d k)]
            exact hge
        have hck_val : IntermediateField.inclusion hLK ((c i₁) ^ k) = 0 ∨
            0 ≤ valL F K (IntermediateField.inclusion hLK ((c i₁) ^ k)) := by
          rcases hval_pow_ge_L k 0 (c i₁) hc1_int with h0 | hge
          · left
            rw [h0, map_zero]
          · right
            rw [hval_alg ((c i₁) ^ k)]
            nlinarith
        have hterm2 : IntermediateField.inclusion hLK ((c i₁) ^ k) * r₁ = 0 ∨
            2 ≤ valL F K (IntermediateField.inclusion hLK ((c i₁) ^ k) * r₁) := by
          simpa using hval_mul_ge_K 0 2 _ r₁ hck_val hr₁_val
        rw [hd_step]
        exact hval_add_K 2 _ _ hterm1 hterm2

    have hτ_pow : τ ^ p = 1 := by
      rw [← hcard_G]
      exact pow_card_eq_one
    have hdp_eq : d p = IntermediateField.inclusion hLK (1 - (c i₁) ^ p) * π := by
      dsimp [d]
      rw [hτ_pow, hact_one, map_sub, map_one]
      ring
    have hc1_pow_sub : (c i₁) ^ p - 1 = 0 ∨ 1 ≤ valL F L ((c i₁) ^ p - 1) := by
      by_cases h0 : (c i₁) ^ p - 1 = 0
      · exact Or.inl h0
      · right
        have h1_sub_ne0 : 1 - (c i₁) ^ p ≠ 0 := by
          intro h10
          apply h0
          linear_combination -h10
        have hincl_ne0 : IntermediateField.inclusion hLK (1 - (c i₁) ^ p) ≠ 0 :=
          (map_ne_zero_iff (IntermediateField.inclusion hLK) hinj).mpr h1_sub_ne0
        have hdp_ne0 : d p ≠ 0 := by
          rw [hdp_eq]
          exact mul_ne_zero hincl_ne0 hπ_ne0
        have hge2 : 2 ≤ valL F K (d p) := (hd_val p).resolve_left hdp_ne0
        rw [hdp_eq, hval_mul_K _ π hincl_ne0 hπ_ne0, hval_alg (1 - (c i₁) ^ p), hπ_val] at hge2
        have hneg_eq : 1 - (c i₁) ^ p = -((c i₁) ^ p - 1) := by ring
        rw [hneg_eq, hval_neg_L] at hge2
        nlinarith

    let a : L := c i₁ - 1
    have ha_int : a = 0 ∨ 0 ≤ valL F L a := by
      dsimp [a]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 (c i₁) (-1) hc1_int (Or.inr (by rw [hval_neg1_L]))
    have hp_eq : p + 1 = (p - 1) + 1 + 1 := by omega
    have hp1 : (p - 1) + 1 = p := by omega
    have hbinom : a ^ p = ((c i₁) ^ p - 1) -
        ∑ k ∈ Finset.range (p - 1), a ^ (k + 1) * (p.choose (k + 1) : L) := by
      have hc_eq : c i₁ = a + 1 := by dsimp [a]; ring
      have hpow := add_pow a 1 p
      rw [← hc_eq, hp_eq, Finset.sum_range_succ, Finset.sum_range_succ'] at hpow
      simp only [hp1, Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one,
        Nat.sub_zero, one_pow, mul_one, Nat.choose_zero_right, Nat.cast_one] at hpow
      linear_combination -hpow
    have hsum_val1 : (∑ k ∈ Finset.range (p - 1), a ^ (k + 1) * (p.choose (k + 1) : L)) = 0 ∨
        1 ≤ valL F L (∑ k ∈ Finset.range (p - 1), a ^ (k + 1) * (p.choose (k + 1) : L)) := by
      apply hval_finset_sum_L (Finset.range (p - 1)) _ 1
      intro k hk
      have hlt : k < p - 1 := Finset.mem_range.mp hk
      have hak_int : a ^ (k + 1) = 0 ∨ 0 ≤ valL F L (a ^ (k + 1)) := by
        simpa using hval_pow_ge_L (k + 1) 0 a ha_int
      have hchk_val := hchoose_valL (k + 1) (by omega) (by omega)
      simpa using hval_mul_ge_L 0 1 (a ^ (k + 1)) (p.choose (k + 1) : L) hak_int hchk_val
    have hneg_sum_val1 :
        -(∑ k ∈ Finset.range (p - 1), a ^ (k + 1) * (p.choose (k + 1) : L)) = 0 ∨
        1 ≤ valL F L (-(∑ k ∈ Finset.range (p - 1), a ^ (k + 1) * (p.choose (k + 1) : L))) := by
      rcases hsum_val1 with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right
        rw [hval_neg_L]
        exact hge
    have hap_val1 : a ^ p = 0 ∨ 1 ≤ valL F L (a ^ p) := by
      rw [hbinom, sub_eq_add_neg]
      exact hval_add_L 1 ((c i₁) ^ p - 1) _ hc1_pow_sub hneg_sum_val1
    have ha_val1 : a = 0 ∨ 1 ≤ valL F L a := by
      by_cases ha0 : a = 0
      · exact Or.inl ha0
      · right
        have hap_ne0 : a ^ p ≠ 0 := pow_ne_zero p ha0
        have hge1 : 1 ≤ valL F L (a ^ p) := hap_val1.resolve_left hap_ne0
        rw [hval_pow_L a p ha0] at hge1
        nlinarith
    have ha_π_val : IntermediateField.inclusion hLK a * π = 0 ∨
        2 ≤ valL F K (IntermediateField.inclusion hLK a * π) := by
      have h := hterm_val a 1 2 (by
        rcases ha_val1 with h0 | hge
        · exact Or.inl h0
        · right
          nlinarith)
      simpa [pow_one] using h
    have hdiff_decomp : act τ π - π = IntermediateField.inclusion hLK a * π + r₁ := by
      dsimp [a, r₁]
      rw [map_sub, map_one]
      ring
    have hdiff_or : act τ π - π = 0 ∨ 2 ≤ valL F K (act τ π - π) := by
      rw [hdiff_decomp]
      exact hval_add_K 2 _ r₁ ha_π_val hr₁_val
    exact hdiff_or.resolve_left (hπ_diff_ne0 τ hτ).1

  
  have htelescope : ∀ (γ : G) (n : ℕ),
      act (γ ^ n) π - π = ∑ j ∈ Finset.range n, act (γ ^ j) (act γ π - π) := by
    intro γ n
    induction n with
    | zero =>
      rw [pow_zero, hact_one, sub_self, Finset.range_zero, Finset.sum_empty]
    | succ n ih =>
      rw [Finset.sum_range_succ, ← ih, pow_succ, hact_mul]
      have hsub : act (γ ^ n) (act γ π - π) = act (γ ^ n) (act γ π) - act (γ ^ n) π :=
        map_sub (φ (γ ^ n)) _ _
      rw [hsub]
      ring

  have hpow_val_ge : ∀ (γ : G) (n : ℕ),
      act (γ ^ n) π - π = 0 ∨ valL F K (act γ π - π) ≤ valL F K (act (γ ^ n) π - π) := by
    intro γ n
    rw [htelescope γ n]
    apply hval_finset_sum_K (Finset.range n) _ (valL F K (act γ π - π))
    intro j _
    right
    rw [hact_val (γ ^ j) (act γ π - π)]

  have hval_le_of_ne1 : ∀ (γ τ : G), γ ≠ 1 → τ ≠ 1 →
      valL F K (act γ π - π) ≤ valL F K (act τ π - π) := by
    intro γ τ hγ hτ
    have hγ_pow : γ ^ p = 1 := by
      rw [← hcard_G]
      exact pow_card_eq_one
    have hord : orderOf γ = p := orderOf_eq_prime hγ_pow hγ
    have hinj_pow : Function.Injective (fun k : Fin p => γ ^ (k : ℕ)) := by
      intro i j hij
      dsimp at hij
      have hi : (i : ℕ) ∈ Set.Iio (orderOf γ) := by
        rw [Set.mem_Iio, hord]
        exact i.2
      have hj : (j : ℕ) ∈ Set.Iio (orderOf γ) := by
        rw [Set.mem_Iio, hord]
        exact j.2
      exact Fin.ext (pow_injOn_Iio_orderOf hi hj hij)
    have hsurj_pow : Function.Surjective (fun k : Fin p => γ ^ (k : ℕ)) :=
      ((Fintype.bijective_iff_injective_and_card (fun k : Fin p => γ ^ (k : ℕ))).mpr
        ⟨hinj_pow, by rw [Fintype.card_fin, hcard_G]⟩).2
    obtain ⟨k, hk⟩ := hsurj_pow τ
    dsimp at hk
    have hge := hpow_val_ge γ (k : ℕ)
    rw [hk] at hge
    exact hge.resolve_left (hπ_diff_ne0 τ hτ).1

  have hval_const : ∀ (γ τ : G), γ ≠ 1 → τ ≠ 1 →
      valL F K (act τ π - π) = valL F K (act γ π - π) := by
    intro γ τ hγ hτ
    exact le_antisymm (hval_le_of_ne1 τ γ hτ hγ) (hval_le_of_ne1 γ τ hγ hτ)

  
  have hcard_gt1 : 1 < Fintype.card G := by
    rw [hcard_G]
    exact hp_gt1
  obtain ⟨σ, hσ⟩ := @Fintype.exists_ne_of_one_lt_card G _ hcard_gt1 1
  let v₀ : ℤ := valL F K (act σ π - π)
  have hv₀_ge2 : 2 ≤ v₀ := hjump_ge2 σ hσ
  let t : ℕ := (v₀ - 1).toNat
  have ht_ge1 : 1 ≤ t := by
    dsimp [t]
    omega
  have ht_cast : (t : ℤ) + 1 = v₀ := by
    dsimp [t]
    omega
  have hjump : ∀ τ : G, τ ≠ 1 →
      (ϖ_K : K) - act τ (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act τ (ϖ_K : K)) = (t + 1 : ℤ) := by
    intro τ hτ
    refine ⟨(hπ_diff_ne0 τ hτ).2, ?_⟩
    have hneg : (ϖ_K : K) - act τ (ϖ_K : K) = -(act τ π - π) := by
      dsimp [π]
      ring
    rw [hneg, hval_neg_K, hval_const σ τ hσ hτ]
    exact ht_cast.symm

  
  have hσπ_ne0 : act σ π ≠ 0 := by
    intro h0
    have h1 : valL F K (act σ π) = 1 := by rw [hact_val σ π, hπ_val]
    rw [h0, hval0_K] at h1
    omega
  let u_σ : Kˣ := Units.mk0 (act σ π) hσπ_ne0
  let w_star : Kˣ := u_σ * ϖ_K⁻¹
  have hw_star_sub : (w_star : K) - 1 = (act σ π - π) * ((ϖ_K⁻¹ : Kˣ) : K) := by
    have h1 : (w_star : K) = act σ π * ((ϖ_K⁻¹ : Kˣ) : K) := rfl
    rw [h1, sub_mul]
    have hinv : π * ((ϖ_K⁻¹ : Kˣ) : K) = 1 := Units.mul_inv ϖ_K
    rw [hinv]
  have hw_star_sub_ne0 : (w_star : K) - 1 ≠ 0 := by
    rw [hw_star_sub]
    exact mul_ne_zero (hπ_diff_ne0 σ hσ).1 (Units.ne_zero ϖ_K⁻¹)
  have hw_star_val_sub : valL F K ((w_star : K) - 1) = (t : ℤ) := by
    rw [hw_star_sub, hval_mul_K _ _ (hπ_diff_ne0 σ hσ).1 (Units.ne_zero ϖ_K⁻¹),
      hval_inv_K ϖ_K, hϖ_K]
    change v₀ + -1 = (t : ℤ)
    omega
  have hw_star_t : w_star ∈ unitGroup F K t := by
    rw [hunit_ge1_K t ht_ge1 w_star]
    right
    rw [hw_star_val_sub]
  have hw_star_nt1 : w_star ∉ unitGroup F K (t + 1) := by
    rw [hunit_ge1_K (t + 1) (by omega) w_star]
    rintro (h1 | hge)
    · apply hw_star_sub_ne0
      rw [h1, sub_self]
    · rw [hw_star_val_sub] at hge
      push_cast at hge
      omega
  have hw_star_norm : Units.map (normLM F hLK) w_star = 1 := by
    dsimp [w_star]
    rw [map_mul, map_inv, mul_inv_eq_one]
    apply Units.ext
    exact hnorm_act σ π

  exact ⟨G, inferInstance, inferInstance, act, t, w_star,
    hcard_G, hact_one, hact_mul, hact_ring, hact_incl, hact_faithful,
    hact_val, hact_trace, hact_norm, ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm, hjump⟩

theorem ld_wild_euler_lagrange_trace_formula (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
      IntermediateField.inclusion hLK x)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (t : ℕ)
    (hjump : ∀ τ : G, τ ≠ 1 →
      (ϖ_K : K) - act τ (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act τ (ϖ_K : K)) = (t + 1 : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    (∀ (m : ℤ) (y : K),
      (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) ∧
    (∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (p : ℤ) * valL F L x + ((p - 1 : ℕ) : ℤ) -
            ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ))) :=
by
  classical
  intro p
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  obtain ⟨hvalK_0, hvalK_1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv,
    hvalK_surj, hvalK_add, _⟩ := hvalK_props
  set π : K := (ϖ_K : K)
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_K
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun x y => ((hact_ring σ).2.2 x y).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun x y => ((hact_ring σ).2.2 x y).1 }
  have hφ_apply : ∀ (σ : G) (y : K), φ σ y = act σ y := fun _ _ => rfl
  have hval_pi_pow : ∀ k : ℕ, π ^ k ≠ 0 ∧ valL F K (π ^ k) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      refine ⟨by simp, ?_⟩
      rw [pow_zero, Nat.cast_zero, hvalK_1]
    | succ k ih =>
      refine ⟨pow_ne_zero (k + 1) hπ_ne0, ?_⟩
      rw [pow_succ, hvalK_mul (π ^ k) π ih.1 hπ_ne0, ih.2, hϖ_K]
      push_cast
      ring
  have htr_smul : ∀ (a : L) (z : K),
      traceLM F hLK (IntermediateField.inclusion hLK a * z) = a * traceLM F hLK z := by
    intro a z
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (traceLM F hLK (IntermediateField.inclusion hLK a * z)) =
      IntermediateField.inclusion hLK (a * traceLM F hLK z)
    rw [map_mul (IntermediateField.inclusion hLK), hact_trace, hact_trace, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun σ _ => ?_)
    rw [((hact_ring σ).2.2 _ _).2.1, hact_incl σ a]
  set U_G : Finset G := Finset.univ
  set S₁ : Finset G := U_G.erase 1
  set δ : K := ∏ τ ∈ S₁, (π - act τ π)
  have hprod_S : ∀ (S : Finset G), S ⊆ S₁ →
      (∏ τ ∈ S, (π - act τ π)) ≠ 0 ∧
      valL F K (∏ τ ∈ S, (π - act τ π)) = (S.card : ℤ) * (t + 1 : ℤ) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp [hvalK_1]
    | @insert a s ha ih =>
      intro hsub
      have ha_S₁ : a ∈ S₁ := hsub (Finset.mem_insert_self a s)
      have ha_ne1 : a ≠ 1 := (Finset.mem_erase.mp ha_S₁).1
      have hs_sub : s ⊆ S₁ := fun x hx => hsub (Finset.mem_insert_of_mem hx)
      obtain ⟨hs_ne0, hs_val⟩ := ih hs_sub
      obtain ⟨ha_ne0, ha_val⟩ := hjump a ha_ne1
      rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha]
      refine ⟨mul_ne_zero ha_ne0 hs_ne0, ?_⟩
      rw [hvalK_mul _ _ ha_ne0 hs_ne0, ha_val, hs_val]
      push_cast
      ring
  have hS₁_card : S₁.card = p - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ (1 : G)), Finset.card_univ, hcard_G]
  have hδ_ne0 : δ ≠ 0 := (hprod_S S₁ (Finset.Subset.refl S₁)).1
  have hδ_val : valL F K δ = ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
    have h := (hprod_S S₁ (Finset.Subset.refl S₁)).2
    rwa [hS₁_card] at h
  have hδ_inv_ne0 : δ⁻¹ ≠ 0 := inv_ne_zero hδ_ne0
  have hδ_inv_val : valL F K δ⁻¹ = - (((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) := by
    set u_δ : Kˣ := Units.mk0 δ hδ_ne0
    have h1 : δ⁻¹ = ((u_δ⁻¹ : Kˣ) : K) := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    have h2 : (u_δ : K) = δ := Units.val_mk0 hδ_ne0
    rw [h1, hvalK_inv u_δ, h2, hδ_val]
  let v : G → K := fun σ => act σ π
  have hInjOn : Set.InjOn v ↑U_G := by
    intro σ _ τ _ h_eq
    change act σ π = act τ π at h_eq
    by_contra hne
    have h_inv_ne1 : σ⁻¹ * τ ≠ 1 := by
      intro h1
      exact hne (inv_mul_eq_one.mp h1)
    have h_fix : act (σ⁻¹ * τ) π = π := by
      rw [hact_mul σ⁻¹ τ π, ← h_eq, ← hact_mul σ⁻¹ σ π, inv_mul_cancel, hact_one]
    exact (hjump (σ⁻¹ * τ) h_inv_ne1).1 (sub_eq_zero.mpr h_fix.symm)
  have hact_δ : ∀ σ : G, act σ δ = ∏ γ ∈ U_G.erase σ, (v σ - v γ) := by
    intro σ
    have hmap : act σ δ = ∏ ρ ∈ S₁, (v σ - v (σ * ρ)) := by
      change φ σ (∏ ρ ∈ S₁, (π - act ρ π)) = _
      rw [map_prod (φ σ)]
      refine Finset.prod_congr rfl (fun ρ _ => ?_)
      rw [map_sub (φ σ), hφ_apply, hφ_apply, ← hact_mul σ ρ π]
    rw [hmap]
    refine Finset.prod_bij (fun (ρ : G) _ => σ * ρ) ?_ ?_ ?_ ?_
    · intro ρ hρ
      have hρ_ne1 : ρ ≠ 1 := (Finset.mem_erase.mp hρ).1
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h_eq
      have h1 : σ⁻¹ * (σ * ρ) = σ⁻¹ * σ := congrArg (σ⁻¹ * ·) h_eq
      rw [inv_mul_cancel_left, inv_mul_cancel] at h1
      exact hρ_ne1 h1
    · intro ρ₁ _ ρ₂ _ h_eq
      exact mul_left_cancel h_eq
    · intro γ hγ
      have hγ_ne : γ ≠ σ := (Finset.mem_erase.mp hγ).1
      refine ⟨σ⁻¹ * γ, ?_, mul_inv_cancel_left σ γ⟩
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h1
      exact hγ_ne (inv_mul_eq_one.mp h1).symm
    · intro ρ _
      rfl
  have hact_term : ∀ (σ : G) (k : ℕ),
      act σ (π ^ k * δ⁻¹) = (v σ) ^ k / (∏ γ ∈ U_G.erase σ, (v σ - v γ)) := by
    intro σ k
    change φ σ (π ^ k * δ⁻¹) = _
    rw [map_mul (φ σ), map_pow (φ σ), map_inv₀ (φ σ), hφ_apply, hφ_apply, hact_δ σ,
      div_eq_mul_inv]
  let Q : G → Polynomial K := fun σ =>
    ∏ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ))
  have hQ_coeff : ∀ σ : G, (Q σ).coeff (p - 1) = 1 := by
    intro σ
    have hmonic_fac : ∀ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ)).Monic :=
      fun γ _ => Polynomial.monic_X_sub_C (v γ)
    have hmonic : (Q σ).Monic :=
      Polynomial.monic_prod_of_monic (U_G.erase σ) _ hmonic_fac
    have hdeg : (Q σ).natDegree = p - 1 := by
      dsimp only [Q]
      rw [Polynomial.natDegree_prod_of_monic (U_G.erase σ) _ hmonic_fac]
      have hsum1 : (∑ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ)).natDegree) =
          ∑ _γ ∈ U_G.erase σ, 1 := by
        refine Finset.sum_congr rfl (fun γ _ => Polynomial.natDegree_X_sub_C (v γ))
      rw [hsum1, Finset.sum_const, smul_eq_mul, mul_one,
        Finset.card_erase_of_mem (Finset.mem_univ σ), Finset.card_univ, hcard_G]
    rw [← hdeg]
    exact Polynomial.Monic.coeff_natDegree hmonic
  have hEuler : ∀ k < p,
      traceLM F hLK (π ^ k * δ⁻¹) = if p - 1 = k then 1 else 0 := by
    intro k hk
    have hdeg : (Polynomial.X ^ k : Polynomial K).degree < (U_G.card : WithBot ℕ) := by
      rw [Polynomial.degree_X_pow k, Finset.card_univ, hcard_G]
      exact WithBot.coe_lt_coe.mpr hk
    have hLag := @Lagrange.eq_interpolate K _ G _ U_G v (Polynomial.X ^ k) hInjOn hdeg
    rw [Lagrange.interpolate_eq_sum] at hLag
    have hcoeff := congrArg (fun P : Polynomial K => P.coeff (p - 1)) hLag
    dsimp only at hcoeff
    rw [Polynomial.coeff_X_pow k (p - 1), Polynomial.finset_sum_coeff] at hcoeff
    have hrhs : (∑ σ ∈ U_G,
        (Polynomial.C (Polynomial.eval (v σ) (Polynomial.X ^ k) /
          ∏ γ ∈ U_G.erase σ, (v σ - v γ)) * Q σ).coeff (p - 1)) =
        IntermediateField.inclusion hLK (traceLM F hLK (π ^ k * δ⁻¹)) := by
      rw [hact_trace (π ^ k * δ⁻¹)]
      refine Finset.sum_congr rfl (fun σ _ => ?_)
      rw [Polynomial.coeff_C_mul, hQ_coeff σ, mul_one, Polynomial.eval_X_pow, hact_term σ k]
    rw [hrhs] at hcoeff
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (traceLM F hLK (π ^ k * δ⁻¹)) =
      IntermediateField.inclusion hLK (if p - 1 = k then 1 else 0)
    rw [← hcoeff]
    split_ifs <;> simp
  let i_max : Fin p := ⟨p - 1, Nat.sub_lt hp_pos zero_lt_one⟩
  refine ⟨?_, ?_⟩
  · intro m y hy
    obtain ⟨c, hyδ_eq, hyδ_val⟩ := hBasis (y * δ)
    have hy_eq : y = ∑ i : Fin p,
        IntermediateField.inclusion hLK (c i) * (π ^ (i : ℕ) * δ⁻¹) := by
      calc y = (y * δ) * δ⁻¹ := (mul_inv_cancel_right₀ hδ_ne0 y).symm
        _ = (∑ i : Fin p, IntermediateField.inclusion hLK (c i) * (π ^ (i : ℕ))) * δ⁻¹ := by
            rw [hyδ_eq]
        _ = ∑ i : Fin p, IntermediateField.inclusion hLK (c i) * (π ^ (i : ℕ) * δ⁻¹) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun i _ => mul_assoc _ _ _)
    have htr_y : traceLM F hLK y = c i_max := by
      rw [hy_eq, map_sum (traceLM F hLK)]
      have hsum_c : (∑ i : Fin p,
          traceLM F hLK (IntermediateField.inclusion hLK (c i) * (π ^ (i : ℕ) * δ⁻¹))) =
          ∑ i : Fin p, c i * (if p - 1 = (i : ℕ) then 1 else 0) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [htr_smul (c i), hEuler i.1 i.2]
      rw [hsum_c, Finset.sum_eq_single i_max]
      · change c i_max * (if p - 1 = p - 1 then 1 else 0) = c i_max
        simp
      · intro i _ hi_ne
        have hval_ne : p - 1 ≠ (i : ℕ) := by
          intro h_eq
          exact hi_ne (Fin.ext h_eq.symm)
        rw [if_neg hval_ne, mul_zero]
      · intro hnot
        exact absurd (Finset.mem_univ i_max) hnot
    have hyδ_bound : y * δ = 0 ∨ (p : ℤ) * m ≤ valL F K (y * δ) := by
      rcases hy with rfl | hy_ge
      · left; exact zero_mul δ
      · by_cases hy0 : y = 0
        · left; rw [hy0, zero_mul]
        · right
          rw [hvalK_mul y δ hy0 hδ_ne0, hδ_val]
          linarith
    have hc_imax := (hyδ_val ((p : ℤ) * m)).mp hyδ_bound i_max
    rw [htr_y]
    rcases hc_imax with hc0 | hc_ge
    · exact Or.inl hc0
    · right
      change (p : ℤ) * m ≤ (p : ℤ) * valL F L (c i_max) + ((p - 1 : ℕ) : ℤ) at hc_ge
      by_contra hlt
      have h1 : 1 ≤ m - valL F L (c i_max) := by omega
      have hp_z : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
      have h2 : (p : ℤ) * 1 ≤ (p : ℤ) * (m - valL F L (c i_max)) :=
        mul_le_mul_of_nonneg_left h1 (le_of_lt hp_z)
      have h3 : ((p - 1 : ℕ) : ℤ) < (p : ℤ) := by omega
      linarith
  · intro x
    refine ⟨IntermediateField.inclusion hLK x * (π ^ (p - 1) * δ⁻¹), ?_, ?_, ?_⟩
    · rw [htr_smul x (π ^ (p - 1) * δ⁻¹), hEuler (p - 1) (Nat.sub_lt hp_pos zero_lt_one),
        if_pos rfl, mul_one]
    · intro hx0
      rw [hx0, map_zero, zero_mul]
    · intro hx_ne0
      have hincl_ne0 : IntermediateField.inclusion hLK x ≠ 0 :=
        (map_ne_zero_iff (IntermediateField.inclusion hLK)
          (IntermediateField.inclusion hLK).injective).mpr hx_ne0
      have hpow_ne0 : π ^ (p - 1) ≠ 0 := (hval_pi_pow (p - 1)).1
      have hpow_val : valL F K (π ^ (p - 1)) = ((p - 1 : ℕ) : ℤ) := (hval_pi_pow (p - 1)).2
      have hrhs_ne0 : π ^ (p - 1) * δ⁻¹ ≠ 0 := mul_ne_zero hpow_ne0 hδ_inv_ne0
      refine ⟨mul_ne_zero hincl_ne0 hrhs_ne0, ?_⟩
      rw [hvalK_mul _ _ hincl_ne0 hrhs_ne0, hvalK_mul _ _ hpow_ne0 hδ_inv_ne0,
        hval_alg x, hpow_val, hδ_inv_val]
      ring

theorem ld_wild_free_orbit_norm_expansion (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (hact_norm : ∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y) :
    ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y :=
by
  rcases hvalK_props with
    ⟨hvalK0, hvalK1, _, _, hvalK_mul, _, _, hvalK_add, _⟩
  intro m hm y hy
  set p : ℕ := Module.finrank L (IntermediateField.extendScalars hLK)
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hcard_univ : (Finset.univ : Finset G).card = p := Finset.card_univ.trans hcard_G
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).1 }
  let P : Finset G → K := fun S => ∏ s ∈ S, act s y
  let U_pow : Finset (Finset G) := (Finset.univ : Finset G).powerset
  
  have hnorm_powerset :
      IntermediateField.inclusion hLK (normLM F hLK (1 + y)) = ∑ S ∈ U_pow, P S := by
    rw [hact_norm (1 + y)]
    have h1 : (∏ σ : G, act σ (1 + y)) = ∏ σ ∈ (Finset.univ : Finset G), (1 + act σ y) := by
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [((hact_ring σ).2.2 1 y).1, (hact_ring σ).2.1]
    rw [h1]
    exact Finset.prod_one_add (Finset.univ : Finset G)
  
  let U₀ : Finset (Finset G) := U_pow.erase ∅
  have hempty_mem : (∅ : Finset G) ∈ U_pow := Finset.empty_mem_powerset Finset.univ
  have hP_empty : P ∅ = 1 := Finset.prod_empty
  have hsum_U_pow : (∑ S ∈ U_pow, P S) = 1 + ∑ S ∈ U₀, P S := by
    rw [← Finset.add_sum_erase U_pow P hempty_mem, hP_empty]
  have huniv_ne_empty : (Finset.univ : Finset G) ≠ ∅ := by
    intro h
    have hc := congrArg Finset.card h
    simp only [hcard_univ, Finset.card_empty] at hc
    omega
  have huniv_mem_U₀ : (Finset.univ : Finset G) ∈ U₀ :=
    Finset.mem_erase.mpr ⟨huniv_ne_empty, Finset.mem_powerset_self Finset.univ⟩
  have hP_univ : P Finset.univ = IntermediateField.inclusion hLK (normLM F hLK y) :=
    (hact_norm y).symm
  let U₁ : Finset (Finset G) := U₀.erase Finset.univ
  have hsum_U₀ :
      (∑ S ∈ U₀, P S) =
        IntermediateField.inclusion hLK (normLM F hLK y) + ∑ S ∈ U₁, P S := by
    rw [← Finset.add_sum_erase U₀ P huniv_mem_U₀, hP_univ]
  have hmem_U₁ : ∀ {S : Finset G}, S ∈ U₁ ↔ 1 ≤ S.card ∧ S.card ≤ p - 1 := by
    intro S
    simp only [U₁, U₀, U_pow, Finset.mem_erase, Finset.mem_powerset, Finset.subset_univ,
      and_true]
    constructor
    · rintro ⟨hne_univ, hne_empty⟩
      have hpos : 0 < S.card := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hne_empty)
      have hle : S.card ≤ p := by
        have h := Finset.card_le_univ S
        omega
      have hne_p : S.card ≠ p := by
        intro hc
        apply hne_univ
        exact Finset.eq_univ_of_card S (hc.trans hcard_G.symm)
      omega
    · rintro ⟨hge1, hle⟩
      refine ⟨?_, ?_⟩
      · intro huniv
        rw [huniv, hcard_univ] at hle
        omega
      · intro hempty
        rw [hempty, Finset.card_empty] at hge1
        omega
  let U_sing : Finset (Finset G) := U₁.filter (fun S => S.card = 1)
  let ℱ : Finset (Finset G) := U₁.filter (fun S => ¬ S.card = 1)
  have hsum_U₁ : (∑ S ∈ U₁, P S) = (∑ S ∈ U_sing, P S) + (∑ S ∈ ℱ, P S) :=
    (Finset.sum_filter_add_sum_filter_not U₁ (fun S => S.card = 1) P).symm
  have hUsing_eq : U_sing = (Finset.univ : Finset G).image (fun σ : G => ({σ} : Finset G)) := by
    ext S
    simp only [U_sing, Finset.mem_filter, hmem_U₁, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨_, hcard1⟩
      obtain ⟨σ, rfl⟩ := Finset.card_eq_one.mp hcard1
      exact ⟨σ, rfl⟩
    · rintro ⟨σ, rfl⟩
      rw [Finset.card_singleton]
      omega
  have hsum_Using :
      (∑ S ∈ U_sing, P S) = IntermediateField.inclusion hLK (traceLM F hLK y) := by
    rw [hUsing_eq, Finset.sum_image (fun σ₁ _ σ₂ _ h => Finset.singleton_injective h)]
    have h1 : (∑ σ ∈ (Finset.univ : Finset G), P {σ}) = ∑ σ : G, act σ y := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact Finset.prod_singleton (fun s => act s y) σ
    rw [h1, ← hact_trace y]
  have hmem_F : ∀ {S : Finset G}, S ∈ ℱ ↔ 2 ≤ S.card ∧ S.card ≤ p - 1 := by
    intro S
    simp only [ℱ, Finset.mem_filter, hmem_U₁]
    omega
  
  let trS : G → Finset G → Finset G := fun τ S => S.image (fun s => τ * s)
  have trS_card : ∀ (τ : G) (S : Finset G), (trS τ S).card = S.card :=
    fun τ S => Finset.card_image_of_injective S (mul_right_injective τ)
  have trS_one : ∀ (S : Finset G), trS 1 S = S := by
    intro S
    ext x
    simp [trS]
  have trS_mul : ∀ (σ τ : G) (S : Finset G), trS (σ * τ) S = trS σ (trS τ S) := by
    intro σ τ S
    ext x
    simp [trS, mul_assoc]
  have trS_mem_F : ∀ {S : Finset G}, S ∈ ℱ → ∀ (τ : G), trS τ S ∈ ℱ := by
    intro S hS τ
    rw [hmem_F, trS_card]
    exact hmem_F.mp hS
  have P_trS : ∀ (τ : G) (S : Finset G), P (trS τ S) = act τ (P S) := by
    intro τ S
    change (∏ x ∈ S.image (fun s => τ * s), act x y) = φ τ (∏ s ∈ S, act s y)
    rw [Finset.prod_image (fun s₁ _ s₂ _ h => mul_right_injective τ h), map_prod (φ τ)]
    refine Finset.prod_congr rfl fun s _ => ?_
    exact hact_mul τ s y
  
  have trS_free : ∀ {S : Finset G}, S ∈ ℱ → ∀ {τ : G}, trS τ S = S → τ = 1 := by
    intro S hS τ hfix
    obtain ⟨hge2, hle⟩ := hmem_F.mp hS
    by_contra hτ
    have hpow_p : τ ^ p = 1 := by
      rw [← hcard_G]
      exact pow_card_eq_one
    have hord : orderOf τ = p := orderOf_eq_prime hpow_p hτ
    have hS_pos : 0 < S.card := by omega
    obtain ⟨s₀, hs₀⟩ := Finset.card_pos.mp hS_pos
    have hpow_mem : ∀ k : ℕ, τ ^ k * s₀ ∈ S := by
      intro k
      induction k with
      | zero => simp [hs₀]
      | succ k ih =>
        have hstep : τ * (τ ^ k * s₀) ∈ trS τ S :=
          Finset.mem_image_of_mem (fun s => τ * s) ih
        rw [hfix, ← mul_assoc, ← pow_succ'] at hstep
        exact hstep
    let f : Fin p → G := fun k => τ ^ k.1 * s₀
    have hMaps : Set.MapsTo f ↑(Finset.univ : Finset (Fin p)) ↑S := by
      intro k _
      exact Finset.mem_coe.mpr (hpow_mem k.1)
    have hInj : Set.InjOn f ↑(Finset.univ : Finset (Fin p)) := by
      intro k₁ _ k₂ _ heq
      have hpow_eq : τ ^ k₁.1 = τ ^ k₂.1 := mul_left_injective s₀ heq
      have hk₁ : k₁.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₁.2
      have hk₂ : k₂.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₂.2
      exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ hpow_eq)
    have hcard_le := Finset.card_le_card_of_injOn f hMaps hInj
    simp only [Finset.card_univ, Fintype.card_fin] at hcard_le
    omega
  have trS_inj : ∀ {S : Finset G}, S ∈ ℱ → Function.Injective (fun τ : G => trS τ S) := by
    intro S hS τ₁ τ₂ heq
    dsimp only at heq
    have hfix : trS (τ₁⁻¹ * τ₂) S = S := by
      rw [trS_mul, ← heq, ← trS_mul, inv_mul_cancel, trS_one]
    exact inv_mul_eq_one.mp (trS_free hS hfix)
  
  let orb : Finset G → Finset (Finset G) :=
    fun S => (Finset.univ : Finset G).image (fun τ => trS τ S)
  let chooseOrb : Finset (Finset G) → Finset G :=
    fun O => if h : ∃ T, T ∈ O then Classical.choose h else ∅
  let rep : Finset G → Finset G := fun S => chooseOrb (orb S)
  let ℛ : Finset (Finset G) := ℱ.image rep
  have mem_orb_self : ∀ (S : Finset G), S ∈ orb S := by
    intro S
    refine Finset.mem_image.mpr ⟨1, Finset.mem_univ 1, trS_one S⟩
  have orb_trS : ∀ (σ : G) (S : Finset G), orb (trS σ S) = orb S := by
    intro σ S
    ext T
    simp only [orb, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨τ, rfl⟩
      exact ⟨τ * σ, trS_mul τ σ S⟩
    · rintro ⟨ρ, rfl⟩
      refine ⟨ρ * σ⁻¹, ?_⟩
      rw [← trS_mul, inv_mul_cancel_right]
  have orb_eq_of_mem : ∀ {S T : Finset G}, T ∈ orb S → orb T = orb S := by
    intro S T hT
    obtain ⟨σ, _, rfl⟩ := Finset.mem_image.mp hT
    exact orb_trS σ S
  have rep_mem_orb : ∀ (S : Finset G), rep S ∈ orb S := by
    intro S
    have hex : ∃ T, T ∈ orb S := ⟨S, mem_orb_self S⟩
    have hdef : rep S = Classical.choose hex := dif_pos hex
    rw [hdef]
    exact Classical.choose_spec hex
  have orb_rep : ∀ (S : Finset G), orb (rep S) = orb S :=
    fun S => orb_eq_of_mem (rep_mem_orb S)
  have rep_eq_iff : ∀ (S₁ S₂ : Finset G), rep S₁ = rep S₂ ↔ orb S₁ = orb S₂ := by
    intro S₁ S₂
    constructor
    · intro h
      rw [← orb_rep S₁, h, orb_rep S₂]
    · intro h
      exact congrArg chooseOrb h
  have R_sub_F : ∀ S₀ ∈ ℛ, S₀ ∈ ℱ ∧ rep S₀ = S₀ := by
    intro S₀ hS₀
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hS₀
    obtain ⟨τ, _, hτ⟩ := Finset.mem_image.mp (rep_mem_orb S)
    refine ⟨hτ ▸ trS_mem_F hS τ, ?_⟩
    exact (rep_eq_iff (rep S) S).mpr (orb_rep S)
  have hfiber : ∀ S₀ ∈ ℛ, ℱ.filter (fun S => rep S = S₀) = orb S₀ := by
    intro S₀ hS₀
    obtain ⟨hS₀_F, hS₀_rep⟩ := R_sub_F S₀ hS₀
    ext S
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨_, hrep⟩
      have horb : orb S = orb S₀ := (rep_eq_iff S S₀).mp (hrep.trans hS₀_rep.symm)
      rw [← horb]
      exact mem_orb_self S
    · intro hmem
      obtain ⟨τ, _, rfl⟩ := Finset.mem_image.mp hmem
      refine ⟨trS_mem_F hS₀_F τ, ?_⟩
      have horb : orb (trS τ S₀) = orb S₀ := orb_trS τ S₀
      exact ((rep_eq_iff (trS τ S₀) S₀).mpr horb).trans hS₀_rep
  let z : K := ∑ S₀ ∈ ℛ, P S₀
  have hsum_F : (∑ S ∈ ℱ, P S) = IntermediateField.inclusion hLK (traceLM F hLK z) := by
    rw [← Finset.sum_fiberwise_of_maps_to (fun S hS => Finset.mem_image_of_mem rep hS) P]
    have h1 :
        (∑ S₀ ∈ ℛ, ∑ S ∈ ℱ with rep S = S₀, P S) =
          ∑ S₀ ∈ ℛ, ∑ τ ∈ (Finset.univ : Finset G), act τ (P S₀) := by
      refine Finset.sum_congr rfl fun S₀ hS₀ => ?_
      have hS₀_F : S₀ ∈ ℱ := (R_sub_F S₀ hS₀).1
      rw [hfiber S₀ hS₀]
      change (∑ S ∈ (Finset.univ : Finset G).image (fun τ => trS τ S₀), P S) = _
      rw [Finset.sum_image (fun τ₁ _ τ₂ _ h => trS_inj hS₀_F h)]
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact P_trS τ S₀
    rw [h1, Finset.sum_comm]
    have h2 :
        (∑ τ ∈ (Finset.univ : Finset G), ∑ S₀ ∈ ℛ, act τ (P S₀)) =
          ∑ τ : G, act τ z := by
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact (map_sum (φ τ) P ℛ).symm
    rw [h2, ← hact_trace z]
  
  have hy_act : ∀ s : G, act s y = 0 ∨ (m : ℤ) ≤ valL F K (act s y) := by
    intro s
    rcases hy with rfl | hy_val
    · exact Or.inl (hact_ring s).1
    · right
      rw [hact_val s y]
      exact hy_val
  have hP_val : ∀ S : Finset G, P S = 0 ∨ (S.card : ℤ) * (m : ℤ) ≤ valL F K (P S) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      right
      change ((0 : ℕ) : ℤ) * (m : ℤ) ≤ valL F K 1
      rw [hvalK1]
      simp
    | @insert s S' hs ih =>
      have hP_ins : P (insert s S') = act s y * P S' := Finset.prod_insert hs
      have hcard_ins : (insert s S').card = S'.card + 1 := Finset.card_insert_of_notMem hs
      rw [hP_ins, hcard_ins]
      by_cases ha : act s y = 0
      · left; rw [ha, zero_mul]
      · by_cases hb : P S' = 0
        · left; rw [hb, mul_zero]
        · right
          have hva : (m : ℤ) ≤ valL F K (act s y) := (hy_act s).resolve_left ha
          have hvb : (S'.card : ℤ) * (m : ℤ) ≤ valL F K (P S') := ih.resolve_left hb
          rw [hvalK_mul (act s y) (P S') ha hb]
          push_cast
          linarith
  have hz_term : ∀ S₀ ∈ ℛ, P S₀ = 0 ∨ (2 * m : ℤ) ≤ valL F K (P S₀) := by
    intro S₀ hS₀
    have hge2 : 2 ≤ S₀.card := (hmem_F.mp (R_sub_F S₀ hS₀).1).1
    rcases hP_val S₀ with h0 | hval
    · exact Or.inl h0
    · right
      have hle : (2 * m : ℤ) ≤ (S₀.card : ℤ) * (m : ℤ) := by
        have h1 : (2 : ℤ) ≤ (S₀.card : ℤ) := by exact_mod_cast hge2
        have h2 : (0 : ℤ) ≤ (m : ℤ) := by positivity
        nlinarith
      exact le_trans hle hval
  have hz_val : z = 0 ∨ (2 * m : ℤ) ≤ valL F K z := by
    change (∑ S₀ ∈ ℛ, P S₀) = 0 ∨ (2 * m : ℤ) ≤ valL F K (∑ S₀ ∈ ℛ, P S₀)
    have hsub : ∀ T : Finset (Finset G), T ⊆ ℛ →
        (∑ S₀ ∈ T, P S₀) = 0 ∨ (2 * m : ℤ) ≤ valL F K (∑ S₀ ∈ T, P S₀) := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro _
        exact Or.inl Finset.sum_empty
      | @insert S₀ T' hS₀ ih =>
        intro hT
        rw [Finset.sum_insert hS₀]
        have h1 : P S₀ = 0 ∨ (2 * m : ℤ) ≤ valL F K (P S₀) :=
          hz_term S₀ (hT (Finset.mem_insert_self S₀ T'))
        have h2 : (∑ S ∈ T', P S) = 0 ∨ (2 * m : ℤ) ≤ valL F K (∑ S ∈ T', P S) :=
          ih (Finset.Subset.trans (Finset.subset_insert S₀ T') hT)
        exact hvalK_add (2 * m : ℤ) (P S₀) (∑ S ∈ T', P S) h1 h2
    exact hsub ℛ (Finset.Subset.refl ℛ)
  refine ⟨z, hz_val, ?_⟩
  apply (IntermediateField.inclusion hLK).injective
  change IntermediateField.inclusion hLK (normLM F hLK (1 + y)) =
    IntermediateField.inclusion hLK (1 + traceLM F hLK (y + z) + normLM F hLK y)
  rw [hnorm_powerset, hsum_U_pow, hsum_U₀, hsum_U₁, hsum_Using, hsum_F]
  rw [map_add, map_add, map_one, map_add (traceLM F hLK), map_add]
  ring

theorem ld_wild_galois_jump_and_euler_trace_formula (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (haddVal1 : addVal F 1 = 0)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ∃ (t : ℕ) (w_star : Kˣ),
      1 ≤ t ∧
      w_star ∈ unitGroup F K t ∧
      w_star ∉ unitGroup F K (t + 1) ∧
      Units.map (normLM F hLK) w_star = 1 ∧
      (∀ (m : ℤ) (y : K),
        (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K y) →
        (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) ∧
      (∀ x : L, ∃ y_x : K,
        traceLM F hLK y_x = x ∧
        (x = 0 → y_x = 0) ∧
        (x ≠ 0 →
          y_x ≠ 0 ∧
          valL F K y_x =
            (p : ℤ) * valL F L x + ((p - 1 : ℕ) : ℤ) -
              ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ))) ∧
      (∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
        ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
          normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y) :=
by
  obtain ⟨G, hGroupG, hFinG, act, t, w_star, hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, hact_faithful, hact_val, hact_trace, hact_norm,
    ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm, hjump⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L K hLK hGal hPrime hEqP
      haddVal1 halg1 hvalL_props hvalK_props hval_norm hval_alg ϖ_K hϖ_K hBasis
  letI : Group G := hGroupG
  letI : Fintype G := hFinG
  obtain ⟨htr_bound, htr_surj⟩ :=
    ld_wild_euler_lagrange_trace_formula F L K hLK hPrime
      hvalL_props hvalK_props hval_alg ϖ_K hϖ_K hBasis
      G act hcard_G hact_one hact_mul hact_ring hact_incl hact_trace t hjump
  have hnorm_exp :=
    ld_wild_free_orbit_norm_expansion F L K hLK hPrime hvalK_props
      G act hcard_G hact_one hact_mul hact_ring hact_val hact_trace hact_norm
  exact ⟨t, w_star, ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm,
    htr_bound, htr_surj, hnorm_exp⟩

theorem ld_wild_herbrand_unit_norm_filtration_and_jump_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (w_star : Kˣ) (ht_ge1 : 1 ≤ t)
    (hw_star_t : w_star ∈ unitGroup F K t)
    (hw_star_nt1 : w_star ∉ unitGroup F K (t + 1))
    (hw_star_norm : Units.map (normLM F hLK) w_star = 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (htr_surj : ∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x +
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    condExp F L ν₁ = t + 1 ∧
    (∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m) ∧
    (∀ m ≤ t, ∀ w : Kˣ,
      Units.map (normLM F hLK) w ∈ unitGroup F L m ↔ w ∈ unitGroup F K m) ∧
    (∀ m < t, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F K m,
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (m + 1)) ∧
    (∀ r ≥ t + 1, ∀ w ∈ unitGroup F K (t + 1 + p * (r - t)),
      Units.map (normLM F hLK) w ∈ unitGroup F L (r + 1)) ∧
    (∀ r ≥ t + 1, ∀ u ∈ unitGroup F L r,
      ∃ w ∈ unitGroup F K (t + p * (r - t)),
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (r + 1)) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, hval_surj_K, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  set K' := IntermediateField.extendScalars hLK
  set p := Module.finrank L K'
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_int_pos : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
  have hp_int_ge2 : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega

  
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_pow_K : ∀ (y : K) (n : ℕ), y ≠ 0 → valL F K (y ^ n) = (n : ℤ) * valL F K y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_mul_ge_K : ∀ (k₁ k₂ : ℤ) (x y : K),
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F K x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F K y := hy.resolve_left hy0
        rw [hval_mul_K x y hx0 hy0]
        omega
  have hval_pow_ge_L : ∀ (n : ℕ) (m : ℤ) (x : L),
      (x = 0 ∨ m ≤ valL F L x) → (x ^ n = 0 ∨ (n : ℤ) * m ≤ valL F L (x ^ n)) := by
    intro n m x hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hval1_L]
      simp
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge_L ((n : ℤ) * m) m (x ^ n) x ih hx
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * m = (n : ℤ) * m + m := by push_cast; ring
        rw [heq]
        exact hge
  have hval_sub_ge_L : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    have hny : -y = 0 ∨ k ≤ valL F L (-y) := by
      rcases hy with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right
        rw [hval_neg_L]
        exact hge
    exact hval_add_L k x (-y) hx hny
  have hval_sub_ge_K : ∀ (k : ℤ) (x y : K),
      (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
        (x - y = 0 ∨ k ≤ valL F K (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    have hny : -y = 0 ∨ k ≤ valL F K (-y) := by
      rcases hy with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right
        rw [hval_neg_K]
        exact hge
    exact hval_add_K k x (-y) hx hny
  have hval_le_L : ∀ {k₁ k₂ : ℤ} {x : L},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hval_le_K : ∀ {k₁ k₂ : ℤ} {y : K},
      k₁ ≤ k₂ → (y = 0 ∨ k₂ ≤ valL F K y) → (y = 0 ∨ k₁ ≤ valL F K y) := by
    intro k₁ k₂ y hle hy
    rcases hy with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hval_finset_sum_L : ∀ {α : Type} (S : Finset α) (f : α → L) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_L k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hval_finset_sum_K : ∀ {α : Type} (S : Finset α) (f : α → K) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hunit_anti_L : ∀ {a b : ℕ}, a ≤ b → ∀ {u : Lˣ},
      u ∈ unitGroup F L b → u ∈ unitGroup F L a := by
    intro a b hab u hu
    by_cases ha0 : a = 0
    · subst ha0
      exact (hunit0_L u).mpr (hunit_val0_L b u hu)
    · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      have hb1 : 1 ≤ b := le_trans ha1 hab
      rw [hunit_ge1_L a ha1 u]
      rcases (hunit_ge1_L b hb1 u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by omega) hge)
  have hunit_anti_K : ∀ {a b : ℕ}, a ≤ b → ∀ {w : Kˣ},
      w ∈ unitGroup F K b → w ∈ unitGroup F K a := by
    intro a b hab w hw
    by_cases ha0 : a = 0
    · subst ha0
      exact (hunit0_K w).mpr (hunit_val0_K b w hw)
    · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      have hb1 : 1 ≤ b := le_trans ha1 hab
      rw [hunit_ge1_K a ha1 w]
      rcases (hunit_ge1_K b hb1 w).mp hw with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by omega) hge)
  have h1_add_ne_zero_L : ∀ {x : L}, (x = 0 ∨ 1 ≤ valL F L x) → 1 + x ≠ 0 := by
    intro x hx h0
    have h1_eq : (1 : L) = -x := eq_neg_of_add_eq_zero_left h0
    rcases hx with hx0 | hge
    · rw [hx0, neg_zero] at h1_eq
      exact one_ne_zero h1_eq
    · have hv : valL F L (1 : L) = valL F L x := by rw [h1_eq, hval_neg_L]
      rw [hval1_L] at hv
      omega
  have h1_add_ne_zero_K : ∀ {y : K}, (y = 0 ∨ 1 ≤ valL F K y) → 1 + y ≠ 0 := by
    intro y hy h0
    have h1_eq : (1 : K) = -y := eq_neg_of_add_eq_zero_left h0
    rcases hy with hy0 | hge
    · rw [hy0, neg_zero] at h1_eq
      exact one_ne_zero h1_eq
    · have hv : valL F K (1 : K) = valL F K y := by rw [h1_eq, hval_neg_K]
      rw [hval1_K] at hv
      omega
  have hval_nat_L : ∀ n : ℕ, (n : L) = 0 ∨ 0 ≤ valL F L (n : L) := by
    intro n
    induction n with
    | zero => exact Or.inl Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_L 0 (n : L) 1 ih (Or.inr (by rw [hval1_L]))
  have hϖ_L_pow_val : ∀ m : ℕ, valL F L (((ϖ_L ^ m : Lˣ) : L)) = (m : ℤ) := by
    intro m
    rw [Units.val_pow_eq_pow_val, hval_pow_L (ϖ_L : L) m (Units.ne_zero ϖ_L), hϖ_L, mul_one]
  have hϖ_L_pow_inv_val : ∀ m : ℕ, valL F L ((((ϖ_L ^ m : Lˣ)⁻¹ : Lˣ) : L)) = -(m : ℤ) := by
    intro m
    rw [hval_inv_L (ϖ_L ^ m), hϖ_L_pow_val m]
  have hϖ_K_pow_val : ∀ m : ℕ, valL F K (((ϖ_K ^ m : Kˣ) : K)) = (m : ℤ) := by
    intro m
    rw [Units.val_pow_eq_pow_val, hval_pow_K (ϖ_K : K) m (Units.ne_zero ϖ_K), hϖ_K, mul_one]
  have hϖ_K_pow_inv_val : ∀ m : ℕ, valL F K ((((ϖ_K ^ m : Kˣ)⁻¹ : Kˣ) : K)) = -(m : ℤ) := by
    intro m
    rw [hval_inv_K (ϖ_K ^ m), hϖ_K_pow_val m]

  
  have hnorm_ne_zero : ∀ y : K, y ≠ 0 → normLM F hLK y ≠ 0 :=
    fun y hy0 => Units.ne_zero (Units.map (normLM F hLK) (Units.mk0 y hy0))
  have hnorm_zero : normLM F hLK 0 = 0 := by
    by_contra h0
    have h1 : normLM F hLK 0 = normLM F hLK 0 * (ϖ_L : L) := by
      have hcoe : normLM F hLK (ϖ_K : K) = (ϖ_L : L) := congrArg Units.val hϖ_norm
      calc normLM F hLK 0
        _ = normLM F hLK (0 * (ϖ_K : K)) := by rw [zero_mul]
        _ = normLM F hLK 0 * normLM F hLK (ϖ_K : K) := map_mul (normLM F hLK) 0 (ϖ_K : K)
        _ = normLM F hLK 0 * (ϖ_L : L) := by rw [hcoe]
    have h2 : valL F L (normLM F hLK 0) = valL F L (normLM F hLK 0) + 1 := by
      conv_lhs => rw [h1]
      rw [hval_mul_L _ _ h0 (Units.ne_zero ϖ_L), hϖ_L]
    omega
  have hnorm_val_ge : ∀ (k : ℤ) (y : K),
      (y = 0 ∨ k ≤ valL F K y) →
        (normLM F hLK y = 0 ∨ k ≤ valL F L (normLM F hLK y)) := by
    intro k y hy
    rcases hy with hy0 | hge
    · exact Or.inl (by rw [hy0, hnorm_zero])
    · right
      rw [hval_norm y]
      exact hge
  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ p := by
    intro x
    change Algebra.norm L (algebraMap L K' x) = x ^ p
    exact Algebra.norm_algebraMap x
  have hval_inc_ge : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) →
        (IntermediateField.inclusion hLK x = 0 ∨
          (p : ℤ) * k ≤ valL F K (IntermediateField.inclusion hLK x)) := by
    intro k x hx
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, map_zero])
    · right
      rw [hval_alg x]
      have hge := hx.resolve_left hx0
      nlinarith
  have hp_valL : (p : L) = 0 ∨ 1 ≤ valL F L (p : L) := by
    letI : Module L L := Semiring.toModule
    have htr1 : traceLM F hLK (1 : K) = (p : L) := by
      change Algebra.trace L K' (algebraMap L K' (1 : L)) = (p : L)
      rw [Algebra.trace_algebraMap (1 : L), nsmul_one]
    have htr1_in : (1 : K) = 0 ∨
        (p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (1 : K) := by
      right
      rw [hval1_K, hp_sub1_int]
      have ht_int : (1 : ℤ) ≤ (t : ℤ) := by omega
      nlinarith
    have h := htr_bound 1 (1 : K) htr1_in
    rwa [htr1] at h

  
  have hResSurj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)) := by
    intro y hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis y
    let t_term (i : Fin p) : K := IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ))
    let i_zero : Fin p := ⟨0, hp_pos⟩
    let x : L := c i_zero
    have hc_all := (hval_iff 0).mp hy
    have hx : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc_all i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (p : ℤ) * valL F L x + (0 : ℤ) at hge
        nlinarith
    have ht_zero : t_term i_zero = IntermediateField.inclusion hLK x := by
      dsimp [t_term, i_zero, x]
      rw [pow_zero, mul_one]
    have hy_sub : y - IntermediateField.inclusion hLK x =
        ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i_zero, t_term i := by
      have hsum := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) t_term
        (Finset.mem_univ i_zero)).symm
      rw [ht_zero] at hsum
      rw [hy_eq]
      change (∑ i : Fin p, t_term i) - IntermediateField.inclusion hLK x = _
      rw [hsum, add_sub_cancel_left]
    refine ⟨x, hx, ?_⟩
    rw [hy_sub]
    apply hval_finset_sum_K ((Finset.univ : Finset (Fin p)).erase i_zero) t_term 1
    intro i hi
    have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
    have hi_ge1 : (1 : ℤ) ≤ (i.1 : ℤ) := by
      have hne0 : i.1 ≠ 0 := fun h0 => hi_ne (Fin.ext h0)
      omega
    have hi_lt : (i.1 : ℤ) < (p : ℤ) := Nat.cast_lt.mpr i.2
    by_cases hci0 : c i = 0
    · left
      dsimp [t_term]
      rw [hci0, map_zero, zero_mul]
    · right
      have hci_ge : 0 ≤ (p : ℤ) * valL F L (c i) + (i.1 : ℤ) := (hc_all i).resolve_left hci0
      have hci_val_ge0 : 0 ≤ valL F L (c i) := by nlinarith
      have hinc_ne : IntermediateField.inclusion hLK (c i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hci0
      have hpow_ne : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
      dsimp [t_term]
      rw [hval_mul_K _ _ hinc_ne hpow_ne, hval_alg (c i),
        hval_pow_K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_one]
      nlinarith

  
  have hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m := by
    intro m hm_le w hw
    by_cases hm0 : m = 0
    · subst hm0
      rw [hunit0_L]
      have hw0 : valL F K (w : K) = 0 := (hunit0_K w).mp hw
      change valL F L (normLM F hLK (w : K)) = 0
      rw [hval_norm (w : K), hw0]
    · have hm_ge1 : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      let y : K := (w : K) - 1
      have hy : y = 0 ∨ (m : ℤ) ≤ valL F K y := by
        rcases (hunit_ge1_K m hm_ge1 w).mp hw with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      have hw_eq : (w : K) = 1 + y := by dsimp [y]; ring
      obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp m hm_ge1 y hy
      have hz_m : z = 0 ∨ (m : ℤ) ≤ valL F K z := hval_le_K (by omega) hz
      have hyz_m : y + z = 0 ∨ (m : ℤ) ≤ valL F K (y + z) := hval_add_K (m : ℤ) y z hy hz_m
      have hyz_tr_in : y + z = 0 ∨
          (p : ℤ) * (m : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (y + z) := by
        apply hval_le_K _ hyz_m
        rw [hp_sub1_int]
        have hm_le_int : (m : ℤ) ≤ (t + 1 : ℤ) := by omega
        nlinarith
      have htr_m : traceLM F hLK (y + z) = 0 ∨ (m : ℤ) ≤ valL F L (traceLM F hLK (y + z)) :=
        htr_bound (m : ℤ) (y + z) hyz_tr_in
      have hny_m : normLM F hLK y = 0 ∨ (m : ℤ) ≤ valL F L (normLM F hLK y) :=
        hnorm_val_ge (m : ℤ) y hy
      have hsum_m := hval_add_L (m : ℤ) (traceLM F hLK (y + z)) (normLM F hLK y) htr_m hny_m
      have hsub_eq : (((Units.map (normLM F hLK) w : Lˣ) : L)) - 1 =
          traceLM F hLK (y + z) + normLM F hLK y := by
        change normLM F hLK (w : K) - 1 = _
        rw [hw_eq, hnorm_eq]
        ring
      rw [hunit_ge1_L m hm_ge1, hsub_eq]
      rcases hsum_m with h0 | hge
      · left
        exact sub_eq_zero.mp (hsub_eq.trans h0)
      · exact Or.inr hge

  have hnorm_cong_lt : ∀ (m : ℕ), 1 ≤ m → m < t → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      normLM F hLK (1 + y) - 1 - normLM F hLK y = 0 ∨
        ((m + 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLK (1 + y) - 1 - normLM F hLK y) := by
    intro m hm_ge1 hm_lt y hy
    obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp m hm_ge1 y hy
    have hz_m : z = 0 ∨ (m : ℤ) ≤ valL F K z := hval_le_K (by omega) hz
    have hyz_m : y + z = 0 ∨ (m : ℤ) ≤ valL F K (y + z) := hval_add_K (m : ℤ) y z hy hz_m
    have hyz_tr_in : y + z = 0 ∨
        (p : ℤ) * ((m + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (y + z) := by
      apply hval_le_K _ hyz_m
      rw [hp_sub1_int]
      have hm1_le : ((m + 1 : ℕ) : ℤ) ≤ (t : ℤ) := by omega
      have hm1_eq : ((m + 1 : ℕ) : ℤ) = (m : ℤ) + 1 := by push_cast; ring
      nlinarith
    have htr := htr_bound ((m + 1 : ℕ) : ℤ) (y + z) hyz_tr_in
    have heq : normLM F hLK (1 + y) - 1 - normLM F hLK y = traceLM F hLK (y + z) := by
      rw [hnorm_eq]
      ring
    rwa [heq]

  
  have hnorm_iff_mp : ∀ m ≤ t, ∀ w : Kˣ,
      Units.map (normLM F hLK) w ∈ unitGroup F L m → w ∈ unitGroup F K m := by
    intro m hm_le
    induction m with
    | zero =>
      intro w hnw
      rw [hunit0_K]
      have hnw0 : valL F L (normLM F hLK (w : K)) = 0 := (hunit0_L _).mp hnw
      rw [← hval_norm (w : K), hnw0]
    | succ m ih =>
      intro w hnw
      have hm_lt : m < t := hm_le
      have hw_m : w ∈ unitGroup F K m :=
        ih (by omega) w (hunit_anti_L (Nat.le_succ m) hnw)
      by_cases hm0 : m = 0
      · subst hm0
        have hw_val0 : valL F K (w : K) = 0 := (hunit0_K w).mp hw_m
        obtain ⟨x, hx_val, hdiff⟩ := hResSurj (w : K) (Or.inr (by omega))
        have hx_not_ge1 : ¬ (x = 0 ∨ 1 ≤ valL F L x) := by
          intro hx1
          have hinc_ge1 : IntermediateField.inclusion hLK x = 0 ∨
              1 ≤ valL F K (IntermediateField.inclusion hLK x) :=
            hval_le_K (by nlinarith) (hval_inc_ge 1 x hx1)
          have hw_ge1 := hval_add_K 1 ((w : K) - IntermediateField.inclusion hLK x)
            (IntermediateField.inclusion hLK x) hdiff hinc_ge1
          rw [sub_add_cancel] at hw_ge1
          rcases hw_ge1 with hw0 | hge
          · exact Units.ne_zero w hw0
          · omega
        have hx_ne0 : x ≠ 0 := fun h0 => hx_not_ge1 (Or.inl h0)
        have hx_val0 : valL F L x = 0 := by
          have h0 := hx_val.resolve_left hx_ne0
          have hnot1 : ¬ (1 ≤ valL F L x) := fun h1 => hx_not_ge1 (Or.inr h1)
          omega
        let u_x : Lˣ := Units.mk0 x hx_ne0
        let w_x : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom u_x
        have hwx_inv_val0 : valL F K (((w_x⁻¹ : Kˣ) : K)) = 0 := by
          rw [hval_inv_K w_x]
          change - valL F K (IntermediateField.inclusion hLK x) = 0
          rw [hval_alg x, hx_val0, mul_zero, neg_zero]
        let w₁ : Kˣ := w * w_x⁻¹
        have hw₁_sub : (w₁ : K) - 1 =
            ((w : K) - IntermediateField.inclusion hLK x) * (((w_x⁻¹ : Kˣ) : K)) := by
          change (w : K) * (((w_x⁻¹ : Kˣ) : K)) - 1 =
            ((w : K) - (w_x : K)) * (((w_x⁻¹ : Kˣ) : K))
          rw [sub_mul, Units.mul_inv]
        have hw₁_mem1 : w₁ ∈ unitGroup F K 1 := by
          rw [hunit_ge1_K 1 le_rfl w₁]
          have hmul := hval_mul_ge_K 1 0 ((w : K) - IntermediateField.inclusion hLK x)
            (((w_x⁻¹ : Kˣ) : K)) hdiff (Or.inr (by omega))
          rw [add_zero, ← hw₁_sub] at hmul
          rcases hmul with h0 | hge
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hge
        have hnw₁_mem1 : Units.map (normLM F hLK) w₁ ∈ unitGroup F L 1 :=
          hnorm_le 1 (by omega) w₁ hw₁_mem1
        have hnw_x : Units.map (normLM F hLK) w_x = u_x ^ p :=
          Units.ext (hnorm_inc x)
        have hux_pow_eq : u_x ^ p =
            (Units.map (normLM F hLK) w₁)⁻¹ * Units.map (normLM F hLK) w := by
          rw [← hnw_x, ← map_inv, ← map_mul]
          congr 1
          dsimp [w₁]
          rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
        have hux_pow_mem1 : u_x ^ p ∈ unitGroup F L 1 := by
          rw [hux_pow_eq]
          exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hnw₁_mem1) hnw
        have hxp_sub : x ^ p - 1 = 0 ∨ 1 ≤ valL F L (x ^ p - 1) := by
          rcases (hunit_ge1_L 1 le_rfl (u_x ^ p)).mp hux_pow_mem1 with h1 | hge
          · exact Or.inl (sub_eq_zero.mpr h1)
          · exact Or.inr hge
        let d : L := x - 1
        have hd_val : d = 0 ∨ 0 ≤ valL F L d :=
          hval_sub_ge_L 0 x 1 hx_val (Or.inr (by rw [hval1_L]))
        have hx_d : x = d + 1 := by dsimp [d]; ring
        have hdp_eq : d ^ p = (x ^ p - 1) -
            ∑ k ∈ Finset.range (p - 1), d ^ (k + 1) * (p.choose (k + 1) : L) := by
          have hp_eq : p + 1 = (p - 1) + 1 + 1 := by omega
          have hp1 : (p - 1) + 1 = p := by omega
          have hexp : x ^ p = (d + 1) ^ p := by rw [hx_d]
          rw [add_pow d 1 p, hp_eq, Finset.sum_range_succ, Finset.sum_range_succ'] at hexp
          simp only [hp1, Nat.sub_self, Nat.sub_zero, one_pow, mul_one,
            Nat.choose_self, Nat.choose_zero_right, Nat.cast_one, pow_zero] at hexp
          linear_combination -hexp
        have hmid_val : (∑ k ∈ Finset.range (p - 1), d ^ (k + 1) * (p.choose (k + 1) : L)) = 0 ∨
            1 ≤ valL F L (∑ k ∈ Finset.range (p - 1), d ^ (k + 1) * (p.choose (k + 1) : L)) := by
          apply hval_finset_sum_L (Finset.range (p - 1)) _ 1
          intro k hk
          have hk_lt : k < p - 1 := Finset.mem_range.mp hk
          have hdvd : p ∣ p.choose (k + 1) :=
            Nat.Prime.dvd_choose_self hPrime (by omega) (by omega)
          rcases hdvd with ⟨c_k, hc_k⟩
          have hchoose_val : (p.choose (k + 1) : L) = 0 ∨ 1 ≤ valL F L (p.choose (k + 1) : L) := by
            rw [hc_k, Nat.cast_mul]
            simpa using hval_mul_ge_L 1 0 (p : L) (c_k : L) hp_valL (hval_nat_L c_k)
          have hdk_val : d ^ (k + 1) = 0 ∨ 0 ≤ valL F L (d ^ (k + 1)) := by
            simpa using hval_pow_ge_L (k + 1) 0 d hd_val
          simpa using hval_mul_ge_L 0 1 (d ^ (k + 1)) (p.choose (k + 1) : L) hdk_val hchoose_val
        have hdp_val : d ^ p = 0 ∨ 1 ≤ valL F L (d ^ p) := by
          rw [hdp_eq]
          exact hval_sub_ge_L 1 (x ^ p - 1) _ hxp_sub hmid_val
        have hd_ge1 : d = 0 ∨ 1 ≤ valL F L d := by
          by_cases hd0 : d = 0
          · exact Or.inl hd0
          · right
            have hdp_ne : d ^ p ≠ 0 := pow_ne_zero p hd0
            have hge1 : 1 ≤ valL F L (d ^ p) := hdp_val.resolve_left hdp_ne
            rw [hval_pow_L d p hd0] at hge1
            nlinarith
        have hinc_d : IntermediateField.inclusion hLK x - 1 = 0 ∨
            1 ≤ valL F K (IntermediateField.inclusion hLK x - 1) := by
          have heq : IntermediateField.inclusion hLK x - 1 =
              IntermediateField.inclusion hLK d := by
            dsimp [d]
            rw [map_sub, map_one]
          rw [heq]
          exact hval_le_K (by nlinarith) (hval_inc_ge 1 d hd_ge1)
        have hw_sub1 := hval_add_K 1 ((w : K) - IntermediateField.inclusion hLK x)
          (IntermediateField.inclusion hLK x - 1) hdiff hinc_d
        have hw_sub_eq : ((w : K) - IntermediateField.inclusion hLK x) +
            (IntermediateField.inclusion hLK x - 1) = (w : K) - 1 := by ring
        rw [hw_sub_eq] at hw_sub1
        rw [hunit_ge1_K 1 le_rfl w]
        rcases hw_sub1 with h0 | hge
        · exact Or.inl (sub_eq_zero.mp h0)
        · exact Or.inr hge
      · have hm_ge1 : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
        let y : K := (w : K) - 1
        have hy : y = 0 ∨ (m : ℤ) ≤ valL F K y := by
          rcases (hunit_ge1_K m hm_ge1 w).mp hw_m with h1 | hge
          · exact Or.inl (sub_eq_zero.mpr h1)
          · exact Or.inr hge
        have hw_eq : (w : K) = 1 + y := by dsimp [y]; ring
        have hnw_sub : normLM F hLK (1 + y) - 1 = 0 ∨
            ((m + 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLK (1 + y) - 1) := by
          have h := (hunit_ge1_L (m + 1) (by omega) (Units.map (normLM F hLK) w)).mp hnw
          change normLM F hLK (w : K) = 1 ∨
            ((m + 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLK (w : K) - 1) at h
          rw [hw_eq] at h
          rcases h with h1 | hge
          · exact Or.inl (sub_eq_zero.mpr h1)
          · exact Or.inr hge
        have hcong := hnorm_cong_lt m hm_ge1 hm_lt y hy
        have hny := hval_sub_ge_L ((m + 1 : ℕ) : ℤ)
          (normLM F hLK (1 + y) - 1) (normLM F hLK (1 + y) - 1 - normLM F hLK y) hnw_sub hcong
        have hny_eq : (normLM F hLK (1 + y) - 1) -
            (normLM F hLK (1 + y) - 1 - normLM F hLK y) = normLM F hLK y := by ring
        rw [hny_eq] at hny
        rw [hunit_ge1_K (m + 1) (by omega) w]
        by_cases hy0 : y = 0
        · left
          exact sub_eq_zero.mp hy0
        · right
          have hge := hny.resolve_left (hnorm_ne_zero y hy0)
          rwa [hval_norm y] at hge

  have hnorm_iff : ∀ m ≤ t, ∀ w : Kˣ,
      Units.map (normLM F hLK) w ∈ unitGroup F L m ↔ w ∈ unitGroup F K m :=
    fun m hm w => ⟨hnorm_iff_mp m hm w, hnorm_le m (by omega) w⟩

  
  have hnorm_surj_lt : ∀ m < t, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F K m,
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (m + 1) := by
    intro m hm_lt u hu
    have hu_inv_val0 : valL F L (((u⁻¹ : Lˣ) : L)) = 0 := by
      rw [hval_inv_L u, hunit_val0_L m u hu, neg_zero]
    by_cases hm0 : m = 0
    · subst hm0
      have hu_val0 : valL F L (u : L) = 0 := (hunit0_L u).mp hu
      obtain ⟨s, hs_val, hdiff⟩ := hfrob_surj (u : L) (Or.inr (by omega))
      have hs_not_ge1 : ¬ (s = 0 ∨ 1 ≤ valL F L s) := by
        intro hs1
        have hsp_ge1 : s ^ p = 0 ∨ 1 ≤ valL F L (s ^ p) :=
          hval_le_L (by nlinarith) (hval_pow_ge_L p 1 s hs1)
        have hu_ge1 := hval_add_L 1 ((u : L) - s ^ p) (s ^ p) hdiff hsp_ge1
        rw [sub_add_cancel] at hu_ge1
        rcases hu_ge1 with hu0 | hge
        · exact Units.ne_zero u hu0
        · omega
      have hs_ne0 : s ≠ 0 := fun h0 => hs_not_ge1 (Or.inl h0)
      have hs_val0 : valL F L s = 0 := by
        have h0 := hs_val.resolve_left hs_ne0
        have hnot1 : ¬ (1 ≤ valL F L s) := fun h1 => hs_not_ge1 (Or.inr h1)
        omega
      let u_s : Lˣ := Units.mk0 s hs_ne0
      let w : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom u_s
      have hw_mem0 : w ∈ unitGroup F K 0 := by
        rw [hunit0_K]
        change valL F K (IntermediateField.inclusion hLK s) = 0
        rw [hval_alg s, hs_val0, mul_zero]
      have hnw_val : ((Units.map (normLM F hLK) w : Lˣ) : L) = s ^ p :=
        hnorm_inc s
      have hsub_eq : ((((Units.map (normLM F hLK) w) * u⁻¹ : Lˣ) : L)) - 1 =
          -(((u : L) - s ^ p) * (((u⁻¹ : Lˣ) : L))) := by
        change ((Units.map (normLM F hLK) w : Lˣ) : L) * (((u⁻¹ : Lˣ) : L)) - 1 = _
        rw [hnw_val, sub_mul, Units.mul_inv]
        ring
      refine ⟨w, hw_mem0, ?_⟩
      rw [hunit_ge1_L 1 le_rfl]
      have hmul := hval_mul_ge_L 1 0 ((u : L) - s ^ p) (((u⁻¹ : Lˣ) : L))
        hdiff (Or.inr (by omega))
      rw [add_zero] at hmul
      have hneg_mul : -(((u : L) - s ^ p) * (((u⁻¹ : Lˣ) : L))) = 0 ∨
          1 ≤ valL F L (-(((u : L) - s ^ p) * (((u⁻¹ : Lˣ) : L)))) := by
        rcases hmul with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_L]
          exact hge
      rw [← hsub_eq] at hneg_mul
      rcases hneg_mul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
    · have hm_ge1 : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hu_sub : (u : L) - 1 = 0 ∨ (m : ℤ) ≤ valL F L ((u : L) - 1) := by
        rcases (hunit_ge1_L m hm_ge1 u).mp hu with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      let x₀ : L := ((u : L) - 1) * ((((ϖ_L ^ m : Lˣ)⁻¹ : Lˣ) : L))
      have hx₀_val : x₀ = 0 ∨ 0 ≤ valL F L x₀ := by
        have hmul := hval_mul_ge_L (m : ℤ) (-(m : ℤ))
          ((u : L) - 1) ((((ϖ_L ^ m : Lˣ)⁻¹ : Lˣ) : L))
          hu_sub (Or.inr (by rw [hϖ_L_pow_inv_val m]))
        rwa [add_neg_cancel] at hmul
      have hu_x₀ : (u : L) - 1 = x₀ * (((ϖ_L ^ m : Lˣ) : L)) := by
        change (u : L) - 1 = ((u : L) - 1) * ((((ϖ_L ^ m : Lˣ)⁻¹ : Lˣ) : L)) * (((ϖ_L ^ m : Lˣ) : L))
        rw [mul_assoc, Units.inv_mul, mul_one]
      obtain ⟨s, hs_val, hdiff⟩ := hfrob_surj x₀ hx₀_val
      let y : K := IntermediateField.inclusion hLK s * (((ϖ_K ^ m : Kˣ) : K))
      have hy_val : y = 0 ∨ (m : ℤ) ≤ valL F K y := by
        have hinc_s := hval_inc_ge 0 s hs_val
        rw [mul_zero] at hinc_s
        have hmul := hval_mul_ge_K 0 (m : ℤ)
          (IntermediateField.inclusion hLK s) (((ϖ_K ^ m : Kˣ) : K))
          hinc_s (Or.inr (by rw [hϖ_K_pow_val m]))
        rwa [zero_add] at hmul
      have h1y_ne : 1 + y ≠ 0 := h1_add_ne_zero_K (hval_le_K (by omega) hy_val)
      let w : Kˣ := Units.mk0 (1 + y) h1y_ne
      have hw_mem : w ∈ unitGroup F K m := by
        rw [hunit_ge1_K m hm_ge1 w]
        have hsub : (w : K) - 1 = y := by change (1 + y) - 1 = y; ring
        rw [hsub]
        rcases hy_val with h0 | hge
        · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
        · exact Or.inr hge
      have hny_eq : normLM F hLK y = s ^ p * (((ϖ_L ^ m : Lˣ) : L)) := by
        dsimp [y]
        rw [map_mul, hnorm_inc s]
        congr 1
        have hmap_pow : Units.map (normLM F hLK) (ϖ_K ^ m) = ϖ_L ^ m := by
          rw [map_pow, hϖ_norm]
        exact congrArg Units.val hmap_pow
      have hcong := hnorm_cong_lt m hm_ge1 hm_lt y hy_val
      have hrem_x₀ : (x₀ - s ^ p) * (((ϖ_L ^ m : Lˣ) : L)) = 0 ∨
          ((m + 1 : ℕ) : ℤ) ≤ valL F L ((x₀ - s ^ p) * (((ϖ_L ^ m : Lˣ) : L))) := by
        have hmul := hval_mul_ge_L 1 (m : ℤ) (x₀ - s ^ p) (((ϖ_L ^ m : Lˣ) : L))
          hdiff (Or.inr (by rw [hϖ_L_pow_val m]))
        have heq : (1 : ℤ) + (m : ℤ) = ((m + 1 : ℕ) : ℤ) := by push_cast; ring
        rwa [heq] at hmul
      have hnw_sub_u_eq : ((Units.map (normLM F hLK) w : Lˣ) : L) - (u : L) =
          (normLM F hLK (1 + y) - 1 - normLM F hLK y) -
            (x₀ - s ^ p) * (((ϖ_L ^ m : Lˣ) : L)) := by
        change normLM F hLK (1 + y) - (u : L) = _
        have hu_eq' : (u : L) = 1 + ((u : L) - 1) := by ring
        rw [hu_eq', hu_x₀, hny_eq]
        ring
      have hnw_sub_u := hval_sub_ge_L ((m + 1 : ℕ) : ℤ)
        (normLM F hLK (1 + y) - 1 - normLM F hLK y)
        ((x₀ - s ^ p) * (((ϖ_L ^ m : Lˣ) : L))) hcong hrem_x₀
      rw [← hnw_sub_u_eq] at hnw_sub_u
      have hprod_sub_eq : ((((Units.map (normLM F hLK) w) * u⁻¹ : Lˣ) : L)) - 1 =
          (((Units.map (normLM F hLK) w : Lˣ) : L) - (u : L)) * (((u⁻¹ : Lˣ) : L)) := by
        change ((Units.map (normLM F hLK) w : Lˣ) : L) * (((u⁻¹ : Lˣ) : L)) - 1 = _
        rw [sub_mul, Units.mul_inv]
      refine ⟨w, hw_mem, ?_⟩
      rw [hunit_ge1_L (m + 1) (by omega)]
      have hmul := hval_mul_ge_L ((m + 1 : ℕ) : ℤ) 0
        (((Units.map (normLM F hLK) w : Lˣ) : L) - (u : L)) (((u⁻¹ : Lˣ) : L))
        hnw_sub_u (Or.inr (by omega))
      rw [add_zero, ← hprod_sub_eq] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge

  
  have hnorm_gt_le : ∀ r ≥ t + 1, ∀ w ∈ unitGroup F K (t + 1 + p * (r - t)),
      Units.map (normLM F hLK) w ∈ unitGroup F L (r + 1) := by
    intro r hr_ge w hw
    set M : ℕ := t + 1 + p * (r - t)
    have hM_ge1 : 1 ≤ M := by omega
    have hr1_ge1 : 1 ≤ r + 1 := by omega
    have hM_int : (M : ℤ) = (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
      dsimp [M]
      have hrt : (r - t : ℕ) = (r : ℤ) - (t : ℤ) := by omega
      rw [hp_sub1_int]
      push_cast
      rw [hrt]
      ring
    have hr1_le_M : ((r + 1 : ℕ) : ℤ) ≤ (M : ℤ) := by
      dsimp [M]
      have hrt_ge1 : (1 : ℤ) ≤ ((r - t : ℕ) : ℤ) := by omega
      have hrt_eq : ((r - t : ℕ) : ℤ) = (r : ℤ) - (t : ℤ) := by omega
      push_cast
      nlinarith
    let y : K := (w : K) - 1
    have hy : y = 0 ∨ (M : ℤ) ≤ valL F K y := by
      rcases (hunit_ge1_K M hM_ge1 w).mp hw with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    have hw_eq : (w : K) = 1 + y := by dsimp [y]; ring
    obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp M hM_ge1 y hy
    have hz_M : z = 0 ∨ (M : ℤ) ≤ valL F K z := hval_le_K (by omega) hz
    have hyz_M : y + z = 0 ∨ (M : ℤ) ≤ valL F K (y + z) := hval_add_K (M : ℤ) y z hy hz_M
    have hyz_tr_in : y + z = 0 ∨
        (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (y + z) := by
      rwa [← hM_int]
    have htr_r1 := htr_bound ((r + 1 : ℕ) : ℤ) (y + z) hyz_tr_in
    have hny_r1 : normLM F hLK y = 0 ∨ ((r + 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLK y) :=
      hnorm_val_ge ((r + 1 : ℕ) : ℤ) y (hval_le_K hr1_le_M hy)
    have hsum_r1 := hval_add_L ((r + 1 : ℕ) : ℤ)
      (traceLM F hLK (y + z)) (normLM F hLK y) htr_r1 hny_r1
    have hsub_eq : (((Units.map (normLM F hLK) w : Lˣ) : L)) - 1 =
        traceLM F hLK (y + z) + normLM F hLK y := by
      change normLM F hLK (w : K) - 1 = _
      rw [hw_eq, hnorm_eq]
      ring
    rw [hunit_ge1_L (r + 1) hr1_ge1, hsub_eq]
    rcases hsum_r1 with h0 | hge
    · left
      exact sub_eq_zero.mp (hsub_eq.trans h0)
    · exact Or.inr hge

  have hnorm_gt_surj : ∀ r ≥ t + 1, ∀ u ∈ unitGroup F L r,
      ∃ w ∈ unitGroup F K (t + p * (r - t)),
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (r + 1) := by
    intro r hr_ge u hu
    set N : ℕ := t + p * (r - t)
    have hrt_ge1 : 1 ≤ r - t := by omega
    have hN_ge3 : 3 ≤ N := by
      dsimp [N]
      nlinarith
    have hN_ge1 : 1 ≤ N := by omega
    have hr_ge1 : 1 ≤ r := by omega
    by_cases hu1 : (u : L) = 1
    · have hu_eq1 : u = 1 := Units.ext hu1
      refine ⟨1, Subgroup.one_mem _, ?_⟩
      rw [hu_eq1, map_one, inv_one, mul_one]
      exact Subgroup.one_mem _
    · let x₀ : L := (u : L) - 1
      have hx₀_ne : x₀ ≠ 0 := sub_ne_zero.mpr hu1
      have hx₀_val : (r : ℤ) ≤ valL F L x₀ :=
        ((hunit_ge1_L r hr_ge1 u).mp hu).resolve_left hu1
      obtain ⟨y₀, hy₀_tr, _, hy₀_nz⟩ := htr_surj x₀
      obtain ⟨hy₀_ne, hy₀_val⟩ := hy₀_nz hx₀_ne
      have hN_int : (N : ℤ) =
          (p : ℤ) * (r : ℤ) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
        dsimp [N]
        have hrt_eq : ((r - t : ℕ) : ℤ) = (r : ℤ) - (t : ℤ) := by omega
        rw [hp_sub1_int]
        push_cast
        rw [hrt_eq]
        ring
      have hy₀_geN : (N : ℤ) ≤ valL F K y₀ := by
        rw [hy₀_val, hN_int]
        nlinarith
      have h1y₀_ne : 1 + y₀ ≠ 0 :=
        h1_add_ne_zero_K (Or.inr (by omega))
      let w : Kˣ := Units.mk0 (1 + y₀) h1y₀_ne
      have hw_mem : w ∈ unitGroup F K N := by
        rw [hunit_ge1_K N hN_ge1 w]
        right
        have hsub : (w : K) - 1 = y₀ := by change (1 + y₀) - 1 = y₀; ring
        rw [hsub]
        exact hy₀_geN
      obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp N hN_ge1 y₀ (Or.inr hy₀_geN)
      have hz_tr_in : z = 0 ∨
          (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K z := by
        apply hval_le_K _ hz
        have hM_eq : (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) =
            (N : ℤ) + 1 := by
          rw [hN_int, hp_sub1_int]
          push_cast
          ring
        rw [hM_eq]
        omega
      have htr_z := htr_bound ((r + 1 : ℕ) : ℤ) z hz_tr_in
      have hr1_le_N : ((r + 1 : ℕ) : ℤ) ≤ (N : ℤ) := by
        dsimp [N]
        have hrt_eq : ((r - t : ℕ) : ℤ) = (r : ℤ) - (t : ℤ) := by omega
        have hrt_int : (1 : ℤ) ≤ ((r - t : ℕ) : ℤ) := by omega
        push_cast
        nlinarith
      have hny₀_r1 : normLM F hLK y₀ = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLK y₀) :=
        hnorm_val_ge ((r + 1 : ℕ) : ℤ) y₀ (Or.inr (le_trans hr1_le_N hy₀_geN))
      have hsum_r1 := hval_add_L ((r + 1 : ℕ) : ℤ)
        (traceLM F hLK z) (normLM F hLK y₀) htr_z hny₀_r1
      have hnw_sub_u : ((Units.map (normLM F hLK) w : Lˣ) : L) - (u : L) =
          traceLM F hLK z + normLM F hLK y₀ := by
        change normLM F hLK (1 + y₀) - (u : L) = _
        have hu_eq' : (u : L) = 1 + x₀ := by dsimp [x₀]; ring
        rw [hu_eq', hnorm_eq, map_add (traceLM F hLK) y₀ z, hy₀_tr]
        ring
      have hu_inv_val0 : valL F L (((u⁻¹ : Lˣ) : L)) = 0 := by
        rw [hval_inv_L u, hunit_val0_L r u hu, neg_zero]
      have hprod_sub : ((((Units.map (normLM F hLK) w) * u⁻¹ : Lˣ) : L)) - 1 =
          (((Units.map (normLM F hLK) w : Lˣ) : L) - (u : L)) * (((u⁻¹ : Lˣ) : L)) := by
        change ((Units.map (normLM F hLK) w : Lˣ) : L) * (((u⁻¹ : Lˣ) : L)) - 1 = _
        rw [sub_mul, Units.mul_inv]
      refine ⟨w, hw_mem, ?_⟩
      rw [hunit_ge1_L (r + 1) (by omega)]
      rw [← hnw_sub_u] at hsum_r1
      have hmul := hval_mul_ge_L ((r + 1 : ℕ) : ℤ) 0
        (((Units.map (normLM F hLK) w : Lˣ) : L) - (u : L)) (((u⁻¹ : Lˣ) : L))
        hsum_r1 (Or.inr (by omega))
      rw [add_zero, ← hprod_sub] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge

  
  have hstep_triv : ∀ r ≥ t + 1,
      (∀ v ∈ unitGroup F L (r + 1), ν₁ v = 1) →
        (∀ u ∈ unitGroup F L r, ν₁ u = 1) := by
    intro r hr_ge htriv_r1 u hu
    obtain ⟨w, _, hrem⟩ := hnorm_gt_surj r hr_ge u hu
    set v : Lˣ := (Units.map (normLM F hLK) w) * u⁻¹
    have hv1 : ν₁ v = 1 := htriv_r1 v hrem
    have hnw1 : ν₁ (Units.map (normLM F hLK) w) = 1 :=
      (hν₁_ker (Units.map (normLM F hLK) w)).mp ⟨w, rfl⟩
    have hu_eq : u = v⁻¹ * Units.map (normLM F hLK) w := by
      dsimp [v]
      rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
    rw [hu_eq, map_mul, map_inv, hv1, hnw1, inv_one, one_mul]
  have hdesc_triv : ∀ k : ℕ,
      (∀ v ∈ unitGroup F L (t + 1 + k), ν₁ v = 1) →
        (∀ u ∈ unitGroup F L (t + 1), ν₁ u = 1) := by
    intro k
    induction k with
    | zero =>
      intro h
      simpa using h
    | succ k ih =>
      intro h
      apply ih
      exact hstep_triv (t + 1 + k) (by omega) h
  have hcond_le : condExp F L ν₁ ≤ t + 1 := by
    set b : ℕ := condExp F L ν₁
    have hb_triv : ∀ v ∈ unitGroup F L b, ν₁ v = 1 := by
      intro v hv
      have h := hν₁_cond 1 hp_gt1 v
      rw [pow_one ν₁] at h
      exact h hv
    rcases le_or_gt b (t + 1) with hle | hgt
    · exact hle
    · have hb_eq : b = t + 1 + (b - (t + 1)) := by omega
      rw [hb_eq] at hb_triv
      have htriv_t1 := hdesc_triv (b - (t + 1)) hb_triv
      exact Nat.sInf_le htriv_t1

  
  let s_L (a : k_L) : L := if a = 0 then 0 else (hresL_surj a).choose
  have hsL_0 : s_L 0 = 0 := if_pos rfl
  have hsL_val : ∀ a : k_L, s_L a = 0 ∨ 0 ≤ valL F L (s_L a) := by
    intro a
    dsimp [s_L]
    split_ifs with ha
    · exact Or.inl rfl
    · exact (hresL_surj a).choose_spec.1
  have hsL_res : ∀ a : k_L, resL (s_L a) = a := by
    intro a
    dsimp [s_L]
    split_ifs with ha
    · rw [ha, hresL_0]
    · exact (hresL_surj a).choose_spec.2
  let y_a (a : k_L) : K := IntermediateField.inclusion hLK (s_L a) * (((ϖ_K ^ t : Kˣ) : K))
  have hy_a_val : ∀ a : k_L, y_a a = 0 ∨ (t : ℤ) ≤ valL F K (y_a a) := by
    intro a
    have hinc := hval_inc_ge 0 (s_L a) (hsL_val a)
    rw [mul_zero] at hinc
    have hmul := hval_mul_ge_K 0 (t : ℤ)
      (IntermediateField.inclusion hLK (s_L a)) (((ϖ_K ^ t : Kˣ) : K))
      hinc (Or.inr (by rw [hϖ_K_pow_val t]))
    rwa [zero_add] at hmul
  have h1ya_ne : ∀ a : k_L, 1 + y_a a ≠ 0 :=
    fun a => h1_add_ne_zero_K (hval_le_K (by omega) (hy_a_val a))
  let w_a (a : k_L) : Kˣ := Units.mk0 (1 + y_a a) (h1ya_ne a)
  have hw_a_mem : ∀ a : k_L, w_a a ∈ unitGroup F K t := by
    intro a
    rw [hunit_ge1_K t ht_ge1 (w_a a)]
    have hsub : ((w_a a : K) - 1) = y_a a := by change (1 + y_a a) - 1 = y_a a; ring
    rw [hsub]
    rcases hy_a_val a with h0 | hge
    · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
    · exact Or.inr hge
  have hw_a_0 : w_a 0 = 1 := by
    apply Units.ext
    change 1 + IntermediateField.inclusion hLK (s_L 0) * (((ϖ_K ^ t : Kˣ) : K)) = 1
    rw [hsL_0, map_zero, zero_mul, add_zero]

  have happrox_t : ∀ w ∈ unitGroup F K t,
      ∃ a : k_L, w * (w_a a)⁻¹ ∈ unitGroup F K (t + 1) := by
    intro w hw
    have hw_sub : (w : K) - 1 = 0 ∨ (t : ℤ) ≤ valL F K ((w : K) - 1) := by
      rcases (hunit_ge1_K t ht_ge1 w).mp hw with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    let y : K := ((w : K) - 1) * ((((ϖ_K ^ t : Kˣ)⁻¹ : Kˣ) : K))
    have hy_val : y = 0 ∨ 0 ≤ valL F K y := by
      have hmul := hval_mul_ge_K (t : ℤ) (-(t : ℤ))
        ((w : K) - 1) ((((ϖ_K ^ t : Kˣ)⁻¹ : Kˣ) : K))
        hw_sub (Or.inr (by rw [hϖ_K_pow_inv_val t]))
      rwa [add_neg_cancel] at hmul
    obtain ⟨x, hx_val, hyx⟩ := hResSurj y hy_val
    let a : k_L := resL x
    have hneg_sLa : -(s_L a) = 0 ∨ 0 ≤ valL F L (-(s_L a)) := by
      rcases hsL_val a with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right
        rw [hval_neg_L]
        exact hge
    have hx_sub_val0 : x - s_L a = 0 ∨ 0 ≤ valL F L (x - s_L a) :=
      hval_sub_ge_L 0 x (s_L a) hx_val (hsL_val a)
    have hx_sub_res0 : resL (x - s_L a) = 0 := by
      rw [sub_eq_add_neg, (hresL_ring x (-(s_L a)) hx_val hneg_sLa).1,
        (hresL_ring (s_L a) 0 (hsL_val a) (Or.inl rfl)).2.2, hsL_res a]
      dsimp [a]
      exact add_neg_cancel (resL x)
    have hx_sub_ge1 : x - s_L a = 0 ∨ 1 ≤ valL F L (x - s_L a) :=
      (hresL_ker (x - s_L a) hx_sub_val0).mp hx_sub_res0
    have hinc_sub_ge1 : IntermediateField.inclusion hLK x - IntermediateField.inclusion hLK (s_L a) = 0 ∨
        1 ≤ valL F K (IntermediateField.inclusion hLK x - IntermediateField.inclusion hLK (s_L a)) := by
      rw [← map_sub]
      exact hval_le_K (by nlinarith) (hval_inc_ge 1 (x - s_L a) hx_sub_ge1)
    have hy_sub_sLa := hval_add_K 1 (y - IntermediateField.inclusion hLK x)
      (IntermediateField.inclusion hLK x - IntermediateField.inclusion hLK (s_L a))
      hyx hinc_sub_ge1
    have hy_sub_eq : (y - IntermediateField.inclusion hLK x) +
        (IntermediateField.inclusion hLK x - IntermediateField.inclusion hLK (s_L a)) =
          y - IntermediateField.inclusion hLK (s_L a) := by ring
    rw [hy_sub_eq] at hy_sub_sLa
    have hw_sub_wa_eq : (w : K) - (w_a a : K) =
        (y - IntermediateField.inclusion hLK (s_L a)) * (((ϖ_K ^ t : Kˣ) : K)) := by
      have h1 : ((w : K) - 1) * ((((ϖ_K ^ t : Kˣ)⁻¹ : Kˣ) : K)) * (((ϖ_K ^ t : Kˣ) : K)) =
          (w : K) - 1 := by
        rw [mul_assoc, Units.inv_mul, mul_one]
      change (w : K) - (1 + IntermediateField.inclusion hLK (s_L a) * (((ϖ_K ^ t : Kˣ) : K))) =
        (((w : K) - 1) * ((((ϖ_K ^ t : Kˣ)⁻¹ : Kˣ) : K)) - IntermediateField.inclusion hLK (s_L a)) *
          (((ϖ_K ^ t : Kˣ) : K))
      linear_combination -h1
    have hw_sub_wa_val : (w : K) - (w_a a : K) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F K ((w : K) - (w_a a : K)) := by
      rw [hw_sub_wa_eq]
      have hmul := hval_mul_ge_K 1 (t : ℤ)
        (y - IntermediateField.inclusion hLK (s_L a)) (((ϖ_K ^ t : Kˣ) : K))
        hy_sub_sLa (Or.inr (by rw [hϖ_K_pow_val t]))
      have heq : (1 : ℤ) + (t : ℤ) = ((t + 1 : ℕ) : ℤ) := by push_cast; ring
      rwa [heq] at hmul
    have hwa_inv_val0 : valL F K ((((w_a a)⁻¹ : Kˣ) : K)) = 0 := by
      rw [hval_inv_K (w_a a), hunit_val0_K t (w_a a) (hw_a_mem a), neg_zero]
    have hprod_sub_eq : (((w * (w_a a)⁻¹ : Kˣ) : K)) - 1 =
        ((w : K) - (w_a a : K)) * ((((w_a a)⁻¹ : Kˣ) : K)) := by
      change (w : K) * ((((w_a a)⁻¹ : Kˣ) : K)) - 1 = _
      rw [sub_mul, Units.mul_inv]
    refine ⟨a, ?_⟩
    rw [hunit_ge1_K (t + 1) (by omega)]
    have hmul := hval_mul_ge_K ((t + 1 : ℕ) : ℤ) 0
      ((w : K) - (w_a a : K)) ((((w_a a)⁻¹ : Kˣ) : K))
      hw_sub_wa_val (Or.inr (by omega))
    rw [add_zero, ← hprod_sub_eq] at hmul
    rcases hmul with h0 | hge
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hge

  
  let nw_a (a : k_L) : Lˣ := Units.map (normLM F hLK) (w_a a)
  have hnw_a_mem : ∀ a : k_L, nw_a a ∈ unitGroup F L t :=
    fun a => hnorm_le t (by omega) (w_a a) (hw_a_mem a)
  let z_a (a : k_L) : L := ((nw_a a : L) - 1) * ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L))
  have hz_a_val : ∀ a : k_L, z_a a = 0 ∨ 0 ≤ valL F L (z_a a) := by
    intro a
    have hsub : (nw_a a : L) - 1 = 0 ∨ (t : ℤ) ≤ valL F L ((nw_a a : L) - 1) := by
      rcases (hunit_ge1_L t ht_ge1 (nw_a a)).mp (hnw_a_mem a) with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    have hmul := hval_mul_ge_L (t : ℤ) (-(t : ℤ))
      ((nw_a a : L) - 1) ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L))
      hsub (Or.inr (by rw [hϖ_L_pow_inv_val t]))
    rwa [add_neg_cancel] at hmul
  let φ : k_L → k_L := fun a => resL (z_a a)
  have hφ_0 : φ 0 = 0 := by
    have hnw0 : nw_a 0 = 1 := by dsimp [nw_a]; rw [hw_a_0, map_one]
    have hz0 : z_a 0 = 0 := by dsimp [z_a]; rw [hnw0, Units.val_one, sub_self, zero_mul]
    dsimp [φ]
    rw [hz0, hresL_0]
  obtain ⟨a_star, hrem_star⟩ := happrox_t w_star hw_star_t
  have ha_star_ne : a_star ≠ 0 := by
    intro ha0
    rw [ha0, hw_a_0, inv_one, mul_one] at hrem_star
    exact hw_star_nt1 hrem_star
  have hwa_star_mem_t1 : (w_a a_star) * w_star⁻¹ ∈ unitGroup F K (t + 1) := by
    have hinv := Subgroup.inv_mem (unitGroup F K (t + 1)) hrem_star
    have heq : (w_star * (w_a a_star)⁻¹)⁻¹ = (w_a a_star) * w_star⁻¹ := by
      rw [mul_inv_rev, inv_inv]
    rwa [heq] at hinv
  have hnw_star_mem_t1 : nw_a a_star ∈ unitGroup F L (t + 1) := by
    have h := hnorm_le (t + 1) le_rfl ((w_a a_star) * w_star⁻¹) hwa_star_mem_t1
    rw [map_mul, map_inv, hw_star_norm, inv_one, mul_one] at h
    exact h
  have hz_star_ge1 : z_a a_star = 0 ∨ 1 ≤ valL F L (z_a a_star) := by
    have hsub : (nw_a a_star : L) - 1 = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F L ((nw_a a_star : L) - 1) := by
      rcases (hunit_ge1_L (t + 1) (by omega) (nw_a a_star)).mp hnw_star_mem_t1 with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    have hmul := hval_mul_ge_L ((t + 1 : ℕ) : ℤ) (-(t : ℤ))
      ((nw_a a_star : L) - 1) ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L))
      hsub (Or.inr (by rw [hϖ_L_pow_inv_val t]))
    have heq : ((t + 1 : ℕ) : ℤ) + -(t : ℤ) = 1 := by push_cast; ring
    rwa [heq] at hmul
  have hφ_star : φ a_star = 0 :=
    (hresL_ker (z_a a_star) (hz_a_val a_star)).mpr hz_star_ge1
  have hnot_inj : ¬ Function.Injective φ :=
    fun hinj => ha_star_ne (hinj (hφ_star.trans hφ_0.symm))
  have hnot_surj : ¬ Function.Surjective φ :=
    mt Finite.injective_iff_surjective.mpr hnot_inj
  unfold Function.Surjective at hnot_surj
  push_neg at hnot_surj
  obtain ⟨b₀, hb₀⟩ := hnot_surj

  
  let x₀_b : L := s_L b₀ * (((ϖ_L ^ t : Lˣ) : L))
  have hx₀_b_val : x₀_b = 0 ∨ (t : ℤ) ≤ valL F L x₀_b := by
    have hmul := hval_mul_ge_L 0 (t : ℤ) (s_L b₀) (((ϖ_L ^ t : Lˣ) : L))
      (hsL_val b₀) (Or.inr (by rw [hϖ_L_pow_val t]))
    rwa [zero_add] at hmul
  have h1x₀_b_ne : 1 + x₀_b ≠ 0 :=
    h1_add_ne_zero_L (hval_le_L (by omega) hx₀_b_val)
  let u₀ : Lˣ := Units.mk0 (1 + x₀_b) h1x₀_b_ne
  have hu₀_mem : u₀ ∈ unitGroup F L t := by
    rw [hunit_ge1_L t ht_ge1 u₀]
    have hsub : (u₀ : L) - 1 = x₀_b := by change (1 + x₀_b) - 1 = x₀_b; ring
    rw [hsub]
    rcases hx₀_b_val with h0 | hge
    · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
    · exact Or.inr hge
  have hu₀_not_norm : u₀ ∉ Set.range (Units.map (normLM F hLK)) := by
    rintro ⟨w, hw⟩
    have hnw_mem_t : Units.map (normLM F hLK) w ∈ unitGroup F L t := by
      rw [hw]
      exact hu₀_mem
    have hw_mem_t : w ∈ unitGroup F K t := (hnorm_iff t le_rfl w).mp hnw_mem_t
    obtain ⟨a, hrem_a⟩ := happrox_t w hw_mem_t
    have hnorm_rem_a : u₀ * (nw_a a)⁻¹ ∈ unitGroup F L (t + 1) := by
      have h := hnorm_le (t + 1) le_rfl (w * (w_a a)⁻¹) hrem_a
      rwa [map_mul, map_inv, hw] at h
    have hprod_sub : (((u₀ * (nw_a a)⁻¹ : Lˣ) : L)) - 1 = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F L ((((u₀ * (nw_a a)⁻¹ : Lˣ) : L)) - 1) := by
      rcases (hunit_ge1_L (t + 1) (by omega) (u₀ * (nw_a a)⁻¹)).mp hnorm_rem_a with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    have hnw_a_val0 : valL F L (nw_a a : L) = 0 :=
      hunit_val0_L t (nw_a a) (hnw_a_mem a)
    have hdiff_u₀ : (u₀ : L) - (nw_a a : L) =
        ((((u₀ * (nw_a a)⁻¹ : Lˣ) : L)) - 1) * (nw_a a : L) := by
      change (u₀ : L) - (nw_a a : L) =
        ((u₀ : L) * ((((nw_a a)⁻¹ : Lˣ) : L)) - 1) * (nw_a a : L)
      rw [sub_mul, mul_assoc, Units.inv_mul, mul_one, one_mul]
    have hdiff_u₀_val : (u₀ : L) - (nw_a a : L) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F L ((u₀ : L) - (nw_a a : L)) := by
      rw [hdiff_u₀]
      have hmul := hval_mul_ge_L ((t + 1 : ℕ) : ℤ) 0
        ((((u₀ * (nw_a a)⁻¹ : Lˣ) : L)) - 1) (nw_a a : L)
        hprod_sub (Or.inr (by omega))
      rwa [add_zero] at hmul
    have hsb_sub_za_eq : s_L b₀ - z_a a =
        ((u₀ : L) - (nw_a a : L)) * ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) := by
      have h1 : s_L b₀ * (((ϖ_L ^ t : Lˣ) : L)) * ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) = s_L b₀ := by
        rw [mul_assoc, Units.mul_inv, mul_one]
      change s_L b₀ - ((nw_a a : L) - 1) * ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) =
        ((1 + s_L b₀ * (((ϖ_L ^ t : Lˣ) : L))) - (nw_a a : L)) *
          ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L))
      linear_combination -h1
    have hsb_sub_za_ge1 : s_L b₀ - z_a a = 0 ∨ 1 ≤ valL F L (s_L b₀ - z_a a) := by
      rw [hsb_sub_za_eq]
      have hmul := hval_mul_ge_L ((t + 1 : ℕ) : ℤ) (-(t : ℤ))
        ((u₀ : L) - (nw_a a : L)) ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L))
        hdiff_u₀_val (Or.inr (by rw [hϖ_L_pow_inv_val t]))
      have heq : ((t + 1 : ℕ) : ℤ) + -(t : ℤ) = 1 := by push_cast; ring
      rwa [heq] at hmul
    have hsb_sub_za_val0 : s_L b₀ - z_a a = 0 ∨ 0 ≤ valL F L (s_L b₀ - z_a a) :=
      hval_le_L (by omega) hsb_sub_za_ge1
    have hres_diff0 : resL (s_L b₀ - z_a a) = 0 :=
      (hresL_ker (s_L b₀ - z_a a) hsb_sub_za_val0).mpr hsb_sub_za_ge1
    have hneg_za : -(z_a a) = 0 ∨ 0 ≤ valL F L (-(z_a a)) := by
      rcases hz_a_val a with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right
        rw [hval_neg_L]
        exact hge
    have hres_calc : resL (s_L b₀ - z_a a) = b₀ - φ a := by
      rw [sub_eq_add_neg, (hresL_ring (s_L b₀) (-(z_a a)) (hsL_val b₀) hneg_za).1,
        (hresL_ring (z_a a) 0 (hz_a_val a) (Or.inl rfl)).2.2, hsL_res b₀]
      dsimp [φ]
      ring
    have hφa_eq : φ a = b₀ := (sub_eq_zero.mp (hres_calc.symm.trans hres_diff0)).symm
    exact hb₀ a hφa_eq
  have hν₁_u₀ : ν₁ u₀ ≠ 1 := mt (hν₁_ker u₀).mpr hu₀_not_norm
  have hcond_ge : t + 1 ≤ condExp F L ν₁ := by
    by_contra hlt
    have hle : condExp F L ν₁ ≤ t := by omega
    have hu₀_cond : u₀ ∈ unitGroup F L (condExp F L ν₁) :=
      hunit_anti_L hle hu₀_mem
    have h1 := hν₁_cond 1 hp_gt1 u₀
    rw [pow_one ν₁] at h1
    exact hν₁_u₀ (h1 hu₀_cond)

  exact ⟨le_antisymm hcond_le hcond_ge, hnorm_le, hnorm_iff, hnorm_surj_lt,
    hnorm_gt_le, hnorm_gt_surj⟩

theorem ld_wild_conductor_formulas_and_unramified_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m,
      u ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∈ unitGroup F L (m + 1))
    (hroot_exh : ∀ u₁ : Lˣ, ν₁ u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ,
      ξ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1 →
      ∃ k < Module.finrank L (IntermediateField.extendScalars hLK), (ν₁ u₁) ^ k = ξ)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (hFinL : ∀ (a : ℕ), 1 ≤ a →
      Set.Finite {u : Lˣ ⧸ unitGroup F L a | valL F L ((cosetRep u : Lˣ) : L) = 0})
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (htr_surj : ∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x +
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m)
    (hnorm_iff : ∀ m ≤ t, ∀ w : Kˣ,
      Units.map (normLM F hLK) w ∈ unitGroup F L m ↔ w ∈ unitGroup F K m)
    (hnorm_surj_lt : ∀ m < t, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F K m,
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (m + 1))
    (hnorm_gt_le : ∀ r ≥ t + 1,
      ∀ w ∈ unitGroup F K
        (t + 1 + Module.finrank L (IntermediateField.extendScalars hLK) * (r - t)),
      Units.map (normLM F hLK) w ∈ unitGroup F L (r + 1))
    (hnorm_gt_surj : ∀ r ≥ t + 1, ∀ u ∈ unitGroup F L r,
      ∃ w ∈ unitGroup F K
        (t + Module.finrank L (IntermediateField.extendScalars hLK) * (r - t)),
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (r + 1)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    condExpChar F K (traceChar F hLK ψ) =
      (p : ℤ) * condExpChar F L ψ +
        ((p - 1 : ℕ) : ℤ) * (condExp F L ν₁ : ℤ) ∧
    (condExp F L χ' ≤ condExp F L ν₁ →
      condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ' ∧
      ∀ j < p, 0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁) ∧
    (condExp F L ν₁ < condExp F L χ' →
      condExp F K (χ'.comp (Units.map (normLM F hLK))) =
        condExp F L ν₁ + p * (condExp F L χ' - condExp F L ν₁) ∧
      ∀ j < p, condExp F L (ν₁ ^ j * χ') = condExp F L χ') ∧
    (condExp F L χ' = 0 →
      tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j) ψ) =
      tateEps F K 1 (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ)) :=
by
  let K' := IntermediateField.extendScalars hLK
  let p := Module.finrank L K'
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have ht_ge1 : 1 ≤ t := by omega
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL_props
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_surj_K,
    hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := hvalK_props
  have hval_pow_L : ∀ (u : Lˣ) (k : ℕ), valL F L (((u ^ k : Lˣ) : L)) = (k : ℤ) * valL F L (u : L) := by
    intro u k
    induction k with
    | zero => rw [pow_zero, Units.val_one, hval1_L, Nat.cast_zero, zero_mul]
    | succ k ih =>
      rw [pow_succ', Units.val_mul, hval_mul_L (u : L) _ (Units.ne_zero u) (Units.ne_zero _), ih]
      push_cast
      ring
  have hunit_anti_L : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F L m₂ ≤ unitGroup F L m₁ := by
    intro m₁ m₂ hle u hu
    by_cases hm₁ : m₁ = 0
    · subst hm₁
      exact (hunit0_L u).mpr (hunit_val0_L m₂ u hu)
    · rw [hunit_ge1_L m₁ (by omega) u]
      rcases (hunit_ge1_L m₂ (by omega) u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  have hunit_anti_K : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F K m₂ ≤ unitGroup F K m₁ := by
    intro m₁ m₂ hle w hw
    by_cases hm₁ : m₁ = 0
    · subst hm₁
      exact (hunit0_K w).mpr (hunit_val0_K m₂ w hw)
    · rw [hunit_ge1_K m₁ (by omega) w]
      rcases (hunit_ge1_K m₂ (by omega) w).mp hw with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  let ψK := traceChar F hLK ψ
  have hψK_app : ∀ y : K, ψK y = ψ (traceLM F hLK y) := fun _ => rfl
  let n := condExpChar F L ψ
  let nK := condExpChar F K ψK
  let b := condExp F L ν₁
  let N_K : ℤ := (p : ℤ) * n + ((p - 1 : ℕ) : ℤ) * (b : ℤ)
  have hb_int : (b : ℤ) = (t + 1 : ℤ) := by exact_mod_cast hb_eq
  have hp_sub1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hnK : nK = N_K := by
    have hle1 : nK ≤ N_K := by
      obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩ := (hSpecL 1).2.1
      obtain ⟨y₁, hy₁_tr, _, hy₁_ne_prop⟩ := htr_surj x₁
      obtain ⟨hy₁_ne0, hy₁_val_eq⟩ := hy₁_ne_prop hx₁_ne0
      have hy₁_ψ : ψK y₁ ≠ 1 := by
        rw [hψK_app, hy₁_tr]
        exact hx₁_ψ
      have hy₁_val : -(N_K + 1) ≤ valL F K y₁ := by
        change valL F K y₁ =
          (p : ℤ) * valL F L x₁ + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) at hy₁_val_eq
        rw [hy₁_val_eq]
        have hmul : (p : ℤ) * (-(n + 1)) ≤ (p : ℤ) * valL F L x₁ :=
          mul_le_mul_of_nonneg_left hx₁_val (by omega)
        have hrhs_eq :
            (p : ℤ) * (-(n + 1)) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) =
              -(N_K + 1) := by
          dsimp [N_K]
          rw [← hb_int, hp_sub1]
          ring
        linarith
      by_contra hlt
      push_neg at hlt
      have htriv : ψK y₁ = 1 := (hSpecK 1).1 y₁ (Or.inr (by change -nK ≤ valL F K y₁; omega))
      exact hy₁_ψ htriv
    have hle2 : N_K ≤ nK := by
      obtain ⟨y₂, hy₂_ne0, hy₂_val, hy₂_ψ⟩ := (hSpecK 1).2.1
      by_contra hlt
      push_neg at hlt
      have hbound : (p : ℤ) * (-n) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K y₂ := by
        have h1 : (p : ℤ) * (-n) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) = -N_K := by
          dsimp [N_K]
          rw [← hb_int]
          ring
        rw [h1]
        change -(nK + 1) ≤ valL F K y₂ at hy₂_val
        omega
      have htr_val := htr_bound (-n) y₂ (Or.inr hbound)
      have htriv : ψK y₂ = 1 := by
        rw [hψK_app]
        apply (hSpecL 1).1 (traceLM F hLK y₂)
        rcases htr_val with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by change -n ≤ valL F L (traceLM F hLK y₂); omega)
      exact hy₂_ψ htriv
    omega
  let a := condExp F L χ'
  let χ'K : Kˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLK))
  have hχ'_triv_a : ∀ u ∈ unitGroup F L a, χ' u = 1 := by
    intro u hu
    have h0_eq : ν₁ ^ 0 * χ' = χ' := by rw [pow_zero, one_mul]
    have h := hχ'_cond 0 hp_pos u
    rw [h0_eq] at h
    exact h hu
  have hν₁_triv_b : ∀ u ∈ unitGroup F L b, ν₁ u = 1 := by
    intro u hu
    have h1_eq : ν₁ ^ 1 = ν₁ := pow_one ν₁
    have h := hν₁_cond 1 hp_gt1 u
    rw [h1_eq] at h
    exact h hu
  have hν₁j_triv_b : ∀ (j : ℕ), ∀ u ∈ unitGroup F L b, (ν₁ ^ j) u = 1 := by
    intro j u hu
    rw [MonoidHom.pow_apply, hν₁_triv_b u hu, one_pow]
  have hCond_le : a ≤ b →
      condExp F K χ'K = a ∧
      ∀ j < p, 0 < j → condExp F L (ν₁ ^ j * χ') = b := by
    intro hab
    have htwist_le : ∀ j < p, 0 < j → condExp F L (ν₁ ^ j * χ') = b := by
      intro j hj hj_pos
      have hcond_νj : condExp F L (ν₁ ^ j) = b := hν_cond_eq j hj hj_pos
      apply le_antisymm
      · apply Nat.sInf_le
        intro u hu
        have hua : u ∈ unitGroup F L a := hunit_anti_L hab hu
        rw [MonoidHom.mul_apply, hν₁j_triv_b j u hu, hχ'_triv_a u hua, mul_one]
      · by_cases hab_eq : a = b
        · rw [← hab_eq]
          exact hMinCond j hj
        · have ha_le_sub : a ≤ b - 1 := by omega
          obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := ((hSpecL (ν₁ ^ j)).2.2.1 (by omega)).2
          rw [hcond_νj] at hu₀_mem
          have hu₀_a : u₀ ∈ unitGroup F L a := hunit_anti_L ha_le_sub hu₀_mem
          have htwist_u₀ : (ν₁ ^ j * χ') u₀ ≠ 1 := by
            rw [MonoidHom.mul_apply, hχ'_triv_a u₀ hu₀_a, mul_one]
            exact hu₀_ne1
          by_contra hlt
          have hle_sub : condExp F L (ν₁ ^ j * χ') ≤ b - 1 := by omega
          have hu₀_cond : u₀ ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')) :=
            hunit_anti_L hle_sub hu₀_mem
          exact htwist_u₀ (hχ'_cond j hj u₀ hu₀_cond)
    have haK_le_a : condExp F K χ'K ≤ a := by
      apply Nat.sInf_le
      intro w hw
      have hnorm_mem : Units.map (normLM F hLK) w ∈ unitGroup F L a :=
        hnorm_le a (by omega) w hw
      exact hχ'_triv_a (Units.map (normLM F hLK) w) hnorm_mem
    have ha_le_aK : a ≤ condExp F K χ'K := by
      by_cases ha0 : a = 0
      · omega
      · by_cases ha_le_t : a ≤ t
        · obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := ((hSpecL χ').2.2.1 ha0).2
          obtain ⟨w₀, hw₀_mem, hnorm_u₀⟩ := hnorm_surj_lt (a - 1) (by omega) u₀ hu₀_mem
          have ha_succ : a - 1 + 1 = a := by omega
          rw [ha_succ] at hnorm_u₀
          let h_u : Lˣ := (Units.map (normLM F hLK) w₀) * u₀⁻¹
          have hχ'_hu : χ' h_u = 1 := hχ'_triv_a h_u hnorm_u₀
          have hnorm_eq : Units.map (normLM F hLK) w₀ = h_u * u₀ := by
            dsimp [h_u]
            exact (inv_mul_cancel_right _ _).symm
          have hχ'K_w₀ : χ'K w₀ ≠ 1 := by
            change χ' (Units.map (normLM F hLK) w₀) ≠ 1
            rw [hnorm_eq, map_mul, hχ'_hu, one_mul]
            exact hu₀_ne1
          by_contra hlt
          have hle_sub : condExp F K χ'K ≤ a - 1 := by omega
          have hw₀_cond : w₀ ∈ unitGroup F K (condExp F K χ'K) :=
            hunit_anti_K hle_sub hw₀_mem
          exact hχ'K_w₀ (hχ'K_cond w₀ hw₀_cond)
        · have ha_eq_b : a = t + 1 := by omega
          by_contra hlt
          have haK_le_t : condExp F K χ'K ≤ t := by omega
          have hχ'K_triv_t : ∀ w ∈ unitGroup F K t, χ'K w = 1 := by
            intro w hw
            exact hχ'K_cond w (hunit_anti_K haK_le_t hw)
          have hker_sub : ∀ v ∈ unitGroup F L t, ν₁ v = 1 → χ' v = 1 := by
            intro v hv hνv
            obtain ⟨w, rfl⟩ := (hν₁_ker v).mpr hνv
            have hw_mem : w ∈ unitGroup F K t := (hnorm_iff t le_rfl w).mp hv
            exact hχ'K_triv_t w hw_mem
          obtain ⟨u₁, hu₁_mem, hu₁_ne1⟩ := ((hSpecL ν₁).2.2.1 (by omega)).2
          have hu₁_mem_t : u₁ ∈ unitGroup F L t := by
            rw [hb_eq] at hu₁_mem
            exact hu₁_mem
          have hu₁_pow_mem : u₁ ^ p ∈ unitGroup F L a := by
            rw [ha_eq_b]
            exact hunit_pow_p t ht_ge1 u₁ hu₁_mem_t
          have hχ'_u₁_pow : χ' (u₁ ^ p) = 1 := hχ'_triv_a (u₁ ^ p) hu₁_pow_mem
          have hχ'_u₁_inv_pow : ((χ' u₁)⁻¹) ^ p = 1 := by
            rw [inv_pow, ← map_pow, hχ'_u₁_pow, inv_one]
          obtain ⟨j, hj, hνj_u₁⟩ := hroot_exh u₁ hu₁_ne1 (χ' u₁)⁻¹ hχ'_u₁_inv_pow
          have htwist_u₁ : (ν₁ ^ j * χ') u₁ = 1 := by
            rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hνj_u₁, inv_mul_cancel]
          have htwist_triv_t : ∀ u ∈ unitGroup F L t, (ν₁ ^ j * χ') u = 1 := by
            intro u hu
            have hνu_pow : (ν₁ u) ^ p = 1 := by
              rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
            obtain ⟨k, _, hνk_u⟩ := hroot_exh u₁ hu₁_ne1 (ν₁ u) hνu_pow
            let v : Lˣ := u * (u₁ ^ k)⁻¹
            have hv_mem : v ∈ unitGroup F L t :=
              Subgroup.mul_mem _ hu (Subgroup.inv_mem _ (Subgroup.pow_mem _ hu₁_mem_t k))
            have hν_v : ν₁ v = 1 := by
              dsimp [v]
              rw [map_mul, map_inv, map_pow, hνk_u, mul_inv_cancel]
            have hχ'_v : χ' v = 1 := hker_sub v hv_mem hν_v
            have htwist_v : (ν₁ ^ j * χ') v = 1 := by
              rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hν_v, hχ'_v, one_pow, mul_one]
            have hu_eq : u = v * u₁ ^ k := by
              dsimp [v]
              exact (inv_mul_cancel_right u (u₁ ^ k)).symm
            rw [hu_eq, map_mul, map_pow, htwist_v, htwist_u₁, one_pow, mul_one]
          have hcond_twist_le_t : condExp F L (ν₁ ^ j * χ') ≤ t :=
            Nat.sInf_le htwist_triv_t
          have hmin := hMinCond j hj
          omega
    exact ⟨le_antisymm haK_le_a ha_le_aK, htwist_le⟩
  have hCond_gt : b < a →
      condExp F K χ'K = b + p * (a - b) ∧
      ∀ j < p, condExp F L (ν₁ ^ j * χ') = a := by
    intro hba
    have htwist_gt : ∀ j < p, condExp F L (ν₁ ^ j * χ') = a := by
      intro j hj
      apply le_antisymm
      · apply Nat.sInf_le
        intro u hu
        have hub : u ∈ unitGroup F L b := hunit_anti_L (by omega) hu
        rw [MonoidHom.mul_apply, hν₁j_triv_b j u hub, hχ'_triv_a u hu, mul_one]
      · exact hMinCond j hj
    let r : ℕ := a - 1
    let A : ℕ := b + p * (a - b)
    have hr_ge : r ≥ t + 1 := by omega
    have hr_succ : r + 1 = a := by omega
    have hrt_eq : r - t = a - b := by omega
    have hA_eq1 : t + 1 + p * (r - t) = A := by
      dsimp [A]
      rw [hrt_eq]
      omega
    have hA_eq2 : t + p * (r - t) = A - 1 := by
      dsimp [A]
      rw [hrt_eq]
      omega
    have haK_le_A : condExp F K χ'K ≤ A := by
      apply Nat.sInf_le
      intro w hw
      have hw' : w ∈ unitGroup F K (t + 1 + p * (r - t)) := by
        rw [hA_eq1]
        exact hw
      have hnorm_mem : Units.map (normLM F hLK) w ∈ unitGroup F L a := by
        rw [← hr_succ]
        exact hnorm_gt_le r hr_ge w hw'
      exact hχ'_triv_a (Units.map (normLM F hLK) w) hnorm_mem
    have hA_le_aK : A ≤ condExp F K χ'K := by
      obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := ((hSpecL χ').2.2.1 (by omega)).2
      obtain ⟨w₀, hw₀_mem, hnorm_u₀⟩ := hnorm_gt_surj r hr_ge u₀ hu₀_mem
      rw [hA_eq2] at hw₀_mem
      rw [hr_succ] at hnorm_u₀
      let h_u : Lˣ := (Units.map (normLM F hLK) w₀) * u₀⁻¹
      have hχ'_hu : χ' h_u = 1 := hχ'_triv_a h_u hnorm_u₀
      have hnorm_eq : Units.map (normLM F hLK) w₀ = h_u * u₀ := by
        dsimp [h_u]
        exact (inv_mul_cancel_right _ _).symm
      have hχ'K_w₀ : χ'K w₀ ≠ 1 := by
        change χ' (Units.map (normLM F hLK) w₀) ≠ 1
        rw [hnorm_eq, map_mul, hχ'_hu, one_mul]
        exact hu₀_ne1
      by_contra hlt
      have hle_sub : condExp F K χ'K ≤ A - 1 := by omega
      have hw₀_cond : w₀ ∈ unitGroup F K (condExp F K χ'K) :=
        hunit_anti_K hle_sub hw₀_mem
      exact hχ'K_w₀ (hχ'K_cond w₀ hw₀_cond)
    exact ⟨le_antisymm haK_le_A hA_le_aK, htwist_gt⟩
  have hW0 : a = 0 →
      tateEps F K χ'K ψK * (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j) ψ) =
      tateEps F K 1 ψK * (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) := by
    intro ha0
    have ha0' : condExp F L χ' = 0 := ha0
    have hχ'_triv0 : ∀ u ∈ unitGroup F L 0, χ' u = 1 := by
      intro u hu
      have hu' : u ∈ unitGroup F L a := by rw [ha0]; exact hu
      exact hχ'_triv_a u hu'
    have hcond_1L : condExp F L 1 = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    have hcond_1K : condExp F K 1 = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    obtain ⟨hcond_χ'K0, hcond_twist0⟩ := hCond_le (by omega)
    rw [ha0] at hcond_χ'K0
    have htateEps_eq_of_cond : ∀ (θ : Lˣ →* (Ω F)ˣ) (m : ℕ) (c : Lˣ),
        condExp F L θ = m → tateElt F L θ ψ = c →
        tateEps F L θ ψ =
          (qL F L : Ω F) ^ n *
            if m = 0 then (θ c : Ω F)
            else
              ∑ᶠ (u : Lˣ ⧸ unitGroup F L m) (_ : valL F L ((cosetRep u : Lˣ) : L) = 0),
                ((θ (c⁻¹ * (cosetRep u : Lˣ)) : Ω F)⁻¹ *
                  ψ (((c⁻¹ * (cosetRep u : Lˣ) : Lˣ) : L))) := by
      intro θ m c hm hc
      subst hm
      subst hc
      rfl
    have hb_ge1 : 1 ≤ b := by omega
    have hb_ne0 : b ≠ 0 := by omega
    have hfin_sum : ∀ (f : Lˣ ⧸ unitGroup F L b → Ω F),
        (∑ᶠ (u : Lˣ ⧸ unitGroup F L b) (_ : valL F L ((cosetRep u : Lˣ) : L) = 0), f u) =
        ∑ u ∈ (hFinL b hb_ge1).toFinset, f u :=
      fun f => finsum_mem_eq_finite_toFinset_sum f (hFinL b hb_ge1)
    let c₀ := tateElt F L 1 ψ
    let c_b := tateElt F L ν₁ ψ
    have hc₀_val : valL F L (c₀ : L) = n := by
      have h := (hSpecL 1).2.2.2
      rw [hcond_1L, Nat.cast_zero, zero_add] at h
      exact h
    have hc_b_val : valL F L (c_b : L) = (b : ℤ) + n := (hSpecL ν₁).2.2.2
    have htate_0 : tateEps F L (ν₁ ^ 0 * χ') ψ = (χ' c₀ : Ω F) * tateEps F L (ν₁ ^ 0) ψ := by
      rw [pow_zero, one_mul]
      have hc_χ' : tateElt F L χ' ψ = c₀ := by
        dsimp [c₀]
        unfold tateElt
        rw [ha0', hcond_1L]
      have h1 : tateEps F L χ' ψ = (qL F L : Ω F) ^ n * (χ' c₀ : Ω F) := by
        unfold tateEps
        rw [if_pos ha0', hc_χ']
      have h2 : tateEps F L 1 ψ = (qL F L : Ω F) ^ n * 1 := by
        unfold tateEps
        rw [if_pos hcond_1L, MonoidHom.one_apply, Units.val_one]
      rw [h1, h2]
      ring
    have htate_j : ∀ j < p, 0 < j →
        tateEps F L (ν₁ ^ j * χ') ψ = (χ' c_b : Ω F) * tateEps F L (ν₁ ^ j) ψ := by
      intro j hj hj_pos
      have hcond_j : condExp F L (ν₁ ^ j) = b := hν_cond_eq j hj hj_pos
      have hcond_tj : condExp F L (ν₁ ^ j * χ') = b := hcond_twist0 j hj hj_pos
      have hc_j : tateElt F L (ν₁ ^ j) ψ = c_b := by
        dsimp [c_b]
        unfold tateElt
        rw [hcond_j]
      have hc_tj : tateElt F L (ν₁ ^ j * χ') ψ = c_b := by
        dsimp [c_b]
        unfold tateElt
        rw [hcond_tj]
      rw [htateEps_eq_of_cond (ν₁ ^ j * χ') b c_b hcond_tj hc_tj,
        htateEps_eq_of_cond (ν₁ ^ j) b c_b hcond_j hc_j,
        if_neg hb_ne0, if_neg hb_ne0, hfin_sum, hfin_sum]
      have hsum_eq :
          ∑ u ∈ (hFinL b hb_ge1).toFinset,
            ((((ν₁ ^ j * χ') (c_b⁻¹ * cosetRep u) : (Ω F)ˣ) : Ω F)⁻¹ *
              ψ (((c_b⁻¹ * cosetRep u : Lˣ) : L))) =
          (χ' c_b : Ω F) *
            ∑ u ∈ (hFinL b hb_ge1).toFinset,
              ((((ν₁ ^ j) (c_b⁻¹ * cosetRep u) : (Ω F)ˣ) : Ω F)⁻¹ *
                ψ (((c_b⁻¹ * cosetRep u : Lˣ) : L))) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro u hu
        have hu_val : valL F L ((cosetRep u : Lˣ) : L) = 0 :=
          (Set.Finite.mem_toFinset (hFinL b hb_ge1)).mp hu
        have hu_mem0 : (cosetRep u : Lˣ) ∈ unitGroup F L 0 := (hunit0_L _).mpr hu_val
        have hχ'_u : χ' (cosetRep u) = 1 := hχ'_triv0 _ hu_mem0
        have hterm : ((ν₁ ^ j * χ') (c_b⁻¹ * cosetRep u)) =
            (χ' c_b)⁻¹ * ((ν₁ ^ j) (c_b⁻¹ * cosetRep u)) := by
          rw [MonoidHom.mul_apply, map_mul χ', hχ'_u, mul_one, map_inv, mul_comm]
        rw [hterm, Units.val_mul, mul_inv, Units.val_inv_eq_inv_val, inv_inv]
        ring
      rw [hsum_eq]
      ring
    let m := p - 1
    have hm : m + 1 = p := Nat.sub_add_cancel (by omega)
    have hprod_eq :
        (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) =
        ((χ' (c₀ * c_b ^ m) : Ω F)) * (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j) ψ) := by
      rw [← hm, Finset.prod_range_succ', Finset.prod_range_succ']
      have hprod_m :
          (∏ k ∈ Finset.range m, tateEps F L (ν₁ ^ (k + 1) * χ') ψ) =
          ((χ' c_b : Ω F) ^ m) * (∏ k ∈ Finset.range m, tateEps F L (ν₁ ^ (k + 1)) ψ) := by
        have hcongr :
            (∏ k ∈ Finset.range m, tateEps F L (ν₁ ^ (k + 1) * χ') ψ) =
            (∏ k ∈ Finset.range m, ((χ' c_b : Ω F) * tateEps F L (ν₁ ^ (k + 1)) ψ)) := by
          apply Finset.prod_congr rfl
          intro k hk
          rw [Finset.mem_range] at hk
          exact htate_j (k + 1) (by omega) (by omega)
        rw [hcongr, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range]
      rw [hprod_m, htate_0, map_mul, map_pow, Units.val_mul, Units.val_pow_eq_pow_val]
      ring
    let cK := tateElt F K 1 ψK
    have hc_χ'K : tateElt F K χ'K ψK = cK := by
      dsimp [cK]
      unfold tateElt
      rw [hcond_χ'K0, hcond_1K]
    have htateK_eq : tateEps F K χ'K ψK = (χ'K cK : Ω F) * tateEps F K 1 ψK := by
      have h1 : tateEps F K χ'K ψK = (qL F K : Ω F) ^ nK * (χ'K cK : Ω F) := by
        unfold tateEps
        rw [if_pos hcond_χ'K0, hc_χ'K]
      have h2 : tateEps F K 1 ψK = (qL F K : Ω F) ^ nK * 1 := by
        unfold tateEps
        rw [if_pos hcond_1K, MonoidHom.one_apply, Units.val_one]
      rw [h1, h2]
      ring
    have hcK_val : valL F L (((Units.map (normLM F hLK) cK : Lˣ) : L)) = N_K := by
      change valL F L (normLM F hLK (cK : K)) = N_K
      rw [hval_norm (cK : K)]
      have h := (hSpecK 1).2.2.2
      rw [hcond_1K, Nat.cast_zero, zero_add] at h
      have h1 : valL F K (cK : K) = nK := h
      rw [h1, hnK]
    have hc0b_val : valL F L (((c₀ * c_b ^ m : Lˣ) : L)) = N_K := by
      rw [Units.val_mul, hval_mul_L (c₀ : L) _ (Units.ne_zero _) (Units.ne_zero _),
        hval_pow_L c_b m, hc₀_val, hc_b_val]
      dsimp [N_K, m]
      rw [hp_sub1]
      ring
    let u_ratio : Lˣ := (Units.map (normLM F hLK) cK) * (c₀ * c_b ^ m)⁻¹
    have hu_ratio_val : valL F L (u_ratio : L) = 0 := by
      change valL F L (((Units.map (normLM F hLK) cK * (c₀ * c_b ^ m)⁻¹ : Lˣ) : L)) = 0
      rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_inv_L (c₀ * c_b ^ m), hcK_val, hc0b_val, add_neg_cancel]
    have hχ'_ratio : χ' u_ratio = 1 := hχ'_triv0 u_ratio ((hunit0_L u_ratio).mpr hu_ratio_val)
    have hχ'K_eq : χ'K cK = χ' (c₀ * c_b ^ m) := by
      have heq : Units.map (normLM F hLK) cK = u_ratio * (c₀ * c_b ^ m) := by
        dsimp [u_ratio]
        exact (inv_mul_cancel_right _ _).symm
      change χ' (Units.map (normLM F hLK) cK) = χ' (c₀ * c_b ^ m)
      rw [heq, map_mul, hχ'_ratio, one_mul]
    rw [htateK_eq, hprod_eq, hχ'K_eq]
    ring
  exact ⟨hnK, hCond_le, hCond_gt, hW0⟩

theorem ld_ch10_wild_ramification_and_cond_formulas (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hRam : condExp F L ν₁ ≠ 0)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F) :
    2 ≤ condExp F L ν₁ ∧
    (∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁) ∧
    qL F K = qL F L ∧
    (∀ y : K, valL F L (normLM F hLK y) = valL F K y) ∧
    condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ) ∧
    (condExp F L χ' ≤ condExp F L ν₁ →
      condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ' ∧
      ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
        0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁) ∧
    (condExp F L ν₁ < condExp F L χ' →
      condExp F K (χ'.comp (Units.map (normLM F hLK))) =
        condExp F L ν₁ +
          Module.finrank L (IntermediateField.extendScalars hLK) *
            (condExp F L χ' - condExp F L ν₁) ∧
      ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
        condExp F L (ν₁ ^ j * χ') = condExp F L χ') ∧
    (condExp F L χ' = 0 →
      tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEps F L (ν₁ ^ j) ψ) =
      tateEps F K 1 (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEps F L (ν₁ ^ j * χ') ψ)) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalK_props := ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L
      hvalL_props.1 hvalL_props.2.1 hvalL_props.2.2.1 hvalL_props.2.2.2.1
      hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1 S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  have hψK : IsAdmissibleChar F K (traceChar F hLK ψ) :=
    ld_traceChar_admissible F L K hLK hAb.2.2 ψ hψ
  obtain ⟨hb_ge2, hν_cond_eq, hqK, hval_norm, hval_alg, hfrob_surj, hunit_pow_p, hroot_exh,
    ϖ_K, ϖ_L, hϖ_norm, hϖ_K, hϖ_L, hBasis⟩ :=
    ld_wild_total_ramification_and_power_basis F L K hLK hPrime ν₁
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hRam hEqP
      haddVal1 haddVal_mul halg1 hvalL_props hvalK_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨t, w_star, ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm,
    htr_bound, htr_surj, hnorm_exp⟩ :=
    ld_wild_galois_jump_and_euler_trace_formula F L K hLK hGal hPrime hEqP
      haddVal1 halg1 hvalL_props hvalK_props hval_norm hval_alg ϖ_K hϖ_K hBasis
  obtain ⟨hb_eq, hnorm_le, hnorm_iff, hnorm_surj_lt, hnorm_gt_le, hnorm_gt_surj⟩ :=
    ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L K hLK hPrime ν₁
      hν₁_ker hν₁_cond hvalL_props hvalK_props hval_norm hval_alg hfrob_surj
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L hBasis
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t w_star ht_ge1 hw_star_t hw_star_nt1 hw_star_norm htr_bound htr_surj hnorm_exp
  obtain ⟨hnK, hCond_le, hCond_gt, hW0⟩ :=
    ld_wild_conductor_formulas_and_unramified_twist F L K hLK hPrime ψ hψ hψK ν₁ χ'
      hν₁_pow hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond
      hb_ge2 hν_cond_eq hqK hval_norm hunit_pow_p hroot_exh
      hvalL_props hvalK_props
      (ld_condExp_and_condExpChar_spec F L ψ hψ)
      (ld_condExp_and_condExpChar_spec F K (traceChar F hLK ψ) hψK)
      (ld_unitCoset_finite F L)
      t hb_eq htr_bound htr_surj hnorm_le hnorm_iff hnorm_surj_lt hnorm_gt_le hnorm_gt_surj
  exact ⟨hb_ge2, hν_cond_eq, hqK, hval_norm, hnK, hCond_le, hCond_gt, hW0⟩

theorem ld_wild_cond_one_stable_twist_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (ha1 : condExp F L χ' = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_1 : valL F K 1 = 0)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hStatL : ∀ (θ : Lˣ →* (Ω F)ˣ), 2 ≤ condExp F L θ →
      let m := condExp F L θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Lˣ,
        valL F L (c_θ : L) = (m : ℤ) + condExpChar F L ψ ∧
        ∀ x : L, (x = 0 ∨ (r₀ : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_θ⁻¹ : Lˣ) : L) * x)) ∧
      (∀ (c : Lˣ),
        valL F L (c : L) = (m : ℤ) + condExpChar F L ψ →
        (∀ x : L, (x = 0 ∨ (r₀ : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c⁻¹ : Lˣ) : L) * x)) →
        ∀ (ν : Lˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F L d, ν u = 1) →
          condExp F L (ν * θ) = m ∧
          tateEps F L (ν * θ) ψ = (ν c : Ω F) * tateEps F L θ ψ))
    (c_τ : Lˣ)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x)) :
    (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      tateEps F L (ν₁ ^ j * χ') ψ) =
    (χ' ((-1 : Lˣ) * c_τ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) : Ω F) *
      (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
        tateEps F L (ν₁ ^ j) ψ) :=
by
  rcases hvalL_props with ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv,
    _, hval_add, hunit0, hunit_ge1, hunit_val0⟩
  set p := Module.finrank L (IntermediateField.extendScalars hLK)
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by omega)
  have hneg1_int : (-1 : L) = 0 ∨ 0 ≤ valL F L (-1) := Or.inr (by omega)
  have hnat : ∀ m : ℕ, ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      exact ⟨Or.inl Nat.cast_zero, by rw [Nat.cast_zero, Nat.cast_zero]; exact hresL_0⟩
    | succ m ih =>
      have h_int : ((m + 1 : ℕ) : L) = 0 ∨ 0 ≤ valL F L ((m + 1 : ℕ) : L) := by
        rw [Nat.cast_succ]
        exact hval_add 0 (m : L) 1 ih.1 h1_int
      have h_res : resL ((m + 1 : ℕ) : L) = ((m + 1 : ℕ) : k_L) := by
        rw [Nat.cast_succ, (hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1, Nat.cast_succ]
      exact ⟨h_int, h_res⟩
  have hχ'_triv1 : ∀ u ∈ unitGroup F L 1, χ' u = 1 := by
    intro u hu
    have h0 := hχ'_cond 0 hp_pos
    have hν0 : ν₁ ^ (0 : ℕ) = 1 := pow_zero ν₁
    have hν0_χ : ν₁ ^ (0 : ℕ) * χ' = χ' := (congr_arg (· * χ') hν0).trans (one_mul χ')
    rw [hν0_χ, ha1] at h0
    exact h0 u hu
  have hχ'_triv_d : ∀ u ∈ unitGroup F L (condExp F L ν₁ / 2), χ' u = 1 := by
    intro u hu
    have hd_ge1 : 1 ≤ condExp F L ν₁ / 2 := by omega
    have hu1 : u ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u]
      rcases (hunit_ge1 (condExp F L ν₁ / 2) hd_ge1 u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (by omega)
    exact hχ'_triv1 u hu1
  have htr1 : traceLM F hLK (1 : K) = (p : L) := by
    change (Algebra.trace L (IntermediateField.extendScalars hLK))
      ((algebraMap L (IntermediateField.extendScalars hLK)) 1) = (p : L)
    rw [Algebra.trace_algebraMap, nsmul_one]
  have hp_val : (p : L) = 0 ∨ 1 ≤ valL F L (p : L) := by
    have h_ineq : (p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (1 : K) := by
      rw [hvalK_1]
      have hp2 : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
      have ht1 : (1 : ℤ) ≤ (t : ℤ) := by exact_mod_cast ht_ge1
      have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
      rw [hp_sub]
      nlinarith
    have htr := htr_bound 1 (1 : K) (Or.inr h_ineq)
    rwa [htr1] at htr
  have hp_kL : (p : k_L) = 0 := by
    rw [← (hnat p).2]
    exact (hresL_ker (p : L) (hnat p).1).mpr hp_val
  have hdvd_p : ringChar k_L ∣ p := (ringChar.spec k_L p).mp hp_kL
  have hrc_ne1 : ringChar k_L ≠ 1 := by
    intro h1
    have h1_zero : ((1 : ℕ) : k_L) = 0 := (ringChar.spec k_L 1).mpr (by rw [h1])
    rw [Nat.cast_one] at h1_zero
    exact one_ne_zero h1_zero
  have hrc_eq : ringChar k_L = p :=
    (hPrime.eq_one_or_self_of_dvd (ringChar k_L) hdvd_p).resolve_left hrc_ne1
  haveI : CharP k_L p := ringChar.eq_iff.mp hrc_eq
  set S : Finset ℕ := (Finset.range p).erase 0
  have hj_props : ∀ j < p, 0 < j → (j : L) ≠ 0 ∧ valL F L (j : L) = 0 := by
    intro j hj_lt hj_pos
    have hj_ndvd : ¬ p ∣ j := Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
    have hj_kL : (j : k_L) ≠ 0 := by
      intro hj0
      exact hj_ndvd ((CharP.cast_eq_zero_iff k_L p j).mp hj0)
    have hj_res : resL (j : L) ≠ 0 := by
      rw [(hnat j).2]
      exact hj_kL
    have hj_not_ker : ¬ ((j : L) = 0 ∨ 1 ≤ valL F L (j : L)) := by
      intro hker
      exact hj_res ((hresL_ker (j : L) (hnat j).1).mpr hker)
    rcases (hnat j).1 with hj0 | hj_ge0
    · exact False.elim (hj_not_ker (Or.inl hj0))
    · refine ⟨fun hj0 => hj_not_ker (Or.inl hj0), ?_⟩
      have hlt1 : ¬ (1 ≤ valL F L (j : L)) := fun h1 => hj_not_ker (Or.inr h1)
      omega
  let u_nat : ℕ → Lˣ := fun j => if h : (j : L) ≠ 0 then Units.mk0 (j : L) h else 1
  have hu_nat_S : ∀ j ∈ S,
      ((u_nat j : Lˣ) : L) = (j : L) ∧
      valL F L ((u_nat j : Lˣ) : L) = 0 ∧
      resL ((u_nat j : Lˣ) : L) = (j : k_L) := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero hj_ne0
    obtain ⟨h_ne, h_val⟩ := hj_props j hj_lt hj_pos
    have h_coe : ((u_nat j : Lˣ) : L) = (j : L) := by
      dsimp only [u_nat]
      rw [dif_pos h_ne, Units.val_mk0]
    refine ⟨h_coe, ?_, ?_⟩
    · rw [h_coe, h_val]
    · rw [h_coe, (hnat j).2]
  have htwist_j : ∀ j ∈ S,
      tateEps F L (ν₁ ^ j * χ') ψ =
        (χ' (c_τ * (u_nat j)⁻¹) : Ω F) * tateEps F L (ν₁ ^ j) ψ := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero hj_ne0
    obtain ⟨h_coe, h_val, _⟩ := hu_nat_S j hj
    have hcond_j : condExp F L (ν₁ ^ j) = condExp F L ν₁ := hν_cond_eq j hj_lt hj_pos
    have hb_j : 2 ≤ condExp F L (ν₁ ^ j) := by rw [hcond_j]; exact hb_ge2
    let c_j : Lˣ := c_τ * (u_nat j)⁻¹
    have hc_j_val : valL F L (c_j : L) = (condExp F L (ν₁ ^ j) : ℤ) + condExpChar F L ψ := by
      change valL F L ((c_τ : L) * (((u_nat j)⁻¹ : Lˣ) : L)) = _
      rw [hval_mul (c_τ : L) (((u_nat j)⁻¹ : Lˣ) : L) (Units.ne_zero _) (Units.ne_zero _),
        hval_inv (u_nat j), h_val, hc_τ_val, hcond_j]
      omega
    have hc_j_stat : ∀ x : L,
        (x = 0 ∨ (((condExp F L (ν₁ ^ j) + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_j⁻¹ : Lˣ) : L) * x) := by
      intro x hx_val hx
      have hx_val' : x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x := by
        rwa [hcond_j] at hx_val
      have h1 : ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) =
          (ν₁ (Units.mk0 (1 + x) hx) : Ω F) ^ j := by
        rw [MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
      rw [h1, hc_τ_stat x hx_val' hx, ← AddChar.map_nsmul_eq_pow ψ j, nsmul_eq_mul]
      congr 1
      have hcj_inv : ((c_j⁻¹ : Lˣ) : L) = (j : L) * ((c_τ⁻¹ : Lˣ) : L) := by
        dsimp only [c_j]
        rw [mul_inv_rev, inv_inv, Units.val_mul, h_coe]
      rw [hcj_inv, mul_assoc]
    have hχ'_triv_j : ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j) / 2), χ' u = 1 := by
      rw [hcond_j]
      exact hχ'_triv_d
    have hstat := ((hStatL (ν₁ ^ j) hb_j).2 c_j hc_j_val hc_j_stat χ' hχ'_triv_j).2
    rw [mul_comm (ν₁ ^ j) χ']
    exact hstat
  let U_S : Lˣ := ∏ j ∈ S, u_nat j
  have hS_card : S.card = p - 1 := by
    dsimp only [S]
    rw [Finset.card_erase_of_mem (Finset.mem_range.mpr hp_pos), Finset.card_range]
  have hprod_split :
      (∏ j ∈ S, tateEps F L (ν₁ ^ j * χ') ψ) =
        (χ' (U_S⁻¹ * c_τ ^ (p - 1)) : Ω F) * (∏ j ∈ S, tateEps F L (ν₁ ^ j) ψ) := by
    rw [Finset.prod_congr rfl htwist_j, Finset.prod_mul_distrib]
    congr 1
    have h_coe_prod : (∏ j ∈ S, (χ' (c_τ * (u_nat j)⁻¹) : Ω F)) =
        ((∏ j ∈ S, χ' (c_τ * (u_nat j)⁻¹) : (Ω F)ˣ) : Ω F) := by
      exact (map_prod (Units.coeHom (Ω F)) (fun j => χ' (c_τ * (u_nat j)⁻¹)) S).symm
    rw [h_coe_prod, ← map_prod χ']
    congr 1
    rw [Finset.prod_mul_distrib, Finset.prod_const, hS_card, Finset.prod_inv_distrib,
      mul_comm]
  have hprod_res : ∀ (T : Finset ℕ), T ⊆ S →
      valL F L ((∏ j ∈ T, u_nat j : Lˣ) : L) = 0 ∧
      resL ((∏ j ∈ T, u_nat j : Lˣ) : L) = ∏ j ∈ T, (j : k_L) := by
    intro T
    induction' T using Finset.induction_on with a T ha ih
    · intro _
      simp only [Finset.prod_empty, Units.val_one]
      exact ⟨hval1, hresL_1⟩
    · intro hTS
      have haS : a ∈ S := hTS (Finset.mem_insert_self a T)
      have hT_sub : T ⊆ S := fun x hx => hTS (Finset.mem_insert_of_mem hx)
      obtain ⟨hT_val, hT_res⟩ := ih hT_sub
      obtain ⟨_, ha_val, ha_res⟩ := hu_nat_S a haS
      rw [Finset.prod_insert ha, Finset.prod_insert ha, Units.val_mul]
      have h_val : valL F L ((u_nat a : L) * ((∏ j ∈ T, u_nat j : Lˣ) : L)) = 0 := by
        rw [hval_mul (u_nat a : L) _ (Units.ne_zero _) (Units.ne_zero _), ha_val, hT_val]
        omega
      have h_res : resL ((u_nat a : L) * ((∏ j ∈ T, u_nat j : Lˣ) : L)) =
          (a : k_L) * ∏ j ∈ T, (j : k_L) := by
        rw [(hresL_ring (u_nat a : L) _ (Or.inr (by omega)) (Or.inr (by omega))).2.1,
          ha_res, hT_res]
      exact ⟨h_val, h_res⟩
  obtain ⟨hUS_val, hUS_res⟩ := hprod_res S (Finset.Subset.refl S)
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hIco_eq : Finset.Ico 1 p = S := by
    dsimp only [S]
    rw [Finset.range_eq_Ico, ← @Nat.Ico_succ_left_eq_erase_Ico 0 p]
  have hwilson_kL : (∏ j ∈ S, (j : k_L)) = (-1 : k_L) := by
    let φ : ZMod p →+* k_L := ZMod.castHom (dvd_rfl : p ∣ p) k_L
    have hZ := congr_arg φ (ZMod.prod_Ico_one_prime p)
    rw [map_prod, map_neg, map_one, hIco_eq] at hZ
    simpa only [map_natCast] using hZ
  have hUS_res_neg1 : resL (U_S : L) = (-1 : k_L) := hUS_res.trans hwilson_kL
  have hUS_int : (U_S : L) = 0 ∨ 0 ≤ valL F L (U_S : L) :=
    Or.inr (le_of_eq hUS_val.symm)
  let w : Lˣ := U_S * (-1 : Lˣ)
  have hw_val : valL F L (w : L) = 0 := by
    change valL F L ((U_S : L) * (-1 : L)) = 0
    rw [hval_mul (U_S : L) (-1 : L) (Units.ne_zero U_S) (neg_ne_zero.mpr one_ne_zero),
      hUS_val, hval_neg1]
    omega
  have hres_neg1 : resL (-1 : L) = (-1 : k_L) := by
    rw [(hresL_ring 1 0 h1_int (Or.inl rfl)).2.2, hresL_1]
  have hw_res : resL (w : L) = (1 : k_L) := by
    change resL ((U_S : L) * (-1 : L)) = 1
    rw [(hresL_ring (U_S : L) (-1 : L) hUS_int hneg1_int).2.1,
      hUS_res_neg1, hres_neg1, neg_mul_neg, one_mul]
  have hw_mem1 : w ∈ unitGroup F L 1 := by
    rw [hunit_ge1 1 le_rfl w]
    have hsub_int : (w : L) - 1 = 0 ∨ 0 ≤ valL F L ((w : L) - 1) := by
      rw [sub_eq_add_neg]
      exact hval_add 0 (w : L) (-1 : L) (Or.inr (by omega)) hneg1_int
    have hsub_res : resL ((w : L) - 1) = 0 := by
      rw [sub_eq_add_neg, (hresL_ring (w : L) (-1 : L) (Or.inr (by omega)) hneg1_int).1,
        hw_res, hres_neg1, add_neg_cancel]
    rcases (hresL_ker ((w : L) - 1) hsub_int).mp hsub_res with h0 | hge1
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hge1
  have hχ'_w : χ' w = 1 := hχ'_triv1 w hw_mem1
  have hw_eq : U_S⁻¹ * c_τ ^ (p - 1) = w⁻¹ * ((-1 : Lˣ) * c_τ ^ (p - 1)) := by
    dsimp only [w]
    rw [mul_inv_rev, mul_comm ((-1 : Lˣ)⁻¹) U_S⁻¹, mul_assoc, inv_mul_cancel_left]
  have hχ'_eq : χ' (U_S⁻¹ * c_τ ^ (p - 1)) = χ' ((-1 : Lˣ) * c_τ ^ (p - 1)) := by
    rw [hw_eq, map_mul, map_inv, hχ'_w, inv_one, one_mul]
  rw [hprod_split, hχ'_eq]

theorem ld_wild_power_basis_residue_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m) :
    ∃ (resK : K → k_L),
      resK 0 = 0 ∧
      resK 1 = 1 ∧
      (∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
        resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
        resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
        resK (-y₁) = -resK y₁) ∧
      (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y))) ∧
      (∀ a : k_L, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = a) ∧
      (∀ y : K, ∀ x : L,
        (y = 0 ∨ 0 ≤ valL F K y) →
        (x = 0 ∨ 0 ≤ valL F L x) →
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)) →
        resK y = resL x) ∧
      (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
        ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
          resK y = resL x ∧
          (y - IntermediateField.inclusion hLK x = 0 ∨
            1 ≤ valL F K (y - IntermediateField.inclusion hLK x))) ∧
      (∀ w : Kˣ, valL F K (w : K) = 0 →
        resL ((Units.map (normLM F hLK) w : Lˣ) : L) =
          (resK (w : K)) ^ (Module.finrank L (IntermediateField.extendScalars hLK))) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, hval_surj_K, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  let p := Module.finrank L (IntermediateField.extendScalars hLK)
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_int_pos : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
  have hp_int_ge2 : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
  have hval_pow_K : ∀ (y : K) (n : ℕ), y ≠ 0 → valL F K (y ^ n) = (n : ℤ) * valL F K y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : k₁ ≤ valL F L x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_mul_ge_K : ∀ (k₁ k₂ : ℤ) (x y : K),
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : k₁ ≤ valL F K x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F K y := hy.resolve_left hy0
        rw [hval_mul_K x y hx0 hy0]
        omega
  have hval_neg_ge_L : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hval_neg_L]; exact hx
  have hval_neg_ge_K : ∀ (k : ℤ) (x : K),
      (x = 0 ∨ k ≤ valL F K x) → (-x = 0 ∨ k ≤ valL F K (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hval_neg_K]; exact hx
  have hval_sub_ge_L : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
      (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_L k x (-y) hx (hval_neg_ge_L k y hy)
  have hval_sub_ge_K : ∀ (k : ℤ) (x y : K),
      (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
      (x - y = 0 ∨ k ≤ valL F K (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_K k x (-y) hx (hval_neg_ge_K k y hy)
  have hval_inc_ge : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) →
      (IntermediateField.inclusion hLK x = 0 ∨
        (p : ℤ) * k ≤ valL F K (IntermediateField.inclusion hLK x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hval_alg x]
      exact mul_le_mul_of_nonneg_left hx (by omega)
  have hval_finset_sum_K : ∀ {α : Type} (S : Finset α) (f : α → K) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K (f i)) →
      ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ S, f i)) := by
    intro α S f k h
    induction S using Finset.induction_on with
    | empty => left; simp
    | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add_K k (f a) (∑ i ∈ s, f i)
        (h a (Finset.mem_insert_self a s))
        (ih (fun i hi => h i (Finset.mem_insert_of_mem hi)))
  have hResSurj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)) := by
    intro y hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis y
    let i_zero : Fin p := ⟨0, hp_pos⟩
    let x : L := c i_zero
    have hc_all := (hval_iff 0).mp hy
    have hx_val : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc_all i_zero with h0 | hle
      · exact Or.inl h0
      · right
        have hi0 : ((i_zero : ℕ) : ℤ) = 0 := rfl
        rw [hi0, add_zero] at hle
        change 0 ≤ (p : ℤ) * valL F L x at hle
        by_contra hlt
        have hle1 : valL F L x ≤ -1 := by omega
        have : (p : ℤ) * valL F L x ≤ (p : ℤ) * (-1) :=
          mul_le_mul_of_nonneg_left hle1 (by omega)
        omega
    refine ⟨x, hx_val, ?_⟩
    let t_term : Fin p → K := fun i =>
      IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ))
    have ht_zero : t_term i_zero = IntermediateField.inclusion hLK x := by
      change IntermediateField.inclusion hLK x * ((ϖ_K : K) ^ (0 : ℕ)) = _
      rw [pow_zero, mul_one]
    have hy_sub : y - IntermediateField.inclusion hLK x =
        ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i_zero, t_term i := by
      have hsum := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) t_term
        (Finset.mem_univ i_zero)).symm
      rw [ht_zero] at hsum
      have hy_eq' : y = ∑ i ∈ (Finset.univ : Finset (Fin p)), t_term i := hy_eq
      rw [hy_eq', hsum, add_sub_cancel_left]
    rw [hy_sub]
    apply hval_finset_sum_K ((Finset.univ : Finset (Fin p)).erase i_zero) t_term 1
    intro i hi
    have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
    have hi_val_ne : (i : ℕ) ≠ 0 := by
      intro h0
      apply hi_ne
      exact Fin.ext h0
    have hi_ge1 : (1 : ℤ) ≤ ((i : ℕ) : ℤ) := by omega
    have hi_lt : ((i : ℕ) : ℤ) < (p : ℤ) := Nat.cast_lt.mpr i.2
    by_cases hci0 : c i = 0
    · left
      simp [t_term, hci0]
    · right
      have hci_ineq : 0 ≤ (p : ℤ) * valL F L (c i) + ((i : ℕ) : ℤ) :=
        (hc_all i).resolve_left hci0
      have hci_val_nonneg : 0 ≤ valL F L (c i) := by
        by_contra hlt
        have hle1 : valL F L (c i) ≤ -1 := by omega
        have : (p : ℤ) * valL F L (c i) ≤ (p : ℤ) * (-1) :=
          mul_le_mul_of_nonneg_left hle1 (by omega)
        omega
      have hinc_ne0 : IntermediateField.inclusion hLK (c i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hci0
      have hpow_ne0 : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 :=
        pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
      have ht_val : valL F K (t_term i) = (p : ℤ) * valL F L (c i) + ((i : ℕ) : ℤ) := by
        change valL F K (IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ))) = _
        rw [hval_mul_K _ _ hinc_ne0 hpow_ne0, hval_alg (c i),
          hval_pow_K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_one]
      rw [ht_val]
      have : 0 ≤ (p : ℤ) * valL F L (c i) := mul_nonneg (by omega) hci_val_nonneg
      omega
  have hresL_congr : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (x₁ - x₂ = 0 ∨ 1 ≤ valL F L (x₁ - x₂)) → resL x₁ = resL x₂ := by
    intro x₁ x₂ hx₁ hx₂ hdiff
    have hsub_val : x₁ - x₂ = 0 ∨ 0 ≤ valL F L (x₁ - x₂) :=
      hval_sub_ge_L 0 x₁ x₂ hx₁ hx₂
    have hker0 : resL (x₁ - x₂) = 0 := (hresL_ker (x₁ - x₂) hsub_val).mpr hdiff
    have hneg_x₂ : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := hval_neg_ge_L 0 x₂ hx₂
    have hring1 := (hresL_ring x₁ (-x₂) hx₁ hneg_x₂).1
    have hring2 := (hresL_ring x₂ 0 hx₂ (Or.inl rfl)).2.2
    rw [sub_eq_add_neg, hring1, hring2] at hker0
    exact sub_eq_zero.mp (by linear_combination hker0)
  let resK : K → k_L := fun y =>
    if hy : y = 0 ∨ 0 ≤ valL F K y then resL (hResSurj y hy).choose else 0
  have hresK_char : ∀ y : K, ∀ x : L,
      (y = 0 ∨ 0 ≤ valL F K y) →
      (x = 0 ∨ 0 ≤ valL F L x) →
      (y - IntermediateField.inclusion hLK x = 0 ∨
        1 ≤ valL F K (y - IntermediateField.inclusion hLK x)) →
      resK y = resL x := by
    intro y x hy hx hdiff
    let x₀ : L := (hResSurj y hy).choose
    have hx₀ : x₀ = 0 ∨ 0 ≤ valL F L x₀ := (hResSurj y hy).choose_spec.1
    have hdiff₀ : y - IntermediateField.inclusion hLK x₀ = 0 ∨
        1 ≤ valL F K (y - IntermediateField.inclusion hLK x₀) :=
      (hResSurj y hy).choose_spec.2
    have hresK_eq : resK y = resL x₀ := dif_pos hy
    rw [hresK_eq]
    have hinc_sub : IntermediateField.inclusion hLK (x₀ - x) =
        (y - IntermediateField.inclusion hLK x) - (y - IntermediateField.inclusion hLK x₀) := by
      rw [map_sub]
      ring
    have hinc_val : IntermediateField.inclusion hLK (x₀ - x) = 0 ∨
        1 ≤ valL F K (IntermediateField.inclusion hLK (x₀ - x)) := by
      rw [hinc_sub]
      exact hval_sub_ge_K 1 _ _ hdiff hdiff₀
    have hsub_L : x₀ - x = 0 ∨ 1 ≤ valL F L (x₀ - x) := by
      by_cases hsub0 : x₀ - x = 0
      · exact Or.inl hsub0
      · right
        have hinc_ne0 : IntermediateField.inclusion hLK (x₀ - x) ≠ 0 :=
          (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hsub0
        have h1 : 1 ≤ valL F K (IntermediateField.inclusion hLK (x₀ - x)) :=
          hinc_val.resolve_left hinc_ne0
        rw [hval_alg (x₀ - x)] at h1
        change 1 ≤ (p : ℤ) * valL F L (x₀ - x) at h1
        by_contra hlt
        have hle0 : valL F L (x₀ - x) ≤ 0 := by omega
        have : (p : ℤ) * valL F L (x₀ - x) ≤ (p : ℤ) * 0 :=
          mul_le_mul_of_nonneg_left hle0 (by omega)
        omega
    exact hresL_congr x₀ x hx₀ hx hsub_L
  have hresK_lift : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        resK y = resL x ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)) := by
    intro y hy
    exact ⟨(hResSurj y hy).choose, (hResSurj y hy).choose_spec.1,
      dif_pos hy, (hResSurj y hy).choose_spec.2⟩
  have hresK_0 : resK 0 = 0 := by
    rw [hresK_char 0 0 (Or.inl rfl) (Or.inl rfl) (Or.inl (by simp)), hresL_0]
  have hresK_1 : resK 1 = 1 := by
    rw [hresK_char 1 1 (Or.inr (by rw [hval1_K])) (Or.inr (by rw [hval1_L]))
      (Or.inl (by simp)), hresL_1]
  have hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁ := by
    intro y₁ y₂ hy₁ hy₂
    obtain ⟨x₁, hx₁, hres₁, hdiff₁⟩ := hresK_lift y₁ hy₁
    obtain ⟨x₂, hx₂, hres₂, hdiff₂⟩ := hresK_lift y₂ hy₂
    refine ⟨?_, ?_, ?_⟩
    · have hy_add : y₁ + y₂ = 0 ∨ 0 ≤ valL F K (y₁ + y₂) := hval_add_K 0 y₁ y₂ hy₁ hy₂
      have hx_add : x₁ + x₂ = 0 ∨ 0 ≤ valL F L (x₁ + x₂) := hval_add_L 0 x₁ x₂ hx₁ hx₂
      have hdiff_add : (y₁ + y₂) - IntermediateField.inclusion hLK (x₁ + x₂) = 0 ∨
          1 ≤ valL F K ((y₁ + y₂) - IntermediateField.inclusion hLK (x₁ + x₂)) := by
        have heq : (y₁ + y₂) - IntermediateField.inclusion hLK (x₁ + x₂) =
            (y₁ - IntermediateField.inclusion hLK x₁) +
              (y₂ - IntermediateField.inclusion hLK x₂) := by
          rw [map_add]; ring
        rw [heq]
        exact hval_add_K 1 _ _ hdiff₁ hdiff₂
      rw [hresK_char (y₁ + y₂) (x₁ + x₂) hy_add hx_add hdiff_add,
        (hresL_ring x₁ x₂ hx₁ hx₂).1, hres₁, hres₂]
    · have hy_mul : y₁ * y₂ = 0 ∨ 0 ≤ valL F K (y₁ * y₂) := by
        simpa using hval_mul_ge_K 0 0 y₁ y₂ hy₁ hy₂
      have hx_mul : x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂) := by
        simpa using hval_mul_ge_L 0 0 x₁ x₂ hx₁ hx₂
      have hdiff_mul : (y₁ * y₂) - IntermediateField.inclusion hLK (x₁ * x₂) = 0 ∨
          1 ≤ valL F K ((y₁ * y₂) - IntermediateField.inclusion hLK (x₁ * x₂)) := by
        have heq : (y₁ * y₂) - IntermediateField.inclusion hLK (x₁ * x₂) =
            (y₁ - IntermediateField.inclusion hLK x₁) * y₂ +
              IntermediateField.inclusion hLK x₁ *
                (y₂ - IntermediateField.inclusion hLK x₂) := by
          rw [map_mul]; ring
        rw [heq]
        have ht1 : (y₁ - IntermediateField.inclusion hLK x₁) * y₂ = 0 ∨
            1 ≤ valL F K ((y₁ - IntermediateField.inclusion hLK x₁) * y₂) := by
          simpa using hval_mul_ge_K 1 0 _ y₂ hdiff₁ hy₂
        have hx₁_inc : IntermediateField.inclusion hLK x₁ = 0 ∨
            0 ≤ valL F K (IntermediateField.inclusion hLK x₁) := by
          simpa using hval_inc_ge 0 x₁ hx₁
        have ht2 : IntermediateField.inclusion hLK x₁ *
              (y₂ - IntermediateField.inclusion hLK x₂) = 0 ∨
            1 ≤ valL F K (IntermediateField.inclusion hLK x₁ *
              (y₂ - IntermediateField.inclusion hLK x₂)) := by
          simpa using hval_mul_ge_K 0 1 _ _ hx₁_inc hdiff₂
        exact hval_add_K 1 _ _ ht1 ht2
      rw [hresK_char (y₁ * y₂) (x₁ * x₂) hy_mul hx_mul hdiff_mul,
        (hresL_ring x₁ x₂ hx₁ hx₂).2.1, hres₁, hres₂]
    · have hy_neg : -y₁ = 0 ∨ 0 ≤ valL F K (-y₁) := hval_neg_ge_K 0 y₁ hy₁
      have hx_neg : -x₁ = 0 ∨ 0 ≤ valL F L (-x₁) := hval_neg_ge_L 0 x₁ hx₁
      have hdiff_neg : (-y₁) - IntermediateField.inclusion hLK (-x₁) = 0 ∨
          1 ≤ valL F K ((-y₁) - IntermediateField.inclusion hLK (-x₁)) := by
        have heq : (-y₁) - IntermediateField.inclusion hLK (-x₁) =
            -(y₁ - IntermediateField.inclusion hLK x₁) := by
          rw [map_neg]; ring
        rw [heq]
        exact hval_neg_ge_K 1 _ hdiff₁
      rw [hresK_char (-y₁) (-x₁) hy_neg hx_neg hdiff_neg,
        (hresL_ring x₁ x₂ hx₁ hx₂).2.2, hres₁]
  have hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)) := by
    intro y hy
    obtain ⟨x, hx, hres, hdiff⟩ := hresK_lift y hy
    constructor
    · intro h0
      have hx0 : resL x = 0 := by rw [← hres, h0]
      have hx1 : x = 0 ∨ 1 ≤ valL F L x := (hresL_ker x hx).mp hx0
      have hx_inc1 : IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (IntermediateField.inclusion hLK x) := by
        rcases hval_inc_ge 1 x hx1 with hinc0 | hinc_le
        · exact Or.inl hinc0
        · right; omega
      have hy_eq : y = (y - IntermediateField.inclusion hLK x) +
          IntermediateField.inclusion hLK x := (sub_add_cancel y _).symm
      rw [hy_eq]
      exact hval_add_K 1 _ _ hdiff hx_inc1
    · intro hy1
      have hdiff0 : y - IntermediateField.inclusion hLK 0 = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK 0) := by
        simpa using hy1
      rw [hresK_char y 0 hy (Or.inl rfl) hdiff0, hresL_0]
  have hresK_surj : ∀ a : k_L, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = a := by
    intro a
    obtain ⟨x, hx, hres_x⟩ := hresL_surj a
    let y : K := IntermediateField.inclusion hLK x
    have hy : y = 0 ∨ 0 ≤ valL F K y := by
      simpa [y] using hval_inc_ge 0 x hx
    refine ⟨y, hy, ?_⟩
    rw [hresK_char y x hy hx (Or.inl (sub_self y)), hres_x]
  have hres_pow_L : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
      ∀ n : ℕ, (x ^ n = 0 ∨ 0 ≤ valL F L (x ^ n)) ∧ resL (x ^ n) = (resL x) ^ n := by
    intro x hx n
    induction n with
    | zero =>
      refine ⟨Or.inr (by rw [pow_zero, hval1_L]), ?_⟩
      rw [pow_zero, pow_zero, hresL_1]
    | succ n ih =>
      have hpow_val : x ^ (n + 1) = 0 ∨ 0 ≤ valL F L (x ^ (n + 1)) := by
        rw [pow_succ]
        simpa using hval_mul_ge_L 0 0 (x ^ n) x ih.1 hx
      refine ⟨hpow_val, ?_⟩
      rw [pow_succ, (hresL_ring (x ^ n) x ih.1 hx).2.1, ih.2, pow_succ]
  have hnorm_inc : ∀ x : L, normLM F hLK (IntermediateField.inclusion hLK x) = x ^ p := by
    intro x
    change Algebra.norm L (algebraMap L (IntermediateField.extendScalars hLK) x) = x ^ p
    exact Algebra.norm_algebraMap x
  have hresK_norm : ∀ w : Kˣ, valL F K (w : K) = 0 →
      resL ((Units.map (normLM F hLK) w : Lˣ) : L) = (resK (w : K)) ^ p := by
    intro w hw0
    have hw_val : (w : K) = 0 ∨ 0 ≤ valL F K (w : K) := Or.inr (by omega)
    obtain ⟨x, hx_val, hres_eq, hdiff⟩ := hresK_lift (w : K) hw_val
    have hw_not_ker : ¬ ((w : K) = 0 ∨ 1 ≤ valL F K (w : K)) := by
      rintro (hw_z | hw_ge1)
      · exact Units.ne_zero w hw_z
      · omega
    have hresK_ne0 : resK (w : K) ≠ 0 := by
      intro h0
      exact hw_not_ker ((hresK_ker (w : K) hw_val).mp h0)
    have hresL_ne0 : resL x ≠ 0 := by
      rw [← hres_eq]
      exact hresK_ne0
    have hx_not_ker : ¬ (x = 0 ∨ 1 ≤ valL F L x) := by
      intro hker
      exact hresL_ne0 ((hresL_ker x hx_val).mpr hker)
    have hx_ne0 : x ≠ 0 := fun h0 => hx_not_ker (Or.inl h0)
    have hx_val0 : valL F L x = 0 := by
      have hx_ge0 : 0 ≤ valL F L x := hx_val.resolve_left hx_ne0
      have hx_lt1 : ¬ (1 ≤ valL F L x) := fun h1 => hx_not_ker (Or.inr h1)
      omega
    let u_x : Lˣ := Units.mk0 x hx_ne0
    let w_x : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom u_x
    have hwx_coe : (w_x : K) = IntermediateField.inclusion hLK x := rfl
    have hwx_inv_val : valL F K ((w_x⁻¹ : Kˣ) : K) = 0 := by
      rw [hval_inv_K w_x, hwx_coe, hval_alg x, hx_val0, mul_zero, neg_zero]
    let w₁ : Kˣ := w * w_x⁻¹
    have hw₁_sub : (w₁ : K) - 1 =
        ((w : K) - IntermediateField.inclusion hLK x) * ((w_x⁻¹ : Kˣ) : K) := by
      calc (w₁ : K) - 1 = (w : K) * ((w_x⁻¹ : Kˣ) : K) - (w_x : K) * ((w_x⁻¹ : Kˣ) : K) := by
            rw [Units.mul_inv]; rfl
        _ = ((w : K) - IntermediateField.inclusion hLK x) * ((w_x⁻¹ : Kˣ) : K) := by
            rw [hwx_coe, sub_mul]
    have hw₁_diff : (w₁ : K) - 1 = 0 ∨ 1 ≤ valL F K ((w₁ : K) - 1) := by
      rw [hw₁_sub]
      simpa using hval_mul_ge_K 1 0 _ ((w_x⁻¹ : Kˣ) : K) hdiff (Or.inr (by omega))
    have hw₁_mem1 : w₁ ∈ unitGroup F K 1 := by
      rw [hunit_ge1_K 1 le_rfl w₁]
      rcases hw₁_diff with h0 | h1
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr h1
    have hnw₁_mem1 : Units.map (normLM F hLK) w₁ ∈ unitGroup F L 1 :=
      hnorm_le 1 (by omega) w₁ hw₁_mem1
    have hnw₁_diff : ((Units.map (normLM F hLK) w₁ : Lˣ) : L) - 1 = 0 ∨
        1 ≤ valL F L (((Units.map (normLM F hLK) w₁ : Lˣ) : L) - 1) := by
      rcases (hunit_ge1_L 1 le_rfl _).mp hnw₁_mem1 with h1 | hge1
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge1
    have hnw_x : ((Units.map (normLM F hLK) w_x : Lˣ) : L) = x ^ p := hnorm_inc x
    have hw_eq : w = w₁ * w_x := by
      dsimp [w₁]
      exact (inv_mul_cancel_right w w_x).symm
    have hnw_sub : ((Units.map (normLM F hLK) w : Lˣ) : L) - x ^ p =
        (((Units.map (normLM F hLK) w₁ : Lˣ) : L) - 1) * (x ^ p) := by
      conv_lhs => rw [hw_eq, map_mul, Units.val_mul, hnw_x]
      ring
    have hxp_val : x ^ p = 0 ∨ 0 ≤ valL F L (x ^ p) := (hres_pow_L x hx_val p).1
    have hnw_diff : ((Units.map (normLM F hLK) w : Lˣ) : L) - x ^ p = 0 ∨
        1 ≤ valL F L (((Units.map (normLM F hLK) w : Lˣ) : L) - x ^ p) := by
      rw [hnw_sub]
      simpa using hval_mul_ge_L 1 0 _ (x ^ p) hnw₁_diff hxp_val
    have hnw_val : ((Units.map (normLM F hLK) w : Lˣ) : L) = 0 ∨
        0 ≤ valL F L ((Units.map (normLM F hLK) w : Lˣ) : L) := by
      have heq : ((Units.map (normLM F hLK) w : Lˣ) : L) =
          (((Units.map (normLM F hLK) w : Lˣ) : L) - x ^ p) + x ^ p :=
        (sub_add_cancel _ _).symm
      rw [heq]
      have hnw_diff0 : ((Units.map (normLM F hLK) w : Lˣ) : L) - x ^ p = 0 ∨
          0 ≤ valL F L (((Units.map (normLM F hLK) w : Lˣ) : L) - x ^ p) := by
        rcases hnw_diff with h0 | h1
        · exact Or.inl h0
        · right; omega
      exact hval_add_L 0 _ _ hnw_diff0 hxp_val
    rw [hresL_congr _ (x ^ p) hnw_val hxp_val hnw_diff,
      (hres_pow_L x hx_val p).2, hres_eq]
  exact ⟨resK, hresK_0, hresK_1, hresK_ring, hresK_ker, hresK_surj,
    hresK_char, hresK_lift, hresK_norm⟩

theorem ld_wild_cond_one_trace_dual_and_frob_shift (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (ha1 : condExp F L χ' = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (resK : K → k_L)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (hresK_lift : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        resK y = resL x ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)))
    (hresK_norm : ∀ w : Kˣ, valL F K (w : K) = 0 →
      resL ((Units.map (normLM F hLK) w : Lˣ) : L) =
        (resK (w : K)) ^ (Module.finrank L (IntermediateField.extendScalars hLK)))
    (t : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (htr_surj : ∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x +
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (c_τ : Lˣ)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x)) :
    ∃ (c_K : Kˣ),
      valL F K (c_K : K) = 1 + condExpChar F K (traceChar F hLK ψ) ∧
      Units.map (normLM F hLK) c_K *
        (tateElt F L χ' ψ *
          ((-1 : Lˣ) * c_τ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1)))⁻¹ ∈
        unitGroup F L 1 ∧
      (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
        ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
          resL x = (resK y) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) →
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y) =
            ψ ((((tateElt F L χ' ψ)⁻¹ : Lˣ) : L) * x)) :=
by
  
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL_props
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K,
    hval_surj_K, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := hvalK_props
  obtain ⟨hψ_triv, hψ_nontriv, hχ'_spec, hc₁_val_raw⟩ := hSpecL χ'
  let K' := IntermediateField.extendScalars hLK
  set p := Module.finrank L K'
  set n := condExpChar F L ψ
  set c₁ : Lˣ := tateElt F L χ' ψ
  have hp_pos : 0 < p := hPrime.pos
  have hp_ne_zero : p ≠ 0 := hPrime.ne_zero
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hc₁_val : valL F L (c₁ : L) = 1 + n := by
    rw [hc₁_val_raw, ha1]
    push_cast
    ring
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  haveI : Module.Free L K' := Module.Free.of_divisionRing L K'
  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ p := by
    intro x
    change Algebra.norm L (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = x ^ p
    rw [hto_inc x]
    exact Algebra.norm_algebraMap x
  have hnorm_inc_unit : ∀ u : Lˣ,
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom u) =
        u ^ p := by
    intro u
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (u : L)) = ((u ^ p : Lˣ) : L)
    rw [hnorm_inc (u : L), Units.val_pow_eq_pow_val]
  have htrace_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    intro x y
    letI : Module L L := Semiring.toModule
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * Algebra.trace L K' (toExtendScalars F hLK y)
    rw [map_mul, hto_inc x, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  have htrace_one : traceLM F hLK (1 : K) = (p : L) := by
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK 1)) = (p : L)
    rw [hto_inc 1, Algebra.trace_algebraMap (1 : L), nsmul_one]
  have hvalL_neg_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (-x = 0 ∨ 0 ≤ valL F L (-x)) := by
    intro x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hval_neg_L]; exact hx)
  have hvalL_sub_int : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (x₁ - x₂ = 0 ∨ 0 ≤ valL F L (x₁ - x₂)) ∧ resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    have hneg : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := hvalL_neg_int x₂ hx₂
    refine ⟨?_, ?_⟩
    · rw [sub_eq_add_neg]
      exact hval_add_L 0 x₁ (-x₂) hx₁ hneg
    · rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ hneg).1, (hresL_ring x₂ x₂ hx₂ hx₂).2.2,
