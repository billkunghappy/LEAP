      intro hS
      rw [Finset.sum_insert ha]
      have h1 : f a = 0 ∨ B ≤ valL F K₁ (f a) := hS a (Finset.mem_insert_self a S')
      have h2 : (∑ r ∈ S', f r) = 0 ∨ B ≤ valL F K₁ (∑ r ∈ S', f r) :=
        ih (fun r hr => hS r (Finset.mem_insert_of_mem hr))
      exact hvalK_add B (f a) (∑ r ∈ S', f r) h1 h2
  have hpoly_zero : ∀ (n : ℕ) (D : ℕ → K₁),
      (∀ c : L, (∑ r ∈ Finset.Icc 1 n, (ι_K c) ^ r * D r) = 0) →
      ∀ r ∈ Finset.Icc 1 n, D r = 0 := by
    intro n
    induction n with
    | zero =>
      intro D _ r hr
      simp at hr
    | succ n ih =>
      intro D hD
      have hD_top : D (n + 1) = 0 := by
        by_contra hne_top
        let M : ℤ :=
          (∑ r ∈ Finset.Icc 1 n, |valL F K₁ (D r) - valL F K₁ (D (n + 1))|) + 1
        have hM_sum_nonneg :
            0 ≤ ∑ r ∈ Finset.Icc 1 n, |valL F K₁ (D r) - valL F K₁ (D (n + 1))| :=
          Finset.sum_nonneg (fun r _ => abs_nonneg _)
        have hM_ge1 : 1 ≤ M := by
          dsimp only [M]
          linarith
        obtain ⟨u, hu_val⟩ := hvalL_surj (-M)
        let c : L := (u : L)
        have hc_ne0 : c ≠ 0 := Units.ne_zero u
        have hιc_ne0 : ι_K c ≠ 0 := (map_ne_zero_iff ι_K ι_K.injective).mpr hc_ne0
        have hval_ιc : valL F K₁ (ι_K c) = - ((p : ℤ) * M) := by
          rw [hval_ιK c, hu_val]
          ring
        let V_top : ℤ :=
          - (((n + 1 : ℕ) : ℤ) * ((p : ℤ) * M)) + valL F K₁ (D (n + 1))
        have htop_ne0 : (ι_K c) ^ (n + 1) * D (n + 1) ≠ 0 :=
          mul_ne_zero (pow_ne_zero (n + 1) hιc_ne0) hne_top
        have htop_val : valL F K₁ ((ι_K c) ^ (n + 1) * D (n + 1)) = V_top := by
          rw [hvalK_mul ((ι_K c) ^ (n + 1)) (D (n + 1))
            (pow_ne_zero (n + 1) hιc_ne0) hne_top,
            (hpow_valK (ι_K c) hιc_ne0 (n + 1)).2, hval_ιc]
          dsimp only [V_top]
          ring
        have hlow_term : ∀ r ∈ Finset.Icc 1 n,
            (ι_K c) ^ r * D r = 0 ∨ V_top + 1 ≤ valL F K₁ ((ι_K c) ^ r * D r) := by
          intro r hr
          by_cases hDr : D r = 0
          · left; rw [hDr, mul_zero]
          · right
            have habs_le : |valL F K₁ (D r) - valL F K₁ (D (n + 1))| ≤ M - 1 := by
              have hsingle := Finset.single_le_sum
                (f := fun k => |valL F K₁ (D k) - valL F K₁ (D (n + 1))|)
                (fun k _ => abs_nonneg _) hr
              dsimp only [M]
              linarith
            have hdiff_le : valL F K₁ (D (n + 1)) - valL F K₁ (D r) ≤ M - 1 := by
              have hneg := neg_le_abs (valL F K₁ (D r) - valL F K₁ (D (n + 1)))
              linarith
            have hval_r :
                valL F K₁ ((ι_K c) ^ r * D r) =
                  - ((r : ℤ) * ((p : ℤ) * M)) + valL F K₁ (D r) := by
              rw [hvalK_mul ((ι_K c) ^ r) (D r) (pow_ne_zero r hιc_ne0) hDr,
                (hpow_valK (ι_K c) hιc_ne0 r).2, hval_ιc]
              ring
            rw [hval_r]
            dsimp only [V_top]
            have hr_le : r ≤ n := (Finset.mem_Icc.mp hr).2
            have hstep1 : (1 : ℤ) ≤ ((n + 1 : ℕ) : ℤ) - (r : ℤ) := by omega
            have hstep2 : (1 : ℤ) * M ≤ (p : ℤ) * M := by
              apply mul_le_mul_of_nonneg_right <;> omega
            have hstep3 :
                (p : ℤ) * M ≤
                  (((n + 1 : ℕ) : ℤ) - (r : ℤ)) * ((p : ℤ) * M) := by
              have hpm : 0 ≤ (p : ℤ) * M := by positivity
              nlinarith
            linarith
        have hlow_sum := hsum_valK (Finset.Icc 1 n) (fun r => (ι_K c) ^ r * D r)
          (V_top + 1) hlow_term
        have hsplit :
            (∑ r ∈ Finset.Icc 1 (n + 1), (ι_K c) ^ r * D r) =
              (∑ r ∈ Finset.Icc 1 n, (ι_K c) ^ r * D r) +
                (ι_K c) ^ (n + 1) * D (n + 1) :=
          Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => (ι_K c) ^ r * D r)
        have hsum0 :
            (∑ r ∈ Finset.Icc 1 n, (ι_K c) ^ r * D r) +
              (ι_K c) ^ (n + 1) * D (n + 1) = 0 := by
          rw [← hsplit]
          exact hD c
        have heq_neg :
            (ι_K c) ^ (n + 1) * D (n + 1) =
              - (∑ r ∈ Finset.Icc 1 n, (ι_K c) ^ r * D r) := by
          linear_combination hsum0
        rcases hlow_sum with hlow0 | hlow_ge
        · rw [hlow0, neg_zero] at heq_neg
          exact htop_ne0 heq_neg
        · dsimp only at hlow_ge
          have hval_eq :
              valL F K₁ ((ι_K c) ^ (n + 1) * D (n + 1)) =
                valL F K₁ (∑ r ∈ Finset.Icc 1 n, (ι_K c) ^ r * D r) := by
            rw [heq_neg, hvalK_neg]
          linarith [htop_val, hval_eq, hlow_ge]
      have hD_low : ∀ c : L, (∑ r ∈ Finset.Icc 1 n, (ι_K c) ^ r * D r) = 0 := by
        intro c
        have hsplit :=
          Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => (ι_K c) ^ r * D r)
        rw [hD c, hD_top, mul_zero, add_zero] at hsplit
        exact hsplit.symm
      intro r hr
      rcases Nat.eq_or_lt_of_le (Finset.mem_Icc.mp hr).2 with rfl | hlt
      · exact hD_top
      · exact ih D hD_low r
          (Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp hr).1, Nat.lt_succ_iff.mp hlt⟩)
  have hs_incl : ∀ r ∈ Finset.Icc 1 (p - 1), ι_K (s x r) = E_x r := by
    intro r hr
    have h0 := hpoly_zero (p - 1) (fun k => ι_K (s x k) - E_x k) hdiff_sum_zero r hr
    exact sub_eq_zero.mp h0
  set C₀ : K₁ := IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d
  set N_U : M₁' := normLM F hM₁'K₁ C₀
  have hNU_eq :
      N_U =
        d ^ p + (∑ i ∈ Finset.Icc 1 (p - 1),
          IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i)) +
          IntermediateField.inclusion hLM₁' A := by
    apply ι_KU.injective
    have h1 : ι_KU N_U = ∏ τ ∈ U_G, (1 * act τ x_K + ι_KU d) := by
      rw [hact_norm C₀]
      refine Finset.prod_congr rfl fun τ _ => ?_
      change act τ (x_K + ι_KU d) = 1 * act τ x_K + ι_KU d
      rw [hact_add, hact_inclM τ d, one_mul]
    rw [h1, hprod_linear 1 (ι_KU d), one_pow, one_mul, hnorm_xK]
    change (ι_KU d) ^ p +
      (∑ i ∈ Finset.Icc 1 (p - 1), (1 : K₁) ^ i * E_x i * (ι_KU d) ^ (p - i)) +
      ι_KU (ι_U A) =
      ι_KU (d ^ p + (∑ i ∈ Finset.Icc 1 (p - 1), ι_U (s x i) * d ^ (p - i)) + ι_U A)
    rw [map_add, map_add, map_pow, map_sum]
    congr 2
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [one_pow, one_mul, ← hs_incl i hi, map_mul, map_pow]
    rfl
  
  have hvalM_sub : ∀ (k : ℤ) (y z : M₁'),
      (y = 0 ∨ k ≤ valL F M₁' y) → (z = 0 ∨ k ≤ valL F M₁' z) →
        (y - z = 0 ∨ k ≤ valL F M₁' (y - z)) := by
    intro k y z hy hz
    have hnz : -z = 0 ∨ k ≤ valL F M₁' (-z) := by
      rcases hz with rfl | hge
      · exact Or.inl neg_zero
      · right; rwa [hvalM_neg]
    rw [sub_eq_add_neg]
    exact hvalM_add k y (-z) hy hnz
  have hvalM_mul_ge : ∀ (k₁ k₂ : ℤ) (y z : M₁'),
      (y = 0 ∨ k₁ ≤ valL F M₁' y) → (z = 0 ∨ k₂ ≤ valL F M₁' z) →
        (y * z = 0 ∨ k₁ + k₂ ≤ valL F M₁' (y * z)) := by
    intro k₁ k₂ y z hy hz
    by_cases hy0 : y = 0
    · left; rw [hy0, zero_mul]
    · by_cases hz0 : z = 0
      · left; rw [hz0, mul_zero]
      · right
        rw [hvalM_mul y z hy0 hz0]
        exact add_le_add (hy.resolve_left hy0) (hz.resolve_left hz0)
  have hvalM_pow_int : ∀ (z : M₁') (n : ℕ),
      (z = 0 ∨ 0 ≤ valL F M₁' z) → (z ^ n = 0 ∨ 0 ≤ valL F M₁' (z ^ n)) := by
    intro z n hz
    induction n with
    | zero =>
      rw [pow_zero]
      exact Or.inr (le_of_eq hvalM1.symm)
    | succ n ih =>
      rw [pow_succ']
      have hmul := hvalM_mul_ge 0 0 z (z ^ n) hz ih
      rwa [add_zero] at hmul
  have hsum_valM : ∀ (S : Finset ℕ) (f : ℕ → M₁') (B : ℤ),
      (∀ r ∈ S, f r = 0 ∨ B ≤ valL F M₁' (f r)) →
      (∑ r ∈ S, f r) = 0 ∨ B ≤ valL F M₁' (∑ r ∈ S, f r) := by
    intro S f B
    induction S using Finset.induction_on with
    | empty =>
      intro _
      exact Or.inl Finset.sum_empty
    | @insert a S' ha ih =>
      intro hS
      rw [Finset.sum_insert ha]
      have h1 : f a = 0 ∨ B ≤ valL F M₁' (f a) := hS a (Finset.mem_insert_self a S')
      have h2 : (∑ r ∈ S', f r) = 0 ∨ B ≤ valL F M₁' (∑ r ∈ S', f r) :=
        ih (fun r hr => hS r (Finset.mem_insert_of_mem hr))
      exact hvalM_add B (f a) (∑ r ∈ S', f r) h1 h2
  have hx_val_bound : x = 0 ∨ -(h : ℤ) ≤ valL F E' x := by
    by_cases hh0 : h = 0
    · rcases hx_zero hh0 with rfl | hx_ge
      · exact Or.inl rfl
      · right; omega
    · have hh_pos : 0 < h := Nat.pos_of_ne_zero hh0
      right
      rw [(hx_pos hh_pos).2.1]
  have hh_lt_T : h < T := by omega
  have hs_term_val : ∀ i ∈ Finset.Icc 1 (p - 1),
      IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i) = 0 ∨
        1 - (h : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i)) := by
    intro i hi
    have hi_bounds := Finset.mem_Icc.mp hi
    have hineq :
        (p : ℤ) * (1 - (h : ℤ)) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (i : ℤ) * (-(h : ℤ)) := by
      have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
      rw [hp1]
      have hi_le : (i : ℤ) ≤ (p : ℤ) - 1 := by omega
      have hh_nonneg : (0 : ℤ) ≤ (h : ℤ) := Nat.cast_nonneg h
      have hmul_le : (i : ℤ) * (h : ℤ) ≤ ((p : ℤ) - 1) * (h : ℤ) :=
        mul_le_mul_of_nonneg_right hi_le hh_nonneg
      have hp_sub : (1 : ℤ) ≤ (p : ℤ) - 1 := by omega
      have hT_sub : (h : ℤ) + 1 ≤ (T : ℤ) := by omega
      nlinarith
    have hs_i := hs_val x i hi (-(h : ℤ)) (1 - (h : ℤ)) hx_val_bound hineq
    have hincl_i :
        IntermediateField.inclusion hLM₁' (s x i) = 0 ∨
          1 - (h : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (s x i)) := by
      rcases hs_i with h0 | hge
      · left; rw [h0, map_zero]
      · right; rwa [hval_LM₁']
    have hd_pow : d ^ (p - i) = 0 ∨ 0 ≤ valL F M₁' (d ^ (p - i)) :=
      hvalM_pow_int d (p - i) (Or.inr (le_of_eq hd_val.symm))
    have hmul := hvalM_mul_ge (1 - (h : ℤ)) 0 _ _ hincl_i hd_pow
    rwa [add_zero] at hmul
  have hsum_s_val :
      (∑ i ∈ Finset.Icc 1 (p - 1), IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i)) = 0 ∨
        1 - (h : ℤ) ≤
          valL F M₁' (∑ i ∈ Finset.Icc 1 (p - 1),
            IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i)) :=
    hsum_valM (Finset.Icc 1 (p - 1)) _ (1 - (h : ℤ)) hs_term_val
  have hε₀_val_bound :
      IntermediateField.inclusion hLM₁' ε₀ = 0 ∨
        1 - (h : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' ε₀) := by
    by_cases hh0 : h = 0
    · left
      have hlt : h < T - 1 := by omega
      rw [hε₀_lt hlt, map_zero]
    · rcases hε₀_int with rfl | hge0
      · left; exact map_zero _
      · right
        rw [hval_LM₁']
        omega
  have hNU_sub_BU_eq :
      N_U - B_U =
        (∑ i ∈ Finset.Icc 1 (p - 1),
          IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i)) -
          IntermediateField.inclusion hLM₁' ε₀ := by
    rw [hNU_eq]
    dsimp only [B_U]
    rw [map_add]
    ring
  have hNU_sub_BU_val :
      N_U - B_U = 0 ∨ 1 - (h : ℤ) ≤ valL F M₁' (N_U - B_U) := by
    rw [hNU_sub_BU_eq]
    exact hvalM_sub (1 - (h : ℤ)) _ _ hsum_s_val hε₀_val_bound
  
  have hBU_val' : valL F M₁' B_U = -(h : ℤ) := hBU_val
  have hBU_ne0' : B_U ≠ 0 := hBU_ne0
  have hNU_ne0 : N_U ≠ 0 := by
    intro h0
    have hdiff_eq : N_U - B_U = -B_U := by rw [h0, zero_sub]
    have hdiff_ne0 : N_U - B_U ≠ 0 := by
      rw [hdiff_eq]
      exact neg_ne_zero.mpr hBU_ne0'
    have hge : 1 - (h : ℤ) ≤ valL F M₁' (N_U - B_U) :=
      hNU_sub_BU_val.resolve_left hdiff_ne0
    rw [hdiff_eq, hvalM_neg, hBU_val'] at hge
    omega
  have hNU_val : valL F M₁' N_U = -(h : ℤ) := by
    have hge : -(h : ℤ) ≤ valL F M₁' N_U := by
      have h1 : B_U = 0 ∨ -(h : ℤ) ≤ valL F M₁' B_U := Or.inr (le_of_eq hBU_val'.symm)
      have h2 : N_U - B_U = 0 ∨ -(h : ℤ) ≤ valL F M₁' (N_U - B_U) := by
        rcases hNU_sub_BU_val with h0 | hge1
        · exact Or.inl h0
        · right; omega
      have hadd := hvalM_add (-(h : ℤ)) B_U (N_U - B_U) h1 h2
      have heq : B_U + (N_U - B_U) = N_U := add_sub_cancel B_U N_U
      rw [heq] at hadd
      exact hadd.resolve_left hNU_ne0
    have hle : valL F M₁' N_U ≤ -(h : ℤ) := by
      by_contra hlt
      have hge1 : 1 - (h : ℤ) ≤ valL F M₁' N_U := by omega
      have hsub := hvalM_sub (1 - (h : ℤ)) N_U (N_U - B_U) (Or.inr hge1) hNU_sub_BU_val
      have heq : N_U - (N_U - B_U) = B_U := sub_sub_cancel N_U B_U
      rw [heq] at hsub
      have hBU_ge1 : 1 - (h : ℤ) ≤ valL F M₁' B_U := hsub.resolve_left hBU_ne0'
      linarith [hBU_val']
    omega
  have hC₀_ne0 : C₀ ≠ 0 := by
    intro h0
    apply hNU_ne0
    dsimp only [N_U]
    rw [h0]
    change Algebra.norm M₁' (0 : K₁_M) = 0
    exact Algebra.norm_zero
  let C : K₁ˣ := Units.mk0 C₀ hC₀_ne0
  let Z_U : M₁'ˣ := Units.map (normLM F hM₁'K₁) C
  let Z_E : E'ˣ := Units.map (normLM F hE'K₁) C
  have hZU_coe : (Z_U : M₁') = N_U := rfl
  have hZE_coe : (Z_E : E') = normLM F hE'K₁ C₀ := rfl
  have hval_C₀ : valL F K₁ C₀ = -(h : ℤ) := by
    rw [← hval_norm_M₁'K₁ C₀]
    exact hNU_val
  have hZE_val : valL F E' (Z_E : E') = -((p * h : ℕ) : ℤ) := by
    rw [hZE_coe, hval_norm_E'K₁ C₀, hval_C₀]
    push_cast
    ring
  set cM₁' : M₁'ˣ := (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) * Z_U⁻¹
  set cE' : E'ˣ := (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) * Z_E⁻¹
  have hcM₁'_val : valL F M₁' (cM₁' : M₁') = (mM₁' : ℤ) + condExpChar F M₁' ψM₁' := by
    let u₁ : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν
    change valL F M₁' ((u₁ * Z_U⁻¹ : M₁'ˣ) : M₁') = _
    rw [Units.val_mul, hvalM_mul _ _ (Units.ne_zero u₁) (Units.ne_zero Z_U⁻¹),
      hvalM_inv Z_U, hZU_coe, hNU_val]
    have hu₁_val : valL F M₁' (u₁ : M₁') = (T : ℤ) + condExpChar F L ψ := by
      change valL F M₁' (IntermediateField.inclusion hLM₁' (c_ν : L)) = _
      rw [hval_LM₁', hc_ν_val]
    rw [hu₁_val, hnM₁'_eq]
    have hTh : (T : ℤ) + (h : ℤ) = (mM₁' : ℤ) := by
      dsimp only [h]
      omega
    linarith
  have hcE'_val : valL F E' (cE' : E') = (mE' : ℤ) + condExpChar F E' ψE' := by
