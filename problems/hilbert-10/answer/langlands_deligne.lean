        have h1 : (Δ_val ^ p - Δ_val) ^ p =
            (iM₁'K₁ b) ^ p +
              (-W_Δ) * (iM₁'K₁ b) ^ (p - 1) * ((p : ℕ) : R_K) +
              (∑ r ∈ Finset.Icc 2 (p - 1),
                (-W_Δ) ^ r * (iM₁'K₁ b) ^ (p - r) * ((p.choose r : ℕ) : R_K)) +
              (-W_Δ) ^ p := by
          rw [hΔ_p_sub, hadd_pow_split2 (-W_Δ) (iM₁'K₁ b)]
        rw [hQ_p_def, h1, trM₁'K₁.map_add, trM₁'K₁.map_add, trM₁'K₁.map_add, map_sum]
        have h0_tr : trM₁'K₁ ((iM₁'K₁ b) ^ p) = ((p : ℕ) : R_M) * b ^ p := by
          have hp_incl : (iM₁'K₁ b) ^ p = iM₁'K₁ (b ^ p) := (map_pow iM₁'K₁ b p).symm
          rw [hp_incl, htr_incl_M₁'K₁ (b ^ p)]
        have h1_tr :
            trM₁'K₁ ((-W_Δ) * (iM₁'K₁ b) ^ (p - 1) * ((p : ℕ) : R_K)) =
            - (((p : ℕ) : R_M) * b ^ (p - 1) * trM₁'K₁ W_Δ) := by
          have heq : (-W_Δ) * (iM₁'K₁ b) ^ (p - 1) * ((p : ℕ) : R_K) =
              - (iM₁'K₁ (((p : ℕ) : R_M) * b ^ (p - 1)) * W_Δ) := by
            rw [map_mul, map_natCast, map_pow]
            ring
          rw [heq, map_neg, htr_smul_M₁'K₁]
        have hmid_tr :
            (∑ r ∈ Finset.Icc 2 (p - 1),
              trM₁'K₁ ((-W_Δ) ^ r * (iM₁'K₁ b) ^ (p - r) * ((p.choose r : ℕ) : R_K))) =
            ∑ r ∈ Finset.Icc 2 (p - 1),
              ((p.choose r : ℕ) : R_M) * b ^ (p - r) * trM₁'K₁ ((-W_Δ) ^ r) := by
          refine Finset.sum_congr rfl fun r _ => ?_
          have heq : (-W_Δ) ^ r * (iM₁'K₁ b) ^ (p - r) * ((p.choose r : ℕ) : R_K) =
              iM₁'K₁ (((p.choose r : ℕ) : R_M) * b ^ (p - r)) * ((-W_Δ) ^ r) := by
            rw [map_mul, map_natCast, map_pow]
