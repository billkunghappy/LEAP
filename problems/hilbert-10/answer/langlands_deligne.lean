      have h1w : 1 + w = IntermediateField.inclusion hEK (1 + y) := by
        dsimp only [w]
        rw [map_add, map_one]
      have hdiam : normLM F hM_CK (1 + w) - 1 =
          IntermediateField.inclusion hLM_C (normLM F hLE (1 + y) - 1) := by
        rw [map_sub, map_one, (hDiamondTrNorm (1 + y)).2, h1w]
      rw [hdiam] at hstab_t
      have hnorm_ge : normLM F hLE (1 + y) - 1 = 0 ∨
          ((a - 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLE (1 + y) - 1) := by
        apply hPullL ((a - 1 : ℕ) : ℤ) (normLM F hLE (1 + y) - 1)
        rcases hstab_t with h0 | hge
        · exact Or.inl h0
        · right
          have hcrit_int : (k : ℤ) * ((a - 1 : ℕ) : ℤ) = (t : ℤ) := by exact_mod_cast hcrit
          have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
          linarith
      have hϖL_inv_val :
          valL F L (((ϖ_L ^ (a - 1))⁻¹ : Lˣ) : L) = - ((a - 1 : ℕ) : ℤ) := by
        rw [hval_unit_inv L, hval_unit_pow L ϖ_L (a - 1), hϖ_valL, mul_one]
      have h := hval_mul_ge L (- ((a - 1 : ℕ) : ℤ)) ((a - 1 : ℕ) : ℤ)
        (((ϖ_L ^ (a - 1))⁻¹ : Lˣ) : L) (normLM F hLE (1 + y) - 1)
        (Or.inr (by rw [hϖL_inv_val])) hnorm_ge
      simpa [s₀] using h

    
    let z_x : M_C := IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)
    have hz_x_int : z_x = 0 ∨ 0 ≤ valL F M_C z_x := by
      have hx₀_MC : IntermediateField.inclusion hLM_C x₀ = 0 ∨
          0 ≤ valL F M_C (IntermediateField.inclusion hLM_C x₀) := by
        rcases hx₀ with rfl | hx₀
        · left; rw [map_zero]
        · right
          rw [hValAlgMCL x₀]
          have hk_nonneg : (0 : ℤ) ≤ (k : ℤ) := by omega
          exact mul_nonneg hk_nonneg hx₀
      have h := hval_mul_ge M_C 0 0 (IntermediateField.inclusion hLM_C x₀) (z_η : M_C)
        hx₀_MC (Or.inr (by rw [hz_η_val]))
      simpa [z_x] using h
    let w₀ : K := IntermediateField.inclusion hM_CK z_x * ((ϖ_K ^ t : Kˣ) : K)
    let d_E : E := (((ϖ_E ^ (a - 1))⁻¹ : Eˣ) : E) * y - IntermediateField.inclusion hLE x₀
    let Δ_w : K := w - w₀
    have hΔ_w_eq :
        Δ_w =
          (IntermediateField.inclusion hEK d_E * η +
            IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C x₀) *
              (η - IntermediateField.inclusion hM_CK (z_η : M_C))) *
            ((ϖ_K ^ t : Kˣ) : K) := by
      have hy_eq : y = ((ϖ_E ^ (a - 1) : Eˣ) : E) * (d_E + IntermediateField.inclusion hLE x₀) := by
        have hmul : ((ϖ_E ^ (a - 1) : Eˣ) : E) * (((ϖ_E ^ (a - 1))⁻¹ : Eˣ) : E) = 1 :=
          Units.mul_inv (ϖ_E ^ (a - 1))
        dsimp only [d_E]
        linear_combination - y * hmul
      have hϖE_K :
          IntermediateField.inclusion hEK ((ϖ_E ^ (a - 1) : Eˣ) : E) =
            η * ((ϖ_K ^ t : Kˣ) : K) := by
        have hunit :
            Units.map (IntermediateField.inclusion hEK).toMonoidHom (ϖ_E ^ (a - 1)) =
              η_u * (ϖ_K ^ t) := by
          dsimp only [η_u]
          rw [inv_mul_cancel_right]
        exact congrArg (fun u : Kˣ => (u : K)) hunit
      have h_comm :
          IntermediateField.inclusion hEK (IntermediateField.inclusion hLE x₀) =
            IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C x₀) := rfl
      dsimp only [Δ_w, w, w₀, z_x]
      rw [hy_eq, map_mul, map_add, hϖE_K, h_comm, map_mul]
      ring
    have hΔ_w_val : Δ_w = 0 ∨ (t + 1 : ℤ) ≤ valL F K Δ_w := by
      have hd_K : IntermediateField.inclusion hEK d_E = 0 ∨
          1 ≤ valL F K (IntermediateField.inclusion hEK d_E) := by
        rcases hPushEK 1 d_E hyx₀ with h0 | hge
        · exact Or.inl h0
        · right
          have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
          linarith
      have hterm1 : IntermediateField.inclusion hEK d_E * η = 0 ∨
          1 ≤ valL F K (IntermediateField.inclusion hEK d_E * η) := by
        have h := hval_mul_ge K 1 0 (IntermediateField.inclusion hEK d_E) η
          hd_K (Or.inr (by rw [hη_val]))
        simpa using h
      have hx₀_K :
          IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C x₀) = 0 ∨
            0 ≤ valL F K (IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C x₀)) := by
        rcases hx₀ with rfl | hx₀
        · left; simp
        · right
          rw [hValAlgK, hValAlgMCL]
          have hq_nonneg : (0 : ℤ) ≤ (q : ℤ) := by omega
          have hk_nonneg : (0 : ℤ) ≤ (k : ℤ) := by omega
          exact mul_nonneg hq_nonneg (mul_nonneg hk_nonneg hx₀)
      have hterm2 :
          IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C x₀) *
            (η - IntermediateField.inclusion hM_CK (z_η : M_C)) = 0 ∨
          1 ≤ valL F K
            (IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C x₀) *
              (η - IntermediateField.inclusion hM_CK (z_η : M_C))) := by
        have h := hval_mul_ge K 0 1
          (IntermediateField.inclusion hM_CK (IntermediateField.inclusion hLM_C x₀))
          (η - IntermediateField.inclusion hM_CK (z_η : M_C))
          hx₀_K hr_η
        simpa using h
      have hsum := hval_add_K 1 _ _ hterm1 hterm2
      have hϖK_t_val : valL F K ((ϖ_K ^ t : Kˣ) : K) = (t : ℤ) := by
        rw [hval_unit_pow K ϖ_K t, hϖ_valK, mul_one]
      rw [hΔ_w_eq]
      have h := hval_mul_ge K 1 (t : ℤ) _ ((ϖ_K ^ t : Kˣ) : K)
        hsum (Or.inr (by rw [hϖK_t_val]))
      simpa [add_comm] using h

    have hw₀_val : w₀ = 0 ∨ (t : ℤ) ≤ valL F K w₀ := by
      have hz_K : IntermediateField.inclusion hM_CK z_x = 0 ∨
          0 ≤ valL F K (IntermediateField.inclusion hM_CK z_x) := by
        rcases hz_x_int with h0 | hge0
        · left; rw [h0, map_zero]
        · right
          rw [hValAlgK z_x]
          have hq_nonneg : (0 : ℤ) ≤ (q : ℤ) := by omega
          exact mul_nonneg hq_nonneg hge0
      have hϖK_t_val : valL F K ((ϖ_K ^ t : Kˣ) : K) = (t : ℤ) := by
        rw [hval_unit_pow K ϖ_K t, hϖ_valK, mul_one]
      have h := hval_mul_ge K 0 (t : ℤ) (IntermediateField.inclusion hM_CK z_x)
        ((ϖ_K ^ t : Kˣ) : K) hz_K (Or.inr (by rw [hϖK_t_val]))
      simpa [w₀] using h
    have hw₀_ge1 : w₀ = 0 ∨ 1 ≤ valL F K w₀ := by
      rcases hw₀_val with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have h1w₀_ne : 1 + w₀ ≠ 0 := by
      intro h0
      have hw₀_eq : w₀ = -1 := by linear_combination h0
      rcases hw₀_ge1 with hw0 | hge1
      · exact one_ne_zero (neg_eq_zero.mp (hw₀_eq.symm.trans hw0))
      · rw [hw₀_eq, hval_neg1_K] at hge1
        omega
    let u_1w₀ : Kˣ := Units.mk0 (1 + w₀) h1w₀_ne
    have hu_1w₀_mem : u_1w₀ ∈ unitGroup F K 1 := by
      rw [hunit_ge1_K 1 le_rfl]
      have hsub : (u_1w₀ : K) - 1 = w₀ := by
        change (1 + w₀) - 1 = w₀
        ring
      rw [hsub]
      rcases hw₀_ge1 with h0 | hge1
      · left; change 1 + w₀ = 1; rw [h0, add_zero]
      · exact Or.inr hge1
    have hu_1w₀_val0 : valL F K (u_1w₀ : K) = 0 :=
      (ld_valL_and_unitGroup_props F K).2.2.2.2.2.2.2.2.2.2 1 u_1w₀ hu_1w₀_mem
    have hu_1w₀_inv_val0 : valL F K ((u_1w₀⁻¹ : Kˣ) : K) = 0 := by
      rw [hval_unit_inv K u_1w₀, hu_1w₀_val0, neg_zero]
    let r_w : K := ((u_1w₀⁻¹ : Kˣ) : K) * Δ_w
    have hr_w_val : r_w = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F K r_w := by
      have h := hval_mul_ge K 0 (t + 1 : ℤ) ((u_1w₀⁻¹ : Kˣ) : K) Δ_w
        (Or.inr (by rw [hu_1w₀_inv_val0])) hΔ_w_val
      simpa [r_w] using h
    have h1w_factor : 1 + w = (1 + w₀) * (1 + r_w) := by
      have hmul : (1 + w₀) * ((u_1w₀⁻¹ : Kˣ) : K) = 1 :=
        Units.mul_inv u_1w₀
      dsimp only [r_w, Δ_w]
      calc 1 + w = (1 + w₀) + 1 * (w - w₀) := by ring
        _ = (1 + w₀) + ((1 + w₀) * ((u_1w₀⁻¹ : Kˣ) : K)) * (w - w₀) := by rw [hmul]
        _ = (1 + w₀) * (1 + ((u_1w₀⁻¹ : Kˣ) : K) * (w - w₀)) := by ring
    have hnorm_1w₀_val0 : valL F M_C (normLM F hM_CK (1 + w₀)) = 0 := by
      rw [hValNormK (1 + w₀)]
      exact hu_1w₀_val0
    have hstab_rw := hStab_KMC (t + 1) (by omega) le_rfl r_w hr_w_val
    have hP_zx := hP_norm z_x hz_x_int
    let α_MC : M_C := normLM F hM_CK (1 + w₀)
    let β_MC : M_C := normLM F hM_CK (1 + r_w)
    let γ_MC : M_C := 1 + P_poly z_x * ((ϖ_MC ^ t : M_Cˣ) : M_C)
    have hnorm_1w_diff :
        normLM F hM_CK (1 + w) - γ_MC =
          α_MC * (β_MC - 1) + (α_MC - γ_MC) := by
      have hmul : normLM F hM_CK (1 + w) = α_MC * β_MC := by
        rw [h1w_factor, map_mul]
      rw [hmul]
      ring
    have hnorm_1w_val :
        normLM F hM_CK (1 + w) - γ_MC = 0 ∨
          (t + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - γ_MC) := by
      have hterm1 : α_MC * (β_MC - 1) = 0 ∨
          (t + 1 : ℤ) ≤ valL F M_C (α_MC * (β_MC - 1)) := by
        have h := hval_mul_ge M_C 0 (t + 1 : ℤ) α_MC (β_MC - 1)
          (Or.inr (by rw [hnorm_1w₀_val0])) (by simpa [β_MC] using hstab_rw)
        simpa using h
      rw [hnorm_1w_diff]
      exact hval_add_MC (t + 1 : ℤ) (α_MC * (β_MC - 1)) (α_MC - γ_MC) hterm1 hP_zx
    have h1w_eq : 1 + w = IntermediateField.inclusion hEK (1 + y) := by
      dsimp only [w]
      rw [map_add, map_one]
    have hinc_s₀ :
        IntermediateField.inclusion hLM_C (((ϖ_L ^ (a - 1) : Lˣ) : L)) *
          IntermediateField.inclusion hLM_C s₀ =
        normLM F hM_CK (1 + w) - 1 := by
      rw [← map_mul, hs₀_mul, map_sub, map_one, (hDiamondTrNorm (1 + y)).2, h1w_eq]
    have hpoly_diff_eq :
        IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C) - P_poly z_x =
          (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * (normLM F hM_CK (1 + w) - γ_MC) := by
      have hu_ϖ_coe :
          (u_ϖ : M_C) =
            IntermediateField.inclusion hLM_C (((ϖ_L ^ (a - 1) : Lˣ) : L)) *
              (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) := rfl
      have hϖMC_inv :
          ((ϖ_MC ^ t : M_Cˣ) : M_C) * (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) = 1 :=
        Units.mul_inv (ϖ_MC ^ t)
      rw [hu_ϖ_coe]
      dsimp only [γ_MC]
      linear_combination
        (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * hinc_s₀ + P_poly z_x * hϖMC_inv
    have hpoly_cong :
        IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C) - P_poly z_x = 0 ∨
          1 ≤ valL F M_C (IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C) - P_poly z_x) := by
      have hϖMC_inv_val :
          valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) = - (t : ℤ) := by
        rw [hval_unit_inv M_C, hval_unit_pow M_C ϖ_MC t, hϖ_valMC, mul_one]
      rw [hpoly_diff_eq]
      have h := hval_mul_ge M_C (- (t : ℤ)) (t + 1 : ℤ)
        ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) (normLM F hM_CK (1 + w) - γ_MC)
        (Or.inr (by rw [hϖMC_inv_val])) hnorm_1w_val
      have hsum : - (t : ℤ) + (t + 1 : ℤ) = 1 := by ring
      rwa [hsum] at h
    exact ⟨s₀, hs₀_int, Or.inl hs₀_exact, hpoly_cong⟩

  · 
    intro hsuper a_E
    let u : ℕ := k * (a - 1)
    have hu_ge : t + 1 ≤ u := by omega
    let m_div : ℕ := (q - 1) / k
    have hm_div_mul : m_div * k = q - 1 := Nat.div_mul_cancel hk_dvd
    have hm_div_ge1 : 1 ≤ m_div := by
      rcases Nat.eq_zero_or_pos m_div with hm0 | hm_pos
      · rw [hm0, zero_mul] at hm_div_mul
        omega
      · exact hm_pos
    have htk_le_ka : t + k + 1 ≤ k * a := by
      have h1 : k * (a - 1) + k = k * a := by
        calc k * (a - 1) + k = k * (a - 1 + 1) := by ring
          _ = k * a := by rw [Nat.sub_add_cancel (by omega)]
      omega
    have hm_ineq : m_div * (t + k) + m_div ≤ (q - 1) * a := by
      calc m_div * (t + k) + m_div
          = m_div * (t + k + 1) := by ring
        _ ≤ m_div * (k * a) := Nat.mul_le_mul_left m_div htk_le_ka
        _ = (m_div * k) * a := by ring
        _ = (q - 1) * a := by rw [hm_div_mul]
    have hqa_split : (q - 1) * a + a = q * a := by
      calc (q - 1) * a + a = (q - 1 + 1) * a := by ring
        _ = q * a := by rw [Nat.sub_add_cancel hq_ge1]
    have hsub_lt : m_div * (t + k) + a + 1 ≤ q * a := by
      calc m_div * (t + k) + a + 1
          ≤ m_div * (t + k) + m_div + a := by omega
        _ ≤ (q - 1) * a + a := Nat.add_le_add_right hm_ineq a
        _ = q * a := hqa_split
    have hsub_le : m_div * (t + k) ≤ q * a := by omega
    have ha_lt_aE : a < a_E := by
      change a < q * a - m_div * (t + k)
      omega
    have haE_ge1 : 1 ≤ a_E := by omega
    have hk_aE_eq :
        (k : ℤ) * ((a_E - 1 : ℕ) : ℤ) =
          ((t + q * (u - t) : ℕ) : ℤ) := by
      have haE_cast : (a_E : ℤ) = (q : ℤ) * (a : ℤ) - (m_div : ℤ) * ((t : ℤ) + (k : ℤ)) := by
        change ((q * a - m_div * (t + k) : ℕ) : ℤ) = _
        rw [Nat.cast_sub hsub_le]
        push_cast
        rfl
      have haE1_cast : ((a_E - 1 : ℕ) : ℤ) = (a_E : ℤ) - 1 := by omega
      have hm_div_int : (m_div : ℤ) * (k : ℤ) = (q : ℤ) - 1 := by
        calc (m_div : ℤ) * (k : ℤ) = ((m_div * k : ℕ) : ℤ) := (Nat.cast_mul m_div k).symm
          _ = ((q - 1 : ℕ) : ℤ) := by rw [hm_div_mul]
          _ = (q : ℤ) - 1 := by omega
      have hu_sub_cast : ((u - t : ℕ) : ℤ) = (k : ℤ) * ((a : ℤ) - 1) - (t : ℤ) := by
        have hut : t ≤ u := by omega
        rw [Nat.cast_sub hut]
        dsimp only [u]
        have ha1_cast : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
        rw [Nat.cast_mul, ha1_cast]
      rw [haE1_cast, haE_cast, Nat.cast_add, Nat.cast_mul, hu_sub_cast]
      linear_combination - ((t : ℤ) + (k : ℤ)) * hm_div_int

    refine ⟨ha_lt_aE, ?_⟩
    intro y hy
    let w : K := IntermediateField.inclusion hEK y
    have hw :
        w = 0 ∨ ((t + q * (u - t) : ℕ) : ℤ) ≤ valL F K w := by
      rcases hPushEK ((a_E - 1 : ℕ) : ℤ) y hy with h0 | hge
      · exact Or.inl h0
      · right
        rwa [← hk_aE_eq]
    obtain ⟨hTr_K, hNorm_K⟩ := hSuper_KMC u hu_ge w hw
    refine ⟨?_, ?_⟩
    · rw [← (hDiamondTrNorm y).1] at hTr_K
      apply hPullL ((a - 1 : ℕ) : ℤ) (traceLM F hLE y)
      rcases hTr_K with h0 | hge
      · exact Or.inl h0
      · right
        have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
        have hu_int : (u : ℤ) = (k : ℤ) * ((a - 1 : ℕ) : ℤ) := by
          dsimp only [u]
          exact Nat.cast_mul k (a - 1)
        linarith
    · have h1w : 1 + w = IntermediateField.inclusion hEK (1 + y) := by
        dsimp only [w]
        rw [map_add, map_one]
      have hdiam :
          normLM F hM_CK (1 + w) - (1 + traceLM F hM_CK w) =
            IntermediateField.inclusion hLM_C
              (normLM F hLE (1 + y) - (1 + traceLM F hLE y)) := by
        rw [map_sub (IntermediateField.inclusion hLM_C),
          map_add (IntermediateField.inclusion hLM_C),
          map_one (IntermediateField.inclusion hLM_C),
          (hDiamondTrNorm (1 + y)).2, (hDiamondTrNorm y).1, h1w]
      rw [hdiam] at hNorm_K
      apply hPullL (a : ℤ) (normLM F hLE (1 + y) - (1 + traceLM F hLE y))
      have hu1_eq : (k : ℤ) * (a : ℤ) - ((k : ℤ) - 1) = (u + 1 : ℤ) := by
        dsimp only [u]
        have ha1_cast : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
        rw [Nat.cast_mul, ha1_cast]
        ring
      rwa [hu1_eq]

theorem ld_ch14_wild_tower_norm_expansions_on_MC_and_E (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hFrobSurjMC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F))))
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
