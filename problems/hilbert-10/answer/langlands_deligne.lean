            (x + y = 0 ∨ k ≤ valL F M₀ (x + y))) ∧
        (∀ u : M₀ˣ, u ∈ unitGroup F M₀ 0 ↔ valL F M₀ (u : M₀) = 0) ∧
        (∀ (a : ℕ), 1 ≤ a → ∀ u : M₀ˣ,
          u ∈ unitGroup F M₀ a ↔ ((u : M₀) = 1 ∨ (a : ℤ) ≤ valL F M₀ ((u : M₀) - 1))) ∧
        (∀ (a : ℕ) (u : M₀ˣ), u ∈ unitGroup F M₀ a → valL F M₀ (u : M₀) = 0)) →
      (traceLM F hM₀K₁ π = 0 ∨ (r : ℤ) ≤ valL F M₀ (traceLM F hM₀K₁ π)) →
      let δ : M₀ˣ := Units.map (normLM F hM₀K₁) (ϖ_K₁ ^ t₂)
      let T : M₀ := traceLM F hM₀K₁ π
      let Nπ : M₀ := normLM F hM₀K₁ π
      let q : M₀ := traceLM F hM₀K₁ (π ^ t₂) * ((δ⁻¹ : M₀ˣ) : M₀)
      valL F M₀ (δ : M₀) = (t₂ : ℤ) ∧
      (q = 0 ∨ 0 ≤ valL F M₀ q) ∧
      ∀ (lam : k_L),
