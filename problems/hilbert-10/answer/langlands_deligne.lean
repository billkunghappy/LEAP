          ⟨fun x => ρ ⟨x * r x, h_xr_mem x⟩ (φ (u x)), fun h₀ x => by
            dsimp only
            rw [hu_mul h₀ x]
            have h_sub : (⟨((h₀ : G) * x) * r ((h₀ : G) * x), h_xr_mem ((h₀ : G) * x)⟩ : H) =
