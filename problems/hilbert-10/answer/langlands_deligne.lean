  have h4c₀_sq_b : 4 * c₀ ^ 2 = 0 ∨ 2 * (e : ℤ) + 1 - (a : ℤ) ≤ valL F L (4 * c₀ ^ 2) :=
    (hL_mul_b _ _ (4 : L) (c₀ ^ 2) h4_b hc₀_sq_b).imp id (fun h => by omega)
  have hδ_val : δ_tr = 0 ∨ 2 * (e : ℤ) + 1 - (a : ℤ) ≤ valL F L δ_tr :=
    hadd (2 * (e : ℤ) + 1 - (a : ℤ)) (4 * c₀) (4 * c₀ ^ 2) h4c₀_b h4c₀_sq_b
