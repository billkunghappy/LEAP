    have hi_val_lt : ((i : ℕ) : ℤ) < (p : ℤ) := by exact_mod_cast i.isLt
    by_cases hci : c i = 0
    · left; simp [t_term, hci]
    · right
      have hge0 : 0 ≤ (p : ℤ) * valL F L (c i) + ((i : ℕ) : ℤ) :=
        (hc_all i).resolve_left hci
      rw [hp_cast] at hge0 hi_val_lt
      have hval_ci_nonneg : 0 ≤ valL F L (c i) := by omega
      have hci_E'_ne : IntermediateField.inclusion hLE' (c i) ≠ 0 :=
        fun h => hci (hinj_E' (by rw [h, map_zero]))
      have hval_term : valL F E' (t_term i) = 2 * valL F L (c i) + ((i : ℕ) : ℤ) := by
        dsimp [t_term]
        rw [hval_mul_E' _ _ hci_E'_ne (hϖ_E'_pow_ne_zero (i : ℕ)),
