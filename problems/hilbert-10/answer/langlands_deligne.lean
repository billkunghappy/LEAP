      · left
        exact (map_eq_zero (IntermediateField.inclusion hM_CK)).mp h0
      · right
        rw [hValAlgK (act_MC h z - z)] at hge
        have hq_ge1 : (1 : ℤ) ≤ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) := by omega
        nlinarith
    · intro hMC w hw
      obtain ⟨z, hz0, hw_z⟩ := hResLiftK w hw
      set d : K := w - IntermediateField.inclusion hM_CK z
      have hMC_z := hMC z hz0
      have hδz_P1 : P 1 (δ h.1 (IntermediateField.inclusion hM_CK z)) := by
        rw [← hδ_compat z]
        rcases hMC_z with h0 | hge
        · left; rw [h0, map_zero]
        · right
          rw [hValAlgK (act_MC h z - z)]
          have hq_ge1 : (1 : ℤ) ≤ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) := by omega
          nlinarith
      have hδw_eq : δ h.1 w = δ h.1 (IntermediateField.inclusion hM_CK z) + act h.1 d - d := by
        have hw_eq : w = IntermediateField.inclusion hM_CK z + d := by dsimp [d]; ring
        conv_lhs => rw [hw_eq]
        dsimp [δ]
        rw [((hact_ring h.1).2.2 _ _).1]
        ring
      change P 1 (δ h.1 w)
      rw [hδw_eq]
      exact hP_sub 1 (hP_add 1 hδz_P1 ((hP_act 1 h.1 d).mpr hw_z)) hw_z
  have hJumpK_C : ∀ c ∈ C, c ≠ 1 → ∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
