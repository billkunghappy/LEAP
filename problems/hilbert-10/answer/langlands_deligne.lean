          rw [hmul_inv, sub_self, mul_zero, sub_zero]
  have hu_prod_one : (1 + u_M) * (1 + u_m) = 1 := by
    have h1 : 1 + u_m = normLM F hM₁'K₁ (1 + y_m) := by
      change 1 + (normLM F hM₁'K₁ (1 + y_m) - 1) = normLM F hM₁'K₁ (1 + y_m)
      ring
    rw [h1_add_uM, h1, ← map_mul, hy_prod_one, map_one]
  have h8uM_id :
      (8 : M₁') * u_M =
        (3 : M₁') * (2 * u_M - u_M ^ 2) +
          (-(1 + u_M) ^ 2) * (2 * u_m - u_m ^ 2) := by
    calc (8 : M₁') * u_M
      _ = (3 : M₁') * (2 * u_M - u_M ^ 2) +
            (-(1 + u_M) ^ 2) * (2 * u_m - u_m ^ 2) -
            (-3 * u_M + u_m * (u_M + 1) - 2) * ((1 + u_M) * (1 + u_m) - 1) := by ring
