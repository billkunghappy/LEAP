  have hx₀_m₀ : x₀ - (m₀ : K₁) = 0 ∨ B₀ ≤ valL F K₁ (x₀ - (m₀ : K₁)) := by
    have hsub := val_sub_K₁ (hτ_u_approx m₀ hm₀_lt hm₀_pos) hm₀_B₀
    have heq : ((τ_u m₀ : K₁) - (m₀ : K₁)) - (-x₀ + (τ_u m₀ : K₁)) = x₀ - (m₀ : K₁) := by ring
    rwa [heq] at hsub
  obtain ⟨q_m₀, hqm₀⟩ := hcoprime_inv_mod_p m₀ hm₀_pos hm₀_lt
  let k : ℕ := (m₀ ^ (p - 2)) % p
  have hkm₀_zmod : ((k * m₀ : ℕ) : ZMod p) = 1 := by
    calc ((k * m₀ : ℕ) : ZMod p)
        = ((m₀ ^ (p - 2) % p : ℕ) : ZMod p) * (m₀ : ZMod p) := by push_cast; rfl
      _ = ((m₀ ^ (p - 2) : ℕ) : ZMod p) * (m₀ : ZMod p) := by rw [ZMod.natCast_mod]
      _ = ((m₀ * m₀ ^ (p - 2) : ℕ) : ZMod p) := by push_cast; ring
