    intro a ha_lt ha_pos ζ hpow
    refine ⟨fun hza => ?_, fun hz1 => by rw [hz1, one_pow]⟩
    by_contra hne
    obtain ⟨hprim, _⟩ := h_prim_of_order ζ hpow hne
