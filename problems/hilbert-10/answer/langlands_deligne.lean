        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)))
    (hΔ_conj_val : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -((bM₁' - 1 : ℕ) : ℤ))
    (hW_conj_sum : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
