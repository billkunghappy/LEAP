            (((α⁻¹ : Lˣ) : L) * δ_tr * u) := by
        rw [hL_inv_mul α (Units.map (normLM F hLE') (Units.mk0 tE' htE')),
          hL_inv_mul α (Units.mk0 (1 - ρ) hβ₂), Units.coe_map,
          Units.val_mk0 htE', Units.val_mk0 hβ₂, ht_norm]
        dsimp [β₂]
        ring
      have hrem_b : ((α⁻¹ : Lˣ) : L) * δ_tr * u = 0 ∨
          -condExpChar F L ψ ≤ valL F L (((α⁻¹ : Lˣ) : L) * δ_tr * u) := by
        have hα_inv_b : ((α⁻¹ : Lˣ) : L) = 0 ∨
            -(2 * (e : ℤ) + 1 + condExpChar F L ψ) ≤ valL F L ((α⁻¹ : Lˣ) : L) := by
          right; rw [hinv α, hα_val, hT2_eq]; push_cast; omega
        have h1 := hL_mul_b _ _ _ _ hα_inv_b hδ_val
        have hu_b : u = 0 ∨ (e : ℤ) + 1 ≤ valL F L u := by
          rwa [hT2_half, Nat.cast_add, Nat.cast_one] at hu
        exact (hL_mul_b _ _ _ _ h1 hu_b).imp id (fun h => by omega)
      rw [hinv_eq, AddChar.map_add_eq_mul, hSpecL _ hrem_b, mul_one]
      exact hstat
  have hcνM₁'_pkg : ∀ (tM₁' : M₁'), normLM F hLM₁' tM₁' = β₁ + δ_tr →
      tM₁' ≠ 0 ∧
      valL F M₁' tM₁' = 2 * ((e : ℤ) - (a : ℤ)) + 1 ∧
      ∀ htM₁' : tM₁' ≠ 0,
        let cνM₁' : Lˣ := α * (Units.map (normLM F hLM₁') (Units.mk0 tM₁' htM₁'))⁻¹
        valL F L (cνM₁' : L) = (condExp F L νM₁' : ℤ) + condExpChar F L ψ ∧
        ∀ u : L, (u = 0 ∨ (((condExp F L νM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
          ∀ hu : 1 + u ≠ 0,
            (νM₁' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνM₁'⁻¹ : Lˣ) : L) * u) := by
    intro tM₁' ht_norm
    have htM₁'_ne : tM₁' ≠ 0 := by
      intro h0
