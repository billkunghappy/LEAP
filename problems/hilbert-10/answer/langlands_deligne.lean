    have hdE_le_WE : (d_E : ℤ) - ((p * h : ℕ) : ℤ) ≤ W_E := by
      apply le_min
      · set X : ℕ := (p - 1) * (T - 1)
        have hVE_X : V_E + ((p * h : ℕ) : ℤ) = (X : ℤ) := by
          dsimp only [V_E, X]
          push_cast
          ring
        have h1 : 0 ≤ (p : ℤ) * ((T : ℤ) - 1 - (h : ℤ)) := mul_nonneg (by omega) (by omega)
        have h2 : 0 ≤ ((p : ℤ) - 3) * ((T : ℤ) - 1) := mul_nonneg (by omega) (by omega)
        have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
        have hT1 : ((T - 1 : ℕ) : ℤ) = (T : ℤ) - 1 := by omega
        have hph : ((p * h : ℕ) : ℤ) = (p : ℤ) * (h : ℤ) := Nat.cast_mul p h
        have hX_eq : (X : ℤ) = ((p : ℤ) - 1) * ((T : ℤ) - 1) := by
          dsimp only [X]
          rw [Nat.cast_mul, hp1, hT1]
        have h_2dE : (T : ℤ) + ((p * h : ℕ) : ℤ) ≤ 2 * (X : ℤ) + 1 := by
          rw [hph, hX_eq]
          linarith [h1, h2]
        omega
      · omega
    have hneg := val_neg_ge hZE_BE_val
    rw [← hBE_sub_ZE] at hneg
    have hmul := val_mul_ge hneg hZE_inv_val
    refine val_mono ?_ hmul
    omega
  have hConj3 : (h < T - 1 ∨ 3 < p) →
      traceLM F hLE' (((Z_E : E') - B_E) ^ 2 * ((Z_E⁻¹ : E'ˣ) : E')) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLE' (((Z_E : E') - B_E) ^ 2 * ((Z_E⁻¹ : E'ˣ) : E'))) := by
    intro h_cond
    have h2WE : (T : ℤ) ≤ (W_E + W_E) + ((p * h : ℕ) : ℤ) := by
      rcases le_total V_E (T : ℤ) with hVT | hTV
      · have hW : W_E = V_E := min_eq_left hVT
        rw [hW]
        have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
        have hT1 : ((T - 1 : ℕ) : ℤ) = (T : ℤ) - 1 := by omega
        have hph : ((p * h : ℕ) : ℤ) = (p : ℤ) * (h : ℤ) := Nat.cast_mul p h
        have hp3_int : (3 : ℤ) ≤ (p : ℤ) := by omega
        have hT2_int : (2 : ℤ) ≤ (T : ℤ) := by omega
        dsimp only [V_E]
        rw [hp1, hT1, hph]
        rcases h_cond with hh_lt1 | hp_gt3
        · have h1 : 0 ≤ (p : ℤ) * ((T : ℤ) - 2 - (h : ℤ)) := mul_nonneg (by omega) (by omega)
          have h2 : 0 ≤ ((p : ℤ) - 3) * ((T : ℤ) - 2) := mul_nonneg (by omega) (by omega)
          linarith [h1, h2, hp3_int, hT2_int]
        · have hp4_int : (4 : ℤ) ≤ (p : ℤ) := by omega
          have h1 : 0 ≤ (p : ℤ) * ((T : ℤ) - 1 - (h : ℤ)) := mul_nonneg (by omega) (by omega)
          have h2 : 0 ≤ ((p : ℤ) - 4) * ((T : ℤ) - 2) := mul_nonneg (by omega) (by omega)
          linarith [h1, h2, hp4_int, hT2_int]
      · have hW : W_E = (T : ℤ) := min_eq_right hTV
        rw [hW]
        omega
    have hsq : ((Z_E : E') - B_E) ^ 2 = 0 ∨
        W_E + W_E ≤ valL F E' (((Z_E : E') - B_E) ^ 2) := by
      rw [sq]
      exact val_mul_ge hZE_BE_val hZE_BE_val
    have hprod := val_mul_ge hsq hZE_inv_val
    have hprod_bound : ((Z_E : E') - B_E) ^ 2 * ((Z_E⁻¹ : E'ˣ) : E') = 0 ∨
        (p : ℤ) * (T : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤
          valL F E' (((Z_E : E') - B_E) ^ 2 * ((Z_E⁻¹ : E'ˣ) : E')) := by
      refine val_mono ?_ hprod
      have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
      have h_id : (p : ℤ) * (T : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) = (T : ℤ) := by
        rw [hp1]
        ring
      rw [h_id]
      exact h2WE
    exact htr_bound_LE' (T : ℤ) _ hprod_bound
  exact ⟨hConj1, hConj2, hConj3, hConj4⟩

theorem ld_ch12_wild_odd_unramified_nonstable_zu_ze_trace_diff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (T h : ℕ) (hT_ge2 : 2 ≤ T) (hh_lt : h < T)
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (T : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (s : E' → ℕ → L)
    (hs1 : ∀ y : E', s y 1 = traceLM F hLE' y)
    (hs_val : ∀ (y : E') (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F E' y) →
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (T : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_newton2 : ∀ y : E',
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLE' (y ^ p) - (p : L) * normLM F hLE' y =
        - (p : L) * (∑ r ∈ Finset.Icc 1 ((p - 1) / 2), s y r * s y (p - r)) +
          ∑ r ∈ Finset.Icc 1 (p - 1),
            ∑ j ∈ Finset.Icc 1 (p - r - 1),
              (-1 : L) ^ (r + j) * s y r * s y j * traceLM F hLE' (y ^ (p - r - j)))
    (c : L) (d : M₁') (x : E') (Z_U : M₁'ˣ) (Z_E : E'ˣ)
    (hd_tr_low : ∀ j ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 2),
      traceLM F hLM₁' (d ^ j) = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ j)))
    (hd_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)))
    (hd_tr_pow :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLM₁' (d ^ p) - (p : L) * c = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ p) - (p : L) * c))
    (hx_zero : h = 0 → (x = 0 ∨ 0 ≤ valL F E' x))
    (hx_pos : 0 < h → x ≠ 0 ∧ valL F E' x = -(h : ℤ) ∧ valL F L (normLM F hLE' x) = -(h : ℤ))
    (hZU_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (Z_U : M₁') =
        d ^ p + (∑ i ∈ Finset.Icc 1 (p - 1),
          IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i)) +
          IntermediateField.inclusion hLM₁' (normLM F hLE' x))
    (hZE_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (Z_E : E') - (x ^ p - x + IntermediateField.inclusion hLE' c) = 0 ∨
        (T : ℤ) ≤ valL F E' ((Z_E : E') - (x ^ p - x + IntermediateField.inclusion hLE' c))) :
    let S := traceLM F hLM₁' (Z_U : M₁') - traceLM F hLE' (Z_E : E')
    ((h < T - 1 ∨ 3 < Module.finrank L (IntermediateField.extendScalars hLE')) →
      S = 0 ∨ (T : ℤ) ≤ valL F L S) ∧
    (Module.finrank L (IntermediateField.extendScalars hLE') = 3 →
      S - (3 * s x 1 - (s x 1) ^ 3 + 3 * s x 1 * s x 2) = 0 ∨
        (T : ℤ) ≤ valL F L (S - (3 * s x 1 - (s x 1) ^ 3 + 3 * s x 1 * s x 2))) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set A := normLM F hLE' x
  set S := traceLM F hLM₁' (Z_U : M₁') - traceLM F hLE' (Z_E : E')
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub (by omega : 1 ≤ p)
  have hval_props : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K],
      valL F K 0 = 0 ∧
      valL F K 1 = 0 ∧
      valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) := by
    intro K _
    have halg : ∀ z : K,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F K = (minpoly F z).natDegree * m := by
      clear htr_bound_LE' hs1 hs_val hs_newton2 hd_tr_low hd_tr_top hd_tr_pow hx_zero hx_pos hZU_eq hZE_eq A S
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq K.val K.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F K 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F K 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : K, x ≠ 0 → y ≠ 0 → relVal F K (x * y) = relVal F K x + relVal F K y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F K (-1) = 0 := by
      have hne : (-1 : K) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F K ((-1 : K) * (-1 : K)) = relVal F K (-1) + relVal F K (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : K) * (-1 : K) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : K, relVal F K (-x) = relVal F K x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : K) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : K) = (-1 : K) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Kˣ, relVal F K ((u⁻¹ : Kˣ) : K) = - relVal F K (u : K) := by
      intro u
      have hmul : relVal F K ((u : K) * ((u⁻¹ : Kˣ) : K)) =
          relVal F K (u : K) + relVal F K ((u⁻¹ : Kˣ) : K) :=
        hrel_mul (u : K) ((u⁻¹ : Kˣ) : K) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Kˣ) (n : ℕ),
        relVal F K (((u ^ n : Kˣ) : K)) = (n : ℤ) * relVal F K (u : K) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Kˣ) (m : ℤ),
        relVal F K (((u ^ m : Kˣ) : K)) = m * relVal F K (u : K) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F K (((u ^ (n : ℤ) : Kˣ) : K)) = (n : ℤ) * relVal F K (u : K)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : K := algebraMap F K π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F K x₀ = (Module.finrank F K : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F K) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F K := Module.finrank_pos
    let S_set : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : K, x ≠ 0 ∧ relVal F K x = k}
    have hS_nonempty : S_set.Nonempty := ⟨Module.finrank F K, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfK_mem : resDeg F K ∈ S_set := Nat.sInf_mem hS_nonempty
    obtain ⟨hfK_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfK_mem
    let ϖK : Kˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖK : relVal F K (ϖK : K) = (resDeg F K : ℤ) := hrel_ϖ₀
    have hfK_int_pos : (0 : ℤ) < (resDeg F K : ℤ) := Nat.cast_pos.mpr hfK_pos
    have hfK_int_ne : (resDeg F K : ℤ) ≠ 0 := ne_of_gt hfK_int_pos
    have hdiv : ∀ x : K, relVal F K x = (resDeg F K : ℤ) * valL F K x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F K : ℤ)
        set q : ℤ := valL F K x
        set r : ℤ := relVal F K x % f
        have hediv : f * q + r = relVal F K x := Int.mul_ediv_add_emod (relVal F K x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F K x) hfK_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F K x) hfK_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : K := x * (((ϖK ^ (-q) : Kˣ) : K))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F K y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖK (-q), hrel_ϖK]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
