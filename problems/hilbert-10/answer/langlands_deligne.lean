        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' d * y)
      let z₃ : K₁ := IntermediateField.inclusion hM₁'K₁ x +
        IntermediateField.inclusion hE'K₁ y +
        2 * IntermediateField.inclusion hM₁'K₁ x * IntermediateField.inclusion hE'K₁ y
      let h₁ : M₁' := 2 * x - IntermediateField.inclusion hLM₁' d
      let h₂ : E' := 2 * IntermediateField.inclusion hLE' d * y - 1
      let β₁ : L := d ^ 2 + 2 * d - 4 * f
      let β₂ : L := 1 + 2 * d - 4 * d ^ 2 * g
