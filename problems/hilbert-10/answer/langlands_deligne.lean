      ((tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ q₀) ^ q₀ := by
    have h_congr :
        (∏ j ∈ Finset.range q₀,
          (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ
              ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L (ν₁ ^ j * χL_ext)))) ^ q₀) =
        ∏ _j ∈ Finset.range q₀,
          (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ
              ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ q₀ :=
      Finset.prod_congr rfl (fun j _ =>
        (hTwistInvL (ν₁ ^ j) (hν₁j_restMC j) (hν₁j_pow j)).2.2.2)
    rw [h_congr, Finset.prod_const, Finset.card_range]
  rw [hLHS_const, hRHS_const, ← pow_mul, ← pow_mul, ← sq] at hPow_eq
  exact hPow_eq

theorem ld_ch14_wild_tame_inertia_metacyclic_and_orbit_disjoint (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hp_prime : Nat.Prime (p F))
    (hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hq_pow : ∃ r_exp : ℕ,
      1 ≤ r_exp ∧ Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (t_jump k : ℕ) (ht_ge1 : 1 ≤ t_jump) (hk_ge1 : 1 ≤ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hJumpK : ∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
      ∀ σ ∈ M_C.fixingSubgroup, σ ∉ K.fixingSubgroup →
        ∀ hσw : (σ : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K,
          (ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) ≠ 0 ∧
          valL F K ((ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K)) =
            (t_jump + 1 : ℤ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
        valL F (D_orb.get i).field x)
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (hG_mul : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (h_mem_C : ∀ w : relWeil F L, w ∈ (relWeil F M_C).subgroupOf (relWeil F L) ↔ π w ∈ C)
    (h_field_C : (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F = M_C) :
    ∃ (H₀ : Subgroup H) (_ : H₀.Normal),
      IsCyclic H₀ ∧
      IsCyclic (H ⧸ H₀) ∧
      ∀ t ∈ D_orb,
        ∀ h ∈ H₀,
          (∀ x : IntermediateField.extendScalars hLK,
            (x : AlgebraicClosure F) ∈ t.field → h.1 x = x) →
          h = 1 :=
by
  
  have h_quot_cyclic : ∀ (hval1_M : valL F M_C 1 = 0)
      (hval_neg_M : ∀ z : M_C, valL F M_C (-z) = valL F M_C z)
      (hval_mul_M : ∀ z₁ z₂ : M_C, z₁ ≠ 0 → z₂ ≠ 0 →
        valL F M_C (z₁ * z₂) = valL F M_C z₁ + valL F M_C z₂)
      (hval_add_M : ∀ (k : ℤ) (z₁ z₂ : M_C),
        (z₁ = 0 ∨ k ≤ valL F M_C z₁) → (z₂ = 0 ∨ k ≤ valL F M_C z₂) →
          (z₁ + z₂ = 0 ∨ k ≤ valL F M_C (z₁ + z₂)))
      (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M_C → k_M)
      (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
      (hresM_ring : ∀ z₁ z₂ : M_C,
        (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
          resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
          resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
          resM (-z₁) = -resM z₁)
      (hresM_ker : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
        (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M_C z)))
      (hresM_surj : ∀ a : k_M, ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧ resM z = a)
      (act_MC : H → M_C → M_C)
      (hact_MC_one : ∀ z : M_C, act_MC 1 z = z)
      (hact_MC_mul : ∀ (h₁ h₂ : H) (z : M_C), act_MC (h₁ * h₂) z = act_MC h₁ (act_MC h₂ z))
      (hact_MC_ring : ∀ h : H,
        act_MC h 0 = 0 ∧ act_MC h 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act_MC h (z₁ + z₂) = act_MC h z₁ + act_MC h z₂ ∧
          act_MC h (z₁ * z₂) = act_MC h z₁ * act_MC h z₂ ∧
          act_MC h (-z₁) = -act_MC h z₁))
      (hact_MC_val : ∀ (h : H) (z : M_C), valL F M_C (act_MC h z) = valL F M_C z)
      (H₀ : Subgroup H) [H₀.Normal]
      (hH₀_MC_iff : ∀ h : H,
        h ∈ H₀ ↔ ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
          (act_MC h z - z = 0 ∨ 1 ≤ valL F M_C (act_MC h z - z))),
      IsCyclic (H ⧸ H₀) := by
    intro hval1_M hval_neg_M hval_mul_M hval_add_M
      k_M _ _ resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
      act_MC hact_MC_one hact_MC_mul hact_MC_ring hact_MC_val H₀ _ hH₀_MC_iff
    let PM (k : ℤ) (z : M_C) : Prop := z = 0 ∨ k ≤ valL F M_C z
    have hPM_zero : ∀ k : ℤ, PM k 0 := fun _ => Or.inl rfl
    have hPM_one : PM 0 1 := Or.inr (by rw [hval1_M])
    have hPM_neg : ∀ {k : ℤ} {z : M_C}, PM k z → PM k (-z) := by
      intro k z hz
      rcases hz with rfl | hz
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_M]; exact hz)
    have hPM_add : ∀ {k : ℤ} {z₁ z₂ : M_C}, PM k z₁ → PM k z₂ → PM k (z₁ + z₂) :=
      fun hz₁ hz₂ => hval_add_M _ _ _ hz₁ hz₂
    have hPM_sub : ∀ {k : ℤ} {z₁ z₂ : M_C}, PM k z₁ → PM k z₂ → PM k (z₁ - z₂) := by
      intro k z₁ z₂ hz₁ hz₂
      rw [sub_eq_add_neg]
      exact hPM_add hz₁ (hPM_neg hz₂)
    have hPM_mul : ∀ {k₁ k₂ : ℤ} {z₁ z₂ : M_C},
        PM k₁ z₁ → PM k₂ z₂ → PM (k₁ + k₂) (z₁ * z₂) := by
      intro k₁ k₂ z₁ z₂ hz₁ hz₂
      by_cases hz₁0 : z₁ = 0
      · left; rw [hz₁0, zero_mul]
      · by_cases hz₂0 : z₂ = 0
        · left; rw [hz₂0, mul_zero]
        · right
          rw [hval_mul_M z₁ z₂ hz₁0 hz₂0]
          have h1 := hz₁.resolve_left hz₁0
          have h2 := hz₂.resolve_left hz₂0
          omega
    have hPM_act : ∀ (k : ℤ) (h : H) (z : M_C), PM k z → PM k (act_MC h z) := by
      intro k h z hz
      rcases hz with rfl | hz
      · left; exact (hact_MC_ring h).1
      · right
        rw [hact_MC_val h z]
        exact hz
    have hresM_sub : ∀ z₁ z₂ : M_C, PM 0 z₁ → PM 0 z₂ →
        resM (z₁ - z₂) = resM z₁ - resM z₂ := by
      intro z₁ z₂ hz₁ hz₂
      rw [sub_eq_add_neg, (hresM_ring z₁ (-z₂) hz₁ (hPM_neg hz₂)).1,
        (hresM_ring z₂ 0 hz₂ (hPM_zero 0)).2.2, ← sub_eq_add_neg]
    have hresM_eq_iff : ∀ z₁ z₂ : M_C, PM 0 z₁ → PM 0 z₂ →
        (resM z₁ = resM z₂ ↔ PM 1 (z₁ - z₂)) := by
      intro z₁ z₂ hz₁ hz₂
      rw [← sub_eq_zero, ← hresM_sub z₁ z₂ hz₁ hz₂]
      exact hresM_ker (z₁ - z₂) (hPM_sub hz₁ hz₂)
    let lift_M : k_M → M_C := fun a => (hresM_surj a).choose
    have hlift_P0 : ∀ a : k_M, PM 0 (lift_M a) := fun a => (hresM_surj a).choose_spec.1
    have hlift_res : ∀ a : k_M, resM (lift_M a) = a := fun a => (hresM_surj a).choose_spec.2
    let bar_fun : H → k_M → k_M := fun h a => resM (act_MC h (lift_M a))
    have hbar_spec : ∀ (h : H) (z : M_C), PM 0 z →
        bar_fun h (resM z) = resM (act_MC h z) := by
      intro h z hz
      dsimp [bar_fun]
      set w : M_C := lift_M (resM z)
      have hw0 : PM 0 w := hlift_P0 (resM z)
      have hw_res : resM w = resM z := hlift_res (resM z)
      have hwz_P1 : PM 1 (w - z) := (hresM_eq_iff w z hw0 hz).mp hw_res
      have hact_sub : act_MC h w - act_MC h z = act_MC h (w - z) := by
        rw [sub_eq_add_neg w z, ((hact_MC_ring h).2.2 w (-z)).1,
          ((hact_MC_ring h).2.2 z 0).2.2, ← sub_eq_add_neg]
      have hact_P1 : PM 1 (act_MC h w - act_MC h z) := by
        rw [hact_sub]
        exact hPM_act 1 h (w - z) hwz_P1
      exact (hresM_eq_iff (act_MC h w) (act_MC h z)
        (hPM_act 0 h w hw0) (hPM_act 0 h z hz)).mpr hact_P1
    have hbar_one : ∀ a : k_M, bar_fun 1 a = a := by
      intro a
      rw [← hlift_res a, hbar_spec 1 (lift_M a) (hlift_P0 a), hact_MC_one, hlift_res]
    have hbar_mul : ∀ (h₁ h₂ : H) (a : k_M),
        bar_fun (h₁ * h₂) a = bar_fun h₁ (bar_fun h₂ a) := by
      intro h₁ h₂ a
      rw [← hlift_res a, hbar_spec (h₁ * h₂) (lift_M a) (hlift_P0 a),
        hact_MC_mul, hbar_spec h₂ (lift_M a) (hlift_P0 a),
        hbar_spec h₁ (act_MC h₂ (lift_M a)) (hPM_act 0 h₂ (lift_M a) (hlift_P0 a))]
    have hbar_zero : ∀ h : H, bar_fun h 0 = 0 := by
      intro h
      rw [← hresM_0, hbar_spec h 0 (hPM_zero 0), (hact_MC_ring h).1, hresM_0]
    have hbar_one_val : ∀ h : H, bar_fun h 1 = 1 := by
      intro h
      rw [← hresM_1, hbar_spec h 1 hPM_one, (hact_MC_ring h).2.1, hresM_1]
    have hbar_add : ∀ (h : H) (a b : k_M), bar_fun h (a + b) = bar_fun h a + bar_fun h b := by
      intro h a b
      set z₁ : M_C := lift_M a
      set z₂ : M_C := lift_M b
      have hz₁ : PM 0 z₁ := hlift_P0 a
      have hz₂ : PM 0 z₂ := hlift_P0 b
      have hab : a + b = resM (z₁ + z₂) := by
        rw [(hresM_ring z₁ z₂ hz₁ hz₂).1, hlift_res a, hlift_res b]
      rw [hab, hbar_spec h (z₁ + z₂) (hPM_add hz₁ hz₂),
        ((hact_MC_ring h).2.2 z₁ z₂).1,
        (hresM_ring (act_MC h z₁) (act_MC h z₂) (hPM_act 0 h z₁ hz₁) (hPM_act 0 h z₂ hz₂)).1]
    have hbar_mul_val : ∀ (h : H) (a b : k_M), bar_fun h (a * b) = bar_fun h a * bar_fun h b := by
      intro h a b
      set z₁ : M_C := lift_M a
      set z₂ : M_C := lift_M b
      have hz₁ : PM 0 z₁ := hlift_P0 a
      have hz₂ : PM 0 z₂ := hlift_P0 b
      have hmul : PM 0 (z₁ * z₂) := by simpa using hPM_mul hz₁ hz₂
      have hab : a * b = resM (z₁ * z₂) := by
        rw [(hresM_ring z₁ z₂ hz₁ hz₂).2.1, hlift_res a, hlift_res b]
      rw [hab, hbar_spec h (z₁ * z₂) hmul,
        ((hact_MC_ring h).2.2 z₁ z₂).2.1,
        (hresM_ring (act_MC h z₁) (act_MC h z₂) (hPM_act 0 h z₁ hz₁) (hPM_act 0 h z₂ hz₂)).2.1]
    let φ_ring : H → (k_M →+* k_M) := fun h =>
      { toFun := bar_fun h
        map_one' := hbar_one_val h
        map_mul' := hbar_mul_val h
        map_zero' := hbar_zero h
        map_add' := hbar_add h }
    have hbar_commutes : ∀ (h : H) (r : ↥(⊥ : Subfield k_M)),
        bar_fun h (algebraMap ↥(⊥ : Subfield k_M) k_M r) =
          algebraMap ↥(⊥ : Subfield k_M) k_M r := by
      intro h r
      have hle : (⊥ : Subfield k_M) ≤ (φ_ring h).eqLocusField (RingHom.id k_M) := bot_le
      have hr : r.1 ∈ (φ_ring h).eqLocusField (RingHom.id k_M) := hle r.2
      exact RingHom.mem_eqLocusField.mp hr
    let Φ_res : H →* (k_M ≃ₐ[↥(⊥ : Subfield k_M)] k_M) :=
      { toFun := fun h =>
          { toFun := bar_fun h
            invFun := bar_fun h⁻¹
            left_inv := fun a => by rw [← hbar_mul, inv_mul_cancel, hbar_one]
            right_inv := fun a => by rw [← hbar_mul, mul_inv_cancel, hbar_one]
            map_mul' := hbar_mul_val h
            map_add' := hbar_add h
            commutes' := hbar_commutes h }
        map_one' := AlgEquiv.ext hbar_one
        map_mul' := fun h₁ h₂ => AlgEquiv.ext (hbar_mul h₁ h₂) }
    have hker_iff : ∀ h : H, h ∈ H₀ ↔ h ∈ Φ_res.ker := by
      intro h
      rw [MonoidHom.mem_ker, hH₀_MC_iff h]
      constructor
      · intro hh
        apply AlgEquiv.ext
        intro a
        dsimp [Φ_res, bar_fun]
        exact ((hresM_eq_iff (act_MC h (lift_M a)) (lift_M a)
          (hPM_act 0 h (lift_M a) (hlift_P0 a)) (hlift_P0 a)).mpr
          (hh (lift_M a) (hlift_P0 a))).trans (hlift_res a)
      · intro hΦ z hz
        have ha : bar_fun h (resM z) = resM z :=
          AlgEquiv.congr_fun hΦ (resM z)
        rw [hbar_spec h z hz] at ha
        exact (hresM_eq_iff (act_MC h z) z (hPM_act 0 h z hz) hz).mp ha
    have hle_ker : H₀ ≤ Φ_res.ker := fun h hh => (hker_iff h).mp hh
    let ψ_quot : H ⧸ H₀ →* (k_M ≃ₐ[↥(⊥ : Subfield k_M)] k_M) :=
      QuotientGroup.lift H₀ Φ_res hle_ker
    have hψ_inj : Function.Injective ψ_quot := by
      intro q₁ q₂ hq
      refine Quotient.inductionOn₂' q₁ q₂ (fun h₁ h₂ h_eq => ?_) hq
      change Φ_res h₁ = Φ_res h₂ at h_eq
      have h_ker : h₁⁻¹ * h₂ ∈ Φ_res.ker := by
        rw [MonoidHom.mem_ker, map_mul, map_inv, h_eq, inv_mul_cancel]
      exact (QuotientGroup.eq).mpr ((hker_iff (h₁⁻¹ * h₂)).mpr h_ker)
    exact isCyclic_of_injective ψ_quot hψ_inj

  
  have h_tame_char_cyclic_and_disj :
      ∀ (hval0_K : valL F K 0 = 0)
        (hval1_K : valL F K 1 = 0)
        (hval_neg_K : ∀ w : K, valL F K (-w) = valL F K w)
        (hval_mul_K : ∀ w₁ w₂ : K, w₁ ≠ 0 → w₂ ≠ 0 →
          valL F K (w₁ * w₂) = valL F K w₁ + valL F K w₂)
        (hval_inv_K : ∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K))
        (hval_surj_K : ∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m)
        (hval_add_K : ∀ (k : ℤ) (w₁ w₂ : K),
          (w₁ = 0 ∨ k ≤ valL F K w₁) → (w₂ = 0 ∨ k ≤ valL F K w₂) →
            (w₁ + w₂ = 0 ∨ k ≤ valL F K (w₁ + w₂)))
        (halg1_K : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
          (algebraMap F K a = 0 ∨ 1 ≤ valL F K (algebraMap F K a)))
        (k_K : Type u) [Field k_K] [Fintype k_K] (resK : K → k_K)
        (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
        (hresK_ring : ∀ w₁ w₂ : K,
          (w₁ = 0 ∨ 0 ≤ valL F K w₁) → (w₂ = 0 ∨ 0 ≤ valL F K w₂) →
            resK (w₁ + w₂) = resK w₁ + resK w₂ ∧
            resK (w₁ * w₂) = resK w₁ * resK w₂ ∧
            resK (-w₁) = -resK w₁)
        (hresK_ker : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
          (resK w = 0 ↔ (w = 0 ∨ 1 ≤ valL F K w)))
        (hUnifFi : ∀ i : Fin D_orb.length, ∃ ϖ_i : ((D_orb.get i).field)ˣ,
          valL F (D_orb.get i).field (ϖ_i : (D_orb.get i).field) = 1)
        (G₀ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
        [G₀.Normal]
        (act : (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) → K → K)
        (hact_one : ∀ w : K, act 1 w = w)
        (hact_mul : ∀ (g₁ g₂ : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)
          (w : K), act (g₁ * g₂) w = act g₁ (act g₂ w))
        (hact_ring : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
          act g 0 = 0 ∧ act g 1 = 1 ∧
          (∀ w₁ w₂ : K,
            act g (w₁ + w₂) = act g w₁ + act g w₂ ∧
            act g (w₁ * w₂) = act g w₁ * act g w₂ ∧
            act g (-w₁) = -act g w₁))
        (hact_val : ∀ (g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)
          (w : K), valL F K (act g w) = valL F K w)
        (hC_mem_iff : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
          g ∈ C ↔ ∀ z : M_C,
            act g (IntermediateField.inclusion hM_CK z) =
              IntermediateField.inclusion hM_CK z)
        (hG₀_iff : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
          g ∈ G₀ ↔ ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
            (act g w - w = 0 ∨ 1 ≤ valL F K (act g w - w)))
        (hJumpK_C : ∀ c ∈ C, c ≠ 1 → ∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
          (ϖ_K : K) - act c (ϖ_K : K) ≠ 0 ∧
          valL F K ((ϖ_K : K) - act c (ϖ_K : K)) = (t_jump + 1 : ℤ))
        (H₀ : Subgroup H)
        (hH₀_iff : ∀ h : H, h ∈ H₀ ↔ h.1 ∈ G₀),
        IsCyclic H₀ ∧
        ∀ (i : Fin D_orb.length) (h : H),
          h ∈ H₀ →
          (∀ x : (D_orb.get i).field,
            act h.1 (IntermediateField.inclusion hM_CK (IntermediateField.inclusion (hFiMC i) x)) =
              IntermediateField.inclusion hM_CK (IntermediateField.inclusion (hFiMC i) x)) →
          h = 1 := by
    intro hval0_K hval1_K hval_neg_K hval_mul_K hval_inv_K hval_surj_K hval_add_K halg1_K
      k_K _ _ resK hresK_0 hresK_1 hresK_ring hresK_ker hUnifFi
      G₀ _ act hact_one hact_mul hact_ring hact_val hC_mem_iff hG₀_iff hJumpK_C H₀ hH₀_iff
    let G := (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)
    let φ_act : G → (K →+* K) := fun g =>
      { toFun := act g
        map_one' := (hact_ring g).2.1
        map_mul' := fun x y => ((hact_ring g).2.2 x y).2.1
        map_zero' := (hact_ring g).1
        map_add' := fun x y => ((hact_ring g).2.2 x y).1 }
    have hφ_apply : ∀ (g : G) (w : K), φ_act g w = act g w := fun _ _ => rfl
    have hact_sub : ∀ (g : G) (w₁ w₂ : K), act g (w₁ - w₂) = act g w₁ - act g w₂ := by
      intro g w₁ w₂
      rw [sub_eq_add_neg, ((hact_ring g).2.2 w₁ (-w₂)).1, ((hact_ring g).2.2 w₂ w₂).2.2,
        ← sub_eq_add_neg]
    let P : ℤ → K → Prop := fun k w => w = 0 ∨ k ≤ valL F K w
    let δ : G → K → K := fun g w => act g w - w
    have hP_zero : ∀ k : ℤ, P k 0 := fun _ => Or.inl rfl
    have hP_one : P 0 1 := Or.inr (by rw [hval1_K])
    have hP_neg : ∀ (k : ℤ) {w : K}, P k w → P k (-w) := by
      intro k w hw
      rcases hw with rfl | hw
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_K]; exact hw)
    have hP_add : ∀ (k : ℤ) {w₁ w₂ : K}, P k w₁ → P k w₂ → P k (w₁ + w₂) :=
      fun k {w₁ w₂} hw₁ hw₂ => hval_add_K k w₁ w₂ hw₁ hw₂
    have hP_sub : ∀ (k : ℤ) {w₁ w₂ : K}, P k w₁ → P k w₂ → P k (w₁ - w₂) := by
      intro k w₁ w₂ hw₁ hw₂
      rw [sub_eq_add_neg]
      exact hP_add k hw₁ (hP_neg k hw₂)
    have hP_mul : ∀ {k₁ k₂ : ℤ} {w₁ w₂ : K}, P k₁ w₁ → P k₂ w₂ → P (k₁ + k₂) (w₁ * w₂) := by
      intro k₁ k₂ w₁ w₂ hw₁ hw₂
      by_cases hw₁0 : w₁ = 0
      · left; rw [hw₁0, zero_mul]
      · by_cases hw₂0 : w₂ = 0
        · left; rw [hw₂0, mul_zero]
        · right
          rw [hval_mul_K w₁ w₂ hw₁0 hw₂0]
          have h1 := hw₁.resolve_left hw₁0
          have h2 := hw₂.resolve_left hw₂0
          omega
    have hP_mono : ∀ {k₁ k₂ : ℤ} {w : K}, k₁ ≤ k₂ → P k₂ w → P k₁ w := by
      intro k₁ k₂ w hle hw
      rcases hw with rfl | hw
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hw)
    have hP_pow : ∀ (n : ℕ) {w : K}, P 0 w → P 0 (w ^ n) := by
      intro n w hw
      induction n with
      | zero =>
        rw [pow_zero]
        exact hP_one
      | succ n ih =>
        rw [pow_succ]
        simpa using hP_mul ih hw
    have hP_act : ∀ (k : ℤ) (g : G) (w : K), P k (act g w) ↔ P k w := by
      intro k g w
      dsimp [P]
      rw [← hφ_apply g w, map_eq_zero (φ_act g), hφ_apply g w, hact_val g w]
    obtain ⟨ϖ₀, hϖ₀⟩ := hval_surj_K 1
    set π_K : K := (ϖ₀ : K)
    set π_inv : K := ((ϖ₀⁻¹ : Kˣ) : K)
    have hπ_ne0 : π_K ≠ 0 := Units.ne_zero ϖ₀
    have hπ_inv_ne0 : π_inv ≠ 0 := Units.ne_zero ϖ₀⁻¹
    have hπ_mul : π_K * π_inv = 1 := by exact_mod_cast Units.mul_inv ϖ₀
    have hπ_inv_mul : π_inv * π_K = 1 := by exact_mod_cast Units.inv_mul ϖ₀
    have hP0_π : P 0 π_K := Or.inr (by omega)
    have hP1_π : P 1 π_K := Or.inr (by omega)
    have hπ_inv_val : valL F K π_inv = -1 := by
      dsimp [π_inv]
      rw [hval_inv_K ϖ₀, hϖ₀]
    have hP_π_inv : P (-1) π_inv := Or.inr (by omega)
    have hval_pi_pow : ∀ m : ℕ,
        (π_K ^ m ≠ 0 ∧ valL F K (π_K ^ m) = (m : ℤ)) ∧
        (π_inv ^ m ≠ 0 ∧ valL F K (π_inv ^ m) = -(m : ℤ)) := by
      intro m
      induction m with
      | zero =>
        simp [hval1_K]
      | succ m ih =>
        refine ⟨⟨pow_ne_zero (m + 1) hπ_ne0, ?_⟩, ⟨pow_ne_zero (m + 1) hπ_inv_ne0, ?_⟩⟩
        · rw [pow_succ, hval_mul_K (π_K ^ m) π_K ih.1.1 hπ_ne0, ih.1.2, hϖ₀]
          push_cast; ring
        · rw [pow_succ, hval_mul_K (π_inv ^ m) π_inv ih.2.1 hπ_inv_ne0, ih.2.2, hπ_inv_val]
          push_cast; ring
    have hP_pi_pow : ∀ m : ℕ, P (m : ℤ) (π_K ^ m) :=
      fun m => Or.inr (le_of_eq (hval_pi_pow m).1.2.symm)
    have hP_pi_inv_pow : ∀ m : ℕ, P (-(m : ℤ)) (π_inv ^ m) :=
      fun m => Or.inr (le_of_eq (hval_pi_pow m).2.2.symm)
    have hpi_pow_mul_inv : ∀ m : ℕ, (π_K ^ m) * (π_inv ^ m) = 1 := by
      intro m
      rw [← mul_pow, hπ_mul, one_pow]
    have hpi_inv_pow_mul : ∀ m : ℕ, (π_inv ^ m) * (π_K ^ m) = 1 := by
      intro m
      rw [← mul_pow, hπ_inv_mul, one_pow]
    have hδc_π : ∀ c ∈ C, P (t_jump + 1 : ℤ) (δ c π_K) := by
      intro c hc
      by_cases hc1 : c = 1
      · rw [hc1]
        dsimp [δ]
        rw [hact_one π_K, sub_self]
        exact hP_zero _
      · obtain ⟨_, h_val⟩ := hJumpK_C c hc hc1 ϖ₀ hϖ₀
        right
        have hneg : δ c π_K = -(π_K - act c π_K) := by dsimp [δ]; ring
        rw [hneg, hval_neg_K, h_val]
    have hC_le_Gm : ∀ m : ℕ, m ≤ t_jump → ∀ c ∈ C, ∀ w : K, P 0 w → P (m + 1 : ℤ) (δ c w) := by
      intro m
      induction m with
      | zero =>
        intro _ c hc w hw
        obtain ⟨z, _, hw_z⟩ := hResLiftK w hw
        set d : K := w - IntermediateField.inclusion hM_CK z
        have hcz : act c (IntermediateField.inclusion hM_CK z) =
            IntermediateField.inclusion hM_CK z := (hC_mem_iff c).mp hc z
        have hδw : δ c w = act c d - d := by
          have hw_eq : w = IntermediateField.inclusion hM_CK z + d := by dsimp [d]; ring
          conv_lhs => rw [hw_eq]
          dsimp [δ]
          rw [((hact_ring c).2.2 _ _).1, hcz]
          ring
        rw [hδw]
        simpa using hP_sub 1 ((hP_act 1 c d).mpr hw_z) hw_z
      | succ m ih =>
        intro hm_le c hc w hw
        obtain ⟨z, _, hw_z⟩ := hResLiftK w hw
        set d : K := w - IntermediateField.inclusion hM_CK z
        set y : K := π_inv * d
        have hy0 : P 0 y := by
          have h1 := hP_mul hP_π_inv hw_z
          simpa using h1
        have hd_eq : d = π_K * y := by
          dsimp [y]
          rw [← mul_assoc, hπ_mul, one_mul]
        have hcz : act c (IntermediateField.inclusion hM_CK z) =
            IntermediateField.inclusion hM_CK z := (hC_mem_iff c).mp hc z
        have hδw : δ c w = δ c π_K * act c y + π_K * δ c y := by
          have hw_eq : w = IntermediateField.inclusion hM_CK z + π_K * y := by
            rw [← hd_eq]; dsimp [d]; ring
          conv_lhs => rw [hw_eq]
          dsimp [δ]
          rw [((hact_ring c).2.2 _ _).1, ((hact_ring c).2.2 π_K y).2.1, hcz]
          ring
        have hδπ_m : P ((m : ℤ) + 2) (δ c π_K) :=
          hP_mono (by omega) (hδc_π c hc)
        have ht1 : P (((m : ℤ) + 2) + 0) (δ c π_K * act c y) :=
          hP_mul hδπ_m ((hP_act 0 c y).mpr hy0)
        have ht2 : P (1 + (m + 1 : ℤ)) (π_K * δ c y) :=
          hP_mul hP1_π (ih (by omega) c hc y hy0)
        rw [hδw]
        exact hP_add ((m + 1 : ℕ) + 1 : ℤ)
          (by simpa [show ((m : ℤ) + 2) + 0 = ((m + 1 : ℕ) + 1 : ℤ) by push_cast; ring] using ht1)
          (by simpa [show (1 : ℤ) + (m + 1 : ℤ) = ((m + 1 : ℕ) + 1 : ℤ) by push_cast; ring] using ht2)
    have hC_le_Gt : ∀ c ∈ C, ∀ w : K, P 0 w → P (t_jump + 1 : ℤ) (δ c w) :=
      hC_le_Gm t_jump le_rfl
    let u : G → K := fun g => act g π_K * π_inv
    let u_inv : G → K := fun g => act g π_inv * π_K
    let η : G → K := fun g => δ g π_K * (π_inv ^ (t_jump + 1))
    have hu_one : u 1 = 1 := by
      dsimp [u]
      rw [hact_one π_K, hπ_mul]
    have hu_P0 : ∀ g : G, P 0 (u g) := by
      intro g
      have h1 : P 1 (act g π_K) := (hP_act 1 g π_K).mpr hP1_π
      simpa using hP_mul h1 hP_π_inv
    have hu_inv_P0 : ∀ g : G, P 0 (u_inv g) := by
      intro g
      have h1 : P (-1) (act g π_inv) := (hP_act (-1) g π_inv).mpr hP_π_inv
      simpa using hP_mul h1 hP1_π
    have hu_mul_pi : ∀ g : G, u g * π_K = act g π_K := by
      intro g
      dsimp [u]
      rw [mul_assoc, hπ_inv_mul, mul_one]
    have hu_inv_mul_u : ∀ g : G, u_inv g * u g = 1 := by
      intro g
      dsimp [u_inv, u]
      calc (act g π_inv * π_K) * (act g π_K * π_inv)
          = (act g π_inv * act g π_K) * (π_K * π_inv) := by ring
        _ = act g (π_inv * π_K) * 1 := by
            rw [← ((hact_ring g).2.2 π_inv π_K).2.1, hπ_mul]
        _ = 1 := by rw [hπ_inv_mul, (hact_ring g).2.1, mul_one]
    have hu_hom_mod1 : ∀ {σ τ : G}, σ ∈ G₀ →
        P 1 (u (σ * τ) - u σ * u τ) := by
      intro σ τ hσ
      have h_id : u (σ * τ) - u σ * u τ = δ σ (u τ) * u σ := by
        have h1 : act (σ * τ) π_K = act σ (u τ) * (u σ * π_K) := by
          rw [hact_mul σ τ π_K, ← hu_mul_pi τ, ((hact_ring σ).2.2 (u τ) π_K).2.1, hu_mul_pi σ]
        dsimp [u, δ]
        rw [h1]
        calc act σ (u τ) * (u σ * π_K) * π_inv - act σ π_K * π_inv * (u τ)
            = act σ (u τ) * u σ * (π_K * π_inv) - u σ * u τ := by dsimp [u]; ring
          _ = (act σ (u τ) - u τ) * u σ := by rw [hπ_mul]; ring
      rw [h_id]
      simpa using hP_mul (((hG₀_iff σ).mp hσ) (u τ) (hu_P0 τ)) (hu_P0 σ)
    have h_act_shift : ∀ {γ : G}, γ ∈ G₀ → ∀ (m : ℕ) {z : K},
        P (m : ℤ) z → P (m + 1 : ℤ) (act γ z - (u γ) ^ m * z) := by
      intro γ hγ m z hz
      set y : K := (π_inv ^ m) * z
      have hy0 : P 0 y := by
        have h1 := hP_mul (hP_pi_inv_pow m) hz
        simpa using h1
      have hz_eq : z = (π_K ^ m) * y := by
        dsimp [y]
        rw [← mul_assoc, hpi_pow_mul_inv m, one_mul]
      have hact_pi_m : act γ (π_K ^ m) = (u γ) ^ m * (π_K ^ m) := by
        rw [← hφ_apply γ, map_pow (φ_act γ), hφ_apply γ π_K, ← hu_mul_pi γ, mul_pow]
      have h_id : act γ z - (u γ) ^ m * z = (u γ) ^ m * (π_K ^ m) * δ γ y := by
        conv_lhs => rw [hz_eq]
        dsimp [δ]
        rw [((hact_ring γ).2.2 (π_K ^ m) y).2.1, hact_pi_m]
        ring
      have ht1 : P (0 + (m : ℤ)) ((u γ) ^ m * (π_K ^ m)) :=
        hP_mul (hP_pow m (hu_P0 γ)) (hP_pi_pow m)
      have ht2 : P ((m : ℤ) + 1) ((u γ) ^ m * (π_K ^ m) * δ γ y) :=
        hP_mul (by simpa using ht1) (((hG₀_iff γ).mp hγ) y hy0)
      rwa [h_id]
    have hη_one : η 1 = 0 := by
      dsimp [η, δ]
      rw [hact_one π_K, sub_self, zero_mul]
    have hη_P0 : ∀ {c : G}, c ∈ C → P 0 (η c) := by
      intro c hc
      have h1 := hP_mul (hC_le_Gt c hc π_K hP0_π) (hP_pi_inv_pow (t_jump + 1))
      have hk_eq : (t_jump + 1 : ℤ) + (-((t_jump + 1 : ℕ) : ℤ)) = 0 := by push_cast; ring
      rwa [hk_eq] at h1
    have hη_P1_iff : ∀ {c : G}, c ∈ C → (P 1 (η c) ↔ c = 1) := by
      intro c hc
      refine ⟨?_, fun hc1 => by rw [hc1, hη_one]; exact hP_zero 1⟩
      intro hη1
      by_contra hc_ne1
      have hδ_P : P (1 + ((t_jump + 1 : ℕ) : ℤ)) (η c * (π_K ^ (t_jump + 1))) :=
        hP_mul hη1 (hP_pi_pow (t_jump + 1))
      have hη_mul_pi : η c * (π_K ^ (t_jump + 1)) = δ c π_K := by
        dsimp [η]
        rw [mul_assoc, hpi_inv_pow_mul (t_jump + 1), mul_one]
      rw [hη_mul_pi] at hδ_P
      obtain ⟨h_ne0, h_val⟩ := hJumpK_C c hc hc_ne1 ϖ₀ hϖ₀
      have hδ_ne0 : δ c π_K ≠ 0 := by
        intro h0
        apply h_ne0
        dsimp [δ] at h0
        linear_combination -h0
      have hδ_val : valL F K (δ c π_K) = (t_jump + 1 : ℤ) := by
        have hneg : δ c π_K = -(π_K - act c π_K) := by dsimp [δ]; ring
        rw [hneg, hval_neg_K, h_val]
      have hge : (1 + ((t_jump + 1 : ℕ) : ℤ)) ≤ valL F K (δ c π_K) := hδ_P.resolve_left hδ_ne0
      omega
    have hη_mul : ∀ {c₁ c₂ : G}, c₁ ∈ C → c₂ ∈ C →
        P 1 (η (c₁ * c₂) - (η c₁ + η c₂)) := by
      intro c₁ c₂ hc₁ hc₂
      set y : K := π_inv * δ c₂ π_K
      have hy_t : P (t_jump : ℤ) y := by
        have h1 := hP_mul hP_π_inv (hC_le_Gt c₂ hc₂ π_K hP0_π)
        simpa using h1
      have hy_1 : P 1 y := hP_mono (by omega) hy_t
      have hy_0 : P 0 y := hP_mono (by omega) hy_t
      have hδc₂_eq : δ c₂ π_K = π_K * y := by
        dsimp [y]
        rw [← mul_assoc, hπ_mul, one_mul]
      have hδ_diff : δ (c₁ * c₂) π_K - (δ c₁ π_K + δ c₂ π_K) =
          δ c₁ π_K * act c₁ y + π_K * δ c₁ y := by
        have h1 : δ (c₁ * c₂) π_K - (δ c₁ π_K + δ c₂ π_K) = δ c₁ (δ c₂ π_K) := by
          dsimp [δ]
          rw [hact_mul c₁ c₂ π_K, hact_sub c₁ (act c₂ π_K) π_K]
          ring
        rw [h1, hδc₂_eq]
        dsimp [δ]
        rw [((hact_ring c₁).2.2 π_K y).2.1]
        ring
      have ht1 : P ((t_jump + 1 : ℤ) + 1) (δ c₁ π_K * act c₁ y) :=
        hP_mul (hC_le_Gt c₁ hc₁ π_K hP0_π) ((hP_act 1 c₁ y).mpr hy_1)
      have ht2 : P (1 + (t_jump + 1 : ℤ)) (π_K * δ c₁ y) :=
        hP_mul hP1_π (hC_le_Gt c₁ hc₁ y hy_0)
      have hδ_P : P (t_jump + 2 : ℤ) (δ (c₁ * c₂) π_K - (δ c₁ π_K + δ c₂ π_K)) := by
        rw [hδ_diff]
        exact hP_add (t_jump + 2 : ℤ)
          (by simpa [show (t_jump + 1 : ℤ) + 1 = (t_jump + 2 : ℤ) by ring] using ht1)
          (by simpa [show (1 : ℤ) + (t_jump + 1 : ℤ) = (t_jump + 2 : ℤ) by ring] using ht2)
      have hmul : P ((t_jump + 2 : ℤ) + (-((t_jump + 1 : ℕ) : ℤ)))
          ((δ (c₁ * c₂) π_K - (δ c₁ π_K + δ c₂ π_K)) * (π_inv ^ (t_jump + 1))) :=
        hP_mul hδ_P (hP_pi_inv_pow (t_jump + 1))
      have heq_η : (δ (c₁ * c₂) π_K - (δ c₁ π_K + δ c₂ π_K)) * (π_inv ^ (t_jump + 1)) =
          η (c₁ * c₂) - (η c₁ + η c₂) := by
        dsimp [η]
        ring
      have hk_eq : (t_jump + 2 : ℤ) + (-((t_jump + 1 : ℕ) : ℤ)) = 1 := by push_cast; ring
      rwa [heq_η, hk_eq] at hmul
    have hη_mul_inv : ∀ {c₁ c₂ : G}, c₁ ∈ C → c₂ ∈ C →
        P 1 (η (c₁ * c₂⁻¹) - (η c₁ - η c₂)) := by
      intro c₁ c₂ hc₁ hc₂
      have h1 := hη_mul (C.mul_mem hc₁ (C.inv_mem hc₂)) hc₂
      rw [inv_mul_cancel_right] at h1
      have hneg := hP_neg 1 h1
      have heq : -(η c₁ - (η (c₁ * c₂⁻¹) + η c₂)) = η (c₁ * c₂⁻¹) - (η c₁ - η c₂) := by ring
      rwa [heq] at hneg
    have hSerre : ∀ {σ c : G}, σ ∈ G₀ → c ∈ C →
        P 1 (η (σ * c * σ⁻¹ * c⁻¹) - ((u σ) ^ t_jump - 1) * η c) := by
      intro σ c hσ hc
      set c' : G := σ * c * σ⁻¹
      have hc' : c' ∈ C := ‹C.Normal›.conj_mem c hc σ
      set W : K := act c' (act σ π_K) - act σ π_K
      have hW_eq : W = act σ (δ c π_K) := by
        dsimp [W, δ, c']
        rw [hact_sub σ (act c π_K) π_K, ← hact_mul (σ * c * σ⁻¹) σ π_K,
          ← hact_mul σ c π_K, inv_mul_cancel_right]
      have hW1 : P (((t_jump + 1 : ℕ) : ℤ) + 1) (W - (u σ) ^ (t_jump + 1) * δ c π_K) := by
        rw [hW_eq]
        exact h_act_shift hσ (t_jump + 1)
          (by simpa [Nat.cast_add, Nat.cast_one] using hC_le_Gt c hc π_K hP0_π)
      have hW2_id : W - u σ * δ c' π_K = δ c' (u σ) * act c' π_K := by
        dsimp [W, δ]
        rw [← hu_mul_pi σ, ((hact_ring c').2.2 (u σ) π_K).2.1]
        ring
      have hW2 : P ((t_jump + 1 : ℤ) + 1) (W - u σ * δ c' π_K) := by
        rw [hW2_id]
        exact hP_mul (hC_le_Gt c' hc' (u σ) (hu_P0 σ)) ((hP_act 1 c' π_K).mpr hP1_π)
      have hdiff_W : P ((t_jump + 1 : ℤ) + 1) (u σ * δ c' π_K - (u σ) ^ (t_jump + 1) * δ c π_K) := by
        have h1 : P ((t_jump + 1 : ℤ) + 1) ((W - (u σ) ^ (t_jump + 1) * δ c π_K) - (W - u σ * δ c' π_K)) :=
          hP_sub ((t_jump + 1 : ℤ) + 1) (by simpa [Nat.cast_add, Nat.cast_one] using hW1) hW2
        have heq : (W - (u σ) ^ (t_jump + 1) * δ c π_K) - (W - u σ * δ c' π_K) =
            u σ * δ c' π_K - (u σ) ^ (t_jump + 1) * δ c π_K := by ring
        rwa [heq] at h1
      have hscale : P (0 + (-((t_jump + 1 : ℕ) : ℤ))) (u_inv σ * (π_inv ^ (t_jump + 1))) :=
        hP_mul (hu_inv_P0 σ) (hP_pi_inv_pow (t_jump + 1))
      have hconj_P : P ((0 + (-((t_jump + 1 : ℕ) : ℤ))) + ((t_jump + 1 : ℤ) + 1))
          ((u_inv σ * (π_inv ^ (t_jump + 1))) * (u σ * δ c' π_K - (u σ) ^ (t_jump + 1) * δ c π_K)) :=
        hP_mul hscale hdiff_W
      have hconj_eq : (u_inv σ * (π_inv ^ (t_jump + 1))) * (u σ * δ c' π_K - (u σ) ^ (t_jump + 1) * δ c π_K) =
          η c' - (u σ) ^ t_jump * η c := by
        dsimp [η]
        rw [pow_succ' (u σ) t_jump]
        calc (u_inv σ * (π_inv ^ (t_jump + 1))) * (u σ * δ c' π_K - (u σ * (u σ) ^ t_jump) * δ c π_K)
            = (u_inv σ * u σ) * (δ c' π_K * (π_inv ^ (t_jump + 1)) - (u σ) ^ t_jump * (δ c π_K * (π_inv ^ (t_jump + 1)))) := by ring
          _ = η c' - (u σ) ^ t_jump * η c := by rw [hu_inv_mul_u σ, one_mul]
      have hconj_P1 : P 1 (η c' - (u σ) ^ t_jump * η c) := by
        have hk_eq : (0 + (-((t_jump + 1 : ℕ) : ℤ))) + ((t_jump + 1 : ℤ) + 1) = 1 := by push_cast; ring
        rwa [hconj_eq, hk_eq] at hconj_P
      have hcomm_sub : P 1 (η (c' * c⁻¹) - (η c' - η c)) := hη_mul_inv hc' hc
      have hsum : P 1 ((η (c' * c⁻¹) - (η c' - η c)) + (η c' - (u σ) ^ t_jump * η c)) :=
        hP_add 1 hcomm_sub hconj_P1
      have heq_final : (η (c' * c⁻¹) - (η c' - η c)) + (η c' - (u σ) ^ t_jump * η c) =
          η (σ * c * σ⁻¹ * c⁻¹) - ((u σ) ^ t_jump - 1) * η c := by
        dsimp [c']
        ring
      rwa [heq_final] at hsum
    have h_cent_C : ∀ {σ : G}, σ ∈ G₀ → P 1 ((u σ) ^ t_jump - 1) → σ ∈ C := by
      intro σ hσ hu_t
      have hcomm_all : ∀ c ∈ C, σ * c = c * σ := by
        intro c hc
        have h1 := hSerre hσ hc
        have h2 : P (1 + 0) (((u σ) ^ t_jump - 1) * η c) := hP_mul hu_t (hη_P0 hc)
        have h3 : P 1 (η (σ * c * σ⁻¹ * c⁻¹)) := by
          have hadd := hP_add 1 h1 (by simpa using h2)
          rwa [sub_add_cancel] at hadd
        have hcomm1 : σ * c * σ⁻¹ * c⁻¹ = 1 :=
          (hη_P1_iff (C.mul_mem (‹C.Normal›.conj_mem c hc σ) (C.inv_mem hc))).mp h3
        have h4 : σ * c * σ⁻¹ = c := eq_of_mul_inv_eq_one hcomm1
        calc σ * c = (σ * c * σ⁻¹) * σ := by group
          _ = c * σ := by rw [h4]
      obtain ⟨h, hhH, c₁, hc₁C, rfl⟩ := hG_mul σ
      have hh_comm : ∀ c ∈ C, h * c = c * h := by
        intro c hc
        have hhc : (h * c₁) * c = c * (h * c₁) := hcomm_all c hc
        have hc₁c : c₁ * c = c * c₁ := hC_ab c₁ hc₁C c hc
        have h_mul : (h * c) * c₁ = (c * h) * c₁ := by
          calc (h * c) * c₁ = h * (c * c₁) := by group
            _ = h * (c₁ * c) := by rw [← hc₁c]
            _ = (h * c₁) * c := by group
            _ = c * (h * c₁) := hhc
            _ = (c * h) * c₁ := by group
        exact mul_right_cancel h_mul
      have hh1 : h = 1 := hZ_H h hhH hh_comm
      rw [hh1, one_mul]
      exact hc₁C
    have hH_inf_C_bot : ∀ {g : G}, g ∈ H → g ∈ C → g = 1 := by
      intro g hgH hgC
      exact hZ_H g hgH (fun c hc => hC_ab g hgC c hc)
    have hpow_one_mod1 : ∀ (w : K) (m : ℕ), P 0 w → P 1 (w - 1) → P 1 (w ^ m - 1) := by
      intro w m hw0 hw1
      induction m with
      | zero =>
        rw [pow_zero, sub_self]
        exact hP_zero 1
      | succ m ih =>
        have h_id : w ^ (m + 1) - 1 = w * (w ^ m - 1) + (w - 1) := by
          rw [pow_succ']
          ring
        have ht1 : P (0 + 1) (w * (w ^ m - 1)) := hP_mul hw0 ih
        rw [h_id]
        exact hP_add 1 (by simpa using ht1) hw1
    have hu_I_inj : ∀ h₁ h₂ : H₀, P 1 (u h₁.1.1 - u h₂.1.1) → h₁ = h₂ := by
      intro h₁ h₂ hdiff
      set γ : G := h₂.1.1⁻¹ * h₁.1.1
      have hγ_G₀ : γ ∈ G₀ :=
        G₀.mul_mem (G₀.inv_mem ((hH₀_iff h₂.1).mp h₂.2)) ((hH₀_iff h₁.1).mp h₁.2)
      have hγ_H : γ ∈ H := H.mul_mem (H.inv_mem h₂.1.2) h₁.1.2
      have hmul_pi : P (1 + 1) ((u h₁.1.1 - u h₂.1.1) * π_K) := hP_mul hdiff hP1_π
      have h_act_diff : (u h₁.1.1 - u h₂.1.1) * π_K = act h₁.1.1 π_K - act h₂.1.1 π_K := by
        rw [sub_mul, hu_mul_pi, hu_mul_pi]
      rw [h_act_diff] at hmul_pi
      have hmap : P 2 (act h₂.1.1⁻¹ (act h₁.1.1 π_K - act h₂.1.1 π_K)) :=
        (hP_act 2 h₂.1.1⁻¹ _).mpr hmul_pi
      have h_δ : act h₂.1.1⁻¹ (act h₁.1.1 π_K - act h₂.1.1 π_K) = δ γ π_K := by
        dsimp [δ, γ]
        rw [hact_sub h₂.1.1⁻¹ (act h₁.1.1 π_K) (act h₂.1.1 π_K),
          ← hact_mul, ← hact_mul, inv_mul_cancel, hact_one]
      rw [h_δ] at hmap
      have huγ_mod1 : P 1 (u γ - 1) := by
        have h1 : P (2 + (-1)) (δ γ π_K * π_inv) := hP_mul hmap hP_π_inv
        have heq : δ γ π_K * π_inv = u γ - 1 := by
          dsimp [u, δ]
          rw [sub_mul, hπ_mul]
        rwa [heq] at h1
      have huγ_t : P 1 ((u γ) ^ t_jump - 1) := hpow_one_mod1 (u γ) t_jump (hu_P0 γ) huγ_mod1
      have hγ_C : γ ∈ C := h_cent_C hγ_G₀ huγ_t
      have hγ_eq1 : γ = 1 := hH_inf_C_bot hγ_H hγ_C
      apply Subtype.ext
      apply Subtype.ext
      exact (inv_mul_eq_one.mp hγ_eq1).symm
    have hresK_sub : ∀ w₁ w₂ : K, P 0 w₁ → P 0 w₂ →
        resK (w₁ - w₂) = resK w₁ - resK w₂ := by
      intro w₁ w₂ hw₁ hw₂
      rw [sub_eq_add_neg, (hresK_ring w₁ (-w₂) hw₁ (hP_neg 0 hw₂)).1,
        (hresK_ring w₂ 0 hw₂ (hP_zero 0)).2.2, ← sub_eq_add_neg]
    have hresK_eq_iff : ∀ w₁ w₂ : K, P 0 w₁ → P 0 w₂ →
        (resK w₁ = resK w₂ ↔ P 1 (w₁ - w₂)) := by
      intro w₁ w₂ hw₁ hw₂
      rw [← sub_eq_zero, ← hresK_sub w₁ w₂ hw₁ hw₂]
      exact hresK_ker (w₁ - w₂) (hP_sub 0 hw₁ hw₂)
    let u_unit : G → k_Kˣ := fun g =>
      { val := resK (u g)
        inv := resK (u_inv g)
        val_inv := by
          rw [← (hresK_ring (u g) (u_inv g) (hu_P0 g) (hu_inv_P0 g)).2.1,
            mul_comm (u g) (u_inv g), hu_inv_mul_u g, hresK_1]
        inv_val := by
          rw [← (hresK_ring (u_inv g) (u g) (hu_inv_P0 g) (hu_P0 g)).2.1,
            hu_inv_mul_u g, hresK_1] }
    let χ_K : H₀ →* k_Kˣ :=
      { toFun := fun h => u_unit h.1.1
        map_one' := Units.ext (by change resK (u 1) = 1; rw [hu_one, hresK_1])
        map_mul' := fun h₁ h₂ => Units.ext (by
          change resK (u (h₁.1.1 * h₂.1.1)) = resK (u h₁.1.1) * resK (u h₂.1.1)
          have hh₁_G₀ : h₁.1.1 ∈ G₀ := (hH₀_iff h₁.1).mp h₁.2
          have hprod_0 : P 0 (u h₁.1.1 * u h₂.1.1) :=
            by simpa using hP_mul (hu_P0 h₁.1.1) (hu_P0 h₂.1.1)
          rw [← (hresK_ring (u h₁.1.1) (u h₂.1.1) (hu_P0 h₁.1.1) (hu_P0 h₂.1.1)).2.1]
          exact (hresK_eq_iff (u (h₁.1.1 * h₂.1.1)) (u h₁.1.1 * u h₂.1.1)
            (hu_P0 (h₁.1.1 * h₂.1.1)) hprod_0).mpr (hu_hom_mod1 hh₁_G₀)) }
    have hχ_K_inj : Function.Injective χ_K := by
      intro h₁ h₂ h_eq
      have hres_eq : resK (u h₁.1.1) = resK (u h₂.1.1) := congrArg Units.val h_eq
      have hdiff : P 1 (u h₁.1.1 - u h₂.1.1) :=
        (hresK_eq_iff (u h₁.1.1) (u h₂.1.1) (hu_P0 h₁.1.1) (hu_P0 h₂.1.1)).mp hres_eq
      exact hu_I_inj h₁ h₂ hdiff
    have hCyclic_H₀ : IsCyclic H₀ := isCyclic_of_injective χ_K hχ_K_inj
    have hresK_pow : ∀ (w : K) (n : ℕ), P 0 w → P 0 (w ^ n) ∧ resK (w ^ n) = (resK w) ^ n := by
      intro w n hw
      induction n with
      | zero =>
        rw [pow_zero, pow_zero, hresK_1]
        exact ⟨hP_one, rfl⟩
      | succ n ih =>
        have hpow_int : P 0 (w ^ (n + 1)) := by
          rw [pow_succ, ← zero_add (0 : ℤ)]
          exact hP_mul ih.1 hw
        refine ⟨hpow_int, ?_⟩
        rw [pow_succ, (hresK_ring (w ^ n) w ih.1 hw).2.1, ih.2, pow_succ]
    have hresK_nat : ∀ n : ℕ, P 0 (n : K) ∧ resK (n : K) = (n : k_K) := by
      intro n
      induction n with
      | zero =>
        refine ⟨Or.inl Nat.cast_zero, ?_⟩
        rw [Nat.cast_zero, Nat.cast_zero, hresK_0]
      | succ n ih =>
        have hval_succ : P 0 ((n + 1 : ℕ) : K) := by
          rw [Nat.cast_succ]
          exact hP_add 0 ih.1 hP_one
        refine ⟨hval_succ, ?_⟩
        rw [Nat.cast_succ, (hresK_ring (n : K) 1 ih.1 hP_one).1, ih.2, hresK_1, Nat.cast_succ]
    have hp_valK : P 1 ((p F : ℕ) : K) := by
      let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      have hres0 : IsLocalRing.residue 𝒪[F] ((p F : ℕ) : 𝒪[F]) = 0 := by
        rw [map_natCast]
        exact CharP.cast_eq_zero 𝓀[F] (p F)
      have hker : valuation F (((p F : ℕ) : 𝒪[F]) : F) < 1 := by
        rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
      have hpF : ((p F : ℕ) : F) = 0 ∨ 1 ≤ addVal F ((p F : ℕ) : F) := by
        by_cases hp0 : ((p F : ℕ) : F) = 0
        · exact Or.inl hp0
        · right
          have hφp : φ (valuation F ((p F : ℕ) : F)) ≠ 0 :=
            (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
          have hlt : φ (valuation F ((p F : ℕ) : F)) < 1 := by
            rw [← map_one φ, map_lt_map_iff φ]
            exact hker
          rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
            ← Multiplicative.toAdd_lt, toAdd_one] at hlt
          unfold addVal
          rw [dif_neg hp0]
          omega
