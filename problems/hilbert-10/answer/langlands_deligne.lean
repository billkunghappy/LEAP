theorem ld_ch14_stickelberger_2p_power_assembly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    (hLE : L ≤ E)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hμ'_pow : ∀ i : Fin D_orb.length, (μ'_orb i) ^ (p F) = 1)
    (hStatPow2p : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      ∀ (c'_θ : Mˣ),
        valL F M (c'_θ : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M →
        (∀ x : M, (x = 0 ∨ ((condExp F M θ - 1 : ℕ) : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c'_θ⁻¹ : Mˣ) : M) * x)) →
        ∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ k : ℕ, k₀ ≤ k →
          (tateEps F M θ ψ_M) ^ ((2 * p F) ^ k) =
            ((qL F M : Ω F) ^ (2 * condExpChar F M ψ_M + (condExp F M θ : ℤ))) ^
              (2 ^ (k - 1) * (p F) ^ k) *
              (θ c'_θ : Ω F) ^ ((2 * p F) ^ k))
    (c'_χ' : Lˣ) (c'_χ'E : Eˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hcond_E : 2 ≤ condExp F E (χ'.comp (Units.map (normLM F hLE))))
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_L_top : ∀ x : L, (x = 0 ∨ ((condExp F L χ' - 1 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c'_χ'⁻¹ : Lˣ) : L) * x))
    (hc_E_val : valL F E (c'_χ'E : E) =
      (condExp F E (χ'.comp (Units.map (normLM F hLE))) : ℤ) +
        condExpChar F E (traceChar F hLE ψ))
    (hc_E_top : ∀ y : E,
      (y = 0 ∨ ((condExp F E (χ'.comp (Units.map (normLM F hLE))) - 1 : ℕ) : ℤ) ≤ valL F E y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLE))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE ψ) (((c'_χ'E⁻¹ : Eˣ) : E) * y))
    (hc_orb : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      2 ≤ condExp F F_i (μ'_orb i) ∧
      2 ≤ condExp F F_i θ_i ∧
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)) ∧
      valL F F_i (c'_θ i : F_i) =
        (condExp F F_i θ_i : ℤ) + condExpChar F F_i ψ_Fi ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i θ_i - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (θ_i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_θ i)⁻¹ : F_iˣ) : F_i) * x)))
    (hExpBal :
      (2 * condExpChar F E (traceChar F hLE ψ) +
          (condExp F E (χ'.comp (Units.map (normLM F hLE))) : ℤ)) * (resDeg F E : ℤ) +
        2 * condExpChar F L ψ * (resDeg F L : ℤ) +
        ∑ i : Fin D_orb.length,
          (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
            (condExp F (D_orb.get i).field (μ'_orb i) : ℤ)) *
            (resDeg F (D_orb.get i).field : ℤ) =
      2 * condExpChar F E (traceChar F hLE ψ) * (resDeg F E : ℤ) +
        (2 * condExpChar F L ψ + (condExp F L χ' : ℤ)) * (resDeg F L : ℤ) +
        ∑ i : Fin D_orb.length,
          (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
            (condExp F (D_orb.get i).field
              (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) : ℤ)) *
            (resDeg F (D_orb.get i).field : ℤ))
    (hNormCong :
      Units.map (normLM F hLE) c'_χ'E *
        (c'_χ' *
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_θ i)))⁻¹ ∈
        unitGroup F L 1) :
    ∃ k₁ : ℕ,
      (tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
          tateEps F L 1 ψ *
          (∏ i : Fin D_orb.length,
            tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ))) ^
        ((2 * p F) ^ k₁) =
      (tateEps F E 1 (traceChar F hLE ψ) *
          tateEps F L χ' ψ *
          (∏ i : Fin D_orb.length,
            tateEps F (D_orb.get i).field
              (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
              (traceChar F (D_orb.get i).le ψ))) ^
        ((2 * p F) ^ k₁) :=
by
  classical
  set Sψ : Set ℤ := {d : ℤ | ∀ x : L, -d ≤ valL F L x → ψ x = 1}
  have hne_ψ : Sψ.Nonempty := by
    obtain ⟨d₀, hd₀⟩ := hψ.2
    refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
    simpa using hx
  have hbdd_ψ : BddAbove Sψ := by
    have hne1 : ∃ x₀ : L, ψ x₀ ≠ 1 := by
      rcases DFunLike.ne_iff.mp hψ.1 with ⟨x₀, hx₀⟩
      exact ⟨x₀, by simpa [AddChar.one_apply] using hx₀⟩
    obtain ⟨x₀, hx₀⟩ := hne1
    refine ⟨-valL F L x₀ - 1, fun d hd => ?_⟩
    by_contra hlt
    have hle : -d ≤ valL F L x₀ := by omega
    exact hx₀ (hd x₀ hle)
  have hmem_ψ : condExpChar F L ψ ∈ Sψ := Int.csSup_mem hne_ψ hbdd_ψ
  have hψ_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1 := by
    intro x hx
    rcases hx with rfl | hx
    · exact AddChar.map_zero_eq_one ψ
    · exact hmem_ψ x hx
  have halg : ∀ z : L,
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F L = (minpoly F z).natDegree * m := by
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq L.val L.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
