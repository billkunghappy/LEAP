    (hTraceH : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hAB : A ≤ B) (hBMC : B ≤ M_C)
      (H_A : Subgroup H),
      (∀ w : relWeil F L,
        w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ projH (π w) ∈ H_A) →
