    dsimp only [U_δ, z]
    rw [Finset.prod_mul_distrib, ← hδ_prod, Finset.prod_const, hS'_card,
      ← pow_mul π₁ (t + 1) (p - 1), mul_comm (t + 1) (p - 1)]
  have hμ_eq : μ = (∏ j ∈ (Finset.range p).erase 0, (j : k_L)) * lam ^ (p - 1) := by
    change resK U_δ = (∏ j ∈ S', (j : k_L)) * lam ^ (p - 1)
    rw [hUδ_prod_z, (hresK_prod_nat S' z (fun j _ => (hz_int_res j).1)).2]
    have hcongr : (∏ j ∈ S', resK (z j)) = ∏ j ∈ S', ((j : k_L) * lam) :=
      Finset.prod_congr rfl (fun j _ => (hz_int_res j).2)
    rw [hcongr, Finset.prod_mul_distrib, Finset.prod_const, hS'_card]
  let v : G → K := fun τ => act τ π
  have hInjOn : Set.InjOn v ↑U_G := by
    intro τ₁ _ τ₂ _ h_eq
    change act τ₁ π = act τ₂ π at h_eq
    by_contra hne
    have h_inv_ne1 : τ₁⁻¹ * τ₂ ≠ 1 := by
      intro h1
      exact hne (inv_mul_eq_one.mp h1)
    have h_fix : act (τ₁⁻¹ * τ₂) π = π := by
      rw [hact_mul τ₁⁻¹ τ₂ π, ← h_eq, ← hact_mul τ₁⁻¹ τ₁ π, inv_mul_cancel, hact_one]
    exact (hjump (τ₁⁻¹ * τ₂) h_inv_ne1).1 (sub_eq_zero.mpr h_fix.symm)
  have hact_δ : ∀ τ : G, act τ δ = ∏ γ ∈ U_G.erase τ, (v τ - v γ) := by
    intro τ
    have hmap : act τ δ = ∏ ρ ∈ S₁, (v τ - v (τ * ρ)) := by
      change φ τ (∏ ρ ∈ S₁, (π - act ρ π)) = _
      rw [map_prod (φ τ)]
      refine Finset.prod_congr rfl (fun ρ _ => ?_)
      rw [map_sub (φ τ), hφ_apply, hφ_apply, ← hact_mul τ ρ π]
    rw [hmap]
    refine Finset.prod_bij (fun (ρ : G) _ => τ * ρ) ?_ ?_ ?_ ?_
    · intro ρ hρ
      have hρ_ne1 : ρ ≠ 1 := (Finset.mem_erase.mp hρ).1
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h_eq
      have h1 : τ⁻¹ * (τ * ρ) = τ⁻¹ * τ := congrArg (τ⁻¹ * ·) h_eq
      rw [inv_mul_cancel_left, inv_mul_cancel] at h1
      exact hρ_ne1 h1
    · intro ρ₁ _ ρ₂ _ h_eq
      exact mul_left_cancel h_eq
    · intro γ hγ
      have hγ_ne : γ ≠ τ := (Finset.mem_erase.mp hγ).1
      refine ⟨τ⁻¹ * γ, ?_, mul_inv_cancel_left τ γ⟩
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h1
      exact hγ_ne (inv_mul_eq_one.mp h1).symm
    · intro ρ _
      rfl
  set y₁ : K := π ^ (p - 1) * δ⁻¹
  have hact_term : ∀ τ : G,
      act τ y₁ = (v τ) ^ (p - 1) / (∏ γ ∈ U_G.erase τ, (v τ - v γ)) := by
    intro τ
    change φ τ (π ^ (p - 1) * δ⁻¹) = _
    rw [map_mul (φ τ), map_pow (φ τ), map_inv₀ (φ τ), hφ_apply, hφ_apply, hact_δ τ,
      div_eq_mul_inv]
  let Q : G → Polynomial K := fun τ =>
    ∏ γ ∈ U_G.erase τ, (Polynomial.X - Polynomial.C (v γ))
  have hQ_coeff : ∀ τ : G, (Q τ).coeff (p - 1) = 1 := by
    intro τ
    have hmonic_fac : ∀ γ ∈ U_G.erase τ, (Polynomial.X - Polynomial.C (v γ)).Monic :=
      fun γ _ => Polynomial.monic_X_sub_C (v γ)
    have hmonic : (Q τ).Monic :=
      Polynomial.monic_prod_of_monic (U_G.erase τ) _ hmonic_fac
    have hdeg : (Q τ).natDegree = p - 1 := by
      dsimp only [Q]
      rw [Polynomial.natDegree_prod_of_monic (U_G.erase τ) _ hmonic_fac]
      have hsum1 : (∑ γ ∈ U_G.erase τ, (Polynomial.X - Polynomial.C (v γ)).natDegree) =
          ∑ _γ ∈ U_G.erase τ, 1 := by
        refine Finset.sum_congr rfl (fun γ _ => Polynomial.natDegree_X_sub_C (v γ))
      rw [hsum1, Finset.sum_const, smul_eq_mul, mul_one,
        Finset.card_erase_of_mem (Finset.mem_univ τ), Finset.card_univ, hcard_G]
    rw [← hdeg]
    exact Polynomial.Monic.coeff_natDegree hmonic
  have htr_y₁ : traceLM F hLK y₁ = 1 := by
    have hk : p - 1 < p := Nat.sub_lt hp_pos zero_lt_one
    have hdeg : (Polynomial.X ^ (p - 1) : Polynomial K).degree < (U_G.card : WithBot ℕ) := by
      rw [Polynomial.degree_X_pow (p - 1), Finset.card_univ, hcard_G]
      exact WithBot.coe_lt_coe.mpr hk
    have hLag := @Lagrange.eq_interpolate K _ G _ U_G v (Polynomial.X ^ (p - 1)) hInjOn hdeg
    rw [Lagrange.interpolate_eq_sum] at hLag
    have hcoeff := congrArg (fun P : Polynomial K => P.coeff (p - 1)) hLag
    dsimp only at hcoeff
    rw [Polynomial.coeff_X_pow (p - 1) (p - 1), if_pos rfl, Polynomial.finset_sum_coeff] at hcoeff
    have hrhs : (∑ τ ∈ U_G,
        (Polynomial.C (Polynomial.eval (v τ) (Polynomial.X ^ (p - 1)) /
          ∏ γ ∈ U_G.erase τ, (v τ - v γ)) * Q τ).coeff (p - 1)) =
        IntermediateField.inclusion hLK (traceLM F hLK y₁) := by
      rw [hact_trace y₁]
      refine Finset.sum_congr rfl (fun τ _ => ?_)
      rw [Polynomial.coeff_C_mul, hQ_coeff τ, mul_one, Polynomial.eval_X_pow, hact_term τ]
    rw [hrhs] at hcoeff
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (traceLM F hLK y₁) =
      IntermediateField.inclusion hLK 1
    rw [map_one (IntermediateField.inclusion hLK), ← hcoeff]
  have hy₁_ne0 : y₁ ≠ 0 := mul_ne_zero (hval_π_pow (p - 1)).1 hδ_inv_ne0
  have hy₁_val : valL F K y₁ = ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
    dsimp only [y₁]
    rw [hval_mul_K _ _ (hval_π_pow (p - 1)).1 hδ_inv_ne0, (hval_π_pow (p - 1)).2, hδ_inv_val]
    ring
  have htr_smul : ∀ (a : L) (z_K : K),
      traceLM F hLK (IntermediateField.inclusion hLK a * z_K) = a * traceLM F hLK z_K := by
    intro a z_K
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (traceLM F hLK (IntermediateField.inclusion hLK a * z_K)) =
      IntermediateField.inclusion hLK (a * traceLM F hLK z_K)
    rw [map_mul (IntermediateField.inclusion hLK), hact_trace, hact_trace, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun τ _ => ?_)
    rw [((hact_ring τ).2.2 _ _).2.1, hact_incl τ a]
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have htr_y₁_ker : ∀ r : K, (r = 0 ∨ 1 ≤ valL F K r) →
      (traceLM F hLK (r * y₁) = 0 ∨ 1 ≤ valL F L (traceLM F hLK (r * y₁))) := by
    intro r hr
    apply htr_bound 1 (r * y₁)
    by_cases hr0 : r = 0
    · exact Or.inl (by rw [hr0, zero_mul])
    · right
      have hr1 : 1 ≤ valL F K r := hr.resolve_left hr0
      rw [hval_mul_K r y₁ hr0 hy₁_ne0, hy₁_val, hp1_cast]
      linarith
  have htr_y₁_res : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      resL (traceLM F hLK (y * y₁)) = resK y := by
    intro y hy
    obtain ⟨x₀, hx₀_int, hx₀_res, hr_val⟩ := hresK_lift y hy
    set r : K := y - IntermediateField.inclusion hLK x₀
    have hy_decomp : y * y₁ = IntermediateField.inclusion hLK x₀ * y₁ + r * y₁ := by
      dsimp only [r]; ring
    have htr_eq : traceLM F hLK (y * y₁) = x₀ + traceLM F hLK (r * y₁) := by
      rw [hy_decomp, map_add, htr_smul x₀ y₁, htr_y₁, mul_one]
    have her_val1 : traceLM F hLK (r * y₁) = 0 ∨ 1 ≤ valL F L (traceLM F hLK (r * y₁)) :=
      htr_y₁_ker r hr_val
    have her_int : traceLM F hLK (r * y₁) = 0 ∨ 0 ≤ valL F L (traceLM F hLK (r * y₁)) := by
      rcases her_val1 with h0 | h1
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have her_res0 : resL (traceLM F hLK (r * y₁)) = 0 :=
      (hresL_ker _ her_int).mpr her_val1
    rw [htr_eq, (hresL_ring x₀ _ hx₀_int her_int).1, her_res0, add_zero, hx₀_res]
  set y_prod : K := W_t * U_δ
  have hy_prod_int : y_prod = 0 ∨ 0 ≤ valL F K y_prod := by
    simpa [y_prod] using hval_mul_ge_K 0 0 W_t U_δ hWt_int hUδ_int
  have hresK_y_prod : resK y_prod = μ := by
    dsimp only [y_prod]
    rw [(hresK_ring W_t U_δ hWt_int hUδ_int).2.1, hresK_Wt, one_mul]
  have hp_sub : (p - 1) + 1 = p := Nat.sub_add_cancel hp_pos
  have h_exp : p * t + (p - 1) = (p - 1) * (t + 1) + t := by
    calc p * t + (p - 1) = ((p - 1) + 1) * t + (p - 1) := by rw [hp_sub]
      _ = (p - 1) * (t + 1) + t := by ring
  have hπ_cancel : π ^ (p * t) * π ^ (p - 1) * (π₁ ^ ((p - 1) * (t + 1))) = π ^ t := by
    calc π ^ (p * t) * π ^ (p - 1) * (π₁ ^ ((p - 1) * (t + 1)))
      _ = π ^ (p * t + (p - 1)) * (π₁ ^ ((p - 1) * (t + 1))) := by rw [← pow_add]
      _ = π ^ ((p - 1) * (t + 1) + t) * (π₁ ^ ((p - 1) * (t + 1))) := by rw [h_exp]
      _ = (π ^ ((p - 1) * (t + 1)) * π₁ ^ ((p - 1) * (t + 1))) * π ^ t := by
          rw [pow_add]; ring
      _ = π ^ t := by rw [hπ_pow_mul_π₁_pow ((p - 1) * (t + 1)), one_mul]
  have hy_prod_y₁ : y_prod * y₁ =
      IntermediateField.inclusion hLK ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) *
        (((ϖ_K ^ t : Kˣ) : K)) := by
    dsimp only [y_prod, U_δ, y₁]
    rw [hWt_eq]
    calc (IntermediateField.inclusion hLK ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) * π ^ (p * t) *
          (δ * π₁ ^ ((p - 1) * (t + 1)))) * (π ^ (p - 1) * δ⁻¹)
      _ = IntermediateField.inclusion hLK ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) *
            (π ^ (p * t) * π ^ (p - 1) * π₁ ^ ((p - 1) * (t + 1))) * (δ * δ⁻¹) := by ring
      _ = IntermediateField.inclusion hLK ((((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) *
            (((ϖ_K ^ t : Kˣ) : K)) := by
          rw [hπ_cancel, mul_inv_cancel₀ hδ_ne0, mul_one, Units.val_pow_eq_pow_val]
  have htr_goal : traceLM F hLK (y_prod * y₁) =
      traceLM F hLK (((ϖ_K ^ t : Kˣ) : K)) * (((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L) := by
    rw [hy_prod_y₁, htr_smul, mul_comm]
  have hres_goal :
      resL (traceLM F hLK (((ϖ_K ^ t : Kˣ) : K)) * (((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) = μ := by
    rw [← htr_goal, htr_y₁_res y_prod hy_prod_int, hresK_y_prod]
  exact ⟨μ, lam, hμ_ne0, hlam_ne0, hres_goal, hμ_eq⟩

theorem ld_wild_odd_prime_norm_quad_error (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_ne2 : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (t b : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : b = t + 1) (hb_odd : b % 2 = 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (hact_norm : ∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y) :
    let d := b / 2
    ∀ w : K, (w = 0 ∨ (d : ℤ) ≤ valL F K w) →
      (normLM F hLK (1 + w) - 1 - traceLM F hLK w - normLM F hLK w) -
        (normLM F hLK (1 + (-w)) - 1 - traceLM F hLK (-w) - normLM F hLK (-w)) = 0 ∨
      (b : ℤ) ≤
        valL F L
          ((normLM F hLK (1 + w) - 1 - traceLM F hLK w - normLM F hLK w) -
            (normLM F hLK (1 + (-w)) - 1 - traceLM F hLK (-w) - normLM F hLK (-w))) :=
by
  rcases hvalK_props with
    ⟨_, hvalK1, _, hvalK_neg, hvalK_mul, _, _, hvalK_add, _⟩
  intro d w hw
  have hd_def : d = b / 2 := rfl
  set p : ℕ := Module.finrank L (IntermediateField.extendScalars hLK)
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hd_ge1 : 1 ≤ d := by omega
  have hb_2d : b = 2 * d + 1 := by omega
  have hcard_univ : (Finset.univ : Finset G).card = p := Finset.card_univ.trans hcard_G
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).1 }
  let P : K → Finset G → K := fun y S => ∏ s ∈ S, act s y
  let U_pow : Finset (Finset G) := (Finset.univ : Finset G).powerset
  
  have hnorm_powerset : ∀ y : K,
      IntermediateField.inclusion hLK (normLM F hLK (1 + y)) = ∑ S ∈ U_pow, P y S := by
    intro y
    rw [hact_norm (1 + y)]
    have h1 : (∏ σ : G, act σ (1 + y)) = ∏ σ ∈ (Finset.univ : Finset G), (1 + act σ y) := by
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [((hact_ring σ).2.2 1 y).1, (hact_ring σ).2.1]
    rw [h1]
    exact Finset.prod_one_add (Finset.univ : Finset G)
  
  let U₀ : Finset (Finset G) := U_pow.erase ∅
  have hempty_mem : (∅ : Finset G) ∈ U_pow := Finset.empty_mem_powerset Finset.univ
  have hP_empty : ∀ y : K, P y ∅ = 1 := fun _ => Finset.prod_empty
  have hsum_U_pow : ∀ y : K, (∑ S ∈ U_pow, P y S) = 1 + ∑ S ∈ U₀, P y S := by
    intro y
    rw [← Finset.add_sum_erase U_pow (P y) hempty_mem, hP_empty y]
  have huniv_ne_empty : (Finset.univ : Finset G) ≠ ∅ := by
    intro h
    have hc := congrArg Finset.card h
    simp only [hcard_univ, Finset.card_empty] at hc
    omega
  have huniv_mem_U₀ : (Finset.univ : Finset G) ∈ U₀ :=
    Finset.mem_erase.mpr ⟨huniv_ne_empty, Finset.mem_powerset_self Finset.univ⟩
  have hP_univ : ∀ y : K, P y Finset.univ = IntermediateField.inclusion hLK (normLM F hLK y) :=
    fun y => (hact_norm y).symm
  let U₁ : Finset (Finset G) := U₀.erase Finset.univ
  have hsum_U₀ : ∀ y : K,
      (∑ S ∈ U₀, P y S) =
        IntermediateField.inclusion hLK (normLM F hLK y) + ∑ S ∈ U₁, P y S := by
    intro y
    rw [← Finset.add_sum_erase U₀ (P y) huniv_mem_U₀, hP_univ y]
  have hmem_U₁ : ∀ {S : Finset G}, S ∈ U₁ ↔ 1 ≤ S.card ∧ S.card ≤ p - 1 := by
    intro S
    simp only [U₁, U₀, U_pow, Finset.mem_erase, Finset.mem_powerset, Finset.subset_univ,
      and_true]
    constructor
    · rintro ⟨hne_univ, hne_empty⟩
      have hpos : 0 < S.card := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hne_empty)
      have hle : S.card ≤ p := by
        have h := Finset.card_le_univ S
        omega
      have hne_p : S.card ≠ p := by
        intro hc
        apply hne_univ
        exact Finset.eq_univ_of_card S (hc.trans hcard_G.symm)
      omega
    · rintro ⟨hge1, hle⟩
      refine ⟨?_, ?_⟩
      · intro huniv
        rw [huniv, hcard_univ] at hle
        omega
      · intro hempty
        rw [hempty, Finset.card_empty] at hge1
        omega
  let U_sing : Finset (Finset G) := U₁.filter (fun S => S.card = 1)
  let ℱ : Finset (Finset G) := U₁.filter (fun S => ¬ S.card = 1)
  have hsum_U₁ : ∀ y : K, (∑ S ∈ U₁, P y S) = (∑ S ∈ U_sing, P y S) + (∑ S ∈ ℱ, P y S) :=
    fun y => (Finset.sum_filter_add_sum_filter_not U₁ (fun S => S.card = 1) (P y)).symm
  have hUsing_eq : U_sing = (Finset.univ : Finset G).image (fun σ : G => ({σ} : Finset G)) := by
    ext S
    simp only [U_sing, Finset.mem_filter, hmem_U₁, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨_, hcard1⟩
      obtain ⟨σ, rfl⟩ := Finset.card_eq_one.mp hcard1
      exact ⟨σ, rfl⟩
    · rintro ⟨σ, rfl⟩
      rw [Finset.card_singleton]
      omega
  have hsum_Using : ∀ y : K,
      (∑ S ∈ U_sing, P y S) = IntermediateField.inclusion hLK (traceLM F hLK y) := by
    intro y
    rw [hUsing_eq, Finset.sum_image (fun σ₁ _ σ₂ _ h => Finset.singleton_injective h)]
    have h1 : (∑ σ ∈ (Finset.univ : Finset G), P y {σ}) = ∑ σ : G, act σ y := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact Finset.prod_singleton (fun s => act s y) σ
    rw [h1, ← hact_trace y]
  have hmem_F : ∀ {S : Finset G}, S ∈ ℱ ↔ 2 ≤ S.card ∧ S.card ≤ p - 1 := by
    intro S
    simp only [ℱ, Finset.mem_filter, hmem_U₁]
    omega
  
  let trS : G → Finset G → Finset G := fun τ S => S.image (fun s => τ * s)
  have trS_card : ∀ (τ : G) (S : Finset G), (trS τ S).card = S.card :=
    fun τ S => Finset.card_image_of_injective S (mul_right_injective τ)
  have trS_one : ∀ (S : Finset G), trS 1 S = S := by
    intro S
    ext x
    simp [trS]
  have trS_mul : ∀ (σ τ : G) (S : Finset G), trS (σ * τ) S = trS σ (trS τ S) := by
    intro σ τ S
    ext x
    simp [trS, mul_assoc]
  have trS_mem_F : ∀ {S : Finset G}, S ∈ ℱ → ∀ (τ : G), trS τ S ∈ ℱ := by
    intro S hS τ
    rw [hmem_F, trS_card]
    exact hmem_F.mp hS
  have P_trS : ∀ (y : K) (τ : G) (S : Finset G), P y (trS τ S) = act τ (P y S) := by
    intro y τ S
    change (∏ x ∈ S.image (fun s => τ * s), act x y) = φ τ (∏ s ∈ S, act s y)
    rw [Finset.prod_image (fun s₁ _ s₂ _ h => mul_right_injective τ h), map_prod (φ τ)]
    refine Finset.prod_congr rfl fun s _ => ?_
    exact hact_mul τ s y
  
  have trS_free : ∀ {S : Finset G}, S ∈ ℱ → ∀ {τ : G}, trS τ S = S → τ = 1 := by
    intro S hS τ hfix
    obtain ⟨hge2, hle⟩ := hmem_F.mp hS
    by_contra hτ
    have hpow_p : τ ^ p = 1 := by
      rw [← hcard_G]
      exact pow_card_eq_one
    have hord : orderOf τ = p := orderOf_eq_prime hpow_p hτ
    have hS_pos : 0 < S.card := by omega
    obtain ⟨s₀, hs₀⟩ := Finset.card_pos.mp hS_pos
    have hpow_mem : ∀ k : ℕ, τ ^ k * s₀ ∈ S := by
      intro k
      induction k with
      | zero => simp [hs₀]
      | succ k ih =>
        have hstep : τ * (τ ^ k * s₀) ∈ trS τ S :=
          Finset.mem_image_of_mem (fun s => τ * s) ih
        rw [hfix, ← mul_assoc, ← pow_succ'] at hstep
        exact hstep
    let f : Fin p → G := fun k => τ ^ k.1 * s₀
    have hMaps : Set.MapsTo f ↑(Finset.univ : Finset (Fin p)) ↑S := by
      intro k _
      exact Finset.mem_coe.mpr (hpow_mem k.1)
    have hInj : Set.InjOn f ↑(Finset.univ : Finset (Fin p)) := by
      intro k₁ _ k₂ _ heq
      have hpow_eq : τ ^ k₁.1 = τ ^ k₂.1 := mul_left_injective s₀ heq
      have hk₁ : k₁.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₁.2
      have hk₂ : k₂.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₂.2
      exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ hpow_eq)
    have hcard_le := Finset.card_le_card_of_injOn f hMaps hInj
    simp only [Finset.card_univ, Fintype.card_fin] at hcard_le
    omega
  have trS_inj : ∀ {S : Finset G}, S ∈ ℱ → Function.Injective (fun τ : G => trS τ S) := by
    intro S hS τ₁ τ₂ heq
    dsimp only at heq
    have hfix : trS (τ₁⁻¹ * τ₂) S = S := by
      rw [trS_mul, ← heq, ← trS_mul, inv_mul_cancel, trS_one]
    exact inv_mul_eq_one.mp (trS_free hS hfix)
  
  let orb : Finset G → Finset (Finset G) :=
    fun S => (Finset.univ : Finset G).image (fun τ => trS τ S)
  let chooseOrb : Finset (Finset G) → Finset G :=
    fun O => if h : ∃ T, T ∈ O then Classical.choose h else ∅
  let rep : Finset G → Finset G := fun S => chooseOrb (orb S)
  let ℛ : Finset (Finset G) := ℱ.image rep
  have mem_orb_self : ∀ (S : Finset G), S ∈ orb S := by
    intro S
    refine Finset.mem_image.mpr ⟨1, Finset.mem_univ 1, trS_one S⟩
  have orb_trS : ∀ (σ : G) (S : Finset G), orb (trS σ S) = orb S := by
    intro σ S
    ext T
    simp only [orb, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨τ, rfl⟩
      exact ⟨τ * σ, trS_mul τ σ S⟩
    · rintro ⟨ρ, rfl⟩
      refine ⟨ρ * σ⁻¹, ?_⟩
      rw [← trS_mul, inv_mul_cancel_right]
  have orb_eq_of_mem : ∀ {S T : Finset G}, T ∈ orb S → orb T = orb S := by
    intro S T hT
    obtain ⟨σ, _, rfl⟩ := Finset.mem_image.mp hT
    exact orb_trS σ S
  have rep_mem_orb : ∀ (S : Finset G), rep S ∈ orb S := by
    intro S
    have hex : ∃ T, T ∈ orb S := ⟨S, mem_orb_self S⟩
    have hdef : rep S = Classical.choose hex := dif_pos hex
    rw [hdef]
    exact Classical.choose_spec hex
  have orb_rep : ∀ (S : Finset G), orb (rep S) = orb S :=
    fun S => orb_eq_of_mem (rep_mem_orb S)
  have rep_eq_iff : ∀ (S₁ S₂ : Finset G), rep S₁ = rep S₂ ↔ orb S₁ = orb S₂ := by
    intro S₁ S₂
    constructor
    · intro h
      rw [← orb_rep S₁, h, orb_rep S₂]
    · intro h
      exact congrArg chooseOrb h
  have R_sub_F : ∀ S₀ ∈ ℛ, S₀ ∈ ℱ ∧ rep S₀ = S₀ := by
    intro S₀ hS₀
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hS₀
    obtain ⟨τ, _, hτ⟩ := Finset.mem_image.mp (rep_mem_orb S)
    refine ⟨hτ ▸ trS_mem_F hS τ, ?_⟩
    exact (rep_eq_iff (rep S) S).mpr (orb_rep S)
  have hfiber : ∀ S₀ ∈ ℛ, ℱ.filter (fun S => rep S = S₀) = orb S₀ := by
    intro S₀ hS₀
    obtain ⟨hS₀_F, hS₀_rep⟩ := R_sub_F S₀ hS₀
    ext S
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨_, hrep⟩
      have horb : orb S = orb S₀ := (rep_eq_iff S S₀).mp (hrep.trans hS₀_rep.symm)
      rw [← horb]
      exact mem_orb_self S
    · intro hmem
      obtain ⟨τ, _, rfl⟩ := Finset.mem_image.mp hmem
      refine ⟨trS_mem_F hS₀_F τ, ?_⟩
      have horb : orb (trS τ S₀) = orb S₀ := orb_trS τ S₀
      exact ((rep_eq_iff (trS τ S₀) S₀).mpr horb).trans hS₀_rep
  have hsum_F : ∀ y : K,
      (∑ S ∈ ℱ, P y S) = IntermediateField.inclusion hLK (traceLM F hLK (∑ S₀ ∈ ℛ, P y S₀)) := by
    intro y
    rw [← Finset.sum_fiberwise_of_maps_to (fun S hS => Finset.mem_image_of_mem rep hS) (P y)]
    have h1 :
        (∑ S₀ ∈ ℛ, ∑ S ∈ ℱ with rep S = S₀, P y S) =
          ∑ S₀ ∈ ℛ, ∑ τ ∈ (Finset.univ : Finset G), act τ (P y S₀) := by
      refine Finset.sum_congr rfl fun S₀ hS₀ => ?_
      have hS₀_F : S₀ ∈ ℱ := (R_sub_F S₀ hS₀).1
      rw [hfiber S₀ hS₀]
      change (∑ S ∈ (Finset.univ : Finset G).image (fun τ => trS τ S₀), P y S) = _
      rw [Finset.sum_image (fun τ₁ _ τ₂ _ h => trS_inj hS₀_F h)]
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact P_trS y τ S₀
    rw [h1, Finset.sum_comm]
    have h2 :
        (∑ τ ∈ (Finset.univ : Finset G), ∑ S₀ ∈ ℛ, act τ (P y S₀)) =
          ∑ τ : G, act τ (∑ S₀ ∈ ℛ, P y S₀) := by
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact (map_sum (φ τ) (P y) ℛ).symm
    rw [h2, ← hact_trace (∑ S₀ ∈ ℛ, P y S₀)]
  have hE_eq : ∀ y : K,
      normLM F hLK (1 + y) - 1 - traceLM F hLK y - normLM F hLK y =
        traceLM F hLK (∑ S₀ ∈ ℛ, P y S₀) := by
    intro y
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK
        (normLM F hLK (1 + y) - 1 - traceLM F hLK y - normLM F hLK y) =
      IntermediateField.inclusion hLK (traceLM F hLK (∑ S₀ ∈ ℛ, P y S₀))
    rw [map_sub, map_sub, map_sub, map_one, hnorm_powerset y, hsum_U_pow y, hsum_U₀ y,
      hsum_U₁ y, hsum_Using y, hsum_F y]
    ring
  let z₃ : K := ∑ S₀ ∈ ℛ, (P w S₀ - P (-w) S₀)
  have hdiff_eq :
      (normLM F hLK (1 + w) - 1 - traceLM F hLK w - normLM F hLK w) -
        (normLM F hLK (1 + (-w)) - 1 - traceLM F hLK (-w) - normLM F hLK (-w)) =
        traceLM F hLK z₃ := by
    change _ = traceLM F hLK (∑ S₀ ∈ ℛ, (P w S₀ - P (-w) S₀))
    rw [hE_eq w, hE_eq (-w), ← map_sub (traceLM F hLK), ← Finset.sum_sub_distrib]
  
  have hP_neg : ∀ S : Finset G, P (-w) S = (-1 : K) ^ S.card * P w S := by
    intro S
    change (∏ s ∈ S, act s (-w)) = (-1 : K) ^ S.card * ∏ s ∈ S, act s w
    have h1 : (∏ s ∈ S, act s (-w)) = ∏ s ∈ S, (- act s w) :=
      Finset.prod_congr rfl fun s _ => ((hact_ring s).2.2 w 0).2.2
    rw [h1, Finset.prod_neg]
  have hP_val : ∀ (y : K), (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
      ∀ S : Finset G, P y S = 0 ∨ (S.card : ℤ) * (d : ℤ) ≤ valL F K (P y S) := by
    intro y hy S
    have hy_act : ∀ s : G, act s y = 0 ∨ (d : ℤ) ≤ valL F K (act s y) := by
      intro s
      rcases hy with rfl | hy_val
      · exact Or.inl (hact_ring s).1
      · right
        rw [hact_val s y]
        exact hy_val
    induction S using Finset.induction_on with
    | empty =>
      right
      change ((0 : ℕ) : ℤ) * (d : ℤ) ≤ valL F K 1
      rw [hvalK1]
      simp
    | @insert s S' hs ih =>
      have hP_ins : P y (insert s S') = act s y * P y S' := Finset.prod_insert hs
      have hcard_ins : (insert s S').card = S'.card + 1 := Finset.card_insert_of_notMem hs
      rw [hP_ins, hcard_ins]
      by_cases ha : act s y = 0
      · left; rw [ha, zero_mul]
      · by_cases hb : P y S' = 0
        · left; rw [hb, mul_zero]
        · right
          have hva : (d : ℤ) ≤ valL F K (act s y) := (hy_act s).resolve_left ha
          have hvb : (S'.card : ℤ) * (d : ℤ) ≤ valL F K (P y S') := ih.resolve_left hb
          rw [hvalK_mul (act s y) (P y S') ha hb]
          push_cast
          linarith
  have hnw : -w = 0 ∨ (d : ℤ) ≤ valL F K (-w) := by
    rcases hw with rfl | hw_le
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hvalK_neg]; exact hw_le)
  have hvalK_sub : ∀ (k : ℤ) (x y : K),
      (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
        (x - y = 0 ∨ k ≤ valL F K (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hvalK_add k x (-y) hx
    rcases hy with rfl | hy_le
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hvalK_neg]; exact hy_le)
  have hz₃_term : ∀ S₀ ∈ ℛ,
      P w S₀ - P (-w) S₀ = 0 ∨ (b : ℤ) ≤ valL F K (P w S₀ - P (-w) S₀) := by
    intro S₀ hS₀
    have hge2 : 2 ≤ S₀.card := (hmem_F.mp (R_sub_F S₀ hS₀).1).1
    by_cases hc2 : S₀.card = 2
    · left
      rw [hP_neg S₀, hc2]
      ring
    · have hge3 : 3 ≤ S₀.card := by omega
      have hbd_le : (b : ℤ) ≤ (S₀.card : ℤ) * (d : ℤ) := by
        have h1 : (3 : ℤ) ≤ (S₀.card : ℤ) := by exact_mod_cast hge3
        have h2 : (1 : ℤ) ≤ (d : ℤ) := by exact_mod_cast hd_ge1
        have h3 : (b : ℤ) = 2 * (d : ℤ) + 1 := by omega
        nlinarith
      have hPw : P w S₀ = 0 ∨ (b : ℤ) ≤ valL F K (P w S₀) := by
        rcases hP_val w hw S₀ with h0 | hval
        · exact Or.inl h0
        · exact Or.inr (le_trans hbd_le hval)
      have hPnw : P (-w) S₀ = 0 ∨ (b : ℤ) ≤ valL F K (P (-w) S₀) := by
        rcases hP_val (-w) hnw S₀ with h0 | hval
        · exact Or.inl h0
        · exact Or.inr (le_trans hbd_le hval)
      exact hvalK_sub (b : ℤ) (P w S₀) (P (-w) S₀) hPw hPnw
  have hz₃_val : z₃ = 0 ∨ (b : ℤ) ≤ valL F K z₃ := by
    change (∑ S₀ ∈ ℛ, (P w S₀ - P (-w) S₀)) = 0 ∨
      (b : ℤ) ≤ valL F K (∑ S₀ ∈ ℛ, (P w S₀ - P (-w) S₀))
    have hsub : ∀ T : Finset (Finset G), T ⊆ ℛ →
        (∑ S₀ ∈ T, (P w S₀ - P (-w) S₀)) = 0 ∨
          (b : ℤ) ≤ valL F K (∑ S₀ ∈ T, (P w S₀ - P (-w) S₀)) := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro _
        exact Or.inl Finset.sum_empty
      | @insert S₀ T' hS₀ ih =>
        intro hT
        rw [Finset.sum_insert hS₀]
        have h1 : P w S₀ - P (-w) S₀ = 0 ∨ (b : ℤ) ≤ valL F K (P w S₀ - P (-w) S₀) :=
          hz₃_term S₀ (hT (Finset.mem_insert_self S₀ T'))
        have h2 : (∑ S ∈ T', (P w S - P (-w) S)) = 0 ∨
            (b : ℤ) ≤ valL F K (∑ S ∈ T', (P w S - P (-w) S)) :=
          ih (Finset.Subset.trans (Finset.subset_insert S₀ T') hT)
        exact hvalK_add (b : ℤ) (P w S₀ - P (-w) S₀) (∑ S ∈ T', (P w S - P (-w) S)) h1 h2
    exact hsub ℛ (Finset.Subset.refl ℛ)
  rw [hdiff_eq]
  apply htr_bound (b : ℤ) z₃
  rcases hz₃_val with hz₀ | hz_le
  · exact Or.inl hz₀
  · right
    have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    have hb_cast : (t + 1 : ℤ) = (b : ℤ) := by omega
    change (p : ℤ) * (b : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K z₃
    rw [hp1_cast, hb_cast]
    nlinarith

theorem ld_wild_odd_prime_trace_residue_and_norm_quad_error (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_ne2 : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (haddVal1 : addVal F 1 = 0)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (t b : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : b = t + 1) (hb_odd : b % 2 = 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
