    (hu_all_0_val : ∀ j, valL F M_C ((u_all_0 j : M_Cˣ) : M_C) = 0)
    (hu_all_0_P : ∀ j, ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
