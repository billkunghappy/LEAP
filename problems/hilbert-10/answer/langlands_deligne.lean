        _ = h₀ * (z * (h₀⁻¹ * c * h₀)) * h₀⁻¹ := by group
        _ = h₀ * ((h₀⁻¹ * c * h₀) * z) * h₀⁻¹ := by rw [hz_comm]
        _ = c * (h₀ * z * h₀⁻¹) := by group
