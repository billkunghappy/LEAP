  intro u hu
  have hmem : resL (x_coord u) ∈ I ∪ I_shift := by
    rw [hunion]
    exact Finset.mem_univ _
  rcases Finset.mem_union.mp hmem with hI | hS
  · obtain ⟨h1, h2⟩ := h_triv_I u hu hI
    change ν₁ u * ν₂ u = 1
    rw [h1, h2, mul_one]
  · obtain ⟨h1, h2⟩ := h_triv_shift u hu hS
    have hprod_uu₁ : (ν₁ * ν₂) (u * u₁) = 1 := by
      change ν₁ (u * u₁) * ν₂ (u * u₁) = 1
      rw [h1, h2, mul_one]
    rw [map_mul, hprod_u₁, mul_one] at hprod_uu₁
    exact hprod_uu₁

theorem ld_ch12_wild_dyadic_tot_ram_min_break_even (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y)) :
    condExp F L νM₁' % 2 = 0 :=
by
  rcases Nat.mod_two_eq_zero_or_one (condExp F L νM₁') with h_even | hT1_odd
  · exact h_even
  · exfalso
    set T₁ := condExp F L νM₁'
    set T₂ := condExp F L νE'
    set e := T₁ / 2
    have he : 1 ≤ e := by dsimp [e, T₁]; omega
    have hT1_eq_2e1 : T₁ = 2 * e + 1 := by dsimp [e, T₁]; omega
    have hT1_le_T2 : T₁ ≤ T₂ := by
      have h0 := hMinM₁' 0 hPrime.pos
      exact h0.1.trans (le_of_eq h0.2)
    have hdegLE'_eq2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2 :=
      hWild.trans hp2
    have hdegLM₁'_eq2 : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
      hdegM₁'.trans hdegLE'_eq2
    have hPrimeM₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) :=
      hdegM₁'.symm ▸ hPrime
    have hWildM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = p F :=
      hdegM₁'.trans hWild
    have hνM₁'_pow' : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) = 1 :=
      hdegM₁'.symm ▸ hνM₁'_pow
    have hνM₁'_cond' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
        ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1 :=
      fun j hj => hνM₁'_cond j (hdegM₁' ▸ hj)
    have hbM₁'_ne0 : condExp F L νM₁' ≠ 0 := by omega
    have hbE'_ne0 : condExp F L νE' ≠ 0 := by omega
    have hvalL_props := ld_valL_and_unitGroup_props F L
    have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
    have hvalE'_props := ld_valL_and_unitGroup_props F E'
    obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L, _, _, _⟩ :=
      ld_valL_and_unitGroup_props F L
    obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0_L, halg1_L, R_F, hRF_0, hRF_mod1⟩ :=
      ld_addVal_finset_and_algebraMap_valL F L
    obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L hval0_L hval_neg_L hval_mul_L hval_add_L
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0_L halg1_L R_F hRF_0 hRF_mod1
    obtain ⟨k_L, hk_L_field, hk_L_fin, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
      ld_valL_residue_field_exists F L hval0_L hval1_L hval_neg1_L hval_neg_L hval_mul_L
        hval_inv_L hval_add_L S₁ hS₁
    letI : Field k_L := hk_L_field
    letI : Fintype k_L := hk_L_fin
    obtain ⟨_, _, _, hval_norm_M₁', hval_alg_M₁', hfrob_surj_M₁', _, _,
      ϖ_M₁', ϖ_L₁, hϖ_norm_M₁', hϖ_M₁', hϖ_L₁, hBasis_M₁'⟩ :=
      ld_wild_total_ramification_and_power_basis F L M₁' hLM₁' hPrimeM₁' νM₁'
        hνM₁'_pow' hνM₁'_ne hνM₁'_ker hνM₁'_cond' hbM₁'_ne0 hWildM₁'
        haddVal1 haddVal_mul halg1_L hvalL_props hvalM₁'_props
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
    obtain ⟨t₁, w_star₁, ht₁_ge1, hw_star₁_t, hw_star₁_nt1, hw_star₁_norm,
      htr_bound_M₁', htr_surj_M₁', hnorm_exp_M₁'⟩ :=
      ld_wild_galois_jump_and_euler_trace_formula F L M₁' hLM₁' hGalLM₁' hPrimeM₁' hWildM₁'
        haddVal1 halg1_L hvalL_props hvalM₁'_props hval_norm_M₁' hval_alg_M₁' ϖ_M₁' hϖ_M₁' hBasis_M₁'
    have hT1_eq_t1 : T₁ = t₁ + 1 :=
      (ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L M₁' hLM₁' hPrimeM₁' νM₁'
        hνM₁'_ker hνM₁'_cond' hvalL_props hvalM₁'_props hval_norm_M₁' hval_alg_M₁' hfrob_surj_M₁'
        ϖ_M₁' ϖ_L₁ hϖ_norm_M₁' hϖ_M₁' hϖ_L₁ hBasis_M₁'
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
        t₁ w_star₁ ht₁_ge1 hw_star₁_t hw_star₁_nt1 hw_star₁_norm
        htr_bound_M₁' htr_surj_M₁' hnorm_exp_M₁').1
    obtain ⟨_, _, _, hval_norm_E', hval_alg_E', hfrob_surj_E', _, _,
      ϖ_E', ϖ_L₂, hϖ_norm_E', hϖ_E', hϖ_L₂, hBasis_E'⟩ :=
      ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
        hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ne0 hWild
        haddVal1 haddVal_mul halg1_L hvalL_props hvalE'_props
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
    obtain ⟨t₂, w_star₂, ht₂_ge1, hw_star₂_t, hw_star₂_nt1, hw_star₂_norm,
      htr_bound_E', htr_surj_E', hnorm_exp_E'⟩ :=
      ld_wild_galois_jump_and_euler_trace_formula F L E' hLE' hGalLE' hPrime hWild
        haddVal1 halg1_L hvalL_props hvalE'_props hval_norm_E' hval_alg_E' ϖ_E' hϖ_E' hBasis_E'
    have hT2_eq_t2 : T₂ = t₂ + 1 :=
      (ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L E' hLE' hPrime νE'
        hνE'_ker hνE'_cond hvalL_props hvalE'_props hval_norm_E' hval_alg_E' hfrob_surj_E'
        ϖ_E' ϖ_L₂ hϖ_norm_E' hϖ_E' hϖ_L₂ hBasis_E'
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
        t₂ w_star₂ ht₂_ge1 hw_star₂_t hw_star₂_nt1 hw_star₂_norm
        htr_bound_E' htr_surj_E' hnorm_exp_E').1
    obtain ⟨htr_incl_M₁', hnorm_add_sub_M₁'⟩ := hQuadNorm L M₁' hLM₁' hdegLM₁'_eq2
    obtain ⟨htr_incl_E', hnorm_add_sub_E'⟩ := hQuadNorm L E' hLE' hdegLE'_eq2
    obtain ⟨_, hOK_decomp_M₁', hodd_M₁'⟩ :=
      ld_wild_dyadic_two_val_bound_and_odd_exact_val F L M₁' hLM₁' hdegLM₁'_eq2
        T₁ t₁ hbM₁'_ge2 hT1_eq_t1 hvalL_props hvalM₁'_props hval_alg_M₁'
        ϖ_M₁' ϖ_L₁ hϖ_M₁' hϖ_L₁ hBasis_M₁'
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
        htr_bound_M₁' htr_surj_M₁' htr_incl_M₁'
    obtain ⟨h2_ne, h2_val, hchar2⟩ := hodd_M₁' hT1_odd
    obtain ⟨h2_bound_E', hOK_decomp_E', _⟩ :=
      ld_wild_dyadic_two_val_bound_and_odd_exact_val F L E' hLE' hdegLE'_eq2
        T₂ t₂ hbE'_ge2 hT2_eq_t2 hvalL_props hvalE'_props hval_alg_E'
        ϖ_E' ϖ_L₂ hϖ_E' hϖ_L₂ hBasis_E'
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
        htr_bound_E' htr_surj_E' htr_incl_E'
    have hT2_div_le : T₂ / 2 ≤ e := by
      rcases h2_bound_E' with h2_eq0 | h2_le
      · exact False.elim (h2_ne h2_eq0)
      · rw [h2_val] at h2_le
        exact Int.ofNat_le.mp h2_le
    have hT2_eq_2e1 : T₂ = 2 * e + 1 := by omega
    have ht1_eq : t₁ = 2 * e := by omega
    have ht2_eq : t₂ = 2 * e := by omega
    have hval_alg2_M₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x := by
      intro x
      have h := hval_alg_M₁' x
      rw [hdegLM₁'_eq2] at h
      exact h
    have hval_alg2_E' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x := by
      intro x
      have h := hval_alg_E' x
      rw [hdegLE'_eq2] at h
      exact h
    have htr_bound_2e1_M₁' : ∀ y : M₁',
        (y = 0 ∨ (2 * e + 1 : ℤ) ≤ valL F M₁' y) →
        (traceLM F hLM₁' y = 0 ∨ (2 * e + 1 : ℤ) ≤ valL F L (traceLM F hLM₁' y)) := by
      intro y hy
      apply htr_bound_M₁' (2 * e + 1 : ℤ) y
      rcases hy with rfl | hy
      · left; rfl
      · right
        have h_eq : (Module.finrank L (IntermediateField.extendScalars hLM₁') : ℤ) * (2 * e + 1 : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLM₁') - 1 : ℕ) : ℤ) * (t₁ + 1 : ℤ) =
            (2 * e + 1 : ℤ) := by
          rw [hdegLM₁'_eq2, ht1_eq]
          omega
        rw [h_eq]
        exact hy
    have htr_bound_2e1_E' : ∀ y : E',
        (y = 0 ∨ (2 * e + 1 : ℤ) ≤ valL F E' y) →
        (traceLM F hLE' y = 0 ∨ (2 * e + 1 : ℤ) ≤ valL F L (traceLM F hLE' y)) := by
      intro y hy
      apply htr_bound_E' (2 * e + 1 : ℤ) y
      rcases hy with rfl | hy
      · left; rfl
      · right
        have h_eq : (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * (2 * e + 1 : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (t₂ + 1 : ℤ) =
            (2 * e + 1 : ℤ) := by
          rw [hdegLE'_eq2, ht2_eq]
          omega
        rw [h_eq]
        exact hy
    obtain ⟨_, _, hSpecM₁', _⟩ := ld_condExp_and_condExpChar_spec F L ψ hψ νM₁'
    obtain ⟨hνM₁'_triv_T1, ⟨u₁, hu₁_mem0, hu₁_ne⟩⟩ := hSpecM₁' hbM₁'_ne0
    have hνM₁'_triv : ∀ u ∈ unitGroup F L (2 * e + 1), νM₁' u = 1 := by
      rw [← hT1_eq_2e1]
      exact hνM₁'_triv_T1
    have hu₁_mem : u₁ ∈ unitGroup F L (2 * e) := by
      have h_sub : condExp F L νM₁' - 1 = 2 * e := by change T₁ - 1 = 2 * e; omega
      rw [← h_sub]
      exact hu₁_mem0
    obtain ⟨_, _, hSpecE', _⟩ := ld_condExp_and_condExpChar_spec F L ψ hψ νE'
    obtain ⟨hνE'_triv_T2, ⟨u₂, hu₂_mem0, hu₂_ne⟩⟩ := hSpecE' hbE'_ne0
    have hνE'_triv : ∀ u ∈ unitGroup F L (2 * e + 1), νE' u = 1 := by
      rw [← hT2_eq_2e1]
      exact hνE'_triv_T2
    have hu₂_mem : u₂ ∈ unitGroup F L (2 * e) := by
      have h_sub : condExp F L νE' - 1 = 2 * e := by change T₂ - 1 = 2 * e; omega
      rw [← h_sub]
      exact hu₂_mem0
    have hw_star₁_2e : w_star₁ ∈ unitGroup F M₁' (2 * e) := ht1_eq ▸ hw_star₁_t
    have hw_star₁_nt1' : w_star₁ ∉ unitGroup F M₁' (2 * e + 1) := ht1_eq ▸ hw_star₁_nt1
    have hw_star₂_2e : w_star₂ ∈ unitGroup F E' (2 * e) := ht2_eq ▸ hw_star₂_t
    have hw_star₂_nt1' : w_star₂ ∉ unitGroup F E' (2 * e + 1) := ht2_eq ▸ hw_star₂_nt1
    have hνM₁'_as := ld_wild_dyadic_odd_cond_norm_one_jump_artin_schreier_triv F L M₁' hLM₁'
      e he νM₁' hνM₁'_ker hνM₁'_triv hvalL_props hvalM₁'_props hval_norm_M₁' hval_alg2_M₁'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker h2_ne h2_val hchar2 hOK_decomp_M₁'
      w_star₁ hw_star₁_2e hw_star₁_nt1' hw_star₁_norm htr_bound_2e1_M₁' htr_incl_M₁'
      (fun x y => (hnorm_add_sub_M₁' x y).1) (fun x y => (hnorm_add_sub_M₁' x y).2)
    have hνE'_as := ld_wild_dyadic_odd_cond_norm_one_jump_artin_schreier_triv F L E' hLE'
      e he νE' hνE'_ker hνE'_triv hvalL_props hvalE'_props hval_norm_E' hval_alg2_E'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker h2_ne h2_val hchar2 hOK_decomp_E'
      w_star₂ hw_star₂_2e hw_star₂_nt1' hw_star₂_norm htr_bound_2e1_E' htr_incl_E'
      (fun x y => (hnorm_add_sub_E' x y).1) (fun x y => (hnorm_add_sub_E' x y).2)
    have hνM₁'_sq : νM₁' ^ 2 = 1 := hdegLE'_eq2 ▸ hνM₁'_pow
    have hνE'_sq : νE' ^ 2 = 1 := hdegLE'_eq2 ▸ hνE'_pow
    have hprod_triv := ld_wild_dyadic_odd_cond_prod_triv_on_jump_unitGroup F L e he
      hvalL_props k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      h2_ne h2_val hchar2 νM₁' νE' hνM₁'_sq hνE'_sq hνM₁'_triv hνE'_triv
      u₁ hu₁_mem hu₁_ne u₂ hu₂_mem hu₂_ne hνM₁'_as hνE'_as
    have hcond_prod_le : condExp F L (νM₁' * νE') ≤ 2 * e :=
      Nat.sInf_le hprod_triv
    have hcond_prod_eq : condExp F L (νM₁' * νE') = T₂ := by
      have h1 := (hMinM₁' 1 hPrime.one_lt).2
      have hpow1 : νM₁' ^ 1 = νM₁' := by ext x; simp
      rw [hpow1] at h1
      exact h1
    omega

theorem ld_ch12_wild_dyadic_tot_ram_m1_min_or_even_dichotomy (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁') (hGalLM₁' : IsGaloisExt F L M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLM₁') = p F)
    (hp2 : p F = 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νM₁' : Lˣ →* (Ω F)ˣ)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (ξM₁' θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hξM₁'_cond : ∀ u ∈ unitGroup F M₁' (condExp F M₁' ξM₁'), ξM₁' u = 1)
    (hθM₁'_cond : ∀ u ∈ unitGroup F M₁' (condExp F M₁' θM₁'), θM₁' u = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (hσ₀_L : ∀ x : L, σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_twist : ∀ z : M₁'ˣ, θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z) = ξM₁' z * θM₁' z) :
    2 ≤ condExp F M₁' ξM₁' →
    condExp F M₁' ξM₁' + condExp F L νM₁' - 1 ≤ condExp F M₁' θM₁' ∧
    (condExp F M₁' ξM₁' + condExp F L νM₁' ≤ condExp F M₁' θM₁' →
      (condExp F M₁' θM₁' - condExp F L νM₁') % 2 = 0) :=
by
  intro hbξ_ge2
  let p : ℕ := Module.finrank L (IntermediateField.extendScalars hLM₁')
  let bM : ℕ := condExp F L νM₁'
  let bξ : ℕ := condExp F M₁' ξM₁'
  let m₁ : ℕ := condExp F M₁' θM₁'
  let mM : ℕ := bξ + bM - 1
  have hp_eq2 : p = 2 := hWild.trans hp2
  have hp_pos : 0 < p := hPrime.pos
  let A' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM₁'
  haveI : FiniteDimensional F A' := ‹FiniteDimensional F M₁'›
  haveI : IsScalarTower F L A' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L A' := Module.Finite.of_restrictScalars_finite F L A'
  letI : Module L L := Semiring.toModule

  
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalM_props := ld_valL_and_unitGroup_props F M₁'
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L
      hvalL_props.1 hvalL_props.2.1 hvalL_props.2.2.1 hvalL_props.2.2.2.1
      hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1 S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  have hRam : bM ≠ 0 := by omega
  obtain ⟨_, _, _, hval_norm, hval_alg, hfrob_surj, _, _,
    ϖ_M, ϖ_L, hϖ_norm, hϖ_M, hϖ_L, hBasis⟩ :=
    ld_wild_total_ramification_and_power_basis F L M₁' hLM₁' hPrime νM₁'
      hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond hRam hWild
      haddVal1 haddVal_mul halg1 hvalL_props hvalM_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨G, hGroupG, hFinG, act, t, w_star, hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, hact_faithful, hact_val, hact_trace, hact_norm,
    ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm, hjump⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L M₁' hLM₁' hGalLM₁' hPrime hWild
      haddVal1 halg1 hvalL_props hvalM_props hval_norm hval_alg ϖ_M hϖ_M hBasis
  letI : Group G := hGroupG
  letI : Fintype G := hFinG
  obtain ⟨htr_bound, htr_surj⟩ :=
    ld_wild_euler_lagrange_trace_formula F L M₁' hLM₁' hPrime
      hvalL_props hvalM_props hval_alg ϖ_M hϖ_M hBasis
      G act hcard_G hact_one hact_mul hact_ring hact_incl hact_trace t hjump
  have hnorm_exp :=
    ld_wild_free_orbit_norm_expansion F L M₁' hLM₁' hPrime hvalM_props
      G act hcard_G hact_one hact_mul hact_ring hact_val hact_trace hact_norm
  obtain ⟨hbM_eq, _, _, _, _, _⟩ :=
    ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L M₁' hLM₁' hPrime νM₁'
      hνM₁'_ker hνM₁'_cond hvalL_props hvalM_props hval_norm hval_alg hfrob_surj
      ϖ_M ϖ_L hϖ_norm hϖ_M hϖ_L hBasis
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t w_star ht_ge1 hw_star_t hw_star_nt1 hw_star_norm htr_bound htr_surj hnorm_exp
  obtain ⟨hact_shift, _, _, _⟩ :=
    ld_wild_galois_action_shift_and_euler_top_trace F L M₁' hLM₁' hPrime
      hvalM_props hval_alg ϖ_M hϖ_M hBasis
      G act hcard_G hact_one hact_mul hact_ring hact_incl hact_val hact_trace t hjump

  
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalM_props with ⟨hval0_M, hval1_M, hval_neg1_M, hval_neg_M, hval_mul_M,
    hval_inv_M, hval_surj_M, hval_add_M, hunit0_M, hunit_ge1_M, hunit_val0_M⟩

  
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_pow_M : ∀ (y : M₁') (n : ℕ), y ≠ 0 → valL F M₁' (y ^ n) = (n : ℤ) * valL F M₁' y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_M]
    | succ n ih =>
      rw [pow_succ, hval_mul_M (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_mul_ge_M : ∀ (k₁ k₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F M₁' x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F M₁' y := hy.resolve_left hy0
        rw [hval_mul_M x y hx0 hy0]
        omega
  have hval_le_M : ∀ {k₁ k₂ : ℤ} {y : M₁'},
      k₁ ≤ k₂ → (y = 0 ∨ k₂ ≤ valL F M₁' y) → (y = 0 ∨ k₁ ≤ valL F M₁' y) := by
    intro k₁ k₂ y hle hy
    rcases hy with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hval_finset_sum_M : ∀ {α : Type} (S : Finset α) (f : α → M₁') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M₁' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M₁' (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_M k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hunit_anti_M : ∀ {a b : ℕ}, a ≤ b → ∀ {w : M₁'ˣ},
      w ∈ unitGroup F M₁' b → w ∈ unitGroup F M₁' a := by
    intro a b hab w hw
    by_cases ha0 : a = 0
    · subst ha0
      exact (hunit0_M w).mpr (hunit_val0_M b w hw)
    · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      have hb1 : 1 ≤ b := le_trans ha1 hab
      rw [hunit_ge1_M a ha1 w]
      rcases (hunit_ge1_M b hb1 w).mp hw with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by omega) hge)
  have h1_add_ne_zero_M : ∀ {y : M₁'}, (y = 0 ∨ 1 ≤ valL F M₁' y) → 1 + y ≠ 0 := by
    intro y hy h0
    have h1_eq : (1 : M₁') = -y := eq_neg_of_add_eq_zero_left h0
    rcases hy with hy0 | hge
    · rw [hy0, neg_zero] at h1_eq
      exact one_ne_zero h1_eq
    · have hv : valL F M₁' (1 : M₁') = valL F M₁' y := by rw [h1_eq, hval_neg_M]
      rw [hval1_M] at hv
      omega
  have hϖ_L_pow_val : ∀ m : ℕ, valL F L (((ϖ_L ^ m : Lˣ) : L)) = (m : ℤ) := by
    intro m
    rw [Units.val_pow_eq_pow_val, hval_pow_L (ϖ_L : L) m (Units.ne_zero ϖ_L), hϖ_L, mul_one]
  have hϖ_L_pow_inv_val : ∀ m : ℕ, valL F L ((((ϖ_L ^ m : Lˣ)⁻¹ : Lˣ) : L)) = -(m : ℤ) := by
    intro m
    rw [hval_inv_L (ϖ_L ^ m), hϖ_L_pow_val m]
  have hval_inc_ge : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) →
        (IntermediateField.inclusion hLM₁' x = 0 ∨
          (p : ℤ) * k ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x)) := by
    intro k x hx
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, map_zero])
    · right
      rw [hval_alg x]
      have hge := hx.resolve_left hx0
      nlinarith
  have hResSurj : ∀ y : M₁', (y = 0 ∨ 0 ≤ valL F M₁' y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLM₁' x = 0 ∨
          1 ≤ valL F M₁' (y - IntermediateField.inclusion hLM₁' x)) := by
    intro y hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis y
    let t_term (i : Fin p) : M₁' := IntermediateField.inclusion hLM₁' (c i) * ((ϖ_M : M₁') ^ (i : ℕ))
    let i_zero : Fin p := ⟨0, hp_pos⟩
    let x : L := c i_zero
    have hc_all := (hval_iff 0).mp hy
    have hx : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc_all i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (p : ℤ) * valL F L x + (0 : ℤ) at hge
        nlinarith
    have ht_zero : t_term i_zero = IntermediateField.inclusion hLM₁' x := by
      dsimp [t_term, i_zero, x]
      rw [pow_zero, mul_one]
    have hy_sub : y - IntermediateField.inclusion hLM₁' x =
        ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i_zero, t_term i := by
      have hsum := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) t_term
        (Finset.mem_univ i_zero)).symm
      rw [ht_zero] at hsum
      rw [hy_eq]
      change (∑ i : Fin p, t_term i) - IntermediateField.inclusion hLM₁' x = _
      rw [hsum, add_sub_cancel_left]
    refine ⟨x, hx, ?_⟩
    rw [hy_sub]
    apply hval_finset_sum_M ((Finset.univ : Finset (Fin p)).erase i_zero) t_term 1
    intro i hi
    have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
    have hi_ge1 : (1 : ℤ) ≤ (i.1 : ℤ) := by
      have hne0 : i.1 ≠ 0 := fun h0 => hi_ne (Fin.ext h0)
      omega
    by_cases hci0 : c i = 0
    · left
      dsimp [t_term]
      rw [hci0, map_zero, zero_mul]
    · right
      have hci_ge : 0 ≤ (p : ℤ) * valL F L (c i) + (i.1 : ℤ) := (hc_all i).resolve_left hci0
      have hi_lt : (i.1 : ℤ) < (p : ℤ) := Nat.cast_lt.mpr i.2
      have hci_val_ge0 : 0 ≤ valL F L (c i) := by nlinarith
      have hinc_ne : IntermediateField.inclusion hLM₁' (c i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hLM₁').toRingHom).ne hci0
      have hpow_ne : ((ϖ_M : M₁') ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_M)
      dsimp [t_term]
      rw [hval_mul_M _ _ hinc_ne hpow_ne, hval_alg (c i),
        hval_pow_M (ϖ_M : M₁') (i : ℕ) (Units.ne_zero ϖ_M), hϖ_M, mul_one]
      nlinarith

  
  let fromExtendScalars : A' →+* M₁' :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLM₁').mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let φ_act : G → (M₁' →+* M₁') := fun γ =>
    { toFun := act γ
      map_one' := (hact_ring γ).2.1
      map_mul' := fun y₁ y₂ => ((hact_ring γ).2.2 y₁ y₂).2.1
      map_zero' := (hact_ring γ).1
      map_add' := fun y₁ y₂ => ((hact_ring γ).2.2 y₁ y₂).1 }
  have hφ_act_apply : ∀ (γ : G) (y : M₁'), φ_act γ y = act γ y := fun _ _ => rfl
  let φ_G : G → (A' →ₐ[L] A') := fun γ =>
    { (toExtendScalars F hLM₁').comp ((φ_act γ).comp fromExtendScalars) with
      commutes' := fun x => by
        change toExtendScalars F hLM₁' (act γ (IntermediateField.inclusion hLM₁' x)) =
          algebraMap L A' x
        rw [hact_incl γ x]
        rfl }
  have hφG_inj : Function.Injective φ_G := by
    intro γ₁ γ₂ h_eq
    have h1 : γ₁ * γ₂⁻¹ = 1 := by
      apply hact_faithful (γ₁ * γ₂⁻¹)
      intro y
      have h_app : φ_G γ₁ (toExtendScalars F hLM₁' (act γ₂⁻¹ y)) =
          φ_G γ₂ (toExtendScalars F hLM₁' (act γ₂⁻¹ y)) :=
        congrArg (fun f : A' →ₐ[L] A' => f (toExtendScalars F hLM₁' (act γ₂⁻¹ y))) h_eq
      have h_from : act γ₁ (act γ₂⁻¹ y) = act γ₂ (act γ₂⁻¹ y) :=
        congrArg fromExtendScalars h_app
      rw [← hact_mul, ← hact_mul, mul_inv_cancel, hact_one] at h_from
      exact h_from
    exact mul_inv_eq_one.mp h1
  have hcard_le1 : Fintype.card G ≤ Fintype.card (A' →ₐ[L] A') :=
    Fintype.card_le_of_injective φ_G hφG_inj
  have hcard_le2 : Fintype.card (A' →ₐ[L] A') ≤ p := @AlgHom.card_le L A' _ _ _ _
  have hcard_eq : Fintype.card G = Fintype.card (A' →ₐ[L] A') := by omega
  have hφG_bij : Function.Bijective φ_G :=
    (Fintype.bijective_iff_injective_and_card φ_G).mpr ⟨hφG_inj, hcard_eq⟩
  let f_σ : A' →ₐ[L] A' :=
    { (toExtendScalars F hLM₁').comp (σ₀.toRingEquiv.toRingHom.comp fromExtendScalars) with
      commutes' := fun x => by
        change toExtendScalars F hLM₁' (σ₀ (IntermediateField.inclusion hLM₁' x)) =
          algebraMap L A' x
        rw [hσ₀_L x]
        rfl }
  obtain ⟨τ, hτ_eq⟩ := hφG_bij.2 f_σ
  have hσ_act : ∀ y : M₁', σ₀ y = act τ y := by
    intro y
    have h1 : φ_G τ (toExtendScalars F hLM₁' y) = f_σ (toExtendScalars F hLM₁' y) :=
      congrArg (fun f : A' →ₐ[L] A' => f (toExtendScalars F hLM₁' y)) hτ_eq
    exact (congrArg fromExtendScalars h1).symm

  let uM : ℕ := bξ - 1
  have huM_ge1 : 1 ≤ uM := by omega
  have hbξ_ne0 : bξ ≠ 0 := by omega
  obtain ⟨y₀, hy₀_mem, hy₀_ne⟩ :=
    ((ld_condExp_and_condExpChar_spec F M₁' (traceChar F hLM₁' ψ) hψM₁' ξM₁').2.2.1 hbξ_ne0).2
  have hτ_ne1 : τ ≠ 1 := by
    intro h1
    have hσ_y₀ : Units.map σ₀.toRingEquiv.toMonoidHom y₀ = y₀ := by
      apply Units.ext
      change σ₀ (y₀ : M₁') = (y₀ : M₁')
      rw [hσ_act (y₀ : M₁'), h1, hact_one]
    have htw := hσ₀_twist y₀
    rw [hσ_y₀] at htw
    have htw1 : θM₁' y₀ * (θM₁' y₀)⁻¹ = ξM₁' y₀ * θM₁' y₀ * (θM₁' y₀)⁻¹ :=
      congrArg (· * (θM₁' y₀)⁻¹) htw
    rw [mul_inv_cancel, mul_inv_cancel_right] at htw1
    exact hy₀_ne htw1.symm
  let z_y₀ : M₁' := (y₀ : M₁') - 1
  have hzy₀_val : z_y₀ = 0 ∨ (uM : ℤ) ≤ valL F M₁' z_y₀ := by
    rcases (hunit_ge1_M uM huM_ge1 y₀).mp hy₀_mem with h1 | hge
    · exact Or.inl (sub_eq_zero.mpr h1)
    · exact Or.inr hge
  have hshift_y₀ : act τ z_y₀ - z_y₀ = 0 ∨
      (uM : ℤ) + (t : ℤ) ≤ valL F M₁' (act τ z_y₀ - z_y₀) :=
    hact_shift τ z_y₀ (uM : ℤ) hzy₀_val
  have hact_zy₀_eq : act τ z_y₀ - z_y₀ = σ₀ (y₀ : M₁') - (y₀ : M₁') := by
    dsimp [z_y₀]
    rw [hσ_act (y₀ : M₁')]
    change φ_act τ ((y₀ : M₁') - 1) - ((y₀ : M₁') - 1) = act τ (y₀ : M₁') - (y₀ : M₁')
    rw [map_sub (φ_act τ), map_one (φ_act τ), hφ_act_apply]
    ring
  let w₀ : M₁'ˣ := (Units.map σ₀.toRingEquiv.toMonoidHom y₀) * y₀⁻¹
  have hw₀_sub : (w₀ : M₁') - 1 = (act τ z_y₀ - z_y₀) * ((y₀⁻¹ : M₁'ˣ) : M₁') := by
    change σ₀ (y₀ : M₁') * ((y₀⁻¹ : M₁'ˣ) : M₁') - 1 = _
    rw [hact_zy₀_eq, sub_mul, Units.mul_inv]
  have hy₀_inv_val0 : ((y₀⁻¹ : M₁'ˣ) : M₁') = 0 ∨ 0 ≤ valL F M₁' ((y₀⁻¹ : M₁'ˣ) : M₁') := by
    right
    rw [hval_inv_M y₀, hunit_val0_M uM y₀ hy₀_mem, neg_zero]
  have hmM_sub1_eq : ((mM - 1 : ℕ) : ℤ) = (uM : ℤ) + (t : ℤ) := by omega
  have hmM_sub1_ge1 : 1 ≤ mM - 1 := by omega
  have hw₀_mem : w₀ ∈ unitGroup F M₁' (mM - 1) := by
    rw [hunit_ge1_M (mM - 1) hmM_sub1_ge1 w₀, hw₀_sub]
    have hmul := hval_mul_ge_M ((uM : ℤ) + (t : ℤ)) 0
      (act τ z_y₀ - z_y₀) ((y₀⁻¹ : M₁'ˣ) : M₁') hshift_y₀ hy₀_inv_val0
    rw [add_zero, ← hmM_sub1_eq] at hmul
    rcases hmul with h0 | hge
    · exact Or.inl (sub_eq_zero.mp (hw₀_sub.trans h0))
    · exact Or.inr hge
  have hθM₁'_w₀ : θM₁' w₀ = ξM₁' y₀ := by
    change θM₁' ((Units.map σ₀.toRingEquiv.toMonoidHom y₀) * y₀⁻¹) = ξM₁' y₀
    rw [map_mul, map_inv, hσ₀_twist y₀, mul_inv_cancel_right]
  have hmM_le : mM ≤ m₁ := by
    by_contra hlt
    have hle : m₁ ≤ mM - 1 := by omega
    have hw₀_cond : w₀ ∈ unitGroup F M₁' m₁ := hunit_anti_M hle hw₀_mem
    have h1 : θM₁' w₀ = 1 := hθM₁'_cond w₀ hw₀_cond
    rw [hθM₁'_w₀] at h1
    exact hy₀_ne h1

  
  refine ⟨hmM_le, fun hm₁_ge => ?_⟩
  rcases Nat.mod_two_eq_zero_or_one (m₁ - bM) with h_even | h_odd
  · exact h_even
  · exfalso
    let k : ℕ := m₁ - 1
    let q : ℕ := k - t
    let m₀ : ℕ := q / 2
    let i₀ : ℕ := 1
    have hq_eq : q = m₁ - bM := by omega
    have hq_ge : bξ ≤ q := by omega
    have hq_ge2 : 2 ≤ q := by omega
    have hk_ge1 : 1 ≤ k := by omega
    have hq_div : p * m₀ + i₀ = q := by
      change p * (q / 2) + 1 = q
      rw [hp_eq2]
      omega
    have hk_eq : p * m₀ + i₀ + t = k := by
      rw [hq_div]
      omega
    have hm₁_ne0 : m₁ ≠ 0 := by omega
    obtain ⟨w, hw, hw_ne1⟩ :=
      ((ld_condExp_and_condExpChar_spec F M₁' (traceChar F hLM₁' ψ) hψM₁' θM₁').2.2.1 hm₁_ne0).2
    let z : M₁' := (w : M₁') - 1
    have hz_val : z = 0 ∨ (k : ℤ) ≤ valL F M₁' z := by
      rcases (hunit_ge1_M k hk_ge1 w).mp hw with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    let π : M₁' := (ϖ_M : M₁')
    have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_M
    let δ₁ : M₁' := act τ π - π
    have hδ₁_ne0 : δ₁ ≠ 0 := by
      intro h0
      exact (hjump τ hτ_ne1).1 (sub_eq_zero.mpr (sub_eq_zero.mp h0).symm)
    have hδ₁_val : valL F M₁' δ₁ = (t + 1 : ℤ) := by
      have hneg : δ₁ = -(π - act τ π) := by dsimp [δ₁]; ring
      rw [hneg, hval_neg_M, (hjump τ hτ_ne1).2]
    let δ_i : M₁' := act τ (π ^ i₀) - π ^ i₀
    have hδi_eq : δ_i = δ₁ := by
      dsimp [δ_i, i₀, δ₁]
      rw [pow_one]
    have hδi_ne0 : δ_i ≠ 0 := hδi_eq ▸ hδ₁_ne0
    have hδi_val : valL F M₁' δ_i = (i₀ : ℤ) + (t : ℤ) := by
      rw [hδi_eq, hδ₁_val]
      dsimp [i₀]
      omega
    let u_δ : M₁'ˣ := Units.mk0 δ_i hδi_ne0
    have huδ_coe : (u_δ : M₁') = δ_i := Units.val_mk0 hδi_ne0
    have huδ_inv_val : ((u_δ⁻¹ : M₁'ˣ) : M₁') = 0 ∨
        -((i₀ : ℤ) + (t : ℤ)) ≤ valL F M₁' ((u_δ⁻¹ : M₁'ˣ) : M₁') := by
      right
      rw [hval_inv_M u_δ, huδ_coe, hδi_val]
    let ϖL_m : L := ((ϖ_L ^ m₀ : Lˣ) : L)
    let ϖL_m_inv : L := (((ϖ_L ^ m₀ : Lˣ)⁻¹ : Lˣ) : L)
    have hϖL_m_val : IntermediateField.inclusion hLM₁' ϖL_m = 0 ∨
        (p : ℤ) * (m₀ : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' ϖL_m) := by
      right
      rw [hval_alg ϖL_m, hϖ_L_pow_val m₀]
    have hϖL_m_inv_val : IntermediateField.inclusion hLM₁' ϖL_m_inv = 0 ∨
        -((p : ℤ) * (m₀ : ℤ)) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' ϖL_m_inv) := by
      right
      rw [hval_alg ϖL_m_inv, hϖ_L_pow_inv_val m₀]
      linarith
    let z₀ : M₁' := z * ((u_δ⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' ϖL_m_inv
    have hz₀_val : z₀ = 0 ∨ 0 ≤ valL F M₁' z₀ := by
      have h1 := hval_mul_ge_M (k : ℤ) (-((i₀ : ℤ) + (t : ℤ))) z ((u_δ⁻¹ : M₁'ˣ) : M₁')
        hz_val huδ_inv_val
      have h2 := hval_mul_ge_M ((k : ℤ) + (-((i₀ : ℤ) + (t : ℤ)))) (-((p : ℤ) * (m₀ : ℤ)))
        (z * ((u_δ⁻¹ : M₁'ˣ) : M₁')) (IntermediateField.inclusion hLM₁' ϖL_m_inv) h1 hϖL_m_inv_val
      have hsum0 : (k : ℤ) + (-((i₀ : ℤ) + (t : ℤ))) + (-((p : ℤ) * (m₀ : ℤ))) = 0 := by
        have hk_int : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) + (t : ℤ) = (k : ℤ) := by
          exact_mod_cast hk_eq
        linarith
      rwa [hsum0] at h2
    obtain ⟨x₀, hx₀_val, hdiff_z₀⟩ := hResSurj z₀ hz₀_val
    let y : M₁' := IntermediateField.inclusion hLM₁' (x₀ * ϖL_m) * (π ^ i₀)
    have hx₀_ϖ_val : x₀ * ϖL_m = 0 ∨ (m₀ : ℤ) ≤ valL F L (x₀ * ϖL_m) := by
      have h := hval_mul_ge_L 0 (m₀ : ℤ) x₀ ϖL_m hx₀_val
        (Or.inr (by rw [hϖ_L_pow_val m₀]))
      rwa [zero_add] at h
    have hinc_x₀_ϖ : IntermediateField.inclusion hLM₁' (x₀ * ϖL_m) = 0 ∨
        (p : ℤ) * (m₀ : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (x₀ * ϖL_m)) :=
      hval_inc_ge (m₀ : ℤ) (x₀ * ϖL_m) hx₀_ϖ_val
    have hπ_i₀_val : π ^ i₀ = 0 ∨ (i₀ : ℤ) ≤ valL F M₁' (π ^ i₀) := by
      right
      rw [hval_pow_M π i₀ hπ_ne0, hϖ_M, mul_one]
    have hy_val : y = 0 ∨ (q : ℤ) ≤ valL F M₁' y := by
      have h := hval_mul_ge_M ((p : ℤ) * (m₀ : ℤ)) (i₀ : ℤ)
        (IntermediateField.inclusion hLM₁' (x₀ * ϖL_m)) (π ^ i₀) hinc_x₀_ϖ hπ_i₀_val
      have hq_int : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) = (q : ℤ) := by exact_mod_cast hq_div
      rwa [hq_int] at h
    have h1y_ne0 : 1 + y ≠ 0 := h1_add_ne_zero_M (hval_le_M (by omega) hy_val)
    let u : M₁'ˣ := Units.mk0 (1 + y) h1y_ne0
    have hu_coe : (u : M₁') = 1 + y := Units.val_mk0 h1y_ne0
    have hu_q : u ∈ unitGroup F M₁' q := by
      rw [hunit_ge1_M q (by omega) u]
      have hsub : (u : M₁') - 1 = y := by rw [hu_coe]; ring
      rw [hsub]
      rcases hy_val with h0 | hge
      · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
      · exact Or.inr hge
    have hξM₁'_u : ξM₁' u = 1 := hξM₁'_cond u (hunit_anti_M hq_ge hu_q)
    have hσy_sub : σ₀ y - y = IntermediateField.inclusion hLM₁' (x₀ * ϖL_m) * δ_i := by
      rw [hσ_act y]
      change φ_act τ (IntermediateField.inclusion hLM₁' (x₀ * ϖL_m) * (π ^ i₀)) -
        IntermediateField.inclusion hLM₁' (x₀ * ϖL_m) * (π ^ i₀) = _
      rw [map_mul (φ_act τ), hφ_act_apply, hact_incl τ (x₀ * ϖL_m), hφ_act_apply, ← mul_sub]
    have hδi_val_ge : δ_i = 0 ∨ (i₀ : ℤ) + (t : ℤ) ≤ valL F M₁' δ_i :=
      Or.inr (by rw [show valL F M₁' δ_i = (i₀ : ℤ) + (t : ℤ) from hδi_val])
    have hσy_sub_val : σ₀ y - y = 0 ∨ (k : ℤ) ≤ valL F M₁' (σ₀ y - y) := by
      rw [hσy_sub]
      have h := hval_mul_ge_M ((p : ℤ) * (m₀ : ℤ)) ((i₀ : ℤ) + (t : ℤ))
        (IntermediateField.inclusion hLM₁' (x₀ * ϖL_m)) δ_i hinc_x₀_ϖ hδi_val_ge
      have hk_int : (p : ℤ) * (m₀ : ℤ) + ((i₀ : ℤ) + (t : ℤ)) = (k : ℤ) := by
        have h1 : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) + (t : ℤ) = (k : ℤ) := by
          exact_mod_cast hk_eq
        linarith
      rwa [hk_int] at h
    have hz_sub_σy : z - (σ₀ y - y) =
        (z₀ - IntermediateField.inclusion hLM₁' x₀) *
          IntermediateField.inclusion hLM₁' ϖL_m * δ_i := by
      have hϖ_inv_mul : IntermediateField.inclusion hLM₁' ϖL_m_inv *
          IntermediateField.inclusion hLM₁' ϖL_m = 1 := by
        rw [← map_mul (IntermediateField.inclusion hLM₁')]
        change IntermediateField.inclusion hLM₁'
          ((((ϖ_L ^ m₀ : Lˣ)⁻¹ * (ϖ_L ^ m₀ : Lˣ) : Lˣ) : L)) = 1
        rw [inv_mul_cancel, Units.val_one, map_one]
      have huδ_inv_mul : ((u_δ⁻¹ : M₁'ˣ) : M₁') * δ_i = 1 := by
        rw [← huδ_coe]
        exact Units.inv_mul u_δ
      have hz_recover : z₀ * IntermediateField.inclusion hLM₁' ϖL_m * δ_i = z := by
        calc z₀ * IntermediateField.inclusion hLM₁' ϖL_m * δ_i
          _ = z * ((u_δ⁻¹ : M₁'ˣ) : M₁') *
              (IntermediateField.inclusion hLM₁' ϖL_m_inv *
                IntermediateField.inclusion hLM₁' ϖL_m) * δ_i := by
              dsimp [z₀]; ring
          _ = z * (((u_δ⁻¹ : M₁'ˣ) : M₁') * δ_i) := by rw [hϖ_inv_mul]; ring
          _ = z := by rw [huδ_inv_mul, mul_one]
      have hσy_recover : IntermediateField.inclusion hLM₁' x₀ *
          IntermediateField.inclusion hLM₁' ϖL_m * δ_i = σ₀ y - y := by
        rw [hσy_sub, map_mul (IntermediateField.inclusion hLM₁')]
      calc z - (σ₀ y - y)
        _ = z₀ * IntermediateField.inclusion hLM₁' ϖL_m * δ_i -
            IntermediateField.inclusion hLM₁' x₀ *
              IntermediateField.inclusion hLM₁' ϖL_m * δ_i := by
            rw [hz_recover, hσy_recover]
        _ = (z₀ - IntermediateField.inclusion hLM₁' x₀) *
            IntermediateField.inclusion hLM₁' ϖL_m * δ_i := by ring
    have hz_sub_σy_val : z - (σ₀ y - y) = 0 ∨
        ((k + 1 : ℕ) : ℤ) ≤ valL F M₁' (z - (σ₀ y - y)) := by
      rw [hz_sub_σy]
      have h1 := hval_mul_ge_M 1 ((p : ℤ) * (m₀ : ℤ))
        (z₀ - IntermediateField.inclusion hLM₁' x₀)
        (IntermediateField.inclusion hLM₁' ϖL_m) hdiff_z₀ hϖL_m_val
      have h2 := hval_mul_ge_M (1 + (p : ℤ) * (m₀ : ℤ)) ((i₀ : ℤ) + (t : ℤ))
        ((z₀ - IntermediateField.inclusion hLM₁' x₀) * IntermediateField.inclusion hLM₁' ϖL_m)
        δ_i h1 hδi_val_ge
      have hkp1_int : 1 + (p : ℤ) * (m₀ : ℤ) + ((i₀ : ℤ) + (t : ℤ)) = ((k + 1 : ℕ) : ℤ) := by
        have hk_int : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) + (t : ℤ) = (k : ℤ) := by
          exact_mod_cast hk_eq
        push_cast
        linarith
      rwa [hkp1_int] at h2
    let v : M₁'ˣ := (Units.map σ₀.toRingEquiv.toMonoidHom u) * u⁻¹
    let w' : M₁'ˣ := w * v⁻¹
    have hu_inv_val0 : ((u⁻¹ : M₁'ˣ) : M₁') = 0 ∨ 0 ≤ valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') := by
      right
      rw [hval_inv_M u, hunit_val0_M q u hu_q, neg_zero]
    have hquad_val : (σ₀ y - y) * y * ((u⁻¹ : M₁'ˣ) : M₁') = 0 ∨
        ((k + 1 : ℕ) : ℤ) ≤ valL F M₁' ((σ₀ y - y) * y * ((u⁻¹ : M₁'ˣ) : M₁')) := by
      have h1 := hval_mul_ge_M (k : ℤ) (q : ℤ) (σ₀ y - y) y hσy_sub_val hy_val
      have h2 := hval_mul_ge_M ((k : ℤ) + (q : ℤ)) 0 ((σ₀ y - y) * y) ((u⁻¹ : M₁'ˣ) : M₁')
        h1 hu_inv_val0
      exact hval_le_M (by push_cast; omega) h2
    have hw_sub_v : (w : M₁') - (v : M₁') =
        (z - (σ₀ y - y)) + (σ₀ y - y) * y * ((u⁻¹ : M₁'ˣ) : M₁') := by
      have hw_eq : (w : M₁') = 1 + z := by dsimp [z]; ring
      have hv_eq : (v : M₁') = (1 + σ₀ y) * ((u⁻¹ : M₁'ˣ) : M₁') := by
        change σ₀ (u : M₁') * ((u⁻¹ : M₁'ˣ) : M₁') = _
        rw [hu_coe, map_add σ₀, map_one σ₀]
      have hu_inv_mul : (1 + y) * ((u⁻¹ : M₁'ˣ) : M₁') = 1 := by
        rw [← hu_coe]
        exact Units.mul_inv u
      rw [hw_eq, hv_eq]
      linear_combination -(1 + (σ₀ y - y)) * hu_inv_mul
    have hw_sub_v_val : (w : M₁') - (v : M₁') = 0 ∨
        ((k + 1 : ℕ) : ℤ) ≤ valL F M₁' ((w : M₁') - (v : M₁')) := by
      rw [hw_sub_v]
      exact hval_add_M (((k + 1 : ℕ) : ℤ)) _ _ hz_sub_σy_val hquad_val
    have hv_inv_val0 : ((v⁻¹ : M₁'ˣ) : M₁') = 0 ∨ 0 ≤ valL F M₁' ((v⁻¹ : M₁'ˣ) : M₁') := by
      right
      rw [hval_inv_M v]
      have hσu_ne0 : σ₀ (u : M₁') ≠ 0 :=
        Units.ne_zero (Units.map σ₀.toRingEquiv.toMonoidHom u)
      have hu_val0 : valL F M₁' (u : M₁') = 0 := hunit_val0_M q u hu_q
      have hσu_val0 : valL F M₁' (σ₀ (u : M₁')) = 0 := by
        rw [hσ_act (u : M₁'), hact_val τ (u : M₁'), hu_val0]
      change 0 ≤ - valL F M₁' (σ₀ (u : M₁') * ((u⁻¹ : M₁'ˣ) : M₁'))
      rw [hval_mul_M (σ₀ (u : M₁')) ((u⁻¹ : M₁'ˣ) : M₁') hσu_ne0 (Units.ne_zero u⁻¹),
        hσu_val0, hval_inv_M u, hu_val0]
      omega
    have hw'_sub : (w' : M₁') - 1 = ((w : M₁') - (v : M₁')) * ((v⁻¹ : M₁'ˣ) : M₁') := by
      change (w : M₁') * ((v⁻¹ : M₁'ˣ) : M₁') - 1 = _
      rw [sub_mul, Units.mul_inv]
    have hw'_mem : w' ∈ unitGroup F M₁' (k + 1) := by
      rw [hunit_ge1_M (k + 1) (by omega) w', hw'_sub]
      have hmul := hval_mul_ge_M (((k + 1 : ℕ) : ℤ)) 0
        ((w : M₁') - (v : M₁')) ((v⁻¹ : M₁'ˣ) : M₁') hw_sub_v_val hv_inv_val0
      rw [add_zero] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp (hw'_sub.trans h0))
      · exact Or.inr hge
    have hθw' : θM₁' w' = θM₁' w := by
      have hθv : θM₁' v = 1 := by
        change θM₁' ((Units.map σ₀.toRingEquiv.toMonoidHom u) * u⁻¹) = 1
        rw [map_mul, map_inv, hσ₀_twist u, hξM₁'_u, one_mul, mul_inv_cancel]
      change θM₁' (w * v⁻¹) = θM₁' w
      rw [map_mul, map_inv, hθv, inv_one, mul_one]
    have hkp1_eq : k + 1 = m₁ := by omega
    rw [hkp1_eq] at hw'_mem
    have hθw'_eq1 : θM₁' w' = 1 := hθM₁'_cond w' hw'_mem
    rw [hθw'] at hθw'_eq1
    exact hw_ne1 hθw'_eq1

theorem ld_ch12_wild_dyadic_tot_ram_cond_sum_and_break_parity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hνE'M₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (hNormFactor : ∀ x : Lˣ, ∃ (y : E'ˣ) (z : M₁'ˣ),
      x = Units.map (normLM F hLE') y * Units.map (normLM F hLM₁') z)
    (hχE'_comp : (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁)
    (hχM₁'_comp : (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
      (recChar F rec K₁ χK₁) u = 1)
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
        (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
      condExp F E' (ξE' ^ j * recChar F rec E' χE') =
        condExp F E' (recChar F rec E' χE') ∧
      tateEps F E' (ξE' ^ j * recChar F rec E' χE') (traceChar F hLE' ψ) =
        tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
