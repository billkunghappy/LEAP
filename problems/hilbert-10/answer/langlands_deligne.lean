    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    let ψM₁' := traceChar F hLM₁' ψ
    let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
    ∀ x : M₁', (x = 0 ∨ (q : ℤ) ≤ valL F M₁' x) →
      ∀ hx : 1 - x ≠ 0,
        (((ξM₁' (Units.mk0 (1 - x) hx) : Ω F)⁻¹) ^ 2) ^ k =
          ψM₁' (2 * IntermediateField.inclusion hLM₁' (((c_νE'⁻¹ : Lˣ) : L)) *
            (1 - s) * P_M₁' x) :=
by
  intro bE' bM₁' t₁ ct q ξM₁' ψM₁' P_M₁'
  let δ : ℕ := bE' - bM₁'
  let m₁ : ℕ := 2 * bM₁' - 1 + p * δ
  let q₁ : ℕ := (m₁ + p - 1) / p
  let R : ℕ := t₁ + 1 - ct + (p - 1) * δ
  let nL : ℤ := condExpChar F L ψ
  let nM₁' : ℤ := condExpChar F M₁' ψM₁'
  let α : L := ((c_νE'⁻¹ : Lˣ) : L)
  let α_M₁' : M₁' := IntermediateField.inclusion hLM₁' α
  
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁, bM₁']; omega
  have hdiv_ct : p * ct + (t₁ + p - 1) % p = t₁ + p - 1 := by
    dsimp [ct]
    exact Nat.div_add_mod (t₁ + p - 1) p
  have hmod_ct : (t₁ + p - 1) % p < p := Nat.mod_lt (t₁ + p - 1) hp_pos
  have ht₁_le_pct : t₁ ≤ p * ct := by omega
  have hpct_ne_t₁ : p * ct ≠ t₁ := by
    intro h_eq
    exact ht₁_ndvd ⟨ct, h_eq.symm⟩
  have hp_ct_ge : t₁ + 1 ≤ p * ct := by omega
  have hct_ge1 : 1 ≤ ct := by
    rcases Nat.eq_zero_or_pos ct with h0 | hpos
    · rw [h0, mul_zero] at hp_ct_ge; omega
    · exact hpos
  have hct_le_t₁ : ct ≤ t₁ := by
    by_contra! hgt
    have hle : t₁ + 1 ≤ ct := by omega
    have hmul1 : p * (t₁ + 1) ≤ p * ct := Nat.mul_le_mul_left p hle
    have hmul2 : 3 * t₁ ≤ p * t₁ := Nat.mul_le_mul_right t₁ hp_ge3
    have hmul3 : p * (t₁ + 1) = p * t₁ + p := by ring
    omega
  have hq_ge1 : 1 ≤ q := by dsimp [q]; omega
  have hm₁_eq : m₁ = 2 * t₁ + 1 + p * δ := by
    dsimp [m₁, t₁, bM₁']
    omega
  have hpq_eq : p * q + t₁ = p * δ + p * ct + t₁ := by
    dsimp [q, δ, bE', bM₁']
    ring
  have hm₁_le_pq_t₁ : m₁ ≤ p * q + t₁ := by omega
  have hq₁_le_q_add_t₁ : q₁ ≤ q + t₁ := by
    have hdiv_q₁ : p * q₁ + (m₁ + p - 1) % p = m₁ + p - 1 := by
      dsimp [q₁]
      exact Nat.div_add_mod (m₁ + p - 1) p
    by_contra! hgt
    have hle : q + t₁ + 1 ≤ q₁ := by omega
    have hmul1 : p * (q + t₁ + 1) ≤ p * q₁ := Nat.mul_le_mul_left p hle
    have hmul2 : 3 * t₁ ≤ p * t₁ := Nat.mul_le_mul_right t₁ hp_ge3
    have hmul3 : p * (q + t₁ + 1) = p * q + p * t₁ + p := by ring
    omega
  have hp1_δ : (p - 1) * δ + δ = p * δ := by
    calc (p - 1) * δ + δ = (p - 1) * δ + 1 * δ := by ring
      _ = (p - 1 + 1) * δ := by rw [← add_mul]
      _ = p * δ := by congr 1; omega
  have hRq_eq : ((R : ℕ) : ℤ) + (q : ℤ) = (m₁ : ℤ) - (t₁ : ℤ) := by
    have hRq_nat : R + q = t₁ + 1 + p * δ := by
      have h1 : R + q = (t₁ + 1 - ct + ct) + ((p - 1) * δ + δ) := by
        dsimp only [R, q, δ]
        ring
      have h2 : t₁ + 1 - ct + ct = t₁ + 1 := Nat.sub_add_cancel (by omega : ct ≤ t₁ + 1)
      rw [h1, h2, hp1_δ]
    have hm₁_nat : m₁ = (R + q) + t₁ := by
      rw [hRq_nat, hm₁_eq]
