      traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a = 0 ∨
        (((p - 1) * t₂ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a) := by
    rcases hΔ_tr_pow with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans h_tr_t₂_le hge)
  have hΔ_tr_low_bE' : ∀ j ∈ Finset.Icc 1 (p - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j)) := by
    intro j hj
    rcases hΔ_tr_low j hj with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans h_tr_bE'_le hge)
  have hΔ_tr_top_bE' :
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        (bE' : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
    rcases hΔ_tr_top with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans h_tr_bE'_le hge)

  
  have hCoeffExtr :=
    ld_ch12_wild_odd_tot_ram_as_coeff_extraction F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd'
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd hp_valK₁
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      hval_LM₁' hval_E'K₁ hval_M₁'K₁ hGalLift
      ϖ_M₁' hϖ_M₁' hBasis_M₁'
      G_M₁' act_M₁' hcard_GM₁' hactM₁'_one hactM₁'_mul hactM₁'_ring
      hactM₁'_incl hactM₁'_val hjump_M₁'
      Δ hΔ_val hΔ_as_t₂ hΔ_basis
  obtain ⟨hTwistedTr, e_Δ, W_as, he_Δ_1, he_Δ_val, he_Δ_poly, he_Δ_cayley, he_Δ_tr_p1,
    hW_as_eq, hW_as_val⟩ :=
    ld_ch12_wild_odd_tot_ram_twisted_trace_and_symm_bounds F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalM₁'K₁ hPrime hp_odd' hdegM₁'K₁
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      htr_LE' htr_E'K₁ hTowerNormTr
      y₁_M₁' hy₁M₁'_tr hy₁M₁'_ne0 hy₁M₁'_val
      hSymm_M₁'K₁ hCayley_M₁'K₁
      Δ hΔ_val hΔ_as_t₂ hΔ_tr_low_t₂ hΔ_tr_top_t₂ hΔ_tr_pow_t₂ hΔ_basis hCoeffExtr
  obtain ⟨Z, s₀, hb_sub_a, hs₀_val, hs₀_approx, hZ0, hZ1, hZl⟩ :=
    ld_ch12_wild_odd_tot_ram_norm_diff_as_expansion F L E' M₁' K₁
      hLE' hE'K₁ hM₁'K₁ hPrime hp_odd'
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hvalE'_props hvalM₁'_props hvalK₁_props
      hval_E'K₁ hval_norm_E'K₁ Δ hΔ_val hΔ_basis hCoeffExtr
      e_Δ he_Δ_val he_Δ_cayley W_as hW_as_eq hW_as_val

  
  have hPrime_E'K₁ : Nat.Prime (Module.finrank E' (IntermediateField.extendScalars hE'K₁)) := by
    rw [hdegE'K₁]; exact hPrime
  have hp_odd_E'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) ≠ 2 := by
    rw [hdegE'K₁]; exact hp_odd'
  have hval_E'K₁' : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * valL F E' y := by
    rw [hdegE'K₁]; exact hval_E'K₁
  have htr_E'K₁' : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * m -
          ((Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 1 : ℕ) : ℤ) *
            ((bM₁' - 1 : ℕ) + 1 : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)) := by
    intro m w hw
    apply htr_E'K₁ m w
    rw [hdegE'K₁] at hw
    have hbM₁'_cast : ((bM₁' - 1 : ℕ) + 1 : ℤ) = (bM₁' : ℤ) := by omega
    rwa [hbM₁'_cast] at hw
  have hSymm_E'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁),
        Fintype.card G = Module.finrank E' (IntermediateField.extendScalars hE'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ (σ τ : G) (w : K₁), act (σ * τ) w = act σ (act τ w)) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (y : E'),
          act σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y) →
        (∀ (σ : G) (w : K₁), valL F K₁ (act σ w) = valL F K₁ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G, act σ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G, act σ w) →
        let p := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
        ∃ s : K₁ → ℕ → E',
          (∀ w : K₁, s w 1 = traceLM F hE'K₁ w) ∧
          (∀ w : K₁, 2 * s w 2 = (traceLM F hE'K₁ w) ^ 2 - traceLM F hE'K₁ (w ^ 2)) ∧
          (∀ w : K₁, w ≠ 0 → s w (p - 1) = normLM F hE'K₁ w * traceLM F hE'K₁ (w⁻¹)) ∧
          (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
            ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
              (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ (r : ℤ) * q →
              (s w r = 0 ∨ m ≤ valL F E' (s w r))) ∧
          (∀ (w : K₁) (c : E'),
            normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * w) =
              1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s w r) +
                c ^ p * normLM F hE'K₁ w) := by
    intro G _ _ act hcard h1 hmul hring hincl hval htr hnorm
    obtain ⟨s, hs1, hs2, hsp1, hs_val, hs_poly⟩ :=
      ld_wild_odd_free_orbit_symm_functions F E' K₁ hE'K₁ hPrime_E'K₁ hp_odd_E'K₁
        hvalK₁_props (bM₁' - 1) htr_E'K₁' G act hcard h1 hmul hring hincl hval htr hnorm
    refine ⟨s, hs1, hs2, hsp1, fun w r hr q m hw hqm => hs_val w r hr q m hw ?_, hs_poly⟩
    have hbM₁'_cast : ((bM₁' - 1 : ℕ) + 1 : ℤ) = (bM₁' : ℤ) := by omega
    rwa [hbM₁'_cast]
  have hCayley_E'K₁ := fun (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁)
      (s : K₁ → ℕ → E') hcard h1 hring hincl hnorm hpoly =>
    ld_wild_odd_symm_subset_sum_and_cayley_hamilton F E' K₁ hE'K₁ hPrime_E'K₁ hp_odd_E'K₁
      hvalE'_props hvalK₁_props hval_E'K₁' G act hcard h1 hring hincl hnorm s hpoly
  have hTrNormCongr :=
    ld_ch12_wild_odd_tot_ram_trace_norm_congruence F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalE'K₁ hPrime hp_odd' hdegM₁' hdegE'K₁
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      hval_LE' hval_norm_LE' hval_LM₁' hval_norm_LM₁' hval_E'K₁ hval_norm_E'K₁
      htr_LE' htr_LM₁' hTowerNormTr
      ϖ_M₁' hϖ_M₁' hBasis_M₁'
      G_M₁' act_M₁' hcard_GM₁' hactM₁'_one hactM₁'_mul hactM₁'_ring
      hactM₁'_incl hactM₁'_val hactM₁'_trace hactM₁'_norm
      y₁_M₁' hy₁M₁'_tr hy₁M₁'_ne0 hy₁M₁'_val
      G_E' act_E' hcard_GE' hactE'_one hactE'_mul hactE'_ring
      hactE'_incl hactE'_val hactE'_trace hactE'_norm
      hSymm_E'K₁ hCayley_E'K₁
      Δ hΔ_val hΔ_tr_low_bE' hΔ_tr_top_bE'
      e_Δ he_Δ_1 he_Δ_val he_Δ_poly
  exact ⟨hCoeffExtr, hTwistedTr,
    ⟨e_Δ, he_Δ_1, he_Δ_val, he_Δ_poly, he_Δ_cayley, he_Δ_tr_p1,
      Z, s₀, hb_sub_a, hs₀_val, hs₀_approx, hZ0, hZ1, hZl⟩,
    hTrNormCongr⟩

theorem ld_trunc_log_binomial_tail_ring_identity (M : Type u) [Field M]
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hj_ne0 : ∀ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M) ≠ 0)
    (x y : M) :
    let P_M := fun z : M => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * z ^ j
    P_M (x + y - x * y) - P_M x - P_M y =
      - ∑ a ∈ Finset.Icc 1 (p - 1),
          ((a : ℕ) : M)⁻¹ * x ^ a *
            (∑ m ∈ Finset.range a, ((p - 1).choose m : M) * (1 - y) ^ m * y ^ (p - 1 - m)) :=
by
  intro P_M
  have hp_ge3 : 3 ≤ p := by
    have h2 := hPrime.two_le
    omega
  have h_reindex : ∀ f : ℕ → M,
      ∑ j ∈ Finset.Icc 1 (p - 1), f j = ∑ n ∈ Finset.range (p - 1), f (n + 1) := by
    intro f
    have hIcc : Finset.Icc 1 (p - 1) = Finset.Ico 1 (p - 1 + 1) := rfl
    rw [hIcc, Finset.sum_Ico_eq_sum_range]
    have h1 : p - 1 + 1 - 1 = p - 1 := by omega
    rw [h1]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [Nat.add_comm 1 n]
  have h_succ_ne0 : ∀ n ∈ Finset.range (p - 1), ((n + 1 : ℕ) : M) ≠ 0 := by
    intro n hn
    rw [Finset.mem_range] at hn
    exact hj_ne0 (n + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
  have h_choose_inv : ∀ n b : ℕ,
      ((n + 1 : ℕ) : M) ≠ 0 → ((b + 1 : ℕ) : M) ≠ 0 →
      ((n + 1 : ℕ) : M)⁻¹ * ((n + 1).choose (b + 1) : M) =
        ((b + 1 : ℕ) : M)⁻¹ * (n.choose b : M) := by
    intro n b hn hb
    have hcast : (((n + 1) * n.choose b : ℕ) : M) =
        (((n + 1).choose (b + 1) * (b + 1) : ℕ) : M) :=
      congrArg (Nat.cast (R := M)) (Nat.add_one_mul_choose_eq n b)
    push_cast at hcast
    have hcast' : ((n + 1 : ℕ) : M) * (n.choose b : M) =
        ((n + 1).choose (b + 1) : M) * ((b + 1 : ℕ) : M) := by
      simpa [Nat.cast_add, Nat.cast_one] using hcast
    rw [inv_mul_eq_iff_eq_mul₀ hn]
    calc ((n + 1).choose (b + 1) : M)
        = ((n + 1).choose (b + 1) : M) * ((b + 1 : ℕ) : M) * ((b + 1 : ℕ) : M)⁻¹ := by
          rw [mul_inv_cancel_right₀ hb]
      _ = ((n + 1 : ℕ) : M) * (n.choose b : M) * ((b + 1 : ℕ) : M)⁻¹ := by
          rw [← hcast']
      _ = ((n + 1 : ℕ) : M) * (((b + 1 : ℕ) : M)⁻¹ * (n.choose b : M)) := by
          ring
  set w : M := 1 - y
  let T : ℕ → M := fun b =>
    ∑ r ∈ Finset.range (p - 1 - b), ((r + b).choose b : M) * w ^ (b + 1) * y ^ r
  have h_pow_diff : ∀ n ∈ Finset.range (p - 1),
      ((n + 1 : ℕ) : M)⁻¹ * (x + y - x * y) ^ (n + 1) - ((n + 1 : ℕ) : M)⁻¹ * y ^ (n + 1) =
        ∑ b ∈ Finset.range (p - 1),
          ((b + 1 : ℕ) : M)⁻¹ * x ^ (b + 1) * ((n.choose b : M) * w ^ (b + 1) * y ^ (n - b)) := by
    intro n hn
    have hxy : x + y - x * y = x * w + y := by dsimp [w]; ring
    rw [hxy, ← mul_sub]
    have hbinom : (x * w + y) ^ (n + 1) - y ^ (n + 1) =
        ∑ b ∈ Finset.range (n + 1),
          (x * w) ^ (b + 1) * y ^ (n - b) * ((n + 1).choose (b + 1) : M) := by
      rw [add_pow, Finset.sum_range_succ']
      simp only [pow_zero, one_mul, Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one, mul_one,
        Nat.succ_sub_succ_eq_sub, add_sub_cancel_right]
    have hsub : (∑ b ∈ Finset.range (n + 1),
          (x * w) ^ (b + 1) * y ^ (n - b) * ((n + 1).choose (b + 1) : M)) =
        ∑ b ∈ Finset.range (p - 1),
          (x * w) ^ (b + 1) * y ^ (n - b) * ((n + 1).choose (b + 1) : M) := by
      apply Finset.sum_subset
      · rw [Finset.mem_range] at hn
        exact Finset.range_mono (by omega)
      · intro b hb hbn
        rw [Finset.mem_range] at hb hbn
        have hlt : n + 1 < b + 1 := by omega
        rw [Nat.choose_eq_zero_of_lt hlt, Nat.cast_zero, mul_zero]
    rw [hbinom, hsub, Finset.mul_sum]
    refine Finset.sum_congr rfl fun b hb => ?_
    have hn0 : ((n + 1 : ℕ) : M) ≠ 0 := h_succ_ne0 n hn
    have hb0 : ((b + 1 : ℕ) : M) ≠ 0 := h_succ_ne0 b hb
    have hci := h_choose_inv n b hn0 hb0
    rw [mul_pow]
    calc ((n + 1 : ℕ) : M)⁻¹ * (x ^ (b + 1) * w ^ (b + 1) * y ^ (n - b) * ((n + 1).choose (b + 1) : M))
        = (((n + 1 : ℕ) : M)⁻¹ * ((n + 1).choose (b + 1) : M)) * (x ^ (b + 1) * w ^ (b + 1) * y ^ (n - b)) := by ring
      _ = (((b + 1 : ℕ) : M)⁻¹ * (n.choose b : M)) * (x ^ (b + 1) * w ^ (b + 1) * y ^ (n - b)) := by rw [hci]
      _ = ((b + 1 : ℕ) : M)⁻¹ * x ^ (b + 1) * ((n.choose b : M) * w ^ (b + 1) * y ^ (n - b)) := by ring
  have h_inner_T : ∀ b ∈ Finset.range (p - 1),
      (∑ n ∈ Finset.range (p - 1), (n.choose b : M) * w ^ (b + 1) * y ^ (n - b)) = T b := by
    intro b hb
    rw [Finset.mem_range] at hb
    have hsplit : p - 1 = b + (p - 1 - b) := by omega
    conv_lhs => rw [hsplit, Finset.sum_range_add]
    have hzero : (∑ n ∈ Finset.range b, (n.choose b : M) * w ^ (b + 1) * y ^ (n - b)) = 0 := by
      refine Finset.sum_eq_zero fun n hn => ?_
      rw [Finset.mem_range] at hn
      rw [Nat.choose_eq_zero_of_lt hn, Nat.cast_zero, zero_mul, zero_mul]
    rw [hzero, zero_add]
    dsimp [T]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [Nat.add_comm b r, Nat.add_sub_cancel_right]
  have h_PM_diff : P_M (x + y - x * y) - P_M y =
      ∑ b ∈ Finset.range (p - 1), ((b + 1 : ℕ) : M)⁻¹ * x ^ (b + 1) * T b := by
    dsimp [P_M]
    rw [h_reindex (fun j => ((j : ℕ) : M)⁻¹ * (x + y - x * y) ^ j),
        h_reindex (fun j => ((j : ℕ) : M)⁻¹ * y ^ j),
        ← Finset.sum_sub_distrib,
        Finset.sum_congr rfl h_pow_diff,
        Finset.sum_comm]
    refine Finset.sum_congr rfl fun b hb => ?_
    rw [← Finset.mul_sum, h_inner_T b hb]
  have h_telescope : ∀ b : ℕ, b < p - 2 →
      T b - T (b + 1) = ((p - 1).choose (b + 1) : M) * w ^ (b + 1) * y ^ (p - 1 - (b + 1)) := by
    intro b hb
    set N := p - 2 - b
    have hNb1 : p - 1 - b = N + 1 := by omega
    have hNb2 : p - 1 - (b + 1) = N := by omega
    have hNp : N + b = p - 2 := by omega
    let G : ℕ → M := fun r => ((r + b).choose (b + 1) : M) * w ^ (b + 1) * y ^ r
    have hG0 : G 0 = 0 := by simp [G, Nat.choose_succ_self]
    have hstep : ∀ r : ℕ,
        ((r + b).choose b : M) * w ^ (b + 1) * y ^ r -
          ((r + (b + 1)).choose (b + 1) : M) * w ^ (b + 1 + 1) * y ^ r =
        G (r + 1) - G r := by
      intro r
      have hpas : (((r + (b + 1)).choose (b + 1) : ℕ) : M) =
          (((r + b).choose b + (r + b).choose (b + 1) : ℕ) : M) := by
        have h1 : r + (b + 1) = r + b + 1 := by omega
        rw [h1, Nat.choose_succ_succ (r + b) b]
      push_cast at hpas
      have hrb : r + 1 + b = r + (b + 1) := by omega
      have hpas2 : ((r + 1 + b).choose (b + 1) : M) =
          ((r + b).choose b : M) + ((r + b).choose (b + 1) : M) := by
        rw [hrb, hpas]
      dsimp [G]
      rw [hpas, hpas2]
      have hw : w ^ (b + 1 + 1) = w ^ (b + 1) * (1 - y) := by rw [pow_succ]
      rw [hw, pow_succ y r]
      ring
    have hTb : T b = (∑ r ∈ Finset.range N, ((r + b).choose b : M) * w ^ (b + 1) * y ^ r) +
        ((N + b).choose b : M) * w ^ (b + 1) * y ^ N := by
      dsimp [T]; rw [hNb1, Finset.sum_range_succ]
    have hTb1 : T (b + 1) = ∑ r ∈ Finset.range N,
        ((r + (b + 1)).choose (b + 1) : M) * w ^ (b + 1 + 1) * y ^ r := by
      dsimp [T]; rw [hNb2]
    rw [hTb, hTb1, add_sub_right_comm, ← Finset.sum_sub_distrib]
    have hsum_G : (∑ r ∈ Finset.range N,
        (((r + b).choose b : M) * w ^ (b + 1) * y ^ r -
          ((r + (b + 1)).choose (b + 1) : M) * w ^ (b + 1 + 1) * y ^ r)) =
        G N - G 0 := by
      rw [Finset.sum_congr rfl (fun r _ => hstep r), Finset.sum_range_sub]
    rw [hsum_G, hG0, sub_zero]
    dsimp [G]
    rw [hNp, hNb2]
    have hpas_top : (((p - 1).choose (b + 1) : ℕ) : M) =
        (((p - 2).choose b + (p - 2).choose (b + 1) : ℕ) : M) := by
      have hp1 : p - 1 = p - 2 + 1 := by omega
      rw [hp1, Nat.choose_succ_succ (p - 2) b]
    push_cast at hpas_top
    rw [hpas_top]
    ring
  have h_one_sub_T : ∀ b : ℕ, b < p - 1 →
      1 - T b = ∑ m ∈ Finset.range (b + 1), ((p - 1).choose m : M) * w ^ m * y ^ (p - 1 - m) := by
    intro b
    induction b with
    | zero =>
      intro _
      have hT0 : T 0 = 1 - y ^ (p - 1) := by
        dsimp [T]
        have hcongr : (∑ r ∈ Finset.range (p - 1), (r.choose 0 : M) * w ^ 1 * y ^ r) =
            ∑ r ∈ Finset.range (p - 1), (1 - y) * y ^ r := by
          refine Finset.sum_congr rfl fun r _ => ?_
          simp [w]
        rw [hcongr, ← Finset.mul_sum, mul_neg_geom_sum]
      rw [hT0, Finset.sum_range_one]
      simp [w]
    | succ b ih =>
      intro hb1
      have hb : b < p - 1 := by omega
      have hb2 : b < p - 2 := by omega
      have htel := h_telescope b hb2
      have hsplit : 1 - T (b + 1) = (1 - T b) + (T b - T (b + 1)) := by ring
      rw [hsplit, ih hb, htel, ← Finset.sum_range_succ]
  have h_PM_x : P_M x = ∑ b ∈ Finset.range (p - 1), ((b + 1 : ℕ) : M)⁻¹ * x ^ (b + 1) := by
    dsimp [P_M]
    exact h_reindex (fun j => ((j : ℕ) : M)⁻¹ * x ^ j)
  have h_rearr : P_M (x + y - x * y) - P_M x - P_M y =
      (P_M (x + y - x * y) - P_M y) - P_M x := by ring
  rw [h_rearr, h_PM_diff, h_PM_x, ← Finset.sum_sub_distrib]
  rw [h_reindex (fun a => ((a : ℕ) : M)⁻¹ * x ^ a *
      (∑ m ∈ Finset.range a, ((p - 1).choose m : M) * (1 - y) ^ m * y ^ (p - 1 - m))),
      ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun b hb => ?_
  rw [Finset.mem_range] at hb
  rw [← h_one_sub_T b hb]
  ring

theorem ld_ch12_single_field_coprime_inv_val_and_trunc_log_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hvalM_props : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))))
    (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
      resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
      resM (-x₁) = -resM x₁)
    (hresM_ker : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x)))
    (hp_char : ((p : ℕ) : k_M) = 0)
    (hBinomTail :
      (∀ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M) ≠ 0) →
      ∀ x y : M,
        let P_M := fun z : M => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * z ^ j
        P_M (x + y - x * y) - P_M x - P_M y =
          - ∑ a ∈ Finset.Icc 1 (p - 1),
              ((a : ℕ) : M)⁻¹ * x ^ a *
                (∑ m ∈ Finset.range a, ((p - 1).choose m : M) * (1 - y) ^ m * y ^ (p - 1 - m))) :
    let P_M := fun z : M => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * z ^ j
    (2 : M) ≠ 0 ∧
    valL F M (2 : M) = 0 ∧
    (∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : M) ≠ 0 ∧ valL F M ((j : ℕ) : M) = 0 ∧ valL F M (((j : ℕ) : M)⁻¹) = 0) ∧
    P_M 0 = 0 ∧
    (∀ (r : ℕ), 1 ≤ r → ∀ x : M, (x = 0 ∨ (r : ℤ) ≤ valL F M x) →
      P_M x - x = 0 ∨ (2 * (r : ℤ)) ≤ valL F M (P_M x - x)) ∧
    (∀ (m_M : ℕ), 2 ≤ m_M →
      let q_M := (m_M + p - 1) / p
      let d_M := m_M / 2
      (∀ x y : M,
        (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
        (y = 0 ∨ (q_M : ℤ) ≤ valL F M y) →
        (x + y - x * y = 0 ∨ (q_M : ℤ) ≤ valL F M (x + y - x * y)) ∧
        (P_M x = 0 ∨ (q_M : ℤ) ≤ valL F M (P_M x)) ∧
        (P_M (x + y - x * y) - P_M x - P_M y = 0 ∨
          (m_M : ℤ) ≤ valL F M (P_M (x + y - x * y) - P_M x - P_M y))) ∧
      (∀ x : M, (x = 0 ∨ (d_M : ℤ) ≤ valL F M x) →
        - 2 * P_M x - (- 2 * x - x ^ 2) = 0 ∨
          (m_M : ℤ) ≤ valL F M (- 2 * P_M x - (- 2 * x - x ^ 2)))) :=
by
  intro P_M
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩ := hvalM_props
  have hp_ge3 : 3 ≤ p := by
    have h2 := hPrime.two_le
    omega
  have hval1_ge0 : (1 : M) = 0 ∨ 0 ≤ valL F M 1 := Or.inr (by rw [hval1])
  have hval_nat : ∀ n : ℕ, ((n : ℕ) : M) = 0 ∨ 0 ≤ valL F M ((n : ℕ) : M) := by
    intro n
    induction n with
    | zero =>
      rw [Nat.cast_zero]
      exact Or.inl rfl
    | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one]
      exact hval_add 0 ((n : ℕ) : M) 1 ih hval1_ge0
  have hres_nat : ∀ n : ℕ, resM ((n : ℕ) : M) = ((n : ℕ) : k_M) := by
    intro n
    induction n with
    | zero =>
      rw [Nat.cast_zero, Nat.cast_zero, hresM_0]
    | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one, Nat.cast_add, Nat.cast_one,
        (hresM_ring ((n : ℕ) : M) 1 (hval_nat n) hval1_ge0).1, ih, hresM_1]
  have hj_props : ∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : M) ≠ 0 ∧ valL F M ((j : ℕ) : M) = 0 ∧ valL F M (((j : ℕ) : M)⁻¹) = 0 := by
    intro j hj
    have hj_bounds := Finset.mem_Icc.mp hj
    have hj_pos : 0 < j := by omega
    have hj_lt : j < p := by omega
    have hndvd : ¬ (p ∣ j) := Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
    have hcop : Nat.Coprime p j := hPrime.coprime_iff_not_dvd.mpr hndvd
    have hgcd : Nat.gcd j p = 1 := hcop.symm.gcd_eq_one
    have hbez := congrArg (Int.cast (R := k_M)) (Nat.gcd_eq_gcd_ab j p)
    rw [hgcd] at hbez
    push_cast at hbez
    rw [hp_char, zero_mul, add_zero] at hbez
    have hj_kM_ne0 : ((j : ℕ) : k_M) ≠ 0 := by
      intro hj0
      rw [hj0, zero_mul] at hbez
      exact one_ne_zero hbez
    have hres_ne0 : resM ((j : ℕ) : M) ≠ 0 := by
      rw [hres_nat j]
      exact hj_kM_ne0
    have hnot_ker : ¬ (((j : ℕ) : M) = 0 ∨ 1 ≤ valL F M ((j : ℕ) : M)) := by
      rw [← hresM_ker ((j : ℕ) : M) (hval_nat j)]
      exact hres_ne0
    have hj_ne0 : ((j : ℕ) : M) ≠ 0 := fun h0 => hnot_ker (Or.inl h0)
    have hj_not_ge1 : ¬ (1 ≤ valL F M ((j : ℕ) : M)) := fun h1 => hnot_ker (Or.inr h1)
    have hj_ge0 : 0 ≤ valL F M ((j : ℕ) : M) := by
      rcases hval_nat j with h0 | hge0
      · exact False.elim (hj_ne0 h0)
      · exact hge0
    have hj_val0 : valL F M ((j : ℕ) : M) = 0 := by omega
    have hj_inv_val0 : valL F M (((j : ℕ) : M)⁻¹) = 0 := by
      have hu := hval_inv (Units.mk0 ((j : ℕ) : M) hj_ne0)
      rw [Units.val_inv_eq_inv_val, Units.val_mk0, hj_val0, neg_zero] at hu
      exact hu
    exact ⟨hj_ne0, hj_val0, hj_inv_val0⟩
  have h2_mem : 2 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  have h2_ne0 : (2 : M) ≠ 0 := by
    have h := (hj_props 2 h2_mem).1
    rwa [Nat.cast_two] at h
  have hval_2 : valL F M (2 : M) = 0 := by
    have h := (hj_props 2 h2_mem).2.1
    rwa [Nat.cast_two] at h
  have hval_neg_bound : ∀ (k : ℤ) (x : M),
      (x = 0 ∨ k ≤ valL F M x) → (-x = 0 ∨ k ≤ valL F M (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · rw [neg_zero]
      exact Or.inl rfl
    · rw [hval_neg]
      exact Or.inr hx
  have hval_sub : ∀ (k : ℤ) (x y : M),
      (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
        (x - y = 0 ∨ k ≤ valL F M (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add k x (-y) hx (hval_neg_bound k y hy)
  have hval_mono : ∀ (k₁ k₂ : ℤ) (x : M),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M x) → (x = 0 ∨ k₁ ≤ valL F M x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hval_mul_bound : ∀ (k₁ k₂ : ℤ) (x y : M),
      (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · rw [hx0, zero_mul]
      exact Or.inl rfl
    · by_cases hy0 : y = 0
      · rw [hy0, mul_zero]
        exact Or.inl rfl
      · rcases hx with rfl | hx
        · exact False.elim (hx0 rfl)
        · rcases hy with rfl | hy
          · exact False.elim (hy0 rfl)
          · rw [hval_mul x y hx0 hy0]
            exact Or.inr (by omega)
  have hval_pow_bound : ∀ (k : ℤ) (x : M),
      (x = 0 ∨ k ≤ valL F M x) →
        ∀ n : ℕ, x ^ n = 0 ∨ (n : ℤ) * k ≤ valL F M (x ^ n) := by
    intro k x hx n
    induction n with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul, hval1]
      exact Or.inr le_rfl
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_bound ((n : ℤ) * k) k (x ^ n) x ih hx
      have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by
        push_cast
        ring
      rw [heq]
      exact hmul
  have hval_sum_bound : ∀ (s : Finset ℕ) (f : ℕ → M) (k : ℤ),
      (∀ i ∈ s, f i = 0 ∨ k ≤ valL F M (f i)) →
        ((∑ i ∈ s, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ s, f i)) := by
    intro s f k hf
    induction' s using Finset.induction_on with a s ha ih
    · rw [Finset.sum_empty]
      exact Or.inl rfl
    · rw [Finset.sum_insert ha]
      exact hval_add k (f a) (∑ i ∈ s, f i)
        (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have hPM_0 : P_M 0 = 0 := by
    change (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * (0 : M) ^ j) = 0
    apply Finset.sum_eq_zero
    intro j hj
    have hj_bounds := Finset.mem_Icc.mp hj
    have hj_ne0 : j ≠ 0 := by omega
    rw [zero_pow hj_ne0, mul_zero]
  have hIcc1 : Finset.Icc 1 (p - 1) = insert 1 (Finset.Icc 2 (p - 1)) := by
    ext j
    simp only [Finset.mem_Icc, Finset.mem_insert]
    omega
  have h1_not_mem : 1 ∉ Finset.Icc 2 (p - 1) := by
    simp [Finset.mem_Icc]
  have hPM_split1 : ∀ x : M,
      P_M x = x + ∑ j ∈ Finset.Icc 2 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j := by
    intro x
    change (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) = _
    rw [hIcc1, Finset.sum_insert h1_not_mem, Nat.cast_one, inv_one, pow_one, one_mul]
  have hPM_lin : ∀ (r : ℕ), 1 ≤ r → ∀ x : M, (x = 0 ∨ (r : ℤ) ≤ valL F M x) →
      P_M x - x = 0 ∨ (2 * (r : ℤ)) ≤ valL F M (P_M x - x) := by
    intro r hr x hx
    have hsub : P_M x - x = ∑ j ∈ Finset.Icc 2 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j := by
      rw [hPM_split1 x, add_sub_cancel_left]
    rw [hsub]
    apply hval_sum_bound
    intro j hj
    have hj_bounds := Finset.mem_Icc.mp hj
    have hj_mem1 : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    have hj_inv : (((j : ℕ) : M)⁻¹) = 0 ∨ 0 ≤ valL F M (((j : ℕ) : M)⁻¹) :=
      Or.inr (by rw [(hj_props j hj_mem1).2.2])
    have hx_pow := hval_pow_bound (r : ℤ) x hx j
    have hterm := hval_mul_bound 0 ((j : ℤ) * (r : ℤ)) (((j : ℕ) : M)⁻¹) (x ^ j) hj_inv hx_pow
    refine hval_mono (2 * (r : ℤ)) (0 + (j : ℤ) * (r : ℤ)) _ ?_ hterm
    have hj2 : (2 : ℤ) ≤ (j : ℤ) := by omega
    have hr0 : (0 : ℤ) ≤ (r : ℤ) := by omega
    nlinarith
  have hIcc2 : Finset.Icc 2 (p - 1) = insert 2 (Finset.Icc 3 (p - 1)) := by
    ext j
    simp only [Finset.mem_Icc, Finset.mem_insert]
    omega
  have h2_not_mem : 2 ∉ Finset.Icc 3 (p - 1) := by
    simp [Finset.mem_Icc]
  have hPM_split2 : ∀ x : M,
      P_M x = x + (2 : M)⁻¹ * x ^ 2 + ∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j := by
    intro x
    rw [hPM_split1 x, hIcc2, Finset.sum_insert h2_not_mem, Nat.cast_two, add_assoc]
  have hPM_bounds : ∀ (m_M : ℕ), 2 ≤ m_M →
      let q_M := (m_M + p - 1) / p
      let d_M := m_M / 2
      (∀ x y : M,
        (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
        (y = 0 ∨ (q_M : ℤ) ≤ valL F M y) →
        (x + y - x * y = 0 ∨ (q_M : ℤ) ≤ valL F M (x + y - x * y)) ∧
        (P_M x = 0 ∨ (q_M : ℤ) ≤ valL F M (P_M x)) ∧
        (P_M (x + y - x * y) - P_M x - P_M y = 0 ∨
          (m_M : ℤ) ≤ valL F M (P_M (x + y - x * y) - P_M x - P_M y))) ∧
      (∀ x : M, (x = 0 ∨ (d_M : ℤ) ≤ valL F M x) →
        - 2 * P_M x - (- 2 * x - x ^ 2) = 0 ∨
          (m_M : ℤ) ≤ valL F M (- 2 * P_M x - (- 2 * x - x ^ 2))) := by
    intro m_M hm_M q_M d_M
    have hm_le_pq : m_M ≤ p * q_M := by
      dsimp [q_M]
      have hdiv := Nat.div_add_mod (m_M + p - 1) p
      have hmod : (m_M + p - 1) % p < p := Nat.mod_lt _ (by omega)
      omega
    have hq_ge1 : 1 ≤ q_M := by
      cases hq : q_M with
      | zero =>
        rw [hq, mul_zero] at hm_le_pq
        omega
      | succ n =>
        omega
    have hd_ge1 : 1 ≤ d_M := by
      dsimp [d_M]
      omega
    have hm_le_3d : m_M ≤ 3 * d_M := by
      dsimp [d_M]
      omega
    refine ⟨?_, ?_⟩
    · intro x y hx hy
      have hxy : x * y = 0 ∨ (q_M : ℤ) ≤ valL F M (x * y) := by
        have hmul := hval_mul_bound (q_M : ℤ) (q_M : ℤ) x y hx hy
        exact hval_mono (q_M : ℤ) ((q_M : ℤ) + (q_M : ℤ)) (x * y) (by omega) hmul
      have hxy_comb : x + y - x * y = 0 ∨ (q_M : ℤ) ≤ valL F M (x + y - x * y) :=
        hval_sub (q_M : ℤ) (x + y) (x * y) (hval_add (q_M : ℤ) x y hx hy) hxy
      have hPM_x : P_M x = 0 ∨ (q_M : ℤ) ≤ valL F M (P_M x) := by
        dsimp only [P_M]
        apply hval_sum_bound
        intro j hj
        have hj_bounds := Finset.mem_Icc.mp hj
        have hj_inv : (((j : ℕ) : M)⁻¹) = 0 ∨ 0 ≤ valL F M (((j : ℕ) : M)⁻¹) :=
          Or.inr (by rw [(hj_props j hj).2.2])
        have hx_pow := hval_pow_bound (q_M : ℤ) x hx j
        have hterm := hval_mul_bound 0 ((j : ℤ) * (q_M : ℤ)) (((j : ℕ) : M)⁻¹) (x ^ j) hj_inv hx_pow
        refine hval_mono (q_M : ℤ) (0 + (j : ℤ) * (q_M : ℤ)) _ ?_ hterm
        have hj1 : (1 : ℤ) ≤ (j : ℤ) := by omega
        have hq0 : (0 : ℤ) ≤ (q_M : ℤ) := by omega
        nlinarith
      have hPM_err : P_M (x + y - x * y) - P_M x - P_M y = 0 ∨
          (m_M : ℤ) ≤ valL F M (P_M (x + y - x * y) - P_M x - P_M y) := by
        have hbt := hBinomTail (fun j hj => (hj_props j hj).1) x y
        change P_M (x + y - x * y) - P_M x - P_M y = _ at hbt
        rw [hbt]
        apply hval_neg_bound
        apply hval_sum_bound
        intro a ha
        have ha_bounds := Finset.mem_Icc.mp ha
        have ha_inv : (((a : ℕ) : M)⁻¹) = 0 ∨ 0 ≤ valL F M (((a : ℕ) : M)⁻¹) :=
          Or.inr (by rw [(hj_props a ha).2.2])
        have hx_pow := hval_pow_bound (q_M : ℤ) x hx a
        have hxa := hval_mul_bound 0 ((a : ℤ) * (q_M : ℤ)) (((a : ℕ) : M)⁻¹) (x ^ a) ha_inv hx_pow
        have hy_ge0 : y = 0 ∨ 0 ≤ valL F M y := hval_mono 0 (q_M : ℤ) y (by omega) hy
        have h1my : 1 - y = 0 ∨ 0 ≤ valL F M (1 - y) := hval_sub 0 1 y hval1_ge0 hy_ge0
        have hinner : (∑ m ∈ Finset.range a,
            ((p - 1).choose m : M) * (1 - y) ^ m * y ^ (p - 1 - m)) = 0 ∨
            ((p - a : ℕ) : ℤ) * (q_M : ℤ) ≤ valL F M
              (∑ m ∈ Finset.range a, ((p - 1).choose m : M) * (1 - y) ^ m * y ^ (p - 1 - m)) := by
          apply hval_sum_bound
          intro m hm
          have hm_lt : m < a := Finset.mem_range.mp hm
          have hchoose : (((p - 1).choose m : ℕ) : M) = 0 ∨
              0 ≤ valL F M (((p - 1).choose m : ℕ) : M) := hval_nat _
          have h1my_pow : (1 - y) ^ m = 0 ∨ 0 ≤ valL F M ((1 - y) ^ m) := by
            have hp0 := hval_pow_bound 0 (1 - y) h1my m
            rwa [mul_zero] at hp0
          have hc_1my := hval_mul_bound 0 0 (((p - 1).choose m : ℕ) : M) ((1 - y) ^ m) hchoose h1my_pow
          rw [add_zero] at hc_1my
          have hy_pow := hval_pow_bound (q_M : ℤ) y hy (p - 1 - m)
          have hterm_m := hval_mul_bound 0 (((p - 1 - m : ℕ) : ℤ) * (q_M : ℤ))
            (((p - 1).choose m : M) * (1 - y) ^ m) (y ^ (p - 1 - m)) hc_1my hy_pow
          refine hval_mono (((p - a : ℕ) : ℤ) * (q_M : ℤ))
            (0 + ((p - 1 - m : ℕ) : ℤ) * (q_M : ℤ)) _ ?_ hterm_m
          have hpa_le : (p - a : ℕ) ≤ (p - 1 - m : ℕ) := by omega
          have hpa_le_z : ((p - a : ℕ) : ℤ) ≤ ((p - 1 - m : ℕ) : ℤ) := by exact_mod_cast hpa_le
          have hq0 : (0 : ℤ) ≤ (q_M : ℤ) := by omega
          nlinarith
        have houter := hval_mul_bound (0 + (a : ℤ) * (q_M : ℤ)) (((p - a : ℕ) : ℤ) * (q_M : ℤ))
          (((a : ℕ) : M)⁻¹ * x ^ a)
          (∑ m ∈ Finset.range a, ((p - 1).choose m : M) * (1 - y) ^ m * y ^ (p - 1 - m))
          hxa hinner
        refine hval_mono (m_M : ℤ)
          ((0 + (a : ℤ) * (q_M : ℤ)) + ((p - a : ℕ) : ℤ) * (q_M : ℤ)) _ ?_ houter
        have hap : a + (p - a) = p := by omega
        have hap_z : (a : ℤ) + ((p - a : ℕ) : ℤ) = (p : ℤ) := by exact_mod_cast hap
        have hm_pq_z : (m_M : ℤ) ≤ (p : ℤ) * (q_M : ℤ) := by exact_mod_cast hm_le_pq
        nlinarith
      exact ⟨hxy_comb, hPM_x, hPM_err⟩
    · intro x hx
      have hquad_eq : - 2 * P_M x - (- 2 * x - x ^ 2) =
          (- 2 : M) * (∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) := by
        rw [hPM_split2 x]
        have h2_inv : (2 : M) * (2 : M)⁻¹ = 1 := mul_inv_cancel₀ h2_ne0
        calc - 2 * (x + (2 : M)⁻¹ * x ^ 2 + ∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) -
              (- 2 * x - x ^ 2)
          _ = - ((2 : M) * (2 : M)⁻¹) * x ^ 2 + x ^ 2 +
              (- 2 : M) * (∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) := by ring
          _ = (- 2 : M) * (∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) := by
            rw [h2_inv]
            ring
      rw [hquad_eq]
      have hneg2 : (- 2 : M) = 0 ∨ 0 ≤ valL F M (- 2 : M) :=
        Or.inr (by rw [hval_neg, hval_2])
      have hsum3 : (∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) = 0 ∨
          (m_M : ℤ) ≤ valL F M (∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) := by
        apply hval_sum_bound
        intro j hj
        have hj_bounds := Finset.mem_Icc.mp hj
        have hj_mem1 : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
        have hj_inv : (((j : ℕ) : M)⁻¹) = 0 ∨ 0 ≤ valL F M (((j : ℕ) : M)⁻¹) :=
          Or.inr (by rw [(hj_props j hj_mem1).2.2])
        have hx_pow := hval_pow_bound (d_M : ℤ) x hx j
        have hterm := hval_mul_bound 0 ((j : ℤ) * (d_M : ℤ)) (((j : ℕ) : M)⁻¹) (x ^ j) hj_inv hx_pow
        refine hval_mono (m_M : ℤ) (0 + (j : ℤ) * (d_M : ℤ)) _ ?_ hterm
        have hj3 : (3 : ℤ) ≤ (j : ℤ) := by omega
        have hd0 : (0 : ℤ) ≤ (d_M : ℤ) := by omega
        have hm3d_z : (m_M : ℤ) ≤ 3 * (d_M : ℤ) := by omega
        nlinarith
      have hprod := hval_mul_bound 0 (m_M : ℤ) (- 2 : M)
        (∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : M)⁻¹ * x ^ j) hneg2 hsum3
      rwa [zero_add] at hprod
  exact ⟨h2_ne0, hval_2, hj_props, hPM_0, hPM_lin, hPM_bounds⟩

theorem ld_ch12_single_field_trunc_log_stat_descent (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (ψ_M : AddChar M (Ω F)) (θ : Mˣ →* (Ω F)ˣ)
    (hm_ge2 : 2 ≤ condExp F M θ)
    (hSpecM_triv : ∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1)
    (hSpecM_nontriv : ∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1)
    (hvalM_props : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
      resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
      resM (-x₁) = -resM x₁)
    (hresM_ker : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x)))
    (hresM_surj : ∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a)
    (h2_ne0 : (2 : M) ≠ 0) (hval_2 : valL F M (2 : M) = 0)
    (P_M : M → M) (hPM_0 : P_M 0 = 0)
    (hPM_lin : ∀ (r : ℕ), 1 ≤ r → ∀ x : M, (x = 0 ∨ (r : ℤ) ≤ valL F M x) →
      P_M x - x = 0 ∨ (2 * (r : ℤ)) ≤ valL F M (P_M x - x))
    (hPM_qM :
      let m_M := condExp F M θ
      let q_M := (m_M + p - 1) / p
      ∀ x y : M,
        (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
        (y = 0 ∨ (q_M : ℤ) ≤ valL F M y) →
        (x + y - x * y = 0 ∨ (q_M : ℤ) ≤ valL F M (x + y - x * y)) ∧
        (P_M x = 0 ∨ (q_M : ℤ) ≤ valL F M (P_M x)) ∧
        (P_M (x + y - x * y) - P_M x - P_M y = 0 ∨
          (m_M : ℤ) ≤ valL F M (P_M (x + y - x * y) - P_M x - P_M y)))
    (hPM_dM :
      let m_M := condExp F M θ
      let d_M := m_M / 2
      ∀ x : M, (x = 0 ∨ (d_M : ℤ) ≤ valL F M x) →
        - 2 * P_M x - (- 2 * x - x ^ 2) = 0 ∨
          (m_M : ℤ) ≤ valL F M (- 2 * P_M x - (- 2 * x - x ^ 2)))
    (c₀ : Mˣ)
    (hc₀_val : valL F M (c₀ : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hc₀_quad : ∀ x : M, (x = 0 ∨ ((condExp F M θ / 2 : ℕ) : ℤ) ≤ valL F M x) →
      ∀ hx : 1 + x ≠ 0,
        (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          ψ_M (((c₀⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) :
    let m_M := condExp F M θ
    let q_M := (m_M + p - 1) / p
    ∃ c_θ : Mˣ,
      valL F M (c_θ : M) = (m_M : ℤ) + condExpChar F M ψ_M ∧
      ∀ x : M, (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
        ∀ hx : 1 - x ≠ 0,
          (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
            ψ_M (- 2 * ((c_θ⁻¹ : Mˣ) : M) * P_M x) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalM_props
  set m_M : ℕ := condExp F M θ
  set n_M : ℤ := condExpChar F M ψ_M
  set d_M : ℕ := m_M / 2
  set q_M : ℕ := (m_M + p - 1) / p
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hm_ge2' : 2 ≤ m_M := hm_ge2
  have hdiv_qM : p * q_M + (m_M + p - 1) % p = m_M + p - 1 := Nat.div_add_mod (m_M + p - 1) p
  have hle_div : p * q_M ≤ m_M + p - 1 := Nat.le.intro hdiv_qM
  have hmod_qM : (m_M + p - 1) % p < p := Nat.mod_lt (m_M + p - 1) (by omega)
  have hqM_ge1 : 1 ≤ q_M := by
    rcases Nat.eq_zero_or_pos q_M with hq0 | hpos
    · rw [hq0, mul_zero, zero_add] at hdiv_qM
      rw [hdiv_qM] at hmod_qM
      omega
    · exact hpos
  have hdM_ge1 : 1 ≤ d_M := by omega
  have hqM_le_dM : q_M ≤ d_M := by
    by_contra hgt
    have hd_lt : d_M + 1 ≤ q_M := Nat.lt_of_not_le hgt
    have h1 : 3 * d_M ≤ p * d_M := Nat.mul_le_mul_right d_M hp_ge3
    have h2 : p * d_M + p ≤ p * q_M := by
      calc p * d_M + p = p * (d_M + 1) := by ring
        _ ≤ p * q_M := Nat.mul_le_mul_left p hd_lt
    omega
  have hdM_lt_mM : d_M < m_M := by omega
  have hval_sub : ∀ (k : ℤ) (x y : M),
      (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
      (x - y = 0 ∨ k ≤ valL F M (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hval_add k x (-y) hx
    rcases hy with rfl | hge
    · left; exact neg_zero
    · right; rw [hval_neg]; exact hge
  have hval_mul_bound : ∀ (k₁ k₂ : ℤ) (x y : M),
      (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' : k₁ ≤ valL F M x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F M y := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hone_add_ne : ∀ (a : ℕ), 1 ≤ a → ∀ (z : M),
      (z = 0 ∨ (a : ℤ) ≤ valL F M z) → 1 + z ≠ 0 := by
    intro a ha z hz h0
    have hz_neg1 : z = -1 := eq_neg_of_add_eq_zero_right h0
    rcases hz with rfl | hge
    · rw [add_zero] at h0
      exact one_ne_zero h0
    · rw [hz_neg1, hval_neg1] at hge
      omega
  have hone_sub_ne : ∀ (a : ℕ), 1 ≤ a → ∀ (z : M),
      (z = 0 ∨ (a : ℤ) ≤ valL F M z) → 1 - z ≠ 0 := by
    intro a ha z hz
    rw [sub_eq_add_neg]
    apply hone_add_ne a ha (-z)
    rcases hz with rfl | hge
    · left; exact neg_zero
    · right; rw [hval_neg]; exact hge
  have hunit_one_add : ∀ (a : ℕ) (ha : 1 ≤ a) (z : M)
      (hz : z = 0 ∨ (a : ℤ) ≤ valL F M z),
      Units.mk0 (1 + z) (hone_add_ne a ha z hz) ∈ unitGroup F M a := by
    intro a ha z hz
    rw [hunit_ge1 a ha]
    rcases hz with rfl | hge
    · left
      change (1 : M) + 0 = 1
      exact add_zero 1
    · right
      change (a : ℤ) ≤ valL F M ((1 + z) - 1)
      rw [add_sub_cancel_left]
      exact hge
  have hunit_one_sub : ∀ (a : ℕ) (ha : 1 ≤ a) (z : M)
      (hz : z = 0 ∨ (a : ℤ) ≤ valL F M z),
      Units.mk0 (1 - z) (hone_sub_ne a ha z hz) ∈ unitGroup F M a := by
    intro a ha z hz
    rw [hunit_ge1 a ha]
    rcases hz with rfl | hge
    · left
      change (1 : M) - 0 = 1
      exact sub_zero 1
    · right
      change (a : ℤ) ≤ valL F M ((1 - z) - 1)
      have hsub : (1 : M) - z - 1 = -z := by ring
      rw [hsub, hval_neg]
      exact hge
  obtain ⟨ϖ_M, hϖ_M⟩ := hval_surj 1
  have hϖ_pow : ∀ n : ℕ, valL F M ((ϖ_M ^ n : Mˣ) : M) = (n : ℤ) := by
    intro n
    induction n with
    | zero =>
      rw [pow_zero, Units.val_one, Nat.cast_zero]
      exact hval1
    | succ n ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul _ _ (Units.ne_zero (ϖ_M ^ n)) (Units.ne_zero ϖ_M), ih, hϖ_M]
      push_cast
      ring
  have hval_ϖm_mul : ∀ (n : ℕ) (k : ℤ) (z : M),
      (z = 0 ∨ k ≤ valL F M z) →
      (((ϖ_M ^ n : Mˣ) : M) * z = 0 ∨ (n : ℤ) + k ≤ valL F M (((ϖ_M ^ n : Mˣ) : M) * z)) := by
    intro n k z hz
    exact hval_mul_bound (n : ℤ) k ((ϖ_M ^ n : Mˣ) : M) z (Or.inr (by rw [hϖ_pow n])) hz
  have hval_2_inv : valL F M ((2 : M)⁻¹) = 0 := by
    let u₂ : Mˣ := Units.mk0 (2 : M) h2_ne0
    have hu₂_inv : ((u₂⁻¹ : Mˣ) : M) = (2 : M)⁻¹ := rfl
    rw [← hu₂_inv, hval_inv u₂]
    change - valL F M (2 : M) = 0
    rw [hval_2, neg_zero]
  have hψ_c_triv : ∀ (c : Mˣ), valL F M (c : M) = (m_M : ℤ) + n_M →
      ∀ (y : M), (y = 0 ∨ (m_M : ℤ) ≤ valL F M y) →
      ψ_M (((c⁻¹ : Mˣ) : M) * y) = 1 := by
    intro c hc_val y hy
    apply hSpecM_triv
    by_cases hy0 : y = 0
    · left; rw [hy0, mul_zero]
    · right
      have hy_ge : (m_M : ℤ) ≤ valL F M y := hy.resolve_left hy0
      rw [hval_mul ((c⁻¹ : Mˣ) : M) y (Units.ne_zero c⁻¹) hy0,
        hval_inv c, hc_val]
      omega
  have hψ_2c_congr : ∀ (c : Mˣ), valL F M (c : M) = (m_M : ℤ) + n_M →
      ∀ (y₁ y₂ : M), (y₁ - y₂ = 0 ∨ (m_M : ℤ) ≤ valL F M (y₁ - y₂)) →
      ψ_M (2 * ((c⁻¹ : Mˣ) : M) * y₁) = ψ_M (2 * ((c⁻¹ : Mˣ) : M) * y₂) := by
    intro c hc_val y₁ y₂ hdiff
    have h2diff : 2 * (y₁ - y₂) = 0 ∨ (m_M : ℤ) ≤ valL F M (2 * (y₁ - y₂)) := by
      rcases hval_mul_bound 0 (m_M : ℤ) (2 : M) (y₁ - y₂) (Or.inr (by rw [hval_2])) hdiff with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have htriv : ψ_M (((c⁻¹ : Mˣ) : M) * (2 * (y₁ - y₂))) = 1 :=
      hψ_c_triv c hc_val (2 * (y₁ - y₂)) h2diff
    have hsplit : 2 * ((c⁻¹ : Mˣ) : M) * y₁ =
        2 * ((c⁻¹ : Mˣ) : M) * y₂ + ((c⁻¹ : Mˣ) : M) * (2 * (y₁ - y₂)) := by ring
    rw [hsplit, ψ_M.map_add_eq_mul, htriv, mul_one]
  have hFF_orth : ∀ (φ ψ₀ : k_M → Ω F),
      φ 0 = 1 → (∀ x y : k_M, φ (x + y) = φ x * φ y) →
      ψ₀ 0 = 1 → (∀ x y : k_M, ψ₀ (x + y) = ψ₀ x * ψ₀ y) →
      ∀ z₁ : k_M, ψ₀ z₁ ≠ 1 →
      ∃ b₀ : k_M, ∀ a : k_M, φ a * ψ₀ (b₀ * a) = 1 := by
    intro φ ψ₀ hφ0 hφadd hψ0 hψadd z₁ hz₁
    have horth : ∀ a : k_M,
        (∑ b : k_M, ψ₀ (b * a)) = if a = 0 then (Fintype.card k_M : Ω F) else 0 := by
      intro a
      by_cases ha : a = 0
      · simp [ha, hψ0]
      · rw [if_neg ha]
        have hshift :
            (∑ b : k_M, ψ₀ (b * a)) * ψ₀ z₁ = ∑ b : k_M, ψ₀ (b * a) := by
          rw [Finset.sum_mul]
          calc (∑ b : k_M, ψ₀ (b * a) * ψ₀ z₁)
              = ∑ b : k_M, ψ₀ ((b + z₁ * a⁻¹) * a) := by
                refine Finset.sum_congr rfl (fun b _ => ?_)
                have h1 : (b + z₁ * a⁻¹) * a = b * a + z₁ := by
                  rw [add_mul, mul_assoc z₁ a⁻¹ a, inv_mul_cancel₀ ha, mul_one]
                rw [h1, hψadd]
            _ = ∑ b : k_M, ψ₀ (b * a) :=
                Fintype.sum_equiv (Equiv.addRight (z₁ * a⁻¹)) _ _ (fun _ => rfl)
        have hsub : (∑ b : k_M, ψ₀ (b * a)) * (ψ₀ z₁ - 1) = 0 := by
          linear_combination hshift
        exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hz₁)
    let S : k_M → Ω F := fun b => ∑ a : k_M, φ a * ψ₀ (b * a)
    have hsumS : (∑ b : k_M, S b) = (Fintype.card k_M : Ω F) := by
      dsimp only [S]
      rw [Finset.sum_comm]
      have hinner : ∀ a : k_M,
          (∑ b : k_M, φ a * ψ₀ (b * a)) = φ a * (∑ b : k_M, ψ₀ (b * a)) := by
        intro a
        rw [← Finset.mul_sum]
      simp_rw [hinner, horth]
      rw [Finset.sum_eq_single (0 : k_M)]
      · rw [if_pos rfl, hφ0, one_mul]
      · intro a _ ha
        rw [if_neg ha, mul_zero]
      · intro h0
        exact False.elim (h0 (Finset.mem_univ 0))
    have hsumS_ne : (∑ b : k_M, S b) ≠ 0 := by
      rw [hsumS]
      exact Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    obtain ⟨b₀, _, hSb₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsumS_ne
    refine ⟨b₀, fun a => ?_⟩
    have hS_shift : S b₀ = S b₀ * (φ a * ψ₀ (b₀ * a)) := by
      dsimp only [S]
      calc (∑ x : k_M, φ x * ψ₀ (b₀ * x))
          = ∑ x : k_M, φ (x + a) * ψ₀ (b₀ * (x + a)) :=
            (Fintype.sum_equiv (Equiv.addRight a) _ _ (fun _ => rfl)).symm
        _ = ∑ x : k_M, (φ x * ψ₀ (b₀ * x)) * (φ a * ψ₀ (b₀ * a)) := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            rw [hφadd x a, mul_add b₀ x a, hψadd]
            ring
        _ = (∑ x : k_M, φ x * ψ₀ (b₀ * x)) * (φ a * ψ₀ (b₀ * a)) :=
            (Finset.sum_mul _ _ _).symm
    have hsub : S b₀ * (φ a * ψ₀ (b₀ * a) - 1) = 0 := by
      linear_combination -hS_shift
    exact sub_eq_zero.mp ((mul_eq_zero.mp hsub).resolve_left hSb₀)
  have hBase : ∀ x : M, (x = 0 ∨ (d_M : ℤ) ≤ valL F M x) →
      ∀ hx : 1 - x ≠ 0,
        (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
          ψ_M (- 2 * ((c₀⁻¹ : Mˣ) : M) * P_M x) := by
    intro x hx_val hx
    have hneg_x_val : -x = 0 ∨ (d_M : ℤ) ≤ valL F M (-x) := by
      rcases hx_val with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg]; exact hge
    have h_neg_x : 1 + (-x) ≠ 0 := by
      rw [← sub_eq_add_neg]
      exact hx
    have hu_eq : Units.mk0 (1 + (-x)) h_neg_x = Units.mk0 (1 - x) hx := by
      apply Units.ext
      exact (sub_eq_add_neg 1 x).symm
    have hquad := hc₀_quad (-x) hneg_x_val h_neg_x
    rw [hu_eq] at hquad
    have hquad_ring : 2 * (-x) - (-x) ^ 2 = - 2 * x - x ^ 2 := by ring
    rw [hquad_ring] at hquad
    have hdM_diff := hPM_dM x hx_val
    have htriv : ψ_M (((c₀⁻¹ : Mˣ) : M) * (- 2 * P_M x - (- 2 * x - x ^ 2))) = 1 :=
      hψ_c_triv c₀ hc₀_val (- 2 * P_M x - (- 2 * x - x ^ 2)) hdM_diff
    have hsplit : - 2 * ((c₀⁻¹ : Mˣ) : M) * P_M x =
        ((c₀⁻¹ : Mˣ) : M) * (- 2 * x - x ^ 2) +
          ((c₀⁻¹ : Mˣ) : M) * (- 2 * P_M x - (- 2 * x - x ^ 2)) := by ring
    rw [hquad, hsplit, ψ_M.map_add_eq_mul, htriv, mul_one]
  have hStep : ∀ (r : ℕ), q_M ≤ r → r < d_M →
      ∀ (c : Mˣ), valL F M (c : M) = (m_M : ℤ) + n_M →
      (∀ y : M, (y = 0 ∨ ((r + 1 : ℕ) : ℤ) ≤ valL F M y) →
        ∀ hy : 1 - y ≠ 0,
          (θ (Units.mk0 (1 - y) hy) : Ω F) ^ 2 =
            ψ_M (- 2 * ((c⁻¹ : Mˣ) : M) * P_M y)) →
      ∃ c' : Mˣ,
        valL F M (c' : M) = (m_M : ℤ) + n_M ∧
        ∀ x : M, (x = 0 ∨ (r : ℤ) ≤ valL F M x) →
          ∀ hx : 1 - x ≠ 0,
