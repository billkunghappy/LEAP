  obtain ⟨_, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _, _, _⟩ := hvalL_props
  obtain ⟨_, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, _, _, hvalE'_add, _, _, _⟩ := hvalE'_props
