    apply hval_mul_bound_K₁ (((p - 2 : ℕ) : ℤ) * v) d
      (∑ i ∈ Finset.range (p - 1), A ^ i * B ^ (p - 1 - 1 - i)) (A - B) ?_ hd
    apply hval_sum_K₁ (Finset.range (p - 1)) (fun i => A ^ i * B ^ (p - 1 - 1 - i))
