    obtain ⟨x_uE, hx_uE_int, hr_uE⟩ := hResLiftE (u_E : E) (Or.inr (by rw [hu_E_val]))
    have hx_uE_ne_and_val0 : x_uE ≠ 0 ∧ valL F L x_uE = 0 := by
      by_contra h_bad
      have hx_ge1 : x_uE = 0 ∨ 1 ≤ valL F L x_uE := by
        rcases hx_uE_int with rfl | hx_ge0
        · exact Or.inl rfl
        · by_cases hx0 : x_uE = 0
          · exact Or.inl hx0
          · right
            have hne0 : valL F L x_uE ≠ 0 := fun h0 => h_bad ⟨hx0, h0⟩
            omega
      have hincl_x : IntermediateField.inclusion hLE x_uE = 0 ∨
          1 ≤ valL F E (IntermediateField.inclusion hLE x_uE) := by
        rcases hx_ge1 with rfl | hx_ge1
        · left; rw [map_zero]
        · right
          rw [hValAlgE x_uE]
          have hq_int : (1 : ℤ) ≤ (q : ℤ) := by exact_mod_cast hq_ge1
          nlinarith
      have huE_sum : (u_E : E) =
          IntermediateField.inclusion hLE x_uE + ((u_E : E) - IntermediateField.inclusion hLE x_uE) := by
        ring
      have huE_ge1 := hval_add_E 1 (IntermediateField.inclusion hLE x_uE)
        ((u_E : E) - IntermediateField.inclusion hLE x_uE) hincl_x hr_uE
      rw [← huE_sum] at huE_ge1
      rcases huE_ge1 with h0 | hge1
      · exact Units.ne_zero u_E h0
      · omega
    let u_EL : Lˣ := Units.mk0 x_uE hx_uE_ne_and_val0.1
    have hu_EL_val : valL F L (u_EL : L) = 0 := hx_uE_ne_and_val0.2
    have hu_EL_inv_val : valL F L ((u_EL⁻¹ : Lˣ) : L) = 0 := by
      rw [hval_inv_L u_EL, hu_EL_val, neg_zero]
    let w_uE : Eˣ := u_E * (Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹
    have hw_uE_mem : w_uE ∈ unitGroup F E 1 := by
      rw [hunit_ge1_E 1 le_rfl]
      have hy₁_eq : (w_uE : E) - 1 =
          ((u_E : E) - IntermediateField.inclusion hLE x_uE) *
            (((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹ : Eˣ) : E) := by
        dsimp only [w_uE]
        have h_mul :
            IntermediateField.inclusion hLE x_uE *
              (((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹ : Eˣ) : E) = 1 := by
          change ((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL : Eˣ) : E) *
            (((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹ : Eˣ) : E) = 1
          exact Units.mul_inv _
        calc (u_E : E) * (((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹ : Eˣ) : E) - 1
            = (u_E : E) * (((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹ : Eˣ) : E) -
                IntermediateField.inclusion hLE x_uE *
                  (((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹ : Eˣ) : E) := by
              rw [h_mul]
          _ = ((u_E : E) - IntermediateField.inclusion hLE x_uE) *
                (((Units.map (IntermediateField.inclusion hLE).toMonoidHom u_EL)⁻¹ : Eˣ) : E) := by
              ring
      rcases hr_uE with h0 | hge1
      · left
        apply sub_eq_zero.mp
        rw [hy₁_eq, h0, zero_mul]
      · by_cases h0 : (u_E : E) - IntermediateField.inclusion hLE x_uE = 0
        · left
          apply sub_eq_zero.mp
          rw [hy₁_eq, h0, zero_mul]
        · right
          rw [hy₁_eq, hval_mul_E _ _ h0 (Units.ne_zero _),
            hval_inv_E, hcoe_inc_unit u_EL,
            hValAlgE (u_EL : L), hu_EL_val]
          omega

    let w_EL_inv : Lˣ := ((u_EL⁻¹) ^ q) * (u_E_norm⁻¹)⁻¹
    have hw_EL_inv_mem : w_EL_inv ∈ unitGroup F L 1 := by
      have hw_EL_eq : w_EL_inv = Units.map (normLM F hLE) w_uE * w_ratio := by
        have hw_uE_norm :
            Units.map (normLM F hLE) w_uE =
              Units.map (normLM F hLE) u_E * (u_EL ^ q)⁻¹ := by
          dsimp only [w_uE]
          rw [map_mul, map_inv, hnorm_inc_unit_LE u_EL, hFinE_eq]
        change ((u_EL⁻¹) ^ q) * (u_E_norm⁻¹)⁻¹ = Units.map (normLM F hLE) w_uE * w_ratio
        rw [inv_inv, hu_E_norm_eq, hw_uE_norm, inv_pow]
        exact hgrp_wEL_id (Units.map (normLM F hLE) u_E) (u_EL ^ q) w_ratio
      rw [hw_EL_eq]
      exact Subgroup.mul_mem (unitGroup F L 1) (hNorm_unit1_E w_uE hw_uE_mem) hw_ratio_mem

    have hu_EL_inv_pow_val : valL F L (((u_EL⁻¹) ^ q : Lˣ) : L) = 0 := by
      rw [hval_unit_pow_L (u_EL⁻¹) q, hu_EL_inv_val, mul_zero]
    have hu_EL_inv_pow_int : PL 0 (((u_EL⁻¹) ^ q : Lˣ) : L) := hPL_of_val hu_EL_inv_pow_val
    have hu_EL_inv_pow_res :
        resL (((u_EL⁻¹) ^ q : Lˣ) : L) = (resL (u_E_norm : L))⁻¹ := by
      rw [← hu_E_norm_inv_res]
      apply hresL_eq_of_mem1 hu_EL_inv_pow_int hu_E_norm_inv_int
      have hdiff_eq :
          (((u_EL⁻¹) ^ q : Lˣ) : L) - ((u_E_norm⁻¹ : Lˣ) : L) =
            ((w_EL_inv : L) - 1) * ((u_E_norm⁻¹ : Lˣ) : L) := by
        have h_mul : (((u_E_norm⁻¹)⁻¹ : Lˣ) : L) * ((u_E_norm⁻¹ : Lˣ) : L) = 1 :=
          Units.inv_mul u_E_norm⁻¹
        change (((u_EL⁻¹) ^ q : Lˣ) : L) - ((u_E_norm⁻¹ : Lˣ) : L) =
          (((((u_EL⁻¹) ^ q) * (u_E_norm⁻¹)⁻¹ : Lˣ) : L) - 1) * ((u_E_norm⁻¹ : Lˣ) : L)
        rw [Units.val_mul, sub_mul, mul_assoc, h_mul, mul_one, one_mul]
      rw [hdiff_eq]
      have hw_mem1 : PL 1 ((w_EL_inv : L) - 1) := by
        rcases (hunit_ge1_L 1 le_rfl w_EL_inv).mp hw_EL_inv_mem with h1 | hge1
        · left; exact sub_eq_zero.mpr h1
        · right; exact hge1
      exact hPL_mul10 hw_mem1 hu_E_norm_inv_int
    exact ⟨u_E, u_EL, rfl, hu_E_val, hu_E_norm_val, hu_E_norm_res,
      hu_EL_inv_val, hu_EL_inv_pow_val, hu_EL_inv_pow_res, hr_uE⟩

  obtain ⟨u_E, u_EL, hu_E_def, hu_E_val, hu_E_norm_val, hu_E_norm_res,
    hu_EL_inv_val, hu_EL_inv_pow_val, hu_EL_inv_pow_res, hr_uE⟩ := hs5
  have hu_EL_inv_int : PL 0 ((u_EL⁻¹ : Lˣ) : L) := hPL_of_val hu_EL_inv_val
  have hu_EL_inv_pow_int : PL 0 (((u_EL⁻¹) ^ q : Lˣ) : L) := hPL_of_val hu_EL_inv_pow_val

  
  let liftL : k_L → L := fun a => Classical.choose (hresL_surj a)
  have hliftL_int : ∀ a : k_L, PL 0 (liftL a) :=
    fun a => (Classical.choose_spec (hresL_surj a)).1
  have hliftL_res : ∀ a : k_L, resL (liftL a) = a :=
    fun a => (Classical.choose_spec (hresL_surj a)).2

  have hinc_int : ∀ {x : L}, PL 0 x → PE 0 (IntermediateField.inclusion hLE x) := by
    intro x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hValAlgE x]
      exact mul_nonneg (by omega) hx
  have hinc_mem1 : ∀ {x : L}, PL 1 x → PE 1 (IntermediateField.inclusion hLE x) := by
    intro x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hValAlgE x]
      have hq_int : (1 : ℤ) ≤ (q : ℤ) := by exact_mod_cast hq_ge1
      nlinarith

  let ι_fun : k_L → k_E := fun a => resE (IntermediateField.inclusion hLE (liftL a))
  have hι_fun_spec : ∀ x : L, PL 0 x →
      resE (IntermediateField.inclusion hLE x) = ι_fun (resL x) := by
    intro x hx
    dsimp only [ι_fun]
    apply hresE_eq_of_mem1 (hinc_int hx) (hinc_int (hliftL_int (resL x)))
    rw [← map_sub]
    exact hinc_mem1 (hresL_sub_mem1 hx (hliftL_int (resL x)) (hliftL_res (resL x)).symm)

  let ι_EL : k_L →+* k_E :=
    { toFun := ι_fun
      map_zero' := by
        rw [← hresL_0, ← hι_fun_spec 0 (hPL_zero 0), map_zero, hresE_0]
      map_one' := by
        rw [← hresL_1, ← hι_fun_spec 1 hPL_one, map_one, hresE_1]
      map_add' := fun a₁ a₂ => by
        set x₁ := liftL a₁
        set x₂ := liftL a₂
        have hx₁ : PL 0 x₁ := hliftL_int a₁
        have hx₂ : PL 0 x₂ := hliftL_int a₂
        have hsum_res : a₁ + a₂ = resL (x₁ + x₂) := by
          rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res a₁, hliftL_res a₂]
        rw [hsum_res, ← hι_fun_spec (x₁ + x₂) (hPL_add hx₁ hx₂),
          ← hliftL_res a₁, ← hliftL_res a₂,
          ← hι_fun_spec x₁ hx₁, ← hι_fun_spec x₂ hx₂, map_add,
          (hresE_ring _ _ (hinc_int hx₁) (hinc_int hx₂)).1]
      map_mul' := fun a₁ a₂ => by
        set x₁ := liftL a₁
        set x₂ := liftL a₂
        have hx₁ : PL 0 x₁ := hliftL_int a₁
        have hx₂ : PL 0 x₂ := hliftL_int a₂
        have hmul_res : a₁ * a₂ = resL (x₁ * x₂) := by
          rw [(hresL_ring x₁ x₂ hx₁ hx₂).2.1, hliftL_res a₁, hliftL_res a₂]
        rw [hmul_res, ← hι_fun_spec (x₁ * x₂) (hPL_mul00 hx₁ hx₂),
          ← hliftL_res a₁, ← hliftL_res a₂,
          ← hι_fun_spec x₁ hx₁, ← hι_fun_spec x₂ hx₂, map_mul,
          (hresE_ring _ _ (hinc_int hx₁) (hinc_int hx₂)).2.1] }

  have hι_EL_surj : Function.Surjective ι_EL := by
    intro b
    obtain ⟨y, hy_int, hy_res⟩ := hresE_surj b
    obtain ⟨x, hx_int, hyx⟩ := hResLiftE y hy_int
    refine ⟨resL x, ?_⟩
    change ι_fun (resL x) = b
    rw [← hι_fun_spec x hx_int, ← hy_res]
    exact (hresE_eq_of_mem1 hy_int (hinc_int hx_int) hyx).symm

  let e_EL : k_L ≃ k_E := Equiv.ofBijective ι_EL ⟨ι_EL.injective, hι_EL_surj⟩
  have he_EL_apply : ∀ a : k_L, e_EL a = ι_EL a := fun _ => rfl

  have hresL_pow : ∀ (x : L) (n : ℕ), PL 0 x → PL 0 (x ^ n) ∧ resL (x ^ n) = (resL x) ^ n := by
    intro x n hx
    induction n with
    | zero =>
      rw [pow_zero, pow_zero, hresL_1]
      exact ⟨hPL_one, rfl⟩
    | succ n ih =>
      have hxn_int : PL 0 (x ^ (n + 1)) := by
        rw [pow_succ]
        exact hPL_mul00 ih.1 hx
      refine ⟨hxn_int, ?_⟩
      rw [pow_succ, pow_succ, (hresL_ring (x ^ n) x ih.1 hx).2.1, ih.2]

  have hfrob_add : ∀ x y : k_L, (x + y) ^ q = x ^ q + y ^ q := by
    suffices h_gen : ∀ (p_0 : ℕ), Nat.Prime p_0 → ((p_0 : ℕ) : k_L) = 0 →
        ∀ x y : k_L, (x + y) ^ (p_0 ^ r_exp) = x ^ (p_0 ^ r_exp) + y ^ (p_0 ^ r_exp) by
      intro x y
      rw [hq_pow']
      exact h_gen (p F) hp hp_char x y
    clear * -
    intro p_0 hp_0 hp_0_char x y
    haveI : Fact (Nat.Prime p_0) := ⟨hp_0⟩
    have hring_kL : ringChar k_L = p_0 := CharP.ringChar_of_prime_eq_zero hp_0 hp_0_char
    haveI : CharP k_L p_0 := CharP.mk (fun z => by rw [← hring_kL]; exact ringChar.spec k_L z)
    exact add_pow_char_pow x y p_0 r_exp

  let frob_q : k_L →+* k_L :=
    { toFun := fun b => b ^ q
      map_zero' := zero_pow hq_pos.ne'
      map_one' := one_pow q
      map_add' := hfrob_add
      map_mul' := fun x y => mul_pow x y q }
  let e_frob : k_L ≃ k_L :=
    Equiv.ofBijective frob_q
      ((Fintype.bijective_iff_injective_and_card frob_q).mpr ⟨frob_q.injective, rfl⟩)
  have he_frob_apply : ∀ b : k_L, e_frob b = frob_q b := fun _ => rfl

  have hodd_E_gauss :
      a_E % 2 = 1 →
      oddStatGaussFactor F E χ'_E k_E ψ_0E =
        ((quadraticChar k_L (resL (u_E_norm : L)) : ℤ) : Ω F) *
          ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) := by
    intro hodd
    have hdiv2 : 2 * (a_E / 2) = a_E - 1 := by omega
    have h_units_E : c'_χ'E⁻¹ * (ϖ_E ^ (2 * (a_E / 2))) = c_E⁻¹ * u_E⁻¹ := by
      rw [hdiv2, hu_E_def]
      exact hgrp_uE_inv_id (ϖ_E ^ (a_E - 1)) c_E c'_χ'E
    have h_val_E : ∀ y : E,
        ((c'_χ'E⁻¹ : Eˣ) : E) * (((ϖ_E ^ (2 * (a_E / 2)) : Eˣ) : E) * y) =
          ((c_E⁻¹ : Eˣ) : E) * (((u_E⁻¹ : Eˣ) : E) * y) := by
      intro y
      have hcoe := congrArg (fun v : Eˣ => (v : E)) h_units_E
      simp only [Units.val_mul] at hcoe
      calc ((c'_χ'E⁻¹ : Eˣ) : E) * (((ϖ_E ^ (2 * (a_E / 2)) : Eˣ) : E) * y)
          = (((c'_χ'E⁻¹ : Eˣ) : E) * ((ϖ_E ^ (2 * (a_E / 2)) : Eˣ) : E)) * y := by ring
        _ = (((c_E⁻¹ : Eˣ) : E) * ((u_E⁻¹ : Eˣ) : E)) * y := by rw [hcoe]
        _ = ((c_E⁻¹ : Eˣ) : E) * (((u_E⁻¹ : Eˣ) : E) * y) := by ring
    have hu_E_inv_val : valL F E ((u_E⁻¹ : Eˣ) : E) = 0 := by
      rw [hval_inv_E u_E, hu_E_val, neg_zero]
    have hu_E_inv_int : PE 0 ((u_E⁻¹ : Eˣ) : E) := hPE_of_val hu_E_inv_val
    have h_uE_inv_diff :
        PE 1 (((u_E⁻¹ : Eˣ) : E) - IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L)) := by
      have h_id :
          ((u_E⁻¹ : Eˣ) : E) - IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L) =
            - (((u_E⁻¹ : Eˣ) : E) * IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L) *
              ((u_E : E) - IntermediateField.inclusion hLE (u_EL : L))) := by
        have h1 : ((u_E⁻¹ : Eˣ) : E) * (u_E : E) = 1 := Units.inv_mul u_E
        have h2 : IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L) *
            IntermediateField.inclusion hLE (u_EL : L) = 1 := by
          rw [← map_mul, Units.inv_mul, map_one]
        calc ((u_E⁻¹ : Eˣ) : E) - IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L)
            = ((u_E⁻¹ : Eˣ) : E) *
                (IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L) *
                  IntermediateField.inclusion hLE (u_EL : L)) -
              (((u_E⁻¹ : Eˣ) : E) * (u_E : E)) *
                IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L) := by
                rw [h1, h2, mul_one, one_mul]
          _ = - (((u_E⁻¹ : Eˣ) : E) * IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L) *
                ((u_E : E) - IntermediateField.inclusion hLE (u_EL : L))) := by ring
      rw [h_id]
      apply hPE_neg
      have h_unit_prod_int :
          PE 0 (((u_E⁻¹ : Eˣ) : E) * IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L)) :=
        hPE_mul00 hu_E_inv_int (hinc_int hu_EL_inv_int)
      exact hPE_mul01 h_unit_prod_int hr_uE
    have hψ0E_eq : ∀ a : k_L, ψ_0E (ι_EL a) = ψ_ref ((resL (u_E_norm : L))⁻¹ * (a ^ q)) := by
      intro a
      set x := liftL a
      have hx_int : PL 0 x := hliftL_int a
      let y₀ : E := ((u_E⁻¹ : Eˣ) : E) * IntermediateField.inclusion hLE x
      let x₀ : L := ((u_EL⁻¹ : Lˣ) : L) * x
      have hy₀_int : PE 0 y₀ :=
        hPE_mul00 hu_E_inv_int (hinc_int hx_int)
      have hx₀_int : PL 0 x₀ :=
        hPL_mul00 hu_EL_inv_int hx_int
      have hyx₀ : PE 1 (y₀ - IntermediateField.inclusion hLE x₀) := by
        have h_eq :
            y₀ - IntermediateField.inclusion hLE x₀ =
              (((u_E⁻¹ : Eˣ) : E) - IntermediateField.inclusion hLE ((u_EL⁻¹ : Lˣ) : L)) *
                IntermediateField.inclusion hLE x := by
          dsimp only [y₀, x₀]
          rw [map_mul]
