    have huP₁₂_raw := hvalM₁'_mul_ge ((k : ℤ) * (p : ℤ) * (m_u : ℤ)) B_v1
      (IntermediateField.inclusion hLM₁' (u ^ k)) (P₁_k + P₂_k) huk_M_val hP₁₂_bound
    have htarget_le_v1 : (p : ℤ) * (a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) ≤
        (k : ℤ) * (p : ℤ) * (m_u : ℤ) + B_v1 := by
      have hpm_z : (t₁ : ℤ) + 1 ≤ (p : ℤ) * (m_u : ℤ) := by
        dsimp [t₁, m_u]
        exact_mod_cast hpm_gt_t₁
      have hk_ge2_z : (2 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk2_bounds.1
      have hp1_z : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
      have hpk_z : ((p - 3 + k : ℕ) : ℤ) = (p : ℤ) - 3 + (k : ℤ) := by omega
      have halam_z : (a_lam : ℤ) = (t₂ : ℤ) + 1 + (m_u : ℤ) := by
        dsimp [t₂, m_u]
