    have hdiv_odd : ((2 * (condExp F M θ / 2) : ℕ) : ℤ) = (condExp F M θ : ℤ) - 1 := by omega
    rw [hc₀_valM, hc_val, hnM, hdiv_odd]
    ring
  have hv_θ_int : (v_θ : M) = 0 ∨ 0 ≤ valL F M (v_θ : M) := Or.inr (by rw [hv_θ_val])
  have hv_θ_res_ne : resM (v_θ : M) ≠ 0 := by
    intro h0
    rcases (hresM_ker (v_θ : M) hv_θ_int).mp h0 with hzero | hge1
    · exact Units.ne_zero v_θ hzero
    · omega
  have hψ_0θ_eq : ∀ a : k_M,
      ψ_0θ a = ψ_ref (Algebra.trace k_L k_M ((k : k_M) * resM (v_θ : M) * a)) := by
    intro a
    obtain ⟨y, hy_int, hy_res⟩ := hresM_surj a
    have hvy_int : (v_θ : M) * y = 0 ∨ 0 ≤ valL F M ((v_θ : M) * y) :=
      hmul_int_M (v_θ : M) y hv_θ_int hy_int
    have hvy_res : resM ((v_θ : M) * y) = resM (v_θ : M) * a := by
      rw [(hresM_ring (v_θ : M) y hv_θ_int hy_int).2.1, hy_res]
    have hunit_eq :
        (((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * (condExp F M θ / 2)) : Mˣ) : M) * y)) =
        IntermediateField.inclusion hLM (((c₀⁻¹ : Lˣ) : L)) * ((v_θ : M) * y) := by
      have hc₀_inv_mul :
          IntermediateField.inclusion hLM (((c₀⁻¹ : Lˣ) : L)) *
            IntermediateField.inclusion hLM (c₀ : L) = 1 := by
        rw [← map_mul, Units.inv_mul, map_one]
      change (((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * (condExp F M θ / 2)) : Mˣ) : M) * y)) =
        IntermediateField.inclusion hLM (((c₀⁻¹ : Lˣ) : L)) *
          ((IntermediateField.inclusion hLM (c₀ : L) * ((c'_θ⁻¹ : Mˣ) : M) *
            ((ϖ_M ^ (2 * (condExp F M θ / 2)) : Mˣ) : M)) * y)
      linear_combination -(((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * (condExp F M θ / 2)) : Mˣ) : M) * y)) * hc₀_inv_mul
    have hsmul_tr :
        (k : k_L) * Algebra.trace k_L k_M (resM (v_θ : M) * a) =
          Algebra.trace k_L k_M ((k : k_M) * resM (v_θ : M) * a) := by
      calc
        (k : k_L) * Algebra.trace k_L k_M (resM (v_θ : M) * a)
          = (k : k_L) • Algebra.trace k_L k_M (resM (v_θ : M) * a) := (smul_eq_mul _ _).symm
        _ = Algebra.trace k_L k_M ((k : k_L) • (resM (v_θ : M) * a)) :=
            ((Algebra.trace k_L k_M).map_smul _ _).symm
        _ = Algebra.trace k_L k_M ((k : k_M) * resM (v_θ : M) * a) := by
            rw [Algebra.smul_def, map_natCast, mul_assoc]
    conv_lhs => rw [← hy_res]
    rw [hstat y hy_int, hunit_eq]
    change ψ (traceLM F hLM (IntermediateField.inclusion hLM (((c₀⁻¹ : Lˣ) : L)) * ((v_θ : M) * y))) = _
    rw [htrace_smul (((c₀⁻¹ : Lˣ) : L)) ((v_θ : M) * y)]
    obtain ⟨htr_vy_int, htr_vy_res⟩ := htrace_res ((v_θ : M) * y) hvy_int
    rw [← hψ_ref_spec (traceLM F hLM ((v_θ : M) * y)) htr_vy_int, htr_vy_res, hvy_res, hsmul_tr]
  refine ⟨hv_θ_val, hv_θ_res_ne, ?_⟩
  unfold oddStatGaussFactor
  rw [if_pos hodd]
  have hsum_eq :
      (∑ x : k_M, ψ_0θ ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ * (x ^ 2))) =
      (∑ x : k_M,
        ψ_ref (Algebra.trace k_L k_M
          ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ *
            (((k : k_M) * resM (v_θ : M)) * (x ^ 2))))) := by
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [hψ_0θ_eq]
    congr 2
    ring
  have hq_pow :
      (qL F M : Ω F) ^ ((p F - 1) / 2) =
        ((qL F L : Ω F) ^ ((p F - 1) / 2)) ^ f_M := by
    rw [hq_M, Nat.cast_pow, ← pow_mul, mul_comm f_M ((p F - 1) / 2), pow_mul]
  rw [hsum_eq, hHD_ext ((k : k_M) * resM (v_θ : M)) (mul_ne_zero hk_M_ne hv_θ_res_ne),
    hfinrank_res, hq_pow]
  change
    ((qL F L : Ω F) ^ ((p F - 1) / 2)) ^ f_M *
      (((((-1 : ℤ) ^ (f_M - 1) *
        quadraticChar k_L (Algebra.norm k_L ((k : k_M) * resM (v_θ : M))) : ℤ) : Ω F) *
        (∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))) ^ f_M)) =
    (((-1 : ℤ) ^ (f_M - 1) *
      quadraticChar k_L (Algebra.norm k_L ((k : k_M) * resM (v_θ : M))) : ℤ) : Ω F) *
      ((qL F L : Ω F) ^ ((p F - 1) / 2) *
        (∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2)))) ^ f_M
  ring

theorem ld_ch14_odd_p_local_to_residue_trace_and_reference_gauss (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    (hp_ne2 : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hSepFiMC : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)))
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (hLtFi : ∀ i : Fin D_orb.length, L < (D_orb.get i).field)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hFi_ram : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x))
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_orb : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      2 ≤ condExp F F_i (μ'_orb i) ∧
      2 ≤ condExp F F_i θ_i ∧
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)) ∧
      valL F F_i (c'_θ i : F_i) =
        (condExp F F_i θ_i : ℤ) + condExpChar F F_i ψ_Fi ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i θ_i - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (θ_i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_θ i)⁻¹ : F_iˣ) : F_i) * x)))
    (k_L : Type u) [Field k_L] [Fintype k_L]
    (resL : L → k_L) (ψ_0L : AddChar k_L (Ω F))
    (k_Fi : Fin D_orb.length → Type u)
    [∀ i, Field (k_Fi i)] [∀ i, Fintype (k_Fi i)]
    (resFi : ∀ i : Fin D_orb.length, (D_orb.get i).field → k_Fi i)
    (ϖ_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (ψ_0μ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (ψ_0θ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (hresL_props :
      IsResidueFieldMap F L k_L resL ∧
      IsStatResChar F L ψ χ' ϖ_L c'_χ' k_L resL ψ_0L)
    (hresFi_props : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      valL F F_i (ϖ_Fi i : F_i) = 1 ∧
      IsResidueFieldMap F F_i (k_Fi i) (resFi i) ∧
      IsStatResChar F F_i ψ_Fi (μ'_orb i) (ϖ_Fi i) (c'_μ i) (k_Fi i) (resFi i) (ψ_0μ i) ∧
      IsStatResChar F F_i ψ_Fi θ_i (ϖ_Fi i) (c'_θ i) (k_Fi i) (resFi i) (ψ_0θ i))
    (hHD_quad : ∀ (hp_char : ((p F : ℕ) : k_L) = 0)
      (ψ_ref : AddChar k_L (Ω F)), ψ_ref ≠ 1 →
      let G_L : Ω F :=
        ∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))
      G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : Ω F) * (Fintype.card k_L : Ω F) ∧
      (∀ a : k_L, a ≠ 0 →
        (∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (a * (x ^ 2)))) =
          ((quadraticChar k_L a : ℤ) : Ω F) * G_L) ∧
      (∀ (k_M : Type u) [Field k_M] [Fintype k_M] [Algebra k_L k_M] (b : k_M),
        b ≠ 0 →
        (∑ y : k_M,
          ψ_ref (Algebra.trace k_L k_M
            ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ * (b * (y ^ 2))))) =
          (((-1 : ℤ) ^ (Module.finrank k_L k_M - 1) *
            quadraticChar k_L (Algebra.norm k_L b) : ℤ) : Ω F) *
            G_L ^ (Module.finrank k_L k_M))) :
    let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
    let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
    ∃ (hp_char : ((p F : ℕ) : k_L) = 0)
      (ψ_ref : AddChar k_L (Ω F))
      (hAlg_Fi : ∀ i : Fin D_orb.length, Algebra k_L (k_Fi i)),
      letI : ∀ i, Algebra k_L (k_Fi i) := hAlg_Fi
      let G_L : Ω F :=
        ∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))
      Fintype.card k_L = qL F L ∧
      ψ_ref ≠ 1 ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ψ_ref (resL x) = ψ (((c₀⁻¹ : Lˣ) : L) * x)) ∧
      G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : Ω F) * (qL F L : Ω F) ∧
      valL F L (u_χ' : L) = 0 ∧
      resL (u_χ' : L) ≠ 0 ∧
      (condExp F L χ' % 2 = 1 →
        oddStatGaussFactor F L χ' k_L ψ_0L =
          ((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)) ∧
      (∀ i : Fin D_orb.length,
        let F_i := (D_orb.get i).field
        let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
        let f_i := Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k
        let v_μ : F_iˣ :=
          Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
            (c'_μ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i (μ'_orb i) / 2)))
        let v_θ : F_iˣ :=
          Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
            (c'_θ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i θ_i / 2)))
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F F_i = f_i * resDeg F L ∧
        qL F F_i = (qL F L) ^ f_i ∧
        Fintype.card (k_Fi i) = qL F F_i ∧
        Module.finrank k_L (k_Fi i) = f_i ∧
        (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
          resFi i (IntermediateField.inclusion (D_orb.get i).le x) =
            algebraMap k_L (k_Fi i) (resL x)) ∧
        (∀ z : F_i, (z = 0 ∨ 0 ≤ valL F F_i z) →
          resL (traceLM F (D_orb.get i).le z) =
            (k : k_L) * Algebra.trace k_L (k_Fi i) (resFi i z)) ∧
        (condExp F F_i (μ'_orb i) % 2 = 1 →
          valL F F_i (v_μ : F_i) = 0 ∧
          resFi i (v_μ : F_i) ≠ 0 ∧
          oddStatGaussFactor F F_i (μ'_orb i) (k_Fi i) (ψ_0μ i) =
            (((-1 : ℤ) ^ (f_i - 1) *
              quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_μ : F_i))) : ℤ) : Ω F) *
              ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i) ∧
        (condExp F F_i θ_i % 2 = 1 →
          valL F F_i (v_θ : F_i) = 0 ∧
          resFi i (v_θ : F_i) ≠ 0 ∧
          oddStatGaussFactor F F_i θ_i (k_Fi i) (ψ_0θ i) =
            (((-1 : ℤ) ^ (f_i - 1) *
              quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_θ : F_i))) : ℤ) : Ω F) *
              ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i)) :=
by
  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hadd1, hadd_neg, hadd_mul, hadd_inv, halgL_0, halgL_1, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ := hresL_props.1
  obtain ⟨hcard_kL, hp_char, _⟩ :=
    ld_valL_residue_field_card_eq_qL F L
      ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add⟩
      ⟨hadd1, hadd_neg, hadd_mul, hadd_inv, halgL_0, halgL_1⟩
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨ψ_ref, hψ_ref_ne, hψ_ref_spec, hG_L_sq, hu_χ'_val, hu_χ'_res, hL_gauss_eq⟩ :=
    ld_ch14_odd_p_base_ref_char_and_gauss_factor F L ψ hψ χ' h_ge2 ϖ_L hϖ_L c'_χ' hc_L_val
      k_L resL ψ_0L hresL_props hcard_kL hp_char
      (fun ψ_ref' hψ_ref' => ⟨(hHD_quad hp_char ψ_ref' hψ_ref').1, (hHD_quad hp_char ψ_ref' hψ_ref').2.1⟩)
  have hFi_s3 : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let f_i := Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k
      1 ≤ f_i ∧
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
      resDeg F F_i = f_i * resDeg F L ∧
      Fintype.card (k_Fi i) = qL F F_i ∧
      qL F F_i = (qL F L) ^ f_i ∧
      (∀ x : L, valL F F_i (IntermediateField.inclusion (D_orb.get i).le x) = (k : ℤ) * valL F L x) ∧
      ∃ (hAlg : Algebra k_L (k_Fi i)),
        letI : Algebra k_L (k_Fi i) := hAlg
        Module.finrank k_L (k_Fi i) = f_i ∧
        (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
          resFi i (IntermediateField.inclusion (D_orb.get i).le x) = algebraMap k_L (k_Fi i) (resL x)) ∧
        (∀ (e : Module.Basis (Fin f_i) k_L (k_Fi i)) (u : Fin f_i → F_i),
          (∀ r : Fin f_i, u r = 0 ∨ 0 ≤ valL F F_i (u r)) →
          (∀ r : Fin f_i, resFi i (u r) = e r) →
          let w : Fin f_i × Fin k → IntermediateField.extendScalars (D_orb.get i).le :=
            fun p => toExtendScalars F (D_orb.get i).le (u p.1 * (((ϖ_Fi i) ^ (p.2 : ℕ) : F_iˣ) : F_i))
          LinearIndependent L w ∧
          ∀ (g : Fin f_i × Fin k → L) (s₀ : Fin k),
            ((∑ p : Fin f_i × Fin k,
                IntermediateField.inclusion (D_orb.get i).le (g p) *
                  (u p.1 * (((ϖ_Fi i) ^ (p.2 : ℕ) : F_iˣ) : F_i))) = 0 ∨
              ((s₀ : ℕ) + 1 : ℤ) ≤
                valL F F_i
                  (∑ p : Fin f_i × Fin k,
                    IntermediateField.inclusion (D_orb.get i).le (g p) *
                      (u p.1 * (((ϖ_Fi i) ^ (p.2 : ℕ) : F_iˣ) : F_i)))) →
            ∀ r : Fin f_i, g (r, s₀) = 0 ∨ 1 ≤ valL F L (g (r, s₀))) := by
    intro i
    let F_i := (D_orb.get i).field
    haveI : FiniteDimensional F F_i := hFinFi i
    obtain ⟨_, _, _, _, _, _, _, f₀, hf₀_ge1, hfin_eq, hres_eq, hValNorm_Fi⟩ := hFi_ram i
    have hfi_eq : Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k = f₀ := by
      rw [hfin_eq, Nat.mul_div_right f₀ (by omega)]
    obtain ⟨hvalM_0, hvalM_1, hvalM_neg1, hvalM_neg, hvalM_mul, hvalM_inv, hvalM_surj, hvalM_add, _, _, _⟩ :=
      ld_valL_and_unitGroup_props F F_i
    obtain ⟨_, _, _, _, halgM_0, halgM_1, _⟩ :=
      ld_addVal_finset_and_algebraMap_valL F F_i
    obtain ⟨hϖ_Fi_val, ⟨hresM_0, hresM_1, hresM_ring, hresM_ker, hresM_surj⟩, _, _⟩ := hresFi_props i
    obtain ⟨hcard_kFi, _, _⟩ :=
      ld_valL_residue_field_card_eq_qL F F_i
        ⟨hvalM_0, hvalM_1, hvalM_neg1, hvalM_neg, hvalM_mul, hvalM_inv, hvalM_surj, hvalM_add⟩
        ⟨hadd1, hadd_neg, hadd_mul, hadd_inv, halgM_0, halgM_1⟩
        (k_Fi i) (resFi i) hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
    have hf_i_ge1 : 1 ≤ Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k := by
      rw [hfi_eq]; exact hf₀_ge1
    have hfin_fi : Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) =
        k * (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k) := by
      rw [hfi_eq]; exact hfin_eq
    have hres_fi : resDeg F F_i =
        (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k) * resDeg F L := by
      rw [hfi_eq]; exact hres_eq
    have hValNorm_fi : ∀ z : F_i, valL F L (normLM F (D_orb.get i).le z) =
        ((Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k : ℕ) : ℤ) * valL F F_i z := by
      intro z; rw [hfi_eq]; exact hValNorm_Fi z
    obtain ⟨hq_Fi, hValAlg_Fi, hex_Alg⟩ :=
      ld_ch14_local_to_residue_algebra_and_basis_val F L F_i (D_orb.get i).le
        k (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k)
        hk_ge1 hf_i_ge1 hfin_fi hres_fi hValNorm_fi (ϖ_Fi i) hϖ_Fi_val
        k_L (k_Fi i) resL (resFi i) hresL_props.1 (hresFi_props i).2.1 hcard_kL hcard_kFi
    exact ⟨hf_i_ge1, hfin_fi, hres_fi, hcard_kFi, hq_Fi, hValAlg_Fi, hex_Alg⟩
  let hAlg_Fi : ∀ i : Fin D_orb.length, Algebra k_L (k_Fi i) :=
    fun i => (hFi_s3 i).2.2.2.2.2.2.choose
  letI : ∀ i, Algebra k_L (k_Fi i) := hAlg_Fi
  refine ⟨hp_char, ψ_ref, hAlg_Fi, hcard_kL, hψ_ref_ne, hψ_ref_spec, hG_L_sq,
    hu_χ'_val, hu_χ'_res, hL_gauss_eq, ?_⟩
  intro i
  let F_i := (D_orb.get i).field
  haveI : FiniteDimensional F F_i := hFinFi i
  obtain ⟨hf_i_ge1, hfin_fi, hres_fi, hcard_kFi, hq_Fi, hValAlg_Fi, _⟩ := hFi_s3 i
  obtain ⟨hfinrank_res, hres_alg, hBasis_val⟩ := (hFi_s3 i).2.2.2.2.2.2.choose_spec
  obtain ⟨htrace_res, hstat_gauss⟩ :=
    ld_ch14_local_to_residue_trace_and_stat_gauss F L F_i (D_orb.get i).le ψ (hψFi i)
      k (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k)
      hk_ge1 hf_i_ge1 hfin_fi hq_Fi hValAlg_Fi (hFi_ram i).2.2.2.2.2.2.1
      ϖ_L hϖ_L (ϖ_Fi i) (hresFi_props i).1 k_L (k_Fi i) resL (resFi i)
      hresL_props.1 (hresFi_props i).2.1 hfinrank_res hres_alg hBasis_val
      ψ_ref hψ_ref_spec ((hHD_quad hp_char ψ_ref hψ_ref_ne).2.2 (k_Fi i))
  refine ⟨hf_i_ge1, hfin_fi, hres_fi, hq_Fi, hcard_kFi, hfinrank_res, hres_alg, htrace_res, ?_, ?_⟩
  · exact hstat_gauss (μ'_orb i) (c'_μ i) (ψ_0μ i)
      (hc_orb i).2.2.1 (hresFi_props i).2.2.1
  · exact hstat_gauss (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) (c'_θ i) (ψ_0θ i)
      (hc_orb i).2.2.2.2.1 (hresFi_props i).2.2.2

theorem ld_ch14_odd_p_pullback_units_on_MC_and_total_ram_K (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E) (hEK : E ≤ K)
    (hGalMCK : IsGaloisExt F M_C K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_Cˣ →* (Ω F)ˣ))
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hν_inj : Function.Injective ν_all)
    (hν_props : ∀ j,
      ν_all j ≠ 1 ∧
      (ν_all j) ^ (p F) = 1 ∧
      (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
      (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
      (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
      (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
      ∀ w : M_Cˣ,
        (ν_all j) w =
          ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
            (Units.map (σ_all j).toRingEquiv.toMonoidHom w))
    (hν_prod : ∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_orb (idx_all j))) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)))
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hFrobSurjMC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F))))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (hFi_ram : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x))
    (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_L : Lˣ)
    (hϖ_K_norm : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_MC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp) (a_coeff : Fin r_exp → M_C)
    (hq_pow : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (ha_int : ∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j))
    (hP_def : ∀ z : M_C,
      P_poly z =
        z ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
          ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ))))
    (hP_norm : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
        (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) = 0 ∨
        (t + 1 : ℤ) ≤ valL F M_C
          (normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
            (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C))))
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_μ_stat : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (c'_μ i : (D_orb.get i).field) =
        (condExp F (D_orb.get i).field (μ'_orb i) : ℤ) +
          condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) ∧
      ∀ x : (D_orb.get i).field,
        (x = 0 ∨ ((condExp F (D_orb.get i).field (μ'_orb i) - 1 : ℕ) : ℤ) ≤
          valL F (D_orb.get i).field x) →
        ∀ hx : 1 + x ≠ 0,
          (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
            (traceChar F (D_orb.get i).le ψ)
              ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * x)) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
    Module.finrank L (IntermediateField.extendScalars hLE) = q ∧
    (∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w) ∧
    (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z) ∧
    (∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z))) ∧
    ∃ (u_all_0 : Fin (q - 1) → M_Cˣ),
      (∀ j : Fin (q - 1),
        u_all_0 j =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀ *
            (ϖ_MC ^ t) *
            (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
              (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (c'_μ (idx_all j))))⁻¹) ∧
      (∏ j : Fin (q - 1), u_all_0 j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (c₀ ^ (q - 1)) *
          (ϖ_MC ^ (t * (q - 1))) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹) ∧
      (∀ j : Fin (q - 1), valL F M_C ((u_all_0 j : M_Cˣ) : M_C) = 0) ∧
      (∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
        (traceChar F hLM_C ψ)
          ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀)⁻¹ : M_Cˣ) : M_C) *
            ((u_all_0 j : M_C) * P_poly z)) = 1) ∧
      (∀ j₁ j₂ : Fin (q - 1),
        ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C) = 0 ∨
          1 ≤ valL F M_C ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C))) →
        j₁ = j₂) :=
by
  let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalMC := ld_valL_and_unitGroup_props F M_C
  have hvalK := ld_valL_and_unitGroup_props F K
  have hSpecMC := ld_condExp_and_condExpChar_spec F M_C (traceChar F hLM_C ψ) hψMC 1

  have hval_mul_ge : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (m₁ m₂ : ℤ) (x y : M),
      (x = 0 ∨ m₁ ≤ valL F M x) → (y = 0 ∨ m₂ ≤ valL F M y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F M (x * y)) := by
    intro M _ m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : m₁ ≤ valL F M x := hx.resolve_left hx0
        have hy' : m₂ ≤ valL F M y := hy.resolve_left hy0
        rw [(ld_valL_and_unitGroup_props F M).2.2.2.2.1 x y hx0 hy0]
        omega

  have hval_pow_el : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (x : M) (n : ℕ), x ≠ 0 →
      valL F M (x ^ n) = (n : ℤ) * valL F M x := by
    intro M _ x n hx
    induction' n with n ih
    · simp [(ld_valL_and_unitGroup_props F M).2.1]
    · rw [pow_succ,
        (ld_valL_and_unitGroup_props F M).2.2.2.2.1 _ _ (pow_ne_zero n hx) hx, ih]
      push_cast
      ring

  have hval_unit_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ),
      valL F M ((u ^ n : Mˣ) : M) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    rw [Units.val_pow_eq_pow_val]
    exact hval_pow_el M (u : M) n (Units.ne_zero u)

  have hval_zpow_L : ∀ (u : Lˣ) (m : ℤ),
      valL F L ((u ^ m : Lˣ) : L) = m * valL F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F L ((u ^ n : Lˣ) : L) = (n : ℤ) * valL F L (u : L)
      exact hval_unit_pow L u n
    | negSucc n =>
      change valL F L (((u ^ (n + 1))⁻¹ : Lˣ) : L) = (Int.negSucc n) * valL F L (u : L)
      rw [hvalL.2.2.2.2.2.1, hval_unit_pow L u (n + 1), Int.negSucc_eq]
      push_cast
      ring

  
  let E' := IntermediateField.extendScalars hLE
  let eF_E : E ≃ₐ[F] E' :=
    { toExtendScalars F hLE with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F E' := Module.Finite.equiv eF_E.toLinearEquiv
  haveI : IsScalarTower F L E' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L E' := Module.Finite.of_restrictScalars_finite F L E'

  have hnorm_inc_LE : ∀ x : L,
      normLM F hLE (IntermediateField.inclusion hLE x) = x ^ (Module.finrank L E') := by
    intro x
    change Algebra.norm L (algebraMap L E' x) = x ^ (Module.finrank L E')
    exact Algebra.norm_algebraMap x

  have hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) = q := by
    have h1 := hValNormE (IntermediateField.inclusion hLE (ϖ_L : L))
    rw [hnorm_inc_LE (ϖ_L : L),
      hval_pow_el L (ϖ_L : L) (Module.finrank L E') (Units.ne_zero ϖ_L),
      hValAlgE (ϖ_L : L), hϖ_L, mul_one, mul_one] at h1
    exact Nat.cast_injective h1

  
  have hp_prime : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
  obtain ⟨hq_gt1, _, ⟨e_MCK, f_MCK, he_pos, hf_pos, hef_eq, _, hnorm_f, hincl_e⟩, _⟩ :=
    ld_ch14_ef_finrank_and_residue_roots_package F L K M_C E
      (hLM_C.trans hM_CK) hLM_C hM_CK hLE hEK hp_prime r_exp hr_exp_pos hq_pow hFinE_eq
  have hq_pos : 0 < q := by omega
  have hϖ_K_norm_coe : normLM F hM_CK (ϖ_K : K) = (ϖ_MC : M_C) :=
    congrArg Units.val hϖ_K_norm
  have hf_MCK_eq1 : f_MCK = 1 := by
    have h := hnorm_f (ϖ_K : K)
    rw [hϖ_K_norm_coe, hϖ_MC, hϖ_K, mul_one] at h
    omega
  have he_MCK_eq_q : e_MCK = q := by
    rw [hf_MCK_eq1, mul_one] at hef_eq
    exact hef_eq
  have hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w := by
    intro w
    rw [hnorm_f w, hf_MCK_eq1, Nat.cast_one, one_mul]
  have hValAlgK : ∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z := by
    intro z
    rw [hincl_e z, he_MCK_eq_q]

  
  have hval_strict_K : ∀ (y₁ y₂ : K),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F K y₁ + 1 ≤ valL F K y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F K (y₁ + y₂) = valL F K y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F K y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F K y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F K (y₁ + y₂) :=
      hvalK.2.2.2.2.2.2.2.1 v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F K (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F K (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hvalK.2.2.2.1]
          exact hge
      have hy₁_gt := hvalK.2.2.2.2.2.2.2.1 (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  let K_MC' := IntermediateField.extendScalars hM_CK
  let eF_KMC : K ≃ₐ[F] K_MC' :=
    { toExtendScalars F hM_CK with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hM_CK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K_MC' := Module.Finite.equiv eF_KMC.toLinearEquiv
  haveI : IsScalarTower F M_C K_MC' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M_C K_MC' := Module.Finite.of_restrictScalars_finite F M_C K_MC'

  let t_term_K (c : Fin q → M_C) (i : Fin q) : K :=
    IntermediateField.inclusion hM_CK (c i) * ((ϖ_K : K) ^ (i : ℕ))
  let v_term_K (c : Fin q → M_C) (i : Fin q) : ℤ :=
    (q : ℤ) * valL F M_C (c i) + (i.1 : ℤ)

  have ht_term_K_zero : ∀ (c : Fin q → M_C) (i : Fin q), c i = 0 → t_term_K c i = 0 := by
    intro c i hci
    dsimp [t_term_K]
    rw [hci, map_zero, zero_mul]

  have ht_term_K_nz : ∀ (c : Fin q → M_C) (i : Fin q),
      c i ≠ 0 → t_term_K c i ≠ 0 ∧ valL F K (t_term_K c i) = v_term_K c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hM_CK (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hM_CK).toRingHom).ne hci
    have hpow_ne : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term_K, v_term_K]
    rw [hvalK.2.2.2.2.1 _ _ hinc_ne hpow_ne, hValAlgK (c i),
      hval_pow_el K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_one]

  have hv_term_K_inj : ∀ (c : Fin q → M_C) (i j : Fin q),
      v_term_K c i = v_term_K c j → i = j := by
    intro c i j hij
    have hmod : ∀ m : Fin q, v_term_K c m % (q : ℤ) = (m.1 : ℤ) := by
      intro m
      dsimp [v_term_K]
      have hcomm : (q : ℤ) * valL F M_C (c m) + (m.1 : ℤ) =
          (m.1 : ℤ) + (q : ℤ) * valL F M_C (c m) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg m.1) (Nat.cast_lt.mpr m.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_K_ge : ∀ (c : Fin q → M_C) (S : Finset (Fin q)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term_K c i) →
        ((∑ i ∈ S, t_term_K c i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, t_term_K c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term_K c a = 0 ∨ m ≤ valL F K (t_term_K c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_K_zero c a hca)
        · right
          rw [(ht_term_K_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hvalK.2.2.2.2.2.2.2.1 m (t_term_K c a) (∑ i ∈ s, t_term_K c i) ha_t hs_t

  have hsum_min_K_nz : ∀ (c : Fin q → M_C) (i : Fin q),
      c i ≠ 0 →
        ∃ i₀ : Fin q, c i₀ ≠ 0 ∧ v_term_K c i₀ ≤ v_term_K c i ∧
          (∑ j : Fin q, t_term_K c j) ≠ 0 ∧
          valL F K (∑ j : Fin q, t_term_K c j) = v_term_K c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin q) := (Finset.univ : Finset (Fin q)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term_K c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term_K c i₀ ≤ v_term_K c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin q)).erase i₀,
        c j = 0 ∨ v_term_K c i₀ + 1 ≤ v_term_K c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term_K c i₀ ≤ v_term_K c j := hi₀_min j hj_mem
        have hne_v : v_term_K c i₀ ≠ v_term_K c j := fun heq => hj_ne (hv_term_K_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_K_ge c ((Finset.univ : Finset (Fin q)).erase i₀)
      (v_term_K c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_K_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_K (t_term_K c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin q)).erase i₀, t_term_K c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term_K c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hval_sum_K_iff : ∀ (c : Fin q → M_C) (m : ℤ),
      ((∑ i : Fin q, t_term_K c i) = 0 ∨ m ≤ valL F K (∑ i : Fin q, t_term_K c i)) ↔
        ∀ i : Fin q, c i = 0 ∨ m ≤ v_term_K c i := by
    intro c m
    refine ⟨?_, fun hall => hval_sum_K_ge c Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hci : c i = 0
    · exact Or.inl hci
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_K_nz c i hci
      have hm_le : m ≤ valL F K (∑ j : Fin q, t_term_K c j) := hsum.resolve_left hsum_ne
      omega

  have hlin_zero_K : ∀ (c : Fin q → M_C),
      (∑ i : Fin q, t_term_K c i) = 0 → ∀ i : Fin q, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_K_nz c i hci
    exact hsum_ne hsum0

  let b_K : Fin q → K_MC' := fun i => (toExtendScalars F hM_CK (ϖ_K : K)) ^ (i : ℕ)
  have hli_K : LinearIndependent M_C b_K := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hM_CK (∑ i : Fin q, t_term_K c i) =
        ∑ i : Fin q, c i • b_K i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term_K, b_K]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin q, t_term_K c i) = 0 := by
      apply eF_KMC.injective
      change toExtendScalars F hM_CK (∑ i : Fin q, t_term_K c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero_K c hsum0

  haveI : Nonempty (Fin q) := ⟨⟨0, hq_pos⟩⟩
  have hcard_K : Fintype.card (Fin q) = Module.finrank M_C K_MC' := Fintype.card_fin q
  let B_K : Module.Basis (Fin q) M_C K_MC' := basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K

  have hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)) := by
    intro w hw
    let c : Fin q → M_C := fun i => B_K.repr (toExtendScalars F hM_CK w) i
    have hw_eq : w = ∑ i : Fin q, t_term_K c i := by
      apply eF_KMC.injective
      change toExtendScalars F hM_CK w = toExtendScalars F hM_CK (∑ i : Fin q, t_term_K c i)
      have hrepr := (B_K.sum_repr (toExtendScalars F hM_CK w)).symm
      rw [hrepr, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [B_K, c, t_term_K, b_K]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K, map_mul, map_pow]
      rfl
    have hc0 : ∀ i : Fin q, c i = 0 ∨ 0 ≤ v_term_K c i :=
      (hval_sum_K_iff c 0).mp (hw_eq ▸ hw)
    let i_zero : Fin q := ⟨0, hq_pos⟩
    let z : M_C := c i_zero
    have hz_int : z = 0 ∨ 0 ≤ valL F M_C z := by
      rcases hc0 i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (q : ℤ) * valL F M_C z + 0 at hge
        nlinarith
    let c_rem : Fin q → M_C := fun i => if i = i_zero then 0 else c i
    have hw_sub_eq : w - IntermediateField.inclusion hM_CK z = ∑ i : Fin q, t_term_K c_rem i := by
      have ht_zero : t_term_K c i_zero = IntermediateField.inclusion hM_CK z := by
        dsimp [t_term_K, i_zero, z]
        rw [pow_zero, mul_one]
      have hsplit_c := (Finset.add_sum_erase Finset.univ (t_term_K c) (Finset.mem_univ i_zero)).symm
      have hsplit_rem := (Finset.add_sum_erase Finset.univ (t_term_K c_rem) (Finset.mem_univ i_zero)).symm
      have hrem_zero : t_term_K c_rem i_zero = 0 :=
        ht_term_K_zero c_rem i_zero (if_pos rfl)
      have herase_eq : (∑ i ∈ (Finset.univ : Finset (Fin q)).erase i_zero, t_term_K c i) =
          ∑ i ∈ (Finset.univ : Finset (Fin q)).erase i_zero, t_term_K c_rem i := by
        apply Finset.sum_congr rfl
        intro i hi
        have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
        dsimp [t_term_K, c_rem]
        rw [if_neg hi_ne]
      rw [hw_eq, hsplit_c, ht_zero, add_sub_cancel_left, herase_eq, hsplit_rem, hrem_zero, zero_add]
    have hrem_ge1 : ∀ i : Fin q, c_rem i = 0 ∨ 1 ≤ v_term_K c_rem i := by
      intro i
      by_cases hi0 : i = i_zero
      · left
        dsimp [c_rem]
        rw [if_pos hi0]
      · dsimp [c_rem, v_term_K]
        rw [if_neg hi0]
        rcases hc0 i with hci0 | hge
        · exact Or.inl hci0
        · right
          dsimp [v_term_K] at hge
          have hi_pos : (1 : ℤ) ≤ (i.1 : ℤ) := by
            have hne_val : i.1 ≠ 0 := fun h0 => hi0 (Fin.ext h0)
            omega
          have hi_lt : (i.1 : ℤ) < (q : ℤ) := Nat.cast_lt.mpr i.2
          have hval_nonneg : 0 ≤ valL F M_C (c i) := by
            by_contra hneg
            have hle_neg1 : valL F M_C (c i) ≤ -1 := by omega
            nlinarith
          nlinarith
    refine ⟨z, hz_int, ?_⟩
    rw [hw_sub_eq]
    exact (hval_sum_K_iff c_rem 1).mpr hrem_ge1

  
  have hc₀_val : valL F L (c₀ : L) = 1 + condExpChar F L ψ := by
    change valL F L ((ϖ_L ^ (1 + condExpChar F L ψ) : Lˣ) : L) = _
    rw [hval_zpow_L, hϖ_L, mul_one]

  have hc_orb_stat : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field ((c'_μ i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) =
        (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
      ∀ x : (D_orb.get i).field,
        (x = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field x) →
        ∀ hx : 1 + x ≠ 0,
          ((μ'_orb i) (Units.mk0 (1 + x) hx) : Ω F) =
            (traceChar F (D_orb.get i).le ψ)
              ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * x) := by
    intro i
    have hcond_i := (hFi_ram i).1
    have hnFi := (hFi_ram i).2.2.2.2.2.2.1
    refine ⟨?_, ?_⟩
    · rw [(hc_μ_stat i).1, hcond_i, hnFi]
      push_cast
      ring
    · intro x hx_val hx
      apply (hc_μ_stat i).2 x _ hx
      rcases hx_val with rfl | hx_ge
      · exact Or.inl rfl
      · right
        omega

  have hσ_val : ∀ j : Fin (q - 1), ∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z :=
    fun j => (hν_props j).2.2.2.1
  have hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) = valL F (D_orb.get i).field x :=
    fun i => (hFi_ram i).2.2.1
  have hFi_unram : ∀ i : Fin D_orb.length,
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) :=
    fun i => ⟨(hFi_ram i).2.2.2.2.1, (hFi_ram i).2.2.2.2.2.1, (hFi_ram i).2.2.2.2.2.2.1⟩

  let c_all : Fin (q - 1) → M_Cˣ := fun j =>
    Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
      (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
        (c'_μ (idx_all j)))
  let u_all_0 : Fin (q - 1) → M_Cˣ := fun j =>
    Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀ *
      (ϖ_MC ^ t) * (c_all j)⁻¹
  have hc_all_def : ∀ j : Fin (q - 1),
      c_all j =
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c'_μ (idx_all j))) := fun _ => rfl
  have hu_all_0_def : ∀ j : Fin (q - 1),
      u_all_0 j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀ *
          (ϖ_MC ^ t) * (c_all j)⁻¹ := fun _ => rfl
  have hc_all_val : ∀ j : Fin (q - 1),
      valL F M_C ((c_all j : M_Cˣ) : M_C) =
        (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) := by
    intro j
    have h1 := hσ_val j ((c_all j : M_Cˣ) : M_C)
    have h2 : (σ_all j) ((c_all j : M_Cˣ) : M_C) =
        IntermediateField.inclusion (hFiMC (idx_all j))
          ((c'_μ (idx_all j) : ((D_orb.get (idx_all j)).field)ˣ) : (D_orb.get (idx_all j)).field) := by
      change (σ_all j) ((σ_all j).symm
        (IntermediateField.inclusion (hFiMC (idx_all j))
          ((c'_μ (idx_all j) : ((D_orb.get (idx_all j)).field)ˣ) : (D_orb.get (idx_all j)).field))) = _
      exact (σ_all j).apply_symm_apply _
    rw [← h1, h2, hValAlgFiMC (idx_all j), (hc_orb_stat (idx_all j)).1]
  have hu_all_0_mul : ∀ j : Fin (q - 1), ∀ z : M_C,
      ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀)⁻¹ : M_Cˣ) : M_C) *
        ((u_all_0 j : M_C) * z)) =
        ((((c_all j)⁻¹ : M_Cˣ) : M_C) * (z * ((ϖ_MC ^ t : M_Cˣ) : M_C))) := by
    intro j z
    have hu_cancel :
        (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀)⁻¹ * u_all_0 j =
          (ϖ_MC ^ t) * (c_all j)⁻¹ := by
      dsimp only [u_all_0]
      rw [mul_assoc (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀),
        inv_mul_cancel_left]
    rw [← mul_assoc, ← Units.val_mul, hu_cancel, Units.val_mul]
    ring
  have hu_all_0_prod :
      ∏ j : Fin (q - 1), u_all_0 j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (c₀ ^ (q - 1)) *
          (ϖ_MC ^ (t * (q - 1))) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹ := by
    dsimp only [u_all_0]
    rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_const, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      ← map_pow, ← pow_mul, Finset.prod_inv_distrib, hν_prod c'_μ]

  have htrace_smul_aux : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (a_s : R) (x : S),
      Algebra.trace R S (algebraMap R S a_s * x) = a_s * Algebra.trace R S x := by
    intro R S _ _ _ a_s x
    rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]

  have htrace_mul_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (a_s : A) (w : B),
      traceLM F hAB (IntermediateField.inclusion hAB a_s * w) = a_s * traceLM F hAB w := by
    intro A B hAB a_s w
    exact htrace_smul_aux A (IntermediateField.extendScalars hAB) a_s (toExtendScalars F hAB w)

  have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
      [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
      (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      [FiniteDimensional K₀ M₀] (z : E₀),
      @Algebra.trace L₀ E₀ _ _ algLE z =
        @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
    intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
    by_cases hFin : FiniteDimensional M₀ E₀
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
      simp [htr1, htr2]

  have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (y : B),
      @Algebra.trace A B _ _ (IntermediateField.inclusion hAB).toAlgebra y = traceLM F hAB y := by
    intro A B hAB y
    letI : Algebra A B := (IntermediateField.inclusion hAB).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars hAB := {
      toFun := toExtendScalars F hAB
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm

  have htrace_trans : ∀ (A B C : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (hAB : A ≤ B) (hBC : B ≤ C) (z : C),
      traceLM F (hAB.trans hBC) z = traceLM F hAB (traceLM F hBC z) := by
    intro A B C _ hAB hBC z
    rw [← htrace_eq_inclusion (hAB.trans hBC) z,
        ← htrace_eq_inclusion hBC z,
        ← htrace_eq_inclusion hAB]
    exact htrace_trans_aux F A B C
      (IntermediateField.inclusion hAB).toAlgebra
      (IntermediateField.inclusion hBC).toAlgebra
      (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z

  let c₀_MC : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀
  have hc₀_MC_val : valL F M_C (c₀_MC : M_C) = (k : ℤ) * (1 + condExpChar F L ψ) := by
    change valL F M_C (IntermediateField.inclusion hLM_C (c₀ : L)) = _
    rw [hValAlgMCL (c₀ : L), hc₀_val]
  have hϖ_MC_pow_val : valL F M_C ((ϖ_MC ^ t : M_Cˣ) : M_C) = (t : ℤ) := by
    rw [hval_unit_pow M_C ϖ_MC t, hϖ_MC, mul_one]
  have hϖ_K_pow_val : valL F K ((ϖ_K ^ t : Kˣ) : K) = (t : ℤ) := by
    rw [hval_unit_pow K ϖ_K t, hϖ_K, mul_one]

  have hu_all_0_val : ∀ j : Fin (q - 1), valL F M_C ((u_all_0 j : M_Cˣ) : M_C) = 0 := by
    intro j
    rw [hu_all_0_def j]
    change valL F M_C (((c₀_MC * (ϖ_MC ^ t) * (c_all j)⁻¹ : M_Cˣ) : M_C)) = 0
    rw [Units.val_mul,
      hvalMC.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
      Units.val_mul,
      hvalMC.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
      hc₀_MC_val, hϖ_MC_pow_val,
      hvalMC.2.2.2.2.2.1 (c_all j), hc_all_val j]
    omega

  
  have hν_stat : ∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ (t : ℤ) ≤ valL F M_C z) →
      ∀ hz : 1 + z ≠ 0,
        ((ν_all j) (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM_C ψ) ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z) := by
    intro j z hz_val hz
    let i := idx_all j
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    have hvalFi := ld_valL_and_unitGroup_props F (D_orb.get i).field
    have hSpecFi := (ld_condExp_and_condExpChar_spec F (D_orb.get i).field
      (traceChar F (D_orb.get i).le ψ) (hψFi i) 1).1
    let z' : M_C := (σ_all j) z
    have hz'_val : z' = 0 ∨ (t : ℤ) ≤ valL F M_C z' := by
      rcases hz_val with rfl | hz_ge
      · left; exact map_zero (σ_all j)
      · right
        change (t : ℤ) ≤ valL F M_C ((σ_all j) z)
        rw [(hν_props j).2.2.2.1 z]
        exact hz_ge
    have hz'_ge1 : z' = 0 ∨ 1 ≤ valL F M_C z' := by
      rcases hz'_val with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    let w_σ : M_Cˣ := Units.map (σ_all j).toRingEquiv.toMonoidHom (Units.mk0 (1 + z) hz)
    have hw_σ_coe : (w_σ : M_C) = 1 + z' := by
      change (σ_all j) (1 + z) = 1 + (σ_all j) z
      rw [map_add, map_one]
    let u' : ((D_orb.get i).field)ˣ := Units.map (normLM F (hFiMC i)) w_σ
    have hu'_coe : (u' : (D_orb.get i).field) = normLM F (hFiMC i) (1 + z') := by
      change normLM F (hFiMC i) (w_σ : M_C) = _
      rw [hw_σ_coe]
    let x' : (D_orb.get i).field := (u' : (D_orb.get i).field) - 1
    let r' : (D_orb.get i).field :=
      normLM F (hFiMC i) (1 + z') - (1 + traceLM F (hFiMC i) z')
    have hx'_1 : 1 + x' = (u' : (D_orb.get i).field) := by
      dsimp only [x']; ring
    have hx' : 1 + x' ≠ 0 := by
      rw [hx'_1]; exact Units.ne_zero u'
    have hu'_mk0 : Units.mk0 (1 + x') hx' = u' := Units.ext hx'_1
    have hx'_decomp : x' = traceLM F (hFiMC i) z' + r' := by
      dsimp only [x', r']
      rw [hu'_coe]
      ring
    have htr_z' : traceLM F (hFiMC i) z' = 0 ∨
        (t : ℤ) ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z') :=
      (hFi_unram i).1 (t : ℤ) z' hz'_val
    have hr'_t1 : r' = 0 ∨ (t + 1 : ℤ) ≤ valL F (D_orb.get i).field r' := by
      by_cases hz'0 : z' = 0
      · left
        dsimp only [r']
        rw [hz'0, add_zero, map_one, map_zero, add_zero, sub_self]
      · have hz'_ge_t : (t : ℤ) ≤ valL F M_C z' := hz'_val.resolve_left hz'0
        have hrem : r' = 0 ∨ 2 * valL F M_C z' ≤ valL F (D_orb.get i).field r' :=
          (hFi_unram i).2.1 z' hz'_ge1
        rcases hrem with hr0 | hr_ge
        · exact Or.inl hr0
        · right; omega
    have hr'_t : r' = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field r' := by
      rcases hr'_t1 with hr0 | hr_ge
      · exact Or.inl hr0
      · exact Or.inr (by omega)
    have hx'_val : x' = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field x' := by
      rw [hx'_decomp]
      exact hvalFi.2.2.2.2.2.2.2.1 (t : ℤ) _ _ htr_z' hr'_t
    have hν_eval : (ν_all j) (Units.mk0 (1 + z) hz) = (μ'_orb i) u' :=
      (hν_props j).2.2.2.2.2.2 (Units.mk0 (1 + z) hz)
    have hstat_i := (hc_orb_stat i).2 x' hx'_val hx'
    rw [hu'_mk0] at hstat_i
    rw [hν_eval, hstat_i, hx'_decomp, mul_add, AddChar.map_add_eq_mul]
    have hr'_psi : (traceChar F (D_orb.get i).le ψ)
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * r') = 1 := by
      apply hSpecFi
      have hc_inv_val : valL F (D_orb.get i).field
          ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) =
            -((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ)) := by
        rw [hvalFi.2.2.2.2.2.1 (c'_μ i), (hc_orb_stat i).1]
      have hmul := hval_mul_ge (D_orb.get i).field
        (-((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))) (t + 1 : ℤ)
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) r'
        (Or.inr (le_of_eq hc_inv_val.symm)) hr'_t1
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have hnFi := (hFi_unram i).2.2
        have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
            (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
        omega
    rw [hr'_psi, mul_one]
    have hc_all_inv_σ : IntermediateField.inclusion (hFiMC i)
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) =
          (σ_all j) ((((c_all j)⁻¹ : M_Cˣ) : M_C)) := by
      have hinv : (c_all j)⁻¹ =
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC i)).toMonoidHom ((c'_μ i)⁻¹)) := by
        rw [hc_all_def j, ← map_inv, ← map_inv]
      have hcoe : (((c_all j)⁻¹ : M_Cˣ) : M_C) =
          (σ_all j).symm (IntermediateField.inclusion (hFiMC i)
            ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field))) :=
        congrArg Units.val hinv
      rw [hcoe, AlgEquiv.apply_symm_apply]
    have htr_pull : traceLM F (D_orb.get i).le
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) *
          traceLM F (hFiMC i) z') =
        traceLM F hLM_C ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z) := by
      have hle_eq : (D_orb.get i).le.trans (hFiMC i) = hLM_C := rfl
      rw [← htrace_mul_inclusion (hFiMC i),
        ← htrace_trans L (D_orb.get i).field M_C (D_orb.get i).le (hFiMC i),
        hle_eq, hc_all_inv_σ]
      dsimp only [z']
      rw [← map_mul (σ_all j), (hν_props j).2.2.2.2.1]
    change ψ (traceLM F (D_orb.get i).le _) = ψ (traceLM F hLM_C _)
    rw [htr_pull]

  have hψMC_call_triv : ∀ (j : Fin (q - 1)) (e : M_C),
      (e = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C e) →
      (traceChar F hLM_C ψ) ((((c_all j)⁻¹ : M_Cˣ) : M_C) * e) = 1 := by
    intro j e he
    apply hSpecMC.1
    have hc_inv_val : valL F M_C ((((c_all j)⁻¹ : M_Cˣ) : M_C)) =
        -((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ)) := by
      rw [hvalMC.2.2.2.2.2.1 (c_all j), hc_all_val j]
    have hmul := hval_mul_ge M_C
      (-((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))) (t + 1 : ℤ)
      ((((c_all j)⁻¹ : M_Cˣ) : M_C)) e
      (Or.inr (le_of_eq hc_inv_val.symm)) he
    rcases hmul with h0 | hge
    · exact Or.inl h0
    · right
      have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
          (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
      omega

  have hν_triv_t1 : ∀ j : Fin (q - 1), ∀ u ∈ unitGroup F M_C (t + 1), (ν_all j) u = 1 := by
    intro j u hu
    let z : M_C := (u : M_C) - 1
    have hz_1 : 1 + z = (u : M_C) := by dsimp only [z]; ring
    have hz : 1 + z ≠ 0 := by rw [hz_1]; exact Units.ne_zero u
    have hu_mk0 : Units.mk0 (1 + z) hz = u := Units.ext hz_1
    have hz_t1 : z = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C z := by
      rcases (hvalMC.2.2.2.2.2.2.2.2.2.1 (t + 1) (by omega) u).mp hu with hu1 | hge
      · left; dsimp only [z]; rw [hu1, sub_self]
      · exact Or.inr hge
    have hz_t : z = 0 ∨ (t : ℤ) ≤ valL F M_C z := by
      rcases hz_t1 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    apply Units.ext
    rw [← hu_mk0, hν_stat j z hz_t hz, hψMC_call_triv j z hz_t1, Units.val_one]

  have hν_nontriv_t : ∀ j : Fin (q - 1), ∃ u₀ ∈ unitGroup F M_C t, (ν_all j) u₀ ≠ 1 := by
    intro j
    obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_psi⟩ := hSpecMC.2.1
    let z₀ : M_C := ((c_all j : M_Cˣ) : M_C) * x₁
    have hz₀_val : (t : ℤ) ≤ valL F M_C z₀ := by
      dsimp only [z₀]
      rw [hvalMC.2.2.2.2.1 _ _ (Units.ne_zero (c_all j)) hx₁_ne, hc_all_val j]
      have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
          (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
      omega
    have hz₀_1_ne : 1 + z₀ ≠ 0 := by
      intro h0
      have hz₀_eq : z₀ = -1 := by linear_combination h0
      have hval_neg1 : valL F M_C z₀ = 0 := by rw [hz₀_eq, hvalMC.2.2.1]
      omega
    let u₀ : M_Cˣ := Units.mk0 (1 + z₀) hz₀_1_ne
    have hu₀_mem : u₀ ∈ unitGroup F M_C t := by
      rw [hvalMC.2.2.2.2.2.2.2.2.2.1 t ht_ge1 u₀]
      right
      have hsub : (u₀ : M_C) - 1 = z₀ := by change (1 + z₀) - 1 = z₀; ring
      rw [hsub]
      exact hz₀_val
    refine ⟨u₀, hu₀_mem, ?_⟩
    intro hu₀_eq1
    apply hx₁_psi
    have hstat := hν_stat j z₀ (Or.inr hz₀_val) hz₀_1_ne
    change ((ν_all j) u₀ : Ω F) = _ at hstat
    rw [hu₀_eq1, Units.val_one] at hstat
    have hcancel : ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z₀) = x₁ := by
      dsimp only [z₀]
      rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
    rw [hcancel] at hstat
    exact hstat.symm

  have hvalMC_pow_int : ∀ (z : M_C) (n : ℕ),
      (z = 0 ∨ 0 ≤ valL F M_C z) → (z ^ n = 0 ∨ 0 ≤ valL F M_C (z ^ n)) := by
    intro z n hz
    induction' n with n ih
    · right; simp [hvalMC.2.1]
    · rw [pow_succ]
      have h := hval_mul_ge M_C 0 0 (z ^ n) z ih hz
      simpa using h

  have hvalMC_sum_int : ∀ (S : Finset (Fin r_exp)) (f : Fin r_exp → M_C),
      (∀ m ∈ S, f m = 0 ∨ 0 ≤ valL F M_C (f m)) →
      ((∑ m ∈ S, f m) = 0 ∨ 0 ≤ valL F M_C (∑ m ∈ S, f m)) := by
    intro S f hf
    induction' S using Finset.induction_on with a_s s ha ih
    · left; simp
    · rw [Finset.sum_insert ha]
      exact hvalMC.2.2.2.2.2.2.2.1 0 (f a_s) (∑ m ∈ s, f m)
        (hf a_s (Finset.mem_insert_self a_s s))
        (ih (fun m hm => hf m (Finset.mem_insert_of_mem hm)))

  have hPz_int : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (P_poly z = 0 ∨ 0 ≤ valL F M_C (P_poly z)) := by
    intro z hz
    rw [hP_def z]
    apply hvalMC.2.2.2.2.2.2.2.1 0
    · exact hvalMC_pow_int z q hz
    · apply hvalMC_sum_int Finset.univ
      intro m _
      have h := hval_mul_ge M_C 0 0 (a_coeff m) (z ^ ((p F) ^ (m : ℕ)))
        (ha_int m) (hvalMC_pow_int z ((p F) ^ (m : ℕ)) hz)
      simpa using h

  have hu_all_0_P : ∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceChar F hLM_C ψ)
        ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₀)⁻¹ : M_Cˣ) : M_C) *
          ((u_all_0 j : M_C) * P_poly z)) = 1 := by
    intro j z hz_int
    let y_K : K := IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)
    have hz_K_int : IntermediateField.inclusion hM_CK z = 0 ∨
        0 ≤ valL F K (IntermediateField.inclusion hM_CK z) := by
      rcases hz_int with rfl | hz_ge0
      · left; exact map_zero _
      · right
        rw [hValAlgK z]
        exact mul_nonneg (Nat.cast_nonneg q) hz_ge0
    have hy_K_val : y_K = 0 ∨ (t : ℤ) ≤ valL F K y_K := by
      have h := hval_mul_ge K 0 (t : ℤ)
        (IntermediateField.inclusion hM_CK z) ((ϖ_K ^ t : Kˣ) : K)
        hz_K_int (Or.inr (le_of_eq hϖ_K_pow_val.symm))
      simpa [y_K] using h
    have hy_K_ne : 1 + y_K ≠ 0 := by
      intro h0
      have hy_eq : y_K = -1 := by linear_combination h0
      have hval_neg1 : valL F K y_K = 0 := by rw [hy_eq, hvalK.2.2.1]
      rcases hy_K_val with hy0 | hy_ge
      · have h10 : (1 : K) = 0 := by linear_combination h0 - hy0
        exact one_ne_zero h10
      · omega
    let w_K : Kˣ := Units.mk0 (1 + y_K) hy_K_ne
    let u_norm : M_Cˣ := Units.map (normLM F hM_CK) w_K
    have hν_u_norm : ((ν_all j) u_norm : Ω F) = 1 := by
      rw [(hν_props j).2.2.2.2.2.1 u_norm ⟨w_K, rfl⟩, Units.val_one]
    let z_norm : M_C := normLM F hM_CK (1 + y_K) - 1
    let e_z : M_C :=
      normLM F hM_CK (1 + y_K) - (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C))
    have hz_norm_1 : 1 + z_norm = (u_norm : M_C) := by
      change 1 + (normLM F hM_CK (1 + y_K) - 1) = normLM F hM_CK (1 + y_K)
      ring
    have hz_norm_ne : 1 + z_norm ≠ 0 := by
      rw [hz_norm_1]; exact Units.ne_zero u_norm
    have hu_norm_mk0 : Units.mk0 (1 + z_norm) hz_norm_ne = u_norm := Units.ext hz_norm_1
    have hz_norm_decomp : z_norm = P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C) + e_z := by
      dsimp only [z_norm, e_z]; ring
    have hPϖ_val : P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C) = 0 ∨
        (t : ℤ) ≤ valL F M_C (P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) := by
      have h := hval_mul_ge M_C 0 (t : ℤ) (P_poly z) ((ϖ_MC ^ t : M_Cˣ) : M_C)
        (hPz_int z hz_int) (Or.inr (le_of_eq hϖ_MC_pow_val.symm))
      simpa using h
    have he_z_t1 : e_z = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C e_z := hP_norm z hz_int
    have he_z_t : e_z = 0 ∨ (t : ℤ) ≤ valL F M_C e_z := by
      rcases he_z_t1 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hz_norm_val : z_norm = 0 ∨ (t : ℤ) ≤ valL F M_C z_norm := by
      rw [hz_norm_decomp]
      exact hvalMC.2.2.2.2.2.2.2.1 (t : ℤ) _ _ hPϖ_val he_z_t
    have hstat := hν_stat j z_norm hz_norm_val hz_norm_ne
    rw [hu_norm_mk0, hν_u_norm, hz_norm_decomp, mul_add, AddChar.map_add_eq_mul,
      hψMC_call_triv j e_z he_z_t1, mul_one] at hstat
    rw [hu_all_0_mul j (P_poly z)]
    exact hstat.symm

  
  have hu_all_0_cong : ∀ j₁ j₂ : Fin (q - 1),
      ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C))) →
      ∀ w ∈ unitGroup F M_C t, (ν_all j₁) w = (ν_all j₂) w := by
    intro j₁ j₂ hdiff w hw
    let z : M_C := (w : M_C) - 1
    have hz_1 : 1 + z = (w : M_C) := by dsimp only [z]; ring
    have hz : 1 + z ≠ 0 := by rw [hz_1]; exact Units.ne_zero w
    have hw_mk0 : Units.mk0 (1 + z) hz = w := Units.ext hz_1
    have hz_t : z = 0 ∨ (t : ℤ) ≤ valL F M_C z := by
      rcases (hvalMC.2.2.2.2.2.2.2.2.2.1 t ht_ge1 w).mp hw with hw1 | hge
      · left; dsimp only [z]; rw [hw1, sub_self]
      · exact Or.inr hge
    let z₁ : M_C := z * ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C))
    have hz₁_mul : z₁ * ((ϖ_MC ^ t : M_Cˣ) : M_C) = z := by
      dsimp only [z₁]
      rw [mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
    have hϖ_inv_val : valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) = -(t : ℤ) := by
      rw [hvalMC.2.2.2.2.2.1 (ϖ_MC ^ t), hϖ_MC_pow_val]
    have hz₁_int : z₁ = 0 ∨ 0 ≤ valL F M_C z₁ := by
      have h := hval_mul_ge M_C (t : ℤ) (-(t : ℤ)) z ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C))
        hz_t (Or.inr (le_of_eq hϖ_inv_val.symm))
      simpa [z₁] using h
    let δ : M_C := (((c₀_MC⁻¹ : M_Cˣ) : M_C) * (((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C)) * z₁))
    have h_decomp : ((((c_all j₁)⁻¹ : M_Cˣ) : M_C) * z) =
        ((((c_all j₂)⁻¹ : M_Cˣ) : M_C) * z) + δ := by
      have hm1 := hu_all_0_mul j₁ z₁
      have hm2 := hu_all_0_mul j₂ z₁
      rw [hz₁_mul] at hm1 hm2
      change (((c₀_MC⁻¹ : M_Cˣ) : M_C) * ((u_all_0 j₁ : M_C) * z₁)) = _ at hm1
      change (((c₀_MC⁻¹ : M_Cˣ) : M_C) * ((u_all_0 j₂ : M_C) * z₁)) = _ at hm2
      rw [← hm1, ← hm2]
      dsimp only [δ]
      ring
    have hδ_psi : (traceChar F hLM_C ψ) δ = 1 := by
      apply hSpecMC.1
      have hc₀_inv_val : valL F M_C (((c₀_MC⁻¹ : M_Cˣ) : M_C)) =
          -((k : ℤ) * (1 + condExpChar F L ψ)) := by
        rw [hvalMC.2.2.2.2.2.1 c₀_MC, hc₀_MC_val]
      have hdu_z₁ := hval_mul_ge M_C 1 0
        ((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C)) z₁ hdiff hz₁_int
      have hmul : δ = 0 ∨ -((k : ℤ) * (1 + condExpChar F L ψ)) + (1 + 0) ≤ valL F M_C δ :=
        hval_mul_ge M_C (-((k : ℤ) * (1 + condExpChar F L ψ))) (1 + 0)
          (((c₀_MC⁻¹ : M_Cˣ) : M_C)) (((u_all_0 j₁ : M_C) - (u_all_0 j₂ : M_C)) * z₁)
          (Or.inr (le_of_eq hc₀_inv_val.symm)) hdu_z₁
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
            (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
        omega
    apply Units.ext
    rw [← hw_mk0, hν_stat j₁ z hz_t hz, hν_stat j₂ z hz_t hz,
      h_decomp, AddChar.map_add_eq_mul, hδ_psi, mul_one]

  obtain ⟨h_gen_vec, hh_gen⟩ :=
    ld_ch14_wild_tower_norm_coset_generators F r_exp hr_exp_pos M_C K hM_CK
      hGalMCK hq_pow hValNormK hValAlgK hFrobSurjMC (t + 1) (by omega)

  have hν_inj_t : ∀ j₁ j₂ : Fin (q - 1),
      (∀ w ∈ unitGroup F M_C t, (ν_all j₁) w = (ν_all j₂) w) → j₁ = j₂ := by
    let j₀ : Fin (q - 1) := ⟨0, by omega⟩
    have hex_x₀ : ∃ x₀ : M_Cˣ, (ν_all j₀) x₀ ≠ 1 := by
      by_contra hall
      push_neg at hall
      apply (hν_props j₀).1
      exact MonoidHom.ext hall
    obtain ⟨x₀, hx₀⟩ := hex_x₀
    let ζ₀ : (Ω F)ˣ := (ν_all j₀) x₀
    have hζ₀_pow : ζ₀ ^ (p F) = 1 := by
      change ((ν_all j₀) x₀) ^ (p F) = 1
      rw [← MonoidHom.pow_apply, (hν_props j₀).2.1, MonoidHom.one_apply]
    haveI : Fact (Nat.Prime (p F)) := ⟨hp_prime⟩
    have hp_pos : 0 < p F := hp_prime.pos
    have hζ₀_ord : orderOf ζ₀ = p F := orderOf_eq_prime hζ₀_pow hx₀
    have hζ₀_inj : Function.Injective (fun i : Fin (p F) => (ζ₀ ^ (i : ℕ) : Ω F)) := by
      intro i₁ i₂ heq
      have hu : ζ₀ ^ (i₁ : ℕ) = ζ₀ ^ (i₂ : ℕ) := Units.ext heq
      have hi₁ : (i₁ : ℕ) ∈ Set.Iio (orderOf ζ₀) := by
        rw [Set.mem_Iio, hζ₀_ord]
        exact i₁.2
      have hi₂ : (i₂ : ℕ) ∈ Set.Iio (orderOf ζ₀) := by
        rw [Set.mem_Iio, hζ₀_ord]
        exact i₂.2
      exact Fin.ext (pow_injOn_Iio_orderOf hi₁ hi₂ hu)
    have hζ₀_roots : ∀ ξ : (Ω F)ˣ, ξ ^ (p F) = 1 → ∃ i : Fin (p F), ξ = ζ₀ ^ (i : ℕ) := by
      intro ξ hξ
      let P_X : Polynomial (Ω F) := Polynomial.X ^ (p F) - 1
      have hP_ne0 : P_X ≠ 0 := by
        simpa [P_X] using Polynomial.X_pow_sub_C_ne_zero hp_pos (1 : Ω F)
      have hP_deg : P_X.natDegree = p F := by
        simpa [P_X] using Polynomial.natDegree_X_pow_sub_C (n := p F) (r := (1 : Ω F))
      let S_ζ : Finset (Ω F) := Finset.univ.image (fun i : Fin (p F) => (ζ₀ ^ (i : ℕ) : Ω F))
      have hS_card : S_ζ.card = p F := by
        rw [Finset.card_image_of_injective _ hζ₀_inj, Finset.card_univ, Fintype.card_fin]
      have h_mem_roots : ∀ z : Ω F, z ^ (p F) = 1 → z ∈ P_X.roots := by
        intro z hz
        rw [Polynomial.mem_roots hP_ne0, Polynomial.IsRoot.def]
        simp [P_X, hz]
      have hξ_val : (ξ : Ω F) ^ (p F) = 1 := by
        rw [← Units.val_pow_eq_pow_val, hξ, Units.val_one]
      by_cases hmem : (ξ : Ω F) ∈ S_ζ
      · rw [Finset.mem_image] at hmem
        rcases hmem with ⟨i, _, hi⟩
        exact ⟨i, Units.ext hi.symm⟩
      · exfalso
        let S' : Finset (Ω F) := insert (ξ : Ω F) S_ζ
        have hS'_sub : S'.val ⊆ P_X.roots := by
          intro z hz
          rw [← Finset.mem_def, Finset.mem_insert] at hz
          rcases hz with rfl | hz
          · exact h_mem_roots (ξ : Ω F) hξ_val
          · rw [Finset.mem_image] at hz
            rcases hz with ⟨i, _, rfl⟩
            apply h_mem_roots
            rw [← pow_mul, mul_comm, pow_mul, ← Units.val_pow_eq_pow_val, hζ₀_pow, Units.val_one, one_pow]
        have hle := Polynomial.card_le_degree_of_subset_roots hS'_sub
        rw [Finset.card_insert_of_notMem hmem, hS_card, hP_deg] at hle
        omega
    have hθ_eq_of_h : ∀ (θ₁ θ₂ : M_Cˣ →* (Ω F)ˣ),
        (∀ w ∈ Set.range (Units.map (normLM F hM_CK)), θ₁ w = 1) →
        (∀ u ∈ unitGroup F M_C (t + 1), θ₁ u = 1) →
        (∀ w ∈ Set.range (Units.map (normLM F hM_CK)), θ₂ w = 1) →
        (∀ u ∈ unitGroup F M_C (t + 1), θ₂ u = 1) →
        (∀ s : Fin r_exp, θ₁ (h_gen_vec s) = θ₂ (h_gen_vec s)) →
        θ₁ = θ₂ := by
      intro θ₁ θ₂ hN₁ hU₁ hN₂ hU₂ h_eq
      apply MonoidHom.ext
      intro x
      obtain ⟨e, w, hu⟩ := hh_gen x
      set n := Units.map (normLM F hM_CK) w
      have hnN : n ∈ Set.range (Units.map (normLM F hM_CK)) := ⟨w, rfl⟩
      set P_e := (∏ s : Fin r_exp, (h_gen_vec s) ^ (e s : ℕ)) * n
      have h₁ : θ₁ (x * P_e⁻¹) = 1 := hU₁ (x * P_e⁻¹) hu
      have h₂ : θ₂ (x * P_e⁻¹) = 1 := hU₂ (x * P_e⁻¹) hu
      rw [map_mul, map_inv, mul_inv_eq_one] at h₁ h₂
      rw [h₁, h₂]
      dsimp only [P_e]
      rw [map_mul, map_mul, hN₁ n hnN, hN₂ n hnN, mul_one, mul_one, map_prod, map_prod]
      congr 1
      ext s
      rw [map_pow, map_pow, h_eq s]
    let θ_opt : Option (Fin (q - 1)) → (M_Cˣ →* (Ω F)ˣ) := fun o =>
      match o with
      | none => 1
      | some j => ν_all j
    have hθ_opt_pow : ∀ o s, ((θ_opt o) (h_gen_vec s)) ^ (p F) = 1 := by
      intro o s
      cases o with
      | none => simp [θ_opt]
      | some j =>
        change ((ν_all j) (h_gen_vec s)) ^ (p F) = 1
        rw [← MonoidHom.pow_apply, (hν_props j).2.1, MonoidHom.one_apply]
    have hθ_opt_N : ∀ o, ∀ w ∈ Set.range (Units.map (normLM F hM_CK)), (θ_opt o) w = 1 := by
      intro o w hw
      cases o with
      | none => rfl
      | some j => exact (hν_props j).2.2.2.2.2.1 w hw
    have hθ_opt_U : ∀ o, ∀ u ∈ unitGroup F M_C (t + 1), (θ_opt o) u = 1 := by
      intro o u hu
      cases o with
      | none => rfl
      | some j => exact hν_triv_t1 j u hu
    let d : Option (Fin (q - 1)) → (Fin r_exp → Fin (p F)) :=
      fun o s => Classical.choose (hζ₀_roots ((θ_opt o) (h_gen_vec s)) (hθ_opt_pow o s))
    have hd_spec : ∀ o s, (θ_opt o) (h_gen_vec s) = ζ₀ ^ (d o s : ℕ) :=
      fun o s => Classical.choose_spec (hζ₀_roots ((θ_opt o) (h_gen_vec s)) (hθ_opt_pow o s))
    have hd_inj : Function.Injective d := by
      intro o₁ o₂ hd_eq
      have hθ_eq : θ_opt o₁ = θ_opt o₂ := by
        apply hθ_eq_of_h (θ_opt o₁) (θ_opt o₂) (hθ_opt_N o₁) (hθ_opt_U o₁) (hθ_opt_N o₂) (hθ_opt_U o₂)
        intro s
        rw [hd_spec o₁ s, hd_spec o₂ s, congr_fun hd_eq s]
      cases o₁ with
      | none =>
        cases o₂ with
        | none => rfl
        | some j₂ =>
          exfalso
          exact (hν_props j₂).1 hθ_eq.symm
      | some j₁ =>
        cases o₂ with
        | none =>
          exfalso
          exact (hν_props j₁).1 hθ_eq
        | some j₂ =>
          exact congrArg some (hν_inj hθ_eq)
    have hcard_eq : Fintype.card (Option (Fin (q - 1))) = Fintype.card (Fin r_exp → Fin (p F)) := by
      rw [Fintype.card_option, Fintype.card_fin, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin]
      have hq_eq : q = (p F) ^ r_exp := hq_pow
      omega
    have hd_bij : Function.Bijective d :=
      (Fintype.bijective_iff_injective_and_card d).mpr ⟨hd_inj, hcard_eq⟩
    intro j₁ j₂ hw_eq
    by_contra hne
    let θ : M_Cˣ →* (Ω F)ˣ := (ν_all j₁) * (ν_all j₂)⁻¹
    have hθ_ne1 : θ ≠ 1 := by
      intro h1
      apply hne
      apply hν_inj
      exact mul_inv_eq_one.mp h1
    have hθ_pow : ∀ s, (θ (h_gen_vec s)) ^ (p F) = 1 := by
      intro s
      change ((ν_all j₁) (h_gen_vec s) * ((ν_all j₂) (h_gen_vec s))⁻¹) ^ (p F) = 1
      rw [mul_pow, inv_pow, ← MonoidHom.pow_apply, ← MonoidHom.pow_apply,
        (hν_props j₁).2.1, (hν_props j₂).2.1, MonoidHom.one_apply, inv_one, mul_one]
    have hθ_N : ∀ w ∈ Set.range (Units.map (normLM F hM_CK)), θ w = 1 := by
      intro w hw
      change (ν_all j₁) w * ((ν_all j₂) w)⁻¹ = 1
      rw [(hν_props j₁).2.2.2.2.2.1 w hw, (hν_props j₂).2.2.2.2.2.1 w hw, inv_one, mul_one]
    have hθ_U : ∀ u ∈ unitGroup F M_C (t + 1), θ u = 1 := by
      intro u hu
      change (ν_all j₁) u * ((ν_all j₂) u)⁻¹ = 1
      rw [hν_triv_t1 j₁ u hu, hν_triv_t1 j₂ u hu, inv_one, mul_one]
    let d_θ : Fin r_exp → Fin (p F) :=
      fun s => Classical.choose (hζ₀_roots (θ (h_gen_vec s)) (hθ_pow s))
    have hd_θ_spec : ∀ s, θ (h_gen_vec s) = ζ₀ ^ (d_θ s : ℕ) :=
      fun s => Classical.choose_spec (hζ₀_roots (θ (h_gen_vec s)) (hθ_pow s))
    obtain ⟨o, ho⟩ := hd_bij.2 d_θ
    have hθ_opt_eq : θ_opt o = θ := by
      apply hθ_eq_of_h (θ_opt o) θ (hθ_opt_N o) (hθ_opt_U o) hθ_N hθ_U
      intro s
      rw [hd_spec o s, hd_θ_spec s, congr_fun ho s]
    cases o with
    | none =>
      exact hθ_ne1 hθ_opt_eq.symm
    | some j₃ =>
      obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := hν_nontriv_t j₃
      apply hu₀_ne1
      have h_eval : (ν_all j₃) u₀ = θ u₀ := congrFun (congrArg DFunLike.coe hθ_opt_eq) u₀
      rw [h_eval]
      change (ν_all j₁) u₀ * ((ν_all j₂) u₀)⁻¹ = 1
      rw [hw_eq u₀ hu₀_mem, mul_inv_cancel]

  refine ⟨hFinE_eq, hValNormK, hValAlgK, hResLiftK,
    u_all_0, hu_all_0_def, hu_all_0_prod, hu_all_0_val, hu_all_0_P, ?_⟩
  intro j₁ j₂ hdiff
  exact hν_inj_t j₁ j₂ (hu_all_0_cong j₁ j₂ hdiff)

theorem ld_ch14_odd_p_diamond_shifted_c_E_exists (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E) (hEK : E ≤ K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (D_orb : List (MonomialTerm F L))
    (χ' : Lˣ →* (Ω F)ˣ)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (hDiamondTrNorm : ∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hnE : condExpChar F E (traceChar F hLE ψ) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * condExpChar F L ψ +
        (((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / k : ℕ) : ℤ) *
          ((t : ℤ) + (k : ℤ)))
    (htr_bound_K : ∀ (m : ℤ) (w : K),
      (w = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hM_CK w = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK w)))
    (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_E : Eˣ) (ϖ_L : Lˣ)
    (hϖ_K_norm : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_E_norm : Units.map (normLM F hLE) ϖ_E = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_MC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_E : valL F E (ϖ_E : E) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (u_all_0 : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hu_all_0_prod :
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1), u_all_0 j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          ((ϖ_L ^ (1 + condExpChar F L ψ)) ^
            (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)) *
          (ϖ_MC ^ (t * (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹)
    (u_α : Lˣ) (u_ω : M_Cˣ)
    (hu_α_val : valL F L (u_α : L) = 0)
    (hu_ω_val : valL F M_C (u_ω : M_C) = 0)
    (hu_ω_def : (u_ω : M_C) = (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K))
    (hu_α_frob : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ (((((ϖ_L ^ (1 + condExpChar F L ψ))⁻¹ : Lˣ) : L)) * ((u_α : L) * x)) =
        ψ (((((ϖ_L ^ (1 + condExpChar F L ψ))⁻¹ : Lˣ) : L)) *
          (x ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (hVieta :
      (∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1), u_all_0 j) *
        (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (u_α ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))))⁻¹ *
        (u_ω ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))) ∈
        unitGroup F M_C 1) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
    ∃ (c_E : Eˣ),
      valL F E (c_E : E) = 1 + condExpChar F E (traceChar F hLE ψ) ∧
      Units.map (normLM F hLE) c_E *
        (c₀ *
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹ ∈
        unitGroup F L 1 ∧
      (∀ y₀ : E, (y₀ = 0 ∨ 0 ≤ valL F E y₀) →
        ∀ x₀ : L, (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
          (y₀ - IntermediateField.inclusion hLE x₀ = 0 ∨
            1 ≤ valL F E (y₀ - IntermediateField.inclusion hLE x₀)) →
          (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * y₀) =
            ψ (((c₀⁻¹ : Lˣ) : L) * (x₀ ^ q))) :=
by
  
  obtain ⟨_, _, _, _, hval_mul_L, _, _, _, _, hunit_ge1_L, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨_, _, _, hval_neg_MC, hval_mul_MC, hval_inv_MC, _, hval_add_MC, _, hunit_ge1_MC, _⟩ :=
    ld_valL_and_unitGroup_props F M_C
  obtain ⟨_, _, _, _, hval_mul_K, _, _, hval_add_K, _, hunit_ge1_K, _⟩ :=
    ld_valL_and_unitGroup_props F K
  obtain ⟨hψ_triv, _, _, _⟩ := ld_condExp_and_condExpChar_spec F L ψ hψ χ'
  have hNorm_unit1 : ∀ w₁ ∈ unitGroup F K 1,
      Units.map (normLM F hM_CK) w₁ ∈ unitGroup F M_C 1 :=
    (ld_ch14_norm_unitGroup_one_and_top_conductor F M_C K E hM_CK hValAlgK).1

  
  have hval_unit_mul : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u v : Mˣ), valL F M ((u * v : Mˣ) : M) = valL F M (u : M) + valL F M (v : M) := by
    intro M _ u v
    have hM := ld_valL_and_unitGroup_props F M
    rw [Units.val_mul]
    exact hM.2.2.2.2.1 (u : M) (v : M) (Units.ne_zero u) (Units.ne_zero v)
  have hval_unit_inv : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ), valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
    intro M _ u
    exact (ld_valL_and_unitGroup_props F M).2.2.2.2.2.1 u
  have hval_unit_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ), valL F M ((u ^ n : Mˣ) : M) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero =>
      simp [hM.2.1]
    | succ n ih =>
      rw [pow_succ, hval_unit_mul M (u ^ n) u, ih]
      push_cast
      ring
  have hval_unit_zpow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (m : ℤ), valL F M ((u ^ m : Mˣ) : M) = m * valL F M (u : M) := by
    intro M _ u m
    cases m with
    | ofNat n =>
      rw [Int.ofNat_eq_natCast, zpow_natCast, hval_unit_pow M u n]
    | negSucc n =>
      rw [zpow_negSucc, hval_unit_inv M (u ^ (n + 1)), hval_unit_pow M u (n + 1), Int.negSucc_eq]
      push_cast
      ring

  
  have hcoe_inc_unit : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      (h : M₁ ≤ M₂) (u : M₁ˣ),
      ((Units.map (IntermediateField.inclusion h).toMonoidHom u : M₂ˣ) : M₂) =
        IntermediateField.inclusion h (u : M₁) := fun _ _ _ _ => rfl
  have hnorm_inc_unit : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₁] [FiniteDimensional F M₂] (h : M₁ ≤ M₂) (u : M₁ˣ),
      Units.map (normLM F h) (Units.map (IntermediateField.inclusion h).toMonoidHom u) =
        u ^ (Module.finrank M₁ (IntermediateField.extendScalars h)) := by
    intro M₁ M₂ _ _ h u
    haveI : FiniteDimensional F (IntermediateField.extendScalars h) := ‹FiniteDimensional F M₂›
    haveI : IsScalarTower F M₁ (IntermediateField.extendScalars h) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional M₁ (IntermediateField.extendScalars h) :=
      Module.Finite.of_restrictScalars_finite F M₁ (IntermediateField.extendScalars h)
    haveI : Module.Free M₁ (IntermediateField.extendScalars h) :=
      Module.Free.of_divisionRing M₁ (IntermediateField.extendScalars h)
    apply Units.ext
    change Algebra.norm M₁ (toExtendScalars F h (IntermediateField.inclusion h (u : M₁))) =
      ((u ^ (Module.finrank M₁ (IntermediateField.extendScalars h)) : M₁ˣ) : M₁)
    have hto : toExtendScalars F h (IntermediateField.inclusion h (u : M₁)) =
        algebraMap M₁ (IntermediateField.extendScalars h) (u : M₁) := rfl
    rw [hto, Algebra.norm_algebraMap, Units.val_pow_eq_pow_val]
  have htrace_smul : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₁] [FiniteDimensional F M₂] (h : M₁ ≤ M₂) (x : M₁) (y : M₂),
      traceLM F h (IntermediateField.inclusion h x * y) = x * traceLM F h y := by
    intro M₁ M₂ _ _ h x y
    letI : Module M₁ M₁ := Semiring.toModule
    change Algebra.trace M₁ (IntermediateField.extendScalars h)
        (toExtendScalars F h (IntermediateField.inclusion h x * y)) =
      x * Algebra.trace M₁ (IntermediateField.extendScalars h) (toExtendScalars F h y)
    have hto : toExtendScalars F h (IntermediateField.inclusion h x) =
        algebraMap M₁ (IntermediateField.extendScalars h) x := rfl
    rw [map_mul, hto, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]

  
  let K' := IntermediateField.extendScalars hM_CK
  let q := Module.finrank M_C K'
  let ψ_E := traceChar F hLE ψ
  have hFinMCK' : FiniteDimensional M_C K' := by
    haveI : FiniteDimensional F K' := ‹FiniteDimensional F K›
    haveI : IsScalarTower F M_C K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F M_C K'
  haveI : FiniteDimensional M_C K' := hFinMCK'
  have hq_pos : 0 < q := Module.finrank_pos
  have hq_ge1 : 1 ≤ q := hq_pos
  have hq1_cast : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by omega
  let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
  have hc₀_val : valL F L (c₀ : L) = 1 + condExpChar F L ψ := by
    dsimp only [c₀]
    rw [hval_unit_zpow L ϖ_L (1 + condExpChar F L ψ), hϖ_L, mul_one]

  
  let m_E : ℤ := 1 + condExpChar F E ψ_E
  let w_E : Eˣ := ϖ_E ^ m_E
  let κ_E : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom c₀ * w_E⁻¹
  have hκ_E_val : valL F E (κ_E : E) = (q : ℤ) * (1 + condExpChar F L ψ) - m_E := by
    dsimp only [κ_E, w_E]
    rw [hval_unit_mul E, hval_unit_inv E, hcoe_inc_unit L E hLE c₀,
      hValAlgE (c₀ : L), hc₀_val, hval_unit_zpow E ϖ_E m_E, hϖ_E]
    ring
  let δ : Kˣ :=
    Units.map (IntermediateField.inclusion hEK).toMonoidHom κ_E *
      Units.map (IntermediateField.inclusion hM_CK).toMonoidHom (ϖ_MC ^ t) *
      (ϖ_K ^ t)⁻¹
  have hdiv_nat : k * ((q - 1) / k) = q - 1 := Nat.mul_div_cancel' hk_dvd
  have hdiv_int : (k : ℤ) * (((q - 1) / k : ℕ) : ℤ) = (q : ℤ) - 1 := by
    calc (k : ℤ) * (((q - 1) / k : ℕ) : ℤ)
        = ((k * ((q - 1) / k) : ℕ) : ℤ) := (Nat.cast_mul k ((q - 1) / k)).symm
      _ = ((q - 1 : ℕ) : ℤ) := by rw [hdiv_nat]
      _ = (q : ℤ) - 1 := hq1_cast
  have hm_E_mul :
      (k : ℤ) * m_E =
        (k : ℤ) * (q : ℤ) * (1 + condExpChar F L ψ) + ((q : ℤ) - 1) * (t : ℤ) := by
    dsimp only [m_E, ψ_E]
    rw [hnE]
    calc (k : ℤ) * (1 + ((q : ℤ) * condExpChar F L ψ +
          (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ))))
        = (k : ℤ) + (k : ℤ) * (q : ℤ) * condExpChar F L ψ +
          ((k : ℤ) * (((q - 1) / k : ℕ) : ℤ)) * ((t : ℤ) + (k : ℤ)) := by ring
      _ = (k : ℤ) + (k : ℤ) * (q : ℤ) * condExpChar F L ψ +
          ((q : ℤ) - 1) * ((t : ℤ) + (k : ℤ)) := by rw [hdiv_int]
      _ = (k : ℤ) * (q : ℤ) * (1 + condExpChar F L ψ) + ((q : ℤ) - 1) * (t : ℤ) := by ring
  have hδ_val : valL F K (δ : K) = 0 := by
    dsimp only [δ]
    rw [hval_unit_mul K, hval_unit_mul K, hval_unit_inv K,
      hcoe_inc_unit E K hEK κ_E, hValAlgKE (κ_E : E), hκ_E_val,
      hcoe_inc_unit M_C K hM_CK (ϖ_MC ^ t), hValAlgK ((ϖ_MC ^ t : M_Cˣ) : M_C),
      hval_unit_pow M_C ϖ_MC t, hϖ_MC,
      hval_unit_pow K ϖ_K t, hϖ_K]
    linear_combination - hm_E_mul

  have hnorm_κ_E : Units.map (normLM F hLE) κ_E = c₀ ^ q * (ϖ_L ^ m_E)⁻¹ := by
    dsimp only [κ_E, w_E]
    rw [map_mul, hnorm_inc_unit L E hLE c₀, hFinE_eq, map_inv, map_zpow, hϖ_E_norm]
  have hnorm_EK_κ :
      Units.map (normLM F hM_CK) (Units.map (IntermediateField.inclusion hEK).toMonoidHom κ_E) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (Units.map (normLM F hLE) κ_E) := by
    apply Units.ext
    exact ((hDiamondTrNorm (κ_E : E)).2).symm
  have htq_split : t * q = t * (q - 1) + t := by
    calc t * q = t * ((q - 1) + 1) := by rw [Nat.sub_add_cancel hq_ge1]
      _ = t * (q - 1) + t := by ring
  have hδ_norm :
      Units.map (normLM F hM_CK) δ =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (c₀ ^ q * (ϖ_L ^ m_E)⁻¹) *
          (ϖ_MC ^ (t * (q - 1))) := by
    dsimp only [δ]
    rw [map_mul, map_mul, hnorm_EK_κ, hnorm_κ_E,
      hnorm_inc_unit M_C K hM_CK (ϖ_MC ^ t), map_inv, map_pow, hϖ_K_norm,
      ← pow_mul, htq_split, pow_add, mul_assoc, mul_inv_cancel_right]

  have hDiamond_tr_κ : ∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE ((κ_E : E) * y)) =
        (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) *
          traceLM F hM_CK ((δ : K) * ((ϖ_K ^ t : Kˣ) : K) * IntermediateField.inclusion hEK y) := by
    intro y
    have hκ_K_unit :
        Units.map (IntermediateField.inclusion hEK).toMonoidHom κ_E =
          Units.map (IntermediateField.inclusion hM_CK).toMonoidHom ((ϖ_MC ^ t)⁻¹) *
            (δ * (ϖ_K ^ t)) := by
      dsimp only [δ]
      rw [map_inv, inv_mul_cancel_right,
        mul_comm _ (Units.map (IntermediateField.inclusion hM_CK).toMonoidHom (ϖ_MC ^ t)),
        inv_mul_cancel_left]
    have hκ_K :
        IntermediateField.inclusion hEK ((κ_E : E) * y) =
          IntermediateField.inclusion hM_CK (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) *
            ((δ : K) * ((ϖ_K ^ t : Kˣ) : K) * IntermediateField.inclusion hEK y) := by
      have hcoe : IntermediateField.inclusion hEK (κ_E : E) =
          IntermediateField.inclusion hM_CK (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) *
            ((δ : K) * ((ϖ_K ^ t : Kˣ) : K)) :=
        congrArg (fun u : Kˣ => (u : K)) hκ_K_unit
      rw [map_mul, hcoe, mul_assoc]
    rw [(hDiamondTrNorm ((κ_E : E) * y)).1, hκ_K, htrace_smul M_C K hM_CK]

  have htr_bound_K_t1 : ∀ w : K,
      (w = 0 ∨ (t + 1 : ℤ) ≤ valL F K w) →
      ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK w = 0 ∨
        1 ≤ valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK w)) := by
    intro w hw
    have hw' : w = 0 ∨ (q : ℤ) * (t + 1 : ℤ) - ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K w := by
      rcases hw with rfl | hw
      · exact Or.inl rfl
      · right
        rw [hq1_cast]
        linarith
    rcases htr_bound_K (t + 1 : ℤ) w hw' with htr0 | htr_ge
    · left
      rw [htr0, mul_zero]
    · by_cases htr0 : traceLM F hM_CK w = 0
      · left
        rw [htr0, mul_zero]
      · right
        rw [hval_mul_MC _ _ (Units.ne_zero _) htr0,
          hval_inv_MC, hval_unit_pow M_C ϖ_MC t, hϖ_MC]
        linarith

  have hRem_tr : ∀ r_E : E, (r_E = 0 ∨ 1 ≤ valL F E r_E) →
      traceLM F hLE ((κ_E : E) * r_E) = 0 ∨
        1 ≤ valL F L (traceLM F hLE ((κ_E : E) * r_E)) := by
    intro r_E hr_E
    let w_r : K := (δ : K) * ((ϖ_K ^ t : Kˣ) : K) * IntermediateField.inclusion hEK r_E
    have hw_r : w_r = 0 ∨ (t + 1 : ℤ) ≤ valL F K w_r := by
      rcases hr_E with rfl | hr_E
      · left
        simp [w_r]
      · by_cases hr0 : r_E = 0
        · left
          simp [w_r, hr0]
        · right
          have hincl_ne : IntermediateField.inclusion hEK r_E ≠ 0 :=
            (map_ne_zero_iff (IntermediateField.inclusion hEK)
              (IntermediateField.inclusion hEK).injective).mpr hr0
          have hδϖ_ne : ((δ * (ϖ_K ^ t) : Kˣ) : K) ≠ 0 := Units.ne_zero _
          change (t + 1 : ℤ) ≤ valL F K (((δ * (ϖ_K ^ t) : Kˣ) : K) * IntermediateField.inclusion hEK r_E)
          rw [hval_mul_K _ _ hδϖ_ne hincl_ne, hval_unit_mul K δ (ϖ_K ^ t),
            hδ_val, hval_unit_pow K ϖ_K t, hϖ_K, hValAlgKE r_E]
          have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
          nlinarith
    have hMC_tr := htr_bound_K_t1 w_r hw_r
    rw [← hDiamond_tr_κ r_E] at hMC_tr
    rcases hMC_tr with h0 | hge1
    · left
      exact (map_eq_zero_iff (IntermediateField.inclusion hLM_C)
        (IntermediateField.inclusion hLM_C).injective).mp h0
    · right
      rw [hValAlgMCL] at hge1
      have hk_pos : (0 : ℤ) < (k : ℤ) := by exact_mod_cast hk_ge1
      nlinarith

  
  obtain ⟨z_δ, hz_δ_int, hr_δ⟩ := hResLiftK (δ : K) (Or.inr (by rw [hδ_val]))
  have hz_δ_ne_and_val0 : z_δ ≠ 0 ∧ valL F M_C z_δ = 0 := by
    by_contra h_bad
    have hz_ge1 : z_δ = 0 ∨ 1 ≤ valL F M_C z_δ := by
      rcases hz_δ_int with rfl | hz_ge0
      · exact Or.inl rfl
      · by_cases hz0 : z_δ = 0
        · exact Or.inl hz0
        · right
          have hne0 : valL F M_C z_δ ≠ 0 := fun h0 => h_bad ⟨hz0, h0⟩
          omega
    have hincl_z : IntermediateField.inclusion hM_CK z_δ = 0 ∨
        1 ≤ valL F K (IntermediateField.inclusion hM_CK z_δ) := by
      rcases hz_ge1 with rfl | hz_ge1
      · left
        rw [map_zero]
      · right
        rw [hValAlgK z_δ]
        have hq_int : (1 : ℤ) ≤ (q : ℤ) := by exact_mod_cast hq_ge1
        nlinarith
    have hδ_sum : (δ : K) =
        IntermediateField.inclusion hM_CK z_δ + ((δ : K) - IntermediateField.inclusion hM_CK z_δ) := by
      ring
    have hδ_ge1 := hval_add_K 1 (IntermediateField.inclusion hM_CK z_δ)
      ((δ : K) - IntermediateField.inclusion hM_CK z_δ) hincl_z hr_δ
    rw [← hδ_sum] at hδ_ge1
    rcases hδ_ge1 with h0 | hge1
    · exact Units.ne_zero δ h0
    · omega
  let u_zδ : M_Cˣ := Units.mk0 z_δ hz_δ_ne_and_val0.1
  have hu_zδ_val : valL F M_C (u_zδ : M_C) = 0 := hz_δ_ne_and_val0.2
  let w₁ : Kˣ := δ * (Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹
  have hw₁_mem : w₁ ∈ unitGroup F K 1 := by
    rw [hunit_ge1_K 1 le_rfl]
    have hy₁_eq : (w₁ : K) - 1 =
        ((δ : K) - IntermediateField.inclusion hM_CK z_δ) *
          (((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹ : Kˣ) : K) := by
      dsimp only [w₁]
      have h_mul :
          IntermediateField.inclusion hM_CK z_δ *
            (((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹ : Kˣ) : K) = 1 := by
        change ((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ : Kˣ) : K) *
          (((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹ : Kˣ) : K) = 1
        exact Units.mul_inv _
      calc (δ : K) * (((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹ : Kˣ) : K) - 1
          = (δ : K) * (((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹ : Kˣ) : K) -
              IntermediateField.inclusion hM_CK z_δ *
                (((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹ : Kˣ) : K) := by
            rw [h_mul]
        _ = ((δ : K) - IntermediateField.inclusion hM_CK z_δ) *
              (((Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹ : Kˣ) : K) := by
            ring
    rcases hr_δ with h0 | hge1
    · left
      apply sub_eq_zero.mp
      rw [hy₁_eq, h0, zero_mul]
    · by_cases h0 : (δ : K) - IntermediateField.inclusion hM_CK z_δ = 0
      · left
        apply sub_eq_zero.mp
        rw [hy₁_eq, h0, zero_mul]
      · right
        rw [hy₁_eq, hval_mul_K _ _ h0 (Units.ne_zero _),
          hval_unit_inv K, hcoe_inc_unit M_C K hM_CK u_zδ,
          hValAlgK (u_zδ : M_C), hu_zδ_val]
        omega

  have hNorm_δ_cong :
      Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
        (c₀ ^ q * (ϖ_L ^ m_E)⁻¹) *
        (ϖ_MC ^ (t * (q - 1))) *
        (u_zδ ^ q)⁻¹ ∈ unitGroup F M_C 1 := by
    have hw₁_norm_eq :
        Units.map (normLM F hM_CK) w₁ =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (c₀ ^ q * (ϖ_L ^ m_E)⁻¹) *
            (ϖ_MC ^ (t * (q - 1))) *
            (u_zδ ^ q)⁻¹ := by
      dsimp only [w₁]
      rw [map_mul, hδ_norm, map_inv, hnorm_inc_unit M_C K hM_CK u_zδ]
    rw [← hw₁_norm_eq]
    exact hNorm_unit1 w₁ hw₁_mem

  
  let r_δ : K := (δ : K) - IntermediateField.inclusion hM_CK (u_zδ : M_C)
  let w_δ : K := r_δ * ((ϖ_K ^ t : Kˣ) : K)
  have hw_δ_val : w_δ = 0 ∨ (t + 1 : ℤ) ≤ valL F K w_δ := by
    rcases hr_δ with h0 | hge1
    · left
      dsimp only [w_δ, r_δ, u_zδ]
      rw [Units.val_mk0, h0, zero_mul]
    · by_cases hr0 : r_δ = 0
      · left
        dsimp only [w_δ]
        rw [hr0, zero_mul]
      · right
        dsimp only [w_δ]
        rw [hval_mul_K _ _ hr0 (Units.ne_zero _), hval_unit_pow K ϖ_K t, hϖ_K]
        change 1 ≤ valL F K r_δ at hge1
        linarith
  let T_E : L := traceLM F hLE (κ_E : E)
  let rem_MC : M_C := (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK w_δ
  have hrem_MC_val : rem_MC = 0 ∨ 1 ≤ valL F M_C rem_MC := htr_bound_K_t1 w_δ hw_δ_val
  have hTE_decomp :
      IntermediateField.inclusion hLM_C T_E =
        ((u_zδ * u_ω : M_Cˣ) : M_C) + rem_MC := by
    have h1 := hDiamond_tr_κ 1
    rw [mul_one, map_one, mul_one] at h1
    have hδ_split :
        (δ : K) * ((ϖ_K ^ t : Kˣ) : K) =
          IntermediateField.inclusion hM_CK (u_zδ : M_C) * ((ϖ_K ^ t : Kˣ) : K) + w_δ := by
      dsimp only [w_δ, r_δ]
      ring
    dsimp only [T_E, rem_MC]
    rw [h1, hδ_split, map_add, htrace_smul M_C K hM_CK, mul_add, Units.val_mul, hu_ω_def]
    ring
  have hTE_ne_and_val0 : T_E ≠ 0 ∧ valL F L T_E = 0 := by
    have hu_prod_val : valL F M_C ((u_zδ * u_ω : M_Cˣ) : M_C) = 0 := by
      rw [hval_unit_mul M_C u_zδ u_ω, hu_zδ_val, hu_ω_val, add_zero]
    by_contra h_bad
    have hTE_ge1 : T_E = 0 ∨ 1 ≤ valL F L T_E := by
      by_cases h0 : T_E = 0
      · exact Or.inl h0
      · by_cases hlt0 : valL F L T_E ≤ -1
        · have hMC_lt : valL F M_C (IntermediateField.inclusion hLM_C T_E) ≤ -1 := by
            rw [hValAlgMCL T_E]
            have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
            nlinarith
          have hMC_ge0 : IntermediateField.inclusion hLM_C T_E = 0 ∨
              0 ≤ valL F M_C (IntermediateField.inclusion hLM_C T_E) := by
            rw [hTE_decomp]
            apply hval_add_MC 0 ((u_zδ * u_ω : M_Cˣ) : M_C) rem_MC
            · exact Or.inr (by omega)
            · rcases hrem_MC_val with hrem0 | hrem1
              · exact Or.inl hrem0
              · exact Or.inr (by omega)
          rcases hMC_ge0 with hMC0 | hMC_ge0
          · exact False.elim (h0 ((map_eq_zero_iff (IntermediateField.inclusion hLM_C)
              (IntermediateField.inclusion hLM_C).injective).mp hMC0))
          · omega
        · right
          have hne0 : valL F L T_E ≠ 0 := fun hval0 => h_bad ⟨h0, hval0⟩
          omega
    have hMC_ge1 : IntermediateField.inclusion hLM_C T_E = 0 ∨
        1 ≤ valL F M_C (IntermediateField.inclusion hLM_C T_E) := by
      rcases hTE_ge1 with hTE0 | hge1
      · left
        rw [hTE0, map_zero]
      · right
        rw [hValAlgMCL T_E]
        have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
        nlinarith
    have hneg_rem : -rem_MC = 0 ∨ 1 ≤ valL F M_C (-rem_MC) := by
      rcases hrem_MC_val with hrem0 | hrem1
      · left
        rw [hrem0, neg_zero]
      · right
        rw [hval_neg_MC]
        exact hrem1
    have hu_sum : ((u_zδ * u_ω : M_Cˣ) : M_C) =
        IntermediateField.inclusion hLM_C T_E + (-rem_MC) := by
      rw [hTE_decomp]
      ring
    have hu_ge1 := hval_add_MC 1 (IntermediateField.inclusion hLM_C T_E) (-rem_MC) hMC_ge1 hneg_rem
    rw [← hu_sum] at hu_ge1
    rcases hu_ge1 with hu0 | hu_ge1
    · exact Units.ne_zero (u_zδ * u_ω) hu0
    · omega
  let u_TE : Lˣ := Units.mk0 T_E hTE_ne_and_val0.1
  have hu_TE_val : valL F L (u_TE : L) = 0 := hTE_ne_and_val0.2
  have hTE_cong :
      Units.map (IntermediateField.inclusion hLM_C).toMonoidHom u_TE *
        (u_zδ * u_ω)⁻¹ ∈ unitGroup F M_C 1 := by
    rw [hunit_ge1_MC 1 le_rfl]
    have hdiff_eq :
        ((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom u_TE *
          (u_zδ * u_ω)⁻¹ : M_Cˣ) : M_C) - 1 =
          rem_MC * (((u_zδ * u_ω)⁻¹ : M_Cˣ) : M_C) := by
      have h_mul : ((u_zδ * u_ω : M_Cˣ) : M_C) * (((u_zδ * u_ω)⁻¹ : M_Cˣ) : M_C) = 1 :=
        Units.mul_inv (u_zδ * u_ω)
      change IntermediateField.inclusion hLM_C T_E * (((u_zδ * u_ω)⁻¹ : M_Cˣ) : M_C) - 1 = _
      rw [hTE_decomp, add_mul, h_mul]
      ring
    rcases hrem_MC_val with hrem0 | hrem1
    · left
      apply sub_eq_zero.mp
      rw [hdiff_eq, hrem0, zero_mul]
    · by_cases hrem0 : rem_MC = 0
      · left
        apply sub_eq_zero.mp
        rw [hdiff_eq, hrem0, zero_mul]
      · right
        rw [hdiff_eq, hval_mul_MC _ _ hrem0 (Units.ne_zero _),
          hval_unit_inv M_C, hval_unit_mul M_C u_zδ u_ω, hu_zδ_val, hu_ω_val]
        omega

  
  let v₀ : Lˣ := u_TE * u_α⁻¹
  have hv₀_val : valL F L (v₀ : L) = 0 := by
    dsimp only [v₀]
    rw [hval_unit_mul L u_TE u_α⁻¹, hval_unit_inv L u_α, hu_TE_val, hu_α_val]
    ring
  let c_E : Eˣ := w_E * Units.map (IntermediateField.inclusion hLE).toMonoidHom v₀
  have hc_E_val : valL F E (c_E : E) = 1 + condExpChar F E ψ_E := by
    dsimp only [c_E, w_E, m_E]
    rw [hval_unit_mul E, hval_unit_zpow E ϖ_E, hϖ_E,
      hcoe_inc_unit L E hLE v₀, hValAlgE (v₀ : L), hv₀_val]
    ring
  have hc_E_norm :
      Units.map (normLM F hLE) c_E *
        (c₀ *
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹ ∈
        unitGroup F L 1 := by
    let ι : Lˣ →* M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
    let P_orb : Lˣ := ∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)
    let U_target : Lˣ := Units.map (normLM F hLE) c_E * (c₀ * P_orb)⁻¹
    have hc_E_norm_eq :
        Units.map (normLM F hLE) c_E = (ϖ_L ^ m_E) * (u_TE ^ q) * (u_α ^ q)⁻¹ := by
      dsimp only [c_E, w_E, v₀]
      rw [map_mul, map_zpow, hϖ_E_norm, hnorm_inc_unit L E hLE (u_TE * u_α⁻¹), hFinE_eq,
        mul_pow, inv_pow, mul_assoc]
    have hc₀_pow : c₀ * c₀ ^ (q - 1) = c₀ ^ q := by
      conv_rhs => rw [← Nat.sub_add_cancel hq_ge1, pow_succ']
    have hι_target :
        ι U_target =
          ((∏ j : Fin (q - 1), u_all_0 j) * (ι (u_α ^ q))⁻¹ * (u_ω ^ q)) *
            (ι (c₀ ^ q * (ϖ_L ^ m_E)⁻¹) * (ϖ_MC ^ (t * (q - 1))) * (u_zδ ^ q)⁻¹)⁻¹ *
            (ι u_TE * (u_zδ * u_ω)⁻¹) ^ q := by
      let P_all : M_Cˣ := ∏ j : Fin (q - 1), u_all_0 j
      let C1_M : M_Cˣ := ι (c₀ ^ (q - 1)) * (ϖ_MC ^ (t * (q - 1)))
      have hprod_eq : (ι P_orb)⁻¹ = P_all * C1_M⁻¹ := by
        have h1 : C1_M⁻¹ * P_all = (ι P_orb)⁻¹ := by
          dsimp only [P_all, C1_M, ι, P_orb, c₀]
          rw [hu_all_0_prod, inv_mul_cancel_left]
        rw [← h1, mul_comm]
      have h_lhs :
          ι U_target =
            ι (ϖ_L ^ m_E) * (ι u_TE) ^ q * (ι (u_α ^ q))⁻¹ * (ι c₀)⁻¹ * P_all * C1_M⁻¹ := by
        change ι (Units.map (normLM F hLE) c_E * (c₀ * P_orb)⁻¹) = _
        rw [hc_E_norm_eq, mul_inv_rev (c₀ : Lˣ) P_orb,
          map_mul ι, map_mul ι, map_mul ι, map_mul ι,
          map_pow ι u_TE q, map_inv ι (u_α ^ q), map_inv ι P_orb, map_inv ι c₀, hprod_eq]
        dsimp only [ι, P_all, C1_M, c₀, q]
        ac_rfl
      have h_mid :
          (ι (c₀ ^ q * (ϖ_L ^ m_E)⁻¹) * (ϖ_MC ^ (t * (q - 1))) * (u_zδ ^ q)⁻¹)⁻¹ =
            (u_zδ ^ q) * C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E) := by
        rw [← hc₀_pow, map_mul ι, map_mul ι, map_inv ι]
        have h_rearrange :
            ι c₀ * ι (c₀ ^ (q - 1)) * (ι (ϖ_L ^ m_E))⁻¹ * (ϖ_MC ^ (t * (q - 1))) * (u_zδ ^ q)⁻¹ =
              (ι (ϖ_L ^ m_E))⁻¹ * ι c₀ * C1_M * (u_zδ ^ q)⁻¹ := by
          dsimp only [ι, C1_M, c₀, q]
          ac_rfl
        rw [h_rearrange,
          mul_inv_rev ((ι (ϖ_L ^ m_E))⁻¹ * ι c₀ * C1_M) (u_zδ ^ q)⁻¹,
          mul_inv_rev ((ι (ϖ_L ^ m_E))⁻¹ * ι c₀) C1_M,
          mul_inv_rev (ι (ϖ_L ^ m_E))⁻¹ (ι c₀),
          inv_inv, inv_inv]
        dsimp only [ι, C1_M, c₀, q]
        ac_rfl
      have h_pow_rhs :
          (ι u_TE * (u_zδ * u_ω)⁻¹) ^ q =
            (u_zδ ^ q)⁻¹ * (u_ω ^ q)⁻¹ * (ι u_TE) ^ q := by
        rw [mul_pow, inv_pow, mul_pow, mul_inv_rev]
        dsimp only [ι, q]
        ac_rfl
      change ι U_target =
        (P_all * (ι (u_α ^ q))⁻¹ * (u_ω ^ q)) *
          (ι (c₀ ^ q * (ϖ_L ^ m_E)⁻¹) * (ϖ_MC ^ (t * (q - 1))) * (u_zδ ^ q)⁻¹)⁻¹ *
          (ι u_TE * (u_zδ * u_ω)⁻¹) ^ q
      rw [h_lhs, h_mid, h_pow_rhs]
      have h_cancel_zδ :
          ((u_zδ ^ q) * C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E)) *
            ((u_zδ ^ q)⁻¹ * (u_ω ^ q)⁻¹ * (ι u_TE) ^ q) =
            (u_ω ^ q)⁻¹ * (C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E) * (ι u_TE) ^ q) := by
        calc ((u_zδ ^ q) * C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E)) *
              ((u_zδ ^ q)⁻¹ * (u_ω ^ q)⁻¹ * (ι u_TE) ^ q)
            = (C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E) * (u_zδ ^ q)) *
                ((u_zδ ^ q)⁻¹ * ((u_ω ^ q)⁻¹ * (ι u_TE) ^ q)) := by
                dsimp only [ι, C1_M, c₀, q]; ac_rfl
          _ = C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E) *
                ((u_zδ ^ q) * ((u_zδ ^ q)⁻¹ * ((u_ω ^ q)⁻¹ * (ι u_TE) ^ q))) := by
                dsimp only [ι, C1_M, c₀, q]; ac_rfl
          _ = C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E) * ((u_ω ^ q)⁻¹ * (ι u_TE) ^ q) := by
                rw [mul_inv_cancel_left]
          _ = (u_ω ^ q)⁻¹ * (C1_M⁻¹ * (ι c₀)⁻¹ * ι (ϖ_L ^ m_E) * (ι u_TE) ^ q) := by
                dsimp only [ι, C1_M, c₀, q]; ac_rfl
      rw [mul_assoc (P_all * (ι (u_α ^ q))⁻¹ * (u_ω ^ q)), h_cancel_zδ,
        mul_assoc (P_all * (ι (u_α ^ q))⁻¹) (u_ω ^ q), mul_inv_cancel_left]
      dsimp only [ι, P_all, C1_M, c₀, q]
      ac_rfl
    have hι_mem : ι U_target ∈ unitGroup F M_C 1 := by
      rw [hι_target]
      exact Subgroup.mul_mem (unitGroup F M_C 1)
        (Subgroup.mul_mem (unitGroup F M_C 1) hVieta
          (Subgroup.inv_mem (unitGroup F M_C 1) hNorm_δ_cong))
        (Subgroup.pow_mem (unitGroup F M_C 1) hTE_cong q)
    change U_target ∈ unitGroup F L 1
    rw [hunit_ge1_L 1 le_rfl]
    rw [hunit_ge1_MC 1 le_rfl] at hι_mem
    rcases hι_mem with h1 | hge1
    · left
      apply (IntermediateField.inclusion hLM_C).injective
      rw [map_one]
      exact h1
    · right
      have hsub : ((ι U_target : M_Cˣ) : M_C) - 1 =
          IntermediateField.inclusion hLM_C ((U_target : L) - 1) := by
        rw [map_sub, map_one]
        rfl
      rw [hsub, hValAlgMCL ((U_target : L) - 1)] at hge1
      change (1 : ℤ) ≤ (k : ℤ) * valL F L ((U_target : L) - 1) at hge1
      change (1 : ℤ) ≤ valL F L ((U_target : L) - 1)
      have hk_pos : (0 : ℤ) < (k : ℤ) := by exact_mod_cast hk_ge1
      nlinarith
  have hc_E_psi : ∀ y₀ : E, (y₀ = 0 ∨ 0 ≤ valL F E y₀) →
      ∀ x₀ : L, (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
        (y₀ - IntermediateField.inclusion hLE x₀ = 0 ∨
          1 ≤ valL F E (y₀ - IntermediateField.inclusion hLE x₀)) →
        ψ_E (((c_E⁻¹ : Eˣ) : E) * y₀) =
          ψ (((c₀⁻¹ : Lˣ) : L) * (x₀ ^ q)) := by
    intro y₀ _ x₀ hx₀ hyx
    let r_E : E := y₀ - IntermediateField.inclusion hLE x₀
    have hy_split : y₀ = IntermediateField.inclusion hLE x₀ + r_E := by
      dsimp only [r_E]
      ring
    have hc_E_inv :
        c_E⁻¹ =
          Units.map (IntermediateField.inclusion hLE).toMonoidHom (c₀⁻¹ * v₀⁻¹) * κ_E := by
      let ι_E : Lˣ →* Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom
      change (w_E * ι_E v₀)⁻¹ = ι_E (c₀⁻¹ * v₀⁻¹) * (ι_E c₀ * w_E⁻¹)
      rw [mul_comm c₀⁻¹ v₀⁻¹, map_mul ι_E v₀⁻¹ c₀⁻¹, map_inv ι_E v₀, map_inv ι_E c₀,
        mul_assoc (ι_E v₀)⁻¹, inv_mul_cancel_left (ι_E c₀) w_E⁻¹, ← mul_inv_rev w_E (ι_E v₀)]
    have hv₀_uTE : ((v₀⁻¹ : Lˣ) : L) * (u_TE : L) = (u_α : L) := by
      have h_unit : v₀⁻¹ * u_TE = u_α := by
        dsimp only [v₀]
        rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
      exact congrArg (fun u : Lˣ => (u : L)) h_unit
    let R_E : L := traceLM F hLE ((κ_E : E) * r_E)
    have htr_y :
        traceLM F hLE (((c_E⁻¹ : Eˣ) : E) * y₀) =
          (((c₀⁻¹ : Lˣ) : L) * ((u_α : L) * x₀)) +
            (((c₀⁻¹ * v₀⁻¹ : Lˣ) : L) * R_E) := by
      have hmul_y :
          ((c_E⁻¹ : Eˣ) : E) * y₀ =
            IntermediateField.inclusion hLE ((c₀⁻¹ * v₀⁻¹ : Lˣ) : L) *
              ((κ_E : E) * IntermediateField.inclusion hLE x₀ + (κ_E : E) * r_E) := by
        rw [hc_E_inv, hy_split, Units.val_mul, hcoe_inc_unit L E hLE (c₀⁻¹ * v₀⁻¹)]
        ring
      have htr_x :
          traceLM F hLE ((κ_E : E) * IntermediateField.inclusion hLE x₀) =
            (u_TE : L) * x₀ := by
        rw [mul_comm (κ_E : E) (IntermediateField.inclusion hLE x₀),
          htrace_smul L E hLE x₀ (κ_E : E), mul_comm x₀]
        rfl
      rw [hmul_y, htrace_smul L E hLE ((c₀⁻¹ * v₀⁻¹ : Lˣ) : L),
        map_add, htr_x]
      dsimp only [R_E]
      rw [mul_add, Units.val_mul, ← mul_assoc (((c₀⁻¹ : Lˣ) : L) * ((v₀⁻¹ : Lˣ) : L)),
        mul_assoc ((c₀⁻¹ : Lˣ) : L) ((v₀⁻¹ : Lˣ) : L) (u_TE : L), hv₀_uTE, mul_assoc]
    have hψ_rem : ψ (((c₀⁻¹ * v₀⁻¹ : Lˣ) : L) * R_E) = 1 := by
      apply hψ_triv
      rcases hRem_tr r_E hyx with hR0 | hR_ge1
      · left
        dsimp only [R_E]
        rw [hR0, mul_zero]
      · by_cases hR0 : R_E = 0
        · left
          rw [hR0, mul_zero]
        · right
          rw [hval_mul_L _ _ (Units.ne_zero _) hR0,
            hval_unit_mul L c₀⁻¹ v₀⁻¹, hval_unit_inv L c₀, hval_unit_inv L v₀,
            hc₀_val, hv₀_val]
          change 1 ≤ valL F L R_E at hR_ge1
          linarith
    change ψ (traceLM F hLE (((c_E⁻¹ : Eˣ) : E) * y₀)) = _
    rw [htr_y, AddChar.map_add_eq_mul, hψ_rem, mul_one, hu_α_frob x₀ hx₀]
  exact ⟨c_E, hc_E_val, hc_E_norm, hc_E_psi⟩

theorem ld_ch14_odd_p_diamond_c_E_and_E_gauss_factor (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E) (hEK : E ≤ K)
    (hGalMCK : IsGaloisExt F M_C K)
    (hp_ne2 : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (χ' : Lˣ →* (Ω F)ˣ)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hqE : qL F E = qL F L)
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hResLiftE : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)))
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (hDiamondTrNorm : ∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hnE : condExpChar F E (traceChar F hLE ψ) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * condExpChar F L ψ +
        (((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / k : ℕ) : ℤ) *
          ((t : ℤ) + (k : ℤ)))
    (htr_bound_K : ∀ (m : ℤ) (w : K),
      (w = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hM_CK w = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK w)))
    (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_E : Eˣ) (ϖ_L : Lˣ)
    (hϖ_K_norm : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_E_norm : Units.map (normLM F hLE) ϖ_E = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_MC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_E : valL F E (ϖ_E : E) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp)
    (hq_pow : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (c'_χ' : Lˣ) (c'_χ'E : Eˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hcond_E : 2 ≤ condExp F E (χ'.comp (Units.map (normLM F hLE))))
    (hc_E_val : valL F E (c'_χ'E : E) =
      (condExp F E (χ'.comp (Units.map (normLM F hLE))) : ℤ) +
        condExpChar F E (traceChar F hLE ψ))
    (hNormCong :
      Units.map (normLM F hLE) c'_χ'E *
        (c'_χ' *
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_θ i)))⁻¹ ∈
        unitGroup F L 1)
    (u_all_0 : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hu_all_0_prod :
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1), u_all_0 j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          ((ϖ_L ^ (1 + condExpChar F L ψ)) ^
            (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)) *
          (ϖ_MC ^ (t * (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹)
    (u_α : Lˣ) (u_ω : M_Cˣ)
    (hu_α_val : valL F L (u_α : L) = 0)
    (hu_ω_val : valL F M_C (u_ω : M_C) = 0)
    (hu_ω_def : (u_ω : M_C) = (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K))
    (hu_α_frob : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ (((((ϖ_L ^ (1 + condExpChar F L ψ))⁻¹ : Lˣ) : L)) * ((u_α : L) * x)) =
        ψ (((((ϖ_L ^ (1 + condExpChar F L ψ))⁻¹ : Lˣ) : L)) *
          (x ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (hVieta :
      (∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1), u_all_0 j) *
        (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (u_α ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))))⁻¹ *
        (u_ω ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))) ∈
        unitGroup F M_C 1)
    (k_L k_E : Type u) [Field k_L] [Fintype k_L] [Field k_E] [Fintype k_E]
    (resL : L → k_L) (resE : E → k_E) (ψ_0E : AddChar k_E (Ω F))
    (hresL_props : IsResidueFieldMap F L k_L resL)
    (hresE_props :
      IsResidueFieldMap F E k_E resE ∧
      IsStatResChar F E (traceChar F hLE ψ)
        (χ'.comp (Units.map (normLM F hLE))) ϖ_E c'_χ'E k_E resE ψ_0E)
    (hp_char : ((p F : ℕ) : k_L) = 0)
    (ψ_ref : AddChar k_L (Ω F))
    (hψ_ref_spec : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_ref (resL x) = ψ ((((ϖ_L ^ (1 + condExpChar F L ψ))⁻¹ : Lˣ) : L) * x))
    (hG_L_scale : ∀ a : k_L, a ≠ 0 →
