      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal E' (AlgebraicClosure F) := Normal.tower_top_of_normal F E' (AlgebraicClosure F)
    have hK₁'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[E'] AlgebraicClosure F),
        (∀ x ∈ K₁', τ x = x) → ∀ x ∈ K₁', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
