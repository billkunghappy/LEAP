        · exact Or.inl rfl
        · right
          set vx : ℤ := vE' x
          rw [hk_eq] at hvx_ge
          have hbE'_le_z : (bE' : ℤ) ≤ (q₁ : ℤ) + ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by
            exact_mod_cast hbE'_le_q₁
