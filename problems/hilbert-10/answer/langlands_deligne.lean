  letI : Fintype (G_L ⧸ H_F') := Fintype.ofFinite (G_L ⧸ H_F')
  have hCard_eq : Fintype.card (Fin q₀) = Fintype.card (G_L ⧸ H_F') := by
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, hCardQ_LF', hFinF']
  obtain ⟨e_Q⟩ : Nonempty (Fin q₀ ≃ (G_L ⧸ H_F')) := ⟨Fintype.equivOfCardEq hCard_eq⟩
  refine ⟨fun j => cosetRep (e_Q j), fun w => ?_⟩
  haveI : Finite (G_F' ⧸ H_tF') := hFinQuot F' t.field hF't
  letI : Fintype (G_F' ⧸ H_tF') := Fintype.ofFinite (G_F' ⧸ H_tF')
  haveI : FiniteDimensional (Ω F) (indSpace H_tF' ρ_tF') := (hFrob H_tF' ρ_tF').1
  have htr_lhs : t.trace F L (ι_F' w) =
      LinearMap.trace (Ω F) _ (indLM F hLF' σ_t (ι_F' w)) := by
    have h1 : t.trace F L (ι_F' w) =
        (1 : ℤ) • LinearMap.trace (Ω F) _ (indLM F t.le (charRep F t.field t.χ) (ι_F' w)) :=
      congr_arg (fun c : ℤ => c • LinearMap.trace (Ω F) _ (indLM F t.le (charRep F t.field t.χ) (ι_F' w))) ht_coeff
    exact (h1.trans (one_zsmul _)).trans (hTrans (charRep F t.field t.χ) (ι_F' w))
  have htr_frob : LinearMap.trace (Ω F) _ (indLM F hLF' σ_t (ι_F' w)) =
      ∑ u₀ : G_L ⧸ H_F',
        if h_mem : (cosetRep u₀)⁻¹ * ι_F' w * cosetRep u₀ ∈ H_F' then
          LinearMap.trace (Ω F) (indSpace H_tF' ρ_tF')
            ((σ_t.comp e_LF'.toMonoidHom) ⟨(cosetRep u₀)⁻¹ * ι_F' w * cosetRep u₀, h_mem⟩)
        else 0 := (hFrob H_F' (σ_t.comp e_LF'.toMonoidHom)).2 (ι_F' w)
  have h_sum_eq :
      (∑ u₀ : G_L ⧸ H_F',
        if h_mem : (cosetRep u₀)⁻¹ * ι_F' w * cosetRep u₀ ∈ H_F' then
          LinearMap.trace (Ω F) (indSpace H_tF' ρ_tF')
            ((σ_t.comp e_LF'.toMonoidHom) ⟨(cosetRep u₀)⁻¹ * ι_F' w * cosetRep u₀, h_mem⟩)
        else 0) =
      ∑ u₀ : G_L ⧸ H_F', (t_conj (cosetRep u₀)).trace F F' w :=
    Finset.sum_congr rfl fun u₀ _ =>
      (dif_pos (h_conj_F' (cosetRep u₀) w)).trans (hConjTrace (cosetRep u₀) w)
  have h_reindex :
      (∑ u₀ : G_L ⧸ H_F', (t_conj (cosetRep u₀)).trace F F' w) =
      ∑ j : Fin q₀, (t_conj (cosetRep (e_Q j))).trace F F' w :=
    (Equiv.sum_comp e_Q (fun u₀ : G_L ⧸ H_F' => (t_conj (cosetRep u₀)).trace F F' w)).symm
  have h_ofFn :
      monomialListTrace F F' (List.ofFn (fun j : Fin q₀ => t_conj (cosetRep (e_Q j)))) w =
      ∑ j : Fin q₀, (t_conj (cosetRep (e_Q j))).trace F F' w := by
    simp only [monomialListTrace, List.map_ofFn, List.sum_ofFn, Function.comp_apply]
  exact ((htr_lhs.trans htr_frob).trans (h_sum_eq.trans h_reindex)).trans h_ofFn.symm

theorem ld_ch14_contained_orbit_term_conj_decomp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E F' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hLF' : L ≤ F') (hF'MC : F' ≤ M_C)
    (hGal : IsGaloisExt F L K) (hGalMC : IsGaloisExt F L M_C) (hGalMCK : IsGaloisExt F M_C K)
    (hAbMCK : IsAbelianExt F hM_CK) (hGalF' : IsGaloisExt F L F')
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀)
    (hFinF' : Module.finrank L (IntermediateField.extendScalars hLF') = q₀)
    (t : MonomialTerm F L) (htWf : t.Wf F L) (ht_coeff : t.coeff = 1)
    (hF't : F' ≤ t.field) (htMC : t.field ≤ M_C)
    (hSepFtMC : Algebra.IsSeparable t.field (IntermediateField.extendScalars htMC))
    (htK : t.field ≤ K) (ht_restK : restrictWeilChar F htK t.χ = 1)
    (hμ_pow : (recChar F rec t.field t.χ) ^ (p F) = 1)
    (hμ_comp_ne1 : ((recChar F rec t.field t.χ).comp (Units.map (normLM F htMC))) ≠ 1)
    (K_t : IntermediateField F (AlgebraicClosure F))
    (hFtKt : t.field ≤ K_t) (hKtK : K_t ≤ K)
    (hGalFtKt : IsGaloisExt F t.field K_t) (hAbFtKt : IsAbelianExt F hFtKt)
    (hμ_ker : ∀ z : t.fieldˣ,
      z ∈ Set.range (Units.map (normLM F hFtKt)) ↔ (recChar F rec t.field t.χ) z = 1) :
    ∃ D_F'_t : List (MonomialTerm F F'),
      (∀ s ∈ D_F'_t, s.Wf F F' ∧ s.field ≤ K) ∧
      (∀ w : relWeil F F',
        t.trace F L (Subgroup.inclusion (relWeil_antitone F hLF') w) =
          monomialListTrace F F' D_F'_t w) ∧
      evalMonomialList F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ) D_F'_t =
        (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t) ^ q₀ ∧
      evalMonomialList F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)
          (D_F'_t.map (twistMonomialTerm F F' (restrictWeilChar F hLF' χL_ext))) =
        (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext t)) ^ q₀ :=
by
  haveI : FiniteDimensional F t.field := htWf.1
  have h_single := fun g : relWeil F L =>
    ld_ch14_contained_orbit_single_conj_char_compat F rec L K M_C F' hLK hLM_C hM_CK hLF' hF'MC
      hGal hGalMC hGalMCK hAbMCK hGalF' ψ hψ χL_ext hχL_ext t htWf hF't htMC hSepFtMC
      htK ht_restK hμ_pow hμ_comp_ne1 g
  let hF'Mg : ∀ g : relWeil F L,
      F' ≤ t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) :=
    fun g => (h_single g).choose
  let χ_conj : ∀ g : relWeil F L,
      relWeil F (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) →* (Ω F)ˣ :=
    fun g => (h_single g).choose_spec.choose
  have h_spec : ∀ g : relWeil F L,
      let γ : AbsGal F := (g : AbsGal F)
      let M_g : IntermediateField F (AlgebraicClosure F) :=
        t.field.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
      let ϕ_g : t.field ≃ₐ[F] M_g :=
        t.field.equivMap (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
      let t_g : MonomialTerm F F' := ⟨1, M_g, hF'Mg g, χ_conj g⟩
      (∀ (u : relWeil F M_g)
        (hu : γ⁻¹ * (u : AbsGal F) * γ ∈ relWeil F t.field),
        χ_conj g u = t.χ ⟨γ⁻¹ * (u : AbsGal F) * γ, hu⟩) ∧
      FiniteDimensional F M_g ∧
      t_g.Wf F F' ∧
      M_g ≤ K ∧
      IsAdmissibleChar F t.field (traceChar F t.le ψ) ∧
      (∀ x : t.field,
        traceChar F (hF'Mg g) (traceChar F hLF' ψ) (ϕ_g x) =
          traceChar F t.le ψ x) ∧
      (∀ u ∈ unitGroup F t.field (condExp F t.field (recChar F rec t.field t.χ)),
        (recChar F rec t.field t.χ) u = 1) ∧
      (∀ z : t.fieldˣ,
        (recChar F rec M_g (χ_conj g)) (Units.map ϕ_g.toRingEquiv.toMonoidHom z) =
          (recChar F rec t.field t.χ) z) ∧
      (∀ u ∈ unitGroup F t.field
          (condExp F t.field
            (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext))),
        (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext)) u = 1) ∧
      (∀ z : t.fieldˣ,
        (recChar F rec M_g
          (χ_conj g * restrictWeilChar F (hF'Mg g) (restrictWeilChar F hLF' χL_ext)))
          (Units.map ϕ_g.toRingEquiv.toMonoidHom z) =
          (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext)) z) :=
    fun g => (h_single g).choose_spec.choose_spec
  let t_conj : relWeil F L → MonomialTerm F F' :=
    fun g => ⟨1, t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F),
      hF'Mg g, χ_conj g⟩
  have heval_un : ∀ g : relWeil F L,
      evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ) (t_conj g) =
        evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t := by
    intro g
    obtain ⟨_, hFinMg, _, _, hψt, htr_eq, hμ_cond, hμ_eq, _, _⟩ := h_spec g
    haveI : FiniteDimensional F
        (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) := hFinMg
    have h_inv := (ld_ch13_2_tateEpsUnit_algEquiv_invariance F t.field
      (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F))
      (t.field.equivMap ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F))
      (traceChar F t.le ψ) hψt
      (traceChar F (hF'Mg g) (traceChar F hLF' ψ)) htr_eq
      (recChar F rec t.field t.χ) hμ_cond
      (recChar F rec (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) (χ_conj g))
      hμ_eq).2
    dsimp [evalMonomialTerm, t_conj]
    rw [ht_coeff, mul_one, mul_one, zpow_one, zpow_one, h_inv]
  have heval_tw : ∀ g : relWeil F L,
      evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)
          (twistMonomialTerm F F' (restrictWeilChar F hLF' χL_ext) (t_conj g)) =
        evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext t) := by
    intro g
    obtain ⟨_, hFinMg, _, _, hψt, htr_eq, _, _, hμ_tw_cond, hμ_tw_eq⟩ := h_spec g
    haveI : FiniteDimensional F
        (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) := hFinMg
    have h_inv := (ld_ch13_2_tateEpsUnit_algEquiv_invariance F t.field
      (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F))
      (t.field.equivMap ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F))
      (traceChar F t.le ψ) hψt
      (traceChar F (hF'Mg g) (traceChar F hLF' ψ)) htr_eq
      (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext)) hμ_tw_cond
      (recChar F rec (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F))
        (χ_conj g * restrictWeilChar F (hF'Mg g) (restrictWeilChar F hLF' χL_ext)))
      hμ_tw_eq).2
    dsimp [evalMonomialTerm, twistMonomialTerm, t_conj]
    rw [ht_coeff, mul_one, mul_one, zpow_one, zpow_one, h_inv]
  obtain ⟨g_rep, hg_rep⟩ :=
    ld_ch14_normal_subfield_indLM_trace_coset_decomp F L F' hLF' hGalF' q₀ hFinF'
      t htWf ht_coeff hF't hF'Mg χ_conj (fun g => (h_spec g).1)
  refine ⟨List.ofFn (fun j : Fin q₀ => t_conj (g_rep j)), ?_, hg_rep, ?_, ?_⟩
  · intro s hs
    rw [List.mem_ofFn'] at hs
    rcases hs with ⟨j, rfl⟩
    exact ⟨(h_spec (g_rep j)).2.2.1, (h_spec (g_rep j)).2.2.2.1⟩
  · dsimp [evalMonomialList]
    rw [List.map_ofFn]
    have h_fn :
        ((evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)) ∘
          (fun j : Fin q₀ => t_conj (g_rep j))) =
        fun _ : Fin q₀ => evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t := by
      funext j
      exact heval_un (g_rep j)
    rw [h_fn, List.prod_ofFn, Finset.prod_const, Finset.card_fin]
  · dsimp [evalMonomialList]
    rw [List.map_ofFn, List.map_ofFn]
    have h_fn :
        ((evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)) ∘
          ((twistMonomialTerm F F' (restrictWeilChar F hLF' χL_ext)) ∘
            (fun j : Fin q₀ => t_conj (g_rep j)))) =
        fun _ : Fin q₀ =>
          evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext t) := by
      funext j
      exact heval_tw (g_rep j)
    rw [h_fn, List.prod_ofFn, Finset.prod_const, Finset.card_fin]

theorem ld_ch14_lemma_14_4_normal_cyclic_q0_pow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E F' : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hLF' : L ≤ F') (hF'MC : F' ≤ M_C)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hLF'_lt : L < F') (hGalF' : IsGaloisExt F L F') (hAbF' : IsAbelianExt F hLF')
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hSubfieldInd : ∀ (F₁ E₁ : IntermediateField F (AlgebraicClosure F))
      (hLF₁ : L ≤ F₁) (hF₁E₁ : F₁ ≤ E₁) (hE₁K : E₁ ≤ K),
      L < F₁ →
      ∀ (χF₁ : relWeil F F₁ →* (Ω F)ˣ),
        IsWeilRep F F₁ (charRep F F₁ χF₁) →
      ∀ (D_F₁ : List (MonomialTerm F F₁)),
        IsMonomialDecomp F F₁
          (fun w => (⟨1, E₁, hF₁E₁, 1⟩ : MonomialTerm F F₁).trace F F₁ w) D_F₁ →
        (∀ t ∈ D_F₁, t.field ≤ K) →
        tateEpsUnit F E₁ (recChar F rec E₁ (restrictWeilChar F hF₁E₁ χF₁))
            (traceChar F (hLF₁.trans hF₁E₁) ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) F₁ (traceChar F hLF₁ ψ) D_F₁ =
        tateEpsUnit F E₁ (recChar F rec E₁ 1)
            (traceChar F (hLF₁.trans hF₁E₁) ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) F₁ (traceChar F hLF₁ ψ)
            (D_F₁.map (twistMonomialTerm F F₁ χF₁)))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (hLowCond : ∀ (χ : relWeil F L →* (Ω F)ˣ),
      IsWeilRep F L (charRep F L χ) →
      condExp F L (recChar F rec L χ) ≤ 1 →
      tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χ)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
      tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χ)))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (h_ge2 : 2 ≤ condExp F L (recChar F rec L χL_ext))
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀) (hq₀_ne_p : q₀ ≠ p F)
    (hFinF' : Module.finrank L (IntermediateField.extendScalars hLF') = q₀)
    (hTwistInvL : ∀ (ν : relWeil F L →* (Ω F)ˣ),
      restrictWeilChar F hLM_C ν = 1 →
      ν ^ q₀ = 1 →
      IsWeilRep F L (charRep F L ν) ∧
      condExp F L (recChar F rec L ν) ≤ 1 ∧
      (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE (ν * χL_ext))) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ q₀ =
      (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ q₀ ∧
      (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L (ν * χL_ext)))) ^ q₀ =
      (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ q₀) :
    (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ (q₀ ^ 2) =
    (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ
        ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ (q₀ ^ 2) :=
by
  obtain ⟨htraceChar, _⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨hFinL, hFinMC, hFinE, hFinK, hGalMCK, hSepLE, hψMC, hψE, hψK, _, _, _, _, _, _, hOrb_pkg, _⟩ :=
    ld_ch14_stickelberger_orbit_recChar_and_pow_reduction F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin h_wild hFinE_eq χL_ext hχL_ext
      D_orb hD₁_sub hD_orb_deg hD_orb_props h_ge2
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F M_C := hFinMC
  haveI : FiniteDimensional F E := hFinE
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional F F' := hGalF'.2.1
  have hSepLF' : Algebra.IsSeparable L (IntermediateField.extendScalars hLF') := hGalF'.2.2.2 hLF'
  have hψF' : IsAdmissibleChar F F' (traceChar F hLF' ψ) :=
    ((htraceChar L F' hLF' hSepLF').2 ψ hψ).1
  obtain ⟨ν₁, hν₁_weil, hν₁_restF', hν₁_restMC, hν₁_pow, hν₁_ne, hDisjSup⟩ :=
    ld_ch14_cyclic_q0_char_and_disjoint_sup_decomp F rec L K M_C F' hLK hLM_C hM_CK hLF' hF'MC
      hGal hGalF' hAbF' q₀ hq₀_prime hFinF'
  have htrace_append : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (D₁ D₂ : List (MonomialTerm F M)) (w : relWeil F M),
      monomialListTrace F M (D₁ ++ D₂) w =
        monomialListTrace F M D₁ w + monomialListTrace F M D₂ w := by
    intro M D₁ D₂ w
    simp [monomialListTrace, List.map_append, List.sum_append]
  have heval_append : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (ψM : AddChar M (Ω F)) (D₁ D₂ : List (MonomialTerm F M)),
      evalMonomialList F rec (fun _ _ _ => 1) M ψM (D₁ ++ D₂) =
        evalMonomialList F rec (fun _ _ _ => 1) M ψM D₁ *
          evalMonomialList F rec (fun _ _ _ => 1) M ψM D₂ := by
