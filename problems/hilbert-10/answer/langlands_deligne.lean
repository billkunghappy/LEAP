      rwa [ne_eq, Subgroup.index_eq_one]
    have hd₁_ne0 : H_L'.index ≠ 0 := Subgroup.index_ne_zero_of_finite
    have hd₁_gt1 : 1 < H_L'.index := by omega
    have hN₁_HL'_idx : (N₁.subgroupOf H_L').index = q₀ := by
      let Ψ : H_L' ⧸ (N₁.subgroupOf H_L') → H ⧸ H_F' :=
        Quotient.lift (fun y : H_L' => QuotientGroup.mk (s := H_F') y.1) (by
          intro a b hab
          have hab' : a⁻¹ * b ∈ N₁.subgroupOf H_L' := QuotientGroup.leftRel_apply.mp hab
          exact QuotientGroup.eq.mpr (hN₁_le_HF' hab'))
      have hΨ_inj : Function.Injective Ψ := by
        intro x₁ x₂ hx
        induction' x₁ using Quotient.inductionOn' with a
        induction' x₂ using Quotient.inductionOn' with b
        change QuotientGroup.mk (s := H_F') a.1 = QuotientGroup.mk (s := H_F') b.1 at hx
        have hab_F : a.1⁻¹ * b.1 ∈ H_F' := QuotientGroup.eq.mp hx
        have hab_L : a.1⁻¹ * b.1 ∈ H_L' := H_L'.mul_mem (H_L'.inv_mem a.2) b.2
