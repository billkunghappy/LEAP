            (evalMonomialTerm F rec (fun _ E _ => f E) L ψ ⟨1, t.field, t.le, t.χ⟩) ^ t.coeff := by
          simp [evalMonomialTerm]
        have hD_t_ev : evalMonomialList F rec (fun _ E _ => f E) L ψ D_t =
            evalMonomialTerm F rec (fun _ E _ => f E) L ψ t := by
          dsimp only [D_t]
          rw [hscale_eval, ← heval_E, ht_ev]
        rw [heval_append, hcons_ev, hD_t_ev]
        exact congrArg (evalMonomialTerm F rec (fun _ E _ => f E) L ψ t * ·) heval_tl
  obtain ⟨D_M, hD_M_decomp, hD_M_le, heval_eq⟩ := hListDescent D hD.1.1 hD.2
  refine ⟨D_M, ⟨hD_M_decomp.1, fun w => ?_⟩, hD_M_le, heval_eq⟩
  rw [hD.1.2 w]
  exact hD_M_decomp.2 w

theorem ld_non_nilpotent_brauer_one (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hNotNilp : ¬ Group.IsNilpotent ((IntermediateField.extendScalars hLK) ≃ₐ[L] (IntermediateField.extendScalars hLK))) :
    ∃ D_triv : List (MonomialTerm F L),
      IsMonomialDecomp F L (fun _ => 1) D_triv ∧
      ∀ s ∈ D_triv, ∃ hsK : s.field ≤ K,
        Module.finrank s.field (IntermediateField.extendScalars hsK) <
          Module.finrank L (IntermediateField.extendScalars hLK) :=
by
  
  have h_s5 : ∀ (G : Type u) [Group G] [Fintype G]
      (hNotNilp : ¬ Group.IsNilpotent G)
      (C₀ : Subgroup G) [C₀.Normal] (hC₀_ne : ∃ c ∈ C₀, c ≠ 1)
      (hC₀_ab : ∀ a ∈ C₀, ∀ b ∈ C₀, a * b = b * a),
      ∃ (C : Subgroup G) (hC_norm : C.Normal),
        (∃ c ∈ C, c ≠ 1) ∧
        (∀ a ∈ C, ∀ b ∈ C, a * b = b * a) ∧
        (@Group.IsNilpotent (G ⧸ C) (@QuotientGroup.Quotient.group G _ C hC_norm) →
          (∃ H : Subgroup G, H < ⊤ ∧ ∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c) ∧
          (∀ (M : Subgroup G) (hC_le : C ≤ M) (ψ : M →* (Ω F)ˣ),
            (∃ c : C, ψ ⟨c.1, hC_le c.2⟩ ≠ 1) →
            (∀ g : G, g ∈ M ↔
              ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C),
                ψ ⟨g⁻¹ * c.1 * g, hC_le hc⟩ = ψ ⟨c.1, hC_le c.2⟩) →
            M < ⊤)) := by
    intro G _ _ hNotNilp_G C₀ hC₀_norm hC₀_ne hC₀_ab
    let S : Finset (Subgroup G) :=
      Finset.univ.filter (fun N : Subgroup G => N.Normal ∧ N ≤ C₀ ∧ ∃ c ∈ N, c ≠ 1)
    have hC₀_mem : C₀ ∈ S :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ C₀, hC₀_norm, le_rfl, hC₀_ne⟩
    obtain ⟨C, hC_mem, hC_min_card⟩ :=
      Finset.exists_min_image S (fun N : Subgroup G => Nat.card N) ⟨C₀, hC₀_mem⟩
    rcases (Finset.mem_filter.mp hC_mem).2 with ⟨hC_norm, hC_le_C₀, hC_ne⟩
    haveI : C.Normal := hC_norm
    have hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a :=
      fun a ha b hb => hC₀_ab a (hC_le_C₀ ha) b (hC_le_C₀ hb)
    have hC_min : ∀ N : Subgroup G, N.Normal → N ≤ C → (∃ c ∈ N, c ≠ 1) → N = C := by
      intro N hN_norm hNC hN_ne
      have hN_mem : N ∈ S :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ N, hN_norm, hNC.trans hC_le_C₀, hN_ne⟩
      exact Subgroup.eq_of_le_of_card_ge hNC (hC_min_card N hN_mem)
    refine ⟨C, hC_norm, hC_ne, hC_ab, fun hNilp_quot => ?_⟩
    haveI : Group.IsNilpotent (G ⧸ C) := hNilp_quot
    have h_not_cent : ∃ g₀ : G, ∃ c₀ ∈ C, g₀ * c₀ ≠ c₀ * g₀ := by
      by_contra h_all_comm
      push_neg at h_all_comm
      have hC_cent : C ≤ Subgroup.center G := by
        intro c hc
        rw [Subgroup.mem_center_iff]
        exact fun g => h_all_comm g c hc
      let f_cent : G ⧸ C →* G ⧸ Subgroup.center G :=
        QuotientGroup.map C (Subgroup.center G) (MonoidHom.id G) hC_cent
      have hf_surj : Function.Surjective f_cent := by
        intro q
        obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center G) q
        exact ⟨QuotientGroup.mk' C g, rfl⟩
      have hNilp_Z : Group.IsNilpotent (G ⧸ Subgroup.center G) :=
        nilpotent_of_surjective f_cent hf_surj
      exact hNotNilp_G (of_quotient_center_nilpotent hNilp_Z)
    refine ⟨?_, ?_⟩
    · have h_tfae_G := (isNilpotent_of_finite_tfae (G := G)).out 0 2
      have h_not_all_norm : ¬ (∀ H : Subgroup G, IsCoatom H → H.Normal) :=
        fun h => hNotNilp_G (h_tfae_G.mpr h)
      push_neg at h_not_all_norm
      rcases h_not_all_norm with ⟨H, hH_coatom, hH_not_norm⟩
      have hH_lt_top : H < ⊤ := lt_top_iff_ne_top.mpr hH_coatom.1
      have h_not_CH : ¬ (C ≤ H) := by
        intro hCH
        let q := QuotientGroup.mk' C
        have hq_surj : Function.Surjective q := QuotientGroup.mk'_surjective C
        have hq_ker : q.ker = C := QuotientGroup.ker_mk' C
        have h_comap_H : (H.map q).comap q = H :=
