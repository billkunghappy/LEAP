    hδ_eq, hu_K_norm, hu_K_val, hδ_val, hnorm_to_tr,
    hu_corr_eq, hc_K_eq, hc_K_val, hc_K_stat, hrhs_twist⟩

theorem ld_wild_finite_field_hasse_power_identities (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (ψ₀ : AddChar k (Ω F)) (hψ₀ : ψ₀ ≠ 1) :
    ((2 : k) = 0 →
      ∀ (Q : k → Ω F),
        Q 0 = 1 →
        (∀ x y : k, Q (x + y) = Q x * Q y * ψ₀ (x * y)) →
        ((∀ x : k, Q x ≠ 0) →
          (∑ x : k, Q x) * (∑ y : k, (Q y)⁻¹) = (Fintype.card k : Ω F)) ∧
        (∀ x₀ : k, (∀ y : k, (Q y) ^ 2 = ψ₀ (x₀ * y)) →
          (∑ x : k, Q x) ^ 2 = (Fintype.card k : Ω F) * Q x₀)) ∧
    (∀ (p : ℕ), Nat.Prime p → p ≠ 2 → (p : k) = 0 →
      ∀ (c : k), c ≠ 0 →
      ∀ (Q : k → Ω F),
        Q 0 = 1 →
        (∀ x y : k, Q (x + y) = Q x * Q y * ψ₀ (c * x * y)) →
        (∀ x : k, (Q x) ^ p = 1) →
        (∑ x : k, Q x) ^ p =
          (Fintype.card k : Ω F) ^ ((p - 1) / 2) *
            (∑ x : k, ψ₀ ((-1 : k) ^ ((p - 1) / 2) * (2 : k)⁻¹ * c * x ^ 2))) :=
by
  obtain ⟨z₀, hz₀⟩ := DFunLike.ne_iff.mp hψ₀
  rw [AddChar.one_apply] at hz₀
  have hψ0 : ψ₀ 0 = 1 := AddChar.map_zero_eq_one ψ₀
  have hψadd : ∀ x y : k, ψ₀ (x + y) = ψ₀ x * ψ₀ y := AddChar.map_add_eq_mul ψ₀
  suffices h_gen :
      ∀ (R : Type) [Field R] [CharZero R]
        (ψ_fn : k → R),
        ψ_fn 0 = 1 →
        (∀ x y : k, ψ_fn (x + y) = ψ_fn x * ψ_fn y) →
        ψ_fn z₀ ≠ 1 →
        ((2 : k) = 0 →
          ∀ (Q : k → R),
            Q 0 = 1 →
            (∀ x y : k, Q (x + y) = Q x * Q y * ψ_fn (x * y)) →
            ((∀ x : k, Q x ≠ 0) →
              (∑ x : k, Q x) * (∑ y : k, (Q y)⁻¹) = (Fintype.card k : R)) ∧
            (∀ x₀ : k, (∀ y : k, (Q y) ^ 2 = ψ_fn (x₀ * y)) →
              (∑ x : k, Q x) ^ 2 = (Fintype.card k : R) * Q x₀)) ∧
        (∀ (p : ℕ), Nat.Prime p → p ≠ 2 → (p : k) = 0 →
          ∀ (c : k), c ≠ 0 →
          ∀ (Q : k → R),
            Q 0 = 1 →
            (∀ x y : k, Q (x + y) = Q x * Q y * ψ_fn (c * x * y)) →
            (∀ x : k, (Q x) ^ p = 1) →
            (∑ x : k, Q x) ^ p =
              (Fintype.card k : R) ^ ((p - 1) / 2) *
                (∑ x : k, ψ_fn ((-1 : k) ^ ((p - 1) / 2) * (2 : k)⁻¹ * c * x ^ 2))) by
    exact h_gen (Ω F) (fun x => ψ₀ x) hψ0 hψadd hz₀
  clear * -
  intro R _ _ ψ_fn hψ0 hψadd hz₀
  have horth : ∀ u : k, (∑ y : k, ψ_fn (u * y)) = if u = 0 then (Fintype.card k : R) else 0 := by
    intro u
    by_cases hu : u = 0
    · simp [hu, hψ0]
    · rw [if_neg hu]
      have hshift : (∑ y : k, ψ_fn (u * y)) = (∑ y : k, ψ_fn (u * y)) * ψ_fn z₀ := by
        rw [Finset.sum_mul]
        refine (Fintype.sum_equiv (Equiv.addRight (u⁻¹ * z₀)) _ _ fun y => ?_).symm
        change ψ_fn (u * y) * ψ_fn z₀ = ψ_fn (u * (y + u⁻¹ * z₀))
        have heq : u * (y + u⁻¹ * z₀) = u * y + z₀ := by
          rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hu, one_mul]
        rw [heq, hψadd]
      have hsub : (∑ y : k, ψ_fn (u * y)) * (ψ_fn z₀ - 1) = 0 := by
        calc (∑ y : k, ψ_fn (u * y)) * (ψ_fn z₀ - 1)
          _ = (∑ y : k, ψ_fn (u * y)) * ψ_fn z₀ - (∑ y : k, ψ_fn (u * y)) := by ring
          _ = 0 := sub_eq_zero.mpr hshift.symm
      rcases mul_eq_zero.mp hsub with h | h
      · exact h
      · exact False.elim (hz₀ (sub_eq_zero.mp h))
  refine ⟨?_, ?_⟩
  · intro h2 Q hQ0 hQadd
    refine ⟨?_, ?_⟩
    · intro hQne
      rw [Finset.sum_mul_sum, Finset.sum_comm]
      have h1 : ∀ y : k, (∑ x : k, Q x * (Q y)⁻¹) = ∑ h : k, Q h * ψ_fn (h * y) := by
        intro y
        refine (Fintype.sum_equiv (Equiv.addRight y) _ _ fun h => ?_).symm
        change Q h * ψ_fn (h * y) = Q (h + y) * (Q y)⁻¹
        rw [hQadd h y]
        calc Q h * ψ_fn (h * y)
          _ = Q h * ψ_fn (h * y) * (Q y * (Q y)⁻¹) := by rw [mul_inv_cancel₀ (hQne y), mul_one]
          _ = Q h * Q y * ψ_fn (h * y) * (Q y)⁻¹ := by ring
      simp_rw [h1]
      rw [Finset.sum_comm]
      simp_rw [← Finset.mul_sum, horth]
      rw [Finset.sum_eq_single (0 : k)]
      · simp [hQ0]
      · intro h _ hh
        simp [hh]
      · intro habs
        exact False.elim (habs (Finset.mem_univ 0))
    · intro x₀ hQsq
      rw [sq, Finset.sum_mul_sum, Finset.sum_comm]
      have h1 : ∀ y : k, (∑ x : k, Q x * Q y) = ∑ h : k, Q h * ψ_fn ((x₀ + h) * y) := by
        intro y
        refine (Fintype.sum_equiv (Equiv.addRight y) _ _ fun h => ?_).symm
        change Q h * ψ_fn ((x₀ + h) * y) = Q (h + y) * Q y
        have hstep : Q (h + y) * Q y = Q h * ((Q y) ^ 2 * ψ_fn (h * y)) := by
          rw [hQadd h y]; ring
        rw [hstep, hQsq y, ← hψadd, ← add_mul]
      simp_rw [h1]
      rw [Finset.sum_comm]
      simp_rw [← Finset.mul_sum, horth]
      have hchar2 : ∀ a : k, a + a = 0 := by
        intro a
        rw [← two_mul, h2, zero_mul]
      rw [Finset.sum_eq_single x₀]
      · rw [if_pos (hchar2 x₀), mul_comm]
      · intro h _ hh
        have hne : x₀ + h ≠ 0 := by
          intro heq
          apply hh
          calc h = 0 + h := (zero_add h).symm
            _ = (x₀ + x₀) + h := by rw [hchar2 x₀]
            _ = x₀ + (x₀ + h) := add_assoc x₀ x₀ h
            _ = x₀ := by rw [heq, add_zero]
        rw [if_neg hne, mul_zero]
      · intro habs
        exact False.elim (habs (Finset.mem_univ x₀))
  · intro p hp hp_ne2 hp0 c hc Q hQ0 hQadd hQpow
    have hdvd : ringChar k ∣ p := (ringChar.spec k p).mp hp0
    have hring : ringChar k = p := by
      rcases (Nat.dvd_prime hp).mp hdvd with h1 | hpeq
      · exfalso
        have h10 : ((1 : ℕ) : k) = 0 := (ringChar.spec k 1).mpr (by rw [h1])
        rw [Nat.cast_one] at h10
        exact one_ne_zero h10
      · exact hpeq
    have h2_ne : (2 : k) ≠ 0 := Ring.two_ne_zero (hring ▸ hp_ne2)
    set a₀ : k := (2 : k)⁻¹ * c
    have ha₀ : a₀ ≠ 0 := mul_ne_zero (inv_ne_zero h2_ne) hc
    have h2a₀ : (2 : k) * a₀ = c := by
      dsimp [a₀]
      rw [← mul_assoc, mul_inv_cancel₀ h2_ne, one_mul]
    let g : k → R := fun x => Q x * ψ_fn (-(a₀ * x ^ 2))
    have hg0 : g 0 = 1 := by
      dsimp [g]
      rw [hQ0, sq, mul_zero, mul_zero, neg_zero, hψ0, mul_one]
    have hgadd : ∀ x y : k, g (x + y) = g x * g y := by
      intro x y
      have halg : c * x * y + -(a₀ * (x + y) ^ 2) = -(a₀ * x ^ 2) + -(a₀ * y ^ 2) := by
        rw [← h2a₀]; ring
      dsimp [g]
      rw [hQadd x y, mul_assoc (Q x * Q y), ← hψadd, halg, hψadd]
      ring
    have hψ_neg : ∀ u : k, ψ_fn (-u) * ψ_fn u = 1 := by
      intro u
      rw [← hψadd, neg_add_cancel, hψ0]
    let T : k → R := fun b => ∑ x : k, g x * ψ_fn (-(c * b * x))
    have hsumT : (∑ b : k, T b) = (Fintype.card k : R) := by
      dsimp [T]
      rw [Finset.sum_comm]
      have hinner : ∀ x : k, (∑ b : k, g x * ψ_fn (-(c * b * x))) =
          g x * ∑ b : k, ψ_fn ((-(c * x)) * b) := by
        intro x
        rw [← Finset.mul_sum]
        refine congrArg (g x * ·) (Finset.sum_congr rfl fun b _ => ?_)
        congr 1
        ring
      simp_rw [hinner, horth]
      rw [Finset.sum_eq_single (0 : k)]
      · simp [hg0]
      · intro x _ hx
        have hcx : -(c * x) ≠ 0 := neg_ne_zero.mpr (mul_ne_zero hc hx)
        rw [if_neg hcx, mul_zero]
      · intro habs
        exact False.elim (habs (Finset.mem_univ 0))
    have hcard_ne : (Fintype.card k : R) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_pos.ne'
    have hsumT_ne : (∑ b : k, T b) ≠ 0 := hsumT.symm ▸ hcard_ne
    obtain ⟨x₁, _, hTx₁⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsumT_ne
    have hg_eq : ∀ y : k, g y = ψ_fn (c * x₁ * y) := by
      intro y
      have hshift : T x₁ = T x₁ * (g y * ψ_fn (-(c * x₁ * y))) := by
        dsimp [T]
        rw [Finset.sum_mul]
        refine (Fintype.sum_equiv (Equiv.addRight y) _ _ fun x => ?_).symm
        change g x * ψ_fn (-(c * x₁ * x)) * (g y * ψ_fn (-(c * x₁ * y))) =
          g (x + y) * ψ_fn (-(c * x₁ * (x + y)))
        have halg : -(c * x₁ * (x + y)) = -(c * x₁ * x) + -(c * x₁ * y) := by ring
        rw [hgadd x y, halg, hψadd]
        ring
      have hsub : T x₁ * (g y * ψ_fn (-(c * x₁ * y)) - 1) = 0 := by
        calc T x₁ * (g y * ψ_fn (-(c * x₁ * y)) - 1)
          _ = T x₁ * (g y * ψ_fn (-(c * x₁ * y))) - T x₁ := by ring
          _ = 0 := sub_eq_zero.mpr hshift.symm
      have h1 : g y * ψ_fn (-(c * x₁ * y)) = 1 := by
        rcases mul_eq_zero.mp hsub with h | h
        · exact False.elim (hTx₁ h)
        · exact sub_eq_zero.mp h
      calc g y = g y * (ψ_fn (-(c * x₁ * y)) * ψ_fn (c * x₁ * y)) := by
            rw [hψ_neg, mul_one]
        _ = (g y * ψ_fn (-(c * x₁ * y))) * ψ_fn (c * x₁ * y) := by ring
        _ = ψ_fn (c * x₁ * y) := by rw [h1, one_mul]
    have hQ_formula : ∀ x : k, Q x = ψ_fn (c * x₁ * x + a₀ * x ^ 2) := by
      intro x
      calc Q x = Q x * (ψ_fn (-(a₀ * x ^ 2)) * ψ_fn (a₀ * x ^ 2)) := by
            rw [hψ_neg, mul_one]
        _ = g x * ψ_fn (a₀ * x ^ 2) := by dsimp [g]; ring
        _ = ψ_fn (c * x₁ * x) * ψ_fn (a₀ * x ^ 2) := by rw [hg_eq x]
        _ = ψ_fn (c * x₁ * x + a₀ * x ^ 2) := (hψadd _ _).symm
    have hQ_complete_sq : ∀ x : k, Q x = Q (-x₁) * ψ_fn (a₀ * (x + x₁) ^ 2) := by
      intro x
      rw [hQ_formula x, hQ_formula (-x₁), ← hψadd]
      congr 1
      rw [← h2a₀]
      ring
    have hsumQ : (∑ x : k, Q x) = Q (-x₁) * ∑ x : k, ψ_fn (a₀ * x ^ 2) := by
      calc (∑ x : k, Q x)
        _ = ∑ x : k, Q (-x₁) * ψ_fn (a₀ * (x + x₁) ^ 2) :=
            Finset.sum_congr rfl fun x _ => hQ_complete_sq x
        _ = Q (-x₁) * ∑ x : k, ψ_fn (a₀ * (x + x₁) ^ 2) := (Finset.mul_sum _ _ _).symm
        _ = Q (-x₁) * ∑ x : k, ψ_fn (a₀ * x ^ 2) := by
            congr 1
            refine Fintype.sum_equiv (Equiv.addRight x₁) _ _ fun x => rfl
    have hQ_pow_eq : (∑ x : k, Q x) ^ p = (∑ x : k, ψ_fn (a₀ * x ^ 2)) ^ p := by
      rw [hsumQ, mul_pow, hQpow (-x₁), one_mul]
    rw [hQ_pow_eq]
    let S : k → R := fun a => ∑ x : k, ψ_fn (a * x ^ 2)
    have hS_prod : S a₀ * S (-a₀) = (Fintype.card k : R) := by
      dsimp [S]
      rw [Finset.sum_mul_sum, Finset.sum_comm]
      have h1 : ∀ y : k, (∑ x : k, ψ_fn (a₀ * x ^ 2) * ψ_fn (-a₀ * y ^ 2)) =
          ∑ h : k, ψ_fn (a₀ * h ^ 2) * ψ_fn (((2 : k) * a₀ * h) * y) := by
        intro y
        refine (Fintype.sum_equiv (Equiv.addRight y) _ _ fun h => ?_).symm
        change ψ_fn (a₀ * h ^ 2) * ψ_fn (((2 : k) * a₀ * h) * y) =
          ψ_fn (a₀ * (h + y) ^ 2) * ψ_fn (-a₀ * y ^ 2)
        rw [← hψadd, ← hψadd]
        congr 1
        ring
      simp_rw [h1]
      rw [Finset.sum_comm]
      simp_rw [← Finset.mul_sum, horth]
      rw [Finset.sum_eq_single (0 : k)]
      · simp [hψ0]
      · intro h _ hh
        have hne : (2 : k) * a₀ * h ≠ 0 := mul_ne_zero (mul_ne_zero h2_ne ha₀) hh
        rw [if_neg hne, mul_zero]
      · intro habs
        exact False.elim (habs (Finset.mem_univ 0))
    have hS_sign : S (-a₀) = S a₀ ∨ S (-a₀) = - S a₀ := by
      by_cases hsq : ∃ s : k, s ^ 2 = -1
      · left
        obtain ⟨s, hs⟩ := hsq
        have hs_ne : s ≠ 0 := by
          intro h0
          rw [h0, zero_pow two_ne_zero] at hs
          exact one_ne_zero (neg_eq_zero.mp hs.symm)
        dsimp [S]
        refine (Fintype.sum_equiv (Equiv.mulLeft₀ s hs_ne) _ _ fun x => ?_).symm
        change ψ_fn (a₀ * x ^ 2) = ψ_fn (-a₀ * (s * x) ^ 2)
        congr 1
        calc a₀ * x ^ 2 = -a₀ * (-1) * x ^ 2 := by ring
          _ = -a₀ * s ^ 2 * x ^ 2 := by rw [← hs]
          _ = -a₀ * (s * x) ^ 2 := by ring
      · right
        set S₀ : Finset k := Finset.univ.erase 0
        set Q_pos : Finset k := S₀.image (fun x : k => x ^ 2)
        set Q_neg : Finset k := Q_pos.image (fun u : k => -u)
        have hne_neg : ∀ x : k, x ≠ 0 → x ≠ -x := by
          intro x hx heq
          have h2x : (2 : k) * x = 0 := by
            calc (2 : k) * x = x + x := two_mul x
              _ = x + -x := by conv_rhs => rw [← heq]
              _ = 0 := add_neg_cancel x
          exact mul_ne_zero h2_ne hx h2x
        have hfiber_eq : ∀ x₀ ∈ S₀,
            S₀.filter (fun x : k => x ^ 2 = x₀ ^ 2) = {x₀, -x₀} := by
          intro x₀ hx₀
          have hx₀_ne : x₀ ≠ 0 := Finset.ne_of_mem_erase hx₀
          ext x
          simp only [S₀, Finset.mem_filter, Finset.mem_erase, Finset.mem_univ, and_true,
            Finset.mem_insert, Finset.mem_singleton, sq_eq_sq_iff_eq_or_eq_neg]
          constructor
          · rintro ⟨_, h⟩; exact h
          · rintro (rfl | rfl)
            · exact ⟨hx₀_ne, Or.inl rfl⟩
            · exact ⟨neg_ne_zero.mpr hx₀_ne, Or.inr rfl⟩
        have hfiber_card : ∀ u ∈ Q_pos,
            (S₀.filter (fun x : k => x ^ 2 = u)).card = 2 := by
          intro u hu
          rcases Finset.mem_image.mp hu with ⟨x₀, hx₀, rfl⟩
          have hx₀_ne : x₀ ≠ 0 := Finset.ne_of_mem_erase hx₀
          rw [hfiber_eq x₀ hx₀, Finset.card_pair (hne_neg x₀ hx₀_ne)]
        have hcard_S₀ : S₀.card = 2 * Q_pos.card := by
          rw [Finset.card_eq_sum_card_fiberwise
            (f := fun x : k => x ^ 2) (t := Q_pos)
            (fun x hx => Finset.mem_image_of_mem _ hx)]
          rw [Finset.sum_const_nat hfiber_card, mul_comm]
        have hsum_Q_pos : ∀ f : k → R,
            (∑ x ∈ S₀, f (x ^ 2)) = 2 * ∑ u ∈ Q_pos, f u := by
          intro f
          rw [← Finset.sum_fiberwise_of_maps_to
            (g := fun x : k => x ^ 2) (t := Q_pos)
            (fun x hx => Finset.mem_image_of_mem _ hx)]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun u hu => ?_
          rw [Finset.sum_congr rfl (fun x hx => congrArg f (Finset.mem_filter.mp hx).2)]
          rw [Finset.sum_const, hfiber_card u hu, nsmul_eq_mul, Nat.cast_two]
        have hcard_Q_neg : Q_neg.card = Q_pos.card :=
          Finset.card_image_of_injective Q_pos neg_injective
        have hsum_Q_neg : ∀ f : k → R,
            (∑ v ∈ Q_neg, f v) = ∑ u ∈ Q_pos, f (-u) := by
          intro f
          exact Finset.sum_image (fun _ _ _ _ h => neg_injective h)
        have hdisj : Disjoint Q_pos Q_neg := by
          rw [Finset.disjoint_left]
          intro u hu_pos hu_neg
          rcases Finset.mem_image.mp hu_pos with ⟨x, hx, rfl⟩
          rcases Finset.mem_image.mp hu_neg with ⟨v, hv_pos, hv_eq⟩
          rcases Finset.mem_image.mp hv_pos with ⟨y, hy, rfl⟩
          have hy_ne : y ≠ 0 := Finset.ne_of_mem_erase hy
          apply hsq ⟨x * y⁻¹, ?_⟩
          calc (x * y⁻¹) ^ 2 = x ^ 2 * (y ^ 2)⁻¹ := by ring
            _ = -(y ^ 2) * (y ^ 2)⁻¹ := by rw [← hv_eq]
            _ = -(y ^ 2 * (y ^ 2)⁻¹) := neg_mul _ _
            _ = -1 := by rw [mul_inv_cancel₀ (pow_ne_zero 2 hy_ne)]
        have hsub_S₀ : Q_pos ∪ Q_neg ⊆ S₀ := by
          rw [Finset.union_subset_iff]
          refine ⟨?_, ?_⟩
          · intro u hu
            rcases Finset.mem_image.mp hu with ⟨x, hx, rfl⟩
            exact Finset.mem_erase.mpr ⟨pow_ne_zero 2 (Finset.ne_of_mem_erase hx), Finset.mem_univ _⟩
          · intro v hv
            rcases Finset.mem_image.mp hv with ⟨u, hu, rfl⟩
            rcases Finset.mem_image.mp hu with ⟨x, hx, rfl⟩
            exact Finset.mem_erase.mpr
              ⟨neg_ne_zero.mpr (pow_ne_zero 2 (Finset.ne_of_mem_erase hx)), Finset.mem_univ _⟩
        have hunion_eq : Q_pos ∪ Q_neg = S₀ := by
          apply Finset.eq_of_subset_of_card_le hsub_S₀
          rw [Finset.card_union_of_disjoint hdisj, hcard_Q_neg, hcard_S₀, two_mul]
        have hsum_zero : S a₀ + S (-a₀) = 0 := by
          have hSa₀ : S a₀ = 1 + 2 * ∑ u ∈ Q_pos, ψ_fn (a₀ * u) := by
            dsimp [S]
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (0 : k))]
            rw [zero_pow two_ne_zero, mul_zero, hψ0]
            congr 1
            exact hsum_Q_pos (fun u => ψ_fn (a₀ * u))
          have hSna₀ : S (-a₀) = 1 + 2 * ∑ v ∈ Q_neg, ψ_fn (a₀ * v) := by
            dsimp [S]
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (0 : k))]
            rw [zero_pow two_ne_zero, mul_zero, hψ0]
            congr 1
            rw [hsum_Q_neg (fun v => ψ_fn (a₀ * v))]
            have h1 := hsum_Q_pos (fun u => ψ_fn (-a₀ * u))
            refine h1.trans (congrArg (2 * ·) (Finset.sum_congr rfl fun u _ => ?_))
            congr 1
            ring
          have hall : (∑ u : k, ψ_fn (a₀ * u)) = 0 := by
            rw [horth a₀, if_neg ha₀]
          have hsplit_all : (∑ u : k, ψ_fn (a₀ * u)) =
              1 + ((∑ u ∈ Q_pos, ψ_fn (a₀ * u)) + ∑ v ∈ Q_neg, ψ_fn (a₀ * v)) := by
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (0 : k))]
            simp only [mul_zero, hψ0]
            congr 1
            change (∑ u ∈ S₀, ψ_fn (a₀ * u)) = _
            rw [← hunion_eq, Finset.sum_union hdisj]
          calc S a₀ + S (-a₀)
            _ = 2 * (1 + ((∑ u ∈ Q_pos, ψ_fn (a₀ * u)) + ∑ v ∈ Q_neg, ψ_fn (a₀ * v))) := by
                rw [hSa₀, hSna₀]; ring
            _ = 2 * (∑ u : k, ψ_fn (a₀ * u)) := by rw [← hsplit_all]
            _ = 0 := by rw [hall, mul_zero]
        exact eq_neg_of_add_eq_zero_right hsum_zero
    set M := (p - 1) / 2
    have hp_odd : p % 2 = 1 := (Nat.Prime.eq_two_or_odd hp).resolve_left hp_ne2
    have hp_eq : p = 2 * M + 1 := by omega
    have hpow_eval : (S a₀) ^ p = (Fintype.card k : R) ^ M * S ((-1 : k) ^ M * a₀) := by
      have hpow_split : (S a₀) ^ p = ((S a₀) ^ 2) ^ M * S a₀ := by
        conv_lhs => rw [hp_eq]
        rw [pow_add, pow_mul, pow_one]
      rw [hpow_split]
      rcases hS_sign with h_eq | h_neg
      · have hsq_eq : (S a₀) ^ 2 = (Fintype.card k : R) := by
          calc (S a₀) ^ 2 = S a₀ * S a₀ := sq (S a₀)
            _ = S a₀ * S (-a₀) := by rw [h_eq]
            _ = (Fintype.card k : R) := hS_prod
        rw [hsq_eq]
        congr 1
        have hpm1 : ((-1 : k) ^ M) ^ 2 = 1 := by
          rw [← pow_mul, mul_comm M 2, pow_mul, neg_one_sq, one_pow]
        rcases sq_eq_one_iff.mp hpm1 with h1 | hm1
        · rw [h1, one_mul]
        · rw [hm1, neg_one_mul, h_eq]
      · have hsq_neg : (S a₀) ^ 2 = (-1 : R) * (Fintype.card k : R) := by
          calc (S a₀) ^ 2 = S a₀ * S a₀ := sq (S a₀)
            _ = -(S a₀ * (-S a₀)) := by ring
            _ = -(S a₀ * S (-a₀)) := by rw [← h_neg]
            _ = (-1 : R) * (Fintype.card k : R) := by rw [hS_prod]; ring
        rw [hsq_neg, mul_pow]
        rcases Nat.even_or_odd' M with ⟨k₀, hk₀ | hk₀⟩
        · have hR1 : (-1 : R) ^ M = 1 := by
            rw [hk₀, pow_mul, neg_one_sq, one_pow]
          have hk1 : (-1 : k) ^ M = 1 := by
            rw [hk₀, pow_mul, neg_one_sq, one_pow]
          rw [hR1, hk1, one_mul, one_mul]
        · have hR1 : (-1 : R) ^ M = -1 := by
            rw [hk₀, pow_add, pow_mul, neg_one_sq, one_pow, pow_one, one_mul]
          have hk1 : (-1 : k) ^ M = -1 := by
            rw [hk₀, pow_add, pow_mul, neg_one_sq, one_pow, pow_one, one_mul]
          rw [hR1, hk1, neg_one_mul (a₀), h_neg]
          ring
    change (S a₀) ^ p = _
    rw [hpow_eval]
    congr 1
    refine Finset.sum_congr rfl fun x _ => ?_
    congr 1
    dsimp [a₀]
    ring

theorem ld_wild_mid_cond_dyadic_quad_norm_and_prefactor (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hba : condExp F L ν₁ < condExp F L χ')
    (ha2b : condExp F L χ' < 2 * condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (hp_val : ((Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * condExp F L ν₁ /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))))
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_ν₁ : ν₁ c_ν₁ = 1)
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hnorm_to_tr : ∀ z : K, (z = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      ψ (((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hrhs_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ τ : L, (τ = 0 ∨ 0 ≤ valL F L τ) →
        (τ - (j : L) = 0 ∨
          ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) *
            condExp F L ν₁ /
            Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
            valL F L (τ - (j : L)))) →
        ∃ u_τ : Lˣ,
          (u_τ : L) = 1 + τ * (δ : L) ∧
          tateEps F L (ν₁ ^ j * χ') ψ =
            (((ν₁ ^ j * χ') u_τ : Ω F)⁻¹) *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * τ * (δ : L)) *
              tateEps F L χ' ψ) :
    (2 : k_L) = 0 ∧
    (∀ x : L, traceLM F hLK (IntermediateField.inclusion hLK x) = (2 : L) * x) ∧
    (∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y) ∧
    (∀ x : L, normLM F hLK (IntermediateField.inclusion hLK x) = x ^ 2) ∧
    (∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x + y) =
        x ^ 2 + x * traceLM F hLK y + normLM F hLK y) ∧
    ∃ (x_0 : L) (z_0 : Lˣ),
      (x_0 = 0 ∨ ((condExp F L χ' / 2 : ℕ) : ℤ) ≤ valL F L x_0) ∧
      (z_0 : L) = 1 + x_0 ∧
      (∀ w : L, (w = 0 ∨ ((condExp F L χ' / 2 : ℕ) : ℤ) ≤ valL F L w) →
        ψ (((c_χ'⁻¹ : Lˣ) : L) * w ^ 2) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0 * w)) ∧
      (∀ (P_sq : Ω F),
        (tateEps F L χ' ψ) ^ 2 =
          P_sq *
            ((χ' c_χ' : Ω F) ^ 2 *
              (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
              (χ' z_0 : Ω F)⁻¹ *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0)) →
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEps F L (ν₁ ^ j * χ') ψ) =
          P_sq *
            (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
              (ν₁ c_ν₁ : Ω F) *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
              ψ (((c_ν₁⁻¹ : Lˣ) : L)))) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, _, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  let p := Module.finrank L (IntermediateField.extendScalars hLK)
  let b := condExp F L ν₁
  let a := condExp F L χ'
  let n := condExpChar F L ψ
  let d_b := b / 2
  let r0_b := (b + 1) / 2
  let d_a := a / 2
  let m_0 := (2 * b - a) / 2
  have hp_pos : 0 < p := by omega
  let P_L (k : ℤ) (x : L) : Prop := x = 0 ∨ k ≤ valL F L x
  let P_K (k : ℤ) (y : K) : Prop := y = 0 ∨ k ≤ valL F K y
  have hPL_mono : ∀ {k₁ k₂ : ℤ} {x : L}, k₁ ≤ k₂ → P_L k₂ x → P_L k₁ x := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hPL_neg : ∀ {k : ℤ} {x : L}, P_L k x → P_L k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · right; rw [hval_neg_L]; exact hx
  have hPL_add : ∀ {k : ℤ} {x₁ x₂ : L}, P_L k x₁ → P_L k x₂ → P_L k (x₁ + x₂) :=
    fun hx₁ hx₂ => hval_add_L _ _ _ hx₁ hx₂
  have hPL_sub : ∀ {k : ℤ} {x₁ x₂ : L}, P_L k x₁ → P_L k x₂ → P_L k (x₁ - x₂) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    exact hPL_add hx₁ (hPL_neg hx₂)
  have hPL_mul : ∀ {k₁ k₂ : ℤ} {x₁ x₂ : L}, P_L k₁ x₁ → P_L k₂ x₂ → P_L (k₁ + k₂) (x₁ * x₂) := by
    intro k₁ k₂ x₁ x₂ hx₁ hx₂
    by_cases hx10 : x₁ = 0
    · exact Or.inl (by rw [hx10, zero_mul])
    · by_cases hx20 : x₂ = 0
      · exact Or.inl (by rw [hx20, mul_zero])
      · right
        have h1 := hx₁.resolve_left hx10
        have h2 := hx₂.resolve_left hx20
        rw [hval_mul_L x₁ x₂ hx10 hx20]
        omega
  have hPK_mono : ∀ {k₁ k₂ : ℤ} {y : K}, k₁ ≤ k₂ → P_K k₂ y → P_K k₁ y := by
    intro k₁ k₂ y hk hy
    rcases hy with rfl | hy
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hy)
  have hPK_mul : ∀ {k₁ k₂ : ℤ} {y₁ y₂ : K}, P_K k₁ y₁ → P_K k₂ y₂ → P_K (k₁ + k₂) (y₁ * y₂) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases hy10 : y₁ = 0
    · exact Or.inl (by rw [hy10, zero_mul])
    · by_cases hy20 : y₂ = 0
      · exact Or.inl (by rw [hy20, mul_zero])
      · right
        have h1 := hy₁.resolve_left hy10
        have h2 := hy₂.resolve_left hy20
        rw [hval_mul_K y₁ y₂ hy10 hy20]
        omega
  have hP_incl : ∀ {k : ℤ} {x : L}, P_L k x → P_K (2 * k) (IntermediateField.inclusion hLK x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl (map_zero (IntermediateField.inclusion hLK))
    · right
      rw [hval_alg x, hp2]
      push_cast
      omega
  have h1_add_ne_L : ∀ {x : L}, P_L 1 x → 1 + x ≠ 0 := by
    intro x hx h0
    have hx_eq : x = -1 := by linear_combination h0
    rw [hx_eq] at hx
    rcases hx with hneg1 | hle
    · exact one_ne_zero (by linear_combination -hneg1)
    · rw [hval_neg1_L] at hle; omega
  have h1_add_val_L : ∀ {x : L}, P_L 1 x → valL F L (1 + x) = 0 := by
    intro x hx
    have hne : 1 + x ≠ 0 := h1_add_ne_L hx
    have hP0 : P_L 0 (1 + x) :=
      hPL_add (Or.inr (le_of_eq hval1_L.symm)) (hPL_mono (by omega) hx)
    have hge0 : 0 ≤ valL F L (1 + x) := hP0.resolve_left hne
    by_contra hval_ne
    have hge1 : 1 ≤ valL F L (1 + x) := by omega
    have h1_P1 : P_L 1 (1 : L) := by
      have h_eq : (1 : L) = (1 + x) - x := by ring
      rw [h_eq]
      exact hPL_sub (Or.inr hge1) hx
    rcases h1_P1 with h10 | h1le
    · exact one_ne_zero h10
    · rw [hval1_L] at h1le; omega
  have hψ_congr : ∀ {x₁ x₂ : L}, P_L (-n) (x₁ - x₂) → ψ x₁ = ψ x₂ := by
    intro x₁ x₂ hdiff
    have h1 : ψ (x₁ - x₂) = 1 := (hSpecL 1).1 (x₁ - x₂) hdiff
    calc ψ x₁ = ψ ((x₁ - x₂) + x₂) := by rw [sub_add_cancel]
      _ = ψ (x₁ - x₂) * ψ x₂ := ψ.map_add_eq_mul _ _
      _ = ψ x₂ := by rw [h1, one_mul]
  have hc_ν₁_inv_coe : ((c_ν₁⁻¹ : Lˣ) : L) = ((c_χ'⁻¹ : Lˣ) : L) * (δ : L) := by
    have h : c_ν₁⁻¹ = c_χ'⁻¹ * δ := by rw [hδ_eq, inv_mul_cancel_left]
    exact congrArg Units.val h
  have h2_Pd : P_L (d_b : ℤ) (2 : L) := by
    have hp_val' := hp_val
    rw [hp2] at hp_val'
    simpa [d_b, b] using hp_val'
  have h1_P0 : P_L 0 (1 : L) := Or.inr (le_of_eq hval1_L.symm)
  have h2_P1 : P_L 1 (2 : L) := hPL_mono (by omega) h2_Pd
  have h2_P0 : P_L 0 (2 : L) := hPL_mono (by omega) h2_P1
  have hresL_2 : resL (2 : L) = (2 : k_L) := by
    have h2_eq : (2 : L) = 1 + 1 := by ring
    rw [h2_eq, (hresL_ring 1 1 h1_P0 h1_P0).1, hresL_1]
    ring
  have hchar2 : (2 : k_L) = 0 := by
    rw [← hresL_2]
    exact (hresL_ker (2 : L) h2_P0).mpr h2_P1
  have htoExt_incl : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) =
        algebraMap L (IntermediateField.extendScalars hLK) x :=
    fun _ => Subtype.ext rfl
  have htoExt_smul : ∀ (x : L) (y : K),
      toExtendScalars F hLK (IntermediateField.inclusion hLK x * y) =
        x • toExtendScalars F hLK y := by
    intro x y
    rw [map_mul, htoExt_incl x, Algebra.smul_def]
  have htr_incl : ∀ x : L, traceLM F hLK (IntermediateField.inclusion hLK x) = (2 : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change (Algebra.trace L (IntermediateField.extendScalars hLK))
      (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = (2 : L) * x
    rw [htoExt_incl x, Algebra.trace_algebraMap, hp2, nsmul_eq_mul, Nat.cast_two]
  have htr_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    letI : Module L L := Semiring.toModule
    intro x y
    change (Algebra.trace L (IntermediateField.extendScalars hLK))
      (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * (Algebra.trace L (IntermediateField.extendScalars hLK)) (toExtendScalars F hLK y)
    rw [htoExt_smul x y, LinearMap.map_smul, smul_eq_mul]
  have hnorm_incl : ∀ x : L, normLM F hLK (IntermediateField.inclusion hLK x) = x ^ 2 := by
    intro x
    change (Algebra.norm L) (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = x ^ 2
    rw [htoExt_incl x, Algebra.norm_algebraMap, hp2]
  have hnorm_0 : normLM F hLK 0 = 0 := by
    have h0 := hnorm_incl 0
    rw [map_zero] at h0
    simpa using h0
  haveI : Module.Finite L (IntermediateField.extendScalars hLK) :=
    Module.finite_of_finrank_pos hp_pos
  letI : Module L L := Semiring.toModule
  let b₀ : Module.Basis (Fin 2) L (IntermediateField.extendScalars hLK) :=
    (Module.finBasis L (IntermediateField.extendScalars hLK)).reindex (finCongr hp2)
  have halg_mat : ∀ x : L,
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 0 0 = x ∧
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 1 1 = x ∧
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 0 1 = 0 ∧
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 1 0 = 0 := by
    intro x
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [Matrix.algebraMap_matrix_apply, if_pos rfl]; rfl
    · rw [Matrix.algebraMap_matrix_apply, if_pos rfl]; rfl
    · rw [Matrix.algebraMap_matrix_apply, if_neg (by decide : (0 : Fin 2) ≠ 1)]
    · rw [Matrix.algebraMap_matrix_apply, if_neg (by decide : (1 : Fin 2) ≠ 0)]
  have hnorm_sub : ∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x - y) =
        x ^ 2 - x * traceLM F hLK y + normLM F hLK y := by
    intro x y
    let M : Matrix (Fin 2) (Fin 2) L := Algebra.leftMulMatrix b₀ (toExtendScalars F hLK y)
    have htr_y : traceLM F hLK y = M 0 0 + M 1 1 := by
      change (Algebra.trace L (IntermediateField.extendScalars hLK)) (toExtendScalars F hLK y) = _
      rw [Algebra.trace_eq_matrix_trace b₀, Matrix.trace_fin_two]
    have hnorm_y : normLM F hLK y = M 0 0 * M 1 1 - M 0 1 * M 1 0 := by
      change (Algebra.norm L) (toExtendScalars F hLK y) = _
      rw [Algebra.norm_eq_matrix_det b₀, Matrix.det_fin_two]
    change (Algebra.norm L)
      (toExtendScalars F hLK (IntermediateField.inclusion hLK x - y)) = _
    rw [Algebra.norm_eq_matrix_det b₀, map_sub, htoExt_incl x, map_sub, AlgHom.commutes]
    change (algebraMap L (Matrix (Fin 2) (Fin 2) L) x - M).det = _
    rw [Matrix.det_fin_two]
    simp only [Matrix.sub_apply, (halg_mat x).1, (halg_mat x).2.1,
      (halg_mat x).2.2.1, (halg_mat x).2.2.2, htr_y, hnorm_y]
    ring
  have hnorm_add : ∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x + y) =
        x ^ 2 + x * traceLM F hLK y + normLM F hLK y := by
    intro x y
    have h1 := hnorm_sub x (-y)
    rw [sub_neg_eq_add, map_neg, mul_neg, sub_neg_eq_add] at h1
    have hneg1 : (-y : K) = IntermediateField.inclusion hLK (-1) * y := by
      rw [map_neg, map_one, neg_one_mul]
    have hnorm_neg_y : normLM F hLK (-y) = normLM F hLK y := by
      rw [hneg1, map_mul, hnorm_incl (-1)]
      ring
    rw [hnorm_neg_y] at h1
    exact h1
  have hδ_Pv : P_L ((a - b : ℕ) : ℤ) (δ : L) := Or.inr (le_of_eq hδ_val.symm)
  have hδ_P1 : P_L 1 (δ : L) := hPL_mono (by omega) hδ_Pv
  have hu_δ_ne : 1 + (δ : L) ≠ 0 := h1_add_ne_L hδ_P1
  let u_δ : Lˣ := Units.mk0 (1 + (δ : L)) hu_δ_ne
  have hu_δ_coe : (u_δ : L) = 1 + (δ : L) := rfl
  have hu_δ_val : valL F L (u_δ : L) = 0 := h1_add_val_L hδ_P1
  have hu_δ_inv_val : valL F L ((u_δ⁻¹ : Lˣ) : L) = 0 := by
    rw [hval_inv_L u_δ, hu_δ_val, neg_zero]
  have hu_δ_inv_P0 : P_L 0 ((u_δ⁻¹ : Lˣ) : L) := Or.inr (le_of_eq hu_δ_inv_val.symm)
  have hu_δ_mul_inv : (1 + (δ : L)) * ((u_δ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_δ
  let s_inv : L := traceLM F hLK ((u_K⁻¹ : Kˣ) : K)
  have hu_K_inv_val : valL F K ((u_K⁻¹ : Kˣ) : K) = -((a - b : ℕ) : ℤ) := by
    rw [hval_inv_K u_K, hu_K_val]
  have hs_inv_Pm0 : P_L (m_0 : ℤ) s_inv := by
    apply htr_bound (m_0 : ℤ) ((u_K⁻¹ : Kˣ) : K)
    right
    rw [hp2, hu_K_inv_val]
    omega
  let x_0 : L := -((δ : L) * s_inv * ((u_δ⁻¹ : Lˣ) : L))
  have hx0_val : P_L ((d_a : ℕ) : ℤ) x_0 := by
    have h1 := hPL_mul (hPL_mul hδ_Pv hs_inv_Pm0) hu_δ_inv_P0
    exact hPL_neg (hPL_mono (by omega) h1)
  have hx0_Pr0b : P_L ((r0_b : ℕ) : ℤ) x_0 := hPL_mono (by omega) hx0_val
  have hx0_P1 : P_L 1 x_0 := hPL_mono (by omega) hx0_Pr0b
  have hz0_ne : 1 + x_0 ≠ 0 := h1_add_ne_L hx0_P1
  have hz1_ne : 1 + (-x_0) ≠ 0 := h1_add_ne_L (hPL_neg hx0_P1)
  let z_0 : Lˣ := Units.mk0 (1 + x_0) hz0_ne
  let z_1 : Lˣ := Units.mk0 (1 + (-x_0)) hz1_ne
  have hz0_coe : (z_0 : L) = 1 + x_0 := rfl
  have hz1_coe : (z_1 : L) = 1 - x_0 := by change 1 + (-x_0) = 1 - x_0; ring
  have h1δ_x0 : (1 + (δ : L)) * x_0 = -((δ : L) * s_inv) := by
    dsimp [x_0]
    linear_combination -((δ : L) * s_inv) * hu_δ_mul_inv
  have hu_K_inv_norm : normLM F hLK ((u_K⁻¹ : Kˣ) : K) = ((δ⁻¹ : Lˣ) : L) := by
    have h : Units.map (normLM F hLK) u_K⁻¹ = δ⁻¹ := by rw [map_inv, hu_K_norm]
    exact congrArg Units.val h
  have hδ_mul_inv : (δ : L) * ((δ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv δ
  have hc_χ'_inv_val : valL F L ((c_χ'⁻¹ : Lˣ) : L) = -((a : ℤ) + n) := by
    rw [hval_inv_L c_χ', hc_χ'_val]
  have hc_χ'_inv_P : P_L (-((a : ℤ) + n)) ((c_χ'⁻¹ : Lˣ) : L) :=
    Or.inr (le_of_eq hc_χ'_inv_val.symm)
  have hw_sq : ∀ w : L, (w = 0 ∨ ((d_a : ℕ) : ℤ) ≤ valL F L w) →
      ψ (((c_χ'⁻¹ : Lˣ) : L) * w ^ 2) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0 * w) := by
    intro w hw
    let z : K := ((u_K⁻¹ : Kˣ) : K) * IntermediateField.inclusion hLK w
    have hu_K_inv_PK : P_K (-((a - b : ℕ) : ℤ)) ((u_K⁻¹ : Kˣ) : K) :=
      Or.inr (le_of_eq hu_K_inv_val.symm)
    have hz_Pr0b : P_K ((r0_b : ℕ) : ℤ) z :=
      hPK_mono (by omega) (hPK_mul hu_K_inv_PK (hP_incl hw))
    have hnt := hnorm_to_tr z hz_Pr0b
    have h_lhs : ((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z = ((c_χ'⁻¹ : Lˣ) : L) * w ^ 2 := by
      dsimp [z]
      rw [map_mul, hu_K_inv_norm, hnorm_incl w, hc_ν₁_inv_coe]
      linear_combination ((c_χ'⁻¹ : Lˣ) : L) * w ^ 2 * hδ_mul_inv
    have h_rhs : -((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z =
        ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 * w := by
      have hz_comm : z = IntermediateField.inclusion hLK w * ((u_K⁻¹ : Kˣ) : K) :=
        mul_comm _ _
      have htr_z : traceLM F hLK z = w * s_inv := by
        rw [hz_comm, htr_smul w ((u_K⁻¹ : Kˣ) : K)]
      rw [htr_z, hc_ν₁_inv_coe]
      linear_combination -(((c_χ'⁻¹ : Lˣ) : L) * w) * h1δ_x0
    rw [h_lhs, h_rhs] at hnt
    rw [hnt]
    apply hψ_congr
    have h_diff : ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 * w -
        ((c_χ'⁻¹ : Lˣ) : L) * x_0 * w =
        ((c_χ'⁻¹ : Lˣ) : L) * (δ : L) * x_0 * w := by ring
    rw [h_diff]
    have hprod := hPL_mul (hPL_mul (hPL_mul hc_χ'_inv_P hδ_Pv) hx0_val) hw
    exact hPL_mono (by omega) hprod
  have hu_corr_norm_coe : normLM F hLK (u_corr : K) = ((u_δ * z_0 : Lˣ) : L) := by
    have h1 := hnorm_sub 1 (IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    rw [map_one (IntermediateField.inclusion hLK), htr_smul (δ : L) ((u_K⁻¹ : Kˣ) : K),
      map_mul (normLM F hLK), hnorm_incl (δ : L), hu_K_inv_norm] at h1
    rw [hu_corr_eq, h1]
    change (1 : L) ^ 2 - 1 * ((δ : L) * s_inv) + (δ : L) ^ 2 * ((δ⁻¹ : Lˣ) : L) =
      (1 + (δ : L)) * (1 + x_0)
    linear_combination (δ : L) * hδ_mul_inv - h1δ_x0
  have hu_corr_norm : Units.map (normLM F hLK) u_corr = u_δ * z_0 :=
    Units.ext hu_corr_norm_coe
  have hc_χ'_incl_norm :
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK) c_χ') = c_χ' ^ 2 := by
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (c_χ' : L)) = ((c_χ' ^ 2 : Lˣ) : L)
    rw [hnorm_incl (c_χ' : L), Units.val_pow_eq_pow_val]
  have hc_K_norm : Units.map (normLM F hLK) c_K = c_χ' ^ 2 * u_δ⁻¹ * z_0⁻¹ := by
    rw [hc_K_eq, map_mul, hc_χ'_incl_norm, map_inv, hu_corr_norm, mul_inv_rev]
    ac_rfl
  have hχK_cK : ((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) =
      (χ' c_χ' : Ω F) ^ 2 * (χ' u_δ : Ω F)⁻¹ * (χ' z_0 : Ω F)⁻¹ := by
    change (χ' (Units.map (normLM F hLK) c_K) : Ω F) = _
    rw [hc_K_norm, map_mul, map_mul, map_pow, map_inv, map_inv,
      Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val,
      Units.val_inv_eq_inv_val, Units.val_inv_eq_inv_val]
  let y_1 : K := 1 + IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K)
  have hy1_norm : normLM F hLK y_1 = ((u_δ * z_1 : Lˣ) : L) := by
    have h1 := hnorm_add 1 (IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    rw [map_one (IntermediateField.inclusion hLK), htr_smul (δ : L) ((u_K⁻¹ : Kˣ) : K),
      map_mul (normLM F hLK), hnorm_incl (δ : L), hu_K_inv_norm] at h1
    dsimp [y_1]
    rw [h1]
    change (1 : L) ^ 2 + 1 * ((δ : L) * s_inv) + (δ : L) ^ 2 * ((δ⁻¹ : Lˣ) : L) =
      (1 + (δ : L)) * (1 + (-x_0))
    linear_combination (δ : L) * hδ_mul_inv + h1δ_x0
  have hy1_ne0 : y_1 ≠ 0 := by
    intro h0
    have h := hy1_norm
    rw [h0, hnorm_0] at h
    exact Units.ne_zero (u_δ * z_1) h.symm
  let w_1 : Kˣ := Units.mk0 y_1 hy1_ne0
  have hw1_norm : Units.map (normLM F hLK) w_1 = u_δ * z_1 :=
    Units.ext hy1_norm
  have hν₁_uδ_z1 : ν₁ (u_δ * z_1) = 1 :=
    (hν₁_ker (u_δ * z_1)).mp ⟨w_1, hw1_norm⟩
  have hν₁_uδ_inv : (ν₁ u_δ : Ω F)⁻¹ =
      ψ (-(((c_χ'⁻¹ : Lˣ) : L) * (δ : L) * x_0)) := by
    have huδ_eq : (ν₁ u_δ)⁻¹ = ν₁ z_1 := by
      rw [map_mul] at hν₁_uδ_z1
      exact (eq_inv_of_mul_eq_one_right hν₁_uδ_z1).symm
    have hstat := hc_ν₁_stat (-x_0) (hPL_neg hx0_Pr0b) hz1_ne
    change (ν₁ z_1 : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * (-x_0)) at hstat
    rw [← Units.val_inv_eq_inv_val, huδ_eq, hstat, hc_ν₁_inv_coe]
    congr 1
    ring
  have hc_K_inv_coe : ((c_K⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK ((c_χ'⁻¹ : Lˣ) : L) * (u_corr : K) := by
    have h : c_K⁻¹ = (Units.map (IntermediateField.inclusion hLK) c_χ'⁻¹) * u_corr := by
      rw [hc_K_eq, mul_inv_rev, inv_inv, ← map_inv, mul_comm]
    exact congrArg Units.val h
  have htr_cK_inv : traceLM F hLK ((c_K⁻¹ : Kˣ) : K) =
      (((c_χ'⁻¹ : Lˣ) : L) + ((c_χ'⁻¹ : Lˣ) : L)) +
        ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 := by
    have h1 : traceLM F hLK (u_corr : K) = (2 : L) - (δ : L) * s_inv := by
      have h1_eq : (1 : K) = IntermediateField.inclusion hLK 1 := (map_one _).symm
      rw [hu_corr_eq, map_sub, htr_smul (δ : L) ((u_K⁻¹ : Kˣ) : K)]
      conv_lhs => enter [1]; rw [h1_eq, htr_incl 1, mul_one]
    rw [hc_K_inv_coe, htr_smul ((c_χ'⁻¹ : Lˣ) : L) (u_corr : K), h1]
    linear_combination -((c_χ'⁻¹ : Lˣ) : L) * h1δ_x0
  have hψ_1δ_x0 : ψ (((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0) =
      ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0) * (ν₁ u_δ : Ω F)⁻¹ := by
    have h1 : ψ (((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0) =
        ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0 + (-(((c_χ'⁻¹ : Lˣ) : L) * (δ : L) * x_0))) := by
      apply hψ_congr
      have h_diff : ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 -
          (((c_χ'⁻¹ : Lˣ) : L) * x_0 + (-(((c_χ'⁻¹ : Lˣ) : L) * (δ : L) * x_0))) =
          ((c_χ'⁻¹ : Lˣ) : L) * (2 : L) * (δ : L) * x_0 := by ring
      rw [h_diff]
      have hprod := hPL_mul (hPL_mul (hPL_mul hc_χ'_inv_P h2_Pd) hδ_Pv) hx0_val
      exact hPL_mono (by omega) hprod
    rw [h1, ψ.map_add_eq_mul, ← hν₁_uδ_inv]
  have htrChar_cK : (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) =
      (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
        ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0) *
        (ν₁ u_δ : Ω F)⁻¹ := by
    change ψ (traceLM F hLK ((c_K⁻¹ : Kˣ) : K)) = _
    rw [htr_cK_inv, ψ.map_add_eq_mul, ψ.map_add_eq_mul, hψ_1δ_x0]
    ring
  have hν₁_0 : ν₁ ^ 0 = 1 := MonoidHom.ext fun _ => by simp
  have hν₁_1 : ν₁ ^ 1 = ν₁ := MonoidHom.ext fun _ => by simp
  have h1_χ' : 1 * χ' = χ' := MonoidHom.ext fun _ => by simp
  obtain ⟨u_τ, hu_τ_coe, hEps_twist1⟩ :=
    hrhs_twist 1 (by omega) 1 h1_P0 (Or.inl (by simp))
  have hu_τ_eq : u_τ = u_δ := by
    apply Units.ext
    rw [hu_τ_coe, one_mul]
    rfl
  have hEps_twist1' : tateEps F L (ν₁ * χ') ψ =
      (ν₁ u_δ : Ω F)⁻¹ * (χ' u_δ : Ω F)⁻¹ *
        ψ (((c_ν₁⁻¹ : Lˣ) : L)) * tateEps F L χ' ψ := by
    rw [hν₁_1, hu_τ_eq] at hEps_twist1
    have hmul : (((ν₁ * χ') u_δ : Ω F)⁻¹) = (ν₁ u_δ : Ω F)⁻¹ * (χ' u_δ : Ω F)⁻¹ := by
      rw [MonoidHom.mul_apply, Units.val_mul, mul_inv]
    have hψ_δ : ψ (((c_χ'⁻¹ : Lˣ) : L) * 1 * (δ : L)) = ψ (((c_ν₁⁻¹ : Lˣ) : L)) := by
      rw [mul_one, ← hc_ν₁_inv_coe]
    rw [hEps_twist1, hmul, hψ_δ]
  have hν₁_cν₁_coe : (ν₁ c_ν₁ : Ω F) = 1 := by
    rw [hc_ν₁_ν₁, Units.val_one]
  have hRHS_prod : ∀ (P_sq : Ω F),
      (tateEps F L χ' ψ) ^ 2 =
        P_sq *
          ((χ' c_χ' : Ω F) ^ 2 *
            (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
            (χ' z_0 : Ω F)⁻¹ *
            ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0)) →
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) =
        P_sq *
          (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
            (ν₁ c_ν₁ : Ω F) *
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
            ψ (((c_ν₁⁻¹ : Lˣ) : L))) := by
    intro P_sq hEps_sq
    rw [hp2, Finset.prod_range_succ, Finset.prod_range_one, hν₁_0, h1_χ', hν₁_1,
      hEps_twist1', hχK_cK, hν₁_cν₁_coe, htrChar_cK]
    calc tateEps F L χ' ψ *
          ((ν₁ u_δ : Ω F)⁻¹ * (χ' u_δ : Ω F)⁻¹ *
            ψ (((c_ν₁⁻¹ : Lˣ) : L)) * tateEps F L χ' ψ)
        = (tateEps F L χ' ψ) ^ 2 *
            ((ν₁ u_δ : Ω F)⁻¹ * (χ' u_δ : Ω F)⁻¹ * ψ (((c_ν₁⁻¹ : Lˣ) : L))) := by ring
      _ = (P_sq *
            ((χ' c_χ' : Ω F) ^ 2 *
              (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
              (χ' z_0 : Ω F)⁻¹ *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0))) *
            ((ν₁ u_δ : Ω F)⁻¹ * (χ' u_δ : Ω F)⁻¹ * ψ (((c_ν₁⁻¹ : Lˣ) : L))) := by rw [hEps_sq]
      _ = P_sq *
            (((χ' c_χ' : Ω F) ^ 2 * (χ' u_δ : Ω F)⁻¹ * (χ' z_0 : Ω F)⁻¹) *
              1 *
              ((ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
                ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0) *
                (ν₁ u_δ : Ω F)⁻¹) *
              ψ (((c_ν₁⁻¹ : Lˣ) : L))) := by ring
  exact ⟨hchar2, htr_incl, htr_smul, hnorm_incl, hnorm_add,
    x_0, z_0, hx0_val, hz0_coe, hw_sq, hRHS_prod⟩

theorem ld_wild_mid_cond_dyadic_L_chi_sq_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χ' : Lˣ →* (Ω F)ˣ)
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
