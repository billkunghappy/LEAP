        ring
      have hTξ : T_lin * ξ_base m = 0 ∨ V_lin ≤ vM₁' (T_lin * ξ_base m) := by
        have hm1 := hvalM₁'_mul_ge V_lin 0 T_lin (ξ_base m)
          hT_lin_val (Or.inr (le_of_eq (hξ_base_val0 m hm_lt hm_pos).2.symm))
        rwa [add_zero] at hm1
      have hp1 :
          (B_fn m - b) * (T_lin * ξ_base m) = 0 ∨
            V_lin ≤ vM₁' ((B_fn m - b) * (T_lin * ξ_base m)) := by
        have hm1 := hvalM₁'_mul_ge 0 V_lin (B_fn m - b) (T_lin * ξ_base m) hB_props.1 hTξ
        rwa [zero_add] at hm1
      have hp2 :
          B_fn m * (ν_fn m - T_lin * ξ_base m) = 0 ∨
            V_lin ≤ vM₁' (B_fn m * (ν_fn m - T_lin * ξ_base m)) := by
        have hm1 := hvalM₁'_mul_ge (-(t₁ : ℤ)) V₁ (B_fn m) (ν_fn m - T_lin * ξ_base m)
          (Or.inr (le_of_eq hB_props.2.2.symm)) (hν_approx m hm_lt hm_pos)
        refine hvalM₁'_mono V_lin _ _ ?_ hm1
        linarith only [hV₁_eq]
      have hlin :
          (N_fn m - B_fn m) - b * T_lin * ξ_base m = 0 ∨
            V_lin ≤ vM₁' ((N_fn m - B_fn m) - b * T_lin * ξ_base m) := by
        rw [hdecomp]
        exact hvalM₁'_add V_lin _ _ hp1 hp2
      have hNB_val : N_fn m - B_fn m = 0 ∨ V_lin - (t₁ : ℤ) ≤ vM₁' (N_fn m - B_fn m) := by
        rw [hNB_eq]
        have hm1 := hvalM₁'_mul_ge (-(t₁ : ℤ)) V_lin (B_fn m) (ν_fn m)
          (Or.inr (le_of_eq hB_props.2.2.symm)) (hν_val m hm_lt hm_pos)
        refine hvalM₁'_mono (V_lin - (t₁ : ℤ)) _ _ (by linarith only) hm1
      have hVlin_sub_t1_nonneg : (0 : ℤ) ≤ V_lin - (t₁ : ℤ) := by
        have hdiff :
            V_lin - (t₁ : ℤ) =
              2 * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
                ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) := by
          rw [hV_lin_def, hp_sub1_z, hp_sub2_z]
          ring
        have hnn :
            0 ≤ 2 * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
              ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) := by
          positivity
        linarith only [hdiff, hnn]
      have hN_sub_b : N_fn m - b = 0 ∨ (0 : ℤ) ≤ vM₁' (N_fn m - b) := by
        have heq : N_fn m - b = (N_fn m - B_fn m) + (B_fn m - b) := by ring
        rw [heq]
        exact hvalM₁'_add 0 _ _
          (hvalM₁'_mono 0 (V_lin - (t₁ : ℤ)) _ hVlin_sub_t1_nonneg hNB_val)
          hB_props.1
      have hN_val : N_fn m = 0 ∨ -(t₁ : ℤ) ≤ vM₁' (N_fn m) := by
        have heq : N_fn m = b + (N_fn m - b) := by ring
        rw [heq]
        exact hvalM₁'_add (-(t₁ : ℤ)) b (N_fn m - b)
          (Or.inr (le_of_eq hb_val.symm))
          (hvalM₁'_mono (-(t₁ : ℤ)) 0 (N_fn m - b) (by omega) hN_sub_b)
      exact ⟨hlin, hNB_val, hN_sub_b, hN_val⟩

    
    have hpow_sub_b_pow : ∀ (x : R_M) (n : ℕ),
        (x = 0 ∨ -(t₁ : ℤ) ≤ vM₁' x) →
        (x - b = 0 ∨ (0 : ℤ) ≤ vM₁' (x - b)) →
        x ^ n - b ^ n = 0 ∨ -((n - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ vM₁' (x ^ n - b ^ n) := by
      intro x n hx hxb
      rw [← geom_sum₂_mul x b n]
      have hsum :
          (∑ i ∈ Finset.range n, x ^ i * b ^ (n - 1 - i)) = 0 ∨
            -((n - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
              vM₁' (∑ i ∈ Finset.range n, x ^ i * b ^ (n - 1 - i)) := by
        apply hvalM₁'_sum_ge (Finset.range n) _ (-((n - 1 : ℕ) : ℤ) * (t₁ : ℤ))
        intro i hi
        have hi_lt : i < n := Finset.mem_range.mp hi
        have hxi := hvalM₁'_pow_ge x i (-(t₁ : ℤ)) hx
        have hbi := hvalM₁'_pow_ge b (n - 1 - i) (-(t₁ : ℤ)) (Or.inr (le_of_eq hb_val.symm))
        have hm1 := hvalM₁'_mul_ge ((i : ℤ) * (-(t₁ : ℤ))) (((n - 1 - i : ℕ) : ℤ) * (-(t₁ : ℤ)))
          (x ^ i) (b ^ (n - 1 - i)) hxi hbi
        refine hvalM₁'_mono (-((n - 1 : ℕ) : ℤ) * (t₁ : ℤ)) _ _ ?_ hm1
        have hadd_eq : (i : ℤ) + ((n - 1 - i : ℕ) : ℤ) = ((n - 1 : ℕ) : ℤ) := by omega
        have hid : (i : ℤ) * -(t₁ : ℤ) + ((n - 1 - i : ℕ) : ℤ) * -(t₁ : ℤ) =
            -((n - 1 : ℕ) : ℤ) * (t₁ : ℤ) := by
          rw [← add_mul, hadd_eq]
          ring
        linarith only [hid]
      have hm2 := hvalM₁'_mul_ge (-((n - 1 : ℕ) : ℤ) * (t₁ : ℤ)) 0
        (∑ i ∈ Finset.range n, x ^ i * b ^ (n - 1 - i)) (x - b) hsum hxb
      rwa [add_zero] at hm2

    
    intro k hk P_k
    have hPk_def :
        P_k = b ^ k + ∑ m ∈ (Finset.range p).erase 0, (B_fn m) ^ k := rfl
    obtain ⟨hk2, hk_p1⟩ := Finset.mem_Icc.mp hk
    let B_goal : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 3 + k : ℕ) : ℤ) * (t₁ : ℤ)
    have hB_goal_def : B_goal =
        2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 3 + k : ℕ) : ℤ) * (t₁ : ℤ) := rfl
    clear_value B_goal
    have hB_goal_eq : B_goal = V₁ - (k : ℤ) * (t₁ : ℤ) := by
      have hp3k : ((p - 3 + k : ℕ) : ℤ) = ((p - 3 : ℕ) : ℤ) + (k : ℤ) := by omega
      rw [hB_goal_def, hV₁_def, hp3k]
      ring

    have hpow_k_m : ∀ m ∈ (Finset.range p).erase 0,
        ((N_fn m) ^ k - (B_fn m) ^ k) - ((k : ℕ) : R_M) * b ^ k * T_lin * ξ_base m = 0 ∨
          B_goal ≤ vM₁' (((N_fn m) ^ k - (B_fn m) ^ k) -
            ((k : ℕ) : R_M) * b ^ k * T_lin * ξ_base m) := by
      intro m hm_mem
      have hm_ne0 : m ≠ 0 := (Finset.mem_erase.mp hm_mem).1
      have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm_mem).2
      have hm_pos : 0 < m := Nat.pos_of_ne_zero hm_ne0
      have hB_props := hB_sub_b m hm_lt hm_pos
      have hN_props := hNB_lin m hm_lt hm_pos
      have hsum_const_b :
          (∑ j ∈ Finset.range k, b ^ (k - 1)) = ((k : ℕ) : R_M) * b ^ (k - 1) := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      have hpow_b : b ^ (k - 1) * b = b ^ k := by
        rw [← pow_succ, show k - 1 + 1 = k by omega]
      have h_id_k :
          ((N_fn m) ^ k - (B_fn m) ^ k) - ((k : ℕ) : R_M) * b ^ k * T_lin * ξ_base m =
            ((k : ℕ) : R_M) * b ^ (k - 1) * ((N_fn m - B_fn m) - b * T_lin * ξ_base m) +
              (N_fn m - B_fn m) *
                (∑ j ∈ Finset.range k,
                  ((N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1))) := by
        rw [← geom_sum₂_mul (N_fn m) (B_fn m) k]
        have hsub_sum :
            (∑ j ∈ Finset.range k,
              ((N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1))) =
            (∑ j ∈ Finset.range k, (N_fn m) ^ j * (B_fn m) ^ (k - 1 - j)) -
              ((k : ℕ) : R_M) * b ^ (k - 1) := by
          rw [Finset.sum_sub_distrib, hsum_const_b]
        rw [hsub_sum]
        linear_combination ((k : ℕ) : R_M) * T_lin * ξ_base m * hpow_b
      rw [h_id_k]
      
      have hpiece1 :
          ((k : ℕ) : R_M) * b ^ (k - 1) * ((N_fn m - B_fn m) - b * T_lin * ξ_base m) = 0 ∨
            B_goal ≤ vM₁'
              (((k : ℕ) : R_M) * b ^ (k - 1) * ((N_fn m - B_fn m) - b * T_lin * ξ_base m)) := by
        have hbk1 := hvalM₁'_pow_ge b (k - 1) (-(t₁ : ℤ)) (Or.inr (le_of_eq hb_val.symm))
        have hm1 := hvalM₁'_mul_ge 0 (((k - 1 : ℕ) : ℤ) * (-(t₁ : ℤ)))
          ((k : ℕ) : R_M) (b ^ (k - 1)) (hvalM₁'_natCast k) hbk1
        have hm2 := hvalM₁'_mul_ge (0 + ((k - 1 : ℕ) : ℤ) * (-(t₁ : ℤ))) V_lin
          (((k : ℕ) : R_M) * b ^ (k - 1)) ((N_fn m - B_fn m) - b * T_lin * ξ_base m)
          hm1 hN_props.1
        refine hvalM₁'_mono B_goal _ _ ?_ hm2
        have hk1_z : ((k - 1 : ℕ) : ℤ) = (k : ℤ) - 1 := by omega
        have hid : (0 + ((k - 1 : ℕ) : ℤ) * -(t₁ : ℤ)) + V_lin = B_goal := by
          rw [hB_goal_eq, hV₁_eq, hk1_z]
          ring
        linarith only [hid]
      
      have hsum_j :
          (∑ j ∈ Finset.range k, ((N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1))) = 0 ∨
            -((k - 2 : ℕ) : ℤ) * (t₁ : ℤ) ≤
              vM₁' (∑ j ∈ Finset.range k,
                ((N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1))) := by
        apply hvalM₁'_sum_ge (Finset.range k) _ (-((k - 2 : ℕ) : ℤ) * (t₁ : ℤ))
        intro j hj
        have hj_lt : j < k := Finset.mem_range.mp hj
        have hj_split :
            (N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1) =
              ((N_fn m) ^ j - b ^ j) * (B_fn m) ^ (k - 1 - j) +
                b ^ j * ((B_fn m) ^ (k - 1 - j) - b ^ (k - 1 - j)) := by
          have hb_split : b ^ (k - 1) = b ^ j * b ^ (k - 1 - j) := by
            rw [← pow_add, show j + (k - 1 - j) = k - 1 by omega]
          rw [hb_split]
          ring
        rw [hj_split]
        have htermA :
            ((N_fn m) ^ j - b ^ j) * (B_fn m) ^ (k - 1 - j) = 0 ∨
              -((k - 2 : ℕ) : ℤ) * (t₁ : ℤ) ≤
                vM₁' (((N_fn m) ^ j - b ^ j) * (B_fn m) ^ (k - 1 - j)) := by
          by_cases hj0 : j = 0
          · left; rw [hj0, pow_zero, pow_zero, sub_self, zero_mul]
          · have hNj := hpow_sub_b_pow (N_fn m) j hN_props.2.2.2 hN_props.2.2.1
            have hBj := hvalM₁'_pow_ge (B_fn m) (k - 1 - j) (-(t₁ : ℤ))
              (Or.inr (le_of_eq hB_props.2.2.symm))
            have hm1 := hvalM₁'_mul_ge
              (-((j - 1 : ℕ) : ℤ) * (t₁ : ℤ)) (((k - 1 - j : ℕ) : ℤ) * (-(t₁ : ℤ)))
              ((N_fn m) ^ j - b ^ j) ((B_fn m) ^ (k - 1 - j)) hNj hBj
            refine hvalM₁'_mono (-((k - 2 : ℕ) : ℤ) * (t₁ : ℤ)) _ _ ?_ hm1
            have hexp : ((j - 1 : ℕ) : ℤ) + ((k - 1 - j : ℕ) : ℤ) = ((k - 2 : ℕ) : ℤ) := by omega
            have hid : -((j - 1 : ℕ) : ℤ) * (t₁ : ℤ) + ((k - 1 - j : ℕ) : ℤ) * -(t₁ : ℤ) =
                -((k - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by
              rw [← hexp]
              ring
            linarith only [hid]
        have htermB :
            b ^ j * ((B_fn m) ^ (k - 1 - j) - b ^ (k - 1 - j)) = 0 ∨
              -((k - 2 : ℕ) : ℤ) * (t₁ : ℤ) ≤
                vM₁' (b ^ j * ((B_fn m) ^ (k - 1 - j) - b ^ (k - 1 - j))) := by
          by_cases hjk : k - 1 - j = 0
          · left; rw [hjk, pow_zero, pow_zero, sub_self, mul_zero]
          · have hbj := hvalM₁'_pow_ge b j (-(t₁ : ℤ)) (Or.inr (le_of_eq hb_val.symm))
            have hBj := hpow_sub_b_pow (B_fn m) (k - 1 - j)
              (Or.inr (le_of_eq hB_props.2.2.symm)) hB_props.1
            have hm1 := hvalM₁'_mul_ge
              ((j : ℤ) * (-(t₁ : ℤ))) (-((k - 1 - j - 1 : ℕ) : ℤ) * (t₁ : ℤ))
              (b ^ j) ((B_fn m) ^ (k - 1 - j) - b ^ (k - 1 - j)) hbj hBj
            refine hvalM₁'_mono (-((k - 2 : ℕ) : ℤ) * (t₁ : ℤ)) _ _ ?_ hm1
            have hexp : (j : ℤ) + ((k - 1 - j - 1 : ℕ) : ℤ) = ((k - 2 : ℕ) : ℤ) := by omega
            have hid : (j : ℤ) * -(t₁ : ℤ) + -((k - 1 - j - 1 : ℕ) : ℤ) * (t₁ : ℤ) =
                -((k - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by
              rw [← hexp]
              ring
            linarith only [hid]
        exact hvalM₁'_add (-((k - 2 : ℕ) : ℤ) * (t₁ : ℤ)) _ _ htermA htermB
      have hpiece2 :
          (N_fn m - B_fn m) *
            (∑ j ∈ Finset.range k, ((N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1))) = 0 ∨
            B_goal ≤ vM₁'
              ((N_fn m - B_fn m) *
                (∑ j ∈ Finset.range k, ((N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1)))) := by
        have hm1 := hvalM₁'_mul_ge (V_lin - (t₁ : ℤ)) (-((k - 2 : ℕ) : ℤ) * (t₁ : ℤ))
          (N_fn m - B_fn m)
          (∑ j ∈ Finset.range k, ((N_fn m) ^ j * (B_fn m) ^ (k - 1 - j) - b ^ (k - 1)))
          hN_props.2.1 hsum_j
        refine hvalM₁'_mono B_goal _ _ ?_ hm1
        have hk2_z : ((k - 2 : ℕ) : ℤ) = (k : ℤ) - 2 := by omega
        have hid : (V_lin - (t₁ : ℤ)) + -((k - 2 : ℕ) : ℤ) * (t₁ : ℤ) = B_goal := by
          rw [hB_goal_eq, hV₁_eq, hk2_z]
          ring
        linarith only [hid]
      exact hvalM₁'_add B_goal _ _ hpiece1 hpiece2

    
    let S_p : Finset ℕ := (Finset.range p).erase 0
    have hsum_m := hvalM₁'_sum_ge S_p
      (fun m => ((N_fn m) ^ k - (B_fn m) ^ k) - ((k : ℕ) : R_M) * b ^ k * T_lin * ξ_base m)
      B_goal hpow_k_m
    have hτ1 :
        (∑ m ∈ S_p, ξ_base m) = 0 ∨
          ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤ vM₁' (∑ m ∈ S_p, ξ_base m) := by
      have h1_mem : 1 ∈ Finset.Icc 1 (2 * (p - 1)) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
      have hndvd : ¬ ((p - 1) ∣ 1) := Nat.not_dvd_of_pos_of_lt zero_lt_one (by omega)
      have h := hτ_pow_sum 1 h1_mem
      dsimp only [ξ_base, S_p] at h ⊢
      rw [← hm₁_def, if_neg hndvd, sub_zero] at h
      have hpow1 : (∑ m ∈ (Finset.range p).erase 0, iLM₁' (τ_val m) ^ 1) =
          ∑ m ∈ (Finset.range p).erase 0, iLM₁' (τ_val m) :=
        Finset.sum_congr rfl fun _ _ => pow_one _
      rwa [hpow1] at h
    have hlin_sum_val :
        ((k : ℕ) : R_M) * b ^ k * T_lin * (∑ m ∈ S_p, ξ_base m) = 0 ∨
          B_goal ≤ vM₁' (((k : ℕ) : R_M) * b ^ k * T_lin * (∑ m ∈ S_p, ξ_base m)) := by
      have hbk := hvalM₁'_pow_ge b k (-(t₁ : ℤ)) (Or.inr (le_of_eq hb_val.symm))
      have hm1 := hvalM₁'_mul_ge 0 ((k : ℤ) * (-(t₁ : ℤ))) ((k : ℕ) : R_M) (b ^ k)
        (hvalM₁'_natCast k) hbk
      have hm2 := hvalM₁'_mul_ge (0 + (k : ℤ) * (-(t₁ : ℤ))) V_lin
        (((k : ℕ) : R_M) * b ^ k) T_lin hm1 hT_lin_val
      have hm3 := hvalM₁'_mul_ge ((0 + (k : ℤ) * (-(t₁ : ℤ))) + V_lin)
        ((p * (3 * p * m₁ + 1) : ℕ) : ℤ)
        (((k : ℕ) : R_M) * b ^ k * T_lin) (∑ m ∈ S_p, ξ_base m) hm2 hτ1
      refine hvalM₁'_mono B_goal _ _ ?_ hm3
      have hpm1_ge_t1 : (t₁ : ℤ) ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
        have h1 : t₁ ≤ m₁ := by
          rw [ht₁_def, hm₁_def]
          omega
        have h2 : m₁ ≤ p * (3 * p * m₁ + 1) := by
          calc m₁ = 1 * m₁ := (one_mul m₁).symm
            _ ≤ p * m₁ := Nat.mul_le_mul_right m₁ (by omega : 1 ≤ p)
            _ ≤ p * (3 * p * m₁ + 1) := Nat.mul_le_mul_left p (by
              calc m₁ = 1 * m₁ := (one_mul m₁).symm
                _ ≤ (3 * p) * m₁ := Nat.mul_le_mul_right m₁ (by omega : 1 ≤ 3 * p)
                _ ≤ 3 * p * m₁ + 1 := Nat.le_succ _)
        exact_mod_cast le_trans h1 h2
      linarith only [hB_goal_eq, hV₁_eq, hpm1_ge_t1]
    have htarget_eq :
        iLM₁' (trLM₁' (b ^ k)) - P_k =
          (∑ m ∈ S_p, (((N_fn m) ^ k - (B_fn m) ^ k) -
            ((k : ℕ) : R_M) * b ^ k * T_lin * ξ_base m)) +
            ((k : ℕ) : R_M) * b ^ k * T_lin * (∑ m ∈ S_p, ξ_base m) := by
      have htr_k := hΔ_conj_tr k
      dsimp only [N_fn, S_p] at htr_k ⊢
      rw [← hb_def] at htr_k
      rw [htr_k, hPk_def, Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
      ring
    rw [htarget_eq, ← hB_goal_def]
    exact hvalM₁'_add B_goal _ _ hsum_m hlin_sum_val
  have htr_smul_M₁'K₁ : ∀ (c : M₁') (w : K₁),
      traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c * w) =
        c * traceLM F hM₁'K₁ w := by
    letI : Module M₁' M₁' := Semiring.toModule
    exact fun c w => (Algebra.trace M₁' (IntermediateField.extendScalars hM₁'K₁)).map_smul' c
      (toExtendScalars F hM₁'K₁ w)
  have hpow_valM₁' : ∀ (x : M₁') (hx : x ≠ 0) (n : ℕ),
      x ^ n ≠ 0 ∧ valL F M₁' (x ^ n) = (n : ℤ) * valL F M₁' x := by
    intro x hx n
    induction n with
    | zero =>
      rw [pow_zero]
      exact ⟨one_ne_zero, by rw [hvalM₁'_props.2.1, Nat.cast_zero, zero_mul]⟩
    | succ n ih =>
      refine ⟨pow_ne_zero (n + 1) hx, ?_⟩
      rw [pow_succ', hvalM₁'_props.2.2.2.2.1 x (x ^ n) hx ih.1, ih.2]
      push_cast; ring
  have hnorm_alg : ∀ c : M₁',
      normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        c ^ (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) := by
    intro c
    have h1 : normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        (Algebra.norm M₁' (S := IntermediateField.extendScalars hM₁'K₁))
          ((algebraMap M₁' (IntermediateField.extendScalars hM₁'K₁)) c) := rfl
    rw [h1, Algebra.norm_algebraMap]
  have hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE') := by
    obtain ⟨π, hπ⟩ := hvalM₁'_props.2.2.2.2.2.2.1 1
    have hval1 : valL F M₁' (normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ (π : M₁'))) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) := by
      rw [hval_norm_M₁'K₁, hval_M₁'K₁, hπ, mul_one]
    have hval2 : valL F M₁' (normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ (π : M₁'))) =
        (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) := by
      rw [hnorm_alg (π : M₁'), (hpow_valM₁' (π : M₁') (Units.ne_zero π) _).2, hπ, mul_one]
    exact Nat.cast_injective (hval2.symm.trans hval1)
  have hnorm_incl_M₁'K₁ : ∀ c : M₁',
      normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        c ^ (Module.finrank L (IntermediateField.extendScalars hLE')) := by
    intro c
    rw [hnorm_alg c, hdegM₁'K₁]
  have hvalK₁_inv : ∀ (x : K₁), x ≠ 0 → valL F K₁ x⁻¹ = - valL F K₁ x := by
    intro x hx
    exact hvalK₁_props.2.2.2.2.2.1 (Units.mk0 x hx)
  exact hAbstract
    (IntermediateField.inclusion hLM₁').toRingHom
    (IntermediateField.inclusion hM₁'K₁).toRingHom
    (IntermediateField.inclusion hM₁'K₁).injective
    (valL F L) (valL F M₁') (valL F K₁)
