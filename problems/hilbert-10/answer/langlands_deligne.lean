        (∑ g ∈ U_v_0 v, tr_term v g) +
        (∑ g ∈ U_v_mid v, tr_term v g) +
        (∑ g ∈ U_v_high v, tr_term v g) := by
    intro v
    have h1 : (∑ g : Fin v → Fin p, tr_term v g) =
        (∑ g ∈ U_v_0 v, tr_term v g) + (∑ g ∈ U_v_nz v, tr_term v g) :=
      (Finset.sum_filter_add_sum_filter_not (U_v v) (P0_v v) (tr_term v)).symm
    have h2 : (∑ g ∈ U_v_nz v, tr_term v g) =
        (∑ g ∈ U_v_mid v, tr_term v g) + (∑ g ∈ U_v_high v, tr_term v g) :=
      (Finset.sum_filter_add_sum_filter_not (U_v_nz v) (Pmid_v v) (tr_term v)).symm
    rw [h1, h2]
    ring
  have hsum_v_0 :
