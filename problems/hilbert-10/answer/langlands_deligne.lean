by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set bE' := condExp F L νE'
  set bM₁' := condExp F L νM₁'
  set t₁ := bM₁' - 1
  set t₂ := bE' - 1
  set h₀ := t₁ / p
  set m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  set m₂ := bE' + bM₁' - 1
  set q₂ := (m₂ + p - 1) / p
  set α := ((c_νE'⁻¹ : Lˣ) : L)
  set ψE' := traceChar F hLE' ψ
  let P_E' : E' → E' := fun x => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
  set a₀ := normLM F hE'K₁ (Δ₀ : K₁)
  set B₂ := - (IntermediateField.inclusion hLE' (c_νE' : L) * ((c₂₀⁻¹ : E'ˣ) : E'))
