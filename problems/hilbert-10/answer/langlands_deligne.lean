      have h := hrec_σ_r r y
      rw [hrec_χE_r r, MonoidHom.mul_apply, MonoidHom.pow_apply, hξE_σ_r r,
        ← MonoidHom.pow_apply, mul_comm] at h
      exact eq_mul_inv_of_mul_eq h
    have h_incl_x : Units.map (IntermediateField.inclusion hLE).toMonoidHom x =
        ∏ r ∈ Finset.range ℓ, Units.map (σ_r r).toRingEquiv.toMonoidHom y := by
      apply Units.ext
      apply Subtype.ext
      have h1 := congrArg E'.val (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLE y.1))
      rw [map_prod] at h1
      have h2 : (∏ σ : G_LE, ((σ (toExtendScalars F hLE y.1) : E') : AlgebraicClosure F)) =
          ∏ r : Fin ℓ, ((τ_r r.1 (toExtendScalars F hLE y.1) : E') : AlgebraicClosure F) :=
        (Fintype.prod_bijective (fun r : Fin ℓ => τ_r r.1) hτ_bij
          (fun r : Fin ℓ => ((τ_r r.1 (toExtendScalars F hLE y.1) : E') : AlgebraicClosure F))
          (fun σ : G_LE => ((σ (toExtendScalars F hLE y.1) : E') : AlgebraicClosure F))
          (fun _ => rfl)).symm
      have h3 : (∏ r : Fin ℓ, ((τ_r r.1 (toExtendScalars F hLE y.1) : E') : AlgebraicClosure F)) =
          ∏ r ∈ Finset.range ℓ, ((σ_r r y.1 : E) : AlgebraicClosure F) :=
        Fin.prod_univ_eq_prod_range (fun r : ℕ => ((σ_r r y.1 : E) : AlgebraicClosure F)) ℓ
      have h4_gen : ∀ m : ℕ,
          ((((∏ r ∈ Finset.range m,
            Units.map (σ_r r).toRingEquiv.toMonoidHom y : Eˣ) : E) : AlgebraicClosure F)) =
            ∏ r ∈ Finset.range m, ((σ_r r y.1 : E) : AlgebraicClosure F) := by
        intro m
        induction' m with m ih
        · rfl
        · rw [Finset.prod_range_succ, Finset.prod_range_succ, ← ih]
          rfl
      exact (h1.trans (h2.trans h3)).trans (h4_gen ℓ).symm
    have h_prod_rc :
        (∏ r ∈ Finset.range ℓ, ((νM₁ ^ ((r * c) % ℓ)) x)⁻¹) =
          ∏ j ∈ Finset.range ℓ, ((νM₁ ^ j) x)⁻¹ := by
      refine Finset.prod_bij' (fun r _ => (r * c) % ℓ)
        (fun j _ => if h : j < ℓ then (Function.surjInv hf_c_bij.2 ⟨j, h⟩).1 else 0)
        (fun r _ => Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
        (fun j _ => by
          dsimp only
          split_ifs with h
          · exact Finset.mem_range.mpr (Function.surjInv hf_c_bij.2 ⟨j, h⟩).2
          · exact Finset.mem_range.mpr hPrime.pos)
        (fun r hr => ?_) (fun j hj => ?_) (fun r _ => rfl)
      · dsimp only
        have hr_lt : r < ℓ := Finset.mem_range.mp hr
        have hmod_lt : (r * c) % ℓ < ℓ := Nat.mod_lt _ hPrime.pos
        rw [dif_pos hmod_lt]
        have h_eq : f_c (Function.surjInv hf_c_bij.2 ⟨(r * c) % ℓ, hmod_lt⟩) = f_c ⟨r, hr_lt⟩ :=
          Function.surjInv_eq hf_c_bij.2 ⟨(r * c) % ℓ, hmod_lt⟩
        exact congrArg Fin.val (hf_c_inj h_eq)
      · dsimp only
        have hj_lt : j < ℓ := Finset.mem_range.mp hj
        rw [dif_pos hj_lt]
        exact congrArg Fin.val (Function.surjInv_eq hf_c_bij.2 ⟨j, hj_lt⟩)
    have h_prod_inv :
        (∏ j ∈ Finset.range ℓ, ((νM₁ ^ j) x)⁻¹) =
          ∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x := by
      have hνM₁_x_pow : (νM₁ x) ^ ℓ = 1 := by
        rw [← MonoidHom.pow_apply, hνM₁_pow, MonoidHom.one_apply]
      refine Finset.prod_bij' (fun j _ => (ℓ - j) % ℓ) (fun j _ => (ℓ - j) % ℓ)
        (fun j _ => Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
        (fun j _ => Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
        (fun j hj => ?_) (fun j hj => ?_) (fun j hj => ?_)
      · dsimp only
        have hj_lt : j < ℓ := Finset.mem_range.mp hj
        rcases eq_or_ne j 0 with rfl | hj0
        · simp
        · have h1 : (ℓ - j) % ℓ = ℓ - j := Nat.mod_eq_of_lt (by omega)
          rw [h1, show ℓ - (ℓ - j) = j by omega, Nat.mod_eq_of_lt hj_lt]
      · dsimp only
        have hj_lt : j < ℓ := Finset.mem_range.mp hj
        rcases eq_or_ne j 0 with rfl | hj0
        · simp
        · have h1 : (ℓ - j) % ℓ = ℓ - j := Nat.mod_eq_of_lt (by omega)
          rw [h1, show ℓ - (ℓ - j) = j by omega, Nat.mod_eq_of_lt hj_lt]
      · dsimp only
        have hj_lt : j < ℓ := Finset.mem_range.mp hj
        rcases eq_or_ne j 0 with rfl | hj0
        · simp
        · have h1 : (ℓ - j) % ℓ = ℓ - j := Nat.mod_eq_of_lt (by omega)
          rw [h1, MonoidHom.pow_apply, MonoidHom.pow_apply]
          apply inv_eq_of_mul_eq_one_left
          rw [← pow_add, show ℓ - j + j = ℓ by omega]
          exact hνM₁_x_pow
    have hχE'_eval_x :
        χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) =
          (χE' y) ^ ℓ * (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x) := by
      rw [h_incl_x, map_prod]
      calc (∏ r ∈ Finset.range ℓ, χE' (Units.map (σ_r r).toRingEquiv.toMonoidHom y))
        _ = ∏ r ∈ Finset.range ℓ, (χE' y * ((νM₁ ^ ((r * c) % ℓ)) x)⁻¹) :=
            Finset.prod_congr rfl fun r _ => hχE'_σ_r r
        _ = (∏ _r ∈ Finset.range ℓ, χE' y) *
              (∏ r ∈ Finset.range ℓ, ((νM₁ ^ ((r * c) % ℓ)) x)⁻¹) :=
            Finset.prod_mul_distrib
        _ = (χE' y) ^ ℓ * (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x) := by
            rw [Finset.prod_const, Finset.card_range, h_prod_rc, h_prod_inv]
    have hχE'_pow_eq : (χE' y) ^ ℓ =
        χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) := by
      calc (χE' y) ^ ℓ
        _ = χE' (y ^ ℓ) := (map_pow χE' y ℓ).symm
        _ = χE' (y ^ (Module.finrank E (IntermediateField.extendScalars hEK₁))) := by
            rw [hdegEK₁]
        _ = χE' (Units.map (normLM F hEK₁)
              (Units.map (IntermediateField.inclusion hEK₁).toMonoidHom y)) := by
            rw [(hDiamondNorm y).2]
        _ = (χE'.comp (Units.map (normLM F hEK₁)))
              (Units.map (IntermediateField.inclusion hEK₁).toMonoidHom y) := rfl
        _ = χK₁' (Units.map (IntermediateField.inclusion hEK₁).toMonoidHom y) := by
            rw [hχE'_norm]
        _ = (χM₁'.comp (Units.map (normLM F hM₁K₁)))
              (Units.map (IntermediateField.inclusion hEK₁).toMonoidHom y) := by
            rw [hχM₁'_norm]
        _ = χM₁' (Units.map (normLM F hM₁K₁)
              (Units.map (IntermediateField.inclusion hEK₁).toMonoidHom y)) := rfl
        _ = χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) := by
            rw [(hDiamondNorm y).1]
    have hνE_x : νE x = 1 := (hνE_ker x).mp ⟨y, rfl⟩
    have h_prod_νE : (∏ j ∈ Finset.range ℓ, (νE ^ j) x) = 1 := by
      apply Finset.prod_eq_one
      intro j _
      rw [MonoidHom.pow_apply, hνE_x, one_pow]
    rw [hχE'_eval_x, hχE'_pow_eq, h_prod_νE, mul_one]
  exact ⟨hNormFact, hχE'_norm, hχK₁'_cond, hcond_χE'_pos, hξE_pow, hξE_ne,
    hξE_pack, hνE_νM₁_cond, hCommonRest_E⟩

theorem ld_ch12_unshifted_cyclic_fml (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L₀ K₀ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L₀] [FiniteDimensional F K₀]
    (hL₀K₀ : L₀ ≤ K₀) (hGal : IsGaloisExt F L₀ K₀) (hAb : IsAbelianExt F hL₀K₀)
    (hPrime : Nat.Prime (Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀)))
    (ψ₀ : AddChar L₀ (Ω F)) (hψ₀ : IsAdmissibleChar F L₀ ψ₀)
    (ν₁ lam₀ : L₀ˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : L₀ˣ, x ∈ Set.range (Units.map (normLM F hL₀K₀)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀),
      ∀ u ∈ unitGroup F L₀ (condExp F L₀ (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hlam₀_cond : ∀ j < Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀),
      ∀ u ∈ unitGroup F L₀ (condExp F L₀ (ν₁ ^ j * lam₀)), (ν₁ ^ j * lam₀) u = 1)
    (hlam₀K_cond : ∀ u ∈ unitGroup F K₀ (condExp F K₀ (lam₀.comp (Units.map (normLM F hL₀K₀)))),
      (lam₀.comp (Units.map (normLM F hL₀K₀))) u = 1) :
    let ℓ₀ := Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀)
    tateEps F K₀ (lam₀.comp (Units.map (normLM F hL₀K₀))) (traceChar F hL₀K₀ ψ₀) *
      (∏ j ∈ Finset.range ℓ₀, tateEps F L₀ (ν₁ ^ j) ψ₀) =
    tateEps F K₀ 1 (traceChar F hL₀K₀ ψ₀) *
      (∏ j ∈ Finset.range ℓ₀, tateEps F L₀ (ν₁ ^ j * lam₀) ψ₀) :=
by
  set ℓ₀ := Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀)
  have hν₁_mod : ∀ k : ℕ, ν₁ ^ k = ν₁ ^ (k % ℓ₀) := by
    intro k
    apply MonoidHom.ext
    intro x
    have h1 : (ν₁ x) ^ ℓ₀ = 1 := by
      rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
    rw [MonoidHom.pow_apply, MonoidHom.pow_apply]
    conv_lhs => rw [← Nat.div_add_mod k ℓ₀]
    rw [pow_add, pow_mul, h1, one_pow, one_mul]
  obtain ⟨j₀, hj₀_mem, hj₀_min⟩ :=
    Finset.exists_min_image (Finset.range ℓ₀) (fun j => condExp F L₀ (ν₁ ^ j * lam₀))
      ⟨0, Finset.mem_range.mpr hPrime.pos⟩
  let χ' : L₀ˣ →* (Ω F)ˣ := ν₁ ^ j₀ * lam₀
  have hshift_char : ∀ (j : ℕ), ν₁ ^ j * χ' = ν₁ ^ ((j + j₀) % ℓ₀) * lam₀ := by
    intro j
    change ν₁ ^ j * (ν₁ ^ j₀ * lam₀) = ν₁ ^ ((j + j₀) % ℓ₀) * lam₀
    rw [← hν₁_mod (j + j₀)]
    apply MonoidHom.ext
    intro x
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, MonoidHom.mul_apply,
      MonoidHom.pow_apply, MonoidHom.pow_apply, MonoidHom.pow_apply,
      ← mul_assoc, ← pow_add]
  have hχ'_cond : ∀ j < ℓ₀,
      ∀ u ∈ unitGroup F L₀ (condExp F L₀ (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1 := by
    intro j _
    rw [hshift_char j]
    exact hlam₀_cond ((j + j₀) % ℓ₀) (Nat.mod_lt _ hPrime.pos)
  have hχ'_comp_eq : χ'.comp (Units.map (normLM F hL₀K₀)) =
      lam₀.comp (Units.map (normLM F hL₀K₀)) := by
    apply MonoidHom.ext
    intro y
    have hy_norm : ν₁ (Units.map (normLM F hL₀K₀) y) = 1 :=
      (hν₁_ker (Units.map (normLM F hL₀K₀) y)).mp ⟨y, rfl⟩
    change (ν₁ ^ j₀ * lam₀) (Units.map (normLM F hL₀K₀) y) =
      lam₀ (Units.map (normLM F hL₀K₀) y)
    rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hy_norm, one_pow, one_mul]
  have hχ'K_cond : ∀ u ∈ unitGroup F K₀ (condExp F K₀ (χ'.comp (Units.map (normLM F hL₀K₀)))),
      (χ'.comp (Units.map (normLM F hL₀K₀))) u = 1 := by
    rw [hχ'_comp_eq]
    exact hlam₀K_cond
  have hMinCond : ∀ j < ℓ₀, condExp F L₀ χ' ≤ condExp F L₀ (ν₁ ^ j * χ') := by
    intro j _
    rw [hshift_char j]
    exact hj₀_min ((j + j₀) % ℓ₀) (Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
  have hshift_prod :
      (∏ j ∈ Finset.range ℓ₀, tateEps F L₀ (ν₁ ^ j * χ') ψ₀) =
        ∏ i ∈ Finset.range ℓ₀, tateEps F L₀ (ν₁ ^ i * lam₀) ψ₀ := by
    have hj₀_lt : j₀ < ℓ₀ := Finset.mem_range.mp hj₀_mem
    refine Finset.prod_bij' (fun j _ => (j + j₀) % ℓ₀) (fun i _ => (i + (ℓ₀ - j₀)) % ℓ₀)
      (fun j _ => Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
      (fun i _ => Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
      (fun j hj => ?_) (fun i hi => ?_) (fun j _ => ?_)
    · dsimp only
      have hj_lt : j < ℓ₀ := Finset.mem_range.mp hj
      rw [Nat.mod_add_mod, show j + j₀ + (ℓ₀ - j₀) = j + ℓ₀ by omega,
        Nat.add_mod_right, Nat.mod_eq_of_lt hj_lt]
    · dsimp only
      have hi_lt : i < ℓ₀ := Finset.mem_range.mp hi
      rw [Nat.mod_add_mod, show i + (ℓ₀ - j₀) + j₀ = i + ℓ₀ by omega,
        Nat.add_mod_right, Nat.mod_eq_of_lt hi_lt]
    · dsimp only
      rw [hshift_char j]
  dsimp only
  rw [← hχ'_comp_eq, ← hshift_prod]
  by_cases hUnram : condExp F L₀ ν₁ = 0
  · exact ld_ch10_fml_unramified F L₀ K₀ hL₀K₀ hGal hAb hPrime ψ₀ hψ₀ ν₁ χ'
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hUnram
  · by_cases hEqP : Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀) = p F
    · exact ld_ch10_fml_wild_ramified F L₀ K₀ hL₀K₀ hGal hAb hPrime ψ₀ hψ₀ ν₁ χ'
        hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hUnram hEqP
    · exact ld_ch10_fml_tame_ramified F L₀ K₀ hL₀K₀ hGal hAb hPrime ψ₀ hψ₀ ν₁ χ'
        hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hUnram hEqP

theorem ld_ch12_bicyclic_f_elim_and_common_pow_rel (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hGalEK₁ : IsGaloisExt F E K₁) (hGalM₁K₁ : IsGaloisExt F M₁ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_inf : E ⊓ M₁ = L) (h_sup : E ⊔ M₁ = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (χM₁ : relWeil F M₁ →* (Ω F)ˣ) (hχM₁_weil : IsWeilRep F M₁ (charRep F M₁ χM₁))
    (hχM₁_rest : restrictWeilChar F hM₁K₁ χM₁ = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ) (hfL : f L = 1)
    (hfE : ∀ D₀ : List (MonomialTerm F L),
      IsMonomialDecomp F L 0 D₀ → (∀ s ∈ D₀, s.field ≤ E) →
      evalMonomialList F rec (fun _ E' _ => f E') L ψ D₀ = 1)
    (hfM₁ : ∀ D₀ : List (MonomialTerm F L),
      IsMonomialDecomp F L 0 D₀ → (∀ s ∈ D₀, s.field ≤ M₁) →
      evalMonomialList F rec (fun _ E' _ => f E') L ψ D₀ = 1) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    let ψE := traceChar F hLE ψ
    let ψM₁ := traceChar F hLM₁ ψ
    let ψK₁ := traceChar F (hLE.trans hEK₁) ψ
    let χE' := recChar F rec E χE
    let χM₁' := recChar F rec M₁ χM₁
    let χK₁' := recChar F rec K₁ χK₁
    FiniteDimensional F L ∧
    FiniteDimensional F E ∧
    FiniteDimensional F M₁ ∧
    FiniteDimensional F K₁ ∧
    IsAbelianExt F hLE ∧
    IsAbelianExt F hLM₁ ∧
    IsAbelianExt F hEK₁ ∧
    IsAbelianExt F hM₁K₁ ∧
    IsAdmissibleChar F E ψE ∧
    IsAdmissibleChar F M₁ ψM₁ ∧
    IsAdmissibleChar F K₁ ψK₁ ∧
    ∃ (νE νM₁ : Lˣ →* (Ω F)ˣ),
      νE ^ ℓ = 1 ∧
      νE ≠ 1 ∧
      (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1) ∧
      (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1) ∧
      νM₁ ^ ℓ = 1 ∧
      νM₁ ≠ 1 ∧
      (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1) ∧
      (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1) ∧
      (∀ x : Lˣ, ∃ (y : Eˣ) (z : M₁ˣ),
        x = Units.map (normLM F hLE) y * Units.map (normLM F hLM₁) z) ∧
      χE'.comp (Units.map (normLM F hEK₁)) = χK₁' ∧
      χM₁'.comp (Units.map (normLM F hM₁K₁)) = χK₁' ∧
      (∀ u ∈ unitGroup F K₁ (condExp F K₁ χK₁'), χK₁' u = 1) ∧
      1 ≤ condExp F E χE' ∧
      (∀ j < ℓ,
        let ξE := νM₁.comp (Units.map (normLM F hLE))
        (∀ y : Eˣ, y ∈ Set.range (Units.map (normLM F hEK₁)) ↔ ξE y = 1) ∧
        (∀ u ∈ unitGroup F E (condExp F E (ξE ^ j)), (ξE ^ j) u = 1) ∧
        (∀ u ∈ unitGroup F E (condExp F E (ξE ^ j * χE')), (ξE ^ j * χE') u = 1) ∧
        condExp F E (ξE ^ j * χE') = condExp F E χE' ∧
        tateEps F E (ξE ^ j * χE') ψE = tateEps F E χE' ψE) ∧
      1 ≤ condExp F M₁ χM₁' ∧
      (∀ j < ℓ,
        let ξM₁ := νE.comp (Units.map (normLM F hLM₁))
        (∀ z : M₁ˣ, z ∈ Set.range (Units.map (normLM F hM₁K₁)) ↔ ξM₁ z = 1) ∧
        (∀ u ∈ unitGroup F M₁ (condExp F M₁ (ξM₁ ^ j)), (ξM₁ ^ j) u = 1) ∧
        (∀ u ∈ unitGroup F M₁ (condExp F M₁ (ξM₁ ^ j * χM₁')), (ξM₁ ^ j * χM₁') u = 1) ∧
        condExp F M₁ (ξM₁ ^ j * χM₁') = condExp F M₁ χM₁' ∧
        tateEps F M₁ (ξM₁ ^ j * χM₁') ψM₁ = tateEps F M₁ χM₁' ψM₁) ∧
      (∀ x : Lˣ,
        χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
          (∏ j ∈ Finset.range ℓ, (νE ^ j) x) =
