      _ = (-1 : k_M) ^ (∑ j ∈ Finset.range ℓ, padicValNat p (γ j).factorial) *
          ((((p.digits a).map Nat.factorial).prod : k_M) *
            ∏ j ∈ (Finset.range ℓ).erase 0, (((p.digits (j * h)).map Nat.factorial).prod : k_M)) := by
            rw [← h_sign_eq]
