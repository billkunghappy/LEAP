    (hnorm_h₁ : normLM F hLM₁' (2 * x) = -4 * f)
    (hnorm_h₂ : normLM F hLE' (R - 1) = 1 - ρ) :
    let a := condExp F L νM₁' / 2
    let e := condExp F L νE' / 2
    let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
    let u₄ : Lˣ := u₂ ^ 2
    let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
    let h₁ : M₁' := 2 * x
    let h₂ : E' := R - 1
    let β₁ : L := -4 * f
    let β₂ : L := 1 - ρ
    let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
    let ψM₁' := traceChar F hLM₁' ψ
    Module.finrank L (IntermediateField.extendScalars hLE') = 2 ∧
    Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 ∧
    (∀ s₀ s₁ : L,
      traceLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        2 * s₀ - s₁ ∧
      normLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        s₀ ^ 2 - s₀ * s₁ - f * s₁ ^ 2) ∧
    ∃ (c₀ c₁ : L) (c_θ₁ : M₁'ˣ) (Δ₀ Δ₁ : L),
      let p_X := 2 * c₀
      let A := c₀ ^ 2 - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x
      valL F M₁' (c_θ₁ : M₁') = (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁',
        (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) = ψM₁' (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z)) ∧
      (c₀ = 0 ∨ 1 - (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L c₀) ∧
      (c₁ = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L c₁) ∧
      (Δ₀ = 0 ∨ (e : ℤ) - (a : ℤ) + 1 ≤ valL F L Δ₀) ∧
      (Δ₁ = 0 ∨ 0 ≤ valL F L Δ₁) ∧
      IntermediateField.inclusion hLM₁' (α : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
          (a₁ + IntermediateField.inclusion hLM₁' A + Q₁) =
        IntermediateField.inclusion hLM₁' Δ₀ + IntermediateField.inclusion hLM₁' Δ₁ * x ∧
      normLM F hLM₁' (h₁ - IntermediateField.inclusion hLM₁' p_X) =
        β₁ + 4 * c₀ + 4 * c₀ ^ 2 ∧
      normLM F hLE' (h₂ - IntermediateField.inclusion hLE' p_X) =
        β₂ + 4 * c₀ + 4 * c₀ ^ 2 :=
by
  intro a e u₂ u₄ h₀ h₁ h₂ β₁ β₂ a₁ ψM₁'
  have ha_ge1 : 1 ≤ a := by dsimp [a]; omega
  have he_ge_a : a ≤ e := by dsimp [a, e]; omega
  have hbM₁'_eq : (condExp F L νM₁' : ℤ) = 2 * (a : ℤ) := by dsimp [a]; omega
  have hbE'_eq : (condExp F L νE' : ℤ) = 2 * (e : ℤ) + 1 := by dsimp [e]; omega
  have hQuad_gen : ∀ (K S : Type u) [Field K] [Field S] [Algebra K S] [FiniteDimensional K S],
      Module.finrank K S = 2 →
      (∀ (u v : K) (w : S),
        Algebra.trace K S (algebraMap K S u + algebraMap K S v * w) =
          (2 : K) * u + v * Algebra.trace K S w ∧
        Algebra.norm K (algebraMap K S u + algebraMap K S v * w) =
          u ^ 2 + u * v * Algebra.trace K S w + v ^ 2 * Algebra.norm K w) ∧
      (∀ (u : K) (w : S),
        Algebra.norm K (w - algebraMap K S u) =
          Algebra.norm K w - u * Algebra.trace K S w + u ^ 2) := by
    clear * -
    intro K S _ _ _ _ hdeg
    have htr_smul : ∀ (c : K) (z : S),
        Algebra.trace K S (algebraMap K S c * z) = c * Algebra.trace K S z := by
      intro c z
      rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
    have hnorm_add : ∀ (x : K) (y : S),
        Algebra.norm K (algebraMap K S x + y) =
          x ^ 2 + x * Algebra.trace K S y + Algebra.norm K y := by
      intro x y
      let b : Module.Basis (Fin 2) K S :=
        (Module.finBasis K S).reindex (finCongr hdeg)
      let A : Matrix (Fin 2) (Fin 2) K := Algebra.leftMulMatrix b y
      let X : Matrix (Fin 2) (Fin 2) K := Algebra.leftMulMatrix b (algebraMap K S x)
      have htr_y : Algebra.trace K S y = A 0 0 + A 1 1 := by
        rw [Algebra.trace_eq_matrix_trace b y, Matrix.trace_fin_two A]
      have hnorm_y : Algebra.norm K y = A 0 0 * A 1 1 - A 0 1 * A 1 0 := by
        rw [Algebra.norm_eq_matrix_det b y, Matrix.det_fin_two A]
      have hX_eq : X = algebraMap K (Matrix (Fin 2) (Fin 2) K) x :=
        AlgHom.commutes (Algebra.leftMulMatrix b) x
      have hX00 : X 0 0 = x := by
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
      have hX11 : X 1 1 = x := by
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
      have hX01 : X 0 1 = 0 := by
        have h01 : (0 : Fin 2) ≠ 1 := by decide
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h01]
      have hX10 : X 1 0 = 0 := by
        have h10 : (1 : Fin 2) ≠ 0 := by decide
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h10]
      rw [Algebra.norm_eq_matrix_det b (algebraMap K S x + y), map_add]
      change (X + A).det = _
      rw [Matrix.det_fin_two, htr_y, hnorm_y]
      simp only [Matrix.add_apply, hX00, hX11, hX01, hX10]
      ring
    refine ⟨?_, ?_⟩
    · intro u v w
      refine ⟨?_, ?_⟩
      · rw [map_add, Algebra.trace_algebraMap, hdeg, nsmul_eq_mul, Nat.cast_two, htr_smul]
      · rw [hnorm_add u (algebraMap K S v * w), htr_smul v w, map_mul,
