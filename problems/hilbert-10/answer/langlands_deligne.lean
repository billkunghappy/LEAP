      valL F L (cνE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ ∧
      (∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
        ∀ hu : 1 + u ≠ 0,
          (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνE'⁻¹ : Lˣ) : L) * u)) ∧
      valL F L (cνM₁' : L) = (condExp F L νM₁' : ℤ) + condExpChar F L ψ ∧
      (∀ u : L, (u = 0 ∨ (((condExp F L νM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
        ∀ hu : 1 + u ≠ 0,
          (νM₁' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνM₁'⁻¹ : Lˣ) : L) * u)) ∧
      (∀ z : K₁, (z = 0 ∨ 0 ≤ valL F K₁ z) →
        let t₂ := 2 * r - 1
