          - (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) := by ring
    rw [hneg_eq]
    rcases huw₂_pow_sub with h0 | hge
    · left; rw [h0, neg_zero]
    · right; rwa [hvalE'_neg]

  
  have hPstar_sub_D_eq :
      P_star - D = ∑ r ∈ Finset.Icc 1 (p - 1), s_LE' x r := by
    have hnorm_1x := hs_LE'_norm_one_add x
    change normLM F hLE' C - 1 =
      (∑ r ∈ Finset.Icc 1 (p - 1), s_LE' x r) + normLM F hLE' x at hnorm_1x
    rw [hnorm_x] at hnorm_1x
    dsimp [P_star, D]
    linear_combination hnorm_1x
  let X_1 : ℤ := q_x + ((p - 1 : ℕ) : ℤ) * (bE' : ℤ)
  let r_1 : ℤ := X_1 % (p : ℤ)
  have hdiv1_eq : (p : ℤ) * m_x1 + r_1 = X_1 := Int.mul_ediv_add_emod X_1 (p : ℤ)
  have hr1_nonneg : 0 ≤ r_1 := Int.emod_nonneg X_1 hp_ne0_int
  have hr1_lt : r_1 < (p : ℤ) := Int.emod_lt_of_pos X_1 hp_pos_int
  have hs_x_val :
      ∀ r ∈ Finset.Icc 1 (p - 1), s_LE' x r = 0 ∨ m_x1 ≤ valL F L (s_LE' x r) := by
    intro r hr
    obtain ⟨hr1, _⟩ := Finset.mem_Icc.mp hr
    apply hs_LE'_val x r hr q_x m_x1 (Or.inr (le_of_eq hx_val.symm))
    have hr1_int : (1 : ℤ) ≤ (r : ℤ) := by exact_mod_cast hr1
    have h1q : 1 * q_x ≤ (r : ℤ) * q_x :=
      mul_le_mul_of_nonneg_right hr1_int (by linarith)
    dsimp [X_1] at hdiv1_eq
    linarith
  have hPstar_sub_D : P_star - D = 0 ∨ m_x1 ≤ valL F L (P_star - D) := by
    rw [hPstar_sub_D_eq]
    exact hvalL_sum_ge (Finset.Icc 1 (p - 1)) (fun r => s_LE' x r) m_x1 hs_x_val

  
  let B_7 : ℤ := (((p - 1) * t₂ + (p * m - t₁) : ℕ) : ℤ)
  have hB7_le_pm : B_7 ≤ (p : ℤ) * m_x1 := by
    dsimp [B_7, X_1, q_x] at hdiv1_eq ⊢
    push_cast
    rw [hp1_cast, hbE'1_cast]
    rw [hp1_cast] at hdiv1_eq
    linarith
  have hQE'_sub_D_eq :
      Q_E' - IntermediateField.inclusion hLE' D =
        ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' x i) * x ^ (p - i) := by
    have hcay := hs_LE'_cayley x
    change x ^ p =
      IntermediateField.inclusion hLE' (normLM F hLE' x) +
        ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' x i) * x ^ (p - i) at hcay
    have hD_incl :
        IntermediateField.inclusion hLE' D =
          1 + IntermediateField.inclusion hLE' (normLM F hLE' x) := by
      dsimp [D]
      rw [← hnorm_x, map_add, map_one]
    rw [hQE'_eq, hD_incl, hcay]
    ring
  have hQE'_sub_D :
      Q_E' - IntermediateField.inclusion hLE' D = 0 ∨
        B_7 ≤ valL F E' (Q_E' - IntermediateField.inclusion hLE' D) := by
    rw [hQE'_sub_D_eq]
    apply hvalE'_sum_ge (Finset.Icc 1 (p - 1))
      (fun i =>
        (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' x i) * x ^ (p - i))
      B_7
    intro i hi
    have hneg_i : (-1 : E') ^ (i - 1) = 0 ∨ 0 ≤ valL F E' ((-1 : E') ^ (i - 1)) :=
      Or.inr (by rw [(hneg1_pow_E' (i - 1)).2])
    have hs_i_E' :
        IntermediateField.inclusion hLE' (s_LE' x i) = 0 ∨
          (p : ℤ) * m_x1 ≤ valL F E' (IntermediateField.inclusion hLE' (s_LE' x i)) := by
      rcases hs_x_val i hi with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LE' (s_LE' x i)]
        exact mul_le_mul_of_nonneg_left hge (by positivity)
    have hx_pi : x ^ (p - i) = 0 ∨ ((p - i : ℕ) : ℤ) * q_x ≤ valL F E' (x ^ (p - i)) :=
      hvalE'_pow_ge x (p - i) q_x (Or.inr (le_of_eq hx_val.symm))
    have h1 := hvalE'_mul_ge 0 ((p : ℤ) * m_x1)
      ((-1 : E') ^ (i - 1)) (IntermediateField.inclusion hLE' (s_LE' x i))
      hneg_i hs_i_E'
    have h2 := hvalE'_mul_ge (0 + (p : ℤ) * m_x1) (((p - i : ℕ) : ℤ) * q_x)
      ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' x i))
      (x ^ (p - i)) h1 hx_pi
    apply hvalE'_mono B_7 _ _ _ h2
    have hnonneg : 0 ≤ ((p - i : ℕ) : ℤ) * q_x :=
      mul_nonneg (Nat.cast_nonneg (p - i)) (by linarith)
    linarith
  have hPstar_sub_D_E' :
      IntermediateField.inclusion hLE' (P_star - D) = 0 ∨
        B_7 ≤ valL F E' (IntermediateField.inclusion hLE' (P_star - D)) := by
    rcases hPstar_sub_D with h0 | hge
    · left; rw [h0, map_zero]
    · right
      rw [hval_LE' (P_star - D)]
      have hmul : (p : ℤ) * m_x1 ≤ (p : ℤ) * valL F L (P_star - D) :=
        mul_le_mul_of_nonneg_left hge (by positivity)
      linarith
  have hQE'_Pstar :
      Q_E' - IntermediateField.inclusion hLE' P_star = 0 ∨
        B_7 ≤ valL F E' (Q_E' - IntermediateField.inclusion hLE' P_star) := by
    have h_split :
        Q_E' - IntermediateField.inclusion hLE' P_star =
          (Q_E' - IntermediateField.inclusion hLE' D) -
            IntermediateField.inclusion hLE' (P_star - D) := by
      rw [map_sub]; ring
    rw [h_split]
    exact hvalE'_sub B_7 _ _ hQE'_sub_D hPstar_sub_D_E'

  
  have hchoose_valE' : ∀ k : ℕ, 0 < k → k < p →
      ((p.choose k : ℕ) : E') = 0 ∨
        (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((p.choose k : ℕ) : E') := by
    intro k hk_pos hk_lt
    obtain ⟨c_k, hc_k⟩ := Nat.Prime.dvd_choose_self hPrime (by omega : k ≠ 0) hk_lt
    rw [hc_k, Nat.cast_mul]
    have hmul := hvalE'_mul_ge ((((p - 1) * t₂ : ℕ) : ℤ)) 0
      ((p : ℕ) : E') ((c_k : ℕ) : E') hp_valE' (hvalE'_natCast c_k)
    rwa [add_zero] at hmul
  have hCp_sub_QE'_eq :
      C ^ p - Q_E' =
        ∑ k ∈ Finset.range (p - 1),
          x ^ (k + 1) * 1 ^ (p - (k + 1)) * ((p.choose (k + 1) : ℕ) : E') := by
    have hC_comm : C ^ p = (x + 1) ^ p := congrArg (· ^ p) (add_comm 1 x)
    rw [hC_comm, hQE'_eq, add_pow x 1 p, Finset.sum_range_succ _ p]
    have hrange : Finset.range p = Finset.range ((p - 1) + 1) :=
      congrArg Finset.range (by omega)
    rw [hrange, Finset.sum_range_succ' _ (p - 1)]
    simp only [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one,
      Nat.sub_zero, one_mul, Nat.choose_zero_right, one_pow]
    ring
  have hCp_QE' : C ^ p - Q_E' = 0 ∨ B_7 ≤ valL F E' (C ^ p - Q_E') := by
    rw [hCp_sub_QE'_eq]
    apply hvalE'_sum_ge (Finset.range (p - 1))
      (fun k => x ^ (k + 1) * 1 ^ (p - (k + 1)) * ((p.choose (k + 1) : ℕ) : E'))
      B_7
    intro k hk_mem
    have hk_lt : k < p - 1 := Finset.mem_range.mp hk_mem
    have hterm_eq :
        x ^ (k + 1) * 1 ^ (p - (k + 1)) * ((p.choose (k + 1) : ℕ) : E') =
          x ^ (k + 1) * ((p.choose (k + 1) : ℕ) : E') := by
      rw [one_pow, mul_one]
    rw [hterm_eq]
    have hx_k1 := hvalE'_pow_ge x (k + 1) q_x (Or.inr (le_of_eq hx_val.symm))
    have hch := hchoose_valE' (k + 1) (by omega) (by omega)
    have hmul := hvalE'_mul_ge (((k + 1 : ℕ) : ℤ) * q_x) ((((p - 1) * t₂ : ℕ) : ℤ))
      (x ^ (k + 1)) ((p.choose (k + 1) : ℕ) : E') hx_k1 hch
    apply hvalE'_mono B_7 _ _ _ hmul
    have hk1_ge1 : (1 : ℤ) ≤ ((k + 1 : ℕ) : ℤ) := by omega
    have hqx_le : 1 * q_x ≤ ((k + 1 : ℕ) : ℤ) * q_x :=
      mul_le_mul_of_nonneg_right hk1_ge1 (by linarith)
    dsimp [B_7, q_x] at hqx_le ⊢
    push_cast
    linarith

  exact ⟨h2_ne0, hj_unit, hp_valE',
    ⟨hC_ne0, hC_val0, hPstar_ne0, hPstar_val0, hD_ne0, hD_val0, hPq₀_ne0, hPq₀_val0,
      hQq₀_ne0, hQq₀_val0, hD₀_ne0⟩,
    huw₂_pow, hPstar_sub_D, hQE'_Pstar, hCp_QE'⟩

theorem ld_ch12_wild_odd_tot_ram_rat_and_add_stationary_cancel_on_E' (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hj_unit :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∀ j ∈ Finset.Icc 1 (p - 1),
        ((j : ℕ) : E') ≠ 0 ∧ valL F E' ((j : ℕ) : E') = 0 ∧ valL F E' (((j : ℕ) : E')⁻¹) = 0)
    (hp_valE' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₂ := bE' - 1
      ((p : ℕ) : E') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E'))
    (hUnits :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let a := normLM F hE'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let P_star := normLM F hLE' C
      let q₀ := u ^ (p - 1)
      let D := 1 + u ^ p * normLM F hLE' a
      let W_E' := IntermediateField.inclusion hLE' W
      let Q_E' := 1 + IntermediateField.inclusion hLE' (u ^ p) * a ^ p
      let D₀_E' := W_E' ^ p - W_E' + a ^ p
      C ≠ 0 ∧ valL F E' C = 0 ∧
      P_star ≠ 0 ∧ valL F L P_star = 0 ∧
      D ≠ 0 ∧ valL F L D = 0 ∧
      P_star - q₀ ≠ 0 ∧ valL F L (P_star - q₀) = 0 ∧
      Q_E' - IntermediateField.inclusion hLE' q₀ ≠ 0 ∧
      valL F E' (Q_E' - IntermediateField.inclusion hLE' q₀) = 0 ∧
      D₀_E' ≠ 0)
    (huw₂_pow :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₂ := bE' - 1
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      1 - IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) = 0 ∨
        (((p - 1) * t₂ : ℕ) : ℤ) ≤
          valL F E' (1 - IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p)))
    (hQE'_Pstar :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let m := a_lam - bE'
      let a := normLM F hE'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let P_star := normLM F hLE' C
      let Q_E' := 1 + IntermediateField.inclusion hLE' (u ^ p) * a ^ p
      Q_E' - IntermediateField.inclusion hLE' P_star = 0 ∨
        (((p - 1) * t₂ + (p * m - t₁) : ℕ) : ℤ) ≤
          valL F E' (Q_E' - IntermediateField.inclusion hLE' P_star))
    (hCp_QE' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let m := a_lam - bE'
      let a := normLM F hE'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let Q_E' := 1 + IntermediateField.inclusion hLE' (u ^ p) * a ^ p
      C ^ p - Q_E' = 0 ∨
        (((p - 1) * t₂ + (p * m - t₁) : ℕ) : ℤ) ≤ valL F E' (C ^ p - Q_E')) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let a := normLM F hE'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let C := 1 + IntermediateField.inclusion hLE' u * a
    let P_star := normLM F hLE' C
    let q₀ := u ^ (p - 1)
    let F_star := P_star * (P_star - q₀)⁻¹
    let k_rat := IntermediateField.inclusion hLE' u * (w₂ : E') * C⁻¹
    let W_E' := IntermediateField.inclusion hLE' W
    let D₀_E' := W_E' ^ p - W_E' + a ^ p
    let F_fn : ℕ → E' := fun i =>
      W_E' * D₀_E'⁻¹ * ((W_E' + a) * (((w₂⁻¹ : E'ˣ) : E'))) ^ i
    let R_E' : E' :=
      - W_E' * F_fn (p - 1) +
        W_E' * (∑ i ∈ Finset.Icc 1 (p - 2), ((i : ℕ) : E')⁻¹ * F_fn i) +
        W_E' * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) +
        IntermediateField.inclusion hLE' (W * F_star) *
          (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * k_rat ^ j) -
        (w₂ : E')
    R_E' = 0 ∨ (bE' : ℤ) ≤ valL F E' R_E' :=
by
  intro p a u W C P_star q₀ F_star k_rat W_E' D₀_E' F_fn R_E'
  let t₁ : ℕ := bM₁' - 1
  let t₂ : ℕ := bE' - 1
  let m : ℕ := a_lam - bE'
  let Q_E' : E' := 1 + IntermediateField.inclusion hLE' (u ^ p) * a ^ p
  let w₂_inv : E' := ((w₂⁻¹ : E'ˣ) : E')

  
  obtain ⟨_, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, hvalE'_1, _, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  have hvalE'_pow : ∀ (x : E') (k : ℕ), x ≠ 0 → valL F E' (x ^ k) = (k : ℤ) * valL F E' x := by
    intro x k hx
    induction k with
    | zero => simp [hvalE'_1]
    | succ k ih =>
      rw [pow_succ, hvalE'_mul (x ^ k) x (pow_ne_zero k hx) hx, ih]
      push_cast; ring
  have hvalE'_inv_elt : ∀ (x : E'), x ≠ 0 → valL F E' x⁻¹ = - valL F E' x := by
    intro x hx
    exact hvalE'_inv (Units.mk0 x hx)
  have hvalE'_sub : ∀ (k : ℤ) (x y : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
        (x - y = 0 ∨ k ≤ valL F E' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    refine hvalE'_add k x (-y) hx ?_
    rcases hy with rfl | hy
    · exact Or.inl neg_zero
    · exact Or.inr (by rwa [hvalE'_neg])
  have hvalE'_mono : ∀ (k₁ k₂ : ℤ) (x : E'),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F E' x) → (x = 0 ∨ k₁ ≤ valL F E' x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hvalE'_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : E'),
      (x = 0 ∨ k₁ ≤ valL F E' x) → (y = 0 ∨ k₂ ≤ valL F E' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F E' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalE'_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalE'_sum_ge : ∀ (S : Finset ℕ) (f : ℕ → E') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F E' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ S, f i)) := by
    intro S f k hf
    induction' S using Finset.induction_on with i S hi ih
    · left; exact Finset.sum_empty
    · rw [Finset.sum_insert hi]
      exact hvalE'_add k (f i) (∑ j ∈ S, f j)
        (hf i (Finset.mem_insert_self i S))
        (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))

  
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by dsimp [p]; omega
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpm_gt : t₁ < p * m := hpm_gt_t₁
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hbE'1_cast : (t₂ : ℤ) = (bE' : ℤ) - 1 := by dsimp [t₂]; omega
  have hpm_sub_cast : ((p * m - t₁ : ℕ) : ℤ) = (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    have hle : t₁ ≤ p * m := le_of_lt hpm_gt
    rw [Int.ofNat_sub hle, Nat.cast_mul]

  
  obtain ⟨hC_ne0, hC_val0, _, _, _, _, hPq₀_ne0, hPq₀_val0, hQq₀_ne0, hQq₀_val0, hD₀_ne0⟩ :=
    hUnits
  have hu_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero γ⁻¹)
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero γ⁻¹),
      hvalL_inv γ, hα_val, hγ_val]
    omega
  have hu_E'_ne0 : IntermediateField.inclusion hLE' u ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hu_ne0
  have hu_E'_val : valL F E' (IntermediateField.inclusion hLE' u) = (p : ℤ) * (m : ℤ) := by
    rw [hval_LE' u, hu_val]
  have hW_L_ne0 : W ≠ 0 := mul_ne_zero (Units.ne_zero γ) (Units.ne_zero α⁻¹)
  have hW_L_val : valL F L W = -(m : ℤ) := by
    dsimp [W, m]
    rw [hvalL_mul (γ : L) ((α⁻¹ : Lˣ) : L) (Units.ne_zero γ) (Units.ne_zero α⁻¹),
      hvalL_inv α, hγ_val, hα_val]
    omega
  have hW_E'_ne0 : W_E' ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hW_L_ne0
  have hW_E'_val : valL F E' W_E' = -(p : ℤ) * (m : ℤ) := by
    dsimp [W_E']
