  rw [← hprod_eq] at hprod_B₀
  have hm₀_B₀ : -x₀ + (τ_u m₀ : K₁) = 0 ∨ B₀ ≤ valL F K₁ (-x₀ + (τ_u m₀ : K₁)) :=
    hval_cancel_unit B₀ (∏ j ∈ S'.erase m₀, (-x₀ + (τ_u j : K₁))) (-x₀ + (τ_u m₀ : K₁))
