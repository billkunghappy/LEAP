        (y = 0 ∨ m ≤ vE y) →
        ιE y * (Δ ^ k) = 0 ∨
          (p : ℤ) * m - (k : ℤ) * (t₁ : ℤ) ≤ vK (ιE y * (Δ ^ k)) := by
      intro y k m hy
      by_cases hy0 : y = 0
      · left; rw [hy0, map_zero, zero_mul]
      · right
