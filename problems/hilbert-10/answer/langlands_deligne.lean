  obtain ⟨c, hY₁_eq, hc_iff⟩ := hBasis Y₁
  have hc_val := (hc_iff 0).mp hY₁
  let i₀ : Fin p := ⟨0, hp_pos⟩
  set c₀ : L := c i₀
  set Y_ge1 : E' := ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₀,
    IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ))
  have hY₁_split : Y₁ = IntermediateField.inclusion hLE' c₀ + Y_ge1 := by
    rw [hY₁_eq, ← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ i₀)]
    change IntermediateField.inclusion hLE' c₀ * ((ϖ_E' : E') ^ (0 : ℕ)) + Y_ge1 = _
    rw [pow_zero, mul_one]
