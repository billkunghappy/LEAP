    rw [← hδ_sum] at hδ_ge1
    rcases hδ_ge1 with h0 | hge1
    · exact Units.ne_zero δ h0
    · omega
  let u_zδ : M_Cˣ := Units.mk0 z_δ hz_δ_ne_and_val0.1
  have hu_zδ_val : valL F M_C (u_zδ : M_C) = 0 := hz_δ_ne_and_val0.2
  let w₁ : Kˣ := δ * (Units.map (IntermediateField.inclusion hM_CK).toMonoidHom u_zδ)⁻¹
  let y₁ : K := (w₁ : K) - 1
  have hy₁_val : y₁ = 0 ∨ 1 ≤ valL F K y₁ := by
    have hy₁_eq : y₁ =
