    refine ⟨hsum_ne, ?_⟩
    have hge : m₁ ≤ valL F L (s₁ + s₂) := by
      rcases hvalL_add m₁ m₁ m₂ s₁ s₂ (Or.inr (le_of_eq hs₁_val.symm)) hs₂ le_rfl (by omega) with h0 | hge
      · exact absurd h0 hsum_ne
      · exact hge
    by_contra hne
    have hgt : m₁ + 1 ≤ valL F L (s₁ + s₂) := by omega
    have hs₁_eq : s₁ = (s₁ + s₂) - s₂ := by ring
    rcases hvalL_sub (m₁ + 1) (m₁ + 1) m₂ (s₁ + s₂) s₂ (Or.inr hgt) hs₂ le_rfl (by omega) with h0 | hle
    · rw [← hs₁_eq] at h0; exact hs₁_ne h0
    · rw [← hs₁_eq, hs₁_val] at hle; omega
  have hvalL_inv_eq : ∀ (s : L) (hs : s ≠ 0), valL F L (s⁻¹) = - valL F L s := by
    intro s hs
    have h := hvalL_inv (Units.mk0 s hs)
    simpa using h
  have hvalM₁'_mono : ∀ (m₁ m₂ : ℤ) (z : M₁'),
      (z = 0 ∨ m₁ ≤ valL F M₁' z) → m₂ ≤ m₁ → (z = 0 ∨ m₂ ≤ valL F M₁' z) := by
    intro m₁ m₂ z hz hm
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hz)
  have hvalM₁'_neg_or : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨ m ≤ valL F M₁' z) → (-z = 0 ∨ m ≤ valL F M₁' (-z)) := by
    intro m z hz
    rcases hz with rfl | hz
    · simp
    · right; rw [hvalM₁'_neg]; exact hz
  have hvalM₁'_add : ∀ (m m₁ m₂ : ℤ) (z₁ z₂ : M₁'),
      (z₁ = 0 ∨ m₁ ≤ valL F M₁' z₁) → (z₂ = 0 ∨ m₂ ≤ valL F M₁' z₂) →
      m ≤ m₁ → m ≤ m₂ → (z₁ + z₂ = 0 ∨ m ≤ valL F M₁' (z₁ + z₂)) := by
    intro m m₁ m₂ z₁ z₂ hz₁ hz₂ hm₁ hm₂
    exact hvalM₁'_ultra m z₁ z₂ (hvalM₁'_mono m₁ m z₁ hz₁ hm₁) (hvalM₁'_mono m₂ m z₂ hz₂ hm₂)
  have hvalM₁'_mul_or : ∀ (m m₁ m₂ : ℤ) (z₁ z₂ : M₁'),
      (z₁ = 0 ∨ m₁ ≤ valL F M₁' z₁) → (z₂ = 0 ∨ m₂ ≤ valL F M₁' z₂) →
      m ≤ m₁ + m₂ → (z₁ * z₂ = 0 ∨ m ≤ valL F M₁' (z₁ * z₂)) := by
    intro m m₁ m₂ z₁ z₂ hz₁ hz₂ hm
