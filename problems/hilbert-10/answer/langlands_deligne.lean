  let liftFi : ∀ i : Fin D_orb.length, k_Fi i → (D_orb.get i).field :=
    fun i b => Classical.choose ((hresFi_map i).2.2.2.2 b)
  have hliftFi_int : ∀ (i : Fin D_orb.length) (b : k_Fi i), PFi i 0 (liftFi i b) :=
    fun i b => (Classical.choose_spec ((hresFi_map i).2.2.2.2 b)).1
  have hliftFi_res : ∀ (i : Fin D_orb.length) (b : k_Fi i), resFi i (liftFi i b) = b :=
    fun i b => (Classical.choose_spec ((hresFi_map i).2.2.2.2 b)).2

  let φ_bar_fun : ∀ j : Fin (q - 1), k_Fi (idx_all j) → k_M :=
    fun j b => resM (φ_loc j (liftFi (idx_all j) b))

  have hφ_bar_spec : ∀ (j : Fin (q - 1)) (y : (D_orb.get (idx_all j)).field),
      PFi (idx_all j) 0 y →
      resM (φ_loc j y) = φ_bar_fun j (resFi (idx_all j) y) := by
    intro j y hy
    dsimp only [φ_bar_fun]
    apply hresM_eq_of_mem1 (hφ_loc_mem j hy)
      (hφ_loc_mem j (hliftFi_int (idx_all j) (resFi (idx_all j) y)))
    rw [← map_sub]
    exact hφ_loc_mem j
      (hresFi_sub_mem1 (idx_all j) hy
        (hliftFi_int (idx_all j) (resFi (idx_all j) y))
        (hliftFi_res (idx_all j) (resFi (idx_all j) y)).symm)

  let φ_bar : ∀ j : Fin (q - 1), k_Fi (idx_all j) →+* k_M := fun j =>
    { toFun := φ_bar_fun j
      map_zero' := by
        rw [← (hresFi_map (idx_all j)).1,
          ← hφ_bar_spec j 0 (hPFi_zero (idx_all j) 0), map_zero, hresM_0]
      map_one' := by
        rw [← (hresFi_map (idx_all j)).2.1,
          ← hφ_bar_spec j 1 (hPFi_one (idx_all j)), map_one, hresM_1]
      map_add' := fun b₁ b₂ => by
        let i := idx_all j
        set y₁ := liftFi i b₁
        set y₂ := liftFi i b₂
        have hy₁ : PFi i 0 y₁ := hliftFi_int i b₁
        have hy₂ : PFi i 0 y₂ := hliftFi_int i b₂
        have hsum_res : b₁ + b₂ = resFi i (y₁ + y₂) := by
          rw [((hresFi_map i).2.2.1 y₁ y₂ hy₁ hy₂).1, hliftFi_res i b₁, hliftFi_res i b₂]
        rw [hsum_res, ← hφ_bar_spec j (y₁ + y₂) (hPFi_add hy₁ hy₂),
          ← hliftFi_res i b₁, ← hliftFi_res i b₂,
          ← hφ_bar_spec j y₁ hy₁, ← hφ_bar_spec j y₂ hy₂, map_add,
          (hresM_ring _ _ (hφ_loc_mem j hy₁) (hφ_loc_mem j hy₂)).1]
      map_mul' := fun b₁ b₂ => by
        let i := idx_all j
        set y₁ := liftFi i b₁
        set y₂ := liftFi i b₂
        have hy₁ : PFi i 0 y₁ := hliftFi_int i b₁
        have hy₂ : PFi i 0 y₂ := hliftFi_int i b₂
        have hmul_res : b₁ * b₂ = resFi i (y₁ * y₂) := by
          rw [((hresFi_map i).2.2.1 y₁ y₂ hy₁ hy₂).2.1, hliftFi_res i b₁, hliftFi_res i b₂]
        rw [hmul_res, ← hφ_bar_spec j (y₁ * y₂) (by simpa using hPFi_mul hy₁ hy₂),
          ← hliftFi_res i b₁, ← hliftFi_res i b₂,
          ← hφ_bar_spec j y₁ hy₁, ← hφ_bar_spec j y₂ hy₂, map_mul,
          (hresM_ring _ _ (hφ_loc_mem j hy₁) (hφ_loc_mem j hy₂)).2.1] }

  have hφ_alg : ∀ (j : Fin (q - 1)) (a : k_L),
      φ_bar j (algebraMap k_L (k_Fi (idx_all j)) a) = ι_res a := by
    intro j a
    let i := idx_all j
    set x := liftL a
    have hx : PL 0 x := hliftL_int a
    have hinc_Fi : PFi i 0 (IntermediateField.inclusion (D_orb.get i).le x) := by
      rcases hx with hx0 | hx
      · left; rw [hx0, map_zero]
      · right
        rw [hValAlgFiL i x]
        exact mul_nonneg (by omega) hx
    have halg_eq : algebraMap k_L (k_Fi i) a =
        resFi i (IntermediateField.inclusion (D_orb.get i).le x) := by
      rw [← hliftL_res a, ← (hFi_alg i).2.2 x hx]
    change φ_bar_fun j (algebraMap k_L (k_Fi i) a) = ι_res a
    rw [halg_eq, ← hφ_bar_spec j _ hinc_Fi]
    have hφ_x : φ_loc j (IntermediateField.inclusion (D_orb.get i).le x) =
        IntermediateField.inclusion hLM_C x := by
      dsimp only [φ_loc, RingHom.comp_apply]
      change (σ_all j).symm
        (IntermediateField.inclusion (hFiMC i)
          (IntermediateField.inclusion (D_orb.get i).le x)) =
        IntermediateField.inclusion hLM_C x
      have hcomp : IntermediateField.inclusion (hFiMC i)
          (IntermediateField.inclusion (D_orb.get i).le x) =
          IntermediateField.inclusion hLM_C x := rfl
      rw [hcomp, hσ_symm_L j x]
    rw [hφ_x, hι_res x hx, hliftL_res a]

  
  let U₀ : M_Cˣ :=
    (ϖ_MC ^ k) * (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom ϖ_L)⁻¹
  have hU₀_val : valL F M_C (U₀ : M_C) = 0 := by
    dsimp only [U₀]
    rw [Units.val_mul,
      hval_mul_M _ _ (Units.ne_zero _) (Units.ne_zero _),
      hval_unit_pow M_C ϖ_MC k, hϖ_MC, mul_one,
      hval_inv_M]
    change (k : ℤ) + - valL F M_C (IntermediateField.inclusion hLM_C (ϖ_L : L)) = 0
    rw [hValAlgMCL (ϖ_L : L), hϖ_L, mul_one, add_neg_cancel]
  let U₀_bar : k_M := resM (U₀ : M_C)
  have hU₀_ne : U₀_bar ≠ 0 := by
    intro h0
    rcases (hresM_ker (U₀ : M_C) (hU0_int hU₀_val)).mp h0 with h_zero | h_ge1
    · exact Units.ne_zero U₀ h_zero
    · omega

  have hΘ_gen_pow : ∀ (t' k' : ℕ), k' * t = t' * k →
      ∀ j : Fin (q - 1),
        φ_bar j (resFi (idx_all j) ((Θ_gen t' k' (idx_all j) :
          ((D_orb.get (idx_all j)).field)ˣ) : (D_orb.get (idx_all j)).field)) *
          (U₀_bar ^ t') = (β j) ^ k' := by
    intro t' k' htk j
    let i := idx_all j
    let φ_u : ((D_orb.get i).field)ˣ →* M_Cˣ := Units.map (φ_loc j).toMonoidHom
    have hφ_u_eq : ∀ w : ((D_orb.get i).field)ˣ,
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC i)).toMonoidHom w) =
        φ_u w := fun _ => Units.ext rfl
    have hφ_u_L : ∀ w_L : Lˣ,
        φ_u (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom w_L) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom w_L :=
      fun w_L => Units.ext (hσ_symm_L j (w_L : L))
    have hα_u : φ_u (α_orb i) * (ϖ_MC ^ t) = u_all_0 j := by
      rw [hu_all_0_def j, hφ_u_eq (c'_μ i)]
      dsimp only [α_orb]
      rw [map_mul, map_inv, hφ_u_L c₀]
      ext; push_cast; ring
    have hU₀_mul_ϖL :
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom ϖ_L * U₀ = ϖ_MC ^ k := by
      dsimp only [U₀]
      rw [mul_comm, inv_mul_cancel_right]
    have h_unit_eq : φ_u (Θ_gen t' k' i) * (U₀ ^ t') = (u_all_0 j) ^ k' := by
      dsimp only [Θ_gen]
      rw [map_mul, map_pow, map_pow, hφ_u_L ϖ_L, mul_assoc, ← mul_pow, hU₀_mul_ϖL,
        ← pow_mul, mul_comm k t', ← htk, mul_comm k' t, pow_mul, ← mul_pow, hα_u]
    have hΘ_val0 : valL F (D_orb.get i).field
        ((Θ_gen t' k' i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 0 :=
      (hΘ_gen_val_res t' k' htk i).1
    have hφΘ_val0 : valL F M_C ((φ_u (Θ_gen t' k' i) : M_Cˣ) : M_C) = 0 := by
      change valL F M_C (φ_loc j (Θ_gen t' k' i : (D_orb.get i).field)) = 0
      rw [hφ_loc_val j, hΘ_val0]
    have hφΘ_res : resM ((φ_u (Θ_gen t' k' i) : M_Cˣ) : M_C) =
        φ_bar j (resFi i ((Θ_gen t' k' i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) :=
      hφ_bar_spec j _ (Or.inr (le_of_eq hΘ_val0.symm))
    have hU_pow := hU0_pow U₀ t' hU₀_val
    have hu_pow := hU0_pow (u_all_0 j) k' (hu_all_0_val j)
    have hlhs := hU0_mul hφΘ_val0 hU_pow.1
    have h_res := congrArg (fun w : M_Cˣ => resM (w : M_C)) h_unit_eq
    dsimp only at h_res
    rw [hlhs.2, hφΘ_res, hU_pow.2, hu_pow.2] at h_res
    exact h_res

  have hθ_pow : ∀ j : Fin (q - 1),
      φ_bar j (resFi (idx_all j) ((Θ_orb (idx_all j) : ((D_orb.get (idx_all j)).field)ˣ) :
        (D_orb.get (idx_all j)).field)) * (U₀_bar ^ t) = (β j) ^ k :=
    hΘ_gen_pow t k (Nat.mul_comm k t)

  have h_half : ∀ (t' k' : ℕ), t = 2 * t' → k = 2 * k' →
      ∃ θ'_orb : ∀ i : Fin D_orb.length, k_Fi i,
        ∀ j : Fin (q - 1),
          φ_bar j (θ'_orb (idx_all j)) * (U₀_bar ^ t') = (β j) ^ k' := by
    intro t' k' ht' hk'
    have htk : k' * t = t' * k := by rw [ht', hk']; ring
    refine ⟨fun i => resFi i ((Θ_gen t' k' i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field),
      hΘ_gen_pow t' k' htk⟩

  
  have h_fiber_norm : ∀ (i : Fin D_orb.length) (w : ((D_orb.get i).field)ˣ),
      valL F (D_orb.get i).field (w : (D_orb.get i).field) = 0 →
      (∏ j : Fin (q - 1),
        if h : idx_all j = i then φ_bar j (h ▸ resFi i (w : (D_orb.get i).field)) else 1) =
        ι_res (resL ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L)) := by
    intro i w hw_val
    let c_single : ∀ i' : Fin D_orb.length, ((D_orb.get i').field)ˣ :=
      fun i' => if h : i' = i then h ▸ w else 1
    let u_f : Fin (q - 1) → M_Cˣ := fun j =>
      Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
        (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
          (c_single (idx_all j)))
    have hu_f_spec : ∀ j : Fin (q - 1),
        valL F M_C (u_f j : M_C) = 0 ∧
        resM (u_f j : M_C) =
          if h : idx_all j = i then φ_bar j (h ▸ resFi i (w : (D_orb.get i).field)) else 1 := by
      intro j
      by_cases h : idx_all j = i
      · subst h
        have hc_eq : c_single (idx_all j) = w := dif_pos rfl
        have hu_eq : (u_f j : M_C) = φ_loc j (w : (D_orb.get (idx_all j)).field) := by
          dsimp only [u_f, φ_loc, RingHom.comp_apply]
          rw [hc_eq]
          rfl
        have hval : valL F M_C (u_f j : M_C) = 0 := by
          rw [hu_eq, hφ_loc_val j, hw_val]
        refine ⟨hval, ?_⟩
        rw [dif_pos rfl, hu_eq]
        exact hφ_bar_spec j _ (Or.inr (le_of_eq hw_val.symm))
      · have hc_eq : c_single (idx_all j) = 1 := dif_neg h
        have hu_eq : u_f j = 1 := by
          dsimp only [u_f]
          rw [hc_eq, map_one, map_one]
        rw [hu_eq, dif_neg h, Units.val_one]
        exact ⟨hval1_M, hresM_1⟩
    have hprod_R :
        (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_single i')) =
          Units.map (normLM F (D_orb.get i).le) w := by
      rw [Finset.prod_eq_single i]
      · dsimp only [c_single]
        rw [dif_pos rfl]
      · intro i' _ hi'
        dsimp only [c_single]
        rw [dif_neg hi', map_one]
      · intro habs
        exact False.elim (habs (Finset.mem_univ i))
    have hprod_eq :
        (∏ j : Fin (q - 1), u_f j) =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (Units.map (normLM F (D_orb.get i).le) w) := by
      have h := hν_prod c_single
      rwa [hprod_R] at h
    have hlhs_prod := @hU0_prod (Fin (q - 1)) Finset.univ u_f (fun j _ => (hu_f_spec j).1)
    have hinc_nw_val : valL F M_C
        (IntermediateField.inclusion hLM_C
          ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L)) = 0 := by
      have h := congrArg (fun u_m : M_Cˣ => valL F M_C (u_m : M_C)) hprod_eq
      exact h.symm.trans hlhs_prod.1
    have hnw_val : valL F L ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L) = 0 := by
      have h := hValAlgMCL ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L)
      rw [hinc_nw_val] at h
      have hk_pos : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
      nlinarith
    have hres_eq := congrArg (fun u_m : M_Cˣ => resM (u_m : M_C)) hprod_eq
    dsimp only at hres_eq
    rw [hlhs_prod.2] at hres_eq
    change (∏ j : Fin (q - 1), resM (u_f j : M_C)) =
      resM (IntermediateField.inclusion hLM_C
        ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L)) at hres_eq
    rw [hι_res _ (Or.inr (le_of_eq hnw_val.symm))] at hres_eq
    rw [← hres_eq]
    exact Finset.prod_congr rfl (fun j _ => (hu_f_spec j).2.symm)

  
  have hβ_prod :
      (∏ j : Fin (q - 1), β j) =
        (U₀_bar ^ (u * t)) *
          ι_res (resL (((c₀ ^ (q - 1) * (ϖ_L ^ (u * t)) *
            (∏ i : Fin D_orb.length,
              Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L))) := by
    set W_L : Lˣ :=
      c₀ ^ (q - 1) * (ϖ_L ^ (u * t)) *
        (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹
    have hqu : k * u = q - 1 := Nat.mul_div_cancel' hk_dvd
    have htq : t * (q - 1) = k * (u * t) := by rw [← hqu]; ring
    have hϖ_MC_pow :
        ϖ_MC ^ (t * (q - 1)) =
          (U₀ ^ (u * t)) *
            Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (u * t)) := by
      have h1 : ϖ_MC ^ k =
          U₀ * Units.map (IntermediateField.inclusion hLM_C).toMonoidHom ϖ_L := by
        dsimp only [U₀]
        rw [inv_mul_cancel_right]
      rw [htq, pow_mul, h1, mul_pow, map_pow]
    have hprod_W :
        (∏ j : Fin (q - 1), u_all_0 j) =
          (U₀ ^ (u * t)) *
            Units.map (IntermediateField.inclusion hLM_C).toMonoidHom W_L := by
      rw [hu_all_0_prod]
      change Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (c₀ ^ (q - 1)) *
          (ϖ_MC ^ (t * (q - 1))) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹ =
        (U₀ ^ (u * t)) *
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom W_L
      rw [hϖ_MC_pow]
      dsimp only [W_L]
      rw [map_mul, map_mul, map_inv]
      ext; push_cast; ring
    have hlhs_prod := @hU0_prod (Fin (q - 1)) Finset.univ u_all_0 (fun j _ => hu_all_0_val j)
    have hU_ut := hU0_pow U₀ (u * t) hU₀_val
    have hW_M_eq :
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom W_L =
          (U₀ ^ (u * t))⁻¹ * (∏ j : Fin (q - 1), u_all_0 j) := by
      rw [hprod_W, inv_mul_cancel_left]
    have hW_M_val :
        valL F M_C ((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom W_L : M_Cˣ) : M_C) = 0 := by
      rw [hW_M_eq, Units.val_mul,
        hval_mul_M _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_inv_M (U₀ ^ (u * t)), hU_ut.1, hlhs_prod.1, neg_zero, add_zero]
    have hW_L_val : valL F L (W_L : L) = 0 := by
      have h := hValAlgMCL (W_L : L)
      have hW_M_val' : valL F M_C (IntermediateField.inclusion hLM_C (W_L : L)) = 0 := hW_M_val
      rw [hW_M_val'] at h
      have hk_pos : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
      nlinarith
    have hrhs_mul := hU0_mul hU_ut.1 hW_M_val
    have hres_eq := congrArg (fun u_m : M_Cˣ => resM (u_m : M_C)) hprod_W
    dsimp only at hres_eq
    rw [hlhs_prod.2, hrhs_mul.2, hU_ut.2] at hres_eq
    change (∏ j : Fin (q - 1), β j) =
      (U₀_bar ^ (u * t)) * resM (IntermediateField.inclusion hLM_C (W_L : L)) at hres_eq
    rw [hι_res (W_L : L) (Or.inr (le_of_eq hW_L_val.symm))] at hres_eq
    exact hres_eq

  exact ⟨hΘ_orb_val_res,
    k_M, hField_kM, hFin_kM, ι_res, ψ_M, a_bar, U₀_bar, β, φ_bar,
    hp_kM, hψM_0, hψM_add, ⟨w₀_M, hw₀_M⟩,
    ha0_ne, hU₀_ne, hβ_inj, hβ_ne, hβ_P,
    hφ_alg, hθ_pow, h_half, h_fiber_norm, hβ_prod⟩

theorem ld_ch14_odd_p_linear_poly_root_cofactor_eq_prod (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_M : Type u) [Field k_M] [Fintype k_M]
    (p r_exp q : ℕ) (hp : Nat.Prime p) (hp_ne2 : p ≠ 2)
    (hr_exp_pos : 1 ≤ r_exp) (hq_pow : q = p ^ r_exp)
    (hchar : (p : k_M) = 0)
    (ψ_M : k_M → Ω F)
    (hψ_0 : ψ_M 0 = 1)
    (hψ_add : ∀ w₁ w₂ : k_M, ψ_M (w₁ + w₂) = ψ_M w₁ * ψ_M w₂)
    (hψ_ne : ∃ w₀ : k_M, ψ_M w₀ ≠ 1)
    (a_bar : Fin r_exp → k_M)
    (β : Fin (q - 1) → k_M)
    (hβ_inj : Function.Injective β)
    (hβ_ne : ∀ j : Fin (q - 1), β j ≠ 0)
    (hβ_P : ∀ j : Fin (q - 1), ∀ z : k_M,
      ψ_M (β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ (p ^ (m : ℕ))))) = 1) :
    ∀ j₀ : Fin (q - 1),
      β j₀ * (∏ j ∈ Finset.univ.erase j₀, (β j₀ - β j)) =
        ∏ j : Fin (q - 1), β j :=
by
  suffices h_gen : ∀ (R : Type) [Field R] [CharZero R] (ψ_M : k_M → R),
      ψ_M 0 = 1 →
      (∀ w₁ w₂ : k_M, ψ_M (w₁ + w₂) = ψ_M w₁ * ψ_M w₂) →
      (∃ w₀ : k_M, ψ_M w₀ ≠ 1) →
      (∀ j : Fin (q - 1), ∀ z : k_M,
        ψ_M (β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ (p ^ (m : ℕ))))) = 1) →
      ∀ j₀ : Fin (q - 1),
        β j₀ * (∏ j ∈ Finset.univ.erase j₀, (β j₀ - β j)) =
          ∏ j : Fin (q - 1), β j by
    exact h_gen (Ω F) ψ_M hψ_0 hψ_add hψ_ne hβ_P
  clear * - hp hp_ne2 hr_exp_pos hq_pow hchar hβ_inj hβ_ne
  intro R _ _ ψ_M hψ_0 hψ_add hψ_ne hβ_P
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  have hring : ringChar k_M = p := by
    have hdvd : ringChar k_M ∣ p := (ringChar.spec k_M p).mp hchar
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | h_eq
    · exfalso
      have h0 : ((1 : ℕ) : k_M) = 0 := (ringChar.spec k_M 1).mpr (h1 ▸ dvd_refl _)
      rw [Nat.cast_one] at h0
      exact one_ne_zero h0
    · exact h_eq
  haveI : CharP k_M p := CharP.mk (fun x => by rw [← hring]; exact ringChar.spec k_M x)
  have hfrob_zero : ∀ n : ℕ, (0 : k_M) ^ (p ^ n) = 0 :=
    fun n => zero_pow (pow_ne_zero n hp.ne_zero)
  have hfrob_add : ∀ (n : ℕ) (x y : k_M), (x + y) ^ (p ^ n) = x ^ (p ^ n) + y ^ (p ^ n) :=
    fun n x y => add_pow_char_pow x y p n
  have hfrob_inj : ∀ n : ℕ, Function.Injective (fun x : k_M => x ^ (p ^ n)) := by
    intro n x y hxy
    dsimp at hxy
    have hsub : (x - y) ^ (p ^ n) + y ^ (p ^ n) = y ^ (p ^ n) := by
