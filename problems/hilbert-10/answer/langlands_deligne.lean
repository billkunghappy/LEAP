  have hSp : S p = IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ (2 * w - w ^ 2)) := by
    dsimp [S]
    have hsum : (∑ k ∈ Finset.range p, (2 * τ k w - (τ k w) ^ 2)) =
        ∑ k ∈ Finset.range p, τ k (2 * w - w ^ 2) := by
      refine Finset.sum_congr rfl fun k _ => ?_
      simp only [map_sub, map_mul, map_ofNat, map_pow]
    rw [hsum, ← hτ_tr (2 * w - w ^ 2)]
  have hδ_incl : IntermediateField.inclusion hE'K₁ δ_E = (2 * P p - (P p) ^ 2) - S p := by
    dsimp [δ_E]
    simp only [map_sub, map_mul, map_ofNat, map_pow, hPp, hSp]
  rw [← hδ_incl] at hQp
  rcases hQp with h0 | hge
  · left
    exact (IntermediateField.inclusion hE'K₁).injective (h0.trans (map_zero _).symm)
  · right
    rw [hval_E'K₁ δ_E] at hge
    exact hge

theorem ld_wild_odd_unramified_galois_lift_and_k1_norm_quad (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (c : L) (d : M₁') (r : ℕ → L)
    (hd_val : valL F M₁' d = 0)
    (hd_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)))
    (hd_sep :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∀ j k : ℕ, j < k → k < p → (σ₀ ^ k) d - (σ₀ ^ j) d ≠ 0)
    (hr_val : ∀ i : ℕ, r i = 0 ∨ (2 * (T : ℤ) + 1) ≤ valL F L (r i))
    (hPd_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
        (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
          ∑ i ∈ Finset.range p,
            Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    (∀ x : E', (x = 0 ∨ -((T - 1 : ℕ) : ℤ) ≤ valL F E' x) →
      normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d) -
        (x ^ p - x + IntermediateField.inclusion hLE' c) = 0 ∨
        (T : ℤ) ≤ valL F E'
          (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d) -
            (x ^ p - x + IntermediateField.inclusion hLE' c))) ∧
    (∀ (m : ℕ), 1 ≤ m → ∀ w : K₁, (w = 0 ∨ (m : ℤ) ≤ valL F K₁ w) →
      let u_E := normLM F hE'K₁ (1 + w) - 1
      (2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2) = 0 ∨
        (3 * (m : ℤ)) ≤ valL F E' ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2))) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  obtain ⟨hnorm_x_d, τ, hτ_val, hτ_norm, hτ_tr⟩ :=
    ld_wild_odd_unramified_k1_galois_lift_and_aut_package F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hdegE'K₁ T hT_ge2
      hp_val hval_LE' hval_E'K₁ hval_M₁'K₁ hDiamond_M₁'
      σ₀ c d r hd_val hd_tr_top hd_sep hPd_eq
  refine ⟨?_, ?_⟩
  · exact ld_wild_odd_unramified_k1_norm_x_add_d_congruence F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd T hT_ge2 hval_LE'
      σ₀ c d r hr_val hPd_eq hnorm_x_d
  · exact ld_wild_odd_unramified_k1_quad_norm_trace_congruence F E' K₁
      hE'K₁ hval_E'K₁ p τ hτ_val hτ_norm hτ_tr

theorem ld_wild_odd_unramified_artin_schreier_and_galois_lift (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁',
      valL F L (normLM F hLM₁' z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hnorm_lin_E'K₁ : ∀ (d : ℕ), 1 ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w))))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (y₁ : M₁') (hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (w₁ : K₁) (hw₁_int : w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) (hw₁_tr : traceLM F hE'K₁ w₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (hσ₀_L : ∀ x : L,
      σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hσ₀_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
      ∏ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    ∃ (c : L) (d : M₁'),
      valL F L c = 0 ∧
      valL F M₁' d = 0 ∧
      (d ^ p - d - IntermediateField.inclusion hLM₁' c = 0 ∨
        (2 * (T : ℤ) + 1) ≤ valL F M₁' (d ^ p - d - IntermediateField.inclusion hLM₁' c)) ∧
      (σ₀ (d ^ p) - d ^ p - 1 = 0 ∨
        ((T - T / 2 : ℕ) : ℤ) ≤ valL F M₁' (σ₀ (d ^ p) - d ^ p - 1)) ∧
      (∀ j ∈ Finset.Icc 1 (p - 2),
        traceLM F hLM₁' (d ^ j) = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ j))) ∧
      (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L))) ∧
      (traceLM F hLM₁' (d ^ p) - (p : L) * c = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ p) - (p : L) * c)) ∧
      (∀ x : E', (x = 0 ∨ -((T - 1 : ℕ) : ℤ) ≤ valL F E' x) →
        normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d) -
          (x ^ p - x + IntermediateField.inclusion hLE' c) = 0 ∨
          (T : ℤ) ≤ valL F E'
            (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d) -
              (x ^ p - x + IntermediateField.inclusion hLE' c))) ∧
      (∀ (m : ℕ), 1 ≤ m → ∀ w : K₁, (w = 0 ∨ (m : ℤ) ≤ valL F K₁ w) →
        let u_E := normLM F hE'K₁ (1 + w) - 1
        (2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2) = 0 ∨
          (3 * (m : ℤ)) ≤ valL F E' ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2))) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  have hp_odd' : p ≠ 2 := by rw [hWild]; exact hp_odd
  obtain ⟨hσ₀_pow, c, d, _, hd_val, hd_AS, _, hd_pow_frob, hd_sep⟩ :=
    ld_wild_odd_unramified_as_iterate_and_frob_shift F L M₁' hLM₁'
      p hPrime T hT_ge2 hp_val hval_LM₁' htr_bound_LM₁'
      y₁ hy₁_int hy₁_tr σ₀ hσ₀_L hσ₀_val hσ₀_tr
  obtain ⟨hc_val, hd_tr_low, hd_tr_top, hd_tr_pow, r, hr_val, hPd_eq⟩ :=
    ld_wild_odd_unramified_as_poly_and_power_traces F L M₁' hLM₁'
      p hPrime hp_odd' T hT_ge2 hval_LM₁' hval_norm_LM₁' htr_bound_LM₁'
      y₁ hy₁_tr σ₀ hσ₀_L hσ₀_val hσ₀_tr hσ₀_norm hσ₀_pow
      c d hd_val hd_AS hd_sep
  obtain ⟨hZE_cong_all, hquad_E'K₁⟩ :=
    ld_wild_odd_unramified_galois_lift_and_k1_norm_quad F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd' hdegE'K₁ T hT_ge2
      hp_val hval_LE' hval_E'K₁ hval_M₁'K₁ hDiamond_M₁'
      σ₀ c d r hd_val hd_tr_top (fun j k hjk hkp => (hd_sep j k hjk hkp).1)
      hr_val hPd_eq
  exact ⟨c, d, hc_val, hd_val, hd_AS, hd_pow_frob,
    hd_tr_low, hd_tr_top, hd_tr_pow, hZE_cong_all, hquad_E'K₁⟩

theorem ld_wild_odd_unramified_norm_trace_vanishing_and_val (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((condExp F L νE' - condExp F L νE' / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (σ₀ : M₁' ≃ₐ[F] M₁') (j₀ : ℕ) (hj₀_pos : 0 < j₀)
    (hj₀_lt : j₀ < Module.finrank L (IntermediateField.extendScalars hLE'))
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hσ₀_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
      ∏ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hq_norm_tr_E' : ∀ (h : ℕ) (y : E'),
      (y = 0 ∨
        (((condExp F L νE' +
          Module.finrank L (IntermediateField.extendScalars hLE') * h) / 2 : ℕ) : ℤ) ≤
          valL F E' y) →
      let u := normLM F hLE' (1 + y) - 1
      let q_y := (2 : E')⁻¹ * (2 * y - y ^ 2)
      (2 * u - u ^ 2) - (traceLM F hLE' (2 * y - y ^ 2) + 2 * normLM F hLE' q_y) = 0 ∨
        ((condExp F L νE' + h : ℕ) : ℤ) ≤
          valL F L ((2 * u - u ^ 2) -
            (traceLM F hLE' (2 * y - y ^ 2) + 2 * normLM F hLE' q_y)))
    (hq_norm_tr_K₁ : ∀ (h : ℕ) (w : K₁),
      (w = 0 ∨
        (((condExp F L νE' +
          Module.finrank L (IntermediateField.extendScalars hLE') * h) / 2 : ℕ) : ℤ) ≤
          valL F K₁ w) →
      let u := normLM F hM₁'K₁ (1 + w) - 1
      let q_w := (2 : K₁)⁻¹ * (2 * w - w ^ 2)
      (2 * u - u ^ 2) - (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w) = 0 ∨
        ((condExp F L νE' + h : ℕ) : ℤ) ≤
          valL F M₁' ((2 * u - u ^ 2) -
            (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w)))
    (c_ν₀ : Lˣ)
    (hc_ν₀_val : valL F L (c_ν₀ : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν₀_stat : ∀ u : L,
      (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
          ψ (((c_ν₀⁻¹ : Lˣ) : L) * (2 * u - u ^ 2))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let T := condExp F L νE'
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ c_ν : Lˣ,
      valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ ∧
      (∀ u : L, (u = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F L u) →
        ∀ hu : 1 + u ≠ 0,
          (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ (2 * j₀) =
            (ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * u - u ^ 2)))⁻¹) ∧
      (∀ (m : ℕ), 1 ≤ m → ∀ z : M₁', (z = 0 ∨ (m : ℤ) ≤ valL F M₁' z) →
        let u_z := normLM F hLM₁' (1 + z) - 1
        (u_z = 0 ∨ (m : ℤ) ≤ valL F L u_z) ∧
        ((2 * u_z - u_z ^ 2) - traceLM F hLM₁' (2 * z - z ^ 2) = 0 ∨
          (3 * (m : ℤ)) ≤ valL F L ((2 * u_z - u_z ^ 2) - traceLM F hLM₁' (2 * z - z ^ 2)))) ∧
      (∀ w : E', (w = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F E' w) →
        ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLE' w + 2 * normLM F hLE' w)) = 1) ∧
