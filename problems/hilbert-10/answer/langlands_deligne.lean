    have ha_ne0 : (Nat.gcdA j p : A) ≠ 0 := right_ne_zero_of_mul hprod_ne0
    have hprod_val : valL F A ((j : ℕ) : A) + valL F A (Nat.gcdA j p : A) = 0 := by
      rw [← hval_mul_A _ _ hj_ne0 ha_ne0, h1t_eq, h1t_val0]
