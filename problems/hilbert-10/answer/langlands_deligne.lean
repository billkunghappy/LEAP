          change toExtendScalars F hAK (act s.1 (fromKA x + fromKA y)) = _
          rw [((hact_ring s.1).2.2 (fromKA x) (fromKA y)).1, map_add]
        commutes' := fun y => by
          change toExtendScalars F hAK (act s.1 (IntermediateField.inclusion hAK y)) =
            toExtendScalars F hAK (IntermediateField.inclusion hAK y)
          rw [hS_fix s y] }
    have hΦ_inj : Function.Injective Φ := by
      intro s₁ s₂ hs
      have h_eq : (s₁.1)⁻¹ * s₂.1 = 1 := by
        apply hact_faithful
        intro w
        have hw : act s₁.1 w = act s₂.1 w :=
          congrArg fromKA (AlgEquiv.congr_fun hs (toExtendScalars F hAK w))
        calc act ((s₁.1)⁻¹ * s₂.1) w = act (s₁.1)⁻¹ (act s₂.1 w) := hact_mul _ _ w
          _ = act (s₁.1)⁻¹ (act s₁.1 w) := by rw [hw]
          _ = act ((s₁.1)⁻¹ * s₁.1) w := (hact_mul _ _ w).symm
          _ = w := by rw [inv_mul_cancel, hact_one]
      apply Subtype.ext
      exact inv_mul_eq_one.mp h_eq
    have hΦ_card : Fintype.card S = Fintype.card G_AK := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hS_card,
        IsGalois.card_aut_eq_finrank A K_A]
    let e_Φ : S ≃ G_AK := Equiv.ofBijective Φ
      ((Fintype.bijective_iff_injective_and_card Φ).mpr ⟨hΦ_inj, hΦ_card⟩)
    refine ⟨fun w => ?_, fun w => ?_⟩
    · have h1 := congrArg fromKA
        (trace_eq_sum_automorphisms (K := A) (L := K_A) (toExtendScalars F hAK w))
      have h2 : fromKA (∑ σ : G_AK, σ (toExtendScalars F hAK w)) =
          ∑ σ : G_AK, fromKA (σ (toExtendScalars F hAK w)) :=
        map_sum fromKA (fun σ : G_AK => σ (toExtendScalars F hAK w)) Finset.univ
      rw [h2, ← Equiv.sum_comp e_Φ (fun σ : G_AK => fromKA (σ (toExtendScalars F hAK w)))] at h1
      exact h1
    · have h1 := congrArg fromKA
        (Algebra.norm_eq_prod_automorphisms A (toExtendScalars F hAK w))
      have h2 : fromKA (∏ σ : G_AK, σ (toExtendScalars F hAK w)) =
          ∏ σ : G_AK, fromKA (σ (toExtendScalars F hAK w)) :=
        map_prod fromKA (fun σ : G_AK => σ (toExtendScalars F hAK w)) Finset.univ
      rw [h2, ← Equiv.prod_comp e_Φ (fun σ : G_AK => fromKA (σ (toExtendScalars F hAK w)))] at h1
      exact h1
  obtain ⟨hact_trace_MCK, hact_norm_MCK⟩ :=
    hSubgroupTraceNorm M_C hM_CK hGalMCK C (fun c z => (hC_mem_iff c.1).mp c.2 z) hcard_C
  have hSep_iff : ∀ (A B : IntermediateField F (AlgebraicClosure F)) (hAB : A ≤ B),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) ↔
        B ≤ IntermediateField.restrictScalars F (separableClosure A (AlgebraicClosure F)) := by
    intro A B hAB
    let S := IntermediateField.extendScalars hAB
    have hmin : ∀ x : S, IsSeparable A x.1 ↔ IsSeparable A x := by
      intro x
      change (minpoly A (S.val x)).Separable ↔ (minpoly A x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hAB).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable A S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hGalEK : IsGaloisExt F E K := by
    refine ⟨hEK, hGal.2.1, ?_, ?_⟩
    · intro σ hσ τ hτ
      exact hGal.2.2.1 σ (IntermediateField.fixingSubgroup_le hLE hσ) τ hτ
    · intro h
      rw [hSep_iff]
      intro z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      have hzL : IsSeparable L z := by
        have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) hz
        exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
      exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLE)) hzL
  have hfinrank_tower : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      Module.finrank F A * Module.finrank A (IntermediateField.extendScalars hAB) =
        Module.finrank F B := by
    intro A B _ _ hAB
    let B_A := IntermediateField.extendScalars hAB
    let e_BA : B ≃ₐ[F] B_A :=
      { toExtendScalars F hAB with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F B_A := Module.Finite.equiv e_BA.toLinearEquiv
    haveI : IsScalarTower F A B_A := IsScalarTower.of_algebraMap_eq fun _ => rfl
    rw [Module.finrank_mul_finrank F A B_A]
    exact (LinearEquiv.finrank_eq e_BA.toLinearEquiv).symm
  have hcard_H_EK : Nat.card H = Module.finrank E (IntermediateField.extendScalars hEK) := by
    have h1 := hfinrank_tower L M_C hLM_C
    have h2 := hfinrank_tower M_C K hM_CK
    have h3 := hfinrank_tower L E hLE
    have h4 := hfinrank_tower E K hEK
    have hposL : 0 < Module.finrank F L := Module.finrank_pos
    have hpos_q : 0 < q := by omega
    rw [hcard_H]
    nlinarith
  have hact_trace_EK : ∀ w : K,
      IntermediateField.inclusion hEK (traceLM F hEK w) = ∑ h : H, act h.1 w :=
    (hSubgroupTraceNorm E hEK hGalEK H hact_incl_E hcard_H_EK).1
  have h_act_MC_mem : ∀ (g : G) (z : M_C),
      ((act g (IntermediateField.inclusion hM_CK z) : K) : AlgebraicClosure F) ∈ M_C := by
    intro g z
    let w : K := act g (IntermediateField.inclusion hM_CK z)
    have hw_fix : ∀ c ∈ C, act c w = w := by
      intro c hc
      have hc' : g⁻¹ * c * g ∈ C := by
        simpa [mul_assoc] using ‹C.Normal›.conj_mem c hc g⁻¹
      calc act c w = act (c * g) (IntermediateField.inclusion hM_CK z) :=
            (hact_mul c g _).symm
        _ = act (g * (g⁻¹ * c * g)) (IntermediateField.inclusion hM_CK z) := by
            congr 1; group
        _ = act g (act (g⁻¹ * c * g) (IntermediateField.inclusion hM_CK z)) :=
            hact_mul g _ _
        _ = w := by rw [(hC_mem_iff (g⁻¹ * c * g)).mp hc' z]
    obtain ⟨z', hz'⟩ := (hC_fixed_iff w).mp hw_fix
    have hcoe : (w : AlgebraicClosure F) = (z' : AlgebraicClosure F) :=
      congrArg Subtype.val hz'.symm
    rw [hcoe]
    exact z'.2
  let act_MC : H → M_C → M_C := fun h z =>
    ⟨((act h.1 (IntermediateField.inclusion hM_CK z) : K) : AlgebraicClosure F),
      h_act_MC_mem h.1 z⟩
  have hact_MC_compat : ∀ (h : H) (z : M_C),
      IntermediateField.inclusion hM_CK (act_MC h z) =
        act h.1 (IntermediateField.inclusion hM_CK z) := fun _ _ => rfl
  have hinj_MCK : Function.Injective (IntermediateField.inclusion hM_CK) :=
    (IntermediateField.inclusion hM_CK).injective
  have hact_MC_one : ∀ z : M_C, act_MC 1 z = z := by
    intro z
    apply hinj_MCK
    rw [hact_MC_compat, Subgroup.coe_one, hact_one]
  have hact_MC_mul : ∀ (h₁ h₂ : H) (z : M_C), act_MC (h₁ * h₂) z = act_MC h₁ (act_MC h₂ z) := by
    intro h₁ h₂ z
    apply hinj_MCK
    rw [hact_MC_compat, Subgroup.coe_mul, hact_mul, ← hact_MC_compat, ← hact_MC_compat]
  have hact_MC_ring : ∀ h : H,
      act_MC h 0 = 0 ∧ act_MC h 1 = 1 ∧
      (∀ z₁ z₂ : M_C,
        act_MC h (z₁ + z₂) = act_MC h z₁ + act_MC h z₂ ∧
        act_MC h (z₁ * z₂) = act_MC h z₁ * act_MC h z₂ ∧
        act_MC h (-z₁) = -act_MC h z₁) := by
    intro h
    refine ⟨?_, ?_, fun z₁ z₂ => ⟨?_, ?_, ?_⟩⟩
    · apply hinj_MCK
      rw [hact_MC_compat, map_zero, (hact_ring h.1).1]
    · apply hinj_MCK
      rw [hact_MC_compat, map_one, (hact_ring h.1).2.1]
    · apply hinj_MCK
      rw [hact_MC_compat, map_add, map_add, hact_MC_compat, hact_MC_compat,
        ((hact_ring h.1).2.2 (IntermediateField.inclusion hM_CK z₁) (IntermediateField.inclusion hM_CK z₂)).1]
    · apply hinj_MCK
      rw [hact_MC_compat, map_mul, map_mul, hact_MC_compat, hact_MC_compat,
        ((hact_ring h.1).2.2 (IntermediateField.inclusion hM_CK z₁) (IntermediateField.inclusion hM_CK z₂)).2.1]
    · apply hinj_MCK
      rw [hact_MC_compat, map_neg, map_neg, hact_MC_compat,
        ((hact_ring h.1).2.2 (IntermediateField.inclusion hM_CK z₁) 0).2.2]
  have hact_MC_incl : ∀ (h : H) (x : L),
      act_MC h (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x := by
    intro h x
    apply hinj_MCK
    rw [hact_MC_compat]
    exact hact_incl_L h.1 x
  let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
  let e_MC : M_C ≃ₐ[F] M_C' :=
    { toExtendScalars F hLM_C with
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLM_C).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  let fromMC : M_C' →+* M_C := e_MC.symm.toRingHom
  haveI : FiniteDimensional F M_C' := Module.Finite.equiv e_MC.toLinearEquiv
  haveI : IsScalarTower F L M_C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L M_C' := Module.Finite.of_restrictScalars_finite F L M_C'
  haveI : Algebra.IsSeparable L M_C' := hMin.1.2.2.2 hLM_C
  have hGalMC' : IsGalois L ↥M_C' := by
    refine helper_isGalois L (AlgebraicClosure F) M_C' (fun σ τ hτ => ?_)
    let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
    let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
    have hτMC : τ_F.1 ∈ M_C.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hLM_C).mpr hx)
    have hconjMC : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
      hMin.1.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτMC
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjMC
    exact hconjMC x ((IntermediateField.mem_extendScalars hLM_C).mp hx)
  haveI : IsGalois L ↥M_C' := hGalMC'
  let G_LMC := (M_C' ≃ₐ[L] M_C')
  letI : Fintype G_LMC := AlgEquiv.fintype L M_C'
  let Ψ : H → G_LMC := fun h =>
    { toFun := fun x => toExtendScalars F hLM_C (act_MC h (fromMC x))
      invFun := fun x => toExtendScalars F hLM_C (act_MC h⁻¹ (fromMC x))
      left_inv := fun x => by
        change toExtendScalars F hLM_C (act_MC h⁻¹ (act_MC h (fromMC x))) = x
        rw [← hact_MC_mul, inv_mul_cancel, hact_MC_one]
        rfl
      right_inv := fun x => by
        change toExtendScalars F hLM_C (act_MC h (act_MC h⁻¹ (fromMC x))) = x
        rw [← hact_MC_mul, mul_inv_cancel, hact_MC_one]
        rfl
      map_mul' := fun x y => by
        change toExtendScalars F hLM_C (act_MC h (fromMC x * fromMC y)) = _
        rw [((hact_MC_ring h).2.2 (fromMC x) (fromMC y)).2.1, map_mul]
      map_add' := fun x y => by
        change toExtendScalars F hLM_C (act_MC h (fromMC x + fromMC y)) = _
        rw [((hact_MC_ring h).2.2 (fromMC x) (fromMC y)).1, map_add]
      commutes' := fun x => by
        change toExtendScalars F hLM_C (act_MC h (IntermediateField.inclusion hLM_C x)) =
          toExtendScalars F hLM_C (IntermediateField.inclusion hLM_C x)
        rw [hact_MC_incl h x] }
  have hact_MC_val : ∀ (h : H) (z : M_C), valL F M_C (act_MC h z) = valL F M_C z := by
    intro h z
    let ψ_h : M_C ≃ₐ[F] M_C := e_MC.trans (((Ψ h).restrictScalars F).trans e_MC.symm)
    have hψ : ψ_h z = act_MC h z := rfl
    unfold valL relVal
    rw [← hψ, Algebra.norm_eq_of_algEquiv ψ_h z]
  have hΨ_inj : Function.Injective Ψ := by
    intro h₁ h₂ hs
    let h₀ : H := h₁⁻¹ * h₂
    have hh₀_C : h₀.1 ∈ C := by
      rw [hC_mem_iff]
      intro z
      have hz : act_MC h₁ z = act_MC h₂ z :=
        congrArg fromMC (AlgEquiv.congr_fun hs (toExtendScalars F hLM_C z))
      have hh₀_z : act_MC h₀ z = z := by
        calc act_MC (h₁⁻¹ * h₂) z = act_MC h₁⁻¹ (act_MC h₂ z) := hact_MC_mul _ _ z
          _ = act_MC h₁⁻¹ (act_MC h₁ z) := by rw [hz]
          _ = act_MC (h₁⁻¹ * h₁) z := (hact_MC_mul _ _ z).symm
          _ = z := by rw [inv_mul_cancel, hact_MC_one]
      rw [← hact_MC_compat h₀ z, hh₀_z]
    have hh₀_eq1 : h₀.1 = 1 :=
      hZ_H h₀.1 h₀.2 (fun c hc => hC_ab h₀.1 hh₀_C c hc)
    apply Subtype.ext
    exact inv_mul_eq_one.mp hh₀_eq1
  have hΨ_card : Fintype.card H = Fintype.card G_LMC := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hcard_H,
      IsGalois.card_aut_eq_finrank L M_C']
  let e_Ψ : H ≃ G_LMC := Equiv.ofBijective Ψ
    ((Fintype.bijective_iff_injective_and_card Ψ).mpr ⟨hΨ_inj, hΨ_card⟩)
  have hact_MC_trace : ∀ z : M_C,
      IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ h : H, act_MC h z := by
    intro z
    have h1 := congrArg fromMC
      (trace_eq_sum_automorphisms (K := L) (L := M_C') (toExtendScalars F hLM_C z))
    have h2 : fromMC (∑ σ : G_LMC, σ (toExtendScalars F hLM_C z)) =
        ∑ σ : G_LMC, fromMC (σ (toExtendScalars F hLM_C z)) :=
      map_sum fromMC (fun σ : G_LMC => σ (toExtendScalars F hLM_C z)) Finset.univ
    rw [h2, ← Equiv.sum_comp e_Ψ (fun σ : G_LMC => fromMC (σ (toExtendScalars F hLM_C z)))] at h1
    exact h1
  exact ⟨hp_prime, ⟨r_exp, hr_exp_pos, hq_eq⟩, hExpMCK, hFrobSurjL, hFrobSurjLp, hFrobSurjMC,
    G, inferInstance, inferInstance, C, H, act, act_MC,
    hC_norm, hC_ab, hcard_C, hcard_H, hH_gt1, hC_exp, hG_mul, hZ_H, hC_min_norm,
    hact_one, hact_mul, hact_ring, hact_incl_L, hact_faithful, hact_val,
    hC_mem_iff, hC_fixed_iff, hact_trace_MCK, hact_norm_MCK, hact_trace_EK, hact_incl_E,
    hact_MC_one, hact_MC_mul, hact_MC_ring, hact_MC_incl, hact_MC_val,
    hact_MC_compat, hact_MC_trace, hLift_to_G, hLift_from_G⟩

theorem ld_ch14_ef_finrank_and_residue_roots_package (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hp_prime : Nat.Prime (p F))
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp)
    (hq_eq : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK)) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    1 < q ∧
    ((p F : K) = 0 ∨ 1 ≤ valL F K (p F : K)) ∧
    (∃ (e_MCK f_MCK : ℕ),
      1 ≤ e_MCK ∧
      1 ≤ f_MCK ∧
      e_MCK * f_MCK = q ∧
      resDeg F K = f_MCK * resDeg F M_C ∧
      (∀ w : K, valL F M_C (normLM F hM_CK w) = (f_MCK : ℤ) * valL F K w) ∧
      (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (e_MCK : ℤ) * valL F M_C z)) ∧
    (∀ (σ τ : K →+* K),
      (∀ w : K, valL F K (σ w) = valL F K w) →
      (∀ w : K, valL F K (τ w) = valL F K w) →
      ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
        (σ (τ w) - τ (σ w) = 0 ∨ 1 ≤ valL F K (σ (τ w) - τ (σ w)))) ∧
    (∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ w₁ : K, (w₁ = 0 ∨ 0 ≤ valL F K w₁) ∧
        (w - w₁ ^ q = 0 ∨ 1 ≤ valL F K (w - w₁ ^ q))) ∧
    (∀ u : K, (u = 0 ∨ 0 ≤ valL F K u) →
      (u ^ (p F) - 1 = 0 ∨ 1 ≤ valL F K (u ^ (p F) - 1)) →
      (u - 1 = 0 ∨ 1 ≤ valL F K (u - 1))) ∧
    (∀ (α : Type u) [Fintype α] (m n : ℕ), 0 < m →
      ∀ u : α → K,
        (∀ a : α, u a = 0 ∨ 0 ≤ valL F K (u a)) →
        (∀ a : α, (u a) ^ m - 1 = 0 ∨ 1 ≤ valL F K ((u a) ^ m - 1)) →
        (∀ a : α, (u a) ^ n - 1 = 0 ∨ 1 ≤ valL F K ((u a) ^ n - 1)) →
        (∀ a₁ a₂ : α, (u a₁ - u a₂ = 0 ∨ 1 ≤ valL F K (u a₁ - u a₂)) → a₁ = a₂) →
        Fintype.card α ≤ m.gcd n) ∧
    (∀ (k e_MCL e_KE : ℕ),
      1 ≤ k →
      Nat.Coprime k q →
      1 ≤ e_MCL → e_MCL ≤ k →
      1 ≤ e_KE → e_KE ≤ k →
      k ∣ q * e_MCL →
      (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z) →
      (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (e_MCL : ℤ) * valL F L x) →
      (∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (e_KE : ℤ) * valL F E y) →
      e_MCL = k ∧
      e_KE = k ∧
      resDeg F E = resDeg F L) :=
by
  have h_valL_props : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L],
      0 < resDeg F L ∧
      (∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x) ∧
      valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) := by
    clear! L K M_C E hp_prime r_exp
    intro L _
    have halg : ∀ z : L,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F L = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq L.val L.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F L (-1) = 0 := by
      have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : L) * (-1 : L) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : L) = (-1 : L) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q : ℤ := valL F L x
        set r : ℤ := relVal F L x % f
        have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F L := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F L 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval1 : valL F L 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg1 : valL F L (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
      intro x
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L) := by
      intro u
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m := by
      intro m
      refine ⟨ϖL ^ m, ?_⟩
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv, hrel_zpow ϖL m, hrel_ϖL, mul_comm]
    have hval_add : ∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : L,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
