  have hConjBridge : ∀ γ : H,
      ∃ (S_tγ : IntermediateField F (AlgebraicClosure F))
        (hLS_tγ : L ≤ S_tγ) (hM₁_Stγ : M₁ ≤ S_tγ) (hS_tγMC : S_tγ ≤ M_C)
        (χ_tγ : relWeil F S_tγ →* (Ω F)ˣ),
        χ_tγ ^ (p F) = 1 ∧
        restrictWeilChar F (hS_tγMC.trans hM_CK) χ_tγ = 1 ∧
        (∃ hgE' : S_tγ ≤ E ⊔ S_tγ, restrictWeilChar F hgE' χ_tγ = 1) ∧
        restrictWeilChar F hS_tγMC χ_tγ ≠ 1 ∧
        tateEpsUnit F S_tγ (recChar F rec S_tγ χ_tγ) (traceChar F hLS_tγ ψ) =
          tateEpsUnit F S_t (recChar F rec S_t χ_St) (traceChar F hLS_t ψ) ∧
        tateEpsUnit F S_tγ
            (recChar F rec S_tγ (χ_tγ * restrictWeilChar F hLS_tγ χL_ext))
            (traceChar F hLS_tγ ψ) =
          tateEpsUnit F S_t
            (recChar F rec S_t (χ_St * restrictWeilChar F hLS_t χL_ext))
