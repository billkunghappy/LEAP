             ((LinearMap.proj b).comp T)) =
          if π_E w = 1 then (χF' w : Ω F) else 0 := by
      intro b
      have h_comm : LinearMap.trace (Ω F) (Q_E → Ω F)
          ((LinearMap.single (Ω F) (fun _ : Q_E => Ω F) b).comp
            ((LinearMap.proj b).comp T)) =
