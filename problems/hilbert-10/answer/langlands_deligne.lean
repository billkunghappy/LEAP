          ring
    intro z
    by_cases hz : z = 0
    · rw [hz, map_zero, hval0_K, hval0_MC]
    · apply mul_left_cancel₀ hℓ_int_ne
      rw [← hval_norm (IntermediateField.inclusion hM_CK z), hnorm_inc z, hval_pow_MC z ℓ hz]

  
  have hL_le_MC : ∀ σ ∈ L.fixingSubgroup, σ ∈ M_C.fixingSubgroup := by
