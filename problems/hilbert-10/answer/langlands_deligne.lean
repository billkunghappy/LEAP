    apply htr_LE' (bE' : ℤ) (- (x_star ^ 2))
    right
    have hx2_ne0 : x_star ^ 2 ≠ 0 := pow_ne_zero 2 hx_star_ne0
    have hx2_val : valL F E' (- (x_star ^ 2)) = 2 * (t : ℤ) := by
      rw [hval_neg_E', sq, hval_mul_E' x_star x_star hx_star_ne0 hx_star_ne0, hx_star_val]
      ring
    rw [hx2_val, hp_sub1_int]
    have ht_eq' : (t : ℤ) + 1 = (bE' : ℤ) := by exact_mod_cast ht_eq
    have ht_ge1' : (1 : ℤ) ≤ (t : ℤ) := by exact_mod_cast ht_ge1
    nlinarith
  have hψE'_incl_L : ∀ s : L, (s = 0 ∨ 0 ≤ valL F L s) →
      ψE' (IntermediateField.inclusion hLE' α₀ *
        IntermediateField.inclusion hLE' s * (2 * x_star - x_star ^ 2)) = ψ (β * s) := by
    intro s hs
    have hid : IntermediateField.inclusion hLE' α₀ *
        IntermediateField.inclusion hLE' s * (2 * x_star - x_star ^ 2) =
