    rw [h_split]
    exact hval_unit_add_pos ((τ_u j : K₁) - (τ_u m₀ : K₁)) (-x₀ + (τ_u m₀ : K₁))
      hdiff_ne hdiff_val hm₀_mod1
  obtain ⟨hP_ne, hP_val⟩ := hprod_unit (S'.erase m₀) (fun j => -x₀ + (τ_u j : K₁)) h_other_unit
  have hprod_eq : (∏ j ∈ S'.erase m₀, (-x₀ + (τ_u j : K₁))) * (-x₀ + (τ_u m₀ : K₁)) =
