    hu_corr_eq, hc_K_eq, hc_K_val, hc_K_stat, hrhs_stable⟩

theorem ld_wild_stable_cond_dyadic_quad_norm_and_prefactor (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (h2ba : 2 * condExp F L ν₁ ≤ condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (hp_val : ((Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * condExp F L ν₁ /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))))
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_eq : ν₁ c_ν₁ = ν₁ c_χ')
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hnorm_to_tr : ∀ z : K, (z = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      ψ (((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hrhs_stable : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      tateEps F L (ν₁ ^ j * χ') ψ =
        (((ν₁ ^ j) c_χ' : (Ω F)ˣ) : Ω F) * tateEps F L χ' ψ) :
    (2 : k_L) = 0 ∧
    (∀ x : L, traceLM F hLK (IntermediateField.inclusion hLK x) = (2 : L) * x) ∧
    (∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y) ∧
    (∀ x : L, normLM F hLK (IntermediateField.inclusion hLK x) = x ^ 2) ∧
    (∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x + y) =
        x ^ 2 + x * traceLM F hLK y + normLM F hLK y) ∧
    ∃ (x_0 : L) (z_0 : Lˣ),
      (x_0 = 0 ∨ ((condExp F L χ' / 2 : ℕ) : ℤ) ≤ valL F L x_0) ∧
      (z_0 : L) = 1 + x_0 ∧
      (∀ w : L, (w = 0 ∨ ((condExp F L χ' / 2 : ℕ) : ℤ) ≤ valL F L w) →
        ψ (((c_χ'⁻¹ : Lˣ) : L) * w ^ 2) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0 * w)) ∧
      (∀ (P_sq : Ω F),
        (tateEps F L χ' ψ) ^ 2 =
          P_sq *
            ((χ' c_χ' : Ω F) ^ 2 *
              (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
              (χ' z_0 : Ω F)⁻¹ *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0)) →
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEps F L (ν₁ ^ j * χ') ψ) =
          P_sq *
            (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
              (ν₁ c_ν₁ : Ω F) *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
              ψ (((c_ν₁⁻¹ : Lˣ) : L)))) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, _, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  let p := Module.finrank L (IntermediateField.extendScalars hLK)
  let b := condExp F L ν₁
  let a := condExp F L χ'
  let n := condExpChar F L ψ
  let d_b := b / 2
  let r0_b := (b + 1) / 2
  let d_a := a / 2
  let r0_a := (a + 1) / 2
  let m_0 : ℤ := ((d_a : ℕ) : ℤ) - ((a - b : ℕ) : ℤ)
  have hp_pos : 0 < p := by omega
  let P_L (k : ℤ) (x : L) : Prop := x = 0 ∨ k ≤ valL F L x
  let P_K (k : ℤ) (y : K) : Prop := y = 0 ∨ k ≤ valL F K y
  have hPL_mono : ∀ {k₁ k₂ : ℤ} {x : L}, k₁ ≤ k₂ → P_L k₂ x → P_L k₁ x := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hPL_neg : ∀ {k : ℤ} {x : L}, P_L k x → P_L k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · right; rw [hval_neg_L]; exact hx
  have hPL_add : ∀ {k : ℤ} {x₁ x₂ : L}, P_L k x₁ → P_L k x₂ → P_L k (x₁ + x₂) :=
    fun hx₁ hx₂ => hval_add_L _ _ _ hx₁ hx₂
  have hPL_sub : ∀ {k : ℤ} {x₁ x₂ : L}, P_L k x₁ → P_L k x₂ → P_L k (x₁ - x₂) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    exact hPL_add hx₁ (hPL_neg hx₂)
  have hPL_mul : ∀ {k₁ k₂ : ℤ} {x₁ x₂ : L}, P_L k₁ x₁ → P_L k₂ x₂ → P_L (k₁ + k₂) (x₁ * x₂) := by
    intro k₁ k₂ x₁ x₂ hx₁ hx₂
    by_cases hx10 : x₁ = 0
    · exact Or.inl (by rw [hx10, zero_mul])
    · by_cases hx20 : x₂ = 0
      · exact Or.inl (by rw [hx20, mul_zero])
      · right
        have h1 := hx₁.resolve_left hx10
        have h2 := hx₂.resolve_left hx20
        rw [hval_mul_L x₁ x₂ hx10 hx20]
        omega
  have hPK_mono : ∀ {k₁ k₂ : ℤ} {y : K}, k₁ ≤ k₂ → P_K k₂ y → P_K k₁ y := by
    intro k₁ k₂ y hk hy
    rcases hy with rfl | hy
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hy)
  have hPK_mul : ∀ {k₁ k₂ : ℤ} {y₁ y₂ : K}, P_K k₁ y₁ → P_K k₂ y₂ → P_K (k₁ + k₂) (y₁ * y₂) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases hy10 : y₁ = 0
    · exact Or.inl (by rw [hy10, zero_mul])
    · by_cases hy20 : y₂ = 0
      · exact Or.inl (by rw [hy20, mul_zero])
      · right
        have h1 := hy₁.resolve_left hy10
        have h2 := hy₂.resolve_left hy20
        rw [hval_mul_K y₁ y₂ hy10 hy20]
        omega
  have hP_incl : ∀ {k : ℤ} {x : L}, P_L k x → P_K (2 * k) (IntermediateField.inclusion hLK x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl (map_zero (IntermediateField.inclusion hLK))
    · right
      rw [hval_alg x, hp2]
      push_cast
      omega
  have h1_add_ne_L : ∀ {x : L}, P_L 1 x → 1 + x ≠ 0 := by
    intro x hx h0
    have hx_eq : x = -1 := by linear_combination h0
    rw [hx_eq] at hx
    rcases hx with hneg1 | hle
    · exact one_ne_zero (by linear_combination -hneg1)
    · rw [hval_neg1_L] at hle; omega
  have h1_add_val_L : ∀ {x : L}, P_L 1 x → valL F L (1 + x) = 0 := by
    intro x hx
    have hne : 1 + x ≠ 0 := h1_add_ne_L hx
    have hP0 : P_L 0 (1 + x) :=
      hPL_add (Or.inr (le_of_eq hval1_L.symm)) (hPL_mono (by omega) hx)
    have hge0 : 0 ≤ valL F L (1 + x) := hP0.resolve_left hne
    by_contra hval_ne
    have hge1 : 1 ≤ valL F L (1 + x) := by omega
    have h1_P1 : P_L 1 (1 : L) := by
      have h_eq : (1 : L) = (1 + x) - x := by ring
      rw [h_eq]
      exact hPL_sub (Or.inr hge1) hx
    rcases h1_P1 with h10 | h1le
    · exact one_ne_zero h10
    · rw [hval1_L] at h1le; omega
  have hψ_congr : ∀ {x₁ x₂ : L}, P_L (-n) (x₁ - x₂) → ψ x₁ = ψ x₂ := by
    intro x₁ x₂ hdiff
    have h1 : ψ (x₁ - x₂) = 1 := (hSpecL 1).1 (x₁ - x₂) hdiff
    calc ψ x₁ = ψ ((x₁ - x₂) + x₂) := by rw [sub_add_cancel]
      _ = ψ (x₁ - x₂) * ψ x₂ := ψ.map_add_eq_mul _ _
      _ = ψ x₂ := by rw [h1, one_mul]
  have hc_ν₁_inv_coe : ((c_ν₁⁻¹ : Lˣ) : L) = ((c_χ'⁻¹ : Lˣ) : L) * (δ : L) := by
    have h : c_ν₁⁻¹ = c_χ'⁻¹ * δ := by rw [hδ_eq, inv_mul_cancel_left]
    exact congrArg Units.val h
  have h2_Pd : P_L (d_b : ℤ) (2 : L) := by
    have hp_val' := hp_val
    rw [hp2] at hp_val'
    simpa [d_b, b] using hp_val'
  have h1_P0 : P_L 0 (1 : L) := Or.inr (le_of_eq hval1_L.symm)
  have h2_P1 : P_L 1 (2 : L) := hPL_mono (by omega) h2_Pd
  have h2_P0 : P_L 0 (2 : L) := hPL_mono (by omega) h2_P1
  have hresL_2 : resL (2 : L) = (2 : k_L) := by
    have h2_eq : (2 : L) = 1 + 1 := by ring
    rw [h2_eq, (hresL_ring 1 1 h1_P0 h1_P0).1, hresL_1]
    ring
  have hchar2 : (2 : k_L) = 0 := by
    rw [← hresL_2]
    exact (hresL_ker (2 : L) h2_P0).mpr h2_P1
  have htoExt_incl : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) =
        algebraMap L (IntermediateField.extendScalars hLK) x :=
    fun _ => Subtype.ext rfl
  have htoExt_smul : ∀ (x : L) (y : K),
      toExtendScalars F hLK (IntermediateField.inclusion hLK x * y) =
        x • toExtendScalars F hLK y := by
    intro x y
    rw [map_mul, htoExt_incl x, Algebra.smul_def]
  have htr_incl : ∀ x : L, traceLM F hLK (IntermediateField.inclusion hLK x) = (2 : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change (Algebra.trace L (IntermediateField.extendScalars hLK))
      (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = (2 : L) * x
    rw [htoExt_incl x, Algebra.trace_algebraMap, hp2, nsmul_eq_mul, Nat.cast_two]
  have htr_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    letI : Module L L := Semiring.toModule
    intro x y
    change (Algebra.trace L (IntermediateField.extendScalars hLK))
      (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * (Algebra.trace L (IntermediateField.extendScalars hLK)) (toExtendScalars F hLK y)
    rw [htoExt_smul x y, LinearMap.map_smul, smul_eq_mul]
  have hnorm_incl : ∀ x : L, normLM F hLK (IntermediateField.inclusion hLK x) = x ^ 2 := by
    intro x
    change (Algebra.norm L) (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = x ^ 2
    rw [htoExt_incl x, Algebra.norm_algebraMap, hp2]
  have hnorm_0 : normLM F hLK 0 = 0 := by
    have h0 := hnorm_incl 0
    rw [map_zero] at h0
    simpa using h0
  haveI : Module.Finite L (IntermediateField.extendScalars hLK) :=
    Module.finite_of_finrank_pos hp_pos
  letI : Module L L := Semiring.toModule
  let b₀ : Module.Basis (Fin 2) L (IntermediateField.extendScalars hLK) :=
    (Module.finBasis L (IntermediateField.extendScalars hLK)).reindex (finCongr hp2)
  have halg_mat : ∀ x : L,
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 0 0 = x ∧
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 1 1 = x ∧
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 0 1 = 0 ∧
      (algebraMap L (Matrix (Fin 2) (Fin 2) L) x) 1 0 = 0 := by
    intro x
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [Matrix.algebraMap_matrix_apply, if_pos rfl]; rfl
    · rw [Matrix.algebraMap_matrix_apply, if_pos rfl]; rfl
    · rw [Matrix.algebraMap_matrix_apply, if_neg (by decide : (0 : Fin 2) ≠ 1)]
    · rw [Matrix.algebraMap_matrix_apply, if_neg (by decide : (1 : Fin 2) ≠ 0)]
  have hnorm_sub : ∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x - y) =
        x ^ 2 - x * traceLM F hLK y + normLM F hLK y := by
    intro x y
    let M : Matrix (Fin 2) (Fin 2) L := Algebra.leftMulMatrix b₀ (toExtendScalars F hLK y)
    have htr_y : traceLM F hLK y = M 0 0 + M 1 1 := by
      change (Algebra.trace L (IntermediateField.extendScalars hLK)) (toExtendScalars F hLK y) = _
      rw [Algebra.trace_eq_matrix_trace b₀, Matrix.trace_fin_two]
    have hnorm_y : normLM F hLK y = M 0 0 * M 1 1 - M 0 1 * M 1 0 := by
      change (Algebra.norm L) (toExtendScalars F hLK y) = _
      rw [Algebra.norm_eq_matrix_det b₀, Matrix.det_fin_two]
    change (Algebra.norm L)
      (toExtendScalars F hLK (IntermediateField.inclusion hLK x - y)) = _
    rw [Algebra.norm_eq_matrix_det b₀, map_sub, htoExt_incl x, map_sub, AlgHom.commutes]
    change (algebraMap L (Matrix (Fin 2) (Fin 2) L) x - M).det = _
    rw [Matrix.det_fin_two]
    simp only [Matrix.sub_apply, (halg_mat x).1, (halg_mat x).2.1,
      (halg_mat x).2.2.1, (halg_mat x).2.2.2, htr_y, hnorm_y]
    ring
  have hnorm_add : ∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x + y) =
        x ^ 2 + x * traceLM F hLK y + normLM F hLK y := by
    intro x y
    have h1 := hnorm_sub x (-y)
    rw [sub_neg_eq_add, map_neg, mul_neg, sub_neg_eq_add] at h1
    have hneg1 : (-y : K) = IntermediateField.inclusion hLK (-1) * y := by
      rw [map_neg, map_one, neg_one_mul]
    have hnorm_neg_y : normLM F hLK (-y) = normLM F hLK y := by
      rw [hneg1, map_mul, hnorm_incl (-1)]
      ring
    rw [hnorm_neg_y] at h1
    exact h1
  have hδ_Pv : P_L ((a - b : ℕ) : ℤ) (δ : L) := Or.inr (le_of_eq hδ_val.symm)
  have hδ_P1 : P_L 1 (δ : L) := hPL_mono (by omega) hδ_Pv
  have hu_δ_ne : 1 + (δ : L) ≠ 0 := h1_add_ne_L hδ_P1
  let u_δ : Lˣ := Units.mk0 (1 + (δ : L)) hu_δ_ne
  have hu_δ_coe : (u_δ : L) = 1 + (δ : L) := rfl
  have hu_δ_val : valL F L (u_δ : L) = 0 := h1_add_val_L hδ_P1
  have hu_δ_inv_val : valL F L ((u_δ⁻¹ : Lˣ) : L) = 0 := by
    rw [hval_inv_L u_δ, hu_δ_val, neg_zero]
  have hu_δ_inv_P0 : P_L 0 ((u_δ⁻¹ : Lˣ) : L) := Or.inr (le_of_eq hu_δ_inv_val.symm)
  have hu_δ_mul_inv : (1 + (δ : L)) * ((u_δ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_δ
  let s_inv : L := traceLM F hLK ((u_K⁻¹ : Kˣ) : K)
  have hu_K_inv_val : valL F K ((u_K⁻¹ : Kˣ) : K) = -((a - b : ℕ) : ℤ) := by
    rw [hval_inv_K u_K, hu_K_val]
  have hs_inv_Pm0 : P_L m_0 s_inv := by
    apply htr_bound m_0 ((u_K⁻¹ : Kˣ) : K)
    right
    rw [hp2, hu_K_inv_val]
    omega
  let x_0 : L := -((δ : L) * s_inv * ((u_δ⁻¹ : Lˣ) : L))
  have hx0_val : P_L ((d_a : ℕ) : ℤ) x_0 := by
    have h1 := hPL_mul (hPL_mul hδ_Pv hs_inv_Pm0) hu_δ_inv_P0
    exact hPL_neg (hPL_mono (by omega) h1)
  have hx0_P1 : P_L 1 x_0 := hPL_mono (by omega) hx0_val
  have hz0_ne : 1 + x_0 ≠ 0 := h1_add_ne_L hx0_P1
  let z_0 : Lˣ := Units.mk0 (1 + x_0) hz0_ne
  have hz0_coe : (z_0 : L) = 1 + x_0 := rfl
  have h1δ_x0 : (1 + (δ : L)) * x_0 = -((δ : L) * s_inv) := by
    dsimp [x_0]
    linear_combination -((δ : L) * s_inv) * hu_δ_mul_inv
  have hu_K_inv_norm : normLM F hLK ((u_K⁻¹ : Kˣ) : K) = ((δ⁻¹ : Lˣ) : L) := by
    have h : Units.map (normLM F hLK) u_K⁻¹ = δ⁻¹ := by rw [map_inv, hu_K_norm]
    exact congrArg Units.val h
  have hδ_mul_inv : (δ : L) * ((δ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv δ
  have hc_χ'_inv_val : valL F L ((c_χ'⁻¹ : Lˣ) : L) = -((a : ℤ) + n) := by
    rw [hval_inv_L c_χ', hc_χ'_val]
  have hc_χ'_inv_P : P_L (-((a : ℤ) + n)) ((c_χ'⁻¹ : Lˣ) : L) :=
    Or.inr (le_of_eq hc_χ'_inv_val.symm)
  have hw_sq : ∀ w : L, (w = 0 ∨ ((d_a : ℕ) : ℤ) ≤ valL F L w) →
      ψ (((c_χ'⁻¹ : Lˣ) : L) * w ^ 2) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0 * w) := by
    intro w hw
    let z : K := ((u_K⁻¹ : Kˣ) : K) * IntermediateField.inclusion hLK w
    have hu_K_inv_PK : P_K (-((a - b : ℕ) : ℤ)) ((u_K⁻¹ : Kˣ) : K) :=
      Or.inr (le_of_eq hu_K_inv_val.symm)
    have hz_Pr0b : P_K ((r0_b : ℕ) : ℤ) z :=
      hPK_mono (by omega) (hPK_mul hu_K_inv_PK (hP_incl hw))
    have hnt := hnorm_to_tr z hz_Pr0b
    have h_lhs : ((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z = ((c_χ'⁻¹ : Lˣ) : L) * w ^ 2 := by
      dsimp [z]
      rw [map_mul, hu_K_inv_norm, hnorm_incl w, hc_ν₁_inv_coe]
      linear_combination ((c_χ'⁻¹ : Lˣ) : L) * w ^ 2 * hδ_mul_inv
    have h_rhs : -((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z =
        ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 * w := by
      have hz_comm : z = IntermediateField.inclusion hLK w * ((u_K⁻¹ : Kˣ) : K) :=
        mul_comm _ _
      have htr_z : traceLM F hLK z = w * s_inv := by
        rw [hz_comm, htr_smul w ((u_K⁻¹ : Kˣ) : K)]
      rw [htr_z, hc_ν₁_inv_coe]
      linear_combination -(((c_χ'⁻¹ : Lˣ) : L) * w) * h1δ_x0
    rw [h_lhs, h_rhs] at hnt
    rw [hnt]
    apply hψ_congr
    have h_diff : ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 * w -
        ((c_χ'⁻¹ : Lˣ) : L) * x_0 * w =
        ((c_χ'⁻¹ : Lˣ) : L) * (δ : L) * x_0 * w := by ring
    rw [h_diff]
    have hprod := hPL_mul (hPL_mul (hPL_mul hc_χ'_inv_P hδ_Pv) hx0_val) hw
    exact hPL_mono (by omega) hprod
  have hu_corr_norm_coe : normLM F hLK (u_corr : K) = ((u_δ * z_0 : Lˣ) : L) := by
    have h1 := hnorm_sub 1 (IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    rw [map_one (IntermediateField.inclusion hLK), htr_smul (δ : L) ((u_K⁻¹ : Kˣ) : K),
      map_mul (normLM F hLK), hnorm_incl (δ : L), hu_K_inv_norm] at h1
    rw [hu_corr_eq, h1]
    change (1 : L) ^ 2 - 1 * ((δ : L) * s_inv) + (δ : L) ^ 2 * ((δ⁻¹ : Lˣ) : L) =
      (1 + (δ : L)) * (1 + x_0)
    linear_combination (δ : L) * hδ_mul_inv - h1δ_x0
  have hu_corr_norm : Units.map (normLM F hLK) u_corr = u_δ * z_0 :=
    Units.ext hu_corr_norm_coe
  have hc_χ'_incl_norm :
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK) c_χ') = c_χ' ^ 2 := by
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (c_χ' : L)) = ((c_χ' ^ 2 : Lˣ) : L)
    rw [hnorm_incl (c_χ' : L), Units.val_pow_eq_pow_val]
  have hc_K_norm : Units.map (normLM F hLK) c_K = c_χ' ^ 2 * u_δ⁻¹ * z_0⁻¹ := by
    rw [hc_K_eq, map_mul, hc_χ'_incl_norm, map_inv, hu_corr_norm, mul_inv_rev]
    ac_rfl
  have hχK_cK : ((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) =
      (χ' c_χ' : Ω F) ^ 2 * (χ' u_δ : Ω F)⁻¹ * (χ' z_0 : Ω F)⁻¹ := by
    change (χ' (Units.map (normLM F hLK) c_K) : Ω F) = _
    rw [hc_K_norm, map_mul, map_mul, map_pow, map_inv, map_inv,
      Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val,
      Units.val_inv_eq_inv_val, Units.val_inv_eq_inv_val]
  have hδ_Pr0a : P_L ((r0_a : ℕ) : ℤ) (δ : L) := hPL_mono (by omega) hδ_Pv
  have hχ'_uδ : (χ' u_δ : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L)) := by
    have hstat := hc_χ'_stat (δ : L) hδ_Pr0a hu_δ_ne
    change (χ' u_δ : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ : L)) at hstat
    rw [hstat, ← hc_ν₁_inv_coe]
  have huδ_cancel : (χ' u_δ : Ω F)⁻¹ * ψ (((c_ν₁⁻¹ : Lˣ) : L)) = 1 := by
    rw [← hχ'_uδ, ← Units.val_inv_eq_inv_val, ← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hc_K_inv_coe : ((c_K⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK ((c_χ'⁻¹ : Lˣ) : L) * (u_corr : K) := by
    have h : c_K⁻¹ = (Units.map (IntermediateField.inclusion hLK) c_χ'⁻¹) * u_corr := by
      rw [hc_K_eq, mul_inv_rev, inv_inv, ← map_inv, mul_comm]
    exact congrArg Units.val h
  have htr_cK_inv : traceLM F hLK ((c_K⁻¹ : Kˣ) : K) =
      (((c_χ'⁻¹ : Lˣ) : L) + ((c_χ'⁻¹ : Lˣ) : L)) +
        ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 := by
    have h1 : traceLM F hLK (u_corr : K) = (2 : L) - (δ : L) * s_inv := by
      have h1_eq : (1 : K) = IntermediateField.inclusion hLK 1 := (map_one _).symm
      rw [hu_corr_eq, map_sub, htr_smul (δ : L) ((u_K⁻¹ : Kˣ) : K)]
      conv_lhs => enter [1]; rw [h1_eq, htr_incl 1, mul_one]
    rw [hc_K_inv_coe, htr_smul ((c_χ'⁻¹ : Lˣ) : L) (u_corr : K), h1]
    linear_combination -((c_χ'⁻¹ : Lˣ) : L) * h1δ_x0
  have hψ_1δ_x0 : ψ (((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0) =
      ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0) := by
    apply hψ_congr
    have h_diff : ((c_χ'⁻¹ : Lˣ) : L) * (1 + (δ : L)) * x_0 -
        ((c_χ'⁻¹ : Lˣ) : L) * x_0 =
        ((c_χ'⁻¹ : Lˣ) : L) * (δ : L) * x_0 := by ring
    rw [h_diff]
    have hprod := hPL_mul (hPL_mul hc_χ'_inv_P hδ_Pv) hx0_val
    exact hPL_mono (by omega) hprod
  have htrChar_cK : (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) =
      (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
        ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0) := by
    change ψ (traceLM F hLK ((c_K⁻¹ : Kˣ) : K)) = _
    rw [htr_cK_inv, ψ.map_add_eq_mul, ψ.map_add_eq_mul, hψ_1δ_x0]
    ring
  have hν₁_0 : ν₁ ^ 0 = 1 := MonoidHom.ext fun _ => by simp
  have hν₁_1 : ν₁ ^ 1 = ν₁ := MonoidHom.ext fun _ => by simp
  have h1_χ' : 1 * χ' = χ' := MonoidHom.ext fun _ => by simp
  have hEps_stable1 : tateEps F L (ν₁ * χ') ψ =
      (ν₁ c_ν₁ : Ω F) * tateEps F L χ' ψ := by
    have h1 := hrhs_stable 1 (by omega)
    rw [hν₁_1, ← hc_ν₁_eq] at h1
    exact h1
  have hRHS_prod : ∀ (P_sq : Ω F),
      (tateEps F L χ' ψ) ^ 2 =
        P_sq *
          ((χ' c_χ' : Ω F) ^ 2 *
            (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
            (χ' z_0 : Ω F)⁻¹ *
            ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0)) →
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) =
        P_sq *
          (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
            (ν₁ c_ν₁ : Ω F) *
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
            ψ (((c_ν₁⁻¹ : Lˣ) : L))) := by
    intro P_sq hEps_sq
    rw [hp2, Finset.prod_range_succ, Finset.prod_range_one, hν₁_0, h1_χ', hν₁_1,
      hEps_stable1, hχK_cK, htrChar_cK]
    calc tateEps F L χ' ψ * ((ν₁ c_ν₁ : Ω F) * tateEps F L χ' ψ)
        = (tateEps F L χ' ψ) ^ 2 * (ν₁ c_ν₁ : Ω F) := by ring
      _ = (P_sq *
            ((χ' c_χ' : Ω F) ^ 2 *
              (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
              (χ' z_0 : Ω F)⁻¹ *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0))) *
            (ν₁ c_ν₁ : Ω F) * 1 := by rw [hEps_sq, mul_one]
      _ = (P_sq *
            ((χ' c_χ' : Ω F) ^ 2 *
              (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
              (χ' z_0 : Ω F)⁻¹ *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0))) *
            (ν₁ c_ν₁ : Ω F) *
            ((χ' u_δ : Ω F)⁻¹ * ψ (((c_ν₁⁻¹ : Lˣ) : L))) := by rw [huδ_cancel]
      _ = P_sq *
            (((χ' c_χ' : Ω F) ^ 2 * (χ' u_δ : Ω F)⁻¹ * (χ' z_0 : Ω F)⁻¹) *
              (ν₁ c_ν₁ : Ω F) *
              ((ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
                ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0)) *
              ψ (((c_ν₁⁻¹ : Lˣ) : L))) := by ring
  exact ⟨hchar2, htr_incl, htr_smul, hnorm_incl, hnorm_add,
    x_0, z_0, hx0_val, hz0_coe, hw_sq, hRHS_prod⟩

theorem ld_wild_stable_cond_dyadic_L_chi_sq_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χ' : Lˣ →* (Ω F)ˣ)
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hchar2 : (2 : k_L) = 0)
    (R_L : Finset L) (c_χ' : Lˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (x_0 : L) (z_0 : Lˣ)
    (hx0_val : x_0 = 0 ∨ ((condExp F L χ' / 2 : ℕ) : ℤ) ≤ valL F L x_0)
    (hz0_coe : (z_0 : L) = 1 + x_0)
    (hw_sq : ∀ w : L, (w = 0 ∨ ((condExp F L χ' / 2 : ℕ) : ℤ) ≤ valL F L w) →
      ψ (((c_χ'⁻¹ : Lˣ) : L) * w ^ 2) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0 * w))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hFF2 : ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
      (2 : k_L) = 0 →
      ∀ (Q : k_L → Ω F),
        Q 0 = 1 →
        (∀ x y : k_L, Q (x + y) = Q x * Q y * ψ₀ (x * y)) →
        ((∀ x : k_L, Q x ≠ 0) →
          (∑ x : k_L, Q x) * (∑ y : k_L, (Q y)⁻¹) = (Fintype.card k_L : Ω F)) ∧
        (∀ x₀ : k_L, (∀ y : k_L, (Q y) ^ 2 = ψ₀ (x₀ * y)) →
          (∑ x : k_L, Q x) ^ 2 = (Fintype.card k_L : Ω F) * Q x₀)) :
    (tateEps F L χ' ψ) ^ 2 =
      ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
        (Fintype.card k_L : Ω F) ^ (condExp F L χ') *
        ((χ' c_χ' : Ω F) ^ 2 *
          (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ 2 *
          (χ' z_0 : Ω F)⁻¹ *
          ψ (((c_χ'⁻¹ : Lˣ) : L) * x_0)) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalL_props
  set a : ℕ := condExp F L χ'
  set d_a : ℕ := a / 2
  set r₀ : ℕ := (a + 1) / 2
  set n : ℤ := condExpChar F L ψ
  set A : L := ((c_χ'⁻¹ : Lˣ) : L)
  have ha_ne0 : a ≠ 0 := by omega
  have ha_ge1 : 1 ≤ a := by omega
  have hd_ge1 : 1 ≤ d_a := by omega
  have hψ_triv : ∀ x : L, (x = 0 ∨ -n ≤ valL F L x) → ψ x = 1 := (hSpecL 1).1
  have hψ_nontriv : ∃ x₁ : L, x₁ ≠ 0 ∧ -(n + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1 := (hSpecL 1).2.1
  have hχ'_triv : ∀ u ∈ unitGroup F L a, χ' u = 1 := ((hSpecL χ').2.2.1 ha_ne0).1
  let P : ℤ → L → Prop := fun k x => x = 0 ∨ k ≤ valL F L x
  have hP_zero : ∀ k : ℤ, P k 0 := fun _ => Or.inl rfl
  have hP_one : P 0 1 := Or.inr (by rw [hval1])
  have hP_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {x : L}, P k₂ x → P k₁ x := by
    intro k₁ k₂ hk x hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hP_neg : ∀ {k : ℤ} {x : L}, P k x → P k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp [P]
    · right; rw [hval_neg]; exact hx
  have hP_add : ∀ {k : ℤ} {x y : L}, P k x → P k y → P k (x + y) :=
    fun hx hy => hval_add _ _ _ hx hy
  have hP_sub : ∀ {k : ℤ} {x y : L}, P k x → P k y → P k (x - y) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hP_add hx (hP_neg hy)
  have hP_mul : ∀ {k₁ k₂ : ℤ} {x y : L}, P k₁ x → P k₂ y → P (k₁ + k₂) (x * y) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hP_sq : ∀ {k : ℤ} {x : L}, P k x → P (k + k) (x ^ 2) := by
    intro k x hx
    rw [sq]
    exact hP_mul hx hx
  have hP_of_val : ∀ {k : ℤ} {x : L}, valL F L x = k → P k x := by
    intro k x h
    exact Or.inr (by omega)
  have hA_val : valL F L A = -((a : ℤ) + n) := by
    dsimp only [A]
    rw [hval_inv c_χ', hc_χ'_val]
  have hP_A : P (-((a : ℤ) + n)) A := hP_of_val hA_val
  have h1_add_ne : ∀ {y : L}, P 1 y → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : y = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hy_eq] at hy
    rcases hy with h_neg1_0 | h_val
    · exact one_ne_zero (neg_eq_zero.mp h_neg1_0)
    · rw [hval_neg1] at h_val
      omega
  have h1_add_val : ∀ {y : L} (hy : P 1 y), valL F L (1 + y) = 0 := by
    intro y hy
    set u := Units.mk0 (1 + y) (h1_add_ne hy)
    have hu_mem : u ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u]
      change (1 + y : L) = 1 ∨ (1 : ℤ) ≤ valL F L ((1 + y : L) - 1)
      rw [add_sub_cancel_left]
      rcases hy with rfl | hy'
      · left; rw [add_zero]
      · right; exact hy'
    exact hunit_val0 1 u hu_mem
  have hψ_congr : ∀ {x y : L}, P (-n) (x - y) → ψ x = ψ y := by
    intro x y hxy
    have h_eq : x = (x - y) + y := by ring
    rw [h_eq, ψ.map_add_eq_mul, hψ_triv (x - y) hxy, one_mul]
  have hχ'_congr : ∀ {u v : Lˣ}, valL F L (u : L) = 0 → P (a : ℤ) ((v : L) - (u : L)) → χ' v = χ' u := by
    intro u v hu_val hvu
    set q : Lˣ := u⁻¹ * v
    have hq_sub : ((q : Lˣ) : L) - 1 = ((u⁻¹ : Lˣ) : L) * ((v : L) - (u : L)) := by
      have h_inv : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := by exact_mod_cast Units.inv_mul u
      dsimp only [q]
      rw [Units.val_mul, ← h_inv]
      ring
    have hu_inv_P : P 0 ((u⁻¹ : Lˣ) : L) := by
      apply hP_of_val
      rw [hval_inv u, hu_val, neg_zero]
    have hq_P : P (a : ℤ) (((q : Lˣ) : L) - 1) := by
      rw [hq_sub, ← zero_add (a : ℤ)]
      exact hP_mul hu_inv_P hvu
    have hq_mem : q ∈ unitGroup F L a := by
      rw [hunit_ge1 a ha_ge1 q]
      rcases hq_P with h0 | hge
      · left; exact sub_eq_zero.mp h0
      · right; exact hge
    have hv_eq : v = u * q := by simp [q]
    rw [hv_eq, map_mul, hχ'_triv q hq_mem, mul_one]
  have hϖ_pow_val : ∀ k : ℕ, valL F L (((ϖ_L ^ k : Lˣ) : L)) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hval1]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_L]
      push_cast
      ring
  set δ_a : Lˣ := ϖ_L ^ d_a
  have hδa_val : valL F L (δ_a : L) = (d_a : ℤ) := hϖ_pow_val d_a
  have hP_δa : P (d_a : ℤ) (δ_a : L) := hP_of_val hδa_val
  have hδa_inv_val : valL F L ((δ_a⁻¹ : Lˣ) : L) = -(d_a : ℤ) := by
    rw [hval_inv δ_a, hδa_val]
  obtain ⟨hEps_even, hEps_odd⟩ :=
    ((hStat L ψ hψ χ' ha_ge2).2 c_χ' hc_χ'_val hc_χ'_stat).2
      R_L δ_a hRL_int hRL_sep hRL_surj hδa_val
  rcases Nat.mod_two_eq_zero_or_one a with ha_even | ha_odd
  · have ha_eq_2d : a = d_a + d_a := by omega
    have hr0_eq : r₀ = d_a := by omega
    have hx0_stat : P (r₀ : ℤ) x_0 := by
      change x_0 = 0 ∨ (r₀ : ℤ) ≤ valL F L x_0
      rw [hr0_eq]
      exact hx0_val
    have hx0_1_ne : 1 + x_0 ≠ 0 := by
      rw [← hz0_coe]
      exact Units.ne_zero z_0
    have hz0_mk0 : Units.mk0 (1 + x_0) hx0_1_ne = z_0 := Units.ext hz0_coe.symm
    have h_cancel : (χ' z_0 : Ω F)⁻¹ * ψ (A * x_0) = 1 := by
      rw [← hc_χ'_stat x_0 hx0_stat hx0_1_ne, hz0_mk0, inv_mul_cancel₀ (Units.ne_zero (χ' z_0))]
    have hcard_pow : ((Fintype.card k_L : Ω F) ^ d_a) ^ 2 = (Fintype.card k_L : Ω F) ^ a := by
      rw [ha_eq_2d, pow_add, sq]
    rw [hEps_even ha_even, hRL_card]
    calc ((qL F L : Ω F) ^ n * (Fintype.card k_L : Ω F) ^ d_a * (χ' c_χ' : Ω F) * ψ A) ^ 2
      _ = ((qL F L : Ω F) ^ n) ^ 2 * ((Fintype.card k_L : Ω F) ^ d_a) ^ 2 *
            ((χ' c_χ' : Ω F) ^ 2 * (ψ A) ^ 2 * 1) := by ring
      _ = ((qL F L : Ω F) ^ n) ^ 2 * (Fintype.card k_L : Ω F) ^ a *
            ((χ' c_χ' : Ω F) ^ 2 * (ψ A) ^ 2 * ((χ' z_0 : Ω F)⁻¹ * ψ (A * x_0))) := by
        rw [hcard_pow, ← h_cancel]
      _ = ((qL F L : Ω F) ^ n) ^ 2 * (Fintype.card k_L : Ω F) ^ a *
            ((χ' c_χ' : Ω F) ^ 2 * (ψ A) ^ 2 * (χ' z_0 : Ω F)⁻¹ * ψ (A * x_0)) := by ring
  · have ha_eq_2d1 : a = 2 * d_a + 1 := by omega
    have hr0_eq : r₀ = d_a + 1 := by omega
    let liftL : k_L → L := fun y => Classical.choose (hresL_surj y)
    have hliftL_int : ∀ y : k_L, P 0 (liftL y) :=
      fun y => (Classical.choose_spec (hresL_surj y)).1
    have hliftL_res : ∀ y : k_L, resL (liftL y) = y :=
      fun y => (Classical.choose_spec (hresL_surj y)).2
    have hresL_sub_mem1 : ∀ {x₁ x₂ : L}, P 0 x₁ → P 0 x₂ → resL x₁ = resL x₂ → P 1 (x₁ - x₂) := by
      intro x₁ x₂ hx₁ hx₂ hres
      have hsub_int : P 0 (x₁ - x₂) := hP_sub hx₁ hx₂
      have hres_sub : resL (x₁ - x₂) = 0 := by
        rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ (hP_neg hx₂)).1,
          (hresL_ring x₂ 0 hx₂ (hP_zero 0)).2.2, hres, add_neg_cancel]
      exact (hresL_ker (x₁ - x₂) hsub_int).mp hres_sub
    let ψ₀_fn : k_L → Ω F := fun y => ψ (A * (δ_a : L) ^ 2 * liftL y)
    have hψ₀_spec : ∀ z : L, P 0 z → ψ₀_fn (resL z) = ψ (A * (δ_a : L) ^ 2 * z) := by
      intro z hz
      dsimp only [ψ₀_fn]
      symm
      apply hψ_congr
      have h_eq : A * (δ_a : L) ^ 2 * z - A * (δ_a : L) ^ 2 * liftL (resL z) =
          A * ((δ_a : L) ^ 2 * (z - liftL (resL z))) := by ring
      rw [h_eq]
      have hΔ1 : P 1 (z - liftL (resL z)) :=
        hresL_sub_mem1 hz (hliftL_int (resL z)) (hliftL_res (resL z)).symm
      exact hP_mono (by omega) (hP_mul hP_A (hP_mul (hP_sq hP_δa) hΔ1))
    have hψ₀_0 : ψ₀_fn 0 = 1 := by
      rw [← hresL_0, hψ₀_spec 0 (hP_zero 0), mul_zero, ψ.map_zero_eq_one]
    have hψ₀_add : ∀ x y : k_L, ψ₀_fn (x + y) = ψ₀_fn x * ψ₀_fn y := by
      intro x y
      set zx := liftL x
      set zy := liftL y
      have hzx : P 0 zx := hliftL_int x
      have hzy : P 0 zy := hliftL_int y
      have hxy_res : x + y = resL (zx + zy) := by
        rw [(hresL_ring zx zy hzx hzy).1, hliftL_res x, hliftL_res y]
      rw [hxy_res, hψ₀_spec (zx + zy) (hP_add hzx hzy),
        ← hliftL_res x, ← hliftL_res y, hψ₀_spec zx hzx, hψ₀_spec zy hzy,
        ← ψ.map_add_eq_mul]
      congr 1
      ring
    let ψ₀ : AddChar k_L (Ω F) := AddChar.mk ψ₀_fn hψ₀_0 hψ₀_add
    have hψ₀_apply : ∀ y : k_L, ψ₀ y = ψ₀_fn y := fun _ => rfl
    have hψ₀_ne1 : ψ₀ ≠ 1 := by
      obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ_ne1⟩ := hψ_nontriv
      have hx₁_P : P (-(n + 1)) x₁ := Or.inr hx₁_val
      set u_scale : Lˣ := c_χ' * (δ_a ^ 2)⁻¹
      set z₁ : L := (u_scale : L) * x₁
      have hδa2_inv_val : valL F L (((δ_a ^ 2)⁻¹ : Lˣ) : L) = -((d_a : ℤ) + (d_a : ℤ)) := by
        rw [hval_inv (δ_a ^ 2), Units.val_pow_eq_pow_val, sq,
          hval_mul (δ_a : L) (δ_a : L) (Units.ne_zero _) (Units.ne_zero _), hδa_val]
      have hu_scale_P : P (n + 1) (u_scale : L) := by
        dsimp only [u_scale]
        rw [Units.val_mul]
        exact hP_mono (by omega)
          (hP_mul (hP_of_val hc_χ'_val) (hP_of_val hδa2_inv_val))
      have hz₁_int : P 0 z₁ :=
        hP_mono (by omega) (hP_mul hu_scale_P hx₁_P)
      have hA_z₁ : A * (δ_a : L) ^ 2 * z₁ = x₁ := by
        have hc_inv : A * (c_χ' : L) = 1 := Units.inv_mul c_χ'
        have hδ_inv : ((δ_a ^ 2 : Lˣ) : L) * (((δ_a ^ 2)⁻¹ : Lˣ) : L) = 1 :=
          Units.mul_inv (δ_a ^ 2)
        rw [Units.val_pow_eq_pow_val] at hδ_inv
        dsimp only [z₁, u_scale]
        rw [Units.val_mul]
        calc A * (δ_a : L) ^ 2 * ((c_χ' : L) * (((δ_a ^ 2)⁻¹ : Lˣ) : L) * x₁)
          _ = (A * (c_χ' : L)) * ((δ_a : L) ^ 2 * (((δ_a ^ 2)⁻¹ : Lˣ) : L)) * x₁ := by ring
          _ = 1 * 1 * x₁ := by rw [hc_inv, hδ_inv]
          _ = x₁ := by ring
      rw [DFunLike.ne_iff]
      refine ⟨resL z₁, ?_⟩
      rw [AddChar.one_apply, hψ₀_apply, hψ₀_spec z₁ hz₁_int, hA_z₁]
      exact hx₁_ψ_ne1
    let Q_χ : k_L → Ω F := fun y =>
      if hx : 1 + (δ_a : L) * liftL y ≠ 0 then
        (χ' (Units.mk0 (1 + (δ_a : L) * liftL y) hx) : Ω F)⁻¹ *
          ψ (A * (δ_a : L) * liftL y)
      else 0
    have hδx_P1 : ∀ {x : L}, P 0 x → P 1 ((δ_a : L) * x) :=
      fun hx => hP_mono (by omega) (hP_mul hP_δa hx)
    have hQ_spec : ∀ x : L, P 0 x → ∀ hx : 1 + (δ_a : L) * x ≠ 0,
        Q_χ (resL x) =
          (χ' (Units.mk0 (1 + (δ_a : L) * x) hx) : Ω F)⁻¹ *
            ψ (A * (δ_a : L) * x) := by
      intro x₁ hx₁ hx₁_ne
      set x₂ := liftL (resL x₁)
      have hx₂ : P 0 x₂ := hliftL_int (resL x₁)
      have hx₂_ne : 1 + (δ_a : L) * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
      dsimp only [Q_χ]
      rw [dif_pos hx₂_ne]
      have h12 : P 1 (x₁ - x₂) :=
        hresL_sub_mem1 hx₁ hx₂ (hliftL_res (resL x₁)).symm
      have hδ12_stat : P (r₀ : ℤ) ((δ_a : L) * (x₁ - x₂)) :=
        hP_mono (by omega) (hP_mul hP_δa h12)
      have hδ12_P1 : P 1 ((δ_a : L) * (x₁ - x₂)) := hP_mono (by omega) hδ12_stat
      have hw_ne : 1 + (δ_a : L) * (x₁ - x₂) ≠ 0 := h1_add_ne hδ12_P1
      set u₁ := Units.mk0 (1 + (δ_a : L) * x₁) hx₁_ne
      set u₂ := Units.mk0 (1 + (δ_a : L) * x₂) hx₂_ne
      set w := Units.mk0 (1 + (δ_a : L) * (x₁ - x₂)) hw_ne
      have hu₁_val : valL F L (u₁ : L) = 0 := h1_add_val (hδx_P1 hx₁)
      have hpoly : ((u₂ * w : Lˣ) : L) - (u₁ : L) =
          (δ_a : L) ^ 2 * (x₂ * (x₁ - x₂)) := by
        dsimp only [u₁, u₂, w]
        rw [Units.val_mul, Units.val_mk0, Units.val_mk0, Units.val_mk0]
        ring
      have hpoly_Pa : P (a : ℤ) (((u₂ * w : Lˣ) : L) - (u₁ : L)) := by
        rw [hpoly]
        exact hP_mono (by omega) (hP_mul (hP_sq hP_δa) (hP_mul hx₂ h12))
      have hχ_eq : χ' (u₂ * w) = χ' u₁ := hχ'_congr hu₁_val hpoly_Pa
      have hχ_mul : (χ' u₁ : Ω F) = (χ' u₂ : Ω F) * (χ' w : Ω F) := by
        rw [← hχ_eq, map_mul, Units.val_mul]
      have hχ_w : (χ' w : Ω F) = ψ (A * ((δ_a : L) * (x₁ - x₂))) :=
        hc_χ'_stat ((δ_a : L) * (x₁ - x₂)) hδ12_stat hw_ne
      have hψ_split : ψ (A * (δ_a : L) * x₁) =
          ψ (A * (δ_a : L) * x₂) * (χ' w : Ω F) := by
        rw [hχ_w, ← ψ.map_add_eq_mul]
        congr 1
        ring
      rw [hχ_mul, hψ_split, mul_inv]
      calc (χ' u₂ : Ω F)⁻¹ * ψ (A * (δ_a : L) * x₂)
        _ = (χ' u₂ : Ω F)⁻¹ * ψ (A * (δ_a : L) * x₂) * 1 := (mul_one _).symm
        _ = (χ' u₂ : Ω F)⁻¹ * ψ (A * (δ_a : L) * x₂) *
            ((χ' w : Ω F)⁻¹ * (χ' w : Ω F)) := by
          rw [inv_mul_cancel₀ (Units.ne_zero (χ' w))]
        _ = (χ' u₂ : Ω F)⁻¹ * (χ' w : Ω F)⁻¹ *
            (ψ (A * (δ_a : L) * x₂) * (χ' w : Ω F)) := by
          ring
    have hQ_0 : Q_χ 0 = 1 := by
      have h1_0_ne : 1 + (δ_a : L) * (0 : L) ≠ 0 := by simp
      rw [← hresL_0, hQ_spec 0 (hP_zero 0) h1_0_ne]
      have hmk_one : Units.mk0 (1 + (δ_a : L) * (0 : L)) h1_0_ne = 1 := by
        apply Units.ext; simp
      rw [hmk_one, map_one, Units.val_one, inv_one, one_mul, mul_zero, ψ.map_zero_eq_one]
    have hQ_add : ∀ y₁ y₂ : k_L, Q_χ (y₁ + y₂) = Q_χ y₁ * Q_χ y₂ * ψ₀ (y₁ * y₂) := by
      intro y₁ y₂
      set x₁ := liftL y₁
      set x₂ := liftL y₂
      have hx₁ : P 0 x₁ := hliftL_int y₁
      have hx₂ : P 0 x₂ := hliftL_int y₂
      have hx12 : P 0 (x₁ + x₂) := hP_add hx₁ hx₂
      have hmul12 : P 0 (x₁ * x₂) := hP_mono (by omega) (hP_mul hx₁ hx₂)
      have hu₁_ne : 1 + (δ_a : L) * x₁ ≠ 0 := h1_add_ne (hδx_P1 hx₁)
      have hu₂_ne : 1 + (δ_a : L) * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
      have hu12_ne : 1 + (δ_a : L) * (x₁ + x₂) ≠ 0 := h1_add_ne (hδx_P1 hx12)
      have hδ2_stat : P (r₀ : ℤ) ((δ_a : L) ^ 2 * (x₁ * x₂)) :=
        hP_mono (by omega) (hP_mul (hP_sq hP_δa) hmul12)
      have hwq_ne : 1 + (δ_a : L) ^ 2 * (x₁ * x₂) ≠ 0 :=
        h1_add_ne (hP_mono (by omega) hδ2_stat)
      set u₁ := Units.mk0 (1 + (δ_a : L) * x₁) hu₁_ne
      set u₂ := Units.mk0 (1 + (δ_a : L) * x₂) hu₂_ne
      set u₁₂ := Units.mk0 (1 + (δ_a : L) * (x₁ + x₂)) hu12_ne
      set w_q := Units.mk0 (1 + (δ_a : L) ^ 2 * (x₁ * x₂)) hwq_ne
      have hu1u2_val : valL F L ((u₁ * u₂ : Lˣ) : L) = 0 := by
        rw [Units.val_mul, hval_mul (u₁ : L) (u₂ : L) (Units.ne_zero _) (Units.ne_zero _)]
        dsimp only [u₁, u₂]
        rw [Units.val_mk0, Units.val_mk0,
          h1_add_val (hδx_P1 hx₁), h1_add_val (hδx_P1 hx₂), add_zero]
      have hpoly_q : ((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L) =
          (δ_a : L) ^ 2 * ((δ_a : L) * (x₁ * x₂ * (x₁ + x₂))) := by
        dsimp only [u₁, u₂, u₁₂, w_q]
        rw [Units.val_mul, Units.val_mul, Units.val_mk0, Units.val_mk0,
          Units.val_mk0, Units.val_mk0]
        ring
      have hpoly_q_Pa : P (a : ℤ) (((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L)) := by
        rw [hpoly_q]
        exact hP_mono (by omega)
          (hP_mul (hP_sq hP_δa) (hP_mul hP_δa (hP_mul hmul12 hx12)))
      have hχ_q_eq : χ' (u₁₂ * w_q) = χ' (u₁ * u₂) :=
        hχ'_congr hu1u2_val hpoly_q_Pa
      have hχ_inv_eq : (χ' u₁₂ : Ω F)⁻¹ =
          (χ' u₁ : Ω F)⁻¹ * (χ' u₂ : Ω F)⁻¹ * (χ' w_q : Ω F) := by
        have h1 : (χ' u₁₂ : Ω F) * (χ' w_q : Ω F) = (χ' u₁ : Ω F) * (χ' u₂ : Ω F) := by
          exact_mod_cast (map_mul χ' u₁₂ w_q).symm.trans (hχ_q_eq.trans (map_mul χ' u₁ u₂))
        rw [← mul_inv, ← h1, mul_inv, mul_assoc, inv_mul_cancel₀ (Units.ne_zero (χ' w_q)), mul_one]
      have hχ_wq : (χ' w_q : Ω F) = ψ₀ (y₁ * y₂) := by
        rw [hc_χ'_stat ((δ_a : L) ^ 2 * (x₁ * x₂)) hδ2_stat hwq_ne, ← mul_assoc,
          hψ₀_apply, ← hψ₀_spec (x₁ * x₂) hmul12, (hresL_ring x₁ x₂ hx₁ hx₂).2.1,
          hliftL_res y₁, hliftL_res y₂]
      have hres_add : y₁ + y₂ = resL (x₁ + x₂) := by
        rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res y₁, hliftL_res y₂]
      have hψ_add : ψ (A * (δ_a : L) * (x₁ + x₂)) =
          ψ (A * (δ_a : L) * x₁) * ψ (A * (δ_a : L) * x₂) := by
        rw [← ψ.map_add_eq_mul]
        congr 1
        ring
      rw [hres_add, hQ_spec (x₁ + x₂) hx12 hu12_ne,
        ← hliftL_res y₁, ← hliftL_res y₂,
        hQ_spec x₁ hx₁ hu₁_ne, hQ_spec x₂ hx₂ hu₂_ne,
        hliftL_res y₁, hliftL_res y₂, hχ_inv_eq, hχ_wq, hψ_add]
      ring
    have hRL_inj : Set.InjOn resL R_L := by
      intro r₁ hr₁ r₂ hr₂ hres_eq
      by_contra hr_ne
      have hval0_sub : valL F L (r₁ - r₂) = 0 := hRL_sep r₁ hr₁ r₂ hr₂ hr_ne
      have hsub_P1 : P 1 (r₁ - r₂) :=
        hresL_sub_mem1 (hRL_int r₁ hr₁) (hRL_int r₂ hr₂) hres_eq
      rcases hsub_P1 with hsub0 | hval1_sub
      · exact hr_ne (sub_eq_zero.mp hsub0)
      · omega
    have hRL_image : R_L.image resL = Finset.univ := by
      apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
      rw [Finset.card_univ, Finset.card_image_of_injOn hRL_inj, hRL_card]
    have hRL_surj_univ : ∀ b_res ∈ (Finset.univ : Finset k_L), ∃ r ∈ R_L, resL r = b_res := by
      intro b_res hb_res
      rw [← hRL_image] at hb_res
      exact Finset.mem_image.mp hb_res
    have hRL_sum_bij : ∀ g : k_L → Ω F, (∑ r ∈ R_L, g (resL r)) = ∑ x : k_L, g x := by
      intro g
      refine Finset.sum_bij (fun r _ => resL r) ?_ ?_ ?_ ?_
      · intro r _; exact Finset.mem_univ _
      · intro r₁ hr₁ r₂ hr₂ heq; exact hRL_inj hr₁ hr₂ heq
      · intro b_res hb_res
        obtain ⟨r, hr, hres⟩ := hRL_surj_univ b_res hb_res
        exact ⟨r, hr, hres⟩
      · intro _ _; rfl
    have hS_χ : (∑ r ∈ R_L,
        if hr : 1 + (δ_a : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + (δ_a : L) * r) hr) : Ω F)⁻¹ *
            ψ (A * (δ_a : L) * r)
        else 0) = (∑ x : k_L, Q_χ x) := by
      rw [← hRL_sum_bij Q_χ]
      refine Finset.sum_congr rfl (fun r hr => ?_)
      have hr_ne : 1 + (δ_a : L) * r ≠ 0 :=
        h1_add_ne (hδx_P1 (hRL_int r hr))
      rw [dif_pos hr_ne, hQ_spec r (hRL_int r hr) hr_ne]
    set q_0 : L := ((δ_a⁻¹ : Lˣ) : L) * x_0
    set x0_bar : k_L := resL q_0
    have hq0_int : P 0 q_0 :=
      hP_mono (by omega) (hP_mul (hP_of_val hδa_inv_val) hx0_val)
    have hδ_q0 : (δ_a : L) * q_0 = x_0 := by
      have h_mul_inv : (δ_a : L) * ((δ_a⁻¹ : Lˣ) : L) = 1 := by
        exact_mod_cast Units.mul_inv δ_a
      dsimp only [q_0]
      rw [← mul_assoc, h_mul_inv, one_mul]
    have hq0_ne : 1 + (δ_a : L) * q_0 ≠ 0 := by
      rw [hδ_q0, ← hz0_coe]
      exact Units.ne_zero z_0
    have hz0_mk0 : Units.mk0 (1 + (δ_a : L) * q_0) hq0_ne = z_0 := by
      apply Units.ext
      simp [hδ_q0, hz0_coe]
    have hQ_x0 : Q_χ x0_bar = (χ' z_0 : Ω F)⁻¹ * ψ (A * x_0) := by
      dsimp only [x0_bar]
      rw [hQ_spec q_0 hq0_int hq0_ne, hz0_mk0]
      congr 2
      rw [mul_assoc, hδ_q0]
    have hchar2_add : ∀ u : k_L, u + u = 0 := by
      intro u
      rw [← two_mul, hchar2, zero_mul]
    have hψ₀_self_mul : ∀ u : k_L, ψ₀ u * ψ₀ u = 1 := by
      intro u
      rw [hψ₀_apply, ← hψ₀_add u u, hchar2_add u, hψ₀_0]
    have hQ_sq : ∀ y : k_L, (Q_χ y) ^ 2 = ψ₀ (x0_bar * y) := by
      intro y
      have h1 : 1 = (Q_χ y) ^ 2 * ψ₀ (y ^ 2) := by
        calc (1 : Ω F)
          _ = Q_χ 0 := hQ_0.symm
          _ = Q_χ (y + y) := by rw [hchar2_add y]
          _ = Q_χ y * Q_χ y * ψ₀ (y * y) := hQ_add y y
          _ = (Q_χ y) ^ 2 * ψ₀ (y ^ 2) := by rw [sq, sq]
      have hQ_sq_ψ₀ : (Q_χ y) ^ 2 = ψ₀ (y ^ 2) := by
        calc (Q_χ y) ^ 2
          _ = (Q_χ y) ^ 2 * 1 := (mul_one _).symm
          _ = (Q_χ y) ^ 2 * (ψ₀ (y ^ 2) * ψ₀ (y ^ 2)) := by rw [hψ₀_self_mul (y ^ 2)]
          _ = ((Q_χ y) ^ 2 * ψ₀ (y ^ 2)) * ψ₀ (y ^ 2) := by ring
          _ = 1 * ψ₀ (y ^ 2) := by rw [← h1]
          _ = ψ₀ (y ^ 2) := one_mul _
      set r := liftL y
      have hr : P 0 r := hliftL_int y
      set w := (δ_a : L) * r
      have hw_P : P (d_a : ℤ) w := hP_mono (by omega) (hP_mul hP_δa hr)
      have hres_r2 : resL (r ^ 2) = y ^ 2 := by
        rw [sq, (hresL_ring r r hr hr).2.1, hliftL_res y, ← sq]
      have hψ₀_y2 : ψ₀ (y ^ 2) = ψ (A * w ^ 2) := by
        rw [← hres_r2, hψ₀_apply, hψ₀_spec (r ^ 2) (hP_sq hr)]
        congr 1
        dsimp only [w]
        ring
      have hres_q0r : resL (q_0 * r) = x0_bar * y := by
        rw [(hresL_ring q_0 r hq0_int hr).2.1, hliftL_res y]
      have hψ₀_x0y : ψ (A * x_0 * w) = ψ₀ (x0_bar * y) := by
        rw [← hres_q0r, hψ₀_apply, hψ₀_spec (q_0 * r) (hP_mono (by omega) (hP_mul hq0_int hr))]
        congr 1
        rw [← hδ_q0]
        dsimp only [w]
        ring
      rw [hQ_sq_ψ₀, hψ₀_y2, hw_sq w hw_P, hψ₀_x0y]
    have hSum_sq : (∑ x : k_L, Q_χ x) ^ 2 = (Fintype.card k_L : Ω F) * Q_χ x0_bar :=
      (hFF2 ψ₀ hψ₀_ne1 hchar2 Q_χ hQ_0 hQ_add).2 x0_bar hQ_sq
    have hcard_pow_odd :
        ((Fintype.card k_L : Ω F) ^ d_a) ^ 2 * (Fintype.card k_L : Ω F) =
          (Fintype.card k_L : Ω F) ^ a := by
      rw [ha_eq_2d1, two_mul, pow_add, pow_add, pow_one, sq]
    rw [hEps_odd ha_odd, hRL_card, hS_χ]
    calc ((qL F L : Ω F) ^ n * (Fintype.card k_L : Ω F) ^ d_a *
            (χ' c_χ' : Ω F) * ψ A * ∑ x : k_L, Q_χ x) ^ 2
      _ = ((qL F L : Ω F) ^ n) ^ 2 * ((Fintype.card k_L : Ω F) ^ d_a) ^ 2 *
            ((χ' c_χ' : Ω F) ^ 2 * (ψ A) ^ 2 * (∑ x : k_L, Q_χ x) ^ 2) := by ring
      _ = ((qL F L : Ω F) ^ n) ^ 2 * ((Fintype.card k_L : Ω F) ^ d_a) ^ 2 *
            ((χ' c_χ' : Ω F) ^ 2 * (ψ A) ^ 2 *
              ((Fintype.card k_L : Ω F) * ((χ' z_0 : Ω F)⁻¹ * ψ (A * x_0)))) := by
        rw [hSum_sq, hQ_x0]
      _ = ((qL F L : Ω F) ^ n) ^ 2 *
            (((Fintype.card k_L : Ω F) ^ d_a) ^ 2 * (Fintype.card k_L : Ω F)) *
            ((χ' c_χ' : Ω F) ^ 2 * (ψ A) ^ 2 * (χ' z_0 : Ω F)⁻¹ * ψ (A * x_0)) := by ring
      _ = ((qL F L : Ω F) ^ n) ^ 2 * (Fintype.card k_L : Ω F) ^ a *
            ((χ' c_χ' : Ω F) ^ 2 * (ψ A) ^ 2 * (χ' z_0 : Ω F)⁻¹ * ψ (A * x_0)) := by
        rw [hcard_pow_odd]

theorem ld_wild_stable_cond_dyadic_K_and_nu_prod_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (h2ba : 2 * condExp F L ν₁ ≤ condExp F L χ')
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      condExp F L ν₁ +
        Module.finrank L (IntermediateField.extendScalars hLK) *
          (condExp F L χ' - condExp F L ν₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hchar2 : (2 : k_L) = 0)
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (R_L : Finset L) (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hc_K_val : valL F K (c_K : K) =
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
        condExpChar F K (traceChar F hLK ψ))
    (hc_K_stat : ∀ y : K,
      (y = 0 ∨ (((condExp F K (χ'.comp (Units.map (normLM F hLK))) + 1) / 2 : ℕ) : ℤ) ≤
        valL F K y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y))
    (htr_incl : ∀ x : L, traceLM F hLK (IntermediateField.inclusion hLK x) = (2 : L) * x)
    (htr_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y)
    (hnorm_incl : ∀ x : L, normLM F hLK (IntermediateField.inclusion hLK x) = x ^ 2)
    (hnorm_add : ∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x + y) =
        x ^ 2 + x * traceLM F hLK y + normLM F hLK y)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hFF2 : ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
      (2 : k_L) = 0 →
      ∀ (Q : k_L → Ω F),
        Q 0 = 1 →
        (∀ x y : k_L, Q (x + y) = Q x * Q y * ψ₀ (x * y)) →
        ((∀ x : k_L, Q x ≠ 0) →
          (∑ x : k_L, Q x) * (∑ y : k_L, (Q y)⁻¹) = (Fintype.card k_L : Ω F)) ∧
        (∀ x₀ : k_L, (∀ y : k_L, (Q y) ^ 2 = ψ₀ (x₀ * y)) →
          (∑ x : k_L, Q x) ^ 2 = (Fintype.card k_L : Ω F) * Q x₀)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      tateEps F L ν₁ ψ =
    (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) *
      (qL F L : Ω F) ^ condExpChar F L ψ *
      (Fintype.card k_L : Ω F) ^ (condExp F L χ') *
      (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
        (ν₁ c_ν₁ : Ω F) *
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
        ψ (((c_ν₁⁻¹ : Lˣ) : L))) :=
by
  have hba : condExp F L ν₁ < condExp F L χ' := by omega
  apply ld_wild_mid_cond_dyadic_RK_and_stat_reduction F L K hLK hp2 ψ hψ hψK ν₁ χ'
    hb_ge2 hval_alg hba haK hvalL_props hvalK_props ϖ_K ϖ_L hϖ_K hϖ_L hBasis
    k_L R_L c_ν₁ u_K c_K hRL_card hRL_int hRL_sep hRL_surj hc_ν₁_val hc_ν₁_stat
    hu_K_val hc_K_val hc_K_stat hStat
  intro hb_odd
  have hSum_eq :
      (∑ r ∈ R_L,
        if hr_K : 1 + ((u_K * ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) *
            IntermediateField.inclusion hLK r ≠ 0 then
          ((χ'.comp (Units.map (normLM F hLK)))
            (Units.mk0 (1 + ((u_K * ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) *
              IntermediateField.inclusion hLK r) hr_K) : Ω F)⁻¹ *
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) *
              ((u_K * ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) *
              IntermediateField.inclusion hLK r)
        else 0) =
      (∑ r ∈ R_L,
        if hr_2 : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ^ 2 ≠ 0 then
          (ν₁ (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
            (ψ (((c_ν₁⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ^ 2))⁻¹
        else 0) := by
    apply Finset.sum_congr rfl
    intro r hr
    exact ld_wild_mid_cond_dyadic_K_summand_eval F L K hLK hp2 ψ ν₁ χ'
      hν₁_ker hb_ge2 hb_odd hval_alg hba hvalL_props hvalK_props hSpecL
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L t hb_eq htr_bound c_χ' c_ν₁ δ u_K u_corr c_K
      hc_χ'_stat hc_ν₁_stat hδ_eq hu_K_norm hu_K_val hδ_val hu_corr_eq hc_K_eq
      htr_smul hnorm_incl hnorm_add r (hRL_int r hr)
  rw [hSum_eq]
  exact ld_wild_mid_cond_dyadic_nu_polar_and_hasse_inv F L ψ ν₁ hb_ge2 hb_odd
    hvalL_props hSpecL ϖ_L hϖ_L k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
    hresL_surj hchar2 R_L c_ν₁ hRL_card hRL_int hRL_sep hc_ν₁_val hc_ν₁_stat hFF2

theorem ld_wild_stable_cond_dyadic_case (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (h2ba : 2 * condExp F L ν₁ ≤ condExp F L χ')
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      condExp F L ν₁ +
        Module.finrank L (IntermediateField.extendScalars hLK) *
          (condExp F L χ' - condExp F L ν₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (hp_val : ((Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * condExp F L ν₁ /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))))
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (R_L : Finset L) (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_eq : ν₁ c_ν₁ = ν₁ c_χ')
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hnorm_to_tr : ∀ z : K, (z = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      ψ (((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hc_K_val : valL F K (c_K : K) =
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
        condExpChar F K (traceChar F hLK ψ))
    (hc_K_stat : ∀ y : K,
      (y = 0 ∨ (((condExp F K (χ'.comp (Units.map (normLM F hLK))) + 1) / 2 : ℕ) : ℤ) ≤
        valL F K y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y))
    (hrhs_stable : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      tateEps F L (ν₁ ^ j * χ') ψ =
        (((ν₁ ^ j) c_χ' : (Ω F)ˣ) : Ω F) * tateEps F L χ' ψ)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hFF2 : ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
      (2 : k_L) = 0 →
      ∀ (Q : k_L → Ω F),
        Q 0 = 1 →
        (∀ x y : k_L, Q (x + y) = Q x * Q y * ψ₀ (x * y)) →
        ((∀ x : k_L, Q x ≠ 0) →
          (∑ x : k_L, Q x) * (∑ y : k_L, (Q y)⁻¹) = (Fintype.card k_L : Ω F)) ∧
        (∀ x₀ : k_L, (∀ y : k_L, (Q y) ^ 2 = ψ₀ (x₀ * y)) →
          (∑ x : k_L, Q x) ^ 2 = (Fintype.card k_L : Ω F) * Q x₀)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  obtain ⟨hchar2, htr_incl, htr_smul, hnorm_incl, hnorm_add, x_0, z_0,
    hx0_val, hz0_coe, hw_sq, hRHS_prod⟩ :=
    ld_wild_stable_cond_dyadic_quad_norm_and_prefactor F L K hLK hp2 ψ ν₁ χ'
      hb_ge2 hval_alg h2ba hvalL_props hvalK_props hSpecL
      k_L resL hresL_1 hresL_ring hresL_ker t hb_eq hp_val htr_bound
      c_χ' c_ν₁ δ u_K u_corr c_K hc_χ'_val hc_χ'_stat hc_ν₁_eq hδ_eq
      hu_K_norm hu_K_val hδ_val hnorm_to_tr hu_corr_eq hc_K_eq hrhs_stable
  have ha_ge2 : 2 ≤ condExp F L χ' := by omega
  have hEps_χ'_sq :=
    ld_wild_stable_cond_dyadic_L_chi_sq_eval F L ψ hψ χ' ha_ge2 hvalL_props hSpecL
      ϖ_L hϖ_L k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj hchar2
      R_L c_χ' hRL_card hRL_int hRL_sep hRL_surj hc_χ'_val hc_χ'_stat
      x_0 z_0 hx0_val hz0_coe hw_sq hStat hFF2
  have hProd_RHS :=
    hRHS_prod
      (((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
        (Fintype.card k_L : Ω F) ^ (condExp F L χ'))
      hEps_χ'_sq
  have hProd_K_ν₁ :=
    ld_wild_stable_cond_dyadic_K_and_nu_prod_eval F L K hLK hp2 ψ hψ hψK ν₁ χ'
      hν₁_ker hb_ge2 hval_alg h2ba haK hvalL_props hvalK_props hSpecL
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L hBasis k_L resL hresL_0 hresL_1 hresL_ring
      hresL_ker hresL_surj hchar2 t hb_eq htr_bound R_L c_χ' c_ν₁ δ u_K u_corr c_K
      hRL_card hRL_int hRL_sep hRL_surj hc_χ'_val hc_χ'_stat hc_ν₁_val hc_ν₁_stat
      hδ_eq hu_K_norm hu_K_val hδ_val hu_corr_eq hc_K_eq hc_K_val hc_K_stat
      htr_incl htr_smul hnorm_incl hnorm_add hStat hFF2
  have hcond1L : condExp F L 1 = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl (fun _ _ => rfl))
  have heps1L : tateEps F L 1 ψ = (qL F L : Ω F) ^ condExpChar F L ψ := by
    unfold tateEps
    rw [if_pos hcond1L, MonoidHom.one_apply, Units.val_one, mul_one]
  have hcond1K : condExp F K 1 = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl (fun _ _ => rfl))
  have heps1K :
      tateEps F K 1 (traceChar F hLK ψ) =
        (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) := by
    unfold tateEps
    rw [if_pos hcond1K, MonoidHom.one_apply, Units.val_one, mul_one]
  have hProd_LHS :
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
      (qL F L : Ω F) ^ condExpChar F L ψ * tateEps F L ν₁ ψ := by
    rw [hp2, Finset.prod_range_succ, Finset.prod_range_one, pow_zero ν₁, pow_one ν₁, heps1L]
  rw [hProd_LHS, heps1K, hProd_RHS]
  calc
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
        ((qL F L : Ω F) ^ condExpChar F L ψ * tateEps F L ν₁ ψ) =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        (tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
          tateEps F L ν₁ ψ) := by ring
    _ =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        ((qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          (Fintype.card k_L : Ω F) ^ (condExp F L χ') *
          (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
            (ν₁ c_ν₁ : Ω F) *
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
            ψ (((c_ν₁⁻¹ : Lˣ) : L)))) := by rw [hProd_K_ν₁]
    _ = _ := by ring

theorem ld_wild_stable_cond_odd_prime_ucorr_prefactor_cancel (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (h2ba : 2 * condExp F L ν₁ ≤ condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (c_χ' δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
      (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K))) =
      ((χ' c_χ' : Ω F) ^ p *
        (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ p) :=
by
  intro p
  set b := condExp F L ν₁
  set a := condExp F L χ'
  let K' := IntermediateField.extendScalars hLK
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have ha_ge4 : 4 ≤ a := by omega
  rcases hvalL_props with ⟨_, hval1_L, _, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, _, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨_, _, _, hval_neg_K, hval_mul_K,
    hval_inv_K, _, _, _, _, _⟩
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rw [hval_mul_L x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega
  have hval_le_L : ∀ {k₁ k₂ : ℤ} {x : L},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hval_le_K : ∀ {k₁ k₂ : ℤ} {y : K},
      k₁ ≤ k₂ → (y = 0 ∨ k₂ ≤ valL F K y) → (y = 0 ∨ k₁ ≤ valL F K y) := by
    intro k₁ k₂ y hle hy
    rcases hy with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have h1_add_ne_zero_L : ∀ {x : L}, (x = 0 ∨ 1 ≤ valL F L x) → 1 + x ≠ 0 := by
    intro x hx h0
    have h1_eq : (1 : L) = -x := eq_neg_of_add_eq_zero_left h0
    rcases hx with hx0 | hge
    · rw [hx0, neg_zero] at h1_eq; exact one_ne_zero h1_eq
    · have hv : valL F L (1 : L) = valL F L x := by rw [h1_eq, hval_neg_L]
      rw [hval1_L] at hv; omega
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have htrace_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    intro x y
    letI : Module L L := Semiring.toModule
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * Algebra.trace L K' (toExtendScalars F hLK y)
    rw [map_mul, hto_inc x, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  set w : K := - (IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
  set m_w : ℕ := (p - 1) * (a - b)
  set r_a : ℕ := (a + 1) / 2
  have hm_w_int : (m_w : ℤ) = ((p - 1 : ℕ) : ℤ) * ((a : ℤ) - (b : ℤ)) := by
    dsimp [m_w]; push_cast; congr 1; omega
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hb_t1_int : (b : ℤ) = (t + 1 : ℤ) := by omega
  have hw_val : valL F K w = (m_w : ℤ) := by
    dsimp [w]
    have hinc_ne : IntermediateField.inclusion hLK (δ : L) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne (Units.ne_zero δ)
    rw [hval_neg_K, hval_mul_K _ _ hinc_ne (Units.ne_zero _), hval_alg (δ : L),
      hval_inv_K u_K, hδ_val, hu_K_val, hm_w_int, hp_sub1_int]
    have hab_int : ((a - b : ℕ) : ℤ) = (a : ℤ) - (b : ℤ) := by omega
    rw [hab_int]; ring
  have hm_w_ge_a : a ≤ m_w := by
    have h1 : 2 * (a - b) ≤ (p - 1) * (a - b) :=
      Nat.mul_le_mul_right (a - b) (by omega)
    dsimp [m_w]; omega
  have hm_w_ge1 : 1 ≤ m_w := by omega
  have hr_a_ge1 : 1 ≤ r_a := by omega
  have htr1_ineq : (p : ℤ) * (r_a : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (m_w : ℤ) := by
    have h2ra_int : 2 * (r_a : ℤ) ≤ (a : ℤ) + 1 := by omega
    have hp_ge3_int : (3 : ℤ) ≤ (p : ℤ) := by omega
    have ha_ge4_int : (4 : ℤ) ≤ (a : ℤ) := by omega
    rw [hm_w_int, ← hb_t1_int, hp_sub1_int]
    nlinarith
  have htr2_ineq : (p : ℤ) * (a : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (2 * m_w : ℤ) := by
    have h_id : (p : ℤ) * (a : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) = (a : ℤ) + (m_w : ℤ) := by
      rw [hm_w_int, ← hb_t1_int, hp_sub1_int]; ring
    omega
  obtain ⟨z_w, hz_w_val, hnorm_1w⟩ :=
    hnorm_exp m_w hm_w_ge1 w (Or.inr (le_of_eq hw_val.symm))
  set t_w : L := traceLM F hLK w
  set t_z : L := traceLM F hLK z_w
  set n_w : L := normLM F hLK w
  have htw_val : t_w = 0 ∨ (r_a : ℤ) ≤ valL F L t_w :=
    htr_bound (r_a : ℤ) w (Or.inr (by linarith))
  have htz_val : t_z = 0 ∨ (a : ℤ) ≤ valL F L t_z :=
    htr_bound (a : ℤ) z_w (hval_le_K htr2_ineq hz_w_val)
  have hnw_val : n_w = 0 ∨ (a : ℤ) ≤ valL F L n_w := by
    right
    dsimp [n_w]
    rw [hval_norm w, hw_val]
    exact_mod_cast hm_w_ge_a
  have htznw_val : t_z + n_w = 0 ∨ (a : ℤ) ≤ valL F L (t_z + n_w) :=
    hval_add_L (a : ℤ) t_z n_w htz_val hnw_val
  have h1tw_ne : 1 + t_w ≠ 0 := h1_add_ne_zero_L (hval_le_L (by omega) htw_val)
  set u_tr : Lˣ := Units.mk0 (1 + t_w) h1tw_ne
  have hu_tr_mem : u_tr ∈ unitGroup F L r_a := by
    rw [hunit_ge1_L r_a hr_a_ge1 u_tr]
    have hsub : (u_tr : L) - 1 = t_w := by change (1 + t_w) - 1 = t_w; ring
    rw [hsub]
    rcases htw_val with h0 | hge
    · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
    · exact Or.inr hge
  have hu_tr_inv_val0 : valL F L (((u_tr⁻¹ : Lˣ) : L)) = 0 := by
    rw [hval_inv_L u_tr, hunit_val0_L r_a u_tr hu_tr_mem, neg_zero]
  set w_norm : Lˣ := Units.map (normLM F hLK) u_corr
  set w_err : Lˣ := w_norm * u_tr⁻¹
  have hw_corr_1w : (u_corr : K) = 1 + w := by
    rw [hu_corr_eq]; dsimp [w]; ring
  have hw_err_sub : (w_err : L) - 1 = (t_z + n_w) * (((u_tr⁻¹ : Lˣ) : L)) := by
    have hwn_coe : (w_norm : L) = 1 + t_w + t_z + n_w := by
      change normLM F hLK (u_corr : K) = 1 + t_w + t_z + n_w
      rw [hw_corr_1w, hnorm_1w, map_add (traceLM F hLK) w z_w]
      dsimp [t_w, t_z, n_w]; ring
    have h1 : (w_err : L) - 1 = ((w_norm : L) - (u_tr : L)) * (((u_tr⁻¹ : Lˣ) : L)) := by
      change (w_norm : L) * (((u_tr⁻¹ : Lˣ) : L)) - 1 = _
      rw [sub_mul, Units.mul_inv]
    rw [h1, hwn_coe]
    change (1 + t_w + t_z + n_w - (1 + t_w)) * (((u_tr⁻¹ : Lˣ) : L)) = _
    ring
  have hw_err_mem : w_err ∈ unitGroup F L a := by
    rw [hunit_ge1_L a (by omega) w_err]
    have hmul := hval_mul_ge_L (a : ℤ) 0 (t_z + n_w) (((u_tr⁻¹ : Lˣ) : L))
      htznw_val (Or.inr (by omega))
    rw [add_zero, ← hw_err_sub] at hmul
    rcases hmul with h0 | hge
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hge
  have hχ'_err : χ' w_err = 1 := ((hSpecL χ').2.2.1 (by omega)).1 w_err hw_err_mem
  have hχ'_ucorr : (χ' w_norm : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * t_w) := by
    have hdecomp : w_norm = w_err * u_tr := by dsimp [w_err]; group
    rw [hdecomp, map_mul, hχ'_err, one_mul, hc_χ'_stat t_w htw_val h1tw_ne]
  letI : Module L L := Semiring.toModule
  have hnorm_inc : Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK) c_χ') =
      c_χ' ^ p := by
    apply Units.ext
    change Algebra.norm L (algebraMap L K' (c_χ' : L)) = (c_χ' : L) ^ p
    exact Algebra.norm_algebraMap (c_χ' : L)
  have hχ'_cK : ((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) =
      (χ' c_χ' : Ω F) ^ p * ((χ' w_norm⁻¹ : (Ω F)ˣ) : Ω F) := by
    change (χ' (Units.map (normLM F hLK) c_K) : Ω F) = _
    rw [hc_K_eq, map_mul, map_inv, hnorm_inc, map_mul, map_pow, Units.val_mul,
      Units.val_pow_eq_pow_val]
  have htr_inc : traceLM F hLK (IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L))) =
      p • (((c_χ'⁻¹ : Lˣ) : L)) := by
    change Algebra.trace L K' (algebraMap L K' (((c_χ'⁻¹ : Lˣ) : L))) = p • (((c_χ'⁻¹ : Lˣ) : L))
    exact Algebra.trace_algebraMap (((c_χ'⁻¹ : Lˣ) : L))
  have hc_K_inv_coe : ((c_K⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L)) +
        IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L)) * w := by
    have hinv : c_K⁻¹ = u_corr * (Units.map (IntermediateField.inclusion hLK) c_χ')⁻¹ := by
      rw [hc_K_eq, mul_inv_rev, inv_inv]
    have hinc_inv : (((Units.map (IntermediateField.inclusion hLK) c_χ')⁻¹ : Kˣ) : K) =
        IntermediateField.inclusion hLK (((c_χ'⁻¹ : Lˣ) : L)) := rfl
    rw [hinv, Units.val_mul, hw_corr_1w, hinc_inv]
    ring
  have hψK_cK : (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) =
      (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ p * (χ' w_norm : Ω F) := by
    change ψ (traceLM F hLK (((c_K⁻¹ : Kˣ) : K))) = _
    rw [hc_K_inv_coe, map_add (traceLM F hLK), htr_inc, htrace_smul,
      AddChar.map_add_eq_mul, AddChar.map_nsmul_eq_pow, ← hχ'_ucorr]
  rw [hχ'_cK, hψK_cK]
  have hcancel : ((χ' w_norm⁻¹ : (Ω F)ˣ) : Ω F) * (χ' w_norm : Ω F) = 1 := by
    rw [map_inv, ← Units.val_mul, inv_mul_cancel, Units.val_one]
  calc ((χ' c_χ' : Ω F) ^ p * ((χ' w_norm⁻¹ : (Ω F)ˣ) : Ω F)) *
        ((ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ p * (χ' w_norm : Ω F))
    _ = ((χ' c_χ' : Ω F) ^ p * (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ p) *
          (((χ' w_norm⁻¹ : (Ω F)ˣ) : Ω F) * (χ' w_norm : Ω F)) := by ring
    _ = (χ' c_χ' : Ω F) ^ p * (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ p := by rw [hcancel, mul_one]

theorem ld_wild_stable_cond_odd_prime_case (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m,
      u ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∈ unitGroup F L (m + 1))
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (h2ba : 2 * condExp F L ν₁ ≤ condExp F L χ')
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      condExp F L ν₁ +
        Module.finrank L (IntermediateField.extendScalars hLK) *
          (condExp F L χ' - condExp F L ν₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hFinL : ∀ (a : ℕ), 1 ≤ a →
      Set.Finite {u : Lˣ ⧸ unitGroup F L a | valL F L ((cosetRep u : Lˣ) : L) = 0})
    (hOrtho : ∀ (a : ℕ), 1 ≤ a → ∀ (c : Lˣ),
      valL F L (c : L) = (a : ℤ) + condExpChar F L ψ →
      ∃ (N_A N_M : ℕ), 0 < N_A ∧
        ∀ (w : Lˣ ⧸ unitGroup F L a),
          valL F L ((cosetRep w : Lˣ) : L) = 0 →
          (∑ᶠ (v : Lˣ ⧸ unitGroup F L a) (_ : valL F L ((cosetRep v : Lˣ) : L) = 0),
            ψ (((c⁻¹ : Lˣ) : L) * (((cosetRep w : Lˣ) : L) - 1) * ((cosetRep v : Lˣ) : L))) =
            (if w = 1 then (N_A : Ω F) else 0) -
              (if cosetRep w ∈ unitGroup F L (a - 1) then (N_M : Ω F) else 0))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (hp_val : ((Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * condExp F L ν₁ /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))))
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (R_L : Finset L) (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_eq : ν₁ c_ν₁ = ν₁ c_χ')
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hnorm_to_tr : ∀ z : K, (z = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      ψ (((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hc_K_val : valL F K (c_K : K) =
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
        condExpChar F K (traceChar F hLK ψ))
    (hc_K_stat : ∀ y : K,
      (y = 0 ∨ (((condExp F K (χ'.comp (Units.map (normLM F hLK))) + 1) / 2 : ℕ) : ℤ) ≤
        valL F K y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y))
    (hrhs_stable : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      tateEps F L (ν₁ ^ j * χ') ψ =
        (((ν₁ ^ j) c_χ' : (Ω F)ˣ) : Ω F) * tateEps F L χ' ψ)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hSym : (∃ s : K → ℕ → L,
      (∀ y : K, s y 1 = traceLM F hLK y) ∧
      (∀ y : K, 2 * s y 2 = (traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2)) ∧
      (∀ y : K, y ≠ 0 →
        s y (Module.finrank L (IntermediateField.extendScalars hLK) - 1) =
          normLM F hLK y * traceLM F hLK (y⁻¹)) ∧
      (∀ (y : K) (r : ℕ),
        r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
        ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ) ≤ (r : ℤ) * q →
          (s y r = 0 ∨ m ≤ valL F L (s y r))) ∧
      (∀ (y : K) (c : L),
        normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
          1 +
            (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
              c ^ r * s y r) +
            c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y)) ∧
      (∀ (d_a d_K : ℕ),
        2 * d_K + (Module.finrank L (IntermediateField.extendScalars hLK) - 1) * (t + 1) =
          Module.finrank L (IntermediateField.extendScalars hLK) * (2 * d_a) +
            (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
        ∃ δ_K : Kˣ,
          valL F K (δ_K : K) = (d_K : ℤ) ∧
          (traceLM F hLK ((δ_K : K) ^ 2) -
              (-1 : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK) - 1) / 2) *
                ((ϖ_L : L) ^ (2 * d_a)) = 0 ∨
            (2 * d_a + 1 : ℤ) ≤
              valL F L
                (traceLM F hLK ((δ_K : K) ^ 2) -
                  (-1 : L) ^
                    ((Module.finrank L (IntermediateField.extendScalars hLK) - 1) / 2) *
                    ((ϖ_L : L) ^ (2 * d_a))))))
    (hFF_odd : ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
      ∀ (p : ℕ), Nat.Prime p → p ≠ 2 → (p : k_L) = 0 →
      ∀ (c : k_L), c ≠ 0 →
      ∀ (Q : k_L → Ω F),
        Q 0 = 1 →
        (∀ x y : k_L, Q (x + y) = Q x * Q y * ψ₀ (c * x * y)) →
        (∀ x : k_L, (Q x) ^ p = 1) →
        (∑ x : k_L, Q x) ^ p =
          (Fintype.card k_L : Ω F) ^ ((p - 1) / 2) *
            (∑ x : k_L, ψ₀ ((-1 : k_L) ^ ((p - 1) / 2) * (2 : k_L)⁻¹ * c * x ^ 2))) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  rcases hSym with ⟨⟨s, hs1, hs2, hsp1, hs_val, hs_poly⟩, hδK_ex⟩
  obtain ⟨hp_val1, hEpsK1, hNuProd⟩ :=
    ld_wild_mid_cond_odd_prime_nu_prod_eval F L K hLK hPrime hp_odd ψ hψ ν₁
      hν₁_pow hb_ge2 hν_cond_eq hqK hvalL_props hSpecL ϖ_L hϖ_L
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hp_val R_L c_ν₁ hRL_card hRL_int hRL_sep hRL_surj hc_ν₁_val hc_ν₁_stat hStat
  have hPref_eq :=
    ld_wild_stable_cond_odd_prime_ucorr_prefactor_cancel F L K hLK hPrime hp_odd ψ ν₁ χ'
      hb_ge2 hval_norm hval_alg h2ba hvalL_props hvalK_props hSpecL
      t hb_eq htr_bound hnorm_exp c_χ' δ u_K u_corr c_K
      hc_χ'_stat hu_K_val hδ_val hu_corr_eq hc_K_eq
  obtain ⟨P_L, hL_pow, hK_eval⟩ :=
    ld_wild_mid_cond_odd_prime_hasse_sum_eval F L K hLK hPrime hp_odd ψ hψ hψK ν₁ χ'
      hb_ge2 hqK hval_norm hval_alg hunit_pow_p (by omega) haK
      hvalL_props hvalK_props hSpecL ϖ_K ϖ_L hϖ_K hϖ_L hBasis
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t hb_eq hp_val1 R_L c_χ' c_ν₁ δ u_K u_corr c_K
      hRL_card hRL_int hRL_sep hRL_surj hc_χ'_val hc_χ'_stat
      hc_ν₁_val hδ_eq hu_K_norm hu_K_val hδ_val hnorm_to_tr hu_corr_eq hc_K_eq hc_K_val hc_K_stat
      hStat s hs1 hs2 hs_val hs_poly hδK_ex hFF_odd
  set p := Module.finrank L (IntermediateField.extendScalars hLK)
  have hsum_range : ∑ j ∈ Finset.range p, j = p * ((p - 1) / 2) := by
    rw [Finset.sum_range_id]
    obtain ⟨k, hk⟩ := hPrime.odd_of_ne_two hp_odd
    have hk_eq : (p - 1) / 2 = k := by omega
    have hp1 : p - 1 = 2 * k := by omega
    have hmul : p * (p - 1) = p * k * 2 := by
      rw [hp1]
      ring
    rw [hk_eq, hmul, Nat.mul_div_cancel _ (by decide)]
  have hRHS_prod :
      (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) =
        (tateEps F L χ' ψ) ^ p := by
    have hcongr :
        (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) =
          ∏ j ∈ Finset.range p,
            ((ν₁ c_χ' : Ω F) ^ j * tateEps F L χ' ψ) := by
      refine Finset.prod_congr rfl (fun j hj => ?_)
      rw [hrhs_stable j (Finset.mem_range.mp hj), MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
    have hpow_p : (ν₁ c_χ' : Ω F) ^ p = 1 := by
      rw [← Units.val_pow_eq_pow_val, ← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply,
        Units.val_one]
    rw [hcongr, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range,
      Finset.prod_pow_eq_pow_sum, hsum_range, pow_mul, hpow_p, one_pow, one_mul]
  rw [hNuProd, hEpsK1, hRHS_prod, hL_pow, ← hPref_eq]
  linear_combination
    ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p * hK_eval

theorem ld_ch10_fml_wild_stable_cond (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hRam : condExp F L ν₁ ≠ 0)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (h2ba : 2 * condExp F L ν₁ ≤ condExp F L χ')
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      condExp F L ν₁ +
        Module.finrank L (IntermediateField.extendScalars hLK) *
          (condExp F L χ' - condExp F L ν₁))
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L (ν₁ ^ j * χ') = condExp F L χ') :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalK_props := ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
