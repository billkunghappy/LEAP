theorem ld_ch13_norm_poly_operator_with_coeff_and_nextCoeff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ)
    (ζ : k) (hζ_ne : ζ ≠ 0) (hζ_pow : ζ ^ ℓ = 1)
    (hζ_prim : ∀ r : ℕ, 1 ≤ r → r < ℓ → ζ ^ r ≠ 1)
    (hζ_prod : (∏ m ∈ Finset.range ℓ, ζ ^ m) = (-1 : k) ^ (ℓ - 1))
    (M : ℕ → Finset (Polynomial k))
    (hM_mem : ∀ (d : ℕ) (f : Polynomial k), f ∈ M d ↔ f.Monic ∧ f.natDegree = d) :
    ∃ (σ : ℕ → Polynomial k → Polynomial k) (𝒩_ℓ : Polynomial k → Polynomial k),
      (∀ (m : ℕ) (P : Polynomial k) (n : ℕ),
        (σ m P).coeff n = (ζ⁻¹) ^ (m * P.natDegree) * (P.coeff n * (ζ ^ m) ^ n)) ∧
      (∀ (m d : ℕ) (P : Polynomial k), P ∈ M d → σ m P ∈ M d) ∧
      (∀ (m : ℕ) (f g : Polynomial k), f.Monic → g.Monic → σ m (f * g) = σ m f * σ m g) ∧
      (∀ (P : Polynomial k), P.Monic → σ 0 P = P) ∧
      (∀ (m₁ m₂ : ℕ) (P : Polynomial k), P.Monic →
        σ m₁ (σ m₂ P) = σ ((m₁ + m₂) % ℓ) P) ∧
      (∀ (m : ℕ) (Q : Polynomial k), Q.Monic →
        σ m (Polynomial.expand k ℓ Q) = Polynomial.expand k ℓ Q) ∧
      (∀ (m : ℕ) (P : Polynomial k), P.Monic → Irreducible P → Irreducible (σ m P)) ∧
      (∀ (d : ℕ) (P : Polynomial k), P ∈ M d →
        𝒩_ℓ P ∈ M d ∧
        Polynomial.expand k ℓ (𝒩_ℓ P) = ∏ m ∈ Finset.range ℓ, σ m P ∧
        (-1 : k) ^ d * (𝒩_ℓ P).coeff 0 = ((-1 : k) ^ d * P.coeff 0) ^ ℓ) ∧
      𝒩_ℓ 1 = 1 ∧
      (∀ f g : Polynomial k, f.Monic → g.Monic → 𝒩_ℓ (f * g) = 𝒩_ℓ f * 𝒩_ℓ g) ∧
      (∀ (c₀ : k) (H : Polynomial k), H ∈ M (ℓ - 1) →
        (𝒩_ℓ (Polynomial.X * H + Polynomial.C c₀)).nextCoeff =
          (𝒩_ℓ H).nextCoeff + (ℓ : k) * c₀) :=
by
  let τ : k → Polynomial k →+* Polynomial k := fun a =>
    Polynomial.eval₂RingHom Polynomial.C (Polynomial.C a * Polynomial.X)
  have hτ_coeff : ∀ (a : k) (P : Polynomial k) (n : ℕ), (τ a P).coeff n = P.coeff n * a ^ n := by
    intro a P
    induction' P using Polynomial.induction_on' with P Q hP hQ k₁ r
    · intro n
      rw [map_add, Polynomial.coeff_add, Polynomial.coeff_add, hP n, hQ n, add_mul]
    · intro n
      change (Polynomial.eval₂ Polynomial.C (Polynomial.C a * Polynomial.X) (Polynomial.monomial k₁ r)).coeff n =
        (Polynomial.monomial k₁ r).coeff n * a ^ n
      rw [Polynomial.eval₂_monomial, mul_pow,
        ← Polynomial.C.map_pow, ← mul_assoc, ← Polynomial.C.map_mul,
        Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, Polynomial.coeff_monomial]
      by_cases hnk : n = k₁
      · subst hnk
        rw [if_pos rfl, if_pos rfl, mul_one]
      · have hkn : k₁ ≠ n := Ne.symm hnk
        rw [if_neg hnk, if_neg hkn, mul_zero, zero_mul]
  have hτ_one : ∀ P : Polynomial k, τ 1 P = P := by
    intro P
    ext n
    rw [hτ_coeff, one_pow, mul_one]
  have hτ_comp : ∀ (a b : k) (P : Polynomial k), τ a (τ b P) = τ (a * b) P := by
    intro a b P
    ext n
    rw [hτ_coeff, hτ_coeff, hτ_coeff, mul_assoc, mul_comm (b ^ n), ← mul_pow]
  have hτ_C : ∀ (a c : k), τ a (Polynomial.C c) = Polynomial.C c := by
    intro a c
    exact Polynomial.eval₂_C _ _
  have hτ_expand : ∀ (a : k) (Q : Polynomial k),
      τ a (Polynomial.expand k ℓ Q) = Polynomial.expand k ℓ (τ (a ^ ℓ) Q) := by
    intro a Q
    ext n
    rw [hτ_coeff, Polynomial.coeff_expand hPrime.pos, Polynomial.coeff_expand hPrime.pos]
    by_cases hdvd : ℓ ∣ n
    · rw [if_pos hdvd, if_pos hdvd, hτ_coeff, ← pow_mul, Nat.mul_div_cancel' hdvd]
    · rw [if_neg hdvd, if_neg hdvd, zero_mul]
  have h_pow_mod : ∀ (x : k), x ^ ℓ = 1 → ∀ (N : ℕ), x ^ N = x ^ (N % ℓ) := by
    intro x hx N
    conv_lhs => rw [← Nat.div_add_mod N ℓ]
    rw [pow_add, pow_mul, hx, one_pow, one_mul]
  have hζ_inv_pow : (ζ⁻¹) ^ ℓ = 1 := by
    rw [inv_pow, hζ_pow, inv_one]
  let σ : ℕ → Polynomial k → Polynomial k := fun m P =>
    Polynomial.C ((ζ⁻¹) ^ (m * P.natDegree)) * τ (ζ ^ m) P
  have hσ_coeff : ∀ (m : ℕ) (P : Polynomial k) (n : ℕ),
      (σ m P).coeff n = (ζ⁻¹) ^ (m * P.natDegree) * (P.coeff n * (ζ ^ m) ^ n) := by
    intro m P n
    dsimp [σ]
    rw [Polynomial.coeff_C_mul, hτ_coeff]
  have hσ_mem : ∀ (m d : ℕ) (P : Polynomial k), P ∈ M d → σ m P ∈ M d := by
    intro m d P hP
    obtain ⟨hP_mon, hP_deg⟩ := (hM_mem d P).mp hP
    have h_le : (σ m P).natDegree ≤ d := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro n hn
      rw [hσ_coeff, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul, mul_zero]
    have h_coeff_d : (σ m P).coeff d = 1 := by
      rw [hσ_coeff, hP_deg]
      have h_lead : P.coeff d = 1 := by
        rw [← hP_deg]
        exact hP_mon.leadingCoeff
      rw [h_lead, one_mul, ← pow_mul, ← mul_pow, inv_mul_cancel₀ hζ_ne, one_pow]
    have h_ge : d ≤ (σ m P).natDegree := by
      apply Polynomial.le_natDegree_of_ne_zero
      rw [h_coeff_d]
      exact one_ne_zero
    have h_deg : (σ m P).natDegree = d := le_antisymm h_le h_ge
    have h_mon : (σ m P).Monic := by
      rw [Polynomial.Monic.def, Polynomial.leadingCoeff, h_deg, h_coeff_d]
    exact (hM_mem d (σ m P)).mpr ⟨h_mon, h_deg⟩
  have hσ_mul : ∀ (m : ℕ) (f g : Polynomial k), f.Monic → g.Monic → σ m (f * g) = σ m f * σ m g := by
    intro m f g hf hg
    dsimp [σ]
    rw [hf.natDegree_mul hg, mul_add, pow_add, Polynomial.C.map_mul, map_mul, mul_mul_mul_comm]
  have hσ_zero : ∀ (P : Polynomial k), P.Monic → σ 0 P = P := by
    intro P _
    dsimp [σ]
    rw [zero_mul, pow_zero, pow_zero, map_one, one_mul, hτ_one]
  have hσ_add : ∀ (m₁ m₂ : ℕ) (P : Polynomial k), P.Monic →
      σ m₁ (σ m₂ P) = σ ((m₁ + m₂) % ℓ) P := by
    intro m₁ m₂ P hP
    have hP_mem : P ∈ M P.natDegree := (hM_mem P.natDegree P).mpr ⟨hP, rfl⟩
    have hσ₂_deg : (σ m₂ P).natDegree = P.natDegree :=
      ((hM_mem P.natDegree (σ m₂ P)).mp (hσ_mem m₂ P.natDegree P hP_mem)).2
    dsimp [σ]
    rw [hσ₂_deg, map_mul, hτ_C, hτ_comp, ← mul_assoc, ← Polynomial.C.map_mul,
      ← pow_add, ← add_mul, ← pow_add]
    congr 2
    · rw [h_pow_mod (ζ⁻¹) hζ_inv_pow ((m₁ + m₂) * P.natDegree),
        h_pow_mod (ζ⁻¹) hζ_inv_pow (((m₁ + m₂) % ℓ) * P.natDegree)]
      congr 1
      rw [Nat.mul_mod ((m₁ + m₂) % ℓ), Nat.mod_mod, ← Nat.mul_mod]
    · rw [h_pow_mod ζ hζ_pow (m₁ + m₂)]
  have hσ_expand : ∀ (m : ℕ) (Q : Polynomial k), Q.Monic →
      σ m (Polynomial.expand k ℓ Q) = Polynomial.expand k ℓ Q := by
    intro m Q _
    dsimp [σ]
    rw [Polynomial.natDegree_expand, ← mul_assoc, pow_mul' (ζ⁻¹), hζ_inv_pow, one_pow,
      map_one, one_mul, hτ_expand, ← pow_mul, pow_mul' ζ, hζ_pow, one_pow, hτ_one]
