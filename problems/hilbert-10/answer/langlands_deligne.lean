    have hN1_mem : 𝒩_ℓ 1 ∈ M 0 := (h𝒩_prop 0 1 h1_mem).1
    obtain ⟨hN1_mon, hN1_deg⟩ := (hM_mem 0 (𝒩_ℓ 1)).mp hN1_mem
