      rw [hc₂_fg]
      change (f * g).coeff k = _
      rw [Polynomial.coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ (fun i j => f.coeff i * g.coeff j) k]
    have hterm_m1 : term (m - 1) = f.nextCoeff * g.nextCoeff := by
      dsimp only [term]
      have hkm1 : k - (m - 1) = n - 1 := by omega
      have hfm_pos : 0 < f.natDegree := by omega
      have hgn_pos : 0 < g.natDegree := by omega
      rw [hkm1, ← Polynomial.nextCoeff_of_natDegree_pos hfm_pos,
        ← Polynomial.nextCoeff_of_natDegree_pos hgn_pos]
