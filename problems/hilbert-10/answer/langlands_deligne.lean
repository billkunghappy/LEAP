theorem ld_ch12_bicyclic_tot_ram_galois_conjugate_twists_and_norm_trans (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    let θE' := recChar F rec E' χE'
    let θM₁' := recChar F rec M₁' χM₁'
    (∀ j < ℓ,
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        (∀ y : E'ˣ,
          Units.map (normLM F hLE') (Units.map σ.toRingEquiv.toMonoidHom y) =
            Units.map (normLM F hLE') y) ∧
        ∀ y : E'ˣ, (ξE' ^ j * θE') y = θE' (Units.map σ.toRingEquiv.toMonoidHom y)) ∧
    (∀ j < ℓ,
      ∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        (∀ z : M₁'ˣ,
          Units.map (normLM F hLM₁') (Units.map τ.toRingEquiv.toMonoidHom z) =
            Units.map (normLM F hLM₁') z) ∧
        ∀ z : M₁'ˣ, (ξM₁' ^ j * θM₁') z = θM₁' (Units.map τ.toRingEquiv.toMonoidHom z)) ∧
    (∀ w : K₁ˣ,
      Units.map (normLM F hLE') (Units.map (normLM F hE'K₁) w) =
        Units.map (normLM F hLM₁') (Units.map (normLM F hM₁'K₁) w)) ∧
    (∀ x : Lˣ,
      Units.map (normLM F hLE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
        x ^ ℓ ∧
      Units.map (normLM F hLM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) =
        x ^ ℓ) :=
by
  intro ℓ ξE' ξM₁' θE' θM₁'
  
  have hTwistFromGen : ∀ (A : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A)
      (hp : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLA)))
      (ξA θA : Aˣ →* (Ω F)ˣ)
      (hξA_pow : ξA ^ (Module.finrank L (IntermediateField.extendScalars hLA)) = 1)
      (σ₀ : A ≃ₐ[F] A) (j₀ : ℕ)
      (hj₀_pos : 0 < j₀)
      (hj₀_lt : j₀ < Module.finrank L (IntermediateField.extendScalars hLA))
      (hσ₀_L : ∀ x : L, σ₀ (IntermediateField.inclusion hLA x) = IntermediateField.inclusion hLA x)
      (hFrobTwist : ∀ (r : ℕ) (y : Aˣ),
        θA (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom y) = (ξA y) ^ (r * j₀) * θA y),
      ∀ j < Module.finrank L (IntermediateField.extendScalars hLA),
        ∃ σ : A ≃ₐ[F] A,
          (∀ x : L, σ (IntermediateField.inclusion hLA x) = IntermediateField.inclusion hLA x) ∧
          (∀ y : Aˣ,
            Units.map (normLM F hLA) (Units.map σ.toRingEquiv.toMonoidHom y) =
              Units.map (normLM F hLA) y) ∧
          ∀ y : Aˣ, (ξA ^ j * θA) y = θA (Units.map σ.toRingEquiv.toMonoidHom y) := by
    intro A hLA hp ξA θA hξA_pow σ₀ j₀ hj₀_pos hj₀_lt hσ₀_L hFrobTwist
    set p := Module.finrank L (IntermediateField.extendScalars hLA)
    have hσ₀_pow_L : ∀ (r : ℕ) (x : L),
        (σ₀ ^ r) (IntermediateField.inclusion hLA x) = IntermediateField.inclusion hLA x := by
      intro r
      induction' r with r ih
      · intro x; rfl
      · intro x
        rw [pow_succ', AlgEquiv.mul_apply, ih x, hσ₀_L x]
    let τ_r : ℕ → (IntermediateField.extendScalars hLA) ≃ₐ[L] (IntermediateField.extendScalars hLA) :=
      fun r =>
        { toFun := fun z =>
            ⟨((σ₀ ^ r) ⟨z.1, (IntermediateField.mem_extendScalars hLA).mp z.2⟩).1,
              (IntermediateField.mem_extendScalars hLA).mpr ((σ₀ ^ r) _).2⟩
          invFun := fun z =>
            ⟨((σ₀ ^ r).symm ⟨z.1, (IntermediateField.mem_extendScalars hLA).mp z.2⟩).1,
              (IntermediateField.mem_extendScalars hLA).mpr ((σ₀ ^ r).symm _).2⟩
          left_inv := fun z => Subtype.ext (congrArg Subtype.val ((σ₀ ^ r).left_inv _))
          right_inv := fun z => Subtype.ext (congrArg Subtype.val ((σ₀ ^ r).right_inv _))
          map_mul' := fun z₁ z₂ => Subtype.ext (congrArg Subtype.val (map_mul (σ₀ ^ r) _ _))
          map_add' := fun z₁ z₂ => Subtype.ext (congrArg Subtype.val (map_add (σ₀ ^ r) _ _))
          commutes' := fun a => Subtype.ext (congrArg Subtype.val (hσ₀_pow_L r a)) }
    have hnorm_σ_r : ∀ (r : ℕ) (y : Aˣ),
        Units.map (normLM F hLA) (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom y) =
          Units.map (normLM F hLA) y := by
      intro r y
      apply Units.ext
      change normLM F hLA ((σ₀ ^ r) y.1) = normLM F hLA y.1
      have h_ext : toExtendScalars F hLA ((σ₀ ^ r) y.1) = τ_r r (toExtendScalars F hLA y.1) := rfl
      unfold normLM
      rw [MonoidHom.comp_apply, MonoidHom.comp_apply, RingHom.toMonoidHom_eq_coe,
        MonoidHom.coe_coe, h_ext]
      exact Algebra.norm_eq_of_algEquiv (τ_r r) (toExtendScalars F hLA y.1)
    let f_j₀ : Fin p → Fin p := fun r => ⟨(r.1 * j₀) % p, Nat.mod_lt _ hp.pos⟩
    have hf_inj : Function.Injective f_j₀ := by
      have h_le : ∀ r₁ r₂ : Fin p, r₂.1 ≤ r₁.1 → f_j₀ r₁ = f_j₀ r₂ → r₁ = r₂ := by
        intro r₁ r₂ hle heq
        have hmod : (r₁.1 * j₀) % p = (r₂.1 * j₀) % p := congrArg Fin.val heq
        have hdvd : p ∣ (r₁.1 - r₂.1) * j₀ := by
          rw [Nat.sub_mul]
          exact (Nat.modEq_iff_dvd' (Nat.mul_le_mul_right j₀ hle)).mp hmod.symm
        have hnot_dvd : ¬ p ∣ j₀ := Nat.not_dvd_of_pos_of_lt hj₀_pos hj₀_lt
        have hdvd_sub : p ∣ r₁.1 - r₂.1 :=
          (hp.dvd_mul.mp hdvd).resolve_right hnot_dvd
        have hsub_lt : r₁.1 - r₂.1 < p := Nat.lt_of_le_of_lt (Nat.sub_le r₁.1 r₂.1) r₁.2
        have hsub0 : r₁.1 - r₂.1 = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_sub hsub_lt
        ext
        omega
      intro r₁ r₂ heq
      rcases le_total r₂.1 r₁.1 with hle | hle
      · exact h_le r₁ r₂ hle heq
      · exact (h_le r₂ r₁ hle heq.symm).symm
    have hf_bij : Function.Bijective f_j₀ :=
      (Fintype.bijective_iff_injective_and_card f_j₀).mpr ⟨hf_inj, rfl⟩
    intro j hj
    obtain ⟨r, hr⟩ := hf_bij.2 ⟨j, hj⟩
    have hr_val : (r.1 * j₀) % p = j := congrArg Fin.val hr
    refine ⟨σ₀ ^ r.1, hσ₀_pow_L r.1, hnorm_σ_r r.1, fun y => ?_⟩
    have hξ_pow : (ξA y) ^ p = 1 := by
      rw [← MonoidHom.pow_apply, hξA_pow, MonoidHom.one_apply]
    have h_mod : (ξA y) ^ (r.1 * j₀) = (ξA y) ^ ((r.1 * j₀) % p) := by
      conv_lhs => rw [← Nat.div_add_mod (r.1 * j₀) p]
      rw [pow_add, pow_mul, hξ_pow, one_pow, one_mul]
    rw [MonoidHom.mul_apply, MonoidHom.pow_apply, ← hr_val, ← h_mod, (hFrobTwist r.1 y).symm]
  
  have hξE'_pow : ξE' ^ ℓ = 1 := by
    apply MonoidHom.ext
    intro y
    change (νM₁' (Units.map (normLM F hLE') y)) ^ ℓ = 1
    rw [← MonoidHom.pow_apply, hνM₁'_pow, MonoidHom.one_apply]
  have hξM₁'_pow : ξM₁' ^ ℓ = 1 := by
    apply MonoidHom.ext
    intro z
    change (νE' (Units.map (normLM F hLM₁') z)) ^ ℓ = 1
    rw [← MonoidHom.pow_apply, hνE'_pow, MonoidHom.one_apply]
  obtain ⟨_, τ₀, j₀, hj₀_pos, hj₀_lt, hτ₀_L, _, _, _, hτ₀_twist⟩ :=
    ld_ch12_bicyclic_frob_generator_and_conj_twist F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hPrime hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf h_sup
      χK₁ hInvK₁ hneK₁ χM₁' hχM₁'_weil hχM₁'_rest ψ hψ νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνM₁'_pow hνM₁'_ne hνM₁'_ker
  have hPrime_M₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) :=
    hdegM₁'.symm ▸ hPrime
  have hTwistsM₁' : ∀ j < ℓ,
      ∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        (∀ z : M₁'ˣ,
          Units.map (normLM F hLM₁') (Units.map τ.toRingEquiv.toMonoidHom z) =
            Units.map (normLM F hLM₁') z) ∧
        ∀ z : M₁'ˣ, (ξM₁' ^ j * θM₁') z = θM₁' (Units.map τ.toRingEquiv.toMonoidHom z) := by
    intro j hj
    exact hTwistFromGen M₁' hLM₁' hPrime_M₁' ξM₁' θM₁' (hdegM₁'.symm ▸ hξM₁'_pow)
      τ₀ j₀ hj₀_pos (hdegM₁'.symm ▸ hj₀_lt) hτ₀_L hτ₀_twist j (hdegM₁'.symm ▸ hj)
  have h_inf_symm : M₁' ⊓ E' = L := (inf_comm M₁' E').trans h_inf
  have h_sup_symm : M₁' ⊔ E' = K₁ := (sup_comm M₁' E').trans h_sup
  obtain ⟨_, σ₀, i₀, hi₀_pos, hi₀_lt, hσ₀_L, _, _, _, hσ₀_twist⟩ :=
    ld_ch12_bicyclic_frob_generator_and_conj_twist F rec L M₁' E' K₁
      hLM₁' hLE' hM₁'K₁ hE'K₁ hGalLK₁ hGalLM₁' hGalLE' hGalM₁'K₁ hGalE'K₁
      hAbLM₁' hAbLE' hPrime_M₁' hdegM₁'.symm
      (hdegM₁'K₁.trans hdegM₁'.symm) (hdegE'K₁.trans hdegM₁'.symm)
      h_inf_symm h_sup_symm χK₁ hInvK₁ hneK₁ χE' hχE'_weil hχE'_rest ψ hψ νM₁' νE'
      (hdegM₁'.symm ▸ hνM₁'_pow) hνM₁'_ne hνM₁'_ker
      (hdegM₁'.symm ▸ hνE'_pow) hνE'_ne hνE'_ker
  have hTwistsE' : ∀ j < ℓ,
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        (∀ y : E'ˣ,
          Units.map (normLM F hLE') (Units.map σ.toRingEquiv.toMonoidHom y) =
            Units.map (normLM F hLE') y) ∧
        ∀ y : E'ˣ, (ξE' ^ j * θE') y = θE' (Units.map σ.toRingEquiv.toMonoidHom y) := by
    intro j hj
    exact hTwistFromGen E' hLE' hPrime ξE' θE' hξE'_pow
      σ₀ i₀ hi₀_pos (hdegM₁' ▸ hi₀_lt) hσ₀_L hσ₀_twist j hj
  
  have h_norm_trans_gen : ∀ (A B C : IntermediateField F (AlgebraicClosure F))
      (hAB : A ≤ B) (hBC : B ≤ C) (u : C),
      normLM F hAB (normLM F hBC u) = normLM F (hAB.trans hBC) u := by
    intro A B C hAB hBC u
    have hAC : A ≤ C := hAB.trans hBC
    let S_AB := IntermediateField.extendScalars hAB
    let S_BC := IntermediateField.extendScalars hBC
    let S_AC := IntermediateField.extendScalars hAC
    let f_BC : B →+* S_AC :=
      { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAC).mpr (hBC z.2)⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let f_SAB : S_AB →+* S_AC :=
      { toFun := fun z =>
          ⟨z.1, (IntermediateField.mem_extendScalars hAC).mpr
            (hBC ((IntermediateField.mem_extendScalars hAB).mp z.2))⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    letI algB : Algebra ↥B ↥S_AC := RingHom.toAlgebra f_BC
    letI : SMul ↥B ↥S_AC := @Algebra.toSMul ↥B ↥S_AC _ _ algB
    letI algSAB : Algebra ↥S_AB ↥S_AC := RingHom.toAlgebra f_SAB
    letI : SMul ↥S_AB ↥S_AC := @Algebra.toSMul ↥S_AB ↥S_AC _ _ algSAB
    haveI : IsScalarTower ↥A ↥S_AB ↥S_AC := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let e_BC : S_BC ≃ₐ[B] S_AC :=
      { toFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hAC).mpr
            ((IntermediateField.mem_extendScalars hBC).mp x.2)⟩
        invFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hBC).mpr
            ((IntermediateField.mem_extendScalars hAC).mp x.2)⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    let e_B : B ≃+* S_AB :=
      { toExtendScalars F hAB with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    let u_BC : S_BC := toExtendScalars F hBC u
    let u_AC : S_AC := toExtendScalars F hAC u
    have h1 : Algebra.norm B u_AC = normLM F hBC u :=
      Algebra.norm_eq_of_algEquiv e_BC u_BC
    have h2 : toExtendScalars F hAB (Algebra.norm B u_AC) = Algebra.norm S_AB u_AC :=
      Algebra.norm_eq_of_ringEquiv e_B (RingHom.ext fun _ => rfl) u_AC
    have h3 : Algebra.norm A (Algebra.norm S_AB u_AC) = normLM F hAC u :=
      Algebra.norm_norm
    change Algebra.norm A (toExtendScalars F hAB (normLM F hBC u)) = normLM F hAC u
    rw [← h1, h2, h3]
  have hNormTrans : ∀ w : K₁ˣ,
      Units.map (normLM F hLE') (Units.map (normLM F hE'K₁) w) =
        Units.map (normLM F hLM₁') (Units.map (normLM F hM₁'K₁) w) := by
    intro w
    apply Units.ext
    change normLM F hLE' (normLM F hE'K₁ w.1) = normLM F hLM₁' (normLM F hM₁'K₁ w.1)
    have h1 := h_norm_trans_gen L E' K₁ hLE' hE'K₁ w.1
    have h2 := h_norm_trans_gen L M₁' K₁ hLM₁' hM₁'K₁ w.1
    have h_eq : hLE'.trans hE'K₁ = hLM₁'.trans hM₁'K₁ := rfl
    rw [h1, h_eq, ← h2]
  have hNormInc : ∀ x : Lˣ,
      Units.map (normLM F hLE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
        x ^ ℓ ∧
      Units.map (normLM F hLM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) =
        x ^ ℓ := by
    intro x
    refine ⟨?_, ?_⟩
    · apply Units.ext
      rw [Units.val_pow_eq_pow_val]
      change Algebra.norm L (algebraMap L (IntermediateField.extendScalars hLE') x.1) =
        x.1 ^ (Module.finrank L (IntermediateField.extendScalars hLE'))
      exact Algebra.norm_algebraMap x.1
    · apply Units.ext
      rw [Units.val_pow_eq_pow_val]
      dsimp only [ℓ]
      rw [← hdegM₁']
      change Algebra.norm L (algebraMap L (IntermediateField.extendScalars hLM₁') x.1) =
        x.1 ^ (Module.finrank L (IntermediateField.extendScalars hLM₁'))
      exact Algebra.norm_algebraMap x.1
  exact ⟨hTwistsE', hTwistsM₁', hNormTrans, hNormInc⟩

theorem ld_wild_odd_single_ext_min_cond_and_deep_norm_triv (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L A : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F A]
    (hLA : L ≤ A) (hGalLA : IsGaloisExt F L A)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLA)))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLA) = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψA : IsAdmissibleChar F A (traceChar F hLA ψ))
    (νA : Lˣ →* (Ω F)ˣ)
    (hνA_pow : νA ^ (Module.finrank L (IntermediateField.extendScalars hLA)) = 1)
    (hνA_ne : νA ≠ 1)
    (hνA_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLA)) ↔ νA x = 1)
    (hνA_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLA),
      ∀ u ∈ unitGroup F L (condExp F L (νA ^ j)), (νA ^ j) u = 1)
    (hbA_ge2 : 2 ≤ condExp F L νA)
    (ξA θA : Aˣ →* (Ω F)ˣ)
    (hbξ_ge2 : 2 ≤ condExp F A ξA)
    (hξA_cond : ∀ u ∈ unitGroup F A (condExp F A ξA), ξA u = 1)
    (hθA_cond : ∀ u ∈ unitGroup F A (condExp F A θA), θA u = 1)
    (σ : A ≃ₐ[F] A)
    (hσ_L : ∀ x : L, σ (IntermediateField.inclusion hLA x) = IntermediateField.inclusion hLA x)
    (hσ_twist : ∀ y : Aˣ, (ξA * θA) y = θA (Units.map σ.toRingEquiv.toMonoidHom y)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLA)
    let bA := condExp F L νA
    let bξ := condExp F A ξA
    let mA := bA + bξ - 1
    mA ≤ condExp F A θA ∧
    (∀ w ∈ unitGroup F A mA,
      Units.map (normLM F hLA) w ∈ unitGroup F L (bA + condExp F A θA) →
      θA w = 1) ∧
    (∀ w ∈ unitGroup F A bA,
      Units.map (normLM F hLA) w ∈ unitGroup F L bA) ∧
    (∀ r ≥ bA, ∀ w ∈ unitGroup F A (bA + p * (r - (bA - 1))),
      Units.map (normLM F hLA) w ∈ unitGroup F L (r + 1)) :=
by
  intro p bA bξ mA
  let A' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLA
  haveI : FiniteDimensional F A' := ‹FiniteDimensional F A›
  haveI : IsScalarTower F L A' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L A' := Module.Finite.of_restrictScalars_finite F L A'
  letI : Module L L := Semiring.toModule
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega

  
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalA_props := ld_valL_and_unitGroup_props F A
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
