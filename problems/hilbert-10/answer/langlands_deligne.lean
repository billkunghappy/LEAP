      have hx₀_pow_eq : x₀ ^ q = (((u_EL⁻¹) ^ q : Lˣ) : L) * (x ^ q) := by
        dsimp only [x₀]
        rw [mul_pow, Units.val_pow_eq_pow_val]
      have hx_pow := hresL_pow x q hx_int
      have hx₀_pow_int : PL 0 (x₀ ^ q) := (hresL_pow x₀ q hx₀_int).1
      have hx₀_pow_res : resL (x₀ ^ q) = (resL (u_E_norm : L))⁻¹ * (a ^ q) := by
        rw [hx₀_pow_eq,
          (hresL_ring (((u_EL⁻¹) ^ q : Lˣ) : L) (x ^ q) hu_EL_inv_pow_int hx_pow.1).2.1,
          hu_EL_inv_pow_res, hx_pow.2, hliftL_res a]
      change ψ_0E (resE (IntermediateField.inclusion hLE x)) = _
      rw [hstat_resE (IntermediateField.inclusion hLE x) (hinc_int hx_int),
        h_val_E (IntermediateField.inclusion hLE x),
        hc_E_psi y₀ hy₀_int x₀ hx₀_int hyx₀,
        ← hψ_ref_spec (x₀ ^ q) hx₀_pow_int, hx₀_pow_res]
    unfold oddStatGaussFactor
    rw [if_pos hodd, hqE]
    have hsum_reindex1 :
        (∑ y : k_E, ψ_0E ((-1 : k_E) ^ ((p F - 1) / 2) * (2 : k_E)⁻¹ * (y ^ 2))) =
          (∑ b : k_L, ψ_0E ((-1 : k_E) ^ ((p F - 1) / 2) * (2 : k_E)⁻¹ * ((e_EL b) ^ 2))) :=
      (Equiv.sum_comp e_EL
        (fun y : k_E => ψ_0E ((-1 : k_E) ^ ((p F - 1) / 2) * (2 : k_E)⁻¹ * (y ^ 2)))).symm
    have hsum_step2 :
        (∑ b : k_L, ψ_0E ((-1 : k_E) ^ ((p F - 1) / 2) * (2 : k_E)⁻¹ * ((e_EL b) ^ 2))) =
          (∑ b : k_L,
            ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ *
              ((resL (u_E_norm : L))⁻¹ * ((e_frob b) ^ 2)))) := by
      refine Finset.sum_congr rfl fun b _ => ?_
      have h_map_EL :
          (-1 : k_E) ^ ((p F - 1) / 2) * (2 : k_E)⁻¹ * ((e_EL b) ^ 2) =
            ι_EL ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (b ^ 2)) := by
        rw [he_EL_apply, map_mul, map_mul, map_pow, map_neg, map_one,
          map_inv₀, map_ofNat, map_pow]
      have h_map_frob :
          ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (b ^ 2)) ^ q =
            (-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * ((e_frob b) ^ 2) := by
        change frob_q ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (b ^ 2)) = _
        rw [he_frob_apply, map_mul, map_mul, map_pow, map_neg, map_one,
          map_inv₀, map_ofNat, map_pow]
      rw [h_map_EL, hψ0E_eq, h_map_frob]
      congr 1
      ring
    have hsum_reindex2 :
        (∑ b : k_L,
          ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ *
            ((resL (u_E_norm : L))⁻¹ * ((e_frob b) ^ 2)))) =
          (∑ x : k_L,
            ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ *
              ((resL (u_E_norm : L))⁻¹ * (x ^ 2)))) :=
      Equiv.sum_comp e_frob
        (fun x : k_L =>
          ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ *
            ((resL (u_E_norm : L))⁻¹ * (x ^ 2))))
    have hscale := hG_L_scale ((resL (u_E_norm : L))⁻¹) (inv_ne_zero hu_E_norm_res)
    have hquad_inv :
        quadraticChar k_L ((resL (u_E_norm : L))⁻¹) =
          quadraticChar k_L (resL (u_E_norm : L)) := by
      set u₀ := resL (u_E_norm : L)
      have h1 : u₀⁻¹ * u₀ ^ 2 = u₀ := by
        rw [sq, inv_mul_cancel_left₀ hu_E_norm_res]
      calc quadraticChar k_L (u₀⁻¹)
          = quadraticChar k_L (u₀⁻¹) * 1 := (mul_one _).symm
        _ = quadraticChar k_L (u₀⁻¹) * quadraticChar k_L (u₀ ^ 2) := by
            rw [quadraticChar_sq_one' hu_E_norm_res]
        _ = quadraticChar k_L (u₀⁻¹ * u₀ ^ 2) := (map_mul (quadraticChar k_L) _ _).symm
        _ = quadraticChar k_L u₀ := by rw [h1]
    rw [hsum_reindex1, hsum_step2, hsum_reindex2, hscale, hquad_inv]
    change (qL F L : Ω F) ^ ((p F - 1) / 2) *
        (((quadraticChar k_L (resL (u_E_norm : L)) : ℤ) : Ω F) * G_L) =
      ((quadraticChar k_L (resL (u_E_norm : L)) : ℤ) : Ω F) *
        ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)
    ring

  exact ⟨hu_E_norm_val, hu_E_norm_res, hodd_E_gauss⟩

theorem ld_ch14_odd_p_twisted_orbit_conductor_regimes (F : Type u) [Field F]
