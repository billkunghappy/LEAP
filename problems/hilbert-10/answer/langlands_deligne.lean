          rw [hσ₀_val]
          exact hge
      rw [hid]
      exact val_add_ge h1 hd_frob
  have h_sep : ∀ j k : ℕ, j < k → k < p →
      (σ₀ ^ k) d - (σ₀ ^ j) d ≠ 0 ∧ valL F M₁' ((σ₀ ^ k) d - (σ₀ ^ j) d) = 0 := by
    intro j k hjk hkp
    set r : ℕ := k - j
    have hr_pos : 0 < r := by omega
    have hr_lt : r < p := by omega
    have hk_eq : k = j + r := by omega
    obtain ⟨hr_ne_cast, hr_val_cast⟩ := hcoprime_unit r hr_pos hr_lt
    obtain ⟨hr_ne, hr_val⟩ := val_eq_zero_of_sub_ge_one
      hr_ne_cast hr_val_cast (val_mono hb_p_ge1 (hσ₀_r_d r))
    have hshift : (σ₀ ^ k) d - (σ₀ ^ j) d = (σ₀ ^ j) ((σ₀ ^ r) d - d) := by
      rw [hk_eq, pow_add, AlgEquiv.mul_apply, map_sub]
    rw [hshift]
    refine ⟨?_, ?_⟩
    · intro h0
      rw [← map_zero (σ₀ ^ j)] at h0
      exact hr_ne ((σ₀ ^ j).injective h0)
    · rw [hσ₀_pow_val j, hr_val]
  exact ⟨hσ₀_pow_p, c, d, hc_int, hd_val, hd_AS, hd_frob, hd_pow_frob, h_sep⟩

theorem ld_wild_odd_unramified_as_poly_remainder_and_norm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = (p : ℤ) * valL F M₁' z)
    (y₁ : M₁') (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (hσ₀_L : ∀ x : L,
      σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range p, (σ₀ ^ k) z)
    (hσ₀_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
      ∏ k ∈ Finset.range p, (σ₀ ^ k) z)
    (hσ₀_pow : ∀ z : M₁', (σ₀ ^ p) z = z)
    (c : L) (d : M₁')
    (hd_val : valL F M₁' d = 0)
    (hd_AS : d ^ p - d - IntermediateField.inclusion hLM₁' c = 0 ∨
      (2 * (T : ℤ) + 1) ≤ valL F M₁' (d ^ p - d - IntermediateField.inclusion hLM₁' c))
    (hd_sep : ∀ j k : ℕ, j < k → k < p →
      (σ₀ ^ k) d - (σ₀ ^ j) d ≠ 0 ∧
      valL F M₁' ((σ₀ ^ k) d - (σ₀ ^ j) d) = 0) :
    valL F L c = 0 ∧
    ∃ r : ℕ → L,
      (∀ i : ℕ, r i = 0 ∨ (2 * (T : ℤ) + 1) ≤ valL F L (r i)) ∧
      ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
        (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
          ∑ i ∈ Finset.range p,
            Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i :=
by
  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, _, _, hvalL_add, _, _, _⟩ := hvalL_props
  obtain ⟨hvalM_0, hvalM_1, hvalM_neg1, hvalM_neg, hvalM_mul, _, _, hvalM_add, _, _, _⟩ := hvalM_props
  have valL_neg_ge : ∀ {k : ℤ} {x : L},
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right
      rw [hvalL_neg x]
      exact hx
  have valL_add_ge : ∀ {k : ℤ} {x y : L},
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
    intro k x y hx hy
    exact hvalL_add k x y hx hy
  have valL_sub_ge : ∀ {k : ℤ} {x y : L},
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact valL_add_ge hx (valL_neg_ge hy)
  have valL_mono : ∀ {k₁ k₂ : ℤ} {x : L},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hk hx
    exact hx.imp_right (le_trans hk)
  have valL_eq_zero_of_sub_ge_one : ∀ {z w : L},
      z ≠ 0 → valL F L z = 0 →
      (w - z = 0 ∨ (1 : ℤ) ≤ valL F L (w - z)) →
        valL F L w = 0 := by
    intro z w hz_ne hz_val hwz
    have hz_int : z = 0 ∨ 0 ≤ valL F L z := Or.inr (by omega)
    have hwz_int : w - z = 0 ∨ 0 ≤ valL F L (w - z) := valL_mono (by omega) hwz
    have hw_int : w = 0 ∨ 0 ≤ valL F L w := by
      have h := valL_add_ge hz_int hwz_int
      have hid : z + (w - z) = w := by ring
      rw [hid] at h
      exact h
    have hnot1 : ¬ (w = 0 ∨ 1 ≤ valL F L w) := by
      intro hw1
      have h := valL_sub_ge hw1 hwz
      have hid : w - (w - z) = z := by ring
      rw [hid] at h
      rcases h with h0 | h1
      · exact hz_ne h0
      · omega
    have hw_ne : w ≠ 0 := fun h0 => hnot1 (Or.inl h0)
    have hw_ge0 : 0 ≤ valL F L w := hw_int.resolve_left hw_ne
    have hw_lt1 : ¬ (1 ≤ valL F L w) := fun h1 => hnot1 (Or.inr h1)
    omega
  have valM_neg_ge : ∀ {k : ℤ} {x : M₁'},
      (x = 0 ∨ k ≤ valL F M₁' x) → (-x = 0 ∨ k ≤ valL F M₁' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right
      rw [hvalM_neg x]
      exact hx
  have valM_add_ge : ∀ {k : ℤ} {x y : M₁'},
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x + y = 0 ∨ k ≤ valL F M₁' (x + y)) := by
    intro k x y hx hy
    exact hvalM_add k x y hx hy
  have valM_sub_ge : ∀ {k : ℤ} {x y : M₁'},
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x - y = 0 ∨ k ≤ valL F M₁' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact valM_add_ge hx (valM_neg_ge hy)
  have valM_mul_ge : ∀ {k₁ k₂ : ℤ} {x y : M₁'},
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by simp [hx0])
    · by_cases hy0 : y = 0
      · exact Or.inl (by simp [hy0])
      · right
        rw [hvalM_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have valM_mono : ∀ {k₁ k₂ : ℤ} {x : M₁'},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M₁' x) → (x = 0 ∨ k₁ ≤ valL F M₁' x) := by
    intro k₁ k₂ x hk hx
    exact hx.imp_right (le_trans hk)
  have valM_div_unit : ∀ {k : ℤ} {u z : M₁'},
      u ≠ 0 → valL F M₁' u = 0 →
      (u * z = 0 ∨ k ≤ valL F M₁' (u * z)) →
        (z = 0 ∨ k ≤ valL F M₁' z) := by
    intro k u z hu_ne hu_val huz
    by_cases hz : z = 0
    · exact Or.inl hz
    · right
      have huz_ne : u * z ≠ 0 := mul_ne_zero hu_ne hz
      have hk : k ≤ valL F M₁' (u * z) := huz.resolve_left huz_ne
      rw [hvalM_mul u z hu_ne hz, hu_val, zero_add] at hk
      exact hk
  have hσ₀_pow_val : ∀ (k : ℕ) (z : M₁'), valL F M₁' ((σ₀ ^ k) z) = valL F M₁' z := by
    intro k
    induction k with
    | zero => intro z; rfl
    | succ k ih =>
      intro z
      rw [pow_succ', AlgEquiv.mul_apply, hσ₀_val, ih]
  have hσ₀_pow_L : ∀ (k : ℕ) (x : L),
      (σ₀ ^ k) (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x := by
    intro k
    induction k with
    | zero => intro x; rfl
    | succ k ih =>
      intro x
      rw [pow_succ', AlgEquiv.mul_apply, ih, hσ₀_L]
  set B : ℤ := 2 * (T : ℤ) + 1
  have hB_ge5 : (5 : ℤ) ≤ B := by omega
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  set d_k : ℕ → M₁' := fun k => (σ₀ ^ k) d
  have hdk_val : ∀ k : ℕ, valL F M₁' (d_k k) = 0 := by
    intro k
    dsimp [d_k]
    rw [hσ₀_pow_val, hd_val]
  set c_M : M₁' := IntermediateField.inclusion hLM₁' c
  set P_d : Polynomial M₁' := ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_k k))
  set P_0 : Polynomial M₁' := Polynomial.X ^ p - Polynomial.X - Polynomial.C c_M
  set R : Polynomial M₁' := P_d - P_0
  have hPd_monic : P_d.Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun k _ => Polynomial.monic_X_sub_C (d_k k))
  have hPd_deg : P_d.natDegree = p := by
    dsimp [P_d]
    rw [Polynomial.natDegree_prod_of_monic _ _ (fun k _ => Polynomial.monic_X_sub_C (d_k k))]
    simp
  have hR_deg : ∀ i : ℕ, p ≤ i → R.coeff i = 0 := by
    intro i hi
    dsimp [R, P_0]
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_sub,
      Polynomial.coeff_X_pow, Polynomial.coeff_X, Polynomial.coeff_C]
    rcases eq_or_lt_of_le hi with rfl | hlt
    · have hPd_p : P_d.coeff p = 1 := by
        rw [← hPd_deg]
        exact hPd_monic.coeff_natDegree
      have hp1 : ¬ (1 = p) := by omega
      have hp0 : ¬ (p = 0) := by omega
      simp [hPd_p, hp1, hp0]
    · have hPd_gt : P_d.coeff i = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hPd_deg]; exact hlt)
      have hip : ¬ (i = p) := by omega
      have hi1 : ¬ (1 = i) := by omega
      have hi0 : ¬ (i = 0) := by omega
      simp [hPd_gt, hip, hi1, hi0]
  have hPd_eval : ∀ k < p, P_d.eval (d_k k) = 0 := by
    intro k hk
    dsimp [P_d]
    rw [Polynomial.eval_prod]
    refine Finset.prod_eq_zero (Finset.mem_range.mpr hk) ?_
    simp
  have hR_eval : ∀ k < p, R.eval (d_k k) = 0 ∨ B ≤ valL F M₁' (R.eval (d_k k)) := by
    intro k hk
    have hReval_eq : R.eval (d_k k) = - (σ₀ ^ k) (d ^ p - d - c_M) := by
      dsimp [R, P_0, d_k, c_M]
      rw [Polynomial.eval_sub, hPd_eval k hk, zero_sub,
        Polynomial.eval_sub, Polynomial.eval_sub, Polynomial.eval_pow,
        Polynomial.eval_X, Polynomial.eval_C,
        map_sub, map_sub, map_pow, hσ₀_pow_L k c]
    rw [hReval_eq]
    apply valM_neg_ge
    rcases hd_AS with h0 | hge
    · exact Or.inl (by dsimp [c_M]; rw [h0, map_zero])
    · right
      rw [hσ₀_pow_val]
      exact hge
  have hDivDiff : ∀ m ≤ p, ∀ Q : Polynomial M₁',
      (∀ i : ℕ, m ≤ i → Q.coeff i = 0) →
      (∀ k < m, Q.eval (d_k k) = 0 ∨ B ≤ valL F M₁' (Q.eval (d_k k))) →
      ∀ i : ℕ, Q.coeff i = 0 ∨ B ≤ valL F M₁' (Q.coeff i) := by
    intro m
    induction m with
    | zero =>
      intro _ Q hQ_deg _ i
      exact Or.inl (hQ_deg i (Nat.zero_le i))
    | succ m ih =>
      intro hm Q hQ_deg hQ_eval
      set d_m : M₁' := d_k m
      set Q_1 : Polynomial M₁' := Q /ₘ (Polynomial.X - Polynomial.C d_m)
      have hQ_eq : Polynomial.C (Q.eval d_m) + (Polynomial.X - Polynomial.C d_m) * Q_1 = Q := by
        have h1 := Polynomial.modByMonic_add_div Q (Polynomial.monic_X_sub_C d_m)
        rw [Polynomial.modByMonic_X_sub_C_eq_C_eval Q d_m] at h1
        exact h1
      have hcoeff_0 : Q.coeff 0 = Q.eval d_m - d_m * Q_1.coeff 0 := by
        have h := congrArg (fun P => P.coeff 0) hQ_eq
        dsimp at h
        rw [Polynomial.coeff_add, Polynomial.coeff_C_zero, sub_mul, Polynomial.coeff_sub,
          Polynomial.coeff_X_mul_zero, Polynomial.coeff_C_mul] at h
        linear_combination -h
      have hcoeff_succ : ∀ i : ℕ, Q.coeff (i + 1) = Q_1.coeff i - d_m * Q_1.coeff (i + 1) := by
        intro i
        have h := congrArg (fun P => P.coeff (i + 1)) hQ_eq
        dsimp at h
        rw [Polynomial.coeff_add, Polynomial.coeff_C_ne_zero (by omega), zero_add,
          Polynomial.coeff_X_sub_C_mul] at h
        exact h.symm
      have hQ1_deg : ∀ i : ℕ, m ≤ i → Q_1.coeff i = 0 := by
        intro i hi
        have hrec : ∀ N : ℕ, Q_1.coeff i = d_m ^ N * Q_1.coeff (i + N) := by
          intro N
          induction N with
          | zero => simp
          | succ N ihN =>
            have hdeg_step : Q.coeff (i + N + 1) = 0 := hQ_deg (i + N + 1) (by omega)
            have hstep := hcoeff_succ (i + N)
            rw [hdeg_step] at hstep
            have hstep' : Q_1.coeff (i + N) = d_m * Q_1.coeff (i + N + 1) :=
              sub_eq_zero.mp hstep.symm
            rw [ihN, hstep', ← Nat.add_assoc i N 1, pow_succ]
            ring
        rw [hrec (Q_1.natDegree + 1),
          Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), mul_zero]
      have hQ1_eval : ∀ k < m, Q_1.eval (d_k k) = 0 ∨ B ≤ valL F M₁' (Q_1.eval (d_k k)) := by
        intro k hk
        have heval_rel : (d_k k - d_m) * Q_1.eval (d_k k) = Q.eval (d_k k) - Q.eval d_m := by
          have h := congrArg (fun P => P.eval (d_k k)) hQ_eq
          dsimp at h
          rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub,
            Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_C] at h
          linear_combination h
        have hrhs : Q.eval (d_k k) - Q.eval d_m = 0 ∨ B ≤ valL F M₁' (Q.eval (d_k k) - Q.eval d_m) :=
          valM_sub_ge (hQ_eval k (by omega)) (hQ_eval m (by omega))
        rw [← heval_rel] at hrhs
        have hsep := hd_sep k m hk (by omega)
        have hu_neg : d_k k - d_m = - ((σ₀ ^ m) d - (σ₀ ^ k) d) := by
          dsimp [d_m, d_k]
          ring
        have hu_ne : d_k k - d_m ≠ 0 := by
          rw [hu_neg]
          exact neg_ne_zero.mpr hsep.1
        have hu_val : valL F M₁' (d_k k - d_m) = 0 := by
          rw [hu_neg, hvalM_neg]
          exact hsep.2
        exact valM_div_unit hu_ne hu_val hrhs
      have hQ1_coeff := ih (by omega) Q_1 hQ1_deg hQ1_eval
      have hdm_int : d_m = 0 ∨ (0 : ℤ) ≤ valL F M₁' d_m := Or.inr (by rw [hdk_val m])
      intro i
      cases i with
      | zero =>
        rw [hcoeff_0]
        have hmul : d_m * Q_1.coeff 0 = 0 ∨ B ≤ valL F M₁' (d_m * Q_1.coeff 0) :=
          valM_mono (by omega) (valM_mul_ge hdm_int (hQ1_coeff 0))
        exact valM_sub_ge (hQ_eval m (by omega)) hmul
      | succ i =>
        rw [hcoeff_succ i]
        have hmul : d_m * Q_1.coeff (i + 1) = 0 ∨ B ≤ valL F M₁' (d_m * Q_1.coeff (i + 1)) :=
          valM_mono (by omega) (valM_mul_ge hdm_int (hQ1_coeff (i + 1)))
        exact valM_sub_ge (hQ1_coeff i) hmul
  have hR_coeff : ∀ i : ℕ, R.coeff i = 0 ∨ B ≤ valL F M₁' (R.coeff i) :=
    hDivDiff p le_rfl R hR_deg hR_eval
  let φ : M₁' →+* M₁' := σ₀.toRingEquiv.toRingHom
  have hφ_apply : ∀ z : M₁', φ z = σ₀ z := fun _ => rfl
  have hPd_map : P_d.map φ = P_d := by
    have hmap_shift : P_d.map φ =
        ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_k (k + 1))) := by
      dsimp [P_d]
      rw [Polynomial.map_prod]
      refine Finset.prod_congr rfl fun k _ => ?_
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
      congr 2
      dsimp [d_k]
      rw [pow_succ', AlgEquiv.mul_apply, hφ_apply]
    have h1 := Finset.prod_range_succ (fun k => Polynomial.X - Polynomial.C (d_k k)) p
    have h2 := Finset.prod_range_succ' (fun k => Polynomial.X - Polynomial.C (d_k k)) p
    have hdp : d_k p = d_k 0 := by
      dsimp [d_k]
      rw [hσ₀_pow d]
      rfl
    have heq_mul : (P_d.map φ) * (Polynomial.X - Polynomial.C (d_k 0)) =
        P_d * (Polynomial.X - Polynomial.C (d_k 0)) := by
      rw [hmap_shift, ← h2, h1, hdp]
    exact mul_right_cancel₀ (Polynomial.monic_X_sub_C (d_k 0)).ne_zero heq_mul
  have hP0_map : P_0.map φ = P_0 := by
    dsimp [P_0, c_M]
    rw [Polynomial.map_sub, Polynomial.map_sub, Polynomial.map_pow,
      Polynomial.map_X, Polynomial.map_C, hφ_apply, hσ₀_L c]
  have hR_map : R.map φ = R := by
    dsimp [R]
    rw [Polynomial.map_sub, hPd_map, hP0_map]
  have hR_coeff_σ₀ : ∀ i : ℕ, σ₀ (R.coeff i) = R.coeff i := by
    intro i
    have h := congrArg (fun P => P.coeff i) hR_map
    dsimp at h
    rw [Polynomial.coeff_map, hφ_apply] at h
    exact h
  have hR_coeff_pow : ∀ (k i : ℕ), (σ₀ ^ k) (R.coeff i) = R.coeff i := by
    intro k i
    induction k with
    | zero => rfl
    | succ k ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih, hR_coeff_σ₀ i]
  let r : ℕ → L := fun i => traceLM F hLM₁' (R.coeff i * y₁)
  have hr_incl : ∀ i : ℕ, IntermediateField.inclusion hLM₁' (r i) = R.coeff i := by
    intro i
    dsimp [r]
    rw [hσ₀_tr (R.coeff i * y₁)]
    have hcongr : ∀ k ∈ Finset.range p,
        (σ₀ ^ k) (R.coeff i * y₁) = R.coeff i * (σ₀ ^ k) y₁ := by
      intro k _
      rw [map_mul, hR_coeff_pow k i]
    rw [Finset.sum_congr rfl hcongr, ← Finset.mul_sum, ← hσ₀_tr y₁, hy₁_tr, map_one, mul_one]
  have hr_val : ∀ i : ℕ, r i = 0 ∨ B ≤ valL F L (r i) := by
    intro i
    rcases hR_coeff i with h0 | hge
    · have hinj0 : IntermediateField.inclusion hLM₁' (r i) = IntermediateField.inclusion hLM₁' 0 := by
        rw [hr_incl i, h0, map_zero]
      exact Or.inl ((IntermediateField.inclusion hLM₁').injective hinj0)
    · right
      rw [← hval_LM₁' (r i), hr_incl i]
      exact hge
  have hR_sum : R = ∑ i ∈ Finset.range p,
      Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i := by
    ext n
    rw [Polynomial.finset_sum_coeff]
    have hcongr : ∀ i ∈ Finset.range p,
        (Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i).coeff n =
          if n = i then R.coeff i else 0 := by
      intro i _
      rw [hr_incl i, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hcongr, Finset.sum_ite_eq]
    by_cases hn : n < p
    · simp [Finset.mem_range.mpr hn]
    · have hge : p ≤ n := not_lt.mp hn
      simp [Finset.mem_range, hn, hR_deg n hge]
  have hPd_eq : ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
      (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
        ∑ i ∈ Finset.range p,
          Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i := by
    change P_d = P_0 + _
    rw [← hR_sum]
    dsimp [R]
    ring
  have hprod_neg : ∀ n : ℕ,
      (∏ k ∈ Finset.range n, (- d_k k)) = (-1 : M₁') ^ n * ∏ k ∈ Finset.range n, d_k k := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.prod_range_succ, Finset.prod_range_succ, ih, pow_succ]
      ring
  have hPd_c0 : P_d.coeff 0 = - IntermediateField.inclusion hLM₁' (normLM F hLM₁' d) := by
    dsimp [P_d]
    rw [Polynomial.coeff_zero_prod]
    have hcongr : (∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_k k)).coeff 0) =
        ∏ k ∈ Finset.range p, (- d_k k) := by
      refine Finset.prod_congr rfl fun k _ => ?_
      simp
    have hp_odd' : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
    rw [hcongr, hprod_neg p, Odd.neg_one_pow hp_odd', neg_one_mul]
    dsimp [d_k]
    rw [← hσ₀_norm d]
  have hP0_c0 : P_0.coeff 0 = - IntermediateField.inclusion hLM₁' c := by
    dsimp [P_0, c_M]
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_X_pow,
      Polynomial.coeff_X, Polynomial.coeff_C]
    have hp0 : ¬ (0 = p) := by omega
    simp [hp0]
  have hc_sub : c - normLM F hLM₁' d = r 0 := by
    have h := congrArg (fun P => P.coeff 0) (show P_d = P_0 + R by dsimp [R]; ring)
    dsimp at h
    rw [Polynomial.coeff_add, hPd_c0, hP0_c0, ← hr_incl 0] at h
    have hinj : - normLM F hLM₁' d = - c + r 0 :=
      (IntermediateField.inclusion hLM₁').injective (by simpa using h)
    linear_combination hinj
  have hd_ne : d ≠ 0 := by
    intro hd0
    have hsep01 := (hd_sep 0 1 (by omega) (by omega)).1
    rw [hd0, map_zero, map_zero, sub_self] at hsep01
    exact hsep01 rfl
  have hnorm_ne : normLM F hLM₁' d ≠ 0 := by
    intro h0
    have hprod0 : (∏ k ∈ Finset.range p, (σ₀ ^ k) d) = 0 := by
      rw [← hσ₀_norm d, h0, map_zero]
    rw [Finset.prod_eq_zero_iff] at hprod0
    rcases hprod0 with ⟨k, _, hk0⟩
    exact hd_ne ((σ₀ ^ k).injective (by rw [hk0, map_zero]))
  have hnorm_val : valL F L (normLM F hLM₁' d) = 0 := by
    rw [hval_norm_LM₁' d, hd_val, mul_zero]
  have hc_sub_val : c - normLM F hLM₁' d = 0 ∨ (1 : ℤ) ≤ valL F L (c - normLM F hLM₁' d) := by
    rw [hc_sub]
    exact valL_mono (by omega) (hr_val 0)
  have hc_val : valL F L c = 0 :=
    valL_eq_zero_of_sub_ge_one hnorm_ne hnorm_val hc_sub_val
  exact ⟨hc_val, r, hr_val, hPd_eq⟩

theorem ld_wild_odd_unramified_as_formal_deriv_power_traces (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (hσ₀_L : ∀ x : L,
      σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range p, (σ₀ ^ k) z)
    (c : L) (d : M₁') (r : ℕ → L)
    (hd_val : valL F M₁' d = 0)
    (hd_AS : d ^ p - d - IntermediateField.inclusion hLM₁' c = 0 ∨
      (2 * (T : ℤ) + 1) ≤ valL F M₁' (d ^ p - d - IntermediateField.inclusion hLM₁' c))
    (hr_val : ∀ i : ℕ, r i = 0 ∨ (2 * (T : ℤ) + 1) ≤ valL F L (r i))
    (hPd_eq : ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
      (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
        ∑ i ∈ Finset.range p,
          Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i) :
    (∀ j ∈ Finset.Icc 1 (p - 2),
      traceLM F hLM₁' (d ^ j) = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ j))) ∧
    (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
      (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L))) ∧
    (traceLM F hLM₁' (d ^ p) - (p : L) * c = 0 ∨
      (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ p) - (p : L) * c)) :=
by
  have valL_neg_ge : ∀ {k : ℤ} {x : L},
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hvalL_props.2.2.2.1]; exact hx
  have valL_add_ge : ∀ {k : ℤ} {x y : L},
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x + y = 0 ∨ k ≤ valL F L (x + y)) :=
    fun hx hy => hvalL_props.2.2.2.2.2.2.2.1 _ _ _ hx hy
  have valL_mono : ∀ {k₁ k₂ : ℤ} {x : L},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have valM_neg_ge : ∀ {k : ℤ} {x : M₁'},
      (x = 0 ∨ k ≤ valL F M₁' x) → (-x = 0 ∨ k ≤ valL F M₁' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hvalM_props.2.2.2.1]; exact hx
  have valM_add_ge : ∀ {k : ℤ} {x y : M₁'},
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x + y = 0 ∨ k ≤ valL F M₁' (x + y)) :=
    fun hx hy => hvalM_props.2.2.2.2.2.2.2.1 _ _ _ hx hy
  have valM_sub_ge : ∀ {k : ℤ} {x y : M₁'},
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x - y = 0 ∨ k ≤ valL F M₁' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact valM_add_ge hx (valM_neg_ge hy)
  have valM_mul_ge : ∀ {k₁ k₂ : ℤ} {x y : M₁'},
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' : k₁ ≤ valL F M₁' x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F M₁' y := hy.resolve_left hy0
        rw [hvalM_props.2.2.2.2.1 x y hx0 hy0]
        omega
  have valM_natCast_int : ∀ (n : ℕ), (n : M₁') = 0 ∨ (0 : ℤ) ≤ valL F M₁' (n : M₁') := by
    intro n
    induction n with
    | zero => left; simp
    | succ n ih =>
      rw [Nat.cast_succ]
      exact valM_add_ge ih (Or.inr (by rw [hvalM_props.2.1]))
  have valM_sum_ge : ∀ (s : Finset ℕ) (f : ℕ → M₁') (k : ℤ),
      (∀ i ∈ s, f i = 0 ∨ k ≤ valL F M₁' (f i)) →
        ((∑ i ∈ s, f i) = 0 ∨ k ≤ valL F M₁' (∑ i ∈ s, f i)) := by
    intro s f k hf
    induction s using Finset.induction_on with
    | empty => left; simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact valM_add_ge (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have hσ₀_pow_val : ∀ (k : ℕ) (z : M₁'), valL F M₁' ((σ₀ ^ k) z) = valL F M₁' z := by
    intro k z
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ', AlgEquiv.mul_apply, hσ₀_val, ih]
  have hσ₀_pow_L : ∀ (k : ℕ) (x : L),
      (σ₀ ^ k) (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x := by
    intro k x
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ', AlgEquiv.mul_apply, ih, hσ₀_L]
  set B : ℤ := 2 * (T : ℤ) + 1
  have hT_le_B : (T : ℤ) ≤ B := by omega
  have hp_ge3 : 3 ≤ p := by
    have h2 := hPrime.two_le
    omega
  let d_k : ℕ → M₁' := fun k => (σ₀ ^ k) d
  have hdk_val : ∀ k : ℕ, valL F M₁' (d_k k) = 0 := by
    intro k
    dsimp [d_k]
    rw [hσ₀_pow_val, hd_val]
  have hdk_int : ∀ k : ℕ, d_k k = 0 ∨ (0 : ℤ) ≤ valL F M₁' (d_k k) := by
    intro k
    right
    rw [hdk_val k]
  have hrM_val : ∀ i : ℕ,
      IntermediateField.inclusion hLM₁' (r i) = 0 ∨
        B ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (r i)) := by
    intro i
    rcases hr_val i with hi | hi
    · left; rw [hi, map_zero]
    · right; rw [hval_LM₁']; exact hi
  let P_d : Polynomial M₁' := ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_k k))
  let R_r : Polynomial M₁' :=
    ∑ i ∈ Finset.range p,
      Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i
  have hRr_coeff : ∀ {n : ℕ}, n < p →
      R_r.coeff n = IntermediateField.inclusion hLM₁' (r n) := by
    intro n hn
    dsimp [R_r]
    rw [Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq (Finset.range p) n
      (fun i => IntermediateField.inclusion hLM₁' (r i))]
    exact if_pos (Finset.mem_range.mpr hn)
  have hPd_coeff_mid : ∀ {m : ℕ}, 2 ≤ m → m < p →
      P_d.coeff m = IntermediateField.inclusion hLM₁' (r m) := by
    intro m hm2 hmp
    have h1 : P_d.coeff m =
        ((Polynomial.X ^ p - Polynomial.X -
            Polynomial.C (IntermediateField.inclusion hLM₁' c)) + R_r).coeff m :=
      congrArg (fun P => P.coeff m) hPd_eq
    rw [h1, Polynomial.coeff_add, hRr_coeff hmp,
        Polynomial.coeff_sub, Polynomial.coeff_sub,
        Polynomial.coeff_X_pow, Polynomial.coeff_X, Polynomial.coeff_C]
    have hmp_ne : ¬ (m = p) := by omega
    have hm1_ne : ¬ (1 = m) := by omega
    have hm0_ne : ¬ (m = 0) := by omega
    rw [if_neg hmp_ne, if_neg hm1_ne, if_neg hm0_ne]
    ring
  have hPd_coeff_mid_val : ∀ {m : ℕ}, 2 ≤ m → m < p →
      P_d.coeff m = 0 ∨ B ≤ valL F M₁' (P_d.coeff m) := by
    intro m hm2 hmp
    rw [hPd_coeff_mid hm2 hmp]
    exact hrM_val m
  have hPd_coeff_one :
      P_d.coeff 1 = -1 + IntermediateField.inclusion hLM₁' (r 1) := by
    have h1p : 1 < p := by omega
    have h1 : P_d.coeff 1 =
        ((Polynomial.X ^ p - Polynomial.X -
            Polynomial.C (IntermediateField.inclusion hLM₁' c)) + R_r).coeff 1 :=
      congrArg (fun P => P.coeff 1) hPd_eq
    rw [h1, Polynomial.coeff_add, hRr_coeff h1p,
        Polynomial.coeff_sub, Polynomial.coeff_sub,
        Polynomial.coeff_X_pow, Polynomial.coeff_X, Polynomial.coeff_C]
    have h1p_ne : ¬ (1 = p) := by omega
    have h10_ne : ¬ ((1 : ℕ) = 0) := by omega
    rw [if_neg h1p_ne, if_pos rfl, if_neg h10_ne]
    ring
  let Q_k : ℕ → Polynomial M₁' := fun k =>
    ∏ m ∈ (Finset.range p).erase k, (Polynomial.X - Polynomial.C (d_k m))
  have hQk_mul : ∀ {k : ℕ}, k < p →
      (Polynomial.X - Polynomial.C (d_k k)) * Q_k k = P_d := by
    intro k hk
    exact Finset.mul_prod_erase (Finset.range p)
      (fun m => Polynomial.X - Polynomial.C (d_k m)) (Finset.mem_range.mpr hk)
  have hQk_top : ∀ {k : ℕ}, k < p → (Q_k k).coeff (p - 1) = 1 := by
    intro k hk
    have hk_mem : k ∈ Finset.range p := Finset.mem_range.mpr hk
    have hmonic : (Q_k k).Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun m _ => Polynomial.monic_X_sub_C (d_k m))
    have hdeg : (Q_k k).natDegree = p - 1 := by
      dsimp [Q_k]
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun m _ => Polynomial.monic_X_sub_C (d_k m))]
      simp only [Polynomial.natDegree_X_sub_C, Finset.sum_const, smul_eq_mul, mul_one,
        Finset.card_erase_of_mem hk_mem, Finset.card_range]
    rw [← hdeg]
    exact hmonic.coeff_natDegree
  have hQk_rec : ∀ {k : ℕ}, k < p → ∀ (a : ℕ),
      (Q_k k).coeff a = d_k k * (Q_k k).coeff (a + 1) + P_d.coeff (a + 1) := by
    intro k hk a
    have h1 : P_d.coeff (a + 1) =
        ((Polynomial.X - Polynomial.C (d_k k)) * Q_k k).coeff (a + 1) :=
      congrArg (fun P => P.coeff (a + 1)) (hQk_mul hk).symm
    rw [Polynomial.coeff_X_sub_C_mul] at h1
    linear_combination -h1
  have hQk_low : ∀ {k : ℕ}, k < p → ∀ (j : ℕ), j ≤ p - 2 →
      (Q_k k).coeff (p - 1 - j) - (d_k k) ^ j = 0 ∨
        B ≤ valL F M₁' ((Q_k k).coeff (p - 1 - j) - (d_k k) ^ j) := by
    intro k hk j
    induction j with
    | zero =>
      intro _
      left
      simp [hQk_top hk]
    | succ j ih =>
      intro hj1
      have hj : j ≤ p - 2 := by omega
      have h_idx : p - 1 - (j + 1) + 1 = p - 1 - j := by omega
      have hm2 : 2 ≤ p - 1 - j := by omega
      have hmp : p - 1 - j < p := by omega
      have hrec := hQk_rec hk (p - 1 - (j + 1))
      rw [h_idx] at hrec
      have h_id : (Q_k k).coeff (p - 1 - (j + 1)) - (d_k k) ^ (j + 1) =
          d_k k * ((Q_k k).coeff (p - 1 - j) - (d_k k) ^ j) + P_d.coeff (p - 1 - j) := by
        rw [hrec, pow_succ']
        ring
      rw [h_id]
      have hmul := valM_mul_ge (hdk_int k) (ih hj)
      rw [zero_add] at hmul
      exact valM_add_ge hmul (hPd_coeff_mid_val hm2 hmp)
  have hQk_zero : ∀ {k : ℕ}, k < p →
      (Q_k k).coeff 0 - ((d_k k) ^ (p - 1) - 1) = 0 ∨
        B ≤ valL F M₁' ((Q_k k).coeff 0 - ((d_k k) ^ (p - 1) - 1)) := by
    intro k hk
    have hrec0 := hQk_rec hk 0
    have h_idx1 : p - 1 - (p - 2) = 1 := by omega
    have h_pow : (d_k k) ^ (p - 1) = d_k k * (d_k k) ^ (p - 2) := by
      have hp1 : p - 1 = (p - 2) + 1 := by omega
      rw [hp1, pow_succ']
    have h_id : (Q_k k).coeff 0 - ((d_k k) ^ (p - 1) - 1) =
        d_k k * ((Q_k k).coeff 1 - (d_k k) ^ (p - 2)) +
          IntermediateField.inclusion hLM₁' (r 1) := by
      rw [hrec0, zero_add, hPd_coeff_one, h_pow]
      ring
    rw [h_id]
    have hlow1 := hQk_low hk (p - 2) le_rfl
    rw [h_idx1] at hlow1
    have hmul := valM_mul_ge (hdk_int k) hlow1
    rw [zero_add] at hmul
    exact valM_add_ge hmul (hrM_val 1)
  have hPd_deriv : P_d.derivative = ∑ k ∈ Finset.range p, Q_k k := by
    dsimp [P_d, Q_k]
    rw [Polynomial.derivative_prod_finset]
    apply Finset.sum_congr rfl
    intro k _
    rw [Polynomial.derivative_X_sub_C, mul_one]
  have hderiv_coeff : ∀ (i : ℕ),
      ∑ k ∈ Finset.range p, (Q_k k).coeff i = P_d.coeff (i + 1) * ((i : M₁') + 1) := by
    intro i
    have h1 : (P_d.derivative).coeff i = (∑ k ∈ Finset.range p, Q_k k).coeff i :=
      congrArg (fun P => P.coeff i) hPd_deriv
    rw [Polynomial.coeff_derivative, Polynomial.finset_sum_coeff] at h1
    exact h1.symm
  have hd_tr_low : ∀ j ∈ Finset.Icc 1 (p - 2),
      traceLM F hLM₁' (d ^ j) = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ j)) := by
    intro j hj
    rcases Finset.mem_Icc.mp hj with ⟨hj1, hj2⟩
    have h_idx : p - 1 - j + 1 = p - j := by omega
    have h_cast : ((p - 1 - j : ℕ) : M₁') + 1 = ((p - j : ℕ) : M₁') := by
      rw [← h_idx, Nat.cast_add, Nat.cast_one]
    have hm2 : 2 ≤ p - j := by omega
    have hmp : p - j < p := by omega
    have hsum_Q : (∑ k ∈ Finset.range p, (Q_k k).coeff (p - 1 - j)) = 0 ∨
        B ≤ valL F M₁' (∑ k ∈ Finset.range p, (Q_k k).coeff (p - 1 - j)) := by
      rw [hderiv_coeff (p - 1 - j), h_cast, h_idx]
      have hmul := valM_mul_ge (hPd_coeff_mid_val hm2 hmp) (valM_natCast_int (p - j))
      rw [add_zero] at hmul
      exact hmul
    have hsum_diff :
        (∑ k ∈ Finset.range p, ((Q_k k).coeff (p - 1 - j) - (d_k k) ^ j)) = 0 ∨
          B ≤ valL F M₁' (∑ k ∈ Finset.range p, ((Q_k k).coeff (p - 1 - j) - (d_k k) ^ j)) :=
      valM_sum_ge (Finset.range p)
        (fun k => (Q_k k).coeff (p - 1 - j) - (d_k k) ^ j) B
        (fun k hk => hQk_low (Finset.mem_range.mp hk) j hj2)
    have htr_dj :
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ j)) =
          ∑ k ∈ Finset.range p, (d_k k) ^ j := by
      rw [hσ₀_tr (d ^ j)]
      apply Finset.sum_congr rfl
      intro k _
      exact map_pow (σ₀ ^ k) d j
    have h_id :
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ j)) =
          (∑ k ∈ Finset.range p, (Q_k k).coeff (p - 1 - j)) -
            (∑ k ∈ Finset.range p, ((Q_k k).coeff (p - 1 - j) - (d_k k) ^ j)) := by
      rw [Finset.sum_sub_distrib, sub_sub_cancel, htr_dj]
    have hval_M :
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ j)) = 0 ∨
          B ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ j))) := by
      rw [h_id]
      exact valM_sub_ge hsum_Q hsum_diff
    rw [map_eq_zero, hval_LM₁'] at hval_M
    exact valL_mono hT_le_B hval_M
  have hd_tr_top :
      traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)) := by
    have hsum_Q0 :
        ∑ k ∈ Finset.range p, (Q_k k).coeff 0 =
          -1 + IntermediateField.inclusion hLM₁' (r 1) := by
      rw [hderiv_coeff 0]
      simp only [Nat.cast_zero, zero_add, mul_one, hPd_coeff_one]
    have htr_dp1 :
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ (p - 1))) =
          ∑ k ∈ Finset.range p, (d_k k) ^ (p - 1) := by
      rw [hσ₀_tr (d ^ (p - 1))]
      apply Finset.sum_congr rfl
      intro k _
      exact map_pow (σ₀ ^ k) d (p - 1)
    have hsum_dp1_sub1 :
        ∑ k ∈ Finset.range p, ((d_k k) ^ (p - 1) - 1) =
          IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ (p - 1))) - (p : M₁') := by
      rw [Finset.sum_sub_distrib, ← htr_dp1, Finset.sum_const, Finset.card_range, nsmul_one]
    have h_id :
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)) =
          IntermediateField.inclusion hLM₁' (r 1) -
            ∑ k ∈ Finset.range p, ((Q_k k).coeff 0 - ((d_k k) ^ (p - 1) - 1)) := by
      rw [Finset.sum_sub_distrib, hsum_Q0, hsum_dp1_sub1,
          map_sub, map_sub, map_natCast, map_one]
      ring
    have hsum_diff0 :
        (∑ k ∈ Finset.range p, ((Q_k k).coeff 0 - ((d_k k) ^ (p - 1) - 1))) = 0 ∨
          B ≤ valL F M₁' (∑ k ∈ Finset.range p, ((Q_k k).coeff 0 - ((d_k k) ^ (p - 1) - 1))) :=
      valM_sum_ge (Finset.range p)
        (fun k => (Q_k k).coeff 0 - ((d_k k) ^ (p - 1) - 1)) B
        (fun k hk => hQk_zero (Finset.mem_range.mp hk))
    have hval_M :
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)) = 0 ∨
          B ≤ valL F M₁'
            (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L))) := by
      rw [h_id]
      exact valM_sub_ge (hrM_val 1) hsum_diff0
    rw [map_eq_zero, hval_LM₁'] at hval_M
    exact valL_mono hT_le_B hval_M
  have hd_tr_pow :
      traceLM F hLM₁' (d ^ p) - (p : L) * c = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ p) - (p : L) * c) := by
    set u : M₁' := d ^ p - d - IntermediateField.inclusion hLM₁' c
    have htr_u : traceLM F hLM₁' u = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' u) :=
      valL_mono hT_le_B (htr_bound_LM₁' B u hd_AS)
    have htr_u_eq :
        traceLM F hLM₁' u = traceLM F hLM₁' (d ^ p) - traceLM F hLM₁' d - (p : L) * c := by
      have h_inc :
          IntermediateField.inclusion hLM₁' (traceLM F hLM₁' u) =
            IntermediateField.inclusion hLM₁'
              (traceLM F hLM₁' (d ^ p) - traceLM F hLM₁' d - (p : L) * c) := by
        rw [hσ₀_tr u]
        have hsum_u :
            ∑ k ∈ Finset.range p, (σ₀ ^ k) u =
              (∑ k ∈ Finset.range p, (σ₀ ^ k) (d ^ p)) -
                (∑ k ∈ Finset.range p, (σ₀ ^ k) d) -
                (∑ k ∈ Finset.range p, IntermediateField.inclusion hLM₁' c) := by
          rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
          apply Finset.sum_congr rfl
          intro k _
          dsimp [u]
          rw [map_sub, map_sub, hσ₀_pow_L k c]
        rw [hsum_u, ← hσ₀_tr (d ^ p), ← hσ₀_tr d, Finset.sum_const, Finset.card_range,
            nsmul_eq_mul, map_sub, map_sub, map_mul, map_natCast]
      exact (IntermediateField.inclusion hLM₁').injective h_inc
    have h_id_pow :
        traceLM F hLM₁' (d ^ p) - (p : L) * c = traceLM F hLM₁' u + traceLM F hLM₁' d := by
      rw [htr_u_eq]
      ring
    have h1_mem : 1 ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
    have htr_d : traceLM F hLM₁' d = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' d) := by
      simpa [pow_one] using hd_tr_low 1 h1_mem
    rw [h_id_pow]
    exact valL_add_ge htr_u htr_d
  exact ⟨hd_tr_low, hd_tr_top, hd_tr_pow⟩

theorem ld_wild_odd_unramified_as_poly_and_power_traces (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = (p : ℤ) * valL F M₁' z)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (y₁ : M₁') (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (hσ₀_L : ∀ x : L,
      σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range p, (σ₀ ^ k) z)
    (hσ₀_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
      ∏ k ∈ Finset.range p, (σ₀ ^ k) z)
    (hσ₀_pow : ∀ z : M₁', (σ₀ ^ p) z = z)
    (c : L) (d : M₁')
    (hd_val : valL F M₁' d = 0)
    (hd_AS : d ^ p - d - IntermediateField.inclusion hLM₁' c = 0 ∨
      (2 * (T : ℤ) + 1) ≤ valL F M₁' (d ^ p - d - IntermediateField.inclusion hLM₁' c))
    (hd_sep : ∀ j k : ℕ, j < k → k < p →
      (σ₀ ^ k) d - (σ₀ ^ j) d ≠ 0 ∧
      valL F M₁' ((σ₀ ^ k) d - (σ₀ ^ j) d) = 0) :
    valL F L c = 0 ∧
    (∀ j ∈ Finset.Icc 1 (p - 2),
      traceLM F hLM₁' (d ^ j) = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ j))) ∧
    (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
      (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L))) ∧
    (traceLM F hLM₁' (d ^ p) - (p : L) * c = 0 ∨
      (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ p) - (p : L) * c)) ∧
    ∃ r : ℕ → L,
      (∀ i : ℕ, r i = 0 ∨ (2 * (T : ℤ) + 1) ≤ valL F L (r i)) ∧
      ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
        (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
          ∑ i ∈ Finset.range p,
            Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i :=
by
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalM_props := ld_valL_and_unitGroup_props F M₁'
  obtain ⟨hc_val, r, hr_val, hPd_eq⟩ :=
    ld_wild_odd_unramified_as_poly_remainder_and_norm F L M₁' hLM₁'
      p hPrime hp_odd T hT_ge2 hvalL_props hvalM_props
      hval_LM₁' hval_norm_LM₁' y₁ hy₁_tr
      σ₀ hσ₀_L hσ₀_val hσ₀_tr hσ₀_norm hσ₀_pow
      c d hd_val hd_AS hd_sep
  obtain ⟨hd_tr_low, hd_tr_top, hd_tr_pow⟩ :=
    ld_wild_odd_unramified_as_formal_deriv_power_traces F L M₁' hLM₁'
      p hPrime hp_odd T hT_ge2 hvalL_props hvalM_props
      hval_LM₁' htr_bound_LM₁' σ₀ hσ₀_L hσ₀_val hσ₀_tr
      c d r hd_val hd_AS hr_val hPd_eq
  exact ⟨hc_val, hd_tr_low, hd_tr_top, hd_tr_pow, r, hr_val, hPd_eq⟩

theorem ld_wild_odd_unramified_k1_generator_adjoin_and_minpoly_split (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (c : L) (d : M₁') (r : ℕ → L)
    (hd_val : valL F M₁' d = 0)
    (hd_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)))
    (hPd_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
        (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
          ∑ i ∈ Finset.range p,
            Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let K₁_ext := IntermediateField.extendScalars hE'K₁
    let d_K : K₁_ext := toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ d)
    IntermediateField.adjoin E' ({d_K} : Set K₁_ext) = ⊤ ∧
    (minpoly E' d_K).map (algebraMap E' K₁_ext) =
      ∏ k ∈ Finset.range p,
        (Polynomial.X - Polynomial.C
          (toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d)))) :=
by
  intro p K₁_ext d_K
  rcases hvalL_props with
    ⟨hvalL_0, hvalL_1, _, hvalL_neg, hvalL_mul, _, _, hvalL_add, _, _, _⟩
  rcases hvalE'_props with
    ⟨hvalE'_0, hvalE'_1, _, hvalE'_neg, hvalE'_mul, _, _, hvalE'_add, _, _, _⟩
  let fromExtendScalars : K₁_ext →+* K₁ :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hE'K₁).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  haveI : FiniteDimensional E' K₁_ext := by
    let eF : K₁ ≃ₐ[F] K₁_ext :=
      AlgEquiv.ofRingEquiv (f := RingEquiv.ofHomInv (toExtendScalars F hE'K₁) fromExtendScalars
        (by ext; rfl) (by ext; rfl)) (fun _ => rfl)
    haveI : FiniteDimensional F K₁_ext := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F E' K₁_ext := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F E' K₁_ext
  have hd_not_bot : d_K ∉ (⊥ : IntermediateField E' K₁_ext) := by
    intro hmem
    rw [IntermediateField.mem_bot] at hmem
    rcases hmem with ⟨y, hy⟩
    have hy_K₁ : IntermediateField.inclusion hE'K₁ y = IntermediateField.inclusion hM₁'K₁ d :=
      congrArg fromExtendScalars hy
    have hy_val : valL F E' y = 0 := by
      have h1 := congrArg (valL F K₁) hy_K₁
      rw [hval_E'K₁ y, hval_M₁'K₁ d, hd_val, mul_zero] at h1
      exact h1
    have hy_pow_val : ∀ n : ℕ, y ^ n = 0 ∨ (0 : ℤ) ≤ valL F E' (y ^ n) := by
      intro n
      induction n with
      | zero =>
        right
        rw [pow_zero, hvalE'_1]
      | succ n ih =>
        rw [pow_succ]
        by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · rcases ih with hyn0 | hyn_ge
          · left; rw [hyn0, zero_mul]
          · by_cases hyn0' : y ^ n = 0
            · left; rw [hyn0', zero_mul]
            · right
              rw [hvalE'_mul (y ^ n) y hyn0' hy0, hy_val, add_zero]
              exact hyn_ge
    have hy_p1_val : y ^ (p - 1) = 0 ∨ (0 : ℤ) ≤ valL F E' (y ^ (p - 1)) := hy_pow_val (p - 1)
    have hy_pow_K₁ :
        IntermediateField.inclusion hE'K₁ (y ^ (p - 1)) =
          IntermediateField.inclusion hM₁'K₁ (d ^ (p - 1)) := by
      rw [map_pow, map_pow, hy_K₁]
    let t_d : L := traceLM F hLM₁' (d ^ (p - 1))
    have htr_eq1 :
        traceLM F hE'K₁ (IntermediateField.inclusion hE'K₁ (y ^ (p - 1))) =
          IntermediateField.inclusion hLE' t_d := by
      rw [hy_pow_K₁]
      exact (hDiamond_M₁' (d ^ (p - 1))).2
    have htr_lhs :
        traceLM F hE'K₁ (IntermediateField.inclusion hE'K₁ (y ^ (p - 1))) =
          (p : E') * y ^ (p - 1) := by
      have halg :
          toExtendScalars F hE'K₁ (IntermediateField.inclusion hE'K₁ (y ^ (p - 1))) =
            algebraMap E' K₁_ext (y ^ (p - 1)) := rfl
      change Algebra.trace E' K₁_ext
          (toExtendScalars F hE'K₁ (IntermediateField.inclusion hE'K₁ (y ^ (p - 1)))) =
        (p : E') * y ^ (p - 1)
      rw [halg, Algebra.trace_algebraMap, hdegE'K₁, nsmul_eq_mul]
    have htr_eq' : IntermediateField.inclusion hLE' t_d = (p : E') * y ^ (p - 1) :=
      htr_eq1.symm.trans htr_lhs
    have hp_ge2 : 2 ≤ p := hPrime.two_le
    have hp_val_1 : (p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L) := by
      rcases hp_val with hp0 | hp_ge
      · exact Or.inl hp0
      · right
        have hT_half : (1 : ℤ) ≤ ((T - T / 2 : ℕ) : ℤ) := by omega
        exact le_trans hT_half hp_ge
    have hpE'_eq : (p : E') = IntermediateField.inclusion hLE' (p : L) :=
      (map_natCast (IntermediateField.inclusion hLE') p).symm
    have hpE'_val : (p : E') = 0 ∨ (p : ℤ) ≤ valL F E' (p : E') := by
      rcases hp_val_1 with hp0 | hp_ge
      · left; rw [hpE'_eq, hp0, map_zero]
      · right
        rw [hpE'_eq, hval_LE' (p : L)]
        have hp_pos : (0 : ℤ) ≤ (p : ℤ) := by omega
        calc (p : ℤ) = (p : ℤ) * 1 := (mul_one _).symm
          _ ≤ (p : ℤ) * valL F L (p : L) := mul_le_mul_of_nonneg_left hp_ge hp_pos
    have htdE'_val :
        IntermediateField.inclusion hLE' t_d = 0 ∨
          (p : ℤ) ≤ valL F E' (IntermediateField.inclusion hLE' t_d) := by
      rw [htr_eq']
      by_cases hpE'0 : (p : E') = 0
      · left; rw [hpE'0, zero_mul]
      · by_cases hyp0 : y ^ (p - 1) = 0
        · left; rw [hyp0, mul_zero]
        · right
          rw [hvalE'_mul (p : E') (y ^ (p - 1)) hpE'0 hyp0]
          have hp_ge : (p : ℤ) ≤ valL F E' (p : E') := hpE'_val.resolve_left hpE'0
          have hy_ge : (0 : ℤ) ≤ valL F E' (y ^ (p - 1)) := hy_p1_val.resolve_left hyp0
          linarith
    have htd_val : t_d = 0 ∨ (1 : ℤ) ≤ valL F L t_d := by
      rcases htdE'_val with h0 | hge
      · left
        exact (IntermediateField.inclusion hLE').injective
          (h0.trans (map_zero (IntermediateField.inclusion hLE')).symm)
      · right
        rw [hval_LE' t_d] at hge
        nlinarith
    have hneg_td_val : -t_d = 0 ∨ (1 : ℤ) ≤ valL F L (-t_d) := by
      rcases htd_val with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hvalL_neg t_d]; exact hge
    have hdiff_val : t_d - (p - 1 : L) = 0 ∨ (1 : ℤ) ≤ valL F L (t_d - (p - 1 : L)) := by
      rcases hd_tr_top with h0 | hge
      · exact Or.inl h0
      · right
        have hT1 : (1 : ℤ) ≤ (T : ℤ) := by omega
        exact le_trans hT1 hge
    have hsum1 := hvalL_add 1 (p : L) (t_d - (p - 1 : L)) hp_val_1 hdiff_val
    have hsum2 := hvalL_add 1 ((p : L) + (t_d - (p - 1 : L))) (-t_d) hsum1 hneg_td_val
    have hring : (p : L) + (t_d - (p - 1 : L)) + (-t_d) = (1 : L) := by ring
    rw [hring] at hsum2
    rcases hsum2 with h1_0 | h1_ge
    · exact one_ne_zero h1_0
    · rw [hvalL_1] at h1_ge
      omega
  have hGen : ∀ (E K : Type u) [Field E] [Field K] [Algebra E K] [FiniteDimensional E K]
      (d₀ : K),
      Module.finrank E K = p →
      d₀ ∉ (⊥ : IntermediateField E K) →
      IntermediateField.adjoin E ({d₀} : Set K) = ⊤ ∧
      (minpoly E d₀).natDegree = p := by
    intro E K _ _ _ _ d₀ hdeg hd_nb
    let S : IntermediateField E K := IntermediateField.adjoin E ({d₀} : Set K)
    have hd_int₀ : IsIntegral E d₀ := IsIntegral.of_finite E d₀
    have hdvd_S : Module.finrank E S ∣ p :=
      ⟨Module.finrank S K, hdeg.symm.trans (Module.finrank_mul_finrank E S K).symm⟩
    have hfinrank_S : Module.finrank E S = p := by
      rcases (Nat.Prime.eq_one_or_self_of_dvd hPrime (Module.finrank E S) hdvd_S) with h1 | hp_eq
      · exfalso
        have hbot_eq : (⊥ : IntermediateField E K) = S :=
          IntermediateField.eq_of_le_of_finrank_le (bot_le : (⊥ : IntermediateField E K) ≤ S)
            (by rw [h1, IntermediateField.finrank_bot])
        have hd_mem_S : d₀ ∈ S := IntermediateField.mem_adjoin_simple_self E d₀
        rw [← hbot_eq] at hd_mem_S
        exact hd_nb hd_mem_S
      · exact hp_eq
    have hfinrank_top : Module.finrank E (⊤ : IntermediateField E K) = p :=
      (LinearEquiv.finrank_eq IntermediateField.topEquiv.toLinearEquiv).trans hdeg
    have hadj_top₀ : S = ⊤ :=
      IntermediateField.eq_of_le_of_finrank_le (le_top : S ≤ ⊤)
        (by rw [hfinrank_S, hfinrank_top])
    have hminpoly_deg₀ : (minpoly E d₀).natDegree = p :=
      (IntermediateField.adjoin.finrank hd_int₀).symm.trans hfinrank_S
    exact ⟨hadj_top₀, hminpoly_deg₀⟩
  obtain ⟨hadj_top, hminpoly_deg⟩ := hGen E' K₁_ext d_K hdegE'K₁ hd_not_bot
  have hd_int : IsIntegral E' d_K := IsIntegral.of_finite E' d_K
  let P_E' : Polynomial E' :=
    (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLE' c)) +
      ∑ i ∈ Finset.range p,
        Polynomial.C (IntermediateField.inclusion hLE' (r i)) * Polynomial.X ^ i
  let φ : M₁' →+* K₁_ext :=
    (toExtendScalars F hE'K₁).comp (IntermediateField.inclusion hM₁'K₁).toRingHom
  let d_Kk : ℕ → K₁_ext := fun k =>
    toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))
  have hφ_L : ∀ a : L,
      φ (IntermediateField.inclusion hLM₁' a) =
        algebraMap E' K₁_ext (IntermediateField.inclusion hLE' a) :=
    fun _ => rfl
  have hφ_d : ∀ k : ℕ, φ ((σ₀ ^ k) d) = d_Kk k := fun _ => rfl
  have hPd_map := congrArg (Polynomial.map φ) hPd_eq
  have hPd_lhs :
      (∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d))).map φ =
        ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_Kk k)) := by
    rw [Polynomial.map_prod]
    refine Finset.prod_congr rfl fun k _ => ?_
    rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hφ_d k]
  have hPd_rhs :
      ((Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
        ∑ i ∈ Finset.range p,
          Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i).map φ =
      P_E'.map (algebraMap E' K₁_ext) := by
    dsimp only [P_E']
    rw [Polynomial.map_add, Polynomial.map_sub, Polynomial.map_sub, Polynomial.map_pow,
      Polynomial.map_X, Polynomial.map_C, hφ_L c, Polynomial.map_sum]
    rw [Polynomial.map_add, Polynomial.map_sub, Polynomial.map_sub, Polynomial.map_pow,
      Polynomial.map_X, Polynomial.map_C, Polynomial.map_sum]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X, hφ_L (r i)]
    rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
  have hPE'_map :
      P_E'.map (algebraMap E' K₁_ext) =
        ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_Kk k)) := by
    rw [← hPd_rhs, ← hPd_lhs]
    exact hPd_map.symm
  have hprod_monic :
      (∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_Kk k))).Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun k _ => Polynomial.monic_X_sub_C (d_Kk k))
  have hPE'_monic : P_E'.Monic := by
    apply Polynomial.monic_of_injective (algebraMap E' K₁_ext).injective
    rw [hPE'_map]
    exact hprod_monic
  have hprod_deg :
      (∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_Kk k))).natDegree = p := by
    rw [Polynomial.natDegree_prod_of_monic _ _ (fun k _ => Polynomial.monic_X_sub_C (d_Kk k))]
    simp [Polynomial.natDegree_X_sub_C]
  have hPE'_deg : P_E'.natDegree = p := by
    rw [← Polynomial.natDegree_map_eq_of_injective (algebraMap E' K₁_ext).injective P_E',
      hPE'_map, hprod_deg]
  have hPE'_aeval : Polynomial.aeval d_K P_E' = 0 := by
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, hPE'_map, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (Finset.mem_range.mpr hPrime.pos)
    rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    have hd0 : d_Kk 0 = d_K := by
      dsimp only [d_Kk, d_K]
      rw [pow_zero, AlgEquiv.one_apply]
    rw [hd0, sub_self]
  have hdvd : minpoly E' d_K ∣ P_E' := minpoly.dvd E' d_K hPE'_aeval
  have hminpoly_eq : minpoly E' d_K = P_E' :=
    (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hd_int) hPE'_monic hdvd
      (by rw [hPE'_deg, hminpoly_deg])).symm
  refine ⟨hadj_top, ?_⟩
  rw [hminpoly_eq]
  exact hPE'_map

theorem ld_wild_odd_unramified_k1_power_basis_lift_aut_and_norm_trace (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = p)
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (d : M₁')
    (hd_sep : ∀ j k : ℕ, j < k → k < p → (σ₀ ^ k) d - (σ₀ ^ j) d ≠ 0)
    (hadj_top :
      let K₁_ext := IntermediateField.extendScalars hE'K₁
      let d_K : K₁_ext := toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ d)
      IntermediateField.adjoin E' ({d_K} : Set K₁_ext) = ⊤)
    (hminpoly_split :
      let K₁_ext := IntermediateField.extendScalars hE'K₁
      let d_K : K₁_ext := toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ d)
      (minpoly E' d_K).map (algebraMap E' K₁_ext) =
        ∏ k ∈ Finset.range p,
          (Polynomial.X - Polynomial.C
            (toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))))) :
    (∀ x : E',
      IntermediateField.inclusion hE'K₁
        (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)) =
      ∏ k ∈ Finset.range p,
        (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))) ∧
    ∃ τ : ℕ → (K₁ →+* K₁),
      (∀ k ∈ Finset.range p, ∀ w : K₁, valL F K₁ (τ k w) = valL F K₁ w) ∧
      (∀ w : K₁,
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) =
          ∏ k ∈ Finset.range p, τ k w) ∧
      (∀ w : K₁,
        IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) =
          ∑ k ∈ Finset.range p, τ k w) :=
by
  have h_abs : ∀ (E₀ K_ext : Type u) [Field E₀] [Field K_ext] [Algebra E₀ K_ext]
      [FiniteDimensional E₀ K_ext]
      (hdeg : Module.finrank E₀ K_ext = p)
      (d_ext : K_ext) (d_seq : ℕ → K_ext)
      (hd_seq_inj : ∀ j k : ℕ, j < p → k < p → d_seq j = d_seq k → j = k)
      (hadj : IntermediateField.adjoin E₀ ({d_ext} : Set K_ext) = ⊤)
      (hsplit : (minpoly E₀ d_ext).map (algebraMap E₀ K_ext) =
        ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C (d_seq k))),
      ∃ e_aut : Fin p ≃ (K_ext ≃ₐ[E₀] K_ext),
        (∀ k : Fin p, e_aut k d_ext = d_seq k.1) ∧
        (∀ (K₀ : Type u) [CommRing K₀] (f : K_ext →+* K₀) (w : K_ext),
          f (algebraMap E₀ K_ext (Algebra.norm E₀ w)) = ∏ k : Fin p, f (e_aut k w)) ∧
        (∀ (K₀ : Type u) [CommRing K₀] (f : K_ext →+* K₀) (w : K_ext),
          f (algebraMap E₀ K_ext (Algebra.trace E₀ K_ext w)) = ∑ k : Fin p, f (e_aut k w)) := by
    intro E₀ K_ext _ _ _ _ hdeg d_ext d_seq hd_seq_inj hadj hsplit
    have hd_int : IsIntegral E₀ d_ext := IsIntegral.of_finite E₀ d_ext
    let e_top : ↥(IntermediateField.adjoin E₀ ({d_ext} : Set K_ext)) ≃ₐ[E₀] K_ext :=
      (IntermediateField.equivOfEq hadj).trans IntermediateField.topEquiv
    let pb_K : PowerBasis E₀ K_ext := (IntermediateField.adjoin.powerBasis hd_int).map e_top
    have hpb_gen : pb_K.gen = d_ext := rfl
    have hroot : ∀ k ∈ Finset.range p, Polynomial.aeval (d_seq k) (minpoly E₀ pb_K.gen) = 0 := by
      intro k hk
      rw [hpb_gen, Polynomial.aeval_def, ← Polynomial.eval_map, hsplit, Polynomial.eval_prod]
      apply Finset.prod_eq_zero hk
      rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]
    let φ_ext (k : Fin p) : K_ext →ₐ[E₀] K_ext :=
      pb_K.lift (d_seq k.1) (hroot k.1 (Finset.mem_range.mpr k.2))
    let τ_ext (k : Fin p) : K_ext ≃ₐ[E₀] K_ext :=
      AlgEquiv.ofBijective (φ_ext k) (AlgHom.bijective (φ_ext k))
    have hτ_ext_gen : ∀ k : Fin p, τ_ext k d_ext = d_seq k.1 := by
      intro k
      have h1 : τ_ext k pb_K.gen = d_seq k.1 :=
        pb_K.lift_gen (d_seq k.1) (hroot k.1 (Finset.mem_range.mpr k.2))
      rw [hpb_gen] at h1
      exact h1
    have hτ_inj : Function.Injective τ_ext := by
      intro j k hjk
      have hd_eq : d_seq j.1 = d_seq k.1 := by
        have h_ev := congrArg (fun σ : K_ext ≃ₐ[E₀] K_ext => σ d_ext) hjk
        dsimp at h_ev
        rw [hτ_ext_gen j, hτ_ext_gen k] at h_ev
        exact h_ev
      exact Fin.ext (hd_seq_inj j.1 k.1 j.2 k.2 hd_eq)
    have hτ_surj : Function.Surjective τ_ext := by
      intro σ
      have hσ_aeval : Polynomial.aeval (σ d_ext) (minpoly E₀ d_ext) = 0 := by
        have h1 := Polynomial.aeval_algHom_apply (σ : K_ext →ₐ[E₀] K_ext) d_ext (minpoly E₀ d_ext)
        rw [minpoly.aeval E₀ d_ext, map_zero] at h1
        exact h1
      rw [Polynomial.aeval_def, ← Polynomial.eval_map, hsplit, Polynomial.eval_prod] at hσ_aeval
      obtain ⟨m, hm_mem, hm_eval⟩ := Finset.prod_eq_zero_iff.mp hσ_aeval
      have hm : m < p := Finset.mem_range.mp hm_mem
      rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at hm_eval
      have hσ_dK : σ d_ext = d_seq m := sub_eq_zero.mp hm_eval
      refine ⟨⟨m, hm⟩, ?_⟩
      apply AlgEquiv.coe_algHom_injective
      apply pb_K.algHom_ext
      rw [hpb_gen]
      change τ_ext ⟨m, hm⟩ d_ext = σ d_ext
      rw [hτ_ext_gen ⟨m, hm⟩, hσ_dK]
    let e_aut : Fin p ≃ (K_ext ≃ₐ[E₀] K_ext) := Equiv.ofBijective τ_ext ⟨hτ_inj, hτ_surj⟩
    have hcard_aut : Nat.card (K_ext ≃ₐ[E₀] K_ext) = Module.finrank E₀ K_ext := by
      rw [Nat.card_congr e_aut.symm, Nat.card_fin, hdeg]
    haveI : IsGalois E₀ K_ext := IsGalois.of_card_aut_eq_finrank E₀ K_ext hcard_aut
    refine ⟨e_aut, hτ_ext_gen, ?_, ?_⟩
    · intro K₀ _ f w
      rw [Algebra.norm_eq_prod_automorphisms E₀ w, map_prod]
      exact (Equiv.prod_comp e_aut (fun σ : K_ext ≃ₐ[E₀] K_ext => f (σ w))).symm
    · intro K₀ _ f w
      rw [trace_eq_sum_automorphisms w, map_sum]
      exact (Equiv.sum_comp e_aut (fun σ : K_ext ≃ₐ[E₀] K_ext => f (σ w))).symm
  let K₁_ext := IntermediateField.extendScalars hE'K₁
  let d_K : K₁_ext := toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ d)
  let d_Kk (k : ℕ) : K₁_ext :=
    toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))
  let fromExtendScalars : K₁_ext →+* K₁ :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hE'K₁).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let eF : K₁ ≃ₐ[F] K₁_ext :=
    { toExtendScalars F hE'K₁ with
      invFun := fromExtendScalars
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional E' K₁_ext := by
    haveI : FiniteDimensional F K₁_ext := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F E' K₁_ext := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F E' K₁_ext
  have hd_seq_inj : ∀ j k : ℕ, j < p → k < p → d_Kk j = d_Kk k → j = k := by
    intro j k hj hk hd_eq
    have hinc_eq : IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ j) d) =
        IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d) :=
      eF.injective hd_eq
    have hσ_eq : (σ₀ ^ j) d = (σ₀ ^ k) d :=
      (IntermediateField.inclusion hM₁'K₁).injective hinc_eq
    rcases lt_trichotomy j k with hlt | heq | hgt
    · exfalso
      exact hd_sep j k hlt hk (sub_eq_zero.mpr hσ_eq.symm)
    · exact heq
    · exfalso
      exact hd_sep k j hgt hj (sub_eq_zero.mpr hσ_eq)
  obtain ⟨e_aut, hτ_ext_gen, hnorm_ext, htr_ext⟩ :=
    h_abs E' K₁_ext hdegE'K₁ d_K d_Kk hd_seq_inj hadj_top hminpoly_split
  let τ (k : ℕ) : K₁ →+* K₁ :=
    if hk : k < p then
      fromExtendScalars.comp
        ((e_aut ⟨k, hk⟩).toRingEquiv.toRingHom.comp (toExtendScalars F hE'K₁))
    else
      RingHom.id K₁
  have hτ_lt : ∀ (k : ℕ) (hk : k < p) (w : K₁),
      τ k w = fromExtendScalars (e_aut ⟨k, hk⟩ (toExtendScalars F hE'K₁ w)) := by
    intro k hk w
    dsimp [τ]
    rw [dif_pos hk]
    rfl
  have hτ_val : ∀ k ∈ Finset.range p, ∀ w : K₁, valL F K₁ (τ k w) = valL F K₁ w := by
    intro k hk_mem w
    have hk : k < p := Finset.mem_range.mp hk_mem
    let σ_k : K₁ ≃ₐ[F] K₁ :=
      eF.trans ((AlgEquiv.restrictScalars F (e_aut ⟨k, hk⟩)).trans eF.symm)
    have hσ_k_eq : σ_k w = τ k w := by
      rw [hτ_lt k hk w]
      rfl
    unfold valL relVal
    rw [← hσ_k_eq, Algebra.norm_eq_of_algEquiv σ_k w]
  have hτ_norm : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) =
        ∏ k ∈ Finset.range p, τ k w := by
    intro w
    have h_inc : IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) =
        fromExtendScalars (algebraMap E' K₁_ext (Algebra.norm E' (toExtendScalars F hE'K₁ w))) := rfl
    rw [h_inc, hnorm_ext K₁ fromExtendScalars (toExtendScalars F hE'K₁ w)]
    rw [← Fin.prod_univ_eq_prod_range (fun k => τ k w)]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [hτ_lt i.1 i.2 w]
  have hτ_tr : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) =
        ∑ k ∈ Finset.range p, τ k w := by
    intro w
    have h_inc : IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) =
        fromExtendScalars (algebraMap E' K₁_ext (Algebra.trace E' K₁_ext (toExtendScalars F hE'K₁ w))) := rfl
    rw [h_inc, htr_ext K₁ fromExtendScalars (toExtendScalars F hE'K₁ w)]
    rw [← Fin.sum_univ_eq_sum_range (fun k => τ k w)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hτ_lt i.1 i.2 w]
  have hnorm_x_d : ∀ x : E',
      IntermediateField.inclusion hE'K₁
        (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)) =
      ∏ k ∈ Finset.range p,
        (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d)) := by
    intro x
    rw [hτ_norm (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)]
    refine Finset.prod_congr rfl fun k hk_mem => ?_
    have hk : k < p := Finset.mem_range.mp hk_mem
    rw [map_add]
    have hτ_x : τ k (IntermediateField.inclusion hE'K₁ x) = IntermediateField.inclusion hE'K₁ x := by
      rw [hτ_lt k hk (IntermediateField.inclusion hE'K₁ x)]
      have h_alg : toExtendScalars F hE'K₁ (IntermediateField.inclusion hE'K₁ x) =
          algebraMap E' K₁_ext x := rfl
      rw [h_alg, (e_aut ⟨k, hk⟩).commutes x]
      rfl
    have hτ_d : τ k (IntermediateField.inclusion hM₁'K₁ d) =
        IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d) := by
      rw [hτ_lt k hk (IntermediateField.inclusion hM₁'K₁ d)]
      have h_dK : toExtendScalars F hE'K₁ (IntermediateField.inclusion hM₁'K₁ d) = d_K := rfl
      rw [h_dK, hτ_ext_gen ⟨k, hk⟩]
      rfl
    rw [hτ_x, hτ_d]
  exact ⟨hnorm_x_d, τ, hτ_val, hτ_norm, hτ_tr⟩

theorem ld_wild_odd_unramified_k1_galois_lift_and_aut_package (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (c : L) (d : M₁') (r : ℕ → L)
    (hd_val : valL F M₁' d = 0)
    (hd_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)))
    (hd_sep :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∀ j k : ℕ, j < k → k < p → (σ₀ ^ k) d - (σ₀ ^ j) d ≠ 0)
    (hPd_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
        (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
          ∑ i ∈ Finset.range p,
            Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    (∀ x : E',
      IntermediateField.inclusion hE'K₁
        (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)) =
      ∏ k ∈ Finset.range p,
        (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))) ∧
    ∃ τ : ℕ → (K₁ →+* K₁),
      (∀ k ∈ Finset.range p, ∀ w : K₁, valL F K₁ (τ k w) = valL F K₁ w) ∧
      (∀ w : K₁,
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) =
          ∏ k ∈ Finset.range p, τ k w) ∧
      (∀ w : K₁,
        IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) =
          ∑ k ∈ Finset.range p, τ k w) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  obtain ⟨hadj_top, hminpoly_split⟩ :=
    ld_wild_odd_unramified_k1_generator_adjoin_and_minpoly_split F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hdegE'K₁ T hT_ge2
      hvalL_props hvalE'_props hp_val hval_LE' hval_E'K₁ hval_M₁'K₁ hDiamond_M₁'
      σ₀ c d r hd_val hd_tr_top hPd_eq
  exact ld_wild_odd_unramified_k1_power_basis_lift_aut_and_norm_trace F E' M₁' K₁
    hE'K₁ hM₁'K₁ p hdegE'K₁ σ₀ d hd_sep hadj_top hminpoly_split

theorem ld_wild_odd_unramified_k1_norm_x_add_d_congruence (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (c : L) (d : M₁') (r : ℕ → L)
    (hr_val : ∀ i : ℕ, r i = 0 ∨ (2 * (T : ℤ) + 1) ≤ valL F L (r i))
    (hPd_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d)) =
        (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
          ∑ i ∈ Finset.range p,
            Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i)
    (hnorm_x_d :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∀ x : E',
        IntermediateField.inclusion hE'K₁
          (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)) =
        ∏ k ∈ Finset.range p,
          (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    ∀ x : E', (x = 0 ∨ -((T - 1 : ℕ) : ℤ) ≤ valL F E' x) →
      normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d) -
        (x ^ p - x + IntermediateField.inclusion hLE' c) = 0 ∨
        (T : ℤ) ≤ valL F E'
          (normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d) -
            (x ^ p - x + IntermediateField.inclusion hLE' c)) :=
by
  have hval_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ z : M, valL F M (-z) = valL F M z) ∧
      (∀ y z : M, y ≠ 0 → z ≠ 0 → valL F M (y * z) = valL F M y + valL F M z) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (y z : M),
        (y = 0 ∨ k ≤ valL F M y) → (z = 0 ∨ k ≤ valL F M z) →
          (y + z = 0 ∨ k ≤ valL F M (y + z))) := by
    intro M _
    have halg_gen : ∀ (F₀ : Type u) [Field F₀]
        (M₀ : IntermediateField F₀ (AlgebraicClosure F₀)) [FiniteDimensional F₀ M₀] (z : M₀),
        minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z ∧
        ∃ m : ℕ,
          Algebra.norm F₀ z = ((-1) ^ (minpoly F₀ z).natDegree * (minpoly F₀ z).coeff 0) ^ m ∧
          Module.finrank F₀ M₀ = (minpoly F₀ z).natDegree * m := by
      intro F₀ _ M₀ _ z
      have hmin_coe : minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z :=
        minpoly.algHom_eq M₀.val M₀.val.injective z
      have hz : IsIntegral F₀ z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F₀ z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F₀ pb.gen = minpoly F₀ z := by
        have hval : (IntermediateField.adjoin F₀ {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F₀ {z}).val
          (IntermediateField.adjoin F₀ {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F₀ z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F₀ z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    have halg : ∀ z : M,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F M = (minpoly F z).natDegree * m :=
      halg_gen F M
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F M (-1) = 0 := by
      have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F M ((-1 : M) * (-1 : M)) = relVal F M (-1) + relVal F M (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : M) * (-1 : M) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : M, relVal F M (-x) = relVal F M x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : M) = (-1 : M) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul : relVal F M ((u : M) * ((u⁻¹ : Mˣ) : M)) =
          relVal F M (u : M) + relVal F M ((u⁻¹ : Mˣ) : M) :=
        hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : M := algebraMap F M π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F M x₀ = (Module.finrank F M : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F M := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F M, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖ₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    have hdiv : ∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F M : ℤ)
        set q : ℤ := valL F M x
        set r : ℤ := relVal F M x % f
        have hediv : f * q + r = relVal F M x := Int.mul_ediv_add_emod (relVal F M x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M x) hfM_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M x) hfM_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : M := x * (((ϖM ^ (-q) : Mˣ) : M))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F M y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q), hrel_ϖM]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F M := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F M 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval1 : valL F M 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg1 : valL F M (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg : ∀ x : M, valL F M (-x) = valL F M x := by
      intro x
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
      intro u
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_add : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : M,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : M, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F M z ≤ valL F M w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F M) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfM_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : M) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F M x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F M y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_add⟩
  have val_neg_ge : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      {k : ℤ} {z : M}, (z = 0 ∨ k ≤ valL F M z) → (-z = 0 ∨ k ≤ valL F M (-z)) := by
    intro M _ k z hz
    rcases hz with rfl | hz
    · simp
    · right
      rw [(hval_props M).2.2.2.1 z]
      exact hz
  have val_add_ge : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      {k : ℤ} {y z : M},
      (y = 0 ∨ k ≤ valL F M y) → (z = 0 ∨ k ≤ valL F M z) →
        (y + z = 0 ∨ k ≤ valL F M (y + z)) := by
    intro M _ k y z hy hz
    exact (hval_props M).2.2.2.2.2.2 k y z hy hz
  have val_mul_ge : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      {k₁ k₂ : ℤ} {y z : M},
      (y = 0 ∨ k₁ ≤ valL F M y) → (z = 0 ∨ k₂ ≤ valL F M z) →
        (y * z = 0 ∨ k₁ + k₂ ≤ valL F M (y * z)) := by
    intro M _ k₁ k₂ y z hy hz
    by_cases hy0 : y = 0
    · exact Or.inl (by simp [hy0])
    · by_cases hz0 : z = 0
      · exact Or.inl (by simp [hz0])
      · right
        rw [(hval_props M).2.2.2.2.1 y z hy0 hz0]
        exact add_le_add (hy.resolve_left hy0) (hz.resolve_left hz0)
  have val_mono : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      {k₁ k₂ : ℤ} {z : M},
      k₁ ≤ k₂ → (z = 0 ∨ k₂ ≤ valL F M z) → (z = 0 ∨ k₁ ≤ valL F M z) := by
    intro M _ k₁ k₂ z hk hz
    exact hz.imp_right (le_trans hk)
  have val_pow_ge : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      {q : ℤ} {z : M},
      (z = 0 ∨ q ≤ valL F M z) → ∀ (k : ℕ), z ^ k = 0 ∨ (k : ℤ) * q ≤ valL F M (z ^ k) := by
    intro M _ q z hz k
    induction k with
    | zero =>
      right
      rw [pow_zero, (hval_props M).2.1]
      omega
    | succ k ih =>
      rw [pow_succ]
      have hmul := val_mul_ge ih hz
      refine val_mono ?_ hmul
      push_cast
      linarith
  have val_sum_ge : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i)) := by
    intro M _ S f k hf
    induction S using Finset.induction_on with
    | empty =>
      exact Or.inl (by simp)
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact val_add_ge (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  intro p
  have hp_two : 2 ≤ p := Nat.Prime.two_le hPrime
  have hp_ge3 : 3 ≤ p := by omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  have hneg1_K₁ : (-1 : K₁) ^ p = -1 := Odd.neg_one_pow hp_odd_nat
  have hneg_pow_K₁ : ∀ y : K₁, (-y) ^ p = - (y ^ p) := by
    intro y
    rw [neg_eq_neg_one_mul y, mul_pow, hneg1_K₁, neg_one_mul]
  have hdiamond_incl : ∀ a : L,
      IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' a) =
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' a) :=
    fun _ => rfl
  intro x hx
  have hdiff_eq :
      normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d) -
        (x ^ p - x + IntermediateField.inclusion hLE' c) =
      - ∑ i ∈ Finset.range p, IntermediateField.inclusion hLE' (r i) * (-x) ^ i := by
    let ιM₁'K₁ : M₁' →+* K₁ := (IntermediateField.inclusion hM₁'K₁).toRingHom
    let y_K : K₁ := - IntermediateField.inclusion hE'K₁ x
    have heval := congrArg (Polynomial.eval₂ ιM₁'K₁ y_K) hPd_eq
    have hLHS :
        Polynomial.eval₂ ιM₁'K₁ y_K (∏ k ∈ Finset.range p, (Polynomial.X - Polynomial.C ((σ₀ ^ k) d))) =
          IntermediateField.inclusion hE'K₁
            (- normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)) := by
      rw [Polynomial.eval₂_finset_prod]
      have hprod_eq :
          (∏ k ∈ Finset.range p, Polynomial.eval₂ ιM₁'K₁ y_K (Polynomial.X - Polynomial.C ((σ₀ ^ k) d))) =
          ∏ k ∈ Finset.range p,
            ((-1 : K₁) * (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))) := by
        refine Finset.prod_congr rfl fun k _ => ?_
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
        change - IntermediateField.inclusion hE'K₁ x - IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d) =
          (-1 : K₁) * (IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ ((σ₀ ^ k) d))
        ring
      rw [hprod_eq, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range,
        hneg1_K₁, neg_one_mul, ← hnorm_x_d x, map_neg]
    have hRHS :
        Polynomial.eval₂ ιM₁'K₁ y_K
          ((Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hLM₁' c)) +
            ∑ i ∈ Finset.range p,
              Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i) =
        IntermediateField.inclusion hE'K₁
          ((- (x ^ p) - (-x) - IntermediateField.inclusion hLE' c) +
            ∑ i ∈ Finset.range p, IntermediateField.inclusion hLE' (r i) * (-x) ^ i) := by
      rw [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_sub,
        Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C, Polynomial.eval₂_finset_sum]
      have hsum_eq :
          (∑ i ∈ Finset.range p,
            Polynomial.eval₂ ιM₁'K₁ y_K
              (Polynomial.C (IntermediateField.inclusion hLM₁' (r i)) * Polynomial.X ^ i)) =
          IntermediateField.inclusion hE'K₁
            (∑ i ∈ Finset.range p, IntermediateField.inclusion hLE' (r i) * (-x) ^ i) := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow, Polynomial.eval₂_X]
        change IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' (r i)) *
          (- IntermediateField.inclusion hE'K₁ x) ^ i =
          IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (r i) * (-x) ^ i)
        rw [hdiamond_incl (r i), map_mul, map_pow, map_neg]
      rw [hsum_eq]
      dsimp [y_K, ιM₁'K₁]
      rw [hneg_pow_K₁, hdiamond_incl c, map_add, map_sub, map_sub, map_neg, map_pow, map_neg]
    rw [hLHS, hRHS] at heval
    have hinj := (IntermediateField.inclusion hE'K₁).injective heval
    linear_combination -hinj
  have hneg_x : -x = 0 ∨ -((T - 1 : ℕ) : ℤ) ≤ valL F E' (-x) := val_neg_ge hx
  have hsum_bound :
      (∑ i ∈ Finset.range p, IntermediateField.inclusion hLE' (r i) * (-x) ^ i) = 0 ∨
        (T : ℤ) ≤ valL F E' (∑ i ∈ Finset.range p, IntermediateField.inclusion hLE' (r i) * (-x) ^ i) := by
    apply val_sum_ge (Finset.range p) (fun i => IntermediateField.inclusion hLE' (r i) * (-x) ^ i) (T : ℤ)
    intro i hi
    have hi_lt : i < p := Finset.mem_range.mp hi
    have hr_E' :
        IntermediateField.inclusion hLE' (r i) = 0 ∨
          (p : ℤ) * (2 * (T : ℤ) + 1) ≤ valL F E' (IntermediateField.inclusion hLE' (r i)) := by
      rcases hr_val i with hr0 | hr_ge
      · exact Or.inl (by simp [hr0])
      · right
        rw [hval_LE' (r i)]
        exact mul_le_mul_of_nonneg_left hr_ge (by positivity)
    have hx_pow :
        (-x) ^ i = 0 ∨ (i : ℤ) * (-((T - 1 : ℕ) : ℤ)) ≤ valL F E' ((-x) ^ i) :=
      val_pow_ge hneg_x i
    have hmul := val_mul_ge hr_E' hx_pow
    refine val_mono ?_ hmul
    have hT1 : ((T - 1 : ℕ) : ℤ) = (T : ℤ) - 1 := by omega
    have hi_le : (i : ℤ) ≤ (p : ℤ) - 1 := by omega
    have hp3 : (3 : ℤ) ≤ (p : ℤ) := by omega
    have hT2 : (2 : ℤ) ≤ (T : ℤ) := by omega
    rw [hT1]
    nlinarith
  rw [hdiff_eq]
  exact val_neg_ge hsum_bound

theorem ld_wild_odd_unramified_k1_quad_norm_trace_congruence (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (p : ℕ)
    (τ : ℕ → (K₁ →+* K₁))
    (hτ_val : ∀ k ∈ Finset.range p, ∀ w : K₁, valL F K₁ (τ k w) = valL F K₁ w)
    (hτ_norm : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) =
        ∏ k ∈ Finset.range p, τ k w)
    (hτ_tr : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) =
        ∑ k ∈ Finset.range p, τ k w) :
    ∀ (m : ℕ), 1 ≤ m → ∀ w : K₁, (w = 0 ∨ (m : ℤ) ≤ valL F K₁ w) →
      let u_E := normLM F hE'K₁ (1 + w) - 1
      (2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2) = 0 ∨
        (3 * (m : ℤ)) ≤ valL F E' ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2)) :=
by
  have hval_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ z : M, valL F M (-z) = valL F M z) ∧
      (∀ y z : M, y ≠ 0 → z ≠ 0 → valL F M (y * z) = valL F M y + valL F M z) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (y z : M),
        (y = 0 ∨ k ≤ valL F M y) → (z = 0 ∨ k ≤ valL F M z) →
          (y + z = 0 ∨ k ≤ valL F M (y + z))) := by
    intro M _
    have halg_gen : ∀ (F₀ : Type u) [Field F₀]
        (M₀ : IntermediateField F₀ (AlgebraicClosure F₀)) [FiniteDimensional F₀ M₀] (z : M₀),
        minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z ∧
        ∃ m : ℕ,
          Algebra.norm F₀ z = ((-1) ^ (minpoly F₀ z).natDegree * (minpoly F₀ z).coeff 0) ^ m ∧
          Module.finrank F₀ M₀ = (minpoly F₀ z).natDegree * m := by
      intro F₀ _ M₀ _ z
      have hmin_coe : minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z :=
        minpoly.algHom_eq M₀.val M₀.val.injective z
      have hz : IsIntegral F₀ z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F₀ z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F₀ pb.gen = minpoly F₀ z := by
        have hval : (IntermediateField.adjoin F₀ {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F₀ {z}).val
          (IntermediateField.adjoin F₀ {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F₀ z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F₀ z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    have halg : ∀ z : M,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F M = (minpoly F z).natDegree * m :=
      halg_gen F M
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
