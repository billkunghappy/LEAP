      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvmul_ge : ∀ (k₁ k₂ : ℤ) (x y : M),
        (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvmul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvpow_ge : ∀ (x : M) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        simp [hv1]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvmul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvsum_ge : ∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvadd k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    have hvnat : ∀ n : ℕ, (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M) := by
      intro n
      induction n with
      | zero => left; exact Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hvadd 0 (n : M) 1 ih (Or.inr (by rw [hv1]))
    exact ⟨hvpow, hvinv_elt, hvsub, hvmono, hvmul_ge, hvpow_ge, hvsum_ge, hvnat⟩
  obtain ⟨hvalE'_pow, _, _, _, _, _, _, _⟩ :=
    hval_helpers E' hvalE'_1 hvalE'_neg hvalE'_mul hvalE'_inv hvalE'_add
  obtain ⟨hvalK₁_pow, hvalK₁_inv_elt, hvalK₁_sub, hvalK₁_mono,
      hvalK₁_mul_ge, hvalK₁_pow_ge, hvalK₁_sum_ge, hvalK₁_natCast⟩ :=
    hval_helpers K₁ hvalK₁_1 hvalK₁_neg hvalK₁_mul hvalK₁_inv hvalK₁_add
  clear hval_helpers
  
  set δ : ℕ := bE' - bM₁'
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by dsimp [p]; omega
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have ht₂_eq : t₂ = t₁ + δ := by dsimp [t₁, t₂, δ]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpm_gt : t₁ < p * m := hpm_gt_t₁
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hp2_cast : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := by omega
  have hp3_cast : ((p - 3 : ℕ) : ℤ) = (p : ℤ) - 3 := by omega
  have hW_L_ne0 : W ≠ 0 := mul_ne_zero (Units.ne_zero γ) (Units.ne_zero α⁻¹)
  have hW_L_val : valL F L W = -(m : ℤ) := by
    dsimp [W, m]
    rw [hval_mul_L (γ : L) ((α⁻¹ : Lˣ) : L) (Units.ne_zero γ) (Units.ne_zero α⁻¹),
      hval_inv_L α, hγ_val, hα_val]
    omega
  have hW_E'_ne0 : W_E' ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hW_L_ne0
  have hW_E'_val : valL F E' W_E' = -(((p * m : ℕ) : ℤ)) := by
    dsimp [W_E']
    rw [hval_LE', hW_L_val]
    push_cast; ring
  have hW_K₁_ne0 : W_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hW_E'_ne0
  have hW_K₁_val : valL F K₁ W_K₁ = -(((p * p * m : ℕ) : ℤ)) := by
    dsimp [W_K₁]
    rw [hval_E'K₁, hW_E'_val]
    push_cast; ring
  have ha_ne0 : a ≠ 0 := Units.ne_zero (Units.map (normLM F hE'K₁) Δ)
  have ha_val : valL F E' a = -(t₁ : ℤ) := by
    dsimp [a, t₁]
    rw [hval_norm_E'K₁, hΔ_val]
  set a_K₁ : K₁ := IntermediateField.inclusion hE'K₁ a
  have ha_K₁_val : valL F K₁ a_K₁ = -(((p * t₁ : ℕ) : ℤ)) := by
    dsimp [a_K₁]
    rw [hval_E'K₁, ha_val]
    push_cast; ring
  set D₀_K₁ : K₁ := IntermediateField.inclusion hE'K₁ D₀_E'
  have hD₀_K₁_ne0 : D₀_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hD₀_ne0
  have hD₀_K₁_val : valL F K₁ D₀_K₁ = -(((p * p * p * m : ℕ) : ℤ)) := by
    dsimp [D₀_K₁]
    rw [hval_E'K₁, hD₀_val]
    push_cast; ring
  have hD₀_K₁_inv_ne0 : D₀_K₁⁻¹ ≠ 0 := inv_ne_zero hD₀_K₁_ne0
  have hD₀_K₁_inv_val : valL F K₁ D₀_K₁⁻¹ = ((p * p * p * m : ℕ) : ℤ) := by
    rw [hvalK₁_inv_elt D₀_K₁ hD₀_K₁_ne0, hD₀_K₁_val, neg_neg]
  set C_K₁ : K₁ := IntermediateField.inclusion hE'K₁ C
  have hC_K₁_ne0 : C_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hC_ne0
  have hC_K₁_val0 : valL F K₁ C_K₁ = 0 := by
    dsimp [C_K₁]
    rw [hval_E'K₁, hC_val0, mul_zero]
  have hC_inv_sq_map :
      IntermediateField.inclusion hE'K₁ (C⁻¹ ^ 2) = C_K₁⁻¹ ^ 2 := by
    dsimp [C_K₁]
    rw [map_pow, map_inv₀]
  have hC_K₁_inv_ne0 : C_K₁⁻¹ ≠ 0 := inv_ne_zero hC_K₁_ne0
  have hC_K₁_inv_sq_ne0 : C_K₁⁻¹ ^ 2 ≠ 0 := pow_ne_zero 2 hC_K₁_inv_ne0
  have hC_K₁_inv_sq_val0 : valL F K₁ (C_K₁⁻¹ ^ 2) = 0 := by
    rw [hvalK₁_pow C_K₁⁻¹ 2 hC_K₁_inv_ne0, hvalK₁_inv_elt C_K₁ hC_K₁_ne0,
      hC_K₁_val0, neg_zero, mul_zero]
  have hD₀C_inv_ne0 : D₀_K₁⁻¹ * C_K₁⁻¹ ^ 2 ≠ 0 :=
    mul_ne_zero hD₀_K₁_inv_ne0 hC_K₁_inv_sq_ne0
  have hD₀C_inv_val : valL F K₁ (D₀_K₁⁻¹ * C_K₁⁻¹ ^ 2) = ((p * p * p * m : ℕ) : ℤ) := by
    rw [hvalK₁_mul D₀_K₁⁻¹ (C_K₁⁻¹ ^ 2) hD₀_K₁_inv_ne0 hC_K₁_inv_sq_ne0,
      hD₀_K₁_inv_val, hC_K₁_inv_sq_val0, add_zero]
  have hw₂_inv_ne0 : ((w₂⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero w₂⁻¹
  have hw₂_inv_val : valL F E' ((w₂⁻¹ : E'ˣ) : E') = (m : ℤ) := by
    dsimp [m]
    rw [hvalE'_inv w₂, hw₂_val, neg_neg]
  have hw₂_p1_val :
      valL F K₁ (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1))) =
        ((p - 1 : ℕ) : ℤ) * (((p * m : ℕ) : ℤ)) := by
    rw [hval_E'K₁, hvalE'_pow _ (p - 1) hw₂_inv_ne0, hw₂_inv_val]
    push_cast; ring
  set Z_bound : ℤ := ((p * (p - 1) * δ : ℕ) : ℤ) - (t₁ : ℤ)
  set δ₁ : K₁ := (Δ : K₁) * IntermediateField.inclusion hM₁'K₁ s
  have hval_incl_M₁'K₁_ge : ∀ (z : M₁') (q : ℤ),
