      · exact Or.inl h0
      · exact Or.inr (by omega)
    rw [h1, h2, hψ_α₀_triv _ hs_tr, mul_one]
  have hψ_β_as : ∀ s : L, (s = 0 ∨ 0 ≤ valL F L s) → ψ (β * (s ^ p - s)) = 1 := by
    intro s hs
    let w₀ : E' := IntermediateField.inclusion hLE' s
    have hw₀_h₀ : w₀ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₀ := by
      rcases hs with rfl | hs_ge0
      · left; simp [w₀]
      · right
