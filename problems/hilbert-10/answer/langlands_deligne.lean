      h_gcd_roots_bound I_H k m_LK hk_pos u_I hu_I_0 hu_I_k hu_I_mLK hu_I_inj
    have hgcd_le_k : k.gcd m_LK ≤ k := Nat.gcd_le_left m_LK hk_pos
    have hgcd_eq_k : k.gcd m_LK = k := le_antisymm hgcd_le_k hcard_le_gcd
    rw [hk_eq_nat, ← hgcd_eq_k]
    exact Nat.gcd_dvd_right k m_LK
  exact ⟨I_H, hIH_norm, hk_ge1, hk_dvd, hk_ndvd, hIH_K_iff, hIH_MC_iff, hComm_surj, h_dvd_qe⟩

theorem ld_ch14_wild_lower_ramification_and_serre_commutator (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hp_prime : Nat.Prime (p F))
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp)
    (hq_eq : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (G : Type u) [Group G] [Fintype G] (C H : Subgroup G)
    (act : G → K → K) (act_MC : H → M_C → M_C)
    [C.Normal]
    (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (hcard_C : Nat.card C = Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hH_gt1 : 1 < Nat.card H)
    (hC_exp : ∀ c ∈ C, c ^ (p F) = 1)
    (hG_mul : ∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (hC_min_norm : ∀ N : Subgroup G, N.Normal → N = ⊥ ∨ C ≤ N)
    (hact_one : ∀ w : K, act 1 w = w)
    (hact_mul : ∀ (g₁ g₂ : G) (w : K), act (g₁ * g₂) w = act g₁ (act g₂ w))
    (hact_ring : ∀ g : G,
      act g 0 = 0 ∧ act g 1 = 1 ∧
      (∀ w₁ w₂ : K,
        act g (w₁ + w₂) = act g w₁ + act g w₂ ∧
        act g (w₁ * w₂) = act g w₁ * act g w₂ ∧
        act g (-w₁) = -act g w₁))
    (hact_incl_L : ∀ (g : G) (x : L),
      act g (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x)
    (hact_faithful : ∀ g : G, (∀ w : K, act g w = w) → g = 1)
    (hact_val : ∀ (g : G) (w : K), valL F K (act g w) = valL F K w)
    (hC_mem_iff : ∀ g : G,
      g ∈ C ↔ ∀ z : M_C,
        act g (IntermediateField.inclusion hM_CK z) =
          IntermediateField.inclusion hM_CK z)
    (hact_trace_MCK : ∀ w : K,
      IntermediateField.inclusion hM_CK (traceLM F hM_CK w) = ∑ c : C, act c.1 w)
    (hact_norm_MCK : ∀ w : K,
      IntermediateField.inclusion hM_CK (normLM F hM_CK w) = ∏ c : C, act c.1 w)
    (hact_MC_compat : ∀ (h : H) (z : M_C),
      IntermediateField.inclusion hM_CK (act_MC h z) =
        act h.1 (IntermediateField.inclusion hM_CK z)) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    qL F K = qL F M_C ∧
    resDeg F K = resDeg F M_C ∧
    (∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w) ∧
    (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z) ∧
    (∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z))) ∧
    ∃ (t : ℕ) (G₀ : Subgroup G) (I_H : Subgroup H),
      1 ≤ t ∧
      G₀.Normal ∧
      I_H.Normal ∧
      1 ≤ Nat.card I_H ∧
      Nat.card I_H ∣ (q - 1) ∧
      ¬ (p F ∣ Nat.card I_H) ∧
      (∀ g : G,
        g ∈ G₀ ↔ ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
          (act g w - w = 0 ∨ 1 ≤ valL F K (act g w - w))) ∧
      (∀ h : H,
        h ∈ I_H ↔ ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
          (act h.1 w - w = 0 ∨ 1 ≤ valL F K (act h.1 w - w))) ∧
      (∀ h : H,
        h ∈ I_H ↔ ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
          (act_MC h z - z = 0 ∨ 1 ≤ valL F M_C (act_MC h z - z))) ∧
      (∀ c ∈ C, c ≠ 1 → ∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
        (ϖ_K : K) - act c (ϖ_K : K) ≠ 0 ∧
        valL F K ((ϖ_K : K) - act c (ϖ_K : K)) = (t + 1 : ℤ)) ∧
      (∀ σ ∈ G₀, σ ∉ C →
        Function.Surjective (fun c : C =>
          (⟨σ * c.1 * σ⁻¹ * c.1⁻¹,
            C.mul_mem (‹C.Normal›.conj_mem c.1 c.2 σ) (C.inv_mem c.2)⟩ : C))) ∧
      (∀ (e_MCL e_KE : ℕ),
        1 ≤ e_MCL → e_MCL ≤ Nat.card I_H →
        1 ≤ e_KE → e_KE ≤ Nat.card I_H →
        (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (e_MCL : ℤ) * valL F L x) →
        (∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (e_KE : ℤ) * valL F E y) →
        e_MCL = Nat.card I_H ∧
        e_KE = Nat.card I_H ∧
        resDeg F E = resDeg F L) :=
by
  intro q
  obtain ⟨hq_gt1, _, ⟨e_MCK, f_MCK, he_pos, hf_pos, hef_eq, hres_f, hnorm_f, hincl_e⟩,
    h_res_comm, h_frob_surj_q, h_pow_p_mod1, h_gcd_roots_bound, h_diamond⟩ :=
    ld_ch14_ef_finrank_and_residue_roots_package F L K M_C E hLK hLM_C hM_CK hLE hEK
      hp_prime r_exp hr_exp_pos hq_eq hFinE_eq
  obtain ⟨hqK, hresK, hValNormK, hValAlgK, hResLiftK,
    t, G₀, ht_ge1, hG₀_norm, hC_le_G₀, hG₀_iff, hC_le_Gt, hJumpK_C⟩ :=
    ld_ch14_wild_inertia_jump_and_total_ramification F M_C K hM_CK
      hq_gt1 e_MCK f_MCK he_pos hf_pos hef_eq hres_f hnorm_f hincl_e
      G C H act hcard_C hH_gt1 hC_exp hZ_H hC_min_norm
      hact_one hact_mul hact_ring hact_faithful hact_val
      hC_mem_iff hact_trace_MCK hact_norm_MCK
      h_res_comm h_frob_surj_q h_pow_p_mod1
  letI : G₀.Normal := hG₀_norm
  obtain ⟨I_H, hIH_norm, hk_ge1, hk_dvd, hk_ndvd, hIH_K_iff, hIH_MC_iff, hComm_surj, h_dvd_qe⟩ :=
    ld_ch14_serre_commutator_and_tame_inertia_divisibility F L K M_C hLK hLM_C hM_CK
      hp_prime r_exp hr_exp_pos hq_eq hValAlgK hResLiftK
      G C H G₀ act act_MC hC_ab hcard_C hG_mul hZ_H
      hact_one hact_mul hact_ring hact_incl_L hact_val hact_MC_compat
      hC_le_G₀ hG₀_iff t ht_ge1 hC_le_Gt hJumpK_C h_gcd_roots_bound
  have hcop_kq : Nat.Coprime (Nat.card I_H) q := by
    rw [Nat.Coprime]
    set d : ℕ := (Nat.card I_H).gcd q
    have hd_dvd_k : d ∣ Nat.card I_H := Nat.gcd_dvd_left (Nat.card I_H) q
    have hd_dvd_q : d ∣ q := Nat.gcd_dvd_right (Nat.card I_H) q
    have hd_dvd_q1 : d ∣ (q - 1) := dvd_trans hd_dvd_k hk_dvd
    have hq_sub : q - (q - 1) = 1 := by omega
    have hd_dvd_1 : d ∣ 1 := hq_sub ▸ Nat.dvd_sub hd_dvd_q hd_dvd_q1
    exact Nat.eq_one_of_dvd_one hd_dvd_1
  refine ⟨hqK, hresK, hValNormK, hValAlgK, hResLiftK,
    t, G₀, I_H, ht_ge1, hG₀_norm, hIH_norm, hk_ge1, hk_dvd, hk_ndvd,
    hG₀_iff, hIH_K_iff, hIH_MC_iff, hJumpK_C, hComm_surj, ?_⟩
  intro e_MCL e_KE he_MCL_ge1 he_MCL_le he_KE_ge1 he_KE_le hValMC_L hValK_E
  exact h_diamond (Nat.card I_H) e_MCL e_KE hk_ge1 hcop_kq he_MCL_ge1 he_MCL_le
    he_KE_ge1 he_KE_le (h_dvd_qe e_MCL he_MCL_ge1 hValMC_L) hValAlgK hValMC_L hValK_E

theorem ld_ch14_wild_orbit_inertia_trivial_and_galois_action (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C F_i K_i : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F K] [FiniteDimensional F F_i]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLFi : L ≤ F_i) (hFiMC : F_i ≤ M_C)
    (hFiKi : F_i ≤ K_i) (hKiK : K_i ≤ K)
    (hGalFiMC : IsGaloisExt F F_i M_C)
    (hAbFiKi : IsAbelianExt F hFiKi)
    (μ'_i : F_iˣ →* (Ω F)ˣ)
    (hμ'_ker : ∀ z : F_iˣ,
      z ∈ Set.range (Units.map (normLM F hFiKi)) ↔ μ'_i z = 1)
    (hμ'_comp_ne1 : (μ'_i.comp (Units.map (normLM F hFiMC))) ≠ 1)
    (hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (G : Type u) [Group G] (C G₀ : Subgroup G) [C.Normal]
    (act : G → K → K)
    (hact_mul : ∀ (g₁ g₂ : G) (w : K), act (g₁ * g₂) w = act g₁ (act g₂ w))
    (hact_ring : ∀ g : G,
      act g 0 = 0 ∧ act g 1 = 1 ∧
      (∀ w₁ w₂ : K,
        act g (w₁ + w₂) = act g w₁ + act g w₂ ∧
        act g (w₁ * w₂) = act g w₁ * act g w₂ ∧
        act g (-w₁) = -act g w₁))
    (hact_val : ∀ (g : G) (w : K), valL F K (act g w) = valL F K w)
    (hC_mem_iff : ∀ g : G,
      g ∈ C ↔ ∀ z : M_C,
        act g (IntermediateField.inclusion hM_CK z) =
          IntermediateField.inclusion hM_CK z)
    (hC_fixed_iff : ∀ w : K,
      (∀ c ∈ C, act c w = w) ↔
        w ∈ Set.range (IntermediateField.inclusion hM_CK))
    (hG₀_iff : ∀ g : G,
      g ∈ G₀ ↔ ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
        (act g w - w = 0 ∨ 1 ≤ valL F K (act g w - w)))
    (hComm_surj : ∀ σ ∈ G₀, σ ∉ C →
      Function.Surjective (fun c : C =>
        (⟨σ * c.1 * σ⁻¹ * c.1⁻¹,
          C.mul_mem (‹C.Normal›.conj_mem c.1 c.2 σ) (C.inv_mem c.2)⟩ : C)))
    (hLift_to_G : ∀ σ ∈ L.fixingSubgroup, ∃ g : G,
      (σ ∈ K.fixingSubgroup ↔ g = 1) ∧
      ∀ w : K, ∀ hσw : (σ : AbsGal F) (w : AlgebraicClosure F) ∈ K,
        act g w = ⟨(σ : AbsGal F) (w : AlgebraicClosure F), hσw⟩)
    (hLift_from_G : ∀ g : G, ∃ σ ∈ L.fixingSubgroup,
      ∀ w : K, ((act g w : K) : AlgebraicClosure F) = (σ : AbsGal F) (w : AlgebraicClosure F)) :
    ∃ (G_Fi : Type u) (_ : Group G_Fi) (_ : Fintype G_Fi) (act_Fi : G_Fi → M_C → M_C),
      (∀ z : M_C, act_Fi 1 z = z) ∧
      (∀ (σ τ : G_Fi) (z : M_C), act_Fi (σ * τ) z = act_Fi σ (act_Fi τ z)) ∧
      (∀ σ : G_Fi,
        act_Fi σ 0 = 0 ∧ act_Fi σ 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act_Fi σ (z₁ + z₂) = act_Fi σ z₁ + act_Fi σ z₂ ∧
          act_Fi σ (z₁ * z₂) = act_Fi σ z₁ * act_Fi σ z₂ ∧
          act_Fi σ (-z₁) = -act_Fi σ z₁)) ∧
      (∀ (σ : G_Fi) (x : F_i),
        act_Fi σ (IntermediateField.inclusion hFiMC x) = IntermediateField.inclusion hFiMC x) ∧
      (∀ (σ : G_Fi) (z : M_C), valL F M_C (act_Fi σ z) = valL F M_C z) ∧
      (∀ z : M_C,
        IntermediateField.inclusion hFiMC (traceLM F hFiMC z) = ∑ σ : G_Fi, act_Fi σ z) ∧
      (∀ σ : G_Fi,
        (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
          (act_Fi σ z - z = 0 ∨ 1 ≤ valL F M_C (act_Fi σ z - z))) →
        σ = 1) :=
by
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have hrelK_1 : relVal F K 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrelK_mul : ∀ x y : K, x ≠ 0 → y ≠ 0 → relVal F K (x * y) = relVal F K x + relVal F K y := by
    intro x y hx hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
  have hrelK_neg1 : relVal F K (-1) = 0 := by
    have h1 : (-1 : K) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have h2 := hrelK_mul (-1) (-1) h1 h1
    have h3 : (-1 : K) * (-1 : K) = 1 := by ring
    rw [h3, hrelK_1] at h2
    omega
  have hrelK_neg : ∀ w : K, relVal F K (-w) = relVal F K w := by
    intro w
    by_cases hw : w = 0
    · rw [hw, neg_zero]
    · have hneg : -w = (-1 : K) * w := by ring
      rw [hneg, hrelK_mul (-1) w (neg_ne_zero.mpr one_ne_zero) hw, hrelK_neg1, zero_add]
  have hvalK_neg : ∀ w : K, valL F K (-w) = valL F K w := by
    intro w
    unfold valL
    rw [hrelK_neg w]
  have halgK : ∀ z : K,
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F K = (minpoly F z).natDegree * m := by
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq K.val K.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  have hvalK_add : ∀ (m : ℤ) (x y : K),
      (x = 0 ∨ m ≤ valL F K x) → (y = 0 ∨ m ≤ valL F K y) →
        (x + y = 0 ∨ m ≤ valL F K (x + y)) := by
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
      Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
    have hspec_pow : ∀ z : K,
        (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F K) =
          ‖Algebra.norm F z‖ := by
      intro z
      obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halgK z
      have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
          ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
        rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
      have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
        rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
        exact_mod_cast minpoly.natDegree_pos hz
      rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
         ← Real.rpow_natCast]
      congr 1
      push_cast
      rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
    have hspec_le : ∀ w z : K, w ≠ 0 →
        spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
          spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
        z ≠ 0 ∧ valL F K z ≤ valL F K w := by
      intro w z hw hle
      have hpow_le :
          (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F K) ≤
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F K) :=
        pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
      rw [hspec_pow w, hspec_pow z] at hpow_le
      have hv_eq : ∀ a : F, ‖a‖ =
          ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
            (valuation F a) : ℝ) := fun a => rfl
      rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
      have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
        (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
          hpow_le
      have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
      obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
      have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
      refine ⟨hz, ?_⟩
      unfold valL
      by_cases hf0 : (resDeg F K : ℤ) = 0
      · rw [hf0, Int.ediv_zero, Int.ediv_zero]
      · have hf_pos : (0 : ℤ) < (resDeg F K : ℤ) := by positivity
        exact Int.ediv_le_ediv hf_pos hrel_le
    intro m x y hx hy
    by_cases hxy : x + y = 0
    · exact Or.inl hxy
    · right
      have hcoe : ((x + y : K) : AlgebraicClosure F) =
          (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
      have hna := isNonarchimedean_spectralNorm (K := F)
        (x : AlgebraicClosure F) (y : AlgebraicClosure F)
      rw [← hcoe, le_max_iff] at hna
      rcases hna with hle_x | hle_y
      · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
        have hmx : m ≤ valL F K x := hx.resolve_left hx_ne
        exact le_trans hmx hval_x
      · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
        have hmy : m ≤ valL F K y := hy.resolve_left hy_ne
        exact le_trans hmy hval_y
  let M_C_Fi : IntermediateField F_i (AlgebraicClosure F) := IntermediateField.extendScalars hFiMC
  let e_MC_Fi : M_C ≃ₐ[F] M_C_Fi :=
    { toExtendScalars F hFiMC with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hFiMC).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F M_C_Fi := Module.Finite.equiv e_MC_Fi.toLinearEquiv
  haveI : IsScalarTower F F_i M_C_Fi := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional F_i M_C_Fi := Module.Finite.of_restrictScalars_finite F F_i M_C_Fi
  haveI : Algebra.IsSeparable F_i M_C_Fi := hGalFiMC.2.2.2 hFiMC
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal F_i (AlgebraicClosure F) := Normal.tower_top_of_normal F F_i (AlgebraicClosure F)
  have hGalFiMC' : IsGalois F_i ↥M_C_Fi := by
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    have hMC_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[F_i] AlgebraicClosure F),
        (∀ x ∈ M_C_Fi, τ x = x) → ∀ x ∈ M_C_Fi, (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : F_i.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv F_i).symm σ
      let τ_F : F_i.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv F_i).symm τ
      have hτMC : τ_F.1 ∈ M_C.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hFiMC).mpr hx)
      have hconjMC : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
        hGalFiMC.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτMC
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjMC
      exact hconjMC x ((IntermediateField.mem_extendScalars hFiMC).mp hx)
    exact helper_isGalois F_i (AlgebraicClosure F) M_C_Fi hMC_norm_fix
  haveI : IsGalois F_i ↥M_C_Fi := hGalFiMC'
  haveI : Normal F_i ↥M_C_Fi := IsGalois.to_normal
  let G_Fi : Type u := (M_C_Fi ≃ₐ[F_i] M_C_Fi)
  let fromExtendScalars : M_C_Fi →+* M_C := e_MC_Fi.symm.toRingHom
  let act_Fi : G_Fi → M_C → M_C := fun σ z => fromExtendScalars (σ (toExtendScalars F hFiMC z))
  have hact_Fi_one : ∀ z : M_C, act_Fi 1 z = z := fun _ => rfl
  have hact_Fi_mul : ∀ (σ τ : G_Fi) (z : M_C), act_Fi (σ * τ) z = act_Fi σ (act_Fi τ z) :=
    fun _ _ _ => rfl
  have hact_Fi_ring : ∀ σ : G_Fi,
      act_Fi σ 0 = 0 ∧ act_Fi σ 1 = 1 ∧
      (∀ z₁ z₂ : M_C,
        act_Fi σ (z₁ + z₂) = act_Fi σ z₁ + act_Fi σ z₂ ∧
        act_Fi σ (z₁ * z₂) = act_Fi σ z₁ * act_Fi σ z₂ ∧
        act_Fi σ (-z₁) = -act_Fi σ z₁) := by
    intro σ
    refine ⟨by change fromExtendScalars (σ 0) = 0; rw [map_zero, map_zero],
      by change fromExtendScalars (σ 1) = 1; rw [map_one, map_one],
      fun z₁ z₂ => ⟨?_, ?_, ?_⟩⟩
    · change fromExtendScalars (σ (toExtendScalars F hFiMC z₁ + toExtendScalars F hFiMC z₂)) = _
      rw [map_add, map_add]
    · change fromExtendScalars (σ (toExtendScalars F hFiMC z₁ * toExtendScalars F hFiMC z₂)) = _
      rw [map_mul, map_mul]
    · change fromExtendScalars (σ (-toExtendScalars F hFiMC z₁)) = _
      rw [map_neg, map_neg]
  have hact_Fi_incl : ∀ (σ : G_Fi) (x : F_i),
      act_Fi σ (IntermediateField.inclusion hFiMC x) = IntermediateField.inclusion hFiMC x := by
    intro σ x
    change fromExtendScalars (σ (algebraMap F_i M_C_Fi x)) = IntermediateField.inclusion hFiMC x
    rw [σ.commutes x]
    rfl
  have hact_Fi_faithful : ∀ σ : G_Fi, (∀ z : M_C, act_Fi σ z = z) → σ = 1 := by
    intro σ h
    apply AlgEquiv.ext
    intro y
    exact congrArg (toExtendScalars F hFiMC) (h (fromExtendScalars y))
  have hact_Fi_val : ∀ (σ : G_Fi) (z : M_C), valL F M_C (act_Fi σ z) = valL F M_C z := by
    intro σ z
    let φ_σ : M_C ≃ₐ[F] M_C := e_MC_Fi.trans ((σ.restrictScalars F).trans e_MC_Fi.symm)
    have hφ : φ_σ z = act_Fi σ z := rfl
    unfold valL relVal
    rw [← hφ, Algebra.norm_eq_of_algEquiv φ_σ z]
  have hact_Fi_trace : ∀ z : M_C,
      IntermediateField.inclusion hFiMC (traceLM F hFiMC z) = ∑ σ : G_Fi, act_Fi σ z := by
    intro z
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := F_i) (L := M_C_Fi) (toExtendScalars F hFiMC z))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G_Fi => σ (toExtendScalars F hFiMC z)) Finset.univ)
  refine ⟨G_Fi, inferInstance, inferInstance, act_Fi,
    hact_Fi_one, hact_Fi_mul, hact_Fi_ring, hact_Fi_incl, hact_Fi_val, hact_Fi_trace, ?_⟩
  intro σ hσ_inert
  obtain ⟨τ_Fi, hτ_Fi⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) σ
  let σ_Fi : F_i.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv F_i).symm τ_Fi
  let σ_bar : AbsGal F := σ_Fi.1
  have hσ_bar_Fi : σ_bar ∈ F_i.fixingSubgroup := σ_Fi.2
  have hσ_bar_L : σ_bar ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLFi hσ_bar_Fi
  have hσ_bar_MC : ∀ z : M_C,
      ((act_Fi σ z : M_C) : AlgebraicClosure F) = σ_bar (z : AlgebraicClosure F) := by
    intro z
    change ((σ (toExtendScalars F hFiMC z) : M_C_Fi) : AlgebraicClosure F) =
      τ_Fi ((toExtendScalars F hFiMC z : M_C_Fi) : AlgebraicClosure F)
    rw [← hτ_Fi, AlgEquiv.restrictNormalHom_apply]
  obtain ⟨g_σ, _, hg_σ_act⟩ := hLift_to_G σ_bar hσ_bar_L
  have hg_σ_MC : ∀ z : M_C,
      act g_σ (IntermediateField.inclusion hM_CK z) =
        IntermediateField.inclusion hM_CK (act_Fi σ z) := by
    intro z
    have hσz : σ_bar ((IntermediateField.inclusion hM_CK z : K) : AlgebraicClosure F) ∈ K := by
      change σ_bar (z : AlgebraicClosure F) ∈ K
      rw [← hσ_bar_MC z]
      exact hM_CK (act_Fi σ z).2
    rw [hg_σ_act (IntermediateField.inclusion hM_CK z) hσz]
    apply Subtype.ext
    exact (hσ_bar_MC z).symm
  have hg_σ_G₀ : g_σ ∈ G₀ := by
    rw [hG₀_iff]
    intro w hw
    obtain ⟨z, hz, hd⟩ := hResLiftK w hw
    set d : K := w - IntermediateField.inclusion hM_CK z
    set δ_z : M_C := act_Fi σ z - z
    set d₁ : K := IntermediateField.inclusion hM_CK δ_z
    have hd₁ : d₁ = 0 ∨ 1 ≤ valL F K d₁ := by
      rcases hσ_inert z hz with h0 | hge1
      · left
        dsimp [d₁, δ_z]
        rw [h0, map_zero]
      · right
        dsimp [d₁, δ_z]
        rw [hValAlgK (act_Fi σ z - z)]
        have hq_int : (1 : ℤ) < (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) := by
          exact_mod_cast hq_gt1
        nlinarith
    have hd₂ : act g_σ d = 0 ∨ 1 ≤ valL F K (act g_σ d) := by
      rcases hd with h0 | hge1
      · left
        rw [h0, (hact_ring g_σ).1]
      · right
        rw [hact_val g_σ d]
        exact hge1
    have hd₃ : -d = 0 ∨ 1 ≤ valL F K (-d) := by
      rcases hd with h0 | hge1
      · left
        rw [h0, neg_zero]
      · right
        rw [hvalK_neg d]
        exact hge1
    have hw_eq : w = IntermediateField.inclusion hM_CK z + d := by
      dsimp [d]
      ring
    have hdiff_eq : act g_σ w - w = d₁ + (act g_σ d + (-d)) := by
      conv_lhs => rw [hw_eq]
      rw [((hact_ring g_σ).2.2 (IntermediateField.inclusion hM_CK z) d).1, hg_σ_MC z]
      dsimp [d₁, δ_z]
      rw [map_sub]
      ring
    rw [hdiff_eq]
    exact hvalK_add 1 d₁ (act g_σ d + (-d)) hd₁ (hvalK_add 1 (act g_σ d) (-d) hd₂ hd₃)
  have hact_one : ∀ w : K, act 1 w = w := by
    obtain ⟨g₁, hg₁_ker, hg₁_act⟩ := hLift_to_G 1 L.fixingSubgroup.one_mem
    have hg₁_eq : g₁ = 1 := hg₁_ker.mp K.fixingSubgroup.one_mem
    intro w
    rw [← hg₁_eq, hg₁_act w w.2]
    rfl
  have hact_inv_coe : ∀ (g : G) (γ : AbsGal F),
      (∀ w : K, ((act g w : K) : AlgebraicClosure F) = γ (w : AlgebraicClosure F)) →
      ∀ w : K, ((act g⁻¹ w : K) : AlgebraicClosure F) = γ⁻¹ (w : AlgebraicClosure F) := by
    intro g γ hγ w
    have h1 : γ ((act g⁻¹ w : K) : AlgebraicClosure F) = (w : AlgebraicClosure F) := by
      rw [← hγ (act g⁻¹ w), ← hact_mul g g⁻¹ w, mul_inv_cancel, hact_one w]
    calc ((act g⁻¹ w : K) : AlgebraicClosure F)
      _ = γ⁻¹ (γ ((act g⁻¹ w : K) : AlgebraicClosure F)) := (γ.symm_apply_apply _).symm
      _ = γ⁻¹ (w : AlgebraicClosure F) := by rw [h1]
  obtain ⟨γ_σ, hγ_σ_L, hγ_σ_act⟩ := hLift_from_G g_σ
  have hγ_σ_Fi : γ_σ ∈ F_i.fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    let z_x : M_C := IntermediateField.inclusion hFiMC ⟨x, hx⟩
    let w_x : K := IntermediateField.inclusion hM_CK z_x
    have hw_x_act : act g_σ w_x = w_x := by
      dsimp [w_x, z_x]
      rw [hg_σ_MC, hact_Fi_incl σ ⟨x, hx⟩]
    have hcoe := hγ_σ_act w_x
    rw [hw_x_act] at hcoe
    exact hcoe.symm
  have hg_σ_C : g_σ ∈ C := by
    by_contra hg_not_C
    have hKiMC : K_i ≤ M_C := by
      intro y hy
      let w_y : K := IntermediateField.inclusion hKiK ⟨y, hy⟩
      have hw_y_fixed : ∀ c ∈ C, act c w_y = w_y := by
        intro c hc
        obtain ⟨c₀, hc₀⟩ := hComm_surj g_σ hg_σ_G₀ hg_not_C ⟨c, hc⟩
        have hc₀_eq : g_σ * c₀.1 * g_σ⁻¹ * c₀.1⁻¹ = c := congrArg Subtype.val hc₀
        obtain ⟨γ_c, hγ_c_L, hγ_c_act⟩ := hLift_from_G c₀.1
        have hγ_c_Fi : γ_c ∈ F_i.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro x hx
          let z_x : M_C := IntermediateField.inclusion hFiMC ⟨x, hx⟩
          let w_x : K := IntermediateField.inclusion hM_CK z_x
          have hw_x_act : act c₀.1 w_x = w_x := (hC_mem_iff c₀.1).mp c₀.2 z_x
          have hcoe := hγ_c_act w_x
          rw [hw_x_act] at hcoe
          exact hcoe.symm
        have hcomm_Ki : γ_σ * γ_c * γ_σ⁻¹ * γ_c⁻¹ ∈ K_i.fixingSubgroup :=
          hAbFiKi.2.1 γ_σ hγ_σ_Fi γ_c hγ_c_Fi
        have hcomm_y : (γ_σ * γ_c * γ_σ⁻¹ * γ_c⁻¹) y = y := by
          rw [IntermediateField.mem_fixingSubgroup_iff] at hcomm_Ki
          exact hcomm_Ki y hy
        apply Subtype.ext
        rw [← hc₀_eq, hact_mul, hact_mul, hact_mul,
          hγ_σ_act, hγ_c_act, hact_inv_coe g_σ γ_σ hγ_σ_act, hact_inv_coe c₀.1 γ_c hγ_c_act]
        exact hcomm_y
      obtain ⟨z_y, hz_y⟩ := (hC_fixed_iff w_y).mp hw_y_fixed
      have hy_eq : (z_y : AlgebraicClosure F) = y := congrArg Subtype.val hz_y
      rw [← hy_eq]
      exact z_y.2
    have hnorm_trans_aux : ∀ (A B E : Type u) [Field A] [Field B] [Field E]
        (algAB : Algebra A B) (algBE : Algebra B E) (algAE : Algebra A E)
        (h : ∀ x : A, @algebraMap B E _ _ algBE (@algebraMap A B _ _ algAB x) =
          @algebraMap A E _ _ algAE x)
        (z : E),
        @Algebra.norm A E _ _ algAE z =
          @Algebra.norm A B _ _ algAB (@Algebra.norm B E _ _ algBE z) := by
      intro A B E _ _ _ algAB algBE algAE h z
      letI : Algebra A B := algAB
      letI : Algebra B E := algBE
      letI : Algebra A E := algAE
      haveI : IsScalarTower A B E := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h x).symm)
      exact (Algebra.norm_norm (a := z)).symm
    have hnorm_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
        (h : A ≤ B) (y : B),
        @Algebra.norm A B _ _ (IntermediateField.inclusion h).toAlgebra y = normLM F h y := by
      intro A B h y
      letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
      let e : B ≃ₐ[A] IntermediateField.extendScalars h :=
        { toFun := toExtendScalars F h
          invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl }
      exact (Algebra.norm_eq_of_algEquiv e y).symm
    have hnorm_trans : ∀ w : M_C,
        normLM F hFiMC w = normLM F hFiKi (normLM F hKiMC w) := by
      intro w
      rw [← hnorm_eq_inclusion hFiMC w,
          ← hnorm_eq_inclusion hKiMC w,
          ← hnorm_eq_inclusion hFiKi]
      exact hnorm_trans_aux F_i K_i M_C
        (IntermediateField.inclusion hFiKi).toAlgebra
        (IntermediateField.inclusion hKiMC).toAlgebra
        (IntermediateField.inclusion hFiMC).toAlgebra
        (fun _ => rfl)
        w
    apply hμ'_comp_ne1
    apply MonoidHom.ext
    intro u
    rw [MonoidHom.one_apply, MonoidHom.comp_apply]
    have hu_range : Units.map (normLM F hFiMC) u ∈ Set.range (Units.map (normLM F hFiKi)) := by
      refine ⟨Units.map (normLM F hKiMC) u, ?_⟩
      apply Units.ext
      exact (hnorm_trans (u : M_C)).symm
    exact (hμ'_ker (Units.map (normLM F hFiMC) u)).mp hu_range
  apply hact_Fi_faithful σ
  intro z
  have h1 := (hC_mem_iff g_σ).mp hg_σ_C z
  rw [hg_σ_MC z] at h1
  exact (IntermediateField.inclusion hM_CK).injective h1

theorem ld_ch14_tame_inertia_coset_lagrange_and_trace_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (A B : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F A] [FiniteDimensional F B]
    (hAB : A ≤ B)
    (hp_prime : Nat.Prime (p F))
    (G_AB : Type u) [Group G_AB] [Fintype G_AB] (act_AB : G_AB → B → B)
    (hact_one : ∀ z : B, act_AB 1 z = z)
    (hact_mul : ∀ (σ τ : G_AB) (z : B), act_AB (σ * τ) z = act_AB σ (act_AB τ z))
    (hact_ring : ∀ σ : G_AB,
      act_AB σ 0 = 0 ∧ act_AB σ 1 = 1 ∧
      (∀ z₁ z₂ : B,
        act_AB σ (z₁ + z₂) = act_AB σ z₁ + act_AB σ z₂ ∧
        act_AB σ (z₁ * z₂) = act_AB σ z₁ * act_AB σ z₂ ∧
        act_AB σ (-z₁) = -act_AB σ z₁))
    (hact_incl : ∀ (σ : G_AB) (x : A),
      act_AB σ (IntermediateField.inclusion hAB x) = IntermediateField.inclusion hAB x)
    (hact_val : ∀ (σ : G_AB) (z : B), valL F B (act_AB σ z) = valL F B z)
    (hact_trace : ∀ z : B,
      IntermediateField.inclusion hAB (traceLM F hAB z) = ∑ σ : G_AB, act_AB σ z)
    (I : Subgroup G_AB) [I.Normal]
    (hI_iff : ∀ σ : G_AB,
      σ ∈ I ↔ ∀ z : B, (z = 0 ∨ 0 ≤ valL F B z) →
        (act_AB σ z - z = 0 ∨ 1 ≤ valL F B (act_AB σ z - z)))
    (hm_I_ndvd : ¬ (p F ∣ Nat.card I)) :
    (∃ e_AB : ℕ,
      1 ≤ e_AB ∧
      e_AB ≤ Nat.card I ∧
      ∀ x : A, valL F B (IntermediateField.inclusion hAB x) = (e_AB : ℤ) * valL F A x) ∧
    (∃ y₁ : B, (y₁ = 0 ∨ 0 ≤ valL F B y₁) ∧ traceLM F hAB y₁ = 1) :=
by
  have h_valL_props : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L],
      0 < resDeg F L ∧
      (∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x) ∧
      valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) := by
    clear! A B G_AB hp_prime
    intro L _
    have halg : ∀ z : L,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F L = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq L.val L.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F L (-1) = 0 := by
      have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : L) * (-1 : L) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : L) = (-1 : L) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q : ℤ := valL F L x
        set r : ℤ := relVal F L x % f
        have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F L := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F L 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval1 : valL F L 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg1 : valL F L (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
      intro x
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L) := by
      intro u
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m := by
      intro m
      refine ⟨ϖL ^ m, ?_⟩
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv, hrel_zpow ϖL m, hrel_ϖL, mul_comm]
    have hval_add : ∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : L,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : L, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F L z ≤ valL F L w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F L) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfL_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : L) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F L x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F L y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    exact ⟨hfL_pos, hdiv, hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩

  obtain ⟨hresDeg_A_pos, hdiv_A, hvalA0, hvalA1, hvalA_neg1, hvalA_neg, hvalA_mul, hvalA_inv,
    hvalA_surj, hvalA_add⟩ := h_valL_props A
  obtain ⟨hresDeg_B_pos, hdiv_B, hvalB0, hvalB1, hvalB_neg1, hvalB_neg, hvalB_mul, hvalB_inv,
    hvalB_surj, hvalB_add⟩ := h_valL_props B

  have h_addVal_props :
      addVal F 1 = 0 ∧
      (∀ a : F, addVal F (-a) = addVal F a) ∧
      (∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b) ∧
      (∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a) ∧
      (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        (algebraMap F B a = 0 ∨ 0 ≤ valL F B (algebraMap F B a))) ∧
      (∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F B a = 0 ∨ 1 ≤ valL F B (algebraMap F B a))) ∧
      ∃ R_F : Finset F,
        (∀ r ∈ R_F, r = 0 ∨ 0 ≤ addVal F r) ∧
        (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
          ∃ r ∈ R_F, a - r = 0 ∨ 1 ≤ addVal F (a - r)) := by
    set φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have haddVal1 : addVal F 1 = 0 := by
      unfold addVal
      rw [dif_neg one_ne_zero]
      have hφ1 : φ (valuation F 1) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr one_ne_zero)
      have hunz1 : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz1, toAdd_one, neg_zero]
    have haddVal_neg : ∀ a : F, addVal F (-a) = addVal F a := by
      intro a
      by_cases ha : a = 0
      · simp [ha]
      · have hna : -a ≠ 0 := neg_ne_zero.mpr ha
        unfold addVal
        simp [ha, hna, Valuation.map_neg]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hφa : φ (valuation F a) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      have hφb : φ (valuation F b) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hb)
      have hφab : φ (valuation F (a * b)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hab)
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_inv : ∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a := by
      intro a ha
      have hainv : a⁻¹ ≠ 0 := inv_ne_zero ha
      have hmul := haddVal_mul a a⁻¹ ha hainv
      rw [mul_inv_cancel₀ ha, haddVal1] at hmul
      omega
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hφa : φ (valuation F a) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      have hφan : φ (valuation F (a ^ n)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr han)
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := fun h0 => hφπ_ne (by simp [h0])
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : B := algebraMap F B π
    have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F B x₀ = (Module.finrank F B : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F B) hπ_ne, hadd_π, mul_one]
    set S_deg : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : B, x ≠ 0 ∧ relVal F B x = k}
    have hmem_deg : Module.finrank F B ∈ S_deg :=
      ⟨Module.finrank_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfB_le : resDeg F B ≤ Module.finrank F B := Nat.sInf_le hmem_deg
    have hvalB_alg : ∀ a : F, a ≠ 0 →
        valL F B (algebraMap F B a) =
          ((Module.finrank F B : ℤ) * addVal F a) / (resDeg F B : ℤ) := by
      intro a ha
      unfold valL relVal
      rw [Algebra.norm_algebraMap, haddVal_pow a (Module.finrank F B) ha]
    have halg0 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        (algebraMap F B a = 0 ∨ 0 ≤ valL F B (algebraMap F B a)) := by
      intro a ha_opt
      by_cases ha : a = 0
      · left; simp [ha]
      · right
        have ha0 : 0 ≤ addVal F a := ha_opt.resolve_left ha
        rw [hvalB_alg a ha]
        exact Int.ediv_nonneg (mul_nonneg (Nat.cast_nonneg _) ha0) (Nat.cast_nonneg _)
    have halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F B a = 0 ∨ 1 ≤ valL F B (algebraMap F B a)) := by
      intro a ha_opt
      by_cases ha : a = 0
      · left; simp [ha]
      · right
        have ha1 : 1 ≤ addVal F a := ha_opt.resolve_left ha
        rw [hvalB_alg a ha]
        have hfB_posZ : (0 : ℤ) < (resDeg F B : ℤ) := Nat.cast_pos.mpr hresDeg_B_pos
        have hfB_leZ : (resDeg F B : ℤ) ≤ (Module.finrank F B : ℤ) := Nat.cast_le.mpr hfB_le
        exact Int.le_ediv_of_mul_le hfB_posZ (by nlinarith)
    have hmem_O : ∀ a : F, a ∈ 𝒪[F] ↔ (a = 0 ∨ 0 ≤ addVal F a) := by
      intro a
      by_cases ha : a = 0
      · simp [ha]
      · have hφa : φ (valuation F a) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
        have hle_iff : valuation F a ≤ 1 ↔ 0 ≤ addVal F a := by
          rw [← map_le_map_iff φ, map_one, ← WithZero.coe_unzero hφa, ← WithZero.coe_one,
            WithZero.coe_le_coe, ← Multiplicative.toAdd_le, toAdd_one]
          unfold addVal
          rw [dif_neg ha]
          omega
        rw [Valuation.mem_integer_iff, hle_iff]
        simp [ha]
    have hres_zero : ∀ x : 𝒪[F],
        IsLocalRing.residue 𝒪[F] x = 0 ↔ ((x : F) = 0 ∨ 1 ≤ addVal F (x : F)) := by
      intro x
      have hker : IsLocalRing.residue 𝒪[F] x = 0 ↔ valuation F (x : F) < 1 := by
        rw [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one]
      by_cases hx : (x : F) = 0
      · rw [hker]
        simp [hx, zero_lt_one]
      · have hφx : φ (valuation F (x : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hx)
        have hlt_iff : valuation F (x : F) < 1 ↔ 1 ≤ addVal F (x : F) := by
          rw [← map_lt_map_iff φ, map_one, ← WithZero.coe_unzero hφx, ← WithZero.coe_one,
            WithZero.coe_lt_coe, ← Multiplicative.toAdd_lt, toAdd_one]
          unfold addVal
          rw [dif_neg hx]
          omega
        rw [hker, hlt_iff]
        simp [hx]
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    let s : 𝓀[F] → 𝒪[F] := Function.surjInv (IsLocalRing.residue_surjective (R := 𝒪[F]))
    have hs_eq : ∀ c : 𝓀[F], IsLocalRing.residue 𝒪[F] (s c) = c :=
      Function.surjInv_eq (IsLocalRing.residue_surjective (R := 𝒪[F]))
    let R_F : Finset F := Finset.univ.image (fun c : 𝓀[F] => ((s c : 𝒪[F]) : F))
    have hRF_0 : ∀ r ∈ R_F, r = 0 ∨ 0 ≤ addVal F r := by
      intro r hr
      rcases Finset.mem_image.mp hr with ⟨c, _, rfl⟩
      exact (hmem_O ((s c : 𝒪[F]) : F)).mp (s c).2
    have hRF_mod1 : ∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        ∃ r ∈ R_F, a - r = 0 ∨ 1 ≤ addVal F (a - r) := by
      intro a ha_opt
      have ha_mem : a ∈ 𝒪[F] := (hmem_O a).mpr ha_opt
      let x : 𝒪[F] := ⟨a, ha_mem⟩
      let c : 𝓀[F] := IsLocalRing.residue 𝒪[F] x
      refine ⟨((s c : 𝒪[F]) : F), Finset.mem_image.mpr ⟨c, Finset.mem_univ c, rfl⟩, ?_⟩
      have hres_diff : IsLocalRing.residue 𝒪[F] (x - s c) = 0 := by
        rw [map_sub, hs_eq c, sub_self]
      have hdiff := (hres_zero (x - s c)).mp hres_diff
      simpa [x] using hdiff
    exact ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩

  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halgB0, halgB1,
    R_F, hRF_0, hRF_mod1⟩ := h_addVal_props

  have h_S₁_B : ∃ S₁ : Finset B,
      ∀ x : B, (x = 0 ∨ 0 ≤ valL F B x) →
        ∃ s ∈ S₁, x - s = 0 ∨ (1 : ℤ) ≤ valL F B (x - s) := by
    have hP_neg : ∀ (k : ℤ) (x : B),
        (x = 0 ∨ k ≤ valL F B x) → (-x = 0 ∨ k ≤ valL F B (-x)) := by
      rintro k x (rfl | hx)
      · exact Or.inl neg_zero
      · right
        rw [hvalB_neg]
        exact hx
    have hP_sub : ∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x - y = 0 ∨ k ≤ valL F B (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      exact hvalB_add k x (-y) hx (hP_neg k y hy)
    have hP_sum : ∀ (k : ℤ) {m : ℕ} (A_fin : Finset (Fin m)) (f : Fin m → B),
        (∀ i ∈ A_fin, f i = 0 ∨ k ≤ valL F B (f i)) →
          ((∑ i ∈ A_fin, f i) = 0 ∨ k ≤ valL F B (∑ i ∈ A_fin, f i)) := by
      intro k m A_fin f
      induction A_fin using Finset.induction_on with
      | empty =>
        intro _
        exact Or.inl Finset.sum_empty
      | @insert j s hj ih =>
        intro hf
        rw [Finset.sum_insert hj]
        exact hvalB_add k (f j) (∑ i ∈ s, f i)
          (hf j (Finset.mem_insert_self j s))
          (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
    have hP_smul1 : ∀ (a : F) (x : B),
        (a = 0 ∨ 1 ≤ addVal F a) → (x = 0 ∨ 0 ≤ valL F B x) →
          (a • x = 0 ∨ (1 : ℤ) ≤ valL F B (a • x)) := by
      intro a x ha hx
      rw [Algebra.smul_def]
      by_cases ha0 : algebraMap F B a = 0
      · left
        rw [ha0, zero_mul]
      · by_cases hx0 : x = 0
        · left
          rw [hx0, mul_zero]
        · right
          have ha_ge : (1 : ℤ) ≤ valL F B (algebraMap F B a) := (halgB1 a ha).resolve_left ha0
          have hx_ge : 0 ≤ valL F B x := hx.resolve_left hx0
          rw [hvalB_mul _ _ ha0 hx0]
          omega
    have hP_smul01 : ∀ (a : F) (x : B),
        (a = 0 ∨ 0 ≤ addVal F a) → (x = 0 ∨ (1 : ℤ) ≤ valL F B x) →
          (a • x = 0 ∨ (1 : ℤ) ≤ valL F B (a • x)) := by
      intro a x ha hx
      rw [Algebra.smul_def]
      by_cases ha0 : algebraMap F B a = 0
      · left
        rw [ha0, zero_mul]
      · by_cases hx0 : x = 0
        · left
          rw [hx0, mul_zero]
        · right
          have ha_ge : 0 ≤ valL F B (algebraMap F B a) := (halgB0 a ha).resolve_left ha0
          have hx_ge : (1 : ℤ) ≤ valL F B x := hx.resolve_left hx0
          rw [hvalB_mul _ _ ha0 hx0]
          omega
    by_contra h_no_S₁
    have h_avoid : ∀ S₁ : Finset B, ∃ x : B,
        (x = 0 ∨ 0 ≤ valL F B x) ∧
        ∀ s ∈ S₁, ¬ (x - s = 0 ∨ (1 : ℤ) ≤ valL F B (x - s)) := by
      intro S₁
      by_contra h_all
      apply h_no_S₁
      refine ⟨S₁, fun x hx => ?_⟩
      by_contra h_none
      exact h_all ⟨x, hx, fun s hs hxs => h_none ⟨s, hs, hxs⟩⟩
    have h_seq : ∀ m : ℕ, ∃ v : Fin m → B,
        (∀ i : Fin m, v i = 0 ∨ 0 ≤ valL F B (v i)) ∧
        (∀ c : Fin m → F,
          (∀ i : Fin m, c i = 0 ∨ 0 ≤ addVal F (c i)) →
          ((∑ i : Fin m, c i • v i) = 0 ∨ (1 : ℤ) ≤ valL F B (∑ i : Fin m, c i • v i)) →
          ∀ i : Fin m, c i = 0 ∨ 1 ≤ addVal F (c i)) := by
      intro m
      induction m with
      | zero =>
        exact ⟨Fin.elim0, fun i => Fin.elim0 i, fun _ _ _ i => Fin.elim0 i⟩
      | succ m ih =>
        rcases ih with ⟨v, hv0, hv_ind⟩
        let S_m : Finset B :=
          (Fintype.piFinset (fun _ : Fin m => R_F)).image
            (fun r : Fin m → F => ∑ i : Fin m, r i • v i)
        obtain ⟨v₀, hv₀_0, hv₀_not⟩ := h_avoid S_m
        refine ⟨Fin.cons v₀ v, ?_, ?_⟩
        · intro i
          refine Fin.cases ?_ ?_ i
          · rw [Fin.cons_zero]
            exact hv₀_0
          · intro j
            rw [Fin.cons_succ]
            exact hv0 j
        · intro c hc0 hsum
          have hsum' : (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) = 0 ∨
              (1 : ℤ) ≤ valL F B (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) := by
            simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ] at hsum
            exact hsum
          have hc0_1 : c 0 = 0 ∨ 1 ≤ addVal F (c 0) := by
            by_contra hc0_not1
            have hc0_ne : c 0 ≠ 0 := fun h0 => hc0_not1 (Or.inl h0)
            have hc0_lt1 : ¬ (1 ≤ addVal F (c 0)) := fun h1 => hc0_not1 (Or.inr h1)
            have hc0_ge0 : 0 ≤ addVal F (c 0) := (hc0 0).resolve_left hc0_ne
            have hc0_val : addVal F (c 0) = 0 := by omega
            have hc0_inv_ne : (c 0)⁻¹ ≠ 0 := inv_ne_zero hc0_ne
            have hc0_inv_val : addVal F (c 0)⁻¹ = 0 := by
              rw [haddVal_inv (c 0) hc0_ne, hc0_val, neg_zero]
            have hc0_inv_0 : (c 0)⁻¹ = 0 ∨ 0 ≤ addVal F (c 0)⁻¹ := Or.inr (by omega)
            let a : Fin m → F := fun i => - ((c 0)⁻¹ * c i.succ)
            have ha0 : ∀ i : Fin m, a i = 0 ∨ 0 ≤ addVal F (a i) := by
              intro i
              by_cases hci : c i.succ = 0
              · left
                dsimp [a]
                rw [hci, mul_zero, neg_zero]
              · right
                dsimp [a]
                rw [haddVal_neg, haddVal_mul _ _ hc0_inv_ne hci, hc0_inv_val, zero_add]
                exact (hc0 i.succ).resolve_left hci
            let r : Fin m → F := fun i => (hRF_mod1 (a i) (ha0 i)).choose
            have hr_mem : ∀ i : Fin m, r i ∈ R_F :=
              fun i => (hRF_mod1 (a i) (ha0 i)).choose_spec.1
            have hr_mod : ∀ i : Fin m, a i - r i = 0 ∨ 1 ≤ addVal F (a i - r i) :=
              fun i => (hRF_mod1 (a i) (ha0 i)).choose_spec.2
            let s : B := ∑ i : Fin m, r i • v i
            have hs_mem : s ∈ S_m :=
              Finset.mem_image.mpr ⟨r, Fintype.mem_piFinset.mpr hr_mem, rfl⟩
            have hid : v₀ - s =
                (c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) +
                  ∑ i : Fin m, (a i - r i) • v i := by
              have h1 : (c 0)⁻¹ • (c 0 • v₀) = v₀ := by
                rw [smul_smul, inv_mul_cancel₀ hc0_ne, one_smul]
              have h2 : ∀ i : Fin m,
                  (c 0)⁻¹ • (c i.succ • v i) + (a i - r i) • v i =
                    -(r i • v i) := by
                intro i
                dsimp [a]
                rw [smul_smul, sub_smul, neg_smul]
                abel
              dsimp [s]
              rw [smul_add, h1, Finset.smul_sum, add_assoc, ← Finset.sum_add_distrib,
                Finset.sum_congr rfl fun i _ => h2 i, Finset.sum_neg_distrib, sub_eq_add_neg]
            have hterm1 : (c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) = 0 ∨
                (1 : ℤ) ≤ valL F B ((c 0)⁻¹ • (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i)) :=
              hP_smul01 (c 0)⁻¹ _ hc0_inv_0 hsum'
            have hterm2 : (∑ i : Fin m, (a i - r i) • v i) = 0 ∨
                (1 : ℤ) ≤ valL F B (∑ i : Fin m, (a i - r i) • v i) :=
              hP_sum 1 Finset.univ (fun i => (a i - r i) • v i)
                (fun i _ => hP_smul1 (a i - r i) (v i) (hr_mod i) (hv0 i))
            have hv₀_s : v₀ - s = 0 ∨ (1 : ℤ) ≤ valL F B (v₀ - s) := by
              rw [hid]
              exact hvalB_add 1 _ _ hterm1 hterm2
            exact hv₀_not s hs_mem hv₀_s
          have hc0_v0 : c 0 • v₀ = 0 ∨ (1 : ℤ) ≤ valL F B (c 0 • v₀) :=
            hP_smul1 (c 0) v₀ hc0_1 hv₀_0
          have hsum_tail : (∑ i : Fin m, c i.succ • v i) = 0 ∨
              (1 : ℤ) ≤ valL F B (∑ i : Fin m, c i.succ • v i) := by
            have hsub := hP_sub 1 (c 0 • v₀ + ∑ i : Fin m, c i.succ • v i) (c 0 • v₀) hsum' hc0_v0
            rwa [add_sub_cancel_left] at hsub
          have hc_succ : ∀ i : Fin m, c i.succ = 0 ∨ 1 ≤ addVal F (c i.succ) :=
            hv_ind (fun i => c i.succ) (fun i => hc0 i.succ) hsum_tail
          intro i
          exact Fin.cases hc0_1 hc_succ i
    let m : ℕ := Module.finrank F B + 1
    obtain ⟨v, _, hv_ind⟩ := h_seq m
    have hli : LinearIndependent F v := by
      rw [Fintype.linearIndependent_iff]
      intro g hg i₀
      by_contra hgi₀
      let A_fin : Finset (Fin m) := Finset.univ.filter (fun i => g i ≠ 0)
      have hi₀ : i₀ ∈ A_fin := Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hgi₀⟩
      obtain ⟨i_star, hi_star_mem, hi_star_min⟩ :=
        Finset.exists_min_image A_fin (fun i => addVal F (g i)) ⟨i₀, hi₀⟩
      have hgi_star : g i_star ≠ 0 := (Finset.mem_filter.mp hi_star_mem).2
      let c : Fin m → F := fun i => (g i_star)⁻¹ * g i
      have hc0 : ∀ i : Fin m, c i = 0 ∨ 0 ≤ addVal F (c i) := by
        intro i
        by_cases hgi : g i = 0
        · left
          dsimp [c]
          rw [hgi, mul_zero]
        · right
          have hi_mem : i ∈ A_fin := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hgi⟩
          have hle : addVal F (g i_star) ≤ addVal F (g i) := hi_star_min i hi_mem
          dsimp [c]
          rw [haddVal_mul _ _ (inv_ne_zero hgi_star) hgi, haddVal_inv _ hgi_star]
          omega
      have hsum_c : (∑ i : Fin m, c i • v i) = 0 := by
        calc (∑ i : Fin m, c i • v i)
          _ = ∑ i : Fin m, (g i_star)⁻¹ • (g i • v i) :=
              Finset.sum_congr rfl (fun i _ => by dsimp [c]; rw [smul_smul])
          _ = (g i_star)⁻¹ • ∑ i : Fin m, g i • v i := (Finset.smul_sum).symm
          _ = 0 := by rw [hg, smul_zero]
      have hc_star : c i_star = 0 ∨ 1 ≤ addVal F (c i_star) :=
        hv_ind c hc0 (Or.inl hsum_c) i_star
      have hc_star_eq : c i_star = 1 := inv_mul_cancel₀ hgi_star
      rw [hc_star_eq, haddVal1] at hc_star
      rcases hc_star with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    have hcard := LinearIndependent.fintype_card_le_finrank hli
    rw [Fintype.card_fin] at hcard
    omega

  obtain ⟨S₁_B, hS₁_B⟩ := h_S₁_B

  have h_res_B :
      ∃ (k_B : Type u) (_ : Field k_B) (_ : Fintype k_B) (resB : B → k_B),
        resB 0 = 0 ∧ resB 1 = 1 ∧
        (∀ x₁ x₂ : B, (x₁ = 0 ∨ 0 ≤ valL F B x₁) → (x₂ = 0 ∨ 0 ≤ valL F B x₂) →
          resB (x₁ + x₂) = resB x₁ + resB x₂ ∧
          resB (x₁ * x₂) = resB x₁ * resB x₂ ∧
          resB (-x₁) = -resB x₁) ∧
        (∀ x : B, (x = 0 ∨ 0 ≤ valL F B x) → (resB x = 0 ↔ (x = 0 ∨ 1 ≤ valL F B x))) ∧
        (∀ a : k_B, ∃ x : B, (x = 0 ∨ 0 ≤ valL F B x) ∧ resB x = a) := by
    have hMain : ∀ (E : Type u) [Field E] (v : E → ℤ),
        v 1 = 0 →
        (∀ x : E, v (-x) = v x) →
        (∀ x y : E, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
        (∀ u : Eˣ, v ((u⁻¹ : Eˣ) : E) = - v (u : E)) →
        (∀ (k : ℤ) (x y : E), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) →
          (x + y = 0 ∨ k ≤ v (x + y))) →
        ∀ (S : Finset E),
        (∀ x : E, (x = 0 ∨ 0 ≤ v x) → ∃ s ∈ S, x - s = 0 ∨ (1 : ℤ) ≤ v (x - s)) →
        ∃ (k_E : Type u) (_ : Field k_E) (_ : Fintype k_E) (resE : E → k_E),
          resE 0 = 0 ∧ resE 1 = 1 ∧
          (∀ x₁ x₂ : E, (x₁ = 0 ∨ 0 ≤ v x₁) → (x₂ = 0 ∨ 0 ≤ v x₂) →
            resE (x₁ + x₂) = resE x₁ + resE x₂ ∧
            resE (x₁ * x₂) = resE x₁ * resE x₂ ∧
            resE (-x₁) = -resE x₁) ∧
          (∀ x : E, (x = 0 ∨ 0 ≤ v x) → (resE x = 0 ↔ (x = 0 ∨ 1 ≤ v x))) ∧
          (∀ a : k_E, ∃ x : E, (x = 0 ∨ 0 ≤ v x) ∧ resE x = a) := by
      clear * -
      intro E _ v hv1 hv_neg hv_mul hv_inv hv_add S hS
      let 𝒪_E : Subring E :=
        { carrier := {x : E | x = 0 ∨ 0 ≤ v x}
          zero_mem' := Or.inl rfl
          one_mem' := Or.inr (by rw [hv1])
          add_mem' := fun {x y} hx hy => hv_add 0 x y hx hy
          neg_mem' := fun {x} hx =>
            hx.elim (fun h0 => Or.inl (by rw [h0, neg_zero]))
              (fun hge => Or.inr (by rw [hv_neg]; exact hge))
          mul_mem' := fun {x y} hx hy => by
            by_cases hx0 : x = 0
            · exact Or.inl (by rw [hx0, zero_mul])
            · by_cases hy0 : y = 0
              · exact Or.inl (by rw [hy0, mul_zero])
              · exact Or.inr (by
                  rw [hv_mul x y hx0 hy0]
                  have h1 := hx.resolve_left hx0
                  have h2 := hy.resolve_left hy0
                  omega) }
      let 𝔭_E : Ideal 𝒪_E :=
        { carrier := {x : 𝒪_E | (x : E) = 0 ∨ (1 : ℤ) ≤ v (x : E)}
          zero_mem' := Or.inl rfl
          add_mem' := fun {x y} hx hy => hv_add 1 x.1 y.1 hx hy
          smul_mem' := fun c {x} hx => by
            by_cases hc0 : (c : E) = 0
            · exact Or.inl (by change (c : E) * (x : E) = 0; rw [hc0, zero_mul])
            · by_cases hx0 : (x : E) = 0
              · exact Or.inl (by change (c : E) * (x : E) = 0; rw [hx0, mul_zero])
              · exact Or.inr (by
                  change (1 : ℤ) ≤ v ((c : E) * (x : E))
                  rw [hv_mul c.1 x.1 hc0 hx0]
                  have h1 := c.2.resolve_left hc0
                  have h2 := hx.resolve_left hx0
                  omega) }
      have hIsField : IsField (𝒪_E ⧸ 𝔭_E) := by
        refine ⟨⟨0, 1, ?_⟩, fun a b => mul_comm a b, ?_⟩
        · intro h01
          have h1 : (1 : 𝒪_E) ∈ 𝔭_E := Ideal.Quotient.eq_zero_iff_mem.mp h01.symm
          rcases h1 with h10 | h1ge
          · exact one_ne_zero h10
          · change (1 : ℤ) ≤ v 1 at h1ge
            rw [hv1] at h1ge
            omega
        · intro a ha
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
          have hxI : x ∉ 𝔭_E := fun h => ha (Ideal.Quotient.eq_zero_iff_mem.mpr h)
          have hx0 : (x : E) ≠ 0 := fun h => hxI (Or.inl h)
          have hxlt : ¬ ((1 : ℤ) ≤ v (x : E)) := fun h => hxI (Or.inr h)
          have hxge : 0 ≤ v (x : E) := x.2.resolve_left hx0
          have hvx : v (x : E) = 0 := by omega
          let u : Eˣ := Units.mk0 (x : E) hx0
          have hvu : v ((u⁻¹ : Eˣ) : E) = 0 := by
            rw [hv_inv u]
            change - v (x : E) = 0
            omega
          let y : 𝒪_E := ⟨((u⁻¹ : Eˣ) : E), Or.inr (by omega)⟩
          refine ⟨Ideal.Quotient.mk 𝔭_E y, ?_⟩
          rw [← map_mul]
          have hxy : x * y = 1 := Subtype.ext (Units.mul_inv u)
          rw [hxy, map_one]
      haveI hMax : 𝔭_E.IsMaximal := Ideal.Quotient.maximal_of_isField 𝔭_E hIsField
      let k_E : Type u := 𝒪_E ⧸ 𝔭_E
      letI hField_kE : Field k_E := Ideal.Quotient.field 𝔭_E
      let resE : E → k_E := fun x =>
        if hx : x = 0 ∨ 0 ≤ v x then Ideal.Quotient.mk 𝔭_E ⟨x, hx⟩ else 0
      have hresE_eq : ∀ (x : E) (hx : x = 0 ∨ 0 ≤ v x),
          resE x = Ideal.Quotient.mk 𝔭_E ⟨x, hx⟩ :=
        fun x hx => dif_pos hx
      have hresE_0 : resE 0 = 0 := by
        rw [hresE_eq 0 (Or.inl rfl)]
        exact map_zero (Ideal.Quotient.mk 𝔭_E)
      have hresE_1 : resE 1 = 1 := by
        rw [hresE_eq 1 (Or.inr (by rw [hv1]))]
        exact map_one (Ideal.Quotient.mk 𝔭_E)
      have hresE_ring : ∀ x₁ x₂ : E,
          (x₁ = 0 ∨ 0 ≤ v x₁) → (x₂ = 0 ∨ 0 ≤ v x₂) →
            resE (x₁ + x₂) = resE x₁ + resE x₂ ∧
            resE (x₁ * x₂) = resE x₁ * resE x₂ ∧
            resE (-x₁) = -resE x₁ := by
        intro x₁ x₂ hx₁ hx₂
        have hadd : x₁ + x₂ = 0 ∨ 0 ≤ v (x₁ + x₂) := 𝒪_E.add_mem hx₁ hx₂
        have hmul : x₁ * x₂ = 0 ∨ 0 ≤ v (x₁ * x₂) := 𝒪_E.mul_mem hx₁ hx₂
        have hneg : -x₁ = 0 ∨ 0 ≤ v (-x₁) := 𝒪_E.neg_mem hx₁
        refine ⟨?_, ?_, ?_⟩
        · rw [hresE_eq (x₁ + x₂) hadd, hresE_eq x₁ hx₁, hresE_eq x₂ hx₂]
          exact map_add (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
        · rw [hresE_eq (x₁ * x₂) hmul, hresE_eq x₁ hx₁, hresE_eq x₂ hx₂]
          exact map_mul (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
        · rw [hresE_eq (-x₁) hneg, hresE_eq x₁ hx₁]
          exact map_neg (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩
      have hresE_ker : ∀ x : E,
          (x = 0 ∨ 0 ≤ v x) → (resE x = 0 ↔ (x = 0 ∨ 1 ≤ v x)) := by
        intro x hx
        rw [hresE_eq x hx, Ideal.Quotient.eq_zero_iff_mem]
        rfl
      have hresE_surj : ∀ a : k_E, ∃ x : E, (x = 0 ∨ 0 ≤ v x) ∧ resE x = a := by
        intro a
        obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.Quotient.mk_surjective a
        exact ⟨x, hx, hresE_eq x hx⟩
      let f : k_E → S := fun a =>
        let x_a := (hresE_surj a).choose
        let hx_a := (hresE_surj a).choose_spec.1
        let hs := hS x_a hx_a
        ⟨hs.choose, hs.choose_spec.1⟩
      have hf_left : ∀ a : k_E, resE (f a : E) = a := by
        intro a
        set x_a := (hresE_surj a).choose
        have hx_a : x_a = 0 ∨ 0 ≤ v x_a := (hresE_surj a).choose_spec.1
        have hres_a : resE x_a = a := (hresE_surj a).choose_spec.2
        have hd₁ : x_a - (f a : E) = 0 ∨ (1 : ℤ) ≤ v (x_a - (f a : E)) :=
          (hS x_a hx_a).choose_spec.2
        have hd₀ : x_a - (f a : E) = 0 ∨ 0 ≤ v (x_a - (f a : E)) :=
          hd₁.elim Or.inl (fun h => Or.inr (by omega))
        have hs₀ : (f a : E) = 0 ∨ 0 ≤ v (f a : E) := by
          have h_eq : (f a : E) = x_a + -(x_a - (f a : E)) := by ring
          rw [h_eq]
          exact 𝒪_E.add_mem hx_a (𝒪_E.neg_mem hd₀)
        have hres_d : resE (x_a - (f a : E)) = 0 :=
          (hresE_ker (x_a - (f a : E)) hd₀).mpr hd₁
        have h_sum : x_a = (x_a - (f a : E)) + (f a : E) := by ring
        have h_add' := (hresE_ring (x_a - (f a : E)) (f a : E) hd₀ hs₀).1
        rw [← h_sum, hres_a, hres_d, zero_add] at h_add'
        exact h_add'.symm
      have hf_inj : Function.Injective f := by
        intro a₁ a₂ h
        have hval : (f a₁ : E) = (f a₂ : E) := congrArg Subtype.val h
        rw [← hf_left a₁, ← hf_left a₂, hval]
      haveI hFin_kE' : Finite k_E := Finite.of_injective f hf_inj
      letI hFin_kE : Fintype k_E := Fintype.ofFinite k_E
      exact ⟨k_E, hField_kE, hFin_kE, resE, hresE_0, hresE_1, hresE_ring, hresE_ker, hresE_surj⟩
    exact hMain ↥B (valL F B) hvalB1 hvalB_neg hvalB_mul hvalB_inv hvalB_add S₁_B hS₁_B

  obtain ⟨k_B, hField_kB, hFin_kB, resB, hresB_0, hresB_1,
    hresB_ring, hresB_ker, hresB_surj⟩ := h_res_B
  letI : Field k_B := hField_kB
  letI : Fintype k_B := hFin_kB

  
  let P_A : ℤ → A → Prop := fun k x => x = 0 ∨ k ≤ valL F A x
  let P_B : ℤ → B → Prop := fun k z => z = 0 ∨ k ≤ valL F B z
  have hPB_zero : ∀ k : ℤ, P_B k 0 := fun _ => Or.inl rfl
  have hPB_one : P_B 0 1 := Or.inr (by omega)
  have hPB_neg : ∀ (k : ℤ) {z : B}, P_B k z → P_B k (-z) := by
    intro k z hz
    rcases hz with rfl | hz
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hvalB_neg]; exact hz)
  have hPB_add : ∀ (k : ℤ) {z₁ z₂ : B}, P_B k z₁ → P_B k z₂ → P_B k (z₁ + z₂) :=
    fun k {z₁ z₂} h1 h2 => hvalB_add k z₁ z₂ h1 h2
  have hPB_sub : ∀ (k : ℤ) {z₁ z₂ : B}, P_B k z₁ → P_B k z₂ → P_B k (z₁ - z₂) := by
    intro k z₁ z₂ h1 h2
    rw [sub_eq_add_neg]
    exact hPB_add k h1 (hPB_neg k h2)
  have hPB_mul : ∀ {k₁ k₂ : ℤ} {z₁ z₂ : B}, P_B k₁ z₁ → P_B k₂ z₂ → P_B (k₁ + k₂) (z₁ * z₂) := by
    intro k₁ k₂ z₁ z₂ h1 h2
    by_cases hz₁ : z₁ = 0
    · exact Or.inl (by rw [hz₁, zero_mul])
    · by_cases hz₂ : z₂ = 0
      · exact Or.inl (by rw [hz₂, mul_zero])
      · right
        rw [hvalB_mul z₁ z₂ hz₁ hz₂]
        have h1' := h1.resolve_left hz₁
        have h2' := h2.resolve_left hz₂
        omega
  have hPB_mul0 : ∀ {k : ℤ} {z₁ z₂ : B}, P_B k z₁ → P_B 0 z₂ → P_B k (z₁ * z₂) := by
    intro k z₁ z₂ h1 h2
    simpa using hPB_mul h1 h2
  have hPB_mono : ∀ {k₁ k₂ : ℤ} {z : B}, k₁ ≤ k₂ → P_B k₂ z → P_B k₁ z := by
    intro k₁ k₂ z hle hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hz)
  have hPB_pow : ∀ (m : ℕ) {z : B}, P_B 0 z → P_B 0 (z ^ m) := by
    intro m z hz
    induction m with
    | zero => rw [pow_zero]; exact hPB_one
    | succ m ih =>
      rw [pow_succ]
      simpa using hPB_mul ih hz
  have hPB_natCast : ∀ m : ℕ, P_B 0 (m : B) := by
    intro m
    induction m with
    | zero => rw [Nat.cast_zero]; exact hPB_zero 0
    | succ m ih => rw [Nat.cast_succ]; exact hPB_add 0 ih hPB_one
  have hPB_intCast : ∀ z : ℤ, P_B 0 (z : B) := by
    intro z
    cases z with
    | ofNat m =>
      rw [Int.ofNat_eq_coe, Int.cast_natCast]
      exact hPB_natCast m
    | negSucc m =>
      rw [Int.cast_negSucc]
      exact hPB_neg 0 (hPB_natCast (m + 1))
  have hPB_act : ∀ (k : ℤ) (σ : G_AB) {z : B}, P_B k z → P_B k (act_AB σ z) := by
    intro k σ z hz
    rcases hz with rfl | hge
    · exact Or.inl (hact_ring σ).1
    · exact Or.inr (by rw [hact_val σ z]; exact hge)
  have hPB_sum_nat : ∀ (T : Finset ℕ) (f : ℕ → B) (k : ℤ),
      (∀ a ∈ T, P_B k (f a)) → P_B k (∑ a ∈ T, f a) := by
    intro T f k hT
    induction' T using Finset.induction_on with a T' ha ih
    · exact Or.inl Finset.sum_empty
    · rw [Finset.sum_insert ha]
      exact hPB_add k (hT a (Finset.mem_insert_self a T'))
        (ih (fun b hb => hT b (Finset.mem_insert_of_mem hb)))
  have hPB_sum_G : ∀ (T : Finset G_AB) (f : G_AB → B) (k : ℤ),
      (∀ a ∈ T, P_B k (f a)) → P_B k (∑ a ∈ T, f a) := by
    intro T f k hT
    induction' T using Finset.induction_on with a T' ha ih
    · exact Or.inl Finset.sum_empty
    · rw [Finset.sum_insert ha]
      exact hPB_add k (hT a (Finset.mem_insert_self a T'))
        (ih (fun b hb => hT b (Finset.mem_insert_of_mem hb)))
  have hPB_sum_I : ∀ (T : Finset I) (f : I → B) (k : ℤ),
      (∀ a ∈ T, P_B k (f a)) → P_B k (∑ a ∈ T, f a) := by
    intro T f k hT
    induction' T using Finset.induction_on with a T' ha ih
    · exact Or.inl Finset.sum_empty
    · rw [Finset.sum_insert ha]
      exact hPB_add k (hT a (Finset.mem_insert_self a T'))
        (ih (fun b hb => hT b (Finset.mem_insert_of_mem hb)))

  
  have hfA_int_pos : (0 : ℤ) < (resDeg F A : ℤ) := Nat.cast_pos.mpr hresDeg_A_pos
  have hfA_int_ne : (resDeg F A : ℤ) ≠ 0 := ne_of_gt hfA_int_pos
  let B' : IntermediateField A (AlgebraicClosure F) := IntermediateField.extendScalars hAB
  let e_B : B ≃ₐ[F] B' :=
    { toExtendScalars F hAB with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hAB).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F B' := Module.Finite.equiv e_B.toLinearEquiv
  haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional A B' := Module.Finite.of_restrictScalars_finite F A B'
  let f_H : ℕ := Module.finrank A B'
  have hf_H_pos : 0 < f_H := Module.finrank_pos
  have hrelVal_norm : ∀ z : B, relVal F A (normLM F hAB z) = relVal F B z := by
    intro z
    change addVal F (Algebra.norm F (Algebra.norm A (toExtendScalars F hAB z))) =
      addVal F (Algebra.norm F z)
    have h1 : Algebra.norm F (Algebra.norm A (toExtendScalars F hAB z)) =
        Algebra.norm F (toExtendScalars F hAB z) := Algebra.norm_norm
    have h2 : Algebra.norm F z = Algebra.norm F (toExtendScalars F hAB z) :=
      Algebra.norm_eq_of_algEquiv e_B z
    rw [h1, ← h2]
  have hnorm_inc : ∀ x : A,
      normLM F hAB (IntermediateField.inclusion hAB x) = x ^ f_H := by
    intro x
    change Algebra.norm A (algebraMap A B' x) = x ^ f_H
    exact Algebra.norm_algebraMap x
  have hvalA_pow : ∀ (x : A) (k : ℕ), x ≠ 0 → valL F A (x ^ k) = (k : ℤ) * valL F A x := by
    intro x k hx
    induction k with
    | zero => rw [pow_zero, hvalA1, Nat.cast_zero, zero_mul]
    | succ k ih =>
      rw [pow_succ', hvalA_mul x (x ^ k) hx (pow_ne_zero k hx), ih]
      push_cast
      ring
  obtain ⟨ϖ_A, hϖ_A⟩ := hvalA_surj 1
  obtain ⟨ϖ_B, hϖ_B⟩ := hvalB_surj 1
  set e : ℤ := valL F B (IntermediateField.inclusion hAB (ϖ_A : A))
  set f : ℤ := valL F A (normLM F hAB (ϖ_B : B))
  have h_resDeg_rel : (resDeg F B : ℤ) = (resDeg F A : ℤ) * f := by
    have h1 := hrelVal_norm (ϖ_B : B)
    rw [hdiv_A, hdiv_B, hϖ_B, mul_one] at h1
    exact h1.symm
  have h_val_norm_f : ∀ z : B, valL F A (normLM F hAB z) = f * valL F B z := by
    intro z
    have h1 := hrelVal_norm z
    rw [hdiv_A, hdiv_B, h_resDeg_rel, mul_assoc] at h1
    exact mul_left_cancel₀ hfA_int_ne h1
  have h_fe : (f_H : ℤ) = f * e := by
    have h1 := h_val_norm_f (IntermediateField.inclusion hAB (ϖ_A : A))
    rw [hnorm_inc (ϖ_A : A), hvalA_pow (ϖ_A : A) f_H (Units.ne_zero ϖ_A), hϖ_A, mul_one] at h1
    exact h1
  have hf_pos : 0 < f := by
    by_contra hle
    have h0 : (resDeg F B : ℤ) ≤ 0 := by nlinarith [h_resDeg_rel, hfA_int_pos]
    omega
  have he_pos : 1 ≤ e := by
    have hfH_ge1 : (1 : ℤ) ≤ (f_H : ℤ) := by exact_mod_cast hf_H_pos
    by_contra hle
    have he0 : e ≤ 0 := by omega
    have h0 : (f_H : ℤ) ≤ 0 := by nlinarith [h_fe, hf_pos, he0]
    omega
  have h_val_alg_e : ∀ x : A,
      valL F B (IntermediateField.inclusion hAB x) = e * valL F A x := by
    intro x
    have h1 := h_val_norm_f (IntermediateField.inclusion hAB x)
    by_cases hx : x = 0
    · subst hx
      rw [map_zero, hvalB0, hvalA0, mul_zero]
    · rw [hnorm_inc x, hvalA_pow x f_H hx, h_fe, mul_assoc] at h1
      exact (mul_left_cancel₀ (ne_of_gt hf_pos) h1).symm
  let e_AB : ℕ := e.toNat
  have he_AB_cast : (e_AB : ℤ) = e := Int.toNat_of_nonneg (by omega)
  have he_AB_ge1 : 1 ≤ e_AB := by omega
  have hValAlg_AB : ∀ x : A,
      valL F B (IntermediateField.inclusion hAB x) = (e_AB : ℤ) * valL F A x := by
    intro x
    rw [he_AB_cast]
    exact h_val_alg_e x

  
  let m_I : ℕ := Nat.card I
  letI : Fintype I := inferInstance
  have hm_I_card : m_I = Fintype.card I := Nat.card_eq_fintype_card
  haveI : Nonempty I := ⟨⟨1, I.one_mem⟩⟩
  have hm_I_ge1 : 1 ≤ m_I := by
    rw [hm_I_card]
    exact Fintype.card_pos
  let φ_iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hp_res : IsLocalRing.residue 𝒪[F] (p F : 𝒪[F]) = 0 := by
    rw [map_natCast]
    exact CharP.cast_eq_zero 𝓀[F] (p F)
  have hp_val_lt : valuation F (p F : F) < 1 := by
    have hker : IsLocalRing.residue 𝒪[F] (p F : 𝒪[F]) = 0 ↔
        valuation F ((p F : 𝒪[F]) : F) < 1 := by
      rw [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one]
    simpa using hker.mp hp_res
  have hp_addVal : (p F : F) = 0 ∨ 1 ≤ addVal F (p F : F) := by
    by_cases hp0 : (p F : F) = 0
    · exact Or.inl hp0
    · right
      have hφp : φ_iso (valuation F (p F : F)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
      have hlt_iff : valuation F (p F : F) < 1 ↔ 1 ≤ addVal F (p F : F) := by
        rw [← map_lt_map_iff φ_iso, map_one, ← WithZero.coe_unzero hφp, ← WithZero.coe_one,
          WithZero.coe_lt_coe, ← Multiplicative.toAdd_lt, toAdd_one]
        unfold addVal
        rw [dif_neg hp0]
        omega
      exact hlt_iff.mp hp_val_lt
  have hp_valB : P_B 1 (p F : B) := by
    have h1 := halgB1 (p F : F) hp_addVal
    rwa [map_natCast] at h1
  have hcop_mI : Nat.Coprime m_I (p F) :=
    ((Nat.Prime.coprime_iff_not_dvd hp_prime).mpr hm_I_ndvd).symm
  have hbez_Z : (1 : ℤ) = (m_I : ℤ) * m_I.gcdA (p F) + (p F : ℤ) * m_I.gcdB (p F) := by
    have h1 := Nat.gcd_eq_gcd_ab m_I (p F)
    rw [hcop_mI.gcd_eq_one, Nat.cast_one] at h1
    exact h1
  have hbez_B : (1 : B) = (m_I : B) * (m_I.gcdA (p F) : B) + (p F : B) * (m_I.gcdB (p F) : B) := by
    have h1 := congrArg (Int.cast : ℤ → B) hbez_Z
    push_cast at h1
    exact h1
  have hm_I_not_P1 : ¬ P_B 1 (m_I : B) := by
    intro hP1_mI
    have ht1 : P_B 1 ((m_I : B) * (m_I.gcdA (p F) : B)) :=
      hPB_mul0 hP1_mI (hPB_intCast (m_I.gcdA (p F)))
    have ht2 : P_B 1 ((p F : B) * (m_I.gcdB (p F) : B)) :=
      hPB_mul0 hp_valB (hPB_intCast (m_I.gcdB (p F)))
    have hsum : P_B 1 ((m_I : B) * (m_I.gcdA (p F) : B) + (p F : B) * (m_I.gcdB (p F) : B)) :=
      hPB_add 1 ht1 ht2
    rw [← hbez_B] at hsum
    rcases hsum with h10 | h1_le
    · exact one_ne_zero h10
    · rw [hvalB1] at h1_le
      omega
  change ¬ ((m_I : B) = 0 ∨ (1 : ℤ) ≤ valL F B (m_I : B)) at hm_I_not_P1
  push_neg at hm_I_not_P1
  obtain ⟨hm_I_ne0, hm_I_lt1⟩ := hm_I_not_P1
  have hm_I_ge0 : (0 : ℤ) ≤ valL F B (m_I : B) := (hPB_natCast m_I).resolve_left hm_I_ne0
  have hm_I_val0 : valL F B (m_I : B) = 0 := by omega
  let u_mI : Bˣ := Units.mk0 (m_I : B) hm_I_ne0
  have hm_I_inv_val0 : valL F B (m_I : B)⁻¹ = 0 := by
    have h1 : ((u_mI⁻¹ : Bˣ) : B) = (m_I : B)⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [← h1, hvalB_inv u_mI, Units.val_mk0, hm_I_val0, neg_zero]
  have hm_I_inv_P0 : P_B 0 (m_I : B)⁻¹ := Or.inr (by omega)

  
  let φ : G_AB → (B →+* B) := fun σ =>
    { toFun := act_AB σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun x y => ((hact_ring σ).2.2 x y).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun x y => ((hact_ring σ).2.2 x y).1 }
  have hresB_pow : ∀ {z : B}, P_B 0 z → ∀ m : ℕ, resB (z ^ m) = (resB z) ^ m := by
    intro z hz m
    induction m with
    | zero => rw [pow_zero, pow_zero, hresB_1]
    | succ m ih =>
      rw [pow_succ, pow_succ, (hresB_ring (z ^ m) z (hPB_pow m hz) hz).2.1, ih]
  have hPB_pow_diff : ∀ (m : ℕ) {a b : B},
      P_B 0 a → P_B 0 b → P_B 1 (a - b) → P_B 1 (a ^ m - b ^ m) := by
    intro m a b ha hb hab
    induction m with
    | zero =>
      rw [pow_zero, pow_zero, sub_self]
      exact hPB_zero 1
    | succ m ih =>
      have hid : a ^ (m + 1) - b ^ (m + 1) = (a ^ m - b ^ m) * a + b ^ m * (a - b) := by ring
      rw [hid]
      have ht1 : P_B 1 ((a ^ m - b ^ m) * a) := hPB_mul0 ih ha
      have ht2 : P_B 1 (b ^ m * (a - b)) := by
        rw [mul_comm]
        exact hPB_mul0 hab (hPB_pow m hb)
      exact hPB_add 1 ht1 ht2
  haveI : Finite k_B := Finite.of_fintype k_B
  haveI : Finite k_Bˣ := Finite.of_injective (Units.val : k_Bˣ → k_B) (fun _ _ h => Units.ext h)
  obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := k_Bˣ)
  obtain ⟨z0_tilde, hz0_tilde_P0, hz0_tilde_res⟩ := hresB_surj (g₀ : k_B)
  have hz0_tilde_not_P1 : ¬ P_B 1 z0_tilde := by
    intro hP1
    have h0 : resB z0_tilde = 0 := (hresB_ker z0_tilde hz0_tilde_P0).mpr hP1
    rw [hz0_tilde_res] at h0
    exact Units.ne_zero g₀ h0
  change ¬ (z0_tilde = 0 ∨ (1 : ℤ) ≤ valL F B z0_tilde) at hz0_tilde_not_P1
  push_neg at hz0_tilde_not_P1
  obtain ⟨hz0_tilde_ne0, hz0_tilde_lt1⟩ := hz0_tilde_not_P1
  have hz0_tilde_ge0 : (0 : ℤ) ≤ valL F B z0_tilde := hz0_tilde_P0.resolve_left hz0_tilde_ne0
  have hz0_tilde_val0 : valL F B z0_tilde = 0 := by omega
  have h_mem_I_of_z0_tilde : ∀ σ : G_AB, P_B 1 (act_AB σ z0_tilde - z0_tilde) → σ ∈ I := by
    intro σ hσ_z0_tilde
    rw [hI_iff σ]
    intro z hz
    by_cases h0 : resB z = 0
    · have hz_P1 : P_B 1 z := (hresB_ker z hz).mp h0
      exact hPB_sub 1 (hPB_act 1 σ hz_P1) hz_P1
    · let u_z : k_Bˣ := Units.mk0 (resB z) h0
      obtain ⟨m, hm⟩ := hg₀ u_z
      have hres_zm : resB (z0_tilde ^ m) = resB z := by
        rw [hresB_pow hz0_tilde_P0 m, hz0_tilde_res]
        exact congrArg Units.val hm
      have hzm_P0 : P_B 0 (z0_tilde ^ m) := hPB_pow m hz0_tilde_P0
      have hdiff_P0 : P_B 0 (z - z0_tilde ^ m) := hPB_sub 0 hz hzm_P0
      have hres_diff : resB (z - z0_tilde ^ m) = 0 := by
        rw [sub_eq_add_neg, (hresB_ring z (-z0_tilde ^ m) hz (hPB_neg 0 hzm_P0)).1,
          (hresB_ring (z0_tilde ^ m) 0 hzm_P0 (hPB_zero 0)).2.2, hres_zm, add_neg_cancel]
      have hd : P_B 1 (z - z0_tilde ^ m) := (hresB_ker (z - z0_tilde ^ m) hdiff_P0).mp hres_diff
      have hσd : P_B 1 (act_AB σ z - (act_AB σ z0_tilde) ^ m) := by
        have h1 : P_B 1 (act_AB σ (z - z0_tilde ^ m)) := hPB_act 1 σ hd
        have h2 : act_AB σ (z - z0_tilde ^ m) = act_AB σ z - (act_AB σ z0_tilde) ^ m := by
          change φ σ (z - z0_tilde ^ m) = φ σ z - (φ σ z0_tilde) ^ m
          rw [map_sub, map_pow]
        rwa [h2] at h1
      have hpow_d : P_B 1 ((act_AB σ z0_tilde) ^ m - z0_tilde ^ m) :=
        hPB_pow_diff m (hPB_act 0 σ hz0_tilde_P0) hz0_tilde_P0 hσ_z0_tilde
      have hid : act_AB σ z - z =
          (act_AB σ z - (act_AB σ z0_tilde) ^ m) + ((act_AB σ z0_tilde) ^ m - z0_tilde ^ m) - (z - z0_tilde ^ m) := by
        ring
      rw [hid]
      exact hPB_sub 1 (hPB_add 1 hσd hpow_d) hd

  let z₀ : B := ∑ γ : I, act_AB γ.1 z0_tilde
  have hz₀_I_inv : ∀ σ ∈ I, act_AB σ z₀ = z₀ := by
    intro σ hσ
    have h1 : act_AB σ z₀ = ∑ γ : I, act_AB ((⟨σ, hσ⟩ : I) * γ).1 z0_tilde := by
      change φ σ (∑ γ : I, act_AB γ.1 z0_tilde) = _
      rw [map_sum (φ σ)]
      refine Finset.sum_congr rfl fun γ _ => ?_
      change act_AB σ (act_AB γ.1 z0_tilde) = act_AB (σ * γ.1) z0_tilde
      exact (hact_mul σ γ.1 z0_tilde).symm
    rw [h1]
    exact Equiv.sum_comp (Equiv.mulLeft (⟨σ, hσ⟩ : I)) (fun γ : I => act_AB γ.1 z0_tilde)
  have hz₀_mod : P_B 1 (z₀ - (m_I : B) * z0_tilde) := by
    have h_const_sum : (∑ _γ : I, z0_tilde) = (m_I : B) * z0_tilde := by
      rw [Finset.sum_const, Finset.card_univ, ← hm_I_card, nsmul_eq_mul]
    have h_diff_eq : z₀ - (m_I : B) * z0_tilde = ∑ γ : I, (act_AB γ.1 z0_tilde - z0_tilde) := by
      dsimp [z₀]
      rw [← h_const_sum, ← Finset.sum_sub_distrib]
    rw [h_diff_eq]
    exact hPB_sum_I Finset.univ (fun γ : I => act_AB γ.1 z0_tilde - z0_tilde) 1
      (fun γ _ => (hI_iff γ.1).mp γ.2 z0_tilde hz0_tilde_P0)
  have hz₀_P0 : P_B 0 z₀ :=
    hPB_sum_I Finset.univ (fun γ : I => act_AB γ.1 z0_tilde) 0 (fun γ _ => hPB_act 0 γ.1 hz0_tilde_P0)
  have hz₀_not_P1 : ¬ P_B 1 z₀ := by
    intro hz₀_P1
    have hprod_P1 : P_B 1 ((m_I : B) * z0_tilde) := by
      have h1 : P_B 1 (z₀ - (z₀ - (m_I : B) * z0_tilde)) := hPB_sub 1 hz₀_P1 hz₀_mod
      rwa [sub_sub_cancel] at h1
    have hprod_ne0 : (m_I : B) * z0_tilde ≠ 0 := mul_ne_zero hm_I_ne0 hz0_tilde_ne0
    have hprod_val0 : valL F B ((m_I : B) * z0_tilde) = 0 := by
      rw [hvalB_mul (m_I : B) z0_tilde hm_I_ne0 hz0_tilde_ne0, hm_I_val0, hz0_tilde_val0, add_zero]
    have hge1 : (1 : ℤ) ≤ valL F B ((m_I : B) * z0_tilde) := hprod_P1.resolve_left hprod_ne0
    omega
  change ¬ (z₀ = 0 ∨ (1 : ℤ) ≤ valL F B z₀) at hz₀_not_P1
  push_neg at hz₀_not_P1
  obtain ⟨hz₀_ne0, hz₀_lt1⟩ := hz₀_not_P1
  have hz₀_ge0 : (0 : ℤ) ≤ valL F B z₀ := hz₀_P0.resolve_left hz₀_ne0
  have hz₀_val0 : valL F B z₀ = 0 := by omega
  have hz₀_pow_P0 : ∀ j : ℕ, P_B 0 (z₀ ^ j) := fun j => hPB_pow j hz₀_P0
  have hz₀_move : ∀ σ : G_AB, σ ∉ I → act_AB σ z₀ - z₀ ≠ 0 ∧ valL F B (act_AB σ z₀ - z₀) = 0 := by
    intro σ hσ_not_I
    have hσ_mod : P_B 1 (act_AB σ z₀ - (m_I : B) * act_AB σ z0_tilde) := by
      have h1 : P_B 1 (act_AB σ (z₀ - (m_I : B) * z0_tilde)) := hPB_act 1 σ hz₀_mod
      have h2 : act_AB σ (z₀ - (m_I : B) * z0_tilde) = act_AB σ z₀ - (m_I : B) * act_AB σ z0_tilde := by
        change φ σ (z₀ - (m_I : B) * z0_tilde) = φ σ z₀ - (m_I : B) * φ σ z0_tilde
        rw [map_sub, map_mul, map_natCast]
      rwa [h2] at h1
    have h_diff_mod : P_B 1 ((act_AB σ z₀ - z₀) - (m_I : B) * (act_AB σ z0_tilde - z0_tilde)) := by
      have hid : (act_AB σ z₀ - z₀) - (m_I : B) * (act_AB σ z0_tilde - z0_tilde) =
          (act_AB σ z₀ - (m_I : B) * act_AB σ z0_tilde) - (z₀ - (m_I : B) * z0_tilde) := by ring
      rw [hid]
      exact hPB_sub 1 hσ_mod hz₀_mod
    have h_not_P1 : ¬ P_B 1 (act_AB σ z₀ - z₀) := by
      intro hP1
      have hm_diff_P1 : P_B 1 ((m_I : B) * (act_AB σ z0_tilde - z0_tilde)) := by
        have h1 : P_B 1 ((act_AB σ z₀ - z₀) - ((act_AB σ z₀ - z₀) - (m_I : B) * (act_AB σ z0_tilde - z0_tilde))) :=
          hPB_sub 1 hP1 h_diff_mod
        rwa [sub_sub_cancel] at h1
      have h_z0_tilde_P1 : P_B 1 (act_AB σ z0_tilde - z0_tilde) := by
        have h1 : P_B 1 (((m_I : B) * (act_AB σ z0_tilde - z0_tilde)) * (m_I : B)⁻¹) :=
          hPB_mul0 hm_diff_P1 hm_I_inv_P0
        have h2 : ((m_I : B) * (act_AB σ z0_tilde - z0_tilde)) * (m_I : B)⁻¹ = act_AB σ z0_tilde - z0_tilde := by
          rw [mul_comm, inv_mul_cancel_left₀ hm_I_ne0]
        rwa [h2] at h1
      exact hσ_not_I (h_mem_I_of_z0_tilde σ h_z0_tilde_P1)
    have h_P0 : P_B 0 (act_AB σ z₀ - z₀) := hPB_sub 0 (hPB_act 0 σ hz₀_P0) hz₀_P0
    change ¬ (act_AB σ z₀ - z₀ = 0 ∨ (1 : ℤ) ≤ valL F B (act_AB σ z₀ - z₀)) at h_not_P1
    push_neg at h_not_P1
    obtain ⟨hne0, hlt1⟩ := h_not_P1
    have hge0 : (0 : ℤ) ≤ valL F B (act_AB σ z₀ - z₀) := h_P0.resolve_left hne0
    exact ⟨hne0, by omega⟩

  
  let Q_I := G_AB ⧸ I
  letI : Fintype Q_I := Quotient.fintype (QuotientGroup.leftRel I)
  let z_Q : Q_I → B := fun q =>
    Quotient.liftOn' q (fun σ => act_AB σ z₀) (fun a b hab => by
      have hmem : a⁻¹ * b ∈ I := QuotientGroup.leftRel_apply.mp hab
      have hfix : act_AB (a⁻¹ * b) z₀ = z₀ := hz₀_I_inv (a⁻¹ * b) hmem
      have hmul : act_AB a (act_AB (a⁻¹ * b) z₀) = act_AB b z₀ := by
        rw [← hact_mul, mul_inv_cancel_left]
      change act_AB a z₀ = act_AB b z₀
      rw [← hmul, hfix])
  have hz_Q_mk : ∀ σ : G_AB, z_Q (σ : Q_I) = act_AB σ z₀ := fun _ => rfl
  have hz_Q_one : z_Q 1 = z₀ := hact_one z₀
  have hz_Q_act : ∀ (σ : G_AB) (q : Q_I), act_AB σ (z_Q q) = z_Q ((σ : Q_I) * q) := by
    intro σ q
    refine Quotient.inductionOn' q (fun τ => ?_)
    change act_AB σ (act_AB τ z₀) = z_Q ((σ : Q_I) * (τ : Q_I))
    rw [← hact_mul σ τ z₀]
    rfl
  have hz_Q_val : ∀ q : Q_I, valL F B (z_Q q) = 0 := by
    intro q
    refine Quotient.inductionOn' q (fun τ => ?_)
    change valL F B (act_AB τ z₀) = 0
    rw [hact_val τ z₀, hz₀_val0]
  have hz_Q_move : ∀ q : Q_I, q ≠ 1 → z₀ - z_Q q ≠ 0 ∧ valL F B (z₀ - z_Q q) = 0 := by
    intro q
    refine Quotient.inductionOn' q (fun τ hτ => ?_)
    have hτ_not_I : τ ∉ I := fun hmem => hτ ((QuotientGroup.eq_one_iff τ).mpr hmem)
    obtain ⟨hne, hval⟩ := hz₀_move τ hτ_not_I
    change z₀ - act_AB τ z₀ ≠ 0 ∧ valL F B (z₀ - act_AB τ z₀) = 0
    have hneg_eq : z₀ - act_AB τ z₀ = -(act_AB τ z₀ - z₀) := by ring
    refine ⟨?_, ?_⟩
    · rw [hneg_eq, neg_ne_zero]
      exact hne
    · rw [hneg_eq, hvalB_neg]
      exact hval

  let S_Q : Finset Q_I := (Finset.univ : Finset Q_I).erase 1
  let Q_poly : Polynomial B := ∏ q ∈ S_Q, (Polynomial.X - Polynomial.C (z_Q q))
  let Δ : B := ∏ q ∈ S_Q, (z₀ - z_Q q)
  have h_factor_val : ∀ q ∈ S_Q, z₀ - z_Q q ≠ 0 ∧ valL F B (z₀ - z_Q q) = 0 :=
    fun q hq => hz_Q_move q (Finset.mem_erase.mp hq).1
  have hΔ_props : Δ ≠ 0 ∧ valL F B Δ = 0 := by
    suffices h : ∀ T : Finset Q_I,
        (∀ q ∈ T, z₀ - z_Q q ≠ 0 ∧ valL F B (z₀ - z_Q q) = 0) →
        (∏ q ∈ T, (z₀ - z_Q q)) ≠ 0 ∧ valL F B (∏ q ∈ T, (z₀ - z_Q q)) = 0 by
      exact h S_Q h_factor_val
    intro T
    induction' T using Finset.induction_on with q T' hq ih
    · intro _
      rw [Finset.prod_empty]
      exact ⟨one_ne_zero, hvalB1⟩
    · intro hT
      rw [Finset.prod_insert hq]
      obtain ⟨h1_ne, h1_val⟩ := hT q (Finset.mem_insert_self q T')
      obtain ⟨h2_ne, h2_val⟩ := ih (fun r hr => hT r (Finset.mem_insert_of_mem hr))
      refine ⟨mul_ne_zero h1_ne h2_ne, ?_⟩
      rw [hvalB_mul _ _ h1_ne h2_ne, h1_val, h2_val, add_zero]
  have hΔ_ne0 : Δ ≠ 0 := hΔ_props.1
  have hΔ_val0 : valL F B Δ = 0 := hΔ_props.2
  let u_Δ : Bˣ := Units.mk0 Δ hΔ_ne0
  have hΔ_inv_val0 : valL F B Δ⁻¹ = 0 := by
    have h1 : ((u_Δ⁻¹ : Bˣ) : B) = Δ⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [← h1, hvalB_inv u_Δ, Units.val_mk0, hΔ_val0, neg_zero]
  have hΔ_inv_P0 : P_B 0 Δ⁻¹ := Or.inr (by omega)
  have hΔ_I_inv : ∀ σ ∈ I, act_AB σ Δ = Δ := by
    intro σ hσ
    have hσ1 : (σ : Q_I) = 1 := (QuotientGroup.eq_one_iff σ).mpr hσ
    change φ σ (∏ q ∈ S_Q, (z₀ - z_Q q)) = ∏ q ∈ S_Q, (z₀ - z_Q q)
    rw [map_prod (φ σ)]
    refine Finset.prod_congr rfl fun q _ => ?_
    change act_AB σ (z₀ - z_Q q) = z₀ - z_Q q
    rw [sub_eq_add_neg, ((hact_ring σ).2.2 z₀ (-z_Q q)).1,
      ((hact_ring σ).2.2 (z_Q q) 0).2.2, hz₀_I_inv σ hσ, hz_Q_act σ q, hσ1, one_mul,
      ← sub_eq_add_neg]
  have hΔ_inv_I_inv : ∀ σ ∈ I, act_AB σ Δ⁻¹ = Δ⁻¹ := by
    intro σ hσ
    apply mul_right_cancel₀ hΔ_ne0
    calc act_AB σ Δ⁻¹ * Δ
      _ = act_AB σ Δ⁻¹ * act_AB σ Δ := by rw [hΔ_I_inv σ hσ]
      _ = act_AB σ (Δ⁻¹ * Δ) := (((hact_ring σ).2.2 Δ⁻¹ Δ).2.1).symm
      _ = act_AB σ 1 := by rw [inv_mul_cancel₀ hΔ_ne0]
      _ = 1 := (hact_ring σ).2.1
      _ = Δ⁻¹ * Δ := (inv_mul_cancel₀ hΔ_ne0).symm

  let IsIntPoly : Polynomial B → Prop := fun P => ∀ j : ℕ, P_B 0 (P.coeff j)
  have hInt_one : IsIntPoly 1 := by
    intro j
    rw [Polynomial.coeff_one]
    split_ifs
    · exact hPB_one
    · exact hPB_zero 0
  have hInt_linear : ∀ a : B, P_B 0 a → IsIntPoly (Polynomial.X - Polynomial.C a) := by
    intro a ha j
    rw [Polynomial.coeff_sub, Polynomial.coeff_X, Polynomial.coeff_C]
    have hX : P_B 0 (if 1 = j then (1 : B) else 0) := by
      split_ifs
      · exact hPB_one
      · exact hPB_zero 0
    have hC : P_B 0 (if j = 0 then a else 0) := by
      split_ifs
      · exact ha
      · exact hPB_zero 0
    exact hPB_sub 0 hX hC
  have hInt_mul : ∀ {P₁ P₂ : Polynomial B}, IsIntPoly P₁ → IsIntPoly P₂ → IsIntPoly (P₁ * P₂) := by
    intro P₁ P₂ hP₁ hP₂ j
    rw [Polynomial.coeff_mul]
    suffices h : ∀ T : Finset (ℕ × ℕ), P_B 0 (∑ p ∈ T, P₁.coeff p.1 * P₂.coeff p.2) by
      exact h (Finset.antidiagonal j)
    intro T
    induction' T using Finset.induction_on with p T' hp ih
    · exact Or.inl Finset.sum_empty
    · rw [Finset.sum_insert hp]
      exact hPB_add 0 (hPB_mul0 (hP₁ p.1) (hP₂ p.2)) ih
  have hQ_int : IsIntPoly Q_poly := by
    suffices h : ∀ T : Finset Q_I, IsIntPoly (∏ q ∈ T, (Polynomial.X - Polynomial.C (z_Q q))) by
      exact h S_Q
    intro T
    induction' T using Finset.induction_on with q T' hq ih
    · rw [Finset.prod_empty]
      exact hInt_one
    · rw [Finset.prod_insert hq]
      have h_q_P0 : P_B 0 (z_Q q) := Or.inr (by rw [hz_Q_val q])
      exact hInt_mul (hInt_linear (z_Q q) h_q_P0) ih

  let n : ℕ := Q_poly.natDegree + 1
  have h_orth : ∀ σ : G_AB,
      (∑ j ∈ Finset.range n, act_AB σ (Q_poly.coeff j) * z₀ ^ j) = if σ ∈ I then Δ else 0 := by
    intro σ
    have h_sum : (∑ j ∈ Finset.range n, act_AB σ (Q_poly.coeff j) * z₀ ^ j) =
        Polynomial.eval z₀ (Polynomial.map (φ σ) Q_poly) := by
      rw [Polynomial.eval_map, Polynomial.eval₂_eq_sum_range]
      rfl
    have h_prod : Polynomial.eval z₀ (Polynomial.map (φ σ) Q_poly) =
        ∏ q ∈ S_Q, (z₀ - z_Q ((σ : Q_I) * q)) := by
      dsimp [Q_poly]
      rw [Polynomial.map_prod, Polynomial.eval_prod]
      refine Finset.prod_congr rfl fun q _ => ?_
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
        Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
      change z₀ - act_AB σ (z_Q q) = z₀ - z_Q ((σ : Q_I) * q)
      rw [hz_Q_act σ q]
    rw [h_sum, h_prod]
    split_ifs with hσ
    · have hσ1 : (σ : Q_I) = 1 := (QuotientGroup.eq_one_iff σ).mpr hσ
      dsimp [Δ]
      refine Finset.prod_congr rfl fun q _ => ?_
      rw [hσ1, one_mul]
    · have hσ1 : (σ : Q_I) ≠ 1 := fun h => hσ ((QuotientGroup.eq_one_iff σ).mp h)
      apply Finset.prod_eq_zero (i := (σ : Q_I)⁻¹)
      · exact Finset.mem_erase.mpr ⟨inv_ne_one.mpr hσ1, Finset.mem_univ _⟩
      · rw [mul_inv_cancel, hz_Q_one, sub_self]

  have h_coset_lagrange : ∀ w : B, (∀ σ ∈ I, act_AB σ w = w) →
      (m_I : B) * w = ∑ j ∈ Finset.range n,
        IntermediateField.inclusion hAB (traceLM F hAB (w * Q_poly.coeff j * Δ⁻¹)) * z₀ ^ j := by
    intro w hw_I
    have h_step : ∀ σ : G_AB,
        (∑ j ∈ Finset.range n, act_AB σ (w * Q_poly.coeff j * Δ⁻¹) * z₀ ^ j) =
          if σ ∈ I then w else 0 := by
      intro σ
      have h_lhs : (∑ j ∈ Finset.range n, act_AB σ (w * Q_poly.coeff j * Δ⁻¹) * z₀ ^ j) =
          act_AB σ (w * Δ⁻¹) * (∑ j ∈ Finset.range n, act_AB σ (Q_poly.coeff j) * z₀ ^ j) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        have h_mul1 := ((hact_ring σ).2.2 (w * Δ⁻¹) (Q_poly.coeff j)).2.1
        have h_eq : w * Q_poly.coeff j * Δ⁻¹ = w * Δ⁻¹ * Q_poly.coeff j := by ring
        rw [h_eq, h_mul1, mul_assoc]
      rw [h_lhs, h_orth σ]
      split_ifs with hσ
      · rw [((hact_ring σ).2.2 w Δ⁻¹).2.1, hw_I σ hσ, hΔ_inv_I_inv σ hσ,
          inv_mul_cancel_right₀ hΔ_ne0 w]
      · rw [mul_zero]
    have h_sum_G :
        (∑ σ : G_AB, ∑ j ∈ Finset.range n, act_AB σ (w * Q_poly.coeff j * Δ⁻¹) * z₀ ^ j) =
          (m_I : B) * w := by
      calc (∑ σ : G_AB, ∑ j ∈ Finset.range n, act_AB σ (w * Q_poly.coeff j * Δ⁻¹) * z₀ ^ j)
        _ = ∑ σ : G_AB, (if σ ∈ I then w else 0) :=
          Finset.sum_congr rfl fun σ _ => h_step σ
        _ = ∑ σ ∈ Finset.univ.filter (fun σ : G_AB => σ ∈ I), w :=
          (Finset.sum_filter (fun σ : G_AB => σ ∈ I) (fun _ => w)).symm
        _ = (Finset.univ.filter (fun σ : G_AB => σ ∈ I)).card • w := Finset.sum_const w
        _ = (Fintype.card I) • w := by rw [← Fintype.card_subtype (fun σ : G_AB => σ ∈ I)]
        _ = m_I • w := by rw [hm_I_card]
        _ = (m_I : B) * w := nsmul_eq_mul m_I w
    rw [Finset.sum_comm] at h_sum_G
    conv_lhs => rw [← h_sum_G]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← Finset.sum_mul, hact_trace (w * Q_poly.coeff j * Δ⁻¹)]

  
  have hinj : Function.Injective (IntermediateField.inclusion hAB) :=
    (IntermediateField.inclusion hAB).injective
  have h_trace_PB : ∀ (m : ℤ) (z : B), P_B m z →
      P_B m (IntermediateField.inclusion hAB (traceLM F hAB z)) := by
    intro m z hz
    rw [hact_trace z]
    exact hPB_sum_G Finset.univ (fun σ => act_AB σ z) m (fun σ _ => hPB_act m σ hz)
  have h_trace_PA0 : ∀ z : B, P_B 0 z → P_A 0 (traceLM F hAB z) := by
    intro z hz
    have h1 := h_trace_PB 0 z hz
    by_cases h0 : traceLM F hAB z = 0
    · exact Or.inl h0
    · right
      have hinc_ne0 : IntermediateField.inclusion hAB (traceLM F hAB z) ≠ 0 :=
        fun h => h0 ((map_eq_zero_iff _ hinj).mp h)
      have hge0 : 0 ≤ valL F B (IntermediateField.inclusion hAB (traceLM F hAB z)) :=
        h1.resolve_left hinc_ne0
      rw [hValAlg_AB (traceLM F hAB z)] at hge0
      by_contra hlt
      have hle : valL F A (traceLM F hAB z) ≤ -1 := by omega
      have hprod : (e_AB : ℤ) * valL F A (traceLM F hAB z) < 0 := by nlinarith [he_AB_ge1, hle]
      omega

  
  have hy₁_ex : ∃ y₁ : B, (y₁ = 0 ∨ 0 ≤ valL F B y₁) ∧ traceLM F hAB y₁ = 1 := by
    let t : ℕ → A := fun j => traceLM F hAB (1 * Q_poly.coeff j * Δ⁻¹)
    have ht_P0 : ∀ j : ℕ, P_A 0 (t j) := by
      intro j
      refine h_trace_PA0 (1 * Q_poly.coeff j * Δ⁻¹) ?_
      rw [one_mul]
      exact hPB_mul0 (hQ_int j) hΔ_inv_P0
    have hex_j0 : ∃ j₀ ∈ Finset.range n, ¬ P_A 1 (t j₀) := by
      by_contra hall
      push_neg at hall
      have hm_P1 : P_B 1 ((m_I : B) * 1) := by
        rw [h_coset_lagrange 1 (fun σ _ => (hact_ring σ).2.1)]
        refine hPB_sum_nat (Finset.range n) _ 1 (fun j hj => ?_)
        have htj : P_A 1 (t j) := hall j hj
        have h_inc_P1 : P_B 1 (IntermediateField.inclusion hAB (t j)) := by
          rcases htj with h0 | hge
          · exact Or.inl (by rw [h0, map_zero])
          · right
            rw [hValAlg_AB (t j)]
            nlinarith [he_AB_ge1, hge]
        exact hPB_mul0 h_inc_P1 (hz₀_pow_P0 j)
      rw [mul_one] at hm_P1
      rcases hm_P1 with hm0 | hge1
      · exact hm_I_ne0 hm0
      · omega
    obtain ⟨j₀, _, hnot_P1⟩ := hex_j0
    have htj0_P0 : P_A 0 (t j₀) := ht_P0 j₀
    change ¬ (t j₀ = 0 ∨ (1 : ℤ) ≤ valL F A (t j₀)) at hnot_P1
    push_neg at hnot_P1
    obtain ⟨htj0_ne0, htj0_lt1⟩ := hnot_P1
    have htj0_ge0 : (0 : ℤ) ≤ valL F A (t j₀) := htj0_P0.resolve_left htj0_ne0
    have htj0_val0 : valL F A (t j₀) = 0 := by omega
    let u_t : Aˣ := Units.mk0 (t j₀) htj0_ne0
    have hut_inv_val0 : valL F A (t j₀)⁻¹ = 0 := by
      have h1 : ((u_t⁻¹ : Aˣ) : A) = (t j₀)⁻¹ := by
        rw [Units.val_inv_eq_inv_val, Units.val_mk0]
      rw [← h1, hvalA_inv u_t, Units.val_mk0, htj0_val0, neg_zero]
    let y₁ : B := IntermediateField.inclusion hAB (t j₀)⁻¹ * (1 * Q_poly.coeff j₀ * Δ⁻¹)
    have hy₁_P0 : P_B 0 y₁ := by
      have h1 : P_B 0 (IntermediateField.inclusion hAB (t j₀)⁻¹) :=
        Or.inr (by rw [hValAlg_AB (t j₀)⁻¹, hut_inv_val0, mul_zero])
      have h2 : P_B 0 (1 * Q_poly.coeff j₀ * Δ⁻¹) := by
        rw [one_mul]
        exact hPB_mul0 (hQ_int j₀) hΔ_inv_P0
      exact hPB_mul0 h1 h2
    have hy₁_tr : traceLM F hAB y₁ = 1 := by
      apply hinj
      rw [hact_trace y₁]
      have h_pull : (∑ σ : G_AB, act_AB σ y₁) =
          IntermediateField.inclusion hAB (t j₀)⁻¹ *
            ∑ σ : G_AB, act_AB σ (1 * Q_poly.coeff j₀ * Δ⁻¹) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun σ _ => ?_
        dsimp [y₁]
        rw [((hact_ring σ).2.2 _ _).2.1, hact_incl σ (t j₀)⁻¹]
      rw [h_pull, ← hact_trace (1 * Q_poly.coeff j₀ * Δ⁻¹)]
      change IntermediateField.inclusion hAB (t j₀)⁻¹ *
        IntermediateField.inclusion hAB (t j₀) = IntermediateField.inclusion hAB 1
      rw [← map_mul, inv_mul_cancel₀ htj0_ne0]
    exact ⟨y₁, hy₁_P0, hy₁_tr⟩

  
  let π_I : B := ∏ γ : I, act_AB γ.1 (ϖ_B : B)
  have hπ_I_inv : ∀ σ ∈ I, act_AB σ π_I = π_I := by
    intro σ hσ
    have h1 : act_AB σ π_I = ∏ γ : I, act_AB ((⟨σ, hσ⟩ : I) * γ).1 (ϖ_B : B) := by
      change φ σ (∏ γ : I, act_AB γ.1 (ϖ_B : B)) = _
      rw [map_prod (φ σ)]
      refine Finset.prod_congr rfl fun γ _ => ?_
      change act_AB σ (act_AB γ.1 (ϖ_B : B)) = act_AB (σ * γ.1) (ϖ_B : B)
      exact (hact_mul σ γ.1 (ϖ_B : B)).symm
    rw [h1]
    exact Equiv.prod_comp (Equiv.mulLeft (⟨σ, hσ⟩ : I)) (fun γ : I => act_AB γ.1 (ϖ_B : B))
  have hπ_I_props : π_I ≠ 0 ∧ valL F B π_I = (m_I : ℤ) := by
    have h_ind : ∀ T : Finset I,
        (∏ γ ∈ T, act_AB γ.1 (ϖ_B : B)) ≠ 0 ∧
        valL F B (∏ γ ∈ T, act_AB γ.1 (ϖ_B : B)) = (T.card : ℤ) := by
      intro T
      induction' T using Finset.induction_on with γ T' hγ ih
      · rw [Finset.prod_empty, Finset.card_empty, Nat.cast_zero]
        exact ⟨one_ne_zero, hvalB1⟩
      · rw [Finset.prod_insert hγ, Finset.card_insert_of_notMem hγ, Nat.cast_add, Nat.cast_one]
        have hγ_val : valL F B (act_AB γ.1 (ϖ_B : B)) = 1 := by
          rw [hact_val γ.1 (ϖ_B : B), hϖ_B]
        have hγ_ne0 : act_AB γ.1 (ϖ_B : B) ≠ 0 := by
          intro h0
          rw [h0, hvalB0] at hγ_val
          omega
        refine ⟨mul_ne_zero hγ_ne0 ih.1, ?_⟩
        rw [hvalB_mul _ _ hγ_ne0 ih.1, hγ_val, ih.2, add_comm]
    have h_univ := h_ind Finset.univ
    rwa [Finset.card_univ, ← hm_I_card] at h_univ
  have hπ_I_ne0 : π_I ≠ 0 := hπ_I_props.1
  have hπ_I_val : valL F B π_I = (m_I : ℤ) := hπ_I_props.2
  have hπ_I_P1 : P_B 1 π_I := Or.inr (by omega)
  have he_AB_le : e_AB ≤ m_I := by
    have h_term_e : ∀ j ∈ Finset.range n,
        P_B (e_AB : ℤ)
          (IntermediateField.inclusion hAB (traceLM F hAB (π_I * Q_poly.coeff j * Δ⁻¹)) * z₀ ^ j) := by
      intro j _
      set a_j : A := traceLM F hAB (π_I * Q_poly.coeff j * Δ⁻¹)
      have hw_term_P1 : P_B 1 (π_I * Q_poly.coeff j * Δ⁻¹) :=
        hPB_mul0 (hPB_mul0 hπ_I_P1 (hQ_int j)) hΔ_inv_P0
      have ha_P1 : P_B 1 (IntermediateField.inclusion hAB a_j) :=
        h_trace_PB 1 (π_I * Q_poly.coeff j * Δ⁻¹) hw_term_P1
      have ha_Pe : P_B (e_AB : ℤ) (IntermediateField.inclusion hAB a_j) := by
        by_cases ha0 : a_j = 0
        · exact Or.inl (by rw [ha0, map_zero])
        · right
          have h_inc_ne0 : IntermediateField.inclusion hAB a_j ≠ 0 :=
            fun h => ha0 ((map_eq_zero_iff _ hinj).mp h)
          have hge1 : 1 ≤ valL F B (IntermediateField.inclusion hAB a_j) :=
            ha_P1.resolve_left h_inc_ne0
          rw [hValAlg_AB a_j] at hge1 ⊢
          have hval_ge1 : 1 ≤ valL F A a_j := by
            by_contra hlt
            have hle0 : valL F A a_j ≤ 0 := by omega
            have hprod_le0 : (e_AB : ℤ) * valL F A a_j ≤ 0 := by nlinarith [he_AB_ge1, hle0]
            omega
          nlinarith [he_AB_ge1, hval_ge1]
      exact hPB_mul0 ha_Pe (hz₀_pow_P0 j)
    have hm_π_Pe : P_B (e_AB : ℤ) ((m_I : B) * π_I) := by
      rw [h_coset_lagrange π_I hπ_I_inv]
      exact hPB_sum_nat (Finset.range n) _ (e_AB : ℤ) h_term_e
    have hm_π_ne0 : (m_I : B) * π_I ≠ 0 := mul_ne_zero hm_I_ne0 hπ_I_ne0
    have hm_π_ge : (e_AB : ℤ) ≤ valL F B ((m_I : B) * π_I) := hm_π_Pe.resolve_left hm_π_ne0
    rw [hvalB_mul (m_I : B) π_I hm_I_ne0 hπ_I_ne0, hm_I_val0, hπ_I_val, zero_add] at hm_π_ge
    omega

  exact ⟨⟨e_AB, he_AB_ge1, he_AB_le, hValAlg_AB⟩, hy₁_ex⟩

theorem ld_ch14_wild_semidirect_inertia_and_serre_jump (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hGalFiK : ∀ i : Fin D_orb.length, IsGaloisExt F (D_orb.get i).field K)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hμ'_props : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) ∧
      IsGaloisExt F (D_orb.get i).field M_C ∧
      (μ'_orb i) ^ (p F) = 1 ∧
      μ'_orb i ≠ 1 ∧
      (∀ u ∈ unitGroup F (D_orb.get i).field (condExp F (D_orb.get i).field (μ'_orb i)),
        (μ'_orb i) u = 1) ∧
      (∀ (χ' : Lˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F (D_orb.get i).field
            (condExp F (D_orb.get i).field
              (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))),
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) u = 1) → True) ∧
      ∃ (K_i : IntermediateField F (AlgebraicClosure F))
        (hFiKi : (D_orb.get i).field ≤ K_i) (hKiEi : K_i ≤ E ⊔ (D_orb.get i).field),
        IsGaloisExt F (D_orb.get i).field K_i ∧
        IsAbelianExt F hFiKi ∧
        Module.finrank (D_orb.get i).field (IntermediateField.extendScalars hFiKi) = p F ∧
        (∀ z : ((D_orb.get i).field)ˣ,
          z ∈ Set.range (Units.map (normLM F hFiKi)) ↔ (μ'_orb i) z = 1) ∧
        (∀ w : M_Cˣ,
          w ∈ Set.range (Units.map (normLM F hM_CK)) →
          ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w = 1) ∧
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) ≠ 1) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let r_orb := D_orb.length
    Nat.Prime (p F) ∧
    (∃ r_exp : ℕ, 1 ≤ r_exp ∧ q = (p F) ^ r_exp) ∧
    (∀ σ ∈ M_C.fixingSubgroup, σ ^ (p F) ∈ K.fixingSubgroup) ∧
    (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ q = 0 ∨ 1 ≤ valL F L (x - s ^ q))) ∧
    (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (p F) = 0 ∨ 1 ≤ valL F L (x - s ^ (p F)))) ∧
    (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F)))) ∧
    qL F K = qL F M_C ∧
    resDeg F K = resDeg F M_C ∧
    (∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w) ∧
    (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z) ∧
    (∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z))) ∧
    ∃ (t k : ℕ),
      1 ≤ t ∧
      1 ≤ k ∧
      k ∣ (q - 1) ∧
      (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x) ∧
      (∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y) ∧
      resDeg F E = resDeg F L ∧
      (∃ y₁ : M_C, (y₁ = 0 ∨ 0 ≤ valL F M_C y₁) ∧ traceLM F hLM_C y₁ = 1) ∧
      (∃ w₁ : K, (w₁ = 0 ∨ 0 ≤ valL F K w₁) ∧ traceLM F hEK w₁ = 1) ∧
      (∀ i : Fin r_orb, ∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
        ∀ σ ∈ M_C.fixingSubgroup, σ ∉ K.fixingSubgroup →
          ∀ hσw : (σ : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K,
            (ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) ≠ 0 ∧
            valL F K ((ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K)) =
              (t + 1 : ℤ)) :=
by
  obtain ⟨hp_prime, ⟨r_exp, hr_exp_pos, hq_eq⟩, hExpMCK, hFrobSurjL, hFrobSurjLp, hFrobSurjMC,
      G, instGroupG, instFintypeG, C, H, act, act_MC,
      hC_norm, hC_ab, hcard_C, hcard_H, hH_gt1, hC_exp, hG_mul, hZ_H, hC_min_norm,
      hact_one, hact_mul, hact_ring, hact_incl_L, hact_faithful, hact_val,
      hC_mem_iff, hC_fixed_iff, hact_trace_MCK, hact_norm_MCK, hact_trace_EK, hact_incl_E,
      hact_MC_one, hact_MC_mul, hact_MC_ring, hact_MC_incl, hact_MC_val,
      hact_MC_compat, hact_MC_trace, hLift_to_G, hLift_from_G⟩ :=
    ld_ch14_wild_semidirect_galois_and_frob_package F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hGalMCK hMin h_wild hFinE_eq
  letI : Group G := instGroupG
  letI : Fintype G := instFintypeG
  letI : C.Normal := hC_norm
  obtain ⟨hqK, hresK, hValNormK, hValAlgK, hResLiftK,
      t, G₀, I_H, ht_ge1, hG₀_norm, hIH_norm, hk_ge1, hk_dvd, hk_ndvd,
      hG₀_iff, hIH_K_iff, hIH_MC_iff, hJumpK_C, hComm_surj, hRam_eq⟩ :=
    ld_ch14_wild_lower_ramification_and_serre_commutator F L K M_C E hLK hLM_C hM_CK hLE hEK
      hp_prime r_exp hr_exp_pos hq_eq hFinE_eq G C H act act_MC
      hC_ab hcard_C hH_gt1 hC_exp hG_mul hZ_H hC_min_norm
      hact_one hact_mul hact_ring hact_incl_L hact_faithful hact_val
      hC_mem_iff hact_trace_MCK hact_norm_MCK hact_MC_compat
  letI : I_H.Normal := hIH_norm
  obtain ⟨⟨e_MCL, he_MCL_ge1, he_MCL_le, hValAlg_eMCL⟩, hy₁_MCL⟩ :=
    ld_ch14_tame_inertia_coset_lagrange_and_trace_one F L M_C hLM_C hp_prime
      H act_MC hact_MC_one hact_MC_mul hact_MC_ring hact_MC_incl hact_MC_val hact_MC_trace
      I_H hIH_MC_iff hk_ndvd
  obtain ⟨⟨e_KE, he_KE_ge1, he_KE_le, hValAlg_eKE⟩, hw₁_KE⟩ :=
    ld_ch14_tame_inertia_coset_lagrange_and_trace_one F E K hEK hp_prime
      H (fun h w => act h.1 w)
      (fun w => hact_one w)
      (fun h₁ h₂ w => hact_mul h₁.1 h₂.1 w)
      (fun h => hact_ring h.1)
      hact_incl_E
      (fun h w => hact_val h.1 w)
      hact_trace_EK
      I_H hIH_K_iff hk_ndvd
  obtain ⟨he_MCL_eq, he_KE_eq, hresE⟩ :=
    hRam_eq e_MCL e_KE he_MCL_ge1 he_MCL_le he_KE_ge1 he_KE_le hValAlg_eMCL hValAlg_eKE
  have hValAlgMCL : ∀ x : L,
      valL F M_C (IntermediateField.inclusion hLM_C x) = (Nat.card I_H : ℤ) * valL F L x := by
    intro x
    rw [← he_MCL_eq]
    exact hValAlg_eMCL x
  have hValAlgKE : ∀ y : E,
      valL F K (IntermediateField.inclusion hEK y) = (Nat.card I_H : ℤ) * valL F E y := by
    intro y
    rw [← he_KE_eq]
    exact hValAlg_eKE y
  have hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK) := by
    rw [hq_eq]
    exact one_lt_pow₀ hp_prime.one_lt (by omega)
  have hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
        valL F (D_orb.get i).field x := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    obtain ⟨_, hGalFiMC, _, _, _, _, K_i, hFiKi, hKiEi, _, hAbFiKi, _, hμ'_ker, _, hμ'_comp_ne1⟩ :=
      hμ'_props i
    have hKiK : K_i ≤ K := hKiEi.trans (sup_le hEK ((hFiMC i).trans hM_CK))
    obtain ⟨G_Fi, instGroupGFi, instFintypeGFi, act_Fi,
        hact_Fi_one, hact_Fi_mul, hact_Fi_ring, hact_Fi_incl,
        hact_Fi_val, hact_Fi_trace, hact_Fi_inertia_triv⟩ :=
      ld_ch14_wild_orbit_inertia_trivial_and_galois_action F L K M_C (D_orb.get i).field K_i
        hLM_C hM_CK (D_orb.get i).le (hFiMC i) hFiKi hKiK hGalFiMC hAbFiKi
        (μ'_orb i) hμ'_ker hμ'_comp_ne1 hq_gt1 hValAlgK hResLiftK
        G C G₀ act hact_mul hact_ring hact_val hC_mem_iff hC_fixed_iff
        hG₀_iff hComm_surj hLift_to_G hLift_from_G
    letI : Group G_Fi := instGroupGFi
    letI : Fintype G_Fi := instFintypeGFi
    have hI_bot_iff : ∀ σ : G_Fi,
        σ ∈ (⊥ : Subgroup G_Fi) ↔ ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
          (act_Fi σ z - z = 0 ∨ 1 ≤ valL F M_C (act_Fi σ z - z)) := by
      intro σ
      rw [Subgroup.mem_bot]
      refine ⟨?_, hact_Fi_inertia_triv σ⟩
      rintro rfl z _
      left
      rw [hact_Fi_one z, sub_self]
    have hm_bot_ndvd : ¬ (p F ∣ Nat.card (⊥ : Subgroup G_Fi)) := by
      rw [Subgroup.card_bot]
      exact hp_prime.not_dvd_one
    obtain ⟨⟨e_Fi, he_Fi_ge1, he_Fi_le, hValAlg_eFi⟩, _⟩ :=
      ld_ch14_tame_inertia_coset_lagrange_and_trace_one F (D_orb.get i).field M_C (hFiMC i) hp_prime
        G_Fi act_Fi hact_Fi_one hact_Fi_mul hact_Fi_ring hact_Fi_incl hact_Fi_val hact_Fi_trace
        (⊥ : Subgroup G_Fi) hI_bot_iff hm_bot_ndvd
    rw [Subgroup.card_bot] at he_Fi_le
    have he_Fi_eq1 : e_Fi = 1 := by omega
    intro x
    have hx := hValAlg_eFi x
    rw [he_Fi_eq1, Nat.cast_one, one_mul] at hx
    exact hx
  have hJumpK : ∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
      ∀ σ ∈ M_C.fixingSubgroup, σ ∉ K.fixingSubgroup →
        ∀ hσw : (σ : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K,
          (ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) ≠ 0 ∧
          valL F K ((ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K)) =
            (t + 1 : ℤ) := by
    intro ϖ_K hϖ_K σ hσMC hσK hσw
    have hσL : σ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM_C hσMC
    obtain ⟨g, hg_ker, hg_act⟩ := hLift_to_G σ hσL
    have hg_C : g ∈ C := by
      rw [hC_mem_iff]
      intro z
      have hσz_eq : (σ : AbsGal F) ((IntermediateField.inclusion hM_CK z : K) : AlgebraicClosure F) =
          (z : AlgebraicClosure F) := hσMC ⟨(z : AlgebraicClosure F), z.2⟩
      have hσz_K : (σ : AbsGal F) ((IntermediateField.inclusion hM_CK z : K) : AlgebraicClosure F) ∈ K := by
        rw [hσz_eq]
        exact hM_CK z.2
      rw [hg_act (IntermediateField.inclusion hM_CK z) hσz_K]
      apply Subtype.ext
      exact hσz_eq
    have hg_ne1 : g ≠ 1 := fun hg1 => hσK (hg_ker.mpr hg1)
    rw [← hg_act (ϖ_K : K) hσw]
    exact hJumpK_C g hg_C hg_ne1 ϖ_K hϖ_K
  exact ⟨hp_prime, ⟨r_exp, hr_exp_pos, hq_eq⟩, hExpMCK, hFrobSurjL, hFrobSurjLp, hFrobSurjMC,
    hqK, hresK, hValNormK, hValAlgK, hResLiftK,
    t, Nat.card I_H, ht_ge1, hk_ge1, hk_dvd, hValAlgMCL, hValAlgKE, hresE,
    hy₁_MCL, hw₁_KE, hValAlgFiMC, hJumpK⟩

theorem ld_ch14_wild_diamond_basis_and_trace_norm_compat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (k : ℕ)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hresE : resDeg F E = resDeg F L) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    qL F E = qL F L ∧
    (∀ y : E, valL F L (normLM F hLE y) = valL F E y) ∧
    (∀ x : L, valL F E (IntermediateField.inclusion hLE x) = (q : ℤ) * valL F L x) ∧
    (∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x))) ∧
    (∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y)) :=
by
  have hval_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      0 < resDeg F M ∧
      (∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x) ∧
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ (x : M) (n : ℕ), x ≠ 0 → valL F M (x ^ n) = (n : ℤ) * valL F M x) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (m : ℤ) (x y : M),
        (x = 0 ∨ m ≤ valL F M x) → (y = 0 ∨ m ≤ valL F M y) →
          (x + y = 0 ∨ m ≤ valL F M (x + y))) ∧
      (∀ (y₁ y₂ : M),
        y₁ ≠ 0 → (y₂ = 0 ∨ valL F M y₁ + 1 ≤ valL F M y₂) →
          y₁ + y₂ ≠ 0 ∧ valL F M (y₁ + y₂) = valL F M y₁) := by
    clear hLM_C hM_CK hLE hEK hFinE_eq hq_gt1 hValAlgK k hk_dvd hValAlgKE hresE
    clear ‹FiniteDimensional F L› ‹FiniteDimensional F M_C› ‹FiniteDimensional F E› ‹FiniteDimensional F K›
    clear L K M_C E
    intro L _
    have halg : ∀ z : L,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F L = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq L.val L.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F L (-1) = 0 := by
      have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : L) * (-1 : L) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : L) = (-1 : L) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q : ℤ := valL F L x
        set r : ℤ := relVal F L x % f
        have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F L := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F L 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval1 : valL F L 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
      intro x
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_pow : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
      intro x n hx
      induction n with
      | zero => simp [hval1]
      | succ n ih =>
        rw [pow_succ, hval_mul (x ^ n) x (pow_ne_zero n hx) hx, ih]
        push_cast
        ring
    have hval_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m := by
      intro m
      refine ⟨ϖL ^ m, ?_⟩
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv, hrel_zpow ϖL m, hrel_ϖL, mul_comm]
    have hval_add : ∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : L,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : L, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F L z ≤ valL F L w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F L) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfL_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : L) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F L x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F L y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    have hval_strict : ∀ (y₁ y₂ : L),
        y₁ ≠ 0 → (y₂ = 0 ∨ valL F L y₁ + 1 ≤ valL F L y₂) →
          y₁ + y₂ ≠ 0 ∧ valL F L (y₁ + y₂) = valL F L y₁ := by
      intro y₁ y₂ hy₁ hy₂
      set v₁ : ℤ := valL F L y₁
      have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F L y₂ := by
        rcases hy₂ with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F L (y₁ + y₂) :=
        hval_add v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
      have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F L (y₁ + y₂)) := by
        intro hgt
        have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F L (-y₂) := by
          rcases hy₂ with h0 | hge
          · exact Or.inl (neg_eq_zero.mpr h0)
          · right
            rw [hval_neg]
            exact hge
        have hy₁_gt := hval_add (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
        have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
        rw [heq_y₁] at hy₁_gt
        rcases hy₁_gt with h10 | h1ge
        · exact hy₁ h10
        · omega
      have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
      have hsum_v₁ : v₁ ≤ valL F L (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
      have hsum_not1 : ¬ (v₁ + 1 ≤ valL F L (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
      exact ⟨hsum_ne, by omega⟩
    exact ⟨hfL_pos, hdiv, hval0, hval1, hval_neg, hval_mul, hval_pow, hval_surj, hval_add, hval_strict⟩

  obtain ⟨hresDeg_L_pos, hdiv_L, hval0_L, _, _, _, hval_pow_L, _, _, _⟩ := hval_props L
  obtain ⟨_, hdiv_E, hval0_E, _, _, hval_mul_E, hval_pow_E, hval_surj_E, hval_add_E, hval_strict_E⟩ := hval_props E
  obtain ⟨_, _, _, _, _, hval_mul_K, hval_pow_K, _, hval_add_K, hval_strict_K⟩ := hval_props K

  let K_MC' := IntermediateField.extendScalars hM_CK
  let E' := IntermediateField.extendScalars hLE
  set q : ℕ := Module.finrank M_C K_MC'
  have hq_pos : 0 < q := by omega
  have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hresDeg_L_pos
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos

  have hqE : qL F E = qL F L := by
    unfold qL
    rw [hresE]

  let eF_E : E ≃ₐ[F] E' :=
    { toExtendScalars F hLE with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F E' := Module.Finite.equiv eF_E.toLinearEquiv
  haveI : IsScalarTower F L E' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L E' := Module.Finite.of_restrictScalars_finite F L E'

  have hrelVal_norm_LE : ∀ y : E, relVal F L (normLM F hLE y) = relVal F E y := by
    intro y
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLE y))) =
      addVal F (Algebra.norm F y)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLE y)) =
        Algebra.norm F (toExtendScalars F hLE y) := Algebra.norm_norm
    have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hLE y) :=
      Algebra.norm_eq_of_algEquiv eF_E y
    rw [h1, ← h2]

  have hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y := by
    intro y
    apply mul_left_cancel₀ hfL_int_ne
    calc (resDeg F L : ℤ) * valL F L (normLM F hLE y)
      _ = relVal F L (normLM F hLE y) := (hdiv_L (normLM F hLE y)).symm
      _ = relVal F E y := hrelVal_norm_LE y
      _ = (resDeg F E : ℤ) * valL F E y := hdiv_E y
      _ = (resDeg F L : ℤ) * valL F E y := by rw [hresE]

  have hnorm_inc_LE : ∀ x : L,
      normLM F hLE (IntermediateField.inclusion hLE x) = x ^ q := by
    intro x
    change Algebra.norm L (algebraMap L E' x) = x ^ q
    rw [Algebra.norm_algebraMap, hFinE_eq]

  have hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) = (q : ℤ) * valL F L x := by
    intro x
    by_cases hx0 : x = 0
    · rw [hx0, map_zero, hval0_E, hval0_L, mul_zero]
    · rw [← hValNormE (IntermediateField.inclusion hLE x), hnorm_inc_LE x, hval_pow_L x q hx0]

  obtain ⟨ϖ_E, hϖ_E⟩ := hval_surj_E 1

  let t_term_E (c : Fin q → L) (i : Fin q) : E :=
    IntermediateField.inclusion hLE (c i) * ((ϖ_E : E) ^ (i : ℕ))
  let v_term_E (c : Fin q → L) (i : Fin q) : ℤ :=
    (q : ℤ) * valL F L (c i) + (i.1 : ℤ)

  have ht_term_E_zero : ∀ (c : Fin q → L) (i : Fin q), c i = 0 → t_term_E c i = 0 := by
    intro c i hci
    dsimp [t_term_E]
    rw [hci, map_zero, zero_mul]

  have ht_term_E_nz : ∀ (c : Fin q → L) (i : Fin q),
      c i ≠ 0 → t_term_E c i ≠ 0 ∧ valL F E (t_term_E c i) = v_term_E c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hLE (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hLE).toRingHom).ne hci
    have hpow_ne : ((ϖ_E : E) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_E)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term_E, v_term_E]
    rw [hval_mul_E _ _ hinc_ne hpow_ne, hValAlgE (c i),
      hval_pow_E (ϖ_E : E) (i : ℕ) (Units.ne_zero ϖ_E), hϖ_E, mul_one]

  have hv_term_E_inj : ∀ (c : Fin q → L) (i j : Fin q),
      v_term_E c i = v_term_E c j → i = j := by
    intro c i j hij
    have hmod : ∀ m : Fin q, v_term_E c m % (q : ℤ) = (m.1 : ℤ) := by
      intro m
      dsimp [v_term_E]
      have hcomm : (q : ℤ) * valL F L (c m) + (m.1 : ℤ) =
          (m.1 : ℤ) + (q : ℤ) * valL F L (c m) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg m.1) (Nat.cast_lt.mpr m.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_E_ge : ∀ (c : Fin q → L) (S : Finset (Fin q)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term_E c i) →
        ((∑ i ∈ S, t_term_E c i) = 0 ∨ m ≤ valL F E (∑ i ∈ S, t_term_E c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term_E c a = 0 ∨ m ≤ valL F E (t_term_E c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_E_zero c a hca)
        · right
          rw [(ht_term_E_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_E m (t_term_E c a) (∑ i ∈ s, t_term_E c i) ha_t hs_t

  have hsum_min_E_nz : ∀ (c : Fin q → L) (i : Fin q),
      c i ≠ 0 →
        ∃ i₀ : Fin q, c i₀ ≠ 0 ∧ v_term_E c i₀ ≤ v_term_E c i ∧
          (∑ j : Fin q, t_term_E c j) ≠ 0 ∧
          valL F E (∑ j : Fin q, t_term_E c j) = v_term_E c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin q) := (Finset.univ : Finset (Fin q)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term_E c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term_E c i₀ ≤ v_term_E c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin q)).erase i₀,
        c j = 0 ∨ v_term_E c i₀ + 1 ≤ v_term_E c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term_E c i₀ ≤ v_term_E c j := hi₀_min j hj_mem
        have hne_v : v_term_E c i₀ ≠ v_term_E c j := fun heq => hj_ne (hv_term_E_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_E_ge c ((Finset.univ : Finset (Fin q)).erase i₀)
      (v_term_E c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_E_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_E (t_term_E c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin q)).erase i₀, t_term_E c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term_E c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hval_sum_E_iff : ∀ (c : Fin q → L) (m : ℤ),
      ((∑ i : Fin q, t_term_E c i) = 0 ∨ m ≤ valL F E (∑ i : Fin q, t_term_E c i)) ↔
        ∀ i : Fin q, c i = 0 ∨ m ≤ v_term_E c i := by
    intro c m
    refine ⟨?_, fun hall => hval_sum_E_ge c Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hci : c i = 0
    · exact Or.inl hci
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_E_nz c i hci
      have hm_le : m ≤ valL F E (∑ j : Fin q, t_term_E c j) := hsum.resolve_left hsum_ne
      omega

  have hlin_zero_E : ∀ (c : Fin q → L),
      (∑ i : Fin q, t_term_E c i) = 0 → ∀ i : Fin q, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_E_nz c i hci
    exact hsum_ne hsum0

  let b_E : Fin q → E' := fun i => (toExtendScalars F hLE (ϖ_E : E)) ^ (i : ℕ)
  have hli_E : LinearIndependent L b_E := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hLE (∑ i : Fin q, t_term_E c i) =
        ∑ i : Fin q, c i • b_E i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term_E, b_E]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin q, t_term_E c i) = 0 := by
      apply eF_E.injective
      change toExtendScalars F hLE (∑ i : Fin q, t_term_E c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero_E c hsum0

  haveI : Nonempty (Fin q) := ⟨⟨0, hq_pos⟩⟩
  have hcard_E : Fintype.card (Fin q) = Module.finrank L E' :=
    (Fintype.card_fin q).trans hFinE_eq.symm
  let B_E : Module.Basis (Fin q) L E' := basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E

  have hResLiftE : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)) := by
    intro y hy
    let c : Fin q → L := fun i => B_E.repr (toExtendScalars F hLE y) i
    have hy_eq : y = ∑ i : Fin q, t_term_E c i := by
      apply eF_E.injective
      change toExtendScalars F hLE y = toExtendScalars F hLE (∑ i : Fin q, t_term_E c i)
      have hrepr := (B_E.sum_repr (toExtendScalars F hLE y)).symm
      rw [hrepr, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [B_E, c, t_term_E, b_E]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E, map_mul, map_pow]
      rfl
    have hc0 : ∀ i : Fin q, c i = 0 ∨ 0 ≤ v_term_E c i :=
      (hval_sum_E_iff c 0).mp (hy_eq ▸ hy)
    let i_zero : Fin q := ⟨0, hq_pos⟩
    let x : L := c i_zero
    have hx_int : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc0 i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (q : ℤ) * valL F L x + 0 at hge
        nlinarith
    let c_rem : Fin q → L := fun i => if i = i_zero then 0 else c i
    have hy_sub_eq : y - IntermediateField.inclusion hLE x = ∑ i : Fin q, t_term_E c_rem i := by
      have ht_zero : t_term_E c i_zero = IntermediateField.inclusion hLE x := by
        dsimp [t_term_E, i_zero, x]
        rw [pow_zero, mul_one]
      have hsplit_c := (Finset.add_sum_erase Finset.univ (t_term_E c) (Finset.mem_univ i_zero)).symm
      have hsplit_rem := (Finset.add_sum_erase Finset.univ (t_term_E c_rem) (Finset.mem_univ i_zero)).symm
      have hrem_zero : t_term_E c_rem i_zero = 0 :=
        ht_term_E_zero c_rem i_zero (if_pos rfl)
      have herase_eq : (∑ i ∈ (Finset.univ : Finset (Fin q)).erase i_zero, t_term_E c i) =
          ∑ i ∈ (Finset.univ : Finset (Fin q)).erase i_zero, t_term_E c_rem i := by
        apply Finset.sum_congr rfl
        intro i hi
        have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
        dsimp [t_term_E, c_rem]
        rw [if_neg hi_ne]
      rw [hy_eq, hsplit_c, ht_zero, add_sub_cancel_left, herase_eq, hsplit_rem, hrem_zero, zero_add]
    have hrem_ge1 : ∀ i : Fin q, c_rem i = 0 ∨ 1 ≤ v_term_E c_rem i := by
      intro i
      by_cases hi0 : i = i_zero
      · left
        dsimp [c_rem]
        rw [if_pos hi0]
      · dsimp [c_rem, v_term_E]
        rw [if_neg hi0]
        rcases hc0 i with hci0 | hge
        · exact Or.inl hci0
        · right
          dsimp [v_term_E] at hge
          have hi_pos : (1 : ℤ) ≤ (i.1 : ℤ) := by
            have hne_val : i.1 ≠ 0 := fun h0 => hi0 (Fin.ext h0)
            omega
          have hi_lt : (i.1 : ℤ) < (q : ℤ) := Nat.cast_lt.mpr i.2
          have hval_nonneg : 0 ≤ valL F L (c i) := by
            by_contra hneg
            have hle_neg1 : valL F L (c i) ≤ -1 := by omega
            nlinarith
          nlinarith
    refine ⟨x, hx_int, ?_⟩
    rw [hy_sub_eq]
    exact (hval_sum_E_iff c_rem 1).mpr hrem_ge1

  let eF_KMC : K ≃ₐ[F] K_MC' :=
    { toExtendScalars F hM_CK with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hM_CK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K_MC' := Module.Finite.equiv eF_KMC.toLinearEquiv
  haveI : IsScalarTower F M_C K_MC' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M_C K_MC' := Module.Finite.of_restrictScalars_finite F M_C K_MC'

  let ϖ_K : Kˣ := Units.map (IntermediateField.inclusion hEK).toMonoidHom ϖ_E
  have hϖ_K_coe : (ϖ_K : K) = IntermediateField.inclusion hEK (ϖ_E : E) := rfl
  have hϖ_K : valL F K (ϖ_K : K) = (k : ℤ) := by
    rw [hϖ_K_coe, hValAlgKE (ϖ_E : E), hϖ_E, mul_one]

  let t_term_K (c : Fin q → M_C) (i : Fin q) : K :=
    IntermediateField.inclusion hM_CK (c i) * ((ϖ_K : K) ^ (i : ℕ))
  let v_term_K (c : Fin q → M_C) (i : Fin q) : ℤ :=
    (q : ℤ) * valL F M_C (c i) + (k : ℤ) * (i.1 : ℤ)

  have ht_term_K_zero : ∀ (c : Fin q → M_C) (i : Fin q), c i = 0 → t_term_K c i = 0 := by
    intro c i hci
    dsimp [t_term_K]
    rw [hci, map_zero, zero_mul]

  have ht_term_K_nz : ∀ (c : Fin q → M_C) (i : Fin q),
      c i ≠ 0 → t_term_K c i ≠ 0 ∧ valL F K (t_term_K c i) = v_term_K c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hM_CK (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hM_CK).toRingHom).ne hci
    have hpow_ne : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term_K, v_term_K]
    rw [hval_mul_K _ _ hinc_ne hpow_ne, hValAlgK (c i),
      hval_pow_K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_comm (i.1 : ℤ) (k : ℤ)]

  have hcop_kq : Nat.Coprime k q := by
    rw [Nat.Coprime]
    have hd_k : k.gcd q ∣ k := Nat.gcd_dvd_left k q
    have hd_q : k.gcd q ∣ q := Nat.gcd_dvd_right k q
    have hd_q1 : k.gcd q ∣ (q - 1) := dvd_trans hd_k hk_dvd
    have hd_sub : k.gcd q ∣ q - (q - 1) := Nat.dvd_sub hd_q hd_q1
    have hq_sub : q - (q - 1) = 1 := by omega
    rw [hq_sub] at hd_sub
    exact Nat.dvd_one.mp hd_sub

  have hv_le : ∀ (v₁ v₂ : ℤ) (a b : ℕ), a ≤ b → b < q →
      (q : ℤ) * v₁ + (k : ℤ) * (a : ℤ) = (q : ℤ) * v₂ + (k : ℤ) * (b : ℤ) → a = b := by
    intro v₁ v₂ a b hab hbq heq
    have hsub_int : ((k * (b - a) : ℕ) : ℤ) = (q : ℤ) * (v₁ - v₂) := by
      rw [Nat.cast_mul, Nat.cast_sub hab]
      linarith
    have hnonneg : 0 ≤ v₁ - v₂ := by
      have hlhs_nonneg : (0 : ℤ) ≤ ((k * (b - a) : ℕ) : ℤ) := Nat.cast_nonneg _
      have hq_int_pos : (0 : ℤ) < (q : ℤ) := Nat.cast_pos.mpr hq_pos
      nlinarith
    have h_eq_nat : k * (b - a) = q * (v₁ - v₂).toNat := by
      apply Nat.cast_injective (R := ℤ)
      rw [hsub_int, Nat.cast_mul, Int.toNat_of_nonneg hnonneg]
    have hdvd_mul : q ∣ k * (b - a) := ⟨(v₁ - v₂).toNat, h_eq_nat⟩
    have hdvd_sub : q ∣ (b - a) := hcop_kq.symm.dvd_of_dvd_mul_left hdvd_mul
    have hlt : b - a < q := by omega
    have hzero : b - a = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_sub hlt
    omega

  have hv_term_K_inj : ∀ (c : Fin q → M_C) (i j : Fin q),
      v_term_K c i = v_term_K c j → i = j := by
    intro c i j hij
    rcases le_total i.1 j.1 with hle | hle
    · exact Fin.ext (hv_le (valL F M_C (c i)) (valL F M_C (c j)) i.1 j.1 hle j.2 hij)
    · exact Fin.ext (hv_le (valL F M_C (c j)) (valL F M_C (c i)) j.1 i.1 hle i.2 hij.symm).symm

  have hval_sum_K_ge : ∀ (c : Fin q → M_C) (S : Finset (Fin q)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term_K c i) →
        ((∑ i ∈ S, t_term_K c i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, t_term_K c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term_K c a = 0 ∨ m ≤ valL F K (t_term_K c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_K_zero c a hca)
        · right
          rw [(ht_term_K_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K m (t_term_K c a) (∑ i ∈ s, t_term_K c i) ha_t hs_t

  have hsum_min_K_nz : ∀ (c : Fin q → M_C) (i : Fin q),
      c i ≠ 0 →
        ∃ i₀ : Fin q, c i₀ ≠ 0 ∧ v_term_K c i₀ ≤ v_term_K c i ∧
          (∑ j : Fin q, t_term_K c j) ≠ 0 ∧
          valL F K (∑ j : Fin q, t_term_K c j) = v_term_K c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin q) := (Finset.univ : Finset (Fin q)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term_K c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term_K c i₀ ≤ v_term_K c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin q)).erase i₀,
        c j = 0 ∨ v_term_K c i₀ + 1 ≤ v_term_K c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term_K c i₀ ≤ v_term_K c j := hi₀_min j hj_mem
        have hne_v : v_term_K c i₀ ≠ v_term_K c j := fun heq => hj_ne (hv_term_K_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_K_ge c ((Finset.univ : Finset (Fin q)).erase i₀)
      (v_term_K c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_K_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_K (t_term_K c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin q)).erase i₀, t_term_K c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term_K c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hlin_zero_K : ∀ (c : Fin q → M_C),
      (∑ i : Fin q, t_term_K c i) = 0 → ∀ i : Fin q, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_K_nz c i hci
    exact hsum_ne hsum0

  let b_K : Fin q → K_MC' := fun i => (toExtendScalars F hM_CK (ϖ_K : K)) ^ (i : ℕ)
  have hli_K : LinearIndependent M_C b_K := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hM_CK (∑ i : Fin q, t_term_K c i) =
        ∑ i : Fin q, c i • b_K i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term_K, b_K]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin q, t_term_K c i) = 0 := by
      apply eF_KMC.injective
      change toExtendScalars F hM_CK (∑ i : Fin q, t_term_K c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero_K c hsum0

  have hcard_K : Fintype.card (Fin q) = Module.finrank M_C K_MC' := Fintype.card_fin q
  let B_K : Module.Basis (Fin q) M_C K_MC' := basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K

  have hrepr_compat : ∀ (y : E) (i : Fin q),
      B_K.repr (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) i =
        IntermediateField.inclusion hLM_C (B_E.repr (toExtendScalars F hLE y) i) := by
    intro y i
    let c : Fin q → L := B_E.equivFun (toExtendScalars F hLE y)
    let c_MC : Fin q → M_C := fun j => IntermediateField.inclusion hLM_C (c j)
    have hsum_E : ∑ j : Fin q, c j • B_E j = toExtendScalars F hLE y := by
      rw [← B_E.equivFun_symm_apply c]
      exact B_E.equivFun.symm_apply_apply (toExtendScalars F hLE y)
    have hterm_coe : ∀ j : Fin q,
        ((c_MC j • B_K j : K_MC') : AlgebraicClosure F) =
          ((c j • B_E j : E') : AlgebraicClosure F) := by
      intro j
      dsimp [B_K, B_E, c_MC, b_K, b_E, ϖ_K]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K,
        coe_basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E]
      rfl
    have hsum_K : ∑ j : Fin q, c_MC j • B_K j =
        toExtendScalars F hM_CK (IntermediateField.inclusion hEK y) := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finset_sum]
      have hsum_E_coe : ((∑ j : Fin q, c j • B_E j : E') : AlgebraicClosure F) = y.1 :=
        congrArg Subtype.val hsum_E
      rw [AddSubmonoidClass.coe_finset_sum] at hsum_E_coe
      calc ∑ j : Fin q, ((c_MC j • B_K j : K_MC') : AlgebraicClosure F)
        _ = ∑ j : Fin q, ((c j • B_E j : E') : AlgebraicClosure F) := by
            apply Finset.sum_congr rfl
            intro j _
            exact hterm_coe j
        _ = y.1 := hsum_E_coe
    rw [← B_K.equivFun_symm_apply c_MC] at hsum_K
    have hfun := congrArg B_K.equivFun hsum_K
    rw [B_K.equivFun.apply_symm_apply c_MC] at hfun
    have hi := congrFun hfun.symm i
    simpa [Module.Basis.equivFun_apply, c_MC, c] using hi

  have hMat_compat : ∀ y : E,
      Algebra.leftMulMatrix B_K (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) =
        (IntermediateField.inclusion hLM_C).toRingHom.mapMatrix
          (Algebra.leftMulMatrix B_E (toExtendScalars F hLE y)) := by
    intro y
    apply Matrix.ext
    intro i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply,
      Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul]
    have hmul_E : toExtendScalars F hLE y * B_E j =
        toExtendScalars F hLE (y * (ϖ_E : E) ^ (j : ℕ)) := by
      dsimp [B_E, b_E]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_E hcard_E, map_mul, map_pow]
    have hmul_K : toExtendScalars F hM_CK (IntermediateField.inclusion hEK y) * B_K j =
        toExtendScalars F hM_CK (IntermediateField.inclusion hEK (y * (ϖ_E : E) ^ (j : ℕ))) := by
      dsimp [B_K]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli_K hcard_K]
      dsimp [b_K]
      rw [hϖ_K_coe, map_mul, map_pow, map_mul, map_pow]
    rw [hmul_E, hmul_K]
    exact hrepr_compat (y * (ϖ_E : E) ^ (j : ℕ)) i

  have htrace_compat : ∀ y : E,
      traceLM F hM_CK (IntermediateField.inclusion hEK y) =
        IntermediateField.inclusion hLM_C (traceLM F hLE y) := by
    intro y
    change Algebra.trace M_C K_MC' (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) =
      IntermediateField.inclusion hLM_C (Algebra.trace L E' (toExtendScalars F hLE y))
    rw [Algebra.trace_eq_matrix_trace B_K, Algebra.trace_eq_matrix_trace B_E, hMat_compat y]
    simp [Matrix.trace, Matrix.diag]

  have hnorm_compat : ∀ y : E,
      normLM F hM_CK (IntermediateField.inclusion hEK y) =
        IntermediateField.inclusion hLM_C (normLM F hLE y) := by
    intro y
    change Algebra.norm M_C (toExtendScalars F hM_CK (IntermediateField.inclusion hEK y)) =
      IntermediateField.inclusion hLM_C (Algebra.norm L (toExtendScalars F hLE y))
    rw [Algebra.norm_eq_matrix_det B_K, Algebra.norm_eq_matrix_det B_E, hMat_compat y]
    exact ((IntermediateField.inclusion hLM_C).toRingHom.map_det _).symm

  exact ⟨hqE, hValNormE, hValAlgE, hResLiftE, fun y => ⟨(htrace_compat y).symm, (hnorm_compat y).symm⟩⟩

theorem ld_ch14_wild_tame_trace_bounds_and_frob_congruence (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hp_prime : Nat.Prime (p F))
    (k : ℕ) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y) :
    (∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z))) ∧
    (∀ (m : ℤ) (w : K),
      (w = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F K w) →
      (traceLM F hEK w = 0 ∨ m ≤ valL F E (traceLM F hEK w))) ∧
    (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F) = 0 ∨
        1 ≤ valL F L (traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F))) :=
by
  have hValProps : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B],
      valL F B 1 = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ (m : ℤ) (x y : B),
        (x = 0 ∨ m ≤ valL F B x) → (y = 0 ∨ m ≤ valL F B y) →
          (x + y = 0 ∨ m ≤ valL F B (x + y))) ∧
      (((p F : ℕ) : B) = 0 ∨ 1 ≤ valL F B ((p F : ℕ) : B)) := by
    intro B _
    have halg : ∀ (F₀ : Type u) [Field F₀] (B₀ : IntermediateField F₀ (AlgebraicClosure F₀))
        [FiniteDimensional F₀ B₀] (z : B₀),
        minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z ∧
        ∃ m : ℕ,
          Algebra.norm F₀ z = ((-1) ^ (minpoly F₀ z).natDegree * (minpoly F₀ z).coeff 0) ^ m ∧
          Module.finrank F₀ B₀ = (minpoly F₀ z).natDegree * m := by
      intro F₀ _ B₀ _ z
      have hmin_coe : minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z :=
        minpoly.algHom_eq B₀.val B₀.val.injective z
      have hz : IsIntegral F₀ z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F₀ z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F₀ pb.gen = minpoly F₀ z := by
        have hval : (IntermediateField.adjoin F₀ {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F₀ {z}).val
          (IntermediateField.adjoin F₀ {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F₀ z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F₀ z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F B 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F B 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : B, x ≠ 0 → y ≠ 0 → relVal F B (x * y) = relVal F B x + relVal F B y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F B (-1) = 0 := by
      have hne : (-1 : B) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F B ((-1 : B) * (-1 : B)) = relVal F B (-1) + relVal F B (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : B) * (-1 : B) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : B, relVal F B (-x) = relVal F B x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : B) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : B) = (-1 : B) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Bˣ, relVal F B ((u⁻¹ : Bˣ) : B) = - relVal F B (u : B) := by
      intro u
      have hmul : relVal F B ((u : B) * ((u⁻¹ : Bˣ) : B)) =
          relVal F B (u : B) + relVal F B ((u⁻¹ : Bˣ) : B) :=
        hrel_mul (u : B) ((u⁻¹ : Bˣ) : B) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Bˣ) (n : ℕ),
        relVal F B (((u ^ n : Bˣ) : B)) = (n : ℤ) * relVal F B (u : B) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Bˣ) (m : ℤ),
        relVal F B (((u ^ m : Bˣ) : B)) = m * relVal F B (u : B) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F B (((u ^ (n : ℤ) : Bˣ) : B)) = (n : ℤ) * relVal F B (u : B)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := fun h0 => hφπ_ne (by simp [h0])
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : B := algebraMap F B π
    have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F B x₀ = (Module.finrank F B : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F B) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F B := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : B, x ≠ 0 ∧ relVal F B x = k}
    have hmem_deg : Module.finrank F B ∈ S := ⟨hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfB_mem : resDeg F B ∈ S := Nat.sInf_mem ⟨Module.finrank F B, hmem_deg⟩
    have hfB_le : resDeg F B ≤ Module.finrank F B := Nat.sInf_le hmem_deg
    obtain ⟨hfB_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfB_mem
    let ϖB : Bˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖB : relVal F B (ϖB : B) = (resDeg F B : ℤ) := hrel_ϖ₀
    have hfB_int_pos : (0 : ℤ) < (resDeg F B : ℤ) := Nat.cast_pos.mpr hfB_pos
    have hfB_int_ne : (resDeg F B : ℤ) ≠ 0 := ne_of_gt hfB_int_pos
    have hdiv : ∀ x : B, relVal F B x = (resDeg F B : ℤ) * valL F B x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F B : ℤ)
        set q_x : ℤ := valL F B x
        set r : ℤ := relVal F B x % f
        have hediv : f * q_x + r = relVal F B x := Int.mul_ediv_add_emod (relVal F B x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F B x) hfB_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F B x) hfB_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : B := x * (((ϖB ^ (-q_x) : Bˣ) : B))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F B y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖB (-q_x), hrel_ϖB]
            linarith
          let k_r : ℕ := r.toNat
          have hk_eq : (k_r : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k_r := by omega
          have hk_lt : k_r < resDeg F B := by omega
          have hk_mem : k_r ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F B ≤ k_r := Nat.sInf_le hk_mem
          omega
        linarith
    have hval1 : valL F B 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfB_int_ne
    have hval_neg : ∀ x : B, valL F B (-x) = valL F B x := by
      intro x
      apply mul_left_cancel₀ hfB_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfB_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_add : ∀ (m : ℤ) (x y : B),
        (x = 0 ∨ m ≤ valL F B x) → (y = 0 ∨ m ≤ valL F B y) →
          (x + y = 0 ∨ m ≤ valL F B (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : B,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F B) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg F B z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : B, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F B z ≤ valL F B w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F B) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F B) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun _ => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfB_int_pos hrel_le
      intro m x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : B) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          exact le_trans (hx.resolve_left hx_ne) hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          exact le_trans (hy.resolve_left hy_ne) hval_y
    have hvalB_alg : ∀ a : F, a ≠ 0 →
        valL F B (algebraMap F B a) =
          ((Module.finrank F B : ℤ) * addVal F a) / (resDeg F B : ℤ) := by
      intro a ha
      unfold valL relVal
      rw [Algebra.norm_algebraMap, haddVal_pow a (Module.finrank F B) ha]
    have halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F B a = 0 ∨ 1 ≤ valL F B (algebraMap F B a)) := by
      intro a ha_opt
      by_cases ha : a = 0
      · left; simp [ha]
      · right
        have ha1 : 1 ≤ addVal F a := ha_opt.resolve_left ha
        rw [hvalB_alg a ha]
        have hfB_leZ : (resDeg F B : ℤ) ≤ (Module.finrank F B : ℤ) := Nat.cast_le.mpr hfB_le
        exact Int.le_ediv_of_mul_le hfB_int_pos (by nlinarith)
    have hp_valB : ((p F : ℕ) : B) = 0 ∨ 1 ≤ valL F B ((p F : ℕ) : B) := by
      have hres0 : IsLocalRing.residue 𝒪[F] ((p F : ℕ) : 𝒪[F]) = 0 :=
        CharP.cast_eq_zero 𝓀[F] (p F)
      have hker : valuation F (((p F : ℕ) : 𝒪[F]) : F) < 1 := by
        rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
      have hpF : ((p F : ℕ) : F) = 0 ∨ 1 ≤ addVal F ((p F : ℕ) : F) := by
        by_cases hp0 : ((p F : ℕ) : F) = 0
        · exact Or.inl hp0
        · right
          have hφp : φ (valuation F ((p F : ℕ) : F)) ≠ 0 :=
            (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
          have hlt : φ (valuation F ((p F : ℕ) : F)) < 1 := by
            rw [← map_one φ, map_lt_map_iff φ]
            exact hker
          rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
            ← Multiplicative.toAdd_lt, toAdd_one] at hlt
          unfold addVal
          rw [dif_neg hp0]
          omega
      have halg_p := halg1 ((p F : ℕ) : F) hpF
      rwa [map_natCast (algebraMap F B) (p F)] at halg_p
    exact ⟨hval1, hval_neg, hval_mul, hval_add, hp_valB⟩

  have hGalLMC : IsGaloisExt F L M_C := hMin.1
  have hSep_iff : ∀ (A B : IntermediateField F (AlgebraicClosure F)) (hAB : A ≤ B),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) ↔
        B ≤ IntermediateField.restrictScalars F (separableClosure A (AlgebraicClosure F)) := by
    intro A B hAB
    let S := IntermediateField.extendScalars hAB
    have hmin : ∀ x : S, IsSeparable A x.1 ↔ IsSeparable A x := by
      intro x
      change (minpoly A (S.val x)).Separable ↔ (minpoly A x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hAB).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable A S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hGalEK : IsGaloisExt F E K := by
    refine ⟨hEK, hGal.2.1, ?_, ?_⟩
    · intro σ hσ τ hτ
      exact hGal.2.2.1 σ (IntermediateField.fixingSubgroup_le hLE hσ) τ hτ
    · intro h
      rw [hSep_iff]
      intro z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      have hzL : IsSeparable L z := by
        have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) hz
        exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
      exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLE)) hzL
  have helper_isGalois : ∀ (k₀ Ω_bar : Type u) [Field k₀] [Field Ω_bar] [Algebra k₀ Ω_bar]
      [Normal k₀ Ω_bar] (K₀ : IntermediateField k₀ Ω_bar) [hSepK₀ : Algebra.IsSeparable k₀ K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k₀] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k₀ K₀ := by
    intro k₀ Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k₀ Ω_bar := separableClosure k₀ Ω_bar
    haveI : IsGalois k₀ N := separableClosure.isGalois k₀ Ω_bar
    haveI : Normal k₀ N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k₀ x := @Algebra.IsSeparable.isSeparable k₀ K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k₀ z = minpoly k₀ x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k₀ z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k₀ N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k₀ K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k₀] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN

  have hGalTraceHelper : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B]
      (hAB : A ≤ B) (hGalAB : IsGaloisExt F A B)
      (hValAlgAB : ∀ x : A, valL F B (IntermediateField.inclusion hAB x) = (k : ℤ) * valL F A x),
      (∀ (m : ℤ) (z : B),
        (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F B z) →
        (traceLM F hAB z = 0 ∨ m ≤ valL F A (traceLM F hAB z))) ∧
      ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → B → B),
        (∀ (σ : G),
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ z₁ z₂ : B,
            act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
            act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
            act σ (-z₁) = -act σ z₁) ∧
          (∀ (z : B) (n : ℕ), act σ (z ^ n) = (act σ z) ^ n)) ∧
        (∀ (σ : G) (z : B), valL F B (act σ z) = valL F B z) ∧
        (∀ z : B, IntermediateField.inclusion hAB (traceLM F hAB z) = ∑ σ : G, act σ z) := by
    intro A B _ _ hAB hGalAB hValAlgAB
    have hvalB_add := (hValProps B).2.2.2.1
    let B' : IntermediateField A (AlgebraicClosure F) := IntermediateField.extendScalars hAB
    let e_B : B ≃ₐ[F] B' :=
      { toExtendScalars F hAB with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hAB).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F B' := Module.Finite.equiv e_B.toLinearEquiv
    haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional A B' := Module.Finite.of_restrictScalars_finite F A B'
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal A (AlgebraicClosure F) := Normal.tower_top_of_normal F A (AlgebraicClosure F)
    haveI : Algebra.IsSeparable A B' := hGalAB.2.2.2 hAB
    have hGalAB' : IsGalois A ↥B' := by
      refine helper_isGalois A (AlgebraicClosure F) B' (fun σ τ hτ => ?_)
      let σ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm σ
      let τ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm τ
      have hτB : τ_F.1 ∈ B.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hAB).mpr hx)
      have hconjB : (σ_F * τ_F * σ_F⁻¹).1 ∈ B.fixingSubgroup :=
        hGalAB.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτB
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjB
      exact hconjB x ((IntermediateField.mem_extendScalars hAB).mp hx)
    haveI : IsGalois A ↥B' := hGalAB'
    let G : Type u := (B' ≃ₐ[A] B')
    let fromExtendScalars : B' →+* B := e_B.symm.toRingHom
    let act : G → B → B := fun σ z => fromExtendScalars (σ (toExtendScalars F hAB z))
    have hact_ring : ∀ (σ : G),
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ z₁ z₂ : B,
          act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
          act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
          act σ (-z₁) = -act σ z₁) ∧
        (∀ (z : B) (n : ℕ), act σ (z ^ n) = (act σ z) ^ n) := by
      intro σ
      refine ⟨by change fromExtendScalars (σ 0) = 0; rw [map_zero, map_zero],
        by change fromExtendScalars (σ 1) = 1; rw [map_one, map_one],
        fun z₁ z₂ => ⟨?_, ?_, ?_⟩, fun z n => ?_⟩
      · change fromExtendScalars (σ (toExtendScalars F hAB z₁ + toExtendScalars F hAB z₂)) = _
        rw [map_add, map_add]
      · change fromExtendScalars (σ (toExtendScalars F hAB z₁ * toExtendScalars F hAB z₂)) = _
        rw [map_mul, map_mul]
      · change fromExtendScalars (σ (-toExtendScalars F hAB z₁)) = _
        rw [map_neg, map_neg]
      · change fromExtendScalars (σ ((toExtendScalars F hAB z) ^ n)) = _
        rw [map_pow, map_pow]
    have hact_val : ∀ (σ : G) (z : B), valL F B (act σ z) = valL F B z := by
      intro σ z
      let φ_σ : B ≃ₐ[F] B := e_B.trans ((σ.restrictScalars F).trans e_B.symm)
      have hφ : φ_σ z = act σ z := rfl
      unfold valL relVal
      rw [← hφ, Algebra.norm_eq_of_algEquiv φ_σ z]
    have hact_trace : ∀ z : B,
        IntermediateField.inclusion hAB (traceLM F hAB z) = ∑ σ : G, act σ z := by
      intro z
      have h1 := congrArg fromExtendScalars
        (trace_eq_sum_automorphisms (K := A) (L := B') (toExtendScalars F hAB z))
      exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hAB z)) Finset.univ)
    have hinj : Function.Injective (IntermediateField.inclusion hAB) :=
      (IntermediateField.inclusion hAB).injective
    have hTrBound : ∀ (m : ℤ) (z : B),
        (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F B z) →
        (traceLM F hAB z = 0 ∨ m ≤ valL F A (traceLM F hAB z)) := by
      intro m z hz
      let b_m : ℤ := (k : ℤ) * m - ((k : ℤ) - 1)
      have hz_act : ∀ σ : G, act σ z = 0 ∨ b_m ≤ valL F B (act σ z) := by
        intro σ
        rcases hz with rfl | hge
        · exact Or.inl (by rw [(hact_ring σ).1])
        · exact Or.inr (by rw [hact_val σ z]; exact hge)
      have h_sum : ∀ S : Finset G,
          (∑ σ ∈ S, act σ z) = 0 ∨ b_m ≤ valL F B (∑ σ ∈ S, act σ z) := by
        intro S
        induction' S using Finset.induction_on with τ S' hτ ih
        · exact Or.inl Finset.sum_empty
        · rw [Finset.sum_insert hτ]
          exact hvalB_add b_m (act τ z) (∑ σ ∈ S', act σ z) (hz_act τ) ih
      have h_univ := h_sum Finset.univ
      rw [← hact_trace z] at h_univ
      rcases h_univ with h0 | hge
      · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hAB) hinj).mp h0)
      · right
        rw [hValAlgAB (traceLM F hAB z)] at hge
        change (k : ℤ) * m - ((k : ℤ) - 1) ≤ (k : ℤ) * valL F A (traceLM F hAB z) at hge
        have hpos : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
        by_contra hlt
        have hle : valL F A (traceLM F hAB z) ≤ m - 1 := by omega
        have hmul_le : (k : ℤ) * valL F A (traceLM F hAB z) ≤ (k : ℤ) * (m - 1) :=
          mul_le_mul_of_nonneg_left hle (by omega)
        linarith
    exact ⟨hTrBound, G, inferInstance, inferInstance, act, hact_ring, hact_val, hact_trace⟩

  obtain ⟨hTrBoundMCL, G_MC, hGrpGMC, hFinGMC, act_MC, hactMC_ring, hactMC_val, hactMC_trace⟩ :=
    hGalTraceHelper L M_C hLM_C hGalLMC hValAlgMCL
  letI : Group G_MC := hGrpGMC
  letI : Fintype G_MC := hFinGMC
  have hTrBoundKE := (hGalTraceHelper E K hEK hGalEK hValAlgKE).1

  obtain ⟨hvalMC1, hvalMC_neg, hvalMC_mul, hvalMC_add, hp_valMC⟩ := hValProps M_C
  let P_MC : ℤ → M_C → Prop := fun m z => z = 0 ∨ m ≤ valL F M_C z
  have hPMC_zero : ∀ m : ℤ, P_MC m 0 := fun _ => Or.inl rfl
  have hPMC_one : P_MC 0 1 := Or.inr (by rw [hvalMC1])
  have hPMC_neg : ∀ (m : ℤ) {z : M_C}, P_MC m z → P_MC m (-z) := by
    intro m z hz
    rcases hz with rfl | hz
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hvalMC_neg]; exact hz)
  have hPMC_add : ∀ (m : ℤ) {z₁ z₂ : M_C}, P_MC m z₁ → P_MC m z₂ → P_MC m (z₁ + z₂) :=
    fun m {z₁ z₂} h1 h2 => hvalMC_add m z₁ z₂ h1 h2
  have hPMC_sub : ∀ (m : ℤ) {z₁ z₂ : M_C}, P_MC m z₁ → P_MC m z₂ → P_MC m (z₁ - z₂) := by
    intro m z₁ z₂ h1 h2
    rw [sub_eq_add_neg]
    exact hPMC_add m h1 (hPMC_neg m h2)
  have hPMC_mul : ∀ {m₁ m₂ : ℤ} {z₁ z₂ : M_C}, P_MC m₁ z₁ → P_MC m₂ z₂ → P_MC (m₁ + m₂) (z₁ * z₂) := by
    intro m₁ m₂ z₁ z₂ h1 h2
    by_cases hz₁ : z₁ = 0
    · exact Or.inl (by rw [hz₁, zero_mul])
    · by_cases hz₂ : z₂ = 0
      · exact Or.inl (by rw [hz₂, mul_zero])
      · right
        rw [hvalMC_mul z₁ z₂ hz₁ hz₂]
        have h1' := h1.resolve_left hz₁
        have h2' := h2.resolve_left hz₂
        omega
  have hPMC_nat : ∀ n : ℕ, P_MC 0 (n : M_C) := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero]; exact hPMC_zero 0
    | succ n ih => rw [Nat.cast_succ]; exact hPMC_add 0 ih hPMC_one
  have hPMC_pow : ∀ {z : M_C}, P_MC 0 z → ∀ n : ℕ, P_MC 0 (z ^ n) := by
    intro z hz n
    induction n with
    | zero => rw [pow_zero]; exact hPMC_one
    | succ n ih =>
      rw [pow_succ]
      have h := hPMC_mul ih hz
      rwa [zero_add] at h
  have hPMC_sum : ∀ (m : ℤ) (S : Finset ℕ) (f : ℕ → M_C),
      (∀ i ∈ S, P_MC m (f i)) → P_MC m (∑ i ∈ S, f i) := by
    intro m S f hS
    induction' S using Finset.induction_on with a s ha ih
    · rw [Finset.sum_empty]; exact hPMC_zero m
    · rw [Finset.sum_insert ha]
      exact hPMC_add m (hS a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
  have hPMC_binom : ∀ {a b : M_C}, P_MC 0 a → P_MC 0 b →
      P_MC 1 ((a + b) ^ (p F) - (a ^ (p F) + b ^ (p F))) := by
    intro a b ha hb
    have hp_ge2 : 2 ≤ p F := hp_prime.two_le
    have hp_eq : p F + 1 = (p F - 1) + 1 + 1 := by omega
    have hp1 : (p F - 1) + 1 = p F := by omega
    have h_expand : (a + b) ^ (p F) - (a ^ (p F) + b ^ (p F)) =
        ∑ j ∈ Finset.range (p F - 1),
          a ^ (j + 1) * b ^ (p F - (j + 1)) * ((p F).choose (j + 1) : M_C) := by
      rw [add_pow a b (p F), hp_eq, Finset.sum_range_succ, Finset.sum_range_succ']
      simp only [hp1, Nat.sub_self, Nat.sub_zero, pow_zero, mul_one, one_mul,
        Nat.choose_self, Nat.choose_zero_right, Nat.cast_one]
      ring
    rw [h_expand]
    refine hPMC_sum 1 (Finset.range (p F - 1)) _ (fun j hj => ?_)
    have hlt : j < p F - 1 := Finset.mem_range.mp hj
    have hdvd : p F ∣ (p F).choose (j + 1) :=
      Nat.Prime.dvd_choose_self hp_prime (by omega) (by omega)
    rcases hdvd with ⟨c, hc⟩
    have hterm_eq : a ^ (j + 1) * b ^ (p F - (j + 1)) * ((p F).choose (j + 1) : M_C) =
        ((p F : ℕ) : M_C) * (a ^ (j + 1) * b ^ (p F - (j + 1)) * (c : M_C)) := by
      rw [hc, Nat.cast_mul]
      ring
    rw [hterm_eq]
    have h_unit : P_MC 0 (a ^ (j + 1) * b ^ (p F - (j + 1)) * (c : M_C)) := by
      have h1 := hPMC_mul (hPMC_pow ha (j + 1)) (hPMC_pow hb (p F - (j + 1)))
      rw [zero_add] at h1
      have h2 := hPMC_mul h1 (hPMC_nat c)
      rwa [zero_add] at h2
    have h_prod := hPMC_mul hp_valMC h_unit
    rwa [add_zero] at h_prod

  have hTrFrobMCL : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F) = 0 ∨
        1 ≤ valL F L (traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F)) := by
    intro z hz
    have hz_act : ∀ σ : G_MC, P_MC 0 (act_MC σ z) := by
      intro σ
      rcases hz with rfl | hge
      · exact Or.inl (by rw [(hactMC_ring σ).1])
      · exact Or.inr (by rw [hactMC_val σ z]; exact hge)
    have h_frob_ind : ∀ S : Finset G_MC,
        P_MC 0 (∑ σ ∈ S, act_MC σ z) ∧
        P_MC 1 ((∑ σ ∈ S, (act_MC σ z) ^ (p F)) - (∑ σ ∈ S, act_MC σ z) ^ (p F)) := by
      intro S
      induction' S using Finset.induction_on with τ S' hτ ih
      · refine ⟨Or.inl Finset.sum_empty, ?_⟩
        rw [Finset.sum_empty, Finset.sum_empty, zero_pow hp_prime.ne_zero, sub_self]
        exact hPMC_zero 1
      · rw [Finset.sum_insert hτ, Finset.sum_insert hτ]
        let a := act_MC τ z
        let b := ∑ σ ∈ S', act_MC σ z
        let B_p := ∑ σ ∈ S', (act_MC σ z) ^ (p F)
        have ha : P_MC 0 a := hz_act τ
        have hb : P_MC 0 b := ih.1
        refine ⟨hPMC_add 0 ha hb, ?_⟩
        have hid : (a ^ (p F) + B_p) - (a + b) ^ (p F) =
            (B_p - b ^ (p F)) - ((a + b) ^ (p F) - (a ^ (p F) + b ^ (p F))) := by ring
        rw [hid]
        exact hPMC_sub 1 ih.2 (hPMC_binom ha hb)
    have h_univ := (h_frob_ind Finset.univ).2
    have h_sum1 : (∑ σ : G_MC, (act_MC σ z) ^ (p F)) =
        IntermediateField.inclusion hLM_C (traceLM F hLM_C (z ^ (p F))) := by
      rw [hactMC_trace (z ^ (p F))]
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact ((hactMC_ring σ).2.2.2 z (p F)).symm
    have h_sum2 : (∑ σ : G_MC, act_MC σ z) ^ (p F) =
        IntermediateField.inclusion hLM_C ((traceLM F hLM_C z) ^ (p F)) := by
      rw [← hactMC_trace z, map_pow]
    let Δ_z : L := traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F)
    have h_diff : (∑ σ : G_MC, (act_MC σ z) ^ (p F)) - (∑ σ : G_MC, act_MC σ z) ^ (p F) =
        IntermediateField.inclusion hLM_C Δ_z := by
      rw [h_sum1, h_sum2, ← map_sub]
    rw [h_diff] at h_univ
    rcases h_univ with h0 | hge
    · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLM_C)
        (IntermediateField.inclusion hLM_C).injective).mp h0)
    · right
      rw [hValAlgMCL Δ_z] at hge
      have hpos : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
      by_contra hlt
      change ¬ (1 ≤ valL F L Δ_z) at hlt
      have hle : valL F L Δ_z ≤ 0 := by omega
      have hmul_le : (k : ℤ) * valL F L Δ_z ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (by omega) hle
      omega

  exact ⟨hTrBoundMCL, hTrBoundKE, hTrFrobMCL⟩

theorem ld_ch14_unramified_orbit_norm_trace_and_degree (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L F_i M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F F_i] [FiniteDimensional F M_C]
    (hLM_C : L ≤ M_C) (hLFi : L ≤ F_i) (hFiMC : F_i ≤ M_C)
    (hGalFiMC : IsGaloisExt F F_i M_C)
    (k : ℕ) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hValAlgFiMC : ∀ x : F_i, valL F M_C (IntermediateField.inclusion hFiMC x) = valL F F_i x) :
    (∀ z : M_C,
      valL F F_i (normLM F hFiMC z) =
        (Module.finrank F_i (IntermediateField.extendScalars hFiMC) : ℤ) * valL F M_C z) ∧
    (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
      (traceLM F hFiMC z = 0 ∨ m ≤ valL F F_i (traceLM F hFiMC z))) ∧
    (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
      normLM F hFiMC (1 + z) - (1 + traceLM F hFiMC z) = 0 ∨
        2 * valL F M_C z ≤
          valL F F_i (normLM F hFiMC (1 + z) - (1 + traceLM F hFiMC z))) ∧
    (∃ f_i : ℕ,
      1 ≤ f_i ∧
      Module.finrank L (IntermediateField.extendScalars hLFi) = k * f_i ∧
      resDeg F F_i = f_i * resDeg F L ∧
      (∀ x : F_i, valL F L (normLM F hLFi x) = (f_i : ℤ) * valL F F_i x)) ∧
    ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → M_C → M_C),
      (∀ z : M_C, act 1 z = z) ∧
      (∀ (σ τ : G) (z : M_C), act (σ * τ) z = act σ (act τ z)) ∧
      (∀ σ : G,
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
          act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
          act σ (-z₁) = -act σ z₁)) ∧
      (∀ (σ : G) (x : F_i),
        act σ (IntermediateField.inclusion hFiMC x) = IntermediateField.inclusion hFiMC x) ∧
      (∀ σ : G, (∀ z : M_C, act σ z = z) → σ = 1) ∧
      (∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z) ∧
      (∀ z : M_C, IntermediateField.inclusion hFiMC (traceLM F hFiMC z) = ∑ σ : G, act σ z) :=
by
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  have h_valL_core : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      0 < resDeg F M ∧
      (∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z) ∧
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (m : ℤ) (x y : M),
        (x = 0 ∨ m ≤ valL F M x) → (y = 0 ∨ m ≤ valL F M y) →
          (x + y = 0 ∨ m ≤ valL F M (x + y))) := by
    intro M _
    have halg : ∀ z : M,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F M = (minpoly F z).natDegree * m := by
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq M.val M.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
