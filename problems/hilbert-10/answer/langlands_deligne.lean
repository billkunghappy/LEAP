        ac_rfl
      rw [h1, ← zpow_add, ← zpow_add, show (1 : ℤ) + -m_y + (m_y - 1) = 0 by omega, zpow_zero, mul_one]
    rw [hy_eq, Φ₁.map_mul (ϖ_E * u), Φ₁.map_zpow, Φ₂.map_mul (ϖ_E * u), Φ₂.map_zpow,
      hΦ_unif (ϖ_E * u) hval_ϖu, hΦ_unif ϖ_E hϖ_E]
  have hrest_mul : restrictWeilChar F hLE (ω_L * χ_ab_L) =
      restrictWeilChar F hLE ω_L * restrictWeilChar F hLE χ_ab_L := by
    apply MonoidHom.ext
    intro w
    rfl
  have hχ'E_rec : ∀ y : Eˣ,
      (χ'.comp (Units.map (normLM F hLE))) y =
        (restrictWeilChar F hLE χL) (rec.recMap E y) := by
    intro y
    rw [MonoidHom.comp_apply, hχ'_apply, hω_L'_norm_E y, ← hΦ₁_apply, hΦ_eq y,
      hΦ₂_apply, hχL_eq, hrest_mul, MonoidHom.mul_apply]
  have hWeil_rest : IsWeilRep F E (charRep F E (restrictWeilChar F hLE χL)) := by
    rcases hχL with ⟨hfin, U, hU, htriv⟩
    refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
    exact htriv (Subgroup.inclusion (relWeil_antitone F hLE) w) hwU hwI
  have hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1 :=
    hWeil_unit_triv E (restrictWeilChar F hLE χL) hWeil_rest
      (χ'.comp (Units.map (normLM F hLE))) hχ'E_rec
  exact ⟨hχ'E_rec, hχ'E_cond⟩

theorem ld_ch13_tame_orbit_mul_char_and_tateEps_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E)
    (hAbMCK : IsAbelianExt F hM_CK)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (χ' : Lˣ →* (Ω F)ˣ)
    (hχ'_rec : ∀ x : Lˣ, χ' x = χL_ext (rec.recMap L x))
    (hχ'E_rec : ∀ y : Eˣ, (χ'.comp (Units.map (normLM F hLE))) y =
      (restrictWeilChar F hLE χL_ext) (rec.recMap E y))
    (hχ'MC_rec : ∀ z : M_Cˣ, (χ'.comp (Units.map (normLM F hLM_C))) z =
      (restrictWeilChar F hLM_C χL_ext) (rec.recMap M_C z))
    (hWeil_unit_triv : ∀ (χ : relWeil F M_C →* (Ω F)ˣ), IsWeilRep F M_C (charRep F M_C χ) →
      ∀ (θ : M_Cˣ →* (Ω F)ˣ), (∀ z : M_Cˣ, θ z = χ (rec.recMap M_C z)) →
        ∀ u ∈ unitGroup F M_C (condExp F M_C θ), θ u = 1)
    (D_orb : List (MonomialTerm F L))
    (μ_orb : Fin D_orb.length → (relWeil F M_C →* (Ω F)ˣ))
    (hμ_props : ∀ i : Fin D_orb.length,
      IsWeilRep F M_C (charRep F M_C (μ_orb i)) ∧
      restrictWeilChar F hM_CK (μ_orb i) = 1 ∧
      (μ_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      μ_orb i ≠ 1)
    (hμ_kerK : ∀ i : Fin D_orb.length, ∀ w : relWeil F M_C,
      (w : AbsGal F) ∈ K.fixingSubgroup ↔ (μ_orb i) w = 1)
    (hμ_orb_sum : ∀ w : relWeil F M_C,
      1 + (∑ i : Fin D_orb.length,
        ∑ c ∈ (Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
          (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
            (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1),
          (((μ_orb i) ^ c) w : Ω F)) =
        if (w : AbsGal F) ∈ K.fixingSubgroup then
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : Ω F)
        else 0)
    (heval_untwist : evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
      tateEpsUnit F L (recChar F rec L 1) ψ *
        (∏ i : Fin D_orb.length,
          tateEpsUnit F M_C (recChar F rec M_C (μ_orb i)) (traceChar F hLM_C ψ)))
    (heval_twist : evalMonomialList F rec (fun _ _ _ => 1) L ψ
        ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext)) =
      tateEpsUnit F L (recChar F rec L χL_ext) ψ *
        (∏ i : Fin D_orb.length,
          tateEpsUnit F M_C
            (recChar F rec M_C (μ_orb i * restrictWeilChar F hLM_C χL_ext))
            (traceChar F hLM_C ψ))) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    let r := D_orb.length
    ∃ ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ),
      (∀ i : Fin r,
        (ν_orb i) ^ ℓ = 1 ∧
        ν_orb i ≠ 1 ∧
        (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
        (∀ k < ℓ, ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)),
          ((ν_orb i) ^ k) u = 1) ∧
        (∀ k < ℓ, ∀ u ∈ unitGroup F M_C
            (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
          ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1)) ∧
      (∀ (ν₀ : M_Cˣ →* (Ω F)ˣ),
        ν₀ ^ ℓ = 1 → ν₀ ≠ 1 →
        (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1) →
        ∀ z : M_Cˣ,
          1 + (∑ i : Fin r,
            ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
              (((ν_orb i) ^ c) z : Ω F)) =
            ∑ j ∈ Finset.range ℓ, ((ν₀ ^ j) z : Ω F)) ∧
      (tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
          tateEps F L 1 ψ *
          (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
        tateEps F E 1 (traceChar F hLE ψ) *
          tateEps F L χ' ψ *
          (∏ i : Fin r,
            tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
              (traceChar F hLM_C ψ)) →
        tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
        tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ
            ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) :=
by
  set ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  set f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
  let r := D_orb.length
  have hWeil_one : ∀ (L' : IntermediateField F (AlgebraicClosure F)),
      IsWeilRep F L' (charRep F L' 1) := by
    intro L'
    refine ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ _ => ?_⟩
    apply LinearMap.ext
    intro v
    change ((1 : relWeil F L' →* (Ω F)ˣ) w : Ω F) • v = v
    rw [MonoidHom.one_apply, Units.val_one, one_smul]
  have hcharRep_mul : ∀ (χ₁ χ₂ : relWeil F M_C →* (Ω F)ˣ) (w : relWeil F M_C),
      charRep F M_C (χ₁ * χ₂) w = charRep F M_C χ₁ w * charRep F M_C χ₂ w := by
    intro χ₁ χ₂ w
    apply LinearMap.ext
    intro v
    change ((χ₁ * χ₂) w : Ω F) • v = (χ₁ w : Ω F) • ((χ₂ w : Ω F) • v)
    rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
  have hWeil_mul : ∀ {χ₁ χ₂ : relWeil F M_C →* (Ω F)ˣ},
      IsWeilRep F M_C (charRep F M_C χ₁) → IsWeilRep F M_C (charRep F M_C χ₂) →
      IsWeilRep F M_C (charRep F M_C (χ₁ * χ₂)) := by
    rintro χ₁ χ₂ ⟨hfin, U₁, hU₁, htriv₁⟩ ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    rw [hcharRep_mul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  have hWeil_pow : ∀ (i : Fin r) (k : ℕ),
      IsWeilRep F M_C (charRep F M_C ((μ_orb i) ^ k)) := by
    intro i k
    induction' k with k ih
    · have h0 : (μ_orb i) ^ (0 : ℕ) = 1 := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_zero, MonoidHom.one_apply]
      rw [h0]
      exact hWeil_one M_C
    · have hsucc : (μ_orb i) ^ (k + 1) = (μ_orb i) ^ k * (μ_orb i) := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_succ, MonoidHom.mul_apply, MonoidHom.pow_apply]
      rw [hsucc]
      exact hWeil_mul ih (hμ_props i).1
  have hWeil_rest : ∀ (M' : IntermediateField F (AlgebraicClosure F)) (hLM' : L ≤ M'),
      IsWeilRep F M' (charRep F M' (restrictWeilChar F hLM' χL_ext)) := by
    intro M' hLM'
    rcases hχL_ext with ⟨hfin, U, hU, htriv⟩
    refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
    exact htriv (Subgroup.inclusion (relWeil_antitone F hLM') w) hwU hwI
  have h_ker_norm : ∀ z : M_Cˣ,
      (rec.recMap M_C z : AbsGal F) ∈ K.fixingSubgroup ↔
        z ∈ Set.range (Units.map (normLM F hM_CK)) := by
    intro z
    rw [rec.ker_rec M_C K hM_CK hAbMCK z]
    refine ⟨?_, ?_⟩
    · rintro ⟨y, hy⟩
      haveI : Module.Finite M_C (IntermediateField.extendScalars hM_CK) :=
        Module.finite_of_finrank_pos hPrime_MCK.pos
      have hy_ne : y ≠ 0 := by
        intro h0
        have hnorm0 : normLM F hM_CK y = 0 := by
          rw [h0]
          exact Algebra.norm_zero (R := M_C) (S := IntermediateField.extendScalars hM_CK)
        rw [hnorm0] at hy
        exact Units.ne_zero z hy.symm
      exact ⟨Units.mk0 y hy_ne, Units.ext hy⟩
    · rintro ⟨y, rfl⟩
      exact ⟨(y : K), rfl⟩
  have hμ_rec_mul : ∀ (i : Fin r) (z₁ z₂ : M_Cˣ),
      (μ_orb i) (rec.recMap M_C (z₁ * z₂)) =
        (μ_orb i) (rec.recMap M_C z₁) * (μ_orb i) (rec.recMap M_C z₂) := by
    intro i z₁ z₂
    have hmem := rec.mul_rec M_C K hM_CK hAbMCK z₁ z₂
    have htriv := (hμ_kerK i ((rec.recMap M_C (z₁ * z₂))⁻¹ *
      (rec.recMap M_C z₁ * rec.recMap M_C z₂))).mp hmem
    rw [map_mul, map_inv, map_mul, inv_mul_eq_one] at htriv
    exact htriv
  have hμ_rec_one : ∀ (i : Fin r), (μ_orb i) (rec.recMap M_C 1) = 1 := by
    intro i
    have h1 := hμ_rec_mul i 1 1
    rw [mul_one] at h1
    simpa using congrArg (fun u => ((μ_orb i) (rec.recMap M_C 1))⁻¹ * u) h1.symm
  let ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ) := fun i =>
    { toFun := fun z => (μ_orb i) (rec.recMap M_C z)
      map_one' := hμ_rec_one i
      map_mul' := hμ_rec_mul i }
  have hν_apply : ∀ (i : Fin r) (z : M_Cˣ),
      (ν_orb i) z = (μ_orb i) (rec.recMap M_C z) := fun _ _ => rfl
  have hν_pow_rec : ∀ (i : Fin r) (k : ℕ) (z : M_Cˣ),
      ((ν_orb i) ^ k) z = ((μ_orb i) ^ k) (rec.recMap M_C z) := by
    intro i k z
    rw [MonoidHom.pow_apply, MonoidHom.pow_apply, hν_apply]
  have hν_twist_rec : ∀ (i : Fin r) (k : ℕ) (z : M_Cˣ),
      ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) z =
        ((μ_orb i) ^ k * restrictWeilChar F hLM_C χL_ext) (rec.recMap M_C z) := by
    intro i k z
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hν_pow_rec i k z, hχ'MC_rec z]
  have hν_props : ∀ i : Fin r,
      (ν_orb i) ^ ℓ = 1 ∧
      ν_orb i ≠ 1 ∧
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
      (∀ k < ℓ, ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)),
        ((ν_orb i) ^ k) u = 1) ∧
      (∀ k < ℓ, ∀ u ∈ unitGroup F M_C
          (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
        ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1) := by
    intro i
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · apply MonoidHom.ext
      intro z
      rw [hν_pow_rec i ℓ z, (hμ_props i).2.2.1, MonoidHom.one_apply, MonoidHom.one_apply]
    · intro h1
      apply (hμ_props i).2.2.2
      apply MonoidHom.ext
      intro w
      obtain ⟨z, hz⟩ := rec.surj_rec M_C K hM_CK hAbMCK w
      have htriv := (hμ_kerK i ((rec.recMap M_C z)⁻¹ * w)).mp hz
      rw [map_mul, map_inv, inv_mul_eq_one] at htriv
      have hz1 : (ν_orb i) z = 1 := by
        rw [h1, MonoidHom.one_apply]
      rw [hν_apply i z] at hz1
      rw [← htriv, hz1, MonoidHom.one_apply]
    · intro z
      rw [← h_ker_norm z, hμ_kerK i (rec.recMap M_C z), hν_apply i z]
    · intro k _
      exact hWeil_unit_triv ((μ_orb i) ^ k) (hWeil_pow i k)
        ((ν_orb i) ^ k) (hν_pow_rec i k)
    · intro k _
      exact hWeil_unit_triv ((μ_orb i) ^ k * restrictWeilChar F hLM_C χL_ext)
        (hWeil_mul (hWeil_pow i k) (hWeil_rest M_C hLM_C))
        ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))
        (hν_twist_rec i k)
  have hν_orb_sum : ∀ (ν₀ : M_Cˣ →* (Ω F)ˣ),
      ν₀ ^ ℓ = 1 → ν₀ ≠ 1 →
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1) →
      ∀ z : M_Cˣ,
        1 + (∑ i : Fin r,
          ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
            (((ν_orb i) ^ c) z : Ω F)) =
          ∑ j ∈ Finset.range ℓ, ((ν₀ ^ j) z : Ω F) := by
    intro ν₀ hν₀_pow _ hν₀_ker z
    have h_lhs_eq : (∑ i : Fin r,
        ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
          (((ν_orb i) ^ c) z : Ω F)) =
        ∑ i : Fin r,
          ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
            (((μ_orb i) ^ c) (rec.recMap M_C z) : Ω F) := by
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro c _
      exact congrArg Units.val (hν_pow_rec i c z)
    rw [h_lhs_eq, hμ_orb_sum (rec.recMap M_C z)]
    have h_iff : (rec.recMap M_C z : AbsGal F) ∈ K.fixingSubgroup ↔ ν₀ z = 1 :=
      (h_ker_norm z).trans (hν₀_ker z)
    have h_rhs_pow : (∑ j ∈ Finset.range ℓ, ((ν₀ ^ j) z : Ω F)) =
        ∑ j ∈ Finset.range ℓ, (ν₀ z : Ω F) ^ j := by
      apply Finset.sum_congr rfl
      intro j _
      rw [MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
    rw [h_rhs_pow]
    by_cases h1 : ν₀ z = 1
    · rw [if_pos (h_iff.mpr h1), h1, Units.val_one]
      simp
    · rw [if_neg (mt h_iff.mp h1)]
      have hx_ne1 : (ν₀ z : Ω F) ≠ 1 := by
        intro hx1
        exact h1 (Units.ext hx1)
      have hx_pow : (ν₀ z : Ω F) ^ ℓ = 1 := by
        rw [← Units.val_pow_eq_pow_val, ← MonoidHom.pow_apply, hν₀_pow,
          MonoidHom.one_apply, Units.val_one]
      rw [geom_sum_eq hx_ne1 ℓ, hx_pow, sub_self, zero_div]
  obtain ⟨_, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  have h_unit_prod : ∀ (s : Finset (Fin r)) (g : Fin r → (Ω F)ˣ),
      ((∏ i ∈ s, g i : (Ω F)ˣ) : Ω F) = ∏ i ∈ s, (g i : Ω F) := by
    intro s g
    induction' s using Finset.cons_induction with a s ha ih
    · rfl
    · rw [Finset.prod_cons, Finset.prod_cons, Units.val_mul, ih]
  have hRed :
      tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
          tateEps F L 1 ψ *
          (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
        tateEps F E 1 (traceChar F hLE ψ) *
          tateEps F L χ' ψ *
          (∏ i : Fin r,
            tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
              (traceChar F hLM_C ψ)) →
        tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
        tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ
            ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext)) := by
    intro hEps_eq
    rw [heval_untwist, heval_twist]
    have heps_E_χ : (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext))
        (traceChar F hLE ψ) : Ω F) =
        tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) :=
      (htateEps E (traceChar F hLE ψ) hψE (restrictWeilChar F hLE χL_ext)
        (hWeil_rest E hLE) (χ'.comp (Units.map (normLM F hLE))) hχ'E_rec).2
    have heps_E_1 : (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) : Ω F) =
        tateEps F E 1 (traceChar F hLE ψ) :=
      (htateEps E (traceChar F hLE ψ) hψE 1 (hWeil_one E) 1 (fun _ => rfl)).2
    have heps_L_1 : (tateEpsUnit F L (recChar F rec L 1) ψ : Ω F) =
        tateEps F L 1 ψ :=
      (htateEps L ψ hψ 1 (hWeil_one L) 1 (fun _ => rfl)).2
    have heps_L_χ : (tateEpsUnit F L (recChar F rec L χL_ext) ψ : Ω F) =
        tateEps F L χ' ψ :=
      (htateEps L ψ hψ χL_ext hχL_ext χ' hχ'_rec).2
    have heps_MC_μ : (∏ i : Fin r,
        (tateEpsUnit F M_C (recChar F rec M_C (μ_orb i)) (traceChar F hLM_C ψ) : Ω F)) =
        ∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ) :=
      Finset.prod_congr rfl fun i _ =>
        (htateEps M_C (traceChar F hLM_C ψ) hψMC (μ_orb i) (hμ_props i).1
          (ν_orb i) (hν_apply i)).2
    have hν_twist1_rec : ∀ (i : Fin r) (z : M_Cˣ),
        (ν_orb i * χ'.comp (Units.map (normLM F hLM_C))) z =
          (μ_orb i * restrictWeilChar F hLM_C χL_ext) (rec.recMap M_C z) := by
      intro i z
      rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hν_apply i z, hχ'MC_rec z]
    have heps_MC_twist : (∏ i : Fin r,
        (tateEpsUnit F M_C
          (recChar F rec M_C (μ_orb i * restrictWeilChar F hLM_C χL_ext))
          (traceChar F hLM_C ψ) : Ω F)) =
        ∏ i : Fin r,
          tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
            (traceChar F hLM_C ψ) :=
      Finset.prod_congr rfl fun i _ =>
        (htateEps M_C (traceChar F hLM_C ψ) hψMC
          (μ_orb i * restrictWeilChar F hLM_C χL_ext)
          (hWeil_mul (hμ_props i).1 (hWeil_rest M_C hLM_C))
          (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
          (hν_twist1_rec i)).2
    apply Units.ext
    rw [Units.val_mul, Units.val_mul, h_unit_prod,
      Units.val_mul, Units.val_mul, h_unit_prod,
      heps_E_χ, heps_E_1, heps_L_1, heps_L_χ, heps_MC_μ, heps_MC_twist,
      ← mul_assoc, ← mul_assoc]
    exact hEps_eq
  exact ⟨ν_orb, hν_props, hν_orb_sum, hRed⟩

theorem ld_ch13_tame_orbit_recChar_and_tower_structure (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      t.field = M_C ∧
      t.χ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1)) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    let r := D_orb.length
    FiniteDimensional F L ∧
    FiniteDimensional F M_C ∧
    FiniteDimensional F E ∧
    FiniteDimensional F K ∧
    IsGaloisExt F M_C K ∧
    IsAbelianExt F hLM_C ∧
    Algebra.IsSeparable L (IntermediateField.extendScalars hLE) ∧
    (∀ σ ∈ L.fixingSubgroup,
      (∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) →
      σ ∈ M_C.fixingSubgroup) ∧
    IsAdmissibleChar F M_C (traceChar F hLM_C ψ) ∧
    IsAdmissibleChar F E (traceChar F hLE ψ) ∧
    IsAdmissibleChar F K (traceChar F hLK ψ) ∧
    1 < f_H ∧
    ℓ ≠ 2 ∧
    1 ≤ r ∧
    r * f_H = ℓ - 1 ∧
    ((Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1)).card = f_H ∧
    ∃ (χ' : Lˣ →* (Ω F)ˣ) (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ)),
      (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
      (∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
        (χ'.comp (Units.map (normLM F hLE))) u = 1) ∧
      (∀ u ∈ unitGroup F M_C (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C)))),
        (χ'.comp (Units.map (normLM F hLM_C))) u = 1) ∧
      (∀ i : Fin r,
        (ν_orb i) ^ ℓ = 1 ∧
        ν_orb i ≠ 1 ∧
        (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
        (∀ k < ℓ, ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)),
          ((ν_orb i) ^ k) u = 1) ∧
        (∀ k < ℓ, ∀ u ∈ unitGroup F M_C
            (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
          ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1)) ∧
      (∀ (ν₀ : M_Cˣ →* (Ω F)ˣ),
        ν₀ ^ ℓ = 1 → ν₀ ≠ 1 →
        (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1) →
        ∀ z : M_Cˣ,
          1 + (∑ i : Fin r,
            ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
              (((ν_orb i) ^ c) z : Ω F)) =
            ∑ j ∈ Finset.range ℓ, ((ν₀ ^ j) z : Ω F)) ∧
      (tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
          tateEps F L 1 ψ *
          (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
        tateEps F E 1 (traceChar F hLE ψ) *
          tateEps F L χ' ψ *
          (∏ i : Fin r,
            tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
              (traceChar F hLM_C ψ)) →
        tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
        tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ
            ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) :=
by
  obtain ⟨hFinL, hFinMC, hFinE, hFinK, hGalMCK, hSepLMC, hSepLE,
      hψMC, hψE, hψK, hf_H_gt1, hOdd_ℓ, hr_pos, hr_mul,
      μ_orb, hμ_props, htrace_eq, heval_untwist, heval_twist⟩ :=
    ld_ch13_tame_monomial_orbit_to_weil_chars F rec L K M_C E
      hLK hLM_C hM_CK hLE hEK hLM_C_lt hGal ψ hψ hPrime_MCK χL_ext
      D_orb hD₁_sub hD_orb_deg hD_orb_props
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F M_C := hFinMC
  haveI : FiniteDimensional F E := hFinE
  haveI : FiniteDimensional F K := hFinK
  obtain ⟨hAbLMC, hCentralizer, hcard_Hf, hμ_kerK, hμ_orb_sum⟩ :=
    ld_ch13_tame_galois_orbit_sum_and_centralizer F L K M_C E
      hLK hLM_C hM_CK hLE hEK h_inf h_sup hGal hMin hPrime_MCK
      hf_H_gt1 D_orb.length hr_pos hr_mul μ_orb hμ_props htrace_eq
  obtain ⟨hWeil_unit_triv_all, hSepRec_all⟩ := ld_separable_weil_char_rec_and_norm F rec
  obtain ⟨χ', hχ'_rec, hχ'_cond, hχ'_sep⟩ := hSepRec_all L χL_ext hχL_ext
  obtain ⟨hχ'E_rec, hχ'E_cond⟩ := hχ'_sep E hLE hSepLE
  obtain ⟨hχ'MC_rec, hχ'MC_cond⟩ := hχ'_sep M_C hLM_C hSepLMC
  obtain ⟨ν_orb, hν_props, hν_orb_sum, hRed⟩ :=
    ld_ch13_tame_orbit_mul_char_and_tateEps_reduction F rec L K M_C E
      hLM_C hM_CK hLE hMin.2.1 hPrime_MCK ψ hψ hψMC hψE
      χL_ext hχL_ext χ' hχ'_rec hχ'E_rec hχ'MC_rec
      (hWeil_unit_triv_all M_C) D_orb μ_orb hμ_props hμ_kerK hμ_orb_sum
      heval_untwist heval_twist
  exact ⟨hFinL, hFinMC, hFinE, hFinK, hGalMCK, hAbLMC, hSepLE, hCentralizer,
    hψMC, hψE, hψK, hf_H_gt1, hOdd_ℓ, hr_pos, hr_mul, hcard_Hf,
    ⟨χ', ν_orb, hχ'_cond, hχ'E_cond, hχ'MC_cond, hν_props, hν_orb_sum, hRed⟩⟩

theorem ld_ch13_tame_mc_cond_ne_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hCentralizer : ∀ σ ∈ L.fixingSubgroup,
      (∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) →
      σ ∈ M_C.fixingSubgroup)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (ν₀ : M_Cˣ →* (Ω F)ˣ)
    (hν₀_pow : ν₀ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1)
    (hν₀_ne : ν₀ ≠ 1)
    (hν₀_ker : ∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1)
    (hν₀_cond : ∀ u ∈ unitGroup F M_C (condExp F M_C ν₀), ν₀ u = 1)
    (haddVal1 : addVal F 1 = 0)
    (haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalMC_props : valL F M_C 0 = 0 ∧ valL F M_C 1 = 0 ∧ valL F M_C (-1) = 0 ∧
      (∀ x : M_C, valL F M_C (-x) = valL F M_C x) ∧
      (∀ x y : M_C, x ≠ 0 → y ≠ 0 → valL F M_C (x * y) = valL F M_C x + valL F M_C y) ∧
      (∀ u : M_Cˣ, valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = - valL F M_C (u : M_C)) ∧
      (∀ m : ℤ, ∃ c : M_Cˣ, valL F M_C (c : M_C) = m) ∧
      (∀ (k : ℤ) (x y : M_C),
        (x = 0 ∨ k ≤ valL F M_C x) → (y = 0 ∨ k ≤ valL F M_C y) →
          (x + y = 0 ∨ k ≤ valL F M_C (x + y))) ∧
      (∀ u : M_Cˣ, u ∈ unitGroup F M_C 0 ↔ valL F M_C (u : M_C) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M_Cˣ,
        u ∈ unitGroup F M_C a ↔ ((u : M_C) = 1 ∨ (a : ℤ) ≤ valL F M_C ((u : M_C) - 1))) ∧
      (∀ (a : ℕ) (u : M_Cˣ), u ∈ unitGroup F M_C a → valL F M_C (u : M_C) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (k_K : Type u) [Field k_K] [Fintype k_K] (resK : K → k_K)
    (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (hresK_surj : ∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b)
    (hInertiaTriv : (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = valL F M_C z) →
      ∀ (G : Type u) [Group G] (act : G → K → K),
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ y₁ y₂ : K,
            act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
            act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
            act σ (-y₁) = -act σ y₁)) →
        (∀ (σ : G) (z : M_C),
          act σ (IntermediateField.inclusion hM_CK z) = IntermediateField.inclusion hM_CK z) →
        (∀ σ : G, (∀ y : K, act σ y = y) → σ = 1) →
        (∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y) →
        ∀ (σ : G), (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → resK (act σ y) = resK y) → σ = 1) :
    condExp F M_C ν₀ ≠ 0 :=
by
  
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (E' : IntermediateField k Ω_bar) [hSepE' : Algebra.IsSeparable k E'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ E', τ x = x) → ∀ x ∈ E', (σ * τ * σ⁻¹) x = x) →
      IsGalois k E' := by
    clear! F k_K
    intro k Ω_bar _ _ _ _ E' hSepE' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hE'N : E' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : E' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k E' _ _ _ hSepE' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq E'.val E'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let E_N : IntermediateField k N := E'.comap N.val
    have hEN_map : E_N.map N.val = E' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hE'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hEN_norm : E_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ E', τ x = x := by
        intro x hx
        let z : N := ⟨x, hE'N hx⟩
        have hz : AlgEquiv.restrictNormalHom N τ z = z := hh z hx
        have h1 : ((AlgEquiv.restrictNormalHom N τ z : N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : E_N.fixingSubgroup.Normal := hEN_norm
    haveI : IsGalois k E_N := (InfiniteGalois.normal_iff_isGalois E_N).mp hEN_norm
    let e_EN : ↥E_N ≃ₐ[k] ↥E' := (E_N.equivMap N.val).trans (IntermediateField.equivOfEq hEN_map)
    exact IsGalois.of_algEquiv e_EN
  intro hUnram
  
  have hval_alg_MCK : ∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = valL F M_C z := by
    clear! k_K hGal hGalMCK hMin hCentralizer hf_H_gt1 hvalL_props helper_isGalois
    obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC, hval_surj_MC,
      hval_add_MC, hunit0_MC, hunit_ge1_MC, hunit_val0_MC⟩ := hvalMC_props
    obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_surj_K,
      hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := hvalK_props
    have haddVal0 : addVal F 0 = 0 := dif_pos rfl
    have hval_pow_MC : ∀ (x : M_C) (n : ℕ), x ≠ 0 → valL F M_C (x ^ n) = (n : ℤ) * valL F M_C x := by
      intro x n hx
      induction n with
      | zero => simp [hval1_MC]
      | succ n ih =>
        rw [pow_succ, hval_mul_MC (x ^ n) x (pow_ne_zero n hx) hx, ih]
        push_cast
        ring
    have hval_zpow_MC : ∀ (u : M_Cˣ) (m : ℤ),
        valL F M_C (((u ^ m : M_Cˣ) : M_C)) = m * valL F M_C (u : M_C) := by
      intro u m
      cases m with
      | ofNat n =>
        change valL F M_C (((u ^ (n : ℤ) : M_Cˣ) : M_C)) = (n : ℤ) * valL F M_C (u : M_C)
        rw [zpow_natCast, Units.val_pow_eq_pow_val, hval_pow_MC (u : M_C) n (Units.ne_zero u)]
      | negSucc n =>
        rw [zpow_negSucc, hval_inv_MC (u ^ (n + 1)), Units.val_pow_eq_pow_val,
          hval_pow_MC (u : M_C) (n + 1) (Units.ne_zero u), Int.negSucc_eq]
        push_cast
        ring
    have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
        (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
        0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
      intro M _ hsurj
      have hrel0 : relVal F M 0 = 0 := by
        unfold relVal
        rw [Algebra.norm_zero, haddVal0]
      have hrel1 : relVal F M 1 = 0 := by
        unfold relVal
        rw [map_one, haddVal1]
      have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
        intro x y hx hy
        unfold relVal
        rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
      have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
        intro u
        have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
        rw [Units.mul_inv, hrel1] at hmul
        omega
      have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
          relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
        intro u n
        induction n with
        | zero => simp [hrel1]
        | succ n ih =>
          rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
          push_cast
          ring
      have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
          relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
        intro u m
        cases m with
        | ofNat n =>
          change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
          rw [zpow_natCast, hrel_pow]
        | negSucc n =>
          rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
          push_cast
          ring
      let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
      have hres_ne : resDeg F M ≠ 0 := by
        intro h0
        obtain ⟨c₁, hc₁⟩ := hsurj 1
        unfold valL at hc₁
        rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
