            2 * traceLM F hM₁'K₁ w * normLM F hM₁'K₁ w +
            ∑ r ∈ Finset.Icc 3 (p - 1),
              2 * (-1 : M₁') ^ (r - 1) * ((r : ℕ) : M₁')⁻¹ * traceLM F hM₁'K₁ (w ^ r)) = 0 ∨
          (m₁ : ℤ) ≤
            valL F M₁'
              (Q2_1 w -
                (2 * (traceLM F hM₁'K₁ w + normLM F hM₁'K₁ w) -
                  (traceLM F hM₁'K₁ (w ^ 2) + normLM F hM₁'K₁ (w ^ 2)) -
                  2 * traceLM F hM₁'K₁ w * normLM F hM₁'K₁ w +
                  ∑ r ∈ Finset.Icc 3 (p - 1),
                    2 * (-1 : M₁') ^ (r - 1) * ((r : ℕ) : M₁')⁻¹ * traceLM F hM₁'K₁ (w ^ r))) := by
    intro Q2_1 w hw
