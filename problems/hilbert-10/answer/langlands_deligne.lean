        intro i
        rcases Nat.eq_zero_or_pos (i : ℕ) with hi0 | hi_pos
        · have hih_0 := ih (by omega) θ Y hθY i
          refine val_mono_E' ?_ hih_0
          have hmin0 : min ((i : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) = min ((i : ℕ) : ℤ) (m : ℤ) := by omega
          rw [hmin0]
        · have hi_lt : (i : ℕ) < p := i.isLt
          set d : ℕ := p - 1 - (i : ℕ)
          have hd_le : d ≤ p - 2 := by omega
          have h_in := hInner d hd_le
          have hj_eq : (⟨p - 2 - d + 1, by omega⟩ : Fin p) = i := by
            ext
            dsimp [d]
            omega
          have h_in_i : Y i = 0 ∨
              v + min ((p - 2 - d + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) := by
            rw [← hj_eq]
            exact h_in
          refine val_mono_E' ?_ h_in_i
          have hmin_d : min ((i : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) =
              min ((p - 2 - d + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) := by
            dsimp [d]
            omega
          rw [hmin_d]
  
  intro θ Y hθY i
  have h_out := hOuter (p - 1) le_rfl θ Y hθY i
  refine val_mono_E' ?_ h_out
  have hmin_eq : min ((i : ℕ) : ℤ) ((p - 1 : ℕ) : ℤ) = ((i : ℕ) : ℤ) := by
    have hi_lt : (i : ℕ) < p := i.isLt
    omega
  rw [hmin_eq]

theorem ld_wild_odd_bicyclic_upper_triangular_as_basis_val_bound (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (ϖ_M₁' : M₁'ˣ) (hϖ_M₁' : valL F M₁' (ϖ_M₁' : M₁') = 1)
    (hBasis_M₁' : ∀ z : M₁',
      ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → L,
        z = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hLM₁' (c i) * ((ϖ_M₁' : M₁') ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (z = 0 ∨ m ≤ valL F M₁' z) ↔
            ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
              c i = 0 ∨
                m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                  valL F L (c i) + (i : ℤ))
    (G_M₁' : Type u) [Group G_M₁'] [Fintype G_M₁'] (act_M₁' : G_M₁' → M₁' → M₁')
    (hcard_GM₁' : Fintype.card G_M₁' = Module.finrank L (IntermediateField.extendScalars hLE'))
    (hactM₁'_one : ∀ z : M₁', act_M₁' 1 z = z)
    (hactM₁'_mul : ∀ (σ τ : G_M₁') (z : M₁'), act_M₁' (σ * τ) z = act_M₁' σ (act_M₁' τ z))
    (hactM₁'_ring : ∀ σ : G_M₁',
      act_M₁' σ 0 = 0 ∧ act_M₁' σ 1 = 1 ∧
      (∀ z₁ z₂ : M₁',
        act_M₁' σ (z₁ + z₂) = act_M₁' σ z₁ + act_M₁' σ z₂ ∧
        act_M₁' σ (z₁ * z₂) = act_M₁' σ z₁ * act_M₁' σ z₂ ∧
        act_M₁' σ (-z₁) = -act_M₁' σ z₁))
    (hactM₁'_incl : ∀ (σ : G_M₁') (x : L),
      act_M₁' σ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hjump_M₁' : ∀ τ : G_M₁', τ ≠ 1 →
      (ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁') ≠ 0 ∧
      valL F M₁' ((ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁')) = (bM₁' : ℤ))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as_t₂ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    ∀ (θ : M₁') (Y : Fin p → E'),
      IntermediateField.inclusion hM₁'K₁ θ =
        ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
      ∀ i : Fin p,
        Y i = 0 ∨
          valL F M₁' θ + (i : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) :=
by
  intro p t₁
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht_le : t₁ ≤ bE' - 1 := by dsimp [t₁]; omega
  obtain ⟨τ, τ_lift, hτ_E', hτ_M₁', hτ_valK₁, hτ_shift_M₁', hϖ_jump⟩ :=
    ld_wild_odd_bicyclic_galois_lift_and_jump_shift_on_M1 F L E' M₁' K₁
      hLM₁' hE'K₁ hM₁'K₁ p hPrime bM₁' hbM₁'_ge2
      hvalM₁'_props hval_LM₁' hval_M₁'K₁ hGalLift
      ϖ_M₁' hϖ_M₁' hBasis_M₁'
      G_M₁' act_M₁' hcard_GM₁' hactM₁'_one hactM₁'_mul hactM₁'_ring hactM₁'_incl hjump_M₁'
  obtain ⟨hval_sum_iff, hcoprime_E', D₀, δ_plus, hτ_Δ, hD₀_ne0, hD₀_val, hδ_plus⟩ :=
    ld_wild_odd_bicyclic_as_aut_shift_unit_and_rem_bound F E' M₁' K₁
      hE'K₁ hM₁'K₁ p hPrime hp_odd t₁ (bE' - 1) ht₁_ge1 ht_le ht₁_ndvd hp_valK₁
      hvalE'_props hvalM₁'_props hvalK₁_props hval_E'K₁ hval_M₁'K₁
      τ τ_lift hτ_E' hτ_M₁' hτ_valK₁
      (ϖ_M₁' : M₁') hϖ_M₁' hϖ_jump
      Δ hΔ_val hΔ_as_t₂ hΔ_basis
  exact ld_wild_odd_bicyclic_upper_triangular_back_substitution F E' M₁' K₁
    hE'K₁ hM₁'K₁ p hPrime hp_odd t₁ ht₁_ge1
    hvalE'_props hvalM₁'_props hvalK₁_props hval_E'K₁ hval_M₁'K₁
    τ τ_lift hτ_E' hτ_M₁' hτ_shift_M₁'
    Δ hΔ_val hΔ_basis hval_sum_iff hcoprime_E'
    D₀ δ_plus hτ_Δ hD₀_ne0 hD₀_val hδ_plus

theorem ld_wild_odd_bicyclic_trace_duality_and_newton_symm_poly (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (y₁_M₁' : M₁')
    (hy₁M₁'_tr : traceLM F hLM₁' y₁_M₁' = 1)
    (hy₁M₁'_ne0 : y₁_M₁' ≠ 0)
    (hy₁M₁'_val : valL F M₁' y₁_M₁' =
      -(((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
        ((bM₁' - 1 : ℕ) : ℤ)))
    (hSymm_M₁'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁),
        Fintype.card G = Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ (σ τ : G) (w : K₁), act (σ * τ) w = act σ (act τ w)) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (z : M₁'),
          act σ (IntermediateField.inclusion hM₁'K₁ z) = IntermediateField.inclusion hM₁'K₁ z) →
        (∀ (σ : G) (w : K₁), valL F K₁ (act σ w) = valL F K₁ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hM₁'K₁ (traceLM F hM₁'K₁ w) = ∑ σ : G, act σ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) = ∏ σ : G, act σ w) →
        let p := Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)
        let t' := (bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') * (bE' - bM₁')
        ∃ s : K₁ → ℕ → M₁',
          (∀ w : K₁, s w 1 = traceLM F hM₁'K₁ w) ∧
          (∀ w : K₁, 2 * s w 2 = (traceLM F hM₁'K₁ w) ^ 2 - traceLM F hM₁'K₁ (w ^ 2)) ∧
          (∀ w : K₁, w ≠ 0 → s w (p - 1) = normLM F hM₁'K₁ w * traceLM F hM₁'K₁ (w⁻¹)) ∧
          (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
            ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
              (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t' + 1 : ℤ) ≤ (r : ℤ) * q →
              (s w r = 0 ∨ m ≤ valL F M₁' (s w r))) ∧
          (∀ (w : K₁) (c : M₁'),
            normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * w) =
              1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s w r) +
                c ^ p * normLM F hM₁'K₁ w))
    (hCayley_M₁'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁) (s : K₁ → ℕ → M₁'),
        Fintype.card G = Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (z : M₁'),
          act σ (IntermediateField.inclusion hM₁'K₁ z) = IntermediateField.inclusion hM₁'K₁ z) →
        (∀ w : K₁,
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) = ∏ σ : G, act σ w) →
        (∀ (w : K₁) (c : M₁'),
          normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * w) =
            1 + (∑ r ∈ Finset.Icc 1 (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) - 1),
              c ^ r * s w r) +
              c ^ (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) * normLM F hM₁'K₁ w) →
        let p := Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)
        (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
          IntermediateField.inclusion hM₁'K₁ (s w r) =
            ∑ S ∈ ((Finset.univ : Finset G).powerset.filter (fun S => S.card = r)),
              ∏ σ ∈ S, act σ w) ∧
        (∀ w : K₁,
          w ^ p =
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) +
              ∑ i ∈ Finset.Icc 1 (p - 1),
                (-1 : K₁) ^ (i - 1) * IntermediateField.inclusion hM₁'K₁ (s w i) * w ^ (p - i)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_tr_low : ∀ j ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 2),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        ((3 * p * m₁ : ℕ) : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j)))
    (hΔ_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')))
    (hΔ_tr_pow :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * normLM F hE'K₁ (Δ : K₁) = 0 ∨
        ((3 * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) -
            ((p : ℕ) : E') * normLM F hE'K₁ (Δ : K₁)))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a = 0 ∨
      ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤
        valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a)) ∧
    ((∀ (θ : M₁') (Y : Fin p → E'),
        IntermediateField.inclusion hM₁'K₁ θ =
          ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
        ∀ i : Fin p,
          Y i = 0 ∨ valL F M₁' θ + (i : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i)) →
      (∀ (Y : E') (i : ℕ), i ∈ Finset.Icc 1 (p - 1) →
        Y = 0 ∨
          traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) + valL F E' Y ≤
            valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)))) ∧
      ∃ (e_Δ : ℕ → M₁') (W_as : Fin p → E'),
        e_Δ 1 = traceLM F hM₁'K₁ (Δ : K₁) ∧
        (∀ i ∈ Finset.Icc 1 (p - 1),
          e_Δ i = 0 ∨
            ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤ valL F M₁' (e_Δ i)) ∧
        (∀ c : M₁',
          normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * (Δ : K₁)) =
            1 + (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e_Δ i) + c ^ p * b) ∧
        (IntermediateField.inclusion hM₁'K₁ b -
          ((Δ : K₁) ^ p +
            ∑ i ∈ Finset.Icc 1 (p - 1),
              (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0) ∧
        (traceLM F hM₁'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : M₁') * (- e_Δ (p - 1)) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * ((t₂ + (bE' - bM₁') : ℕ) : ℤ) ≤
            valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ (p - 1)) -
              ((p - 1 : ℕ) : M₁') * (- e_Δ (p - 1)))) ∧
        (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a =
          ∑ l : Fin p, IntermediateField.inclusion hE'K₁ (W_as l) * ((Δ : K₁) ^ (l : ℕ)) ∧
        (∀ l : Fin p, W_as l = 0 ∨ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (W_as l))) :=
by
  intro p t₁ t₂ a b
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by
    change 3 ≤ Module.finrank L (IntermediateField.extendScalars hLE')
    omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  let m₁ : ℕ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  have ht₂_le_m₁ : t₂ ≤ m₁ := by
    dsimp [t₂, m₁]
    have h1 : bE' - bM₁' ≤ p * (bE' - bM₁') := Nat.le_mul_of_pos_left _ hp_pos
    omega
  have h_as_bound_nat : p * (p - 1) * t₂ ≤ 4 * p * p * m₁ := by
    have h1 : p - 1 ≤ 4 * p := by omega
    have h2 : p * (p - 1) ≤ p * (4 * p) := Nat.mul_le_mul_left p h1
    have h3 : p * (4 * p) = 4 * p * p := by ring
    have h4 : p * (p - 1) ≤ 4 * p * p := h2.trans_eq h3
    exact Nat.mul_le_mul h4 ht₂_le_m₁
  have h_as_bound_int : ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ ((4 * p * p * m₁ : ℕ) : ℤ) := by
    exact_mod_cast h_as_bound_nat
  let δ_AS : K₁ := (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a
  have hΔ_as_t₂ : δ_AS = 0 ∨ ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ δ_AS := by
    rcases hΔ_as with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans h_as_bound_int hge)
  obtain ⟨W_as, hW_as_eq, hW_as_iff⟩ := hΔ_basis δ_AS
  have hW_as_raw := (hW_as_iff ((p * (p - 1) * t₂ : ℕ) : ℤ)).mp hΔ_as_t₂
  have hW_as_val : ∀ l : Fin p, W_as l = 0 ∨ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (W_as l) := by
    intro l
    rcases hW_as_raw l with h0 | hge
    · exact Or.inl h0
    · right
      have hl_nonneg : 0 ≤ (l : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) := by positivity
      have hcast_lhs : ((p * (p - 1) * t₂ : ℕ) : ℤ) =
          (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) := by
        push_cast
        ring
      rw [hcast_lhs] at hge
      have hmul_le : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) ≤ (p : ℤ) * valL F E' (W_as l) := by
        linarith
      have hp_pos_int : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
      exact le_of_mul_le_mul_left hmul_le hp_pos_int

  
  have hval_helpers : ∀ {M : Type u} [Field M] (v : M → ℤ),
      v 1 = 0 →
      (∀ x : M, v (-x) = v x) →
      (∀ x y : M, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
      (∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) → (x + y = 0 ∨ k ≤ v (x + y))) →
      (∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y))) ∧
      (∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x))) ∧
      (∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M)) ∧
      (∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M)) := by
    intro M _ v hv1 h_neg h_mul h_add
    have hmul_b : ∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y)) := by
      intro m₁ m₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          have hvx : m₁ ≤ v x := hx.resolve_left hx0
          have hvy : m₂ ≤ v y := hy.resolve_left hy0
          rw [h_mul x y hx0 hy0]
          linarith
    have hsum_b : ∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x)) := by
      intro α s f k hs
      induction s using Finset.induction_on with
      | empty => exact Or.inl Finset.sum_empty
      | @insert x s' hx ih =>
        rw [Finset.sum_insert hx]
        exact h_add k (f x) (∑ y ∈ s', f y)
          (hs x (Finset.mem_insert_self x s'))
          (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
    have hnat_b : ∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M) := by
      intro n
      induction n with
      | zero => left; simp
      | succ m ih =>
        rw [Nat.cast_succ]
        exact h_add 0 (m : M) 1 ih (Or.inr (by rw [hv1]))
    have hint_b : ∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M) := by
      intro z
      cases z with
      | ofNat n => simpa using hnat_b n
      | negSucc n =>
        rw [Int.cast_negSucc]
        rcases hnat_b (n + 1) with h0 | hge
        · left; exact neg_eq_zero.mpr h0
        · right; rw [h_neg]; exact hge
    exact ⟨hmul_b, hsum_b, hnat_b, hint_b⟩

  obtain ⟨hvalL_0, hvalL_1, _, _, _, _, _, _, _⟩ := hvalL_props
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _⟩ := hvalE'_props
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv, _, hvalM₁'_add, _⟩ := hvalM₁'_props
  obtain ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, _, hvalK₁_add, _⟩ := hvalK₁_props

  obtain ⟨hmul_E', hsum_E', hnat_E', _⟩ :=
    hval_helpers (valL F E') hvalE'_1 hvalE'_neg hvalE'_mul hvalE'_add
  obtain ⟨hmul_M₁', hsum_M₁', hnat_M₁', hint_M₁'⟩ :=
    hval_helpers (valL F M₁') hvalM₁'_1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_add
  obtain ⟨hmul_K₁, _, _, _⟩ :=
    hval_helpers (valL F K₁) hvalK₁_1 hvalK₁_neg hvalK₁_mul hvalK₁_add

  have htr_smul : ∀ {E₀ K₀ : IntermediateField F (AlgebraicClosure F)} (h : E₀ ≤ K₀)
      (y : E₀) (w : K₀),
      traceLM F h (IntermediateField.inclusion h y * w) = y * traceLM F h w := by
    intro E₀ K₀ h y w
    letI : Algebra E₀ E₀ := Algebra.id E₀
    letI : Module E₀ E₀ := Semiring.toModule
    exact (Algebra.trace E₀ (IntermediateField.extendScalars h)).map_smul' y (toExtendScalars F h w)

  
  have hΔ_ne0 : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
  have hval_pow_Δ : ∀ r : ℕ, (Δ : K₁) ^ r ≠ 0 ∧ valL F K₁ ((Δ : K₁) ^ r) = - (r : ℤ) * (t₁ : ℤ) := by
    intro r
    induction r with
    | zero =>
      refine ⟨by simp, ?_⟩
      simp [hvalK₁_1]
    | succ r ih =>
      rw [pow_succ]
      have hne : (Δ : K₁) ^ r * (Δ : K₁) ≠ 0 := mul_ne_zero ih.1 hΔ_ne0
      refine ⟨hne, ?_⟩
      rw [hvalK₁_mul ((Δ : K₁) ^ r) (Δ : K₁) ih.1 hΔ_ne0, ih.2, hΔ_val]
      dsimp [t₁]
      push_cast
      ring
  have hval_a : a = 0 ∨ -(t₁ : ℤ) ≤ valL F E' a := by
    right
    dsimp [a, t₁]
    rw [hval_norm_E'K₁ (Δ : K₁), hΔ_val]
  have hPowTr_le_p : ∀ k : ℕ, 1 ≤ k → k ≤ p →
      traceLM F hE'K₁ ((Δ : K₁) ^ k) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ k)) := by
    intro k hk1 hkp
    by_cases hk_low : k ≤ p - 2
    · have hk_mem : k ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨hk1, hk_low⟩
      rcases hΔ_tr_low k hk_mem with h0 | hge
      · exact Or.inl h0
      · right
        have hm₁_ge_t₁ : t₁ ≤ m₁ := by dsimp [t₁, m₁]; omega
        have h_le_nat : p * t₁ ≤ 3 * p * m₁ := by
          have h1 : p ≤ 3 * p := by omega
          exact Nat.mul_le_mul h1 hm₁_ge_t₁
        have h_le_int : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
            ((3 * p * m₁ : ℕ) : ℤ) := by
          have h2 : (p : ℤ) * (t₁ : ℤ) ≤ ((3 * p * m₁ : ℕ) : ℤ) := by exact_mod_cast h_le_nat
          have h3 : ((p - 1 : ℕ) : ℤ) ≤ (p : ℤ) := by omega
          have h4 : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ (p : ℤ) * (t₁ : ℤ) :=
            mul_le_mul_of_nonneg_right h3 (by positivity)
          have h5 : 0 ≤ (k : ℤ) * (t₁ : ℤ) := by positivity
          linarith
        exact le_trans h_le_int hge
    · by_cases hk_top : k = p - 1
      · subst hk_top
        rw [sub_self]
        have hdecomp : traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) =
            ((p - 1 : ℕ) : E') + (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
          ring
        rw [hdecomp]
        have hterm1 : ((p - 1 : ℕ) : E') = 0 ∨ 0 ≤ valL F E' ((p - 1 : ℕ) : E') :=
          hnat_E' (p - 1)
        have hterm2 : traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
            0 ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
          rcases hΔ_tr_top with h0 | hge
          · exact Or.inl h0
          · exact Or.inr (le_trans (by positivity) hge)
        exact hvalE'_add 0 _ _ hterm1 hterm2
      · have hk_eq_p : k = p := by omega
        subst hk_eq_p
        have hbound_eq : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (p : ℤ) * (t₁ : ℤ) = -(t₁ : ℤ) := by
          have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
          rw [hp_sub]
          ring
        rw [hbound_eq]
        have hdecomp : traceLM F hE'K₁ ((Δ : K₁) ^ p) =
            ((p : ℕ) : E') * a + (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a) := by
          ring
        rw [hdecomp]
        have hterm1 : ((p : ℕ) : E') * a = 0 ∨ -(t₁ : ℤ) ≤ valL F E' (((p : ℕ) : E') * a) := by
          have h := hmul_E' 0 (-(t₁ : ℤ)) ((p : ℕ) : E') a (hnat_E' p) hval_a
          rwa [zero_add] at h
        have hterm2 : traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a = 0 ∨
            -(t₁ : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a) := by
          rcases hΔ_tr_pow with h0 | hge
          · exact Or.inl h0
          · right
            have h0_le : (-(t₁ : ℤ)) ≤ ((3 * p * m₁ : ℕ) : ℤ) := by
              have : 0 ≤ (t₁ : ℤ) := by positivity
              have : 0 ≤ ((3 * p * m₁ : ℕ) : ℤ) := by positivity
              linarith
            exact le_trans h0_le hge
        exact hvalE'_add (-(t₁ : ℤ)) _ _ hterm1 hterm2

  have hPowTr_E'K₁ : ∀ k ∈ Finset.Icc 1 (2 * p - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ k) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ k)) := by
    intro k hk
    obtain ⟨hk1, hk2⟩ := Finset.mem_Icc.mp hk
    by_cases hkp : k ≤ p
    · exact hPowTr_le_p k hk1 hkp
    · set r : ℕ := k - p
      have hr1 : 1 ≤ r := by omega
      have hr_le : r ≤ p - 2 := by omega
      have hk_eq : k = p + r := by omega
      let B_k : ℤ := ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ)
      have hpow_decomp : (Δ : K₁) ^ k =
          (Δ : K₁) ^ (r + 1) + IntermediateField.inclusion hE'K₁ a * ((Δ : K₁) ^ r) +
            δ_AS * ((Δ : K₁) ^ r) := by
        rw [hk_eq, pow_add, pow_succ']
        dsimp [δ_AS]
        ring
      have htr_decomp : traceLM F hE'K₁ ((Δ : K₁) ^ k) =
          (traceLM F hE'K₁ ((Δ : K₁) ^ (r + 1)) + a * traceLM F hE'K₁ ((Δ : K₁) ^ r)) +
            traceLM F hE'K₁ (δ_AS * ((Δ : K₁) ^ r)) := by
        rw [hpow_decomp, map_add, map_add, htr_smul hE'K₁ a ((Δ : K₁) ^ r)]
      rw [htr_decomp]
      have hterm1 : traceLM F hE'K₁ ((Δ : K₁) ^ (r + 1)) = 0 ∨
          B_k ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (r + 1))) := by
        rcases hPowTr_le_p (r + 1) (by omega) (by omega) with h0 | hge
        · exact Or.inl h0
        · right
          have hle : ((r + 1 : ℕ) : ℤ) ≤ (k : ℤ) := by exact_mod_cast (by omega : r + 1 ≤ k)
          have hmul : ((r + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ (k : ℤ) * (t₁ : ℤ) :=
            mul_le_mul_of_nonneg_right hle (by positivity)
          dsimp [B_k]
          linarith
      have hterm2 : a * traceLM F hE'K₁ ((Δ : K₁) ^ r) = 0 ∨
          B_k ≤ valL F E' (a * traceLM F hE'K₁ ((Δ : K₁) ^ r)) := by
        have h_tr_r := hPowTr_le_p r hr1 (by omega)
        have h_prod := hmul_E' (-(t₁ : ℤ)) (((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (r : ℤ) * (t₁ : ℤ))
