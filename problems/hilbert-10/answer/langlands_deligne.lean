    have hb_sub : ((bE' - bM₁' : ℕ) : ℤ) = (bE' : ℤ) - (bM₁' : ℤ) := by omega
    have ht'_z : ((t' + 1 : ℕ) : ℤ) = (bM₁' : ℤ) + (p : ℤ) * ((bE' : ℤ) - (bM₁' : ℤ)) := by
      have ht'_def : t' + 1 = bM₁' + p * (bE' - bM₁') := by omega
      rw [ht'_def, Nat.cast_add, Nat.cast_mul, hb_sub]
    omega
  have htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)) := by
    have h := htr_E'K₁_raw
    rw [hdegE'K₁, hu₂_add1] at h
    exact h
  have htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * ((t' + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)) := by
    have h := htr_M₁'K₁_raw
    rw [hdegM₁'K₁, hu₁_eq] at h
    exact h
  have hBasis_E'K₁ : ∀ w : K₁, ∃ c : Fin p → E',
      w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F E' (c i) + (i : ℤ) := by
    have h := hBasis_E'K₁_raw ϖ_K₁ hϖ_K₁
    dsimp only [p]
    rw [← hdegE'K₁]
    exact h
  letI : Group G_K₁ := instGroupGK₁
  letI : Fintype G_K₁ := instFintypeGK₁
  have hcard_GK₁ : Fintype.card G_K₁ = p := by
    rw [hdegE'K₁] at hcard_GK₁_raw
    exact hcard_GK₁_raw
  have hjump_K₁ : ∀ τ : G_K₁, τ ≠ 1 →
      (ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁) ≠ 0 ∧
      valL F K₁ ((ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁)) = (t₁ + 1 : ℤ) := by
    rw [← hu₂_eq]
    exact hjump_K₁_raw
  have hy₁K₁_val : valL F K₁ y₁_K₁ = -(((p - 1 : ℕ) : ℤ) * (t₁ : ℤ)) := by
    rw [hdegE'K₁, hu₂_eq] at hy₁K₁_val_raw
    exact hy₁K₁_val_raw
  exact ⟨hnE'_eq, hnM₁'_eq, hξE'_cond, hξM₁'_cond,
    hval_norm_LE', hval_LE', hval_norm_LM₁', hval_LM₁',
    hval_norm_E'K₁, hval_E'K₁, hval_norm_M₁'K₁, hval_M₁'K₁,
    htr_LE', htr_LM₁', htr_E'K₁, htr_M₁'K₁, hPkg_LE',
    ⟨ϖ_K₁, G_K₁, instGroupGK₁, instFintypeGK₁, act_K₁, y₁_K₁,
     hϖ_K₁, hBasis_E'K₁, hcard_GK₁, hactK₁_one, hactK₁_mul, hactK₁_ring,
     hactK₁_incl, hactK₁_val, hactK₁_trace, hactK₁_norm, hjump_K₁,
     hy₁K₁_tr, hy₁K₁_ne0, hy₁K₁_val⟩⟩

theorem ld_wild_tot_ram_const_free_jump_shift_and_telescoping (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K]
    (hBK : B ≤ K) (p : ℕ) (hPrime : Nat.Prime p)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (hvalB_props : valL F B 0 = 0 ∧ valL F B 1 = 0 ∧ valL F B (-1) = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B)) ∧
      (∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x + y = 0 ∨ k ≤ valL F B (x + y))))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ w : K, valL F K (-w) = valL F K w) ∧
      (∀ w₁ w₂ : K, w₁ ≠ 0 → w₂ ≠ 0 → valL F K (w₁ * w₂) = valL F K w₁ + valL F K w₂) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ (k : ℤ) (w₁ w₂ : K),
        (w₁ = 0 ∨ k ≤ valL F K w₁) → (w₂ = 0 ∨ k ≤ valL F K w₂) →
          (w₁ + w₂ = 0 ∨ k ≤ valL F K (w₁ + w₂))))
    (hval_BK : ∀ x : B, valL F K (IntermediateField.inclusion hBK x) = (p : ℤ) * valL F B x)
    (ϖ_K : Kˣ) (G : Type u) [Group G] [Fintype G]
    (act : G → K → K) (y₁ : K)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hBasis : ∀ w : K, ∃ c : Fin p → B,
      w = ∑ i : Fin p, IntermediateField.inclusion hBK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K w) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F B (c i) + (i : ℤ))
    (hcard_G : Fintype.card G = p)
    (hact_one : ∀ w : K, act 1 w = w)
    (hact_mul : ∀ (σ τ : G) (w : K), act (σ * τ) w = act σ (act τ w))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ w₁ w₂ : K,
        act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
        act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
        act σ (-w₁) = -act σ w₁))
    (hact_incl : ∀ (σ : G) (x : B),
      act σ (IntermediateField.inclusion hBK x) = IntermediateField.inclusion hBK x)
    (hact_val : ∀ (σ : G) (w : K), valL F K (act σ w) = valL F K w)
    (hact_trace : ∀ w : K,
      IntermediateField.inclusion hBK (traceLM F hBK w) = ∑ σ : G, act σ w)
    (hjump : ∀ τ : G, τ ≠ 1 →
      (ϖ_K : K) - act τ (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act τ (ϖ_K : K)) = (t + 1 : ℤ))
    (hy₁_tr : traceLM F hBK y₁ = 1)
    (hy₁_ne0 : y₁ ≠ 0)
    (hy₁_val : valL F K y₁ = -(((p - 1 : ℕ) : ℤ) * (t : ℤ))) :
    (((p : ℕ) : K) = 0 ∨ (((p - 1) * t : ℕ) : ℤ) ≤ valL F K ((p : ℕ) : K)) ∧
    (∀ M_p : ℤ,
      ((p - 1 : ℕ) : ℤ) * (t : ℤ) + 1 ≤ M_p →
      (((p : ℕ) : K) = 0 ∨ M_p ≤ valL F K ((p : ℕ) : K)) →
      ¬ (p ∣ t) ∧
      ∃ (σ : G) (d : K),
        σ ≠ 1 ∧
        valL F K d = -(t : ℤ) ∧
        (act σ d - (d + 1) = 0 ∨
          M_p - ((p - 1 : ℕ) : ℤ) * (t : ℤ) ≤ valL F K (act σ d - (d + 1)))) ∧
    (∀ (w : K) (σ : G) (M : ℤ),
      σ ≠ 1 →
      (act σ w - w = 0 ∨ M + (t : ℤ) ≤ valL F K (act σ w - w)) →
      ∃ c₀ : B,
        w - IntermediateField.inclusion hBK c₀ = 0 ∨
          M ≤ valL F K (w - IntermediateField.inclusion hBK c₀)) :=
by
  classical
  
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  obtain ⟨hvalB_0, hvalB_1, hvalB_neg1, hvalB_neg, hvalB_mul, hvalB_inv, hvalB_add⟩ := hvalB_props
  obtain ⟨hvalK_0, hvalK_1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_add⟩ := hvalK_props
  set π : K := (ϖ_K : K)
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_K
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun x y => ((hact_ring σ).2.2 x y).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun x y => ((hact_ring σ).2.2 x y).1 }
  have hφ_apply : ∀ (σ : G) (w : K), φ σ w = act σ w := fun _ _ => rfl

  have hval_pi_pow : ∀ k : ℕ, π ^ k ≠ 0 ∧ valL F K (π ^ k) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      refine ⟨by simp, ?_⟩
      rw [pow_zero, Nat.cast_zero, hvalK_1]
    | succ k ih =>
      refine ⟨pow_ne_zero (k + 1) hπ_ne0, ?_⟩
      rw [pow_succ, hvalK_mul (π ^ k) π ih.1 hπ_ne0, ih.2, hϖ_K]
      push_cast
      ring

  have hval_neg_ge_K : ∀ (k : ℤ) (w : K),
      (w = 0 ∨ k ≤ valL F K w) → (-w = 0 ∨ k ≤ valL F K (-w)) := by
    intro k w hw
    rcases hw with rfl | hge
    · exact Or.inl neg_zero
    · right
      rwa [hvalK_neg]

  have hval_sub_ge_K : ∀ (k : ℤ) (w₁ w₂ : K),
      (w₁ = 0 ∨ k ≤ valL F K w₁) → (w₂ = 0 ∨ k ≤ valL F K w₂) →
        (w₁ - w₂ = 0 ∨ k ≤ valL F K (w₁ - w₂)) := by
    intro k w₁ w₂ hw₁ hw₂
    rw [sub_eq_add_neg]
    exact hvalK_add k w₁ (-w₂) hw₁ (hval_neg_ge_K k w₂ hw₂)

  have hval_mul_ge_K : ∀ (k₁ k₂ : ℤ) (x y : K),
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F K x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F K y := hy.resolve_left hy0
        rw [hvalK_mul x y hx0 hy0]
        omega

  have hval_finset_sum_K : ∀ {α : Type} (S : Finset α) (f : α → K) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hvalK_add k (f a) (∑ i ∈ s, f i) ha_val hs_val

  have hval_finset_sum_G : ∀ (S : Finset G) (f : G → K) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hvalK_add k (f a) (∑ i ∈ s, f i) ha_val hs_val

  have hval_strict_K : ∀ (w₁ w₂ : K),
      w₁ ≠ 0 → (w₂ = 0 ∨ valL F K w₁ + 1 ≤ valL F K w₂) →
        w₁ + w₂ ≠ 0 ∧ valL F K (w₁ + w₂) = valL F K w₁ := by
    intro w₁ w₂ hw₁ hw₂
    set v₁ : ℤ := valL F K w₁
    have hw₂_ge : w₂ = 0 ∨ v₁ ≤ valL F K w₂ := by
      rcases hw₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : w₁ + w₂ = 0 ∨ v₁ ≤ valL F K (w₁ + w₂) :=
      hvalK_add v₁ w₁ w₂ (Or.inr le_rfl) hw₂_ge
    have hnot_gt : ¬ (w₁ + w₂ = 0 ∨ v₁ + 1 ≤ valL F K (w₁ + w₂)) := by
      intro hgt
      have hneg_w₂ : -w₂ = 0 ∨ v₁ + 1 ≤ valL F K (-w₂) := by
        rcases hw₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hvalK_neg]
          exact hge
      have hw₁_gt := hvalK_add (v₁ + 1) (w₁ + w₂) (-w₂) hgt hneg_w₂
      have heq_w₁ : (w₁ + w₂) + (-w₂) = w₁ := by ring
      rw [heq_w₁] at hw₁_gt
      rcases hw₁_gt with h10 | h1ge
      · exact hw₁ h10
      · omega
    have hsum_ne : w₁ + w₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K (w₁ + w₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K (w₁ + w₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  have hact_pi_diff : ∀ τ : G,
      act τ π - π = 0 ∨ (t + 1 : ℤ) ≤ valL F K (act τ π - π) := by
    intro τ
    by_cases hτ1 : τ = 1
    · left
      rw [hτ1, hact_one π, sub_self]
    · right
      have hneg : act τ π - π = -(π - act τ π) := by ring
      rw [hneg, hvalK_neg, (hjump τ hτ1).2]

  have hact_pi_pow_diff : ∀ (τ : G) (n : ℕ), 1 ≤ n →
      (act τ π) ^ n - π ^ n = 0 ∨
        (n : ℤ) + (t : ℤ) ≤ valL F K ((act τ π) ^ n - π ^ n) := by
    intro τ n
    induction n with
    | zero =>
      intro h
      omega
    | succ n ih =>
      intro _
      by_cases hn0 : n = 0
      · subst hn0
        simpa [pow_one, add_comm] using hact_pi_diff τ
      · have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
        have h_id : (act τ π) ^ (n + 1) - π ^ (n + 1) =
            ((act τ π) ^ n - π ^ n) * act τ π + π ^ n * (act τ π - π) := by
          rw [pow_succ (act τ π) n, pow_succ π n]
          ring
        have hτπ_val : act τ π = 0 ∨ (1 : ℤ) ≤ valL F K (act τ π) :=
          Or.inr (by rw [hact_val τ π, hϖ_K])
        have hπn_val : π ^ n = 0 ∨ (n : ℤ) ≤ valL F K (π ^ n) :=
          Or.inr (by rw [(hval_pi_pow n).2])
        have ht1 := hval_mul_ge_K ((n : ℤ) + (t : ℤ)) 1
          ((act τ π) ^ n - π ^ n) (act τ π) (ih hn1) hτπ_val
        have ht2 := hval_mul_ge_K (n : ℤ) (t + 1 : ℤ)
          (π ^ n) (act τ π - π) hπn_val (hact_pi_diff τ)
        have ht1' : ((act τ π) ^ n - π ^ n) * act τ π = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t : ℤ) ≤
              valL F K (((act τ π) ^ n - π ^ n) * act τ π) := by
          rcases ht1 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        have ht2' : π ^ n * (act τ π - π) = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t : ℤ) ≤
              valL F K (π ^ n * (act τ π - π)) := by
          rcases ht2 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        rw [h_id]
        exact hvalK_add (((n + 1 : ℕ) : ℤ) + (t : ℤ)) _ _ ht1' ht2'

  have hact_shift : ∀ (τ : G) (w : K) (m : ℤ),
      (w = 0 ∨ m ≤ valL F K w) →
      (act τ w - w = 0 ∨ m + (t : ℤ) ≤ valL F K (act τ w - w)) := by
    intro τ w m hw
    obtain ⟨c, hw_eq, hval_iff⟩ := hBasis w
    have hc_bound := (hval_iff m).mp hw
    have hact_w_sub : act τ w - w =
        ∑ i : Fin p, IntermediateField.inclusion hBK (c i) *
          ((act τ π) ^ (i : ℕ) - π ^ (i : ℕ)) := by
      change φ τ w - w = _
      rw [hw_eq, map_sum (φ τ), ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul (φ τ), map_pow (φ τ), hφ_apply, hact_incl τ (c i), hφ_apply, ← mul_sub]
    rw [hact_w_sub]
    apply hval_finset_sum_K Finset.univ _ (m + (t : ℤ))
    intro i _
    by_cases hi0 : (i : ℕ) = 0
    · left
      rw [hi0, pow_zero, pow_zero, sub_self, mul_zero]
    · have hi1 : 1 ≤ (i : ℕ) := Nat.one_le_iff_ne_zero.mpr hi0
      rcases hc_bound i with hci0 | hci_ge
      · left
        rw [hci0, map_zero, zero_mul]
      · have hinc_val : IntermediateField.inclusion hBK (c i) = 0 ∨
            (p : ℤ) * valL F B (c i) ≤
              valL F K (IntermediateField.inclusion hBK (c i)) :=
          Or.inr (by rw [hval_BK (c i)])
        have hdiff_val := hact_pi_pow_diff τ (i : ℕ) hi1
        have hmul := hval_mul_ge_K ((p : ℤ) * valL F B (c i)) (((i : ℕ) : ℤ) + (t : ℤ))
          (IntermediateField.inclusion hBK (c i))
          ((act τ π) ^ (i : ℕ) - π ^ (i : ℕ)) hinc_val hdiff_val
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          change m ≤ (p : ℤ) * valL F B (c i) + ((i : ℕ) : ℤ) at hci_ge
          omega

  
  set m₁ : ℤ := -(((p - 1 : ℕ) : ℤ) * (t : ℤ))
  have hy₁_ge : y₁ = 0 ∨ m₁ ≤ valL F K y₁ := Or.inr (by rw [hy₁_val])
  have hsum_shift : (∑ τ : G, (act τ y₁ - y₁)) = 0 ∨
      m₁ + (t : ℤ) ≤ valL F K (∑ τ : G, (act τ y₁ - y₁)) :=
    hval_finset_sum_G (Finset.univ : Finset G) (fun τ => act τ y₁ - y₁) (m₁ + (t : ℤ))
      (fun τ _ => hact_shift τ y₁ m₁ hy₁_ge)
  have hsum_y₁ : (∑ τ : G, (act τ y₁ - y₁)) = 1 - ((p : ℕ) : K) * y₁ := by
    rw [Finset.sum_sub_distrib, ← hact_trace y₁, hy₁_tr, map_one,
      Finset.sum_const, Finset.card_univ, hcard_G, nsmul_eq_mul]
  rw [hsum_y₁] at hsum_shift
  have hm₁_t_le0 : m₁ + (t : ℤ) ≤ 0 := by
    dsimp [m₁]
    have hp1 : 1 ≤ ((p - 1 : ℕ) : ℤ) := by omega
    have ht1 : 1 ≤ (t : ℤ) := by omega
    nlinarith
  have h1_ge : (1 : K) = 0 ∨ m₁ + (t : ℤ) ≤ valL F K (1 : K) :=
    Or.inr (by rw [hvalK_1]; exact hm₁_t_le0)
  have hpy₁_val : ((p : ℕ) : K) * y₁ = 0 ∨ m₁ + (t : ℤ) ≤ valL F K (((p : ℕ) : K) * y₁) := by
    have heq : ((p : ℕ) : K) * y₁ = 1 - (1 - ((p : ℕ) : K) * y₁) := by ring
    rw [heq]
    exact hval_sub_ge_K (m₁ + (t : ℤ)) 1 (1 - ((p : ℕ) : K) * y₁) h1_ge hsum_shift
  have hp_val_ge1 : ((p : ℕ) : K) = 0 ∨ (1 : ℤ) ≤ valL F K ((p : ℕ) : K) := by
    by_cases hp0 : ((p : ℕ) : K) = 0
    · exact Or.inl hp0
    · right
      have hpy₁_ne0 : ((p : ℕ) : K) * y₁ ≠ 0 := mul_ne_zero hp0 hy₁_ne0
      have hge := hpy₁_val.resolve_left hpy₁_ne0
      rw [hvalK_mul ((p : ℕ) : K) y₁ hp0 hy₁_ne0, hy₁_val] at hge
      change m₁ + (t : ℤ) ≤ valL F K ((p : ℕ) : K) + m₁ at hge
      omega

  have hval_natCast_K : ∀ n : ℕ, (n : K) = 0 ∨ (0 : ℤ) ≤ valL F K (n : K) := by
    intro n
    induction n with
    | zero => exact Or.inl Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hvalK_add 0 (n : K) 1 ih (Or.inr (by rw [hvalK_1]))

  have hval_intCast_K : ∀ z : ℤ, (z : K) = 0 ∨ (0 : ℤ) ≤ valL F K (z : K) := by
    intro z
    cases z with
    | ofNat n =>
      simpa using hval_natCast_K n
    | negSucc n =>
      rw [Int.cast_negSucc]
      exact hval_neg_ge_K 0 ((n + 1 : ℕ) : K) (hval_natCast_K (n + 1))

  have hcoprime_unit : ∀ i : ℕ, 1 ≤ i → i < p → (i : K) ≠ 0 ∧ valL F K (i : K) = 0 := by
    intro i hi_ge1 hi_lt
    have hcop : Nat.Coprime i p :=
      ((Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt (by omega) hi_lt)).symm
    have hbez : (i : K) * (Nat.gcdA i p : K) =
        (1 : K) + (- (((p : ℕ) : K) * (Nat.gcdB i p : K))) := by
      have h := congrArg (Int.cast : ℤ → K) (Nat.gcd_eq_gcd_ab i p)
      rw [hcop.gcd_eq_one] at h
      push_cast at h
      linear_combination -h
    have hw₂_ge : - (((p : ℕ) : K) * (Nat.gcdB i p : K)) = 0 ∨
        valL F K (1 : K) + 1 ≤ valL F K (- (((p : ℕ) : K) * (Nat.gcdB i p : K))) := by
      have hmul := hval_mul_ge_K 1 0 ((p : ℕ) : K) (Nat.gcdB i p : K)
        hp_val_ge1 (hval_intCast_K (Nat.gcdB i p))
      have hneg := hval_neg_ge_K (1 + 0) (((p : ℕ) : K) * (Nat.gcdB i p : K)) hmul
      rcases hneg with h0 | hge
      · exact Or.inl h0
      · right
        rw [hvalK_1]
        omega
    have hstrict := hval_strict_K (1 : K) (- (((p : ℕ) : K) * (Nat.gcdB i p : K)))
      one_ne_zero hw₂_ge
    rw [← hbez, hvalK_1] at hstrict
    have hi_ne0 : (i : K) ≠ 0 := left_ne_zero_of_mul hstrict.1
    have ha_ne0 : (Nat.gcdA i p : K) ≠ 0 := right_ne_zero_of_mul hstrict.1
    have hi_ge0 : 0 ≤ valL F K (i : K) := (hval_natCast_K i).resolve_left hi_ne0
    have ha_ge0 : 0 ≤ valL F K (Nat.gcdA i p : K) :=
      (hval_intCast_K (Nat.gcdA i p)).resolve_left ha_ne0
    have hmul_val := hstrict.2
    rw [hvalK_mul (i : K) (Nat.gcdA i p : K) hi_ne0 ha_ne0] at hmul_val
    exact ⟨hi_ne0, by omega⟩

  
  have hact_pi_pow_exact : ∀ (σ : G), σ ≠ 1 → ∀ i : ℕ, 1 ≤ i → i < p →
      (act σ π) ^ i - π ^ i ≠ 0 ∧
      valL F K ((act σ π) ^ i - π ^ i) = (i : ℤ) + (t : ℤ) := by
    intro σ hσ i hi_ge1 hi_lt
    set δ_σ : K := act σ π - π
    have hneg_δ : δ_σ = -(π - act σ π) := by dsimp [δ_σ]; ring
    have hδ_ne0 : δ_σ ≠ 0 := by
      rw [hneg_δ]
      exact neg_ne_zero.mpr (hjump σ hσ).1
    have hδ_val : valL F K δ_σ = (t + 1 : ℤ) := by
      rw [hneg_δ, hvalK_neg, (hjump σ hσ).2]
    have hδ_sq_ne0 : δ_σ ^ 2 ≠ 0 := pow_ne_zero 2 hδ_ne0
    have hδ_sq_val : valL F K (δ_σ ^ 2) = 2 * (t : ℤ) + 2 := by
      rw [sq, hvalK_mul δ_σ δ_σ hδ_ne0 hδ_ne0, hδ_val]
      ring
    let R₁ : ℕ → K := fun m =>
      (act σ π) ^ (m + 1) - π ^ (m + 1) - ((m + 1 : ℕ) : K) * (π ^ m) * δ_σ
    have hR₁_val : ∀ m : ℕ,
        R₁ m = 0 ∨ ((m + 1 : ℕ) : ℤ) + 2 * (t : ℤ) ≤ valL F K (R₁ m) := by
      intro m
      induction m with
      | zero =>
        left
        dsimp [R₁, δ_σ]
        ring
      | succ m ih =>
        have hR₁_rec : R₁ (m + 1) =
            R₁ m * act σ π + ((m + 1 : ℕ) : K) * (π ^ m) * (δ_σ ^ 2) := by
          dsimp [R₁, δ_σ]
          rw [pow_succ (act σ π) (m + 1), pow_succ π (m + 1), pow_succ π m]
          push_cast
          ring
        have hσπ_val : act σ π = 0 ∨ (1 : ℤ) ≤ valL F K (act σ π) :=
          Or.inr (by rw [hact_val σ π, hϖ_K])
        have ht1 := hval_mul_ge_K (((m + 1 : ℕ) : ℤ) + 2 * (t : ℤ)) 1
          (R₁ m) (act σ π) ih hσπ_val
        have ht1' : R₁ m * act σ π = 0 ∨
            ((m + 2 : ℕ) : ℤ) + 2 * (t : ℤ) ≤ valL F K (R₁ m * act σ π) := by
          rcases ht1 with h0 | hge
          · exact Or.inl h0
          · right
            have hcast : ((m + 2 : ℕ) : ℤ) + 2 * (t : ℤ) =
                (((m + 1 : ℕ) : ℤ) + 2 * (t : ℤ)) + 1 := by push_cast; ring
            rw [hcast]
            exact hge
        have hm1_val : ((m + 1 : ℕ) : K) = 0 ∨ (0 : ℤ) ≤ valL F K ((m + 1 : ℕ) : K) :=
          hval_natCast_K (m + 1)
        have hπm_val : π ^ m = 0 ∨ (m : ℤ) ≤ valL F K (π ^ m) :=
          Or.inr (by rw [(hval_pi_pow m).2])
        have hδ2_val : δ_σ ^ 2 = 0 ∨ 2 * (t : ℤ) + 2 ≤ valL F K (δ_σ ^ 2) :=
          Or.inr (by rw [hδ_sq_val])
        have ht2_a := hval_mul_ge_K 0 (m : ℤ) ((m + 1 : ℕ) : K) (π ^ m) hm1_val hπm_val
        have ht2 := hval_mul_ge_K (0 + (m : ℤ)) (2 * (t : ℤ) + 2)
          (((m + 1 : ℕ) : K) * (π ^ m)) (δ_σ ^ 2) ht2_a hδ2_val
        have ht2' : ((m + 1 : ℕ) : K) * (π ^ m) * (δ_σ ^ 2) = 0 ∨
            ((m + 2 : ℕ) : ℤ) + 2 * (t : ℤ) ≤
              valL F K (((m + 1 : ℕ) : K) * (π ^ m) * (δ_σ ^ 2)) := by
          rcases ht2 with h0 | hge
          · exact Or.inl h0
          · right
            have hcast : ((m + 2 : ℕ) : ℤ) + 2 * (t : ℤ) =
                (0 + (m : ℤ)) + (2 * (t : ℤ) + 2) := by push_cast; ring
            rw [hcast]
            exact hge
        rw [hR₁_rec]
        exact hvalK_add (((m + 2 : ℕ) : ℤ) + 2 * (t : ℤ)) _ _ ht1' ht2'
    have hm_eq : (i - 1) + 1 = i := by omega
    have hsplit : (act σ π) ^ i - π ^ i =
        (i : K) * (π ^ (i - 1)) * δ_σ + R₁ (i - 1) := by
      dsimp [R₁]
      rw [hm_eq]
      ring
    obtain ⟨hi_ne0, hi_val0⟩ := hcoprime_unit i hi_ge1 hi_lt
    obtain ⟨hπi_ne0, hπi_val⟩ := hval_pi_pow (i - 1)
    have hlead_a_ne0 : (i : K) * (π ^ (i - 1)) ≠ 0 := mul_ne_zero hi_ne0 hπi_ne0
    have hlead_ne0 : (i : K) * (π ^ (i - 1)) * δ_σ ≠ 0 := mul_ne_zero hlead_a_ne0 hδ_ne0
    have hlead_val : valL F K ((i : K) * (π ^ (i - 1)) * δ_σ) = (i : ℤ) + (t : ℤ) := by
      rw [hvalK_mul _ _ hlead_a_ne0 hδ_ne0, hvalK_mul _ _ hi_ne0 hπi_ne0,
        hi_val0, hπi_val, hδ_val]
      omega
    have hR₁_bound : R₁ (i - 1) = 0 ∨
        valL F K ((i : K) * (π ^ (i - 1)) * δ_σ) + 1 ≤ valL F K (R₁ (i - 1)) := by
      rcases hR₁_val (i - 1) with h0 | hge
      · exact Or.inl h0
      · right
        rw [hlead_val]
        rw [hm_eq] at hge
        omega
    have hstrict := hval_strict_K ((i : K) * (π ^ (i - 1)) * δ_σ) (R₁ (i - 1))
      hlead_ne0 hR₁_bound
    rw [← hsplit, hlead_val] at hstrict
    exact hstrict

  let t_term (c : Fin p → B) (i : Fin p) : K :=
    IntermediateField.inclusion hBK (c i) * (π ^ (i : ℕ))
  let d_term (σ : G) (c : Fin p → B) (i : Fin p) : K :=
    IntermediateField.inclusion hBK (c i) * ((act σ π) ^ (i : ℕ) - π ^ (i : ℕ))
  let v_term (c : Fin p → B) (i : Fin p) : ℤ :=
    (p : ℤ) * valL F B (c i) + (i.1 : ℤ)

  have ht_term_zero : ∀ (c : Fin p → B) (i : Fin p), c i = 0 → t_term c i = 0 := by
    intro c i hci
    dsimp [t_term]
    rw [hci, map_zero, zero_mul]

  have ht_term_nz : ∀ (c : Fin p → B) (i : Fin p),
      c i ≠ 0 → t_term c i ≠ 0 ∧ valL F K (t_term c i) = v_term c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hBK (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hBK).toRingHom).ne hci
    obtain ⟨hpow_ne, hpow_val⟩ := hval_pi_pow (i : ℕ)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term, v_term]
    rw [hvalK_mul _ _ hinc_ne hpow_ne, hval_BK (c i), hpow_val]

  have hv_term_mod : ∀ (c : Fin p → B) (k : Fin p),
      v_term c k % (p : ℤ) = (k.1 : ℤ) := by
    intro c k
    dsimp [v_term]
    have hcomm : (p : ℤ) * valL F B (c k) + (k.1 : ℤ) =
        (k.1 : ℤ) + (p : ℤ) * valL F B (c k) := by ring
    rw [hcomm, Int.add_mul_emod_self_left,
      Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]

  have hv_term_inj : ∀ (c : Fin p → B) (i j : Fin p),
      v_term c i = v_term c j → i = j := by
    intro c i j hij
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hv_term_mod c i, ← hv_term_mod c j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_t_sum_ge : ∀ (c : Fin p → B) (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term c i) →
        ((∑ i ∈ S, t_term c i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, t_term c i)) := by
    intro c S m hS
    apply hval_finset_sum_K S (t_term c) m
    intro i hi
    by_cases hci : c i = 0
    · exact Or.inl (ht_term_zero c i hci)
    · right
      rw [(ht_term_nz c i hci).2]
      exact (hS i hi).resolve_left hci

  have hconst_free_shift : ∀ (w : K) (σ : G), σ ≠ 1 →
      ∃ c₀ : B,
        let z := w - IntermediateField.inclusion hBK c₀
        act σ z - z = act σ w - w ∧
        ((z = 0 ∧ act σ w - w = 0) ∨
          (z ≠ 0 ∧ act σ w - w ≠ 0 ∧
            valL F K (act σ w - w) = valL F K z + (t : ℤ) ∧
            ¬ ((p : ℤ) ∣ valL F K z))) := by
    intro w σ hσ
    obtain ⟨c, hw_eq, _⟩ := hBasis w
    let i_zero : Fin p := ⟨0, hp_pos⟩
    let c₀ : B := c i_zero
    let c' : Fin p → B := fun i => if i = i_zero then 0 else c i
    have hc'0 : c' i_zero = 0 := if_pos rfl
    set z : K := w - IntermediateField.inclusion hBK c₀
    have hact_z_eq : act σ z - z = act σ w - w := by
      change φ σ (w - IntermediateField.inclusion hBK c₀) - (w - IntermediateField.inclusion hBK c₀) =
        act σ w - w
      rw [map_sub (φ σ), hφ_apply, hφ_apply, hact_incl σ c₀]
      ring
    have hz_eq : z = ∑ i : Fin p, t_term c' i := by
      have hw_sum : w = ∑ i : Fin p, t_term c i := hw_eq
      have hsplit_w := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) (t_term c)
        (Finset.mem_univ i_zero)).symm
      have ht0 : t_term c i_zero = IntermediateField.inclusion hBK c₀ := by
        dsimp [t_term, i_zero, c₀]
        rw [pow_zero, mul_one]
      have hsplit_c' := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) (t_term c')
        (Finset.mem_univ i_zero)).symm
      have ht'0 : t_term c' i_zero = 0 := ht_term_zero c' i_zero hc'0
      have herase_eq : (∑ i ∈ (Finset.univ : Finset (Fin p)).erase i_zero, t_term c i) =
          ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i_zero, t_term c' i := by
        refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
        dsimp [t_term, c']
        rw [if_neg hi_ne]
      dsimp [z]
      rw [hw_sum, hsplit_w, ht0, add_sub_cancel_left, herase_eq, hsplit_c', ht'0, zero_add]
    have hact_w_eq : act σ w - w = ∑ i : Fin p, d_term σ c' i := by
      rw [← hact_z_eq]
      change φ σ z - z = _
      rw [hz_eq, map_sum (φ σ), ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      dsimp [t_term, d_term]
      rw [map_mul (φ σ), map_pow (φ σ), hφ_apply, hact_incl σ (c' i), hφ_apply, ← mul_sub]
    have hd_term_zero : ∀ i : Fin p, c' i = 0 → d_term σ c' i = 0 := by
      intro i hci
      dsimp [d_term]
      rw [hci, map_zero, zero_mul]
    have hd_term_nz : ∀ i : Fin p, c' i ≠ 0 →
        d_term σ c' i ≠ 0 ∧ valL F K (d_term σ c' i) = v_term c' i + (t : ℤ) := by
      intro i hci
      have hi_ne0 : i ≠ i_zero := fun heq => hci (heq ▸ hc'0)
      have hi_ge1 : 1 ≤ (i : ℕ) := by
        have hne : (i : ℕ) ≠ 0 := fun h0 => hi_ne0 (Fin.ext h0)
        omega
      have hinc_ne : IntermediateField.inclusion hBK (c' i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hBK).toRingHom).ne hci
      obtain ⟨hdiff_ne, hdiff_val⟩ := hact_pi_pow_exact σ hσ (i : ℕ) hi_ge1 i.2
      refine ⟨mul_ne_zero hinc_ne hdiff_ne, ?_⟩
      dsimp [d_term, v_term]
      rw [hvalK_mul _ _ hinc_ne hdiff_ne, hval_BK (c' i), hdiff_val]
      ring
    have hval_d_sum_ge : ∀ (S : Finset (Fin p)) (m : ℤ),
        (∀ i ∈ S, c' i = 0 ∨ m ≤ v_term c' i + (t : ℤ)) →
          ((∑ i ∈ S, d_term σ c' i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, d_term σ c' i)) := by
      intro S m hS
      apply hval_finset_sum_K S (d_term σ c') m
      intro i hi
      by_cases hci : c' i = 0
      · exact Or.inl (hd_term_zero i hci)
      · right
        rw [(hd_term_nz i hci).2]
        exact (hS i hi).resolve_left hci
    refine ⟨c₀, hact_z_eq, ?_⟩
    let S_nz : Finset (Fin p) := (Finset.univ : Finset (Fin p)).filter (fun j => c' j ≠ 0)
    by_cases hS_ne : S_nz.Nonempty
    · right
      obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term c') hS_ne
      have hci₀ : c' i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
      have hi₀_ne0 : i₀ ≠ i_zero := fun heq => hci₀ (heq ▸ hc'0)
      have hi₀_ge1 : 1 ≤ i₀.1 := by
        have hne : i₀.1 ≠ 0 := fun h0 => hi₀_ne0 (Fin.ext h0)
        omega
      have herase_t : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
          c' j = 0 ∨ v_term c' i₀ + 1 ≤ v_term c' j := by
        intro j hj
        have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
        by_cases hcj : c' j = 0
        · exact Or.inl hcj
        · right
          have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
          have hle_j : v_term c' i₀ ≤ v_term c' j := hi₀_min j hj_mem
          have hne_v : v_term c' i₀ ≠ v_term c' j := fun heq => hj_ne (hv_term_inj c' i₀ j heq).symm
          omega
      have hrem_t := hval_t_sum_ge c' ((Finset.univ : Finset (Fin p)).erase i₀)
        (v_term c' i₀ + 1) herase_t
      obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz c' i₀ hci₀
      rw [← hti₀_val] at hrem_t
      have hstrict_z := hval_strict_K (t_term c' i₀)
        (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term c' j) hti₀_ne hrem_t
      rw [Finset.add_sum_erase Finset.univ (t_term c') (Finset.mem_univ i₀),
        ← hz_eq, hti₀_val] at hstrict_z
      have herase_d : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
          c' j = 0 ∨ (v_term c' i₀ + (t : ℤ)) + 1 ≤ v_term c' j + (t : ℤ) := by
        intro j hj
        rcases herase_t j hj with h0 | hge
        · exact Or.inl h0
        · right; omega
      have hrem_d := hval_d_sum_ge ((Finset.univ : Finset (Fin p)).erase i₀)
        ((v_term c' i₀ + (t : ℤ)) + 1) herase_d
      obtain ⟨hdi₀_ne, hdi₀_val⟩ := hd_term_nz i₀ hci₀
      rw [← hdi₀_val] at hrem_d
      have hstrict_d := hval_strict_K (d_term σ c' i₀)
        (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, d_term σ c' j) hdi₀_ne hrem_d
      rw [Finset.add_sum_erase Finset.univ (d_term σ c') (Finset.mem_univ i₀),
        ← hact_w_eq, hdi₀_val] at hstrict_d
      have hndvd_z : ¬ ((p : ℤ) ∣ valL F K z) := by
        rw [Int.dvd_iff_emod_eq_zero, hstrict_z.2, hv_term_mod c' i₀]
        omega
      refine ⟨hstrict_z.1, hstrict_d.1, ?_, hndvd_z⟩
      rw [hstrict_d.2, hstrict_z.2]
    · left
      rw [Finset.not_nonempty_iff_eq_empty] at hS_ne
      have hall_zero : ∀ j : Fin p, c' j = 0 := by
        intro j
        by_contra hcj
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        rw [hS_ne] at hj_mem
        exact Finset.notMem_empty j hj_mem
      have hz0 : z = 0 := by
        rw [hz_eq]
        exact Finset.sum_eq_zero (fun j _ => ht_term_zero c' j (hall_zero j))
      have hd0 : act σ w - w = 0 := by
        rw [hact_w_eq]
        exact Finset.sum_eq_zero (fun j _ => hd_term_zero j (hall_zero j))
      exact ⟨hz0, hd0⟩

  
  have hcard_gt1 : 1 < Fintype.card G := by rw [hcard_G]; exact hp_gt1
  obtain ⟨σ, hσ_ne1⟩ := @Fintype.exists_ne_of_one_lt_card G _ hcard_gt1 1
  have hσ_pow : σ ^ p = 1 := by
    rw [← hcard_G]
    exact pow_card_eq_one
  have hord : orderOf σ = p := orderOf_eq_prime hσ_pow hσ_ne1
  let ψ_pow : Fin p → G := fun k => σ ^ (k : ℕ)
  have hinj_pow : Function.Injective ψ_pow := by
    intro i j hij
    dsimp [ψ_pow] at hij
    have hi : (i : ℕ) ∈ Set.Iio (orderOf σ) := by
      rw [Set.mem_Iio, hord]
      exact i.2
    have hj : (j : ℕ) ∈ Set.Iio (orderOf σ) := by
      rw [Set.mem_Iio, hord]
      exact j.2
    exact Fin.ext (pow_injOn_Iio_orderOf hi hj hij)
  have hbij_pow : Function.Bijective ψ_pow :=
    (Fintype.bijective_iff_injective_and_card ψ_pow).mpr
      ⟨hinj_pow, by rw [Fintype.card_fin, hcard_G]⟩
  let e_pow : Fin p ≃ G := Equiv.ofBijective ψ_pow hbij_pow
  have horbit_tr : (∑ k ∈ Finset.range p, act (σ ^ k) y₁) = 1 := by
    rw [← Fin.sum_univ_eq_sum_range (fun k => act (σ ^ k) y₁) p]
    change (∑ k : Fin p, act (e_pow k) y₁) = 1
    rw [Equiv.sum_comp e_pow (fun τ => act τ y₁), ← hact_trace y₁, hy₁_tr, map_one]
  have horbit_tr_shift : (∑ k ∈ Finset.range p, act (σ ^ (k + 1)) y₁) = 1 := by
    have h1 := Finset.sum_range_succ (fun k => act (σ ^ k) y₁) p
    have h2 := Finset.sum_range_succ' (fun k => act (σ ^ k) y₁) p
    rw [horbit_tr, hσ_pow, hact_one] at h1
    rw [pow_zero, hact_one] at h2
    linear_combination h1 - h2

  let g : ℕ → K := fun k => (k : K) * act (σ ^ k) y₁
  set d_raw : K := - ∑ k ∈ Finset.range p, g k
  have hg_succ : (∑ k ∈ Finset.range (p + 1), g k) =
      (∑ k ∈ Finset.range p, g k) + ((p : ℕ) : K) * y₁ := by
    rw [Finset.sum_range_succ]
    dsimp [g]
    rw [hσ_pow, hact_one]
  have hg_step : ∀ k : ℕ, g (k + 1) = act σ (g k) + act (σ ^ (k + 1)) y₁ := by
    intro k
    have hact_gk : act σ (g k) = (k : K) * act (σ ^ (k + 1)) y₁ := by
      change φ σ ((k : K) * act (σ ^ k) y₁) = _
      rw [map_mul (φ σ), map_natCast (φ σ) k, hφ_apply, ← hact_mul σ (σ ^ k) y₁, ← pow_succ' σ k]
    dsimp [g]
    rw [hact_gk]
    push_cast
    ring
  have hg_succ' : (∑ k ∈ Finset.range (p + 1), g k) = - act σ d_raw + 1 := by
    rw [Finset.sum_range_succ' g p]
    have hg0 : g 0 = 0 := by dsimp [g]; simp
    have hsum_step : (∑ k ∈ Finset.range p, g (k + 1)) =
        (∑ k ∈ Finset.range p, act σ (g k)) + (∑ k ∈ Finset.range p, act (σ ^ (k + 1)) y₁) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun k _ => hg_step k)
    have hact_sum : (∑ k ∈ Finset.range p, act σ (g k)) = - act σ d_raw := by
      dsimp [d_raw]
      change (∑ k ∈ Finset.range p, φ σ (g k)) = - φ σ (- ∑ k ∈ Finset.range p, g k)
      rw [map_neg (φ σ), neg_neg, map_sum (φ σ)]
    rw [hg0, add_zero, hsum_step, hact_sum, horbit_tr_shift]
  have hd_raw_shift : act σ d_raw - d_raw = 1 - ((p : ℕ) : K) * y₁ := by
    have h_eq : (∑ k ∈ Finset.range p, g k) + ((p : ℕ) : K) * y₁ = - act σ d_raw + 1 :=
      hg_succ.symm.trans hg_succ'
    calc act σ d_raw - d_raw
      _ = act σ d_raw + ∑ k ∈ Finset.range p, g k := by dsimp [d_raw]; ring
      _ = act σ d_raw + ((- act σ d_raw + 1) - ((p : ℕ) : K) * y₁) := by
        rw [eq_sub_iff_add_eq.mpr h_eq]
      _ = 1 - ((p : ℕ) : K) * y₁ := by ring

  obtain ⟨c₀_d, hd_shift_eq, hd_dich⟩ := hconst_free_shift d_raw σ hσ_ne1
  set d : K := d_raw - IntermediateField.inclusion hBK c₀_d
  have hd_shift : act σ d - d = 1 - ((p : ℕ) : K) * y₁ := hd_shift_eq.trans hd_raw_shift

  refine ⟨?_, ?_, ?_⟩
  · 
    by_cases hp0 : ((p : ℕ) : K) = 0
    · exact Or.inl hp0
    · right
      by_contra hlt
      push_neg at hlt
      have hincl_p : IntermediateField.inclusion hBK ((p : ℕ) : B) = ((p : ℕ) : K) :=
        map_natCast (IntermediateField.inclusion hBK) p
      have hval_p_B : valL F K ((p : ℕ) : K) = (p : ℤ) * valL F B ((p : ℕ) : B) := by
        rw [← hincl_p, hval_BK]
      set w₁ : K := - (((p : ℕ) : K) * y₁)
      have hw₁_ne0 : w₁ ≠ 0 := neg_ne_zero.mpr (mul_ne_zero hp0 hy₁_ne0)
      have hw₁_val : valL F K w₁ = valL F K ((p : ℕ) : K) - (((p - 1 : ℕ) : ℤ) * (t : ℤ)) := by
        dsimp [w₁]
        rw [hvalK_neg, hvalK_mul ((p : ℕ) : K) y₁ hp0 hy₁_ne0, hy₁_val]
        ring
      have hcast_pt : (((p - 1) * t : ℕ) : ℤ) = ((p - 1 : ℕ) : ℤ) * (t : ℤ) :=
        Nat.cast_mul (p - 1) t
      have hw₁_lt0 : valL F K w₁ + 1 ≤ valL F K (1 : K) := by
        rw [hvalK_1, hw₁_val]
        omega
      have hstrict := hval_strict_K w₁ 1 hw₁_ne0 (Or.inr hw₁_lt0)
      have hw₁_add1 : w₁ + 1 = act σ d_raw - d_raw := by
        rw [hd_raw_shift]
        dsimp [w₁]
        ring
      rw [hw₁_add1] at hstrict
      rcases hd_dich with ⟨_, hd0⟩ | ⟨_, _, hd_val_eq, hndvd_d⟩
      · exact hstrict.1 hd0
      · have hd_eq_mul : valL F K d = (p : ℤ) * (valL F B ((p : ℕ) : B) - (t : ℤ)) := by
          have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
          have h1 := hstrict.2
          rw [hw₁_val, hval_p_B, hp1] at h1
          linarith [hd_val_eq, h1]
        exact hndvd_d ⟨valL F B ((p : ℕ) : B) - (t : ℤ), hd_eq_mul⟩
  · 
    intro M_p hMp_ge hp_Mp
    set w₂ : K := - (((p : ℕ) : K) * y₁)
    have hw₂_bound : w₂ = 0 ∨ M_p - ((p - 1 : ℕ) : ℤ) * (t : ℤ) ≤ valL F K w₂ := by
      have hmul := hval_mul_ge_K M_p (-(((p - 1 : ℕ) : ℤ) * (t : ℤ)))
        ((p : ℕ) : K) y₁ hp_Mp (Or.inr (by rw [hy₁_val]))
      have hneg := hval_neg_ge_K (M_p + -(((p - 1 : ℕ) : ℤ) * (t : ℤ)))
        (((p : ℕ) : K) * y₁) hmul
      rcases hneg with h0 | hge
      · exact Or.inl h0
      · right
        change M_p + -(((p - 1 : ℕ) : ℤ) * (t : ℤ)) ≤ valL F K w₂ at hge
        omega
    have hw₂_ge1 : w₂ = 0 ∨ valL F K (1 : K) + 1 ≤ valL F K w₂ := by
      rcases hw₂_bound with h0 | hge
      · exact Or.inl h0
      · right
        rw [hvalK_1]
        omega
    have hstrict := hval_strict_K (1 : K) w₂ one_ne_zero hw₂_ge1
    have h1_add_w₂ : (1 : K) + w₂ = act σ d_raw - d_raw := by
      rw [hd_raw_shift]
      dsimp [w₂]
      ring
    rw [h1_add_w₂, hvalK_1] at hstrict
    rcases hd_dich with ⟨_, hd0⟩ | ⟨_, _, hd_val_eq, hndvd_d⟩
    · exact False.elim (hstrict.1 hd0)
    · have hd_val : valL F K d = -(t : ℤ) := by
        linarith [hstrict.2, hd_val_eq]
      have ht_ndvd : ¬ (p ∣ t) := by
        intro hdvd_t
        have hdvd_z : (p : ℤ) ∣ (t : ℤ) := Int.ofNat_dvd.mpr hdvd_t
        have hdvd_neg : (p : ℤ) ∣ -(t : ℤ) := dvd_neg.mpr hdvd_z
        rw [← hd_val] at hdvd_neg
        exact hndvd_d hdvd_neg
      have hd_shift_w₂ : act σ d - (d + 1) = w₂ := by
        have h1 : act σ d - (d + 1) = (act σ d - d) - 1 := by ring
        rw [h1, hd_shift]
        dsimp [w₂]
        ring
      refine ⟨ht_ndvd, σ, d, hσ_ne1, hd_val, ?_⟩
      rw [hd_shift_w₂]
      exact hw₂_bound
  · 
    intro w σ' M hσ' hw_shift
    obtain ⟨c₀, _, h_or⟩ := hconst_free_shift w σ' hσ'
    refine ⟨c₀, ?_⟩
    rcases h_or with ⟨hz0, _⟩ | ⟨_, hact_ne0, hval_eq, _⟩
    · exact Or.inl hz0
    · right
      have hge := hw_shift.resolve_left hact_ne0
      omega

theorem ld_wild_tot_ram_coprime_neg_val_power_basis (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁) (p : ℕ) (hPrime : Nat.Prime p)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = p)
    (t₁ : ℕ) (ht₁_ndvd : ¬ (p ∣ t₁))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ w : K₁, valL F K₁ (-w) = valL F K₁ w) ∧
      (∀ w₁ w₂ : K₁, w₁ ≠ 0 → w₂ ≠ 0 → valL F K₁ (w₁ * w₂) = valL F K₁ w₁ + valL F K₁ w₂) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ (k : ℤ) (w₁ w₂ : K₁),
        (w₁ = 0 ∨ k ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k ≤ valL F K₁ w₂) →
          (w₁ + w₂ = 0 ∨ k ≤ valL F K₁ (w₁ + w₂))))
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y) :
    ∀ Δ : K₁ˣ,
      valL F K₁ (Δ : K₁) = -(t₁ : ℤ) →
      ∀ w : K₁, ∃ Y : Fin p → E',
        w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (w = 0 ∨ m ≤ valL F K₁ w) ↔
            ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ) :=
by
  rcases hvalK₁_props with ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁, hval_add_K₁⟩
  intro Δ hΔ_val w
  have hval_pow_K₁ : ∀ (x : K₁) (n : ℕ), x ≠ 0 → valL F K₁ (x ^ n) = (n : ℤ) * valL F K₁ x := by
    intro x n hx
    induction n with
    | zero =>
      rw [pow_zero, hval1_K₁]
      ring
    | succ n ih =>
      have hxn : x ^ n ≠ 0 := pow_ne_zero n hx
      rw [pow_succ, hval_mul_K₁ (x ^ n) x hxn hx, ih]
      push_cast
      ring
  have hval_strict_K₁ : ∀ (w₁ w₂ : K₁), w₁ ≠ 0 →
      (w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ w₂) →
      w₁ + w₂ ≠ 0 ∧ valL F K₁ (w₁ + w₂) = valL F K₁ w₁ := by
    intro w₁ w₂ hw₁ hw₂
    have hw₂_ge : w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ w₂ := by
      rcases hw₂ with rfl | hge
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hsum_ge : w₁ + w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ (w₁ + w₂) :=
      hval_add_K₁ (valL F K₁ w₁) w₁ w₂ (Or.inr le_rfl) hw₂_ge
    have hnot_gt : ¬ (w₁ + w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := by
      intro hgt
      have hneg_w₂ : -w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ (-w₂) := by
        rcases hw₂ with rfl | hge
        · simp
        · right
          rw [hval_neg_K₁]
          exact hge
      have hw₁_gt := hval_add_K₁ (valL F K₁ w₁ + 1) (w₁ + w₂) (-w₂) hgt hneg_w₂
      have heq : (w₁ + w₂) + (-w₂) = w₁ := by ring
      rw [heq] at hw₁_gt
      rcases hw₁_gt with hw₁0 | hle
      · exact hw₁ hw₁0
      · omega
    rcases hsum_ge with hsum0 | hle
    · exfalso
      exact hnot_gt (Or.inl hsum0)
    · refine ⟨fun hsum0 => hnot_gt (Or.inl hsum0), ?_⟩
      have hlt : ¬ (valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) :=
        fun h => hnot_gt (Or.inr h)
      omega
  let t_term : (Fin p → E') → Fin p → K₁ :=
    fun Y i => IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))
  let v_term : (Fin p → E') → Fin p → ℤ :=
    fun Y i => (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)
  have ht_term_zero : ∀ (Y : Fin p → E') (i : Fin p), Y i = 0 → t_term Y i = 0 := by
    intro Y i hYi
    dsimp [t_term]
    rw [hYi, map_zero, zero_mul]
  have ht_term_nz : ∀ (Y : Fin p → E') (i : Fin p), Y i ≠ 0 →
      t_term Y i ≠ 0 ∧ valL F K₁ (t_term Y i) = v_term Y i := by
    intro Y i hYi
    dsimp [t_term, v_term]
    have hincl_ne : IntermediateField.inclusion hE'K₁ (Y i) ≠ 0 := by
      intro h0
      exact hYi ((IntermediateField.inclusion hE'K₁).injective (h0.trans (map_zero _).symm))
    have hΔ_ne : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
    have hpow_ne : (Δ : K₁) ^ (i : ℕ) ≠ 0 := pow_ne_zero (i : ℕ) hΔ_ne
    refine ⟨mul_ne_zero hincl_ne hpow_ne, ?_⟩
    rw [hval_mul_K₁ _ _ hincl_ne hpow_ne, hval_E'K₁ (Y i), hval_pow_K₁ (Δ : K₁) (i : ℕ) hΔ_ne, hΔ_val]
    ring
  have hv_term_inj_le : ∀ (Y : Fin p → E') (i j : Fin p),
      (i : ℕ) ≤ (j : ℕ) → v_term Y i = v_term Y j → i = j := by
    intro Y i j hij_le hij
    dsimp [v_term] at hij
    set d : ℕ := (j : ℕ) - (i : ℕ)
    set v_diff : ℤ := valL F E' (Y j) - valL F E' (Y i)
    have hd_cast : (d : ℤ) = (j : ℤ) - (i : ℤ) := by
      dsimp [d]
      omega
    have hrel : (d : ℤ) * (t₁ : ℤ) = (p : ℤ) * v_diff := by
      dsimp [v_diff]
      rw [hd_cast]
      linarith
    have hp_pos : 0 < p := hPrime.pos
    have hv_diff_nonneg : 0 ≤ v_diff := by
      have hdt_nonneg : 0 ≤ (d : ℤ) * (t₁ : ℤ) :=
        mul_nonneg (Nat.cast_nonneg d) (Nat.cast_nonneg t₁)
      rw [hrel] at hdt_nonneg
      by_contra hlt
      have hneg : v_diff < 0 := not_le.mp hlt
      have hp_pos_z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
      have hmul_neg : (p : ℤ) * v_diff < 0 := mul_neg_of_pos_of_neg hp_pos_z hneg
      omega
    set q : ℕ := v_diff.toNat
    have hq_cast : (q : ℤ) = v_diff := Int.toNat_of_nonneg hv_diff_nonneg
    have hrel_nat_z : ((d * t₁ : ℕ) : ℤ) = ((p * q : ℕ) : ℤ) := by
      push_cast
      rw [hq_cast, hrel]
    have hrel_nat : d * t₁ = p * q := by exact_mod_cast hrel_nat_z
    have hdvd_mul : p ∣ d * t₁ := ⟨q, hrel_nat⟩
    have hdvd_d : p ∣ d := (hPrime.dvd_mul.mp hdvd_mul).resolve_right ht₁_ndvd
    have hd_lt : d < p := by
      dsimp [d]
      have hj_lt : (j : ℕ) < p := j.isLt
      omega
    have hd_eq0 : d = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_d hd_lt
    apply Fin.ext
    dsimp [d] at hd_eq0
    omega
  have hv_term_inj : ∀ (Y : Fin p → E') (i j : Fin p), v_term Y i = v_term Y j → i = j := by
    intro Y i j hij
    rcases le_total (i : ℕ) (j : ℕ) with hij_le | hji_le
    · exact hv_term_inj_le Y i j hij_le hij
    · exact (hv_term_inj_le Y j i hji_le hij.symm).symm
  have hval_sum_ge : ∀ (Y : Fin p → E') (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, Y i = 0 ∨ m ≤ v_term Y i) →
      (∑ i ∈ S, t_term Y i) = 0 ∨ m ≤ valL F K₁ (∑ i ∈ S, t_term Y i) := by
    intro Y S m
    induction S using Finset.induction_on with
    | empty =>
      intro _
      left
      simp
    | @insert a s ha ih =>
      intro hS
      rw [Finset.sum_insert ha]
      have ha_bound : t_term Y a = 0 ∨ m ≤ valL F K₁ (t_term Y a) := by
        rcases hS a (Finset.mem_insert_self a s) with hYa0 | hYa_ge
        · exact Or.inl (ht_term_zero Y a hYa0)
        · by_cases hYa : Y a = 0
          · exact Or.inl (ht_term_zero Y a hYa)
          · right
            rw [(ht_term_nz Y a hYa).2]
            exact hYa_ge
      have hs_bound : (∑ i ∈ s, t_term Y i) = 0 ∨ m ≤ valL F K₁ (∑ i ∈ s, t_term Y i) :=
        ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K₁ m (t_term Y a) (∑ i ∈ s, t_term Y i) ha_bound hs_bound
  have hsum_min_nz : ∀ (Y : Fin p → E') (i : Fin p), Y i ≠ 0 →
      ∃ i₀ : Fin p, Y i₀ ≠ 0 ∧ v_term Y i₀ ≤ v_term Y i ∧
        (∑ j : Fin p, t_term Y j) ≠ 0 ∧
        valL F K₁ (∑ j : Fin p, t_term Y j) = v_term Y i₀ := by
    intro Y i hYi
    let S_nz : Finset (Fin p) := Finset.univ.filter (fun j : Fin p => Y j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hYi⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term Y) ⟨i, hi_mem⟩
    have hi₀_nz : Y i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hi₀_le_i : v_term Y i₀ ≤ v_term Y i := hi₀_min i hi_mem
    have herase_bound : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
        Y j = 0 ∨ v_term Y i₀ + 1 ≤ v_term Y j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hYj : Y j = 0
      · exact Or.inl hYj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hYj⟩
        have hle : v_term Y i₀ ≤ v_term Y j := hi₀_min j hj_mem
        have hne : v_term Y i₀ ≠ v_term Y j := fun heq => hj_ne (hv_term_inj Y i₀ j heq).symm
        omega
    have herase_sum := hval_sum_ge Y ((Finset.univ : Finset (Fin p)).erase i₀) (v_term Y i₀ + 1) herase_bound
    obtain ⟨ht_i₀_nz, ht_i₀_val⟩ := ht_term_nz Y i₀ hi₀_nz
    have herase_sum' :
        (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term Y j) = 0 ∨
          valL F K₁ (t_term Y i₀) + 1 ≤ valL F K₁ (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term Y j) := by
      rw [ht_i₀_val]
      exact herase_sum
    obtain ⟨hadd_nz, hadd_val⟩ := hval_strict_K₁ (t_term Y i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term Y j) ht_i₀_nz herase_sum'
    have hsum_split : t_term Y i₀ + ∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term Y j =
        ∑ j : Fin p, t_term Y j :=
      Finset.add_sum_erase Finset.univ (t_term Y) (Finset.mem_univ i₀)
    rw [hsum_split] at hadd_nz hadd_val
    rw [ht_i₀_val] at hadd_val
    exact ⟨i₀, hi₀_nz, hi₀_le_i, hadd_nz, hadd_val⟩
  have hval_sum_iff : ∀ (Y : Fin p → E') (m : ℤ),
      ((∑ i : Fin p, t_term Y i) = 0 ∨ m ≤ valL F K₁ (∑ i : Fin p, t_term Y i)) ↔
        ∀ i : Fin p, Y i = 0 ∨ m ≤ v_term Y i := by
    intro Y m
    refine ⟨?_, ?_⟩
    · intro hsum i
      by_cases hYi : Y i = 0
      · exact Or.inl hYi
      · right
        obtain ⟨i₀, _, hi₀_le, hsum_nz, hsum_val⟩ := hsum_min_nz Y i hYi
        rcases hsum with h0 | hm_le
        · exact False.elim (hsum_nz h0)
        · rw [hsum_val] at hm_le
          exact le_trans hm_le hi₀_le
    · intro h_all
      exact hval_sum_ge Y Finset.univ m (fun i _ => h_all i)
  have hlin_zero : ∀ (Y : Fin p → E'), (∑ i : Fin p, t_term Y i) = 0 → ∀ i : Fin p, Y i = 0 := by
    intro Y hsum i
    by_contra hYi
    obtain ⟨_, _, _, hsum_nz, _⟩ := hsum_min_nz Y i hYi
    exact hsum_nz hsum
  let K₁' := IntermediateField.extendScalars hE'K₁
  let eF : K₁ ≃ₐ[F] K₁' :=
    { toExtendScalars F hE'K₁ with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hE'K₁).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K₁' := Module.Finite.equiv eF.toLinearEquiv
  haveI : IsScalarTower F E' K₁' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional E' K₁' := Module.Finite.of_restrictScalars_finite F E' K₁'
  let b_vec : Fin p → K₁' := fun i => (toExtendScalars F hE'K₁ (Δ : K₁)) ^ (i : ℕ)
  have hto_sum : ∀ (Y : Fin p → E'),
      toExtendScalars F hE'K₁ (∑ i : Fin p, t_term Y i) = ∑ i : Fin p, Y i • b_vec i := by
    intro Y
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    dsimp [t_term, b_vec]
    rw [map_mul, map_pow]
    rfl
  have hli : LinearIndependent E' b_vec := by
    rw [Fintype.linearIndependent_iff]
    intro Y hY
    have hsum0 : ∑ i : Fin p, t_term Y i = 0 := by
      apply eF.injective
      change toExtendScalars F hE'K₁ (∑ i : Fin p, t_term Y i) = toExtendScalars F hE'K₁ 0
      rw [hto_sum Y, hY, map_zero]
    exact hlin_zero Y hsum0
  haveI : Nonempty (Fin p) := ⟨⟨0, hPrime.pos⟩⟩
  have hcard : Fintype.card (Fin p) = Module.finrank E' K₁' :=
    (Fintype.card_fin p).trans hdegE'K₁.symm
  let B : Module.Basis (Fin p) E' K₁' := basisOfLinearIndependentOfCardEqFinrank hli hcard
  let Y : Fin p → E' := fun i => B.repr (toExtendScalars F hE'K₁ w) i
  have hw_eq : w = ∑ i : Fin p, t_term Y i := by
    apply eF.injective
    change toExtendScalars F hE'K₁ w = toExtendScalars F hE'K₁ (∑ i : Fin p, t_term Y i)
    rw [hto_sum Y]
    have hrepr := B.sum_repr (toExtendScalars F hE'K₁ w)
    have hB_coe : (B : Fin p → K₁') = b_vec :=
      coe_basisOfLinearIndependentOfCardEqFinrank hli hcard
    dsimp [Y]
    rw [← hB_coe]
    exact hrepr.symm
  refine ⟨Y, hw_eq, fun m => ?_⟩
  rw [hw_eq]
  exact hval_sum_iff Y m

theorem ld_wild_odd_tot_ram_as_iterate_and_w0_shift (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁) (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t₁ t₂ : ℕ) (ht₁_ge1 : 1 ≤ t₁) (ht_le : t₁ ≤ t₂)
    (ht₁_ndvd : ¬ (p ∣ t₁))
    (hp_valK₁ : ((p : ℕ) : K₁) = 0 ∨ ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ y : E', valL F E' (-y) = valL F E' y) ∧
      (∀ y₁ y₂ : E', y₁ ≠ 0 → y₂ ≠ 0 → valL F E' (y₁ * y₂) = valL F E' y₁ + valL F E' y₂) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ (k : ℤ) (y₁ y₂ : E'),
        (y₁ = 0 ∨ k ≤ valL F E' y₁) → (y₂ = 0 ∨ k ≤ valL F E' y₂) →
          (y₁ + y₂ = 0 ∨ k ≤ valL F E' (y₁ + y₂))))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ w : K₁, valL F K₁ (-w) = valL F K₁ w) ∧
      (∀ w₁ w₂ : K₁, w₁ ≠ 0 → w₂ ≠ 0 → valL F K₁ (w₁ * w₂) = valL F K₁ w₁ + valL F K₁ w₂) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ (k : ℤ) (w₁ w₂ : K₁),
        (w₁ = 0 ∨ k ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k ≤ valL F K₁ w₂) →
          (w₁ + w₂ = 0 ∨ k ≤ valL F K₁ (w₁ + w₂))))
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y) :
    (∀ d d' : K₁,
      valL F K₁ d = -(t₁ : ℤ) →
      (d' - (d + 1) = 0 ∨
        ((p * (p - 1) * t₂ : ℕ) : ℤ) - (((p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (d' - (d + 1))) →
      (d' ^ p - d') - (d ^ p - d) = 0 ∨
        ((p * (p - 1) * t₂ : ℕ) : ℤ) - (((p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ ((d' ^ p - d') - (d ^ p - d))) ∧
    (∀ (d : K₁) (a₀ : E'),
      valL F K₁ d = -(t₁ : ℤ) →
      (d ^ p - d - IntermediateField.inclusion hE'K₁ a₀ = 0 ∨
        (1 : ℤ) ≤ valL F K₁ (d ^ p - d - IntermediateField.inclusion hE'K₁ a₀)) →
      ∀ N : ℕ, ∃ Δ₀ : K₁ˣ,
        valL F K₁ (Δ₀ : K₁) = -(t₁ : ℤ) ∧
        valL F E' a₀ = -(t₁ : ℤ) ∧
        ((Δ₀ : K₁) ^ p - (Δ₀ : K₁) - IntermediateField.inclusion hE'K₁ a₀ = 0 ∨
          (N : ℤ) ≤ valL F K₁ ((Δ₀ : K₁) ^ p - (Δ₀ : K₁) - IntermediateField.inclusion hE'K₁ a₀))) ∧
    (∀ (N : ℕ) (Δ : K₁ˣ) (a : E'),
      valL F K₁ (Δ : K₁) = -(t₁ : ℤ) →
      valL F E' a = -(t₁ : ℤ) →
      ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a = 0 ∨
        (1 : ℤ) ≤ valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a)) →
      ∀ w₀ : E',
        (w₀ = 0 ∨ -((t₁ / p : ℕ) : ℤ) ≤ valL F E' w₀) →
        ∃ Δ' : K₁ˣ,
          valL F K₁ (Δ' : K₁) = -(t₁ : ℤ) ∧
          ((Δ' : K₁) ^ p - (Δ' : K₁) -
            IntermediateField.inclusion hE'K₁ (a + w₀ ^ p - w₀) = 0 ∨
            (N : ℤ) ≤
              valL F K₁ ((Δ' : K₁) ^ p - (Δ' : K₁) -
                IntermediateField.inclusion hE'K₁ (a + w₀ ^ p - w₀)))) :=
by
  obtain ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, hvalK₁_add⟩ :=
    hvalK₁_props
  have val_neg_K₁ : ∀ {k : ℤ} {w : K₁},
      (w = 0 ∨ k ≤ valL F K₁ w) → (-w = 0 ∨ k ≤ valL F K₁ (-w)) := by
    intro k w hw
    rcases hw with rfl | hw
    · simp
    · right
      rw [hvalK₁_neg w]
      exact hw
  have val_add_K₁ : ∀ {k : ℤ} {w₁ w₂ : K₁},
      (w₁ = 0 ∨ k ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k ≤ valL F K₁ w₂) →
        (w₁ + w₂ = 0 ∨ k ≤ valL F K₁ (w₁ + w₂)) := by
    intro k w₁ w₂ hw₁ hw₂
    exact hvalK₁_add k w₁ w₂ hw₁ hw₂
  have val_sub_K₁ : ∀ {k : ℤ} {w₁ w₂ : K₁},
      (w₁ = 0 ∨ k ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k ≤ valL F K₁ w₂) →
        (w₁ - w₂ = 0 ∨ k ≤ valL F K₁ (w₁ - w₂)) := by
    intro k w₁ w₂ hw₁ hw₂
    rw [sub_eq_add_neg]
    exact val_add_K₁ hw₁ (val_neg_K₁ hw₂)
  have val_mul_K₁ : ∀ {k₁ k₂ : ℤ} {w₁ w₂ : K₁},
      (w₁ = 0 ∨ k₁ ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k₂ ≤ valL F K₁ w₂) →
        (w₁ * w₂ = 0 ∨ k₁ + k₂ ≤ valL F K₁ (w₁ * w₂)) := by
    intro k₁ k₂ w₁ w₂ hw₁ hw₂
    by_cases hw₁0 : w₁ = 0
    · exact Or.inl (by simp [hw₁0])
    · by_cases hw₂0 : w₂ = 0
      · exact Or.inl (by simp [hw₂0])
      · right
        rw [hvalK₁_mul w₁ w₂ hw₁0 hw₂0]
        exact add_le_add (hw₁.resolve_left hw₁0) (hw₂.resolve_left hw₂0)
  have val_mono_K₁ : ∀ {k₁ k₂ : ℤ} {w : K₁},
      k₁ ≤ k₂ → (w = 0 ∨ k₂ ≤ valL F K₁ w) → (w = 0 ∨ k₁ ≤ valL F K₁ w) := by
    intro k₁ k₂ w hk hw
    exact hw.imp_right (le_trans hk)
  have val_pow_K₁ : ∀ {q : ℤ} {w : K₁},
      (w = 0 ∨ q ≤ valL F K₁ w) → ∀ (k : ℕ), w ^ k = 0 ∨ (k : ℤ) * q ≤ valL F K₁ (w ^ k) := by
    intro q w hw k
    induction k with
    | zero =>
      right
      rw [pow_zero, hvalK₁_1]
      omega
    | succ k ih =>
      rw [pow_succ]
      have hmul := val_mul_K₁ ih hw
      refine val_mono_K₁ ?_ hmul
      push_cast
      linarith
  have val_sum_K₁ : ∀ (S : Finset ℕ) (f : ℕ → K₁) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ S, f i)) := by
    intro S f k hf
    induction S using Finset.induction_on with
    | empty =>
      exact Or.inl (by simp)
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact val_add_K₁ (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have val_natCast_K₁ : ∀ (n : ℕ), ((n : ℕ) : K₁) = 0 ∨ (0 : ℤ) ≤ valL F K₁ ((n : ℕ) : K₁) := by
    intro n
    induction n with
    | zero => exact Or.inl (by simp)
    | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one]
      exact val_add_K₁ ih (Or.inr (by rw [hvalK₁_1]))
  have hval_pow_eq_K₁ : ∀ {w : K₁}, w ≠ 0 → ∀ (k : ℕ),
      w ^ k ≠ 0 ∧ valL F K₁ (w ^ k) = (k : ℤ) * valL F K₁ w := by
    intro w hw k
    induction k with
    | zero =>
      exact ⟨by simp, by simp [hvalK₁_1]⟩
    | succ k ih =>
      rw [pow_succ]
      refine ⟨mul_ne_zero ih.1 hw, ?_⟩
      rw [hvalK₁_mul (w ^ k) w ih.1 hw, ih.2]
      push_cast
      ring
  have hval_strict_K₁ : ∀ {w₁ w₂ : K₁},
      w₁ ≠ 0 →
      (w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ w₂) →
      w₁ + w₂ ≠ 0 ∧ valL F K₁ (w₁ + w₂) = valL F K₁ w₁ := by
    intro w₁ w₂ hw₁ hw₂
    have hw₁_ge : w₁ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ w₁ := Or.inr le_rfl
    have hw₂_ge : w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ w₂ := val_mono_K₁ (by omega) hw₂
    have hsum_ge : w₁ + w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ (w₁ + w₂) :=
      val_add_K₁ hw₁_ge hw₂_ge
    have hnot_gt : ¬ (w₁ + w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := by
      intro hgt
      have hsub := val_sub_K₁ hgt hw₂
      have hid : (w₁ + w₂) - w₂ = w₁ := by ring
      rw [hid] at hsub
      rcases hsub with h0 | hle
      · exact hw₁ h0
      · omega
    have hsum_ne : w₁ + w₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hge : valL F K₁ w₁ ≤ valL F K₁ (w₁ + w₂) := hsum_ge.resolve_left hsum_ne
    have hlt : ¬ (valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := fun hle => hnot_gt (Or.inr hle)
    exact ⟨hsum_ne, by omega⟩
  have val_incl_E'K₁ : ∀ {m : ℤ} {y : E'},
      (y = 0 ∨ m ≤ valL F E' y) →
      IntermediateField.inclusion hE'K₁ y = 0 ∨
        (p : ℤ) * m ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ y) := by
    intro m y hy
    rcases hy with rfl | hy
    · exact Or.inl (map_zero _)
    · right
      rw [hval_E'K₁ y]
      exact mul_le_mul_of_nonneg_left hy (Nat.cast_nonneg p)
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := hPrime.pos
  set P₂ : ℤ := ((p * (p - 1) * t₂ : ℕ) : ℤ)
  set B₀ : ℤ := P₂ - (((p - 1) * t₁ : ℕ) : ℤ)
  have hB₀_ge4 : (4 : ℤ) ≤ B₀ := by
    have h1 : (p - 1) * t₁ + 4 ≤ p * (p - 1) * t₂ := by
      have hpt1 : 2 ≤ (p - 1) * t₁ := by
        calc 2 = 2 * 1 := by ring
          _ ≤ (p - 1) * t₁ := Nat.mul_le_mul (by omega) ht₁_ge1
      calc (p - 1) * t₁ + 4
        _ ≤ (p - 1) * t₁ + 2 * ((p - 1) * t₁) := by omega
        _ = 3 * (p - 1) * t₁ := by ring
        _ ≤ p * (p - 1) * t₁ :=
          Nat.mul_le_mul_right t₁ (Nat.mul_le_mul_right (p - 1) hp_ge3)
        _ ≤ p * (p - 1) * t₂ := Nat.mul_le_mul_left (p * (p - 1)) ht_le
    have h1z : (((p - 1) * t₁ : ℕ) : ℤ) + 4 ≤ P₂ := by
      dsimp [P₂]
      exact_mod_cast h1
    push_cast at h1z
    dsimp [B₀]
    linarith
  have hP₂_sub_pt₁ : (3 : ℤ) ≤ P₂ - (p : ℤ) * (t₁ : ℤ) := by
    have h1 : p * t₁ + 3 ≤ p * (p - 1) * t₂ := by
      have hpt1 : 3 ≤ p * t₁ := by
        calc 3 = 3 * 1 := by ring
          _ ≤ p * t₁ := Nat.mul_le_mul hp_ge3 ht₁_ge1
      calc p * t₁ + 3
        _ ≤ p * t₁ + p * t₁ := by omega
        _ = p * 2 * t₁ := by ring
        _ ≤ p * (p - 1) * t₁ :=
          Nat.mul_le_mul_right t₁ (Nat.mul_le_mul_left p (by omega))
        _ ≤ p * (p - 1) * t₂ := Nat.mul_le_mul_left (p * (p - 1)) ht_le
    have h1z : (p : ℤ) * (t₁ : ℤ) + 3 ≤ P₂ := by
      dsimp [P₂]
      exact_mod_cast h1
    linarith
  have hchoose_val : ∀ (j : ℕ), 0 < j → j < p →
      ((Nat.choose p j : ℕ) : K₁) = 0 ∨ P₂ ≤ valL F K₁ ((Nat.choose p j : ℕ) : K₁) := by
    intro j hj_pos hj_lt
    obtain ⟨q, hq⟩ := Nat.Prime.dvd_choose_self hPrime (by omega) hj_lt
    rw [hq, Nat.cast_mul]
    exact val_mono_K₁ (by omega) (val_mul_K₁ hp_valK₁ (val_natCast_K₁ q))
  have hbinom_decomp : ∀ (x y : K₁),
      (x + y) ^ p - (x ^ p + y ^ p) =
        ∑ k ∈ Finset.range (p - 1),
          x ^ (k + 1) * y ^ (p - (k + 1)) * ((Nat.choose p (k + 1) : ℕ) : K₁) := by
    intro x y
    let g : ℕ → K₁ := fun j => x ^ j * y ^ (p - j) * ((Nat.choose p j : ℕ) : K₁)
    have h1 : (x + y) ^ p = ∑ j ∈ Finset.range (p + 1), g j := add_pow x y p
    have h2 : ∑ j ∈ Finset.range (p + 1), g j = (∑ j ∈ Finset.range p, g j) + g p :=
      Finset.sum_range_succ g p
    have hgp : g p = x ^ p := by
      dsimp [g]
      rw [Nat.sub_self, pow_zero, Nat.choose_self, Nat.cast_one, mul_one, mul_one]
    have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp_pos).symm
    have h3 : ∑ j ∈ Finset.range p, g j =
        (∑ k ∈ Finset.range (p - 1), g (k + 1)) + g 0 := by
      conv_lhs => rw [hp_eq]
      exact Finset.sum_range_succ' g (p - 1)
    have hg0 : g 0 = y ^ p := by
      dsimp [g]
      rw [pow_zero, Nat.choose_zero_right, Nat.cast_one, one_mul, mul_one]
    rw [h1, h2, hgp, h3, hg0]
    ring
  have hbinom_cross : ∀ (x y : K₁) (vx vy M : ℤ),
      (x = 0 ∨ vx ≤ valL F K₁ x) →
      (y = 0 ∨ vy ≤ valL F K₁ y) →
      (∀ k < p - 1, M ≤ ((k + 1 : ℕ) : ℤ) * vx + ((p - (k + 1) : ℕ) : ℤ) * vy + P₂) →
      (x + y) ^ p - (x ^ p + y ^ p) = 0 ∨ M ≤ valL F K₁ ((x + y) ^ p - (x ^ p + y ^ p)) := by
    intro x y vx vy M hx hy hM
    rw [hbinom_decomp x y]
    apply val_sum_K₁ (Finset.range (p - 1)) _ M
    intro k hk
    have hk_lt : k < p - 1 := Finset.mem_range.mp hk
    have hx_pow := val_pow_K₁ hx (k + 1)
    have hy_pow := val_pow_K₁ hy (p - (k + 1))
    have hch := hchoose_val (k + 1) (by omega) (by omega)
    exact val_mono_K₁ (hM k hk_lt) (val_mul_K₁ (val_mul_K₁ hx_pow hy_pow) hch)
  have hB₀_eq : P₂ - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) = B₀ := rfl
  have hConj1 : ∀ d d' : K₁,
      valL F K₁ d = -(t₁ : ℤ) →
      (d' - (d + 1) = 0 ∨ B₀ ≤ valL F K₁ (d' - (d + 1))) →
      (d' ^ p - d') - (d ^ p - d) = 0 ∨ B₀ ≤ valL F K₁ ((d' ^ p - d') - (d ^ p - d)) := by
    intro d d' hd_val hd_shift
    set η : K₁ := d' - (d + 1)
    have hd_ge : d = 0 ∨ -(t₁ : ℤ) ≤ valL F K₁ d := Or.inr (by omega)
    have h1_ge : (1 : K₁) = 0 ∨ (0 : ℤ) ≤ valL F K₁ (1 : K₁) := Or.inr (by rw [hvalK₁_1])
    have hd1_ge : d + 1 = 0 ∨ -(t₁ : ℤ) ≤ valL F K₁ (d + 1) :=
      val_add_K₁ hd_ge (val_mono_K₁ (by omega) h1_ge)
    have hid : (d' ^ p - d') - (d ^ p - d) =
        (((d + 1) + η) ^ p - ((d + 1) ^ p + η ^ p)) +
          ((d + 1) ^ p - (d ^ p + 1 ^ p)) + η ^ p - η := by
      dsimp [η]
      ring
    have ht1 : ((d + 1) + η) ^ p - ((d + 1) ^ p + η ^ p) = 0 ∨
        B₀ ≤ valL F K₁ (((d + 1) + η) ^ p - ((d + 1) ^ p + η ^ p)) := by
      apply hbinom_cross (d + 1) η (-(t₁ : ℤ)) B₀ B₀ hd1_ge hd_shift
      intro k hk_lt
      have hk1 : ((k + 1 : ℕ) : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by omega
      have hpk1 : (1 : ℤ) ≤ ((p - (k + 1) : ℕ) : ℤ) := by omega
      nlinarith [hB₀_ge4, hB₀_eq]
    have ht2 : (d + 1) ^ p - (d ^ p + 1 ^ p) = 0 ∨
        B₀ ≤ valL F K₁ ((d + 1) ^ p - (d ^ p + 1 ^ p)) := by
      apply hbinom_cross d 1 (-(t₁ : ℤ)) 0 B₀ hd_ge h1_ge
      intro k hk_lt
      have hk1 : ((k + 1 : ℕ) : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by omega
      nlinarith [hB₀_eq]
    have ht3 : η ^ p = 0 ∨ B₀ ≤ valL F K₁ (η ^ p) := by
      refine val_mono_K₁ ?_ (val_pow_K₁ hd_shift p)
      nlinarith [hp_ge3, hB₀_ge4]
    rw [hid]
    exact val_sub_K₁ (val_add_K₁ (val_add_K₁ ht1 ht2) ht3) hd_shift
  have hConj2 : ∀ (d : K₁) (a₀ : E'),
      valL F K₁ d = -(t₁ : ℤ) →
      (d ^ p - d - IntermediateField.inclusion hE'K₁ a₀ = 0 ∨
        (1 : ℤ) ≤ valL F K₁ (d ^ p - d - IntermediateField.inclusion hE'K₁ a₀)) →
      ∀ N : ℕ, ∃ Δ₀ : K₁ˣ,
        valL F K₁ (Δ₀ : K₁) = -(t₁ : ℤ) ∧
        valL F E' a₀ = -(t₁ : ℤ) ∧
        ((Δ₀ : K₁) ^ p - (Δ₀ : K₁) - IntermediateField.inclusion hE'K₁ a₀ = 0 ∨
          (N : ℤ) ≤ valL F K₁ ((Δ₀ : K₁) ^ p - (Δ₀ : K₁) - IntermediateField.inclusion hE'K₁ a₀)) := by
    intro d a₀ hd_val hd_as N
    have hd_ne : d ≠ 0 := by
      intro h0
      rw [h0, hvalK₁_0] at hd_val
      omega
    obtain ⟨hd_pow_ne, hd_pow_val⟩ := hval_pow_eq_K₁ hd_ne p
    rw [hd_val] at hd_pow_val
    set r₀ : K₁ := d ^ p - d - IntermediateField.inclusion hE'K₁ a₀
    have ha₀_incl_eq : IntermediateField.inclusion hE'K₁ a₀ = d ^ p + (-d - r₀) := by
      dsimp [r₀]
      ring
    have h_neg_d_r₀ : -d - r₀ = 0 ∨ valL F K₁ (d ^ p) + 1 ≤ valL F K₁ (-d - r₀) := by
      have hnd : -d = 0 ∨ -(t₁ : ℤ) ≤ valL F K₁ (-d) :=
        val_neg_K₁ (Or.inr (by omega))
      have hr₀_ge : r₀ = 0 ∨ -(t₁ : ℤ) ≤ valL F K₁ r₀ :=
        val_mono_K₁ (by omega) hd_as
      have hsub := val_sub_K₁ hnd hr₀_ge
      refine val_mono_K₁ ?_ hsub
      rw [hd_pow_val]
      nlinarith [hp_ge3]
    obtain ⟨_, ha₀_incl_val⟩ := hval_strict_K₁ hd_pow_ne h_neg_d_r₀
    rw [← ha₀_incl_eq, hval_E'K₁ a₀, hd_pow_val] at ha₀_incl_val
    have ha₀_val : valL F E' a₀ = -(t₁ : ℤ) := by
      nlinarith [hp_ge3, ha₀_incl_val]
    set T_a₀ : K₁ → K₁ := fun X => X ^ p - IntermediateField.inclusion hE'K₁ a₀
    set x : ℕ → K₁ := fun n => (T_a₀^[n]) d
    have h_iter : ∀ n : ℕ,
        valL F K₁ (x n) = -(t₁ : ℤ) ∧
        ((x n) ^ p - x n - IntermediateField.inclusion hE'K₁ a₀ = 0 ∨
          ((n : ℤ) + 1) ≤ valL F K₁ ((x n) ^ p - x n - IntermediateField.inclusion hE'K₁ a₀)) := by
      intro n
      induction n with
      | zero =>
        have hx0 : x 0 = d := rfl
        rw [hx0, Nat.cast_zero, zero_add]
        exact ⟨hd_val, hd_as⟩
      | succ n ih =>
        obtain ⟨ih_val, ih_as⟩ := ih
        set r_n : K₁ := (x n) ^ p - x n - IntermediateField.inclusion hE'K₁ a₀
        have hxn1 : x (n + 1) = (x n) ^ p - IntermediateField.inclusion hE'K₁ a₀ :=
          Function.iterate_succ_apply' T_a₀ n d
        have hxn1_add : x (n + 1) = x n + r_n := by
          rw [hxn1]
          dsimp [r_n]
          ring
        have hxn_ne : x n ≠ 0 := by
          intro h0
          rw [h0, hvalK₁_0] at ih_val
          omega
        have hr_n_gt : r_n = 0 ∨ valL F K₁ (x n) + 1 ≤ valL F K₁ r_n := by
          rw [ih_val]
          exact val_mono_K₁ (by omega) ih_as
        obtain ⟨_, hxn1_val⟩ := hval_strict_K₁ hxn_ne hr_n_gt
        rw [← hxn1_add, ih_val] at hxn1_val
        have hid_next : (x (n + 1)) ^ p - x (n + 1) - IntermediateField.inclusion hE'K₁ a₀ =
            ((x n + r_n) ^ p - ((x n) ^ p + r_n ^ p)) + r_n ^ p := by
          have h1 : (x (n + 1)) ^ p = (x n + r_n) ^ p := by rw [hxn1_add]
          rw [h1, hxn1]
          ring
        have hcross_next : (x n + r_n) ^ p - ((x n) ^ p + r_n ^ p) = 0 ∨
            (((n + 1 : ℕ) : ℤ) + 1) ≤ valL F K₁ ((x n + r_n) ^ p - ((x n) ^ p + r_n ^ p)) := by
          apply hbinom_cross (x n) r_n (-(t₁ : ℤ)) ((n : ℤ) + 1) (((n + 1 : ℕ) : ℤ) + 1)
            (Or.inr (by omega)) ih_as
          intro k hk_lt
          have hk1 : ((k + 1 : ℕ) : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by omega
          have hpk1 : (1 : ℤ) ≤ ((p - (k + 1) : ℕ) : ℤ) := by omega
          push_cast
          nlinarith [hB₀_ge4, hB₀_eq]
        have hrp_next : r_n ^ p = 0 ∨ (((n + 1 : ℕ) : ℤ) + 1) ≤ valL F K₁ (r_n ^ p) := by
          refine val_mono_K₁ ?_ (val_pow_K₁ ih_as p)
          push_cast
          nlinarith [hp_ge3]
        refine ⟨hxn1_val, ?_⟩
        rw [hid_next]
        exact val_add_K₁ hcross_next hrp_next
    obtain ⟨hxN_val, hxN_as⟩ := h_iter N
    have hxN_ne : x N ≠ 0 := by
      intro h0
      rw [h0, hvalK₁_0] at hxN_val
      omega
    refine ⟨Units.mk0 (x N) hxN_ne, ?_, ha₀_val, ?_⟩
    · exact hxN_val
    · exact val_mono_K₁ (by omega) hxN_as
  refine ⟨hConj1, hConj2, ?_⟩
  intro N Δ a hΔ_val ha_val hΔ_as w₀ hw₀
  have hdiv_lt : p * (t₁ / p) + 1 ≤ t₁ := by
    have hdiv := Nat.div_add_mod t₁ p
    have hmod_ne0 : t₁ % p ≠ 0 := by
      intro h0
      exact ht₁_ndvd (Nat.dvd_iff_mod_eq_zero.mpr h0)
    omega
  have hw₀_K₁ : IntermediateField.inclusion hE'K₁ w₀ = 0 ∨
      -(t₁ : ℤ) + 1 ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ w₀) := by
    refine val_mono_K₁ ?_ (val_incl_E'K₁ hw₀)
    have hdiv_z : (p : ℤ) * ((t₁ / p : ℕ) : ℤ) + 1 ≤ (t₁ : ℤ) := by
      exact_mod_cast hdiv_lt
    linarith
  set d_shift : K₁ := (Δ : K₁) + IntermediateField.inclusion hE'K₁ w₀
  have hd_shift_val : valL F K₁ d_shift = -(t₁ : ℤ) := by
    have hw₀_gt : IntermediateField.inclusion hE'K₁ w₀ = 0 ∨
        valL F K₁ (Δ : K₁) + 1 ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ w₀) := by
      rw [hΔ_val]
      exact hw₀_K₁
    have hstrict := (hval_strict_K₁ (Units.ne_zero Δ) hw₀_gt).2
    rw [hstrict, hΔ_val]
  have hd_shift_as :
      d_shift ^ p - d_shift - IntermediateField.inclusion hE'K₁ (a + w₀ ^ p - w₀) = 0 ∨
        (1 : ℤ) ≤
          valL F K₁ (d_shift ^ p - d_shift -
            IntermediateField.inclusion hE'K₁ (a + w₀ ^ p - w₀)) := by
    have hid : d_shift ^ p - d_shift - IntermediateField.inclusion hE'K₁ (a + w₀ ^ p - w₀) =
        (((Δ : K₁) + IntermediateField.inclusion hE'K₁ w₀) ^ p -
          ((Δ : K₁) ^ p + (IntermediateField.inclusion hE'K₁ w₀) ^ p)) +
        ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a) := by
      dsimp [d_shift]
      rw [map_sub, map_add, map_pow]
      ring
    have hcross :
        ((Δ : K₁) + IntermediateField.inclusion hE'K₁ w₀) ^ p -
          ((Δ : K₁) ^ p + (IntermediateField.inclusion hE'K₁ w₀) ^ p) = 0 ∨
        (1 : ℤ) ≤
          valL F K₁ (((Δ : K₁) + IntermediateField.inclusion hE'K₁ w₀) ^ p -
            ((Δ : K₁) ^ p + (IntermediateField.inclusion hE'K₁ w₀) ^ p)) := by
      apply hbinom_cross (Δ : K₁) (IntermediateField.inclusion hE'K₁ w₀)
        (-(t₁ : ℤ)) (-(t₁ : ℤ) + 1) 1 (Or.inr (by omega)) hw₀_K₁
      intro k hk_lt
      have hk_sum : ((k + 1 : ℕ) : ℤ) + ((p - (k + 1) : ℕ) : ℤ) = (p : ℤ) := by omega
      have hpk1 : (1 : ℤ) ≤ ((p - (k + 1) : ℕ) : ℤ) := by omega
      nlinarith [hP₂_sub_pt₁, hk_sum, hpk1]
    rw [hid]
    exact val_add_K₁ hcross hΔ_as
  obtain ⟨Δ', hΔ'_val, _, hΔ'_as⟩ :=
    hConj2 d_shift (a + w₀ ^ p - w₀) hd_shift_val hd_shift_as N
  exact ⟨Δ', hΔ'_val, hΔ'_as⟩

theorem ld_wild_odd_tot_ram_as_iterate_and_basis_package (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = p)
    (t₁ t₂ : ℕ) (ht₁_ge1 : 1 ≤ t₁) (ht_le : t₁ ≤ t₂)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = (p : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y)
    (ϖ_E' : E'ˣ) (G_E' : Type u) [Group G_E'] [Fintype G_E']
    (act_E' : G_E' → E' → E') (y₁_E' : E')
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hBasis_E' : ∀ y : E', ∃ c : Fin p → L,
      y = ∑ i : Fin p, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F L (c i) + (i : ℤ))
    (hcard_GE' : Fintype.card G_E' = p)
    (hactE'_one : ∀ y : E', act_E' 1 y = y)
    (hactE'_mul : ∀ (σ τ : G_E') (y : E'), act_E' (σ * τ) y = act_E' σ (act_E' τ y))
    (hactE'_ring : ∀ σ : G_E',
      act_E' σ 0 = 0 ∧ act_E' σ 1 = 1 ∧
      (∀ y₁ y₂ : E',
        act_E' σ (y₁ + y₂) = act_E' σ y₁ + act_E' σ y₂ ∧
        act_E' σ (y₁ * y₂) = act_E' σ y₁ * act_E' σ y₂ ∧
        act_E' σ (-y₁) = -act_E' σ y₁))
    (hactE'_incl : ∀ (σ : G_E') (x : L),
      act_E' σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hactE'_val : ∀ (σ : G_E') (y : E'), valL F E' (act_E' σ y) = valL F E' y)
    (hactE'_trace : ∀ y : E',
      IntermediateField.inclusion hLE' (traceLM F hLE' y) = ∑ σ : G_E', act_E' σ y)
    (hjump_E' : ∀ τ : G_E', τ ≠ 1 →
      (ϖ_E' : E') - act_E' τ (ϖ_E' : E') ≠ 0 ∧
      valL F E' ((ϖ_E' : E') - act_E' τ (ϖ_E' : E')) = (t₂ + 1 : ℤ))
    (hy₁E'_tr : traceLM F hLE' y₁_E' = 1)
    (hy₁E'_ne0 : y₁_E' ≠ 0)
    (hy₁E'_val : valL F E' y₁_E' = -(((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)))
    (ϖ_K₁ : K₁ˣ) (G_K₁ : Type u) [Group G_K₁] [Fintype G_K₁]
    (act_K₁ : G_K₁ → K₁ → K₁) (y₁_K₁ : K₁)
    (hϖ_K₁ : valL F K₁ (ϖ_K₁ : K₁) = 1)
    (hBasis_K₁ : ∀ w : K₁, ∃ c : Fin p → E',
      w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F E' (c i) + (i : ℤ))
    (hcard_GK₁ : Fintype.card G_K₁ = p)
    (hactK₁_one : ∀ w : K₁, act_K₁ 1 w = w)
    (hactK₁_mul : ∀ (σ τ : G_K₁) (w : K₁), act_K₁ (σ * τ) w = act_K₁ σ (act_K₁ τ w))
    (hactK₁_ring : ∀ σ : G_K₁,
      act_K₁ σ 0 = 0 ∧ act_K₁ σ 1 = 1 ∧
      (∀ w₁ w₂ : K₁,
        act_K₁ σ (w₁ + w₂) = act_K₁ σ w₁ + act_K₁ σ w₂ ∧
        act_K₁ σ (w₁ * w₂) = act_K₁ σ w₁ * act_K₁ σ w₂ ∧
        act_K₁ σ (-w₁) = -act_K₁ σ w₁))
    (hactK₁_incl : ∀ (σ : G_K₁) (y : E'),
      act_K₁ σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y)
    (hactK₁_val : ∀ (σ : G_K₁) (w : K₁), valL F K₁ (act_K₁ σ w) = valL F K₁ w)
    (hactK₁_trace : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G_K₁, act_K₁ σ w)
    (hjump_K₁ : ∀ τ : G_K₁, τ ≠ 1 →
      (ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁) ≠ 0 ∧
      valL F K₁ ((ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁)) = (t₁ + 1 : ℤ))
    (hy₁K₁_tr : traceLM F hE'K₁ y₁_K₁ = 1)
    (hy₁K₁_ne0 : y₁_K₁ ≠ 0)
    (hy₁K₁_val : valL F K₁ y₁_K₁ = -(((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))) :
    ¬ (p ∣ t₁) ∧
    (((p : ℕ) : K₁) = 0 ∨ ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁)) ∧
    (∀ Δ : K₁ˣ,
      valL F K₁ (Δ : K₁) = -(t₁ : ℤ) →
      ∀ w : K₁, ∃ Y : Fin p → E',
        w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (w = 0 ∨ m ≤ valL F K₁ w) ↔
            ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)) ∧
    (∀ N : ℕ, ∃ (Δ₀ : K₁ˣ) (a₀ : E'),
      valL F K₁ (Δ₀ : K₁) = -(t₁ : ℤ) ∧
      valL F E' a₀ = -(t₁ : ℤ) ∧
      ((Δ₀ : K₁) ^ p - (Δ₀ : K₁) - IntermediateField.inclusion hE'K₁ a₀ = 0 ∨
        (N : ℤ) ≤ valL F K₁ ((Δ₀ : K₁) ^ p - (Δ₀ : K₁) - IntermediateField.inclusion hE'K₁ a₀))) ∧
    (∀ (N : ℕ) (Δ : K₁ˣ) (a : E'),
      valL F K₁ (Δ : K₁) = -(t₁ : ℤ) →
      valL F E' a = -(t₁ : ℤ) →
      ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a = 0 ∨
        (1 : ℤ) ≤ valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a)) →
      ∀ w₀ : E',
        (w₀ = 0 ∨ -((t₁ / p : ℕ) : ℤ) ≤ valL F E' w₀) →
        ∃ Δ' : K₁ˣ,
          valL F K₁ (Δ' : K₁) = -(t₁ : ℤ) ∧
          ((Δ' : K₁) ^ p - (Δ' : K₁) -
            IntermediateField.inclusion hE'K₁ (a + w₀ ^ p - w₀) = 0 ∨
            (N : ℤ) ≤
              valL F K₁ ((Δ' : K₁) ^ p - (Δ' : K₁) -
                IntermediateField.inclusion hE'K₁ (a + w₀ ^ p - w₀)))) :=
by
  have hval7 : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) := by
    intro M _
    obtain ⟨h0, h1, hneg1, hneg, hmul, hinv, _, hadd, _, _, _⟩ :=
      ld_valL_and_unitGroup_props F M
    exact ⟨h0, h1, hneg1, hneg, hmul, hinv, hadd⟩
  have ht₂_ge1 : 1 ≤ t₂ := le_trans ht₁_ge1 ht_le
  have hp_valE' : ((p : ℕ) : E') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E') :=
    (ld_wild_tot_ram_const_free_jump_shift_and_telescoping F L E' hLE' p hPrime t₂ ht₂_ge1
      (hval7 L) (hval7 E') hval_LE' ϖ_E' G_E' act_E' y₁_E'
      hϖ_E' hBasis_E' hcard_GE' hactE'_one hactE'_mul hactE'_ring
      hactE'_incl hactE'_val hactE'_trace hjump_E'
      hy₁E'_tr hy₁E'_ne0 hy₁E'_val).1
  have hp_valK₁ : ((p : ℕ) : K₁) = 0 ∨ ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁) := by
    have hincl_p : IntermediateField.inclusion hE'K₁ ((p : ℕ) : E') = ((p : ℕ) : K₁) :=
      map_natCast (IntermediateField.inclusion hE'K₁) p
    rcases hp_valE' with hp0 | hp_ge
    · left
      rw [← hincl_p, hp0, map_zero]
    · right
      rw [← hincl_p, hval_E'K₁]
      have hcast : ((p * (p - 1) * t₂ : ℕ) : ℤ) = (p : ℤ) * (((p - 1) * t₂ : ℕ) : ℤ) := by
        push_cast; ring
      rw [hcast]
      exact mul_le_mul_of_nonneg_left hp_ge (Nat.cast_nonneg p)
  have hp_ge3 : 3 ≤ p := by
    have hp2 := hPrime.two_le
    omega
  obtain ⟨_, hK₁_step2, hK₁_step3⟩ :=
    ld_wild_tot_ram_const_free_jump_shift_and_telescoping F E' K₁ hE'K₁ p hPrime t₁ ht₁_ge1
      (hval7 E') (hval7 K₁) hval_E'K₁ ϖ_K₁ G_K₁ act_K₁ y₁_K₁
      hϖ_K₁ hBasis_K₁ hcard_GK₁ hactK₁_one hactK₁_mul hactK₁_ring
      hactK₁_incl hactK₁_val hactK₁_trace hjump_K₁
      hy₁K₁_tr hy₁K₁_ne0 hy₁K₁_val
  have hMp_le : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) + 1 ≤ ((p * (p - 1) * t₂ : ℕ) : ℤ) := by
    have h1 : (p - 1) * t₁ + 1 ≤ p * (p - 1) * t₂ := by
      calc (p - 1) * t₁ + 1
        _ ≤ (p - 1) * t₁ + (p - 1) * t₁ := by
          have : 1 ≤ (p - 1) * t₁ := Nat.mul_pos (by omega) ht₁_ge1
          omega
        _ = 2 * ((p - 1) * t₁) := by ring
        _ ≤ p * ((p - 1) * t₁) := Nat.mul_le_mul_right ((p - 1) * t₁) (by omega)
        _ ≤ p * ((p - 1) * t₂) := Nat.mul_le_mul_left p (Nat.mul_le_mul_left (p - 1) ht_le)
        _ = p * (p - 1) * t₂ := by ring
    exact_mod_cast h1
  obtain ⟨ht₁_ndvd, σ, d, hσ_ne1, hd_val, hd_shift⟩ :=
    hK₁_step2 ((p * (p - 1) * t₂ : ℕ) : ℤ) hMp_le hp_valK₁
  have hd_shift' :
      act_K₁ σ d - (d + 1) = 0 ∨
        ((p * (p - 1) * t₂ : ℕ) : ℤ) - (((p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (act_K₁ σ d - (d + 1)) := by
    have hcast : (((p - 1) * t₁ : ℕ) : ℤ) = ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) :=
      Nat.cast_mul (p - 1) t₁
    rw [hcast]
    exact hd_shift
  have hΔ_basis_all :=
    ld_wild_tot_ram_coprime_neg_val_power_basis F E' K₁ hE'K₁ p hPrime hdegE'K₁
      t₁ ht₁_ndvd (hval7 K₁) hval_E'K₁
  obtain ⟨hShift_dp, hIter_Δ₀, hShift_w₀⟩ :=
    ld_wild_odd_tot_ram_as_iterate_and_w0_shift F E' K₁ hE'K₁ p hPrime hp_odd
      t₁ t₂ ht₁_ge1 ht_le ht₁_ndvd hp_valK₁ (hval7 E') (hval7 K₁) hval_E'K₁
  have hact_pow : ∀ n : ℕ, act_K₁ σ (d ^ n) = (act_K₁ σ d) ^ n := by
    intro n
    induction n with
    | zero => simp [(hactK₁_ring σ).2.1]
    | succ n ih => rw [pow_succ, pow_succ, ((hactK₁_ring σ).2.2 (d ^ n) d).2.1, ih]
  have hact_dp_sub : act_K₁ σ (d ^ p - d) = (act_K₁ σ d) ^ p - act_K₁ σ d := by
    rw [sub_eq_add_neg, ((hactK₁_ring σ).2.2 (d ^ p) (-d)).1, ((hactK₁_ring σ).2.2 d d).2.2,
      hact_pow p, ← sub_eq_add_neg]
  have hdp_shift := hShift_dp d (act_K₁ σ d) hd_val hd_shift'
  rw [← hact_dp_sub] at hdp_shift
  set M₀ : ℤ := ((p * (p - 1) * t₂ : ℕ) : ℤ) - ((p * t₁ : ℕ) : ℤ)
  have hdp_shift_M₀ :
      act_K₁ σ (d ^ p - d) - (d ^ p - d) = 0 ∨
        M₀ + (t₁ : ℤ) ≤ valL F K₁ (act_K₁ σ (d ^ p - d) - (d ^ p - d)) := by
    have hM₀_eq : M₀ + (t₁ : ℤ) =
        ((p * (p - 1) * t₂ : ℕ) : ℤ) - (((p - 1) * t₁ : ℕ) : ℤ) := by
      dsimp [M₀]
      have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
      push_cast
      rw [hp1]
      ring
    rw [hM₀_eq]
    exact hdp_shift
  obtain ⟨a₀, ha₀_approx⟩ := hK₁_step3 (d ^ p - d) σ M₀ hσ_ne1 hdp_shift_M₀
  have ha₀_approx1 :
      d ^ p - d - IntermediateField.inclusion hE'K₁ a₀ = 0 ∨
        (1 : ℤ) ≤ valL F K₁ (d ^ p - d - IntermediateField.inclusion hE'K₁ a₀) := by
    rcases ha₀_approx with h0 | hge
    · exact Or.inl h0
    · right
      have h1_le_M₀ : (1 : ℤ) ≤ M₀ := by
        dsimp [M₀]
        have h1 : p * t₁ + 1 ≤ p * (p - 1) * t₂ := by
          calc p * t₁ + 1
            _ ≤ p * t₁ + p * t₁ := by
              have : 1 ≤ p * t₁ := Nat.mul_pos (by omega) ht₁_ge1
              omega
            _ = (p * 2) * t₁ := by ring
            _ ≤ (p * (p - 1)) * t₁ := Nat.mul_le_mul_right t₁ (Nat.mul_le_mul_left p (by omega))
            _ ≤ (p * (p - 1)) * t₂ := Nat.mul_le_mul_left (p * (p - 1)) ht_le
        have h1z : ((p * t₁ : ℕ) : ℤ) + 1 ≤ ((p * (p - 1) * t₂ : ℕ) : ℤ) := by
          exact_mod_cast h1
        linarith
      exact le_trans h1_le_M₀ hge
  refine ⟨ht₁_ndvd, hp_valK₁, hΔ_basis_all, fun N => ?_, hShift_w₀⟩
  obtain ⟨Δ₀, hΔ₀_val, ha₀_val, hΔ₀_as⟩ := hIter_Δ₀ d a₀ hd_val ha₀_approx1 N
  exact ⟨Δ₀, a₀, hΔ₀_val, ha₀_val, hΔ₀_as⟩

theorem ld_wild_odd_tot_ram_as_charpoly_remainder_and_norm (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t₁ m₁ : ℕ) (ht₁_ge1 : 1 ≤ t₁) (hm₁_gt : t₁ < m₁)
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y)
    (G_K₁ : Type u) [Group G_K₁] [Fintype G_K₁]
    (act_K₁ : G_K₁ → K₁ → K₁) (y₁_K₁ : K₁)
    (hcard_GK₁ : Fintype.card G_K₁ = p)
    (hactK₁_one : ∀ w : K₁, act_K₁ 1 w = w)
    (hactK₁_mul : ∀ (σ τ : G_K₁) (w : K₁), act_K₁ (σ * τ) w = act_K₁ σ (act_K₁ τ w))
    (hactK₁_ring : ∀ σ : G_K₁,
      act_K₁ σ 0 = 0 ∧ act_K₁ σ 1 = 1 ∧
      (∀ w₁ w₂ : K₁,
        act_K₁ σ (w₁ + w₂) = act_K₁ σ w₁ + act_K₁ σ w₂ ∧
        act_K₁ σ (w₁ * w₂) = act_K₁ σ w₁ * act_K₁ σ w₂ ∧
        act_K₁ σ (-w₁) = -act_K₁ σ w₁))
    (hactK₁_incl : ∀ (σ : G_K₁) (y : E'),
      act_K₁ σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y)
    (hactK₁_trace : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G_K₁, act_K₁ σ w)
    (hactK₁_norm : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G_K₁, act_K₁ σ w)
    (hy₁K₁_tr : traceLM F hE'K₁ y₁_K₁ = 1)
    (Δ : K₁ˣ) (hΔ_val : valL F K₁ (Δ : K₁) = -(t₁ : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin p → E',
      w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ))
    (a_target : E')
    (hΔ_as_target :
      (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a_target = 0 ∨
        ((4 * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a_target)) :
    (normLM F hE'K₁ (Δ : K₁) - a_target = 0 ∨
      ((3 * m₁ : ℕ) : ℤ) ≤ valL F E' (normLM F hE'K₁ (Δ : K₁) - a_target)) ∧
    ((Δ : K₁) ^ p - (Δ : K₁) -
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
      ((4 * p * m₁ : ℕ) : ℤ) ≤
        valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)))) ∧
    ∃ r : ℕ → E',
      (∀ i < p,
        IntermediateField.inclusion hE'K₁ (r i) = 0 ∨
          ((4 * p * m₁ : ℕ) : ℤ) + (i : ℤ) * (t₁ : ℤ) ≤
            valL F K₁ (IntermediateField.inclusion hE'K₁ (r i))) ∧
      ∏ σ : G_K₁, (Polynomial.X - Polynomial.C (act_K₁ σ (Δ : K₁))) =
        (Polynomial.X ^ p - Polynomial.X -
          Polynomial.C (IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)))) +
        ∑ i ∈ Finset.range p,
          Polynomial.C (IntermediateField.inclusion hE'K₁ (r i)) * Polynomial.X ^ i :=
by
  obtain ⟨_, _, _, hvalE'_neg, _, _, _, _, _, _, _⟩ := hvalE'_props
  obtain ⟨_, hvalK₁_1, _, hvalK₁_neg, hvalK₁_mul, _, hvalK₁_surj, hvalK₁_add, _, _, _⟩ := hvalK₁_props
  have valE'_neg_ge : ∀ {k : ℤ} {x : E'},
      (x = 0 ∨ k ≤ valL F E' x) → (-x = 0 ∨ k ≤ valL F E' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right
      rw [hvalE'_neg x]
      exact hx
  have valK₁_neg_ge : ∀ {k : ℤ} {x : K₁},
      (x = 0 ∨ k ≤ valL F K₁ x) → (-x = 0 ∨ k ≤ valL F K₁ (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right
      rw [hvalK₁_neg x]
      exact hx
  have valK₁_add_ge : ∀ {k : ℤ} {x y : K₁},
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x + y = 0 ∨ k ≤ valL F K₁ (x + y)) := by
    intro k x y hx hy
    exact hvalK₁_add k x y hx hy
  have hvalK₁_pow : ∀ (x : K₁) (n : ℕ), x ≠ 0 → valL F K₁ (x ^ n) = (n : ℤ) * valL F K₁ x := by
    intro x n hx
    induction n with
    | zero => simp [hvalK₁_1]
    | succ n ih =>
      rw [pow_succ', hvalK₁_mul x (x ^ n) hx (pow_ne_zero n hx), ih]
      push_cast
      ring
  have hval_strict_K₁ : ∀ (y₁ y₂ : K₁),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F K₁ y₁ + 1 ≤ valL F K₁ y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F K₁ (y₁ + y₂) = valL F K₁ y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F K₁ y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F K₁ y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F K₁ (y₁ + y₂) :=
      hvalK₁_add v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F K₁ (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F K₁ (-y₂) := valK₁_neg_ge hy₂
      have hy₁_gt := hvalK₁_add (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K₁ (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K₁ (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩
  let t_term (Y : Fin p → E') (i : Fin p) : K₁ :=
    IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))
  let v_term (Y : Fin p → E') (i : Fin p) : ℤ :=
    (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)
  have ht_term_zero : ∀ (Y : Fin p → E') (i : Fin p), Y i = 0 → t_term Y i = 0 := by
    intro Y i hYi
    dsimp [t_term]
    rw [hYi, map_zero, zero_mul]
  have ht_term_nz : ∀ (Y : Fin p → E') (i : Fin p),
      Y i ≠ 0 → t_term Y i ≠ 0 ∧ valL F K₁ (t_term Y i) = v_term Y i := by
    intro Y i hYi
    have hinc_ne : IntermediateField.inclusion hE'K₁ (Y i) ≠ 0 :=
      (IntermediateField.inclusion hE'K₁).injective.ne hYi
    have hpow_ne : ((Δ : K₁) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero Δ)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term, v_term]
    rw [hvalK₁_mul _ _ hinc_ne hpow_ne, hval_E'K₁ (Y i),
      hvalK₁_pow (Δ : K₁) (i : ℕ) (Units.ne_zero Δ), hΔ_val]
    ring
  obtain ⟨w₁, hw₁_val⟩ := hvalK₁_surj 1
  obtain ⟨Y₁, _, hY₁_iff⟩ := hΔ_basis (w₁ : K₁)
  have hY₁_ge1 : ∀ i : Fin p, Y₁ i = 0 ∨ (1 : ℤ) ≤ v_term Y₁ i :=
    (hY₁_iff 1).mp (Or.inr (by omega))
  have hnot_w₁_2 : ¬ ((w₁ : K₁) = 0 ∨ (2 : ℤ) ≤ valL F K₁ (w₁ : K₁)) := by
    rintro (h0 | h2)
    · exact Units.ne_zero w₁ h0
    · omega
  have hnot_all_2 : ¬ (∀ i : Fin p, Y₁ i = 0 ∨ (2 : ℤ) ≤ v_term Y₁ i) :=
    mt (hY₁_iff 2).mpr hnot_w₁_2
  push_neg at hnot_all_2
  obtain ⟨i₀_bez, hY₁_i₀_ne, hv_i₀_lt2⟩ := hnot_all_2
  have hv_i₀_ge1 : (1 : ℤ) ≤ v_term Y₁ i₀_bez := (hY₁_ge1 i₀_bez).resolve_left hY₁_i₀_ne
  have hbez : (p : ℤ) * valL F E' (Y₁ i₀_bez) - (i₀_bez : ℤ) * (t₁ : ℤ) = 1 := by
    change v_term Y₁ i₀_bez = 1
    omega
  have hv_term_inj : ∀ (Y : Fin p → E') (i j : Fin p),
      v_term Y i = v_term Y j → i = j := by
    intro Y i j hij
    dsimp [v_term] at hij
    set d : ℤ := (i : ℤ) - (j : ℤ)
    set q : ℤ := valL F E' (Y i) - valL F E' (Y j)
    have hd_t₁ : d * (t₁ : ℤ) = (p : ℤ) * q := by
      dsimp [d, q]
      linarith [hij]
    set k : ℤ := d * valL F E' (Y₁ i₀_bez) - (i₀_bez : ℤ) * q
    have hd_mul : d = (p : ℤ) * k := by
      calc d = d * 1 := (mul_one d).symm
        _ = d * ((p : ℤ) * valL F E' (Y₁ i₀_bez) - (i₀_bez : ℤ) * (t₁ : ℤ)) := by rw [hbez]
        _ = (p : ℤ) * (d * valL F E' (Y₁ i₀_bez)) - (i₀_bez : ℤ) * (d * (t₁ : ℤ)) := by ring
        _ = (p : ℤ) * (d * valL F E' (Y₁ i₀_bez)) - (i₀_bez : ℤ) * ((p : ℤ) * q) := by rw [hd_t₁]
        _ = (p : ℤ) * k := by dsimp [k]; ring
    have hi_nonneg : (0 : ℤ) ≤ (i : ℤ) := Nat.cast_nonneg i.1
    have hi_lt : (i : ℤ) < (p : ℤ) := Nat.cast_lt.mpr i.2
    have hj_nonneg : (0 : ℤ) ≤ (j : ℤ) := Nat.cast_nonneg j.1
    have hj_lt : (j : ℤ) < (p : ℤ) := Nat.cast_lt.mpr j.2
    have hd_gt : -(p : ℤ) < d := by dsimp [d]; omega
    have hd_lt : d < (p : ℤ) := by dsimp [d]; omega
    have hk0 : k = 0 := by nlinarith
    have hd0 : d = 0 := by rw [hd_mul, hk0, mul_zero]
    have hij_int : (i.1 : ℤ) = (j.1 : ℤ) := by dsimp [d] at hd0; omega
    exact Fin.ext (Nat.cast_injective hij_int)
  have hval_sum_ge : ∀ (Y : Fin p → E') (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, Y i = 0 ∨ m ≤ v_term Y i) →
        ((∑ i ∈ S, t_term Y i) = 0 ∨ m ≤ valL F K₁ (∑ i ∈ S, t_term Y i)) := by
    intro Y S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term Y a = 0 ∨ m ≤ valL F K₁ (t_term Y a) := by
        by_cases hYa : Y a = 0
        · exact Or.inl (ht_term_zero Y a hYa)
        · right
          rw [(ht_term_nz Y a hYa).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hYa
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hvalK₁_add m (t_term Y a) (∑ i ∈ s, t_term Y i) ha_t hs_t
  have hsum_min_nz : ∀ (Y : Fin p → E') (i : Fin p),
      Y i ≠ 0 →
        ∃ i₀ : Fin p, Y i₀ ≠ 0 ∧ v_term Y i₀ ≤ v_term Y i ∧
          (∑ j : Fin p, t_term Y j) ≠ 0 ∧
          valL F K₁ (∑ j : Fin p, t_term Y j) = v_term Y i₀ := by
    intro Y i hYi
    let S_nz : Finset (Fin p) := (Finset.univ : Finset (Fin p)).filter (fun j => Y j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hYi⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term Y) ⟨i, hi_mem⟩
    have hYi₀ : Y i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term Y i₀ ≤ v_term Y i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
        Y j = 0 ∨ v_term Y i₀ + 1 ≤ v_term Y j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hYj : Y j = 0
      · exact Or.inl hYj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hYj⟩
        have hle_j : v_term Y i₀ ≤ v_term Y j := hi₀_min j hj_mem
        have hne_v : v_term Y i₀ ≠ v_term Y j := fun heq => hj_ne (hv_term_inj Y i₀ j heq).symm
        omega
    have hrem := hval_sum_ge Y ((Finset.univ : Finset (Fin p)).erase i₀)
      (v_term Y i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz Y i₀ hYi₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_K₁ (t_term Y i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term Y j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term Y) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hYi₀, hle_i, hstrict.1, hstrict.2⟩
  have hval_sum_iff : ∀ (Y : Fin p → E') (m : ℤ),
      ((∑ i : Fin p, t_term Y i) = 0 ∨ m ≤ valL F K₁ (∑ i : Fin p, t_term Y i)) ↔
        ∀ i : Fin p, Y i = 0 ∨ m ≤ v_term Y i := by
    intro Y m
    refine ⟨?_, fun hall => hval_sum_ge Y Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hYi : Y i = 0
    · exact Or.inl hYi
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_nz Y i hYi
      have hm_le : m ≤ valL F K₁ (∑ j : Fin p, t_term Y j) := hsum.resolve_left hsum_ne
      omega
  set B : ℤ := ((4 * p * m₁ : ℕ) : ℤ)
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := by omega
  set P_Δ : Polynomial K₁ := ∏ σ : G_K₁, (Polynomial.X - Polynomial.C (act_K₁ σ (Δ : K₁)))
  set P_0t : Polynomial K₁ :=
    Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hE'K₁ a_target)
  set R_t : Polynomial K₁ := P_Δ - P_0t
  have hPΔ_monic : P_Δ.Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun σ _ => Polynomial.monic_X_sub_C _)
  have hPΔ_deg : P_Δ.natDegree = p := by
    dsimp [P_Δ]
    rw [Polynomial.natDegree_prod_of_monic _ _ (fun σ _ => Polynomial.monic_X_sub_C _)]
    simp [hcard_GK₁]
  have hRt_deg : ∀ i : ℕ, p ≤ i → R_t.coeff i = 0 := by
    intro i hi
    dsimp [R_t, P_0t]
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_sub,
      Polynomial.coeff_X_pow, Polynomial.coeff_X, Polynomial.coeff_C]
    rcases eq_or_lt_of_le hi with rfl | hlt
    · have hPΔ_p : P_Δ.coeff p = 1 := by
        rw [← hPΔ_deg]
        exact hPΔ_monic.coeff_natDegree
      have hp1 : ¬ (1 = p) := by omega
      have hp0 : ¬ (p = 0) := by omega
      simp [hPΔ_p, hp1, hp0]
    · have hPΔ_gt : P_Δ.coeff i = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hPΔ_deg]; exact hlt)
      have hip : ¬ (i = p) := by omega
      have hi1 : ¬ (1 = i) := by omega
      have hi0 : ¬ (i = 0) := by omega
      simp [hPΔ_gt, hip, hi1, hi0]
  let φ_K₁ (τ : G_K₁) : K₁ →+* K₁ :=
    { toFun := act_K₁ τ
      map_one' := (hactK₁_ring τ).2.1
      map_mul' := fun x y => ((hactK₁_ring τ).2.2 x y).2.1
      map_zero' := (hactK₁_ring τ).1
      map_add' := fun x y => ((hactK₁_ring τ).2.2 x y).1 }
  have hφ_apply : ∀ (τ : G_K₁) (w : K₁), φ_K₁ τ w = act_K₁ τ w := fun _ _ => rfl
  have hPΔ_map : ∀ τ : G_K₁, P_Δ.map (φ_K₁ τ) = P_Δ := by
    intro τ
    dsimp [P_Δ]
    rw [Polynomial.map_prod]
    have hstep : ∀ σ : G_K₁,
        (Polynomial.X - Polynomial.C (act_K₁ σ (Δ : K₁))).map (φ_K₁ τ) =
          Polynomial.X - Polynomial.C (act_K₁ (τ * σ) (Δ : K₁)) := by
      intro σ
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hφ_apply,
        ← hactK₁_mul τ σ (Δ : K₁)]
    simp_rw [hstep]
    exact Equiv.prod_comp (Equiv.mulLeft τ)
      (fun g => Polynomial.X - Polynomial.C (act_K₁ g (Δ : K₁)))
  have hP0t_map : ∀ τ : G_K₁, P_0t.map (φ_K₁ τ) = P_0t := by
    intro τ
    dsimp [P_0t]
    rw [Polynomial.map_sub, Polynomial.map_sub, Polynomial.map_pow,
      Polynomial.map_X, Polynomial.map_C, hφ_apply, hactK₁_incl τ a_target]
  have hRt_map : ∀ τ : G_K₁, R_t.map (φ_K₁ τ) = R_t := by
    intro τ
    dsimp [R_t]
    rw [Polynomial.map_sub, hPΔ_map τ, hP0t_map τ]
  have hRt_coeff_inv : ∀ (τ : G_K₁) (i : ℕ), act_K₁ τ (R_t.coeff i) = R_t.coeff i := by
    intro τ i
    have h := congrArg (fun P => P.coeff i) (hRt_map τ)
    dsimp at h
    rw [Polynomial.coeff_map, hφ_apply] at h
    exact h
  let r_t : ℕ → E' := fun i => traceLM F hE'K₁ (R_t.coeff i * y₁_K₁)
  have hr_t_incl : ∀ i : ℕ, IntermediateField.inclusion hE'K₁ (r_t i) = R_t.coeff i := by
    intro i
    dsimp [r_t]
    rw [hactK₁_trace (R_t.coeff i * y₁_K₁)]
    have hcongr : ∀ σ ∈ (Finset.univ : Finset G_K₁),
        act_K₁ σ (R_t.coeff i * y₁_K₁) = R_t.coeff i * act_K₁ σ y₁_K₁ := by
      intro σ _
      rw [((hactK₁_ring σ).2.2 _ _).2.1, hRt_coeff_inv σ i]
    rw [Finset.sum_congr rfl hcongr, ← Finset.mul_sum, ← hactK₁_trace y₁_K₁,
      hy₁K₁_tr, map_one, mul_one]
  have hRt_sum : R_t = ∑ i ∈ Finset.range p,
      Polynomial.C (IntermediateField.inclusion hE'K₁ (r_t i)) * Polynomial.X ^ i := by
    ext n
    rw [Polynomial.finset_sum_coeff]
    have hcongr : ∀ i ∈ Finset.range p,
        (Polynomial.C (IntermediateField.inclusion hE'K₁ (r_t i)) * Polynomial.X ^ i).coeff n =
          if n = i then R_t.coeff i else 0 := by
      intro i _
      rw [hr_t_incl i, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hcongr, Finset.sum_ite_eq]
    by_cases hn : n < p
    · simp [Finset.mem_range.mpr hn]
    · have hge : p ≤ n := not_lt.mp hn
      simp [Finset.mem_range, hn, hRt_deg n hge]
  have hPΔ_eval : P_Δ.eval (Δ : K₁) = 0 := by
    dsimp [P_Δ]
    rw [Polynomial.eval_prod]
    refine Finset.prod_eq_zero (Finset.mem_univ (1 : G_K₁)) ?_
    simp [hactK₁_one]
  have hRt_eval_eq :
      R_t.eval (Δ : K₁) =
        - ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a_target) := by
    dsimp [R_t, P_0t]
    rw [Polynomial.eval_sub, hPΔ_eval, zero_sub,
      Polynomial.eval_sub, Polynomial.eval_sub, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C]
  have hRt_eval_val : R_t.eval (Δ : K₁) = 0 ∨ B ≤ valL F K₁ (R_t.eval (Δ : K₁)) := by
    rw [hRt_eval_eq]
    exact valK₁_neg_ge hΔ_as_target
  have hRt_eval_sum : R_t.eval (Δ : K₁) = ∑ i : Fin p, t_term (fun i => r_t i.1) i := by
    conv_lhs => rw [hRt_sum]
    rw [Polynomial.eval_finset_sum]
    have hcongr : ∀ i ∈ Finset.range p,
        (Polynomial.C (IntermediateField.inclusion hE'K₁ (r_t i)) * Polynomial.X ^ i).eval (Δ : K₁) =
          IntermediateField.inclusion hE'K₁ (r_t i) * ((Δ : K₁) ^ i) := by
      intro i _
      rw [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_X]
    rw [Finset.sum_congr rfl hcongr,
      ← Fin.sum_univ_eq_sum_range (fun i => IntermediateField.inclusion hE'K₁ (r_t i) * ((Δ : K₁) ^ i)) p]
  have hr_t_val_E' : ∀ i < p,
      r_t i = 0 ∨ B ≤ (p : ℤ) * valL F E' (r_t i) - (i : ℤ) * (t₁ : ℤ) := by
    intro i hi
    have hsum_val : (∑ j : Fin p, t_term (fun k => r_t k.1) j) = 0 ∨
        B ≤ valL F K₁ (∑ j : Fin p, t_term (fun k => r_t k.1) j) := by
      rw [← hRt_eval_sum]
      exact hRt_eval_val
    exact (hval_sum_iff (fun k => r_t k.1) B).mp hsum_val ⟨i, hi⟩
  have hr_t_val_K₁ : ∀ i < p,
      IntermediateField.inclusion hE'K₁ (r_t i) = 0 ∨
        B + (i : ℤ) * (t₁ : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ (r_t i)) := by
    intro i hi
    rcases hr_t_val_E' i hi with h0 | hge
    · exact Or.inl (by rw [h0, map_zero])
    · right
      rw [hval_E'K₁ (r_t i)]
      linarith
  set a : E' := normLM F hE'K₁ (Δ : K₁)
  have hPΔ_c0 : P_Δ.coeff 0 = - IntermediateField.inclusion hE'K₁ a := by
    dsimp [P_Δ, a]
    rw [Polynomial.coeff_zero_prod]
    have hstep : ∀ σ : G_K₁,
        (Polynomial.X - Polynomial.C (act_K₁ σ (Δ : K₁))).coeff 0 =
          (-1 : K₁) * act_K₁ σ (Δ : K₁) := by
      intro σ
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero,
        zero_sub, neg_eq_neg_one_mul]
    simp_rw [hstep]
    rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, hcard_GK₁,
      Odd.neg_one_pow (Nat.Prime.odd_of_ne_two hPrime hp_odd), neg_one_mul,
      ← hactK₁_norm (Δ : K₁)]
  have hP0t_c0 : P_0t.coeff 0 = - IntermediateField.inclusion hE'K₁ a_target := by
    dsimp [P_0t]
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_X_pow,
      Polynomial.coeff_X, Polynomial.coeff_C]
    have hp0 : ¬ (0 = p) := by omega
    simp [hp0]
  have hr_t0_incl :
      IntermediateField.inclusion hE'K₁ (r_t 0) =
        - IntermediateField.inclusion hE'K₁ a + IntermediateField.inclusion hE'K₁ a_target := by
    rw [hr_t_incl 0]
    dsimp [R_t]
    rw [Polynomial.coeff_sub, hPΔ_c0, hP0t_c0, sub_neg_eq_add]
  have ha_sub : a - a_target = - r_t 0 := by
    have hinj : IntermediateField.inclusion hE'K₁ (a - a_target) =
        IntermediateField.inclusion hE'K₁ (- r_t 0) := by
      rw [map_sub, map_neg, hr_t0_incl]
      ring
    exact (IntermediateField.inclusion hE'K₁).injective hinj
  have hconj1 : a - a_target = 0 ∨ ((3 * m₁ : ℕ) : ℤ) ≤ valL F E' (a - a_target) := by
    rw [ha_sub]
    apply valE'_neg_ge
    rcases hr_t_val_E' 0 hp_pos with h0 | hge
    · exact Or.inl h0
    · right
      dsimp [B] at hge
      push_cast at hge ⊢
      nlinarith
  have hconj2 :
      (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a = 0 ∨
        B ≤ valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a) := by
    have hΔ_as_eq :
        (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a =
          ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a_target) +
            IntermediateField.inclusion hE'K₁ (r_t 0) := by
      rw [hr_t0_incl]
      ring
    rw [hΔ_as_eq]
    have hr0_val : IntermediateField.inclusion hE'K₁ (r_t 0) = 0 ∨
        B ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ (r_t 0)) := by
      have h := hr_t_val_K₁ 0 hp_pos
      simpa using h
    exact valK₁_add_ge hΔ_as_target hr0_val
  let r : ℕ → E' := fun i => if i = 0 then 0 else r_t i
  have hr_val : ∀ i < p,
      IntermediateField.inclusion hE'K₁ (r i) = 0 ∨
        B + (i : ℤ) * (t₁ : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ (r i)) := by
    intro i hi
    by_cases hi0 : i = 0
    · exact Or.inl (by simp [r, hi0])
    · simp only [r, if_neg hi0]
      exact hr_t_val_K₁ i hi
  have hterm_eq : ∀ i : ℕ,
      Polynomial.C (IntermediateField.inclusion hE'K₁ (r_t i)) * Polynomial.X ^ i =
        Polynomial.C (IntermediateField.inclusion hE'K₁ (r i)) * Polynomial.X ^ i +
          if i = 0 then Polynomial.C (IntermediateField.inclusion hE'K₁ (r_t 0)) else 0 := by
    intro i
    by_cases hi0 : i = 0
    · subst hi0
      simp [r]
    · simp [r, hi0]
  have hPΔ_poly_eq :
      P_Δ =
        (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hE'K₁ a)) +
          ∑ i ∈ Finset.range p,
            Polynomial.C (IntermediateField.inclusion hE'K₁ (r i)) * Polynomial.X ^ i := by
    have hPΔ_split : P_Δ = P_0t + R_t := by dsimp [R_t]; ring
    rw [hPΔ_split, hRt_sum]
    simp_rw [hterm_eq]
    rw [Finset.sum_add_distrib, Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr hp_pos)]
    dsimp [P_0t]
    rw [hr_t0_incl, Polynomial.C_add, Polynomial.C_neg]
    ring
  exact ⟨hconj1, hconj2, r, hr_val, hPΔ_poly_eq⟩

theorem ld_wild_odd_tot_ram_as_formal_deriv_power_traces (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t₁ m₁ : ℕ) (ht₁_ge1 : 1 ≤ t₁) (hm₁_gt : t₁ < m₁)
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y)
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * ((t₁ + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (G_K₁ : Type u) [Group G_K₁] [Fintype G_K₁]
    (act_K₁ : G_K₁ → K₁ → K₁)
    (hcard_GK₁ : Fintype.card G_K₁ = p)
    (hactK₁_ring : ∀ σ : G_K₁,
      act_K₁ σ 0 = 0 ∧ act_K₁ σ 1 = 1 ∧
      (∀ w₁ w₂ : K₁,
        act_K₁ σ (w₁ + w₂) = act_K₁ σ w₁ + act_K₁ σ w₂ ∧
        act_K₁ σ (w₁ * w₂) = act_K₁ σ w₁ * act_K₁ σ w₂ ∧
        act_K₁ σ (-w₁) = -act_K₁ σ w₁))
    (hactK₁_incl : ∀ (σ : G_K₁) (y : E'),
      act_K₁ σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y)
    (hactK₁_val : ∀ (σ : G_K₁) (w : K₁), valL F K₁ (act_K₁ σ w) = valL F K₁ w)
    (hactK₁_trace : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G_K₁, act_K₁ σ w)
    (Δ : K₁ˣ) (hΔ_val : valL F K₁ (Δ : K₁) = -(t₁ : ℤ))
    (a : E') (r : ℕ → E')
    (hΔ_as : (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a = 0 ∨
      ((4 * p * m₁ : ℕ) : ℤ) ≤
        valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a))
    (hr_val : ∀ i < p,
      IntermediateField.inclusion hE'K₁ (r i) = 0 ∨
        ((4 * p * m₁ : ℕ) : ℤ) + (i : ℤ) * (t₁ : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hE'K₁ (r i)))
    (hPΔ_eq : ∏ σ : G_K₁, (Polynomial.X - Polynomial.C (act_K₁ σ (Δ : K₁))) =
      (Polynomial.X ^ p - Polynomial.X - Polynomial.C (IntermediateField.inclusion hE'K₁ a)) +
        ∑ i ∈ Finset.range p,
          Polynomial.C (IntermediateField.inclusion hE'K₁ (r i)) * Polynomial.X ^ i) :
    (∀ j ∈ Finset.Icc 1 (p - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        ((3 * m₁ : ℕ) : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j))) ∧
    (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
      ((3 * m₁ : ℕ) : ℤ) ≤
        valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E'))) ∧
    (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a = 0 ∨
      ((3 * m₁ : ℕ) : ℤ) ≤
        valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a)) :=
by
  have valE'_add_ge : ∀ {k : ℤ} {x y : E'},
      (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
        (x + y = 0 ∨ k ≤ valL F E' (x + y)) :=
    fun hx hy => hvalE'_props.2.2.2.2.2.2.2.1 _ _ _ hx hy
  have valK₁_neg_ge : ∀ {k : ℤ} {x : K₁},
      (x = 0 ∨ k ≤ valL F K₁ x) → (-x = 0 ∨ k ≤ valL F K₁ (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hvalK₁_props.2.2.2.1]; exact hx
  have valK₁_add_ge : ∀ {k : ℤ} {x y : K₁},
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x + y = 0 ∨ k ≤ valL F K₁ (x + y)) :=
    fun hx hy => hvalK₁_props.2.2.2.2.2.2.2.1 _ _ _ hx hy
  have valK₁_sub_ge : ∀ {k : ℤ} {x y : K₁},
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
