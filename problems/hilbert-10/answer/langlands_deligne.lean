  obtain ⟨c_E, hc_E_val, hc_E_norm, hc_E_psi⟩ :=
    ld_ch14_diamond_trace_shift_and_c_E_assembly F L K M_C E hLK hLM_C hM_CK hLE hEK
      hGalMCK hFinE_eq ψ hψ D_orb χ' ha1 hValNormE hValAlgE hValNormK hValAlgK hResLiftK
      hDiamondTrNorm t k ht_ge1 hk_ge1 hk_dvd hValAlgKE hValAlgMCL hnE htr_bound_K
      ϖ_K ϖ_MC ϖ_E ϖ_L hϖ_normK hϖ_normE hϖ_valK hϖ_valMC hϖ_valE hϖ_valL
      r_exp hr_exp_pos hq_pow c_orb u_all hu_all_prod u_α u_ω
      hu_α_val hu_ω_val hu_ω_def hu_α_frob hVieta
  exact ⟨c_orb, c_E, hTwist_orb, hc_E_val, hc_E_norm, hc_E_psi⟩

theorem ld_ch14_wild_cond_one_frob_gauss_assembly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    (hM_CK_finrank : ℕ)
    (hLE : L ≤ E)
    (hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) = hM_CK_finrank)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (D_orb : List (MonomialTerm F L))
    (χ' : Lˣ →* (Ω F)ˣ) (ha1 : condExp F L χ' = 1)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1)
    (hq_pow : ∃ r_exp : ℕ, 1 ≤ r_exp ∧ hM_CK_finrank = (p F) ^ r_exp)
    (hqE : qL F E = qL F L)
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) = (hM_CK_finrank : ℤ) * valL F L x)
    (hResLiftE : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)))
    (hFrobSurjL : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ hM_CK_finrank = 0 ∨ 1 ≤ valL F L (x - s ^ hM_CK_finrank)))
    (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c_E : Eˣ)
    (hTwist_orb : ∀ i : Fin D_orb.length,
      tateEps F (D_orb.get i).field
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
        (traceChar F (D_orb.get i).le ψ) =
      (χ' (Units.map (normLM F (D_orb.get i).le) (c_orb i)) : Ω F) *
        tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ))
    (hc_E_val : valL F E (c_E : E) = 1 + condExpChar F E (traceChar F hLE ψ))
    (hc_E_norm : Units.map (normLM F hLE) c_E *
      (tateElt F L χ' ψ *
        (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)))⁻¹ ∈
      unitGroup F L 1)
    (hc_E_psi : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)) →
        (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * y) =
          ψ ((((tateElt F L χ' ψ)⁻¹ : Lˣ) : L) * (x ^ hM_CK_finrank))) :
    tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
      tateEps F L 1 ψ *
      (∏ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)) =
    tateEps F E 1 (traceChar F hLE ψ) *
      tateEps F L χ' ψ *
      (∏ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (traceChar F (D_orb.get i).le ψ)) :=
by
  classical
  
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_E, hval1_E, hval_neg1_E, hval_neg_E, hval_mul_E, hval_inv_E, hval_surj_E,
    hval_add_E, hunit0_E, hunit_ge1_E, hunit_val0_E⟩ := ld_valL_and_unitGroup_props F E
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L hval0_L hval_neg_L hval_mul_L hval_add_L
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hval0_L hval1_L hval_neg1_L hval_neg_L hval_mul_L
      hval_inv_L hval_add_L S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL

  haveI : CharP 𝓀[F] (p F) := ringChar.of_eq rfl
  haveI : Finite 𝓀[F] :=
    IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  have hp_ne : p F ≠ 0 := CharP.char_ne_zero_of_finite 𝓀[F] (p F)
  haveI : NeZero (p F) := ⟨hp_ne⟩
  have hp_prime : Nat.Prime (p F) := (CharP.char_is_prime_of_pos 𝓀[F] (p F)).1
  obtain ⟨r_exp, hr_exp_ge1, hq_eq⟩ := hq_pow
  set q := hM_CK_finrank
  have hq_ge2 : 2 ≤ q := by
    rw [hq_eq]
    calc 2 = 2 ^ 1 := rfl
      _ ≤ (p F) ^ 1 := Nat.pow_le_pow_left hp_prime.two_le 1
      _ ≤ (p F) ^ r_exp := Nat.pow_le_pow_right hp_prime.pos hr_exp_ge1
  have hq_pos : 0 < q := by omega
  have hq_ne_zero : q ≠ 0 := by omega

  
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q_z : ℤ := valL F M z
      set r_z : ℤ := relVal F M z % f
      have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
          linarith
        let k : ℕ := r_z.toNat
        have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith

  obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hval_surj_L
  obtain ⟨hresDeg_E_pos, hdiv_E⟩ := hrelVal_div E hval_surj_E

  let E' := IntermediateField.extendScalars hLE
  let eF_E : E ≃ₐ[F] E' :=
    { toExtendScalars F hLE with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F E' := Module.Finite.equiv eF_E.toLinearEquiv
  haveI : IsScalarTower F L E' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L E' := Module.Finite.of_restrictScalars_finite F L E'
  letI : Fintype (E' →ₐ[L] AlgebraicClosure F) :=
    minpoly.AlgHom.fintype L E' (AlgebraicClosure F)

  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
    Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
  letI : NontriviallyNormedField (AlgebraicClosure F) :=
    spectralNorm.nontriviallyNormedField F (AlgebraicClosure F)
  haveI : IsUltrametricDist (AlgebraicClosure F) :=
    IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
      (isNonarchimedean_spectralNorm (K := F) (L := AlgebraicClosure F))

  have halg_norm : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (z : M),
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F M = (minpoly F z).natDegree * m := by
    intro M _ z
    haveI : Algebra.IsAlgebraic F M := Algebra.IsAlgebraic.of_finite F M
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]; rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨_, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]

  have hspec_pow_M : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (z : M),
      ‖(z : AlgebraicClosure F)‖ ^ (Module.finrank F M) = ‖Algebra.norm F z‖ := by
    intro M _ z
    haveI : Algebra.IsAlgebraic F M := Algebra.IsAlgebraic.of_finite F M
    obtain ⟨m, hnorm_adj, hfinrank⟩ := halg_norm M z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq M.val M.val.injective z
    have hspec : ‖(z : AlgebraicClosure F)‖ =
        ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
      change spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) = _
      rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
    have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
      rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
      exact_mod_cast minpoly.natDegree_pos hz
    rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
      ← Real.rpow_natCast]
    congr 1
    push_cast
    rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]

  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → ‖a‖ ≤ ‖b‖ → b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hle
    have hv_eq : ∀ c : F, ‖c‖ =
        ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
          (valuation F c) : ℝ) := fun _ => rfl
    rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hle
    have hab : valuation F a ≤ valuation F b :=
      (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp hle
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le

  have hF_norm_lt_one_iff : ∀ a : F, a ≠ 0 → (‖a‖ < 1 ↔ 1 ≤ addVal F a) := by
    intro a ha
    constructor
    · intro hlt
      have hle1 : ‖a‖ ≤ ‖(1 : F)‖ := by rw [norm_one]; exact le_of_lt hlt
      have hge0 : 0 ≤ addVal F a := by
        have h := (hval_le a 1 ha hle1).2
        rwa [haddVal1] at h
      have hne0 : addVal F a ≠ 0 := by
        intro h0
        have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
        have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
        unfold addVal at h0
        rw [dif_neg ha, neg_eq_zero, toAdd_eq_zero] at h0
        have hφ_eq1 : φ (valuation F a) = 1 := by
          rw [← WithZero.coe_unzero hφa, h0, WithZero.coe_one]
        have hva_eq1 : valuation F a = 1 :=
          φ.injective (hφ_eq1.trans (map_one φ).symm)
        have hnorm_eq1 : ‖a‖ = 1 := by
          change ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
            (valuation F a) : ℝ) = 1
          rw [hva_eq1, map_one, NNReal.coe_one]
        linarith
      omega
    · intro hge1
      by_contra hge
      push_neg at hge
      rw [← norm_one (α := F)] at hge
      have hle0 := (hval_le 1 a one_ne_zero hge).2
      rw [haddVal1] at hle0
      omega

  have hE_norm_lt_one : ∀ y : E, (y = 0 ∨ 1 ≤ valL F E y) → ‖(y : AlgebraicClosure F)‖ < 1 := by
    intro y hy
    by_cases hy0 : y = 0
    · rw [hy0, ZeroMemClass.coe_zero, norm_zero]
      exact zero_lt_one
    · have hy_ge1 : 1 ≤ valL F E y := hy.resolve_left hy0
      have hnorm_ne : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy0
      have hadd_ge1 : 1 ≤ addVal F (Algebra.norm F y) := by
        change 1 ≤ relVal F E y
        rw [hdiv_E y]
        have hfE_ge1 : (1 : ℤ) ≤ (resDeg F E : ℤ) := by exact_mod_cast hresDeg_E_pos
        nlinarith
      have hnorm_lt1 : ‖Algebra.norm F y‖ < 1 := (hF_norm_lt_one_iff _ hnorm_ne).mpr hadd_ge1
      rw [← hspec_pow_M E y] at hnorm_lt1
      by_contra hge1
      push_neg at hge1
      have hpow_ge1 : (1 : ℝ) ≤ ‖(y : AlgebraicClosure F)‖ ^ (Module.finrank F E) :=
        one_le_pow₀ hge1
      linarith

  have hL_of_norm_lt_one : ∀ x : L, ‖(x : AlgebraicClosure F)‖ < 1 →
      (x = 0 ∨ 1 ≤ valL F L x) := by
    intro x hlt
    by_cases hx0 : x = 0
    · exact Or.inl hx0
    · right
      have hnorm_ne : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx0
      have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
      have hpow_lt1 : ‖Algebra.norm F x‖ < 1 := by
        rw [← hspec_pow_M L x]
        exact pow_lt_one₀ (norm_nonneg _) hlt hfin_pos.ne'
      have hadd_ge1 : 1 ≤ addVal F (Algebra.norm F x) :=
        (hF_norm_lt_one_iff _ hnorm_ne).mp hpow_lt1
      change 1 ≤ relVal F L x at hadd_ge1
      rw [hdiv_L x] at hadd_ge1
      have hfL_ge1 : (1 : ℤ) ≤ (resDeg F L : ℤ) := by exact_mod_cast hresDeg_L_pos
      by_contra hlt1
      have hle0 : valL F L x ≤ 0 := by omega
      nlinarith

  have hnorm_emb_eq : ∀ (σ : E' →ₐ[L] AlgebraicClosure F) (y : E),
      ‖σ (toExtendScalars F hLE y)‖ = ‖(y : AlgebraicClosure F)‖ := by
    intro σ y
    let y' : E' := toExtendScalars F hLE y
    have hmin1 : minpoly F (σ y') = minpoly F y' :=
      minpoly.algHom_eq (σ.restrictScalars F) (σ.restrictScalars F).injective y'
    have hmin2 : minpoly F (y : AlgebraicClosure F) = minpoly F y' :=
      minpoly.algHom_eq (E'.val.restrictScalars F) (E'.val.restrictScalars F).injective y'
    change spectralNorm F (AlgebraicClosure F) (σ y') =
      spectralNorm F (AlgebraicClosure F) (y : AlgebraicClosure F)
    rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow,
      spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin1, hmin2]

  have hprod_one_add_lt : ∀ (S : Finset (E' →ₐ[L] AlgebraicClosure F)) (y' : E'),
      (∀ σ ∈ S, ‖σ y'‖ < 1) →
      ‖(∏ σ ∈ S, (1 + σ y')) - 1‖ < 1 := by
    intro S y'
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp
    | @insert a s ha ih =>
      intro hS
      rw [Finset.prod_insert ha]
      set A : AlgebraicClosure F := a y'
      set B : AlgebraicClosure F := (∏ σ ∈ s, (1 + σ y')) - 1
      have hA : ‖A‖ < 1 := hS a (Finset.mem_insert_self a s)
      have hB : ‖B‖ < 1 := ih (fun σ hσ => hS σ (Finset.mem_insert_of_mem hσ))
      have hident : (1 + A) * (∏ σ ∈ s, (1 + σ y')) - 1 = (A + B) + A * B := by
        dsimp [B]
        ring
      rw [hident]
      have hAB_add : ‖A + B‖ < 1 :=
        lt_of_le_of_lt
          (isNonarchimedean_spectralNorm (K := F) (L := AlgebraicClosure F) A B)
          (max_lt hA hB)
      have hAB_mul : ‖A * B‖ < 1 := by
        rw [norm_mul]
        exact mul_lt_one_of_nonneg_of_lt_one_left (norm_nonneg A) hA (le_of_lt hB)
      exact lt_of_le_of_lt
        (isNonarchimedean_spectralNorm (K := F) (L := AlgebraicClosure F) (A + B) (A * B))
        (max_lt hAB_add hAB_mul)

  have hnorm_unit1 : ∀ w ∈ unitGroup F E 1,
      Units.map (normLM F hLE) w ∈ unitGroup F L 1 := by
    intro w hw
    have hw_diff : (w : E) - 1 = 0 ∨ 1 ≤ valL F E ((w : E) - 1) := by
      rcases (hunit_ge1_E 1 le_rfl w).mp hw with h1 | hge1
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge1
    set y : E := (w : E) - 1
    have hy_norm : ‖(y : AlgebraicClosure F)‖ < 1 := hE_norm_lt_one y hw_diff
    let y' : E' := toExtendScalars F hLE y
    have hw_eq_1y : toExtendScalars F hLE (w : E) = 1 + y' := by
      have hw_y : (w : E) = 1 + y := by dsimp [y]; ring
      conv_lhs => rw [hw_y, map_add, map_one]
    have hcoe_norm : ((((Units.map (normLM F hLE) w : Lˣ) : L) - 1 : L) : AlgebraicClosure F) =
        (∏ σ ∈ (Finset.univ : Finset (E' →ₐ[L] AlgebraicClosure F)), (1 + σ y')) - 1 := by
      change (algebraMap L (AlgebraicClosure F) (Algebra.norm L (toExtendScalars F hLE (w : E)))) - 1 = _
      rw [hw_eq_1y, Algebra.norm_eq_prod_embeddings L (AlgebraicClosure F) (1 + y')]
      congr 1
      refine Finset.prod_congr rfl (fun σ _ => ?_)
      rw [map_add, map_one]
    have hnorm_lt : ‖((((Units.map (normLM F hLE) w : Lˣ) : L) - 1 : L) : AlgebraicClosure F)‖ < 1 := by
      rw [hcoe_norm]
      apply hprod_one_add_lt Finset.univ y'
      intro σ _
      rw [hnorm_emb_eq σ y]
      exact hy_norm
    have hL_diff := hL_of_norm_lt_one (((Units.map (normLM F hLE) w : Lˣ) : L) - 1) hnorm_lt
    rw [hunit_ge1_L 1 le_rfl]
    rcases hL_diff with h0 | hge1
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hge1

  
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : k₁ ≤ valL F L x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_mul_ge_E : ∀ (k₁ k₂ : ℤ) (x y : E),
      (x = 0 ∨ k₁ ≤ valL F E x) → (y = 0 ∨ k₂ ≤ valL F E y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F E (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : k₁ ≤ valL F E x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F E y := hy.resolve_left hy0
        rw [hval_mul_E x y hx0 hy0]
        omega
  have hval_neg_ge_L : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hval_neg_L]; exact hx
  have hval_neg_ge_E : ∀ (k : ℤ) (x : E),
      (x = 0 ∨ k ≤ valL F E x) → (-x = 0 ∨ k ≤ valL F E (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hval_neg_E]; exact hx
  have hval_sub_ge_L : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
      (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_L k x (-y) hx (hval_neg_ge_L k y hy)
  have hval_sub_ge_E : ∀ (k : ℤ) (x y : E),
      (x = 0 ∨ k ≤ valL F E x) → (y = 0 ∨ k ≤ valL F E y) →
      (x - y = 0 ∨ k ≤ valL F E (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_E k x (-y) hx (hval_neg_ge_E k y hy)
  have hval_inc_ge : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) →
      (IntermediateField.inclusion hLE x = 0 ∨
        (q : ℤ) * k ≤ valL F E (IntermediateField.inclusion hLE x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hValAlgE x]
      exact mul_le_mul_of_nonneg_left hx (by omega)
  have hresL_congr : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (x₁ - x₂ = 0 ∨ 1 ≤ valL F L (x₁ - x₂)) → resL x₁ = resL x₂ := by
    intro x₁ x₂ hx₁ hx₂ hdiff
    have hsub_val : x₁ - x₂ = 0 ∨ 0 ≤ valL F L (x₁ - x₂) :=
      hval_sub_ge_L 0 x₁ x₂ hx₁ hx₂
    have hker0 : resL (x₁ - x₂) = 0 := (hresL_ker (x₁ - x₂) hsub_val).mpr hdiff
    have hneg_x₂ : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := hval_neg_ge_L 0 x₂ hx₂
    have hring1 := (hresL_ring x₁ (-x₂) hx₁ hneg_x₂).1
    have hring2 := (hresL_ring x₂ 0 hx₂ (Or.inl rfl)).2.2
    rw [sub_eq_add_neg, hring1, hring2] at hker0
    exact sub_eq_zero.mp (by linear_combination hker0)
  have hres_pow_L : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
      ∀ n : ℕ, (x ^ n = 0 ∨ 0 ≤ valL F L (x ^ n)) ∧ resL (x ^ n) = (resL x) ^ n := by
    intro x hx n
    induction n with
    | zero =>
      refine ⟨Or.inr (by rw [pow_zero, hval1_L]), ?_⟩
      rw [pow_zero, pow_zero, hresL_1]
    | succ n ih =>
      have hpow_val : x ^ (n + 1) = 0 ∨ 0 ≤ valL F L (x ^ (n + 1)) := by
        rw [pow_succ]
        simpa using hval_mul_ge_L 0 0 (x ^ n) x ih.1 hx
      refine ⟨hpow_val, ?_⟩
      rw [pow_succ, (hresL_ring (x ^ n) x ih.1 hx).2.1, ih.2, pow_succ]
  have hnorm_inc : ∀ x : L, normLM F hLE (IntermediateField.inclusion hLE x) = x ^ q := by
    intro x
    change Algebra.norm L (algebraMap L E' x) = x ^ q
    rw [Algebra.norm_algebraMap, hFinE_eq]

  let resE : E → k_L := fun y =>
    if hy : y = 0 ∨ 0 ≤ valL F E y then resL (hResLiftE y hy).choose else 0
  have hresE_char : ∀ y : E, ∀ x : L,
      (y = 0 ∨ 0 ≤ valL F E y) →
      (x = 0 ∨ 0 ≤ valL F L x) →
      (y - IntermediateField.inclusion hLE x = 0 ∨
        1 ≤ valL F E (y - IntermediateField.inclusion hLE x)) →
      resE y = resL x := by
    intro y x hy hx hdiff
    let x₀ : L := (hResLiftE y hy).choose
    have hx₀ : x₀ = 0 ∨ 0 ≤ valL F L x₀ := (hResLiftE y hy).choose_spec.1
    have hdiff₀ : y - IntermediateField.inclusion hLE x₀ = 0 ∨
        1 ≤ valL F E (y - IntermediateField.inclusion hLE x₀) :=
      (hResLiftE y hy).choose_spec.2
    have hresE_eq : resE y = resL x₀ := dif_pos hy
    rw [hresE_eq]
    have hinc_sub : IntermediateField.inclusion hLE (x₀ - x) =
        (y - IntermediateField.inclusion hLE x) - (y - IntermediateField.inclusion hLE x₀) := by
      rw [map_sub]; ring
    have hinc_val : IntermediateField.inclusion hLE (x₀ - x) = 0 ∨
        1 ≤ valL F E (IntermediateField.inclusion hLE (x₀ - x)) := by
      rw [hinc_sub]
      exact hval_sub_ge_E 1 _ _ hdiff hdiff₀
    have hsub_L : x₀ - x = 0 ∨ 1 ≤ valL F L (x₀ - x) := by
      by_cases hsub0 : x₀ - x = 0
      · exact Or.inl hsub0
      · right
        have hinc_ne0 : IntermediateField.inclusion hLE (x₀ - x) ≠ 0 :=
          (RingHom.injective (IntermediateField.inclusion hLE).toRingHom).ne hsub0
        have h1 : 1 ≤ valL F E (IntermediateField.inclusion hLE (x₀ - x)) :=
          hinc_val.resolve_left hinc_ne0
        rw [hValAlgE (x₀ - x)] at h1
        change 1 ≤ (q : ℤ) * valL F L (x₀ - x) at h1
        by_contra hlt
        have hle0 : valL F L (x₀ - x) ≤ 0 := by omega
        have : (q : ℤ) * valL F L (x₀ - x) ≤ (q : ℤ) * 0 :=
          mul_le_mul_of_nonneg_left hle0 (by omega)
        omega
    exact hresL_congr x₀ x hx₀ hx hsub_L
  have hresE_lift : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        resE y = resL x ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)) := by
    intro y hy
    exact ⟨(hResLiftE y hy).choose, (hResLiftE y hy).choose_spec.1,
      dif_pos hy, (hResLiftE y hy).choose_spec.2⟩
  have hresE_0 : resE 0 = 0 := by
    rw [hresE_char 0 0 (Or.inl rfl) (Or.inl rfl) (Or.inl (by simp)), hresL_0]
  have hresE_1 : resE 1 = 1 := by
    rw [hresE_char 1 1 (Or.inr (by rw [hval1_E])) (Or.inr (by rw [hval1_L]))
      (Or.inl (by simp)), hresL_1]
  have hresE_ring : ∀ y₁ y₂ : E, (y₁ = 0 ∨ 0 ≤ valL F E y₁) → (y₂ = 0 ∨ 0 ≤ valL F E y₂) →
      resE (y₁ + y₂) = resE y₁ + resE y₂ ∧
      resE (y₁ * y₂) = resE y₁ * resE y₂ ∧
      resE (-y₁) = -resE y₁ := by
    intro y₁ y₂ hy₁ hy₂
    obtain ⟨x₁, hx₁, hres₁, hdiff₁⟩ := hresE_lift y₁ hy₁
    obtain ⟨x₂, hx₂, hres₂, hdiff₂⟩ := hresE_lift y₂ hy₂
    refine ⟨?_, ?_, ?_⟩
    · have hy_add : y₁ + y₂ = 0 ∨ 0 ≤ valL F E (y₁ + y₂) := hval_add_E 0 y₁ y₂ hy₁ hy₂
      have hx_add : x₁ + x₂ = 0 ∨ 0 ≤ valL F L (x₁ + x₂) := hval_add_L 0 x₁ x₂ hx₁ hx₂
      have hdiff_add : (y₁ + y₂) - IntermediateField.inclusion hLE (x₁ + x₂) = 0 ∨
          1 ≤ valL F E ((y₁ + y₂) - IntermediateField.inclusion hLE (x₁ + x₂)) := by
        have heq : (y₁ + y₂) - IntermediateField.inclusion hLE (x₁ + x₂) =
            (y₁ - IntermediateField.inclusion hLE x₁) +
              (y₂ - IntermediateField.inclusion hLE x₂) := by
          rw [map_add]; ring
        rw [heq]
        exact hval_add_E 1 _ _ hdiff₁ hdiff₂
      rw [hresE_char (y₁ + y₂) (x₁ + x₂) hy_add hx_add hdiff_add,
        (hresL_ring x₁ x₂ hx₁ hx₂).1, hres₁, hres₂]
    · have hy_mul : y₁ * y₂ = 0 ∨ 0 ≤ valL F E (y₁ * y₂) := by
        simpa using hval_mul_ge_E 0 0 y₁ y₂ hy₁ hy₂
      have hx_mul : x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂) := by
        simpa using hval_mul_ge_L 0 0 x₁ x₂ hx₁ hx₂
      have hdiff_mul : (y₁ * y₂) - IntermediateField.inclusion hLE (x₁ * x₂) = 0 ∨
          1 ≤ valL F E ((y₁ * y₂) - IntermediateField.inclusion hLE (x₁ * x₂)) := by
        have heq : (y₁ * y₂) - IntermediateField.inclusion hLE (x₁ * x₂) =
            (y₁ - IntermediateField.inclusion hLE x₁) * y₂ +
              IntermediateField.inclusion hLE x₁ *
                (y₂ - IntermediateField.inclusion hLE x₂) := by
          rw [map_mul]; ring
        rw [heq]
        have ht1 : (y₁ - IntermediateField.inclusion hLE x₁) * y₂ = 0 ∨
            1 ≤ valL F E ((y₁ - IntermediateField.inclusion hLE x₁) * y₂) := by
          simpa using hval_mul_ge_E 1 0 _ y₂ hdiff₁ hy₂
        have hx₁_inc : IntermediateField.inclusion hLE x₁ = 0 ∨
            0 ≤ valL F E (IntermediateField.inclusion hLE x₁) := by
          simpa using hval_inc_ge 0 x₁ hx₁
        have ht2 : IntermediateField.inclusion hLE x₁ *
              (y₂ - IntermediateField.inclusion hLE x₂) = 0 ∨
            1 ≤ valL F E (IntermediateField.inclusion hLE x₁ *
              (y₂ - IntermediateField.inclusion hLE x₂)) := by
          simpa using hval_mul_ge_E 0 1 _ _ hx₁_inc hdiff₂
        exact hval_add_E 1 _ _ ht1 ht2
      rw [hresE_char (y₁ * y₂) (x₁ * x₂) hy_mul hx_mul hdiff_mul,
        (hresL_ring x₁ x₂ hx₁ hx₂).2.1, hres₁, hres₂]
    · have hy_neg : -y₁ = 0 ∨ 0 ≤ valL F E (-y₁) := hval_neg_ge_E 0 y₁ hy₁
      have hx_neg : -x₁ = 0 ∨ 0 ≤ valL F L (-x₁) := hval_neg_ge_L 0 x₁ hx₁
      have hdiff_neg : (-y₁) - IntermediateField.inclusion hLE (-x₁) = 0 ∨
          1 ≤ valL F E ((-y₁) - IntermediateField.inclusion hLE (-x₁)) := by
        have heq : (-y₁) - IntermediateField.inclusion hLE (-x₁) =
            -(y₁ - IntermediateField.inclusion hLE x₁) := by
          rw [map_neg]; ring
        rw [heq]
        exact hval_neg_ge_E 1 _ hdiff₁
      rw [hresE_char (-y₁) (-x₁) hy_neg hx_neg hdiff_neg,
        (hresL_ring x₁ x₂ hx₁ hx₂).2.2, hres₁]
  have hresE_ker : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      (resE y = 0 ↔ (y = 0 ∨ 1 ≤ valL F E y)) := by
    intro y hy
    obtain ⟨x, hx, hres, hdiff⟩ := hresE_lift y hy
    constructor
    · intro h0
      have hx0 : resL x = 0 := by rw [← hres, h0]
      have hx1 : x = 0 ∨ 1 ≤ valL F L x := (hresL_ker x hx).mp hx0
      have hx_inc1 : IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (IntermediateField.inclusion hLE x) := by
        rcases hval_inc_ge 1 x hx1 with hinc0 | hinc_le
        · exact Or.inl hinc0
        · right; omega
      have hy_eq : y = (y - IntermediateField.inclusion hLE x) +
          IntermediateField.inclusion hLE x := (sub_add_cancel y _).symm
      rw [hy_eq]
      exact hval_add_E 1 _ _ hdiff hx_inc1
    · intro hy1
      have hdiff0 : y - IntermediateField.inclusion hLE 0 = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE 0) := by
        simpa using hy1
      rw [hresE_char y 0 hy (Or.inl rfl) hdiff0, hresL_0]
  have hresE_surj : ∀ a : k_L, ∃ y : E, (y = 0 ∨ 0 ≤ valL F E y) ∧ resE y = a := by
    intro a
    obtain ⟨x, hx, hres_x⟩ := hresL_surj a
    let y : E := IntermediateField.inclusion hLE x
    have hy : y = 0 ∨ 0 ≤ valL F E y := by
      simpa [y] using hval_inc_ge 0 x hx
    refine ⟨y, hy, ?_⟩
    rw [hresE_char y x hy hx (Or.inl (sub_self y)), hres_x]
  have hresE_norm : ∀ w : Eˣ, valL F E (w : E) = 0 →
      resL ((Units.map (normLM F hLE) w : Lˣ) : L) = (resE (w : E)) ^ q := by
    intro w hw0
    have hw_val : (w : E) = 0 ∨ 0 ≤ valL F E (w : E) := Or.inr (by omega)
    obtain ⟨x, hx_val, hres_eq, hdiff⟩ := hresE_lift (w : E) hw_val
    have hw_not_ker : ¬ ((w : E) = 0 ∨ 1 ≤ valL F E (w : E)) := by
      rintro (hw_z | hw_ge1)
      · exact Units.ne_zero w hw_z
      · omega
    have hresE_ne0 : resE (w : E) ≠ 0 := by
      intro h0
      exact hw_not_ker ((hresE_ker (w : E) hw_val).mp h0)
    have hresL_ne0 : resL x ≠ 0 := by
      rw [← hres_eq]; exact hresE_ne0
    have hx_not_ker : ¬ (x = 0 ∨ 1 ≤ valL F L x) := by
      intro hker
      exact hresL_ne0 ((hresL_ker x hx_val).mpr hker)
    have hx_ne0 : x ≠ 0 := fun h0 => hx_not_ker (Or.inl h0)
    have hx_val0 : valL F L x = 0 := by
      have hx_ge0 : 0 ≤ valL F L x := hx_val.resolve_left hx_ne0
      have hx_lt1 : ¬ (1 ≤ valL F L x) := fun h1 => hx_not_ker (Or.inr h1)
      omega
    let u_x : Lˣ := Units.mk0 x hx_ne0
    let w_x : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom u_x
    have hwx_coe : (w_x : E) = IntermediateField.inclusion hLE x := rfl
    have hwx_inv_val : valL F E ((w_x⁻¹ : Eˣ) : E) = 0 := by
      rw [hval_inv_E w_x, hwx_coe, hValAlgE x, hx_val0, mul_zero, neg_zero]
    let w₁ : Eˣ := w * w_x⁻¹
    have hw₁_sub : (w₁ : E) - 1 =
        ((w : E) - IntermediateField.inclusion hLE x) * ((w_x⁻¹ : Eˣ) : E) := by
      calc (w₁ : E) - 1 = (w : E) * ((w_x⁻¹ : Eˣ) : E) - (w_x : E) * ((w_x⁻¹ : Eˣ) : E) := by
            rw [Units.mul_inv]; rfl
        _ = ((w : E) - IntermediateField.inclusion hLE x) * ((w_x⁻¹ : Eˣ) : E) := by
            rw [hwx_coe, sub_mul]
    have hw₁_diff : (w₁ : E) - 1 = 0 ∨ 1 ≤ valL F E ((w₁ : E) - 1) := by
      rw [hw₁_sub]
      simpa using hval_mul_ge_E 1 0 _ ((w_x⁻¹ : Eˣ) : E) hdiff (Or.inr (by omega))
    have hw₁_mem1 : w₁ ∈ unitGroup F E 1 := by
      rw [hunit_ge1_E 1 le_rfl w₁]
      rcases hw₁_diff with h0 | h1
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr h1
    have hnw₁_mem1 : Units.map (normLM F hLE) w₁ ∈ unitGroup F L 1 :=
      hnorm_unit1 w₁ hw₁_mem1
    have hnw₁_diff : ((Units.map (normLM F hLE) w₁ : Lˣ) : L) - 1 = 0 ∨
        1 ≤ valL F L (((Units.map (normLM F hLE) w₁ : Lˣ) : L) - 1) := by
      rcases (hunit_ge1_L 1 le_rfl _).mp hnw₁_mem1 with h1 | hge1
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge1
    have hnw_x : ((Units.map (normLM F hLE) w_x : Lˣ) : L) = x ^ q := hnorm_inc x
    have hw_eq : w = w₁ * w_x := by
      dsimp [w₁]
      exact (inv_mul_cancel_right w w_x).symm
    have hnw_sub : ((Units.map (normLM F hLE) w : Lˣ) : L) - x ^ q =
        (((Units.map (normLM F hLE) w₁ : Lˣ) : L) - 1) * (x ^ q) := by
      conv_lhs => rw [hw_eq, map_mul, Units.val_mul, hnw_x]
      ring
    have hxq_val : x ^ q = 0 ∨ 0 ≤ valL F L (x ^ q) := (hres_pow_L x hx_val q).1
    have hnw_diff : ((Units.map (normLM F hLE) w : Lˣ) : L) - x ^ q = 0 ∨
        1 ≤ valL F L (((Units.map (normLM F hLE) w : Lˣ) : L) - x ^ q) := by
      rw [hnw_sub]
      simpa using hval_mul_ge_L 1 0 _ (x ^ q) hnw₁_diff hxq_val
    have hnw_val : ((Units.map (normLM F hLE) w : Lˣ) : L) = 0 ∨
        0 ≤ valL F L ((Units.map (normLM F hLE) w : Lˣ) : L) := by
      have heq : ((Units.map (normLM F hLE) w : Lˣ) : L) =
          (((Units.map (normLM F hLE) w : Lˣ) : L) - x ^ q) + x ^ q :=
        (sub_add_cancel _ _).symm
      rw [heq]
      have hnw_diff0 : ((Units.map (normLM F hLE) w : Lˣ) : L) - x ^ q = 0 ∨
          0 ≤ valL F L (((Units.map (normLM F hLE) w : Lˣ) : L) - x ^ q) := by
        rcases hnw_diff with h0 | h1
        · exact Or.inl h0
        · right; omega
      exact hval_add_L 0 _ _ hnw_diff0 hxq_val
    rw [hresL_congr _ (x ^ q) hnw_val hxq_val hnw_diff,
      (hres_pow_L x hx_val q).2, hres_eq]

  
  obtain ⟨hψ_triv, _, hχ'_nontriv, htateL_val⟩ :=
    ld_condExp_and_condExpChar_spec F L ψ hψ χ'
  obtain ⟨_, ⟨u₀, hu₀_mem, hu₀_ne1⟩⟩ := hχ'_nontriv (by omega)
  have hu₀_mem0 : u₀ ∈ unitGroup F L 0 := by simpa [ha1] using hu₀_mem
  have hu₀_val0 : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀_mem0
  have hu₀_int : (u₀ : L) = 0 ∨ 0 ≤ valL F L (u₀ : L) := Or.inr (by omega)
  set χ'_E : Eˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLE))
  have hχ'_triv1 : ∀ u ∈ unitGroup F L 1, χ' u = 1 := ha1 ▸ hχ'_cond
  have hcondE_le1 : condExp F E χ'_E ≤ 1 := by
    apply Nat.sInf_le
    intro w hw
    exact hχ'_triv1 (Units.map (normLM F hLE) w) (hnorm_unit1 w hw)
  obtain ⟨s₀, hs₀_int, hs₀_frob⟩ := hFrobSurjL (u₀ : L) hu₀_int
  have hs₀_pow_int : s₀ ^ q = 0 ∨ 0 ≤ valL F L (s₀ ^ q) := (hres_pow_L s₀ hs₀_int q).1
  have hres_u₀_eq : resL (u₀ : L) = (resL s₀) ^ q := by
    rw [hresL_congr (u₀ : L) (s₀ ^ q) hu₀_int hs₀_pow_int hs₀_frob, (hres_pow_L s₀ hs₀_int q).2]
  have hres_u₀_ne0 : resL (u₀ : L) ≠ 0 := by
    intro h0
    rcases (hresL_ker (u₀ : L) hu₀_int).mp h0 with hu0 | hu1
    · exact Units.ne_zero u₀ hu0
    · omega
  have hres_s₀_ne0 : resL s₀ ≠ 0 := by
    intro h0
    apply hres_u₀_ne0
    rw [hres_u₀_eq, h0, zero_pow hq_ne_zero]
  have hs₀_not_ker : ¬ (s₀ = 0 ∨ 1 ≤ valL F L s₀) :=
    fun hker => hres_s₀_ne0 ((hresL_ker s₀ hs₀_int).mpr hker)
  have hs₀_ne0 : s₀ ≠ 0 := fun h0 => hs₀_not_ker (Or.inl h0)
  have hs₀_val0 : valL F L s₀ = 0 := by
    have hge0 : 0 ≤ valL F L s₀ := hs₀_int.resolve_left hs₀_ne0
    have hlt1 : ¬ (1 ≤ valL F L s₀) := fun h1 => hs₀_not_ker (Or.inr h1)
    omega
  let v₀ : Lˣ := Units.mk0 s₀ hs₀_ne0
  let w₀ : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom v₀
  have hw₀_val0 : valL F E (w₀ : E) = 0 := by
    change valL F E (IntermediateField.inclusion hLE s₀) = 0
    rw [hValAlgE s₀, hs₀_val0, mul_zero]
  have hw₀_mem0 : w₀ ∈ unitGroup F E 0 := (hunit0_E w₀).mpr hw₀_val0
  have hnw₀_eq : Units.map (normLM F hLE) w₀ = v₀ ^ q := by
    apply Units.ext
    change normLM F hLE (IntermediateField.inclusion hLE s₀) = s₀ ^ q
    exact hnorm_inc s₀
  have hv₀q_inv_val0 : valL F L ((((v₀ ^ q)⁻¹ : Lˣ) : L)) = 0 := by
    rw [hval_inv_L (v₀ ^ q)]
    have hv₀q_coe : ((v₀ ^ q : Lˣ) : L) = s₀ ^ q := Units.val_pow_eq_pow_val v₀ q
    have hres_sq_ne0 : resL (s₀ ^ q) ≠ 0 := by
      rw [← hresL_congr (u₀ : L) (s₀ ^ q) hu₀_int hs₀_pow_int hs₀_frob]
      exact hres_u₀_ne0
    have hsq_not_ker : ¬ (s₀ ^ q = 0 ∨ 1 ≤ valL F L (s₀ ^ q)) :=
      fun hker => hres_sq_ne0 ((hresL_ker (s₀ ^ q) hs₀_pow_int).mpr hker)
    have hsq_ge0 : 0 ≤ valL F L (s₀ ^ q) := hs₀_pow_int.resolve_left (pow_ne_zero q hs₀_ne0)
    have hsq_lt1 : ¬ (1 ≤ valL F L (s₀ ^ q)) := fun h1 => hsq_not_ker (Or.inr h1)
    rw [hv₀q_coe]
    omega
  have hu₀_v₀q_mem1 : (v₀ ^ q)⁻¹ * u₀ ∈ unitGroup F L 1 := by
    rw [hunit_ge1_L 1 le_rfl]
    have hsub : ((((v₀ ^ q)⁻¹ * u₀ : Lˣ) : L)) - 1 =
        ((((v₀ ^ q)⁻¹ : Lˣ) : L)) * ((u₀ : L) - s₀ ^ q) := by
      have hinv : ((((v₀ ^ q)⁻¹ : Lˣ) : L)) * ((v₀ ^ q : Lˣ) : L) = 1 :=
        Units.inv_mul (v₀ ^ q)
      have hv₀q_coe : ((v₀ ^ q : Lˣ) : L) = s₀ ^ q := Units.val_pow_eq_pow_val v₀ q
      calc ((((v₀ ^ q)⁻¹ * u₀ : Lˣ) : L)) - 1 =
            ((((v₀ ^ q)⁻¹ : Lˣ) : L)) * (u₀ : L) -
              ((((v₀ ^ q)⁻¹ : Lˣ) : L)) * ((v₀ ^ q : Lˣ) : L) := by
            rw [hinv]; rfl
        _ = ((((v₀ ^ q)⁻¹ : Lˣ) : L)) * ((u₀ : L) - s₀ ^ q) := by
            rw [hv₀q_coe]; ring
    have hprod_ge1 : ((((v₀ ^ q)⁻¹ : Lˣ) : L)) * ((u₀ : L) - s₀ ^ q) = 0 ∨
        1 ≤ valL F L (((((v₀ ^ q)⁻¹ : Lˣ) : L)) * ((u₀ : L) - s₀ ^ q)) := by
      simpa using hval_mul_ge_L 0 1 ((((v₀ ^ q)⁻¹ : Lˣ) : L)) ((u₀ : L) - s₀ ^ q)
        (Or.inr (by omega)) hs₀_frob
    rw [← hsub] at hprod_ge1
    rcases hprod_ge1 with h0 | h1
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr h1
  have hχ'_E_w₀_ne1 : χ'_E w₀ ≠ 1 := by
    change χ' (Units.map (normLM F hLE) w₀) ≠ 1
    rw [hnw₀_eq]
    have htriv : χ' ((v₀ ^ q)⁻¹ * u₀) = 1 := hχ'_triv1 _ hu₀_v₀q_mem1
    have heq : v₀ ^ q * ((v₀ ^ q)⁻¹ * u₀) = u₀ := mul_inv_cancel_left (v₀ ^ q) u₀
    have hχ_eq : χ' u₀ = χ' (v₀ ^ q) := by
      rw [← heq, map_mul, htriv, mul_one]
    rw [← hχ_eq]
    exact hu₀_ne1
  have hcondE_ne0 : condExp F E χ'_E ≠ 0 := by
    intro h0
    apply hχ'_E_w₀_ne1
    exact hχ'E_cond w₀ (by simpa [h0] using hw₀_mem0)
  have haE : condExp F E χ'_E = 1 := by omega

  
  have htate_L1 : tateEps F L 1 ψ = (qL F L : Ω F) ^ condExpChar F L ψ := by
    have hcond_L1 : condExp F L (1 : Lˣ →* (Ω F)ˣ) = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    rw [tateEps, if_pos hcond_L1, MonoidHom.one_apply, Units.val_one, mul_one]
  have htate_E1 : tateEps F E 1 (traceChar F hLE ψ) =
      (qL F L : Ω F) ^ condExpChar F E (traceChar F hLE ψ) := by
    have hcond_E1 : condExp F E (1 : Eˣ →* (Ω F)ˣ) = 0 :=
      Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
    rw [tateEps, if_pos hcond_E1, MonoidHom.one_apply, Units.val_one, mul_one, hqE]

  set c_1 : Lˣ := tateElt F L χ' ψ
  have hc_1_val : valL F L (c_1 : L) = 1 + condExpChar F L ψ := by
    rw [htateL_val, ha1]
    norm_num
  set s_L : k_L → L := fun a => (hresL_surj a).choose
  have hs_L_int : ∀ a : k_L, s_L a = 0 ∨ 0 ≤ valL F L (s_L a) :=
    fun a => (hresL_surj a).choose_spec.1
  have hs_L_res : ∀ a : k_L, resL (s_L a) = a :=
    fun a => (hresL_surj a).choose_spec.2
  have hs_L_ne : ∀ (a : k_L), a ≠ 0 → s_L a ≠ 0 := by
    intro a ha h0
    apply ha
    rw [← hs_L_res a, h0, hresL_0]
  have hs_L_val0 : ∀ (a : k_L), a ≠ 0 → valL F L (s_L a) = 0 := by
    intro a ha
    have hne : s_L a ≠ 0 := hs_L_ne a ha
    have hge0 : 0 ≤ valL F L (s_L a) := (hs_L_int a).resolve_left hne
    by_contra hne0
    have hge1 : 1 ≤ valL F L (s_L a) := by omega
    have hres0 : resL (s_L a) = 0 := (hresL_ker (s_L a) (hs_L_int a)).mpr (Or.inr hge1)
    rw [hs_L_res a] at hres0
    exact ha hres0

  set χ_tilde : k_L → Ω F := fun a =>
    if ha : a = 0 then 0 else (χ' (Units.mk0 (s_L a) (hs_L_ne a ha)) : Ω F)⁻¹
  set ψ_tilde : k_L → Ω F := fun a =>
    ψ (((c_1⁻¹ : Lˣ) : L) * s_L a)
  have hχ_zero : χ_tilde 0 = 0 := dif_pos rfl
  have hχ_unit : ∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde (resL (u : L)) = (χ' u : Ω F)⁻¹ := by
    intro u hu
    set a := resL (u : L)
    have hu_int : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
    have ha : a ≠ 0 := by
      intro h0
      rcases (hresL_ker (u : L) hu_int).mp h0 with hu0 | hu1
      · exact Units.ne_zero u hu0
      · omega
    change (if ha' : a = 0 then 0 else (χ' (Units.mk0 (s_L a) (hs_L_ne a ha')) : Ω F)⁻¹) =
      (χ' u : Ω F)⁻¹
    rw [dif_neg ha]
    set v_a : Lˣ := Units.mk0 (s_L a) (hs_L_ne a ha)
    have hv_a_val : valL F L (v_a : L) = 0 := hs_L_val0 a ha
    have hv_a_int : (v_a : L) = 0 ∨ 0 ≤ valL F L (v_a : L) := hs_L_int a
    have hv_a_res : resL (v_a : L) = a := hs_L_res a
    have hneg_va_int : -(v_a : L) = 0 ∨ 0 ≤ valL F L (-(v_a : L)) := by
      rw [neg_eq_zero, hval_neg_L]
      exact hv_a_int
    set d : L := (u : L) - (v_a : L)
    have hd_eq : d = (u : L) + -(v_a : L) := sub_eq_add_neg _ _
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      rw [hd_eq]
      exact hval_add_L 0 (u : L) (-(v_a : L)) hu_int hneg_va_int
    have hd_res : resL d = 0 := by
      rw [hd_eq, (hresL_ring (u : L) (-(v_a : L)) hu_int hneg_va_int).1,
        (hresL_ring (v_a : L) 0 hv_a_int (Or.inl rfl)).2.2, hv_a_res]
      exact add_neg_cancel a
    have hd_val : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set h : Lˣ := v_a⁻¹ * u
    have hh_sub : (h : L) - 1 = ((v_a⁻¹ : Lˣ) : L) * d := by
      have hv_inv : ((v_a⁻¹ : Lˣ) : L) * (v_a : L) = 1 := Units.inv_mul v_a
      calc
        (h : L) - 1 = ((v_a⁻¹ : Lˣ) : L) * (u : L) - ((v_a⁻¹ : Lˣ) : L) * (v_a : L) := by
          rw [hv_inv]; rfl
        _ = ((v_a⁻¹ : Lˣ) : L) * d := by ring
    have hh_mem : h ∈ unitGroup F L (condExp F L χ') := by
      rw [hunit_ge1_L (condExp F L χ') (by omega) h, ha1]
      rcases hd_val with hd0 | hd1
      · left
        have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        rw [hh_sub]
        have hd_ne : d ≠ 0 := by
          intro h0
          rw [h0, hval0_L] at hd1
          omega
        rw [hval_mul_L ((v_a⁻¹ : Lˣ) : L) d (Units.ne_zero v_a⁻¹) hd_ne,
          hval_inv_L v_a, hv_a_val]
        omega
    have hχ_h : χ' h = 1 := hχ'_cond h hh_mem
    have hu_eq : v_a * h = u := mul_inv_cancel_left v_a u
    have hχ_eq : χ' u = χ' v_a := by
      rw [← hu_eq, map_mul, hχ_h, mul_one]
    rw [hχ_eq]

  have hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ (((c_1⁻¹ : Lˣ) : L) * x) := by
    intro x hx
    set a := resL x
    have hsa_int : s_L a = 0 ∨ 0 ≤ valL F L (s_L a) := hs_L_int a
    have hneg_sa_int : -(s_L a) = 0 ∨ 0 ≤ valL F L (-(s_L a)) := by
      rw [neg_eq_zero, hval_neg_L]
      exact hsa_int
    set d : L := x - s_L a
    have hd_eq : d = x + -(s_L a) := sub_eq_add_neg _ _
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      rw [hd_eq]
      exact hval_add_L 0 x (-(s_L a)) hx hneg_sa_int
    have hd_res : resL d = 0 := by
      rw [hd_eq, (hresL_ring x (-(s_L a)) hx hneg_sa_int).1,
        (hresL_ring (s_L a) 0 hsa_int (Or.inl rfl)).2.2, hs_L_res a]
      exact add_neg_cancel a
    have hd_val : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set w : L := ((c_1⁻¹ : Lˣ) : L) * d
    have hw_val : w = 0 ∨ -condExpChar F L ψ ≤ valL F L w := by
      rcases hd_val with hd0 | hd1
      · left; simp [w, hd0]
      · right
        have hd_ne : d ≠ 0 := by
          intro h0
          rw [h0, hval0_L] at hd1
          omega
        rw [hval_mul_L ((c_1⁻¹ : Lˣ) : L) d (Units.ne_zero c_1⁻¹) hd_ne,
          hval_inv_L c_1, hc_1_val]
        omega
    have hψ_w : ψ w = 1 := hψ_triv w hw_val
    have hx_split : ((c_1⁻¹ : Lˣ) : L) * x = ((c_1⁻¹ : Lˣ) : L) * s_L a + w := by
      simp only [w, d]
      ring
    change ψ (((c_1⁻¹ : Lˣ) : L) * s_L a) = ψ (((c_1⁻¹ : Lˣ) : L) * x)
    rw [hx_split, ψ.map_add_eq_mul, hψ_w, mul_one]

  have hFinL1 := ld_unitCoset_finite F L (condExp F L χ') (by omega)
  have htate_L := ld_cond_one_tateEps_eq_residue_gauss_sum F L ψ χ' ha1 htateL_val hFinL1
    ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_add_L,
      hunit_ge1_L, hunit_val0_L⟩
    k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
    c_1 hc_1_val χ_tilde ψ_tilde hχ_zero hχ_unit hψ_int

  set ψ_E : AddChar E (Ω F) := traceChar F hLE ψ
  have htateE_val :=
    (ld_condExp_and_condExpChar_spec F E ψ_E hψE χ'_E).2.2.2
  have hFinE1 := ld_unitCoset_finite F E (condExp F E χ'_E) (by omega)

  set χ_tilde_E : k_L → Ω F := fun b => χ_tilde (b ^ q)
  set ψ_tilde_E : k_L → Ω F := fun b => ψ_tilde (b ^ q)
  have hχE_zero : χ_tilde_E 0 = 0 := by
    change χ_tilde ((0 : k_L) ^ q) = 0
    rw [zero_pow hq_ne_zero, hχ_zero]
  have hχE_unit : ∀ w : Eˣ, valL F E (w : E) = 0 →
      χ_tilde_E (resE (w : E)) = (χ'_E w : Ω F)⁻¹ := by
    intro w hw
    set u_w : Lˣ := Units.map (normLM F hLE) w
    have hu_w_val : valL F L (u_w : L) = 0 := by
      change valL F L (normLM F hLE (w : E)) = 0
      rw [hValNormE (w : E), hw]
    have hres_eq : resL (u_w : L) = (resE (w : E)) ^ q := hresE_norm w hw
    change χ_tilde ((resE (w : E)) ^ q) = (χ' u_w : Ω F)⁻¹
    rw [← hres_eq]
    exact hχ_unit u_w hu_w_val
  have hψE_int : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ψ_tilde_E (resE y) = ψ_E (((c_E⁻¹ : Eˣ) : E) * y) := by
    intro y hy
    obtain ⟨x, hx_int, hres_eq, hyx⟩ := hresE_lift y hy
    have hxq := hres_pow_L x hx_int q
    calc ψ_tilde_E (resE y)
      _ = ψ_tilde ((resE y) ^ q) := rfl
      _ = ψ_tilde (resL (x ^ q)) := by rw [hres_eq, ← hxq.2]
      _ = ψ (((c_1⁻¹ : Lˣ) : L) * (x ^ q)) := hψ_int (x ^ q) hxq.1
      _ = ψ_E (((c_E⁻¹ : Eˣ) : E) * y) := (hc_E_psi y hy x hx_int hyx).symm

  have htate_E := ld_cond_one_tateEps_eq_residue_gauss_sum F E ψ_E χ'_E haE htateE_val hFinE1
    ⟨hval0_E, hval1_E, hval_neg1_E, hval_neg_E, hval_mul_E, hval_inv_E, hval_add_E,
      hunit_ge1_E, hunit_val0_E⟩
    k_L resE hresE_0 hresE_1 hresE_ring hresE_ker hresE_surj
    c_E hc_E_val χ_tilde_E ψ_tilde_E hχE_zero hχE_unit hψE_int
  rw [hqE] at htate_E

  have hfrob_surj_kL : Function.Surjective (fun b : k_L => b ^ q) := by
    intro a
    obtain ⟨s, hs_int, hs_frob⟩ := hFrobSurjL (s_L a) (hs_L_int a)
    have hsq := hres_pow_L s hs_int q
    have hneg_sq_int : -(s ^ q) = 0 ∨ 0 ≤ valL F L (-(s ^ q)) := by
      rw [neg_eq_zero, hval_neg_L]
      exact hsq.1
    set d : L := s_L a - s ^ q
    have hd_eq : d = s_L a + -(s ^ q) := sub_eq_add_neg _ _
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      rw [hd_eq]
      exact hval_add_L 0 (s_L a) (-(s ^ q)) (hs_L_int a) hneg_sq_int
    have hd_res0 : resL d = 0 := (hresL_ker d hd_int).mpr hs_frob
    have hd_res_calc : resL d = a - (resL s) ^ q := by
      rw [hd_eq, (hresL_ring (s_L a) (-(s ^ q)) (hs_L_int a) hneg_sq_int).1,
        (hresL_ring (s ^ q) 0 hsq.1 (Or.inl rfl)).2.2, hs_L_res a, hsq.2]
      ring
    rw [hd_res_calc] at hd_res0
    exact ⟨resL s, (sub_eq_zero.mp hd_res0).symm⟩
  have hfrob_bij : Function.Bijective (fun b : k_L => b ^ q) :=
    (Fintype.bijective_iff_surjective_and_card (fun b : k_L => b ^ q)).mpr ⟨hfrob_surj_kL, rfl⟩
  have hsum_eq : (∑ b : k_L, χ_tilde_E b * ψ_tilde_E b) =
      (∑ a : k_L, χ_tilde a * ψ_tilde a) :=
    Equiv.sum_comp (Equiv.ofBijective (fun b : k_L => b ^ q) hfrob_bij)
      (fun a => χ_tilde a * ψ_tilde a)

  set u_pref : Lˣ := ∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)
  have hχ_cE : (χ'_E c_E : Ω F) = (χ' c_1 : Ω F) * (χ' u_pref : Ω F) := by
    have hmem : Units.map (normLM F hLE) c_E * (c_1 * u_pref)⁻¹ ∈
        unitGroup F L (condExp F L χ') := ha1.symm ▸ hc_E_norm
    have h1 : χ' (Units.map (normLM F hLE) c_E * (c_1 * u_pref)⁻¹) = 1 :=
      hχ'_cond _ hmem
    rw [map_mul, map_inv, mul_inv_eq_one, map_mul] at h1
    exact_mod_cast h1
  have hχ_upref : (χ' u_pref : Ω F) =
      ∏ i : Fin D_orb.length,
        (χ' (Units.map (normLM F (D_orb.get i).le) (c_orb i)) : Ω F) := by
    change (Units.coeHom (Ω F)) (χ' (∏ i : Fin D_orb.length,
      Units.map (normLM F (D_orb.get i).le) (c_orb i))) = _
    rw [map_prod, map_prod]
    rfl
  have hprod_twist :
      (∏ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (traceChar F (D_orb.get i).le ψ)) =
      (∏ i : Fin D_orb.length,
        (χ' (Units.map (normLM F (D_orb.get i).le) (c_orb i)) : Ω F)) *
      (∏ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)) := by
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i _ => hTwist_orb i)

  change tateEps F E χ'_E ψ_E * tateEps F L 1 ψ *
      (∏ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)) =
    tateEps F E 1 ψ_E * tateEps F L χ' ψ *
      (∏ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (traceChar F (D_orb.get i).le ψ))
  rw [htate_E, htate_L, htate_E1, htate_L1, hsum_eq, hχ_cE, hχ_upref, hprod_twist]
  ring

theorem ld_ch14_lemma_14_2_low_conductor_exact (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (χ : relWeil F L →* (Ω F)ˣ) (hχ : IsWeilRep F L (charRep F L χ))
    (h_low : condExp F L (recChar F rec L χ) ≤ 1) :
    tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χ)) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
    tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ
        ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χ)) :=
by
  obtain ⟨hFinL, hFinMC, hFinE, hFinK, hFinFi, hGalMCK, hGalFiK, hSepLE, hSepLFi,
      hψMC, hψE, hψK, hψFi, hLMC_gt1, hq_gt1, hr_pos, hDegSum,
      χ', hFiMC, μ'_orb, hχ'_le1, hχ'_cond, hχ'E_cond, hμ'_props, hOrbitEnum, hRed⟩ :=
    ld_ch14_wild_orbit_recChar_and_tateEps_reduction F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin h_wild hFinE_eq
      D_orb hD₁_sub hD_orb_deg hD_orb_props χ hχ h_low
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F M_C := hFinMC
  haveI : FiniteDimensional F E := hFinE
  haveI : FiniteDimensional F K := hFinK
  apply hRed
  obtain ⟨hq_pow, hqE, hresE, hValNormE, hValAlgE, hResLiftE, hFrobSurjL,
      hFrobSurjLp, hFrobSurjMC,
      hqK, hresK, hValNormK, hValAlgK, hResLiftK, hDiamondTrNorm,
      t, k, ht_ge1, hk_ge1, hk_dvd, hValAlgKE, hValAlgMCL, hTrBoundMCL, hTrFrobMCL, hnMC, hnE,
      htr_bound_K, hFi_ram, hPoly14_6, hCond0⟩ :=
    ld_ch14_wild_semidirect_ramification_and_cond_zero F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hGalMCK hSepLE hMin h_wild hFinE_eq
      ψ hψ hψMC hψE hψK D_orb hFinFi hGalFiK hSepLFi hψFi hDegSum
      χ' hFiMC μ'_orb hχ'_cond hχ'E_cond hμ'_props
  by_cases ha0 : condExp F L χ' = 0
  · exact hCond0 ha0
  · have ha1 : condExp F L χ' = 1 := by omega
    obtain ⟨c_orb, c_E, hTwist_orb, hc_E_val, hc_E_norm, hc_E_psi⟩ :=
      ld_ch14_lemma_14_6_and_stationary_phase_norm_product F L K M_C E hLK hLM_C hM_CK hLE hEK
        hGal hGalMCK hFinE_eq ψ hψ hψMC hψE D_orb hFinFi hSepLFi hψFi hDegSum χ' ha1 hFiMC μ'_orb
        hχ'_cond hμ'_props hOrbitEnum hValNormE hValAlgE hResLiftE hFrobSurjL
        hFrobSurjLp hFrobSurjMC
        hValNormK hValAlgK hResLiftK hDiamondTrNorm t k ht_ge1 hk_ge1 hk_dvd
        hValAlgKE hValAlgMCL hTrBoundMCL hTrFrobMCL hnMC hnE htr_bound_K hFi_ram hPoly14_6
    exact ld_ch14_wild_cond_one_frob_gauss_assembly F L M_C E
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) hLE hSepLE hFinE_eq
      ψ hψ hψE D_orb χ' ha1 μ'_orb hχ'_cond hχ'E_cond hq_pow hqE
      hValNormE hValAlgE hResLiftE hFrobSurjL c_orb c_E
      hTwist_orb hc_E_val hc_E_norm hc_E_psi

theorem ld_ch14_stickelberger_orbit_recChar_and_pow_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (h_ge2 : 2 ≤ condExp F L (recChar F rec L χL_ext)) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let χ' := recChar F rec L χL_ext
    FiniteDimensional F L ∧
    FiniteDimensional F M_C ∧
    FiniteDimensional F E ∧
    FiniteDimensional F K ∧
    IsGaloisExt F M_C K ∧
    Algebra.IsSeparable L (IntermediateField.extendScalars hLE) ∧
    IsAdmissibleChar F M_C (traceChar F hLM_C ψ) ∧
    IsAdmissibleChar F E (traceChar F hLE ψ) ∧
    IsAdmissibleChar F K (traceChar F hLK ψ) ∧
    1 < Module.finrank L (IntermediateField.extendScalars hLM_C) ∧
    1 < q ∧
    1 ≤ D_orb.length ∧
    (D_orb.map fun t => Module.finrank L (IntermediateField.extendScalars t.le)).sum = q - 1 ∧
    (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
    (∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1) ∧
    (∀ t ∈ D_orb,
      FiniteDimensional F t.field ∧
      IsGaloisExt F t.field K ∧
      IsGaloisExt F t.field M_C ∧
      Algebra.IsSeparable L (IntermediateField.extendScalars t.le) ∧
      IsAdmissibleChar F t.field (traceChar F t.le ψ) ∧
      (recChar F rec t.field t.χ) ^ (p F) = 1 ∧
      recChar F rec t.field t.χ ≠ 1 ∧
      (∀ u ∈ unitGroup F t.field (condExp F t.field (recChar F rec t.field t.χ)),
        (recChar F rec t.field t.χ) u = 1) ∧
      (∀ u ∈ unitGroup F t.field
          (condExp F t.field
            (recChar F rec t.field t.χ * χ'.comp (Units.map (normLM F t.le)))),
        (recChar F rec t.field t.χ * χ'.comp (Units.map (normLM F t.le))) u = 1) ∧
      ∃ (hFtMC : t.field ≤ M_C) (K_t : IntermediateField F (AlgebraicClosure F))
        (hFtKt : t.field ≤ K_t) (hKtEt : K_t ≤ E ⊔ t.field),
        Algebra.IsSeparable t.field (IntermediateField.extendScalars hFtMC) ∧
