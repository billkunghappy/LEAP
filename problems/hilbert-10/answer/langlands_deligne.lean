    have h1 := hvalL_mul_ge ((((p - 2) * m : ℕ) : ℤ)) q_s
      (u ^ (p - 2)) H (Or.inr (le_of_eq hu_pow_val.symm)) hH_val
    have h2 := hvalL_mul_ge ((((p - 2) * m : ℕ) : ℤ) + q_s) m_x1
      (u ^ (p - 2) * H) (P_star - D) h1 hPstar_sub_D
    have h3 := hvalL_mul_ge (((((p - 2) * m : ℕ) : ℤ) + q_s) + m_x1) 0
      ((u ^ (p - 2) * H) * (P_star - D)) P_star⁻¹ h2 (Or.inr (le_of_eq hPstar_inv_val0.symm))
    have h4 := hvalL_mul_ge ((((((p - 2) * m : ℕ) : ℤ) + q_s) + m_x1) + 0) 0
      (((u ^ (p - 2) * H) * (P_star - D)) * P_star⁻¹) D⁻¹ h3 (Or.inr (le_of_eq hD_inv_val0.symm))
    apply hvalL_mono (bE' : ℤ) _ _ _ h4
    have hpm_t₁_ge1 : 1 ≤ ((p * m - t₁ : ℕ) : ℤ) := by
      exact_mod_cast (show 1 ≤ p * m - t₁ by omega)
    have hp2m_ge_t₁ : (t₁ : ℤ) + 1 ≤ (p : ℤ) * ((((p - 2) * m : ℕ) : ℤ)) := by
      have h_p2 : 1 ≤ p - 2 := by omega
      have h_m : m ≤ (p - 2) * m := by
        calc m = 1 * m := (one_mul m).symm
          _ ≤ (p - 2) * m := Nat.mul_le_mul_right m h_p2
      have h_pm : t₁ + 1 ≤ p * ((p - 2) * m) :=
        le_trans (by omega : t₁ + 1 ≤ p * m) (Nat.mul_le_mul_left p h_m)
      have h_int : ((t₁ + 1 : ℕ) : ℤ) ≤ ((p * ((p - 2) * m) : ℕ) : ℤ) := by exact_mod_cast h_pm
      push_cast at h_int
      exact h_int
    have hδ_ge : (δ : ℤ) ≤ (p : ℤ) * q_s := by
      have h_p1 : 1 ≤ p * (p - 1) := Nat.mul_pos hp_pos (by omega)
      have h_δ : δ ≤ p * ((p - 1) * δ) := by
        calc δ = 1 * δ := (one_mul δ).symm
          _ ≤ (p * (p - 1)) * δ := Nat.mul_le_mul_right δ h_p1
          _ = p * ((p - 1) * δ) := by ring
      have h_int : (δ : ℤ) ≤ ((p * ((p - 1) * δ) : ℕ) : ℤ) := by exact_mod_cast h_δ
      dsimp [q_s]
      push_cast at h_int
      exact h_int
    have hid :
        (p : ℤ) * ((((((p - 2) * m : ℕ) : ℤ) + q_s) + m_x1) + 0 + 0) - (p : ℤ) * (bE' : ℤ) =
          ((p : ℤ) * ((((p - 2) * m : ℕ) : ℤ)) - ((t₁ : ℤ) + 1)) +
            ((p : ℤ) * q_s - (δ : ℤ)) + ((p * m - t₁ : ℕ) : ℤ) - r_1 := by
      rw [hbE'_eq] at hdiv1_eq ⊢
      push_cast at hdiv1_eq ⊢
      rw [hp1_cast] at hdiv1_eq
      linear_combination hdiv1_eq
    by_contra hlt
    push_neg at hlt
    have hle1 : ((((((p - 2) * m : ℕ) : ℤ) + q_s) + m_x1) + 0) + 0 ≤ (bE' : ℤ) - 1 := by omega
    have hle2 :
        (p : ℤ) * ((((((p - 2) * m : ℕ) : ℤ) + q_s) + m_x1) + 0 + 0) ≤
          (p : ℤ) * ((bE' : ℤ) - 1) :=
      mul_le_mul_of_nonneg_left hle1 (by positivity)
    linarith only [hid, hp2m_ge_t₁, hδ_ge, hpm_t₁_ge1, hr1_lt, hle2]

  have hysT_norm_congr :
      normLM F hLE' y_sT - u ^ (p - 2) * H * D⁻¹ = 0 ∨
        (bE' : ℤ) ≤ valL F L (normLM F hLE' y_sT - u ^ (p - 2) * H * D⁻¹) := by
    rw [hnorm_diff_decomp]
    exact hvalL_sub (bE' : ℤ) _ _ hterm1_val hterm2_val

  exact ⟨hysT_c2, hysT_norm_congr⟩

theorem ld_ch12_wild_odd_tot_ram_add_char_cond_and_final_L_cancel (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bE' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (Δ : K₁ˣ)
    (e_Δ : ℕ → M₁') (s₀ : E')
    (α β γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hConv_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let c₂ := (bE' + p - 1) / p
      ∀ y : E', (y = 0 ∨ (c₂ : ℤ) ≤ valL F E' y) →
        (traceChar F hLE' ψ) (2 * IntermediateField.inclusion hLE' (α : L) * y) =
          ψ (- 2 * (α : L) * normLM F hLE' y))
    (hH_congr :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let ct := (t₁ + p - 1) / p
      normLM F hLM₁' (- e_Δ (p - 1)) - ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1) = 0 ∨
        ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤
          valL F L (normLM F hLM₁' (- e_Δ (p - 1)) -
            ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1)))
    (hψ_triv : ∀ x : L,
      (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hψE'_triv : ∀ x : E',
      (x = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' x) →
      (traceChar F hLE' ψ) x = 1)
    (h2_ne0 : (2 : E') ≠ 0)
    (hD_ne0 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let a := normLM F hE'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      1 + u ^ p * normLM F hLE' a ≠ 0)
    (hD_val0 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let a := normLM F hE'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      valL F L (1 + u ^ p * normLM F hLE' a) = 0)
    (hysT_c2 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let c₂ := (bE' + p - 1) / p
      let a := normLM F hE'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let y_sT := s₀ * ((w₂ : E') ^ (p - 2) * C)⁻¹
      y_sT = 0 ∨ (c₂ : ℤ) ≤ valL F E' y_sT)
    (hysT_norm_congr :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let a := normLM F hE'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let y_sT := s₀ * ((w₂ : E') ^ (p - 2) * C)⁻¹
      let D := 1 + u ^ p * normLM F hLE' a
      let H := normLM F hLM₁' (- e_Δ (p - 1))
      normLM F hLE' y_sT - u ^ (p - 2) * H * D⁻¹ = 0 ∨
        (bE' : ℤ) ≤ valL F L (normLM F hLE' y_sT - u ^ (p - 2) * H * D⁻¹)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let ψE' := traceChar F hLE' ψ
    let a := normLM F hE'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let v := (β : L) * ((α⁻¹ : Lˣ) : L)
    let C := 1 + IntermediateField.inclusion hLE' u * a
    let y_sT := s₀ * ((w₂ : E') ^ (p - 2) * C)⁻¹
    let D := 1 + u ^ p * normLM F hLE' a
    let H := normLM F hLM₁' (- e_Δ (p - 1))
    (∀ X Y : E', (X - Y = 0 ∨ (bE' : ℤ) ≤ valL F E' (X - Y)) →
      ψE' (2 * IntermediateField.inclusion hLE' (α : L) * X) =
        ψE' (2 * IntermediateField.inclusion hLE' (α : L) * Y)) ∧
    (ψE' (2 * IntermediateField.inclusion hLE' (α : L) * ((2 : E')⁻¹ * y_sT))) ^ 2 =
      ψ (2 * (α : L) * (- u ^ (p - 2) * H * D⁻¹)) ∧
    ψ (2 * (α : L) * (2 * W * u ^ (p - 1) * H * D⁻¹ -
      u ^ (p - 2) * H * D⁻¹ - W * (v * u) ^ (p - 1) * D⁻¹)) = 1 :=
by
  intro p ψE' a u W v C y_sT D H
  obtain ⟨_, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, _, _, _, hvalE'_mul, _, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  have hvalL_mono : ∀ (k₁ k₂ : ℤ) (x : L),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hvalL_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalL_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalE'_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : E'),
      (x = 0 ∨ k₁ ≤ valL F E' x) → (y = 0 ∨ k₂ ≤ valL F E' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F E' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalE'_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalL_pow_ge : ∀ (x : L) (n : ℕ) (q : ℤ),
      (x = 0 ∨ q ≤ valL F L x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F L (x ^ n)) := by
    intro x n q hx
    induction n with
    | zero =>
      right
      simp [hvalL_1]
    | succ n ih =>
      rw [pow_succ]
      have hmul := hvalL_mul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
      have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
      rwa [heq]
  have hvalL_inv_elt : ∀ (x : L) (hx : x ≠ 0), valL F L x⁻¹ = - valL F L x := by
    intro x hx
    exact hvalL_inv (Units.mk0 x hx)

  
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by dsimp [p]; omega
  have hp_ge3 : 3 ≤ p := by omega
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega

  
  have hval_α_E' :
      valL F E' (IntermediateField.inclusion hLE' (α : L)) =
        (p : ℤ) * (-(bE' : ℤ) - condExpChar F L ψ) := by
    rw [hval_LE' (α : L), hα_val]
  have hψE'_2α_triv : ∀ Z : E',
      (Z = 0 ∨ (bE' : ℤ) ≤ valL F E' Z) →
      ψE' (2 * IntermediateField.inclusion hLE' (α : L) * Z) = 1 := by
    intro Z hZ
    let Z₁ : E' := IntermediateField.inclusion hLE' (α : L) * Z
    have hZ₁_val :
        Z₁ = 0 ∨
          (p : ℤ) * (-(bE' : ℤ) - condExpChar F L ψ) + (bE' : ℤ) ≤ valL F E' Z₁ :=
      hvalE'_mul_ge ((p : ℤ) * (-(bE' : ℤ) - condExpChar F L ψ)) (bE' : ℤ)
        (IntermediateField.inclusion hLE' (α : L)) Z
        (Or.inr (le_of_eq hval_α_E'.symm)) hZ
    have hcond_eq :
        (p : ℤ) * (-(bE' : ℤ) - condExpChar F L ψ) + (bE' : ℤ) =
          -condExpChar F E' ψE' := by
      dsimp [ψE', p] at hnE'_eq ⊢
      rw [hnE'_eq, hp1_cast]
      ring
    have hZ₁_cond : Z₁ = 0 ∨ -condExpChar F E' ψE' ≤ valL F E' Z₁ := by
      rwa [hcond_eq] at hZ₁_val
    have htriv₁ : ψE' Z₁ = 1 := hψE'_triv Z₁ hZ₁_cond
    have h2Z₁ : 2 * IntermediateField.inclusion hLE' (α : L) * Z = Z₁ + Z₁ := by
      dsimp [Z₁]; ring
    rw [h2Z₁, AddChar.map_add_eq_mul, htriv₁, mul_one]
  have hConj1 : ∀ X Y : E', (X - Y = 0 ∨ (bE' : ℤ) ≤ valL F E' (X - Y)) →
      ψE' (2 * IntermediateField.inclusion hLE' (α : L) * X) =
        ψE' (2 * IntermediateField.inclusion hLE' (α : L) * Y) := by
    intro X Y hXY
    have hsplit :
        2 * IntermediateField.inclusion hLE' (α : L) * X =
          2 * IntermediateField.inclusion hLE' (α : L) * (X - Y) +
            2 * IntermediateField.inclusion hLE' (α : L) * Y := by ring
    rw [hsplit, AddChar.map_add_eq_mul, hψE'_2α_triv (X - Y) hXY, one_mul]
  have hψ_2α_triv : ∀ Z : L,
      (Z = 0 ∨ (bE' : ℤ) ≤ valL F L Z) →
      ψ (2 * (α : L) * Z) = 1 := by
    intro Z hZ
    let Z₁ : L := (α : L) * Z
    have hZ₁_val :
        Z₁ = 0 ∨ (-(bE' : ℤ) - condExpChar F L ψ) + (bE' : ℤ) ≤ valL F L Z₁ :=
      hvalL_mul_ge (-(bE' : ℤ) - condExpChar F L ψ) (bE' : ℤ) (α : L) Z
        (Or.inr (le_of_eq hα_val.symm)) hZ
    have hcond_eq : (-(bE' : ℤ) - condExpChar F L ψ) + (bE' : ℤ) = -condExpChar F L ψ := by ring
    have hZ₁_cond : Z₁ = 0 ∨ -condExpChar F L ψ ≤ valL F L Z₁ := by
      rwa [hcond_eq] at hZ₁_val
    have htriv₁ : ψ Z₁ = 1 := hψ_triv Z₁ hZ₁_cond
    have h2Z₁ : 2 * (α : L) * Z = Z₁ + Z₁ := by dsimp [Z₁]; ring
    rw [h2Z₁, AddChar.map_add_eq_mul, htriv₁, mul_one]
  have hψ_2α_congr : ∀ X Y : L, (X - Y = 0 ∨ (bE' : ℤ) ≤ valL F L (X - Y)) →
      ψ (2 * (α : L) * X) = ψ (2 * (α : L) * Y) := by
    intro X Y hXY
    have hsplit : 2 * (α : L) * X = 2 * (α : L) * (X - Y) + 2 * (α : L) * Y := by ring
    rw [hsplit, AddChar.map_add_eq_mul, hψ_2α_triv (X - Y) hXY, one_mul]

  
  have hConj2 :
      (ψE' (2 * IntermediateField.inclusion hLE' (α : L) * ((2 : E')⁻¹ * y_sT))) ^ 2 =
        ψ (2 * (α : L) * (- u ^ (p - 2) * H * D⁻¹)) := by
    let Z : E' := 2 * IntermediateField.inclusion hLE' (α : L) * ((2 : E')⁻¹ * y_sT)
    have hsq : (ψE' Z) ^ 2 = ψE' (Z + Z) := by
      rw [sq, ← AddChar.map_add_eq_mul]
    have h2_inv : (2 : E') * (2 : E')⁻¹ = 1 := mul_inv_cancel₀ h2_ne0
    have hZZ : Z + Z = 2 * IntermediateField.inclusion hLE' (α : L) * y_sT := by
      dsimp [Z]
      linear_combination (2 * IntermediateField.inclusion hLE' (α : L) * y_sT) * h2_inv
    have hconv :
        ψE' (2 * IntermediateField.inclusion hLE' (α : L) * y_sT) =
          ψ (2 * (α : L) * (- normLM F hLE' y_sT)) := by
      have h1 := hConv_E' y_sT hysT_c2
      have h2 : - 2 * (α : L) * normLM F hLE' y_sT = 2 * (α : L) * (- normLM F hLE' y_sT) := by ring
      dsimp [ψE']
      rw [h1, h2]
    have hneg_diff :
        (- normLM F hLE' y_sT) - (- u ^ (p - 2) * H * D⁻¹) =
          - (normLM F hLE' y_sT - u ^ (p - 2) * H * D⁻¹) := by ring
    have hneg_congr :
        (- normLM F hLE' y_sT) - (- u ^ (p - 2) * H * D⁻¹) = 0 ∨
          (bE' : ℤ) ≤ valL F L ((- normLM F hLE' y_sT) - (- u ^ (p - 2) * H * D⁻¹)) := by
      rw [hneg_diff]
      rcases hysT_norm_congr with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rwa [hvalL_neg]
    calc
      (ψE' Z) ^ 2 = ψE' (Z + Z) := hsq
      _ = ψE' (2 * IntermediateField.inclusion hLE' (α : L) * y_sT) := by rw [hZZ]
      _ = ψ (2 * (α : L) * (- normLM F hLE' y_sT)) := hconv
      _ = ψ (2 * (α : L) * (- u ^ (p - 2) * H * D⁻¹)) :=
        hψ_2α_congr (- normLM F hLE' y_sT) (- u ^ (p - 2) * H * D⁻¹) hneg_congr

  
  let R_L : L := u ^ (p - 2) * (H - v ^ (p - 1)) * D⁻¹
  have hWu : W * u = 1 := by
    have hα_inv : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    have hγ_inv : (γ : L) * ((γ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv γ
    dsimp [W, u]
    linear_combination ((γ : L) * ((γ⁻¹ : Lˣ) : L)) * hα_inv + hγ_inv
  have hp1_eq : p - 1 = (p - 2) + 1 := by omega
  have hup1 : u ^ (p - 1) = u ^ (p - 2) * u := by
    rw [hp1_eq, pow_succ]
  have hvup1 : (v * u) ^ (p - 1) = v ^ (p - 1) * (u ^ (p - 2) * u) := by
    rw [mul_pow, hup1]
  have hRL_eq :
      2 * W * u ^ (p - 1) * H * D⁻¹ - u ^ (p - 2) * H * D⁻¹ - W * (v * u) ^ (p - 1) * D⁻¹ = R_L := by
    dsimp [R_L]
    rw [hvup1, hup1]
    linear_combination (2 * u ^ (p - 2) * H * D⁻¹ - u ^ (p - 2) * v ^ (p - 1) * D⁻¹) * hWu
  let m : ℕ := a_lam - bE'
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero γ⁻¹),
      hvalL_inv γ, hα_val, hγ_val]
    omega
  have hu_p2_val :
      u ^ (p - 2) = 0 ∨ ((p - 2 : ℕ) : ℤ) * (m : ℤ) ≤ valL F L (u ^ (p - 2)) :=
    hvalL_pow_ge u (p - 2) (m : ℤ) (Or.inr (le_of_eq hu_val.symm))
  have hD_inv_val : D⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F L (D⁻¹) := by
    right
    rw [hvalL_inv_elt D hD_ne0, hD_val0, neg_zero]
  let t₁ : ℕ := bM₁' - 1
  let ct : ℕ := (t₁ + p - 1) / p
  let B_H : ℕ := t₁ + 1 - ct + (p - 1) * (bE' - bM₁')
  have hH_val : H - v ^ (p - 1) = 0 ∨ (B_H : ℤ) ≤ valL F L (H - v ^ (p - 1)) := hH_congr
  have hRL_val1 := hvalL_mul_ge (((p - 2 : ℕ) : ℤ) * (m : ℤ)) (B_H : ℤ)
    (u ^ (p - 2)) (H - v ^ (p - 1)) hu_p2_val hH_val
  have hRL_val2 := hvalL_mul_ge ((((p - 2 : ℕ) : ℤ) * (m : ℤ)) + (B_H : ℤ)) 0
    (u ^ (p - 2) * (H - v ^ (p - 1))) (D⁻¹) hRL_val1 hD_inv_val
  have hdiv_ct : p * ct + (t₁ + p - 1) % p = t₁ + p - 1 := Nat.div_add_mod (t₁ + p - 1) p
  have hmod_ct : (t₁ + p - 1) % p < p := Nat.mod_lt (t₁ + p - 1) hp_pos
  have hpm_gt : t₁ < p * m := hpm_gt_t₁
  have hct_le_m : ct ≤ m := by
    have hlt : p * ct < p * (m + 1) := by
      calc
        p * ct ≤ t₁ + p - 1 := by omega
        _ < p * m + p := by omega
        _ = p * (m + 1) := by ring
    have hlt2 : ct < m + 1 := Nat.lt_of_mul_lt_mul_left hlt
    omega
  have hct_le_t₁ : ct ≤ t₁ := by
    have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
    have hlt : p * ct < p * (t₁ + 1) := by
      calc
        p * ct ≤ t₁ + p - 1 := by omega
        _ < 3 * t₁ + p := by omega
        _ ≤ p * t₁ + p := by nlinarith
        _ = p * (t₁ + 1) := by ring
    have hlt2 : ct < t₁ + 1 := Nat.lt_of_mul_lt_mul_left hlt
    omega
  have hp2m_ge : m ≤ (p - 2) * m := by
    have h1 : 1 * m ≤ (p - 2) * m := Nat.mul_le_mul_right m (by omega)
    simpa using h1
  have hp1_diff_ge : bE' - bM₁' ≤ (p - 1) * (bE' - bM₁') := by
    have h1 : 1 * (bE' - bM₁') ≤ (p - 1) * (bE' - bM₁') :=
      Nat.mul_le_mul_right (bE' - bM₁') (by omega)
    simpa using h1
  have hRL_bound :
      (bE' : ℤ) ≤ (((p - 2 : ℕ) : ℤ) * (m : ℤ) + (B_H : ℤ)) + 0 := by
    have hnat : bE' ≤ (p - 2) * m + B_H := by
      dsimp [B_H, t₁]
      omega
    have hcast : ((bE' : ℕ) : ℤ) ≤ (((p - 2) * m + B_H : ℕ) : ℤ) := by exact_mod_cast hnat
    push_cast at hcast
    linarith
  have hRL_val : R_L = 0 ∨ (bE' : ℤ) ≤ valL F L R_L :=
    hvalL_mono (bE' : ℤ) ((((p - 2 : ℕ) : ℤ) * (m : ℤ) + (B_H : ℤ)) + 0) R_L hRL_bound hRL_val2
  have hConj3 :
      ψ (2 * (α : L) * (2 * W * u ^ (p - 1) * H * D⁻¹ -
        u ^ (p - 2) * H * D⁻¹ - W * (v * u) ^ (p - 1) * D⁻¹)) = 1 := by
    rw [hRL_eq]
    exact hψ_2α_triv R_L hRL_val
  exact ⟨hConj1, hConj2, hConj3⟩

theorem ld_ch12_wild_odd_tot_ram_rational_additive_and_final_phase_cancel (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bE' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (e_Δ : ℕ → M₁') (s₀ : E')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (hs₀_val : s₀ = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
        ((bE' - bM₁' : ℕ) : ℤ) ≤ valL F E' s₀)
    (hs₀_approx :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) - IntermediateField.inclusion hE'K₁ s₀ = 0 ∨
        ((p * (p - 1) * (bE' - bM₁') + (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) -
            IntermediateField.inclusion hE'K₁ s₀))
    (α β γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hβ_val : valL F L (β : L) = -(bM₁' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hw₂_norm : Units.map (normLM F hLE') w₂ = γ * α⁻¹)
    (hConv_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let c₂ := (bE' + p - 1) / p
      ∀ y : E', (y = 0 ∨ (c₂ : ℤ) ≤ valL F E' y) →
        (traceChar F hLE' ψ) (2 * IntermediateField.inclusion hLE' (α : L) * y) =
          ψ (- 2 * (α : L) * normLM F hLE' y))
    (hH_congr :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let ct := (t₁ + p - 1) / p
      normLM F hLM₁' (- e_Δ (p - 1)) - ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1) = 0 ∨
        ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤
          valL F L (normLM F hLM₁' (- e_Δ (p - 1)) -
            ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let ψE' := traceChar F hLE' ψ
    let a := normLM F hE'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let v := (β : L) * ((α⁻¹ : Lˣ) : L)
    let C := 1 + IntermediateField.inclusion hLE' u * a
    let P_star := normLM F hLE' C
    let q₀ := u ^ (p - 1)
    let F_star := P_star * (P_star - q₀)⁻¹
    let k_rat := IntermediateField.inclusion hLE' u * (w₂ : E') * C⁻¹
    let W_E' := IntermediateField.inclusion hLE' W
    let D₀_E' := W_E' ^ p - W_E' + a ^ p
    let F_fn : ℕ → E' := fun i =>
      W_E' * D₀_E'⁻¹ * ((W_E' + a) * (((w₂⁻¹ : E'ˣ) : E'))) ^ i
    let y_sT := s₀ * ((w₂ : E') ^ (p - 2) * C)⁻¹
    let D := 1 + u ^ p * normLM F hLE' a
    let H := normLM F hLM₁' (- e_Δ (p - 1))
    (∀ X Y : E', (X - Y = 0 ∨ (bE' : ℤ) ≤ valL F E' (X - Y)) →
      ψE' (2 * IntermediateField.inclusion hLE' (α : L) * X) =
        ψE' (2 * IntermediateField.inclusion hLE' (α : L) * Y)) ∧
    ψE' (2 * IntermediateField.inclusion hLE' (α : L) *
      (- W_E' * F_fn (p - 1) +
        W_E' * (∑ i ∈ Finset.Icc 1 (p - 2), ((i : ℕ) : E')⁻¹ * F_fn i) +
        W_E' * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) +
        IntermediateField.inclusion hLE' (W * F_star) *
          (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * k_rat ^ j) -
        (w₂ : E'))) = 1 ∧
    (ψE' (2 * IntermediateField.inclusion hLE' (α : L) * ((2 : E')⁻¹ * y_sT))) ^ 2 =
      ψ (2 * (α : L) * (- u ^ (p - 2) * H * D⁻¹)) ∧
    ψ (2 * (α : L) * (2 * W * u ^ (p - 1) * H * D⁻¹ -
      u ^ (p - 2) * H * D⁻¹ - W * (v * u) ^ (p - 1) * D⁻¹)) = 1 :=
by
  dsimp only
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalE' := ld_valL_and_unitGroup_props F E'
  have hvalM₁' := ld_valL_and_unitGroup_props F M₁'
  have hψ_triv := (ld_condExp_and_condExpChar_spec F L ψ hψ 1).1
  have hψE'_triv := (ld_condExp_and_condExpChar_spec F E' (traceChar F hLE' ψ) hψE' 1).1
  have hp_odd_LE' : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2 :=
    hWild.symm ▸ hp_odd
  have hPrime_LM₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) :=
    hdegM₁'.symm ▸ hPrime
  have hp_odd_LM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') ≠ 2 :=
    (hdegM₁'.trans hWild).symm ▸ hp_odd
  have hval_LM₁'_deg : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLM₁') : ℤ) * valL F L x := by
    intro x; rw [hdegM₁']; exact hval_LM₁' x
  have htr_LM₁'_deg : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLM₁') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLM₁') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)) := by
    intro m z hz; rw [hdegM₁'] at hz; exact htr_LM₁' m z hz
  obtain ⟨s_LE', _, _, hs_LE'_val, hs_LE'_norm_one_add, hs_LE'_cayley, _⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F L E' hLE' hGalLE'
      hPrime hp_odd_LE' hvalL hvalE' hval_LE' hval_norm_LE' bE' (by omega) htr_LE'
      (fun t htr G _ _ act hcard h1 hmul hring hincl hval htr_s hnorm_p =>
        ld_wild_odd_free_orbit_symm_functions F L E' hLE' hPrime hp_odd_LE' hvalE' t htr
          G act hcard h1 hmul hring hincl hval htr_s hnorm_p)
      (fun G _ _ act s hcard h1 hring hincl hnorm_p hs_poly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F L E' hLE' hPrime hp_odd_LE'
          hvalL hvalE' hval_LE' G act hcard h1 hring hincl hnorm_p s hs_poly)
  obtain ⟨s_LM₁', _, _, hs_LM₁'_val_deg, _, hs_LM₁'_cayley_deg, _⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F L M₁' hLM₁' hGalLM₁'
      hPrime_LM₁' hp_odd_LM₁' hvalL hvalM₁' hval_LM₁'_deg hval_norm_LM₁' bM₁' (by omega)
      htr_LM₁'_deg
      (fun t htr G _ _ act hcard h1 hmul hring hincl hval htr_s hnorm_p =>
        ld_wild_odd_free_orbit_symm_functions F L M₁' hLM₁' hPrime_LM₁' hp_odd_LM₁' hvalM₁' t htr
          G act hcard h1 hmul hring hincl hval htr_s hnorm_p)
      (fun G _ _ act s hcard h1 hring hincl hnorm_p hs_poly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F L M₁' hLM₁' hPrime_LM₁' hp_odd_LM₁'
          hvalL hvalM₁' hval_LM₁'_deg G act hcard h1 hring hincl hnorm_p s hs_poly)
  have hs_LM₁'_val : ∀ (w : M₁') (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F M₁' w) →
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤
            (r : ℤ) * q →
