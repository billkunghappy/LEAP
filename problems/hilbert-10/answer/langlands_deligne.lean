  let cM₁' : M₁'ˣ :=
    Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
      (Units.map (normLM F hM₁'K₁) C)⁻¹
  have hcE'_val : valL F E' (cE' : E') = (m₂ : ℤ) + condExpChar F E' ψE' := by
    have hmul := hvalE'_props.2.2.2.2.1
      ((Units.map (IntermediateField.inclusion hLE').toMonoidHom α : E'ˣ) : E')
