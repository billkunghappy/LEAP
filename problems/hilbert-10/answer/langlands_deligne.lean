  have hθ_v1_eq_ψ :
      (θM₁' v₁ : Ω F) = ψ (((α⁻¹ : Lˣ) : L) * (-β₂ * (Q - V) * Q⁻¹)) := by
    rw [hθ_v1_eq_νV, hV_unit_eq, map_mul, hν_Q, mul_one, hc_ν₂_stat' u_Q hPu_Q hu_Q]
    congr 1
    dsimp [u_Q]
    ring
  have hV_inv : V * V⁻¹ = 1 := mul_inv_cancel₀ hV_ne
  have hV_inv_M1 : u₁_val * (u₁_conj * ιM₁' V⁻¹) = 1 := by
    rw [← mul_assoc, hu1_prod, ← map_mul, hV_inv, map_one]
  have hinv_u1 : ((u₁⁻¹ : M₁'ˣ) : M₁') * u₁_val = 1 := Units.inv_mul u₁
  have hu1_inv_eq : ((u₁⁻¹ : M₁'ˣ) : M₁') = u₁_conj * ιM₁' V⁻¹ := by
    linear_combination (u₁_conj * ιM₁' V⁻¹) * hinv_u1 - ((u₁⁻¹ : M₁'ˣ) : M₁') * hV_inv_M1
  have hv1_sub_1 : (v₁ : M₁') - 1 = (u₁_conj - u₁_val) * u₁_conj * ιM₁' V⁻¹ := by
    change τ₁ u₁_val * ((u₁⁻¹ : M₁'ˣ) : M₁') - 1 = (u₁_conj - u₁_val) * u₁_conj * ιM₁' V⁻¹
    rw [hτ₁_u1, hu1_inv_eq]
