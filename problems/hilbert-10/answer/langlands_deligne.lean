        rw [hθ_wx, hθ_w, sq, ← ψ_M.map_add_eq_mul, ← h2x_eq]
        congr 1
        ring
      have hθ_wx_quad : (θ w_x : Ω F) ^ 2 = ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2)) :=
        hc_θ_quad x hx_d hx_ne
      have hx2_m : x ^ 2 = 0 ∨ (m : ℤ) ≤ valL F M (x ^ 2) := by
        rw [sq]
        rcases hval_mul_bound ((m - d : ℕ) : ℤ) ((m - d : ℕ) : ℤ) x x hx_md hx_md with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hψ_x2 : ψ_M (((c_θ⁻¹ : Mˣ) : M) * (x ^ 2)) = 1 :=
        hψ_c_triv c_θ hc_θ_val (x ^ 2) hx2_m
      have hsplit_z : ((c_θ⁻¹ : Mˣ) : M) * z =
          ((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2) + ((c_θ⁻¹ : Mˣ) : M) * (x ^ 2) := by
        rw [← h2x_eq]
        ring
      change (θ w : Ω F) = ψ_M (((c_θ⁻¹ : Mˣ) : M) * z)
      rw [hsplit_z, ψ_M.map_add_eq_mul, hψ_x2, mul_one, ← hθ_wx_quad, hθ_wx_sq_eq_w]
    · intro Q'_M ψ'_0M hQ'_int hψ'_int a
      obtain ⟨y, hy_int, hy_res⟩ := hresM_surj a
      let x : M := ((ϖ_M ^ d : Mˣ) : M) * y
      have hx_d : x = 0 ∨ (d : ℤ) ≤ valL F M x := by
        change ((ϖ_M ^ d : Mˣ) : M) * y = 0 ∨ (d : ℤ) ≤ valL F M (((ϖ_M ^ d : Mˣ) : M) * y)
        rcases hval_ϖm_mul d 0 y hy_int with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hx_ne : 1 + x ≠ 0 := hone_add_ne d hd_ge1 x hx_d
      let u_x : Mˣ := Units.mk0 (1 + x) hx_ne
      have hQ'_a : Q'_M a = (θ u_x : Ω F)⁻¹ * ψ_M (((c_θ⁻¹ : Mˣ) : M) * x) := by
        have h := hQ'_int y hy_int hx_ne
        rwa [hy_res, mul_assoc (((c_θ⁻¹ : Mˣ) : M)) (((ϖ_M ^ d : Mˣ) : M)) y] at h
      have hQ'_mul_θ : Q'_M a * (θ u_x : Ω F) = ψ_M (((c_θ⁻¹ : Mˣ) : M) * x) := by
        rw [hQ'_a, mul_right_comm, inv_mul_cancel₀ (Units.ne_zero (θ u_x)), one_mul]
      have hQ'_sq_θ : (Q'_M a) ^ 2 * (θ u_x : Ω F) ^ 2 = ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x)) := by
        rw [← mul_pow, hQ'_mul_θ, sq, ← ψ_M.map_add_eq_mul]
        congr 1
        ring
      have hθ_ux_quad : (θ u_x : Ω F) ^ 2 = ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2)) :=
        hc_θ_quad x hx_d hx_ne
      have hy2_int : y ^ 2 = 0 ∨ 0 ≤ valL F M (y ^ 2) := by
        rw [sq]
        rcases hval_mul_bound 0 0 y y hy_int hy_int with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hres_y2 : resM (y ^ 2) = a ^ 2 := by
        rw [sq, sq, (hresM_ring y y hy_int hy_int).2.1, hy_res]
      have hπ2d_y2 : ((ϖ_M ^ (2 * d) : Mˣ) : M) * (y ^ 2) = x ^ 2 := by
        change ((ϖ_M ^ (2 * d) : Mˣ) : M) * (y ^ 2) = (((ϖ_M ^ d : Mˣ) : M) * y) ^ 2
        rw [hπ2d_eq]
        ring
      have hψ'_a2 : ψ'_0M (a ^ 2) = ψ_M (((c_θ⁻¹ : Mˣ) : M) * (x ^ 2)) := by
        have h := hψ'_int (y ^ 2) hy2_int
        rwa [hres_y2, hπ2d_y2] at h
      have hsplit_2x : ((c_θ⁻¹ : Mˣ) : M) * (2 * x) =
          ((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2) + ((c_θ⁻¹ : Mˣ) : M) * (x ^ 2) := by ring
      have hprod : (Q'_M a) ^ 2 * (θ u_x : Ω F) ^ 2 = ψ'_0M (a ^ 2) * (θ u_x : Ω F) ^ 2 := by
        rw [hQ'_sq_θ, hsplit_2x, ψ_M.map_add_eq_mul, ← hθ_ux_quad, ← hψ'_a2, mul_comm]
      have hθ_sq_ne0 : (θ u_x : Ω F) ^ 2 ≠ 0 := pow_ne_zero 2 (Units.ne_zero (θ u_x))
      exact mul_right_cancel₀ hθ_sq_ne0 hprod

theorem ld_ch12_wild_odd_perturbed_quad_stat_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ψ_M : AddChar M (Ω F)) (θ : Mˣ →* (Ω F)ˣ)
    (hm : 2 ≤ condExp F M θ)
    (hSpecM_triv : ∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1)
    (hvalM_props : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (c : Mˣ) (η : M)
    (hc_val : valL F M (c : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hη_val : η = 0 ∨ ((condExp F M θ / 2 : ℕ) : ℤ) ≤ valL F M η)
    (hc_quad : ∀ x : M, (x = 0 ∨ ((condExp F M θ / 2 : ℕ) : ℤ) ≤ valL F M x) →
      ∀ hx : 1 + x ≠ 0,
        (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * x - x ^ 2))) :
    let m := condExp F M θ
    let d := m / 2
    ∃ c_θ : Mˣ,
      valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
      (∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) ∧
      (θ c_θ : Ω F) ^ 4 * (ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 4 =
        (θ c : Ω F) ^ 4 * (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2 :=
by
  intro m d
  have hm_def : m = condExp F M θ := rfl
  have hd_def : d = m / 2 := rfl
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalM_props
  have hd_ge1 : 1 ≤ d := by omega
  have h3d_ge_m : (m : ℤ) ≤ (d : ℤ) + (d : ℤ) + (d : ℤ) := by omega
  have hval_mul_bound : ∀ (k₁ k₂ : ℤ) (x y : M),
      (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' : k₁ ≤ valL F M x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F M y := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hη_ne : 1 + η ≠ 0 := by
    intro h0
    have hη_neg1 : η = -1 := eq_neg_of_add_eq_zero_right h0
    rcases hη_val with rfl | hge
    · rw [add_zero] at h0
      exact one_ne_zero h0
    · rw [hη_neg1, hval_neg1] at hge
      omega
  let u_η : Mˣ := Units.mk0 (1 + η) hη_ne
  have hu_η_mem : u_η ∈ unitGroup F M d := by
    rw [hunit_ge1 d hd_ge1]
    rcases hη_val with rfl | hge
    · left
      change (1 : M) + 0 = 1
      exact add_zero 1
    · right
      change (d : ℤ) ≤ valL F M ((1 + η) - 1)
      rw [add_sub_cancel_left]
      exact hge
  have hu_η_val : valL F M (u_η : M) = 0 := hunit_val0 d u_η hu_η_mem
  have hu_η_inv_val : valL F M ((u_η⁻¹ : Mˣ) : M) = 0 := by
    rw [hval_inv u_η, hu_η_val, neg_zero]
  let c_θ : Mˣ := c * u_η⁻¹
  have hc_θ_val : valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M := by
    change valL F M (((c * u_η⁻¹ : Mˣ) : M)) = (m : ℤ) + condExpChar F M ψ_M
    rw [Units.val_mul,
      hval_mul (c : M) ((u_η⁻¹ : Mˣ) : M) (Units.ne_zero c) (Units.ne_zero u_η⁻¹),
      hc_val, hu_η_inv_val, add_zero]
  have hc_θ_inv_unit : c_θ⁻¹ = c⁻¹ * u_η := by
    dsimp [c_θ]
    rw [mul_inv_rev, inv_inv, mul_comm]
  have hc_θ_inv : ((c_θ⁻¹ : Mˣ) : M) = ((c⁻¹ : Mˣ) : M) * (1 + η) := by
    rw [hc_θ_inv_unit, Units.val_mul]
    rfl
  have hc_θ_quad : ∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
      ∀ hx : 1 + x ≠ 0,
        (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2)) := by
    intro x hx_val hx
    rw [hc_θ_inv]
    exact hc_quad x hx_val hx
  have hη2_val : η ^ 2 = 0 ∨ (d : ℤ) + (d : ℤ) ≤ valL F M (η ^ 2) := by
    rw [sq]
    exact hval_mul_bound (d : ℤ) (d : ℤ) η η hη_val hη_val
  have hη3_val : η ^ 3 = 0 ∨ (d : ℤ) + (d : ℤ) + (d : ℤ) ≤ valL F M (η ^ 3) := by
    have hpow3 : η ^ 3 = η ^ 2 * η := by ring
    rw [hpow3]
    exact hval_mul_bound ((d : ℤ) + (d : ℤ)) (d : ℤ) (η ^ 2) η hη2_val hη_val
  have hψ_η3 : ψ_M (((c⁻¹ : Mˣ) : M) * (η ^ 3)) = 1 := by
    apply hSpecM_triv
    by_cases h0 : η ^ 3 = 0
    · left; rw [h0, mul_zero]
    · right
      have hge : (d : ℤ) + (d : ℤ) + (d : ℤ) ≤ valL F M (η ^ 3) := hη3_val.resolve_left h0
      rw [hval_mul ((c⁻¹ : Mˣ) : M) (η ^ 3) (Units.ne_zero c⁻¹) h0, hval_inv c, hc_val]
      omega
  have hθ_uη_sq : (θ u_η : Ω F) ^ 2 =
      ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * η - η ^ 2)) :=
    hc_quad η hη_val hη_ne
  have hring_id : ((c_θ⁻¹ : Mˣ) : M) + ((c_θ⁻¹ : Mˣ) : M) =
      ((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * η - η ^ 2) +
        ((c⁻¹ : Mˣ) : M) * (2 - η ^ 2) +
        ((c⁻¹ : Mˣ) : M) * (η ^ 3) := by
    rw [hc_θ_inv]
    ring
  have hψ_cθ_sq : (ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 2 =
      (θ u_η : Ω F) ^ 2 * ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2)) := by
    calc (ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 2
        = ψ_M (((c_θ⁻¹ : Mˣ) : M)) * ψ_M (((c_θ⁻¹ : Mˣ) : M)) := sq _
      _ = ψ_M (((c_θ⁻¹ : Mˣ) : M) + ((c_θ⁻¹ : Mˣ) : M)) :=
          (AddChar.map_add_eq_mul ψ_M _ _).symm
      _ = ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * η - η ^ 2) +
            ((c⁻¹ : Mˣ) : M) * (2 - η ^ 2) +
            ((c⁻¹ : Mˣ) : M) * (η ^ 3)) := by rw [hring_id]
      _ = ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * η - η ^ 2)) *
            ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2)) *
            ψ_M (((c⁻¹ : Mˣ) : M) * (η ^ 3)) := by
          rw [AddChar.map_add_eq_mul, AddChar.map_add_eq_mul]
      _ = (θ u_η : Ω F) ^ 2 * ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2)) := by
          rw [← hθ_uη_sq, hψ_η3, mul_one]
  have hθ_mul : (θ c_θ : Ω F) * (θ u_η : Ω F) = (θ c : Ω F) := by
    have hunit_mul : c_θ * u_η = c := inv_mul_cancel_right c u_η
    calc (θ c_θ : Ω F) * (θ u_η : Ω F)
        = ((θ c_θ * θ u_η : (Ω F)ˣ) : Ω F) := (Units.val_mul _ _).symm
      _ = (θ (c_θ * u_η) : Ω F) := by rw [← map_mul]
      _ = (θ c : Ω F) := by rw [hunit_mul]
  have hPhaseEq : (θ c_θ : Ω F) ^ 4 * (ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 4 =
      (θ c : Ω F) ^ 4 * (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2 := by
    calc (θ c_θ : Ω F) ^ 4 * (ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 4
        = ((θ c_θ : Ω F) ^ 2 * ((ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 2)) ^ 2 := by ring
      _ = ((θ c_θ : Ω F) ^ 2 * ((θ u_η : Ω F) ^ 2 * ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2)))) ^ 2 := by
          rw [hψ_cθ_sq]
      _ = (((θ c_θ : Ω F) * (θ u_η : Ω F)) ^ 2 * ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2 := by
          ring
      _ = ((θ c : Ω F) ^ 2 * ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2 := by
          rw [hθ_mul]
      _ = (θ c : Ω F) ^ 4 * (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2 := by ring
  exact ⟨c_θ, hc_θ_val, hc_θ_quad, hPhaseEq⟩

theorem ld_ch12_wild_odd_single_field_fourth_pow_lamprecht (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hp_odd : p F ≠ 2)
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ψ_M : AddChar M (Ω F)) (hψM : IsAdmissibleChar F M ψ_M)
    (θ : Mˣ →* (Ω F)ˣ) (hm : 2 ≤ condExp F M θ)
    (hθ_cond : ∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) :
    let m := condExp F M θ
    let d := m / 2
    (∃ c_θ : Mˣ,
      valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
      ∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) ∧
    (∀ (c : Mˣ) (η : M),
      valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
      (η = 0 ∨ (d : ℤ) ≤ valL F M η) →
      (∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * x - x ^ 2))) →
      (tateEps F M θ ψ_M) ^ 4 =
        ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (m : ℤ))) *
          (θ c : Ω F) ^ 4 *
          (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2) :=
by
  have hp : Nat.Prime (p F) := (ld_frob_pow_on_primeToP_roots F).1
  have hvalM := ld_valL_and_unitGroup_props F M
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := ld_valL_and_unitGroup_props F M
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F M
  obtain ⟨S₁, hS₁⟩ :=
    ld_valL_mod_one_finset F M hval0 hval_neg hval_mul hval_add
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_M, hField_kM, hFintype_kM, resM, hres_0, hres_1, hres_ring, hres_ker, hres_surj⟩ :=
    ld_valL_residue_field_exists F M hval0 hval1 hval_neg1 hval_neg hval_mul hval_inv hval_add S₁ hS₁
  letI : Field k_M := hField_kM
  letI : Fintype k_M := hFintype_kM
  obtain ⟨hcard, hp_char, hp_valM⟩ :=
    ld_valL_residue_field_card_eq_qL F M
      ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩
      ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩
      k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj
  have hSpecM := ld_condExp_and_condExpChar_spec F M ψ_M hψM θ
  have hFinM := ld_unitCoset_finite F M (condExp F M θ) (by omega)
  have hne_θ := ld_tateEps_ne_zero F M ψ_M hψM θ
  have hstat := ld_cond_ge_two_stationary_phase_sum_reduction F M ψ_M θ hm hSpecM hFinM hvalM
  obtain ⟨c₀, hc₀_val, hc₀_stat⟩ := hstat.1 hne_θ
  obtain ⟨ϖ_M, hϖ_M⟩ := hval_surj 1
  have hstat_to_top : ∀ c_M : Mˣ,
      (∀ w ∈ unitGroup F M (condExp F M θ - condExp F M θ / 2),
        (θ w : Ω F) = ψ_M (((c_M⁻¹ : Mˣ) : M) * ((w : M) - 1))) →
      ∀ x : M, (x = 0 ∨ ((condExp F M θ - 1 : ℕ) : ℤ) ≤ valL F M x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c_M⁻¹ : Mˣ) : M) * x) := by
    intro c_M hc_M_stat x hx_val hx
    let w : Mˣ := Units.mk0 (1 + x) hx
    have hw_sub : (w : M) - 1 = x := add_sub_cancel_left 1 x
    have hw_mem : w ∈ unitGroup F M (condExp F M θ - condExp F M θ / 2) := by
      rw [hunit_ge1 (condExp F M θ - condExp F M θ / 2) (by omega), hw_sub]
      rcases hx_val with rfl | hx_ge
      · exact Or.inl (add_zero 1)
      · exact Or.inr (le_trans (by omega) hx_ge)
    have h1 := hc_M_stat w hw_mem
    rw [hw_sub] at h1
    exact h1
  have hOddExist : condExp F M θ = 2 * (condExp F M θ / 2) + 1 →
      ∃ (Q_M : k_M → Ω F) (ψ_0M : AddChar k_M (Ω F)) (b₀ : k_M),
        (∀ (y : M) (hy_int : y = 0 ∨ 0 ≤ valL F M y)
          (hy_ne : 1 + ((ϖ_M ^ (condExp F M θ / 2) : Mˣ) : M) * y ≠ 0),
          Q_M (resM y) =
            (θ (Units.mk0 (1 + ((ϖ_M ^ (condExp F M θ / 2) : Mˣ) : M) * y) hy_ne) : Ω F)⁻¹ *
              ψ_M (((c₀⁻¹ : Mˣ) : M) * ((ϖ_M ^ (condExp F M θ / 2) : Mˣ) : M) * y)) ∧
        (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
          ψ_0M (resM x) =
            ψ_M (((c₀⁻¹ : Mˣ) : M) *
              (((ϖ_M ^ (2 * (condExp F M θ / 2)) : Mˣ) : M) * x))) ∧
        (∀ a : k_M, (Q_M a) ^ 2 * ψ_0M (2 * b₀ * a) = ψ_0M (a ^ 2)) := by
    intro hodd
    obtain ⟨Q_M, ψ_0M, hQ_M_int, hψ_0M_int, hψ_0M_ne, hQ0, hQbichar⟩ :=
      (ld_ch14_top_stat_congruence_and_odd_quadratic_phase F M ψ_M θ hm hp hp_valM
        hSpecM hvalM c₀ c₀ hc₀_val hc₀_stat hc₀_val (hstat_to_top c₀ hc₀_stat)).2
        hodd k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj ϖ_M hϖ_M
    have hQG := ld_ch14_odd_p_finite_field_hasse_davenport_quad_gauss F hp hp_odd k_M hp_char ψ_0M hψ_0M_ne
    obtain ⟨b₀, hb₀⟩ :=
      (ld_ch12_odd_p_finite_field_quad_bichar_param_and_fourth_pow F hp hp_odd k_M hp_char
        ψ_0M hψ_0M_ne Q_M hQ0 hQbichar ⟨hQG.1, hQG.2.1⟩).1
    exact ⟨Q_M, ψ_0M, b₀, hQ_M_int, hψ_0M_int, hb₀⟩
  obtain ⟨hConj1, hBridge⟩ :=
    ld_ch12_wild_odd_quad_stat_exists_and_linear_bridge F hp hp_odd M ψ_M θ hm hSpecM.1 hvalM
      k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj hp_char
      ϖ_M c₀ hϖ_M hc₀_val hc₀_stat hOddExist
  refine ⟨hConj1, ?_⟩
  intro c η hc_val hη_val hc_quad
  obtain ⟨c_θ, hc_θ_val, hc_θ_quad, hPhaseEq⟩ :=
    ld_ch12_wild_odd_perturbed_quad_stat_reduction F M ψ_M θ hm hSpecM.1 hvalM
      c η hc_val hη_val hc_quad
  obtain ⟨hc_θ_stat, hQ_sq⟩ := hBridge c_θ hc_θ_val hc_θ_quad
  have heps_θ := hstat.2 c_θ hc_θ_val hc_θ_stat
  have hq_pos : 0 < qL F M := pow_pos (q_pos F) (resDeg F M)
  have hq_ne : (qL F M : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hq_pos.ne'
  rcases Nat.mod_two_eq_zero_or_one (condExp F M θ) with heven | hodd
  · have hfilt :=
      (ld_cond_ge_two_filtration_card_and_eval F M ψ_M θ hm hSpecM.1 hθ_cond hFinM hvalM
        k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj ϖ_M c_θ hϖ_M hc_θ_val hc_θ_stat).1
        (by omega)
    rw [hcard] at hfilt
    have heps_even :
        tateEps F M θ ψ_M =
          (qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) *
            (θ c_θ : Ω F) * ψ_M (((c_θ⁻¹ : Mˣ) : M)) := by
      rw [heps_θ, hfilt, zpow_add₀ hq_ne, zpow_natCast]
      ring
    have hq_exp :
        ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^ 4 =
          (qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (condExp F M θ : ℤ)) := by
      rw [← zpow_natCast, ← zpow_mul]
      congr 1
      have hm_even :
          (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) * ((4 : ℕ) : ℤ) =
            4 * condExpChar F M ψ_M + 2 * (condExp F M θ : ℤ) := by omega
      exact hm_even
    calc (tateEps F M θ ψ_M) ^ 4
        = ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^ 4 *
            ((θ c_θ : Ω F) ^ 4 * (ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 4) := by
          rw [heps_even]
          ring
      _ = ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (condExp F M θ : ℤ))) *
            (θ c : Ω F) ^ 4 *
            (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2 := by
          rw [hq_exp, hPhaseEq, mul_assoc]
  · obtain ⟨Q'_M, ψ'_0M, hQ'_int, hψ'_int, hψ'_ne, hQ'0, hQ'bichar⟩ :=
      (ld_ch14_top_stat_congruence_and_odd_quadratic_phase F M ψ_M θ hm hp hp_valM
        hSpecM hvalM c_θ c_θ hc_θ_val hc_θ_stat hc_θ_val (hstat_to_top c_θ hc_θ_stat)).2
        (by omega) k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj ϖ_M hϖ_M
    have hfilt :=
      (ld_cond_ge_two_filtration_card_and_eval F M ψ_M θ hm hSpecM.1 hθ_cond hFinM hvalM
        k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj ϖ_M c_θ hϖ_M hc_θ_val hc_θ_stat).2
        (by omega) Q'_M hQ'_int
    rw [hcard] at hfilt
    have heps_odd :
        tateEps F M θ ψ_M =
          (qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) *
            (θ c_θ : Ω F) * ψ_M (((c_θ⁻¹ : Mˣ) : M)) * (∑ b : k_M, Q'_M b) := by
      rw [heps_θ, hfilt, zpow_add₀ hq_ne, zpow_natCast]
      ring
    have hQG' := ld_ch14_odd_p_finite_field_hasse_davenport_quad_gauss F hp hp_odd k_M hp_char ψ'_0M hψ'_ne
    have hQ'_pow4 :=
      ((ld_ch12_odd_p_finite_field_quad_bichar_param_and_fourth_pow F hp hp_odd k_M hp_char
        ψ'_0M hψ'_ne Q'_M hQ'0 hQ'bichar ⟨hQG'.1, hQG'.2.1⟩).2
        (hQ_sq Q'_M ψ'_0M hQ'_int hψ'_int)).2
    rw [hcard] at hQ'_pow4
    have hq_exp_odd :
        ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^ 4 *
          (qL F M : Ω F) ^ 2 =
          (qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (condExp F M θ : ℤ)) := by
      rw [← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_add₀ hq_ne]
      congr 1
      have hm_odd :
          (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) * ((4 : ℕ) : ℤ) + ((2 : ℕ) : ℤ) =
            4 * condExpChar F M ψ_M + 2 * (condExp F M θ : ℤ) := by omega
      exact hm_odd
    calc (tateEps F M θ ψ_M) ^ 4
        = (((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^ 4 *
            (∑ b : k_M, Q'_M b) ^ 4) *
            ((θ c_θ : Ω F) ^ 4 * (ψ_M (((c_θ⁻¹ : Mˣ) : M))) ^ 4) := by
          rw [heps_odd]
          ring
      _ = ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (condExp F M θ : ℤ))) *
            (θ c : Ω F) ^ 4 *
            (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2 := by
          rw [hQ'_pow4, hq_exp_odd, hPhaseEq, mul_assoc]

theorem ld_ch12_wild_odd_unramified_four_edge_cond_and_val_package (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (htraceChar_E'K₁ : traceChar F (hLE'.trans hE'K₁) ψ =
      traceChar F hE'K₁ (traceChar F hLE' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hνE'M₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hUnramM₁' : condExp F L νM₁' = 0)
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ θK₁), θK₁ u = 1)
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * θE')),
        (ξE' ^ j * θE') u = 1) ∧
      condExp F E' (ξE' ^ j * θE') = condExp F E' θE')
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * θM₁')),
        (ξM₁' ^ j * θM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * θM₁') = condExp F M₁' θM₁') :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let T := condExp F L νE'
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let ψK₁ := traceChar F (hLE'.trans hE'K₁) ψ
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    let mE' := condExp F E' θE'
    let mM₁' := condExp F M₁' θM₁'
    T ≤ mM₁' ∧
    mE' = T + p * (mM₁' - T) ∧
    condExpChar F M₁' ψM₁' = condExpChar F L ψ ∧
    condExpChar F E' ψE' = (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (T : ℤ) ∧
    condExpChar F K₁ ψK₁ = condExpChar F E' ψE' ∧
    ξM₁' ^ p = 1 ∧
    ξM₁' ≠ 1 ∧
    condExp F M₁' ξM₁' = T ∧
    ((qL F E' : Ω F) ^ (4 * condExpChar F E' ψE' + 2 * (mE' : ℤ))) *
        ((qL F L : Ω F) ^ (2 * (((p - 1 : ℕ) : ℤ) * (condExp F L νM₁' : ℤ)))) =
      ((qL F M₁' : Ω F) ^ (4 * condExpChar F M₁' ψM₁' + 2 * (mM₁' : ℤ))) *
        ((qL F L : Ω F) ^ (2 * (((p - 1 : ℕ) : ℤ) * (T : ℤ)))) ∧
    (∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x) ∧
    (∀ z : M₁', valL F L (normLM F hLM₁' z) = (p : ℤ) * valL F M₁' z) ∧
    (∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = (p : ℤ) * valL F L x) ∧
    (∀ y : E', valL F L (normLM F hLE' y) = valL F E' y) ∧
    (∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y) ∧
    (∀ w : K₁, valL F E' (normLM F hE'K₁ w) = (p : ℤ) * valL F K₁ w) ∧
    (∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z) ∧
    (∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w) ∧
    (∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z))) ∧
    (∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w))) ∧
    (∀ (d : ℕ), 1 ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w)))) ∧
    ∃ (y₁ : M₁') (w₁ : K₁),
      (y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) ∧
      traceLM F hLM₁' y₁ = 1 ∧
      (w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) ∧
      traceLM F hE'K₁ w₁ = 1 :=
by
  intro p T ψE' ψM₁' ψK₁ ξM₁' mE' mM₁'
  have hvalL := ld_valL_and_unitGroup_props F L
  have hval_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (x : M) (n : ℕ), x ≠ 0 → valL F M (x ^ n) = (n : ℤ) * valL F M x := by
    intro M _ x n hx
    have hvalM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero =>
      rw [pow_zero, hvalM.2.1, Nat.cast_zero, zero_mul]
    | succ k ih =>
      rw [pow_succ', hvalM.2.2.2.2.1 x (x ^ k) hx (pow_ne_zero k hx), ih]
      push_cast
      ring
  have hval_zpow : ∀ (u : Lˣ) (m : ℤ),
      valL F L ((u ^ m : Lˣ) : L) = m * valL F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F L ((u ^ (n : ℤ) : Lˣ) : L) = (n : ℤ) * valL F L (u : L)
      rw [zpow_natCast, Units.val_pow_eq_pow_val]
      exact hval_pow L (u : L) n (Units.ne_zero u)
    | negSucc n =>
      rw [zpow_negSucc, hvalL.2.2.2.2.2.1 (u ^ (n + 1)), Units.val_pow_eq_pow_val,
        hval_pow L (u : L) (n + 1) (Units.ne_zero u), Int.negSucc_eq]
      push_cast
      ring
  have hval_incl_of_norm : ∀ (L₀ K₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F L₀] [FiniteDimensional F K₀] (hL₀K₀ : L₀ ≤ K₀),
      (∀ y : K₀, valL F L₀ (normLM F hL₀K₀ y) = valL F K₀ y) →
      ∀ x : L₀, valL F K₀ (IntermediateField.inclusion hL₀K₀ x) =
        (Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀) : ℤ) * valL F L₀ x := by
    intro L₀ K₀ _ _ hL₀K₀ hval_norm x
    have hvalL₀ := ld_valL_and_unitGroup_props F L₀
    have hvalK₀ := ld_valL_and_unitGroup_props F K₀
    by_cases hx : x = 0
    · subst hx
      rw [map_zero, hvalK₀.1, hvalL₀.1, mul_zero]
    · rw [← hval_norm (IntermediateField.inclusion hL₀K₀ x)]
      have hnorm_eq : normLM F hL₀K₀ (IntermediateField.inclusion hL₀K₀ x) =
          x ^ (Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀)) := by
        change Algebra.norm L₀ (algebraMap L₀ (IntermediateField.extendScalars hL₀K₀) x) = _
        exact Algebra.norm_algebraMap x
      rw [hnorm_eq]
      exact hval_pow L₀ x _ hx
  
  have hPrime_LM₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) :=
    hdegM₁'.symm ▸ hPrime
  have hξM₁'_triv1 : ∀ u ∈ unitGroup F M₁' (condExp F M₁' ξM₁'), ξM₁' u = 1 := by
    simpa [pow_one] using (hξM₁'_props 1 hPrime.one_lt).2.1
  obtain ⟨_, hval_norm_LM₁'_raw, hval_LM₁', _, hq_M₁'_raw, _, hUnramImp_LM₁'⟩ :=
    ld_ch10_unramified_arith_and_twist_reduction F L M₁' hLM₁' hGalLM₁' hAbLM₁' hPrime_LM₁'
      ψ hψ νM₁' νE' (hdegM₁'.symm ▸ hνM₁'_pow) hνM₁'_ne hνM₁'_ker
      (fun j hj => hνM₁'_cond j (hdegM₁' ▸ hj))
      (fun j hj => hνM₁'E'_cond j (hdegM₁' ▸ hj))
      hξM₁'_triv1
      (fun j hj => le_of_eq ((hMinM₁' j (hdegM₁' ▸ hj)).2).symm)
      hUnramM₁'
      (fun ψ' hψ' θ => ld_condExp_and_condExpChar_spec F L ψ' hψ' θ)
      (fun ψK hψK θK => ld_condExp_and_condExpChar_spec F M₁' ψK hψK θK)
      (fun a ha => ld_unitCoset_finite F L a ha)
  have hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = (p : ℤ) * valL F M₁' z := by
    intro z
    simpa [hdegM₁'] using hval_norm_LM₁'_raw z
  have hq_M₁' : qL F M₁' = (qL F L) ^ p := by
    simpa [hdegM₁'] using hq_M₁'_raw
  obtain ⟨htr_bound_LM₁', ⟨y₁, hy₁_int, hy₁_tr⟩, hnorm_lin_LM₁', _⟩ :=
    ld_ch10_unramified_residue_galois_bridge F L M₁' hLM₁' hGalLM₁' hPrime_LM₁'
      hval_norm_LM₁'_raw hval_LM₁'
  obtain ⟨_, hnM₁'_eq_raw, hξM₁'_cond_eq_raw, _⟩ :=
    hUnramImp_LM₁' htr_bound_LM₁' ⟨y₁, hy₁_int, hy₁_tr⟩ hnorm_lin_LM₁'
  have hnM₁'_eq : condExpChar F M₁' ψM₁' = condExpChar F L ψ := hnM₁'_eq_raw
  have hξM₁'_cond_eq : condExp F M₁' ξM₁' = T := hξM₁'_cond_eq_raw
  have hT_ge2 : 2 ≤ T := hbE'_ge2
  have hξM₁'_cond_ne0 : condExp F M₁' ξM₁' ≠ 0 := by omega
  have hξM₁'_pow : ξM₁' ^ p = 1 := by
    apply MonoidHom.ext
    intro z
    change (νE' (Units.map (normLM F hLM₁') z)) ^ p = 1
    rw [← MonoidHom.pow_apply, hνE'_pow, MonoidHom.one_apply]
  have hξM₁'_ne : ξM₁' ≠ 1 := by
    intro h1
    obtain ⟨_, u₀, _, hu₀_ne⟩ :=
      (ld_condExp_and_condExpChar_spec F M₁' ψM₁' hψM₁' ξM₁').2.2.1 hξM₁'_cond_ne0
    apply hu₀_ne
    rw [h1, MonoidHom.one_apply]
  
  let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
  have hξE'_triv1 : ∀ u ∈ unitGroup F E' (condExp F E' ξE'), ξE' u = 1 := by
    simpa [pow_one] using (hξE'_props 1 hPrime.one_lt).2.1
  obtain ⟨_, _, hq_E', hval_norm_LE', hnE'_eq_raw, hCond_le_LE', _, _⟩ :=
    ld_ch10_wild_ramification_and_cond_formulas F L E' hLE' hGalLE' hAbLE' hPrime
      ψ hψ νE' νM₁' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνE'M₁'_cond hξE'_triv1
      (fun j hj => (hMinE' j hj).1) (by omega : condExp F L νE' ≠ 0) hWild
  have hnE'_eq : condExpChar F E' ψE' =
      (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (T : ℤ) := hnE'_eq_raw
  have hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) = (p : ℤ) * valL F L x :=
    hval_incl_of_norm L E' hLE' hval_norm_LE'
  have hξE'_cond_eq : condExp F E' ξE' = 0 := by
    have h1 := (hCond_le_LE' (by omega)).1
    rwa [hUnramM₁'] at h1
  
  have hξE'_pow : ξE' ^ p = 1 := by
    apply MonoidHom.ext
    intro y
    change (νM₁' (Units.map (normLM F hLE') y)) ^ p = 1
    rw [← MonoidHom.pow_apply, hνM₁'_pow, MonoidHom.one_apply]
  have hξE'_ne : ξE' ≠ 1 := by
    intro h1
    apply hνM₁'_ne
    apply MonoidHom.ext
    intro x
    rw [MonoidHom.one_apply]
    obtain ⟨ϖ_E', hϖE'⟩ := (ld_valL_and_unitGroup_props F E').2.2.2.2.2.2.1 1
    let ϖ_L : Lˣ := Units.map (normLM F hLE') ϖ_E'
    have hϖL : valL F L (ϖ_L : L) = 1 := by
      change valL F L (normLM F hLE' (ϖ_E' : E')) = 1
      rw [hval_norm_LE', hϖE']
    let m : ℤ := valL F L (x : L)
    let u : Lˣ := x * (ϖ_L ^ m)⁻¹
    have hu_val0 : valL F L (u : L) = 0 := by
      change valL F L ((x : L) * (((ϖ_L ^ m)⁻¹ : Lˣ) : L)) = 0
      rw [hvalL.2.2.2.2.1 (x : L) (((ϖ_L ^ m)⁻¹ : Lˣ) : L) (Units.ne_zero x) (Units.ne_zero _),
        hvalL.2.2.2.2.2.1 (ϖ_L ^ m), hval_zpow ϖ_L m, hϖL]
      change m + -(m * 1) = 0
      ring
    have hu_mem0 : u ∈ unitGroup F L 0 :=
      (hvalL.2.2.2.2.2.2.2.2.1 u).mpr hu_val0
    have hνM₁'_triv0 : ∀ v ∈ unitGroup F L 0, νM₁' v = 1 := by
      have h0 := hνM₁'_cond 1 hPrime.one_lt
      simpa [pow_one, hUnramM₁'] using h0
    have hu_one : νM₁' u = 1 := hνM₁'_triv0 u hu_mem0
    have hϖL_one : νM₁' ϖ_L = 1 := by
      change ξE' ϖ_E' = 1
      rw [h1, MonoidHom.one_apply]
    have hx_eq : x = u * ϖ_L ^ m := by
      dsimp only [u]
      exact (inv_mul_cancel_right x (ϖ_L ^ m)).symm
    rw [hx_eq, map_mul, map_zpow, hu_one, hϖL_one, one_zpow, mul_one]
  have hPrime_E'K₁ : Nat.Prime (Module.finrank E' (IntermediateField.extendScalars hE'K₁)) :=
    hdegE'K₁.symm ▸ hPrime
  have hθE'K₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (θE'.comp (Units.map (normLM F hE'K₁)))),
      (θE'.comp (Units.map (normLM F hE'K₁))) u = 1 := by
    rwa [hχE'_comp]
  obtain ⟨_, hval_norm_E'K₁_raw, hval_E'K₁, _, _, _, hUnramImp_E'K₁⟩ :=
    ld_ch10_unramified_arith_and_twist_reduction F E' K₁ hE'K₁ hGalE'K₁ hAbE'K₁ hPrime_E'K₁
      ψE' hψE' ξE' θE' (hdegE'K₁.symm ▸ hξE'_pow) hξE'_ne
      (hξE'_props 0 hPrime.pos).1
      (fun j hj => (hξE'_props j (hdegE'K₁ ▸ hj)).2.1)
      (fun j hj => (hξE'_props j (hdegE'K₁ ▸ hj)).2.2.1)
      hθE'K₁_cond
      (fun j hj => le_of_eq ((hξE'_props j (hdegE'K₁ ▸ hj)).2.2.2).symm)
      hξE'_cond_eq
      (fun ψ' hψ' θ => ld_condExp_and_condExpChar_spec F E' ψ' hψ' θ)
      (fun ψK hψK θK => ld_condExp_and_condExpChar_spec F K₁ ψK hψK θK)
      (fun a ha => ld_unitCoset_finite F E' a ha)
  have hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = (p : ℤ) * valL F K₁ w := by
    intro w
    simpa [hdegE'K₁] using hval_norm_E'K₁_raw w
  obtain ⟨htr_bound_E'K₁, ⟨w₁, hw₁_int, hw₁_tr⟩, hnorm_lin_E'K₁, _⟩ :=
    ld_ch10_unramified_residue_galois_bridge F E' K₁ hE'K₁ hGalE'K₁ hPrime_E'K₁
      hval_norm_E'K₁_raw hval_E'K₁
  obtain ⟨_, hnK₁_eq_raw, hmK₁_E'_raw, _⟩ :=
    hUnramImp_E'K₁ htr_bound_E'K₁ ⟨w₁, hw₁_int, hw₁_tr⟩ hnorm_lin_E'K₁
  have hnK₁_eq : condExpChar F K₁ ψK₁ = condExpChar F E' ψE' := by
    change condExpChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ) = condExpChar F E' ψE'
    rwa [htraceChar_E'K₁]
  have hmK₁_E' : condExp F K₁ θK₁ = mE' := by
    simpa [hχE'_comp] using hmK₁_E'_raw
  
  have hPrime_M₁'K₁ : Nat.Prime (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) :=
    hdegM₁'K₁.symm ▸ hPrime
  have hWild_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      EllipticRootNumber.p F :=
    hdegM₁'K₁.trans hWild
  have hθM₁'K₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (θM₁'.comp (Units.map (normLM F hM₁'K₁)))),
      (θM₁'.comp (Units.map (normLM F hM₁'K₁))) u = 1 := by
    rwa [hχM₁'_comp]
  obtain ⟨_, _, _, hval_norm_M₁'K₁, _, hCond_le_M₁'K₁, hCond_gt_M₁'K₁, _⟩ :=
    ld_ch10_wild_ramification_and_cond_formulas F M₁' K₁ hM₁'K₁ hGalM₁'K₁ hAbM₁'K₁ hPrime_M₁'K₁
      ψM₁' hψM₁' ξM₁' θM₁' (hdegM₁'K₁.symm ▸ hξM₁'_pow) hξM₁'_ne
      (hξM₁'_props 0 hPrime.pos).1
      (fun j hj => (hξM₁'_props j (hdegM₁'K₁ ▸ hj)).2.1)
      (fun j hj => (hξM₁'_props j (hdegM₁'K₁ ▸ hj)).2.2.1)
      hθM₁'K₁_cond
      (fun j hj => le_of_eq ((hξM₁'_props j (hdegM₁'K₁ ▸ hj)).2.2.2).symm)
      hξM₁'_cond_ne0 hWild_M₁'K₁
  have hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z := by
    intro z
    simpa [hdegM₁'K₁] using hval_incl_of_norm M₁' K₁ hM₁'K₁ hval_norm_M₁'K₁ z
  have hCondPair : T ≤ mM₁' ∧ mE' = T + p * (mM₁' - T) := by
    by_cases hle : mM₁' ≤ T
    · have hle' : condExp F M₁' θM₁' ≤ condExp F M₁' ξM₁' := by
        rw [hξM₁'_cond_eq]
        exact hle
      have h1 := (hCond_le_M₁'K₁ hle').2 1 (hdegM₁'K₁.symm ▸ hPrime.one_lt) zero_lt_one
      have h2 : condExp F M₁' (ξM₁' ^ 1 * θM₁') = mM₁' := (hξM₁'_props 1 hPrime.one_lt).2.2.2
      have hmM₁'_eq_T : mM₁' = T := by
        rw [← h2, h1, hξM₁'_cond_eq]
      have hmE'_eq_mM₁' : mE' = mM₁' := by
        have h3 := (hCond_le_M₁'K₁ hle').1
        rwa [hχM₁'_comp, hmK₁_E'] at h3
      rw [hmE'_eq_mM₁', hmM₁'_eq_T]
      simp
    · have hlt : T < mM₁' := Nat.lt_of_not_le hle
      have hlt' : condExp F M₁' ξM₁' < condExp F M₁' θM₁' := by
        rw [hξM₁'_cond_eq]
        exact hlt
      have h1 := (hCond_gt_M₁'K₁ hlt').1
      rw [hχM₁'_comp, hmK₁_E', hξM₁'_cond_eq, hdegM₁'K₁] at h1
      exact ⟨le_of_lt hlt, h1⟩
  obtain ⟨hT_le, hmE'_eq⟩ := hCondPair
  
  have hq_pow_eq :
      ((qL F E' : Ω F) ^ (4 * condExpChar F E' ψE' + 2 * (mE' : ℤ))) *
          ((qL F L : Ω F) ^ (2 * (((p - 1 : ℕ) : ℤ) * (condExp F L νM₁' : ℤ)))) =
        ((qL F M₁' : Ω F) ^ (4 * condExpChar F M₁' ψM₁' + 2 * (mM₁' : ℤ))) *
          ((qL F L : Ω F) ^ (2 * (((p - 1 : ℕ) : ℤ) * (T : ℤ)))) := by
    have hqL_pos : 0 < qL F L := Nat.pow_pos (q_pos F)
    have hqL_ne0 : (qL F L : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hqL_pos.ne'
    rw [hq_E', hq_M₁', hUnramM₁', Nat.cast_pow, ← zpow_natCast (qL F L : Ω F) p,
      ← zpow_mul, ← zpow_add₀ hqL_ne0, ← zpow_add₀ hqL_ne0]
    congr 1
    have hmE'_cast : (mE' : ℤ) = (T : ℤ) + (p : ℤ) * ((mM₁' : ℤ) - (T : ℤ)) := by
      rw [hmE'_eq, Nat.cast_add, Nat.cast_mul, Nat.cast_sub hT_le]
    have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by
      have hp1 : 1 ≤ p := hPrime.one_le
      exact Nat.cast_sub hp1
    rw [hnE'_eq, hnM₁'_eq, hmE'_cast, hp_sub, Nat.cast_zero]
    ring
  exact ⟨hT_le, hmE'_eq, hnM₁'_eq, hnE'_eq, hnK₁_eq, hξM₁'_pow, hξM₁'_ne, hξM₁'_cond_eq,
    hq_pow_eq, hval_LM₁', hval_norm_LM₁', hval_LE', hval_norm_LE',
    hval_E'K₁, hval_norm_E'K₁, hval_M₁'K₁, hval_norm_M₁'K₁,
    htr_bound_LM₁', htr_bound_E'K₁, hnorm_lin_E'K₁,
    ⟨y₁, w₁, hy₁_int, hy₁_tr, hw₁_int, hw₁_tr⟩⟩

theorem ld_bicyclic_diamond_norm_and_trace_compat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L A B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F A]
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hLA : L ≤ A) (hLB : L ≤ B) (hAK₁ : A ≤ K₁) (hBK₁ : B ≤ K₁)
    (hGalLA : IsGaloisExt F L A) (hGalBK₁ : IsGaloisExt F B K₁)
    (hdeg : Module.finrank B (IntermediateField.extendScalars hBK₁) =
      Module.finrank L (IntermediateField.extendScalars hLA))
    (h_sup : A ⊔ B = K₁) (y : A) :
    normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
      IntermediateField.inclusion hLB (normLM F hLA y) ∧
    traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
      IntermediateField.inclusion hLB (traceLM F hLA y) :=
by
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k K₀ := by
    intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  have hIsGalois_of_ext : ∀ {A₀ B₀ : IntermediateField F (AlgebraicClosure F)}
      (hAB : A₀ ≤ B₀), IsGaloisExt F A₀ B₀ → IsGalois A₀ (IntermediateField.extendScalars hAB) := by
    intro A₀ B₀ hAB hGalAB
    let B' := IntermediateField.extendScalars hAB
    haveI : Algebra.IsSeparable A₀ B' := hGalAB.2.2.2 hAB
    haveI : Normal A₀ (AlgebraicClosure F) := Normal.tower_top_of_normal F A₀ (AlgebraicClosure F)
    refine helper_isGalois A₀ (AlgebraicClosure F) B' ?_
    intro σ τ hτ
    let σ_F : A₀.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A₀).symm σ
    let τ_F : A₀.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A₀).symm τ
    have hτB : τ_F.1 ∈ B₀.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hAB).mpr hx)
    have hconjB : (σ_F * τ_F * σ_F⁻¹).1 ∈ B₀.fixingSubgroup :=
      hGalAB.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτB
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjB
    exact hconjB x ((IntermediateField.mem_extendScalars hAB).mp hx)
  let A' := IntermediateField.extendScalars hLA
  let K₁_B := IntermediateField.extendScalars hBK₁
  haveI : FiniteDimensional F A' := ‹FiniteDimensional F A›
  haveI : FiniteDimensional F K₁_B := ‹FiniteDimensional F K₁›
  haveI : FiniteDimensional L A' := Module.Finite.of_restrictScalars_finite F L A'
  haveI : FiniteDimensional B K₁_B := Module.Finite.of_restrictScalars_finite F B K₁_B
  haveI : IsGalois L A' := hIsGalois_of_ext hLA hGalLA
  haveI : Normal L A' := IsGalois.to_normal
  haveI : IsGalois B K₁_B := hIsGalois_of_ext hBK₁ hGalBK₁
  haveI : Normal B K₁_B := IsGalois.to_normal
  haveI : Normal B (AlgebraicClosure F) := Normal.tower_top_of_normal F B (AlgebraicClosure F)
  let G_A := A' ≃ₐ[L] A'
  let G_B := K₁_B ≃ₐ[B] K₁_B
  have hcard_GB_GA : Fintype.card G_B = Fintype.card G_A := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank B K₁_B, hdeg,
      ← IsGalois.card_aut_eq_finrank L A', Nat.card_eq_fintype_card]
  let Φ_BL : B.fixingSubgroup →* G_A :=
    (AlgEquiv.restrictNormalHom A').comp
      ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
        (Subgroup.inclusion (IntermediateField.fixingSubgroup_le hLB)))
  let Ψ_B : B.fixingSubgroup →* G_B :=
    (AlgEquiv.restrictNormalHom K₁_B).comp
      (IntermediateField.fixingSubgroupEquiv B).toMonoidHom
  have hΦ_apply : ∀ (γ : B.fixingSubgroup) (x : A'),
      ((Φ_BL γ x : A') : AlgebraicClosure F) = γ.1 x.1 := by
    intro γ x
    change ((AlgEquiv.restrictNormalHom A'
      ((IntermediateField.fixingSubgroupEquiv L)
        ⟨γ.1, IntermediateField.fixingSubgroup_le hLB γ.2⟩) x : A') :
        AlgebraicClosure F) = γ.1 x.1
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have hΨ_apply : ∀ (γ : B.fixingSubgroup) (z : K₁_B),
      ((Ψ_B γ z : K₁_B) : AlgebraicClosure F) = γ.1 z.1 := by
    intro γ z
    change ((AlgEquiv.restrictNormalHom K₁_B
      ((IntermediateField.fixingSubgroupEquiv B) γ) z : K₁_B) :
        AlgebraicClosure F) = γ.1 z.1
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have hΨ_surj : Function.Surjective Ψ_B :=
    (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
      (IntermediateField.fixingSubgroupEquiv B).surjective
  choose lift_B hlift_B using hΨ_surj
  let ρ : G_B → G_A := fun τ => Φ_BL (lift_B τ)
  have hfix_sup_AB : A.fixingSubgroup ⊓ B.fixingSubgroup = K₁.fixingSubgroup := by
    rw [← IntermediateField.fixingSubgroup_sup, h_sup]
  have hρ_inj : Function.Injective ρ := by
    intro τ₁ τ₂ hρ_eq
    let γ : B.fixingSubgroup := (lift_B τ₁)⁻¹ * lift_B τ₂
    have hΦ_γ : Φ_BL γ = 1 := by
      change Φ_BL ((lift_B τ₁)⁻¹ * lift_B τ₂) = 1
      rw [map_mul, map_inv]
      exact inv_mul_eq_one.mpr hρ_eq
    have hγ_A : γ.1 ∈ A.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro a ha
      let x : A' := ⟨a, (IntermediateField.mem_extendScalars hLA).mpr ha⟩
      have hx : Φ_BL γ x = x := by rw [hΦ_γ]; rfl
      have hx_val := congrArg Subtype.val hx
      rwa [hΦ_apply γ x] at hx_val
    have hγ_K₁ : γ.1 ∈ K₁.fixingSubgroup := by
      rw [← hfix_sup_AB]
      exact ⟨hγ_A, γ.2⟩
    have hΨ_γ : Ψ_B γ = 1 := by
      apply AlgEquiv.ext
      intro z
      apply Subtype.ext
      rw [hΨ_apply γ z]
      rw [IntermediateField.mem_fixingSubgroup_iff] at hγ_K₁
      exact hγ_K₁ z.1 ((IntermediateField.mem_extendScalars hBK₁).mp z.2)
    have hΨ_eq : Ψ_B (lift_B τ₁) = Ψ_B (lift_B τ₂) := by
      apply inv_mul_eq_one.mp
      rw [← map_inv, ← map_mul]
      exact hΨ_γ
    rwa [hlift_B τ₁, hlift_B τ₂] at hΨ_eq
  have hρ_bij : Function.Bijective ρ :=
    (Fintype.bijective_iff_injective_and_card ρ).mpr ⟨hρ_inj, hcard_GB_GA⟩
  let y_A : A' := toExtendScalars F hLA y
  let y_B : K₁_B := toExtendScalars F hBK₁ (IntermediateField.inclusion hAK₁ y)
  have hρ_act : ∀ τ : G_B,
      ((τ y_B : K₁_B) : AlgebraicClosure F) = ((ρ τ y_A : A') : AlgebraicClosure F) := by
    intro τ
    have h1 : ((ρ τ y_A : A') : AlgebraicClosure F) = (lift_B τ).1 y.1 :=
      hΦ_apply (lift_B τ) y_A
    have h2 : ((Ψ_B (lift_B τ) y_B : K₁_B) : AlgebraicClosure F) = (lift_B τ).1 y.1 :=
      hΨ_apply (lift_B τ) y_B
    rw [hlift_B τ] at h2
    exact h2.trans h1.symm
  have hNorm_B : (normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
      ∏ τ : G_B, ((τ y_B : K₁_B) : AlgebraicClosure F) := by
    have h1 := congrArg K₁_B.val (Algebra.norm_eq_prod_automorphisms B y_B)
    rw [map_prod] at h1
    exact h1
  have hNorm_A : (normLM F hLA y : AlgebraicClosure F) =
      ∏ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) := by
    have h1 := congrArg A'.val (Algebra.norm_eq_prod_automorphisms L y_A)
    rw [map_prod] at h1
    exact h1
  have hProd_eq : (∏ τ : G_B, ((τ y_B : K₁_B) : AlgebraicClosure F)) =
      ∏ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) :=
    Fintype.prod_bijective ρ hρ_bij _ _ hρ_act
  have hNorm_diamond : normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
      IntermediateField.inclusion hLB (normLM F hLA y) := by
    apply Subtype.ext
    change (normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
      (normLM F hLA y : AlgebraicClosure F)
    rw [hNorm_B, hNorm_A, hProd_eq]
  have hTrace_B : (traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
      ∑ τ : G_B, ((τ y_B : K₁_B) : AlgebraicClosure F) := by
    have h1 := congrArg K₁_B.val (trace_eq_sum_automorphisms (K := B) y_B)
    rw [map_sum] at h1
    exact h1
  have hTrace_A : (traceLM F hLA y : AlgebraicClosure F) =
      ∑ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) := by
    have h1 := congrArg A'.val (trace_eq_sum_automorphisms (K := L) y_A)
    rw [map_sum] at h1
    exact h1
  have hSum_eq : (∑ τ : G_B, ((τ y_B : K₁_B) : AlgebraicClosure F)) =
      ∑ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) :=
    Fintype.sum_bijective ρ hρ_bij _ _ hρ_act
  have hTrace_diamond : traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
      IntermediateField.inclusion hLB (traceLM F hLA y) := by
    apply Subtype.ext
    change (traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
      (traceLM F hLA y : AlgebraicClosure F)
    rw [hTrace_B, hTrace_A, hSum_eq]
  exact ⟨hNorm_diamond, hTrace_diamond⟩

theorem ld_ch12_bicyclic_frob_generator_and_conj_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let θM₁' := recChar F rec M₁' χM₁'
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    traceChar F (hLE'.trans hE'K₁) ψ = traceChar F hE'K₁ (traceChar F hLE' ψ) ∧
    ∃ (σ₀ : M₁' ≃ₐ[F] M₁') (j₀ : ℕ),
      0 < j₀ ∧ j₀ < p ∧
      (∀ x : L, σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
      (∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z) ∧
      (∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
        ∑ k ∈ Finset.range p, (σ₀ ^ k) z) ∧
      (∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
        ∏ k ∈ Finset.range p, (σ₀ ^ k) z) ∧
      (∀ (r : ℕ) (z : M₁'ˣ),
        θM₁' (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z) =
          (ξM₁' z) ^ (r * j₀) * θM₁' z) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set θM₁' := recChar F rec M₁' χM₁'
  set ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  haveI : NeZero p := ⟨hPrime.ne_zero⟩
  
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨_, hWeil_norm⟩ := ld_separable_weil_char_rec_and_norm F rec
  have htraceChar_E'K₁ : traceChar F (hLE'.trans hE'K₁) ψ =
      traceChar F hE'K₁ (traceChar F hLE' ψ) :=
    ((htraceChar L E' hLE' hAbLE'.2.2).2 ψ hψ).2.2 K₁ hE'K₁
  have hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ) :=
    ((htraceChar L M₁' hLM₁' hAbLM₁'.2.2).2 ψ hψ).1
  obtain ⟨μE', μM₁', hμE'_weil, hμE'_ker, hμE'_pow, hνE'_rec,
    hμM₁'_weil, hμM₁'_ker, hμM₁'_pow, hνM₁'_rec, _⟩ :=
    ld_ch12_bicyclic_norm_char_weil_lift_and_diagonal_subfield F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hPrime hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf h_sup
      χK₁ hInvK₁ ψ hψ νE' νM₁' hνE'_pow hνE'_ne hνE'_ker hνM₁'_pow hνM₁'_ne hνM₁'_ker
  have hWeil_one : ∀ (A : IntermediateField F (AlgebraicClosure F)),
      IsWeilRep F A (charRep F A 1) := by
    intro A
    refine ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ _ => ?_⟩
    apply LinearMap.ext
    intro v
    change ((1 : relWeil F A →* (Ω F)ˣ) w : Ω F) • v = v
    rw [MonoidHom.one_apply, Units.val_one, one_smul]
  have hWeil_mul : ∀ (A : IntermediateField F (AlgebraicClosure F))
      {χ₁ χ₂ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ₁) → IsWeilRep F A (charRep F A χ₂) →
      IsWeilRep F A (charRep F A (χ₁ * χ₂)) := by
    rintro A χ₁ χ₂ ⟨hfin, U₁, hU₁, htriv₁⟩ ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    have hmul : charRep F A (χ₁ * χ₂) w = charRep F A χ₁ w * charRep F A χ₂ w := by
      apply LinearMap.ext
      intro v
      change ((χ₁ * χ₂) w : Ω F) • v = (χ₁ w : Ω F) • ((χ₂ w : Ω F) • v)
      rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
    rw [hmul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  have hWeil_pow : ∀ (A : IntermediateField F (AlgebraicClosure F))
      {χ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ) → ∀ j : ℕ, IsWeilRep F A (charRep F A (χ ^ j)) := by
    intro A χ hχ j
    induction' j with j ih
    · have h0 : χ ^ (0 : ℕ) = 1 := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_zero, MonoidHom.one_apply]
      rw [h0]
      exact hWeil_one A
    · have hs : χ ^ (j + 1) = χ ^ j * χ := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_succ, MonoidHom.mul_apply, MonoidHom.pow_apply]
      rw [hs]
      exact hWeil_mul A ih hχ
  have hWeil_rest : ∀ {A B : IntermediateField F (AlgebraicClosure F)} (hAB : A ≤ B)
      {χ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ) →
      IsWeilRep F B (charRep F B (restrictWeilChar F hAB χ)) := by
    rintro A B hAB χ ⟨hfin, U, hU, htriv⟩
    refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
    exact htriv (Subgroup.inclusion (relWeil_antitone F hAB) w) hwU hwI
  have hrecChar_eval : ∀ (A : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F A]
      (ψA : AddChar A (Ω F)), IsAdmissibleChar F A ψA →
      ∀ (χ : relWeil F A →* (Ω F)ˣ), IsWeilRep F A (charRep F A χ) →
      (∀ x : Aˣ, (recChar F rec A χ) x = χ (rec.recMap A x)) ∧
      (∀ u ∈ unitGroup F A (condExp F A (recChar F rec A χ)), (recChar F rec A χ) u = 1) ∧
      (∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
        (ψB : AddChar B (Ω F)), IsAdmissibleChar F B ψB →
        ∀ (hAB : A ≤ B), Algebra.IsSeparable A (IntermediateField.extendScalars hAB) →
        (recChar F rec A χ).comp (Units.map (normLM F hAB)) =
          recChar F rec B (restrictWeilChar F hAB χ)) := by
    intro A _ ψA hψA χ hχ
    obtain ⟨θ, hθ_rec, hθ_cond, hθ_norm⟩ := hWeil_norm A χ hχ
    have h_eq : recChar F rec A χ = θ := (htateEps A ψA hψA χ hχ θ hθ_rec).1
    rw [h_eq]
    refine ⟨hθ_rec, hθ_cond, ?_⟩
    intro B _ ψB hψB hAB hSep
    have hnorm := (hθ_norm B hAB hSep).1
    exact ((htateEps B ψB hψB (restrictWeilChar F hAB χ) (hWeil_rest hAB hχ)
      (θ.comp (Units.map (normLM F hAB))) hnorm).1).symm
  let μM₁'_tilde : relWeil F M₁' →* (Ω F)ˣ := restrictWeilChar F hLM₁' μE'
  have hμM₁'_tilde_weil : IsWeilRep F M₁' (charRep F M₁' μM₁'_tilde) :=
    hWeil_rest hLM₁' hμE'_weil
  have hrec_μE' : recChar F rec L μE' = νE' :=
    (htateEps L ψ hψ μE' hμE'_weil νE' hνE'_rec).1
  have hξM₁'_eq_rec : ξM₁' = recChar F rec M₁' μM₁'_tilde := by
    have h := (hrecChar_eval L ψ hψ μE' hμE'_weil).2.2
      M₁' (traceChar F hLM₁' ψ) hψM₁' hLM₁' hAbLM₁'.2.2
    rw [hrec_μE'] at h
    exact h
  have hξM₁'_rec : ∀ z : M₁'ˣ, ξM₁' z = μM₁'_tilde (rec.recMap M₁' z) := by
    intro z
    rw [hξM₁'_eq_rec]
    exact (hrecChar_eval M₁' (traceChar F hLM₁' ψ) hψM₁' μM₁'_tilde hμM₁'_tilde_weil).1 z
  have hθM₁'_rec : ∀ z : M₁'ˣ, θM₁' z = χM₁' (rec.recMap M₁' z) :=
    (hrecChar_eval M₁' (traceChar F hLM₁' ψ) hψM₁' χM₁' hχM₁'_weil).1
  have hξM₁'_pow_rec : ∀ (j : ℕ) (z : M₁'ˣ),
      (ξM₁' ^ j) z = (μM₁'_tilde ^ j) (rec.recMap M₁' z) := by
    intro j z
    rw [MonoidHom.pow_apply, MonoidHom.pow_apply, hξM₁'_rec z]
  have hξM₁'_twist_rec : ∀ (j : ℕ) (z : M₁'ˣ),
      (ξM₁' ^ j * θM₁') z = (μM₁'_tilde ^ j * χM₁') (rec.recMap M₁' z) := by
    intro j z
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hξM₁'_pow_rec j z, hθM₁'_rec z]
  have hrec_twist : ∀ j : ℕ, recChar F rec M₁' (μM₁'_tilde ^ j * χM₁') = ξM₁' ^ j * θM₁' :=
    fun j => (htateEps M₁' (traceChar F hLM₁' ψ) hψM₁' (μM₁'_tilde ^ j * χM₁')
      (hWeil_mul M₁' (hWeil_pow M₁' hμM₁'_tilde_weil j) hχM₁'_weil)
      (ξM₁' ^ j * θM₁') (hξM₁'_twist_rec j)).1
  have hξM₁'_pow : ξM₁' ^ p = 1 := by
    apply MonoidHom.ext
    intro z
    rw [MonoidHom.pow_apply, MonoidHom.one_apply, MonoidHom.comp_apply,
      ← MonoidHom.pow_apply, hνE'_pow, MonoidHom.one_apply]
  have hμM₁'_tilde_pow : μM₁'_tilde ^ p = 1 := by
    apply MonoidHom.ext
    intro w
    change (μE' (Subgroup.inclusion (relWeil_antitone F hLM₁') w)) ^ p = 1
    rw [← MonoidHom.pow_apply, hμE'_pow, MonoidHom.one_apply]
  
  have h_prim_of_order : ∀ (ζ : (Ω F)ˣ), ζ ^ p = 1 → ζ ≠ 1 →
      IsPrimitiveRoot (ζ : Ω F) p ∧
      ∀ (ξ : (Ω F)ˣ), ξ ^ p = 1 → ∃ i < p, ζ ^ i = ξ := by
    intro ζ hpow hne
    have hpow_val : (ζ : Ω F) ^ p = 1 := by
      rw [← Units.val_pow_eq_pow_val, hpow, Units.val_one]
    have hne_val : (ζ : Ω F) ≠ 1 := fun h => hne (Units.ext h)
    have hord : orderOf (ζ : Ω F) = p := orderOf_eq_prime hpow_val hne_val
    have hprim : IsPrimitiveRoot (ζ : Ω F) p := IsPrimitiveRoot.iff_orderOf.mpr hord
    refine ⟨hprim, fun ξ hξ => ?_⟩
    have hξ_val : (ξ : Ω F) ^ p = 1 := by
      rw [← Units.val_pow_eq_pow_val, hξ, Units.val_one]
    obtain ⟨i, hi_lt, hi_eq⟩ := hprim.eq_pow_of_pow_eq_one hξ_val
    refine ⟨i, hi_lt, Units.ext ?_⟩
    rw [Units.val_pow_eq_pow_val]
    exact hi_eq
  have hμM₁'_pow_val : ∀ w : relWeil F L, (μM₁' w) ^ p = 1 := by
    intro w
    rw [← MonoidHom.pow_apply, hμM₁'_pow, MonoidHom.one_apply]
  have hex_x₁ : ∃ x₁ : Lˣ, νM₁' x₁ ≠ 1 := by
    by_contra hall
    push_neg at hall
    exact hνM₁'_ne (MonoidHom.ext hall)
  obtain ⟨x₁, hx₁_ne⟩ := hex_x₁
  let g₀ : relWeil F L := rec.recMap L x₁
  let ζM₁' : (Ω F)ˣ := μM₁' g₀
  have hζM₁'_eq : ζM₁' = νM₁' x₁ := (hνM₁'_rec x₁).symm
  have hζM₁'_pow : ζM₁' ^ p = 1 := hμM₁'_pow_val g₀
  have hζM₁'_ne : ζM₁' ≠ 1 := hζM₁'_eq ▸ hx₁_ne
  obtain ⟨hζM₁'_prim, hζM₁'_span⟩ := h_prim_of_order ζM₁' hζM₁'_pow hζM₁'_ne
  let ι_LM₁' : relWeil F M₁' →* relWeil F L := Subgroup.inclusion (relWeil_antitone F hLM₁')
  have h_decomp_LM₁' : ∀ w : relWeil F L,
      ∃ (k : ℕ) (n : relWeil F M₁'), k < p ∧ w = g₀ ^ k * ι_LM₁' n := by
    intro w
    obtain ⟨k, hk_lt, hk_eq⟩ := hζM₁'_span (μM₁' w) (hμM₁'_pow_val w)
    have h_ker : (((g₀ ^ k)⁻¹ * w : relWeil F L) : AbsGal F) ∈ M₁'.fixingSubgroup := by
      rw [hμM₁'_ker, map_mul, map_inv, map_pow, inv_mul_eq_one]
      exact hk_eq
    let n : relWeil F M₁' := ⟨((g₀ ^ k)⁻¹ * w : relWeil F L).1,
      ((g₀ ^ k)⁻¹ * w : relWeil F L).2.1, h_ker⟩
    refine ⟨k, n, hk_lt, ?_⟩
    apply Subtype.ext
    change (w : AbsGal F) = (g₀ : AbsGal F) ^ k * (((g₀ : AbsGal F) ^ k)⁻¹ * (w : AbsGal F))
    exact (mul_inv_cancel_left ((g₀ : AbsGal F) ^ k) (w : AbsGal F)).symm
  have hg₀_p_fix : ((g₀ ^ p : relWeil F L) : AbsGal F) ∈ M₁'.fixingSubgroup := by
    rw [hμM₁'_ker, map_pow]
    exact hζM₁'_pow
  let u_p : relWeil F M₁' := ⟨(g₀ ^ p : relWeil F L).1, (g₀ ^ p : relWeil F L).2.1, hg₀_p_fix⟩
  have hu_p_coe : ι_LM₁' u_p = g₀ ^ p := Subtype.ext rfl
  have hfix_sup_K₁ : E'.fixingSubgroup ⊓ M₁'.fixingSubgroup = K₁.fixingSubgroup := by
    rw [← IntermediateField.fixingSubgroup_sup, h_sup]
  have hNorm_LK₁ : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ K₁.fixingSubgroup,
      σ * τ * σ⁻¹ ∈ K₁.fixingSubgroup := by
    intro σ hσ τ hτ
    rw [← hfix_sup_K₁] at hτ ⊢
    exact ⟨hAbLE'.1 σ hσ τ hτ.1, hAbLM₁'.1 σ hσ τ hτ.2⟩
  obtain ⟨σ₀, χM₁'_1, hσ₀, hσ₀_L, hχM₁'_1, hχM₁'_1_weil, hrec_σ₀, _, _⟩ :=
    ld_ch12_galois_aut_weil_recChar_invariance F rec L M₁' hLM₁' hGalLM₁' ψ hψ
      χM₁' hχM₁'_weil g₀
  let δM₁' : relWeil F M₁' →* (Ω F)ˣ := χM₁'_1 * χM₁'⁻¹
  have h_conj_mem_M₁' : ∀ (g : relWeil F L) (w : relWeil F M₁'),
      (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F M₁' := by
    intro g w
    refine ⟨(weilGroup F).mul_mem
      ((weilGroup F).mul_mem ((weilGroup F).inv_mem g.2.1) w.2.1) g.2.1, ?_⟩
    have hg_inv : (g : AbsGal F)⁻¹ ∈ L.fixingSubgroup := L.fixingSubgroup.inv_mem g.2.2
    have hconj := hGalLM₁'.2.2.1 (g : AbsGal F)⁻¹ hg_inv (w : AbsGal F) w.2.2
    simpa using hconj
  have hδM₁'_apply : ∀ w : relWeil F M₁',
      δM₁' w = χM₁' ⟨(g₀ : AbsGal F)⁻¹ * (w : AbsGal F) * (g₀ : AbsGal F), h_conj_mem_M₁' g₀ w⟩ *
        (χM₁' w)⁻¹ := by
    intro w
    change χM₁'_1 w * (χM₁' w)⁻¹ = _
    rw [hχM₁'_1 w (h_conj_mem_M₁' g₀ w)]
  have hδM₁'_kerK₁ : ∀ w : relWeil F M₁', (w : AbsGal F) ∈ K₁.fixingSubgroup → δM₁' w = 1 := by
