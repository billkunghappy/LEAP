      rw [hB, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one, smul_eq_mul, mul_one]
    · rw [dif_neg h_mem]
      have hu_ne : u_map x₀ ≠ u₀ := fun h_eq => h_mem (hu_iff.mp h_eq)
      have hB : LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u₀ ∘ₗ
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u₀) = 0 := by
        apply LinearMap.ext
        intro c
        change (ρ ⟨x₀ * r_map x₀, h_xr_mem x₀⟩
          (ULift.up (LinearMap.single (Ω F) (fun _ => Ω F) u₀ c (u_map x₀)))).down = 0
        rw [LinearMap.single_apply, Pi.single_eq_of_ne hu_ne]
        change (ρ ⟨x₀ * r_map x₀, h_xr_mem x₀⟩ 0).down = 0
        rw [map_zero]
        rfl
      rw [hB, map_zero]
  have hFrob_congr : ∀ {M : IntermediateField F (AlgebraicClosure F)}
      (E : IntermediateField F (AlgebraicClosure F))
      (χ : relWeil F E →* (Ω F)ˣ) (x g : relWeil F M),
      let H_EM := (relWeil F E).subgroupOf (relWeil F M)
      frobTerm E χ (cosetRep (QuotientGroup.mk x : relWeil F M ⧸ H_EM)) g =
        frobTerm E χ x g := by
    intro M E χ x g H_EM
    let u₀ : relWeil F M ⧸ H_EM := QuotientGroup.mk x
    let y : relWeil F M := cosetRep u₀
    have hyx : y⁻¹ * x ∈ H_EM := QuotientGroup.eq.mp (Quotient.out_eq u₀)
    let b : relWeil F E := ⟨((y⁻¹ * x : relWeil F M) : AbsGal F), hyx⟩
    have h_conj_eq : ((x⁻¹ * g * x : relWeil F M) : AbsGal F) =
        (b : AbsGal F)⁻¹ * ((y⁻¹ * g * y : relWeil F M) : AbsGal F) * (b : AbsGal F) := by
      change (x : AbsGal F)⁻¹ * (g : AbsGal F) * (x : AbsGal F) =
        ((y : AbsGal F)⁻¹ * (x : AbsGal F))⁻¹ *
          ((y : AbsGal F)⁻¹ * (g : AbsGal F) * (y : AbsGal F)) *
          ((y : AbsGal F)⁻¹ * (x : AbsGal F))
      group
    have h_mem_iff : ((y⁻¹ * g * y : relWeil F M) : AbsGal F) ∈ relWeil F E ↔
        ((x⁻¹ * g * x : relWeil F M) : AbsGal F) ∈ relWeil F E := by
      constructor
      · intro hy_mem
        rw [h_conj_eq]
        exact (relWeil F E).mul_mem
          ((relWeil F E).mul_mem ((relWeil F E).inv_mem b.2) hy_mem) b.2
      · intro hx_mem
        have h1 : (b : AbsGal F) * ((x⁻¹ * g * x : relWeil F M) : AbsGal F) * (b : AbsGal F)⁻¹ ∈
            relWeil F E :=
          (relWeil F E).mul_mem ((relWeil F E).mul_mem b.2 hx_mem) ((relWeil F E).inv_mem b.2)
        have h2 : (b : AbsGal F) * ((x⁻¹ * g * x : relWeil F M) : AbsGal F) * (b : AbsGal F)⁻¹ =
            ((y⁻¹ * g * y : relWeil F M) : AbsGal F) := by
          rw [h_conj_eq]
          group
        rwa [h2] at h1
    dsimp only [frobTerm]
    by_cases hx_mem : ((x⁻¹ * g * x : relWeil F M) : AbsGal F) ∈ relWeil F E
    · have hy_mem : ((y⁻¹ * g * y : relWeil F M) : AbsGal F) ∈ relWeil F E :=
        h_mem_iff.mpr hx_mem
      rw [dif_pos hy_mem, dif_pos hx_mem]
      congr 1
      let z_y : relWeil F E := ⟨((y⁻¹ * g * y : relWeil F M) : AbsGal F), hy_mem⟩
      let z_x : relWeil F E := ⟨((x⁻¹ * g * x : relWeil F M) : AbsGal F), hx_mem⟩
      have h_zx_eq : z_x = b⁻¹ * z_y * b := Subtype.ext h_conj_eq
      change χ z_y = χ z_x
      rw [h_zx_eq, map_mul, map_mul, map_inv, mul_right_comm, inv_mul_cancel, one_mul]
    · have hy_not_mem : ¬ (((y⁻¹ * g * y : relWeil F M) : AbsGal F) ∈ relWeil F E) :=
        fun hy_mem => hx_mem (h_mem_iff.mp hy_mem)
      rw [dif_neg hy_not_mem, dif_neg hx_mem]
  
  let G_L := relWeil F L
  let G_A := relWeil F A
  let H_B := (relWeil F B).subgroupOf G_L
  let ι_A := Subgroup.inclusion (relWeil_antitone F hLA)
  let ι_B := Subgroup.inclusion (relWeil_antitone F hLB)
  let A_i : Fin m → IntermediateField F (AlgebraicClosure F) :=
    fun i => mackeyField F A B (w i)
  let H_Ai : ∀ i : Fin m, Subgroup G_A :=
    fun i => (relWeil F (A_i i)).subgroupOf G_A
  have hStab_iff : ∀ (i : Fin m) (a : G_A),
      (a : AbsGal F) ∈ relWeil F (A_i i) ↔
        (w i : AbsGal F)⁻¹ * (a : AbsGal F) * (w i : AbsGal F) ∈ relWeil F B := by
    intro i a
    constructor
    · intro ha
      exact (mackeyConjHom F A B (w i) ⟨(a : AbsGal F), ha⟩).2
    · intro hb
      refine ⟨a.2.1, ?_⟩
      change (a : AbsGal F) ∈
        (A ⊔ B.map ((w i : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)).fixingSubgroup
      rw [IntermediateField.fixingSubgroup_sup]
      refine Subgroup.mem_inf.mpr ⟨a.2.2, ?_⟩
      rw [IntermediateField.mem_fixingSubgroup_iff]
      rintro y ⟨x, hx, rfl⟩
      have hbx : ((w i : AbsGal F)⁻¹ * (a : AbsGal F) * (w i : AbsGal F)) x = x :=
        (IntermediateField.mem_fixingSubgroup_iff B _).mp hb.2 x hx
      have hbx' : (w i : AbsGal F).symm ((a : AbsGal F) ((w i : AbsGal F) x)) = x := hbx
      have h1 := congrArg (w i : AbsGal F) hbx'
      rw [(w i : AbsGal F).apply_symm_apply] at h1
      exact h1
  have hTerm_eq : ∀ (i : Fin m) (a₀ u : G_A),
      (χA u : Ω F) * frobTerm B χB (ι_A a₀ * w i) (ι_A u) =
        frobTerm (A_i i) (mackeyChar F χA χB (w i)) a₀ u := by
    intro i a₀ u
    have h_abs_eq : (((ι_A a₀ * w i)⁻¹ * ι_A u * (ι_A a₀ * w i) : G_L) : AbsGal F) =
        (w i : AbsGal F)⁻¹ * ((a₀⁻¹ * u * a₀ : G_A) : AbsGal F) * (w i : AbsGal F) := by
      change ((a₀ : AbsGal F) * (w i : AbsGal F))⁻¹ * (u : AbsGal F) *
        ((a₀ : AbsGal F) * (w i : AbsGal F)) =
        (w i : AbsGal F)⁻¹ * ((a₀ : AbsGal F)⁻¹ * (u : AbsGal F) * (a₀ : AbsGal F)) * (w i : AbsGal F)
      group
    have h_iff : (((ι_A a₀ * w i)⁻¹ * ι_A u * (ι_A a₀ * w i) : G_L) : AbsGal F) ∈ relWeil F B ↔
        ((a₀⁻¹ * u * a₀ : G_A) : AbsGal F) ∈ relWeil F (A_i i) := by
      rw [h_abs_eq]
      exact (hStab_iff i (a₀⁻¹ * u * a₀)).symm
    dsimp only [frobTerm]
    by_cases h_mem : ((a₀⁻¹ * u * a₀ : G_A) : AbsGal F) ∈ relWeil F (A_i i)
    · have h_mem_B : (((ι_A a₀ * w i)⁻¹ * ι_A u * (ι_A a₀ * w i) : G_L) : AbsGal F) ∈ relWeil F B :=
        h_iff.mpr h_mem
      rw [dif_pos h_mem_B, dif_pos h_mem, ← Units.val_mul]
      congr 1
      let z_Ai : relWeil F (A_i i) := ⟨((a₀⁻¹ * u * a₀ : G_A) : AbsGal F), h_mem⟩
      change χA u * χB ⟨(((ι_A a₀ * w i)⁻¹ * ι_A u * (ι_A a₀ * w i) : G_L) : AbsGal F), h_mem_B⟩ =
        χA (a₀⁻¹ * u * a₀) * χB (mackeyConjHom F A B (w i) z_Ai)
      have hχA_conj : χA (a₀⁻¹ * u * a₀) = χA u := by
        rw [map_mul, map_mul, map_inv, mul_right_comm, inv_mul_cancel, one_mul]
      have h_sub_B : (⟨(((ι_A a₀ * w i)⁻¹ * ι_A u * (ι_A a₀ * w i) : G_L) : AbsGal F), h_mem_B⟩ : relWeil F B) =
          mackeyConjHom F A B (w i) z_Ai :=
        Subtype.ext h_abs_eq
      rw [hχA_conj, h_sub_B]
    · have h_not_B : ¬ ((((ι_A a₀ * w i)⁻¹ * ι_A u * (ι_A a₀ * w i) : G_L) : AbsGal F) ∈ relWeil F B) :=
        fun h_mem_B => h_mem (h_iff.mp h_mem_B)
      rw [dif_neg h_not_B, dif_neg h_mem, mul_zero]
  haveI : Finite (G_L ⧸ H_B) := hFinQuot L B hLB
  letI : Fintype (G_L ⧸ H_B) := Fintype.ofFinite (G_L ⧸ H_B)
  have hFinAi : ∀ i : Fin m, FiniteDimensional F (A_i i) := fun i => (hMackey_wf i).1.1
  have hFinQuotAi : ∀ i : Fin m, Finite (G_A ⧸ H_Ai i) := by
    intro i
    haveI : FiniteDimensional F (A_i i) := hFinAi i
    exact hFinQuot A (A_i i) (show A ≤ A_i i from le_sup_left)
  letI : ∀ i : Fin m, Fintype (G_A ⧸ H_Ai i) := fun i => Fintype.ofFinite (G_A ⧸ H_Ai i)
  let Ψ : (Σ i : Fin m, (G_A ⧸ H_Ai i)) → (G_L ⧸ H_B) :=
    fun p => QuotientGroup.mk (ι_A (cosetRep p.2) * w p.1)
  have hΨ_inj : Function.Injective Ψ := by
    rintro ⟨i, v₁⟩ ⟨j, v₂⟩ h_eq
    let a₁ : G_A := cosetRep v₁
    let a₂ : G_A := cosetRep v₂
    have h_mem_B : (ι_A a₁ * w i)⁻¹ * (ι_A a₂ * w j) ∈ H_B := QuotientGroup.eq.mp h_eq
    let b : relWeil F B := ⟨(((ι_A a₁ * w i)⁻¹ * (ι_A a₂ * w j) : G_L) : AbsGal F), h_mem_B⟩
    have h_disj_eq : ι_A (a₂⁻¹ * a₁) * w i * ι_B b = w j := by
      apply Subtype.ext
      change ((a₂ : AbsGal F)⁻¹ * (a₁ : AbsGal F)) * (w i : AbsGal F) *
        (((a₁ : AbsGal F) * (w i : AbsGal F))⁻¹ * ((a₂ : AbsGal F) * (w j : AbsGal F))) =
        (w j : AbsGal F)
      group
    have hij : i = j := hDisj i j (a₂⁻¹ * a₁) b h_disj_eq
    subst hij
    have h_conj_B : (w i : AbsGal F)⁻¹ * ((a₁⁻¹ * a₂ : G_A) : AbsGal F) * (w i : AbsGal F) ∈ relWeil F B := by
      have h_abs : (((ι_A a₁ * w i)⁻¹ * (ι_A a₂ * w i) : G_L) : AbsGal F) =
          (w i : AbsGal F)⁻¹ * ((a₁⁻¹ * a₂ : G_A) : AbsGal F) * (w i : AbsGal F) := by
        change ((a₁ : AbsGal F) * (w i : AbsGal F))⁻¹ * ((a₂ : AbsGal F) * (w i : AbsGal F)) =
          (w i : AbsGal F)⁻¹ * ((a₁ : AbsGal F)⁻¹ * (a₂ : AbsGal F)) * (w i : AbsGal F)
        group
      rw [← h_abs]
      exact h_mem_B
    have h_mem_Ai : a₁⁻¹ * a₂ ∈ H_Ai i := (hStab_iff i (a₁⁻¹ * a₂)).mpr h_conj_B
    have hv : (a₁ : G_A ⧸ H_Ai i) = (a₂ : G_A ⧸ H_Ai i) := QuotientGroup.eq.mpr h_mem_Ai
    have h_out1 : (a₁ : G_A ⧸ H_Ai i) = v₁ := Quotient.out_eq v₁
    have h_out2 : (a₂ : G_A ⧸ H_Ai i) = v₂ := Quotient.out_eq v₂
    rw [h_out1, h_out2] at hv
    rw [hv]
  have hΨ_surj : Function.Surjective Ψ := by
    intro u₀
    obtain ⟨i, a, b, h_g⟩ := hExh (cosetRep u₀)
    let v₀ : G_A ⧸ H_Ai i := QuotientGroup.mk a
    let a₀ : G_A := cosetRep v₀
    have ha₀a : a₀⁻¹ * a ∈ H_Ai i := QuotientGroup.eq.mp (Quotient.out_eq v₀)
    have h_conj_B : (w i)⁻¹ * ι_A (a₀⁻¹ * a) * w i ∈ H_B :=
      (hStab_iff i (a₀⁻¹ * a)).mp ha₀a
    have h_prod_B : (ι_A a₀ * w i)⁻¹ * cosetRep u₀ ∈ H_B := by
      have h_eq : (ι_A a₀ * w i)⁻¹ * cosetRep u₀ =
          ((w i)⁻¹ * ι_A (a₀⁻¹ * a) * w i) * ι_B b := by
        rw [← h_g]
        apply Subtype.ext
        change ((a₀ : AbsGal F) * (w i : AbsGal F))⁻¹ *
          ((a : AbsGal F) * (w i : AbsGal F) * (b : AbsGal F)) =
          ((w i : AbsGal F)⁻¹ * ((a₀ : AbsGal F)⁻¹ * (a : AbsGal F)) * (w i : AbsGal F)) *
            (b : AbsGal F)
        group
      rw [h_eq]
      exact H_B.mul_mem h_conj_B b.2
    refine ⟨⟨i, v₀⟩, ?_⟩
    have hq : (QuotientGroup.mk (ι_A a₀ * w i) : G_L ⧸ H_B) = QuotientGroup.mk (cosetRep u₀) :=
      QuotientGroup.eq.mpr h_prod_B
    have hout : (QuotientGroup.mk (cosetRep u₀) : G_L ⧸ H_B) = u₀ := Quotient.out_eq u₀
    exact hq.trans hout
  let e_Ψ : (Σ i : Fin m, (G_A ⧸ H_Ai i)) ≃ (G_L ⧸ H_B) :=
    Equiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩
  refine ⟨hWf_self, hTr_self, hMackey_wf, fun u => ?_⟩
  rw [hFrobChar L B hLB χB (ι_A u), Finset.mul_sum, ← Equiv.sum_comp e_Ψ, Fintype.sum_sigma]
  simp only [monomialListTrace, List.map_ofFn, List.sum_ofFn, Function.comp_def]
  apply Finset.sum_congr rfl
  intro i _
  have hTr_i := hFrobChar A (A_i i) (show A ≤ A_i i from le_sup_left) (mackeyChar F χA χB (w i)) u
  change (∑ v₀ : G_A ⧸ H_Ai i,
      (χA u : Ω F) * frobTerm B χB (cosetRep (QuotientGroup.mk (ι_A (cosetRep v₀) * w i))) (ι_A u)) =
    (⟨1, A_i i, show A ≤ A_i i from le_sup_left, mackeyChar F χA χB (w i)⟩ : MonomialTerm F A).trace F A u
  rw [hTr_i]
  apply Finset.sum_congr rfl
  intro v₀ _
  rw [hFrob_congr B χB (ι_A (cosetRep v₀) * w i) (ι_A u)]
  exact hTerm_eq i (cosetRep v₀) u

theorem ld_mackey_conj_term_eval_eq (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K E₁ E₂ : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hGal : IsGaloisExt F L K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_conj : ∀ σ ∈ L.fixingSubgroup, ∀ E, L ≤ E → E ≤ K →
      f (E.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) = f E)
    (hLE₁ : L ≤ E₁) (hE₁K : E₁ ≤ K) (hLE₂ : L ≤ E₂) (hE₂K : E₂ ≤ K)
    (χ₁ : relWeil F E₁ →* (Ω F)ˣ) (χ₂ : relWeil F E₂ →* (Ω F)ˣ)
    (hWeil₁ : IsWeilRep F E₁ (charRep F E₁ χ₁))
    (hWeil₂ : IsWeilRep F E₂ (charRep F E₂ χ₂))
    (g : relWeil F L)
    (hE₂_eq : E₂ = E₁.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F))
    (hχ₂_eq : ∀ (u : relWeil F E₂)
      (hu : (g : AbsGal F)⁻¹ * (u : AbsGal F) * (g : AbsGal F) ∈ relWeil F E₁),
      χ₂ u = χ₁ ⟨(g : AbsGal F)⁻¹ * (u : AbsGal F) * (g : AbsGal F), hu⟩) :
    evalMonomialTerm F rec (fun _ E _ => f E) L ψ ⟨1, E₂, hLE₂, χ₂⟩ =
      evalMonomialTerm F rec (fun _ E _ => f E) L ψ ⟨1, E₁, hLE₁, χ₁⟩ :=
by
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨hWeil_unit_triv, hSepRec_all⟩ := ld_separable_weil_char_rec_and_norm F rec
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear * -
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have hSep_iff : ∀ (L₀ E₀ : IntermediateField F (AlgebraicClosure F)) (h₀ : L₀ ≤ E₀),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars h₀) ↔
        E₀ ≤ IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) := by
    clear * -
    intro L₀ E₀ h₀
    let S := IntermediateField.extendScalars h₀
    have hmin : ∀ x : S, IsSeparable L₀ x.1 ↔ IsSeparable L₀ x := by
      intro x
      change (minpoly L₀ (S.val x)).Separable ↔ (minpoly L₀ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h₀).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₀ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₀ := (IntermediateField.mem_extendScalars h₀).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F E₁ :=
    Module.Finite.of_injective (IntermediateField.inclusion hE₁K).toLinearMap
      (IntermediateField.inclusion hE₁K).injective
  haveI : FiniteDimensional F E₂ :=
    Module.Finite.of_injective (IntermediateField.inclusion hE₂K).toLinearMap
      (IntermediateField.inclusion hE₂K).injective
  have hSepLK : Algebra.IsSeparable L (IntermediateField.extendScalars hLK) := hGal.2.2.2 hLK
  have hSepLE₁ : Algebra.IsSeparable L (IntermediateField.extendScalars hLE₁) :=
    (hSep_iff L E₁ hLE₁).mpr (hE₁K.trans ((hSep_iff L K hLK).mp hSepLK))
  have hSepLE₂ : Algebra.IsSeparable L (IntermediateField.extendScalars hLE₂) :=
    (hSep_iff L E₂ hLE₂).mpr (hE₂K.trans ((hSep_iff L K hLK).mp hSepLK))
  let γ : AbsGal F := (g : AbsGal F)
  have hγL : γ ∈ L.fixingSubgroup := g.2.2
  have hf_eq : f E₂ = f E₁ := by
