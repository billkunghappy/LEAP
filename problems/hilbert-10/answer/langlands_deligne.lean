        (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j * lam_L) ψ) := by
    intro lam_L h1 h2
    exact ld_ch12_unshifted_cyclic_fml F L E hLE hGalLE hAbLE hPrime ψ hψ νE lam_L
