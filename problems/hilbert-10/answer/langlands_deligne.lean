  let α_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ := fun i =>
    Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ * (c'_μ i)⁻¹

  have hα_orb_val : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field ((α_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = -(t : ℤ) := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
