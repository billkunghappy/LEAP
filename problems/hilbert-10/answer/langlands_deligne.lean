          (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad))) ∧
    ((T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T) ∧
     (IntermediateField.inclusion hM₁'K₁ T +
        IntermediateField.inclusion hE'K₁ ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀) = 0 ∨
       (((p - 1) * p * m + p * (p - 1) * δ + (p - 1) * t₁ : ℕ) : ℤ) ≤
