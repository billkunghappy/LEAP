  rw [hRE'_decomp]
  exact hvalE'_add (bE' : ℤ) _ _ (hvalE'_add (bE' : ℤ) _ _ hR_sum_val hR_coeff_val) hR_main_val

theorem ld_ch12_wild_odd_tot_ram_frobenius_norm_s0_and_ysT_congr (F : Type u) [Field F]
