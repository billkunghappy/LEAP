    have hSepLA : Algebra.IsSeparable L (IntermediateField.extendScalars hLA) := by
      rw [hSep_iff]
      intro z hz
      exact (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) (hBK (hAB hz))
    exact ⟨hFinA, hGalAB, hSepLA, hGalAB.2.2.2 hAB⟩
  refine ⟨?_, ?_⟩
  · intro M' hLM' hM'K β hβ_weil hβ_rest
    obtain ⟨hFinM', hGalM'K, hSepLM', hSepM'K⟩ := hSubField hLM' hM'K le_rfl hGal
    haveI : FiniteDimensional F M' := hFinM'
    have hψM' : IsAdmissibleChar F M' (traceChar F hLM' ψ) :=
      ((htraceChar L M' hLM' hSepLM').2 ψ hψ).1
    obtain ⟨θ₀, hθ₀_rec, hθ₀_triv, hθ₀_norm⟩ := hsep_rec M' β hβ_weil
    have hθ_eq : recChar F rec M' β = θ₀ :=
      (hrecChar_spec M' (traceChar F hLM' ψ) hψM' β hβ_weil θ₀ hθ₀_rec).1
    let θ_M' := recChar F rec M' β
    have hθ_triv : ∀ u ∈ unitGroup F M' (condExp F M' θ_M'), θ_M' u = 1 := by
      change ∀ u ∈ unitGroup F M' (condExp F M' (recChar F rec M' β)), (recChar F rec M' β) u = 1
      rw [hθ_eq]
      exact hθ₀_triv
    have hθ_normK : ∀ w : Kˣ,
        θ_M' (Units.map (normLM F hM'K) w) = (restrictWeilChar F hM'K β) (rec.recMap K w) := by
      intro w
      change (recChar F rec M' β) (Units.map (normLM F hM'K) w) = _
      rw [hθ_eq]
      exact (hθ₀_norm K hM'K hSepM'K).1 w
    let u_M' : M'ˣ := Units.map (normLM F hM'K) w₀
    have hu_M'_ug1 : u_M' ∈ unitGroup F M' 1 := hNormUG1 M' K hM'K hGalM'K w₀ hw₀_ug1
    obtain ⟨_, _, _, _, _, _, _, _, hugM'0, _, hugM'_val0⟩ := ld_valL_and_unitGroup_props F M'
    have hu_M'_ug0 : u_M' ∈ unitGroup F M' 0 :=
      (hugM'0 u_M').mpr (hugM'_val0 1 u_M' hu_M'_ug1)
    have hθ_u_ne1 : θ_M' u_M' ≠ 1 := by
      dsimp [u_M']
      rw [hθ_normK w₀, hβ_rest]
      exact hw₀_ne1
    change 2 ≤ condExp F M' θ_M'
    by_contra h_lt2
    have h_cases : condExp F M' θ_M' = 0 ∨ condExp F M' θ_M' = 1 := by omega
    rcases h_cases with h0 | h1
    · have htriv := hθ_triv u_M' (h0 ▸ hu_M'_ug0)
      exact hθ_u_ne1 htriv
    · have htriv := hθ_triv u_M' (h1 ▸ hu_M'_ug1)
      exact hθ_u_ne1 htriv
  · intro F_s hLFs hFsMC χ_s hχ_s_K hχ_s_MC
    obtain ⟨hFinFs, hGalFsMC, hSepLFs, hSepFsMC⟩ := hSubField hLFs hFsMC hM_CK hMin.1
    haveI : FiniteDimensional F F_s := hFinFs
    have hχ_s_weil : IsWeilRep F F_s (charRep F F_s χ_s) := by
      have hfin : FiniteDimensional (Ω F) (ULift.{u} (Ω F)) :=
        Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm
      let U : Set (AbsGal F) := (K.fixingSubgroup : Set (AbsGal F))
      have hU : U ∈ nhds (1 : AbsGal F) := by
        rw [krullTopology_mem_nhds_one_iff]
        exact ⟨K, inferInstance, Set.Subset.rfl⟩
      refine ⟨hfin, U, hU, fun w hwU _ => ?_⟩
      have hwK : w.1 ∈ relWeil F K := ⟨w.2.1, hwU⟩
      let w_K : relWeil F K := ⟨w.1, hwK⟩
      have hχ1 : χ_s w = 1 := by
        change (restrictWeilChar F (hFsMC.trans hM_CK) χ_s) w_K = 1
        rw [hχ_s_K]
        rfl
      apply LinearMap.ext
      intro v
      change (χ_s w : Ω F) • v = v
      rw [hχ1, Units.val_one, one_smul]
    refine ⟨hχ_s_weil, ?_⟩
    have hψFs : IsAdmissibleChar F F_s (traceChar F hLFs ψ) :=
      ((htraceChar L F_s hLFs hSepLFs).2 ψ hψ).1
    obtain ⟨μ₀, hμ₀_rec, hμ₀_triv, hμ₀_norm⟩ := hsep_rec F_s χ_s hχ_s_weil
    have hμ_eq : recChar F rec F_s χ_s = μ₀ :=
      (hrecChar_spec F_s (traceChar F hLFs ψ) hψFs χ_s hχ_s_weil μ₀ hμ₀_rec).1
    let μ_s := recChar F rec F_s χ_s
    let χ_s_MC := restrictWeilChar F hFsMC χ_s
    have hμ_triv : ∀ u ∈ unitGroup F F_s (condExp F F_s μ_s), μ_s u = 1 := by
      change ∀ u ∈ unitGroup F F_s (condExp F F_s (recChar F rec F_s χ_s)),
        (recChar F rec F_s χ_s) u = 1
      rw [hμ_eq]
      exact hμ₀_triv
    have hμ_normMC : ∀ z : M_Cˣ,
        μ_s (Units.map (normLM F hFsMC) z) = χ_s_MC (rec.recMap M_C z) := by
      intro z
      change (recChar F rec F_s χ_s) (Units.map (normLM F hFsMC) z) = _
      rw [hμ_eq]
      exact (hμ₀_norm M_C hFsMC hSepFsMC).1 z
    have hχ_s_MC_kerK : ∀ v : relWeil F M_C,
        (v : AbsGal F) ∈ K.fixingSubgroup → χ_s_MC v = 1 := by
      intro v hvK
      let v_K : relWeil F K := ⟨v.1, ⟨v.2.1, hvK⟩⟩
      change (restrictWeilChar F (hFsMC.trans hM_CK) χ_s) v_K = 1
      rw [hχ_s_K]
      rfl
    have hμ_normK_triv : ∀ w : Kˣ,
        μ_s (Units.map (normLM F hFsMC) (Units.map (normLM F hM_CK) w)) = 1 := by
      intro w
      let z_w : M_Cˣ := Units.map (normLM F hM_CK) w
      rw [hμ_normMC z_w]
      have hfix : (rec.recMap M_C z_w : AbsGal F) ∈ K.fixingSubgroup :=
        (rec.ker_rec M_C K hM_CK hMin.2.1 z_w).mpr ⟨w.1, rfl⟩
      exact hχ_s_MC_kerK (rec.recMap M_C z_w) hfix
    change 2 ≤ condExp F F_s μ_s
    by_contra h_lt2
    obtain ⟨_, _, _, _, _, _, _, _, hugFs0, _, hugFs_val0⟩ := ld_valL_and_unitGroup_props F F_s
    have hμ_ug1_triv : ∀ u_s ∈ unitGroup F F_s 1, μ_s u_s = 1 := by
      intro u_s hu_s
      have hu_s0 : u_s ∈ unitGroup F F_s 0 :=
        (hugFs0 u_s).mpr (hugFs_val0 1 u_s hu_s)
      have h_cases : condExp F F_s μ_s = 0 ∨ condExp F F_s μ_s = 1 := by omega
      rcases h_cases with h0 | h1
      · exact hμ_triv u_s (h0 ▸ hu_s0)
      · exact hμ_triv u_s (h1 ▸ hu_s)
    have hμ_MC_ug1_triv : ∀ u ∈ unitGroup F M_C 1,
        μ_s (Units.map (normLM F hFsMC) u) = 1 := by
      intro u hu
      exact hμ_ug1_triv _ (hNormUG1 F_s M_C hFsMC hGalFsMC u hu)
    have hχ_s_MC_rec_triv : ∀ z : M_Cˣ, χ_s_MC (rec.recMap M_C z) = 1 := by
      intro z
      obtain ⟨w, hw⟩ := hMC_decomp z
      set u := z * (Units.map (normLM F hM_CK) w)⁻¹
      have hz_eq : z = u * Units.map (normLM F hM_CK) w := by
        dsimp [u]
        group
      rw [← hμ_normMC z, hz_eq, map_mul, map_mul,
        hμ_MC_ug1_triv u hw, hμ_normK_triv w, mul_one]
    have hχ_s_MC_all_triv : χ_s_MC = 1 := by
      ext v
      obtain ⟨z, hz⟩ := rec.surj_rec M_C K hM_CK hMin.2.1 v
      set v₀ : relWeil F M_C := (rec.recMap M_C z)⁻¹ * v
      have hv_eq : v = rec.recMap M_C z * v₀ := by
        dsimp [v₀]
        group
      rw [hv_eq, map_mul, hχ_s_MC_rec_triv z, hχ_s_MC_kerK v₀ hz, mul_one, MonoidHom.one_apply]
    exact hχ_s_MC hχ_s_MC_all_triv

theorem ld_ch14_tame_twist_cond_and_pow_invariance (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (h_ge2 : 2 ≤ condExp F L (recChar F rec L χL_ext))
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀) (hq₀_ne_p : q₀ ≠ p F) :
    (∀ (ν : relWeil F L →* (Ω F)ˣ),
      restrictWeilChar F hLM_C ν = 1 →
      ν ^ q₀ = 1 →
      IsWeilRep F L (charRep F L ν) ∧
      condExp F L (recChar F rec L ν) ≤ 1 ∧
      (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE (ν * χL_ext))) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ q₀ =
      (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ q₀ ∧
      (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L (ν * χL_ext)))) ^ q₀ =
      (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ q₀) ∧
    (∀ (L' E' : IntermediateField F (AlgebraicClosure F))
      (hLL' : L ≤ L') (hL'MC : L' ≤ M_C) (hEE' : E ≤ E') (hL'E' : L' ≤ E') (hE'K : E' ≤ K),
      E ⊔ L' = E' →
      ∀ (ν' : relWeil F L' →* (Ω F)ˣ),
        restrictWeilChar F hL'MC ν' = 1 →
        ν' ^ q₀ = 1 →
        IsWeilRep F L' (charRep F L' ν') ∧
        (tateEpsUnit F L'
            (recChar F rec L' (ν' * restrictWeilChar F hLL' χL_ext))
            (traceChar F hLL' ψ)) ^ q₀ =
          (tateEpsUnit F L'
            (recChar F rec L' (restrictWeilChar F hLL' χL_ext))
            (traceChar F hLL' ψ)) ^ q₀ ∧
        (tateEpsUnit F E'
            (recChar F rec E' (restrictWeilChar F hL'E' (ν' * restrictWeilChar F hLL' χL_ext)))
            (traceChar F (hLL'.trans hL'E') ψ)) ^ q₀ =
          (tateEpsUnit F E'
            (recChar F rec E' (restrictWeilChar F hL'E' (restrictWeilChar F hLL' χL_ext)))
            (traceChar F (hLL'.trans hL'E') ψ)) ^ q₀ ∧
        (∀ (D_L' : List (MonomialTerm F L')),
          (∀ s ∈ D_L',
            s.coeff = 1 ∧
            s.field ≤ M_C ∧
            s.χ ^ (p F) = 1 ∧
            (∃ hsK : s.field ≤ K, restrictWeilChar F hsK s.χ = 1) ∧
            (∃ hsE : s.field ≤ E ⊔ s.field, restrictWeilChar F hsE s.χ = 1) ∧
            (∀ hsM : s.field ≤ M_C, restrictWeilChar F hsM s.χ ≠ 1)) →
          (evalMonomialList F rec (fun _ _ _ => 1) L' (traceChar F hLL' ψ)
              (D_L'.map (twistMonomialTerm F L' ν'))) ^ q₀ =
            (evalMonomialList F rec (fun _ _ _ => 1) L' (traceChar F hLL' ψ) D_L') ^ q₀)) :=
by
  obtain ⟨hFinL, hFinMC, hFinE, hFinK, hGalMCK, _, _, hψE, _,
