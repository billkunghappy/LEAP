theorem ld_ch12_wild_odd_tot_ram_charpoly_splits_and_denom_replacement (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_cayley :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ : K₁)) -
        ((Δ : K₁) ^ p +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0)
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let δ := bE' - bM₁'
    let m := a_lam - bE'
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let s := - e_Δ (p - 1)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let n := IntermediateField.inclusion hLM₁' u * b
    let C := 1 + IntermediateField.inclusion hLE' u * a
    let W_E' := IntermediateField.inclusion hLE' W
    let D₀_E' := W_E' ^ p - W_E' + a ^ p
    let W_K₁ := IntermediateField.inclusion hE'K₁ W_E'
    let L_val := W_K₁ + IntermediateField.inclusion hM₁'K₁ b
    let D_norm := L_val ^ p - L_val
    let A_star := (Δ : K₁) - L_val
    let ρ := IntermediateField.inclusion hM₁'K₁ b -
      ((Δ : K₁) + IntermediateField.inclusion hE'K₁ a -
        (Δ : K₁) * IntermediateField.inclusion hM₁'K₁ s)
    let h_diff := IntermediateField.inclusion hM₁'K₁ b -
      ((Δ : K₁) + IntermediateField.inclusion hE'K₁ a)
    C ≠ 0 ∧ valL F E' C = 0 ∧
    1 + n ≠ 0 ∧ valL F M₁' (1 + n) = 0 ∧
    D₀_E' ≠ 0 ∧ valL F E' D₀_E' = -(((p * p * m : ℕ) : ℤ)) ∧
    L_val ≠ 0 ∧ valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) ∧
    D_norm ≠ 0 ∧ valL F K₁ D_norm = -(((p * p * p * m : ℕ) : ℤ)) ∧
    A_star ≠ 0 ∧ valL F K₁ A_star = -(((p * p * m : ℕ) : ℤ)) ∧
    (((p : ℕ) : E') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E')) ∧
    (ρ = 0 ∨
      ((p * (p - 1) * t₂ : ℕ) : ℤ) - ((p * p - 2 * p + 2 : ℕ) : ℤ) * (t₁ : ℤ) ≤
        valL F K₁ ρ) ∧
    (h_diff = 0 ∨ ((p * (p - 1) * δ : ℕ) : ℤ) - (t₁ : ℤ) ≤ valL F K₁ h_diff) ∧
    (IntermediateField.inclusion hM₁'K₁ b - IntermediateField.inclusion hE'K₁ a = 0 ∨
      -(t₁ : ℤ) ≤
        valL F K₁ (IntermediateField.inclusion hM₁'K₁ b - IntermediateField.inclusion hE'K₁ a)) ∧
    (∀ i ∈ Finset.Icc 1 (p - 1),
      ((p - 1 : ℕ) : K₁) * W_K₁ ^ 2 *
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
          A_star ^ i * D_norm⁻¹ -
        ((p - 1 : ℕ) : K₁) * W_K₁ ^ 2 *
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
          A_star ^ i * (IntermediateField.inclusion hE'K₁ D₀_E')⁻¹ = 0 ∨
        ((1 + p * t₂ : ℕ) : ℤ) ≤
          valL F K₁
            (((p - 1 : ℕ) : K₁) * W_K₁ ^ 2 *
                IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
                A_star ^ i * D_norm⁻¹ -
              ((p - 1 : ℕ) : K₁) * W_K₁ ^ 2 *
                IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
                A_star ^ i * (IntermediateField.inclusion hE'K₁ D₀_E')⁻¹)) ∧
    (W_K₁ ^ 2 * A_star ^ (p - 2) * D_norm⁻¹ -
      W_K₁ ^ 2 * A_star ^ (p - 2) * (IntermediateField.inclusion hE'K₁ D₀_E')⁻¹ = 0 ∨
      ((p * p * m : ℕ) : ℤ) - (t₁ : ℤ) ≤
        valL F K₁
          (W_K₁ ^ 2 * A_star ^ (p - 2) * D_norm⁻¹ -
            W_K₁ ^ 2 * A_star ^ (p - 2) * (IntermediateField.inclusion hE'K₁ D₀_E')⁻¹)) :=
by
  intro p t₁ t₂ δ m a b s u W n C W_E' D₀_E' W_K₁ L_val D_norm A_star ρ h_diff
  obtain ⟨_, _, _, _, hval_mul_L, hval_inv_L, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, hvalE'_1, _, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  obtain ⟨_, hvalM₁'_1, _, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv, _, hvalM₁'_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M₁'
  obtain ⟨_, hvalK₁_1, _, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, _, hvalK₁_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K₁
  have hval_helpers :
      ∀ (M : IntermediateField F (AlgebraicClosure F)),
        valL F M 1 = 0 →
        (∀ x : M, valL F M (-x) = valL F M x) →
        (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) →
        (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) →
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x + y = 0 ∨ k ≤ valL F M (x + y))) →
        (∀ (x : M) (k : ℕ), x ≠ 0 → valL F M (x ^ k) = (k : ℤ) * valL F M x) ∧
        (∀ (x : M), x ≠ 0 → valL F M x⁻¹ = - valL F M x) ∧
        (∀ (x y : M), x ≠ 0 → (y = 0 ∨ valL F M x < valL F M y) →
          x + y ≠ 0 ∧ valL F M (x + y) = valL F M x) ∧
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x - y = 0 ∨ k ≤ valL F M (x - y))) ∧
        (∀ (k₁ k₂ : ℤ) (x : M),
          k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M x) → (x = 0 ∨ k₁ ≤ valL F M x)) ∧
        (∀ (k₁ k₂ : ℤ) (x y : M),
          (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
            (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y))) ∧
        (∀ (x : M) (n : ℕ) (q : ℤ),
          (x = 0 ∨ q ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M (x ^ n))) ∧
        (∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
          (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
            ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i))) ∧
        (∀ n : ℕ, (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M)) := by
    intro M hv1 hvneg hvmul hvinv hvadd
    have hvpow : ∀ (x : M) (k : ℕ), x ≠ 0 → valL F M (x ^ k) = (k : ℤ) * valL F M x := by
      intro x k hx
      induction k with
      | zero => simp [hv1]
      | succ k ih =>
        rw [pow_succ, hvmul (x ^ k) x (pow_ne_zero k hx) hx, ih]
        push_cast
        ring
    have hvinv_elt : ∀ (x : M), x ≠ 0 → valL F M x⁻¹ = - valL F M x := by
      intro x hx
      exact hvinv (Units.mk0 x hx)
    have hvstrict : ∀ (x y : M), x ≠ 0 → (y = 0 ∨ valL F M x < valL F M y) →
        x + y ≠ 0 ∧ valL F M (x + y) = valL F M x := by
      intro x y hx hxy
      rcases hxy with rfl | hlt
      · simp [hx]
      · by_cases hy0 : y = 0
        · simp [hy0, hx]
        · have hxy_ne0 : x + y ≠ 0 := by
            intro h0
            have hx_eq : x = -y := eq_neg_of_add_eq_zero_left h0
            have hveq : valL F M x = valL F M y := by rw [hx_eq, hvneg]
            omega
          have hge : valL F M x ≤ valL F M (x + y) :=
            (hvadd (valL F M x) x y (Or.inr le_rfl) (Or.inr (le_of_lt hlt))).resolve_left hxy_ne0
          have hle : valL F M (x + y) ≤ valL F M x := by
            by_contra hgt
            push_neg at hgt
            set k : ℤ := min (valL F M (x + y)) (valL F M y)
            have hk_xy : x + y = 0 ∨ k ≤ valL F M (x + y) := Or.inr (min_le_left _ _)
            have hk_ny : -y = 0 ∨ k ≤ valL F M (-y) := by
              right; rw [hvneg]; exact min_le_right _ _
            have hsum := hvadd k (x + y) (-y) hk_xy hk_ny
            rw [add_neg_cancel_right] at hsum
            have hk_le : k ≤ valL F M x := hsum.resolve_left hx
            have hlt_k : valL F M x < k := lt_min hgt hlt
            omega
          exact ⟨hxy_ne0, le_antisymm hle hge⟩
    have hvsub : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x - y = 0 ∨ k ≤ valL F M (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      refine hvadd k x (-y) hx ?_
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rwa [hvneg])
    have hvmono : ∀ (k₁ k₂ : ℤ) (x : M),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M x) → (x = 0 ∨ k₁ ≤ valL F M x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvmul_ge : ∀ (k₁ k₂ : ℤ) (x y : M),
        (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvmul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvpow_ge : ∀ (x : M) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        simp [hv1]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvmul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvsum_ge : ∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvadd k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    have hvnat : ∀ n : ℕ, (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M) := by
      intro n
      induction n with
      | zero => left; exact Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hvadd 0 (n : M) 1 ih (Or.inr (by rw [hv1]))
    exact ⟨hvpow, hvinv_elt, hvstrict, hvsub, hvmono, hvmul_ge, hvpow_ge, hvsum_ge, hvnat⟩
  obtain ⟨hvalE'_pow, _, hvalE'_strict, _, _, _, _, _, _⟩ :=
    hval_helpers E' hvalE'_1 hvalE'_neg hvalE'_mul hvalE'_inv hvalE'_add
  obtain ⟨_, _, hvalM₁'_strict, _, _, _, _, _, _⟩ :=
    hval_helpers M₁' hvalM₁'_1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_inv hvalM₁'_add
  obtain ⟨hvalK₁_pow, hvalK₁_inv_elt, hvalK₁_strict, hvalK₁_sub, hvalK₁_mono,
      hvalK₁_mul_ge, hvalK₁_pow_ge, hvalK₁_sum_ge, hvalK₁_natCast⟩ :=
    hval_helpers K₁ hvalK₁_1 hvalK₁_neg hvalK₁_mul hvalK₁_inv hvalK₁_add
  clear hval_helpers
  
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by dsimp [p]; omega
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have ht₂_eq : t₂ = t₁ + δ := by dsimp [t₁, t₂, δ]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpm_gt : t₁ < p * m := hpm_gt_t₁
  have hpt₁_lt_ppm : p * t₁ < p * p * m := by
    have h1 : p * t₁ < p * (p * m) := Nat.mul_lt_mul_of_pos_left hpm_gt_t₁ hp_pos
    linarith [show p * (p * m) = p * p * m by ring]
  have hpm_lt_ppm : p * m < p * p * m := by
    have hpos : 0 < p * m := by positivity
    nlinarith
  have hppm_lt_pppm : p * p * m < p * p * p * m := by
    have hpos : 0 < p * p * m := by positivity
    nlinarith
  have ht₁_lt_pt₁ : t₁ < p * t₁ := by nlinarith
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hp2_cast : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := by omega
  
  have hu_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero γ⁻¹)
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hval_mul_L (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero γ⁻¹),
      hval_inv_L γ, hα_val, hγ_val]
    omega
  have hW_L_ne0 : W ≠ 0 := mul_ne_zero (Units.ne_zero γ) (Units.ne_zero α⁻¹)
  have hW_L_val : valL F L W = -(m : ℤ) := by
    dsimp [W, m]
    rw [hval_mul_L (γ : L) ((α⁻¹ : Lˣ) : L) (Units.ne_zero γ) (Units.ne_zero α⁻¹),
      hval_inv_L α, hγ_val, hα_val]
    omega
  have ha_ne0 : a ≠ 0 := Units.ne_zero (Units.map (normLM F hE'K₁) Δ)
  have ha_val : valL F E' a = -(t₁ : ℤ) := by
    dsimp [a, t₁]
    rw [hval_norm_E'K₁, hΔ_val]
  have hb_ne0 : b ≠ 0 := Units.ne_zero (Units.map (normLM F hM₁'K₁) Δ)
  have hb_val : valL F M₁' b = -(t₁ : ℤ) := by
    dsimp [b, t₁]
    rw [hval_norm_M₁'K₁, hΔ_val]
  
  have hu_E'_ne0 : IntermediateField.inclusion hLE' u ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hu_ne0
  have hua_ne0 : IntermediateField.inclusion hLE' u * a ≠ 0 := mul_ne_zero hu_E'_ne0 ha_ne0
  have hua_val : valL F E' (IntermediateField.inclusion hLE' u * a) =
      ((p * m : ℕ) : ℤ) - (t₁ : ℤ) := by
    rw [hvalE'_mul _ _ hu_E'_ne0 ha_ne0, hval_LE', hu_val, ha_val]
    push_cast; ring
  obtain ⟨hC_ne0, hC_val0⟩ : C ≠ 0 ∧ valL F E' C = 0 := by
    dsimp [C]
    have h := hvalE'_strict 1 (IntermediateField.inclusion hLE' u * a) one_ne_zero
      (Or.inr (by rw [hvalE'_1, hua_val]; omega))
    rwa [hvalE'_1] at h
  
  have hu_M₁'_ne0 : IntermediateField.inclusion hLM₁' u ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLM₁')).mpr hu_ne0
  have hn_ne0 : n ≠ 0 := mul_ne_zero hu_M₁'_ne0 hb_ne0
  have hn_val : valL F M₁' n = ((p * m : ℕ) : ℤ) - (t₁ : ℤ) := by
    dsimp [n]
    rw [hvalM₁'_mul _ _ hu_M₁'_ne0 hb_ne0, hval_LM₁', hu_val, hb_val]
    push_cast; ring
  obtain ⟨h1n_ne0, h1n_val0⟩ : 1 + n ≠ 0 ∧ valL F M₁' (1 + n) = 0 := by
    have h := hvalM₁'_strict 1 n one_ne_zero (Or.inr (by rw [hvalM₁'_1, hn_val]; omega))
    rwa [hvalM₁'_1] at h
  
  have hW_E'_ne0 : W_E' ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hW_L_ne0
  have hW_E'_val : valL F E' W_E' = -(((p * m : ℕ) : ℤ)) := by
    dsimp [W_E']
    rw [hval_LE', hW_L_val]
    push_cast; ring
  have hW_E'_p_ne0 : W_E' ^ p ≠ 0 := pow_ne_zero p hW_E'_ne0
  have hW_E'_p_val : valL F E' (W_E' ^ p) = -(((p * p * m : ℕ) : ℤ)) := by
    rw [hvalE'_pow W_E' p hW_E'_ne0, hW_E'_val]
    push_cast; ring
  have hap_ne0 : a ^ p ≠ 0 := pow_ne_zero p ha_ne0
