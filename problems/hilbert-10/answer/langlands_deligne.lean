  have hβ'_ne : β' ≠ 0 := mul_ne_zero hx₀_inv_M₁'_ne hb'_ne
  have hβ'_val : valL F M₁' β' = -(m₁ : ℤ) - condExpChar F M₁' ψM₁' := by
    dsimp [β']
    rw [hval_mul_M₁' x₀_inv_M₁' b' hx₀_inv_M₁'_ne hb'_ne, hx₀_inv_M₁'_val, hb'_val,
      hbM₁'_sub1_cast, hnM₁'_eq, hm₁_cast, hp_sub1_cast]
    ring
  have hψM₁'_β'_triv : ∀ w : M₁', (w = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' w) → ψM₁' (β' * w) = 1 := by
    intro w hw
    apply hψM₁'_triv (β' * w)
    by_cases hw0 : w = 0
    · left; rw [hw0, mul_zero]
    · right
      have hw_ge : (m₁ : ℤ) ≤ valL F M₁' w := hw.resolve_left hw0
      rw [hval_mul_M₁' β' w hβ'_ne hw0, hβ'_val]
      linarith
  have hψM₁'_ne0 : ∀ w : M₁', ψM₁' w ≠ 0 := by
    intro w
    have hmul : ψM₁' w * ψM₁' (-w) = 1 := by
      rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
    exact left_ne_zero_of_mul_eq_one hmul
  let ψM₁'_unit : M₁' → (Ω F)ˣ := fun w => Units.mk0 (ψM₁' w) (hψM₁'_ne0 w)
  let Φ : M₁'ˣ → (Ω F)ˣ := fun u =>
    (χ₁ u ^ 2)⁻¹ * ψM₁'_unit (β' * (2 * ((u : M₁') - 1) - ((u : M₁') - 1) ^ 2))

  have hΦ_mul : ∀ u₁ ∈ unitGroup F M₁' d₁, ∀ u₂ ∈ unitGroup F M₁' d₁,
      Φ (u₁ * u₂) = Φ u₁ * Φ u₂ := by
    intro u₁ hu₁ u₂ hu₂
    set z₁ : M₁' := (u₁ : M₁') - 1
    set z₂ : M₁' := (u₂ : M₁') - 1
    set z₁₂ : M₁' := ((u₁ * u₂ : M₁'ˣ) : M₁') - 1
    have hz₁ : z₁ = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' z₁ := by
      rcases (hunit_ge1_M₁' d₁ hd₁_ge1 u₁).mp hu₁ with h1 | hge
      · left; exact sub_eq_zero.mpr h1
      · right; exact hge
    have hz₂ : z₂ = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' z₂ := by
      rcases (hunit_ge1_M₁' d₁ hd₁_ge1 u₂).mp hu₂ with h1 | hge
      · left; exact sub_eq_zero.mpr h1
      · right; exact hge
    have hz₁z₂ : z₁ * z₂ = 0 ∨ (d₁ : ℤ) + (d₁ : ℤ) ≤ valL F M₁' (z₁ * z₂) :=
      hval_mul_bound_M₁' (d₁ : ℤ) (d₁ : ℤ) z₁ z₂ hz₁ hz₂
    have hz₁z₂_d₁ : z₁ * z₂ = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' (z₁ * z₂) := by
      rcases hz₁z₂ with h0 | hge
      · left; exact h0
      · right; omega
    have hsum_d₁ : (z₁ + z₁ + z₂ + z₂ + z₁ * z₂) = 0 ∨
        (d₁ : ℤ) ≤ valL F M₁' (z₁ + z₁ + z₂ + z₂ + z₁ * z₂) := by
      have h1 := hval_add_M₁' (d₁ : ℤ) z₁ z₁ hz₁ hz₁
      have h2 := hval_add_M₁' (d₁ : ℤ) (z₁ + z₁) z₂ h1 hz₂
      have h3 := hval_add_M₁' (d₁ : ℤ) (z₁ + z₁ + z₂) z₂ h2 hz₂
      exact hval_add_M₁' (d₁ : ℤ) (z₁ + z₁ + z₂ + z₂) (z₁ * z₂) h3 hz₁z₂_d₁
    have hprod_3d₁ : (z₁ * z₂) * (z₁ + z₁ + z₂ + z₂ + z₁ * z₂) = 0 ∨
        ((d₁ : ℤ) + (d₁ : ℤ)) + (d₁ : ℤ) ≤
          valL F M₁' ((z₁ * z₂) * (z₁ + z₁ + z₂ + z₂ + z₁ * z₂)) :=
      hval_mul_bound_M₁' ((d₁ : ℤ) + (d₁ : ℤ)) (d₁ : ℤ) _ _ hz₁z₂ hsum_d₁
    set diff_Q : M₁' := (2 * z₁₂ - z₁₂ ^ 2) - ((2 * z₁ - z₁ ^ 2) + (2 * z₂ - z₂ ^ 2))
    have hdiff_Q_eq : diff_Q = -((z₁ * z₂) * (z₁ + z₁ + z₂ + z₂ + z₁ * z₂)) := by
      dsimp [diff_Q, z₁₂, z₁, z₂]
      ring
    have hdiff_Q_m₁ : diff_Q = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' diff_Q := by
      rw [hdiff_Q_eq]
      rcases hprod_3d₁ with h0 | hge
      · left; rw [h0, neg_zero]
      · right
        rw [hval_neg_M₁']
        linarith
    have hψ_diff : ψM₁' (β' * diff_Q) = 1 := hψM₁'_β'_triv diff_Q hdiff_Q_m₁
    have hψ_Q12 : ψM₁'_unit (β' * (2 * z₁₂ - z₁₂ ^ 2)) =
        ψM₁'_unit (β' * (2 * z₁ - z₁ ^ 2)) * ψM₁'_unit (β' * (2 * z₂ - z₂ ^ 2)) := by
      apply Units.ext
      change ψM₁' (β' * (2 * z₁₂ - z₁₂ ^ 2)) =
        ψM₁' (β' * (2 * z₁ - z₁ ^ 2)) * ψM₁' (β' * (2 * z₂ - z₂ ^ 2))
      have hsplit : β' * (2 * z₁₂ - z₁₂ ^ 2) =
          β' * diff_Q + (β' * (2 * z₁ - z₁ ^ 2) + β' * (2 * z₂ - z₂ ^ 2)) := by
        dsimp [diff_Q]; ring
      rw [hsplit, AddChar.map_add_eq_mul, hψ_diff, one_mul, AddChar.map_add_eq_mul]
    dsimp [Φ]
    change (χ₁ (u₁ * u₂) ^ 2)⁻¹ * ψM₁'_unit (β' * (2 * z₁₂ - z₁₂ ^ 2)) =
      ((χ₁ u₁ ^ 2)⁻¹ * ψM₁'_unit (β' * (2 * z₁ - z₁ ^ 2))) *
        ((χ₁ u₂ ^ 2)⁻¹ * ψM₁'_unit (β' * (2 * z₂ - z₂ ^ 2)))
    rw [map_mul, mul_pow, mul_inv, hψ_Q12, mul_mul_mul_comm]

  have hΦ_triv_m₁ : ∀ u ∈ unitGroup F M₁' m₁, Φ u = 1 := by
    intro u hu
    have h0 := (hχ₁_twists 0 hp_pos).2.1 u hu
    change (ξM₁' u) ^ 0 * χ₁ u = 1 at h0
    rw [pow_zero, one_mul] at h0
    set z : M₁' := (u : M₁') - 1
    have hz : z = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' z := by
      rcases (hunit_ge1_M₁' m₁ hm₁_ge1 u).mp hu with h1 | hge
      · left; exact sub_eq_zero.mpr h1
      · right; exact hge
    have hz2 : z ^ 2 = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (z ^ 2) := by
      rw [sq]
      rcases hval_mul_bound_M₁' (m₁ : ℤ) (m₁ : ℤ) z z hz hz with h0' | hge
      · left; exact h0'
      · right; omega
    have hQz : 2 * z - z ^ 2 = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (2 * z - z ^ 2) := by
      rw [two_mul]
      exact hval_sub_M₁' (m₁ : ℤ) (z + z) (z ^ 2) (hval_add_M₁' (m₁ : ℤ) z z hz hz) hz2
    have hψ_Qz : ψM₁'_unit (β' * (2 * z - z ^ 2)) = 1 := by
      apply Units.ext
      exact hψM₁'_β'_triv (2 * z - z ^ 2) hQz
    dsimp [Φ]
    rw [h0, one_pow, inv_one, one_mul]
    exact hψ_Qz

  have hΦ_norm : ∀ w₀ ∈ unitGroup F K₁ d₁, Φ (Units.map (normLM F hM₁'K₁) w₀) = 1 := by
    intro w₀ hw₀
    set w : K₁ := (w₀ : K₁) - 1
    have hw : w = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w := by
      rcases (hunit_ge1_K₁ d₁ hd₁_ge1 w₀).mp hw₀ with h1 | hge
      · left; exact sub_eq_zero.mpr h1
      · right; exact hge
    have h1w : 1 + w = (w₀ : K₁) := add_sub_cancel 1 (w₀ : K₁)
    obtain ⟨hu₁, hu₂, htr_eq⟩ := hCompat_Δ' w hw
    set u₁ : M₁' := normLM F hM₁'K₁ (1 + w) - 1
    set u₂ : E' := normLM F hE'K₁ (1 + w) - 1
    have hpow_j : (ψM₁' (IntermediateField.inclusion hLM₁' α₀ * b' * (2 * u₁ - u₁ ^ 2))) ^ j =
        (ψE' (IntermediateField.inclusion hLE' α₀ * a' * (2 * u₂ - u₂ ^ 2))) ^ j :=
      congrArg (· ^ j) htr_eq
    rw [← AddChar.map_nsmul_eq_pow, ← AddChar.map_nsmul_eq_pow, nsmul_eq_mul, nsmul_eq_mul] at hpow_j
    have hneg_eq : ∀ {x : M₁'} {y : E'}, ψM₁' x = ψE' y → ψM₁' (-x) = ψE' (-y) := by
      intro x y hxy
      have h1 : ψM₁' (-x) * ψM₁' x = 1 := by
        rw [← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one]
      have h2 : ψE' (-y) * ψE' y = 1 := by
        rw [← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one]
      rw [hxy] at h1
      exact mul_right_cancel₀ (by
        intro h0
        rw [h0, mul_zero] at h2
        exact zero_ne_one h2) (h1.trans h2.symm)
    have hneg_j := hneg_eq hpow_j
    have hLHS_β' : - ((j : M₁') * (IntermediateField.inclusion hLM₁' α₀ * b' * (2 * u₁ - u₁ ^ 2))) =
        β' * (2 * u₁ - u₁ ^ 2) := by
      dsimp [β', x₀_inv_M₁']
      rw [hx₀_inv, map_mul, map_neg, map_natCast]
      ring
    have hRHS_α₀ : - ((j : E') * (IntermediateField.inclusion hLE' α₀ * a' * (2 * u₂ - u₂ ^ 2))) =
        - IntermediateField.inclusion hLE' α₀ * (j : E') * a' * (2 * u₂ - u₂ ^ 2) := by
      ring
    rw [hLHS_β', hRHS_α₀] at hneg_j
    have h1u₂_eq : 1 + u₂ = ((Units.map (normLM F hE'K₁) w₀ : E'ˣ) : E') := by
      dsimp [u₂]
      rw [add_sub_cancel, h1w]
    have hu₂_ne : 1 + u₂ ≠ 0 := by
      rw [h1u₂_eq]
      exact Units.ne_zero _
    have hmk_u₂ : Units.mk0 (1 + u₂) hu₂_ne = Units.map (normLM F hE'K₁) w₀ :=
      Units.ext h1u₂_eq
    have hstat₂ := hΔ'_stat₂ u₂ hu₂ hu₂_ne
    rw [hmk_u₂, ← hneg_j] at hstat₂
    have hχ_eq : χ₂ (Units.map (normLM F hE'K₁) w₀) = χ₁ (Units.map (normLM F hM₁'K₁) w₀) :=
      MonoidHom.ext_iff.mp hχ_comp w₀
    rw [hχ_eq] at hstat₂
    have hu₁_eq : normLM F hM₁'K₁ (w₀ : K₁) - 1 = u₁ := by
      dsimp [u₁]
      rw [h1w]
    dsimp [Φ]
    rw [hu₁_eq]
    apply inv_mul_eq_one.mpr
    apply Units.ext
    exact hstat₂

  obtain ⟨r, hr_lt, hr_coker⟩ := hCoker_M₁' Φ hΦ_mul hΦ_triv_m₁ hΦ_norm
  obtain ⟨_, _, τ, hτ_L, hτ_char⟩ := hχ₁_twists r hr_lt
  obtain ⟨hτ_val, hτ_symm_val, hτ_ψM₁'⟩ := hGalM₁'_inv τ hτ_L
  obtain ⟨τ_lift, hτ_lift_E', _, hτ_lift_val, hτ_lift_norm⟩ := hGalLift τ hτ_L

  set Δ'' : K₁ˣ := Units.map τ_lift.toRingEquiv.toMonoidHom Δ'
  have hΔ''_coe : (Δ'' : K₁) = τ_lift (Δ' : K₁) := rfl
  have hΔ''_val : valL F K₁ (Δ'' : K₁) = -((bM₁' - 1 : ℕ) : ℤ) := by
    rw [hΔ''_coe, hτ_lift_val, hΔ'_val]
  have hΔ''_normE' : normLM F hE'K₁ (Δ'' : K₁) = normLM F hE'K₁ (Δ' : K₁) :=
    (hτ_lift_norm (Δ' : K₁)).1
  have hΔ''_normM₁' : normLM F hM₁'K₁ (Δ'' : K₁) = τ b' :=
    (hτ_lift_norm (Δ' : K₁)).2
  have hΔ''_as :
      (Δ'' : K₁) ^ p - (Δ'' : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ'' : K₁)) = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ'' : K₁) ^ p - (Δ'' : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ'' : K₁))) := by
    have hmap_as : (Δ'' : K₁) ^ p - (Δ'' : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ'' : K₁)) =
      τ_lift ((Δ' : K₁) ^ p - (Δ' : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁))) := by
      rw [hΔ''_normE', hΔ''_coe, map_sub, map_sub, map_pow, hτ_lift_E']
    rcases hΔ'_as with h0 | hge
    · left
      rw [hmap_as, h0, map_zero]
    · right
      rw [hmap_as, hτ_lift_val]
      exact hge

  have hΔ''_stat₁ : ∀ z : M₁', (z = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (χ₁ (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          ψM₁' (x₀_inv_M₁' * normLM F hM₁'K₁ (Δ'' : K₁) * (2 * z - z ^ 2)) := by
    intro z hz hz_ne
    set z' : M₁' := τ.symm z
    have hz' : z' = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' z' := by
      rcases hz with rfl | hz_ge
      · left; exact map_zero τ.symm
      · right; rw [hτ_symm_val z]; exact hz_ge
    have h1z'_eq : 1 + z' = τ.symm (1 + z) := by
      dsimp [z']
      rw [map_add, map_one]
    have hz'_ne : 1 + z' ≠ 0 := by
      rw [h1z'_eq]
      exact (map_ne_zero τ.symm).mpr hz_ne
    let u' : M₁'ˣ := Units.mk0 (1 + z') hz'_ne
    have hu'_sub1 : (u' : M₁') - 1 = z' := add_sub_cancel_left 1 z'
    have hu'_mem : u' ∈ unitGroup F M₁' d₁ := by
      rw [hunit_ge1_M₁' d₁ hd₁_ge1 u', hu'_sub1]
      rcases hz' with h0 | hge
      · left; change 1 + z' = 1; rw [h0, add_zero]
      · right; exact hge
    have hτ_u' : Units.map τ.toRingEquiv.toMonoidHom u' = Units.mk0 (1 + z) hz_ne := by
      apply Units.ext
      change τ (1 + z') = 1 + z
      rw [h1z'_eq, τ.apply_symm_apply]
    have hchar_u' := hτ_char u'
    rw [hτ_u'] at hchar_u'
    have hcoker_u' := hr_coker u' hu'_mem
    have hΦ_u' : ((ξM₁' ^ r * χ₁) u' : Ω F) ^ 2 =
        ψM₁' (β' * (2 * z' - z' ^ 2)) := by
      have h1 : ψM₁'_unit (β' * (2 * ((u' : M₁') - 1) - ((u' : M₁') - 1) ^ 2)) =
          ((ξM₁' ^ r * χ₁) u') ^ 2 := by
        have h2 : (χ₁ u' ^ 2)⁻¹ *
            ψM₁'_unit (β' * (2 * ((u' : M₁') - 1) - ((u' : M₁') - 1) ^ 2)) =
            ((ξM₁' ^ 2) u') ^ r := hcoker_u'
        rw [inv_mul_eq_iff_eq_mul] at h2
        rw [h2, MonoidHom.mul_apply, mul_pow]
        change (χ₁ u') ^ 2 * ((ξM₁' u') ^ 2) ^ r = ((ξM₁' u') ^ r) ^ 2 * (χ₁ u') ^ 2
        rw [← pow_mul, mul_comm 2 r, pow_mul, mul_comm]
      have hval := congrArg Units.val h1
      simpa [ψM₁'_unit, hu'_sub1] using hval.symm
    rw [← hchar_u', hΦ_u', ← hτ_ψM₁' (β' * (2 * z' - z' ^ 2))]
    congr 1
    dsimp [β', x₀_inv_M₁']
    rw [hΔ''_normM₁', map_mul, map_mul, hτ_L (((x₀⁻¹ : Lˣ) : L)),
      map_sub, map_mul, map_ofNat, map_pow, τ.apply_symm_apply]

  
  have hMC_Δ'' := hModelCompat_all Δ'' hΔ''_val hΔ''_as
  have ha''_val : valL F E' (normLM F hE'K₁ (Δ'' : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) := hMC_Δ''.1
  have hb''_val : valL F M₁' (normLM F hM₁'K₁ (Δ'' : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) := hMC_Δ''.2.1
  have hTrNormCongr := hMC_Δ''.2.2.2.1

  let a''_u : E'ˣ := Units.map (normLM F hE'K₁) Δ''
  let b''_u : M₁'ˣ := Units.map (normLM F hM₁'K₁) Δ''
  let x₀_E' : E'ˣ := Units.map (IntermediateField.inclusion hLE').toMonoidHom x₀
  let x₀_M₁' : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x₀
  let cE' : E'ˣ := x₀_E' * a''_u⁻¹
  let cM₁' : M₁'ˣ := x₀_M₁' * b''_u⁻¹

  have hcE'_inv_coe : ((cE'⁻¹ : E'ˣ) : E') =
      IntermediateField.inclusion hLE' (((x₀⁻¹ : Lˣ) : L)) * normLM F hE'K₁ (Δ'' : K₁) := by
    have h1 : cE'⁻¹ = a''_u * x₀_E'⁻¹ := by
      dsimp [cE']
      rw [mul_inv_rev, inv_inv]
    rw [h1, Units.val_mul, ← map_inv (Units.map (IntermediateField.inclusion hLE').toMonoidHom)]
    change normLM F hE'K₁ (Δ'' : K₁) * IntermediateField.inclusion hLE' (((x₀⁻¹ : Lˣ) : L)) = _
    ring
  have hcM₁'_inv_coe : ((cM₁'⁻¹ : M₁'ˣ) : M₁') =
      x₀_inv_M₁' * normLM F hM₁'K₁ (Δ'' : K₁) := by
    have h1 : cM₁'⁻¹ = b''_u * x₀_M₁'⁻¹ := by
      dsimp [cM₁']
      rw [mul_inv_rev, inv_inv]
    rw [h1, Units.val_mul, ← map_inv (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom)]
    change normLM F hM₁'K₁ (Δ'' : K₁) * x₀_inv_M₁' = _
    ring

  refine ⟨cE', cM₁', ?_, ?_, ?_, ?_, ?_⟩
  · 
    change valL F E' (((x₀_E' * a''_u⁻¹ : E'ˣ) : E')) = (m₂ : ℤ) + condExpChar F E' ψE'
    rw [Units.val_mul, hval_mul_E' _ _ (Units.ne_zero _) (Units.ne_zero _), hval_inv_E' a''_u]
    change valL F E' (IntermediateField.inclusion hLE' (x₀ : L)) +
      (- valL F E' (normLM F hE'K₁ (Δ'' : K₁))) = (m₂ : ℤ) + condExpChar F E' ψE'
    rw [hval_LE', hx₀_val, ha''_val, hbM₁'_sub1_cast, hnE'_eq, hm₂_cast, hp_sub1_cast]
    ring
  · 
    intro x hx hx_ne
    rw [hcE'_inv_coe, hΔ''_normE', hΔ'_stat₂ x hx hx_ne]
    congr 1
    rw [hx₀_inv, map_mul, map_neg, map_natCast]
    ring
  · 
    change valL F M₁' (((x₀_M₁' * b''_u⁻¹ : M₁'ˣ) : M₁')) = (m₁ : ℤ) + condExpChar F M₁' ψM₁'
    rw [Units.val_mul, hval_mul_M₁' _ _ (Units.ne_zero _) (Units.ne_zero _), hval_inv_M₁' b''_u]
    change valL F M₁' (IntermediateField.inclusion hLM₁' (x₀ : L)) +
      (- valL F M₁' (normLM F hM₁'K₁ (Δ'' : K₁))) = (m₁ : ℤ) + condExpChar F M₁' ψM₁'
    rw [hval_LM₁', hx₀_val, hb''_val, hbM₁'_sub1_cast, hnM₁'_eq, hm₁_cast, hp_sub1_cast]
    ring
  · 
    intro z hz hz_ne
    rw [hcM₁'_inv_coe]
    exact hΔ''_stat₁ z hz hz_ne
  · 
    have hχ_c : χ₂ cE' = χ₁ cM₁' := by
      dsimp [cE', cM₁']
      rw [map_mul, map_inv, map_mul, map_inv]
      have h1 : χ₂ x₀_E' = χ₁ x₀_M₁' := hχ_rest x₀
      have h2 : χ₂ a''_u = χ₁ b''_u := MonoidHom.ext_iff.mp hχ_comp Δ''
      rw [h1, h2]
    have hψ_c : ψE' (((cE'⁻¹ : E'ˣ) : E') * 2) = ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2) := by
      have hE'_arg : ((cE'⁻¹ : E'ˣ) : E') * 2 =
          IntermediateField.inclusion hLE' (((x₀⁻¹ : Lˣ) : L) * 2) *
            normLM F hE'K₁ (Δ'' : K₁) := by
        rw [hcE'_inv_coe, map_mul, map_ofNat]
        ring
      have hM₁'_arg : ((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2 =
          IntermediateField.inclusion hLM₁' (((x₀⁻¹ : Lˣ) : L) * 2) *
