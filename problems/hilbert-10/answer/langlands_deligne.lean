  have hP_res_gen : ∀ z₀ : M_C, PM 0 z₀ →
      PM 0 (P_poly z₀) ∧
        resM (P_poly z₀) =
          (resM z₀) ^ q + ∑ m : Fin r_exp, a_bar m * ((resM z₀) ^ ((p F) ^ (m : ℕ))) := by
    intro z₀ hz₀
    have hterm : ∀ m : Fin r_exp,
        PM 0 (a_coeff m * z₀ ^ ((p F) ^ (m : ℕ))) ∧
          resM (a_coeff m * z₀ ^ ((p F) ^ (m : ℕ))) =
            a_bar m * (resM z₀) ^ ((p F) ^ (m : ℕ)) := by
      intro m
      have hm_pow := hresM_pow z₀ ((p F) ^ (m : ℕ)) hz₀
      have hm_int : PM 0 (a_coeff m * z₀ ^ ((p F) ^ (m : ℕ))) := by
        simpa using hPM_mul (ha_int m) hm_pow.1
      refine ⟨hm_int, ?_⟩
      rw [(hresM_ring (a_coeff m) (z₀ ^ ((p F) ^ (m : ℕ))) (ha_int m) hm_pow.1).2.1, hm_pow.2]
    have hsum := @hresM_sum (Fin r_exp) Finset.univ
      (fun m : Fin r_exp => a_coeff m * z₀ ^ ((p F) ^ (m : ℕ)))
      (fun m _ => (hterm m).1)
    have hzq := hresM_pow z₀ q hz₀
    have hP_int : PM 0 (P_poly z₀) := by
      rw [hP_def z₀]
      exact hPM_add hzq.1 hsum.1
    refine ⟨hP_int, ?_⟩
    rw [hP_def z₀, (hresM_ring (z₀ ^ q) _ hzq.1 hsum.1).1, hzq.2, hsum.2]
    refine congrArg ((resM z₀) ^ q + ·) (Finset.sum_congr rfl fun m _ => (hterm m).2)

  have hβ_P : ∀ j : Fin (q - 1), ∀ z : k_M,
      ψ_M (β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ ((p F) ^ (m : ℕ))))) = 1 := by
    intro j z
    set z₀ := liftM z
    have hz₀ : PM 0 z₀ := hliftM_int z
    have hP := hP_res_gen z₀ hz₀
    have hu_int : PM 0 (u_all_0 j : M_C) := hU0_int (hu_all_0_val j)
    have huP_int : PM 0 ((u_all_0 j : M_C) * P_poly z₀) := by
      simpa using hPM_mul hu_int hP.1
    have huP_res : resM ((u_all_0 j : M_C) * P_poly z₀) =
        β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ ((p F) ^ (m : ℕ)))) := by
      rw [(hresM_ring (u_all_0 j : M_C) (P_poly z₀) hu_int hP.1).2.1, hP.2, hliftM_res z]
    rw [← huP_res, hψM_spec ((u_all_0 j : M_C) * P_poly z₀) huP_int]
    exact hu_all_0_P j z₀ hz₀

  have hp_prime : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
  haveI : Fact (Nat.Prime (p F)) := ⟨hp_prime⟩
  have hring_kM : ringChar k_M = p F := by
    have hdvd : ringChar k_M ∣ p F := (ringChar.spec k_M (p F)).mp hp_kM
    rcases (Nat.dvd_prime hp_prime).mp hdvd with h1 | h_eq
    · exfalso
      have h0 : ((1 : ℕ) : k_M) = 0 := (ringChar.spec k_M 1).mpr (h1 ▸ dvd_refl _)
      rw [Nat.cast_one] at h0
      exact one_ne_zero h0
    · exact h_eq
  haveI : CharP k_M (p F) := CharP.mk (fun x => by rw [← hring_kM]; exact ringChar.spec k_M x)
  have hfrob_add_kM : ∀ x y : k_M, (x + y) ^ q = x ^ q + y ^ q := by
    intro x y
    change (x + y) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) =
      x ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
        y ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    rw [hq_pow]
    exact add_pow_char_pow x y (p F) r_exp
  have hfrob_inj_kM : Function.Injective (fun x : k_M => x ^ q) := by
    intro x y hxy
    dsimp at hxy
    have hsub : (x - y) ^ q + y ^ q = y ^ q := by
      rw [← hfrob_add_kM (x - y) y, sub_add_cancel, hxy]
    have hsub0 : (x - y) ^ q = 0 := by linear_combination hsub
    exact sub_eq_zero.mp (pow_eq_zero hsub0)
  have hfrob_surj_kM : Function.Surjective (fun x : k_M => x ^ q) :=
    ((Fintype.bijective_iff_injective_and_card (fun x : k_M => x ^ q)).mpr
      ⟨hfrob_inj_kM, rfl⟩).2
  obtain ⟨w₀_M, hw₀_M⟩ := hψM_ne
  have horth_M : ∀ w : k_M, w ≠ 0 → (∑ b : k_M, ψ_M (- b * w)) = 0 := by
    intro w hw
    have hshift : (∑ b : k_M, ψ_M (- b * w)) = (∑ b : k_M, ψ_M (- b * w)) * ψ_M w₀_M := by
      conv_lhs =>
        rw [← Fintype.sum_equiv (Equiv.addRight (- w⁻¹ * w₀_M)) _ _ (fun _ => rfl)]
      have hterm : ∀ b : k_M, ψ_M (- (b + (- w⁻¹ * w₀_M)) * w) = ψ_M (- b * w) * ψ_M w₀_M := by
        intro b
        have hbw : - (b + (- w⁻¹ * w₀_M)) * w = - b * w + w₀_M := by
          calc - (b + (- w⁻¹ * w₀_M)) * w
              = - b * w + (w * w⁻¹) * w₀_M := by ring
            _ = - b * w + w₀_M := by rw [mul_inv_cancel₀ hw, one_mul]
        rw [hbw, hψM_add]
      simp_rw [Equiv.coe_addRight, hterm, ← Finset.sum_mul]
    have hzero : (∑ b : k_M, ψ_M (- b * w)) * (ψ_M w₀_M - 1) = 0 := by
      linear_combination -hshift
    exact (mul_eq_zero.mp hzero).resolve_right (sub_ne_zero.mpr hw₀_M)
  have hq_ne0 : q ≠ 0 := by
    change Module.finrank M_C (IntermediateField.extendScalars hM_CK) ≠ 0
    rw [hq_pow]
    exact pow_ne_zero r_exp hp_prime.ne_zero
  let S_M : k_M → Ω F := fun b => ∑ w : k_M, ψ_M (w ^ q) * ψ_M (- b * w)
  have hsum_SM : (∑ b : k_M, S_M b) = (Fintype.card k_M : Ω F) := by
    dsimp only [S_M]
    rw [Finset.sum_comm]
    have hinner : ∀ w : k_M,
        (∑ b : k_M, ψ_M (w ^ q) * ψ_M (- b * w)) =
          ψ_M (w ^ q) * ∑ b : k_M, ψ_M (- b * w) :=
      fun w => (Finset.mul_sum Finset.univ (fun b => ψ_M (- b * w)) (ψ_M (w ^ q))).symm
    simp_rw [hinner]
    rw [Finset.sum_eq_single (0 : k_M)]
    · simp [zero_pow hq_ne0, hψM_0]
    · intro w _ hw
      rw [horth_M w hw, mul_zero]
    · intro h0
      exact False.elim (h0 (Finset.mem_univ 0))
  have hsum_SM_ne : (∑ b : k_M, S_M b) ≠ 0 := by
    rw [hsum_SM]
    exact Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  obtain ⟨α_M, _, hS_αM⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum_SM_ne
  have hαM_frob : ∀ w : k_M, ψ_M (α_M * w) = ψ_M (w ^ q) := by
    intro u_w
    have hshift : S_M α_M = S_M α_M * (ψ_M (u_w ^ q) * ψ_M (- α_M * u_w)) := by
      dsimp only [S_M]
      conv_lhs =>
        rw [← Fintype.sum_equiv (Equiv.addRight u_w) _ _ (fun _ => rfl)]
      have hterm : ∀ w : k_M,
          ψ_M ((w + u_w) ^ q) * ψ_M (- α_M * (w + u_w)) =
            (ψ_M (w ^ q) * ψ_M (- α_M * w)) * (ψ_M (u_w ^ q) * ψ_M (- α_M * u_w)) := by
        intro w
        have hαu : - α_M * (w + u_w) = - α_M * w + (- α_M * u_w) := by ring
        rw [hfrob_add_kM w u_w, hψM_add, hαu, hψM_add]
        ring
      simp_rw [Equiv.coe_addRight, hterm, ← Finset.sum_mul]
    have h_factor_zero : S_M α_M * (ψ_M (u_w ^ q) * ψ_M (- α_M * u_w) - 1) = 0 := by
      linear_combination -hshift
    have h_prod_one : ψ_M (u_w ^ q) * ψ_M (- α_M * u_w) = 1 :=
      sub_eq_zero.mp ((mul_eq_zero.mp h_factor_zero).resolve_left hS_αM)
    have hψ_mul_neg : ψ_M (α_M * u_w) * ψ_M (- α_M * u_w) = 1 := by
      have hneg : α_M * u_w + (- α_M * u_w) = 0 := by ring
      rw [← hψM_add, hneg, hψM_0]
    symm
    calc ψ_M (u_w ^ q)
        = ψ_M (u_w ^ q) * (ψ_M (α_M * u_w) * ψ_M (- α_M * u_w)) := by rw [hψ_mul_neg, mul_one]
      _ = (ψ_M (u_w ^ q) * ψ_M (- α_M * u_w)) * ψ_M (α_M * u_w) := by ring
      _ = ψ_M (α_M * u_w) := by rw [h_prod_one, one_mul]
  have hαM_ne : α_M ≠ 0 := by
    intro h0
    obtain ⟨u₀, hu₀⟩ := hfrob_surj_kM w₀_M
    have h1 : ψ_M w₀_M = 1 := by
      rw [← hu₀, ← hαM_frob u₀, h0, zero_mul, hψM_0]
    exact hw₀_M h1
  have ha0_ne : a_bar ⟨0, hr_exp_pos⟩ ≠ 0 :=
    (ld_ch14_finite_field_adjoint_vieta_root_product F k_M (p F) r_exp q hp_prime
      hr_exp_pos hq_pow hp_kM ψ_M hψM_0 hψM_add ⟨w₀_M, hw₀_M⟩ α_M hαM_ne hαM_frob
      a_bar β hβ_inj hβ_ne hβ_P).1

  
  have hValAlgFiL : ∀ (i : Fin D_orb.length) (x : L),
      valL F (D_orb.get i).field (IntermediateField.inclusion (D_orb.get i).le x) =
