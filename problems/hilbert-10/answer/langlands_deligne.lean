theorem ld_wild_mid_cond_stationary_params_and_rhs_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hRam : condExp F L ν₁ ≠ 0)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hroot_exh : ∀ u₁ : Lˣ, ν₁ u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ,
      ξ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1 →
      ∃ k < Module.finrank L (IntermediateField.extendScalars hLK), (ν₁ u₁) ^ k = ξ)
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (hba : condExp F L ν₁ < condExp F L χ')
    (ha2b : condExp F L χ' < 2 * condExp F L ν₁)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      condExp F L ν₁ +
        Module.finrank L (IntermediateField.extendScalars hLK) *
          (condExp F L χ' - condExp F L ν₁))
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L (ν₁ ^ j * χ') = condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (htr_surj : ∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x +
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let b := condExp F L ν₁
    let a := condExp F L χ'
    let a_K := condExp F K (χ'.comp (Units.map (normLM F hLK)))
    condExp F L ν₁ = t + 1 ∧
    ((p : L) = 0 ∨ (((p - 1) * b / p : ℕ) : ℤ) ≤ valL F L (p : L)) ∧
    ∃ (R_L : Finset L) (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ),
      R_L.card = Fintype.card k_L ∧
      (∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r) ∧
      (∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r)) ∧
      valL F L (c_χ' : L) = (a : ℤ) + condExpChar F L ψ ∧
      ν₁ c_χ' = 1 ∧
      (∀ x : L, (x = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x)) ∧
      valL F L (c_ν₁ : L) = (b : ℤ) + condExpChar F L ψ ∧
      ν₁ c_ν₁ = 1 ∧
      (∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x)) ∧
      δ = c_χ' * c_ν₁⁻¹ ∧
      Units.map (normLM F hLK) u_K = δ ∧
      valL F K (u_K : K) = ((a - b : ℕ) : ℤ) ∧
      valL F L (δ : L) = ((a - b : ℕ) : ℤ) ∧
      (∀ z : K, (z = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
        ψ (((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z) =
          ψ (- ((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z)) ∧
      (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K) ∧
      c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹ ∧
      valL F K (c_K : K) = (a_K : ℤ) + condExpChar F K (traceChar F hLK ψ) ∧
      (∀ y : K, (y = 0 ∨ (((a_K + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
        ∀ hy : 1 + y ≠ 0,
          ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y)) ∧
      (∀ j < p, ∀ τ : L, (τ = 0 ∨ 0 ≤ valL F L τ) →
        (τ - (j : L) = 0 ∨ (((p - 1) * b / p : ℕ) : ℤ) ≤ valL F L (τ - (j : L))) →
        ∃ u_τ : Lˣ,
          (u_τ : L) = 1 + τ * (δ : L) ∧
          tateEps F L (ν₁ ^ j * χ') ψ =
            (((ν₁ ^ j * χ') u_τ : Ω F)⁻¹) *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * τ * (δ : L)) *
              tateEps F L χ' ψ) :=
by
  intro p b a a_K
  let K' := IntermediateField.extendScalars hLK
  set n := condExpChar F L ψ
  set ψ_K := traceChar F hLK ψ
  set n_K := condExpChar F K ψ_K
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hb_ge2' : 2 ≤ b := hb_ge2
  have hba' : b < a := hba
  have ha2b' : a < 2 * b := ha2b
  have ha_ge2 : 2 ≤ a := by omega
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, hval_surj_K, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  obtain ⟨ϖ_L, hϖ_L⟩ := hval_surj_L 1
  obtain ⟨ϖ_K, hϖ_K⟩ := hval_surj_K 1
  have hψ_triv : ∀ x : L, (x = 0 ∨ -n ≤ valL F L x) → ψ x = 1 := (hSpecL 1).1
  have hψK_triv : ∀ y : K, (y = 0 ∨ -n_K ≤ valL F K y) → ψ_K y = 1 := (hSpecK 1).1
  have hψK_app : ∀ y : K, ψ_K y = ψ (traceLM F hLK y) := fun _ => rfl
  have hval_pow_L : ∀ (u : Lˣ) (k : ℕ), valL F L (((u ^ k : Lˣ) : L)) = (k : ℤ) * valL F L (u : L) := by
    intro u k
    induction k with
    | zero => simp [hval1_L]
    | succ k ih =>
      rw [pow_succ', Units.val_mul, hval_mul_L (u : L) _ (Units.ne_zero u) (Units.ne_zero _), ih]
      push_cast; ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rw [hval_mul_L x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega
  have hval_mul_ge_K : ∀ (k₁ k₂ : ℤ) (x y : K),
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rw [hval_mul_K x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega
  have hval_sub_ge_L : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    have hny : -y = 0 ∨ k ≤ valL F L (-y) := by
      rcases hy with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_L]; exact hge
    exact hval_add_L k x (-y) hx hny
  have hval_sub_ge_K : ∀ (k : ℤ) (x y : K),
      (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
        (x - y = 0 ∨ k ≤ valL F K (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    have hny : -y = 0 ∨ k ≤ valL F K (-y) := by
      rcases hy with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_K]; exact hge
    exact hval_add_K k x (-y) hx hny
  have hval_le_L : ∀ {k₁ k₂ : ℤ} {x : L},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hval_le_K : ∀ {k₁ k₂ : ℤ} {y : K},
      k₁ ≤ k₂ → (y = 0 ∨ k₂ ≤ valL F K y) → (y = 0 ∨ k₁ ≤ valL F K y) := by
    intro k₁ k₂ y hle hy
    rcases hy with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have h1_add_ne_zero_L : ∀ {x : L}, (x = 0 ∨ 1 ≤ valL F L x) → 1 + x ≠ 0 := by
    intro x hx h0
    have h1_eq : (1 : L) = -x := eq_neg_of_add_eq_zero_left h0
    rcases hx with hx0 | hge
    · rw [hx0, neg_zero] at h1_eq; exact one_ne_zero h1_eq
    · have hv : valL F L (1 : L) = valL F L x := by rw [h1_eq, hval_neg_L]
      rw [hval1_L] at hv; omega
  have h1_add_ne_zero_K : ∀ {y : K}, (y = 0 ∨ 1 ≤ valL F K y) → 1 + y ≠ 0 := by
    intro y hy h0
    have h1_eq : (1 : K) = -y := eq_neg_of_add_eq_zero_left h0
    rcases hy with hy0 | hge
    · rw [hy0, neg_zero] at h1_eq; exact one_ne_zero h1_eq
    · have hv : valL F K (1 : K) = valL F K y := by rw [h1_eq, hval_neg_K]
      rw [hval1_K] at hv; omega
  have hnorm_zero : normLM F hLK 0 = 0 := by
    by_contra h0
    have hϖ_norm_ne : normLM F hLK (ϖ_K : K) ≠ 0 :=
      Units.ne_zero (Units.map (normLM F hLK) ϖ_K)
    have h1 : normLM F hLK 0 = normLM F hLK 0 * normLM F hLK (ϖ_K : K) := by
      calc normLM F hLK 0
        _ = normLM F hLK (0 * (ϖ_K : K)) := by rw [zero_mul]
        _ = normLM F hLK 0 * normLM F hLK (ϖ_K : K) := map_mul (normLM F hLK) 0 (ϖ_K : K)
    have h2 : valL F L (normLM F hLK 0) = valL F L (normLM F hLK 0) + 1 := by
      conv_lhs => rw [h1]
      rw [hval_mul_L _ _ h0 hϖ_norm_ne, hval_norm (ϖ_K : K), hϖ_K]
    omega
  have hnorm_val_ge : ∀ (k : ℤ) (y : K),
      (y = 0 ∨ k ≤ valL F K y) →
        (normLM F hLK y = 0 ∨ k ≤ valL F L (normLM F hLK y)) := by
    intro k y hy
    rcases hy with hy0 | hge
    · exact Or.inl (by rw [hy0, hnorm_zero])
    · right; rw [hval_norm y]; exact hge
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have htrace_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    intro x y
    letI : Module L L := Semiring.toModule
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * Algebra.trace L K' (toExtendScalars F hLK y)
    rw [map_mul, hto_inc x, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  set N_t : ℤ := (p : ℤ) * n + ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ)
  have hnK_le_Nt : n_K ≤ N_t := by
    obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩ := (hSpecL 1).2.1
    obtain ⟨y₁, hy₁_tr, _, hy₁_ne_prop⟩ := htr_surj x₁
    obtain ⟨hy₁_ne0, hy₁_val_eq⟩ := hy₁_ne_prop hx₁_ne0
    have hy₁_ψ : ψ_K y₁ ≠ 1 := by rw [hψK_app, hy₁_tr]; exact hx₁_ψ
    have hy₁_val : -(N_t + 1) ≤ valL F K y₁ := by
      change valL F K y₁ =
        (p : ℤ) * valL F L x₁ + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) at hy₁_val_eq
      rw [hy₁_val_eq]
      have hmul : (p : ℤ) * (-(n + 1)) ≤ (p : ℤ) * valL F L x₁ :=
        mul_le_mul_of_nonneg_left hx₁_val (by omega)
      dsimp [N_t]
      rw [hp_sub1_int] at *
      linarith
    by_contra hlt
    have htriv : ψ_K y₁ = 1 := hψK_triv y₁ (Or.inr (by omega))
    exact hy₁_ψ htriv
  have hNt_le_nK : N_t ≤ n_K := by
    obtain ⟨y₂, hy₂_ne0, hy₂_val, hy₂_ψ⟩ := (hSpecK 1).2.1
    by_contra hlt
    have hbound : (p : ℤ) * (-n) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K y₂ := by
      change -(n_K + 1) ≤ valL F K y₂ at hy₂_val
      dsimp [N_t] at hlt
      linarith
    have htr_val := htr_bound (-n) y₂ (Or.inr hbound)
    have htriv : ψ_K y₂ = 1 := by
      rw [hψK_app]
      exact hψ_triv (traceLM F hLK y₂) htr_val
    exact hy₂_ψ htriv
