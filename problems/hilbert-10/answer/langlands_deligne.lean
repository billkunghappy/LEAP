    ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
      _, hval_add_E', _, _, _⟩
  obtain ⟨c, hq₂_eq, hq₂_iff⟩ := hBasis_E' q₂
  have hc_all := (hq₂_iff 0).mp hq₂_int
  have hc0_int : c 0 = 0 ∨ 0 ≤ valL F L (c 0) := by
    rcases hc_all 0 with h0 | hge
    · exact Or.inl h0
    · right
      change 0 ≤ 2 * valL F L (c 0) + (0 : ℤ) at hge
      omega
  have hc1_ge1 : c 1 = 0 ∨ 1 ≤ 2 * valL F L (c 1) + 1 := by
    rcases hc_all 1 with h0 | hge
    · exact Or.inl h0
    · right
      change 0 ≤ 2 * valL F L (c 1) + (1 : ℤ) at hge
      omega
  set lam₂ : k_L := resL (c 0)
  have hc0_lift : IntermediateField.inclusion hLE' (liftL lam₂) -
      IntermediateField.inclusion hLE' (c 0) = 0 ∨
      1 ≤ valL F E' (IntermediateField.inclusion hLE' (liftL lam₂) -
        IntermediateField.inclusion hLE' (c 0)) := by
    rw [← map_sub]
    have hsub_int : liftL lam₂ - c 0 = 0 ∨ 0 ≤ valL F L (liftL lam₂ - c 0) :=
      hval_sub_L 0 (liftL lam₂) (c 0) (hliftL lam₂).1 hc0_int
    have hsub_val1 : liftL lam₂ - c 0 = 0 ∨ 1 ≤ valL F L (liftL lam₂ - c 0) := by
      apply (hresL_ker _ hsub_int).mp
      rw [hresL_sub _ _ (hliftL lam₂).1 hc0_int, (hliftL lam₂).2, sub_self]
    rcases hsub_val1 with h0 | hge1
    · left; rw [h0, map_zero]
    · right; rw [hval_LE']; omega
  have hq₂_c0 : IntermediateField.inclusion hLE' (c 0) - q₂ = 0 ∨
      1 ≤ valL F E' (IntermediateField.inclusion hLE' (c 0) - q₂) := by
    have heq : IntermediateField.inclusion hLE' (c 0) - q₂ =
        -(IntermediateField.inclusion hLE' (c 1) * (ϖ_E' : E')) := by
      rw [hq₂_eq, Fin.sum_univ_two]
      change IntermediateField.inclusion hLE' (c 0) -
        (IntermediateField.inclusion hLE' (c 0) * (ϖ_E' : E') ^ (0 : ℕ) +
          IntermediateField.inclusion hLE' (c 1) * (ϖ_E' : E') ^ (1 : ℕ)) = _
      rw [pow_zero, pow_one, mul_one]; ring
    rw [heq]
    rcases eq_or_ne (c 1) 0 with h0 | hne0
    · left; rw [h0, map_zero, zero_mul, neg_zero]
    · right
      rw [hval_neg_E']
      have hge1 := hc1_ge1.resolve_left hne0
      have hι_ne : IntermediateField.inclusion hLE' (c 1) ≠ 0 :=
        (map_ne_zero_iff _ (IntermediateField.inclusion hLE').injective).mpr hne0
      rw [hval_mul_E' _ _ hι_ne (Units.ne_zero ϖ_E'), hval_LE', hϖ_E']
      exact hge1
  have hlam₂_q₂ : IntermediateField.inclusion hLE' (liftL lam₂) - q₂ = 0 ∨
      1 ≤ valL F E' (IntermediateField.inclusion hLE' (liftL lam₂) - q₂) := by
    have heq : IntermediateField.inclusion hLE' (liftL lam₂) - q₂ =
        (IntermediateField.inclusion hLE' (liftL lam₂) - IntermediateField.inclusion hLE' (c 0)) +
          (IntermediateField.inclusion hLE' (c 0) - q₂) := by ring
    rw [heq]
    exact hval_add_E' 1 _ _ hc0_lift hq₂_c0
  obtain ⟨hlam₂_res, hPull_E'⟩ := hBranch_E' lam₂ hlam₂_q₂
  refine ⟨δ₁, δ₂, lam₁, lam₂, ?_, ?_,
    hCH_gen M₁' hM₁'K₁ hdegM₁'K₁_2 π,
    hCH_gen E' hE'K₁ hdegE'K₁_2 π,
    hlam₁_res, hlam₂_res, ?_⟩
  · rw [hδ₁_t₂, hd₁_eq]
  · rw [hδ₂_t₂, hd₂_eq]
  · intro b
    have hz_int : IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b)) = 0 ∨
        0 ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b))) := by
      rcases (hliftL b).1 with h0 | hge
      · left; rw [h0, map_zero, map_zero]
      · right; rw [hval_E'K₁, hval_LE']; omega
    refine ⟨hz_int, fun hz => ⟨?_, ?_⟩⟩
    · rw [hr₀₁_eq]; push_cast
      exact hPull_M₁' b hz
    · rw [hr₀₂_eq]; push_cast
      exact hPull_E' b hz

theorem ld_ch12_wild_dyadic_even_breaks_equal_jump_diff_and_distinct_roots (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (heq : condExp F L νM₁' = condExp F L νE')
    (hval_normK₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w ∧
      valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = 2 * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = 2 * valL F M₁' z)
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (liftL : k_L → L)
    (hliftL_0 : liftL 0 = 0)
    (hliftL : ∀ a : k_L, (liftL a = 0 ∨ 0 ≤ valL F L (liftL a)) ∧ resL (liftL a) = a)
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ 2 * m - (condExp F L νM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ 2 * m - (2 * (condExp F L νE' : ℤ) - (condExp F L νM₁' : ℤ)) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (ϖ_K₁ : K₁ˣ) (hϖ_K₁ : valL F K₁ (ϖ_K₁ : K₁) = 1)
    (hBasis_K₁ : ∀ w : K₁, ∃ c : Fin 2 → E',
      w = ∑ i : Fin 2, IntermediateField.inclusion hE'K₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin 2, c i = 0 ∨ m ≤ 2 * valL F E' (c i) + (i : ℤ))
    (G_K₁ : Type u) [Group G_K₁] [Fintype G_K₁]
    (act_K₁ : G_K₁ → K₁ → K₁)
    (hcard_GK₁ : Fintype.card G_K₁ = 2)
    (hactK₁_one : ∀ w : K₁, act_K₁ 1 w = w)
    (hactK₁_ring : ∀ σ : G_K₁,
      act_K₁ σ 0 = 0 ∧ act_K₁ σ 1 = 1 ∧
      (∀ w₁ w₂ : K₁,
        act_K₁ σ (w₁ + w₂) = act_K₁ σ w₁ + act_K₁ σ w₂ ∧
        act_K₁ σ (w₁ * w₂) = act_K₁ σ w₁ * act_K₁ σ w₂ ∧
        act_K₁ σ (-w₁) = -act_K₁ σ w₁))
    (hactK₁_val : ∀ (σ : G_K₁) (w : K₁), valL F K₁ (act_K₁ σ w) = valL F K₁ w)
    (hactK₁_trace : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G_K₁, act_K₁ σ w)
    (hjump_K₁ : ∀ τ : G_K₁, τ ≠ 1 →
      (ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁) ≠ 0 ∧
      valL F K₁ ((ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁)) = (condExp F L νM₁' : ℤ))
    (τ₁ : M₁' ≃ₐ[F] M₁')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hGalLift_τ : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁')
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hx_tr : traceLM F hLM₁' x = -1)
    (hx_conj : τ₁ x = -1 - x)
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (hCH₁ : (ϖ_K₁ : K₁) ^ 2 -
      IntermediateField.inclusion hM₁'K₁ (traceLM F hM₁'K₁ (ϖ_K₁ : K₁)) * (ϖ_K₁ : K₁) +
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (ϖ_K₁ : K₁)) = 0)
    (hCH₂ : (ϖ_K₁ : K₁) ^ 2 -
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ (ϖ_K₁ : K₁)) * (ϖ_K₁ : K₁) +
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (ϖ_K₁ : K₁)) = 0)
    (lam₁ lam₂ : k_L)
    (hlam₁_res :
      let r := condExp F L νE' / 2
      let T₁' := traceLM F hM₁'K₁ (ϖ_K₁ : K₁)
      let Pi₁ := normLM F hM₁'K₁ (ϖ_K₁ : K₁)
      IntermediateField.inclusion hLM₁' (liftL lam₁) - (-1 : M₁') ^ (r - 1) * (Pi₁ ^ r)⁻¹ * T₁' = 0 ∨
        1 ≤ valL F M₁'
          (IntermediateField.inclusion hLM₁' (liftL lam₁) - (-1 : M₁') ^ (r - 1) * (Pi₁ ^ r)⁻¹ * T₁'))
    (hlam₂_res :
      let r := condExp F L νE' / 2
      let T₂' := traceLM F hE'K₁ (ϖ_K₁ : K₁)
      let Pi₂ := normLM F hE'K₁ (ϖ_K₁ : K₁)
      IntermediateField.inclusion hLE' (liftL lam₂) - (-1 : E') ^ (r - 1) * (Pi₂ ^ r)⁻¹ * T₂' = 0 ∨
        1 ≤ valL F E'
          (IntermediateField.inclusion hLE' (liftL lam₂) - (-1 : E') ^ (r - 1) * (Pi₂ ^ r)⁻¹ * T₂')) :
    lam₂ ≠ 0 ∧ lam₁ ≠ lam₂ :=
by
  classical
  set T₁ : ℕ := condExp F L νM₁'
  set T₂ : ℕ := condExp F L νE'
  set r : ℕ := T₂ / 2
  have hr_ge1 : 1 ≤ r := by omega
  have hT₂_eq : T₂ = 2 * r := by omega
  have hT₁_eq : T₁ = 2 * r := by omega
  have hT₁_div2 : T₁ / 2 = r := by omega
  rcases hvalL_props with
    ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
      _, hval_add_L, _, _, _⟩
  rcases hvalE'_props with
    ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
      _, hval_add_E', _, _, _⟩
  rcases hvalM₁'_props with
    ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
      _, hval_add_M₁', _, _, _⟩
  rcases hvalK₁_props with
    ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁,
      _, hval_add_K₁, _, _, _⟩
  have hP_mono : ∀ {M : Type u} [Field M] (v : M → ℤ) {k₁ k₂ : ℤ} {z : M},
      k₁ ≤ k₂ → (z = 0 ∨ k₂ ≤ v z) → (z = 0 ∨ k₁ ≤ v z) := by
    intro M _ v k₁ k₂ z hk hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hP_neg : ∀ {M : Type u} [Field M] (v : M → ℤ),
      (∀ z : M, v (-z) = v z) →
      ∀ {k : ℤ} {z : M}, (z = 0 ∨ k ≤ v z) → (-z = 0 ∨ k ≤ v (-z)) := by
    intro M _ v hneg k z hz
    rcases hz with rfl | hz
    · simp
    · right
      rw [hneg]
      exact hz
  have hP_mul : ∀ {M : Type u} [Field M] (v : M → ℤ),
      (∀ z₁ z₂ : M, z₁ ≠ 0 → z₂ ≠ 0 → v (z₁ * z₂) = v z₁ + v z₂) →
      ∀ {k₁ k₂ : ℤ} {z₁ z₂ : M},
        (z₁ = 0 ∨ k₁ ≤ v z₁) → (z₂ = 0 ∨ k₂ ≤ v z₂) →
        (z₁ * z₂ = 0 ∨ k₁ + k₂ ≤ v (z₁ * z₂)) := by
    intro M _ v hmul k₁ k₂ z₁ z₂ hz₁ hz₂
    by_cases h1 : z₁ = 0
    · exact Or.inl (by simp [h1])
    · by_cases h2 : z₂ = 0
      · exact Or.inl (by simp [h2])
      · rcases hz₁ with rfl | hz₁
        · exact False.elim (h1 rfl)
        · rcases hz₂ with rfl | hz₂
          · exact False.elim (h2 rfl)
          · right
            rw [hmul z₁ z₂ h1 h2]
            omega
  have hUltra : ∀ {M : Type u} [Field M] (v : M → ℤ),
      (∀ z : M, v (-z) = v z) →
