    (hχ₂_triv : ∀ u ∈ unitGroup F E' (bE' + bM₁' - 1), χ₂ u = 1)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
