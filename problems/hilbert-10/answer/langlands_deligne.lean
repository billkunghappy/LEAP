          have hδ_z : (0 : ℤ) ≤ (δ : ℤ) := by positivity
          have hp3_z : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
          have h1 : 0 ≤ ((p : ℤ) - 2) * ((p : ℤ) * (m_u : ℤ) - (t₁ : ℤ) - 1) :=
            mul_nonneg (by linarith) (by linarith)
          have h2 : 0 ≤ ((p : ℤ) - 2) * ((p : ℤ) * (δ : ℤ)) :=
            mul_nonneg (by linarith) (by positivity)
          have h3 : 0 ≤ ((p : ℤ) - 3) * (t₁ : ℤ) :=
            mul_nonneg (by linarith) (by linarith)
          dsimp [B_H]
          rw [hp1_z, halam_z]
          have hring :
              (((p : ℤ) - 1) * (p : ℤ) * (m_u : ℤ) +
                ((p : ℤ) * ((p : ℤ) - 1) * (δ : ℤ) + ((p : ℤ) - 1) * (t₁ : ℤ))) -
              ((p : ℤ) * ((t₁ : ℤ) + (δ : ℤ) + 1 + (m_u : ℤ)) - ((p : ℤ) - 1)) =
              ((p : ℤ) - 2) * ((p : ℤ) * (m_u : ℤ) - (t₁ : ℤ) - 1) +
                ((p : ℤ) - 2) * ((p : ℤ) * (δ : ℤ)) +
                ((p : ℤ) - 3) * (t₁ : ℤ) +
                ((p : ℤ) - 3) := by ring
          linarith
        exact hvalM₁'_mono ((p : ℤ) * (a_lam : ℤ) - ((p - 1 : ℕ) : ℤ))
          ((k : ℤ) * (p : ℤ) * (m_u : ℤ) + B_H) _ htarget_le_BH huP₃_raw
      · rw [if_neg hk_top, mul_zero]
        exact Or.inl rfl
    have hXk_M_bound : IntermediateField.inclusion hLM₁' X_k = 0 ∨
        (p : ℤ) * (a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) ≤
          valL F M₁' (IntermediateField.inclusion hLM₁' X_k) := by
      have hdist : IntermediateField.inclusion hLM₁' X_k =
          IntermediateField.inclusion hLM₁' (u ^ k) * (P₁_k + P₂_k) +
            IntermediateField.inclusion hLM₁' (u ^ k) * P₃_k := by
        rw [hXk_decomp]
        ring
      rw [hdist]
      exact hvalM₁'_add ((p : ℤ) * (a_lam : ℤ) - ((p - 1 : ℕ) : ℤ))
        (IntermediateField.inclusion hLM₁' (u ^ k) * (P₁_k + P₂_k))
        (IntermediateField.inclusion hLM₁' (u ^ k) * P₃_k)
