theorem ld_ch12_wild_dyadic_even_breaks_k0_h0_beta1_beta2_valuations (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (a r : ℕ) (ha_ge1 : 1 ≤ a) (hr_ge_a : a ≤ r)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (h2_val : (2 : L) = 0 ∨ (r : ℤ) ≤ valL F L (2 : L))
    (f g d : L) (hg_ne : g ≠ 0) (hd_ne : d ≠ 0)
    (hf_val : valL F L f = (1 - 2 * (a : ℤ)))
    (hg_val : valL F L g = (1 - 2 * (r : ℤ)))
    (hd_val : valL F L d = ((r : ℤ) - (a : ℤ)))
    (h_not_bad : a = r → ¬ (1 + d = 0 ∨ (1 : ℤ) ≤ valL F L (1 + d)))
    (hE_val : f + d ^ 2 * g = 0 ∨ (1 - (a : ℤ)) ≤ valL F L (f + d ^ 2 * g)) :
    let k₀ := 1 + d
    let h₀ := f + g + 4 * f * g
    let β₁ := d ^ 2 + 2 * d - 4 * f
    let β₂ := 1 + 2 * d - 4 * d ^ 2 * g
    k₀ ≠ 0 ∧ h₀ ≠ 0 ∧ β₁ ≠ 0 ∧ β₂ ≠ 0 ∧
    valL F L k₀ = 0 ∧
    valL F L h₀ = (1 - 2 * (r : ℤ)) ∧
    valL F L β₁ = 2 * ((r : ℤ) - (a : ℤ)) ∧
    valL F L β₂ = 0 :=
by
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_a, hunit_val0⟩ := hvalL_props
  dsimp only
  have hL_mono : ∀ {m₁ m₂ : ℤ} {z : L},
      m₁ ≤ m₂ → (z = 0 ∨ m₂ ≤ valL F L z) → (z = 0 ∨ m₁ ≤ valL F L z) := by
    intro m₁ m₂ z hm hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hz)
  have hL_neg : ∀ {m : ℤ} {z : L},
      (z = 0 ∨ m ≤ valL F L z) → (-z = 0 ∨ m ≤ valL F L (-z)) := by
    intro m z hz
    rcases hz with rfl | hz
    · simp
    · exact Or.inr (by rw [hval_neg]; exact hz)
  have hL_add : ∀ {m : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m ≤ valL F L z₁) → (z₂ = 0 ∨ m ≤ valL F L z₂) →
      (z₁ + z₂ = 0 ∨ m ≤ valL F L (z₁ + z₂)) := by
    intro m z₁ z₂ h₁ h₂
    exact hval_add m z₁ z₂ h₁ h₂
  have hL_sub : ∀ {m : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m ≤ valL F L z₁) → (z₂ = 0 ∨ m ≤ valL F L z₂) →
      (z₁ - z₂ = 0 ∨ m ≤ valL F L (z₁ - z₂)) := by
    intro m z₁ z₂ h₁ h₂
    rw [sub_eq_add_neg]
    exact hL_add h₁ (hL_neg h₂)
  have hL_mul : ∀ {m₁ m₂ : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m₁ ≤ valL F L z₁) → (z₂ = 0 ∨ m₂ ≤ valL F L z₂) →
      (z₁ * z₂ = 0 ∨ m₁ + m₂ ≤ valL F L (z₁ * z₂)) := by
    intro m₁ m₂ z₁ z₂ h₁ h₂
    by_cases hz₁ : z₁ = 0
    · exact Or.inl (by simp [hz₁])
    · by_cases hz₂ : z₂ = 0
      · exact Or.inl (by simp [hz₂])
      · rcases h₁ with rfl | h₁
        · contradiction
        · rcases h₂ with rfl | h₂
          · contradiction
          · right
            rw [hval_mul z₁ z₂ hz₁ hz₂]
            exact add_le_add h₁ h₂
  have hL_sq : ∀ {m : ℤ} {z : L},
      (z = 0 ∨ m ≤ valL F L z) → (z ^ 2 = 0 ∨ 2 * m ≤ valL F L (z ^ 2)) := by
    intro m z hz
    have h := hL_mul hz hz
    rwa [← sq, ← two_mul] at h
  have hL_dom : ∀ {x y : L},
      x ≠ 0 → (y = 0 ∨ valL F L x + 1 ≤ valL F L y) →
      x + y ≠ 0 ∧ valL F L (x + y) = valL F L x := by
    intro x y hx hy
    have hx_ge : x = 0 ∨ valL F L x ≤ valL F L x := Or.inr le_rfl
    have hy_ge : y = 0 ∨ valL F L x ≤ valL F L y := hL_mono (by omega) hy
    have hxy_ge : x + y = 0 ∨ valL F L x ≤ valL F L (x + y) := hL_add hx_ge hy_ge
    have hxy_not_gt : ¬ (x + y = 0 ∨ valL F L x + 1 ≤ valL F L (x + y)) := by
      intro hgt
      have hx_sub : x = (x + y) - y := by ring
      have hx_gt : x = 0 ∨ valL F L x + 1 ≤ valL F L x := by
        have hsub := hL_sub hgt hy
        rwa [← hx_sub] at hsub
      rcases hx_gt with rfl | hx_gt
      · exact hx rfl
      · omega
    rcases hxy_ge with h0 | hge
    · exfalso; exact hxy_not_gt (Or.inl h0)
    · have hne : x + y ≠ 0 := fun h0 => hxy_not_gt (Or.inl h0)
      have hlt : ¬ (valL F L x + 1 ≤ valL F L (x + y)) := fun h1 => hxy_not_gt (Or.inr h1)
      exact ⟨hne, by omega⟩
  have hd2_ne : d ^ 2 ≠ 0 := pow_ne_zero 2 hd_ne
  have hd2_val : valL F L (d ^ 2) = 2 * ((r : ℤ) - (a : ℤ)) := by
    rw [sq, hval_mul d d hd_ne hd_ne, hd_val]
    ring
  have h4_ge : (4 : L) = 0 ∨ 2 * (r : ℤ) ≤ valL F L (4 : L) := by
    have h4_eq : (4 : L) = (2 : L) ^ 2 := by norm_num
    rw [h4_eq]
    exact hL_sq h2_val
  have hk₀ : 1 + d ≠ 0 ∧ valL F L (1 + d) = 0 := by
    by_cases h_ar : a = r
    · have hd_ge0 : d = 0 ∨ (0 : ℤ) ≤ valL F L d := Or.inr (by rw [hd_val, h_ar]; omega)
      have h1_ge0 : (1 : L) = 0 ∨ (0 : ℤ) ≤ valL F L 1 := Or.inr (by rw [hval1])
      have hk₀_ge0 : 1 + d = 0 ∨ (0 : ℤ) ≤ valL F L (1 + d) := hL_add h1_ge0 hd_ge0
      have hnb := h_not_bad h_ar
      rcases hk₀_ge0 with h0 | hge0
      · exfalso; exact hnb (Or.inl h0)
      · have hne : 1 + d ≠ 0 := fun h0 => hnb (Or.inl h0)
        have hlt1 : ¬ ((1 : ℤ) ≤ valL F L (1 + d)) := fun h1 => hnb (Or.inr h1)
