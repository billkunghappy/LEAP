    exact_mod_cast h1
  have h_2d₂_ge_bE'_h₀ : (bE' : ℤ) + (h₀ : ℤ) ≤ 2 * (d₂ : ℤ) := by
    have h1 : bE' + h₀ ≤ 2 * d₂ := by omega
    exact_mod_cast h1
  have h_2d₂_sub_ph₀ : (bE' : ℤ) ≤ -(p : ℤ) * (h₀ : ℤ) + 2 * (d₂ : ℤ) := by linarith
  have h_d₂_sub_h₀ : (((bE' + 1) / 2 : ℕ) : ℤ) ≤ -(h₀ : ℤ) + (d₂ : ℤ) := by omega
  
  obtain ⟨z_x, hz_x, hnorm_x_eq⟩ := hnorm_exp d₂ hd₂_ge1 x hx
  have hu_x_eq : u_x = (traceLM F hLE' x + normLM F hLE' x) + traceLM F hLE' z_x := by
    dsimp [u_x]
    rw [hnorm_x_eq, map_add]
    ring
  have hp_sub1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have htr_zx_bE'_h₀ : traceLM F hLE' z_x = 0 ∨
      (bE' : ℤ) + (h₀ : ℤ) ≤ valL F L (traceLM F hLE' z_x) := by
    apply htr_LE' ((bE' : ℤ) + (h₀ : ℤ)) z_x
    rcases hz_x with rfl | hz_ge
    · left; rfl
    · right
      have h_ineq : (p : ℤ) * ((bE' : ℤ) + (h₀ : ℤ)) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤
          (2 * d₂ : ℤ) := by
