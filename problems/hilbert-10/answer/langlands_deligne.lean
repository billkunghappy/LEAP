      intro q₀ r₀
      induction r₀ with
      | zero =>
        intro _
        simp
      | succ r ih =>
        intro hr
        have hr_lt : r < p := Nat.lt_of_succ_lt hr
        have h_not_dvd : ¬ (p ∣ (p * q₀ + (r + 1))) := by
          rw [Nat.dvd_add_right ⟨q₀, rfl⟩]
          exact Nat.not_dvd_of_pos_of_lt (Nat.succ_pos r) hr
        have h_vp0 : padicValNat p (p * q₀ + (r + 1)) = 0 :=
          padicValNat.eq_zero_of_not_dvd h_not_dvd
        have h_ordC_eq : ordC (p * q₀ + (r + 1)) = p * q₀ + (r + 1) := by
          dsimp only [ordC]
          rw [h_vp0, pow_zero, Nat.div_one]
        have h_cast_eq : ((ordC (p * q₀ + (r + 1)) : ℕ) : k_M) = ((r + 1 : ℕ) : k_M) := by
          rw [h_ordC_eq, Nat.cast_add, Nat.cast_mul, CharP.cast_eq_zero k_M p, zero_mul, zero_add]
        have h_add_eq : p * q₀ + (r + 1) = (p * q₀ + r) + 1 := by omega
        calc ordF (p * q₀ + (r + 1)) = ordF ((p * q₀ + r) + 1) := by rw [h_add_eq]
          _ = (ordC (p * q₀ + (r + 1)) : k_M) * ordF (p * q₀ + r) := by
              rw [h_ordF_succ, ← h_add_eq]
          _ = ((r + 1 : ℕ) : k_M) * (ordF (p * q₀) * (r.factorial : k_M)) := by
              rw [h_cast_eq, ih hr_lt]
          _ = ordF (p * q₀) * (((r + 1) * r.factorial : ℕ) : k_M) := by push_cast; ring
          _ = ordF (p * q₀) * ((r + 1).factorial : k_M) := by rw [← Nat.factorial_succ]
