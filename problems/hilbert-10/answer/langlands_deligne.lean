    intro Q _ _ _ σ lam M_lam hM_lam ψ_lam w_bar hw_ne hw_C hw_M
    have h_indep : ∀ {ι : Type u} [DecidableEq ι] (μ : ι → (C → Ω F)),
        Function.Injective μ →
        ∀ (S : Finset ι) (f : ι → Q),
          (∀ i ∈ S, ∀ c : C, σ c.1 (f i) = μ i c • f i) →
          ∑ i ∈ S, f i = 0 →
          ∀ i ∈ S, f i = 0 := by
      intro ι _ μ hμ_inj S
      induction' S using Finset.induction_on with i₀ S₀ hi₀ ih
      · intro f _ _ i hi
        simp at hi
      · intro f hf hsum
        rw [Finset.sum_insert hi₀] at hsum
        have h_ann : ∀ (c : C) (i : ι), i ∈ S₀ → (μ i c - μ i₀ c) • f i = 0 := by
          intro c
          apply ih (fun i => (μ i c - μ i₀ c) • f i)
          · intro i hi b
            have hfi : σ b.1 (f i) = μ i b • f i := hf i (Finset.mem_insert_of_mem hi) b
            rw [map_smul, hfi, smul_comm]
          · have h_term : ∀ i ∈ S₀, (μ i c - μ i₀ c) • f i = σ c.1 (f i) - μ i₀ c • f i := by
              intro i hi
              rw [sub_smul, hf i (Finset.mem_insert_of_mem hi) c]
            have h_sum_eq : (∑ i ∈ S₀, (μ i c - μ i₀ c) • f i) =
                ∑ i ∈ S₀, (σ c.1 (f i) - μ i₀ c • f i) :=
              Finset.sum_congr rfl h_term
            have h_i₀ : σ c.1 (f i₀) - μ i₀ c • f i₀ = 0 := by
              rw [hf i₀ (Finset.mem_insert_self i₀ S₀) c, sub_self]
            rw [h_sum_eq, Finset.sum_sub_distrib, ← map_sum, ← Finset.smul_sum]
            calc σ c.1 (∑ x ∈ S₀, f x) - μ i₀ c • ∑ x ∈ S₀, f x
                = (σ c.1 (f i₀) - μ i₀ c • f i₀) +
                    (σ c.1 (∑ x ∈ S₀, f x) - μ i₀ c • ∑ x ∈ S₀, f x) := by
                  rw [h_i₀, zero_add]
              _ = σ c.1 (f i₀ + ∑ x ∈ S₀, f x) - μ i₀ c • (f i₀ + ∑ x ∈ S₀, f x) := by
                  rw [map_add, smul_add]
                  abel
              _ = 0 := by
                  rw [hsum, map_zero, smul_zero, sub_self]
        have hS₀ : ∀ i ∈ S₀, f i = 0 := by
          intro i hi
          have h_ne : i ≠ i₀ := fun h => hi₀ (h ▸ hi)
          have hμ_ne : μ i ≠ μ i₀ := hμ_inj.ne h_ne
          obtain ⟨c, hc⟩ := Function.ne_iff.mp hμ_ne
          have h_sub_ne : μ i c - μ i₀ c ≠ 0 := sub_ne_zero.mpr hc
          exact (smul_eq_zero.mp (h_ann c i hi)).resolve_left h_sub_ne
        have h_sum_zero : ∑ i ∈ S₀, f i = 0 := Finset.sum_eq_zero hS₀
        have h_fi₀ : f i₀ = 0 := by
          rw [h_sum_zero, add_zero] at hsum
          exact hsum
        intro i hi
        rcases Finset.mem_insert.mp hi with rfl | hi_S₀
        · exact h_fi₀
        · exact hS₀ i hi_S₀
    have hC_norm : C.Normal := inferInstance
    have h_conj : ∀ (x : G) (c : C), x⁻¹ * c.1 * x ∈ C := by
      intro x c
      have h1 := hC_norm.conj_mem c.1 c.2 x⁻¹
      simpa [mul_assoc] using h1
    let shift : G → (C → Ω F) → (C → Ω F) :=
      fun x μ c => μ ⟨x⁻¹ * c.1 * x, h_conj x c⟩
    have h_shift_one : ∀ μ : C → Ω F, shift 1 μ = μ := by
      intro μ
      funext c
      dsimp only [shift]
      congr 1
      apply Subtype.ext
      group
    have h_shift_mul : ∀ (x y : G) (μ : C → Ω F), shift (x * y) μ = shift x (shift y μ) := by
