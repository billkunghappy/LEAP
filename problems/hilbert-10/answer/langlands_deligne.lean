      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
