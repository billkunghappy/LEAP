  obtain ⟨hvalL_0, hvalL_1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_add⟩ := hval_props L
  obtain ⟨hvalM_0, hvalM_1, hvalM_neg, hvalM_mul, hvalM_inv, hvalM_add⟩ := hval_props M
  have hψM_nontriv : ∃ w₁ : M,
