        IntermediateField.inclusion hLM_C (normLM F hLE (1 + δ_E) - 1) := by
      rw [map_sub, map_one, (hDiamondTrNorm (1 + δ_E)).2, h1w₁]
    rw [hdiam] at hMC
    apply hPullL 1 (normLM F hLE (1 + δ_E) - 1)
    have h1 : (k : ℤ) * 1 - ((k : ℤ) - 1) = ((1 : ℕ) : ℤ) := by ring
    rwa [h1]

  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro y₀ hy₀ x₀ hx₀ hyx₀
    by_cases hx₀_ge1 : x₀ = 0 ∨ 1 ≤ valL F L x₀
    · have hinc_x₀ : IntermediateField.inclusion hLE x₀ = 0 ∨
          1 ≤ valL F E (IntermediateField.inclusion hLE x₀) := by
        rcases hx₀_ge1 with rfl | hx₀_ge1
        · left; rw [map_zero]
        · right
          rw [hValAlgE x₀]
          have hq_int : (1 : ℤ) ≤ (q : ℤ) := by exact_mod_cast hq_ge1
          nlinarith
      have hy₀_ge1 : y₀ = 0 ∨ 1 ≤ valL F E y₀ := by
        have hsum : (y₀ - IntermediateField.inclusion hLE x₀) +
            IntermediateField.inclusion hLE x₀ = y₀ := sub_add_cancel y₀ _
        have h := hval_add_E 1 (y₀ - IntermediateField.inclusion hLE x₀)
          (IntermediateField.inclusion hLE x₀) hyx₀ hinc_x₀
        rwa [hsum] at h
      have hnorm_y₀ : normLM F hLE y₀ = 0 ∨ 1 ≤ valL F L (normLM F hLE y₀) := by
        rcases hy₀_ge1 with rfl | hy₀_ge1
        · left; exact hnormE_zero
        · right; rwa [hValNormE y₀]
      have hx₀_pow : x₀ ^ q = 0 ∨ 1 ≤ valL F L (x₀ ^ q) := by
        by_cases hx0 : x₀ = 0
        · left
          rw [hx0]
          exact zero_pow (by omega)
        · right
          have hge1 := hx₀_ge1.resolve_left hx0
          rw [hval_pow L x₀ q hx0]
          have hq_int : (1 : ℤ) ≤ (q : ℤ) := by exact_mod_cast hq_ge1
          nlinarith
      exact hval_sub_ge L 1 (normLM F hLE y₀) (x₀ ^ q) hnorm_y₀ hx₀_pow
    · have hx₀_ne : x₀ ≠ 0 := fun h0 => hx₀_ge1 (Or.inl h0)
      have hx₀_val0 : valL F L x₀ = 0 := by
