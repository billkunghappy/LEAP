        Module.finrank (IntermediateField.adjoin k_L ({y} : Set k_K)) k_K = ℓ := by
      rw [← IntermediateField.adjoin.finrank hy]
      exact Module.finrank_mul_finrank k_L (IntermediateField.adjoin k_L ({y} : Set k_K)) k_K
    have hdvd : (minpoly k_L y).natDegree ∣ ℓ :=
      ⟨Module.finrank (IntermediateField.adjoin k_L ({y} : Set k_K)) k_K, hmul.symm⟩
    have hℓ_pos : 0 < ℓ := hPrime.pos
    have hk_mul : (ℓ / (minpoly k_L y).natDegree) * (minpoly k_L y).natDegree = ℓ :=
      Nat.div_mul_cancel hdvd
    have hk_pos : 1 ≤ ℓ / (minpoly k_L y).natDegree := by
      rcases Nat.eq_zero_or_pos (ℓ / (minpoly k_L y).natDegree) with h0 | hpos
      · rw [h0, zero_mul] at hk_mul
        omega
      · exact hpos
    have hF_mem : F_y y ∈ M ℓ := by
      rw [hM_mem]
      refine ⟨hmon.pow _, ?_⟩
      rw [hmon.natDegree_pow, hk_mul]
    have hΛ_eq : Λ (F_y y) = (minpoly k_L y).natDegree :=
      hΛ_prime_pow (minpoly k_L y) _ hmon hirr hk_pos
    exact ⟨hmon, hirr, hk_pos, hF_mem, hΛ_eq⟩
  let fib : Polynomial k_L → Finset k_K := fun P =>
    Finset.univ.filter (fun y : k_K => F_y y = P)
  have hfib_le : ∀ P ∈ M ℓ, (fib P).card ≤ Λ P := by
    intro P _
    by_cases hne : (fib P).Nonempty
    · obtain ⟨y₀, hy₀⟩ := hne
      rw [Finset.mem_filter] at hy₀
      have hFy₀ : F_y y₀ = P := hy₀.2
      have hΛP : Λ P = (minpoly k_L y₀).natDegree := by
        rw [← hFy₀, (h_props y₀).2.2.2.2]
      let Q₀ : Polynomial k_K := Polynomial.map (algebraMap k_L k_K) (minpoly k_L y₀)
      have hQ₀_mon : Q₀.Monic := (h_props y₀).1.map (algebraMap k_L k_K)
      have hQ₀_ne : Q₀ ≠ 0 := hQ₀_mon.ne_zero
      have hQ₀_deg : Q₀.natDegree = (minpoly k_L y₀).natDegree :=
        (h_props y₀).1.natDegree_map (algebraMap k_L k_K)
      have hsub : fib P ⊆ Q₀.roots.toFinset := by
        intro y hy
        rw [Finset.mem_filter] at hy
        have hmin_eq : minpoly k_L y = minpoly k_L y₀ :=
          prime_pow_base_unique (minpoly k_L y) (minpoly k_L y₀) _ _
            (h_props y).1 (h_props y).2.1 (h_props y).2.2.1
            (h_props y₀).1 (h_props y₀).2.1 (h_props y₀).2.2.1
            (hy.2.trans hFy₀.symm)
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hQ₀_ne, Polynomial.IsRoot.def,
          Polynomial.eval_map, ← Polynomial.aeval_def, ← hmin_eq, minpoly.aeval]
      calc (fib P).card ≤ Q₀.roots.toFinset.card := Finset.card_le_card hsub
        _ ≤ Q₀.roots.card := Multiset.toFinset_card_le _
        _ ≤ Q₀.natDegree := Polynomial.card_roots' Q₀
        _ = Λ P := by rw [hQ₀_deg, hΛP]
    · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.card_empty]
      exact Nat.zero_le _
  have hsum_fib : (∑ P ∈ M ℓ, (fib P).card) = ∑ P ∈ M ℓ, Λ P := by
    have h1 : (∑ P ∈ M ℓ, (fib P).card) = (Finset.univ : Finset k_K).card :=
      (Finset.card_eq_sum_card_fiberwise (f := F_y) (s := Finset.univ) (t := M ℓ)
        (fun y _ => (h_props y).2.2.2.1)).symm
    rw [h1, Finset.card_univ, Module.card_eq_pow_finrank (K := k_L) (V := k_K), hΛ_sum_card]
  have hfib_eq : ∀ P ∈ M ℓ, (fib P).card = Λ P :=
    (Finset.sum_eq_sum_iff_of_le hfib_le).mp hsum_fib
  have hsum_eq := (Finset.sum_fiberwise_of_maps_to' (s := (Finset.univ : Finset k_K)) (t := M ℓ)
    (g := F_y) (f := lam) (fun y _ => (h_props y).2.2.2.1)).symm
  have h_lhs : (∑ y : k_K, lam (F_y y)) = ∑ P ∈ M ℓ, (Λ P : R) * lam P := by
    rw [hsum_eq]
    apply Finset.sum_congr rfl
    intro P hP
    change (∑ _y ∈ fib P, lam P) = (Λ P : R) * lam P
    rw [Finset.sum_const, nsmul_eq_mul, hfib_eq P hP]
  exact h_lhs.trans hS_lam_ℓ

theorem ld_ch10_fml_unramified (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hUnram : condExp F L ν₁ = 0) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  obtain ⟨hFinDimL, hval_norm, hval_alg, hresDeg, hqL_eq, hnorm_surj, hCondRed⟩ :=
    ld_ch10_unramified_arith_and_twist_reduction F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hUnram
      (fun ψ' hψ' θ => ld_condExp_and_condExpChar_spec F L ψ' hψ' θ)
      (fun ψK hψK θK => ld_condExp_and_condExpChar_spec F K ψK hψK θK)
      (fun a ha => ld_unitCoset_finite F L a ha)
  haveI : FiniteDimensional F L := hFinDimL
  obtain ⟨htr_bound, hy₁, hnorm_lin1, k_L, k_K, hField_kL, hFin_kL, hField_kK, hFin_kK,
    hAlg_k, resL, resK, hfinrank_res, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj,
    hresK_0, hresK_1, hresK_ring, hresK_ker, hresK_surj, hres_alg, hres_Fy_all⟩ :=
    ld_ch10_unramified_residue_galois_bridge F L K hLK hGal hPrime hval_norm hval_alg
  obtain ⟨hψK, hcondChar_eq, hcond_K, hRed⟩ := hCondRed htr_bound hy₁ hnorm_lin1
  apply hRed
  intro ha
  have hPrime_res : Nat.Prime (Module.finrank k_L k_K) := hfinrank_res.symm ▸ hPrime
  have hPolyLift := fun (lam : Polynomial k_L → Ω F) h1 hmul hvan =>
    ld_ch10_finite_field_poly_char_lifting F k_L k_K hPrime_res lam h1 hmul hvan
  have hSpecL := ld_condExp_and_condExpChar_spec F L ψ hψ χ'
  have hSpecK := ld_condExp_and_condExpChar_spec F K (traceChar F hLK ψ) hψK
    (χ'.comp (Units.map (normLM F hLK)))
  have hFinL := ld_unitCoset_finite F L (condExp F L χ') ha
  have hFinK := ld_unitCoset_finite F K (condExp F K (χ'.comp (Units.map (normLM F hLK))))
    (hcond_K.symm ▸ ha)
  by_cases h1 : condExp F L χ' = 1
  · exact ld_ch10_unramified_hd_loc_cond_one F L K hLK hPrime ψ hψ hψK χ'
      h1 (hcond_K.trans h1) hcondChar_eq hqL_eq hval_norm hval_alg
      hSpecL hSpecK hFinL hFinK k_L k_K resL resK hfinrank_res
      hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
      (fun y hy => ⟨(hres_Fy_all y hy).1, (hres_Fy_all y hy).2.1⟩)
      hPolyLift
  · have hge2 : 2 ≤ condExp F L χ' := by omega
    exact ld_ch10_unramified_hd_loc_cond_ge_two F L K hLK hPrime ψ hψ hψK χ'
      hge2 hcond_K hcondChar_eq hqL_eq hval_norm hval_alg
      htr_bound hy₁ hnorm_lin1 hSpecL hSpecK hFinL hFinK
      k_L k_K resL resK hfinrank_res
      hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
      (fun y hy => ⟨(hres_Fy_all y hy).1, (hres_Fy_all y hy).2.2⟩)
      hPolyLift

theorem ld_tame_unit_triv_val_and_residue_surj (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hRam : condExp F L ν₁ ≠ 0)
    (hNeP : Module.finrank L (IntermediateField.extendScalars hLK) ≠ p F)
    (hp : Nat.Prime (p F))
    (hp_valL : ((p F : ℕ) : L) = 0 ∨ 1 ≤ valL F L ((p F : ℕ) : L))
    (haddVal1 : addVal F 1 = 0)
    (haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0)) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
    ((ℓ : L) ≠ 0 ∧ valL F L (ℓ : L) = 0) ∧
    (∀ u ∈ unitGroup F L 1, ν₁ u = 1) ∧
    (∀ j < ℓ, j ≠ 0 → condExp F L (ν₁ ^ j) = 1) ∧
    (∀ u₁ : Lˣ, ν₁ u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ, ξ ^ ℓ = 1 → ∃ k < ℓ, (ν₁ u₁) ^ k = ξ) ∧
    resDeg F K = resDeg F L ∧
    (∀ y : K, valL F K y = valL F L (normLM F hLK y)) ∧
    (∀ x : L, valL F K (IntermediateField.inclusion hLK x) = (ℓ : ℤ) * valL F L x) ∧
    (∃ ϖ_K₀ : Kˣ, valL F K (ϖ_K₀ : K) = 1) ∧
    (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x))) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, hval_surj_K, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  set K' := IntermediateField.extendScalars hLK
  set ℓ := Module.finrank L K'
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt
  have hℓ_int_pos : (0 : ℤ) < (ℓ : ℤ) := Nat.cast_pos.mpr hℓ_pos
  have hℓ_int_ne : (ℓ : ℤ) ≠ 0 := ne_of_gt hℓ_int_pos

  
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_pow_K : ∀ (y : K) (n : ℕ), y ≠ 0 → valL F K (y ^ n) = (n : ℤ) * valL F K y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_pow_ge_L : ∀ (n : ℕ) (m : ℤ) (x : L),
      (x = 0 ∨ m ≤ valL F L x) → (x ^ n = 0 ∨ (n : ℤ) * m ≤ valL F L (x ^ n)) := by
    intro n m x hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hval1_L]
      simp
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge_L ((n : ℤ) * m) m (x ^ n) x ih hx
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * m = (n : ℤ) * m + m := by push_cast; ring
        rw [heq]
        exact hge
  have hval_finset_sum_L : ∀ (S : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_L k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hval_nat_L : ∀ n : ℕ, (n : L) = 0 ∨ 0 ≤ valL F L (n : L) := by
    intro n
    induction n with
    | zero => exact Or.inl Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_L 0 (n : L) 1 ih (Or.inr (by rw [hval1_L]))
  have hval_int_L : ∀ z : ℤ, (z : L) = 0 ∨ 0 ≤ valL F L (z : L) := by
    intro z
    cases z with
    | ofNat n =>
      simpa using hval_nat_L n
    | negSucc n =>
      rw [Int.cast_negSucc]
      rcases hval_nat_L (n + 1) with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right
        rw [hval_neg_L]
        exact hge

  
  have hcop : Nat.Coprime ℓ (p F) :=
    (Nat.Prime.coprime_iff_not_dvd hPrime).mpr fun hdvd =>
      hNeP ((Nat.dvd_prime hp).mp hdvd |>.resolve_left hPrime.ne_one)
  have hbez_int : (1 : ℤ) = (ℓ : ℤ) * Nat.gcdA ℓ (p F) + (p F : ℤ) * Nat.gcdB ℓ (p F) := by
    have h := Nat.gcd_eq_gcd_ab ℓ (p F)
    rw [hcop.gcd_eq_one, Nat.cast_one] at h
    exact h
  have hbez_L : (1 : L) =
      (ℓ : L) * (Nat.gcdA ℓ (p F) : L) + ((p F : ℕ) : L) * (Nat.gcdB ℓ (p F) : L) := by
    have h := congrArg (Int.cast : ℤ → L) hbez_int
    push_cast at h
    exact h
  have hℓ_not_gt0 : ¬ ((ℓ : L) = 0 ∨ 1 ≤ valL F L (ℓ : L)) := by
    intro hℓ1
    have ht1 : (ℓ : L) * (Nat.gcdA ℓ (p F) : L) = 0 ∨
        1 ≤ valL F L ((ℓ : L) * (Nat.gcdA ℓ (p F) : L)) := by
      simpa using hval_mul_ge_L 1 0 (ℓ : L) (Nat.gcdA ℓ (p F) : L) hℓ1 (hval_int_L _)
    have ht2 : ((p F : ℕ) : L) * (Nat.gcdB ℓ (p F) : L) = 0 ∨
        1 ≤ valL F L (((p F : ℕ) : L) * (Nat.gcdB ℓ (p F) : L)) := by
      simpa using hval_mul_ge_L 1 0 ((p F : ℕ) : L) (Nat.gcdB ℓ (p F) : L) hp_valL (hval_int_L _)
    have hsum := hval_add_L 1 _ _ ht1 ht2
    rw [← hbez_L, hval1_L] at hsum
    rcases hsum with h10 | h1ge
    · exact one_ne_zero h10
    · omega
  have hℓ_ne0 : (ℓ : L) ≠ 0 := fun h0 => hℓ_not_gt0 (Or.inl h0)
  have hℓ_val0 : valL F L (ℓ : L) = 0 := by
    have hge0 : 0 ≤ valL F L (ℓ : L) := (hval_nat_L ℓ).resolve_left hℓ_ne0
    have hnot1 : ¬ (1 ≤ valL F L (ℓ : L)) := fun h1 => hℓ_not_gt0 (Or.inr h1)
    omega

  have hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m,
      u ^ (p F) ∈ unitGroup F L (m + 1) := by
    intro m hm u hu
    let x : L := (u : L) - 1
    have hx : x = 0 ∨ (m : ℤ) ≤ valL F L x := by
      rcases (hunit_ge1_L m hm u).mp hu with h1 | hge
      · left
        dsimp [x]
        rw [h1, sub_self]
      · exact Or.inr hge
    have hu_eq : (u : L) = x + 1 := by
      dsimp [x]
      ring
    have hpow_sub : ((u ^ (p F) : Lˣ) : L) - 1 =
        ∑ k ∈ Finset.range (p F), (x ^ (k + 1) * ((p F).choose (k + 1) : L)) := by
      rw [Units.val_pow_eq_pow_val, hu_eq, add_pow x 1 (p F), Finset.sum_range_succ']
      simp [one_pow]
    have hsum_val : (∑ k ∈ Finset.range (p F), (x ^ (k + 1) * ((p F).choose (k + 1) : L))) = 0 ∨
        ((m + 1 : ℕ) : ℤ) ≤
          valL F L (∑ k ∈ Finset.range (p F), (x ^ (k + 1) * ((p F).choose (k + 1) : L))) := by
      apply hval_finset_sum_L (Finset.range (p F)) _ ((m + 1 : ℕ) : ℤ)
      intro k _
      by_cases hk0 : k = 0
      · subst hk0
        simp only [zero_add, pow_one, Nat.choose_one_right]
        have hmul := hval_mul_ge_L (m : ℤ) 1 x ((p F : ℕ) : L) hx hp_valL
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          push_cast
          omega
      · have hx_pow := hval_pow_ge_L (k + 1) (m : ℤ) x hx
        have hx_pow' : x ^ (k + 1) = 0 ∨ ((m + 1 : ℕ) : ℤ) ≤ valL F L (x ^ (k + 1)) := by
          rcases hx_pow with h0 | hge
          · exact Or.inl h0
          · right
            have hle : ((m + 1 : ℕ) : ℤ) ≤ ((k + 1 : ℕ) : ℤ) * (m : ℤ) := by
              have hk1 : 1 ≤ k := Nat.pos_of_ne_zero hk0
              push_cast
              nlinarith
            exact le_trans hle hge
        have hmul := hval_mul_ge_L ((m + 1 : ℕ) : ℤ) 0
          (x ^ (k + 1)) ((p F).choose (k + 1) : L) hx_pow' (hval_nat_L _)
        simpa using hmul
    rw [hunit_ge1_L (m + 1) (by omega) (u ^ (p F)), hpow_sub]
    rcases hsum_val with h0 | hge
    · left
      exact sub_eq_zero.mp (hpow_sub.trans h0)
    · exact Or.inr hge

  have hunit_pow_pd : ∀ (d : ℕ) (u : Lˣ),
      u ∈ unitGroup F L 1 → u ^ ((p F) ^ d) ∈ unitGroup F L (1 + d) := by
    intro d u hu
    induction d with
    | zero =>
      simpa using hu
    | succ d ih =>
      rw [pow_succ, pow_mul, ← Nat.add_assoc]
      exact hunit_pow_p (1 + d) (by omega) (u ^ ((p F) ^ d)) ih

  have hunit_anti_L : ∀ {a b : ℕ}, a ≤ b → unitGroup F L b ≤ unitGroup F L a := by
    intro a b hle u hu
    by_cases ha0 : a = 0
    · subst ha0
      exact (hunit0_L u).mpr (hunit_val0_L b u hu)
    · have ha1 : 1 ≤ a := by omega
      have hb1 : 1 ≤ b := by omega
      rw [hunit_ge1_L a ha1 u]
      rcases (hunit_ge1_L b hb1 u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)

  have hν₁_triv1 : ∀ u ∈ unitGroup F L 1, ν₁ u = 1 := by
    intro u hu
    set d : ℕ := condExp F L ν₁
    have hu_pd : u ^ ((p F) ^ d) ∈ unitGroup F L d :=
      hunit_anti_L (by omega : d ≤ 1 + d) (hunit_pow_pd d u hu)
    have hcond1 := hν₁_cond 1 hℓ_gt1 (u ^ ((p F) ^ d))
    rw [pow_one ν₁] at hcond1
    have hpow_pd : (ν₁ u) ^ ((p F) ^ d) = 1 := by
      rw [← map_pow]
      exact hcond1 hu_pd
    have hpow_ell : (ν₁ u) ^ ℓ = 1 := by
      rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
    have hcop_d : Nat.Coprime ℓ ((p F) ^ d) := hcop.pow_right d
    have hgcd := (pow_gcd_eq_one (a := ν₁ u) (m := ℓ) (n := (p F) ^ d)).mpr ⟨hpow_ell, hpow_pd⟩
    rwa [hcop_d.gcd_eq_one, pow_one] at hgcd

  have hν₁_cond_eq : ∀ j < ℓ, j ≠ 0 → condExp F L (ν₁ ^ j) = 1 := by
    intro j hj_lt hj_ne0
    have hle1 : condExp F L (ν₁ ^ j) ≤ 1 := by
      have hmem : (1 : ℕ) ∈ {a : ℕ | ∀ u ∈ unitGroup F L a, (ν₁ ^ j) u = 1} := by
        intro u hu
        rw [MonoidHom.pow_apply, hν₁_triv1 u hu, one_pow]
      exact Nat.sInf_le hmem
    have hne0 : condExp F L (ν₁ ^ j) ≠ 0 := by
      intro hc0
      have hj_triv0 : ∀ u ∈ unitGroup F L 0, (ν₁ u) ^ j = 1 := by
        intro u hu
        have h := hν₁_cond j hj_lt u
        rw [hc0] at h
        rw [← MonoidHom.pow_apply]
        exact h hu
      have hcop_j : Nat.Coprime ℓ j :=
        (Nat.Prime.coprime_iff_not_dvd hPrime).mpr
          (Nat.not_dvd_of_pos_of_lt (Nat.pos_of_ne_zero hj_ne0) hj_lt)
      have hν₁_triv0 : ∀ u ∈ unitGroup F L 0, ν₁ u = 1 := by
        intro u hu
        have hpow_ell : (ν₁ u) ^ ℓ = 1 := by
          rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
        have hpow_j : (ν₁ u) ^ j = 1 := hj_triv0 u hu
        have hgcd := (pow_gcd_eq_one (a := ν₁ u) (m := ℓ) (n := j)).mpr ⟨hpow_ell, hpow_j⟩
        rwa [hcop_j.gcd_eq_one, pow_one] at hgcd
      have hc_ν₁ : condExp F L ν₁ ≤ 0 := Nat.sInf_le hν₁_triv0
      exact hRam (Nat.eq_zero_of_le_zero hc_ν₁)
    omega

  
  have hroot_exh : ∀ u₁ : Lˣ, ν₁ u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ, ξ ^ ℓ = 1 →
      ∃ k < ℓ, (ν₁ u₁) ^ k = ξ := by
    intro u₁ hu₁_ne ξ hξ
    set ζ : (Ω F)ˣ := ν₁ u₁
    have hζ_pow : ζ ^ ℓ = 1 := by
      dsimp [ζ]
      rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
    have hord : orderOf ζ = ℓ := orderOf_eq_prime hζ_pow hu₁_ne
    let ϕ : Fin ℓ → Ω F := fun i => ((ζ ^ (i : ℕ) : (Ω F)ˣ) : Ω F)
    have hpow_inj_le : ∀ {a b : ℕ}, a ≤ b → b < ℓ → ζ ^ a = ζ ^ b → a = b := by
      intro a b hab hb heq
      have hsub : ζ ^ (b - a) * ζ ^ a = 1 * ζ ^ a := by
        rw [← pow_add, Nat.sub_add_cancel hab, one_mul, heq]
      have hpow_sub : ζ ^ (b - a) = 1 := mul_right_cancel hsub
      have hdvd : ℓ ∣ b - a := by
        rw [← hord]
        exact orderOf_dvd_iff_pow_eq_one.mpr hpow_sub
      have hlt : b - a < ℓ := by omega
      have hzero : b - a = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      omega
    have hϕ_inj : Function.Injective ϕ := by
      intro i j hij
      have hζ_ij : ζ ^ (i : ℕ) = ζ ^ (j : ℕ) := Units.ext hij
      rcases le_total (i : ℕ) (j : ℕ) with hle | hle
      · exact Fin.ext (hpow_inj_le hle j.2 hζ_ij)
      · exact Fin.ext (hpow_inj_le hle i.2 hζ_ij.symm).symm
    let P : Polynomial (Ω F) := Polynomial.X ^ ℓ - Polynomial.C 1
    have hP_ne : P ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hℓ_pos 1
    have hP_deg : P.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    let S_img : Finset (Ω F) := (Finset.univ : Finset (Fin ℓ)).image ϕ
    let R_fin : Finset (Ω F) := P.roots.toFinset
    have hsub_roots : S_img ⊆ R_fin := by
      intro z hz
      rcases Finset.mem_image.mp hz with ⟨i, _, rfl⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P, ϕ]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← pow_mul, mul_comm (i : ℕ) ℓ, pow_mul, ← Units.val_pow_eq_pow_val,
        hζ_pow, Units.val_one, one_pow]
    have hcard_le : R_fin.card ≤ S_img.card := by
      calc R_fin.card
        _ ≤ P.roots.card := Multiset.toFinset_card_le P.roots
        _ ≤ P.natDegree := Polynomial.card_roots' P
        _ = ℓ := hP_deg
        _ = (Finset.univ : Finset (Fin ℓ)).card := (Fintype.card_fin ℓ).symm
        _ = S_img.card := (Finset.card_image_of_injective _ hϕ_inj).symm
    have hS_eq_R : S_img = R_fin := Finset.eq_of_subset_of_card_le hsub_roots hcard_le
    have hξ_mem : (ξ : Ω F) ∈ R_fin := by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← Units.val_pow_eq_pow_val, hξ, Units.val_one]
    rw [← hS_eq_R] at hξ_mem
    rcases Finset.mem_image.mp hξ_mem with ⟨i, _, hi⟩
    exact ⟨i.1, i.2, Units.ext hi⟩

  have hex_u0 : ∃ u₀ ∈ unitGroup F L 0, ν₁ u₀ ≠ 1 := by
    by_contra h_all
    push_neg at h_all
    have hc0 : condExp F L ν₁ ≤ 0 := Nat.sInf_le h_all
    exact hRam (Nat.eq_zero_of_le_zero hc0)
  obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := hex_u0
  obtain ⟨ϖ₀, hϖ₀⟩ := hval_surj_L 1
  have hν₁_ϖ₀_pow : (ν₁ ϖ₀) ^ ℓ = 1 := by
    rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
  obtain ⟨k₀, _, hk₀⟩ := hroot_exh u₀ hu₀_ne (ν₁ ϖ₀) hν₁_ϖ₀_pow
  let ϖ_L₀ : Lˣ := ϖ₀ * (u₀ ^ k₀)⁻¹
  have hϖ_L₀_val : valL F L (ϖ_L₀ : L) = 1 := by
    have hu₀_val : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀_mem
    change valL F L (((ϖ₀ * (u₀ ^ k₀)⁻¹ : Lˣ) : L)) = 1
    rw [Units.val_mul, hval_mul_L (ϖ₀ : L) _ (Units.ne_zero ϖ₀) (Units.ne_zero _),
      hval_inv_L (u₀ ^ k₀), Units.val_pow_eq_pow_val, hval_pow_L (u₀ : L) k₀ (Units.ne_zero u₀),
      hϖ₀, hu₀_val, mul_zero, neg_zero, add_zero]
  have hν₁_ϖ_L₀ : ν₁ ϖ_L₀ = 1 := by
    dsimp [ϖ_L₀]
    rw [map_mul, map_inv, map_pow, hk₀, mul_inv_cancel]
  obtain ⟨ϖ_K_lift, hϖ_K_lift⟩ := (hν₁_ker ϖ_L₀).mpr hν₁_ϖ_L₀

  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q_z : ℤ := valL F M z
      set r_z : ℤ := relVal F M z % f
      have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
          linarith
        let k : ℕ := r_z.toNat
        have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hval_surj_L
  obtain ⟨hresDeg_K_pos, hdiv_K⟩ := hrelVal_div K hval_surj_K
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hresDeg_L_pos)

  let eF : K ≃ₐ[F] K' :=
    { toExtendScalars F hLK with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K' := Module.Finite.equiv eF.toLinearEquiv
  haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'

  have hrelVal_norm : ∀ y : K, relVal F L (normLM F hLK y) = relVal F K y := by
    intro y
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y))) =
      addVal F (Algebra.norm F y)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y)) =
        Algebra.norm F (toExtendScalars F hLK y) := Algebra.norm_norm
    have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hLK y) :=
      Algebra.norm_eq_of_algEquiv eF y
    rw [h1, ← h2]

  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (algebraMap L K' x) = x ^ ℓ
    exact Algebra.norm_algebraMap x

  have hResDeg : resDeg F K = resDeg F L := by
    apply le_antisymm
    · have hcoe : normLM F hLK (ϖ_K_lift : K) = (ϖ_L₀ : L) := congrArg Units.val hϖ_K_lift
      have hrel_lift : relVal F K (ϖ_K_lift : K) = (resDeg F L : ℤ) := by
        rw [← hrelVal_norm (ϖ_K_lift : K), hcoe, hdiv_L (ϖ_L₀ : L), hϖ_L₀_val, mul_one]
      have hmem : resDeg F L ∈ {k : ℕ | 0 < k ∧ ∃ y : K, y ≠ 0 ∧ relVal F K y = (k : ℤ)} :=
        ⟨hresDeg_L_pos, (ϖ_K_lift : K), Units.ne_zero ϖ_K_lift, hrel_lift⟩
      exact Nat.sInf_le hmem
    · obtain ⟨c₁, hc₁⟩ := hval_surj_K 1
      have hrel_c₁ : (resDeg F K : ℤ) =
          (resDeg F L : ℤ) * valL F L (normLM F hLK (c₁ : K)) := by
        calc (resDeg F K : ℤ)
          _ = (resDeg F K : ℤ) * valL F K (c₁ : K) := by rw [hc₁, mul_one]
          _ = relVal F K (c₁ : K) := (hdiv_K (c₁ : K)).symm
          _ = relVal F L (normLM F hLK (c₁ : K)) := (hrelVal_norm (c₁ : K)).symm
          _ = (resDeg F L : ℤ) * valL F L (normLM F hLK (c₁ : K)) := hdiv_L _
      have hdvd_int : (resDeg F L : ℤ) ∣ (resDeg F K : ℤ) := ⟨_, hrel_c₁⟩
      have hdvd_nat : resDeg F L ∣ resDeg F K := Int.ofNat_dvd.mp hdvd_int
      exact Nat.le_of_dvd hresDeg_K_pos hdvd_nat

  have hValNorm : ∀ y : K, valL F K y = valL F L (normLM F hLK y) := by
    intro y
    apply mul_left_cancel₀ hfL_int_ne
    calc (resDeg F L : ℤ) * valL F K y
      _ = (resDeg F K : ℤ) * valL F K y := by rw [hResDeg]
      _ = relVal F K y := (hdiv_K y).symm
      _ = relVal F L (normLM F hLK y) := (hrelVal_norm y).symm
      _ = (resDeg F L : ℤ) * valL F L (normLM F hLK y) := hdiv_L (normLM F hLK y)

  have hValAlg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) = (ℓ : ℤ) * valL F L x := by
    intro x
    by_cases hx0 : x = 0
    · rw [hx0, map_zero, hval0_K, hval0_L, mul_zero]
    · rw [hValNorm (IntermediateField.inclusion hLK x), hnorm_inc x, hval_pow_L x ℓ hx0]

  
  obtain ⟨ϖ_K₀, hϖ_K₀⟩ := hval_surj_K 1

  have hval_strict_K : ∀ (y₁ y₂ : K),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F K y₁ + 1 ≤ valL F K y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F K (y₁ + y₂) = valL F K y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F K y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F K y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F K (y₁ + y₂) :=
      hval_add_K v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F K (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F K (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_K]
          exact hge
      have hy₁_gt := hval_add_K (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  let t_term (c : Fin ℓ → L) (i : Fin ℓ) : K :=
    IntermediateField.inclusion hLK (c i) * ((ϖ_K₀ : K) ^ (i : ℕ))
  let v_term (c : Fin ℓ → L) (i : Fin ℓ) : ℤ :=
    (ℓ : ℤ) * valL F L (c i) + (i.1 : ℤ)

  have ht_term_zero : ∀ (c : Fin ℓ → L) (i : Fin ℓ), c i = 0 → t_term c i = 0 := by
    intro c i hci
    dsimp [t_term]
    rw [hci, map_zero, zero_mul]

  have ht_term_nz : ∀ (c : Fin ℓ → L) (i : Fin ℓ),
      c i ≠ 0 → t_term c i ≠ 0 ∧ valL F K (t_term c i) = v_term c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hLK (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hci
    have hpow_ne : ((ϖ_K₀ : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K₀)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term, v_term]
    rw [hval_mul_K _ _ hinc_ne hpow_ne, hValAlg (c i),
      hval_pow_K (ϖ_K₀ : K) (i : ℕ) (Units.ne_zero ϖ_K₀), hϖ_K₀, mul_one]

  have hv_term_inj : ∀ (c : Fin ℓ → L) (i j : Fin ℓ),
      v_term c i = v_term c j → i = j := by
    intro c i j hij
    have hmod : ∀ k : Fin ℓ, v_term c k % (ℓ : ℤ) = (k.1 : ℤ) := by
      intro k
      dsimp [v_term]
      have hcomm : (ℓ : ℤ) * valL F L (c k) + (k.1 : ℤ) =
          (k.1 : ℤ) + (ℓ : ℤ) * valL F L (c k) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_ge : ∀ (c : Fin ℓ → L) (S : Finset (Fin ℓ)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term c i) →
        ((∑ i ∈ S, t_term c i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, t_term c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term c a = 0 ∨ m ≤ valL F K (t_term c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_zero c a hca)
        · right
          rw [(ht_term_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K m (t_term c a) (∑ i ∈ s, t_term c i) ha_t hs_t

  have hsum_min_nz : ∀ (c : Fin ℓ → L) (i : Fin ℓ),
      c i ≠ 0 →
        ∃ i₀ : Fin ℓ, c i₀ ≠ 0 ∧ v_term c i₀ ≤ v_term c i ∧
          (∑ j : Fin ℓ, t_term c j) ≠ 0 ∧
          valL F K (∑ j : Fin ℓ, t_term c j) = v_term c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin ℓ) := (Finset.univ : Finset (Fin ℓ)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term c i₀ ≤ v_term c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin ℓ)).erase i₀,
        c j = 0 ∨ v_term c i₀ + 1 ≤ v_term c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term c i₀ ≤ v_term c j := hi₀_min j hj_mem
        have hne_v : v_term c i₀ ≠ v_term c j := fun heq => hj_ne (hv_term_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_ge c ((Finset.univ : Finset (Fin ℓ)).erase i₀)
      (v_term c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_K (t_term c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin ℓ)).erase i₀, t_term c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hval_sum_iff : ∀ (c : Fin ℓ → L) (m : ℤ),
      ((∑ i : Fin ℓ, t_term c i) = 0 ∨ m ≤ valL F K (∑ i : Fin ℓ, t_term c i)) ↔
        ∀ i : Fin ℓ, c i = 0 ∨ m ≤ v_term c i := by
    intro c m
    refine ⟨?_, fun hall => hval_sum_ge c Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hci : c i = 0
    · exact Or.inl hci
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_nz c i hci
      have hm_le : m ≤ valL F K (∑ j : Fin ℓ, t_term c j) := hsum.resolve_left hsum_ne
      omega

  have hlin_zero : ∀ (c : Fin ℓ → L),
      (∑ i : Fin ℓ, t_term c i) = 0 → ∀ i : Fin ℓ, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_nz c i hci
    exact hsum_ne hsum0

  let b_vec : Fin ℓ → K' := fun i => (toExtendScalars F hLK (ϖ_K₀ : K)) ^ (i : ℕ)
  have hli : LinearIndependent L b_vec := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hLK (∑ i : Fin ℓ, t_term c i) =
        ∑ i : Fin ℓ, c i • b_vec i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term, b_vec]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin ℓ, t_term c i) = 0 := by
      apply eF.injective
      change toExtendScalars F hLK (∑ i : Fin ℓ, t_term c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero c hsum0

  haveI : Nonempty (Fin ℓ) := ⟨⟨0, hℓ_pos⟩⟩
  have hcard : Fintype.card (Fin ℓ) = Module.finrank L K' := Fintype.card_fin ℓ
  let B : Module.Basis (Fin ℓ) L K' := basisOfLinearIndependentOfCardEqFinrank hli hcard

  have hResSurj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)) := by
    intro y hy
    let c : Fin ℓ → L := fun i => B.repr (toExtendScalars F hLK y) i
    have hy_eq : y = ∑ i : Fin ℓ, t_term c i := by
      apply eF.injective
      change toExtendScalars F hLK y = toExtendScalars F hLK (∑ i : Fin ℓ, t_term c i)
      have hrepr := (B.sum_repr (toExtendScalars F hLK y)).symm
      rw [hrepr, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [B, c, t_term, b_vec]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli hcard, map_mul, map_pow]
      rfl
    have hc0 : ∀ i : Fin ℓ, c i = 0 ∨ 0 ≤ v_term c i :=
      (hval_sum_iff c 0).mp (hy_eq ▸ hy)
    let i_zero : Fin ℓ := ⟨0, hℓ_pos⟩
    let x : L := c i_zero
    have hx_int : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc0 i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (ℓ : ℤ) * valL F L x + 0 at hge
        nlinarith
    let c_rem : Fin ℓ → L := fun i => if i = i_zero then 0 else c i
    have hy_sub_eq : y - IntermediateField.inclusion hLK x = ∑ i : Fin ℓ, t_term c_rem i := by
      have ht_zero : t_term c i_zero = IntermediateField.inclusion hLK x := by
        dsimp [t_term, i_zero, x]
        rw [pow_zero, mul_one]
      have hsplit_c := (Finset.add_sum_erase Finset.univ (t_term c) (Finset.mem_univ i_zero)).symm
      have hsplit_rem := (Finset.add_sum_erase Finset.univ (t_term c_rem) (Finset.mem_univ i_zero)).symm
      have hrem_zero : t_term c_rem i_zero = 0 :=
        ht_term_zero c_rem i_zero (if_pos rfl)
      have herase_eq : (∑ i ∈ (Finset.univ : Finset (Fin ℓ)).erase i_zero, t_term c i) =
          ∑ i ∈ (Finset.univ : Finset (Fin ℓ)).erase i_zero, t_term c_rem i := by
        apply Finset.sum_congr rfl
        intro i hi
        have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
        dsimp [t_term, c_rem]
        rw [if_neg hi_ne]
      rw [hy_eq, hsplit_c, ht_zero, add_sub_cancel_left, herase_eq, hsplit_rem, hrem_zero, zero_add]
    have hrem_ge1 : ∀ i : Fin ℓ, c_rem i = 0 ∨ 1 ≤ v_term c_rem i := by
      intro i
      by_cases hi0 : i = i_zero
      · left
        dsimp [c_rem]
        rw [if_pos hi0]
      · dsimp [c_rem, v_term]
        rw [if_neg hi0]
        rcases hc0 i with hci0 | hge
        · exact Or.inl hci0
        · right
          dsimp [v_term] at hge
          have hi_pos : (1 : ℤ) ≤ (i.1 : ℤ) := by
            have hne_val : i.1 ≠ 0 := fun h0 => hi0 (Fin.ext h0)
            omega
          have hi_lt : (i.1 : ℤ) < (ℓ : ℤ) := Nat.cast_lt.mpr i.2
          have hval_nonneg : 0 ≤ valL F L (c i) := by
            by_contra hneg
            have hle_neg1 : valL F L (c i) ≤ -1 := by omega
            nlinarith
          nlinarith
    refine ⟨x, hx_int, ?_⟩
    rw [hy_sub_eq]
    exact (hval_sum_iff c_rem 1).mpr hrem_ge1

  exact ⟨⟨hℓ_ne0, hℓ_val0⟩, hν₁_triv1, hν₁_cond_eq, hroot_exh, hResDeg, hValNorm, hValAlg,
    ⟨ϖ_K₀, hϖ_K₀⟩, hResSurj⟩

theorem ld_tame_galois_trace_norm_bounds_and_uniformizer (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hℓ_ne0 : (Module.finrank L (IntermediateField.extendScalars hLK) : L) ≠ 0)
    (hℓ_val0 : valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0)
    (hValNorm : ∀ y : K, valL F K y = valL F L (normLM F hLK y))
    (hValAlg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K₀ : Kˣ) (hϖ_K₀ : valL F K (ϖ_K₀ : K) = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0)) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
    (∀ (m : ℤ) (y : K),
      (y = 0 ∨ (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) ∧
    (∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
      normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        2 * valL F K y ≤ (ℓ : ℤ) * valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y))) ∧
    (∃ ϖ_K : Kˣ,
      valL F K (ϖ_K : K) = 1 ∧
      valL F L ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) = 1 ∧
      ν₁ (Units.map (normLM F hLK) ϖ_K) = 1 ∧
      (ℓ = 2 →
        traceLM F hLK (ϖ_K : K) = 0 ∧
        (ϖ_K : K) ^ 2 = - IntermediateField.inclusion hLK ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L))) :=
by
  obtain ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add,
    hunitL0, hunitLa, hunitL_val0⟩ := hvalL_props
  obtain ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add,
    hunitK0, hunitKa, hunitK_val0⟩ := hvalK_props
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let ℓ := Module.finrank L K'
  have hFinLK' : FiniteDimensional L K' := by
    haveI : FiniteDimensional F K' := ‹FiniteDimensional F K›
    haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F L K'
  haveI : FiniteDimensional L K' := hFinLK'
  have hGalLK' : IsGalois L ↥K' := by
    have hSepLK' : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    haveI : Algebra.IsSeparable L K' := hSepLK'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
    exact helper_isGalois L (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois L ↥K' := hGalLK'
  let G : Type u := (K' ≃ₐ[L] K')
  have hcard_G : Fintype.card G = ℓ :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank L K')
  let fromExtendScalars : K' →+* K :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLK).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → K → K := fun σ y => fromExtendScalars (σ (toExtendScalars F hLK y))
  have hact_one : ∀ y : K, act 1 y = y := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun y₁ y₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x := by
    intro σ x
    change fromExtendScalars (σ (algebraMap L K' x)) = IntermediateField.inclusion hLK x
    rw [σ.commutes x]
    rfl
  have hact_trace : ∀ y : K,
      IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := L) (L := K') (toExtendScalars F hLK y))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hLK y)) Finset.univ)
  have hact_norm : ∀ y : K,
      IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLK y))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hLK y)) Finset.univ)
  have hinj : Function.Injective (IntermediateField.inclusion hLK) :=
    (IntermediateField.inclusion hLK).injective
  have htrace_incl : ∀ x : L,
      traceLM F hLK (IntermediateField.inclusion hLK x) = (ℓ : L) * x := by
    intro x
    apply hinj
    rw [hact_trace (IntermediateField.inclusion hLK x)]
    have hsum : (∑ σ : G, act σ (IntermediateField.inclusion hLK x)) =
        ∑ _ : G, IntermediateField.inclusion hLK x := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact hact_incl σ x
    rw [hsum, Finset.sum_const, Finset.card_univ, hcard_G, nsmul_eq_mul, map_mul, map_natCast]
  have hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y := by
    intro σ y
    have hnorm_eq : normLM F hLK (act σ y) = normLM F hLK y := by
      apply hinj
      rw [hact_norm (act σ y), hact_norm y]
      have hmul : (∏ τ : G, act τ (act σ y)) = ∏ τ : G, act (τ * σ) y := by
        refine Finset.prod_congr rfl fun τ _ => ?_
        rw [hact_mul]
      rw [hmul]
      exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => act τ y)
    rw [hValNorm (act σ y), hValNorm y, hnorm_eq]
  have hTraceBound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨ (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)) := by
    intro m y hy
    let k : ℤ := (ℓ : ℤ) * m - ((ℓ : ℤ) - 1)
    have hy_act : ∀ σ : G, act σ y = 0 ∨ k ≤ valL F K (act σ y) := by
      intro σ
      rcases hy with rfl | hge
      · exact Or.inl (by rw [(hact_ring σ).1])
      · exact Or.inr (by rw [hact_val σ y]; exact hge)
    have h_sum_bound : ∀ S : Finset G,
        (∑ σ ∈ S, act σ y) = 0 ∨ k ≤ valL F K (∑ σ ∈ S, act σ y) := by
      intro S
      induction' S using Finset.induction_on with τ S' hτ ih
      · exact Or.inl Finset.sum_empty
      · rw [Finset.sum_insert hτ]
        exact hvalK_add k (act τ y) (∑ σ ∈ S', act σ y) (hy_act τ) ih
    have h_univ := h_sum_bound Finset.univ
    rw [← hact_trace y] at h_univ
    rcases h_univ with h0 | hge
    · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLK) hinj).mp h0)
    · right
      rw [hValAlg (traceLM F hLK y)] at hge
      change (ℓ : ℤ) * m - ((ℓ : ℤ) - 1) ≤ (ℓ : ℤ) * valL F L (traceLM F hLK y) at hge
      have hpos : (1 : ℤ) ≤ (ℓ : ℤ) := by exact_mod_cast hPrime.pos
      by_contra hlt
      have hle : valL F L (traceLM F hLK y) ≤ m - 1 := by omega
      have hmul_le : (ℓ : ℤ) * valL F L (traceLM F hLK y) ≤ (ℓ : ℤ) * (m - 1) :=
        mul_le_mul_of_nonneg_left hle (by omega)
      linarith
  have hring_id : ∀ (z S_sum P : K),
      (1 + z) * P - (1 + (z + S_sum)) =
        (P - (1 + S_sum)) + z * S_sum + z * (P - (1 + S_sum)) :=
    fun _ _ _ => by ring
  have hNormRem : ∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
      normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        2 * valL F K y ≤ (ℓ : ℤ) * valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)) := by
    intro y hy
    by_cases hy0 : y = 0
    · exact Or.inl (by rw [hy0]; simp)
    · have hd : 1 ≤ valL F K y := hy.resolve_left hy0
      let d : ℤ := valL F K y
      have hy_act : ∀ σ : G, act σ y = 0 ∨ d ≤ valL F K (act σ y) := by
        intro σ
        exact Or.inr (by rw [hact_val σ y])
      have h_ind : ∀ S : Finset G,
          ((∑ σ ∈ S, act σ y) = 0 ∨ d ≤ valL F K (∑ σ ∈ S, act σ y)) ∧
          ((∏ σ ∈ S, (1 + act σ y)) - (1 + ∑ σ ∈ S, act σ y) = 0 ∨
            2 * d ≤ valL F K ((∏ σ ∈ S, (1 + act σ y)) - (1 + ∑ σ ∈ S, act σ y))) := by
        intro S
        induction' S using Finset.induction_on with τ S' hτ ih
        · exact ⟨Or.inl Finset.sum_empty,
            Or.inl (by rw [Finset.prod_empty, Finset.sum_empty, add_zero, sub_self])⟩
        · rw [Finset.sum_insert hτ, Finset.prod_insert hτ]
          let z := act τ y
          let S_sum := ∑ σ ∈ S', act σ y
          let P := ∏ σ ∈ S', (1 + act σ y)
          let R := P - (1 + S_sum)
          have ih1 : S_sum = 0 ∨ d ≤ valL F K S_sum := ih.1
          have ih2 : R = 0 ∨ 2 * d ≤ valL F K R := ih.2
          have hz : z = 0 ∨ d ≤ valL F K z := hy_act τ
          have hsum : z + S_sum = 0 ∨ d ≤ valL F K (z + S_sum) :=
            hvalK_add d z S_sum hz ih1
          refine ⟨hsum, ?_⟩
          rw [hring_id z S_sum P]
          change (R + z * S_sum + z * R = 0) ∨ 2 * d ≤ valL F K (R + z * S_sum + z * R)
          have hzS : z * S_sum = 0 ∨ 2 * d ≤ valL F K (z * S_sum) := by
            by_cases hz0 : z = 0
            · exact Or.inl (by rw [hz0, zero_mul])
            · by_cases hS0 : S_sum = 0
              · exact Or.inl (by rw [hS0, mul_zero])
              · right
                rw [hvalK_mul z S_sum hz0 hS0]
                have h1 := hz.resolve_left hz0
                have h2 := ih1.resolve_left hS0
                omega
          have hzR : z * R = 0 ∨ 2 * d ≤ valL F K (z * R) := by
            by_cases hz0 : z = 0
            · exact Or.inl (by rw [hz0, zero_mul])
            · by_cases hR0 : R = 0
              · exact Or.inl (by rw [hR0, mul_zero])
              · right
                rw [hvalK_mul z R hz0 hR0]
                have h1 := hz.resolve_left hz0
                have h2 := ih2.resolve_left hR0
                omega
          exact hvalK_add (2 * d) (R + z * S_sum) (z * R)
            (hvalK_add (2 * d) R (z * S_sum) ih2 hzS) hzR
      have h_univ := (h_ind Finset.univ).2
      have hprod_eq : (∏ σ : G, (1 + act σ y)) =
          IntermediateField.inclusion hLK (normLM F hLK (1 + y)) := by
        rw [hact_norm (1 + y)]
        refine Finset.prod_congr rfl fun σ _ => ?_
        rw [((hact_ring σ).2.2 1 y).1, (hact_ring σ).2.1]
      have h_diff_eq : (∏ σ : G, (1 + act σ y)) - (1 + ∑ σ : G, act σ y) =
          IntermediateField.inclusion hLK (normLM F hLK (1 + y) - (1 + traceLM F hLK y)) := by
        rw [hprod_eq, ← hact_trace y]
        simp only [map_sub, map_add, map_one]
      rw [h_diff_eq] at h_univ
      rcases h_univ with h0 | hge
      · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLK) hinj).mp h0)
      · rw [hValAlg (normLM F hLK (1 + y) - (1 + traceLM F hLK y))] at hge
        exact Or.inr hge
  have hUniformizer : ∃ ϖ_K : Kˣ,
      valL F K (ϖ_K : K) = 1 ∧
      valL F L ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) = 1 ∧
      ν₁ (Units.map (normLM F hLK) ϖ_K) = 1 ∧
      (ℓ = 2 →
        traceLM F hLK (ϖ_K : K) = 0 ∧
        (ϖ_K : K) ^ 2 =
          - IntermediateField.inclusion hLK ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L)) := by
    have h_norm_props : ∀ w : Kˣ, valL F K (w : K) = 1 →
        valL F L ((Units.map (normLM F hLK) w : Lˣ) : L) = 1 ∧
        ν₁ (Units.map (normLM F hLK) w) = 1 := by
      intro w hw
      refine ⟨?_, ?_⟩
      · change valL F L (normLM F hLK (w : K)) = 1
        rw [← hValNorm (w : K), hw]
      · exact (hν₁_ker (Units.map (normLM F hLK) w)).mp ⟨w, rfl⟩
    by_cases hℓ2 : ℓ = 2
    · let t₀ : L := traceLM F hLK (ϖ_K₀ : K)
      have ht₀ : t₀ = 0 ∨ 1 ≤ valL F L t₀ := by
        apply hTraceBound 1 (ϖ_K₀ : K)
        right
        rw [hϖ_K₀]
        omega
      let u_ℓ : Lˣ := Units.mk0 (ℓ : L) hℓ_ne0
      have hℓ_inv_val : valL F L ((ℓ : L)⁻¹) = 0 := by
        have h1 : ((u_ℓ⁻¹ : Lˣ) : L) = (ℓ : L)⁻¹ := Units.val_inv_eq_inv_val u_ℓ
        rw [← h1, hvalL_inv u_ℓ]
        change - valL F L (ℓ : L) = 0
        rw [hℓ_val0, neg_zero]
      let x₀ : L := (ℓ : L)⁻¹ * t₀
      have hx₀ : x₀ = 0 ∨ 1 ≤ valL F L x₀ := by
        rcases ht₀ with ht₀0 | ht₀_ge
        · exact Or.inl (by simp [x₀, ht₀0])
        · by_cases ht₀0 : t₀ = 0
          · exact Or.inl (by simp [x₀, ht₀0])
          · right
            change 1 ≤ valL F L ((ℓ : L)⁻¹ * t₀)
            rw [hvalL_mul (ℓ : L)⁻¹ t₀ (inv_ne_zero hℓ_ne0) ht₀0, hℓ_inv_val, zero_add]
            exact ht₀_ge
      let w₀ : K := - IntermediateField.inclusion hLK x₀
      have hw₀ : w₀ = 0 ∨ 2 ≤ valL F K w₀ := by
        rcases hx₀ with hx₀0 | hx₀_ge
        · exact Or.inl (by simp [w₀, hx₀0])
        · right
          change 2 ≤ valL F K (- IntermediateField.inclusion hLK x₀)
          rw [hvalK_neg, hValAlg x₀]
          change 2 ≤ (ℓ : ℤ) * valL F L x₀
          rw [hℓ2]
          omega
      have hw₀1 : w₀ = 0 ∨ 1 ≤ valL F K w₀ := by
        rcases hw₀ with hw₀0 | hw₀_ge
        · exact Or.inl hw₀0
        · exact Or.inr (by omega)
      let z : K := (ϖ_K₀ : K) + w₀
      have hz1 : z = 0 ∨ 1 ≤ valL F K z :=
        hvalK_add 1 (ϖ_K₀ : K) w₀ (Or.inr (by rw [hϖ_K₀])) hw₀1
      have h_not_z2 : ¬ (z = 0 ∨ 2 ≤ valL F K z) := by
        intro hz2
        have hnw₀ : -w₀ = 0 ∨ 2 ≤ valL F K (-w₀) := by
          rcases hw₀ with hw₀0 | hw₀_ge
          · exact Or.inl (by rw [hw₀0, neg_zero])
          · exact Or.inr (by rw [hvalK_neg]; exact hw₀_ge)
        have hsum := hvalK_add 2 z (-w₀) hz2 hnw₀
        have heq : z + (-w₀) = (ϖ_K₀ : K) := by simp [z]
        rw [heq] at hsum
        rcases hsum with h0 | hge
        · exact ϖ_K₀.ne_zero h0
        · rw [hϖ_K₀] at hge
          omega
      have hz_ne0 : z ≠ 0 := fun h => h_not_z2 (Or.inl h)
      have hz_val : valL F K z = 1 := by
        have h1 : 1 ≤ valL F K z := hz1.resolve_left hz_ne0
        have h2 : ¬ (2 ≤ valL F K z) := fun h => h_not_z2 (Or.inr h)
        omega
      let ϖ_K : Kˣ := Units.mk0 z hz_ne0
      have hϖ_K_val : valL F K (ϖ_K : K) = 1 := hz_val
      obtain ⟨hϖ_L, hν₁_ϖ⟩ := h_norm_props ϖ_K hϖ_K_val
      have htr_ϖ : traceLM F hLK (ϖ_K : K) = 0 := by
        change traceLM F hLK ((ϖ_K₀ : K) + (- IntermediateField.inclusion hLK x₀)) = 0
        rw [← sub_eq_add_neg, map_sub, htrace_incl x₀]
        change t₀ - (ℓ : L) * ((ℓ : L)⁻¹ * t₀) = 0
        rw [mul_inv_cancel_left₀ hℓ_ne0 t₀, sub_self]
      have hsq_ϖ : (ϖ_K : K) ^ 2 =
          - IntermediateField.inclusion hLK ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) := by
        have hcard_erase : ((Finset.univ : Finset G).erase 1).card = 1 := by
          rw [Finset.card_erase_of_mem (Finset.mem_univ (1 : G)), Finset.card_univ, hcard_G, hℓ2]
        obtain ⟨σ, h_erase⟩ := Finset.card_eq_one.mp hcard_erase
        have h_sum_G : (∑ τ : G, act τ (ϖ_K : K)) = (ϖ_K : K) + act σ (ϖ_K : K) := by
          rw [← Finset.add_sum_erase Finset.univ (fun τ : G => act τ (ϖ_K : K)) (Finset.mem_univ 1),
            h_erase, Finset.sum_singleton, hact_one]
        have h_prod_G : (∏ τ : G, act τ (ϖ_K : K)) = (ϖ_K : K) * act σ (ϖ_K : K) := by
          rw [← Finset.mul_prod_erase Finset.univ (fun τ : G => act τ (ϖ_K : K)) (Finset.mem_univ 1),
            h_erase, Finset.prod_singleton, hact_one]
        have h_tr_sum : (ϖ_K : K) + act σ (ϖ_K : K) = 0 := by
          rw [← h_sum_G, ← hact_trace (ϖ_K : K), htr_ϖ, map_zero]
        have h_nm_prod : IntermediateField.inclusion hLK ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) =
            (ϖ_K : K) * act σ (ϖ_K : K) := by
          change IntermediateField.inclusion hLK (normLM F hLK (ϖ_K : K)) = _
          rw [hact_norm (ϖ_K : K), h_prod_G]
        rw [h_nm_prod]
        linear_combination (ϖ_K : K) * h_tr_sum
      exact ⟨ϖ_K, hϖ_K_val, hϖ_L, hν₁_ϖ, fun _ => ⟨htr_ϖ, hsq_ϖ⟩⟩
    · obtain ⟨hϖ_L, hν₁_ϖ⟩ := h_norm_props ϖ_K₀ hϖ_K₀
      exact ⟨ϖ_K₀, hϖ_K₀, hϖ_L, hν₁_ϖ, fun h => False.elim (hℓ2 h)⟩
  exact ⟨hTraceBound, hNormRem, hUniformizer⟩

theorem ld_tame_conductor_formulas_and_unramified_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hℓ_ne0 : (Module.finrank L (IntermediateField.extendScalars hLK) : L) ≠ 0)
    (hℓ_val0 : valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0)
    (hν₁_triv1 : ∀ u ∈ unitGroup F L 1, ν₁ u = 1)
    (hν₁_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      j ≠ 0 → condExp F L (ν₁ ^ j) = 1)
    (hroot_exh : ∀ u₁ : Lˣ, ν₁ u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ,
      ξ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1 →
      ∃ k < Module.finrank L (IntermediateField.extendScalars hLK), (ν₁ u₁) ^ k = ξ)
    (hValNorm : ∀ y : K, valL F K y = valL F L (normLM F hLK y))
    (hValAlg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hTraceBound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) - 1) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hNormRem : ∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
      normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        2 * valL F K y ≤
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
            valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
