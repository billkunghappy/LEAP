    intro s t_s e₀ hts_val hδ
    set δ_s : L := s - (((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s))
    have hid : β * s = β * δ_s + (β * (((e₀ : ℕ) : L) * s₁) + β * (t_s ^ p - t_s)) := by
      dsimp only [δ_s]; ring
    rw [hid, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
      hψ_β_triv δ_s hδ, hψ_nat_mul (e₀ : ℕ) s₁, hψ_β_as t_s hts_val, one_mul, mul_one]
  have hζ_pow_p : ζ ^ p = 1 := by
    rw [← hψ_nat_mul p s₁]
    apply hψ_β_triv ((p : L) * s₁)
    rcases hval_mul_ge_L hp_valL hs₁_val with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hζ_ne1 : ζ ≠ 1 := by
    intro hζ1
    obtain ⟨x₁, _, hx₁_val, hx₁_ψ⟩ := hSpecL.2.1
    let u_β : Lˣ := Units.mk0 β hβ_ne0
    let s_test : L := ((u_β⁻¹ : Lˣ) : L) * x₁
    have hs_test_val : s_test = 0 ∨ 0 ≤ valL F L s_test := by
      dsimp only [s_test]
      have huβ_inv : valL F L ((u_β⁻¹ : Lˣ) : L) = condExpChar F L ψ + 1 := by
        rw [hval_inv_L u_β]
        change - valL F L β = condExpChar F L ψ + 1
        rw [hβ_val, neg_neg]
