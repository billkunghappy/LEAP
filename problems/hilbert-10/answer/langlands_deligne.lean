        ψ_k (Algebra.trace k_L k_M ((ℓ : k_M) * u₁ i * v₂ ^ (q_L ^ (s_star i.1).1))))).symm
    simp_rw [h_inner_prod]
    rw [← Fintype.prod_sum (fun (i : S_plus) (u₁ : k_M) =>
      ∑ u₂ : k_M, ψ_k (Algebra.trace k_L k_M ((ℓ : k_M) * u₁ * u₂ ^ (q_L ^ (s_star i.1).1))))]
    have htr_surj : Function.Surjective (Algebra.trace k_L k_M) :=
      Algebra.trace_surjective k_L k_M
    have hψM_orth : ∀ c : k_M, c ≠ 0 →
        (∑ y : k_M, ψ_k (Algebra.trace k_L k_M (c * y))) = 0 := by
      intro c hc
      have hex_x₀ : ∃ x₀ : k_L, ψ_k x₀ ≠ 1 := by
        by_contra hall
        push_neg at hall
        apply hψ_k
        ext x
        rw [hall x, AddChar.one_apply]
      obtain ⟨x₀, hx₀⟩ := hex_x₀
      obtain ⟨y₀, hy₀⟩ := htr_surj x₀
      have hshift : (∑ y : k_M, ψ_k (Algebra.trace k_L k_M (c * y))) =
          (∑ y : k_M, ψ_k (Algebra.trace k_L k_M (c * y))) * ψ_k x₀ := by
        conv_lhs =>
          rw [← Fintype.sum_equiv (Equiv.addRight (c⁻¹ * y₀))
            (fun y => ψ_k (Algebra.trace k_L k_M (c * (y + c⁻¹ * y₀))))
            (fun y => ψ_k (Algebra.trace k_L k_M (c * y))) (fun _ => rfl)]
        have hterm : ∀ y : k_M,
            ψ_k (Algebra.trace k_L k_M (c * (y + c⁻¹ * y₀))) =
              ψ_k (Algebra.trace k_L k_M (c * y)) * ψ_k x₀ := by
          intro y
          have h1 : c * (y + c⁻¹ * y₀) = c * y + y₀ := by
            rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hc, one_mul]
          rw [h1, map_add, hψk_add, hy₀]
        simp_rw [hterm, ← Finset.sum_mul]
      have hsub : (∑ y : k_M, ψ_k (Algebra.trace k_L k_M (c * y))) * (ψ_k x₀ - 1) = 0 := by
        calc (∑ y : k_M, ψ_k (Algebra.trace k_L k_M (c * y))) * (ψ_k x₀ - 1)
            = (∑ y : k_M, ψ_k (Algebra.trace k_L k_M (c * y))) * ψ_k x₀ -
                (∑ y : k_M, ψ_k (Algebra.trace k_L k_M (c * y))) := by ring
          _ = 0 := sub_eq_zero.mpr hshift.symm
      exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hx₀)
    have hℓ_kM_ne0 : (ℓ : k_M) ≠ 0 := by
      have h1 : (ℓ : k_M) = algebraMap k_L k_M (ℓ : k_L) := (map_natCast (algebraMap k_L k_M) ℓ).symm
      rw [h1]
      exact (map_ne_zero_iff (algebraMap k_L k_M) (algebraMap k_L k_M).injective).mpr hNeChar
    have hfactor_eval : ∀ i : S_plus,
        (∑ u₁ : k_M, ∑ u₂ : k_M,
          ψ_k (Algebra.trace k_L k_M ((ℓ : k_M) * u₁ * u₂ ^ (q_L ^ (s_star i.1).1)))) =
          (q_L : Ω F) ^ f_H := by
      intro i
      rw [Finset.sum_comm]
      rw [Finset.sum_eq_single (0 : k_M)]
      · have hqL_pos : 0 < q_L := Fintype.card_pos
        have hpow_ne0 : q_L ^ (s_star i.1).1 ≠ 0 := pow_ne_zero _ hqL_pos.ne'
        simp [zero_pow hpow_ne0, hψk_0, hcard_kM]
      · intro u₂ _ hu₂
        have hc_ne0 : (ℓ : k_M) * u₂ ^ (q_L ^ (s_star i.1).1) ≠ 0 :=
          mul_ne_zero hℓ_kM_ne0 (pow_ne_zero _ hu₂)
        have hrew : ∀ u₁ : k_M,
            (ℓ : k_M) * u₁ * u₂ ^ (q_L ^ (s_star i.1).1) =
              ((ℓ : k_M) * u₂ ^ (q_L ^ (s_star i.1).1)) * u₁ := fun _ => by ring
        simp_rw [hrew]
        exact hψM_orth ((ℓ : k_M) * u₂ ^ (q_L ^ (s_star i.1).1)) hc_ne0
      · intro habs
        exact False.elim (habs (Finset.mem_univ _))
    simp_rw [hfactor_eval]
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_coe, ← pow_mul]
    have hsign1 : (-1 : Ω F) ^ (r * (f_H - 1)) = 1 := by
      have hf_sub : f_H - 1 = 2 * (f_H / 2) := by omega
      rw [hf_sub, ← mul_assoc, mul_comm r 2, mul_assoc, pow_mul, neg_one_sq, one_pow]
    have hexp_eq : f_H * S_plus.card = (ℓ - 1) / 2 := by
      have hmul2 : 2 * (f_H * S_plus.card) = ℓ - 1 := by
        calc 2 * (f_H * S_plus.card) = (2 * S_plus.card) * f_H := by ring
          _ = r * f_H := by rw [← hr_even]
          _ = ℓ - 1 := hr_mul
      omega
    rw [hsign1, one_mul, hexp_eq]

theorem ld_ch13_third_main_lemma_tame (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
