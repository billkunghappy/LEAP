    set t : A := - (((p : ℕ) : A) * (Nat.gcdB j p : A))
    have ht_val : t = 0 ∨ 1 ≤ valL F A t := by
      have hmul := hval_mul_ge_A 1 0 ((p : ℕ) : A) (Nat.gcdB j p : A) hp_valA
        (hval_int_A (Nat.gcdB j p))
      rw [add_zero] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (by dsimp [t]; rw [h0, neg_zero])
      · right
