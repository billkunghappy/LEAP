  have hz₂_ne : z₂ ≠ 0 := mul_ne_zero (Units.ne_zero cE'⁻¹) hδ₂_sq_ne
  have hz₂_val : valL F E' z₂ = 2 * (-(n_ψ + 1) - (r : ℤ)) + 1 := by
    dsimp [z₂]
    rw [hval_mul_E' _ _ (Units.ne_zero cE'⁻¹) hδ₂_sq_ne,
      hval_inv_E' cE', hcE'_val, hnE', hm₂_eq, hT₂_eq, hδ₂_sq_val]
    omega
  obtain ⟨b₀, b₁, hb₀_P, hb₁_ne, hb₁_val, hγ₂_tr_eq⟩ :=
    hE'_odd_coord z₂ (-(n_ψ + 1) - (r : ℤ)) hz₂_ne hz₂_val
  have hγ₂_eq : γ₂ = b₁ * tr_ϖ + (2 : L) * b₀ := by
    dsimp [γ₂, tr_ϖ]; rw [hγ₂_tr_eq]; ring
  have hb₁_tr_ne : b₁ * tr_ϖ ≠ 0 := mul_ne_zero hb₁_ne htr_ϖ_ne
  have hb₁_tr_val : valL F L (b₁ * tr_ϖ) = -(n_ψ + 1) := by
    rw [hval_mul_L b₁ tr_ϖ hb₁_ne htr_ϖ_ne, hb₁_val, htr_ϖ_val]
    omega
  have h2b₀_P : P_L (-(n_ψ + 1) + 1) ((2 : L) * b₀) :=
    hPL_mono (by omega) (hPL_mul h2_PL hb₀_P)
  have hγ₂_strict : γ₂ ≠ 0 ∧ valL F L γ₂ = -(n_ψ + 1) := by
    rw [hγ₂_eq]
    exact hval_add_strict_L hb₁_tr_ne hb₁_tr_val h2b₀_P
  obtain ⟨x₁, hx₁_ne, hx₁_ge, hψ_x₁_ne⟩ := hSpecL.2
  have hx₁_val : valL F L x₁ = -(n_ψ + 1) := by
    by_contra hne
    have hge : -n_ψ ≤ valL F L x₁ := by omega
    exact hψ_x₁_ne (hSpecL.1 x₁ (Or.inr hge))
  have hx₁_P : P_L (-(n_ψ + 1)) x₁ := Or.inr (le_of_eq hx₁_val.symm)
  have hψ_x₁_congr : ∀ {u v : L}, P_L 1 (u - v) → ψ (x₁ * u) = ψ (x₁ * v) := by
    intro u v huv
    have hdiff : P_L (-n_ψ) (x₁ * (u - v)) :=
      hPL_mono (by omega) (hPL_mul hx₁_P huv)
    have hψ_diff : ψ (x₁ * (u - v)) = 1 := hSpecL.1 _ hdiff
    have hadd : x₁ * u = x₁ * v + x₁ * (u - v) := by ring
    rw [hadd, ψ.map_add_eq_mul, hψ_diff, mul_one]
  let ψ₀ : AddChar k_L (Ω F) :=
    { toFun := fun a => ψ (x₁ * liftL a)
      map_zero_eq_one' := by rw [hliftL_0, mul_zero, ψ.map_zero_eq_one]
      map_add_eq_mul' := by
        intro a b
        have hsub : P_L 1 (liftL (a + b) - (liftL a + liftL b)) := by
          have hneg : liftL (a + b) - (liftL a + liftL b) =
              -(liftL a + liftL b - liftL (a + b)) := by ring
          rw [hneg]
          exact hPL_neg (hliftL_add_sub a b)
        rw [hψ_x₁_congr hsub, mul_add, ψ.map_add_eq_mul] }
  have hψ₀_apply : ∀ a : k_L, ψ₀ a = ψ (x₁ * liftL a) := fun _ => rfl
  have hψ₀_ne : ψ₀ ≠ 1 := by
    intro h1
    have hψ₀_1 : ψ₀ 1 = 1 := by rw [h1, AddChar.one_apply]
    have hl1_sub : P_L 1 (liftL 1 - 1) := by
      have hl1_P0 : P_L 0 (liftL 1) := (hliftL 1).1
      have h1_P0 : P_L 0 1 := Or.inr (by rw [hval1_L])
      have hsub0 : P_L 0 (liftL 1 - 1) := hPL_sub hl1_P0 h1_P0
      have hres0 : resL (liftL 1 - 1) = 0 := by
        rw [hresL_sub _ _ hl1_P0 h1_P0, (hliftL 1).2, hresL_1, sub_self]
      exact (hresL_ker _ hsub0).mp hres0
    have h_eq : ψ₀ 1 = ψ x₁ := by
      rw [hψ₀_apply, hψ_x₁_congr hl1_sub, mul_one]
    rw [h_eq] at hψ₀_1
    exact hψ_x₁_ne hψ₀_1
  set u_x₁ : Lˣ := Units.mk0 x₁ hx₁_ne
  have h_polar_const : ∀ (γ : L), γ ≠ 0 → valL F L γ = -(n_ψ + 1) →
      ∃ d : k_L, d ≠ 0 ∧ ∀ a b : k_L, ψ (γ * liftL a * liftL b) = ψ₀ (d * a * b) := by
    intro γ hγ_ne hγ_val
    set q_γ : L := γ * ((u_x₁⁻¹ : Lˣ) : L)
    have hq_γ_ne : q_γ ≠ 0 := mul_ne_zero hγ_ne (Units.ne_zero u_x₁⁻¹)
    have hq_γ_val : valL F L q_γ = 0 := by
      dsimp [q_γ]
      rw [hval_mul_L γ _ hγ_ne (Units.ne_zero u_x₁⁻¹), hγ_val, hval_inv_L u_x₁]
      change -(n_ψ + 1) + -valL F L x₁ = 0
      rw [hx₁_val]; omega
    have hq_γ_P0 : P_L 0 q_γ := Or.inr (le_of_eq hq_γ_val.symm)
    set d : k_L := resL q_γ
    have hd_ne : d ≠ 0 := by
      intro hd0
      rcases (hresL_ker q_γ hq_γ_P0).mp hd0 with h0 | hge1
      · exact hq_γ_ne h0
      · omega
    refine ⟨d, hd_ne, fun a b => ?_⟩
    have ha_P0 : P_L 0 (liftL a) := (hliftL a).1
    have hb_P0 : P_L 0 (liftL b) := (hliftL b).1
    have hab_P0 : P_L 0 (liftL a * liftL b) := hPL_mono (by omega) (hPL_mul ha_P0 hb_P0)
    have hprod_P0 : P_L 0 (q_γ * (liftL a * liftL b)) :=
      hPL_mono (by omega) (hPL_mul hq_γ_P0 hab_P0)
    have hdab_P0 : P_L 0 (liftL (d * a * b)) := (hliftL (d * a * b)).1
    have hsub_P0 : P_L 0 (q_γ * (liftL a * liftL b) - liftL (d * a * b)) :=
      hPL_sub hprod_P0 hdab_P0
    have hres_eq : resL (q_γ * (liftL a * liftL b) - liftL (d * a * b)) = 0 := by
      rw [hresL_sub _ _ hprod_P0 hdab_P0, (hresL_ring _ _ hq_γ_P0 hab_P0).2.1,
        (hresL_ring _ _ ha_P0 hb_P0).2.1, (hliftL a).2, (hliftL b).2,
        (hliftL (d * a * b)).2]
      dsimp [d]; ring
    have hsub_P1 : P_L 1 (q_γ * (liftL a * liftL b) - liftL (d * a * b)) :=
      (hresL_ker _ hsub_P0).mp hres_eq
    have hx₁_q_γ : x₁ * (q_γ * (liftL a * liftL b)) = γ * liftL a * liftL b := by
      have hmul_inv : x₁ * ((u_x₁⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_x₁
      dsimp [q_γ]
      linear_combination (γ * (liftL a * liftL b)) * hmul_inv
    rw [← hx₁_q_γ, hψ_x₁_congr hsub_P1, ← hψ₀_apply]
  obtain ⟨d₁, hd₁_ne, hd₁_spec⟩ := h_polar_const γ₁ hγ₁_strict.1 hγ₁_strict.2
  obtain ⟨d₂, hd₂_ne, hd₂_spec⟩ := h_polar_const γ₂ hγ₂_strict.1 hγ₂_strict.2
  have hH₁_quad_ψ₀ : ∀ a b : k_L, H₁ (a + b) = H₁ a * H₁ b * ψ₀ (d₁ * a * b) := by
    intro a b
    rw [hH₁_quad a b, ← hd₁_spec a b]
  have hH₂_quad_ψ₀ : ∀ a b : k_L, H₂ (a + b) = H₂ a * H₂ b * ψ₀ (d₂ * a * b) := by
    intro a b
    rw [hH₂_quad a b, ← hd₂_spec a b]
  let quadMap : k_L → (k_L →+ k_L) := fun lam =>
    { toFun := fun z => z ^ 2 + lam * z
      map_zero' := by ring
      map_add' := by
        intro x y
        calc (x + y) ^ 2 + lam * (x + y)
          _ = (x ^ 2 + lam * x) + (y ^ 2 + lam * y) + (2 : k_L) * (x * y) := by ring
          _ = (x ^ 2 + lam * x) + (y ^ 2 + lam * y) + 0 * (x * y) := by rw [hchar2_kL]
          _ = (x ^ 2 + lam * x) + (y ^ 2 + lam * y) := by ring }
  have hquad_apply : ∀ lam z : k_L, quadMap lam z = z ^ 2 + lam * z := fun _ _ => rfl
  have hquad_ker : ∀ lam z : k_L, quadMap lam z = 0 ↔ (z = 0 ∨ z = lam) := by
    intro lam z
    have hfac : quadMap lam z = z * (z - lam) := by
      rw [hquad_apply]
      calc z ^ 2 + lam * z = z * (z - lam) + (2 : k_L) * (lam * z) := by ring
        _ = z * (z - lam) + 0 * (lam * z) := by rw [hchar2_kL]
        _ = z * (z - lam) := by ring
    rw [hfac, mul_eq_zero, sub_eq_zero]
  have hfrob_inj : Function.Injective (fun b : k_L => b ^ 2) := by
    intro a b hab
    have hsub_sq : (a - b) ^ 2 = 0 := by
      calc (a - b) ^ 2 = (a ^ 2 - b ^ 2) - (2 : k_L) * (a * b - b ^ 2) := by ring
        _ = 0 - 0 * (a * b - b ^ 2) := by rw [sub_eq_zero.mpr hab, hchar2_kL]
        _ = 0 := by ring
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hsub_sq)
  have hfrob_bij : Function.Bijective (fun b : k_L => b ^ 2) :=
    (Fintype.bijective_iff_injective_and_card _).mpr ⟨hfrob_inj, rfl⟩
  have hH₁_ne_zero : ∀ x : k_L, H₁ x ≠ 0 := by
    intro x hx0
    have hxx : x + x = 0 := by
      calc x + x = (2 : k_L) * x := by ring
        _ = 0 * x := by rw [hchar2_kL]
        _ = 0 := zero_mul x
    have hquad_xx := hH₁_quad_ψ₀ x x
    rw [hxx, hH₁_0, hx0, zero_mul, zero_mul] at hquad_xx
    exact one_ne_zero hquad_xx
  refine ⟨hH₁_eval, hH₂_eval, fun lam₁ lam₂ hlam₂_ne hlam₁₂_ne hH_pull => ?_⟩
  have hlam₁_ne : lam₁ ≠ 0 := by
    intro hlam₁_0
    have hpull0 : ∀ b : k_L, H₁ (b ^ 2) = H₂ (quadMap lam₂ b) := by
      intro b
      have hb := hH_pull b
      rw [hlam₁_0, zero_mul, add_zero] at hb
      exact hb
    have hquad_lam₂_0 : quadMap lam₂ lam₂ = 0 := (hquad_ker lam₂ lam₂).mpr (Or.inr rfl)
    have hH₁_lam₂_sq : H₁ (lam₂ ^ 2) = 1 := by
      rw [hpull0 lam₂, hquad_lam₂_0, hH₂_0]
    have hψ₀_triv_sq : ∀ b : k_L, ψ₀ (d₁ * b ^ 2 * lam₂ ^ 2) = 1 := by
      intro b
      have hshift : H₁ ((b + lam₂) ^ 2) = H₁ (b ^ 2) := by
        rw [hpull0 (b + lam₂), map_add, hquad_lam₂_0, add_zero, ← hpull0 b]
      have hsq_add : (b + lam₂) ^ 2 = b ^ 2 + lam₂ ^ 2 := by
        calc (b + lam₂) ^ 2 = b ^ 2 + lam₂ ^ 2 + (2 : k_L) * (b * lam₂) := by ring
          _ = b ^ 2 + lam₂ ^ 2 + 0 * (b * lam₂) := by rw [hchar2_kL]
          _ = b ^ 2 + lam₂ ^ 2 := by ring
      rw [hsq_add, hH₁_quad_ψ₀ (b ^ 2) (lam₂ ^ 2), hH₁_lam₂_sq, mul_one] at hshift
      exact mul_right_eq_self₀.mp hshift |>.resolve_right (hH₁_ne_zero (b ^ 2))
    apply hψ₀_ne
    ext x
    rw [AddChar.one_apply]
    have hd_lam_ne : d₁ * lam₂ ^ 2 ≠ 0 :=
      mul_ne_zero hd₁_ne (pow_ne_zero 2 hlam₂_ne)
    obtain ⟨b, hb_sq⟩ := hfrob_bij.2 ((d₁ * lam₂ ^ 2)⁻¹ * x)
    have hbx : d₁ * b ^ 2 * lam₂ ^ 2 = x := by
      dsimp at hb_sq
      calc d₁ * b ^ 2 * lam₂ ^ 2 = (d₁ * lam₂ ^ 2) * b ^ 2 := by ring
        _ = (d₁ * lam₂ ^ 2) * ((d₁ * lam₂ ^ 2)⁻¹ * x) := by rw [hb_sq]
        _ = ((d₁ * lam₂ ^ 2) * (d₁ * lam₂ ^ 2)⁻¹) * x := by ring
        _ = 1 * x := by rw [mul_inv_cancel₀ hd_lam_ne]
        _ = x := one_mul x
    rw [← hbx]
    exact hψ₀_triv_sq b
  exact (hMissingCoset k_L hchar2_kL ψ₀ hψ₀_ne d₁ d₂ lam₁ lam₂
    hd₁_ne hd₂_ne hlam₁_ne hlam₂_ne hlam₁₂_ne
    (quadMap lam₁) (quadMap lam₂) H₁ H₂ (fun z => H₂ (quadMap lam₂ z))
    (hquad_ker lam₁) (hquad_ker lam₂) hH₁_0 hH₂_0
    hH₁_quad_ψ₀ hH₂_quad_ψ₀ hH_pull (fun _ => rfl)).symm

theorem ld_ch12_wild_dyadic_even_breaks_equal_newton_trace_and_quad_pullback (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (heq : condExp F L νM₁' = condExp F L νE')
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hval_normK₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w ∧
      valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = 2 * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = 2 * valL F M₁' z)
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
    (hm2_min : condExp F E' (recChar F rec E' χE') =
      condExp F L νM₁' + condExp F L νE' - 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (liftL : k_L → L)
    (hliftL_0 : liftL 0 = 0)
    (hliftL : ∀ a : k_L, (liftL a = 0 ∨ 0 ≤ valL F L (liftL a)) ∧ resL (liftL a) = a)
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ 2 * m - (condExp F L νM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ 2 * m - (2 * (condExp F L νE' : ℤ) - (condExp F L νM₁' : ℤ)) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (ϖ_E' : E'ˣ) (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hBasis_E' : ∀ y : E', ∃ c : Fin 2 → L,
      y = ∑ i : Fin 2, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin 2, c i = 0 ∨ m ≤ 2 * valL F L (c i) + (i : ℤ))
    (ϖ_K₁ : K₁ˣ) (hϖ_K₁ : valL F K₁ (ϖ_K₁ : K₁) = 1)
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁')
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))) :
    ∃ (δ₁ : M₁'ˣ) (δ₂ : E'ˣ) (lam₁ lam₂ : k_L),
      valL F M₁' (δ₁ : M₁') = ((condExp F M₁' (recChar F rec M₁' χM₁') / 2 : ℕ) : ℤ) ∧
      valL F E' (δ₂ : E') = ((condExp F E' (recChar F rec E' χE') / 2 : ℕ) : ℤ) ∧
      (ϖ_K₁ : K₁) ^ 2 -
        IntermediateField.inclusion hM₁'K₁ (traceLM F hM₁'K₁ (ϖ_K₁ : K₁)) * (ϖ_K₁ : K₁) +
        IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (ϖ_K₁ : K₁)) = 0 ∧
      (ϖ_K₁ : K₁) ^ 2 -
        IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ (ϖ_K₁ : K₁)) * (ϖ_K₁ : K₁) +
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (ϖ_K₁ : K₁)) = 0 ∧
      (IntermediateField.inclusion hLM₁' (liftL lam₁) -
          (-1 : M₁') ^ (condExp F L νE' / 2 - 1) *
            (normLM F hM₁'K₁ (ϖ_K₁ : K₁) ^ (condExp F L νE' / 2))⁻¹ *
            traceLM F hM₁'K₁ (ϖ_K₁ : K₁) = 0 ∨
        1 ≤ valL F M₁'
          (IntermediateField.inclusion hLM₁' (liftL lam₁) -
            (-1 : M₁') ^ (condExp F L νE' / 2 - 1) *
              (normLM F hM₁'K₁ (ϖ_K₁ : K₁) ^ (condExp F L νE' / 2))⁻¹ *
              traceLM F hM₁'K₁ (ϖ_K₁ : K₁))) ∧
      (IntermediateField.inclusion hLE' (liftL lam₂) -
          (-1 : E') ^ (condExp F L νE' / 2 - 1) *
            (normLM F hE'K₁ (ϖ_K₁ : K₁) ^ (condExp F L νE' / 2))⁻¹ *
            traceLM F hE'K₁ (ϖ_K₁ : K₁) = 0 ∨
        1 ≤ valL F E'
          (IntermediateField.inclusion hLE' (liftL lam₂) -
            (-1 : E') ^ (condExp F L νE' / 2 - 1) *
              (normLM F hE'K₁ (ϖ_K₁ : K₁) ^ (condExp F L νE' / 2))⁻¹ *
              traceLM F hE'K₁ (ϖ_K₁ : K₁))) ∧
      (∀ b : k_L,
        (IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b)) = 0 ∨
          0 ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b)))) ∧
        ∀ hz : 1 + ((ϖ_K₁ ^ (2 * (condExp F L νE' / 2) - 1) : K₁ˣ) : K₁) *
            IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b)) ≠ 0,
          ((((Units.map (normLM F hM₁'K₁)
                (Units.mk0 (1 + ((ϖ_K₁ ^ (2 * (condExp F L νE' / 2) - 1) : K₁ˣ) : K₁) *
                  IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b))) hz) : M₁'ˣ) : M₁') - 1) -
              (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL (b ^ 2 + lam₁ * b)) = 0 ∨
            (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤
              valL F M₁'
                ((((Units.map (normLM F hM₁'K₁)
                    (Units.mk0 (1 + ((ϖ_K₁ ^ (2 * (condExp F L νE' / 2) - 1) : K₁ˣ) : K₁) *
                      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b))) hz) : M₁'ˣ) : M₁') - 1) -
                  (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL (b ^ 2 + lam₁ * b)))) ∧
          ((((Units.map (normLM F hE'K₁)
                (Units.mk0 (1 + ((ϖ_K₁ ^ (2 * (condExp F L νE' / 2) - 1) : K₁ˣ) : K₁) *
                  IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b))) hz) : E'ˣ) : E') - 1) -
              (δ₂ : E') * IntermediateField.inclusion hLE' (liftL (b ^ 2 + lam₂ * b)) = 0 ∨
            (((condExp F E' (recChar F rec E' χE') + 1) / 2 : ℕ) : ℤ) ≤
              valL F E'
                ((((Units.map (normLM F hE'K₁)
                    (Units.mk0 (1 + ((ϖ_K₁ ^ (2 * (condExp F L νE' / 2) - 1) : K₁ˣ) : K₁) *
                      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b))) hz) : E'ˣ) : E') - 1) -
                  (δ₂ : E') * IntermediateField.inclusion hLE' (liftL (b ^ 2 + lam₂ * b))))) :=
by
  classical
  set T₁ : ℕ := condExp F L νM₁'
  set T₂ : ℕ := condExp F L νE'
  set r : ℕ := T₂ / 2
  set t₂ : ℕ := 2 * r - 1
  set θE' := recChar F rec E' χE'
  set θM₁' := recChar F rec M₁' χM₁'
  set m₁ : ℕ := condExp F M₁' θM₁'
  set m₂ : ℕ := condExp F E' θE'
  have hr_ge1 : 1 ≤ r := by omega
  have hT₂_eq : T₂ = 2 * r := by omega
  have hT₁_eq : T₁ = 2 * r := by omega
  have hT₁_div : T₁ / 2 = r := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by omega
  have ht₂_odd : t₂ = 2 * (r - 1) + 1 := by omega
  have ht₂_split : t₂ = (r - 1) + r := by omega
  have hm₁_eq : m₁ = 4 * r - 1 := by omega
  have hm₂_eq : m₂ = 4 * r - 1 := by omega
  have hd₁_eq : m₁ / 2 = t₂ := by omega
  have hd₂_eq : m₂ / 2 = t₂ := by omega
  have hr₀₁_eq : (m₁ + 1) / 2 = 2 * r := by omega
  have hr₀₂_eq : (m₂ + 1) / 2 = 2 * r := by omega
  have hdegE'K₁_2 : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 :=
    hdegE'K₁.trans hdeg2
  have hdegM₁'K₁_2 : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 :=
    hdegM₁'K₁.trans hdeg2
  rcases hvalL_props with
    ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
      _, hval_add_L, _, _, _⟩
  rcases hvalK₁_props with
    ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁,
      _, hval_add_K₁, _, _, _⟩
  have hval_sub_L : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    have hneg2 : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_L]; exact hge)
    exact hval_add_L k x₁ (-x₂) hx₁ hneg2
  have hresL_sub : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    have hneg2 : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_L]; exact hge)
    have hadd := (hresL_ring x₁ (-x₂) hx₁ hneg2).1
    have hneg := (hresL_ring x₂ x₂ hx₂ hx₂).2.2
    rw [sub_eq_add_neg, hadd, hneg, ← sub_eq_add_neg]
  have hmul_int_L : ∀ {x₁ x₂ : L},
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        (x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ hx₁ hx₂
    by_cases h1 : x₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : x₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rw [hval_mul_L x₁ x₂ h1 h2]
        have hg1 := hx₁.resolve_left h1
        have hg2 := hx₂.resolve_left h2
        omega
  have hquad_lift_L : ∀ (lam b : k_L),
      let s := liftL b
      let s_lam := liftL lam
      let s_quad := liftL (b ^ 2 + lam * b)
      s ^ 2 + s_lam * s - s_quad = 0 ∨ 1 ≤ valL F L (s ^ 2 + s_lam * s - s_quad) := by
    intro lam b s s_lam s_quad
    have hs_int : s = 0 ∨ 0 ≤ valL F L s := (hliftL b).1
    have hsl_int : s_lam = 0 ∨ 0 ≤ valL F L s_lam := (hliftL lam).1
    have hsq_int : s_quad = 0 ∨ 0 ≤ valL F L s_quad := (hliftL (b ^ 2 + lam * b)).1
    have hs2_int : s ^ 2 = 0 ∨ 0 ≤ valL F L (s ^ 2) := by
      rw [sq]; exact hmul_int_L hs_int hs_int
    have hsls_int : s_lam * s = 0 ∨ 0 ≤ valL F L (s_lam * s) := hmul_int_L hsl_int hs_int
    have hsum_int : s ^ 2 + s_lam * s = 0 ∨ 0 ≤ valL F L (s ^ 2 + s_lam * s) :=
      hval_add_L 0 _ _ hs2_int hsls_int
    have hdiff_int : s ^ 2 + s_lam * s - s_quad = 0 ∨
        0 ≤ valL F L (s ^ 2 + s_lam * s - s_quad) :=
      hval_sub_L 0 _ _ hsum_int hsq_int
    apply (hresL_ker _ hdiff_int).mp
    rw [hresL_sub _ _ hsum_int hsq_int,
      (hresL_ring (s ^ 2) (s_lam * s) hs2_int hsls_int).1,
      sq, (hresL_ring s s hs_int hs_int).2.1, ← sq,
      (hresL_ring s_lam s hsl_int hs_int).2.1,
      (hliftL b).2, (hliftL lam).2, (hliftL (b ^ 2 + lam * b)).2, sub_self]
  have htr_smul_gen : ∀ (K S : Type u) [CommRing K] [CommRing S] [Algebra K S] (a : K) (y : S),
      Algebra.trace K S (algebraMap K S a * y) = a * Algebra.trace K S y := by
    clear * -
    intro K S _ _ _ a y
    rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  have hCH_gen : ∀ (M₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] (hM₀K₁ : M₀ ≤ K₁),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀K₁) = 2 →
      ∀ w : K₁,
        w ^ 2 - IntermediateField.inclusion hM₀K₁ (traceLM F hM₀K₁ w) * w +
          IntermediateField.inclusion hM₀K₁ (normLM F hM₀K₁ w) = 0 := by
    clear * -
    intro M₀ _ hM₀K₁ hdeg w
    let K₂ : IntermediateField M₀ (AlgebraicClosure F) := IntermediateField.extendScalars hM₀K₁
    haveI : FiniteDimensional F K₂ := ‹FiniteDimensional F K₁›
    haveI : IsScalarTower F M₀ K₂ := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional M₀ K₂ := Module.Finite.of_restrictScalars_finite F M₀ K₂
    let b : Module.Basis (Fin 2) M₀ K₂ := (Module.finBasis M₀ K₂).reindex (finCongr hdeg)
    let y : K₂ := toExtendScalars F hM₀K₁ w
    let A : Matrix (Fin 2) (Fin 2) M₀ := Algebra.leftMulMatrix b y
    have htr_y : traceLM F hM₀K₁ w = A 0 0 + A 1 1 := by
      change Algebra.trace M₀ K₂ y = _
      rw [Algebra.trace_eq_matrix_trace b y, Matrix.trace_fin_two A]
    have hnorm_y : normLM F hM₀K₁ w = A 0 0 * A 1 1 - A 0 1 * A 1 0 := by
      change Algebra.norm M₀ y = _
      rw [Algebra.norm_eq_matrix_det b y, Matrix.det_fin_two A]
    have hA : ∀ i j : Fin 2, A i j = b.repr (y * b j) i := fun i j =>
      Algebra.leftMulMatrix_eq_repr_mul b y i j
    have hexp : ∀ z : K₂,
        z = algebraMap M₀ K₂ (b.repr z 0) * b 0 + algebraMap M₀ K₂ (b.repr z 1) * b 1 := by
      intro z
      conv_lhs => rw [← b.sum_repr z]
      rw [Fin.sum_univ_two, Algebra.smul_def, Algebra.smul_def]
    have hb0 : y * b 0 = algebraMap M₀ K₂ (A 0 0) * b 0 + algebraMap M₀ K₂ (A 1 0) * b 1 := by
      rw [hA 0 0, hA 1 0]
      exact hexp (y * b 0)
    have hb1 : y * b 1 = algebraMap M₀ K₂ (A 0 1) * b 0 + algebraMap M₀ K₂ (A 1 1) * b 1 := by
      rw [hA 0 1, hA 1 1]
      exact hexp (y * b 1)
    have hmul_b0 : (y ^ 2 - algebraMap M₀ K₂ (traceLM F hM₀K₁ w) * y +
        algebraMap M₀ K₂ (normLM F hM₀K₁ w)) * b 0 = 0 := by
      rw [htr_y, hnorm_y, map_add, map_sub, map_mul, map_mul]
      linear_combination (y - algebraMap M₀ K₂ (A 1 1)) * hb0 + algebraMap M₀ K₂ (A 1 0) * hb1
    have hK₂ : y ^ 2 - algebraMap M₀ K₂ (traceLM F hM₀K₁ w) * y +
        algebraMap M₀ K₂ (normLM F hM₀K₁ w) = 0 :=
      (mul_eq_zero.mp hmul_b0).resolve_right (b.ne_zero 0)
    exact Subtype.ext (congrArg Subtype.val hK₂)
  have hnorm_1_add_mul : ∀ (M₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] (hM₀K₁ : M₀ ≤ K₁),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀K₁) = 2 →
      ∀ (w : K₁) (y₀ : M₀),
        normLM F hM₀K₁ (1 + w * IntermediateField.inclusion hM₀K₁ y₀) - 1 =
          traceLM F hM₀K₁ w * y₀ + normLM F hM₀K₁ w * y₀ ^ 2 := by
    intro M₀ _ hM₀K₁ hdeg2_M₀ w y₀
    have htr_mul : traceLM F hM₀K₁ (w * IntermediateField.inclusion hM₀K₁ y₀) =
        traceLM F hM₀K₁ w * y₀ := by
      rw [mul_comm w, mul_comm (traceLM F hM₀K₁ w)]
      exact htr_smul_gen M₀ (IntermediateField.extendScalars hM₀K₁) y₀ (toExtendScalars F hM₀K₁ w)
    have hnorm0 : normLM F hM₀K₁ 0 = 0 := by
      have h10 := ((hQuadNorm M₀ K₁ hM₀K₁ hdeg2_M₀).2 1 0).1
      simp only [map_one, add_zero, one_pow, map_zero, mul_zero, one_mul] at h10
      exact eq_of_sub_eq_zero (by linear_combination -h10)
    have hnorm_incl : normLM F hM₀K₁ (IntermediateField.inclusion hM₀K₁ y₀) = y₀ ^ 2 := by
      have hy0 := ((hQuadNorm M₀ K₁ hM₀K₁ hdeg2_M₀).2 y₀ 0).1
      rw [add_zero, map_zero, mul_zero, add_zero, hnorm0, add_zero] at hy0
      exact hy0
    have hnorm_mul : normLM F hM₀K₁ (w * IntermediateField.inclusion hM₀K₁ y₀) =
        normLM F hM₀K₁ w * y₀ ^ 2 := by
      rw [map_mul, hnorm_incl]
    have hquad := ((hQuadNorm M₀ K₁ hM₀K₁ hdeg2_M₀).2 1
      (w * IntermediateField.inclusion hM₀K₁ y₀)).1
    rw [map_one, one_pow, one_mul, htr_mul, hnorm_mul] at hquad
    linear_combination hquad
  set π : K₁ := (ϖ_K₁ : K₁)
  have hBranch_gen : ∀ (M₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] (hLM₀ : L ≤ M₀) (hM₀K₁ : M₀ ≤ K₁),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀K₁) = 2 →
      (∀ x : L, valL F M₀ (IntermediateField.inclusion hLM₀ x) = 2 * valL F L x) →
      (∀ w : K₁, valL F M₀ (normLM F hM₀K₁ w) = valL F K₁ w) →
      (valL F M₀ 0 = 0 ∧ valL F M₀ 1 = 0 ∧ valL F M₀ (-1) = 0 ∧
