        hνE_pow hνE_ne hνE_ker hνE_cond hνM₁_pow hνM₁_ne hνM₁_ker hνM₁_cond
      set ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
      have hCop : Nat.Coprime ℓ 4 := by
        have hCop2 : Nat.Coprime ℓ 2 :=
          (Nat.Prime.coprime_iff_not_dvd hPrime).mpr fun hdvd =>
            hp2 (hWild ▸ ((Nat.dvd_prime Nat.prime_two).mp hdvd).resolve_left hPrime.ne_one)
