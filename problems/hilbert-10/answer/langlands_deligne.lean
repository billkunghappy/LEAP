    rw [hval_mul_L (α₀ * 2) (traceLM F hLE' x_star) (mul_ne_zero hα₀_ne0 h2_ne0) htr_x_star_ne0,
      hval_mul_L α₀ 2 hα₀_ne0 h2_ne0, hα₀_val, h2_val0, htr_x_star_val]
