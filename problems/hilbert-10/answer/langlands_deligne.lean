            if hx : e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹ ∈ M_lam then
              (ψ_lam ⟨e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹, hx⟩ : Ω F)
            else 0) =
          ∑ _z : M_lam,
            (if hm : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ M_lam then
              (ψ_lam ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hm⟩ : Ω F)
            else 0) :=
        Finset.sum_congr rfl fun z _ => h_term_inv u₀ z
      rw [h_congr, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
    rw [Finset.sum_congr rfl fun u₀ _ => h_inner u₀, ← Finset.mul_sum]
  rw [h_sum_G]
  have h_card_pos : 0 < Nat.card M_lam := Nat.card_pos
  have h_card_ne_zero : (Nat.card M_lam : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_pos.ne'
  exact (inv_mul_cancel_left₀ h_card_ne_zero _).symm

theorem ld_abelian_normal_indCharTrace_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (H : Subgroup G) :
    ∃ (L_mon : List (Σ (M : Subgroup G), (M →* (Ω F)ˣ))),
      (∀ p ∈ L_mon, C ≤ p.1) ∧
      ∀ g : G,
        indCharTrace F H 1 g =
          (L_mon.map fun p => indCharTrace F p.1 p.2 g).sum :=
by
  have h_prod_case : ∀ (d : ℕ) (M : Type u) [Group M] [Fintype M]
      (C' : Subgroup M) [C'.Normal]
      (hC'_ab : ∀ a ∈ C', ∀ b ∈ C', a * b = b * a)
      (H' : Subgroup M) (hM_mul : ∀ m : M, ∃ h ∈ H', ∃ c ∈ C', m = h * c)
      {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q]
      (σ : Representation (Ω F) M Q)
      (π : leftInvSpace F H' →ₗ[Ω F] Q),
      Function.Surjective π →
      (∀ m : M, π ∘ₗ rightTransRep F H' m = σ m ∘ₗ π) →
      Module.finrank (Ω F) Q = d →
      ∃ (L_Q : List (Σ (K : Subgroup M), (K →* (Ω F)ˣ))),
        (∀ p ∈ L_Q, C' ≤ p.1) ∧
        ∀ m : M,
          LinearMap.trace (Ω F) Q (σ m) =
            (L_Q.map fun p => indCharTrace F p.1 p.2 m).sum := by
    intro d
    induction' d using Nat.strong_induction_on with d ih
    intro M _ _ C' _ hC'_ab H' hM_mul Q _ _ _ σ π hπ_surj hπ_inter hd
    rcases Nat.eq_zero_or_pos (Module.finrank (Ω F) Q) with hd0 | hd_pos
    · haveI : Subsingleton Q := Module.finrank_zero_iff.mp hd0
      refine ⟨[], by simp, fun m => ?_⟩
      have h0 : σ m = 0 := Subsingleton.elim _ _
      simp [h0]
    · haveI : Nontrivial Q := Module.nontrivial_of_finrank_pos hd_pos
      obtain ⟨lam, M_lam, ψ_lam, w_bar, hC'_le, hM_lam, hw_ne, hw_C, hw_M⟩ :=
        ld_fourier_weight_lift_and_stabilizer_char F M C' hC'_ab H' hM_mul σ π hπ_surj hπ_inter
      obtain ⟨W, hW, hW_ne_bot, hW_tr⟩ :=
        ld_weight_orbit_submodule_trace F M C' σ lam M_lam hM_lam ψ_lam w_bar hw_ne hw_C hw_M
      haveI : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hW_ne_bot
      have hW_pos : 0 < Module.finrank (Ω F) W := Module.finrank_pos
      have h_add_dim : Module.finrank (Ω F) (Q ⧸ W) + Module.finrank (Ω F) W =
          Module.finrank (Ω F) Q :=
        Submodule.finrank_quotient_add_finrank W
      have h_lt : Module.finrank (Ω F) (Q ⧸ W) < d := by omega
      let π' : leftInvSpace F H' →ₗ[Ω F] (Q ⧸ W) := W.mkQ ∘ₗ π
      have hπ'_surj : Function.Surjective π' :=
        (Submodule.mkQ_surjective W).comp hπ_surj
      have hπ'_inter : ∀ m : M, π' ∘ₗ rightTransRep F H' m = quotRep σ W hW m ∘ₗ π' := by
        intro m
        have hq_comm : W.mkQ ∘ₗ σ m = quotRep σ W hW m ∘ₗ W.mkQ := by
          ext x
          rfl
        calc W.mkQ ∘ₗ π ∘ₗ rightTransRep F H' m
            = W.mkQ ∘ₗ (π ∘ₗ rightTransRep F H' m) := rfl
          _ = W.mkQ ∘ₗ (σ m ∘ₗ π) := by rw [hπ_inter m]
          _ = (W.mkQ ∘ₗ σ m) ∘ₗ π := rfl
          _ = (quotRep σ W hW m ∘ₗ W.mkQ) ∘ₗ π := by rw [hq_comm]
          _ = quotRep σ W hW m ∘ₗ (W.mkQ ∘ₗ π) := rfl
      obtain ⟨L_quot, hL_quot_le, hL_quot_tr⟩ :=
        ih (Module.finrank (Ω F) (Q ⧸ W)) h_lt M C' hC'_ab H' hM_mul
          (quotRep σ W hW) π' hπ'_surj hπ'_inter rfl
      have h_quot_add := (ld_rightTransRep_trace_and_quot_add F M).2 σ W hW
      refine ⟨⟨M_lam, ψ_lam⟩ :: L_quot, ?_, ?_⟩
      · intro p hp
        rw [List.mem_cons] at hp
        rcases ht : hp with rfl | hp
        · exact hC'_le
        · exact hL_quot_le p hp
      · intro m
        simp only [List.map_cons, List.sum_cons]
        rw [h_quot_add m, hW_tr m, hL_quot_tr m]
  obtain ⟨M, hC'_norm, hC'_ab, hM_mul, h_push⟩ :=
    ld_indCharTrace_prod_subgroup_pushforward F G C hC_ab H
  haveI : (C.subgroupOf M).Normal := hC'_norm
  obtain ⟨L_M, hL_M_le, hL_M_tr⟩ :=
    h_prod_case (Module.finrank (Ω F) (leftInvSpace F (H.subgroupOf M)))
      M (C.subgroupOf M) hC'_ab (H.subgroupOf M) hM_mul
      (rightTransRep F (H.subgroupOf M)) LinearMap.id
      Function.surjective_id (fun _ => rfl) rfl
  have h_tr_init := (ld_rightTransRep_trace_and_quot_add F M).1 (H.subgroupOf M)
  apply h_push L_M hL_M_le
  intro m
  rw [← h_tr_init m, hL_M_tr m]

theorem ld_trivial_ind_abelian_normal_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hdeg : 1 < Module.finrank L (IntermediateField.extendScalars hLK)) :
    ∃ (M_C : IntermediateField F (AlgebraicClosure F)) (hLM_C : L ≤ M_C),
      M_C ≤ K ∧ IsGaloisExt F L M_C ∧
      Module.finrank L (IntermediateField.extendScalars hLM_C) <
        Module.finrank L (IntermediateField.extendScalars hLK) ∧
      ∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E),
        E ≤ K →
        ∃ D₀ : List (MonomialTerm F L),
          (∀ t ∈ D₀, t.field ≤ M_C) ∧
          IsMonomialDecomp F L 0
            (⟨1, E, hLE, 1⟩ :: D₀.map (MonomialTerm.neg F L)) :=
by
  obtain ⟨C, hC_norm, hC_ne, hC_ab⟩ :=
    ld_local_galois_abelian_normal_subgroup F L K hLK hGal hdeg
  haveI : C.Normal := hC_norm
  obtain ⟨hFinL, hFinK, hGalLK, ⟨π, hπ, hsurj⟩, hLM_C, hM_CK, hGalM_C, hlt⟩ :=
    ld_galois_normal_fixedField_and_weil_proj F L K hLK hGal C hC_ne
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F K := hFinK
  haveI : IsGalois L (IntermediateField.extendScalars hLK) := hGalLK
  haveI : FiniteDimensional F (IntermediateField.extendScalars hLK) := hFinK
  haveI : IsScalarTower F L (IntermediateField.extendScalars hLK) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) :=
    Module.Finite.of_restrictScalars_finite F L (IntermediateField.extendScalars hLK)
  set M_C := (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F
  obtain ⟨h_lift_sub, h_lift_field⟩ :=
    ld_weil_galois_indCharTrace_bridge F L K hLK π hπ hsurj
  have htrace_neg : ∀ (D : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (D.map (MonomialTerm.neg F L)) w =
        - monomialListTrace F L D w := by
    intro D w
    induction D with
    | nil => simp [monomialListTrace]
    | cons t tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F L).trace F L w = - (t.trace F L w) := by
        simp [MonomialTerm.neg, MonomialTerm.trace, neg_smul]
      rw [ht, ih]
      ring
  refine ⟨M_C, hLM_C, hM_CK, hGalM_C, hlt, ?_⟩
  intro E hLE hEK
  obtain ⟨hwf_E, H, htr_E⟩ := h_lift_field E hLE hEK
  obtain ⟨L_mon, hL_le, hL_sum⟩ :=
    ld_abelian_normal_indCharTrace_decomp F
      (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) C hC_ab H
  have h_build : ∀ (L_sub : List (Σ (M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)), (M →* (Ω F)ˣ))),
      (∀ p ∈ L_sub, C ≤ p.1) →
      ∃ D₀ : List (MonomialTerm F L),
        (∀ t ∈ D₀, t.field ≤ M_C) ∧
        (∀ t ∈ D₀, t.Wf F L) ∧
        ∀ w : relWeil F L,
          monomialListTrace F L D₀ w =
            (L_sub.map fun p => indCharTrace F p.1 p.2 (π w)).sum := by
    intro L_sub h_sub
    induction L_sub with
    | nil =>
      exact ⟨[], by simp, by simp, fun w => by simp [monomialListTrace]⟩
    | cons p tl ih =>
      have hp : C ≤ p.1 := h_sub p (by simp)
      have htl : ∀ p' ∈ tl, C ≤ p'.1 := fun p' hp' => h_sub p' (by simp [hp'])
      obtain ⟨D_tl, hD_tl_le, hD_tl_wf, hD_tl_tr⟩ := ih htl
      obtain ⟨t_p, ht_p_wf, ht_p_le, ht_p_tr⟩ := h_lift_sub C p.1 hp p.2
      refine ⟨t_p :: D_tl, ?_, ?_, ?_⟩
      · intro t ht
        rw [List.mem_cons] at ht
        rcases ht with rfl | ht
        · exact ht_p_le
        · exact hD_tl_le t ht
      · intro t ht
        rw [List.mem_cons] at ht
        rcases ht with rfl | ht
        · exact ht_p_wf
        · exact hD_tl_wf t ht
      · intro w
        change t_p.trace F L w + monomialListTrace F L D_tl w =
          indCharTrace F p.1 p.2 (π w) + (tl.map fun p => indCharTrace F p.1 p.2 (π w)).sum
        rw [ht_p_tr w, hD_tl_tr w]
  obtain ⟨D₀, hD₀_le, hD₀_wf, hD₀_tr⟩ := h_build L_mon hL_le
  refine ⟨D₀, hD₀_le, ⟨?_, ?_⟩⟩
  · intro t ht
    rw [List.mem_cons] at ht
    rcases ht with rfl | ht
    · exact hwf_E
    · rw [List.mem_map] at ht
      rcases ht with ⟨t₀, ht₀, rfl⟩
      exact hD₀_wf t₀ ht₀
  · intro w
    change 0 = (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w +
      monomialListTrace F L (D₀.map (MonomialTerm.neg F L)) w
    rw [htrace_neg D₀ w, htr_E w, hD₀_tr w, hL_sum (π w), add_neg_cancel]

theorem ld_lambda_uniqueness_and_closure (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F) :
    (∀ n : ℕ, LambdaExistsBelow F rec n → LambdaTheoryBelow F rec n) ∧
    ((∀ n : ℕ, LambdaTheoryBelow F rec n) →
      (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
        (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ → globalLam F rec L L ψ = 1) ∧
      (∀ (L M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
        (h₁ : L ≤ M) (h₂ : M ≤ E),
        Algebra.IsSeparable L (IntermediateField.extendScalars h₁) →
        Algebra.IsSeparable M (IntermediateField.extendScalars h₂) →
        ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
          globalLam F rec L E ψ =
            globalLam F rec M E (traceChar F h₁ ψ) *
              (globalLam F rec L M ψ) ^ (Module.finrank M (IntermediateField.extendScalars h₂))) ∧
      (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
        (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
        ∀ (D : List (MonomialTerm F L)),
          IsMonomialDecomp F L 0 D →
          evalMonomialList F rec (globalLam F rec) L ψ D = 1)) :=
by
  obtain ⟨hDeg1, hGalTower, hGalClos, hGalSup, hGalList⟩ := ld_galois_closure_directed_system F
  have heval_neg : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (lam : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ)
      (ψ : AddChar L (Ω F)) (D : List (MonomialTerm F L)),
      evalMonomialList F rec lam L ψ (D.map (MonomialTerm.neg F L)) =
        (evalMonomialList F rec lam L ψ D)⁻¹ := by
    intro L lam ψ D
    induction D with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have ht : evalMonomialTerm F rec lam L ψ (t.neg F L) =
          (evalMonomialTerm F rec lam L ψ t)⁻¹ := by
        simp [MonomialTerm.neg, evalMonomialTerm, zpow_neg]
      rw [ht, ih, mul_inv]
  have heval_congr : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (lam₁ lam₂ : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ)
      (ψ : AddChar L (Ω F)) (D : List (MonomialTerm F L)),
      (∀ t ∈ D, lam₁ L t.field ψ = lam₂ L t.field ψ) →
      evalMonomialList F rec lam₁ L ψ D = evalMonomialList F rec lam₂ L ψ D := by
    intro L lam₁ lam₂ ψ D hEq
    unfold evalMonomialList
    congr 1
    apply List.map_congr_left
    intro t ht
    simp only [evalMonomialTerm, hEq t ht]
  have hUnique : ∀ (m : ℕ) (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
      IsGaloisExt F L K →
      Module.finrank L (IntermediateField.extendScalars hLK) = m →
      ∀ (ψ : AddChar L (Ω F)) (g₁ g₂ : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ),
        IsLambdaFuncOn F rec L K ψ g₁ →
        IsLambdaFuncOn F rec L K ψ g₂ →
        ∀ E, L ≤ E → E ≤ K → g₁ E = g₂ E := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro L K hLK hGal hdeg ψ g₁ g₂ hg₁ hg₂ E hLE hEK
    by_cases hm : 1 < Module.finrank L (IntermediateField.extendScalars hLK)
    · obtain ⟨M_C, hLM_C, hM_CK, hGalM_C, hlt, hDecomp⟩ :=
        ld_trivial_ind_abelian_normal_decomp F L K hLK hGal hm
      have hg₁_M : IsLambdaFuncOn F rec L M_C ψ g₁ :=
        ⟨hg₁.1, fun D hD hDK => hg₁.2 D hD (fun t ht => (hDK t ht).trans hM_CK)⟩
      have hg₂_M : IsLambdaFuncOn F rec L M_C ψ g₂ :=
        ⟨hg₂.1, fun D hD hDK => hg₂.2 D hD (fun t ht => (hDK t ht).trans hM_CK)⟩
      have hEqM : ∀ F', L ≤ F' → F' ≤ M_C → g₁ F' = g₂ F' :=
        ih _ (hdeg ▸ hlt) L M_C hLM_C hGalM_C rfl ψ g₁ g₂ hg₁_M hg₂_M
      obtain ⟨D₀, hD₀_le, hD₀_zero⟩ := hDecomp E hLE hEK
      have hDK_all : ∀ t ∈ (⟨1, E, hLE, 1⟩ :: D₀.map (MonomialTerm.neg F L)), t.field ≤ K := by
        intro t ht
        rw [List.mem_cons] at ht
        rcases ht with rfl | ht
        · exact hEK
        · rw [List.mem_map] at ht
          rcases ht with ⟨t₀, ht₀, rfl⟩
          exact (hD₀_le t₀ ht₀).trans hM_CK
      have h1 := hg₁.2 _ hD₀_zero hDK_all
      have h2 := hg₂.2 _ hD₀_zero hDK_all
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at h1 h2
      change evalMonomialTerm F rec (fun _ E' _ => g₁ E') L ψ ⟨1, E, hLE, 1⟩ *
        evalMonomialList F rec (fun _ E' _ => g₁ E') L ψ (D₀.map (MonomialTerm.neg F L)) = 1 at h1
      change evalMonomialTerm F rec (fun _ E' _ => g₂ E') L ψ ⟨1, E, hLE, 1⟩ *
        evalMonomialList F rec (fun _ E' _ => g₂ E') L ψ (D₀.map (MonomialTerm.neg F L)) = 1 at h2
      rw [heval_neg] at h1 h2
      have hD₀_eq : evalMonomialList F rec (fun _ E' _ => g₁ E') L ψ D₀ =
          evalMonomialList F rec (fun _ E' _ => g₂ E') L ψ D₀ := by
        apply heval_congr
        intro t₀ ht₀
        have ht₀_wf : t₀.Wf F L :=
          hD₀_zero.1 (t₀.neg F L) (List.mem_cons_of_mem _ (List.mem_map_of_mem ht₀))
        exact hEqM t₀.field t₀.le (hD₀_le t₀ ht₀)
      have hTerm_eq : evalMonomialTerm F rec (fun _ E' _ => g₁ E') L ψ ⟨1, E, hLE, 1⟩ =
          evalMonomialTerm F rec (fun _ E' _ => g₂ E') L ψ ⟨1, E, hLE, 1⟩ := by
        rw [mul_inv_eq_one.mp h1, hD₀_eq, ← mul_inv_eq_one.mp h2]
      simp only [evalMonomialTerm, zpow_one] at hTerm_eq
      exact mul_left_cancel hTerm_eq
    · have hKL : K ≤ L := hDeg1 L K hLK hGal (not_lt.mp hm)
      have hEL : E = L := le_antisymm (hEK.trans hKL) hLE
      rw [hEL, hg₁.1, hg₂.1]
  have hPart1 : ∀ n : ℕ, LambdaExistsBelow F rec n → LambdaTheoryBelow F rec n := by
    intro n hEx
    refine ⟨hEx, ?_, ?_⟩
    · intro L K hLK hGal hlt ψ hψ g hg E hLE hEK
      have hLam : IsLambdaFuncOn F rec L K ψ (galoisLam F rec L K ψ) :=
        hEx L K hLK hGal hlt ψ hψ
      exact hUnique _ L K hLK hGal rfl ψ g (galoisLam F rec L K ψ) hg hLam E hLE hEK
    · intro L M E K hLK h₁ h₂ hEK hGalLK hGalMK hlt ψ hψ
      have hMK : M ≤ K := h₂.trans hEK
      have hLamLK : IsLambdaFuncOn F rec L K ψ (galoisLam F rec L K ψ) :=
        hEx L K hLK hGalLK hlt ψ hψ
      obtain ⟨hψM, hShift⟩ :=
        ld_lambda_base_shift F rec L M K h₁ hMK hGalLK ψ hψ (galoisLam F rec L K ψ) hLamLK
      refine ⟨hψM, ?_⟩
      have hle_deg : Module.finrank M (IntermediateField.extendScalars hMK) ≤
          Module.finrank L (IntermediateField.extendScalars hLK) :=
        (hGalTower L M K h₁ hMK hGalLK).2
      have hlt_M : Module.finrank M (IntermediateField.extendScalars hMK) < n :=
        lt_of_le_of_lt hle_deg hlt
      have hLamMK : IsLambdaFuncOn F rec M K (traceChar F h₁ ψ)
          (galoisLam F rec M K (traceChar F h₁ ψ)) :=
        hEx M K hMK hGalMK hlt_M (traceChar F h₁ ψ) hψM
      have hEq := hUnique _ M K hMK hGalMK rfl (traceChar F h₁ ψ)
        (shiftLamFunc F M (galoisLam F rec L K ψ))
        (galoisLam F rec M K (traceChar F h₁ ψ))
        hShift hLamMK E h₂ hEK
      unfold shiftLamFunc at hEq
      rw [dif_pos h₂] at hEq
      exact mul_inv_eq_iff_eq_mul.mp hEq
  refine ⟨hPart1, ?_⟩
  intro hTheory
  have hGlobal_eq : ∀ (L K E : IntermediateField F (AlgebraicClosure F)),
      IsGaloisExt F L K → L ≤ E → E ≤ K →
      ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
        globalLam F rec L E ψ = galoisLam F rec L K ψ E := by
    intro L K E hGal hLE hEK ψ hψ
    have hex : ∃ K' : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K' ∧ E ≤ K' :=
      ⟨K, hGal, hEK⟩
    unfold globalLam
    rw [dif_pos hex]
    set K₀ := hex.choose
    obtain ⟨hGal₀, hEK₀⟩ := hex.choose_spec
    obtain ⟨K₁₂, hGal₁₂, hK₀_le, hK_le⟩ := hGalSup L K₀ K hGal₀ hGal
    have hLK₁₂ : L ≤ K₁₂ := hGal₁₂.1
    have hLK₀ : L ≤ K₀ := hGal₀.1
    have hLK : L ≤ K := hGal.1
    have hLam₁₂ : IsLambdaFuncOn F rec L K₁₂ ψ (galoisLam F rec L K₁₂ ψ) :=
      (hTheory (Module.finrank L (IntermediateField.extendScalars hLK₁₂) + 1)).1
        L K₁₂ hLK₁₂ hGal₁₂ (Nat.lt_succ_self _) ψ hψ
    have hLam₁₂_on_K₀ : IsLambdaFuncOn F rec L K₀ ψ (galoisLam F rec L K₁₂ ψ) :=
      ⟨hLam₁₂.1, fun D hD hDK₀ => hLam₁₂.2 D hD (fun t ht => (hDK₀ t ht).trans hK₀_le)⟩
    have hLam₁₂_on_K : IsLambdaFuncOn F rec L K ψ (galoisLam F rec L K₁₂ ψ) :=
      ⟨hLam₁₂.1, fun D hD hDK => hLam₁₂.2 D hD (fun t ht => (hDK t ht).trans hK_le)⟩
    have hEq₀ : galoisLam F rec L K₁₂ ψ E = galoisLam F rec L K₀ ψ E :=
      (hTheory (Module.finrank L (IntermediateField.extendScalars hLK₀) + 1)).2.1
        L K₀ hLK₀ hGal₀ (Nat.lt_succ_self _) ψ hψ (galoisLam F rec L K₁₂ ψ) hLam₁₂_on_K₀ E hLE hEK₀
    have hEq₁ : galoisLam F rec L K₁₂ ψ E = galoisLam F rec L K ψ E :=
      (hTheory (Module.finrank L (IntermediateField.extendScalars hLK) + 1)).2.1
        L K hLK hGal (Nat.lt_succ_self _) ψ hψ (galoisLam F rec L K₁₂ ψ) hLam₁₂_on_K E hLE hEK
    exact hEq₀.symm.trans hEq₁
  refine ⟨?_, ?_, ?_⟩
  · intro L _ ψ hψ
    have hSepL : Algebra.IsSeparable L (IntermediateField.extendScalars (le_rfl : L ≤ L)) := by
      refine ⟨fun x => ?_⟩
      let xL : L := ⟨x.1, (IntermediateField.mem_extendScalars (le_rfl : L ≤ L)).mp x.2⟩
      have hx : algebraMap L (IntermediateField.extendScalars (le_rfl : L ≤ L)) xL = x := rfl
      rw [← hx]
      exact isSeparable_algebraMap xL
    obtain ⟨K, hGal, hLK⟩ := hGalClos L L le_rfl hSepL
    rw [hGlobal_eq L K L hGal le_rfl hLK ψ hψ]
    exact ((hTheory (Module.finrank L (IntermediateField.extendScalars hGal.1) + 1)).1
      L K hGal.1 hGal (Nat.lt_succ_self _) ψ hψ).1
  · intro L M E _ h₁ h₂ hSep₁ hSep₂ ψ hψ
    have hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars (h₁.trans h₂)) := by
      letI algME : Algebra (IntermediateField.extendScalars h₁)
          (IntermediateField.extendScalars (h₁.trans h₂)) :=
        inferInstanceAs (Algebra M (IntermediateField.extendScalars h₂))
      letI : SMul (IntermediateField.extendScalars h₁)
          (IntermediateField.extendScalars (h₁.trans h₂)) :=
        algME.toSMul
      haveI : IsScalarTower L (IntermediateField.extendScalars h₁)
          (IntermediateField.extendScalars (h₁.trans h₂)) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : Algebra.IsSeparable L (IntermediateField.extendScalars h₁) := hSep₁
      haveI : Algebra.IsSeparable (IntermediateField.extendScalars h₁)
          (IntermediateField.extendScalars (h₁.trans h₂)) := hSep₂
      exact Algebra.IsSeparable.trans L (IntermediateField.extendScalars h₁)
        (IntermediateField.extendScalars (h₁.trans h₂))
    obtain ⟨K, hGalLK, hEK⟩ := hGalClos L E (h₁.trans h₂) hSepLE
    have hMK : M ≤ K := h₂.trans hEK
    have hGalMK : IsGaloisExt F M K := (hGalTower L M K h₁ hMK hGalLK).1
    obtain ⟨hψM, hTrans⟩ :=
      (hTheory (Module.finrank L (IntermediateField.extendScalars hGalLK.1) + 1)).2.2
        L M E K hGalLK.1 h₁ h₂ hEK hGalLK hGalMK (Nat.lt_succ_self _) ψ hψ
    rw [hGlobal_eq L K E hGalLK (h₁.trans h₂) hEK ψ hψ,
        hGlobal_eq M K E hGalMK h₂ hEK (traceChar F h₁ ψ) hψM,
        hGlobal_eq L K M hGalLK h₁ hMK ψ hψ,
        hTrans]
  · intro L _ ψ hψ D hD
    obtain ⟨K, hGal, hDK⟩ := hGalList L D hD.1
    have hLam : IsLambdaFuncOn F rec L K ψ (galoisLam F rec L K ψ) :=
      (hTheory (Module.finrank L (IntermediateField.extendScalars hGal.1) + 1)).1
        L K hGal.1 hGal (Nat.lt_succ_self _) ψ hψ
    have hCongr : evalMonomialList F rec (globalLam F rec) L ψ D =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L K ψ E') L ψ D := by
      apply heval_congr
      intro t ht
      exact hGlobal_eq L K t.field hGal t.le (hDK t ht) ψ hψ
    rw [hCongr]
    exact hLam.2 D hD hDK

theorem ld_minimal_abelian_normal_subfield_and_base (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ) :
    (Module.finrank L (IntermediateField.extendScalars hLK) ≤ 1 →
      IsCandidateLambdaOn F rec L K hLK ψ (fun _ => 1) ∧
      ∀ (χK : relWeil F K →* (Ω F)ˣ),
        (∃ χL : relWeil F L →* (Ω F)ˣ,
          IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK) →
        ∀ (D : List (MonomialTerm F L)),
          IsHomogeneousDecompOn F L K χK D →
          evalMonomialList F rec (fun _ _ _ => 1) L ψ D = 1) ∧
    (1 < Module.finrank L (IntermediateField.extendScalars hLK) →
      ∃ (M_C : IntermediateField F (AlgebraicClosure F)) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K),
        IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK) :=
by
  refine ⟨fun hle => ?_, fun hgt => ?_⟩
  · 
    haveI : FiniteDimensional F K := hGal.2.1
    haveI : IsScalarTower F L (IntermediateField.extendScalars hLK) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hmul_LK : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) =
        Module.finrank F K :=
      Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLK)
    have hFK_le : Module.finrank F K ≤ Module.finrank F L := by
      calc Module.finrank F K
        _ = Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) := hmul_LK.symm
        _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hle
        _ = Module.finrank F L := mul_one _
    have hLK_eq : L = K := IntermediateField.eq_of_le_of_finrank_le hLK hFK_le
    refine ⟨⟨rfl, ?_, fun _ _ _ _ _ => rfl, ?_⟩, ?_⟩
    · intro K₁ hLK₁ _ hGal₁ hlt E _ _
      haveI : FiniteDimensional F K₁ := hGal₁.2.1
      haveI : FiniteDimensional F (IntermediateField.extendScalars hLK₁) := hGal₁.2.1
      haveI : FiniteDimensional L (IntermediateField.extendScalars hLK₁) :=
        FiniteDimensional.right F L (IntermediateField.extendScalars hLK₁)
      have hpos : 0 < Module.finrank L (IntermediateField.extendScalars hLK₁) := Module.finrank_pos
      omega
    · intro M E h₁ h₂ hMK _ _ _ hlt
      haveI : FiniteDimensional F (IntermediateField.extendScalars hMK) := hGal.2.1
      haveI : FiniteDimensional M (IntermediateField.extendScalars hMK) :=
        FiniteDimensional.right F M (IntermediateField.extendScalars hMK)
      have hpos : 0 < Module.finrank M (IntermediateField.extendScalars hMK) := Module.finrank_pos
      omega
    · subst hLK_eq
      intro χK _ D hD
      haveI : FiniteDimensional F (IntermediateField.extendScalars hLK) := hGal.2.1
      haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) :=
        FiniteDimensional.right F L (IntermediateField.extendScalars hLK)
      have hpos_LL : 0 < Module.finrank L (IntermediateField.extendScalars (le_rfl : L ≤ L)) :=
        Module.finrank_pos
      have hfin_LL : Module.finrank L (IntermediateField.extendScalars (le_rfl : L ≤ L)) = 1 := by
        have hle' : Module.finrank L (IntermediateField.extendScalars (le_rfl : L ≤ L)) ≤ 1 := hle
        omega
      let c₀ : (Ω F)ˣ := tateEpsUnit F L (recChar F rec L χK) (traceChar F (le_rfl : L ≤ L) ψ)
      have hterm_eq : ∀ t ∈ D,
          evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t = c₀ ^ (t.deg F L) := by
        intro t ht
        obtain ⟨htL, htχ⟩ := hD.2 t ht
        rcases t with ⟨coeff, field, hle_t, χ_t⟩
        dsimp at htL htχ ⊢
        have hfield_eq : L = field := le_antisymm hle_t htL
        subst hfield_eq
        have hχ_eq : χ_t = χK := by
          rw [← htχ]
          ext w
          rfl
        subst hχ_eq
        change (c₀ * 1) ^ coeff = c₀ ^ (coeff * (Module.finrank L (IntermediateField.extendScalars hle_t) : ℤ))
        rw [mul_one, hfin_LL, Nat.cast_one, mul_one]
      have hlist_eq : ∀ (D' : List (MonomialTerm F L)),
          (∀ t ∈ D', evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t = c₀ ^ (t.deg F L)) →
          evalMonomialList F rec (fun _ _ _ => 1) L ψ D' = c₀ ^ (monomialListDeg F L D') := by
        intro D' hD'
        induction D' with
        | nil => simp [evalMonomialList, monomialListDeg]
        | cons t tl ih =>
          change evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t *
              evalMonomialList F rec (fun _ _ _ => 1) L ψ tl =
            c₀ ^ (t.deg F L + monomialListDeg F L tl)
          rw [hD' t List.mem_cons_self, ih (fun t' ht' => hD' t' (List.mem_cons_of_mem t ht')),
            zpow_add]
      rw [hlist_eq D hterm_eq]
      let V₀ := Fin 0 → ULift.{u} (Ω F)
      let σ₀ : Representation (Ω F) (relWeil F L) V₀ := 1
      have hσ₀ : IsWeilRep F L σ₀ := ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
      have htr₀ : (fun w => LinearMap.trace (Ω F) V₀ (σ₀ w)) = 0 := by
        funext w
        rw [Subsingleton.elim (σ₀ w) 0, map_zero]
        rfl
      have hD₀ : IsMonomialDecomp F L (fun w => LinearMap.trace (Ω F) V₀ (σ₀ w)) D := by
        rw [htr₀]
        exact hD.1
      have hdeg₀ := ld_monomial_deg_eq_finrank F L σ₀ hσ₀ D hD₀
      have hfin_V₀ : Module.finrank (Ω F) V₀ = 0 := Module.finrank_zero_of_subsingleton
      rw [hdeg₀, hfin_V₀, Nat.cast_zero, zpow_zero]
  · 
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
        IsGalois k K' := by
      intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK'N : K' ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K' := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K'.comap N.val
      have hKN_map : K_N.map N.val = K' := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K', τ x = x := by
          intro x hx
          let z : N := ⟨x, hK'N hx⟩
          have hz : AlgEquiv.restrictNormalHom N τ z = z := hh z hx
          have h1 : ((AlgEquiv.restrictNormalHom N τ z : N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    have helper_fixedField_finrank_lt : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        (K' : IntermediateField k Ω_bar) [FiniteDimensional k K'] [IsGalois k K']
        (C : Subgroup (K' ≃ₐ[k] K')), C ≠ ⊥ →
        Module.finrank k ↥((IntermediateField.fixedField C).map K'.val) < Module.finrank k ↥K' := by
      clear * -
      have h_abs : ∀ (k E : Type u) [Field k] [Field E] [Algebra k E]
          [FiniteDimensional k E] [IsGalois k E]
          (C : Subgroup (E ≃ₐ[k] E)), C ≠ ⊥ →
          Module.finrank k ↥(IntermediateField.fixedField C) < Module.finrank k E := by
        intro k E _ _ _ _ _ C hC_ne
        let M' : IntermediateField k E := IntermediateField.fixedField C
        have hmul : Module.finrank k M' * Module.finrank M' E = Module.finrank k E :=
          Module.finrank_mul_finrank k M' E
        have hcard_C : Module.finrank M' E = Nat.card C :=
          IntermediateField.finrank_fixedField_eq_card C
        have hC_gt1 : 1 < Nat.card C := by
          have hpos : 0 < Nat.card C := Nat.card_pos
          have hne1 : Nat.card C ≠ 1 := by
            intro h1
            exact hC_ne ((Subgroup.card_le_one_iff_eq_bot (H := C)).mp (le_of_eq h1))
          omega
        have hpos_E : 0 < Module.finrank k E := Module.finrank_pos
        have hpos_M' : 0 < Module.finrank k M' := by
          by_contra h0
          have h0' : Module.finrank k M' = 0 := Nat.eq_zero_of_not_pos h0
          rw [h0', zero_mul] at hmul
          omega
        rw [← hmul, hcard_C]
        exact lt_mul_of_one_lt_right hpos_M' hC_gt1
      intro k Ω_bar _ _ _ K' _ _ C hC_ne
      let M' : IntermediateField k K' := IntermediateField.fixedField C
      have hfin_eq : Module.finrank k ↥(M'.map K'.val) = Module.finrank k ↥M' :=
        (LinearEquiv.finrank_eq (M'.equivMap K'.val).toLinearEquiv).symm
      rw [hfin_eq]
      exact h_abs k ↥K' C hC_ne
    have helper_ramification_solvable : ∀ (K₀ : Type u) [Field K₀]
        (G₀ : Type u) [Group G₀] [Finite G₀]
        (φ : G₀ →* (K₀ ≃+* K₀)), Function.Injective φ →
        ∀ (v : K₀ → ℤ),
          v 0 = 0 → v 1 = 0 →
          (∀ x : K₀, v (-x) = v x) →
          (∀ x y : K₀, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
          (∀ u : K₀ˣ, v ((u⁻¹ : K₀ˣ) : K₀) = - v (u : K₀)) →
          (∀ m : ℤ, ∃ c : K₀ˣ, v (c : K₀) = m) →
          (∀ (k : ℤ) (x y : K₀),
            (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) → (x + y = 0 ∨ k ≤ v (x + y))) →
          (∀ (σ : G₀) (x : K₀), v (φ σ x) = v x) →
          ∀ (S₁ : Finset K₀),
            (∀ x : K₀, (x = 0 ∨ 0 ≤ v x) →
              ∃ s ∈ S₁, x - s = 0 ∨ (1 : ℤ) ≤ v (x - s)) →
            IsSolvable G₀ := by
      intro K₀ _ G₀ _ _ φ hφ_inj v hval0 hval1 hval_neg hval_mul hval_inv hval_surj hval_add
        hv_gal S₁ hS₁
      have hφ_one : ∀ x : K₀, φ 1 x = x := fun x => by rw [map_one]; rfl
      have hφ_mul : ∀ (σ τ : G₀) (x : K₀), φ (σ * τ) x = φ σ (φ τ x) :=
        fun σ τ x => by rw [map_mul]; rfl
      have hφ_inv_left : ∀ (σ : G₀) (x : K₀), φ σ⁻¹ (φ σ x) = x :=
        fun σ x => by rw [← hφ_mul, inv_mul_cancel, hφ_one]
      let inP : ℤ → K₀ → Prop := fun k x => x = 0 ∨ k ≤ v x
      have hP_zero : ∀ k : ℤ, inP k 0 := fun _ => Or.inl rfl
      have hP_one : inP 0 1 := Or.inr (by rw [hval1])
      have hP_mono : ∀ {k₁ k₂ : ℤ} {x : K₀}, k₁ ≤ k₂ → inP k₂ x → inP k₁ x := by
        intro k₁ k₂ x hle hx
        rcases hx with rfl | hx
        · exact Or.inl rfl
        · exact Or.inr (hle.trans hx)
      have hP_neg : ∀ (k : ℤ) {x : K₀}, inP k x → inP k (-x) := by
        intro k x hx
        rcases hx with rfl | hx
        · left; exact neg_zero
        · right; rw [hval_neg]; exact hx
      have hP_add : ∀ (k : ℤ) {x y : K₀}, inP k x → inP k y → inP k (x + y) :=
        fun k {x y} hx hy => hval_add k x y hx hy
      have hP_sub : ∀ (k : ℤ) {x y : K₀}, inP k x → inP k y → inP k (x - y) := by
        intro k x y hx hy
        rw [sub_eq_add_neg]
        exact hP_add k hx (hP_neg k hy)
      have hP_mul : ∀ {k₁ k₂ : ℤ} {x y : K₀}, inP k₁ x → inP k₂ y → inP (k₁ + k₂) (x * y) := by
        intro k₁ k₂ x y hx hy
        by_cases hx0 : x = 0
        · left; rw [hx0, zero_mul]
        · by_cases hy0 : y = 0
          · left; rw [hy0, mul_zero]
          · right
            rw [hval_mul x y hx0 hy0]
            exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
      have hP_gal : ∀ (k : ℤ) (σ : G₀) {x : K₀}, inP k x → inP k (φ σ x) := by
        intro k σ x hx
        rcases hx with rfl | hx
        · left; exact map_zero (φ σ)
        · right; rw [hv_gal σ x]; exact hx
      have hv_inv0 : ∀ {x : K₀}, x ≠ 0 → v x⁻¹ = - v x := by
        intro x hx
        let u : K₀ˣ := Units.mk0 x hx
        have hu : ((u⁻¹ : K₀ˣ) : K₀) = x⁻¹ := rfl
        rw [← hu, hval_inv u]
        rfl
      have hv_pow : ∀ (x : K₀), x ≠ 0 → ∀ n : ℕ, v (x ^ n) = (n : ℤ) * v x := by
        intro x hx n
        induction n with
        | zero => simp [hval1]
        | succ n ih =>
          rw [pow_succ', hval_mul x (x ^ n) hx (pow_ne_zero n hx), ih]
          push_cast
          ring
      let 𝒪_K : Subring K₀ :=
        { carrier := {x : K₀ | inP 0 x}
          mul_mem' := fun {x y} hx hy => by simpa using hP_mul hx hy
          one_mem' := hP_one
          add_mem' := fun {x y} hx hy => hP_add 0 hx hy
          zero_mem' := hP_zero 0
          neg_mem' := fun {x} hx => hP_neg 0 hx }
      have h_nonunits : ∀ x : 𝒪_K, x ∈ nonunits 𝒪_K ↔ inP 1 x.1 := by
        intro x
        rw [mem_nonunits_iff]
        constructor
        · intro hnu
          by_contra hnot1
          have hx0 : x.1 ≠ 0 := fun h0 => hnot1 (Or.inl h0)
          have hlt1 : ¬ (1 ≤ v x.1) := fun h1 => hnot1 (Or.inr h1)
          have hge0 : 0 ≤ v x.1 := x.2.resolve_left hx0
          have hvx0 : v x.1 = 0 := by omega
          have hinv_mem : inP 0 (x.1)⁻¹ := by
            right
            rw [hv_inv0 hx0, hvx0, neg_zero]
          apply hnu
          exact isUnit_iff_exists_inv.mpr ⟨⟨(x.1)⁻¹, hinv_mem⟩, Subtype.ext (mul_inv_cancel₀ hx0)⟩
        · intro hx1 hu
          rcases isUnit_iff_exists_inv.mp hu with ⟨y, hxy⟩
          have hxy_val : x.1 * y.1 = 1 := congrArg Subtype.val hxy
          have hx0 : x.1 ≠ 0 := left_ne_zero_of_mul_eq_one hxy_val
          have hy0 : y.1 ≠ 0 := right_ne_zero_of_mul_eq_one hxy_val
          have hv1 : v (x.1 * y.1) = 0 := by rw [hxy_val, hval1]
          rw [hval_mul x.1 y.1 hx0 hy0] at hv1
          have hx_ge1 : 1 ≤ v x.1 := hx1.resolve_left hx0
          have hy_ge0 : 0 ≤ v y.1 := y.2.resolve_left hy0
          omega
      haveI : IsLocalRing 𝒪_K := IsLocalRing.of_nonunits_add (by
        intro a b ha hb
        rw [h_nonunits] at ha hb ⊢
        exact hP_add 1 ha hb)
      let k_K := IsLocalRing.ResidueField 𝒪_K
      let res : 𝒪_K →+* k_K := IsLocalRing.residue 𝒪_K
      have h_res_zero : ∀ x : 𝒪_K, res x = 0 ↔ inP 1 x.1 := by
        intro x
        rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, h_nonunits]
      have h_kK_fin : Finite k_K := by
        let f : Option S₁ → k_K := fun o =>
          match o with
          | none => 0
          | some s => if hs : s.1 ∈ 𝒪_K then res ⟨s.1, hs⟩ else 0
        have hf_surj : Function.Surjective f := by
          intro z
          obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective z
          obtain ⟨s, hs_mem, hxs⟩ := hS₁ x.1 x.2
          have hs_O : s ∈ 𝒪_K := by
            have hsub : x.1 - (x.1 - s) = s := sub_sub_cancel x.1 s
            rw [← hsub]
            exact hP_sub 0 x.2 (hP_mono (by omega) hxs)
          refine ⟨some ⟨s, hs_mem⟩, ?_⟩
          dsimp [f]
          rw [dif_pos hs_O]
          have hdiff0 : res (x - ⟨s, hs_O⟩) = 0 := (h_res_zero (x - ⟨s, hs_O⟩)).mpr hxs
          rw [map_sub, sub_eq_zero] at hdiff0
          exact hdiff0.symm
        exact Finite.of_surjective f hf_surj
      letI : Fintype k_K := Fintype.ofFinite k_K
      let G_sub : ℕ → Subgroup G₀ := fun i =>
        { carrier := {σ : G₀ | ∀ x : K₀, inP 0 x → inP (i + 1 : ℤ) (φ σ x - x)}
          one_mem' := by
            intro x _
            left
            rw [hφ_one, sub_self]
          mul_mem' := by
            intro σ τ hσ hτ x hx
            have h1 : φ (σ * τ) x - x = (φ σ (φ τ x) - φ τ x) + (φ τ x - x) := by
              rw [hφ_mul]
              ring
            rw [h1]
            exact hP_add (i + 1 : ℤ) (hσ (φ τ x) (hP_gal 0 τ hx)) (hτ x hx)
          inv_mem' := by
            intro σ hσ x hx
            have h1 : φ σ⁻¹ x - x = - (φ σ⁻¹ (φ σ x - x)) := by
              rw [map_sub, hφ_inv_left σ x, neg_sub]
            rw [h1]
            exact hP_neg (i + 1 : ℤ) (hP_gal (i + 1 : ℤ) σ⁻¹ (hσ x hx)) }
      have h_comm_G0 : ∀ σ τ : G₀, ⁅σ, τ⁆ ∈ G_sub 0 := by
        obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := k_Kˣ)
        obtain ⟨u₀, hu₀⟩ := IsLocalRing.residue_surjective (g₀ : k_K)
        have h_pow_rep : ∀ z : k_K, z ≠ 0 → ∃ m : ℕ, z = res (u₀ ^ m) := by
          intro z hz
          obtain ⟨m, hm⟩ := hg₀ (Units.mk0 z hz)
          refine ⟨m, ?_⟩
          have hm' := congrArg (fun u : k_Kˣ => (u : k_K)) hm
          dsimp at hm'
          rw [← hm', ← hu₀, map_pow]
        let σ_O : G₀ → (𝒪_K →+* 𝒪_K) := fun σ =>
          { toFun := fun x => ⟨φ σ x.1, hP_gal 0 σ x.2⟩
            map_one' := Subtype.ext (map_one (φ σ))
            map_mul' := fun x y => Subtype.ext (map_mul (φ σ) x.1 y.1)
            map_zero' := Subtype.ext (map_zero (φ σ))
            map_add' := fun x y => Subtype.ext (map_add (φ σ) x.1 y.1) }
        have h_res_σ_zero : ∀ (σ : G₀) (x : 𝒪_K), res (σ_O σ x) = 0 ↔ res x = 0 := by
          intro σ x
          rw [h_res_zero, h_res_zero]
          refine ⟨fun h => ?_, hP_gal 1 σ⟩
          have h1 : inP 1 (φ σ⁻¹ (φ σ x.1)) := hP_gal 1 σ⁻¹ h
          rwa [hφ_inv_left] at h1
        have h_res_σ_congr : ∀ (σ : G₀) (x y : 𝒪_K), res x = res y → res (σ_O σ x) = res (σ_O σ y) := by
          intro σ x y hxy
          rw [← sub_eq_zero, ← map_sub, ← map_sub, h_res_σ_zero σ (x - y), map_sub, sub_eq_zero]
          exact hxy
        have hu₀_ne : res u₀ ≠ 0 := by
          rw [hu₀]
          exact Units.ne_zero g₀
        have h_σ_pow : ∀ σ : G₀, ∃ a : ℕ, ∀ m : ℕ, res (σ_O σ (u₀ ^ m)) = res (u₀ ^ (a * m)) := by
          intro σ
          have hne : res (σ_O σ u₀) ≠ 0 := (h_res_σ_zero σ u₀).not.mpr hu₀_ne
          obtain ⟨a, ha⟩ := h_pow_rep (res (σ_O σ u₀)) hne
          refine ⟨a, fun m => ?_⟩
          rw [map_pow, map_pow, ha, ← map_pow, ← pow_mul]
        intro σ τ x hx
        obtain ⟨a, ha⟩ := h_σ_pow σ
        obtain ⟨b, hb⟩ := h_σ_pow τ
        let y : 𝒪_K := ⟨φ (σ⁻¹ * τ⁻¹) x, hP_gal 0 (σ⁻¹ * τ⁻¹) hx⟩
        have h_comm_y : res (σ_O σ (σ_O τ y)) = res (σ_O τ (σ_O σ y)) := by
          by_cases hy0 : res y = 0
          · have h1 : res (σ_O σ (σ_O τ y)) = 0 :=
              (h_res_σ_zero σ (σ_O τ y)).mpr ((h_res_σ_zero τ y).mpr hy0)
            have h2 : res (σ_O τ (σ_O σ y)) = 0 :=
              (h_res_σ_zero τ (σ_O σ y)).mpr ((h_res_σ_zero σ y).mpr hy0)
            rw [h1, h2]
          · obtain ⟨m, hm⟩ := h_pow_rep (res y) hy0
            have h1 : res (σ_O τ y) = res (u₀ ^ (b * m)) :=
              (h_res_σ_congr τ y (u₀ ^ m) hm).trans (hb m)
            have h2 : res (σ_O σ (σ_O τ y)) = res (u₀ ^ (a * (b * m))) :=
              (h_res_σ_congr σ (σ_O τ y) (u₀ ^ (b * m)) h1).trans (ha (b * m))
            have h3 : res (σ_O σ y) = res (u₀ ^ (a * m)) :=
              (h_res_σ_congr σ y (u₀ ^ m) hm).trans (ha m)
            have h4 : res (σ_O τ (σ_O σ y)) = res (u₀ ^ (b * (a * m))) :=
              (h_res_σ_congr τ (σ_O σ y) (u₀ ^ (a * m)) h3).trans (hb (a * m))
            rw [h2, h4, mul_left_comm]
        have h_diff0 : res (σ_O σ (σ_O τ y) - σ_O τ (σ_O σ y)) = 0 := by
          rw [map_sub, sub_eq_zero]
          exact h_comm_y
        have h_inP1 : inP 1 ((σ_O σ (σ_O τ y) - σ_O τ (σ_O σ y)).1) :=
          (h_res_zero _).mp h_diff0
        have h_eq : (σ_O σ (σ_O τ y) - σ_O τ (σ_O σ y)).1 = φ ⁅σ, τ⁆ x - x := by
          change φ σ (φ τ (φ (σ⁻¹ * τ⁻¹) x)) - φ τ (φ σ (φ (σ⁻¹ * τ⁻¹) x)) = φ ⁅σ, τ⁆ x - x
          rw [← hφ_mul, ← hφ_mul, ← hφ_mul, ← hφ_mul, commutatorElement_def]
          have hgrp1 : σ * τ * (σ⁻¹ * τ⁻¹) = σ * τ * σ⁻¹ * τ⁻¹ := by group
          have hgrp2 : τ * σ * (σ⁻¹ * τ⁻¹) = 1 := by group
          rw [hgrp1, hgrp2, hφ_one]
        simpa [h_eq] using h_inP1
      obtain ⟨ϖ_u, hϖ_val⟩ := hval_surj 1
      let ϖ : K₀ := (ϖ_u : K₀)
      let ϖ_inv : K₀ := ((ϖ_u⁻¹ : K₀ˣ) : K₀)
      have hϖ_val' : v ϖ = 1 := hϖ_val
      have hϖ_ne : ϖ ≠ 0 := Units.ne_zero ϖ_u
      have hϖ_inv_ne : ϖ_inv ≠ 0 := Units.ne_zero ϖ_u⁻¹
      have hϖ_mul_inv : ϖ * ϖ_inv = 1 := by exact_mod_cast Units.mul_inv ϖ_u
      have hϖ_inv_mul : ϖ_inv * ϖ = 1 := by exact_mod_cast Units.inv_mul ϖ_u
      have hϖ_inv_val : v ϖ_inv = -1 := by rw [hval_inv ϖ_u, hϖ_val]
      have hϖ_inP1 : inP 1 ϖ := Or.inr (by omega)
      have hϖ_inP0 : inP 0 ϖ := Or.inr (by omega)
      have hϖ_inv_inP : inP (-1) ϖ_inv := Or.inr (by omega)
      have h_G1_from_ϖ : ∀ σ ∈ G_sub 0, inP 2 (φ σ ϖ - ϖ) → σ ∈ G_sub 1 := by
        intro σ hσ hσϖ
        have h_on_P1 : ∀ z : K₀, inP 1 z → inP 2 (φ σ z - z) := by
          intro z hz
          let y : K₀ := ϖ_inv * z
          have hy0 : inP 0 y := by simpa using hP_mul hϖ_inv_inP hz
          have hzy : z = ϖ * y := by
            dsimp [y]
            rw [← mul_assoc, hϖ_mul_inv, one_mul]
          have hid : φ σ z - z = φ σ ϖ * (φ σ y - y) + (φ σ ϖ - ϖ) * y := by
            conv_lhs => rw [hzy, map_mul]
            ring
          rw [hid]
          have ht1 : inP 2 (φ σ ϖ * (φ σ y - y)) := by
            simpa using hP_mul (hP_gal 1 σ hϖ_inP1) (hσ y hy0)
          have ht2 : inP 2 ((φ σ ϖ - ϖ) * y) := by
            simpa using hP_mul hσϖ hy0
          exact hP_add 2 ht1 ht2
        intro x hx
        by_cases hx1 : inP 1 x
        · exact h_on_P1 x hx1
        · have hres_x_ne : res ⟨x, hx⟩ ≠ 0 := (h_res_zero ⟨x, hx⟩).not.mpr hx1
          let M : ℕ := Fintype.card k_Kˣ
          let ux : k_Kˣ := Units.mk0 (res ⟨x, hx⟩) hres_x_ne
          have hux_pow : ux ^ M = 1 := pow_card_eq_one
          have hres_pow : (res ⟨x, hx⟩) ^ M = 1 := by
            have h1 := congrArg (fun u : k_Kˣ => (u : k_K)) hux_pow
            simpa [ux, Units.val_pow_eq_pow_val] using h1
          let x_O : 𝒪_K := ⟨x, hx⟩
          let σx_O : 𝒪_K := ⟨φ σ x, hP_gal 0 σ hx⟩
          let z_O : 𝒪_K := x_O ^ M - 1
          have hz_res : res z_O = 0 := by
            dsimp [z_O]
            rw [map_sub, map_pow, map_one, hres_pow, sub_self]
          have hz1 : inP 1 (x ^ M - 1) := (h_res_zero z_O).mp hz_res
          have hσz : inP 2 (φ σ (x ^ M - 1) - (x ^ M - 1)) := h_on_P1 (x ^ M - 1) hz1
          have hσz_eq : φ σ (x ^ M - 1) - (x ^ M - 1) = (φ σ x) ^ M - x ^ M := by
            rw [map_sub, map_pow, map_one]
            ring
          rw [hσz_eq] at hσz
          let S_O : 𝒪_K := ∑ j ∈ Finset.range M, σx_O ^ j * x_O ^ (M - 1 - j)
          let S : K₀ := S_O.1
          have hS_eq : S = ∑ j ∈ Finset.range M, (φ σ x) ^ j * x ^ (M - 1 - j) := by
            dsimp [S, S_O]
            push_cast
            rfl
          have hgeom : S * (φ σ x - x) = (φ σ x) ^ M - x ^ M := by
            rw [hS_eq]
            exact geom_sum₂_mul (φ σ x) x M
          have hres_σx : res σx_O = res x_O := by
            rw [← sub_eq_zero, ← map_sub]
            exact (h_res_zero (σx_O - x_O)).mpr (hσ x hx)
          have hres_S : res S_O = (M : k_K) * (res x_O) ^ (M - 1) := by
            dsimp [S_O]
            rw [map_sum]
            have hterm : ∀ j ∈ Finset.range M,
                res (σx_O ^ j * x_O ^ (M - 1 - j)) = (res x_O) ^ (M - 1) := by
              intro j hj
              have hj_le : j ≤ M - 1 := Nat.le_sub_one_of_lt (Finset.mem_range.mp hj)
              rw [map_mul, map_pow, map_pow, hres_σx, ← pow_add, Nat.add_sub_of_le hj_le]
            rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          have hcard_kK : Fintype.card k_K = M + 1 := Fintype.card_eq_card_units_add_one k_K
          have hcast0 : ((Fintype.card k_K : ℕ) : k_K) = 0 := Nat.cast_card_eq_zero k_K
          rw [hcard_kK, Nat.cast_add, Nat.cast_one] at hcast0
          have hM_eq_neg1 : (M : k_K) = -1 := eq_neg_of_add_eq_zero_left hcast0
          have hres_S_ne : res S_O ≠ 0 := by
            rw [hres_S, hM_eq_neg1, neg_one_mul, neg_ne_zero]
            exact pow_ne_zero (M - 1) hres_x_ne
          have hS_not1 : ¬ inP 1 S := (h_res_zero S_O).not.mp hres_S_ne
          have hS_ne : S ≠ 0 := fun h0 => hS_not1 (Or.inl h0)
          have hS_ge0 : 0 ≤ v S := S_O.2.resolve_left hS_ne
          have hS_lt1 : ¬ (1 ≤ v S) := fun h1 => hS_not1 (Or.inr h1)
          have hS_val0 : v S = 0 := by omega
          have hS_inv_inP0 : inP 0 S⁻¹ := by
            right
            rw [hv_inv0 hS_ne, hS_val0, neg_zero]
          have h_prod : inP 2 (S⁻¹ * (S * (φ σ x - x))) := by
            rw [hgeom]
            simpa using hP_mul hS_inv_inP0 hσz
          rwa [inv_mul_cancel_left₀ hS_ne] at h_prod
      have h_comm_G1 : ∀ σ ∈ G_sub 0, ∀ τ ∈ G_sub 0, ⁅σ, τ⁆ ∈ G_sub 1 := by
        have h_diff_ϖ : ∀ σ₁ ∈ G_sub 0, ∀ τ₁ ∈ G_sub 0,
            inP 2 (φ (σ₁ * τ₁) ϖ - φ (τ₁ * σ₁) ϖ) := by
          intro σ₁ hσ₁ τ₁ hτ₁
          let u_σ : K₀ := φ σ₁ ϖ * ϖ_inv
          let u_τ : K₀ := φ τ₁ ϖ * ϖ_inv
          have hu_σ0 : inP 0 u_σ := by simpa using hP_mul (hP_gal 1 σ₁ hϖ_inP1) hϖ_inv_inP
          have hu_τ0 : inP 0 u_τ := by simpa using hP_mul (hP_gal 1 τ₁ hϖ_inP1) hϖ_inv_inP
          have hσϖ_eq : φ σ₁ ϖ = u_σ * ϖ := by
            dsimp [u_σ]
            rw [mul_assoc, hϖ_inv_mul, mul_one]
          have hτϖ_eq : φ τ₁ ϖ = u_τ * ϖ := by
            dsimp [u_τ]
            rw [mul_assoc, hϖ_inv_mul, mul_one]
          have h1 : φ (σ₁ * τ₁) ϖ = φ σ₁ u_τ * (u_σ * ϖ) := by
            rw [hφ_mul, hτϖ_eq, map_mul, hσϖ_eq]
          have h2 : φ (τ₁ * σ₁) ϖ = φ τ₁ u_σ * (u_τ * ϖ) := by
            rw [hφ_mul, hσϖ_eq, map_mul, hτϖ_eq]
          have hid_comm : φ (σ₁ * τ₁) ϖ - φ (τ₁ * σ₁) ϖ =
              ϖ * ((φ σ₁ u_τ - u_τ) * u_σ - (φ τ₁ u_σ - u_σ) * u_τ) := by
            rw [h1, h2]
            ring
          have h_inner : inP 1 ((φ σ₁ u_τ - u_τ) * u_σ - (φ τ₁ u_σ - u_σ) * u_τ) := by
            have ht1 : inP 1 ((φ σ₁ u_τ - u_τ) * u_σ) := by
              simpa using hP_mul (hσ₁ u_τ hu_τ0) hu_σ0
            have ht2 : inP 1 ((φ τ₁ u_σ - u_σ) * u_τ) := by
              simpa using hP_mul (hτ₁ u_σ hu_σ0) hu_τ0
            exact hP_sub 1 ht1 ht2
          rw [hid_comm]
          simpa using hP_mul hϖ_inP1 h_inner
        intro σ hσ τ hτ
        apply h_G1_from_ϖ ⁅σ, τ⁆ (h_comm_G0 σ τ)
        have hσ_inv : σ⁻¹ ∈ G_sub 0 := (G_sub 0).inv_mem hσ
        have hτ_inv : τ⁻¹ ∈ G_sub 0 := (G_sub 0).inv_mem hτ
        have h1 : inP 2 (φ (σ * τ) (φ (σ⁻¹ * τ⁻¹) ϖ - φ (τ⁻¹ * σ⁻¹) ϖ)) :=
          hP_gal 2 (σ * τ) (h_diff_ϖ σ⁻¹ hσ_inv τ⁻¹ hτ_inv)
        have h2 : φ (σ * τ) (φ (σ⁻¹ * τ⁻¹) ϖ - φ (τ⁻¹ * σ⁻¹) ϖ) = φ ⁅σ, τ⁆ ϖ - ϖ := by
          rw [map_sub, ← hφ_mul, ← hφ_mul, commutatorElement_def]
          have hgrp1 : (σ * τ) * (σ⁻¹ * τ⁻¹) = σ * τ * σ⁻¹ * τ⁻¹ := by group
          have hgrp2 : (σ * τ) * (τ⁻¹ * σ⁻¹) = 1 := by group
          rw [hgrp1, hgrp2, hφ_one]
        rwa [h2] at h1
      have h_comm_Gi : ∀ (i : ℕ), 1 ≤ i → ∀ σ ∈ G_sub i, ∀ τ ∈ G_sub i, ⁅σ, τ⁆ ∈ G_sub (i + 1) := by
        intro i hi σ hσ τ hτ
        have h_pow_ϖ : ∀ (γ : G₀), γ ∈ G_sub i → ∀ m : ℕ, 1 ≤ m →
            inP (i + m : ℤ) (φ γ (ϖ ^ m) - ϖ ^ m) := by
          intro γ hγ m hm
          induction m with
          | zero => omega
          | succ m ih =>
            by_cases hm0 : m = 0
            · subst hm0
              simpa [pow_one] using hγ ϖ hϖ_inP0
            · have hm1 : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
              have ih' := ih hm1
              have hid : φ γ (ϖ ^ (m + 1)) - ϖ ^ (m + 1) =
                  φ γ ϖ * (φ γ (ϖ ^ m) - ϖ ^ m) + (φ γ ϖ - ϖ) * ϖ ^ m := by
                rw [pow_succ', map_mul]
                ring
              rw [hid]
              have hϖm_inP : inP (m : ℤ) (ϖ ^ m) := by
                right
                rw [hv_pow ϖ hϖ_ne m, hϖ_val', mul_one]
              have ht1 : inP ((i : ℤ) + ((m : ℕ) + 1 : ℤ)) (φ γ ϖ * (φ γ (ϖ ^ m) - ϖ ^ m)) := by
                have h1 := hP_mul (hP_gal 1 γ hϖ_inP1) ih'
                exact hP_mono (by omega) h1
              have ht2 : inP ((i : ℤ) + ((m : ℕ) + 1 : ℤ)) ((φ γ ϖ - ϖ) * ϖ ^ m) := by
                have h1 := hP_mul (hγ ϖ hϖ_inP0) hϖm_inP
                exact hP_mono (by omega) h1
              simpa [Nat.cast_add, Nat.cast_one] using hP_add ((i : ℤ) + ((m : ℕ) + 1 : ℤ)) ht1 ht2
        have h_on_Pi : ∀ (γ : G₀), γ ∈ G_sub i → ∀ z : K₀, inP (i + 1 : ℤ) z →
            inP (i + 2 : ℤ) (φ γ z - z) := by
          intro γ hγ z hz
          let y : K₀ := (ϖ_inv ^ (i + 1)) * z
          have hϖ_inv_pow : inP (-(i + 1 : ℤ)) (ϖ_inv ^ (i + 1)) := by
            right
            rw [hv_pow ϖ_inv hϖ_inv_ne (i + 1), hϖ_inv_val]
            omega
          have hy0 : inP 0 y := by
            have h1 := hP_mul hϖ_inv_pow hz
            exact hP_mono (by omega) h1
          have hzy : z = (ϖ ^ (i + 1)) * y := by
            dsimp [y]
            rw [← mul_assoc, ← mul_pow, hϖ_mul_inv, one_pow, one_mul]
          have hid : φ γ z - z =
              φ γ (ϖ ^ (i + 1)) * (φ γ y - y) + (φ γ (ϖ ^ (i + 1)) - ϖ ^ (i + 1)) * y := by
            conv_lhs => rw [hzy, map_mul]
            ring
          rw [hid]
          have hϖ_pow_inP : inP (i + 1 : ℤ) (ϖ ^ (i + 1)) := by
            right
            rw [hv_pow ϖ hϖ_ne (i + 1), hϖ_val']
            omega
          have ht1 : inP (i + 2 : ℤ) (φ γ (ϖ ^ (i + 1)) * (φ γ y - y)) := by
            have h1 := hP_mul (hP_gal (i + 1 : ℤ) γ hϖ_pow_inP) (hγ y hy0)
            exact hP_mono (by omega) h1
          have ht2 : inP (i + 2 : ℤ) ((φ γ (ϖ ^ (i + 1)) - ϖ ^ (i + 1)) * y) := by
            have h1 := h_pow_ϖ γ hγ (i + 1) (by omega)
            have h2 := hP_mul h1 hy0
            exact hP_mono (by omega) h2
          exact hP_add (i + 2 : ℤ) ht1 ht2
        intro x hx
        let x' : K₀ := φ (σ⁻¹ * τ⁻¹) x
        have hx' : inP 0 x' := hP_gal 0 (σ⁻¹ * τ⁻¹) hx
        let z₁ : K₀ := φ τ x' - x'
        let z₂ : K₀ := φ σ x' - x'
        have hz₁ : inP (i + 1 : ℤ) z₁ := hτ x' hx'
        have hz₂ : inP (i + 1 : ℤ) z₂ := hσ x' hx'
        have hid : φ ⁅σ, τ⁆ x - x = (φ σ z₁ - z₁) - (φ τ z₂ - z₂) := by
          have h1 : φ σ (φ τ x') = φ ⁅σ, τ⁆ x := by
            dsimp [x']
            rw [← hφ_mul, ← hφ_mul, commutatorElement_def]
            have hgrp : σ * τ * (σ⁻¹ * τ⁻¹) = σ * τ * σ⁻¹ * τ⁻¹ := by group
            rw [hgrp]
          have h2 : φ τ (φ σ x') = x := by
            dsimp [x']
            rw [← hφ_mul, ← hφ_mul]
            have hgrp : τ * σ * (σ⁻¹ * τ⁻¹) = 1 := by group
            rw [hgrp, hφ_one]
          dsimp [z₁, z₂]
          rw [map_sub, map_sub, h1, h2]
          ring
        have h_i2 : ((i + 1 : ℕ) + 1 : ℤ) = (i + 2 : ℤ) := by push_cast; ring
        rw [h_i2, hid]
        exact hP_sub (i + 2 : ℤ) (h_on_Pi σ hσ z₁ hz₁) (h_on_Pi τ hτ z₂ hz₂)
      have h_der_le : ∀ k : ℕ, derivedSeries G₀ (k + 1) ≤ G_sub k := by
