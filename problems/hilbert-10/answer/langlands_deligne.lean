        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
  have hResSurj_E' : ∀ y : E', (y = 0 ∨ 0 ≤ valL F E' y) →
      ∃ c₀ : L, (c₀ = 0 ∨ 0 ≤ valL F L c₀) ∧
        (y - IntermediateField.inclusion hLE' c₀ = 0 ∨
          1 ≤ valL F E' (y - IntermediateField.inclusion hLE' c₀)) := by
    intro y hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis y
    have hc_all : ∀ i : Fin p, c i = 0 ∨ 0 ≤ (p : ℤ) * valL F L (c i) + (i : ℤ) :=
