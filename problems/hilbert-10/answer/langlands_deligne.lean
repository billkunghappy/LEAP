      ring
    have h1 := hval_mul_bound_K₁
      (((p - 1 : ℕ) : ℤ) * ((p * m_exp : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ))
      B_req (w_pow * A m) (E_tr m)
      (Or.inr (le_of_eq hwA_val.symm)) hE_bound
    have h2 := hval_mul_bound_K₁
      ((((p - 1 : ℕ) : ℤ) * ((p * m_exp : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)) + B_req)
      (-(((p * t₁ : ℕ) : ℤ)))
      (w_pow * A m * E_tr m) (C m)
      h1 (Or.inr (le_of_eq (hC_val m hm).2.symm))
    rcases h2 with h0 | hge
    · exact Or.inl h0
    · right
      dsimp [err_tr, B_req] at hge ⊢
      have h2p1 : (2 * p - 1) * t₁ = (p - 1) * t₁ + p * t₁ := by
        have hp2 : 2 * p - 1 = (p - 1) + p := by omega
        rw [hp2, add_mul]
      omega
  have herr_pow_bound : ∀ m < p,
      err_pow m = 0 ∨ ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (err_pow m) := by
    intro m hm
    have h1 := hval_mul_bound_K₁ V_sub 0 P_sub (ξ m) hP_sub_bound (hξΔ_val m hm).1
    rw [add_zero] at h1
    have h2 := hval_mul_bound_K₁ V_sub (-(((p - 2 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)))
      (P_sub * ξ m) (A m - A₀) h1 (hA_diff_bound m hm)
    have h3 := hval_mul_bound_K₁
      (V_sub + -(((p - 2 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)))
      (-(((p * t₁ : ℕ) : ℤ)))
      (P_sub * ξ m * (A m - A₀)) (C m)
      h2 (Or.inr (le_of_eq (hC_val m hm).2.symm))
    rcases h3 with h0 | hge
    · exact Or.inl h0
    · right
      dsimp only [err_pow, V_pow] at hge hK_le_V_pow ⊢
      omega
  have herr_wt_bound : ∀ m < p,
      err_wt m = 0 ∨ ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (err_wt m) := by
    intro m hm
    have h1 := hval_mul_bound_K₁ V_sub 0 P_sub (ξ m) hP_sub_bound (hξΔ_val m hm).1
    rw [add_zero] at h1
    have h2 := hval_mul_bound_K₁ V_sub (-(((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)))
      (P_sub * ξ m) A₀ h1 (Or.inr (le_of_eq hA₀_val.symm))
    have h3 := hval_mul_bound_K₁
      (V_sub + -(((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ))) 0
      (P_sub * ξ m * A₀) (C m - C₀)
      h2 (hC_diff_bound m hm)
    rcases h3 with h0 | hge
    · exact Or.inl h0
    · right
      have hp1 : ((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) ≤
          ((p - 2 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) + ((p * t₁ : ℕ) : ℤ) := by
        have hnat : (p - 1) * t₁ ≤ (p - 2) * t₁ + p * t₁ := by
          have hle : p - 1 ≤ (p - 2) + p := by omega
          calc (p - 1) * t₁ ≤ ((p - 2) + p) * t₁ := Nat.mul_le_mul_right t₁ hle
            _ = (p - 2) * t₁ + p * t₁ := add_mul (p - 2) p t₁
        omega
      dsimp only [err_wt, V_pow] at hge hK_le_V_pow ⊢
      omega
  have hconst_bound :
      term_const = 0 ∨ ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ term_const := by
    have h1 := hval_mul_bound_K₁ V_sub (-(((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)))
      P_sub A₀ hP_sub_bound (Or.inr (le_of_eq hA₀_val.symm))
    have h2 := hval_mul_bound_K₁
      (V_sub + -(((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)))
      (-(((p * t₁ : ℕ) : ℤ)))
      (P_sub * A₀) C₀ h1 (Or.inr (le_of_eq hC₀_val.symm))
    have h3 := hval_mul_bound_K₁
      (V_sub + -(((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)) + -(((p * t₁ : ℕ) : ℤ)))
      (((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ))
      (P_sub * A₀ * C₀) (∑ m ∈ Finset.range p, ξ m)
      h2 hξ_sum_bound
    rcases h3 with h0 | hge
    · exact Or.inl h0
    · right
      have ht₁_le_pp : t₁ ≤ p * p * (3 * p * m₁ + 1) := by
        have hm₁_ge : t₁ ≤ m₁ := by dsimp [t₁, m₁]; omega
        have hm₁_le : m₁ ≤ 3 * p * m₁ + 1 :=
          le_trans (Nat.le_mul_of_pos_left m₁ (by omega : 0 < 3 * p)) (Nat.le_succ _)
        have hpp_ge : 3 * p * m₁ + 1 ≤ p * p * (3 * p * m₁ + 1) :=
          Nat.le_mul_of_pos_left (3 * p * m₁ + 1) (mul_pos hPrime.pos hPrime.pos)
        omega
      have hp1 : ((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) -
          ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          ((p - 2 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) := by
        have hdiff : ((p - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) =
            ((p - 2 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) + ((t₁ : ℕ) : ℤ) := by
          have hp2 : ((p - 1 : ℕ) : ℤ) = ((p - 2 : ℕ) : ℤ) + 1 := by omega
          rw [hp2, add_mul, one_mul]
        omega
      dsimp only [term_const, V_pow] at hge hK_le_V_pow ⊢
      omega
  rw [hQ_decomp]
  apply hval_add_K₁ ((1 + p * t₂ : ℕ) : ℤ)
    (∑ m ∈ Finset.range p, (err_tr m + err_pow m + err_wt m)) term_const
  · apply hval_sum_K₁ (Finset.range p) (fun m => err_tr m + err_pow m + err_wt m)
      ((1 + p * t₂ : ℕ) : ℤ)
    intro m hm_mem
    have hm : m < p := Finset.mem_range.mp hm_mem
    exact hval_add_K₁ ((1 + p * t₂ : ℕ) : ℤ) (err_tr m + err_pow m) (err_wt m)
      (hval_add_K₁ ((1 + p * t₂ : ℕ) : ℤ) (err_tr m) (err_pow m)
        (herr_tr_bound m hm) (herr_pow_bound m hm))
      (herr_wt_bound m hm)
  · exact hconst_bound

theorem ld_ch12_wild_odd_tot_ram_quad_conj_to_translated_norm_sum (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hTwistedTr : ∀ (Y : E') (i : ℕ),
      i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hT_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T)
    (ξ Δ_conj : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hΔ_conj0 : Δ_conj 0 = (Δ : K₁))
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hξ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)))
    (hΔ_conj_val : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -((bM₁' - 1 : ℕ) : ℤ))
    (hQ_conj_sum :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let u_M₁' := IntermediateField.inclusion hLM₁' u
      let n := u_M₁' * b
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      let Q_quad : E' :=
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
            (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
      IntermediateField.inclusion hE'K₁ Q_quad =
        ∑ m ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
            (Δ_conj m) ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁
              (normLM F hM₁'K₁ (Δ_conj m) *
                traceLM F hM₁'K₁
                  ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) *
                    Δ_conj m) ^ (p - 1))) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)) ^ 2))⁻¹)
    (hΔ_conj_approx : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let s := - e_Δ (p - 1)
      (Δ_conj m - ((Δ : K₁) + ξ m) = 0 ∨
        ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (Δ_conj m - ((Δ : K₁) + ξ m))) ∧
      ((Δ_conj m - ((Δ : K₁) + ξ m)) -
          ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m = 0 ∨
        ((p * (p - 1) * t₂ - (p - 2) * t₁ : ℕ) : ℤ) ≤
          valL F K₁
            ((Δ_conj m - ((Δ : K₁) + ξ m)) -
              ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m)) ∧
      (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) = 0 ∨
        ((p * (t₂ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
              IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)))) ∧
      (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
          (IntermediateField.inclusion hM₁'K₁ b + ξ m -
            ξ m * IntermediateField.inclusion hM₁'K₁ s) = 0 ∨
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
              (IntermediateField.inclusion hM₁'K₁ b + ξ m -
                ξ m * IntermediateField.inclusion hM₁'K₁ s)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₂ := bE' - 1
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let n := u_M₁' * b
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let Q_quad : E' :=
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
          (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
    let Q_norm :=
      IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
        IntermediateField.inclusion hM₁'K₁ T *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) ^ 2))⁻¹)
    IntermediateField.inclusion hE'K₁ Q_quad - Q_norm = 0 ∨
      ((1 + p * t₂ : ℕ) : ℤ) ≤
        valL F K₁ (IntermediateField.inclusion hE'K₁ Q_quad - Q_norm) :=
by
  intro p t₂ b u z u_M₁' n T Q_quad Q_norm
  obtain ⟨_, _, _, _, _, _, _, hvalK₁_add, _, _, _⟩ := ld_valL_and_unitGroup_props F K₁
  have hTr0 :=
    ld_ch12_wild_odd_tot_ram_quad_zero_degree_trace_bound F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁ htr_M₁'K₁
      Δ hΔ_val hTwistedTr e_Δ he_Δ_val
      α γ w₂ hα_val hγ_val hw₂_val hT_val
      ξ Δ_conj hξ0 hΔ_conj0 hξ_props hξ_pow_sum hΔ_conj_val
      hQ_conj_sum hΔ_conj_approx
  have hTr_lin :=
    ld_ch12_wild_odd_tot_ram_quad_inner_trace_binomial_linearization F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_LM₁' hval_E'K₁ hval_M₁'K₁ htr_M₁'K₁
      Δ hΔ_val hTwistedTr w₂ hw₂_val
      ξ Δ_conj hξ0 hΔ_conj0 hξ_props hΔ_conj_val
      (fun m hm => (hΔ_conj_approx m hm).1) hTr0
  have hStep1 :=
    ld_ch12_wild_odd_tot_ram_quad_outer_and_norm_weight_replacement F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hval_LM₁' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁ htr_M₁'K₁
      Δ hΔ_val α γ w₂ hα_val hγ_val hw₂_val hT_val
      ξ Δ_conj hξ0 hξ_props hΔ_conj_val hQ_conj_sum
      (fun m hm => ⟨(hΔ_conj_approx m hm).1, (hΔ_conj_approx m hm).2.2.1⟩)
  have hStep2 :=
    ld_ch12_wild_odd_tot_ram_quad_subleading_trace_sum_cancel F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hval_LM₁' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      Δ hΔ_val hTwistedTr e_Δ he_Δ_val α γ w₂ hα_val hγ_val hw₂_val
      ξ Δ_conj hξ0 hξ_props hξ_pow_sum
      (fun m hm => (hΔ_conj_approx m hm).2.2.2) hTr_lin
  dsimp only at hStep1 hStep2
  set Q_step1 :=
    ∑ m ∈ Finset.range p,
      IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
        ((Δ : K₁) + ξ m) ^ (p - 1) *
        IntermediateField.inclusion hM₁'K₁
          (traceLM F hM₁'K₁
            ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) *
              Δ_conj m) ^ (p - 1))) *
        IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) *
        (IntermediateField.inclusion hM₁'K₁
          ((1 + u_M₁' * normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) ^ 2))⁻¹
  have hrew : IntermediateField.inclusion hE'K₁ Q_quad - Q_norm =
      (IntermediateField.inclusion hE'K₁ Q_quad - Q_step1) + (Q_step1 - Q_norm) := by
    ring
  rw [hrew]
  exact hvalK₁_add ((1 + p * t₂ : ℕ) : ℤ) _ _ hStep1 hStep2

theorem ld_ch12_wild_odd_tot_ram_quad_base_vals_and_norm_to_poly_sum (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hT_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T)
    (ξ : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hΔ_norm_poly_approx : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let s := - e_Δ (p - 1)
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
          (IntermediateField.inclusion hM₁'K₁ b + ξ m -
            ξ m * IntermediateField.inclusion hM₁'K₁ s) = 0 ∨
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
              (IntermediateField.inclusion hM₁'K₁ b + ξ m -
                ξ m * IntermediateField.inclusion hM₁'K₁ s))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let δ := bE' - bM₁'
    let m := a_lam - bE'
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let s := - e_Δ (p - 1)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
    let b_K₁ := IntermediateField.inclusion hM₁'K₁ b
    let s_K₁ := IntermediateField.inclusion hM₁'K₁ s
    let P_out :=
      IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
        IntermediateField.inclusion hM₁'K₁ T
    let L_val := W_K₁ + b_K₁
    let Q_norm :=
      P_out *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) ^ 2))⁻¹)
    let Q_poly :=
      P_out *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 *
            (b_K₁ + ξ m' - ξ m' * s_K₁) *
            ((L_val + ξ m' - ξ m' * s_K₁) ^ 2)⁻¹)
    W_K₁ ≠ 0 ∧
    valL F K₁ W_K₁ = -(((p * p * m : ℕ) : ℤ)) ∧
    b_K₁ ≠ 0 ∧
    valL F K₁ b_K₁ = -(((p * t₁ : ℕ) : ℤ)) ∧
    L_val ≠ 0 ∧
    valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) ∧
    (s_K₁ = 0 ∨ ((p * (p - 1) * δ : ℕ) : ℤ) ≤ valL F K₁ s_K₁) ∧
    (P_out = 0 ∨
      ((2 * (p - 1) * p * m + p * (p - 1) * δ : ℕ) : ℤ) ≤ valL F K₁ P_out) ∧
    (∀ m' < p,
      (ξ m' = 0 ∨ 0 ≤ valL F K₁ (ξ m')) ∧
      (Δ : K₁) + ξ m' ≠ 0 ∧
      valL F K₁ ((Δ : K₁) + ξ m') = -(((t₁ : ℕ) : ℤ))) ∧
    (Q_norm - Q_poly = 0 ∨
      ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (Q_norm - Q_poly)) :=
by
  intro p t₁ t₂ δ m b s u W z u_M₁' T W_K₁ b_K₁ s_K₁ P_out L_val Q_norm Q_poly
  obtain ⟨_, _, _, _, hval_mul_L, hval_inv_L, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, hval1_E', _, _, hval_mul_E', hval_inv_E', _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  obtain ⟨_, _, _, hval_neg_M₁', _, _, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M₁'
  obtain ⟨_, hval1_K₁, _, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁, _, hval_add_K₁, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K₁
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge_t₁ : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpt₁_lt_ppm : p * t₁ < p * p * m := by
    have h1 : p * t₁ < p * (p * m) := Nat.mul_lt_mul_of_pos_left hpm_gt_t₁ (by omega)
    linarith [show p * (p * m) = p * p * m by ring]
  have hval_pow_K₁ : ∀ (x : K₁) (k : ℕ), x ≠ 0 → valL F K₁ (x ^ k) = (k : ℤ) * valL F K₁ x := by
    intro x k hx
    induction k with
    | zero => simp [hval1_K₁]
    | succ k ih =>
      rw [pow_succ, hval_mul_K₁ (x ^ k) x (pow_ne_zero k hx) hx, ih]
      push_cast
      ring
  have hval_pow_E' : ∀ (x : E') (k : ℕ), x ≠ 0 → valL F E' (x ^ k) = (k : ℤ) * valL F E' x := by
    intro x k hx
    induction k with
    | zero => simp [hval1_E']
    | succ k ih =>
      rw [pow_succ, hval_mul_E' (x ^ k) x (pow_ne_zero k hx) hx, ih]
      push_cast
      ring
  have hval_inv_elt_K₁ : ∀ (x : K₁), x ≠ 0 → valL F K₁ x⁻¹ = - valL F K₁ x := by
    intro x hx
    exact hval_inv_K₁ (Units.mk0 x hx)
  have hval_add_strict : ∀ (x y : K₁),
      x ≠ 0 → (y = 0 ∨ valL F K₁ x < valL F K₁ y) →
        x + y ≠ 0 ∧ valL F K₁ (x + y) = valL F K₁ x := by
    intro x y hx hxy
    rcases hxy with rfl | hlt
    · simp [hx]
    · by_cases hy0 : y = 0
      · simp [hy0, hx]
      · have hxy_ne0 : x + y ≠ 0 := by
          intro h0
          have hx_eq : x = -y := eq_neg_of_add_eq_zero_left h0
          have hveq : valL F K₁ x = valL F K₁ y := by rw [hx_eq, hval_neg_K₁]
          omega
        have hge : valL F K₁ x ≤ valL F K₁ (x + y) :=
          (hval_add_K₁ (valL F K₁ x) x y (Or.inr le_rfl) (Or.inr (le_of_lt hlt))).resolve_left hxy_ne0
        have hle : valL F K₁ (x + y) ≤ valL F K₁ x := by
          by_contra hgt
          push_neg at hgt
          set k : ℤ := min (valL F K₁ (x + y)) (valL F K₁ y)
          have hk_xy : x + y = 0 ∨ k ≤ valL F K₁ (x + y) := Or.inr (min_le_left _ _)
          have hk_ny : -y = 0 ∨ k ≤ valL F K₁ (-y) := by
            right; rw [hval_neg_K₁]; exact min_le_right _ _
          have hsum := hval_add_K₁ k (x + y) (-y) hk_xy hk_ny
          rw [add_neg_cancel_right] at hsum
          have hk_le : k ≤ valL F K₁ x := hsum.resolve_left hx
          have hlt_k : valL F K₁ x < k := lt_min hgt hlt
          omega
        exact ⟨hxy_ne0, le_antisymm hle hge⟩
  have hval_sub_K₁ : ∀ (k : ℤ) (x y : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hval_add_K₁ k x (-y) hx
    rcases hy with rfl | hy
    · left; simp
    · right; rwa [hval_neg_K₁]
  have hval_mul_bound_K₁ : ∀ (k₁ k₂ : ℤ) (x y : K₁),
      (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        rw [hval_mul_K₁ x y hx0 hy0]
        have hx' : k₁ ≤ valL F K₁ x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F K₁ y := hy.resolve_left hy0
        omega
  have hval_sum_K₁ : ∀ (S : Finset ℕ) (f : ℕ → K₁) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction S using Finset.induction_on with
    | empty => left; simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add_K₁ k (f a) (∑ i ∈ s, f i)
        (hS a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
  have hW_L_ne0 : W ≠ 0 := mul_ne_zero (Units.ne_zero γ) (Units.ne_zero α⁻¹)
  have hW_L_val : valL F L W = -((m : ℕ) : ℤ) := by
    dsimp [W, m]
    rw [hval_mul_L (γ : L) ((α⁻¹ : Lˣ) : L) (Units.ne_zero γ) (Units.ne_zero α⁻¹),
      hval_inv_L α, hγ_val, hα_val]
    omega
  have hW_E'_ne0 : IntermediateField.inclusion hLE' W ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hW_L_ne0
  have hW_ne0 : W_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hW_E'_ne0
  have hW_val : valL F K₁ W_K₁ = -(((p * p * m : ℕ) : ℤ)) := by
    dsimp [W_K₁]
    rw [hval_E'K₁, hval_LE', hW_L_val]
    push_cast
    ring
  have hb_M₁'_ne0 : b ≠ 0 := Units.ne_zero (Units.map (normLM F hM₁'K₁) Δ)
  have hb_ne0 : b_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hM₁'K₁)).mpr hb_M₁'_ne0
  have hb_val : valL F K₁ b_K₁ = -(((p * t₁ : ℕ) : ℤ)) := by
    dsimp [b_K₁, b, t₁]
    rw [hval_M₁'K₁, hval_norm_M₁'K₁, hΔ_val]
    push_cast
    ring
  obtain ⟨hL_ne0, hL_val⟩ : L_val ≠ 0 ∧ valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) := by
    have h := hval_add_strict W_K₁ b_K₁ hW_ne0 (Or.inr (by rw [hW_val, hb_val]; omega))
    rwa [hW_val] at h
  have hs_val : s_K₁ = 0 ∨ ((p * (p - 1) * δ : ℕ) : ℤ) ≤ valL F K₁ s_K₁ := by
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩
    rcases he_Δ_val (p - 1) hp1_mem with he0 | he_ge
    · left
      dsimp [s_K₁, s]
      rw [he0, neg_zero, map_zero]
    · right
      dsimp [s_K₁, s]
      rw [hval_M₁'K₁ (- e_Δ (p - 1)), hval_neg_M₁' (e_Δ (p - 1))]
      have hδ_eq : ((bE' - 1 : ℕ) : ℤ) - ((bM₁' - 1 : ℕ) : ℤ) = ((δ : ℕ) : ℤ) := by
        dsimp [δ]; omega
      change ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) -
          ((p - 1 : ℕ) : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ (p - 1)) at he_ge
      have he_ge' : ((p - 1 : ℕ) : ℤ) * ((δ : ℕ) : ℤ) ≤ valL F M₁' (e_Δ (p - 1)) := by
        rwa [← mul_sub, hδ_eq] at he_ge
      have hmul : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * ((δ : ℕ) : ℤ)) ≤
          (p : ℤ) * valL F M₁' (e_Δ (p - 1)) :=
        mul_le_mul_of_nonneg_left he_ge' (by positivity)
      have hcast : ((p * (p - 1) * δ : ℕ) : ℤ) =
          (p : ℤ) * (((p - 1 : ℕ) : ℤ) * ((δ : ℕ) : ℤ)) := by
        push_cast; ring
      linarith
  have hP_val : P_out = 0 ∨
      ((2 * (p - 1) * p * m + p * (p - 1) * δ : ℕ) : ℤ) ≤ valL F K₁ P_out := by
    have hw2_inv_ne0 : ((w₂⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero w₂⁻¹
    have hw2_inv_val : valL F E' ((w₂⁻¹ : E'ˣ) : E') = ((m : ℕ) : ℤ) := by
      rw [hval_inv_E' w₂, hw₂_val]
      dsimp [m]; omega
    have hw2_pow_ne0 : (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) ≠ 0 :=
      pow_ne_zero (p - 1) hw2_inv_ne0
    have hw2_K₁_val :
        valL F K₁ (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1))) =
          ((p * (p - 1) * m : ℕ) : ℤ) := by
      rw [hval_E'K₁, hval_pow_E' _ (p - 1) hw2_inv_ne0, hw2_inv_val]
      push_cast; ring
    have hT_K₁_val :
        IntermediateField.inclusion hM₁'K₁ T = 0 ∨
          ((p * (p - 1) * (m + δ) : ℕ) : ℤ) ≤
            valL F K₁ (IntermediateField.inclusion hM₁'K₁ T) := by
      rcases hT_val with hT0 | hT_ge
      · left
        change T = 0 at hT0
        rw [hT0, map_zero]
      · right
        rw [hval_M₁'K₁ T]
        have hmul : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ)) ≤
            (p : ℤ) * valL F M₁' T :=
          mul_le_mul_of_nonneg_left hT_ge (by positivity)
        have hcast : ((p * (p - 1) * (m + δ) : ℕ) : ℤ) =
            (p : ℤ) * (((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ)) := by
          push_cast; ring
        linarith
    have hprod := hval_mul_bound_K₁
      ((p * (p - 1) * m : ℕ) : ℤ) ((p * (p - 1) * (m + δ) : ℕ) : ℤ)
      (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)))
      (IntermediateField.inclusion hM₁'K₁ T)
      (Or.inr (le_of_eq hw2_K₁_val.symm)) hT_K₁_val
    rcases hprod with h0 | hge
    · left; exact h0
    · right
      have hcast : ((2 * (p - 1) * p * m + p * (p - 1) * δ : ℕ) : ℤ) =
          ((p * (p - 1) * m : ℕ) : ℤ) + ((p * (p - 1) * (m + δ) : ℕ) : ℤ) := by
        push_cast; ring
      linarith
  have hξ_zero_or_val0 : ∀ m' < p, ξ m' = 0 ∨ valL F K₁ (ξ m') = 0 := by
    intro m' hm'
    by_cases hm'0 : m' = 0
    · left; rw [hm'0, hξ0]
    · right; exact (hξ_props m' hm' (Nat.pos_of_ne_zero hm'0)).2.1
  have hξΔ_val : ∀ m' < p,
      (ξ m' = 0 ∨ 0 ≤ valL F K₁ (ξ m')) ∧
      (Δ : K₁) + ξ m' ≠ 0 ∧
      valL F K₁ ((Δ : K₁) + ξ m') = -(((t₁ : ℕ) : ℤ)) := by
    intro m' hm'
    have hξ_nonneg : ξ m' = 0 ∨ 0 ≤ valL F K₁ (ξ m') := by
      rcases hξ_zero_or_val0 m' hm' with h0 | hv0
      · exact Or.inl h0
      · right; omega
    have hlt : ξ m' = 0 ∨ valL F K₁ (Δ : K₁) < valL F K₁ (ξ m') := by
      rcases hξ_zero_or_val0 m' hm' with h0 | hv0
      · exact Or.inl h0
      · right; rw [hΔ_val, hv0]; omega
    have h := hval_add_strict (Δ : K₁) (ξ m') (Units.ne_zero Δ) hlt
    rw [hΔ_val] at h
    exact ⟨hξ_nonneg, h.1, h.2⟩
  have hWu_L : W * u = 1 := by
    dsimp [W, u]
    linear_combination ((γ : L) * ((γ⁻¹ : Lˣ) : L)) * Units.mul_inv α + Units.mul_inv γ
  have hincl_diamond : ∀ x : L,
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' x) =
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' x) :=
    fun _ => Subtype.ext rfl
  have hWu_K₁ : W_K₁ * IntermediateField.inclusion hM₁'K₁ u_M₁' = 1 := by
    dsimp [W_K₁, u_M₁']
    rw [hincl_diamond W, ← map_mul, ← map_mul, hWu_L, map_one, map_one]
  have hW_inv : W_K₁ * W_K₁⁻¹ = 1 := mul_inv_cancel₀ hW_ne0
  have hdenom_factor : ∀ N : M₁',
      IntermediateField.inclusion hM₁'K₁ (1 + u_M₁' * N) =
        W_K₁⁻¹ * (W_K₁ + IntermediateField.inclusion hM₁'K₁ N) := by
    intro N
    rw [map_add, map_one, map_mul]
    linear_combination (W_K₁⁻¹ * IntermediateField.inclusion hM₁'K₁ N) * hWu_K₁ -
      (1 + IntermediateField.inclusion hM₁'K₁ u_M₁' * IntermediateField.inclusion hM₁'K₁ N) * hW_inv
  have hquad_wt_rew : ∀ N : M₁',
      (IntermediateField.inclusion hM₁'K₁ ((1 + u_M₁' * N) ^ 2))⁻¹ =
        W_K₁ ^ 2 * ((W_K₁ + IntermediateField.inclusion hM₁'K₁ N) ^ 2)⁻¹ := by
    intro N
    rw [map_pow, hdenom_factor N, mul_pow, mul_inv, ← inv_pow, inv_inv]
  have hQ_diff : Q_norm - Q_poly = 0 ∨
      ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (Q_norm - Q_poly) := by
    set term_diff : ℕ → K₁ := fun m' =>
      P_out * (((Δ : K₁) + ξ m') ^ (p - 1) *
        (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) *
          (IntermediateField.inclusion hM₁'K₁
            ((1 + u_M₁' * normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) ^ 2))⁻¹ -
          W_K₁ ^ 2 * (b_K₁ + ξ m' - ξ m' * s_K₁) *
            ((L_val + ξ m' - ξ m' * s_K₁) ^ 2)⁻¹))
    have hQ_eq : Q_norm - Q_poly = ∑ m' ∈ Finset.range p, term_diff m' := by
      dsimp [Q_norm, Q_poly, term_diff]
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun m' _ => ?_
      ring
    rw [hQ_eq]
    apply hval_sum_K₁ (Finset.range p) term_diff ((1 + p * t₂ : ℕ) : ℤ)
    intro m' hm'_mem
    have hm' : m' < p := Finset.mem_range.mp hm'_mem
    set N₀ := normLM F hM₁'K₁ ((Δ : K₁) + ξ m')
    set N_m := IntermediateField.inclusion hM₁'K₁ N₀
    set Y_m := b_K₁ + ξ m' - ξ m' * s_K₁
    set R_m := N_m - Y_m
    set B_poly := L_val + ξ m' - ξ m' * s_K₁
    set B_norm := W_K₁ + N_m
    have hs_nonneg : s_K₁ = 0 ∨ 0 ≤ valL F K₁ s_K₁ := by
      rcases hs_val with h0 | hge
      · exact Or.inl h0
      · right; linarith [show (0 : ℤ) ≤ ((p * (p - 1) * δ : ℕ) : ℤ) by positivity]
    have hξs_nonneg : ξ m' * s_K₁ = 0 ∨ 0 ≤ valL F K₁ (ξ m' * s_K₁) := by
      have h := hval_mul_bound_K₁ 0 0 (ξ m') s_K₁ (hξΔ_val m' hm').1 hs_nonneg
      simpa using h
    have hξ_lin_nonneg : ξ m' - ξ m' * s_K₁ = 0 ∨ 0 ≤ valL F K₁ (ξ m' - ξ m' * s_K₁) :=
      hval_sub_K₁ 0 (ξ m') (ξ m' * s_K₁) (hξΔ_val m' hm').1 hξs_nonneg
    obtain ⟨hB_poly_ne0, hB_poly_val⟩ :
        B_poly ≠ 0 ∧ valL F K₁ B_poly = -(((p * p * m : ℕ) : ℤ)) := by
      have hB_poly_eq : B_poly = L_val + (ξ m' - ξ m' * s_K₁) := by
        dsimp [B_poly]; ring
      rw [hB_poly_eq]
      have hlt : ξ m' - ξ m' * s_K₁ = 0 ∨
          valL F K₁ L_val < valL F K₁ (ξ m' - ξ m' * s_K₁) := by
        rcases hξ_lin_nonneg with h0 | hge
        · exact Or.inl h0
        · right; rw [hL_val]; omega
      have h := hval_add_strict L_val (ξ m' - ξ m' * s_K₁) hL_ne0 hlt
      rwa [hL_val] at h
    have hR_bound : R_m = 0 ∨
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤ valL F K₁ R_m :=
      hΔ_norm_poly_approx m' hm'
    have hR_nonneg : R_m = 0 ∨ 0 ≤ valL F K₁ R_m := by
      rcases hR_bound with h0 | hge
      · exact Or.inl h0
      · right
        linarith [show (0 : ℤ) ≤ ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) by positivity]
    obtain ⟨hB_norm_ne0, hB_norm_val⟩ :
        B_norm ≠ 0 ∧ valL F K₁ B_norm = -(((p * p * m : ℕ) : ℤ)) := by
      have hB_norm_eq : B_norm = B_poly + R_m := by
        dsimp [B_norm, B_poly, R_m, Y_m, L_val]; ring
      rw [hB_norm_eq]
      have hlt : R_m = 0 ∨ valL F K₁ B_poly < valL F K₁ R_m := by
        rcases hR_nonneg with h0 | hge
        · exact Or.inl h0
        · right; rw [hB_poly_val]; omega
      have h := hval_add_strict B_poly R_m hB_poly_ne0 hlt
      rwa [hB_poly_val] at h
    have hY_bound : Y_m = 0 ∨ -(((p * t₁ : ℕ) : ℤ)) ≤ valL F K₁ Y_m := by
      have hY_eq : Y_m = b_K₁ + (ξ m' - ξ m' * s_K₁) := by dsimp [Y_m]; ring
      rw [hY_eq]
      apply hval_add_K₁ (-(((p * t₁ : ℕ) : ℤ))) b_K₁ (ξ m' - ξ m' * s_K₁)
      · right; rw [hb_val]
      · rcases hξ_lin_nonneg with h0 | hge
        · exact Or.inl h0
        · right; omega
    have hN_bound : N_m = 0 ∨ -(((p * t₁ : ℕ) : ℤ)) ≤ valL F K₁ N_m := by
      have hN_eq : N_m = Y_m + R_m := by dsimp [R_m]; ring
      rw [hN_eq]
      apply hval_add_K₁ (-(((p * t₁ : ℕ) : ℤ))) Y_m R_m hY_bound
      rcases hR_nonneg with h0 | hge
      · exact Or.inl h0
      · right; omega
    have hYN_bound : Y_m * N_m = 0 ∨ -(((2 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (Y_m * N_m) := by
      have h := hval_mul_bound_K₁ (-(((p * t₁ : ℕ) : ℤ))) (-(((p * t₁ : ℕ) : ℤ)))
        Y_m N_m hY_bound hN_bound
      rcases h with h0 | hge
      · exact Or.inl h0
      · right
        have h2pt₁ : 2 * (p * t₁) ≤ 2 * p * p * m := by linarith
        omega
    have hW2_ne0 : W_K₁ ^ 2 ≠ 0 := pow_ne_zero 2 hW_ne0
    have hW2_val : valL F K₁ (W_K₁ ^ 2) = -(((2 * p * p * m : ℕ) : ℤ)) := by
      rw [hval_pow_K₁ W_K₁ 2 hW_ne0, hW_val]
      push_cast; ring
    have hW2_sub_YN_bound :
        W_K₁ ^ 2 - Y_m * N_m = 0 ∨
          -(((2 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (W_K₁ ^ 2 - Y_m * N_m) :=
      hval_sub_K₁ (-(((2 * p * p * m : ℕ) : ℤ))) (W_K₁ ^ 2) (Y_m * N_m)
        (Or.inr (le_of_eq hW2_val.symm)) hYN_bound
    have hBn2_inv_ne0 : (B_norm ^ 2)⁻¹ ≠ 0 := inv_ne_zero (pow_ne_zero 2 hB_norm_ne0)
    have hBn2_inv_val : valL F K₁ (B_norm ^ 2)⁻¹ = ((2 * p * p * m : ℕ) : ℤ) := by
      rw [hval_inv_elt_K₁ (B_norm ^ 2) (pow_ne_zero 2 hB_norm_ne0),
        hval_pow_K₁ B_norm 2 hB_norm_ne0, hB_norm_val]
      push_cast; ring
    have hBp2_inv_ne0 : (B_poly ^ 2)⁻¹ ≠ 0 := inv_ne_zero (pow_ne_zero 2 hB_poly_ne0)
    have hBp2_inv_val : valL F K₁ (B_poly ^ 2)⁻¹ = ((2 * p * p * m : ℕ) : ℤ) := by
      rw [hval_inv_elt_K₁ (B_poly ^ 2) (pow_ne_zero 2 hB_poly_ne0),
        hval_pow_K₁ B_poly 2 hB_poly_ne0, hB_poly_val]
      push_cast; ring
    have h_bn : B_norm ^ 2 * (B_norm ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (pow_ne_zero 2 hB_norm_ne0)
    have h_bp : B_poly ^ 2 * (B_poly ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (pow_ne_zero 2 hB_poly_ne0)
    have hwt_diff_eq :
        N_m * (IntermediateField.inclusion hM₁'K₁ ((1 + u_M₁' * N₀) ^ 2))⁻¹ -
          W_K₁ ^ 2 * Y_m * (B_poly ^ 2)⁻¹ =
        R_m * (W_K₁ ^ 2 - Y_m * N_m) *
          (W_K₁ ^ 2 * (B_norm ^ 2)⁻¹ * (B_poly ^ 2)⁻¹) := by
      rw [hquad_wt_rew N₀]
      change N_m * (W_K₁ ^ 2 * (B_norm ^ 2)⁻¹) - W_K₁ ^ 2 * Y_m * (B_poly ^ 2)⁻¹ =
        R_m * (W_K₁ ^ 2 - Y_m * N_m) * (W_K₁ ^ 2 * (B_norm ^ 2)⁻¹ * (B_poly ^ 2)⁻¹)
      dsimp [R_m, B_norm, B_poly, L_val]
      linear_combination
        -(N_m * W_K₁ ^ 2 * (B_norm ^ 2)⁻¹) * h_bp +
        (W_K₁ ^ 2 * Y_m * (B_poly ^ 2)⁻¹) * h_bn
    have hW_Bn_Bp_ne0 : W_K₁ ^ 2 * (B_norm ^ 2)⁻¹ * (B_poly ^ 2)⁻¹ ≠ 0 :=
      mul_ne_zero (mul_ne_zero hW2_ne0 hBn2_inv_ne0) hBp2_inv_ne0
    have hW_Bn_Bp_val :
        valL F K₁ (W_K₁ ^ 2 * (B_norm ^ 2)⁻¹ * (B_poly ^ 2)⁻¹) =
          ((2 * p * p * m : ℕ) : ℤ) := by
      rw [hval_mul_K₁ (W_K₁ ^ 2 * (B_norm ^ 2)⁻¹) (B_poly ^ 2)⁻¹
          (mul_ne_zero hW2_ne0 hBn2_inv_ne0) hBp2_inv_ne0,
        hval_mul_K₁ (W_K₁ ^ 2) (B_norm ^ 2)⁻¹ hW2_ne0 hBn2_inv_ne0,
        hW2_val, hBn2_inv_val, hBp2_inv_val]
      omega
    have hwt_diff_bound :
        N_m * (IntermediateField.inclusion hM₁'K₁ ((1 + u_M₁' * N₀) ^ 2))⁻¹ -
          W_K₁ ^ 2 * Y_m * (B_poly ^ 2)⁻¹ = 0 ∨
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤
          valL F K₁
            (N_m * (IntermediateField.inclusion hM₁'K₁ ((1 + u_M₁' * N₀) ^ 2))⁻¹ -
              W_K₁ ^ 2 * Y_m * (B_poly ^ 2)⁻¹) := by
      rw [hwt_diff_eq]
      have h1 := hval_mul_bound_K₁
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) (-(((2 * p * p * m : ℕ) : ℤ)))
        R_m (W_K₁ ^ 2 - Y_m * N_m) hR_bound hW2_sub_YN_bound
      have h2 := hval_mul_bound_K₁
        (((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) + -(((2 * p * p * m : ℕ) : ℤ)))
        ((2 * p * p * m : ℕ) : ℤ)
        (R_m * (W_K₁ ^ 2 - Y_m * N_m))
        (W_K₁ ^ 2 * (B_norm ^ 2)⁻¹ * (B_poly ^ 2)⁻¹)
        h1 (Or.inr (le_of_eq hW_Bn_Bp_val.symm))
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right; omega
    have hΔξ_pow_ne0 : (((Δ : K₁) + ξ m') ^ (p - 1)) ≠ 0 :=
      pow_ne_zero (p - 1) (hξΔ_val m' hm').2.1
    have hΔξ_pow_val :
        valL F K₁ (((Δ : K₁) + ξ m') ^ (p - 1)) = -(((p - 1) * t₁ : ℕ) : ℤ) := by
      rw [hval_pow_K₁ ((Δ : K₁) + ξ m') (p - 1) (hξΔ_val m' hm').2.1, (hξΔ_val m' hm').2.2]
      push_cast; ring
    have hinner_bound := hval_mul_bound_K₁
      (-(((p - 1) * t₁ : ℕ) : ℤ)) ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ)
      (((Δ : K₁) + ξ m') ^ (p - 1))
      (N_m * (IntermediateField.inclusion hM₁'K₁ ((1 + u_M₁' * N₀) ^ 2))⁻¹ -
        W_K₁ ^ 2 * Y_m * (B_poly ^ 2)⁻¹)
      (Or.inr (le_of_eq hΔξ_pow_val.symm)) hwt_diff_bound
    have hterm_bound := hval_mul_bound_K₁
      ((2 * (p - 1) * p * m + p * (p - 1) * δ : ℕ) : ℤ)
      (-(((p - 1) * t₁ : ℕ) : ℤ) + ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ))
      P_out
      (((Δ : K₁) + ξ m') ^ (p - 1) *
        (N_m * (IntermediateField.inclusion hM₁'K₁ ((1 + u_M₁' * N₀) ^ 2))⁻¹ -
          W_K₁ ^ 2 * Y_m * (B_poly ^ 2)⁻¹))
      hP_val hinner_bound
    rcases hterm_bound with h0 | hge
    · exact Or.inl h0
    · right
      have ht₂_eq : t₂ = t₁ + δ := by dsimp [t₁, t₂, δ]; omega
      have hsub_eq : (p - 1) * t₂ - (p - 2) * t₁ = (p - 1) * δ + t₁ := by
        have h1 : (p - 2) * t₁ ≤ (p - 1) * t₂ := by
          calc (p - 2) * t₁ ≤ (p - 1) * t₁ := Nat.mul_le_mul_right t₁ (by omega)
            _ ≤ (p - 1) * t₂ := Nat.mul_le_mul_left (p - 1) ht₂_ge_t₁
        zify [h1]
        rw [ht₂_eq]
        have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
        have hp2 : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := by omega
        push_cast
        rw [hp1, hp2]
        ring
      have hpm_ge : t₁ + 1 ≤ p * m := hpm_gt_t₁
      have hineq_nat :
          (1 + p * t₂) + (p - 1) * t₁ ≤
            (2 * (p - 1) * p * m + p * (p - 1) * δ) + p * ((p - 1) * t₂ - (p - 2) * t₁) := by
        rw [hsub_eq, ht₂_eq]
        have h1 : 2 * (t₁ + 1) ≤ (p - 1) * (p * m) := by
          calc 2 * (t₁ + 1) ≤ (p - 1) * (t₁ + 1) := Nat.mul_le_mul_right (t₁ + 1) (by omega)
            _ ≤ (p - 1) * (p * m) := Nat.mul_le_mul_left (p - 1) hpm_ge
        have h2 : p * δ ≤ p * ((p - 1) * δ) := by
          apply Nat.mul_le_mul_left p
          calc δ = 1 * δ := (one_mul δ).symm
            _ ≤ (p - 1) * δ := Nat.mul_le_mul_right δ (by omega)
        have h3 : 2 * (p - 1) * (p * m) = 2 * (p - 1) * p * m := by ring
        nlinarith
      have hineq_int :
          ((1 + p * t₂ : ℕ) : ℤ) ≤
            ((2 * (p - 1) * p * m + p * (p - 1) * δ : ℕ) : ℤ) +
              (-(((p - 1) * t₁ : ℕ) : ℤ) + ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ)) := by
        omega
      exact le_trans hineq_int hge
  exact ⟨hW_ne0, hW_val, hb_ne0, hb_val, hL_ne0, hL_val, hs_val, hP_val, hξΔ_val, hQ_diff⟩

theorem ld_ch12_wild_odd_tot_ram_quad_poly_weight_to_linearized_sum (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (K₁ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K₁]
    (p bE' bM₁' a_lam : ℕ)
    (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 < p * (a_lam - bE'))
    (Δ : K₁ˣ) (W_K₁ b_K₁ s_K₁ P_out : K₁) (ξ : ℕ → K₁)
    (hW_ne : W_K₁ ≠ 0)
    (hW_val : valL F K₁ W_K₁ = -(((p * p * (a_lam - bE') : ℕ) : ℤ)))
    (hb_ne : b_K₁ ≠ 0)
    (hb_val : valL F K₁ b_K₁ = -(((p * (bM₁' - 1) : ℕ) : ℤ)))
    (hL_ne : W_K₁ + b_K₁ ≠ 0)
    (hL_val : valL F K₁ (W_K₁ + b_K₁) = -(((p * p * (a_lam - bE') : ℕ) : ℤ)))
    (hs_val : s_K₁ = 0 ∨ ((p * (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤ valL F K₁ s_K₁)
    (hP_val : P_out = 0 ∨
      ((2 * (p - 1) * p * (a_lam - bE') + p * (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤
        valL F K₁ P_out)
    (hξΔ_val : ∀ m' < p,
      (ξ m' = 0 ∨ 0 ≤ valL F K₁ (ξ m')) ∧
      (Δ : K₁) + ξ m' ≠ 0 ∧
      valL F K₁ ((Δ : K₁) + ξ m') = -(((bM₁' - 1 : ℕ) : ℤ))) :
    let t₂ := bE' - 1
    let L_val := W_K₁ + b_K₁
    let Q_poly :=
      P_out *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 *
            (b_K₁ + ξ m' - ξ m' * s_K₁) *
            ((L_val + ξ m' - ξ m' * s_K₁) ^ 2)⁻¹)
    let Q_teich :=
      P_out *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 *
            (b_K₁ + ξ m') *
            ((L_val + ξ m') ^ 2)⁻¹)
    let Q_lin :=
      Q_teich -
        P_out * s_K₁ * W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹ *
          (∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ (p - 1))
    Q_poly - Q_lin = 0 ∨
      ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (Q_poly - Q_lin) :=
by
  intro t₂ L_val Q_poly Q_teich Q_lin
  obtain ⟨_, hval1_K₁, _, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁, _, hval_add_K₁, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K₁
  set t₁ : ℕ := bM₁' - 1
  set δ : ℕ := bE' - bM₁'
  set m : ℕ := a_lam - bE'
  set M₂ : ℤ := ((p * p * m : ℕ) : ℤ)
  set S : ℤ := ((p * (p - 1) * δ : ℕ) : ℤ)
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge_t₁ : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpt₁_lt_ppm : p * t₁ < p * p * m := by
    have h1 : p * t₁ < p * (p * m) := Nat.mul_lt_mul_of_pos_left hpm_gt_t₁ (by omega)
    linarith [show p * (p * m) = p * p * m by ring]
  have hppm_pos : 0 < p * p * m :=
    Nat.mul_pos (Nat.mul_pos (by omega) (by omega)) (by omega)
  have hM₂_pos : 0 < M₂ := Nat.cast_pos.mpr hppm_pos
  have hpt₁_lt_M₂ : ((p * t₁ : ℕ) : ℤ) < M₂ := Nat.cast_lt.mpr hpt₁_lt_ppm
  have hS_nonneg : 0 ≤ S := by dsimp [S]; positivity
  have hval_pow_K₁ : ∀ (x : K₁) (k : ℕ), x ≠ 0 → valL F K₁ (x ^ k) = (k : ℤ) * valL F K₁ x := by
    intro x k hx
    induction k with
    | zero => simp [hval1_K₁]
    | succ k ih =>
      rw [pow_succ, hval_mul_K₁ (x ^ k) x (pow_ne_zero k hx) hx, ih]
      push_cast
      ring
  have hval_inv_elt_K₁ : ∀ (x : K₁), x ≠ 0 → valL F K₁ x⁻¹ = - valL F K₁ x := by
    intro x hx
    exact hval_inv_K₁ (Units.mk0 x hx)
  have hval_add_strict : ∀ (x y : K₁),
      x ≠ 0 → (y = 0 ∨ valL F K₁ x < valL F K₁ y) →
        x + y ≠ 0 ∧ valL F K₁ (x + y) = valL F K₁ x := by
    intro x y hx hxy
    rcases hxy with rfl | hlt
    · simp [hx]
    · by_cases hy0 : y = 0
      · simp [hy0, hx]
      · have hxy_ne0 : x + y ≠ 0 := by
          intro h0
          have hx_eq : x = -y := eq_neg_of_add_eq_zero_left h0
          have hveq : valL F K₁ x = valL F K₁ y := by rw [hx_eq, hval_neg_K₁]
          omega
        have hge : valL F K₁ x ≤ valL F K₁ (x + y) :=
          (hval_add_K₁ (valL F K₁ x) x y (Or.inr le_rfl) (Or.inr (le_of_lt hlt))).resolve_left hxy_ne0
        have hle : valL F K₁ (x + y) ≤ valL F K₁ x := by
          by_contra hgt
          push_neg at hgt
          set k : ℤ := min (valL F K₁ (x + y)) (valL F K₁ y)
          have hk_xy : x + y = 0 ∨ k ≤ valL F K₁ (x + y) := Or.inr (min_le_left _ _)
          have hk_ny : -y = 0 ∨ k ≤ valL F K₁ (-y) := by
            right; rw [hval_neg_K₁]; exact min_le_right _ _
          have hsum := hval_add_K₁ k (x + y) (-y) hk_xy hk_ny
          rw [add_neg_cancel_right] at hsum
          have hk_le : k ≤ valL F K₁ x := hsum.resolve_left hx
          have hlt_k : valL F K₁ x < k := lt_min hgt hlt
          omega
        exact ⟨hxy_ne0, le_antisymm hle hge⟩
  have hval_neg_bound_K₁ : ∀ (k : ℤ) (x : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (-x = 0 ∨ k ≤ valL F K₁ (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rwa [hval_neg_K₁]
  have hval_sub_K₁ : ∀ (k : ℤ) (x y : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_K₁ k x (-y) hx (hval_neg_bound_K₁ k y hy)
  have hval_mul_bound_K₁ : ∀ (k₁ k₂ : ℤ) (x y : K₁),
      (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        rw [hval_mul_K₁ x y hx0 hy0]
        have hx' : k₁ ≤ valL F K₁ x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F K₁ y := hy.resolve_left hy0
        omega
  have hval_sum_K₁ : ∀ (S₀ : Finset ℕ) (f : ℕ → K₁) (k : ℤ),
      (∀ i ∈ S₀, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
        ((∑ i ∈ S₀, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ S₀, f i)) := by
    intro S₀ f k hS₀
    induction S₀ using Finset.induction_on with
    | empty => left; simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add_K₁ k (f a) (∑ i ∈ s, f i)
        (hS₀ a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS₀ i (Finset.mem_insert_of_mem hi)))
  set Δ_wt : ℕ → K₁ := fun m' =>
    W_K₁ ^ 2 * (b_K₁ + ξ m' - ξ m' * s_K₁) * ((L_val + ξ m' - ξ m' * s_K₁) ^ 2)⁻¹ -
      W_K₁ ^ 2 * (b_K₁ + ξ m') * ((L_val + ξ m') ^ 2)⁻¹ +
      ξ m' * s_K₁ * W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹
  set term_diff : ℕ → K₁ := fun m' =>
    P_out * (((Δ : K₁) + ξ m') ^ (p - 1) * Δ_wt m')
  have hQ_lin_eq : Q_lin = ∑ m' ∈ Finset.range p,
      (P_out * (((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 * (b_K₁ + ξ m') *
        ((L_val + ξ m') ^ 2)⁻¹) -
      P_out * s_K₁ * W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹ *
        (ξ m' * ((Δ : K₁) + ξ m') ^ (p - 1))) := by
    dsimp [Q_lin, Q_teich]
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
  have hQ_eq : Q_poly - Q_lin = ∑ m' ∈ Finset.range p, term_diff m' := by
    dsimp [Q_poly]
    rw [hQ_lin_eq, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun m' _ => ?_
    dsimp [term_diff, Δ_wt]
    ring
  rw [hQ_eq]
  apply hval_sum_K₁ (Finset.range p) term_diff ((1 + p * t₂ : ℕ) : ℤ)
  intro m' hm'_mem
  have hm' : m' < p := Finset.mem_range.mp hm'_mem
  set η_m := ξ m' - ξ m' * s_K₁
  set X_m := b_K₁ + ξ m'
  set Y_m := b_K₁ + ξ m' - ξ m' * s_K₁
  set A_m := L_val + ξ m'
  set B_m := L_val + ξ m' - ξ m' * s_K₁
  have hξ_val : ξ m' = 0 ∨ 0 ≤ valL F K₁ (ξ m') := (hξΔ_val m' hm').1
  have hξs_bound : ξ m' * s_K₁ = 0 ∨ S ≤ valL F K₁ (ξ m' * s_K₁) := by
    have h := hval_mul_bound_K₁ 0 S (ξ m') s_K₁ hξ_val hs_val
    simpa using h
  have hneg_ξs_bound : -(ξ m' * s_K₁) = 0 ∨ S ≤ valL F K₁ (-(ξ m' * s_K₁)) :=
    hval_neg_bound_K₁ S (ξ m' * s_K₁) hξs_bound
  have hξs_nonneg : ξ m' * s_K₁ = 0 ∨ 0 ≤ valL F K₁ (ξ m' * s_K₁) := by
    rcases hξs_bound with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hη_nonneg : η_m = 0 ∨ 0 ≤ valL F K₁ η_m :=
    hval_sub_K₁ 0 (ξ m') (ξ m' * s_K₁) hξ_val hξs_nonneg
  obtain ⟨hA_ne0, hA_val⟩ : A_m ≠ 0 ∧ valL F K₁ A_m = -M₂ := by
    have hlt_A : ξ m' = 0 ∨ valL F K₁ L_val < valL F K₁ (ξ m') := by
      rcases hξ_val with h0 | hge
      · exact Or.inl h0
      · right; rw [hL_val]; omega
    have h := hval_add_strict L_val (ξ m') hL_ne hlt_A
    rwa [hL_val] at h
  obtain ⟨hB_ne0, hB_val⟩ : B_m ≠ 0 ∧ valL F K₁ B_m = -M₂ := by
    have hB_eq : B_m = L_val + η_m := by dsimp [B_m, η_m]; ring
    rw [hB_eq]
    have hlt_B : η_m = 0 ∨ valL F K₁ L_val < valL F K₁ η_m := by
      rcases hη_nonneg with h0 | hge
      · exact Or.inl h0
      · right; rw [hL_val]; omega
    have h := hval_add_strict L_val η_m hL_ne hlt_B
    rwa [hL_val] at h
  set D_den := L_val ^ 4 * A_m ^ 2 * B_m ^ 2
  set E_b := b_K₁ * η_m + ξ m' * Y_m
  set E_L := L_val * η_m + ξ m' * B_m
  set N_inner := -(L_val ^ 4 * E_b) - (W_K₁ ^ 2 - b_K₁ ^ 2) * (A_m * B_m + L_val ^ 2) * E_L
  have hB2_ne0 : B_m ^ 2 ≠ 0 := pow_ne_zero 2 hB_ne0
  have hA2_ne0 : A_m ^ 2 ≠ 0 := pow_ne_zero 2 hA_ne0
  have hL4_ne0 : L_val ^ 4 ≠ 0 := pow_ne_zero 4 hL_ne
  have hD_ne0 : D_den ≠ 0 := mul_ne_zero (mul_ne_zero hL4_ne0 hA2_ne0) hB2_ne0
  have hB_inv : B_m ^ 2 * (B_m ^ 2)⁻¹ = 1 := mul_inv_cancel₀ hB2_ne0
  have hA_inv : A_m ^ 2 * (A_m ^ 2)⁻¹ = 1 := mul_inv_cancel₀ hA2_ne0
  have hL_inv : L_val ^ 4 * (L_val ^ 4)⁻¹ = 1 := mul_inv_cancel₀ hL4_ne0
  have hD_inv : D_den * D_den⁻¹ = 1 := mul_inv_cancel₀ hD_ne0
  have hΔ_wt_cleared :
      Δ_wt m' * D_den = -(ξ m' * s_K₁) * W_K₁ ^ 2 * N_inner := by
    dsimp [Δ_wt, D_den, N_inner, E_b, E_L, A_m, B_m, X_m, Y_m, η_m, L_val]
    linear_combination
      (W_K₁ ^ 2 * Y_m * L_val ^ 4 * A_m ^ 2) * hB_inv -
      (W_K₁ ^ 2 * X_m * L_val ^ 4 * B_m ^ 2) * hA_inv +
      (ξ m' * s_K₁ * W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * A_m ^ 2 * B_m ^ 2) * hL_inv
  have hΔ_wt_eq :
      Δ_wt m' = (-(ξ m' * s_K₁)) * N_inner * (W_K₁ ^ 2 * D_den⁻¹) := by
    calc Δ_wt m' = Δ_wt m' * (D_den * D_den⁻¹) := by rw [hD_inv, mul_one]
      _ = (Δ_wt m' * D_den) * D_den⁻¹ := by ring
      _ = (-(ξ m' * s_K₁) * W_K₁ ^ 2 * N_inner) * D_den⁻¹ := by rw [hΔ_wt_cleared]
      _ = (-(ξ m' * s_K₁)) * N_inner * (W_K₁ ^ 2 * D_den⁻¹) := by ring
  have hb_bound : b_K₁ = 0 ∨ -M₂ ≤ valL F K₁ b_K₁ := by
    right; rw [hb_val]; linarith [hpt₁_lt_M₂]
  have hY_bound : Y_m = 0 ∨ -M₂ ≤ valL F K₁ Y_m := by
    have hY_eq : Y_m = b_K₁ + η_m := by dsimp [Y_m, η_m]; ring
    rw [hY_eq]
    apply hval_add_K₁ (-M₂) b_K₁ η_m hb_bound
    rcases hη_nonneg with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hEb_bound : E_b = 0 ∨ -M₂ ≤ valL F K₁ E_b := by
    have hbη : b_K₁ * η_m = 0 ∨ -M₂ ≤ valL F K₁ (b_K₁ * η_m) := by
      have h := hval_mul_bound_K₁ (-M₂) 0 b_K₁ η_m hb_bound hη_nonneg
      simpa using h
    have hξY : ξ m' * Y_m = 0 ∨ -M₂ ≤ valL F K₁ (ξ m' * Y_m) := by
      have h := hval_mul_bound_K₁ 0 (-M₂) (ξ m') Y_m hξ_val hY_bound
      simpa using h
    exact hval_add_K₁ (-M₂) (b_K₁ * η_m) (ξ m' * Y_m) hbη hξY
  have hEL_bound : E_L = 0 ∨ -M₂ ≤ valL F K₁ E_L := by
    have hLη : L_val * η_m = 0 ∨ -M₂ ≤ valL F K₁ (L_val * η_m) := by
      have h := hval_mul_bound_K₁ (-M₂) 0 L_val η_m (Or.inr (le_of_eq hL_val.symm)) hη_nonneg
      simpa using h
    have hξB : ξ m' * B_m = 0 ∨ -M₂ ≤ valL F K₁ (ξ m' * B_m) := by
      have h := hval_mul_bound_K₁ 0 (-M₂) (ξ m') B_m hξ_val (Or.inr (le_of_eq hB_val.symm))
      simpa using h
    exact hval_add_K₁ (-M₂) (L_val * η_m) (ξ m' * B_m) hLη hξB
  have hW2_ne0 : W_K₁ ^ 2 ≠ 0 := pow_ne_zero 2 hW_ne
  have hW2_val : valL F K₁ (W_K₁ ^ 2) = -2 * M₂ := by
    rw [hval_pow_K₁ W_K₁ 2 hW_ne, hW_val]
    dsimp [M₂, m]; ring
  have hb2_bound : b_K₁ ^ 2 = 0 ∨ -2 * M₂ ≤ valL F K₁ (b_K₁ ^ 2) := by
    rw [sq]
    have h := hval_mul_bound_K₁ (-M₂) (-M₂) b_K₁ b_K₁ hb_bound hb_bound
    rcases h with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hW2_sub_b2 : W_K₁ ^ 2 - b_K₁ ^ 2 = 0 ∨ -2 * M₂ ≤ valL F K₁ (W_K₁ ^ 2 - b_K₁ ^ 2) :=
    hval_sub_K₁ (-2 * M₂) (W_K₁ ^ 2) (b_K₁ ^ 2) (Or.inr (le_of_eq hW2_val.symm)) hb2_bound
  have hAB_val : valL F K₁ (A_m * B_m) = -2 * M₂ := by
    rw [hval_mul_K₁ A_m B_m hA_ne0 hB_ne0, hA_val, hB_val]; ring
  have hL2_val : valL F K₁ (L_val ^ 2) = -2 * M₂ := by
    rw [hval_pow_K₁ L_val 2 hL_ne, hL_val]
    dsimp [M₂, m]; ring
  have hAB_add_L2 : A_m * B_m + L_val ^ 2 = 0 ∨ -2 * M₂ ≤ valL F K₁ (A_m * B_m + L_val ^ 2) :=
    hval_add_K₁ (-2 * M₂) (A_m * B_m) (L_val ^ 2)
      (Or.inr (le_of_eq hAB_val.symm)) (Or.inr (le_of_eq hL2_val.symm))
  have hL4_val : valL F K₁ (L_val ^ 4) = -4 * M₂ := by
    rw [hval_pow_K₁ L_val 4 hL_ne, hL_val]
    dsimp [M₂, m]; ring
  have hN_term1 : -(L_val ^ 4 * E_b) = 0 ∨ -5 * M₂ ≤ valL F K₁ (-(L_val ^ 4 * E_b)) := by
    have h := hval_mul_bound_K₁ (-4 * M₂) (-M₂) (L_val ^ 4) E_b
      (Or.inr (le_of_eq hL4_val.symm)) hEb_bound
    have h' : L_val ^ 4 * E_b = 0 ∨ -5 * M₂ ≤ valL F K₁ (L_val ^ 4 * E_b) := by
      rcases h with h0 | hge
      · exact Or.inl h0
      · right; omega
    exact hval_neg_bound_K₁ (-5 * M₂) (L_val ^ 4 * E_b) h'
  have hN_term2 :
      (W_K₁ ^ 2 - b_K₁ ^ 2) * (A_m * B_m + L_val ^ 2) * E_L = 0 ∨
        -5 * M₂ ≤ valL F K₁ ((W_K₁ ^ 2 - b_K₁ ^ 2) * (A_m * B_m + L_val ^ 2) * E_L) := by
    have h1 := hval_mul_bound_K₁ (-2 * M₂) (-2 * M₂)
      (W_K₁ ^ 2 - b_K₁ ^ 2) (A_m * B_m + L_val ^ 2) hW2_sub_b2 hAB_add_L2
    have h2 := hval_mul_bound_K₁ (-2 * M₂ + -2 * M₂) (-M₂)
      ((W_K₁ ^ 2 - b_K₁ ^ 2) * (A_m * B_m + L_val ^ 2)) E_L h1 hEL_bound
    rcases h2 with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hN_bound : N_inner = 0 ∨ -5 * M₂ ≤ valL F K₁ N_inner :=
    hval_sub_K₁ (-5 * M₂) (-(L_val ^ 4 * E_b))
      ((W_K₁ ^ 2 - b_K₁ ^ 2) * (A_m * B_m + L_val ^ 2) * E_L) hN_term1 hN_term2
  have hA2_val : valL F K₁ (A_m ^ 2) = -2 * M₂ := by
    rw [hval_pow_K₁ A_m 2 hA_ne0, hA_val]; ring
  have hB2_val : valL F K₁ (B_m ^ 2) = -2 * M₂ := by
    rw [hval_pow_K₁ B_m 2 hB_ne0, hB_val]; ring
  have hD_val : valL F K₁ D_den = -8 * M₂ := by
    dsimp [D_den]
    rw [hval_mul_K₁ (L_val ^ 4 * A_m ^ 2) (B_m ^ 2) (mul_ne_zero hL4_ne0 hA2_ne0) hB2_ne0,
      hval_mul_K₁ (L_val ^ 4) (A_m ^ 2) hL4_ne0 hA2_ne0, hL4_val, hA2_val, hB2_val]
    ring
  have hWD_inv_val : valL F K₁ (W_K₁ ^ 2 * D_den⁻¹) = 6 * M₂ := by
    rw [hval_mul_K₁ (W_K₁ ^ 2) D_den⁻¹ hW2_ne0 (inv_ne_zero hD_ne0),
      hval_inv_elt_K₁ D_den hD_ne0, hW2_val, hD_val]
    ring
  have hΔ_wt_bound : Δ_wt m' = 0 ∨ S + M₂ ≤ valL F K₁ (Δ_wt m') := by
    rw [hΔ_wt_eq]
    have h1 := hval_mul_bound_K₁ S (-5 * M₂) (-(ξ m' * s_K₁)) N_inner hneg_ξs_bound hN_bound
    have h2 := hval_mul_bound_K₁ (S + -5 * M₂) (6 * M₂)
      ((-(ξ m' * s_K₁)) * N_inner) (W_K₁ ^ 2 * D_den⁻¹)
      h1 (Or.inr (le_of_eq hWD_inv_val.symm))
    rcases h2 with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hΔξ_pow_val :
      valL F K₁ (((Δ : K₁) + ξ m') ^ (p - 1)) = -(((p - 1) * t₁ : ℕ) : ℤ) := by
    rw [hval_pow_K₁ ((Δ : K₁) + ξ m') (p - 1) (hξΔ_val m' hm').2.1, (hξΔ_val m' hm').2.2]
    push_cast; ring
  have hinner_bound := hval_mul_bound_K₁
    (-(((p - 1) * t₁ : ℕ) : ℤ)) (S + M₂)
    (((Δ : K₁) + ξ m') ^ (p - 1)) (Δ_wt m')
    (Or.inr (le_of_eq hΔξ_pow_val.symm)) hΔ_wt_bound
  have hterm_bound := hval_mul_bound_K₁
    ((2 * (p - 1) * p * m + p * (p - 1) * δ : ℕ) : ℤ)
    (-(((p - 1) * t₁ : ℕ) : ℤ) + (S + M₂))
    P_out (((Δ : K₁) + ξ m') ^ (p - 1) * Δ_wt m')
    hP_val hinner_bound
  rcases hterm_bound with h0 | hge
  · exact Or.inl h0
  · right
    have ht₂_eq : t₂ = t₁ + δ := by dsimp [t₁, t₂, δ]; omega
    have hpm_ge : t₁ + 1 ≤ p * m := hpm_gt_t₁
    have h1 : (p - 1) * t₁ ≤ 2 * (p - 1) * p * m := by
      have ha : (p - 1) * t₁ ≤ (p - 1) * (p * m) :=
        Nat.mul_le_mul_left (p - 1) (by omega)
      have hb : (p - 1) * (p * m) ≤ 2 * ((p - 1) * (p * m)) := by omega
      linarith [show 2 * ((p - 1) * (p * m)) = 2 * (p - 1) * p * m by ring]
    have h2 : p * (t₁ + 1) ≤ p * p * m := by
      have ha : p * (t₁ + 1) ≤ p * (p * m) := Nat.mul_le_mul_left p hpm_ge
      linarith [show p * (p * m) = p * p * m by ring]
    have h3 : p * δ ≤ p * (p - 1) * δ := by
      have ha : 1 * δ ≤ (p - 1) * δ := Nat.mul_le_mul_right δ (by omega)
      have hb : p * (1 * δ) ≤ p * ((p - 1) * δ) := Nat.mul_le_mul_left p ha
      linarith [show p * (1 * δ) = p * δ by ring,
        show p * ((p - 1) * δ) = p * (p - 1) * δ by ring]
    have h4 : 1 + p * t₂ ≤ p * (p - 1) * δ + p * p * m := by
      rw [ht₂_eq]
      nlinarith
    have hineq_nat :
        (1 + p * t₂) + (p - 1) * t₁ ≤
          (2 * (p - 1) * p * m + p * (p - 1) * δ) + (p * (p - 1) * δ + p * p * m) := by
      omega
    have hineq_cast :
        (((1 + p * t₂) + (p - 1) * t₁ : ℕ) : ℤ) ≤
          (((2 * (p - 1) * p * m + p * (p - 1) * δ) + (p * (p - 1) * δ + p * p * m) : ℕ) : ℤ) :=
      Nat.cast_le.mpr hineq_nat
    have hineq_int :
        ((1 + p * t₂ : ℕ) : ℤ) ≤
          ((2 * (p - 1) * p * m + p * (p - 1) * δ : ℕ) : ℤ) +
            (-(((p - 1) * t₁ : ℕ) : ℤ) + (S + M₂)) := by
      dsimp [S, M₂]
      push_cast at hineq_cast ⊢
      linarith [hineq_cast]
    exact le_trans hineq_int hge

theorem ld_ch12_wild_odd_tot_ram_quad_linearized_error_teich_sum_bound (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (K₁ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K₁]
    (p bE' bM₁' a_lam : ℕ)
    (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 < p * (a_lam - bE'))
    (Δ : K₁ˣ) (W_K₁ b_K₁ s_K₁ P_out : K₁) (ξ : ℕ → K₁)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hW_ne : W_K₁ ≠ 0)
    (hW_val : valL F K₁ W_K₁ = -(((p * p * (a_lam - bE') : ℕ) : ℤ)))
    (hb_ne : b_K₁ ≠ 0)
    (hb_val : valL F K₁ b_K₁ = -(((p * (bM₁' - 1) : ℕ) : ℤ)))
    (hL_ne : W_K₁ + b_K₁ ≠ 0)
    (hL_val : valL F K₁ (W_K₁ + b_K₁) = -(((p * p * (a_lam - bE') : ℕ) : ℤ)))
    (hs_val : s_K₁ = 0 ∨ ((p * (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤ valL F K₁ s_K₁)
    (hP_val : P_out = 0 ∨
      ((2 * (p - 1) * p * (a_lam - bE') + p * (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤
        valL F K₁ P_out)
    (hξ0 : ξ 0 = 0)
    (hξ_props : ∀ m < p, 0 < m →
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hξ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0))) :
    let t₂ := bE' - 1
    let L_val := W_K₁ + b_K₁
    let Q_teich :=
      P_out *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 *
            (b_K₁ + ξ m') *
            ((L_val + ξ m') ^ 2)⁻¹)
    let Q_lin :=
      Q_teich -
        P_out * s_K₁ * W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹ *
          (∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ (p - 1))
    Q_lin - Q_teich = 0 ∨
      ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (Q_lin - Q_teich) :=
by
  intro t₂ L_val Q_teich Q_lin
  obtain ⟨hval0_K₁, hval1_K₁, _, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁, _, hval_add_K₁, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K₁
  set t₁ : ℕ := bM₁' - 1
  set δ : ℕ := bE' - bM₁'
  set m : ℕ := a_lam - bE'
  set S : ℕ := p * (p - 1) * δ
  set m₁ : ℕ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  set B_pow : ℕ := p * p * (3 * p * m₁ + 1)
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := hPrime.pos
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_eq : t₂ = t₁ + δ := by dsimp [t₁, t₂, δ]; omega
  have hval_pow_K₁ : ∀ (x : K₁) (k : ℕ), x ≠ 0 → valL F K₁ (x ^ k) = (k : ℤ) * valL F K₁ x := by
    intro x k hx
    induction k with
    | zero => simp [hval1_K₁]
    | succ k ih =>
      rw [pow_succ, hval_mul_K₁ (x ^ k) x (pow_ne_zero k hx) hx, ih]
      push_cast
      ring
  have hval_inv_elt_K₁ : ∀ (x : K₁), x ≠ 0 → valL F K₁ x⁻¹ = - valL F K₁ x := by
    intro x hx
    exact hval_inv_K₁ (Units.mk0 x hx)
  have hval_neg_ge_K₁ : ∀ (k : ℤ) (x : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (-x = 0 ∨ k ≤ valL F K₁ (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · right; rwa [hval_neg_K₁]
  have hval_sub_K₁ : ∀ (k : ℤ) (x y : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_K₁ k x (-y) hx (hval_neg_ge_K₁ k y hy)
  have hval_mul_ge_K₁ : ∀ (k₁ k₂ : ℤ) (x y : K₁),
      (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        rw [hval_mul_K₁ x y hx0 hy0]
        have h1 : k₁ ≤ valL F K₁ x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F K₁ y := hy.resolve_left hy0
        omega
  have hval_mono_K₁ : ∀ (k₁ k₂ : ℤ) (x : K₁),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F K₁ x) → (x = 0 ∨ k₁ ≤ valL F K₁ x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hval_sum_K₁ : ∀ (S₀ : Finset ℕ) (f : ℕ → K₁) (k : ℤ),
      (∀ i ∈ S₀, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
        ((∑ i ∈ S₀, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ S₀, f i)) := by
    intro S₀ f k hf
    induction S₀ using Finset.induction_on with
    | empty => left; simp
    | @insert a s₀ ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add_K₁ k (f a) (∑ x ∈ s₀, f x)
        (hf a (Finset.mem_insert_self a s₀))
        (ih (fun x hx => hf x (Finset.mem_insert_of_mem hx)))
  have hval_natCast_K₁ : ∀ (n : ℕ),
      ((n : ℕ) : K₁) = 0 ∨ (0 : ℤ) ≤ valL F K₁ ((n : ℕ) : K₁) := by
    intro n
    induction n with
    | zero => left; simp
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_K₁ 0 ((n : ℕ) : K₁) 1 ih (Or.inr (by rw [hval1_K₁]))
  set Pref : K₁ := P_out * s_K₁ * W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹
  set Sigma_xi : K₁ := ∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ (p - 1)
  have hQ_diff_eq : Q_lin - Q_teich = -(Pref * Sigma_xi) := by
    dsimp [Q_lin, Pref, Sigma_xi]
    ring
  have hW2_ne : W_K₁ ^ 2 ≠ 0 := pow_ne_zero 2 hW_ne
  have hW2_val : valL F K₁ (W_K₁ ^ 2) = -(((2 * p * p * m : ℕ) : ℤ)) := by
    rw [hval_pow_K₁ W_K₁ 2 hW_ne, hW_val]
    dsimp [m]; push_cast; ring
  have hb2_ne : b_K₁ ^ 2 ≠ 0 := pow_ne_zero 2 hb_ne
  have hb2_val : valL F K₁ (b_K₁ ^ 2) = -(((2 * p * t₁ : ℕ) : ℤ)) := by
    rw [hval_pow_K₁ b_K₁ 2 hb_ne, hb_val]
    dsimp [t₁]; push_cast; ring
  have hpt₁_le_ppm : 2 * p * t₁ ≤ 2 * p * p * m := by
    have h1 : p * t₁ ≤ p * (p * m) := Nat.mul_le_mul_left p (le_of_lt hpm_gt_t₁)
    dsimp [m]
    nlinarith
  have hW2_sub_b2_val :
      W_K₁ ^ 2 - b_K₁ ^ 2 = 0 ∨
        -(((2 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (W_K₁ ^ 2 - b_K₁ ^ 2) := by
    apply hval_sub_K₁ (-(((2 * p * p * m : ℕ) : ℤ))) (W_K₁ ^ 2) (b_K₁ ^ 2)
    · right; rw [hW2_val]
    · right; rw [hb2_val]; omega
  have hL4_ne : L_val ^ 4 ≠ 0 := pow_ne_zero 4 hL_ne
  have hL4_inv_val : valL F K₁ (L_val ^ 4)⁻¹ = (((4 * p * p * m : ℕ) : ℤ)) := by
    rw [hval_inv_elt_K₁ (L_val ^ 4) hL4_ne, hval_pow_K₁ L_val 4 hL_ne, hL_val]
    dsimp [m]; push_cast; ring
  have hF_b_val :
      W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹ = 0 ∨
        (0 : ℤ) ≤ valL F K₁ (W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹) := by
    have h1 := hval_mul_ge_K₁ (-(((2 * p * p * m : ℕ) : ℤ))) (-(((2 * p * p * m : ℕ) : ℤ)))
      (W_K₁ ^ 2) (W_K₁ ^ 2 - b_K₁ ^ 2) (Or.inr (by rw [hW2_val])) hW2_sub_b2_val
    have h2 := hval_mul_ge_K₁
      (-(((2 * p * p * m : ℕ) : ℤ)) + -(((2 * p * p * m : ℕ) : ℤ)))
      (((4 * p * p * m : ℕ) : ℤ))
      (W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2)) (L_val ^ 4)⁻¹
      h1 (Or.inr (by rw [hL4_inv_val]))
    rcases h2 with h0 | hge
    · exact Or.inl h0
    · right; push_cast at hge; linarith
  have hPs_val :
      P_out * s_K₁ = 0 ∨
        ((2 * (p - 1) * p * m + 2 * S : ℕ) : ℤ) ≤ valL F K₁ (P_out * s_K₁) := by
    have h := hval_mul_ge_K₁
      ((2 * (p - 1) * p * m + S : ℕ) : ℤ) ((S : ℕ) : ℤ)
      P_out s_K₁ hP_val hs_val
    rcases h with h0 | hge
    · exact Or.inl h0
    · right
      have hcast : ((2 * (p - 1) * p * m + 2 * S : ℕ) : ℤ) =
          ((2 * (p - 1) * p * m + S : ℕ) : ℤ) + ((S : ℕ) : ℤ) := by
        push_cast; ring
      linarith
  have hPref_val :
      Pref = 0 ∨
        ((2 * (p - 1) * p * m + 2 * S : ℕ) : ℤ) ≤ valL F K₁ Pref := by
    have hPref_assoc : Pref = (P_out * s_K₁) * (W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹) := by
      dsimp [Pref]; ring
    rw [hPref_assoc]
    have h := hval_mul_ge_K₁
      ((2 * (p - 1) * p * m + 2 * S : ℕ) : ℤ) 0
      (P_out * s_K₁) (W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹)
      hPs_val hF_b_val
    simpa using h
  have hterm_binom : ∀ m' : ℕ,
      ξ m' * ((Δ : K₁) + ξ m') ^ (p - 1) =
        ∑ r ∈ Finset.range p,
          (((p - 1).choose r : ℕ) : K₁) * (Δ : K₁) ^ (p - 1 - r) * (ξ m') ^ (r + 1) := by
    intro m'
    have h_add : (Δ : K₁) + ξ m' = ξ m' + (Δ : K₁) := add_comm _ _
    have hp_sub : p - 1 + 1 = p := Nat.sub_add_cancel (by omega)
    rw [h_add, add_pow (ξ m') (Δ : K₁) (p - 1), hp_sub, Finset.mul_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [pow_succ']
    ring
  have hSigma_binom :
      Sigma_xi =
        ∑ r ∈ Finset.range p,
          ((((p - 1).choose r : ℕ) : K₁) * (Δ : K₁) ^ (p - 1 - r)) *
            (∑ m' ∈ (Finset.range p).erase 0, (ξ m') ^ (r + 1)) := by
    dsimp [Sigma_xi]
    simp_rw [hterm_binom]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [← Finset.mul_sum]
    congr 1
    have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
    rw [← Finset.add_sum_erase (Finset.range p) (fun m' => (ξ m') ^ (r + 1)) h0_mem,
      hξ0, zero_pow (by omega), zero_add]
  have hSigma_val :
      Sigma_xi = 0 ∨ -((t₁ : ℕ) : ℤ) ≤ valL F K₁ Sigma_xi := by
    rw [hSigma_binom]
    apply hval_sum_K₁ (Finset.range p) _ (-((t₁ : ℕ) : ℤ))
    intro r hr_mem
    have hr : r < p := Finset.mem_range.mp hr_mem
    set C_r : K₁ := (((p - 1).choose r : ℕ) : K₁) * (Δ : K₁) ^ (p - 1 - r)
    set S_pow : K₁ := ∑ m' ∈ (Finset.range p).erase 0, (ξ m') ^ (r + 1)
    have hΔ_pow_val :
        valL F K₁ ((Δ : K₁) ^ (p - 1 - r)) = -(((p - 1 - r) * t₁ : ℕ) : ℤ) := by
      rw [hval_pow_K₁ (Δ : K₁) (p - 1 - r) (Units.ne_zero Δ), hΔ_val]
      dsimp [t₁]; push_cast; ring
    have hCr_val :
        C_r = 0 ∨ -(((p - 1 - r) * t₁ : ℕ) : ℤ) ≤ valL F K₁ C_r := by
      have h := hval_mul_ge_K₁ 0 (-(((p - 1 - r) * t₁ : ℕ) : ℤ))
        (((p - 1).choose r : ℕ) : K₁) ((Δ : K₁) ^ (p - 1 - r))
        (hval_natCast_K₁ ((p - 1).choose r)) (Or.inr (by rw [hΔ_pow_val]))
      rw [zero_add] at h
      exact h
    by_cases hr_lt : r < p - 2
    · have hr1_mem : r + 1 ∈ Finset.Icc 1 (2 * (p - 1)) :=
        Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have h_ndvd : ¬ ((p - 1) ∣ (r + 1)) :=
        Nat.not_dvd_of_pos_of_lt (by omega) (by omega)
      have hpow_sum := hξ_pow_sum (r + 1) hr1_mem
      dsimp only at hpow_sum
      rw [if_neg h_ndvd, sub_zero] at hpow_sum
      have hprod := hval_mul_ge_K₁
        (-(((p - 1 - r) * t₁ : ℕ) : ℤ)) ((B_pow : ℕ) : ℤ)
        C_r S_pow hCr_val hpow_sum
      rcases hprod with h0 | hge
      · exact Or.inl h0
      · right
        have ht₁_le_m₁ : t₁ ≤ m₁ := by dsimp [t₁, m₁]; omega
        have h_le_B : (p - 1 - r) * t₁ ≤ B_pow := by
          dsimp [B_pow]
          have h1 : (p - 1 - r) * t₁ ≤ p * m₁ := Nat.mul_le_mul (by omega) ht₁_le_m₁
          have h2 : 1 ≤ p * (3 * p) := by nlinarith
          have h3 : p * m₁ ≤ p * p * (3 * p * m₁ + 1) := by
            calc p * m₁ = 1 * (p * m₁) := (one_mul _).symm
              _ ≤ (p * (3 * p)) * (p * m₁) := Nat.mul_le_mul_right (p * m₁) h2
              _ = p * p * (3 * p * m₁) := by ring
              _ ≤ p * p * (3 * p * m₁ + 1) := Nat.mul_le_mul_left (p * p) (by omega)
          exact le_trans h1 h3
        have h_ineq : -((t₁ : ℕ) : ℤ) ≤ -(((p - 1 - r) * t₁ : ℕ) : ℤ) + ((B_pow : ℕ) : ℤ) := by
          zify at h_le_B; omega
        exact le_trans h_ineq hge
    · have hSpow_val0 : S_pow = 0 ∨ (0 : ℤ) ≤ valL F K₁ S_pow := by
        apply hval_sum_K₁ ((Finset.range p).erase 0) (fun m' => (ξ m') ^ (r + 1)) 0
        intro m' hm'_mem
        obtain ⟨hm'_ne0, hm'_range⟩ := Finset.mem_erase.mp hm'_mem
        have hm'_lt : m' < p := Finset.mem_range.mp hm'_range
        have hm'_pos : 0 < m' := Nat.pos_of_ne_zero hm'_ne0
        obtain ⟨hξ_ne0, hξ_val0, _⟩ := hξ_props m' hm'_lt hm'_pos
        right
        rw [hval_pow_K₁ (ξ m') (r + 1) hξ_ne0, hξ_val0, mul_zero]
      have hprod := hval_mul_ge_K₁
        (-(((p - 1 - r) * t₁ : ℕ) : ℤ)) 0 C_r S_pow hCr_val hSpow_val0
      rcases hprod with h0 | hge
      · exact Or.inl h0
      · right
        have h_sub_le1 : p - 1 - r ≤ 1 := by omega
        have h_mul_le : (p - 1 - r) * t₁ ≤ t₁ := by
          calc (p - 1 - r) * t₁ ≤ 1 * t₁ := Nat.mul_le_mul_right t₁ h_sub_le1
            _ = t₁ := Nat.one_mul t₁
        have h_ineq : -((t₁ : ℕ) : ℤ) ≤ -(((p - 1 - r) * t₁ : ℕ) : ℤ) + 0 := by
          zify at h_mul_le; omega
        exact le_trans h_ineq hge
  rw [hQ_diff_eq]
  apply hval_neg_ge_K₁ ((1 + p * t₂ : ℕ) : ℤ) (Pref * Sigma_xi)
  have hprod_final := hval_mul_ge_K₁
    ((2 * (p - 1) * p * m + 2 * S : ℕ) : ℤ) (-((t₁ : ℕ) : ℤ))
    Pref Sigma_xi hPref_val hSigma_val
  rcases hprod_final with h0 | hge
  · exact Or.inl h0
  · right
    have hpm_ge : t₁ + 1 ≤ p * m := hpm_gt_t₁
    have h1 : (p + 1) * (t₁ + 1) ≤ 2 * (p - 1) * (p * m) := by
      calc (p + 1) * (t₁ + 1) ≤ (2 * (p - 1)) * (t₁ + 1) :=
            Nat.mul_le_mul_right (t₁ + 1) (by omega)
        _ ≤ 2 * (p - 1) * (p * m) := Nat.mul_le_mul_left (2 * (p - 1)) hpm_ge
    have h2 : p * δ ≤ 2 * S := by
      dsimp [S]
      calc p * δ = 1 * (p * δ) := (one_mul _).symm
        _ ≤ (2 * (p - 1)) * (p * δ) := Nat.mul_le_mul_right (p * δ) (by omega)
        _ = 2 * (p * (p - 1) * δ) := by ring
    have hineq_nat : 1 + p * t₂ + t₁ ≤ 2 * (p - 1) * p * m + 2 * S := by
      rw [ht₂_eq]
      nlinarith
    have hineq_int :
        ((1 + p * t₂ : ℕ) : ℤ) ≤
          ((2 * (p - 1) * p * m + 2 * S : ℕ) : ℤ) + -((t₁ : ℕ) : ℤ) := by
      zify at hineq_nat
      push_cast
      linarith
    exact le_trans hineq_int hge

theorem ld_ch12_wild_odd_tot_ram_quad_translated_norm_to_teich_sum (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hT_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T)
    (ξ : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hξ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)))
    (hΔ_norm_poly_approx : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let s := - e_Δ (p - 1)
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
          (IntermediateField.inclusion hM₁'K₁ b + ξ m -
            ξ m * IntermediateField.inclusion hM₁'K₁ s) = 0 ∨
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
              (IntermediateField.inclusion hM₁'K₁ b + ξ m -
                ξ m * IntermediateField.inclusion hM₁'K₁ s))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₂ := bE' - 1
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
    let L_val := W_K₁ + IntermediateField.inclusion hM₁'K₁ b
    let Q_norm :=
      IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
        IntermediateField.inclusion hM₁'K₁ T *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) ^ 2))⁻¹)
    let Q_teich :=
      IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
        IntermediateField.inclusion hM₁'K₁ T *
        (∑ m' ∈ Finset.range p,
          ((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 *
            (IntermediateField.inclusion hM₁'K₁ b + ξ m') *
            ((L_val + ξ m') ^ 2)⁻¹)
    Q_norm - Q_teich = 0 ∨
      ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (Q_norm - Q_teich) :=
by
  intro p t₂ b u W z u_M₁' T W_K₁ L_val Q_norm Q_teich
  obtain ⟨_, _, _, _, _, _, _, hvalK₁_add, _, _, _⟩ := ld_valL_and_unitGroup_props F K₁
  obtain ⟨hW_ne, hW_val, hb_ne, hb_val, hL_ne, hL_val, hs_val, hP_val, hξΔ_val, hQ_norm_poly⟩ :=
    ld_ch12_wild_odd_tot_ram_quad_base_vals_and_norm_to_poly_sum F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      Δ hΔ_val e_Δ he_Δ_val α γ w₂ hα_val hγ_val hw₂_val hT_val
      ξ hξ0 hξ_props hΔ_norm_poly_approx
  set b_K₁ := IntermediateField.inclusion hM₁'K₁ b
  set s_K₁ := IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1))
  set P_out :=
    IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
      IntermediateField.inclusion hM₁'K₁ T
  have hQ_poly_lin :=
    ld_ch12_wild_odd_tot_ram_quad_poly_weight_to_linearized_sum F K₁
      p bE' bM₁' a_lam hPrime hp_odd hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      Δ W_K₁ b_K₁ s_K₁ P_out ξ
      hW_ne hW_val hb_ne hb_val hL_ne hL_val hs_val hP_val hξΔ_val
  have hQ_lin_teich :=
    ld_ch12_wild_odd_tot_ram_quad_linearized_error_teich_sum_bound F K₁
      p bE' bM₁' a_lam hPrime hp_odd hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      Δ W_K₁ b_K₁ s_K₁ P_out ξ
      hΔ_val hW_ne hW_val hb_ne hb_val hL_ne hL_val hs_val hP_val
      hξ0 hξ_props hξ_pow_sum
  dsimp only at hQ_norm_poly hQ_poly_lin hQ_lin_teich
  set Q_poly :=
    P_out *
      (∑ m' ∈ Finset.range p,
        ((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 *
          (b_K₁ + ξ m' - ξ m' * s_K₁) *
          ((L_val + ξ m' - ξ m' * s_K₁) ^ 2)⁻¹)
  set Q_lin :=
    Q_teich -
      P_out * s_K₁ * W_K₁ ^ 2 * (W_K₁ ^ 2 - b_K₁ ^ 2) * (L_val ^ 4)⁻¹ *
        (∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ (p - 1))
  have hrew : Q_norm - Q_teich =
      (Q_norm - Q_poly) + ((Q_poly - Q_lin) + (Q_lin - Q_teich)) := by
    ring
  rw [hrew]
  exact hvalK₁_add ((1 + p * t₂ : ℕ) : ℤ) _ _ hQ_norm_poly
    (hvalK₁_add ((1 + p * t₂ : ℕ) : ℤ) _ _ hQ_poly_lin hQ_lin_teich)

theorem ld_ch12_wild_odd_tot_ram_linear_and_quad_conj_sum_reduction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')))
    (hTwistedTr : ∀ (Y : E') (i : ℕ),
      i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hT_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T)
    (ξ Δ_conj : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hΔ_conj0 : Δ_conj 0 = (Δ : K₁))
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hξ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)))
    (hΔ_conj_val : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -((bM₁' - 1 : ℕ) : ℤ))
    (hW_conj_sum : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let u_M₁' := IntermediateField.inclusion hLM₁' u
      let n := u_M₁' * b
      let W_fn : ℕ → E' := fun i =>
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
            (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
      IntermediateField.inclusion hE'K₁ (W_fn i) =
        ∑ m ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
            (Δ_conj m) ^ i *
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) *
            (IntermediateField.inclusion hM₁'K₁
              (1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)))⁻¹)
    (hQ_conj_sum :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let u_M₁' := IntermediateField.inclusion hLM₁' u
      let n := u_M₁' * b
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      let Q_quad : E' :=
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
            (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
      IntermediateField.inclusion hE'K₁ Q_quad =
        ∑ m ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
            (Δ_conj m) ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁
              (normLM F hM₁'K₁ (Δ_conj m) *
                traceLM F hM₁'K₁
                  ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) *
                    Δ_conj m) ^ (p - 1))) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)) ^ 2))⁻¹)
    (hTr_top_conj_sum :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1))) =
        ∑ m ∈ Finset.range p, (Δ_conj m) ^ (p - 1))
    (hΔ_conj_approx : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let s := - e_Δ (p - 1)
      (Δ_conj m - ((Δ : K₁) + ξ m) = 0 ∨
        ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (Δ_conj m - ((Δ : K₁) + ξ m))) ∧
      ((Δ_conj m - ((Δ : K₁) + ξ m)) -
          ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m = 0 ∨
        ((p * (p - 1) * t₂ - (p - 2) * t₁ : ℕ) : ℤ) ≤
          valL F K₁
            ((Δ_conj m - ((Δ : K₁) + ξ m)) -
              ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m)) ∧
      (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) = 0 ∨
        ((p * (t₂ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
              IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)))) ∧
      (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
          (IntermediateField.inclusion hM₁'K₁ b + ξ m -
            ξ m * IntermediateField.inclusion hM₁'K₁ s) = 0 ∨
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
              (IntermediateField.inclusion hM₁'K₁ b + ξ m -
                ξ m * IntermediateField.inclusion hM₁'K₁ s)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₂ := bE' - 1
    let m := a_lam - bE'
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let s := - e_Δ (p - 1)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let n := u_M₁' * b
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let W_fn : ℕ → E' := fun i =>
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
    let Q_quad : E' :=
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
          (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
    let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
    let L_val := W_K₁ + IntermediateField.inclusion hM₁'K₁ b
    let D_norm := L_val ^ p - L_val
    let A_star := (Δ : K₁) - L_val
    L_val ≠ 0 ∧ D_norm ≠ 0 ∧
    valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ D_norm = -(((p * p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ A_star = -(((p * p * m : ℕ) : ℤ)) ∧
    (∀ m' < p,
      L_val + ξ m' ≠ 0 ∧ valL F K₁ (L_val + ξ m') = -(((p * p * m : ℕ) : ℤ))) ∧
    (∀ i ∈ Finset.Icc 1 (p - 1),
      let W_teich :=
        IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
            (∑ m' ∈ Finset.range p,
              ((Δ : K₁) + ξ m') ^ i * W_K₁ *
                (IntermediateField.inclusion hM₁'K₁ b + ξ m') *
                (L_val + ξ m')⁻¹) -
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
            IntermediateField.inclusion hM₁'K₁ (s * (1 + u_M₁' * b)⁻¹ ^ 2) *
            (∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ i)
      IntermediateField.inclusion hE'K₁ (W_fn i) - W_teich = 0 ∨
        ((1 + p * t₂ : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hE'K₁ (W_fn i) - W_teich)) ∧
    (let Q_teich :=
       IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
         IntermediateField.inclusion hM₁'K₁ T *
         (∑ m' ∈ Finset.range p,
           ((Δ : K₁) + ξ m') ^ (p - 1) * W_K₁ ^ 2 *
             (IntermediateField.inclusion hM₁'K₁ b + ξ m') *
             ((L_val + ξ m') ^ 2)⁻¹)
     IntermediateField.inclusion hE'K₁ Q_quad - Q_teich = 0 ∨
       ((1 + p * t₂ : ℕ) : ℤ) ≤
         valL F K₁ (IntermediateField.inclusion hE'K₁ Q_quad - Q_teich)) :=
by
  intro p t₂ m b s u W z u_M₁' n T W_fn Q_quad W_K₁ L_val D_norm A_star
  obtain ⟨_, _, _, _, _, _, _, hvalK₁_add, _, _, _⟩ := ld_valL_and_unitGroup_props F K₁
  obtain ⟨hL_ne0, hD_ne0, hL_val, hD_val, hA_val, hL_xi_val, hW_teich⟩ :=
    ld_ch12_wild_odd_tot_ram_lval_vals_and_linear_conj_sum_reduction F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      Δ hΔ_val hΔ_tr_top e_Δ he_Δ_val
      α γ w₂ hα_val hγ_val hw₂_val
      ξ Δ_conj hξ0 hΔ_conj0 hξ_props hξ_pow_sum hΔ_conj_val
      hW_conj_sum hTr_top_conj_sum hΔ_conj_approx
  have hQ_norm :=
    ld_ch12_wild_odd_tot_ram_quad_conj_to_translated_norm_sum F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁ htr_M₁'K₁
      Δ hΔ_val hTwistedTr e_Δ he_Δ_val
      α γ w₂ hα_val hγ_val hw₂_val hT_val
      ξ Δ_conj hξ0 hΔ_conj0 hξ_props hξ_pow_sum hΔ_conj_val
      hQ_conj_sum hΔ_conj_approx
  have hQ_teich_diff :=
    ld_ch12_wild_odd_tot_ram_quad_translated_norm_to_teich_sum F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      Δ hΔ_val e_Δ he_Δ_val α γ w₂ hα_val hγ_val hw₂_val hT_val
      ξ hξ0 hξ_props hξ_pow_sum (fun m hm => (hΔ_conj_approx m hm).2.2.2)
  refine ⟨hL_ne0, hD_ne0, hL_val, hD_val, hA_val, hL_xi_val, hW_teich, ?_⟩
  intro Q_teich
  dsimp only at hQ_norm hQ_teich_diff
  set Q_norm :=
    IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
      IntermediateField.inclusion hM₁'K₁ T *
      (∑ m' ∈ Finset.range p,
        ((Δ : K₁) + ξ m') ^ (p - 1) *
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) *
          (IntermediateField.inclusion hM₁'K₁
            ((1 + u_M₁' * normLM F hM₁'K₁ ((Δ : K₁) + ξ m')) ^ 2))⁻¹)
  have hrew : IntermediateField.inclusion hE'K₁ Q_quad - Q_teich =
      (IntermediateField.inclusion hE'K₁ Q_quad - Q_norm) + (Q_norm - Q_teich) := by
    ring
  rw [hrew]
  exact hvalK₁_add ((1 + p * t₂ : ℕ) : ℤ) _ _ hQ_norm hQ_teich_diff

theorem ld_ch12_wild_odd_tot_ram_teichmuller_binom_master_and_linear_poly_sums (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (ξ : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hξ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    (∀ i ∈ Finset.Icc 1 (p - 1), ∀ k ∈ Finset.range (p - 1),
      let B_main :=
        (if k = 0 then ((p : ℕ) : K₁) * ((Δ : K₁) ^ i) else 0) +
          (if p - 1 - i ≤ k then
            ((p - 1 : ℕ) : K₁) * ((i.choose (p - 1 - k) : ℕ) : K₁) *
              ((Δ : K₁) ^ (i - (p - 1 - k)))
          else 0)
      (∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * (ξ m') ^ k) - B_main = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤
          valL F K₁
            ((∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * (ξ m') ^ k) - B_main)) ∧
    (∀ i ∈ Finset.Icc 1 (p - 1),
      let S1_main :=
        ((p : ℕ) : K₁) * ((Δ : K₁) ^ i) +
          ((p - 1 : ℕ) : K₁) * (if i = p - 1 then 1 else 0)
      (∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i) - S1_main = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤
          valL F K₁
            ((∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i) - S1_main)) ∧
    (∀ i ∈ Finset.Icc 1 (p - 1),
      let S_xi_main :=
        ((p - 1 : ℕ) : K₁) *
          ((if i = p - 2 then 1 else 0) +
            ((i : ℕ) : K₁) * (Δ : K₁) * (if i = p - 1 then 1 else 0))
      (∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ i) - S_xi_main = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤
          valL F K₁
            ((∑ m' ∈ Finset.range p, ξ m' * ((Δ : K₁) + ξ m') ^ i) - S_xi_main)) :=
by
  intro p t₁ m₁
  have halg : ∀ z : K₁,
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F K₁ = (minpoly F z).natDegree * m := by
    clear hΔ_val hξ_pow_sum ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq K₁.val K₁.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  have hrel0 : relVal F K₁ 0 = 0 := by
    unfold relVal
    rw [Algebra.norm_zero, haddVal0]
  have hrel1 : relVal F K₁ 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x y : K₁, x ≠ 0 → y ≠ 0 → relVal F K₁ (x * y) = relVal F K₁ x + relVal F K₁ y := by
    intro x y hx hy
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ hnx hny]
  have hrel_inv : ∀ u : K₁ˣ, relVal F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - relVal F K₁ (u : K₁) := by
    intro u
    have hmul : relVal F K₁ ((u : K₁) * ((u⁻¹ : K₁ˣ) : K₁)) =
        relVal F K₁ (u : K₁) + relVal F K₁ ((u⁻¹ : K₁ˣ) : K₁) :=
      hrel_mul (u : K₁) ((u⁻¹ : K₁ˣ) : K₁) (Units.ne_zero u) (Units.ne_zero u⁻¹)
    rw [Units.mul_inv, hrel1] at hmul
    omega
  have hrel_pow : ∀ (u : K₁ˣ) (n : ℕ),
      relVal F K₁ (((u ^ n : K₁ˣ) : K₁)) = (n : ℤ) * relVal F K₁ (u : K₁) := by
    intro u n
    induction n with
    | zero =>
      simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hrel_zpow : ∀ (u : K₁ˣ) (m : ℤ),
      relVal F K₁ (((u ^ m : K₁ˣ) : K₁)) = m * relVal F K₁ (u : K₁) := by
    intro u m
    cases m with
    | ofNat n =>
      change relVal F K₁ (((u ^ (n : ℤ) : K₁ˣ) : K₁)) = (n : ℤ) * relVal F K₁ (u : K₁)
      rw [zpow_natCast, hrel_pow]
    | negSucc n =>
      rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
      push_cast
      ring
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : K₁ := algebraMap F K₁ π
  have hx₀_ne : x₀ ≠ 0 := by
    simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F K₁ x₀ = (Module.finrank F K₁ : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F K₁) hπ_ne, hadd_π, mul_one]
  have hfin_pos : 0 < Module.finrank F K₁ := Module.finrank_pos
  let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : K₁, x ≠ 0 ∧ relVal F K₁ x = k}
  have hS_nonempty : S.Nonempty := ⟨Module.finrank F K₁, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfL_mem : resDeg F K₁ ∈ S := Nat.sInf_mem hS_nonempty
  obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
  let ϖL : K₁ˣ := Units.mk0 ϖ₀ hϖ₀_ne
  have hrel_ϖL : relVal F K₁ (ϖL : K₁) = (resDeg F K₁ : ℤ) := hrel_ϖ₀
  have hfL_int_pos : (0 : ℤ) < (resDeg F K₁ : ℤ) := Nat.cast_pos.mpr hfL_pos
  have hfL_int_ne : (resDeg F K₁ : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
  have hdiv : ∀ x : K₁, relVal F K₁ x = (resDeg F K₁ : ℤ) * valL F K₁ x := by
    intro x
    by_cases hx : x = 0
    · unfold valL
      rw [hx, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F K₁ : ℤ)
      set q : ℤ := valL F K₁ x
      set r : ℤ := relVal F K₁ x % f
      have hediv : f * q + r = relVal F K₁ x := Int.mul_ediv_add_emod (relVal F K₁ x) f
      have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F K₁ x) hfL_int_ne
      have hr_lt : r < f := Int.emod_lt_of_pos (relVal F K₁ x) hfL_int_pos
      have hr_zero : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
        let y : K₁ := x * (((ϖL ^ (-q) : K₁ˣ) : K₁))
        have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
        have hrel_y : relVal F K₁ y = r := by
          dsimp [y]
          rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
          linarith
        let k : ℕ := r.toNat
        have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F K₁ := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F K₁ ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  have hval0 : valL F K₁ 0 = 0 := by
    have h := hdiv 0
    rw [hrel0] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hval1 : valL F K₁ 1 = 0 := by
    have h := hdiv 1
    rw [hrel1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hval_mul : ∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y := by
    intro x y hx hy
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
