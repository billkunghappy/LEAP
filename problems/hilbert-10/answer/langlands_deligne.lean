      have hcast := congrArg (Nat.cast : ℕ → M₁') hm
      simpa only [Nat.cast_mul, Nat.cast_add, Nat.cast_one] using hcast
    let zp : M₁' := ((p : ℕ) : M₁') * ((m : ℕ) : M₁')
    have hzp_1 : zp = 0 ∨ (1 : ℤ) ≤ valL F M₁' zp := by
      have h1 := hvalM₁'_mul_ge 1 0 ((p : ℕ) : M₁') ((m : ℕ) : M₁') hp_valM₁' (hvalM₁'_natCast m)
      simpa [zp] using h1
    have hzp_0 : zp = 0 ∨ (0 : ℤ) ≤ valL F M₁' zp := hvalM₁'_mono 0 1 zp (by omega) hzp_1
    have hzp1_0 : zp + 1 = 0 ∨ (0 : ℤ) ≤ valL F M₁' (zp + 1) :=
      hvalM₁'_add 0 zp 1 hzp_0 (Or.inr (by rw [hvalM₁'_1]))
    have hzp1_not_1 : ¬ (zp + 1 = 0 ∨ (1 : ℤ) ≤ valL F M₁' (zp + 1)) := by
      intro h1
      have hsub := hvalM₁'_sub 1 (zp + 1) zp h1 hzp_1
      have heq1 : (zp + 1) - zp = 1 := by ring
      rw [heq1, hvalM₁'_1] at hsub
      rcases hsub with h0 | hle
      · exact one_ne_zero h0
