    rw [hK_target_def]
    push_cast
    rw [hp1_cast, ht₂_eq]
    linarith

  have hTerm2 : P_out * G₁ * (F₂ - G₂) * F₃ = 0 ∨
      K_target ≤ valL F K₁ (P_out * G₁ * (F₂ - G₂) * F₃) := by
    apply hvalK₁_mul4 _ _ _ _ K_target P_out G₁ (F₂ - G₂) F₃
      hP_out_val hG₁_val hF₂_sub_G₂ hF₃_val
    rw [hK_target_def]
    push_cast
    rw [hp1_cast, ht₂_eq]
    linarith

  have hTerm3 : P_out * G₁ * G₂ * (F₃ - G₃) = 0 ∨
      K_target ≤ valL F K₁ (P_out * G₁ * G₂ * (F₃ - G₃)) := by
    apply hvalK₁_mul4 _ _ _ _ K_target P_out G₁ G₂ (F₃ - G₃)
      hP_out_val hG₁_val hG₂_val hF₃_sub_G₃
    rw [hK_target_def]
    push_cast
    rw [hp1_cast, ht₂_eq]
    linarith

  have hQ_interp_diff :
      Q_interp - P_out * (G₁ * G₂ * G₃) = 0 ∨
        K_target ≤ valL F K₁ (Q_interp - P_out * (G₁ * G₂ * G₃)) := by
    rw [hQ_telesc]
    exact hvalK₁_add K_target _ _
      (hvalK₁_add K_target _ _ hTerm1 hTerm2) hTerm3

  have hConj1 : Q_quad - ((p - 1 : ℕ) : E') * y_T = 0 ∨
      (bE' : ℤ) ≤ valL F E' (Q_quad - ((p - 1 : ℕ) : E') * y_T) := by
    apply pullback_E'K₁
    have hQ_in : IntermediateField.inclusion hE'K₁ Q_quad - Q_interp = 0 ∨
        K_target ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ Q_quad - Q_interp) := hQ_interp
    have hsum := hvalK₁_add K_target
      (IntermediateField.inclusion hE'K₁ Q_quad - Q_interp)
      (Q_interp - P_out * (G₁ * G₂ * G₃))
      hQ_in hQ_interp_diff
    have heq : (IntermediateField.inclusion hE'K₁ Q_quad - Q_interp) +
        (Q_interp - P_out * (G₁ * G₂ * G₃)) =
        IntermediateField.inclusion hE'K₁ (Q_quad - ((p - 1 : ℕ) : E') * y_T) := by
      rw [map_sub, ← hG_prod_K₁]
      ring
    rwa [heq] at hsum

  
  have hw₂_norm_val : normLM F hLE' (w₂ : E') = (γ : L) * ((α⁻¹ : Lˣ) : L) := by
    have h := congrArg Units.val hw₂_norm
    simpa [Units.val_mul] using h
  have hu_norm_L : u * normLM F hLE' (w₂ : E') = 1 := by
    rw [hu_def, hw₂_norm_val]
    have hα : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    have hγ : ((γ⁻¹ : Lˣ) : L) * (γ : L) = 1 := Units.inv_mul γ
    linear_combination (γ : L) * ((γ⁻¹ : Lˣ) : L) * hα + hγ
  have hu_norm_E' :
      IntermediateField.inclusion hLE' u *
        IntermediateField.inclusion hLE' (normLM F hLE' (w₂ : E')) = 1 := by
    rw [← map_mul, hu_norm_L, map_one]

  
  have hs_E'_val : ∀ i ∈ Finset.Icc 1 (p - 1),
      IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) = 0 ∨
