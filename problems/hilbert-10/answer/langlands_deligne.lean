        rw [Finset.sum_congr rfl fun x _ => h_term x, Finset.sum_const, Finset.card_univ,
          ← Nat.card_eq_fintype_card, Subgroup.card_top, nsmul_eq_mul, mul_one]
      rw [h_sum]
      have h_pos : 0 < Nat.card (⊤ : Subgroup G) := Nat.card_pos
      have h_ne : (Nat.card (⊤ : Subgroup G) : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_pos.ne'
      exact inv_mul_cancel₀ h_ne
    obtain ⟨t_H, ht_H_wf, ht_H_lt, ht_H_tr⟩ :=
      h_s6 L K hLK π hπ hsurj 1 H hH_lt 1
    have h_lift_orb : ∀ (L₀ : List (Σ (M : Subgroup G), (M →* (Ω F)ˣ))),
        (∀ p ∈ L₀, p.1 < ⊤) →
        ∃ D_orb : List (MonomialTerm F L),
          (∀ s ∈ D_orb, s.Wf F L) ∧
          (∀ s ∈ D_orb, ∃ hsK : s.field ≤ K,
            Module.finrank s.field (IntermediateField.extendScalars hsK) <
              Module.finrank L K') ∧
          ∀ w : relWeil F L,
            monomialListTrace F L D_orb w =
              - (L₀.map fun p => indCharTrace F p.1 p.2 (π w)).sum := by
      intro L₀ hL₀
      induction L₀ with
      | nil =>
        refine ⟨[], by simp, by simp, fun w => by simp [monomialListTrace]⟩
      | cons p tl ih_orb =>
        have hp_lt : p.1 < ⊤ := hL₀ p (by simp)
        have htl_lt : ∀ p' ∈ tl, p'.1 < ⊤ := fun p' hp' => hL₀ p' (by simp [hp'])
        obtain ⟨D_tl, hD_tl_wf, hD_tl_lt, hD_tl_tr⟩ := ih_orb htl_lt
        obtain ⟨t_p, ht_p_wf, ht_p_lt, ht_p_tr⟩ :=
          h_s6 L K hLK π hπ hsurj (-1) p.1 hp_lt p.2
        refine ⟨t_p :: D_tl, ?_, ?_, ?_⟩
        · intro s hs
          rcases List.mem_cons.mp hs with rfl | hs
          · exact ht_p_wf
          · exact hD_tl_wf s hs
        · intro s hs
          rcases List.mem_cons.mp hs with rfl | hs
          · exact ht_p_lt
          · exact hD_tl_lt s hs
        · intro w
          simp only [monomialListTrace, List.map_cons, List.sum_cons] at hD_tl_tr ⊢
          rw [ht_p_tr w, hD_tl_tr w, neg_one_smul]
          ring
    have hL_orb_lt : ∀ p ∈ L_orb, p.1 < ⊤ := by
      intro p hp
      obtain ⟨hC_le, hc_ne, _, _, h_stab⟩ := h_orb_props p hp
      exact h_stab_lt p.1 hC_le p.2 hc_ne h_stab
    obtain ⟨D_orb, hD_orb_wf, hD_orb_lt, hD_orb_tr⟩ := h_lift_orb L_orb hL_orb_lt
    refine ⟨t_H :: D_orb, ⟨?_, ?_⟩, ?_⟩
    · intro s hs
      rcases List.mem_cons.mp hs with rfl | hs
      · exact ht_H_wf
      · exact hD_orb_wf s hs
    · intro w
      change 1 = t_H.trace F L w + monomialListTrace F L D_orb w
      rw [ht_H_tr w, hD_orb_tr w, one_smul, h_tr_orb (π w), h_ind_top (π w)]
      ring
    · intro s hs
      rcases List.mem_cons.mp hs with rfl | hs
      · exact ht_H_lt
      · exact hD_orb_lt s hs
  · 
    have hlt_m : Module.finrank L M_C' < m := hm ▸ hlt_MC
    obtain ⟨D_triv, hD_triv, hD_lt_MC⟩ :=
      ih (Module.finrank L M_C') hlt_m L M_C hLM_C hGalM_C rfl hNilp_MC
    refine ⟨D_triv, hD_triv, fun s hs => ?_⟩
    obtain ⟨hsMC, hs_lt⟩ := hD_lt_MC s hs
    have hsWf : s.Wf F L := hD_triv.1 s hs
    haveI : FiniteDimensional F s.field := hsWf.1
    haveI : FiniteDimensional F M_C := hGalM_C.2.1
    have hsK : s.field ≤ K := hsMC.trans hM_CK
    refine ⟨hsK, ?_⟩
    haveI : IsScalarTower F s.field (IntermediateField.extendScalars hsMC) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower F L M_C' :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower F s.field (IntermediateField.extendScalars hsK) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hmul_sMC : Module.finrank F s.field *
        Module.finrank s.field (IntermediateField.extendScalars hsMC) =
        Module.finrank F M_C :=
      Module.finrank_mul_finrank F s.field (IntermediateField.extendScalars hsMC)
    have hmul_LMC : Module.finrank F L * Module.finrank L M_C' = Module.finrank F M_C :=
      Module.finrank_mul_finrank F L M_C'
    have hmul_sK : Module.finrank F s.field *
        Module.finrank s.field (IntermediateField.extendScalars hsK) =
        Module.finrank F K :=
      Module.finrank_mul_finrank F s.field (IntermediateField.extendScalars hsK)
    have hmul_LK : Module.finrank F L * Module.finrank L K' = Module.finrank F K :=
      Module.finrank_mul_finrank F L K'
    haveI : FiniteDimensional F (IntermediateField.extendScalars hsMC) :=
      inferInstanceAs (FiniteDimensional F M_C)
    haveI : FiniteDimensional s.field (IntermediateField.extendScalars hsMC) :=
      Module.Finite.of_restrictScalars_finite F s.field (IntermediateField.extendScalars hsMC)
    haveI : FiniteDimensional F (IntermediateField.extendScalars hsK) :=
      inferInstanceAs (FiniteDimensional F K)
    haveI : FiniteDimensional s.field (IntermediateField.extendScalars hsK) :=
      Module.Finite.of_restrictScalars_finite F s.field (IntermediateField.extendScalars hsK)
    have hpos_sMC : 0 < Module.finrank s.field (IntermediateField.extendScalars hsMC) :=
      Module.finrank_pos
    have hpos_sK : 0 < Module.finrank s.field (IntermediateField.extendScalars hsK) :=
      Module.finrank_pos
    have hpos_FL : 0 < Module.finrank F L := Module.finrank_pos
    nlinarith

theorem ld_mackey_double_coset_reps_exist (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L A B : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B]
    (hLA : L ≤ A) (hLB : L ≤ B) :
    ∃ (m : ℕ) (w : Fin m → relWeil F L),
      (∀ (i j : Fin m) (a : relWeil F A) (b : relWeil F B),
        Subgroup.inclusion (relWeil_antitone F hLA) a * w i *
          Subgroup.inclusion (relWeil_antitone F hLB) b = w j → i = j) ∧
      (∀ g : relWeil F L, ∃ (i : Fin m) (a : relWeil F A) (b : relWeil F B),
        Subgroup.inclusion (relWeil_antitone F hLA) a * w i *
          Subgroup.inclusion (relWeil_antitone F hLB) b = g) ∧
      (∀ (i j : Fin m) (b : relWeil F B) (a : relWeil F A),
        Subgroup.inclusion (relWeil_antitone F hLB) b * (w i)⁻¹ *
          Subgroup.inclusion (relWeil_antitone F hLA) a = (w j)⁻¹ → i = j) ∧
      (∀ g : relWeil F L, ∃ (i : Fin m) (b : relWeil F B) (a : relWeil F A),
        Subgroup.inclusion (relWeil_antitone F hLB) b * (w i)⁻¹ *
          Subgroup.inclusion (relWeil_antitone F hLA) a = g) :=
by
  let G_L := relWeil F L
  let H_A := (relWeil F A).subgroupOf G_L
  let H_B := (relWeil F B).subgroupOf G_L
  let ι_A := Subgroup.inclusion (relWeil_antitone F hLA)
  let ι_B := Subgroup.inclusion (relWeil_antitone F hLB)
  let X := G_L ⧸ H_B
  have hFinX : Finite X := by
    let E_B := IntermediateField.extendScalars hLB
    let e_F : B ≃ₐ[F] E_B :=
      { toFun := toExtendScalars F hLB
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLB).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F E_B := Module.Finite.equiv e_F.toLinearEquiv
    haveI : IsScalarTower F L E_B := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L E_B := Module.Finite.of_restrictScalars_finite F L E_B
    letI : Fintype (E_B →ₐ[L] AlgebraicClosure F) :=
      minpoly.AlgHom.fintype L E_B (AlgebraicClosure F)
    let res : X → (E_B →ₐ[L] AlgebraicClosure F) := fun u =>
      { toFun := fun x => ((cosetRep u : G_L) : AbsGal F) x.1
        map_one' := map_one ((cosetRep u : G_L) : AbsGal F)
        map_mul' := fun x y => map_mul ((cosetRep u : G_L) : AbsGal F) x.1 y.1
        map_zero' := map_zero ((cosetRep u : G_L) : AbsGal F)
        map_add' := fun x y => map_add ((cosetRep u : G_L) : AbsGal F) x.1 y.1
        commutes' := fun r => (cosetRep u).2.2 r }
    have hinj : Function.Injective res := by
      intro u₁ u₂ h_eq
      let g₁ : G_L := cosetRep u₁
      let g₂ : G_L := cosetRep u₂
      have h_mem : g₁⁻¹ * g₂ ∈ H_B := by
        rw [Subgroup.mem_subgroupOf]
        refine ⟨(g₁⁻¹ * g₂).2.1, ?_⟩
        intro y
        let y_E : E_B := ⟨y.1, (IntermediateField.mem_extendScalars hLB).mpr y.2⟩
        have hy : (g₁ : AbsGal F) y.1 = (g₂ : AbsGal F) y.1 := AlgHom.congr_fun h_eq y_E
        change ((g₁ : AbsGal F)⁻¹ * (g₂ : AbsGal F)) y.1 = y.1
        rw [AlgEquiv.mul_apply, ← hy, ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
      have hq : (g₁ : X) = (g₂ : X) := QuotientGroup.eq.mpr h_mem
      have h1 : (g₁ : X) = u₁ := Quotient.out_eq u₁
      have h2 : (g₂ : X) = u₂ := Quotient.out_eq u₂
      rw [← h1, ← h2, hq]
    exact Finite.of_injective res hinj
  let S : Setoid X := MulAction.orbitRel ↥H_A X
  let Q := Quotient S
  haveI : Finite Q := @Quotient.finite X hFinX S
  letI : Fintype Q := Fintype.ofFinite Q
  let m : ℕ := Fintype.card Q
  let e_Q : Fin m ≃ Q := (Fintype.equivFin Q).symm
  let u_rep : Fin m → X := fun i => @Quotient.out X S (e_Q i)
  let w : Fin m → relWeil F L := fun i => cosetRep (u_rep i)
  have hw_coset : ∀ i : Fin m, ((w i : G_L) : X) = u_rep i :=
    fun i => Quotient.out_eq (u_rep i)
  have hw_quot : ∀ i : Fin m, @Quotient.mk X S ((w i : G_L) : X) = e_Q i := by
    intro i
    rw [hw_coset i]
    exact @Quotient.out_eq X S (e_Q i)
  have hDisj_AB : ∀ (i j : Fin m) (a : relWeil F A) (b : relWeil F B),
      ι_A a * w i * ι_B b = w j → i = j := by
    intro i j a b h_eq
    let a' : ↥H_A := ⟨ι_A a, a.2⟩
    have h_mem : (ι_A a * w i)⁻¹ * w j ∈ H_B := by
      have h_b : (ι_A a * w i)⁻¹ * w j = ι_B b := by
        rw [← h_eq, inv_mul_cancel_left]
      rw [h_b]
      exact b.2
    have h_coset : (((ι_A a * w i : G_L) : X)) = ((w j : G_L) : X) :=
      QuotientGroup.eq.mpr h_mem
    have h_orb : @Setoid.r X S ((w j : G_L) : X) ((w i : G_L) : X) :=
      ⟨a', h_coset⟩
    have h_q : @Quotient.mk X S ((w j : G_L) : X) = @Quotient.mk X S ((w i : G_L) : X) :=
      @Quotient.sound X S _ _ h_orb
    rw [hw_quot j, hw_quot i] at h_q
    exact e_Q.injective h_q.symm
  have hExh_AB : ∀ g : relWeil F L, ∃ (i : Fin m) (a : relWeil F A) (b : relWeil F B),
      ι_A a * w i * ι_B b = g := by
    intro g
    let x : X := (g : X)
    let i : Fin m := e_Q.symm (@Quotient.mk X S x)
    have h_q : @Quotient.mk X S x = @Quotient.mk X S ((w i : G_L) : X) := by
      rw [hw_quot i]
      exact (e_Q.apply_symm_apply (@Quotient.mk X S x)).symm
    have h_orb : @Setoid.r X S x ((w i : G_L) : X) := @Quotient.exact X S _ _ h_q
    rcases h_orb with ⟨a', ha'⟩
    have h_coset : (((a' : G_L) * w i : G_L) : X) = (g : X) := ha'
    have h_mem : ((a' : G_L) * w i)⁻¹ * g ∈ H_B := QuotientGroup.eq.mp h_coset
    let a : relWeil F A := ⟨(a' : G_L).1, a'.2⟩
    let b : relWeil F B := ⟨(((a' : G_L) * w i)⁻¹ * g).1, h_mem⟩
    refine ⟨i, a, b, ?_⟩
    have ha_eq : ι_A a = (a' : G_L) := rfl
    have hb_eq : ι_B b = ((a' : G_L) * w i)⁻¹ * g := rfl
    rw [ha_eq, hb_eq, mul_inv_cancel_left]
  have hDisj_BA : ∀ (i j : Fin m) (b : relWeil F B) (a : relWeil F A),
      ι_B b * (w i)⁻¹ * ι_A a = (w j)⁻¹ → i = j := by
    intro i j b a h_eq
    apply hDisj_AB i j a⁻¹ b⁻¹
    have h_inv := congr_arg Inv.inv h_eq
    rw [inv_inv] at h_inv
    rw [← h_inv, map_inv, map_inv]
    group
  have hExh_BA : ∀ g : relWeil F L, ∃ (i : Fin m) (b : relWeil F B) (a : relWeil F A),
      ι_B b * (w i)⁻¹ * ι_A a = g := by
    intro g
    obtain ⟨i, a, b, h_eq⟩ := hExh_AB g⁻¹
    refine ⟨i, b⁻¹, a⁻¹, ?_⟩
    have h_inv := congr_arg Inv.inv h_eq
    rw [inv_inv] at h_inv
    rw [← h_inv, map_inv, map_inv]
    group
  exact ⟨m, w, hDisj_AB, hExh_AB, hDisj_BA, hExh_BA⟩

theorem ld_mackey_one_sided_double_coset_trace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K A B : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hGal : IsGaloisExt F L K)
    (hLA : L ≤ A) (hAK : A ≤ K) (hLB : L ≤ B) (hBK : B ≤ K)
    (χA : relWeil F A →* (Ω F)ˣ) (χB : relWeil F B →* (Ω F)ˣ)
    (htA : (⟨1, A, hLA, χA⟩ : MonomialTerm F L).Wf F L)
    (htB : (⟨1, B, hLB, χB⟩ : MonomialTerm F L).Wf F L)
    (m : ℕ) (w : Fin m → relWeil F L)
    (hDisj : ∀ (i j : Fin m) (a : relWeil F A) (b : relWeil F B),
      Subgroup.inclusion (relWeil_antitone F hLA) a * w i *
        Subgroup.inclusion (relWeil_antitone F hLB) b = w j → i = j)
    (hExh : ∀ g : relWeil F L, ∃ (i : Fin m) (a : relWeil F A) (b : relWeil F B),
      Subgroup.inclusion (relWeil_antitone F hLA) a * w i *
        Subgroup.inclusion (relWeil_antitone F hLB) b = g) :
    (⟨-1, A, le_rfl, χA⟩ : MonomialTerm F A).Wf F A ∧
    (∀ u : relWeil F A,
      (⟨-1, A, le_rfl, χA⟩ : MonomialTerm F A).trace F A u = - (χA u : Ω F)) ∧
    (∀ i : Fin m,
      (mackeyTerm F A B χA χB (w i)).Wf F A ∧
      mackeyField F A B (w i) ≤ K ∧
      L ≤ mackeyField F A B (w i)) ∧
    (∀ u : relWeil F A,
      (χA u : Ω F) *
        (⟨1, B, hLB, χB⟩ : MonomialTerm F L).trace F L
          (Subgroup.inclusion (relWeil_antitone F hLA) u) =
      monomialListTrace F A
        (List.ofFn (fun i : Fin m => mackeyTerm F A B χA χB (w i))) u) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F A := htA.1
  haveI : FiniteDimensional F B := htB.1
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  
  have hWf_self : (⟨-1, A, le_rfl, χA⟩ : MonomialTerm F A).Wf F A := by
    refine ⟨htA.1, ⟨fun x => ?_⟩, htA.2.2⟩
    let xA : A := ⟨x.1, (IntermediateField.mem_extendScalars (le_rfl : A ≤ A)).mp x.2⟩
    have hx : algebraMap A (IntermediateField.extendScalars (le_rfl : A ≤ A)) xA = x := rfl
    rw [← hx]
    exact isSeparable_algebraMap xA
  have hTr_self : ∀ u : relWeil F A,
      (⟨-1, A, le_rfl, χA⟩ : MonomialTerm F A).trace F A u = - (χA u : Ω F) := by
    intro u
    simp only [MonomialTerm.trace, neg_one_smul]
    congr 1
    let G_A := relWeil F A
    let H_AA := G_A.subgroupOf G_A
    let σ_A := charRep F A χA
    let e_sub := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F (le_rfl : A ≤ A))
    let ρ_A := σ_A.comp e_sub.toMonoidHom
    let e : indSpace H_AA ρ_A ≃ₗ[Ω F] Ω F :=
      { toFun := fun f => (f.1 1).down
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        invFun := fun c => ⟨fun g => σ_A g (ULift.up c), fun h g => by
          change σ_A ((h : G_A) * g) (ULift.up c) = σ_A (e_sub h) (σ_A g (ULift.up c))
          have he : e_sub h = (h : G_A) := rfl
          rw [he, map_mul, Module.End.mul_apply]⟩
        left_inv := fun f => Subtype.ext (funext fun g => by
          have hf := f.2 ⟨g, Subgroup.mem_subgroupOf.mpr g.2⟩ 1
          have he : e_sub ⟨g, Subgroup.mem_subgroupOf.mpr g.2⟩ = g := rfl
          change (σ_A g (f.1 1) : ULift.{u} (Ω F)) = f.1 g
          rw [← he]
          simpa [mul_one] using hf.symm)
        right_inv := fun c => by
          change (σ_A 1 (ULift.up c)).down = c
          rw [map_one]
          rfl }
    have hconj : e.conj (indLM F (le_rfl : A ≤ A) σ_A u) = (χA u : Ω F) • LinearMap.id := by
      apply LinearMap.ext
      intro c
      change (σ_A (1 * u) (ULift.up c)).down = (χA u : Ω F) * c
      rw [one_mul]
      rfl
    have htr := (LinearMap.trace_conj' (indLM F (le_rfl : A ≤ A) σ_A u) e).symm
    rw [hconj, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one,
      smul_eq_mul, mul_one] at htr
    exact htr
  
  have hSep_iff : ∀ (L₀ E₁ : IntermediateField F (AlgebraicClosure F)) (h₀ : L₀ ≤ E₁),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars h₀) ↔
        E₁ ≤ IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) := by
    intro L₀ E₁ h₀
    let S := IntermediateField.extendScalars h₀
    have hmin : ∀ x : S, IsSeparable L₀ x.1 ↔ IsSeparable L₀ x := by
      intro x
      change (minpoly L₀ (S.val x)).Separable ↔ (minpoly L₀ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h₀).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₀ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₁ := (IntermediateField.mem_extendScalars h₀).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
