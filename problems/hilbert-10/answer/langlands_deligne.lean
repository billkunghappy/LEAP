    have hmk0_z₁ : Units.mk0 (1 + z₁) hz₁_ne = v₁ := Units.ext h1z₁_eq
    have hz₁_stat_cond :
        z₁ = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z₁ := by
      rw [hm1_half]
      exact hvalM₁'_mono (2 * (b₁_ceil : ℤ)) (b₁ : ℤ) z₁ hz₁_or (by omega)
    have hstat_z₁ := hc_θ₁_stat z₁ hz₁_stat_cond hz₁_ne
    rw [hmk0_z₁, hComm_eq] at hstat_z₁
    have hsub_one := hψM₁'_sub_eq_one
      (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z₁) (ι ((α'⁻¹ : Lˣ) : L) * a₁ * z₁) hstat_z₁.symm
    have hα_mul_inv : ι ((α'⁻¹ : Lˣ) : L) * ι (α' : L) = 1 := by
      rw [← map_mul, Units.inv_mul, map_one]
    have hc_θ₁_sub :
        ((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z₁ - ι ((α'⁻¹ : Lˣ) : L) * a₁ * z₁ =
          ι ((α'⁻¹ : Lˣ) : L) * ((ι A + Q₁) * z₁) + ι ((α'⁻¹ : Lˣ) : L) * (Δ * z₁) := by
      linear_combination
        -(((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z₁) * hα_mul_inv +
        (ι ((α'⁻¹ : Lˣ) : L) * z₁) * hΔ_eq
    rw [hc_θ₁_sub, AddChar.map_add_eq_mul, hψ_AQ₁, one_mul, htraceChar_incl_mul] at hsub_one
    set r₀ : L := s₀' + (1 + 2 * f) * s₀' ^ 2
    set r₁ : L := 2 * s₀' + s₀' ^ 2
    have hNu₁_eq : ι Nu₁ = (1 - ι s₀' * x) * (1 + ι s₀' + ι s₀' * x) := by
      dsimp [Nu₁]
      simp only [map_add, map_sub, map_mul, map_pow, map_one]
      linear_combination (ι s₀') ^ 2 * hx_sq
    have hNu₁_z₁ : ι Nu₁ * z₁ = ι r₀ + ι r₁ * x := by
      change ι Nu₁ * (τ₁ (u₁ : M₁') * ((u₁⁻¹ : M₁'ˣ) : M₁') - 1) = _
      rw [hτ₁_u₁, hNu₁_eq]
