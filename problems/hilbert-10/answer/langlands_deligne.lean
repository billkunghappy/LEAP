  have hu_K_inv_norm : normLM F hLK ((u_K⁻¹ : Kˣ) : K) = ((δ⁻¹ : Lˣ) : L) := by
    have h1 : Units.map (normLM F hLK) (u_K⁻¹) = δ⁻¹ := by
      rw [map_inv, hu_K_norm]
    exact congrArg Units.val h1
  have hAtp_eq : A_χ * t_p = A_ν * normLM F hLK z := by
    have hδ_inv : (δ : L) * ((δ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv δ
    have hnorm_z : normLM F hLK z = ((δ⁻¹ : Lˣ) : L) * t_p := by
      change normLM F hLK (((u_K⁻¹ : Kˣ) : K) * y_r) = ((δ⁻¹ : Lˣ) : L) * normLM F hLK y_r
      rw [map_mul, hu_K_inv_norm]
    rw [hnorm_z, hA_ν_eq]
    calc A_χ * t_p
      _ = A_χ * ((δ : L) * ((δ⁻¹ : Lˣ) : L)) * t_p := by rw [hδ_inv, mul_one]
      _ = A_χ * (δ : L) * (((δ⁻¹ : Lˣ) : L) * t_p) := by ring
  have hψ_tp : ψ (A_χ * t_p) = ψ (- A_ν * traceLM F hLK z) := by
    rw [hAtp_eq, hnorm_to_tr z hz_dom]
  have hc_K_inv_coe : ((c_K⁻¹ : Kˣ) : K) = ι A_χ * (u_corr : K) := by
    have h : c_K⁻¹ = (Units.map ι c_χ'⁻¹) * u_corr := by
      rw [hc_K_eq, mul_inv_rev, inv_inv, ← map_inv, mul_comm]
    exact congrArg Units.val h
  have hcK_yr_eq :
      ((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * ι r = ι A_χ * y_r + ι (- A_ν) * z := by
    have hmul : ((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * ι r = ((c_K⁻¹ : Kˣ) : K) * y_r := by
      dsimp [y_r]; ring
    rw [hmul, hc_K_inv_coe, hu_corr_eq, map_neg, hA_ν_eq, map_mul]
    dsimp [z]
    ring
  have htrChar_yr :
      (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * ι r) =
        ψ (A_χ * t_1) * ψ (A_χ * t_p) := by
    change ψ (traceLM F hLK (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * ι r)) = _
    rw [hcK_yr_eq, map_add, htrace_smul A_χ y_r, htrace_smul (- A_ν) z,
      AddChar.map_add_eq_mul, ← hψ_tp]
  have hψ_ne_zero : ∀ x : L, ψ x ≠ 0 := by
    intro x
    have h1 : ψ x * ψ (-x) = 1 := by
      rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
    exact left_ne_zero_of_mul_eq_one h1
  have hLHS_eq :
      (if hr_K' : 1 + (δ_K : K) * ι r ≠ 0 then
        (χ'_K (Units.mk0 (1 + (δ_K : K) * ι r) hr_K') : Ω F)⁻¹ *
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * ι r)
      else 0) = ψ (- (A_χ * t_2)) := by
    rw [dif_pos hr_K, hχ'_wnorm, htrChar_yr]
    have h1_ne : ψ (A_χ * t_1) ≠ 0 := hψ_ne_zero _
    have hp_ne : ψ (A_χ * t_p) ≠ 0 := hψ_ne_zero _
    calc (ψ (A_χ * t_1) * ψ (A_χ * t_2) * ψ (A_χ * t_p))⁻¹ *
          (ψ (A_χ * t_1) * ψ (A_χ * t_p))
      _ = (ψ (A_χ * t_1) * (ψ (A_χ * t_1))⁻¹) *
            (ψ (A_χ * t_p) * (ψ (A_χ * t_p))⁻¹) *
            (ψ (A_χ * t_2))⁻¹ := by
        rw [mul_inv, mul_inv]; ring
      _ = (ψ (A_χ * t_2))⁻¹ := by
        rw [mul_inv_cancel₀ h1_ne, mul_inv_cancel₀ hp_ne, one_mul, one_mul]
      _ = ψ (- (A_χ * t_2)) := (AddChar.map_neg_eq_inv ψ (A_χ * t_2)).symm
  have hyr2_tr : traceLM F hLK (y_r ^ 2) = r ^ 2 * traceLM F hLK ((δ_K : K) ^ 2) := by
    have hyr2_eq : y_r ^ 2 = ι (r ^ 2) * (δ_K : K) ^ 2 := by
      dsimp [y_r]
      rw [map_pow]; ring
    rw [hyr2_eq, htrace_smul (r ^ 2) ((δ_K : K) ^ 2)]
  set δ_a_sq : L := ((ϖ_L ^ d_a : Lˣ) : L) ^ 2
  have hδa_sq_eq : δ_a_sq = (ϖ_L : L) ^ (2 * d_a) := by
    dsimp [δ_a_sq]
    rw [← pow_mul, mul_comm]
  set Δ_tr : L := traceLM F hLK ((δ_K : K) ^ 2) - (-1 : L) ^ k * ((ϖ_L : L) ^ (2 * d_a))
  have hΔtr_val : P_L (a : ℤ) Δ_tr := by
    have ha_Z : (2 * (a / 2) + 1 : ℤ) = (a : ℤ) := by exact_mod_cast ha_eq.symm
    change P_L (a : ℤ) Δ_tr
    rcases hδK_tr2 with h0 | hge
    · exact Or.inl h0
    · right; rwa [ha_Z] at hge
  set E_2 : L := (2 : L) * t_2 + (-1 : L) ^ k * δ_a_sq * r ^ 2
  have hE2_eq : E_2 = t_1 ^ 2 - r ^ 2 * Δ_tr := by
    have h2t2 := hs2 y_r
    rw [hyr2_tr] at h2t2
    dsimp [E_2, Δ_tr, t_1, t_2]
    rw [hδa_sq_eq]
    linear_combination h2t2
  have ht1_sq_val : P_L (a : ℤ) (t_1 ^ 2) := by
    rw [sq]
    exact hPL_mono h2r0a_ge_a (hPL_mul ht1_val ht1_val)
  have hr_sq_int : P_L 0 (r ^ 2) := by
    rw [sq]
    have h := hPL_mul hr_int hr_int
    rwa [add_zero] at h
  have hr2_Δtr_val : P_L (a : ℤ) (r ^ 2 * Δ_tr) := by
    have h := hPL_mul hr_sq_int hΔtr_val
    rwa [zero_add] at h
  have hE2_val : P_L (a : ℤ) E_2 := by
    rw [hE2_eq]
    exact hPL_sub ht1_sq_val hr2_Δtr_val
  have hAχ_PL : P_L (-((a : ℤ) + n)) (- A_χ) := by
    apply hPL_neg
    right
    dsimp [A_χ, a, n]
    rw [hval_inv_L c_χ', hc_χ'_val]
  rw [hLHS_eq]
  apply hψ_congr
  have hdiff_eq :
      (- (A_χ * t_2)) - A_χ * δ_a_sq * ((-1 : L) ^ k * (2 : L)⁻¹ * r ^ 2) =
        (- A_χ) * (2 : L)⁻¹ * E_2 := by
    have h2_inv_mul : (2 : L)⁻¹ * (2 : L) = 1 := inv_mul_cancel₀ h2_ne
    dsimp [E_2]
    calc (- (A_χ * t_2)) - A_χ * δ_a_sq * ((-1 : L) ^ k * (2 : L)⁻¹ * r ^ 2)
      _ = (- A_χ) * (((2 : L)⁻¹ * (2 : L)) * t_2) -
            A_χ * δ_a_sq * ((-1 : L) ^ k * (2 : L)⁻¹ * r ^ 2) := by
        rw [h2_inv_mul, one_mul]; ring
      _ = (- A_χ) * (2 : L)⁻¹ * ((2 : L) * t_2 + (-1 : L) ^ k * δ_a_sq * r ^ 2) := by ring
  rw [hdiff_eq]
  have hprod := hPL_mul (hPL_mul hAχ_PL h2_inv_int) hE2_val
  exact hPL_mono (by omega) hprod

theorem ld_wild_mid_cond_odd_prime_L_polar_and_hasse_pow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (ψ : AddChar L (Ω F))
    (χ' : Lˣ →* (Ω F)ˣ)
    (ha_ge2 : 2 ≤ condExp F L χ')
    (ha_odd : condExp F L χ' % 2 = 1)
    (hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m, u ^ p ∈ unitGroup F L (m + 1))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hp_val1 : (p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L))
    (R_L : Finset L) (c_χ' : Lˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hFF_odd : ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
      ∀ (p : ℕ), Nat.Prime p → p ≠ 2 → (p : k_L) = 0 →
      ∀ (c : k_L), c ≠ 0 →
      ∀ (Q : k_L → Ω F),
        Q 0 = 1 →
        (∀ x y : k_L, Q (x + y) = Q x * Q y * ψ₀ (c * x * y)) →
        (∀ x : k_L, (Q x) ^ p = 1) →
        (∑ x : k_L, Q x) ^ p =
          (Fintype.card k_L : Ω F) ^ ((p - 1) / 2) *
            (∑ x : k_L, ψ₀ ((-1 : k_L) ^ ((p - 1) / 2) * (2 : k_L)⁻¹ * c * x ^ 2))) :
    (∑ r ∈ R_L,
      if hr_L : 1 + ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * r ≠ 0 then
        (χ' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * r) hr_L) : Ω F)⁻¹ *
          ψ (((c_χ'⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * r)
      else 0) ^ p =
    (Fintype.card k_L : Ω F) ^ ((p - 1) / 2) *
      ∑ r ∈ R_L,
        ψ (((c_χ'⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) ^ 2 *
          ((-1 : L) ^ ((p - 1) / 2) * (2 : L)⁻¹ * r ^ 2)) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalL_props
  set a : ℕ := condExp F L χ'
  set d_a : ℕ := a / 2
  set r₀ : ℕ := (a + 1) / 2
  set k : ℕ := (p - 1) / 2
  set n : ℤ := condExpChar F L ψ
  set A : L := ((c_χ'⁻¹ : Lˣ) : L)
  have hp_ge3 : 3 ≤ p := by
    have := hPrime.two_le
    omega
  have hp_odd_mod : p % 2 = 1 := hPrime.eq_two_or_odd.resolve_left hp_odd
  have hp_eq_2k1 : p = 2 * k + 1 := by omega
  have ha_ne0 : a ≠ 0 := by omega
  have ha_ge1 : 1 ≤ a := by omega
  have hd_ge1 : 1 ≤ d_a := by omega
  have ha_eq_2d1 : a = 2 * d_a + 1 := by omega
  have hr0_eq : r₀ = d_a + 1 := by omega
  have hψ_triv : ∀ x : L, (x = 0 ∨ -n ≤ valL F L x) → ψ x = 1 := (hSpecL 1).1
  have hψ_nontriv : ∃ x₁ : L, x₁ ≠ 0 ∧ -(n + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1 := (hSpecL 1).2.1
  have hχ'_triv : ∀ u ∈ unitGroup F L a, χ' u = 1 := ((hSpecL χ').2.2.1 ha_ne0).1
  let P : ℤ → L → Prop := fun m x => x = 0 ∨ m ≤ valL F L x
  have hP_zero : ∀ m : ℤ, P m 0 := fun _ => Or.inl rfl
  have hP_one : P 0 1 := Or.inr (by rw [hval1])
  have hP_mono : ∀ {m₁ m₂ : ℤ}, m₁ ≤ m₂ → ∀ {x : L}, P m₂ x → P m₁ x := by
    intro m₁ m₂ hm x hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hP_neg : ∀ {m : ℤ} {x : L}, P m x → P m (-x) := by
    intro m x hx
    rcases hx with rfl | hx
    · simp [P]
    · right; rw [hval_neg]; exact hx
  have hP_add : ∀ {m : ℤ} {x y : L}, P m x → P m y → P m (x + y) :=
    fun hx hy => hval_add _ _ _ hx hy
  have hP_sub : ∀ {m : ℤ} {x y : L}, P m x → P m y → P m (x - y) := by
    intro m x y hx hy
    rw [sub_eq_add_neg]
    exact hP_add hx (hP_neg hy)
  have hP_mul : ∀ {m₁ m₂ : ℤ} {x y : L}, P m₁ x → P m₂ y → P (m₁ + m₂) (x * y) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hP_sq : ∀ {m : ℤ} {x : L}, P m x → P (m + m) (x ^ 2) := by
    intro m x hx
    rw [sq]
    exact hP_mul hx hx
  have hP_pow : ∀ {m : ℤ} {x : L} (j : ℕ), P m x → P ((j : ℤ) * m) (x ^ j) := by
    intro m x j hx
    induction j with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul]
      exact hP_one
    | succ j ih =>
      rw [pow_succ]
      have hmul := hP_mul ih hx
      have heq : ((j + 1 : ℕ) : ℤ) * m = (j : ℤ) * m + m := by push_cast; ring
      rw [heq]
      exact hmul
  have hP_finset_sum : ∀ (T : Finset ℕ) (f : ℕ → L) (m : ℤ),
      (∀ j ∈ T, P m (f j)) → P m (∑ j ∈ T, f j) := by
    intro T f m hT
    induction T using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty]
      exact hP_zero m
    | @insert j s hj ih =>
      rw [Finset.sum_insert hj]
      exact hP_add (hT j (Finset.mem_insert_self j s))
        (ih (fun i hi => hT i (Finset.mem_insert_of_mem hi)))
  have hP_of_val : ∀ {m : ℤ} {x : L}, valL F L x = m → P m x := by
    intro m x h
    exact Or.inr (by omega)
  have hA_val : valL F L A = -((a : ℤ) + n) := by
    dsimp only [A]
    rw [hval_inv c_χ', hc_χ'_val]
  have hP_A : P (-((a : ℤ) + n)) A := hP_of_val hA_val
  have h1_add_ne : ∀ {y : L}, P 1 y → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : y = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hy_eq] at hy
    rcases hy with h_neg1_0 | h_val
    · exact one_ne_zero (neg_eq_zero.mp h_neg1_0)
    · rw [hval_neg1] at h_val
      omega
  have h1_add_val : ∀ {y : L} (hy : P 1 y), valL F L (1 + y) = 0 := by
    intro y hy
    set u := Units.mk0 (1 + y) (h1_add_ne hy)
    have hu_mem : u ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u]
      change (1 + y : L) = 1 ∨ (1 : ℤ) ≤ valL F L ((1 + y : L) - 1)
      rw [add_sub_cancel_left]
      rcases hy with rfl | hy'
      · left; rw [add_zero]
      · right; exact hy'
    exact hunit_val0 1 u hu_mem
  have hψ_congr : ∀ {x y : L}, P (-n) (x - y) → ψ x = ψ y := by
    intro x y hxy
    have h_eq : x = (x - y) + y := by ring
    rw [h_eq, ψ.map_add_eq_mul, hψ_triv (x - y) hxy, one_mul]
  have hψ_nat_mul : ∀ (m : ℕ) (z : L), ψ ((m : L) * z) = (ψ z) ^ m := by
    intro m z
    induction m with
    | zero => simp [ψ.map_zero_eq_one]
    | succ m ih =>
      rw [Nat.cast_succ, add_mul, one_mul, ψ.map_add_eq_mul, ih, pow_succ]
  have hχ'_congr : ∀ {u v : Lˣ}, valL F L (u : L) = 0 → P (a : ℤ) ((v : L) - (u : L)) → χ' v = χ' u := by
    intro u v hu_val hvu
    set q : Lˣ := u⁻¹ * v
    have hq_sub : ((q : Lˣ) : L) - 1 = ((u⁻¹ : Lˣ) : L) * ((v : L) - (u : L)) := by
      have h_inv : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := by exact_mod_cast Units.inv_mul u
      dsimp only [q]
      rw [Units.val_mul, ← h_inv]
      ring
    have hu_inv_P : P 0 ((u⁻¹ : Lˣ) : L) := by
      apply hP_of_val
      rw [hval_inv u, hu_val, neg_zero]
    have hq_P : P (a : ℤ) (((q : Lˣ) : L) - 1) := by
      rw [hq_sub, ← zero_add (a : ℤ)]
      exact hP_mul hu_inv_P hvu
    have hq_mem : q ∈ unitGroup F L a := by
      rw [hunit_ge1 a ha_ge1 q]
      rcases hq_P with h0 | hge
      · left; exact sub_eq_zero.mp h0
      · right; exact hge
    have hv_eq : v = u * q := by simp [q]
    rw [hv_eq, map_mul, hχ'_triv q hq_mem, mul_one]
  have hϖ_pow_val : ∀ m : ℕ, valL F L (((ϖ_L ^ m : Lˣ) : L)) = (m : ℤ) := by
    intro m
    induction m with
    | zero => simp [hval1]
    | succ m ih =>
      rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_L]
      push_cast
      ring
  set δ_a : Lˣ := ϖ_L ^ d_a
  have hδa_val : valL F L (δ_a : L) = (d_a : ℤ) := hϖ_pow_val d_a
  have hP_δa : P (d_a : ℤ) (δ_a : L) := hP_of_val hδa_val
  have hnat_res : ∀ m : ℕ, P 0 (m : L) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      refine ⟨by simpa using hP_zero 0, ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ m ih =>
      have hm_int : P 0 ((m + 1 : ℕ) : L) := by
        rw [Nat.cast_succ]
        exact hP_add ih.1 hP_one
      refine ⟨hm_int, ?_⟩
