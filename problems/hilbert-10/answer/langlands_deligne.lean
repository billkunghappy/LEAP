                hLE hLM₁ hEK₁ hM₁K₁ hGalLK₁ hGalLE hGalLM₁ hGalEK₁ hGalM₁K₁
                hPrimeLE hdegLM₁ hdegEK₁ hdegM₁K₁ h_inf_M₁ h_sup_M₁
