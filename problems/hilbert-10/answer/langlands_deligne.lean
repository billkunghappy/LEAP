  have hP_num : P (2 * (r : ℤ)) ((B_comm - β₂ * (Q - V)) * Q + β₂ * (Q - V) ^ 2) :=
    hP_add (hP_mono (hP_mul hP_B_sub_QV hPQ) (by omega)) hP_β₂_QV_sq
  have hrat_diff :
      (-β₂ * (Q - V) * Q⁻¹) - (-B_comm * V⁻¹) =
        ((B_comm - β₂ * (Q - V)) * Q + β₂ * (Q - V) ^ 2) * V⁻¹ * Q⁻¹ := by
    linear_combination -B_comm * V⁻¹ * hQ_inv + β₂ * (Q - V) * Q⁻¹ * hV_inv
  have hP_rat : P (2 * (r : ℤ)) ((-β₂ * (Q - V) * Q⁻¹) - (-B_comm * V⁻¹)) := by
    rw [hrat_diff]
    exact hP_mono (hP_mul (hP_mul hP_num hPV_inv) hPQ_inv) (by omega)
  change (θM₁' v₁ : Ω F) = ψM₁' Z
  rw [hθ_v1_eq_ψ, hψM₁'_Z]
  exact hψ_eq2r _ _ hP_rat

theorem ld_ch12_wild_dyadic_even_breaks_higher_cond_lower_covectors_and_commutator (F : Type u) [Field F]
