    have ht_sq : t ^ 2 = 0 ∨ (r : ℤ) ≤ valL F L (t ^ 2) := hP_sq_iff.mp ht
    have hu_val : 2 * t + t ^ 2 = 0 ∨ (r : ℤ) ≤ valL F L (2 * t + t ^ 2) :=
      hP_add (r : ℤ) (hP_mul hP_2 ht1) ht_sq (by omega) (by omega)
    have h1pt : 1 + t ≠ 0 := h1_plus_ne ht1
    have hu_1 : 1 + (2 * t + t ^ 2) ≠ 0 := h1_plus_ne (hP_mono 1 hu_val (by omega))
    set w₀ : Lˣ := Units.mk0 (1 + t) h1pt
    have hw_sq : Units.mk0 (1 + (2 * t + t ^ 2)) hu_1 = w₀ * w₀ := by
      apply Units.ext
      change 1 + (2 * t + t ^ 2) = (1 + t) * (1 + t)
      ring
    have hν_1 : νE' (Units.mk0 (1 + (2 * t + t ^ 2)) hu_1) = 1 := by
      rw [hw_sq, map_mul, ← sq, ← MonoidHom.pow_apply, hνE'_pow2, MonoidHom.one_apply]
    have hstat := hcν₂_stat (2 * t + t ^ 2) hu_val hu_1
    rw [hν_1, Units.val_one, mul_assoc] at hstat
    exact hstat.symm
  have hnormE'_0 : normLM F hLE' 0 = 0 := by
    have hq := ((hQuadNorm L E' hLE' hdeg2).2 1 1).2
    have htr1 := (hQuadNorm L E' hLE' hdeg2).1 1
    rw [map_one] at htr1
    rw [map_one, sub_self, htr1, map_one] at hq
    linear_combination hq
  have hnormE'_incl : ∀ c : L, normLM F hLE' (ιE c) = c ^ 2 := by
    intro c
    have hq := ((hQuadNorm L E' hLE' hdeg2).2 c 0).1
    rw [add_zero, map_zero, hnormE'_0, mul_zero, add_zero, add_zero] at hq
    exact hq
  have hnormE'_add_lin : ∀ t₁ : L, normLM F hLE' (1 + ιE t₁ * y) = 1 - (t₁ + g * t₁ ^ 2) := by
    intro t₁
    by_cases ht₁ : t₁ = 0
    · subst ht₁; simp
    · have hfac : (1 : E') + ιE t₁ * y = ιE t₁ * (ιE t₁⁻¹ + y) := by
        have ht_inv : ιE t₁ * ιE t₁⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel₀ ht₁, map_one]
        calc (1 : E') + ιE t₁ * y = ιE t₁ * ιE t₁⁻¹ + ιE t₁ * y := by rw [ht_inv]
          _ = ιE t₁ * (ιE t₁⁻¹ + y) := by ring
      rw [hfac, map_mul, hnormE'_incl t₁, ((hQuadNorm L E' hLE' hdeg2).2 t₁⁻¹ y).1, hy_tr, hy_norm]
      have ht2 : t₁ ^ 2 * (t₁⁻¹) ^ 2 = 1 := by rw [← mul_pow, mul_inv_cancel₀ ht₁, one_pow]
      calc t₁ ^ 2 * ((t₁⁻¹) ^ 2 + t₁⁻¹ * (-1) + -g)
        _ = t₁ ^ 2 * (t₁⁻¹) ^ 2 - t₁ * (t₁ * t₁⁻¹) - g * t₁ ^ 2 := by ring
        _ = 1 - (t₁ + g * t₁ ^ 2) := by rw [ht2, mul_inv_cancel₀ ht₁]; ring
  have hnormE'_sub_lin : ∀ t : L, normLM F hLE' (1 - ιE t * y) = 1 + t - g * t ^ 2 := by
    intro t
    have h := hnormE'_add_lin (-t)
    rw [map_neg, neg_mul, ← sub_eq_add_neg] at h
    rw [h]; ring
  have hE'_odd : ∀ t₁ : L, (t₁ = 0 ∨ 3 * (r : ℤ) - 1 ≤ 2 * valL F L t₁) →
      ψ (((α⁻¹ : Lˣ) : L) * (β₂ * (t₁ + g * t₁ ^ 2))) = 1 := by
    intro t₁ ht₁
    have ht₁_r : t₁ = 0 ∨ (r : ℤ) ≤ valL F L t₁ := hP_half (r : ℤ) ht₁ (by omega)
    have ht₁_sq : t₁ ^ 2 = 0 ∨ (3 * (r : ℤ) - 1) ≤ valL F L (t₁ ^ 2) := hP_sq_iff.mp ht₁
    set A := t₁ + g * t₁ ^ 2
    have hA_val : -A = 0 ∨ (r : ℤ) ≤ valL F L (-A) :=
      hP_neg (hP_add (r : ℤ) ht₁_r (hP_mul hP_g ht₁_sq) (by omega) (by omega))
    have hu_1 : 1 + -A ≠ 0 := h1_plus_ne (hP_mono 1 hA_val (by omega))
    have hnorm_eq : normLM F hLE' (1 + ιE t₁ * y) = 1 + -A := by
      rw [hnormE'_add_lin t₁]; dsimp [A]; ring
    have hy_ne0 : (1 : E') + ιE t₁ * y ≠ 0 := fun h0 => hu_1 (by rw [← hnorm_eq, h0, hnormE'_0])
    have hν_1 : νE' (Units.mk0 (1 + -A) hu_1) = 1 := by
      apply (hνE'_ker (Units.mk0 (1 + -A) hu_1)).mp
      refine ⟨Units.mk0 (1 + ιE t₁ * y) hy_ne0, ?_⟩
      apply Units.ext
      exact hnorm_eq
    have hstat := hcν₂_stat (-A) hA_val hu_1
    rw [hν_1, Units.val_one] at hstat
    apply hψ_neg_eq1
    rw [show -(((α⁻¹ : Lˣ) : L) * (β₂ * A)) = ((α⁻¹ : Lˣ) : L) * β₂ * (-A) by ring]
    exact hstat.symm
  have hE'_scaled_sq : ∀ t₀ : L, (t₀ = 0 ∨ (r : ℤ) ≤ 2 * valL F L t₀) →
      ψ (((α⁻¹ : Lˣ) : L) * (β₂ * (1 - 4 * g) * t₀ ^ 2)) = 1 := by
    intro t₀ ht₀
    have ht₀_sq : t₀ ^ 2 = 0 ∨ (r : ℤ) ≤ valL F L (t₀ ^ 2) := hP_sq_iff.mp ht₀
    have h2t₀ : 2 * t₀ = 0 ∨ 3 * (r : ℤ) - 1 ≤ 2 * valL F L (2 * t₀) := by
      rw [hP_sq_iff, show (2 * t₀) ^ 2 = 4 * t₀ ^ 2 by ring]
      exact hP_mono (3 * (r : ℤ) - 1) (hP_mul hP_4 ht₀_sq) (by omega)
