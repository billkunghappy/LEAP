      dsimp [w₁]
      rw [hw₁_conj, map_mul τ₁, map_add τ₁, hτ₁_L A]
      linear_combination
        ι A * hz₁_tr_norm_zero +
        (ι A * z₁ * τ₁ z₁ - (Q₁ * z₁ + τ₁ Q₁ * τ₁ z₁) +
