    · exact Or.inl h0
    · right
      have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by
        have := hPrime.two_le
        omega
      have hq1 : (1 : ℤ) ≤ (q₀ : ℤ) := by exact_mod_cast hq₀_ge1
      have hle : (p : ℤ) * (T : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (q₀ : ℤ) + (T : ℤ) := by
