      ∏ j ∈ Finset.range ℓ, tateEpsUnit F L (recChar F rec L (μA ^ j)) ψ := by
    rw [← ht_A1_ev]
    exact mul_inv_eq_one.mp heval_D₀
  have ht_Aχ_ev : evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, A, hLA, χA⟩ =
      tateEpsUnit F A (recChar F rec A χA) (traceChar F hLA ψ) * f A := by
    simp [evalMonomialTerm]
  have h_unit_eq : evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, A, hLA, χA⟩ *
      tateEpsUnit F A (recChar F rec A 1) (traceChar F hLA ψ) =
      tateEpsUnit F A (recChar F rec A χA) (traceChar F hLA ψ) *
        (∏ j ∈ Finset.range ℓ, tateEpsUnit F L (recChar F rec L (μA ^ j)) ψ) := by
    calc evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, A, hLA, χA⟩ *
          tateEpsUnit F A (recChar F rec A 1) (traceChar F hLA ψ)
      _ = (tateEpsUnit F A (recChar F rec A χA) (traceChar F hLA ψ) * f A) *
            tateEpsUnit F A (recChar F rec A 1) (traceChar F hLA ψ) := by rw [ht_Aχ_ev]
      _ = tateEpsUnit F A (recChar F rec A χA) (traceChar F hLA ψ) *
            (tateEpsUnit F A (recChar F rec A 1) (traceChar F hLA ψ) * f A) := by ac_rfl
      _ = tateEpsUnit F A (recChar F rec A χA) (traceChar F hLA ψ) *
            (∏ j ∈ Finset.range ℓ, tateEpsUnit F L (recChar F rec L (μA ^ j)) ψ) := by rw [hfA_eq]
  have heps_A1 : (tateEpsUnit F A (recChar F rec A 1) (traceChar F hLA ψ) : Ω F) =
      tateEps F A 1 (traceChar F hLA ψ) :=
    (htateEps A (traceChar F hLA ψ) hψA 1 (hWeil_one A) 1 (fun _ => rfl)).2
  have heps_Aχ : (tateEpsUnit F A (recChar F rec A χA) (traceChar F hLA ψ) : Ω F) =
      tateEps F A (recChar F rec A χA) (traceChar F hLA ψ) := by
    unfold tateEpsUnit
    rw [dif_pos (ld_tateEps_ne_zero F A (traceChar F hLA ψ) hψA (recChar F rec A χA))]
    rfl
  have hνA_pow_rec : ∀ (j : ℕ) (x : Lˣ), (νA ^ j) x = (μA ^ j) (rec.recMap L x) := by
    intro j x
    rw [MonoidHom.pow_apply, MonoidHom.pow_apply, hνA_rec]
  have h_unit_prod : ∀ (s : Finset ℕ) (g : ℕ → (Ω F)ˣ),
      ((∏ j ∈ s, g j : (Ω F)ˣ) : Ω F) = ∏ j ∈ s, (g j : Ω F) := by
    intro s g
    induction' s using Finset.cons_induction with a s ha ih
    · rfl
    · rw [Finset.prod_cons, Finset.prod_cons, Units.val_mul, ih]
  have heps_L_prod : ((∏ j ∈ Finset.range ℓ,
      tateEpsUnit F L (recChar F rec L (μA ^ j)) ψ : (Ω F)ˣ) : Ω F) =
      ∏ j ∈ Finset.range ℓ, tateEps F L (νA ^ j) ψ := by
    rw [h_unit_prod]
    exact Finset.prod_congr rfl fun j _ =>
      (htateEps L ψ hψ (μA ^ j) (hWeil_pow j) (νA ^ j) (hνA_pow_rec j)).2
  have hf_elim : (evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, A, hLA, χA⟩ : Ω F) *
      tateEps F A 1 (traceChar F hLA ψ) =
      tateEps F A (recChar F rec A χA) (traceChar F hLA ψ) *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νA ^ j) ψ) := by
    have hval := congrArg Units.val h_unit_eq
    rw [Units.val_mul, Units.val_mul, heps_A1, heps_Aχ, heps_L_prod] at hval
    exact hval
  exact ⟨μA, νA, hμA_weil, hμA_rest, hμA_ker, hμA_pow, hμA_ne, h_char_exhaust,
    hνA_eq, hνA_rec, hνA_pow, hνA_ne, hνA_ker, hνA_cond, hf_elim⟩

theorem ld_ch12_galois_aut_weil_recChar_invariance (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L A : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F A]
    (hLA : L ≤ A) (hGalLA : IsGaloisExt F L A)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χA : relWeil F A →* (Ω F)ˣ) (hχA_weil : IsWeilRep F A (charRep F A χA))
    (g : relWeil F L) :
    ∃ (σ_g : A ≃ₐ[F] A) (χA_g : relWeil F A →* (Ω F)ˣ),
      (∀ y : A, (σ_g y : AlgebraicClosure F) = (g : AbsGal F) (y : AlgebraicClosure F)) ∧
      (∀ x : L, σ_g (IntermediateField.inclusion hLA x) = IntermediateField.inclusion hLA x) ∧
      (∀ (w : relWeil F A)
        (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F A),
        χA_g w = χA ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩) ∧
      IsWeilRep F A (charRep F A χA_g) ∧
      (∀ y : Aˣ,
        (recChar F rec A χA_g) (Units.map σ_g.toRingEquiv.toMonoidHom y) =
          (recChar F rec A χA) y) ∧
      condExp F A (recChar F rec A χA_g) = condExp F A (recChar F rec A χA) ∧
      tateEps F A (recChar F rec A χA_g) (traceChar F hLA ψ) =
        tateEps F A (recChar F rec A χA) (traceChar F hLA ψ) :=
by
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨hWeil_unit_triv, hSepRec_all⟩ := ld_separable_weil_char_rec_and_norm F rec
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear * -
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have hSep_iff : ∀ (L₀ E₁ : IntermediateField F (AlgebraicClosure F)) (h₀ : L₀ ≤ E₁),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars h₀) ↔
        E₁ ≤ IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) := by
    clear * -
    intro L₀ E₁ h₀
    let S := IntermediateField.extendScalars h₀
    have hmin : ∀ x : S, IsSeparable L₀ x.1 ↔ IsSeparable L₀ x := by
      intro x
      change (minpoly L₀ (S.val x)).Separable ↔ (minpoly L₀ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h₀).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₀ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₁ := (IntermediateField.mem_extendScalars h₀).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have helper_galois_map_mem : ∀ (B : IntermediateField F (AlgebraicClosure F))
      (hLB : L ≤ B), IsGaloisExt F L B →
      ∀ (δ : AbsGal F), δ ∈ L.fixingSubgroup → ∀ z ∈ B, δ z ∈ B := by
    intro B hLB hGalLB δ hδ z hz
    let B' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLB
    haveI : FiniteDimensional F B' := hGalLB.2.1
    haveI : IsScalarTower F L B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L B' := Module.Finite.of_restrictScalars_finite F L B'
    haveI : Algebra.IsSeparable L B' := hGalLB.2.2.2 hLB
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hB'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ B', τ x = x) → ∀ x ∈ B', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτB : τ_F.1 ∈ B.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLB).mpr hx)
      have hconjB : (σ_F * τ_F * σ_F⁻¹).1 ∈ B.fixingSubgroup :=
        hGalLB.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτB
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjB
      exact hconjB x ((IntermediateField.mem_extendScalars hLB).mp hx)
    haveI : IsGalois L ↥B' := helper_isGalois L (AlgebraicClosure F) B' hB'_norm_fix
    haveI : Normal L ↥B' := IsGalois.to_normal
    let σ_B : B' ≃ₐ[L] B' :=
      AlgEquiv.restrictNormalHom B' ((IntermediateField.fixingSubgroupEquiv L) ⟨δ, hδ⟩)
    let x : B' := ⟨z, (IntermediateField.mem_extendScalars hLB).mpr hz⟩
    have hx : ((σ_B x : B') : AlgebraicClosure F) = δ z := by
      change ((AlgEquiv.restrictNormalHom B'
        ((IntermediateField.fixingSubgroupEquiv L) ⟨δ, hδ⟩) x : B') : AlgebraicClosure F) = δ z
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    rw [← hx]
    exact (IntermediateField.mem_extendScalars hLB).mp (σ_B x).2
  
  let γ : AbsGal F := (g : AbsGal F)
  have hγL : γ ∈ L.fixingSubgroup := g.2.2
  have hγ_inv_L : γ⁻¹ ∈ L.fixingSubgroup := L.fixingSubgroup.inv_mem g.2.2
  let σ_g : A ≃ₐ[F] A :=
    { toFun := fun y => ⟨γ y.1, helper_galois_map_mem A hLA hGalLA γ hγL y.1 y.2⟩
      invFun := fun y => ⟨γ⁻¹ y.1, helper_galois_map_mem A hLA hGalLA γ⁻¹ hγ_inv_L y.1 y.2⟩
      left_inv := fun y => Subtype.ext (γ.symm_apply_apply y.1)
      right_inv := fun y => Subtype.ext (γ.apply_symm_apply y.1)
      map_mul' := fun x y => Subtype.ext (map_mul γ x.1 y.1)
      map_add' := fun x y => Subtype.ext (map_add γ x.1 y.1)
      commutes' := fun r => Subtype.ext (γ.commutes r) }
  have hσ_g_coe : ∀ y : A, (σ_g y : AlgebraicClosure F) = (g : AbsGal F) (y : AlgebraicClosure F) :=
    fun _ => rfl
  have hσ_g_fixL : ∀ x : L,
      σ_g (IntermediateField.inclusion hLA x) = IntermediateField.inclusion hLA x := by
    intro x
    apply Subtype.ext
    exact (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγL x.1 x.2
  have hConj_relWeil : ∀ w : relWeil F A, γ⁻¹ * (w : AbsGal F) * γ ∈ relWeil F A := by
    intro w
    refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem g.2.1) w.2.1) g.2.1, ?_⟩
    exact hGalLA.2.2.1 γ⁻¹ hγ_inv_L (w : AbsGal F) w.2.2
  let conjHom_g : relWeil F A →* relWeil F A :=
    { toFun := fun w => ⟨γ⁻¹ * (w : AbsGal F) * γ, hConj_relWeil w⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun w₁ w₂ => Subtype.ext (by
        change γ⁻¹ * ((w₁ : AbsGal F) * (w₂ : AbsGal F)) * γ =
          (γ⁻¹ * (w₁ : AbsGal F) * γ) * (γ⁻¹ * (w₂ : AbsGal F) * γ)
        group) }
  let χA_g : relWeil F A →* (Ω F)ˣ := χA.comp conjHom_g
  have hχA_g_apply : ∀ (w : relWeil F A)
      (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F A),
      χA_g w = χA ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩ :=
    fun _ _ => rfl
  
  obtain ⟨M_ab, hAM_ab, ω, χ_ab, hGalM_ab, hAbM_ab, hχA_eq, hω_I, hχ_ab_rest⟩ :=
    ld_weil_char_untwist_abelian_decomp F A χA hχA_weil
  haveI : FiniteDimensional F M_ab := hGalM_ab.2.1
  have hχ_ab_ker : ∀ w : relWeil F A, (w : AbsGal F) ∈ M_ab.fixingSubgroup → χ_ab w = 1 := by
    intro w hwM
    let w_M : relWeil F M_ab := ⟨w.1, ⟨w.2.1, hwM⟩⟩
    have h1 : restrictWeilChar F hAM_ab χ_ab w_M = 1 := by
      rw [hχ_ab_rest, MonoidHom.one_apply]
    exact h1
  have h_primeToP_map : ∀ (α : AbsGal F) (ζ : AlgebraicClosure F),
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (α ζ) := by
    rintro α ζ ⟨n, hn_pos, hpn, hζn⟩
    refine ⟨n, hn_pos, hpn, ?_⟩
    rw [← map_pow, hζn, map_one]
  have h_fix_inertia : ∀ τ : AbsGal F,
      (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ) →
      τ ∈ inertia F := by
    intro τ hτ
    let K_fix : IntermediateField F (AlgebraicClosure F) :=
      { carrier := {x : AlgebraicClosure F | τ x = x}
        algebraMap_mem' := fun r => τ.commutes r
        zero_mem' := map_zero τ
        one_mem' := map_one τ
        add_mem' := fun {a b} ha hb => by change τ (a + b) = a + b; rw [map_add, ha, hb]
        mul_mem' := fun {a b} ha hb => by change τ (a * b) = a * b; rw [map_mul, ha, hb]
        inv_mem' := fun {a} ha => by change τ a⁻¹ = a⁻¹; rw [map_inv₀, ha] }
    have hle : unramifiedClosure F ≤ K_fix := by
      unfold unramifiedClosure
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      exact hτ ζ hζ
    change τ ∈ (unramifiedClosure F).fixingSubgroup
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact hle hx
  have h_inv_apply : ∀ (α : AbsGal F) (x : AlgebraicClosure F), α⁻¹ (α x) = x :=
    fun α x => α.symm_apply_apply x
  have h_apply_inv : ∀ (α : AbsGal F) (x : AlgebraicClosure F), α (α⁻¹ x) = x :=
    fun α x => α.apply_symm_apply x
  have h_comm_inertia : ∀ w : AbsGal F, γ⁻¹ * w * γ * w⁻¹ ∈ inertia F := by
    intro w
    apply h_fix_inertia
    rintro ζ ⟨N, hN_pos, hpN, hζN⟩
    obtain ⟨k, hk⟩ := (hFrob N hN_pos hpN).2.2 w
    let ξ : AlgebraicClosure F := w⁻¹ ζ
    have hξN : ξ ^ N = 1 := by
      dsimp [ξ]
      rw [← map_pow, hζN, map_one]
    have hγξN : (γ ξ) ^ N = 1 := by
      rw [← map_pow, hξN, map_one]
    change γ⁻¹ (w (γ ξ)) = ζ
    rw [hk (γ ξ) hγξN, map_pow, h_inv_apply γ ξ, ← hk ξ hξN]
    exact h_apply_inv w ζ
  have hω_conj : ∀ w : relWeil F A, ω (conjHom_g w) = ω w := by
    intro w
    have hI : ((conjHom_g w * w⁻¹ : relWeil F A) : AbsGal F) ∈ inertia F :=
      h_comm_inertia (w : AbsGal F)
    have h1 : ω (conjHom_g w * w⁻¹) = 1 := hω_I (conjHom_g w * w⁻¹) hI
    rwa [map_mul, map_inv, mul_inv_eq_one] at h1
  let M_ab_g : IntermediateField F (AlgebraicClosure F) :=
    M_ab.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  haveI : FiniteDimensional F M_ab_g :=
    Module.Finite.equiv (M_ab.equivMap (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)).toLinearEquiv
  have hχA_g_weil : IsWeilRep F A (charRep F A χA_g) := by
    let U_g : Set (AbsGal F) := (M_ab_g.fixingSubgroup : Set (AbsGal F))
    have hUg_nhds : U_g ∈ nhds (1 : AbsGal F) :=
      (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U_g).mpr
        ⟨M_ab_g, inferInstance, Set.Subset.rfl⟩
    refine ⟨inferInstance, U_g, hUg_nhds, fun w hwU hwI => ?_⟩
    have hconj_M : (conjHom_g w : AbsGal F) ∈ M_ab.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have hγx : (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) x ∈ M_ab_g := ⟨x, hx, rfl⟩
      have hw_fix : (w : AbsGal F) (γ x) = γ x :=
        (IntermediateField.mem_fixingSubgroup_iff M_ab_g (w : AbsGal F)).mp hwU (γ x) hγx
      change γ⁻¹ ((w : AbsGal F) (γ x)) = x
      rw [hw_fix]
      exact h_inv_apply γ x
    have h1 : χA_g w = 1 := by
      change χA (conjHom_g w) = 1
      rw [hχA_eq, MonoidHom.mul_apply, hω_conj w, hω_I w hwI, hχ_ab_ker (conjHom_g w) hconj_M, mul_one]
    apply LinearMap.ext
    intro v
    change (χA_g w : Ω F) • v = v
    rw [h1, Units.val_one, one_smul]
  
  have hSepLA : Algebra.IsSeparable L (IntermediateField.extendScalars hLA) := hGalLA.2.2.2 hLA
  have hψA : IsAdmissibleChar F A (traceChar F hLA ψ) :=
    ((htraceChar L A hLA hSepLA).2 ψ hψ).1
  set χA' := recChar F rec A χA
  set χA_g' := recChar F rec A χA_g
  obtain ⟨χ₀', hχ₀'_rec, hχ₀'_cond, _⟩ := hSepRec_all A χA hχA_weil
  have hχA'_eq : χA' = χ₀' := (htateEps A (traceChar F hLA ψ) hψA χA hχA_weil χ₀' hχ₀'_rec).1
  have hχA'_rec : ∀ y : Aˣ, χA' y = χA (rec.recMap A y) := by
    rw [hχA'_eq]; exact hχ₀'_rec
  have hχA'_cond : ∀ u ∈ unitGroup F A (condExp F A χA'), χA' u = 1 := by
    rw [hχA'_eq]; exact hχ₀'_cond
  obtain ⟨χ₀_g', hχ₀_g'_rec, _, _⟩ := hSepRec_all A χA_g hχA_g_weil
  have hχA_g'_eq : χA_g' = χ₀_g' :=
    (htateEps A (traceChar F hLA ψ) hψA χA_g hχA_g_weil χ₀_g' hχ₀_g'_rec).1
  have hχA_g'_rec : ∀ y : Aˣ, χA_g' y = χA_g (rec.recMap A y) := by
    rw [hχA_g'_eq]; exact hχ₀_g'_rec
  have hSepAA : ∀ h : A ≤ A, Algebra.IsSeparable A (IntermediateField.extendScalars h) := by
    intro h
