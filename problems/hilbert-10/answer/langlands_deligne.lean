  have h_disj_HC : ∀ g : G, g ∈ H → g ∈ C → g = 1 := by
    let f_mul : H × C → G := fun p => p.1.1 * p.2.1
    have hf_surj : Function.Surjective f_mul := by
      intro g
      obtain ⟨h, hh, c, hc, rfl⟩ := hG_mul g
      exact ⟨⟨⟨h, hh⟩, ⟨c, hc⟩⟩, rfl⟩
    have hf_card : Fintype.card (H × C) = Fintype.card G := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, Nat.card_prod, h_card_G_HC]
    have hf_bij : Function.Bijective f_mul :=
      (Fintype.bijective_iff_surjective_and_card f_mul).mpr ⟨hf_surj, hf_card⟩
    intro g hgH hgC
    have h_eq : f_mul (⟨g, hgH⟩, 1) = f_mul (1, ⟨g, hgC⟩) := by
      change g * 1 = 1 * g
      rw [mul_one, one_mul]
    have h_pair := hf_bij.1 h_eq
    exact congrArg (fun p : H × C => p.1.1) h_pair
  have h_ker_π : ∀ w : relWeil F L, π w = 1 ↔ (w : AbsGal F) ∈ K.fixingSubgroup := by
    intro w
    rw [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hw z hz
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
      have h1 := hπ w x
