    (hnorm_shift c₀).1, (hnorm_shift c₀).2⟩
  have hsub_δ₀ :
      IntermediateField.inclusion hLM₁' (α : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
        (a₁ + IntermediateField.inclusion hLM₁' (c₀ ^ 2 - c₁ ^ 2 * h₀) +
          (IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
            IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x)) =
      δ₀ - IntermediateField.inclusion hLM₁' (c₀ ^ 2 - c₁ ^ 2 * h₀) -
        (IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
          IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x) := by
    dsimp [δ₀]
    ring
  rw [hsub_δ₀, hδ₀_eq]
  dsimp [Δ₀, Δ₁, G]
  simp only [map_add, map_sub, map_mul, map_neg, map_one, map_ofNat]
  ring

theorem ld_ch12_wild_dyadic_odd_max_break_min_cond_cM1_stationarity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hm1_min : condExp F M₁' θM₁' = 2 * condExp F L νE' - 1)
    (hSpecL : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (τ₁ : M₁' ≃ₐ[F] M₁')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (h2_ne : (2 : L) ≠ 0)
    (h2_val : valL F L (2 : L) = ((condExp F L νE' / 2 : ℕ) : ℤ))
    (x : M₁') (f ρ E : L) (α : Lˣ)
    (hβ₁ : -4 * f ≠ 0)
    (hx_ne : x ≠ 0) (hf_ne : f ≠ 0) (hρ_ne : ρ ≠ 0)
    (h4f_ρ : 4 * f - ρ = 4 * E)
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hρ_val : valL F L ρ =
      (2 * ((condExp F L νE' / 2 : ℕ) : ℤ) + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hE_val : E = 0 ∨ (1 - ((condExp F L νM₁' / 2 : ℕ) : ℤ)) ≤ valL F L E)
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (hα_val : valL F L (α : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hNormPhaseM₁' : ∀ v : M₁', (v = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' v) →
      ψ (((α⁻¹ : Lˣ) : L) * (-4 * f) * (traceLM F hLM₁' v + normLM F hLM₁' v)) = 1)
    (hCommM₁' : ∀ s₀ : L, (s₀ = 0 ∨ (((condExp F L νE' / 2 : ℕ) + 1 : ℕ) : ℤ) ≤ valL F L s₀) →
      1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0 ∧
      ∀ hu₁ : 1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0,
        let u₁ : M₁'ˣ := Units.mk0 (1 - IntermediateField.inclusion hLM₁' s₀ * x) hu₁
        let v₁ : M₁'ˣ := (Units.map τ₁.toRingEquiv.toMonoidHom u₁) * u₁⁻¹
        let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
        (θM₁' v₁ : Ω F) =
          (traceChar F hLM₁' ψ)
            (IntermediateField.inclusion hLM₁' ((α⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1)))
    (hCoordTrNorm : ∀ s₀ s₁ : L,
      traceLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        2 * s₀ - s₁ ∧
      normLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        s₀ ^ 2 - s₀ * s₁ - f * s₁ ^ 2)
    (c₀ c₁ : L) (c_θ₁ : M₁'ˣ) (Δ₀ Δ₁ : L)
    (hc_θ₁_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z))
    (hc₀_val : c₀ = 0 ∨ 1 - ((((condExp F L νM₁' / 2) + 1) / 2 : ℕ) : ℤ) ≤ valL F L c₀)
    (hc₁_val : c₁ = 0 ∨ ((((condExp F L νM₁' / 2) + 1) / 2 : ℕ) : ℤ) ≤ valL F L c₁)
    (hΔ₀_val : Δ₀ = 0 ∨
      ((condExp F L νE' / 2 : ℕ) : ℤ) - ((condExp F L νM₁' / 2 : ℕ) : ℤ) + 1 ≤ valL F L Δ₀)
    (hΔ₁_val : Δ₁ = 0 ∨ 0 ≤ valL F L Δ₁)
    (hΔ_eq :
      let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
      let u₄ : Lˣ := u₂ ^ 2
      let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
      let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
      let A := c₀ ^ 2 - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x
      IntermediateField.inclusion hLM₁' (α : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
          (a₁ + IntermediateField.inclusion hLM₁' A + Q₁) =
        IntermediateField.inclusion hLM₁' Δ₀ + IntermediateField.inclusion hLM₁' Δ₁ * x)
    (hQ₁_norm :
      let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
      let u₄ : Lˣ := u₂ ^ 2
      let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
      let β₁ := -4 * f
      let A := c₀ ^ 2 - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x
      normLM F hLM₁' Q₁ - β₁ * A =
        c₁ * ((u₄⁻¹ : Lˣ) : L) * ρ * (1 + 4 * f) * (4 * c₀ - c₁ * (4 * f + ρ))) :
    let a := condExp F L νM₁' / 2
    let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
    let u₄ : Lˣ := u₂ ^ 2
    let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
    let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
    let A := c₀ ^ 2 - c₁ ^ 2 * h₀
    let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
      IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x
    let N₁ : M₁' := a₁ + IntermediateField.inclusion hLM₁' A + Q₁
    N₁ ≠ 0 ∧
    valL F M₁' N₁ = 1 - 2 * (a : ℤ) ∧
    (∀ z : M₁', (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L)) * N₁ * z)) :=
by
  dsimp only
  set a := condExp F L νM₁' / 2
  set e := condExp F L νE' / 2
  set a_ceil := (a + 1) / 2
  set u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
  set u₄ : Lˣ := u₂ ^ 2
  set h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
  set β₁ : L := -4 * f
  set ι := IntermediateField.inclusion hLM₁'
  set a₁ : M₁' := ι E - x
  set A := c₀ ^ 2 - c₁ ^ 2 * h₀
  set q₀ : L := c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ
  set q₁ : L := -2 * c₀ + c₁ * ρ
  set Q₁ : M₁' := ι q₀ + ι q₁ * x
  set N₁ : M₁' := a₁ + ι A + Q₁
  set Δ : M₁' := ι Δ₀ + ι Δ₁ * x
  have ha_ge1 : 1 ≤ a := by dsimp [a]; omega
  have hae : a ≤ e := by dsimp [a, e]; omega
  have hcond_M₁' : condExp F L νM₁' = 2 * a := by dsimp [a]; omega
  have hcond_E' : condExp F L νE' = 2 * e + 1 := by dsimp [e]; omega
  have hm1_half : (condExp F M₁' θM₁' + 1) / 2 = 2 * e + 1 := by dsimp [e]; omega
  have ha_parts : a ≤ 2 * a_ceil ∧ 2 * a_ceil ≤ a + 1 := by
    dsimp [a_ceil]; omega
  rcases hvalL_props with ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    _, hvalL_ultra, _, _, _⟩
  rcases hvalM₁'_props with ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul,
    hvalM₁'_inv, _, hvalM₁'_ultra, _, _, _⟩
  have h2_or : (2 : L) = 0 ∨ (e : ℤ) ≤ valL F L (2 : L) := Or.inr (le_of_eq h2_val.symm)
  have hvalL_mono : ∀ (m₁ m₂ : ℤ) (s : L),
      (s = 0 ∨ m₁ ≤ valL F L s) → m₂ ≤ m₁ → (s = 0 ∨ m₂ ≤ valL F L s) := by
    intro m₁ m₂ s hs hm
    rcases hs with rfl | hs
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hs)
  have hvalL_neg_or : ∀ (m : ℤ) (s : L),
      (s = 0 ∨ m ≤ valL F L s) → (-s = 0 ∨ m ≤ valL F L (-s)) := by
    intro m s hs
    rcases hs with rfl | hs
    · simp
    · right; rw [hvalL_neg]; exact hs
  have hvalL_add : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ → m ≤ m₂ → (s₁ + s₂ = 0 ∨ m ≤ valL F L (s₁ + s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm₁ hm₂
    exact hvalL_ultra m s₁ s₂ (hvalL_mono m₁ m s₁ hs₁ hm₁) (hvalL_mono m₂ m s₂ hs₂ hm₂)
  have hvalL_sub : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ → m ≤ m₂ → (s₁ - s₂ = 0 ∨ m ≤ valL F L (s₁ - s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm₁ hm₂
    rw [sub_eq_add_neg]
    exact hvalL_add m m₁ m₂ s₁ (-s₂) hs₁ (hvalL_neg_or m₂ s₂ hs₂) hm₁ hm₂
  have hvalL_mul_or : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ + m₂ → (s₁ * s₂ = 0 ∨ m ≤ valL F L (s₁ * s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm
    by_cases h₁ : s₁ = 0
    · simp [h₁]
    · by_cases h₂ : s₂ = 0
      · simp [h₂]
      · rcases hs₁ with rfl | hs₁
        · contradiction
        · rcases hs₂ with rfl | hs₂
          · contradiction
          · right
            rw [hvalL_mul s₁ s₂ h₁ h₂]
            omega
  have hvalL_sq_or : ∀ (m m₁ : ℤ) (s : L),
      (s = 0 ∨ m₁ ≤ valL F L s) → m ≤ 2 * m₁ → (s ^ 2 = 0 ∨ m ≤ valL F L (s ^ 2)) := by
    intro m m₁ s hs hm
    rw [sq]
    exact hvalL_mul_or m m₁ m₁ s s hs hs (by omega)
  have hvalL_2mul : ∀ (m m₁ : ℤ) (s : L),
      (s = 0 ∨ m₁ ≤ valL F L s) → m ≤ (e : ℤ) + m₁ → (2 * s = 0 ∨ m ≤ valL F L (2 * s)) := by
    intro m m₁ s hs hm
    exact hvalL_mul_or m (e : ℤ) m₁ 2 s h2_or hs hm
  have hvalL_4mul : ∀ (m m₁ : ℤ) (s : L),
      (s = 0 ∨ m₁ ≤ valL F L s) → m ≤ 2 * (e : ℤ) + m₁ → (4 * s = 0 ∨ m ≤ valL F L (4 * s)) := by
    intro m m₁ s hs hm
    have h4 : (4 : L) * s = 2 * (2 * s) := by ring
    rw [h4]
    exact hvalL_2mul m ((e : ℤ) + m₁) (2 * s) (hvalL_2mul ((e : ℤ) + m₁) m₁ s hs le_rfl) (by omega)
  have hvalL_eq_of_lt : ∀ (m₁ m₂ : ℤ) (s₁ s₂ : L),
      s₁ ≠ 0 → valL F L s₁ = m₁ → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) → m₁ < m₂ →
      s₁ + s₂ ≠ 0 ∧ valL F L (s₁ + s₂) = m₁ := by
    intro m₁ m₂ s₁ s₂ hs₁_ne hs₁_val hs₂ hlt
    have hsum_ne : s₁ + s₂ ≠ 0 := by
      intro h0
      have hs₂_eq : s₂ = -s₁ := by linear_combination h0
      have hs₂_ne : s₂ ≠ 0 := by rw [hs₂_eq]; exact neg_ne_zero.mpr hs₁_ne
      rcases hs₂ with rfl | hs₂
      · exact hs₂_ne rfl
      · rw [hs₂_eq, hvalL_neg, hs₁_val] at hs₂
