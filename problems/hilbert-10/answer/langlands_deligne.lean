    valL F M ((((ϖ_M ^ t)⁻¹ : Mˣ) : M) * traceLM F hMK ((ϖ_K ^ t : Kˣ) : K)) = 0 ∧
    ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → K → K),
      Fintype.card G = q ∧
      (∀ y : K, act 1 y = y) ∧
      (∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y)) ∧
      (∀ σ : G,
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ y₁ y₂ : K,
