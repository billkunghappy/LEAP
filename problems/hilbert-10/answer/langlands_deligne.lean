          rw [hh₀_val]
          omega
        let u_R : L := -R * ((u_h₀⁻¹ : Lˣ) : L) * ((π₁⁻¹ : Lˣ) : L) ^ 2
        have hu_R : u_R = 0 ∨ 0 ≤ valL F L u_R :=
          hL_mono (by omega) (hL_mul (hL_mul (hL_neg hR) hu_h₀_inv_ge) (hL_sq hπ₁_inv_ge))
        obtain ⟨s, hs_val, hs_sq⟩ := hfrob_surj u_R hu_R
        let δc₁ : L := (π₁ : L) * s
        have hδc₁ : δc₁ = 0 ∨ m₁ ≤ valL F L δc₁ :=
          hL_mono (by omega) (hL_mul hπ₁_ge hs_val)
        have hh₀_π₁_sq_uR : -h₀ * (π₁ : L) ^ 2 * u_R = R := by
          dsimp [u_R]
          calc -h₀ * (π₁ : L) ^ 2 * (-R * ((u_h₀⁻¹ : Lˣ) : L) * ((π₁⁻¹ : Lˣ) : L) ^ 2)
            _ = R * ((u_h₀ : L) * ((u_h₀⁻¹ : Lˣ) : L)) * ((π₁ : L) * ((π₁⁻¹ : Lˣ) : L)) ^ 2 := by
                change -h₀ * (π₁ : L) ^ 2 * (-R * ((u_h₀⁻¹ : Lˣ) : L) * ((π₁⁻¹ : Lˣ) : L) ^ 2) =
                  R * (h₀ * ((u_h₀⁻¹ : Lˣ) : L)) * ((π₁ : L) * ((π₁⁻¹ : Lˣ) : L)) ^ 2
                ring
            _ = R * 1 * 1 ^ 2 := by rw [Units.mul_inv u_h₀, Units.mul_inv π₁]
            _ = R := by ring
        have hG_step : A_star - G c₀ (c₁ + δc₁) =
            -h₀ * (π₁ : L) ^ 2 * (u_R - s ^ 2) + (c₀ + 2 * c₁ * h₀ - 2 * d * g) * δc₁ := by
          calc A_star - G c₀ (c₁ + δc₁)
            _ = R + δc₁ ^ 2 * h₀ + (c₀ + 2 * c₁ * h₀ - 2 * d * g) * δc₁ := by dsimp [R, G]; ring
            _ = -h₀ * (π₁ : L) ^ 2 * u_R + ((π₁ : L) * s) ^ 2 * h₀ +
                  (c₀ + 2 * c₁ * h₀ - 2 * d * g) * δc₁ := by rw [hh₀_π₁_sq_uR]
            _ = -h₀ * (π₁ : L) ^ 2 * (u_R - s ^ 2) + (c₀ + 2 * c₁ * h₀ - 2 * d * g) * δc₁ := by
                ring
        have hlin_coeff :
            c₀ + 2 * c₁ * h₀ - 2 * d * g = 0 ∨
              1 - (a : ℤ) ≤ valL F L (c₀ + 2 * c₁ * h₀ - 2 * d * g) :=
          hL_sub
            (hL_add
              (hL_mono (by omega) hc₀)
              (hL_mono (by omega) (hL_mul (hL_mul h2_ge hc₁) hh₀_ge)))
            (hL_mono (by omega) (hL_mul (hL_mul h2_ge hd_ge) hg_ge))
        refine ⟨c₀, c₁ + δc₁, hc₀, hL_add hc₁ (hL_mono (by omega) hδc₁), ?_⟩
        rw [hG_step]
        exact hL_add
          (hL_mono (by omega) (hL_mul (hL_mul (hL_neg hh₀_ge) (hL_sq hπ₁_ge)) hs_sq))
          (hL_mono (by omega) (hL_mul hlin_coeff hδc₁))
  obtain ⟨c₀, c₁, hc₀_val, hc₁_val, hΔ₀_raw⟩ := hG_ind (r - 1) (le_refl _)
  let Δ₀ : L := A_star - G c₀ c₁
  let Δ₁ : L := B_star - (-2 * c₀ + c₁ * (1 + d + 4 * d * g))
  have hΔ₀_val : Δ₀ = 0 ∨ (r : ℤ) - (a : ℤ) ≤ valL F L Δ₀ :=
    hL_mono (by omega) hΔ₀_raw
  have h1d4dg_ge : 1 + d + 4 * d * g = 0 ∨ 0 ≤ valL F L (1 + d + 4 * d * g) :=
    hL_add
      (hL_add h1_ge (hL_mono (by omega) hd_ge))
      (hL_mono (by omega) (hL_mul (hL_mul h4_ge hd_ge) hg_ge))
  have hΔ₁_val : Δ₁ = 0 ∨ 0 ≤ valL F L Δ₁ :=
    hL_sub
      hB_star_val
      (hL_add
        (hL_mono (by omega) (hL_mul (hL_neg h2_ge) hc₀_val))
        (hL_mono (by omega) (hL_mul hc₁_val h1d4dg_ge)))
  refine ⟨hCoordTrNorm, hτ₁_TrNorm, c₀, c₁, c_θ₁, Δ₀, Δ₁,
    hc_θ₁_val, hc_θ₁_stat, hc₀_val, hc₁_val, hΔ₀_val, hΔ₁_val, ?_,
    (hnorm_shift (2 * c₀ - c₁)).1, (hnorm_shift (2 * c₀ - c₁)).2⟩
  have hsub_δ₀ :
      IntermediateField.inclusion hLM₁' (α : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
        (a₁ + IntermediateField.inclusion hLM₁' (c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀) +
          (IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
            IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x)) =
      δ₀ - IntermediateField.inclusion hLM₁' (c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀) -
        (IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
          IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x) := by
    dsimp [δ₀]
    ring
  rw [hsub_δ₀, hδ₀_eq]
  dsimp [Δ₀, Δ₁, G]
  simp only [map_add, map_sub, map_mul, map_neg, map_one, map_ofNat]
  ring

theorem ld_ch12_wild_dyadic_even_breaks_min_cond_cM1_stationarity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' θM₁' = 2 * condExp F L νE' - 1)
    (hSpecL : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (τ₁ : M₁' ≃ₐ[F] M₁')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁') (f g d : L) (α : Lˣ)
    (hβ₁ : d ^ 2 + 2 * d - 4 * f ≠ 0)
    (hx_ne : x ≠ 0) (hf_ne : f ≠ 0) (hg_ne : g ≠ 0) (hd_ne : d ≠ 0)
    (hk₀_ne : 1 + d ≠ 0) (hh₀_ne : f + g + 4 * f * g ≠ 0)
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hg_val : valL F L g = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hd_val : valL F L d = (((condExp F L νE' / 2 : ℕ) : ℤ) - ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hk₀_val : valL F L (1 + d) = 0)
    (hE_val : f + d ^ 2 * g = 0 ∨ (1 - ((condExp F L νM₁' / 2 : ℕ) : ℤ)) ≤ valL F L (f + d ^ 2 * g))
    (hh₀_val : valL F L (f + g + 4 * f * g) = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hβ₁_val : valL F L (d ^ 2 + 2 * d - 4 * f) =
      2 * (((condExp F L νE' / 2 : ℕ) : ℤ) - ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (hα_val : valL F L (α : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hNormPhaseM₁' : ∀ v : M₁', (v = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' v) →
      ψ (((α⁻¹ : Lˣ) : L) * (d ^ 2 + 2 * d - 4 * f) * (traceLM F hLM₁' v + normLM F hLM₁' v)) = 1)
    (hCommM₁' : ∀ s₀ : L, (s₀ = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L s₀) →
      1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0 ∧
      ∀ hu₁ : 1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0,
        let u₁ : M₁'ˣ := Units.mk0 (1 - IntermediateField.inclusion hLM₁' s₀ * x) hu₁
        let v₁ : M₁'ˣ := (Units.map τ₁.toRingEquiv.toMonoidHom u₁) * u₁⁻¹
        let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
          IntermediateField.inclusion hLM₁' (1 + d) * x
        (θM₁' v₁ : Ω F) =
          (traceChar F hLM₁' ψ)
            (IntermediateField.inclusion hLM₁' ((α⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1)))
    (hCoordTrNorm : ∀ s₀ s₁ : L,
      traceLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        2 * s₀ - s₁ ∧
      normLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        s₀ ^ 2 - s₀ * s₁ - f * s₁ ^ 2)
    (hτ₁_TrNorm : ∀ z : M₁',
      IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z ∧
      IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (c₀ c₁ : L) (c_θ₁ : M₁'ˣ) (Δ₀ Δ₁ : L)
    (hc_θ₁_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z))
    (hc₀_val : c₀ = 0 ∨ 1 - ((((condExp F L νM₁' / 2) + 1) / 2 : ℕ) : ℤ) ≤ valL F L c₀)
    (hc₁_val : c₁ = 0 ∨
      ((condExp F L νE' / 2 : ℕ) : ℤ) - (((condExp F L νM₁' / 2) / 2 : ℕ) : ℤ) ≤ valL F L c₁)
    (hΔ₀_val : Δ₀ = 0 ∨
      ((condExp F L νE' / 2 : ℕ) : ℤ) - ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F L Δ₀)
    (hΔ₁_val : Δ₁ = 0 ∨ 0 ≤ valL F L Δ₁)
    (hΔ_eq :
      let k₀ := 1 + d
      let h₀ := f + g + 4 * f * g
      let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
        IntermediateField.inclusion hLM₁' k₀ * x
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      IntermediateField.inclusion hLM₁' (α : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
          (a₁ + IntermediateField.inclusion hLM₁' A + Q₁) =
        IntermediateField.inclusion hLM₁' Δ₀ + IntermediateField.inclusion hLM₁' Δ₁ * x)
    (hQ₁_norm :
      let h₀ := f + g + 4 * f * g
      let β₁ := d ^ 2 + 2 * d - 4 * f
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      normLM F hLM₁' Q₁ - β₁ * A =
        c₁ * (1 + 4 * f) * (1 + 4 * g) * (c₀ * d - c₁ * (f + d ^ 2 * g))) :
    let a := condExp F L νM₁' / 2
    let k₀ := 1 + d
    let h₀ := f + g + 4 * f * g
    let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
      IntermediateField.inclusion hLM₁' k₀ * x
    let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
    let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
      IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
    let N₁ : M₁' := a₁ + IntermediateField.inclusion hLM₁' A + Q₁
    N₁ ≠ 0 ∧
    valL F M₁' N₁ = 1 - 2 * (a : ℤ) ∧
    (∀ z : M₁', (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L)) * N₁ * z)) :=
by
  dsimp only
  set a := condExp F L νM₁' / 2
  set r := condExp F L νE' / 2
  set a_half := a / 2
  set a_ceil := (a + 1) / 2
  set k₀ := 1 + d
  set h₀ := f + g + 4 * f * g
  set β₁ := d ^ 2 + 2 * d - 4 * f
  set ι := IntermediateField.inclusion hLM₁'
  set a₁ : M₁' := ι (f - d ^ 2 * g) - ι k₀ * x
  set A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
  set q₀ : L := c₀ * d + 2 * c₁ * d * g
  set q₁ : L := -2 * c₀ + c₁ * (1 + d + 4 * d * g)
  set Q₁ : M₁' := ι q₀ + ι q₁ * x
  set N₁ : M₁' := a₁ + ι A + Q₁
  set Δ : M₁' := ι Δ₀ + ι Δ₁ * x
  have ha_ge1 : 1 ≤ a := by dsimp [a]; omega
  have har : a ≤ r := by dsimp [a, r]; omega
  have hcond_M₁' : condExp F L νM₁' = 2 * a := by dsimp [a]; omega
  have hcond_E' : condExp F L νE' = 2 * r := by dsimp [r]; omega
  have hm1_half : (condExp F M₁' θM₁' + 1) / 2 = 2 * r := by dsimp [r]; omega
  have ha_parts :
      a_half + a_ceil = a ∧ 2 * a_half ≤ a ∧ a ≤ 2 * a_ceil ∧ 2 * a_ceil ≤ a + 1 := by
    dsimp [a_half, a_ceil]; omega
  rcases hvalL_props with ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    _, hvalL_ultra, _, _, _⟩
  rcases hvalM₁'_props with ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul,
    hvalM₁'_inv, _, hvalM₁'_ultra, _, _, _⟩
  have hvalL_mono : ∀ (m₁ m₂ : ℤ) (s : L),
      (s = 0 ∨ m₁ ≤ valL F L s) → m₂ ≤ m₁ → (s = 0 ∨ m₂ ≤ valL F L s) := by
    intro m₁ m₂ s hs hm
    rcases hs with rfl | hs
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hs)
  have hvalL_neg_or : ∀ (m : ℤ) (s : L),
      (s = 0 ∨ m ≤ valL F L s) → (-s = 0 ∨ m ≤ valL F L (-s)) := by
    intro m s hs
    rcases hs with rfl | hs
    · simp
    · right; rw [hvalL_neg]; exact hs
  have hvalL_add : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ → m ≤ m₂ → (s₁ + s₂ = 0 ∨ m ≤ valL F L (s₁ + s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm₁ hm₂
    exact hvalL_ultra m s₁ s₂ (hvalL_mono m₁ m s₁ hs₁ hm₁) (hvalL_mono m₂ m s₂ hs₂ hm₂)
  have hvalL_sub : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ → m ≤ m₂ → (s₁ - s₂ = 0 ∨ m ≤ valL F L (s₁ - s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm₁ hm₂
    rw [sub_eq_add_neg]
    exact hvalL_add m m₁ m₂ s₁ (-s₂) hs₁ (hvalL_neg_or m₂ s₂ hs₂) hm₁ hm₂
  have hvalL_mul_or : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ + m₂ → (s₁ * s₂ = 0 ∨ m ≤ valL F L (s₁ * s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm
    by_cases h₁ : s₁ = 0
    · simp [h₁]
    · by_cases h₂ : s₂ = 0
      · simp [h₂]
      · rcases hs₁ with rfl | hs₁
        · contradiction
        · rcases hs₂ with rfl | hs₂
          · contradiction
          · right
            rw [hvalL_mul s₁ s₂ h₁ h₂]
            omega
