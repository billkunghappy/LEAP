              ψ (((cνE'⁻¹ : Lˣ) : L) * (δ_L : L) * s) =
            (θM₁' (Units.mk0 (1 + (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s) hs_M) : Ω F)⁻¹ *
              ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s)) :=
by
  intro a e m₁ m₂ ψE' ψM₁' θE' θM₁' δ_L δ_M₁'
  obtain ⟨hNormLE', hNormLM₁', hcνE'_pkg, hcνM₁'_pkg⟩ :=
    ld_ch12_wild_dyadic_odd_max_break_min_cond_lower_norm_and_c_nu_stat F L E' M₁'
      hLE' hLM₁' hdegLE' hdegLM₁' ψ νE' νM₁' hbE'_ge2 hbM₁'_ge2 hMinM₁'
      hT1_even hT2_odd hQuadNorm hSpecL hvalL_props hval_normE' hval_normM₁'
      htr_LE' h2_ne h2_val x f ρ α hβ₁ hβ₂ hf_val hρ_val hM₁'_coords
      hCoordTrNorm hα_val hc_ν₂_stat hc_ν₁_stat c₀ hc₀_val
  let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
  let u₄ : Lˣ := u₂ ^ 2
  let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
  let Y : K₁ := IntermediateField.inclusion hM₁'K₁ x +
    IntermediateField.inclusion hE'K₁
      (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)
  let z₃ : K₁ := (2 * IntermediateField.inclusion hM₁'K₁ x + 1) *
    IntermediateField.inclusion hE'K₁
      (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)
  let h₁ : M₁' := 2 * x
  let h₂ : E' := R - 1
  let β₁ : L := -4 * f
  let β₂ : L := 1 - ρ
  let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
  let p_X := 2 * c₀
  let A := c₀ ^ 2 - c₁ ^ 2 * h₀
  let X : K₁ := IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
    IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ * z₃
  let C_val : K₁ := Y - X
  let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
    IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x
  let N₁ : M₁' := a₁ + IntermediateField.inclusion hLM₁' A + Q₁
  have hST := hShiftTable c₀ c₁
  have htrM₁'_eq : traceLM F hM₁'K₁ C_val = h₁ - IntermediateField.inclusion hLM₁' p_X := hST.1
  have htrE'_eq : traceLM F hE'K₁ C_val = h₂ - IntermediateField.inclusion hLE' p_X := hST.2.1
  have hnormM₁'_eq : normLM F hM₁'K₁ C_val = N₁ := hST.2.2.1
  have hN₁_val' : valL F M₁' N₁ = 1 - 2 * (a : ℤ) := hN₁_val
  have hC_val_elem : valL F K₁ C_val = 1 - 2 * (a : ℤ) := by
    rw [← (hval_normK₁ C_val).2, hnormM₁'_eq, hN₁_val']
  have hC_ne : C_val ≠ 0 := by
    intro h0
