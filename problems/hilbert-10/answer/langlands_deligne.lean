        σ.1 ∈ A.fixingSubgroup ↔ res_F' σ ∈ (toSub A hF'A).fixingSubgroup := by
      intro A hF'A hAK σ
      rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hσ y hy
        apply Subtype.ext
        rw [h_res_apply σ y]
        exact hσ y.1 ((h_mem_toSub A hF'A y).mp hy)
      · intro hσ x hx
        let y : K' := ⟨x, (IntermediateField.mem_extendScalars hF'K).mpr (hAK hx)⟩
        have hy : y ∈ toSub A hF'A := (h_mem_toSub A hF'A y).mpr hx
        have h1 := congrArg Subtype.val (hσ y hy)
        rwa [h_res_apply σ y] at h1
    have h_res_K : ∀ σ : F'.fixingSubgroup, σ.1 ∈ K.fixingSubgroup ↔ res_F' σ = 1 := by
      intro σ
      rw [IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hσ
        apply AlgEquiv.ext
        intro y
        apply Subtype.ext
        rw [h_res_apply σ y]
        exact hσ y.1 ((IntermediateField.mem_extendScalars hF'K).mp y.2)
      · intro h1 x hx
        let y : K' := ⟨x, (IntermediateField.mem_extendScalars hF'K).mpr hx⟩
