    have hE_eq : E_inv1 =
        R_inv1 + (S_trunc - S_trunc_main) * D_norm⁻¹ + (S1 - S1_main) * D_norm⁻¹ := by
      change (S_inv1 - S_inv1_main) - L_val⁻¹ * (S1 - S1_main) =
        ((S_inv1 - L_val⁻¹ * S1) - (S_trunc + S1 - (Δ : K₁) ^ i) * D_norm⁻¹) +
          (S_trunc - S_trunc_main) * D_norm⁻¹ + (S1 - S1_main) * D_norm⁻¹
      linear_combination hmain1
    rw [hE_eq]
    have h1 := hR_inv1 i hi
    have h2 := hval_mul_bound
      (((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - ((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ))
      ((p * p * p * m : ℕ) : ℤ)
      (S_trunc - S_trunc_main) D_norm⁻¹ (hS_trunc i hi) hD_inv_bound
    have h3 := hval_mul_bound
      (((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ))
      ((p * p * p * m : ℕ) : ℤ)
      (S1 - S1_main) D_norm⁻¹ (hS1 i hi) hD_inv_bound
    have h12 := hval_add
      (((4 * p * p * m₁ : ℕ) : ℤ) + ((2 * p * p * m : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ))
      R_inv1 ((S_trunc - S_trunc_main) * D_norm⁻¹)
      h1 (hval_mono _ _ _ (by linarith) h2)
    exact hval_add
      (((4 * p * p * m₁ : ℕ) : ℤ) + ((2 * p * p * m : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ))
      (R_inv1 + (S_trunc - S_trunc_main) * D_norm⁻¹) ((S1 - S1_main) * D_norm⁻¹)
      h12 (hval_mono _ _ _ (by linarith) h3)
  refine ⟨hE_inv1_all, ?_⟩
  intro S_inv2 S_inv2_main
  set S1_top := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1)
  set S1_main_top :=
    ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) +
      ((p - 1 : ℕ) : K₁) * (if p - 1 = p - 1 then 1 else 0)
  set S_inv1_top := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1) * (L_val + ξ m')⁻¹
  set S_inv1_main_top :=
    ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * L_val⁻¹ +
      ((p - 1 : ℕ) : K₁) * A_star ^ (p - 1) * D_norm⁻¹
  set E_inv1_top := (S_inv1_top - S_inv1_main_top) - L_val⁻¹ * (S1_top - S1_main_top)
  set S_deriv := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1) * P'_geom (ξ m')
  set S_deriv_main :=
    ((p : ℕ) : K₁) * ((p - 1 : ℕ) : K₁) * (Δ : K₁) ^ (p - 1) * L_val ^ (p - 2) -
      ((p - 1 : ℕ) : K₁) ^ 2 * A_star ^ (p - 2)
  set R_inv2 := S_inv2 -
    ((((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) * D_norm⁻¹ * S_inv1_top - S_deriv * D_norm⁻¹)
  have hmain2 := (rat_main_term_identities (p - 1)).2
  change ((((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) * D_norm⁻¹ * S_inv1_main_top -
    S_deriv_main * D_norm⁻¹) = S_inv2_main at hmain2
  have hS2_eq : S_inv2 - S_inv2_main =
      R_inv2 +
        (((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) * D_norm⁻¹ *
          (E_inv1_top + L_val⁻¹ * (S1_top - S1_main_top)) -
        (S_deriv - S_deriv_main) * D_norm⁻¹ := by
    change S_inv2 - S_inv2_main =
      (S_inv2 - ((((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) * D_norm⁻¹ * S_inv1_top - S_deriv * D_norm⁻¹)) +
        (((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) * D_norm⁻¹ *
          (((S_inv1_top - S_inv1_main_top) - L_val⁻¹ * (S1_top - S1_main_top)) +
            L_val⁻¹ * (S1_top - S1_main_top)) -
        (S_deriv - S_deriv_main) * D_norm⁻¹
    linear_combination hmain2
  rw [hS2_eq]
  have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := by rw [Finset.mem_Icc]; omega
  have hE_top := hE_inv1_all (p - 1) hp1_mem
  have hS1_top_bound := hval_mul_bound
    ((p * p * m : ℕ) : ℤ)
    (((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
    L_val⁻¹ (S1_top - S1_main_top) hL_inv_bound (hS1 (p - 1) hp1_mem)
  have h_2ppm_eq : ((p * p * m : ℕ) : ℤ) + ((p * p * m : ℕ) : ℤ) = ((2 * p * p * m : ℕ) : ℤ) := by
    push_cast; ring
  have h_ppm_nonneg : (0 : ℤ) ≤ ((p * p * m : ℕ) : ℤ) := by positivity
  have hS_inv1_diff := hval_add
    (((4 * p * p * m₁ : ℕ) : ℤ) + ((p * p * m : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
    E_inv1_top (L_val⁻¹ * (S1_top - S1_main_top))
    (hval_mono _ _ _ (by linarith) hE_top)
    (hval_mono _ _ _ (by linarith) hS1_top_bound)
  have hLp1_bound : L_val ^ (p - 1) = 0 ∨
      -((p - 1 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ) ≤ valL F K₁ (L_val ^ (p - 1)) := by
    right
    have hL_val' : valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) := hL_val
    rw [hval_pow L_val hL_ne0 (p - 1), hL_val']
    linarith
  have hpLp1_bound := hval_mul_bound 0 (-((p - 1 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ))
    ((p : ℕ) : K₁) (L_val ^ (p - 1)) (hval_natCast p) hLp1_bound
  have hp1_ppm_nonneg : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ) := by positivity
  have hpLp1_sub1_bound := hval_sub (-((p - 1 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ))
    (((p : ℕ) : K₁) * L_val ^ (p - 1)) 1
    (hval_mono _ _ _ (by linarith) hpLp1_bound)
    (Or.inr (by rw [hval_1]; linarith))
  have hcoeff_bound := hval_mul_bound
    (-((p - 1 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ))
    ((p * p * p * m : ℕ) : ℤ)
    (((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) D_norm⁻¹
    hpLp1_sub1_bound hD_inv_bound
  have hmid_bound := hval_mul_bound
    ((p * p * m : ℕ) : ℤ)
    (((4 * p * p * m₁ : ℕ) : ℤ) + ((p * p * m : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
    ((((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) * D_norm⁻¹)
    (E_inv1_top + L_val⁻¹ * (S1_top - S1_main_top))
    (hval_mono _ _ _ (by linarith) hcoeff_bound)
    hS_inv1_diff
  have hderiv_D_bound := hval_mul_bound
    (((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) -
      ((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
    ((p * p * p * m : ℕ) : ℤ)
    (S_deriv - S_deriv_main) D_norm⁻¹ hS_deriv hD_inv_bound
  have h12 := hval_add
    (((4 * p * p * m₁ : ℕ) : ℤ) + ((2 * p * p * m : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
    R_inv2
    ((((p : ℕ) : K₁) * L_val ^ (p - 1) - 1) * D_norm⁻¹ *
