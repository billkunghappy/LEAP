  set D : M₁' := U₀ - d ^ p
  have hD_frob1 : D - σ₀ D = 0 ∨ ((T - d_U : ℕ) : ℤ) ≤ valL F M₁' (D - σ₀ D) := by
    have hD_id : D - σ₀ D = (σ₀ (d ^ p) - d ^ p - 1) - (σ₀ U₀ - U₀ - 1) := by
      change (U₀ - d ^ p) - σ₀ (U₀ - d ^ p) = _
      rw [map_sub]
      ring
    rw [hD_id]
    have hd_frob' : σ₀ (d ^ p) - d ^ p - 1 = 0 ∨
        ((T - d_U : ℕ) : ℤ) ≤ valL F M₁' (σ₀ (d ^ p) - d ^ p - 1) :=
      hmono_val (by omega) hd_pow_frob
    exact hsub_val_ge ((T - d_U : ℕ) : ℤ) _ _ hd_frob' hU₀_frob
  have hD_pow : ∀ k : ℕ,
      D - (σ₀ ^ k) D = 0 ∨ ((T - d_U : ℕ) : ℤ) ≤ valL F M₁' (D - (σ₀ ^ k) D) := by
    intro k
    induction k with
    | zero =>
      left
      change D - D = 0
      exact sub_self D
    | succ k ih =>
      have hstep : D - (σ₀ ^ (k + 1)) D = (D - σ₀ D) + σ₀ (D - (σ₀ ^ k) D) := by
        rw [pow_succ']
        change D - σ₀ ((σ₀ ^ k) D) = (D - σ₀ D) + σ₀ (D - (σ₀ ^ k) D)
        rw [map_sub σ₀ D ((σ₀ ^ k) D)]
        ring
      rw [hstep]
      have hσ_ih : σ₀ (D - (σ₀ ^ k) D) = 0 ∨
          ((T - d_U : ℕ) : ℤ) ≤ valL F M₁' (σ₀ (D - (σ₀ ^ k) D)) := by
        rcases ih with h0 | hge
        · left; rw [h0, map_zero]
        · right; rwa [hσ₀_val]
      exact hval_add_M₁' ((T - d_U : ℕ) : ℤ) _ _ hD_frob1 hσ_ih
  set A_star : L := traceLM F hLM₁' (D * y₁)
  have hApprox : U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p) = 0 ∨
      ((T - d_U : ℕ) : ℤ) ≤
        valL F M₁' (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p)) := by
    have hy₁_sum : (∑ k ∈ Finset.range p, (σ₀ ^ k) y₁) = 1 := by
      have h1 := hσ₀_tr y₁
      rw [hy₁_tr, map_one] at h1
      exact h1.symm
    have hrem_sum : U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p) =
        ∑ k ∈ Finset.range p, (D - (σ₀ ^ k) D) * (σ₀ ^ k) y₁ := by
      calc U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p)
        _ = D * 1 - IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (D * y₁)) := by
              dsimp [D, A_star]; ring
        _ = D * (∑ k ∈ Finset.range p, (σ₀ ^ k) y₁) -
            ∑ k ∈ Finset.range p, (σ₀ ^ k) (D * y₁) := by
              rw [hy₁_sum, hσ₀_tr (D * y₁)]
        _ = (∑ k ∈ Finset.range p, D * (σ₀ ^ k) y₁) -
            ∑ k ∈ Finset.range p, (σ₀ ^ k) D * (σ₀ ^ k) y₁ := by
              rw [Finset.mul_sum]
              congr 1
              exact Finset.sum_congr rfl fun k _ => map_mul (σ₀ ^ k) D y₁
        _ = ∑ k ∈ Finset.range p, (D - (σ₀ ^ k) D) * (σ₀ ^ k) y₁ := by
              rw [← Finset.sum_sub_distrib]
              exact Finset.sum_congr rfl fun k _ => (sub_mul D ((σ₀ ^ k) D) ((σ₀ ^ k) y₁)).symm
    rw [hrem_sum]
    have hsum_bound : ∀ r : ℕ,
        (∑ k ∈ Finset.range r, (D - (σ₀ ^ k) D) * (σ₀ ^ k) y₁) = 0 ∨
        ((T - d_U : ℕ) : ℤ) ≤
          valL F M₁' (∑ k ∈ Finset.range r, (D - (σ₀ ^ k) D) * (σ₀ ^ k) y₁) := by
      intro r
      induction r with
      | zero => left; simp
      | succ r ih =>
        rw [Finset.sum_range_succ]
        have hy₁_k : (σ₀ ^ r) y₁ = 0 ∨ 0 ≤ valL F M₁' ((σ₀ ^ r) y₁) := by
          rcases hy₁_int with rfl | hge
          · left; exact map_zero (σ₀ ^ r)
          · right; rwa [hσ₀_pow_val r y₁]
        have hterm : (D - (σ₀ ^ r) D) * (σ₀ ^ r) y₁ = 0 ∨
            ((T - d_U : ℕ) : ℤ) ≤ valL F M₁' ((D - (σ₀ ^ r) D) * (σ₀ ^ r) y₁) :=
          hmul_int ((T - d_U : ℕ) : ℤ) _ _ (hD_pow r) hy₁_k
        exact hval_add_M₁' ((T - d_U : ℕ) : ℤ) _ _ ih hterm
    exact hsum_bound p
  have hincl_cν_ne : IntermediateField.inclusion hLM₁' (c_ν : L) ≠ 0 :=
    (hincl_eq_zero (c_ν : L)).not.mpr (Units.ne_zero c_ν)
  have hU₀_ne : U₀ ≠ 0 := mul_ne_zero hincl_cν_ne (Units.ne_zero c_U⁻¹)
  have hU₀_val : valL F M₁' U₀ = -(h : ℤ) := by
    rw [hval_mul_M₁' _ _ hincl_cν_ne (Units.ne_zero c_U⁻¹), hval_LM₁', hc_ν_val, hc_U_inv_val]
    omega
  have hd_pow_val : ∀ k : ℕ, valL F M₁' (d ^ k) = 0 := by
    intro k
    induction k with
    | zero => rw [pow_zero, hval1_M₁']
    | succ k ih =>
      rw [pow_succ]
      by_cases hdk : d ^ k = 0
      · rw [hdk, zero_mul, hval0_M₁']
      · by_cases hd0 : d = 0
        · rw [hd0, mul_zero, hval0_M₁']
        · rw [hval_mul_M₁' (d ^ k) d hdk hd0, ih, hd_val, add_zero]
  set E_rem : M₁' := U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p)
  set R : M₁' := -(d ^ p) - E_rem
  have hR_int : R = 0 ∨ 0 ≤ valL F M₁' R := by
    have h1 : -(d ^ p) = 0 ∨ 0 ≤ valL F M₁' (-(d ^ p)) := by
      right; rw [hval_neg_M₁', hd_pow_val p]
    have h2 : E_rem = 0 ∨ 0 ≤ valL F M₁' E_rem := hmono_val (by omega) hApprox
    exact hsub_val_ge 0 (-(d ^ p)) E_rem h1 h2
  have hA_star_id : IntermediateField.inclusion hLM₁' A_star = U₀ + R := by
    dsimp [R, E_rem]; ring
  refine ⟨A_star, hApprox, ?_, ?_⟩
  · intro hh0
    have hU₀_int : U₀ = 0 ∨ 0 ≤ valL F M₁' U₀ := by
      right; rw [hU₀_val]; omega
    have hsum_int : IntermediateField.inclusion hLM₁' A_star = 0 ∨
        0 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' A_star) := by
      rw [hA_star_id]
      exact hval_add_M₁' 0 U₀ R hU₀_int hR_int
    rcases hsum_int with h0 | hge
    · exact Or.inl ((hincl_eq_zero A_star).mp h0)
    · rw [hval_LM₁' A_star] at hge
      exact Or.inr hge
  · intro hh_pos
    have hA_ne : A_star ≠ 0 := by
      intro hA0
      have hUR0 : U₀ + R = 0 := by
        rw [← hA_star_id, hA0, map_zero]
      have hR_eq : R = -U₀ := eq_neg_of_add_eq_zero_right hUR0
      rcases hR_int with hR0 | hR_ge
      · rw [hR_eq, neg_eq_zero] at hR0
        exact hU₀_ne hR0
      · rw [hR_eq, hval_neg_M₁', hU₀_val] at hR_ge
        omega
    refine ⟨hA_ne, ?_⟩
    have hA_ge : -(h : ℤ) ≤ valL F L A_star := by
      have h1 : U₀ = 0 ∨ -(h : ℤ) ≤ valL F M₁' U₀ := Or.inr (by rw [hU₀_val])
      have h2 : R = 0 ∨ -(h : ℤ) ≤ valL F M₁' R := hmono_val (by omega) hR_int
      have hsum := hval_add_M₁' (-(h : ℤ)) U₀ R h1 h2
      rw [← hA_star_id] at hsum
      have hincl_A_ne : IntermediateField.inclusion hLM₁' A_star ≠ 0 :=
        (hincl_eq_zero A_star).not.mpr hA_ne
      have hge := hsum.resolve_left hincl_A_ne
      rwa [hval_LM₁' A_star] at hge
    have hA_le : valL F L A_star ≤ -(h : ℤ) := by
      by_contra hlt
      have h1 : IntermediateField.inclusion hLM₁' A_star = 0 ∨
          -(h : ℤ) + 1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' A_star) := by
        right; rw [hval_LM₁' A_star]; omega
      have h2 : R = 0 ∨ -(h : ℤ) + 1 ≤ valL F M₁' R := hmono_val (by omega) hR_int
      have hU_id : U₀ = IntermediateField.inclusion hLM₁' A_star - R := by
        rw [hA_star_id]; ring
      have hU_ge := hsub_val_ge (-(h : ℤ) + 1) _ R h1 h2
      rw [← hU_id] at hU_ge
      have hU_ge' := hU_ge.resolve_left hU₀_ne
      rw [hU₀_val] at hU_ge'
      omega
    omega

theorem ld_wild_odd_unramified_herbrand_norm_approx_and_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (ψ : AddChar L (Ω F))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (T t : ℕ) (ht_ge1 : 1 ≤ t) (hT_eq : T = t + 1)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hT_le : T ≤ condExp F M₁' θM₁')
    (hNonStable : condExp F M₁' θM₁' < 2 * T)
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLE') ϖ_E' = ϖ_L)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F E' m,
      Units.map (normLM F hLE') w ∈ unitGroup F L m)
    (hnorm_surj_lt : ∀ m < t, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F E' m,
        (Units.map (normLM F hLE') w) * u⁻¹ ∈ unitGroup F L (m + 1))
    (c_U : M₁'ˣ)
    (hc_U_val : valL F M₁' (c_U : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc_U_stat : ∀ z : M₁',
      (z = 0 ∨ ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          (traceChar F hLM₁' ψ) (((c_U⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2)))
    (d : M₁') (hd_val : valL F M₁' d = 0)
    (c_ν : Lˣ)
    (hc_ν_val : valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ)
    (A_star : L)
    (hA_star_approx :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let mM₁' := condExp F M₁' θM₁'
      let U₀ := IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')
      U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p) = 0 ∨
        ((T - mM₁' / 2 : ℕ) : ℤ) ≤
          valL F M₁' (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p)))
    (hA_star_zero : condExp F M₁' θM₁' - T = 0 → (A_star = 0 ∨ 0 ≤ valL F L A_star))
    (hA_star_pos : 0 < condExp F M₁' θM₁' - T →
      A_star ≠ 0 ∧ valL F L A_star = -((condExp F M₁' θM₁' - T : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let mM₁' := condExp F M₁' θM₁'
    let h := mM₁' - T
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ (ε₀ : L) (x : E'),
      let A := normLM F hLE' x
      let B_U := IntermediateField.inclusion hLM₁' (A + ε₀) + d ^ p
      (ε₀ = 0 ∨ 0 ≤ valL F L ε₀) ∧
      (h < T - 1 → ε₀ = 0) ∧
      (h = 0 → (x = 0 ∨ 0 ≤ valL F E' x)) ∧
      (0 < h → x ≠ 0 ∧ valL F E' x = -(h : ℤ) ∧ valL F L A = -(h : ℤ)) ∧
      valL F M₁' B_U = -(h : ℤ) ∧
      (∀ z : M₁', (z = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
            ψM₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) * B_U * (2 * z - z ^ 2))) :=
by
  
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set mM₁' := condExp F M₁' θM₁'
  set h := mM₁' - T
  set ψM₁' := traceChar F hLM₁' ψ
  set d_U := mM₁' / 2
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    _, hval_add_L, hunit0_iff_L, hunit_pos_iff_L, hunit_val0_L⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
    _, hval_add_E', hunit0_iff_E', hunit_pos_iff_E', hunit_val0_E'⟩ :=
    ld_valL_and_unitGroup_props F E'
  obtain ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
    _, hval_add_M₁', _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M₁'
  have hval_mul_bound_L : ∀ (a b : ℤ) (x y : L),
      (x = 0 ∨ a ≤ valL F L x) → (y = 0 ∨ b ≤ valL F L y) →
        (x * y = 0 ∨ a + b ≤ valL F L (x * y)) := by
    intro a b x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul_L x y hx0 hy0]
        have ha := hx.resolve_left hx0
        have hb := hy.resolve_left hy0
        omega
  have hval_mul_bound_M₁' : ∀ (a b : ℤ) (x y : M₁'),
      (x = 0 ∨ a ≤ valL F M₁' x) → (y = 0 ∨ b ≤ valL F M₁' y) →
        (x * y = 0 ∨ a + b ≤ valL F M₁' (x * y)) := by
    intro a b x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul_M₁' x y hx0 hy0]
        have ha := hx.resolve_left hx0
        have hb := hy.resolve_left hy0
        omega
  have hval_pow_L : ∀ k : ℕ, valL F L ((ϖ_L ^ k : Lˣ) : L) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      simpa using hval1_L
    | succ k ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul_L _ _ (Units.ne_zero (ϖ_L ^ k)) (Units.ne_zero ϖ_L), ih, hϖ_L]
      push_cast
      ring
  have hval_pow_E' : ∀ k : ℕ, valL F E' ((ϖ_E' ^ k : E'ˣ) : E') = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      simpa using hval1_E'
    | succ k ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul_E' _ _ (Units.ne_zero (ϖ_E' ^ k)) (Units.ne_zero ϖ_E'), ih, hϖ_E']
      push_cast
      ring
  have hval_inv_pow_L : ∀ k : ℕ, valL F L (((ϖ_L ^ k)⁻¹ : Lˣ) : L) = -(k : ℤ) := by
    intro k
    rw [hval_inv_L (ϖ_L ^ k), hval_pow_L k]
  have hval_inv_pow_E' : ∀ k : ℕ, valL F E' (((ϖ_E' ^ k)⁻¹ : E'ˣ) : E') = -(k : ℤ) := by
    intro k
    rw [hval_inv_E' (ϖ_E' ^ k), hval_pow_E' k]
  have hnorm_pow_ϖ : ∀ k : ℕ,
      normLM F hLE' ((ϖ_E' ^ k : E'ˣ) : E') = ((ϖ_L ^ k : Lˣ) : L) := by
    intro k
    have h1 : Units.map (normLM F hLE') (ϖ_E' ^ k) = ϖ_L ^ k := by
      rw [map_pow, hϖ_norm]
    exact congrArg Units.val h1
  have hnorm_inv_pow_ϖ : ∀ k : ℕ,
      normLM F hLE' (((ϖ_E' ^ k)⁻¹ : E'ˣ) : E') = (((ϖ_L ^ k)⁻¹ : Lˣ) : L) := by
    intro k
    have h1 : Units.map (normLM F hLE') ((ϖ_E' ^ k)⁻¹) = (ϖ_L ^ k)⁻¹ := by
      rw [map_inv, map_pow, hϖ_norm]
    exact congrArg Units.val h1
  
  have hunit_ind : ∀ m : ℕ, m ≤ t → ∀ u₀ ∈ unitGroup F L 0,
      ∃ w_m ∈ unitGroup F E' 0,
        (Units.map (normLM F hLE') w_m) * u₀⁻¹ ∈ unitGroup F L m := by
    intro m
    induction m with
    | zero =>
      intro _ u₀ hu₀
      refine ⟨1, Subgroup.one_mem _, ?_⟩
      rw [map_one, one_mul]
      exact Subgroup.inv_mem _ hu₀
    | succ m ih =>
      intro hm1 u₀ hu₀
      have hm_lt : m < t := by omega
      have hm_le : m ≤ t := by omega
      obtain ⟨w_m, hw_m0, hv_m⟩ := ih hm_le u₀ hu₀
      set v_m := (Units.map (normLM F hLE') w_m) * u₀⁻¹
      have hvm_inv : v_m⁻¹ ∈ unitGroup F L m := Subgroup.inv_mem _ hv_m
      obtain ⟨δ, hδ_m, hδ_mul⟩ := hnorm_surj_lt m hm_lt v_m⁻¹ hvm_inv
      have hδ0 : δ ∈ unitGroup F E' 0 :=
        (hunit0_iff_E' δ).mpr (hunit_val0_E' m δ hδ_m)
      refine ⟨δ * w_m, Subgroup.mul_mem _ hδ0 hw_m0, ?_⟩
      have heq : (Units.map (normLM F hLE') (δ * w_m)) * u₀⁻¹ =
          (Units.map (normLM F hLE') δ) * (v_m⁻¹)⁻¹ := by
        rw [map_mul, mul_assoc, inv_inv]
      rw [heq]
      exact hδ_mul
  have hunit_lift : ∀ u₀ : Lˣ, valL F L (u₀ : L) = 0 →
      ∃ w₀ : E'ˣ, valL F E' (w₀ : E') = 0 ∧
        (normLM F hLE' (w₀ : E') - (u₀ : L) = 0 ∨
          (t : ℤ) ≤ valL F L (normLM F hLE' (w₀ : E') - (u₀ : L))) := by
    intro u₀ hu₀_val
    have hu₀_mem : u₀ ∈ unitGroup F L 0 := (hunit0_iff_L u₀).mpr hu₀_val
    obtain ⟨w₀, hw₀_mem, hvt_mem⟩ := hunit_ind t le_rfl u₀ hu₀_mem
    have hw₀_val : valL F E' (w₀ : E') = 0 := (hunit0_iff_E' w₀).mp hw₀_mem
    set v_t := (Units.map (normLM F hLE') w₀) * u₀⁻¹
    have hvt_pos : (v_t : L) = 1 ∨ (t : ℤ) ≤ valL F L ((v_t : L) - 1) :=
      (hunit_pos_iff_L t ht_ge1 v_t).mp hvt_mem
    have hvt_sub : (v_t : L) - 1 = 0 ∨ (t : ℤ) ≤ valL F L ((v_t : L) - 1) := by
      rcases hvt_pos with h1 | hge
      · left; rw [h1, sub_self]
      · right; exact hge
    have hmul_eq : ((v_t : L) - 1) * (u₀ : L) = normLM F hLE' (w₀ : E') - (u₀ : L) := by
      have hvt_coe : (v_t : L) = normLM F hLE' (w₀ : E') * ((u₀⁻¹ : Lˣ) : L) := rfl
      have hinv_u₀ : ((u₀⁻¹ : Lˣ) : L) * (u₀ : L) = 1 := Units.inv_mul u₀
      calc ((v_t : L) - 1) * (u₀ : L)
        _ = normLM F hLE' (w₀ : E') * (((u₀⁻¹ : Lˣ) : L) * (u₀ : L)) - (u₀ : L) := by
            rw [hvt_coe]; ring
        _ = normLM F hLE' (w₀ : E') - (u₀ : L) := by
            rw [hinv_u₀, mul_one]
    refine ⟨w₀, hw₀_val, ?_⟩
    rw [← hmul_eq]
    simpa only [add_zero] using
      hval_mul_bound_L (t : ℤ) 0 ((v_t : L) - 1) (u₀ : L) hvt_sub (Or.inr (by rw [hu₀_val]))
  
  have hh_le_t : h ≤ t := by omega
  have h1_le_TdU : 1 ≤ T - d_U := by omega
  have hTdU_le_t : ((T - d_U : ℕ) : ℤ) ≤ (t : ℤ) := by omega
  have hTdU_le_th : h < T - 1 → ((T - d_U : ℕ) : ℤ) ≤ (t : ℤ) - (h : ℤ) := by omega
  have hex_pair : ∃ (ε₀ : L) (x : E'),
      let A := normLM F hLE' x
      (ε₀ = 0 ∨ 0 ≤ valL F L ε₀) ∧
      (h < T - 1 → ε₀ = 0) ∧
      (h = 0 → (x = 0 ∨ 0 ≤ valL F E' x)) ∧
      (0 < h → x ≠ 0 ∧ valL F E' x = -(h : ℤ) ∧ valL F L A = -(h : ℤ)) ∧
      ((A + ε₀) - A_star = 0 ∨
        ((T - d_U : ℕ) : ℤ) ≤ valL F L ((A + ε₀) - A_star)) := by
    by_cases hh0 : h = 0
    · by_cases hA_hi : A_star = 0 ∨ ((T - d_U : ℕ) : ℤ) ≤ valL F L A_star
      · refine ⟨0, 0, Or.inl rfl, fun _ => rfl, fun _ => Or.inl rfl,
          fun hh_pos => by omega, ?_⟩
        haveI : IsScalarTower F L (IntermediateField.extendScalars hLE') :=
          IsScalarTower.of_algebraMap_eq fun _ => rfl
        haveI : FiniteDimensional F (IntermediateField.extendScalars hLE') :=
          inferInstanceAs (FiniteDimensional F E')
        haveI : Module.Finite L (IntermediateField.extendScalars hLE') :=
          FiniteDimensional.right F L (IntermediateField.extendScalars hLE')
        have hnorm0 : normLM F hLE' 0 = 0 := by
          change Algebra.norm L (toExtendScalars F hLE' 0) = 0
          rw [map_zero, Algebra.norm_zero]
        change (normLM F hLE' 0 + 0) - A_star = 0 ∨
          ((T - d_U : ℕ) : ℤ) ≤ valL F L ((normLM F hLE' 0 + 0) - A_star)
        rw [hnorm0, add_zero, zero_sub]
        rcases hA_hi with h0 | hge
        · left; rw [h0, neg_zero]
        · right; rw [hval_neg_L]; exact hge
      · push_neg at hA_hi
        rcases hA_hi with ⟨hA_ne0, _⟩
        have hA_nonneg : 0 ≤ valL F L A_star :=
          (hA_star_zero hh0).resolve_left hA_ne0
        set k₀ : ℕ := (valL F L A_star).toNat
        have hk₀_eq : (k₀ : ℤ) = valL F L A_star := Int.toNat_of_nonneg hA_nonneg
        let u₀ : Lˣ := (Units.mk0 A_star hA_ne0) * (ϖ_L ^ k₀)⁻¹
        have hu₀_val : valL F L (u₀ : L) = 0 := by
          change valL F L (A_star * (((ϖ_L ^ k₀)⁻¹ : Lˣ) : L)) = 0
          rw [hval_mul_L _ _ hA_ne0 (Units.ne_zero (ϖ_L ^ k₀)⁻¹),
            ← hk₀_eq, hval_inv_pow_L k₀, add_neg_cancel]
        obtain ⟨w₀, hw₀_val, hw₀_approx⟩ := hunit_lift u₀ hu₀_val
        let x : E' := ((w₀ * ϖ_E' ^ k₀ : E'ˣ) : E')
        have hx_val : valL F E' x = (k₀ : ℤ) := by
          change valL F E' ((w₀ : E') * ((ϖ_E' ^ k₀ : E'ˣ) : E')) = (k₀ : ℤ)
          rw [hval_mul_E' _ _ (Units.ne_zero w₀) (Units.ne_zero (ϖ_E' ^ k₀)),
            hw₀_val, hval_pow_E' k₀, zero_add]
        refine ⟨0, x, Or.inl rfl, fun _ => rfl,
          fun _ => Or.inr (by rw [hx_val]; omega),
          fun hh_pos => by omega, ?_⟩
        have hA_eq : normLM F hLE' x =
            normLM F hLE' (w₀ : E') * ((ϖ_L ^ k₀ : Lˣ) : L) := by
          change normLM F hLE' ((w₀ : E') * ((ϖ_E' ^ k₀ : E'ˣ) : E')) = _
          rw [map_mul, hnorm_pow_ϖ k₀]
        have hu₀_mul : (u₀ : L) * ((ϖ_L ^ k₀ : Lˣ) : L) = A_star := by
          have hinv_ϖ : (((ϖ_L ^ k₀)⁻¹ : Lˣ) : L) * ((ϖ_L ^ k₀ : Lˣ) : L) = 1 :=
            Units.inv_mul (ϖ_L ^ k₀)
          change (A_star * (((ϖ_L ^ k₀)⁻¹ : Lˣ) : L)) * ((ϖ_L ^ k₀ : Lˣ) : L) = A_star
          rw [mul_assoc, hinv_ϖ, mul_one]
        have hdiff_eq : (normLM F hLE' x + 0) - A_star =
            (normLM F hLE' (w₀ : E') - (u₀ : L)) * ((ϖ_L ^ k₀ : Lˣ) : L) := by
          rw [add_zero, hA_eq, ← hu₀_mul]
          ring
        change (normLM F hLE' x + 0) - A_star = 0 ∨
          ((T - d_U : ℕ) : ℤ) ≤ valL F L ((normLM F hLE' x + 0) - A_star)
        rw [hdiff_eq]
        have hbound := hval_mul_bound_L (t : ℤ) (k₀ : ℤ)
          (normLM F hLE' (w₀ : E') - (u₀ : L)) ((ϖ_L ^ k₀ : Lˣ) : L)
          hw₀_approx (Or.inr (by rw [hval_pow_L k₀]))
        exact hbound.imp id (fun hge => by omega)
    · have hh_pos : 0 < h := Nat.pos_of_ne_zero hh0
      obtain ⟨hA_ne0, hA_val⟩ := hA_star_pos hh_pos
      let u₀ : Lˣ := (Units.mk0 A_star hA_ne0) * (ϖ_L ^ h)
      have hu₀_val : valL F L (u₀ : L) = 0 := by
        change valL F L (A_star * ((ϖ_L ^ h : Lˣ) : L)) = 0
        rw [hval_mul_L _ _ hA_ne0 (Units.ne_zero (ϖ_L ^ h)),
          hA_val, hval_pow_L h, neg_add_cancel]
      obtain ⟨w₀, hw₀_val, hw₀_approx⟩ := hunit_lift u₀ hu₀_val
      let x : E' := ((w₀ * (ϖ_E' ^ h)⁻¹ : E'ˣ) : E')
      have hx_ne0 : x ≠ 0 := Units.ne_zero (w₀ * (ϖ_E' ^ h)⁻¹)
      have hx_val : valL F E' x = -(h : ℤ) := by
        change valL F E' ((w₀ : E') * (((ϖ_E' ^ h)⁻¹ : E'ˣ) : E')) = -(h : ℤ)
        rw [hval_mul_E' _ _ (Units.ne_zero w₀) (Units.ne_zero (ϖ_E' ^ h)⁻¹),
          hw₀_val, hval_inv_pow_E' h, zero_add]
      set A := normLM F hLE' x
      have hA_val_eq : valL F L A = -(h : ℤ) := by
        rw [hval_norm_LE' x, hx_val]
      have hA_eq : A = normLM F hLE' (w₀ : E') * (((ϖ_L ^ h)⁻¹ : Lˣ) : L) := by
        change normLM F hLE' ((w₀ : E') * (((ϖ_E' ^ h)⁻¹ : E'ˣ) : E')) = _
        rw [map_mul, hnorm_inv_pow_ϖ h]
      have hu₀_mul : (u₀ : L) * (((ϖ_L ^ h)⁻¹ : Lˣ) : L) = A_star := by
        have hmul_ϖ : ((ϖ_L ^ h : Lˣ) : L) * (((ϖ_L ^ h)⁻¹ : Lˣ) : L) = 1 :=
          Units.mul_inv (ϖ_L ^ h)
        change (A_star * ((ϖ_L ^ h : Lˣ) : L)) * (((ϖ_L ^ h)⁻¹ : Lˣ) : L) = A_star
        rw [mul_assoc, hmul_ϖ, mul_one]
      have hdiff_A : A - A_star =
          (normLM F hLE' (w₀ : E') - (u₀ : L)) * (((ϖ_L ^ h)⁻¹ : Lˣ) : L) := by
        rw [hA_eq, ← hu₀_mul]
        ring
      have hdiff_A_bound : A - A_star = 0 ∨ (t : ℤ) - (h : ℤ) ≤ valL F L (A - A_star) := by
        rw [hdiff_A]
        have h1 := hval_mul_bound_L (t : ℤ) (-(h : ℤ))
          (normLM F hLE' (w₀ : E') - (u₀ : L)) (((ϖ_L ^ h)⁻¹ : Lˣ) : L)
          hw₀_approx (Or.inr (by rw [hval_inv_pow_L h]))
        exact h1.imp id (fun hge => by omega)
      by_cases hh_lt : h < T - 1
      · refine ⟨0, x, Or.inl rfl, fun _ => rfl,
          fun hh0' => absurd hh0' hh0,
          fun _ => ⟨hx_ne0, hx_val, hA_val_eq⟩, ?_⟩
        change (A + 0) - A_star = 0 ∨ ((T - d_U : ℕ) : ℤ) ≤ valL F L ((A + 0) - A_star)
        rw [add_zero]
        have hle := hTdU_le_th hh_lt
        exact hdiff_A_bound.imp id (fun hge => le_trans hle hge)
      · have hh_eq_t : h = t := by omega
        set ε₀ : L := A_star - A
        have hε₀_int : ε₀ = 0 ∨ 0 ≤ valL F L ε₀ := by
          have hneg : ε₀ = -(A - A_star) := by ring
          rw [hneg]
          rcases hdiff_A_bound with h0 | hge
          · left; rw [h0, neg_zero]
          · right; rw [hval_neg_L]; omega
        refine ⟨ε₀, x, hε₀_int, fun hlt => absurd hlt hh_lt,
          fun hh0' => absurd hh0' hh0,
          fun _ => ⟨hx_ne0, hx_val, hA_val_eq⟩, ?_⟩
        left
        change (A + (A_star - A)) - A_star = 0
        ring
  
  obtain ⟨ε₀, x, hε₀_int, hε₀_lt, hx_zero, hx_pos, hA_approx⟩ := hex_pair
  set A := normLM F hLE' x
  set B_U := IntermediateField.inclusion hLM₁' (A + ε₀) + d ^ p
  set U₀ := IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')
  have hA_approx_M₁' :
      -(IntermediateField.inclusion hLM₁' ((A + ε₀) - A_star)) = 0 ∨
        ((T - d_U : ℕ) : ℤ) ≤
          valL F M₁' (-(IntermediateField.inclusion hLM₁' ((A + ε₀) - A_star))) := by
    rcases hA_approx with h0 | hge
    · left; rw [h0, map_zero, neg_zero]
    · right; rw [hval_neg_M₁', hval_LM₁']; exact hge
  have hU₀_BU_diff :
      U₀ - B_U = 0 ∨ ((T - d_U : ℕ) : ℤ) ≤ valL F M₁' (U₀ - B_U) := by
    have hadd_id :
        (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p)) +
          (-(IntermediateField.inclusion hLM₁' ((A + ε₀) - A_star))) =
        U₀ - B_U := by
      dsimp only [B_U]
      rw [map_sub]
      ring
    rw [← hadd_id]
    exact hval_add_M₁' ((T - d_U : ℕ) : ℤ) _ _ hA_star_approx hA_approx_M₁'
  have hincl_cν_ne0 : IntermediateField.inclusion hLM₁' (c_ν : L) ≠ 0 := by
    intro h0
    apply Units.ne_zero c_ν
    exact (IntermediateField.inclusion hLM₁').injective (h0.trans (map_zero _).symm)
  have hU₀_ne0 : U₀ ≠ 0 :=
    mul_ne_zero hincl_cν_ne0 (Units.ne_zero c_U⁻¹)
  have hU₀_val : valL F M₁' U₀ = -(h : ℤ) := by
    change valL F M₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')) =
      -(h : ℤ)
    rw [hval_mul_M₁' _ _ hincl_cν_ne0 (Units.ne_zero c_U⁻¹),
      hval_LM₁' (c_ν : L), hc_ν_val, hval_inv_M₁' c_U, hc_U_val, hnM₁'_eq]
    omega
  have hBU_val : valL F M₁' B_U = -(h : ℤ) := by
    have hneg_diff : -(U₀ - B_U) = 0 ∨ -(h : ℤ) ≤ valL F M₁' (-(U₀ - B_U)) := by
      rcases hU₀_BU_diff with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_M₁']; omega
    have hBU_ge_or_0 : B_U = 0 ∨ -(h : ℤ) ≤ valL F M₁' B_U := by
      have hid : U₀ + (-(U₀ - B_U)) = B_U := by ring
      rw [← hid]
      exact hval_add_M₁' (-(h : ℤ)) U₀ (-(U₀ - B_U)) (Or.inr (by rw [hU₀_val])) hneg_diff
    have hnot_hi : ¬ (B_U = 0 ∨ -(h : ℤ) + 1 ≤ valL F M₁' B_U) := by
      intro hhi
      have hdiff_hi : U₀ - B_U = 0 ∨ -(h : ℤ) + 1 ≤ valL F M₁' (U₀ - B_U) :=
        hU₀_BU_diff.imp id (fun hge => by omega)
      have hid : B_U + (U₀ - B_U) = U₀ := by ring
      have hU₀_hi := hval_add_M₁' (-(h : ℤ) + 1) B_U (U₀ - B_U) hhi hdiff_hi
      rw [hid] at hU₀_hi
      rcases hU₀_hi with h0 | hge
      · exact hU₀_ne0 h0
      · rw [hU₀_val] at hge
        omega
    rcases hBU_ge_or_0 with h0 | hge
    · exfalso; exact hnot_hi (Or.inl h0)
    · by_contra hne
      exact hnot_hi (Or.inr (by omega))
  
  have hcondChar_triv : ∀ y : M₁',
      (y = 0 ∨ -condExpChar F M₁' ψM₁' ≤ valL F M₁' y) → ψM₁' y = 1 := by
    set S : Set ℤ := {d' : ℤ | ∀ y : M₁', -d' ≤ valL F M₁' y → ψM₁' y = 1}
    have hne : S.Nonempty := by
      rcases hψM₁'.2 with ⟨d₀, hd₀⟩
      refine ⟨-d₀, fun y hy => hd₀ y ?_⟩
      omega
    have hbdd : BddAbove S := by
      have hne1 : ψM₁' ≠ 1 := hψM₁'.1
      rw [DFunLike.ne_iff] at hne1
      rcases hne1 with ⟨y₀, hy₀⟩
      rw [AddChar.one_apply] at hy₀
      refine ⟨-valL F M₁' y₀ - 1, fun d' hd' => ?_⟩
      by_contra hlt
      have hge : -d' ≤ valL F M₁' y₀ := by omega
      exact hy₀ (hd' y₀ hge)
    have hmem : condExpChar F M₁' ψM₁' ∈ S := Int.csSup_mem hne hbdd
    intro y hy
    rcases hy with rfl | hy
    · exact AddChar.map_zero_eq_one ψM₁'
    · exact hmem y hy
  
  refine ⟨ε₀, x, hε₀_int, hε₀_lt, hx_zero, hx_pos, hBU_val, ?_⟩
  intro z hz_val hz
  set c_νM := IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L))
  have hc_νM_val : valL F M₁' c_νM = -(T : ℤ) - condExpChar F M₁' ψM₁' := by
    change valL F M₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L))) = _
    rw [hval_LM₁', hval_inv_L c_ν, hc_ν_val, hnM₁'_eq]
    ring
  have h2_int : (2 : M₁') = 0 ∨ 0 ≤ valL F M₁' (2 : M₁') := by
    have h11 : (1 : M₁') + 1 = 2 := one_add_one_eq_two
    rw [← h11]
    exact hval_add_M₁' 0 1 1 (Or.inr (by rw [hval1_M₁'])) (Or.inr (by rw [hval1_M₁']))
  have hneg_z_int : -z = 0 ∨ 0 ≤ valL F M₁' (-z) := by
    rcases hz_val with rfl | hge
    · left; exact neg_zero
    · right; rw [hval_neg_M₁']; omega
  have h2_sub_z_int : 2 - z = 0 ∨ 0 ≤ valL F M₁' (2 - z) := by
    rw [sub_eq_add_neg]
    exact hval_add_M₁' 0 2 (-z) h2_int hneg_z_int
  have h2z_quad_val : 2 * z - z ^ 2 = 0 ∨ (d_U : ℤ) ≤ valL F M₁' (2 * z - z ^ 2) := by
    have hfac : 2 * z - z ^ 2 = z * (2 - z) := by ring
    rw [hfac]
    simpa only [add_zero] using hval_mul_bound_M₁' (d_U : ℤ) 0 z (2 - z) hz_val h2_sub_z_int
  set δ_z : M₁' := c_νM * (U₀ - B_U) * (2 * z - z ^ 2)
  have hδ_z_triv : ψM₁' δ_z = 1 := by
    have h1 := hval_mul_bound_M₁' (-(T : ℤ) - condExpChar F M₁' ψM₁') ((T - d_U : ℕ) : ℤ)
      c_νM (U₀ - B_U) (Or.inr (by rw [hc_νM_val])) hU₀_BU_diff
    have h2 : δ_z = 0 ∨
        ((-(T : ℤ) - condExpChar F M₁' ψM₁') + ((T - d_U : ℕ) : ℤ)) + (d_U : ℤ) ≤
          valL F M₁' δ_z :=
      hval_mul_bound_M₁'
        ((-(T : ℤ) - condExpChar F M₁' ψM₁') + ((T - d_U : ℕ) : ℤ)) (d_U : ℤ)
        (c_νM * (U₀ - B_U)) (2 * z - z ^ 2) h1 h2z_quad_val
    apply hcondChar_triv δ_z
    exact h2.imp id (fun hge => by omega)
  have hc_U_inv_eq : ((c_U⁻¹ : M₁'ˣ) : M₁') = c_νM * U₀ := by
    have hmul_cν : IntermediateField.inclusion hLM₁' (c_ν : L) * c_νM = 1 := by
      change IntermediateField.inclusion hLM₁' (c_ν : L) *
        IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) = 1
      rw [← map_mul, Units.mul_inv c_ν, map_one]
    calc ((c_U⁻¹ : M₁'ˣ) : M₁')
      _ = (IntermediateField.inclusion hLM₁' (c_ν : L) * c_νM) * ((c_U⁻¹ : M₁'ˣ) : M₁') := by
          rw [hmul_cν, one_mul]
      _ = c_νM * U₀ := by
          dsimp only [U₀]
          ring
  have hphase_split :
      ((c_U⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2) =
        δ_z + c_νM * B_U * (2 * z - z ^ 2) := by
    rw [hc_U_inv_eq]
    dsimp only [δ_z]
    ring
  rw [hc_U_stat z hz_val hz, hphase_split, AddChar.map_add_eq_mul, hδ_z_triv, one_mul]

theorem ld_wild_odd_unramified_norm_stat_and_frob_descent (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hNonStable : condExp F M₁' θM₁' < 2 * condExp F L νE')
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((condExp F L νE' - condExp F L νE' / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (y₁ : M₁') (hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁') (j₀ : ℕ) (hj₀_pos : 0 < j₀)
    (hj₀_lt : j₀ < Module.finrank L (IntermediateField.extendScalars hLE'))
    (hσ₀_L : ∀ x : L,
      σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hσ₀_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
      ∏ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hFrobTwist : ∀ (r : ℕ) (z : M₁'ˣ),
      θM₁' (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z) =
        ((νE'.comp (Units.map (normLM F hLM₁'))) z) ^ (r * j₀) * θM₁' z)
    (hq_norm_tr_E' : ∀ (h : ℕ) (y : E'),
      (y = 0 ∨
        (((condExp F L νE' +
          Module.finrank L (IntermediateField.extendScalars hLE') * h) / 2 : ℕ) : ℤ) ≤
          valL F E' y) →
      let u := normLM F hLE' (1 + y) - 1
      let q_y := (2 : E')⁻¹ * (2 * y - y ^ 2)
      (2 * u - u ^ 2) - (traceLM F hLE' (2 * y - y ^ 2) + 2 * normLM F hLE' q_y) = 0 ∨
        ((condExp F L νE' + h : ℕ) : ℤ) ≤
          valL F L ((2 * u - u ^ 2) -
            (traceLM F hLE' (2 * y - y ^ 2) + 2 * normLM F hLE' q_y)))
    (hq_norm_tr_K₁ : ∀ (h : ℕ) (w : K₁),
      (w = 0 ∨
        (((condExp F L νE' +
          Module.finrank L (IntermediateField.extendScalars hLE') * h) / 2 : ℕ) : ℤ) ≤
          valL F K₁ w) →
      let u := normLM F hM₁'K₁ (1 + w) - 1
      let q_w := (2 : K₁)⁻¹ * (2 * w - w ^ 2)
      (2 * u - u ^ 2) - (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w) = 0 ∨
        ((condExp F L νE' + h : ℕ) : ℤ) ≤
          valL F M₁' ((2 * u - u ^ 2) -
            (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w)))
    (c_ν₀ : Lˣ)
    (hc_ν₀_val : valL F L (c_ν₀ : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν₀_stat : ∀ u : L,
      (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
          ψ (((c_ν₀⁻¹ : Lˣ) : L) * (2 * u - u ^ 2)))
    (c_U : M₁'ˣ)
    (hc_U_val : valL F M₁' (c_U : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc_U_stat : ∀ z : M₁',
      (z = 0 ∨ ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          (traceChar F hLM₁' ψ) (((c_U⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2)))
    (d : M₁') (hd_val : valL F M₁' d = 0)
    (hd_pow_frob :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let T := condExp F L νE'
      σ₀ (d ^ p) - d ^ p - 1 = 0 ∨
        ((T - T / 2 : ℕ) : ℤ) ≤ valL F M₁' (σ₀ (d ^ p) - d ^ p - 1)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let h := mM₁' - T
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ (c_ν : Lˣ) (ε₀ : L) (x : E'),
      let A := normLM F hLE' x
      let B_U := IntermediateField.inclusion hLM₁' (A + ε₀) + d ^ p
      valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ ∧
      (∀ w : E', (w = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F E' w) →
        ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLE' w + 2 * normLM F hLE' w)) = 1) ∧
      (∀ w : K₁, (w = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F K₁ w) →
        ψM₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) *
          (2 * traceLM F hM₁'K₁ w + 2 * normLM F hM₁'K₁ w)) = 1) ∧
      (∀ (h' : ℕ) (w : K₁),
        (w = 0 ∨ (((T + p * h') / 2 : ℕ) : ℤ) ≤ valL F K₁ w) →
        normLM F hM₁'K₁ (1 + w) - 1 = 0 ∨
          (((T + h') / 2 : ℕ) : ℤ) ≤ valL F M₁' (normLM F hM₁'K₁ (1 + w) - 1)) ∧
      (ε₀ = 0 ∨ 0 ≤ valL F L ε₀) ∧
      (h < T - 1 → ε₀ = 0) ∧
      (h = 0 → (x = 0 ∨ 0 ≤ valL F E' x)) ∧
      (0 < h → x ≠ 0 ∧ valL F E' x = -(h : ℤ) ∧ valL F L A = -(h : ℤ)) ∧
      valL F M₁' B_U = -(h : ℤ) ∧
      (∀ z : M₁', (z = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
            ψM₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) * B_U * (2 * z - z ^ 2))) :=
by
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalE' := ld_valL_and_unitGroup_props F E'
  have haddVal := ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨R_F, hRF_0, hRF_mod1⟩ := haddVal.2.2.2.2.2.2
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hvalL.1 hvalL.2.2.2.1 hvalL.2.2.2.2.1 hvalL.2.2.2.2.2.2.2.1
    haddVal.1 haddVal.2.1 haddVal.2.2.1 haddVal.2.2.2.1
    haddVal.2.2.2.2.1 haddVal.2.2.2.2.2.1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hkL_field, hkL_fin, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L
      hvalL.1 hvalL.2.1 hvalL.2.2.1 hvalL.2.2.2.1 hvalL.2.2.2.2.1
      hvalL.2.2.2.2.2.1 hvalL.2.2.2.2.2.2.2.1 S₁ hS₁
  letI : Field k_L := hkL_field
  letI : Fintype k_L := hkL_fin
  have hRam : condExp F L νE' ≠ 0 := by omega
  obtain ⟨_, _, _, _, _, hfrob_surj, _, _, ϖ_E', ϖ_L, hϖ_norm, hϖ_E', hϖ_L, hBasis⟩ :=
    ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hRam hWild
      haddVal.1 haddVal.2.2.1 haddVal.2.2.2.2.2.1 hvalL hvalE'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨t, w_star, ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm,
    htr_bound_LE'_t, htr_surj_LE', hnorm_exp_LE'⟩ :=
    ld_wild_galois_jump_and_euler_trace_formula F L E' hLE' hGalLE' hPrime hWild
      haddVal.1 haddVal.2.2.2.2.2.1 hvalL hvalE' hval_norm_LE' hval_LE'
      ϖ_E' hϖ_E' hBasis
  obtain ⟨hT_eq_t1, hnorm_le_LE', _, hnorm_surj_lt_LE', _, _⟩ :=
    ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L E' hLE' hPrime νE'
      hνE'_ker hνE'_cond hvalL hvalE' hval_norm_LE' hval_LE' hfrob_surj
      ϖ_E' ϖ_L hϖ_norm hϖ_E' hϖ_L hBasis
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t w_star ht_ge1 hw_star_t hw_star_nt1 hw_star_norm
      htr_bound_LE'_t htr_surj_LE' hnorm_exp_LE'
  have htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)) := by
    intro m y hy
    apply htr_bound_LE'_t m y
    rw [hT_eq_t1] at hy
    exact_mod_cast hy
  obtain ⟨c_ν, hc_ν_val, hc_ν_stat_pow, hquad_LM₁', hc_ν_tr_norm, hc_ν_K₁, hnorm_M₁'K₁_val⟩ :=
    ld_wild_odd_unramified_norm_trace_vanishing_and_val F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd
      ψ hψ hψE' hψM₁' νE' hνE'_ker hbE'_ge2 hnM₁'_eq hnE'_eq hp_val
      hval_LM₁' hval_LE' hval_norm_LE' hval_M₁'K₁ hval_norm_M₁'K₁
      htr_bound_LE' htr_bound_E'K₁
      σ₀ j₀ hj₀_pos hj₀_lt hσ₀_val hσ₀_tr hσ₀_norm
      hq_norm_tr_E' hq_norm_tr_K₁ c_ν₀ hc_ν₀_val hc_ν₀_stat
  obtain ⟨A_star, hA_star_approx, hA_star_zero, hA_star_pos⟩ :=
    ld_wild_odd_unramified_frob_descent_on_m1 F L E' M₁'
      hLE' hLM₁' hp_odd ψ hψ hψM₁' νE' hbE'_ge2 θM₁' hT_le hNonStable
      hnM₁'_eq hval_LM₁' y₁ hy₁_int hy₁_tr σ₀ j₀ hσ₀_L hσ₀_val hσ₀_tr hσ₀_norm
      hFrobTwist c_U hc_U_val hc_U_stat d hd_val hd_pow_frob
      c_ν hc_ν_val hc_ν_stat_pow hquad_LM₁'
  obtain ⟨ε₀, x, hε₀_int, hε₀_lt, hx_zero, hx_pos, hBU_val, hcM₁'_stat⟩ :=
    ld_wild_odd_unramified_herbrand_norm_approx_and_stat F L E' M₁'
      hLE' hLM₁' ψ hψM₁' (condExp F L νE') t ht_ge1 hT_eq_t1
      θM₁' hT_le hNonStable hnM₁'_eq hval_LM₁' hval_norm_LE'
      ϖ_E' ϖ_L hϖ_norm hϖ_E' hϖ_L hnorm_le_LE' hnorm_surj_lt_LE'
      c_U hc_U_val hc_U_stat d hd_val c_ν hc_ν_val
      A_star hA_star_approx hA_star_zero hA_star_pos
  exact ⟨c_ν, ε₀, x, hc_ν_val, hc_ν_tr_norm, hc_ν_K₁, hnorm_M₁'K₁_val,
    hε₀_int, hε₀_lt, hx_zero, hx_pos, hBU_val, hcM₁'_stat⟩

theorem ld_wild_odd_unramified_k1_norm_pullback_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hT_le : T ≤ condExp F M₁' θM₁')
    (hNonStable : condExp F M₁' θM₁' < 2 * T)
    (hmE'_eq : condExp F E' θE' =
      T + Module.finrank L (IntermediateField.extendScalars hLE') * (condExp F M₁' θM₁' - T))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (T : ℤ))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hnorm_lin_E'K₁ : ∀ (d : ℕ), 1 ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w))))
    (hquad_E'K₁ : ∀ (m : ℕ), 1 ≤ m → ∀ w : K₁, (w = 0 ∨ (m : ℤ) ≤ valL F K₁ w) →
      let u_E := normLM F hE'K₁ (1 + w) - 1
      (2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2) = 0 ∨
        (3 * (m : ℤ)) ≤ valL F E' ((2 * u_E - u_E ^ 2) - traceLM F hE'K₁ (2 * w - w ^ 2)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (w₁ : K₁) (hw₁_int : w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) (hw₁_tr : traceLM F hE'K₁ w₁ = 1)
    (hq_norm_tr_K₁ : ∀ (h : ℕ) (w : K₁),
      (w = 0 ∨
        (((T + Module.finrank L (IntermediateField.extendScalars hLE') * h) / 2 : ℕ) : ℤ) ≤
          valL F K₁ w) →
      let u := normLM F hM₁'K₁ (1 + w) - 1
      let q_w := (2 : K₁)⁻¹ * (2 * w - w ^ 2)
      (2 * u - u ^ 2) - (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w) = 0 ∨
        ((T + h : ℕ) : ℤ) ≤
          valL F M₁' ((2 * u - u ^ 2) -
            (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w)))
    (c_E : E'ˣ)
    (hc_E_val : valL F E' (c_E : E') =
      (condExp F E' θE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hc_E_stat : ∀ x : E',
      (x = 0 ∨ ((condExp F E' θE' / 2 : ℕ) : ℤ) ≤ valL F E' x) →
      ∀ hx : 1 + x ≠ 0,
        (θE' (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          (traceChar F hLE' ψ) (((c_E⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2)))
    (c_ν : Lˣ) (c ε₀ : L) (d : M₁') (x : E')
    (hc_ν_val : valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ)
    (hc_ν_K₁ : ∀ w : K₁, (w = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) *
        (2 * traceLM F hM₁'K₁ w + 2 * normLM F hM₁'K₁ w)) = 1)
    (hnorm_M₁'K₁_val : ∀ (h' : ℕ) (w : K₁),
      (w = 0 ∨ (((T + Module.finrank L (IntermediateField.extendScalars hLE') * h') / 2 : ℕ) : ℤ) ≤
        valL F K₁ w) →
      normLM F hM₁'K₁ (1 + w) - 1 = 0 ∨
        (((T + h') / 2 : ℕ) : ℤ) ≤ valL F M₁' (normLM F hM₁'K₁ (1 + w) - 1))
    (hc_val : valL F L c = 0)
    (hd_val : valL F M₁' d = 0)
    (hd_AS : d ^ (Module.finrank L (IntermediateField.extendScalars hLE')) - d -
      IntermediateField.inclusion hLM₁' c = 0 ∨
      (2 * (T : ℤ) + 1) ≤
        valL F M₁' (d ^ (Module.finrank L (IntermediateField.extendScalars hLE')) - d -
          IntermediateField.inclusion hLM₁' c))
    (hε₀_int : ε₀ = 0 ∨ 0 ≤ valL F L ε₀)
    (hε₀_lt : condExp F M₁' θM₁' - T < T - 1 → ε₀ = 0)
    (hx_zero : condExp F M₁' θM₁' - T = 0 → (x = 0 ∨ 0 ≤ valL F E' x))
    (hx_pos : 0 < condExp F M₁' θM₁' - T →
      x ≠ 0 ∧ valL F E' x = -((condExp F M₁' θM₁' - T : ℕ) : ℤ) ∧
