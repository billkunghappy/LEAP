      have hv_ge : ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) ≤ valL F M₁' ((p : ℕ) : M₁') :=
        le_of_mul_le_mul_left hpv hp_pos_z
      have hge2 : (2 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) := by
        have h1 : (2 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by omega
        have h2 : (1 : ℤ) ≤ ((bE' - 1 : ℕ) : ℤ) := by omega
        nlinarith
      have hm₁_sub : (m₁ : ℤ) - 2 * (d₁ : ℤ) ≤ 1 := by
        have : m₁ ≤ 2 * d₁ + 1 := by dsimp [d₁]; omega
        omega
      exact ⟨by omega, by omega⟩
  have hp_val_E' :
      let pE := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
      ((pE : ℕ) : E') = 0 ∨
        ((1 : ℤ) ≤ valL F E' ((pE : ℕ) : E') ∧
