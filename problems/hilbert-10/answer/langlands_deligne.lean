      ⟨K_t, hFtKt, hKtEt, hGal_tKt, hAb_tKt, hFin_tKt, hker, htriv_MC, hne_MC⟩⟩
  obtain ⟨hp_prime, ⟨r_exp, hr_exp_pos, hq_eq⟩, _, _, _, hFrobSurjMC,
      _, _, hValNormK, hValAlgK, hResLiftK,
      _, k, _, hk_ge1, _, hValAlgMCL, _, _, hy₁, _, _, _⟩ :=
    ld_ch14_wild_semidirect_inertia_and_serre_jump F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hGalMCK hMin h_wild hFinE_eq
      D_orb hFinFi hGalFiK hFiMC μ'_orb hμ'_props
  obtain ⟨hMC_decomp, hMC_inter, hu_star⟩ :=
    ld_ch14_wild_semidirect_unitGroup_norm_and_trace_one_nontrivial F L M_C K
