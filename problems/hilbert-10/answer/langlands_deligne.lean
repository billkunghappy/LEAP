            have hdiff_val := hπ_pow_diff (i : ℕ) hi1
            have hmul := hval_mul_ge_K₁ ((p : ℤ) * valL F M₁' (c i)) (((i : ℕ) : ℤ) + (d₁ : ℤ))
              (IntermediateField.inclusion hM₁'K₁ (c i))
              ((σ_lift πK₁) ^ (i : ℕ) - πK₁ ^ (i : ℕ)) hinc_val hdiff_val
            rcases hmul with h0 | hge
            · exact Or.inl h0
            · right
              change m ≤ (p : ℤ) * valL F M₁' (c i) + ((i : ℕ) : ℤ) at hci_ge
              omega
      have hv_inv_val : ((v⁻¹ : K₁ˣ) : K₁) = 0 ∨
          -m ≤ valL F K₁ ((v⁻¹ : K₁ˣ) : K₁) := by
        right
        rw [hval_inv_K₁ v]
      have hw_v_eq : w_v = (σ_lift (v : K₁) - (v : K₁)) * ((v⁻¹ : K₁ˣ) : K₁) := by
        change σ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁) - 1 = _
        rw [sub_mul, Units.mul_inv]
      rw [hw_v_eq]
      have hmul := hval_mul_ge_K₁ (m + (d₁ : ℤ)) (-m)
        (σ_lift (v : K₁) - (v : K₁)) ((v⁻¹ : K₁ˣ) : K₁) hσv_shift hv_inv_val
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right; omega
    · push_neg at hne
      left
      change σ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁) - 1 = 0
      rw [hne (v : K₁), Units.mul_inv, sub_self]

  exact ⟨hConj1, hConj2, hConj3, hConj4⟩

theorem ld_wild_odd_tot_ram_coboundary_char_and_twist_exp_exists (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣
      (condExp F L νM₁' - 1)))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hGalLift_E' : ∀ σ : E' ≃ₐ[F] E',
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      ∃ σ_lift : K₁ ≃ₐ[F] K₁,
        (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ z) ∧
        (∀ y : E', σ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ (σ y)) ∧
        (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hM₁'K₁ (σ_lift w) = normLM F hM₁'K₁ w ∧
          normLM F hE'K₁ (σ_lift w) = σ (normLM F hE'K₁ w)))
    (χ₂ : E'ˣ →* (Ω F)ˣ)
    (hχ₂_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
      (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (c₂₀ : E'ˣ)
    (hc₂₀_val : valL F E' (c₂₀ : E') =
      ((condExp F L νE' + condExp F L νM₁' - 1 : ℕ) : ℤ) +
        condExpChar F E' (traceChar F hLE' ψ))
    (hc₂₀_stat : ∀ x : E',
      (x = 0 ∨ (((condExp F L νE' + condExp F L νM₁' - 1) / 2 : ℕ) : ℤ) ≤ valL F E' x) →
      ∀ hx : 1 + x ≠ 0,
        (χ₂ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          (traceChar F hLE' ψ) (((c₂₀⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2)))
    (Δ₀ : K₁ˣ)
    (hModelCompat_Δ₀ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let m₂ := bE' + bM₁' - 1
      let d₁ := m₁ / 2
      let d₂ := m₂ / 2
      valL F E' (normLM F hE'K₁ (Δ₀ : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) ∧
      ∀ w : K₁, (w = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w) →
        let u₁ := normLM F hM₁'K₁ (1 + w) - 1
        let u₂ := normLM F hE'K₁ (1 + w) - 1
        (u₁ = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' u₁) ∧
        (u₂ = 0 ∨ (d₂ : ℤ) ≤ valL F E' u₂) ∧
        (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((c_νE'⁻¹ : Lˣ) : L)) *
          normLM F hM₁'K₁ (Δ₀ : K₁) * (2 * u₁ - u₁ ^ 2)) =
        (traceChar F hLE' ψ) (IntermediateField.inclusion hLE' (((c_νE'⁻¹ : Lˣ) : L)) *
          normLM F hE'K₁ (Δ₀ : K₁) * (2 * u₂ - u₂ ^ 2)))
    (hCoker_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := condExp F L νM₁' - 1
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      ∀ (Φ₀ : E'ˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F E' (t₁ + 1), Φ₀ u = 1) →
        (∀ w : K₁ˣ, Φ₀ (Units.map (normLM F hE'K₁) w) = 1) →
        (∃ u₁ ∈ unitGroup F E' t₁, Φ₀ u₁ ≠ 1) →
        ∃ j < p, 0 < j ∧ ∀ y : E'ˣ, (ξE' y) ^ 2 = (Φ₀ y) ^ j)
    (hτ₀_exists : ∃ τ₀ : E' ≃ₐ[F] E',
      (∀ x : L, τ₀ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
      ∃ y₀ : E', τ₀ y₀ ≠ y₀)
    (hψE'_α₀_triv :
      let bE' := condExp F L νE'
      let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      ∀ Z : E', (Z = 0 ∨ (bE' : ℤ) ≤ valL F E' Z) →
        ψE' (IntermediateField.inclusion hLE' α₀ * Z) = 1)
    (hσ_props :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let t₂ := bE' - 1
      let m₂ := bE' + bM₁' - 1
      let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      ∀ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∀ y : E',
          valL F E' (σ y) = valL F E' y ∧
          normLM F hLE' (σ y) = normLM F hLE' y ∧
          ψE' (σ y) = ψE' y) ∧
        (∀ y : E'ˣ,
          let w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
          (w_y = 0 ∨ (t₂ : ℤ) ≤ valL F E' w_y) ∧
          normLM F hLE' (1 + w_y) - 1 = 0) ∧
        (∀ u ∈ unitGroup F E' bM₁',
          let w_u := ((((Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹ : E'ˣ) : E')) - 1
          w_u = 0 ∨ (m₂ : ℤ) ≤ valL F E' w_u) ∧
        ((∃ y₀ : E', σ y₀ ≠ y₀) →
          ∀ (r : ℕ), 1 ≤ r → ¬ (p ∣ r) →
            ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
              ¬ (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y) →
              ∃ u₁ ∈ unitGroup F E' r,
                let w₁ := ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E')) - 1
                ψE' (IntermediateField.inclusion hLE' α₀ * Y * (2 * w₁ - w₁ ^ 2)) ≠ 1 ∧
                (ψE' (IntermediateField.inclusion hLE' α₀ * Y * (2 * w₁ - w₁ ^ 2))) ^ p = 1))
    (hσ_lift_props :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let d₁ := m₁ / 2
      ∀ σ_lift : K₁ ≃ₐ[F] K₁,
        (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ z) →
        (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) →
        ∀ v : K₁ˣ,
          let w_v := ((((Units.map σ_lift.toRingEquiv.toMonoidHom v) * v⁻¹ : K₁ˣ) : K₁)) - 1
          w_v = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w_v) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bM₁' := condExp F L νM₁'
    let t₁ := bM₁' - 1
    let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    let a₀ := normLM F hE'K₁ (Δ₀ : K₁)
    let B₂ := IntermediateField.inclusion hLE' (c_νE' : L) * ((c₂₀⁻¹ : E'ˣ) : E')
    valL F E' B₂ = -(t₁ : ℤ) ∧
    ∃ (j : ℕ) (σ : E' ≃ₐ[F] E'),
      0 < j ∧ j < p ∧
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
      (∃ y₀ : E', σ y₀ ≠ y₀) ∧
      (∀ y : E'ˣ,
        let w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
        ψE' (IntermediateField.inclusion hLE' α₀ * (B₂ + (j : E') * a₀) *
          (2 * w_y - w_y ^ 2)) = 1) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set bE' := condExp F L νE'
  set bM₁' := condExp F L νM₁'
  set t₁ := bM₁' - 1
  set t₂ := bE' - 1
  set m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  set m₂ := bE' + bM₁' - 1
  set d₁ := m₁ / 2
  set d₂ := m₂ / 2
  set α₀ := ((c_νE'⁻¹ : Lˣ) : L)
  set ψE' := traceChar F hLE' ψ
  set ξE' := νM₁'.comp (Units.map (normLM F hLE'))
  set a₀ := normLM F hE'K₁ (Δ₀ : K₁)
  set B₂ := IntermediateField.inclusion hLE' (c_νE' : L) * ((c₂₀⁻¹ : E'ˣ) : E')
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
    _, hval_add_E', _, _, _⟩ := hvalE'_props
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hc_νE'_ne0 : IntermediateField.inclusion hLE' (c_νE' : L) ≠ 0 :=
    (IntermediateField.inclusion hLE').injective.ne (Units.ne_zero c_νE')
  have hc₂₀_inv_ne0 : ((c₂₀⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero c₂₀⁻¹
  have hB₂_val : valL F E' B₂ = -(t₁ : ℤ) := by
    rw [hval_mul_E' _ _ hc_νE'_ne0 hc₂₀_inv_ne0, hval_LE' (c_νE' : L),
      hc_νE'_val, hval_inv_E' c₂₀, hc₂₀_val, hnE'_eq]
    have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    have hm₂_cast : ((bE' + bM₁' - 1 : ℕ) : ℤ) = (bE' : ℤ) + (bM₁' : ℤ) - 1 := by omega
    have ht₁_cast : (t₁ : ℤ) = (bM₁' : ℤ) - 1 := by omega
    rw [hp_sub, hm₂_cast, ht₁_cast]
    ring
  let u_ψE' : E' → (Ω F)ˣ := fun x =>
    ⟨ψE' x, ψE' (-x),
      by rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one],
      by rw [← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one]⟩
  have hu_ψE'_zero : u_ψE' 0 = 1 := Units.ext (AddChar.map_zero_eq_one ψE')
  have hu_ψE'_add : ∀ x y : E', u_ψE' (x + y) = u_ψE' x * u_ψE' y :=
    fun x y => Units.ext (AddChar.map_add_eq_mul ψE' x y)
  have hu_ψE'_neg : ∀ x : E', u_ψE' (-x) = (u_ψE' x)⁻¹ := by
    intro x
    apply mul_left_cancel (a := u_ψE' x)
    rw [← hu_ψE'_add, add_neg_cancel, hu_ψE'_zero, mul_inv_cancel]
  have hu_ψE'_eq_one : ∀ x : E', u_ψE' x = 1 ↔ ψE' x = 1 :=
    fun x => ⟨fun h => congrArg Units.val h, fun h => Units.ext h⟩
  have hu_ψE'_pow : ∀ (k : ℕ) (x : E'), (u_ψE' x) ^ k = u_ψE' ((k : E') * x) := by
    intro k x
    induction k with
    | zero => simp [hu_ψE'_zero]
    | succ k ih =>
      rw [pow_succ, ih, Nat.cast_add, Nat.cast_one, right_distrib, one_mul, hu_ψE'_add]
  have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : E'),
      (x = 0 ∨ k₁ ≤ valL F E' x) → (y = 0 ∨ k₂ ≤ valL F E' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F E' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rcases hx with rfl | hx_ge
        · contradiction
        · rcases hy with rfl | hy_ge
          · contradiction
          · rw [hval_mul_E' x y hx0 hy0]
            linarith
  have hval_neg_ge : ∀ (k : ℤ) (x : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (-x = 0 ∨ k ≤ valL F E' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx_ge
    · exact Or.inl neg_zero
    · right
      rw [hval_neg_E' x]
      exact hx_ge
  have hval_ge_mono : ∀ (k₁ k₂ : ℤ) (x : E'),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F E' x) → (x = 0 ∨ k₁ ≤ valL F E' x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx_ge
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx_ge)
  have hquad_val : ∀ (k : ℤ), 0 ≤ k → ∀ w : E',
      (w = 0 ∨ k ≤ valL F E' w) →
      (2 * w - w ^ 2 = 0 ∨ k ≤ valL F E' (2 * w - w ^ 2)) := by
    intro k hk w hw
    have h2w : w + w = 0 ∨ k ≤ valL F E' (w + w) := hval_add_E' k w w hw hw
    have hww : w * w = 0 ∨ k + k ≤ valL F E' (w * w) := hval_mul_ge k k w w hw hw
    have hww_k : w * w = 0 ∨ k ≤ valL F E' (w * w) :=
      hval_ge_mono k (k + k) (w * w) (by linarith) hww
    have hnww : -(w * w) = 0 ∨ k ≤ valL F E' (-(w * w)) := hval_neg_ge k (w * w) hww_k
    have hsum := hval_add_E' k (w + w) (-(w * w)) h2w hnww
    have heq : (w + w) + -(w * w) = 2 * w - w ^ 2 := by ring
    rw [heq] at hsum
    exact hsum
  have ha₀_val : valL F E' a₀ = -(t₁ : ℤ) := hModelCompat_Δ₀.1
  have ha₀_ge : a₀ = 0 ∨ -(t₁ : ℤ) ≤ valL F E' a₀ := Or.inr (le_of_eq ha₀_val.symm)
  have hrem_val : ∀ w₁ w₂ : E',
      (w₁ = 0 ∨ (t₂ : ℤ) ≤ valL F E' w₁) →
      (w₂ = 0 ∨ (t₂ : ℤ) ≤ valL F E' w₂) →
      (a₀ * w₁ * w₂ * (2 * w₁ + 2 * w₂ + w₁ * w₂) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (a₀ * w₁ * w₂ * (2 * w₁ + 2 * w₂ + w₁ * w₂))) := by
    intro w₁ w₂ hw₁ hw₂
    have ht₂_nonneg : (0 : ℤ) ≤ (t₂ : ℤ) := by omega
    have h2w₁ : w₁ + w₁ = 0 ∨ (t₂ : ℤ) ≤ valL F E' (w₁ + w₁) := hval_add_E' (t₂ : ℤ) w₁ w₁ hw₁ hw₁
    have h2w₂ : w₂ + w₂ = 0 ∨ (t₂ : ℤ) ≤ valL F E' (w₂ + w₂) := hval_add_E' (t₂ : ℤ) w₂ w₂ hw₂ hw₂
    have hw₁₂ : w₁ * w₂ = 0 ∨ (t₂ : ℤ) + (t₂ : ℤ) ≤ valL F E' (w₁ * w₂) :=
      hval_mul_ge (t₂ : ℤ) (t₂ : ℤ) w₁ w₂ hw₁ hw₂
    have hw₁₂_t₂ : w₁ * w₂ = 0 ∨ (t₂ : ℤ) ≤ valL F E' (w₁ * w₂) :=
      hval_ge_mono (t₂ : ℤ) ((t₂ : ℤ) + (t₂ : ℤ)) (w₁ * w₂) (by linarith) hw₁₂
    have hsum1 := hval_add_E' (t₂ : ℤ) (w₁ + w₁) (w₂ + w₂) h2w₁ h2w₂
    have hsum2 := hval_add_E' (t₂ : ℤ) ((w₁ + w₁) + (w₂ + w₂)) (w₁ * w₂) hsum1 hw₁₂_t₂
    have heq_inner : (w₁ + w₁) + (w₂ + w₂) + w₁ * w₂ = 2 * w₁ + 2 * w₂ + w₁ * w₂ := by ring
    rw [heq_inner] at hsum2
    have hprod1 := hval_mul_ge (-(t₁ : ℤ)) (t₂ : ℤ) a₀ w₁ ha₀_ge hw₁
    have hprod2 := hval_mul_ge (-(t₁ : ℤ) + (t₂ : ℤ)) (t₂ : ℤ) (a₀ * w₁) w₂ hprod1 hw₂
    have hprod3 := hval_mul_ge (-(t₁ : ℤ) + (t₂ : ℤ) + (t₂ : ℤ)) (t₂ : ℤ)
      (a₀ * w₁ * w₂) (2 * w₁ + 2 * w₂ + w₁ * w₂) hprod2 hsum2
    exact hval_ge_mono (bE' : ℤ) (-(t₁ : ℤ) + (t₂ : ℤ) + (t₂ : ℤ) + (t₂ : ℤ))
      (a₀ * w₁ * w₂ * (2 * w₁ + 2 * w₂ + w₁ * w₂)) (by omega) hprod3
  have hΦ_coker : ∀ τ : E' ≃ₐ[F] E',
      (∀ x : L, τ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      (∃ y₀ : E', τ y₀ ≠ y₀) →
      let w_τ : E'ˣ → E' := fun y =>
        ((((Units.map τ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
      let Φ_fn : E'ˣ → (Ω F)ˣ := fun y =>
        u_ψE' (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_τ y - (w_τ y) ^ 2)))
      (∃ u₁ ∈ unitGroup F E' t₁, Φ_fn u₁ ≠ 1 ∧ (Φ_fn u₁) ^ p = 1) ∧
      (∃ j < p, 0 < j ∧ ∀ y : E'ˣ, (ξE' y) ^ 2 = (Φ_fn y) ^ j) := by
    intro τ hτ_L hτ_ne
    dsimp only
    set w_τ : E'ˣ → E' := fun y =>
      ((((Units.map τ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
    set Φ_fn : E'ˣ → (Ω F)ˣ := fun y =>
      u_ψE' (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_τ y - (w_τ y) ^ 2)))
    obtain ⟨_, hτ_w_t₂, hτ_w_m₂, hτ_nondiv⟩ := hσ_props τ hτ_L
    have hw_τ_mul : ∀ y₁ y₂ : E'ˣ, w_τ (y₁ * y₂) = w_τ y₁ + w_τ y₂ + w_τ y₁ * w_τ y₂ := by
      intro y₁ y₂
      dsimp only [w_τ]
      have hmap : (((Units.map τ.toRingEquiv.toMonoidHom (y₁ * y₂)) * (y₁ * y₂)⁻¹ : E'ˣ) : E') =
          ((((Units.map τ.toRingEquiv.toMonoidHom y₁) * y₁⁻¹ : E'ˣ) : E')) *
            ((((Units.map τ.toRingEquiv.toMonoidHom y₂) * y₂⁻¹ : E'ˣ) : E')) := by
        rw [map_mul, mul_inv, mul_mul_mul_comm, Units.val_mul]
      rw [hmap]
      ring
    have hΦ_mul : ∀ y₁ y₂ : E'ˣ, Φ_fn (y₁ * y₂) = Φ_fn y₁ * Φ_fn y₂ := by
      intro y₁ y₂
      dsimp only [Φ_fn]
      rw [hw_τ_mul y₁ y₂]
      set w₁ := w_τ y₁
      set w₂ := w_τ y₂
      have hring : - (IntermediateField.inclusion hLE' α₀ * a₀ *
            (2 * (w₁ + w₂ + w₁ * w₂) - (w₁ + w₂ + w₁ * w₂) ^ 2)) =
          ((- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w₁ - w₁ ^ 2))) +
            (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w₂ - w₂ ^ 2)))) +
          IntermediateField.inclusion hLE' α₀ *
            (a₀ * w₁ * w₂ * (2 * w₁ + 2 * w₂ + w₁ * w₂)) := by ring
      rw [hring, hu_ψE'_add, hu_ψE'_add]
      have hrem1 : u_ψE' (IntermediateField.inclusion hLE' α₀ *
          (a₀ * w₁ * w₂ * (2 * w₁ + 2 * w₂ + w₁ * w₂))) = 1 :=
        (hu_ψE'_eq_one _).mpr (hψE'_α₀_triv _ (hrem_val w₁ w₂ (hτ_w_t₂ y₁).1 (hτ_w_t₂ y₂).1))
      rw [hrem1, mul_one]
    let Φ_τ : E'ˣ →* (Ω F)ˣ := MonoidHom.mk' Φ_fn hΦ_mul
    have hΦ_triv_t₁_add1 : ∀ u ∈ unitGroup F E' (t₁ + 1), Φ_τ u = 1 := by
      intro u hu
      have ht₁_add1 : t₁ + 1 = bM₁' := by omega
      rw [ht₁_add1] at hu
      have hw_u : w_τ u = 0 ∨ (m₂ : ℤ) ≤ valL F E' (w_τ u) := hτ_w_m₂ u hu
      have hq_u := hquad_val (m₂ : ℤ) (by omega) (w_τ u) hw_u
      have hprod_u := hval_mul_ge (-(t₁ : ℤ)) (m₂ : ℤ) a₀ (2 * w_τ u - (w_τ u) ^ 2) ha₀_ge hq_u
      have hneg_u := hval_neg_ge (-(t₁ : ℤ) + (m₂ : ℤ)) (a₀ * (2 * w_τ u - (w_τ u) ^ 2)) hprod_u
      have hge_bE' := hval_ge_mono (bE' : ℤ) (-(t₁ : ℤ) + (m₂ : ℤ))
        (- (a₀ * (2 * w_τ u - (w_τ u) ^ 2))) (by omega) hneg_u
      change u_ψE' (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_τ u - (w_τ u) ^ 2))) = 1
      have hring_u : - (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_τ u - (w_τ u) ^ 2)) =
          IntermediateField.inclusion hLE' α₀ * (- (a₀ * (2 * w_τ u - (w_τ u) ^ 2))) := by ring
      rw [hring_u, hu_ψE'_eq_one]
      exact hψE'_α₀_triv _ hge_bE'
    have hΦ_triv_norm : ∀ v : K₁ˣ, Φ_τ (Units.map (normLM F hE'K₁) v) = 1 := by
      intro v
      obtain ⟨τ_lift, hτ_lift_M₁', _, hτ_lift_val, hτ_lift_norm⟩ := hGalLift_E' τ hτ_L
      set w_v : K₁ := ((((Units.map τ_lift.toRingEquiv.toMonoidHom v) * v⁻¹ : K₁ˣ) : K₁)) - 1
      have hw_v : w_v = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w_v :=
        hσ_lift_props τ_lift hτ_lift_M₁' hτ_lift_val v
      have h1_wv : 1 + w_v = τ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁) := by
        dsimp only [w_v]
        change 1 + ((τ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁)) - 1) =
          τ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁)
        ring
      have hinv_v : (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁) = 1 := v.val_inv
      have hu₁_zero : normLM F hM₁'K₁ (1 + w_v) - 1 = 0 := by
        rw [h1_wv, map_mul, (hτ_lift_norm (v : K₁)).1, ← map_mul, hinv_v, map_one, sub_self]
      have hu₂_eq : normLM F hE'K₁ (1 + w_v) - 1 = w_τ (Units.map (normLM F hE'K₁) v) := by
        rw [h1_wv, map_mul, (hτ_lift_norm (v : K₁)).2]
        rfl
      have hmc := (hModelCompat_Δ₀.2 w_v hw_v).2.2
      rw [hu₁_zero, hu₂_eq] at hmc
      have h0_arg : IntermediateField.inclusion hLM₁' α₀ *
          normLM F hM₁'K₁ (Δ₀ : K₁) * (2 * (0 : M₁') - (0 : M₁') ^ 2) = 0 := by ring
      rw [h0_arg, AddChar.map_zero_eq_one] at hmc
      have hu_pos : u_ψE' (IntermediateField.inclusion hLE' α₀ * a₀ *
          (2 * w_τ (Units.map (normLM F hE'K₁) v) - (w_τ (Units.map (normLM F hE'K₁) v)) ^ 2)) = 1 :=
        (hu_ψE'_eq_one _).mpr hmc.symm
      change u_ψE' (- (IntermediateField.inclusion hLE' α₀ * a₀ *
        (2 * w_τ (Units.map (normLM F hE'K₁) v) - (w_τ (Units.map (normLM F hE'K₁) v)) ^ 2))) = 1
      rw [hu_ψE'_neg, hu_pos, inv_one]
    have hna₀_val : valL F E' (-a₀) = -(t₁ : ℤ) := by
      rw [hval_neg_E' a₀, ha₀_val]
    have hna₀_ge : -a₀ = 0 ∨ -(t₁ : ℤ) ≤ valL F E' (-a₀) :=
      Or.inr (le_of_eq hna₀_val.symm)
    have hna₀_not_gt : ¬ (-a₀ = 0 ∨ -(t₁ : ℤ) + 1 ≤ valL F E' (-a₀)) := by
      rintro (h0 | hgt)
      · have hval0 : valL F E' (-a₀) = 0 := by rw [h0, hval0_E']
        omega
      · omega
    obtain ⟨u₁, hu₁_mem, hu₁_ne1, hu₁_pow_p⟩ :=
      hτ_nondiv hτ_ne t₁ (by omega) ht₁_ndvd (-a₀) hna₀_ge hna₀_not_gt
    have harg_u₁ : IntermediateField.inclusion hLE' α₀ * (-a₀) * (2 * w_τ u₁ - (w_τ u₁) ^ 2) =
        - (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_τ u₁ - (w_τ u₁) ^ 2)) := by ring
    have hΦ_u₁_ne1 : Φ_fn u₁ ≠ 1 := by
      intro h1
      apply hu₁_ne1
      change ψE' (IntermediateField.inclusion hLE' α₀ * (-a₀) * (2 * w_τ u₁ - (w_τ u₁) ^ 2)) = 1
      rw [harg_u₁]
      exact (hu_ψE'_eq_one _).mp h1
    have hΦ_u₁_pow_p : (Φ_fn u₁) ^ p = 1 := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val]
      change (ψE' (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_τ u₁ - (w_τ u₁) ^ 2)))) ^ p = 1
      rw [← harg_u₁]
      exact hu₁_pow_p
    refine ⟨⟨u₁, hu₁_mem, hΦ_u₁_ne1, hΦ_u₁_pow_p⟩, ?_⟩
    exact hCoker_E' Φ_τ hΦ_triv_t₁_add1 hΦ_triv_norm ⟨u₁, hu₁_mem, hΦ_u₁_ne1⟩
  obtain ⟨τ₀, hτ₀_L, hτ₀_ne⟩ := hτ₀_exists
  obtain ⟨⟨u₁, _, hu₁_ne1, hu₁_pow_p⟩, ⟨j₀, hj₀_lt, hj₀_pos, hξ_τ₀⟩⟩ :=
    hΦ_coker τ₀ hτ₀_L hτ₀_ne
  set w_τ₀ : E'ˣ → E' := fun y =>
    ((((Units.map τ₀.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
  set Φ_τ₀_u₁ : (Ω F)ˣ :=
    u_ψE' (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_τ₀ u₁ - (w_τ₀ u₁) ^ 2)))
  have hΦ_pow_j₀_ne1 : Φ_τ₀_u₁ ^ j₀ ≠ 1 := by
    intro hpow_j₀
    have hdvd_j₀ : orderOf Φ_τ₀_u₁ ∣ j₀ := orderOf_dvd_of_pow_eq_one hpow_j₀
    have hdvd_p : orderOf Φ_τ₀_u₁ ∣ p := orderOf_dvd_of_pow_eq_one hu₁_pow_p
    have hdvd_gcd : orderOf Φ_τ₀_u₁ ∣ p.gcd j₀ := Nat.dvd_gcd hdvd_p hdvd_j₀
    have hcop : p.Coprime j₀ :=
      (Nat.Prime.coprime_iff_not_dvd hPrime).2 (Nat.not_dvd_of_pos_of_lt hj₀_pos hj₀_lt)
    rw [Nat.Coprime.gcd_eq_one hcop] at hdvd_gcd
    have hord1 : orderOf Φ_τ₀_u₁ = 1 := Nat.eq_one_of_dvd_one hdvd_gcd
    exact hu₁_ne1 (orderOf_eq_one_iff.mp hord1)
  have hξ_u₁_ne1 : ξE' u₁ ≠ 1 := by
    intro hξ1
    apply hΦ_pow_j₀_ne1
    have hsq := hξ_τ₀ u₁
    change (ξE' u₁) ^ 2 = Φ_τ₀_u₁ ^ j₀ at hsq
    rw [← hsq, hξ1, one_pow]
  obtain ⟨_, _, σ, hσ_L, hσ_twist⟩ := hχ₂_twists 1 hp_gt1
  have hσ_ne : ∃ y₀ : E', σ y₀ ≠ y₀ := by
    refine ⟨(u₁ : E'), ?_⟩
    intro hfix
    have hmap_eq : Units.map σ.toRingEquiv.toMonoidHom u₁ = u₁ := Units.ext hfix
    have htw := hσ_twist u₁
    change (ξE' u₁) ^ 1 * χ₂ u₁ = χ₂ (Units.map σ.toRingEquiv.toMonoidHom u₁) at htw
    rw [pow_one, hmap_eq] at htw
    have hξ1 : ξE' u₁ = 1 := by
      have hmul := congrArg (· * (χ₂ u₁)⁻¹) htw
      dsimp only at hmul
      rw [mul_inv_cancel_right, mul_inv_cancel] at hmul
      exact hmul
    exact hξ_u₁_ne1 hξ1
  obtain ⟨_, ⟨j, hj_lt, hj_pos, hξ_σ⟩⟩ := hΦ_coker σ hσ_L hσ_ne
  have hc₂₀_inv_eq : ((c₂₀⁻¹ : E'ˣ) : E') = IntermediateField.inclusion hLE' α₀ * B₂ := by
    dsimp only [B₂, α₀]
    rw [← mul_assoc, ← map_mul]
    have hinv_mul : ((c_νE'⁻¹ : Lˣ) : L) * (c_νE' : L) = 1 := c_νE'.inv_val
    rw [hinv_mul, map_one, one_mul]
  refine ⟨hB₂_val, j, σ, hj_pos, hj_lt, hσ_L, hσ_ne, ?_⟩
  intro y
  set u_y : E'ˣ := (Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹
  set w_y : E' := (u_y : E') - 1
  have hξ_eq_χ₂ : ξE' y = χ₂ u_y := by
    have htw := hσ_twist y
    change (ξE' y) ^ 1 * χ₂ y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y) at htw
    rw [pow_one] at htw
    dsimp only [u_y]
    rw [map_mul, map_inv, ← htw, mul_inv_cancel_right]
  have hw_y_t₂ : w_y = 0 ∨ (t₂ : ℤ) ≤ valL F E' w_y :=
    ((hσ_props σ hσ_L).2.1 y).1
  have hw_y_d₂ : w_y = 0 ∨ (d₂ : ℤ) ≤ valL F E' w_y :=
    hval_ge_mono (d₂ : ℤ) (t₂ : ℤ) w_y (by omega) hw_y_t₂
  have h1_add_wy : 1 + w_y = (u_y : E') := by
    dsimp only [w_y]
    ring
  have hx : 1 + w_y ≠ 0 := by
    rw [h1_add_wy]
    exact Units.ne_zero u_y
  have hmk0_eq : Units.mk0 (1 + w_y) hx = u_y := by
    apply Units.ext
    rw [Units.val_mk0, h1_add_wy]
  have hstat := hc₂₀_stat w_y hw_y_d₂ hx
  rw [hmk0_eq, ← hξ_eq_χ₂, hc₂₀_inv_eq] at hstat
  have hξ_sq_u : (ξE' y) ^ 2 =
      u_ψE' (IntermediateField.inclusion hLE' α₀ * B₂ * (2 * w_y - w_y ^ 2)) := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val]
    exact hstat
  have hξ_σ_y : (ξE' y) ^ 2 =
      (u_ψE' (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_y - w_y ^ 2)))) ^ j :=
    hξ_σ y
  rw [hu_ψE'_pow, hξ_sq_u] at hξ_σ_y
  have hmul_eq := congrArg
    (· * u_ψE' (IntermediateField.inclusion hLE' α₀ * (j : E') * a₀ * (2 * w_y - w_y ^ 2)))
    hξ_σ_y
  dsimp only at hmul_eq
  rw [← hu_ψE'_add, ← hu_ψE'_add] at hmul_eq
  have hring_lhs : IntermediateField.inclusion hLE' α₀ * B₂ * (2 * w_y - w_y ^ 2) +
      IntermediateField.inclusion hLE' α₀ * (j : E') * a₀ * (2 * w_y - w_y ^ 2) =
      IntermediateField.inclusion hLE' α₀ * (B₂ + (j : E') * a₀) * (2 * w_y - w_y ^ 2) := by ring
  have hring_rhs : (j : E') * (- (IntermediateField.inclusion hLE' α₀ * a₀ * (2 * w_y - w_y ^ 2))) +
      IntermediateField.inclusion hLE' α₀ * (j : E') * a₀ * (2 * w_y - w_y ^ 2) = 0 := by ring
  rw [hring_lhs, hring_rhs, hu_ψE'_zero] at hmul_eq
  exact (hu_ψE'_eq_one _).mp hmul_eq

theorem ld_wild_odd_tot_ram_as_peeling_descent_and_shift_realization (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣
      (condExp F L νM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) *
          (condExp F L νE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (χ₂ : E'ˣ →* (Ω F)ˣ)
    (c_νE' : Lˣ)
    (c₂₀ : E'ˣ)
    (hc₂₀_stat : ∀ x : E',
      (x = 0 ∨ (((condExp F L νE' + condExp F L νM₁' - 1) / 2 : ℕ) : ℤ) ≤ valL F E' x) →
      ∀ hx : 1 + x ≠ 0,
        (χ₂ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          (traceChar F hLE' ψ) (((c₂₀⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2)))
    (Δ₀ : K₁ˣ)
    (ha₀_val : valL F E' (normLM F hE'K₁ (Δ₀ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hAS_shift : ∀ w₀ : E',
      (w₀ = 0 ∨ -(((condExp F L νM₁' - 1) /
        Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : ℤ) ≤ valL F E' w₀) →
      ∃ Δ' : K₁ˣ,
        let p := Module.finrank L (IntermediateField.extendScalars hLE')
        let m₁ := 2 * condExp F L νM₁' - 1 + p * (condExp F L νE' - condExp F L νM₁')
        valL F K₁ (Δ' : K₁) = -((condExp F L νM₁' - 1 : ℕ) : ℤ) ∧
        ((Δ' : K₁) ^ p - (Δ' : K₁) -
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁)) = 0 ∨
          ((4 * p * p * m₁ : ℕ) : ℤ) ≤
            valL F K₁ ((Δ' : K₁) ^ p - (Δ' : K₁) -
              IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁)))) ∧
        (normLM F hE'K₁ (Δ' : K₁) - (normLM F hE'K₁ (Δ₀ : K₁) + w₀ ^ p - w₀) = 0 ∨
          ((3 * p * m₁ : ℕ) : ℤ) ≤
            valL F E' (normLM F hE'K₁ (Δ' : K₁) -
              (normLM F hE'K₁ (Δ₀ : K₁) + w₀ ^ p - w₀))))
    (hShift_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let t₁ := condExp F L νM₁' - 1
      let h₀ := t₁ / p
      let m₂ := bE' + condExp F L νM₁' - 1
      let d₂ := m₂ / 2
      let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      (∀ w₀ : E', (w₀ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₀) →
        ∀ x : E', (x = 0 ∨ (d₂ : ℤ) ≤ valL F E' x) →
          let u_x := normLM F hLE' (1 + x) - 1
          (u_x = 0 ∨ (d₂ : ℤ) ≤ valL F L u_x) ∧
