          (hdegM₁.symm ▸ hνM₁_pow) (fun u hu => (hν_triv1 u hu).2) hνM₁_cond_eq hcondM₁1 hχM₁_triv1
          hResDeg_M₁ hValAlg_M₁ hCondψM₁ hResSurj_M₁ k_L resL hresL_0 hresL_1 hresL_ring
          hresL_ker hresL_surj c₁ hc₁_val hval_all hSpec_all hGauss_all
      obtain ⟨htate_M₁χ_raw, hprod_νM₁_raw⟩ := hEval_M₁_all ψ_k hψ_k_int
      have hν_kM₁_pow : ν_kM₁ ^ ℓ = 1 := by rwa [hdegM₁] at hν_kM₁_pow_raw
      have htate_M₁1 : tateEps F M₁ 1 ψM₁ = (qL F L : Ω F) ^ ((ℓ : ℤ) * (n_L + 1) - 1) := by
