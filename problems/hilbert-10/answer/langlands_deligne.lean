        have hk2 : 2 * ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) ≤
            (k : ℤ) * ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) := by
          have hnonneg : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) := by positivity
          have hk_z : (2 : ℤ) ≤ (k : ℤ) := by omega
          have hmul := mul_le_mul_of_nonneg_right hk_z hnonneg
          linarith
        have hp_lt : (p : ℤ) * ((m_B - 1 : ℕ) : ℤ) < (p : ℤ) * valL F B (c k (p + s)) := by
          linarith
        have hlt' := lt_of_mul_lt_mul_left hp_lt (by omega : (0 : ℤ) ≤ (p : ℤ))
        omega
  have hPB_S_approx :
      P_B S - ∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * t_pow m = 0 ∨
        (m_B : ℤ) ≤ valL F B (P_B S - ∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * t_pow m) := by
    have hPB_S_eq :
        P_B S - ∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * t_pow m =
          ∑ k ∈ Finset.Icc 1 (p - 1),
            ((k : ℕ) : B)⁻¹ * (∑ s ∈ Finset.range ((p - 1) * (p - 1)), c k (p + s)) := by
      rw [← hW_eq]
      dsimp only [P_B, S]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun k hk => ?_
      rw [hc_pow_split k hk]
      ring
    rw [hPB_S_eq]
    refine hvalB_sum (Finset.Icc 1 (p - 1)) _ (m_B : ℤ) fun k hk => ?_
    have hkinv : ((k : ℕ) : B)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F B (((k : ℕ) : B)⁻¹) := by
      right; rw [hj_inv_val k hk]
    have htail_k : (∑ s ∈ Finset.range ((p - 1) * (p - 1)), c k (p + s)) = 0 ∨
        (m_B : ℤ) ≤ valL F B (∑ s ∈ Finset.range ((p - 1) * (p - 1)), c k (p + s)) :=
      hvalB_sum (Finset.range ((p - 1) * (p - 1))) (fun s => c k (p + s)) (m_B : ℤ) (hc_tail k hk)
    rcases hvalB_mul_bound (((k : ℕ) : B)⁻¹) _ 0 (m_B : ℤ) hkinv htail_k with h0 | hle
    · left; exact h0
    · right; omega
  
  have hbinom_term : ∀ (k : ℕ), 2 ≤ k → ((k : ℕ) : B) ≠ 0 →
      ((k : ℕ) : B)⁻¹ * (S + N_w) ^ k - ((k : ℕ) : B)⁻¹ * S ^ k -
        ((k : ℕ) : B)⁻¹ * N_w ^ k - S * N_w ^ (k - 1) =
        ((k : ℕ) : B)⁻¹ * ∑ m ∈ Finset.Icc 2 (k - 1),
          S ^ m * N_w ^ (k - m) * (k.choose m : B) := by
    intro k hk hk_ne0
    have hk_split : k + 1 = 2 + (k - 2) + 1 := by omega
    have hpow := add_pow S N_w k
    rw [hk_split, Finset.sum_range_succ, Finset.sum_range_add] at hpow
    have h_range2 : (∑ x ∈ Finset.range 2, S ^ x * N_w ^ (k - x) * (k.choose x : B)) =
        N_w ^ k + S * N_w ^ (k - 1) * ((k : ℕ) : B) := by
      rw [Finset.sum_range_succ, Finset.sum_range_one]
      simp [Nat.choose_zero_right, Nat.choose_one_right]
    have h_top : S ^ (2 + (k - 2)) * N_w ^ (k - (2 + (k - 2))) * (k.choose (2 + (k - 2)) : B) = S ^ k := by
      have h2k : 2 + (k - 2) = k := by omega
      rw [h2k, Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one, mul_one]
    have h_mid : (∑ x ∈ Finset.range (k - 2), S ^ (2 + x) * N_w ^ (k - (2 + x)) * (k.choose (2 + x) : B)) =
        ∑ m ∈ Finset.Icc 2 (k - 1), S ^ m * N_w ^ (k - m) * (k.choose m : B) := by
      have hIcc : Finset.Icc 2 (k - 1) = Finset.Ico 2 (k - 1 + 1) := rfl
      rw [hIcc, Finset.sum_Ico_eq_sum_range]
      have h1 : k - 1 + 1 - 2 = k - 2 := by omega
      rw [h1]
    rw [h_range2, h_top, h_mid] at hpow
    rw [hpow]
    have h_inv : ((k : ℕ) : B)⁻¹ * ((k : ℕ) : B) = 1 := inv_mul_cancel₀ hk_ne0
    calc ((k : ℕ) : B)⁻¹ * (N_w ^ k + S * N_w ^ (k - 1) * ((k : ℕ) : B) +
            ∑ m ∈ Finset.Icc 2 (k - 1), S ^ m * N_w ^ (k - m) * (k.choose m : B) + S ^ k) -
          ((k : ℕ) : B)⁻¹ * S ^ k - ((k : ℕ) : B)⁻¹ * N_w ^ k - S * N_w ^ (k - 1)
        = S * N_w ^ (k - 1) * (((k : ℕ) : B)⁻¹ * ((k : ℕ) : B) - 1) +
          ((k : ℕ) : B)⁻¹ * ∑ m ∈ Finset.Icc 2 (k - 1), S ^ m * N_w ^ (k - m) * (k.choose m : B) := by
          ring
      _ = ((k : ℕ) : B)⁻¹ * ∑ m ∈ Finset.Icc 2 (k - 1), S ^ m * N_w ^ (k - m) * (k.choose m : B) := by
          rw [h_inv, sub_self, mul_zero, zero_add]
  have hPB_binom :
      P_B (S + N_w) - P_B S - P_B N_w - (∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j) = 0 ∨
        (m_B : ℤ) ≤ valL F B
          (P_B (S + N_w) - P_B S - P_B N_w - (∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j)) := by
    have hIcc_split : Finset.Icc 1 (p - 1) = insert 1 (Finset.Icc 2 (p - 1)) := by
      ext k
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    have h1_not_mem : (1 : ℕ) ∉ Finset.Icc 2 (p - 1) := by
      simp only [Finset.mem_Icc]
      omega
    have hsum_reindex :
        (∑ k ∈ Finset.Icc 2 (p - 1), S * N_w ^ (k - 1)) =
          ∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j := by
      have hIcc1 : Finset.Icc 2 (p - 1) = Finset.Ico 2 (p - 1 + 1) := rfl
      have hIcc2 : Finset.Icc 1 (p - 2) = Finset.Ico 1 (p - 2 + 1) := rfl
      rw [hIcc1, hIcc2, Finset.sum_Ico_eq_sum_range, Finset.sum_Ico_eq_sum_range]
      have hlen : p - 1 + 1 - 2 = p - 2 + 1 - 1 := by omega
      rw [hlen]
      refine Finset.sum_congr rfl fun x _ => ?_
      have hx : 2 + x - 1 = 1 + x := by omega
      rw [hx]
    have hPB_binom_eq :
        P_B (S + N_w) - P_B S - P_B N_w - (∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j) =
          ∑ k ∈ Finset.Icc 2 (p - 1),
            (((k : ℕ) : B)⁻¹ * (S + N_w) ^ k - ((k : ℕ) : B)⁻¹ * S ^ k -
              ((k : ℕ) : B)⁻¹ * N_w ^ k - S * N_w ^ (k - 1)) := by
      dsimp only [P_B]
      rw [← hsum_reindex, hIcc_split,
        Finset.sum_insert h1_not_mem, Finset.sum_insert h1_not_mem, Finset.sum_insert h1_not_mem,
        Finset.sum_sub_distrib, Finset.sum_sub_distrib, Finset.sum_sub_distrib]
      simp only [Nat.cast_one, inv_one, one_mul, pow_one]
      ring
    rw [hPB_binom_eq]
    refine hvalB_sum (Finset.Icc 2 (p - 1)) _ (m_B : ℤ) fun k hk => ?_
    obtain ⟨hk2, hk_ub⟩ := Finset.mem_Icc.mp hk
    have hk1 : k ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hk_ub⟩
    rw [hbinom_term k hk2 (hj_ne0 k hk1)]
    have hkinv : ((k : ℕ) : B)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F B (((k : ℕ) : B)⁻¹) := by
      right; rw [hj_inv_val k hk1]
    have hmid_val :
        (∑ m ∈ Finset.Icc 2 (k - 1), S ^ m * N_w ^ (k - m) * (k.choose m : B)) = 0 ∨
          (m_B : ℤ) ≤ valL F B
            (∑ m ∈ Finset.Icc 2 (k - 1), S ^ m * N_w ^ (k - m) * (k.choose m : B)) := by
      refine hvalB_sum (Finset.Icc 2 (k - 1)) _ (m_B : ℤ) fun m hm => ?_
      obtain ⟨hm2, hm_ub⟩ := Finset.mem_Icc.mp hm
      have hSm : S ^ m = 0 ∨ 2 * (e₁ : ℤ) ≤ valL F B (S ^ m) := by
        rcases hvalB_pow_ge1 S (e₁ : ℤ) m (by omega) hS_e1 with h0 | hle
        · left; exact h0
        · right
          have hm_ge2 : 2 * (e₁ : ℤ) ≤ (m : ℤ) * (e₁ : ℤ) :=
            mul_le_mul_of_nonneg_right (by omega) (Nat.cast_nonneg e₁)
          exact le_trans hm_ge2 hle
      have hNwm : N_w ^ (k - m) = 0 ∨ (q₁ : ℤ) ≤ valL F B (N_w ^ (k - m)) := by
        rcases hvalB_pow_ge1 N_w (q₁ : ℤ) (k - m) (by omega) hNw_val with h0 | hle
        · left; exact h0
        · right
          have hkm_ge1 : 1 * (q₁ : ℤ) ≤ ((k - m : ℕ) : ℤ) * (q₁ : ℤ) :=
            mul_le_mul_of_nonneg_right (by omega) (Nat.cast_nonneg q₁)
          linarith
      have hprod1 := hvalB_mul_bound (S ^ m) (N_w ^ (k - m)) (2 * (e₁ : ℤ)) (q₁ : ℤ) hSm hNwm
      have hchoose := hvalB_natCast (k.choose m)
      rcases hvalB_mul_bound _ _ (2 * (e₁ : ℤ) + (q₁ : ℤ)) 0 hprod1 hchoose with h0 | hle
      · left; exact h0
      · right
        have hmB_le : (m_B : ℤ) ≤ 2 * (e₁ : ℤ) + (q₁ : ℤ) := by exact_mod_cast hm_B_le_2e1_q1
        omega
    rcases hvalB_mul_bound (((k : ℕ) : B)⁻¹) _ 0 (m_B : ℤ) hkinv hmid_val with h0 | hle
    · left; exact h0
    · right; omega
  
  have hCross_approx :
      (∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j) -
        (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
          ((r : ℕ) : B)⁻¹ * t_pow r * N_w ^ j) = 0 ∨
      (m_B : ℤ) ≤ valL F B
        ((∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j) -
          (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
            ((r : ℕ) : B)⁻¹ * t_pow r * N_w ^ j)) := by
    rw [← Finset.sum_sub_distrib]
    refine hvalB_sum (Finset.Icc 1 (p - 2)) _ (m_B : ℤ) fun j hj => ?_
    obtain ⟨hj1, _⟩ := Finset.mem_Icc.mp hj
    have hSN_eq : S * N_w ^ j = ∑ r ∈ Finset.Icc 1 (p - 1), b r * N_w ^ j := by
      dsimp only [S]
      exact Finset.sum_mul _ _ _
    rw [hSN_eq, ← Finset.sum_sub_distrib]
    refine hvalB_sum (Finset.Icc 1 (p - 1)) _ (m_B : ℤ) fun r hr => ?_
    obtain ⟨hr1, hr_ub⟩ := Finset.mem_Icc.mp hr
    have hr_inv : ((r : ℕ) : B)⁻¹ * ((r : ℕ) : B) = 1 := inv_mul_cancel₀ (hj_ne0 r hr)
    have hbr_newton : b r * N_w ^ j - ((r : ℕ) : B)⁻¹ * t_pow r * N_w ^ j =
        - (((r : ℕ) : B)⁻¹ * (∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l)) * N_w ^ j) := by
      rw [h_newton r hr]
      calc b r * N_w ^ j - ((r : ℕ) : B)⁻¹ * (((r : ℕ) : B) * b r +
              ∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l)) * N_w ^ j
          = (1 - ((r : ℕ) : B)⁻¹ * ((r : ℕ) : B)) * b r * N_w ^ j -
              ((r : ℕ) : B)⁻¹ * (∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l)) * N_w ^ j := by
            ring
        _ = - (((r : ℕ) : B)⁻¹ * (∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l)) * N_w ^ j) := by
            rw [hr_inv, sub_self, zero_mul, zero_mul, zero_sub]
    rw [hbr_newton]
    have hrinv_val : ((r : ℕ) : B)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F B (((r : ℕ) : B)⁻¹) := by
      right; rw [hj_inv_val r hr]
    have hsum_l :
        (∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l)) = 0 ∨
          2 * (e₁ : ℤ) ≤ valL F B (∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l)) := by
      refine hvalB_sum (Finset.Icc 1 (r - 1)) _ (2 * (e₁ : ℤ)) fun l hl => ?_
      obtain ⟨hl1, hl_ub⟩ := Finset.mem_Icc.mp hl
      have hl_mem : l ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hl1, by omega⟩
      have hrl_mem : r - l ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      rcases hvalB_mul_bound (b l) (t_pow (r - l)) (e₁ : ℤ) (e₁ : ℤ)
        (hb_e1 l hl_mem) (ht_e1 (r - l) hrl_mem) with h0 | hle
      · left; exact h0
      · right; omega
    have hNwj : N_w ^ j = 0 ∨ (q₁ : ℤ) ≤ valL F B (N_w ^ j) := by
      rcases hvalB_pow_ge1 N_w (q₁ : ℤ) j hj1 hNw_val with h0 | hle
      · left; exact h0
      · right
        have hj_ge1 : 1 * (q₁ : ℤ) ≤ (j : ℤ) * (q₁ : ℤ) :=
          mul_le_mul_of_nonneg_right (by omega) (Nat.cast_nonneg q₁)
        linarith
    have hprod1 := hvalB_mul_bound (((r : ℕ) : B)⁻¹) _ 0 (2 * (e₁ : ℤ)) hrinv_val hsum_l
    rcases hvalB_mul_bound _ (N_w ^ j) (0 + 2 * (e₁ : ℤ)) (q₁ : ℤ) hprod1 hNwj with h0 | hle
    · left; rw [h0, neg_zero]
    · right
      rw [hvalB_neg]
      have hmB_le : (m_B : ℤ) ≤ 2 * (e₁ : ℤ) + (q₁ : ℤ) := by exact_mod_cast hm_B_le_2e1_q1
      omega
  have hE_first :
      (∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * (t_pow m + N_w ^ m)) =
        (∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * t_pow m) + P_B N_w := by
    dsimp only [P_B]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun m _ => mul_add _ _ _
  have hfinal_id :
      P_B (S + N_w) - E_val =
        (P_B (S + N_w) - P_B S - P_B N_w - (∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j)) +
        ((P_B S - ∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * t_pow m) +
          ((∑ j ∈ Finset.Icc 1 (p - 2), S * N_w ^ j) -
            (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
              ((r : ℕ) : B)⁻¹ * t_pow r * N_w ^ j))) := by
    dsimp only [E_val]
    rw [hE_first]
    ring
  have hConj2 : P_B (S + N_w) - E_val = 0 ∨ (m_B : ℤ) ≤ valL F B (P_B (S + N_w) - E_val) := by
    rw [hfinal_id]
    exact hvalB_add (m_B : ℤ) _ _ hPB_binom (hvalB_add (m_B : ℤ) _ _ hPB_S_approx hCross_approx)
  exact ⟨hConj1, hConj2⟩

theorem ld_ch12_wild_odd_totally_ramified_upper_edge_trunc_log_norm_expansion (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hBK : B ≤ K₁) (hGalBK : IsGaloisExt F B K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hWild : p = EllipticRootNumber.p F)
    (hp_odd : EllipticRootNumber.p F ≠ 2)
    (hdegBK : Module.finrank B (IntermediateField.extendScalars hBK) = p)
    (T q₁ q_B m_B : ℕ)
    (hT_ge2 : 2 ≤ T) (hq_B_ge1 : 1 ≤ q_B) (hq_B_le_q₁ : q_B ≤ q₁) (hq_B_le_m_B : q_B ≤ m_B)
    (h_filt : p * q_B ≤ q₁ + (p - 1) * T)
    (h_exp : p * (m_B - 1) + 1 ≤ p * q₁ + 2 * (p - 1) * (T - 1))
    (hval_BK : ∀ x : B, valL F K₁ (IntermediateField.inclusion hBK x) = (p : ℤ) * valL F B x)
    (hval_norm_BK : ∀ w : K₁, valL F B (normLM F hBK w) = valL F K₁ w)
    (htr_BK : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ valL F K₁ w) →
      (traceLM F hBK w = 0 ∨ m ≤ valL F B (traceLM F hBK w))) :
    let P_B := fun z : B => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : B)⁻¹ * z ^ j
    let E_B := fun w : K₁ =>
      (∑ m ∈ Finset.Icc 1 (p - 1),
        ((m : ℕ) : B)⁻¹ * (traceLM F hBK (w ^ m) + (normLM F hBK w) ^ m)) +
      (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
        ((r : ℕ) : B)⁻¹ * traceLM F hBK (w ^ r) * (normLM F hBK w) ^ j)
    (∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
      let u_B := 1 - normLM F hBK (1 - w)
      (u_B = 0 ∨ (q_B : ℤ) ≤ valL F B u_B) ∧
      (P_B u_B - E_B w = 0 ∨ (m_B : ℤ) ≤ valL F B (P_B u_B - E_B w))) ∧
    (∀ w : K₁, (w = 0 ∨ ((p * m_B : ℕ) : ℤ) ≤ valL F K₁ w) →
      let u_B := 1 - normLM F hBK (1 - w)
      (u_B = 0 ∨ (m_B : ℤ) ≤ valL F B u_B) ∧
      (P_B u_B = 0 ∨ (m_B : ℤ) ≤ valL F B (P_B u_B))) :=
by
  intro P_B E_B
  have hvalB_props := ld_valL_and_unitGroup_props F B
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  have hp_ne2 : p ≠ 2 := hWild ▸ hp_odd
  have hPrime_BK : Nat.Prime (Module.finrank B (IntermediateField.extendScalars hBK)) :=
    hdegBK.symm ▸ hPrime
  have hp_odd_BK : Module.finrank B (IntermediateField.extendScalars hBK) ≠ 2 :=
    hdegBK.symm ▸ hp_ne2
  have hval_BK' : ∀ x : B,
      valL F K₁ (IntermediateField.inclusion hBK x) =
        (Module.finrank B (IntermediateField.extendScalars hBK) : ℤ) * valL F B x := by
    intro x
    rw [hdegBK]
    exact hval_BK x
  have hT_ge1 : 1 ≤ T := by omega
  have htr_BK' : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank B (IntermediateField.extendScalars hBK) : ℤ) * m -
          ((Module.finrank B (IntermediateField.extendScalars hBK) - 1 : ℕ) : ℤ) *
            (T : ℤ) ≤ valL F K₁ w) →
      (traceLM F hBK w = 0 ∨ m ≤ valL F B (traceLM F hBK w)) := by
    intro m w hw
    rw [hdegBK] at hw
    exact htr_BK m w hw
  obtain ⟨s, hs1, hs2, hs_val_raw, hs_norm_one_add_raw, hs_cayley, hs_newton1_raw⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton
      F B K₁ hBK hGalBK hPrime_BK hp_odd_BK hvalB_props hvalK₁_props
      hval_BK' hval_norm_BK T hT_ge1 htr_BK'
      (fun t htr_t G _ _ act hcard h1 hmul hring hincl hval htr hnorm =>
        ld_wild_odd_free_orbit_symm_functions
          F B K₁ hBK hPrime_BK hp_odd_BK hvalK₁_props t htr_t
          G act hcard h1 hmul hring hincl hval htr hnorm)
      (fun G _ _ act s₀ hcard h1 hring hincl hnorm hpoly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton
          F B K₁ hBK hPrime_BK hp_odd_BK hvalB_props hvalK₁_props hval_BK'
          G act hcard h1 hring hincl hnorm s₀ hpoly)
  have hs_val : ∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * q →
        (s w r = 0 ∨ m ≤ valL F B (s w r)) := by
    have h := hs_val_raw
    rw [hdegBK] at h
    exact h
  have hs_norm_one_add : ∀ w : K₁,
      normLM F hBK (1 + w) - 1 =
        (∑ r ∈ Finset.Icc 1 (p - 1), s w r) + normLM F hBK w := by
    have h := hs_norm_one_add_raw
    rw [hdegBK] at h
    exact h
  have hs_newton1 : ∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      (-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s w r - traceLM F hBK (w ^ r) =
        - ∑ j ∈ Finset.Icc 1 (r - 1),
            (-1 : B) ^ (j - 1) * s w j * traceLM F hBK (w ^ (r - j)) := by
    have h := hs_newton1_raw
    rw [hdegBK] at h
    exact h
  obtain ⟨hj_B, hBridge, hDeep⟩ :=
    ld_ch12_wild_odd_upper_edge_symm_bridge_and_deep_filt
      F B K₁ hBK p hPrime hWild hp_odd hdegBK T q₁ m_B hT_ge2
      hval_norm_BK htr_BK s hs_val hs_norm_one_add hs_newton1
  refine ⟨?_, hDeep⟩
  intro w hw u_B
  obtain ⟨huB_eq, h_newton, hb_e1, ht_e1, hb_scaled, hNw_val⟩ := hBridge w hw
  let b : ℕ → B := fun r => - s (-w) r
  let t_pow : ℕ → B := fun r => traceLM F hBK (w ^ r)
  let N_w : B := normLM F hBK w
  obtain ⟨c, hc_zero, hc_succ, hc_one_ge, hc_pow_split, hW_eq⟩ :=
    ld_ch12_wild_odd_upper_edge_newton_girard_conv_poly_id
      B p hPrime hp_ne2 (fun j hj => (hj_B j hj).1) b t_pow h_newton
  obtain ⟨h1, h2⟩ :=
    ld_ch12_wild_odd_upper_edge_conv_tail_and_cross_term_bound
      F B p T q₁ q_B m_B hPrime hp_ne2 hT_ge2 hq_B_ge1 hq_B_le_q₁ hq_B_le_m_B
      h_filt h_exp (fun j hj => (hj_B j hj).1) (fun j hj => (hj_B j hj).2)
      b t_pow N_w h_newton hb_e1 ht_e1 hb_scaled hNw_val
      c hc_zero hc_succ hc_one_ge hc_pow_split hW_eq
  have h1' : u_B = 0 ∨ (q_B : ℤ) ≤ valL F B u_B := by
    change (1 - normLM F hBK (1 - w)) = 0 ∨ (q_B : ℤ) ≤ valL F B (1 - normLM F hBK (1 - w))
    rw [huB_eq]
    exact h1
  have h2' : P_B u_B - E_B w = 0 ∨ (m_B : ℤ) ≤ valL F B (P_B u_B - E_B w) := by
    change P_B (1 - normLM F hBK (1 - w)) - E_B w = 0 ∨
      (m_B : ℤ) ≤ valL F B (P_B (1 - normLM F hBK (1 - w)) - E_B w)
    rw [huB_eq]
    exact h2
  exact ⟨h1', h2'⟩

theorem ld_ch12_wild_odd_tot_ram_teichmuller_units_and_c_pow_char_bridge (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (t₁ : ℕ) (ht₁_ge1 : 1 ≤ t₁)
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_1 : valL F E' 1 = 0)
    (hψ_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hTeich :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := condExp F L νE' + t₁
      ((p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L)) →
      ∀ (τ_unit τ_tilde : ℕ → Lˣ),
        (∀ j < p, 0 < j →
          (τ_tilde j : L) = (j : L) ^ (p ^ b) ∧
          τ_unit j = (τ_tilde j) ^ p) →
        (∀ j < p, 0 < j →
          (τ_unit j : L) ^ (p - 1) - 1 = 0 ∨
            (b + 1 : ℤ) ≤ valL F L ((τ_unit j : L) ^ (p - 1) - 1)) ∧
        (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
          (∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
            (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
            (b + 1 : ℤ) ≤
              valL F L
                ((∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
                  (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let q_p := (bE' + p - 1) / p
    let α := ((c_νE'⁻¹ : Lˣ) : L)
    (∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : L) ≠ 0 ∧ valL F L (((j : ℕ) : L)⁻¹) = 0) ∧
    ∃ τ_unit : ℕ → Lˣ,
      (∀ c ∈ (Finset.range p).erase 0,
        ((τ_unit c : L) - (c : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((τ_unit c : L) - (c : L))) ∧
        ∃ k_c : ℕ, c * c ^ (p - 2) = 1 + p * k_c) ∧
      (∀ c ∈ (Finset.range p).erase 0,
        valL F L (τ_unit c : L) = 0 ∧
        valL F L (((τ_unit c)⁻¹ : Lˣ) : L) = 0 ∧
        ((τ_unit c : L) ^ (p - 1) - 1 = 0 ∨
          ((bE' + t₁ + 1 : ℕ) : ℤ) ≤ valL F L ((τ_unit c : L) ^ (p - 1) - 1))) ∧
      (∀ A ∈ Finset.Icc 1 (2 * (p - 1)),
        ¬ ((p - 1) ∣ A) →
        (∑ c ∈ (Finset.range p).erase 0, (τ_unit c : L) ^ A) = 0 ∨
          ((bE' + t₁ + 1 : ℕ) : ℤ) ≤
            valL F L (∑ c ∈ (Finset.range p).erase 0, (τ_unit c : L) ^ A)) ∧
      (∀ y : L, (y = 0 ∨ (bE' : ℤ) ≤ valL F L y) → ψ (2 * α * y) = 1) ∧
      (∀ c ∈ (Finset.range p).erase 0,
        ∀ v : L, (v = 0 ∨ (q_p : ℤ) ≤ valL F L v) →
          (ψ (2 * α * v)) ^ (c ^ (p - 2)) =
            ψ (2 * α * ((((τ_unit c)⁻¹ : Lˣ) : L) * v))) :=
by
  intro p bE' q_p α
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL_props
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ne2 : p ≠ 2 := by
    change Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2
    rw [hWild]
    exact hp_odd
  have hp_ge3 : 3 ≤ p := by
    have h2 : 2 ≤ p := hPrime.two_le
    omega
  have hp1_ne0 : p - 1 ≠ 0 := by omega
  have hbE'_ge2' : 2 ≤ bE' := hbE'_ge2
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    rcases hx with rfl | hx
    · left; simp
    · rcases hy with rfl | hy
      · left; simp
      · by_cases hx0 : x = 0
        · left; simp [hx0]
        · by_cases hy0 : y = 0
          · left; simp [hy0]
          · right
            rw [hval_mul_L x y hx0 hy0]
            omega
  have hval_sub_L : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    apply hval_add_L k x₁ (-x₂) hx₁
    rcases hx₂ with rfl | hx₂
    · left; simp
    · right; rwa [hval_neg_L]
  have hval_mono_L : ∀ (k₁ k₂ : ℤ) (x : L),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx
    · left; rfl
    · right; exact le_trans hle hx
  have hunit_of_gt0_L : ∀ x : L,
      (x = 0 ∨ (1 : ℤ) ≤ valL F L x) → 1 + x ≠ 0 ∧ valL F L (1 + x) = 0 := by
    intro x hx
    have h1x_ne0 : 1 + x ≠ 0 := by
      intro h0
      rcases hx with rfl | hx
      · rw [add_zero] at h0
        exact one_ne_zero h0
      · have hx_neg1 : x = -1 := by linear_combination h0
        rw [hx_neg1, hval_neg1_L] at hx
        omega
    refine ⟨h1x_ne0, ?_⟩
    let u_x : Lˣ := Units.mk0 (1 + x) h1x_ne0
    have hu_sub : (u_x : L) - 1 = x := by
      dsimp [u_x]
      ring
    have hu_mem : u_x ∈ unitGroup F L 1 := by
      rw [hunit_ge1_L 1 le_rfl u_x, hu_sub]
      rcases hx with rfl | hx
      · left; dsimp [u_x]; ring
      · right; exact hx
    exact hunit_val0_L 1 u_x hu_mem
  have hnat_int_L : ∀ n : ℕ, (n : L) = 0 ∨ 0 ≤ valL F L (n : L) := by
    intro n
    induction n with
    | zero => left; simp
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_L 0 (n : L) 1 ih (Or.inr (le_of_eq hval1_L.symm))
  have hint_int_L : ∀ z : ℤ, (z : L) = 0 ∨ 0 ≤ valL F L (z : L) := by
    intro z
    cases z with
    | ofNat n =>
      rw [Int.ofNat_eq_natCast, Int.cast_natCast]
      exact hnat_int_L n
    | negSucc n =>
      rw [Int.cast_negSucc]
      rcases hnat_int_L (n + 1) with h0 | hge
      · left; simp [h0]
      · right; rwa [hval_neg_L]
  
  let m_p : ℕ := bE' - q_p
  have hqp_div_mod := Nat.div_add_mod (bE' + p - 1) p
  have hqp_mod_lt : (bE' + p - 1) % p < p := Nat.mod_lt (bE' + p - 1) hp_pos
  have hp_qp_ge : bE' ≤ p * q_p := by
    change bE' ≤ p * ((bE' + p - 1) / p)
    omega
  have hp_qp_le : p * q_p ≤ bE' + p - 1 := by
    change p * ((bE' + p - 1) / p) ≤ bE' + p - 1
    omega
  have hp1_bE' : (p - 1) * 2 ≤ (p - 1) * bE' := Nat.mul_le_mul_left (p - 1) hbE'_ge2'
  have hqp_lt_bE' : q_p < bE' := by
    by_contra hge
    have hle : bE' ≤ q_p := by omega
    have hmul : p * bE' ≤ p * q_p := Nat.mul_le_mul_left p hle
    have h_p_bE' : p * bE' = (p - 1) * bE' + bE' := by
      have hp1 : p = (p - 1) + 1 := by omega
      conv_lhs => arg 1; rw [hp1]
      ring
    omega
  have hqp_ge1 : 1 ≤ q_p := by
    rcases Nat.eq_zero_or_pos q_p with h0 | hpos
    · rw [h0, mul_zero] at hp_qp_ge
      omega
    · exact hpos
  have hmp_ge1 : 1 ≤ m_p := by dsimp [m_p]; omega
  have hmp_add_qp : m_p + q_p = bE' := by dsimp [m_p]; omega
  have hmp_add_qp_int : (m_p : ℤ) + (q_p : ℤ) = (bE' : ℤ) := by exact_mod_cast hmp_add_qp
  have htr_ineq_mp : (p : ℤ) * (m_p : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ 0 := by
    have hmp_int : (m_p : ℤ) = (bE' : ℤ) - (q_p : ℤ) := by omega
    have hp1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    have hp_qp_ge_int : (bE' : ℤ) ≤ (p : ℤ) * (q_p : ℤ) := by exact_mod_cast hp_qp_ge
    calc
      (p : ℤ) * (m_p : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ)
        = (p : ℤ) * ((bE' : ℤ) - (q_p : ℤ)) - ((p : ℤ) - 1) * (bE' : ℤ) := by
            rw [hmp_int, hp1_int]
      _ = (bE' : ℤ) - (p : ℤ) * (q_p : ℤ) := by ring
      _ ≤ 0 := by omega
  
  have htr_one : traceLM F hLE' (1 : E') = ((p : ℕ) : L) := by
    change Algebra.trace L (IntermediateField.extendScalars hLE')
      (toExtendScalars F hLE' (1 : E')) = ((p : ℕ) : L)
    have h1 : toExtendScalars F hLE' (1 : E') =
        algebraMap L (IntermediateField.extendScalars hLE') (1 : L) := by
      rw [map_one, map_one]
    rw [h1, Algebra.trace_algebraMap (1 : L), nsmul_one]
  have hp_val_mp : ((p : ℕ) : L) = 0 ∨ (m_p : ℤ) ≤ valL F L ((p : ℕ) : L) := by
    have h := htr_LE' (m_p : ℤ) (1 : E') (Or.inr (by rw [hvalE'_1]; exact htr_ineq_mp))
    rwa [htr_one] at h
  have hp_val1 : ((p : ℕ) : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((p : ℕ) : L) :=
    hval_mono_L 1 (m_p : ℤ) ((p : ℕ) : L) (by exact_mod_cast hmp_ge1) hp_val_mp
  
  have hzmod_eq_imp_val_mp : ∀ z₁ z₂ : ℤ,
      ((z₁ : ℤ) : ZMod p) = ((z₂ : ℤ) : ZMod p) →
        (z₁ : L) - (z₂ : L) = 0 ∨ (m_p : ℤ) ≤ valL F L ((z₁ : L) - (z₂ : L)) := by
    intro z₁ z₂ hz
    have hdvd : (p : ℤ) ∣ (z₁ - z₂) :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub z₂ z₁ p).mp hz.symm
    rcases hdvd with ⟨k, hk⟩
    have hk_L : (z₁ : L) - (z₂ : L) = ((p : ℕ) : L) * (k : L) := by
      have h1 := congrArg (Int.cast : ℤ → L) hk
      push_cast at h1
      exact h1
    rw [hk_L]
    have h := hval_mul_ge_L (m_p : ℤ) 0 ((p : ℕ) : L) (k : L) hp_val_mp (hint_int_L k)
    simpa using h
  
  have hj_props : ∀ j < p, 0 < j →
      ((j : ℕ) : L) ≠ 0 ∧
      valL F L ((j : ℕ) : L) = 0 ∧
      valL F L (((j : ℕ) : L)⁻¹) = 0 ∧
      ∃ k_j : ℕ, j * j ^ (p - 2) = 1 + p * k_j := by
    intro j hj_lt hj_pos
    have hndvd : ¬ (p ∣ j) := Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
    have hj_zmod : (j : ZMod p) ≠ 0 := by
      rwa [Ne, ZMod.natCast_eq_zero_iff]
    have hfermat : (j : ZMod p) ^ (p - 1) = 1 := ZMod.pow_card_sub_one_eq_one hj_zmod
    have hfermat_nat : ((j ^ (p - 1) : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) := by
      push_cast
      exact hfermat
    have hmod_eq : j ^ (p - 1) % p = 1 % p :=
      (ZMod.natCast_eq_natCast_iff (j ^ (p - 1)) 1 p).mp hfermat_nat
    rw [Nat.mod_eq_of_lt hp_gt1] at hmod_eq
    let k_j : ℕ := j ^ (p - 1) / p
    have hdiv : p * k_j + 1 = j ^ (p - 1) := by
      have h := Nat.div_add_mod (j ^ (p - 1)) p
      rw [hmod_eq] at h
      exact h
    have hp_sub1 : p - 1 = (p - 2) + 1 := by omega
    have hpow_j : j ^ (p - 1) = j * j ^ (p - 2) := by
      rw [hp_sub1, pow_succ']
    have hk_j : j * j ^ (p - 2) = 1 + p * k_j := by omega
    have hdiv_L : ((j : ℕ) : L) ^ (p - 1) = 1 + ((p : ℕ) : L) * (k_j : L) := by
      have h1 := congrArg (Nat.cast : ℕ → L) hdiv.symm
      push_cast at h1
      linear_combination h1
    have hpk_val : ((p : ℕ) : L) * (k_j : L) = 0 ∨
        (1 : ℤ) ≤ valL F L (((p : ℕ) : L) * (k_j : L)) := by
      have h := hval_mul_ge_L 1 0 ((p : ℕ) : L) (k_j : L) hp_val1 (hnat_int_L k_j)
      simpa using h
    have hjp1_unit := hunit_of_gt0_L (((p : ℕ) : L) * (k_j : L)) hpk_val
    rw [← hdiv_L] at hjp1_unit
    have hj_ne0 : ((j : ℕ) : L) ≠ 0 := by
      intro h0
      apply hjp1_unit.1
      rw [h0, zero_pow hp1_ne0]
    have hj_val0 : valL F L ((j : ℕ) : L) = 0 := by
      have hpow := hval_pow_L ((j : ℕ) : L) (p - 1) hj_ne0
      rw [hjp1_unit.2] at hpow
      have hp1_ge2 : (2 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by omega
      nlinarith
    let u_j : Lˣ := Units.mk0 ((j : ℕ) : L) hj_ne0
    have hj_inv_val0 : valL F L (((j : ℕ) : L)⁻¹) = 0 := by
      change valL F L ((u_j⁻¹ : Lˣ) : L) = 0
      rw [hval_inv_L u_j]
      change -valL F L ((j : ℕ) : L) = 0
      rw [hj_val0, neg_zero]
    exact ⟨hj_ne0, hj_val0, hj_inv_val0, ⟨k_j, hk_j⟩⟩
  have hj_inv : ∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : L) ≠ 0 ∧ valL F L (((j : ℕ) : L)⁻¹) = 0 := by
    intro j hj
    rcases Finset.mem_Icc.mp hj with ⟨hj_ge1, hj_le⟩
    have hj_lt : j < p := by omega
    have hj_pos : 0 < j := by omega
    exact ⟨(hj_props j hj_lt hj_pos).1, (hj_props j hj_lt hj_pos).2.2.1⟩
  
  let b : ℕ := bE' + t₁
  let u_nat : ℕ → Lˣ := fun c =>
    if h : ((c : ℕ) : L) ≠ 0 then Units.mk0 ((c : ℕ) : L) h else 1
  let τ_tilde : ℕ → Lˣ := fun c => (u_nat c) ^ (p ^ b)
  let τ_unit : ℕ → Lˣ := fun c => (τ_tilde c) ^ p
  have hu_nat_coe : ∀ c < p, 0 < c → (u_nat c : L) = (c : L) := by
    intro c hc_lt hc_pos
    dsimp [u_nat]
    rw [dif_pos (hj_props c hc_lt hc_pos).1, Units.val_mk0]
  have hτ_tilde_coe : ∀ c < p, 0 < c → (τ_tilde c : L) = (c : L) ^ (p ^ b) := by
    intro c hc_lt hc_pos
    change (u_nat c : L) ^ (p ^ b) = (c : L) ^ (p ^ b)
    rw [hu_nat_coe c hc_lt hc_pos]
  have hτ_unit_coe : ∀ c < p, 0 < c → (τ_unit c : L) = (c : L) ^ (p ^ (b + 1)) := by
    intro c hc_lt hc_pos
    change (τ_tilde c : L) ^ p = (c : L) ^ (p ^ (b + 1))
    rw [hτ_tilde_coe c hc_lt hc_pos, ← pow_mul, ← pow_succ]
  have hτ_val0 : ∀ c < p, 0 < c → valL F L (τ_unit c : L) = 0 := by
    intro c hc_lt hc_pos
    rw [hτ_unit_coe c hc_lt hc_pos,
      hval_pow_L (c : L) (p ^ (b + 1)) (hj_props c hc_lt hc_pos).1,
      (hj_props c hc_lt hc_pos).2.1, mul_zero]
  have hτ_inv_val0 : ∀ c < p, 0 < c → valL F L (((τ_unit c)⁻¹ : Lˣ) : L) = 0 := by
    intro c hc_lt hc_pos
    rw [hval_inv_L (τ_unit c), hτ_val0 c hc_lt hc_pos, neg_zero]
  obtain ⟨hT_p1, hT_sum⟩ :=
    hTeich hp_val1 τ_unit τ_tilde (fun j hj hj0 => ⟨hτ_tilde_coe j hj hj0, rfl⟩)
  have hb_cast : ((bE' + t₁ + 1 : ℕ) : ℤ) = (b + 1 : ℤ) := by
    dsimp [b]
  have hConj2 : ∀ c ∈ (Finset.range p).erase 0,
      valL F L (τ_unit c : L) = 0 ∧
      valL F L (((τ_unit c)⁻¹ : Lˣ) : L) = 0 ∧
      ((τ_unit c : L) ^ (p - 1) - 1 = 0 ∨
        ((bE' + t₁ + 1 : ℕ) : ℤ) ≤ valL F L ((τ_unit c : L) ^ (p - 1) - 1)) := by
    intro c hc
    have hc_ne0 : c ≠ 0 := (Finset.mem_erase.mp hc).1
    have hc_lt : c < p := Finset.mem_range.mp (Finset.mem_erase.mp hc).2
    have hc_pos : 0 < c := Nat.pos_of_ne_zero hc_ne0
    refine ⟨hτ_val0 c hc_lt hc_pos, hτ_inv_val0 c hc_lt hc_pos, ?_⟩
    rw [hb_cast]
    exact hT_p1 c hc_lt hc_pos
  have hConj3 : ∀ A ∈ Finset.Icc 1 (2 * (p - 1)),
      ¬ ((p - 1) ∣ A) →
      (∑ c ∈ (Finset.range p).erase 0, (τ_unit c : L) ^ A) = 0 ∨
        ((bE' + t₁ + 1 : ℕ) : ℤ) ≤
          valL F L (∑ c ∈ (Finset.range p).erase 0, (τ_unit c : L) ^ A) := by
    intro A hA hndvd
    have h := hT_sum A hA
    rw [if_neg hndvd, sub_zero, ← hb_cast] at h
    exact h
  
  have hτ_mod_mp : ∀ c < p, 0 < c →
      (τ_unit c : L) - (c : L) = 0 ∨ (m_p : ℤ) ≤ valL F L ((τ_unit c : L) - (c : L)) := by
    intro c hc_lt hc_pos
    have hpow_zmod : (((c : ℤ) ^ (p ^ (b + 1)) : ℤ) : ZMod p) = ((c : ℤ) : ZMod p) := by
      push_cast
      exact ZMod.pow_card_pow (c : ZMod p)
    have h := hzmod_eq_imp_val_mp ((c : ℤ) ^ (p ^ (b + 1))) (c : ℤ) hpow_zmod
    push_cast at h
    rwa [← hτ_unit_coe c hc_lt hc_pos] at h
  have hConj1 : ∀ c ∈ (Finset.range p).erase 0,
      ((τ_unit c : L) - (c : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((τ_unit c : L) - (c : L))) ∧
      ∃ k_c : ℕ, c * c ^ (p - 2) = 1 + p * k_c := by
    intro c hc
    have hc_ne0 : c ≠ 0 := (Finset.mem_erase.mp hc).1
    have hc_lt : c < p := Finset.mem_range.mp (Finset.mem_erase.mp hc).2
    have hc_pos : 0 < c := Nat.pos_of_ne_zero hc_ne0
    refine ⟨?_, (hj_props c hc_lt hc_pos).2.2.2⟩
    exact hval_mono_L 1 (m_p : ℤ) ((τ_unit c : L) - (c : L))
      (by exact_mod_cast hmp_ge1) (hτ_mod_mp c hc_lt hc_pos)
  have hτ_inv_c_mp : ∀ c ∈ (Finset.range p).erase 0,
      (((τ_unit c)⁻¹ : Lˣ) : L) - ((c ^ (p - 2) : ℕ) : L) = 0 ∨
        (m_p : ℤ) ≤ valL F L ((((τ_unit c)⁻¹ : Lˣ) : L) - ((c ^ (p - 2) : ℕ) : L)) := by
    intro c hc
    have hc_ne0 : c ≠ 0 := (Finset.mem_erase.mp hc).1
    have hc_lt : c < p := Finset.mem_range.mp (Finset.mem_erase.mp hc).2
    have hc_pos : 0 < c := Nat.pos_of_ne_zero hc_ne0
    have hpow_p2_zmod :
        ((((c : ℤ) ^ (p ^ (b + 1))) ^ (p - 2) : ℤ) : ZMod p) =
          (((c : ℤ) ^ (p - 2) : ℤ) : ZMod p) := by
      push_cast
      rw [ZMod.pow_card_pow (c : ZMod p)]
    have hτ_p2_mod_mp :
        (τ_unit c : L) ^ (p - 2) - ((c ^ (p - 2) : ℕ) : L) = 0 ∨
          (m_p : ℤ) ≤ valL F L ((τ_unit c : L) ^ (p - 2) - ((c ^ (p - 2) : ℕ) : L)) := by
      have h := hzmod_eq_imp_val_mp (((c : ℤ) ^ (p ^ (b + 1))) ^ (p - 2))
        ((c : ℤ) ^ (p - 2)) hpow_p2_zmod
      push_cast at h
      rw [Nat.cast_pow c (p - 2)]
      rwa [← hτ_unit_coe c hc_lt hc_pos] at h
    have hinv_mul : (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) = 1 := by
      exact_mod_cast Units.inv_mul (τ_unit c)
    have hp_sub1 : p - 1 = (p - 2) + 1 := by omega
    have h_alg : (((τ_unit c)⁻¹ : Lˣ) : L) - (τ_unit c : L) ^ (p - 2) =
        - ((((τ_unit c)⁻¹ : Lˣ) : L) * ((τ_unit c : L) ^ (p - 1) - 1)) := by
      conv_rhs => rw [hp_sub1, pow_succ']
      linear_combination ((τ_unit c : L) ^ (p - 2)) * hinv_mul
    have hmp_le_b1 : (m_p : ℤ) ≤ (b + 1 : ℤ) := by
      have h1 : m_p ≤ b + 1 := by dsimp [m_p, b]; omega
      exact_mod_cast h1
    have hτ_inv_p2 :
        (((τ_unit c)⁻¹ : Lˣ) : L) - (τ_unit c : L) ^ (p - 2) = 0 ∨
          (m_p : ℤ) ≤ valL F L ((((τ_unit c)⁻¹ : Lˣ) : L) - (τ_unit c : L) ^ (p - 2)) := by
      rw [h_alg]
      have hprod := hval_mul_ge_L 0 (b + 1 : ℤ)
        (((τ_unit c)⁻¹ : Lˣ) : L) ((τ_unit c : L) ^ (p - 1) - 1)
        (Or.inr (le_of_eq (hτ_inv_val0 c hc_lt hc_pos).symm))
        (hT_p1 c hc_lt hc_pos)
      rw [zero_add] at hprod
      have hprod_mp := hval_mono_L (m_p : ℤ) (b + 1 : ℤ) _ hmp_le_b1 hprod
      rcases hprod_mp with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rwa [hval_neg_L]
    have hsum := hval_add_L (m_p : ℤ)
      ((((τ_unit c)⁻¹ : Lˣ) : L) - (τ_unit c : L) ^ (p - 2))
      ((τ_unit c : L) ^ (p - 2) - ((c ^ (p - 2) : ℕ) : L))
      hτ_inv_p2 hτ_p2_mod_mp
    have hadd_eq :
        ((((τ_unit c)⁻¹ : Lˣ) : L) - (τ_unit c : L) ^ (p - 2)) +
          ((τ_unit c : L) ^ (p - 2) - ((c ^ (p - 2) : ℕ) : L)) =
        (((τ_unit c)⁻¹ : Lˣ) : L) - ((c ^ (p - 2) : ℕ) : L) := by ring
    rwa [hadd_eq] at hsum
  
  have hval_α : valL F L α = -((bE' : ℤ) + condExpChar F L ψ) := by
    dsimp [α, bE']
    rw [hval_inv_L c_νE', hc_νE'_val]
  have hval_2α : (2 : L) * α = 0 ∨ -((bE' : ℤ) + condExpChar F L ψ) ≤ valL F L (2 * α) := by
    have h2 : (2 : L) = 0 ∨ 0 ≤ valL F L (2 : L) := by
      simpa using hnat_int_L 2
    have h := hval_mul_ge_L 0 (-((bE' : ℤ) + condExpChar F L ψ)) (2 : L) α
      h2 (Or.inr (le_of_eq hval_α.symm))
    simpa using h
  have hConj4 : ∀ y : L, (y = 0 ∨ (bE' : ℤ) ≤ valL F L y) → ψ (2 * α * y) = 1 := by
    intro y hy
    have h := hval_mul_ge_L (-((bE' : ℤ) + condExpChar F L ψ)) (bE' : ℤ) (2 * α) y hval_2α hy
    have h_add : -((bE' : ℤ) + condExpChar F L ψ) + (bE' : ℤ) = -condExpChar F L ψ := by ring
    rw [h_add] at h
    exact hψ_triv (2 * α * y) h
  have hConj5 : ∀ c ∈ (Finset.range p).erase 0,
      ∀ v : L, (v = 0 ∨ (q_p : ℤ) ≤ valL F L v) →
        (ψ (2 * α * v)) ^ (c ^ (p - 2)) =
          ψ (2 * α * ((((τ_unit c)⁻¹ : Lˣ) : L) * v)) := by
    intro c hc v hv
    let δ_c : L := ((((τ_unit c)⁻¹ : Lˣ) : L) - ((c ^ (p - 2) : ℕ) : L)) * v
    have hδ_val : δ_c = 0 ∨ (bE' : ℤ) ≤ valL F L δ_c := by
      have h := hval_mul_ge_L (m_p : ℤ) (q_p : ℤ)
        ((((τ_unit c)⁻¹ : Lˣ) : L) - ((c ^ (p - 2) : ℕ) : L)) v
        (hτ_inv_c_mp c hc) hv
      rwa [hmp_add_qp_int] at h
    have hψ_δ : ψ (2 * α * δ_c) = 1 := hConj4 δ_c hδ_val
    have h_split : 2 * α * ((((τ_unit c)⁻¹ : Lˣ) : L) * v) =
        (2 * α * δ_c) + (2 * α * (((c ^ (p - 2) : ℕ) : L) * v)) := by
      dsimp [δ_c]
      ring
    have h_nsmul : 2 * α * (((c ^ (p - 2) : ℕ) : L) * v) =
        (c ^ (p - 2)) • (2 * α * v) := by
      rw [nsmul_eq_mul]
      ring
    rw [h_split, AddChar.map_add_eq_mul, hψ_δ, one_mul, h_nsmul, AddChar.map_nsmul_eq_pow]
  exact ⟨hj_inv, ⟨τ_unit, hConj1, hConj2, hConj3, hConj4, hConj5⟩⟩

theorem ld_ch12_wild_odd_tot_ram_scaled_F_fn_expansion_and_term_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((condExp F L νM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (condExp F L νE' - condExp F L νM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (ha_val : valL F E' (normLM F hE'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hb_val : valL F M₁' (normLM F hM₁'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hj_inv : ∀ j ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      ((j : ℕ) : L) ≠ 0 ∧ valL F L (((j : ℕ) : L)⁻¹) = 0)
    (hExp_M₁' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let q₁ := (m₁ + p - 1) / p
      let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
      let E_M₁' := fun w : K₁ =>
        (∑ m ∈ Finset.Icc 1 (p - 1),
          ((m : ℕ) : M₁')⁻¹ * (traceLM F hM₁'K₁ (w ^ m) + (normLM F hM₁'K₁ w) ^ m)) +
        (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
          ((r : ℕ) : M₁')⁻¹ * traceLM F hM₁'K₁ (w ^ r) * (normLM F hM₁'K₁ w) ^ j)
      ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
        let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
        (u₁ = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' u₁) ∧
        (P_M₁' u₁ - E_M₁' w = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (P_M₁' u₁ - E_M₁' w)))
    (hExp_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
