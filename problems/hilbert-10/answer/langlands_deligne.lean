        rw [hi0, pow_zero, pow_zero, sub_self, mul_zero]
      · have hi_ge1 : 1 ≤ (i : ℕ) := by omega
        set m : ℕ := (i : ℕ) - 1
        have hm_eq : (i : ℕ) = m + 1 := by omega
        have hW_i : IntermediateField.inclusion hE'K₁ (W i) = 0 ∨
            (p : ℤ) + (i : ℤ) * (t₁ : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ (W i)) := by
          rcases hW_coeffs i with h0 | hle
          · exact Or.inl (by rw [h0, map_zero])
          · right
            rw [hval_E'K₁ (W i)]
            linarith
        have hΔ_pow_i : (τ_lift (Δ : K₁)) ^ (i : ℕ) - ((Δ : K₁) ^ (i : ℕ)) = 0 ∨
            (m : ℤ) * (-(t₁ : ℤ)) + M_low ≤
              valL F K₁ ((τ_lift (Δ : K₁)) ^ (i : ℕ) - ((Δ : K₁) ^ (i : ℕ))) := by
          rw [hm_eq]
          exact hpow_diff_succ m (τ_lift (Δ : K₁)) (Δ : K₁) (-(t₁ : ℤ)) M_low
            (Or.inr (by omega)) (Or.inr (by omega)) hδ_M_low
        refine val_mono_K₁ ?_ (val_mul_K₁ hW_i hΔ_pow_i)
        have hm_z : ((i : ℕ) : ℤ) = (m : ℤ) + 1 := by omega
        rw [hm_z]
        linarith
    have h_jump_ge : (p : ℤ) + (t₁ : ℤ) + M_low ≤ (p : ℤ) * (bM₁' : ℤ) := by
      have h := hw₀_diff_bound.resolve_left hw₀_jump_ne0
      rw [hw₀_jump_val] at h
      exact h
    have hbM₁'_eq : (bM₁' : ℤ) = (t₁ : ℤ) + 1 := by omega
    have h_p_le_sq : p * t₁ ≤ (p - 1) * (p - 1) * t₁ := by
      have hp_sq : p ≤ (p - 1) * (p - 1) := by
        calc p ≤ p + (p - 2) := by omega
          _ = 2 * (p - 1) := by omega
          _ ≤ (p - 1) * (p - 1) := Nat.mul_le_mul_right (p - 1) (by omega)
      exact Nat.mul_le_mul_right t₁ hp_sq
    have h_p_le_sq_z : (p : ℤ) * (t₁ : ℤ) ≤ M_low := by
      dsimp [M_low]
      exact_mod_cast h_p_le_sq
    nlinarith [h_jump_ge, hbM₁'_eq, h_p_le_sq_z, ht₁_ge1]
  exact ⟨D₀, δ_plus, hΔ_shift, hD₀_unit.1, hD₀_unit.2, hδ_plus_val⟩

theorem ld_ch12_wild_odd_tot_ram_upper_triangular_back_subst (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bM₁' : ℕ) (hbM₁'_ge2 : 2 ≤ bM₁')
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_coeff_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      ∀ (Y : Fin p → E') (m : ℤ),
        ((∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))) = 0 ∨
          m ≤ valL F K₁ (∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)))) ↔
        ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ))
    (hcoprime_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∀ k : ℕ, 1 ≤ k → k < p →
        ((k : ℕ) : E') ≠ 0 ∧ valL F E' ((k : ℕ) : E') = 0)
    (τ : M₁' ≃ₐ[F] M₁') (τ_lift : K₁ ≃ₐ[F] K₁)
    (hτ_E' : ∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
      IntermediateField.inclusion hE'K₁ y)
    (hτ_M₁' : ∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
      IntermediateField.inclusion hM₁'K₁ (τ z))
    (hτ_val : ∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w)
    (hτ_shift : ∀ (θ : M₁') (m : ℤ),
      (θ = 0 ∨ m ≤ valL F M₁' θ) →
      (τ θ - θ = 0 ∨ m + ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (τ θ - θ)))
    (D₀ : E') (δ_plus : K₁)
    (hΔ_shift : τ_lift (Δ : K₁) = (Δ : K₁) + IntermediateField.inclusion hE'K₁ D₀ + δ_plus)
    (hD₀_ne0 : D₀ ≠ 0)
    (hD₀_val : valL F E' D₀ = 0)
    (hδ_plus_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      δ_plus = 0 ∨ (((p - 1) * (p - 1) * t₁ : ℕ) : ℤ) ≤ valL F K₁ δ_plus) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    ∀ (θ : M₁') (Y : Fin p → E'),
      IntermediateField.inclusion hM₁'K₁ θ =
        ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
      ∀ i : Fin p,
        Y i = 0 ∨
          valL F M₁' θ + (i : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) :=
by
  intro p t₁
  have hp_two_le : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := hp_odd
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := by omega
  have ht₁_def : t₁ = bM₁' - 1 := rfl
  have ht₁_ge1 : 1 ≤ t₁ := by omega
  have hΔ_coeff_val' : ∀ (Y : Fin p → E') (m : ℤ),
      ((∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))) = 0 ∨
        m ≤ valL F K₁ (∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)))) ↔
      ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ) := hΔ_coeff_val
  have hΔ_basis' : ∀ w : K₁, ∃ Y : Fin p → E',
      w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ) := hΔ_basis
  rcases hvalE'_props with
    ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E',
     hval_inv_E', hval_surj_E', hval_add_E', _⟩
  rcases hvalM₁'_props with
    ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁',
     hval_inv_M₁', hval_surj_M₁', hval_add_M₁', _⟩
  rcases hvalK₁_props with
    ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁,
     hval_inv_K₁, hval_surj_K₁, hval_add_K₁, _⟩
  have hval_sub_E' : ∀ (k : ℤ) (x y : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
      (x - y = 0 ∨ k ≤ valL F E' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hval_add_E' k x (-y) hx
    rcases hy with rfl | hy
    · left; simp
    · right; rw [hval_neg_E']; exact hy
  have hval_sub_K₁ : ∀ (k : ℤ) (x y : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
      (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hval_add_K₁ k x (-y) hx
    rcases hy with rfl | hy
    · left; simp
    · right; rw [hval_neg_K₁]; exact hy
  have hval_mul_le_E' : ∀ (k₁ k₂ : ℤ) (x y : E'),
      (x = 0 ∨ k₁ ≤ valL F E' x) → (y = 0 ∨ k₂ ≤ valL F E' y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F E' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        rcases hx with rfl | hx
        · contradiction
        · rcases hy with rfl | hy
          · contradiction
          · rw [hval_mul_E' x y hx0 hy0]
            omega
  have hval_mul_le_K₁ : ∀ (k₁ k₂ : ℤ) (x y : K₁),
      (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        rcases hx with rfl | hx
        · contradiction
        · rcases hy with rfl | hy
          · contradiction
          · rw [hval_mul_K₁ x y hx0 hy0]
            omega
  have hval_sum_E' : ∀ (s : Finset (Fin p)) (f : Fin p → E') (k : ℤ),
      (∀ i ∈ s, f i = 0 ∨ k ≤ valL F E' (f i)) →
      ((∑ i ∈ s, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ s, f i)) := by
    intro s f k hf
    induction' s using Finset.induction_on with a s ha ih
    · left; simp
    · rw [Finset.sum_insert ha]
      apply hval_add_E' k (f a) (∑ i ∈ s, f i)
      · exact hf a (Finset.mem_insert_self a s)
      · exact ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hval_sum_K₁ : ∀ (s : Finset (Fin p)) (f : Fin p → K₁) (k : ℤ),
      (∀ i ∈ s, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
      ((∑ i ∈ s, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ s, f i)) := by
    intro s f k hf
    induction' s using Finset.induction_on with a s ha ih
    · left; simp
    · rw [Finset.sum_insert ha]
      apply hval_add_K₁ k (f a) (∑ i ∈ s, f i)
      · exact hf a (Finset.mem_insert_self a s)
      · exact ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hval_pow_E' : ∀ (x : E') (hx : x ≠ 0) (n : ℕ),
      x ^ n ≠ 0 ∧ valL F E' (x ^ n) = (n : ℤ) * valL F E' x := by
    intro x hx n
    induction' n with n ih
    · simp [hval1_E']
    · refine ⟨pow_ne_zero (n + 1) hx, ?_⟩
      rw [pow_succ, hval_mul_E' (x ^ n) x ih.1 hx, ih.2]
      push_cast
      ring
  have hval_pow_le_K₁ : ∀ (x : K₁) (v : ℤ),
      (x = 0 ∨ v ≤ valL F K₁ x) →
      ∀ n : ℕ, x ^ n = 0 ∨ (n : ℤ) * v ≤ valL F K₁ (x ^ n) := by
    intro x v hx n
    induction' n with n ih
    · right; simp [hval1_K₁]
    · rw [pow_succ]
      have h1 := hval_mul_le_K₁ ((n : ℤ) * v) v (x ^ n) x ih hx
      rcases h1 with h1 | h1
      · left; exact h1
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * v = (n : ℤ) * v + v := by push_cast; ring
        rw [heq]
        exact h1
  have hnat_val_E' : ∀ n : ℕ, ((n : ℕ) : E') = 0 ∨ (0 : ℤ) ≤ valL F E' ((n : ℕ) : E') := by
    intro n
    induction' n with n ih
    · left; simp
    · rw [Nat.cast_succ]
      apply hval_add_E' 0 (n : E') 1 ih
      right
      rw [hval1_E']
  have hpow_diff_K₁ : ∀ (n : ℕ), 1 ≤ n → ∀ (x y : K₁) (v d : ℤ),
      (x = 0 ∨ v ≤ valL F K₁ x) →
      (y = 0 ∨ v ≤ valL F K₁ y) →
      (x - y = 0 ∨ d ≤ valL F K₁ (x - y)) →
      (x ^ n - y ^ n = 0 ∨ ((n - 1 : ℕ) : ℤ) * v + d ≤ valL F K₁ (x ^ n - y ^ n)) := by
    intro n
    induction' n with n ih
    · intro h; omega
    · intro _ x y v d hx hy hxy
      rcases Nat.eq_zero_or_pos n with rfl | hn_pos
      · simp only [zero_add, pow_one, Nat.sub_self, Nat.cast_zero, zero_mul]
        exact hxy
      · have hsplit : x ^ (n + 1) - y ^ (n + 1) = (x ^ n - y ^ n) * x + y ^ n * (x - y) := by ring
        rw [hsplit]
        have h1 := ih hn_pos x y v d hx hy hxy
        have h1x := hval_mul_le_K₁ (((n - 1 : ℕ) : ℤ) * v + d) v (x ^ n - y ^ n) x h1 hx
        have hyn := hval_pow_le_K₁ y v hy n
        have h2y := hval_mul_le_K₁ ((n : ℤ) * v) d (y ^ n) (x - y) hyn hxy
        have heq1 : ((n + 1 - 1 : ℕ) : ℤ) * v + d = (((n - 1 : ℕ) : ℤ) * v + d) + v := by
          have hn1 : ((n - 1 : ℕ) : ℤ) = (n : ℤ) - 1 := by omega
          have hn2 : ((n + 1 - 1 : ℕ) : ℤ) = (n : ℤ) := by omega
          rw [hn1, hn2]
          ring
        have heq2 : ((n + 1 - 1 : ℕ) : ℤ) * v + d = (n : ℤ) * v + d := by simp
        apply hval_add_K₁ (((n + 1 - 1 : ℕ) : ℤ) * v + d)
        · rw [heq1]; exact h1x
        · rw [heq2]; exact h2y
  have hzero_coeff : ∀ (Y : Fin p → E'),
      (∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))) = 0 →
      ∀ i : Fin p, Y i = 0 := by
    intro Y hsum i
    have hm := (hΔ_coeff_val' Y ((p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ) + 1)).mp (Or.inl hsum) i
    rcases hm with hYi | hle
    · exact hYi
    · omega
  let Δ₀ : K₁ := (Δ : K₁) + IntermediateField.inclusion hE'K₁ D₀
  let U_mat : (Fin p → E') → Fin p → Fin p → E' := fun Y i r =>
    if (r : ℕ) < (i : ℕ) then
      (((i : ℕ).choose (r : ℕ) : ℕ) : E') * (D₀ ^ ((i : ℕ) - (r : ℕ))) * Y i
    else 0
  let Y_prime : (Fin p → E') → Fin p → E' := fun Y r =>
    ∑ i : Fin p, U_mat Y i r
  have hswap_sum : ∀ (Y : Fin p → E'),
      (∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * (Δ₀ ^ (i : ℕ) - (Δ : K₁) ^ (i : ℕ))) =
        ∑ r : Fin p, IntermediateField.inclusion hE'K₁ (Y_prime Y r) * ((Δ : K₁) ^ (r : ℕ)) := by
    intro Y
    have hrow : ∀ i : Fin p,
        IntermediateField.inclusion hE'K₁ (Y i) * (Δ₀ ^ (i : ℕ) - (Δ : K₁) ^ (i : ℕ)) =
          ∑ r : Fin p, IntermediateField.inclusion hE'K₁ (U_mat Y i r) * ((Δ : K₁) ^ (r : ℕ)) := by
      intro i
      have hpow : Δ₀ ^ (i : ℕ) - (Δ : K₁) ^ (i : ℕ) =
          ∑ r ∈ Finset.range (i : ℕ),
            (Δ : K₁) ^ r * (IntermediateField.inclusion hE'K₁ D₀) ^ ((i : ℕ) - r) *
              (((i : ℕ).choose r : ℕ) : K₁) := by
        have h1 := add_pow (Δ : K₁) (IntermediateField.inclusion hE'K₁ D₀) (i : ℕ)
        rw [Finset.sum_range_succ] at h1
