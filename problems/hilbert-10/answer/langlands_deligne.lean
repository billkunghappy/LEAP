theorem ld_ch14_metacyclic_q0_power_subgroup_and_complement (H : Type u) [Group H] [Fintype H]
    (H₀ : Subgroup H) [H₀.Normal] [IsCyclic H₀] [IsCyclic (H ⧸ H₀)]
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀) (hq₀_dvd : q₀ ∣ Nat.card H) :
    (∃ (H' : Subgroup H),
      H'.Normal ∧
      (∀ a b : H, a * b * a⁻¹ * b⁻¹ ∈ H') ∧
      H'.index = q₀) ∨
    (Nat.Coprime q₀ H₀.index ∧
      ∃ (N₀ H_F' : Subgroup H),
        N₀.Normal ∧
        N₀ ≤ H₀ ∧
        N₀ ≤ H_F' ∧
        (N₀.subgroupOf H₀).index = q₀ ∧
        H_F'.index = q₀ ∧
        (∀ c ∈ H₀, c ^ q₀ ∈ N₀) ∧
        (∀ a ∈ H₀, ∀ b ∈ H₀, a * b = b * a) ∧
        (∀ h : H, h ∈ H_F' → h ∈ H₀ → h ∈ N₀) ∧
        (∀ h : H, ∃ x ∈ H_F', ∃ c ∈ H₀, h = x * c) ∧
        (∀ a ∈ H_F', ∀ b ∈ H_F', a * b * a⁻¹ * b⁻¹ ∈ N₀)) :=
by
  have hCyclicPow : ∀ (G : Type u) [Group G] [Finite G] [IsCyclic G],
      q₀ ∣ Nat.card G →
      ∃ (N : Subgroup G),
        N.Normal ∧
        N.index = q₀ ∧
        (∀ x : G, x ∈ N ↔ ∃ y : G, x = y ^ q₀) ∧
        (∀ a b : G, a * b = b * a) := by
    intro G _ _ _ hdvd
    letI : CommGroup G := IsCyclic.commGroup
    obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_generator (α := G)
    let N : Subgroup G := Subgroup.zpowers (g₀ ^ q₀)
    have hN_norm : N.Normal := Subgroup.normal_of_comm N
    have hN_iff : ∀ x : G, x ∈ N ↔ ∃ y : G, x = y ^ q₀ := by
      intro x
      constructor
      · intro hx
        obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
        refine ⟨g₀ ^ k, ?_⟩
        rw [← zpow_natCast (g₀ ^ k) q₀, ← zpow_mul, mul_comm k (q₀ : ℤ),
          zpow_mul, zpow_natCast]
      · rintro ⟨y, rfl⟩
        obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg₀ y)
        refine Subgroup.mem_zpowers_iff.mpr ⟨k, ?_⟩
        rw [← zpow_natCast g₀ q₀, ← zpow_mul, mul_comm (q₀ : ℤ) k,
          zpow_mul, zpow_natCast]
    have hzp_top : Subgroup.zpowers g₀ = ⊤ :=
      eq_top_iff.mpr (fun x _ => hg₀ x)
    have hord_g₀ : orderOf g₀ = Nat.card G := by
      rw [← Nat.card_zpowers g₀, hzp_top, Subgroup.card_top]
    have hcard_N : Nat.card N = Nat.card G / q₀ := by
      rw [Nat.card_zpowers (g₀ ^ q₀), orderOf_pow g₀, hord_g₀,
        Nat.gcd_eq_right hdvd]
    have hmul_idx : (Nat.card G / q₀) * N.index = (Nat.card G / q₀) * q₀ := by
      calc (Nat.card G / q₀) * N.index = Nat.card N * N.index := by rw [hcard_N]
        _ = Nat.card G := Subgroup.card_mul_index N
        _ = (Nat.card G / q₀) * q₀ := (Nat.div_mul_cancel hdvd).symm
    have hdiv_pos : 0 < Nat.card G / q₀ :=
      Nat.div_pos (Nat.le_of_dvd Nat.card_pos hdvd) hq₀_prime.pos
    exact ⟨N, hN_norm, Nat.mul_left_cancel hdiv_pos hmul_idx, hN_iff,
      fun a b => mul_comm a b⟩
  by_cases hdvd_idx : q₀ ∣ H₀.index
  · apply Or.inl
    have hdvd_quot : q₀ ∣ Nat.card (H ⧸ H₀) := Subgroup.index_eq_card H₀ ▸ hdvd_idx
    obtain ⟨Q', hQ'_norm, hQ'_idx, _, hQ_comm⟩ := hCyclicPow (H ⧸ H₀) hdvd_quot
    let H' : Subgroup H := Q'.comap (QuotientGroup.mk' H₀)
    refine ⟨H', hQ'_norm.comap (QuotientGroup.mk' H₀), ?_, ?_⟩
    · intro a b
      rw [Subgroup.mem_comap]
      have hcomm_one : QuotientGroup.mk' H₀ (a * b * a⁻¹ * b⁻¹) = 1 := by
        simp only [map_mul, map_inv]
        rw [hQ_comm (QuotientGroup.mk' H₀ a) (QuotientGroup.mk' H₀ b),
          mul_inv_cancel_right, mul_inv_cancel]
      rw [hcomm_one]
      exact Q'.one_mem
    · rw [Subgroup.index_comap_of_surjective Q' (QuotientGroup.mk'_surjective H₀)]
      exact hQ'_idx
  · apply Or.inr
    have hcop : Nat.Coprime q₀ H₀.index :=
      hq₀_prime.coprime_iff_not_dvd.mpr hdvd_idx
    have hdvd_H₀ : q₀ ∣ Nat.card H₀ :=
      hcop.dvd_of_dvd_mul_right (Subgroup.card_mul_index H₀ ▸ hq₀_dvd)
    obtain ⟨N₀', _, hN₀'_idx, hN₀'_iff, hH₀_sub_comm⟩ := hCyclicPow H₀ hdvd_H₀
    let N₀ : Subgroup H := N₀'.map H₀.subtype
    have hN₀_le_H₀ : N₀ ≤ H₀ := by
      rintro x ⟨c, _, rfl⟩
      exact c.2
    have hN₀_iff : ∀ x : H, x ∈ N₀ ↔ ∃ c ∈ H₀, x = c ^ q₀ := by
      intro x
      simp only [N₀, Subgroup.mem_map, hN₀'_iff, Subtype.exists,
        Subgroup.coe_subtype, Subtype.ext_iff, Subgroup.coe_pow]
      constructor
      · rintro ⟨a, ha, ⟨b, hb, rfl⟩, rfl⟩
        exact ⟨b, hb, rfl⟩
      · rintro ⟨c, hc, rfl⟩
        exact ⟨c ^ q₀, H₀.pow_mem hc q₀, ⟨c, hc, rfl⟩, rfl⟩
    have hconj_pow : ∀ (g c : H) (n : ℕ), g * c ^ n * g⁻¹ = (g * c * g⁻¹) ^ n := by
      intro g c n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ, pow_succ, ← ih]
        group
    have hN₀_norm : N₀.Normal := by
      refine ⟨fun x hx g => ?_⟩
      obtain ⟨c, hc, rfl⟩ := (hN₀_iff x).mp hx
      exact (hN₀_iff (g * c ^ q₀ * g⁻¹)).mpr
        ⟨g * c * g⁻¹, ‹H₀.Normal›.conj_mem c hc g, hconj_pow g c q₀⟩
    have hN₀_sub_eq : N₀.subgroupOf H₀ = N₀' := by
      ext ⟨x, hx⟩
      simp [N₀, Subgroup.mem_subgroupOf, Subgroup.mem_map, hx]
    have hN₀_idx : (N₀.subgroupOf H₀).index = q₀ := by
      rw [hN₀_sub_eq]
      exact hN₀'_idx
    have hH₀_pow : ∀ c ∈ H₀, c ^ q₀ ∈ N₀ :=
      fun c hc => (hN₀_iff (c ^ q₀)).mpr ⟨c, hc, rfl⟩
    have hH₀_comm : ∀ a ∈ H₀, ∀ b ∈ H₀, a * b = b * a :=
      fun a ha b hb => congrArg Subtype.val (hH₀_sub_comm ⟨a, ha⟩ ⟨b, hb⟩)
    haveI : N₀.Normal := hN₀_norm
    letI : Fintype (H ⧸ H₀) := Fintype.ofFinite (H ⧸ H₀)
    obtain ⟨σbar₀, hσbar₀⟩ := IsCyclic.exists_generator (α := H ⧸ H₀)
    obtain ⟨σ₀, hσ₀⟩ := QuotientGroup.mk'_surjective H₀ σbar₀
    let σ₁ : H := σ₀ ^ q₀
    let σbar₁ : H ⧸ N₀ := QuotientGroup.mk' N₀ σ₁
    let H_F' : Subgroup H := (Subgroup.zpowers σbar₁).comap (QuotientGroup.mk' N₀)
    have hN₀_le_HF' : N₀ ≤ H_F' := by
      intro n hn
      rw [Subgroup.mem_comap]
      have hn_ker : QuotientGroup.mk' N₀ n = 1 := by
        rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']
        exact hn
      rw [hn_ker]
      exact Subgroup.one_mem _
    have hHF'_comm : ∀ a ∈ H_F', ∀ b ∈ H_F', a * b * a⁻¹ * b⁻¹ ∈ N₀ := by
      intro a ha b hb
      obtain ⟨ka, hka⟩ := Subgroup.mem_zpowers_iff.mp ha
      obtain ⟨kb, hkb⟩ := Subgroup.mem_zpowers_iff.mp hb
      rw [← QuotientGroup.ker_mk' N₀, MonoidHom.mem_ker]
      simp only [map_mul, map_inv, ← hka, ← hkb]
      have hcomm_zpow : σbar₁ ^ ka * σbar₁ ^ kb = σbar₁ ^ kb * σbar₁ ^ ka := by
        rw [← zpow_add, ← zpow_add, add_comm]
      rw [hcomm_zpow, mul_inv_cancel_right, mul_inv_cancel]
    let f₀ : ℕ := H₀.index
    have hf₀_card : f₀ = Fintype.card (H ⧸ H₀) := by
      change H₀.index = Fintype.card (H ⧸ H₀)
      rw [Subgroup.index_eq_card H₀, Nat.card_eq_fintype_card]
    have hσbar₀_f₀ : σbar₀ ^ f₀ = 1 := by
      rw [hf₀_card]
      exact pow_card_eq_one
    have hσ₀_f₀ : σ₀ ^ f₀ ∈ H₀ := by
      rw [← QuotientGroup.ker_mk' H₀, MonoidHom.mem_ker, map_pow, hσ₀, hσbar₀_f₀]
    have hσ₁_f₀_mem : σ₁ ^ f₀ ∈ N₀ := by
      have heq : σ₁ ^ f₀ = (σ₀ ^ f₀) ^ q₀ := by
        dsimp [σ₁]
        rw [← pow_mul, mul_comm, pow_mul]
      rw [heq]
      exact hH₀_pow (σ₀ ^ f₀) hσ₀_f₀
    have hσ₁_f₀ : σbar₁ ^ f₀ = 1 := by
      change (QuotientGroup.mk' N₀ σ₁) ^ f₀ = 1
      rw [← map_pow, ← MonoidHom.mem_ker, QuotientGroup.ker_mk']
      exact hσ₁_f₀_mem
    let u : ℤ := q₀.gcdA f₀
    let v : ℤ := q₀.gcdB f₀
    have hbez : (1 : ℤ) = (q₀ : ℤ) * u + (f₀ : ℤ) * v := by
      have h := Nat.gcd_eq_gcd_ab q₀ f₀
      rw [hcop.gcd_eq_one] at h
      exact_mod_cast h
    have hBezoutPow : ∀ {G : Type u} [Group G] (g : G),
        g ^ f₀ = 1 → g = (g ^ q₀) ^ u := by
      intro G _ g hg_f₀
      calc g = g ^ (1 : ℤ) := (zpow_one g).symm
        _ = g ^ ((q₀ : ℤ) * u + (f₀ : ℤ) * v) := by rw [← hbez]
        _ = (g ^ q₀) ^ u * (g ^ f₀) ^ v := by
            rw [zpow_add, zpow_mul, zpow_mul, zpow_natCast, zpow_natCast]
        _ = (g ^ q₀) ^ u := by rw [hg_f₀, one_zpow, mul_one]
    have hHF'_H₀_inf : ∀ h : H, h ∈ H_F' → h ∈ H₀ → h ∈ N₀ := by
      intro h hhF' hh₀
      let hbar : H ⧸ N₀ := QuotientGroup.mk' N₀ h
      have hbar_q₀ : hbar ^ q₀ = 1 := by
        change (QuotientGroup.mk' N₀ h) ^ q₀ = 1
        rw [← map_pow, ← MonoidHom.mem_ker, QuotientGroup.ker_mk']
        exact hH₀_pow h hh₀
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hhF'
      have hk' : σbar₁ ^ k = hbar := hk
      have hbar_f₀ : hbar ^ f₀ = 1 := by
        calc hbar ^ f₀ = (σbar₁ ^ k) ^ (f₀ : ℤ) := by
              rw [← zpow_natCast hbar f₀, ← hk']
          _ = (σbar₁ ^ f₀) ^ k := by
              rw [← zpow_mul, mul_comm k (f₀ : ℤ), zpow_mul, zpow_natCast]
          _ = 1 := by rw [hσ₁_f₀, one_zpow]
      have hbar_one : hbar = 1 := by
        rw [hBezoutPow hbar hbar_f₀, hbar_q₀, one_zpow]
      rw [← QuotientGroup.ker_mk' N₀, MonoidHom.mem_ker]
      exact hbar_one
    have hHF'_H₀_mul : ∀ h : H, ∃ x ∈ H_F', ∃ c ∈ H₀, h = x * c := by
      intro h
      obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hσbar₀ (QuotientGroup.mk' H₀ h))
      let n : ℤ := u * m
      let x : H := σ₁ ^ n
      have hx : x ∈ H_F' := by
        rw [Subgroup.mem_comap]
        exact Subgroup.mem_zpowers_iff.mpr ⟨n, (map_zpow (QuotientGroup.mk' N₀) σ₁ n).symm⟩
      have hx_quot : QuotientGroup.mk' H₀ x = QuotientGroup.mk' H₀ h := by
        change QuotientGroup.mk' H₀ ((σ₀ ^ q₀) ^ (u * m)) = QuotientGroup.mk' H₀ h
        rw [map_zpow, map_pow, hσ₀, zpow_mul, ← hBezoutPow σbar₀ hσbar₀_f₀, hm]
      let c : H := x⁻¹ * h
      have hc : c ∈ H₀ := by
        rw [← QuotientGroup.ker_mk' H₀, MonoidHom.mem_ker]
        change QuotientGroup.mk' H₀ (x⁻¹ * h) = 1
        rw [map_mul, map_inv, hx_quot, inv_mul_cancel]
      exact ⟨x, hx, c, hc, (mul_inv_cancel_left x h).symm⟩
    let N₀_sub : Subgroup H₀ := N₀.subgroupOf H₀
    let f_raw : H₀ → H ⧸ H_F' := fun c => QuotientGroup.mk (s := H_F') c.1
    have hf_rel : ∀ a b : H₀, @Setoid.r _ (QuotientGroup.leftRel N₀_sub) a b → f_raw a = f_raw b := by
      intro a b hab
      have hab' : a⁻¹ * b ∈ N₀_sub := QuotientGroup.leftRel_apply.mp hab
      have hab_N₀ : a.1⁻¹ * b.1 ∈ N₀ := hab'
      exact QuotientGroup.eq.mpr (hN₀_le_HF' hab_N₀)
    let ϕ : H₀ ⧸ N₀_sub → H ⧸ H_F' := Quotient.lift f_raw hf_rel
    have hϕ_inj : Function.Injective ϕ := by
      intro qa qb hq
      refine Quotient.inductionOn₂ qa qb (fun a b hq => ?_) hq
      have hab_HF' : a.1⁻¹ * b.1 ∈ H_F' := QuotientGroup.eq.mp hq
      have hab_H₀ : a.1⁻¹ * b.1 ∈ H₀ := H₀.mul_mem (H₀.inv_mem a.2) b.2
      have hab_N₀ : a.1⁻¹ * b.1 ∈ N₀ := hHF'_H₀_inf (a.1⁻¹ * b.1) hab_HF' hab_H₀
      exact QuotientGroup.eq.mpr hab_N₀
    have hϕ_surj : Function.Surjective ϕ := by
      intro q
      refine Quotient.inductionOn q (fun h => ?_)
      obtain ⟨x, hx, c, hc, h_inv⟩ := hHF'_H₀_mul h⁻¹
      refine ⟨QuotientGroup.mk (s := N₀_sub) ⟨c⁻¹, H₀.inv_mem hc⟩, ?_⟩
      change QuotientGroup.mk (s := H_F') c⁻¹ = QuotientGroup.mk (s := H_F') h
      apply QuotientGroup.eq.mpr
      have h_eq : (c⁻¹)⁻¹ * h = x⁻¹ := by
        calc (c⁻¹)⁻¹ * h = c * h := by rw [inv_inv]
          _ = (x⁻¹ * (x * c)) * h := by rw [inv_mul_cancel_left]
          _ = (x⁻¹ * h⁻¹) * h := by rw [← h_inv]
          _ = x⁻¹ := inv_mul_cancel_right x⁻¹ h
      rw [h_eq]
      exact H_F'.inv_mem hx
    have hHF'_idx : H_F'.index = q₀ := by
      rw [Subgroup.index_eq_card H_F',
        ← Nat.card_congr (Equiv.ofBijective ϕ ⟨hϕ_inj, hϕ_surj⟩),
        ← Subgroup.index_eq_card N₀_sub, hN₀_idx]
    exact ⟨hcop, N₀, H_F', hN₀_norm, hN₀_le_H₀, hN₀_le_HF', hN₀_idx, hHF'_idx,
      hH₀_pow, hH₀_comm, hHF'_H₀_inf, hHF'_H₀_mul, hHF'_comm⟩

theorem ld_ch14_metacyclic_centralizer_dichotomy_and_free_orbits (H : Type u) [Group H] [Fintype H]
    (H₀ N₀ H_F' : Subgroup H) [H₀.Normal] [N₀.Normal]
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀)
    (hN₀_le_H₀ : N₀ ≤ H₀) (hN₀_le_HF' : N₀ ≤ H_F')
    (hHF'_idx : H_F'.index = q₀)
    (hH₀_comm : ∀ a ∈ H₀, ∀ b ∈ H₀, a * b = b * a)
    (hHF'_H₀_inf : ∀ h : H, h ∈ H_F' → h ∈ H₀ → h ∈ N₀)
    (hHF'_H₀_mul : ∀ h : H, ∃ x ∈ H_F', ∃ c ∈ H₀, h = x * c)
    (hHF'_comm : ∀ a ∈ H_F', ∀ b ∈ H_F', a * b * a⁻¹ * b⁻¹ ∈ N₀) :
    (∃ (H' : Subgroup H),
      H'.Normal ∧
      (∀ a b : H, a * b * a⁻¹ * b⁻¹ ∈ H') ∧
      H'.index = q₀) ∨
    (∃ (N₁ H_L' : Subgroup H),
      N₁.Normal ∧
      H_L'.Normal ∧
      N₁ ≤ H_L' ∧
      N₁ ≤ H_F' ∧
      (∀ h : H, h ∈ H_F' → h ∈ H_L' → h ∈ N₁) ∧
      (∀ h : H, ∃ x ∈ H_F', ∃ y ∈ H_L', h = x * y) ∧
      1 < H_L'.index ∧
      (N₁.subgroupOf H_L').index = q₀ ∧
      (∀ a ∈ H_L', ∀ b ∈ H_L', a * b * a⁻¹ * b⁻¹ ∈ N₁) ∧
      (∀ h ∈ H_F', (∀ c ∈ H_L', h * c * h⁻¹ * c⁻¹ ∈ N₁) → h ∈ N₁) ∧
      (∀ M : Subgroup H, N₁ ≤ M → M.Normal → M ≤ N₁ ∨ H_L' ≤ M) ∧
      (∀ (r : ℕ), r * H_L'.index = q₀ - 1 →
        ∃ c_rep : Fin r → H,
          (∀ a : Fin r, c_rep a ∈ H_L' ∧ c_rep a ∉ N₁) ∧
          (∀ y ∈ H_L', y ∉ N₁ →
            ∃ (a₀ : Fin r) (g₀ : H),
              g₀ ∈ H_F' ∧
              ∀ (a : Fin r) (g : H), g ∈ H_F' →
                (g * (c_rep a)⁻¹ * g⁻¹ * y⁻¹ ∈ N₁ ↔ a = a₀ ∧ g⁻¹ * g₀ ∈ N₁)))) :=
by
  classical
  let H_L' : Subgroup H :=
    { carrier := {h : H | ∀ c ∈ H₀, h * c * h⁻¹ * c⁻¹ ∈ N₀}
      one_mem' := by
        intro c hc
        simp [N₀.one_mem]
      mul_mem' := by
        intro h₁ h₂ hh₁ hh₂ c hc
        have h_id : (h₁ * h₂) * c * (h₁ * h₂)⁻¹ * c⁻¹ =
            (h₁ * (h₂ * c * h₂⁻¹ * c⁻¹) * h₁⁻¹) * (h₁ * c * h₁⁻¹ * c⁻¹) := by group
        rw [h_id]
        exact N₀.mul_mem (‹N₀.Normal›.conj_mem _ (hh₂ c hc) h₁) (hh₁ c hc)
      inv_mem' := by
        intro h hh c hc
        have hc' : h⁻¹ * c * h ∈ H₀ := by
          have := ‹H₀.Normal›.conj_mem c hc h⁻¹
          simpa [mul_assoc] using this
        have h1 : (h * (h⁻¹ * c * h) * h⁻¹ * (h⁻¹ * c * h)⁻¹)⁻¹ ∈ N₀ :=
          N₀.inv_mem (hh _ hc')
        have h_id : (h * (h⁻¹ * c * h) * h⁻¹ * (h⁻¹ * c * h)⁻¹)⁻¹ =
            h⁻¹ * c * (h⁻¹)⁻¹ * c⁻¹ := by group
        rwa [h_id] at h1 }
  have hHL'_norm : H_L'.Normal := ⟨by
    intro h hh g c hc
    have hc' : g⁻¹ * c * g ∈ H₀ := by
      have := ‹H₀.Normal›.conj_mem c hc g⁻¹
      simpa [mul_assoc] using this
    have h1 : g * (h * (g⁻¹ * c * g) * h⁻¹ * (g⁻¹ * c * g)⁻¹) * g⁻¹ ∈ N₀ :=
      ‹N₀.Normal›.conj_mem _ (hh _ hc') g
    have h_id : g * (h * (g⁻¹ * c * g) * h⁻¹ * (g⁻¹ * c * g)⁻¹) * g⁻¹ =
        (g * h * g⁻¹) * c * (g * h * g⁻¹)⁻¹ * c⁻¹ := by group
    rwa [h_id] at h1⟩
  haveI : H_L'.Normal := hHL'_norm
  have hH₀_le_HL' : H₀ ≤ H_L' := by
    intro a ha c hc
    have hac : a * c * a⁻¹ * c⁻¹ = 1 := by
      calc a * c * a⁻¹ * c⁻¹ = (c * a) * a⁻¹ * c⁻¹ := by rw [hH₀_comm a ha c hc]
        _ = 1 := by group
    rw [hac]
    exact N₀.one_mem
  let N₁ : Subgroup H := H_F' ⊓ H_L'
  have hN₀_le_N₁ : N₀ ≤ N₁ := le_inf hN₀_le_HF' (hN₀_le_H₀.trans hH₀_le_HL')
  have hN₁_le_HL' : N₁ ≤ H_L' := inf_le_right
  have hN₁_le_HF' : N₁ ≤ H_F' := inf_le_left
  have hHF'_HL'_inf : ∀ h : H, h ∈ H_F' → h ∈ H_L' → h ∈ N₁ := fun _ hx hy => ⟨hx, hy⟩
  have hHF'_HL'_mul : ∀ h : H, ∃ x ∈ H_F', ∃ y ∈ H_L', h = x * y := by
    intro h
    obtain ⟨x, hx, c, hc, rfl⟩ := hHF'_H₀_mul h
    exact ⟨x, hx, c, hH₀_le_HL' hc, rfl⟩
  have hN₁_norm : N₁.Normal := ⟨by
    intro n hn g
    refine ⟨?_, hHL'_norm.conj_mem n hn.2 g⟩
    obtain ⟨x, hx, c, hc, rfl⟩ := hHF'_H₀_mul g
    have hnc : n * c * n⁻¹ * c⁻¹ ∈ H_F' := hN₀_le_HF' (hn.2 c hc)
    have hcn : c * n * c⁻¹ ∈ H_F' := by
      have h_id : c * n * c⁻¹ = (n * c * n⁻¹ * c⁻¹)⁻¹ * n := by group
      rw [h_id]
      exact H_F'.mul_mem (H_F'.inv_mem hnc) hn.1
    have h_id2 : (x * c) * n * (x * c)⁻¹ = x * (c * n * c⁻¹) * x⁻¹ := by group
    rw [h_id2]
    exact H_F'.mul_mem (H_F'.mul_mem hx hcn) (H_F'.inv_mem hx)⟩
  haveI : N₁.Normal := hN₁_norm
  have hHL'_comm : ∀ a ∈ H_L', ∀ b ∈ H_L', a * b * a⁻¹ * b⁻¹ ∈ N₁ := by
    intro a ha b hb
    apply hN₀_le_N₁
    let π₀ := QuotientGroup.mk' N₀
    have hcomm_π₀ : ∀ u v : H, u * v * u⁻¹ * v⁻¹ ∈ N₀ → π₀ u * π₀ v = π₀ v * π₀ u := by
      intro u v huv
      have h1 : π₀ (u * v * u⁻¹ * v⁻¹) = 1 := (QuotientGroup.eq_one_iff _).mpr huv
      simp only [map_mul, map_inv] at h1
      calc π₀ u * π₀ v
          = (π₀ u * π₀ v * (π₀ u)⁻¹ * (π₀ v)⁻¹) * (π₀ v * π₀ u) := by group
        _ = 1 * (π₀ v * π₀ u) := by rw [h1]
        _ = π₀ v * π₀ u := one_mul _
    obtain ⟨xa, hxa_F, ca, hca_0, rfl⟩ := hHF'_H₀_mul a
    obtain ⟨xb, hxb_F, cb, hcb_0, rfl⟩ := hHF'_H₀_mul b
    have hxa_L : xa ∈ H_L' := by
      have : xa = (xa * ca) * ca⁻¹ := by group
      rw [this]
      exact H_L'.mul_mem ha (H_L'.inv_mem (hH₀_le_HL' hca_0))
    have hxb_L : xb ∈ H_L' := by
      have : xb = (xb * cb) * cb⁻¹ := by group
      rw [this]
      exact H_L'.mul_mem hb (H_L'.inv_mem (hH₀_le_HL' hcb_0))
    have hc_xx : π₀ xa * π₀ xb = π₀ xb * π₀ xa := hcomm_π₀ xa xb (hHF'_comm xa hxa_F xb hxb_F)
    have hc_cc : π₀ ca * π₀ cb = π₀ cb * π₀ ca := by
      rw [← map_mul, ← map_mul, hH₀_comm ca hca_0 cb hcb_0]
    have hc_xc : π₀ xa * π₀ cb = π₀ cb * π₀ xa := hcomm_π₀ xa cb (hxa_L cb hcb_0)
    have hc_cx : π₀ xb * π₀ ca = π₀ ca * π₀ xb := hcomm_π₀ xb ca (hxb_L ca hca_0)
    have hab_eq : π₀ (xa * ca) * π₀ (xb * cb) = π₀ (xb * cb) * π₀ (xa * ca) := by
      simp only [map_mul]
      calc (π₀ xa * π₀ ca) * (π₀ xb * π₀ cb)
          = π₀ xa * (π₀ ca * π₀ xb) * π₀ cb := by group
        _ = π₀ xa * (π₀ xb * π₀ ca) * π₀ cb := by rw [← hc_cx]
        _ = (π₀ xa * π₀ xb) * (π₀ ca * π₀ cb) := by group
        _ = (π₀ xb * π₀ xa) * (π₀ cb * π₀ ca) := by rw [hc_xx, hc_cc]
        _ = π₀ xb * (π₀ xa * π₀ cb) * π₀ ca := by group
        _ = π₀ xb * (π₀ cb * π₀ xa) * π₀ ca := by rw [hc_xc]
        _ = (π₀ xb * π₀ cb) * (π₀ xa * π₀ ca) := by group
