    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : y₂ = 0
      · left; rw [h2, mul_zero]
      · right
