      exact hvalL_mul_or (2 * (e : ℤ) + 1) (2 * (e : ℤ) + 1) 0
        ((1 + 4 * f) * Δ₀ * s₀' ^ 2) (Nu₁⁻¹) hp2 (Or.inr (le_of_eq hNu₁_inv_val.symm)) (by omega)
    have hψ_err₂ : ψ (((α'⁻¹ : Lˣ) : L) * ((1 + 4 * f) * Δ₀ * s₀' ^ 2 * Nu₁⁻¹)) = 1 :=
