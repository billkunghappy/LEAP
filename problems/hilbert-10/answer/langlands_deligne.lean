      have hunit_1_plus : ∀ z : F_i, 1 ≤ valL F F_i z → 1 + z ≠ 0 ∧ valL F F_i (1 + z) = 0 := by
        intro z hz
        have hne0 : 1 + z ≠ 0 := by
