  have hΔz_or :
      ι ((α'⁻¹ : Lˣ) : L) * (Δ * z) = 0 ∨
        -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' (ι ((α'⁻¹ : Lˣ) : L) * (Δ * z)) := by
    have hια'_inv :
