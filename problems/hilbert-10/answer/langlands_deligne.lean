          (p : ℤ) * v + ((i : ℕ) : ℤ) * (t₁ : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ (Y i)) := by
        rcases hY_base i with h0 | hle
        · exact Or.inl (by rw [h0, map_zero])
        · right
          rw [hval_E'K₁ (Y i)]
          linarith
      have hrem_i := hrem_δ_val (i : ℕ) hi_pos
      have hmul := val_mul_K₁ hYi_K₁ hrem_i
      refine val_mono_K₁ ?_ hmul
      ring_nf
      linarith
  
  have hOuter : ∀ m : ℕ, m ≤ p - 1 →
      ∀ (θ : M₁') (Y : Fin p → E'),
        IntermediateField.inclusion hM₁'K₁ θ =
          ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
        ∀ i : Fin p,
          Y i = 0 ∨ valL F M₁' θ + (min (i : ℕ) m : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) := by
    intro m
    induction m with
    | zero =>
      intro _ θ Y hθY i
      have hbase : Y i = 0 ∨ valL F M₁' θ ≤ valL F E' (Y i) := by
        by_cases hθ0 : θ = 0
        · left
          have hsum0 : (∑ j : Fin p, IntermediateField.inclusion hE'K₁ (Y j) * ((Δ : K₁) ^ (j : ℕ))) = 0 := by
            rw [← hθY, hθ0, map_zero]
          exact hY_zero_of_sum_zero Y hsum0 i
        · have hθK₁_val : (∑ j : Fin p, IntermediateField.inclusion hE'K₁ (Y j) * ((Δ : K₁) ^ (j : ℕ))) = 0 ∨
              (p : ℤ) * valL F M₁' θ ≤ valL F K₁ (∑ j : Fin p, IntermediateField.inclusion hE'K₁ (Y j) * ((Δ : K₁) ^ (j : ℕ))) := by
            right
            rw [← hθY, hval_M₁'K₁ θ]
          rcases (hval_sum_iff Y ((p : ℤ) * valL F M₁' θ)).mp hθK₁_val i with h0 | hle
          · exact Or.inl h0
          · right
            have hit₁_nonneg : (0 : ℤ) ≤ (i : ℤ) * (t₁ : ℤ) := by positivity
            have hp_pos_z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
            nlinarith
      refine val_mono_E' ?_ hbase
      have hmin0 : min ((i : ℕ) : ℤ) ((0 : ℕ) : ℤ) = 0 := by omega
      rw [hmin0, zero_mul, add_zero]
    | succ m ih =>
      intro hm1 θ Y hθY
      by_cases hθ0 : θ = 0
      · intro i
        left
        have hsum0 : (∑ j : Fin p, IntermediateField.inclusion hE'K₁ (Y j) * ((Δ : K₁) ^ (j : ℕ))) = 0 := by
          rw [← hθY, hθ0, map_zero]
        exact hY_zero_of_sum_zero Y hsum0 i
      · set v : ℤ := valL F M₁' θ
        set θ' : M₁' := τ θ - θ
        obtain ⟨Y_tilde, hθ'_eq, _⟩ := hΔ_basis (IntermediateField.inclusion hM₁'K₁ θ')
        have hY_tilde_bound : ∀ r : Fin p,
            Y_tilde r = 0 ∨ v + (min ((r : ℕ) + 1) (m + 1) : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y_tilde r) := by
          intro r
          by_cases hθ'0 : θ' = 0
          · left
            have hsum0 : (∑ j : Fin p, IntermediateField.inclusion hE'K₁ (Y_tilde j) * ((Δ : K₁) ^ (j : ℕ))) = 0 := by
              rw [← hθ'_eq, hθ'0, map_zero]
            exact hY_zero_of_sum_zero Y_tilde hsum0 r
          · have hv_θ' : v + (t₁ : ℤ) ≤ valL F M₁' θ' :=
              (hτ_shift_M₁' θ hθ0).resolve_left hθ'0
            have hih_r := ih (by omega) θ' Y_tilde hθ'_eq r
            refine val_mono_E' ?_ hih_r
            have hmin_id : (1 : ℤ) + (min (r : ℕ) m : ℤ) = (min ((r : ℕ) + 1) (m + 1) : ℤ) := by
              omega
            nlinarith [hv_θ', hmin_id]
        have hdiff_sum : (∑ r : Fin p,
            IntermediateField.inclusion hE'K₁ (Y_tilde r - Y' Y r) * ((Δ : K₁) ^ (r : ℕ))) =
            E_δ Y := by
          have h1 := hshift_decomp θ Y hθY
          change IntermediateField.inclusion hM₁'K₁ θ' = _ at h1
          rw [hθ'_eq] at h1
          have hsub : (∑ r : Fin p,
              IntermediateField.inclusion hE'K₁ (Y_tilde r - Y' Y r) * ((Δ : K₁) ^ (r : ℕ))) =
              (∑ r : Fin p, IntermediateField.inclusion hE'K₁ (Y_tilde r) * ((Δ : K₁) ^ (r : ℕ))) -
                (∑ r : Fin p, IntermediateField.inclusion hE'K₁ (Y' Y r) * ((Δ : K₁) ^ (r : ℕ))) := by
            rw [← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [map_sub, sub_mul]
          rw [hsub, h1, add_sub_cancel_left]
        have hE_δ_sum : (∑ r : Fin p,
            IntermediateField.inclusion hE'K₁ (Y_tilde r - Y' Y r) * ((Δ : K₁) ^ (r : ℕ))) = 0 ∨
            (p : ℤ) * v + (t₁ : ℤ) + M_target ≤
              valL F K₁ (∑ r : Fin p,
                IntermediateField.inclusion hE'K₁ (Y_tilde r - Y' Y r) * ((Δ : K₁) ^ (r : ℕ))) := by
          rw [hdiff_sum]
          exact hE_δ_val θ Y hθ0 hθY
        have hdiff_coeff := (hval_sum_iff (fun r => Y_tilde r - Y' Y r)
          ((p : ℤ) * v + (t₁ : ℤ) + M_target)).mp hE_δ_sum
        have hY'_bound : ∀ r : Fin p, (r : ℕ) ≤ p - 2 →
            Y' Y r = 0 ∨ v + (min ((r : ℕ) + 1) (m + 1) : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y' Y r) := by
          intro r hr
          have hdiff_r : Y_tilde r - Y' Y r = 0 ∨
              v + (min ((r : ℕ) + 1) (m + 1) : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y_tilde r - Y' Y r) := by
            rcases hdiff_coeff r with h0 | hle
            · exact Or.inl h0
            · right
              have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
              have hM_eq : M_target = ((p : ℤ) - 1) * ((p : ℤ) - 1) * (t₁ : ℤ) := by
                dsimp [M_target]
                push_cast
                rw [hp1_cast]
              have h_excess : (0 : ℤ) ≤ ((p : ℤ) - 2 - (r : ℤ)) * ((p : ℤ) - 1) * (t₁ : ℤ) := by
                refine mul_nonneg (mul_nonneg ?_ ?_) ?_
                · omega
                · omega
                · omega
              have h_poly : (p : ℤ) * ((r : ℤ) + 1) * (t₁ : ℤ) ≤
                  (t₁ : ℤ) + M_target + (r : ℤ) * (t₁ : ℤ) := by
                rw [hM_eq]
                linarith [h_excess]
              have hmin_le : (min ((r : ℕ) + 1) (m + 1) : ℤ) * (t₁ : ℤ) ≤ ((r : ℤ) + 1) * (t₁ : ℤ) := by
                refine mul_le_mul_of_nonneg_right ?_ (by omega)
                omega
              have hp_le : (p : ℤ) * (v + (min ((r : ℕ) + 1) (m + 1) : ℤ) * (t₁ : ℤ)) ≤
                  (p : ℤ) * valL F E' (Y_tilde r - Y' Y r) := by
                have hp_min : (p : ℤ) * ((min ((r : ℕ) + 1) (m + 1) : ℤ) * (t₁ : ℤ)) ≤
                    (p : ℤ) * (((r : ℤ) + 1) * (t₁ : ℤ)) :=
                  mul_le_mul_of_nonneg_left hmin_le (by omega)
                linarith [hle, h_poly, hp_min]
              have hp_pos_z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
              nlinarith
          have hsub_eq : Y' Y r = Y_tilde r - (Y_tilde r - Y' Y r) := by ring
          rw [hsub_eq]
          exact val_sub_E' (hY_tilde_bound r) hdiff_r
        have hInner : ∀ d : ℕ, d ≤ p - 2 →
            Y ⟨p - 2 - d + 1, by omega⟩ = 0 ∨
              v + min ((p - 2 - d + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
                valL F E' (Y ⟨p - 2 - d + 1, by omega⟩) := by
          intro d
          induction' d using Nat.strong_induction_on with d ih_d
          intro hd_le
          set r₀ : ℕ := p - 2 - d
          let r_fin : Fin p := ⟨r₀, by omega⟩
          let j₀ : Fin p := ⟨r₀ + 1, by omega⟩
          have herase := Finset.add_sum_erase Finset.univ
            (fun i : Fin p => U r_fin i * Y i) (Finset.mem_univ j₀)
          dsimp only at herase
          have h_isolate : U r_fin j₀ * Y j₀ =
              Y' Y r_fin - ∑ i ∈ Finset.univ.erase j₀, U r_fin i * Y i := by
            dsimp [Y']
            rw [← herase, add_sub_cancel_right]
          have hU_diag : U r_fin j₀ = ((r₀ + 1 : ℕ) : E') * D₀ := by
            dsimp [U, r_fin, j₀]
            have hlt : r₀ < r₀ + 1 := by omega
            have hsub1 : (r₀ + 1) - r₀ = 1 := by omega
            rw [if_pos hlt, hsub1, pow_one, Nat.choose_succ_self_right r₀]
          have hsum_erase_val : (∑ i ∈ Finset.univ.erase j₀, U r_fin i * Y i) = 0 ∨
              v + min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
                valL F E' (∑ i ∈ Finset.univ.erase j₀, U r_fin i * Y i) := by
            refine val_sum_E' (Finset.univ.erase j₀) (fun i => U r_fin i * Y i)
              (v + min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ)) fun i hi => ?_
            dsimp only
            have hne : i ≠ j₀ := (Finset.mem_erase.mp hi).1
            by_cases hlt : r₀ < (i : ℕ)
            · have hne_val : (i : ℕ) ≠ r₀ + 1 := by
                intro heq
                apply hne
                exact Fin.ext heq
              have hi_ge : r₀ + 2 ≤ (i : ℕ) := by omega
              have hi_lt : (i : ℕ) < p := i.isLt
              set d' : ℕ := p - 1 - (i : ℕ)
              have hd'_lt : d' < d := by omega
              have hd'_le : d' ≤ p - 2 := by omega
              have hih_d' := ih_d d' hd'_lt hd'_le
              have hj'_eq : (⟨p - 2 - d' + 1, by omega⟩ : Fin p) = i := by
                ext
                dsimp [d']
                omega
              have hYi_d' : Y i = 0 ∨
                  v + min ((p - 2 - d' + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) := by
                rw [← hj'_eq]
                exact hih_d'
              have hYi_ge : Y i = 0 ∨
                  v + min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) := by
                refine val_mono_E' ?_ hYi_d'
                have hmin_le : min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) ≤
                    min ((p - 2 - d' + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) := by
                  dsimp [d']
                  omega
                have hmul_le : min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
                    min ((p - 2 - d' + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) :=
                  mul_le_mul_of_nonneg_right hmin_le (by omega)
                linarith
              have hU_ge0 : U r_fin i = 0 ∨ (0 : ℤ) ≤ valL F E' (U r_fin i) := by
                dsimp [U, r_fin]
                rw [if_pos hlt]
                have hmul := val_mul_E' (val_natCast_E' (Nat.choose (i : ℕ) r₀))
                  (hD₀_pow_val ((i : ℕ) - r₀))
                exact val_mono_E' (by omega) hmul
              have hmul := val_mul_E' hU_ge0 hYi_ge
              exact val_mono_E' (by omega) hmul
            · left
              have hU0 : U r_fin i = 0 := by
                dsimp [U, r_fin]
                exact if_neg hlt
              rw [hU0, zero_mul]
          have hY'_rfin : Y' Y r_fin = 0 ∨
              v + min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y' Y r_fin) := by
            have hb := hY'_bound r_fin (by dsimp [r_fin]; omega)
            refine val_mono_E' ?_ hb
            have hmin_eq : min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) =
                (min ((r_fin : ℕ) + 1) (m + 1) : ℤ) := by
              dsimp [r_fin]
            rw [hmin_eq]
          have hprod_val : U r_fin j₀ * Y j₀ = 0 ∨
              v + min ((r₀ + 1 : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ valL F E' (U r_fin j₀ * Y j₀) := by
            rw [h_isolate]
            exact val_sub_E' hY'_rfin hsum_erase_val
          rw [hU_diag] at hprod_val
          obtain ⟨hnat_ne0, hnat_val0⟩ := hcoprime_E' (r₀ + 1) (by omega) (by omega)
          set c₀ : E' := ((r₀ + 1 : ℕ) : E') * D₀
          have hc₀_ne0 : c₀ ≠ 0 := mul_ne_zero hnat_ne0 hD₀_ne0
