      dsimp only [w₁]
      rw [map_mul, hδ_norm, map_inv, hnorm_inc_unit M_C K hM_CK u_zδ]
    rw [← hw₁_norm_eq, hunit_ge1_MC 1 le_rfl]
    have huniv := hprod_one_add Finset.univ
    have hprod_eq :
        (∏ σ : G, (1 + act σ y₁)) - 1 =
