    rw [(hvalK_pow π k hϖ_K_ne0).2, hϖ_K, mul_one]
  have hδ_K_coe : (δ_K : K) = (u_L_K : K) * (π ^ k) * ((η_half⁻¹ : Kˣ) : K) := by
    change (((u_L_K * (ϖ_K ^ k) * η_half⁻¹ : Kˣ) : K)) = _
    rw [Units.val_mul, Units.val_mul, hϖ_K_k_coe]
  have hδ_K_val : valL F K (δ_K : K) = (d_K : ℤ) := by
    have h12_ne0 : (u_L_K : K) * (π ^ k) ≠ 0 := mul_ne_zero hu_L_K_ne0 hϖ_K_k_ne0
    rw [hδ_K_coe, hvalK_mul ((u_L_K : K) * (π ^ k)) ((η_half⁻¹ : Kˣ) : K) h12_ne0 hη_inv_ne0,
      hvalK_mul (u_L_K : K) (π ^ k) hu_L_K_ne0 hϖ_K_k_ne0,
      hu_L_K_val, hϖ_K_k_val, hη_inv_val]
    have hd_eq' : 2 * d_K + (2 * k) * (t + 1) = p * (2 * d_a) + 2 * k := by
      rwa [hp_sub_eq_2k] at hd_eq
    have hd_eq_Z : (2 * (d_K : ℤ)) + (2 * (k : ℤ)) * ((t : ℤ) + 1) =
        (p : ℤ) * (2 * (d_a : ℤ)) + 2 * (k : ℤ) := by
      exact_mod_cast hd_eq'
    linarith
  set y_euler : K := (π ^ (p - 1)) * δ_diff⁻¹
  set c_L : L := (ϖ_L : L) ^ (2 * d_a)
  set a_L : L := (-1 : L) ^ k * c_L
  have hu_L_K_sq : (u_L_K : K) ^ 2 = IntermediateField.inclusion hLK c_L := by
    rw [hu_L_K_coe, ← map_pow]
    congr 1
    rw [← pow_mul, mul_comm d_a 2]
  have hπ_k_sq : (π ^ k) ^ 2 = π ^ (p - 1) := by
    rw [← pow_mul, mul_comm k 2, ← hp_sub_eq_2k]
  have hδ_diff_cancel : δ_diff * δ_diff⁻¹ = 1 := mul_inv_cancel₀ hδ_diff_ne0
  have hδ_K_sq : (δ_K : K) ^ 2 = IntermediateField.inclusion hLK c_L * y_euler * U_ratio := by
    calc (δ_K : K) ^ 2
      _ = ((u_L_K : K) ^ 2) * ((π ^ k) ^ 2) * (((η_half⁻¹ : Kˣ) : K) ^ 2) := by
          rw [hδ_K_coe]
          ring
      _ = IntermediateField.inclusion hLK c_L * (π ^ (p - 1)) * (((η_half⁻¹ : Kˣ) : K) ^ 2) := by
          rw [hu_L_K_sq, hπ_k_sq]
      _ = IntermediateField.inclusion hLK c_L * (π ^ (p - 1)) * (δ_diff * δ_diff⁻¹) *
            (((η_half⁻¹ : Kˣ) : K) ^ 2) := by
          rw [hδ_diff_cancel, mul_one]
      _ = IntermediateField.inclusion hLK c_L * ((π ^ (p - 1)) * δ_diff⁻¹) *
            (δ_diff * (((η_half⁻¹ : Kˣ) : K) ^ 2)) := by ring
      _ = IntermediateField.inclusion hLK c_L * y_euler * U_ratio := by
          rw [hδ_diff_mul_η_inv_sq]
  have hincl_a_L : IntermediateField.inclusion hLK a_L =
      (-1 : K) ^ k * IntermediateField.inclusion hLK c_L := by
    change IntermediateField.inclusion hLK ((-1 : L) ^ k * c_L) = _
    rw [map_mul, map_pow, map_neg, map_one]
  set rem_K : K := (δ_K : K) ^ 2 - IntermediateField.inclusion hLK a_L * y_euler
  have hrem_K_eq : rem_K = (IntermediateField.inclusion hLK c_L * y_euler) *
      (U_ratio - (-1 : K) ^ k) := by
    change (δ_K : K) ^ 2 - IntermediateField.inclusion hLK a_L * y_euler = _
    rw [hδ_K_sq, hincl_a_L]
    ring
  have hc_L_ne0 : c_L ≠ 0 := (hvalL_pow (ϖ_L : L) (2 * d_a) hϖ_L_ne0).1
  have hincl_c_L_ne0 : IntermediateField.inclusion hLK c_L ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLK)).mpr hc_L_ne0
  have hincl_c_L_val : valL F K (IntermediateField.inclusion hLK c_L) =
      (p : ℤ) * (2 * (d_a : ℤ)) := by
    rw [hval_alg, ← hp_def, (hvalL_pow (ϖ_L : L) (2 * d_a) hϖ_L_ne0).2, hϖ_L, mul_one]
    push_cast
    ring
  have hδ_diff_inv_spec : δ_diff⁻¹ ≠ 0 ∧
      valL F K δ_diff⁻¹ = - (((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) := by
    let u_δ : Kˣ := Units.mk0 δ_diff hδ_diff_ne0
    have hcoe_inv : δ_diff⁻¹ = ((u_δ⁻¹ : Kˣ) : K) := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    refine ⟨inv_ne_zero hδ_diff_ne0, ?_⟩
    rw [hcoe_inv, hvalK_inv u_δ, Units.val_mk0, hδ_diff_val]
  have hy_euler_spec : y_euler ≠ 0 ∧
      valL F K y_euler = ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
    have hπ_p1 := hvalK_pow π (p - 1) hϖ_K_ne0
    refine ⟨mul_ne_zero hπ_p1.1 hδ_diff_inv_spec.1, ?_⟩
    change valL F K ((π ^ (p - 1)) * δ_diff⁻¹) = _
    rw [hvalK_mul (π ^ (p - 1)) δ_diff⁻¹ hπ_p1.1 hδ_diff_inv_spec.1,
      hπ_p1.2, hϖ_K, mul_one, hδ_diff_inv_spec.2]
    ring
  have hcy_val : IntermediateField.inclusion hLK c_L * y_euler = 0 ∨
      ((p : ℤ) * (2 * (d_a : ℤ)) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) ≤
        valL F K (IntermediateField.inclusion hLK c_L * y_euler) := by
    refine Or.inr ?_
    rw [hvalK_mul (IntermediateField.inclusion hLK c_L) y_euler hincl_c_L_ne0 hy_euler_spec.1,
      hincl_c_L_val, hy_euler_spec.2]
    linarith
  have hrem_K_val : rem_K = 0 ∨
      (p : ℤ) * (2 * (d_a : ℤ) + 1) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K rem_K := by
    have hmul := hvalK_mul_ge
      ((p : ℤ) * (2 * (d_a : ℤ)) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) 1
      (IntermediateField.inclusion hLK c_L * y_euler) (U_ratio - (-1 : K) ^ k)
      hcy_val hU_ratio_cong
    rw [← hrem_K_eq] at hmul
    rcases hmul with h0 | hge
    · exact Or.inl h0
    · refine Or.inr ?_
      linarith [hp1_cast]
  have htr_rem := htr_bound (2 * (d_a : ℤ) + 1) rem_K hrem_K_val
  have htr_rem_eq : traceLM F hLK rem_K =
      traceLM F hLK ((δ_K : K) ^ 2) - (-1 : L) ^ ((p - 1) / 2) * ((ϖ_L : L) ^ (2 * d_a)) := by
    change traceLM F hLK ((δ_K : K) ^ 2 - IntermediateField.inclusion hLK a_L * y_euler) = _
    rw [map_sub (traceLM F hLK), htr_smul a_L y_euler, htr_euler, mul_one]
  rw [htr_rem_eq] at htr_rem
  exact ⟨δ_K, hδ_K_val, htr_rem⟩

theorem ld_wild_odd_orbit_symm_and_euler_half_diff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (haddVal1 : addVal F 1 = 0)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (t : ℕ) (w_star : Kˣ) (ht_ge1 : 1 ≤ t)
    (hw_star_t : w_star ∈ unitGroup F K t)
    (hw_star_nt1 : w_star ∉ unitGroup F K (t + 1))
    (hw_star_norm : Units.map (normLM F hLK) w_star = 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (htr_surj : ∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x +
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    (∃ s : K → ℕ → L,
      (∀ y : K, s y 1 = traceLM F hLK y) ∧
      (∀ y : K, 2 * s y 2 = (traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2)) ∧
      (∀ y : K, y ≠ 0 → s y (p - 1) = normLM F hLK y * traceLM F hLK (y⁻¹)) ∧
      (∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
        ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
          (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (r : ℤ) * q →
          (s y r = 0 ∨ m ≤ valL F L (s y r))) ∧
      (∀ (y : K) (c : L),
        normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
          1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) +
            c ^ p * normLM F hLK y)) ∧
    (∀ (d_a d_K : ℕ),
      2 * d_K + (p - 1) * (t + 1) = p * (2 * d_a) + (p - 1) →
      ∃ δ_K : Kˣ,
        valL F K (δ_K : K) = (d_K : ℤ) ∧
        (traceLM F hLK ((δ_K : K) ^ 2) -
            (-1 : L) ^ ((p - 1) / 2) * ((ϖ_L : L) ^ (2 * d_a)) = 0 ∨
          (2 * d_a + 1 : ℤ) ≤
            valL F L
              (traceLM F hLK ((δ_K : K) ^ 2) -
                (-1 : L) ^ ((p - 1) / 2) * ((ϖ_L : L) ^ (2 * d_a))))) :=
by
  intro p
  obtain ⟨G, hGroupG, hFinG, act, t_true, w_star', hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, _, hact_val, hact_trace, hact_norm, ht_true_ge1, _, _, _, hjump_true⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L K hLK hGal hPrime hEqP
      haddVal1 halg1 hvalL_props hvalK_props hval_norm hval_alg ϖ_K hϖ_K hBasis
  letI : Group G := hGroupG
  letI : Fintype G := hFinG
  obtain ⟨htr_bound_true, htr_surj_true⟩ :=
    ld_wild_euler_lagrange_trace_formula F L K hLK hPrime hvalL_props hvalK_props
      hval_alg ϖ_K hϖ_K hBasis G act hcard_G hact_one hact_mul hact_ring
      hact_incl hact_trace t_true hjump_true
  have hp_def : Module.finrank L (IntermediateField.extendScalars hLK) = p := rfl
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have h1L_ne0 : (1 : L) ≠ 0 := one_ne_zero
  have hvalL_1 : valL F L 1 = 0 := hvalL_props.2.1
  have ht_eq : t_true = t := by
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · obtain ⟨y₁, hy₁_tr, _, hy₁_spec⟩ := htr_surj_true 1
      obtain ⟨_, hy₁_val⟩ := hy₁_spec h1L_ne0
      have hge : (p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K y₁ := by
        rw [hy₁_val, hvalL_1, hp_def]
        have h_mul : (1 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((t : ℤ) - (t_true : ℤ)) := by
          calc (1 : ℤ) = 1 * 1 := by ring
            _ ≤ ((p - 1 : ℕ) : ℤ) * ((t : ℤ) - (t_true : ℤ)) := by
              apply mul_le_mul <;> omega
        linarith
      have htr1 := htr_bound 1 y₁ (Or.inr hge)
      rw [hy₁_tr, hvalL_1] at htr1
      rcases htr1 with h0 | h1
      · exact h1L_ne0 h0
      · omega
    · obtain ⟨y₁, hy₁_tr, _, hy₁_spec⟩ := htr_surj 1
      obtain ⟨_, hy₁_val⟩ := hy₁_spec h1L_ne0
      have hge : (p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (t_true + 1 : ℤ) ≤ valL F K y₁ := by
        rw [hy₁_val, hvalL_1, hp_def]
        have h_mul : (1 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((t_true : ℤ) - (t : ℤ)) := by
          calc (1 : ℤ) = 1 * 1 := by ring
            _ ≤ ((p - 1 : ℕ) : ℤ) * ((t_true : ℤ) - (t : ℤ)) := by
              apply mul_le_mul <;> omega
        linarith
      have htr1 := htr_bound_true 1 y₁ (Or.inr hge)
      rw [hy₁_tr, hvalL_1] at htr1
      rcases htr1 with h0 | h1
      · exact h1L_ne0 h0
      · omega
  subst ht_eq
  refine ⟨ld_wild_odd_free_orbit_symm_functions F L K hLK hPrime hp_odd hvalK_props
      t_true htr_bound G act hcard_G hact_one hact_mul hact_ring hact_incl hact_val
      hact_trace hact_norm, ?_⟩
  have hshift_top :=
    ld_wild_galois_action_shift_and_euler_top_trace F L K hLK hPrime hvalK_props
      hval_alg ϖ_K hϖ_K hBasis G act hcard_G hact_one hact_mul hact_ring
      hact_incl hact_val hact_trace t_true hjump_true
  exact ld_wild_odd_euler_half_diff_element F L K hLK hPrime hp_odd hvalL_props
    hvalK_props hval_alg ϖ_K ϖ_L hϖ_K hϖ_L t_true ht_ge1 htr_bound
    G act hcard_G hact_one hact_mul hact_ring hact_incl hact_trace
    hjump_true hshift_top.1 hshift_top.2

theorem ld_wild_mid_cond_odd_prime_nat_unit_and_contragredient_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (ψ : AddChar L (Ω F))
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ p = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hp_val : ((p : L) = 0 ∨
      ((((p - 1) * condExp F L ν₁ / p : ℕ) : ℤ) ≤ valL F L (p : L))))
    (c_ν₁ : Lˣ)
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x)) :
    ((p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L)) ∧
    ∀ j < p, 0 < j →
      ∃ c_j c'_j : Lˣ,
        valL F L (c_j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
        (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_j⁻¹ : Lˣ) : L) * x)) ∧
        valL F L (c'_j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
        (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            ((ν₁ ^ (p - j)) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c'_j)⁻¹ : Lˣ) : L) * x)) ∧
        (((c'_j)⁻¹ : Lˣ) : L) = - (((c_j⁻¹ : Lˣ) : L)) ∧
        (∀ u : Lˣ, ((ν₁ ^ (p - j)) u : Ω F)⁻¹ = ((ν₁ ^ j) u : Ω F)) ∧
        ((ν₁ ^ j) c_j : Ω F) * ((ν₁ ^ (p - j)) c'_j : Ω F) = 1 ∧
        ψ (((c_j⁻¹ : Lˣ) : L)) * ψ ((((c'_j)⁻¹ : Lˣ) : L)) = 1 :=
by
  rcases hvalL_props with ⟨hval0, hval1, _, hval_neg, hval_mul,
    hval_inv, _, hval_add, _, _, _⟩
  set b := condExp F L ν₁
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd_mod : p % 2 = 1 := hPrime.eq_two_or_odd.resolve_left hp_odd
  have hp_ge3 : 3 ≤ p := by omega
  have hmp_ge1 : 1 ≤ (p - 1) * b / p := by
    rw [Nat.le_div_iff_mul_le hp_pos]
    calc 1 * p ≤ (p - 1) * 2 := by omega
      _ ≤ (p - 1) * b := Nat.mul_le_mul_left (p - 1) hb_ge2
  have hp_val1 : (p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L) := by
    rcases hp_val with hp0 | hge
    · exact Or.inl hp0
    · exact Or.inr (by omega)
  have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by omega)
  have hnat_res : ∀ m : ℕ,
      ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      simp [hresL_0]
    | succ m ih =>
      rw [Nat.cast_succ, Nat.cast_succ]
      refine ⟨hval_add 0 (m : L) 1 ih.1 h1_int, ?_⟩
      rw [(hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1]
  have hp_kL : (p : k_L) = 0 := by
    rw [← (hnat_res p).2]
    exact (hresL_ker (p : L) (hnat_res p).1).mpr hp_val1
  have hring : ringChar k_L = p := by
    have hdvd : ringChar k_L ∣ p := (ringChar.spec k_L p).mp hp_kL
    rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | hp_eq
    · exfalso
      have h1_zero : ((1 : ℕ) : k_L) = 0 :=
        (ringChar.spec k_L 1).mpr (by rw [h1])
      rw [Nat.cast_one] at h1_zero
      exact one_ne_zero h1_zero
    · exact hp_eq
  have hj_ne_val0 : ∀ j < p, 0 < j → (j : L) ≠ 0 ∧ valL F L (j : L) = 0 := by
    intro j hj_lt hj_pos
    have hndvd : ¬ (ringChar k_L ∣ j) := by
      rw [hring]
      exact Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
    have hj_kL_ne0 : (j : k_L) ≠ 0 :=
      fun h0 => hndvd ((ringChar.spec k_L j).mp h0)
    have hres_j_ne0 : resL (j : L) ≠ 0 := by
      rw [(hnat_res j).2]
      exact hj_kL_ne0
    have hnot_ker : ¬ ((j : L) = 0 ∨ 1 ≤ valL F L (j : L)) :=
      fun hker => hres_j_ne0 ((hresL_ker (j : L) (hnat_res j).1).mpr hker)
    have hj_int := (hnat_res j).1
    refine ⟨fun h0 => hnot_ker (Or.inl h0), ?_⟩
    rcases hj_int with h0 | hge0
    · exact False.elim (hnot_ker (Or.inl h0))
    · omega
  have hneg1_sq : (-1 : Lˣ) ^ 2 = 1 := by
    ext
    simp
  have hν₁_neg1_sq : (ν₁ (-1 : Lˣ)) ^ 2 = 1 := by
    rw [← map_pow, hneg1_sq, map_one]
  have hν₁_neg1 : ν₁ (-1 : Lˣ) = 1 := by
    have hp_decomp : p = 2 * (p / 2) + 1 := by omega
    have hpow_p : (ν₁ (-1 : Lˣ)) ^ p = 1 := by
      rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
    rw [hp_decomp, pow_add, pow_mul, hν₁_neg1_sq, one_pow, one_mul, pow_one] at hpow_p
    exact hpow_p
  have hψ_neg_mul : ∀ z : L, ψ (-z) * ψ z = 1 := by
    intro z
    rw [← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one]
  have hψ_neg : ∀ z : L, ψ (-z) = (ψ z)⁻¹ := by
    intro z
    exact eq_inv_of_mul_eq_one_left (hψ_neg_mul z)
  refine ⟨hp_val1, ?_⟩
  intro j hj_lt hj_pos
  obtain ⟨hj_ne, hj_val0⟩ := hj_ne_val0 j hj_lt hj_pos
  let u_j : Lˣ := Units.mk0 (j : L) hj_ne
  let c_j : Lˣ := c_ν₁ * u_j⁻¹
  let c'_j : Lˣ := (-1 : Lˣ) * c_j
  have hc_j_inv : ((c_j⁻¹ : Lˣ) : L) = (j : L) * ((c_ν₁⁻¹ : Lˣ) : L) := by
    have hinv : c_j⁻¹ = u_j * c_ν₁⁻¹ := by
      dsimp [c_j]
      rw [mul_inv_rev, inv_inv]
    rw [hinv, Units.val_mul]
    rfl
  have hc'_j_inv : (((c'_j)⁻¹ : Lˣ) : L) = - (((c_j⁻¹ : Lˣ) : L)) := by
    have hinv : (c'_j)⁻¹ = (-1 : Lˣ) * c_j⁻¹ := by
      dsimp [c'_j]
      rw [mul_inv_rev, inv_neg, inv_one, mul_comm]
    rw [hinv, Units.val_mul, Units.val_neg, Units.val_one, neg_one_mul]
  have hc_j_val : valL F L (c_j : L) = (b : ℤ) + condExpChar F L ψ := by
    change valL F L ((c_ν₁ : L) * ((u_j⁻¹ : Lˣ) : L)) = (b : ℤ) + condExpChar F L ψ
    rw [hval_mul (c_ν₁ : L) ((u_j⁻¹ : Lˣ) : L) (Units.ne_zero c_ν₁) (Units.ne_zero _),
      hc_ν₁_val, hval_inv u_j]
    change (b : ℤ) + condExpChar F L ψ + - valL F L (j : L) = _
    rw [hj_val0, neg_zero, add_zero]
  have hc'_j_val : valL F L (c'_j : L) = (b : ℤ) + condExpChar F L ψ := by
    have hcoe : (c'_j : L) = - (c_j : L) := by
      change ((-1 : Lˣ) : L) * (c_j : L) = - (c_j : L)
      rw [Units.val_neg, Units.val_one, neg_one_mul]
    rw [hcoe, hval_neg, hc_j_val]
  have hν_prod_unit : ∀ u : Lˣ, (ν₁ ^ j) u * (ν₁ ^ (p - j)) u = 1 := by
    intro u
    rw [← MonoidHom.mul_apply, ← pow_add, Nat.add_sub_of_le (le_of_lt hj_lt),
      hν₁_pow, MonoidHom.one_apply]
  have hν_pj_eq_inv : ∀ u : Lˣ,
      ((ν₁ ^ (p - j)) u : Ω F) = (((ν₁ ^ j) u : Ω F))⁻¹ := by
    intro u
    have h1 : (ν₁ ^ (p - j)) u = ((ν₁ ^ j) u)⁻¹ :=
      eq_inv_of_mul_eq_one_right (hν_prod_unit u)
    rw [h1, Units.val_inv_eq_inv_val]
  have hν_pj_inv : ∀ u : Lˣ,
      ((ν₁ ^ (p - j)) u : Ω F)⁻¹ = ((ν₁ ^ j) u : Ω F) := by
    intro u
    rw [hν_pj_eq_inv u, inv_inv]
  have hc_j_stat : ∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_j⁻¹ : Lˣ) : L) * x) := by
    intro x hx_dom hx
    rw [MonoidHom.pow_apply, Units.val_pow_eq_pow_val, hc_ν₁_stat x hx_dom hx,
      ← AddChar.map_nsmul_eq_pow, nsmul_eq_mul, hc_j_inv, mul_assoc]
  have hc'_j_stat : ∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        ((ν₁ ^ (p - j)) (Units.mk0 (1 + x) hx) : Ω F) =
          ψ ((((c'_j)⁻¹ : Lˣ) : L) * x) := by
    intro x hx_dom hx
    rw [hν_pj_eq_inv (Units.mk0 (1 + x) hx), hc_j_stat x hx_dom hx,
      hc'_j_inv, neg_mul, hψ_neg]
  have hν_c_prod : ((ν₁ ^ j) c_j : Ω F) * ((ν₁ ^ (p - j)) c'_j : Ω F) = 1 := by
    have hc'_eq : (ν₁ ^ (p - j)) c'_j = (ν₁ ^ (p - j)) c_j := by
      change (ν₁ ^ (p - j)) ((-1 : Lˣ) * c_j) = (ν₁ ^ (p - j)) c_j
      rw [map_mul, MonoidHom.pow_apply, hν₁_neg1, one_pow, one_mul]
    rw [hc'_eq, ← Units.val_mul, hν_prod_unit c_j, Units.val_one]
  have hψ_c_prod :
      ψ (((c_j⁻¹ : Lˣ) : L)) * ψ ((((c'_j)⁻¹ : Lˣ) : L)) = 1 := by
    rw [hc'_j_inv, ← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
  exact ⟨c_j, c'_j, hc_j_val, hc_j_stat, hc'_j_val, hc'_j_stat,
    hc'_j_inv, hν_pj_inv, hν_c_prod, hψ_c_prod⟩

theorem ld_wild_odd_cond_polar_hasse_inv_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (R_L : Finset L)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (θ : Lˣ →* (Ω F)ˣ) (c : Lˣ)
    (hb_ge2 : 2 ≤ condExp F L θ)
    (hb_odd : condExp F L θ % 2 = 1)
    (hc_val : valL F L (c : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hc_stat : ∀ x : L, (x = 0 ∨ (((condExp F L θ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c⁻¹ : Lˣ) : L) * x)) :
    (∑ r ∈ R_L,
      if hr : 1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r ≠ 0 then
        (θ (Units.mk0 (1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
          ψ (((c⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r)
      else 0) *
    (∑ r ∈ R_L,
      if hr : 1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r ≠ 0 then
        (θ (Units.mk0 (1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r) hr) : Ω F) *
          ψ ((- ((c⁻¹ : Lˣ) : L)) * ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r)
      else 0) =
    (Fintype.card k_L : Ω F) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalL_props
  set b : ℕ := condExp F L θ
  set d_b : ℕ := b / 2
  set r₀ : ℕ := (b + 1) / 2
  set n : ℤ := condExpChar F L ψ
  set A : L := ((c⁻¹ : Lˣ) : L)
  have hb_ne0 : b ≠ 0 := by omega
  have hb_ge1 : 1 ≤ b := by omega
  have hd_ge1 : 1 ≤ d_b := by omega
  have hb_eq_2d1 : b = 2 * d_b + 1 := by omega
  have hr0_eq : r₀ = d_b + 1 := by omega
  have hψ_triv : ∀ x : L, (x = 0 ∨ -n ≤ valL F L x) → ψ x = 1 := (hSpecL 1).1
  have hψ_nontriv : ∃ x₁ : L, x₁ ≠ 0 ∧ -(n + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1 := (hSpecL 1).2.1
  have hθ_triv : ∀ u ∈ unitGroup F L b, θ u = 1 := ((hSpecL θ).2.2.1 hb_ne0).1
  let P : ℤ → L → Prop := fun k x => x = 0 ∨ k ≤ valL F L x
  have hP_zero : ∀ k : ℤ, P k 0 := fun _ => Or.inl rfl
  have hP_one : P 0 1 := Or.inr (by rw [hval1])
  have hP_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {x : L}, P k₂ x → P k₁ x := by
    intro k₁ k₂ hk x hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hP_neg : ∀ {k : ℤ} {x : L}, P k x → P k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp [P]
    · right; rw [hval_neg]; exact hx
  have hP_add : ∀ {k : ℤ} {x y : L}, P k x → P k y → P k (x + y) :=
    fun hx hy => hval_add _ _ _ hx hy
  have hP_sub : ∀ {k : ℤ} {x y : L}, P k x → P k y → P k (x - y) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hP_add hx (hP_neg hy)
  have hP_mul : ∀ {k₁ k₂ : ℤ} {x y : L}, P k₁ x → P k₂ y → P (k₁ + k₂) (x * y) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hP_sq : ∀ {k : ℤ} {x : L}, P k x → P (k + k) (x ^ 2) := by
    intro k x hx
    rw [sq]
    exact hP_mul hx hx
  have hP_of_val : ∀ {k : ℤ} {x : L}, valL F L x = k → P k x := by
    intro k x h
    exact Or.inr (by omega)
  have hA_val : valL F L A = -((b : ℤ) + n) := by
    dsimp only [A]
    rw [hval_inv c, hc_val]
  have hP_A : P (-((b : ℤ) + n)) A := hP_of_val hA_val
  have h1_add_ne : ∀ {y : L}, P 1 y → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : y = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hy_eq] at hy
    rcases hy with h_neg1_0 | h_val
    · exact one_ne_zero (neg_eq_zero.mp h_neg1_0)
    · rw [hval_neg1] at h_val
      omega
  have h1_add_val : ∀ {y : L} (hy : P 1 y), valL F L (1 + y) = 0 := by
    intro y hy
    set u := Units.mk0 (1 + y) (h1_add_ne hy)
    have hu_mem : u ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u]
      change (1 + y : L) = 1 ∨ (1 : ℤ) ≤ valL F L ((1 + y : L) - 1)
      rw [add_sub_cancel_left]
      rcases hy with rfl | hy'
      · left; rw [add_zero]
      · right; exact hy'
    exact hunit_val0 1 u hu_mem
  have hψ_congr : ∀ {x y : L}, P (-n) (x - y) → ψ x = ψ y := by
    intro x y hxy
    have h_eq : x = (x - y) + y := by ring
    rw [h_eq, ψ.map_add_eq_mul, hψ_triv (x - y) hxy, one_mul]
  have hψ_neg_eq_inv : ∀ z : L, ψ (-z) = (ψ z)⁻¹ := by
    intro z
    apply eq_inv_of_mul_eq_one_left
    rw [← ψ.map_add_eq_mul, neg_add_cancel, ψ.map_zero_eq_one]
  have hθ_congr : ∀ {u v : Lˣ}, valL F L (u : L) = 0 → P (b : ℤ) ((v : L) - (u : L)) → θ v = θ u := by
    intro u v hu_val hvu
    set q : Lˣ := u⁻¹ * v
    have hq_sub : ((q : Lˣ) : L) - 1 = ((u⁻¹ : Lˣ) : L) * ((v : L) - (u : L)) := by
      have h_inv : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := by exact_mod_cast Units.inv_mul u
      dsimp only [q]
      rw [Units.val_mul, ← h_inv]
      ring
    have hu_inv_P : P 0 ((u⁻¹ : Lˣ) : L) := by
      apply hP_of_val
      rw [hval_inv u, hu_val, neg_zero]
    have hq_P : P (b : ℤ) (((q : Lˣ) : L) - 1) := by
      rw [hq_sub, ← zero_add (b : ℤ)]
      exact hP_mul hu_inv_P hvu
    have hq_mem : q ∈ unitGroup F L b := by
      rw [hunit_ge1 b hb_ge1 q]
      rcases hq_P with h0 | hge
      · left; exact sub_eq_zero.mp h0
      · right; exact hge
    have hv_eq : v = u * q := by simp [q]
    rw [hv_eq, map_mul, hθ_triv q hq_mem, mul_one]
  have hϖ_pow_val : ∀ k : ℕ, valL F L (((ϖ_L ^ k : Lˣ) : L)) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hval1]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_L]
      push_cast
      ring
  set δ_b : Lˣ := ϖ_L ^ d_b
  have hδb_val : valL F L (δ_b : L) = (d_b : ℤ) := hϖ_pow_val d_b
  have hP_δb : P (d_b : ℤ) (δ_b : L) := hP_of_val hδb_val
  let liftL : k_L → L := fun y => Classical.choose (hresL_surj y)
  have hliftL_int : ∀ y : k_L, P 0 (liftL y) :=
    fun y => (Classical.choose_spec (hresL_surj y)).1
  have hliftL_res : ∀ y : k_L, resL (liftL y) = y :=
    fun y => (Classical.choose_spec (hresL_surj y)).2
  have hresL_sub_mem1 : ∀ {x₁ x₂ : L}, P 0 x₁ → P 0 x₂ → resL x₁ = resL x₂ → P 1 (x₁ - x₂) := by
    intro x₁ x₂ hx₁ hx₂ hres
    have hsub_int : P 0 (x₁ - x₂) := hP_sub hx₁ hx₂
    have hres_sub : resL (x₁ - x₂) = 0 := by
      rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ (hP_neg hx₂)).1,
        (hresL_ring x₂ 0 hx₂ (hP_zero 0)).2.2, hres, add_neg_cancel]
    exact (hresL_ker (x₁ - x₂) hsub_int).mp hres_sub
  let ψ₀_fn : k_L → Ω F := fun y => ψ (A * (δ_b : L) ^ 2 * liftL y)
  have hψ₀_spec : ∀ z : L, P 0 z → ψ₀_fn (resL z) = ψ (A * (δ_b : L) ^ 2 * z) := by
    intro z hz
    dsimp only [ψ₀_fn]
    symm
    apply hψ_congr
    have h_eq : A * (δ_b : L) ^ 2 * z - A * (δ_b : L) ^ 2 * liftL (resL z) =
        A * ((δ_b : L) ^ 2 * (z - liftL (resL z))) := by ring
    rw [h_eq]
    have hΔ1 : P 1 (z - liftL (resL z)) :=
      hresL_sub_mem1 hz (hliftL_int (resL z)) (hliftL_res (resL z)).symm
    exact hP_mono (by omega) (hP_mul hP_A (hP_mul (hP_sq hP_δb) hΔ1))
  have hψ₀_0 : ψ₀_fn 0 = 1 := by
    rw [← hresL_0, hψ₀_spec 0 (hP_zero 0), mul_zero, ψ.map_zero_eq_one]
  have hψ₀_add : ∀ x y : k_L, ψ₀_fn (x + y) = ψ₀_fn x * ψ₀_fn y := by
    intro x y
    set zx := liftL x
    set zy := liftL y
    have hzx : P 0 zx := hliftL_int x
    have hzy : P 0 zy := hliftL_int y
    have hxy_res : x + y = resL (zx + zy) := by
      rw [(hresL_ring zx zy hzx hzy).1, hliftL_res x, hliftL_res y]
    rw [hxy_res, hψ₀_spec (zx + zy) (hP_add hzx hzy),
      ← hliftL_res x, ← hliftL_res y, hψ₀_spec zx hzx, hψ₀_spec zy hzy,
      ← ψ.map_add_eq_mul]
    congr 1
    ring
  obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ_ne1⟩ := hψ_nontriv
  have hx₁_P : P (-(n + 1)) x₁ := Or.inr hx₁_val
  set u_scale : Lˣ := c * (δ_b ^ 2)⁻¹
  set z₁ : L := (u_scale : L) * x₁
  set z₀ : k_L := resL z₁
  have hδb2_inv_val : valL F L (((δ_b ^ 2)⁻¹ : Lˣ) : L) = -((d_b : ℤ) + (d_b : ℤ)) := by
    rw [hval_inv (δ_b ^ 2), Units.val_pow_eq_pow_val, sq,
      hval_mul (δ_b : L) (δ_b : L) (Units.ne_zero _) (Units.ne_zero _), hδb_val]
  have hu_scale_P : P (n + 1) (u_scale : L) := by
    dsimp only [u_scale]
    rw [Units.val_mul]
    exact hP_mono (by omega)
      (hP_mul (hP_of_val hc_val) (hP_of_val hδb2_inv_val))
  have hz₁_int : P 0 z₁ :=
    hP_mono (by omega) (hP_mul hu_scale_P hx₁_P)
  have hA_z₁ : A * (δ_b : L) ^ 2 * z₁ = x₁ := by
    have hc_inv : A * (c : L) = 1 := Units.inv_mul c
    have hδ_inv : ((δ_b ^ 2 : Lˣ) : L) * (((δ_b ^ 2)⁻¹ : Lˣ) : L) = 1 :=
      Units.mul_inv (δ_b ^ 2)
    rw [Units.val_pow_eq_pow_val] at hδ_inv
    dsimp only [z₁, u_scale]
    rw [Units.val_mul]
    calc A * (δ_b : L) ^ 2 * ((c : L) * (((δ_b ^ 2)⁻¹ : Lˣ) : L) * x₁)
      _ = (A * (c : L)) * ((δ_b : L) ^ 2 * (((δ_b ^ 2)⁻¹ : Lˣ) : L)) * x₁ := by ring
      _ = 1 * 1 * x₁ := by rw [hc_inv, hδ_inv]
      _ = x₁ := by ring
  have hz₀ : ψ₀_fn z₀ ≠ 1 := by
    dsimp only [z₀]
    rw [hψ₀_spec z₁ hz₁_int, hA_z₁]
    exact hx₁_ψ_ne1
  have horth : ∀ u : k_L, (∑ y : k_L, ψ₀_fn (u * y)) = if u = 0 then (Fintype.card k_L : Ω F) else 0 := by
    intro u
    by_cases hu : u = 0
    · simp [hu, hψ₀_0]
    · rw [if_neg hu]
      have hshift : (∑ y : k_L, ψ₀_fn (u * y)) = (∑ y : k_L, ψ₀_fn (u * y)) * ψ₀_fn z₀ := by
        rw [Finset.sum_mul]
        refine (Fintype.sum_equiv (Equiv.addRight (u⁻¹ * z₀)) _ _ fun y => ?_).symm
        change ψ₀_fn (u * y) * ψ₀_fn z₀ = ψ₀_fn (u * (y + u⁻¹ * z₀))
        have heq : u * (y + u⁻¹ * z₀) = u * y + z₀ := by
          rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hu, one_mul]
        rw [heq, hψ₀_add]
      have hsub : (∑ y : k_L, ψ₀_fn (u * y)) * (ψ₀_fn z₀ - 1) = 0 := by
        calc (∑ y : k_L, ψ₀_fn (u * y)) * (ψ₀_fn z₀ - 1)
          _ = (∑ y : k_L, ψ₀_fn (u * y)) * ψ₀_fn z₀ - (∑ y : k_L, ψ₀_fn (u * y)) := by ring
          _ = 0 := sub_eq_zero.mpr hshift.symm
      rcases mul_eq_zero.mp hsub with h | h
      · exact h
      · exact False.elim (hz₀ (sub_eq_zero.mp h))
  let Q : k_L → Ω F := fun y =>
    if hx : 1 + (δ_b : L) * liftL y ≠ 0 then
      (θ (Units.mk0 (1 + (δ_b : L) * liftL y) hx) : Ω F)⁻¹ *
        ψ (A * (δ_b : L) * liftL y)
    else 0
  have hδx_P1 : ∀ {x : L}, P 0 x → P 1 ((δ_b : L) * x) :=
    fun hx => hP_mono (by omega) (hP_mul hP_δb hx)
  have hQ_spec : ∀ x : L, P 0 x → ∀ hx : 1 + (δ_b : L) * x ≠ 0,
      Q (resL x) =
        (θ (Units.mk0 (1 + (δ_b : L) * x) hx) : Ω F)⁻¹ *
          ψ (A * (δ_b : L) * x) := by
    intro x₁ hx₁ hx₁_ne
    set x₂ := liftL (resL x₁)
    have hx₂ : P 0 x₂ := hliftL_int (resL x₁)
    have hx₂_ne : 1 + (δ_b : L) * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
    dsimp only [Q]
    rw [dif_pos hx₂_ne]
    have h12 : P 1 (x₁ - x₂) :=
      hresL_sub_mem1 hx₁ hx₂ (hliftL_res (resL x₁)).symm
    have hδ12_stat : P (r₀ : ℤ) ((δ_b : L) * (x₁ - x₂)) :=
      hP_mono (by omega) (hP_mul hP_δb h12)
    have hδ12_P1 : P 1 ((δ_b : L) * (x₁ - x₂)) := hP_mono (by omega) hδ12_stat
    have hw_ne : 1 + (δ_b : L) * (x₁ - x₂) ≠ 0 := h1_add_ne hδ12_P1
    set u₁ := Units.mk0 (1 + (δ_b : L) * x₁) hx₁_ne
    set u₂ := Units.mk0 (1 + (δ_b : L) * x₂) hx₂_ne
    set w := Units.mk0 (1 + (δ_b : L) * (x₁ - x₂)) hw_ne
    have hu₁_val : valL F L (u₁ : L) = 0 := h1_add_val (hδx_P1 hx₁)
    have hpoly : ((u₂ * w : Lˣ) : L) - (u₁ : L) =
        (δ_b : L) ^ 2 * (x₂ * (x₁ - x₂)) := by
      dsimp only [u₁, u₂, w]
      rw [Units.val_mul, Units.val_mk0, Units.val_mk0, Units.val_mk0]
      ring
    have hpoly_Pb : P (b : ℤ) (((u₂ * w : Lˣ) : L) - (u₁ : L)) := by
      rw [hpoly]
      exact hP_mono (by omega) (hP_mul (hP_sq hP_δb) (hP_mul hx₂ h12))
    have hθ_eq : θ (u₂ * w) = θ u₁ := hθ_congr hu₁_val hpoly_Pb
    have hθ_mul : (θ u₁ : Ω F) = (θ u₂ : Ω F) * (θ w : Ω F) := by
      rw [← hθ_eq, map_mul, Units.val_mul]
    have hθ_w : (θ w : Ω F) = ψ (A * ((δ_b : L) * (x₁ - x₂))) :=
      hc_stat ((δ_b : L) * (x₁ - x₂)) hδ12_stat hw_ne
    have hψ_split : ψ (A * (δ_b : L) * x₁) =
        ψ (A * (δ_b : L) * x₂) * (θ w : Ω F) := by
      rw [hθ_w, ← ψ.map_add_eq_mul]
      congr 1
      ring
    rw [hθ_mul, hψ_split, mul_inv]
    calc (θ u₂ : Ω F)⁻¹ * ψ (A * (δ_b : L) * x₂)
      _ = (θ u₂ : Ω F)⁻¹ * ψ (A * (δ_b : L) * x₂) * 1 := (mul_one _).symm
      _ = (θ u₂ : Ω F)⁻¹ * ψ (A * (δ_b : L) * x₂) *
          ((θ w : Ω F)⁻¹ * (θ w : Ω F)) := by
        rw [inv_mul_cancel₀ (Units.ne_zero (θ w))]
      _ = (θ u₂ : Ω F)⁻¹ * (θ w : Ω F)⁻¹ *
          (ψ (A * (δ_b : L) * x₂) * (θ w : Ω F)) := by
        ring
  have hQ_0 : Q 0 = 1 := by
    have h1_0_ne : 1 + (δ_b : L) * (0 : L) ≠ 0 := by simp
    rw [← hresL_0, hQ_spec 0 (hP_zero 0) h1_0_ne]
    have hmk_one : Units.mk0 (1 + (δ_b : L) * (0 : L)) h1_0_ne = 1 := by
      apply Units.ext; simp
    rw [hmk_one, map_one, Units.val_one, inv_one, one_mul, mul_zero, ψ.map_zero_eq_one]
  have hQ_add : ∀ y₁ y₂ : k_L, Q (y₁ + y₂) = Q y₁ * Q y₂ * ψ₀_fn (y₁ * y₂) := by
    intro y₁ y₂
    set x₁ := liftL y₁
    set x₂ := liftL y₂
    have hx₁ : P 0 x₁ := hliftL_int y₁
    have hx₂ : P 0 x₂ := hliftL_int y₂
    have hx12 : P 0 (x₁ + x₂) := hP_add hx₁ hx₂
    have hmul12 : P 0 (x₁ * x₂) := hP_mono (by omega) (hP_mul hx₁ hx₂)
    have hu₁_ne : 1 + (δ_b : L) * x₁ ≠ 0 := h1_add_ne (hδx_P1 hx₁)
    have hu₂_ne : 1 + (δ_b : L) * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
    have hu12_ne : 1 + (δ_b : L) * (x₁ + x₂) ≠ 0 := h1_add_ne (hδx_P1 hx12)
    have hδ2_stat : P (r₀ : ℤ) ((δ_b : L) ^ 2 * (x₁ * x₂)) :=
      hP_mono (by omega) (hP_mul (hP_sq hP_δb) hmul12)
    have hwq_ne : 1 + (δ_b : L) ^ 2 * (x₁ * x₂) ≠ 0 :=
      h1_add_ne (hP_mono (by omega) hδ2_stat)
    set u₁ := Units.mk0 (1 + (δ_b : L) * x₁) hu₁_ne
    set u₂ := Units.mk0 (1 + (δ_b : L) * x₂) hu₂_ne
    set u₁₂ := Units.mk0 (1 + (δ_b : L) * (x₁ + x₂)) hu12_ne
    set w_q := Units.mk0 (1 + (δ_b : L) ^ 2 * (x₁ * x₂)) hwq_ne
    have hu1u2_val : valL F L ((u₁ * u₂ : Lˣ) : L) = 0 := by
      rw [Units.val_mul, hval_mul (u₁ : L) (u₂ : L) (Units.ne_zero _) (Units.ne_zero _)]
      dsimp only [u₁, u₂]
      rw [Units.val_mk0, Units.val_mk0,
        h1_add_val (hδx_P1 hx₁), h1_add_val (hδx_P1 hx₂), add_zero]
    have hpoly_q : ((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L) =
        (δ_b : L) ^ 2 * ((δ_b : L) * (x₁ * x₂ * (x₁ + x₂))) := by
      dsimp only [u₁, u₂, u₁₂, w_q]
      rw [Units.val_mul, Units.val_mul, Units.val_mk0, Units.val_mk0,
        Units.val_mk0, Units.val_mk0]
      ring
    have hpoly_q_Pb : P (b : ℤ) (((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L)) := by
      rw [hpoly_q]
      exact hP_mono (by omega)
        (hP_mul (hP_sq hP_δb) (hP_mul hP_δb (hP_mul hmul12 hx12)))
    have hθ_q_eq : θ (u₁₂ * w_q) = θ (u₁ * u₂) :=
      hθ_congr hu1u2_val hpoly_q_Pb
    have hθ_inv_eq : (θ u₁₂ : Ω F)⁻¹ =
        (θ u₁ : Ω F)⁻¹ * (θ u₂ : Ω F)⁻¹ * (θ w_q : Ω F) := by
      have h1 : (θ u₁₂ : Ω F) * (θ w_q : Ω F) = (θ u₁ : Ω F) * (θ u₂ : Ω F) := by
        exact_mod_cast (map_mul θ u₁₂ w_q).symm.trans (hθ_q_eq.trans (map_mul θ u₁ u₂))
      rw [← mul_inv, ← h1, mul_inv, mul_assoc, inv_mul_cancel₀ (Units.ne_zero (θ w_q)), mul_one]
    have hθ_wq : (θ w_q : Ω F) = ψ₀_fn (y₁ * y₂) := by
      rw [hc_stat ((δ_b : L) ^ 2 * (x₁ * x₂)) hδ2_stat hwq_ne, ← mul_assoc,
        ← hψ₀_spec (x₁ * x₂) hmul12, (hresL_ring x₁ x₂ hx₁ hx₂).2.1,
        hliftL_res y₁, hliftL_res y₂]
    have hres_add : y₁ + y₂ = resL (x₁ + x₂) := by
      rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res y₁, hliftL_res y₂]
    have hψ_add : ψ (A * (δ_b : L) * (x₁ + x₂)) =
        ψ (A * (δ_b : L) * x₁) * ψ (A * (δ_b : L) * x₂) := by
      rw [← ψ.map_add_eq_mul]
      congr 1
      ring
    rw [hres_add, hQ_spec (x₁ + x₂) hx12 hu12_ne,
      ← hliftL_res y₁, ← hliftL_res y₂,
      hQ_spec x₁ hx₁ hu₁_ne, hQ_spec x₂ hx₂ hu₂_ne,
      hliftL_res y₁, hliftL_res y₂, hθ_inv_eq, hθ_wq, hψ_add]
    ring
  have hQ_ne0 : ∀ x : k_L, Q x ≠ 0 := by
    intro x hx0
    have h1 : (1 : Ω F) = Q x * Q (-x) * ψ₀_fn (x * (-x)) := by
      rw [← hQ_0, ← add_neg_cancel x, hQ_add x (-x)]
    rw [hx0, zero_mul, zero_mul] at h1
    exact one_ne_zero h1
  have hRL_inj : Set.InjOn resL R_L := by
    intro r₁ hr₁ r₂ hr₂ hres_eq
    by_contra hr_ne
    have hval0_sub : valL F L (r₁ - r₂) = 0 := hRL_sep r₁ hr₁ r₂ hr₂ hr_ne
    have hsub_P1 : P 1 (r₁ - r₂) :=
      hresL_sub_mem1 (hRL_int r₁ hr₁) (hRL_int r₂ hr₂) hres_eq
    rcases hsub_P1 with hsub0 | hval1_sub
    · exact hr_ne (sub_eq_zero.mp hsub0)
    · omega
  have hRL_image : R_L.image resL = Finset.univ := by
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Finset.card_image_of_injOn hRL_inj, hRL_card]
  have hRL_sum_bij : ∀ g : k_L → Ω F, (∑ r ∈ R_L, g (resL r)) = ∑ x : k_L, g x := by
    intro g
    refine Finset.sum_bij (fun r _ => resL r) ?_ ?_ ?_ ?_
    · intro r _; exact Finset.mem_univ _
    · intro r₁ hr₁ r₂ hr₂ heq; exact hRL_inj hr₁ hr₂ heq
    · intro b_res hb_res
      rw [← hRL_image] at hb_res
      obtain ⟨r, hr, hres⟩ := Finset.mem_image.mp hb_res
      exact ⟨r, hr, hres⟩
    · intro _ _; rfl
  have hS_1 : (∑ r ∈ R_L,
      if hr : 1 + (δ_b : L) * r ≠ 0 then
        (θ (Units.mk0 (1 + (δ_b : L) * r) hr) : Ω F)⁻¹ *
          ψ (A * (δ_b : L) * r)
      else 0) = ∑ x : k_L, Q x := by
    rw [← hRL_sum_bij Q]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_ne : 1 + (δ_b : L) * r ≠ 0 := h1_add_ne (hδx_P1 (hRL_int r hr))
    rw [dif_pos hr_ne, hQ_spec r (hRL_int r hr) hr_ne]
  have hS_2 : (∑ r ∈ R_L,
      if hr : 1 + (δ_b : L) * r ≠ 0 then
        (θ (Units.mk0 (1 + (δ_b : L) * r) hr) : Ω F) *
          ψ ((- A) * (δ_b : L) * r)
      else 0) = ∑ y : k_L, (Q y)⁻¹ := by
    rw [← hRL_sum_bij (fun y : k_L => (Q y)⁻¹)]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_int : P 0 r := hRL_int r hr
    have hr_ne : 1 + (δ_b : L) * r ≠ 0 := h1_add_ne (hδx_P1 hr_int)
    have hneg_arg : (- A) * (δ_b : L) * r = - (A * (δ_b : L) * r) := by ring
    rw [dif_pos hr_ne, hneg_arg, hψ_neg_eq_inv, hQ_spec r hr_int hr_ne, mul_inv, inv_inv]
  rw [hS_1, hS_2, Finset.sum_mul_sum, Finset.sum_comm]
  have hinner : ∀ y : k_L, (∑ x : k_L, Q x * (Q y)⁻¹) = ∑ h : k_L, Q h * ψ₀_fn (h * y) := by
    intro y
    refine (Fintype.sum_equiv (Equiv.addRight y) _ _ fun h => ?_).symm
    change Q h * ψ₀_fn (h * y) = Q (h + y) * (Q y)⁻¹
    rw [hQ_add h y]
    calc Q h * ψ₀_fn (h * y)
      _ = Q h * ψ₀_fn (h * y) * (Q y * (Q y)⁻¹) := by rw [mul_inv_cancel₀ (hQ_ne0 y), mul_one]
      _ = Q h * Q y * ψ₀_fn (h * y) * (Q y)⁻¹ := by ring
  simp_rw [hinner]
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum, horth]
  rw [Finset.sum_eq_single (0 : k_L)]
  · simp [hQ_0]
  · intro h _ hh
    simp [hh]
  · intro habs
    exact False.elim (habs (Finset.mem_univ 0))

theorem ld_wild_mid_cond_odd_prime_pair_and_range_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Fintype k_L]
    (R_L : Finset L)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hContragred : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      ∃ c_j c'_j : Lˣ,
        valL F L (c_j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
        (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_j⁻¹ : Lˣ) : L) * x)) ∧
        valL F L (c'_j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
        (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            ((ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - j))
              (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c'_j)⁻¹ : Lˣ) : L) * x)) ∧
        (((c'_j)⁻¹ : Lˣ) : L) = - (((c_j⁻¹ : Lˣ) : L)) ∧
        (∀ u : Lˣ,
          ((ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - j)) u : Ω F)⁻¹ =
            ((ν₁ ^ j) u : Ω F)) ∧
        ((ν₁ ^ j) c_j : Ω F) *
          ((ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - j)) c'_j : Ω F) = 1 ∧
        ψ (((c_j⁻¹ : Lˣ) : L)) * ψ ((((c'_j)⁻¹ : Lˣ) : L)) = 1)
    (hOddSum : ∀ (θ : Lˣ →* (Ω F)ˣ) (c : Lˣ),
      2 ≤ condExp F L θ →
      condExp F L θ % 2 = 1 →
      valL F L (c : L) = (condExp F L θ : ℤ) + condExpChar F L ψ →
      (∀ x : L, (x = 0 ∨ (((condExp F L θ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c⁻¹ : Lˣ) : L) * x)) →
      (∑ r ∈ R_L,
        if hr : 1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r ≠ 0 then
          (θ (Units.mk0 (1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
            ψ (((c⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r)
        else 0) *
      (∑ r ∈ R_L,
        if hr : 1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r ≠ 0 then
          (θ (Units.mk0 (1 + ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r) hr) : Ω F) *
            ψ ((- ((c⁻¹ : Lˣ) : L)) * ((ϖ_L ^ (condExp F L θ / 2) : Lˣ) : L) * r)
        else 0) =
      (Fintype.card k_L : Ω F)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    tateEps F K 1 (traceChar F hLK ψ) =
      (qL F L : Ω F) ^ condExpChar F K (traceChar F hLK ψ) ∧
    (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j) ψ) =
      ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p *
        (Fintype.card k_L : Ω F) ^ (((p - 1) / 2) * condExp F L ν₁) :=
by
  intro p
  rcases hvalL_props with ⟨_, hval1_L, _, _, hval_mul_L, _, _, _, _, _, _⟩
  set b := condExp F L ν₁
  set d_b := b / 2
  set δ_b : Lˣ := ϖ_L ^ d_b
  have hcond_1K : condExp F K 1 = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl (fun _ _ => rfl))
  have hEps_1K : tateEps F K 1 (traceChar F hLK ψ) =
      (qL F L : Ω F) ^ condExpChar F K (traceChar F hLK ψ) := by
    unfold tateEps
    rw [if_pos hcond_1K, hqK]
    simp
  have hcond_1L : condExp F L 1 = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl (fun _ _ => rfl))
  have hEps_0L : tateEps F L (ν₁ ^ 0) ψ =
      (qL F L : Ω F) ^ condExpChar F L ψ := by
    rw [pow_zero]
    unfold tateEps
    rw [if_pos hcond_1L]
    simp
  have hϖ_L_pow_ne_zero : ∀ n : ℕ, ((ϖ_L : L) ^ n) ≠ 0 :=
    fun n => pow_ne_zero n (Units.ne_zero ϖ_L)
  have hϖ_L_pow_val : ∀ n : ℕ, valL F L ((ϖ_L : L) ^ n) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simp [hval1_L]
    · rw [pow_succ, hval_mul_L _ _ (hϖ_L_pow_ne_zero n) (Units.ne_zero ϖ_L), ih, hϖ_L]
      push_cast
      ring
  have hδb_val : valL F L (δ_b : L) = (d_b : ℤ) := by
    change valL F L (((ϖ_L ^ d_b : Lˣ) : L)) = (d_b : ℤ)
    rw [Units.val_pow_eq_pow_val]
    exact hϖ_L_pow_val d_b
  have hPair : ∀ j < p, 0 < j →
      tateEps F L (ν₁ ^ j) ψ * tateEps F L (ν₁ ^ (p - j)) ψ =
        ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
          (Fintype.card k_L : Ω F) ^ b := by
    intro j hj_lt hj_pos
    have hpj_lt : p - j < p := by omega
    have hpj_pos : 0 < p - j := by omega
    have hcond_j : condExp F L (ν₁ ^ j) = b := hν_cond_eq j hj_lt hj_pos
    have hcond_pj : condExp F L (ν₁ ^ (p - j)) = b := hν_cond_eq (p - j) hpj_lt hpj_pos
    have hcond_j_ge2 : 2 ≤ condExp F L (ν₁ ^ j) := by
      rw [hcond_j]
      exact hb_ge2
    have hcond_pj_ge2 : 2 ≤ condExp F L (ν₁ ^ (p - j)) := by
      rw [hcond_pj]
      exact hb_ge2
    obtain ⟨c_j, c'_j, hc_j_val, hc_j_stat, hc'_j_val, hc'_j_stat,
      hc'_inv_eq, hν_pj_inv, hν_c_prod, hψ_c_prod⟩ := hContragred j hj_lt hj_pos
    have hc_j_val' : valL F L (c_j : L) =
        (condExp F L (ν₁ ^ j) : ℤ) + condExpChar F L ψ := by
      rw [hcond_j]
      exact hc_j_val
    have hc_j_stat' : ∀ x : L,
        (x = 0 ∨ (((condExp F L (ν₁ ^ j) + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_j⁻¹ : Lˣ) : L) * x) := by
      rw [hcond_j]
      exact hc_j_stat
    have hδb_val_j : valL F L (δ_b : L) = ((condExp F L (ν₁ ^ j) / 2 : ℕ) : ℤ) := by
      rw [hcond_j]
      exact hδb_val
    have hc'_j_val' : valL F L (c'_j : L) =
        (condExp F L (ν₁ ^ (p - j)) : ℤ) + condExpChar F L ψ := by
      rw [hcond_pj]
      exact hc'_j_val
    have hc'_j_stat' : ∀ x : L,
        (x = 0 ∨ (((condExp F L (ν₁ ^ (p - j)) + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ (p - j)) (Units.mk0 (1 + x) hx) : Ω F) =
            ψ ((((c'_j)⁻¹ : Lˣ) : L) * x) := by
      rw [hcond_pj]
      exact hc'_j_stat
    have hδb_val_pj : valL F L (δ_b : L) =
        ((condExp F L (ν₁ ^ (p - j)) / 2 : ℕ) : ℤ) := by
      rw [hcond_pj]
      exact hδb_val
    obtain ⟨hEps_j_even, hEps_j_odd⟩ :=
      ((hStat L ψ hψ (ν₁ ^ j) hcond_j_ge2).2 c_j hc_j_val' hc_j_stat').2
        R_L δ_b hRL_int hRL_sep hRL_surj hδb_val_j
    obtain ⟨hEps_pj_even, hEps_pj_odd⟩ :=
      ((hStat L ψ hψ (ν₁ ^ (p - j)) hcond_pj_ge2).2 c'_j hc'_j_val' hc'_j_stat').2
        R_L δ_b hRL_int hRL_sep hRL_surj hδb_val_pj
    rcases Nat.mod_two_eq_zero_or_one b with hb_even | hb_odd
    · have hj_even : condExp F L (ν₁ ^ j) % 2 = 0 := by
        rw [hcond_j]
        exact hb_even
      have hpj_even : condExp F L (ν₁ ^ (p - j)) % 2 = 0 := by
        rw [hcond_pj]
        exact hb_even
      have hj_eq := hEps_j_even hj_even
      have hpj_eq := hEps_pj_even hpj_even
      rw [hcond_j, hRL_card] at hj_eq
      rw [hcond_pj, hRL_card] at hpj_eq
      have hd_sum : d_b + d_b = b := by omega
      have hpow_card :
          (Fintype.card k_L : Ω F) ^ d_b * (Fintype.card k_L : Ω F) ^ d_b =
            (Fintype.card k_L : Ω F) ^ b := by
        rw [← pow_add, hd_sum]
      change tateEps F L (ν₁ ^ j) ψ * tateEps F L (ν₁ ^ (p - j)) ψ = _
      rw [hj_eq, hpj_eq]
      calc
        ((qL F L : Ω F) ^ condExpChar F L ψ * (Fintype.card k_L : Ω F) ^ d_b *
            ((ν₁ ^ j) c_j : Ω F) * ψ (((c_j⁻¹ : Lˣ) : L))) *
          ((qL F L : Ω F) ^ condExpChar F L ψ * (Fintype.card k_L : Ω F) ^ d_b *
            ((ν₁ ^ (p - j)) c'_j : Ω F) * ψ ((((c'_j)⁻¹ : Lˣ) : L)))
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              ((Fintype.card k_L : Ω F) ^ d_b * (Fintype.card k_L : Ω F) ^ d_b) *
              (((ν₁ ^ j) c_j : Ω F) * ((ν₁ ^ (p - j)) c'_j : Ω F)) *
              (ψ (((c_j⁻¹ : Lˣ) : L)) * ψ ((((c'_j)⁻¹ : Lˣ) : L))) := by ring
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              (Fintype.card k_L : Ω F) ^ b * 1 * 1 := by
              rw [hpow_card, hν_c_prod, hψ_c_prod]
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              (Fintype.card k_L : Ω F) ^ b := by ring
    · have hj_odd : condExp F L (ν₁ ^ j) % 2 = 1 := by
        rw [hcond_j]
        exact hb_odd
      have hpj_odd : condExp F L (ν₁ ^ (p - j)) % 2 = 1 := by
        rw [hcond_pj]
        exact hb_odd
      have hj_eq := hEps_j_odd hj_odd
      have hpj_eq := hEps_pj_odd hpj_odd
      rw [hcond_j, hRL_card] at hj_eq
      rw [hcond_pj, hRL_card] at hpj_eq
      set S_j : Ω F :=
        ∑ r ∈ R_L,
          if hr : 1 + (δ_b : L) * r ≠ 0 then
            ((ν₁ ^ j) (Units.mk0 (1 + (δ_b : L) * r) hr) : Ω F)⁻¹ *
              ψ (((c_j⁻¹ : Lˣ) : L) * (δ_b : L) * r)
          else 0
      set S'_j : Ω F :=
        ∑ r ∈ R_L,
          if hr : 1 + (δ_b : L) * r ≠ 0 then
            ((ν₁ ^ j) (Units.mk0 (1 + (δ_b : L) * r) hr) : Ω F) *
              ψ ((- ((c_j⁻¹ : Lˣ) : L)) * (δ_b : L) * r)
          else 0
      have hsum_pj_eq :
          (∑ r ∈ R_L,
            if hr : 1 + (δ_b : L) * r ≠ 0 then
              ((ν₁ ^ (p - j)) (Units.mk0 (1 + (δ_b : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c'_j)⁻¹ : Lˣ) : L) * (δ_b : L) * r)
            else 0) = S'_j := by
        apply Finset.sum_congr rfl
        intro r _
        by_cases hr : 1 + (δ_b : L) * r ≠ 0
        · rw [dif_pos hr, dif_pos hr, hν_pj_inv (Units.mk0 (1 + (δ_b : L) * r) hr), hc'_inv_eq]
        · rw [dif_neg hr, dif_neg hr]
      rw [hsum_pj_eq] at hpj_eq
      have hOdd_j := hOddSum (ν₁ ^ j) c_j hcond_j_ge2 hj_odd hc_j_val' hc_j_stat'
      rw [hcond_j] at hOdd_j
      have hSj_prod : S_j * S'_j = (Fintype.card k_L : Ω F) := hOdd_j
      have hd_sum_odd : d_b + d_b + 1 = b := by omega
      have hpow_card_odd :
          (Fintype.card k_L : Ω F) ^ d_b * (Fintype.card k_L : Ω F) ^ d_b *
            (Fintype.card k_L : Ω F) =
            (Fintype.card k_L : Ω F) ^ b := by
        rw [← pow_add, ← pow_succ, hd_sum_odd]
      change tateEps F L (ν₁ ^ j) ψ * tateEps F L (ν₁ ^ (p - j)) ψ = _
      rw [hj_eq, hpj_eq]
      calc
        ((qL F L : Ω F) ^ condExpChar F L ψ * (Fintype.card k_L : Ω F) ^ d_b *
            ((ν₁ ^ j) c_j : Ω F) * ψ (((c_j⁻¹ : Lˣ) : L)) * S_j) *
          ((qL F L : Ω F) ^ condExpChar F L ψ * (Fintype.card k_L : Ω F) ^ d_b *
            ((ν₁ ^ (p - j)) c'_j : Ω F) * ψ ((((c'_j)⁻¹ : Lˣ) : L)) * S'_j)
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              ((Fintype.card k_L : Ω F) ^ d_b * (Fintype.card k_L : Ω F) ^ d_b *
                (S_j * S'_j)) *
              (((ν₁ ^ j) c_j : Ω F) * ((ν₁ ^ (p - j)) c'_j : Ω F)) *
              (ψ (((c_j⁻¹ : Lˣ) : L)) * ψ ((((c'_j)⁻¹ : Lˣ) : L))) := by ring
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              ((Fintype.card k_L : Ω F) ^ d_b * (Fintype.card k_L : Ω F) ^ d_b *
                (Fintype.card k_L : Ω F)) * 1 * 1 := by
              rw [hSj_prod, hν_c_prod, hψ_c_prod]
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
              (Fintype.card k_L : Ω F) ^ b := by
              rw [hpow_card_odd]
              ring
  refine ⟨hEps_1K, ?_⟩
  set k := (p - 1) / 2
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd_prop : Odd p := hPrime.odd_of_ne_two hp_odd
  have hp_eq : p = 1 + k + k := by
    rcases hp_odd_prop with ⟨m, hm⟩
    omega
  let f : ℕ → Ω F := fun j => tateEps F L (ν₁ ^ j) ψ
  have hprod_split :
      (∏ j ∈ Finset.range p, f j) =
        f 0 * ((∏ i ∈ Finset.range k, f (1 + i)) *
          (∏ i ∈ Finset.range k, f (1 + k + i))) := by
    conv_lhs => rw [hp_eq]
    rw [Finset.prod_range_add f (1 + k) k, Finset.prod_range_add f 1 k,
      Finset.prod_range_one f, mul_assoc]
  have hprod_refl :
      (∏ i ∈ Finset.range k, f (1 + k + i)) =
        ∏ i ∈ Finset.range k, f (1 + k + (k - 1 - i)) :=
    (Finset.prod_range_reflect (fun i => f (1 + k + i)) k).symm
  have hpair_i : ∀ i ∈ Finset.range k,
      f (1 + i) * f (1 + k + (k - 1 - i)) =
        ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
          (Fintype.card k_L : Ω F) ^ b := by
    intro i hi
    have hi_lt_k : i < k := Finset.mem_range.mp hi
    have hi_sub : 1 + k + (k - 1 - i) = p - (1 + i) := by omega
    have hi_lt_p : 1 + i < p := by omega
    have hi_pos : 0 < 1 + i := by omega
    dsimp [f]
    rw [hi_sub]
    exact hPair (1 + i) hi_lt_p hi_pos
  have hprod_pairs :
      (∏ i ∈ Finset.range k, (f (1 + i) * f (1 + k + (k - 1 - i)))) =
        (((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
          (Fintype.card k_L : Ω F) ^ b) ^ k := by
    rw [Finset.prod_congr rfl hpair_i, Finset.prod_const, Finset.card_range]
  change (∏ j ∈ Finset.range p, f j) = _
  rw [hprod_split, hprod_refl, ← Finset.prod_mul_distrib, hprod_pairs]
  have hf0 : f 0 = (qL F L : Ω F) ^ condExpChar F L ψ := hEps_0L
  rw [hf0, mul_pow, ← pow_mul, ← pow_mul]
  have hQ_pow :
      (qL F L : Ω F) ^ condExpChar F L ψ *
        ((qL F L : Ω F) ^ condExpChar F L ψ) ^ (2 * k) =
        ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p := by
    have h12k : p = 2 * k + 1 := by omega
    rw [h12k, pow_succ, mul_comm]
  have hbk : b * k = k * b := Nat.mul_comm b k
  rw [← mul_assoc, hQ_pow, hbk]

theorem ld_wild_mid_cond_odd_prime_nu_prod_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hp_val : ((Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * condExp F L ν₁ /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))))
    (R_L : Finset L) (c_ν₁ : Lˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ((p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L)) ∧
    tateEps F K 1 (traceChar F hLK ψ) =
      (qL F L : Ω F) ^ condExpChar F K (traceChar F hLK ψ) ∧
    (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j) ψ) =
      ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p *
        (Fintype.card k_L : Ω F) ^ (((p - 1) / 2) * condExp F L ν₁) :=
by
  intro p
  obtain ⟨hp_val1, hContragred⟩ :=
    ld_wild_mid_cond_odd_prime_nat_unit_and_contragredient_stat F L p hPrime hp_odd ψ ν₁
      hν₁_pow hb_ge2 hvalL_props k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
      hp_val c_ν₁ hc_ν₁_val hc_ν₁_stat
  obtain ⟨hEpsK1, hNuProd⟩ :=
    ld_wild_mid_cond_odd_prime_pair_and_range_prod F L K hLK hPrime hp_odd ψ hψ ν₁
      hb_ge2 hν_cond_eq hqK hvalL_props ϖ_L hϖ_L k_L R_L hRL_card hRL_int hRL_sep hRL_surj
      hStat hContragred
      (fun θ c hθ_ge2 hθ_odd hc_val hc_stat =>
        ld_wild_odd_cond_polar_hasse_inv_prod F L ψ hvalL_props hSpecL ϖ_L hϖ_L
          k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
          R_L hRL_card hRL_int hRL_sep θ c hθ_ge2 hθ_odd hc_val hc_stat)
  exact ⟨hp_val1, hEpsK1, hNuProd⟩

theorem ld_wild_mid_cond_odd_prime_teichmuller_inv_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (p b a : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hb_ge2 : 2 ≤ b) (hba : b < a)
    (hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m, u ^ p ∈ unitGroup F L (m + 1))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hp_val : (p : L) = 0 ∨ (((p - 1) * b / p : ℕ) : ℤ) ≤ valL F L (p : L))
    (hp_val1 : (p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L))
    (δ_L : L) (hδL_val : valL F L δ_L = ((a - b : ℕ) : ℤ))
    (hTeich : ∀ (N : L), (N = 0 ∨ 0 ≤ valL F L N) →
      ∀ (τ_unit τ_tilde : ℕ → Lˣ),
        (∀ j < p, 0 < j →
          (τ_tilde j : L) = (j : L) ^ (p ^ a) ∧
          τ_unit j = (τ_tilde j) ^ p) →
        (∀ j < p, 0 < j →
          (τ_tilde j : L) - (τ_unit j : L) = 0 ∨
            (a + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - (τ_unit j : L))) ∧
        (∀ j < p, 0 < j →
          (τ_unit j : L) ^ (p - 1) - 1 = 0 ∨
            (a + 1 : ℤ) ≤ valL F L ((τ_unit j : L) ^ (p - 1) - 1)) ∧
        ((∏ j ∈ (Finset.range p).erase 0, (N + (τ_unit j : L))) - (N ^ (p - 1) - 1) = 0 ∨
          (a + 1 : ℤ) ≤
            valL F L
              ((∏ j ∈ (Finset.range p).erase 0, (N + (τ_unit j : L))) - (N ^ (p - 1) - 1))) ∧
        (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
          (∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
            (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
            (a + 1 : ℤ) ≤
              valL F L
                ((∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
                  (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0)))) :
    let S' := (Finset.range p).erase 0
    ∃ (τ_tilde : ℕ → Lˣ) (τ : ℕ → L),
      (∀ j ∈ S',
        ((τ_tilde j : L) = 0 ∨ 0 ≤ valL F L (τ_tilde j : L)) ∧
        (τ_tilde j : L) ^ p = τ j ∧
        (τ j = 0 ∨ 0 ≤ valL F L (τ j)) ∧
        1 + τ j * δ_L ≠ 0 ∧
        valL F L (1 + τ j * δ_L) = 0) ∧
      (∀ j ∈ S',
        τ j - (j : L) = 0 ∨ (((p - 1) * b / p : ℕ) : ℤ) ≤ valL F L (τ j - (j : L))) ∧
      (∀ j ∈ S',
        (τ_tilde j : L) - τ j = 0 ∨ (a + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - τ j)) ∧
      (∀ j ∈ S',
        (τ j) ^ (p - 1) - 1 = 0 ∨ (a + 1 : ℤ) ≤ valL F L ((τ j) ^ (p - 1) - 1)) ∧
      ((∏ j ∈ S', (1 + τ j * δ_L)) - (1 - δ_L ^ (p - 1)) = 0 ∨
        (a + 1 : ℤ) ≤ valL F L ((∏ j ∈ S', (1 + τ j * δ_L)) - (1 - δ_L ^ (p - 1)))) ∧
      (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
        (∑ j ∈ S', (τ j) ^ r) -
          (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
          (a + 1 : ℤ) ≤
            valL F L
              ((∑ j ∈ S', (τ j) ^ r) -
                (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0))) :=
by
  intro S'
  rcases hvalL_props with ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul,
    hval_inv, _, hval_add, hunit0, hunit_ge1, hunit_val0⟩
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  haveI : NeZero p := ⟨hPrime.ne_zero⟩
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp1_ne0 : p - 1 ≠ 0 := by omega
  have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hval_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    have hneg2 : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg]; exact hge)
    exact hval_add k x₁ (-x₂) hx₁ hneg2
  have hval_pow_int : ∀ (x : L) (n : ℕ),
      (x = 0 ∨ 0 ≤ valL F L x) → (x ^ n = 0 ∨ 0 ≤ valL F L (x ^ n)) := by
    intro x n hx
    induction n with
    | zero => right; simp [hval1]
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge 0 0 (x ^ n) x ih hx
      rwa [add_zero] at hmul
  have hunit_of_gt0 : ∀ x : L, (x = 0 ∨ (1 : ℤ) ≤ valL F L x) →
      1 + x ≠ 0 ∧ valL F L (1 + x) = 0 := by
    intro x hx
    have h1x_ne0 : 1 + x ≠ 0 := by
      intro h0
      have hx_neg1 : x = -1 := by linear_combination h0
      rcases hx with hx0 | hx_ge1
      · have h10 : (1 : L) = 0 := by linear_combination h0 - hx0
        exact one_ne_zero h10
      · rw [hx_neg1, hval_neg1] at hx_ge1
        omega
    let u_x : Lˣ := Units.mk0 (1 + x) h1x_ne0
    have hu_mem : u_x ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u_x]
      have hsub : (u_x : L) - 1 = x := by dsimp [u_x]; ring
      rcases hx with rfl | hx_ge1
      · exact Or.inl (by dsimp [u_x]; ring)
      · exact Or.inr (by rw [hsub]; exact hx_ge1)
    exact ⟨h1x_ne0, hunit_val0 1 u_x hu_mem⟩
  have hval_finset_prod_int : ∀ (T : Finset ℕ) (f : ℕ → L),
      (∀ i ∈ T, f i = 0 ∨ 0 ≤ valL F L (f i)) →
        ((∏ i ∈ T, f i) = 0 ∨ 0 ≤ valL F L (∏ i ∈ T, f i)) := by
    intro T f hT
    induction T using Finset.induction_on with
    | empty => right; simp [hval1]
    | @insert c s hc ih =>
      rw [Finset.prod_insert hc]
      have hmul := hval_mul_ge 0 0 (f c) (∏ i ∈ s, f i)
        (hT c (Finset.mem_insert_self c s))
        (ih (fun i hi => hT i (Finset.mem_insert_of_mem hi)))
      rwa [add_zero] at hmul
  have hval_finset_prod_cong : ∀ (T : Finset ℕ) (f g : ℕ → L) (k : ℤ),
      (∀ i ∈ T, f i = 0 ∨ 0 ≤ valL F L (f i)) →
      (∀ i ∈ T, g i = 0 ∨ 0 ≤ valL F L (g i)) →
      (∀ i ∈ T, f i - g i = 0 ∨ k ≤ valL F L (f i - g i)) →
        ((∏ i ∈ T, f i) - (∏ i ∈ T, g i) = 0 ∨
          k ≤ valL F L ((∏ i ∈ T, f i) - (∏ i ∈ T, g i))) := by
    intro T f g k hf hg hfg
    induction T using Finset.induction_on with
    | empty => exact Or.inl (by simp)
    | @insert c s hc ih =>
      rw [Finset.prod_insert hc, Finset.prod_insert hc]
      have hid : f c * (∏ i ∈ s, f i) - g c * (∏ i ∈ s, g i) =
          (f c - g c) * (∏ i ∈ s, f i) +
            g c * ((∏ i ∈ s, f i) - (∏ i ∈ s, g i)) := by ring
      rw [hid]
      have hs_f := hval_finset_prod_int s f (fun i hi => hf i (Finset.mem_insert_of_mem hi))
      have hs_ih := ih
        (fun i hi => hf i (Finset.mem_insert_of_mem hi))
        (fun i hi => hg i (Finset.mem_insert_of_mem hi))
        (fun i hi => hfg i (Finset.mem_insert_of_mem hi))
      have h1 := hval_mul_ge k 0 (f c - g c) (∏ i ∈ s, f i)
        (hfg c (Finset.mem_insert_self c s)) hs_f
      rw [add_zero] at h1
      have h2 := hval_mul_ge 0 k (g c) ((∏ i ∈ s, f i) - (∏ i ∈ s, g i))
        (hg c (Finset.mem_insert_self c s)) hs_ih
      rw [zero_add] at h2
      exact hval_add k _ _ h1 h2
  have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by omega)
  have hnat : ∀ m : ℕ, ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      rw [Nat.cast_zero, Nat.cast_zero]
      exact ⟨Or.inl rfl, hresL_0⟩
    | succ m ih =>
      have h_int : ((m + 1 : ℕ) : L) = 0 ∨ 0 ≤ valL F L ((m + 1 : ℕ) : L) := by
        rw [Nat.cast_succ]
        exact hval_add 0 (m : L) 1 ih.1 h1_int
      have h_res : resL ((m + 1 : ℕ) : L) = ((m + 1 : ℕ) : k_L) := by
        rw [Nat.cast_succ, (hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1, Nat.cast_succ]
      exact ⟨h_int, h_res⟩
  have hint_int : ∀ z : ℤ, (z : L) = 0 ∨ 0 ≤ valL F L (z : L) := by
    intro z
    cases z with
    | ofNat n =>
      rw [Int.ofNat_eq_natCast, Int.cast_natCast]
      exact (hnat n).1
    | negSucc n =>
      rw [Int.cast_negSucc]
      rcases (hnat (n + 1)).1 with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · exact Or.inr (by rw [hval_neg]; exact hge)
  have hp_kL : (p : k_L) = 0 := by
    rw [← (hnat p).2]
    exact (hresL_ker (p : L) (hnat p).1).mpr hp_val1
  have hdvd_p : ringChar k_L ∣ p := (ringChar.spec k_L p).mp hp_kL
  have hrc_ne1 : ringChar k_L ≠ 1 := by
    intro h1
    have h1_zero : ((1 : ℕ) : k_L) = 0 := (ringChar.spec k_L 1).mpr (by rw [h1])
    rw [Nat.cast_one] at h1_zero
    exact one_ne_zero h1_zero
  have hrc_eq : ringChar k_L = p :=
    (hPrime.eq_one_or_self_of_dvd (ringChar k_L) hdvd_p).resolve_left hrc_ne1
  haveI : CharP k_L p := ringChar.eq_iff.mp hrc_eq
  have hj_props : ∀ j < p, 0 < j → (j : L) ≠ 0 ∧ valL F L (j : L) = 0 := by
    intro j hj_lt hj_pos
    have hj_ndvd : ¬ p ∣ j := Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
    have hj_kL : (j : k_L) ≠ 0 := by
      intro hj0
      exact hj_ndvd ((CharP.cast_eq_zero_iff k_L p j).mp hj0)
    have hj_res : resL (j : L) ≠ 0 := by
      rw [(hnat j).2]
      exact hj_kL
    have hj_not_ker : ¬ ((j : L) = 0 ∨ 1 ≤ valL F L (j : L)) := by
      intro hker
      exact hj_res ((hresL_ker (j : L) (hnat j).1).mpr hker)
    rcases (hnat j).1 with hj0 | hj_ge0
    · exact False.elim (hj_not_ker (Or.inl hj0))
    · refine ⟨fun hj0 => hj_not_ker (Or.inl hj0), ?_⟩
      have hlt1 : ¬ (1 ≤ valL F L (j : L)) := fun h1 => hj_not_ker (Or.inr h1)
      omega
  let u_nat : ℕ → Lˣ := fun j => if h : (j : L) ≠ 0 then Units.mk0 (j : L) h else 1
  let τ_tilde : ℕ → Lˣ := fun j => (u_nat j) ^ (p ^ a)
  let τ_unit : ℕ → Lˣ := fun j => (τ_tilde j) ^ p
  let τ : ℕ → L := fun j => (τ_unit j : L)
  have hu_nat_coe : ∀ j < p, 0 < j → (u_nat j : L) = (j : L) := by
    intro j hj hj0
    have hj_ne : (j : L) ≠ 0 := (hj_props j hj hj0).1
    dsimp [u_nat]
    rw [dif_pos hj_ne, Units.val_mk0]
  have hτ_tilde_coe : ∀ j < p, 0 < j → (τ_tilde j : L) = (j : L) ^ (p ^ a) := by
    intro j hj hj0
    dsimp [τ_tilde]
    rw [hu_nat_coe j hj hj0]
  have hτ_coe : ∀ j < p, 0 < j → τ j = (j : L) ^ (p ^ (a + 1)) := by
    intro j hj hj0
    change ((τ_tilde j : L) ^ p) = (j : L) ^ (p ^ (a + 1))
    rw [hτ_tilde_coe j hj hj0, ← pow_mul, ← pow_succ]
  have hτ_def : ∀ j < p, 0 < j →
      (τ_tilde j : L) = (j : L) ^ (p ^ a) ∧ τ_unit j = (τ_tilde j) ^ p :=
    fun j hj hj0 => ⟨hτ_tilde_coe j hj hj0, rfl⟩
  have hδL_ge1 : δ_L = 0 ∨ (1 : ℤ) ≤ valL F L δ_L := by
    right; rw [hδL_val]; omega
  have hδL_int : δ_L = 0 ∨ 0 ≤ valL F L δ_L := by
    right; rw [hδL_val]; omega
  have hτ_props : ∀ j ∈ S',
      ((τ_tilde j : L) = 0 ∨ 0 ≤ valL F L (τ_tilde j : L)) ∧
      (τ_tilde j : L) ^ p = τ j ∧
      (τ j = 0 ∨ 0 ≤ valL F L (τ j)) ∧
      1 + τ j * δ_L ≠ 0 ∧
      valL F L (1 + τ j * δ_L) = 0 := by
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    have htilde_int : (τ_tilde j : L) = 0 ∨ 0 ≤ valL F L (τ_tilde j : L) := by
      rw [hτ_tilde_coe j hj_lt hj_pos]
      exact hval_pow_int (j : L) (p ^ a) (hnat j).1
    have hpow_eq : (τ_tilde j : L) ^ p = τ j := Units.val_pow_eq_pow_val (τ_tilde j) p
    have hτ_int : τ j = 0 ∨ 0 ≤ valL F L (τ j) := by
      rw [← hpow_eq]
      exact hval_pow_int (τ_tilde j : L) p htilde_int
    have hτδ_ge1 : τ j * δ_L = 0 ∨ (1 : ℤ) ≤ valL F L (τ j * δ_L) := by
      have hmul := hval_mul_ge 0 1 (τ j) δ_L hτ_int hδL_ge1
      rwa [zero_add] at hmul
    have hunit := hunit_of_gt0 (τ j * δ_L) hτδ_ge1
    exact ⟨htilde_int, hpow_eq, hτ_int, hunit.1, hunit.2⟩
  let m_p : ℕ := (p - 1) * b / p
  have hτ_diff : ∀ j ∈ S',
      τ j - (j : L) = 0 ∨ (m_p : ℤ) ≤ valL F L (τ j - (j : L)) := by
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    have hzmod : ((((j : ℤ) ^ (p ^ (a + 1)) : ℤ) : ZMod p)) = ((j : ℤ) : ZMod p) := by
      rw [Int.cast_pow]
      exact ZMod.pow_card_pow (n := a + 1) ((j : ℤ) : ZMod p)
    have hdvd : (p : ℤ) ∣ ((j : ℤ) ^ (p ^ (a + 1)) - (j : ℤ)) :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub (j : ℤ) ((j : ℤ) ^ (p ^ (a + 1))) p).mp hzmod.symm
    rcases hdvd with ⟨k, hk⟩
    have hcast_eq : τ j - (j : L) = (p : L) * (k : L) := by
      rw [hτ_coe j hj_lt hj_pos]
      have hkL := congrArg (Int.cast : ℤ → L) hk
      push_cast at hkL
      exact hkL
    rw [hcast_eq]
    have hmul := hval_mul_ge (m_p : ℤ) 0 (p : L) (k : L) hp_val (hint_int k)
    rwa [add_zero] at hmul
  obtain ⟨hT1, hT2, hT3_δ, hT4⟩ := hTeich δ_L hδL_int τ_unit τ_tilde hτ_def
  have hT3_0 := (hTeich 0 (Or.inl rfl) τ_unit τ_tilde hτ_def).2.2.1
  have hTeich_1 : ∀ j ∈ S',
      (τ_tilde j : L) - τ j = 0 ∨ (a + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - τ j) := by
    intro j hj
    exact hT1 j (Finset.mem_range.mp (Finset.mem_erase.mp hj).2)
      (Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1)
  have hTeich_2 : ∀ j ∈ S',
      (τ j) ^ (p - 1) - 1 = 0 ∨ (a + 1 : ℤ) ≤ valL F L ((τ j) ^ (p - 1) - 1) := by
    intro j hj
    exact hT2 j (Finset.mem_range.mp (Finset.mem_erase.mp hj).2)
      (Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1)
  have hTeich_4 : ∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
      (∑ j ∈ S', (τ j) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
        (a + 1 : ℤ) ≤
          valL F L
            ((∑ j ∈ S', (τ j) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0)) := hT4
  have hunit_pow_pk : ∀ (k : ℕ) (u : Lˣ),
      u ∈ unitGroup F L 1 → u ^ (p ^ k) ∈ unitGroup F L (k + 1) := by
    intro k u hu
    induction k with
    | zero =>
      rw [pow_zero, pow_one, zero_add]
      exact hu
    | succ k ih =>
      rw [pow_succ, pow_mul]
      exact hunit_pow_p (k + 1) (by omega) (u ^ (p ^ k)) ih
  let inv_p : ℕ → ℕ := fun j => ((j : ZMod p)⁻¹).val
  have hinv_p_props : ∀ j ∈ S',
      inv_p j ∈ S' ∧
      inv_p (inv_p j) = j ∧
      (τ j * τ (inv_p j) - 1 = 0 ∨ (a + 1 : ℤ) ≤ valL F L (τ j * τ (inv_p j) - 1)) := by
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    have hj_ndvd : ¬ p ∣ j := Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
    have hj_zmod_ne0 : (j : ZMod p) ≠ 0 :=
      fun h0 => hj_ndvd ((ZMod.natCast_eq_zero_iff j p).mp h0)
    have hinv_zmod_ne0 : ((j : ZMod p)⁻¹) ≠ 0 := inv_ne_zero hj_zmod_ne0
    have hinv_lt : inv_p j < p := ZMod.val_lt ((j : ZMod p)⁻¹)
    have hinv_ne0 : inv_p j ≠ 0 :=
      fun h0 => hinv_zmod_ne0 ((ZMod.val_eq_zero ((j : ZMod p)⁻¹)).mp h0)
    have hinv_pos : 0 < inv_p j := Nat.pos_of_ne_zero hinv_ne0
    have hinv_mem : inv_p j ∈ S' :=
      Finset.mem_erase.mpr ⟨hinv_ne0, Finset.mem_range.mpr hinv_lt⟩
    have hinv_inv : inv_p (inv_p j) = j := by
      dsimp [inv_p]
      rw [ZMod.natCast_zmod_val, inv_inv, ZMod.val_natCast_of_lt hj_lt]
    have hmul_zmod : (((j : ℤ) * (inv_p j : ℤ) : ℤ) : ZMod p) = ((1 : ℤ) : ZMod p) := by
      push_cast
      rw [ZMod.natCast_zmod_val]
      exact mul_inv_cancel₀ hj_zmod_ne0
    have hdvd_mul : (p : ℤ) ∣ ((j : ℤ) * (inv_p j : ℤ) - 1) :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub 1 ((j : ℤ) * (inv_p j : ℤ)) p).mp hmul_zmod.symm
    rcases hdvd_mul with ⟨k, hk⟩
    have hu_mul_coe : ((u_nat j * u_nat (inv_p j) : Lˣ) : L) - 1 = (p : L) * (k : L) := by
      rw [Units.val_mul, hu_nat_coe j hj_lt hj_pos, hu_nat_coe (inv_p j) hinv_lt hinv_pos]
      have hkL := congrArg (Int.cast : ℤ → L) hk
      push_cast at hkL
      exact hkL
    have hu_mul_mem1 : u_nat j * u_nat (inv_p j) ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl (u_nat j * u_nat (inv_p j)), hu_mul_coe]
      have hmul := hval_mul_ge 1 0 (p : L) (k : L) hp_val1 (hint_int k)
      rw [add_zero] at hmul
      rcases hmul with h0 | hge1
      · exact Or.inl (sub_eq_zero.mp (hu_mul_coe.trans h0))
      · exact Or.inr hge1
    have hτ_mul_eq : (u_nat j * u_nat (inv_p j)) ^ (p ^ (a + 1)) =
        τ_unit j * τ_unit (inv_p j) := by
      rw [mul_pow]
      dsimp [τ_unit, τ_tilde]
      rw [← pow_mul, ← pow_mul, ← pow_succ]
    have hτ_mul_mem : τ_unit j * τ_unit (inv_p j) ∈ unitGroup F L (a + 2) := by
      rw [← hτ_mul_eq]
      exact hunit_pow_pk (a + 1) (u_nat j * u_nat (inv_p j)) hu_mul_mem1
    have hτ_mul_val := (hunit_ge1 (a + 2) (by omega) (τ_unit j * τ_unit (inv_p j))).mp hτ_mul_mem
    have hτ_coe_mul : ((τ_unit j * τ_unit (inv_p j) : Lˣ) : L) = τ j * τ (inv_p j) :=
      Units.val_mul (τ_unit j) (τ_unit (inv_p j))
    rw [hτ_coe_mul] at hτ_mul_val
    refine ⟨hinv_mem, hinv_inv, ?_⟩
    rcases hτ_mul_val with h1 | hge
    · exact Or.inl (sub_eq_zero.mpr h1)
    · exact Or.inr (by omega)
  have hprod_reindex :
      (∏ j ∈ S', (δ_L + τ (inv_p j))) = ∏ j ∈ S', (δ_L + τ j) := by
    refine Finset.prod_bij (fun j _ => inv_p j) ?_ ?_ ?_ ?_
    · intro j hj
      exact (hinv_p_props j hj).1
    · intro j₁ hj₁ j₂ hj₂ heq
      have h1 := (hinv_p_props j₁ hj₁).2.1
      have h2 := (hinv_p_props j₂ hj₂).2.1
      calc j₁ = inv_p (inv_p j₁) := h1.symm
        _ = inv_p (inv_p j₂) := congrArg inv_p heq
        _ = j₂ := h2
    · intro b hb
      exact ⟨inv_p b, (hinv_p_props b hb).1, (hinv_p_props b hb).2.1⟩
    · intro j _
      rfl
  let P_1 : L := ∏ j ∈ S', (1 + τ j * δ_L)
  let P_τ : L := ∏ j ∈ S', τ j
  let P_δτ : L := ∏ j ∈ S', (δ_L + τ j)
  have hΔ1 : P_1 - P_τ * P_δτ = 0 ∨ (a + 1 : ℤ) ≤ valL F L (P_1 - P_τ * P_δτ) := by
    have hprod_eq : P_τ * P_δτ = ∏ j ∈ S', (τ j * (δ_L + τ (inv_p j))) := by
      rw [Finset.prod_mul_distrib, hprod_reindex]
    rw [hprod_eq]
    apply hval_finset_prod_cong S'
      (fun j => 1 + τ j * δ_L)
      (fun j => τ j * (δ_L + τ (inv_p j)))
      (a + 1 : ℤ)
    · intro j hj
      exact Or.inr (le_of_eq (hτ_props j hj).2.2.2.2.symm)
    · intro j hj
      have hinv_mem := (hinv_p_props j hj).1
      have hsum := hval_add 0 δ_L (τ (inv_p j)) hδL_int (hτ_props (inv_p j) hinv_mem).2.2.1
      have hmul := hval_mul_ge 0 0 (τ j) (δ_L + τ (inv_p j)) (hτ_props j hj).2.2.1 hsum
      rwa [add_zero] at hmul
    · intro j hj
      have hid : (1 + τ j * δ_L) - τ j * (δ_L + τ (inv_p j)) =
          -(τ j * τ (inv_p j) - 1) := by ring
      rw [hid]
      rcases (hinv_p_props j hj).2.2 with h0 | hge
      · exact Or.inl (by rw [h0, neg_zero])
      · exact Or.inr (by rw [hval_neg]; exact hge)
  have hP_τ_cong : P_τ - (-1 : L) = 0 ∨ (a + 1 : ℤ) ≤ valL F L (P_τ - (-1 : L)) := by
    have h0_eq : (∏ j ∈ S', ((0 : L) + (τ_unit j : L))) - ((0 : L) ^ (p - 1) - 1) =
        P_τ - (-1 : L) := by
      have hprod0 : (∏ j ∈ S', ((0 : L) + (τ_unit j : L))) = P_τ :=
        Finset.prod_congr rfl (fun j _ => zero_add (τ j))
      rw [hprod0, zero_pow hp1_ne0, zero_sub]
    rwa [h0_eq] at hT3_0
  have hP_δτ_int : P_δτ = 0 ∨ 0 ≤ valL F L P_δτ := by
    apply hval_finset_prod_int S' (fun j => δ_L + τ j)
    intro j hj
    exact hval_add 0 δ_L (τ j) hδL_int (hτ_props j hj).2.2.1
  have hΔ2 : P_τ * P_δτ - (1 - δ_L ^ (p - 1)) = 0 ∨
      (a + 1 : ℤ) ≤ valL F L (P_τ * P_δτ - (1 - δ_L ^ (p - 1))) := by
    have hid : P_τ * P_δτ - (1 - δ_L ^ (p - 1)) =
        (P_τ - (-1 : L)) * P_δτ - (P_δτ - (δ_L ^ (p - 1) - 1)) := by ring
    rw [hid]
    have h1 := hval_mul_ge (a + 1 : ℤ) 0 (P_τ - (-1 : L)) P_δτ hP_τ_cong hP_δτ_int
    rw [add_zero] at h1
    exact hval_sub (a + 1 : ℤ) _ _ h1 hT3_δ
  have hTeich_3_inv : P_1 - (1 - δ_L ^ (p - 1)) = 0 ∨
      (a + 1 : ℤ) ≤ valL F L (P_1 - (1 - δ_L ^ (p - 1))) := by
    have hid : P_1 - (1 - δ_L ^ (p - 1)) =
        (P_1 - P_τ * P_δτ) + (P_τ * P_δτ - (1 - δ_L ^ (p - 1))) := by ring
    rw [hid]
    exact hval_add (a + 1 : ℤ) _ _ hΔ1 hΔ2
  exact ⟨τ_tilde, τ, hτ_props, hτ_diff, hTeich_1, hTeich_2, hTeich_3_inv, hTeich_4⟩

theorem ld_wild_mid_cond_odd_prime_correction_units (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (b a t : ℕ) (hb_ge2 : 2 ≤ b) (hba : b < a) (ha2b : a < 2 * b) (hb_eq : b = t + 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (δ : Lˣ) (u_K u_corr : Kˣ)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((a - b : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((a - b : ℕ) : ℤ))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (s : K → ℕ → L)
    (hsp1 : ∀ y : K, y ≠ 0 →
      s y (Module.finrank L (IntermediateField.extendScalars hLK) - 1) =
        normLM F hLK y * traceLM F hLK (y⁻¹))
    (hs_val : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_poly : ∀ (y : K) (c : L),
      normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
        1 +
          (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
            c ^ r * s y r) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y)
    (τ_tilde : ℕ → Lˣ) (τ : ℕ → L)
    (hτ_props : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      ((τ_tilde j : L) = 0 ∨ 0 ≤ valL F L (τ_tilde j : L)) ∧
      (τ_tilde j : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = τ j ∧
      (τ j = 0 ∨ 0 ≤ valL F L (τ j)) ∧
      1 + τ j * (δ : L) ≠ 0 ∧
      valL F L (1 + τ j * (δ : L)) = 0)
    (hTeich_1 : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      (τ_tilde j : L) - τ j = 0 ∨ (a + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - τ j))
    (hTeich_3_inv :
      (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
        (1 + τ j * (δ : L))) - (1 - (δ : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) = 0 ∨
      (a + 1 : ℤ) ≤
        valL F L
          ((∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
              (1 + τ j * (δ : L))) -
            (1 - (δ : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let S' := (Finset.range p).erase 0
    let m_1 := ((p - 1) * b + (a - b)) / p
    ∃ (δ₀ : L) (δ_err s_u : ℕ → L) (z₀ : Lˣ) (z : ℕ → Lˣ),
      (∀ r ∈ Finset.Icc 1 (p - 1),
        s_u r = 0 ∨ (m_1 : ℤ) ≤ valL F L (s_u r)) ∧
      s_u (p - 1) = (δ : L) * traceLM F hLK ((u_K⁻¹ : Kˣ) : K) ∧
      (∀ j ∈ S',
        δ_err j = 0 ∨ (m_1 : ℤ) ≤ valL F L (δ_err j)) ∧
      (∀ j ∈ S',
        δ_err j = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L (δ_err j)) ∧
      (δ₀ = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L δ₀) ∧
      (z₀ : L) = 1 + δ₀ ∧
      normLM F hLK (u_corr : K) = (∏ j ∈ S', (1 + τ j * (δ : L))) * (z₀ : L) ∧
      (∀ j ∈ S',
        (z j : L) = 1 + δ_err j ∧
        ∃ w_j : Kˣ, normLM F hLK (w_j : K) = (1 + τ j * (δ : L)) * (z j : L)) ∧
      ((1 - (δ : L) ^ (p - 1)) * δ₀ +
        (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * (δ : L) ^ (p - 1 - r) * s_u r) = 0 ∨
        (a + 1 : ℤ) ≤
          valL F L
            ((1 - (δ : L) ^ (p - 1)) * δ₀ +
              (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * (δ : L) ^ (p - 1 - r) * s_u r))) ∧
      (∀ j ∈ S',
        (1 + τ j * (δ : L)) * δ_err j -
          (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r) = 0 ∨
          (a + 1 : ℤ) ≤
            valL F L
              ((1 + τ j * (δ : L)) * δ_err j -
                (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r))) :=
by
  intro p S' m_1
  let m_a : ℕ := ((p - 1) * a) / p
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd' : Odd p := hPrime.odd_of_ne_two hp_odd
  have hp_ge3 : 3 ≤ p := by
    rcases hp_odd' with ⟨k, hk⟩
