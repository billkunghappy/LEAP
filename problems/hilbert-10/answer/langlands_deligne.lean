        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x)) ∧
      valL F L (c_twist j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
