    dsimp only [U₁, V₁, a₁, A, Q₁, k₀, h₀]
    simp only [map_sub, map_add, map_mul, map_pow, map_neg, map_one, map_ofNat]
    linear_combination (1 - (IntermediateField.inclusion hLM₁' c₁) ^ 2 *
