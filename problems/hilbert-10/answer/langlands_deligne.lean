        linarith only [hm₀_def, hpr_z]
      rw [hQp_decomp]
      exact hvalM₁'_add m₀ _ _ (hvalM₁'_add m₀ _ _ hq_piece1 hq_piece2) htr_Wp_val

    have hPQ_diff : P_p - Q_p = 0 ∨ m₀ ≤ vM₁' (P_p - Q_p) := by
      have h := hvalM₁'_sub m₀ (P_p - ((p : ℕ) : R_M) * b ^ p) (Q_p - ((p : ℕ) : R_M) * b ^ p)
        hPp_bound hQp_bound
      have hid : (P_p - ((p : ℕ) : R_M) * b ^ p) - (Q_p - ((p : ℕ) : R_M) * b ^ p) = P_p - Q_p := by
        ring
      rwa [hid] at h

    refine ⟨hNewton, hClaimA, hClaimB, ?_⟩
    intro x hx X P_p' Q_p'
    have hPp_eq' : P_p' = P_p := by
      change b ^ p +
        ∑ m ∈ (Finset.range p).erase 0,
          nmM₁'K₁ (Δ_val + iM₁'K₁ (iLM₁' (τ_val m))) ^ p = P_p
      rw [hP_p_def, hS_p_def]
      congr 1
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [← hξ_def]
    have hQp_eq' : Q_p' = Q_p := by
      change trM₁'K₁ ((Δ_val ^ p - Δ_val) ^ p) = Q_p
      exact hQ_p_def.symm
    rw [hPp_eq', hQp_eq']
    rcases hx with rfl | hx_ge
    · left
      dsimp [X]
      rw [hnorm_zero_LE', map_zero, zero_mul]
    · have hX_val :
          iLM₁' X = 0 ∨
            (d₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ vM₁' (iLM₁' X) := by
        right
        dsimp [X]
        rw [hval_LM₁', hval_norm_LE']
        linarith only [hx_ge]
      have hmul := hvalM₁'_mul_ge
        ((d₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ)) m₀
        (iLM₁' X) (P_p - Q_p)
        hX_val hPQ_diff
      refine hvalM₁'_mono (((p * t₂ + 1 : ℕ) : ℤ)) _ _ ?_ hmul
      push_cast at hd₁_z ⊢
      have hid :
          ((d₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) + m₀) - ((p : ℤ) * (t₂ : ℤ) + 1) =
          ((d₁ : ℤ) + (t₁ : ℤ)) - ((t₂ : ℤ) + 1) := by
        rw [hm₀_def, hp_sub1_z, hp_sub2_z]; ring
      linarith only [hid, hd₁_z]
  have htr_smul_M₁'K₁ : ∀ (c : M₁') (w : K₁),
      traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c * w) =
        c * traceLM F hM₁'K₁ w := by
    letI : Module M₁' M₁' := Semiring.toModule
    exact fun c w => (Algebra.trace M₁' (IntermediateField.extendScalars hM₁'K₁)).map_smul' c
      (toExtendScalars F hM₁'K₁ w)
  have htr_incl_M₁'K₁ : ∀ c : M₁',
      traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : M₁') * c := by
    intro c
    have h1 : traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        (Algebra.trace M₁' (IntermediateField.extendScalars hM₁'K₁))
          ((algebraMap M₁' (IntermediateField.extendScalars hM₁'K₁)) c) := rfl
    rw [h1, Algebra.trace_algebraMap, hdegM₁'K₁, nsmul_eq_mul]
  have hnorm_incl_M₁'K₁ : ∀ c : M₁',
      normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        c ^ (Module.finrank L (IntermediateField.extendScalars hLE')) := by
    intro c
    have h1 : normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        (Algebra.norm M₁' (S := IntermediateField.extendScalars hM₁'K₁))
          ((algebraMap M₁' (IntermediateField.extendScalars hM₁'K₁)) c) := rfl
    rw [h1, Algebra.norm_algebraMap, hdegM₁'K₁]
  have hnorm_zero_LE' : normLM F hLE' 0 = 0 := by
    have h1 : normLM F hLE' 0 =
        (Algebra.norm L (S := IntermediateField.extendScalars hLE'))
          ((algebraMap L (IntermediateField.extendScalars hLE')) 0) := rfl
    rw [h1, Algebra.norm_algebraMap, zero_pow hPrime.ne_zero]
  have hvalM₁'_surj : ∀ m : ℤ, ∃ c : M₁', c ≠ 0 ∧ valL F M₁' c = m := by
    intro m
    obtain ⟨c, hc⟩ := hvalM₁'_props.2.2.2.2.2.2.1 m
    exact ⟨(c : M₁'), Units.ne_zero c, hc⟩
  exact hAbstract
    (IntermediateField.inclusion hLM₁').toRingHom
    (IntermediateField.inclusion hE'K₁).toRingHom
    (IntermediateField.inclusion hM₁'K₁).toRingHom
    (IntermediateField.inclusion hLM₁').injective
    (IntermediateField.inclusion hM₁'K₁).injective
    (valL F L) (valL F E') (valL F M₁') (valL F K₁)
    (traceLM F hM₁'K₁) (normLM F hLE') (normLM F hM₁'K₁)
    (Module.finrank L (IntermediateField.extendScalars hLE'))
    hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
    hp_valK₁
    hvalE'_props.2.1
    hvalM₁'_props.2.1 hvalM₁'_props.2.2.1 hvalM₁'_props.2.2.2.1
    hvalM₁'_props.2.2.2.2.1 hvalM₁'_surj hvalM₁'_props.2.2.2.2.2.2.2.1
    hvalK₁_props.2.1 hvalK₁_props.2.2.2.1 hvalK₁_props.2.2.2.2.1 hvalK₁_props.2.2.2.2.2.2.2.1
    hval_norm_LE' hval_LM₁' hval_M₁'K₁ hval_norm_M₁'K₁
    htr_M₁'K₁ htr_smul_M₁'K₁ htr_incl_M₁'K₁ hnorm_incl_M₁'K₁ hnorm_zero_LE'
    s₁ hs₁_norm_one_add hs₁_cayley hs₁_newton1
    (Δ : K₁) hΔ_val hTwistedTr
    e_Δ he_Δ_val he_Δ_poly he_Δ_cayley
