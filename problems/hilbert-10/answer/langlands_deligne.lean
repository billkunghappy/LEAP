    have hπ_i_val : valL F K π_i = (q : ℤ) := by
      have h1 := hValAlgK (IntermediateField.inclusion (hFiMC i) (ϖ_i : (D_orb.get i).field))
      have h2 := hValAlgFiMC i (ϖ_i : (D_orb.get i).field)
