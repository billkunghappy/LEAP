    hα_val hcν₂_stat hcν₁_stat c₀ c₁ hc₀_val hc₁_val
    hnorm_tr_M₁' hnorm_tr_E' hN₁_ne hN₁_val hcM₁'_stat_N₁

theorem ld_ch12_wild_dyadic_even_breaks_residue_finsets_and_lamprecht_reduction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hqE' : qL F E' = qL F L)
    (hqM₁' : qL F M₁' = qL F L)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (heps1_E' : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F L : Ω F) ^ condExpChar F E' (traceChar F hLE' ψ))
    (heps1_M₁' : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
      (qL F L : Ω F) ^ condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
    (hm2_min : condExp F E' (recChar F rec E' χE') =
      condExp F L νM₁' + condExp F L νE' - 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hcard_kL : Fintype.card k_L = qL F L)
    (liftL : k_L → L)
    (hliftL : ∀ a : k_L, (liftL a = 0 ∨ 0 ≤ valL F L (liftL a)) ∧ resL (liftL a) = a)
    (ϖ_E' : E'ˣ) (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hBasis_E' : ∀ y : E', ∃ c : Fin 2 → L,
      y = ∑ i : Fin 2, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin 2, c i = 0 ∨ m ≤ 2 * valL F L (c i) + (i : ℤ))
    (x : M₁')
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (α : Lˣ) (C : K₁ˣ)
    (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0)
    (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0)
    (hcE'_val : valL F E'
      ((Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
        (Units.map (normLM F hE'K₁) C)⁻¹ : E'ˣ) : E') =
      (condExp F E' (recChar F rec E' χE') : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ w : E',
      (w = 0 ∨ (((condExp F E' (recChar F rec E' χE') + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ∀ hw : 1 + w ≠ 0,
        ((recChar F rec E' χE') (Units.mk0 (1 + w) hw) : Ω F) =
          (traceChar F hLE' ψ)
            (((((Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
              (Units.map (normLM F hE'K₁) C)⁻¹)⁻¹ : E'ˣ) : E') * w)))
    (hcM₁'_val : valL F M₁'
      ((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
        (Units.map (normLM F hM₁'K₁) C)⁻¹ : M₁'ˣ) : M₁') =
      (condExp F M₁' (recChar F rec M₁' χM₁') : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        ((recChar F rec M₁' χM₁') (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ)
            (((((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
              (Units.map (normLM F hM₁'K₁) C)⁻¹)⁻¹ : M₁'ˣ) : M₁') * z)))
    (hcνE'_val : valL F L
      ((α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹ : Lˣ) : L) =
      (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hcνE'_stat : ∀ u : L,
      (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) =
          ψ (((((α * (Units.map (normLM F hLE')
            (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹)⁻¹ : Lˣ) : L) * u)))
    (hcνM₁'_val : valL F L
      ((α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹ : Lˣ) : L) =
      (condExp F L νM₁' : ℤ) + condExpChar F L ψ)
    (hcνM₁'_stat : ∀ u : L,
      (u = 0 ∨ (((condExp F L νM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νM₁' (Units.mk0 (1 + u) hu) : Ω F) =
          ψ (((((α * (Units.map (normLM F hLM₁')
            (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹)⁻¹ : Lˣ) : L) * u)))
    (hPrefactor :
      ((recChar F rec E' χE')
          (Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
            (Units.map (normLM F hE'K₁) C)⁻¹) : Ω F) *
        (νE' (α * (Units.map (normLM F hLE')
          (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹) : Ω F) *
        (traceChar F hLE' ψ)
          ((((Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
            (Units.map (normLM F hE'K₁) C)⁻¹)⁻¹ : E'ˣ) : E')) *
        ψ ((((α * (Units.map (normLM F hLE')
          (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹)⁻¹ : Lˣ) : L)) =
      ((recChar F rec M₁' χM₁')
          (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
            (Units.map (normLM F hM₁'K₁) C)⁻¹) : Ω F) *
        (νM₁' (α * (Units.map (normLM F hLM₁')
          (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹) : Ω F) *
        (traceChar F hLM₁' ψ)
          ((((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
            (Units.map (normLM F hM₁'K₁) C)⁻¹)⁻¹ : M₁'ˣ) : M₁')) *
        ψ ((((α * (Units.map (normLM F hLM₁')
          (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹)⁻¹ : Lˣ) : L)))
    (δ₁ : M₁'ˣ) (δ₂ : E'ˣ)
    (hδ₁ : valL F M₁' (δ₁ : M₁') = ((condExp F M₁' (recChar F rec M₁' χM₁') / 2 : ℕ) : ℤ))
    (hδ₂ : valL F E' (δ₂ : E') = ((condExp F E' (recChar F rec E' χE') / 2 : ℕ) : ℤ))
    (hSumEq :
      let θE' := recChar F rec E' χE'
      let θM₁' := recChar F rec M₁' χM₁'
      let ψE' := traceChar F hLE' ψ
      let ψM₁' := traceChar F hLM₁' ψ
      let cE' : E'ˣ :=
        Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
          (Units.map (normLM F hE'K₁) C)⁻¹
      let cM₁' : M₁'ˣ :=
        Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
          (Units.map (normLM F hM₁'K₁) C)⁻¹
      (∑ a : k_L,
        if hr : 1 + (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a) ≠ 0 then
          (θE' (Units.mk0 (1 + (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a)) hr) : Ω F)⁻¹ *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a))
        else 0) =
      (∑ a : k_L,
        if hr : 1 + (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a) ≠ 0 then
          (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a)) hr) : Ω F)⁻¹ *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a))
        else 0)) :
    tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ) *
      tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
      tateEps F L νE' ψ =
    tateEps F M₁' (recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ) *
      tateEps F E' 1 (traceChar F hLE' ψ) *
      tateEps F L νM₁' ψ :=
by
  classical
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, _, _, _⟩ := hvalL_props
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E',
    hval_inv_E', hval_surj_E', hval_add_E', _, _, _⟩ := hvalE'_props
  obtain ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁',
    hval_inv_M₁', hval_surj_M₁', hval_add_M₁', _, _, _⟩ := hvalM₁'_props
  have hval_sub_L : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    have hneg2 : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_L]; exact hge)
    exact hval_add_L k x₁ (-x₂) hx₁ hneg2
  have hresL_sub : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    have hneg2 : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_L]; exact hge)
    have hadd := (hresL_ring x₁ (-x₂) hx₁ hneg2).1
    have hneg := (hresL_ring x₂ x₂ hx₂ hx₂).2.2
    rw [sub_eq_add_neg, hadd, hneg, ← sub_eq_add_neg]
  have hliftL_inj : Function.Injective liftL := by
    intro a₁ a₂ h
    have h1 := (hliftL a₁).2
    have h2 := (hliftL a₂).2
    rw [h] at h1
    exact h1.symm.trans h2
  let R_L : Finset L := Finset.univ.image liftL
  let ι_E := IntermediateField.inclusion hLE'
  let ι_M := IntermediateField.inclusion hLM₁'
  let R_E' : Finset E' := R_L.image ι_E
  let R_M₁' : Finset M₁' := R_L.image ι_M
  have hRL_card : R_L.card = qL F L := by
    dsimp [R_L]
    rw [Finset.card_image_of_injective _ hliftL_inj, Finset.card_univ, hcard_kL]
  have hRE'_card : R_E'.card = qL F L :=
    (Finset.card_image_of_injective R_L ι_E.injective).trans hRL_card
  have hRM₁'_card : R_M₁'.card = qL F L :=
    (Finset.card_image_of_injective R_L ι_M.injective).trans hRL_card
  have hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨a, _, rfl⟩
    exact (hliftL a).1
  have hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0 := by
    intro r₁ hr₁ r₂ hr₂ hr_ne
    rcases Finset.mem_image.mp hr₁ with ⟨a₁, _, rfl⟩
    rcases Finset.mem_image.mp hr₂ with ⟨a₂, _, rfl⟩
    have hsub_int : liftL a₁ - liftL a₂ = 0 ∨ 0 ≤ valL F L (liftL a₁ - liftL a₂) :=
      hval_sub_L 0 (liftL a₁) (liftL a₂) (hliftL a₁).1 (hliftL a₂).1
    have hsub_ne : liftL a₁ - liftL a₂ ≠ 0 := sub_ne_zero.mpr hr_ne
    have hge0 : 0 ≤ valL F L (liftL a₁ - liftL a₂) := hsub_int.resolve_left hsub_ne
    by_contra hne0
    have hge1 : 1 ≤ valL F L (liftL a₁ - liftL a₂) := by omega
    have hres0 : resL (liftL a₁ - liftL a₂) = 0 :=
      (hresL_ker (liftL a₁ - liftL a₂) hsub_int).mpr (Or.inr hge1)
    rw [hresL_sub (liftL a₁) (liftL a₂) (hliftL a₁).1 (hliftL a₂).1,
      (hliftL a₁).2, (hliftL a₂).2] at hres0
    exact hr_ne (congrArg liftL (sub_eq_zero.mp hres0))
  have hRL_surj : ∀ u : L, (u = 0 ∨ 0 ≤ valL F L u) →
      ∃ r ∈ R_L, u - r = 0 ∨ 1 ≤ valL F L (u - r) := by
    intro u hu
    refine ⟨liftL (resL u), Finset.mem_image_of_mem liftL (Finset.mem_univ (resL u)), ?_⟩
    have hsub_int : u - liftL (resL u) = 0 ∨ 0 ≤ valL F L (u - liftL (resL u)) :=
      hval_sub_L 0 u (liftL (resL u)) hu (hliftL (resL u)).1
    apply (hresL_ker (u - liftL (resL u)) hsub_int).mp
    rw [hresL_sub u (liftL (resL u)) hu (hliftL (resL u)).1, (hliftL (resL u)).2, sub_self]
  have hRE'_int : ∀ r ∈ R_E', r = 0 ∨ 0 ≤ valL F E' r := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨r_L, hr_L, rfl⟩
    rcases hRL_int r_L hr_L with rfl | hge0
    · exact Or.inl (map_zero _)
    · right
      rw [hval_LE' r_L]
      omega
  have hRE'_sep : ∀ r₁ ∈ R_E', ∀ r₂ ∈ R_E', r₁ ≠ r₂ → valL F E' (r₁ - r₂) = 0 := by
    intro r₁ hr₁ r₂ hr₂ hr_ne
    rcases Finset.mem_image.mp hr₁ with ⟨x₁, hx₁, rfl⟩
    rcases Finset.mem_image.mp hr₂ with ⟨x₂, hx₂, rfl⟩
    have hx_ne : x₁ ≠ x₂ := fun h => hr_ne (congrArg ι_E h)
    rw [← map_sub, hval_LE' (x₁ - x₂), hRL_sep x₁ hx₁ x₂ hx₂ hx_ne, mul_zero]
  have hRE'_surj : ∀ y : E', (y = 0 ∨ 0 ≤ valL F E' y) →
      ∃ r ∈ R_E', y - r = 0 ∨ 1 ≤ valL F E' (y - r) := by
    intro y hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis_E' y
    have hc_all := (hval_iff 0).mp hy
    have hc0 : c 0 = 0 ∨ 0 ≤ valL F L (c 0) := by
      rcases hc_all 0 with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ 2 * valL F L (c 0) + (0 : ℤ) at hge
        omega
    have hc1 : c 1 = 0 ∨ 1 ≤ 2 * valL F L (c 1) + 1 := by
      rcases hc_all 1 with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ 2 * valL F L (c 1) + (1 : ℤ) at hge
        omega
    have hy_sub_c0 : y - ι_E (c 0) = ι_E (c 1) * (ϖ_E' : E') := by
      rw [hy_eq, Fin.sum_univ_two]
      change (ι_E (c 0) * (ϖ_E' : E') ^ (0 : ℕ) + ι_E (c 1) * (ϖ_E' : E') ^ (1 : ℕ)) -
        ι_E (c 0) = _
      rw [pow_zero, pow_one, mul_one, add_sub_cancel_left]
    have hyc0_val : y - ι_E (c 0) = 0 ∨ 1 ≤ valL F E' (y - ι_E (c 0)) := by
      rw [hy_sub_c0]
      rcases eq_or_ne (c 1) 0 with h0 | hne0
      · exact Or.inl (by rw [h0, map_zero, zero_mul])
      · right
        have hge1 : 1 ≤ 2 * valL F L (c 1) + 1 := hc1.resolve_left hne0
        have hι_ne : ι_E (c 1) ≠ 0 := (map_ne_zero_iff ι_E ι_E.injective).mpr hne0
        rw [hval_mul_E' (ι_E (c 1)) (ϖ_E' : E') hι_ne (Units.ne_zero ϖ_E'),
          hval_LE' (c 1), hϖ_E']
        exact hge1
    obtain ⟨r_L, hr_L_mem, hcr⟩ := hRL_surj (c 0) hc0
    refine ⟨ι_E r_L, Finset.mem_image_of_mem _ hr_L_mem, ?_⟩
    have hcr_E' : ι_E (c 0) - ι_E r_L = 0 ∨ 1 ≤ valL F E' (ι_E (c 0) - ι_E r_L) := by
      rw [← map_sub]
      rcases hcr with h0 | hge1
      · exact Or.inl (by rw [h0, map_zero])
      · right
        rw [hval_LE' (c 0 - r_L)]
        omega
    have hadd_eq : y - ι_E r_L = (y - ι_E (c 0)) + (ι_E (c 0) - ι_E r_L) := by ring
    rw [hadd_eq]
    exact hval_add_E' 1 _ _ hyc0_val hcr_E'
  have hRM₁'_int : ∀ r ∈ R_M₁', r = 0 ∨ 0 ≤ valL F M₁' r := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨r_L, hr_L, rfl⟩
    rcases hRL_int r_L hr_L with rfl | hge0
    · exact Or.inl (map_zero _)
    · right
      rw [hval_LM₁' r_L]
      omega
  have hRM₁'_sep : ∀ r₁ ∈ R_M₁', ∀ r₂ ∈ R_M₁', r₁ ≠ r₂ → valL F M₁' (r₁ - r₂) = 0 := by
    intro r₁ hr₁ r₂ hr₂ hr_ne
    rcases Finset.mem_image.mp hr₁ with ⟨x₁, hx₁, rfl⟩
    rcases Finset.mem_image.mp hr₂ with ⟨x₂, hx₂, rfl⟩
    have hx_ne : x₁ ≠ x₂ := fun h => hr_ne (congrArg ι_M h)
    rw [← map_sub, hval_LM₁' (x₁ - x₂), hRL_sep x₁ hx₁ x₂ hx₂ hx_ne, mul_zero]
  have hx_ne : x ≠ 0 := by
    intro hx0
    have h0 : valL F M₁' x = 0 := by rw [hx0, hval0_M₁']
    rw [hx_val] at h0
    omega
  have hRM₁'_surj : ∀ z : M₁', (z = 0 ∨ 0 ≤ valL F M₁' z) →
      ∃ r ∈ R_M₁', z - r = 0 ∨ 1 ≤ valL F M₁' (z - r) := by
    intro z hz
    obtain ⟨s₀, s₁, hz_eq, hz_iff⟩ := hM₁'_coords z
    obtain ⟨hs₀_0, hs₁_0⟩ := (hz_iff 0).mp hz
    have hs₀_int : s₀ = 0 ∨ 0 ≤ valL F L s₀ := by
      rcases hs₀_0 with h0 | hge
      · exact Or.inl h0
      · right; omega
    have hs₁_ge1 : s₁ = 0 ∨
        1 ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ) := by
      rcases hs₁_0 with h0 | hge
      · exact Or.inl h0
      · right; omega
    have hz_sub_s0 : z - ι_M s₀ = ι_M s₁ * x := by
      rw [hz_eq, add_sub_cancel_left]
    have hzs0_val : z - ι_M s₀ = 0 ∨ 1 ≤ valL F M₁' (z - ι_M s₀) := by
      rw [hz_sub_s0]
      rcases eq_or_ne s₁ 0 with h0 | hne0
      · exact Or.inl (by rw [h0, map_zero, zero_mul])
      · right
        have hge1 := hs₁_ge1.resolve_left hne0
        have hι_ne : ι_M s₁ ≠ 0 := (map_ne_zero_iff ι_M ι_M.injective).mpr hne0
        rw [hval_mul_M₁' (ι_M s₁) x hι_ne hx_ne, hval_LM₁' s₁, hx_val]
        omega
    obtain ⟨r_L, hr_L_mem, hsr⟩ := hRL_surj s₀ hs₀_int
    refine ⟨ι_M r_L, Finset.mem_image_of_mem _ hr_L_mem, ?_⟩
    have hsr_M₁' : ι_M s₀ - ι_M r_L = 0 ∨ 1 ≤ valL F M₁' (ι_M s₀ - ι_M r_L) := by
      rw [← map_sub]
      rcases hsr with h0 | hge1
      · exact Or.inl (by rw [h0, map_zero])
      · right
        rw [hval_LM₁' (s₀ - r_L)]
        omega
    have hadd_eq : z - ι_M r_L = (z - ι_M s₀) + (ι_M s₀ - ι_M r_L) := by ring
    rw [hadd_eq]
    exact hval_add_M₁' 1 _ _ hzs0_val hsr_M₁'
  set θE' := recChar F rec E' χE'
  set θM₁' := recChar F rec M₁' χM₁'
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  set cE' : E'ˣ :=
    Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
      (Units.map (normLM F hE'K₁) C)⁻¹
  set cM₁' : M₁'ˣ :=
    Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
      (Units.map (normLM F hM₁'K₁) C)⁻¹
  set cνE' : Lˣ :=
    α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹
  set cνM₁' : Lˣ :=
    α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹
  set m₂ := condExp F E' θE'
  set m₁ := condExp F M₁' θM₁'
  set T₂ := condExp F L νE'
  set T₁ := condExp F L νM₁'
  set d₂ := m₂ / 2
  set d₁ := m₁ / 2
  set r := T₂ / 2
  set a := T₁ / 2
  have hm1_odd : m₁ % 2 = 1 := by omega
  have hm2_odd : m₂ % 2 = 1 := by omega
  have hd_sum : d₂ + r = d₁ + a := by omega
  obtain ⟨δνE', hδνE'⟩ := hval_surj_L (r : ℤ)
  obtain ⟨δνM₁', hδνM₁'⟩ := hval_surj_L (a : ℤ)
  have hEpsE' :=
    (((hStat E' ψE' hψE' θE' hmE'_ge2).2 cE' hcE'_val hcE'_stat).2
      R_E' δ₂ hRE'_int hRE'_sep hRE'_surj hδ₂).2 hm2_odd
  have hEpsM₁' :=
    (((hStat M₁' ψM₁' hψM₁' θM₁' hmM₁'_ge2).2 cM₁' hcM₁'_val hcM₁'_stat).2
      R_M₁' δ₁ hRM₁'_int hRM₁'_sep hRM₁'_surj hδ₁).2 hm1_odd
  have hEpsνE' :=
    (((hStat L ψ hψ νE' hbE'_ge2).2 cνE' hcνE'_val hcνE'_stat).2
      R_L δνE' hRL_int hRL_sep hRL_surj hδνE').1 hT2_even
  have hEpsνM₁' :=
    (((hStat L ψ hψ νM₁' hbM₁'_ge2).2 cνM₁' hcνM₁'_val hcνM₁'_stat).2
      R_L δνM₁' hRL_int hRL_sep hRL_surj hδνM₁').1 hT1_even
  have hSumE' :
      (∑ r_E ∈ R_E',
        if hr : 1 + (δ₂ : E') * r_E ≠ 0 then
          (θE' (Units.mk0 (1 + (δ₂ : E') * r_E) hr) : Ω F)⁻¹ *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * r_E)
        else 0) =
      (∑ a_k : k_L,
        if hr : 1 + (δ₂ : E') * ι_E (liftL a_k) ≠ 0 then
          (θE' (Units.mk0 (1 + (δ₂ : E') * ι_E (liftL a_k)) hr) : Ω F)⁻¹ *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * ι_E (liftL a_k))
        else 0) := by
    have hinjE : ∀ x ∈ R_L, ∀ y ∈ R_L, ι_E x = ι_E y → x = y :=
      fun _ _ _ _ h => ι_E.injective h
    have hinjL : ∀ x ∈ (Finset.univ : Finset k_L), ∀ y ∈ (Finset.univ : Finset k_L),
        liftL x = liftL y → x = y :=
      fun _ _ _ _ h => hliftL_inj h
    dsimp [R_E']
    rw [Finset.sum_image hinjE]
    dsimp [R_L]
    rw [Finset.sum_image hinjL]
  have hSumM₁' :
      (∑ r_M ∈ R_M₁',
        if hr : 1 + (δ₁ : M₁') * r_M ≠ 0 then
          (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * r_M) hr) : Ω F)⁻¹ *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * r_M)
        else 0) =
      (∑ a_k : k_L,
        if hr : 1 + (δ₁ : M₁') * ι_M (liftL a_k) ≠ 0 then
          (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * ι_M (liftL a_k)) hr) : Ω F)⁻¹ *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * ι_M (liftL a_k))
        else 0) := by
    have hinjM : ∀ x ∈ R_L, ∀ y ∈ R_L, ι_M x = ι_M y → x = y :=
      fun _ _ _ _ h => ι_M.injective h
    have hinjL : ∀ x ∈ (Finset.univ : Finset k_L), ∀ y ∈ (Finset.univ : Finset k_L),
        liftL x = liftL y → x = y :=
      fun _ _ _ _ h => hliftL_inj h
    dsimp [R_M₁']
    rw [Finset.sum_image hinjM]
    dsimp [R_L]
    rw [Finset.sum_image hinjL]
  have hSumEq_clean :
      (∑ a_k : k_L,
        if hr : 1 + (δ₂ : E') * ι_E (liftL a_k) ≠ 0 then
          (θE' (Units.mk0 (1 + (δ₂ : E') * ι_E (liftL a_k)) hr) : Ω F)⁻¹ *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * ι_E (liftL a_k))
        else 0) =
      (∑ a_k : k_L,
        if hr : 1 + (δ₁ : M₁') * ι_M (liftL a_k) ≠ 0 then
          (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * ι_M (liftL a_k)) hr) : Ω F)⁻¹ *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * ι_M (liftL a_k))
        else 0) := hSumEq
  have hq_pow :
      (qL F L : Ω F) ^ d₂ * (qL F L : Ω F) ^ r =
        (qL F L : Ω F) ^ d₁ * (qL F L : Ω F) ^ a := by
    rw [← pow_add, ← pow_add, hd_sum]
  rw [hEpsE', hEpsM₁', hEpsνE', hEpsνM₁', heps1_E', heps1_M₁', hqE', hqM₁',
    hRE'_card, hRM₁'_card, hRL_card, hSumE', hSumM₁']
  calc ((qL F L : Ω F) ^ condExpChar F E' ψE' * (qL F L : Ω F) ^ d₂ *
          (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E')) *
          ∑ a_k : k_L,
            if hr : 1 + (δ₂ : E') * ι_E (liftL a_k) ≠ 0 then
              (θE' (Units.mk0 (1 + (δ₂ : E') * ι_E (liftL a_k)) hr) : Ω F)⁻¹ *
                ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * ι_E (liftL a_k))
            else 0) *
        ((qL F L : Ω F) ^ condExpChar F M₁' ψM₁') *
        ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ r *
          (νE' cνE' : Ω F) * ψ (((cνE'⁻¹ : Lˣ) : L)))
    _ = (qL F L : Ω F) ^ condExpChar F E' ψE' *
          (qL F L : Ω F) ^ condExpChar F M₁' ψM₁' *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F L : Ω F) ^ d₂ * (qL F L : Ω F) ^ r) *
          ((θE' cE' : Ω F) * (νE' cνE' : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L))) *
          (∑ a_k : k_L,
            if hr : 1 + (δ₂ : E') * ι_E (liftL a_k) ≠ 0 then
              (θE' (Units.mk0 (1 + (δ₂ : E') * ι_E (liftL a_k)) hr) : Ω F)⁻¹ *
                ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * ι_E (liftL a_k))
            else 0) := by ring
    _ = (qL F L : Ω F) ^ condExpChar F E' ψE' *
          (qL F L : Ω F) ^ condExpChar F M₁' ψM₁' *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F L : Ω F) ^ d₁ * (qL F L : Ω F) ^ a) *
          ((θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L))) *
          (∑ a_k : k_L,
            if hr : 1 + (δ₁ : M₁') * ι_M (liftL a_k) ≠ 0 then
              (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * ι_M (liftL a_k)) hr) : Ω F)⁻¹ *
                ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * ι_M (liftL a_k))
            else 0) := by
        rw [hq_pow, hPrefactor, hSumEq_clean]
    _ = ((qL F L : Ω F) ^ condExpChar F M₁' ψM₁' * (qL F L : Ω F) ^ d₁ *
          (θM₁' cM₁' : Ω F) * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) *
          ∑ a_k : k_L,
            if hr : 1 + (δ₁ : M₁') * ι_M (liftL a_k) ≠ 0 then
              (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * ι_M (liftL a_k)) hr) : Ω F)⁻¹ *
                ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * ι_M (liftL a_k))
            else 0) *
        ((qL F L : Ω F) ^ condExpChar F E' ψE') *
        ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ a *
          (νM₁' cνM₁' : Ω F) * ψ (((cνM₁'⁻¹ : Lˣ) : L))) := by ring

theorem ld_ch12_wild_dyadic_even_breaks_unequal_critical_sum_eq (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hlt : condExp F L νM₁' < condExp F L νE')
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
