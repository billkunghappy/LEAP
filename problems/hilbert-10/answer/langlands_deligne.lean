    have hu_χ'_q_val0 : valL F L (((u_χ' ^ q : Lˣ) : L)) = 0 := by
      rw [hval_pow_L u_χ' q, hu_χ'_val0, mul_zero]
    have hprod_uM_val0 : valL F L (((u_χ' ^ q * M_unit : Lˣ) : L)) = 0 := by
