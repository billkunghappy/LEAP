  have hExp_M₁' :
      let Q2_1 := fun w : K₁ => 2 * u₁_fn w - (u₁_fn w) ^ 2
      ∀ w : K₁, (w = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w) →
