  have hm₀_ne0 : m₀ ≠ 0 := (Finset.mem_erase.mp hm₀_mem).1
  have hm₀_lt : m₀ < p := Finset.mem_range.mp (Finset.mem_erase.mp hm₀_mem).2
  have hm₀_pos : 0 < m₀ := Nat.pos_of_ne_zero hm₀_ne0
  have h_other_unit : ∀ j ∈ S'.erase m₀,
