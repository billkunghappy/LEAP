      (∑ j ∈ Finset.Icc 1 (k - 1), (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j)) =
        T_pow k - (-1 : K₁) ^ (k - 1) * (k : K₁) * E_Δ k := by
    intro k hk
    let F_k : ℕ → K₁ := fun j => (-1 : K₁) ^ (j - 1) * A_Δ j (k - j)
    have hterm : ∀ j ∈ Finset.Icc 1 (k - 1),
        (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j) = F_k j - F_k (j + 1) := by
      intro j hj
      obtain ⟨hj1, hjk⟩ := Finset.mem_Icc.mp hj
      have hk_sub : k - j = (k - (j + 1)) + 1 := by omega
      have hj_pow : (-1 : K₁) ^ ((j + 1) - 1) = (-1 : K₁) ^ (j - 1) * (-1 : K₁) := by
        have hj_eq : (j + 1) - 1 = (j - 1) + 1 := by omega
        rw [hj_eq, pow_succ]
      dsimp only [F_k]
      rw [mul_assoc, hET_split j (k - j), hk_sub, hBA j (k - (j + 1)), ← hk_sub, hj_pow]
      ring
    rw [Finset.sum_congr rfl hterm, h_telescope F_k (k - 1)]
    dsimp only [F_k]
    have hk1 : (k - 1) + 1 = k := Nat.sub_add_cancel hk
    rw [hk1, Nat.sub_self 1, pow_zero, one_mul, hA_one (k - 1), hk1, Nat.sub_self k, hA_zero k, mul_assoc]
  have hNewton_E' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      (-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e' k =
        traceLM F hE'K₁ ((Δ : K₁) ^ k) -
          ∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j)) := by
    intro k hk
    obtain ⟨hk1, _⟩ := Finset.mem_Icc.mp hk
    apply hι_E'_inj
    have hL : ι_E' ((-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e' k) =
        (-1 : K₁) ^ (k - 1) * (k : K₁) * E_Δ k := by
      rw [map_mul, map_mul, map_pow, map_neg, map_one, map_natCast, ← hE_eq_e hk]
    have hR : ι_E' (traceLM F hE'K₁ ((Δ : K₁) ^ k) -
        ∑ j ∈ Finset.Icc 1 (k - 1),
          (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) =
        T_pow k - ∑ j ∈ Finset.Icc 1 (k - 1), (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j) := by
      rw [map_sub, ← hT_pow_eq k, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun j hj => ?_
      obtain ⟨hj1, hjk1⟩ := Finset.mem_Icc.mp hj
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      rw [map_mul, map_mul, map_pow, map_neg, map_one, ← hE_eq_e hj_mem, ← hT_pow_eq (k - j)]
    rw [hL, hR, hNewton_K₁ hk1]
    ring

  
  have hcoprime_val_E' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      ((k : ℕ) : E') ≠ 0 ∧ valL F E' ((k : ℕ) : E') = 0 := by
    intro k hk
    obtain ⟨hk1, hkp1⟩ := Finset.mem_Icc.mp hk
    have hnot_ge1 : ¬ (((k : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((k : ℕ) : E')) := by
      intro hk_bad
      have hndvd : ¬ (p ∣ k) := Nat.not_dvd_of_pos_of_lt hk1 (by omega)
      have hcop : Nat.Coprime p k := (Nat.Prime.coprime_iff_not_dvd hPrime).mpr hndvd
      have hgcd : Nat.gcd k p = 1 := Nat.Coprime.gcd_eq_one hcop.symm
      have hbez_int : (1 : ℤ) = (k : ℤ) * Nat.gcdA k p + (p : ℤ) * Nat.gcdB k p := by
        have h := Nat.gcd_eq_gcd_ab k p
        rw [hgcd] at h
        simpa using h
      have hbez_E' : (1 : E') =
          ((k : ℕ) : E') * (Nat.gcdA k p : E') + ((p : ℕ) : E') * (Nat.gcdB k p : E') := by
        have h := congrArg (Int.cast : ℤ → E') hbez_int
        push_cast at h
        exact h
      have hterm1 : ((k : ℕ) : E') * (Nat.gcdA k p : E') = 0 ∨
          1 ≤ valL F E' (((k : ℕ) : E') * (Nat.gcdA k p : E')) := by
        have h := hmul_E' 1 0 ((k : ℕ) : E') (Nat.gcdA k p : E') hk_bad (hint_E' (Nat.gcdA k p))
        rwa [add_zero] at h
      have hterm2 : ((p : ℕ) : E') * (Nat.gcdB k p : E') = 0 ∨
          1 ≤ valL F E' (((p : ℕ) : E') * (Nat.gcdB k p : E')) := by
        have h := hmul_E' 1 0 ((p : ℕ) : E') (Nat.gcdB k p : E') hp_valE' (hint_E' (Nat.gcdB k p))
        rwa [add_zero] at h
      have hsum := hvalE'_add 1 _ _ hterm1 hterm2
      rw [← hbez_E', hvalE'_1] at hsum
      rcases hsum with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    rcases hnat_E' k with hk0 | hk_ge0
    · exact False.elim (hnot_ge1 (Or.inl hk0))
    · refine ⟨fun hk0 => hnot_ge1 (Or.inl hk0), ?_⟩
      have hk_lt1 : valL F E' ((k : ℕ) : E') < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot_ge1 (Or.inr hge1)
      omega

  have hval_neg1_pow_E' : ∀ m : ℕ,
      (-1 : E') ^ m ≠ 0 ∧ valL F E' ((-1 : E') ^ m) = 0 := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero]
      exact ⟨one_ne_zero, hvalE'_1⟩
    | succ m ih =>
      rw [pow_succ]
      have hneg1_ne0 : (-1 : E') ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hne : (-1 : E') ^ m * (-1 : E') ≠ 0 := mul_ne_zero ih.1 hneg1_ne0
      refine ⟨hne, ?_⟩
      rw [hvalE'_mul _ _ ih.1 hneg1_ne0, ih.2, hvalE'_neg1, add_zero]

  
  have he'_low : ∀ k ∈ Finset.Icc 1 (p - 2),
      e' k = 0 ∨ (bE' : ℤ) ≤ valL F E' (e' k) := by
    intro k hk
    induction' k using Nat.strong_induction_on with k ih
    obtain ⟨hk1, hkp2⟩ := Finset.mem_Icc.mp hk
    have hkp1_mem : k ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hk1, by omega⟩
    have hsum_val :
        (∑ j ∈ Finset.Icc 1 (k - 1),
          (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) = 0 ∨
        (bE' : ℤ) ≤ valL F E'
          (∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) := by
      apply @hsum_E' ℕ (Finset.Icc 1 (k - 1))
        (fun j => (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) (bE' : ℤ)
      intro j hj
      obtain ⟨hj1, hjk1⟩ := Finset.mem_Icc.mp hj
      have hj_lt : j < k := by omega
      have hj_mem : j ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      have hkj_mem : k - j ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hej := ih j hj_lt hj_mem
      have htr_kj := hΔ_tr_low_bE' (k - j) hkj_mem
      have hneg_j : (-1 : E') ^ (j - 1) = 0 ∨ 0 ≤ valL F E' ((-1 : E') ^ (j - 1)) :=
        Or.inr (by rw [(hval_neg1_pow_E' (j - 1)).2])
      have h1 := hmul_E' 0 (bE' : ℤ) ((-1 : E') ^ (j - 1)) (e' j) hneg_j hej
      have h2 := hmul_E' (0 + (bE' : ℤ)) (bE' : ℤ)
        ((-1 : E') ^ (j - 1) * e' j) (traceLM F hE'K₁ ((Δ : K₁) ^ (k - j)))
        h1 htr_kj
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right
        linarith
    have hneg_sum_val :
        - (∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) = 0 ∨
        (bE' : ℤ) ≤ valL F E'
          (- (∑ j ∈ Finset.Icc 1 (k - 1),
              (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j)))) := by
      rcases hsum_val with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hvalE'_neg]; exact hge
    have hrhs_val :
        (-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e' k = 0 ∨
          (bE' : ℤ) ≤ valL F E' ((-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e' k) := by
      rw [hNewton_E' hkp1_mem, sub_eq_add_neg]
      exact hvalE'_add (bE' : ℤ) _ _ (hΔ_tr_low_bE' k hk) hneg_sum_val
    obtain ⟨hneg_ne0, hneg_val0⟩ := hval_neg1_pow_E' (k - 1)
    obtain ⟨hk_ne0, hk_val0⟩ := hcoprime_val_E' hkp1_mem
    have hcoeff_ne0 : (-1 : E') ^ (k - 1) * ((k : ℕ) : E') ≠ 0 := mul_ne_zero hneg_ne0 hk_ne0
    have hcoeff_val0 : valL F E' ((-1 : E') ^ (k - 1) * ((k : ℕ) : E')) = 0 := by
      rw [hvalE'_mul _ _ hneg_ne0 hk_ne0, hneg_val0, hk_val0, add_zero]
    by_cases hek0 : e' k = 0
    · exact Or.inl hek0
    · right
      have hprod_ne0 : (-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e' k ≠ 0 :=
        mul_ne_zero hcoeff_ne0 hek0
      have hge := hrhs_val.resolve_left hprod_ne0
      rw [hvalE'_mul _ _ hcoeff_ne0 hek0, hcoeff_val0, zero_add] at hge
      exact hge
  have h1_mem_low : 1 ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
  have he'_1 : e' 1 = 0 ∨ (bE' : ℤ) ≤ valL F E' (e' 1) := he'_low 1 h1_mem_low
  have he'_top : e' (p - 1) = 0 ∨ 0 ≤ valL F E' (e' (p - 1)) := by
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩
    have htr_diff_bE' :
        traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
          (bE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) :=
      hΔ_tr_top_bE'
    have htr_diff_0 :
        traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
          0 ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
      rcases htr_diff_bE' with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (le_trans hbE'_nonneg hge)
    have htr_top_0 :
        traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) = 0 ∨
          0 ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1))) := by
      have h := hvalE'_add 0
        (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E'))
        ((p - 1 : ℕ) : E')
        htr_diff_0 (hnat_E' (p - 1))
      rwa [sub_add_cancel] at h
    have hsum_top_0 :
        (∑ j ∈ Finset.Icc 1 (p - 1 - 1),
          (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j))) = 0 ∨
        0 ≤ valL F E'
          (∑ j ∈ Finset.Icc 1 (p - 1 - 1),
            (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j))) := by
      apply @hsum_E' ℕ (Finset.Icc 1 (p - 1 - 1))
        (fun j => (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j))) 0
      intro j hj
      obtain ⟨hj1, hjp2⟩ := Finset.mem_Icc.mp hj
      have hj_mem : j ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      have hkj_mem : p - 1 - j ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hej := he'_low j hj_mem
      have htr_kj : traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j)) = 0 ∨
          (bE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j))) :=
        hΔ_tr_low_bE' (p - 1 - j) hkj_mem
      have hneg_j : (-1 : E') ^ (j - 1) = 0 ∨ 0 ≤ valL F E' ((-1 : E') ^ (j - 1)) :=
        Or.inr (by rw [(hval_neg1_pow_E' (j - 1)).2])
      have h1 := hmul_E' 0 (bE' : ℤ) ((-1 : E') ^ (j - 1)) (e' j) hneg_j hej
      have h2 := hmul_E' (0 + (bE' : ℤ)) (bE' : ℤ)
        ((-1 : E') ^ (j - 1) * e' j) (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j)))
        h1 htr_kj
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right; linarith
    have hneg_sum_top_0 :
        - (∑ j ∈ Finset.Icc 1 (p - 1 - 1),
            (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j))) = 0 ∨
        0 ≤ valL F E'
          (- (∑ j ∈ Finset.Icc 1 (p - 1 - 1),
              (-1 : E') ^ (j - 1) * e' j * traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1 - j)))) := by
      rcases hsum_top_0 with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hvalE'_neg]; exact hge
    have hrhs_top :
        (-1 : E') ^ (p - 1 - 1) * ((p - 1 : ℕ) : E') * e' (p - 1) = 0 ∨
          0 ≤ valL F E' ((-1 : E') ^ (p - 1 - 1) * ((p - 1 : ℕ) : E') * e' (p - 1)) := by
      rw [hNewton_E' hp1_mem, sub_eq_add_neg]
      exact hvalE'_add 0 _ _ htr_top_0 hneg_sum_top_0
    obtain ⟨hneg_ne0, hneg_val0⟩ := hval_neg1_pow_E' (p - 1 - 1)
    obtain ⟨hp1_ne0, hp1_val0⟩ := hcoprime_val_E' hp1_mem
    have hcoeff_ne0 : (-1 : E') ^ (p - 1 - 1) * ((p - 1 : ℕ) : E') ≠ 0 :=
      mul_ne_zero hneg_ne0 hp1_ne0
    have hcoeff_val0 : valL F E' ((-1 : E') ^ (p - 1 - 1) * ((p - 1 : ℕ) : E')) = 0 := by
      rw [hvalE'_mul _ _ hneg_ne0 hp1_ne0, hneg_val0, hp1_val0, add_zero]
    by_cases hep1_0 : e' (p - 1) = 0
    · exact Or.inl hep1_0
    · right
      have hprod_ne0 : (-1 : E') ^ (p - 1 - 1) * ((p - 1 : ℕ) : E') * e' (p - 1) ≠ 0 :=
        mul_ne_zero hcoeff_ne0 hep1_0
      have hge := hrhs_top.resolve_left hprod_ne0
      rw [hvalE'_mul _ _ hcoeff_ne0 hep1_0, hcoeff_val0, zero_add] at hge
      exact hge
  have he'_nonneg : ∀ k : ℕ, k ≤ p - 1 → e' k = 0 ∨ 0 ≤ valL F E' (e' k) := by
    intro k hk
    by_cases hk0 : k = 0
    · right; rw [hk0, he'_0, hvalE'_1]
    · by_cases hkp : k = p - 1
      · rw [hkp]; exact he'_top
      · have hk_mem : k ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
        rcases he'_low k hk_mem with h0 | hle
        · left; exact h0
        · right; linarith

  
  have he'_mixed : ∀ f : G_E' → Fin (p + 1),
      (∑ σ : G_E', (f σ : ℕ)) = p →
      (∀ σ : G_E', (f σ : ℕ) ≤ p - 1) →
      ¬ (∀ σ : G_E', f σ = f 1) →
      (∏ σ : G_E', act_E' σ (e' (f σ : ℕ))) = 0 ∨
        (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤
          valL F E' (∏ σ : G_E', act_E' σ (e' (f σ : ℕ))) := by
    intro f hsum hle _hnot_const
    have hex_low : ∃ σ₀ : G_E', (f σ₀ : ℕ) ∈ Finset.Icc 1 (p - 2) := by
      by_contra h_none
      push_neg at h_none
      have hdvd_each : ∀ σ ∈ (Finset.univ : Finset G_E'), (p - 1) ∣ (f σ : ℕ) := by
        intro σ _
        have h_not_mem : ¬ (1 ≤ (f σ : ℕ) ∧ (f σ : ℕ) ≤ p - 2) := by
          intro hmem
          exact h_none σ (Finset.mem_Icc.mpr hmem)
        have h_le : (f σ : ℕ) ≤ p - 1 := hle σ
        have h_zero_or_top : (f σ : ℕ) = 0 ∨ (f σ : ℕ) = p - 1 := by omega
        rcases h_zero_or_top with h0 | htop
        · rw [h0]; exact dvd_zero (p - 1)
        · rw [htop]
      have hdvd_sum : (p - 1) ∣ ∑ σ : G_E', (f σ : ℕ) := Finset.dvd_sum hdvd_each
      rw [hsum] at hdvd_sum
      obtain ⟨k, hk⟩ := hdvd_sum
      rcases k with _ | _ | k
      · simp at hk; omega
      · simp at hk; omega
      · have hmul_ge : (p - 1) * 2 ≤ (p - 1) * (k + 2) :=
          Nat.mul_le_mul_left (p - 1) (by omega)
        rw [← hk] at hmul_ge
        omega
    obtain ⟨σ₀, hσ₀⟩ := hex_low
    rw [← Finset.mul_prod_erase Finset.univ (fun σ => act_E' σ (e' (f σ : ℕ))) (Finset.mem_univ σ₀)]
    have hfirst : act_E' σ₀ (e' (f σ₀ : ℕ)) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (act_E' σ₀ (e' (f σ₀ : ℕ))) :=
      hactE'_bound σ₀ (e' (f σ₀ : ℕ)) (bE' : ℤ) (he'_low (f σ₀ : ℕ) hσ₀)
    have hrest : (∏ σ ∈ Finset.univ.erase σ₀, act_E' σ (e' (f σ : ℕ))) = 0 ∨
        0 ≤ valL F E' (∏ σ ∈ Finset.univ.erase σ₀, act_E' σ (e' (f σ : ℕ))) := by
      apply hprod_nonneg_E'
      intro σ _
      exact hactE'_bound σ (e' (f σ : ℕ)) 0 (he'_nonneg (f σ : ℕ) (hle σ))
    have hcomb := hmul_E' (bE' : ℤ) 0 _ _ hfirst hrest
    have h_eq : (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) = (bE' : ℤ) + 0 := by
      rw [hp_sub1_z]; ring
    rw [h_eq]
    exact hcomb

  exact ⟨e', he'_0, he'_p, he'_poly, he'_1, he'_mixed⟩

theorem ld_ch12_wild_odd_tot_ram_m1_e1_upgrade_and_mixed_tuple_bound (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
