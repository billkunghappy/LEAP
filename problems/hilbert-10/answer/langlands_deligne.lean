        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfL_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : L) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F L x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F L y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    exact ⟨hval1, hval_neg, hval_mul, hval_inv, hval_add⟩
  obtain ⟨hval1_M, hval_neg_M, hval_mul_M, hval_inv_M, hval_add_M⟩ := hval_props M
  obtain ⟨hval1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_add_K⟩ := hval_props K

  have hval_pow_M : ∀ (z : M) (n : ℕ), z ≠ 0 → valL F M (z ^ n) = (n : ℤ) * valL F M z := by
    intro z n hz
    induction n with
    | zero => simp [hval1_M]
    | succ n ih =>
      rw [pow_succ, hval_mul_M (z ^ n) z (pow_ne_zero n hz) hz, ih]
      push_cast
      ring

  have hval_pow_K : ∀ (w : K) (n : ℕ), w ≠ 0 → valL F K (w ^ n) = (n : ℤ) * valL F K w := by
    intro w n hw
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (w ^ n) w (pow_ne_zero n hw) hw, ih]
      push_cast
      ring

  have hval_finset_sum_K : ∀ {ι : Type} [DecidableEq ι] (S : Finset ι) (f : ι → K) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ S, f i)) := by
    intro ι _ S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K k (f a) (∑ i ∈ s, f i) ha_val hs_val

  have hval_strict_K : ∀ (y₁ y₂ : K),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F K y₁ + 1 ≤ valL F K y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F K (y₁ + y₂) = valL F K y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F K y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F K y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F K (y₁ + y₂) :=
      hval_add_K v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F K (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F K (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_K]
          exact hge
      have hy₁_gt := hval_add_K (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  let K' : IntermediateField M (AlgebraicClosure F) := IntermediateField.extendScalars hMK
  let eF : K ≃ₐ[F] K' :=
    { toExtendScalars F hMK with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hMK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K' := Module.Finite.equiv eF.toLinearEquiv
  haveI : IsScalarTower F M K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M K' := Module.Finite.of_restrictScalars_finite F M K'

  let t_term (c : Fin q → M) (i : Fin q) : K :=
    IntermediateField.inclusion hMK (c i) * ((ϖ_K : K) ^ (i : ℕ))
  let v_term (c : Fin q → M) (i : Fin q) : ℤ :=
    (q : ℤ) * valL F M (c i) + (i.1 : ℤ)

  have ht_term_zero : ∀ (c : Fin q → M) (i : Fin q), c i = 0 → t_term c i = 0 := by
    intro c i hci
    dsimp [t_term]
    rw [hci, map_zero, zero_mul]

  have ht_term_nz : ∀ (c : Fin q → M) (i : Fin q),
      c i ≠ 0 → t_term c i ≠ 0 ∧ valL F K (t_term c i) = v_term c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hMK (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hMK).toRingHom).ne hci
    have hpow_ne : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term, v_term]
    rw [hval_mul_K _ _ hinc_ne hpow_ne, hValAlg (c i),
      hval_pow_K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_one]

  have hv_term_inj : ∀ (c : Fin q → M) (i j : Fin q),
      v_term c i = v_term c j → i = j := by
    intro c i j hij
    have hmod : ∀ k : Fin q, v_term c k % (q : ℤ) = (k.1 : ℤ) := by
      intro k
      dsimp [v_term]
      have hcomm : (q : ℤ) * valL F M (c k) + (k.1 : ℤ) =
          (k.1 : ℤ) + (q : ℤ) * valL F M (c k) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_ge : ∀ (c : Fin q → M) (S : Finset (Fin q)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term c i) →
        ((∑ i ∈ S, t_term c i) = 0 ∨ m ≤ valL F K (∑ i ∈ S, t_term c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term c a = 0 ∨ m ≤ valL F K (t_term c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_zero c a hca)
        · right
          rw [(ht_term_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K m (t_term c a) (∑ i ∈ s, t_term c i) ha_t hs_t

  have hsum_min_nz : ∀ (c : Fin q → M) (i : Fin q),
      c i ≠ 0 →
        ∃ i₀ : Fin q, c i₀ ≠ 0 ∧ v_term c i₀ ≤ v_term c i ∧
          (∑ j : Fin q, t_term c j) ≠ 0 ∧
          valL F K (∑ j : Fin q, t_term c j) = v_term c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin q) := (Finset.univ : Finset (Fin q)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term c i₀ ≤ v_term c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin q)).erase i₀,
        c j = 0 ∨ v_term c i₀ + 1 ≤ v_term c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term c i₀ ≤ v_term c j := hi₀_min j hj_mem
        have hne_v : v_term c i₀ ≠ v_term c j := fun heq => hj_ne (hv_term_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_ge c ((Finset.univ : Finset (Fin q)).erase i₀)
      (v_term c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_K (t_term c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin q)).erase i₀, t_term c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hval_sum_iff : ∀ (c : Fin q → M) (m : ℤ),
      ((∑ i : Fin q, t_term c i) = 0 ∨ m ≤ valL F K (∑ i : Fin q, t_term c i)) ↔
        ∀ i : Fin q, c i = 0 ∨ m ≤ v_term c i := by
    intro c m
    refine ⟨?_, fun hall => hval_sum_ge c Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hci : c i = 0
    · exact Or.inl hci
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_nz c i hci
      have hm_le : m ≤ valL F K (∑ j : Fin q, t_term c j) := hsum.resolve_left hsum_ne
      omega

  have hlin_zero : ∀ (c : Fin q → M),
      (∑ i : Fin q, t_term c i) = 0 → ∀ i : Fin q, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_nz c i hci
    exact hsum_ne hsum0

  let b_vec : Fin q → K' := fun i => (toExtendScalars F hMK (ϖ_K : K)) ^ (i : ℕ)
  have hli : LinearIndependent M b_vec := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hMK (∑ i : Fin q, t_term c i) =
        ∑ i : Fin q, c i • b_vec i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term, b_vec]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin q, t_term c i) = 0 := by
      apply eF.injective
      change toExtendScalars F hMK (∑ i : Fin q, t_term c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero c hsum0

  haveI : Nonempty (Fin q) := ⟨⟨0, hq_pos⟩⟩
  have hcard : Fintype.card (Fin q) = Module.finrank M K' := Fintype.card_fin q
  let B : Module.Basis (Fin q) M K' := basisOfLinearIndependentOfCardEqFinrank hli hcard

  have hBasis : ∀ w : K, ∃ c : Fin q → M,
      w = ∑ i : Fin q, IntermediateField.inclusion hMK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (w = 0 ∨ m ≤ valL F K w) ↔
          ∀ i : Fin q, c i = 0 ∨ m ≤ (q : ℤ) * valL F M (c i) + (i : ℤ) := by
    intro w
    let c : Fin q → M := fun i => B.repr (toExtendScalars F hMK w) i
    have hw_eq : w = ∑ i : Fin q, t_term c i := by
      apply eF.injective
      change toExtendScalars F hMK w = toExtendScalars F hMK (∑ i : Fin q, t_term c i)
      have hrepr := (B.sum_repr (toExtendScalars F hMK w)).symm
      rw [hrepr, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [B, c, t_term, b_vec]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli hcard, map_mul, map_pow]
      rfl
    refine ⟨c, hw_eq, fun m => ?_⟩
    rw [hw_eq]
    exact hval_sum_iff c m

  have hResLift : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M, (z = 0 ∨ 0 ≤ valL F M z) ∧
        (w - IntermediateField.inclusion hMK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hMK z)) := by
    intro w hw
    obtain ⟨c, hw_eq, hval_iff⟩ := hBasis w
    let t_term_c (i : Fin q) : K := IntermediateField.inclusion hMK (c i) * ((ϖ_K : K) ^ (i : ℕ))
    let i_zero : Fin q := ⟨0, hq_pos⟩
    let z : M := c i_zero
    have hc_all := (hval_iff 0).mp hw
    have hz : z = 0 ∨ 0 ≤ valL F M z := by
      rcases hc_all i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (q : ℤ) * valL F M z + (0 : ℤ) at hge
        nlinarith
    have ht_zero : t_term_c i_zero = IntermediateField.inclusion hMK z := by
      dsimp [t_term_c, i_zero, z]
      rw [pow_zero, mul_one]
    have hw_sub : w - IntermediateField.inclusion hMK z =
        ∑ i ∈ (Finset.univ : Finset (Fin q)).erase i_zero, t_term_c i := by
      have hsum := (Finset.add_sum_erase (Finset.univ : Finset (Fin q)) t_term_c
        (Finset.mem_univ i_zero)).symm
      rw [ht_zero] at hsum
      rw [hw_eq]
      change (∑ i : Fin q, t_term_c i) - IntermediateField.inclusion hMK z = _
      rw [hsum, add_sub_cancel_left]
    refine ⟨z, hz, ?_⟩
    rw [hw_sub]
    apply hval_finset_sum_K ((Finset.univ : Finset (Fin q)).erase i_zero) t_term_c 1
    intro i hi
    have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
    have hi_ge1 : (1 : ℤ) ≤ (i.1 : ℤ) := by
      have hne0 : i.1 ≠ 0 := fun h0 => hi_ne (Fin.ext h0)
      omega
    have hi_lt : (i.1 : ℤ) < (q : ℤ) := Nat.cast_lt.mpr i.2
    by_cases hci0 : c i = 0
    · left
      dsimp [t_term_c]
      rw [hci0, map_zero, zero_mul]
    · right
      have hci_ge : 0 ≤ (q : ℤ) * valL F M (c i) + (i.1 : ℤ) := (hc_all i).resolve_left hci0
      have hci_val_ge0 : 0 ≤ valL F M (c i) := by nlinarith
      have hinc_ne : IntermediateField.inclusion hMK (c i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hMK).toRingHom).ne hci0
      have hpow_ne : ((ϖ_K : K) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K)
      dsimp [t_term_c]
      rw [hval_mul_K _ _ hinc_ne hpow_ne, hValAlg (c i),
        hval_pow_K (ϖ_K : K) (i : ℕ) (Units.ne_zero ϖ_K), hϖ_K, mul_one]
      nlinarith

  have hGalMK' : IsGalois M ↥K' := by
    have hSepMK' : Algebra.IsSeparable M K' := hGal.2.2.2 hMK
    haveI : Algebra.IsSeparable M K' := hSepMK'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal M (AlgebraicClosure F) := Normal.tower_top_of_normal F M (AlgebraicClosure F)
    have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[M] AlgebraicClosure F),
        (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : M.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M).symm σ
      let τ_F : M.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hMK).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hMK).mp hx)
    exact helper_isGalois M (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois M ↥K' := hGalMK'
  let G : Type u := (K' ≃ₐ[M] K')

  have hcard_G : Fintype.card G = q :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank M K')
  let fromExtendScalars : K' →+* K :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hMK).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → K → K := fun σ y => fromExtendScalars (σ (toExtendScalars F hMK y))
  let φ : G → (K →+* K) := fun σ =>
    fromExtendScalars.comp (σ.toRingHom.comp (toExtendScalars F hMK))
  have hφ_apply : ∀ (σ : G) (y : K), φ σ y = act σ y := fun _ _ => rfl
  have hact_one : ∀ y : K, act 1 y = y := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun y₁ y₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (z : M),
      act σ (IntermediateField.inclusion hMK z) = IntermediateField.inclusion hMK z := by
    intro σ z
    change fromExtendScalars (σ (algebraMap M K' z)) = IntermediateField.inclusion hMK z
    rw [σ.commutes z]
    rfl
  have hact_faithful : ∀ σ : G, (∀ y : K, act σ y = y) → σ = 1 := by
    intro σ h
    apply AlgEquiv.ext
    intro z
    exact congrArg (toExtendScalars F hMK) (h (fromExtendScalars z))

  have hact_trace : ∀ y : K,
      IntermediateField.inclusion hMK (traceLM F hMK y) = ∑ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := M) (L := K') (toExtendScalars F hMK y))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hMK y)) Finset.univ)
  have hact_norm : ∀ y : K,
      IntermediateField.inclusion hMK (normLM F hMK y) = ∏ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms M (toExtendScalars F hMK y))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hMK y)) Finset.univ)
  have hinj : Function.Injective (IntermediateField.inclusion hMK) :=
    (IntermediateField.inclusion hMK).injective
  have hnorm_act : ∀ (σ : G) (y : K), normLM F hMK (act σ y) = normLM F hMK y := by
    intro σ y
    apply hinj
    rw [hact_norm (act σ y), hact_norm y]
    have hmul : (∏ τ : G, act τ (act σ y)) = ∏ τ : G, act (τ * σ) y := by
      refine Finset.prod_congr rfl fun τ _ => ?_
      rw [hact_mul]
    rw [hmul]
    exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => act τ y)
  have hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y := by
    intro σ y
    rw [← hValNorm (act σ y), hnorm_act σ y, hValNorm y]

  have hjump_G : ∀ τ : G, τ ≠ 1 →
      (ϖ_K : K) - act τ (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act τ (ϖ_K : K)) = (t + 1 : ℤ) := by
    intro τ hτ_ne1
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal M (AlgebraicClosure F) := Normal.tower_top_of_normal F M (AlgebraicClosure F)
    haveI : Normal M ↥K' := IsGalois.to_normal
    obtain ⟨τ_tilde, hτ_tilde⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) τ
    let σ_F : M.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M).symm τ_tilde
    have hσ_apply : ∀ y : K, (σ_F.1 : AbsGal F) (y : AlgebraicClosure F) =
        (act τ y : AlgebraicClosure F) := by
      intro y
      let y' : K' := toExtendScalars F hMK y
      have h1 : (σ_F.1 : AbsGal F) (y : AlgebraicClosure F) = τ_tilde (y' : AlgebraicClosure F) := rfl
      have h2 : (act τ y : AlgebraicClosure F) =
          (((AlgEquiv.restrictNormalHom ↥K' τ_tilde) y' : ↥K') : AlgebraicClosure F) := by
        rw [hτ_tilde]
        rfl
      rw [h1, h2, AlgEquiv.restrictNormalHom_apply]
    have hnot_K : σ_F.1 ∉ K.fixingSubgroup := by
      intro hmemK
      rw [IntermediateField.mem_fixingSubgroup_iff] at hmemK
      apply hτ_ne1
      apply hact_faithful τ
      intro y
      apply Subtype.ext
      rw [← hσ_apply y]
      exact hmemK y.1 y.2
    have hσw : (σ_F.1 : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K := by
      rw [hσ_apply (ϖ_K : K)]
      exact (act τ (ϖ_K : K)).2
    have hσ_eq : (⟨(σ_F.1 : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) =
        act τ (ϖ_K : K) := by
      apply Subtype.ext
      exact hσ_apply (ϖ_K : K)
    have hj := hJump σ_F.1 σ_F.2 hnot_K hσw
    rwa [hσ_eq] at hj

  set π : K := (ϖ_K : K)
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_K
  have hval_pi_pow : ∀ k : ℕ, π ^ k ≠ 0 ∧ valL F K (π ^ k) = (k : ℤ) := by
    intro k
    refine ⟨pow_ne_zero k hπ_ne0, ?_⟩
    rw [hval_pow_K π k hπ_ne0, hϖ_K, mul_one]

  have htr_smul : ∀ (a : M) (z : K),
      traceLM F hMK (IntermediateField.inclusion hMK a * z) = a * traceLM F hMK z := by
    intro a z
    apply hinj
    change IntermediateField.inclusion hMK (traceLM F hMK (IntermediateField.inclusion hMK a * z)) =
      IntermediateField.inclusion hMK (a * traceLM F hMK z)
    rw [map_mul (IntermediateField.inclusion hMK), hact_trace, hact_trace, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun σ _ => ?_)
    rw [((hact_ring σ).2.2 _ _).2.1, hact_incl σ a]

  set U_G : Finset G := Finset.univ
  set S₁ : Finset G := U_G.erase 1
  set δ : K := ∏ τ ∈ S₁, (π - act τ π)
  have hprod_S : ∀ (S : Finset G), S ⊆ S₁ →
      (∏ τ ∈ S, (π - act τ π)) ≠ 0 ∧
      valL F K (∏ τ ∈ S, (π - act τ π)) = (S.card : ℤ) * (t + 1 : ℤ) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp [hval1_K]
    | @insert a s ha ih =>
      intro hsub
      have ha_S₁ : a ∈ S₁ := hsub (Finset.mem_insert_self a s)
      have ha_ne1 : a ≠ 1 := (Finset.mem_erase.mp ha_S₁).1
      have hs_sub : s ⊆ S₁ := fun x hx => hsub (Finset.mem_insert_of_mem hx)
      obtain ⟨hs_ne0, hs_val⟩ := ih hs_sub
      obtain ⟨ha_ne0, ha_val⟩ := hjump_G a ha_ne1
      rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha]
      refine ⟨mul_ne_zero ha_ne0 hs_ne0, ?_⟩
      rw [hval_mul_K _ _ ha_ne0 hs_ne0, ha_val, hs_val]
      push_cast
      ring

  have hS₁_card : S₁.card = q - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ (1 : G)), Finset.card_univ, hcard_G]
  have hδ_ne0 : δ ≠ 0 := (hprod_S S₁ (Finset.Subset.refl S₁)).1
  have hδ_val : valL F K δ = ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
    have h := (hprod_S S₁ (Finset.Subset.refl S₁)).2
    rwa [hS₁_card] at h
  have hδ_inv_ne0 : δ⁻¹ ≠ 0 := inv_ne_zero hδ_ne0
  have hδ_inv_val : valL F K δ⁻¹ = - (((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) := by
    set u_δ : Kˣ := Units.mk0 δ hδ_ne0
    have h1 : δ⁻¹ = ((u_δ⁻¹ : Kˣ) : K) := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    have h2 : (u_δ : K) = δ := Units.val_mk0 hδ_ne0
    rw [h1, hval_inv_K u_δ, h2, hδ_val]

  let v : G → K := fun σ => act σ π
  have hInjOn : Set.InjOn v ↑U_G := by
    intro σ _ τ _ h_eq
    change act σ π = act τ π at h_eq
    by_contra hne
    have h_inv_ne1 : σ⁻¹ * τ ≠ 1 := by
      intro h1
      exact hne (inv_mul_eq_one.mp h1)
    have h_fix : act (σ⁻¹ * τ) π = π := by
      rw [hact_mul σ⁻¹ τ π, ← h_eq, ← hact_mul σ⁻¹ σ π, inv_mul_cancel, hact_one]
    exact (hjump_G (σ⁻¹ * τ) h_inv_ne1).1 (sub_eq_zero.mpr h_fix.symm)

  have hact_δ : ∀ σ : G, act σ δ = ∏ γ ∈ U_G.erase σ, (v σ - v γ) := by
    intro σ
    have hmap : act σ δ = ∏ ρ ∈ S₁, (v σ - v (σ * ρ)) := by
      change φ σ (∏ ρ ∈ S₁, (π - act ρ π)) = _
      rw [map_prod (φ σ)]
      refine Finset.prod_congr rfl (fun ρ _ => ?_)
      rw [map_sub (φ σ), hφ_apply, hφ_apply, ← hact_mul σ ρ π]
    rw [hmap]
    refine Finset.prod_bij (fun (ρ : G) _ => σ * ρ) ?_ ?_ ?_ ?_
    · intro ρ hρ
      have hρ_ne1 : ρ ≠ 1 := (Finset.mem_erase.mp hρ).1
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h_eq
      have h1 : σ⁻¹ * (σ * ρ) = σ⁻¹ * σ := congrArg (σ⁻¹ * ·) h_eq
      rw [inv_mul_cancel_left, inv_mul_cancel] at h1
      exact hρ_ne1 h1
    · intro ρ₁ _ ρ₂ _ h_eq
      exact mul_left_cancel h_eq
    · intro γ hγ
      have hγ_ne : γ ≠ σ := (Finset.mem_erase.mp hγ).1
      refine ⟨σ⁻¹ * γ, ?_, mul_inv_cancel_left σ γ⟩
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h1
      exact hγ_ne (inv_mul_eq_one.mp h1).symm
    · intro ρ _
      rfl

  have hact_term : ∀ (σ : G) (k : ℕ),
      act σ (π ^ k * δ⁻¹) = (v σ) ^ k / (∏ γ ∈ U_G.erase σ, (v σ - v γ)) := by
    intro σ k
    change φ σ (π ^ k * δ⁻¹) = _
    rw [map_mul (φ σ), map_pow (φ σ), map_inv₀ (φ σ), hφ_apply, hφ_apply, hact_δ σ,
      div_eq_mul_inv]

  let Q : G → Polynomial K := fun σ =>
    ∏ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ))
  have hQ_coeff : ∀ σ : G, (Q σ).coeff (q - 1) = 1 := by
    intro σ
    have hmonic_fac : ∀ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ)).Monic :=
      fun γ _ => Polynomial.monic_X_sub_C (v γ)
    have hmonic : (Q σ).Monic :=
      Polynomial.monic_prod_of_monic (U_G.erase σ) _ hmonic_fac
    have hdeg : (Q σ).natDegree = q - 1 := by
      dsimp only [Q]
      rw [Polynomial.natDegree_prod_of_monic (U_G.erase σ) _ hmonic_fac]
      have hsum1 : (∑ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ)).natDegree) =
          ∑ _γ ∈ U_G.erase σ, 1 := by
        refine Finset.sum_congr rfl (fun γ _ => Polynomial.natDegree_X_sub_C (v γ))
      rw [hsum1, Finset.sum_const, smul_eq_mul, mul_one,
        Finset.card_erase_of_mem (Finset.mem_univ σ), Finset.card_univ, hcard_G]
    rw [← hdeg]
    exact Polynomial.Monic.coeff_natDegree hmonic

  have hEuler : ∀ k < q,
      traceLM F hMK (π ^ k * δ⁻¹) = if q - 1 = k then 1 else 0 := by
    intro k hk
    have hdeg : (Polynomial.X ^ k : Polynomial K).degree < (U_G.card : WithBot ℕ) := by
      rw [Polynomial.degree_X_pow k, Finset.card_univ, hcard_G]
      exact WithBot.coe_lt_coe.mpr hk
    have hLag := @Lagrange.eq_interpolate K _ G _ U_G v (Polynomial.X ^ k) hInjOn hdeg
    rw [Lagrange.interpolate_eq_sum] at hLag
    have hcoeff := congrArg (fun P : Polynomial K => P.coeff (q - 1)) hLag
    dsimp only at hcoeff
    rw [Polynomial.coeff_X_pow k (q - 1), Polynomial.finset_sum_coeff] at hcoeff
    have hrhs : (∑ σ ∈ U_G,
        (Polynomial.C (Polynomial.eval (v σ) (Polynomial.X ^ k) /
          ∏ γ ∈ U_G.erase σ, (v σ - v γ)) * Q σ).coeff (q - 1)) =
        IntermediateField.inclusion hMK (traceLM F hMK (π ^ k * δ⁻¹)) := by
      rw [hact_trace (π ^ k * δ⁻¹)]
      refine Finset.sum_congr rfl (fun σ _ => ?_)
      rw [Polynomial.coeff_C_mul, hQ_coeff σ, mul_one, Polynomial.eval_X_pow, hact_term σ k]
    rw [hrhs] at hcoeff
    apply hinj
    change IntermediateField.inclusion hMK (traceLM F hMK (π ^ k * δ⁻¹)) =
      IntermediateField.inclusion hMK (if q - 1 = k then 1 else 0)
    rw [← hcoeff]
    split_ifs <;> simp

  let i_max : Fin q := ⟨q - 1, Nat.sub_lt hq_pos zero_lt_one⟩
  have htr_from_basis : ∀ (w : K) (c : Fin q → M),
      w * δ = ∑ i : Fin q, IntermediateField.inclusion hMK (c i) * (π ^ (i : ℕ)) →
      traceLM F hMK w = c i_max := by
    intro w c hwδ_eq
    have hw_eq : w = ∑ i : Fin q,
        IntermediateField.inclusion hMK (c i) * (π ^ (i : ℕ) * δ⁻¹) := by
      calc w = (w * δ) * δ⁻¹ := (mul_inv_cancel_right₀ hδ_ne0 w).symm
        _ = (∑ i : Fin q, IntermediateField.inclusion hMK (c i) * (π ^ (i : ℕ))) * δ⁻¹ := by
            rw [hwδ_eq]
        _ = ∑ i : Fin q, IntermediateField.inclusion hMK (c i) * (π ^ (i : ℕ) * δ⁻¹) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun i _ => mul_assoc _ _ _)
    rw [hw_eq, map_sum (traceLM F hMK)]
    have hsum_c : (∑ i : Fin q,
        traceLM F hMK (IntermediateField.inclusion hMK (c i) * (π ^ (i : ℕ) * δ⁻¹))) =
        ∑ i : Fin q, c i * (if q - 1 = (i : ℕ) then 1 else 0) := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [htr_smul (c i), hEuler i.1 i.2]
    rw [hsum_c, Finset.sum_eq_single i_max]
    · change c i_max * (if q - 1 = q - 1 then 1 else 0) = c i_max
      simp
    · intro i _ hi_ne
      have hval_ne : q - 1 ≠ (i : ℕ) := by
        intro h_eq
        exact hi_ne (Fin.ext h_eq.symm)
      rw [if_neg hval_ne, mul_zero]
    · intro hnot
      exact absurd (Finset.mem_univ i_max) hnot

  have htr_bound : ∀ (m : ℤ) (w : K),
      (w = 0 ∨ (q : ℤ) * m - ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hMK w = 0 ∨ m ≤ valL F M (traceLM F hMK w)) := by
    intro m w hw
    obtain ⟨c, hwδ_eq, hwδ_val⟩ := hBasis (w * δ)
    have htr_w : traceLM F hMK w = c i_max := htr_from_basis w c hwδ_eq
    have hwδ_bound : w * δ = 0 ∨ (q : ℤ) * m ≤ valL F K (w * δ) := by
      rcases hw with rfl | hw_ge
      · left; exact zero_mul δ
      · by_cases hw0 : w = 0
        · left; rw [hw0, zero_mul]
        · right
          rw [hval_mul_K w δ hw0 hδ_ne0, hδ_val]
          linarith
    have hc_imax := (hwδ_val ((q : ℤ) * m)).mp hwδ_bound i_max
    rw [htr_w]
    rcases hc_imax with hc0 | hc_ge
    · exact Or.inl hc0
    · right
      change (q : ℤ) * m ≤ (q : ℤ) * valL F M (c i_max) + ((q - 1 : ℕ) : ℤ) at hc_ge
      by_contra hlt
      have h1 : 1 ≤ m - valL F M (c i_max) := by omega
      have h2 : (q : ℤ) * 1 ≤ (q : ℤ) * (m - valL F M (c i_max)) :=
        mul_le_mul_of_nonneg_left h1 (le_of_lt hq_int_pos)
      have h3 : ((q - 1 : ℕ) : ℤ) < (q : ℤ) := by omega
      linarith

  have htr_surj : ∀ z : M, ∃ w_z : K,
      traceLM F hMK w_z = z ∧
      (z = 0 → w_z = 0) ∧
      (z ≠ 0 →
        w_z ≠ 0 ∧
        valL F K w_z =
          (q : ℤ) * valL F M z + ((q - 1 : ℕ) : ℤ) -
            ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) := by
    intro z
    refine ⟨IntermediateField.inclusion hMK z * (π ^ (q - 1) * δ⁻¹), ?_, ?_, ?_⟩
    · rw [htr_smul z (π ^ (q - 1) * δ⁻¹), hEuler (q - 1) (Nat.sub_lt hq_pos zero_lt_one),
        if_pos rfl, mul_one]
    · intro hz0
      rw [hz0, map_zero, zero_mul]
    · intro hz_ne0
      have hincl_ne0 : IntermediateField.inclusion hMK z ≠ 0 :=
        (map_ne_zero_iff (IntermediateField.inclusion hMK) hinj).mpr hz_ne0
      have hpow_ne0 : π ^ (q - 1) ≠ 0 := (hval_pi_pow (q - 1)).1
      have hpow_val : valL F K (π ^ (q - 1)) = ((q - 1 : ℕ) : ℤ) := (hval_pi_pow (q - 1)).2
      have hrhs_ne0 : π ^ (q - 1) * δ⁻¹ ≠ 0 := mul_ne_zero hpow_ne0 hδ_inv_ne0
      refine ⟨mul_ne_zero hincl_ne0 hrhs_ne0, ?_⟩
      rw [hval_mul_K _ _ hincl_ne0 hrhs_ne0, hval_mul_K _ _ hpow_ne0 hδ_inv_ne0,
        hValAlg z, hpow_val, hδ_inv_val]
      ring

  have hTr_val0 : valL F M ((((ϖ_M ^ t)⁻¹ : Mˣ) : M) * traceLM F hMK ((ϖ_K ^ t : Kˣ) : K)) = 0 := by
    let w_t : K := ((ϖ_K ^ t : Kˣ) : K)
    have hwt_def : w_t = π ^ t := Units.val_pow_eq_pow_val ϖ_K t
    have hwt_ne0 : w_t ≠ 0 := by
      rw [hwt_def]
      exact (hval_pi_pow t).1
    have hwt_val : valL F K w_t = (t : ℤ) := by
      rw [hwt_def]
      exact (hval_pi_pow t).2
    have hwt_δ_ne0 : w_t * δ ≠ 0 := mul_ne_zero hwt_ne0 hδ_ne0
    have hq_sub : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by omega
    have hwt_δ_val : valL F K (w_t * δ) = (q : ℤ) * (t : ℤ) + ((q - 1 : ℕ) : ℤ) := by
      rw [hval_mul_K w_t δ hwt_ne0 hδ_ne0, hwt_val, hδ_val, hq_sub]
      ring
    obtain ⟨c_t, hwt_eq, hwt_val_iff⟩ := hBasis (w_t * δ)
    have htr_wt : traceLM F hMK w_t = c_t i_max := htr_from_basis w_t c_t hwt_eq
    set m₀ : ℤ := (q : ℤ) * (t : ℤ) + ((q - 1 : ℕ) : ℤ)
    have hc_t_all := (hwt_val_iff m₀).mp (Or.inr (le_of_eq hwt_δ_val.symm))
    have hc_t_imax_ge : c_t i_max = 0 ∨ (t : ℤ) ≤ valL F M (c_t i_max) := by
      rcases hc_t_all i_max with hc0 | hge
      · exact Or.inl hc0
      · right
        change m₀ ≤ (q : ℤ) * valL F M (c_t i_max) + ((q - 1 : ℕ) : ℤ) at hge
        nlinarith
    have hnot_gt : ¬ (c_t i_max = 0 ∨ (t : ℤ) + 1 ≤ valL F M (c_t i_max)) := by
      intro hbad
      set m₁ : ℤ := (q : ℤ) * (t : ℤ) + (q : ℤ)
      have hall_m₁ : ∀ i : Fin q, c_t i = 0 ∨ m₁ ≤ (q : ℤ) * valL F M (c_t i) + (i : ℤ) := by
        intro i
        by_cases hi_eq : i = i_max
        · subst hi_eq
          rcases hbad with hc0 | hge1
          · exact Or.inl hc0
          · right
            change m₁ ≤ (q : ℤ) * valL F M (c_t i_max) + ((q - 1 : ℕ) : ℤ)
            have hq1_nonneg : (0 : ℤ) ≤ ((q - 1 : ℕ) : ℤ) := Nat.cast_nonneg _
            nlinarith
        · by_cases hci0 : c_t i = 0
          · exact Or.inl hci0
          · right
            have hge0 : m₀ ≤ (q : ℤ) * valL F M (c_t i) + (i : ℤ) :=
              (hc_t_all i).resolve_left hci0
            have hi_ne_val : (i : ℕ) ≠ q - 1 := fun heq => hi_eq (Fin.ext heq)
            have hi_lt : (i : ℕ) < q := i.2
            have hi_le : (i : ℤ) ≤ ((q - 1 : ℕ) : ℤ) - 1 := by omega
            have hval_ge1 : (t : ℤ) + 1 ≤ valL F M (c_t i) := by
              by_contra hlt
              have hval_le : valL F M (c_t i) ≤ (t : ℤ) := by omega
              nlinarith
            have hi_nonneg : (0 : ℤ) ≤ (i : ℤ) := Nat.cast_nonneg _
            nlinarith
      have hm₁_val := (hwt_val_iff m₁).mpr hall_m₁
      have hm₁_le : m₁ ≤ valL F K (w_t * δ) := hm₁_val.resolve_left hwt_δ_ne0
      rw [hwt_δ_val] at hm₁_le
      omega
    have hct_imax_ne0 : c_t i_max ≠ 0 := fun hc0 => hnot_gt (Or.inl hc0)
    have hct_imax_val : valL F M (c_t i_max) = (t : ℤ) := by
      have hge : (t : ℤ) ≤ valL F M (c_t i_max) := hc_t_imax_ge.resolve_left hct_imax_ne0
      have hnot : ¬ ((t : ℤ) + 1 ≤ valL F M (c_t i_max)) := fun h1 => hnot_gt (Or.inr h1)
      omega
    have htr_wt_ne0 : traceLM F hMK w_t ≠ 0 := by
      rw [htr_wt]
      exact hct_imax_ne0
    have htr_wt_val : valL F M (traceLM F hMK w_t) = (t : ℤ) := by
      rw [htr_wt, hct_imax_val]
    have hϖM_pow_val : valL F M ((ϖ_M ^ t : Mˣ) : M) = (t : ℤ) := by
      rw [Units.val_pow_eq_pow_val, hval_pow_M (ϖ_M : M) t (Units.ne_zero ϖ_M), hϖ_M, mul_one]
    have hϖM_inv_val : valL F M (((ϖ_M ^ t)⁻¹ : Mˣ) : M) = -(t : ℤ) := by
      rw [hval_inv_M (ϖ_M ^ t), hϖM_pow_val]
    have hϖM_inv_ne0 : (((ϖ_M ^ t)⁻¹ : Mˣ) : M) ≠ 0 := Units.ne_zero _
    rw [hval_mul_M (((ϖ_M ^ t)⁻¹ : Mˣ) : M) (traceLM F hMK w_t) hϖM_inv_ne0 htr_wt_ne0,
      hϖM_inv_val, htr_wt_val]
    ring

  exact ⟨hResLift, htr_bound, htr_surj, hTr_val0,
    G, inferInstance, inferInstance, act,
    hcard_G, hact_one, hact_mul, hact_ring, hact_val, hact_trace, hact_norm⟩

theorem ld_ch14_wild_prime_step_norm_poly_and_herbrand (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] [FiniteDimensional F K]
    (hMK : M ≤ K)
    (hp_prime : Nat.Prime (p F))
    (hq_eq : Module.finrank M (IntermediateField.extendScalars hMK) = p F)
    (hValNorm : ∀ w : K, valL F M (normLM F hMK w) = valL F K w)
    (hValAlg : ∀ z : M,
      valL F K (IntermediateField.inclusion hMK z) =
        (Module.finrank M (IntermediateField.extendScalars hMK) : ℤ) * valL F M z)
    (hFrobSurjM : ∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
      ∃ s : M, (s = 0 ∨ 0 ≤ valL F M s) ∧
