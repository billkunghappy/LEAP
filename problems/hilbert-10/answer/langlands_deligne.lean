      ∀ (ξ : (Ω F)ˣ), ξ ^ ℓ = 1 → ∃ i < ℓ, ζ ^ i = ξ := by
    intro ζ hpow hne
    have hpow_val : (ζ : Ω F) ^ ℓ = 1 := by
      rw [← Units.val_pow_eq_pow_val, hpow, Units.val_one]
    have hne_val : (ζ : Ω F) ≠ 1 := fun h => hne (Units.ext h)
    have hord : orderOf (ζ : Ω F) = ℓ := orderOf_eq_prime hpow_val hne_val
    have hprim : IsPrimitiveRoot (ζ : Ω F) ℓ := IsPrimitiveRoot.iff_orderOf.mpr hord
    refine ⟨hprim, fun ξ hξ => ?_⟩
    have hξ_val : (ξ : Ω F) ^ ℓ = 1 := by
      rw [← Units.val_pow_eq_pow_val, hξ, Units.val_one]
    obtain ⟨i, hi_lt, hi_eq⟩ := hprim.eq_pow_of_pow_eq_one hξ_val
    refine ⟨i, hi_lt, Units.ext ?_⟩
    rw [Units.val_pow_eq_pow_val]
    exact hi_eq
  have hμE_pow_val : ∀ w : relWeil F L, (μE w) ^ ℓ = 1 := by
    intro w
    rw [← MonoidHom.pow_apply, hμE_pow, MonoidHom.one_apply]
  have hμM₁_pow_val : ∀ w : relWeil F L, (μM₁ w) ^ ℓ = 1 := by
    intro w
    rw [← MonoidHom.pow_apply, hμM₁_pow, MonoidHom.one_apply]
  have h_pow_a_eq_one : ∀ (a : ℕ), a < ℓ → 0 < a → ∀ (ζ : (Ω F)ˣ), ζ ^ ℓ = 1 →
