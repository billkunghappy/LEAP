    ld_ch13_tame_orbit_recChar_and_tower_structure F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hGal ψ hψ hMin hPrime_MCK hFinE_eq χL_ext hχL_ext
      D_orb hD₁_sub hD_orb_deg hD_orb_props
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F M_C := hFinMC
  haveI : FiniteDimensional F E := hFinE
  haveI : FiniteDimensional F K := hFinK
  apply hRed
  obtain ⟨hν_cond1, hϖ_L, hz₀, _, hqMC, hval_norm_MC, hval_alg_MC, htr_bound_MC, hnorm_lin_MC,
      hcondChar_MC, hcond_MC, hcond_νχ_MC, _, hqE, hval_norm_E, hval_alg_E, hResSurj_E,
      htr_bound_E, hnorm_rem_E, hcondChar_E, hcond_E, hT0⟩ :=
    ld_ch13_tame_diamond_ramification_and_conductors F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hGal hGalMCK hAbLMC hSepLE hCentralizer hMin h_tame hPrime_MCK hFinE_eq
      ψ hψ hψMC hψE D_orb.length hr_pos hf_H_gt1 hr_mul hcard_Hf
      χ' ν_orb hχ'_cond hχ'E_cond hχ'MC_cond hν_props hν_orb_sum
  by_cases ha0 : condExp F L χ' = 0
  · exact hT0 ha0
  · have ha_ge1 : 1 ≤ condExp F L χ' := Nat.one_le_iff_ne_zero.mpr ha0
    exact ld_ch13_tame_local_to_residue_reduction F L K M_C E hLK hLM_C hM_CK hLE hEK
      hGal hMin hPrime_MCK hOdd_ℓ hFinE_eq ψ hψ hψMC hψE
      D_orb.length hr_pos hf_H_gt1 hr_mul hcard_Hf χ' ν_orb ha_ge1
      hχ'_cond hχ'E_cond hχ'MC_cond hν_props hν_orb_sum hν_cond1 hϖ_L hz₀
      hqMC hval_norm_MC hval_alg_MC htr_bound_MC hnorm_lin_MC
      hcondChar_MC hcond_MC hcond_νχ_MC hqE hval_norm_E hval_alg_E
      hResSurj_E htr_bound_E hnorm_rem_E hcondChar_E (hcond_E ha_ge1)
      (fun k_L k_M _ _ _ _ _ hfinrank hNeChar hNotDvd ψ_k hψ_k χ_k μ_tilde hμ_props hμ_orb_sum =>
        ld_ch13_finite_field_orbit_davenport_hasse_product F k_L k_M _ _ D_orb.length
          hPrime_MCK hOdd_ℓ hf_H_gt1 hr_pos hr_mul hfinrank hNeChar hNotDvd hcard_Hf
          ψ_k hψ_k χ_k μ_tilde hμ_props hμ_orb_sum)
      (fun k_L k_M _ _ _ _ _ hfinrank hNeChar hNotDvd ψ_k hψ_k μ_tilde hμ_props hμ_orb_sum =>
        ld_ch13_finite_field_orbit_gauss_and_vandermonde_hasse F k_L k_M _ _ D_orb.length
          hPrime_MCK hOdd_ℓ hf_H_gt1 hr_pos hr_mul hfinrank hNeChar hNotDvd hcard_Hf
          ψ_k hψ_k μ_tilde hμ_props hμ_orb_sum)

theorem ld_ch14_wild_semidirect_coprime_prime_exists (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK)) :
    (∃ q₀ : ℕ,
      Nat.Prime q₀ ∧
      q₀ ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) ∧
      q₀ ≠ p F ∧
      q₀ ≠ 2 ∧
      Nat.Coprime (2 * p F) q₀) ∨
    (p F ≠ 2 ∧
      Nat.Prime 2 ∧
      2 ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) ∧
      Nat.Coprime (p F) 2 ∧
      ∀ q : ℕ, Nat.Prime q → q ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) →
        q = 2 ∨ q = p F) :=
by
  let K' := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  obtain ⟨hLMC_gt1, hMCK_gt1, _, _, _, hFinLK', _,
    _, C, H, _, _, hC_norm, hC_ab, hCard_C, hCard_H, hG_mul, hZ_H, hC_min_norm, _⟩ :=
    ld_ch13_14_semidirect_galois_group_structure F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hMin
  haveI : FiniteDimensional L K' := hFinLK'
  haveI : C.Normal := hC_norm
  letI : Fintype G := AlgEquiv.fintype L K'
  have hC_gt1 : 1 < Nat.card C := hCard_C.symm ▸ hMCK_gt1
  have hH_gt1 : 1 < Nat.card H := hCard_H.symm ▸ hLMC_gt1
  obtain ⟨ℓ, hPrime_ℓ, _, hC_exp_ℓ, _, h_wild_ℓ⟩ :=
    ld_ch13_14_lemma_6_4_prime_exp_and_tame_cyclic F L K hLK hGal C H hC_ab
      hC_gt1 hH_gt1 hZ_H hC_min_norm
  have hℓ_eq : ℓ = p F := h_wild_ℓ (hCard_C.symm ▸ h_wild)
  have hp_prime : Nat.Prime (p F) := hℓ_eq ▸ hPrime_ℓ
  have hC_exp : ∀ c ∈ C, c ^ (p F) = 1 := fun c hc => hℓ_eq ▸ hC_exp_ℓ c hc
  have h_exists_q₁ : ∃ q₁ : ℕ, Nat.Prime q₁ ∧
      q₁ ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) ∧ q₁ ≠ p F := by
    rw [← hCard_H]
    by_contra h_no_q
    push_neg at h_no_q
    have h_prime_pow : ∀ m : ℕ, 0 < m →
        (∀ q : ℕ, Nat.Prime q → q ∣ m → q = p F) → ∃ k : ℕ, m = (p F) ^ k := by
      intro m
      induction' m using Nat.strong_induction_on with m ih
      intro hm_pos hm_primes
      by_cases hm1 : m = 1
      · exact ⟨0, by rw [hm1, pow_zero]⟩
      · obtain ⟨q, hq_prime, hq_dvd⟩ := Nat.exists_prime_and_dvd hm1
        have hq_eq : q = p F := hm_primes q hq_prime hq_dvd
        rw [hq_eq] at hq_dvd
        rcases hq_dvd with ⟨m', rfl⟩
        have hm'_pos : 0 < m' := Nat.pos_of_mul_pos_left hm_pos
        have hm'_lt : m' < p F * m' := lt_mul_of_one_lt_left hm'_pos hp_prime.one_lt
        obtain ⟨k, hk⟩ := ih m' hm'_lt hm'_pos
          (fun q' hq' hq'_dvd => hm_primes q' hq' (dvd_mul_of_dvd_right hq'_dvd (p F)))
        exact ⟨k + 1, by rw [hk, pow_succ']⟩
    haveI : Finite H := Finite.of_fintype H
    obtain ⟨k₀, hk₀⟩ := h_prime_pow (Nat.card H) Nat.card_pos h_no_q
    have hH_exp : ∀ h ∈ H, h ^ ((p F) ^ k₀) = 1 := by
      intro h hh
      let h_sub : H := ⟨h, hh⟩
      have h_sub_pow : h_sub ^ (Nat.card H) = 1 :=
        orderOf_dvd_iff_pow_eq_one.mp (orderOf_dvd_natCard h_sub)
      have h_coe : h ^ (Nat.card H) = 1 := by
        rw [← Subgroup.coe_pow H h_sub (Nat.card H), h_sub_pow, Subgroup.coe_one]
      rwa [hk₀] at h_coe
    have h_semidirect_pow : ∀ (n : ℕ) (h : G), h ∈ H → ∀ c ∈ C,
        ∃ c_n ∈ C, (h * c) ^ n = h ^ n * c_n := by
      intro n h hh c hc
      induction n with
      | zero => exact ⟨1, C.one_mem, by simp⟩
      | succ n ih =>
        obtain ⟨c_n, hc_n, hn_eq⟩ := ih
        refine ⟨h⁻¹ * c_n * h * c, ?_, by rw [pow_succ, hn_eq, pow_succ]; group⟩
        have hconj : h⁻¹ * c_n * (h⁻¹)⁻¹ ∈ C := hC_norm.conj_mem c_n hc_n h⁻¹
        have heq : h⁻¹ * c_n * h = h⁻¹ * c_n * (h⁻¹)⁻¹ := by group
        rw [heq]
        exact C.mul_mem hconj hc
    have hPGroup : IsPGroup (p F) G := by
      intro g
      obtain ⟨h, hh, c, hc, rfl⟩ := hG_mul g
      obtain ⟨c_m, hc_m, hm_eq⟩ := h_semidirect_pow ((p F) ^ k₀) h hh c hc
      rw [hH_exp h hh, one_mul] at hm_eq
      refine ⟨k₀ + 1, ?_⟩
      rw [pow_succ, pow_mul, hm_eq, hC_exp c_m hc_m]
    haveI : Fact (Nat.Prime (p F)) := ⟨hp_prime⟩
    haveI : Finite C := Finite.of_fintype C
    have hC_ne_bot : C ≠ ⊥ := (Subgroup.one_lt_card_iff_ne_bot C).mp hC_gt1
    rw [ne_eq, Subgroup.eq_bot_iff_forall] at hC_ne_bot
    push_neg at hC_ne_bot
    obtain ⟨c₁, _, hc₁_ne1⟩ := hC_ne_bot
    haveI : Nontrivial G := ⟨⟨c₁, 1, hc₁_ne1⟩⟩
    have h_center_ne_bot : Subgroup.center G ≠ ⊥ := (IsPGroup.bot_lt_center hPGroup).ne'
    have hC_le_center : C ≤ Subgroup.center G :=
      (hC_min_norm (Subgroup.center G) Subgroup.instNormalCenter).resolve_left h_center_ne_bot
    have hH_ne_bot : H ≠ ⊥ := (Subgroup.one_lt_card_iff_ne_bot H).mp hH_gt1
    rw [ne_eq, Subgroup.eq_bot_iff_forall] at hH_ne_bot
    push_neg at hH_ne_bot
    obtain ⟨h₀, hh₀, hh₀_ne1⟩ := hH_ne_bot
    have hh₀_comm : ∀ c ∈ C, h₀ * c = c * h₀ :=
      fun c hc => Subgroup.mem_center_iff.mp (hC_le_center hc) h₀
    exact hh₀_ne1 (hZ_H h₀ hh₀ hh₀_comm)
  by_cases h_odd : ∃ q₀ : ℕ, Nat.Prime q₀ ∧
      q₀ ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) ∧ q₀ ≠ p F ∧ q₀ ≠ 2
  · obtain ⟨q₀, hq₀_prime, hq₀_dvd, hq₀_ne_p, hq₀_ne_2⟩ := h_odd
    have h_ndvd_2 : ¬ (2 ∣ q₀) := by
      intro h2
      have heq := ((Nat.dvd_prime hq₀_prime).mp h2).resolve_left (by decide)
      exact hq₀_ne_2 heq.symm
    have hcop_2 : Nat.Coprime 2 q₀ :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h_ndvd_2
    have h_ndvd_p : ¬ (p F ∣ q₀) := by
      intro hp
      have heq := ((Nat.dvd_prime hq₀_prime).mp hp).resolve_left hp_prime.ne_one
      exact hq₀_ne_p heq.symm
    have hcop_p : Nat.Coprime (p F) q₀ :=
      (Nat.Prime.coprime_iff_not_dvd hp_prime).mpr h_ndvd_p
    exact Or.inl ⟨q₀, hq₀_prime, hq₀_dvd, hq₀_ne_p, hq₀_ne_2,
      Nat.Coprime.mul_left hcop_2 hcop_p⟩
  · obtain ⟨q₁, hq₁_prime, hq₁_dvd, hq₁_ne_p⟩ := h_exists_q₁
    have hq₁_eq_2 : q₁ = 2 := by
      by_contra hq₁_ne_2
      exact h_odd ⟨q₁, hq₁_prime, hq₁_dvd, hq₁_ne_p, hq₁_ne_2⟩
    have hp_ne_2 : p F ≠ 2 := fun h => hq₁_ne_p (hq₁_eq_2.trans h.symm)
    have h2_dvd : 2 ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) :=
      hq₁_eq_2 ▸ hq₁_dvd
    have hcop_p_2 : Nat.Coprime (p F) 2 := by
      refine (Nat.Prime.coprime_iff_not_dvd hp_prime).mpr (fun hdvd => ?_)
      have heq := ((Nat.dvd_prime Nat.prime_two).mp hdvd).resolve_left hp_prime.ne_one
      exact hp_ne_2 heq
    refine Or.inr ⟨hp_ne_2, Nat.prime_two, h2_dvd, hcop_p_2, ?_⟩
    intro q hq_prime hq_dvd
    by_cases hq_p : q = p F
    · exact Or.inr hq_p
    · left
      by_contra hq_ne_2
      exact h_odd ⟨q, hq_prime, hq_dvd, hq_p, hq_ne_2⟩

theorem ld_ch14_galois_aut_recMap_conj_compat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L M_C K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGalLK : IsGaloisExt F L K)
    (hGalMC : IsGaloisExt F L M_C)
    (hGalMCK : IsGaloisExt F M_C K)
    (hAbMCK : IsAbelianExt F hM_CK)
    (γ : AbsGal F) (hγL : γ ∈ L.fixingSubgroup)
    (σ : M_C ≃ₐ[F] M_C)
    (hσ : ∀ z : M_C, (σ z : AlgebraicClosure F) = γ (z : AlgebraicClosure F))
    (w : M_Cˣ) :
    ((γ * (rec.recMap M_C w : AbsGal F) * γ⁻¹)⁻¹ *
