    rw [map_mul (IntermediateField.inclusion hE'K₁), hinc_E'K₁ c₀, hinc_E'K₁ c₁]
    dsimp only [U₂, V₂]
    simp only [map_sub, map_add, map_mul, map_one, map_ofNat]
