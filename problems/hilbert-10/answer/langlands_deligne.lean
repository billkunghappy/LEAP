        have ht₁_1 : (p - 1) * t₁ ≤ (p - 1) * t₂ := Nat.mul_le_mul_left (p - 1) ht₁_le_t₂
        have ht₁_2 : (p - 2) * t₁ ≤ (p - 2) * t₂ := Nat.mul_le_mul_left (p - 2) ht₁_le_t₂
        have ht₁_3 : (p - 3) * t₁ ≤ (p - 3) * t₂ := Nat.mul_le_mul_left (p - 3) ht₁_le_t₂
        have h_sum4 : p + (p - 1) + (p - 2) + (p - 3) ≤ 4 * (p - 1) := by omega
        have h4 : p * t₂ + (p - 1) * t₂ + (p - 2) * t₂ + (p - 3) * t₂ ≤ p * (p - 1) * t₂ := by
          calc p * t₂ + (p - 1) * t₂ + (p - 2) * t₂ + (p - 3) * t₂
              = (p + (p - 1) + (p - 2) + (p - 3)) * t₂ := by ring
            _ ≤ (4 * (p - 1)) * t₂ := Nat.mul_le_mul_right t₂ h_sum4
            _ ≤ (p * (p - 1)) * t₂ :=
              Nat.mul_le_mul_right t₂ (Nat.mul_le_mul_right (p - 1) (by omega))
        have h_nat : (1 + p * t₂) + p * t₁ + (i - 1) * t₁ + (p - 1) * t₁ ≤
            i * p * m_exp + (B₀ + (p - 1) * t₁) := by
          rw [hB₀_add]
          linarith [h1', h2, h3, ht₁_1, ht₁_2, ht₁_3, h4]
        have hz : (((1 + p * t₂) + p * t₁ + (i - 1) * t₁ + (p - 1) * t₁ : ℕ) : ℤ) ≤
            ((i * p * m_exp + (B₀ + (p - 1) * t₁) : ℕ) : ℤ) := by
          exact_mod_cast h_nat
        push_cast at hz ⊢
        linarith
  rw [hsplit]
  exact hval_add_K₁ ((1 + p * t₂ : ℕ) : ℤ) Term1 Term2 hTerm1 hTerm2

theorem ld_ch12_wild_odd_tot_ram_lval_vals_and_linear_conj_sum_reduction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
