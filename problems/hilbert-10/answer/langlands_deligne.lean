      have h_nat : (1 + p * t₂) + p * t₁ + (p - 2) * t₁ ≤
          1 * p * m_exp + (B₁ + (p - 2) * t₁) := by
        rw [hB₁_add]
        linarith [h1', h2, h_base_t₂]
      have hz : (((1 + p * t₂) + p * t₁ + (p - 2) * t₁ : ℕ) : ℤ) ≤
          ((1 * p * m_exp + (B₁ + (p - 2) * t₁) : ℕ) : ℤ) := by
        exact_mod_cast h_nat
      push_cast at hz ⊢
      linarith
    · rcases eq_or_ne i (p - 1) with rfl | hi_ne_top
      · refine hmul_bound _ _ _ _ _ ?_ hw_fb_val hSumTop
        have h1 : 2 * (1 + t₁) ≤ (p - 1) * (p * m_exp) :=
          Nat.mul_le_mul (by omega) hpm_ge
        have h1' : 2 + 2 * t₁ ≤ (p - 1) * p * m_exp := by
          calc 2 + 2 * t₁ = 2 * (1 + t₁) := by ring
            _ ≤ (p - 1) * (p * m_exp) := h1
            _ = (p - 1) * p * m_exp := by ring
        have h2 : p * t₁ = 2 * t₁ + (p - 2) * t₁ := by
          have hp2 : p = 2 + (p - 2) := by omega
          calc p * t₁ = (2 + (p - 2)) * t₁ := by rw [← hp2]
            _ = 2 * t₁ + (p - 2) * t₁ := by ring
        have h_nat : (1 + p * t₂) + p * t₁ + (p - 1) * t₁ ≤
            (p - 1) * p * m_exp + (B₀ + (p - 1) * t₁) := by
          rw [hB₀_add]
          linarith [h1', h2, h_base_t₂]
        have hz : (((1 + p * t₂) + p * t₁ + (p - 1) * t₁ : ℕ) : ℤ) ≤
            (((p - 1) * p * m_exp + (B₀ + (p - 1) * t₁) : ℕ) : ℤ) := by
          exact_mod_cast h_nat
        push_cast at hz ⊢
        linarith
      · have hp_ne4 : p ≠ 4 := by
          rintro h4
          have hnp : ¬ Nat.Prime 4 := by decide
          exact hnp (h4 ▸ hPrime)
        have hp_ge5 : 5 ≤ p := by omega
        have hSum_mid : (∑ m' ∈ Finset.range p, ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i)) = 0 ∨
            ((B₀ : ℕ) : ℤ) - ((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) ≤
              valL F K₁ (∑ m' ∈ Finset.range p, ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i)) :=
          hval_sum (Finset.range p) _ _ fun m' hm' => hDiff_pow_val m' (Finset.mem_range.mp hm')
