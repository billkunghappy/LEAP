              _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hle1
              _ = Module.finrank F L := mul_one _
          have hLF'₀_eq : L = F'₀ := IntermediateField.eq_of_le_of_finrank_le hLF'₀ hfin_le
          have hF'₀_le_L : E ⊓ M ≤ L := hF'₀_inf.trans (le_of_eq hLF'₀_eq.symm)
          by_cases hCommTriv : ∀ (w₁ : relWeil F E) (w₂ : relWeil F M)
