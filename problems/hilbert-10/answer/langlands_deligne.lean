  have hδU_val : valL F L (δ_U : L) = (d_U : ℤ) := hϖ_pow_val d_U
  have hP_δU : P_L (d_U : ℤ) (δ_U : L) := hPL_of_val hδU_val
  set δ_M₁' : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom δ_U
  have hδM₁'_coe : (δ_M₁' : M₁') = IntermediateField.inclusion hLM₁' (δ_U : L) := rfl
  have hδM₁'_val : valL F M₁' (δ_M₁' : M₁') = (d_U : ℤ) := by
    rw [hδM₁'_coe, hval_LM₁', hδU_val]
  have hP_δM₁' : P_U (d_U : ℤ) (δ_M₁' : M₁') := hPU_of_val hδM₁'_val
  let ϕ_U : L × L → M₁' := fun p =>
    IntermediateField.inclusion hLM₁' p.1 + IntermediateField.inclusion hLM₁' p.2 * d
  set R_M₁' : Finset M₁' := (R_L ×ˢ R_L).image ϕ_U
