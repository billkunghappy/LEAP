    rcases hval_mul_ge_L (Or.inr (le_of_eq hβ_val.symm)) hz with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hx_star_sq_tr : traceLM F hLE' (- (x_star ^ 2)) = 0 ∨
