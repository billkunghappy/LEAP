    · exact Or.inl h0
    · right
      change 0 ≤ (p : ℤ) * valL F L c₀ + (0 : ℤ) at hge
      have hp_int_pos : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
