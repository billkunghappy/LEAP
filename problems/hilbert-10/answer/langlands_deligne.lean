        have h14f_inv : (1 + 4 * f) * (1 + 4 * f)⁻¹ = 1 := mul_inv_cancel₀ h14f_props.1
        have h1η_inv : (1 + η) * (1 + η)⁻¹ = 1 := mul_inv_cancel₀ h1η_ne
        linear_combination -w * h1η_inv - (w * (1 + η)⁻¹) * h14f_inv
      have hmul_decomp : ((α⁻¹ : Lˣ) : L) * Δ₁ * w =
          ((α⁻¹ : Lˣ) : L) * Δ₁ * w₁' + ((α⁻¹ : Lˣ) : L) * Δ₁ * w₂' := by
        rw [hw_decomp, mul_add]
      rw [hmul_decomp, ψ.map_add_eq_mul, hψ_w₁', hψ_w₂', mul_one]
  have hΔ₁_vanish : ∀ w : L, (w = 0 ∨ (e : ℤ) + 1 ≤ valL F L w) →
      ψ (((α⁻¹ : Lˣ) : L) * Δ₁ * w) = 1 := by
    intro w hw
    apply hΔ₁_down e le_rfl w
    exact hvalL_mono ((e : ℤ) + 1) (2 * (e : ℤ) + 1 - (e : ℤ)) w hw (by omega)
  refine ⟨hN₁_props.1, hN₁_props.2, ?_⟩
  intro z hz_val hz
  have hz_2e1 : z = 0 ∨ 2 * (e : ℤ) + 1 ≤ valL F M₁' z := by
    rw [hm1_half] at hz_val
    push_cast at hz_val
    exact hz_val
  obtain ⟨s₀, s₁, hz_eq, hz_coords⟩ := hM₁'_coords z
  obtain ⟨hs₀_raw, hs₁_raw⟩ := (hz_coords (2 * (e : ℤ) + 1)).mp hz_2e1
  have hs₀_e1 : s₀ = 0 ∨ (e : ℤ) + 1 ≤ valL F L s₀ := by
    rcases hs₀_raw with rfl | h
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hs₁_ea : s₁ = 0 ∨ (e : ℤ) + (a : ℤ) ≤ valL F L s₁ := by
    rcases hs₁_raw with rfl | h
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hΔz_eq : Δ * z =
      ι (Δ₀ * s₀ + Δ₁ * s₁ * f) + ι (Δ₀ * s₁ + Δ₁ * (s₀ - s₁)) * x := by
    rw [hz_eq]
    dsimp [Δ]
    simp only [map_add, map_sub, map_mul]
    linear_combination ι Δ₁ * ι s₁ * hx_sq
  have htr_Δz : traceLM F hLM₁' (Δ * z) =
      Δ₀ * (2 * s₀ - s₁) + Δ₁ * (-s₀ + s₁ + 2 * f * s₁) := by
    rw [hΔz_eq, (hCoordTrNorm _ _).1]
    ring
  have hΔ₀_term : Δ₀ * (2 * s₀ - s₁) = 0 ∨ 2 * (e : ℤ) + 1 ≤ valL F L (Δ₀ * (2 * s₀ - s₁)) := by
    have h2s₀ : 2 * s₀ = 0 ∨ 2 * (e : ℤ) + 1 ≤ valL F L (2 * s₀) :=
      hvalL_2mul (2 * (e : ℤ) + 1) ((e : ℤ) + 1) s₀ hs₀_e1 (by omega)
    have h2s₀_s₁ : 2 * s₀ - s₁ = 0 ∨ (e : ℤ) + (a : ℤ) ≤ valL F L (2 * s₀ - s₁) :=
      hvalL_sub ((e : ℤ) + (a : ℤ)) (2 * (e : ℤ) + 1) ((e : ℤ) + (a : ℤ)) (2 * s₀) s₁
        h2s₀ hs₁_ea (by omega) le_rfl
    exact hvalL_mul_or (2 * (e : ℤ) + 1) ((e : ℤ) - (a : ℤ) + 1) ((e : ℤ) + (a : ℤ))
      Δ₀ (2 * s₀ - s₁) hΔ₀_val h2s₀_s₁ (by omega)
  have hψ_Δ₀_term : ψ (((α⁻¹ : Lˣ) : L) * (Δ₀ * (2 * s₀ - s₁))) = 1 :=
    hψ_alpha_inv _ hΔ₀_term
  have hw_z_e1 : -s₀ + s₁ + 2 * f * s₁ = 0 ∨ (e : ℤ) + 1 ≤ valL F L (-s₀ + s₁ + 2 * f * s₁) := by
    have hns₀_s₁ : -s₀ + s₁ = 0 ∨ (e : ℤ) + 1 ≤ valL F L (-s₀ + s₁) :=
      hvalL_add ((e : ℤ) + 1) ((e : ℤ) + 1) ((e : ℤ) + (a : ℤ)) (-s₀) s₁
        (hvalL_neg_or ((e : ℤ) + 1) s₀ hs₀_e1) hs₁_ea le_rfl (by omega)
    have hfs₁ : f * s₁ = 0 ∨ 1 + (e : ℤ) - (a : ℤ) ≤ valL F L (f * s₁) :=
      hvalL_mul_or (1 + (e : ℤ) - (a : ℤ)) (1 - 2 * (a : ℤ)) ((e : ℤ) + (a : ℤ))
        f s₁ hf_or hs₁_ea (by omega)
    have h2fs₁ : 2 * f * s₁ = 0 ∨ (e : ℤ) + 1 ≤ valL F L (2 * f * s₁) := by
      have heq : 2 * f * s₁ = 2 * (f * s₁) := by ring
      rw [heq]
      exact hvalL_2mul ((e : ℤ) + 1) (1 + (e : ℤ) - (a : ℤ)) (f * s₁) hfs₁ (by omega)
    exact hvalL_add ((e : ℤ) + 1) ((e : ℤ) + 1) ((e : ℤ) + 1) (-s₀ + s₁) (2 * f * s₁)
      hns₀_s₁ h2fs₁ le_rfl le_rfl
  have hψ_Δ₁_term : ψ (((α⁻¹ : Lˣ) : L) * Δ₁ * (-s₀ + s₁ + 2 * f * s₁)) = 1 :=
    hΔ₁_vanish _ hw_z_e1
  have hψM₁'_Δz : (traceChar F hLM₁' ψ) (ι ((α⁻¹ : Lˣ) : L) * (Δ * z)) = 1 := by
    rw [htraceChar_incl_mul, htr_Δz]
    have hsplit :
        ((α⁻¹ : Lˣ) : L) * (Δ₀ * (2 * s₀ - s₁) + Δ₁ * (-s₀ + s₁ + 2 * f * s₁)) =
          ((α⁻¹ : Lˣ) : L) * (Δ₀ * (2 * s₀ - s₁)) +
            ((α⁻¹ : Lˣ) : L) * Δ₁ * (-s₀ + s₁ + 2 * f * s₁) := by ring
    rw [hsplit, ψ.map_add_eq_mul, hψ_Δ₀_term, hψ_Δ₁_term, mul_one]
  have hα_mul_inv : ι ((α⁻¹ : Lˣ) : L) * ι (α : L) = 1 := by
    rw [← map_mul, Units.inv_mul, map_one]
  have hc_θ₁_z_decomp :
      ((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z =
        ι ((α⁻¹ : Lˣ) : L) * N₁ * z + ι ((α⁻¹ : Lˣ) : L) * (Δ * z) := by
    linear_combination
      -(((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z) * hα_mul_inv +
      (ι ((α⁻¹ : Lˣ) : L) * z) * hΔ_eq
  rw [hc_θ₁_stat z hz_val hz, hc_θ₁_z_decomp, AddChar.map_add_eq_mul, hψM₁'_Δz, mul_one]

theorem ld_ch12_wild_dyadic_odd_max_break_min_cond_lower_norm_and_c_nu_stat (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdegLE' : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegLM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hSpecL : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (h2_ne : (2 : L) ≠ 0)
    (h2_val : valL F L (2 : L) = ((condExp F L νE' / 2 : ℕ) : ℤ))
    (x : M₁') (f ρ : L) (α : Lˣ)
    (hβ₁ : -4 * f ≠ 0) (hβ₂ : 1 - ρ ≠ 0)
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hρ_val : valL F L ρ =
      (2 * ((condExp F L νE' / 2 : ℕ) : ℤ) + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (hCoordTrNorm : ∀ s₀ s₁ : L,
      traceLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        2 * s₀ - s₁ ∧
      normLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        s₀ ^ 2 - s₀ * s₁ - f * s₁ ^ 2)
    (hα_val : valL F L (α : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν₂_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' / 2 : ℕ) + 1 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) =
          ψ (((((α * (Units.mk0 (1 - ρ) hβ₂)⁻¹)⁻¹ : Lˣ) : L) * u)))
    (hc_ν₁_stat : ∀ u : L, (u = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νM₁' (Units.mk0 (1 + u) hu) : Ω F) =
          ψ (((((α * (Units.mk0 (-4 * f) hβ₁)⁻¹)⁻¹ : Lˣ) : L) * u)))
    (c₀ : L)
    (hc₀_val : c₀ = 0 ∨ 1 - ((((condExp F L νM₁' / 2) + 1) / 2 : ℕ) : ℤ) ≤ valL F L c₀) :
    let a := condExp F L νM₁' / 2
    let e := condExp F L νE' / 2
    let β₁ := -4 * f
    let β₂ := 1 - ρ
    let δ_tr := 4 * c₀ + 4 * c₀ ^ 2
    (∀ v : E', (v = 0 ∨ (e : ℤ) + 1 ≤ valL F E' v) →
      ∀ hv : 1 + v ≠ 0,
        let wE' : Lˣ := Units.map (normLM F hLE') (Units.mk0 (1 + v) hv)
        (wE' : L) - 1 = 0 ∨ (e : ℤ) + 1 ≤ valL F L ((wE' : L) - 1)) ∧
    (∀ v : M₁', (v = 0 ∨ (e : ℤ) ≤ valL F M₁' v) →
      ∀ hv : 1 + v ≠ 0,
        let wM₁' : Lˣ := Units.map (normLM F hLM₁') (Units.mk0 (1 + v) hv)
        (wM₁' : L) - 1 = 0 ∨ (a : ℤ) ≤ valL F L ((wM₁' : L) - 1)) ∧
    (∀ (tE' : E'), normLM F hLE' tE' = β₂ + δ_tr →
      tE' ≠ 0 ∧
      valL F E' tE' = 0 ∧
      ∀ htE' : tE' ≠ 0,
        let cνE' : Lˣ := α * (Units.map (normLM F hLE') (Units.mk0 tE' htE'))⁻¹
        valL F L (cνE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ ∧
        ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
          ∀ hu : 1 + u ≠ 0,
            (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνE'⁻¹ : Lˣ) : L) * u)) ∧
    (∀ (tM₁' : M₁'), normLM F hLM₁' tM₁' = β₁ + δ_tr →
      tM₁' ≠ 0 ∧
      valL F M₁' tM₁' = 2 * ((e : ℤ) - (a : ℤ)) + 1 ∧
      ∀ htM₁' : tM₁' ≠ 0,
        let cνM₁' : Lˣ := α * (Units.map (normLM F hLM₁') (Units.mk0 tM₁' htM₁'))⁻¹
        valL F L (cνM₁' : L) = (condExp F L νM₁' : ℤ) + condExpChar F L ψ ∧
        ∀ u : L, (u = 0 ∨ (((condExp F L νM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
          ∀ hu : 1 + u ≠ 0,
            (νM₁' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνM₁'⁻¹ : Lˣ) : L) * u)) :=
by
  intro a e β₁ β₂ δ_tr
  have ha_ge1 : 1 ≤ a := by dsimp [a]; omega
  have he_ge_a : a ≤ e := by dsimp [a, e]; omega
  have hT1_eq : condExp F L νM₁' = 2 * a := by dsimp [a]; omega
  have hT2_eq : condExp F L νE' = 2 * e + 1 := by dsimp [e]; omega
  have hT2_half : (condExp F L νE' + 1) / 2 = e + 1 := by omega
  have hT1_half : (condExp F L νM₁' + 1) / 2 = a := by omega
  obtain ⟨h0, h1, hneg1, hneg, hmul, hinv, hex, hadd, hug0, huga, huga_val⟩ := hvalL_props
  have hL_mul_b : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by simp [hx0])
    · by_cases hy0 : y = 0
      · exact Or.inl (by simp [hy0])
      · right
        rw [hmul x y hx0 hy0]
        have hx1 := hx.resolve_left hx0
        have hy1 := hy.resolve_left hy0
        omega
  have hL_sub_b : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hadd k x (-y) hx
    rcases hy with rfl | hy
    · exact Or.inl neg_zero
    · right; rwa [hneg]
  have hL_eq_lt : ∀ (k₁ k₂ : ℤ) (x y : L),
      x ≠ 0 → valL F L x = k₁ → (y = 0 ∨ k₂ ≤ valL F L y) → k₁ < k₂ →
        x + y ≠ 0 ∧ valL F L (x + y) = k₁ := by
    intro k₁ k₂ x y hx0 hxv hy hk
    have hne : x + y ≠ 0 := by
      intro hsum
      have hyx : y = -x := eq_neg_of_add_eq_zero_right hsum
      have hy0 : y ≠ 0 := by rw [hyx]; exact neg_ne_zero.mpr hx0
      have hyv : valL F L y = k₁ := by rw [hyx, hneg, hxv]
      have hy_ge := hy.resolve_left hy0
      omega
    have hge : k₁ ≤ valL F L (x + y) := by
      have h := hadd k₁ x y (Or.inr (by omega)) (hy.imp id (fun h => by omega))
      exact h.resolve_left hne
    have hle : valL F L (x + y) ≤ k₁ := by
      by_contra hlt
      push_neg at hlt
      let m := min (valL F L (x + y)) k₂
      have hm_gt : k₁ < m := lt_min hlt hk
      have hxy_m : x + y = 0 ∨ m ≤ valL F L (x + y) := Or.inr (min_le_left _ _)
      have hny_m : -y = 0 ∨ m ≤ valL F L (-y) := by
        rcases hy with rfl | hy
        · exact Or.inl neg_zero
        · right; rw [hneg]; exact le_trans (min_le_right _ _) hy
      have hx_m := hadd m (x + y) (-y) hxy_m hny_m
      rw [add_neg_cancel_right] at hx_m
      have hx_ge := hx_m.resolve_left hx0
      omega
    exact ⟨hne, le_antisymm hle hge⟩
  have hL_mul_inv : ∀ (u v : Lˣ),
      valL F L (((u * v⁻¹ : Lˣ) : L)) = valL F L (u : L) - valL F L (v : L) := by
    intro u v
    rw [Units.val_mul, hmul _ _ (Units.ne_zero _) (Units.ne_zero _), hinv v]
    ring
  have hL_inv_mul : ∀ (u v : Lˣ),
      (((u * v⁻¹)⁻¹ : Lˣ) : L) = ((u⁻¹ : Lˣ) : L) * (v : L) := by
    intro u v
    rw [mul_inv, inv_inv, Units.val_mul]
  have hQuadHelper : ∀ (M₂ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M₂]
      (h : L ≤ M₂),
      Module.finrank L (IntermediateField.extendScalars h) = 2 →
      normLM F h 0 = 0 ∧
      ∀ v : M₂, normLM F h (1 + v) - 1 = traceLM F h v + normLM F h v := by
    intro M₂ _ h hdeg
    have hq := hQuadNorm L M₂ h hdeg
    have hnorm0 : normLM F h 0 = 0 := by
      have hsub := (hq.2 1 (IntermediateField.inclusion h 1)).2
      have htr1 := hq.1 1
      have hincl1 : IntermediateField.inclusion h 1 = 1 := map_one (IntermediateField.inclusion h)
      have hnorm1 : normLM F h (IntermediateField.inclusion h 1) = 1 := by
        rw [hincl1, map_one]
      rw [sub_self, htr1, hnorm1] at hsub
      linear_combination hsub
    refine ⟨hnorm0, fun v => ?_⟩
    have h1 := (hq.2 1 v).1
    rw [map_one (IntermediateField.inclusion h)] at h1
    linear_combination h1
  obtain ⟨hnormE'_0, hnormE'_1add⟩ := hQuadHelper E' hLE' hdegLE'
  obtain ⟨hnormM₁'_0, hnormM₁'_1add⟩ := hQuadHelper M₁' hLM₁' hdegLM₁'
  have hNormLE' : ∀ v : E', (v = 0 ∨ (e : ℤ) + 1 ≤ valL F E' v) →
      ∀ hv : 1 + v ≠ 0,
        let wE' : Lˣ := Units.map (normLM F hLE') (Units.mk0 (1 + v) hv)
        (wE' : L) - 1 = 0 ∨ (e : ℤ) + 1 ≤ valL F L ((wE' : L) - 1) := by
    intro v hv hv1 wE'
    have htr_in : v = 0 ∨ 2 * ((e : ℤ) + 1) - (condExp F L νE' : ℤ) ≤ valL F E' v :=
      hv.imp id (fun h => by omega)
    have htr_b : traceLM F hLE' v = 0 ∨ (e : ℤ) + 1 ≤ valL F L (traceLM F hLE' v) :=
      htr_LE' ((e : ℤ) + 1) v htr_in
    have hnorm_b : normLM F hLE' v = 0 ∨ (e : ℤ) + 1 ≤ valL F L (normLM F hLE' v) := by
      rcases hv with rfl | hv_ge
      · exact Or.inl hnormE'_0
      · right; rwa [hval_normE']
    have hw_eq : (wE' : L) - 1 = traceLM F hLE' v + normLM F hLE' v := by
      change normLM F hLE' (1 + v) - 1 = _
      exact hnormE'_1add v
    rw [hw_eq]
    exact hadd ((e : ℤ) + 1) _ _ htr_b hnorm_b
  have hNormLM₁' : ∀ v : M₁', (v = 0 ∨ (e : ℤ) ≤ valL F M₁' v) →
      ∀ hv : 1 + v ≠ 0,
        let wM₁' : Lˣ := Units.map (normLM F hLM₁') (Units.mk0 (1 + v) hv)
        (wM₁' : L) - 1 = 0 ∨ (a : ℤ) ≤ valL F L ((wM₁' : L) - 1) := by
    intro v hv hv1 wM₁'
    obtain ⟨s₀, s₁, hv_eq, hv_val⟩ := hM₁'_coords v
    obtain ⟨hs₀, hs₁⟩ := (hv_val (e : ℤ)).mp hv
    have hs₀_1 : s₀ = 0 ∨ 1 ≤ valL F L s₀ := hs₀.imp id (fun h => by omega)
    have h2_b : (2 : L) = 0 ∨ (e : ℤ) ≤ valL F L (2 : L) := Or.inr (by rw [h2_val])
    have h2s₀_b : 2 * s₀ = 0 ∨ (a : ℤ) ≤ valL F L (2 * s₀) :=
      (hL_mul_b (e : ℤ) 1 (2 : L) s₀ h2_b hs₀_1).imp id (fun h => by omega)
    have hs₁_b : s₁ = 0 ∨ (a : ℤ) ≤ valL F L s₁ := by
      change s₁ = 0 ∨ (e : ℤ) ≤ 2 * valL F L s₁ + 1 - 2 * (a : ℤ) at hs₁
      exact hs₁.imp id (fun h => by omega)
    have htr_b : traceLM F hLM₁' v = 0 ∨ (a : ℤ) ≤ valL F L (traceLM F hLM₁' v) := by
      rw [hv_eq, (hCoordTrNorm s₀ s₁).1]
      exact hL_sub_b (a : ℤ) (2 * s₀) s₁ h2s₀_b hs₁_b
    have hnorm_b : normLM F hLM₁' v = 0 ∨ (a : ℤ) ≤ valL F L (normLM F hLM₁' v) := by
      rcases hv with rfl | hv_ge
      · exact Or.inl hnormM₁'_0
      · right; rw [hval_normM₁']; omega
    have hw_eq : (wM₁' : L) - 1 = traceLM F hLM₁' v + normLM F hLM₁' v := by
      change normLM F hLM₁' (1 + v) - 1 = _
      exact hnormM₁'_1add v
    rw [hw_eq]
