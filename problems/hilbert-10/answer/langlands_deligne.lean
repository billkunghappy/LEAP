          have hB_last : B ≤ (p : ℤ) * valL F L a_last + valL F M₁' w_last := by
            linarith
          have hval_term_last :
              -(ι a_last * w_last) = 0 ∨ B ≤ valL F M₁' (-(ι a_last * w_last)) := by
            right
            rw [hval_neg_M₁', hval_mul_M₁' (ι a_last) w_last hι_ne0 hw_last_ne0,
              hval_LM₁' a_last]
            exact hB_last
          have hU_B : U a' = 0 ∨ B ≤ valL F M₁' (U a') := by
            have hadd := hval_add_M₁' B (U a' + ι a_last * w_last) (-(ι a_last * w_last))
              (Or.inr hB_comb) hval_term_last
            have hcancel : (U a' + ι a_last * w_last) + -(ι a_last * w_last) = U a' := by ring
            rwa [hcancel] at hadd
          intro j
          refine Fin.lastCases ?_ ?_ j
          · right; right; dsimp [w]; rw [Fin.lastCases_last]; exact hB_last
          · intro i
            dsimp [w]
            rw [Fin.lastCases_castSucc]
            exact horth' a' B hU_B i

theorem ld_ch12_wild_odd_tot_ram_quad_zero_degree_trace_from_orthogonal_basis (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
