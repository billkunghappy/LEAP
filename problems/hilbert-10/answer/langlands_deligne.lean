      τ₁ hτ₁_L h2_val x f g d α
      hβ₁ hx_ne hf_ne hg_ne hd_ne hk₀_ne hh₀_ne
      hx_val hf_val hg_val hd_val hk₀_val hE_val hh₀_val hβ₁_val
      hx_sq hx_conj hM₁'_coords hα_val hNormPhaseM₁' hCommM₁'
      hCoordTrNorm hτ₁_TrNorm c₀ c₁ c_θ₁ Δ₀ Δ₁
      hc_θ₁_stat hc₀_val hc₁_val hΔ₀_val hΔ₁_val hΔ_eq (hShiftTable c₀ c₁).2.2.2.2.2
  exact ld_ch12_wild_dyadic_even_breaks_min_cond_cE_and_pullback F rec L E' M₁' K₁
    hLE' hLM₁' hE'K₁ hM₁'K₁ χK₁ χE' χM₁' ψ νE' νM₁'
    hνE'_ker hνM₁'_ker hbE'_ge2 hbM₁'_ge2 hMinM₁' hT1_even hT2_even
    hm1_min hm2_min hθE'_triv hnE' hnM₁' hCommonOrigin hSpecL hSpecE'
    hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
    hval_normE' hval_normM₁' hval_normK₁ hval_LE' hval_LM₁'
