        (u_fn m - ∑ r ∈ Finset.range (p - 2),
            (c_coeff r : K₁) * ξ_m ^ (r + 1) * ((Δ : K₁) ^ (p - 2 - r)) = 0 ∨
          ((2 * p * (p - 1) * (bE' - 1) - (2 * p - 3) * (bM₁' - 1) : ℕ) : ℤ) ≤
            valL F K₁
              (u_fn m - ∑ r ∈ Finset.range (p - 2),
                (c_coeff r : K₁) * ξ_m ^ (r + 1) * ((Δ : K₁) ^ (p - 2 - r))))) :=
by
  obtain ⟨τ_unit, hτ_val0, hτ_p1, hτ_pow_sum, hξ_props, hξ_diff, hξ_prod⟩ :=
    ld_ch12_wild_odd_tot_ram_teichmuller_unit_lifts_and_distinctness F L E' M₁' K₁
      hLE' hLM₁' hM₁'K₁ hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalL_props hvalM₁'_props hvalK₁_props hval_LM₁' hval_M₁'K₁ hTeich
  obtain ⟨Δ_conj, hΔ_conj_tr, hΔ_conj_as, hΔ_conj_approx⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_teichmuller_matching_bijection F L E' M₁' K₁
      hLE' hLM₁' hM₁'K₁ hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hvalK₁_props Δ Δ_gal hΔ_gal_tr hΔ_gal_as hδ_gal_props hδ_gal_diff
      τ_unit hξ_diff hξ_prod
  obtain ⟨u_fn, c_coeff, hc_dvd, hu_props⟩ :=
    ld_ch12_wild_odd_tot_ram_closed_form_quotient_perturbation F L E' M₁' K₁
      hLE' hLM₁' hM₁'K₁ hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hp_valK₁ hvalK₁_props Δ hΔ_val τ_unit hξ_props
      Δ_conj hΔ_conj_as hΔ_conj_approx
  exact ⟨τ_unit, Δ_conj, u_fn, c_coeff, hτ_val0, hτ_p1, hτ_pow_sum, hΔ_conj_tr, hc_dvd, hu_props⟩

