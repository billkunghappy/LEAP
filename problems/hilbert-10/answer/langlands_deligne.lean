    have hsum_b := hvalE'_props.2.2.2.2.2.2.2.1 (2 * (e : ℤ)) _ _ h2z_b hzz_b
    rw [← huE'_sub1] at hsum_b
    rw [hm₂_half]
    exact hsum_b.imp id (fun h => by omega)
  have huE'_1add : 1 + ((uE' : E') - 1) = (uE' : E') := add_sub_cancel 1 (uE' : E')
  have huE'_1ne : 1 + ((uE' : E') - 1) ≠ 0 := by rw [huE'_1add]; exact Units.ne_zero uE'
  have hmk_uE' : Units.mk0 (1 + ((uE' : E') - 1)) huE'_1ne = uE' := Units.ext huE'_1add
  have hstat_uE' : (θE' uE' : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) := by
    have h := hcE'_stat ((uE' : E') - 1) huE'_b huE'_1ne
    rwa [hmk_uE'] at h
  have hνM₁'_w : νM₁' wM₁' = 1 :=
    (hνM₁'_ker wM₁').mp ⟨Units.mk0 (1 + vM₁') hvM₁'_1ne, rfl⟩
  have hwM₁'_b : (wM₁' : L) - 1 = 0 ∨
      (((condExp F L νM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((wM₁' : L) - 1) := by
    rw [hT1_half]
    exact hNormLM₁' vM₁' hvM₁'_b hvM₁'_1ne
  have hwM₁'_1add : 1 + ((wM₁' : L) - 1) = (wM₁' : L) := add_sub_cancel 1 (wM₁' : L)
  have hwM₁'_1ne : 1 + ((wM₁' : L) - 1) ≠ 0 := by rw [hwM₁'_1add]; exact Units.ne_zero wM₁'
  have hmk_wM₁' : Units.mk0 (1 + ((wM₁' : L) - 1)) hwM₁'_1ne = wM₁' := Units.ext hwM₁'_1add
  have hψ_wM₁' : ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)) = 1 := by
    have h := (hcνM₁'_stat ((wM₁' : L) - 1) hwM₁'_b hwM₁'_1ne).symm
    rw [hmk_wM₁', hνM₁'_w, Units.val_one] at h
    exact h
  have hCO := (hCommonOrigin α C htE' htM₁').2 C' htE'' htM₁''
  dsimp only at hCO
  rw [hC'C_inv, hmk_trE', hmk_trM₁'] at hCO
  change (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) *
      (νE' wE' : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
    (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) *
      (νM₁' wM₁' : Ω F)⁻¹ * ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)) at hCO
  rw [← hstat_uE', inv_mul_cancel₀ (Units.ne_zero (θE' uE')), one_mul,
    hνM₁'_w, hψ_wM₁', Units.val_one, inv_one, mul_one, mul_one] at hCO
  have hnorm_zE : normLM F hLE' z_E = (δ_L : L) * r ^ 2 := by
    change normLM F hLE' (((ϖ_E' ^ e : E'ˣ) : E') * IntermediateField.inclusion hLE' r) =
      (((ϖ_L ^ e : Lˣ) : L)) * r ^ 2
    rw [map_mul, hnormLE'_incl r]
    congr 1
    have h1 : normLM F hLE' ((ϖ_E' ^ e : E'ˣ) : E') =
        ((Units.map (normLM F hLE') (ϖ_E' ^ e) : Lˣ) : L) := rfl
    rw [h1, map_pow, hϖ_norm]
  have hwE'_sub1 : (wE' : L) - 1 = traceLM F hLE' z_E + (δ_L : L) * r ^ 2 := by
    change normLM F hLE' (1 + z_E) - 1 = _
    rw [hnormLE'_1add z_E, hnorm_zE]
  let η_L : L := ((wE' : L) - 1) - (δ_L : L) * s
  have hη_eq : η_L = traceLM F hLE' z_E - (δ_L : L) * (s - r ^ 2) := by
    dsimp [η_L]
    rw [hwE'_sub1]
    ring
  have htr_zE_b : traceLM F hLE' z_E = 0 ∨ (e : ℤ) + 1 ≤ valL F L (traceLM F hLE' z_E) := by
    apply htr_LE' ((e : ℤ) + 1) z_E
    rcases hz_E_b with h0 | hge
    · exact Or.inl h0
    · right; rw [hT2_eq]; push_cast; omega
  have hδ_sr_b : (δ_L : L) * (s - r ^ 2) = 0 ∨
      (e : ℤ) + 1 ≤ valL F L ((δ_L : L) * (s - r ^ 2)) :=
    (hL_mul_b (e : ℤ) 1 (δ_L : L) (s - r ^ 2) hδ_b hsr).imp id (fun h => by omega)
  have hη_b : η_L = 0 ∨ (e : ℤ) + 1 ≤ valL F L η_L := by
    rw [hη_eq]
    exact hL_sub_b ((e : ℤ) + 1) _ _ htr_zE_b hδ_sr_b
  let u_s : Lˣ := Units.mk0 (1 + (δ_L : L) * s) hs_L
  let q_L : Lˣ := wE' * u_s⁻¹
  let u_diff : L := (q_L : L) - 1
  have hus_mem : u_s ∈ unitGroup F L 1 := by
    rw [hvalL_props.2.2.2.2.2.2.2.2.2.1 1 le_rfl u_s]
    have hsub : (u_s : L) - 1 = (δ_L : L) * s := add_sub_cancel_left 1 ((δ_L : L) * s)
    rw [hsub]
    rcases hδs_b with h0 | hge
    · left; change 1 + (δ_L : L) * s = 1; rw [h0, add_zero]
    · right; omega
  have hus_inv_b : ((u_s⁻¹ : Lˣ) : L) = 0 ∨ 0 ≤ valL F L ((u_s⁻¹ : Lˣ) : L) := by
    right
    rw [hvalL_props.2.2.2.2.2.1 u_s, hvalL_props.2.2.2.2.2.2.2.2.2.2 1 u_s hus_mem]
    omega
  have hus_inv_mul : (1 + (δ_L : L) * s) * ((u_s⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_s
  have hu_diff_eq : u_diff = η_L * ((u_s⁻¹ : Lˣ) : L) := by
    change (wE' : L) * ((u_s⁻¹ : Lˣ) : L) - 1 = ((wE' : L) - 1 - (δ_L : L) * s) * ((u_s⁻¹ : Lˣ) : L)
    linear_combination hus_inv_mul
  have hη_sub_udiff : η_L - u_diff = η_L * ((δ_L : L) * s) * ((u_s⁻¹ : Lˣ) : L) := by
    rw [hu_diff_eq]
    linear_combination -η_L * hus_inv_mul
  have hu_diff_b : u_diff = 0 ∨ (e : ℤ) + 1 ≤ valL F L u_diff := by
    rw [hu_diff_eq]
    exact (hL_mul_b _ _ _ _ hη_b hus_inv_b).imp id (fun h => by omega)
  have hη_udiff_b : η_L - u_diff = 0 ∨ 2 * (e : ℤ) + 1 ≤ valL F L (η_L - u_diff) := by
    rw [hη_sub_udiff]
    have h1 := hL_mul_b _ _ _ _ hη_b hδs_b
    exact (hL_mul_b _ _ _ _ h1 hus_inv_b).imp id (fun h => by omega)
  have hu_diff_1add : 1 + u_diff = (q_L : L) := add_sub_cancel 1 (q_L : L)
  have hu_diff_1ne : 1 + u_diff ≠ 0 := by rw [hu_diff_1add]; exact Units.ne_zero q_L
  have hmk_qL : Units.mk0 (1 + u_diff) hu_diff_1ne = q_L := Units.ext hu_diff_1add
  have hstat_qL : (νE' q_L : Ω F) = ψ (((cνE'⁻¹ : Lˣ) : L) * u_diff) := by
    have hu_diff_cond : u_diff = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u_diff := by
      rw [hT2_half]
      exact hu_diff_b
    have h := hcνE'_stat u_diff hu_diff_cond hu_diff_1ne
    rwa [hmk_qL] at h
  have hψ_rem_L : ψ (((cνE'⁻¹ : Lˣ) : L) * (η_L - u_diff)) = 1 := by
    have hcνE'_inv_b : ((cνE'⁻¹ : Lˣ) : L) = 0 ∨
        -(2 * (e : ℤ) + 1 + condExpChar F L ψ) ≤ valL F L ((cνE'⁻¹ : Lˣ) : L) := by
      right; rw [hvalL_props.2.2.2.2.2.1 cνE', hcνE'_val, hT2_eq]; push_cast; omega
    rcases hL_mul_b _ _ _ _ hcνE'_inv_b hη_udiff_b with h0 | hge
    · exact hSpecL _ (Or.inl h0)
    · exact hSpecL _ (Or.inr (by omega))
  have hψ_wE'_split : ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
      ψ (((cνE'⁻¹ : Lˣ) : L) * (δ_L : L) * s) * (νE' q_L : Ω F) := by
    have hsplit : ((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1) =
        (((cνE'⁻¹ : Lˣ) : L) * (δ_L : L) * s + ((cνE'⁻¹ : Lˣ) : L) * u_diff) +
          ((cνE'⁻¹ : Lˣ) : L) * (η_L - u_diff) := by
      dsimp [η_L]
      ring
    rw [hsplit, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, hψ_rem_L, mul_one, ← hstat_qL]
  have hwE'_eq_qL : wE' = q_L * u_s := (inv_mul_cancel_right wE' u_s).symm
  have hLHS_eq : (νE' wE' : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
      (νE' u_s : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * (δ_L : L) * s) := by
    have hν_mul : (νE' wE' : Ω F) = (νE' q_L : Ω F) * (νE' u_s : Ω F) := by
      rw [hwE'_eq_qL, map_mul, Units.val_mul]
    rw [hν_mul, mul_inv, hψ_wE'_split]
    have hq_inv : (νE' q_L : Ω F)⁻¹ * (νE' q_L : Ω F) = 1 :=
      inv_mul_cancel₀ (Units.ne_zero (νE' q_L))
    linear_combination (νE' u_s : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * (δ_L : L) * s) * hq_inv
  let u_sM : M₁'ˣ := Units.mk0 (1 + (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s) hs_M
  let q_M : M₁'ˣ := uM₁' * u_sM⁻¹
  let z_diff : M₁' := (q_M : M₁') - 1
  have husM_eq : u_sM = Units.map (IntermediateField.inclusion hLM₁').toMonoidHom u_s := by
    apply Units.ext
    change 1 + (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s =
      IntermediateField.inclusion hLM₁' (1 + (δ_L : L) * s)
    rw [map_add, map_one, ← hδs_M_eq]
  have hqM_eq : q_M = Units.map (IntermediateField.inclusion hLM₁').toMonoidHom q_L := by
    change uM₁' * u_sM⁻¹ =
      Units.map (IntermediateField.inclusion hLM₁').toMonoidHom (wE' * u_s⁻¹)
    rw [huM₁'_eq, husM_eq, ← map_inv, ← map_mul]
  have hz_diff_eq : z_diff = IntermediateField.inclusion hLM₁' u_diff := by
    have hqM_coe : (q_M : M₁') = IntermediateField.inclusion hLM₁' (q_L : L) := by
      rw [hqM_eq]; rfl
    change (q_M : M₁') - 1 = IntermediateField.inclusion hLM₁' ((q_L : L) - 1)
    rw [hqM_coe, map_sub, map_one]
  have hz_diff_b : z_diff = 0 ∨ (((m₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z_diff := by
    rw [hm₁_half, hz_diff_eq]
    rcases hu_diff_b with h0 | hge
    · left; rw [h0, map_zero]
    · right; rw [hval_LM₁']; omega
  have hz_diff_1add : 1 + z_diff = (q_M : M₁') := add_sub_cancel 1 (q_M : M₁')
  have hz_diff_1ne : 1 + z_diff ≠ 0 := by rw [hz_diff_1add]; exact Units.ne_zero q_M
  have hmk_qM : Units.mk0 (1 + z_diff) hz_diff_1ne = q_M := Units.ext hz_diff_1add
  have hstat_qM : (θM₁' q_M : Ω F) = ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z_diff) := by
    have h := hcM₁'_stat z_diff hz_diff_b hz_diff_1ne
    rwa [hmk_qM] at h
  have hηM_udiff_b : IntermediateField.inclusion hLM₁' (η_L - u_diff) = 0 ∨
      (m₁ : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (η_L - u_diff)) := by
    rcases hη_udiff_b with h0 | hge
    · left; rw [h0, map_zero]
    · right; rw [hval_LM₁', hm₁_eq]; push_cast; omega
  have hψ_rem_M₁' : ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') *
      IntermediateField.inclusion hLM₁' (η_L - u_diff)) = 1 := by
    have hcM₁'_inv_b : ((cM₁'⁻¹ : M₁'ˣ) : M₁') = 0 ∨
        -((m₁ : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ)) ≤
          valL F M₁' ((cM₁'⁻¹ : M₁'ˣ) : M₁') := by
      right; rw [hvalM₁'_props.2.2.2.2.2.1 cM₁', hcM₁'_val]
    rcases hM₁'_mul_b _ _ _ _ hcM₁'_inv_b hηM_udiff_b with h0 | hge
    · exact hSpecM₁' _ (Or.inl h0)
    · exact hSpecM₁' _ (Or.inr (by omega))
  have hψ_uM₁'_split : ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) =
      ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s) *
        (θM₁' q_M : Ω F) := by
    have huM₁'_sub1 : (uM₁' : M₁') - 1 =
        (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s +
          IntermediateField.inclusion hLM₁' η_L := by
      have h1 : (uM₁' : M₁') - 1 = IntermediateField.inclusion hLM₁' ((wE' : L) - 1) := by
        have hc : (uM₁' : M₁') = IntermediateField.inclusion hLM₁' (wE' : L) := by
          rw [huM₁'_eq]; rfl
        rw [hc, map_sub, map_one]
      have h2 : (wE' : L) - 1 = (δ_L : L) * s + η_L := by dsimp [η_L]; ring
      rw [h1, h2, map_add, ← hδs_M_eq]
    have hηM_split : IntermediateField.inclusion hLM₁' (η_L - u_diff) =
        IntermediateField.inclusion hLM₁' η_L - z_diff := by
      rw [map_sub, hz_diff_eq]
    have hsplit : ((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1) =
        (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s +
          ((cM₁'⁻¹ : M₁'ˣ) : M₁') * z_diff) +
          ((cM₁'⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' (η_L - u_diff) := by
      rw [huM₁'_sub1, hηM_split]
      ring
    rw [hsplit, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, hψ_rem_M₁', mul_one, ← hstat_qM]
  have huM₁'_eq_qM : uM₁' = q_M * u_sM := (inv_mul_cancel_right uM₁' u_sM).symm
  have hRHS_eq : (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) =
      (θM₁' u_sM : Ω F)⁻¹ *
        ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s) := by
    have hθ_mul : (θM₁' uM₁' : Ω F) = (θM₁' q_M : Ω F) * (θM₁' u_sM : Ω F) := by
      rw [huM₁'_eq_qM, map_mul, Units.val_mul]
    rw [hθ_mul, mul_inv, hψ_uM₁'_split]
    have hq_inv : (θM₁' q_M : Ω F)⁻¹ * (θM₁' q_M : Ω F) = 1 :=
      inv_mul_cancel₀ (Units.ne_zero (θM₁' q_M))
    linear_combination (θM₁' u_sM : Ω F)⁻¹ *
      ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s) * hq_inv
  exact hLHS_eq.symm.trans (hCO.trans hRHS_eq)

theorem ld_ch12_wild_dyadic_odd_max_break_min_cond_cE_and_pointwise_pullback (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdegLE' : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegLM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ)
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
    (hm2_min : condExp F E' (recChar F rec E' χE') =
      condExp F L νM₁' + condExp F L νE' - 1)
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' (recChar F rec E' χE')),
      (recChar F rec E' χE') u = 1)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hCommonOrigin :
      ∀ (α : Lˣ) (C : K₁ˣ)
        (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0)
        (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0),
        let ψE' := traceChar F hLE' ψ
        let ψM₁' := traceChar F hLM₁' ψ
        let θE' := recChar F rec E' χE'
        let θM₁' := recChar F rec M₁' χM₁'
        let cE' : E'ˣ :=
          Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
            (Units.map (normLM F hE'K₁) C)⁻¹
        let cνE' : Lˣ :=
          α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹
        let cM₁' : M₁'ˣ :=
          Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
            (Units.map (normLM F hM₁'K₁) C)⁻¹
        let cνM₁' : Lˣ :=
          α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹
        (θE' cE' : Ω F) * (νE' cνE' : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L)) =
          (θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)) ∧
        ∀ (C' : K₁ˣ)
          (htE'' : traceLM F hE'K₁ (C' : K₁) ≠ 0)
          (htM₁'' : traceLM F hM₁'K₁ (C' : K₁) ≠ 0),
