    rw [IntermediateField.finrank_fixedField_eq_card N, hfin,
      ← IsGalois.card_aut_eq_finrank k E₀, ← Subgroup.card_mul_index N,
      mul_comm (Nat.card N) N.index] at hmul
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos hmul
  
  obtain ⟨hLMC_gt1, hq_gt1, _, hFinL, hFinK, hFinLK', hGalLK', _⟩ :=
    ld_ch13_14_semidirect_galois_group_structure F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hMin
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) := hFinLK'
  haveI : IsGalois L (IntermediateField.extendScalars hLK) := hGalLK'
  have hFinMC : FiniteDimensional F M_C :=
    Module.Finite.of_injective (IntermediateField.inclusion hM_CK).toLinearMap
      (IntermediateField.inclusion hM_CK).injective
  have hFinE : FiniteDimensional F E :=
    Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
      (IntermediateField.inclusion hEK).injective
  haveI : FiniteDimensional F M_C := hFinMC
  haveI : FiniteDimensional F E := hFinE
  have hGalMCK : IsGaloisExt F M_C K :=
    ((ld_galois_closure_directed_system F).2.1 L M_C K hLM_C hM_CK hGal).1
  have h_sep : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A) (hAK : A ≤ K),
      Algebra.IsSeparable L (IntermediateField.extendScalars hLA) := by
    intro A hLA hAK
    let S_A := IntermediateField.extendScalars hLA
    let K' := IntermediateField.extendScalars hLK
    haveI : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    refine ⟨fun x => ?_⟩
    have hxA : (x : AlgebraicClosure F) ∈ A := (IntermediateField.mem_extendScalars hLA).mp x.2
    let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hAK hxA)⟩
    have hmin1 : (minpoly L (S_A.val x)).Separable ↔ (minpoly L x).Separable := by
      rw [minpoly.algHom_eq S_A.val S_A.val.injective x]
    have hmin2 : (minpoly L (K'.val x_K)).Separable ↔ (minpoly L x_K).Separable := by
      rw [minpoly.algHom_eq K'.val K'.val.injective x_K]
    exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable L x_K))
  have hSepLMC : Algebra.IsSeparable L (IntermediateField.extendScalars hLM_C) :=
