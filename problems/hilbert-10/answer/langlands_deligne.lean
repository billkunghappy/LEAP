theorem ld_ch12_sml_wild_odd_prime_fourth_pow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    [FiniteDimensional F M₁] [FiniteDimensional F K₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hGalEK₁ : IsGaloisExt F E K₁) (hGalM₁K₁ : IsGaloisExt F M₁ K₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hAbEK₁ : IsAbelianExt F hEK₁) (hAbM₁K₁ : IsAbelianExt F hM₁K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE) = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_inf : E ⊓ M₁ = L) (h_sup : E ⊔ M₁ = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (χM₁ : relWeil F M₁ →* (Ω F)ˣ) (hχM₁_weil : IsWeilRep F M₁ (charRep F M₁ χM₁))
    (hχM₁_rest : restrictWeilChar F hM₁K₁ χM₁ = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψM₁ : IsAdmissibleChar F M₁ (traceChar F hLM₁ ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE.trans hEK₁) ψ))
    (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1)
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1)
    (hνM₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    let ψE := traceChar F hLE ψ
    let ψM₁ := traceChar F hLM₁ ψ
    let χE' := recChar F rec E χE
    let χM₁' := recChar F rec M₁ χM₁
    (tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ)) ^ 4 =
      (tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ)) ^ 4 :=
by
  apply ld_ch12_wild_odd_min_cond_subfield_and_norm_pow_reduction F rec L E M₁ K₁
    hLE hLM₁ hEK₁ hM₁K₁ hGalLK₁ hGalLE hGalLM₁ hGalEK₁ hGalM₁K₁
    hAbLE hAbLM₁ hAbEK₁ hAbM₁K₁ hPrime hWild hp_odd
    hdegM₁ hdegEK₁ hdegM₁K₁ h_inf h_sup
    χK₁ hInvK₁ hneK₁ χE hχE_weil hχE_rest χM₁ hχM₁_weil hχM₁_rest
    ψ hψ hψE hψM₁ hψK₁ νE νM₁
    hνE_pow hνE_ne hνE_ker hνE_cond hνM₁_pow hνM₁_ne hνM₁_ker hνM₁_cond
  intro E' M₁' _ _ hLE' hLM₁' hE'K₁ hM₁'K₁
    hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
    hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁
    hdegE' hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf' h_sup'
    χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
    hψE' hψM₁' νE' νM₁'
    hνE'_pow hνE'_ne hνE'_ker hνE'_cond
    hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
    hνM₁'E'_cond hνE'M₁'_cond
    hbE'_ge2 hCondM₁' hMinM₁' hMinE'
    hNormFactor hχE'_comp hχM₁'_comp hχK₁_cond
    hmE'_ge2 hξE'_props hmM₁'_ge2 hξM₁'_props hCommonRest
  have hPrime' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')) :=
    hdegE'.symm ▸ hPrime
  have hWild' : Module.finrank L (IntermediateField.extendScalars hLE') = p F :=
    hdegE'.trans hWild
  have hdegM₁'' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdegM₁'.trans hdegE'.symm
  have hdegE'K₁' : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdegE'K₁.trans hdegE'.symm
  have hdegM₁'K₁' : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdegM₁'K₁.trans hdegE'.symm
  have hneK₁' : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁ :=
    hneK₁
  have hψK₁' : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ) := hψK₁
  rw [← hdegE'] at hνE'_pow hνE'_cond hνM₁'_pow hνM₁'_cond hνM₁'E'_cond hνE'M₁'_cond
  rw [← hdegE'] at hMinM₁' hMinE' hξE'_props hξM₁'_props ⊢
  rcases hCondM₁' with hUnramM₁' | hbM₁'_ge2
  · exact ld_ch12_wild_odd_unramified_subfield_branch_fourth_pow F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime' hWild' hp_odd
      hdegM₁'' hdegE'K₁' hdegM₁'K₁' h_inf' h_sup'
      χK₁ hInvK₁ hneK₁' χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
      ψ hψ hψE' hψM₁' hψK₁' νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hνM₁'E'_cond hνE'M₁'_cond hbE'_ge2 hUnramM₁' hMinM₁' hMinE'
      hNormFactor hχE'_comp hχM₁'_comp hχK₁_cond
      hmE'_ge2 hξE'_props hmM₁'_ge2 hξM₁'_props hCommonRest
      (fun M _ ψ_M hψM θ hm hθ_cond =>
        ld_ch12_wild_odd_single_field_fourth_pow_lamprecht F hp_odd M ψ_M hψM θ hm hθ_cond)
  · exact ld_ch12_wild_odd_totally_ramified_subfields_fourth_pow F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime' hWild' hp_odd
      hdegM₁'' hdegE'K₁' hdegM₁'K₁' h_inf' h_sup'
      χK₁ hInvK₁ hneK₁' χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
      ψ hψ hψE' hψM₁' hψK₁' νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hνM₁'E'_cond hνE'M₁'_cond hbE'_ge2 hbM₁'_ge2 hMinM₁' hMinE'
      hNormFactor hχE'_comp hχM₁'_comp hχK₁_cond
      hmE'_ge2 hξE'_props hmM₁'_ge2 hξM₁'_props hCommonRest
      (fun M _ ψ_M hψM θ hm hθ_cond =>
        ld_ch12_wild_odd_single_field_fourth_pow_lamprecht F hp_odd M ψ_M hψM θ hm hθ_cond)

theorem ld_ch12_wild_dyadic_single_ext_cond_and_range_two_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L A : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F A]
    (hLA : L ≤ A) (hGalLA : IsGaloisExt F L A) (hAbLA : IsAbelianExt F hLA)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLA)))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLA) = p F)
    (hp2 : p F = 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νA : Lˣ →* (Ω F)ˣ)
    (hνA_pow : νA ^ (Module.finrank L (IntermediateField.extendScalars hLA)) = 1)
    (hνA_ne : νA ≠ 1)
    (hνA_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLA)) ↔ νA x = 1)
    (hνA_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLA),
      ∀ u ∈ unitGroup F L (condExp F L (νA ^ j)), (νA ^ j) u = 1) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLA)
    let ψA := traceChar F hLA ψ
    IsAdmissibleChar F A ψA ∧
    (condExp F L νA = 0 ∨ 2 ≤ condExp F L νA) ∧
    tateEps F L 1 ψ ≠ 0 ∧
    tateEps F L νA ψ ≠ 0 ∧
    tateEps F A 1 ψA ≠ 0 ∧
    (∏ j ∈ Finset.range ℓ, tateEps F L (νA ^ j) ψ) =
      tateEps F L 1 ψ * tateEps F L νA ψ ∧
    (∀ (lam_L : Lˣ →* (Ω F)ˣ),
      (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νA ^ j * lam_L)), (νA ^ j * lam_L) u = 1) →
      (∀ u ∈ unitGroup F A (condExp F A (lam_L.comp (Units.map (normLM F hLA)))),
        (lam_L.comp (Units.map (normLM F hLA))) u = 1) →
      tateEps F A (lam_L.comp (Units.map (normLM F hLA))) ψA *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νA ^ j) ψ) =
      tateEps F A 1 ψA *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νA ^ j * lam_L) ψ)) :=
by
  intro ℓ ψA
  have hψA : IsAdmissibleChar F A ψA :=
    ld_traceChar_admissible F L A hLA hAbLA.2.2 ψ hψ
  have hCondνA : condExp F L νA = 0 ∨ 2 ≤ condExp F L νA := by
    by_cases hUnram : condExp F L νA = 0
    · exact Or.inl hUnram
    · have hcond_1L : condExp F L 1 = 0 := by
        apply Nat.eq_zero_of_le_zero
        have hmem : (0 : ℕ) ∈ {a : ℕ | ∀ u ∈ unitGroup F L a, (1 : Lˣ →* (Ω F)ˣ) u = 1} :=
          fun _ _ => rfl
        exact Nat.sInf_le hmem
      have hχ'1_cond : ∀ j < ℓ,
          ∀ u ∈ unitGroup F L (condExp F L (νA ^ j * 1)), (νA ^ j * 1) u = 1 := by
        intro j hj u hu
        rw [mul_one (νA ^ j)] at hu ⊢
        exact hνA_cond j hj u hu
      have hMinCond1 : ∀ j < ℓ, condExp F L 1 ≤ condExp F L (νA ^ j * 1) := by
        intro j _
        rw [hcond_1L]
        exact Nat.zero_le _
      obtain ⟨hb_ge2, _, _, _, _, _, _, _⟩ :=
        ld_ch10_wild_ramification_and_cond_formulas F L A hLA hGalLA hAbLA hPrime ψ hψ νA 1
          hνA_pow hνA_ne hνA_ker hνA_cond hχ'1_cond (fun _ _ => rfl) hMinCond1 hUnram hWild
      exact Or.inr hb_ge2
  have hEpsL1_ne0 : tateEps F L 1 ψ ≠ 0 :=
    ld_tateEps_ne_zero F L ψ hψ 1
  have hEpsLνA_ne0 : tateEps F L νA ψ ≠ 0 :=
    ld_tateEps_ne_zero F L ψ hψ νA
  have hEpsA1_ne0 : tateEps F A 1 ψA ≠ 0 :=
    ld_tateEps_ne_zero F A ψA hψA 1
  have hℓ2 : ℓ = 2 := hWild.trans hp2
  have hProd : (∏ j ∈ Finset.range ℓ, tateEps F L (νA ^ j) ψ) =
      tateEps F L 1 ψ * tateEps F L νA ψ := by
    rw [hℓ2, Finset.prod_range_succ, Finset.prod_range_one, pow_zero νA, pow_one νA]
  refine ⟨hψA, hCondνA, hEpsL1_ne0, hEpsLνA_ne0, hEpsA1_ne0, hProd, ?_⟩
  intro lam_L h1 h2
  exact ld_ch12_unshifted_cyclic_fml F L A hLA hGalLA hAbLA hPrime ψ hψ νA lam_L
    hνA_pow hνA_ne hνA_ker hνA_cond h1 h2

theorem ld_ch12_wild_dyadic_bicyclic_diamond_rec_and_cond_package (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (μE' μM₁' : relWeil F L →* (Ω F)ˣ) (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hμE'_weil : IsWeilRep F L (charRep F L μE'))
    (hμE'_ker : ∀ w : relWeil F L, (w : AbsGal F) ∈ E'.fixingSubgroup ↔ μE' w = 1)
    (hμE'_pow : μE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_rec : ∀ x : Lˣ, νE' x = μE' (rec.recMap L x))
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hCondE' : condExp F L νE' = 0 ∨ 2 ≤ condExp F L νE')
    (hμM₁'_weil : IsWeilRep F L (charRep F L μM₁'))
    (hμM₁'_ker : ∀ w : relWeil F L, (w : AbsGal F) ∈ M₁'.fixingSubgroup ↔ μM₁' w = 1)
    (hμM₁'_pow : μM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_rec : ∀ x : Lˣ, νM₁' x = μM₁' (rec.recMap L x))
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hCondM₁' : condExp F L νM₁' = 0 ∨ 2 ≤ condExp F L νM₁')
    (hMinLe : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE')) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1) ∧
    (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1) ∧
    2 ≤ condExp F L νE' ∧
    (∀ j < ℓ,
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE') ∧
    (∀ j < ℓ,
