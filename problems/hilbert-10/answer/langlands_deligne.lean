          exact_mod_cast Nat.mul_le_mul_right d₁ hr3
        exact hvalK₁_mono hrd1 h
      exact hvalL_mono (by omega)
        (hvalL_mul_ge 0 (bE' : ℤ) (c_fn r) (g_fn (v ^ r)) (hc_fn_val r hr_mem)
          (hg_deep3 (v ^ r) hvr_3d1))
    have hmaster_id :
        (Δ_quad z + Δ_quad v) - 2 * (g_fn z + h_fn z) =
          (Δ_quad z - (2 * (g_fn z + h_fn z) - (g_fn (z ^ 2) + h_fn (z ^ 2)) - M_mix z +
            ∑ r ∈ Finset.Icc 3 (p - 1), c_fn r * g_fn (z ^ r))) +
          (Δ_quad v - (2 * (g_fn v + h_fn v) - (g_fn (v ^ 2) + h_fn (v ^ 2)) - M_mix v +
            ∑ r ∈ Finset.Icc 3 (p - 1), c_fn r * g_fn (v ^ r))) +
          (2 * h_fn v - h_fn (z ^ 2)) -
          (g_fn (v ^ 2) + h_fn (v ^ 2)) -
          (M_mix z + M_mix v) +
          ((∑ r ∈ Finset.Icc 3 (p - 1), c_fn r * g_fn (z ^ r)) +
            (∑ r ∈ Finset.Icc 3 (p - 1), c_fn r * g_fn (v ^ r))) := by
      rw [← h2gv]
      ring
    rw [hmaster_id]
    have ha1 := hvalL_add (bE' : ℤ) _ _ hexp_z hexp_v
    have ha2 := hvalL_add (bE' : ℤ) _ _ ha1 h2hv_sub
    have ha3 := hvalL_sub_ge (bE' : ℤ) _ _ ha2 (hvalL_add (bE' : ℤ) _ _ hgv2 hhv2)
    have ha4 := hvalL_sub_ge (bE' : ℤ) _ _ ha3 (hvalL_add (bE' : ℤ) _ _ hMmix_z hMmix_v)
    exact hvalL_add (bE' : ℤ) _ _ ha4 (hvalL_add (bE' : ℤ) _ _ hgz_sum hgv_sum)

theorem ld_ch12_wild_odd_totally_ramified_half_cond_master_identity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (bE' bM₁' : ℕ) (hbE'_eq : condExp F L νE' = bE') (hbM₁'_eq : condExp F L νM₁' = bM₁')
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let d₁ := m₁ / 2
    let d₂ := m₂ / 2
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let u₁_fn := fun w : K₁ => normLM F hM₁'K₁ (1 + w) - 1
    let u₂_fn := fun w : K₁ => normLM F hE'K₁ (1 + w) - 1
    let Δ_quad := fun w : K₁ =>
      traceLM F hLM₁' (b * (2 * u₁_fn w - (u₁_fn w) ^ 2)) -
        traceLM F hLE' (a * (2 * u₂_fn w - (u₂_fn w) ^ 2))
    let g_fn := fun z : K₁ =>
      traceLM F hLM₁' (b * traceLM F hM₁'K₁ z) -
        traceLM F hLE' (a * traceLM F hE'K₁ z)
    let h_fn := fun z : K₁ =>
      traceLM F hLM₁' (b * normLM F hM₁'K₁ z) -
        traceLM F hLE' (a * normLM F hE'K₁ z)
    (∀ w : K₁, (w = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w) →
      (u₁_fn w = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' (u₁_fn w)) ∧
      (u₂_fn w = 0 ∨ (d₂ : ℤ) ≤ valL F E' (u₂_fn w))) ∧
    (∀ w : K₁, (w = 0 ∨ (3 * (d₁ : ℤ)) ≤ valL F K₁ w) →
      Δ_quad w = 0 ∨ (bE' : ℤ) ≤ valL F L (Δ_quad w)) ∧
    (∀ w₁ w₂ : K₁,
      (w₁ = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w₁) →
      (w₂ = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w₂) →
      let w₁₂ := (1 + w₁) * (1 + w₂) - 1
      (w₁₂ = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w₁₂) ∧
      (Δ_quad w₁₂ - (Δ_quad w₁ + Δ_quad w₂) = 0 ∨
        (bE' : ℤ) ≤ valL F L (Δ_quad w₁₂ - (Δ_quad w₁ + Δ_quad w₂)))) ∧
    (∀ (d : ℕ), d₁ ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      ∃ (x : Fin p → E') (w' : K₁),
        (∀ j : Fin p,
          (x j = 0 ∨ (d : ℤ) ≤ (p : ℤ) * valL F E' (x j) - (j : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) ∧
          (IntermediateField.inclusion hE'K₁ (x j) * ((Δ : K₁) ^ (j : ℕ)) = 0 ∨
            (d : ℤ) ≤
              valL F K₁ (IntermediateField.inclusion hE'K₁ (x j) * ((Δ : K₁) ^ (j : ℕ))))) ∧
        (w' = 0 ∨ (2 * (d : ℤ)) ≤ valL F K₁ w') ∧
        (Δ_quad w -
            ((∑ j : Fin p,
              Δ_quad (IntermediateField.inclusion hE'K₁ (x j) * ((Δ : K₁) ^ (j : ℕ)))) +
              Δ_quad w') = 0 ∨
          (bE' : ℤ) ≤
            valL F L
              (Δ_quad w -
                ((∑ j : Fin p,
                  Δ_quad (IntermediateField.inclusion hE'K₁ (x j) * ((Δ : K₁) ^ (j : ℕ)))) +
                  Δ_quad w')))) ∧
    ((∀ w₀ : K₁, (w₀ = 0 ∨ (3 * (d₁ : ℤ)) ≤ valL F K₁ w₀) →
        g_fn w₀ = 0 ∨ (bE' : ℤ) ≤ valL F L (g_fn w₀)) →
      ∀ (d : ℕ), d₁ ≤ d → ∀ z : K₁, (z = 0 ∨ (d : ℤ) ≤ valL F K₁ z) →
        ∃ v : K₁,
          (v = 0 ∨ (2 * (d : ℤ)) ≤ valL F K₁ v) ∧
          ((Δ_quad z + Δ_quad v) - 2 * (g_fn z + h_fn z) = 0 ∨
            (bE' : ℤ) ≤ valL F L ((Δ_quad z + Δ_quad v) - 2 * (g_fn z + h_fn z)))) :=
by
  intro p m₁ m₂ d₁ d₂ a b u₁_fn u₂_fn Δ_quad g_fn h_fn
  have hp_odd' : p ≠ 2 := by
    rw [show p = EllipticRootNumber.p F from hWild]
    exact hp_odd
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := hPrime.pos
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  have hPrime_M₁'K₁ : Nat.Prime (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) := by
    rw [hdegM₁'K₁]; exact hPrime
  have hp_odd_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) ≠ 2 := by
    rw [hdegM₁'K₁]; exact hp_odd'
  have hval_M₁'K₁' : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) * valL F M₁' z := by
    intro z; rw [hdegM₁'K₁]; exact hval_M₁'K₁ z
  let T₁ : ℕ := (bM₁' - 1) + p * (bE' - bM₁') + 1
  have hT₁_ge2 : 2 ≤ T₁ := by dsimp [T₁]; omega
  have hT₁_ge1 : 1 ≤ T₁ := by omega
  have htr_M₁'K₁' : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) * m -
          ((Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) - 1 : ℕ) : ℤ) *
            (T₁ : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)) := by
    intro m w hw; rw [hdegM₁'K₁] at hw; exact htr_M₁'K₁ m w hw
  have hPrime_E'K₁ : Nat.Prime (Module.finrank E' (IntermediateField.extendScalars hE'K₁)) := by
    rw [hdegE'K₁]; exact hPrime
  have hp_odd_E'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) ≠ 2 := by
    rw [hdegE'K₁]; exact hp_odd'
  have hval_E'K₁' : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * valL F E' y := by
    intro y; rw [hdegE'K₁]; exact hval_E'K₁ y
  have htr_E'K₁' : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * m -
          ((Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)) := by
    intro m w hw; rw [hdegE'K₁] at hw; exact htr_E'K₁ m w hw
  obtain ⟨s₁, hs₁_1, hs₁_2, hs₁_val', hs₁_norm_one_add, hs₁_cayley', hs₁_newton1⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F M₁' K₁ hM₁'K₁ hGalM₁'K₁
      hPrime_M₁'K₁ hp_odd_M₁'K₁ hvalM₁'_props hvalK₁_props hval_M₁'K₁' hval_norm_M₁'K₁
      T₁ hT₁_ge1 htr_M₁'K₁'
      (fun t htr G _ _ act => ld_wild_odd_free_orbit_symm_functions F M₁' K₁ hM₁'K₁
        hPrime_M₁'K₁ hp_odd_M₁'K₁ hvalK₁_props t htr G act)
      (fun G _ _ act s hcard_G hact_one hact_ring hact_incl hact_norm hs_poly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F M₁' K₁ hM₁'K₁
          hPrime_M₁'K₁ hp_odd_M₁'K₁ hvalM₁'_props hvalK₁_props hval_M₁'K₁' G act
          hcard_G hact_one hact_ring hact_incl hact_norm s hs_poly)
  obtain ⟨s₂, hs₂_1, hs₂_2, hs₂_val', hs₂_norm_one_add, hs₂_cayley', hs₂_newton1⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F E' K₁ hE'K₁ hGalE'K₁
      hPrime_E'K₁ hp_odd_E'K₁ hvalE'_props hvalK₁_props hval_E'K₁' hval_norm_E'K₁
      bM₁' (by omega) htr_E'K₁'
      (fun t htr G _ _ act => ld_wild_odd_free_orbit_symm_functions F E' K₁ hE'K₁
        hPrime_E'K₁ hp_odd_E'K₁ hvalK₁_props t htr G act)
      (fun G _ _ act s hcard_G hact_one hact_ring hact_incl hact_norm hs_poly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F E' K₁ hE'K₁
          hPrime_E'K₁ hp_odd_E'K₁ hvalE'_props hvalK₁_props hval_E'K₁' G act
          hcard_G hact_one hact_ring hact_incl hact_norm s hs_poly)
  obtain ⟨s_LE', _, _, hsLE'_val, _, hsLE'_cayley, _⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F L E' hLE' hGalLE'
      hPrime hp_odd' hvalL_props hvalE'_props hval_LE' hval_norm_LE'
      bE' (by omega) htr_LE'
      (fun t htr G _ _ act => ld_wild_odd_free_orbit_symm_functions F L E' hLE'
        hPrime hp_odd' hvalE'_props t htr G act)
      (fun G _ _ act s hcard_G hact_one hact_ring hact_incl hact_norm hs_poly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F L E' hLE'
          hPrime hp_odd' hvalL_props hvalE'_props hval_LE' G act
          hcard_G hact_one hact_ring hact_incl hact_norm s hs_poly)
  have hd₁_pos : 1 ≤ d₁ := by dsimp [d₁, m₁]; omega
  have hd₂_pos : 1 ≤ d₂ := by dsimp [d₂, m₂]; omega
  have hd₂_le_d₁ : d₂ ≤ d₁ := by
    have hmul : bE' - bM₁' ≤ p * (bE' - bM₁') := Nat.le_mul_of_pos_left _ hp_pos
    dsimp [d₁, d₂, m₁, m₂]; omega
  have hm₁_le_3d₁ : m₁ ≤ 3 * d₁ := by dsimp [d₁, m₁]; omega
  have hm₂_le_3d₂ : m₂ ≤ 3 * d₂ := by dsimp [d₂, m₂]; omega
  have hd₁_le_T₁ : d₁ ≤ T₁ := by dsimp [d₁, m₁, T₁]; omega
  have hv1_ge_d₁_M₁' :
      (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) * (d₁ : ℤ) -
        ((Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) - 1 : ℕ) : ℤ) * (T₁ : ℤ) ≤
          (d₁ : ℤ) := by
    rw [hdegM₁'K₁]
    change (p : ℤ) * (d₁ : ℤ) - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ) ≤ (d₁ : ℤ)
    have hle : (d₁ : ℤ) ≤ (T₁ : ℤ) := by exact_mod_cast hd₁_le_T₁
    have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    nlinarith
  have hv12_ge_M_M₁' :
      let pM := Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)
      let v1 := (1 * d₁ + (pM - 1) * T₁) / pM
      let v2 := (2 * d₁ + (pM - 1) * T₁) / pM
      m₁ ≤ v1 + v2 ∧ m₁ ≤ v2 + d₁ := by
    dsimp only
    rw [hdegM₁'K₁]
    change m₁ ≤ (1 * d₁ + (p - 1) * T₁) / p + (2 * d₁ + (p - 1) * T₁) / p ∧
      m₁ ≤ (2 * d₁ + (p - 1) * T₁) / p + d₁
    have hd₁_le_v1 : d₁ ≤ (1 * d₁ + (p - 1) * T₁) / p := by
      rw [Nat.le_div_iff_mul_le hp_pos]
      have hp1 : 1 + (p - 1) = p := by omega
      nlinarith
    have hm₁_sub_le_v2 : m₁ - d₁ ≤ (2 * d₁ + (p - 1) * T₁) / p := by
      rw [Nat.le_div_iff_mul_le hp_pos]
      have hm₁_sub_le_T₁ : m₁ - d₁ ≤ T₁ := by dsimp [d₁, m₁, T₁]; omega
      have hm₁_sub_le_2d₁ : m₁ - d₁ ≤ 2 * d₁ := by dsimp [d₁, m₁]; omega
      have hp1 : 1 + (p - 1) = p := by omega
      nlinarith
    have hd₁_le_m₁ : d₁ ≤ m₁ := by dsimp [d₁]; omega
    exact ⟨by omega, by omega⟩
  have hv1_ge_d₂_E' :
      (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * (d₂ : ℤ) -
        ((Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤
          (d₁ : ℤ) := by
    rw [hdegE'K₁]
    change (p : ℤ) * (d₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ (d₁ : ℤ)
    let t₁ := bM₁' - 1
    let δ := bE' - bM₁'
    let q := p - 3
    have h2d₂ : 2 * d₂ ≤ 2 * t₁ + 1 + δ := by dsimp [d₂, m₂, t₁, δ]; omega
    have h2d₁ : 2 * t₁ + p * δ ≤ 2 * d₁ := by dsimp [d₁, m₁, t₁, δ]; omega
    have hp_eq : p = q + 3 := by dsimp [q]; omega
    have hp1_eq : p - 1 = q + 2 := by dsimp [q]; omega
    have hb_eq : bM₁' = t₁ + 1 := by dsimp [t₁]; omega
    have hnat : p * d₂ ≤ d₁ + (p - 1) * bM₁' := by nlinarith
    have hcast : ((p * d₂ : ℕ) : ℤ) ≤ ((d₁ + (p - 1) * bM₁' : ℕ) : ℤ) := by
      exact_mod_cast hnat
    push_cast at hcast
    linarith
  have hv12_ge_M_E' :
      let pE := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
      let v1 := (1 * d₁ + (pE - 1) * bM₁') / pE
      let v2 := (2 * d₁ + (pE - 1) * bM₁') / pE
      m₂ ≤ v1 + v2 ∧ m₂ ≤ v2 + d₁ := by
    dsimp only
    rw [hdegE'K₁]
    change m₂ ≤ (1 * d₁ + (p - 1) * bM₁') / p + (2 * d₁ + (p - 1) * bM₁') / p ∧
      m₂ ≤ (2 * d₁ + (p - 1) * bM₁') / p + d₁
    have hbM₁'_sub_le_d₁ : bM₁' - 1 ≤ d₁ := by dsimp [d₁, m₁]; omega
    have hbM₁'_sub_le_v1 : bM₁' - 1 ≤ (1 * d₁ + (p - 1) * bM₁') / p := by
      rw [Nat.le_div_iff_mul_le hp_pos]
