  have hPrimeEL' : Nat.Prime (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) := by
    rw [hFinEL'E₁_eq]
    exact hq₀_prime
  have hFinE'EL' : Module.finrank E (IntermediateField.extendScalars hEE') =
      Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁) :=
    hFinEE'_eq.trans hFinEL'E₁_eq.symm
  have hFinEEL'_LL' : Module.finrank E (IntermediateField.extendScalars hEE_L') =
      Module.finrank L (IntermediateField.extendScalars hLL') :=
    hFinEEL'_eq.trans hFinLL'_eq.symm
  obtain ⟨_, _, _, ℓ, D_tame, hPrime_ℓ, hℓ_dvd, hDtame_sub, hDtame_deg, hDtame_props_raw, hTame_branch, _⟩ :=
    ld_ch13_14_canonical_orbit_decomp_and_structure F L M₁ L' F' (hLL'.trans hL'M₁) hLL' hL'M₁
      hLF' hF'M₁ hF'L'_inf hF'L'_sup hLL'_lt hCore_M₁ hGalLM₁ hMinLM₁
  obtain ⟨_, _, _, hField_L'⟩ := hTame_branch hTameL'
  have hℓ_eq : ℓ = Module.finrank L' (IntermediateField.extendScalars hL'M₁) :=
    (Nat.dvd_prime hPrimeL').mp hℓ_dvd |>.resolve_left hPrime_ℓ.ne_one
  have hDtame_props : ∀ t ∈ D_tame,
      t.coeff = 1 ∧
      t.field = L' ∧
      t.χ ^ (Module.finrank L' (IntermediateField.extendScalars hL'M₁)) = 1 ∧
      (∃ htK : t.field ≤ M₁, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ F' ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ L', restrictWeilChar F htM t.χ ≠ 1) := by
    intro t ht
    obtain ⟨hc, _, _, hpow, hK, hE, hM⟩ := hDtame_props_raw t ht
    exact ⟨hc, hField_L' t ht, hℓ_eq ▸ hpow, hK, hE, hM⟩
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, hr_pos, hr_mul_finrank, μ_orb, hμ_props, hμ_trace, hμ_eval_un, hμ_eval_tw⟩ :=
    ld_ch13_tame_monomial_orbit_to_weil_chars F rec L M₁ L' F' (hLL'.trans hL'M₁) hLL' hL'M₁
      hLF' hF'M₁ hLL'_lt hGalLM₁ ψ hψ hPrimeL' χL_ext D_tame hDtame_sub hDtame_deg hDtame_props
  have hr_mul : D_tame.length * Module.finrank L (IntermediateField.extendScalars hLL') = q₀ - 1 := by
    rw [← hFinL'M₁_eq]
    exact hr_mul_finrank
  have hr_idx : D_tame.length * H_L'.index = q₀ - 1 := by
    rw [← hFinLL'_eq]
    exact hr_mul
  have hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE) := by
    let S_E := IntermediateField.extendScalars hLE
    let K' := IntermediateField.extendScalars hLK
    haveI : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    refine ⟨fun x => ?_⟩
    have hxE : (x : AlgebraicClosure F) ∈ E := (IntermediateField.mem_extendScalars hLE).mp x.2
    let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hEK hxE)⟩
    have hmin1 : (minpoly L (S_E.val x)).Separable ↔ (minpoly L x).Separable := by
      rw [minpoly.algHom_eq S_E.val S_E.val.injective x]
    have hmin2 : (minpoly L (K'.val x_K)).Separable ↔ (minpoly L x_K).Separable := by
      rw [minpoly.algHom_eq K'.val K'.val.injective x_K]
    exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable L x_K))
  have htr_LE := ((ld_tateEps_char_and_traceChar F rec).1 L E hLE hSepLE).2 ψ hψ
  have htr_self_L : traceChar F (le_rfl : L ≤ L) ψ = ψ := htr_LE.2.1
  have htr_EE' : traceChar F hEE' (traceChar F hLE ψ) = traceChar F (hLF'.trans hF'E') ψ :=
    (htr_LE.2.2 E' hEE').symm
  have htr_EL' : traceChar F hEE_L' (traceChar F hLE ψ) = traceChar F (hLL'.trans hL'E_L') ψ :=
    (htr_LE.2.2 E_L' hEE_L').symm
  obtain ⟨D_tame_E, ν_list, hrE_eq, hν_len, hDtameE_sub, hDtameE_deg, hDtameE_props,
      hν_props, hEval_un, hEval_tw, hEvalE_un, hEvalE_tw⟩ :=
    ld_ch14_tame_subdiamond_Dtame_E_and_eval_prod F rec L K M_C E L' F' M₁ E_L' E' E₁
      hLK hLM_C hM_CK hLE hEK hLL' hL'M₁ hM₁MC hLF' hF'M₁ hEE_L' hE_L'E₁ hEE' hE'E₁
      hL'E_L' hF'E' hE_L'K hE'K hEL'_sup hEF'_sup hGal ψ htr_self_L htr_EL' χL_ext
      q₀ hq₀_prime hFinL'M₁_eq hFinEL'E₁_eq hFinEEL'_LL' π C H hsurj hG_mul h_mem_H h_mem_C
      D_tame hr_mul μ_orb hμ_props hμ_trace hμ_eval_un hμ_eval_tw
  exact ⟨L', F', M₁, E_L', E', E₁, hLL', hL'M₁, hM₁MC, hLF', hF'M₁,
    hEE_L', hE_L'E₁, hEE', hE'E₁, hL'E_L', hF'E', hE_L'K, hE'K,
    D_tame, D_tame_E,
    hLL'_lt, hLF'_lt, hF'L'_inf, hF'L'_sup, hE'EL'_inf, hE'EL'_sup,
    hEEL'_lt, hEL'_sup, hEF'_sup,
    hGalLM₁, hGalEE₁, htr_EE', hMinLM₁, hMinEE₁,
    hTameL', hPrimeL', hFinF'L', hTameEL', hPrimeEL', hFinE'EL',
    hDtame_sub, hDtame_deg, hDtame_props,
    hDtameE_sub, hDtameE_deg, hDtameE_props,
    hr_pos, hrE_eq, hr_idx,
    ⟨ν_list, hν_len, hν_props, hEval_un, hEval_tw, hEvalE_un, hEvalE_tw⟩,
