      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m := by
      intro m
      refine ⟨ϖL ^ m, ?_⟩
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv, hrel_zpow ϖL m, hrel_ϖL, mul_comm]
    exact ⟨hfL_pos, hdiv, hval0, hval1, hval_mul, hval_surj⟩

  have hrelVal_norm : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B) (y : B),
      relVal F A (normLM F hAB y) = relVal F B y := by
    intro A B _ _ hAB y
    let B' := IntermediateField.extendScalars hAB
    let eF : B ≃ₐ[F] B' :=
      { toExtendScalars F hAB with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F B' := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional A B' := Module.Finite.of_restrictScalars_finite F A B'
    change addVal F (Algebra.norm F (Algebra.norm A (toExtendScalars F hAB y))) =
      addVal F (Algebra.norm F y)
    have h1 : Algebra.norm F (Algebra.norm A (toExtendScalars F hAB y)) =
        Algebra.norm F (toExtendScalars F hAB y) := Algebra.norm_norm
    have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hAB y) :=
      Algebra.norm_eq_of_algEquiv eF y
    rw [h1, ← h2]

  
  have hresDeg_le : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      resDeg F A ≤ resDeg F B := by
    intro A B _ _ hAB
    obtain ⟨hfA_pos, hdivA, _, _, _, _⟩ := hvalL_props A
    obtain ⟨hfB_pos, hdivB, _, _, _, hsurjB⟩ := hvalL_props B
    obtain ⟨c₁, hc₁⟩ := hsurjB 1
    have hdvd_int : (resDeg F A : ℤ) ∣ (resDeg F B : ℤ) := by
      refine ⟨valL F A (normLM F hAB (c₁ : B)), ?_⟩
      calc (resDeg F B : ℤ)
        _ = (resDeg F B : ℤ) * valL F B (c₁ : B) := by rw [hc₁, mul_one]
        _ = relVal F B (c₁ : B) := (hdivB (c₁ : B)).symm
        _ = relVal F A (normLM F hAB (c₁ : B)) := (hrelVal_norm A B hAB (c₁ : B)).symm
        _ = (resDeg F A : ℤ) * valL F A (normLM F hAB (c₁ : B)) := hdivA _
    exact Nat.le_of_dvd hfB_pos (Int.ofNat_dvd.mp hdvd_int)

  have hres_MC_le_M1 : resDeg F M_C ≤ resDeg F M_1 := hresDeg_le M_C M_1 hMC_M1
  have hres_M1_le_K : resDeg F M_1 ≤ resDeg F K := hresDeg_le M_1 K hM1_K
  obtain ⟨_, hdiv_MC, _, _, _, _⟩ := hvalL_props M_C
  obtain ⟨_, hdiv_K, _, _, _, hsurj_K⟩ := hvalL_props K
  obtain ⟨ϖ_K, hϖ_K⟩ := hsurj_K 1
  have hresDeg_K_eq_MC : (resDeg F K : ℤ) = (resDeg F M_C : ℤ) := by
    calc (resDeg F K : ℤ)
      _ = (resDeg F K : ℤ) * valL F K (ϖ_K : K) := by rw [hϖ_K, mul_one]
      _ = relVal F K (ϖ_K : K) := (hdiv_K (ϖ_K : K)).symm
      _ = relVal F M_C (normLM F hM_CK (ϖ_K : K)) := (hrelVal_norm M_C K hM_CK (ϖ_K : K)).symm
      _ = (resDeg F M_C : ℤ) * valL F M_C (normLM F hM_CK (ϖ_K : K)) := hdiv_MC _
      _ = (resDeg F M_C : ℤ) := by rw [hValNormK (ϖ_K : K), hϖ_K, mul_one]
  have hres_M1_eq_MC : resDeg F M_1 = resDeg F M_C := by omega
  have hres_K_eq_M1 : resDeg F K = resDeg F M_1 := by omega

  have hstep_val_props : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      resDeg F B = resDeg F A →
      (∀ w : B, valL F A (normLM F hAB w) = valL F B w) ∧
      (∀ z : A,
        valL F B (IntermediateField.inclusion hAB z) =
          (Module.finrank A (IntermediateField.extendScalars hAB) : ℤ) * valL F A z) := by
    intro A B _ _ hAB hres_eq
    obtain ⟨hfA_pos, hdivA, hvalA0, hvalA1, hvalA_mul, _⟩ := hvalL_props A
    obtain ⟨_, hdivB, hvalB0, _, _, _⟩ := hvalL_props B
    have hfA_ne : (resDeg F A : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hfA_pos)
    have hValNorm_AB : ∀ w : B, valL F A (normLM F hAB w) = valL F B w := by
      intro w
      apply mul_left_cancel₀ hfA_ne
      calc (resDeg F A : ℤ) * valL F A (normLM F hAB w)
        _ = relVal F A (normLM F hAB w) := (hdivA (normLM F hAB w)).symm
        _ = relVal F B w := hrelVal_norm A B hAB w
        _ = (resDeg F B : ℤ) * valL F B w := hdivB w
        _ = (resDeg F A : ℤ) * valL F B w := by rw [hres_eq]
    have hval_pow_A : ∀ (z : A) (n : ℕ), z ≠ 0 → valL F A (z ^ n) = (n : ℤ) * valL F A z := by
      intro z n hz0
      induction n with
      | zero => simp [hvalA1]
      | succ n ih =>
        rw [pow_succ, hvalA_mul (z ^ n) z (pow_ne_zero n hz0) hz0, ih]
        push_cast
        ring
    have hValAlg_AB : ∀ z : A,
        valL F B (IntermediateField.inclusion hAB z) =
          (Module.finrank A (IntermediateField.extendScalars hAB) : ℤ) * valL F A z := by
      intro z
      by_cases hz0 : z = 0
      · rw [hz0, map_zero, hvalB0, hvalA0, mul_zero]
      · rw [← hValNorm_AB (IntermediateField.inclusion hAB z)]
        have hnorm_inc : normLM F hAB (IntermediateField.inclusion hAB z) =
            z ^ (Module.finrank A (IntermediateField.extendScalars hAB)) := by
          change Algebra.norm A (algebraMap A (IntermediateField.extendScalars hAB) z) =
            z ^ (Module.finrank A (IntermediateField.extendScalars hAB))
          exact Algebra.norm_algebraMap z
        rw [hnorm_inc, hval_pow_A z _ hz0]
    exact ⟨hValNorm_AB, hValAlg_AB⟩

  obtain ⟨hValNorm_M1K, hValAlg_M1K⟩ := hstep_val_props M_1 K hM1_K hres_K_eq_M1
  obtain ⟨hValNorm_MCM1, hValAlg_MCM1⟩ := hstep_val_props M_C M_1 hMC_M1 hres_M1_eq_MC
  exact ⟨M_1, hFinM1, hMC_M1, hM1_K, hGalMCM1, hGalM1K, hfin_M1K, hfin_MCM1,
    hnorm_trans, hValNorm_M1K, hValAlg_M1K, hValNorm_MCM1, hValAlg_MCM1⟩

theorem ld_ch14_wild_tower_norm_coset_generators (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp)
    (M_C K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K)
    (hGalMCK : IsGaloisExt F M_C K)
    (hq_pow : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hFrobSurjMC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F))))
    (m_cut : ℕ) (hm_cut : 1 ≤ m_cut) :
    ∃ (h : Fin r_exp → M_Cˣ),
      ∀ x : M_Cˣ,
        ∃ (e : Fin r_exp → Fin (p F)) (w : Kˣ),
          x * ((∏ s : Fin r_exp, (h s) ^ (e s : ℕ)) *
            Units.map (normLM F hM_CK) w)⁻¹ ∈ unitGroup F M_C m_cut :=
by
  have hp_prime : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
  have hGalTower : ∀ (A B C : IntermediateField F (AlgebraicClosure F))
      (h1 : A ≤ B) (h2 : B ≤ C),
      IsGaloisExt F A C → IsGaloisExt F B C :=
    fun A B C h1 h2 hG => ((ld_galois_closure_directed_system F).2.1 A B C h1 h2 hG).1
  have hPrimeStep : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B]
      (hAB : A ≤ B) (hGal : IsGaloisExt F A B)
      (hq_p : Module.finrank A (IntermediateField.extendScalars hAB) = p F)
      (hValNorm : ∀ y : B, valL F A (normLM F hAB y) = valL F B y)
      (hValAlg : ∀ x : A,
        valL F B (IntermediateField.inclusion hAB x) =
          (Module.finrank A (IntermediateField.extendScalars hAB) : ℤ) * valL F A x)
      (m_c : ℕ) (hm_c : 1 ≤ m_c),
      (∃ m₁ : ℕ, 1 ≤ m₁ ∧
        ∀ w ∈ unitGroup F B m₁,
          Units.map (normLM F hAB) w ∈ unitGroup F A m_c) ∧
      (∃ g₀ : Aˣ, ∀ x : Aˣ, ∃ (e₀ : Fin (p F)) (w : Bˣ),
        x * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hAB) w)⁻¹ ∈ unitGroup F A m_c) := by
    intro A B _ _ hAB hGal hq_p hValNorm hValAlg m_c hm_c
    have hvalA := ld_valL_and_unitGroup_props F A
    have hvalB := ld_valL_and_unitGroup_props F B
    obtain ⟨hadd1, hadd_neg, hadd_mul, hadd_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
      ld_addVal_finset_and_algebraMap_valL F A
    obtain ⟨S₁, hS₁⟩ :=
      ld_valL_mod_one_finset F A hvalA.1 hvalA.2.2.2.1 hvalA.2.2.2.2.1 hvalA.2.2.2.2.2.2.2.1
        hadd1 hadd_neg hadd_mul hadd_inv halg0 halg1 R_F hRF_0 hRF_mod1
    obtain ⟨k_A, hField_kA, hFin_kA, resA, hresA_0, hresA_1, hresA_ring, hresA_ker, hresA_surj⟩ :=
      ld_valL_residue_field_exists F A hvalA.1 hvalA.2.1 hvalA.2.2.1 hvalA.2.2.2.1
        hvalA.2.2.2.2.1 hvalA.2.2.2.2.2.1 hvalA.2.2.2.2.2.2.2.1 S₁ hS₁
    letI : Field k_A := hField_kA
    letI : Fintype k_A := hFin_kA
    have hp_pos_AB : 0 < Module.finrank A (IntermediateField.extendScalars hAB) := by
      rw [hq_p]
      exact hp_prime.pos
    obtain ⟨ϖ_B, ϖ_A, hϖ_norm, hϖ_B, hϖ_A, hBasis⟩ :=
      ld_ch14_wild_prime_power_basis F A B hAB hp_pos_AB hValNorm hValAlg
    have hPrime_AB : Nat.Prime (Module.finrank A (IntermediateField.extendScalars hAB)) := by
      rw [hq_p]
      exact hp_prime
    obtain ⟨t, _, ht_ge1, _, _, _, htr_bound, htr_surj, hnorm_exp⟩ :=
      ld_wild_galois_jump_and_euler_trace_formula F A B hAB hGal hPrime_AB hq_p
        hadd1 halg1 hvalA hvalB hValNorm hValAlg ϖ_B hϖ_B hBasis
    obtain ⟨hp_char, hnorm_surj_lt, hnorm_gt_le, hnorm_gt_surj, hb_tr_val, hP_norm_t⟩ :=
      ld_ch14_wild_prime_herbrand_filtration_and_level_t_poly F A B hAB hp_prime hq_p
        hValNorm hValAlg ϖ_B ϖ_A hϖ_norm hϖ_B hϖ_A k_A resA hresA_0 hresA_1
        hresA_ring hresA_ker hresA_surj t ht_ge1 htr_bound htr_surj hnorm_exp
    exact ld_ch14_wild_prime_step_norm_coset_generator F A B hAB hp_prime
      ϖ_B ϖ_A hϖ_norm hϖ_B hϖ_A k_A resA hresA_0 hresA_1 hresA_ring hresA_ker hresA_surj
      t ht_ge1 hnorm_surj_lt hnorm_gt_le hnorm_gt_surj
      ((((ϖ_A ^ t)⁻¹ : Aˣ) : A) * traceLM F hAB ((ϖ_B ^ t : Bˣ) : B))
      hb_tr_val hP_norm_t
      (fun b₀ => ld_ch14_finite_field_artin_schreier_coker_gen k_A (p F) hp_prime hp_char b₀)
      m_c hm_c
  have hInd : ∀ (d : ℕ) (K₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F K₀]
      (hM_CK₀ : M_C ≤ K₀) (hGal₀ : IsGaloisExt F M_C K₀)
      (hq_pow₀ : Module.finrank M_C (IntermediateField.extendScalars hM_CK₀) = (p F) ^ (d + 1))
      (hValNorm₀ : ∀ w : K₀, valL F M_C (normLM F hM_CK₀ w) = valL F K₀ w)
      (hValAlg₀ : ∀ z : M_C,
        valL F K₀ (IntermediateField.inclusion hM_CK₀ z) =
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK₀) : ℤ) * valL F M_C z)
      (m_c : ℕ) (hm_c : 1 ≤ m_c),
      (∃ m₁ : ℕ, 1 ≤ m₁ ∧
        ∀ w ∈ unitGroup F K₀ m₁,
          Units.map (normLM F hM_CK₀) w ∈ unitGroup F M_C m_c) ∧
      (∃ (h : Fin (d + 1) → M_Cˣ),
        ∀ x : M_Cˣ,
          ∃ (e : Fin (d + 1) → Fin (p F)) (w : K₀ˣ),
            x * ((∏ s : Fin (d + 1), (h s) ^ (e s : ℕ)) *
              Units.map (normLM F hM_CK₀) w)⁻¹ ∈ unitGroup F M_C m_c) := by
    intro d
    induction d with
    | zero =>
      intro K₀ _ hM_CK₀ hGal₀ hq_pow₀ hValNorm₀ hValAlg₀ m_c hm_c
      have hq_p₀ : Module.finrank M_C (IntermediateField.extendScalars hM_CK₀) = p F := by
        simpa using hq_pow₀
      obtain ⟨h_m₁, g₀, hg₀⟩ :=
        hPrimeStep M_C K₀ hM_CK₀ hGal₀ hq_p₀ hValNorm₀ hValAlg₀ m_c hm_c
      refine ⟨h_m₁, ⟨fun _ => g₀, fun x => ?_⟩⟩
      obtain ⟨e₀, w, hx⟩ := hg₀ x
      refine ⟨fun _ => e₀, w, ?_⟩
      simpa [Fin.prod_univ_one] using hx
    | succ d ih =>
      intro K₀ _ hM_CK₀ hGal₀ hq_pow₀ hValNorm₀ hValAlg₀ m_c hm_c
      set r := d + 1
      have hr_pos : 1 ≤ r := Nat.succ_pos d
      obtain ⟨M_1, hFinM1, hMC_M1, hM1_K₀, hGalMCM1, hGalM1K₀,
          hfin_M1K₀, hfin_MCM1, hnorm_trans,
          hValNorm_M1K₀, hValAlg_M1K₀, hValNorm_MCM1, hValAlg_MCM1⟩ :=
        ld_ch14_wild_central_p_subfield_step F M_C K₀ hM_CK₀ hGal₀ hp_prime
          r hr_pos hq_pow₀ hValNorm₀ (fun M_1 => hGalTower M_C M_1 K₀)
      letI : FiniteDimensional F M_1 := hFinM1
      obtain ⟨⟨m₁, hm₁_ge1, hnorm_m₁⟩, ⟨h₀, hh₀⟩⟩ :=
        ih M_1 hMC_M1 hGalMCM1 hfin_MCM1 hValNorm_MCM1 hValAlg_MCM1 m_c hm_c
      obtain ⟨⟨m₂, hm₂_ge1, hnorm_m₂⟩, ⟨g₁, hg₁⟩⟩ :=
        hPrimeStep M_1 K₀ hM1_K₀ hGalM1K₀ hfin_M1K₀ hValNorm_M1K₀ hValAlg_M1K₀ m₁ hm₁_ge1
      have hnorm_units : ∀ w : K₀ˣ,
          Units.map (normLM F hM_CK₀) w =
            Units.map (normLM F hMC_M1) (Units.map (normLM F hM1_K₀) w) :=
        fun w => Units.ext (hnorm_trans w)
      let h_snoc : Fin (r + 1) → M_Cˣ := Fin.snoc h₀ (Units.map (normLM F hMC_M1) g₁)
      refine ⟨⟨m₂, hm₂_ge1, fun w hw => ?_⟩, ⟨h_snoc, fun x => ?_⟩⟩
      · rw [hnorm_units w]
        exact hnorm_m₁ _ (hnorm_m₂ w hw)
      · obtain ⟨e₀, w₁, hu₀⟩ := hh₀ x
        obtain ⟨e_r, w, hu₁⟩ := hg₁ w₁
        let e_snoc : Fin (r + 1) → Fin (p F) := Fin.snoc e₀ e_r
        refine ⟨e_snoc, w, ?_⟩
        have hprod_snoc :
            (∏ s : Fin (r + 1), (h_snoc s) ^ (e_snoc s : ℕ)) =
              (∏ s : Fin r, (h₀ s) ^ (e₀ s : ℕ)) *
                Units.map (normLM F hMC_M1) (g₁ ^ (e_r : ℕ)) := by
          dsimp only [h_snoc, e_snoc]
          rw [Fin.prod_univ_castSucc]
          simp only [Fin.snoc_castSucc, Fin.snoc_last, map_pow]
        set P₀ : M_Cˣ := ∏ s : Fin r, (h₀ s) ^ (e₀ s : ℕ)
        set G_r : M_Cˣ := Units.map (normLM F hMC_M1) (g₁ ^ (e_r : ℕ))
        set N_w₁ : M_Cˣ := Units.map (normLM F hMC_M1) w₁
        set N_w : M_Cˣ := Units.map (normLM F hM_CK₀) w
        have hN_u₁_mem : N_w₁ * (G_r * N_w)⁻¹ ∈ unitGroup F M_C m_c := by
          have h_im := hnorm_m₁ (w₁ * (g₁ ^ (e_r : ℕ) * Units.map (normLM F hM1_K₀) w)⁻¹) hu₁
          rwa [map_mul, map_inv, map_mul, ← hnorm_units w] at h_im
        have h_eq :
            x * ((P₀ * G_r) * N_w)⁻¹ =
              (x * (P₀ * N_w₁)⁻¹) * (N_w₁ * (G_r * N_w)⁻¹) := by
          calc x * ((P₀ * G_r) * N_w)⁻¹
            _ = x * (P₀ * (G_r * N_w))⁻¹ := by rw [mul_assoc P₀ G_r N_w]
            _ = x * (P₀⁻¹ * (G_r * N_w)⁻¹) := by rw [mul_inv P₀ (G_r * N_w)]
            _ = x * (P₀⁻¹ * (N_w₁⁻¹ * N_w₁) * (G_r * N_w)⁻¹) := by rw [inv_mul_cancel, mul_one]
            _ = (x * (P₀⁻¹ * N_w₁⁻¹)) * (N_w₁ * (G_r * N_w)⁻¹) := by ac_rfl
            _ = (x * (P₀ * N_w₁)⁻¹) * (N_w₁ * (G_r * N_w)⁻¹) := by rw [← mul_inv P₀ N_w₁]
        rw [hprod_snoc, h_eq]
        exact (unitGroup F M_C m_c).mul_mem hu₀ hN_u₁_mem
  rcases Nat.exists_eq_succ_of_ne_zero (by omega : r_exp ≠ 0) with ⟨d, rfl⟩
  exact (hInd d K hM_CK hGalMCK hq_pow hValNormK hValAlgK m_cut hm_cut).2

theorem ld_ch14_pullback_stationary_phase_units_on_MC (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (ha1 : condExp F L χ' = 1)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hμ'_props : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) ∧
