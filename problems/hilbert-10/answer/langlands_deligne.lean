      exact (hP_M₁' (u₁_fn w₁) (u₁_fn w₂) hu₁_1 hu₁_2).2.2
    have hy₂ : y₂ = 0 ∨ (m₂ : ℤ) ≤ valL F E' y₂ := by
      dsimp only [y₂]
      rw [hu₂_eq]
      exact (hP_E' (u₂_fn w₁) (u₂_fn w₂) hu₂_1 hu₂_2).2.2
    have hψ_diff : ψ (2 * α * (traceLM F hLM₁' (b * y₁) - traceLM F hLE' (a * y₂))) = 1 :=
      hBridge y₁ y₂ hy₁ hy₂
    have htr_diff : traceLM F hLM₁' (b * y₁) - traceLM F hLE' (a * y₂) =
        F_fn w₁₂ - F_fn w₁ - F_fn w₂ := by
      dsimp only [y₁, y₂]
      rw [htr_lin₁, htr_lin₂]
      dsimp only [F_fn, u₁_fn, u₂_fn]
      ring
    rw [htr_diff] at hψ_diff
    have hadd : 2 * α * F_fn w₁₂ =
        2 * α * (F_fn w₁₂ - F_fn w₁ - F_fn w₂) + 2 * α * F_fn w₁ + 2 * α * F_fn w₂ := by
      ring
    change ψ (2 * α * F_fn w₁₂) = ψ (2 * α * F_fn w₁) * ψ (2 * α * F_fn w₂)
    rw [hadd, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, hψ_diff, one_mul]
  have hΞ_deep : ∀ w : K₁,
      (w = 0 ∨ ((p * m₁ : ℕ) : ℤ) ≤ valL F K₁ w) →
      Ξ w = 1 := by
    intro w hw
    obtain ⟨hP₁, hP₂⟩ := hFilt.2 w hw
    exact hBridge _ _ hP₁ hP₂
  exact ⟨hΞ_char, hΞ_mult, hΞ_deep⟩

theorem ld_ch12_wild_odd_tot_ram_unit_model_step_add_and_teich_scale (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (p bE' q₁ s : ℕ)
    (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hbE'_ge2 : 2 ≤ bE') (hq₁_ge1 : 1 ≤ q₁) (hq₁_le_s : q₁ ≤ s)
    (hp_valK₁ : ((p : ℕ) : K₁) = 0 ∨
      ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) = (p : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y)
    (τ_unit : ℕ → Lˣ)
    (hτ_props : ∀ c ∈ (Finset.range p).erase 0,
      ((τ_unit c : L) - (c : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((τ_unit c : L) - (c : L))) ∧
      ∃ k_c : ℕ, c * c ^ (p - 2) = 1 + p * k_c)
    (Ξ : K₁ → Ω F)
    (hΞ_mult : ∀ w₁ w₂ : K₁,
      (w₁ = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w₁) →
      (w₂ = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w₂) →
      Ξ (w₁ + w₂ - w₁ * w₂) = Ξ w₁ * Ξ w₂)
    (ih : ∀ w' : K₁,
      (w' = 0 ∨ ((s + 1 : ℕ) : ℤ) ≤ valL F K₁ w') → Ξ w' = 1) :
    Ξ 0 = 1 ∧
    (∀ w₁ w₂ : K₁,
      (w₁ = 0 ∨ (s : ℤ) ≤ valL F K₁ w₁) →
      (w₂ = 0 ∨ (s : ℤ) ≤ valL F K₁ w₂) →
      Ξ (w₁ + w₂) = Ξ w₁ * Ξ w₂) ∧
    (∀ z : K₁,
      (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
      (Ξ z) ^ p = 1) ∧
    (∀ c ∈ (Finset.range p).erase 0,
      ∀ z : K₁,
        (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
        (Ξ (IntermediateField.inclusion hE'K₁
          (IntermediateField.inclusion hLE' (τ_unit c : L)) * z)) ^ (c ^ (p - 2)) = Ξ z) :=
by
  rcases hvalK₁_props with
    ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, _, hvalK₁_add,
     _, hunitK₁_mem, hunitK₁_val0⟩
  have hvalK₁_neg_ge : ∀ (k : ℤ) (x : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (-x = 0 ∨ k ≤ valL F K₁ (-x)) := by
    intro k x hx
    rcases hx with rfl | hle
    · left; simp
    · right; rw [hvalK₁_neg]; exact hle
  have hvalK₁_sub_ge : ∀ (k : ℤ) (x y : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hvalK₁_add k x (-y) hx (hvalK₁_neg_ge k y hy)
  have hvalK₁_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : K₁),
      (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        rw [hvalK₁_mul x y hx0 hy0]
        have hx_le : k₁ ≤ valL F K₁ x := hx.resolve_left hx0
        have hy_le : k₂ ≤ valL F K₁ y := hy.resolve_left hy0
        omega
  have hvalK₁_mono : ∀ {k₁ k₂ : ℤ} {x : K₁},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F K₁ x) → (x = 0 ∨ k₁ ≤ valL F K₁ x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx_ge
    · left; rfl
    · right; omega
  have hΞ0 : Ξ 0 = 1 := ih 0 (Or.inl rfl)
  have hΞ_add : ∀ w₁ w₂ : K₁,
      (w₁ = 0 ∨ (s : ℤ) ≤ valL F K₁ w₁) →
      (w₂ = 0 ∨ (s : ℤ) ≤ valL F K₁ w₂) →
      Ξ (w₁ + w₂) = Ξ w₁ * Ξ w₂ := by
    intro w₁ w₂ hw₁ hw₂
    let w₁₂ : K₁ := w₁ + w₂ - w₁ * w₂
    have hw₁₂_prod_2s : w₁ * w₂ = 0 ∨ (s : ℤ) + (s : ℤ) ≤ valL F K₁ (w₁ * w₂) :=
      hvalK₁_mul_ge (s : ℤ) (s : ℤ) w₁ w₂ hw₁ hw₂
    have hw₁₂_prod_s : w₁ * w₂ = 0 ∨ (s : ℤ) ≤ valL F K₁ (w₁ * w₂) :=
      hvalK₁_mono (by omega : (s : ℤ) ≤ (s : ℤ) + (s : ℤ)) hw₁₂_prod_2s
    have hw₁₂_s : w₁₂ = 0 ∨ (s : ℤ) ≤ valL F K₁ w₁₂ :=
      hvalK₁_sub_ge (s : ℤ) (w₁ + w₂) (w₁ * w₂) (hvalK₁_add (s : ℤ) w₁ w₂ hw₁ hw₂) hw₁₂_prod_s
    have hw₁_q₁ : w₁ = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w₁ :=
      hvalK₁_mono (by omega : (q₁ : ℤ) ≤ (s : ℤ)) hw₁
    have hw₂_q₁ : w₂ = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w₂ :=
      hvalK₁_mono (by omega : (q₁ : ℤ) ≤ (s : ℤ)) hw₂
    have hw₁₂_q₁ : w₁₂ = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w₁₂ :=
      hvalK₁_mono (by omega : (q₁ : ℤ) ≤ (s : ℤ)) hw₁₂_s
    have hw₁₂_1 : w₁₂ = 0 ∨ (1 : ℤ) ≤ valL F K₁ w₁₂ :=
      hvalK₁_mono (by omega : (1 : ℤ) ≤ (s : ℤ)) hw₁₂_s
    have hneg_w₁₂_1 : -w₁₂ = 0 ∨ (1 : ℤ) ≤ valL F K₁ (-w₁₂) :=
      hvalK₁_neg_ge 1 w₁₂ hw₁₂_1
    have h1w₁₂_ne0 : 1 - w₁₂ ≠ 0 := by
      intro h0
      have hw_eq : -w₁₂ = -1 := by linear_combination h0
      rcases hneg_w₁₂_1 with hnw0 | hle
      · rw [hnw0] at hw_eq
        exact one_ne_zero (neg_eq_zero.mp hw_eq.symm)
      · rw [hw_eq, hvalK₁_neg1] at hle
        omega
    let u₁₂ : K₁ˣ := Units.mk0 (1 - w₁₂) h1w₁₂_ne0
    have hu₁₂_mem : u₁₂ ∈ unitGroup F K₁ 1 := by
      rw [hunitK₁_mem 1 (by omega) u₁₂]
      dsimp only [u₁₂, Units.val_mk0]
      have hsub : (1 - w₁₂) - 1 = -w₁₂ := by ring
      rw [hsub]
      rcases hneg_w₁₂_1 with hnw0 | hle
      · left
        have hw0 : w₁₂ = 0 := neg_eq_zero.mp hnw0
        rw [hw0, sub_zero]
      · right
        exact_mod_cast hle
    have hu₁₂_val0 : valL F K₁ (1 - w₁₂) = 0 := hunitK₁_val0 1 u₁₂ hu₁₂_mem
    have hinv_val0_eq : valL F K₁ ((1 - w₁₂)⁻¹) = 0 := by
      have h := hvalK₁_inv u₁₂
      dsimp only [u₁₂] at h
      rw [Units.val_inv_eq_inv_val, Units.val_mk0, hu₁₂_val0, neg_zero] at h
      exact h
    have hinv_val0 : (1 - w₁₂)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F K₁ ((1 - w₁₂)⁻¹) :=
      Or.inr (by omega)
    let δ : K₁ := (w₁ * w₂) * (1 - w₁₂)⁻¹
    have hδ_2s : δ = 0 ∨ (s : ℤ) + (s : ℤ) ≤ valL F K₁ δ := by
      have h := hvalK₁_mul_ge ((s : ℤ) + (s : ℤ)) 0 (w₁ * w₂) ((1 - w₁₂)⁻¹) hw₁₂_prod_2s hinv_val0
      rwa [add_zero] at h
    have hδ_s1 : δ = 0 ∨ ((s + 1 : ℕ) : ℤ) ≤ valL F K₁ δ :=
      hvalK₁_mono (by omega : ((s + 1 : ℕ) : ℤ) ≤ (s : ℤ) + (s : ℤ)) hδ_2s
    have hδ_q₁ : δ = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ δ :=
      hvalK₁_mono (by omega : (q₁ : ℤ) ≤ ((s + 1 : ℕ) : ℤ)) hδ_s1
    have h1w₁₂_mul_δ : (1 - w₁₂) * δ = w₁ * w₂ := by
      dsimp only [δ]
      rw [mul_comm (w₁ * w₂) ((1 - w₁₂)⁻¹), ← mul_assoc, mul_inv_cancel₀ h1w₁₂_ne0, one_mul]
    have hw_sum_eq : w₁ + w₂ = w₁₂ + δ - w₁₂ * δ := by
      calc w₁ + w₂
        _ = w₁₂ + w₁ * w₂ := by dsimp only [w₁₂]; ring
        _ = w₁₂ + (1 - w₁₂) * δ := by rw [← h1w₁₂_mul_δ]
        _ = w₁₂ + δ - w₁₂ * δ := by ring
    rw [hw_sum_eq, hΞ_mult w₁₂ δ hw₁₂_q₁ hδ_q₁, hΞ_mult w₁ w₂ hw₁_q₁ hw₂_q₁,
      ih δ hδ_s1, mul_one]
  have hvalK₁_natCast : ∀ m : ℕ, ((m : ℕ) : K₁) = 0 ∨ (0 : ℤ) ≤ valL F K₁ ((m : ℕ) : K₁) := by
    intro m
    induction m with
    | zero => left; simp
    | succ m ihm =>
      rw [Nat.cast_add, Nat.cast_one]
      exact hvalK₁_add 0 ((m : ℕ) : K₁) 1 ihm (Or.inr (by rw [hvalK₁_1]))
  have hvalK₁_natMul : ∀ (m : ℕ) (z : K₁),
      (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
      (((m : ℕ) : K₁) * z = 0 ∨ (s : ℤ) ≤ valL F K₁ (((m : ℕ) : K₁) * z)) := by
    intro m z hz
    have h := hvalK₁_mul_ge 0 (s : ℤ) ((m : ℕ) : K₁) z (hvalK₁_natCast m) hz
    rwa [zero_add] at h
  have hΞ_natMul : ∀ (m : ℕ) (z : K₁),
      (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
      Ξ (((m : ℕ) : K₁) * z) = (Ξ z) ^ m := by
    intro m z hz
    induction m with
    | zero =>
      rw [Nat.cast_zero, zero_mul, hΞ0, pow_zero]
    | succ m ihm =>
      have hcast : ((m + 1 : ℕ) : K₁) * z = ((m : ℕ) : K₁) * z + z := by
        push_cast
        ring
      rw [hcast, hΞ_add (((m : ℕ) : K₁) * z) z (hvalK₁_natMul m z hz) hz, ihm, pow_succ]
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hprod_ge1 : 1 ≤ p * (p - 1) * (bE' - 1) :=
    Nat.mul_pos (Nat.mul_pos (by omega) (by omega)) (by omega)
  have hp_valK₁_ge1 : ((p : ℕ) : K₁) = 0 ∨ (1 : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁) :=
    hvalK₁_mono (by exact_mod_cast hprod_ge1) hp_valK₁
  have hΞ_pow_p : ∀ z : K₁,
      (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
      (Ξ z) ^ p = 1 := by
    intro z hz
    have hpz_raw := hvalK₁_mul_ge 1 (s : ℤ) ((p : ℕ) : K₁) z hp_valK₁_ge1 hz
    have hpz_s1 : ((p : ℕ) : K₁) * z = 0 ∨
        ((s + 1 : ℕ) : ℤ) ≤ valL F K₁ (((p : ℕ) : K₁) * z) :=
      hvalK₁_mono (by omega : ((s + 1 : ℕ) : ℤ) ≤ 1 + (s : ℤ)) hpz_raw
    rw [← hΞ_natMul p z hz]
    exact ih (((p : ℕ) : K₁) * z) hpz_s1
  have hΞ_teich : ∀ c ∈ (Finset.range p).erase 0,
      ∀ z : K₁,
        (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
        (Ξ (IntermediateField.inclusion hE'K₁
          (IntermediateField.inclusion hLE' (τ_unit c : L)) * z)) ^ (c ^ (p - 2)) = Ξ z := by
    intro c hc z hz
    rcases hτ_props c hc with ⟨hdc_L, k_c, hkc⟩
    let d_c : L := (τ_unit c : L) - (c : L)
    let d_K₁ : K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' d_c)
    have hd_K₁_ge1 : d_K₁ = 0 ∨ (1 : ℤ) ≤ valL F K₁ d_K₁ := by
      rcases hdc_L with hd0 | hdc_ge1
      · left
        dsimp only [d_K₁, d_c]
        rw [hd0, map_zero, map_zero]
      · right
        have hp_pos : (1 : ℤ) ≤ (p : ℤ) := by omega
        dsimp only [d_K₁, d_c]
        rw [hval_E'K₁, hval_LE']
        have h1 : (1 : ℤ) ≤ (p : ℤ) * valL F L ((τ_unit c : L) - (c : L)) := by
          calc (1 : ℤ) = 1 * 1 := by ring
            _ ≤ (p : ℤ) * valL F L ((τ_unit c : L) - (c : L)) :=
              mul_le_mul hp_pos hdc_ge1 (by omega) (by omega)
        calc (1 : ℤ) = 1 * 1 := by ring
          _ ≤ (p : ℤ) * ((p : ℤ) * valL F L ((τ_unit c : L) - (c : L))) :=
            mul_le_mul hp_pos h1 (by omega) (by omega)
    have hdz_raw := hvalK₁_mul_ge 1 (s : ℤ) d_K₁ z hd_K₁_ge1 hz
    have hdz_s1 : d_K₁ * z = 0 ∨ ((s + 1 : ℕ) : ℤ) ≤ valL F K₁ (d_K₁ * z) :=
      hvalK₁_mono (by omega : ((s + 1 : ℕ) : ℤ) ≤ 1 + (s : ℤ)) hdz_raw
    have hdz_s : d_K₁ * z = 0 ∨ (s : ℤ) ≤ valL F K₁ (d_K₁ * z) :=
      hvalK₁_mono (by omega : (s : ℤ) ≤ ((s + 1 : ℕ) : ℤ)) hdz_s1
    have hτz_eq :
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (τ_unit c : L)) * z =
          ((c : ℕ) : K₁) * z + d_K₁ * z := by
      have hτ_eq : (τ_unit c : L) = ((c : ℕ) : L) + d_c := by
        dsimp only [d_c]
        ring
      dsimp only [d_K₁]
      rw [hτ_eq, map_add, map_add, map_natCast, map_natCast, add_mul]
    have hΞ_τz :
        Ξ (IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (τ_unit c : L)) * z) =
          (Ξ z) ^ c := by
      rw [hτz_eq, hΞ_add (((c : ℕ) : K₁) * z) (d_K₁ * z) (hvalK₁_natMul c z hz) hdz_s,
        hΞ_natMul c z hz, ih (d_K₁ * z) hdz_s1, mul_one]
    rw [hΞ_τz, ← pow_mul, hkc, pow_add, pow_one, pow_mul, hΞ_pow_p z hz, one_pow, mul_one]
  exact ⟨hΞ0, hΞ_add, hΞ_pow_p, hΞ_teich⟩

theorem ld_ch12_wild_odd_tot_ram_unit_model_basis_and_desc_ind (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (t₁ m₁ q₁ : ℕ) (hq₁_ge1 : 1 ≤ q₁)
    (hq₁_le_pm₁ : q₁ ≤ Module.finrank L (IntermediateField.extendScalars hLE') * m₁)
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -(t₁ : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ))
    (τ_unit : ℕ → Lˣ)
    (Ξ : K₁ → Ω F)
    (hΞ_deep : ∀ w : K₁,
      (w = 0 ∨ ((Module.finrank L (IntermediateField.extendScalars hLE') * m₁ : ℕ) : ℤ) ≤
        valL F K₁ w) →
      Ξ w = 1)
    (hΞ_mono :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∀ (k : Fin p) (x : E'),
        (x = 0 ∨ (q₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ)) →
        let z_k := IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (k : ℕ))
        ∏ c ∈ (Finset.range p).erase 0,
          (Ξ (IntermediateField.inclusion hE'K₁
            (IntermediateField.inclusion hLE' (τ_unit c : L)) * z_k)) ^ (c ^ (p - 2)) = 1)
    (hStep :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ∀ s : ℕ, q₁ ≤ s →
        (∀ w' : K₁, (w' = 0 ∨ ((s + 1 : ℕ) : ℤ) ≤ valL F K₁ w') → Ξ w' = 1) →
        Ξ 0 = 1 ∧
        (∀ w₁ w₂ : K₁,
          (w₁ = 0 ∨ (s : ℤ) ≤ valL F K₁ w₁) →
          (w₂ = 0 ∨ (s : ℤ) ≤ valL F K₁ w₂) →
          Ξ (w₁ + w₂) = Ξ w₁ * Ξ w₂) ∧
        (∀ z : K₁,
          (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
          (Ξ z) ^ p = 1) ∧
        (∀ c ∈ (Finset.range p).erase 0,
          ∀ z : K₁,
            (z = 0 ∨ (s : ℤ) ≤ valL F K₁ z) →
            (Ξ (IntermediateField.inclusion hE'K₁
              (IntermediateField.inclusion hLE' (τ_unit c : L)) * z)) ^ (c ^ (p - 2)) = Ξ z)) :
    ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) → Ξ w = 1 :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  have hp_pos : 0 < p := hPrime.pos
  obtain ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv,
    hvalK₁_surj, hvalK₁_add, hunitK₁_0, hunitK₁_a, hunitK₁_val0⟩ := hvalK₁_props
  have hΔ_pow_val : ∀ i : ℕ, valL F K₁ ((Δ : K₁) ^ i) = -(i : ℤ) * (t₁ : ℤ) := by
    intro i
    induction' i with i ih
    · simp [hvalK₁_1]
    · rw [pow_succ, hvalK₁_mul ((Δ : K₁) ^ i) (Δ : K₁) (pow_ne_zero i Δ.ne_zero) Δ.ne_zero,
        ih, hΔ_val, Nat.cast_add, Nat.cast_one]
      ring
  have hMono_val : ∀ (s : ℕ) (k : Fin p) (x : E'),
      (x = 0 ∨ (s : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ)) →
      let z_k := IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (k : ℕ))
      z_k = 0 ∨ (s : ℤ) ≤ valL F K₁ z_k := by
    intro s k x hx
    dsimp only
    by_cases hx0 : x = 0
    · exact Or.inl (by simp [hx0])
    · rcases hx with rfl | hx_ge
      · exact False.elim (hx0 rfl)
      · right
        have hx_inc : IntermediateField.inclusion hE'K₁ x ≠ 0 :=
          (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hx0
        have hΔ_ne0 : ((Δ : K₁) ^ (k : ℕ)) ≠ 0 := pow_ne_zero (k : ℕ) Δ.ne_zero
        rw [hvalK₁_mul (IntermediateField.inclusion hE'K₁ x) ((Δ : K₁) ^ (k : ℕ)) hx_inc hΔ_ne0,
          hval_E'K₁ x, hΔ_pow_val (k : ℕ)]
        linarith
  have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
  have hcard_erase : ((Finset.range p).erase 0).card = p - 1 := by
    rw [Finset.card_erase_of_mem h0_mem, Finset.card_range]
  have hStep_all : ∀ s : ℕ, q₁ ≤ s →
      (∀ w' : K₁, (w' = 0 ∨ ((s + 1 : ℕ) : ℤ) ≤ valL F K₁ w') → Ξ w' = 1) →
      ∀ w : K₁, (w = 0 ∨ (s : ℤ) ≤ valL F K₁ w) → Ξ w = 1 := by
    intro s hq₁_s ih
    obtain ⟨hΞ0, hΞ_add, hΞ_pow_p, hΞ_teich⟩ := hStep s hq₁_s ih
    have hMono_one : ∀ (k : Fin p) (x : E'),
        (x = 0 ∨ (s : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ)) →
        Ξ (IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (k : ℕ))) = 1 := by
      intro k x hx_s
      set z_k := IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (k : ℕ))
      have hz_k_s : z_k = 0 ∨ (s : ℤ) ≤ valL F K₁ z_k := hMono_val s k x hx_s
      have hx_q₁ : x = 0 ∨ (q₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ) := by
        rcases hx_s with rfl | hx_ge
        · exact Or.inl rfl
        · exact Or.inr (le_trans (Int.ofNat_le.mpr hq₁_s) hx_ge)
      have hprod_eq1 :
          ∏ c ∈ (Finset.range p).erase 0,
            (Ξ (IntermediateField.inclusion hE'K₁
              (IntermediateField.inclusion hLE' (τ_unit c : L)) * z_k)) ^ (c ^ (p - 2)) = 1 :=
        hΞ_mono k x hx_q₁
      have hprod_simp :
          ∏ c ∈ (Finset.range p).erase 0,
            (Ξ (IntermediateField.inclusion hE'K₁
              (IntermediateField.inclusion hLE' (τ_unit c : L)) * z_k)) ^ (c ^ (p - 2)) =
          (Ξ z_k) ^ (p - 1) := by
        calc ∏ c ∈ (Finset.range p).erase 0,
              (Ξ (IntermediateField.inclusion hE'K₁
                (IntermediateField.inclusion hLE' (τ_unit c : L)) * z_k)) ^ (c ^ (p - 2))
            = ∏ _c ∈ (Finset.range p).erase 0, Ξ z_k :=
              Finset.prod_congr rfl (fun c hc => hΞ_teich c hc z_k hz_k_s)
          _ = (Ξ z_k) ^ ((Finset.range p).erase 0).card := Finset.prod_const (Ξ z_k)
          _ = (Ξ z_k) ^ (p - 1) := by rw [hcard_erase]
      have hpow_p_sub1 : (Ξ z_k) ^ (p - 1) = 1 := by
        rw [← hprod_simp, hprod_eq1]
      have hpow_p : (Ξ z_k) ^ p = 1 := hΞ_pow_p z_k hz_k_s
      calc Ξ z_k = 1 * Ξ z_k := (one_mul (Ξ z_k)).symm
        _ = (Ξ z_k) ^ (p - 1) * Ξ z_k := by rw [hpow_p_sub1]
        _ = (Ξ z_k) ^ (p - 1 + 1) := (pow_succ (Ξ z_k) (p - 1)).symm
        _ = (Ξ z_k) ^ p := by rw [Nat.sub_add_cancel hp_pos]
        _ = 1 := hpow_p
    intro w hw_s
    obtain ⟨Y, hw_sum, hw_iff⟩ := hΔ_basis w
    have hY_s : ∀ i : Fin p, Y i = 0 ∨ (s : ℤ) ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ) :=
      (hw_iff (s : ℤ)).mp hw_s
    let z : Fin p → K₁ := fun i => IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))
    have hz_s : ∀ i : Fin p, z i = 0 ∨ (s : ℤ) ≤ valL F K₁ (z i) :=
      fun i => hMono_val s i (Y i) (hY_s i)
    have hz_one : ∀ i : Fin p, Ξ (z i) = 1 :=
      fun i => hMono_one i (Y i) (hY_s i)
    have hFin_sum : ∀ S : Finset (Fin p),
        ((∑ i ∈ S, z i) = 0 ∨ (s : ℤ) ≤ valL F K₁ (∑ i ∈ S, z i)) ∧ Ξ (∑ i ∈ S, z i) = 1 := by
      intro S
      induction' S using Finset.induction_on with i₀ S hi₀ ihS
      · rw [Finset.sum_empty]
        exact ⟨Or.inl rfl, hΞ0⟩
      · rw [Finset.sum_insert hi₀]
        refine ⟨hvalK₁_add (s : ℤ) (z i₀) (∑ i ∈ S, z i) (hz_s i₀) ihS.1, ?_⟩
        rw [hΞ_add (z i₀) (∑ i ∈ S, z i) (hz_s i₀) ihS.1, hz_one i₀, ihS.2, mul_one]
    have hw_eq : w = ∑ i ∈ Finset.univ, z i := hw_sum
    rw [hw_eq]
    exact (hFin_sum Finset.univ).2
  have hDesc : ∀ (n : ℕ) (s : ℕ), s = p * m₁ - n → q₁ ≤ s →
      ∀ w : K₁, (w = 0 ∨ (s : ℤ) ≤ valL F K₁ w) → Ξ w = 1 := by
    intro n
    induction' n with n ih <;> intro s hs hq₁_s
    · have hs_eq : s = p * m₁ := by omega
      subst hs_eq
      exact hΞ_deep
    · have hs1 : s + 1 = p * m₁ - n := by omega
      have hq₁_s1 : q₁ ≤ s + 1 := by omega
      exact hStep_all s hq₁_s (ih (s + 1) hs1 hq₁_s1)
  exact hDesc (p * m₁ - q₁) q₁ (by have := hq₁_le_pm₁; omega) (le_refl q₁)

theorem ld_ch12_wild_odd_totally_ramified_unit_model_descending_induction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) *
          (condExp F L νE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (ha_val : valL F E' (normLM F hE'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hb_val : valL F M₁' (normLM F hM₁'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hP_M₁' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * condExp F L νM₁' - 1 + p * (condExp F L νE' - condExp F L νM₁')
      let q₁ := (m₁ + p - 1) / p
      let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
      ∀ x y : M₁',
        (x = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' x) →
        (y = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' y) →
        (x + y - x * y = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' (x + y - x * y)) ∧
        (P_M₁' x = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' (P_M₁' x)) ∧
        (P_M₁' (x + y - x * y) - P_M₁' x - P_M₁' y = 0 ∨
          (m₁ : ℤ) ≤ valL F M₁' (P_M₁' (x + y - x * y) - P_M₁' x - P_M₁' y)))
    (hP_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      let q₂ := (m₂ + p - 1) / p
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      ∀ x y : E',
        (x = 0 ∨ (q₂ : ℤ) ≤ valL F E' x) →
        (y = 0 ∨ (q₂ : ℤ) ≤ valL F E' y) →
        (x + y - x * y = 0 ∨ (q₂ : ℤ) ≤ valL F E' (x + y - x * y)) ∧
        (P_E' x = 0 ∨ (q₂ : ℤ) ≤ valL F E' (P_E' x)) ∧
        (P_E' (x + y - x * y) - P_E' x - P_E' y = 0 ∨
          (m₂ : ℤ) ≤ valL F E' (P_E' (x + y - x * y) - P_E' x - P_E' y)))
    (hFilt :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let m₂ := bE' + bM₁' - 1
      let q₁ := (m₁ + p - 1) / p
      let q₂ := (m₂ + p - 1) / p
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
      (∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
        let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
        let u₂ := 1 - normLM F hE'K₁ (1 - w)
        (u₁ = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' u₁) ∧
        (u₂ = 0 ∨ (q₂ : ℤ) ≤ valL F E' u₂)) ∧
      (∀ w : K₁, (w = 0 ∨ ((p * m₁ : ℕ) : ℤ) ≤ valL F K₁ w) →
        let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
        let u₂ := 1 - normLM F hE'K₁ (1 - w)
        (P_M₁' u₁ = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (P_M₁' u₁)) ∧
        (P_E' u₂ = 0 ∨ (m₂ : ℤ) ≤ valL F E' (P_E' u₂))))
    (hTeich_vanish :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let t₁ := bM₁' - 1
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let q₁ := (m₁ + p - 1) / p
      let a := normLM F hE'K₁ (Δ : K₁)
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let α := ((c_νE'⁻¹ : Lˣ) : L)
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
      let F_fn := fun w : K₁ =>
        traceLM F hLM₁' (b * P_M₁' (1 - normLM F hM₁'K₁ (1 - w))) -
          traceLM F hLE' (a * P_E' (1 - normLM F hE'K₁ (1 - w)))
      ∃ τ_unit : ℕ → Lˣ,
        (∀ c ∈ (Finset.range p).erase 0,
          ((τ_unit c : L) - (c : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((τ_unit c : L) - (c : L))) ∧
          ∃ k_c : ℕ, c * c ^ (p - 2) = 1 + p * k_c) ∧
        (∀ (k : Fin p) (x : E'),
          (x = 0 ∨ (q₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ)) →
          let z_k := IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (k : ℕ))
          ∏ c ∈ (Finset.range p).erase 0,
            (ψ (2 * α * F_fn (IntermediateField.inclusion hE'K₁
              (IntermediateField.inclusion hLE' (τ_unit c : L)) * z_k))) ^ (c ^ (p - 2)) = 1)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let q₁ := (m₁ + p - 1) / p
    let q₂ := (m₂ + p - 1) / p
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let α := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
    let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
    ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
      let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
      let u₂ := 1 - normLM F hE'K₁ (1 - w)
      (u₁ = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' u₁) ∧
      (u₂ = 0 ∨ (q₂ : ℤ) ≤ valL F E' u₂) ∧
      ψM₁' (2 * IntermediateField.inclusion hLM₁' α * b * P_M₁' u₁) =
        ψE' (2 * IntermediateField.inclusion hLE' α * a * P_E' u₂) :=
by
  intro p bE' bM₁' m₁ m₂ q₁ q₂ a b α ψE' ψM₁' P_E' P_M₁'
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  have hψ_triv := (ld_condExp_and_condExpChar_spec F L ψ hψ νE').1
  obtain ⟨hΞ_char, hΞ_mult, hΞ_deep⟩ :=
    ld_ch12_wild_odd_tot_ram_unit_model_char_mult_and_deep_base
      F L E' M₁' K₁ hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime ψ νE' νM₁'
      hbE'_ge2 hbM₁'_ge2 hb_le hvalL_props hvalE'_props hvalM₁'_props
      htr_LE' htr_LM₁' Δ ha_val hb_val c_νE' hc_νE'_val hψ_triv
      hP_M₁' hP_E' hFilt
  obtain ⟨τ_unit, hτ_props, hΞ_mono⟩ := hTeich_vanish
  have hp_pos : 0 < p := hPrime.pos
  have hp_ne2 : p ≠ 2 := by
    dsimp only [p]
    rw [hWild]
    exact hp_odd
  have hm₁_ge2 : 2 ≤ m₁ := by omega
  have hq₁_ge1 : 1 ≤ q₁ := Nat.div_pos (by omega) hp_pos
  have hq₁_le_self : q₁ ≤ m₁ + p - 1 := Nat.div_le_self (m₁ + p - 1) p
  have hpm₁_1 : p * 2 ≤ p * m₁ := Nat.mul_le_mul_left p hm₁_ge2
  have hpm₁_2 : 2 * m₁ ≤ p * m₁ := Nat.mul_le_mul_right m₁ hPrime.two_le
  have hq₁_le_pm₁ : q₁ ≤ p * m₁ := by omega
  let F_fn := fun w : K₁ =>
    traceLM F hLM₁' (b * P_M₁' (1 - normLM F hM₁'K₁ (1 - w))) -
      traceLM F hLE' (a * P_E' (1 - normLM F hE'K₁ (1 - w)))
  let Ξ := fun w : K₁ => ψ (2 * α * F_fn w)
  have hΞ_all : ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) → Ξ w = 1 :=
    ld_ch12_wild_odd_tot_ram_unit_model_basis_and_desc_ind
      F L E' K₁ hLE' hE'K₁ hPrime (bM₁' - 1) m₁ q₁ hq₁_ge1 hq₁_le_pm₁
      hvalK₁_props hval_E'K₁ Δ hΔ_val hΔ_basis τ_unit Ξ hΞ_deep hΞ_mono
      (fun s hs ih =>
        ld_ch12_wild_odd_tot_ram_unit_model_step_add_and_teich_scale
          F L E' K₁ hLE' hE'K₁ p bE' q₁ s hPrime hp_ne2 hbE'_ge2 hq₁_ge1 hs
          hp_valK₁ hvalL_props hvalK₁_props hval_LE' hval_E'K₁
          τ_unit hτ_props Ξ hΞ_mult ih)
  intro w hw u₁ u₂
  exact ⟨(hFilt.1 w hw).1, (hFilt.1 w hw).2, hΞ_char w (hΞ_all w hw)⟩

theorem ld_ch12_wild_odd_totally_ramified_one_over_p_unit_model_compatibility_p3 (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
