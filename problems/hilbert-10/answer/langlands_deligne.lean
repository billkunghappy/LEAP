    have hw_ge0 : 0 ≤ valL F M₁' w := hw_int.resolve_left hw_ne
    have hw_lt1 : ¬ (1 ≤ valL F M₁' w) := fun h1 => hnot1 (Or.inr h1)
    exact ⟨hw_ne, by omega⟩
  
  have hσ₀_pow_val : ∀ (k : ℕ) (z : M₁'), valL F M₁' ((σ₀ ^ k) z) = valL F M₁' z := by
    intro k
    induction k with
    | zero => intro z; rfl
    | succ k ih =>
      intro z
      rw [pow_succ', AlgEquiv.mul_apply, hσ₀_val, ih]
  have hσ₀_pow_L : ∀ (k : ℕ) (x : L),
      (σ₀ ^ k) (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x := by
    intro k
    induction k with
    | zero => intro x; rfl
    | succ k ih =>
      intro x
      rw [pow_succ', AlgEquiv.mul_apply, ih, hσ₀_L]
  have hσ₀_pow_p : ∀ z : M₁', (σ₀ ^ p) z = z := by
    intro z
    have h_ap := congrArg σ₀ (hσ₀_tr z)
    rw [hσ₀_L (traceLM F hLM₁' z), hσ₀_tr z, map_sum] at h_ap
    have hsum_shift :
        (∑ k ∈ Finset.range p, (σ₀ ^ (k + 1)) z) = ∑ k ∈ Finset.range p, (σ₀ ^ k) z := by
      rw [h_ap]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [pow_succ', AlgEquiv.mul_apply]
    have h1 := Finset.sum_range_succ (fun k => (σ₀ ^ k) z) p
    have h2 := Finset.sum_range_succ' (fun k => (σ₀ ^ k) z) p
    have h0 : (σ₀ ^ 0) z = z := rfl
    rw [h0, hsum_shift] at h2
    exact add_left_cancel (h1.symm.trans h2)
  
  have val_natCast : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      (n : ℕ), (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M) := by
