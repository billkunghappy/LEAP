  have hw₂_p_split : (w₂ : E') ^ p = (w₂ : E') ^ (p - 1) * (w₂ : E') := by
    conv_lhs => rw [hp_eq, pow_succ]
  have hw₂_inv_p_split : w₂_inv ^ p = (w₂_inv ^ (p - 1)) * w₂_inv := by
    conv_lhs => rw [hp_eq, pow_succ]
  have hR_main_C :
      R_main * C =
        a * (w₂_inv ^ (p - 1)) * (1 - IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p)) := by
    dsimp [R_main, k_rat, η]
    rw [hw₂_p_split, hw₂_inv_p_split]
