    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, hCard_QF']
  choose kg hkg using hf_pow_bij.2
  have hkg' : ∀ b : Q_F', σ₀ ^ (kg b).1 = b := hkg
  have hdeg_pos : 0 < (Polynomial.cyclotomic q₀ (Ω F)).degree :=
