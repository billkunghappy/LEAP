          else 0) = 1 := fun x => by simp [Subgroup.mem_top]
      simp_rw [h_term]
      rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul, mul_one,
        Subgroup.card_top, inv_mul_cancel₀ (by exact_mod_cast (Nat.card_pos (α := G)).ne')]
    have h_eval_H : indCharTrace F H 1 c.1 = if c = 1 then (ℓ : Ω F) else 0 := by
      unfold indCharTrace
      by_cases hc1 : c = 1
      · rw [if_pos hc1]
        have hc_val : c.1 = 1 := congrArg Subtype.val hc1
        have h_term : ∀ x : G,
            (if h : x * c.1 * x⁻¹ ∈ H then
              ((1 : H →* (Ω F)ˣ) ⟨x * c.1 * x⁻¹, h⟩ : Ω F)
            else 0) = 1 := by
          intro x
          have hx1 : x * c.1 * x⁻¹ = 1 := by rw [hc_val]; group
