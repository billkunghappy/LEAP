  have hr_e_tr_in : r_e = 0 ∨ 2 * ((e : ℤ) + 1) - (condExp F L νE' : ℤ) ≤ valL F E' r_e := by
    rcases hr_e_dom with h0 | hge
    · exact Or.inl h0
    · right; omega
  have htr_r_e : traceLM F hLE' r_e = 0 ∨ (e : ℤ) + 1 ≤ valL F L (traceLM F hLE' r_e) :=
    htr_LE' ((e : ℤ) + 1) r_e hr_e_tr_in
  have hce_eq : (c_e : L) = (2 : L) * (c 0) + traceLM F hLE' r_e := by
    have h := congrArg (traceLM F hLE') hy_e_decomp
    rw [hy_e_tr, map_add, htr_incl (c 0)] at h
