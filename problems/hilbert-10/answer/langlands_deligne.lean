      rw [hπ w x]
      exact hw x.1 ((IntermediateField.mem_extendScalars hLK).mp x.2)
  let toSub_i : Fin r_orb → IntermediateField L K' :=
    fun i => (IntermediateField.extendScalars (D_orb.get i).le).comap K'.val
  let M_sub : Fin r_orb → Subgroup G := fun i => (toSub_i i).fixingSubgroup
  have hM_sub_mem : ∀ (i : Fin r_orb) (g : G),
      g ∈ M_sub i ↔
        ∀ (x : AlgebraicClosure F) (hx : x ∈ (D_orb.get i).field),
          ((g ⟨x, (IntermediateField.mem_extendScalars hLK).mpr
            (hM_CK (hFiMC i hx))⟩ : K') : AlgebraicClosure F) = x := by
    intro i g
    rw [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hg x hx
      let y : K' := ⟨x, (IntermediateField.mem_extendScalars hLK).mpr (hM_CK (hFiMC i hx))⟩
      have hy : y ∈ toSub_i i := (IntermediateField.mem_extendScalars (D_orb.get i).le).mpr hx
