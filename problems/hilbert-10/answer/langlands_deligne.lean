    hdegE'K₁.symm ▸ hPrime
  have hp_odd_E'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) ≠ 2 :=
    (hdegE'K₁.trans hWild).symm ▸ hp_odd
  have hPrime_M₁'K₁ : Nat.Prime (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) :=
    hdegM₁'K₁.symm ▸ hPrime
  have hp_odd_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) ≠ 2 :=
    (hdegM₁'K₁.trans hWild).symm ▸ hp_odd
  have hval_LM₁'_deg : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLM₁') : ℤ) * valL F L x := by
    intro x; rw [hdegM₁']; exact hval_LM₁' x
  have htr_LM₁'_deg : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLM₁') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLM₁') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)) := by
    intro m z hz; rw [hdegM₁'] at hz; exact htr_LM₁' m z hz
  have hval_E'K₁_deg : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * valL F E' y := by
    intro y; rw [hdegE'K₁]; exact hval_E'K₁ y
  have htr_E'K₁_deg : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * m -
          ((Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)) := by
    intro m w hw; rw [hdegE'K₁] at hw; exact htr_E'K₁ m w hw
  have hval_M₁'K₁_deg : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
