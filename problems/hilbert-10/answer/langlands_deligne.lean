        _ = σ (c.1 * x) w_bar := by rw [← map_mul]
        _ = σ (x * (x⁻¹ * c.1 * x)) w_bar := by rw [h_grp]
        _ = σ x (σ (x⁻¹ * c.1 * x) w_bar) := by rw [map_mul, Module.End.mul_apply]
