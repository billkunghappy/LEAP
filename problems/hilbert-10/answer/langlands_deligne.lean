      rwa [h_fixing_toSub_fieldOf (H ⊔ C), h_toSub_bot, IntermediateField.fixingSubgroup_bot] at h_fix
    have hG_mul : ∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c := by
      let S : Subgroup G :=
        { carrier := {g : G | ∃ h ∈ H, ∃ c ∈ C, g = h * c}
          one_mem' := ⟨1, H.one_mem, 1, C.one_mem, (mul_one 1).symm⟩
          mul_mem' := by
            rintro g₁ g₂ ⟨h₁, hh₁, c₁, hc₁, rfl⟩ ⟨h₂, hh₂, c₂, hc₂, rfl⟩
            refine ⟨h₁ * h₂, H.mul_mem hh₁ hh₂, h₂⁻¹ * c₁ * h₂ * c₂, ?_, by group⟩
            have hconj : h₂⁻¹ * c₁ * (h₂⁻¹)⁻¹ ∈ C := hC_norm.conj_mem c₁ hc₁ h₂⁻¹
            have heq : h₂⁻¹ * c₁ * h₂ = h₂⁻¹ * c₁ * (h₂⁻¹)⁻¹ := by group
            rw [heq]
            exact C.mul_mem hconj hc₂
          inv_mem' := by
            rintro g ⟨h, hh, c, hc, rfl⟩
            refine ⟨h⁻¹, H.inv_mem hh, h * c⁻¹ * h⁻¹, hC_norm.conj_mem c⁻¹ (C.inv_mem hc) h, by group⟩ }
      have hH_le_S : H ≤ S := fun h hh => ⟨h, hh, 1, C.one_mem, (mul_one h).symm⟩
      have hC_le_S : C ≤ S := fun c hc => ⟨1, H.one_mem, c, hc, (one_mul c).symm⟩
      have h_top_le_S : (⊤ : Subgroup G) ≤ S := by
        rw [← h_sup_HC]
        exact sup_le hH_le_S hC_le_S
      intro g
      exact h_top_le_S (Subgroup.mem_top g)
    let f_mul : H × C → G := fun p => p.1.1 * p.2.1
    have hf_inj : Function.Injective f_mul := by
      rintro ⟨⟨h₁, hh₁⟩, ⟨c₁, hc₁⟩⟩ ⟨⟨h₂, hh₂⟩, ⟨c₂, hc₂⟩⟩ heq
      dsimp [f_mul] at heq
      have h_eq_inv : h₂⁻¹ * h₁ = c₂ * c₁⁻¹ := by
        calc h₂⁻¹ * h₁ = h₂⁻¹ * (h₁ * c₁) * c₁⁻¹ := by group
          _ = h₂⁻¹ * (h₂ * c₂) * c₁⁻¹ := by rw [heq]
          _ = c₂ * c₁⁻¹ := by group
      have h_in_H : h₂⁻¹ * h₁ ∈ H := H.mul_mem (H.inv_mem hh₂) hh₁
      have h_in_C : h₂⁻¹ * h₁ ∈ C := by
        rw [h_eq_inv]
        exact C.mul_mem hc₂ (C.inv_mem hc₁)
      have h_one : h₂⁻¹ * h₁ = 1 := h_disj_HC (h₂⁻¹ * h₁) h_in_H h_in_C
      have hh_eq : h₁ = h₂ := by
        calc h₁ = h₂ * (h₂⁻¹ * h₁) := by group
          _ = h₂ * 1 := by rw [h_one]
          _ = h₂ := mul_one h₂
      have hc_eq : c₁ = c₂ := by
        subst hh_eq
        exact mul_left_cancel heq
      exact Prod.ext (Subtype.ext hh_eq) (Subtype.ext hc_eq)
    have hf_surj : Function.Surjective f_mul := by
      intro g
      obtain ⟨h, hh, c, hc, rfl⟩ := hG_mul g
      exact ⟨⟨⟨h, hh⟩, ⟨c, hc⟩⟩, rfl⟩
    have h_card_G_mul : Nat.card G = Nat.card H * Nat.card C := by
      rw [← Nat.card_congr (Equiv.ofBijective f_mul ⟨hf_inj, hf_surj⟩), Nat.card_prod]
    have h_finrank_mul_card : ∀ (A : IntermediateField F (AlgebraicClosure F))
        (hLA : L ≤ A) (hAK : A ≤ K),
        Module.finrank L (IntermediateField.extendScalars hLA) *
          Nat.card ((toSub A hLA).fixingSubgroup) = Module.finrank L K' ∧
        Module.finrank L (IntermediateField.extendScalars hLA) *
          Module.finrank A (IntermediateField.extendScalars hAK) = Module.finrank L K' ∧
        Nat.card ((toSub A hLA).fixingSubgroup) =
          Module.finrank A (IntermediateField.extendScalars hAK) := by
      intro A hLA hAK
      let A' : IntermediateField L K' := toSub A hLA
      let A_ext : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLA
      have hmul_fix : Module.finrank L ↥A_ext * Nat.card A'.fixingSubgroup =
          Module.finrank L ↥K' :=
        h_abs_finrank ↥L ↥K' (AlgebraicClosure F) K'.val A_ext (fun z hz =>
          ⟨⟨z, (IntermediateField.mem_extendScalars hLK).mpr
            (hAK ((IntermediateField.mem_extendScalars hLA).mp hz))⟩, rfl⟩)
      obtain ⟨hmul_tower, hLA_pos, _⟩ := h_tower_finrank L A K hLK hLA hAK
      have hcard_eq : Nat.card A'.fixingSubgroup =
          Module.finrank A ↥(IntermediateField.extendScalars hAK) := by
        apply Nat.eq_of_mul_eq_mul_left hLA_pos
        rw [hmul_fix, hmul_tower]
      exact ⟨hmul_fix, hmul_tower, hcard_eq⟩
    have hCard_C : Nat.card C = ℓ := (h_finrank_mul_card M_C hLM_C hM_CK).2.2
    have h_card_G_finrank : Nat.card G = Module.finrank L K' :=
      IsGalois.card_aut_eq_finrank L K'
    have hCard_H : Nat.card H = f_H := by
      have hC_pos : 0 < Nat.card C := Nat.card_pos
      apply Nat.eq_of_mul_eq_mul_right hC_pos
      rw [← h_card_G_mul, h_card_G_finrank, ← (h_finrank_mul_card M_C hLM_C hM_CK).1]
    have h_mem_fixing : ∀ (A : IntermediateField F (AlgebraicClosure F))
        (hLA : L ≤ A) (hAK : A ≤ K) (w : relWeil F L),
        w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ π w ∈ (toSub A hLA).fixingSubgroup := by
      intro A hLA hAK w
      change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ A.fixingSubgroup) ↔
        π w ∈ (toSub A hLA).fixingSubgroup
      have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
      rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff,
        IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hw x hx
        apply Subtype.ext
        rw [hπ w x]
        exact hw x.1 ((h_mem_toSub A hLA x).mp hx)
      · intro hπw z hzA
        let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hAK hzA)⟩
        have hxA : x ∈ toSub A hLA := (h_mem_toSub A hLA x).mpr hzA
        have h1 := hπ w x
        have h2 : π w x = x := hπw x hxA
        rw [h2] at h1
        exact h1.symm
    have h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H :=
      h_mem_fixing E hLE hEK
    have h_mem_C : ∀ w : relWeil F L, w ∈ (relWeil F M_C).subgroupOf (relWeil F L) ↔ π w ∈ C :=
      h_mem_fixing M_C hLM_C hM_CK
    have h_mem_K : ∀ w : relWeil F L, (w : AbsGal F) ∈ K.fixingSubgroup ↔ π w = 1 := by
      intro w
      have h1 := h_mem_fixing K hLK le_rfl w
      change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ K.fixingSubgroup) ↔
        π w ∈ (toSub K hLK).fixingSubgroup at h1
      have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
      rw [and_iff_right hw_weil, h_toSub_top, IntermediateField.fixingSubgroup_top,
        Subgroup.mem_bot] at h1
      exact h1
    have h_mem_K_eq : ∀ w₁ w₂ : relWeil F L,
        π w₁ = π w₂ → ((w₁⁻¹ * w₂ : relWeil F L) : AbsGal F) ∈ K.fixingSubgroup := by
      intro w₁ w₂ h_eq
      have h1 : π (w₁⁻¹ * w₂) = 1 := by
        rw [map_mul, map_inv, h_eq, inv_mul_cancel]
      exact (h_mem_K (w₁⁻¹ * w₂)).mpr h1
    have hAb_imp : (∀ h₁ h₂ : H, h₁ * h₂ = h₂ * h₁) → IsAbelianExt F hLM_C := by
      intro hH_ab
      refine ⟨hMin.1.2.2.1, ?_, hMin.1.2.2.2 hLM_C⟩
      intro σ hσ τ hτ
      let σ' : L.fixingSubgroup := ⟨σ, hσ⟩
      let τ' : L.fixingSubgroup := ⟨τ, hτ⟩
      obtain ⟨h₁, hh₁, c₁, hc₁, hσ_eq⟩ := hG_mul (res_L σ')
      obtain ⟨h₂, hh₂, c₂, hc₂, hτ_eq⟩ := hG_mul (res_L τ')
      have hh_comm : h₁ * h₂ = h₂ * h₁ := congrArg Subtype.val (hH_ab ⟨h₁, hh₁⟩ ⟨h₂, hh₂⟩)
      have h_comm_eq_C :
          res_L (σ' * τ' * σ'⁻¹ * τ'⁻¹) =
            (h₁ * c₁ * h₁⁻¹) * ((h₂ * h₁) * (c₂ * c₁⁻¹) * (h₂ * h₁)⁻¹) * (h₂ * c₂⁻¹ * h₂⁻¹) := by
        rw [map_mul, map_mul, map_mul, map_inv, map_inv, hσ_eq, hτ_eq]
        calc (h₁ * c₁) * (h₂ * c₂) * (h₁ * c₁)⁻¹ * (h₂ * c₂)⁻¹
            = (h₁ * c₁ * h₁⁻¹) * ((h₁ * h₂) * (c₂ * c₁⁻¹ * h₁⁻¹ * c₂⁻¹ * h₂⁻¹)) := by group
          _ = (h₁ * c₁ * h₁⁻¹) * ((h₂ * h₁) * (c₂ * c₁⁻¹ * h₁⁻¹ * c₂⁻¹ * h₂⁻¹)) := by rw [hh_comm]
          _ = (h₁ * c₁ * h₁⁻¹) * ((h₂ * h₁) * (c₂ * c₁⁻¹) * (h₂ * h₁)⁻¹) * (h₂ * c₂⁻¹ * h₂⁻¹) := by group
      have h_in_C : res_L (σ' * τ' * σ'⁻¹ * τ'⁻¹) ∈ C := by
        rw [h_comm_eq_C]
        have hc1 : h₁ * c₁ * h₁⁻¹ ∈ C := hC_norm.conj_mem c₁ hc₁ h₁
        have hc2 : (h₂ * h₁) * (c₂ * c₁⁻¹) * (h₂ * h₁)⁻¹ ∈ C :=
          hC_norm.conj_mem (c₂ * c₁⁻¹) (C.mul_mem hc₂ (C.inv_mem hc₁)) (h₂ * h₁)
        have hc3 : h₂ * c₂⁻¹ * h₂⁻¹ ∈ C := hC_norm.conj_mem c₂⁻¹ (C.inv_mem hc₂) h₂
        exact C.mul_mem (C.mul_mem hc1 hc2) hc3
      exact (h_res_fix M_C hLM_C hM_CK (σ' * τ' * σ'⁻¹ * τ'⁻¹)).mpr h_in_C
    have hCent_imp : (∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1) →
        ∀ σ ∈ L.fixingSubgroup,
          (∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) →
          σ ∈ M_C.fixingSubgroup := by
      intro hZ_H σ hσ h_comm_K
      let σ' : L.fixingSubgroup := ⟨σ, hσ⟩
      obtain ⟨h, hh, c₀, hc₀, hσ_eq⟩ := hG_mul (res_L σ')
      have hh_comm : ∀ c ∈ C, h * c = c * h := by
        intro c hc
        obtain ⟨τ', hτ'⟩ := h_res_surj c
        have hτ'M : τ'.1 ∈ M_C.fixingSubgroup :=
          (h_res_fix M_C hLM_C hM_CK τ').mpr (hτ'.symm ▸ hc)
        have hcomm1 : res_L (σ' * τ' * σ'⁻¹ * τ'⁻¹) = 1 :=
          (h_res_K (σ' * τ' * σ'⁻¹ * τ'⁻¹)).mp (h_comm_K τ'.1 hτ'M)
        rw [map_mul, map_mul, map_mul, map_inv, map_inv, hσ_eq, hτ'] at hcomm1
        have h_hc₀ : (h * c₀) * c = c * (h * c₀) := h_comm_eq G (h * c₀) c hcomm1
        calc h * c = h * (c * c₀) * c₀⁻¹ := by group
          _ = h * (c₀ * c) * c₀⁻¹ := by rw [← hC_ab c₀ hc₀ c hc]
          _ = ((h * c₀) * c) * c₀⁻¹ := by group
          _ = (c * (h * c₀)) * c₀⁻¹ := by rw [h_hc₀]
          _ = c * h := by group
      have hh1 : h = 1 := hZ_H h hh hh_comm
      have hσ_C : res_L σ' ∈ C := by
        rw [hσ_eq, hh1, one_mul]
        exact hc₀
      exact (h_res_fix M_C hLM_C hM_CK σ').mpr hσ_C
    exact ⟨π, C, H, hC_norm, hsurj, hC_ab, h_disj_HC, hG_mul, hCard_C, hCard_H,
      h_mem_H, h_mem_C, h_mem_K, h_mem_K_eq, hAb_imp, hCent_imp⟩
  obtain ⟨π, C, H, hC_norm, hsurj, hC_ab, h_disj_HC, hG_mul, hCard_C, hCard_H,
    h_mem_H, h_mem_C, h_mem_K, h_mem_K_eq, hAb_imp, hCent_imp⟩ := h_gal_setup
  haveI : C.Normal := hC_norm
  letI : Fintype H := Fintype.ofFinite H
  letI : Fintype C := Fintype.ofFinite C
  let f_mul : H × C → G := fun p => p.1.1 * p.2.1
  have hf_inj : Function.Injective f_mul := by
    rintro ⟨⟨h₁, hh₁⟩, ⟨c₁, hc₁⟩⟩ ⟨⟨h₂, hh₂⟩, ⟨c₂, hc₂⟩⟩ heq
    dsimp [f_mul] at heq
    have h_eq_inv : h₂⁻¹ * h₁ = c₂ * c₁⁻¹ := by
      calc h₂⁻¹ * h₁ = h₂⁻¹ * (h₁ * c₁) * c₁⁻¹ := by group
        _ = h₂⁻¹ * (h₂ * c₂) * c₁⁻¹ := by rw [heq]
        _ = c₂ * c₁⁻¹ := by group
    have h_in_H : h₂⁻¹ * h₁ ∈ H := H.mul_mem (H.inv_mem hh₂) hh₁
    have h_in_C : h₂⁻¹ * h₁ ∈ C := by
      rw [h_eq_inv]
      exact C.mul_mem hc₂ (C.inv_mem hc₁)
    have h_one : h₂⁻¹ * h₁ = 1 := h_disj_HC (h₂⁻¹ * h₁) h_in_H h_in_C
    have hh_eq : h₁ = h₂ := by
      calc h₁ = h₂ * (h₂⁻¹ * h₁) := by group
        _ = h₂ * 1 := by rw [h_one]
        _ = h₂ := mul_one h₂
    have hc_eq : c₁ = c₂ := by
      subst hh_eq
      exact mul_left_cancel heq
    exact Prod.ext (Subtype.ext hh_eq) (Subtype.ext hc_eq)
  have hf_surj : Function.Surjective f_mul := by
    intro g
    obtain ⟨h, hh, c, hc, rfl⟩ := hG_mul g
    exact ⟨⟨⟨h, hh⟩, ⟨c, hc⟩⟩, rfl⟩
  let e_HC : H × C ≃ G := Equiv.ofBijective f_mul ⟨hf_inj, hf_surj⟩
  have h_card_G_mul : Nat.card G = Nat.card H * Nat.card C := by
    rw [← Nat.card_congr e_HC, Nat.card_prod]
  let ι_MC : relWeil F M_C →* relWeil F L := Subgroup.inclusion (relWeil_antitone F hLM_C)
  let π_MC : relWeil F M_C →* C :=
    { toFun := fun w => ⟨π (ι_MC w), (h_mem_C (ι_MC w)).mp w.2⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun x y => Subtype.ext (by simp) }
  have h_ker_π_MC : ∀ w : relWeil F M_C, (w : AbsGal F) ∈ K.fixingSubgroup ↔ π_MC w = 1 := by
    intro w
    exact (h_mem_K (ι_MC w)).trans ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩
  have hπ_MC_surj : Function.Surjective π_MC := by
    intro c
    obtain ⟨w_L, hw_L⟩ := hsurj c.1
    have hw_C : π w_L ∈ C := hw_L.symm ▸ c.2
    let w_MC : relWeil F M_C := ⟨w_L.1, (h_mem_C w_L).mpr hw_C⟩
    have hι : ι_MC w_MC = w_L := Subtype.ext rfl
    refine ⟨w_MC, Subtype.ext ?_⟩
    change π (ι_MC w_MC) = c.1
    rw [hι, hw_L]
  let s_C : C → relWeil F M_C := fun c => (hπ_MC_surj c).choose
  have hs_C : ∀ c : C, π_MC (s_C c) = c := fun c => (hπ_MC_surj c).choose_spec
  have hμ_ker_K : ∀ (i : Fin r) (w : relWeil F M_C),
      (w : AbsGal F) ∈ K.fixingSubgroup → μ_orb i w = 1 := by
    intro i w hwK
    let w_K : relWeil F K := ⟨w.1, w.2.1, hwK⟩
    have h_inc : Subgroup.inclusion (relWeil_antitone F hM_CK) w_K = w := Subtype.ext rfl
    calc μ_orb i w = restrictWeilChar F hM_CK (μ_orb i) w_K := by
          rw [← h_inc]; rfl
      _ = 1 := by rw [(hμ_props i).2.1]; rfl
  have hμ_sec : ∀ (i : Fin r) (w : relWeil F M_C), μ_orb i (s_C (π_MC w)) = μ_orb i w := by
    intro i w
    have hwK : (((s_C (π_MC w))⁻¹ * w : relWeil F M_C) : AbsGal F) ∈ K.fixingSubgroup :=
      h_mem_K_eq (ι_MC (s_C (π_MC w))) (ι_MC w) (congrArg Subtype.val (hs_C (π_MC w)))
    have h1 : μ_orb i ((s_C (π_MC w))⁻¹ * w) = 1 := hμ_ker_K i _ hwK
    calc μ_orb i (s_C (π_MC w))
        = μ_orb i (s_C (π_MC w)) * μ_orb i ((s_C (π_MC w))⁻¹ * w) := by rw [h1, mul_one]
      _ = μ_orb i (s_C (π_MC w) * ((s_C (π_MC w))⁻¹ * w)) := (map_mul (μ_orb i) _ _).symm
      _ = μ_orb i w := by rw [mul_inv_cancel_left]
  let μ_bar : Fin r → (C →* (Ω F)ˣ) := fun i =>
    { toFun := fun c => μ_orb i (s_C c)
      map_one' := by
        calc μ_orb i (s_C 1) = μ_orb i (s_C (π_MC 1)) := by rw [map_one]
          _ = μ_orb i 1 := hμ_sec i 1
          _ = 1 := map_one (μ_orb i)
      map_mul' := fun c₁ c₂ => by
        calc μ_orb i (s_C (c₁ * c₂)) = μ_orb i (s_C (π_MC (s_C c₁ * s_C c₂))) := by
              rw [map_mul, hs_C c₁, hs_C c₂]
          _ = μ_orb i (s_C c₁ * s_C c₂) := hμ_sec i (s_C c₁ * s_C c₂)
          _ = μ_orb i (s_C c₁) * μ_orb i (s_C c₂) := map_mul (μ_orb i) _ _ }
  have hμ_bar_props : ∀ i : Fin r,
      (∀ w : relWeil F M_C, μ_orb i w = μ_bar i (π_MC w)) ∧
      (μ_bar i) ^ ℓ = 1 ∧
      μ_bar i ≠ 1 := by
    intro i
    refine ⟨fun w => (hμ_sec i w).symm, ?_, ?_⟩
    · apply MonoidHom.ext
      intro c
      change (μ_orb i (s_C c)) ^ ℓ = 1
      rw [← MonoidHom.pow_apply, (hμ_props i).2.2.1, MonoidHom.one_apply]
    · intro h_one
      apply (hμ_props i).2.2.2
      apply MonoidHom.ext
      intro w
      rw [(hμ_sec i w).symm]
      exact DFunLike.congr_fun h_one (π_MC w)
  let G_L := relWeil F L
  have h_bridge : ∀ (E₁ : IntermediateField F (AlgebraicClosure F))
      (hLE₁ : L ≤ E₁) (M : Subgroup G)
      (h_mem : ∀ w : G_L, w ∈ (relWeil F E₁).subgroupOf G_L ↔ π w ∈ M)
      (ψ : M →* (Ω F)ˣ),
      let ι : relWeil F E₁ →* G_L := Subgroup.inclusion (relWeil_antitone F hLE₁)
      let π_E₁ : relWeil F E₁ →* M :=
        { toFun := fun w => ⟨π (ι w), (h_mem (ι w)).mp w.2⟩
          map_one' := Subtype.ext (by simp)
          map_mul' := fun x y => Subtype.ext (by simp) }
      let χ_E₁ : relWeil F E₁ →* (Ω F)ˣ := ψ.comp π_E₁
      ∀ w : G_L,
        (⟨1, E₁, hLE₁, χ_E₁⟩ : MonomialTerm F L).trace F L w = indCharTrace F M ψ (π w) := by
    intro E₁ hLE₁ M h_mem ψ ι π_E₁ χ_E₁ w
    let H_E₁ : Subgroup G_L := (relWeil F E₁).subgroupOf G_L
    let W := ULift.{u} (Ω F)
    let e_sub : H_E₁ ≃* relWeil F E₁ := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE₁)
    let ρ_E₁ : Representation (Ω F) H_E₁ W := (charRep F E₁ χ_E₁).comp e_sub.toMonoidHom
    let s : G ⧸ M → G_L := fun u₀ => (hsurj (cosetRep u₀)).choose
    have hs_spec : ∀ u₀ : G ⧸ M, π (s u₀) = cosetRep u₀ :=
      fun u₀ => (hsurj (cosetRep u₀)).choose_spec
    let u : G_L → G ⧸ M := fun x => QuotientGroup.mk (π x)⁻¹
    let r_map : G_L → G_L := fun x => s (u x)
    have h_xr_mem : ∀ x : G_L, x * r_map x ∈ H_E₁ := by
      intro x
      rw [h_mem]
      change π (x * s (u x)) ∈ M
      rw [map_mul, hs_spec (u x)]
      have hout : QuotientGroup.mk (s := M) (cosetRep (u x)) = QuotientGroup.mk (s := M) (π x)⁻¹ :=
        Quotient.out_eq (u x)
      have hrel : (cosetRep (u x))⁻¹ * (π x)⁻¹ ∈ M := QuotientGroup.eq.mp hout
      have hinv : (π x * cosetRep (u x))⁻¹ ∈ M := by
        have heq : (π x * cosetRep (u x))⁻¹ = (cosetRep (u x))⁻¹ * (π x)⁻¹ := mul_inv_rev _ _
        rw [heq]
        exact hrel
      exact M.inv_mem_iff.mp hinv
    have hu_mul : ∀ (h₀ : H_E₁) (x : G_L), u ((h₀ : G_L) * x) = u x := by
      intro h₀ x
      change QuotientGroup.mk (s := M) (π ((h₀ : G_L) * x))⁻¹ = QuotientGroup.mk (s := M) (π x)⁻¹
      rw [QuotientGroup.eq]
      have heq : ((π ((h₀ : G_L) * x))⁻¹)⁻¹ * (π x)⁻¹ = π (h₀ : G_L) := by
        rw [inv_inv, map_mul, mul_inv_cancel_right]
      rw [heq]
      exact (h_mem (h₀ : G_L)).mp h₀.2
    have hr_mul : ∀ (h₀ : H_E₁) (x : G_L), r_map ((h₀ : G_L) * x) = r_map x := by
      intro h₀ x
      exact congrArg s (hu_mul h₀ x)
    have hu_rep_inv : ∀ u₀ : G ⧸ M, u (s u₀)⁻¹ = u₀ := by
      intro u₀
      change QuotientGroup.mk (s := M) (π (s u₀)⁻¹)⁻¹ = u₀
      rw [map_inv, inv_inv, hs_spec u₀]
      exact Quotient.out_eq u₀
    have hr_rep_inv : ∀ u₀ : G ⧸ M, r_map (s u₀)⁻¹ = s u₀ := by
      intro u₀
      exact congrArg s (hu_rep_inv u₀)
    have hu_iff : ∀ u₀ : G ⧸ M,
        u ((s u₀)⁻¹ * w) = u₀ ↔ (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M := by
      intro u₀
      have h1 : u ((s u₀)⁻¹ * w) = QuotientGroup.mk (s := M) (π ((s u₀)⁻¹ * w))⁻¹ := rfl
      have h2 : u₀ = QuotientGroup.mk (s := M) (cosetRep u₀) := (Quotient.out_eq u₀).symm
      rw [h1]
      conv_lhs => rhs; rw [h2]
      rw [QuotientGroup.eq, inv_inv, map_mul, map_inv, hs_spec u₀]
    let Φ : indSpace H_E₁ ρ_E₁ ≃ₗ[Ω F] ((G ⧸ M) → Ω F) :=
      { toFun := fun f u₀ => (f.1 (s u₀)⁻¹).down
        map_add' := fun f₁ f₂ => funext fun u₀ => rfl
        map_smul' := fun c f => funext fun u₀ => rfl
        invFun := fun φ =>
          ⟨fun x => ρ_E₁ ⟨x * r_map x, h_xr_mem x⟩ (ULift.up (φ (u x))), by
            intro h₀ x
            dsimp only
            rw [hu_mul h₀ x]
            have hsub : (⟨((h₀ : G_L) * x) * r_map ((h₀ : G_L) * x), h_xr_mem ((h₀ : G_L) * x)⟩ : H_E₁) =
                h₀ * ⟨x * r_map x, h_xr_mem x⟩ := by
              apply Subtype.ext
              change ((h₀ : G_L) * x) * r_map ((h₀ : G_L) * x) = (h₀ : G_L) * (x * r_map x)
              rw [hr_mul h₀ x, mul_assoc]
            rw [hsub, map_mul, Module.End.mul_apply]⟩
        left_inv := fun f => by
          apply Subtype.ext
          funext x
          dsimp only
          have h_eq : f.1 ((x * r_map x) * (r_map x)⁻¹) =
              ρ_E₁ ⟨x * r_map x, h_xr_mem x⟩ (f.1 (r_map x)⁻¹) :=
            f.2 ⟨x * r_map x, h_xr_mem x⟩ (r_map x)⁻¹
          have h_cancel : (x * r_map x) * (r_map x)⁻¹ = x := mul_inv_cancel_right x (r_map x)
          rw [h_cancel] at h_eq
          exact h_eq.symm
        right_inv := fun φ => by
          funext u₀
          dsimp only
          rw [hu_rep_inv u₀]
          have h_one : (⟨(s u₀)⁻¹ * r_map (s u₀)⁻¹, h_xr_mem (s u₀)⁻¹⟩ : H_E₁) = 1 := by
            apply Subtype.ext
            change (s u₀)⁻¹ * r_map (s u₀)⁻¹ = 1
            rw [hr_rep_inv u₀, inv_mul_cancel]
          rw [h_one, map_one, Module.End.one_apply] }
    let T : ((G ⧸ M) → Ω F) →ₗ[Ω F] ((G ⧸ M) → Ω F) := Φ.conj (indRep H_E₁ ρ_E₁ w)
    have h_tr_ind : LinearMap.trace (Ω F) (indSpace H_E₁ ρ_E₁) (indRep H_E₁ ρ_E₁ w) =
        ∑ u₀ : G ⧸ M,
          if hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M then
            (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)
          else 0 := by
      have h_conj : LinearMap.trace (Ω F) (indSpace H_E₁ ρ_E₁) (indRep H_E₁ ρ_E₁ w) =
          LinearMap.trace (Ω F) ((G ⧸ M) → Ω F) T :=
        (LinearMap.trace_conj' (indRep H_E₁ ρ_E₁ w) Φ).symm
      rw [h_conj]
      have h_decomp : T = ∑ u₀ : G ⧸ M,
          (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀).comp
            ((LinearMap.proj u₀).comp T) := by
        apply LinearMap.ext
        intro φ
        funext u₁
        simp [LinearMap.sum_apply, LinearMap.comp_apply]
      rw [h_decomp, map_sum]
      apply Finset.sum_congr rfl
      intro u₀ _
      have h_comm : LinearMap.trace (Ω F) ((G ⧸ M) → Ω F)
          ((LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀).comp
            ((LinearMap.proj u₀).comp T)) =
          LinearMap.trace (Ω F) (Ω F)
            (((LinearMap.proj u₀).comp T).comp
              (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)) :=
        (LinearMap.trace_comp_comm'
          (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)
          ((LinearMap.proj u₀).comp T)).symm
      rw [h_comm]
      let B : Ω F →ₗ[Ω F] Ω F :=
        ((LinearMap.proj u₀).comp T).comp (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)
      change LinearMap.trace (Ω F) (Ω F) B = _
      by_cases hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M
      · rw [dif_pos hc]
        have hu_eq : u ((s u₀)⁻¹ * w) = u₀ := (hu_iff u₀).mpr hc
        have hr_eq : r_map ((s u₀)⁻¹ * w) = s u₀ := congrArg s hu_eq
        have hB : B = (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F) • LinearMap.id := by
          apply LinearMap.ext
          intro a
          change (ρ_E₁ ⟨((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (ULift.up (Pi.single (M := fun _ : G ⧸ M => Ω F) u₀ a (u ((s u₀)⁻¹ * w))))).down =
            (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F) * a
          rw [hu_eq, Pi.single_eq_same]
          have h_πE₁ : π_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) =
              ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ := by
            apply Subtype.ext
            change π (((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w)) = (cosetRep u₀)⁻¹ * π w * cosetRep u₀
            rw [hr_eq, map_mul, map_mul, map_inv, hs_spec u₀]
          change (χ_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) : Ω F) * a = _
          have h_χ : χ_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) =
              ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ := by
            change ψ (π_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩)) = _
            rw [h_πE₁]
          rw [h_χ]
        rw [hB, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one, smul_eq_mul, mul_one]
      · rw [dif_neg hc]
        have hu_ne : u ((s u₀)⁻¹ * w) ≠ u₀ := fun h => hc ((hu_iff u₀).mp h)
        have hB : B = 0 := by
          apply LinearMap.ext
          intro a
          change (ρ_E₁ ⟨((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (ULift.up (Pi.single (M := fun _ : G ⧸ M => Ω F) u₀ a (u ((s u₀)⁻¹ * w))))).down = 0
          rw [Pi.single_eq_of_ne hu_ne]
          change (ρ_E₁ ⟨((s u₀)⁻¹ * w) * r_map ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (0 : W)).down = 0
          rw [map_zero]
          rfl
        rw [hB, map_zero]
    let u_G : G → G ⧸ M := fun x => QuotientGroup.mk x⁻¹
    let r_G : G → G := fun x => cosetRep (u_G x)
    have h_xr_G : ∀ x : G, x * r_G x ∈ M := by
      intro x
      have hout : QuotientGroup.mk (s := M) (r_G x) = QuotientGroup.mk (s := M) x⁻¹ :=
        Quotient.out_eq (u_G x)
      have hrel : (r_G x)⁻¹ * x⁻¹ ∈ M := QuotientGroup.eq.mp hout
      have hinv : (x * r_G x)⁻¹ ∈ M := by
        have heq : (x * r_G x)⁻¹ = (r_G x)⁻¹ * x⁻¹ := mul_inv_rev _ _
        rw [heq]
        exact hrel
      exact M.inv_mem_iff.mp hinv
    have hu_mul_G : ∀ (y : M) (x : G), u_G ((y : G) * x) = u_G x := by
      intro y x
      change QuotientGroup.mk (s := M) ((y : G) * x)⁻¹ = QuotientGroup.mk (s := M) x⁻¹
      rw [QuotientGroup.eq]
      have heq : (((y : G) * x)⁻¹)⁻¹ * x⁻¹ = (y : G) := by
        rw [inv_inv, mul_inv_cancel_right]
      rw [heq]
      exact y.2
    have hr_mul_G : ∀ (y : M) (x : G), r_G ((y : G) * x) = r_G x := by
      intro y x
      exact congrArg cosetRep (hu_mul_G y x)
    have hu_rep_G : ∀ u₀ : G ⧸ M, u_G (cosetRep u₀)⁻¹ = u₀ := by
      intro u₀
      change QuotientGroup.mk (s := M) ((cosetRep u₀)⁻¹)⁻¹ = u₀
      rw [inv_inv]
      exact Quotient.out_eq u₀
    have hr_rep_G : ∀ u₀ : G ⧸ M, r_G (cosetRep u₀)⁻¹ = cosetRep u₀ := by
      intro u₀
      exact congrArg cosetRep (hu_rep_G u₀)
    let e_coset : (G ⧸ M) × M ≃ G :=
      { toFun := fun p => (p.2 : G) * (cosetRep p.1)⁻¹
        invFun := fun x => (u_G x, ⟨x * r_G x, h_xr_G x⟩)
        left_inv := fun ⟨u₀, y⟩ => by
          dsimp only
          have hu : u_G ((y : G) * (cosetRep u₀)⁻¹) = u₀ := by
            rw [hu_mul_G y (cosetRep u₀)⁻¹, hu_rep_G u₀]
          have hr : r_G ((y : G) * (cosetRep u₀)⁻¹) = cosetRep u₀ := by
            rw [hr_mul_G y (cosetRep u₀)⁻¹, hr_rep_G u₀]
          ext
          · exact hu
          · dsimp only
            rw [hr, inv_mul_cancel_right]
        right_inv := fun x => by
          dsimp only
          exact mul_inv_cancel_right x (r_G x) }
    have h_indChar : indCharTrace F M ψ (π w) =
        ∑ u₀ : G ⧸ M,
          if hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M then
            (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)
          else 0 := by
      unfold indCharTrace
      set g := π w
      have h_sum_eq : (∑ x : G, if h : x * g * x⁻¹ ∈ M then (ψ ⟨x * g * x⁻¹, h⟩ : Ω F) else 0) =
          ∑ p : (G ⧸ M) × M,
            if h : e_coset p * g * (e_coset p)⁻¹ ∈ M then
              (ψ ⟨e_coset p * g * (e_coset p)⁻¹, h⟩ : Ω F)
            else 0 :=
        (Fintype.sum_equiv e_coset _ _ (fun _ => rfl)).symm
      rw [h_sum_eq, Fintype.sum_prod_type]
      have h_inner : ∀ u₀ : G ⧸ M,
          (∑ y : M,
            if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M then
              (ψ ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : Ω F)
            else 0) =
          (Nat.card M : Ω F) *
            if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ M then
              (ψ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩ : Ω F)
            else 0 := by
        intro u₀
        set c := (cosetRep u₀)⁻¹ * g * cosetRep u₀
        have h_term : ∀ y : M,
            (if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M then
              (ψ ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : Ω F)
            else 0) =
            if hc : c ∈ M then (ψ ⟨c, hc⟩ : Ω F) else 0 := by
          intro y
          have h_conj_y : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ = (y : G) * c * (y : G)⁻¹ := by
            change ((y : G) * (cosetRep u₀)⁻¹) * g * ((y : G) * (cosetRep u₀)⁻¹)⁻¹ =
              (y : G) * ((cosetRep u₀)⁻¹ * g * cosetRep u₀) * (y : G)⁻¹
            group
          have h_mem_iff : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M ↔ c ∈ M := by
            rw [h_conj_y]
            constructor
            · intro h
              have h1 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) ∈ M :=
                M.mul_mem (M.mul_mem (M.inv_mem y.2) h) y.2
              have h2 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) = c := by group
              rw [h2] at h1
              exact h1
            · intro hc
              exact M.mul_mem (M.mul_mem y.2 hc) (M.inv_mem y.2)
          by_cases hc : c ∈ M
          · have hyc : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M := h_mem_iff.mpr hc
            rw [dif_pos hyc, dif_pos hc]
            have h_sub_eq : (⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, hyc⟩ : M) =
                y * ⟨c, hc⟩ * y⁻¹ := by
              apply Subtype.ext
              exact h_conj_y
            rw [h_sub_eq, map_mul, map_mul, map_inv, mul_comm (ψ y), mul_inv_cancel_right]
          · have hyc : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∉ M :=
              fun h => hc (h_mem_iff.mp h)
            rw [dif_neg hyc, dif_neg hc]
        simp_rw [h_term]
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
      simp_rw [h_inner, ← Finset.mul_sum]
      have hM_ne : (Nat.card M : Ω F) ≠ 0 := by
        exact_mod_cast (Nat.card_pos (α := M)).ne'
      exact inv_mul_cancel_left₀ hM_ne _
    change (1 : ℤ) • LinearMap.trace (Ω F) (indSpace H_E₁ ρ_E₁) (indRep H_E₁ ρ_E₁ w) =
      indCharTrace F M ψ (π w)
    rw [one_smul, h_tr_ind, h_indChar]
  have h_mem_top : ∀ w : G_L, w ∈ (relWeil F L).subgroupOf G_L ↔ π w ∈ (⊤ : Subgroup G) :=
    fun w => by simp [Subgroup.mem_subgroupOf]
  have htr_L : ∀ w : G_L,
      (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L w =
        indCharTrace F (⊤ : Subgroup G) 1 (π w) := by
    have h1 := h_bridge L le_rfl (⊤ : Subgroup G) h_mem_top 1
    dsimp only at h1
    have hχ_top_one : (1 : (⊤ : Subgroup G) →* (Ω F)ˣ).comp
        { toFun := fun w => ⟨π (Subgroup.inclusion (relWeil_antitone F le_rfl) w),
            (h_mem_top (Subgroup.inclusion (relWeil_antitone F le_rfl) w)).mp w.2⟩
          map_one' := Subtype.ext (by simp)
          map_mul' := fun x y => Subtype.ext (by simp) } =
        (1 : relWeil F L →* (Ω F)ˣ) := MonoidHom.ext fun _ => rfl
    rwa [hχ_top_one] at h1
  have htr_E : ∀ w : G_L,
      (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w =
        indCharTrace F H 1 (π w) := by
    have h1 := h_bridge E hLE H h_mem_H 1
    dsimp only at h1
    have hχ_E_one : (1 : H →* (Ω F)ˣ).comp
        { toFun := fun w => ⟨π (Subgroup.inclusion (relWeil_antitone F hLE) w),
            (h_mem_H (Subgroup.inclusion (relWeil_antitone F hLE) w)).mp w.2⟩
          map_one' := Subtype.ext (by simp)
          map_mul' := fun x y => Subtype.ext (by simp) } =
        (1 : relWeil F E →* (Ω F)ˣ) := MonoidHom.ext fun _ => rfl
    rwa [hχ_E_one] at h1
  have htr_MC : ∀ (i : Fin r) (w : G_L),
      (⟨1, M_C, hLM_C, μ_orb i⟩ : MonomialTerm F L).trace F L w =
        indCharTrace F C (μ_bar i) (π w) := by
    intro i
    have h1 := h_bridge M_C hLM_C C h_mem_C (μ_bar i)
    dsimp only at h1
    have hχ_MC : (μ_bar i).comp π_MC = μ_orb i := MonoidHom.ext fun w => hμ_sec i w
    rwa [hχ_MC] at h1
  have h_sum_C : ∀ c : C,
      1 + (∑ i : Fin r,
        ∑ h : H,
          (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F)) =
        if c = 1 then (ℓ : Ω F) else 0 := by
    intro c
    have h_eval_top : indCharTrace F (⊤ : Subgroup G) 1 c.1 = 1 := by
      unfold indCharTrace
      have h_term : ∀ x : G,
          (if h : x * c.1 * x⁻¹ ∈ (⊤ : Subgroup G) then
