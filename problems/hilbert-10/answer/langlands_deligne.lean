      rw [h_grp]
      exact h_norm_E₁F₁ (γ⁻¹ * α * γ) hα_conj (γ⁻¹ * τ * γ) hτ
    have h_comm_E₂F₀ : ∀ α ∈ E₂.fixingSubgroup, ∀ β ∈ E₂.fixingSubgroup,
        α * β * α⁻¹ * β⁻¹ ∈ F₀.fixingSubgroup := by
      intro α hα β hβ
      rw [h_fix_F₀]
      have hα_conj : γ⁻¹ * α * γ ∈ E₁.fixingSubgroup := hConj_fixing α hα
      have hβ_conj : γ⁻¹ * β * γ ∈ E₁.fixingSubgroup := hConj_fixing β hβ
      have h_grp : γ⁻¹ * (α * β * α⁻¹ * β⁻¹) * γ =
          (γ⁻¹ * α * γ) * (γ⁻¹ * β * γ) * (γ⁻¹ * α * γ)⁻¹ * (γ⁻¹ * β * γ)⁻¹ := by group
      rw [h_grp]
      exact h_comm_E₁F₁ (γ⁻¹ * α * γ) hα_conj (γ⁻¹ * β * γ) hβ_conj
    let S₀ := IntermediateField.extendScalars hE₂F₀
    let S₁ := IntermediateField.extendScalars hE₁F₁
    let e₁ : E₂ ≃+* E₁ := ϕ.symm.toRingEquiv
    let e₂ : S₀ ≃+* S₁ :=
      { toFun := fun x =>
          ⟨γ⁻¹ x.1, (IntermediateField.mem_extendScalars hE₁F₁).mpr
            ((IntermediateField.mem_extendScalars hE₂F₀).mp x.2)⟩
        invFun := fun y =>
          ⟨γ y.1, (IntermediateField.mem_extendScalars hE₂F₀).mpr (by
            change γ⁻¹ (γ y.1) ∈ F₁
            rw [h_inv_apply γ y.1]
            exact (IntermediateField.mem_extendScalars hE₁F₁).mp y.2)⟩
        left_inv := fun x => Subtype.ext (h_apply_inv γ x.1)
        right_inv := fun y => Subtype.ext (h_inv_apply γ y.1)
        map_mul' := fun x y => Subtype.ext (map_mul γ⁻¹ x.1 y.1)
        map_add' := fun x y => Subtype.ext (map_add γ⁻¹ x.1 y.1) }
    have h_comm_alg : (algebraMap E₁ S₁).comp (e₁ : E₂ →+* E₁) =
        (e₂ : S₀ →+* S₁).comp (algebraMap E₂ S₀) :=
      RingHom.ext fun m => Subtype.ext rfl
    have h_sep_E₂F₀ : Algebra.IsSeparable E₂ S₀ := by
      refine ⟨fun x => ?_⟩
      let y : S₁ := e₂ x
      have hy_sep : (minpoly E₁ y).Separable :=
        @Algebra.IsSeparable.isSeparable E₁ S₁ _ _ _ h_sep_E₁F₁ y
      let p : Polynomial E₂ := Polynomial.map (e₁.symm : E₁ →+* E₂) (minpoly E₁ y)
      have hp_sep : p.Separable := hy_sep.map
      have h_comp_symm : ((e₂ : S₀ →+* S₁).comp (algebraMap E₂ S₀)).comp (e₁.symm : E₁ →+* E₂) =
          algebraMap E₁ S₁ := by
        rw [← h_comm_alg]
        exact RingHom.ext fun m => congrArg (algebraMap E₁ S₁) (e₁.apply_symm_apply m)
      have h_eval_e₂ : e₂ (Polynomial.aeval x p) = 0 := by
        calc e₂ (Polynomial.aeval x p)
            = (e₂ : S₀ →+* S₁) (Polynomial.eval₂ (algebraMap E₂ S₀) x
                (Polynomial.map (e₁.symm : E₁ →+* E₂) (minpoly E₁ y))) := by
              rw [Polynomial.aeval_def]; rfl
          _ = (e₂ : S₀ →+* S₁) (Polynomial.eval₂
                ((algebraMap E₂ S₀).comp (e₁.symm : E₁ →+* E₂)) x (minpoly E₁ y)) := by
              rw [Polynomial.eval₂_map]
          _ = Polynomial.eval₂
                (((e₂ : S₀ →+* S₁).comp (algebraMap E₂ S₀)).comp (e₁.symm : E₁ →+* E₂))
                (e₂ x) (minpoly E₁ y) := by
              rw [Polynomial.hom_eval₂, RingHom.comp_assoc]; rfl
          _ = Polynomial.aeval y (minpoly E₁ y) := by
              rw [h_comp_symm, ← Polynomial.aeval_def]
          _ = 0 := minpoly.aeval E₁ y
      have h_aeval : Polynomial.aeval x p = 0 :=
        e₂.injective (h_eval_e₂.trans (map_zero e₂).symm)
      exact hp_sep.of_dvd (minpoly.dvd E₂ x h_aeval)
    have hAbE₂F₀ : IsAbelianExt F hE₂F₀ := ⟨h_norm_E₂F₀, h_comm_E₂F₀, h_sep_E₂F₀⟩
    let u₀ : F₀ := e_F₀₁.symm u₁
    have hu₀_norm : normLM F hE₂F₀ u₀ = (z' : E₂) := by
      let x₀ : S₀ := toExtendScalars F hE₂F₀ u₀
      have hx₀_e₂ : e₂ x₀ = toExtendScalars F hE₁F₁ u₁ :=
        Subtype.ext (h_inv_apply γ u₁.1)
      have h_norm_eq : Algebra.norm E₂ x₀ = e₁.symm (Algebra.norm E₁ (e₂ x₀)) :=
        Algebra.norm_eq_of_equiv_equiv e₁ e₂ h_comm_alg x₀
      change Algebra.norm E₂ x₀ = (z' : E₂)
      rw [h_norm_eq, hx₀_e₂]
      change ϕ (normLM F hE₁F₁ u₁) = ϕ (z : E₁)
      rw [hu₁]
    have hz'_fix_F₀ : (rec.recMap E₂ z' : AbsGal F) ∈ F₀.fixingSubgroup :=
      (rec.ker_rec E₂ F₀ hE₂F₀ hAbE₂F₀ z').mpr ⟨u₀, hu₀_norm⟩
    have hγ₂_fix_F₁ : γ₂ ∈ F₁.fixingSubgroup :=
      (h_fix_F₀ (rec.recMap E₂ z' : AbsGal F)).mp hz'_fix_F₀
    have hσ₂_mem : σ₂ ∈ H₁ := by
      rw [← h_fix_H₁, IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      apply Subtype.ext
      rw [hσ₂ x]
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hγ₂_fix_F₁ x.1 ((h_mem_F₁ x).mpr hx)
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hσ₂_mem
    have hγ₂_ζ : γ₂ ζ_N = γ₁ ζ_N := by
      have hγ₂_p : IsPrimeToPRootOfUnity F (γ₂ ζ_N) := h_primeToP_map γ₂ ζ_N hζ_p
      have h1 : γ₁⁻¹ (γ₂ ζ_N) = ζ_N := by
        rw [hγ₁_frob (γ₂ ζ_N) hγ₂_p, ← hγ₂_frob (γ₂ ζ_N) hγ₂_p, h_inv_apply γ₂ ζ_N]
      calc γ₂ ζ_N = γ₁ (γ₁⁻¹ (γ₂ ζ_N)) := (h_apply_inv γ₁ (γ₂ ζ_N)).symm
        _ = γ₁ ζ_N := congrArg (⇑γ₁) h1
    have hk_ζ :
        (((σ₁ ^ k) ⟨ζ_N, (IntermediateField.mem_extendScalars hE₁M').mpr hζ_mem⟩ : M_ext') :
          AlgebraicClosure F) = γ₁ ζ_N := by
      rw [hk, hσ₂ ⟨ζ_N, (IntermediateField.mem_extendScalars hE₁M').mpr hζ_mem⟩, hγ₂_ζ]
    have h_eq_M₀ :=
      ld_frob_zpow_eq_on_subfield_of_primitiveRoot F E₁ E₁ M₀ M' le_rfl hE₁M₀ hM₀M' hGalE₁M₀
        (resDeg F E₁) hf_E₁ hq ζ_N hζ_prim hζ_p hζ_mem
        γ₁ hγ₁_E₁ hγ₁_frob σ₁ hσ₁ k hk_ζ
    have hdiff_Mab :
        (((rec.recMap E₁ z)⁻¹ * conjHom_g (rec.recMap E₂ z') : relWeil F E₁) : AbsGal F) ∈
          M_ab.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro a ha
      have ha_M₀ : a ∈ M₀ := hMabM₀ ha
      have ha_eq : γ₂ a = γ₁ a := by
        have h1 := h_eq_M₀ a ha_M₀
        rw [hk, hσ₂ ⟨a, (IntermediateField.mem_extendScalars hE₁M').mpr (hM₀M' ha_M₀)⟩] at h1
        exact h1
      change (γ₁⁻¹ * γ₂) a = a
      rw [AlgEquiv.mul_apply, ha_eq, h_inv_apply γ₁ a]
    have hχ_ab_eq : χ_ab (conjHom_g (rec.recMap E₂ z')) = χ_ab (rec.recMap E₁ z) := by
      have htriv : χ_ab ((rec.recMap E₁ z)⁻¹ * conjHom_g (rec.recMap E₂ z')) = 1 :=
        hχ_ab_ker ((rec.recMap E₁ z)⁻¹ * conjHom_g (rec.recMap E₂ z')) hdiff_Mab
      rw [map_mul, map_inv, inv_mul_eq_one] at htriv
      exact htriv.symm
    change θ₂ (ϕ_u z) = θ₁ z
    rw [hθ₂_rec z', hθ₁_rec z, hχ₂_conj (rec.recMap E₂ z'), hχ₁_eq,
      MonoidHom.mul_apply, MonoidHom.mul_apply, hω_eq, hχ_ab_eq]
  obtain ⟨_, hval_one, _, _, hval_mul, hval_inv, hval_surj, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E₁
  obtain ⟨ϖ_E₁, hϖ_E₁⟩ := hval_surj 1
  have hval_pow : ∀ n : ℕ, valL F E₁ (((ϖ_E₁ ^ n : E₁ˣ) : E₁)) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simpa using hval_one
    · rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_E₁, Nat.cast_add, Nat.cast_one]
  have hval_zpow : ∀ m : ℤ, valL F E₁ (((ϖ_E₁ ^ m : E₁ˣ) : E₁)) = m := by
    intro m
    cases m with
    | ofNat n => simpa using hval_pow n
    | negSucc n =>
      rw [zpow_negSucc, hval_inv, hval_pow (n + 1)]
      rfl
  have hrec_eq : ∀ y : E₁ˣ, θ₂ (ϕ_u y) = θ₁ y := by
    intro y
    set m_y : ℤ := valL F E₁ (y : E₁)
    let u : E₁ˣ := y * ϖ_E₁ ^ (-m_y)
    have hval_u : valL F E₁ (u : E₁) = 0 := by
      change valL F E₁ ((y : E₁) * ((ϖ_E₁ ^ (-m_y) : E₁ˣ) : E₁)) = 0
      rw [hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hval_zpow (-m_y)]
      change m_y + -m_y = 0
      omega
    have hval_ϖu : valL F E₁ (((ϖ_E₁ * u : E₁ˣ) : E₁)) = 1 := by
      rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hϖ_E₁, hval_u, add_zero]
    have hy_eq : y = (ϖ_E₁ * u) * ϖ_E₁ ^ (m_y - 1) := by
      have h1 : (ϖ_E₁ * u) * ϖ_E₁ ^ (m_y - 1) =
          y * (ϖ_E₁ ^ (1 : ℤ) * ϖ_E₁ ^ (-m_y) * ϖ_E₁ ^ (m_y - 1)) := by
        dsimp [u]
        rw [zpow_one]
        ac_rfl
      rw [h1, ← zpow_add, ← zpow_add, show (1 : ℤ) + -m_y + (m_y - 1) = 0 by omega,
        zpow_zero, mul_one]
    change Ψ₁ y = Ψ₂ y
    rw [hy_eq, Ψ₁.map_mul (ϖ_E₁ * u), Ψ₁.map_zpow, Ψ₂.map_mul (ϖ_E₁ * u), Ψ₂.map_zpow,
      hΨ_unif (ϖ_E₁ * u) hval_ϖu, hΨ_unif ϖ_E₁ hϖ_E₁]
  
  let ϕ_L : IntermediateField.extendScalars hLE₁ ≃ₐ[L] IntermediateField.extendScalars hLE₂ :=
    { toFun := fun x =>
        ⟨(ϕ ⟨x.1, (IntermediateField.mem_extendScalars hLE₁).mp x.2⟩).1,
          (IntermediateField.mem_extendScalars hLE₂).mpr
            (ϕ ⟨x.1, (IntermediateField.mem_extendScalars hLE₁).mp x.2⟩).2⟩
      invFun := fun y =>
        ⟨(ϕ.symm ⟨y.1, (IntermediateField.mem_extendScalars hLE₂).mp y.2⟩).1,
          (IntermediateField.mem_extendScalars hLE₁).mpr
            (ϕ.symm ⟨y.1, (IntermediateField.mem_extendScalars hLE₂).mp y.2⟩).2⟩
      left_inv := fun x => Subtype.ext (congrArg Subtype.val (ϕ.symm_apply_apply ⟨x.1, _⟩))
      right_inv := fun y => Subtype.ext (congrArg Subtype.val (ϕ.apply_symm_apply ⟨y.1, _⟩))
      map_mul' := fun x y => Subtype.ext (congrArg Subtype.val (map_mul ϕ ⟨x.1, _⟩ ⟨y.1, _⟩))
      map_add' := fun x y => Subtype.ext (congrArg Subtype.val (map_add ϕ ⟨x.1, _⟩ ⟨y.1, _⟩))
      commutes' := fun r => Subtype.ext (by
        change ((ϕ ⟨r.1, hLE₁ r.2⟩ : E₂) : AlgebraicClosure F) = r.1
        exact (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγL r.1 r.2) }
  have htraceChar_ϕ : ∀ x : E₁,
      traceChar F hLE₂ ψ (ϕ x) = traceChar F hLE₁ ψ x := by
    intro x
    change ψ (Algebra.trace L (IntermediateField.extendScalars hLE₂) (toExtendScalars F hLE₂ (ϕ x))) =
      ψ (Algebra.trace L (IntermediateField.extendScalars hLE₁) (toExtendScalars F hLE₁ x))
    have h_app : toExtendScalars F hLE₂ (ϕ x) = ϕ_L (toExtendScalars F hLE₁ x) := rfl
    rw [h_app, Algebra.trace_eq_of_algEquiv ϕ_L (toExtendScalars F hLE₁ x)]
  have htateEpsUnit_eq :
      tateEpsUnit F E₂ θ₂ (traceChar F hLE₂ ψ) = tateEpsUnit F E₁ θ₁ (traceChar F hLE₁ ψ) :=
    (ld_ch13_2_tateEpsUnit_algEquiv_invariance F E₁ E₂ ϕ
      (traceChar F hLE₁ ψ) hψ₁ (traceChar F hLE₂ ψ) htraceChar_ϕ
      θ₁ hθ₁_cond θ₂ hrec_eq).2
  simp only [evalMonomialTerm, zpow_one]
  rw [htateEpsUnit_eq, hf_eq]

theorem ld_mackey_bipartite_base_shift_cancel (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (ψ : AddChar L (Ω F))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hBaseShift : ∀ (F' : IntermediateField F (AlgebraicClosure F)) (hLF' : L ≤ F') (hF'K : F' ≤ K),
      Module.finrank F' (IntermediateField.extendScalars hF'K) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      ∀ (D_F' : List (MonomialTerm F F')),
        IsMonomialDecomp F F' 0 D_F' →
        (∀ t ∈ D_F', t.field ≤ K) →
        evalMonomialList F rec (fun _ E _ => f E) L ψ (D_F'.map (MonomialTerm.restrict F hLF')) = 1)
    (D : List (MonomialTerm F L)) (hD_zero : IsMonomialDecomp F L 0 D)
    (hD_lt : ∀ t ∈ D, ∃ htK : t.field ≤ K,
      Module.finrank t.field (IntermediateField.extendScalars htK) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (D_triv : List (MonomialTerm F L)) (hD_triv : IsMonomialDecomp F L (fun _ => 1) D_triv)
    (hD_triv_lt : ∀ s ∈ D_triv, ∃ hsK : s.field ≤ K,
      Module.finrank s.field (IntermediateField.extendScalars hsK) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hSelfNeg : ∀ t ∈ D,
      (⟨-1, t.field, le_rfl, t.χ⟩ : MonomialTerm F t.field).Wf F t.field ∧
      ∀ u : relWeil F t.field,
        (⟨-1, t.field, le_rfl, t.χ⟩ : MonomialTerm F t.field).trace F t.field u =
          - (t.χ u : Ω F))
    (hPair : ∀ t ∈ D, ∀ s ∈ D_triv,
      ∃ (L_A : List (MonomialTerm F t.field)) (L_B : List (MonomialTerm F s.field)),
        (∀ r ∈ L_A, r.Wf F t.field ∧ r.field ≤ K) ∧
        (∀ u : relWeil F t.field,
          monomialListTrace F t.field L_A u =
            (t.χ u : Ω F) *
              (⟨1, s.field, s.le, s.χ⟩ : MonomialTerm F L).trace F L
                (Subgroup.inclusion (relWeil_antitone F t.le) u)) ∧
        (∀ r ∈ L_B, r.Wf F s.field ∧ r.field ≤ K) ∧
        (∀ v : relWeil F s.field,
          monomialListTrace F s.field L_B v =
            (s.χ v : Ω F) *
              (⟨1, t.field, t.le, t.χ⟩ : MonomialTerm F L).trace F L
                (Subgroup.inclusion (relWeil_antitone F s.le) v)) ∧
        evalMonomialList F rec (fun _ E _ => f E) L ψ
            (L_A.map (MonomialTerm.restrict F t.le)) =
          evalMonomialList F rec (fun _ E _ => f E) L ψ
            (L_B.map (MonomialTerm.restrict F s.le))) :
    evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1 :=
by
  let lam : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)), AddChar L' (Ω F) → (Ω F)ˣ :=
    fun _ E' _ => f E'
  
  let L_A_tot : ∀ (t s : MonomialTerm F L), List (MonomialTerm F t.field) :=
    fun t s => if ht : t ∈ D then if hs : s ∈ D_triv then (hPair t ht s hs).choose else [] else []
  let L_B_tot : ∀ (t s : MonomialTerm F L), List (MonomialTerm F s.field) :=
    fun t s =>
      if ht : t ∈ D then
        if hs : s ∈ D_triv then (hPair t ht s hs).choose_spec.choose else []
      else []
  let E : MonomialTerm F L → MonomialTerm F L → (Ω F)ˣ :=
    fun t s => evalMonomialList F rec lam L ψ ((L_A_tot t s).map (MonomialTerm.restrict F t.le))
  have hLA_wf : ∀ t (ht : t ∈ D) s (hs : s ∈ D_triv),
      ∀ r ∈ L_A_tot t s, r.Wf F t.field ∧ r.field ≤ K := by
    intro t ht s hs
    dsimp only [L_A_tot]
    rw [dif_pos ht, dif_pos hs]
    exact (hPair t ht s hs).choose_spec.choose_spec.1
  have hLA_tr : ∀ t (ht : t ∈ D) s (hs : s ∈ D_triv) (u : relWeil F t.field),
      monomialListTrace F t.field (L_A_tot t s) u =
        (t.χ u : Ω F) *
          (⟨1, s.field, s.le, s.χ⟩ : MonomialTerm F L).trace F L
            (Subgroup.inclusion (relWeil_antitone F t.le) u) := by
    intro t ht s hs u
    dsimp only [L_A_tot]
    rw [dif_pos ht, dif_pos hs]
    exact (hPair t ht s hs).choose_spec.choose_spec.2.1 u
  have hLB_wf : ∀ t (ht : t ∈ D) s (hs : s ∈ D_triv),
      ∀ r ∈ L_B_tot t s, r.Wf F s.field ∧ r.field ≤ K := by
    intro t ht s hs
    dsimp only [L_B_tot]
    rw [dif_pos ht, dif_pos hs]
    exact (hPair t ht s hs).choose_spec.choose_spec.2.2.1
  have hLB_tr : ∀ t (ht : t ∈ D) s (hs : s ∈ D_triv) (v : relWeil F s.field),
      monomialListTrace F s.field (L_B_tot t s) v =
        (s.χ v : Ω F) *
          (⟨1, t.field, t.le, t.χ⟩ : MonomialTerm F L).trace F L
            (Subgroup.inclusion (relWeil_antitone F s.le) v) := by
    intro t ht s hs v
    dsimp only [L_B_tot]
    rw [dif_pos ht, dif_pos hs]
    exact (hPair t ht s hs).choose_spec.choose_spec.2.2.2.1 v
  have hE_eq : ∀ t (ht : t ∈ D) s (hs : s ∈ D_triv),
      E t s = evalMonomialList F rec lam L ψ ((L_B_tot t s).map (MonomialTerm.restrict F s.le)) := by
    intro t ht s hs
    dsimp only [E, L_A_tot, L_B_tot]
    rw [dif_pos ht, dif_pos hs, dif_pos ht, dif_pos hs]
    exact (hPair t ht s hs).choose_spec.choose_spec.2.2.2.2
  
  have htrace_append : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (D₁ D₂ : List (MonomialTerm F M)) (w : relWeil F M),
      monomialListTrace F M (D₁ ++ D₂) w =
        monomialListTrace F M D₁ w + monomialListTrace F M D₂ w := by
    intro M D₁ D₂ w
    simp [monomialListTrace, List.map_append, List.sum_append]
  have heval_append : ∀ (D₁ D₂ : List (MonomialTerm F L)),
      evalMonomialList F rec lam L ψ (D₁ ++ D₂) =
        evalMonomialList F rec lam L ψ D₁ * evalMonomialList F rec lam L ψ D₂ := by
    intro D₁ D₂
    simp [evalMonomialList, List.map_append, List.prod_append]
  have hterm_trace_coeff : ∀ (r : MonomialTerm F L) (w : relWeil F L),
      r.trace F L w =
        (r.coeff : Ω F) * (⟨1, r.field, r.le, r.χ⟩ : MonomialTerm F L).trace F L w := by
    intro r w
    simp [MonomialTerm.trace, zsmul_eq_mul, one_smul]
  have hterm_eval_coeff : ∀ (r : MonomialTerm F L),
      evalMonomialTerm F rec lam L ψ r =
        (evalMonomialTerm F rec lam L ψ ⟨1, r.field, r.le, r.χ⟩) ^ r.coeff := by
    intro r
    simp [evalMonomialTerm, zpow_one]
  have hscale_wf : ∀ (M : IntermediateField F (AlgebraicClosure F)) (c : ℤ)
      (L₀ : List (MonomialTerm F M)),
      (∀ r ∈ L₀, r.Wf F M ∧ r.field ≤ K) →
      ∀ r ∈ L₀.map (scaleMonomialTerm F M c), r.Wf F M ∧ r.field ≤ K := by
    intro M c L₀ h₀ r hr
    rw [List.mem_map] at hr
    rcases hr with ⟨r₀, hr₀, rfl⟩
    exact h₀ r₀ hr₀
  have hscale_tr : ∀ (M : IntermediateField F (AlgebraicClosure F)) (c : ℤ)
      (L₀ : List (MonomialTerm F M)) (u : relWeil F M),
      monomialListTrace F M (L₀.map (scaleMonomialTerm F M c)) u =
        (c : Ω F) * monomialListTrace F M L₀ u := by
    intro M c L₀ u
    induction L₀ with
    | nil => simp [monomialListTrace]
    | cons r tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have hr : (scaleMonomialTerm F M c r).trace F M u = (c : Ω F) * r.trace F M u := by
        simp [scaleMonomialTerm, MonomialTerm.trace, mul_smul, zsmul_eq_mul]
      rw [hr, ih, mul_add]
  have hscale_eval : ∀ (M : IntermediateField F (AlgebraicClosure F)) (h : L ≤ M) (c : ℤ)
      (L₀ : List (MonomialTerm F M)),
      evalMonomialList F rec lam L ψ
          ((L₀.map (scaleMonomialTerm F M c)).map (MonomialTerm.restrict F h)) =
        (evalMonomialList F rec lam L ψ (L₀.map (MonomialTerm.restrict F h))) ^ c := by
    intro M h c L₀
    induction L₀ with
    | nil => simp [evalMonomialList, one_zpow]
    | cons r tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have hr : evalMonomialTerm F rec lam L ψ ((scaleMonomialTerm F M c r).restrict F h) =
          (evalMonomialTerm F rec lam L ψ (r.restrict F h)) ^ c := by
        simp only [evalMonomialTerm, scaleMonomialTerm, MonomialTerm.restrict]
        rw [mul_comm c r.coeff, zpow_mul]
      rw [hr, ih, ← mul_zpow]
  
  let D_A : ∀ (t : MonomialTerm F L), List (MonomialTerm F L) → List (MonomialTerm F t.field) :=
    fun t S => (S.map (fun s => (L_A_tot t s).map (scaleMonomialTerm F t.field s.coeff))).flatten
  have hDA_ind : ∀ t (ht : t ∈ D) (S : List (MonomialTerm F L)),
      (∀ s ∈ S, s ∈ D_triv) →
      (∀ r ∈ D_A t S, r.Wf F t.field ∧ r.field ≤ K) ∧
      (∀ u : relWeil F t.field,
        monomialListTrace F t.field (D_A t S) u =
          (t.χ u : Ω F) *
            monomialListTrace F L S (Subgroup.inclusion (relWeil_antitone F t.le) u)) ∧
      evalMonomialList F rec lam L ψ ((D_A t S).map (MonomialTerm.restrict F t.le)) =
        (S.map (fun s => (E t s) ^ s.coeff)).prod := by
    intro t ht S hS
    induction S with
    | nil =>
      refine ⟨?_, ?_, ?_⟩
      · intro r hr
        simp [D_A] at hr
      · intro u
        simp [D_A, monomialListTrace]
      · simp [D_A, evalMonomialList]
    | cons s tl ih =>
      have hs : s ∈ D_triv := hS s (by simp)
      have htl : ∀ s' ∈ tl, s' ∈ D_triv := fun s' hs' => hS s' (by simp [hs'])
      have ih' := ih htl
      have h_cons : D_A t (s :: tl) =
          (L_A_tot t s).map (scaleMonomialTerm F t.field s.coeff) ++ D_A t tl := by
        simp [D_A]
      refine ⟨?_, ?_, ?_⟩
      · intro r hr
        rw [h_cons, List.mem_append] at hr
        rcases hr with hr | hr
        · exact hscale_wf t.field s.coeff (L_A_tot t s) (hLA_wf t ht s hs) r hr
        · exact ih'.1 r hr
      · intro u
        let ι_A := Subgroup.inclusion (relWeil_antitone F t.le)
        rw [h_cons, htrace_append, hscale_tr, ih'.2.1 u, hLA_tr t ht s hs u]
        simp only [monomialListTrace, List.map_cons, List.sum_cons]
        rw [hterm_trace_coeff s (ι_A u)]
        ring
      · rw [h_cons, List.map_append, heval_append,
          hscale_eval t.field t.le s.coeff (L_A_tot t s), ih'.2.2]
        simp [E]
  have hHoriz : ∀ t ∈ D,
      evalMonomialTerm F rec lam L ψ t =
        ((D_triv.map (fun s => (E t s) ^ s.coeff)).prod) ^ t.coeff := by
    intro t ht
    obtain ⟨htK, hltA⟩ := hD_lt t ht
    have hDA := hDA_ind t ht D_triv (fun s hs => hs)
    let t_neg : MonomialTerm F t.field := ⟨-1, t.field, le_rfl, t.χ⟩
    have hDecompA : IsMonomialDecomp F t.field 0 (t_neg :: D_A t D_triv) := by
      refine ⟨?_, ?_⟩
      · intro r hr
        rw [List.mem_cons] at hr
        rcases hr with rfl | hr
        · exact (hSelfNeg t ht).1
        · exact (hDA.1 r hr).1
      · intro u
        let ι_A := Subgroup.inclusion (relWeil_antitone F t.le)
        rw [Pi.zero_apply]
        have h_cons_tr : monomialListTrace F t.field (t_neg :: D_A t D_triv) u =
            t_neg.trace F t.field u + monomialListTrace F t.field (D_A t D_triv) u := rfl
        have h1 : t_neg.trace F t.field u = - (t.χ u : Ω F) := (hSelfNeg t ht).2 u
        have h2 : monomialListTrace F t.field (D_A t D_triv) u = (t.χ u : Ω F) := by
          rw [hDA.2.1 u, ← hD_triv.2 (ι_A u), mul_one]
        rw [h_cons_tr, h1, h2, neg_add_cancel]
    have hFieldA : ∀ r ∈ t_neg :: D_A t D_triv, r.field ≤ K := by
      intro r hr
      rw [List.mem_cons] at hr
      rcases hr with rfl | hr
      · exact htK
      · exact (hDA.1 r hr).2
    have hShiftA : evalMonomialList F rec lam L ψ
        ((t_neg :: D_A t D_triv).map (MonomialTerm.restrict F t.le)) = 1 :=
      hBaseShift t.field t.le htK hltA (t_neg :: D_A t D_triv) hDecompA hFieldA
    have h_cons_eval : evalMonomialList F rec lam L ψ
        ((t_neg :: D_A t D_triv).map (MonomialTerm.restrict F t.le)) =
      evalMonomialTerm F rec lam L ψ (t_neg.restrict F t.le) *
        evalMonomialList F rec lam L ψ ((D_A t D_triv).map (MonomialTerm.restrict F t.le)) := rfl
    have ht_neg_eval : evalMonomialTerm F rec lam L ψ (t_neg.restrict F t.le) =
        (evalMonomialTerm F rec lam L ψ ⟨1, t.field, t.le, t.χ⟩)⁻¹ := by
      simp [t_neg, MonomialTerm.restrict, evalMonomialTerm, zpow_neg_one, zpow_one]
    rw [h_cons_eval, ht_neg_eval, hDA.2.2] at hShiftA
    have h_unit : evalMonomialTerm F rec lam L ψ ⟨1, t.field, t.le, t.χ⟩ =
        (D_triv.map (fun s => (E t s) ^ s.coeff)).prod :=
      inv_mul_eq_one.mp hShiftA
    rw [hterm_eval_coeff t, h_unit]
  
  let D_B : ∀ (s : MonomialTerm F L), List (MonomialTerm F L) → List (MonomialTerm F s.field) :=
    fun s T => (T.map (fun t => (L_B_tot t s).map (scaleMonomialTerm F s.field t.coeff))).flatten
  have hDB_ind : ∀ s (hs : s ∈ D_triv) (T : List (MonomialTerm F L)),
      (∀ t ∈ T, t ∈ D) →
      (∀ r ∈ D_B s T, r.Wf F s.field ∧ r.field ≤ K) ∧
      (∀ v : relWeil F s.field,
        monomialListTrace F s.field (D_B s T) v =
          (s.χ v : Ω F) *
            monomialListTrace F L T (Subgroup.inclusion (relWeil_antitone F s.le) v)) ∧
      evalMonomialList F rec lam L ψ ((D_B s T).map (MonomialTerm.restrict F s.le)) =
        (T.map (fun t => (E t s) ^ t.coeff)).prod := by
    intro s hs T hT
    induction T with
    | nil =>
      refine ⟨?_, ?_, ?_⟩
      · intro r hr
        simp [D_B] at hr
      · intro v
        simp [D_B, monomialListTrace]
      · simp [D_B, evalMonomialList]
    | cons t tl ih =>
      have ht : t ∈ D := hT t (by simp)
      have htl : ∀ t' ∈ tl, t' ∈ D := fun t' ht' => hT t' (by simp [ht'])
      have ih' := ih htl
      have h_cons : D_B s (t :: tl) =
          (L_B_tot t s).map (scaleMonomialTerm F s.field t.coeff) ++ D_B s tl := by
        simp [D_B]
      refine ⟨?_, ?_, ?_⟩
      · intro r hr
        rw [h_cons, List.mem_append] at hr
        rcases hr with hr | hr
        · exact hscale_wf s.field t.coeff (L_B_tot t s) (hLB_wf t ht s hs) r hr
        · exact ih'.1 r hr
      · intro v
        let ι_B := Subgroup.inclusion (relWeil_antitone F s.le)
        rw [h_cons, htrace_append, hscale_tr, ih'.2.1 v, hLB_tr t ht s hs v]
        simp only [monomialListTrace, List.map_cons, List.sum_cons]
        rw [hterm_trace_coeff t (ι_B v)]
        ring
      · rw [h_cons, List.map_append, heval_append,
          hscale_eval s.field s.le t.coeff (L_B_tot t s), ← hE_eq t ht s hs, ih'.2.2]
        simp
  have hVert : ∀ s ∈ D_triv,
      (D.map (fun t => (E t s) ^ t.coeff)).prod = 1 := by
    intro s hs
    obtain ⟨hsK, hltB⟩ := hD_triv_lt s hs
    have hDB := hDB_ind s hs D (fun t ht => ht)
    have hDecompB : IsMonomialDecomp F s.field 0 (D_B s D) := by
      refine ⟨?_, ?_⟩
      · intro r hr
        exact (hDB.1 r hr).1
      · intro v
        let ι_B := Subgroup.inclusion (relWeil_antitone F s.le)
        rw [Pi.zero_apply, hDB.2.1 v, ← hD_zero.2 (ι_B v), Pi.zero_apply, mul_zero]
    have hFieldB : ∀ r ∈ D_B s D, r.field ≤ K := fun r hr => (hDB.1 r hr).2
    have hShiftB := hBaseShift s.field s.le hsK hltB (D_B s D) hDecompB hFieldB
    rw [← hDB.2.2]
    exact hShiftB
  
  have hprod_zpow : ∀ (xs : List (MonomialTerm F L)) (g : MonomialTerm F L → (Ω F)ˣ) (c : ℤ),
      ((xs.map g).prod) ^ c = (xs.map (fun x => (g x) ^ c)).prod := by
    intro xs g c
    induction xs with
    | nil => simp [one_zpow]
    | cons x tl ih =>
      simp only [List.map_cons, List.prod_cons]
      rw [mul_zpow, ih]
  have hprod_mul : ∀ (ys : List (MonomialTerm F L)) (f₁ f₂ : MonomialTerm F L → (Ω F)ˣ),
      (ys.map f₁).prod * (ys.map f₂).prod = (ys.map (fun y => f₁ y * f₂ y)).prod := by
    intro ys f₁ f₂
    induction ys with
    | nil => simp
    | cons y tl ih =>
      simp only [List.map_cons, List.prod_cons]
      rw [← ih]
      ac_rfl
  have hprod_one : ∀ (ys : List (MonomialTerm F L)),
      (ys.map (fun _ => (1 : (Ω F)ˣ))).prod = 1 := by
    intro ys
    induction ys with
    | nil => rfl
    | cons y tl ih =>
      simp only [List.map_cons, List.prod_cons, one_mul]
      exact ih
  have hprod_comm : ∀ (xs ys : List (MonomialTerm F L))
      (h : MonomialTerm F L → MonomialTerm F L → (Ω F)ˣ),
      (xs.map (fun x => (ys.map (fun y => h x y)).prod)).prod =
        (ys.map (fun y => (xs.map (fun x => h x y)).prod)).prod := by
    intro xs ys h
    induction xs with
    | nil =>
      simp only [List.map_nil, List.prod_nil]
      exact (hprod_one ys).symm
    | cons x tl ih =>
      simp only [List.map_cons, List.prod_cons]
      rw [ih, hprod_mul]
  have hEvalD_eq : ∀ (T : List (MonomialTerm F L)),
      (∀ t ∈ T, t ∈ D) →
      evalMonomialList F rec lam L ψ T =
        (T.map (fun t => (D_triv.map (fun s => ((E t s) ^ t.coeff) ^ s.coeff)).prod)).prod := by
    intro T hT
    induction T with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      have ht : t ∈ D := hT t (by simp)
      have htl : ∀ t' ∈ tl, t' ∈ D := fun t' ht' => hT t' (by simp [ht'])
      have h_cons_T : evalMonomialList F rec lam L ψ (t :: tl) =
          evalMonomialTerm F rec lam L ψ t * evalMonomialList F rec lam L ψ tl := rfl
      simp only [List.map_cons, List.prod_cons]
      rw [h_cons_T, hHoriz t ht, hprod_zpow, ih htl]
      congr 1
      apply congrArg List.prod
      apply List.map_congr_left
      intro s _
      rw [← zpow_mul, mul_comm s.coeff t.coeff, zpow_mul]
  rw [hEvalD_eq D (fun t ht => ht),
    hprod_comm D D_triv (fun t s => ((E t s) ^ t.coeff) ^ s.coeff)]
  have hVert_prod : ∀ (S : List (MonomialTerm F L)),
      (∀ s ∈ S, s ∈ D_triv) →
      (S.map (fun s => (D.map (fun t => ((E t s) ^ t.coeff) ^ s.coeff)).prod)).prod = 1 := by
    intro S hS
    induction S with
    | nil => rfl
    | cons s tl ih =>
      have hs : s ∈ D_triv := hS s (by simp)
      have htl : ∀ s' ∈ tl, s' ∈ D_triv := fun s' hs' => hS s' (by simp [hs'])
      simp only [List.map_cons, List.prod_cons]
      rw [← hprod_zpow D (fun t => (E t s) ^ t.coeff) s.coeff,
        hVert s hs, one_zpow, one_mul, ih htl]
  exact hVert_prod D_triv (fun s hs => hs)

theorem ld_lemma_19_2_mackey_eval (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_conj : ∀ σ ∈ L.fixingSubgroup, ∀ E, L ≤ E → E ≤ K →
      f (E.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) = f E)
    (hBaseShift : ∀ (F' : IntermediateField F (AlgebraicClosure F)) (hLF' : L ≤ F') (hF'K : F' ≤ K),
      Module.finrank F' (IntermediateField.extendScalars hF'K) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      ∀ (D_F' : List (MonomialTerm F F')),
        IsMonomialDecomp F F' 0 D_F' →
        (∀ t ∈ D_F', t.field ≤ K) →
        evalMonomialList F rec (fun _ E _ => f E) L ψ (D_F'.map (MonomialTerm.restrict F hLF')) = 1)
    (D : List (MonomialTerm F L)) (hD_zero : IsMonomialDecomp F L 0 D)
    (hD_lt : ∀ t ∈ D, ∃ htK : t.field ≤ K,
      Module.finrank t.field (IntermediateField.extendScalars htK) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (D_triv : List (MonomialTerm F L)) (hD_triv : IsMonomialDecomp F L (fun _ => 1) D_triv)
    (hD_triv_lt : ∀ s ∈ D_triv, ∃ hsK : s.field ≤ K,
      Module.finrank s.field (IntermediateField.extendScalars hsK) <
        Module.finrank L (IntermediateField.extendScalars hLK)) :
    evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1 :=
by
  apply ld_mackey_bipartite_base_shift_cancel F rec L K hLK ψ f hBaseShift
    D hD_zero hD_lt D_triv hD_triv hD_triv_lt
  · intro t ht
    have htWf : (⟨1, t.field, t.le, t.χ⟩ : MonomialTerm F L).Wf F L := hD_zero.1 t ht
    haveI : FiniteDimensional F t.field := htWf.1
    obtain ⟨htK, _⟩ := hD_lt t ht
    obtain ⟨m, w, hDisj, hExh, _, _⟩ :=
      ld_mackey_double_coset_reps_exist F L t.field t.field t.le t.le
    have h := ld_mackey_one_sided_double_coset_trace F L K t.field t.field
      hLK hGal t.le htK t.le htK t.χ t.χ htWf htWf m w hDisj hExh
    exact ⟨h.1, h.2.1⟩
  · intro t ht s hs
    have htWf : (⟨1, t.field, t.le, t.χ⟩ : MonomialTerm F L).Wf F L := hD_zero.1 t ht
    have hsWf : (⟨1, s.field, s.le, s.χ⟩ : MonomialTerm F L).Wf F L := hD_triv.1 s hs
    haveI : FiniteDimensional F s.field := hsWf.1
    obtain ⟨htK, _⟩ := hD_lt t ht
    obtain ⟨hsK, _⟩ := hD_triv_lt s hs
    obtain ⟨m, w, hDisj_AB, hExh_AB, hDisj_BA, hExh_BA⟩ :=
      ld_mackey_double_coset_reps_exist F L t.field s.field t.le s.le
    have hA := ld_mackey_one_sided_double_coset_trace F L K t.field s.field
      hLK hGal t.le htK s.le hsK t.χ s.χ htWf hsWf m w hDisj_AB hExh_AB
    have hB := ld_mackey_one_sided_double_coset_trace F L K s.field t.field
      hLK hGal s.le hsK t.le htK s.χ t.χ hsWf htWf m (fun i => (w i)⁻¹) hDisj_BA hExh_BA
    let L_A : List (MonomialTerm F t.field) :=
      List.ofFn (fun i : Fin m => mackeyTerm F t.field s.field t.χ s.χ (w i))
    let L_B : List (MonomialTerm F s.field) :=
      List.ofFn (fun i : Fin m => mackeyTerm F s.field t.field s.χ t.χ (w i)⁻¹)
    refine ⟨L_A, L_B, ?_, ?_, ?_, ?_, ?_⟩
    · intro r hr
      rw [List.mem_ofFn] at hr
      rcases hr with ⟨i, rfl⟩
      exact ⟨(hA.2.2.1 i).1, (hA.2.2.1 i).2.1⟩
    · intro u
      exact (hA.2.2.2 u).symm
    · intro r hr
      rw [List.mem_ofFn] at hr
      rcases hr with ⟨i, rfl⟩
      exact ⟨(hB.2.2.1 i).1, (hB.2.2.1 i).2.1⟩
    · intro v
      exact (hB.2.2.2 v).symm
    · simp only [L_A, L_B, evalMonomialList, List.map_ofFn, Function.comp_def]
      congr 1
      apply congrArg List.ofFn
      funext i
      let E₁ := mackeyField F s.field t.field (w i)⁻¹
      let E₂ := mackeyField F t.field s.field (w i)
      have hE₂_eq : E₂ = E₁.map ((w i : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := by
        change t.field ⊔ s.field.map ((w i : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) =
          (s.field ⊔ t.field.map ((((w i)⁻¹ : relWeil F L) : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)).map
            ((w i : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
        rw [IntermediateField.map_sup, IntermediateField.map_map]
        have h_id : (((w i : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp
            ((((w i)⁻¹ : relWeil F L) : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) =
            AlgHom.id F (AlgebraicClosure F) := by
          ext x
          exact (w i : AbsGal F).apply_symm_apply x
        rw [h_id, IntermediateField.map_id, sup_comm]
      have hχ₂_eq : ∀ (u : relWeil F E₂)
          (hu : (w i : AbsGal F)⁻¹ * (u : AbsGal F) * (w i : AbsGal F) ∈ relWeil F E₁),
          mackeyChar F t.χ s.χ (w i) u =
            mackeyChar F s.χ t.χ (w i)⁻¹ ⟨(w i : AbsGal F)⁻¹ * (u : AbsGal F) * (w i : AbsGal F), hu⟩ := by
        intro u hu
        let v : relWeil F E₁ := ⟨(w i : AbsGal F)⁻¹ * (u : AbsGal F) * (w i : AbsGal F), hu⟩
        change (restrictWeilChar F (show t.field ≤ E₂ from le_sup_left) t.χ u) *
            (s.χ (mackeyConjHom F t.field s.field (w i) u)) =
          (restrictWeilChar F (show s.field ≤ E₁ from le_sup_left) s.χ v) *
            (t.χ (mackeyConjHom F s.field t.field (w i)⁻¹ v))
        have h_left : mackeyConjHom F t.field s.field (w i) u =
            Subgroup.inclusion (relWeil_antitone F (show s.field ≤ E₁ from le_sup_left)) v := rfl
        have h_right : mackeyConjHom F s.field t.field (w i)⁻¹ v =
            Subgroup.inclusion (relWeil_antitone F (show t.field ≤ E₂ from le_sup_left)) u := by
          apply Subtype.ext
          change (((w i)⁻¹ : relWeil F L) : AbsGal F)⁻¹ *
            ((w i : AbsGal F)⁻¹ * (u : AbsGal F) * (w i : AbsGal F)) *
            (((w i)⁻¹ : relWeil F L) : AbsGal F) = (u : AbsGal F)
          simp only [Subgroup.coe_inv]
          group
        rw [h_left, h_right]
        exact mul_comm _ _
      exact ld_mackey_conj_term_eval_eq F rec L K E₁ E₂ hLK hGal ψ hψ f hf_conj
        (s.le.trans (show s.field ≤ E₁ from le_sup_left)) (hB.2.2.1 i).2.1
        (t.le.trans (show t.field ≤ E₂ from le_sup_left)) (hA.2.2.1 i).2.1
        (mackeyChar F s.χ t.χ (w i)⁻¹) (mackeyChar F t.χ s.χ (w i))
        (hB.2.2.1 i).1.2.2 (hA.2.2.1 i).1.2.2
        (w i) hE₂_eq hχ₂_eq

theorem ld_ch18_19_2_non_extended_inv_char (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_cand : IsCandidateLambdaOn F rec L K hLK ψ f)
    (χK : relWeil F K →* (Ω F)ˣ) (hInv : IsInvariantWeilChar F L K χK)
    (hne : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK)
    (D : List (MonomialTerm F L)) (hD : IsHomogeneousDecompOn F L K χK D) :
    evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1 :=
by
  obtain ⟨hD_lt, hLemma18_2, hBaseShift⟩ :=
    ld_candidate_subfield_reductions F rec L K hLK hGal ψ hψ hTheory f hf_cand χK hne D hD
  by_cases hNilp : Group.IsNilpotent ((IntermediateField.extendScalars hLK) ≃ₐ[L] (IntermediateField.extendScalars hLK))
  · obtain ⟨M, hLM, hMK, hGalLM, hGalMK, hPrime, hltM, hCent, χM, hχM_weil, hχM_rest⟩ :=
      ld_nilpotent_central_subext F rec L K hLK hGal χK hInv hne hNilp
    obtain ⟨D_M, hD_M_zero, hD_M_le, heval_eq⟩ :=
      ld_lemma_18_1_term_descent F rec L K hLK hGal ψ hψ hTheory f hf_cand χK hInv hne
        M hLM hMK hGalLM hGalMK hPrime hltM hCent χM hχM_weil hχM_rest D hD
    rw [heval_eq]
    exact hLemma18_2 M hLM hMK hGalLM hltM D_M hD_M_zero hD_M_le
  · obtain ⟨D_triv, hD_triv, hD_triv_lt⟩ :=
      ld_non_nilpotent_brauer_one F L K hLK hGal hNilp
    exact ld_lemma_19_2_mackey_eval F rec L K hLK hGal ψ hψ f hf_cand.2.2.1 hBaseShift
      D hD.1 hD_lt D_triv hD_triv hD_triv_lt

theorem ld_ch17_orbit_partition_trace_zero (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (D : List (MonomialTerm F L))
    (hD : IsMonomialDecomp F L 0 D)
    (hDK : ∀ t ∈ D, t.field ≤ K)
    (P : (relWeil F K →* (Ω F)ˣ) → Prop) [DecidablePred P]
    (hP : ∀ (g : relWeil F L) (χ : relWeil F K →* (Ω F)ˣ),
      P (conjWeilChar F hGal g χ) ↔ P χ) :
    IsMonomialDecomp F L 0 (D.filter (fun t => decide (P (termWeilCharOn F L K t)))) :=
by
  set b : MonomialTerm F L → Bool := fun t => decide (P (termWeilCharOn F L K t))
  refine ⟨?_, ?_⟩
  · intro t ht
    exact hD.1 t (List.mem_of_mem_filter ht)
  · intro w₀
    change (0 : Ω F) = monomialListTrace F L (D.filter b) w₀
    have htrace_filter : ∀ (L₀ : List (MonomialTerm F L)) (g : relWeil F L),
        monomialListTrace F L L₀ g =
          monomialListTrace F L (L₀.filter b) g +
            monomialListTrace F L (L₀.filter (fun t => !b t)) g := by
      intro L₀ g
      induction L₀ with
      | nil => simp [monomialListTrace]
      | cons t tl ih =>
        simp only [monomialListTrace] at ih
        cases hb : b t <;>
          simp [monomialListTrace, List.filter_cons, hb, ih, add_assoc, add_left_comm, add_comm]
    obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
    let ι_K : relWeil F K →* relWeil F L := Subgroup.inclusion (relWeil_antitone F hLK)
    let X := relWeil F K →* (Ω F)ˣ
    let v : X → (relWeil F K → Ω F) := fun χ w => (χ w : Ω F)
    have h_lin_indep : LinearIndependent (Ω F) v := by
      have h1 : LinearIndependent (Ω F) (fun f : relWeil F K →* Ω F => ⇑f) :=
        linearIndependent_monoidHom (relWeil F K) (Ω F)
      let emb : X → (relWeil F K →* Ω F) := fun χ => (Units.coeHom (Ω F)).comp χ
      have hemb : Function.Injective emb := by
        intro χ₁ χ₂ h
        ext w
        exact DFunLike.congr_fun h w
      exact h1.comp emb hemb
    have hterm_finsupp : ∀ (t : MonomialTerm F L),
        t.Wf F L → t.field ≤ K →
        ∃ l_t : X →₀ Ω F,
          (∀ w : relWeil F K,
            Finsupp.linearCombination (Ω F) v l_t w = t.trace F L (w₀ * ι_K w)) ∧
          (P (termWeilCharOn F L K t) → ∀ χ : X, ¬ P χ → l_t χ = 0) ∧
          (¬ P (termWeilCharOn F L K t) → ∀ χ : X, P χ → l_t χ = 0) := by
      intro t htWf htK
      let G_L := relWeil F L
      let E := t.field
      let H_E : Subgroup G_L := (relWeil F E).subgroupOf G_L
      let W := ULift.{u} (Ω F)
      let e_sub : H_E ≃* relWeil F E := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F t.le)
      let ρ : Representation (Ω F) H_E W := (charRep F E t.χ).comp e_sub.toMonoidHom
      haveI : FiniteDimensional F E := htWf.1
      have hSep : Algebra.IsSeparable L (IntermediateField.extendScalars t.le) := htWf.2.1
      have hFin_quot : Finite (G_L ⧸ H_E) :=
        (ld_relWeil_quotient_card_eq_finrank F hp hFrob L E t.le hSep).1
      letI : Fintype (G_L ⧸ H_E) := Fintype.ofFinite (G_L ⧸ H_E)
      let u : G_L → G_L ⧸ H_E := fun x => QuotientGroup.mk x⁻¹
      let r : G_L → G_L := fun x => cosetRep (u x)
      have h_xr_mem : ∀ x : G_L, x * r x ∈ H_E := by
        intro x
        have hout : (r x : G_L ⧸ H_E) = u x := Quotient.out_eq (u x)
        have hrel : (r x)⁻¹ * x⁻¹ ∈ H_E := QuotientGroup.eq.mp hout
        have hinv : (x * r x)⁻¹ ∈ H_E := by
          rw [mul_inv_rev]
          exact hrel
        exact (Subgroup.inv_mem_iff H_E).mp hinv
      have hu_mul : ∀ (h₀ : H_E) (x : G_L), u ((h₀ : G_L) * x) = u x := by
        intro h₀ x
        apply QuotientGroup.eq.mpr
        rw [inv_inv, mul_inv_cancel_right]
        exact h₀.2
      have hr_mul : ∀ (h₀ : H_E) (x : G_L), r ((h₀ : G_L) * x) = r x := by
        intro h₀ x
        dsimp only [r]
        rw [hu_mul h₀ x]
      have hu_rep_inv : ∀ u₀ : G_L ⧸ H_E, u (cosetRep u₀)⁻¹ = u₀ := by
        intro u₀
        dsimp only [u]
        rw [inv_inv]
        exact Quotient.out_eq u₀
      have hr_rep_inv : ∀ u₀ : G_L ⧸ H_E, r (cosetRep u₀)⁻¹ = cosetRep u₀ := by
        intro u₀
        dsimp only [r]
        rw [hu_rep_inv u₀]
      have hu_iff : ∀ (u₀ : G_L ⧸ H_E) (g : G_L),
          u ((cosetRep u₀)⁻¹ * g) = u₀ ↔ (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H_E := by
        intro u₀ g
        have h1 : u ((cosetRep u₀)⁻¹ * g) = QuotientGroup.mk (s := H_E) ((cosetRep u₀)⁻¹ * g)⁻¹ := rfl
        have h2 : u₀ = QuotientGroup.mk (s := H_E) (cosetRep u₀) := (Quotient.out_eq u₀).symm
        rw [h1]
        conv_lhs => rhs; rw [h2]
        rw [QuotientGroup.eq, inv_inv]
      let Φ : indSpace H_E ρ ≃ₗ[Ω F] ((G_L ⧸ H_E) → Ω F) :=
        { toFun := fun f u₀ => (f.1 (cosetRep u₀)⁻¹).down
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl
          invFun := fun φ =>
            ⟨fun x => ρ ⟨x * r x, h_xr_mem x⟩ (ULift.up (φ (u x))), fun h₀ x => by
              dsimp only
              rw [hu_mul h₀ x]
              have h_sub : (⟨((h₀ : G_L) * x) * r ((h₀ : G_L) * x), h_xr_mem ((h₀ : G_L) * x)⟩ : H_E) =
                  h₀ * ⟨x * r x, h_xr_mem x⟩ := by
                apply Subtype.ext
                change ((h₀ : G_L) * x) * r ((h₀ : G_L) * x) = (h₀ : G_L) * (x * r x)
                rw [hr_mul h₀ x, mul_assoc]
              rw [h_sub, map_mul, Module.End.mul_apply]⟩
          left_inv := fun f => Subtype.ext (funext fun x => by
            dsimp only
            have hf := f.2 ⟨x * r x, h_xr_mem x⟩ (r x)⁻¹
            change ρ ⟨x * r x, h_xr_mem x⟩ (f.1 (r x)⁻¹) = f.1 x
            rw [← hf]
            change f.1 ((x * r x) * (r x)⁻¹) = f.1 x
            rw [mul_inv_cancel_right])
          right_inv := fun φ => funext fun u₀ => by
            dsimp only
            rw [hu_rep_inv u₀]
            have h_one : (⟨(cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹, h_xr_mem (cosetRep u₀)⁻¹⟩ : H_E) = 1 := by
              apply Subtype.ext
              change (cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹ = 1
              rw [hr_rep_inv u₀, inv_mul_cancel]
            rw [h_one, map_one, Module.End.one_apply] }
      have h_tr_term : ∀ g : G_L,
          t.trace F L g =
            ∑ u₀ : G_L ⧸ H_E,
              if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H_E then
                t.coeff • (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F)
              else 0 := by
        intro g
        let T : ((G_L ⧸ H_E) → Ω F) →ₗ[Ω F] ((G_L ⧸ H_E) → Ω F) := Φ.conj (indRep H_E ρ g)
        have h_tr_ind : LinearMap.trace (Ω F) (indSpace H_E ρ) (indRep H_E ρ g) =
            ∑ u₀ : G_L ⧸ H_E,
              if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H_E then
                (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F)
              else 0 := by
          have h_conj : LinearMap.trace (Ω F) (indSpace H_E ρ) (indRep H_E ρ g) =
              LinearMap.trace (Ω F) ((G_L ⧸ H_E) → Ω F) T :=
            (LinearMap.trace_conj' (indRep H_E ρ g) Φ).symm
          rw [h_conj]
          have h_decomp : T = ∑ u₀ : G_L ⧸ H_E,
              (LinearMap.single (Ω F) (fun _ : G_L ⧸ H_E => Ω F) u₀).comp
                ((LinearMap.proj u₀).comp T) := by
            apply LinearMap.ext
            intro φ
            funext u₁
            simp [LinearMap.sum_apply, LinearMap.comp_apply]
          rw [h_decomp, map_sum]
          apply Finset.sum_congr rfl
          intro u₀ _
          have h_comm : LinearMap.trace (Ω F) ((G_L ⧸ H_E) → Ω F)
              ((LinearMap.single (Ω F) (fun _ : G_L ⧸ H_E => Ω F) u₀).comp
                ((LinearMap.proj u₀).comp T)) =
              LinearMap.trace (Ω F) (Ω F)
                (((LinearMap.proj u₀).comp T).comp
                  (LinearMap.single (Ω F) (fun _ : G_L ⧸ H_E => Ω F) u₀)) :=
            (LinearMap.trace_comp_comm'
              (LinearMap.single (Ω F) (fun _ : G_L ⧸ H_E => Ω F) u₀)
              ((LinearMap.proj u₀).comp T)).symm
          rw [h_comm]
          let B : Ω F →ₗ[Ω F] Ω F :=
            ((LinearMap.proj u₀).comp T).comp (LinearMap.single (Ω F) (fun _ : G_L ⧸ H_E => Ω F) u₀)
          change LinearMap.trace (Ω F) (Ω F) B = _
          by_cases hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H_E
          · rw [dif_pos hc]
            have hu_eq : u ((cosetRep u₀)⁻¹ * g) = u₀ := (hu_iff u₀ g).mpr hc
            have hr_eq : r ((cosetRep u₀)⁻¹ * g) = cosetRep u₀ := congrArg cosetRep hu_eq
            have hB : B = (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F) • LinearMap.id := by
              apply LinearMap.ext
              intro a
              change (ρ ⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩
                (ULift.up (Pi.single (M := fun _ : G_L ⧸ H_E => Ω F) u₀ a (u ((cosetRep u₀)⁻¹ * g))))).down =
                (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F) * a
              rw [hu_eq, Pi.single_eq_same]
              have h_sub_eq : (⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩ : H_E) =
                  ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩ := by
                apply Subtype.ext
                change ((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g) = (cosetRep u₀)⁻¹ * g * cosetRep u₀
                rw [hr_eq]
              rw [h_sub_eq]
              rfl
            rw [hB, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one, smul_eq_mul, mul_one]
          · rw [dif_neg hc]
            have hu_ne : u ((cosetRep u₀)⁻¹ * g) ≠ u₀ := fun h => hc ((hu_iff u₀ g).mp h)
            have hB : B = 0 := by
              apply LinearMap.ext
              intro a
              change (ρ ⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩
                (ULift.up (Pi.single (M := fun _ : G_L ⧸ H_E => Ω F) u₀ a (u ((cosetRep u₀)⁻¹ * g))))).down = 0
              rw [Pi.single_eq_of_ne hu_ne]
              change (ρ ⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩
                (0 : W)).down = 0
              rw [map_zero]
              rfl
            rw [hB, map_zero]
        change t.coeff • LinearMap.trace (Ω F) (indSpace H_E ρ) (indRep H_E ρ g) = _
        rw [h_tr_ind, Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro u₀ _
        split_ifs with hc
        · rfl
        · exact smul_zero t.coeff
      let c : G_L ⧸ H_E → Ω F := fun u₀ =>
        if hc₀ : (cosetRep u₀)⁻¹ * w₀ * cosetRep u₀ ∈ H_E then
          t.coeff • (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * w₀ * cosetRep u₀, hc₀⟩) : Ω F)
        else 0
      let l_t : X →₀ Ω F :=
        ∑ u₀ : G_L ⧸ H_E,
          Finsupp.single (conjWeilChar F hGal (cosetRep u₀) (termWeilCharOn F L K t)) (c u₀)
      refine ⟨l_t, ?_, ?_, ?_⟩
      · intro w
        rw [h_tr_term (w₀ * ι_K w)]
        dsimp only [l_t]
        rw [map_sum, Finset.sum_apply]
        apply Finset.sum_congr rfl
        intro u₀ _
        rw [Finsupp.linearCombination_single, Pi.smul_apply, smul_eq_mul]
        let s : G_L := cosetRep u₀
        have hw_s : s⁻¹ * ι_K w * s ∈ H_E := by
          change ((s⁻¹ * ι_K w * s : G_L) : AbsGal F) ∈ relWeil F E
          have h_eq : ((s⁻¹ * ι_K w * s : G_L) : AbsGal F) =
              (conjWeilElt F hGal s⁻¹ w : AbsGal F) := rfl
          rw [h_eq]
          exact relWeil_antitone F htK (conjWeilElt F hGal s⁻¹ w).2
        have h_mul_eq : s⁻¹ * (w₀ * ι_K w) * s = (s⁻¹ * w₀ * s) * (s⁻¹ * ι_K w * s) := by
          group
        have h_mem_iff : s⁻¹ * (w₀ * ι_K w) * s ∈ H_E ↔ s⁻¹ * w₀ * s ∈ H_E := by
          rw [h_mul_eq]
          exact Subgroup.mul_mem_cancel_right H_E hw_s
        have h_char_eq : (t.χ (e_sub ⟨s⁻¹ * ι_K w * s, hw_s⟩) : Ω F) =
            v (conjWeilChar F hGal s (termWeilCharOn F L K t)) w := by
          have hterm : termWeilCharOn F L K t = restrictWeilChar F htK t.χ := dif_pos htK
          dsimp only [v]
          rw [hterm]
          rfl
        by_cases hc₀ : s⁻¹ * w₀ * s ∈ H_E
        · have hc : s⁻¹ * (w₀ * ι_K w) * s ∈ H_E := h_mem_iff.mpr hc₀
          have hc_def : c u₀ = t.coeff • (t.χ (e_sub ⟨s⁻¹ * w₀ * s, hc₀⟩) : Ω F) := dif_pos hc₀
          rw [hc_def, dif_pos hc]
          have h_sub_mul : (⟨s⁻¹ * (w₀ * ι_K w) * s, hc⟩ : H_E) =
              ⟨s⁻¹ * w₀ * s, hc₀⟩ * ⟨s⁻¹ * ι_K w * s, hw_s⟩ := by
            apply Subtype.ext
            exact h_mul_eq
          rw [h_sub_mul, map_mul, map_mul, Units.val_mul, ← h_char_eq, zsmul_eq_mul, zsmul_eq_mul, mul_assoc]
        · have hc : s⁻¹ * (w₀ * ι_K w) * s ∉ H_E := fun h => hc₀ (h_mem_iff.mp h)
          have hc_def : c u₀ = 0 := dif_neg hc₀
          rw [hc_def, dif_neg hc, zero_mul]
      · intro hPt χ hnotPχ
        dsimp only [l_t]
        rw [Finsupp.finset_sum_apply]
        apply Finset.sum_eq_zero
        intro u₀ _
        rw [Finsupp.single_apply, if_neg]
        intro h_eq
        apply hnotPχ
        rw [← h_eq, hP (cosetRep u₀) (termWeilCharOn F L K t)]
        exact hPt
      · intro hnotPt χ hPχ
        dsimp only [l_t]
        rw [Finsupp.finset_sum_apply]
        apply Finset.sum_eq_zero
        intro u₀ _
        rw [Finsupp.single_apply, if_neg]
        intro h_eq
        apply hnotPt
        rw [← hP (cosetRep u₀) (termWeilCharOn F L K t), h_eq]
        exact hPχ
    have hlist_finsupp : ∀ (L₀ : List (MonomialTerm F L)),
        (∀ t ∈ L₀, t.Wf F L) →
        (∀ t ∈ L₀, t.field ≤ K) →
        ∃ L_fin : X →₀ Ω F,
          (∀ w : relWeil F K,
            Finsupp.linearCombination (Ω F) v L_fin w = monomialListTrace F L L₀ (w₀ * ι_K w)) ∧
          ((∀ t ∈ L₀, P (termWeilCharOn F L K t)) → ∀ χ : X, ¬ P χ → L_fin χ = 0) ∧
          ((∀ t ∈ L₀, ¬ P (termWeilCharOn F L K t)) → ∀ χ : X, P χ → L_fin χ = 0) := by
      intro L₀
      induction L₀ with
      | nil =>
        intro _ _
        refine ⟨0, ?_, ?_, ?_⟩
        · intro w
          simp [monomialListTrace]
        · intro _ _ _
          rfl
        · intro _ _ _
          rfl
      | cons t tl ih =>
        intro hWf hK
        obtain ⟨l_t, hl_t_tr, hl_t_P, hl_t_notP⟩ :=
          hterm_finsupp t (hWf t (by simp)) (hK t (by simp))
        obtain ⟨L_tl, hL_tl_tr, hL_tl_P, hL_tl_notP⟩ :=
          ih (fun s hs => hWf s (by simp [hs])) (fun s hs => hK s (by simp [hs]))
        refine ⟨l_t + L_tl, ?_, ?_, ?_⟩
        · intro w
          simp only [map_add, Pi.add_apply, hl_t_tr w, hL_tl_tr w,
            monomialListTrace, List.map_cons, List.sum_cons]
        · intro hP_all χ hnotPχ
          rw [Finsupp.add_apply,
              hl_t_P (hP_all t (by simp)) χ hnotPχ,
              hL_tl_P (fun s hs => hP_all s (by simp [hs])) χ hnotPχ,
              add_zero]
        · intro hnotP_all χ hPχ
          rw [Finsupp.add_apply,
              hl_t_notP (hnotP_all t (by simp)) χ hPχ,
              hL_tl_notP (fun s hs => hnotP_all s (by simp [hs])) χ hPχ,
              add_zero]
    set D_P := D.filter b
    set D_notP := D.filter (fun t => !b t)
    obtain ⟨L_P, hL_P_tr, hL_P_supp, _⟩ :=
      hlist_finsupp D_P
        (fun t ht => hD.1 t (List.mem_of_mem_filter ht))
        (fun t ht => hDK t (List.mem_of_mem_filter ht))
    obtain ⟨L_notP, hL_notP_tr, _, hL_notP_supp⟩ :=
      hlist_finsupp D_notP
        (fun t ht => hD.1 t (List.mem_of_mem_filter ht))
        (fun t ht => hDK t (List.mem_of_mem_filter ht))
    have hD_P_prop : ∀ t ∈ D_P, P (termWeilCharOn F L K t) := by
      intro t ht
      exact of_decide_eq_true (List.mem_filter.mp ht).2
    have hD_notP_prop : ∀ t ∈ D_notP, ¬ P (termWeilCharOn F L K t) := by
      intro t ht
      have hbt : (!b t) = true := (List.mem_filter.mp ht).2
      have hbt' : b t = false := Bool.eq_false_iff.mpr (fun h => by rw [h] at hbt; revert hbt; decide)
      exact of_decide_eq_false hbt'
    have h_comb_zero : Finsupp.linearCombination (Ω F) v (L_P + L_notP) = 0 := by
      ext w
      rw [map_add, Pi.add_apply, Pi.zero_apply, hL_P_tr w, hL_notP_tr w,
          ← htrace_filter D (w₀ * ι_K w), ← hD.2 (w₀ * ι_K w), Pi.zero_apply]
    have h_sum_zero : L_P + L_notP = 0 :=
      linearIndependent_iff.mp h_lin_indep (L_P + L_notP) h_comb_zero
    have hL_P_zero : L_P = 0 := by
      ext χ
      rw [Finsupp.zero_apply]
      by_cases hχ : P χ
      · have h1 : (L_P + L_notP) χ = 0 := by rw [h_sum_zero, Finsupp.zero_apply]
        rw [Finsupp.add_apply, hL_notP_supp hD_notP_prop χ hχ, add_zero] at h1
        exact h1
      · exact hL_P_supp hD_P_prop χ hχ
    have h_eval_one := hL_P_tr 1
    rw [hL_P_zero, map_zero, Pi.zero_apply, map_one, mul_one] at h_eval_one
    exact h_eval_one

theorem ld_ch17_conj_monomial_term (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_cand : IsCandidateLambdaOn F rec L K hLK ψ f)
    (t : MonomialTerm F L) (htWf : t.Wf F L) (htK : t.field ≤ K)
    (g : relWeil F L) :
    ∃ t' : MonomialTerm F L,
      t'.Wf F L ∧
      (∀ w : relWeil F L, t'.trace F L w = t.trace F L w) ∧
      evalMonomialTerm F rec (fun _ E _ => f E) L ψ t' =
        evalMonomialTerm F rec (fun _ E _ => f E) L ψ t ∧
      ∃ ht'K : t'.field ≤ K,
        restrictWeilChar F ht'K t'.χ = conjWeilChar F hGal g (restrictWeilChar F htK t.χ) :=
by
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨hWeil_unit_triv, hSepRec_all⟩ := ld_separable_weil_char_rec_and_norm F rec
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear * -
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have hSep_iff : ∀ (L₀ E₀ : IntermediateField F (AlgebraicClosure F)) (h₀ : L₀ ≤ E₀),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars h₀) ↔
        E₀ ≤ IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) := by
    clear * -
    intro L₀ E₀ h₀
    let S := IntermediateField.extendScalars h₀
    have hmin : ∀ x : S, IsSeparable L₀ x.1 ↔ IsSeparable L₀ x := by
      intro x
      change (minpoly L₀ (S.val x)).Separable ↔ (minpoly L₀ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h₀).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₀ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₀ := (IntermediateField.mem_extendScalars h₀).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  haveI : FiniteDimensional F K := hGal.2.1
  have hK_map_mem : ∀ (δ : AbsGal F), δ ∈ L.fixingSubgroup → ∀ z ∈ K, δ z ∈ K := by
    intro δ hδ z hz
    let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
    have hSepLK : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    haveI : Algebra.IsSeparable L K' := hSepLK
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
    haveI : IsGalois L ↥K' := helper_isGalois L (AlgebraicClosure F) K' hK'_norm_fix
    haveI : Normal L ↥K' := IsGalois.to_normal
    let σ_K : K' ≃ₐ[L] K' :=
      AlgEquiv.restrictNormalHom K' ((IntermediateField.fixingSubgroupEquiv L) ⟨δ, hδ⟩)
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
    have hx : ((σ_K x : K') : AlgebraicClosure F) = δ z := by
      change ((AlgEquiv.restrictNormalHom K'
        ((IntermediateField.fixingSubgroupEquiv L) ⟨δ, hδ⟩) x : K') : AlgebraicClosure F) = δ z
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    rw [← hx]
    exact (IntermediateField.mem_extendScalars hLK).mp (σ_K x).2
  
  let E₁ : IntermediateField F (AlgebraicClosure F) := t.field
  have hLE₁ : L ≤ E₁ := t.le
  have hE₁K : E₁ ≤ K := htK
  let χ₁ : relWeil F E₁ →* (Ω F)ˣ := t.χ
  haveI : FiniteDimensional F E₁ := htWf.1
  have hSepLE₁ : Algebra.IsSeparable L (IntermediateField.extendScalars hLE₁) := htWf.2.1
  have hWeil₁ : IsWeilRep F E₁ (charRep F E₁ χ₁) := htWf.2.2
  let γ : AbsGal F := (g : AbsGal F)
  have hγL : γ ∈ L.fixingSubgroup := g.2.2
  let E₂ : IntermediateField F (AlgebraicClosure F) :=
    E₁.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  have hE₂_eq : E₂ = E₁.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := rfl
  have hLE₂ : L ≤ E₂ := by
    intro x hx
    exact ⟨x, hLE₁ hx, (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγL x hx⟩
  have hE₂K : E₂ ≤ K := by
    rintro y ⟨x, hx, rfl⟩
    exact hK_map_mem γ hγL x (hE₁K hx)
  haveI : FiniteDimensional F E₂ :=
    Module.Finite.of_injective (IntermediateField.inclusion hE₂K).toLinearMap
      (IntermediateField.inclusion hE₂K).injective
  have hSepLK : Algebra.IsSeparable L (IntermediateField.extendScalars hLK) := hGal.2.2.2 hLK
  have hSepLE₂ : Algebra.IsSeparable L (IntermediateField.extendScalars hLE₂) :=
    (hSep_iff L E₂ hLE₂).mpr (hE₂K.trans ((hSep_iff L K hLK).mp hSepLK))
  have hf_eq : f E₂ = f E₁ := hf_cand.2.2.1 γ hγL E₁ hLE₁ hE₁K
  have h_inv_apply : ∀ (α : AbsGal F) (x : AlgebraicClosure F), α⁻¹ (α x) = x :=
    fun α x => α.symm_apply_apply x
  have h_apply_inv : ∀ (α : AbsGal F) (x : AlgebraicClosure F), α (α⁻¹ x) = x :=
    fun α x => α.apply_symm_apply x
  have hγ_map_E₁ : ∀ y ∈ E₁, γ y ∈ E₂ := fun y hy => ⟨y, hy, rfl⟩
  have hγ_inv_map_E₂ : ∀ z ∈ E₂, γ⁻¹ z ∈ E₁ := by
    rintro z ⟨x, hx, rfl⟩
    change γ⁻¹ (γ x) ∈ E₁
    rw [h_inv_apply γ x]
    exact hx
  let ϕ : E₁ ≃ₐ[F] E₂ :=
    { toFun := fun y => ⟨γ y.1, hγ_map_E₁ y.1 y.2⟩
      invFun := fun z => ⟨γ⁻¹ z.1, hγ_inv_map_E₂ z.1 z.2⟩
      left_inv := fun y => Subtype.ext (γ.symm_apply_apply y.1)
      right_inv := fun z => Subtype.ext (γ.apply_symm_apply z.1)
      map_mul' := fun x y => Subtype.ext (map_mul γ x.1 y.1)
      map_add' := fun x y => Subtype.ext (map_add γ x.1 y.1)
      commutes' := fun r => Subtype.ext (γ.commutes r) }
  have hConj_fixing : ∀ α ∈ E₂.fixingSubgroup, γ⁻¹ * α * γ ∈ E₁.fixingSubgroup := by
    intro α hα
    rw [IntermediateField.mem_fixingSubgroup_iff] at hα ⊢
    intro x hx
    have hγx : γ x ∈ E₂ := hγ_map_E₁ x hx
    have hα_fix : α (γ x) = γ x := hα (γ x) hγx
    change γ⁻¹ (α (γ x)) = x
    rw [hα_fix, h_inv_apply γ x]
  have hConj_inv_fixing : ∀ β ∈ E₁.fixingSubgroup, γ * β * γ⁻¹ ∈ E₂.fixingSubgroup := by
    intro β hβ
    rw [IntermediateField.mem_fixingSubgroup_iff] at hβ ⊢
    rintro y ⟨x, hx, rfl⟩
    have hβ_fix : β x = x := hβ x hx
    change γ (β (γ⁻¹ (γ x))) = γ x
    rw [h_inv_apply γ x, hβ_fix]
  have hConj_relWeil : ∀ u : relWeil F E₂, γ⁻¹ * (u : AbsGal F) * γ ∈ relWeil F E₁ :=
    fun u => ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem g.2.1) u.2.1) g.2.1,
      hConj_fixing (u : AbsGal F) u.2.2⟩
  have hConj_inv_relWeil : ∀ v : relWeil F E₁, γ * (v : AbsGal F) * γ⁻¹ ∈ relWeil F E₂ :=
    fun v => ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem g.2.1 v.2.1) ((weilGroup F).inv_mem g.2.1),
      hConj_inv_fixing (v : AbsGal F) v.2.2⟩
  let conjHom_g : relWeil F E₂ →* relWeil F E₁ :=
    { toFun := fun u => ⟨γ⁻¹ * (u : AbsGal F) * γ, hConj_relWeil u⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun u₁ u₂ => Subtype.ext (by
        change γ⁻¹ * ((u₁ : AbsGal F) * (u₂ : AbsGal F)) * γ =
          (γ⁻¹ * (u₁ : AbsGal F) * γ) * (γ⁻¹ * (u₂ : AbsGal F) * γ)
        group) }
  let χ₂ : relWeil F E₂ →* (Ω F)ˣ := χ₁.comp conjHom_g
  have hχ₂_conj : ∀ u : relWeil F E₂, χ₂ u = χ₁ (conjHom_g u) := fun _ => rfl
  let t' : MonomialTerm F L := ⟨t.coeff, E₂, hLE₂, χ₂⟩
  have h_primeToP_map : ∀ (α : AbsGal F) (ζ : AlgebraicClosure F),
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (α ζ) := by
    rintro α ζ ⟨n, hn_pos, hpn, hζn⟩
    refine ⟨n, hn_pos, hpn, ?_⟩
    rw [← map_pow, hζn, map_one]
  have h_fix_inertia : ∀ τ : AbsGal F,
      (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ) →
      τ ∈ inertia F := by
    intro τ hτ
    let K_fix : IntermediateField F (AlgebraicClosure F) :=
      { carrier := {x : AlgebraicClosure F | τ x = x}
        algebraMap_mem' := fun r => τ.commutes r
        zero_mem' := map_zero τ
        one_mem' := map_one τ
        add_mem' := fun {a b} ha hb => by change τ (a + b) = a + b; rw [map_add, ha, hb]
        mul_mem' := fun {a b} ha hb => by change τ (a * b) = a * b; rw [map_mul, ha, hb]
        inv_mem' := fun {a} ha => by change τ a⁻¹ = a⁻¹; rw [map_inv₀, ha] }
    have hle : unramifiedClosure F ≤ K_fix := by
      unfold unramifiedClosure
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      exact hτ ζ hζ
    change τ ∈ (unramifiedClosure F).fixingSubgroup
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact hle hx
  obtain ⟨hFin_Ω, U₁, hU₁_nhds, hU₁_triv⟩ := htWf.2.2
  obtain ⟨E_U, hFinEU, hEU_sub⟩ :=
    (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U₁).mp hU₁_nhds
  haveI : FiniteDimensional F E_U := hFinEU
  let E_U' : IntermediateField F (AlgebraicClosure F) :=
    E_U.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  haveI : FiniteDimensional F E_U' :=
    Module.Finite.equiv (E_U.equivMap (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)).toLinearEquiv
  let U₂ : Set (AbsGal F) := (E_U'.fixingSubgroup : Set (AbsGal F))
  have hU₂_nhds : U₂ ∈ nhds (1 : AbsGal F) :=
    (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U₂).mpr ⟨E_U', inferInstance, Set.Subset.rfl⟩
  have hWeil₂ : IsWeilRep F E₂ (charRep F E₂ χ₂) := by
    refine ⟨hFin_Ω, U₂, hU₂_nhds, fun u huU huI => ?_⟩
    have hu₁_fix : (conjHom_g u : AbsGal F) ∈ E_U.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have hγx : (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) x ∈ E_U' := ⟨x, hx, rfl⟩
      have hu_fix : (u : AbsGal F) (γ x) = γ x :=
        (IntermediateField.mem_fixingSubgroup_iff E_U' (u : AbsGal F)).mp huU (γ x) hγx
      change γ⁻¹ ((u : AbsGal F) (γ x)) = x
      rw [hu_fix, h_inv_apply γ x]
    have hu₁_I : (conjHom_g u : AbsGal F) ∈ inertia F := by
      apply h_fix_inertia
      intro ζ hζ
      have hγζ : IsPrimeToPRootOfUnity F (γ ζ) := h_primeToP_map γ ζ hζ
      have hγζ_mem : γ ζ ∈ unramifiedClosure F :=
        IntermediateField.subset_adjoin F {z | IsPrimeToPRootOfUnity F z} hγζ
      have hu_fix : (u : AbsGal F) (γ ζ) = γ ζ :=
        (IntermediateField.mem_fixingSubgroup_iff (unramifiedClosure F) (u : AbsGal F)).mp huI (γ ζ) hγζ_mem
      change γ⁻¹ ((u : AbsGal F) (γ ζ)) = ζ
      rw [hu_fix, h_inv_apply γ ζ]
    change charRep F E₁ χ₁ (conjHom_g u) = 1
    exact hU₁_triv (conjHom_g u) (hEU_sub hu₁_fix) hu₁_I
  have ht'Wf : t'.Wf F L := ⟨inferInstance, hSepLE₂, hWeil₂⟩
  
  let G_L := relWeil F L
  let H₁ := (relWeil F E₁).subgroupOf G_L
  let H₂ := (relWeil F E₂).subgroupOf G_L
  let ρ₁ := (charRep F E₁ χ₁).comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE₁)).toMonoidHom
  let ρ₂ := (charRep F E₂ χ₂).comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE₂)).toMonoidHom
  let Φ : indSpace H₁ ρ₁ ≃ₗ[Ω F] indSpace H₂ ρ₂ :=
    { toFun := fun φ =>
        ⟨fun x => φ.1 (g⁻¹ * x), fun h₂ x => by
          have hh₁ : g⁻¹ * (h₂ : G_L) * g ∈ H₁ :=
            Subgroup.mem_subgroupOf.mpr (hConj_relWeil ⟨(h₂ : G_L).1, Subgroup.mem_subgroupOf.mp h₂.2⟩)
          let h₁ : H₁ := ⟨g⁻¹ * (h₂ : G_L) * g, hh₁⟩
          have h_grp : g⁻¹ * ((h₂ : G_L) * x) = (h₁ : G_L) * (g⁻¹ * x) := by
            change g⁻¹ * ((h₂ : G_L) * x) = (g⁻¹ * (h₂ : G_L) * g) * (g⁻¹ * x)
            group
          dsimp only
          rw [h_grp, φ.2 h₁ (g⁻¹ * x)]
          rfl⟩
      invFun := fun ψ₀ =>
        ⟨fun x => ψ₀.1 (g * x), fun h₁ x => by
          have hh₂ : g * (h₁ : G_L) * g⁻¹ ∈ H₂ :=
            Subgroup.mem_subgroupOf.mpr (hConj_inv_relWeil ⟨(h₁ : G_L).1, Subgroup.mem_subgroupOf.mp h₁.2⟩)
          let h₂ : H₂ := ⟨g * (h₁ : G_L) * g⁻¹, hh₂⟩
          have h_grp : g * ((h₁ : G_L) * x) = (h₂ : G_L) * (g * x) := by
            change g * ((h₁ : G_L) * x) = (g * (h₁ : G_L) * g⁻¹) * (g * x)
            group
          have h_ρ : ρ₂ h₂ = ρ₁ h₁ := by
            have h_sub : conjHom_g ⟨(h₂ : G_L).1, Subgroup.mem_subgroupOf.mp h₂.2⟩ =
                ⟨(h₁ : G_L).1, Subgroup.mem_subgroupOf.mp h₁.2⟩ := by
              apply Subtype.ext
              change γ⁻¹ * (γ * (h₁ : AbsGal F) * γ⁻¹) * γ = (h₁ : AbsGal F)
              group
            change charRep F E₁ χ₁ (conjHom_g ⟨(h₂ : G_L).1, Subgroup.mem_subgroupOf.mp h₂.2⟩) =
              charRep F E₁ χ₁ ⟨(h₁ : G_L).1, Subgroup.mem_subgroupOf.mp h₁.2⟩
            rw [h_sub]
          dsimp only
          rw [h_grp, ψ₀.2 h₂ (g * x), h_ρ]⟩
      left_inv := fun φ => Subtype.ext (funext fun x => by simp [mul_assoc])
      right_inv := fun ψ₀ => Subtype.ext (funext fun x => by simp [mul_assoc])
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have htr_eq : ∀ w : relWeil F L, t'.trace F L w = t.trace F L w := by
    intro w
    have hConj_w : Φ.conj (indLM F hLE₁ (charRep F E₁ χ₁) w) = indLM F hLE₂ (charRep F E₂ χ₂) w := by
      apply LinearMap.ext
      intro ψ₀
      apply Subtype.ext
      funext x
      change ψ₀.1 (g * ((g⁻¹ * x) * w)) = ψ₀.1 (x * w)
      have h_assoc : g * ((g⁻¹ * x) * w) = x * w := by group
      rw [h_assoc]
    simp only [t', MonomialTerm.trace]
    congr 1
    rw [← hConj_w]
    exact LinearMap.trace_conj' (indLM F hLE₁ (charRep F E₁ χ₁) w) Φ
  
  have hrelVal_ϕ : ∀ x : E₁, relVal F E₂ (ϕ x) = relVal F E₁ x := by
    intro x
    unfold relVal
    rw [Algebra.norm_eq_of_algEquiv ϕ x]
  have hresDeg_eq : resDeg F E₂ = resDeg F E₁ := by
    unfold resDeg
    congr 1
    ext k
    simp only [Set.mem_setOf_eq]
    refine ⟨fun ⟨hk, y, hy0, hrel⟩ => ⟨hk, ϕ.symm y, (map_ne_zero ϕ.symm).mpr hy0, ?_⟩,
            fun ⟨hk, x, hx0, hrel⟩ => ⟨hk, ϕ x, (map_ne_zero ϕ).mpr hx0, ?_⟩⟩
