    have hresDeg : resDeg F K = ℓ * resDeg F M_C := by
      apply le_antisymm
      · let zMC : M_Cˣ := ϖMC ^ ℓ
        have hzMC_val : valL F M_C (zMC : M_C) = (ℓ : ℤ) := by
