  let v₁ : M₁'ˣ := (Units.map τ₁.toRingEquiv.toMonoidHom u₁) * u₁⁻¹
  have hθ_v1_eq_νV : θM₁' v₁ = νE' (Units.mk0 V hV_ne) := by
    change θM₁' ((Units.map τ₁.toRingEquiv.toMonoidHom u₁) * u₁⁻¹) = νE' (Units.mk0 V hV_ne)
    rw [map_mul, map_inv, hτ₁_twist u₁, mul_inv_cancel_right]
    have hmap : Units.map (normLM F hLM₁') u₁ = Units.mk0 V hV_ne := by
      apply Units.ext
      exact hnorm_u1
    rw [MonoidHom.comp_apply, hmap]
