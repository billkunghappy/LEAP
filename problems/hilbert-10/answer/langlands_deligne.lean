by
  rcases hvalL_props with
    ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
      _, hval_add_L, _, _, _⟩
  rcases hvalK_props with
    ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K,
      _, hval_add_K, _, _, _⟩
  set p := Module.finrank L (IntermediateField.extendScalars hLK)
  set k := (p - 1) / 2
  set b := condExp F L ν₁
  set a := condExp F L χ'
  set m_ab := a - b
  set χ'_K : Kˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLK))
  set ψ_K : AddChar K (Ω F) := traceChar F hLK ψ
  set a_K := condExp F K χ'_K
  set d_a := a / 2
  set d_K := a_K / 2
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_mod2 : p % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime).resolve_left hp_odd
  have hp_pos : 0 < p := by omega
  have hp_pos_Z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
  have hp_ge1_Z : (1 : ℤ) ≤ (p : ℤ) := by omega
  have hp_eq : p = 2 * k + 1 := by omega
  have hp_sub1 : p - 1 = 2 * k := by omega
  have ha_ge2 : 2 ≤ a := by omega
  have ha_eq_b : a = b + m_ab := by omega
  have ha_div : a = 2 * d_a + a % 2 := by omega
  have haK_step1 : a_K = b + (2 * k + 1) * m_ab := by
    change a_K = b + p * m_ab at haK
    rw [haK, hp_eq]
  have haK_step2 : b + (2 * k + 1) * m_ab = (b + m_ab) + 2 * (k * m_ab) := by ring
  have haK_eq : a_K = a + 2 * (k * m_ab) := by omega
  have haK_ge2 : 2 ≤ a_K := by omega
  have haK_mod : a_K % 2 = a % 2 := by omega
  have hdK_eq : d_K = d_a + k * m_ab := by omega
  have hd_sum : d_K + k * b = p * d_a + k * (a % 2) := by
    calc d_K + k * b
      _ = (d_a + k * m_ab) + k * b := by rw [hdK_eq]
      _ = d_a + k * (b + m_ab) := by ring
      _ = d_a + k * (2 * d_a + a % 2) := by rw [← ha_eq_b, ← ha_div]
      _ = (2 * k + 1) * d_a + k * (a % 2) := by ring
      _ = p * d_a + k * (a % 2) := by rw [← hp_eq]
  have hϖ_L_pow_ne_zero : ∀ n : ℕ, ((ϖ_L : L) ^ n) ≠ 0 :=
    fun n => pow_ne_zero n (Units.ne_zero ϖ_L)
  have hϖ_L_pow_val : ∀ n : ℕ, valL F L ((ϖ_L : L) ^ n) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simp [hval1_L]
    · rw [pow_succ, hval_mul_L _ _ (hϖ_L_pow_ne_zero n) (Units.ne_zero ϖ_L), ih, hϖ_L]
      push_cast
      ring
  have hϖ_K_pow_ne_zero : ∀ n : ℕ, ((ϖ_K : K) ^ n) ≠ 0 :=
    fun n => pow_ne_zero n (Units.ne_zero ϖ_K)
  have hϖ_K_pow_val : ∀ n : ℕ, valL F K ((ϖ_K : K) ^ n) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simp [hval1_K]
    · rw [pow_succ, hval_mul_K _ _ (hϖ_K_pow_ne_zero n) (Units.ne_zero ϖ_K), ih, hϖ_K]
      push_cast
      ring
  set δ_a : Lˣ := ϖ_L ^ d_a
  have hδa_val : valL F L (δ_a : L) = (d_a : ℤ) := by
    change valL F L (((ϖ_L ^ d_a : Lˣ) : L)) = (d_a : ℤ)
    rw [Units.val_pow_eq_pow_val]
    exact hϖ_L_pow_val d_a
  have hinj : Function.Injective (IntermediateField.inclusion hLK) :=
    (IntermediateField.inclusion hLK).injective
  set R_K : Finset K := R_L.image (IntermediateField.inclusion hLK)
  have hRK_card : R_K.card = Fintype.card k_L := by
    rw [Finset.card_image_of_injective R_L hinj, hRL_card]
  have hRK_int : ∀ r ∈ R_K, r = 0 ∨ 0 ≤ valL F K r := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨r_L, hr_L, rfl⟩
