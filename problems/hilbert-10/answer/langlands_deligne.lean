      intro m hm_lt hm_pos
      have hB_props := hB_sub_b m hm_lt hm_pos
      have hNB_eq : N_fn m - B_fn m = B_fn m * ν_fn m := by
        dsimp only [N_fn, B_fn, ν_fn]
        have h1 := congrArg nmM₁'K₁ (hu_props m hm_lt hm_pos).1
