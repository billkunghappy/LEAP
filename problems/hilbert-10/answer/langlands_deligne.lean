      · simp [evalMonomialList]
    · have hInfCase : ∀ (F'₀ : IntermediateField F (AlgebraicClosure F))
          (hLF'₀ : L ≤ F'₀) (hF'₀E : F'₀ ≤ E) (hF'₀M : F'₀ ≤ M) (hF'₀_inf : E ⊓ M ≤ F'₀),
