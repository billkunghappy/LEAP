          (r : ℤ) * (t₁ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (((t₁ + p * (bE' - bM₁') + 1 : ℕ) : ℤ)) := by
      intro r hr
      obtain ⟨hr2, hr_p1⟩ := Finset.mem_Icc.mp hr
      have hpr_le : (p - r) * t₁ ≤ (p - 2) * t₁ := Nat.mul_le_mul_right t₁ (by omega : p - r ≤ p - 2)
      have hpr_z : (((p - r) * t₁ : ℕ) : ℤ) ≤ (((p - 2) * t₁ : ℕ) : ℤ) := by exact_mod_cast hpr_le
      have hr_le : r * t₁ ≤ (p - 1) * (t₁ + p * (bE' - bM₁') + 1) :=
        Nat.mul_le_mul hr_p1 (by omega : t₁ ≤ t₁ + p * (bE' - bM₁') + 1)
      have hr_z : ((r * t₁ : ℕ) : ℤ) ≤ (((p - 1) * (t₁ + p * (bE' - bM₁') + 1) : ℕ) : ℤ) := by
        exact_mod_cast hr_le
      push_cast at hpr_z hr_z
      exact ⟨Finset.mem_Icc.mpr ⟨by omega, hr_p1⟩, hpr_z, hr_z⟩
    have hIcc_1_p1_idx : ∀ s ∈ Finset.Icc 1 (p - 1),
        s ≤ p ∧ ((p - s : ℕ) : ℤ) = (p : ℤ) - (s : ℤ) ∧
          ((p - s : ℕ) : ℤ) * (t₁ : ℤ) ≤
            ((p - 1 : ℕ) : ℤ) * (((t₁ + p * (bE' - bM₁') + 1 : ℕ) : ℤ)) := by
      intro s hs
      obtain ⟨hs1, hs2⟩ := Finset.mem_Icc.mp hs
      have hps_le : (p - s) * t₁ ≤ (p - 1) * (t₁ + p * (bE' - bM₁') + 1) :=
        Nat.mul_le_mul (by omega : p - s ≤ p - 1) (by omega : t₁ ≤ t₁ + p * (bE' - bM₁') + 1)
      have hps_z : (((p - s) * t₁ : ℕ) : ℤ) ≤
          (((p - 1) * (t₁ + p * (bE' - bM₁') + 1) : ℕ) : ℤ) := by exact_mod_cast hps_le
      push_cast at hps_z
      exact ⟨by omega, Nat.cast_sub (by omega : s ≤ p), hps_z⟩

    have herase_range : (Finset.range p).erase 0 = Finset.Icc 1 (p - 1) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_Icc]
      omega
    have herase_Icc_p : (Finset.Icc 1 p).erase p = Finset.Icc 1 (p - 1) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_Icc]
      omega
    have herase_Icc_bot : (Finset.Icc 1 (p - 1)).erase 1 = Finset.Icc 2 (p - 1) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_Icc]
      omega
    have herase_Icc_top : (Finset.Icc 1 (p - 1)).erase (p - 1) = Finset.Icc 1 (p - 2) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_Icc]
      omega
    have hIcc_split_top : ∀ {R : Type u} [AddCommMonoid R] (f : ℕ → R),
        (∑ r ∈ Finset.Icc 1 (p - 1), f r) =
          (∑ r ∈ Finset.Icc 1 (p - 2), f r) + f (p - 1) := by
      intro R _ f
      have hp1 : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hp1_ge1, le_rfl⟩
      rw [← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) f hp1, herase_Icc_top, add_comm]
    have hadd_pow_split1 : ∀ {R : Type u} [CommRing R] (x y : R),
        (x + y) ^ p =
          y ^ p +
            (∑ r ∈ Finset.Icc 1 (p - 1), x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)) +
            x ^ p := by
      intro R _ x y
      let f : ℕ → R := fun r => x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)
      have h0 : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
      have hsplit : (∑ r ∈ Finset.range (p + 1), f r) =
          f 0 + (∑ r ∈ Finset.Icc 1 (p - 1), f r) + f p := by
        rw [Finset.sum_range_succ f p, ← Finset.add_sum_erase (Finset.range p) f h0, herase_range]
      have hf0 : f 0 = y ^ p := by
        dsimp [f]
        rw [pow_zero, one_mul, Nat.choose_zero_right, Nat.cast_one, mul_one]
      have hfp : f p = x ^ p := by
        dsimp [f]
        rw [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one, mul_one]
      rw [add_pow x y p]
      exact hsplit.trans (by rw [hf0, hfp])
    have hadd_pow_split2 : ∀ {R : Type u} [CommRing R] (x y : R),
        (x + y) ^ p =
          y ^ p + x * y ^ (p - 1) * ((p : ℕ) : R) +
            (∑ r ∈ Finset.Icc 2 (p - 1), x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)) +
            x ^ p := by
      intro R _ x y
      let f : ℕ → R := fun r => x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)
      have h1 : 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨le_rfl, hp1_ge1⟩
      have hsplit : (∑ r ∈ Finset.Icc 1 (p - 1), f r) =
          f 1 + ∑ r ∈ Finset.Icc 2 (p - 1), f r := by
        rw [← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) f h1, herase_Icc_bot]
      have hf1 : f 1 = x * y ^ (p - 1) * ((p : ℕ) : R) := by
        dsimp [f]
        rw [pow_one, Nat.choose_one_right]
      rw [hadd_pow_split1 x y, hsplit, hf1, ← add_assoc (y ^ p)]

    have hp1_t₁_le_t₂ : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
      exact_mod_cast Nat.mul_le_mul_left (p - 1) ht_le
    have h2t₁_le_p2t₁ : 2 * (t₁ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) + (t₁ : ℤ) := by
      have h1 : 1 * t₁ ≤ (p - 2) * t₁ := Nat.mul_le_mul_right t₁ hp2_ge1
      have h2_le : 2 * t₁ ≤ (p - 2) * t₁ + t₁ := by
        calc 2 * t₁ = 1 * t₁ + t₁ := by ring
          _ ≤ (p - 2) * t₁ + t₁ := Nat.add_le_add_right h1 t₁
      have h2_z : ((2 * t₁ : ℕ) : ℤ) ≤ (((p - 2) * t₁ + t₁ : ℕ) : ℤ) := by exact_mod_cast h2_le
      push_cast at h2_z
      exact h2_z
    have hτ1_mem : 1 ∈ Finset.Icc 1 (2 * (p - 1)) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
    have hndvd1 : ¬ ((p - 1) ∣ 1) := Nat.not_dvd_of_pos_of_lt Nat.one_pos hp1_gt1

    have hchoose_valM₁' : ∀ r ∈ Finset.Icc 1 (p - 1),
        ((p.choose r : ℕ) : R_M) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ vM₁' ((p.choose r : ℕ) : R_M) := by
      intro r hr
      obtain ⟨hr1, hr2⟩ := Finset.mem_Icc.mp hr
      obtain ⟨k, hk⟩ := Nat.Prime.dvd_choose_self hPrime (by omega : r ≠ 0) (by omega : r < p)
      rw [hk, Nat.cast_mul]
      have hmul := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
        ((p : ℕ) : R_M) (k : R_M) (hp_valM₁' _ le_rfl) (hvalM₁'_natCast k)
      rwa [add_zero] at hmul

    have hr_ne0_M₁' : ∀ r ∈ Finset.Icc 1 (p - 1), ((r : ℕ) : R_M) ≠ 0 := by
      intro r hr
      obtain ⟨hr1, hr2⟩ := Finset.mem_Icc.mp hr
      have hcop : Nat.Coprime r p :=
        ((Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt hr1 (by omega))).symm
      have hmod : r ^ (p - 1) ≡ 1 [MOD p] := by
        rw [← Nat.totient_prime hPrime]
        exact Nat.ModEq.pow_totient hcop
      have hrem : r ^ (p - 1) % p = 1 := by
        change r ^ (p - 1) % p = 1 % p at hmod
        rwa [Nat.mod_eq_of_lt hPrime.one_lt] at hmod
      have hdiv_nat : p * (r ^ (p - 1) / p) + 1 = r * r ^ (p - 2) := by
        calc p * (r ^ (p - 1) / p) + 1 = p * (r ^ (p - 1) / p) + r ^ (p - 1) % p := by rw [hrem]
          _ = r ^ (p - 1) := Nat.div_add_mod (r ^ (p - 1)) p
          _ = r ^ ((p - 2) + 1) := by congr 1; omega
          _ = r * r ^ (p - 2) := pow_succ' r (p - 2)
      intro hr0
      have hcast := congrArg (Nat.cast : ℕ → R_M) hdiv_nat
      push_cast at hcast
      rw [hr0, zero_mul] at hcast
      have hpq_eq : ((p : ℕ) : R_M) * ((r ^ (p - 1) / p : ℕ) : R_M) = -1 := by
        linear_combination hcast
      have hpq_val := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
        ((p : ℕ) : R_M) ((r ^ (p - 1) / p : ℕ) : R_M)
        (hp_valM₁' _ le_rfl) (hvalM₁'_natCast (r ^ (p - 1) / p))
      rw [hpq_eq, add_zero, hvalM₁'_neg1] at hpq_val
      rcases hpq_val with hneg1_0 | hle0
      · exact neg_ne_zero.mpr one_ne_zero hneg1_0
      · have hpos : (0 : ℤ) < ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by positivity
        linarith only [hle0, hpos]

    have hs₁_scale : ∀ (c : R_M) (r : ℕ),
        r ∈ Finset.Icc 1 (p - 1) →
        s₁ (iM₁'K₁ c * Δ_val) r = c ^ r * s₁ Δ_val r := by
      intro c r
      induction' r using Nat.strong_induction_on with r ih
      intro hr
      have htr_wc_pow : ∀ m : ℕ,
          trM₁'K₁ ((iM₁'K₁ c * Δ_val) ^ m) = c ^ m * trM₁'K₁ (Δ_val ^ m) := by
        intro m
        have hpow : (iM₁'K₁ c * Δ_val) ^ m = iM₁'K₁ (c ^ m) * Δ_val ^ m := by
          rw [mul_pow, map_pow]
        rw [hpow, htr_smul_M₁'K₁]
      have hnew_wc := hs₁_newton1 (iM₁'K₁ c * Δ_val) r hr
      have hnew_Δ := hs₁_newton1 Δ_val r hr
      have hsum_scale :
          (∑ j ∈ Finset.Icc 1 (r - 1),
            (-1 : R_M) ^ (j - 1) * s₁ (iM₁'K₁ c * Δ_val) j *
              trM₁'K₁ ((iM₁'K₁ c * Δ_val) ^ (r - j))) =
          c ^ r * (∑ j ∈ Finset.Icc 1 (r - 1),
            (-1 : R_M) ^ (j - 1) * s₁ Δ_val j * trM₁'K₁ (Δ_val ^ (r - j))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j hj => ?_
        obtain ⟨hj1, hj2⟩ := Finset.mem_Icc.mp hj
        obtain ⟨hr1, hr2⟩ := Finset.mem_Icc.mp hr
        have hj_lt : j < r := by omega
        have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
        rw [htr_wc_pow (r - j), ih j hj_lt hj_mem]
        have hpow_add : c ^ j * c ^ (r - j) = c ^ r := by
          rw [← pow_add, show j + (r - j) = r by omega]
        calc (-1 : R_M) ^ (j - 1) * (c ^ j * s₁ Δ_val j) * (c ^ (r - j) * trM₁'K₁ (Δ_val ^ (r - j)))
            = (c ^ j * c ^ (r - j)) * ((-1 : R_M) ^ (j - 1) * s₁ Δ_val j * trM₁'K₁ (Δ_val ^ (r - j))) := by ring
          _ = c ^ r * ((-1 : R_M) ^ (j - 1) * s₁ Δ_val j * trM₁'K₁ (Δ_val ^ (r - j))) := by rw [hpow_add]
      have heq_coeff :
          ((-1 : R_M) ^ (r - 1) * ((r : ℕ) : R_M)) * s₁ (iM₁'K₁ c * Δ_val) r =
          ((-1 : R_M) ^ (r - 1) * ((r : ℕ) : R_M)) * (c ^ r * s₁ Δ_val r) := by
        have htr_r := htr_wc_pow r
        linear_combination hnew_wc + htr_r - hsum_scale - c ^ r * hnew_Δ
      have hcoeff_ne0 : (-1 : R_M) ^ (r - 1) * ((r : ℕ) : R_M) ≠ 0 :=
        mul_ne_zero (pow_ne_zero (r - 1) (neg_ne_zero.mpr one_ne_zero)) (hr_ne0_M₁' r hr)
      exact mul_left_cancel₀ hcoeff_ne0 heq_coeff

    have hpoly_zeroM₁' : ∀ (n : ℕ) (d : ℕ → R_M),
        (∀ c : R_M, (∑ r ∈ Finset.Icc 1 n, c ^ r * d r) = 0) →
        ∀ r ∈ Finset.Icc 1 n, d r = 0 := by
      intro n
      induction n with
      | zero =>
        intro d _ r hr
        have h1 := (Finset.mem_Icc.mp hr).1
        have h2 := (Finset.mem_Icc.mp hr).2
        omega
      | succ n ih =>
        intro d hd
        have hd_top : d (n + 1) = 0 := by
          by_contra hne_top
          have hM_ex : ∃ M : ℤ, 1 ≤ M ∧
              ∀ r ∈ Finset.Icc 1 n, vM₁' (d (n + 1)) - vM₁' (d r) ≤ M - 1 := by
            refine ⟨(∑ r ∈ Finset.Icc 1 n, |vM₁' (d r) - vM₁' (d (n + 1))|) + 1, ?_, ?_⟩
            · have h0 : 0 ≤ ∑ r ∈ Finset.Icc 1 n, |vM₁' (d r) - vM₁' (d (n + 1))| :=
                Finset.sum_nonneg (fun r _ => abs_nonneg _)
              linarith only [h0]
            · intro r hr
              have hsingle := Finset.single_le_sum
                (f := fun k => |vM₁' (d k) - vM₁' (d (n + 1))|)
                (fun k _ => abs_nonneg _) hr
              have hneg := neg_le_abs (vM₁' (d r) - vM₁' (d (n + 1)))
              linarith only [hsingle, hneg]
          rcases hM_ex with ⟨M, hM_ge1, hM_bound⟩
          obtain ⟨u, hc_ne0, hu_val⟩ := hvalM₁'_surj (-M)
          have htop_ne0 : u ^ (n + 1) * d (n + 1) ≠ 0 :=
            mul_ne_zero (pow_ne_zero (n + 1) hc_ne0) hne_top
          have htop_val : vM₁' (u ^ (n + 1) * d (n + 1)) =
              - (((n + 1 : ℕ) : ℤ) * M) + vM₁' (d (n + 1)) := by
            rw [hvalM₁'_mul (u ^ (n + 1)) (d (n + 1))
              (pow_ne_zero (n + 1) hc_ne0) hne_top,
              (hvalM₁'_pow_eq u hc_ne0 (n + 1)).2, hu_val]
            ring
          have hlow_term : ∀ r ∈ Finset.Icc 1 n,
              u ^ r * d r = 0 ∨
                (- (((n + 1 : ℕ) : ℤ) * M) + vM₁' (d (n + 1))) + 1 ≤
                  vM₁' (u ^ r * d r) := by
            intro r hr
            by_cases hdr : d r = 0
            · left; rw [hdr, mul_zero]
            · right
              have hr_le : r ≤ n := (Finset.mem_Icc.mp hr).2
              have h1_sub : (1 : ℤ) ≤ ((n + 1 : ℕ) : ℤ) - (r : ℤ) := by omega
              have hdiff_le := hM_bound r hr
              have hval_r : vM₁' (u ^ r * d r) = - ((r : ℤ) * M) + vM₁' (d r) := by
                rw [hvalM₁'_mul (u ^ r) (d r) (pow_ne_zero r hc_ne0) hdr,
                  (hvalM₁'_pow_eq u hc_ne0 r).2, hu_val]
                ring
              rw [hval_r]
              have hstep2 : M ≤ (((n + 1 : ℕ) : ℤ) - (r : ℤ)) * M := by
                have h2 := mul_le_mul_of_nonneg_right h1_sub (by linarith only [hM_ge1] : (0 : ℤ) ≤ M)
                linarith only [h2]
              linarith only [hdiff_le, hstep2]
          have hlow_sum := hvalM₁'_sum_ge (Finset.Icc 1 n) (fun r => u ^ r * d r)
            ((- (((n + 1 : ℕ) : ℤ) * M) + vM₁' (d (n + 1))) + 1) hlow_term
          have hsplit :
              (∑ r ∈ Finset.Icc 1 (n + 1), u ^ r * d r) =
                (∑ r ∈ Finset.Icc 1 n, u ^ r * d r) + u ^ (n + 1) * d (n + 1) :=
            Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => u ^ r * d r)
          have hsum0 :
              (∑ r ∈ Finset.Icc 1 n, u ^ r * d r) + u ^ (n + 1) * d (n + 1) = 0 := by
            rw [← hsplit]
            exact hd u
          have heq_neg :
              u ^ (n + 1) * d (n + 1) = - (∑ r ∈ Finset.Icc 1 n, u ^ r * d r) :=
            eq_neg_of_add_eq_zero_right hsum0
          rcases hlow_sum with hlow0 | hlow_ge
          · rw [hlow0, neg_zero] at heq_neg
            exact htop_ne0 heq_neg
          · have hval_eq :
                vM₁' (u ^ (n + 1) * d (n + 1)) = vM₁' (∑ r ∈ Finset.Icc 1 n, u ^ r * d r) := by
              rw [heq_neg, hvalM₁'_neg]
            linarith only [htop_val, hval_eq, hlow_ge]
        have hd_low : ∀ c : R_M, (∑ r ∈ Finset.Icc 1 n, c ^ r * d r) = 0 := by
          intro c
          have hsplit :=
            Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => c ^ r * d r)
          rw [hd c, hd_top, mul_zero, add_zero] at hsplit
          exact hsplit.symm
        intro r hr
        rcases Nat.eq_or_lt_of_le (Finset.mem_Icc.mp hr).2 with rfl | hlt
        · exact hd_top
        · exact ih d hd_low r
            (Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp hr).1, Nat.lt_succ_iff.mp hlt⟩)

    have he_Δ_eq_s₁ : ∀ i ∈ Finset.Icc 1 (p - 1), e_Δ i = s₁ Δ_val i := by
      have hdiff_zero : ∀ c : R_M,
          (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * (e_Δ i - s₁ Δ_val i)) = 0 := by
        intro c
        have h1 := hs₁_norm_one_add (iM₁'K₁ c * Δ_val)
        have hnorm_prod : nmM₁'K₁ (iM₁'K₁ c * Δ_val) = c ^ p * nmM₁'K₁ Δ_val := by
          rw [map_mul, hnorm_incl_M₁'K₁ c]
        have hsum_s₁ :
            (∑ i ∈ Finset.Icc 1 (p - 1), s₁ (iM₁'K₁ c * Δ_val) i) =
            ∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * s₁ Δ_val i :=
          Finset.sum_congr rfl (fun i hi => hs₁_scale c i hi)
        rw [hnorm_prod, hsum_s₁, he_Δ_poly c, ← hb_def] at h1
        have h2 : (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e_Δ i) -
            (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * s₁ Δ_val i) = 0 := by
          linear_combination h1
        rw [← Finset.sum_sub_distrib] at h2
        rw [← h2]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
      intro i hi
      exact sub_eq_zero.mp (hpoly_zeroM₁' (p - 1) (fun k => e_Δ k - s₁ Δ_val k) hdiff_zero i hi)
    clear hr_ne0_M₁' hs₁_scale hpoly_zeroM₁' hs₁_norm_one_add

    have he_fn_val_low : ∀ i ∈ Finset.Icc 1 (p - 1),
        e_fn i = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤ vM₁' (e_fn i) := by
      intro i hi
      have hi_ne_p : i ≠ p := by
        have hi_le : i ≤ p - 1 := (Finset.mem_Icc.mp hi).2
        omega
      rw [he_fn_def, if_neg hi_ne_p]
      rcases he_Δ_val i hi with h0 | hge
      · left; rw [h0, mul_zero]
      · right; rwa [hvalM₁'_neg1_pow_mul]
    have htr_Δ_val_low : ∀ d ∈ Finset.Icc 1 (p - 1),
        trM₁'K₁ (Δ_val ^ d) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (d : ℤ) * (t₁ : ℤ) ≤
            vM₁' (trM₁'K₁ (Δ_val ^ d)) := by
      intro d hd
      have htw := hTwistedTr (1 : R_E) d hd
      rw [map_one, one_mul, hvalE'_1, add_zero] at htw
      exact htw.resolve_left one_ne_zero
    have hΔ_cayley_split :
        Δ_val ^ p =
          iM₁'K₁ b +
            ∑ j ∈ Finset.Icc 1 (p - 1), iM₁'K₁ (e_fn j) * Δ_val ^ (p - j) := by
      rw [hs₁_cayley Δ_val, ← hb_def]
      congr 1
      refine Finset.sum_congr rfl fun j hj => ?_
      have hj_ne_p : j ≠ p := by
        have hj_le : j ≤ p - 1 := (Finset.mem_Icc.mp hj).2
        omega
      have he_j : e_fn j = (-1 : R_M) ^ (j - 1) * s₁ Δ_val j := by
        rw [he_fn_def, if_neg hj_ne_p, he_Δ_eq_s₁ j hj]
      rw [he_j, map_mul, map_pow, map_neg, map_one]
    have hΔ_cayley_full :
        Δ_val ^ p =
          ∑ j ∈ Finset.Icc 1 p, iM₁'K₁ (e_fn j) * Δ_val ^ (p - j) := by
      have hp_mem : p ∈ Finset.Icc 1 p := Finset.mem_Icc.mpr ⟨hp_pos, le_rfl⟩
      rw [← Finset.add_sum_erase (Finset.Icc 1 p)
        (fun j => iM₁'K₁ (e_fn j) * Δ_val ^ (p - j)) hp_mem]
      have hep : e_fn p = b := by rw [he_fn_def, if_pos rfl]
      rw [herase_Icc_p, hep, Nat.sub_self, pow_zero, mul_one]
      exact hΔ_cayley_split
    have htr_Δ_rec : ∀ D : ℕ, p ≤ D →
        trM₁'K₁ (Δ_val ^ D) =
          ∑ j ∈ Finset.Icc 1 p, e_fn j * trM₁'K₁ (Δ_val ^ (D - j)) := by
      intro D hD
      have hpow : Δ_val ^ D = Δ_val ^ p * Δ_val ^ (D - p) := by
        rw [← pow_add, show p + (D - p) = D by omega]
      rw [hpow, hΔ_cayley_full, Finset.sum_mul, map_sum]
      refine Finset.sum_congr rfl fun j hj => ?_
      have hj_le : j ≤ p := (Finset.mem_Icc.mp hj).2
      have hmul : iM₁'K₁ (e_fn j) * Δ_val ^ (p - j) * Δ_val ^ (D - p) =
          iM₁'K₁ (e_fn j) * Δ_val ^ (D - j) := by
        rw [mul_assoc, ← pow_add, show (p - j) + (D - p) = D - j by omega]
      rw [hmul, htr_smul_M₁'K₁]
    have hNewton_id : ∀ D ∈ Finset.Icc 1 p,
        trM₁'K₁ (Δ_val ^ D) - ((D : ℕ) : R_M) * e_fn D =
          ∑ j ∈ Finset.Icc 1 (D - 1), e_fn j * trM₁'K₁ (Δ_val ^ (D - j)) := by
      intro D hD
      obtain ⟨hD1, hDp⟩ := Finset.mem_Icc.mp hD
      rcases Nat.eq_or_lt_of_le hDp with hD_eq | hD_lt
      · rw [hD_eq]
        have htr_p : trM₁'K₁ (Δ_val ^ p) =
            ((p : ℕ) : R_M) * b +
              ∑ j ∈ Finset.Icc 1 (p - 1), e_fn j * trM₁'K₁ (Δ_val ^ (p - j)) := by
          rw [hΔ_cayley_split, map_add, htr_incl_M₁'K₁ b, map_sum]
          congr 1
          refine Finset.sum_congr rfl fun j _ => htr_smul_M₁'K₁ (e_fn j) (Δ_val ^ (p - j))
        have hep : e_fn p = b := by rw [he_fn_def, if_pos rfl]
        rw [htr_p, hep, add_sub_cancel_left]
      · have hD_mem : D ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hD1, by omega⟩
        have hnew := hs₁_newton1 Δ_val D hD_mem
        have he_D : ((D : ℕ) : R_M) * e_fn D =
            (-1 : R_M) ^ (D - 1) * ((D : ℕ) : R_M) * s₁ Δ_val D := by
          rw [he_fn_def, if_neg (Nat.ne_of_lt hD_lt), he_Δ_eq_s₁ D hD_mem]
          ring
        have hsum_eq :
            (∑ j ∈ Finset.Icc 1 (D - 1), e_fn j * trM₁'K₁ (Δ_val ^ (D - j))) =
            ∑ j ∈ Finset.Icc 1 (D - 1),
              (-1 : R_M) ^ (j - 1) * s₁ Δ_val j * trM₁'K₁ (Δ_val ^ (D - j)) := by
          refine Finset.sum_congr rfl fun j hj => ?_
          obtain ⟨hj1, hj2⟩ := Finset.mem_Icc.mp hj
          have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
          have hj_ne_p : j ≠ p := by omega
          rw [he_fn_def, if_neg hj_ne_p, he_Δ_eq_s₁ j hj_mem]
        rw [he_D, hsum_eq]
        linear_combination -hnew
    have hNewton : ∀ D ∈ Finset.Icc 1 p,
        trM₁'K₁ (Δ_val ^ D) - ((D : ℕ) : R_M) * e_fn D = 0 ∨
          2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) ≤
            vM₁' (trM₁'K₁ (Δ_val ^ D) - ((D : ℕ) : R_M) * e_fn D) := by
      intro D hD
      obtain ⟨hD1, hDp⟩ := Finset.mem_Icc.mp hD
      rw [hNewton_id D hD]
      apply hvalM₁'_sum_ge
      intro j hj
      obtain ⟨hj1, hjD⟩ := Finset.mem_Icc.mp hj
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      have hDj_mem : D - j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hmul := hvalM₁'_mul_ge
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (j : ℤ) * (t₁ : ℤ))
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((D - j : ℕ) : ℤ) * (t₁ : ℤ))
        (e_fn j) (trM₁'K₁ (Δ_val ^ (D - j)))
        (he_fn_val_low j hj_mem) (htr_Δ_val_low (D - j) hDj_mem)
      refine hvalM₁'_mono _ _ _ ?_ hmul
      have hDj : ((D - j : ℕ) : ℤ) = (D : ℤ) - (j : ℤ) := Nat.cast_sub (by omega : j ≤ D)
      rw [hDj]
      exact le_of_eq (by ring)

    have he_fn_val_all : ∀ j ∈ Finset.Icc 1 p,
        e_fn j = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (j : ℤ) * (t₁ : ℤ) ≤ vM₁' (e_fn j) := by
      intro j hj
      obtain ⟨hj1, hjp⟩ := Finset.mem_Icc.mp hj
      rcases Nat.eq_or_lt_of_le hjp with hj_eq | hj_lt
      · right
        have hep : e_fn p = b := by rw [he_fn_def, if_pos rfl]
        rw [hj_eq, hep, hb_val, hp_sub1_z]
        exact le_of_eq (by ring)
      · have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
        refine hvalM₁'_mono _ _ _ ?_ (he_fn_val_low j hj_mem)
        linarith only [hp1_t₁_le_t₂]
    have hrec_step_bound : ∀ D : ℕ, p ≤ D →
        (∀ d < D, trM₁'K₁ (Δ_val ^ d) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (d : ℤ) * (t₁ : ℤ) ≤
            vM₁' (trM₁'K₁ (Δ_val ^ d))) →
        trM₁'K₁ (Δ_val ^ D) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) +
            ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
              vM₁' (trM₁'K₁ (Δ_val ^ D)) := by
      intro D hD h_prev
      rw [htr_Δ_rec D hD]
      apply hvalM₁'_sum_ge
      intro j hj
      obtain ⟨hj1, hjp⟩ := Finset.mem_Icc.mp hj
      have hDj_lt : D - j < D := by omega
      have hmul := hvalM₁'_mul_ge
        (((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (j : ℤ) * (t₁ : ℤ))
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((D - j : ℕ) : ℤ) * (t₁ : ℤ))
        (e_fn j) (trM₁'K₁ (Δ_val ^ (D - j)))
        (he_fn_val_all j hj) (h_prev (D - j) hDj_lt)
      refine hvalM₁'_mono _ _ _ ?_ hmul
      have hDj : ((D - j : ℕ) : ℤ) = (D : ℤ) - (j : ℤ) := Nat.cast_sub (by omega : j ≤ D)
      rw [hDj]
      exact le_of_eq (by ring)
    have hClaimA : ∀ D : ℕ,
        trM₁'K₁ (Δ_val ^ D) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) ≤
            vM₁' (trM₁'K₁ (Δ_val ^ D)) := by
      intro D
      induction' D using Nat.strong_induction_on with D ih
      rcases eq_or_ne D 0 with rfl | hD_ne0
      · rw [pow_zero, htr_one_M₁'K₁, Nat.cast_zero, zero_mul, sub_zero]
        exact hp_valM₁' _ le_rfl
      · by_cases hD_lt : D < p
        · exact htr_Δ_val_low D (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
        · have hD_ge : p ≤ D := by omega
          refine hvalM₁'_mono _ _ _ ?_ (hrec_step_bound D hD_ge ih)
          have h : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) := by positivity
          linarith only [h]
    have hClaimB : ∀ D : ℕ, p ≤ D →
        trM₁'K₁ (Δ_val ^ D) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) +
            ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
              vM₁' (trM₁'K₁ (Δ_val ^ D)) :=
      fun D hD => hrec_step_bound D hD (fun d _ => hClaimA d)
    clear hs₁_cayley hs₁_newton1 he_Δ_eq_s₁ he_fn_val_low htr_Δ_val_low
      hΔ_cayley_split hΔ_cayley_full htr_Δ_rec hNewton_id he_fn_val_all hrec_step_bound

    
    let m₀ : ℤ := ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ)
    have hm₀_def : m₀ = ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := rfl
    clear_value m₀
    have hm₀_ge_t₂ : (t₂ : ℤ) ≤ m₀ := by
      have hmul : (p - 2) * t₁ ≤ (p - 2) * t₂ := Nat.mul_le_mul_left (p - 2) ht_le
      have hmul_z : (((p - 2) * t₁ : ℕ) : ℤ) ≤ (((p - 2) * t₂ : ℕ) : ℤ) := by exact_mod_cast hmul
      have hp12 : ((p - 1 : ℕ) : ℤ) = ((p - 2 : ℕ) : ℤ) + 1 := by omega
      push_cast at hmul_z
      rw [hm₀_def, hp12]
      linarith only [hmul_z]
    have hm₀_ge_t₁ : (t₁ : ℤ) ≤ m₀ := le_trans (by exact_mod_cast ht_le) hm₀_ge_t₂
    have hm₀_ge1 : (1 : ℤ) ≤ m₀ := le_trans (by exact_mod_cast ht₁_ge1) hm₀_ge_t₁
    have hm₀_nonneg : (0 : ℤ) ≤ m₀ := by linarith only [hm₀_ge1]
    have hm₀_le_p1t₂ : m₀ ≤ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
      have h : (0 : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by positivity
      linarith only [hm₀_def, h]
    have hpm₁_ge_m₀ : m₀ ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := le_trans hm₀_le_p1t₂ hpm₁_ge_p1t₂
    have hpm₀_ge_m₀ : m₀ ≤ (p : ℤ) * m₀ := by
      have h1 : (1 : ℤ) * m₀ ≤ (p : ℤ) * m₀ :=
        Int.mul_le_mul_of_nonneg_right (by omega : (1 : ℤ) ≤ (p : ℤ)) hm₀_nonneg
      linarith only [h1]
    have hpm₀_ge_3m₀ : (3 : ℤ) * m₀ ≤ (p : ℤ) * m₀ :=
      Int.mul_le_mul_of_nonneg_right (by omega : (3 : ℤ) ≤ (p : ℤ)) hm₀_nonneg

    have hfreshman_M₁' : ∀ x y : R_M,
        (x = 0 ∨ (0 : ℤ) ≤ vM₁' x) →
        (y = 0 ∨ (0 : ℤ) ≤ vM₁' y) →
        (x + y) ^ p - (x ^ p + y ^ p) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ vM₁' ((x + y) ^ p - (x ^ p + y ^ p)) := by
      intro x y hx hy
      have hbinom : (x + y) ^ p - (x ^ p + y ^ p) =
          ∑ r ∈ Finset.Icc 1 (p - 1), x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R_M) := by
        rw [hadd_pow_split1 x y]
        ring
      rw [hbinom]
      apply hvalM₁'_sum_ge
      intro r hr
      have hxr : x ^ r = 0 ∨ (0 : ℤ) ≤ vM₁' (x ^ r) := by
        have h := hvalM₁'_pow_ge x r 0 hx
        rwa [mul_zero] at h
      have hyr : y ^ (p - r) = 0 ∨ (0 : ℤ) ≤ vM₁' (y ^ (p - r)) := by
        have h := hvalM₁'_pow_ge y (p - r) 0 hy
        rwa [mul_zero] at h
      have hxy := hvalM₁'_mul_ge 0 0 (x ^ r) (y ^ (p - r)) hxr hyr
      rw [add_zero] at hxy
      have hxyz := hvalM₁'_mul_ge 0 (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
        (x ^ r * y ^ (p - r)) ((p.choose r : ℕ) : R_M) hxy (hchoose_valM₁' r hr)
      rwa [zero_add] at hxyz

    let S_p : Finset ℕ := (Finset.range p).erase 0
    have hS_p_def : S_p = (Finset.range p).erase 0 := rfl
    clear_value S_p
    let ξ : ℕ → R_M := fun m => iLM₁' (τ_val m)
    have hξ_def : ∀ m, ξ m = iLM₁' (τ_val m) := fun _ => rfl
    clear_value ξ
    let s₀_m : R_M := 1 + e_Δ (p - 1)
    have hs₀_m_def : s₀_m = 1 + e_Δ (p - 1) := rfl
    clear_value s₀_m
    let W_fn : ℕ → R_M := fun m => ξ m ^ p + ∑ i ∈ Finset.Icc 1 (p - 1), ξ m ^ (p - i) * e_Δ i
    have hW_fn_def : ∀ m, W_fn m = ξ m ^ p + ∑ i ∈ Finset.Icc 1 (p - 1), ξ m ^ (p - i) * e_Δ i :=
      fun _ => rfl
    clear_value W_fn
    let B_tilde : ℕ → R_M := fun m =>
      (ξ m ^ p - ξ m) + ∑ i ∈ Finset.Icc 1 (p - 2), ξ m ^ (p - i) * e_Δ i
    have hB_tilde_def : ∀ m, B_tilde m =
        (ξ m ^ p - ξ m) + ∑ i ∈ Finset.Icc 1 (p - 2), ξ m ^ (p - i) * e_Δ i := fun _ => rfl
    clear_value B_tilde
    let P_p : R_M := b ^ p +
      ∑ m ∈ S_p, nmM₁'K₁ (Δ_val + iM₁'K₁ (ξ m)) ^ p
    have hP_p_def : P_p = b ^ p +
        ∑ m ∈ S_p, nmM₁'K₁ (Δ_val + iM₁'K₁ (ξ m)) ^ p := rfl
    clear_value P_p

    have hs₀_m_int : s₀_m = 0 ∨ (0 : ℤ) ≤ vM₁' s₀_m := by
      have he_p1_int : e_Δ (p - 1) = 0 ∨ (0 : ℤ) ≤ vM₁' (e_Δ (p - 1)) := by
        have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hp1_ge1, le_rfl⟩
        refine hvalM₁'_mono 0 _ _ ?_ (he_Δ_val (p - 1) hp1_mem)
        linarith only [hp1_t₁_le_t₂]
      rw [hs₀_m_def]
      exact hvalM₁'_add 0 1 (e_Δ (p - 1)) (Or.inr (by rw [hvalM₁'_1])) he_p1_int
    have hs₀_m_pow_int : ∀ r : ℕ, s₀_m ^ r = 0 ∨ (0 : ℤ) ≤ vM₁' (s₀_m ^ r) := by
      intro r
      have h := hvalM₁'_pow_ge s₀_m r 0 hs₀_m_int
      rwa [mul_zero] at h

    have hξ_props : ∀ m ∈ S_p,
        (ξ m = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m)) ∧
        (∀ k : ℕ, ξ m ^ k = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m ^ k)) ∧
        (ξ m ^ p - ξ m = 0 ∨ m₀ ≤ vM₁' (ξ m ^ p - ξ m)) ∧
        nmM₁'K₁ (Δ_val + iM₁'K₁ (ξ m)) = W_fn m + b ∧
        W_fn m = ξ m * s₀_m + B_tilde m ∧
        (B_tilde m = 0 ∨ m₀ ≤ vM₁' (B_tilde m)) ∧
        (W_fn m = 0 ∨ (0 : ℤ) ≤ vM₁' (W_fn m)) := by
      intro m hm
      rw [hS_p_def] at hm
      have hm_pos : 0 < m := Nat.pos_of_ne_zero (Finset.mem_erase.mp hm).1
      have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm).2
      have hξ_ne0 : ξ m ≠ 0 := by
        rw [hξ_def]
        exact (map_ne_zero_iff iLM₁' hiLM₁').mpr (hτ_ne0 m)
      have hmul_inv : ξ m * (ξ m)⁻¹ = 1 := mul_inv_cancel₀ hξ_ne0
      have hξ_int : ξ m = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m) := by
        right
        rw [hξ_def, hval_LM₁', hτ_val0 m hm_lt hm_pos, mul_zero]
      have hξ_pow_int : ∀ k : ℕ, ξ m ^ k = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m ^ k) := by
        intro k
        have h := hvalM₁'_pow_ge (ξ m) k 0 hξ_int
        rwa [mul_zero] at h
      have hξ_p_sub : ξ m ^ p - ξ m = 0 ∨ m₀ ≤ vM₁' (ξ m ^ p - ξ m) := by
        have hτ_m := hτ_p1 m hm_lt hm_pos
        have hξ_p1_val :
            iLM₁' ((τ_val m) ^ (p - 1) - 1) = 0 ∨
              m₀ ≤ vM₁' (iLM₁' ((τ_val m) ^ (p - 1) - 1)) := by
          rcases hτ_m with h0 | hge
          · left; rw [h0, map_zero]
          · right
            rw [hval_LM₁']
            have hmul_p : ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
                (p : ℤ) * vL ((τ_val m) ^ (p - 1) - 1) := by
              calc ((p * (3 * p * m₁ + 1) : ℕ) : ℤ)
                  = (p : ℤ) * ((3 * p * m₁ + 1 : ℕ) : ℤ) := by push_cast; ring
                _ ≤ (p : ℤ) * vL ((τ_val m) ^ (p - 1) - 1) :=
                  Int.mul_le_mul_of_nonneg_left hge (Nat.cast_nonneg p)
            exact le_trans hpm₁_ge_m₀ hmul_p
        have hξ_factor : ξ m ^ p - ξ m =
            ξ m * iLM₁' ((τ_val m) ^ (p - 1) - 1) := by
          have h1 : iLM₁' ((τ_val m) ^ (p - 1) - 1) = ξ m ^ (p - 1) - 1 := by
            rw [map_sub, map_pow, map_one, ← hξ_def]
          rw [h1, mul_sub, mul_one, ← pow_succ', ← hp_eq_p1_add1]
        rw [hξ_factor]
        have hmul := hvalM₁'_mul_ge 0 m₀ (ξ m)
          (iLM₁' ((τ_val m) ^ (p - 1) - 1))
          hξ_int hξ_p1_val
        rwa [zero_add] at hmul
      have hnorm_W : nmM₁'K₁ (Δ_val + iM₁'K₁ (ξ m)) = W_fn m + b := by
        have hfactor : Δ_val + iM₁'K₁ (ξ m) =
            iM₁'K₁ (ξ m) * (1 + iM₁'K₁ ((ξ m)⁻¹) * Δ_val) := by
          have h1 : iM₁'K₁ (ξ m) * iM₁'K₁ ((ξ m)⁻¹) = 1 := by
            rw [← map_mul, hmul_inv, map_one]
          calc Δ_val + iM₁'K₁ (ξ m)
              = iM₁'K₁ (ξ m) + 1 * Δ_val := by ring
            _ = iM₁'K₁ (ξ m) + (iM₁'K₁ (ξ m) * iM₁'K₁ ((ξ m)⁻¹)) * Δ_val := by rw [← h1]
            _ = iM₁'K₁ (ξ m) * (1 + iM₁'K₁ ((ξ m)⁻¹) * Δ_val) := by ring
        have hpow_cancel : ∀ i : ℕ, i ≤ p → ξ m ^ p * ((ξ m)⁻¹) ^ i = ξ m ^ (p - i) := by
          intro i hi
          calc ξ m ^ p * ((ξ m)⁻¹) ^ i
              = ξ m ^ ((p - i) + i) * ((ξ m)⁻¹) ^ i := by rw [Nat.sub_add_cancel hi]
            _ = ξ m ^ (p - i) * (ξ m ^ i * ((ξ m)⁻¹) ^ i) := by rw [pow_add, mul_assoc]
            _ = ξ m ^ (p - i) * (ξ m * (ξ m)⁻¹) ^ i := by rw [← mul_pow]
            _ = ξ m ^ (p - i) := by rw [hmul_inv, one_pow, mul_one]
        rw [hfactor, nmM₁'K₁.map_mul, hnorm_incl_M₁'K₁ (ξ m), he_Δ_poly ((ξ m)⁻¹), ← hb_def]
        have hsum_cancel :
            ξ m ^ p * (∑ i ∈ Finset.Icc 1 (p - 1), ((ξ m)⁻¹) ^ i * e_Δ i) =
              ∑ i ∈ Finset.Icc 1 (p - 1), ξ m ^ (p - i) * e_Δ i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_le : i ≤ p := (hIcc_1_p1_idx i hi).1
          rw [← mul_assoc, hpow_cancel i hi_le]
        have htop_cancel : ξ m ^ p * (((ξ m)⁻¹) ^ p * b) = b := by
          rw [← mul_assoc, hpow_cancel p le_rfl, Nat.sub_self, pow_zero, one_mul]
        rw [mul_add, mul_add, mul_one, hsum_cancel, htop_cancel, hW_fn_def]
      have hW_split : W_fn m = ξ m * s₀_m + B_tilde m := by
        rw [hW_fn_def, hB_tilde_def, hs₀_m_def,
          hIcc_split_top (fun i => ξ m ^ (p - i) * e_Δ i), hp_sub_p1, pow_one]
        ring
      have hB_tilde_val : B_tilde m = 0 ∨ m₀ ≤ vM₁' (B_tilde m) := by
        rw [hB_tilde_def]
        refine hvalM₁'_add m₀ _ _ hξ_p_sub ?_
        apply hvalM₁'_sum_ge
        intro i hi
        obtain ⟨hi_mem, _, _, hi_mul⟩ := hIcc_1_p2_idx i hi
        have hmul := hvalM₁'_mul_ge 0
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ))
          (ξ m ^ (p - i)) (e_Δ i) (hξ_pow_int (p - i)) (he_Δ_val i hi_mem)
        refine hvalM₁'_mono m₀ _ _ ?_ hmul
        linarith only [hm₀_def, hi_mul]
      have hW_int : W_fn m = 0 ∨ (0 : ℤ) ≤ vM₁' (W_fn m) := by
        rw [hW_split]
        have h1 := hvalM₁'_mul_ge 0 0 (ξ m) s₀_m hξ_int hs₀_m_int
        rw [add_zero] at h1
        have h2 := hvalM₁'_mono 0 m₀ (B_tilde m) hm₀_nonneg hB_tilde_val
        exact hvalM₁'_add 0 _ _ h1 h2
      exact ⟨hξ_int, hξ_pow_int, hξ_p_sub, hnorm_W, hW_split, hB_tilde_val, hW_int⟩

    let C_Δ : R_M := ((p : ℕ) : R_M) * b ^ (p - 1) * s₀_m + s₀_m ^ p
    have hC_Δ_def : C_Δ = ((p : ℕ) : R_M) * b ^ (p - 1) * s₀_m + s₀_m ^ p := rfl
    clear_value C_Δ
    have hC_Δ_int : C_Δ = 0 ∨ (0 : ℤ) ≤ vM₁' C_Δ := by
      rw [hC_Δ_def]
      have hpb := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) (-((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
        ((p : ℕ) : R_M) (b ^ (p - 1)) (hp_valM₁' _ le_rfl) (hb_pow_val (p - 1))
      have hpbs := hvalM₁'_mul_ge
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + (-((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))) 0
        (((p : ℕ) : R_M) * b ^ (p - 1)) s₀_m hpb hs₀_m_int
      have hpbs_int : ((p : ℕ) : R_M) * b ^ (p - 1) * s₀_m = 0 ∨
          (0 : ℤ) ≤ vM₁' (((p : ℕ) : R_M) * b ^ (p - 1) * s₀_m) := by
        refine hvalM₁'_mono 0 _ _ ?_ hpbs
        linarith only [hp1_t₁_le_t₂]
      exact hvalM₁'_add 0 _ _ hpbs_int (hs₀_m_pow_int p)

    have hWm_term_bound : ∀ m ∈ S_p,
        (W_fn m + b) ^ p - b ^ p - C_Δ * ξ m = 0 ∨
          m₀ ≤ vM₁' ((W_fn m + b) ^ p - b ^ p - C_Δ * ξ m) := by
      intro m hm
