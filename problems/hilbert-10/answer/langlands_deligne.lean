  have ht₁_mod_pos : 1 ≤ t₁ % p := by
    by_contra h0
    have h0' : t₁ % p = 0 := by omega
    exact ht₁_ndvd (Nat.dvd_of_mod_eq_zero h0')
  have hdiv_t₁ : p * h₀ + t₁ % p = t₁ := Nat.div_add_mod t₁ p
  have h3h₀_le_ph₀ : 3 * h₀ ≤ p * h₀ := Nat.mul_le_mul_right h₀ hp_ge3
  have hd₂_ge1 : 1 ≤ d₂ := by omega
  have hd₂_le_bE' : (d₂ : ℤ) ≤ (bE' : ℤ) := by omega
  have h_ph₀_bE' : (p : ℤ) * (h₀ : ℤ) + 2 ≤ (bE' : ℤ) := by
