    have hA_ge2_val : A_ge2 = 0 ∨ m₀ ≤ vK₁ A_ge2 := by
      rw [hA_ge2_def]
      apply hvalK₁_sum_ge
      intro i hi
      obtain ⟨hi_mem, _, hpi, hi_le_p2⟩ := hIcc_1_p2_idx i hi
      have hincl_i :
          (-1 : R_K) ^ i * iM₁'K₁ (e_Δ i) = 0 ∨
            (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ)) ≤
              vK₁ ((-1 : R_K) ^ i * iM₁'K₁ (e_Δ i)) := by
        rcases he_Δ_val i hi_mem with h0 | hge
        · left; rw [h0, map_zero, mul_zero]
        · right
          rw [hvalK₁_neg1_pow_mul, hval_M₁'K₁]
          exact Int.mul_le_mul_of_nonneg_left hge (Nat.cast_nonneg p)
      have hΔ_pow_i : Δ_val ^ (p - i) = 0 ∨
          -((p - i : ℕ) : ℤ) * (t₁ : ℤ) ≤ vK₁ (Δ_val ^ (p - i)) := by
        have h := hvalK₁_pow_ge Δ_val (p - i) (-(t₁ : ℤ)) (Or.inr (by rw [hΔ_val']))
        have heq : ((p - i : ℕ) : ℤ) * (-(t₁ : ℤ)) = -((p - i : ℕ) : ℤ) * (t₁ : ℤ) := by ring
        rwa [heq] at h
      have hmul := hvalK₁_mul_ge
        ((p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ)))
        (-((p - i : ℕ) : ℤ) * (t₁ : ℤ))
        ((-1 : R_K) ^ i * iM₁'K₁ (e_Δ i)) (Δ_val ^ (p - i))
        hincl_i hΔ_pow_i
      refine hvalK₁_mono m₀ _ _ ?_ hmul
      have h_val_ge_pm₀ :
          (p : ℤ) * m₀ - 2 * (t₁ : ℤ) ≤
            (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ)) +
              (-((p - i : ℕ) : ℤ) * (t₁ : ℤ)) := by
        have hp1_nonneg : (0 : ℤ) ≤ (p : ℤ) - 1 := by linarith only [hp_pos_z]
        have hdiff_i :
            (0 : ℤ) ≤ ((p : ℤ) - 1) * (((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) - (i : ℤ) * (t₁ : ℤ)) :=
          mul_nonneg hp1_nonneg (by linarith only [hi_le_p2])
        have hid :
            (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ)) +
              (-(((p : ℤ) - (i : ℤ)) * (t₁ : ℤ))) - ((p : ℤ) * m₀ - 2 * (t₁ : ℤ)) =
            ((p : ℤ) - 1) * (((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) - (i : ℤ) * (t₁ : ℤ)) := by
