      exact h3
    clear ht₁_def ht₂_def hm₁_def hbE'_ge2 hbM₁'_ge2 hb_le

    have hIcc_1_p2_idx : ∀ i ∈ Finset.Icc 1 (p - 2),
        i ∈ Finset.Icc 1 (p - 1) ∧ i ≤ p ∧ ((p - i : ℕ) : ℤ) = (p : ℤ) - (i : ℤ) ∧
          (i : ℤ) * (t₁ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by
      intro i hi
      obtain ⟨hi1, hi2⟩ := Finset.mem_Icc.mp hi
      refine ⟨Finset.mem_Icc.mpr ⟨hi1, by omega⟩, by omega, Nat.cast_sub (by omega : i ≤ p), ?_⟩
      exact_mod_cast Nat.mul_le_mul_right t₁ hi2
    have hIcc_2_p1_idx : ∀ r ∈ Finset.Icc 2 (p - 1),
