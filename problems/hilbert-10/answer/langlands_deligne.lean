      push_cast
      ring
  have hval_zpow_L : ∀ (u : Lˣ) (m : ℤ),
      valL F L ((u ^ m : Lˣ) : L) = m * valL F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F L ((u ^ (n : ℤ) : Lˣ) : L) = (n : ℤ) * valL F L (u : L)
      rw [zpow_natCast, Units.val_pow_eq_pow_val]
      exact hval_pow_L (u : L) n (Units.ne_zero u)
    | negSucc n =>
      rw [zpow_negSucc, hvalL.2.2.2.2.2.1 (u ^ (n + 1)), Units.val_pow_eq_pow_val,
        hval_pow_L (u : L) (n + 1) (Units.ne_zero u), Int.negSucc_eq]
      push_cast
      ring
  obtain ⟨ϖ_L, hϖL⟩ := hvalL.2.2.2.2.2.2.1 1
  have hνM₁'_triv0 : ∀ v ∈ unitGroup F L 0, νM₁' v = 1 := by
    have h0 := hνM₁'_cond 1 hPrime.one_lt
    simpa [pow_one, hUnramM₁'] using h0
  have hνM₁'_zpow : ∀ x : Lˣ, νM₁' x = (νM₁' ϖ_L) ^ (valL F L (x : L)) := by
    intro x
    let m : ℤ := valL F L (x : L)
    let u : Lˣ := x * (ϖ_L ^ m)⁻¹
    have hu_val0 : valL F L (u : L) = 0 := by
      change valL F L ((x : L) * (((ϖ_L ^ m)⁻¹ : Lˣ) : L)) = 0
      rw [hvalL.2.2.2.2.1 (x : L) (((ϖ_L ^ m)⁻¹ : Lˣ) : L) (Units.ne_zero x) (Units.ne_zero _),
        hvalL.2.2.2.2.2.1 (ϖ_L ^ m), hval_zpow_L ϖ_L m, hϖL]
      change m + -(m * 1) = 0
      ring
    have hu_mem0 : u ∈ unitGroup F L 0 := (hvalL.2.2.2.2.2.2.2.2.1 u).mpr hu_val0
    have hu_one : νM₁' u = 1 := hνM₁'_triv0 u hu_mem0
    have hx_eq : x = u * ϖ_L ^ m := (inv_mul_cancel_right x (ϖ_L ^ m)).symm
    conv_lhs => rw [hx_eq]
    rw [map_mul, map_zpow, hu_one, one_mul]
  have hνM₁'_ϖL_ne1 : νM₁' ϖ_L ≠ 1 := by
    intro h1
    apply hνM₁'_ne
    apply MonoidHom.ext
    intro x
    rw [MonoidHom.one_apply, hνM₁'_zpow x, h1, one_zpow]
  have hνM₁'_sq : νM₁' ^ 2 = 1 := hdeg2 ▸ hνM₁'_pow
  have hνM₁'_ϖL_sq : ((νM₁' ϖ_L : (Ω F)ˣ) : Ω F) ^ 2 = 1 := by
    rw [← Units.val_pow_eq_pow_val, ← MonoidHom.pow_apply, hνM₁'_sq,
      MonoidHom.one_apply, Units.val_one]
  have hνM₁'_ϖL_val : (νM₁' ϖ_L : Ω F) = -1 := by
    rcases sq_eq_one_iff.mp hνM₁'_ϖL_sq with h1 | hneg1
    · exact False.elim (hνM₁'_ϖL_ne1 (Units.ext h1))
    · exact hneg1
  have hνM₁'_val : ∀ x : Lˣ, (νM₁' x : Ω F) = (-1 : Ω F) ^ (valL F L (x : L)) := by
    intro x
    rw [hνM₁'_zpow x, Units.val_zpow_eq_zpow_val, hνM₁'_ϖL_val]
  have heps_νM₁'_fn : ∀ c : Lˣ, valL F L (c : L) = (T : ℤ) + condExpChar F L ψ →
      tateEps F L νM₁' ψ =
        (qL F L : Ω F) ^ (condExpChar F L ψ) * (-1 : Ω F) ^ T * (νM₁' c : Ω F) := by
    intro c hc_val_eq
    have htate_val : valL F L ((tateElt F L νM₁' ψ : Lˣ) : L) = condExpChar F L ψ := by
      have h := (ld_condExp_and_condExpChar_spec F L ψ hψ νM₁').2.2.2
      rw [hUnramM₁', Nat.cast_zero, zero_add] at h
      exact h
    unfold tateEps
    rw [if_pos hUnramM₁', hνM₁'_val (tateElt F L νM₁' ψ), htate_val,
      hνM₁'_val c, hc_val_eq,
      zpow_add₀ (neg_ne_zero.mpr one_ne_zero) (T : ℤ) (condExpChar F L ψ),
      zpow_natCast (-1 : Ω F) T]
    have hneg1_sq : (-1 : Ω F) ^ T * (-1 : Ω F) ^ T = 1 := by
      rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
    calc (qL F L : Ω F) ^ (condExpChar F L ψ) * (-1 : Ω F) ^ (condExpChar F L ψ)
      _ = (qL F L : Ω F) ^ (condExpChar F L ψ) * ((-1 : Ω F) ^ T * (-1 : Ω F) ^ T) *
            (-1 : Ω F) ^ (condExpChar F L ψ) := by rw [hneg1_sq, mul_one]
      _ = (qL F L : Ω F) ^ (condExpChar F L ψ) * (-1 : Ω F) ^ T *
            ((-1 : Ω F) ^ T * (-1 : Ω F) ^ (condExpChar F L ψ)) := by ring
  let c : L := - normLM F hLM₁' d
  have hd_not1 : ¬ (d = 0 ∨ 1 ≤ valL F M₁' d) := by
    intro h1
    have htr1 := htr_bound_LM₁' 1 d h1
    rw [hd_tr, hvalL.2.1] at htr1
    rcases htr1 with h10 | h1le0
    · exact one_ne_zero h10
    · omega
  have hd_val : valL F M₁' d = 0 := by
    rcases hd_int with rfl | hd0
    · exact False.elim (hd_not1 (Or.inl rfl))
    · have hnot : ¬ (1 ≤ valL F M₁' d) := fun h => hd_not1 (Or.inr h)
      omega
  have hc_val : valL F L c = 0 := by
    dsimp [c]
    rw [hvalL.2.2.2.1, hval_norm_LM₁' d, hd_val, mul_zero]
  have hd_norm : normLM F hLM₁' d = -c := (neg_neg (normLM F hLM₁' d)).symm
  have hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c := by
    have h1 : d + σ_U d = 1 := by rw [← hσ_U_tr d, hd_tr, map_one]
    have h2 : d * σ_U d = - IntermediateField.inclusion hLM₁' c := by
      rw [← hσ_U_norm d, hd_norm, map_neg]
    linear_combination d * h1 - h2
  exact ⟨hdeg2, hT_le, hmE'_eq, hnM₁'_eq, hnE'_eq, hnK₁_eq, hqM₁', hqE',
    hξM₁'_pow, hξM₁'_ne, hξM₁'_cond_eq, hξE'_cond_eq,
    heps_M₁'_1, heps_E'_1, hνM₁'_val, heps_νM₁'_fn,
    hval_LM₁', hval_norm_LM₁', hval_LE', hval_norm_LE',
    hval_E'K₁, hval_norm_E'K₁, hval_M₁'K₁, hval_norm_M₁'K₁,
    htr_bound_LM₁', htr_bound_LE', htr_bound_E'K₁, htr_bound_M₁'K₁,
    hDiamond_E', hDiamond_M₁',
    ⟨d, c, σ_U, σ_E, hd_val, hc_val, hd_tr, hd_norm, hd_sq,
     hσ_U_L, hσ_U_val, hσ_U_tr, hσ_U_norm, hσ_U_twist,
     hσ_E_L, hσ_E_val, hσ_E_tr, hσ_E_norm, hσ_E_twist⟩⟩

theorem ld_ch12_wild_dyadic_unramified_frob_proj_and_norm_approx (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = 2 * valL F M₁' z)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (d : M₁') (c : L) (σ_U : M₁' ≃ₐ[F] M₁')
    (hd_val : valL F M₁' d = 0)
    (hd_tr : traceLM F hLM₁' d = 1)
    (hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c)
    (hσ_U_L : ∀ x : L,
      σ_U (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ_U_val : ∀ z : M₁', valL F M₁' (σ_U z) = valL F M₁' z)
    (hσ_U_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + σ_U z)
    (hσ_U_twist : ∀ z : M₁'ˣ,
      θM₁' (Units.map σ_U.toRingEquiv.toMonoidHom z) =
        (νE'.comp (Units.map (normLM F hLM₁'))) z * θM₁' z)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hu₁_pow : ∀ u₁ : Lˣ, νE' u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ,
      ξ ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1 →
      ∃ k < Module.finrank L (IntermediateField.extendScalars hLE'), (νE' u₁) ^ k = ξ)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (c_ν₀ : Lˣ)
    (hc_ν₀_val : valL F L (c_ν₀ : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν₀_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν₀⁻¹ : Lˣ) : L) * u))
    (c_U : M₁'ˣ)
    (hc_U_val : valL F M₁' (c_U : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc_U_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((c_U⁻¹ : M₁'ˣ) : M₁') * z)) :
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let h := mM₁' - T
    ∃ (c_ν : Lˣ) (x : E'),
      let A := normLM F hLE' x
      let U₁ := IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')
      valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ ∧
      (∀ u : L, (u = 0 ∨ (((T + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
        ∀ hu : 1 + u ≠ 0,
          (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u)) ∧
      (U₁ - (IntermediateField.inclusion hLM₁' A + d ^ 2) = 0 ∨
        (T : ℤ) - (((mM₁' + 1) / 2 : ℕ) : ℤ) ≤
          valL F M₁' (U₁ - (IntermediateField.inclusion hLM₁' A + d ^ 2))) ∧
      (h = 0 → (x = 0 ∨ 0 ≤ valL F E' x)) ∧
      (0 < h → x ≠ 0 ∧ valL F E' x = -(h : ℤ) ∧ valL F L A = -(h : ℤ)) :=
by
  
  set T := condExp F L νE'
  set mM₁' := condExp F M₁' θM₁'
  set h := mM₁' - T
  set r_T := (T + 1) / 2
  set d_T := T / 2
  set r_U := (mM₁' + 1) / 2
  set n := condExpChar F L ψ
  set ψM₁' := traceChar F hLM₁' ψ
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    _, hval_add_L, hunit0_iff_L, hunit_pos_iff_L, hunit_val0_L⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_E', hval1_E', _, _, _, _, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  obtain ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
    _, hval_add_M₁', _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M₁'
  have hr_T_ge1 : 1 ≤ r_T := by omega
  have hd_T_ge1 : 1 ≤ d_T := by omega
  have hr_U_ge1 : 1 ≤ r_U := by omega
  have hr_T_le_r_U : r_T ≤ r_U := by omega
  have hT_le_2r_U : T ≤ 2 * r_U := by omega
  have hT_le_dT_add_rU : T ≤ d_T + r_U := by omega
  have hh_lt_TrU : -(h : ℤ) + 1 ≤ (T : ℤ) - (r_U : ℤ) := by omega
  have hT_sub1_ge1 : 1 ≤ T - 1 := by omega
  have hT_le_T1_add_rT : (T : ℤ) ≤ ((T - 1 : ℕ) : ℤ) + (r_T : ℤ) := by omega
  have hTrU_le_T1 : (T : ℤ) - (r_U : ℤ) ≤ ((T - 1 : ℕ) : ℤ) := by omega
  have hmono_val_L : ∀ {k₁ k₂ : ℤ} {x : L}, k₁ ≤ k₂ →
      (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hmul_val_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hkx : k₁ ≤ valL F L x := hx.resolve_left hx0
        have hky : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hmono_val_M₁' : ∀ {k₁ k₂ : ℤ} {x : M₁'}, k₁ ≤ k₂ →
      (x = 0 ∨ k₂ ≤ valL F M₁' x) → (x = 0 ∨ k₁ ≤ valL F M₁' x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hmul_val_ge_M₁' : ∀ (k₁ k₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hkx : k₁ ≤ valL F M₁' x := hx.resolve_left hx0
        have hky : k₂ ≤ valL F M₁' y := hy.resolve_left hy0
        rw [hval_mul_M₁' x y hx0 hy0]
        omega
  have hmul_int_M₁' : ∀ (k : ℤ) (x y : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ 0 ≤ valL F M₁' y) →
      (x * y = 0 ∨ k ≤ valL F M₁' (x * y)) := by
    intro k x y hx hy
    simpa only [add_zero] using hmul_val_ge_M₁' k 0 x y hx hy
  have hsub_val_ge_M₁' : ∀ (k : ℤ) (x y : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
      (x - y = 0 ∨ k ≤ valL F M₁' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hval_add_M₁' k x (-y) hx
    rcases hy with rfl | hy
    · left; exact neg_zero
    · right; rwa [hval_neg_M₁']
  have htr_smul : ∀ (a : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a * z) = a * traceLM F hLM₁' z := by
    intro a z
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' a
      (toExtendScalars F hLM₁' z)
  have hincl_inj : Function.Injective (IntermediateField.inclusion hLM₁') :=
    (IntermediateField.inclusion hLM₁').injective
  have hincl_eq_zero : ∀ a : L, IntermediateField.inclusion hLM₁' a = 0 ↔ a = 0 :=
    fun a => map_eq_zero_iff (IntermediateField.inclusion hLM₁') hincl_inj
  have hdegM₁'_2 : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    hdegM₁'.trans hdeg2
  have hnorm_M₁'_0 : normLM F hLM₁' 0 = 0 := by
    have h1 := ((hQuadNorm L M₁' hLM₁' hdegM₁'_2).2 1 0).1
    rw [map_one, add_zero, map_one, map_zero] at h1
    linear_combination -h1
  have hnorm_E'_0 : normLM F hLE' 0 = 0 := by
    have h1 := ((hQuadNorm L E' hLE' hdeg2).2 1 0).1
    rw [map_one, add_zero, map_one, map_zero] at h1
    linear_combination -h1
  
  have hcondChar_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψM : AddChar M (Ω F)), IsAdmissibleChar F M ψM →
      (∀ x : M, (x = 0 ∨ -condExpChar F M ψM ≤ valL F M x) → ψM x = 1) ∧
      (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψM + 1) ≤ valL F M x₁ ∧ ψM x₁ ≠ 1) := by
    intro M _ ψM hψM
    set S : Set ℤ := {k : ℤ | ∀ x : M, -k ≤ valL F M x → ψM x = 1}
    have hne : S.Nonempty := by
      rcases hψM.2 with ⟨d₀, hd₀⟩
      refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
      omega
    have hbdd : BddAbove S := by
      have hne1 : ψM ≠ 1 := hψM.1
      rw [DFunLike.ne_iff] at hne1
      rcases hne1 with ⟨x₀, hx₀⟩
      rw [AddChar.one_apply] at hx₀
      refine ⟨-valL F M x₀ - 1, fun k hk => ?_⟩
      by_contra hlt
      have hge : -k ≤ valL F M x₀ := by omega
      exact hx₀ (hk x₀ hge)
    have hmem : condExpChar F M ψM ∈ S := Int.csSup_mem hne hbdd
    have htriv : ∀ x : M, (x = 0 ∨ -condExpChar F M ψM ≤ valL F M x) → ψM x = 1 := by
      intro x hx
      rcases hx with rfl | hx
      · exact AddChar.map_zero_eq_one ψM
      · exact hmem x hx
    have hnot : condExpChar F M ψM + 1 ∉ S :=
      notMem_of_csSup_lt (lt_add_one (condExpChar F M ψM)) hbdd
    change ¬ (∀ x : M, -(condExpChar F M ψM + 1) ≤ valL F M x → ψM x = 1) at hnot
    push_neg at hnot
    rcases hnot with ⟨x₁, hx₁_val, hx₁_ne⟩
    have hx₁_ne0 : x₁ ≠ 0 := by
      rintro rfl
      exact hx₁_ne (AddChar.map_zero_eq_one ψM)
