    have hshift_val : π_d ^ 2 * (sig2 - s₂M) = 0 ∨
        (2 * d + 1 : ℤ) ≤ valL F M_C (π_d ^ 2 * (sig2 - s₂M)) := by
      have h := hvalMC_mul_ge (d + d) 1 (π_d ^ 2) (sig2 - s₂M) hπ_d2 hdiff_val1
      rcases h with h0 | hge
      · exact Or.inl h0
      · right; omega
    have hcomb := hvalM_add (2 * d + 1)
      ((∏ σ : G, (1 + π_d * z σ)) - (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * sig2))
      (π_d ^ 2 * (sig2 - s₂M)) hsig2_rem hshift_val
    have hcomb_ring :
        ((∏ σ : G, (1 + π_d * z σ)) - (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * sig2)) +
          π_d ^ 2 * (sig2 - s₂M) =
        (∏ σ : G, (1 + π_d * z σ)) - (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * s₂M) := by
      ring
    rw [hcomb_ring] at hcomb
    have hact_lin : ∀ σ : G, act σ (1 + π_d * y) = 1 + π_d * z σ := by
      intro σ
      rw [((hact_ring σ).2.2 1 (π_d * y)).1, (hact_ring σ).2.1,
        ((hact_ring σ).2.2 π_d y).2.1, hact_incl σ π_dL]
    have hϖ_2d : (((ϖ ^ (2 * d) : Lˣ) : L)) = π_dL ^ 2 := by
      change (((ϖ ^ (2 * d) : Lˣ) : L)) = (((ϖ ^ d : Lˣ) : L)) ^ 2
      rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
      ring
    have hincl_rem : IntermediateField.inclusion hLM_C
        (normLM F hLM_C (1 + π_d * y) -
          (1 + π_dL * traceLM F hLM_C y + (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂)) =
        (∏ σ : G, (1 + π_d * z σ)) -
          (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * s₂M) := by
      rw [hϖ_2d, map_sub, hact_norm (1 + π_d * y), map_add, map_add, map_one,
        map_mul, map_mul, map_pow, hact_trace y]
      simp_rw [hact_lin]
      rfl
    rw [← hincl_rem] at hcomb
    rcases hcomb with h0 | hge
    · left
      exact (map_eq_zero_iff (IntermediateField.inclusion hLM_C)
        (IntermediateField.inclusion hLM_C).injective).mp h0
    · right
      rwa [hval_alg_MC] at hge
  refine ⟨hNotDvd, hν_triv_L, fun z hz => (htr_norm_and_Fz z hz).1,
    fun z hz => (htr_norm_and_Fz z hz).2⟩

theorem ld_ch13_tame_cond_one_residue_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hr_mul : r * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (hcond_L : condExp F L χ' = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1)
    (hχ'MC_cond : ∀ u ∈ unitGroup F M_C (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C)))),
      (χ'.comp (Units.map (normLM F hLM_C))) u = 1)
    (hν_props : ∀ i : Fin r,
      (ν_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      ν_orb i ≠ 1 ∧
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)), ((ν_orb i) ^ k) u = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
          ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1))
    (hν_orb_sum : ∀ (ν₀ : M_Cˣ →* (Ω F)ˣ),
      ν₀ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 → ν₀ ≠ 1 →
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1) →
      ∀ z : M_Cˣ,
        1 + (∑ i : Fin r,
          ∑ c ∈ (Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
            (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
              (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1),
            (((ν_orb i) ^ c) z : Ω F)) =
          ∑ j ∈ Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK)),
            ((ν₀ ^ j) z : Ω F))
    (hν_cond1 : ∀ i : Fin r,
      condExp F M_C (ν_orb i) = 1 ∧
      (∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1))
    (hν_triv_L : ∀ (i : Fin r) (x : Lˣ),
      (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom x) = 1)
    (ϖ_L : Lˣ) (hϖ_L_val : valL F L (ϖ_L : L) = 1)
    (hval_alg_MC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x)
    (hcondChar_MC : condExpChar F M_C (traceChar F hLM_C ψ) = condExpChar F L ψ)
    (hcond_MC : condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ')
    (hval_alg_E : ∀ x : L, valL F E (IntermediateField.inclusion hLE x) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hResSurj_E : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨ 1 ≤ valL F E (y - IntermediateField.inclusion hLE x)))
    (hcondChar_E : condExpChar F E (traceChar F hLE ψ) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (hcond_E : condExp F E (χ'.comp (Units.map (normLM F hLE))) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) * (condExp F L χ' - 1) + 1)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] (resL : L → k_L) (resM : M_C → k_M)
    (hfinrank_res : Module.finrank k_L k_M =
      Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hNotDvd : ∀ d : ℕ, 1 ≤ d → d < Module.finrank L (IntermediateField.extendScalars hLM_C) →
      ¬ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) ∣ ((Fintype.card k_L) ^ d - 1)))
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
      resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
      resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
      resM (-z₁) = -resM z₁)
    (hresM_ker : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) → (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M_C z)))
    (hresM_surj : ∀ b : k_M, ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧ resM z = b)
    (hres_tr_norm_MC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      resL (traceLM F hLM_C z) = Algebra.trace k_L k_M (resM z) ∧
      resL (normLM F hLM_C z) = Algebra.norm k_L (resM z))
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (hSpec_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ),
        (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
        (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) ∧
        (condExp F M θ ≠ 0 →
          (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) ∧
          (∃ u₀ ∈ unitGroup F M (condExp F M θ - 1), θ u₀ ≠ 1)) ∧
        valL F M ((tateElt F M θ ψ_M : Mˣ) : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hGauss_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (χ_M : Mˣ →* (Ω F)ˣ), condExp F M χ_M = 1 →
      ∀ (k_R : Type u) [Field k_R] [Fintype k_R] (resR : M → k_R),
        resR 0 = 0 → resR 1 = 1 →
        (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
          resR (x₁ + x₂) = resR x₁ + resR x₂ ∧
          resR (x₁ * x₂) = resR x₁ * resR x₂ ∧
          resR (-x₁) = -resR x₁) →
        (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (resR x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) →
        (∀ a : k_R, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resR x = a) →
        ∀ (c_M : Mˣ), valL F M (c_M : M) = 1 + condExpChar F M ψ_M →
        ∀ (χ_tilde ψ_tilde : k_R → Ω F),
          χ_tilde 0 = 0 →
          (∀ u : Mˣ, valL F M (u : M) = 0 → χ_tilde (resR (u : M)) = (χ_M u : Ω F)⁻¹) →
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            ψ_tilde (resR x) = ψ_M (((c_M⁻¹ : Mˣ) : M) * x)) →
          tateEps F M χ_M ψ_M =
            (qL F M : Ω F) ^ condExpChar F M ψ_M * (χ_M c_M : Ω F) *
              (∑ a : k_R, χ_tilde a * ψ_tilde a))
    (hDH_orbit : ∀ (hNeChar : (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : k_L) ≠ 0)
      (ψ_k : AddChar k_L (Ω F)), ψ_k ≠ 1 →
      ∀ (χ_k : k_Lˣ →* (Ω F)ˣ) (μ_tilde : Fin r → (k_Mˣ →* (Ω F)ˣ)),
        (∀ i : Fin r,
          (μ_tilde i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
          μ_tilde i ≠ 1) →
        (∀ y : k_Mˣ,
          1 + (∑ i : Fin r,
            ∑ c ∈ (Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
              (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
                (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1),
              (((μ_tilde i) ^ c) y : Ω F)) =
            ∑ j ∈ Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK)),
              (((μ_tilde ⟨0, hr_pos⟩) ^ j) y : Ω F)) →
        (((χ_k (Units.mk0 (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : k_L) hNeChar))⁻¹) ^
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) : Ω F) *
          (∑ x : k_Lˣ,
            ((χ_k ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))) x : Ω F) * ψ_k (x : k_L)) *
          (∏ i : Fin r,
            (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) *
              ψ_k (Algebra.trace k_L k_M (y : k_M)))) =
        (∑ x : k_Lˣ, (χ_k x : Ω F) * ψ_k (x : k_L)) *
          (∏ i : Fin r,
            (∑ y : k_Mˣ, ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
              ψ_k (Algebra.trace k_L k_M (y : k_M))))) :
    tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
      tateEps F L 1 ψ *
      (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
    tateEps F E 1 (traceChar F hLE ψ) *
      tateEps F L χ' ψ *
      (∏ i : Fin r,
        tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
          (traceChar F hLM_C ψ)) :=
by
  classical
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
  obtain ⟨hval0_E, hval1_E, hval_neg1_E, hval_neg_E, hval_mul_E, hval_inv_E, _, hval_add_E,
    hunit0_E, hunit_ge1_E, hunit_val0_E⟩ := hval_all E
  obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC, _, hval_add_MC,
    hunit0_MC, hunit_ge1_MC, hunit_val0_MC⟩ := hval_all M_C
  set ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  set f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
  have hℓ_ge2 : 2 ≤ ℓ := hPrime_MCK.two_le
  have hℓ_pos : 0 < ℓ := hPrime_MCK.pos

  
  
  
  set n : ℤ := condExpChar F L ψ
  set c₁ : Lˣ := ϖ_L ^ ((1 : ℤ) + n)
  let valHomL : Lˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (valL F L (u : L))
      map_one' := by rw [Units.val_one, hval1_L]; rfl
      map_mul' := fun u v => by
        rw [Units.val_mul, hval_mul_L (u : L) (v : L) (Units.ne_zero u) (Units.ne_zero v),
          ofAdd_add] }
  have hc₁_val : valL F L (c₁ : L) = 1 + n := by
    have hz := congrArg Multiplicative.toAdd (map_zpow valHomL ϖ_L (1 + n))
    rw [toAdd_zpow] at hz
    change valL F L (c₁ : L) = (1 + n) • valL F L (ϖ_L : L) at hz
    rw [hz, hϖ_L_val, smul_eq_mul, mul_one]

  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, hχ'_spec, _⟩ := hSpec_all L ψ hψ χ'
  set s_L : k_L → L := fun a => (hresL_surj a).choose
  have hs_L_int : ∀ a : k_L, s_L a = 0 ∨ 0 ≤ valL F L (s_L a) :=
    fun a => (hresL_surj a).choose_spec.1
  have hs_L_res : ∀ a : k_L, resL (s_L a) = a :=
    fun a => (hresL_surj a).choose_spec.2
  have hs_L_ne : ∀ a : k_L, a ≠ 0 → s_L a ≠ 0 := by
    intro a ha h0
    apply ha
    rw [← hs_L_res a, h0, hresL_0]
  have hs_L_val0 : ∀ a : k_L, a ≠ 0 → valL F L (s_L a) = 0 := by
    intro a ha
    have hge0 : 0 ≤ valL F L (s_L a) := (hs_L_int a).resolve_left (hs_L_ne a ha)
    by_contra hne
    have hge1 : 1 ≤ valL F L (s_L a) := by omega
    have hres0 : resL (s_L a) = 0 := (hresL_ker (s_L a) (hs_L_int a)).mpr (Or.inr hge1)
    rw [hs_L_res a] at hres0
    exact ha hres0
  set ψ_tilde : k_L → Ω F := fun a => ψ (((c₁⁻¹ : Lˣ) : L) * s_L a)
  have hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x) := by
    intro x hx_int
    set a : k_L := resL x
    have hneg_s_int : -(s_L a) = 0 ∨ 0 ≤ valL F L (-(s_L a)) := by
      rcases hs_L_int a with hs0 | hsge
      · left; rw [hs0, neg_zero]
      · right; rw [hval_neg_L]; exact hsge
    set d : L := x - s_L a
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 x (-(s_L a)) hx_int hneg_s_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg, (hresL_ring x (-(s_L a)) hx_int hneg_s_int).1,
        (hresL_ring (s_L a) (s_L a) (hs_L_int a) (hs_L_int a)).2.2, hs_L_res a]
      exact add_neg_cancel a
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set w : L := ((c₁⁻¹ : Lˣ) : L) * d
    have hw_cond : w = 0 ∨ -n ≤ valL F L w := by
      by_cases hd0 : d = 0
      · left; dsimp only [w]; rw [hd0, mul_zero]
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        dsimp only [w]
        rw [hval_mul_L ((c₁⁻¹ : Lˣ) : L) d (Units.ne_zero c₁⁻¹) hd0,
          hval_inv_L c₁, hc₁_val]
        omega
    have hψ_w : ψ w = 1 := hψ_triv w hw_cond
    have hx_decomp : ((c₁⁻¹ : Lˣ) : L) * x = ((c₁⁻¹ : Lˣ) : L) * s_L a + w := by
      dsimp only [w, d]; ring
    rw [hx_decomp, ψ.map_add_eq_mul, hψ_w, mul_one]
  have hψ_zero : ψ_tilde 0 = 1 := by
    rw [← hresL_0, hψ_int 0 (Or.inl rfl), mul_zero, ψ.map_zero_eq_one]
  have hψ_add : ∀ a b : k_L, ψ_tilde (a + b) = ψ_tilde a * ψ_tilde b := by
    intro a b
    have hab_int : s_L a + s_L b = 0 ∨ 0 ≤ valL F L (s_L a + s_L b) :=
      hval_add_L 0 (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)
    have hab_res : resL (s_L a + s_L b) = a + b := by
      rw [(hresL_ring (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)).1, hs_L_res a, hs_L_res b]
    rw [← hab_res, hψ_int (s_L a + s_L b) hab_int, mul_add, ψ.map_add_eq_mul]
  let ψ_k : AddChar k_L (Ω F) :=
    { toFun := ψ_tilde
      map_zero_eq_one' := hψ_zero
      map_add_eq_mul' := hψ_add }
  have hψ_k_apply : ∀ a : k_L, ψ_k a = ψ_tilde a := fun _ => rfl
  have hψ_k_ne : ψ_k ≠ 1 := by
    intro hψ1
    set z₁ : L := (c₁ : L) * x₁
    have hz₁_val : 0 ≤ valL F L z₁ := by
      dsimp only [z₁]
      rw [hval_mul_L (c₁ : L) x₁ (Units.ne_zero c₁) hx₁_ne, hc₁_val]
      omega
    have hinv_c₁ : ((c₁⁻¹ : Lˣ) : L) * (c₁ : L) = 1 := by exact_mod_cast Units.inv_mul c₁
    have heval : ψ_k (resL z₁) = ψ x₁ := by
      rw [hψ_k_apply, hψ_int z₁ (Or.inr hz₁_val)]
      dsimp only [z₁]
      rw [← mul_assoc, hinv_c₁, one_mul]
    have h1 : ψ_k (resL z₁) = 1 := by rw [hψ1]; rfl
    exact hx₁_ψ (heval.symm.trans h1)

  set v_unit : k_Lˣ → Lˣ := fun a => Units.mk0 (s_L (a : k_L)) (hs_L_ne (a : k_L) (Units.ne_zero a))
  have hv_unit_val0 : ∀ a : k_Lˣ, valL F L ((v_unit a : Lˣ) : L) = 0 :=
    fun a => hs_L_val0 (a : k_L) (Units.ne_zero a)
  have hv_unit_int : ∀ a : k_Lˣ, ((v_unit a : Lˣ) : L) = 0 ∨ 0 ≤ valL F L ((v_unit a : Lˣ) : L) :=
    fun a => hs_L_int (a : k_L)
  have hv_unit_res : ∀ a : k_Lˣ, resL ((v_unit a : Lˣ) : L) = (a : k_L) :=
    fun a => hs_L_res (a : k_L)
  have hdesc_unit : ∀ (θ : Lˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F L 1, θ u = 1) →
      ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
        (θ (v_unit a))⁻¹ = (θ u)⁻¹ := by
    intro θ hθ1 u a hu_val hu_res
    have hu_int : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
    have hneg_v_int : -((v_unit a : Lˣ) : L) = 0 ∨ 0 ≤ valL F L (-((v_unit a : Lˣ) : L)) := by
      right; rw [hval_neg_L, hv_unit_val0 a]
    set d : L := (u : L) - ((v_unit a : Lˣ) : L)
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 (u : L) (-((v_unit a : Lˣ) : L)) hu_int hneg_v_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg,
        (hresL_ring (u : L) (-((v_unit a : Lˣ) : L)) hu_int hneg_v_int).1,
        (hresL_ring ((v_unit a : Lˣ) : L) ((v_unit a : Lˣ) : L) (hv_unit_int a) (hv_unit_int a)).2.2,
        hu_res, hv_unit_res a, add_neg_cancel]
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set h : Lˣ := (v_unit a)⁻¹ * u
    have hh_sub : (h : L) - 1 = (((v_unit a)⁻¹ : Lˣ) : L) * d := by
      have hinv : (((v_unit a)⁻¹ : Lˣ) : L) * ((v_unit a : Lˣ) : L) = 1 := by
        exact_mod_cast Units.inv_mul (v_unit a)
      calc (h : L) - 1 =
            (((v_unit a)⁻¹ : Lˣ) : L) * (u : L) - (((v_unit a)⁻¹ : Lˣ) : L) * ((v_unit a : Lˣ) : L) := by
            rw [Units.val_mul, hinv]
        _ = (((v_unit a)⁻¹ : Lˣ) : L) * d := by dsimp only [d]; ring
    have hh_mem : h ∈ unitGroup F L 1 := by
      rw [hunit_ge1_L 1 le_rfl h]
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul_L (((v_unit a)⁻¹ : Lˣ) : L) d (Units.ne_zero (v_unit a)⁻¹) hd0,
          hval_inv_L (v_unit a), hv_unit_val0 a]
        omega
    have hθ_h : θ h = 1 := hθ1 h hh_mem
    have hθ_u : θ u = θ (v_unit a) := by
      have huv : v_unit a * h = u := mul_inv_cancel_left (v_unit a) u
      rw [← huv, map_mul, hθ_h, mul_one]
    rw [hθ_u]
  let mkDescChar : ∀ (θ : Lˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F L 1, θ u = 1) → (k_Lˣ →* (Ω F)ˣ) :=
    fun θ hθ1 =>
      { toFun := fun a => (θ (v_unit a))⁻¹
        map_one' := by
          have h1 : (θ (v_unit 1))⁻¹ = (θ 1)⁻¹ :=
            hdesc_unit θ hθ1 1 1 (by rw [Units.val_one, hval1_L]) (by rw [Units.val_one, hresL_1, Units.val_one])
          rw [h1, map_one, inv_one]
        map_mul' := fun a b => by
          have hab_val : valL F L ((v_unit a * v_unit b : Lˣ) : L) = 0 := by
            rw [Units.val_mul,
              hval_mul_L ((v_unit a : Lˣ) : L) ((v_unit b : Lˣ) : L)
                (Units.ne_zero (v_unit a)) (Units.ne_zero (v_unit b)),
              hv_unit_val0 a, hv_unit_val0 b, add_zero]
          have hab_res : resL ((v_unit a * v_unit b : Lˣ) : L) = ((a * b : k_Lˣ) : k_L) := by
            rw [Units.val_mul,
              (hresL_ring ((v_unit a : Lˣ) : L) ((v_unit b : Lˣ) : L)
                (hv_unit_int a) (hv_unit_int b)).2.1,
              hv_unit_res a, hv_unit_res b, Units.val_mul]
          have hm := hdesc_unit θ hθ1 (v_unit a * v_unit b) (a * b) hab_val hab_res
          rw [hm, map_mul, mul_inv] }
  have hχ'_triv1 : ∀ u ∈ unitGroup F L 1, χ' u = 1 := by
    have hspec := hχ'_spec (by omega)
    simpa [hcond_L] using hspec.1
  let χ_k : k_Lˣ →* (Ω F)ˣ := mkDescChar χ' hχ'_triv1
  have hχ_k_unit : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
      χ_k a = (χ' u)⁻¹ := fun u a hu ha => hdesc_unit χ' hχ'_triv1 u a hu ha

  have hsum_units_kL : ∀ (θ_k : k_Lˣ →* (Ω F)ˣ),
      (∑ a : k_L, (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a) =
        ∑ x : k_Lˣ, (θ_k x : Ω F) * ψ_k (x : k_L) := by
    intro θ_k
    have herase :
        (∑ a : k_L, (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a) =
          ∑ a ∈ (Finset.univ : Finset k_L).erase 0,
            (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a := by
      exact (Finset.sum_erase Finset.univ (by simp)).symm
    rw [herase]
    refine (Finset.sum_bij (fun (x : k_Lˣ) _ => (x : k_L)) ?_ ?_ ?_ ?_).symm
    · intro x _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero x, Finset.mem_univ _⟩
    · intro x₁ _ x₂ _ h
      exact Units.ext h
    · intro a ha
      have ha_ne : a ≠ 0 := (Finset.mem_erase.mp ha).1
      exact ⟨Units.mk0 a ha_ne, Finset.mem_univ _, rfl⟩
    · intro x _
      rw [dif_neg (Units.ne_zero x), Units.mk0_val, hψ_k_apply]

  have htate_Lχ :
      tateEps F L χ' ψ =
        (qL F L : Ω F) ^ n * (χ' c₁ : Ω F) *
          (∑ x : k_Lˣ, (χ_k x : Ω F) * ψ_k (x : k_L)) := by
    set χ_tilde_L : k_L → Ω F := fun a =>
      if ha : a = 0 then 0 else (χ_k (Units.mk0 a ha) : Ω F)
    have hχ_zero : χ_tilde_L 0 = 0 := dif_pos rfl
    have hχ_unit : ∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde_L (resL (u : L)) = (χ' u : Ω F)⁻¹ := by
      intro u hu
      have hres_ne : resL (u : L) ≠ 0 := by
        intro h0
        rcases (hresL_ker (u : L) (Or.inr (by omega))).mp h0 with h1 | h2
        · exact Units.ne_zero u h1
        · omega
      dsimp only [χ_tilde_L]
      rw [dif_neg hres_ne, hχ_k_unit u (Units.mk0 (resL (u : L)) hres_ne) hu rfl,
        Units.val_inv_eq_inv_val]
    have hG := hGauss_all L ψ hψ χ' hcond_L k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      c₁ hc₁_val χ_tilde_L ψ_tilde hχ_zero hχ_unit hψ_int
    rw [hG, hsum_units_kL χ_k]

  have hcond_one_char : ∀ (M : IntermediateField F (AlgebraicClosure F)),
      condExp F M 1 = 0 := by
    intro M
    exact Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
  have htate_triv : ∀ (M : IntermediateField F (AlgebraicClosure F)) (ψ_M : AddChar M (Ω F)),
      tateEps F M 1 ψ_M = (qL F M : Ω F) ^ condExpChar F M ψ_M := by
    intro M ψ_M
    dsimp only [tateEps]
    rw [if_pos (hcond_one_char M), MonoidHom.one_apply, Units.val_one, mul_one]

  
  
  
  have hCondχ'E : condExp F E (χ'.comp (Units.map (normLM F hLE))) = 1 := by
    rw [hcond_E, hcond_L]; omega
  let resE : E → k_L := fun y =>
    if hy : y = 0 ∨ 0 ≤ valL F E y then resL (hResSurj_E y hy).choose else 0
  have hinc_int_E : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (IntermediateField.inclusion hLE x = 0 ∨ 0 ≤ valL F E (IntermediateField.inclusion hLE x)) := by
    intro x hx
    rcases hx with rfl | hx_ge0
    · left; exact map_zero _
    · right; rw [hval_alg_E x]; exact mul_nonneg (by omega) hx_ge0
  have hinc_p1_E : ∀ x : L,
      (IntermediateField.inclusion hLE x = 0 ∨ 1 ≤ valL F E (IntermediateField.inclusion hLE x)) ↔
        (x = 0 ∨ 1 ≤ valL F L x) := by
    intro x
    constructor
    · intro h
      rcases h with h0 | hge1
      · left
        exact (IntermediateField.inclusion hLE).injective (h0.trans (map_zero _).symm)
      · right
        rw [hval_alg_E x] at hge1
        by_contra hlt
        have hle0 : valL F L x ≤ 0 := by omega
        have hmul_le0 : (ℓ : ℤ) * valL F L x ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
        omega
    · intro h
      rcases h with rfl | hge1
      · left; exact map_zero _
      · right
        rw [hval_alg_E x]
        calc (1 : ℤ) ≤ (ℓ : ℤ) * 1 := by omega
          _ ≤ (ℓ : ℤ) * valL F L x := mul_le_mul_of_nonneg_left hge1 (by omega)
  have hvalE_sub : ∀ (k : ℤ) (y₁ y₂ : E),
      (y₁ = 0 ∨ k ≤ valL F E y₁) → (y₂ = 0 ∨ k ≤ valL F E y₂) →
        (y₁ - y₂ = 0 ∨ k ≤ valL F E (y₁ - y₂)) := by
    intro k y₁ y₂ hy₁ hy₂
    have hneg₂ : -y₂ = 0 ∨ k ≤ valL F E (-y₂) := by
      rcases hy₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_E]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_E k y₁ (-y₂) hy₁ hneg₂
  have hvalL_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    have hneg₂ : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_L k x₁ (-x₂) hx₁ hneg₂
  have hresE_char : ∀ (y : E) (hy : y = 0 ∨ 0 ≤ valL F E y) (x : L)
      (hx : x = 0 ∨ 0 ≤ valL F L x),
      (y - IntermediateField.inclusion hLE x = 0 ∨
        1 ≤ valL F E (y - IntermediateField.inclusion hLE x)) →
      resE y = resL x := by
    intro y hy x hx hyx
    dsimp only [resE]
    rw [dif_pos hy]
    set x₀ : L := (hResSurj_E y hy).choose
    have hx₀_int : x₀ = 0 ∨ 0 ≤ valL F L x₀ := (hResSurj_E y hy).choose_spec.1
    have hyx₀ : y - IntermediateField.inclusion hLE x₀ = 0 ∨
        1 ≤ valL F E (y - IntermediateField.inclusion hLE x₀) := (hResSurj_E y hy).choose_spec.2
    have hinc_diff_eq :
        IntermediateField.inclusion hLE (x₀ - x) =
          (y - IntermediateField.inclusion hLE x) - (y - IntermediateField.inclusion hLE x₀) := by
      rw [map_sub]; ring
    have hinc_diff_p1 :
        IntermediateField.inclusion hLE (x₀ - x) = 0 ∨
          1 ≤ valL F E (IntermediateField.inclusion hLE (x₀ - x)) := by
      rw [hinc_diff_eq]
      exact hvalE_sub 1 _ _ hyx hyx₀
    have hdiff_p1 : x₀ - x = 0 ∨ 1 ≤ valL F L (x₀ - x) := (hinc_p1_E (x₀ - x)).mp hinc_diff_p1
    have hdiff_int : x₀ - x = 0 ∨ 0 ≤ valL F L (x₀ - x) := hvalL_sub 0 x₀ x hx₀_int hx
    have hres_diff : resL (x₀ - x) = 0 := (hresL_ker (x₀ - x) hdiff_int).mpr hdiff_p1
    have hneg_x_int : -x = 0 ∨ 0 ≤ valL F L (-x) := by
      rcases hx with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    have hres_sub : resL (x₀ - x) = resL x₀ - resL x := by
      rw [sub_eq_add_neg, (hresL_ring x₀ (-x) hx₀_int hneg_x_int).1,
        (hresL_ring x x hx hx).2.2, sub_eq_add_neg]
    exact sub_eq_zero.mp (hres_sub ▸ hres_diff)
  have hresE_inc : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resE (IntermediateField.inclusion hLE x) = resL x := by
    intro x hx
    exact hresE_char (IntermediateField.inclusion hLE x) (hinc_int_E x hx) x hx
      (Or.inl (sub_self _))
  have hresE_0 : resE 0 = 0 := by
    have h := hresE_inc 0 (Or.inl rfl)
    rwa [map_zero, hresL_0] at h
  have hresE_1 : resE 1 = 1 := by
    have h := hresE_inc 1 (Or.inr (by rw [hval1_L]))
    rwa [map_one, hresL_1] at h
  have hresE_surj : ∀ a : k_L, ∃ y : E, (y = 0 ∨ 0 ≤ valL F E y) ∧ resE y = a := by
    intro a
    exact ⟨IntermediateField.inclusion hLE (s_L a), hinc_int_E (s_L a) (hs_L_int a),
      (hresE_inc (s_L a) (hs_L_int a)).trans (hs_L_res a)⟩
  have hvalE_mul_int : ∀ (y₁ y₂ : E) (k₁ k₂ : ℤ),
      (y₁ = 0 ∨ k₁ ≤ valL F E y₁) → (y₂ = 0 ∨ k₂ ≤ valL F E y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F E (y₁ * y₂)) := by
    intro y₁ y₂ k₁ k₂ hy₁ hy₂
    by_cases hy₁0 : y₁ = 0
    · left; rw [hy₁0, zero_mul]
    · by_cases hy₂0 : y₂ = 0
      · left; rw [hy₂0, mul_zero]
      · right
        have h1 := hy₁.resolve_left hy₁0
        have h2 := hy₂.resolve_left hy₂0
        rw [hval_mul_E y₁ y₂ hy₁0 hy₂0]
        omega
  have hvalL_mul_int : ∀ (x₁ x₂ : L) (k₁ k₂ : ℤ),
      (x₁ = 0 ∨ k₁ ≤ valL F L x₁) → (x₂ = 0 ∨ k₂ ≤ valL F L x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ k₁ k₂ hx₁ hx₂
    by_cases hx₁0 : x₁ = 0
    · left; rw [hx₁0, zero_mul]
    · by_cases hx₂0 : x₂ = 0
      · left; rw [hx₂0, mul_zero]
      · right
        have h1 := hx₁.resolve_left hx₁0
        have h2 := hx₂.resolve_left hx₂0
        rw [hval_mul_L x₁ x₂ hx₁0 hx₂0]
        omega
  have hresE_ring : ∀ y₁ y₂ : E, (y₁ = 0 ∨ 0 ≤ valL F E y₁) → (y₂ = 0 ∨ 0 ≤ valL F E y₂) →
      resE (y₁ + y₂) = resE y₁ + resE y₂ ∧
      resE (y₁ * y₂) = resE y₁ * resE y₂ ∧
      resE (-y₁) = -resE y₁ := by
    intro y₁ y₂ hy₁ hy₂
    obtain ⟨x₁, hx₁_int, hy₁_x₁⟩ := hResSurj_E y₁ hy₁
    obtain ⟨x₂, hx₂_int, hy₂_x₂⟩ := hResSurj_E y₂ hy₂
    have hr₁ : resE y₁ = resL x₁ := hresE_char y₁ hy₁ x₁ hx₁_int hy₁_x₁
    have hr₂ : resE y₂ = resL x₂ := hresE_char y₂ hy₂ x₂ hx₂_int hy₂_x₂
    have hringL := hresL_ring x₁ x₂ hx₁_int hx₂_int
    refine ⟨?_, ?_, ?_⟩
    · have hy_add : y₁ + y₂ = 0 ∨ 0 ≤ valL F E (y₁ + y₂) := hval_add_E 0 y₁ y₂ hy₁ hy₂
      have hx_add : x₁ + x₂ = 0 ∨ 0 ≤ valL F L (x₁ + x₂) := hval_add_L 0 x₁ x₂ hx₁_int hx₂_int
      have hdiff_eq : (y₁ + y₂) - IntermediateField.inclusion hLE (x₁ + x₂) =
          (y₁ - IntermediateField.inclusion hLE x₁) + (y₂ - IntermediateField.inclusion hLE x₂) := by
        rw [map_add]; ring
      have hdiff_p1 : (y₁ + y₂) - IntermediateField.inclusion hLE (x₁ + x₂) = 0 ∨
          1 ≤ valL F E ((y₁ + y₂) - IntermediateField.inclusion hLE (x₁ + x₂)) := by
        rw [hdiff_eq]
        exact hval_add_E 1 _ _ hy₁_x₁ hy₂_x₂
      rw [hresE_char (y₁ + y₂) hy_add (x₁ + x₂) hx_add hdiff_p1, hringL.1, hr₁, hr₂]
    · have hy_mul : y₁ * y₂ = 0 ∨ 0 ≤ valL F E (y₁ * y₂) := by
        simpa using hvalE_mul_int y₁ y₂ 0 0 hy₁ hy₂
      have hx_mul : x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂) := by
        simpa using hvalL_mul_int x₁ x₂ 0 0 hx₁_int hx₂_int
      have hdiff_eq : y₁ * y₂ - IntermediateField.inclusion hLE (x₁ * x₂) =
          (y₁ - IntermediateField.inclusion hLE x₁) * y₂ +
            IntermediateField.inclusion hLE x₁ * (y₂ - IntermediateField.inclusion hLE x₂) := by
        rw [map_mul]; ring
      have ht1 : (y₁ - IntermediateField.inclusion hLE x₁) * y₂ = 0 ∨
          1 ≤ valL F E ((y₁ - IntermediateField.inclusion hLE x₁) * y₂) := by
        simpa using hvalE_mul_int _ y₂ 1 0 hy₁_x₁ hy₂
      have ht2 : IntermediateField.inclusion hLE x₁ * (y₂ - IntermediateField.inclusion hLE x₂) = 0 ∨
          1 ≤ valL F E (IntermediateField.inclusion hLE x₁ * (y₂ - IntermediateField.inclusion hLE x₂)) := by
        simpa using hvalE_mul_int _ _ 0 1 (hinc_int_E x₁ hx₁_int) hy₂_x₂
      have hdiff_p1 : y₁ * y₂ - IntermediateField.inclusion hLE (x₁ * x₂) = 0 ∨
          1 ≤ valL F E (y₁ * y₂ - IntermediateField.inclusion hLE (x₁ * x₂)) := by
        rw [hdiff_eq]
        exact hval_add_E 1 _ _ ht1 ht2
      rw [hresE_char (y₁ * y₂) hy_mul (x₁ * x₂) hx_mul hdiff_p1, hringL.2.1, hr₁, hr₂]
    · have hy_neg : -y₁ = 0 ∨ 0 ≤ valL F E (-y₁) := by
        rcases hy₁ with rfl | hge
        · left; exact neg_zero
        · right; rw [hval_neg_E]; exact hge
      have hx_neg : -x₁ = 0 ∨ 0 ≤ valL F L (-x₁) := by
        rcases hx₁_int with rfl | hge
        · left; exact neg_zero
        · right; rw [hval_neg_L]; exact hge
      have hdiff_eq : -y₁ - IntermediateField.inclusion hLE (-x₁) =
          -(y₁ - IntermediateField.inclusion hLE x₁) := by
        rw [map_neg]; ring
      have hdiff_p1 : -y₁ - IntermediateField.inclusion hLE (-x₁) = 0 ∨
          1 ≤ valL F E (-y₁ - IntermediateField.inclusion hLE (-x₁)) := by
        rw [hdiff_eq]
        rcases hy₁_x₁ with h0 | hge1
        · left; rw [h0, neg_zero]
        · right; rw [hval_neg_E]; exact hge1
      rw [hresE_char (-y₁) hy_neg (-x₁) hx_neg hdiff_p1, hringL.2.2, hr₁]
  have hresE_ker : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      (resE y = 0 ↔ (y = 0 ∨ 1 ≤ valL F E y)) := by
    intro y hy
    obtain ⟨x, hx_int, hyx⟩ := hResSurj_E y hy
    rw [hresE_char y hy x hx_int hyx, hresL_ker x hx_int, ← hinc_p1_E x]
    constructor
    · intro hinc
      have hy_eq : y = (y - IntermediateField.inclusion hLE x) + IntermediateField.inclusion hLE x := by
        ring
      rw [hy_eq]
      exact hval_add_E 1 _ _ hyx hinc
    · intro hy_p1
      have hinc_eq : IntermediateField.inclusion hLE x = y - (y - IntermediateField.inclusion hLE x) := by
        ring
      rw [hinc_eq]
      exact hvalE_sub 1 _ _ hy_p1 hyx

  set c₁_E : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom c₁
  have hc₁_E_coe : (c₁_E : E) = IntermediateField.inclusion hLE (c₁ : L) := rfl
  have hc₁_E_inv_coe : ((c₁_E⁻¹ : Eˣ) : E) =
      IntermediateField.inclusion hLE ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_E_val : valL F E (c₁_E : E) = 1 + condExpChar F E (traceChar F hLE ψ) := by
    rw [hc₁_E_coe, hval_alg_E (c₁ : L), hc₁_val, hcondChar_E]
    ring
  let E' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE
  have hto_inc_E : ∀ x : L,
      toExtendScalars F hLE (IntermediateField.inclusion hLE x) = algebraMap L E' x :=
    fun _ => rfl
  have hnorm_inc_E : ∀ x : L,
      normLM F hLE (IntermediateField.inclusion hLE x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (toExtendScalars F hLE (IntermediateField.inclusion hLE x)) = x ^ ℓ
    rw [hto_inc_E x, Algebra.norm_algebraMap x, hFinE_eq]
  have htrace_inc_E : ∀ x : L,
      traceLM F hLE (IntermediateField.inclusion hLE x) = (ℓ : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change Algebra.trace L E' (toExtendScalars F hLE (IntermediateField.inclusion hLE x)) = (ℓ : L) * x
    rw [hto_inc_E x, Algebra.trace_algebraMap x, hFinE_eq, nsmul_eq_mul]
  set χ'_E : Eˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLE))
  have hnorm_c₁E : Units.map (normLM F hLE) c₁_E = c₁ ^ ℓ := by
    apply Units.ext
    change normLM F hLE (IntermediateField.inclusion hLE (c₁ : L)) = ((c₁ ^ ℓ : Lˣ) : L)
    rw [hnorm_inc_E, Units.val_pow_eq_pow_val]
  have hχ'_E_c₁E : (χ'_E c₁_E : Ω F) = (χ' c₁ : Ω F) ^ ℓ := by
    dsimp only [χ'_E]
    rw [MonoidHom.comp_apply, hnorm_c₁E, map_pow, Units.val_pow_eq_pow_val]

  set χ_tilde_E : k_L → Ω F := fun a =>
    if ha : a = 0 then 0 else ((χ_k ^ ℓ) (Units.mk0 a ha) : Ω F)
  set ψ_tilde_E : k_L → Ω F := fun a => ψ_k ((ℓ : k_L) * a)
  have hχE_zero : χ_tilde_E 0 = 0 := dif_pos rfl
  have hχE_unit : ∀ w : Eˣ, valL F E (w : E) = 0 →
      χ_tilde_E (resE (w : E)) = (χ'_E w : Ω F)⁻¹ := by
    intro w hw_val
    have hw_int : (w : E) = 0 ∨ 0 ≤ valL F E (w : E) := Or.inr (by omega)
    obtain ⟨x, hx_int, hwx⟩ := hResSurj_E (w : E) hw_int
    have hres_w : resE (w : E) = resL x := hresE_char (w : E) hw_int x hx_int hwx
    have hres_w_ne : resE (w : E) ≠ 0 := by
      intro h0
      rcases (hresE_ker (w : E) hw_int).mp h0 with h1 | h2
      · exact Units.ne_zero w h1
      · omega
    have hres_x_ne : resL x ≠ 0 := hres_w ▸ hres_w_ne
    have hx_ne : x ≠ 0 := by
      intro h0; apply hres_x_ne; rw [h0, hresL_0]
    have hx_val0 : valL F L x = 0 := by
      have hge0 : 0 ≤ valL F L x := hx_int.resolve_left hx_ne
      by_contra hne0
      have hge1 : 1 ≤ valL F L x := by omega
      exact hres_x_ne ((hresL_ker x hx_int).mpr (Or.inr hge1))
    set u_x : Lˣ := Units.mk0 x hx_ne
    set w_x : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom u_x
    have hw_x_coe : (w_x : E) = IntermediateField.inclusion hLE x := rfl
    have hw_x_val0 : valL F E (w_x : E) = 0 := by
      rw [hw_x_coe, hval_alg_E x, hx_val0, mul_zero]
    set h : Eˣ := w_x⁻¹ * w
    have hh_sub : (h : E) - 1 = ((w_x⁻¹ : Eˣ) : E) * ((w : E) - IntermediateField.inclusion hLE x) := by
      have hinv : ((w_x⁻¹ : Eˣ) : E) * IntermediateField.inclusion hLE x = 1 := by
        exact_mod_cast Units.inv_mul w_x
      calc (h : E) - 1 = ((w_x⁻¹ : Eˣ) : E) * (w : E) - ((w_x⁻¹ : Eˣ) : E) * IntermediateField.inclusion hLE x := by
            rw [Units.val_mul, hinv]
        _ = ((w_x⁻¹ : Eˣ) : E) * ((w : E) - IntermediateField.inclusion hLE x) := by ring
    have hh_mem : h ∈ unitGroup F E (condExp F E χ'_E) := by
      rw [hCondχ'E, hunit_ge1_E 1 le_rfl h]
      rcases hwx with hd0 | hd1
      · left
        have hsub0 : (h : E) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ne : (w : E) - IntermediateField.inclusion hLE x ≠ 0 := by
          intro h0; rw [h0, hval0_E] at hd1; omega
        rw [hh_sub, hval_mul_E ((w_x⁻¹ : Eˣ) : E) _ (Units.ne_zero w_x⁻¹) hd_ne,
          hval_inv_E w_x, hw_x_val0]
        omega
    have hχE_h : χ'_E h = 1 := hχ'E_cond h hh_mem
    have hχE_w : χ'_E w = (χ' u_x) ^ ℓ := by
      have hww : w_x * h = w := mul_inv_cancel_left w_x w
      have hnorm_wx : Units.map (normLM F hLE) w_x = u_x ^ ℓ := by
        apply Units.ext
        change normLM F hLE (IntermediateField.inclusion hLE x) = ((u_x ^ ℓ : Lˣ) : L)
        rw [hnorm_inc_E x, Units.val_pow_eq_pow_val]; rfl
      rw [← hww, map_mul, hχE_h, mul_one]
      change χ' (Units.map (normLM F hLE) w_x) = (χ' u_x) ^ ℓ
      rw [hnorm_wx, map_pow]
    set a_w : k_Lˣ := Units.mk0 (resE (w : E)) hres_w_ne
    have hχk_aw : χ_k a_w = (χ' u_x)⁻¹ := hχ_k_unit u_x a_w hx_val0 hres_w.symm
    dsimp only [χ_tilde_E]
    rw [dif_neg hres_w_ne]
    change (((χ_k a_w) ^ ℓ : (Ω F)ˣ) : Ω F) = (χ'_E w : Ω F)⁻¹
    rw [hχk_aw, hχE_w, inv_pow, Units.val_inv_eq_inv_val]

  have hnat_int_resL : ∀ m : ℕ,
      ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      refine ⟨Or.inl (Nat.cast_zero), ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ m ih =>
      have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hval1_L])
      have hm1_int : ((m : L) + 1) = 0 ∨ 0 ≤ valL F L ((m : L) + 1) :=
        hval_add_L 0 (m : L) 1 ih.1 h1_int
      refine ⟨by simpa [Nat.cast_succ] using hm1_int, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1, Nat.cast_succ]

  obtain ⟨hψE_triv, ⟨y₁, hy₁_ne, hy₁_val, hy₁_ψE⟩, _, _⟩ :=
    hSpec_all E (traceChar F hLE ψ) hψE χ'_E
  have hψE_int : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ψ_tilde_E (resE y) = (traceChar F hLE ψ) (((c₁_E⁻¹ : Eˣ) : E) * y) := by
    intro y hy
    obtain ⟨x, hx_int, hyx⟩ := hResSurj_E y hy
    have hres_y : resE y = resL x := hresE_char y hy x hx_int hyx
    set z : E := y - IntermediateField.inclusion hLE x
    set w_z : E := ((c₁_E⁻¹ : Eˣ) : E) * z
    have hw_z_cond : w_z = 0 ∨ -condExpChar F E (traceChar F hLE ψ) ≤ valL F E w_z := by
      by_cases hz0 : z = 0
      · left; dsimp only [w_z]; rw [hz0, mul_zero]
      · right
        have hz_ge1 : 1 ≤ valL F E z := hyx.resolve_left hz0
        dsimp only [w_z]
        rw [hval_mul_E ((c₁_E⁻¹ : Eˣ) : E) z (Units.ne_zero c₁_E⁻¹) hz0,
          hval_inv_E c₁_E, hc₁_E_val]
        omega
    have hψE_wz : (traceChar F hLE ψ) w_z = 1 := hψE_triv w_z hw_z_cond
    have hy_decomp : ((c₁_E⁻¹ : Eˣ) : E) * y =
        IntermediateField.inclusion hLE (((c₁⁻¹ : Lˣ) : L) * x) + w_z := by
      dsimp only [w_z, z]
      rw [hc₁_E_inv_coe, map_mul]
      ring
    have htr_inc_cx :
        (traceChar F hLE ψ) (IntermediateField.inclusion hLE (((c₁⁻¹ : Lˣ) : L) * x)) =
          ψ (((c₁⁻¹ : Lˣ) : L) * ((ℓ : L) * x)) := by
      change ψ (traceLM F hLE (IntermediateField.inclusion hLE (((c₁⁻¹ : Lˣ) : L) * x))) = _
      rw [htrace_inc_E]
      congr 1
      ring
    have hℓ_int : (ℓ : L) = 0 ∨ 0 ≤ valL F L (ℓ : L) := (hnat_int_resL ℓ).1
    have hℓ_res : resL (ℓ : L) = (ℓ : k_L) := (hnat_int_resL ℓ).2
    have hℓx_int : (ℓ : L) * x = 0 ∨ 0 ≤ valL F L ((ℓ : L) * x) := by
      simpa using hvalL_mul_int (ℓ : L) x 0 0 hℓ_int hx_int
    have hℓx_res : resL ((ℓ : L) * x) = (ℓ : k_L) * resE y := by
      rw [(hresL_ring (ℓ : L) x hℓ_int hx_int).2.1, hℓ_res, hres_y]
    rw [hy_decomp, (traceChar F hLE ψ).map_add_eq_mul, hψE_wz, mul_one, htr_inc_cx,
      ← hψ_int ((ℓ : L) * x) hℓx_int, ← hψ_k_apply, hℓx_res]

  have hNeChar : (ℓ : k_L) ≠ 0 := by
    intro hℓ0
    set y₀ : E := (c₁_E : E) * y₁
    have hy₀_val : 0 ≤ valL F E y₀ := by
      dsimp only [y₀]
      rw [hval_mul_E (c₁_E : E) y₁ (Units.ne_zero c₁_E) hy₁_ne, hc₁_E_val]
      omega
    have hinv_c₁E : ((c₁_E⁻¹ : Eˣ) : E) * (c₁_E : E) = 1 := by exact_mod_cast Units.inv_mul c₁_E
    have heval : ψ_tilde_E (resE y₀) = (traceChar F hLE ψ) y₁ := by
      rw [hψE_int y₀ (Or.inr hy₀_val)]
      dsimp only [y₀]
      rw [← mul_assoc, hinv_c₁E, one_mul]
    have h1 : ψ_tilde_E (resE y₀) = 1 := by
      dsimp only [ψ_tilde_E]
      rw [hℓ0, zero_mul, ψ_k.map_zero_eq_one]
    exact hy₁_ψE (heval.symm.trans h1)

  have hGaussE_raw := hGauss_all E (traceChar F hLE ψ) hψE χ'_E hCondχ'E
    k_L resE hresE_0 hresE_1 hresE_ring hresE_ker hresE_surj
    c₁_E hc₁_E_val χ_tilde_E ψ_tilde_E hχE_zero hχE_unit hψE_int
  set ℓ_u : k_Lˣ := Units.mk0 (ℓ : k_L) hNeChar
  have hsum_E_units :
      (∑ a : k_L, χ_tilde_E a * ψ_tilde_E a) =
        ∑ u : k_Lˣ, ((χ_k ^ ℓ) u : Ω F) * ψ_k ((ℓ : k_L) * (u : k_L)) := by
    have herase :
        (∑ a : k_L, χ_tilde_E a * ψ_tilde_E a) =
          ∑ a ∈ (Finset.univ : Finset k_L).erase 0, χ_tilde_E a * ψ_tilde_E a := by
      exact (Finset.sum_erase Finset.univ (by rw [hχE_zero, zero_mul])).symm
    rw [herase]
    refine (Finset.sum_bij (fun (u : k_Lˣ) _ => (u : k_L)) ?_ ?_ ?_ ?_).symm
    · intro u _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero u, Finset.mem_univ _⟩
    · intro u₁ _ u₂ _ h
      exact Units.ext h
    · intro a ha
      have ha_ne : a ≠ 0 := (Finset.mem_erase.mp ha).1
      exact ⟨Units.mk0 a ha_ne, Finset.mem_univ _, rfl⟩
    · intro u _
      dsimp only [χ_tilde_E, ψ_tilde_E]
      rw [dif_neg (Units.ne_zero u), Units.mk0_val]
  have hsum_E_reindex :
      (∑ u : k_Lˣ, ((χ_k ^ ℓ) u : Ω F) * ψ_k ((ℓ : k_L) * (u : k_L))) =
        (((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) *
          (∑ x : k_Lˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k_L)) := by
    rw [Finset.mul_sum]
    refine Finset.sum_bij (fun (u : k_Lˣ) _ => ℓ_u * u) ?_ ?_ ?_ ?_
    · intro u _; exact Finset.mem_univ _
    · intro u₁ _ u₂ _ h; exact mul_left_cancel h
    · intro x _
      exact ⟨ℓ_u⁻¹ * x, Finset.mem_univ _, mul_inv_cancel_left ℓ_u x⟩
    · intro u _
      have hval_mul : ((ℓ : k_L) * (u : k_L)) = ((ℓ_u * u : k_Lˣ) : k_L) := rfl
      have hχ_mul_u : ((χ_k ^ ℓ) (ℓ_u * u) : Ω F) =
          (((χ_k ℓ_u : (Ω F)ˣ) : Ω F) ^ ℓ) * ((χ_k ^ ℓ) u : Ω F) := by
        rw [map_mul, Units.val_mul, MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
      have hinv_cancel :
          (((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) * (((χ_k ℓ_u : (Ω F)ˣ) : Ω F) ^ ℓ) = 1 := by
        rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_mul,
          ← mul_pow, inv_mul_cancel, one_pow, Units.val_one]
      rw [hval_mul, hχ_mul_u, ← mul_assoc, ← mul_assoc, hinv_cancel, one_mul]
  have htate_Eχ :
      tateEps F E χ'_E (traceChar F hLE ψ) =
        (qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
          (χ' c₁ : Ω F) ^ ℓ *
          (((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) *
          (∑ x : k_Lˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k_L)) := by
    rw [hGaussE_raw, hχ'_E_c₁E, hsum_E_units, hsum_E_reindex]
    ring

  
  
  
  
  have hval_norm_MC_unit_le0 : ∀ w : M_Cˣ, valL F M_C (w : M_C) = 0 →
      valL F L ((Units.map (normLM F hLM_C) w : Lˣ) : L) ≤ 0 := by
    intro w hw
    by_contra hlt
    have hge1 : 1 ≤ valL F L ((Units.map (normLM F hLM_C) w : Lˣ) : L) := by omega
    have hresL0 : resL ((Units.map (normLM F hLM_C) w : Lˣ) : L) = 0 :=
      (hresL_ker _ (Or.inr (by omega))).mpr (Or.inr hge1)
    have hres_norm : resL (normLM F hLM_C (w : M_C)) = Algebra.norm k_L (resM (w : M_C)) :=
      (hres_tr_norm_MC (w : M_C) (Or.inr (by omega))).2
    have hresM_ne : resM (w : M_C) ≠ 0 := by
      intro h0
      rcases (hresM_ker (w : M_C) (Or.inr (by omega))).mp h0 with h1 | h2
      · exact Units.ne_zero w h1
      · omega
    set y_w : k_Mˣ := Units.mk0 (resM (w : M_C)) hresM_ne
    have hnorm_ne : Algebra.norm k_L (resM (w : M_C)) ≠ 0 :=
      Units.ne_zero (Units.map (Algebra.norm k_L (S := k_M)) y_w)
    exact hnorm_ne (hres_norm.symm.trans hresL0)

  have hval_norm_MC_unit0 : ∀ u : M_Cˣ, valL F M_C (u : M_C) = 0 →
      valL F L ((Units.map (normLM F hLM_C) u : Lˣ) : L) = 0 := by
    intro u hu
    have hle0 := hval_norm_MC_unit_le0 u hu
    have hu_inv : valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = 0 := by
      rw [hval_inv_MC u, hu, neg_zero]
    have hle0_inv := hval_norm_MC_unit_le0 u⁻¹ hu_inv
    rw [map_inv, hval_inv_L] at hle0_inv
    omega

  let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
  have hto_inc_MC : ∀ x : L,
      toExtendScalars F hLM_C (IntermediateField.inclusion hLM_C x) = algebraMap L M_C' x :=
    fun _ => rfl
  have hnorm_inc_MC : ∀ x : L,
      normLM F hLM_C (IntermediateField.inclusion hLM_C x) = x ^ f_H := by
    intro x
    change Algebra.norm L (toExtendScalars F hLM_C (IntermediateField.inclusion hLM_C x)) = x ^ f_H
    rw [hto_inc_MC x, Algebra.norm_algebraMap x]
  have htrace_mul_inc_MC : ∀ (x : L) (z : M_C),
      traceLM F hLM_C (IntermediateField.inclusion hLM_C x * z) =
        x * traceLM F hLM_C z := by
    letI : Module L L := Semiring.toModule
    intro x z
    have h1 : toExtendScalars F hLM_C (IntermediateField.inclusion hLM_C x * z) =
        x • toExtendScalars F hLM_C z := by
      rw [map_mul, hto_inc_MC x, Algebra.smul_def]
    have h2 := (Algebra.trace L M_C').map_smul' x (toExtendScalars F hLM_C z)
    exact (congrArg (Algebra.trace L M_C') h1).trans h2

  have htr_int_MC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ 0 ≤ valL F L (traceLM F hLM_C z)) := by
    intro z hz
    set t : L := traceLM F hLM_C z
    by_cases ht0 : t = 0
    · exact Or.inl ht0
    · right
      by_contra hlt
      set u_t : Lˣ := Units.mk0 t ht0
      have hut_inv_val : 1 ≤ valL F L ((u_t⁻¹ : Lˣ) : L) := by
        rw [hval_inv_L u_t]
        change 1 ≤ - valL F L t
        omega
      set z' : M_C := IntermediateField.inclusion hLM_C ((u_t⁻¹ : Lˣ) : L) * z
      have hz'_p1 : z' = 0 ∨ 1 ≤ valL F M_C z' := by
        by_cases hz0 : z = 0
        · left; dsimp only [z']; rw [hz0, mul_zero]
        · right
          have hz_ge0 : 0 ≤ valL F M_C z := hz.resolve_left hz0
          have hinc_ne : IntermediateField.inclusion hLM_C ((u_t⁻¹ : Lˣ) : L) ≠ 0 := by
            intro h0
            exact Units.ne_zero u_t⁻¹
              ((IntermediateField.inclusion hLM_C).injective (h0.trans (map_zero _).symm))
          dsimp only [z']
          rw [hval_mul_MC _ z hinc_ne hz0, hval_alg_MC]
          omega
      have hz'_int : z' = 0 ∨ 0 ≤ valL F M_C z' := by
        rcases hz'_p1 with h0 | h1
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hresM_z' : resM z' = 0 := (hresM_ker z' hz'_int).mpr hz'_p1
      have htr_z' : traceLM F hLM_C z' = 1 := by
        dsimp only [z']
        rw [htrace_mul_inc_MC]
        exact_mod_cast Units.inv_mul u_t
      have hresL_tr : resL (traceLM F hLM_C z') = 0 := by
        rw [(hres_tr_norm_MC z' hz'_int).1, hresM_z', map_zero]
      rw [htr_z', hresL_1] at hresL_tr
      exact one_ne_zero hresL_tr

  
  set s_M : k_M → M_C := fun b => (hresM_surj b).choose
  have hs_M_int : ∀ b : k_M, s_M b = 0 ∨ 0 ≤ valL F M_C (s_M b) :=
    fun b => (hresM_surj b).choose_spec.1
  have hs_M_res : ∀ b : k_M, resM (s_M b) = b :=
    fun b => (hresM_surj b).choose_spec.2
  have hs_M_ne : ∀ b : k_M, b ≠ 0 → s_M b ≠ 0 := by
    intro b hb h0
    apply hb
    rw [← hs_M_res b, h0, hresM_0]
  have hs_M_val0 : ∀ b : k_M, b ≠ 0 → valL F M_C (s_M b) = 0 := by
    intro b hb
    have hge0 : 0 ≤ valL F M_C (s_M b) := (hs_M_int b).resolve_left (hs_M_ne b hb)
    by_contra hne
    have hge1 : 1 ≤ valL F M_C (s_M b) := by omega
    have hres0 : resM (s_M b) = 0 := (hresM_ker (s_M b) (hs_M_int b)).mpr (Or.inr hge1)
    rw [hs_M_res b] at hres0
    exact hb hres0
  set v_M : k_Mˣ → M_Cˣ := fun y => Units.mk0 (s_M (y : k_M)) (hs_M_ne (y : k_M) (Units.ne_zero y))
  have hv_M_val0 : ∀ y : k_Mˣ, valL F M_C ((v_M y : M_Cˣ) : M_C) = 0 :=
    fun y => hs_M_val0 (y : k_M) (Units.ne_zero y)
  have hv_M_int : ∀ y : k_Mˣ, ((v_M y : M_Cˣ) : M_C) = 0 ∨ 0 ≤ valL F M_C ((v_M y : M_Cˣ) : M_C) :=
    fun y => hs_M_int (y : k_M)
  have hv_M_res : ∀ y : k_Mˣ, resM ((v_M y : M_Cˣ) : M_C) = (y : k_M) :=
    fun y => hs_M_res (y : k_M)
  have hdesc_unit_MC : ∀ (θ : M_Cˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F M_C 1, θ u = 1) →
      ∀ (u : M_Cˣ) (y : k_Mˣ), valL F M_C (u : M_C) = 0 → resM (u : M_C) = (y : k_M) →
        (θ (v_M y))⁻¹ = (θ u)⁻¹ := by
    intro θ hθ1 u y hu_val hu_res
    have hu_int : (u : M_C) = 0 ∨ 0 ≤ valL F M_C (u : M_C) := Or.inr (by omega)
    have hneg_v_int : -((v_M y : M_Cˣ) : M_C) = 0 ∨ 0 ≤ valL F M_C (-((v_M y : M_Cˣ) : M_C)) := by
      right; rw [hval_neg_MC, hv_M_val0 y]
    set d : M_C := (u : M_C) - ((v_M y : M_Cˣ) : M_C)
    have hd_int : d = 0 ∨ 0 ≤ valL F M_C d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_MC 0 (u : M_C) (-((v_M y : M_Cˣ) : M_C)) hu_int hneg_v_int
    have hd_res : resM d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg,
        (hresM_ring (u : M_C) (-((v_M y : M_Cˣ) : M_C)) hu_int hneg_v_int).1,
        (hresM_ring ((v_M y : M_Cˣ) : M_C) ((v_M y : M_Cˣ) : M_C) (hv_M_int y) (hv_M_int y)).2.2,
        hu_res, hv_M_res y, add_neg_cancel]
    have hd1 : d = 0 ∨ 1 ≤ valL F M_C d := (hresM_ker d hd_int).mp hd_res
    set h : M_Cˣ := (v_M y)⁻¹ * u
    have hh_sub : (h : M_C) - 1 = (((v_M y)⁻¹ : M_Cˣ) : M_C) * d := by
      have hinv : (((v_M y)⁻¹ : M_Cˣ) : M_C) * ((v_M y : M_Cˣ) : M_C) = 1 := by
        exact_mod_cast Units.inv_mul (v_M y)
      calc (h : M_C) - 1 =
            (((v_M y)⁻¹ : M_Cˣ) : M_C) * (u : M_C) - (((v_M y)⁻¹ : M_Cˣ) : M_C) * ((v_M y : M_Cˣ) : M_C) := by
            rw [Units.val_mul, hinv]
        _ = (((v_M y)⁻¹ : M_Cˣ) : M_C) * d := by dsimp only [d]; ring
    have hh_mem : h ∈ unitGroup F M_C 1 := by
      rw [hunit_ge1_MC 1 le_rfl h]
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : M_C) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : 1 ≤ valL F M_C d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul_MC (((v_M y)⁻¹ : M_Cˣ) : M_C) d (Units.ne_zero (v_M y)⁻¹) hd0,
          hval_inv_MC (v_M y), hv_M_val0 y]
        omega
    have hθ_h : θ h = 1 := hθ1 h hh_mem
    have hθ_u : θ u = θ (v_M y) := by
      have huv : v_M y * h = u := mul_inv_cancel_left (v_M y) u
      rw [← huv, map_mul, hθ_h, mul_one]
    rw [hθ_u]
  let mkDescCharM : ∀ (θ : M_Cˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F M_C 1, θ u = 1) → (k_Mˣ →* (Ω F)ˣ) :=
    fun θ hθ1 =>
      { toFun := fun y => (θ (v_M y))⁻¹
        map_one' := by
          have h1 : (θ (v_M 1))⁻¹ = (θ 1)⁻¹ :=
            hdesc_unit_MC θ hθ1 1 1 (by rw [Units.val_one, hval1_MC])
              (by rw [Units.val_one, hresM_1, Units.val_one])
          rw [h1, map_one, inv_one]
        map_mul' := fun y₁ y₂ => by
          have hab_val : valL F M_C ((v_M y₁ * v_M y₂ : M_Cˣ) : M_C) = 0 := by
            rw [Units.val_mul,
              hval_mul_MC ((v_M y₁ : M_Cˣ) : M_C) ((v_M y₂ : M_Cˣ) : M_C)
                (Units.ne_zero (v_M y₁)) (Units.ne_zero (v_M y₂)),
              hv_M_val0 y₁, hv_M_val0 y₂, add_zero]
          have hab_res : resM ((v_M y₁ * v_M y₂ : M_Cˣ) : M_C) = ((y₁ * y₂ : k_Mˣ) : k_M) := by
            rw [Units.val_mul,
              (hresM_ring ((v_M y₁ : M_Cˣ) : M_C) ((v_M y₂ : M_Cˣ) : M_C)
                (hv_M_int y₁) (hv_M_int y₂)).2.1,
              hv_M_res y₁, hv_M_res y₂, Units.val_mul]
          have hm := hdesc_unit_MC θ hθ1 (v_M y₁ * v_M y₂) (y₁ * y₂) hab_val hab_res
          rw [hm, map_mul, mul_inv] }
  let μ_tilde : Fin r → (k_Mˣ →* (Ω F)ˣ) := fun i => mkDescCharM (ν_orb i) (hν_cond1 i).2
  have hμ_unit : ∀ (i : Fin r) (u : M_Cˣ) (y : k_Mˣ),
      valL F M_C (u : M_C) = 0 → resM (u : M_C) = (y : k_M) →
        (μ_tilde i) y = ((ν_orb i) u)⁻¹ :=
    fun i u y hu hy => hdesc_unit_MC (ν_orb i) (hν_cond1 i).2 u y hu hy

  have hμ_props : ∀ i : Fin r, (μ_tilde i) ^ ℓ = 1 ∧ μ_tilde i ≠ 1 := by
    intro i
    refine ⟨?_, ?_⟩
    · apply MonoidHom.ext
      intro y
      rw [MonoidHom.pow_apply, MonoidHom.one_apply]
      change ((ν_orb i) (v_M y))⁻¹ ^ ℓ = 1
      rw [inv_pow, ← MonoidHom.pow_apply, (hν_props i).1, MonoidHom.one_apply, inv_one]
    · intro hμ1
      have hspec_ν :=
        (hSpec_all M_C (traceChar F hLM_C ψ) hψMC (ν_orb i)).2.2.1 (by rw [(hν_cond1 i).1]; omega)
      obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := hspec_ν.2
      rw [(hν_cond1 i).1] at hu₀_mem
      have hu₀_val : valL F M_C (u₀ : M_C) = 0 := (hunit0_MC u₀).mp hu₀_mem
      have hu₀_res_ne : resM (u₀ : M_C) ≠ 0 := by
        intro h0
        rcases (hresM_ker (u₀ : M_C) (Or.inr (by omega))).mp h0 with h1 | h2
        · exact Units.ne_zero u₀ h1
        · omega
      set y₀ : k_Mˣ := Units.mk0 (resM (u₀ : M_C)) hu₀_res_ne
      have hμ_y₀ : (μ_tilde i) y₀ = ((ν_orb i) u₀)⁻¹ := hμ_unit i u₀ y₀ hu₀_val rfl
      have hμ_1 : (μ_tilde i) y₀ = 1 := by rw [hμ1]; rfl
      exact hu₀_ne (inv_eq_one.mp (hμ_y₀.symm.trans hμ_1))

  have hμ_orb_sum : ∀ y : k_Mˣ,
      1 + (∑ i : Fin r,
        ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
          (((μ_tilde i) ^ c) y : Ω F)) =
        ∑ j ∈ Finset.range ℓ, (((μ_tilde ⟨0, hr_pos⟩) ^ j) y : Ω F) := by
    intro y
    have hpow_eq : ∀ (i : Fin r) (m : ℕ),
        (((μ_tilde i) ^ m) y : Ω F) = (((ν_orb i) ^ m) ((v_M y)⁻¹) : Ω F) := by
      intro i m
      congr 1
      rw [MonoidHom.pow_apply, MonoidHom.pow_apply]
      change (((ν_orb i) (v_M y))⁻¹) ^ m = ((ν_orb i) ((v_M y)⁻¹)) ^ m
      rw [map_inv]
    simp_rw [hpow_eq]
    exact hν_orb_sum (ν_orb ⟨0, hr_pos⟩) (hν_props ⟨0, hr_pos⟩).1 (hν_props ⟨0, hr_pos⟩).2.1
      (hν_props ⟨0, hr_pos⟩).2.2.1 ((v_M y)⁻¹)

  
  set χ'_MC : M_Cˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLM_C))
  have htwist_unit : ∀ (i : Fin r) (u : M_Cˣ) (y : k_Mˣ),
      valL F M_C (u : M_C) = 0 → resM (u : M_C) = (y : k_M) →
        ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y) =
          ((ν_orb i * χ'_MC) u)⁻¹ := by
    intro i u y hu hy
    set u_L : Lˣ := Units.map (normLM F hLM_C) u
    set a_y : k_Lˣ := Units.map (Algebra.norm k_L (S := k_M)) y
    have huL_val0 : valL F L (u_L : L) = 0 := hval_norm_MC_unit0 u hu
    have huL_res : resL (u_L : L) = (a_y : k_L) := by
      change resL (normLM F hLM_C (u : M_C)) = Algebra.norm k_L (y : k_M)
      rw [← hy]
      exact (hres_tr_norm_MC (u : M_C) (Or.inr (by omega))).2
    have hχk_ay : χ_k a_y = (χ' u_L)⁻¹ := hχ_k_unit u_L a_y huL_val0 huL_res
    rw [MonoidHom.mul_apply, MonoidHom.comp_apply, hμ_unit i u y hu hy, hχk_ay,
      MonoidHom.mul_apply, MonoidHom.comp_apply, mul_inv]

  have hχ'MC_triv1 : ∀ u ∈ unitGroup F M_C 1, χ'_MC u = 1 := by
    have hcond1 : condExp F M_C χ'_MC = 1 := hcond_MC.trans hcond_L
    intro u hu
    exact hχ'MC_cond u (hcond1.symm ▸ hu)

  have hcond_twist_MC : ∀ i : Fin r, condExp F M_C (ν_orb i * χ'_MC) = 1 := by
    intro i
    have htriv1 : ∀ u ∈ unitGroup F M_C 1, (ν_orb i * χ'_MC) u = 1 := by
      intro u hu
      rw [MonoidHom.mul_apply, (hν_cond1 i).2 u hu, hχ'MC_triv1 u hu, mul_one]
    have hle1 : condExp F M_C (ν_orb i * χ'_MC) ≤ 1 := Nat.sInf_le htriv1
    by_contra hne1
    have heq0 : condExp F M_C (ν_orb i * χ'_MC) = 0 := by omega
    have hpow1 : (ν_orb i) ^ 1 = ν_orb i := by
      apply MonoidHom.ext; intro z; rw [MonoidHom.pow_apply, pow_one]
    have htriv0 : ∀ u ∈ unitGroup F M_C 0, (ν_orb i * χ'_MC) u = 1 := by
      have h := (hν_props i).2.2.2.2 1 hPrime_MCK.one_lt
      rwa [hpow1, heq0] at h
    have hμ_eq1 : μ_tilde i = 1 := by
      apply MonoidHom.ext
      intro y
      rw [MonoidHom.one_apply]
      set u : M_Cˣ := v_M y
      have hu_mem0 : u ∈ unitGroup F M_C 0 := (hunit0_MC u).mpr (hv_M_val0 y)
      have htwist_u : (ν_orb i * χ'_MC) u = 1 := htriv0 u hu_mem0
      have hprod_y : ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y) = 1 := by
        rw [htwist_unit i u y (hv_M_val0 y) (hv_M_res y), htwist_u, inv_one]
      set a_y : k_Lˣ := Units.map (Algebra.norm k_L (S := k_M)) y
      set q_kL := Fintype.card k_L
      have hay_pow : a_y ^ (q_kL - 1) = 1 := by
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, Units.val_one]
        exact FiniteField.pow_card_sub_one_eq_one (a_y : k_L) (Units.ne_zero a_y)
      have hχk_pow : (χ_k a_y) ^ (q_kL - 1) = 1 := by
        rw [← map_pow, hay_pow, map_one]
      have hμ_pow_q : ((μ_tilde i) y) ^ (q_kL - 1) = 1 := by
        have hp : ((μ_tilde i) y * χ_k a_y) ^ (q_kL - 1) = 1 ^ (q_kL - 1) :=
          congrArg (fun z : (Ω F)ˣ => z ^ (q_kL - 1)) hprod_y
        rw [mul_pow, hχk_pow, mul_one, one_pow] at hp
        exact hp
      have hμ_pow_ℓ : ((μ_tilde i) y) ^ ℓ = 1 := by
        rw [← MonoidHom.pow_apply, (hμ_props i).1, MonoidHom.one_apply]
      have hnot_dvd : ¬ (ℓ ∣ (q_kL - 1)) := by
        have hd := hNotDvd 1 le_rfl hf_H_gt1
        rwa [pow_one] at hd
      have hcop : Nat.Coprime ℓ (q_kL - 1) := hPrime_MCK.coprime_iff_not_dvd.mpr hnot_dvd
      have hdvd_ℓ : orderOf ((μ_tilde i) y) ∣ ℓ := orderOf_dvd_iff_pow_eq_one.mpr hμ_pow_ℓ
      have hdvd_q : orderOf ((μ_tilde i) y) ∣ (q_kL - 1) := orderOf_dvd_iff_pow_eq_one.mpr hμ_pow_q
      have hdvd_1 : orderOf ((μ_tilde i) y) ∣ 1 := by
        rw [← (hcop : Nat.gcd ℓ (q_kL - 1) = 1)]
        exact Nat.dvd_gcd hdvd_ℓ hdvd_q
      have hpow1_y := (orderOf_dvd_iff_pow_eq_one (n := 1)).mp hdvd_1
      rwa [pow_one] at hpow1_y
    exact (hμ_props i).2 hμ_eq1

  
  set c₁_M : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁
  have hc₁_M_coe : (c₁_M : M_C) = IntermediateField.inclusion hLM_C (c₁ : L) := rfl
  have hc₁_M_inv_coe : ((c₁_M⁻¹ : M_Cˣ) : M_C) =
      IntermediateField.inclusion hLM_C ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_M_val : valL F M_C (c₁_M : M_C) = 1 + condExpChar F M_C (traceChar F hLM_C ψ) := by
    rw [hc₁_M_coe, hval_alg_MC (c₁ : L), hc₁_val, hcondChar_MC]
  have hν_c₁M : ∀ i : Fin r, (ν_orb i) c₁_M = 1 := fun i => hν_triv_L i c₁
  have hnorm_c₁M : Units.map (normLM F hLM_C) c₁_M = c₁ ^ f_H := by
    apply Units.ext
    change normLM F hLM_C (IntermediateField.inclusion hLM_C (c₁ : L)) = ((c₁ ^ f_H : Lˣ) : L)
    rw [hnorm_inc_MC, Units.val_pow_eq_pow_val]
  have hχ'MC_c₁M : (χ'_MC c₁_M : Ω F) = (χ' c₁ : Ω F) ^ f_H := by
    dsimp only [χ'_MC]
    rw [MonoidHom.comp_apply, hnorm_c₁M, map_pow, Units.val_pow_eq_pow_val]

  set ψ_tilde_M : k_M → Ω F := fun b => ψ_k (Algebra.trace k_L k_M b)
  have hψM_int : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ψ_tilde_M (resM z) = (traceChar F hLM_C ψ) (((c₁_M⁻¹ : M_Cˣ) : M_C) * z) := by
    intro z hz
    have htr_int : traceLM F hLM_C z = 0 ∨ 0 ≤ valL F L (traceLM F hLM_C z) := htr_int_MC z hz
    have htr_res : resL (traceLM F hLM_C z) = Algebra.trace k_L k_M (resM z) :=
      (hres_tr_norm_MC z hz).1
    dsimp only [ψ_tilde_M]
    rw [← htr_res, hψ_k_apply, hψ_int (traceLM F hLM_C z) htr_int]
    change ψ (((c₁⁻¹ : Lˣ) : L) * traceLM F hLM_C z) =
      ψ (traceLM F hLM_C (((c₁_M⁻¹ : M_Cˣ) : M_C) * z))
    rw [hc₁_M_inv_coe, htrace_mul_inc_MC]

  have hsum_units_kM : ∀ (θ_M : k_Mˣ →* (Ω F)ˣ),
      (∑ b : k_M, (if hb : b = 0 then (0 : Ω F) else (θ_M (Units.mk0 b hb) : Ω F)) * ψ_tilde_M b) =
        ∑ y : k_Mˣ, (θ_M y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M)) := by
    intro θ_M
    have herase :
        (∑ b : k_M, (if hb : b = 0 then (0 : Ω F) else (θ_M (Units.mk0 b hb) : Ω F)) * ψ_tilde_M b) =
          ∑ b ∈ (Finset.univ : Finset k_M).erase 0,
            (if hb : b = 0 then (0 : Ω F) else (θ_M (Units.mk0 b hb) : Ω F)) * ψ_tilde_M b := by
      exact (Finset.sum_erase Finset.univ (by simp)).symm
    rw [herase]
    refine (Finset.sum_bij (fun (y : k_Mˣ) _ => (y : k_M)) ?_ ?_ ?_ ?_).symm
    · intro y _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero y, Finset.mem_univ _⟩
    · intro y₁ _ y₂ _ h
      exact Units.ext h
    · intro b hb
      have hb_ne : b ≠ 0 := (Finset.mem_erase.mp hb).1
      exact ⟨Units.mk0 b hb_ne, Finset.mem_univ _, rfl⟩
    · intro y _
      rw [dif_neg (Units.ne_zero y), Units.mk0_val]

  have hGaussMC_eval : ∀ (θ : M_Cˣ →* (Ω F)ˣ) (θ_M : k_Mˣ →* (Ω F)ˣ),
      condExp F M_C θ = 1 →
      (∀ (u : M_Cˣ) (y : k_Mˣ), valL F M_C (u : M_C) = 0 → resM (u : M_C) = (y : k_M) →
        θ_M y = (θ u)⁻¹) →
      tateEps F M_C θ (traceChar F hLM_C ψ) =
        (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) * (θ c₁_M : Ω F) *
          (∑ y : k_Mˣ, (θ_M y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M))) := by
    intro θ θ_M hcond hθ_unit
    set χ_tilde_θ : k_M → Ω F := fun b =>
      if hb : b = 0 then 0 else (θ_M (Units.mk0 b hb) : Ω F)
    have hχ_zero : χ_tilde_θ 0 = 0 := dif_pos rfl
    have hχ_unit : ∀ u : M_Cˣ, valL F M_C (u : M_C) = 0 →
        χ_tilde_θ (resM (u : M_C)) = (θ u : Ω F)⁻¹ := by
      intro u hu
      have hres_ne : resM (u : M_C) ≠ 0 := by
        intro h0
        rcases (hresM_ker (u : M_C) (Or.inr (by omega))).mp h0 with h1 | h2
        · exact Units.ne_zero u h1
        · omega
      dsimp only [χ_tilde_θ]
      rw [dif_neg hres_ne, hθ_unit u (Units.mk0 (resM (u : M_C)) hres_ne) hu rfl,
        Units.val_inv_eq_inv_val]
    have hG := hGauss_all M_C (traceChar F hLM_C ψ) hψMC θ hcond
      k_M resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
      c₁_M hc₁_M_val χ_tilde_θ ψ_tilde_M hχ_zero hχ_unit hψM_int
    rw [hG, hsum_units_kM θ_M]

  set Q_MC : Ω F := (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ)
  have htate_MC_untwist : ∀ i : Fin r,
      tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ) =
        Q_MC * (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M))) := by
    intro i
    rw [hGaussMC_eval (ν_orb i) (μ_tilde i) (hν_cond1 i).1 (hμ_unit i), hν_c₁M i,
      Units.val_one, mul_one]

  have htate_MC_twist : ∀ i : Fin r,
      tateEps F M_C (ν_orb i * χ'_MC) (traceChar F hLM_C ψ) =
        Q_MC * (χ' c₁ : Ω F) ^ f_H *
          (∑ y : k_Mˣ,
            ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
              ψ_k (Algebra.trace k_L k_M (y : k_M))) := by
    intro i
    rw [hGaussMC_eval (ν_orb i * χ'_MC)
      (μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M))))
      (hcond_twist_MC i) (htwist_unit i),
      MonoidHom.mul_apply, hν_c₁M i, one_mul, hχ'MC_c₁M]

  have hprod_MC_untwist :
      (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
        Q_MC ^ r *
          (∏ i : Fin r,
            (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M)))) := by
    rw [Finset.prod_congr rfl (fun i _ => htate_MC_untwist i),
      Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

  have hprod_MC_twist :
      (∏ i : Fin r, tateEps F M_C (ν_orb i * χ'_MC) (traceChar F hLM_C ψ)) =
        Q_MC ^ r * (χ' c₁ : Ω F) ^ (r * f_H) *
          (∏ i : Fin r,
            (∑ y : k_Mˣ,
              ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
                ψ_k (Algebra.trace k_L k_M (y : k_M)))) := by
    rw [Finset.prod_congr rfl (fun i _ => htate_MC_twist i),
      Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_const, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      ← pow_mul, mul_comm f_H r]

  
  
  
  have htate_L1 : tateEps F L 1 ψ = (qL F L : Ω F) ^ n := htate_triv L ψ
  have htate_E1 : tateEps F E 1 (traceChar F hLE ψ) =
      (qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) :=
    htate_triv E (traceChar F hLE ψ)
  have hC_pow : (χ' c₁ : Ω F) * (χ' c₁ : Ω F) ^ (r * f_H) = (χ' c₁ : Ω F) ^ ℓ := by
    rw [← pow_succ', hr_mul, Nat.sub_add_cancel hℓ_pos]
  have hDH := hDH_orbit hNeChar ψ_k hψ_k_ne χ_k μ_tilde hμ_props hμ_orb_sum
  change tateEps F E χ'_E (traceChar F hLE ψ) *
      tateEps F L 1 ψ *
      (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
    tateEps F E 1 (traceChar F hLE ψ) *
      tateEps F L χ' ψ *
      (∏ i : Fin r, tateEps F M_C (ν_orb i * χ'_MC) (traceChar F hLM_C ψ))
  rw [htate_Eχ, htate_L1, hprod_MC_untwist, htate_E1, htate_Lχ, hprod_MC_twist]
  calc ((qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
          (χ' c₁ : Ω F) ^ ℓ *
          (((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) *
          (∑ x : k_Lˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k_L))) *
        (qL F L : Ω F) ^ n *
        (Q_MC ^ r *
          (∏ i : Fin r,
            (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M)))))
      = (qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
          (qL F L : Ω F) ^ n *
          Q_MC ^ r *
          (χ' c₁ : Ω F) ^ ℓ *
          ((((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) *
            (∑ x : k_Lˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k_L)) *
            (∏ i : Fin r,
              (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M))))) := by
        ring
    _ = (qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
          (qL F L : Ω F) ^ n *
          Q_MC ^ r *
          ((χ' c₁ : Ω F) * (χ' c₁ : Ω F) ^ (r * f_H)) *
          ((∑ x : k_Lˣ, (χ_k x : Ω F) * ψ_k (x : k_L)) *
            (∏ i : Fin r,
              (∑ y : k_Mˣ,
                ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
                  ψ_k (Algebra.trace k_L k_M (y : k_M))))) := by
        rw [← hC_pow, hDH]
    _ = (qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
          ((qL F L : Ω F) ^ n * (χ' c₁ : Ω F) *
            (∑ x : k_Lˣ, (χ_k x : Ω F) * ψ_k (x : k_L))) *
          (Q_MC ^ r * (χ' c₁ : Ω F) ^ (r * f_H) *
            (∏ i : Fin r,
              (∑ y : k_Mˣ,
                ((μ_tilde i * χ_k.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
                  ψ_k (Algebra.trace k_L k_M (y : k_M))))) := by
        ring

theorem ld_ch13_unramified_mc_higher_cond_lifting (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] (hLM_C : L ≤ M_C)
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (ψ : AddChar L (Ω F))
    (χ' : Lˣ →* (Ω F)ˣ)
    (ha2 : 2 ≤ condExp F L χ')
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hχ'MC_cond : ∀ u ∈ unitGroup F M_C (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C)))),
      (χ'.comp (Units.map (normLM F hLM_C))) u = 1)
    (hval_alg_MC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x)
    (htr_bound_MC : ∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hnorm_lin_MC : ∀ (d : ℕ), 1 ≤ d → ∀ z : M_C, (z = 0 ∨ (d : ℤ) ≤ valL F M_C z) →
      (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z))))
    (hcondChar_MC : condExpChar F M_C (traceChar F hLM_C ψ) = condExpChar F L ψ)
    (hcond_MC : condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ')
    (hvalL : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalMC : valL F M_C 0 = 0 ∧ valL F M_C 1 = 0 ∧ valL F M_C (-1) = 0 ∧
      (∀ x : M_C, valL F M_C (-x) = valL F M_C x) ∧
      (∀ x y : M_C, x ≠ 0 → y ≠ 0 → valL F M_C (x * y) = valL F M_C x + valL F M_C y) ∧
      (∀ u : M_Cˣ, valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = - valL F M_C (u : M_C)) ∧
      (∀ m : ℤ, ∃ c : M_Cˣ, valL F M_C (c : M_C) = m) ∧
      (∀ (k : ℤ) (x y : M_C),
        (x = 0 ∨ k ≤ valL F M_C x) → (y = 0 ∨ k ≤ valL F M_C y) →
          (x + y = 0 ∨ k ≤ valL F M_C (x + y))) ∧
      (∀ u : M_Cˣ, u ∈ unitGroup F M_C 0 ↔ valL F M_C (u : M_C) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M_Cˣ,
        u ∈ unitGroup F M_C a ↔ ((u : M_C) = 1 ∨ (a : ℤ) ≤ valL F M_C ((u : M_C) - 1))) ∧
      (∀ (a : ℕ) (u : M_Cˣ), u ∈ unitGroup F M_C a → valL F M_C (u : M_C) = 0))
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] (resL : L → k_L) (resM : M_C → k_M)
    (hfinrank_res : Module.finrank k_L k_M =
      Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hres_Fz2 : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      let F_z : Polynomial k_L :=
        (minpoly k_L (resM z)) ^
          (Module.finrank k_L k_M / (minpoly k_L (resM z)).natDegree)
      resL (traceLM F hLM_C z) = -F_z.nextCoeff ∧
      resL (normLM F hLM_C z) = (-1 : k_L) ^ (Module.finrank k_L k_M) * F_z.coeff 0 ∧
      ∀ (ϖ : Lˣ) (d : ℕ), valL F L (ϖ : L) = 1 → 1 ≤ d →
        ∃ s₂ : L, (s₂ = 0 ∨ 0 ≤ valL F L s₂) ∧
          resL s₂ = F_z.coeff (Module.finrank k_L k_M - 2) ∧
          (normLM F hLM_C (1 + IntermediateField.inclusion hLM_C (((ϖ ^ d : Lˣ) : L)) * z) -
            (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLM_C z +
              (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂) = 0 ∨
            (2 * d + 1 : ℤ) ≤ valL F L
              (normLM F hLM_C (1 + IntermediateField.inclusion hLM_C (((ϖ ^ d : Lˣ) : L)) * z) -
                (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLM_C z +
                  (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂))))
    (M_poly : ℕ → Finset (Polynomial k_L)) (Λ_poly : Polynomial k_L → ℕ)
    (hM_mem : ∀ (d : ℕ) (f : Polynomial k_L), f ∈ M_poly d ↔ f.Monic ∧ f.natDegree = d)
    (hM_zero : M_poly 0 = {1})
    (hM_one : ∀ (μ : Polynomial k_L → Ω F),
      (∑ f ∈ M_poly 1, μ f) = ∑ x : k_L, μ (Polynomial.X - Polynomial.C x))
    (hΛ_prime_pow : ∀ (P : Polynomial k_L) (m : ℕ), P.Monic → Irreducible P → 1 ≤ m →
      Λ_poly (P ^ m) = P.natDegree)
    (hΛ_ne_zero : ∀ (Q : Polynomial k_L), Λ_poly Q ≠ 0 →
      ∃ (P : Polynomial k_L) (m : ℕ), P.Monic ∧ Irreducible P ∧ 1 ≤ m ∧ Q = P ^ m)
    (hNewton : ∀ (μ : Polynomial k_L → Ω F),
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → μ (f * g) = μ f * μ g) →
      ∀ (n : ℕ),
        (∑ d ∈ Finset.Icc 1 n,
          (∑ Q ∈ M_poly d, (Λ_poly Q : Ω F) * μ Q) * (∑ B ∈ M_poly (n - d), μ B)) =
          (n : Ω F) * (∑ P ∈ M_poly n, μ P))
    (ϖ_L c_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hc_L_val : valL F L (c_L : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_L_stat : ∀ w ∈ unitGroup F L (condExp F L χ' - condExp F L χ' / 2),
      (χ' w : Ω F) = ψ (((c_L⁻¹ : Lˣ) : L) * ((w : L) - 1)))
    (hEvalMC : ∀ (c_M : M_Cˣ),
      valL F M_C (c_M : M_C) =
        (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) : ℤ) +
          condExpChar F M_C (traceChar F hLM_C ψ) →
      (∀ w ∈ unitGroup F M_C
          (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) -
            condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) / 2),
        ((χ'.comp (Units.map (normLM F hLM_C))) w : Ω F) =
          (traceChar F hLM_C ψ) (((c_M⁻¹ : M_Cˣ) : M_C) * ((w : M_C) - 1))) →
      let a := condExp F M_C (χ'.comp (Units.map (normLM F hLM_C)))
      let d := a / 2
      (a = 2 * d →
        tateEps F M_C (χ'.comp (Units.map (normLM F hLM_C))) (traceChar F hLM_C ψ) =
          (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) *
            (((χ'.comp (Units.map (normLM F hLM_C))) c_M : Ω F) *
              (traceChar F hLM_C ψ) (((c_M⁻¹ : M_Cˣ) : M_C))) *
            (Fintype.card k_M : Ω F) ^ d) ∧
      (a = 2 * d + 1 →
        ∀ (ϖ_M : M_Cˣ), valL F M_C (ϖ_M : M_C) = 1 →
        ∀ (Q_M : k_M → Ω F),
          (∀ (z : M_C) (hz_int : z = 0 ∨ 0 ≤ valL F M_C z)
            (hz_ne : 1 + ((ϖ_M ^ d : M_Cˣ) : M_C) * z ≠ 0),
            Q_M (resM z) =
              ((χ'.comp (Units.map (normLM F hLM_C)))
                (Units.mk0 (1 + ((ϖ_M ^ d : M_Cˣ) : M_C) * z) hz_ne) : Ω F)⁻¹ *
                (traceChar F hLM_C ψ) (((c_M⁻¹ : M_Cˣ) : M_C) * ((ϖ_M ^ d : M_Cˣ) : M_C) * z)) →
          tateEps F M_C (χ'.comp (Units.map (normLM F hLM_C))) (traceChar F hLM_C ψ) =
            (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) *
              (((χ'.comp (Units.map (normLM F hLM_C))) c_M : Ω F) *
                (traceChar F hLM_C ψ) (((c_M⁻¹ : M_Cˣ) : M_C))) *
              ((Fintype.card k_M : Ω F) ^ d * (∑ b : k_M, Q_M b)))) :
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    let a := condExp F L χ'
    let d := a / 2
    let c_M : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c_L
    valL F M_C (c_M : M_C) =
      (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) : ℤ) +
        condExpChar F M_C (traceChar F hLM_C ψ) ∧
    (∀ x : M_C,
      (x = 0 ∨ (((condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) + 1) / 2 : ℕ) : ℤ) ≤ valL F M_C x) →
      ∀ hx : 1 + x ≠ 0,
        ((χ'.comp (Units.map (normLM F hLM_C))) (Units.mk0 (1 + x) hx) : Ω F) =
          (traceChar F hLM_C ψ) (((c_M⁻¹ : M_Cˣ) : M_C) * x)) ∧
    (a % 2 = 0 →
      tateEps F M_C (χ'.comp (Units.map (normLM F hLM_C))) (traceChar F hLM_C ψ) =
        (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) *
          (((Fintype.card k_L : Ω F) ^ d) ^ f_H) *
          (χ' c_L : Ω F) ^ f_H *
          (ψ (((c_L⁻¹ : Lˣ) : L))) ^ f_H) ∧
    (∀ (hd : 1 ≤ d), a = 2 * d + 1 →
      ∀ (Q_L ψ_0 : k_L → Ω F) (lam₂ : Polynomial k_L → Ω F),
        (∀ (x : L) (hx_int : x = 0 ∨ 0 ≤ valL F L x)
          (hx_ne : 1 + ((ϖ_L ^ d : Lˣ) : L) * x ≠ 0),
          Q_L (resL x) =
            (χ' (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * x) hx_ne) : Ω F)⁻¹ *
              ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * x)) →
        (∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
          ψ_0 (resL x) = ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ_L ^ (2 * d) : Lˣ) : L) * x)) →
        (∀ f : Polynomial k_L,
          lam₂ f = Q_L (-f.nextCoeff) *
            ψ_0 (-(if f.natDegree < 2 then 0 else f.coeff (f.natDegree - 2)))) →
        (∀ x : k_L, lam₂ (Polynomial.X - Polynomial.C x) = Q_L x) →
        lam₂ 1 = 1 →
        (∀ f g : Polynomial k_L, f.Monic → g.Monic → lam₂ (f * g) = lam₂ f * lam₂ g) →
        (∀ (k : ℕ), 2 ≤ k →
          (∑ c : Fin k → k_L,
            lam₂ (Polynomial.X ^ k + ∑ i : Fin k, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0) →
        tateEps F M_C (χ'.comp (Units.map (normLM F hLM_C))) (traceChar F hLM_C ψ) =
          (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) *
            (((Fintype.card k_L : Ω F) ^ d) ^ f_H) *
            (χ' c_L : Ω F) ^ f_H *
            (ψ (((c_L⁻¹ : Lˣ) : L))) ^ f_H *
            (-1 : Ω F) ^ (f_H - 1) *
            (∑ x : k_L, Q_L x) ^ f_H) :=
by
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL
  obtain ⟨hval0_M, hval1_M, hval_neg1_M, hval_neg_M, hval_mul_M, hval_inv_M, hval_surj_M,
    hval_add_M, hunit0_M, hunit_ge1_M, hunit_val0_M⟩ := hvalMC
  set f_H : ℕ := Module.finrank L (IntermediateField.extendScalars hLM_C)
  set a : ℕ := condExp F L χ'
  set d₀ : ℕ := a / 2
  have ha_ge1 : 1 ≤ a := by omega
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hone_add_ne_zero_L : ∀ (m : ℕ), 1 ≤ m → ∀ (x : L),
      (x = 0 ∨ (m : ℤ) ≤ valL F L x) → 1 + x ≠ 0 := by
    intro m hm x hx h0
    have hx_neg1 : x = -1 := eq_neg_of_add_eq_zero_right h0
    rcases hx with rfl | hge
    · rw [add_zero] at h0
      exact one_ne_zero h0
    · rw [hx_neg1, hval_neg1_L] at hge
      omega
  have hone_add_mem_unitGroup_L : ∀ (m : ℕ), 1 ≤ m → ∀ (x : L)
      (hx : x = 0 ∨ (m : ℤ) ≤ valL F L x) (hne : 1 + x ≠ 0),
      Units.mk0 (1 + x) hne ∈ unitGroup F L m := by
    intro m hm x hx hne
    rw [hunit_ge1_L m hm (Units.mk0 (1 + x) hne)]
    have hsub : ((Units.mk0 (1 + x) hne : Lˣ) : L) - 1 = x := by
      rw [Units.val_mk0, add_sub_cancel_left]
    rcases hx with rfl | hge
    · left
      rw [Units.val_mk0, add_zero]
    · right
      rw [hsub]
      exact hge
  have hχ'_eq_of_sub : ∀ (u₁ u₂ : Lˣ),
      valL F L (u₁ : L) = 0 →
      ((u₂ : L) - (u₁ : L) = 0 ∨ (a : ℤ) ≤ valL F L ((u₂ : L) - (u₁ : L))) →
      χ' u₂ = χ' u₁ := by
    intro u₁ u₂ hu₁ hsub
    have hmem : u₁⁻¹ * u₂ ∈ unitGroup F L a := by
      rw [hunit_ge1_L a ha_ge1 (u₁⁻¹ * u₂)]
      have hdiff : ((u₁⁻¹ * u₂ : Lˣ) : L) - 1 =
          ((u₁⁻¹ : Lˣ) : L) * ((u₂ : L) - (u₁ : L)) := by
        calc ((u₁⁻¹ * u₂ : Lˣ) : L) - 1
          _ = ((u₁⁻¹ : Lˣ) : L) * (u₂ : L) - ((u₁⁻¹ : Lˣ) : L) * (u₁ : L) := by
            rw [Units.val_mul, Units.inv_mul]
          _ = ((u₁⁻¹ : Lˣ) : L) * ((u₂ : L) - (u₁ : L)) := by ring
      rcases hsub with h0 | hge
      · left
        have h1 : ((u₁⁻¹ * u₂ : Lˣ) : L) - 1 = 0 := by rw [hdiff, h0, mul_zero]
        exact sub_eq_zero.mp h1
      · by_cases h0 : (u₂ : L) - (u₁ : L) = 0
        · left
          have h1 : ((u₁⁻¹ * u₂ : Lˣ) : L) - 1 = 0 := by rw [hdiff, h0, mul_zero]
          exact sub_eq_zero.mp h1
        · right
          rw [hdiff, hval_mul_L _ _ (Units.ne_zero u₁⁻¹) h0, hval_inv_L u₁, hu₁]
          omega
    have htriv : χ' (u₁⁻¹ * u₂) = 1 := hχ'_cond (u₁⁻¹ * u₂) hmem
    rw [map_mul, map_inv, inv_mul_eq_one] at htriv
    exact htriv.symm
  set M_C' := IntermediateField.extendScalars hLM_C
  have hnorm_inc : ∀ x : L,
      normLM F hLM_C (IntermediateField.inclusion hLM_C x) = x ^ f_H := by
    intro x
    change Algebra.norm L (algebraMap L M_C' x) = x ^ f_H
    exact Algebra.norm_algebraMap x
  have htrace_inc : ∀ x : L,
      traceLM F hLM_C (IntermediateField.inclusion hLM_C x) = f_H • x := by
    intro x
