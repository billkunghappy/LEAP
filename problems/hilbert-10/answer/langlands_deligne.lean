  have hψ_sub_one : ∀ A B : L, ψ (α₀ * A) = 1 → ψ (α₀ * B) = 1 → ψ (α₀ * (A - B)) = 1 := by
    intro A B hA hB
    have heq : α₀ * A = α₀ * (A - B) + α₀ * B := by ring
    have hsum : ψ (α₀ * (A - B)) * ψ (α₀ * B) = 1 := by
      rw [← ψ.map_add_eq_mul, ← heq, hA]
    rw [hB, mul_one] at hsum
    exact hsum
  have hψ_nat_mul_one : ∀ (n : ℕ) (A : L), ψ (α₀ * A) = 1 → ψ (α₀ * ((n : L) * A)) = 1 := by
    intro n A hA
    have heq : α₀ * ((n : L) * A) = n • (α₀ * A) := by
      rw [nsmul_eq_mul]
      ring
    rw [heq, AddChar.map_nsmul_eq_pow, hA, one_pow]
  have hψ_finset_sum_one : ∀ (S : Finset (Fin p)) (f : Fin p → L),
      (∀ j ∈ S, ψ (α₀ * f j) = 1) → ψ (α₀ * (∑ j ∈ S, f j)) = 1 := by
    intro S f hf
    induction S using Finset.induction_on with
    | empty =>
      simp [ψ.map_zero_eq_one]
    | @insert j s hj ih =>
      rw [Finset.sum_insert hj]
      exact hψ_add_one (f j) (∑ i ∈ s, f i)
        (hf j (Finset.mem_insert_self j s))
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hψ_gh_mono : ∀ (j : Fin p) (x : E'),
      (x = 0 ∨ (d₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (j : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) →
      let z_j := IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (j : ℕ))
      ψ (α₀ * (2 * (g_fn z_j + h_fn z_j))) = 1 := by
    intro j x hx z_j
    obtain ⟨hg_ne, hg_eq⟩ := hg_mono j x hx
    obtain ⟨hh_ne, hh_eq⟩ := hh_mono j x hx
    by_cases hj : (j : ℕ) = p - 2
    · obtain ⟨hx_half, hg_congr⟩ := hg_eq hj
      have hh_congr := hh_eq hj
      have hxs₀_half : x * s₀ = 0 ∨ (((bE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' (x * s₀) := by
        by_cases hx0 : x = 0
        · exact Or.inl (by rw [hx0, zero_mul])
        · by_cases hs0 : s₀ = 0
          · exact Or.inl (by rw [hs0, mul_zero])
          · right
            have hx_v : (((bE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' x := hx_half.resolve_left hx0
            have hs_v : ((p - 1 : ℕ) : ℤ) * ((bE' - bM₁' : ℕ) : ℤ) ≤ valL F E' s₀ :=
              hs₀_val.resolve_left hs0
            have hs_nonneg : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((bE' - bM₁' : ℕ) : ℤ) := by positivity
            rw [hvalE'_mul x s₀ hx0 hs0]
            omega
      have hsum_congr := hvalL_add (bE' : ℤ) _ _ hg_congr hh_congr
      have h2_congr := hvalL_add (bE' : ℤ) _ _ hsum_congr hsum_congr
      have htr_sub : traceLM F hLE' (x * (1 - s₀)) =
          traceLM F hLE' x - traceLM F hLE' (x * s₀) := by
        have hsub : x * (1 - s₀) = x - x * s₀ := by ring
        rw [hsub, map_sub]
      let Qx : L := 2 * (traceLM F hLE' x + normLM F hLE' x)
      let Qxs₀ : L := 2 * (traceLM F hLE' (x * s₀) + normLM F hLE' (x * s₀))
      have hring :
          (g_fn z_j - ((p - 1 : ℕ) : L) * traceLM F hLE' (x * (1 - s₀)) +
            (h_fn z_j - ((p - 1 : ℕ) : L) * (normLM F hLE' x - normLM F hLE' (x * s₀)))) +
          (g_fn z_j - ((p - 1 : ℕ) : L) * traceLM F hLE' (x * (1 - s₀)) +
            (h_fn z_j - ((p - 1 : ℕ) : L) * (normLM F hLE' x - normLM F hLE' (x * s₀)))) =
          2 * (g_fn z_j + h_fn z_j) - ((p - 1 : ℕ) : L) * (Qx - Qxs₀) := by
        dsimp only [Qx, Qxs₀]
        rw [htr_sub]
        ring
      rw [hring] at h2_congr
      rw [hψ_sub_eq_one _ _ h2_congr]
      apply hψ_nat_mul_one (p - 1)
      exact hψ_sub_one Qx Qxs₀ (hψ_Q x hx_half) (hψ_Q (x * s₀) hxs₀_half)
    · have hg_val := hg_ne hj
      have hh_val := hh_ne hj
      have hgh_val := hvalL_add (bE' : ℤ) (g_fn z_j) (h_fn z_j) hg_val hh_val
      have h2gh_val := hvalL_add (bE' : ℤ) _ _ hgh_val hgh_val
      rw [← two_mul] at h2gh_val
      exact hψ_triv _ h2gh_val
  have hStage1 : ∀ w'' : K₁, (w'' = 0 ∨ (3 * (d₁ : ℤ)) ≤ valL F K₁ w'') →
      ψ (α₀ * Δ_quad w'') = 1 := by
    intro w'' hw''
    exact hψ_triv (Δ_quad w'') (hDeep3 w'' hw'')
  have hStage2 : ∀ w' : K₁, (w' = 0 ∨ (2 * (d₁ : ℤ)) ≤ valL F K₁ w') →
      ψ (α₀ * Δ_quad w') = 1 := by
    intro w' hw'
    have hd2_ge : d₁ ≤ 2 * d₁ := by omega
    have hw'_cast : w' = 0 ∨ ((2 * d₁ : ℕ) : ℤ) ≤ valL F K₁ w' := by
      rcases hw' with h0 | hle
      · exact Or.inl h0
      · right; push_cast; exact hle
    obtain ⟨x', w'', hx', hw'', hdecomp'⟩ := hMonoDecomp (2 * d₁) hd2_ge w' hw'_cast
    rw [hψ_sub_eq_one _ _ hdecomp']
    have hw''_3 : w'' = 0 ∨ (3 * (d₁ : ℤ)) ≤ valL F K₁ w'' := by
      rcases hw'' with h0 | hle
      · exact Or.inl h0
      · right; exact le_trans (by omega) hle
    refine hψ_add_one _ _ (hψ_finset_sum_one Finset.univ _ fun j _ => ?_) (hStage1 w'' hw''_3)
    obtain ⟨hx'_j, hz'_j⟩ := hx' j
    let z'_j : K₁ := IntermediateField.inclusion hE'K₁ (x' j) * ((Δ : K₁) ^ (j : ℕ))
    obtain ⟨v'_j, hv'_j, hmaster'_j⟩ := hMaster' (2 * d₁) hd2_ge z'_j hz'_j
    have hx'_j_d1 : x' j = 0 ∨
        (d₁ : ℤ) ≤ (p : ℤ) * valL F E' (x' j) - (j : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) := by
      rcases hx'_j with h0 | hle
      · exact Or.inl h0
      · right; exact le_trans (by omega) hle
    have hv'_j_3 : v'_j = 0 ∨ (3 * (d₁ : ℤ)) ≤ valL F K₁ v'_j := by
      rcases hv'_j with h0 | hle
      · exact Or.inl h0
      · right; exact le_trans (by omega) hle
    have hsum_eq1 : ψ (α₀ * (Δ_quad z'_j + Δ_quad v'_j)) = 1 := by
      rw [hψ_sub_eq_one _ _ hmaster'_j]
      exact hψ_gh_mono j (x' j) hx'_j_d1
    have hv'_eq1 : ψ (α₀ * Δ_quad v'_j) = 1 := hStage1 v'_j hv'_j_3
    have hsub := hψ_sub_one (Δ_quad z'_j + Δ_quad v'_j) (Δ_quad v'_j) hsum_eq1 hv'_eq1
    rwa [add_sub_cancel_right] at hsub
  have hStage3 : ψ (α₀ * Δ_quad w) = 1 := by
    obtain ⟨x, w', hx, hw', hdecomp⟩ := hMonoDecomp d₁ (le_refl d₁) w hw
    rw [hψ_sub_eq_one _ _ hdecomp]
    refine hψ_add_one _ _ (hψ_finset_sum_one Finset.univ _ fun j _ => ?_) (hStage2 w' hw')
    obtain ⟨hx_j, hz_j⟩ := hx j
    let z_j : K₁ := IntermediateField.inclusion hE'K₁ (x j) * ((Δ : K₁) ^ (j : ℕ))
    obtain ⟨v_j, hv_j, hmaster_j⟩ := hMaster' d₁ (le_refl d₁) z_j hz_j
    have hsum_eq1 : ψ (α₀ * (Δ_quad z_j + Δ_quad v_j)) = 1 := by
      rw [hψ_sub_eq_one _ _ hmaster_j]
      exact hψ_gh_mono j (x j) hx_j
    have hv_eq1 : ψ (α₀ * Δ_quad v_j) = 1 := hStage2 v_j hv_j
    have hsub := hψ_sub_one (Δ_quad z_j + Δ_quad v_j) (Δ_quad v_j) hsum_eq1 hv_eq1
    rwa [add_sub_cancel_right] at hsub
  obtain ⟨hu₁, hu₂⟩ := hFiltration w hw
  refine ⟨hu₁, hu₂, ?_⟩
  rw [mul_assoc, mul_assoc]
  exact (hψ_bridge (b * (2 * u₁_fn w - (u₁_fn w) ^ 2)) (a * (2 * u₂_fn w - (u₂_fn w) ^ 2))).mpr
    hStage3

theorem ld_wild_odd_upper_edge_jump_eq_and_level_t_coset_gen (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hBK₁ : B ≤ K₁)
    (hp_prime : Nat.Prime (p F))
    (hvalB_props : valL F B 0 = 0 ∧ valL F B 1 = 0 ∧ valL F B (-1) = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B)) ∧
      (∀ m : ℤ, ∃ c : Bˣ, valL F B (c : B) = m) ∧
      (∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x + y = 0 ∨ k ≤ valL F B (x + y))) ∧
      (∀ u : Bˣ, u ∈ unitGroup F B 0 ↔ valL F B (u : B) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Bˣ,
        u ∈ unitGroup F B a ↔ ((u : B) = 1 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1))) ∧
      (∀ (a : ℕ) (u : Bˣ), u ∈ unitGroup F B a → valL F B (u : B) = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_BK₁ : ∀ y : B,
      valL F K₁ (IntermediateField.inclusion hBK₁ y) =
        (Module.finrank B (IntermediateField.extendScalars hBK₁) : ℤ) * valL F B y)
    (ϖ_K₁ : K₁ˣ) (ϖ_B : Bˣ)
    (hϖ_norm : Units.map (normLM F hBK₁) ϖ_K₁ = ϖ_B)
    (hϖ_K₁ : valL F K₁ (ϖ_K₁ : K₁) = 1)
    (hϖ_B : valL F B (ϖ_B : B) = 1)
    (k_B : Type u) [Field k_B] [Fintype k_B] (resB : B → k_B)
    (hresB_0 : resB 0 = 0) (hresB_1 : resB 1 = 1)
    (hresB_ring : ∀ x₁ x₂ : B, (x₁ = 0 ∨ 0 ≤ valL F B x₁) → (x₂ = 0 ∨ 0 ≤ valL F B x₂) →
      resB (x₁ + x₂) = resB x₁ + resB x₂ ∧
      resB (x₁ * x₂) = resB x₁ * resB x₂ ∧
      resB (-x₁) = -resB x₁)
    (hresB_ker : ∀ x : B, (x = 0 ∨ 0 ≤ valL F B x) → (resB x = 0 ↔ (x = 0 ∨ 1 ≤ valL F B x)))
    (hresB_surj : ∀ a : k_B, ∃ x : B, (x = 0 ∨ 0 ≤ valL F B x) ∧ resB x = a)
    (hp_char : ((p F : ℕ) : k_B) = 0)
    (u t : ℕ) (hu_ge1 : 1 ≤ u) (ht_ge1 : 1 ≤ t)
    (ξ : Bˣ →* (Ω F)ˣ)
    (hξ_cond : condExp F B ξ = t + 1)
    (hξ_triv : ∀ v ∈ unitGroup F B (t + 1), ξ v = 1)
    (hξ_norm : ∀ w : K₁ˣ, ξ (Units.map (normLM F hBK₁) w) = 1)
    (hnorm_surj_lt : ∀ m < u, ∀ v ∈ unitGroup F B m,
      ∃ w ∈ unitGroup F K₁ m,
        (Units.map (normLM F hBK₁) w) * v⁻¹ ∈ unitGroup F B (m + 1))
    (hnorm_gt_surj : ∀ r ≥ u + 1, ∀ v ∈ unitGroup F B r,
      ∃ w ∈ unitGroup F K₁ (u + (p F) * (r - u)),
        (Units.map (normLM F hBK₁) w) * v⁻¹ ∈ unitGroup F B (r + 1))
    (b_tr : B) (hb_tr_val : b_tr = 0 ∨ 0 ≤ valL F B b_tr)
    (hP_norm_u : ∀ s : B, (s = 0 ∨ 0 ≤ valL F B s) →
      normLM F hBK₁ (1 + IntermediateField.inclusion hBK₁ s * ((ϖ_K₁ ^ u : K₁ˣ) : K₁)) -
        (1 + (s ^ (p F) + b_tr * s) * ((ϖ_B ^ u : Bˣ) : B)) = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B
          (normLM F hBK₁ (1 + IntermediateField.inclusion hBK₁ s * ((ϖ_K₁ ^ u : K₁ˣ) : K₁)) -
            (1 + (s ^ (p F) + b_tr * s) * ((ϖ_B ^ u : Bˣ) : B))))
    (hAS_coker : ∀ b₀ : k_B, ∃ a₁ : k_B, ∀ c : k_B, ∃ (e₀ : Fin (p F)) (a : k_B),
      c = ((e₀ : ℕ) : k_B) * a₁ + (a ^ (p F) + b₀ * a)) :
    u = t ∧
    ∃ g₀ : Bˣ,
      g₀ ∈ unitGroup F B t ∧
      g₀ ^ (p F) ∈ unitGroup F B (t + 1) ∧
      (∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
        ∃ w_p ∈ unitGroup F K₁ d,
          g₀ ^ (p F) * (Units.map (normLM F hBK₁) w_p)⁻¹ ∈ unitGroup F B m) ∧
      (∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
        ∀ v ∈ unitGroup F B d,
          ∃ (e₀ : Fin (p F)) (w : K₁ˣ),
            w ∈ unitGroup F K₁ d ∧
            v * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B m) ∧
      (∀ y : Bˣ,
        ∃ (e₀ : Fin (p F)) (w : K₁ˣ),
          y * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B (t + 1)) :=
by
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, _, hval_add,
      hmem_u0, hmem_ua, hval_u0⟩ := hvalB_props
  obtain ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁, _, hval_add_K₁,
      hmem_u0_K₁, hmem_ua_K₁, hval_u0_K₁⟩ := hvalK₁_props
  let N : K₁ˣ →* Bˣ := Units.map (normLM F hBK₁)

  
  have hdesc_step : ∀ r ≥ u + 1,
      (∀ v ∈ unitGroup F B (r + 1), ξ v = 1) →
      (∀ v ∈ unitGroup F B r, ξ v = 1) := by
    intro r hr htriv_r1 v₀ hv₀
    obtain ⟨w, _, hmem⟩ := hnorm_gt_surj r hr v₀ hv₀
    set v : Bˣ := N w * v₀⁻¹
    have hv₀_eq : v₀ = v⁻¹ * N w := by
      dsimp only [v]
      rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
    rw [hv₀_eq, map_mul, map_inv, htriv_r1 v hmem, inv_one, hξ_norm w, mul_one]

  have hdesc_ind : ∀ k : ℕ,
      (∀ v ∈ unitGroup F B (u + 1 + k), ξ v = 1) →
      (∀ v ∈ unitGroup F B (u + 1), ξ v = 1) := by
    intro k
    induction k with
    | zero =>
      intro h
      simpa using h
    | succ k ih =>
      intro h
      apply ih
      apply hdesc_step (u + 1 + k) (by omega)
      simpa [Nat.add_assoc] using h

  have ht_le_u : t ≤ u := by
    by_contra h_gt
    have h_triv_u1 : ∀ v ∈ unitGroup F B (u + 1), ξ v = 1 := by
      apply hdesc_ind (t - u)
      have heq : u + 1 + (t - u) = t + 1 := by omega
      rw [heq]
      exact hξ_triv
    have hmem_u1 : u + 1 ∈ {a : ℕ | ∀ v ∈ unitGroup F B a, ξ v = 1} := h_triv_u1
    have hle : condExp F B ξ ≤ u + 1 := Nat.sInf_le hmem_u1
    omega

  have hu_le_t : u ≤ t := by
    by_contra h_lt
    have h_triv_t : ∀ v₀ ∈ unitGroup F B t, ξ v₀ = 1 := by
      intro v₀ hv₀
      obtain ⟨w, _, hmem⟩ := hnorm_surj_lt t (by omega) v₀ hv₀
      set v : Bˣ := N w * v₀⁻¹
      have hv₀_eq : v₀ = v⁻¹ * N w := by
        dsimp only [v]
        rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
      rw [hv₀_eq, map_mul, map_inv, hξ_triv v hmem, inv_one, hξ_norm w, mul_one]
    have hmem_t : t ∈ {a : ℕ | ∀ v ∈ unitGroup F B a, ξ v = 1} := h_triv_t
    have hle : condExp F B ξ ≤ t := Nat.sInf_le hmem_t
    omega

  have hu_eq_t : u = t := le_antisymm hu_le_t ht_le_u
  subst hu_eq_t
  refine ⟨rfl, ?_⟩

  
  have hunit_anti_B : ∀ {a b : ℕ}, a ≤ b → ∀ {v : Bˣ},
      v ∈ unitGroup F B b → v ∈ unitGroup F B a := by
    intro a b hab v hv
    rcases Nat.eq_zero_or_pos a with rfl | ha
    · exact (hmem_u0 v).mpr (hval_u0 b v hv)
    · have hb : 1 ≤ b := le_trans ha hab
      rw [hmem_ua a ha]
      rcases (hmem_ua b hb v).mp hv with hv1 | hvb
      · exact Or.inl hv1
      · exact Or.inr (le_trans (by exact_mod_cast hab) hvb)

  have hunit_anti_K₁ : ∀ {a b : ℕ}, a ≤ b → ∀ {w : K₁ˣ},
      w ∈ unitGroup F K₁ b → w ∈ unitGroup F K₁ a := by
    intro a b hab w hw
    rcases Nat.eq_zero_or_pos a with rfl | ha
    · exact (hmem_u0_K₁ w).mpr (hval_u0_K₁ b w hw)
    · have hb : 1 ≤ b := le_trans ha hab
      rw [hmem_ua_K₁ a ha]
      rcases (hmem_ua_K₁ b hb w).mp hw with hw1 | hwb
      · exact Or.inl hw1
      · exact Or.inr (le_trans (by exact_mod_cast hab) hwb)

  have hval_neg_ge_B : ∀ {k : ℤ} {x : B},
      (x = 0 ∨ k ≤ valL F B x) → (-x = 0 ∨ k ≤ valL F B (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right; rwa [hval_neg]

  have hval_sub_B : ∀ (k : ℤ) (x y : B),
      (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
        (x - y = 0 ∨ k ≤ valL F B (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add k x (-y) hx (hval_neg_ge_B hy)

  have hval_mul_ge_B : ∀ {k₁ k₂ : ℤ} {x y : B},
      (x = 0 ∨ k₁ ≤ valL F B x) → (y = 0 ∨ k₂ ≤ valL F B y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F B (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul x y hx0 hy0]
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        omega

  have hval_mul_ge_K₁ : ∀ {k₁ k₂ : ℤ} {x y : K₁},
      (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul_K₁ x y hx0 hy0]
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        omega

  have hval_pow_B : ∀ (v : Bˣ) (n : ℕ),
      valL F B ((v ^ n : Bˣ) : B) = (n : ℤ) * valL F B (v : B) := by
    intro v n
    induction n with
    | zero => simp [hval1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast; ring

  have hval_zpow_B : ∀ (v : Bˣ) (m : ℤ),
      valL F B ((v ^ m : Bˣ) : B) = m * valL F B (v : B) := by
    intro v m
    cases m with
    | ofNat n =>
      change valL F B ((v ^ (n : ℤ) : Bˣ) : B) = (n : ℤ) * valL F B (v : B)
      rw [zpow_natCast, hval_pow_B]
    | negSucc n =>
      rw [zpow_negSucc, hval_inv (v ^ (n + 1)), hval_pow_B v (n + 1), Int.negSucc_eq]
      push_cast; ring

  have hval_pow_K₁ : ∀ (w : K₁ˣ) (n : ℕ),
      valL F K₁ ((w ^ n : K₁ˣ) : K₁) = (n : ℤ) * valL F K₁ (w : K₁) := by
    intro w n
    induction n with
    | zero => simp [hval1_K₁]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hval_mul_K₁ _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast; ring

  set πB_t : B := ((ϖ_B ^ u : Bˣ) : B)
  set πK₁_t : K₁ := ((ϖ_K₁ ^ u : K₁ˣ) : K₁)
  have hπB_t_val : valL F B πB_t = (u : ℤ) := by
    dsimp only [πB_t]
    rw [hval_pow_B ϖ_B u, hϖ_B, mul_one]
  have hπB_t_inv_val : valL F B (((ϖ_B ^ u)⁻¹ : Bˣ) : B) = -(u : ℤ) := by
    rw [hval_inv (ϖ_B ^ u), hπB_t_val]
  have hπB_t_ge : πB_t = 0 ∨ (u : ℤ) ≤ valL F B πB_t :=
    Or.inr (le_of_eq hπB_t_val.symm)
  have hπB_t_ge0 : πB_t = 0 ∨ 0 ≤ valL F B πB_t :=
    Or.inr (by omega)
  have hπB_t_sq_ge : πB_t * πB_t = 0 ∨ ((u + 1 : ℕ) : ℤ) ≤ valL F B (πB_t * πB_t) := by
    rcases hval_mul_ge_B hπB_t_ge hπB_t_ge with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)

  have hπK₁_t_val : valL F K₁ πK₁_t = (u : ℤ) := by
    dsimp only [πK₁_t]
    rw [hval_pow_K₁ ϖ_K₁ u, hϖ_K₁, mul_one]
  have hπK₁_t_ge : πK₁_t = 0 ∨ (u : ℤ) ≤ valL F K₁ πK₁_t :=
    Or.inr (le_of_eq hπK₁_t_val.symm)

  have h1_int_B : (1 : B) = 0 ∨ 0 ≤ valL F B (1 : B) :=
    Or.inr (le_of_eq hval1.symm)

  have hnat_val_B : ∀ n : ℕ, (n : B) = 0 ∨ 0 ≤ valL F B (n : B) := by
    intro n
    induction n with
    | zero => left; simp
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add 0 (n : B) 1 ih h1_int_B

  have hpow_val_B : ∀ (s : B), (s = 0 ∨ 0 ≤ valL F B s) →
      ∀ n : ℕ, (s ^ n = 0 ∨ 0 ≤ valL F B (s ^ n)) := by
    intro s hs n
    induction n with
    | zero => rw [pow_zero]; exact h1_int_B
    | succ n ih =>
      rw [pow_succ]
      rcases hval_mul_ge_B ih hs with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)

  have hresB_sub : ∀ x₁ x₂ : B, (x₁ = 0 ∨ 0 ≤ valL F B x₁) → (x₂ = 0 ∨ 0 ≤ valL F B x₂) →
      resB (x₁ - x₂) = resB x₁ - resB x₂ := by
    intro x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg, (hresB_ring x₁ (-x₂) hx₁ (hval_neg_ge_B hx₂)).1,
      (hresB_ring x₂ x₂ hx₂ hx₂).2.2, ← sub_eq_add_neg]

  have hresB_nat : ∀ n : ℕ, resB (n : B) = (n : k_B) := by
    intro n
    induction n with
    | zero => simp [hresB_0]
    | succ n ih =>
      rw [Nat.cast_succ, (hresB_ring (n : B) 1 (hnat_val_B n) h1_int_B).1,
        ih, hresB_1, Nat.cast_succ]

  have hresB_pow : ∀ (s : B), (s = 0 ∨ 0 ≤ valL F B s) →
      ∀ n : ℕ, resB (s ^ n) = (resB s) ^ n := by
    intro s hs n
    induction n with
    | zero => simp [hresB_1]
    | succ n ih =>
      rw [pow_succ, (hresB_ring (s ^ n) s (hpow_val_B s hs n) hs).2.1, ih, pow_succ]

  have hmk_unit_B : ∀ (m : ℕ), 1 ≤ m → ∀ z : B, (z = 0 ∨ (m : ℤ) ≤ valL F B z) →
      ∃ v : Bˣ, (v : B) = 1 + z ∧ v ∈ unitGroup F B m := by
    intro m hm z hz
    have h1z : 1 + z ≠ 0 := by
      intro h0
      have hz_eq : z = -1 := eq_neg_of_add_eq_zero_right h0
      have hz_ne0 : z ≠ 0 := by rw [hz_eq]; exact neg_ne_zero.mpr one_ne_zero
      have hge : (m : ℤ) ≤ valL F B z := hz.resolve_left hz_ne0
      rw [hz_eq, hval_neg1] at hge
      omega
    let v : Bˣ := Units.mk0 (1 + z) h1z
    refine ⟨v, rfl, (hmem_ua m hm v).mpr ?_⟩
    have hsub : (v : B) - 1 = z := by change (1 + z) - 1 = z; ring
    rw [hsub]
    rcases hz with rfl | hz
    · left; change 1 + (0 : B) = 1; ring
    · exact Or.inr hz

  have hmk_unit_K₁ : ∀ (m : ℕ), 1 ≤ m → ∀ z : K₁, (z = 0 ∨ (m : ℤ) ≤ valL F K₁ z) →
      ∃ w : K₁ˣ, (w : K₁) = 1 + z ∧ w ∈ unitGroup F K₁ m := by
    intro m hm z hz
    have h1z : 1 + z ≠ 0 := by
      intro h0
      have hz_eq : z = -1 := eq_neg_of_add_eq_zero_right h0
      have hz_ne0 : z ≠ 0 := by rw [hz_eq]; exact neg_ne_zero.mpr one_ne_zero
      have hge : (m : ℤ) ≤ valL F K₁ z := hz.resolve_left hz_ne0
      rw [hz_eq, hval_neg1_K₁] at hge
      omega
    let w : K₁ˣ := Units.mk0 (1 + z) h1z
    refine ⟨w, rfl, (hmem_ua_K₁ m hm w).mpr ?_⟩
    have hsub : (w : K₁) - 1 = z := by change (1 + z) - 1 = z; ring
    rw [hsub]
    rcases hz with rfl | hz
    · left; change 1 + (0 : K₁) = 1; ring
    · exact Or.inr hz

  have hcong_to_unit_B : ∀ (m : ℕ), 1 ≤ m → ∀ u₁ u₂ : Bˣ,
      valL F B (u₂ : B) = 0 →
      ((u₁ : B) - (u₂ : B) = 0 ∨ (m : ℤ) ≤ valL F B ((u₁ : B) - (u₂ : B))) →
      u₁ * u₂⁻¹ ∈ unitGroup F B m := by
    intro m hm u₁ u₂ hu₂_val hdiff
    rw [hmem_ua m hm (u₁ * u₂⁻¹)]
    have hsub : ((u₁ * u₂⁻¹ : Bˣ) : B) - 1 =
        ((u₁ : B) - (u₂ : B)) * ((u₂⁻¹ : Bˣ) : B) := by
      calc ((u₁ * u₂⁻¹ : Bˣ) : B) - 1
        _ = (u₁ : B) * ((u₂⁻¹ : Bˣ) : B) - (u₂ : B) * ((u₂⁻¹ : Bˣ) : B) := by
          rw [Units.val_mul, Units.mul_inv]
        _ = ((u₁ : B) - (u₂ : B)) * ((u₂⁻¹ : Bˣ) : B) := by ring
    have hu₂_inv_val : valL F B ((u₂⁻¹ : Bˣ) : B) = 0 := by
      rw [hval_inv u₂, hu₂_val, neg_zero]
    have hprod := hval_mul_ge_B hdiff (Or.inr (le_of_eq hu₂_inv_val.symm))
    rw [add_zero, ← hsub] at hprod
    rcases hprod with h0 | hle
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hle

  
  have h_below_t_d : ∀ (d k : ℕ), d + k ≤ u → ∀ v ∈ unitGroup F B d,
      ∃ w₁ ∈ unitGroup F K₁ d, v * (N w₁)⁻¹ ∈ unitGroup F B (d + k) := by
    intro d k
    induction k with
    | zero =>
      intro _ v hv
      refine ⟨1, Subgroup.one_mem _, ?_⟩
      simpa using hv
    | succ k ih =>
      intro hdk v hv
      obtain ⟨w₁, hw₁_d, hv_dk⟩ := ih (by omega) v hv
      set v_m : Bˣ := v * (N w₁)⁻¹
      obtain ⟨w', hw'_dk, hw'_step⟩ := hnorm_surj_lt (d + k) (by omega) v_m hv_dk
      have hw'_d : w' ∈ unitGroup F K₁ d := hunit_anti_K₁ (by omega) hw'_dk
      refine ⟨w₁ * w', (unitGroup F K₁ d).mul_mem hw₁_d hw'_d, ?_⟩
      have h_inv : (N w' * v_m⁻¹)⁻¹ ∈ unitGroup F B (d + (k + 1)) := by
        simpa [Nat.add_assoc] using (unitGroup F B (d + k + 1)).inv_mem hw'_step
      have h_eq : (N w' * v_m⁻¹)⁻¹ = v * (N (w₁ * w'))⁻¹ := by
        dsimp only [v_m]
        rw [map_mul, mul_inv_rev, inv_inv, mul_assoc, ← mul_inv]
      rwa [← h_eq]

  have h_above_t1 : ∀ k : ℕ, ∀ v ∈ unitGroup F B (u + 1),
      ∃ w₂ ∈ unitGroup F K₁ (u + 1), v * (N w₂)⁻¹ ∈ unitGroup F B (u + 1 + k) := by
    intro k
    induction k with
    | zero =>
      intro v hv
      refine ⟨1, Subgroup.one_mem _, ?_⟩
      simpa using hv
    | succ k ih =>
      intro v hv
      obtain ⟨w₂, hw₂_t1, hv_k⟩ := ih v hv
      set v_k : Bˣ := v * (N w₂)⁻¹
      obtain ⟨w', hw'_mem, hw'_step⟩ := hnorm_gt_surj (u + 1 + k) (by omega) v_k hv_k
      have hp_pos : 0 < p F := hp_prime.pos
      have h_idx_ge : u + 1 ≤ u + p F * (u + 1 + k - u) := by
        have hsub : u + 1 + k - u = k + 1 := by omega
        rw [hsub]
        have hmul : 1 ≤ p F * (k + 1) := Nat.mul_pos hp_pos (Nat.succ_pos k)
        omega
      have hw'_t1 : w' ∈ unitGroup F K₁ (u + 1) := hunit_anti_K₁ h_idx_ge hw'_mem
      refine ⟨w₂ * w', (unitGroup F K₁ (u + 1)).mul_mem hw₂_t1 hw'_t1, ?_⟩
      have h_inv : (N w' * v_k⁻¹)⁻¹ ∈ unitGroup F B (u + 1 + (k + 1)) := by
        simpa [Nat.add_assoc] using (unitGroup F B (u + 1 + k + 1)).inv_mem hw'_step
      have h_eq : (N w' * v_k⁻¹)⁻¹ = v * (N (w₂ * w'))⁻¹ := by
        dsimp only [v_k]
        rw [map_mul, mul_inv_rev, inv_inv, mul_assoc, ← mul_inv]
      rwa [← h_eq]

  
  let b₀ : k_B := resB b_tr
  obtain ⟨a₁, ha₁⟩ := hAS_coker b₀
  obtain ⟨x₁, hx₁_val, hx₁_res⟩ := hresB_surj a₁
  have hx₁_π_val : x₁ * πB_t = 0 ∨ (u : ℤ) ≤ valL F B (x₁ * πB_t) := by
    rcases hval_mul_ge_B hx₁_val hπB_t_ge with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)
  obtain ⟨g₀, hg₀_val, hg₀_mem⟩ := hmk_unit_B u hu_ge1 (x₁ * πB_t) hx₁_π_val
  have hg₀_val0 : valL F B (g₀ : B) = 0 := hval_u0 u g₀ hg₀_mem
  have hg₀_pow_mem : ∀ n : ℕ, g₀ ^ n ∈ unitGroup F B u :=
    fun n => (unitGroup F B u).pow_mem hg₀_mem n
  have hg₀_pow_val0 : ∀ n : ℕ, valL F B ((g₀ ^ n : Bˣ) : B) = 0 :=
    fun n => hval_u0 u (g₀ ^ n) (hg₀_pow_mem n)

  have hg₀_pow : ∀ n : ℕ,
      ((g₀ ^ n : Bˣ) : B) - (1 + (n : B) * x₁ * πB_t) = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B (((g₀ ^ n : Bˣ) : B) - (1 + (n : B) * x₁ * πB_t)) := by
    intro n
    induction n with
    | zero => left; simp
    | succ n ih =>
      set D_n : B := ((g₀ ^ n : Bˣ) : B) - (1 + (n : B) * x₁ * πB_t)
      have h_id : ((g₀ ^ (n + 1) : Bˣ) : B) - (1 + ((n + 1 : ℕ) : B) * x₁ * πB_t) =
          D_n * (g₀ : B) + ((n : B) * x₁ * x₁) * (πB_t * πB_t) := by
        dsimp only [D_n]
        rw [pow_succ, Units.val_mul, hg₀_val]
        push_cast; ring
      rw [h_id]
      have hterm1 : D_n * (g₀ : B) = 0 ∨ ((u + 1 : ℕ) : ℤ) ≤ valL F B (D_n * (g₀ : B)) := by
        rcases hval_mul_ge_B ih (Or.inr (le_of_eq hg₀_val0.symm)) with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hnx₁ : (n : B) * x₁ = 0 ∨ 0 ≤ valL F B ((n : B) * x₁) := by
        rcases hval_mul_ge_B (hnat_val_B n) hx₁_val with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hnx₁_sq : (n : B) * x₁ * x₁ = 0 ∨ 0 ≤ valL F B ((n : B) * x₁ * x₁) := by
        rcases hval_mul_ge_B hnx₁ hx₁_val with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hterm2 : ((n : B) * x₁ * x₁) * (πB_t * πB_t) = 0 ∨
          ((u + 1 : ℕ) : ℤ) ≤ valL F B (((n : B) * x₁ * x₁) * (πB_t * πB_t)) := by
        rcases hval_mul_ge_B hnx₁_sq hπB_t_sq_ge with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      exact hval_add ((u + 1 : ℕ) : ℤ) _ _ hterm1 hterm2

  have hg₀_pow_pF : g₀ ^ (p F) ∈ unitGroup F B (u + 1) := by
    have hp_res0 : resB ((p F : ℕ) : B) = 0 := by
      rw [hresB_nat (p F), hp_char]
    have hp_val1 : ((p F : ℕ) : B) = 0 ∨ 1 ≤ valL F B ((p F : ℕ) : B) :=
      (hresB_ker ((p F : ℕ) : B) (hnat_val_B (p F))).mp hp_res0
    have hpx₁_val1 : ((p F : ℕ) : B) * x₁ = 0 ∨ 1 ≤ valL F B (((p F : ℕ) : B) * x₁) := by
      rcases hval_mul_ge_B hp_val1 hx₁_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hpx₁π_val : ((p F : ℕ) : B) * x₁ * πB_t = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B (((p F : ℕ) : B) * x₁ * πB_t) := by
      rcases hval_mul_ge_B hpx₁_val1 hπB_t_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hdiff := hval_add ((u + 1 : ℕ) : ℤ)
      (((g₀ ^ (p F) : Bˣ) : B) - (1 + ((p F : ℕ) : B) * x₁ * πB_t))
      (((p F : ℕ) : B) * x₁ * πB_t)
      (hg₀_pow (p F)) hpx₁π_val
    have hid : (((g₀ ^ (p F) : Bˣ) : B) - (1 + ((p F : ℕ) : B) * x₁ * πB_t)) +
        (((p F : ℕ) : B) * x₁ * πB_t) = ((g₀ ^ (p F) : Bˣ) : B) - 1 := by ring
    rw [hid] at hdiff
    rw [hmem_ua (u + 1) (by omega) (g₀ ^ (p F))]
    rcases hdiff with h0 | hle
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hle

  
  have hprod_approx : ∀ (n : ℕ) (s : B), (s = 0 ∨ 0 ≤ valL F B s) →
      ∃ w_s : K₁ˣ,
        w_s ∈ unitGroup F K₁ u ∧
        N w_s ∈ unitGroup F B u ∧
        (((g₀ ^ n * N w_s : Bˣ) : B) - (1 + ((n : B) * x₁ + (s ^ (p F) + b_tr * s)) * πB_t) = 0 ∨
          ((u + 1 : ℕ) : ℤ) ≤ valL F B
            (((g₀ ^ n * N w_s : Bˣ) : B) - (1 + ((n : B) * x₁ + (s ^ (p F) + b_tr * s)) * πB_t))) := by
    intro n s hs
    have hs_K₁ : IntermediateField.inclusion hBK₁ s = 0 ∨
        0 ≤ valL F K₁ (IntermediateField.inclusion hBK₁ s) := by
      rcases hs with rfl | hs_ge0
      · left; simp
      · right
        rw [hval_BK₁ s]
        exact mul_nonneg (Nat.cast_nonneg _) hs_ge0
    have hsπ_K₁ : IntermediateField.inclusion hBK₁ s * πK₁_t = 0 ∨
        (u : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hBK₁ s * πK₁_t) := by
      rcases hval_mul_ge_K₁ hs_K₁ hπK₁_t_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    obtain ⟨w_s, hw_s_coe, hw_s_mem⟩ :=
      hmk_unit_K₁ u hu_ge1 (IntermediateField.inclusion hBK₁ s * πK₁_t) hsπ_K₁
    set Q_s : B := s ^ (p F) + b_tr * s
    have hbs : b_tr * s = 0 ∨ 0 ≤ valL F B (b_tr * s) := by
      rcases hval_mul_ge_B hb_tr_val hs with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hQ_s_val : Q_s = 0 ∨ 0 ≤ valL F B Q_s :=
      hval_add 0 (s ^ (p F)) (b_tr * s) (hpow_val_B s hs (p F)) hbs
    set R_s : B := normLM F hBK₁ (w_s : K₁) - (1 + Q_s * πB_t)
    have hR_s_val : R_s = 0 ∨ ((u + 1 : ℕ) : ℤ) ≤ valL F B R_s := by
      dsimp only [R_s]
      rw [hw_s_coe]
      exact hP_norm_u s hs
    have hQπ_val : Q_s * πB_t = 0 ∨ (u : ℤ) ≤ valL F B (Q_s * πB_t) := by
      rcases hval_mul_ge_B hQ_s_val hπB_t_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hQR_val : Q_s * πB_t + R_s = 0 ∨ (u : ℤ) ≤ valL F B (Q_s * πB_t + R_s) := by
      have hR_t : R_s = 0 ∨ (u : ℤ) ≤ valL F B R_s := by
        rcases hR_s_val with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      exact hval_add (u : ℤ) (Q_s * πB_t) R_s hQπ_val hR_t
    obtain ⟨u_Ns, hu_Ns_val, hu_Ns_mem⟩ := hmk_unit_B u hu_ge1 (Q_s * πB_t + R_s) hQR_val
    have hN_ws_coe : ((N w_s : Bˣ) : B) = normLM F hBK₁ (w_s : K₁) := rfl
    have hnorm_ys_eq : normLM F hBK₁ (w_s : K₁) = (u_Ns : B) := by
      rw [hu_Ns_val]
      dsimp only [R_s]
      ring
    have hN_ws_eq : N w_s = u_Ns := Units.ext (by rw [hN_ws_coe, hnorm_ys_eq])
    have hN_ws_mem : N w_s ∈ unitGroup F B u := by rwa [hN_ws_eq]
    have hN_ws_val0 : valL F B ((N w_s : Bˣ) : B) = 0 := hval_u0 u (N w_s) hN_ws_mem
    refine ⟨w_s, hw_s_mem, hN_ws_mem, ?_⟩
    set D_n : B := ((g₀ ^ n : Bˣ) : B) - (1 + (n : B) * x₁ * πB_t)
    have h_id : ((g₀ ^ n * N w_s : Bˣ) : B) - (1 + ((n : B) * x₁ + Q_s) * πB_t) =
        D_n * ((N w_s : Bˣ) : B) + (1 + (n : B) * x₁ * πB_t) * R_s +
          ((n : B) * x₁ * Q_s) * (πB_t * πB_t) := by
      dsimp only [D_n, R_s]
      rw [Units.val_mul, hN_ws_coe]
      ring
    rw [h_id]
    have hterm1 : D_n * ((N w_s : Bˣ) : B) = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B (D_n * ((N w_s : Bˣ) : B)) := by
      dsimp only [D_n]
      rcases hval_mul_ge_B (hg₀_pow n) (Or.inr (le_of_eq hN_ws_val0.symm)) with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hnx₁ : (n : B) * x₁ = 0 ∨ 0 ≤ valL F B ((n : B) * x₁) := by
      rcases hval_mul_ge_B (hnat_val_B n) hx₁_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hnx₁π : (n : B) * x₁ * πB_t = 0 ∨ 0 ≤ valL F B ((n : B) * x₁ * πB_t) := by
      rcases hval_mul_ge_B hnx₁ hπB_t_ge0 with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have h1nx₁π : 1 + (n : B) * x₁ * πB_t = 0 ∨ 0 ≤ valL F B (1 + (n : B) * x₁ * πB_t) :=
      hval_add 0 1 ((n : B) * x₁ * πB_t) h1_int_B hnx₁π
    have hterm2 : (1 + (n : B) * x₁ * πB_t) * R_s = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B ((1 + (n : B) * x₁ * πB_t) * R_s) := by
      rcases hval_mul_ge_B h1nx₁π hR_s_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hnx₁Q : (n : B) * x₁ * Q_s = 0 ∨ 0 ≤ valL F B ((n : B) * x₁ * Q_s) := by
      rcases hval_mul_ge_B hnx₁ hQ_s_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hterm3 : ((n : B) * x₁ * Q_s) * (πB_t * πB_t) = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B (((n : B) * x₁ * Q_s) * (πB_t * πB_t)) := by
      rcases hval_mul_ge_B hnx₁Q hπB_t_sq_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    exact hval_add ((u + 1 : ℕ) : ℤ) _ _
      (hval_add ((u + 1 : ℕ) : ℤ) _ _ hterm1 hterm2) hterm3

  have h_level_t : ∀ u_t ∈ unitGroup F B u,
      ∃ (e₀ : Fin (p F)) (w_s : K₁ˣ),
        w_s ∈ unitGroup F K₁ u ∧
        u_t * (g₀ ^ (e₀ : ℕ) * N w_s)⁻¹ ∈ unitGroup F B (u + 1) := by
    intro u_t hu_t
    have hu_t_sub : (u_t : B) - 1 = 0 ∨ (u : ℤ) ≤ valL F B ((u_t : B) - 1) := by
      rcases (hmem_ua u hu_ge1 u_t).mp hu_t with hu1 | hle
      · exact Or.inl (sub_eq_zero.mpr hu1)
      · exact Or.inr hle
    set z_t : B := ((u_t : B) - 1) * (((ϖ_B ^ u)⁻¹ : Bˣ) : B)
    have hz_t_val : z_t = 0 ∨ 0 ≤ valL F B z_t := by
      dsimp only [z_t]
      rcases hval_mul_ge_B hu_t_sub (Or.inr (le_of_eq hπB_t_inv_val.symm)) with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hu_t_decomp : (u_t : B) = 1 + z_t * πB_t := by
      dsimp only [z_t, πB_t]
      rw [mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one, add_sub_cancel]
    obtain ⟨e₀, a, hc_eq⟩ := ha₁ (resB z_t)
    obtain ⟨s, hs_val, hs_res⟩ := hresB_surj a
    obtain ⟨w_s, hw_s_mem_K₁, hw_s_mem, h_approx⟩ := hprod_approx (e₀ : ℕ) s hs_val
    refine ⟨e₀, w_s, hw_s_mem_K₁, ?_⟩
    set Q_s : B := s ^ (p F) + b_tr * s
    have hbs : b_tr * s = 0 ∨ 0 ≤ valL F B (b_tr * s) := by
      rcases hval_mul_ge_B hb_tr_val hs_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hQ_s_val : Q_s = 0 ∨ 0 ≤ valL F B Q_s :=
      hval_add 0 (s ^ (p F)) (b_tr * s) (hpow_val_B s hs_val (p F)) hbs
    have he₀x₁_val : ((e₀ : ℕ) : B) * x₁ = 0 ∨ 0 ≤ valL F B (((e₀ : ℕ) : B) * x₁) := by
      rcases hval_mul_ge_B (hnat_val_B (e₀ : ℕ)) hx₁_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_val : ((e₀ : ℕ) : B) * x₁ + Q_s = 0 ∨ 0 ≤ valL F B (((e₀ : ℕ) : B) * x₁ + Q_s) :=
      hval_add 0 (((e₀ : ℕ) : B) * x₁) Q_s he₀x₁_val hQ_s_val
    set δ : B := z_t - (((e₀ : ℕ) : B) * x₁ + Q_s)
    have hδ_int : δ = 0 ∨ 0 ≤ valL F B δ := hval_sub_B 0 z_t _ hz_t_val hsum_val
    have hδ_res : resB δ = 0 := by
      dsimp only [δ, Q_s]
      rw [hresB_sub z_t _ hz_t_val hsum_val,
        (hresB_ring (((e₀ : ℕ) : B) * x₁) (s ^ (p F) + b_tr * s) he₀x₁_val hQ_s_val).1,
        (hresB_ring ((e₀ : ℕ) : B) x₁ (hnat_val_B (e₀ : ℕ)) hx₁_val).2.1,
        (hresB_ring (s ^ (p F)) (b_tr * s) (hpow_val_B s hs_val (p F)) hbs).1,
        (hresB_ring b_tr s hb_tr_val hs_val).2.1,
        hresB_nat (e₀ : ℕ), hx₁_res, hresB_pow s hs_val (p F), hs_res]
      exact sub_eq_zero.mpr hc_eq
    have hδ_val1 : δ = 0 ∨ 1 ≤ valL F B δ := (hresB_ker δ hδ_int).mp hδ_res
    have hδπ_val : δ * πB_t = 0 ∨ ((u + 1 : ℕ) : ℤ) ≤ valL F B (δ * πB_t) := by
      rcases hval_mul_ge_B hδ_val1 hπB_t_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hu_t_approx : (u_t : B) - (1 + (((e₀ : ℕ) : B) * x₁ + Q_s) * πB_t) = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B ((u_t : B) - (1 + (((e₀ : ℕ) : B) * x₁ + Q_s) * πB_t)) := by
      have hid : (u_t : B) - (1 + (((e₀ : ℕ) : B) * x₁ + Q_s) * πB_t) = δ * πB_t := by
        rw [hu_t_decomp]; dsimp only [δ]; ring
      rwa [hid]
    have hdiff_u : (u_t : B) - ((g₀ ^ (e₀ : ℕ) * N w_s : Bˣ) : B) = 0 ∨
        ((u + 1 : ℕ) : ℤ) ≤ valL F B ((u_t : B) - ((g₀ ^ (e₀ : ℕ) * N w_s : Bˣ) : B)) := by
      have hid : (u_t : B) - ((g₀ ^ (e₀ : ℕ) * N w_s : Bˣ) : B) =
          ((u_t : B) - (1 + (((e₀ : ℕ) : B) * x₁ + Q_s) * πB_t)) -
            (((g₀ ^ (e₀ : ℕ) * N w_s : Bˣ) : B) - (1 + (((e₀ : ℕ) : B) * x₁ + Q_s) * πB_t)) := by
        ring
      rw [hid]
      exact hval_sub_B ((u + 1 : ℕ) : ℤ) _ _ hu_t_approx h_approx
    have hprod_mem_t : g₀ ^ (e₀ : ℕ) * N w_s ∈ unitGroup F B u :=
      (unitGroup F B u).mul_mem (hg₀_pow_mem (e₀ : ℕ)) hw_s_mem
    have hprod_val0 : valL F B ((g₀ ^ (e₀ : ℕ) * N w_s : Bˣ) : B) = 0 :=
      hval_u0 u _ hprod_mem_t
    exact hcong_to_unit_B (u + 1) (by omega) u_t (g₀ ^ (e₀ : ℕ) * N w_s) hprod_val0 hdiff_u

  
  refine ⟨g₀, hg₀_mem, hg₀_pow_pF, ?_, ?_, ?_⟩
  · intro d m hd_ge1 hd_le hm_ge
    obtain ⟨w_p, hw_p_t1, hu'_p⟩ := h_above_t1 (m - (u + 1)) (g₀ ^ (p F)) hg₀_pow_pF
    have hw_p_d : w_p ∈ unitGroup F K₁ d := hunit_anti_K₁ (by omega) hw_p_t1
    have hm_eq : u + 1 + (m - (u + 1)) = m := by omega
    rw [hm_eq] at hu'_p
    exact ⟨w_p, hw_p_d, hu'_p⟩
  · intro d m hd_ge1 hd_le hm_ge v hv
    obtain ⟨w₁, hw₁_d, hu_t_mem⟩ := h_below_t_d d (u - d) (by omega) v hv
    have hd_sub : d + (u - d) = u := by omega
    rw [hd_sub] at hu_t_mem
    set u_t : Bˣ := v * (N w₁)⁻¹
    obtain ⟨e₀, w_s, hw_s_u, hu_t1_mem⟩ := h_level_t u_t hu_t_mem
    set u_t1 : Bˣ := u_t * (g₀ ^ (e₀ : ℕ) * N w_s)⁻¹
    obtain ⟨w₂, hw₂_u1, hu_final_mem⟩ := h_above_t1 (m - (u + 1)) u_t1 hu_t1_mem
    have hm_eq : u + 1 + (m - (u + 1)) = m := by omega
    rw [hm_eq] at hu_final_mem
    set u_final : Bˣ := u_t1 * (N w₂)⁻¹
    let w : K₁ˣ := w₁ * w_s * w₂
    have hw_s_d : w_s ∈ unitGroup F K₁ d := hunit_anti_K₁ hd_le hw_s_u
    have hw₂_d : w₂ ∈ unitGroup F K₁ d := hunit_anti_K₁ (by omega) hw₂_u1
    have hw_d : w ∈ unitGroup F K₁ d :=
      (unitGroup F K₁ d).mul_mem ((unitGroup F K₁ d).mul_mem hw₁_d hw_s_d) hw₂_d
    refine ⟨e₀, w, hw_d, ?_⟩
    have h_eq : v * (g₀ ^ (e₀ : ℕ) * N w)⁻¹ = u_final := by
      dsimp only [u_final, u_t1, u_t, w]
      rw [map_mul, map_mul]
      simp only [mul_inv]
      apply Units.ext
      simp only [Units.val_mul]
      ring
    rwa [h_eq]
  · intro y
    set q : ℤ := valL F B (y : B)
    set u₀ : Bˣ := y * (ϖ_B ^ q)⁻¹
    have hu₀_mem : u₀ ∈ unitGroup F B 0 := by
      rw [hmem_u0 u₀]
      dsimp only [u₀]
      rw [Units.val_mul, hval_mul _ _ (Units.ne_zero y) (Units.ne_zero _),
        hval_inv (ϖ_B ^ q), hval_zpow_B ϖ_B q, hϖ_B, mul_one]
      change q + -q = 0
      omega
    obtain ⟨w₁, _, hu_t_mem⟩ := h_below_t_d 0 u (by omega) u₀ hu₀_mem
    rw [zero_add] at hu_t_mem
    set u_t : Bˣ := u₀ * (N w₁)⁻¹
    obtain ⟨e₀, w_s, _, hu_t1_mem⟩ := h_level_t u_t hu_t_mem
    set u_t1 : Bˣ := u_t * (g₀ ^ (e₀ : ℕ) * N w_s)⁻¹
    let w : K₁ˣ := ϖ_K₁ ^ q * w₁ * w_s
    refine ⟨e₀, w, ?_⟩
    have hN_zpow : N (ϖ_K₁ ^ q) = ϖ_B ^ q := by
      dsimp only [N]
      rw [map_zpow, hϖ_norm]
    have h_eq : y * (g₀ ^ (e₀ : ℕ) * N w)⁻¹ = u_t1 := by
      dsimp only [u_t1, u_t, u₀, w]
      rw [map_mul, map_mul, hN_zpow]
      simp only [mul_inv]
      apply Units.ext
      simp only [Units.val_mul]
      ring
    rwa [h_eq]

theorem ld_wild_odd_cyclic_p_group_char_pow_and_sq_gen (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hBK₁ : B ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (ξ : Bˣ →* (Ω F)ˣ)
    (hξ_pow : ξ ^ p = 1)
    (hξ_cond : condExp F B ξ = t + 1)
    (hξ_triv : ∀ u ∈ unitGroup F B (t + 1), ξ u = 1)
    (hξ_norm : ∀ w : K₁ˣ, ξ (Units.map (normLM F hBK₁) w) = 1)
    (g₀ : Bˣ)
    (hg₀_mem : g₀ ∈ unitGroup F B t)
    (hg₀_pow : g₀ ^ p ∈ unitGroup F B (t + 1))
    (hg₀_pow_decomp : ∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∃ w_p ∈ unitGroup F K₁ d,
        g₀ ^ p * (Units.map (normLM F hBK₁) w_p)⁻¹ ∈ unitGroup F B m)
    (h_unit_decomp : ∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∀ v ∈ unitGroup F B d,
        ∃ (e₀ : Fin p) (w : K₁ˣ),
          w ∈ unitGroup F K₁ d ∧
          v * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B m)
    (h_full_decomp : ∀ y : Bˣ,
      ∃ (e₀ : Fin p) (w : K₁ˣ),
        y * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B (t + 1)) :
    (∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∀ (Φ : Bˣ → (Ω F)ˣ),
        (∀ u₁ ∈ unitGroup F B d, ∀ u₂ ∈ unitGroup F B d, Φ (u₁ * u₂) = Φ u₁ * Φ u₂) →
        (∀ u ∈ unitGroup F B m, Φ u = 1) →
        (∀ w ∈ unitGroup F K₁ d, Φ (Units.map (normLM F hBK₁) w) = 1) →
        ∃ r < p, ∀ u ∈ unitGroup F B d, Φ u = ((ξ ^ 2) u) ^ r) ∧
    (∀ (Φ₀ : Bˣ →* (Ω F)ˣ),
      (∀ u ∈ unitGroup F B (t + 1), Φ₀ u = 1) →
      (∀ w : K₁ˣ, Φ₀ (Units.map (normLM F hBK₁) w) = 1) →
      (∃ u₁ ∈ unitGroup F B t, Φ₀ u₁ ≠ 1) →
      ∃ j < p, 0 < j ∧ ∀ y : Bˣ, (ξ y) ^ 2 = (Φ₀ y) ^ j) :=
by
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  haveI : NeZero p := ⟨hPrime.ne_zero⟩
  let N : K₁ˣ →* Bˣ := Units.map (normLM F hBK₁)
  have hunit_anti_B : ∀ {a b : ℕ}, 1 ≤ a → a ≤ b → ∀ {u : Bˣ},
      u ∈ unitGroup F B b → u ∈ unitGroup F B a := by
    intro a b ha hab u hu
    have ha0 : a ≠ 0 := by omega
    have hb0 : b ≠ 0 := by omega
    refine Subgroup.closure_mono (fun x hx => ?_) hu
    simp only [Set.mem_setOf_eq, if_neg ha0, if_neg hb0] at hx ⊢
    rcases hx with hx1 | hxb
    · exact Or.inl hx1
    · exact Or.inr (le_trans (by exact_mod_cast hab) hxb)
  have hξ_g₀_pow : (ξ g₀) ^ p = 1 := by
    change (ξ ^ p) g₀ = 1
    rw [hξ_pow, MonoidHom.one_apply]
  have hξ_g₀_ne1 : ξ g₀ ≠ 1 := by
    intro h1
    have hmem_t : t ∈ {a : ℕ | ∀ u ∈ unitGroup F B a, ξ u = 1} := by
      intro v hv
      obtain ⟨e₀, w, _, hu'⟩ := h_unit_decomp t (t + 1) ht_ge1 le_rfl le_rfl v hv
      set u' : Bˣ := v * (g₀ ^ (e₀ : ℕ) * N w)⁻¹
      have hv_eq : v = u' * (g₀ ^ (e₀ : ℕ) * N w) := by
        dsimp only [u']
        rw [inv_mul_cancel_right]
      rw [hv_eq, map_mul, hξ_triv u' hu', one_mul, map_mul, map_pow, h1, one_pow, hξ_norm w,
        mul_one]
    have hle : condExp F B ξ ≤ t := Nat.sInf_le hmem_t
    omega
  set ζ : (Ω F)ˣ := (ξ g₀) ^ 2
  have hζ_pow : ζ ^ p = 1 := by
    dsimp only [ζ]
    rw [pow_right_comm, hξ_g₀_pow, one_pow]
  have hζ_ne1 : ζ ≠ 1 := by
    intro hζ1
    have hp_mod : p % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime).resolve_left hp_odd
    have hp_eq : 2 * (p / 2) + 1 = p := by omega
    have h1 : ξ g₀ = 1 := by
      calc ξ g₀
        _ = 1 ^ (p / 2) * (ξ g₀) ^ 1 := by rw [one_pow, one_mul, pow_one]
        _ = ((ξ g₀) ^ 2) ^ (p / 2) * (ξ g₀) ^ 1 := by rw [← hζ1]
        _ = (ξ g₀) ^ (2 * (p / 2) + 1) := by rw [← pow_mul, ← pow_add]
        _ = (ξ g₀) ^ p := by rw [hp_eq]
        _ = 1 := hξ_g₀_pow
    exact hξ_g₀_ne1 h1
  have hζ_prim : IsPrimitiveRoot ζ p :=
    IsPrimitiveRoot.iff_orderOf.mpr (orderOf_eq_prime hζ_pow hζ_ne1)
  refine ⟨?_, ?_⟩
  · intro d m hd_ge1 hd_le hm_ge Φ hΦ_mul hΦ_triv hΦ_norm
    have hΦ_one : Φ 1 = 1 := hΦ_triv 1 (Subgroup.one_mem _)
    have hΦ_pow : ∀ (v : Bˣ), v ∈ unitGroup F B d → ∀ (n : ℕ),
        v ^ n ∈ unitGroup F B d ∧ Φ (v ^ n) = (Φ v) ^ n := by
      intro v hv n
      induction n with
      | zero =>
        rw [pow_zero, pow_zero]
        exact ⟨Subgroup.one_mem _, hΦ_one⟩
      | succ n ih =>
        have hvn1 : v ^ (n + 1) ∈ unitGroup F B d := (unitGroup F B d).pow_mem hv (n + 1)
        refine ⟨hvn1, ?_⟩
        rw [pow_succ, hΦ_mul (v ^ n) ih.1 v hv, ih.2, pow_succ]
    have hg₀_d : g₀ ∈ unitGroup F B d := hunit_anti_B hd_ge1 hd_le hg₀_mem
    obtain ⟨w_p, hw_p_d, hu'_p_m⟩ := hg₀_pow_decomp d m hd_ge1 hd_le hm_ge
    set u'_p : Bˣ := g₀ ^ p * (N w_p)⁻¹
    have hu'_p_d : u'_p ∈ unitGroup F B d := hunit_anti_B hd_ge1 (by omega) hu'_p_m
    have hg₀p_d : g₀ ^ p ∈ unitGroup F B d := (hΦ_pow g₀ hg₀_d p).1
    have hNwp_eq : N w_p = u'_p⁻¹ * g₀ ^ p := by
      dsimp only [u'_p]
      rw [mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one]
    have hNwp_d : N w_p ∈ unitGroup F B d := by
      rw [hNwp_eq]
      exact (unitGroup F B d).mul_mem ((unitGroup F B d).inv_mem hu'_p_d) hg₀p_d
    have hg₀p_eq : g₀ ^ p = u'_p * N w_p := by
      dsimp only [u'_p]
      rw [inv_mul_cancel_right]
    have hΦ_g₀_pow : (Φ g₀) ^ p = 1 := by
      rw [← (hΦ_pow g₀ hg₀_d p).2, hg₀p_eq, hΦ_mul u'_p hu'_p_d (N w_p) hNwp_d,
        hΦ_triv u'_p hu'_p_m, hΦ_norm w_p hw_p_d, mul_one]
    have hΦ_mem : Φ g₀ ∈ rootsOfUnity p (Ω F) := (mem_rootsOfUnity p (Φ g₀)).mpr hΦ_g₀_pow
    obtain ⟨r, hr_lt, hr_eq⟩ := hζ_prim.eq_pow_of_mem_rootsOfUnity hΦ_mem
    refine ⟨r, hr_lt, fun v hv => ?_⟩
    obtain ⟨e₀, w, hw_d, hu'_m⟩ := h_unit_decomp d m hd_ge1 hd_le hm_ge v hv
    set u' : Bˣ := v * (g₀ ^ (e₀ : ℕ) * N w)⁻¹
    have hu'_d : u' ∈ unitGroup F B d := hunit_anti_B hd_ge1 (by omega) hu'_m
    have hg₀e_d : g₀ ^ (e₀ : ℕ) ∈ unitGroup F B d := (hΦ_pow g₀ hg₀_d (e₀ : ℕ)).1
    have hg₀eNw_eq : g₀ ^ (e₀ : ℕ) * N w = u'⁻¹ * v := by
      dsimp only [u']
      rw [mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one]
    have hg₀eNw_d : g₀ ^ (e₀ : ℕ) * N w ∈ unitGroup F B d := by
      rw [hg₀eNw_eq]
      exact (unitGroup F B d).mul_mem ((unitGroup F B d).inv_mem hu'_d) hv
    have hNw_eq : N w = (g₀ ^ (e₀ : ℕ))⁻¹ * (g₀ ^ (e₀ : ℕ) * N w) := by
      rw [inv_mul_cancel_left]
    have hNw_d : N w ∈ unitGroup F B d := by
      rw [hNw_eq]
      exact (unitGroup F B d).mul_mem ((unitGroup F B d).inv_mem hg₀e_d) hg₀eNw_d
    have hv_eq : v = u' * (g₀ ^ (e₀ : ℕ) * N w) := by
      dsimp only [u']
      rw [inv_mul_cancel_right]
    have hΦ_v : Φ v = (Φ g₀) ^ (e₀ : ℕ) := by
      rw [hv_eq, hΦ_mul u' hu'_d _ hg₀eNw_d, hΦ_mul (g₀ ^ (e₀ : ℕ)) hg₀e_d (N w) hNw_d,
        hΦ_triv u' hu'_m, (hΦ_pow g₀ hg₀_d (e₀ : ℕ)).2, hΦ_norm w hw_d, one_mul, mul_one]
    have hu'_t1 : u' ∈ unitGroup F B (t + 1) := hunit_anti_B (by omega) hm_ge hu'_m
    have hξ_v : ((ξ ^ 2) v) = ζ ^ (e₀ : ℕ) := by
      change (ξ v) ^ 2 = ((ξ g₀) ^ 2) ^ (e₀ : ℕ)
      rw [hv_eq, map_mul, hξ_triv u' hu'_t1, one_mul, map_mul, map_pow, hξ_norm w,
        mul_one, pow_right_comm]
    rw [hΦ_v, ← hr_eq, hξ_v, pow_right_comm]
  · intro Φ₀ hΦ₀_triv hΦ₀_norm hΦ₀_nt
    have hdecomp_eval : ∀ (y : Bˣ) (e₀ : Fin p) (w : K₁ˣ),
        y * (g₀ ^ (e₀ : ℕ) * N w)⁻¹ ∈ unitGroup F B (t + 1) →
        Φ₀ y = (Φ₀ g₀) ^ (e₀ : ℕ) ∧ (ξ y) ^ 2 = ζ ^ (e₀ : ℕ) := by
      intro y e₀ w hu'
      set u' : Bˣ := y * (g₀ ^ (e₀ : ℕ) * N w)⁻¹
      have hy_eq : y = u' * (g₀ ^ (e₀ : ℕ) * N w) := by
        dsimp only [u']
        rw [inv_mul_cancel_right]
      refine ⟨?_, ?_⟩
      · rw [hy_eq, map_mul, hΦ₀_triv u' hu', one_mul, map_mul, map_pow, hΦ₀_norm w, mul_one]
      · rw [hy_eq, map_mul, hξ_triv u' hu', one_mul, map_mul, map_pow, hξ_norm w,
          mul_one, pow_right_comm]
    have hΦ₀_g₀_pow : (Φ₀ g₀) ^ p = 1 := by
      rw [← map_pow]
      exact hΦ₀_triv (g₀ ^ p) hg₀_pow
    have hΦ₀_g₀_ne1 : Φ₀ g₀ ≠ 1 := by
      intro h1
      obtain ⟨u₁, _, hu₁_ne1⟩ := hΦ₀_nt
      obtain ⟨e₀, w, hu'⟩ := h_full_decomp u₁
      have hΦ₀_u₁ := (hdecomp_eval u₁ e₀ w hu').1
      rw [h1, one_pow] at hΦ₀_u₁
      exact hu₁_ne1 hΦ₀_u₁
    have hΦ₀_prim : IsPrimitiveRoot (Φ₀ g₀) p :=
      IsPrimitiveRoot.iff_orderOf.mpr (orderOf_eq_prime hΦ₀_g₀_pow hΦ₀_g₀_ne1)
    have hζ_mem : ζ ∈ rootsOfUnity p (Ω F) := (mem_rootsOfUnity p ζ).mpr hζ_pow
    obtain ⟨j, hj_lt, hj_eq⟩ := hΦ₀_prim.eq_pow_of_mem_rootsOfUnity hζ_mem
    have hj_pos : 0 < j := by
      apply Nat.pos_of_ne_zero
      intro hj0
      rw [hj0, pow_zero] at hj_eq
      exact hζ_ne1 hj_eq.symm
    refine ⟨j, hj_lt, hj_pos, fun y => ?_⟩
    obtain ⟨e₀, w, hu'⟩ := h_full_decomp y
    obtain ⟨hΦ₀_y, hξ_y⟩ := hdecomp_eval y e₀ w hu'
    rw [hξ_y, ← hj_eq, hΦ₀_y, pow_right_comm]

theorem ld_ch12_wild_odd_totally_ramified_upper_edge_norm_coker_cyclic (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hBK₁ : B ≤ K₁) (hGalBK₁ : IsGaloisExt F B K₁)
    (hPrime : Nat.Prime (Module.finrank B (IntermediateField.extendScalars hBK₁)))
    (hWild : Module.finrank B (IntermediateField.extendScalars hBK₁) = p F)
    (hp_odd : p F ≠ 2)
    (hval_BK₁ : ∀ y : B,
      valL F K₁ (IntermediateField.inclusion hBK₁ y) =
        (Module.finrank B (IntermediateField.extendScalars hBK₁) : ℤ) * valL F B y)
    (hval_norm_BK₁ : ∀ w : K₁, valL F B (normLM F hBK₁ w) = valL F K₁ w)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (ξ : Bˣ →* (Ω F)ˣ)
    (hξ_pow : ξ ^ (Module.finrank B (IntermediateField.extendScalars hBK₁)) = 1)
    (hξ_cond : condExp F B ξ = t + 1)
    (hξ_triv : ∀ u ∈ unitGroup F B (t + 1), ξ u = 1)
    (hξ_norm : ∀ w : K₁ˣ, ξ (Units.map (normLM F hBK₁) w) = 1) :
    let p := Module.finrank B (IntermediateField.extendScalars hBK₁)
    (∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∀ (Φ : Bˣ → (Ω F)ˣ),
        (∀ u₁ ∈ unitGroup F B d, ∀ u₂ ∈ unitGroup F B d, Φ (u₁ * u₂) = Φ u₁ * Φ u₂) →
        (∀ u ∈ unitGroup F B m, Φ u = 1) →
        (∀ w ∈ unitGroup F K₁ d, Φ (Units.map (normLM F hBK₁) w) = 1) →
        ∃ r < p, ∀ u ∈ unitGroup F B d, Φ u = ((ξ ^ 2) u) ^ r) ∧
    (∀ (Φ₀ : Bˣ →* (Ω F)ˣ),
      (∀ u ∈ unitGroup F B (t + 1), Φ₀ u = 1) →
      (∀ w : K₁ˣ, Φ₀ (Units.map (normLM F hBK₁) w) = 1) →
      (∃ u₁ ∈ unitGroup F B t, Φ₀ u₁ ≠ 1) →
      ∃ j < p, 0 < j ∧ ∀ y : Bˣ, (ξ y) ^ 2 = (Φ₀ y) ^ j) :=
by
  intro p
  have hp_prime : Nat.Prime (EllipticRootNumber.p F) := hWild ▸ hPrime
  have hp_pos : 0 < Module.finrank B (IntermediateField.extendScalars hBK₁) := hPrime.pos
  have hp_odd' : p ≠ 2 := by
    change Module.finrank B (IntermediateField.extendScalars hBK₁) ≠ 2
    rw [hWild]
    exact hp_odd
  have hvalB := ld_valL_and_unitGroup_props F B
  have hvalK₁ := ld_valL_and_unitGroup_props F K₁
  obtain ⟨hadd1, hadd_neg, hadd_mul, hadd_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F B
  obtain ⟨S₁, hS₁⟩ :=
    ld_valL_mod_one_finset F B hvalB.1 hvalB.2.2.2.1 hvalB.2.2.2.2.1 hvalB.2.2.2.2.2.2.2.1
      hadd1 hadd_neg hadd_mul hadd_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_B, hField_kB, hFin_kB, resB, hresB_0, hresB_1, hresB_ring, hresB_ker, hresB_surj⟩ :=
    ld_valL_residue_field_exists F B hvalB.1 hvalB.2.1 hvalB.2.2.1 hvalB.2.2.2.1
      hvalB.2.2.2.2.1 hvalB.2.2.2.2.2.1 hvalB.2.2.2.2.2.2.2.1 S₁ hS₁
  letI : Field k_B := hField_kB
  letI : Fintype k_B := hFin_kB
  obtain ⟨ϖ_K₁, ϖ_B, hϖ_norm, hϖ_K₁, hϖ_B, hBasis⟩ :=
    ld_ch14_wild_prime_power_basis F B K₁ hBK₁ hp_pos hval_norm_BK₁ hval_BK₁
  obtain ⟨u, _, hu_ge1, _, _, _, htr_bound, htr_surj, hnorm_exp⟩ :=
    ld_wild_galois_jump_and_euler_trace_formula F B K₁ hBK₁ hGalBK₁ hPrime hWild
      hadd1 halg1 hvalB hvalK₁ hval_norm_BK₁ hval_BK₁ ϖ_K₁ hϖ_K₁ hBasis
  obtain ⟨hp_char, hnorm_surj_lt, _, hnorm_gt_surj, hb_tr_val, hP_norm_u⟩ :=
    ld_ch14_wild_prime_herbrand_filtration_and_level_t_poly F B K₁ hBK₁ hp_prime hWild
      hval_norm_BK₁ hval_BK₁ ϖ_K₁ ϖ_B hϖ_norm hϖ_K₁ hϖ_B k_B resB hresB_0 hresB_1
      hresB_ring hresB_ker hresB_surj u hu_ge1 htr_bound htr_surj hnorm_exp
  obtain ⟨_, g₀, hg₀_mem, hg₀_pow_pF, hg₀_pow_decomp_pF, h_unit_decomp_pF, h_full_decomp_pF⟩ :=
    ld_wild_odd_upper_edge_jump_eq_and_level_t_coset_gen F B K₁ hBK₁ hp_prime
      hvalB hvalK₁ hval_BK₁ ϖ_K₁ ϖ_B hϖ_norm hϖ_K₁ hϖ_B
      k_B resB hresB_0 hresB_1 hresB_ring hresB_ker hresB_surj hp_char
      u t hu_ge1 ht_ge1 ξ hξ_cond hξ_triv hξ_norm
      hnorm_surj_lt hnorm_gt_surj
      ((((ϖ_B ^ u)⁻¹ : Bˣ) : B) * traceLM F hBK₁ ((ϖ_K₁ ^ u : K₁ˣ) : K₁))
      hb_tr_val hP_norm_u
      (fun b₀ => ld_ch14_finite_field_artin_schreier_coker_gen k_B (EllipticRootNumber.p F)
        hp_prime hp_char b₀)
  have hg₀_pow : g₀ ^ p ∈ unitGroup F B (t + 1) := by
    change g₀ ^ (Module.finrank B (IntermediateField.extendScalars hBK₁)) ∈ unitGroup F B (t + 1)
    rw [hWild]
    exact hg₀_pow_pF
  have hg₀_pow_decomp : ∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∃ w_p ∈ unitGroup F K₁ d,
        g₀ ^ p * (Units.map (normLM F hBK₁) w_p)⁻¹ ∈ unitGroup F B m := by
    change ∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∃ w_p ∈ unitGroup F K₁ d,
        g₀ ^ (Module.finrank B (IntermediateField.extendScalars hBK₁)) *
          (Units.map (normLM F hBK₁) w_p)⁻¹ ∈ unitGroup F B m
    rw [hWild]
    exact hg₀_pow_decomp_pF
  have h_unit_decomp : ∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∀ v ∈ unitGroup F B d,
        ∃ (e₀ : Fin p) (w : K₁ˣ),
          w ∈ unitGroup F K₁ d ∧
          v * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B m := by
    change ∀ (d m : ℕ), 1 ≤ d → d ≤ t → t + 1 ≤ m →
      ∀ v ∈ unitGroup F B d,
        ∃ (e₀ : Fin (Module.finrank B (IntermediateField.extendScalars hBK₁))) (w : K₁ˣ),
          w ∈ unitGroup F K₁ d ∧
          v * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B m
    rw [hWild]
    exact h_unit_decomp_pF
  have h_full_decomp : ∀ y : Bˣ,
      ∃ (e₀ : Fin p) (w : K₁ˣ),
        y * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B (t + 1) := by
    change ∀ y : Bˣ,
      ∃ (e₀ : Fin (Module.finrank B (IntermediateField.extendScalars hBK₁))) (w : K₁ˣ),
        y * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hBK₁) w)⁻¹ ∈ unitGroup F B (t + 1)
    rw [hWild]
    exact h_full_decomp_pF
  exact ld_wild_odd_cyclic_p_group_char_pow_and_sq_gen F B K₁ hBK₁ p hPrime hp_odd'
    t ht_ge1 ξ hξ_pow hξ_cond hξ_triv hξ_norm g₀ hg₀_mem hg₀_pow
    hg₀_pow_decomp h_unit_decomp h_full_decomp

theorem ld_ch12_wild_odd_totally_ramified_boxed_as_shift_formula (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E') (hGalLE' : IsGaloisExt F L E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (bM₁' : ℕ) (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_νE'_stat : ∀ u : L, (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
          ψ (((c_νE'⁻¹ : Lˣ) : L) * (2 * u - u ^ 2))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let t₁ := bM₁' - 1
    let h₀ := t₁ / p
    let m₂ := bE' + bM₁' - 1
    let d₂ := m₂ / 2
    let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    ∀ w₀ : E', (w₀ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₀) →
      ∀ x : E', (x = 0 ∨ (d₂ : ℤ) ≤ valL F E' x) →
        let u_x := normLM F hLE' (1 + x) - 1
        (u_x = 0 ∨ (d₂ : ℤ) ≤ valL F L u_x) ∧
        ψE' (IntermediateField.inclusion hLE' α₀ * (w₀ ^ p - w₀) * (2 * x - x ^ 2)) =
          ψ (α₀ * normLM F hLE' w₀ * (2 * u_x - u_x ^ 2)) :=
by
  intro p bE' t₁ h₀ m₂ d₂ α₀ ψE' w₀ hw₀ x hx u_x
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hval0_L := hvalL_props.1
  have hval1_L := hvalL_props.2.1
  have hval_neg1_L := hvalL_props.2.2.1
  have hval_neg_L := hvalL_props.2.2.2.1
  have hval_mul_L := hvalL_props.2.2.2.2.1
  have hval_inv_L := hvalL_props.2.2.2.2.2.1
  have hval_add_L := hvalL_props.2.2.2.2.2.2.2.1
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hval0_E' := hvalE'_props.1
  have hval1_E' := hvalE'_props.2.1
  have hval_neg1_E' := hvalE'_props.2.2.1
  have hval_neg_E' := hvalE'_props.2.2.2.1
  have hval_mul_E' := hvalE'_props.2.2.2.2.1
  have hval_inv_E' := hvalE'_props.2.2.2.2.2.1
  have hval_add_E' := hvalE'_props.2.2.2.2.2.2.2.1
  have hval_sub_L : ∀ (k : ℤ) (a b : L),
      (a = 0 ∨ k ≤ valL F L a) → (b = 0 ∨ k ≤ valL F L b) →
      (a - b = 0 ∨ k ≤ valL F L (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    apply hval_add_L k a (-b) ha
    rcases hb with rfl | hb_ge
    · left; exact neg_zero
    · right; rw [hval_neg_L]; exact hb_ge
  have hval_sub_E' : ∀ (k : ℤ) (a b : E'),
      (a = 0 ∨ k ≤ valL F E' a) → (b = 0 ∨ k ≤ valL F E' b) →
      (a - b = 0 ∨ k ≤ valL F E' (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    apply hval_add_E' k a (-b) ha
    rcases hb with rfl | hb_ge
    · left; exact neg_zero
    · right; rw [hval_neg_E']; exact hb_ge
  have hval_mul_bound_L : ∀ (k₁ k₂ : ℤ) (a b : L),
      (a = 0 ∨ k₁ ≤ valL F L a) → (b = 0 ∨ k₂ ≤ valL F L b) →
      (a * b = 0 ∨ k₁ + k₂ ≤ valL F L (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · left; rw [ha0, zero_mul]
    · by_cases hb0 : b = 0
      · left; rw [hb0, mul_zero]
      · right
        rw [hval_mul_L a b ha0 hb0]
        exact add_le_add (ha.resolve_left ha0) (hb.resolve_left hb0)
  have hval_mul_bound_E' : ∀ (k₁ k₂ : ℤ) (a b : E'),
      (a = 0 ∨ k₁ ≤ valL F E' a) → (b = 0 ∨ k₂ ≤ valL F E' b) →
      (a * b = 0 ∨ k₁ + k₂ ≤ valL F E' (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · left; rw [ha0, zero_mul]
    · by_cases hb0 : b = 0
      · left; rw [hb0, mul_zero]
      · right
        rw [hval_mul_E' a b ha0 hb0]
        exact add_le_add (ha.resolve_left ha0) (hb.resolve_left hb0)
  have hval_pow_E' : ∀ (n : ℕ) (k : ℤ) (y : E'),
      (y = 0 ∨ k ≤ valL F E' y) → (y ^ n = 0 ∨ (n : ℤ) * k ≤ valL F E' (y ^ n)) := by
    intro n k y hy
    induction n with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul, hval1_E']
      exact Or.inr le_rfl
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_bound_E' ((n : ℤ) * k) k (y ^ n) y ih hy
      have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by push_cast; ring
      rw [heq]
      exact hmul
  have hval_sum_E' : ∀ (S : Finset ℕ) (f : ℕ → E') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F E' (f i)) →
      ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ S, f i)) := by
    intro S f k hf
    induction S using Finset.induction_on with
    | empty =>
      left; exact Finset.sum_empty
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add_E' k (f a) (∑ i ∈ s, f i)
        (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  obtain ⟨haddVal1, _, _, _, _, halg1, _⟩ := ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨ϖ_E', _, _, hϖ_E', _, hBasis⟩ :=
    ld_ch14_wild_prime_power_basis F L E' hLE' hPrime.pos hval_norm_LE' hval_LE'
  obtain ⟨G, instGroupG, instFintypeG, act, _, _, hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, _, hact_val, hact_trace, hact_norm, _⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L E' hLE' hGalLE' hPrime hWild
      haddVal1 halg1 hvalL_props hvalE'_props hval_norm_LE' hval_LE' ϖ_E' hϖ_E' hBasis
  letI : Group G := instGroupG
  letI : Fintype G := instFintypeG
  obtain ⟨_, _, _, _, _, _, _, _, hnorm_exp⟩ :=
    ld_wild_galois_jump_and_euler_trace_formula F L E' hLE' hGalLE' hPrime hWild
      haddVal1 halg1 hvalL_props hvalE'_props hval_norm_LE' hval_LE' ϖ_E' hϖ_E' hBasis
  have hp_odd' : p ≠ 2 := by omega
  have hbE'_sub1_cast : ((bE' - 1 : ℕ) + 1 : ℤ) = (bE' : ℤ) := by omega
  have htr_LE'_cast : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) + 1 : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)) := by
    intro m y hy
    rw [hbE'_sub1_cast] at hy
    exact htr_LE' m y hy
  obtain ⟨s, _, _, _, hs_val, hs_poly⟩ :=
    ld_wild_odd_free_orbit_symm_functions F L E' hLE' hPrime hp_odd' hvalE'_props (bE' - 1)
      htr_LE'_cast G act hcard_G hact_one hact_mul hact_ring hact_incl hact_val hact_trace hact_norm
  obtain ⟨_, hCH⟩ :=
    ld_wild_odd_symm_subset_sum_and_cayley_hamilton F L E' hLE' hPrime hp_odd'
      hvalL_props hvalE'_props hval_LE' G act hcard_G hact_one hact_ring hact_incl hact_norm
      s hs_poly
  obtain ⟨hψ_triv, _, hψ_Q⟩ :=
    ld_ch12_wild_odd_totally_ramified_norm_ker_quad_phase_cancel F L E' E' hLE' hLE'
      hGalLE' hPrime hWild hp_odd ψ hψ νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond
      bE' rfl hbE'_ge2 hval_LE' hval_norm_LE' htr_LE' c_νE' hc_νE'_val hc_νE'_stat
  have hp_ge2 : 2 ≤ p := hPrime.two_le
