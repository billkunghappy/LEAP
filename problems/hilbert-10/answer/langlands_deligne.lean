    intro i hi j hj
    let r : Ω F := ζ₀ ^ j * (ζ₀ ^ i)⁻¹
    have h_term_r : ∀ k : ℕ, (ζ₀ ^ k) ^ j * ((ζ₀ ^ i)⁻¹) ^ k = r ^ k := by
      intro k
      dsimp [r]
      rw [mul_pow, ← pow_mul, mul_comm k j, pow_mul]
    simp_rw [h_term_r]
    by_cases hji : j = i
    · subst hji
      rw [if_pos rfl]
      have hr1 : r = 1 := mul_inv_cancel₀ (pow_ne_zero j hζ₀_ne)
      simp [hr1]
    · rw [if_neg hji]
      have hr_ne1 : r ≠ 1 := by
        intro hr1
        have h_eq_pow : ζ₀ ^ j = ζ₀ ^ i :=
          mul_inv_eq_one₀ (pow_ne_zero i hζ₀_ne) |>.mp hr1
        exact hji (hζ₀.injOn_pow hj hi h_eq_pow)
      have hr_pow_ℓ : r ^ ℓ = 1 := by
        dsimp [r]
        rw [mul_pow, ← pow_mul, mul_comm j ℓ, pow_mul, hζ₀.pow_eq_one, one_pow, one_mul,
          inv_pow, ← pow_mul, mul_comm i ℓ, pow_mul, hζ₀.pow_eq_one, one_pow, inv_one]
      rw [geom_sum_eq hr_ne1 ℓ, hr_pow_ℓ, sub_self, zero_div]
  have hc_eq_one : ∀ i ∈ Finset.range ℓ, c i = 1 := by
    intro i hi
    have h_lhs : (∑ k ∈ Finset.range ℓ,
        (⟨1, K, hLK, 1⟩ : MonomialTerm F L).trace F L (g₀ ^ k) * ((ζ₀ ^ i)⁻¹) ^ k) =
        (ℓ : Ω F) := by
      have h_congr : ∀ k ∈ Finset.range ℓ,
          (⟨1, K, hLK, 1⟩ : MonomialTerm F L).trace F L (g₀ ^ k) * ((ζ₀ ^ i)⁻¹) ^ k =
            if k = 0 then (ℓ : Ω F) else 0 := by
        intro k hk
        rw [h_ind_eval k hk]
        by_cases hk0 : k = 0
        · subst hk0; simp
        · simp [hk0]
      rw [Finset.sum_congr rfl h_congr, Finset.sum_ite_eq' (Finset.range ℓ) 0,
        if_pos (Finset.mem_range.mpr hPrime.pos)]
    have h_rhs : (∑ k ∈ Finset.range ℓ,
        monomialListTrace F L D₀ (g₀ ^ k) * ((ζ₀ ^ i)⁻¹) ^ k) =
        (c i : Ω F) * (ℓ : Ω F) := by
      have h_step1 : ∀ k ∈ Finset.range ℓ,
          monomialListTrace F L D₀ (g₀ ^ k) * ((ζ₀ ^ i)⁻¹) ^ k =
            ∑ j ∈ Finset.range ℓ, (c j : Ω F) * ((ζ₀ ^ k) ^ j * ((ζ₀ ^ i)⁻¹) ^ k) := by
        intro k _
        rw [h_tr_c (g₀ ^ k), Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro j _
        have hμ_gk : (μ₁ (g₀ ^ k) : Ω F) = ζ₀ ^ k := by
          rw [map_pow, hμ₁_g₀, Units.val_pow_eq_pow_val]
          rfl
        rw [hμ_gk, mul_assoc]
      rw [Finset.sum_congr rfl h_step1, Finset.sum_comm]
      have h_step2 : ∀ j ∈ Finset.range ℓ,
          (∑ k ∈ Finset.range ℓ, (c j : Ω F) * ((ζ₀ ^ k) ^ j * ((ζ₀ ^ i)⁻¹) ^ k)) =
            if j = i then (c j : Ω F) * (ℓ : Ω F) else 0 := by
        intro j hj
        rw [← Finset.mul_sum, h_ortho i hi j hj]
        split_ifs <;> ring
      rw [Finset.sum_congr rfl h_step2, Finset.sum_ite_eq' (Finset.range ℓ) i, if_pos hi]
    have h_tr_eq : (∑ k ∈ Finset.range ℓ,
        (⟨1, K, hLK, 1⟩ : MonomialTerm F L).trace F L (g₀ ^ k) * ((ζ₀ ^ i)⁻¹) ^ k) =
        ∑ k ∈ Finset.range ℓ,
          monomialListTrace F L D₀ (g₀ ^ k) * ((ζ₀ ^ i)⁻¹) ^ k := by
      apply Finset.sum_congr rfl
      intro k _
      have h_eq_k : (⟨1, K, hLK, 1⟩ : MonomialTerm F L).trace F L (g₀ ^ k) =
          monomialListTrace F L D₀ (g₀ ^ k) := hD₀_sub.1.2 (g₀ ^ k)
      rw [h_eq_k]
    rw [h_lhs, h_rhs] at h_tr_eq
    have hℓ_ne0 : (ℓ : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hPrime.ne_zero
    have h_cast_eq : (c i : Ω F) = ((1 : ℤ) : Ω F) := by
      apply mul_right_cancel₀ hℓ_ne0
      rw [Int.cast_one, one_mul, h_tr_eq.symm]
    exact Int.cast_injective h_cast_eq
  refine ⟨hPrime, hAb, μ₁, hμ₁_weil, hμ₁_rest, hμ₁_pow, hμ₁_ne, ?_, ?_⟩
  · rw [h_eval_c]
    apply Finset.prod_congr rfl
    intro j hj
    rw [hc_eq_one j hj, zpow_one]
  · rw [h_eval_t_c]
    apply Finset.prod_congr rfl
    intro j hj
    rw [hc_eq_one j hj, zpow_one]

theorem ld_weil_char_untwist_abelian_decomp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (χ : relWeil F L →* (Ω F)ˣ) (hχ : IsWeilRep F L (charRep F L χ)) :
    ∃ (M : IntermediateField F (AlgebraicClosure F)) (hLM : L ≤ M)
      (ω χ_ab : relWeil F L →* (Ω F)ˣ),
      IsGaloisExt F L M ∧
      IsAbelianExt F hLM ∧
      χ = ω * χ_ab ∧
      (∀ w : relWeil F L, (w : AbsGal F) ∈ inertia F → ω w = 1) ∧
      restrictWeilChar F hLM χ_ab = 1 :=
by
  
  rcases hχ.2 with ⟨U, hU_nhds, hU_triv⟩
  have hU_χ_triv : ∀ w : relWeil F L, (w : AbsGal F) ∈ U → (w : AbsGal F) ∈ inertia F → χ w = 1 := by
    intro w hwU hwI
    have h1 := LinearMap.congr_fun (hU_triv w hwU hwI) (ULift.up (1 : Ω F))
    have h2 : (χ w : Ω F) * 1 = 1 := congrArg ULift.down h1
    rw [mul_one] at h2
    exact Units.ext h2
  
  have h_gal_closure : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (E₁ : IntermediateField k Ω_bar) [FiniteDimensional k E₁],
      ∃ (K' : IntermediateField k Ω_bar),
        FiniteDimensional k K' ∧ IsGalois k K' ∧
        ∀ x ∈ E₁, ∃ n : ℕ, x ^ (ringExpChar Ω_bar ^ n) ∈ K' := by
    intro k Ω_bar _ _ _ _ E₁ _
    let N : IntermediateField k Ω_bar := IntermediateField.normalClosure k E₁ Ω_bar
    haveI : Normal k N := normalClosure.normal k E₁ Ω_bar
    haveI : FiniteDimensional k N := normalClosure.is_finiteDimensional k E₁ Ω_bar
    have hE₁_le_N : E₁ ≤ N := IntermediateField.le_normalClosure E₁
    let K_sep : IntermediateField k N := separableClosure k N
    haveI : IsGalois k K_sep := separableClosure.isGalois k N
    let K' : IntermediateField k Ω_bar := K_sep.map N.val
    let e_K : ↥K_sep ≃ₐ[k] ↥K' := K_sep.equivMap N.val
    have hGal : IsGalois k K' := IsGalois.of_algEquiv e_K
    have hK'N : K' ≤ N := by
      rintro x ⟨z, _, rfl⟩
      exact z.2
    have hFinK' : FiniteDimensional k K' :=
      FiniteDimensional.of_injective (IntermediateField.inclusion hK'N).toLinearMap
        (IntermediateField.inclusion hK'N).injective
    refine ⟨K', hFinK', hGal, ?_⟩
    haveI : Algebra.IsAlgebraic k N := Algebra.IsAlgebraic.of_finite k N
    haveI : IsPurelyInseparable K_sep N := separableClosure.isPurelyInseparable k N
    intro x hxE₁
    let x_N : N := ⟨x, hE₁_le_N hxE₁⟩
    let q := ringExpChar Ω_bar
    haveI : ExpChar K_sep q :=
      RingHom.expChar (N.val.comp K_sep.val).toRingHom (N.val.comp K_sep.val).injective q
    obtain ⟨n, y, hy⟩ := IsPurelyInseparable.pow_mem K_sep q x_N
    refine ⟨n, ?_⟩
    have hy_val : x ^ (q ^ n) = N.val (K_sep.val y) := (congr_arg N.val hy).symm
    rw [hy_val]
    exact ⟨K_sep.val y, y.2, rfl⟩
  have h_krull_galois : ∀ (U : Set (AbsGal F)), U ∈ nhds (1 : AbsGal F) →
      ∃ (K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
        (_ : FiniteDimensional F K) (_ : IsGalois L (IntermediateField.extendScalars hLK)),
        (K.fixingSubgroup : Set (AbsGal F)) ⊆ U := by
    intro U hU
    rw [krullTopology_mem_nhds_one_iff] at hU
    rcases hU with ⟨K₀, hFinK₀, hK₀_sub⟩
    haveI : FiniteDimensional F K₀ := hFinK₀
    let K₁ : IntermediateField F (AlgebraicClosure F) := L ⊔ K₀
    have hLK₁ : L ≤ K₁ := le_sup_left
    have hK₀K₁ : K₀ ≤ K₁ := le_sup_right
    haveI : FiniteDimensional F K₁ := IntermediateField.finiteDimensional_sup L K₀
    let E₁ : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK₁
    have hFinE₁ : FiniteDimensional L E₁ := by
      haveI : FiniteDimensional F E₁ := ‹FiniteDimensional F K₁›
      exact FiniteDimensional.right F L E₁
    haveI : FiniteDimensional L E₁ := hFinE₁
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    obtain ⟨K', hFinK', hGalK', hK'_pow⟩ := h_gal_closure L (AlgebraicClosure F) E₁
    let K : IntermediateField F (AlgebraicClosure F) := K'.restrictScalars F
    have hLK : L ≤ K := fun x hx => K'.algebraMap_mem ⟨x, hx⟩
    haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) := hFinK'
    have hFinK : FiniteDimensional F K :=
      FiniteDimensional.trans F L (IntermediateField.extendScalars hLK)
    refine ⟨K, hLK, hFinK, hGalK', ?_⟩
    intro g hg
    apply hK₀_sub
    rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff] at hg ⊢
    intro x hx
    have hxE₁ : x ∈ E₁ := (IntermediateField.mem_extendScalars hLK₁).mpr (hK₀K₁ hx)
    obtain ⟨n, hxn⟩ := hK'_pow x hxE₁
    have hg_pow : g (x ^ (ringExpChar (AlgebraicClosure F) ^ n)) =
        x ^ (ringExpChar (AlgebraicClosure F) ^ n) := hg _ hxn
    rw [map_pow] at hg_pow
    have h_sub : (g x - x) ^ (ringExpChar (AlgebraicClosure F) ^ n) = 0 := by
      rw [sub_pow_expChar_pow, hg_pow, sub_self]
    exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero h_sub)
  
  have h_absGal_comm : ∀ a b : AbsGal F, a * b * a⁻¹ * b⁻¹ ∈ inertia F := by
    have h_comm_root : ∀ (n : ℕ), 0 < n → ∀ (f₁ f₂ : AbsGal F) (z : AlgebraicClosure F),
        z ^ n = 1 → f₁ (f₂ z) = f₂ (f₁ z) := by
      intro n hn f₁ f₂ z hz
      haveI : NeZero n := ⟨hn.ne'⟩
      obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := rootsOfUnity n (AlgebraicClosure F))
      have h_pow : ∀ w : AlgebraicClosure F, w ^ n = 1 →
          ∃ m : ℕ, w = ((g₀ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ m := by
        intro w hw
        have hw0 : w ≠ 0 := by
          intro h0
          rw [h0, zero_pow hn.ne'] at hw
          exact zero_ne_one hw
        let uw : (AlgebraicClosure F)ˣ := Units.mk0 w hw0
        have huw : uw ∈ rootsOfUnity n (AlgebraicClosure F) := by
          rw [mem_rootsOfUnity]
          ext
          simp [uw, hw]
        obtain ⟨m, hm⟩ := hg₀ ⟨uw, huw⟩
        refine ⟨m, ?_⟩
        have hm' := congr_arg
          (fun u : rootsOfUnity n (AlgebraicClosure F) => ((u : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)) hm
        simpa [uw] using hm'.symm
      let ζ₀ : AlgebraicClosure F := ((g₀ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)
      have hζ₀ : ζ₀ ^ n = 1 := by
        have h1 : (g₀ : (AlgebraicClosure F)ˣ) ^ n = 1 := (mem_rootsOfUnity n _).mp g₀.2
        simpa [ζ₀, Units.val_pow_eq_pow_val] using congr_arg Units.val h1
      have hf₁ζ₀ : (f₁ ζ₀) ^ n = 1 := by rw [← map_pow, hζ₀, map_one]
      have hf₂ζ₀ : (f₂ ζ₀) ^ n = 1 := by rw [← map_pow, hζ₀, map_one]
      obtain ⟨j, hj⟩ := h_pow (f₁ ζ₀) hf₁ζ₀
      obtain ⟨k, hk⟩ := h_pow (f₂ ζ₀) hf₂ζ₀
      obtain ⟨m, hm⟩ := h_pow z hz
      change f₁ ζ₀ = ζ₀ ^ j at hj
      change f₂ ζ₀ = ζ₀ ^ k at hk
      change z = ζ₀ ^ m at hm
      calc f₁ (f₂ z) = f₁ (f₂ (ζ₀ ^ m)) := by rw [hm]
        _ = f₁ ((f₂ ζ₀) ^ m) := by rw [map_pow]
        _ = f₁ ((ζ₀ ^ k) ^ m) := by rw [hk]
        _ = (f₁ ζ₀) ^ (k * m) := by rw [← pow_mul, map_pow]
        _ = (ζ₀ ^ j) ^ (k * m) := by rw [hj]
        _ = ζ₀ ^ (j * (k * m)) := by rw [← pow_mul]
        _ = ζ₀ ^ (k * (j * m)) := by rw [mul_left_comm]
        _ = (ζ₀ ^ k) ^ (j * m) := by rw [pow_mul]
        _ = (f₂ ζ₀) ^ (j * m) := by rw [← hk]
        _ = f₂ ((ζ₀ ^ j) ^ m) := by rw [← map_pow, pow_mul]
        _ = f₂ ((f₁ ζ₀) ^ m) := by rw [← hj]
        _ = f₂ (f₁ (ζ₀ ^ m)) := by rw [← map_pow]
        _ = f₂ (f₁ z) := by rw [← hm]
    intro a b
    unfold inertia unramifiedClosure
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy =>
      rcases hy with ⟨n, hn, _, hyn⟩
      let z := a⁻¹ (b⁻¹ y)
      have hz : z ^ n = 1 := by
        simp only [z, ← map_pow, hyn, map_one]
      have h1 : a (b z) = b (a z) := h_comm_root n hn a b z hz
      change a (b z) = y
      rw [h1]
      simp [z]
    | algebraMap y =>
      exact (a * b * a⁻¹ * b⁻¹).commutes y
    | add y z _ _ hy hz =>
      rw [map_add, hy, hz]
    | inv y _ hy =>
      rw [map_inv₀, hy]
    | mul y z _ _ hy hz =>
      rw [map_mul, hy, hz]
  let I : Subgroup (relWeil F L) := (inertia F).subgroupOf (relWeil F L)
  have h_comm_I : ∀ a b : relWeil F L, a * b * a⁻¹ * b⁻¹ ∈ I :=
    fun a b => h_absGal_comm a.1 b.1
  haveI : I.Normal := ⟨fun g hg i => by
    have h1 : i * g * i⁻¹ * g⁻¹ ∈ I := h_comm_I i g
    have h2 : (i * g * i⁻¹ * g⁻¹) * g = i * g * i⁻¹ := by group
    rw [← h2]
    exact I.mul_mem h1 hg⟩
  let Γ := relWeil F L ⧸ I
  let π_I : relWeil F L →* Γ := QuotientGroup.mk' I
  have hΓ_comm : ∀ x y : Γ, x * y = y * x := by
    intro x y
    refine QuotientGroup.induction_on x fun a => QuotientGroup.induction_on y fun b => ?_
    change π_I a * π_I b = π_I b * π_I a
    have h1 : π_I (a * b * a⁻¹ * b⁻¹) = 1 := (QuotientGroup.eq_one_iff _).mpr (h_comm_I a b)
    rw [map_mul, map_mul, map_mul, map_inv, map_inv] at h1
    exact mul_inv_eq_one.mp (by
      calc (π_I a * π_I b) * (π_I b * π_I a)⁻¹
          = π_I a * π_I b * (π_I a)⁻¹ * (π_I b)⁻¹ := by group
        _ = 1 := h1)
  letI : CommGroup Γ := { (inferInstance : Group Γ) with mul_comm := hΓ_comm }
  
  obtain ⟨K, hLK, hFinK, hGal, hK_sub⟩ := h_krull_galois U hU_nhds
  haveI : FiniteDimensional F K := hFinK
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  haveI : IsGalois L K' := hGal
  haveI : Normal L K' := IsGalois.to_normal
  let G := (K' ≃ₐ[L] K')
  let res : relWeil F L →* G :=
    (AlgEquiv.restrictNormalHom K').comp
      ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
        (Subgroup.inclusion (inf_le_right : relWeil F L ≤ L.fixingSubgroup)))
  have h_res_apply : ∀ (w : relWeil F L) (x : K'),
      ((res w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) := by
    intro w x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv L) ⟨w.1, w.2.2⟩) x : K') : AlgebraicClosure F) =
      (w : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  let N : Subgroup (relWeil F L) := res.ker
  have hN_le_U : ∀ w ∈ N, (w : AbsGal F) ∈ U := by
    intro w hw
    apply hK_sub
    rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
    have h1 : ((res w x : K') : AlgebraicClosure F) = (w : AbsGal F) z := h_res_apply w x
    have h2 : res w = 1 := hw
    rw [← h1, h2]
    rfl
  let χ_N : N →* (Ω F)ˣ := χ.comp N.subtype
  have hχ_I : ∀ n : N, (n : relWeil F L) ∈ I → χ_N n = 1 := by
    intro n hnI
    exact hU_χ_triv (n : relWeil F L) (hN_le_U (n : relWeil F L) n.2) hnI
  let φ : N →* Γ := π_I.comp N.subtype
  let M_Γ : Subgroup Γ := φ.range
  have h_ker_φ : φ.ker ≤ χ_N.ker := by
    intro n hn
    rw [MonoidHom.mem_ker] at hn ⊢
    have hnI : (n : relWeil F L) ∈ I := (QuotientGroup.eq_one_iff (n : relWeil F L)).mp hn
    exact hχ_I n hnI
  let bar_χ_N : M_Γ →* (Ω F)ˣ :=
    (QuotientGroup.lift φ.ker χ_N h_ker_φ).comp
      (QuotientGroup.quotientKerEquivRange φ).symm.toMonoidHom
  have h_bar_χ_N : ∀ n : N, bar_χ_N (φ.rangeRestrict n) = χ_N n := by
    intro n
    have h1 : (QuotientGroup.quotientKerEquivRange φ).symm (φ.rangeRestrict n) =
        (n : N ⧸ φ.ker) := by
      apply (QuotientGroup.quotientKerEquivRange φ).injective
      simp
      rfl
    change (QuotientGroup.lift φ.ker χ_N h_ker_φ)
      ((QuotientGroup.quotientKerEquivRange φ).symm (φ.rangeRestrict n)) = χ_N n
    rw [h1]
    rfl
  letI : DivisibleBy (Additive (Ω F)ˣ) ℕ :=
    { div := fun x n =>
        if hn : n = 0 then 0
        else
          let hpos : 0 < n := Nat.pos_of_ne_zero hn
          let z := (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val hpos).choose
          have hz_pow : z ^ n = (Additive.toMul x).val :=
            (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val hpos).choose_spec
          have hz_ne : z ≠ 0 := by
            intro h0
            have h1 : z ^ n = 0 := h0.symm ▸ zero_pow hn
            rw [hz_pow] at h1
            exact (Units.ne_zero (Additive.toMul x)) h1
          Additive.ofMul (Units.mk0 z hz_ne)
      div_zero := fun x => dif_pos rfl
      div_cancel := fun {n} x hn => by
        dsimp only
        rw [dif_neg hn]
        apply Additive.toMul.injective
        rw [toMul_nsmul, toMul_ofMul]
        ext
        rw [Units.val_pow_eq_pow_val, Units.val_mk0]
        exact (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val
          (Nat.pos_of_ne_zero hn)).choose_spec }
  letI : DivisibleBy (Additive (Ω F)ˣ) ℤ :=
    AddGroup.divisibleByIntOfDivisibleByNat (Additive (Ω F)ˣ)
  have hBaer : Module.Baer ℤ (Additive (Ω F)ˣ) := Module.Baer.of_divisible (Additive (Ω F)ˣ)
  let f_add : Additive M_Γ →+ Additive Γ := MonoidHom.toAdditive M_Γ.subtype
  let g_add : Additive M_Γ →+ Additive (Ω F)ˣ := MonoidHom.toAdditive bar_χ_N
  have hf_inj : Function.Injective f_add := M_Γ.subtype_injective
  obtain ⟨h_add, hh_add⟩ := hBaer.extension_property_addMonoidHom f_add hf_inj g_add
  let bar_ω : Γ →* (Ω F)ˣ := MonoidHom.toAdditive.symm h_add
  let ω : relWeil F L →* (Ω F)ˣ := bar_ω.comp π_I
  have hω_I : ∀ w : relWeil F L, (w : AbsGal F) ∈ inertia F → ω w = 1 := by
    intro w hw
    change bar_ω (π_I w) = 1
    have h1 : π_I w = 1 := (QuotientGroup.eq_one_iff w).mpr hw
    rw [h1, map_one]
  have hω_N : ∀ n : N, ω (n : relWeil F L) = χ (n : relWeil F L) := by
    intro n
    change bar_ω (φ n) = χ_N n
    have h1 : φ n = M_Γ.subtype (φ.rangeRestrict n) := rfl
    rw [h1]
    have h2 : bar_ω (M_Γ.subtype (φ.rangeRestrict n)) = bar_χ_N (φ.rangeRestrict n) :=
      DFunLike.congr_fun hh_add (Additive.ofMul (φ.rangeRestrict n))
    rw [h2, h_bar_χ_N n]
  let χ_ab : relWeil F L →* (Ω F)ˣ := ω⁻¹ * χ
  have hχ_eq : χ = ω * χ_ab := by
    ext w
    simp [χ_ab]
  have h_ker_le : res.ker ≤ χ_ab.ker := by
    intro w hw
    rw [MonoidHom.mem_ker]
    change (ω w)⁻¹ * χ w = 1
    have hwN : w ∈ N := hw
    have h1 : ω w = χ w := hω_N ⟨w, hwN⟩
    rw [h1, inv_mul_cancel]
  
  haveI : FiniteDimensional F K' := hFinK
  haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
  have hSepLK : Algebra.IsSeparable L K' := IsGalois.to_isSeparable
  let H_KL : Subgroup (relWeil F L) := (relWeil F K).subgroupOf (relWeil F L)
  let bar_res : (relWeil F L ⧸ H_KL) → G := fun u => res (cosetRep u)
  have h_ker_res : ∀ w : relWeil F L, res w = 1 → w ∈ H_KL := by
    intro w hw
    rw [Subgroup.mem_subgroupOf]
    refine Subgroup.mem_inf.mpr ⟨w.2.1, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
    have h1 := h_res_apply w x
    rw [hw] at h1
    exact h1.symm
  have hbar_res_inj : Function.Injective bar_res := by
    intro u₁ u₂ h_eq
    change res (cosetRep u₁) = res (cosetRep u₂) at h_eq
    have h1 : res ((cosetRep u₁)⁻¹ * cosetRep u₂) = 1 := by
      rw [map_mul, map_inv, h_eq, inv_mul_cancel]
    have h2 : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ H_KL := h_ker_res _ h1
    have h3 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_KL) =
        QuotientGroup.mk (cosetRep u₂) := QuotientGroup.eq.mpr h2
    have h_out1 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_KL) = u₁ :=
      Quotient.out_eq u₁
    have h_out2 : (QuotientGroup.mk (cosetRep u₂) : relWeil F L ⧸ H_KL) = u₂ :=
      Quotient.out_eq u₂
    rw [h_out1, h_out2] at h3
    exact h3
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFin_quot, hCard_quot⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob L K hLK hSepLK
  letI : Finite (relWeil F L ⧸ H_KL) := hFin_quot
  letI : Fintype (relWeil F L ⧸ H_KL) := Fintype.ofFinite (relWeil F L ⧸ H_KL)
  have h_card_eq : Fintype.card (relWeil F L ⧸ H_KL) = Fintype.card G := by
    rw [← Nat.card_eq_fintype_card, hCard_quot, ← IsGalois.card_aut_eq_finrank L K',
      Nat.card_eq_fintype_card]
  have hbar_res_bij : Function.Bijective bar_res :=
    (Fintype.bijective_iff_injective_and_card bar_res).mpr ⟨hbar_res_inj, h_card_eq⟩
  have hsurj : Function.Surjective res := by
    intro g
    obtain ⟨u, hu⟩ := hbar_res_bij.2 g
    exact ⟨cosetRep u, hu⟩
  let bar_χ : G →* (Ω F)ˣ :=
    (QuotientGroup.lift res.ker χ_ab h_ker_le).comp
      (QuotientGroup.quotientKerEquivOfSurjective res hsurj).symm.toMonoidHom
  have h_bar_χ : ∀ w : relWeil F L, bar_χ (res w) = χ_ab w := by
    intro w
    have h1 : (QuotientGroup.quotientKerEquivOfSurjective res hsurj).symm (res w) =
        (w : relWeil F L ⧸ res.ker) := by
      apply (QuotientGroup.quotientKerEquivOfSurjective res hsurj).injective
      simp
      rfl
    change (QuotientGroup.lift res.ker χ_ab h_ker_le)
      ((QuotientGroup.quotientKerEquivOfSurjective res hsurj).symm (res w)) = χ_ab w
    rw [h1]
    rfl
  
  let C : Subgroup G := bar_χ.ker
  haveI : C.Normal := bar_χ.normal_ker
  have hC_comm : ∀ g₁ g₂ : G, g₁ * g₂ * g₁⁻¹ * g₂⁻¹ ∈ C := by
    intro g₁ g₂
    rw [MonoidHom.mem_ker, map_mul, map_mul, map_mul, map_inv, map_inv,
      mul_right_comm (bar_χ g₁) (bar_χ g₂) (bar_χ g₁)⁻¹, mul_inv_cancel, one_mul, mul_inv_cancel]
  let E₀ : IntermediateField L K' := IntermediateField.fixedField C
  let E_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.lift E₀
  let M : IntermediateField F (AlgebraicClosure F) := E_L.restrictScalars F
  have hLM : L ≤ M := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars]
    exact E_L.algebraMap_mem ⟨z, hz⟩
  have hMK : M ≤ K := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars] at hz
    exact (IntermediateField.mem_extendScalars hLK).mp (IntermediateField.lift_le E₀ hz)
  have h_mem_M : ∀ x : K', (x : AlgebraicClosure F) ∈ M ↔ x ∈ E₀ := by
    intro x
    exact (IntermediateField.mem_restrictScalars F).trans (IntermediateField.mem_lift x)
  haveI : FiniteDimensional F M :=
    Module.Finite.of_injective (IntermediateField.inclusion hMK).toLinearMap
      (IntermediateField.inclusion hMK).injective
  let res_L : L.fixingSubgroup →* G :=
    (AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv L).toMonoidHom
  have h_res_L_apply : ∀ (γ : L.fixingSubgroup) (x : K'),
      ((res_L γ x : K') : AlgebraicClosure F) = (γ : AbsGal F) (x : AlgebraicClosure F) := by
    intro γ x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv L) γ) x : K') : AlgebraicClosure F) =
      (γ : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have h_fix_C : E₀.fixingSubgroup = C := IntermediateField.fixingSubgroup_fixedField C
  have hGalM : IsGaloisExt F L M := by
    refine ⟨hLM, inferInstance, ?_, ?_⟩
    · intro σ hσ τ hτ
      have hτ_L : τ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM hτ
      let g_σ : G := res_L ⟨σ, hσ⟩
      let g_τ : G := res_L ⟨τ, hτ_L⟩
      have hg_τ : g_τ ∈ C := by
        rw [← h_fix_C, IntermediateField.mem_fixingSubgroup_iff]
        intro y hy
        apply Subtype.ext
        rw [h_res_L_apply ⟨τ, hτ_L⟩ y]
        have hyM : (y : AlgebraicClosure F) ∈ M := (h_mem_M y).mpr hy
        exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hτ (y : AlgebraicClosure F) hyM
      have h_conj_C : g_σ * g_τ * g_σ⁻¹ ∈ C :=
        Subgroup.Normal.conj_mem ‹C.Normal› g_τ hg_τ g_σ
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro z hz
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hMK hz)⟩
      have hxE₀ : x ∈ E₀ := (h_mem_M x).mp hz
      have h_fix_x : (g_σ * g_τ * g_σ⁻¹) x = x :=
        (IntermediateField.mem_fixedField_iff C x).mp hxE₀ (g_σ * g_τ * g_σ⁻¹) h_conj_C
      have h_res_conj : res_L (⟨σ, hσ⟩ * ⟨τ, hτ_L⟩ * ⟨σ, hσ⟩⁻¹) = g_σ * g_τ * g_σ⁻¹ := by
        rw [map_mul, map_mul, map_inv]
      have h1 := h_res_L_apply (⟨σ, hσ⟩ * ⟨τ, hτ_L⟩ * ⟨σ, hσ⟩⁻¹) x
      rw [h_res_conj, h_fix_x] at h1
      exact h1.symm
    · intro h
      let S_M := IntermediateField.extendScalars h
      refine ⟨fun x => ?_⟩
      have hxM : (x : AlgebraicClosure F) ∈ M := (IntermediateField.mem_extendScalars h).mp x.2
      let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hMK hxM)⟩
      have hmin1 : (minpoly L (S_M.val x)).Separable ↔ (minpoly L x).Separable := by
        rw [minpoly.algHom_eq S_M.val S_M.val.injective x]
      have hmin2 : (minpoly L (K'.val x_K)).Separable ↔ (minpoly L x_K).Separable := by
        rw [minpoly.algHom_eq K'.val K'.val.injective x_K]
      exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable L x_K))
  have hAbM : IsAbelianExt F hLM := by
    refine ⟨hGalM.2.2.1, ?_, hGalM.2.2.2 hLM⟩
    intro σ hσ τ hτ
    let g_σ : G := res_L ⟨σ, hσ⟩
    let g_τ : G := res_L ⟨τ, hτ⟩
    have h_comm_C : g_σ * g_τ * g_σ⁻¹ * g_τ⁻¹ ∈ C := hC_comm g_σ g_τ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hMK hz)⟩
    have hxE₀ : x ∈ E₀ := (h_mem_M x).mp hz
    have h_fix_x : (g_σ * g_τ * g_σ⁻¹ * g_τ⁻¹) x = x :=
      (IntermediateField.mem_fixedField_iff C x).mp hxE₀ (g_σ * g_τ * g_σ⁻¹ * g_τ⁻¹) h_comm_C
    have h_res_comm : res_L (⟨σ, hσ⟩ * ⟨τ, hτ⟩ * ⟨σ, hσ⟩⁻¹ * ⟨τ, hτ⟩⁻¹) =
        g_σ * g_τ * g_σ⁻¹ * g_τ⁻¹ := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv]
    have h1 := h_res_L_apply (⟨σ, hσ⟩ * ⟨τ, hτ⟩ * ⟨σ, hσ⟩⁻¹ * ⟨τ, hτ⟩⁻¹) x
    rw [h_res_comm, h_fix_x] at h1
    exact h1.symm
  have hχ_ab_rest : restrictWeilChar F hLM χ_ab = 1 := by
    apply MonoidHom.ext
    intro w
    rw [MonoidHom.one_apply]
    let w_L : relWeil F L := Subgroup.inclusion (relWeil_antitone F hLM) w
    change χ_ab w_L = 1
    rw [← h_bar_χ w_L, ← MonoidHom.mem_ker]
    change res w_L ∈ C
    rw [← h_fix_C, IntermediateField.mem_fixingSubgroup_iff]
    intro y hy
    apply Subtype.ext
    rw [h_res_apply w_L y]
    have hyM : (y : AlgebraicClosure F) ∈ M := (h_mem_M y).mpr hy
    exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp w.2.2 (y : AlgebraicClosure F) hyM
  exact ⟨M, hLM, ω, χ_ab, hGalM, hAbM, hχ_eq, hω_I, hχ_ab_rest⟩

theorem ld_unramified_weil_char_rec_and_norm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
    (hLK : L ≤ K) (hSep : Algebra.IsSeparable L (IntermediateField.extendScalars hLK))
    (ω : relWeil F L →* (Ω F)ˣ)
    (hω_I : ∀ w : relWeil F L, (w : AbsGal F) ∈ inertia F → ω w = 1) :
    ∃ ω' : Lˣ →* (Ω F)ˣ,
      (∀ x : Lˣ, ω' x = ω (rec.recMap L x)) ∧
      (∀ u ∈ unitGroup F L 0, ω' u = 1) ∧
      (∀ y : Kˣ, ω' (Units.map (normLM F hLK) y) =
        (restrictWeilChar F hLK ω) (rec.recMap K y)) :=
by
  
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  haveI : CharP 𝓀[F] (p F) := ringChar.of_eq rfl
  haveI : Finite 𝓀[F] :=
    IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  obtain ⟨r_p, _, hcard_k⟩ := FiniteField.card 𝓀[F] (p F)
  have hq_eq : q F = (p F) ^ (r_p : ℕ) := Nat.card_eq_fintype_card.trans hcard_k
  have hp_dvd_q : p F ∣ q F := hq_eq ▸ dvd_pow_self (p F) r_p.ne_zero
  have hq_gt1 : 1 < q F := hq_eq ▸ one_lt_pow₀ hp.one_lt r_p.ne_zero
  have hS_map : ∀ (σ : AbsGal F) {ζ : AlgebraicClosure F},
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (σ ζ) := by
    rintro σ ζ ⟨N, hN, hpN, hζN⟩
    refine ⟨N, hN, hpN, ?_⟩
    rw [← map_pow, hζN, map_one]
  have h_qpow_inj : ∀ (N : ℕ), 0 < N → ¬ p F ∣ N → ∀ (c : ℕ) (ξ₁ ξ₂ : AlgebraicClosure F),
      ξ₁ ^ N = 1 → ξ₂ ^ N = 1 → ξ₁ ^ ((q F) ^ c) = ξ₂ ^ ((q F) ^ c) → ξ₁ = ξ₂ := by
    intro N hN hpN c ξ₁ ξ₂ hξ₁ hξ₂ heq
    obtain ⟨τ, hτ⟩ := (hFrob N hN hpN).2.1
    have hτ_pow : ∀ (k : ℕ) (ξ : AlgebraicClosure F), ξ ^ N = 1 → (τ ^ k) ξ = ξ ^ ((q F) ^ k) := by
      intro k
      induction k with
      | zero =>
        intro ξ _
        simp
      | succ k ih =>
        intro ξ hξ
        have hξ_pow : (ξ ^ ((q F) ^ k)) ^ N = 1 := by
          rw [← pow_mul, mul_comm _ N, pow_mul, hξ, one_pow]
        rw [pow_succ', AlgEquiv.mul_apply, ih ξ hξ, hτ _ hξ_pow, ← pow_mul, ← pow_succ]
    apply (τ ^ c).injective
    rw [hτ_pow c ξ₁ hξ₁, hτ_pow c ξ₂ hξ₂, heq]
  
  have h_frob_one : ActsAsFrobPow F 1 0 := by
    intro ζ _
    rfl
  have h_frob_inv : ∀ (σ : AbsGal F) (n : ℤ),
      ActsAsFrobPow F σ n → ActsAsFrobPow F σ⁻¹ (-n) := by
    intro σ n hσ ζ hζ
    have h1 := hσ (σ⁻¹ ζ) (hS_map σ⁻¹ hζ)
    have h2 : σ (σ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h2] at h1
    change (σ⁻¹ ζ) ^ (q F ^ (-(-n)).toNat) = ζ ^ (q F ^ (-n).toNat)
    rw [neg_neg, ← h1]
  have h_frob_mul : ∀ (σ₁ σ₂ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F σ₁ n₁ → ActsAsFrobPow F σ₂ n₂ →
      ActsAsFrobPow F (σ₁ * σ₂) (n₁ + n₂) := by
    intro σ₁ σ₂ n₁ n₂ hσ₁ hσ₂ ζ hζ
    rcases hζ with ⟨N, hN_pos, hpN, hζN⟩
    have hζ_S : IsPrimeToPRootOfUnity F ζ := ⟨N, hN_pos, hpN, hζN⟩
    set a₁ := n₁.toNat
    set b₁ := (-n₁).toNat
    set a₂ := n₂.toNat
    set b₂ := (-n₂).toNat
    set a₃ := (n₁ + n₂).toNat
    set b₃ := (-(n₁ + n₂)).toNat
    set c := (a₁ + a₂) - a₃
    have ha_eq : a₃ + c = a₁ + a₂ := by omega
    have hb_eq : b₃ + c = b₁ + b₂ := by omega
    let ξ₁ : AlgebraicClosure F := ((σ₁ * σ₂) ζ) ^ ((q F) ^ b₃)
    let ξ₂ : AlgebraicClosure F := ζ ^ ((q F) ^ a₃)
    have hξ₁N : ξ₁ ^ N = 1 := by
      change (((σ₁ * σ₂) ζ) ^ ((q F) ^ b₃)) ^ N = 1
      rw [← pow_mul, mul_comm _ N, pow_mul, ← map_pow, hζN, map_one, one_pow]
    have hξ₂N : ξ₂ ^ N = 1 := by
      change (ζ ^ ((q F) ^ a₃)) ^ N = 1
      rw [← pow_mul, mul_comm _ N, pow_mul, hζN, one_pow]
    apply h_qpow_inj N hN_pos hpN c ξ₁ ξ₂ hξ₁N hξ₂N
    dsimp [ξ₁, ξ₂]
    have h1 := hσ₁ (σ₂ ζ) (hS_map σ₂ hζ_S)
    have h2 := hσ₂ ζ hζ_S
    calc (((σ₁ * σ₂) ζ) ^ ((q F) ^ b₃)) ^ ((q F) ^ c)
      _ = (σ₁ (σ₂ ζ)) ^ ((q F) ^ (b₃ + c)) := by
        rw [AlgEquiv.mul_apply, ← pow_mul, ← pow_add]
      _ = ((σ₁ (σ₂ ζ)) ^ ((q F) ^ b₁)) ^ ((q F) ^ b₂) := by
        rw [hb_eq, pow_add, pow_mul]
      _ = ((σ₂ ζ) ^ ((q F) ^ a₁)) ^ ((q F) ^ b₂) := by
        rw [h1]
      _ = ((σ₂ ζ) ^ ((q F) ^ b₂)) ^ ((q F) ^ a₁) := by
        rw [← pow_mul, mul_comm ((q F) ^ a₁) ((q F) ^ b₂), pow_mul]
      _ = (ζ ^ ((q F) ^ a₂)) ^ ((q F) ^ a₁) := by
        rw [h2]
      _ = ζ ^ ((q F) ^ (a₁ + a₂)) := by
        rw [← pow_mul, ← pow_add, add_comm a₂ a₁]
      _ = (ζ ^ ((q F) ^ a₃)) ^ ((q F) ^ c) := by
        rw [← ha_eq, pow_add, pow_mul]
  have h_frob_one_pos : ∀ k : ℕ, 0 < k → ¬ ActsAsFrobPow F 1 (k : ℤ) := by
    intro k hk hk_frob
    let N : ℕ := (q F) ^ (k + 1) - 1
    have hqk_gt1 : 1 < (q F) ^ k := one_lt_pow₀ hq_gt1 (Nat.ne_of_gt hk)
    have hqk_lt : (q F) ^ k < (q F) ^ (k + 1) :=
      Nat.pow_lt_pow_right hq_gt1 (Nat.lt_succ_self k)
    have hN_pos : 0 < N := by
      dsimp [N]
      omega
    have hp_dvd_N1 : p F ∣ N + 1 := by
      have hN1 : N + 1 = (q F) ^ (k + 1) := by
        dsimp [N]
        omega
      rw [hN1]
      exact dvd_trans hp_dvd_q (dvd_pow_self (q F) (Nat.succ_ne_zero k))
    have hpN : ¬ p F ∣ N := by
      intro hdvd
      have hdvd1 : p F ∣ 1 := (Nat.dvd_add_right hdvd).mp hp_dvd_N1
      exact hp.not_dvd_one hdvd1
    haveI : NeZero (N : F) := ⟨(hFrob N hN_pos hpN).1⟩
    obtain ⟨ζ, hζ_prim⟩ :=
      @HasEnoughRootsOfUnity.prim (AlgebraicClosure F) _ N
        (AlgebraicClosure.hasEnoughRootsOfUnity F N)
    have hζ_S : IsPrimeToPRootOfUnity F ζ := ⟨N, hN_pos, hpN, hζ_prim.pow_eq_one⟩
    have h1 := hk_frob ζ hζ_S
    have hneg : (-(k : ℤ)).toNat = 0 := by omega
    have hpos : (k : ℤ).toNat = k := Int.toNat_natCast k
    change ((1 : AbsGal F) ζ) ^ ((q F) ^ (-(k : ℤ)).toNat) = ζ ^ ((q F) ^ (k : ℤ).toNat) at h1
    rw [AlgEquiv.one_apply, hneg, hpos, pow_zero, pow_one] at h1
    let m : ℕ := (q F) ^ k - 1
    have hm_pos : 0 < m := by
      dsimp [m]
      omega
    have hm_lt : m < N := by
      dsimp [m, N]
      omega
    have hm_add : m + 1 = (q F) ^ k := by
      dsimp [m]
      omega
    have hζ_ne : ζ ≠ 0 := hζ_prim.ne_zero hN_pos.ne'
    have hζ_m : ζ ^ m = 1 := by
      apply mul_right_cancel₀ hζ_ne
      rw [← pow_succ, hm_add, one_mul]
      exact h1.symm
    have hdvd : N ∣ m := hζ_prim.dvd_of_pow_eq_one m hζ_m
    have hle : N ≤ m := Nat.le_of_dvd hm_pos hdvd
    omega
  have h_frob_unique : ∀ (σ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F σ n₁ → ActsAsFrobPow F σ n₂ → n₁ = n₂ := by
    intro σ n₁ n₂ h₁ h₂
    have h_diff : ActsAsFrobPow F 1 (-n₁ + n₂) := by
      rw [← inv_mul_cancel σ]
      exact h_frob_mul σ⁻¹ σ (-n₁) n₂ (h_frob_inv σ n₁ h₁) h₂
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · let k : ℕ := (-n₁ + n₂).toNat
      have hk_pos : 0 < k := by omega
      have hk_eq : (k : ℤ) = -n₁ + n₂ := by omega
      rw [← hk_eq] at h_diff
      exact h_frob_one_pos k hk_pos h_diff
    · have h_diff' : ActsAsFrobPow F 1 (-(-n₁ + n₂)) := by
        simpa using h_frob_inv 1 (-n₁ + n₂) h_diff
      let k : ℕ := (-(-n₁ + n₂)).toNat
      have hk_pos : 0 < k := by omega
      have hk_eq : (k : ℤ) = -(-n₁ + n₂) := by omega
      rw [← hk_eq] at h_diff'
      exact h_frob_one_pos k hk_pos h_diff'
  
  let W' : Subgroup (AbsGal F) :=
    { carrier := {σ : AbsGal F | ∃ n : ℤ, ActsAsFrobPow F σ n}
      one_mem' := ⟨0, h_frob_one⟩
      mul_mem' := fun ⟨n₁, h₁⟩ ⟨n₂, h₂⟩ => ⟨n₁ + n₂, h_frob_mul _ _ n₁ n₂ h₁ h₂⟩
      inv_mem' := fun ⟨n, h⟩ => ⟨-n, h_frob_inv _ n h⟩ }
  have hW_le : weilGroup F ≤ W' := by
    rw [weilGroup, Subgroup.closure_le]
    exact Set.Subset.refl _
  have hex_frob : ∀ σ : weilGroup F, ∃ n : ℤ, ActsAsFrobPow F (σ : AbsGal F) n :=
    fun σ => hW_le σ.2
  let f₀ : weilGroup F →* Multiplicative ℤ :=
    { toFun := fun σ => Multiplicative.ofAdd (hex_frob σ).choose
      map_one' := by
        have h0 : (hex_frob 1).choose = 0 :=
          h_frob_unique 1 _ 0 (hex_frob 1).choose_spec h_frob_one
        rw [h0, ofAdd_zero]
      map_mul' := fun σ₁ σ₂ => by
        have hmul : (hex_frob (σ₁ * σ₂)).choose =
            (hex_frob σ₁).choose + (hex_frob σ₂).choose :=
          h_frob_unique (σ₁ * σ₂).1 _ _ (hex_frob (σ₁ * σ₂)).choose_spec
            (h_frob_mul _ _ _ _ (hex_frob σ₁).choose_spec (hex_frob σ₂).choose_spec)
        rw [hmul, ofAdd_add] }
  have hf₀_spec : ∀ (σ : weilGroup F) (n : ℤ),
      ActsAsFrobPow F (σ : AbsGal F) n → f₀ σ = Multiplicative.ofAdd n := by
    intro σ n hσn
    have heq : (hex_frob σ).choose = n :=
      h_frob_unique σ.1 _ n (hex_frob σ).choose_spec hσn
    change Multiplicative.ofAdd (hex_frob σ).choose = Multiplicative.ofAdd n
    rw [heq]
  have hdeg_spec : ∀ (σ : weilGroup F) (n : ℤ),
      ActsAsFrobPow F (σ : AbsGal F) n → weilDegreeHom F σ = Multiplicative.ofAdd n :=
    Classical.epsilon_spec (p := fun f : weilGroup F →* Multiplicative ℤ =>
      ∀ (σ : weilGroup F) (n : ℤ), ActsAsFrobPow F σ n → f σ = Multiplicative.ofAdd n)
      ⟨f₀, hf₀_spec⟩
  have h_ker_I : ∀ σ : weilGroup F, weilDegreeHom F σ = 1 → (σ : AbsGal F) ∈ inertia F := by
    intro σ hdeg1
    let n := (hex_frob σ).choose
    have hn_spec : ActsAsFrobPow F (σ : AbsGal F) n := (hex_frob σ).choose_spec
    have h1 : Multiplicative.ofAdd n = Multiplicative.ofAdd (0 : ℤ) := by
      rw [← hdeg_spec σ n hn_spec, hdeg1, ofAdd_zero]
    have hn0 : n = 0 := Multiplicative.ofAdd.injective h1
    rw [hn0] at hn_spec
    let K_fix : IntermediateField F (AlgebraicClosure F) :=
      { carrier := {x : AlgebraicClosure F | (σ : AbsGal F) x = x}
        algebraMap_mem' := fun r => (σ : AbsGal F).commutes r
        zero_mem' := map_zero (σ : AbsGal F)
        one_mem' := map_one (σ : AbsGal F)
        add_mem' := fun {a b} ha hb => by
          change (σ : AbsGal F) (a + b) = a + b
          rw [map_add, ha, hb]
        mul_mem' := fun {a b} ha hb => by
          change (σ : AbsGal F) (a * b) = a * b
          rw [map_mul, ha, hb]
        inv_mem' := fun {a} ha => by
          change (σ : AbsGal F) a⁻¹ = a⁻¹
          rw [map_inv₀, ha] }
    have hle : unramifiedClosure F ≤ K_fix := by
      unfold unramifiedClosure
      rw [IntermediateField.adjoin_le_iff]
      intro y hy
      have hy0 := hn_spec y hy
      change (σ : AbsGal F) y ^ (q F ^ (-(0 : ℤ)).toNat) = y ^ (q F ^ (0 : ℤ).toNat) at hy0
      simpa using hy0
    change (σ : AbsGal F) ∈ (unramifiedClosure F).fixingSubgroup
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact hle hx
  let d_L : relWeil F L →* Multiplicative ℤ :=
    (weilDegreeHom F).comp (Subgroup.inclusion (relWeil_le_weilGroup F L))
  have hω_of_dL_eq : ∀ w₁ w₂ : relWeil F L, d_L w₁ = d_L w₂ → ω w₁ = ω w₂ := by
    intro w₁ w₂ hd
    have hd1 : d_L (w₁⁻¹ * w₂) = 1 := by
      rw [map_mul, map_inv, hd, inv_mul_cancel]
    have hI : ((w₁⁻¹ * w₂ : relWeil F L) : AbsGal F) ∈ inertia F :=
      h_ker_I (Subgroup.inclusion (relWeil_le_weilGroup F L) (w₁⁻¹ * w₂)) hd1
    have hω1 : ω (w₁⁻¹ * w₂) = 1 := hω_I (w₁⁻¹ * w₂) hI
    rw [map_mul, map_inv, inv_mul_eq_one] at hω1
    exact hω1
  
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (RingHom.injective (IntermediateField.inclusion hLK).toRingHom)
  obtain ⟨_, _, _, _, _, _, hval_surj_L, _, hunit0_L, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨haddVal1, _, haddVal_mul, _, _, _, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  have hrel1 : relVal F L 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
  have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
      relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
    intro u n
    induction n with
    | zero => simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hfL_ne : (resDeg F L : ℤ) ≠ 0 := by
    intro h0
    obtain ⟨c₁, hc₁⟩ := hval_surj_L 1
    unfold valL at hc₁
    rw [h0, Int.ediv_zero] at hc₁
    omega
  have hrel_unit0 : ∀ u ∈ unitGroup F L 0, relVal F L (u : L) = 0 := by
    intro u hu
    have hu_pow : u ^ (resDeg F L) ∈ unitGroup F L 0 :=
      Subgroup.pow_mem _ hu (resDeg F L)
    have hval_pow : valL F L (((u ^ (resDeg F L) : Lˣ) : L)) = 0 :=
      (hunit0_L (u ^ (resDeg F L))).mp hu_pow
    unfold valL at hval_pow
    rw [hrel_pow u (resDeg F L), Int.mul_ediv_cancel_left _ hfL_ne] at hval_pow
    exact hval_pow
  
  let K' := IntermediateField.extendScalars hLK
  have hrelVal_norm : ∀ y : K, relVal F L (normLM F hLK y) = relVal F K y := by
    intro y
    let eF : K ≃ₐ[F] K' :=
      { toExtendScalars F hLK with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLK).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F K' := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y))) =
      addVal F (Algebra.norm F y)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y)) =
        Algebra.norm F (toExtendScalars F hLK y) := Algebra.norm_norm
    have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hLK y) :=
      Algebra.norm_eq_of_algEquiv eF y
    rw [h1, ← h2]
  
  have hω'_one : ω (rec.recMap L 1) = 1 := by
    have hd : d_L (rec.recMap L 1) = d_L 1 := by
      change weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F L) (rec.recMap L 1)) =
        d_L 1
      rw [rec.degree_rec L 1, Units.val_one, hrel1, neg_zero, ofAdd_zero, map_one]
    rw [hω_of_dL_eq (rec.recMap L 1) 1 hd, map_one]
  have hω'_mul : ∀ x₁ x₂ : Lˣ,
      ω (rec.recMap L (x₁ * x₂)) = ω (rec.recMap L x₁) * ω (rec.recMap L x₂) := by
    intro x₁ x₂
    have hd : d_L (rec.recMap L (x₁ * x₂)) = d_L (rec.recMap L x₁ * rec.recMap L x₂) := by
      rw [map_mul]
      change weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F L) (rec.recMap L (x₁ * x₂))) =
        weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F L) (rec.recMap L x₁)) *
          weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F L) (rec.recMap L x₂))
      rw [rec.degree_rec L (x₁ * x₂), rec.degree_rec L x₁, rec.degree_rec L x₂,
        Units.val_mul, hrel_mul _ _ (Units.ne_zero x₁) (Units.ne_zero x₂),
        neg_add, ofAdd_add]
    rw [hω_of_dL_eq _ _ hd, map_mul]
  let ω' : Lˣ →* (Ω F)ˣ :=
    { toFun := fun x => ω (rec.recMap L x)
      map_one' := hω'_one
      map_mul' := hω'_mul }
  refine ⟨ω', fun _ => rfl, ?_, ?_⟩
  · intro u hu
    change ω (rec.recMap L u) = 1
    have hd : d_L (rec.recMap L u) = d_L 1 := by
      change weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F L) (rec.recMap L u)) =
        d_L 1
      rw [rec.degree_rec L u, hrel_unit0 u hu, neg_zero, ofAdd_zero, map_one]
    rw [hω_of_dL_eq (rec.recMap L u) 1 hd, map_one]
  · intro y
    let x : Lˣ := Units.map (normLM F hLK) y
    let w_K : relWeil F L := Subgroup.inclusion (relWeil_antitone F hLK) (rec.recMap K y)
    change ω (rec.recMap L x) = ω w_K
    apply hω_of_dL_eq
    have hd_x : d_L (rec.recMap L x) = Multiplicative.ofAdd (-relVal F K (y : K)) := by
      change weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F L) (rec.recMap L x)) = _
      rw [rec.degree_rec L x]
      change Multiplicative.ofAdd (-relVal F L (normLM F hLK (y : K))) = _
      rw [hrelVal_norm (y : K)]
    have hd_wK : d_L w_K = Multiplicative.ofAdd (-relVal F K (y : K)) := by
      change weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F K) (rec.recMap K y)) = _
      exact rec.degree_rec K y
    rw [hd_x, hd_wK]

theorem ld_separable_unitGroup_sub_norm_range (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hLM : L ≤ M) (hSep : Algebra.IsSeparable L (IntermediateField.extendScalars hLM)) :
    ∃ a : ℕ, 1 ≤ a ∧ ∀ u ∈ unitGroup F L a, (u : L) ∈ Set.range (normLM F hLM) :=
by
  let M' := IntermediateField.extendScalars hLM
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLM).toLinearMap
      (IntermediateField.inclusion hLM).injective
  haveI : FiniteDimensional F M' := ‹FiniteDimensional F M›
  haveI : IsScalarTower F L M' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : FiniteDimensional L M' := FiniteDimensional.right F L M'
  obtain ⟨z₀', hz₀'⟩ := Algebra.trace_surjective L M' (1 : L)
  let z₀ : M := ⟨z₀'.1, (IntermediateField.mem_extendScalars hLM).mp z₀'.2⟩
  let ιLM := IntermediateField.inclusion hLM
  let f : L → L := fun x => normLM F hLM (1 + ιLM x * z₀)
  let R_L : L → L := fun x => f x - 1 - x
  letI : Fintype (M' →ₐ[L] AlgebraicClosure F) :=
    minpoly.AlgHom.fintype L M' (AlgebraicClosure F)
  let P : Finset (M' →ₐ[L] AlgebraicClosure F) → AlgebraicClosure F → AlgebraicClosure F :=
    fun s w => ∏ σ ∈ s, (1 + w * σ z₀')
  let T : Finset (M' →ₐ[L] AlgebraicClosure F) → AlgebraicClosure F :=
    fun s => ∑ σ ∈ s, σ z₀'
  let R : Finset (M' →ₐ[L] AlgebraicClosure F) → AlgebraicClosure F → AlgebraicClosure F :=
    fun s w => P s w - 1 - w * T s
  have hf_coe : ∀ x : L, (f x : AlgebraicClosure F) =
      P Finset.univ (x : AlgebraicClosure F) := by
    intro x
    change algebraMap L (AlgebraicClosure F) (Algebra.norm L (1 + algebraMap L M' x * z₀')) = _
    rw [Algebra.norm_eq_prod_embeddings L (AlgebraicClosure F) (1 + algebraMap L M' x * z₀')]
    refine Finset.prod_congr rfl (fun σ _ => ?_)
    rw [map_add, map_one, map_mul, AlgHom.commutes]
    rfl
  have hT_univ : T Finset.univ = 1 := by
    change (∑ σ : M' →ₐ[L] AlgebraicClosure F, σ z₀') = 1
    rw [← trace_eq_sum_embeddings (AlgebraicClosure F) (x := z₀'), hz₀', map_one]
  have hR_L_coe : ∀ x : L, (R_L x : AlgebraicClosure F) =
      R Finset.univ (x : AlgebraicClosure F) := by
    intro x
    change (f x : AlgebraicClosure F) - 1 - (x : AlgebraicClosure F) =
      P Finset.univ (x : AlgebraicClosure F) - 1 - (x : AlgebraicClosure F) * T Finset.univ
    rw [hf_coe x, hT_univ, mul_one]
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
    Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
  haveI : Algebra.IsAlgebraic F L := Algebra.IsAlgebraic.of_finite F L
  letI : NontriviallyNormedField L := spectralNorm.nontriviallyNormedField F L
  haveI : CompleteSpace L := spectralNorm.completeSpace F L
  haveI : IsUltrametricDist L := IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
    (isNonarchimedean_spectralNorm (K := F) (L := L))
  have hnorm_coe : ∀ x : L,
      spectralNorm F (AlgebraicClosure F) (x : AlgebraicClosure F) = ‖x‖ := by
    intro x
    have hmin_coe : minpoly F (x : AlgebraicClosure F) = minpoly F x :=
      minpoly.algHom_eq L.val L.val.injective x
    change spectralNorm F (AlgebraicClosure F) (x : AlgebraicClosure F) = spectralNorm F L x
    rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow,
      spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
  have hR_bound : ∀ s : Finset (M' →ₐ[L] AlgebraicClosure F),
      ∃ C_s : ℝ, 0 ≤ C_s ∧ R s 0 = 0 ∧
        ∀ x y : AlgebraicClosure F,
          spectralNorm F (AlgebraicClosure F) x ≤ 1 →
          spectralNorm F (AlgebraicClosure F) y ≤ 1 →
          spectralNorm F (AlgebraicClosure F) (R s x - R s y) ≤
            C_s * (spectralNorm F (AlgebraicClosure F) x +
              spectralNorm F (AlgebraicClosure F) y) *
              spectralNorm F (AlgebraicClosure F) (x - y) := by
    letI : NontriviallyNormedField (AlgebraicClosure F) :=
      spectralNorm.nontriviallyNormedField F (AlgebraicClosure F)
    change ∀ s : Finset (M' →ₐ[L] AlgebraicClosure F),
      ∃ C_s : ℝ, 0 ≤ C_s ∧ R s 0 = 0 ∧
        ∀ x y : AlgebraicClosure F, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 →
          ‖R s x - R s y‖ ≤ C_s * (‖x‖ + ‖y‖) * ‖x - y‖
    intro s
    induction s using Finset.cons_induction with
    | empty =>
      refine ⟨0, le_rfl, ?_, ?_⟩
      · simp [R, P, T]
      · intro x y _ _
        simp [R, P, T]
    | cons a s ha ih =>
      rcases ih with ⟨Cs, hCs_nonneg, hRs0, hRs⟩
      refine ⟨(1 + 2 * ‖a z₀'‖) * Cs + ‖a z₀' * T s‖, by positivity, ?_, ?_⟩
      · simp [R, P, T]
      · intro x y hx hy
        have hP_cons : ∀ w, P (Finset.cons a s ha) w = (1 + w * a z₀') * P s w :=
          fun w => Finset.prod_cons ha
        have hT_cons : T (Finset.cons a s ha) = a z₀' + T s :=
          Finset.sum_cons ha
        have hR_diff : R (Finset.cons a s ha) x - R (Finset.cons a s ha) y =
            (1 + x * a z₀') * (R s x - R s y) + (x - y) * a z₀' * R s y +
              (x + y) * (x - y) * (a z₀' * T s) := by
          dsimp only [R]
          rw [hP_cons x, hP_cons y, hT_cons]
          ring
        have hRsy : ‖R s y‖ ≤ Cs * (‖x‖ + ‖y‖) := by
          have h0 : ‖R s y - R s 0‖ ≤ Cs * (‖y‖ + ‖(0 : AlgebraicClosure F)‖) * ‖y - 0‖ :=
            hRs y 0 hy (by simp)
          rw [hRs0, sub_zero, norm_zero, add_zero, sub_zero] at h0
          have hy_sq : Cs * ‖y‖ * ‖y‖ ≤ Cs * (‖x‖ + ‖y‖) := by
            have h1 : Cs * ‖y‖ * ‖y‖ ≤ Cs * ‖y‖ * 1 := by gcongr
            have h2 : Cs * ‖y‖ * 1 ≤ Cs * (‖x‖ + ‖y‖) := by
              rw [mul_one]
              gcongr
              linarith [norm_nonneg x]
            exact le_trans h1 h2
          exact le_trans h0 hy_sq
        have hterm1 : ‖(1 + x * a z₀') * (R s x - R s y)‖ ≤
            (1 + ‖a z₀'‖) * Cs * (‖x‖ + ‖y‖) * ‖x - y‖ := by
          rw [norm_mul]
          have h1x : ‖1 + x * a z₀'‖ ≤ 1 + ‖a z₀'‖ := by
            calc ‖1 + x * a z₀'‖ ≤ ‖(1 : AlgebraicClosure F)‖ + ‖x * a z₀'‖ := norm_add_le _ _
              _ = 1 + ‖x‖ * ‖a z₀'‖ := by rw [norm_one, norm_mul]
              _ ≤ 1 + 1 * ‖a z₀'‖ := by gcongr
              _ = 1 + ‖a z₀'‖ := by ring
          calc ‖1 + x * a z₀'‖ * ‖R s x - R s y‖
              ≤ (1 + ‖a z₀'‖) * (Cs * (‖x‖ + ‖y‖) * ‖x - y‖) := by
                gcongr
                exact hRs x y hx hy
            _ = (1 + ‖a z₀'‖) * Cs * (‖x‖ + ‖y‖) * ‖x - y‖ := by ring
        have hterm2 : ‖(x - y) * a z₀' * R s y‖ ≤
            ‖a z₀'‖ * Cs * (‖x‖ + ‖y‖) * ‖x - y‖ := by
          rw [norm_mul, norm_mul]
          calc ‖x - y‖ * ‖a z₀'‖ * ‖R s y‖
              ≤ ‖x - y‖ * ‖a z₀'‖ * (Cs * (‖x‖ + ‖y‖)) := by gcongr
            _ = ‖a z₀'‖ * Cs * (‖x‖ + ‖y‖) * ‖x - y‖ := by ring
        have hterm3 : ‖(x + y) * (x - y) * (a z₀' * T s)‖ ≤
            ‖a z₀' * T s‖ * (‖x‖ + ‖y‖) * ‖x - y‖ := by
          rw [norm_mul, norm_mul]
          have hxy : ‖x + y‖ ≤ ‖x‖ + ‖y‖ := norm_add_le x y
          calc ‖x + y‖ * ‖x - y‖ * ‖a z₀' * T s‖
              ≤ (‖x‖ + ‖y‖) * ‖x - y‖ * ‖a z₀' * T s‖ := by gcongr
            _ = ‖a z₀' * T s‖ * (‖x‖ + ‖y‖) * ‖x - y‖ := by ring
        rw [hR_diff]
        calc ‖(1 + x * a z₀') * (R s x - R s y) + (x - y) * a z₀' * R s y +
              (x + y) * (x - y) * (a z₀' * T s)‖
            ≤ ‖(1 + x * a z₀') * (R s x - R s y) + (x - y) * a z₀' * R s y‖ +
              ‖(x + y) * (x - y) * (a z₀' * T s)‖ := norm_add_le _ _
          _ ≤ ‖(1 + x * a z₀') * (R s x - R s y)‖ + ‖(x - y) * a z₀' * R s y‖ +
              ‖(x + y) * (x - y) * (a z₀' * T s)‖ := by
                gcongr
                exact norm_add_le _ _
          _ ≤ (1 + ‖a z₀'‖) * Cs * (‖x‖ + ‖y‖) * ‖x - y‖ +
              ‖a z₀'‖ * Cs * (‖x‖ + ‖y‖) * ‖x - y‖ +
              ‖a z₀' * T s‖ * (‖x‖ + ‖y‖) * ‖x - y‖ := by gcongr
          _ = ((1 + 2 * ‖a z₀'‖) * Cs + ‖a z₀' * T s‖) * (‖x‖ + ‖y‖) * ‖x - y‖ := by ring
  obtain ⟨C₀, hC₀_nonneg, hR_univ0, hR_univ⟩ := hR_bound Finset.univ
  have hR_L0 : R_L 0 = 0 := by
    apply L.val.injective
    change (R_L 0 : AlgebraicClosure F) = 0
    rw [hR_L_coe 0]
    exact hR_univ0
  have hR_L_bound : ∀ x y : L, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 →
      ‖R_L x - R_L y‖ ≤ C₀ * (‖x‖ + ‖y‖) * ‖x - y‖ := by
    intro x y hx hy
    have hcoe_sub : ((R_L x - R_L y : L) : AlgebraicClosure F) =
        R Finset.univ (x : AlgebraicClosure F) - R Finset.univ (y : AlgebraicClosure F) := by
      change (R_L x : AlgebraicClosure F) - (R_L y : AlgebraicClosure F) = _
      rw [hR_L_coe x, hR_L_coe y]
    have hcoe_xy : (((x - y : L) : AlgebraicClosure F)) =
        (x : AlgebraicClosure F) - (y : AlgebraicClosure F) := rfl
    have h1 := hR_univ (x : AlgebraicClosure F) (y : AlgebraicClosure F)
    rw [← hcoe_sub, ← hcoe_xy, hnorm_coe, hnorm_coe, hnorm_coe, hnorm_coe] at h1
    exact h1 hx hy
  let ε : ℝ := min 1 (1 / (4 * C₀ + 4))
  have hε_pos : 0 < ε := by
    dsimp [ε]
    refine lt_min zero_lt_one ?_
    positivity
  have hε_le_one : ε ≤ 1 := min_le_left _ _
  have hC₀_ε : C₀ * (2 * ε) ≤ 1 / 2 := by
    have h1 : ε ≤ 1 / (4 * C₀ + 4) := min_le_right _ _
    calc C₀ * (2 * ε) ≤ C₀ * (2 * (1 / (4 * C₀ + 4))) := by gcongr
      _ = (2 * C₀) / (4 * C₀ + 4) := by ring
      _ ≤ 1 / 2 := by
        rw [div_le_iff₀ (by positivity)]
        linarith
  have hball_norm : ∀ z : L, ‖z - 1‖ ≤ ε → z ∈ Set.range (normLM F hLM) := by
    intro z hz
    let B := Metric.closedBall (0 : L) ε
    have hsc : IsComplete B := Metric.isClosed_closedBall.isComplete
    have h0_mem : (0 : L) ∈ B := mem_closedBall_zero_iff.mpr (by rw [norm_zero]; exact le_of_lt hε_pos)
    have hR_L_lip : ∀ x ∈ B, ∀ y ∈ B, ‖R_L x - R_L y‖ ≤ (1 / 2 : ℝ) * ‖x - y‖ := by
      intro x hx y hy
      have hx_le : ‖x‖ ≤ ε := mem_closedBall_zero_iff.mp hx
      have hy_le : ‖y‖ ≤ ε := mem_closedBall_zero_iff.mp hy
      have hx1 : ‖x‖ ≤ 1 := le_trans hx_le hε_le_one
      have hy1 : ‖y‖ ≤ 1 := le_trans hy_le hε_le_one
      calc ‖R_L x - R_L y‖ ≤ C₀ * (‖x‖ + ‖y‖) * ‖x - y‖ := hR_L_bound x y hx1 hy1
        _ ≤ C₀ * (2 * ε) * ‖x - y‖ := by
          gcongr
          linarith
        _ ≤ (1 / 2 : ℝ) * ‖x - y‖ := by gcongr
    let Φ : L → L := fun x => (z - 1) - R_L x
    have hsf : Set.MapsTo Φ B B := by
      intro x hx
      rw [mem_closedBall_zero_iff]
      have hx_R : ‖R_L x‖ ≤ ε := by
        have h0 := hR_L_lip x hx 0 h0_mem
        rw [hR_L0, sub_zero, sub_zero] at h0
        have hx_le : ‖x‖ ≤ ε := mem_closedBall_zero_iff.mp hx
        linarith [norm_nonneg x]
      have hna : ‖(z - 1) + (-R_L x)‖ ≤ max ‖z - 1‖ ‖-R_L x‖ :=
        isNonarchimedean_spectralNorm (K := F) (L := L) (z - 1) (-R_L x)
      rw [← sub_eq_add_neg, norm_neg] at hna
      exact le_trans hna (max_le hz hx_R)
    let K_lip : NNReal := ⟨1 / 2, by norm_num⟩
    have hf_lip : LipschitzWith K_lip (Set.MapsTo.restrict Φ B B hsf) := by
      apply LipschitzWith.of_dist_le_mul
      intro x y
      change dist (Φ x.1) (Φ y.1) ≤ (1 / 2 : ℝ) * dist x.1 y.1
      rw [dist_eq_norm, dist_eq_norm]
      have hsub : Φ x.1 - Φ y.1 = -(R_L x.1 - R_L y.1) := by
        dsimp [Φ]
        ring
      rw [hsub, norm_neg]
      exact hR_L_lip x.1 x.2 y.1 y.2
    have hf_contr : ContractingWith K_lip (Set.MapsTo.restrict Φ B B hsf) :=
      ⟨by change (1 / 2 : ℝ) < 1; norm_num, hf_lip⟩
    let x_z := ContractingWith.efixedPoint' Φ hsc hsf hf_contr 0 h0_mem (edist_ne_top 0 (Φ 0))
    have hx_fixed : Φ x_z = x_z :=
      ContractingWith.efixedPoint_isFixedPt' hsc hsf hf_contr h0_mem (edist_ne_top 0 (Φ 0))
    refine ⟨1 + ιLM x_z * z₀, ?_⟩
    change f x_z = z
    have hfx : f x_z = 1 + x_z + R_L x_z := by
      dsimp [R_L]
      ring
    dsimp [Φ] at hx_fixed
    linear_combination hfx - hx_fixed
  have halg : ∀ z : L,
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F L = (minpoly F z).natDegree * m := by
    intro z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨_, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  have hspec_pow : ∀ z : L, ‖z‖ ^ (Module.finrank F L) = ‖Algebra.norm F z‖ := by
    intro z
    obtain ⟨m, hnorm_adj, hfinrank⟩ := halg z
    have hspec : ‖z‖ = ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) :=
      spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F L z
    have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
      rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
      exact_mod_cast minpoly.natDegree_pos hz
    rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
       ← Real.rpow_natCast]
    congr 1
    push_cast
    rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → ‖a‖ ≤ ‖b‖ → b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hle
    have hv_eq : ∀ c : F, ‖c‖ =
        ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
          (valuation F c) : ℝ) := fun _ => rfl
    rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hle
    have hab : valuation F a ≤ valuation F b :=
      (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp hle
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : L := algebraMap F L π
  have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
  have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
  let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
  have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfL_pos : 0 < resDeg F L := (Nat.sInf_mem hS_nonempty).1
  have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
  have hπ_lt : ‖π‖ < 1 := by
    by_contra hge
    push_neg at hge
    rw [← norm_one (α := F)] at hge
    have h1 := (hval_le 1 π one_ne_zero hge).2
    rw [hadd_π, haddVal1] at h1
    omega
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one (pow_pos hε_pos (Module.finrank F L)) hπ_lt
  refine ⟨n + 1, by omega, ?_⟩
  intro u hu
  refine Subgroup.closure_induction ?_ ?_ ?_ ?_ hu
  · intro w hw
    simp only [Set.mem_setOf_eq, Nat.add_eq_zero_iff, one_ne_zero, and_false, ↓reduceIte] at hw
    rcases hw with hw1 | hval_w
    · refine ⟨1, ?_⟩
      rw [map_one, hw1]
    · apply hball_norm (w : L)
      by_cases hw_sub : (w : L) - 1 = 0
      · rw [hw_sub, norm_zero]
        exact le_of_lt hε_pos
      · by_contra hgt
        push_neg at hgt
        have hpow_le : ε ^ (Module.finrank F L) ≤ ‖(w : L) - 1‖ ^ (Module.finrank F L) :=
          pow_le_pow_left₀ (le_of_lt hε_pos) (le_of_lt hgt) _
        rw [hspec_pow] at hpow_le
        have hπn_le : ‖π ^ n‖ ≤ ‖Algebra.norm F ((w : L) - 1)‖ := by
          rw [norm_pow]
          exact le_of_lt (lt_of_lt_of_le hn hpow_le)
        have hadd_le := (hval_le (π ^ n) (Algebra.norm F ((w : L) - 1))
          (pow_ne_zero n hπ_ne) hπn_le).2
        rw [haddVal_pow π n hπ_ne, hadd_π, mul_one] at hadd_le
        unfold valL relVal at hval_w
        rw [Int.le_ediv_iff_mul_le hfL_int_pos] at hval_w
        have h1 : ((n + 1 : ℕ) : ℤ) * 1 ≤ ((n + 1 : ℕ) : ℤ) * (resDeg F L : ℤ) :=
          mul_le_mul_of_nonneg_left (by omega) (by positivity)
        omega
  · exact ⟨1, map_one _⟩
  · rintro w₁ w₂ _ _ ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩
    refine ⟨y₁ * y₂, ?_⟩
    rw [map_mul, hy₁, hy₂, Units.val_mul]
  · rintro w _ ⟨y, hy⟩
    refine ⟨y⁻¹, ?_⟩
    have hy_ne : y ≠ 0 := by
      intro h0
      have hnorm0 : normLM F hLM y = 0 := by
        change Algebra.norm L (toExtendScalars F hLM y) = 0
        rw [h0, map_zero, Algebra.norm_zero]
      rw [hnorm0] at hy
      exact Units.ne_zero w hy.symm
    have hmul : normLM F hLM y * normLM F hLM y⁻¹ = 1 := by
      rw [← map_mul, mul_inv_cancel₀ hy_ne, map_one]
    rw [hy] at hmul
    exact (Units.inv_eq_of_mul_eq_one_right hmul).symm

theorem ld_recMap_uniformizer_frob_on_primeToP_roots (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
    (hLK : L ≤ K) (y : Kˣ) (hy : valL F K (y : K) = 1) :
    0 < resDeg F K ∧
    2 ≤ q F ∧
    ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      (rec.recMap K y : AbsGal F)⁻¹ ζ = ζ ^ ((q F) ^ (resDeg F K)) ∧
      (rec.recMap L (Units.map (normLM F hLK) y) : AbsGal F) ζ =
        (rec.recMap K y : AbsGal F) ζ :=
by
  
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  haveI : CharP 𝓀[F] (p F) := ringChar.of_eq rfl
  haveI : Finite 𝓀[F] :=
    IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  obtain ⟨r_p, _, hcard_k⟩ := FiniteField.card 𝓀[F] (p F)
  have hq_eq : q F = (p F) ^ (r_p : ℕ) := Nat.card_eq_fintype_card.trans hcard_k
  have hp_dvd_q : p F ∣ q F := hq_eq ▸ dvd_pow_self (p F) r_p.ne_zero
  have hq_gt1 : 1 < q F := hq_eq ▸ one_lt_pow₀ hp.one_lt r_p.ne_zero
  have hq_ge2 : 2 ≤ q F := hq_gt1
  have hS_map : ∀ (σ : AbsGal F) {ζ : AlgebraicClosure F},
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (σ ζ) := by
    rintro σ ζ ⟨N, hN, hpN, hζN⟩
    refine ⟨N, hN, hpN, ?_⟩
    rw [← map_pow, hζN, map_one]
  have h_qpow_inj : ∀ (N : ℕ), 0 < N → ¬ p F ∣ N → ∀ (c : ℕ) (ξ₁ ξ₂ : AlgebraicClosure F),
      ξ₁ ^ N = 1 → ξ₂ ^ N = 1 → ξ₁ ^ ((q F) ^ c) = ξ₂ ^ ((q F) ^ c) → ξ₁ = ξ₂ := by
    intro N hN hpN c ξ₁ ξ₂ hξ₁ hξ₂ heq
    obtain ⟨τ, hτ⟩ := (hFrob N hN hpN).2.1
    have hτ_pow : ∀ (k : ℕ) (ξ : AlgebraicClosure F), ξ ^ N = 1 → (τ ^ k) ξ = ξ ^ ((q F) ^ k) := by
      intro k
      induction k with
      | zero =>
        intro ξ _
        simp
      | succ k ih =>
        intro ξ hξ
        have hξ_pow : (ξ ^ ((q F) ^ k)) ^ N = 1 := by
          rw [← pow_mul, mul_comm _ N, pow_mul, hξ, one_pow]
        rw [pow_succ', AlgEquiv.mul_apply, ih ξ hξ, hτ _ hξ_pow, ← pow_mul, ← pow_succ]
    apply (τ ^ c).injective
    rw [hτ_pow c ξ₁ hξ₁, hτ_pow c ξ₂ hξ₂, heq]
  
  have h_frob_one : ActsAsFrobPow F 1 0 := by
    intro ζ _
    rfl
  have h_frob_inv : ∀ (σ : AbsGal F) (n : ℤ),
      ActsAsFrobPow F σ n → ActsAsFrobPow F σ⁻¹ (-n) := by
    intro σ n hσ ζ hζ
    have h1 := hσ (σ⁻¹ ζ) (hS_map σ⁻¹ hζ)
    have h2 : σ (σ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h2] at h1
    change (σ⁻¹ ζ) ^ (q F ^ (-(-n)).toNat) = ζ ^ (q F ^ (-n).toNat)
    rw [neg_neg, ← h1]
  have h_frob_mul : ∀ (σ₁ σ₂ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F σ₁ n₁ → ActsAsFrobPow F σ₂ n₂ →
      ActsAsFrobPow F (σ₁ * σ₂) (n₁ + n₂) := by
    intro σ₁ σ₂ n₁ n₂ hσ₁ hσ₂ ζ hζ
    rcases hζ with ⟨N, hN_pos, hpN, hζN⟩
    have hζ_S : IsPrimeToPRootOfUnity F ζ := ⟨N, hN_pos, hpN, hζN⟩
    set a₁ := n₁.toNat
    set b₁ := (-n₁).toNat
    set a₂ := n₂.toNat
    set b₂ := (-n₂).toNat
    set a₃ := (n₁ + n₂).toNat
    set b₃ := (-(n₁ + n₂)).toNat
    set c := (a₁ + a₂) - a₃
    have ha_eq : a₃ + c = a₁ + a₂ := by omega
    have hb_eq : b₃ + c = b₁ + b₂ := by omega
    let ξ₁ : AlgebraicClosure F := ((σ₁ * σ₂) ζ) ^ ((q F) ^ b₃)
    let ξ₂ : AlgebraicClosure F := ζ ^ ((q F) ^ a₃)
    have hξ₁N : ξ₁ ^ N = 1 := by
      change (((σ₁ * σ₂) ζ) ^ ((q F) ^ b₃)) ^ N = 1
      rw [← pow_mul, mul_comm _ N, pow_mul, ← map_pow, hζN, map_one, one_pow]
    have hξ₂N : ξ₂ ^ N = 1 := by
      change (ζ ^ ((q F) ^ a₃)) ^ N = 1
      rw [← pow_mul, mul_comm _ N, pow_mul, hζN, one_pow]
    apply h_qpow_inj N hN_pos hpN c ξ₁ ξ₂ hξ₁N hξ₂N
    dsimp [ξ₁, ξ₂]
    have h1 := hσ₁ (σ₂ ζ) (hS_map σ₂ hζ_S)
    have h2 := hσ₂ ζ hζ_S
    calc (((σ₁ * σ₂) ζ) ^ ((q F) ^ b₃)) ^ ((q F) ^ c)
      _ = (σ₁ (σ₂ ζ)) ^ ((q F) ^ (b₃ + c)) := by
        rw [AlgEquiv.mul_apply, ← pow_mul, ← pow_add]
      _ = ((σ₁ (σ₂ ζ)) ^ ((q F) ^ b₁)) ^ ((q F) ^ b₂) := by
        rw [hb_eq, pow_add, pow_mul]
      _ = ((σ₂ ζ) ^ ((q F) ^ a₁)) ^ ((q F) ^ b₂) := by
        rw [h1]
      _ = ((σ₂ ζ) ^ ((q F) ^ b₂)) ^ ((q F) ^ a₁) := by
        rw [← pow_mul, mul_comm ((q F) ^ a₁) ((q F) ^ b₂), pow_mul]
      _ = (ζ ^ ((q F) ^ a₂)) ^ ((q F) ^ a₁) := by
        rw [h2]
      _ = ζ ^ ((q F) ^ (a₁ + a₂)) := by
        rw [← pow_mul, ← pow_add, add_comm a₂ a₁]
      _ = (ζ ^ ((q F) ^ a₃)) ^ ((q F) ^ c) := by
        rw [← ha_eq, pow_add, pow_mul]
  have h_frob_one_pos : ∀ k : ℕ, 0 < k → ¬ ActsAsFrobPow F 1 (k : ℤ) := by
    intro k hk hk_frob
    let N : ℕ := (q F) ^ (k + 1) - 1
    have hqk_gt1 : 1 < (q F) ^ k := one_lt_pow₀ hq_gt1 (Nat.ne_of_gt hk)
    have hqk_lt : (q F) ^ k < (q F) ^ (k + 1) :=
      Nat.pow_lt_pow_right hq_gt1 (Nat.lt_succ_self k)
    have hN_pos : 0 < N := by
      dsimp [N]
      omega
    have hp_dvd_N1 : p F ∣ N + 1 := by
      have hN1 : N + 1 = (q F) ^ (k + 1) := by
        dsimp [N]
        omega
      rw [hN1]
      exact dvd_trans hp_dvd_q (dvd_pow_self (q F) (Nat.succ_ne_zero k))
    have hpN : ¬ p F ∣ N := by
      intro hdvd
      have hdvd1 : p F ∣ 1 := (Nat.dvd_add_right hdvd).mp hp_dvd_N1
      exact hp.not_dvd_one hdvd1
    haveI : NeZero (N : F) := ⟨(hFrob N hN_pos hpN).1⟩
    obtain ⟨ζ, hζ_prim⟩ :=
      @HasEnoughRootsOfUnity.prim (AlgebraicClosure F) _ N
        (AlgebraicClosure.hasEnoughRootsOfUnity F N)
    have hζ_S : IsPrimeToPRootOfUnity F ζ := ⟨N, hN_pos, hpN, hζ_prim.pow_eq_one⟩
    have h1 := hk_frob ζ hζ_S
    have hneg : (-(k : ℤ)).toNat = 0 := by omega
    have hpos : (k : ℤ).toNat = k := Int.toNat_natCast k
    change ((1 : AbsGal F) ζ) ^ ((q F) ^ (-(k : ℤ)).toNat) = ζ ^ ((q F) ^ (k : ℤ).toNat) at h1
    rw [AlgEquiv.one_apply, hneg, hpos, pow_zero, pow_one] at h1
    let m : ℕ := (q F) ^ k - 1
    have hm_pos : 0 < m := by
      dsimp [m]
      omega
    have hm_lt : m < N := by
      dsimp [m, N]
      omega
    have hm_add : m + 1 = (q F) ^ k := by
      dsimp [m]
      omega
    have hζ_ne : ζ ≠ 0 := hζ_prim.ne_zero hN_pos.ne'
    have hζ_m : ζ ^ m = 1 := by
      apply mul_right_cancel₀ hζ_ne
      rw [← pow_succ, hm_add, one_mul]
      exact h1.symm
    have hdvd : N ∣ m := hζ_prim.dvd_of_pow_eq_one m hζ_m
    have hle : N ≤ m := Nat.le_of_dvd hm_pos hdvd
    omega
  have h_frob_unique : ∀ (σ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F σ n₁ → ActsAsFrobPow F σ n₂ → n₁ = n₂ := by
    intro σ n₁ n₂ h₁ h₂
    have h_diff : ActsAsFrobPow F 1 (-n₁ + n₂) := by
      rw [← inv_mul_cancel σ]
      exact h_frob_mul σ⁻¹ σ (-n₁) n₂ (h_frob_inv σ n₁ h₁) h₂
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · let k : ℕ := (-n₁ + n₂).toNat
      have hk_pos : 0 < k := by omega
      have hk_eq : (k : ℤ) = -n₁ + n₂ := by omega
      rw [← hk_eq] at h_diff
      exact h_frob_one_pos k hk_pos h_diff
    · have h_diff' : ActsAsFrobPow F 1 (-(-n₁ + n₂)) := by
        simpa using h_frob_inv 1 (-n₁ + n₂) h_diff
      let k : ℕ := (-(-n₁ + n₂)).toNat
      have hk_pos : 0 < k := by omega
      have hk_eq : (k : ℤ) = -(-n₁ + n₂) := by omega
      rw [← hk_eq] at h_diff'
      exact h_frob_one_pos k hk_pos h_diff'
  
  let W' : Subgroup (AbsGal F) :=
    { carrier := {σ : AbsGal F | ∃ n : ℤ, ActsAsFrobPow F σ n}
      one_mem' := ⟨0, h_frob_one⟩
      mul_mem' := fun ⟨n₁, h₁⟩ ⟨n₂, h₂⟩ => ⟨n₁ + n₂, h_frob_mul _ _ n₁ n₂ h₁ h₂⟩
      inv_mem' := fun ⟨n, h⟩ => ⟨-n, h_frob_inv _ n h⟩ }
  have hW_le : weilGroup F ≤ W' := by
    rw [weilGroup, Subgroup.closure_le]
    exact Set.Subset.refl _
  have hex_frob : ∀ σ : weilGroup F, ∃ n : ℤ, ActsAsFrobPow F (σ : AbsGal F) n :=
    fun σ => hW_le σ.2
  let f₀ : weilGroup F →* Multiplicative ℤ :=
    { toFun := fun σ => Multiplicative.ofAdd (hex_frob σ).choose
      map_one' := by
        have h0 : (hex_frob 1).choose = 0 :=
          h_frob_unique 1 _ 0 (hex_frob 1).choose_spec h_frob_one
        rw [h0, ofAdd_zero]
      map_mul' := fun σ₁ σ₂ => by
        have hmul : (hex_frob (σ₁ * σ₂)).choose =
            (hex_frob σ₁).choose + (hex_frob σ₂).choose :=
          h_frob_unique (σ₁ * σ₂).1 _ _ (hex_frob (σ₁ * σ₂)).choose_spec
            (h_frob_mul _ _ _ _ (hex_frob σ₁).choose_spec (hex_frob σ₂).choose_spec)
        rw [hmul, ofAdd_add] }
  have hf₀_spec : ∀ (σ : weilGroup F) (n : ℤ),
      ActsAsFrobPow F (σ : AbsGal F) n → f₀ σ = Multiplicative.ofAdd n := by
    intro σ n hσn
    have heq : (hex_frob σ).choose = n :=
      h_frob_unique σ.1 _ n (hex_frob σ).choose_spec hσn
    change Multiplicative.ofAdd (hex_frob σ).choose = Multiplicative.ofAdd n
    rw [heq]
  have hdeg_spec : ∀ (σ : weilGroup F) (n : ℤ),
      ActsAsFrobPow F (σ : AbsGal F) n → weilDegreeHom F σ = Multiplicative.ofAdd n :=
    Classical.epsilon_spec (p := fun f : weilGroup F →* Multiplicative ℤ =>
      ∀ (σ : weilGroup F) (n : ℤ), ActsAsFrobPow F σ n → f σ = Multiplicative.ofAdd n)
      ⟨f₀, hf₀_spec⟩
  have h_frob_of_deg : ∀ (σ : weilGroup F) (n : ℤ),
      weilDegreeHom F σ = Multiplicative.ofAdd n → ActsAsFrobPow F (σ : AbsGal F) n := by
    intro σ n hdeg
    let n₀ := (hex_frob σ).choose
    have hn₀ : ActsAsFrobPow F (σ : AbsGal F) n₀ := (hex_frob σ).choose_spec
    have h1 : Multiplicative.ofAdd n₀ = Multiplicative.ofAdd n := by
      rw [← hdeg_spec σ n₀ hn₀, hdeg]
    have heq : n₀ = n := Multiplicative.ofAdd.injective h1
    rw [← heq]
    exact hn₀
  
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (RingHom.injective (IntermediateField.inclusion hLK).toRingHom)
  obtain ⟨_, hval1_K, _, _, hval_mul_K, _, hval_surj_K, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, _, haddVal_mul, _, _, _, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F K
  have hrel1 : relVal F K 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x₁ x₂ : K, x₁ ≠ 0 → x₂ ≠ 0 → relVal F K (x₁ * x₂) = relVal F K x₁ + relVal F K x₂ := by
    intro x₁ x₂ hx₁ hx₂
    unfold relVal
    rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx₁) (Algebra.norm_ne_zero_iff.mpr hx₂)]
  have hrel_pow : ∀ (u : Kˣ) (n : ℕ),
      relVal F K (((u ^ n : Kˣ) : K)) = (n : ℤ) * relVal F K (u : K) := by
    intro u n
    induction n with
    | zero => simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hval_pow : ∀ (u : Kˣ) (n : ℕ),
      valL F K (((u ^ n : Kˣ) : K)) = (n : ℤ) * valL F K (u : K) := by
    intro u n
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hval_mul_K _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hfK_ne : (resDeg F K : ℤ) ≠ 0 := by
    intro h0
    obtain ⟨c₁, hc₁⟩ := hval_surj_K 1
    unfold valL at hc₁
    rw [h0, Int.ediv_zero] at hc₁
    omega
  have hfK_pos : 0 < resDeg F K := by omega
  have hrel_y : relVal F K (y : K) = (resDeg F K : ℤ) := by
    have hval_yf : valL F K (((y ^ (resDeg F K) : Kˣ) : K)) = (resDeg F K : ℤ) := by
      rw [hval_pow y (resDeg F K), hy, mul_one]
    unfold valL at hval_yf
    rw [hrel_pow y (resDeg F K), Int.mul_ediv_cancel_left _ hfK_ne] at hval_yf
    exact hval_yf
  
  let K' := IntermediateField.extendScalars hLK
  have hrelVal_norm : ∀ z : K, relVal F L (normLM F hLK z) = relVal F K z := by
    intro z
    let eF : K ≃ₐ[F] K' :=
      { toExtendScalars F hLK with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLK).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F K' := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLK z))) =
      addVal F (Algebra.norm F z)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLK z)) =
        Algebra.norm F (toExtendScalars F hLK z) := Algebra.norm_norm
    have h2 : Algebra.norm F z = Algebra.norm F (toExtendScalars F hLK z) :=
      Algebra.norm_eq_of_algEquiv eF z
    rw [h1, ← h2]
  
  set f_K := resDeg F K
  let x : Lˣ := Units.map (normLM F hLK) y
  let w_K : relWeil F K := rec.recMap K y
  let w_L : relWeil F L := rec.recMap L x
  have hwK_deg : weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F K) w_K) =
      Multiplicative.ofAdd (-(f_K : ℤ)) := by
    rw [rec.degree_rec K y, hrel_y]
  have hwK_frob : ActsAsFrobPow F (w_K : AbsGal F) (-(f_K : ℤ)) :=
    h_frob_of_deg (Subgroup.inclusion (relWeil_le_weilGroup F K) w_K) (-(f_K : ℤ)) hwK_deg
  have hrel_x : relVal F L (x : L) = (f_K : ℤ) := by
    change relVal F L (normLM F hLK (y : K)) = (f_K : ℤ)
    rw [hrelVal_norm (y : K), hrel_y]
  have hwL_deg : weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F L) w_L) =
      Multiplicative.ofAdd (-(f_K : ℤ)) := by
    rw [rec.degree_rec L x, hrel_x]
  have hwL_frob : ActsAsFrobPow F (w_L : AbsGal F) (-(f_K : ℤ)) :=
    h_frob_of_deg (Subgroup.inclusion (relWeil_le_weilGroup F L) w_L) (-(f_K : ℤ)) hwL_deg
  have hwK_inv_frob : ActsAsFrobPow F (w_K : AbsGal F)⁻¹ (f_K : ℤ) := by
    have h1 := h_frob_inv (w_K : AbsGal F) (-(f_K : ℤ)) hwK_frob
    rw [neg_neg] at h1
    exact h1
  have h_toNat_neg : (-(f_K : ℤ)).toNat = 0 := by omega
  have h_toNat_neg_neg : (-(-(f_K : ℤ))).toNat = f_K := by omega
  have h_toNat_pos : (f_K : ℤ).toNat = f_K := Int.toNat_natCast f_K
  refine ⟨hfK_pos, hq_ge2, fun ζ hζ => ⟨?_, ?_⟩⟩
  · have h1 := hwK_inv_frob ζ hζ
    change ((w_K : AbsGal F)⁻¹ ζ) ^ (q F ^ (-(f_K : ℤ)).toNat) = ζ ^ (q F ^ (f_K : ℤ).toNat) at h1
    rw [h_toNat_neg, h_toNat_pos, pow_zero, pow_one] at h1
    exact h1
  · rcases hζ with ⟨N, hN_pos, hpN, hζN⟩
    have hζ_S : IsPrimeToPRootOfUnity F ζ := ⟨N, hN_pos, hpN, hζN⟩
    have hL_N : ((w_L : AbsGal F) ζ) ^ N = 1 := by
      rw [← map_pow, hζN, map_one]
    have hK_N : ((w_K : AbsGal F) ζ) ^ N = 1 := by
      rw [← map_pow, hζN, map_one]
    apply h_qpow_inj N hN_pos hpN f_K ((w_L : AbsGal F) ζ) ((w_K : AbsGal F) ζ) hL_N hK_N
    have hL_pow := hwL_frob ζ hζ_S
    change ((w_L : AbsGal F) ζ) ^ (q F ^ (-(-(f_K : ℤ))).toNat) = ζ ^ (q F ^ (-(f_K : ℤ)).toNat) at hL_pow
    rw [h_toNat_neg_neg, h_toNat_neg, pow_zero, pow_one] at hL_pow
    have hK_pow := hwK_frob ζ hζ_S
    change ((w_K : AbsGal F) ζ) ^ (q F ^ (-(-(f_K : ℤ))).toNat) = ζ ^ (q F ^ (-(f_K : ℤ)).toNat) at hK_pow
    rw [h_toNat_neg_neg, h_toNat_neg, pow_zero, pow_one] at hK_pow
    rw [hL_pow, hK_pow]

theorem ld_abelian_compositum_and_cyclotomic_ext (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM : L ≤ M)
    (hGalK : IsGaloisExt F L K) (hAbK : IsAbelianExt F hLK)
    (hGalM : IsGaloisExt F L M) (hAbM : IsAbelianExt F hLM)
    (f_K : ℕ) (hf_K : 0 < f_K) :
    ∃ (M₀ M' : IntermediateField F (AlgebraicClosure F))
      (hKM₀ : K ≤ M₀) (hMM₀ : M ≤ M₀) (hM₀M' : M₀ ≤ M')
      (ζ_N : AlgebraicClosure F),
      IsGaloisExt F K M₀ ∧
      IsAbelianExt F hKM₀ ∧
      0 < Module.finrank K (IntermediateField.extendScalars hKM₀) ∧
      IsPrimitiveRoot ζ_N ((q F) ^ (Module.finrank K (IntermediateField.extendScalars hKM₀) * f_K) - 1) ∧
      IsPrimeToPRootOfUnity F ζ_N ∧
      ζ_N ∈ M' ∧
      IsGaloisExt F L M' ∧
      IsAbelianExt F (hLK.trans (hKM₀.trans hM₀M')) :=
by
  
  have hSep_iff : ∀ (L₁ E₁ : IntermediateField F (AlgebraicClosure F)) (h : L₁ ≤ E₁),
      Algebra.IsSeparable L₁ (IntermediateField.extendScalars h) ↔
        E₁ ≤ IntermediateField.restrictScalars F (separableClosure L₁ (AlgebraicClosure F)) := by
    intro L₁ E₁ h
    let S := IntermediateField.extendScalars h
    have hmin : ∀ x : S, IsSeparable L₁ x.1 ↔ IsSeparable L₁ x := by
      intro x
      change (minpoly L₁ (S.val x)).Separable ↔ (minpoly L₁ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₁ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₁ := (IntermediateField.mem_extendScalars h).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  
  let M₀ : IntermediateField F (AlgebraicClosure F) := K ⊔ M
  have hKM₀ : K ≤ M₀ := le_sup_left
  have hMM₀ : M ≤ M₀ := le_sup_right
  have hLM₀ : L ≤ M₀ := hLK.trans hKM₀
  have hFinM₀ : FiniteDimensional F M₀ := by
    haveI : FiniteDimensional F K := hGalK.2.1
    haveI : FiniteDimensional F M := hGalM.2.1
    exact IntermediateField.finiteDimensional_sup K M
  have hNormLM₀ : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ M₀.fixingSubgroup,
      σ * τ * σ⁻¹ ∈ M₀.fixingSubgroup := by
    intro σ hσ τ hτ
    rw [IntermediateField.fixingSubgroup_sup] at hτ ⊢
    exact ⟨hGalK.2.2.1 σ hσ τ hτ.1, hGalM.2.2.1 σ hσ τ hτ.2⟩
  have hCommLM₀ : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ L.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ M₀.fixingSubgroup := by
    intro σ hσ τ hτ
    rw [IntermediateField.fixingSubgroup_sup]
    exact ⟨hAbK.2.1 σ hσ τ hτ, hAbM.2.1 σ hσ τ hτ⟩
  have hSepLM₀ : M₀ ≤ IntermediateField.restrictScalars F (separableClosure L (AlgebraicClosure F)) :=
    sup_le ((hSep_iff L K hLK).mp hAbK.2.2) ((hSep_iff L M hLM).mp hAbM.2.2)
  have hSepKM₀ : ∀ h : K ≤ M₀, Algebra.IsSeparable K (IntermediateField.extendScalars h) := by
    intro h
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z :=
      mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hSepLM₀ hz))
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLK)) hzL
  have hGalKM₀ : IsGaloisExt F K M₀ :=
    ⟨hKM₀, hFinM₀,
      fun σ hσ τ hτ => hNormLM₀ σ (IntermediateField.fixingSubgroup_le hLK hσ) τ hτ,
      hSepKM₀⟩
  have hAbKM₀ : IsAbelianExt F hKM₀ :=
    ⟨fun σ hσ τ hτ => hNormLM₀ σ (IntermediateField.fixingSubgroup_le hLK hσ) τ hτ,
     fun σ hσ τ hτ => hCommLM₀ σ (IntermediateField.fixingSubgroup_le hLK hσ)
       τ (IntermediateField.fixingSubgroup_le hLK hτ),
     hSepKM₀ hKM₀⟩
  have hd_pos : 0 < Module.finrank K (IntermediateField.extendScalars hKM₀) := by
    haveI : FiniteDimensional F (IntermediateField.extendScalars hKM₀) := hFinM₀
    haveI : IsScalarTower F K (IntermediateField.extendScalars hKM₀) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional K (IntermediateField.extendScalars hKM₀) :=
      Module.Finite.of_restrictScalars_finite F K (IntermediateField.extendScalars hKM₀)
    exact Module.finrank_pos
  
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  have hq_props : p F ∣ q F ∧ 1 < q F := by
    haveI : CharP 𝓀[F] (p F) := ringChar.of_eq rfl
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    obtain ⟨r_p, _, hcard_k⟩ := FiniteField.card 𝓀[F] (p F)
    have hq_eq : q F = (p F) ^ (r_p : ℕ) := Nat.card_eq_fintype_card.trans hcard_k
    exact ⟨hq_eq ▸ dvd_pow_self (p F) r_p.ne_zero, hq_eq ▸ one_lt_pow₀ hp.one_lt r_p.ne_zero⟩
  obtain ⟨hp_dvd_q, hq_gt1⟩ := hq_props
  set d := Module.finrank K (IntermediateField.extendScalars hKM₀)
  set m := d * f_K
  set N := (q F) ^ m - 1
  have hm_pos : 0 < m := Nat.mul_pos hd_pos hf_K
  have hqm_gt1 : 1 < (q F) ^ m := one_lt_pow₀ hq_gt1 hm_pos.ne'
  have hN_pos : 0 < N := by
    dsimp [N]
    omega
  have hp_dvd_N1 : p F ∣ N + 1 := by
    have hN1 : N + 1 = (q F) ^ m := by
      dsimp [N]
      omega
    rw [hN1]
    exact dvd_trans hp_dvd_q (dvd_pow_self (q F) hm_pos.ne')
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    exact hp.not_dvd_one ((Nat.dvd_add_right hdvd).mp hp_dvd_N1)
  have hNF : (N : F) ≠ 0 := (hFrob N hN_pos hpN).1
  have hσ_pow : ∀ σ₀ : AbsGal F, ∃ k : ℕ, ∀ ζ : AlgebraicClosure F, ζ ^ N = 1 → σ₀ ζ = ζ ^ ((q F) ^ k) :=
    (hFrob N hN_pos hpN).2.2
  obtain ⟨ζ_N, hζ_prim⟩ : ∃ ζ_N : AlgebraicClosure F, IsPrimitiveRoot ζ_N N := by
    haveI : NeZero (N : F) := ⟨hNF⟩
    exact @HasEnoughRootsOfUnity.prim (AlgebraicClosure F) _ N
      (AlgebraicClosure.hasEnoughRootsOfUnity F N)
  have hζ_N_pow : ζ_N ^ N = 1 := hζ_prim.pow_eq_one
  have hζ_p : IsPrimeToPRootOfUnity F ζ_N := ⟨N, hN_pos, hpN, hζ_N_pow⟩
  
  let C : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.adjoin F ({ζ_N} : Set (AlgebraicClosure F))
  have hζ_mem_C : ζ_N ∈ C :=
    IntermediateField.subset_adjoin F ({ζ_N} : Set (AlgebraicClosure F)) (Set.mem_singleton ζ_N)
  have hFinC : FiniteDimensional F C :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  have hC_fix_iff : ∀ γ : AbsGal F, γ ∈ C.fixingSubgroup ↔ γ ζ_N = ζ_N := by
    intro γ
    refine ⟨fun hγ => hγ ⟨ζ_N, hζ_mem_C⟩, fun hγ => ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy =>
      rcases Set.mem_singleton_iff.mp hy with rfl
      exact hγ
    | algebraMap y =>
      exact γ.commutes y
    | add y z _ _ hy hz =>
      rw [map_add, hy, hz]
    | inv y _ hy =>
      rw [map_inv₀, hy]
    | mul y z _ _ hy hz =>
      rw [map_mul, hy, hz]
  have hNormC : ∀ (σ τ : AbsGal F), τ ∈ C.fixingSubgroup → σ * τ * σ⁻¹ ∈ C.fixingSubgroup := by
    intro σ τ hτ_mem
    have hτ : τ ζ_N = ζ_N := (hC_fix_iff τ).mp hτ_mem
    obtain ⟨k, hk⟩ := hσ_pow σ⁻¹
    have hk_ζ : σ⁻¹ ζ_N = ζ_N ^ ((q F) ^ k) := hk ζ_N hζ_N_pow
    apply (hC_fix_iff (σ * τ * σ⁻¹)).mpr
    change σ (τ (σ⁻¹ ζ_N)) = ζ_N
    rw [hk_ζ, map_pow, hτ, ← hk_ζ]
    exact σ.apply_symm_apply ζ_N
  have hCommC : ∀ (σ τ : AbsGal F), σ * τ * σ⁻¹ * τ⁻¹ ∈ C.fixingSubgroup := by
    intro σ τ
    apply (hC_fix_iff (σ * τ * σ⁻¹ * τ⁻¹)).mpr
    let z : AlgebraicClosure F := σ⁻¹ (τ⁻¹ ζ_N)
    have hz_pow : z ^ N = 1 := by
      dsimp [z]
      rw [← map_pow, ← map_pow, hζ_N_pow, map_one, map_one]
    obtain ⟨j, hj⟩ := hσ_pow σ
    obtain ⟨k, hk⟩ := hσ_pow τ
    have h_comm_z : σ (τ z) = τ (σ z) := by
      calc σ (τ z) = σ (z ^ ((q F) ^ k)) := by rw [hk z hz_pow]
        _ = (σ z) ^ ((q F) ^ k) := by rw [map_pow]
        _ = (z ^ ((q F) ^ j)) ^ ((q F) ^ k) := by rw [hj z hz_pow]
        _ = z ^ (((q F) ^ j) * ((q F) ^ k)) := by rw [← pow_mul]
        _ = z ^ (((q F) ^ k) * ((q F) ^ j)) := by rw [mul_comm]
        _ = (z ^ ((q F) ^ k)) ^ ((q F) ^ j) := by rw [pow_mul]
        _ = (τ z) ^ ((q F) ^ j) := by rw [← hk z hz_pow]
        _ = τ (z ^ ((q F) ^ j)) := by rw [← map_pow]
        _ = τ (σ z) := by rw [← hj z hz_pow]
    change σ (τ z) = ζ_N
    rw [h_comm_z]
    dsimp [z]
    rw [σ.apply_symm_apply, τ.apply_symm_apply]
  have hSepC : C ≤ IntermediateField.restrictScalars F (separableClosure L (AlgebraicClosure F)) := by
    have hNL : (N : L) ≠ 0 := by
      intro h0
      apply hNF
      apply (algebraMap F L).injective
      rw [map_natCast, h0, map_zero]
    have hP_sep : (Polynomial.X ^ N - Polynomial.C (1 : L)).Separable :=
      Polynomial.separable_X_pow_sub_C (1 : L) hNL one_ne_zero
    have haeval_P : Polynomial.aeval ζ_N (Polynomial.X ^ N - Polynomial.C (1 : L)) = 0 := by
      rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, map_one, hζ_N_pow, sub_self]
    have hdvd_P : minpoly L ζ_N ∣ Polynomial.X ^ N - Polynomial.C (1 : L) :=
      minpoly.dvd L ζ_N haeval_P
    have hζ_sep : IsSeparable L ζ_N := hP_sep.of_dvd hdvd_P
    have hζ_mem_sep : ζ_N ∈ IntermediateField.restrictScalars F (separableClosure L (AlgebraicClosure F)) := by
      rwa [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    exact hζ_mem_sep
  
  let M' : IntermediateField F (AlgebraicClosure F) := M₀ ⊔ C
  have hM₀M' : M₀ ≤ M' := le_sup_left
  have hCM' : C ≤ M' := le_sup_right
  have hLM' : L ≤ M' := hLK.trans (hKM₀.trans hM₀M')
  have hζ_mem : ζ_N ∈ M' := hCM' hζ_mem_C
  have hFinM' : FiniteDimensional F M' := by
    haveI : FiniteDimensional F M₀ := hFinM₀
    haveI : FiniteDimensional F C := hFinC
    exact IntermediateField.finiteDimensional_sup M₀ C
  have hNormLM' : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ M'.fixingSubgroup,
      σ * τ * σ⁻¹ ∈ M'.fixingSubgroup := by
    intro σ hσ τ hτ
    rw [IntermediateField.fixingSubgroup_sup] at hτ ⊢
    exact ⟨hNormLM₀ σ hσ τ hτ.1, hNormC σ τ hτ.2⟩
  have hCommLM' : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ L.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ M'.fixingSubgroup := by
    intro σ hσ τ hτ
    rw [IntermediateField.fixingSubgroup_sup]
    exact ⟨hCommLM₀ σ hσ τ hτ, hCommC σ τ⟩
  have hSepLM' : ∀ h : L ≤ M', Algebra.IsSeparable L (IntermediateField.extendScalars h) := by
    intro h
    exact (hSep_iff L M' h).mpr (sup_le hSepLM₀ hSepC)
  have hGalM' : IsGaloisExt F L M' :=
    ⟨hLM', hFinM', hNormLM', hSepLM'⟩
  have hAbM' : IsAbelianExt F hLM' :=
    ⟨hNormLM', hCommLM', hSepLM' hLM'⟩
  exact ⟨M₀, M', hKM₀, hMM₀, hM₀M', ζ_N, hGalKM₀, hAbKM₀, hd_pos, hζ_prim, hζ_p, hζ_mem, hGalM', hAbM'⟩

theorem ld_recMap_norm_in_zpowers_on_abelian_ext (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M' : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hKM' : K ≤ M')
    (hGalM' : IsGaloisExt F L M') (hAbM' : IsAbelianExt F (hLK.trans hKM'))
    (y : Kˣ) :
    ∃ (σ_K : IntermediateField.extendScalars (hLK.trans hKM') ≃ₐ[L]
        IntermediateField.extendScalars (hLK.trans hKM'))
      (k : ℤ),
      (∀ x : IntermediateField.extendScalars (hLK.trans hKM'),
        ((σ_K x : IntermediateField.extendScalars (hLK.trans hKM')) : AlgebraicClosure F) =
          (rec.recMap K y : AbsGal F) (x : AlgebraicClosure F)) ∧
      (∀ x : IntermediateField.extendScalars (hLK.trans hKM'),
        (((σ_K ^ k) x : IntermediateField.extendScalars (hLK.trans hKM')) : AlgebraicClosure F) =
          (rec.recMap L (Units.map (normLM F hLK) y) : AbsGal F) (x : AlgebraicClosure F)) :=
by
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have hLM' : L ≤ M' := hLK.trans hKM'
  let M_ext' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM'
  let G' := (M_ext' ≃ₐ[L] M_ext')
  haveI : FiniteDimensional F M' := hGalM'.2.1
  haveI : FiniteDimensional F K :=
    Module.Finite.of_injective (IntermediateField.inclusion hKM').toLinearMap
      (IntermediateField.inclusion hKM').injective
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLM').toLinearMap
      (IntermediateField.inclusion hLM').injective
  haveI : FiniteDimensional F M_ext' := hGalM'.2.1
  haveI : IsScalarTower F L M_ext' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L M_ext' := Module.Finite.of_restrictScalars_finite F L M_ext'
  have hSepLM' : Algebra.IsSeparable L M_ext' := hGalM'.2.2.2 hLM'
  haveI : Algebra.IsSeparable L M_ext' := hSepLM'
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  have hM'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
      (∀ x ∈ M_ext', τ x = x) → ∀ x ∈ M_ext', (σ * τ * σ⁻¹) x = x := by
    intro σ τ hτ
    let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
    let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
    have hτM' : τ_F.1 ∈ M'.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hLM').mpr hx)
    have hconjM' : (σ_F * τ_F * σ_F⁻¹).1 ∈ M'.fixingSubgroup :=
      hGalM'.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτM'
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjM'
    exact hconjM' x ((IntermediateField.mem_extendScalars hLM').mp hx)
  haveI : IsGalois L ↥M_ext' := helper_isGalois L (AlgebraicClosure F) M_ext' hM'_norm_fix
  haveI : Normal L ↥M_ext' := IsGalois.to_normal
  let res_L : L.fixingSubgroup →* G' :=
    (AlgEquiv.restrictNormalHom M_ext').comp (IntermediateField.fixingSubgroupEquiv L).toMonoidHom
  have h_res_L_apply : ∀ (γ : L.fixingSubgroup) (x : M_ext'),
      ((res_L γ x : M_ext') : AlgebraicClosure F) = (γ : AbsGal F) (x : AlgebraicClosure F) := by
    intro γ x
    change ((AlgEquiv.restrictNormalHom M_ext'
      ((IntermediateField.fixingSubgroupEquiv L) γ) x : M_ext') : AlgebraicClosure F) =
      (γ : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  let w_K : relWeil F K := rec.recMap K y
  let x_norm : Lˣ := Units.map (normLM F hLK) y
  let w_L : relWeil F L := rec.recMap L x_norm
  let γ_K : L.fixingSubgroup := ⟨(w_K : AbsGal F), IntermediateField.fixingSubgroup_le hLK w_K.2.2⟩
  let γ_L : L.fixingSubgroup := ⟨(w_L : AbsGal F), w_L.2.2⟩
  let σ_K : G' := res_L γ_K
  let σ_L : G' := res_L γ_L
  have hσ_K : ∀ x : M_ext',
      ((σ_K x : M_ext') : AlgebraicClosure F) = (w_K : AbsGal F) (x : AlgebraicClosure F) :=
    h_res_L_apply γ_K
  have hσ_L : ∀ x : M_ext',
      ((σ_L x : M_ext') : AlgebraicClosure F) = (w_L : AbsGal F) (x : AlgebraicClosure F) :=
    h_res_L_apply γ_L
  let H_y : Subgroup G' := Subgroup.zpowers σ_K
  let E₀ : IntermediateField L M_ext' := IntermediateField.fixedField H_y
  let E_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.lift E₀
  let E_y : IntermediateField F (AlgebraicClosure F) := E_L.restrictScalars F
  have hLE_y : L ≤ E_y := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars]
    exact E_L.algebraMap_mem ⟨z, hz⟩
  have hE_yM' : E_y ≤ M' := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars] at hz
    exact (IntermediateField.mem_extendScalars hLM').mp (IntermediateField.lift_le E₀ hz)
  have h_mem_Ey : ∀ x : M_ext', (x : AlgebraicClosure F) ∈ E_y ↔ x ∈ E₀ := by
    intro x
    exact (IntermediateField.mem_restrictScalars F).trans (IntermediateField.mem_lift x)
  haveI : FiniteDimensional F E_y :=
    Module.Finite.of_injective (IntermediateField.inclusion hE_yM').toLinearMap
      (IntermediateField.inclusion hE_yM').injective
  have h_fix_Hy : E₀.fixingSubgroup = H_y := IntermediateField.fixingSubgroup_fixedField H_y
  have hKE_y : K ≤ E_y := by
    intro z hz
    let x_z : M_ext' := ⟨z, (IntermediateField.mem_extendScalars hLM').mpr (hKM' hz)⟩
    let S_xz : Subgroup G' :=
      { carrier := {g : G' | g x_z = x_z}
        one_mem' := rfl
        mul_mem' := fun {a b} ha hb => by
          change a (b x_z) = x_z
          rw [hb, ha]
        inv_mem' := fun {a} ha => by
          apply a.injective
          change (a * a⁻¹) x_z = a x_z
          rw [mul_inv_cancel, AlgEquiv.one_apply, ha] }
    have hσK_xz : σ_K ∈ S_xz := by
      apply Subtype.ext
      rw [hσ_K x_z]
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp w_K.2.2 z hz
    have hHy_xz : H_y ≤ S_xz := Subgroup.zpowers_le.mpr hσK_xz
    have hx_E₀ : x_z ∈ E₀ := (IntermediateField.mem_fixedField_iff H_y x_z).mpr fun g hg => hHy_xz hg
    exact (h_mem_Ey x_z).mpr hx_E₀
  have hSep_iff : ∀ (L₀ E₁ : IntermediateField F (AlgebraicClosure F)) (h₀ : L₀ ≤ E₁),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars h₀) ↔
        E₁ ≤ IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) := by
    intro L₀ E₁ h₀
    let S := IntermediateField.extendScalars h₀
    have hmin : ∀ x : S, IsSeparable L₀ x.1 ↔ IsSeparable L₀ x := by
      intro x
      change (minpoly L₀ (S.val x)).Separable ↔ (minpoly L₀ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h₀).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₀ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₁ := (IntermediateField.mem_extendScalars h₀).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have h_comm_L : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ L.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ E_y.fixingSubgroup := by
    intro σ hσ τ hτ
    exact IntermediateField.fixingSubgroup_le hE_yM' (hAbM'.2.1 σ hσ τ hτ)
  have h_norm_L : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ E_y.fixingSubgroup,
      σ * τ * σ⁻¹ ∈ E_y.fixingSubgroup := by
    intro σ hσ τ hτ
    have hτL : τ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLE_y hτ
    have hcomm := h_comm_L σ hσ τ hτL
    have heq : (σ * τ * σ⁻¹ * τ⁻¹) * τ = σ * τ * σ⁻¹ := inv_mul_cancel_right (σ * τ * σ⁻¹) τ
    rw [← heq]
    exact Subgroup.mul_mem _ hcomm hτ
  have h_sep_LE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE_y) :=
    (hSep_iff L E_y hLE_y).mpr (hE_yM'.trans ((hSep_iff L M' hLM').mp hAbM'.2.2))
  have hAbLE_y : IsAbelianExt F hLE_y := ⟨h_norm_L, h_comm_L, h_sep_LE⟩
  have h_comm_K : ∀ σ ∈ K.fixingSubgroup, ∀ τ ∈ K.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ E_y.fixingSubgroup := by
    intro σ hσ τ hτ
    exact h_comm_L σ (IntermediateField.fixingSubgroup_le hLK hσ)
      τ (IntermediateField.fixingSubgroup_le hLK hτ)
  have h_norm_K : ∀ σ ∈ K.fixingSubgroup, ∀ τ ∈ E_y.fixingSubgroup,
      σ * τ * σ⁻¹ ∈ E_y.fixingSubgroup := by
    intro σ hσ τ hτ
    exact h_norm_L σ (IntermediateField.fixingSubgroup_le hLK hσ) τ hτ
  have h_sep_KE : Algebra.IsSeparable K (IntermediateField.extendScalars hKE_y) := by
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z := by
      have hE_sep := (hSep_iff L E_y hLE_y).mp h_sep_LE hz
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hE_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLK)) hzL
  have hAbKE_y : IsAbelianExt F hKE_y := ⟨h_norm_K, h_comm_K, h_sep_KE⟩
  have h_norm_trans : ∀ u : E_y, normLM F hLK (normLM F hKE_y u) = normLM F hLE_y u := by
    let S_LK := IntermediateField.extendScalars hLK
    let S_KE := IntermediateField.extendScalars hKE_y
    let S_LE := IntermediateField.extendScalars hLE_y
    let f_KL : K →+* S_LE :=
      { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLE_y).mpr (hKE_y z.2)⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let f_SLK : S_LK →+* S_LE :=
      { toFun := fun z =>
          ⟨z.1, (IntermediateField.mem_extendScalars hLE_y).mpr
            (hKE_y ((IntermediateField.mem_extendScalars hLK).mp z.2))⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    letI algK : Algebra ↥K ↥S_LE := RingHom.toAlgebra f_KL
    letI : SMul ↥K ↥S_LE := @Algebra.toSMul ↥K ↥S_LE _ _ algK
    letI algSLK : Algebra ↥S_LK ↥S_LE := RingHom.toAlgebra f_SLK
    letI : SMul ↥S_LK ↥S_LE := @Algebra.toSMul ↥S_LK ↥S_LE _ _ algSLK
    haveI : IsScalarTower ↥L ↥S_LK ↥S_LE := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let e_KE : S_KE ≃ₐ[K] S_LE :=
      { toFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hLE_y).mpr
            ((IntermediateField.mem_extendScalars hKE_y).mp x.2)⟩
        invFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hKE_y).mpr
            ((IntermediateField.mem_extendScalars hLE_y).mp x.2)⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    let e_K : K ≃+* S_LK :=
      { toExtendScalars F hLK with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLK).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    intro u
    let u_KE : S_KE := toExtendScalars F hKE_y u
    let u_LE : S_LE := toExtendScalars F hLE_y u
    have h1 : Algebra.norm K u_LE = normLM F hKE_y u :=
      Algebra.norm_eq_of_algEquiv e_KE u_KE
    have h2 : toExtendScalars F hLK (Algebra.norm K u_LE) = Algebra.norm S_LK u_LE :=
      Algebra.norm_eq_of_ringEquiv e_K (RingHom.ext fun _ => rfl) u_LE
    have h3 : Algebra.norm L (Algebra.norm S_LK u_LE) = normLM F hLE_y u :=
      Algebra.norm_norm
    change Algebra.norm L (toExtendScalars F hLK (normLM F hKE_y u)) = normLM F hLE_y u
    rw [← h1, h2, h3]
  have hwK_fix_Ey : (w_K : AbsGal F) ∈ E_y.fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x_z : M_ext' := ⟨z, (IntermediateField.mem_extendScalars hLM').mpr (hE_yM' hz)⟩
    have hx_E₀ : x_z ∈ E₀ := (h_mem_Ey x_z).mp hz
    have h_fix : σ_K x_z = x_z :=
      (IntermediateField.mem_fixedField_iff H_y x_z).mp hx_E₀ σ_K (Subgroup.mem_zpowers σ_K)
    have h1 := hσ_K x_z
    rw [h_fix] at h1
    exact h1.symm
  obtain ⟨u, hu⟩ := (rec.ker_rec K E_y hKE_y hAbKE_y y).mp hwK_fix_Ey
  have hx_range : (x_norm : L) ∈ Set.range (normLM F hLE_y) := by
    refine ⟨u, ?_⟩
    rw [← h_norm_trans u, hu]
    rfl
  have hwL_fix_Ey : (w_L : AbsGal F) ∈ E_y.fixingSubgroup :=
    (rec.ker_rec L E_y hLE_y hAbLE_y x_norm).mpr hx_range
  have hσL_mem : σ_L ∈ H_y := by
    rw [← h_fix_Hy, IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    apply Subtype.ext
    rw [hσ_L x]
    have hx_Ey : (x : AlgebraicClosure F) ∈ E_y := (h_mem_Ey x).mpr hx
    exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hwL_fix_Ey x.1 hx_Ey
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hσL_mem
  exact ⟨σ_K, k, hσ_K, fun x => by rw [hk, hσ_L x]⟩

theorem ld_frob_zpow_eq_on_subfield_of_primitiveRoot (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M₀ M' : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hKM₀ : K ≤ M₀) (hM₀M' : M₀ ≤ M')
    (hGalKM₀ : IsGaloisExt F K M₀)
    (f_K : ℕ) (hf_K : 0 < f_K) (hq : 2 ≤ q F)
    (ζ_N : AlgebraicClosure F)
    (hζ_prim : IsPrimitiveRoot ζ_N ((q F) ^ (Module.finrank K (IntermediateField.extendScalars hKM₀) * f_K) - 1))
    (hζ_p : IsPrimeToPRootOfUnity F ζ_N)
    (hζ_mem : ζ_N ∈ M')
    (γ_K : AbsGal F) (hγ_K : γ_K ∈ K.fixingSubgroup)
    (hγ_frob : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      γ_K⁻¹ ζ = ζ ^ ((q F) ^ f_K))
    (σ_K : IntermediateField.extendScalars (hLK.trans (hKM₀.trans hM₀M')) ≃ₐ[L]
      IntermediateField.extendScalars (hLK.trans (hKM₀.trans hM₀M')))
    (hσ_K : ∀ x : IntermediateField.extendScalars (hLK.trans (hKM₀.trans hM₀M')),
      ((σ_K x : IntermediateField.extendScalars (hLK.trans (hKM₀.trans hM₀M'))) : AlgebraicClosure F) =
        γ_K (x : AlgebraicClosure F))
    (k : ℤ)
    (hk_ζ : (((σ_K ^ k) ⟨ζ_N, (IntermediateField.mem_extendScalars (hLK.trans (hKM₀.trans hM₀M'))).mpr hζ_mem⟩ :
        IntermediateField.extendScalars (hLK.trans (hKM₀.trans hM₀M'))) : AlgebraicClosure F) =
      γ_K ζ_N) :
    ∀ (z : AlgebraicClosure F) (hz : z ∈ M₀),
      (((σ_K ^ k) ⟨z, (IntermediateField.mem_extendScalars (hLK.trans (hKM₀.trans hM₀M'))).mpr (hM₀M' hz)⟩ :
        IntermediateField.extendScalars (hLK.trans (hKM₀.trans hM₀M'))) : AlgebraicClosure F) =
        γ_K z :=
by
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  let hKM' : K ≤ M' := hKM₀.trans hM₀M'
  let hLM' : L ≤ M' := hLK.trans hKM'
  let M_ext' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM'
  let M₀_ext : IntermediateField K (AlgebraicClosure F) := IntermediateField.extendScalars hKM₀
  set d : ℕ := Module.finrank K M₀_ext
  set Q : ℕ := (q F) ^ f_K
  set N : ℕ := (q F) ^ (d * f_K) - 1
  have hFinM₀ : FiniteDimensional F M₀ := hGalKM₀.2.1
  haveI : FiniteDimensional F M₀ := hFinM₀
  have hFinK : FiniteDimensional F K :=
    Module.Finite.of_injective (IntermediateField.inclusion hKM₀).toLinearMap
      (RingHom.injective (IntermediateField.inclusion hKM₀).toRingHom)
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional F M₀_ext := hFinM₀
  haveI : IsScalarTower F K M₀_ext := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional K M₀_ext := Module.Finite.of_restrictScalars_finite F K M₀_ext
  have hd_pos : 0 < d := Module.finrank_pos
  have hQ_ge2 : 2 ≤ Q :=
    le_trans (by rw [pow_one]; exact hq) (Nat.pow_le_pow_right (by omega) hf_K)
  have hQ_gt1 : 1 < Q := by omega
  have hQd_eq : Q ^ d = (q F) ^ (d * f_K) := by
    dsimp [Q]
    rw [← pow_mul, mul_comm f_K d]
  have hN_eq : N = Q ^ d - 1 := by
    dsimp [N]
    rw [hQd_eq]
  have hQd_ge2 : 2 ≤ Q ^ d :=
    le_trans (by rw [pow_one]; exact hQ_ge2) (Nat.pow_le_pow_right (by omega) hd_pos)
  have hN_pos : 0 < N := by omega
  have hσ_K_inv : ∀ x : M_ext',
      ((σ_K⁻¹ x : M_ext') : AlgebraicClosure F) = γ_K⁻¹ (x : AlgebraicClosure F) := by
    intro x
    have h1 : ((σ_K (σ_K⁻¹ x) : M_ext') : AlgebraicClosure F) =
        γ_K ((σ_K⁻¹ x : M_ext') : AlgebraicClosure F) := hσ_K (σ_K⁻¹ x)
    have h2 : σ_K (σ_K⁻¹ x) = x := σ_K.apply_symm_apply x
    rw [h2] at h1
    have h3 : γ_K⁻¹ (x : AlgebraicClosure F) =
        γ_K⁻¹ (γ_K ((σ_K⁻¹ x : M_ext') : AlgebraicClosure F)) := congrArg (⇑γ_K⁻¹) h1
    have h4 : γ_K⁻¹ (γ_K ((σ_K⁻¹ x : M_ext') : AlgebraicClosure F)) =
        ((σ_K⁻¹ x : M_ext') : AlgebraicClosure F) := γ_K.symm_apply_apply _
    rw [h4] at h3
    exact h3.symm
  have hσ_K_inv_pow : ∀ (r : ℕ) (x : M_ext'),
      (((σ_K⁻¹ ^ r) x : M_ext') : AlgebraicClosure F) = (γ_K⁻¹ ^ r) (x : AlgebraicClosure F) := by
    intro r
    induction' r with r ih
    · intro x; rfl
    · intro x
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, hσ_K_inv, ih]
  have hγ_inv_pow_ζ : ∀ r : ℕ, (γ_K⁻¹ ^ r) ζ_N = ζ_N ^ (Q ^ r) := by
    intro r
    induction' r with r ih
    · simp
    · rw [pow_succ, AlgEquiv.mul_apply, hγ_frob ζ_N hζ_p, map_pow, ih, ← pow_mul, ← pow_succ]
  let z_ζ : M_ext' := ⟨ζ_N, (IntermediateField.mem_extendScalars hLM').mpr hζ_mem⟩
  have hk_zζ : (σ_K ^ k) z_ζ = σ_K z_ζ := by
    apply Subtype.ext
    rw [hk_ζ, hσ_K z_ζ]
  have hk_sub1 : ((σ_K⁻¹) ^ (k - 1)) z_ζ = z_ζ := by
    have h1 : (σ_K ^ (k - 1)) z_ζ = z_ζ := by
      have hk_split : k - 1 = -1 + k := by omega
      rw [hk_split, zpow_add, zpow_neg, zpow_one, AlgEquiv.mul_apply, hk_zζ]
      exact σ_K.symm_apply_apply z_ζ
    have h2 : (σ_K ^ (k - 1))⁻¹ ((σ_K ^ (k - 1)) z_ζ) = (σ_K ^ (k - 1))⁻¹ z_ζ :=
      congrArg (⇑(σ_K ^ (k - 1))⁻¹) h1
    have h3 : (σ_K ^ (k - 1))⁻¹ ((σ_K ^ (k - 1)) z_ζ) = z_ζ :=
      (σ_K ^ (k - 1)).symm_apply_apply z_ζ
    rw [h3, ← inv_zpow] at h2
    exact h2.symm
  set r : ℕ := (k - 1).natAbs
  have hr_zζ : ((σ_K⁻¹) ^ r) z_ζ = z_ζ := by
    rcases Int.natAbs_eq (k - 1) with hpos | hneg
    · have h1 := hk_sub1
      rw [hpos, zpow_natCast] at h1
      exact h1
    · have h1 := hk_sub1
      rw [hneg, zpow_neg, zpow_natCast] at h1
      have h2 : ((σ_K⁻¹) ^ r) (((σ_K⁻¹) ^ r)⁻¹ z_ζ) = ((σ_K⁻¹) ^ r) z_ζ :=
        congrArg (⇑((σ_K⁻¹) ^ r)) h1
      have h3 : ((σ_K⁻¹) ^ r) (((σ_K⁻¹) ^ r)⁻¹ z_ζ) = z_ζ :=
        ((σ_K⁻¹) ^ r).apply_symm_apply z_ζ
      rw [h3] at h2
      exact h2.symm
  have hζ_Qr : ζ_N ^ (Q ^ r) = ζ_N := by
    have h1 : (((σ_K⁻¹ ^ r) z_ζ : M_ext') : AlgebraicClosure F) = (z_ζ : AlgebraicClosure F) :=
      congrArg Subtype.val hr_zζ
    rw [hσ_K_inv_pow r z_ζ, hγ_inv_pow_ζ r] at h1
    exact h1
  have hζ_ne0 : ζ_N ≠ 0 := hζ_prim.ne_zero hN_pos.ne'
  have hQr_ge1 : 1 ≤ Q ^ r := Nat.one_le_pow r Q (by omega)
  have hζ_pow_eq_one : ζ_N ^ (Q ^ r - 1) = 1 := by
    apply mul_right_cancel₀ hζ_ne0
    rw [← pow_succ, Nat.sub_add_cancel hQr_ge1, one_mul]
    exact hζ_Qr
  have hdvd_N : N ∣ Q ^ r - 1 := hζ_prim.dvd_of_pow_eq_one (Q ^ r - 1) hζ_pow_eq_one
  rw [hN_eq] at hdvd_N
  have hdvd_mul : Q ^ d - 1 ∣ Q ^ (d * (r / d)) - 1 :=
    Nat.pow_sub_one_dvd_pow_sub_one Q (Nat.dvd_mul_right d (r / d))
  have hdvd_term : Q ^ d - 1 ∣ Q ^ (r % d) * (Q ^ (d * (r / d)) - 1) :=
    dvd_mul_of_dvd_right hdvd_mul (Q ^ (r % d))
  have hQr_split : Q ^ r - 1 - Q ^ (r % d) * (Q ^ (d * (r / d)) - 1) = Q ^ (r % d) - 1 := by
    have hr_eq : Q ^ r = Q ^ (r % d) * Q ^ (d * (r / d)) := by
      conv_lhs => rw [← Nat.div_add_mod r d, add_comm, pow_add]
    have h1 : 1 ≤ Q ^ (d * (r / d)) := Nat.one_le_pow _ Q (by omega)
    have h2 : 1 ≤ Q ^ (r % d) := Nat.one_le_pow _ Q (by omega)
    have hle : Q ^ (r % d) ≤ Q ^ (r % d) * Q ^ (d * (r / d)) := Nat.le_mul_of_pos_right _ h1
    rw [hr_eq, Nat.mul_sub_one]
    omega
  have hdvd_rem : Q ^ d - 1 ∣ Q ^ (r % d) - 1 := by
    rw [← hQr_split]
    exact Nat.dvd_sub hdvd_N hdvd_term
  have hrem_lt_d : r % d < d := Nat.mod_lt r hd_pos
  have hQrem_lt : Q ^ (r % d) - 1 < Q ^ d - 1 := by
    have hlt : Q ^ (r % d) < Q ^ d := Nat.pow_lt_pow_right hQ_gt1 hrem_lt_d
    have h1 : 1 ≤ Q ^ (r % d) := Nat.one_le_pow _ Q (by omega)
    omega
  have hQrem_eq0 : Q ^ (r % d) - 1 = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_rem hQrem_lt
  have hrem_eq0 : r % d = 0 := by
    by_contra hne
    have hpos : 0 < r % d := Nat.pos_of_ne_zero hne
    have hlt : Q ^ 0 < Q ^ (r % d) := Nat.pow_lt_pow_right hQ_gt1 hpos
    rw [pow_zero] at hlt
    omega
  have hd_dvd_r : d ∣ r := Nat.dvd_of_mod_eq_zero hrem_eq0
  have hd_dvd_k : (d : ℤ) ∣ k - 1 := Int.natCast_dvd.mpr hd_dvd_r
  obtain ⟨c, hc⟩ := hd_dvd_k
  have hk_eq : k = 1 + (d : ℤ) * c := by omega
  have hSepKM₀ : Algebra.IsSeparable K M₀_ext := hGalKM₀.2.2.2 hKM₀
  haveI : Algebra.IsSeparable K M₀_ext := hSepKM₀
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal K (AlgebraicClosure F) := Normal.tower_top_of_normal F K (AlgebraicClosure F)
  have hM₀_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[K] AlgebraicClosure F),
      (∀ x ∈ M₀_ext, τ x = x) → ∀ x ∈ M₀_ext, (σ * τ * σ⁻¹) x = x := by
    intro σ τ hτ
    let σ_F : K.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv K).symm σ
    let τ_F : K.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv K).symm τ
    have hτM₀ : τ_F.1 ∈ M₀.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hKM₀).mpr hx)
    have hconjM₀ : (σ_F * τ_F * σ_F⁻¹).1 ∈ M₀.fixingSubgroup :=
      hGalKM₀.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτM₀
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjM₀
    exact hconjM₀ x ((IntermediateField.mem_extendScalars hKM₀).mp hx)
  have hGalKM₀_ext : IsGalois K ↥M₀_ext := helper_isGalois K (AlgebraicClosure F) M₀_ext hM₀_norm_fix
  haveI : IsGalois K ↥M₀_ext := hGalKM₀_ext
  haveI : Normal K ↥M₀_ext := IsGalois.to_normal
  let G₀ := (M₀_ext ≃ₐ[K] M₀_ext)
  let γ_bar : G₀ :=
    AlgEquiv.restrictNormalHom M₀_ext ((IntermediateField.fixingSubgroupEquiv K) ⟨γ_K, hγ_K⟩)
  have hγ_bar : ∀ y : M₀_ext, ((γ_bar y : M₀_ext) : AlgebraicClosure F) = γ_K (y : AlgebraicClosure F) := by
    intro y
    change ((AlgEquiv.restrictNormalHom M₀_ext
      ((IntermediateField.fixingSubgroupEquiv K) ⟨γ_K, hγ_K⟩) y : M₀_ext) : AlgebraicClosure F) =
      γ_K (y : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  let ι : M₀_ext → M_ext' := fun y =>
    ⟨y.1, (IntermediateField.mem_extendScalars hLM').mpr
      (hM₀M' ((IntermediateField.mem_extendScalars hKM₀).mp y.2))⟩
  have h_comm_one : ∀ y : M₀_ext, σ_K (ι y) = ι (γ_bar y) := by
    intro y
    apply Subtype.ext
    rw [hσ_K (ι y), ← hγ_bar y]
  have h_comm_inv : ∀ y : M₀_ext, σ_K⁻¹ (ι y) = ι (γ_bar⁻¹ y) := by
    intro y
    have h1 : σ_K (ι (γ_bar⁻¹ y)) = ι (γ_bar (γ_bar⁻¹ y)) := h_comm_one (γ_bar⁻¹ y)
    have h_apply : γ_bar (γ_bar⁻¹ y) = y := γ_bar.apply_symm_apply y
    rw [h_apply] at h1
    have h2 : σ_K⁻¹ (σ_K (ι (γ_bar⁻¹ y))) = σ_K⁻¹ (ι y) := congrArg (⇑σ_K⁻¹) h1
    have h_symm : σ_K⁻¹ (σ_K (ι (γ_bar⁻¹ y))) = ι (γ_bar⁻¹ y) := σ_K.symm_apply_apply _
    rw [h_symm] at h2
    exact h2.symm
  have h_comm_pow : ∀ (n : ℕ) (y : M₀_ext), (σ_K ^ n) (ι y) = ι ((γ_bar ^ n) y) := by
    intro n
    induction' n with n ih
    · intro y; rfl
    · intro y
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, ih, h_comm_one]
  have h_comm_inv_pow : ∀ (n : ℕ) (y : M₀_ext), (σ_K⁻¹ ^ n) (ι y) = ι ((γ_bar⁻¹ ^ n) y) := by
    intro n
    induction' n with n ih
    · intro y; rfl
    · intro y
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, ih, h_comm_inv]
  have h_comm_zpow : ∀ (m : ℤ) (y : M₀_ext), (σ_K ^ m) (ι y) = ι ((γ_bar ^ m) y) := by
    intro m y
    cases m with
    | ofNat n =>
      exact h_comm_pow n y
    | negSucc n =>
      rw [zpow_negSucc, zpow_negSucc, ← inv_pow, ← inv_pow]
      exact h_comm_inv_pow (n + 1) y
  have hcard_G₀ : Nat.card G₀ = d := IsGalois.card_aut_eq_finrank K M₀_ext
  have hγ_bar_d : γ_bar ^ d = 1 := by
    rw [← hcard_G₀]
    exact pow_card_eq_one'
  have hγ_bar_k : γ_bar ^ k = γ_bar := by
    rw [hk_eq, zpow_add, zpow_one, zpow_mul, zpow_natCast, hγ_bar_d, one_zpow, mul_one]
  intro z hz
  let y_z : M₀_ext := ⟨z, (IntermediateField.mem_extendScalars hKM₀).mpr hz⟩
  have h1 : (σ_K ^ k) (ι y_z) = ι (γ_bar y_z) := by
    rw [h_comm_zpow k y_z, hγ_bar_k]
  have h2 : (((σ_K ^ k) (ι y_z) : M_ext') : AlgebraicClosure F) =
      ((ι (γ_bar y_z) : M_ext') : AlgebraicClosure F) := congrArg Subtype.val h1
  rw [h2]
  exact hγ_bar y_z

theorem ld_abelian_weil_char_rec_and_norm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM : L ≤ M)
    (hGalK : IsGaloisExt F L K) (hAbK : IsAbelianExt F hLK)
    (hGalM : IsGaloisExt F L M) (hAbM : IsAbelianExt F hLM)
    (χ_ab : relWeil F L →* (Ω F)ˣ) (hχ_ab_rest : restrictWeilChar F hLM χ_ab = 1)
    (a_M : ℕ) (ha_M : ∀ u ∈ unitGroup F L a_M, (u : L) ∈ Set.range (normLM F hLM)) :
    ∃ χ_ab' : Lˣ →* (Ω F)ˣ,
      (∀ x : Lˣ, χ_ab' x = χ_ab (rec.recMap L x)) ∧
      (∀ u ∈ unitGroup F L a_M, χ_ab' u = 1) ∧
      (∀ y : Kˣ, χ_ab' (Units.map (normLM F hLK) y) =
        (restrictWeilChar F hLK χ_ab) (rec.recMap K y)) :=
by
  haveI : FiniteDimensional F K := hGalK.2.1
  haveI : FiniteDimensional F M := hGalM.2.1
  have hχ_kerM : ∀ w : relWeil F L, (w : AbsGal F) ∈ M.fixingSubgroup → χ_ab w = 1 := by
    intro w hwM
    have hw_relM : (w : AbsGal F) ∈ relWeil F M := ⟨w.2.1, hwM⟩
    have h1 : restrictWeilChar F hLM χ_ab ⟨w.1, hw_relM⟩ = 1 := by
      rw [hχ_ab_rest]
      rfl
    exact h1
  have hχ_rec_mul : ∀ x₁ x₂ : Lˣ,
      χ_ab (rec.recMap L (x₁ * x₂)) = χ_ab (rec.recMap L x₁) * χ_ab (rec.recMap L x₂) := by
    intro x₁ x₂
    have hmem := rec.mul_rec L M hLM hAbM x₁ x₂
    have htriv := hχ_kerM ((rec.recMap L (x₁ * x₂))⁻¹ * (rec.recMap L x₁ * rec.recMap L x₂)) hmem
    rw [map_mul, map_inv, map_mul, inv_mul_eq_one] at htriv
    exact htriv
  have hχ_rec_one : χ_ab (rec.recMap L 1) = 1 := by
    have h1 := hχ_rec_mul 1 1
    rw [mul_one] at h1
    simpa using congrArg (fun z => (χ_ab (rec.recMap L 1))⁻¹ * z) h1.symm
  let χ_ab' : Lˣ →* (Ω F)ˣ :=
    { toFun := fun x => χ_ab (rec.recMap L x)
      map_one' := hχ_rec_one
      map_mul' := hχ_rec_mul }
  have hχ_ab'_apply : ∀ x : Lˣ, χ_ab' x = χ_ab (rec.recMap L x) := fun _ => rfl
  have hχ_ab'_unit : ∀ u ∈ unitGroup F L a_M, χ_ab' u = 1 := by
    intro u hu
    rw [hχ_ab'_apply]
    apply hχ_kerM
    exact (rec.ker_rec L M hLM hAbM u).mpr (ha_M u hu)
  obtain ⟨_, hvalK_one, _, _, hvalK_mul, hvalK_inv, hvalK_surj, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K
  obtain ⟨ϖ_K, hϖ_K⟩ := hvalK_surj 1
  obtain ⟨hf_K, hq, _⟩ :=
    ld_recMap_uniformizer_frob_on_primeToP_roots F rec L K hLK ϖ_K hϖ_K
  obtain ⟨M₀, M', hKM₀, hMM₀, hM₀M', ζ_N, hGalKM₀, hAbKM₀, _, hζ_prim, hζ_p, hζ_mem, hGalM', hAbM'⟩ :=
    ld_abelian_compositum_and_cyclotomic_ext F L K M hLK hLM hGalK hAbK hGalM hAbM (resDeg F K) hf_K
  haveI : FiniteDimensional F M₀ := hGalKM₀.2.1
  let Φ₁ : Kˣ →* (Ω F)ˣ := χ_ab'.comp (Units.map (normLM F hLK))
  have hχK_kerM₀ : ∀ w : relWeil F K,
      (w : AbsGal F) ∈ M₀.fixingSubgroup → (restrictWeilChar F hLK χ_ab) w = 1 := by
    intro w hwM₀
    apply hχ_kerM (Subgroup.inclusion (relWeil_antitone F hLK) w)
    exact IntermediateField.fixingSubgroup_le hMM₀ hwM₀
  have hχK_rec_mul : ∀ y₁ y₂ : Kˣ,
      (restrictWeilChar F hLK χ_ab) (rec.recMap K (y₁ * y₂)) =
        (restrictWeilChar F hLK χ_ab) (rec.recMap K y₁) *
          (restrictWeilChar F hLK χ_ab) (rec.recMap K y₂) := by
    intro y₁ y₂
    have hmem := rec.mul_rec K M₀ hKM₀ hAbKM₀ y₁ y₂
    have htriv := hχK_kerM₀ ((rec.recMap K (y₁ * y₂))⁻¹ * (rec.recMap K y₁ * rec.recMap K y₂)) hmem
    rw [map_mul, map_inv, map_mul, inv_mul_eq_one] at htriv
    exact htriv
  have hχK_rec_one : (restrictWeilChar F hLK χ_ab) (rec.recMap K 1) = 1 := by
    have h1 := hχK_rec_mul 1 1
    rw [mul_one] at h1
    simpa using congrArg (fun z => ((restrictWeilChar F hLK χ_ab) (rec.recMap K 1))⁻¹ * z) h1.symm
  let Φ₂ : Kˣ →* (Ω F)ˣ :=
    { toFun := fun y => (restrictWeilChar F hLK χ_ab) (rec.recMap K y)
      map_one' := hχK_rec_one
      map_mul' := hχK_rec_mul }
  have hΦ₁_apply : ∀ y : Kˣ, Φ₁ y = χ_ab' (Units.map (normLM F hLK) y) := fun _ => rfl
  have hΦ₂_apply : ∀ y : Kˣ, Φ₂ y = (restrictWeilChar F hLK χ_ab) (rec.recMap K y) := fun _ => rfl
  have hΦ_unif : ∀ z : Kˣ, valL F K (z : K) = 1 → Φ₁ z = Φ₂ z := by
    intro z hz
    obtain ⟨_, _, hz_frob⟩ :=
      ld_recMap_uniformizer_frob_on_primeToP_roots F rec L K hLK z hz
    obtain ⟨σ_K, k, hσ_K, hσ_Kk⟩ :=
      ld_recMap_norm_in_zpowers_on_abelian_ext F rec L K M' hLK (hKM₀.trans hM₀M') hGalM' hAbM' z
    have hLM' : L ≤ M' := hLK.trans (hKM₀.trans hM₀M')
    have hk_ζ :
        (((σ_K ^ k) ⟨ζ_N, (IntermediateField.mem_extendScalars hLM').mpr hζ_mem⟩ :
          IntermediateField.extendScalars hLM') : AlgebraicClosure F) =
          (rec.recMap K z : AbsGal F) ζ_N := by
      rw [hσ_Kk ⟨ζ_N, (IntermediateField.mem_extendScalars hLM').mpr hζ_mem⟩]
      exact (hz_frob ζ_N hζ_p).2
    have h_eq_M₀ :=
      ld_frob_zpow_eq_on_subfield_of_primitiveRoot F L K M₀ M' hLK hKM₀ hM₀M' hGalKM₀
        (resDeg F K) hf_K hq ζ_N hζ_prim hζ_p hζ_mem
        (rec.recMap K z : AbsGal F) (rec.recMap K z).2.2
        (fun ζ hζ => (hz_frob ζ hζ).1) σ_K hσ_K k hk_ζ
    let w_L : relWeil F L := rec.recMap L (Units.map (normLM F hLK) z)
    let w_K_L : relWeil F L := Subgroup.inclusion (relWeil_antitone F hLK) (rec.recMap K z)
    have h_diff_M : ((w_L⁻¹ * w_K_L : relWeil F L) : AbsGal F) ∈ M.fixingSubgroup := by
      rintro ⟨a, ha⟩
      have ha_M₀ : a ∈ M₀ := hMM₀ ha
      have ha_eq : (w_L : AbsGal F) a = (rec.recMap K z : AbsGal F) a := by
        have h1 := hσ_Kk ⟨a, (IntermediateField.mem_extendScalars hLM').mpr (hM₀M' ha_M₀)⟩
        have h2 := h_eq_M₀ a ha_M₀
        exact h1.symm.trans h2
      change ((w_L : AbsGal F)⁻¹ * (rec.recMap K z : AbsGal F)) a = a
      rw [AlgEquiv.mul_apply, ← ha_eq]
      exact (w_L : AbsGal F).symm_apply_apply a
    have htriv := hχ_kerM (w_L⁻¹ * w_K_L) h_diff_M
    rw [map_mul, map_inv, inv_mul_eq_one] at htriv
    rw [hΦ₁_apply, hΦ₂_apply, hχ_ab'_apply]
    exact htriv
  have hvalK_pow : ∀ n : ℕ, valL F K (((ϖ_K ^ n : Kˣ) : K)) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simpa using hvalK_one
    · rw [pow_succ, Units.val_mul, hvalK_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_K, Nat.cast_add, Nat.cast_one]
  have hvalK_zpow : ∀ m : ℤ, valL F K (((ϖ_K ^ m : Kˣ) : K)) = m := by
    intro m
    cases m with
    | ofNat n =>
      simpa using hvalK_pow n
    | negSucc n =>
      rw [zpow_negSucc, hvalK_inv, hvalK_pow (n + 1)]
      rfl
  refine ⟨χ_ab', hχ_ab'_apply, hχ_ab'_unit, ?_⟩
  intro y
  set m_y : ℤ := valL F K (y : K)
  let u : Kˣ := y * ϖ_K ^ (-m_y)
  have hval_u : valL F K (u : K) = 0 := by
    change valL F K ((y : K) * ((ϖ_K ^ (-m_y) : Kˣ) : K)) = 0
    rw [hvalK_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hvalK_zpow (-m_y)]
    change m_y + -m_y = 0
    omega
  have hval_ϖu : valL F K (((ϖ_K * u : Kˣ) : K)) = 1 := by
    rw [Units.val_mul, hvalK_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hϖ_K, hval_u, add_zero]
  have hy_eq : y = (ϖ_K * u) * ϖ_K ^ (m_y - 1) := by
    have h1 : (ϖ_K * u) * ϖ_K ^ (m_y - 1) = y * (ϖ_K ^ (1 : ℤ) * ϖ_K ^ (-m_y) * ϖ_K ^ (m_y - 1)) := by
      dsimp [u]
      rw [zpow_one]
      ac_rfl
    rw [h1, ← zpow_add, ← zpow_add, show (1 : ℤ) + -m_y + (m_y - 1) = 0 by omega, zpow_zero, mul_one]
  have hΦ_eq : Φ₁ y = Φ₂ y := by
    rw [hy_eq, Φ₁.map_mul (ϖ_K * u), Φ₁.map_zpow, Φ₂.map_mul (ϖ_K * u), Φ₂.map_zpow,
      hΦ_unif (ϖ_K * u) hval_ϖu, hΦ_unif ϖ_K hϖ_K]
  exact hΦ_eq

theorem ld_ch10_recChar_norm_and_min_cond_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (μ₁ χL_ext : relWeil F L →* (Ω F)ˣ)
    (hμ₁_weil : IsWeilRep F L (charRep F L μ₁))
    (hμ₁_rest : restrictWeilChar F hLK μ₁ = 1)
    (hμ₁_pow : μ₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hμ₁_ne : μ₁ ≠ 1)
    (hχL_ext : IsWeilRep F L (charRep F L χL_ext)) :
    ∃ (ν₁ χ' : Lˣ →* (Ω F)ˣ),
      ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1 ∧
      ν₁ ≠ 1 ∧
      (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1) ∧
      (∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
        ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1) ∧
      (∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
        ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1) ∧
      (∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
        (χ'.comp (Units.map (normLM F hLK))) u = 1) ∧
      (∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
        condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ')) ∧
      (tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEps F L (ν₁ ^ j) ψ) =
      tateEps F K 1 (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEps F L (ν₁ ^ j * χ') ψ) →
      tateEpsUnit F K (recChar F rec K (restrictWeilChar F hLK χL_ext)) (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEpsUnit F L (recChar F rec L (μ₁ ^ j)) ψ) =
      tateEpsUnit F K (recChar F rec K 1) (traceChar F hLK ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEpsUnit F L (recChar F rec L (μ₁ ^ j * χL_ext)) ψ)) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨hFinL, htr_adm⟩ := htraceChar L K hLK hAb.2.2
  haveI : FiniteDimensional F L := hFinL
  have hψK : IsAdmissibleChar F K (traceChar F hLK ψ) := (htr_adm ψ hψ).1
  
  have hWeil_one : ∀ (L' : IntermediateField F (AlgebraicClosure F)),
      IsWeilRep F L' (charRep F L' 1) := by
    intro L'
    refine ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ _ => ?_⟩
    apply LinearMap.ext
    intro v
    change ((1 : relWeil F L' →* (Ω F)ˣ) w : Ω F) • v = v
    rw [MonoidHom.one_apply, Units.val_one, one_smul]
  have hcharRep_mul : ∀ (χ₁ χ₂ : relWeil F L →* (Ω F)ˣ) (w : relWeil F L),
      charRep F L (χ₁ * χ₂) w = charRep F L χ₁ w * charRep F L χ₂ w := by
    intro χ₁ χ₂ w
    apply LinearMap.ext
    intro v
    change ((χ₁ * χ₂) w : Ω F) • v = (χ₁ w : Ω F) • ((χ₂ w : Ω F) • v)
    rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
  have hWeil_mul : ∀ {χ₁ χ₂ : relWeil F L →* (Ω F)ˣ},
      IsWeilRep F L (charRep F L χ₁) → IsWeilRep F L (charRep F L χ₂) →
      IsWeilRep F L (charRep F L (χ₁ * χ₂)) := by
    rintro χ₁ χ₂ ⟨hfin, U₁, hU₁, htriv₁⟩ ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    rw [hcharRep_mul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  have hWeil_pow : ∀ (j : ℕ), IsWeilRep F L (charRep F L (μ₁ ^ j)) := by
    intro j
    induction' j with j ih
    · have h0 : μ₁ ^ (0 : ℕ) = 1 := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_zero, MonoidHom.one_apply]
      rw [h0]
      exact hWeil_one L
    · have hsucc : μ₁ ^ (j + 1) = μ₁ ^ j * μ₁ := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_succ, MonoidHom.mul_apply, MonoidHom.pow_apply]
      rw [hsucc]
      exact hWeil_mul ih hμ₁_weil
  have hWeil_rest : IsWeilRep F K (charRep F K (restrictWeilChar F hLK χL_ext)) := by
    rcases hχL_ext with ⟨hfin, U, hU, htriv⟩
    refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
    exact htriv (Subgroup.inclusion (relWeil_antitone F hLK) w) hwU hwI
  have hWeil_unit_triv : ∀ (L' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L']
      (χ : relWeil F L' →* (Ω F)ˣ), IsWeilRep F L' (charRep F L' χ) →
      ∀ (θ : L'ˣ →* (Ω F)ˣ), (∀ x : L'ˣ, θ x = χ (rec.recMap L' x)) →
        ∀ u ∈ unitGroup F L' (condExp F L' θ), θ u = 1 := by
    intro L' _ χ hχ θ hθ
    obtain ⟨M, hLM, ω, χ_ab, hGalM, hAbM, hχ_eq, hω_I, hχ_ab_rest⟩ :=
      ld_weil_char_untwist_abelian_decomp F L' χ hχ
    haveI : FiniteDimensional F M := hGalM.2.1
    obtain ⟨ω', hω'_rec, hω'_unit0, _⟩ :=
      ld_unramified_weil_char_rec_and_norm F rec L' M hLM hAbM.2.2 ω hω_I
    obtain ⟨a_M, _, ha_M⟩ :=
      ld_separable_unitGroup_sub_norm_range F L' M hLM hAbM.2.2
    obtain ⟨χ_ab', hχ_ab'_rec, hχ_ab'_unit, _⟩ :=
      ld_abelian_weil_char_rec_and_norm F rec L' M M hLM hLM hGalM hAbM hGalM hAbM
        χ_ab hχ_ab_rest a_M ha_M
    obtain ⟨_, _, _, _, _, _, _, _, hunit0, _, hunit_val0⟩ := ld_valL_and_unitGroup_props F L'
    have ha_M_mem : a_M ∈ {a : ℕ | ∀ u ∈ unitGroup F L' a, θ u = 1} := by
      intro u hu
      have hu0 : u ∈ unitGroup F L' 0 := (hunit0 u).mpr (hunit_val0 a_M u hu)
      rw [hθ u, hχ_eq, MonoidHom.mul_apply, ← hω'_rec u, ← hχ_ab'_rec u,
        hω'_unit0 u hu0, hχ_ab'_unit u hu, mul_one]
    exact Nat.sInf_mem ⟨a_M, ha_M_mem⟩
  
  have hμ₁_kerK : ∀ w : relWeil F L, (w : AbsGal F) ∈ K.fixingSubgroup → μ₁ w = 1 := by
    intro w hwK
    have hw_relK : (w : AbsGal F) ∈ relWeil F K := ⟨w.2.1, hwK⟩
    have h1 : restrictWeilChar F hLK μ₁ ⟨w.1, hw_relK⟩ = 1 := by
      rw [hμ₁_rest]
      rfl
    exact h1
  have hμ₁_rec_mul : ∀ x y : Lˣ,
      μ₁ (rec.recMap L (x * y)) = μ₁ (rec.recMap L x) * μ₁ (rec.recMap L y) := by
    intro x y
    have hmem := rec.mul_rec L K hLK hAb x y
    have htriv := hμ₁_kerK ((rec.recMap L (x * y))⁻¹ * (rec.recMap L x * rec.recMap L y)) hmem
    rw [map_mul, map_inv, map_mul, inv_mul_eq_one] at htriv
    exact htriv
  have hμ₁_rec_one : μ₁ (rec.recMap L 1) = 1 := by
    have h1 := hμ₁_rec_mul 1 1
    rw [mul_one] at h1
    simpa using congrArg (fun z => (μ₁ (rec.recMap L 1))⁻¹ * z) h1.symm
  obtain ⟨ν₁, hν₁_apply⟩ : ∃ ν₁ : Lˣ →* (Ω F)ˣ, ∀ x : Lˣ, ν₁ x = μ₁ (rec.recMap L x) :=
    ⟨{ toFun := fun x => μ₁ (rec.recMap L x)
       map_one' := hμ₁_rec_one
       map_mul' := hμ₁_rec_mul }, fun _ => rfl⟩
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
  have hν₁_pow : ν₁ ^ ℓ = 1 := by
    apply MonoidHom.ext
    intro x
    rw [MonoidHom.pow_apply, MonoidHom.one_apply, hν₁_apply, ← MonoidHom.pow_apply,
      hμ₁_pow, MonoidHom.one_apply]
  have hν₁_mod : ∀ k : ℕ, ν₁ ^ k = ν₁ ^ (k % ℓ) := by
    intro k
    apply MonoidHom.ext
    intro x
    have h1 : (ν₁ x) ^ ℓ = 1 := by
      rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
    rw [MonoidHom.pow_apply, MonoidHom.pow_apply]
    conv_lhs => rw [← Nat.div_add_mod k ℓ]
    rw [pow_add, pow_mul, h1, one_pow, one_mul]
  have hν₁_ne : ν₁ ≠ 1 := by
    intro h1
    apply hμ₁_ne
    apply MonoidHom.ext
    intro w
    obtain ⟨x, hx⟩ := rec.surj_rec L K hLK hAb w
    have htriv := hμ₁_kerK ((rec.recMap L x)⁻¹ * w) hx
    rw [map_mul, map_inv, inv_mul_eq_one] at htriv
    have hx1 : ν₁ x = 1 := by
      rw [h1, MonoidHom.one_apply]
    rw [hν₁_apply] at hx1
    rw [← htriv, hx1, MonoidHom.one_apply]
  have hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1 := by
    have hNK_mem : ∀ w : relWeil F L,
        w ∈ (relWeil F K).subgroupOf (relWeil F L) ↔ (w : AbsGal F) ∈ K.fixingSubgroup := by
      intro w
      exact ⟨fun hw => hw.2, fun hw => ⟨w.2.1, hw⟩⟩
    haveI : ((relWeil F K).subgroupOf (relWeil F L)).Normal :=
      ⟨fun n hn g => (hNK_mem _).mpr (hGal.2.2.1 g.1 g.2.2 n.1 ((hNK_mem n).mp hn))⟩
    obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
    obtain ⟨_, hcard_Q⟩ := ld_relWeil_quotient_card_eq_finrank F hp hFrob L K hLK hAb.2.2
    have hμ₁_iff_K : ∀ w : relWeil F L, (w : AbsGal F) ∈ K.fixingSubgroup ↔ μ₁ w = 1 := by
      intro w
      refine ⟨hμ₁_kerK w, fun hw1 => ?_⟩
      by_contra hwK
      let q_w : relWeil F L ⧸ (relWeil F K).subgroupOf (relWeil F L) :=
        QuotientGroup.mk' ((relWeil F K).subgroupOf (relWeil F L)) w
      have hqw_ne : q_w ≠ 1 := by
        intro hq1
        exact hwK ((hNK_mem w).mp ((QuotientGroup.eq_one_iff w).mp hq1))
      have hne1 : ∃ w₀ : relWeil F L, μ₁ w₀ ≠ 1 := by
        by_contra hall
        push_neg at hall
        exact hμ₁_ne (MonoidHom.ext hall)
      obtain ⟨w₀, hw₀⟩ := hne1
      let q_w₀ : relWeil F L ⧸ (relWeil F K).subgroupOf (relWeil F L) :=
        QuotientGroup.mk' ((relWeil F K).subgroupOf (relWeil F L)) w₀
      haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
      have hmem_zpow : q_w₀ ∈ Subgroup.zpowers q_w :=
        mem_zpowers_of_prime_card hcard_Q hqw_ne
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem_zpow
      have hk' : QuotientGroup.mk' ((relWeil F K).subgroupOf (relWeil F L)) (w ^ k) =
          QuotientGroup.mk' ((relWeil F K).subgroupOf (relWeil F L)) w₀ := by
        rw [map_zpow]
        exact hk
      have hmem_NK : (w ^ k)⁻¹ * w₀ ∈ (relWeil F K).subgroupOf (relWeil F L) :=
        QuotientGroup.eq.mp hk'
      have htriv := hμ₁_kerK ((w ^ k)⁻¹ * w₀) ((hNK_mem _).mp hmem_NK)
      rw [map_mul, map_inv, map_zpow, hw1, one_zpow, inv_one, one_mul] at htriv
      exact hw₀ htriv
    intro x
    rw [hν₁_apply, ← hμ₁_iff_K (rec.recMap L x), rec.ker_rec L K hLK hAb x]
    refine ⟨?_, ?_⟩
    · rintro ⟨y, rfl⟩
      exact ⟨(y : K), rfl⟩
    · rintro ⟨z, hz⟩
      haveI : Module.Finite L (IntermediateField.extendScalars hLK) :=
        Module.finite_of_finrank_pos hPrime.pos
      have hz_ne : z ≠ 0 := by
        intro h0
        have hnorm0 : normLM F hLK z = 0 := by
          rw [h0]
          exact Algebra.norm_zero (R := L) (S := IntermediateField.extendScalars hLK)
        rw [hnorm0] at hz
        exact Units.ne_zero x hz.symm
      exact ⟨Units.mk0 z hz_ne, Units.ext hz⟩
  have hν₁_pow_rec : ∀ (j : ℕ) (x : Lˣ), (ν₁ ^ j) x = (μ₁ ^ j) (rec.recMap L x) := by
    intro j x
    rw [MonoidHom.pow_apply, MonoidHom.pow_apply, hν₁_apply]
  have hν₁_cond : ∀ j < ℓ,
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1 :=
    fun j _ => hWeil_unit_triv L (μ₁ ^ j) (hWeil_pow j) (ν₁ ^ j) (hν₁_pow_rec j)
  
  obtain ⟨M_L, hLM_L, ω_L, χ_ab_L, hGalM_L, hAbM_L, hχL_eq, hω_L_I, hχ_ab_L_rest⟩ :=
    ld_weil_char_untwist_abelian_decomp F L χL_ext hχL_ext
  haveI : FiniteDimensional F M_L := hGalM_L.2.1
  obtain ⟨ω_L', hω_L'_rec, _, hω_L'_norm⟩ :=
    ld_unramified_weil_char_rec_and_norm F rec L K hLK hAb.2.2 ω_L hω_L_I
  obtain ⟨a_ML, _, ha_ML⟩ :=
    ld_separable_unitGroup_sub_norm_range F L M_L hLM_L hAbM_L.2.2
  obtain ⟨χ_ab_L', hχ_ab_L'_rec, _, hχ_ab_L'_norm⟩ :=
    ld_abelian_weil_char_rec_and_norm F rec L K M_L hLK hLM_L hGal hAb hGalM_L hAbM_L
      χ_ab_L hχ_ab_L_rest a_ML ha_ML
  obtain ⟨χ₀', hχ₀'_apply⟩ : ∃ χ₀' : Lˣ →* (Ω F)ˣ, ∀ x : Lˣ, χ₀' x = ω_L' x * χ_ab_L' x :=
    ⟨ω_L' * χ_ab_L', fun _ => rfl⟩
  have hχ₀'_rec : ∀ x : Lˣ, χ₀' x = χL_ext (rec.recMap L x) := by
    intro x
    rw [hχ₀'_apply x, hω_L'_rec x, hχ_ab_L'_rec x, hχL_eq, MonoidHom.mul_apply]
  have hrest_mul : restrictWeilChar F hLK (ω_L * χ_ab_L) =
      restrictWeilChar F hLK ω_L * restrictWeilChar F hLK χ_ab_L := by
    apply MonoidHom.ext
    intro w
    rfl
  have hχ₀'_norm : ∀ y : Kˣ,
      (χ₀'.comp (Units.map (normLM F hLK))) y =
        (restrictWeilChar F hLK χL_ext) (rec.recMap K y) := by
    intro y
    rw [MonoidHom.comp_apply, hχ₀'_apply, hω_L'_norm y, hχ_ab_L'_norm y,
      hχL_eq, hrest_mul, MonoidHom.mul_apply]
  obtain ⟨j₀, hj₀_mem, hj₀_min⟩ :=
    Finset.exists_min_image (Finset.range ℓ) (fun j => condExp F L (ν₁ ^ j * χ₀'))
      ⟨0, Finset.mem_range.mpr hPrime.pos⟩
  obtain ⟨χ', hχ'_def⟩ : ∃ χ' : Lˣ →* (Ω F)ˣ, χ' = ν₁ ^ j₀ * χ₀' := ⟨ν₁ ^ j₀ * χ₀', rfl⟩
  have hshift_char : ∀ (j : ℕ), ν₁ ^ j * χ' = ν₁ ^ ((j + j₀) % ℓ) * χ₀' := by
    intro j
    rw [hχ'_def, ← hν₁_mod (j + j₀)]
    apply MonoidHom.ext
    intro x
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, MonoidHom.mul_apply,
      MonoidHom.pow_apply, MonoidHom.pow_apply, MonoidHom.pow_apply,
      ← mul_assoc, ← pow_add]
  have htwist_rec : ∀ (i : ℕ) (x : Lˣ),
      (ν₁ ^ i * χ₀') x = (μ₁ ^ i * χL_ext) (rec.recMap L x) := by
    intro i x
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hν₁_pow_rec i x, hχ₀'_rec x]
  have hχ'_cond : ∀ j < ℓ,
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1 := by
    intro j _
    rw [hshift_char j]
    exact hWeil_unit_triv L (μ₁ ^ ((j + j₀) % ℓ) * χL_ext)
      (hWeil_mul (hWeil_pow _) hχL_ext) (ν₁ ^ ((j + j₀) % ℓ) * χ₀')
      (htwist_rec ((j + j₀) % ℓ))
  have hχ'_comp_eq : χ'.comp (Units.map (normLM F hLK)) =
      χ₀'.comp (Units.map (normLM F hLK)) := by
    rw [hχ'_def]
    apply MonoidHom.ext
    intro y
    have hy_norm : ν₁ (Units.map (normLM F hLK) y) = 1 :=
      (hν₁_ker (Units.map (normLM F hLK) y)).mp ⟨y, rfl⟩
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply, MonoidHom.mul_apply,
      MonoidHom.pow_apply, hy_norm, one_pow, one_mul]
  have hχ'K_rec : ∀ y : Kˣ,
      (χ'.comp (Units.map (normLM F hLK))) y =
        (restrictWeilChar F hLK χL_ext) (rec.recMap K y) := by
    intro y
    rw [hχ'_comp_eq]
    exact hχ₀'_norm y
  have hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1 :=
    hWeil_unit_triv K (restrictWeilChar F hLK χL_ext) hWeil_rest
      (χ'.comp (Units.map (normLM F hLK))) hχ'K_rec
  have hMinCond : ∀ j < ℓ, condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ') := by
    intro j _
    rw [hshift_char j, hχ'_def]
    exact hj₀_min ((j + j₀) % ℓ) (Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
  have hshift_prod :
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j * χ') ψ) =
        ∏ i ∈ Finset.range ℓ, tateEps F L (ν₁ ^ i * χ₀') ψ := by
    have hj₀_lt : j₀ < ℓ := Finset.mem_range.mp hj₀_mem
    refine Finset.prod_bij' (fun j _ => (j + j₀) % ℓ) (fun i _ => (i + (ℓ - j₀)) % ℓ)
      (fun j _ => Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
      (fun i _ => Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos))
      (fun j hj => ?_) (fun i hi => ?_) (fun j _ => ?_)
    · dsimp only
      have hj_lt : j < ℓ := Finset.mem_range.mp hj
      rw [Nat.mod_add_mod, show j + j₀ + (ℓ - j₀) = j + ℓ by omega,
        Nat.add_mod_right, Nat.mod_eq_of_lt hj_lt]
    · dsimp only
      have hi_lt : i < ℓ := Finset.mem_range.mp hi
      rw [Nat.mod_add_mod, show i + (ℓ - j₀) + j₀ = i + ℓ by omega,
        Nat.add_mod_right, Nat.mod_eq_of_lt hi_lt]
    · dsimp only
      rw [hshift_char j]
  refine ⟨ν₁, χ', hν₁_pow, hν₁_ne, hν₁_ker, hν₁_cond, hχ'_cond, hχ'K_cond, hMinCond, ?_⟩
  intro hEps_eq
  have heps_K_χ : (tateEpsUnit F K (recChar F rec K (restrictWeilChar F hLK χL_ext))
      (traceChar F hLK ψ) : Ω F) =
      tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) :=
    (htateEps K (traceChar F hLK ψ) hψK (restrictWeilChar F hLK χL_ext) hWeil_rest
      (χ'.comp (Units.map (normLM F hLK))) hχ'K_rec).2
  have heps_K_1 : (tateEpsUnit F K (recChar F rec K 1) (traceChar F hLK ψ) : Ω F) =
      tateEps F K 1 (traceChar F hLK ψ) :=
    (htateEps K (traceChar F hLK ψ) hψK 1 (hWeil_one K) 1 (fun _ => rfl)).2
  have heps_L_μ : (∏ j ∈ Finset.range ℓ,
      (tateEpsUnit F L (recChar F rec L (μ₁ ^ j)) ψ : Ω F)) =
      ∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ :=
    Finset.prod_congr rfl fun j _ =>
      (htateEps L ψ hψ (μ₁ ^ j) (hWeil_pow j) (ν₁ ^ j) (hν₁_pow_rec j)).2
  have heps_L_twist : (∏ j ∈ Finset.range ℓ,
      (tateEpsUnit F L (recChar F rec L (μ₁ ^ j * χL_ext)) ψ : Ω F)) =
      ∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j * χ₀') ψ :=
    Finset.prod_congr rfl fun j _ =>
      (htateEps L ψ hψ (μ₁ ^ j * χL_ext)
        (hWeil_mul (hWeil_pow j) hχL_ext) (ν₁ ^ j * χ₀') (htwist_rec j)).2
  have h_unit_prod : ∀ (s : Finset ℕ) (g : ℕ → (Ω F)ˣ),
      ((∏ j ∈ s, g j : (Ω F)ˣ) : Ω F) = ∏ j ∈ s, (g j : Ω F) := by
    intro s g
    induction' s using Finset.cons_induction with a s ha ih
    · rfl
    · rw [Finset.prod_cons, Finset.prod_cons, Units.val_mul, ih]
  apply Units.ext
  rw [Units.val_mul, h_unit_prod, Units.val_mul, h_unit_prod,
    heps_K_χ, heps_K_1, heps_L_μ, heps_L_twist, ← hshift_prod]
  exact hEps_eq

theorem ld_ch10_unramified_arith_and_twist_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hUnram : condExp F L ν₁ = 0)
    (hSpecL : ∀ [FiniteDimensional F L] (ψ' : AddChar L (Ω F)), IsAdmissibleChar F L ψ' →
      ∀ (θ : Lˣ →* (Ω F)ˣ),
        (∀ x : L, (x = 0 ∨ -condExpChar F L ψ' ≤ valL F L x) → ψ' x = 1) ∧
        (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ' + 1) ≤ valL F L x₁ ∧ ψ' x₁ ≠ 1) ∧
        (condExp F L θ ≠ 0 →
          (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
          (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
        valL F L ((tateElt F L θ ψ' : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ')
    (hSpecK : ∀ [FiniteDimensional F K] (ψK : AddChar K (Ω F)), IsAdmissibleChar F K ψK →
      ∀ (θK : Kˣ →* (Ω F)ˣ),
        (∀ y : K, (y = 0 ∨ -condExpChar F K ψK ≤ valL F K y) → ψK y = 1) ∧
        (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K ψK + 1) ≤ valL F K y₁ ∧ ψK y₁ ≠ 1) ∧
        (condExp F K θK ≠ 0 →
          (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
          (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
        valL F K ((tateElt F K θK ψK : Kˣ) : K) = (condExp F K θK : ℤ) + condExpChar F K ψK)
    (hFinL : ∀ [FiniteDimensional F L] (a : ℕ), 1 ≤ a →
      Set.Finite {u : Lˣ ⧸ unitGroup F L a | valL F L ((cosetRep u : Lˣ) : L) = 0}) :
    FiniteDimensional F L ∧
    (∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y) ∧
    (∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x) ∧
    resDeg F K = Module.finrank L (IntermediateField.extendScalars hLK) * resDeg F L ∧
    qL F K = (qL F L) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
    (∀ u ∈ unitGroup F L 0, ∃ w ∈ unitGroup F K 0, Units.map (normLM F hLK) w = u) ∧
    ((∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
        (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) →
      (∃ y₁ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) ∧ traceLM F hLK y₁ = 1) →
      (∀ (d : ℕ), 1 ≤ d → ∀ y : K, (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
        (normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
          (2 * d : ℤ) ≤ valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)))) →
      IsAdmissibleChar F K (traceChar F hLK ψ) ∧
      condExpChar F K (traceChar F hLK ψ) = condExpChar F L ψ ∧
      condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ' ∧
      ((1 ≤ condExp F L χ' →
        tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) =
          (-1 : Ω F) ^ (condExp F L χ' *
            (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) *
            (tateEps F L χ' ψ) ^ (Module.finrank L (IntermediateField.extendScalars hLK))) →
        tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
          (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
            tateEps F L (ν₁ ^ j) ψ) =
        tateEps F K 1 (traceChar F hLK ψ) *
          (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
            tateEps F L (ν₁ ^ j * χ') ψ))) :=
by
  
  haveI : FiniteDimensional F K := hGal.2.1
  have hFinDimL : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (RingHom.injective (IntermediateField.inclusion hLK).toRingHom)
  haveI : FiniteDimensional F L := hFinDimL
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_surj_K,
    hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, _, haddVal_mul, _, _, _, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_zpow_L : ∀ (u : Lˣ) (m : ℤ),
      valL F L (((u ^ m : Lˣ) : L)) = m * valL F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * valL F L (u : L)
      rw [zpow_natCast, Units.val_pow_eq_pow_val, hval_pow_L (u : L) n (Units.ne_zero u)]
    | negSucc n =>
      rw [zpow_negSucc, hval_inv_L (u ^ (n + 1)), Units.val_pow_eq_pow_val,
        hval_pow_L (u : L) (n + 1) (Units.ne_zero u), Int.negSucc_eq]
      push_cast
      ring
  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖ₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q : ℤ := valL F M z
      set r : ℤ := relVal F M z % f
      have hediv : f * q + r = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
        let y : M := z * (((ϖM ^ (-q) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q), hrel_ϖM]
          linarith
        let k : ℕ := r.toNat
        have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hval_surj_L
  obtain ⟨hresDeg_K_pos, hdiv_K⟩ := hrelVal_div K hval_surj_K
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hresDeg_L_pos)
  set K' := IntermediateField.extendScalars hLK
  set ℓ := Module.finrank L K'
  have hrelVal_norm : ∀ y : K, relVal F L (normLM F hLK y) = relVal F K y := by
    intro y
    let eF : K ≃ₐ[F] K' :=
      { toExtendScalars F hLK with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLK).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F K' := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
    change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y))) =
      addVal F (Algebra.norm F y)
    have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLK y)) =
        Algebra.norm F (toExtendScalars F hLK y) := Algebra.norm_norm
    have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hLK y) :=
      Algebra.norm_eq_of_algEquiv eF y
    rw [h1, ← h2]
  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (algebraMap L K' x) = x ^ ℓ
    exact Algebra.norm_algebraMap x
  have htrace_inc_mul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    letI : Module L L := Semiring.toModule
    intro x y
    exact (Algebra.trace L K').map_smul' x (toExtendScalars F hLK y)

  
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt
  have hℓ_int_ne : (ℓ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hℓ_pos)
  have hν₁_unit0 : ∀ u ∈ unitGroup F L 0, ν₁ u = 1 := by
    intro u hu
    have h := hν₁_cond 1 hℓ_gt1 u
    rw [pow_one ν₁, hUnram] at h
    exact h hu
  obtain ⟨ϖL, hϖL⟩ := hval_surj_L 1
  set ζ : (Ω F)ˣ := ν₁ ϖL
  have hν₁_eq_zpow : ∀ x : Lˣ, ν₁ x = ζ ^ (valL F L (x : L)) := by
    intro x
    set m : ℤ := valL F L (x : L)
    let u : Lˣ := x * (ϖL ^ m)⁻¹
    have hu_val : valL F L (u : L) = 0 := by
      dsimp [u]
      rw [hval_mul_L (x : L) _ (Units.ne_zero x) (Units.ne_zero _),
        hval_inv_L (ϖL ^ m), hval_zpow_L ϖL m, hϖL, mul_one]
      omega
    have hu_mem : u ∈ unitGroup F L 0 := (hunit0_L u).mpr hu_val
    have hx_eq : x = u * (ϖL ^ m) := by
      dsimp [u]
      rw [inv_mul_cancel_right]
    conv_lhs => rw [hx_eq]
    rw [map_mul, hν₁_unit0 u hu_mem, one_mul, map_zpow]
  have hζ_pow : ζ ^ ℓ = 1 := by
    dsimp [ζ]
    rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
  have hζ_ne : ζ ≠ 1 := by
    intro h1
    apply hν₁_ne
    ext x
    rw [hν₁_eq_zpow x, h1, one_zpow, MonoidHom.one_apply]
  have hζ_ord : orderOf ζ = ℓ := orderOf_eq_prime hζ_pow hζ_ne
  have hnorm_range_iff : ∀ x : Lˣ,
      x ∈ Set.range (Units.map (normLM F hLK)) ↔ (ℓ : ℤ) ∣ valL F L (x : L) := by
    intro x
    rw [hν₁_ker x, hν₁_eq_zpow x, ← orderOf_dvd_iff_zpow_eq_one, hζ_ord]
  have hresDeg : resDeg F K = ℓ * resDeg F L := by
    apply le_antisymm
    · let xL : Lˣ := ϖL ^ ℓ
      have hxL_val : valL F L (xL : L) = (ℓ : ℤ) := by
        dsimp [xL]
        rw [hval_pow_L (ϖL : L) ℓ (Units.ne_zero ϖL), hϖL, mul_one]
      have hxL_range : xL ∈ Set.range (Units.map (normLM F hLK)) := by
        rw [hnorm_range_iff xL, hxL_val]
      obtain ⟨w₁, hw₁⟩ := hxL_range
      have hw₁_coe : normLM F hLK (w₁ : K) = (xL : L) := congrArg Units.val hw₁
      have hrel_w₁ : relVal F K (w₁ : K) = ((ℓ * resDeg F L : ℕ) : ℤ) := by
        rw [← hrelVal_norm (w₁ : K), hw₁_coe, hdiv_L (xL : L), hxL_val, Nat.cast_mul, mul_comm]
      have hmem : ℓ * resDeg F L ∈ {k : ℕ | 0 < k ∧ ∃ y : K, y ≠ 0 ∧ relVal F K y = (k : ℤ)} :=
        ⟨Nat.mul_pos hℓ_pos hresDeg_L_pos, (w₁ : K), Units.ne_zero w₁, hrel_w₁⟩
      exact Nat.sInf_le hmem
    · obtain ⟨ϖK, hϖK⟩ := hval_surj_K 1
      let xK : Lˣ := Units.map (normLM F hLK) ϖK
      have hxK_range : xK ∈ Set.range (Units.map (normLM F hLK)) := ⟨ϖK, rfl⟩
      obtain ⟨k, hk⟩ := (hnorm_range_iff xK).mp hxK_range
      have hrel_ϖK : (resDeg F K : ℤ) = ((ℓ * resDeg F L : ℕ) : ℤ) * k := by
        calc (resDeg F K : ℤ)
          _ = (resDeg F K : ℤ) * valL F K (ϖK : K) := by rw [hϖK, mul_one]
          _ = relVal F K (ϖK : K) := (hdiv_K (ϖK : K)).symm
          _ = relVal F L (normLM F hLK (ϖK : K)) := (hrelVal_norm (ϖK : K)).symm
          _ = (resDeg F L : ℤ) * valL F L (xK : L) := hdiv_L (xK : L)
          _ = (resDeg F L : ℤ) * ((ℓ : ℤ) * k) := by rw [hk]
          _ = ((ℓ * resDeg F L : ℕ) : ℤ) * k := by push_cast; ring
      have hdvd_int : ((ℓ * resDeg F L : ℕ) : ℤ) ∣ (resDeg F K : ℤ) := ⟨k, hrel_ϖK⟩
      have hdvd_nat : ℓ * resDeg F L ∣ resDeg F K := Int.ofNat_dvd.mp hdvd_int
      exact Nat.le_of_dvd hresDeg_K_pos hdvd_nat
  have hqL_eq : qL F K = (qL F L) ^ ℓ := by
    unfold qL
    rw [hresDeg, mul_comm, pow_mul]
  have hval_norm : ∀ y : K, valL F L (normLM F hLK y) = (ℓ : ℤ) * valL F K y := by
    intro y
    apply mul_left_cancel₀ hfL_int_ne
    calc (resDeg F L : ℤ) * valL F L (normLM F hLK y)
      _ = relVal F L (normLM F hLK y) := (hdiv_L (normLM F hLK y)).symm
      _ = relVal F K y := hrelVal_norm y
      _ = (resDeg F K : ℤ) * valL F K y := hdiv_K y
      _ = (resDeg F L : ℤ) * ((ℓ : ℤ) * valL F K y) := by
        rw [hresDeg]
        push_cast
        ring
  have hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, map_zero, hval0_K, hval0_L]
    · apply mul_left_cancel₀ hℓ_int_ne
      rw [← hval_norm (IntermediateField.inclusion hLK x), hnorm_inc x, hval_pow_L x ℓ hx]
  have hnorm_surj : ∀ u ∈ unitGroup F L 0,
      ∃ w ∈ unitGroup F K 0, Units.map (normLM F hLK) w = u := by
    intro u hu
    have hu_val : valL F L (u : L) = 0 := (hunit0_L u).mp hu
    have hu_range : u ∈ Set.range (Units.map (normLM F hLK)) := by
      rw [hnorm_range_iff u, hu_val]
      exact dvd_zero (ℓ : ℤ)
    obtain ⟨w, hw⟩ := hu_range
    have hw_val : valL F K (w : K) = 0 := by
      apply mul_left_cancel₀ hℓ_int_ne
      rw [mul_zero, ← hval_norm (w : K)]
      have hcoe : normLM F hLK (w : K) = (u : L) := congrArg Units.val hw
      rw [hcoe, hu_val]
    exact ⟨w, (hunit0_K w).mpr hw_val, hw⟩

  refine ⟨hFinDimL, hval_norm, hval_alg, hresDeg, hqL_eq, hnorm_surj, ?_⟩

  
  intro htr_bound hy₁ hnorm_lin1
  obtain ⟨y₁, hy₁_val, hy₁_tr⟩ := hy₁
  have hy₁_ne : y₁ ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hy₁_tr
    exact zero_ne_one hy₁_tr
  have hy₁_ge0 : (0 : ℤ) ≤ valL F K y₁ := hy₁_val.resolve_left hy₁_ne
  set ψK : AddChar K (Ω F) := traceChar F hLK ψ
  have hψK_apply : ∀ y : K, ψK y = ψ (traceLM F hLK y) := fun _ => rfl
  have hψK : IsAdmissibleChar F K ψK := by
    refine ⟨?_, ?_⟩
    · intro h1
      apply hψ.1
      ext x
      have hy : ψK (IntermediateField.inclusion hLK x * y₁) = 1 := by
        rw [h1]
        rfl
      rw [hψK_apply, htrace_inc_mul x y₁, hy₁_tr, mul_one] at hy
      exact hy
    · obtain ⟨d₀, hd₀⟩ := hψ.2
      refine ⟨d₀, fun y hy => ?_⟩
      rw [hψK_apply]
      rcases htr_bound d₀ y (Or.inr hy) with htr0 | htr_ge
      · rw [htr0]
        exact (hSpecL ψ hψ 1).1 0 (Or.inl rfl)
      · exact hd₀ _ htr_ge
  have hcondChar_eq : condExpChar F K ψK = condExpChar F L ψ := by
    set nL : ℤ := condExpChar F L ψ
    set nK : ℤ := condExpChar F K ψK
    have hL_triv := (hSpecL ψ hψ 1).1
    obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_nontriv⟩ := (hSpecL ψ hψ 1).2.1
    have hK_triv := (hSpecK ψK hψK 1).1
    obtain ⟨z₁, hz₁_ne, hz₁_val, hz₁_nontriv⟩ := (hSpecK ψK hψK 1).2.1
    have hnL_le_nK : nL ≤ nK := by
      by_contra hlt
      have hle : -nL ≤ -(nK + 1) := by omega
      have htr := htr_bound (-(nK + 1)) z₁ (Or.inr hz₁_val)
      have htr' : traceLM F hLK z₁ = 0 ∨ -nL ≤ valL F L (traceLM F hLK z₁) := by
        rcases htr with h0 | hge
        · exact Or.inl h0
        · exact Or.inr ( le_trans hle hge )
      exact hz₁_nontriv (hL_triv (traceLM F hLK z₁) htr')
    have hnK_le_nL : nK ≤ nL := by
      by_contra hlt
      have hle : -nK ≤ -(nL + 1) := by omega
      let y_x₁ : K := IntermediateField.inclusion hLK x₁ * y₁
      have hinc_ne : IntermediateField.inclusion hLK x₁ ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hx₁_ne
      have hy_val : -nK ≤ valL F K y_x₁ := by
        dsimp [y_x₁]
        rw [hval_mul_K _ _ hinc_ne hy₁_ne, hval_alg x₁]
        omega
      have hy_triv : ψK y_x₁ = 1 := hK_triv y_x₁ (Or.inr hy_val)
      rw [hψK_apply, htrace_inc_mul x₁ y₁, hy₁_tr, mul_one] at hy_triv
      exact hx₁_nontriv hy_triv
    omega

  
  set χ'K : Kˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLK))
  set aL : ℕ := condExp F L χ'
  set aK : ℕ := condExp F K χ'K
  have hunit_anti_L : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F L m₂ ≤ unitGroup F L m₁ := by
    intro m₁ m₂ hle u hu
    by_cases hm₁ : m₁ = 0
    · subst hm₁
      exact (hunit0_L u).mpr (hunit_val0_L m₂ u hu)
    · have hm₁_ge1 : 1 ≤ m₁ := by omega
      have hm₂_ge1 : 1 ≤ m₂ := by omega
      rw [hunit_ge1_L m₁ hm₁_ge1 u]
      rcases (hunit_ge1_L m₂ hm₂_ge1 u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  have hunit_anti_K : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F K m₂ ≤ unitGroup F K m₁ := by
    intro m₁ m₂ hle w hw
    by_cases hm₁ : m₁ = 0
    · subst hm₁
      exact (hunit0_K w).mpr (hunit_val0_K m₂ w hw)
    · have hm₁_ge1 : 1 ≤ m₁ := by omega
      have hm₂_ge1 : 1 ≤ m₂ := by omega
      rw [hunit_ge1_K m₁ hm₁_ge1 w]
      rcases (hunit_ge1_K m₂ hm₂_ge1 w).mp hw with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  have hnorm_unit : ∀ (m : ℕ) (w : Kˣ),
      w ∈ unitGroup F K m → Units.map (normLM F hLK) w ∈ unitGroup F L m := by
    intro m w hw
    by_cases hm : m = 0
    · subst hm
      have hw0 : valL F K (w : K) = 0 := (hunit0_K w).mp hw
      rw [hunit0_L]
      change valL F L (normLM F hLK (w : K)) = 0
      rw [hval_norm (w : K), hw0, mul_zero]
    · have hm1 : 1 ≤ m := by omega
      rw [hunit_ge1_L m hm1]
      let y : K := (w : K) - 1
      have hy : y = 0 ∨ (m : ℤ) ≤ valL F K y := by
        rcases (hunit_ge1_K m hm1 w).mp hw with h1 | hge
        · left
          dsimp [y]
          rw [h1, sub_self]
        · exact Or.inr hge
      have htr_y := htr_bound (m : ℤ) y hy
      have hlin_y := hnorm_lin1 m hm1 y hy
      let δ : L := normLM F hLK (1 + y) - (1 + traceLM F hLK y)
      have hδ : δ = 0 ∨ (m : ℤ) ≤ valL F L δ := by
        rcases hlin_y with h0 | hge
        · exact Or.inl h0
        · right
          have h2m : (m : ℤ) ≤ (2 * m : ℤ) := by omega
          exact le_trans h2m hge
      have hsum := hval_add_L (m : ℤ) δ (traceLM F hLK y) hδ htr_y
      have h1y : 1 + y = (w : K) := by
        dsimp [y]
        ring
      have hsum_eq : δ + traceLM F hLK y = normLM F hLK (w : K) - 1 := by
        dsimp [δ]
        rw [h1y]
        ring
      rw [hsum_eq] at hsum
      change (normLM F hLK (w : K) = 1) ∨ (m : ℤ) ≤ valL F L (normLM F hLK (w : K) - 1)
      rcases hsum with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
  have hχ'_triv : ∀ u ∈ unitGroup F L aL, χ' u = 1 := by
    intro u hu
    have h := hχ'_cond 0 hℓ_pos u
    rw [pow_zero ν₁, one_mul] at h
    exact h hu
  have haK_le_aL : aK ≤ aL := by
    have hmem : aL ∈ {a : ℕ | ∀ w ∈ unitGroup F K a, χ'K w = 1} := by
      intro w hw
      exact hχ'_triv (Units.map (normLM F hLK) w) (hnorm_unit aL w hw)
    exact Nat.sInf_le hmem
  have haL_le_aK : aL ≤ aK := by
    by_cases haL0 : aL = 0
    · omega
    · obtain ⟨_, u₀, hu₀_mem, hu₀_ne1⟩ := (hSpecL ψ hψ χ').2.2.1 haL0
      have hex_w₀ : ∃ w₀ ∈ unitGroup F K (aL - 1), χ'K w₀ ≠ 1 := by
        by_cases haL1 : aL = 1
        · have hu₀_0 : u₀ ∈ unitGroup F L 0 := by
            change u₀ ∈ unitGroup F L (aL - 1) at hu₀_mem
            simpa [haL1] using hu₀_mem
          obtain ⟨w₀, hw₀_0, hw₀_eq⟩ := hnorm_surj u₀ hu₀_0
          refine ⟨w₀, ?_, ?_⟩
          · simpa [haL1] using hw₀_0
          · change χ' (Units.map (normLM F hLK) w₀) ≠ 1
            rw [hw₀_eq]
            exact hu₀_ne1
        · have haL2 : 2 ≤ aL := by omega
          set d : ℕ := aL - 1
          have hd1 : 1 ≤ d := by omega
          have hu₀_ne_one : (u₀ : L) ≠ 1 := by
            intro h1
            have hu1 : u₀ = 1 := Units.ext h1
            rw [hu1, map_one] at hu₀_ne1
            exact hu₀_ne1 rfl
          set x₀ : L := (u₀ : L) - 1
          have hx₀_ne : x₀ ≠ 0 := sub_ne_zero.mpr hu₀_ne_one
          have hx₀_val : (d : ℤ) ≤ valL F L x₀ :=
            ((hunit_ge1_L d hd1 u₀).mp hu₀_mem).resolve_left hu₀_ne_one
          set z₀ : K := IntermediateField.inclusion hLK x₀ * y₁
          have hinc_x₀_ne : IntermediateField.inclusion hLK x₀ ≠ 0 :=
            (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hx₀_ne
          have hz₀_ne : z₀ ≠ 0 := mul_ne_zero hinc_x₀_ne hy₁_ne
          have hz₀_val : (d : ℤ) ≤ valL F K z₀ := by
            dsimp [z₀]
            rw [hval_mul_K _ _ hinc_x₀_ne hy₁_ne, hval_alg x₀]
            omega
          have hz₀_tr : traceLM F hLK z₀ = x₀ := by
            dsimp [z₀]
            rw [htrace_inc_mul x₀ y₁, hy₁_tr, mul_one]
          have h1z₀_ne : (1 : K) + z₀ ≠ 0 := by
            intro h0
            have hz_neg1 : z₀ = -1 := eq_neg_of_add_eq_zero_right h0
            have hval_z : valL F K z₀ = 0 := by rw [hz_neg1, hval_neg1_K]
            omega
          let w₀ : Kˣ := Units.mk0 (1 + z₀) h1z₀_ne
          have hw₀_mem : w₀ ∈ unitGroup F K d := by
            rw [hunit_ge1_K d hd1 w₀]
            right
            have hw₀_sub : (w₀ : K) - 1 = z₀ := by
              change (1 + z₀) - 1 = z₀
              ring
            rw [hw₀_sub]
            exact hz₀_val
          let v₀ : Lˣ := Units.map (normLM F hLK) w₀
          set δ₀ : L := (v₀ : L) - (u₀ : L)
          have hδ₀_eq : δ₀ = normLM F hLK (1 + z₀) - (1 + traceLM F hLK z₀) := by
            dsimp [δ₀, v₀, w₀, x₀]
            rw [hz₀_tr]
            ring
          have hδ₀_val : δ₀ = 0 ∨ (aL : ℤ) ≤ valL F L δ₀ := by
            rw [hδ₀_eq]
            rcases hnorm_lin1 d hd1 z₀ (Or.inr hz₀_val) with h0 | hge
            · exact Or.inl h0
            · right
              have h2d : (aL : ℤ) ≤ (2 * d : ℤ) := by omega
              exact le_trans h2d hge
          let h : Lˣ := v₀ * u₀⁻¹
          have hh_mem : h ∈ unitGroup F L aL := by
            rw [hunit_ge1_L aL (by omega) h]
            have hh_sub : (h : L) - 1 = δ₀ * ((u₀⁻¹ : Lˣ) : L) := by
              dsimp [h, δ₀]
              rw [sub_mul, Units.mul_inv]
            by_cases hδ₀_0 : δ₀ = 0
            · left
              have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hδ₀_0, zero_mul]
              exact sub_eq_zero.mp hsub0
            · right
              rw [hh_sub, hval_mul_L δ₀ ((u₀⁻¹ : Lˣ) : L) hδ₀_0 (Units.ne_zero u₀⁻¹),
                hval_inv_L u₀, hunit_val0_L d u₀ hu₀_mem, neg_zero, add_zero]
              exact hδ₀_val.resolve_left hδ₀_0
          have hv₀_eq : v₀ = h * u₀ := by
            dsimp [h]
            rw [inv_mul_cancel_right]
          refine ⟨w₀, hw₀_mem, ?_⟩
          change χ' v₀ ≠ 1
          rw [hv₀_eq, map_mul, hχ'_triv h hh_mem, one_mul]
          exact hu₀_ne1
      obtain ⟨w₀, hw₀_mem, hw₀_ne1⟩ := hex_w₀
      by_contra hlt
      have hle : aK ≤ aL - 1 := by omega
      have hw₀_aK : w₀ ∈ unitGroup F K aK := hunit_anti_K hle hw₀_mem
      exact hw₀_ne1 (hχ'K_cond w₀ hw₀_aK)
  have hcond_K : aK = aL := le_antisymm haK_le_aL haL_le_aK

  refine ⟨hψK, hcondChar_eq, hcond_K, ?_⟩

  
  intro hHD_loc
  have hν₁j_unit0 : ∀ (j : ℕ), ∀ u ∈ unitGroup F L 0, (ν₁ ^ j) u = 1 := by
    intro j u hu
    rw [MonoidHom.pow_apply, hν₁_unit0 u hu, one_pow]
  have hcond_ν₁j : ∀ j : ℕ, condExp F L (ν₁ ^ j) = 0 := by
    intro j
    apply Nat.eq_zero_of_le_zero
    exact Nat.sInf_le (hν₁j_unit0 j)
  have hcond_1L : condExp F L 1 = 0 := by
    simpa using hcond_ν₁j 0
  have hcond_1K : condExp F K 1 = 0 := by
    apply Nat.eq_zero_of_le_zero
    have hmem : (0 : ℕ) ∈ {a : ℕ | ∀ w ∈ unitGroup F K a, (1 : Kˣ →* (Ω F)ˣ) w = 1} :=
      fun _ _ => rfl
    exact Nat.sInf_le hmem
  have hcond_twist : ∀ j < ℓ, condExp F L (ν₁ ^ j * χ') = aL := by
    intro j hj
    apply le_antisymm
    · have hmem : aL ∈ {a : ℕ | ∀ u ∈ unitGroup F L a, (ν₁ ^ j * χ') u = 1} := by
        intro u hu
        have hu0 : u ∈ unitGroup F L 0 := hunit_anti_L (Nat.zero_le aL) hu
        rw [MonoidHom.mul_apply, hν₁j_unit0 j u hu0, hχ'_triv u hu, mul_one]
      exact Nat.sInf_le hmem
    · exact hMinCond j hj
  set n : ℤ := condExpChar F L ψ
  set c₀ : Lˣ := tateElt F L 1 ψ
  set c_a : Lˣ := tateElt F L χ' ψ
  have hc₀_val : valL F L (c₀ : L) = n := by
    have h := (hSpecL ψ hψ 1).2.2.2
    rw [hcond_1L, Nat.cast_zero, zero_add] at h
    exact h
  have hc_a_val : valL F L (c_a : L) = (aL : ℤ) + n := (hSpecL ψ hψ χ').2.2.2
  have htateElt_ν₁j : ∀ j : ℕ, tateElt F L (ν₁ ^ j) ψ = c₀ := by
    intro j
    dsimp [c₀]
    unfold tateElt
    rw [hcond_ν₁j j, hcond_1L]
  have htateElt_twist : ∀ j < ℓ, tateElt F L (ν₁ ^ j * χ') ψ = c_a := by
    intro j hj
    dsimp [c_a]
    unfold tateElt
    rw [hcond_twist j hj]
  have htateEps_eq_of_cond : ∀ (θ : Lˣ →* (Ω F)ˣ) (a : ℕ) (c : Lˣ),
      condExp F L θ = a → tateElt F L θ ψ = c →
      tateEps F L θ ψ =
        (qL F L : Ω F) ^ n *
          if a = 0 then (θ c : Ω F)
          else
            ∑ᶠ (u : Lˣ ⧸ unitGroup F L a) (_ : valL F L ((cosetRep u : Lˣ) : L) = 0),
              ((θ (c⁻¹ * (cosetRep u : Lˣ)) : Ω F)⁻¹ *
                ψ (((c⁻¹ * (cosetRep u : Lˣ) : Lˣ) : L))) := by
    intro θ a c ha hc
    subst ha
    subst hc
    rfl
  have htateEps_ν₁j : ∀ j : ℕ, tateEps F L (ν₁ ^ j) ψ = (qL F L : Ω F) ^ n * ((ν₁ ^ j) c₀ : Ω F) := by
    intro j
    rw [htateEps_eq_of_cond (ν₁ ^ j) 0 c₀ (hcond_ν₁j j) (htateElt_ν₁j j), if_pos rfl]
  have htateEps_1K : tateEps F K 1 ψK = ((qL F L : Ω F) ^ n) ^ ℓ := by
    unfold tateEps
    rw [hcondChar_eq, hcond_1K, if_pos rfl, MonoidHom.one_apply, Units.val_one, mul_one,
      hqL_eq, Nat.cast_pow, ← zpow_natCast, ← zpow_mul, mul_comm (ℓ : ℤ) n, zpow_mul, zpow_natCast]
  have htateEps_twist : ∀ j < ℓ,
      tateEps F L (ν₁ ^ j * χ') ψ = ((ν₁ ^ j) c_a : Ω F) * tateEps F L χ' ψ := by
    intro j hj
    rw [htateEps_eq_of_cond (ν₁ ^ j * χ') aL c_a (hcond_twist j hj) (htateElt_twist j hj),
      htateEps_eq_of_cond χ' aL c_a rfl rfl]
    by_cases ha0 : aL = 0
    · rw [if_pos ha0, if_pos ha0, MonoidHom.mul_apply, Units.val_mul]
      ring
    · rw [if_neg ha0, if_neg ha0]
      have ha1 : 1 ≤ aL := by omega
      have hFin_a := hFinL aL ha1
      change (qL F L : Ω F) ^ n *
          (∑ᶠ u ∈ {u : Lˣ ⧸ unitGroup F L aL | valL F L ((cosetRep u : Lˣ) : L) = 0}, _) =
        ((ν₁ ^ j) c_a : Ω F) * ((qL F L : Ω F) ^ n *
          (∑ᶠ u ∈ {u : Lˣ ⧸ unitGroup F L aL | valL F L ((cosetRep u : Lˣ) : L) = 0}, _))
      rw [finsum_mem_eq_finite_toFinset_sum _ hFin_a, finsum_mem_eq_finite_toFinset_sum _ hFin_a]
      have hsum_eq :
          (∑ u ∈ hFin_a.toFinset,
            (((ν₁ ^ j * χ') (c_a⁻¹ * (cosetRep u : Lˣ)) : Ω F)⁻¹ *
              ψ (((c_a⁻¹ * (cosetRep u : Lˣ) : Lˣ) : L)))) =
          ((ν₁ ^ j) c_a : Ω F) *
            (∑ u ∈ hFin_a.toFinset,
              ((χ' (c_a⁻¹ * (cosetRep u : Lˣ)) : Ω F)⁻¹ *
                ψ (((c_a⁻¹ * (cosetRep u : Lˣ) : Lˣ) : L)))) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro u hu
        have hu_val : valL F L ((cosetRep u : Lˣ) : L) = 0 := (Set.Finite.mem_toFinset hFin_a).mp hu
        have hu_mem0 : (cosetRep u : Lˣ) ∈ unitGroup F L 0 := (hunit0_L (cosetRep u)).mpr hu_val
        have hν_u : (ν₁ ^ j) (cosetRep u : Lˣ) = 1 := hν₁j_unit0 j (cosetRep u) hu_mem0
        have hν_term : (ν₁ ^ j * χ') (c_a⁻¹ * (cosetRep u : Lˣ)) =
            ((ν₁ ^ j) c_a)⁻¹ * χ' (c_a⁻¹ * (cosetRep u : Lˣ)) := by
          rw [MonoidHom.mul_apply, map_mul (ν₁ ^ j), map_inv (ν₁ ^ j), hν_u, mul_one]
        rw [hν_term, Units.val_mul, mul_inv, Units.val_inv_eq_inv_val, inv_inv, mul_assoc]
      rw [hsum_eq]
      ring

  
  set ζ₀ : Ω F := (ζ : Ω F)
  have hζ₀_pow : ζ₀ ^ ℓ = 1 := by
    dsimp [ζ₀]
    rw [← Units.val_pow_eq_pow_val, hζ_pow, Units.val_one]
  have hζ₀_ne : ζ₀ ≠ 1 := by
    intro h1
    apply hζ_ne
    exact Units.ext h1
  have hζ₀_prod : (∏ j ∈ Finset.range ℓ, (ζ₀ ^ aL) ^ j) = (-1 : Ω F) ^ (aL * (ℓ - 1)) := by
    rw [Finset.prod_pow_eq_pow_sum, Finset.sum_range_id]
    by_cases h2 : ℓ = 2
    · have hζ₀_sq : ζ₀ ^ 2 = 1 := h2 ▸ hζ₀_pow
      have hζ₀_neg1 : ζ₀ = -1 := (sq_eq_one_iff.mp hζ₀_sq).resolve_left hζ₀_ne
      rw [h2, hζ₀_neg1]
      norm_num
    · have hodd : ℓ % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime).resolve_left h2
      let k : ℕ := (ℓ - 1) / 2
      have hk : ℓ - 1 = 2 * k := by omega
      have hdiv2 : ℓ * (ℓ - 1) / 2 = ℓ * k := by
        rw [hk]
        have hmul : ℓ * (2 * k) = 2 * (ℓ * k) := by ring
        rw [hmul, Nat.mul_div_right _ (by omega)]
      have hlhs : (ζ₀ ^ aL) ^ (ℓ * (ℓ - 1) / 2) = 1 := by
        rw [hdiv2]
        have hpow : (ζ₀ ^ aL) ^ (ℓ * k) = ((ζ₀ ^ ℓ) ^ aL) ^ k := by ring
        rw [hpow, hζ₀_pow, one_pow, one_pow]
      have hrhs : (-1 : Ω F) ^ (aL * (ℓ - 1)) = 1 := by
        have hexp : aL * (ℓ - 1) = 2 * (aL * k) := by rw [hk]; ring
        rw [hexp, pow_mul]
        norm_num
      rw [hlhs, hrhs]
  have hca_c0_ν₁ : ∀ j : ℕ,
      ((ν₁ ^ j) c_a : Ω F) = ((ν₁ ^ j) c₀ : Ω F) * (ζ₀ ^ aL) ^ j := by
    intro j
    let d_c : Lˣ := c_a * c₀⁻¹
    have hdc_val : valL F L (d_c : L) = (aL : ℤ) := by
      dsimp [d_c]
      rw [hval_mul_L (c_a : L) _ (Units.ne_zero c_a) (Units.ne_zero _),
        hval_inv_L c₀, hc_a_val, hc₀_val]
      omega
    have hν₁_dc : ν₁ d_c = ζ ^ aL := by
      rw [hν₁_eq_zpow d_c, hdc_val, zpow_natCast]
    have hca_eq : c_a = c₀ * d_c := by
      dsimp [d_c]
      rw [mul_inv_cancel_comm_assoc]
    conv_lhs => rw [hca_eq]
    rw [map_mul (ν₁ ^ j), Units.val_mul, MonoidHom.pow_apply ν₁ j d_c, hν₁_dc,
      Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
  have hprod_ν₁ :
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
        tateEps F K 1 ψK * (∏ j ∈ Finset.range ℓ, ((ν₁ ^ j) c₀ : Ω F)) := by
    have hcongr : (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
        ∏ j ∈ Finset.range ℓ, ((qL F L : Ω F) ^ n * ((ν₁ ^ j) c₀ : Ω F)) := by
      apply Finset.prod_congr rfl
      intro j _
      exact htateEps_ν₁j j
    rw [hcongr, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range, ← htateEps_1K]
  have hprod_twist :
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j * χ') ψ) =
        (∏ j ∈ Finset.range ℓ, ((ν₁ ^ j) c₀ : Ω F)) *
          (-1 : Ω F) ^ (aL * (ℓ - 1)) * (tateEps F L χ' ψ) ^ ℓ := by
    have hcongr : (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j * χ') ψ) =
        ∏ j ∈ Finset.range ℓ, (((ν₁ ^ j) c₀ : Ω F) * (ζ₀ ^ aL) ^ j * tateEps F L χ' ψ) := by
      apply Finset.prod_congr rfl
      intro j hj
      rw [htateEps_twist j (Finset.mem_range.mp hj), hca_c0_ν₁ j]
    rw [hcongr, Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_const, Finset.card_range, hζ₀_prod]
  have hHD_all :
      tateEps F K χ'K ψK = (-1 : Ω F) ^ (aL * (ℓ - 1)) * (tateEps F L χ' ψ) ^ ℓ := by
    by_cases ha1 : 1 ≤ aL
    · exact hHD_loc ha1
    · have ha0 : aL = 0 := by omega
      have haK0 : aK = 0 := by rw [hcond_K, ha0]
      set cK : Kˣ := tateElt F K χ'K ψK
      have hcK_val : valL F K (cK : K) = n := by
        have h := (hSpecK ψK hψK χ'K).2.2.2
        rw [show condExp F K χ'K = 0 from haK0, Nat.cast_zero, zero_add, hcondChar_eq] at h
        exact h
      let u_norm : Lˣ := (Units.map (normLM F hLK) cK) * (c_a ^ ℓ)⁻¹
      have hu_norm_val : valL F L (u_norm : L) = 0 := by
        change valL F L ((((Units.map (normLM F hLK) cK) * (c_a ^ ℓ)⁻¹ : Lˣ) : L)) = 0
        rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
          hval_inv_L (c_a ^ ℓ), Units.val_pow_eq_pow_val,
          hval_pow_L (c_a : L) ℓ (Units.ne_zero c_a), hc_a_val, ha0, Nat.cast_zero, zero_add]
        change valL F L (normLM F hLK (cK : K)) + -((ℓ : ℤ) * n) = 0
        rw [hval_norm (cK : K), hcK_val]
        ring
      have hu_norm_mem : u_norm ∈ unitGroup F L aL := by
        rw [ha0]
        exact (hunit0_L u_norm).mpr hu_norm_val
      have hχ'_u_norm : χ' u_norm = 1 := hχ'_triv u_norm hu_norm_mem
      have hnorm_cK_eq : Units.map (normLM F hLK) cK = u_norm * (c_a ^ ℓ) := by
        dsimp [u_norm]
        rw [inv_mul_cancel_right]
      have hχ'K_cK : (χ'K cK : Ω F) = (χ' c_a : Ω F) ^ ℓ := by
        change (χ' (Units.map (normLM F hLK) cK) : Ω F) = (χ' c_a : Ω F) ^ ℓ
        rw [hnorm_cK_eq, map_mul, hχ'_u_norm, one_mul, map_pow, Units.val_pow_eq_pow_val]
      have hlhs : tateEps F K χ'K ψK = ((qL F L : Ω F) ^ n) ^ ℓ * (χ' c_a : Ω F) ^ ℓ := by
        unfold tateEps
        rw [hcondChar_eq, show condExp F K χ'K = 0 from haK0, if_pos rfl]
        change (qL F K : Ω F) ^ n * (χ'K cK : Ω F) = _
        rw [hqL_eq, Nat.cast_pow, ← zpow_natCast, ← zpow_mul, mul_comm (ℓ : ℤ) n,
          zpow_mul, zpow_natCast, hχ'K_cK]
      have hrhs : tateEps F L χ' ψ = (qL F L : Ω F) ^ n * (χ' c_a : Ω F) := by
        rw [htateEps_eq_of_cond χ' aL c_a rfl rfl, if_pos ha0]
      rw [hlhs, hrhs, ha0, zero_mul, pow_zero, one_mul, mul_pow]
  rw [hHD_all, hprod_ν₁, hprod_twist]
  ring

theorem ld_valL_residue_field_exists (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hval0 : valL F M 0 = 0)
    (hval1 : valL F M 1 = 0)
    (hval_neg1 : valL F M (-1) = 0)
    (hval_neg : ∀ x : M, valL F M (-x) = valL F M x)
    (hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y)
    (hval_inv : ∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M))
    (hval_add : ∀ (k : ℤ) (x y : M),
      (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
        (x + y = 0 ∨ k ≤ valL F M (x + y)))
    (S₁ : Finset M)
    (hS₁ : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ s ∈ S₁, x - s = 0 ∨ (1 : ℤ) ≤ valL F M (x - s)) :
    ∃ (k_M : Type u) (_ : Field k_M) (_ : Fintype k_M) (resM : M → k_M),
      resM 0 = 0 ∧ resM 1 = 1 ∧
      (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
        resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
        resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
        resM (-x₁) = -resM x₁) ∧
      (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) ∧
      (∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a) :=
by
  have hMain : ∀ (E : Type u) [Field E] (v : E → ℤ),
      v 1 = 0 →
      (∀ x : E, v (-x) = v x) →
      (∀ x y : E, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
      (∀ u : Eˣ, v ((u⁻¹ : Eˣ) : E) = - v (u : E)) →
      (∀ (k : ℤ) (x y : E), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) →
        (x + y = 0 ∨ k ≤ v (x + y))) →
      ∀ (S : Finset E),
      (∀ x : E, (x = 0 ∨ 0 ≤ v x) → ∃ s ∈ S, x - s = 0 ∨ (1 : ℤ) ≤ v (x - s)) →
      ∃ (k_E : Type u) (_ : Field k_E) (_ : Fintype k_E) (resE : E → k_E),
        resE 0 = 0 ∧ resE 1 = 1 ∧
        (∀ x₁ x₂ : E, (x₁ = 0 ∨ 0 ≤ v x₁) → (x₂ = 0 ∨ 0 ≤ v x₂) →
          resE (x₁ + x₂) = resE x₁ + resE x₂ ∧
          resE (x₁ * x₂) = resE x₁ * resE x₂ ∧
          resE (-x₁) = -resE x₁) ∧
        (∀ x : E, (x = 0 ∨ 0 ≤ v x) → (resE x = 0 ↔ (x = 0 ∨ 1 ≤ v x))) ∧
        (∀ a : k_E, ∃ x : E, (x = 0 ∨ 0 ≤ v x) ∧ resE x = a) := by
    clear * -
    intro E _ v hv1 hv_neg hv_mul hv_inv hv_add S hS
    let 𝒪_E : Subring E :=
      { carrier := {x : E | x = 0 ∨ 0 ≤ v x}
        zero_mem' := Or.inl rfl
        one_mem' := Or.inr (by rw [hv1])
        add_mem' := fun {x y} hx hy => hv_add 0 x y hx hy
        neg_mem' := fun {x} hx =>
          hx.elim (fun h0 => Or.inl (by rw [h0, neg_zero]))
            (fun hge => Or.inr (by rw [hv_neg]; exact hge))
        mul_mem' := fun {x y} hx hy => by
          by_cases hx0 : x = 0
          · exact Or.inl (by rw [hx0, zero_mul])
          · by_cases hy0 : y = 0
            · exact Or.inl (by rw [hy0, mul_zero])
            · exact Or.inr (by
                rw [hv_mul x y hx0 hy0]
                have h1 := hx.resolve_left hx0
                have h2 := hy.resolve_left hy0
                omega) }
    let 𝔭_E : Ideal 𝒪_E :=
      { carrier := {x : 𝒪_E | (x : E) = 0 ∨ (1 : ℤ) ≤ v (x : E)}
        zero_mem' := Or.inl rfl
        add_mem' := fun {x y} hx hy => hv_add 1 x.1 y.1 hx hy
        smul_mem' := fun c {x} hx => by
          by_cases hc0 : (c : E) = 0
          · exact Or.inl (by change (c : E) * (x : E) = 0; rw [hc0, zero_mul])
          · by_cases hx0 : (x : E) = 0
            · exact Or.inl (by change (c : E) * (x : E) = 0; rw [hx0, mul_zero])
            · exact Or.inr (by
                change (1 : ℤ) ≤ v ((c : E) * (x : E))
                rw [hv_mul c.1 x.1 hc0 hx0]
                have h1 := c.2.resolve_left hc0
                have h2 := hx.resolve_left hx0
                omega) }
    have hIsField : IsField (𝒪_E ⧸ 𝔭_E) := by
      refine ⟨⟨0, 1, ?_⟩, fun a b => mul_comm a b, ?_⟩
      · intro h01
        have h1 : (1 : 𝒪_E) ∈ 𝔭_E := Ideal.Quotient.eq_zero_iff_mem.mp h01.symm
        rcases h1 with h10 | h1ge
        · exact one_ne_zero h10
        · change (1 : ℤ) ≤ v 1 at h1ge
          rw [hv1] at h1ge
          omega
      · intro a ha
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
        have hxI : x ∉ 𝔭_E := fun h => ha (Ideal.Quotient.eq_zero_iff_mem.mpr h)
        have hx0 : (x : E) ≠ 0 := fun h => hxI (Or.inl h)
        have hxlt : ¬ ((1 : ℤ) ≤ v (x : E)) := fun h => hxI (Or.inr h)
        have hxge : 0 ≤ v (x : E) := x.2.resolve_left hx0
        have hvx : v (x : E) = 0 := by omega
        let u : Eˣ := Units.mk0 (x : E) hx0
        have hvu : v ((u⁻¹ : Eˣ) : E) = 0 := by
          rw [hv_inv u]
          change - v (x : E) = 0
          omega
        let y : 𝒪_E := ⟨((u⁻¹ : Eˣ) : E), Or.inr (by omega)⟩
        refine ⟨Ideal.Quotient.mk 𝔭_E y, ?_⟩
        rw [← map_mul]
        have hxy : x * y = 1 := Subtype.ext (Units.mul_inv u)
        rw [hxy, map_one]
    haveI hMax : 𝔭_E.IsMaximal := Ideal.Quotient.maximal_of_isField 𝔭_E hIsField
    let k_E : Type u := 𝒪_E ⧸ 𝔭_E
    letI hField_kE : Field k_E := Ideal.Quotient.field 𝔭_E
    let resE : E → k_E := fun x =>
      if hx : x = 0 ∨ 0 ≤ v x then Ideal.Quotient.mk 𝔭_E ⟨x, hx⟩ else 0
    have hresE_eq : ∀ (x : E) (hx : x = 0 ∨ 0 ≤ v x),
        resE x = Ideal.Quotient.mk 𝔭_E ⟨x, hx⟩ :=
      fun x hx => dif_pos hx
    have hresE_0 : resE 0 = 0 := by
      rw [hresE_eq 0 (Or.inl rfl)]
      exact map_zero (Ideal.Quotient.mk 𝔭_E)
    have hresE_1 : resE 1 = 1 := by
      rw [hresE_eq 1 (Or.inr (by rw [hv1]))]
      exact map_one (Ideal.Quotient.mk 𝔭_E)
    have hresE_ring : ∀ x₁ x₂ : E,
        (x₁ = 0 ∨ 0 ≤ v x₁) → (x₂ = 0 ∨ 0 ≤ v x₂) →
          resE (x₁ + x₂) = resE x₁ + resE x₂ ∧
          resE (x₁ * x₂) = resE x₁ * resE x₂ ∧
          resE (-x₁) = -resE x₁ := by
      intro x₁ x₂ hx₁ hx₂
      have hadd : x₁ + x₂ = 0 ∨ 0 ≤ v (x₁ + x₂) := 𝒪_E.add_mem hx₁ hx₂
      have hmul : x₁ * x₂ = 0 ∨ 0 ≤ v (x₁ * x₂) := 𝒪_E.mul_mem hx₁ hx₂
      have hneg : -x₁ = 0 ∨ 0 ≤ v (-x₁) := 𝒪_E.neg_mem hx₁
      refine ⟨?_, ?_, ?_⟩
      · rw [hresE_eq (x₁ + x₂) hadd, hresE_eq x₁ hx₁, hresE_eq x₂ hx₂]
        exact map_add (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
      · rw [hresE_eq (x₁ * x₂) hmul, hresE_eq x₁ hx₁, hresE_eq x₂ hx₂]
        exact map_mul (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
      · rw [hresE_eq (-x₁) hneg, hresE_eq x₁ hx₁]
        exact map_neg (Ideal.Quotient.mk 𝔭_E) ⟨x₁, hx₁⟩
    have hresE_ker : ∀ x : E,
        (x = 0 ∨ 0 ≤ v x) → (resE x = 0 ↔ (x = 0 ∨ 1 ≤ v x)) := by
      intro x hx
      rw [hresE_eq x hx, Ideal.Quotient.eq_zero_iff_mem]
      rfl
    have hresE_surj : ∀ a : k_E, ∃ x : E, (x = 0 ∨ 0 ≤ v x) ∧ resE x = a := by
      intro a
      obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.Quotient.mk_surjective a
      exact ⟨x, hx, hresE_eq x hx⟩
    let f : k_E → S := fun a =>
      let x_a := (hresE_surj a).choose
      let hx_a := (hresE_surj a).choose_spec.1
      let hs := hS x_a hx_a
      ⟨hs.choose, hs.choose_spec.1⟩
    have hf_left : ∀ a : k_E, resE (f a : E) = a := by
      intro a
      set x_a := (hresE_surj a).choose
      have hx_a : x_a = 0 ∨ 0 ≤ v x_a := (hresE_surj a).choose_spec.1
      have hres_a : resE x_a = a := (hresE_surj a).choose_spec.2
      have hd₁ : x_a - (f a : E) = 0 ∨ (1 : ℤ) ≤ v (x_a - (f a : E)) :=
        (hS x_a hx_a).choose_spec.2
      have hd₀ : x_a - (f a : E) = 0 ∨ 0 ≤ v (x_a - (f a : E)) :=
        hd₁.elim Or.inl (fun h => Or.inr (by omega))
      have hs₀ : (f a : E) = 0 ∨ 0 ≤ v (f a : E) := by
        have h_eq : (f a : E) = x_a + -(x_a - (f a : E)) := by ring
        rw [h_eq]
        exact 𝒪_E.add_mem hx_a (𝒪_E.neg_mem hd₀)
      have hres_d : resE (x_a - (f a : E)) = 0 :=
        (hresE_ker (x_a - (f a : E)) hd₀).mpr hd₁
      have h_sum : x_a = (x_a - (f a : E)) + (f a : E) := by ring
      have h_add := (hresE_ring (x_a - (f a : E)) (f a : E) hd₀ hs₀).1
      rw [← h_sum, hres_a, hres_d, zero_add] at h_add
      exact h_add.symm
    have hf_inj : Function.Injective f := by
      intro a₁ a₂ h
      have hval : (f a₁ : E) = (f a₂ : E) := congrArg Subtype.val h
      rw [← hf_left a₁, ← hf_left a₂, hval]
    haveI hFin_kE' : Finite k_E := Finite.of_injective f hf_inj
    letI hFin_kE : Fintype k_E := Fintype.ofFinite k_E
    exact ⟨k_E, hField_kE, hFin_kE, resE, hresE_0, hresE_1, hresE_ring, hresE_ker, hresE_surj⟩
  exact hMain ↥M (valL F M) hval1 hval_neg hval_mul hval_inv hval_add S₁ hS₁

theorem ld_unramified_galois_aut_trace_norm_and_lin (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y)))) :
    FiniteDimensional L (IntermediateField.extendScalars hLK) ∧
    (∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) ∧
    (∀ (d : ℕ), 1 ≤ d → ∀ y : K, (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
      (normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)))) ∧
    ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → K → K),
      Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK) ∧
      (∀ y : K, act 1 y = y) ∧
      (∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y)) ∧
      (∀ σ : G,
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ y₁ y₂ : K,
          act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
          act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
          act σ (-y₁) = -act σ y₁)) ∧
      (∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
        IntermediateField.inclusion hLK x) ∧
      (∀ σ : G, (∀ y : K, act σ y = y) → σ = 1) ∧
      (∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y) ∧
      (∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y) ∧
      (∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y) :=
by
  obtain ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add⟩ :=
    hvalL_props
  obtain ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add⟩ :=
    hvalK_props
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  have hFinLK' : FiniteDimensional L K' := by
    haveI : FiniteDimensional F K' := ‹FiniteDimensional F K›
    haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F L K'
  haveI : FiniteDimensional L K' := hFinLK'
  have hGalLK' : IsGalois L ↥K' := by
    have hSepLK' : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    haveI : Algebra.IsSeparable L K' := hSepLK'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
    exact helper_isGalois L (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois L ↥K' := hGalLK'
  let G : Type u := (K' ≃ₐ[L] K')
  have hcard_G : Fintype.card G = Module.finrank L K' :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank L K')
  let fromExtendScalars : K' →+* K :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLK).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → K → K := fun σ y => fromExtendScalars (σ (toExtendScalars F hLK y))
  have hact_one : ∀ y : K, act 1 y = y := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun y₁ y₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x := by
    intro σ x
    change fromExtendScalars (σ (algebraMap L K' x)) = IntermediateField.inclusion hLK x
    rw [σ.commutes x]
    rfl
  have hact_faithful : ∀ σ : G, (∀ y : K, act σ y = y) → σ = 1 := by
    intro σ h
    apply AlgEquiv.ext
    intro z
    exact congrArg (toExtendScalars F hLK) (h (fromExtendScalars z))
  have hact_trace : ∀ y : K,
      IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := L) (L := K') (toExtendScalars F hLK y))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hLK y)) Finset.univ)
  have hact_norm : ∀ y : K,
      IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLK y))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hLK y)) Finset.univ)
  have hinj : Function.Injective (IntermediateField.inclusion hLK) :=
    (IntermediateField.inclusion hLK).injective
  have hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y := by
    intro σ y
    have hnorm_eq : normLM F hLK (act σ y) = normLM F hLK y := by
      apply hinj
      rw [hact_norm (act σ y), hact_norm y]
      have hmul : (∏ τ : G, act τ (act σ y)) = ∏ τ : G, act (τ * σ) y := by
        refine Finset.prod_congr rfl fun τ _ => ?_
        rw [hact_mul]
      rw [hmul]
      exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => act τ y)
    have hval_eq := congrArg (valL F L) hnorm_eq
    rw [hval_norm (act σ y), hval_norm y] at hval_eq
    have h_ne_zero : (Module.finrank L K' : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hPrime.ne_zero
    exact mul_left_cancel₀ h_ne_zero hval_eq
  have htr_bound : ∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)) := by
    intro m y hy
    have hy_act : ∀ σ : G, act σ y = 0 ∨ m ≤ valL F K (act σ y) := by
      intro σ
      rcases hy with rfl | hge
      · exact Or.inl (by rw [(hact_ring σ).1])
      · exact Or.inr (by rw [hact_val σ y]; exact hge)
    have h_sum_bound : ∀ S : Finset G,
        (∑ σ ∈ S, act σ y) = 0 ∨ m ≤ valL F K (∑ σ ∈ S, act σ y) := by
      intro S
      induction' S using Finset.induction_on with τ S' hτ ih
      · exact Or.inl Finset.sum_empty
      · rw [Finset.sum_insert hτ]
        exact hvalK_add m (act τ y) (∑ σ ∈ S', act σ y) (hy_act τ) ih
    have h_univ := h_sum_bound Finset.univ
    rw [← hact_trace y] at h_univ
    rcases h_univ with h0 | hge
    · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLK) hinj).mp h0)
    · rw [hval_alg (traceLM F hLK y)] at hge
      exact Or.inr hge
  have hring_id : ∀ (z S_sum P : K),
      (1 + z) * P - (1 + (z + S_sum)) =
        (P - (1 + S_sum)) + z * S_sum + z * (P - (1 + S_sum)) :=
    fun _ _ _ => by ring
  have hnorm_lin1 : ∀ (d : ℕ), 1 ≤ d → ∀ y : K, (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
      (normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y))) := by
    intro d hd y hy
    have hy_act : ∀ σ : G, act σ y = 0 ∨ (d : ℤ) ≤ valL F K (act σ y) := by
      intro σ
      rcases hy with rfl | hge
      · exact Or.inl (by rw [(hact_ring σ).1])
      · exact Or.inr (by rw [hact_val σ y]; exact hge)
    have h_ind : ∀ S : Finset G,
        ((∑ σ ∈ S, act σ y) = 0 ∨ (d : ℤ) ≤ valL F K (∑ σ ∈ S, act σ y)) ∧
        ((∏ σ ∈ S, (1 + act σ y)) - (1 + ∑ σ ∈ S, act σ y) = 0 ∨
          (2 * d : ℤ) ≤ valL F K ((∏ σ ∈ S, (1 + act σ y)) - (1 + ∑ σ ∈ S, act σ y))) := by
      intro S
      induction' S using Finset.induction_on with τ S' hτ ih
      · exact ⟨Or.inl Finset.sum_empty,
          Or.inl (by rw [Finset.prod_empty, Finset.sum_empty, add_zero, sub_self])⟩
      · rw [Finset.sum_insert hτ, Finset.prod_insert hτ]
        let z := act τ y
        let S_sum := ∑ σ ∈ S', act σ y
        let P := ∏ σ ∈ S', (1 + act σ y)
        let R := P - (1 + S_sum)
        have ih1 : S_sum = 0 ∨ (d : ℤ) ≤ valL F K S_sum := ih.1
        have ih2 : R = 0 ∨ (2 * d : ℤ) ≤ valL F K R := ih.2
        have hz : z = 0 ∨ (d : ℤ) ≤ valL F K z := hy_act τ
        have hsum : z + S_sum = 0 ∨ (d : ℤ) ≤ valL F K (z + S_sum) :=
          hvalK_add (d : ℤ) z S_sum hz ih1
        refine ⟨hsum, ?_⟩
        rw [hring_id z S_sum P]
        change (R + z * S_sum + z * R = 0) ∨ (2 * d : ℤ) ≤ valL F K (R + z * S_sum + z * R)
        have hzS : z * S_sum = 0 ∨ (2 * d : ℤ) ≤ valL F K (z * S_sum) := by
          by_cases hz0 : z = 0
          · exact Or.inl (by rw [hz0, zero_mul])
          · by_cases hS0 : S_sum = 0
            · exact Or.inl (by rw [hS0, mul_zero])
            · right
              rw [hvalK_mul z S_sum hz0 hS0]
              have h1 := hz.resolve_left hz0
              have h2 := ih1.resolve_left hS0
              omega
        have hzR : z * R = 0 ∨ (2 * d : ℤ) ≤ valL F K (z * R) := by
          by_cases hz0 : z = 0
          · exact Or.inl (by rw [hz0, zero_mul])
          · by_cases hR0 : R = 0
            · exact Or.inl (by rw [hR0, mul_zero])
            · right
              rw [hvalK_mul z R hz0 hR0]
              have h1 := hz.resolve_left hz0
              have h2 := ih2.resolve_left hR0
              omega
        exact hvalK_add (2 * d : ℤ) (R + z * S_sum) (z * R)
          (hvalK_add (2 * d : ℤ) R (z * S_sum) ih2 hzS) hzR
    have h_univ := (h_ind Finset.univ).2
    have hprod_eq : (∏ σ : G, (1 + act σ y)) =
        IntermediateField.inclusion hLK (normLM F hLK (1 + y)) := by
      rw [hact_norm (1 + y)]
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [((hact_ring σ).2.2 1 y).1, (hact_ring σ).2.1]
    have h_diff_eq : (∏ σ : G, (1 + act σ y)) - (1 + ∑ σ : G, act σ y) =
        IntermediateField.inclusion hLK (normLM F hLK (1 + y) - (1 + traceLM F hLK y)) := by
      rw [hprod_eq, ← hact_trace y]
      simp only [map_sub, map_add, map_one]
    rw [h_diff_eq] at h_univ
    rcases h_univ with h0 | hge
    · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLK) hinj).mp h0)
    · rw [hval_alg (normLM F hLK (1 + y) - (1 + traceLM F hLK y))] at hge
      exact Or.inr hge
  exact ⟨hFinLK', htr_bound, hnorm_lin1, G, inferInstance, inferInstance, act,
    hcard_G, hact_one, hact_mul, hact_ring, hact_incl, hact_faithful, hact_val,
    hact_trace, hact_norm⟩

theorem ld_unramified_residue_algebra_and_galois_hom (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))))
    (G : Type u) [Group G] (act : G → K → K)
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x)
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (k_L k_K : Type u) [Field k_L] [Field k_K]
    (resL : L → k_L) (resK : K → k_K)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (hresK_surj : ∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b) :
    ∃ (_ : Algebra k_L k_K) (π_res : G →* (k_K ≃ₐ[k_L] k_K)),
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resK (IntermediateField.inclusion hLK x) = algebraMap k_L k_K (resL x)) ∧
      (∀ (σ : G) (y : K), (y = 0 ∨ 0 ≤ valL F K y) →
        π_res σ (resK y) = resK (act σ y)) :=
by
  rcases hvalL_props with ⟨hvalL0, hvalL1, _, hvalL_neg, hvalL_mul, _, _, hvalL_add⟩
  rcases hvalK_props with ⟨hvalK0, hvalK1, _, hvalK_neg, hvalK_mul, _, _, hvalK_add⟩
  let ι := IntermediateField.inclusion hLK
  have hintL_0 : (0 : L) = 0 ∨ 0 ≤ valL F L 0 := Or.inl rfl
  have hintL_1 : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by rw [hvalL1])
  have hintL_neg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (-x = 0 ∨ 0 ≤ valL F L (-x)) := by
    intro x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · rw [hvalL_neg]
      exact Or.inr hx
  have hintL_add : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (x₁ + x₂ = 0 ∨ 0 ≤ valL F L (x₁ + x₂)) := hvalL_add 0
  have hintL_sub : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (x₁ - x₂ = 0 ∨ 0 ≤ valL F L (x₁ - x₂)) := by
    intro x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    exact hintL_add x₁ (-x₂) hx₁ (hintL_neg x₂ hx₂)
  have hintL_mul : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ hx₁ hx₂
    by_cases h1 : x₁ = 0
    · subst h1; exact Or.inl (zero_mul x₂)
    · by_cases h2 : x₂ = 0
      · subst h2; exact Or.inl (mul_zero x₁)
      · rcases hx₁ with rfl | hx₁
        · contradiction
        · rcases hx₂ with rfl | hx₂
          · contradiction
          · right
            rw [hvalL_mul x₁ x₂ h1 h2]
            omega
  have hresL_sub : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ (hintL_neg x₂ hx₂)).1,
      (hresL_ring x₂ 0 hx₂ hintL_0).2.2, ← sub_eq_add_neg]
  have hintK_0 : (0 : K) = 0 ∨ 0 ≤ valL F K 0 := Or.inl rfl
  have hintK_1 : (1 : K) = 0 ∨ 0 ≤ valL F K 1 := Or.inr (by rw [hvalK1])
  have hintK_neg : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (-y = 0 ∨ 0 ≤ valL F K (-y)) := by
    intro y hy
    rcases hy with rfl | hy
    · exact Or.inl neg_zero
    · rw [hvalK_neg]
      exact Or.inr hy
  have hintK_add : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ + y₂ = 0 ∨ 0 ≤ valL F K (y₁ + y₂)) := hvalK_add 0
  have hintK_sub : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ - y₂ = 0 ∨ 0 ≤ valL F K (y₁ - y₂)) := by
    intro y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg]
    exact hintK_add y₁ (-y₂) hy₁ (hintK_neg y₂ hy₂)
  have hintK_mul : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ * y₂ = 0 ∨ 0 ≤ valL F K (y₁ * y₂)) := by
    intro y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · subst h1; exact Or.inl (zero_mul y₂)
    · by_cases h2 : y₂ = 0
      · subst h2; exact Or.inl (mul_zero y₁)
      · rcases hy₁ with rfl | hy₁
        · contradiction
        · rcases hy₂ with rfl | hy₂
          · contradiction
          · right
            rw [hvalK_mul y₁ y₂ h1 h2]
            omega
  have hresK_sub : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ - y₂) = resK y₁ - resK y₂ := by
    intro y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg, (hresK_ring y₁ (-y₂) hy₁ (hintK_neg y₂ hy₂)).1,
      (hresK_ring y₂ 0 hy₂ hintK_0).2.2, ← sub_eq_add_neg]
  have hintK_incl : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (ι x = 0 ∨ 0 ≤ valL F K (ι x)) := by
    intro x hx
    rcases hx with rfl | hx
    · exact Or.inl (map_zero ι)
    · right
      rw [hval_alg x]
      exact hx
  have hpK_incl : ∀ x : L, (x = 0 ∨ 1 ≤ valL F L x) → (ι x = 0 ∨ 1 ≤ valL F K (ι x)) := by
    intro x hx
    rcases hx with rfl | hx
    · exact Or.inl (map_zero ι)
    · right
      rw [hval_alg x]
      exact hx
  have hintK_act : ∀ (σ : G) (y : K), (y = 0 ∨ 0 ≤ valL F K y) →
      (act σ y = 0 ∨ 0 ≤ valL F K (act σ y)) := by
    intro σ y hy
    rcases hy with rfl | hy
    · exact Or.inl (hact_ring σ).1
    · right
      rw [hact_val σ y]
      exact hy
  have hpK_act : ∀ (σ : G) (y : K), (y = 0 ∨ 1 ≤ valL F K y) →
      (act σ y = 0 ∨ 1 ≤ valL F K (act σ y)) := by
    intro σ y hy
    rcases hy with rfl | hy
    · exact Or.inl (hact_ring σ).1
    · right
      rw [hact_val σ y]
      exact hy
  let sL : k_L → L := fun a => (hresL_surj a).choose
  have hsL_int : ∀ a : k_L, sL a = 0 ∨ 0 ≤ valL F L (sL a) :=
    fun a => (hresL_surj a).choose_spec.1
  have hsL_res : ∀ a : k_L, resL (sL a) = a :=
    fun a => (hresL_surj a).choose_spec.2
  let i₀ : k_L → k_K := fun a => resK (ι (sL a))
  have hi₀_eq : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → resK (ι x) = i₀ (resL x) := by
    intro x hx
    set a := resL x
    set d := x - sL a
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := hintL_sub x (sL a) hx (hsL_int a)
    have hd_res : resL d = 0 := by
      rw [hresL_sub x (sL a) hx (hsL_int a), hsL_res a, sub_self]
    have hd_pL : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    have hιd_int : ι d = 0 ∨ 0 ≤ valL F K (ι d) := hintK_incl d hd_int
    have hιd_pK : ι d = 0 ∨ 1 ≤ valL F K (ι d) := hpK_incl d hd_pL
    have hιd_res : resK (ι d) = 0 := (hresK_ker (ι d) hιd_int).mpr hιd_pK
    have hx_eq : x = d + sL a := (sub_add_cancel x (sL a)).symm
    have hιx_eq : ι x = ι d + ι (sL a) := by
      conv_lhs => rw [hx_eq]
      exact map_add ι d (sL a)
    rw [hιx_eq, (hresK_ring (ι d) (ι (sL a)) hιd_int (hintK_incl (sL a) (hsL_int a))).1,
      hιd_res, zero_add]
  have hi₀_0 : i₀ 0 = 0 := by
    calc i₀ 0 = i₀ (resL 0) := by rw [hresL_0]
      _ = resK (ι 0) := (hi₀_eq 0 hintL_0).symm
      _ = 0 := by rw [map_zero, hresK_0]
  have hi₀_1 : i₀ 1 = 1 := by
    calc i₀ 1 = i₀ (resL 1) := by rw [hresL_1]
      _ = resK (ι 1) := (hi₀_eq 1 hintL_1).symm
      _ = 1 := by rw [map_one, hresK_1]
  have hi₀_add : ∀ a b : k_L, i₀ (a + b) = i₀ a + i₀ b := by
    intro a b
    have hab : a + b = resL (sL a + sL b) := by
      rw [(hresL_ring (sL a) (sL b) (hsL_int a) (hsL_int b)).1, hsL_res a, hsL_res b]
    rw [hab, ← hi₀_eq (sL a + sL b) (hintL_add (sL a) (sL b) (hsL_int a) (hsL_int b)),
      map_add, (hresK_ring (ι (sL a)) (ι (sL b)) (hintK_incl (sL a) (hsL_int a))
        (hintK_incl (sL b) (hsL_int b))).1]
  have hi₀_mul : ∀ a b : k_L, i₀ (a * b) = i₀ a * i₀ b := by
    intro a b
    have hab : a * b = resL (sL a * sL b) := by
      rw [(hresL_ring (sL a) (sL b) (hsL_int a) (hsL_int b)).2.1, hsL_res a, hsL_res b]
    rw [hab, ← hi₀_eq (sL a * sL b) (hintL_mul (sL a) (sL b) (hsL_int a) (hsL_int b)),
      map_mul, (hresK_ring (ι (sL a)) (ι (sL b)) (hintK_incl (sL a) (hsL_int a))
        (hintK_incl (sL b) (hsL_int b))).2.1]
  let i_res : k_L →+* k_K :=
    { toFun := i₀
      map_one' := hi₀_1
      map_mul' := hi₀_mul
      map_zero' := hi₀_0
      map_add' := hi₀_add }
  letI hAlg_k : Algebra k_L k_K := i_res.toAlgebra
  let sK : k_K → K := fun b => (hresK_surj b).choose
  have hsK_int : ∀ b : k_K, sK b = 0 ∨ 0 ≤ valL F K (sK b) :=
    fun b => (hresK_surj b).choose_spec.1
  have hsK_res : ∀ b : k_K, resK (sK b) = b :=
    fun b => (hresK_surj b).choose_spec.2
  let π₀ : G → k_K → k_K := fun σ b => resK (act σ (sK b))
  have hπ₀_eq : ∀ (σ : G) (y : K), (y = 0 ∨ 0 ≤ valL F K y) →
      π₀ σ (resK y) = resK (act σ y) := by
    intro σ y hy
    set b := resK y
    set d := y - sK b
    have hd_int : d = 0 ∨ 0 ≤ valL F K d := hintK_sub y (sK b) hy (hsK_int b)
    have hd_res : resK d = 0 := by
      rw [hresK_sub y (sK b) hy (hsK_int b), hsK_res b, sub_self]
    have hd_pK : d = 0 ∨ 1 ≤ valL F K d := (hresK_ker d hd_int).mp hd_res
    have hactd_int : act σ d = 0 ∨ 0 ≤ valL F K (act σ d) := hintK_act σ d hd_int
    have hactd_pK : act σ d = 0 ∨ 1 ≤ valL F K (act σ d) := hpK_act σ d hd_pK
    have hactd_res : resK (act σ d) = 0 := (hresK_ker (act σ d) hactd_int).mpr hactd_pK
    have hy_eq : y = d + sK b := (sub_add_cancel y (sK b)).symm
    have hacty_eq : act σ y = act σ d + act σ (sK b) := by
      conv_lhs => rw [hy_eq]
      exact ((hact_ring σ).2.2 d (sK b)).1
    rw [hacty_eq, (hresK_ring (act σ d) (act σ (sK b)) hactd_int
      (hintK_act σ (sK b) (hsK_int b))).1, hactd_res, zero_add]
  have hπ₀_one : ∀ b : k_K, π₀ 1 b = b := by
    intro b
    change resK (act 1 (sK b)) = b
    rw [hact_one (sK b), hsK_res b]
  have hπ₀_mul_act : ∀ (σ τ : G) (b : k_K), π₀ (σ * τ) b = π₀ σ (π₀ τ b) := by
    intro σ τ b
    change resK (act (σ * τ) (sK b)) = π₀ σ (resK (act τ (sK b)))
    rw [hact_mul σ τ (sK b), hπ₀_eq σ (act τ (sK b)) (hintK_act τ (sK b) (hsK_int b))]
  have hπ₀_left_inv : ∀ (σ : G) (b : k_K), π₀ σ⁻¹ (π₀ σ b) = b := by
    intro σ b
    rw [← hπ₀_mul_act σ⁻¹ σ b, inv_mul_cancel, hπ₀_one b]
  have hπ₀_right_inv : ∀ (σ : G) (b : k_K), π₀ σ (π₀ σ⁻¹ b) = b := by
    intro σ b
    rw [← hπ₀_mul_act σ σ⁻¹ b, mul_inv_cancel, hπ₀_one b]
  have hπ₀_add : ∀ (σ : G) (b₁ b₂ : k_K), π₀ σ (b₁ + b₂) = π₀ σ b₁ + π₀ σ b₂ := by
    intro σ b₁ b₂
    have hb : b₁ + b₂ = resK (sK b₁ + sK b₂) := by
      rw [(hresK_ring (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)).1, hsK_res b₁, hsK_res b₂]
    rw [hb, hπ₀_eq σ (sK b₁ + sK b₂) (hintK_add (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)),
      ((hact_ring σ).2.2 (sK b₁) (sK b₂)).1,
      (hresK_ring (act σ (sK b₁)) (act σ (sK b₂))
        (hintK_act σ (sK b₁) (hsK_int b₁)) (hintK_act σ (sK b₂) (hsK_int b₂))).1]
  have hπ₀_mul : ∀ (σ : G) (b₁ b₂ : k_K), π₀ σ (b₁ * b₂) = π₀ σ b₁ * π₀ σ b₂ := by
    intro σ b₁ b₂
    have hb : b₁ * b₂ = resK (sK b₁ * sK b₂) := by
      rw [(hresK_ring (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)).2.1, hsK_res b₁, hsK_res b₂]
    rw [hb, hπ₀_eq σ (sK b₁ * sK b₂) (hintK_mul (sK b₁) (sK b₂) (hsK_int b₁) (hsK_int b₂)),
      ((hact_ring σ).2.2 (sK b₁) (sK b₂)).2.1,
      (hresK_ring (act σ (sK b₁)) (act σ (sK b₂))
        (hintK_act σ (sK b₁) (hsK_int b₁)) (hintK_act σ (sK b₂) (hsK_int b₂))).2.1]
  have hπ₀_commutes : ∀ (σ : G) (a : k_L),
      π₀ σ (algebraMap k_L k_K a) = algebraMap k_L k_K a := by
    intro σ a
    change π₀ σ (resK (ι (sL a))) = resK (ι (sL a))
    rw [hπ₀_eq σ (ι (sL a)) (hintK_incl (sL a) (hsL_int a)), hact_incl σ (sL a)]
  let π_equiv : G → (k_K ≃ₐ[k_L] k_K) := fun σ =>
    { toFun := π₀ σ
      invFun := π₀ σ⁻¹
      left_inv := hπ₀_left_inv σ
      right_inv := hπ₀_right_inv σ
      map_mul' := hπ₀_mul σ
      map_add' := hπ₀_add σ
      commutes' := hπ₀_commutes σ }
  let π_res : G →* (k_K ≃ₐ[k_L] k_K) :=
    { toFun := π_equiv
      map_one' := by
        apply AlgEquiv.ext
        intro b
        exact hπ₀_one b
      map_mul' := by
        intro σ τ
        apply AlgEquiv.ext
        intro b
        exact hπ₀_mul_act σ τ b }
  exact ⟨hAlg_k, π_res, hi₀_eq, hπ₀_eq⟩

theorem ld_unramified_inertia_trivial_of_resK_fix (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (hvalL_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m)
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))))
    (G : Type u) [Group G] (act : G → K → K)
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x)
    (hact_faithful : ∀ σ : G, (∀ y : K, act σ y = y) → σ = 1)
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (k_K : Type u) [Field k_K] [Fintype k_K]
    (resK : K → k_K)
    (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (σ : G)
    (hσ_res : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → resK (act σ y) = resK y) :
    σ = 1 :=
by
  rcases hvalK_props with ⟨hvalK0, hvalK1, _, hvalK_neg, hvalK_mul, hvalK_inv, _, hvalK_add⟩
  have hintK_0 : (0 : K) = 0 ∨ 0 ≤ valL F K 0 := Or.inl rfl
  have hintK_1 : (1 : K) = 0 ∨ 0 ≤ valL F K 1 := Or.inr (by rw [hvalK1])
  have hintK_neg : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (-y = 0 ∨ 0 ≤ valL F K (-y)) := by
    intro y hy
    rcases hy with rfl | hy
    · simp
    · right; rw [hvalK_neg]; exact hy
  have hintK_add : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ + y₂ = 0 ∨ 0 ≤ valL F K (y₁ + y₂)) := hvalK_add 0
  have hintK_sub : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ - y₂ = 0 ∨ 0 ≤ valL F K (y₁ - y₂)) := by
    intro y₁ y₂ hy₁ hy₂; rw [sub_eq_add_neg]; exact hintK_add y₁ (-y₂) hy₁ (hintK_neg y₂ hy₂)
  have hintK_mul : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ * y₂ = 0 ∨ 0 ≤ valL F K (y₁ * y₂)) := by
    intro y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · simp [h1]
    · by_cases h2 : y₂ = 0
      · simp [h2]
      · right; rw [hvalK_mul y₁ y₂ h1 h2]
        rcases hy₁ with rfl | hy₁
        · contradiction
        · rcases hy₂ with rfl | hy₂
          · contradiction
          · omega
  have hresK_sub : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ - y₂) = resK y₁ - resK y₂ := by
    intro y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg, (hresK_ring y₁ (-y₂) hy₁ (hintK_neg y₂ hy₂)).1,
      (hresK_ring y₂ 0 hy₂ hintK_0).2.2, ← sub_eq_add_neg]
  have hintK_act : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (act σ y = 0 ∨ 0 ≤ valL F K (act σ y)) := by
    intro y hy
    rcases hy with rfl | hy
    · left; exact (hact_ring σ).1
    · right; rw [hact_val]; exact hy
  have hact_sub : ∀ y₁ y₂ : K, act σ (y₁ - y₂) = act σ y₁ - act σ y₂ := by
    intro y₁ y₂
    rw [sub_eq_add_neg, ((hact_ring σ).2.2 y₁ (-y₂)).1, ((hact_ring σ).2.2 y₂ 0).2.2, ← sub_eq_add_neg]
  have hact_pow : ∀ (y : K) (n : ℕ), act σ (y ^ n) = (act σ y) ^ n := by
    intro y n
    induction n with
    | zero => simp [(hact_ring σ).2.1]
    | succ n ih => rw [pow_succ, ((hact_ring σ).2.2 (y ^ n) y).2.1, ih, pow_succ]
  have hresK_pow : ∀ (y : K), (y = 0 ∨ 0 ≤ valL F K y) → ∀ (n : ℕ),
      (y ^ n = 0 ∨ 0 ≤ valL F K (y ^ n)) ∧ resK (y ^ n) = (resK y) ^ n := by
    intro y hy n
    induction n with
    | zero =>
      refine ⟨?_, ?_⟩
      · rw [pow_zero]; exact hintK_1
      · rw [pow_zero, pow_zero, hresK_1]
    | succ n ih =>
      refine ⟨?_, ?_⟩
      · rw [pow_succ]; exact hintK_mul (y ^ n) y ih.1 hy
      · rw [pow_succ, (hresK_ring (y ^ n) y ih.1 hy).2.1, ih.2, pow_succ]
  have hresK_sum : ∀ (S : Finset ℕ) (f : ℕ → K),
      (∀ j ∈ S, f j = 0 ∨ 0 ≤ valL F K (f j)) →
      ((∑ j ∈ S, f j) = 0 ∨ 0 ≤ valL F K (∑ j ∈ S, f j)) ∧
        resK (∑ j ∈ S, f j) = ∑ j ∈ S, resK (f j) := by
    intro S f hf
    induction S using Finset.induction_on with
    | empty => simp [hresK_0]
    | @insert a s ha ih =>
      have hfa : f a = 0 ∨ 0 ≤ valL F K (f a) := hf a (Finset.mem_insert_self a s)
      have hfs : ∀ j ∈ s, f j = 0 ∨ 0 ≤ valL F K (f j) :=
        fun j hj => hf j (Finset.mem_insert_of_mem hj)
      have ih' := ih hfs
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      refine ⟨hintK_add _ _ hfa ih'.1, ?_⟩
      rw [(hresK_ring _ _ hfa ih'.1).1, ih'.2]
  obtain ⟨ϖL, hϖL⟩ := hvalL_surj 1
  let uK : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom ϖL
  have huK_coe : (uK : K) = IntermediateField.inclusion hLK (ϖL : L) := rfl
  have huK_val : valL F K (uK : K) = 1 := by
    rw [huK_coe, hval_alg, hϖL]
  have huK_inv_val : valL F K ((uK⁻¹ : Kˣ) : K) = -1 := by
    rw [hvalK_inv, huK_val]
  have huK_act : act σ (uK : K) = (uK : K) := by
    rw [huK_coe, hact_incl]
  let M : ℕ := Fintype.card k_Kˣ
  have hM_card : M + 1 = Fintype.card k_K := by
    have hpos : 0 < Fintype.card k_K := Fintype.card_pos
    have hu := Fintype.card_units k_K
    dsimp [M]
    omega
  have hM_cast : (M : k_K) = -1 := by
    have h0 : ((M + 1 : ℕ) : k_K) = 0 := by
      rw [hM_card, FiniteField.cast_card_eq_zero]
    push_cast at h0
    exact eq_neg_of_add_eq_zero_left h0
  have hind : ∀ (i : ℕ) (y : K), (y = 0 ∨ 0 ≤ valL F K y) →
      (act σ y - y = 0 ∨ (i : ℤ) ≤ valL F K (act σ y - y)) := by
    intro i
    induction i with
    | zero =>
      intro y hy
      simpa using hintK_sub (act σ y) y (hintK_act y hy) hy
    | succ i ih =>
      have hstep1 : ∀ z : K, (z = 0 ∨ 1 ≤ valL F K z) →
           (act σ z - z = 0 ∨ ((i + 1 : ℕ) : ℤ) ≤ valL F K (act σ z - z)) := by
        intro z hz
        rcases hz with rfl | hz
        · left; rw [(hact_ring σ).1, sub_zero]
        · by_cases hz0 : z = 0
          · left; rw [hz0, (hact_ring σ).1, sub_zero]
          · let y' : K := ((uK⁻¹ : Kˣ) : K) * z
            have hy'_val : valL F K y' = -1 + valL F K z := by
              rw [hvalK_mul _ _ (Units.ne_zero _) hz0, huK_inv_val]
            have hy'_int : y' = 0 ∨ 0 ≤ valL F K y' := Or.inr (by omega)
            have hz_eq : z = (uK : K) * y' := by
              dsimp [y']
              rw [← mul_assoc, Units.mul_inv, one_mul]
            have hdiff_eq : act σ z - z = (uK : K) * (act σ y' - y') := by
              conv_lhs => rw [hz_eq]
              rw [((hact_ring σ).2.2 (uK : K) y').2.1, huK_act, mul_sub]
            rcases ih y' hy'_int with h0 | hval
            · left; rw [hdiff_eq, h0, mul_zero]
            · by_cases hdiff0 : act σ y' - y' = 0
              · left; rw [hdiff_eq, hdiff0, mul_zero]
              · right
                rw [hdiff_eq, hvalK_mul (uK : K) _ (Units.ne_zero _) hdiff0, huK_val]
                push_cast
                omega
      intro y hy
      by_cases hres0 : resK y = 0
      · exact hstep1 y ((hresK_ker y hy).mp hres0)
      · let uy : k_Kˣ := Units.mk0 (resK y) hres0
        have huy_pow : (resK y) ^ M = 1 := by
          have h1 : uy ^ M = 1 := pow_card_eq_one
          exact congrArg Units.val h1
        let z : K := y ^ M - 1
        have hz_int : z = 0 ∨ 0 ≤ valL F K z := hintK_sub (y ^ M) 1 (hresK_pow y hy M).1 hintK_1
        have hz_res : resK z = 0 := by
          dsimp [z]
          rw [hresK_sub (y ^ M) 1 (hresK_pow y hy M).1 hintK_1, (hresK_pow y hy M).2,
            huy_pow, hresK_1, sub_self]
        have hz_step := hstep1 z ((hresK_ker z hz_int).mp hz_res)
        have hact_z : act σ z - z = (act σ y) ^ M - y ^ M := by
          dsimp [z]
          rw [hact_sub, hact_pow, (hact_ring σ).2.1, sub_sub_sub_cancel_right]
        rw [hact_z] at hz_step
        let f : ℕ → K := fun j => (act σ y) ^ j * y ^ (M - 1 - j)
        let S : K := ∑ j ∈ Finset.range M, f j
        have hgeom : S * (act σ y - y) = (act σ y) ^ M - y ^ M :=
          geom_sum₂_mul (act σ y) y M
        have hf_int : ∀ j ∈ Finset.range M, f j = 0 ∨ 0 ≤ valL F K (f j) := by
          intro j _
          exact hintK_mul _ _ (hresK_pow (act σ y) (hintK_act y hy) j).1
            (hresK_pow y hy (M - 1 - j)).1
        have hS_sum : (S = 0 ∨ 0 ≤ valL F K S) ∧ resK S = ∑ j ∈ Finset.range M, resK (f j) :=
          hresK_sum (Finset.range M) f hf_int
        have hf_res : ∀ j ∈ Finset.range M, resK (f j) = (resK y) ^ (M - 1) := by
          intro j hj
          have hj_lt : j < M := Finset.mem_range.mp hj
          dsimp [f]
          rw [(hresK_ring _ _ (hresK_pow (act σ y) (hintK_act y hy) j).1
            (hresK_pow y hy (M - 1 - j)).1).2.1,
            (hresK_pow (act σ y) (hintK_act y hy) j).2,
            (hresK_pow y hy (M - 1 - j)).2,
            hσ_res y hy, ← pow_add]
          congr 1
          omega
        have hS_res : resK S = - (resK y) ^ (M - 1) := by
          rw [hS_sum.2, Finset.sum_congr rfl hf_res, Finset.sum_const, Finset.card_range,
            nsmul_eq_mul, hM_cast, neg_one_mul]
        have hS_res_ne : resK S ≠ 0 := by
          rw [hS_res, neg_ne_zero]
          exact pow_ne_zero _ hres0
        have hS_not_pK : ¬ (S = 0 ∨ 1 ≤ valL F K S) := by
          intro hS_pK
          exact hS_res_ne ((hresK_ker S hS_sum.1).mpr hS_pK)
        have hS_ne : S ≠ 0 := fun h0 => hS_not_pK (Or.inl h0)
        have hS_val : valL F K S = 0 := by
          rcases hS_sum.1 with hS0 | hge0
          · exact absurd hS0 hS_ne
          · have hlt1 : ¬ (1 ≤ valL F K S) := fun h1 => hS_not_pK (Or.inr h1)
            omega
        by_cases hdiff0 : act σ y - y = 0
        · exact Or.inl hdiff0
        · right
          have hprod_ne : S * (act σ y - y) ≠ 0 := mul_ne_zero hS_ne hdiff0
          rw [← hgeom] at hz_step
          rcases hz_step with h0 | hval
          · exact absurd h0 hprod_ne
          · rw [hvalK_mul S (act σ y - y) hS_ne hdiff0, hS_val, zero_add] at hval
            exact hval
  have hfix_int : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → act σ y = y := by
    intro y hy
    by_contra hne
    have hdiff_ne : act σ y - y ≠ 0 := sub_ne_zero.mpr hne
    let i : ℕ := (valL F K (act σ y - y)).toNat + 1
    rcases hind i y hy with h0 | hval
    · exact hdiff_ne h0
    · dsimp [i] at hval
      omega
  apply hact_faithful σ
  intro y
  by_cases hy : y = 0 ∨ 0 ≤ valL F K y
  · exact hfix_int y hy
  · push_neg at hy
    rcases hy with ⟨hy0, hylt⟩
    let uy : Kˣ := Units.mk0 y hy0
    let y_inv : K := ((uy⁻¹ : Kˣ) : K)
    have hy_inv_val : valL F K y_inv = - valL F K y := hvalK_inv uy
    have hy_inv_int : y_inv = 0 ∨ 0 ≤ valL F K y_inv := Or.inr (by omega)
    have hfix_inv : act σ y_inv = y_inv := hfix_int y_inv hy_inv_int
    have hmul1 : y * y_inv = 1 := Units.mul_inv uy
    have hact_mul1 : act σ y * y_inv = 1 := by
      rw [← hfix_inv, ← ((hact_ring σ).2.2 y y_inv).2.1, hmul1, (hact_ring σ).2.1]
    exact mul_right_cancel₀ (Units.ne_zero uy⁻¹) (hact_mul1.trans hmul1.symm)

theorem ld_unramified_trace_one_of_galois_inj (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (htr_bound : ∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x)
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (k_L k_K : Type u) [Field k_L] [Field k_K] [Algebra k_L k_K]
    (resL : L → k_L) (resK : K → k_K)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresK_0 : resK 0 = 0)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_surj : ∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b)
    (hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resK (IntermediateField.inclusion hLK x) = algebraMap k_L k_K (resL x))
    (π_res : G →* (k_K ≃ₐ[k_L] k_K))
    (hπ_inj : Function.Injective π_res)
    (hπ_res : ∀ (σ : G) (y : K), (y = 0 ∨ 0 ≤ valL F K y) →
      π_res σ (resK y) = resK (act σ y)) :
    ∃ y₁ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) ∧ traceLM F hLK y₁ = 1 :=
by
  rcases hvalL_props with ⟨_, _, _, _, _, hvalL_inv, _, _⟩
  rcases hvalK_props with ⟨_, _, _, _, hvalK_mul, _, _, hvalK_add⟩
  have hintK_0 : (0 : K) = 0 ∨ 0 ≤ valL F K 0 := Or.inl rfl
  have hintK_add : ∀ y₁ y₂ : K,
      (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ + y₂ = 0 ∨ 0 ≤ valL F K (y₁ + y₂)) := hvalK_add 0
  have hintK_mul : ∀ y₁ y₂ : K,
      (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ * y₂ = 0 ∨ 0 ≤ valL F K (y₁ * y₂)) := by
    intro y₁ y₂ hy₁ hy₂
    by_cases h₁ : y₁ = 0
    · left; rw [h₁, zero_mul]
    · by_cases h₂ : y₂ = 0
      · left; rw [h₂, mul_zero]
      · right
        have hv₁ : 0 ≤ valL F K y₁ := hy₁.resolve_left h₁
        have hv₂ : 0 ≤ valL F K y₂ := hy₂.resolve_left h₂
        rw [hvalK_mul y₁ y₂ h₁ h₂]
        omega
  have hresK_sum : ∀ (S : Finset G) (g : G → K),
      (∀ σ ∈ S, g σ = 0 ∨ 0 ≤ valL F K (g σ)) →
      ((∑ σ ∈ S, g σ) = 0 ∨ 0 ≤ valL F K (∑ σ ∈ S, g σ)) ∧
        resK (∑ σ ∈ S, g σ) = ∑ σ ∈ S, resK (g σ) := by
    intro S g
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp [hresK_0]
    | @insert a s ha ih =>
      intro hg
      have hga : g a = 0 ∨ 0 ≤ valL F K (g a) := hg a (Finset.mem_insert_self a s)
      have hgs : ∀ σ ∈ s, g σ = 0 ∨ 0 ≤ valL F K (g σ) :=
        fun σ hσ => hg σ (Finset.mem_insert_of_mem hσ)
      have ih_s := ih hgs
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      refine ⟨hintK_add _ _ hga ih_s.1, ?_⟩
      rw [(hresK_ring _ _ hga ih_s.1).1, ih_s.2]
  let f : G → (k_Kˣ →* k_K) :=
    fun σ => (π_res σ : k_K →+* k_K).toMonoidHom.comp (Units.coeHom k_K)
  have hf_inj : Function.Injective f := by
    intro σ₁ σ₂ h_eq
    apply hπ_inj
    apply AlgEquiv.ext
    intro b
    by_cases hb : b = 0
    · rw [hb, map_zero, map_zero]
    · let u : k_Kˣ := Units.mk0 b hb
      have hu : (f σ₁) u = (f σ₂) u := congrFun (congrArg DFunLike.coe h_eq) u
      exact hu
  have h_lin : LinearIndependent k_K (fun σ : G => (f σ : k_Kˣ → k_K)) :=
    (linearIndependent_monoidHom k_Kˣ k_K).comp f hf_inj
  have h_sum_ne : (∑ σ : G, (1 : k_K) • (f σ : k_Kˣ → k_K)) ≠ 0 := by
    intro h0
    have h1 : (1 : k_K) = 0 :=
      Fintype.linearIndependent_iff.mp h_lin (fun _ => (1 : k_K)) h0 (1 : G)
    exact one_ne_zero h1
  have h_ex_u : ∃ u₀ : k_Kˣ, ∑ σ : G, π_res σ (u₀ : k_K) ≠ 0 := by
    by_contra h_all
    push_neg at h_all
    apply h_sum_ne
    ext u₀
    simp only [Finset.sum_apply, one_smul, Pi.zero_apply]
    exact h_all u₀
  obtain ⟨u₀, hu₀⟩ := h_ex_u
  obtain ⟨y₀, hy₀_int, hy₀_res⟩ := hresK_surj (u₀ : k_K)
  let t₀ : L := traceLM F hLK y₀
  have ht₀_int : t₀ = 0 ∨ 0 ≤ valL F L t₀ := htr_bound 0 y₀ hy₀_int
  have hact_y₀_int : ∀ σ ∈ (Finset.univ : Finset G),
      act σ y₀ = 0 ∨ 0 ≤ valL F K (act σ y₀) := by
    intro σ _
    rcases hy₀_int with rfl | hv
    · left; exact (hact_ring σ).1
    · right; rw [hact_val σ y₀]; exact hv
  have hres_t₀ : algebraMap k_L k_K (resL t₀) = ∑ σ : G, π_res σ (u₀ : k_K) := by
    rw [← hres_alg t₀ ht₀_int]
    change resK (IntermediateField.inclusion hLK (traceLM F hLK y₀)) = _
    rw [hact_trace y₀]
    rw [(hresK_sum Finset.univ (fun σ => act σ y₀) hact_y₀_int).2]
    apply Finset.sum_congr rfl
    intro σ _
    rw [← hπ_res σ y₀ hy₀_int, hy₀_res]
  have hresL_t₀_ne : resL t₀ ≠ 0 := by
    intro h0
    apply hu₀
    rw [← hres_t₀, h0, map_zero]
  have ht₀_not_ker : ¬ (t₀ = 0 ∨ 1 ≤ valL F L t₀) := by
    intro h_ker
    exact hresL_t₀_ne ((hresL_ker t₀ ht₀_int).mpr h_ker)
  have ht₀_ne : t₀ ≠ 0 := fun h0 => ht₀_not_ker (Or.inl h0)
  have ht₀_val : valL F L t₀ = 0 := by
    have hv0 : 0 ≤ valL F L t₀ := ht₀_int.resolve_left ht₀_ne
    have hv1 : ¬ (1 ≤ valL F L t₀) := fun h1 => ht₀_not_ker (Or.inr h1)
    omega
  let ut₀ : Lˣ := Units.mk0 t₀ ht₀_ne
  let t₀_inv : L := ((ut₀⁻¹ : Lˣ) : L)
  have ht₀_inv_val : valL F L t₀_inv = 0 := by
    change valL F L ((ut₀⁻¹ : Lˣ) : L) = 0
    rw [hvalL_inv]
    change - valL F L t₀ = 0
    rw [ht₀_val, neg_zero]
  let y₁ : K := IntermediateField.inclusion hLK t₀_inv * y₀
  have hy₁_int : y₁ = 0 ∨ 0 ≤ valL F K y₁ := by
    apply hintK_mul
    · right
      rw [hval_alg t₀_inv, ht₀_inv_val]
    · exact hy₀_int
  have hy₁_tr : traceLM F hLK y₁ = 1 := by
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (traceLM F hLK y₁) =
      IntermediateField.inclusion hLK 1
    rw [hact_trace y₁, map_one]
    have h_term : ∀ σ : G,
        act σ y₁ = IntermediateField.inclusion hLK t₀_inv * act σ y₀ := by
      intro σ
      change act σ (IntermediateField.inclusion hLK t₀_inv * y₀) = _
      rw [((hact_ring σ).2.2 _ y₀).2.1, hact_incl σ t₀_inv]
    simp_rw [h_term]
    rw [← Finset.mul_sum, ← hact_trace y₀, ← map_mul]
    change IntermediateField.inclusion hLK (t₀_inv * t₀) = 1
    have h_inv_mul : t₀_inv * t₀ = 1 := by
      change ((ut₀⁻¹ : Lˣ) : L) * (ut₀ : L) = 1
      exact Units.inv_mul ut₀
    rw [h_inv_mul, map_one]
  exact ⟨y₁, hy₁_int, hy₁_tr⟩

theorem ld_unramified_residue_finrank_eq_of_galois_inj (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))))
    (G : Type u) [Group G] [Fintype G]
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (k_L k_K : Type u) [Field k_L] [Field k_K] [Fintype k_K] [Algebra k_L k_K]
    (resL : L → k_L) (resK : K → k_K)
    (hresL_1 : resL 1 = 1)
    (hresK_0 : resK 0 = 0)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_surj : ∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b)
    (hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resK (IntermediateField.inclusion hLK x) = algebraMap k_L k_K (resL x))
    (π_res : G →* (k_K ≃ₐ[k_L] k_K))
    (hπ_inj : Function.Injective π_res) :
    Module.finrank k_L k_K = Module.finrank L (IntermediateField.extendScalars hLK) :=
by
  haveI : FiniteDimensional k_L k_K := Module.Finite.of_finite
  set H : Subgroup (k_K ≃ₐ[k_L] k_K) := π_res.range
  have h_artin : Module.finrank (IntermediateField.fixedField H) k_K = Nat.card H :=
    IntermediateField.finrank_fixedField_eq_card H
  have hcard_H : Nat.card H = Module.finrank L (IntermediateField.extendScalars hLK) := by
    have h1 : Nat.card H = Nat.card (Set.range π_res) := rfl
    rw [h1, Nat.card_range_of_injective hπ_inj, ← Fintype.card_eq_nat_card, hcard_G]
  have htower : Module.finrank k_L (IntermediateField.fixedField H) *
      Module.finrank (IntermediateField.fixedField H) k_K = Module.finrank k_L k_K :=
    Module.finrank_mul_finrank k_L (IntermediateField.fixedField H) k_K
  have hpos_fixed : 0 < Module.finrank k_L (IntermediateField.fixedField H) := Module.finrank_pos
  have h_le_1 : Module.finrank L (IntermediateField.extendScalars hLK) ≤ Module.finrank k_L k_K := by
    rw [← hcard_H, ← h_artin, ← htower]
    exact Nat.le_mul_of_pos_left _ hpos_fixed
  rcases hvalL_props with ⟨_, _, _, _, hvalL_mul, hvalL_inv, _, _⟩
  rcases hvalK_props with ⟨_, _, _, _, hvalK_mul, _, _, hvalK_add⟩
  have hintK_add := hvalK_add 0
  have hintK_mul : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      (y₁ * y₂ = 0 ∨ 0 ≤ valL F K (y₁ * y₂)) := by
    intro y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : y₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rcases hy₁ with rfl | hy₁
        · contradiction
        · rcases hy₂ with rfl | hy₂
          · contradiction
          · rw [hvalK_mul y₁ y₂ h1 h2]
            omega
  set m := Module.finrank k_L k_K
  have hresK_sum : ∀ (S : Finset (Fin m)) (f : Fin m → K),
      (∀ i ∈ S, f i = 0 ∨ 0 ≤ valL F K (f i)) →
      ((∑ i ∈ S, f i) = 0 ∨ 0 ≤ valL F K (∑ i ∈ S, f i)) ∧
        resK (∑ i ∈ S, f i) = ∑ i ∈ S, resK (f i) := by
    intro S f
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp [hresK_0]
    | insert a s ha ih =>
      intro hf
      have hfa : f a = 0 ∨ 0 ≤ valL F K (f a) := hf a (Finset.mem_insert_self a s)
      have hfs : ∀ i ∈ s, f i = 0 ∨ 0 ≤ valL F K (f i) :=
        fun i hi => hf i (Finset.mem_insert_of_mem hi)
      obtain ⟨hsum_int, hsum_res⟩ := ih hfs
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      refine ⟨hintK_add (f a) (∑ i ∈ s, f i) hfa hsum_int, ?_⟩
      rw [(hresK_ring (f a) (∑ i ∈ s, f i) hfa hsum_int).1, hsum_res]
  set b : Module.Basis (Fin m) k_L k_K := Module.finBasis k_L k_K
  let y : Fin m → K := fun i => (hresK_surj (b i)).choose
  have hy_int : ∀ i : Fin m, y i = 0 ∨ 0 ≤ valL F K (y i) :=
    fun i => (hresK_surj (b i)).choose_spec.1
  have hy_res : ∀ i : Fin m, resK (y i) = b i :=
    fun i => (hresK_surj (b i)).choose_spec.2
  let y' : Fin m → IntermediateField.extendScalars hLK := fun i => toExtendScalars F hLK (y i)
  have hsmul_eq : ∀ (c : L) (z : K),
      c • toExtendScalars F hLK z = toExtendScalars F hLK (IntermediateField.inclusion hLK c * z) := by
    intro c z
    exact Subtype.ext rfl
  have hto_inj : Function.Injective (toExtendScalars F hLK) := by
    intro z₁ z₂ h
    exact Subtype.ext (congrArg Subtype.val h)
  have h_lin : LinearIndependent L y' := by
    rw [Fintype.linearIndependent_iff]
    intro g hsum0 i₀
    by_contra hgi₀
    have hsumK : (∑ i : Fin m, IntermediateField.inclusion hLK (g i) * y i) = 0 := by
      apply hto_inj
      rw [map_zero, map_sum]
      have h_eq : (∑ x : Fin m, toExtendScalars F hLK (IntermediateField.inclusion hLK (g x) * y x)) =
          ∑ x : Fin m, g x • y' x := by
        refine Finset.sum_congr rfl fun x _ => ?_
        exact (hsmul_eq (g x) (y x)).symm
      rw [h_eq, hsum0]
    let A : Finset (Fin m) := Finset.univ.filter (fun i : Fin m => g i ≠ 0)
    have hA_ne : A.Nonempty := ⟨i₀, Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hgi₀⟩⟩
    obtain ⟨i_star, hi_star_mem, hi_star_min⟩ :=
      Finset.exists_min_image A (fun i => valL F L (g i)) hA_ne
    have hgi_star : g i_star ≠ 0 := (Finset.mem_filter.mp hi_star_mem).2
    let u_star : Lˣ := Units.mk0 (g i_star) hgi_star
    let c_star_inv : L := ((u_star⁻¹ : Lˣ) : L)
    have hval_c_inv : valL F L c_star_inv = - valL F L (g i_star) := hvalL_inv u_star
    let d : Fin m → L := fun i => c_star_inv * g i
    have hd_int : ∀ i : Fin m, d i = 0 ∨ 0 ≤ valL F L (d i) := by
      intro i
      by_cases hgi : g i = 0
      · left
        dsimp [d]
        rw [hgi, mul_zero]
      · right
        have hi_A : i ∈ A := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hgi⟩
        have hmin_i : valL F L (g i_star) ≤ valL F L (g i) := hi_star_min i hi_A
        have hc_ne : c_star_inv ≠ 0 := Units.ne_zero u_star⁻¹
        dsimp [d]
        rw [hvalL_mul c_star_inv (g i) hc_ne hgi, hval_c_inv]
        omega
    have hd_i_star : d i_star = 1 := Units.inv_mul u_star
    have hsumK_d : (∑ i : Fin m, IntermediateField.inclusion hLK (d i) * y i) = 0 := by
      have hmul0 : IntermediateField.inclusion hLK c_star_inv *
          (∑ i : Fin m, IntermediateField.inclusion hLK (g i) * y i) = 0 := by
        rw [hsumK, mul_zero]
      rw [Finset.mul_sum] at hmul0
      rw [← hmul0]
      refine Finset.sum_congr rfl fun i _ => ?_
      dsimp [d]
      rw [map_mul, mul_assoc]
    have h_incl_int : ∀ i : Fin m,
        IntermediateField.inclusion hLK (d i) = 0 ∨
          0 ≤ valL F K (IntermediateField.inclusion hLK (d i)) := by
      intro i
      rcases hd_int i with hdi | hdi
      · left; rw [hdi, map_zero]
      · right; rw [hval_alg (d i)]; exact hdi
    have h_term_int : ∀ i : Fin m,
        IntermediateField.inclusion hLK (d i) * y i = 0 ∨
          0 ≤ valL F K (IntermediateField.inclusion hLK (d i) * y i) :=
      fun i => hintK_mul _ _ (h_incl_int i) (hy_int i)
    have hsum_res : (∑ i : Fin m, (resL (d i)) • b i) = 0 := by
      have h1 := (hresK_sum Finset.univ
        (fun i => IntermediateField.inclusion hLK (d i) * y i)
        (fun i _ => h_term_int i)).2
      rw [hsumK_d, hresK_0] at h1
      rw [← h1.symm]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [(hresK_ring _ _ (h_incl_int i) (hy_int i)).2.1,
        hres_alg (d i) (hd_int i), hy_res i, ← Algebra.smul_def]
    have hres_d_zero : resL (d i_star) = 0 :=
      Fintype.linearIndependent_iff.mp b.linearIndependent (fun i => resL (d i)) hsum_res i_star
    rw [hd_i_star, hresL_1] at hres_d_zero
    exact one_ne_zero hres_d_zero
  have h_le_2 : Module.finrank k_L k_K ≤ Module.finrank L (IntermediateField.extendScalars hLK) := by
    have hcard := h_lin.fintype_card_le_finrank
    rwa [Fintype.card_fin m] at hcard
  exact le_antisymm h_le_2 h_le_1

theorem ld_unramified_residue_algebra_and_galois_inj (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (htr_bound : ∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x)
    (hact_faithful : ∀ σ : G, (∀ y : K, act σ y = y) → σ = 1)
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (k_L k_K : Type u) [Field k_L] [Fintype k_L] [Field k_K] [Fintype k_K]
    (resL : L → k_L) (resK : K → k_K)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (hresK_surj : ∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b) :
    (∃ y₁ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) ∧ traceLM F hLK y₁ = 1) ∧
    ∃ (_ : Algebra k_L k_K) (π_res : G →* (k_K ≃ₐ[k_L] k_K)),
      Module.finrank k_L k_K = Module.finrank L (IntermediateField.extendScalars hLK) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resK (IntermediateField.inclusion hLK x) = algebraMap k_L k_K (resL x)) ∧
      Function.Injective π_res ∧
      (∀ (σ : G) (y : K), (y = 0 ∨ 0 ≤ valL F K y) →
        π_res σ (resK y) = resK (act σ y)) :=
by
  obtain ⟨hAlg_k, π_res, hres_alg, hπ_res⟩ :=
    ld_unramified_residue_algebra_and_galois_hom F L K hLK hval_alg hvalL_props hvalK_props
      G act hact_one hact_mul hact_ring hact_incl hact_val
      k_L k_K resL resK hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
  letI : Algebra k_L k_K := hAlg_k
  have hπ_inj : Function.Injective π_res := by
    rw [injective_iff_map_eq_one]
    intro σ hσ1
    apply ld_unramified_inertia_trivial_of_resK_fix F L K hLK hval_alg
      hvalL_props.2.2.2.2.2.2.1 hvalK_props
      G act hact_ring hact_incl hact_faithful hact_val
      k_K resK hresK_0 hresK_1 hresK_ring hresK_ker σ
    intro y hy
    rw [← hπ_res σ y hy, hσ1]
    rfl
  have hy₁ :=
    ld_unramified_trace_one_of_galois_inj F L K hLK hval_alg htr_bound hvalL_props hvalK_props
      G act hact_ring hact_incl hact_val hact_trace
      k_L k_K resL resK hresL_ker hresK_0 hresK_ring hresK_surj
      hres_alg π_res hπ_inj hπ_res
  have hfinrank_res :=
    ld_unramified_residue_finrank_eq_of_galois_inj F L K hLK hval_alg hvalL_props hvalK_props
      G hcard_G k_L k_K resL resK hresL_1 hresK_0 hresK_ring hresK_surj
      hres_alg π_res hπ_inj
  exact ⟨hy₁, hAlg_k, π_res, hfinrank_res, hres_alg, hπ_inj, hπ_res⟩

theorem ld_unramified_charpoly_trace_norm_and_quad_expansion (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (htr_bound : ∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ (k : ℤ) (x y : L),
