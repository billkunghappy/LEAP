              ξ_M₁' * e_Δ (p - 1) := by
        have hIcc : Finset.Icc 1 (p - 1) = Finset.Icc 1 ((p - 2) + 1) :=
          congrArg (Finset.Icc 1) (by omega)
        rw [hIcc, Finset.sum_Icc_succ_top (by omega : 1 ≤ (p - 2) + 1)]
        have hsub1 : p - ((p - 2) + 1) = 1 := by omega
        have hsub2 : (p - 2) + 1 = p - 1 := by omega
        rw [hsub1, hsub2, pow_one]
      have htop_scale : ξ_M₁' ^ p * (c ^ p * b) = b := by
        rw [← mul_assoc, hξ_pow_cancel p le_rfl, Nat.sub_self, pow_zero, one_mul]
      have hnorm_w_M₁' :
          normLM F hM₁'K₁ w_m - (b + ξ_M₁' - ξ_M₁' * s) =
            (ξ_M₁' ^ p - ξ_M₁') +
              ∑ i ∈ Finset.Icc 1 (p - 2), ξ_M₁' ^ (p - i) * e_Δ i := by
        have hpoly : normLM F hM₁'K₁ w_m =
            ξ_M₁' ^ p * (1 + (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e_Δ i) + c ^ p * b) := by
          rw [hw_factor, map_mul, hnorm_incl_M₁'K₁ ξ_M₁', he_Δ_poly c]
        have hs_eq : s = - e_Δ (p - 1) := rfl
        linear_combination hpoly + hsum_scale + hsum_peel_Icc + htop_scale + ξ_M₁' * hs_eq
      have hnorm_w_K₁ :
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w_m) -
            (IntermediateField.inclusion hM₁'K₁ b + ξ m -
              ξ m * IntermediateField.inclusion hM₁'K₁ s) =
          ((ξ m) ^ p - ξ m) +
            IntermediateField.inclusion hM₁'K₁
              (∑ i ∈ Finset.Icc 1 (p - 2), ξ_M₁' ^ (p - i) * e_Δ i) := by
        have h1 := congrArg (IntermediateField.inclusion hM₁'K₁) hnorm_w_M₁'
        simp only [map_sub, map_add, map_mul, map_pow, ← hξ_incl] at h1
        exact h1
      have h_piece1 : (ξ m) ^ p - ξ m = 0 ∨ B₃ ≤ valL F K₁ ((ξ m) ^ p - ξ m) :=
        hvalK₁_mono B₃ ((4 * p * p * m₁ : ℕ) : ℤ) _ hB₃_le_as1 hξ_as
      set M₃ : ℤ := (((p - 1) * t₂ - (p - 2) * t₁ : ℕ) : ℤ)
      have hM₃_eq : M₃ = ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by
        dsimp [M₃]
        rw [Nat.cast_sub hB₃_sub_le]
        push_cast; ring
      have hsum_M₁' :
          (∑ i ∈ Finset.Icc 1 (p - 2), ξ_M₁' ^ (p - i) * e_Δ i) = 0 ∨
            M₃ ≤ valL F M₁' (∑ i ∈ Finset.Icc 1 (p - 2), ξ_M₁' ^ (p - i) * e_Δ i) := by
        apply hvalM₁'_sum_ge (Finset.Icc 1 (p - 2)) _ M₃
        intro i hi
        obtain ⟨hi_ge1, hi_le⟩ := Finset.mem_Icc.mp hi
        have hξ_pow := hvalM₁'_pow_ge ξ_M₁' (p - i) 0 (Or.inr (le_of_eq hξ_M₁'_val0.symm))
        have he_i := he_Δ_val i (Finset.mem_Icc.mpr ⟨hi_ge1, by omega⟩)
        have hmul := hvalM₁'_mul_ge (((p - i : ℕ) : ℤ) * 0)
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ))
          (ξ_M₁' ^ (p - i)) (e_Δ i) hξ_pow he_i
        apply hvalM₁'_mono M₃ _ _ _ hmul
        have hi_le_z : (i : ℤ) ≤ ((p - 2 : ℕ) : ℤ) := by exact_mod_cast hi_le
        have hit₁ : (i : ℤ) * (t₁ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) :=
          Int.mul_le_mul_of_nonneg_right hi_le_z (by positivity)
        rw [hM₃_eq]
        linarith
      have h_piece2 :
          IntermediateField.inclusion hM₁'K₁
              (∑ i ∈ Finset.Icc 1 (p - 2), ξ_M₁' ^ (p - i) * e_Δ i) = 0 ∨
            B₃ ≤ valL F K₁
              (IntermediateField.inclusion hM₁'K₁
                (∑ i ∈ Finset.Icc 1 (p - 2), ξ_M₁' ^ (p - i) * e_Δ i)) := by
        have h_incl := hval_incl_M₁'K₁_ge _ M₃ hsum_M₁'
        have hB₃_M₃ : B₃ = (p : ℤ) * M₃ := by dsimp [B₃, M₃]
        rwa [← hB₃_M₃] at h_incl
      rw [hnorm_w_K₁]
      exact hvalK₁_add B₃ _ _ h_piece1 h_piece2
    exact ⟨h_conj1, h_conj2, h_conj3⟩

theorem ld_ch12_wild_odd_tot_ram_galois_teichmuller_conj_trace_and_norm_approx (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLM₁' : IsGaloisExt F L M₁') (hGalE'K₁ : IsGaloisExt F E' K₁)
    (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_poly : ∀ c : M₁',
      normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * (Δ : K₁)) =
        1 + (∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          c ^ i * e_Δ i) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLE')) *
            normLM F hM₁'K₁ (Δ : K₁))
    (u : L) (w₂ : E'ˣ) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let s := - e_Δ (p - 1)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let n := u_M₁' * b
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let W_fn : ℕ → E' := fun i =>
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
    let Q_quad : E' :=
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
          (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
    ∃ (ξ Δ_conj : ℕ → K₁),
      ξ 0 = 0 ∧
      Δ_conj 0 = (Δ : K₁) ∧
      (∀ m < p, 0 < m →
        ξ m ≠ 0 ∧
        valL F K₁ (ξ m) = 0 ∧
        ((ξ m) ^ p - ξ m = 0 ∨
          ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m))) ∧
      (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
        (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
          (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
          ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
            valL F K₁
              ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
                (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0))) ∧
      (∀ m < p, Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -(t₁ : ℤ)) ∧
      (∀ i ∈ Finset.Icc 1 (p - 1),
        IntermediateField.inclusion hE'K₁ (W_fn i) =
          ∑ m ∈ Finset.range p,
            IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
              (Δ_conj m) ^ i *
              IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) *
              (IntermediateField.inclusion hM₁'K₁
                (1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)))⁻¹) ∧
      (IntermediateField.inclusion hE'K₁ Q_quad =
        ∑ m ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
            (Δ_conj m) ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁
              (normLM F hM₁'K₁ (Δ_conj m) *
                traceLM F hM₁'K₁
                  ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) *
                    Δ_conj m) ^ (p - 1))) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)) ^ 2))⁻¹) ∧
      (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1))) =
        ∑ m ∈ Finset.range p, (Δ_conj m) ^ (p - 1)) ∧
      (∀ m < p,
        (Δ_conj m - ((Δ : K₁) + ξ m) = 0 ∨
          ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ) ≤
            valL F K₁ (Δ_conj m - ((Δ : K₁) + ξ m))) ∧
        ((Δ_conj m - ((Δ : K₁) + ξ m)) -
            ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m = 0 ∨
          ((p * (p - 1) * t₂ - (p - 2) * t₁ : ℕ) : ℤ) ≤
            valL F K₁
              ((Δ_conj m - ((Δ : K₁) + ξ m)) -
                ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m)) ∧
        (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) = 0 ∨
          ((p * (t₂ + 1) : ℕ) : ℤ) ≤
            valL F K₁
              (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
                IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)))) ∧
        (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
            (IntermediateField.inclusion hM₁'K₁ b + ξ m -
              ξ m * IntermediateField.inclusion hM₁'K₁ s) = 0 ∨
          ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤
            valL F K₁
              (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
                (IntermediateField.inclusion hM₁'K₁ b + ξ m -
                  ξ m * IntermediateField.inclusion hM₁'K₁ s)))) :=
by
  intro p t₁ t₂ m₁ b s z u_M₁' n T W_fn Q_quad
  have hp_odd' : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2 :=
    hWild.symm ▸ hp_odd
  have hp_odd_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) ≠ 2 :=
    hdegM₁'K₁.symm ▸ hp_odd'
  have hPrime_M₁'K₁ : Nat.Prime (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) :=
    hdegM₁'K₁.symm ▸ hPrime
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  have hval_M₁'K₁' : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) * valL F M₁' z := by
    intro z
    rw [hdegM₁'K₁]
    exact hval_M₁'K₁ z
  let T_jump : ℕ := (bM₁' - 1) + p * (bE' - bM₁') + 1
  have hT_ge1 : 1 ≤ T_jump := Nat.le_add_left 1 _
  have htr_M₁'K₁' : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) * m -
          ((Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) - 1 : ℕ) : ℤ) *
            (T_jump : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)) := by
    intro m w hw
    rw [hdegM₁'K₁] at hw
