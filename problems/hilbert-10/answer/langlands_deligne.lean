          rw [hsub_eq, hd0, mul_zero]
        · right
          rw [hsub_eq]
          have hneg_ne0 : -(c'_θ i : F_i) ≠ 0 := neg_ne_zero.mpr (Units.ne_zero (c'_θ i))
          rw [hval_mul_Fi (-(c'_θ i : F_i)) d hneg_ne0 hd0, hval_neg_Fi, hc_θ_val]
          change (1 : ℤ) ≤ ((m₀ + 1 : ℕ) : ℤ) + n_Fi + valL F F_i d
          omega

    refine ⟨fun hle => ⟨fun i => ?_, fun hsub i => ?_⟩, fun hsuper => ⟨fun i => ?_, fun i => ?_⟩⟩
    · have hm₀_eq : max t (k * (a - 1)) = t := max_eq_left hle
      have h1 := (hFi_ultrametric i).1
      rw [hm₀_eq] at h1
      exact h1
    · set F_i := (D_orb.get i).field
      haveI : FiniteDimensional F F_i := hFinFi i
      set ψ_Fi := traceChar F (D_orb.get i).le ψ
      set n_Fi := condExpChar F F_i ψ_Fi
      obtain ⟨_, _, _, _, _, hval_inv_Fi, _, hval_add_Fi, _, _, _⟩ := hval_all F_i
      have hm₀_eq : max t (k * (a - 1)) = t := max_eq_left hle
      obtain ⟨hc_i_eq, hΔ_val⟩ := hFi_ultrametric i
      rw [hm₀_eq] at hc_i_eq hΔ_val
      have hc_θ_val : valL F F_i (c'_θ i : F_i) = ((t + 1 : ℕ) : ℤ) + n_Fi := by
        rw [(hc_orb i).2.2.2.2.1, hc_i_eq]
      have hχ_inv_val : -((t : ℤ) + n_Fi) ≤ valL F F_i (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i) := by
        rw [hval_inv_Fi (c'_χ'_Fi i)]
        have hval_χ := hc'_χ'_Fi_val_Fi i
