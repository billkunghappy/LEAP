  let PFi (i : Fin D_orb.length) (m : ℤ) (y : (D_orb.get i).field) : Prop :=
    y = 0 ∨ m ≤ valL F (D_orb.get i).field y

  have hPFi_zero : ∀ (i : Fin D_orb.length) (m : ℤ), PFi i m 0 := fun _ _ => Or.inl rfl
  have hPFi_one : ∀ i : Fin D_orb.length, PFi i 0 1 := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    right
    rw [(ld_valL_and_unitGroup_props F (D_orb.get i).field).2.1]
  have hPFi_neg : ∀ {i : Fin D_orb.length} {m : ℤ} {y : (D_orb.get i).field},
