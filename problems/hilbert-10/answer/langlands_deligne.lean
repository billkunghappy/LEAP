      rw [Fin.sum_univ_castSucc] at hd
      have hinit_wt : (∑ i : Fin v, (d i.castSucc : ℕ)) = wt v (Ψ_v d) := rfl
      rw [hinit_wt] at hd
      have hd_last_lt : (d (Fin.last v) : ℕ) < p := (d (Fin.last v)).2
