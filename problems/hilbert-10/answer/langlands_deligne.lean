    Nat.sInf_mem ⟨m₂, h_mem_E'⟩

  let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  have hm₁_triv0 := (hχ₁_twists 0 hp_pos).2.1
  have hm₁_triv1 := (hχ₁_twists 1 hp_gt1).2.1
