                (hLemma18_2 M₁ hLM₁ (hM₁K₁.trans hK₁K) hGalLM₁ hlt_LM₁)
      exact hInfCase (E ⊓ M) (le_inf hLE hLM) inf_le_left inf_le_right le_rfl
  have hListDescent : ∀ (L₀ : List (MonomialTerm F L)),
      (∀ t ∈ L₀, t.Wf F L) →
      (∀ t ∈ L₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = χK) →
      ∃ D_M : List (MonomialTerm F L),
        IsMonomialDecomp F L (fun w => monomialListTrace F L L₀ w) D_M ∧
        (∀ s ∈ D_M, s.field ≤ M) ∧
        evalMonomialList F rec (fun _ E _ => f E) L ψ L₀ =
          evalMonomialList F rec (fun _ E _ => f E) L ψ D_M := by
    intro L₀ hWf hHom
    induction L₀ with
    | nil =>
      refine ⟨[], ⟨by simp, fun w => rfl⟩, by simp, rfl⟩
    | cons t tl ih =>
      have ht_wf : t.Wf F L := hWf t List.mem_cons_self
      obtain ⟨htK, ht_rest⟩ := hHom t List.mem_cons_self
      have htl_wf : ∀ t' ∈ tl, t'.Wf F L :=
        fun t' ht' => hWf t' (List.mem_cons_of_mem t ht')
      have htl_hom : ∀ t' ∈ tl, ∃ htK : t'.field ≤ K, restrictWeilChar F htK t'.χ = χK :=
        fun t' ht' => hHom t' (List.mem_cons_of_mem t ht')
      obtain ⟨D_tl, hD_tl_decomp, hD_tl_M, heval_tl⟩ := ih htl_wf htl_hom
      have ht1_wf : (⟨1, t.field, t.le, t.χ⟩ : MonomialTerm F L).Wf F L := ht_wf
      obtain ⟨D_E, hD_E_decomp, hD_E_M, heval_E⟩ :=
        hTermDescent t.field t.le htK t.χ ht1_wf ht_rest
      let D_t : List (MonomialTerm F L) := D_E.map (scaleMonomialTerm F L t.coeff)
      refine ⟨D_t ++ D_tl, ⟨?_, ?_⟩, ?_, ?_⟩
      · intro s hs
        rw [List.mem_append] at hs
        rcases hs with hs | hs
        · rw [List.mem_map] at hs
          rcases hs with ⟨s₀, hs₀, rfl⟩
          exact hD_E_decomp.1 s₀ hs₀
        · exact hD_tl_decomp.1 s hs
      · intro w
        have hcons_tr : monomialListTrace F L (t :: tl) w =
            t.trace F L w + monomialListTrace F L tl w := by
          simp [monomialListTrace]
        have ht_tr : t.trace F L w =
            t.coeff • (⟨1, t.field, t.le, t.χ⟩ : MonomialTerm F L).trace F L w := by
          simp [MonomialTerm.trace]
