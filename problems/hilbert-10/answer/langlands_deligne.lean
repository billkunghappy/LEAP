    have hqw_val : q_w = 0 ∨ (d_E : ℤ) ≤ valL F K₁ q_w := by
      simpa only [zero_add] using
        hval_mul_bound_K₁ 0 (d_E : ℤ) (2 : K₁)⁻¹ (2 * w - w ^ 2)
