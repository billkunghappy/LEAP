        normLM F hM_CK (IntermediateField.inclusion hM_CK z) = z ^ ℓ := by
      intro z
      change Algebra.norm M_C (algebraMap M_C K_MC' z) = z ^ ℓ
      exact Algebra.norm_algebraMap z
    haveI : Fact (Nat.Prime ℓ) := ⟨hPrime_MCK⟩
    have hℓ_pos : 0 < ℓ := hPrime_MCK.pos
    have hℓ_int_ne : (ℓ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hℓ_pos)
