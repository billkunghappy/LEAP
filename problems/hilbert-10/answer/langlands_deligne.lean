        Lagrange.eval_interpolate_at_node y_node hx_inj.injOn (Finset.mem_univ d)]
    rw [h1, h2]
  have hPM_eq_QM : P_M = Q_M :=
    sub_eq_zero.mp
      (Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero
        (P_M - Q_M) hv_inj hDiff_eval hDiff_deg_lt)
  have hP_α_coeff : ∀ N : ℕ, ∃ c_N : k_L,
      (∏ j : Fin (q - 1), (Polynomial.X - Polynomial.C (u_ϖ_bar * β j))).coeff N =
        ι_res c_N := by
    intro N
    have hcoeff_eq : P_M.coeff N = IntermediateField.inclusion hLM_C (Q_L.coeff N) := by
      rw [hPM_eq_QM]
      exact Polynomial.coeff_map (IntermediateField.inclusion hLM_C).toRingHom N
    have hPM_c_int : PM (P_M.coeff N) := (hP_s_res Finset.univ N).1
    have hQL_c_int : Q_L.coeff N = 0 ∨ 0 ≤ valL F L (Q_L.coeff N) := by
      rcases hPM_c_int with h0 | hge0
      · left
        apply (IntermediateField.inclusion hLM_C).injective
        change IntermediateField.inclusion hLM_C (Q_L.coeff N) = 0
        rw [← hcoeff_eq, h0]
      · right
        rw [hcoeff_eq, hValAlgMCL (Q_L.coeff N)] at hge0
        have hk_pos : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
        nlinarith
    refine ⟨resL (Q_L.coeff N), ?_⟩
    rw [← (hP_s_res Finset.univ N).2, hcoeff_eq, hι_res (Q_L.coeff N) hQL_c_int]
  refine ⟨hu_ϖ_val, hu_ϖ_ne, hP_α_coeff, ?_⟩
  intro v_θ hv_θ
  let w_θ : Fin (q - 1) → M_Cˣ := fun j =>
    Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
      (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
        (v_θ (idx_all j)))
  have hw_θ_val : ∀ j : Fin (q - 1), valL F M_C ((w_θ j : M_Cˣ) : M_C) = 0 := by
    intro j
    dsimp only [w_θ]
    change valL F M_C ((σ_all j).symm
      (IntermediateField.inclusion (hFiMC (idx_all j)) (v_θ (idx_all j) : _))) = 0
    rw [hσ_symm_val j, hValAlgFiMC (idx_all j), (hv_θ (idx_all j)).1]
  have hw_θ_eq : ∀ j : Fin (q - 1),
      ((w_θ j : M_Cˣ) : M_C) = 1 + (((α_tilde j)⁻¹ : M_Cˣ) : M_C) := by
    intro j
    have hv_eq := (hv_θ (idx_all j)).2
    dsimp only [w_θ, α_tilde]
    change (σ_all j).symm
        (IntermediateField.inclusion (hFiMC (idx_all j)) (v_θ (idx_all j) : _)) =
      1 + (σ_all j).symm
        (IntermediateField.inclusion (hFiMC (idx_all j)) (((α_orb (idx_all j))⁻¹ : _) : _))
    rw [hv_eq, map_add, map_one, map_add, map_one]
  have hα_tilde_inv_val : ∀ j : Fin (q - 1),
      valL F M_C ((((α_tilde j)⁻¹ : M_Cˣ) : M_C)) = 0 := by
    intro j
    rw [hvalMC.2.2.2.2.2.1 (α_tilde j), hα_tilde_val j, neg_zero]
  have hα_tilde_inv_res : ∀ j : Fin (q - 1),
      resM ((((α_tilde j)⁻¹ : M_Cˣ) : M_C)) = (u_ϖ_bar * β j)⁻¹ := by
    intro j
    have hmul1 : (((α_tilde j)⁻¹ : M_Cˣ) : M_C) * ((α_tilde j : M_Cˣ) : M_C) = 1 :=
      Units.inv_mul (α_tilde j)
    have hres_mul : resM ((((α_tilde j)⁻¹ : M_Cˣ) : M_C)) * (u_ϖ_bar * β j) = 1 := by
      rw [← hα_tilde_res j,
        ← (hresM_ring _ _
          (Or.inr (le_of_eq (hα_tilde_inv_val j).symm))
          (Or.inr (le_of_eq (hα_tilde_val j).symm))).2.1,
        hmul1, hresM_1]
    exact eq_inv_of_mul_eq_one_left hres_mul
  have hw_θ_res : ∀ j : Fin (q - 1),
      resM ((w_θ j : M_Cˣ) : M_C) = 1 + (u_ϖ_bar * β j)⁻¹ := by
    intro j
    rw [hw_θ_eq j,
      (hresM_ring 1 _ hPM_1 (Or.inr (le_of_eq (hα_tilde_inv_val j).symm))).1,
      hresM_1, hα_tilde_inv_res j]
  have hw_prod_spec : ∀ s : Finset (Fin (q - 1)),
      valL F M_C (((∏ j ∈ s, w_θ j : M_Cˣ) : M_C)) = 0 ∧
      resM (((∏ j ∈ s, w_θ j : M_Cˣ) : M_C)) = ∏ j ∈ s, (1 + (u_ϖ_bar * β j)⁻¹) := by
    intro s
    induction s using Finset.cons_induction with
    | empty =>
      rw [Finset.prod_empty, Finset.prod_empty, Units.val_one]
      exact ⟨hvalMC.2.1, hresM_1⟩
    | cons j s hj ih =>
      rw [Finset.prod_cons, Finset.prod_cons, Units.val_mul]
      have hval_prod : valL F M_C ((w_θ j : M_C) * ((∏ i ∈ s, w_θ i : M_Cˣ) : M_C)) = 0 := by
        rw [hvalMC.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
          hw_θ_val j, ih.1, add_zero]
      refine ⟨hval_prod, ?_⟩
      rw [(hresM_ring (w_θ j : M_C) ((∏ i ∈ s, w_θ i : M_Cˣ) : M_C)
        (Or.inr (le_of_eq (hw_θ_val j).symm))
        (Or.inr (le_of_eq ih.1.symm))).2.1,
        hw_θ_res j, ih.2]
  let U_θ : Lˣ := ∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (v_θ i)
  have hU_θ_eq_prod :
      Units.map (IntermediateField.inclusion hLM_C).toMonoidHom U_θ =
        ∏ j : Fin (q - 1), w_θ j :=
    (hν_prod v_θ).symm
  have hinc_U_val : valL F M_C (IntermediateField.inclusion hLM_C (U_θ : L)) = 0 := by
    have h := congrArg (fun u : M_Cˣ => valL F M_C (u : M_C)) hU_θ_eq_prod
    simpa using h.trans (hw_prod_spec Finset.univ).1
  have hU_θ_val : valL F L (U_θ : L) = 0 := by
    have h := hValAlgMCL (U_θ : L)
    rw [hinc_U_val] at h
    have hk_pos : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
    nlinarith
  have hU_θ_res : ι_res (resL (U_θ : L)) = ∏ j : Fin (q - 1), (1 + (u_ϖ_bar * β j)⁻¹) := by
    rw [← hι_res (U_θ : L) (Or.inr (le_of_eq hU_θ_val.symm))]
    have h := congrArg (fun u : M_Cˣ => resM (u : M_C)) hU_θ_eq_prod
    simpa using h.trans (hw_prod_spec Finset.univ).2
  exact ⟨hU_θ_val, hU_θ_res⟩

theorem ld_ch14_finite_field_critical_polynomial_vieta_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L : Type u) [Field k_L] [Fintype k_L]
    (k_M : Type u) [Field k_M] [Fintype k_M]
    (ι_res : k_L →+* k_M)
    (p r_exp q : ℕ) (hp : Nat.Prime p) (hr_exp_pos : 1 ≤ r_exp) (hq_pow : q = p ^ r_exp)
    (hchar_L : (p : k_L) = 0) (hchar_M : (p : k_M) = 0)
    (ψ_L : k_L → Ω F)
    (hψL_0 : ψ_L 0 = 1)
    (hψL_add : ∀ a₁ a₂ : k_L, ψ_L (a₁ + a₂) = ψ_L a₁ * ψ_L a₂)
    (hψL_ne : ∃ a₀ : k_L, ψ_L a₀ ≠ 1)
    (ψ_M : k_M → Ω F)
    (hψM_0 : ψ_M 0 = 1)
    (hψM_add : ∀ w₁ w₂ : k_M, ψ_M (w₁ + w₂) = ψ_M w₁ * ψ_M w₂)
    (hψM_ne : ∃ w₀ : k_M, ψ_M w₀ ≠ 1)
    (α_L : k_L) (hαL_ne : α_L ≠ 0)
    (hαL_frob : ∀ b : k_L, ψ_L (α_L * b) = ψ_L (b ^ q))
    (hFrob_lift : ∀ (n : ℕ) (γ_L : k_L),
      (∀ b : k_L, ψ_L (γ_L * b ^ (p ^ n)) = ψ_L b) →
      ∀ w : k_M, ψ_M (ι_res γ_L * w ^ (p ^ n)) = ψ_M w)
    (a_bar : Fin r_exp → k_M) (ha0_ne : a_bar ⟨0, hr_exp_pos⟩ ≠ 0)
    (β : Fin (q - 1) → k_M)
    (hβ_inj : Function.Injective β)
    (hβ_ne : ∀ j : Fin (q - 1), β j ≠ 0)
    (hβ_P : ∀ j : Fin (q - 1), ∀ z : k_M,
      ψ_M (β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ (p ^ (m : ℕ))))) = 1)
    (u_ϖ_bar z_η_bar : k_M) (hu_ϖ_ne : u_ϖ_bar ≠ 0) (hz_η_pow : z_η_bar ^ q = u_ϖ_bar)
    (hP_α_coeff : ∀ N : ℕ, ∃ c_N : k_L,
      (∏ j : Fin (q - 1), (Polynomial.X - Polynomial.C (u_ϖ_bar * β j))).coeff N =
        ι_res c_N)
    (U_θ_bar x₀_bar s₀_bar : k_L)
    (hU_θ_prod : ι_res U_θ_bar = ∏ j : Fin (q - 1), (1 + (u_ϖ_bar * β j)⁻¹))
    (hs₀_eq : ι_res s₀_bar * u_ϖ_bar =
      (ι_res x₀_bar * z_η_bar) ^ q +
        ∑ m : Fin r_exp, a_bar m * (ι_res x₀_bar * z_η_bar) ^ (p ^ (m : ℕ))) :
    ψ_L s₀_bar = ψ_L (U_θ_bar * x₀_bar ^ q) :=
by
  suffices h_gen : ∀ (R : Type) [Field R] [CharZero R]
      (ψ_L : k_L → R) (ψ_M : k_M → R),
      ψ_L 0 = 1 →
      (∀ a₁ a₂ : k_L, ψ_L (a₁ + a₂) = ψ_L a₁ * ψ_L a₂) →
      (∃ a₀ : k_L, ψ_L a₀ ≠ 1) →
      ψ_M 0 = 1 →
      (∀ w₁ w₂ : k_M, ψ_M (w₁ + w₂) = ψ_M w₁ * ψ_M w₂) →
      (∃ w₀ : k_M, ψ_M w₀ ≠ 1) →
      (∀ b : k_L, ψ_L (α_L * b) = ψ_L (b ^ q)) →
      (∀ (n : ℕ) (γ_L : k_L),
        (∀ b : k_L, ψ_L (γ_L * b ^ (p ^ n)) = ψ_L b) →
        ∀ w : k_M, ψ_M (ι_res γ_L * w ^ (p ^ n)) = ψ_M w) →
      (∀ j : Fin (q - 1), ∀ z : k_M,
        ψ_M (β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ (p ^ (m : ℕ))))) = 1) →
      ψ_L s₀_bar = ψ_L (U_θ_bar * x₀_bar ^ q) by
    exact h_gen (Ω F) ψ_L ψ_M hψL_0 hψL_add hψL_ne hψM_0 hψM_add hψM_ne
      hαL_frob hFrob_lift hβ_P
  clear * - hp hr_exp_pos hq_pow hchar_L hchar_M hαL_ne ha0_ne hβ_inj hβ_ne
    hu_ϖ_ne hz_η_pow hP_α_coeff hU_θ_prod hs₀_eq
  intro R _ _ ψ_L ψ_M hψL_0 hψL_add hψL_ne hψM_0 hψM_add hψM_ne
    hαL_frob hFrob_lift hβ_P
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  have hring_L : ringChar k_L = p := by
    have hdvd : ringChar k_L ∣ p := (ringChar.spec k_L p).mp hchar_L
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | h_eq
    · exfalso
      have h0 : ((1 : ℕ) : k_L) = 0 := (ringChar.spec k_L 1).mpr (h1 ▸ dvd_refl _)
      rw [Nat.cast_one] at h0
      exact one_ne_zero h0
    · exact h_eq
  haveI : CharP k_L p := CharP.mk (fun x => by rw [← hring_L]; exact ringChar.spec k_L x)
  have hring_M : ringChar k_M = p := by
    have hdvd : ringChar k_M ∣ p := (ringChar.spec k_M p).mp hchar_M
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | h_eq
    · exfalso
      have h0 : ((1 : ℕ) : k_M) = 0 := (ringChar.spec k_M 1).mpr (h1 ▸ dvd_refl _)
      rw [Nat.cast_one] at h0
      exact one_ne_zero h0
    · exact h_eq
  haveI : CharP k_M p := CharP.mk (fun x => by rw [← hring_M]; exact ringChar.spec k_M x)
  have hfrobL_zero : ∀ n : ℕ, (0 : k_L) ^ (p ^ n) = 0 :=
    fun n => zero_pow (pow_ne_zero n hp.ne_zero)
  have hfrobL_add : ∀ (n : ℕ) (x y : k_L), (x + y) ^ (p ^ n) = x ^ (p ^ n) + y ^ (p ^ n) :=
    fun n x y => add_pow_char_pow x y p n
  have hfrobL_inj : ∀ n : ℕ, Function.Injective (fun x : k_L => x ^ (p ^ n)) := by
    intro n x y hxy
    dsimp at hxy
    have hsub : (x - y) ^ (p ^ n) + y ^ (p ^ n) = y ^ (p ^ n) := by
      rw [← hfrobL_add n (x - y) y, sub_add_cancel, hxy]
    have hsub0 : (x - y) ^ (p ^ n) = 0 := by linear_combination hsub
    exact sub_eq_zero.mp (pow_eq_zero hsub0)
  have hfrobL_surj : ∀ n : ℕ, Function.Surjective (fun x : k_L => x ^ (p ^ n)) :=
    fun n => ((Fintype.bijective_iff_injective_and_card (fun x : k_L => x ^ (p ^ n))).mpr
      ⟨hfrobL_inj n, rfl⟩).2
  have hfrobM_inj : ∀ n : ℕ, Function.Injective (fun x : k_M => x ^ (p ^ n)) := by
    intro n x y hxy
    dsimp at hxy
    have hsub : (x - y) ^ (p ^ n) + y ^ (p ^ n) = y ^ (p ^ n) := by
      rw [← add_pow_char_pow (x - y) y p n, sub_add_cancel, hxy]
    have hsub0 : (x - y) ^ (p ^ n) = 0 := by linear_combination hsub
    exact sub_eq_zero.mp (pow_eq_zero hsub0)
  have hfrobM_surj : ∀ n : ℕ, Function.Surjective (fun x : k_M => x ^ (p ^ n)) :=
    fun n => ((Fintype.bijective_iff_injective_and_card (fun x : k_M => x ^ (p ^ n))).mpr
      ⟨hfrobM_inj n, rfl⟩).2
  have h_frob_mem_range : ∀ (n : ℕ) (w : k_M) (b : k_L),
      w ^ (p ^ n) = ι_res b → ∃ c : k_L, w = ι_res c := by
    intro n w b hwb
    obtain ⟨c, hc⟩ := hfrobL_surj n b
    refine ⟨c, hfrobM_inj n ?_⟩
    dsimp
    rw [hwb, ← hc, map_pow]
  have hψL_mul_neg : ∀ b : k_L, ψ_L b * ψ_L (-b) = 1 := by
    intro b
    rw [← hψL_add, add_neg_cancel, hψL_0]
  have hψL_sum : ∀ (s : Finset (Fin r_exp)) (f : Fin r_exp → k_L),
      ψ_L (∑ i ∈ s, f i) = ∏ i ∈ s, ψ_L (f i) := by
    intro s f
    induction s using Finset.cons_induction with
    | empty => simp [hψL_0]
    | cons a s ha ih => rw [Finset.sum_cons, hψL_add, Finset.prod_cons, ih]
  have hψM_sum : ∀ (s : Finset (Fin r_exp)) (f : Fin r_exp → k_M),
      ψ_M (∑ i ∈ s, f i) = ∏ i ∈ s, ψ_M (f i) := by
    intro s f
    induction s using Finset.cons_induction with
    | empty => simp [hψM_0]
    | cons a s ha ih => rw [Finset.sum_cons, hψM_add, Finset.prod_cons, ih]
  obtain ⟨a₀, ha₀⟩ := hψL_ne
  have h_orth_L : ∀ b : k_L, b ≠ 0 → (∑ c : k_L, ψ_L (- c * b)) = 0 := by
    intro b hb
    have hshift : (∑ c : k_L, ψ_L (- c * b)) = (∑ c : k_L, ψ_L (- c * b)) * ψ_L a₀ := by
      conv_lhs =>
        rw [← Fintype.sum_equiv (Equiv.addRight (- b⁻¹ * a₀)) _ _ (fun _ => rfl)]
      have hterm : ∀ c : k_L, ψ_L (- (c + (- b⁻¹ * a₀)) * b) = ψ_L (- c * b) * ψ_L a₀ := by
        intro c
        have hcb : - (c + (- b⁻¹ * a₀)) * b = - c * b + a₀ := by
          calc - (c + (- b⁻¹ * a₀)) * b
              = - c * b + (b * b⁻¹) * a₀ := by ring
            _ = - c * b + a₀ := by rw [mul_inv_cancel₀ hb, one_mul]
        rw [hcb, hψL_add]
      simp_rw [Equiv.coe_addRight, hterm, ← Finset.sum_mul]
    have hzero : (∑ c : k_L, ψ_L (- c * b)) * (ψ_L a₀ - 1) = 0 := by
      linear_combination -hshift
    exact (mul_eq_zero.mp hzero).resolve_right (sub_ne_zero.mpr ha₀)
  obtain ⟨w₀, hw₀⟩ := hψM_ne
  have hψM_triv_imp_zero : ∀ c : k_M, (∀ u : k_M, ψ_M (c * u) = 1) → c = 0 := by
    intro c hc
    by_contra hc_ne
    have h1 : ψ_M (c * (c⁻¹ * w₀)) = 1 := hc (c⁻¹ * w₀)
    rw [← mul_assoc, mul_inv_cancel₀ hc_ne, one_mul] at h1
    exact hw₀ h1
  have h_frob_dual_L : ∀ n : ℕ,
      ∃ γ_n : k_L, γ_n ≠ 0 ∧ ∀ b : k_L, ψ_L (γ_n * b ^ (p ^ n)) = ψ_L b := by
    intro n
    let g : k_L → R := fun b => ψ_L (b ^ (p ^ n))
    have hg_0 : g 0 = 1 := by dsimp [g]; rw [hfrobL_zero n, hψL_0]
    have hg_add : ∀ x y : k_L, g (x + y) = g x * g y := by
      intro x y; dsimp [g]; rw [hfrobL_add n x y, hψL_add]
    let S : k_L → R := fun c => ∑ b : k_L, g b * ψ_L (- c * b)
    have h_sum_S : (∑ c : k_L, S c) = (Fintype.card k_L : R) := by
      dsimp only [S]
      rw [Finset.sum_comm]
      have h_inner : ∀ b : k_L,
          (∑ c : k_L, g b * ψ_L (- c * b)) = g b * ∑ c : k_L, ψ_L (- c * b) :=
        fun b => (Finset.mul_sum Finset.univ (fun c => ψ_L (- c * b)) (g b)).symm
      simp_rw [h_inner]
      rw [Finset.sum_eq_single (0 : k_L)]
      · simp [hg_0, hψL_0]
      · intro b _ hb
        rw [h_orth_L b hb, mul_zero]
      · intro h0
        exact False.elim (h0 (Finset.mem_univ 0))
    have h_sum_ne : (∑ c : k_L, S c) ≠ 0 := by
      rw [h_sum_S]
      exact Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    obtain ⟨δ, _, hSδ⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_sum_ne
    have hδ_eq : ∀ u : k_L, ψ_L (u ^ (p ^ n)) = ψ_L (δ * u) := by
      intro u
      have hS_shift : S δ = S δ * (g u * ψ_L (- δ * u)) := by
        dsimp only [S]
        conv_lhs =>
          rw [← Fintype.sum_equiv (Equiv.addRight u) _ _ (fun _ => rfl)]
        have hterm : ∀ b : k_L,
            g (b + u) * ψ_L (- δ * (b + u)) =
              (g b * ψ_L (- δ * b)) * (g u * ψ_L (- δ * u)) := by
          intro b
          have hδu : - δ * (b + u) = - δ * b + (- δ * u) := by ring
          rw [hg_add b u, hδu, hψL_add]
          ring
        simp_rw [Equiv.coe_addRight, hterm, ← Finset.sum_mul]
      have h_factor_zero : S δ * (g u * ψ_L (- δ * u) - 1) = 0 := by
        linear_combination -hS_shift
      have h_prod_one : g u * ψ_L (- δ * u) = 1 :=
        sub_eq_zero.mp ((mul_eq_zero.mp h_factor_zero).resolve_left hSδ)
      dsimp only [g] at h_prod_one
      calc ψ_L (u ^ (p ^ n))
          = ψ_L (u ^ (p ^ n)) * (ψ_L (δ * u) * ψ_L (- (δ * u))) := by
            rw [hψL_mul_neg (δ * u), mul_one]
        _ = (ψ_L (u ^ (p ^ n)) * ψ_L (- δ * u)) * ψ_L (δ * u) := by
            have hneg : - (δ * u) = - δ * u := by ring
            rw [hneg]; ring
        _ = ψ_L (δ * u) := by rw [h_prod_one, one_mul]
    have hδ_ne : δ ≠ 0 := by
      intro h0
      obtain ⟨u₀, hu₀⟩ := hfrobL_surj n a₀
      have h1 : ψ_L a₀ = 1 := by
        rw [← hu₀, hδ_eq u₀, h0, zero_mul, hψL_0]
      exact ha₀ h1
    refine ⟨(δ⁻¹) ^ (p ^ n), pow_ne_zero (p ^ n) (inv_ne_zero hδ_ne), fun b => ?_⟩
    calc ψ_L ((δ⁻¹) ^ (p ^ n) * b ^ (p ^ n))
        = ψ_L ((δ⁻¹ * b) ^ (p ^ n)) := by rw [← mul_pow]
      _ = ψ_L (δ * (δ⁻¹ * b)) := hδ_eq (δ⁻¹ * b)
      _ = ψ_L ((δ * δ⁻¹) * b) := by rw [← mul_assoc]
      _ = ψ_L b := by rw [mul_inv_cancel₀ hδ_ne, one_mul]
