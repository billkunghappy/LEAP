    have hpm₁_ge_p1t₂ : ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
      have hm₁_ge : t₂ ≤ m₁ := by
        have h : 1 * (bE' - bM₁') ≤ p * (bE' - bM₁') :=
          Nat.mul_le_mul_right (bE' - bM₁') (by omega : 1 ≤ p)
        omega
      have h1 : (p - 1) * t₂ ≤ p * m₁ := Nat.mul_le_mul (by omega) hm₁_ge
      have h_m1_le : m₁ ≤ 3 * p * m₁ + 1 := by
        calc m₁ = 1 * m₁ := (one_mul m₁).symm
          _ ≤ (3 * p) * m₁ := Nat.mul_le_mul_right m₁ (by omega : 1 ≤ 3 * p)
          _ ≤ 3 * p * m₁ + 1 := Nat.le_succ _
      have h2 : p * m₁ ≤ p * (3 * p * m₁ + 1) := Nat.mul_le_mul_left p h_m1_le
      have h3 : (((p - 1) * t₂ : ℕ) : ℤ) ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
        exact_mod_cast le_trans h1 h2
