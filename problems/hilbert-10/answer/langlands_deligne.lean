      exact h1.imp id (fun h => le_trans (by omega) h)
    have htr_cond_T :
        (2 * z - z ^ 2) - 2 * w = 0 ∨
          (p : ℤ) * (T : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ valL F B ((2 * z - z ^ 2) - 2 * w) := by
      have hp_sub1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by
        rw [Nat.cast_sub hp_ge1, Nat.cast_one]
      have hid : (p : ℤ) * (T : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) = (T : ℤ) := by
        rw [hp_sub1]; ring
      rw [hid]
      exact h2z_diff_T
    have hcong2 :
        traceLM F hAB (2 * z - z ^ 2) - 2 * traceLM F hAB w = 0 ∨
          (T : ℤ) ≤ valL F A (traceLM F hAB (2 * z - z ^ 2) - 2 * traceLM F hAB w) := by
      have htr_lin : traceLM F hAB ((2 * z - z ^ 2) - 2 * w) =
          traceLM F hAB (2 * z - z ^ 2) - 2 * traceLM F hAB w := by
        have h2w : (2 : B) * w = w + w := two_mul w
        have h2tr : (2 : A) * traceLM F hAB w = traceLM F hAB w + traceLM F hAB w := two_mul _
        rw [map_sub, h2w, map_add, h2tr]
      rw [← htr_lin]
      exact htr_bound_AB (T : ℤ) ((2 * z - z ^ 2) - 2 * w) htr_cond_T
    
    set δ_w : B := (w * w) * ((0 - t₂) - (t₂ * (t₂ * t₂)) * w)
    have hfactor2_int :
        (0 - t₂) - (t₂ * (t₂ * t₂)) * w = 0 ∨
          0 ≤ valL F B ((0 - t₂) - (t₂ * (t₂ * t₂)) * w) := by
      have h0_sub_t₂ : (0 : B) - t₂ = 0 ∨ 0 ≤ valL F B ((0 : B) - t₂) :=
        hval_sub (M := B) 0 0 t₂ (Or.inl rfl) ht₂_int
      have hcube_w : (t₂ * (t₂ * t₂)) * w = 0 ∨ 0 ≤ valL F B ((t₂ * (t₂ * t₂)) * w) := by
        simpa only [add_zero] using
          hval_mul_bound (M := B) 0 0 (t₂ * (t₂ * t₂)) w ht₂_cube_int hw_int
      exact hval_sub (M := B) 0 (0 - t₂) ((t₂ * (t₂ * t₂)) * w) h0_sub_t₂ hcube_w
    have hδ_val : δ_w = 0 ∨ m_c ≤ valL F B δ_w := by
      have h1 := hval_mul_bound (M := B) ((d₀ : ℤ) + (d₀ : ℤ)) 0
        (w * w) ((0 - t₂) - (t₂ * (t₂ * t₂)) * w) hw_sq_val hfactor2_int
      exact h1.imp id (fun h => le_trans (by omega) h)
    have hnorm_δ :
        normLM F hAB (1 + δ_w) - 1 = 0 ∨ m_c ≤ valL F A (normLM F hAB (1 + δ_w) - 1) :=
      hnorm_comp_AB hAB hval_norm_AB htr_bound_AB hq_norm_tr_AB δ_w hδ_val
    have hqz_id : q_z = w * (1 + δ_w) := by
      calc q_z
        _ = w * (1 + δ_w) + (w + t₂ * w ^ 2 - t₂ * w ^ 3) * ((2 : B) * t₂ - 1) := by
            dsimp [q_z, z, δ_w]; ring
        _ = w * (1 + δ_w) := by rw [h2_mul_t₂, sub_self, mul_zero, add_zero]
    have hnorm_w_val : normLM F hAB w = 0 ∨ (d₀ : ℤ) ≤ valL F A (normLM F hAB w) := by
      rcases hw with rfl | hw_ge
      · left
        change Algebra.norm A (toExtendScalars F hAB 0) = 0
        rw [map_zero, Algebra.norm_zero]
      · right; rw [hval_norm_AB]; exact hw_ge
    have hcong3 :
        2 * normLM F hAB q_z - 2 * normLM F hAB w = 0 ∨
          (T : ℤ) ≤ valL F A (2 * normLM F hAB q_z - 2 * normLM F hAB w) := by
      have hfac : 2 * normLM F hAB q_z - 2 * normLM F hAB w =
          (2 : A) * (normLM F hAB w * (normLM F hAB (1 + δ_w) - 1)) := by
        rw [hqz_id, map_mul]
        ring
      rw [hfac]
      have hprod_T :
          normLM F hAB w * (normLM F hAB (1 + δ_w) - 1) = 0 ∨
            (T : ℤ) ≤ valL F A (normLM F hAB w * (normLM F hAB (1 + δ_w) - 1)) := by
        have h1 := hval_mul_bound (M := A) (d₀ : ℤ) m_c
          (normLM F hAB w) (normLM F hAB (1 + δ_w) - 1) hnorm_w_val hnorm_δ
        exact h1.imp id (fun h => le_trans (by omega) h)
      simpa only [zero_add] using
        hval_mul_bound (M := A) 0 (T : ℤ) 2
          (normLM F hAB w * (normLM F hAB (1 + δ_w) - 1))
          (Or.inr (by rw [h2_A_val])) hprod_T
    
    have hcong23 :
        (traceLM F hAB (2 * z - z ^ 2) + 2 * normLM F hAB q_z) -
          (2 * traceLM F hAB w + 2 * normLM F hAB w) = 0 ∨
          (T : ℤ) ≤
            valL F A ((traceLM F hAB (2 * z - z ^ 2) + 2 * normLM F hAB q_z) -
              (2 * traceLM F hAB w + 2 * normLM F hAB w)) := by
      have hadd_eq :
          (traceLM F hAB (2 * z - z ^ 2) - 2 * traceLM F hAB w) +
            (2 * normLM F hAB q_z - 2 * normLM F hAB w) =
          (traceLM F hAB (2 * z - z ^ 2) + 2 * normLM F hAB q_z) -
            (2 * traceLM F hAB w + 2 * normLM F hAB w) := by ring
      simpa only [hadd_eq] using hval_add_A (T : ℤ) _ _ hcong2 hcong3
    have htotal_diff :
        (2 * u - u ^ 2) - (2 * traceLM F hAB w + 2 * normLM F hAB w) = 0 ∨
          (T : ℤ) ≤ valL F A ((2 * u - u ^ 2) - (2 * traceLM F hAB w + 2 * normLM F hAB w)) := by
      have hadd_eq :
          ((2 * u - u ^ 2) - (traceLM F hAB (2 * z - z ^ 2) + 2 * normLM F hAB q_z)) +
            ((traceLM F hAB (2 * z - z ^ 2) + 2 * normLM F hAB q_z) -
              (2 * traceLM F hAB w + 2 * normLM F hAB w)) =
          (2 * u - u ^ 2) - (2 * traceLM F hAB w + 2 * normLM F hAB w) := by ring
      simpa only [hadd_eq] using hval_add_A (T : ℤ) _ _ hcong1 hcong23
    have hchar_eq := hchar_cong A ψA hψA T c_A (2 * u - u ^ 2)
      (2 * traceLM F hAB w + 2 * normLM F hAB w) hc_A_val htotal_diff
    exact hchar_eq.symm.trans hψ_u
  
  
  
  have hc_ν_tr_norm_E' : ∀ w : E', (w = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLE' w + 2 * normLM F hLE' w)) = 1 :=
    hnorm_trace_vanish_AB hLE' ψ hψ hval_norm_LE' htr_bound_LE' hq_norm_tr_E'
      c_ν hc_ν_val hquad_vanish_E'
  have hc_ν_tr_norm_K₁ : ∀ w : K₁, (w = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F K₁ w) →
      ψM₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) *
        (2 * traceLM F hM₁'K₁ w + 2 * normLM F hM₁'K₁ w)) = 1 :=
    hnorm_trace_vanish_AB hM₁'K₁ ψM₁' hψM₁' hval_norm_M₁'K₁ htr_bound_M₁'K₁ hq_norm_tr_K₁
      c_νM hc_νM_val hquad_vanish_K₁
  have hnorm_M₁'K₁_half : ∀ (h' : ℕ) (w : K₁),
      (w = 0 ∨ (((T + p * h') / 2 : ℕ) : ℤ) ≤ valL F K₁ w) →
      normLM F hM₁'K₁ (1 + w) - 1 = 0 ∨
        (((T + h') / 2 : ℕ) : ℤ) ≤ valL F M₁' (normLM F hM₁'K₁ (1 + w) - 1) :=
    hnorm_half_AB hM₁'K₁ hval_norm_M₁'K₁ htr_bound_M₁'K₁ hq_norm_tr_K₁
  exact ⟨c_ν, hc_ν_val, hc_ν_stat_pow, hquad_LM₁',
    hc_ν_tr_norm_E', hc_ν_tr_norm_K₁, hnorm_M₁'K₁_half⟩

theorem ld_wild_odd_unramified_frob_descent_on_m1 (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hNonStable : condExp F M₁' θM₁' < 2 * condExp F L νE')
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (y₁ : M₁') (hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁') (j₀ : ℕ)
    (hσ₀_L : ∀ x : L,
      σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hσ₀_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
      ∏ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hFrobTwist : ∀ (r : ℕ) (z : M₁'ˣ),
      θM₁' (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z) =
        ((νE'.comp (Units.map (normLM F hLM₁'))) z) ^ (r * j₀) * θM₁' z)
    (c_U : M₁'ˣ)
    (hc_U_val : valL F M₁' (c_U : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc_U_stat : ∀ z : M₁',
      (z = 0 ∨ ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          (traceChar F hLM₁' ψ) (((c_U⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2)))
    (d : M₁') (hd_val : valL F M₁' d = 0)
    (hd_pow_frob :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let T := condExp F L νE'
      σ₀ (d ^ p) - d ^ p - 1 = 0 ∨
        ((T - T / 2 : ℕ) : ℤ) ≤ valL F M₁' (σ₀ (d ^ p) - d ^ p - 1))
    (c_ν : Lˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat_pow : ∀ u : L,
      (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ (2 * j₀) =
          (ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * u - u ^ 2)))⁻¹)
    (hquad_LM₁' : ∀ (m : ℕ), 1 ≤ m → ∀ z : M₁', (z = 0 ∨ (m : ℤ) ≤ valL F M₁' z) →
      let u_z := normLM F hLM₁' (1 + z) - 1
      (u_z = 0 ∨ (m : ℤ) ≤ valL F L u_z) ∧
      ((2 * u_z - u_z ^ 2) - traceLM F hLM₁' (2 * z - z ^ 2) = 0 ∨
        (3 * (m : ℤ)) ≤ valL F L ((2 * u_z - u_z ^ 2) - traceLM F hLM₁' (2 * z - z ^ 2)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let h := mM₁' - T
    let U₀ := IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')
    ∃ A_star : L,
      (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p) = 0 ∨
        ((T - mM₁' / 2 : ℕ) : ℤ) ≤
          valL F M₁' (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ p))) ∧
      (h = 0 → (A_star = 0 ∨ 0 ≤ valL F L A_star)) ∧
      (0 < h → A_star ≠ 0 ∧ valL F L A_star = -(h : ℤ)) :=
by
  
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set T := condExp F L νE'
  set mM₁' := condExp F M₁' θM₁'
  set h := mM₁' - T
  set d_U := mM₁' / 2
  set d₀ := T / 2
  set n := condExpChar F L ψ
  set ψM₁' := traceChar F hLM₁' ψ
  set U₀ := IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    _, hval_add_L, _, _, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
    _, hval_add_M₁', _, _, _⟩ := ld_valL_and_unitGroup_props F M₁'
  have hd_U_ge1 : 1 ≤ d_U := by omega
  have hd₀_le_d_U : d₀ ≤ d_U := by omega
  have hd_U_lt_T : d_U < T := by omega
  have hT_sub_d_U_ge1 : 1 ≤ T - d_U := by omega
  have hT_sub_le : T - d_U ≤ T - d₀ := by omega
  have hmM₁'_le_3d_U : mM₁' ≤ 3 * d_U := by omega
  have hT_le_3d_U : T ≤ 3 * d_U := by omega
  have htr_smul : ∀ (a : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a * z) = a * traceLM F hLM₁' z := by
    intro a z
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' a
      (toExtendScalars F hLM₁' z)
  have hincl_inj : Function.Injective (IntermediateField.inclusion hLM₁') :=
    (IntermediateField.inclusion hLM₁').injective
  have hincl_eq_zero : ∀ a : L, IntermediateField.inclusion hLM₁' a = 0 ↔ a = 0 :=
    fun a => map_eq_zero_iff (IntermediateField.inclusion hLM₁') hincl_inj
  have hmono_val : ∀ {k₁ k₂ : ℤ} {x : M₁'}, k₁ ≤ k₂ →
      (x = 0 ∨ k₂ ≤ valL F M₁' x) → (x = 0 ∨ k₁ ≤ valL F M₁' x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hmul_val_ge : ∀ (k₁ k₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hkx : k₁ ≤ valL F M₁' x := hx.resolve_left hx0
        have hky : k₂ ≤ valL F M₁' y := hy.resolve_left hy0
        rw [hval_mul_M₁' x y hx0 hy0]
        omega
  have hmul_int : ∀ (k : ℤ) (x y : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ 0 ≤ valL F M₁' y) →
      (x * y = 0 ∨ k ≤ valL F M₁' (x * y)) := by
    intro k x y hx hy
    simpa only [add_zero] using hmul_val_ge k 0 x y hx hy
  have hsub_val_ge : ∀ (k : ℤ) (x y : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
      (x - y = 0 ∨ k ≤ valL F M₁' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hval_add_M₁' k x (-y) hx
    rcases hy with rfl | hy
    · left; exact neg_zero
    · right; rwa [hval_neg_M₁']
  
  have hcondChar_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψM : AddChar M (Ω F)), IsAdmissibleChar F M ψM →
      (∀ x : M, (x = 0 ∨ -condExpChar F M ψM ≤ valL F M x) → ψM x = 1) ∧
      (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψM + 1) ≤ valL F M x₁ ∧ ψM x₁ ≠ 1) := by
    intro M _ ψM hψM
    set S : Set ℤ := {d : ℤ | ∀ x : M, -d ≤ valL F M x → ψM x = 1}
    have hne : S.Nonempty := by
      rcases hψM.2 with ⟨d₀, hd₀⟩
      refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
      omega
    have hbdd : BddAbove S := by
      have hne1 : ψM ≠ 1 := hψM.1
      rw [DFunLike.ne_iff] at hne1
      rcases hne1 with ⟨x₀, hx₀⟩
      rw [AddChar.one_apply] at hx₀
      refine ⟨-valL F M x₀ - 1, fun d hd => ?_⟩
      by_contra hlt
      have hge : -d ≤ valL F M x₀ := by omega
      exact hx₀ (hd x₀ hge)
    have hmem : condExpChar F M ψM ∈ S := Int.csSup_mem hne hbdd
    have htriv : ∀ x : M, (x = 0 ∨ -condExpChar F M ψM ≤ valL F M x) → ψM x = 1 := by
      intro x hx
      rcases hx with rfl | hx
      · exact AddChar.map_zero_eq_one ψM
      · exact hmem x hx
    have hnot : condExpChar F M ψM + 1 ∉ S :=
      notMem_of_csSup_lt (lt_add_one (condExpChar F M ψM)) hbdd
    change ¬ (∀ x : M, -(condExpChar F M ψM + 1) ≤ valL F M x → ψM x = 1) at hnot
    push_neg at hnot
    rcases hnot with ⟨x₁, hx₁_val, hx₁_ne⟩
    have hx₁_ne0 : x₁ ≠ 0 := by
      rintro rfl
      exact hx₁_ne (AddChar.map_zero_eq_one ψM)
    exact ⟨htriv, ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ne⟩⟩
  have hchar_cong : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψM : AddChar M (Ω F)), IsAdmissibleChar F M ψM →
      ∀ (m : ℕ) (c : Mˣ) (a b : M),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψM →
        (a - b = 0 ∨ (m : ℤ) ≤ valL F M (a - b)) →
        ψM (((c⁻¹ : Mˣ) : M) * a) = ψM (((c⁻¹ : Mˣ) : M) * b) := by
    intro M _ ψM hψM m c a b hc_val hab
    obtain ⟨_, _, _, _, hval_mul, hval_inv, _, _, _, _, _⟩ :=
      ld_valL_and_unitGroup_props F M
    have htriv := (hcondChar_props M ψM hψM).1
    have hsplit : ((c⁻¹ : Mˣ) : M) * a = ((c⁻¹ : Mˣ) : M) * (a - b) + ((c⁻¹ : Mˣ) : M) * b := by
      ring
    rw [hsplit, AddChar.map_add_eq_mul]
    suffices h1 : ψM (((c⁻¹ : Mˣ) : M) * (a - b)) = 1 by rw [h1, one_mul]
    apply htriv
    rcases hab with hab0 | hab_ge
    · left
      rw [hab0, mul_zero]
    · by_cases hab0 : a - b = 0
      · left
        rw [hab0, mul_zero]
      · right
        rw [hval_mul _ _ (Units.ne_zero c⁻¹) hab0, hval_inv c, hc_val]
        omega
  
  have hσ₀_comm : ∀ (k : ℕ) (a : M₁'), (σ₀ ^ k) (σ₀ a) = σ₀ ((σ₀ ^ k) a) := by
    intro k a
    change (σ₀ ^ k * σ₀) a = (σ₀ * σ₀ ^ k) a
    rw [← pow_succ, ← pow_succ']
  have hσ₀_pow_val : ∀ (k : ℕ) (a : M₁'), valL F M₁' ((σ₀ ^ k) a) = valL F M₁' a := by
    intro k a
    induction k with
    | zero => rfl
    | succ k ih =>
      change valL F M₁' ((σ₀ ^ (k + 1)) a) = valL F M₁' a
      rw [pow_succ']
      change valL F M₁' (σ₀ ((σ₀ ^ k) a)) = valL F M₁' a
      rw [hσ₀_val, ih]
  have hσ₀_tr_inv : ∀ a : M₁', traceLM F hLM₁' (σ₀ a) = traceLM F hLM₁' a := by
    intro a
    apply hincl_inj
    rw [hσ₀_tr (σ₀ a)]
    have hsum : (∑ k ∈ Finset.range p, (σ₀ ^ k) (σ₀ a)) =
