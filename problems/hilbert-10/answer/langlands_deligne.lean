        (∑ r ∈ Finset.Icc 1 (p - 1),
          ∑ j ∈ Finset.Icc 1 (p - r - 1),
            (-1 : L) ^ (r + j) * s x r * s x j * traceLM F hLE' (x ^ (p - r - j))) = 0 ∨
          (T : ℤ) ≤ valL F L
            (∑ r ∈ Finset.Icc 1 (p - 1),
              ∑ j ∈ Finset.Icc 1 (p - r - 1),
