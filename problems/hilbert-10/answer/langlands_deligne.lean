    intro u hu_val hu
    rw [← hcν₂_inv_eq]
    exact hcν₂_stat_goal u hu_val hu
  have hcν₁_val : valL F L (c_ν₁ : L) = (condExp F L νM₁' : ℤ) + condExpChar F L ψ := by
    change valL F L ((α : L) * ((Units.mk0 β₁ hβ₁)⁻¹ : Lˣ)) = _
