    rw [h0, AddChar.map_zero_eq_one]
  set Q₁ := (χ₁ A₁ : Ω F) ^ 2 * ((χ₂ C₂ : Ω F) ^ 2)⁻¹
  set Q₂ := (lam_L (Units.map (normLM F hLM₁') A₁ * (Units.map (normLM F hLE') C₂)⁻¹) : Ω F) ^ 2
