    (hjump_K₁ : ∀ τ : G_K₁, τ ≠ 1 →
      (ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁) ≠ 0 ∧
      valL F K₁ ((ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁)) = (condExp F L νM₁' : ℤ))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hσ₂_L : ∀ x : L, σ₂ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hGalLift_τ : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (hGalLift_σ : ∀ σ : E' ≃ₐ[F] E',
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      ∃ σ_lift : K₁ ≃ₐ[F] K₁,
        (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ z) ∧
        (∀ y : E', σ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ (σ y)) ∧
        (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hM₁'K₁ (σ_lift w) = normLM F hM₁'K₁ w ∧
          normLM F hE'K₁ (σ_lift w) = σ (normLM F hE'K₁ w)))
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁') (y : E')
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hy_val : valL F E' y = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hx_tr : traceLM F hLM₁' x = -1)
    (hx_conj : τ₁ x = -1 - x)
    (hy_tr : traceLM F hLE' y = -1)
    (hy_conj : σ₂ y = -1 - y)
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (α : Lˣ) (C : K₁ˣ)
    (hcE'_val : valL F E'
      ((Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
        (Units.map (normLM F hE'K₁) C)⁻¹ : E'ˣ) : E') =
      (condExp F E' (recChar F rec E' χE') : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ w : E',
      (w = 0 ∨ (((condExp F E' (recChar F rec E' χE') + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ∀ hw : 1 + w ≠ 0,
        ((recChar F rec E' χE') (Units.mk0 (1 + w) hw) : Ω F) =
          (traceChar F hLE' ψ)
            (((((Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
              (Units.map (normLM F hE'K₁) C)⁻¹)⁻¹ : E'ˣ) : E') * w)))
    (hcM₁'_val : valL F M₁'
      ((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
        (Units.map (normLM F hM₁'K₁) C)⁻¹ : M₁'ˣ) : M₁') =
      (condExp F M₁' (recChar F rec M₁' χM₁') : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        ((recChar F rec M₁' χM₁') (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ)
            (((((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
              (Units.map (normLM F hM₁'K₁) C)⁻¹)⁻¹ : M₁'ˣ) : M₁') * z)))
    (hCritPullback : ∀ z : K₁, (z = 0 ∨ 0 ≤ valL F K₁ z) →
      let t₂ := 2 * (condExp F L νE' / 2) - 1
      1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z ≠ 0 ∧
      ∀ hz : 1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z ≠ 0,
        let wz : K₁ˣ := Units.mk0 (1 + ((ϖ_K₁ ^ t₂ : K₁ˣ) : K₁) * z) hz
        let uE' : E'ˣ := Units.map (normLM F hE'K₁) wz
        let uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) wz
        let cE' : E'ˣ :=
          Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
            (Units.map (normLM F hE'K₁) C)⁻¹
        let cM₁' : M₁'ˣ :=
          Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
            (Units.map (normLM F hM₁'K₁) C)⁻¹
        ((recChar F rec E' χE') uE' : Ω F)⁻¹ *
            (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) =
          ((recChar F rec M₁' χM₁') uM₁' : Ω F)⁻¹ *
            (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1))) :
    let θE' := recChar F rec E' χE'
    let θM₁' := recChar F rec M₁' χM₁'
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let cE' : E'ˣ :=
      Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
        (Units.map (normLM F hE'K₁) C)⁻¹
    let cM₁' : M₁'ˣ :=
      Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
        (Units.map (normLM F hM₁'K₁) C)⁻¹
    ∃ (δ₁ : M₁'ˣ) (δ₂ : E'ˣ),
      valL F M₁' (δ₁ : M₁') = ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ∧
      valL F E' (δ₂ : E') = ((condExp F E' θE' / 2 : ℕ) : ℤ) ∧
      (∑ a : k_L,
        if hr : 1 + (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a) ≠ 0 then
          (θE' (Units.mk0 (1 + (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a)) hr) : Ω F)⁻¹ *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ₂ : E') * IntermediateField.inclusion hLE' (liftL a))
        else 0) =
      (∑ a : k_L,
        if hr : 1 + (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a) ≠ 0 then
          (θM₁' (Units.mk0 (1 + (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a)) hr) : Ω F)⁻¹ *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ₁ : M₁') * IntermediateField.inclusion hLM₁' (liftL a))
        else 0) :=
by
  obtain ⟨δ₁, δ₂, lam₁, lam₂, hδ₁, hδ₂, hCH₁, hCH₂, hlam₁_res, hlam₂_res, hPull⟩ :=
    ld_ch12_wild_dyadic_even_breaks_equal_newton_trace_and_quad_pullback F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' hdegE'K₁ hdegM₁'K₁
      χE' χM₁' νE' νM₁' hbE'_ge2 hbM₁'_ge2 heq hQuadNorm
      hval_normK₁ hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁
      hT1_even hT2_even hm1_min hm2_min
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker liftL hliftL_0 hliftL
      htr_E'K₁ htr_M₁'K₁ ϖ_E' hϖ_E' hBasis_E' ϖ_K₁ hϖ_K₁
      hDiamond_E' hDiamond_M₁' h2_val x hx_val hM₁'_coords
  obtain ⟨hH₁_eval, hH₂_eval, hMissingApply⟩ :=
    ld_ch12_wild_dyadic_even_breaks_equal_polar_quad_and_missing_coset F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' χE' χM₁' ψ νE' νM₁'
      hbE'_ge2 hbM₁'_ge2 heq hQuadNorm hMissingCoset
      hval_LE' hval_LM₁' hnE' hnM₁' hT1_even hT2_even hm1_min hm2_min
      hSpecL hSpecE' hSpecM₁' hvalL_props hvalE'_props hvalM₁'_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hchar2_kL liftL hliftL_0 hliftL
      ϖ_E' hϖ_E' hBasis_E' h2_val x y hx_val hy_val hx_tr hy_tr hM₁'_coords
      α C hcE'_val hcE'_stat hcM₁'_val hcM₁'_stat δ₁ δ₂ hδ₁ hδ₂
  obtain ⟨hlam₂_ne, hlam₁₂_ne⟩ :=
    ld_ch12_wild_dyadic_even_breaks_equal_jump_diff_and_distinct_roots F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ νE' νM₁' hbE'_ge2 hbM₁'_ge2 heq
      hval_normK₁ hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁ hT1_even hT2_even
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker liftL hliftL_0 hliftL
      htr_E'K₁ htr_M₁'K₁ ϖ_K₁ hϖ_K₁ hBasis_K₁
      G_K₁ act_K₁ hcard_GK₁ hactK₁_one hactK₁_ring hactK₁_val hactK₁_trace hjump_K₁
      τ₁ hτ₁_L hτ₁_tr hGalLift_τ h2_val x hx_val hx_tr hx_conj hM₁'_coords
      hCH₁ hCH₂ lam₁ lam₂ hlam₁_res hlam₂_res
  refine ⟨δ₁, δ₂, hδ₁, hδ₂, hMissingApply lam₁ lam₂ hlam₂_ne hlam₁₂_ne (fun b => ?_)⟩
  obtain ⟨hz_val, hPull_b⟩ := hPull b
  obtain ⟨hz_ne, hCrit_b⟩ :=
    hCritPullback (IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL b))) hz_val
  obtain ⟨huM₁'_congr, huE'_congr⟩ := hPull_b hz_ne
  have h1 := hH₁_eval _ (b ^ 2 + lam₁ * b) huM₁'_congr
  have h2 := hH₂_eval _ (b ^ 2 + lam₂ * b) huE'_congr
  exact h1.symm.trans ((hCrit_b hz_ne).symm.trans h2)

theorem ld_ch12_wild_dyadic_even_breaks_critical_sum_comparison_with_prefactor (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ)
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' (recChar F rec E' χE')),
      (recChar F rec E' χE') u = 1)
    (hθM₁'_triv : ∀ u ∈ unitGroup F M₁' (condExp F M₁' (recChar F rec M₁' χM₁')),
      (recChar F rec M₁' χM₁') u = 1)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hMissingCoset :
      ∀ (k_L : Type u) [Field k_L] [Fintype k_L],
        (2 : k_L) = 0 →
        ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
        ∀ (d₁ d₂ a₁ a₂ : k_L), d₁ ≠ 0 → d₂ ≠ 0 → a₁ ≠ 0 → a₂ ≠ 0 → a₁ ≠ a₂ →
        ∀ (p₁ p₂ : k_L →+ k_L) (H₁ H₂ Q : k_L → Ω F),
          (∀ z : k_L, p₁ z = 0 ↔ (z = 0 ∨ z = a₁)) →
          (∀ z : k_L, p₂ z = 0 ↔ (z = 0 ∨ z = a₂)) →
          H₁ 0 = 1 → H₂ 0 = 1 →
          (∀ x y : k_L, H₁ (x + y) = H₁ x * H₁ y * ψ₀ (d₁ * x * y)) →
          (∀ x y : k_L, H₂ (x + y) = H₂ x * H₂ y * ψ₀ (d₂ * x * y)) →
          (∀ z : k_L, H₁ (p₁ z) = Q z) →
          (∀ z : k_L, H₂ (p₂ z) = Q z) →
          (∑ x : k_L, H₁ x) = (∑ x : k_L, H₂ x))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hqE' : qL F E' = qL F L)
    (hqM₁' : qL F M₁' = qL F L)
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_normK₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w ∧
      valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = 2 * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = 2 * valL F M₁' z)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (heps1_E' : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F L : Ω F) ^ condExpChar F E' (traceChar F hLE' ψ))
    (heps1_M₁' : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
      (qL F L : Ω F) ^ condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
