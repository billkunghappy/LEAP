        _ = (act σ (u τ) - u τ) * u σ := by rw [hπ_mul]; ring
    rw [h_id]
    simpa using hP_mul (hσ (u τ) (hu_P0 hτ)) (hu_P0 hσ)
  have hu_pow_mod1 : ∀ {σ : G}, σ ∈ G_sub 0 → ∀ m : ℕ, P 1 (u (σ ^ m) - (u σ) ^ m) := by
    intro σ hσ m
    induction m with
    | zero =>
      rw [pow_zero, pow_zero, hu_one, sub_self]
      exact hP_zero 1
    | succ m ih =>
      have h_id : u (σ ^ (m + 1)) - (u σ) ^ (m + 1) =
          (u (σ * σ ^ m) - u σ * u (σ ^ m)) + u σ * (u (σ ^ m) - (u σ) ^ m) := by
        rw [pow_succ', pow_succ']
        ring
      have ht1 : P 1 (u (σ * σ ^ m) - u σ * u (σ ^ m)) :=
        hu_hom_mod1 hσ ((G_sub 0).pow_mem hσ m)
      have ht2 : P (0 + 1) (u σ * (u (σ ^ m) - (u σ) ^ m)) :=
        hP_mul (hu_P0 hσ) ih
      rw [h_id]
      exact hP_add 1 ht1 (by simpa using ht2)
  let u_C : C → K := fun c => u c.1
  have huC_P0 : ∀ c : C, P 0 (u_C c) := fun c => hu_P0 (hC_le_G0 c.2)
  have huC_pow : ∀ c : C, P 1 ((u_C c) ^ ℓ - 1) := by
    intro c
    have h1 : P 1 (u (c.1 ^ ℓ) - (u_C c) ^ ℓ) := hu_pow_mod1 (hC_le_G0 c.2) ℓ
    rw [hC_exp c.1 c.2, hu_one] at h1
    have hneg : P 1 (-(1 - (u_C c) ^ ℓ)) := hP_neg 1 h1
    rwa [neg_sub] at hneg
  have huC_inj : ∀ c₁ c₂ : C, P 1 (u_C c₁ - u_C c₂) → c₁ = c₂ := by
    intro c₁ c₂ hdiff
    have hmul_π : P (1 + 1) ((u c₁.1 - u c₂.1) * π) := hP_mul hdiff hP1_π
    have h_act_diff : (u c₁.1 - u c₂.1) * π = act c₁.1 π - act c₂.1 π := by
      rw [sub_mul, hu_mul, hu_mul]
    rw [h_act_diff] at hmul_π
    have hmap : P 2 (act (c₂.1)⁻¹ (act c₁.1 π - act c₂.1 π)) :=
      (hP_map 2 (act (c₂.1)⁻¹) _).mpr hmul_π
    have h_δ : act (c₂.1)⁻¹ (act c₁.1 π - act c₂.1 π) = δ ((c₂.1)⁻¹ * c₁.1) π := by
      dsimp [δ]
      rw [map_sub, h_act_mul, h_act_mul, inv_mul_cancel, map_one, AlgEquiv.one_apply]
    rw [h_δ] at hmap
    have hγ_G0 : (c₂.1)⁻¹ * c₁.1 ∈ G_sub 0 :=
      hC_le_G0 (C.mul_mem (C.inv_mem c₂.2) c₁.2)
    have hγ_G1 : (c₂.1)⁻¹ * c₁.1 ∈ G_sub 1 := h_G1_of_pi hγ_G0 hmap
    rw [hG1_bot, Subgroup.mem_bot] at hγ_G1
    apply Subtype.ext
    exact (inv_mul_eq_one.mp hγ_G1).symm
  have hcard_le : Fintype.card C ≤ ℓ :=
    h_roots_bound C ℓ hPrime_ℓ.pos u_C huC_P0 huC_pow huC_inj
  have hNat_le : Nat.card C ≤ ℓ := by
    rwa [Nat.card_eq_fintype_card]
  have hℓ_le : ℓ ≤ Nat.card C := Nat.le_of_dvd (by omega) hℓ_dvd
  have hcard_eq : Nat.card C = ℓ := le_antisymm hNat_le hℓ_le
  exact hcard_eq ▸ hPrime_ℓ

theorem ld_ch13_14_orbit_monomial_list_lift (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hMCK_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (hCard_C : Nat.card C = Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hH_gt1 : 1 < Nat.card H)
    (hG_mul : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (hC_min_norm : ∀ N : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      N.Normal → N = ⊥ ∨ C ≤ N)
    (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
    (h_mem_C : ∀ w : relWeil F L, w ∈ (relWeil F M_C).subgroupOf (relWeil F L) ↔ π w ∈ C)
    (h_sub_MC : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      C ≤ M → (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ M_C)
    (h_lt_L : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      M < ⊤ → L < (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F)
    (h_field_C : (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F = M_C)
    (h_mem_sup : ∀ (M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
      (w : relWeil F L),
      w ∈ (relWeil F (E ⊔ (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F)).subgroupOf
        (relWeil F L) →
      π w ∈ H ∧ π w ∈ M)
    (ℓ : ℕ) (hC_exp : ∀ c ∈ C, c ^ ℓ = 1)
    (L_orb : List (Σ (M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)),
      (M →* (Ω F)ˣ)))
    (hL_sum : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      indCharTrace F H 1 g =
        indCharTrace F (⊤ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)) 1 g +
          (L_orb.map fun p => indCharTrace F p.1 p.2 g).sum)
    (hL_props : ∀ p ∈ L_orb,
      ∃ hC_le : C ≤ p.1,
        (∃ c : C, p.2 ⟨c.1, hC_le c.2⟩ ≠ 1) ∧
        (∀ m : p.1, ∃ c : C, p.2 m = p.2 ⟨c.1, hC_le c.2⟩) ∧
        (∀ h ∈ H, ∀ hh : h ∈ p.1, p.2 ⟨h, hh⟩ = 1) ∧
        (∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
          g ∈ p.1 ↔
            ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C),
              p.2 ⟨g⁻¹ * c.1 * g, hC_le hc⟩ = p.2 ⟨c.1, hC_le c.2⟩)) :
    ∃ D_orb : List (MonomialTerm F L),
      IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb) ∧
      monomialListDeg F L D_orb =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1 ∧
      (∀ t ∈ D_orb,
        t.coeff = 1 ∧
        L < t.field ∧
        t.field ≤ M_C ∧
        t.χ ^ ℓ = 1 ∧
        (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
        (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
        (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1)) ∧
      (Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) →
        Module.finrank L (IntermediateField.extendScalars hLM_C) ∣
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) ∧
        ∀ t ∈ D_orb, t.field = M_C) :=
by
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  let G_L := relWeil F L
  letI : Fintype G := AlgEquiv.fintype L K'
  have h_abs_finrank : ∀ (k E₀ Ω_bar : Type u) [Field k] [Field E₀] [Field Ω_bar]
      [Algebra k E₀] [Algebra k Ω_bar] [FiniteDimensional k E₀] [IsGalois k E₀]
      (f : E₀ →ₐ[k] Ω_bar) (A_ext : IntermediateField k Ω_bar),
      (∀ z ∈ A_ext, ∃ y : E₀, f y = z) →
      Module.finrank k ↥A_ext * Nat.card ((A_ext.comap f).fixingSubgroup) =
        Module.finrank k E₀ := by
    clear * -
    intro k E₀ Ω_bar _ _ _ _ _ _ _ f A_ext h_surj
    let A' : IntermediateField k E₀ := A_ext.comap f
    have hA'_map : A'.map f = A_ext := by
      ext z
      refine ⟨?_, fun hz => ?_⟩
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · obtain ⟨y, rfl⟩ := h_surj z hz
        exact ⟨y, hz, rfl⟩
    have hfin_A' : Module.finrank k ↥A' = Module.finrank k ↥A_ext := by
      have h1 : Module.finrank k ↥A' = Module.finrank k ↥(A'.map f) :=
        LinearEquiv.finrank_eq (A'.equivMap f).toLinearEquiv
      rwa [hA'_map] at h1
    have hmul : Module.finrank k ↥(IntermediateField.fixedField A'.fixingSubgroup) *
        Module.finrank ↥(IntermediateField.fixedField A'.fixingSubgroup) E₀ =
        Module.finrank k E₀ :=
      Module.finrank_mul_finrank k ↥(IntermediateField.fixedField A'.fixingSubgroup) E₀
    rwa [IntermediateField.finrank_fixedField_eq_card A'.fixingSubgroup,
      IsGalois.fixedField_fixingSubgroup A', hfin_A'] at hmul
  have h_bridge : ∀ (E₁ : IntermediateField F (AlgebraicClosure F))
      (hLE₁ : L ≤ E₁) (hE₁K : E₁ ≤ K) (M : Subgroup G)
      (h_mem : ∀ w : G_L, w ∈ (relWeil F E₁).subgroupOf G_L ↔ π w ∈ M)
      (ψ : M →* (Ω F)ˣ),
      let ι : relWeil F E₁ →* G_L := Subgroup.inclusion (relWeil_antitone F hLE₁)
      let π_E₁ : relWeil F E₁ →* M :=
        { toFun := fun w => ⟨π (ι w), (h_mem (ι w)).mp w.2⟩
          map_one' := Subtype.ext (by simp)
          map_mul' := fun x y => Subtype.ext (by simp) }
      let χ_E₁ : relWeil F E₁ →* (Ω F)ˣ := ψ.comp π_E₁
      (⟨1, E₁, hLE₁, χ_E₁⟩ : MonomialTerm F L).Wf F L ∧
      restrictWeilChar F hE₁K χ_E₁ = 1 ∧
      indCharTrace F M ψ 1 = (((⟨1, E₁, hLE₁, χ_E₁⟩ : MonomialTerm F L).deg F L : ℤ) : Ω F) ∧
      ∀ w : G_L,
        (⟨1, E₁, hLE₁, χ_E₁⟩ : MonomialTerm F L).trace F L w = indCharTrace F M ψ (π w) := by
    intro E₁ hLE₁ hE₁K M h_mem ψ ι π_E₁ χ_E₁
    haveI : FiniteDimensional F E₁ :=
      Module.Finite.of_injective (IntermediateField.inclusion hE₁K).toLinearMap
        (IntermediateField.inclusion hE₁K).injective
    have hSep_E₁ : Algebra.IsSeparable L (IntermediateField.extendScalars hLE₁) := by
      refine ⟨fun x => ?_⟩
      let E₁' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE₁
      have hxE₁ : (x : AlgebraicClosure F) ∈ E₁ := (IntermediateField.mem_extendScalars hLE₁).mp x.2
      let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hE₁K hxE₁)⟩
      have hsep_K : IsSeparable L x_K := Algebra.IsSeparable.isSeparable L x_K
      have hmin_E₁ : minpoly L (x : AlgebraicClosure F) = minpoly L x :=
        minpoly.algHom_eq E₁'.val E₁'.val.injective x
      have hmin_K : minpoly L (x_K : AlgebraicClosure F) = minpoly L x_K :=
        minpoly.algHom_eq K'.val K'.val.injective x_K
      change (minpoly L x).Separable
      rw [← hmin_E₁]
      change (minpoly L (x_K : AlgebraicClosure F)).Separable
      rw [hmin_K]
      exact hsep_K
    have hWeil_E₁ : IsWeilRep F E₁ (charRep F E₁ χ_E₁) := by
      refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
      let U : Set (AbsGal F) := (K.fixingSubgroup : Set (AbsGal F))
      have hU_nhds : U ∈ nhds (1 : AbsGal F) :=
        (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U).mpr
          ⟨K, inferInstance, Set.Subset.rfl⟩
      refine ⟨U, hU_nhds, fun w hwU _ => ?_⟩
      have hπ_w : π (ι w) = 1 := by
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        have h1 := hπ (ι w) x
        change ((π (ι w) x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        have hxK : (x : AlgebraicClosure F) ∈ K := (IntermediateField.mem_extendScalars hLK).mp x.2
        exact (IntermediateField.mem_fixingSubgroup_iff K (w : AbsGal F)).mp hwU x.1 hxK
      have hπE₁_w : π_E₁ w = 1 := Subtype.ext hπ_w
      have hχ_w : χ_E₁ w = 1 := by
        change ψ (π_E₁ w) = 1
        rw [hπE₁_w, map_one]
      change (χ_E₁ w : Ω F) • LinearMap.id = 1
      rw [hχ_w, Units.val_one, one_smul]
      rfl
    have hWf : (⟨1, E₁, hLE₁, χ_E₁⟩ : MonomialTerm F L).Wf F L := ⟨inferInstance, hSep_E₁, hWeil_E₁⟩
    have h_rest_E₁ : restrictWeilChar F hE₁K χ_E₁ = 1 := by
      apply MonoidHom.ext
      intro w
      let ι_K : relWeil F K →* relWeil F E₁ := Subgroup.inclusion (relWeil_antitone F hE₁K)
      have hπ_w : π (ι (ι_K w)) = 1 := by
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        have h1 := hπ (ι (ι_K w)) x
        change ((π (ι (ι_K w)) x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        have hxK : (x : AlgebraicClosure F) ∈ K := (IntermediateField.mem_extendScalars hLK).mp x.2
        exact (IntermediateField.mem_fixingSubgroup_iff K (w : AbsGal F)).mp w.2.2 x.1 hxK
      have hπE₁_w : π_E₁ (ι_K w) = 1 := Subtype.ext hπ_w
      change ψ (π_E₁ (ι_K w)) = 1
      rw [hπE₁_w, map_one]
    have h_deg_E₁ : indCharTrace F M ψ 1 =
        (((⟨1, E₁, hLE₁, χ_E₁⟩ : MonomialTerm F L).deg F L : ℤ) : Ω F) := by
      let E₁_ext : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE₁
      let E₁' : IntermediateField L K' := E₁_ext.comap K'.val
      have h_fix_eq : E₁'.fixingSubgroup = M := by
        ext g
        obtain ⟨w, rfl⟩ := hsurj g
        rw [← h_mem w]
        change (π w ∈ E₁'.fixingSubgroup) ↔
          ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ E₁.fixingSubgroup)
        have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
        rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff,
          IntermediateField.mem_fixingSubgroup_iff]
        constructor
        · intro hπw z hzE₁
          let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hE₁K hzE₁)⟩
          have hxE₁' : x ∈ E₁' := (IntermediateField.mem_extendScalars hLE₁).mpr hzE₁
          have h1 := hπ w x
          change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) z at h1
          rw [hπw x hxE₁'] at h1
          exact h1.symm
        · intro hw x hxE₁'
          apply Subtype.ext
          have h1 := hπ w x
          change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) x.1 at h1
          rw [h1]
          exact hw x.1 ((IntermediateField.mem_extendScalars hLE₁).mp hxE₁')
      have h_card_mul : Module.finrank L E₁_ext * Nat.card M = Nat.card G := by
        have h1 : Module.finrank L ↥E₁_ext * Nat.card E₁'.fixingSubgroup = Module.finrank L K' :=
          h_abs_finrank ↥L ↥K' (AlgebraicClosure F) K'.val E₁_ext (fun z hz =>
            ⟨⟨z, (IntermediateField.mem_extendScalars hLK).mpr
              (hE₁K ((IntermediateField.mem_extendScalars hLE₁).mp hz))⟩, rfl⟩)
        rw [h_fix_eq, ← IsGalois.card_aut_eq_finrank L K'] at h1
        exact h1
      unfold indCharTrace MonomialTerm.deg
      have h_term1 : ∀ x : G,
          (if h : x * 1 * x⁻¹ ∈ M then (ψ ⟨x * 1 * x⁻¹, h⟩ : Ω F) else 0) = 1 := by
        intro x
        have hx1 : x * 1 * x⁻¹ = 1 := by group
        have hm1 : x * 1 * x⁻¹ ∈ M := by rw [hx1]; exact M.one_mem
        rw [dif_pos hm1]
        have hsub1 : (⟨x * 1 * x⁻¹, hm1⟩ : M) = 1 := Subtype.ext hx1
        rw [hsub1, map_one, Units.val_one]
      simp_rw [h_term1]
      rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul, mul_one,
        ← h_card_mul, Nat.cast_mul, mul_comm (Module.finrank L E₁_ext : Ω F),
        inv_mul_cancel_left₀ (by exact_mod_cast (Nat.card_pos (α := M)).ne')]
      rw [one_mul, Int.cast_natCast]
    clear h_abs_finrank
    refine ⟨hWf, h_rest_E₁, h_deg_E₁, fun w => ?_⟩
    let H_E₁ : Subgroup G_L := (relWeil F E₁).subgroupOf G_L
    let W := ULift.{u} (Ω F)
    let e_sub : H_E₁ ≃* relWeil F E₁ := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE₁)
    let ρ_E₁ : Representation (Ω F) H_E₁ W := (charRep F E₁ χ_E₁).comp e_sub.toMonoidHom
    let s : G ⧸ M → G_L := fun u₀ => (hsurj (cosetRep u₀)).choose
    have hs_spec : ∀ u₀ : G ⧸ M, π (s u₀) = cosetRep u₀ :=
      fun u₀ => (hsurj (cosetRep u₀)).choose_spec
    let u : G_L → G ⧸ M := fun x => QuotientGroup.mk (π x)⁻¹
    let r : G_L → G_L := fun x => s (u x)
    have h_xr_mem : ∀ x : G_L, x * r x ∈ H_E₁ := by
      intro x
      rw [h_mem]
      change π (x * s (u x)) ∈ M
      rw [map_mul, hs_spec (u x)]
      have hout : QuotientGroup.mk (s := M) (cosetRep (u x)) = QuotientGroup.mk (s := M) (π x)⁻¹ :=
        Quotient.out_eq (u x)
      have hrel : (cosetRep (u x))⁻¹ * (π x)⁻¹ ∈ M := QuotientGroup.eq.mp hout
      have hinv : (π x * cosetRep (u x))⁻¹ ∈ M := by
        have heq : (π x * cosetRep (u x))⁻¹ = (cosetRep (u x))⁻¹ * (π x)⁻¹ := mul_inv_rev _ _
        rw [heq]
        exact hrel
      exact M.inv_mem_iff.mp hinv
    have hu_mul : ∀ (h₀ : H_E₁) (x : G_L), u ((h₀ : G_L) * x) = u x := by
      intro h₀ x
      change QuotientGroup.mk (s := M) (π ((h₀ : G_L) * x))⁻¹ = QuotientGroup.mk (s := M) (π x)⁻¹
      rw [QuotientGroup.eq]
      have heq : ((π ((h₀ : G_L) * x))⁻¹)⁻¹ * (π x)⁻¹ = π (h₀ : G_L) := by
        rw [inv_inv, map_mul, mul_inv_cancel_right]
      rw [heq]
      exact (h_mem (h₀ : G_L)).mp h₀.2
    have hr_mul : ∀ (h₀ : H_E₁) (x : G_L), r ((h₀ : G_L) * x) = r x := by
      intro h₀ x
      exact congrArg s (hu_mul h₀ x)
    have hu_rep_inv : ∀ u₀ : G ⧸ M, u (s u₀)⁻¹ = u₀ := by
      intro u₀
      change QuotientGroup.mk (s := M) (π (s u₀)⁻¹)⁻¹ = u₀
      rw [map_inv, inv_inv, hs_spec u₀]
      exact Quotient.out_eq u₀
    have hr_rep_inv : ∀ u₀ : G ⧸ M, r (s u₀)⁻¹ = s u₀ := by
      intro u₀
      exact congrArg s (hu_rep_inv u₀)
