        valL F M (-1) = 0 →
        (∀ x : M, valL F M (-x) = valL F M x) →
        (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) →
        (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) →
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x + y = 0 ∨ k ≤ valL F M (x + y))) →
        (∀ (x : M) (k : ℕ), x ≠ 0 → valL F M (x ^ k) = (k : ℤ) * valL F M x) ∧
        (∀ (x : M), x ≠ 0 → valL F M x⁻¹ = - valL F M x) ∧
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x - y = 0 ∨ k ≤ valL F M (x - y))) ∧
        (∀ (k₁ k₂ : ℤ) (x : M),
          k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M x) → (x = 0 ∨ k₁ ≤ valL F M x)) ∧
        (∀ (k₁ k₂ : ℤ) (x y : M),
          (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
            (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y))) ∧
        (∀ (x : M) (n : ℕ) (q : ℤ),
          (x = 0 ∨ q ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M (x ^ n))) ∧
        (∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
          (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
            ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i))) ∧
        (∀ n : ℕ, (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M)) ∧
        (∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ valL F M ((-1 : M) ^ r) = 0) := by
    intro M hv1 hvneg1 hvneg hvmul hvinv hvadd
    have hvpow : ∀ (x : M) (k : ℕ), x ≠ 0 → valL F M (x ^ k) = (k : ℤ) * valL F M x := by
      intro x k hx
      induction k with
      | zero => simp [hv1]
      | succ k ih =>
        rw [pow_succ, hvmul (x ^ k) x (pow_ne_zero k hx) hx, ih]
        push_cast
        ring
    have hvinv_elt : ∀ (x : M), x ≠ 0 → valL F M x⁻¹ = - valL F M x := by
      intro x hx
      exact hvinv (Units.mk0 x hx)
    have hvsub : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x - y = 0 ∨ k ≤ valL F M (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      refine hvadd k x (-y) hx ?_
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rwa [hvneg])
    have hvmono : ∀ (k₁ k₂ : ℤ) (x : M),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M x) → (x = 0 ∨ k₁ ≤ valL F M x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvmul_ge : ∀ (k₁ k₂ : ℤ) (x y : M),
        (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvmul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvpow_ge : ∀ (x : M) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        simp [hv1]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvmul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvsum_ge : ∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvadd k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    have hvnat : ∀ n : ℕ, (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M) := by
      intro n
      induction n with
      | zero => left; exact Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hvadd 0 (n : M) 1 ih (Or.inr (by rw [hv1]))
    have hvneg1_pow : ∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ valL F M ((-1 : M) ^ r) = 0 := by
      intro r
      have hne : (-1 : M) ^ r ≠ 0 := pow_ne_zero r (neg_ne_zero.mpr one_ne_zero)
      refine ⟨hne, ?_⟩
      rw [hvpow (-1 : M) r (neg_ne_zero.mpr one_ne_zero), hvneg1, mul_zero]
    exact ⟨hvpow, hvinv_elt, hvsub, hvmono, hvmul_ge, hvpow_ge, hvsum_ge, hvnat, hvneg1_pow⟩
  obtain ⟨hvalL_pow, hvalL_inv_elt, hvalL_sub, hvalL_mono, hvalL_mul_ge, _, _, _, _⟩ :=
    hval_helpers L hvalL_1 hvalL_neg1 hvalL_neg hvalL_mul hvalL_inv hvalL_add
  obtain ⟨hvalE'_pow, hvalE'_inv_elt, _, hvalE'_mono, hvalE'_mul_ge, hvalE'_pow_ge,
      hvalE'_sum_ge, _, hneg1_pow_E'⟩ :=
    hval_helpers E' hvalE'_1 hvalE'_neg1 hvalE'_neg hvalE'_mul hvalE'_inv hvalE'_add
  obtain ⟨_, _, _, hvalM₁'_mono, hvalM₁'_mul_ge, hvalM₁'_pow_ge,
      hvalM₁'_sum_ge, _, hneg1_pow_M₁'⟩ :=
    hval_helpers M₁' hvalM₁'_1 hvalM₁'_neg1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_inv hvalM₁'_add
  obtain ⟨_, _, hvalK₁_sub, hvalK₁_mono, hvalK₁_mul_ge, hvalK₁_pow_ge,
      hvalK₁_sum_ge, hvalK₁_natCast, _⟩ :=
    hval_helpers K₁ hvalK₁_1 hvalK₁_neg1 hvalK₁_neg hvalK₁_mul hvalK₁_inv hvalK₁_add
  clear hval_helpers

  
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by dsimp [p]; omega
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos_int : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
  have hp_ne0_int : (p : ℤ) ≠ 0 := ne_of_gt hp_pos_int
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have ht₂_eq : t₂ = t₁ + δ := by dsimp [t₁, t₂, δ]; omega
  have hbE'_eq : bE' = t₁ + 1 + δ := by dsimp [t₁, δ]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpm_gt : t₁ < p * m := hpm_gt_t₁
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hp2_cast : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := by omega
  have hbM₁'1_cast : (t₁ : ℤ) = (bM₁' : ℤ) - 1 := by dsimp [t₁]; omega
  have hbE'1_cast : (t₂ : ℤ) = (bE' : ℤ) - 1 := by dsimp [t₂]; omega
  have hct_div : p * ct + (t₁ + p - 1) % p = t₁ + p - 1 := Nat.div_add_mod (t₁ + p - 1) p
  have hct_mod : (t₁ + p - 1) % p < p := Nat.mod_lt (t₁ + p - 1) hp_pos
  have hpct_ne : p * ct ≠ t₁ := fun hpct_eq => ht₁_ndvd ⟨ct, hpct_eq.symm⟩
  have ht₁_lt_pct : t₁ + 1 ≤ p * ct := by omega
  have hpct_le : p * ct ≤ t₁ + p - 1 := by omega
  have hct_le_t₁ : ct ≤ t₁ := by
    by_contra hlt
    push_neg at hlt
    have h1 : p * (t₁ + 1) ≤ p * ct := Nat.mul_le_mul_left p hlt
    have h2 : p * (t₁ + 1) = p * t₁ + p := by ring
    have h3 : t₁ ≤ p * t₁ := Nat.le_mul_of_pos_left t₁ hp_pos
    omega
  have hct_le_m : ct ≤ m := by
    by_contra hlt
    push_neg at hlt
    have h1 : p * (m + 1) ≤ p * ct := Nat.mul_le_mul_left p hlt
    have h2 : p * (m + 1) = p * m + p := by ring
    omega
  have hc₂_div : p * c₂ + (bE' + p - 1) % p = bE' + p - 1 := Nat.div_add_mod (bE' + p - 1) p
  have hc₂_mod : (bE' + p - 1) % p < p := Nat.mod_lt (bE' + p - 1) hp_pos
  have hpc₂_le : p * c₂ ≤ bE' + p - 1 := by omega

  
  have hu_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero γ⁻¹)
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero γ⁻¹),
      hvalL_inv γ, hα_val, hγ_val]
    omega
  have hw₂_ne0 : (w₂ : E') ≠ 0 := Units.ne_zero w₂
  have hw₂_pow_ne0 : (w₂ : E') ^ (p - 2) ≠ 0 := pow_ne_zero (p - 2) hw₂_ne0
  have hw₂_pow_val : valL F E' ((w₂ : E') ^ (p - 2)) = -(((p - 2) * m : ℕ) : ℤ) := by
    rw [hvalE'_pow (w₂ : E') (p - 2) hw₂_ne0, hw₂_val]
    push_cast; ring
  have hz_den_ne0 : (w₂ : E') ^ (p - 2) * C ≠ 0 := mul_ne_zero hw₂_pow_ne0 hC_ne0
  have hz_den_val : valL F E' ((w₂ : E') ^ (p - 2) * C) = -(((p - 2) * m : ℕ) : ℤ) := by
    rw [hvalE'_mul _ _ hw₂_pow_ne0 hC_ne0, hw₂_pow_val, hC_val0, add_zero]
  have hz_den_inv_val : valL F E' (((w₂ : E') ^ (p - 2) * C)⁻¹) = (((p - 2) * m : ℕ) : ℤ) := by
    rw [hvalE'_inv_elt _ hz_den_ne0, hz_den_val, neg_neg]
  have hysT_val1 :
      y_sT = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (δ : ℤ) + (((p - 2) * m : ℕ) : ℤ) ≤ valL F E' y_sT :=
    hvalE'_mul_ge (((p - 1 : ℕ) : ℤ) * (δ : ℤ)) ((((p - 2) * m : ℕ) : ℤ))
      s₀ (((w₂ : E') ^ (p - 2) * C)⁻¹) hs₀_val (Or.inr (le_of_eq hz_den_inv_val.symm))
  have hc₂_le_ysT : c₂ ≤ (p - 1) * δ + (p - 2) * m := by
    have h1_le_p2 : 1 ≤ p - 2 := by omega
    have hm_le_p2m : m ≤ (p - 2) * m := by
      calc m = 1 * m := (one_mul m).symm
        _ ≤ (p - 2) * m := Nat.mul_le_mul_right m h1_le_p2
    have hct_le_p2m : ct ≤ (p - 2) * m := le_trans hct_le_m hm_le_p2m
    have hpct_le_p2m : p * ct ≤ p * ((p - 2) * m) := Nat.mul_le_mul_left p hct_le_p2m
    have hδ_le_p1δ : δ ≤ p * ((p - 1) * δ) := by
      have h1 : 1 ≤ p * (p - 1) := Nat.mul_pos hp_pos (by omega)
      calc δ = 1 * δ := (one_mul δ).symm
        _ ≤ (p * (p - 1)) * δ := Nat.mul_le_mul_right δ h1
        _ = p * ((p - 1) * δ) := by ring
    by_contra hlt
    push_neg at hlt
    have hmul : p * ((p - 1) * δ + (p - 2) * m + 1) ≤ p * c₂ := Nat.mul_le_mul_left p hlt
    have hexp : p * ((p - 1) * δ + (p - 2) * m + 1) =
        p * ((p - 1) * δ) + p * ((p - 2) * m) + p := by ring
    omega
  have hc₂_le_ysT_int :
      (c₂ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) + (((p - 2) * m : ℕ) : ℤ) := by
    have h : (c₂ : ℤ) ≤ (((p - 1) * δ + (p - 2) * m : ℕ) : ℤ) := by exact_mod_cast hc₂_le_ysT
    push_cast at h
    exact h
  have hysT_c2 : y_sT = 0 ∨ (c₂ : ℤ) ≤ valL F E' y_sT :=
    hvalE'_mono (c₂ : ℤ) (((p - 1 : ℕ) : ℤ) * (δ : ℤ) + (((p - 2) * m : ℕ) : ℤ))
      y_sT hc₂_le_ysT_int hysT_val1

  have hnorm_LM₁'_zero : normLM F hLM₁' 0 = 0 := by
    have hcay0 := hs_LM₁'_cayley 0
    change (0 : M₁') ^ p =
      IntermediateField.inclusion hLM₁' (normLM F hLM₁' 0) +
        ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : M₁') ^ (i - 1) * IntermediateField.inclusion hLM₁' (s_LM₁' 0 i) *
            (0 : M₁') ^ (p - i) at hcay0
    have h0p : (0 : M₁') ^ p = 0 := zero_pow (by omega : p ≠ 0)
    have hsum0 :
        (∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : M₁') ^ (i - 1) * IntermediateField.inclusion hLM₁' (s_LM₁' 0 i) *
            (0 : M₁') ^ (p - i)) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      obtain ⟨_, hip1⟩ := Finset.mem_Icc.mp hi
      have h0pi : (0 : M₁') ^ (p - i) = 0 := zero_pow (by omega : p - i ≠ 0)
      rw [h0pi, mul_zero]
    rw [h0p, hsum0, add_zero] at hcay0
    exact (map_eq_zero (IntermediateField.inclusion hLM₁')).mp hcay0.symm
  let q_s : ℤ := (((p - 1) * δ : ℕ) : ℤ)
  have hqs_eq : q_s = ((p - 1 : ℕ) : ℤ) * (δ : ℤ) := Nat.cast_mul (p - 1) δ
  have hs_val_M₁' : s = 0 ∨ q_s ≤ valL F M₁' s := by
    have he_p1 := he_Δ_val (p - 1) (Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩)
    rcases he_p1 with he0 | he_ge
    · left; dsimp [s]; rw [he0, neg_zero]
    · right
      dsimp [s]
      rw [hvalM₁'_neg]
      have h1 : ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) = q_s := by
        dsimp [q_s]; rw [ht₂_eq]; push_cast; ring
      linarith only [he_ge, h1]
  have hH_val : H = 0 ∨ q_s ≤ valL F L H := by
    rcases hs_val_M₁' with hs0 | hs_ge
    · left; change normLM F hLM₁' s = 0; rw [hs0, hnorm_LM₁'_zero]
    · right; change q_s ≤ valL F L (normLM F hLM₁' s); rwa [hval_norm_LM₁' s]

  
  let B_M₁' : ℤ := ((p * (p - 1) * δ + (p - 1) * t₁ : ℕ) : ℤ)
  let B_frob : ℤ := ((p * p * (p - 1) * δ + p * (p - 1) * t₁ : ℕ) : ℤ)
  have hBfrob_eq : B_frob = (p : ℤ) * B_M₁' := by
    dsimp [B_frob, B_M₁']; ring
  have hcay_arith : ∀ (bM : ℕ), bM₁' ≤ bM → ∀ i ∈ Finset.Icc 1 (p - 1),
      let X_i : ℤ := (i : ℤ) * q_s + ((p - 1 : ℕ) : ℤ) * (bM : ℤ)
      let m_i : ℤ := X_i / (p : ℤ)
      (p : ℤ) * m_i - ((p - 1 : ℕ) : ℤ) * (bM : ℤ) ≤ (i : ℤ) * q_s ∧
      B_M₁' ≤ (0 + (p : ℤ) * m_i) + ((p - i : ℕ) : ℤ) * q_s := by
    intro bM hbM i hi
    obtain ⟨hi1, hip1⟩ := Finset.mem_Icc.mp hi
    intro X_i m_i
    let r_i : ℤ := X_i % (p : ℤ)
    have hdiv_i : (p : ℤ) * m_i + r_i = (i : ℤ) * q_s + ((p - 1 : ℕ) : ℤ) * (bM : ℤ) :=
      Int.mul_ediv_add_emod X_i (p : ℤ)
    have hr_nonneg : 0 ≤ r_i := Int.emod_nonneg X_i hp_ne0_int
    have hr_lt : r_i < (p : ℤ) := Int.emod_lt_of_pos X_i hp_pos_int
    refine ⟨by linarith only [hdiv_i, hr_nonneg], ?_⟩
    have hpi_cast : ((p - i : ℕ) : ℤ) = (p : ℤ) - (i : ℤ) := Nat.cast_sub (by omega)
    have hb_le_int : (bM₁' : ℤ) ≤ (bM : ℤ) := by exact_mod_cast hbM
    have hp1_ble : ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (bM : ℤ) :=
      mul_le_mul_of_nonneg_left hb_le_int (by positivity)
    have hid :
        ((0 + (p : ℤ) * m_i) + ((p - i : ℕ) : ℤ) * q_s) - B_M₁' =
          (((p - 1 : ℕ) : ℤ) * (bM : ℤ) - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ)) +
            (((p : ℤ) - 1) - r_i) := by
      have hBM : B_M₁' = (p : ℤ) * q_s + ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) := by
        dsimp [B_M₁', q_s]; ring
      rw [hBM, hpi_cast, hbM₁'1_cast, hp1_cast]
      rw [hp1_cast] at hdiv_i
      linear_combination hdiv_i
    linarith only [hid, hp1_ble, hr_lt]

  have hs_cayley_eq :
      s ^ p - IntermediateField.inclusion hLM₁' H =
        ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : M₁') ^ (i - 1) * IntermediateField.inclusion hLM₁' (s_LM₁' s i) * s ^ (p - i) := by
    have hcay := hs_LM₁'_cayley s
    change s ^ p =
      IntermediateField.inclusion hLM₁' H +
        ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : M₁') ^ (i - 1) * IntermediateField.inclusion hLM₁' (s_LM₁' s i) *
            s ^ (p - i) at hcay
    linear_combination hcay
  have hs_pow_M₁' :
      s ^ p - IntermediateField.inclusion hLM₁' H = 0 ∨
        B_M₁' ≤ valL F M₁' (s ^ p - IntermediateField.inclusion hLM₁' H) := by
    rw [hs_cayley_eq]
    apply hvalM₁'_sum_ge (Finset.Icc 1 (p - 1))
      (fun i =>
        (-1 : M₁') ^ (i - 1) * IntermediateField.inclusion hLM₁' (s_LM₁' s i) * s ^ (p - i))
      B_M₁'
    intro i hi
    obtain ⟨hs_cond, hB_le⟩ := hcay_arith bM₁' le_rfl i hi
    let m_si : ℤ := ((i : ℤ) * q_s + ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ)) / (p : ℤ)
    have hs_i_L : s_LM₁' s i = 0 ∨ m_si ≤ valL F L (s_LM₁' s i) :=
      hs_LM₁'_val s i hi q_s m_si hs_val_M₁' hs_cond
    have hs_i_M₁' :
        IntermediateField.inclusion hLM₁' (s_LM₁' s i) = 0 ∨
          (p : ℤ) * m_si ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (s_LM₁' s i)) := by
      rcases hs_i_L with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LM₁' (s_LM₁' s i)]
        exact mul_le_mul_of_nonneg_left hge (by positivity)
    have hneg_i : (-1 : M₁') ^ (i - 1) = 0 ∨ 0 ≤ valL F M₁' ((-1 : M₁') ^ (i - 1)) :=
      Or.inr (by rw [(hneg1_pow_M₁' (i - 1)).2])
    have hs_pi : s ^ (p - i) = 0 ∨ ((p - i : ℕ) : ℤ) * q_s ≤ valL F M₁' (s ^ (p - i)) :=
      hvalM₁'_pow_ge s (p - i) q_s hs_val_M₁'
    have h1 := hvalM₁'_mul_ge 0 ((p : ℤ) * m_si)
      ((-1 : M₁') ^ (i - 1)) (IntermediateField.inclusion hLM₁' (s_LM₁' s i))
      hneg_i hs_i_M₁'
    have h2 := hvalM₁'_mul_ge (0 + (p : ℤ) * m_si) (((p - i : ℕ) : ℤ) * q_s)
