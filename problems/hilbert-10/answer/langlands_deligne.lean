  have hvinv_val : valL F L v_inv = -(δ : ℤ) := by
    dsimp [v_inv]
    rw [hvalL_mul α (c_νM₁' : L) hα_ne0 hcM_ne0, hα_val, hc_νM₁'_val]
    dsimp [δ, bE', bM₁', nL]
    omega
  have hincl_neg_vinv_val :
      valL F M₁' (- IntermediateField.inclusion hLM₁' v_inv) = -(p : ℤ) * (δ : ℤ) := by
    rw [hvalM₁'_neg, hval_LM₁' v_inv, hvinv_val]
    ring
  have hneg_vinv_pow : (-v_inv) ^ p = - (v_inv ^ p) := by
    conv_lhs => rw [hp_odd_split]
    conv_rhs => rw [hp_odd_split]
    simp only [pow_add, pow_mul, pow_one]
    have hsq : (-v_inv) ^ 2 = v_inv ^ 2 := by ring
    rw [hsq]
    ring
  have hnorm_neg_vinv :
      normLM F hLM₁' (- IntermediateField.inclusion hLM₁' v_inv) = - (v_inv ^ p) := by
    have hmap : - IntermediateField.inclusion hLM₁' v_inv =
        IntermediateField.inclusion hLM₁' (-v_inv) :=
      (map_neg (IntermediateField.inclusion hLM₁') v_inv).symm
    rw [hmap, hnorm_incl_LM₁' (-v_inv), hneg_vinv_pow]
  let A : L := 2 * α * v_inv ^ (p - 1) * (H - v ^ (p - 1))
  have hψ_A_vanish : ∀ x : M₁', (x = 0 ∨ (q : ℤ) ≤ valL F M₁' x) →
      ψ (A * normLM F hLM₁' (P_M₁' x)) = 1 := by
    intro x hx
    let wx : M₁' := - IntermediateField.inclusion hLM₁' v_inv * s * P_M₁' x
    have hwx_val : wx = 0 ∨ (q₀ : ℤ) ≤ valL F M₁' wx := by
      have h1 := hvalM₁'_mul_ge (-(p : ℤ) * (δ : ℤ)) (((p - 1 : ℕ) : ℤ) * (δ : ℤ))
        (- IntermediateField.inclusion hLM₁' v_inv) s
        (Or.inr (by rw [hincl_neg_vinv_val])) hs_val
      have h2 := hvalM₁'_mul_ge (-(p : ℤ) * (δ : ℤ) + ((p - 1 : ℕ) : ℤ) * (δ : ℤ)) (q : ℤ)
        (- IntermediateField.inclusion hLM₁' v_inv * s) (P_M₁' x) h1 (hPM₁'_val x hx)
      have heq_q0 : -(p : ℤ) * (δ : ℤ) + ((p - 1 : ℕ) : ℤ) * (δ : ℤ) + (q : ℤ) = (q₀ : ℤ) := by
        rw [hq₀_eq_ct]
        dsimp [q]
        push_cast
        have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
        rw [hp1]
        ring
      rw [heq_q0] at h2
      exact h2
    have hconv := hConv_M₁' wx hwx_val
    have hlhs_eq : 2 * IntermediateField.inclusion hLM₁' β * wx =
        - 2 * IntermediateField.inclusion hLM₁' α * s * P_M₁' x := by
      have hmap_mul : IntermediateField.inclusion hLM₁' β * IntermediateField.inclusion hLM₁' v_inv =
          IntermediateField.inclusion hLM₁' α := by
        rw [← map_mul, hβ_vinv]
      calc 2 * IntermediateField.inclusion hLM₁' β * wx
          = - 2 * (IntermediateField.inclusion hLM₁' β * IntermediateField.inclusion hLM₁' v_inv) *
              s * P_M₁' x := by dsimp [wx]; ring
        _ = - 2 * IntermediateField.inclusion hLM₁' α * s * P_M₁' x := by rw [hmap_mul]
    have hrhs_eq : - 2 * β * normLM F hLM₁' wx =
        2 * α * v_inv ^ (p - 1) * H * normLM F hLM₁' (P_M₁' x) := by
      have hnorm_wx : normLM F hLM₁' wx =
          - (v_inv ^ p) * H * normLM F hLM₁' (P_M₁' x) := by
        dsimp [wx, H]
        rw [map_mul, map_mul, hnorm_neg_vinv]
      rw [hnorm_wx]
      calc - 2 * β * (- (v_inv ^ p) * H * normLM F hLM₁' (P_M₁' x))
          = 2 * (β * v_inv ^ p) * H * normLM F hLM₁' (P_M₁' x) := by ring
        _ = 2 * α * v_inv ^ (p - 1) * H * normLM F hLM₁' (P_M₁' x) := by rw [hβ_vinv_p]; ring
    change ψM₁' (2 * IntermediateField.inclusion hLM₁' β * wx) =
      ψ (- 2 * β * normLM F hLM₁' wx) at hconv
    rw [hlhs_eq, hrhs_eq, hchar_comp x hx] at hconv
    let Nx : L := normLM F hLM₁' (P_M₁' x)
    have hsplit_A : 2 * α * v_inv ^ (p - 1) * H * Nx =
        A * Nx + 2 * α * Nx := by
      calc 2 * α * v_inv ^ (p - 1) * H * Nx
          = 2 * α * v_inv ^ (p - 1) * (H - v ^ (p - 1)) * Nx +
              2 * α * (v ^ (p - 1) * v_inv ^ (p - 1)) * Nx := by ring
        _ = A * Nx + 2 * α * Nx := by rw [hv_vinv_pow]; dsimp [A]; ring
    change ψ (2 * α * Nx) = ψ (2 * α * v_inv ^ (p - 1) * H * Nx) at hconv
    rw [hsplit_A, AddChar.map_add_eq_mul] at hconv
    have hcancel_Nx : ψ (2 * α * Nx) * ψ (-(2 * α * Nx)) = 1 := by
      rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
    calc ψ (A * Nx)
        = ψ (A * Nx) * (ψ (2 * α * Nx) * ψ (-(2 * α * Nx))) := by rw [hcancel_Nx, mul_one]
      _ = (ψ (A * Nx) * ψ (2 * α * Nx)) * ψ (-(2 * α * Nx)) := by rw [mul_assoc (ψ (A * Nx))]
      _ = ψ (2 * α * Nx) * ψ (-(2 * α * Nx)) := by rw [← hconv]
      _ = 1 := hcancel_Nx
  
  have hPM₁'_factor : ∀ (x : M₁') (m : ℤ), 1 ≤ m → (x = 0 ∨ m ≤ valL F M₁' x) →
      ∃ zx : M₁', P_M₁' x = x * (1 - zx) ∧ (zx = 0 ∨ m ≤ valL F M₁' zx) := by
    intro x m hm1 hx
    let S : Finset ℕ := (Finset.Icc 1 (p - 1)).erase 1
    let zx : M₁' := - ∑ j ∈ S, ((j : ℕ) : M₁')⁻¹ * x ^ (j - 1)
    refine ⟨zx, ?_, ?_⟩
    · dsimp [P_M₁', zx]
      have h1_mem : 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
      rw [← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) _ h1_mem]
      have hsum_eq : (∑ j ∈ S, ((j : ℕ) : M₁')⁻¹ * x ^ j) =
          x * (∑ j ∈ S, ((j : ℕ) : M₁')⁻¹ * x ^ (j - 1)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl ?_
        intro j hj
        have hj_ne1 : j ≠ 1 := (Finset.mem_erase.mp hj).1
        have hj_ge1 : 1 ≤ j := (Finset.mem_Icc.mp (Finset.mem_erase.mp hj).2).1
        have hpow_j : x ^ j = x ^ (j - 1) * x := by
          rw [← pow_succ, show j - 1 + 1 = j by omega]
        rw [hpow_j]
        ring
      change ((1 : ℕ) : M₁')⁻¹ * x ^ 1 + ∑ j ∈ S, ((j : ℕ) : M₁')⁻¹ * x ^ j =
        x * (1 - - ∑ j ∈ S, ((j : ℕ) : M₁')⁻¹ * x ^ (j - 1))
      rw [hsum_eq]
      simp only [Nat.cast_one, inv_one, one_mul, pow_one]
      ring
    · dsimp [zx]
      have hsum_val : (∑ j ∈ S, ((j : ℕ) : M₁')⁻¹ * x ^ (j - 1)) = 0 ∨
          m ≤ valL F M₁' (∑ j ∈ S, ((j : ℕ) : M₁')⁻¹ * x ^ (j - 1)) := by
        refine hvalM₁'_sum_nat_ge S _ m ?_
        intro j hj
        have hj_ne1 : j ≠ 1 := (Finset.mem_erase.mp hj).1
        have hj_bounds : 1 ≤ j ∧ j ≤ p - 1 := Finset.mem_Icc.mp (Finset.mem_erase.mp hj).2
        have hj1_ge1 : 1 ≤ j - 1 := by omega
        have hj_inv_val : valL F M₁' (((j : ℕ) : M₁')⁻¹) = 0 :=
          (hvalM₁'_coprime_inv j hj_bounds.1 (by omega)).2
        have hx_pow := hvalM₁'_pow_ge x (j - 1) m hx
        have hmul := hvalM₁'_mul_ge 0 (((j - 1 : ℕ) : ℤ) * m) (((j : ℕ) : M₁')⁻¹) (x ^ (j - 1))
          (Or.inr (by rw [hj_inv_val])) hx_pow
        refine hvalM₁'_mono m (0 + ((j - 1 : ℕ) : ℤ) * m) _ ?_ hmul
        nlinarith [hj1_ge1, hm1]
      rcases hsum_val with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rw [hvalM₁'_neg]; exact hle
  
  change H - v ^ (p - 1) = 0 ∨ ((R : ℕ) : ℤ) ≤ valL F L (H - v ^ (p - 1))
  by_cases hdiff_0 : H - v ^ (p - 1) = 0
  · exact Or.inl hdiff_0
  · right
    by_contra! hval_lt
    have hval_diff_le : valL F L (H - v ^ (p - 1)) ≤ ((R : ℕ) : ℤ) - 1 := by omega
    have hvinv_pow_ne0 : v_inv ^ (p - 1) ≠ 0 := pow_ne_zero (p - 1) hvinv_ne0
    have hvinv_pow_val : valL F L (v_inv ^ (p - 1)) = -((p - 1 : ℕ) : ℤ) * (δ : ℤ) := by
      have hpow := hvalL_pow_ge v_inv (p - 1) (-(δ : ℤ)) (Or.inr (by rw [hvinv_val]))
      have hpow_inv := hvalL_pow_ge (v_inv⁻¹) (p - 1) (δ : ℤ)
        (Or.inr (by rw [hvalL_inv_eq v_inv hvinv_ne0, hvinv_val, neg_neg]))
      have hge : ((p - 1 : ℕ) : ℤ) * (-(δ : ℤ)) ≤ valL F L (v_inv ^ (p - 1)) :=
        hpow.resolve_left hvinv_pow_ne0
      have hvinv_inv_pow_ne0 : (v_inv⁻¹) ^ (p - 1) ≠ 0 :=
        pow_ne_zero (p - 1) (inv_ne_zero hvinv_ne0)
      have hge_inv : ((p - 1 : ℕ) : ℤ) * (δ : ℤ) ≤ valL F L ((v_inv⁻¹) ^ (p - 1)) :=
        hpow_inv.resolve_left hvinv_inv_pow_ne0
      rw [inv_pow, hvalL_inv_eq (v_inv ^ (p - 1)) hvinv_pow_ne0] at hge_inv
      linarith
    have h2α_ne0 : 2 * α ≠ 0 := mul_ne_zero h2_ne hα_ne0
    have h2αv_ne0 : 2 * α * v_inv ^ (p - 1) ≠ 0 := mul_ne_zero h2α_ne0 hvinv_pow_ne0
    have hA_ne0 : A ≠ 0 := mul_ne_zero h2αv_ne0 hdiff_0
    have hA_val : valL F L A =
        -((bE' : ℤ) + nL) - ((p - 1 : ℕ) : ℤ) * (δ : ℤ) + valL F L (H - v ^ (p - 1)) := by
      dsimp [A]
      rw [hvalL_mul (2 * α * v_inv ^ (p - 1)) (H - v ^ (p - 1)) h2αv_ne0 hdiff_0,
        hvalL_mul (2 * α) (v_inv ^ (p - 1)) h2α_ne0 hvinv_pow_ne0,
        hvalL_mul 2 α h2_ne hα_ne0, hvalL_2, hα_val, hvinv_pow_val]
      ring
    have hA_val_le : valL F L A ≤ -nL - 1 - (q : ℤ) := by
      linarith [hRq_eq, hval_diff_le, hA_val]
    obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_nontriv⟩ := hx₁_exists
    let u : L := A⁻¹ * x₁
    have hu_ne0 : u ≠ 0 := mul_ne_zero (inv_ne_zero hA_ne0) hx₁_ne0
    have hAu : A * u = x₁ := mul_inv_cancel_left₀ hA_ne0 x₁
    let m : ℤ := valL F L u
    have hm_eq : m = - valL F L A + valL F L x₁ := by
      dsimp [m, u]
      rw [hvalL_mul A⁻¹ x₁ (inv_ne_zero hA_ne0) hx₁_ne0, hvalL_inv_eq A hA_ne0]
    have hm_ge_q : (q : ℤ) ≤ m := by
      dsimp [nL] at hA_val_le
      omega
    have hm_ge_q₀ : (q₀ : ℤ) ≤ m := by
      rw [hq₀_eq_ct]
      dsimp [q] at hm_ge_q
      omega
    have hm_ge1 : 1 ≤ m := by omega
    obtain ⟨cm, hcm_val⟩ := hvalM₁'_surj m
    let Nm : L := normLM F hLM₁' (cm : M₁')
    have hNm_unit : Nm = ((Units.map (normLM F hLM₁') cm : Lˣ) : L) := rfl
    have hNm_ne0 : Nm ≠ 0 := by
      rw [hNm_unit]
      exact (Units.map (normLM F hLM₁') cm).ne_zero
    have hNm_val : valL F L Nm = m := by
      dsimp [Nm]
      rw [hval_norm_LM₁' (cm : M₁'), hcm_val]
    let u₀' : L := u * Nm⁻¹
    have hu₀'_ne0 : u₀' ≠ 0 := mul_ne_zero hu_ne0 (inv_ne_zero hNm_ne0)
    have hu₀'_Nm : u₀' * Nm = u := inv_mul_cancel_right₀ hNm_ne0 u
    have hu₀'_val0 : valL F L u₀' = 0 := by
      dsimp [u₀']
      rw [hvalL_mul u Nm⁻¹ hu_ne0 (inv_ne_zero hNm_ne0), hvalL_inv_eq Nm hNm_ne0, hNm_val]
      dsimp [m]
      ring
    obtain ⟨s_L, hs_L_int, hs_L_frob⟩ := hfrob_surj u₀' (Or.inr (by rw [hu₀'_val0]))
    let x : M₁' := IntermediateField.inclusion hLM₁' s_L * (cm : M₁')
    have hs_L_M_int : IntermediateField.inclusion hLM₁' s_L = 0 ∨
        0 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' s_L) := by
      rcases hs_L_int with rfl | hs_ge0
      · left; simp
      · right; rw [hval_LM₁']; nlinarith [hp_pos]
    have hx_m : x = 0 ∨ m ≤ valL F M₁' x := by
      have h1 := hvalM₁'_mul_ge 0 m (IntermediateField.inclusion hLM₁' s_L) (cm : M₁')
        hs_L_M_int (Or.inr (by rw [hcm_val]))
      simpa [x] using h1
    have hx_q : x = 0 ∨ (q : ℤ) ≤ valL F M₁' x :=
      hvalM₁'_mono (q : ℤ) m x hm_ge_q hx_m
    obtain ⟨zx, hPM_eq, hzx_m⟩ := hPM₁'_factor x m hm_ge1 hx_m
    have hzx_q₀ : zx = 0 ∨ (q₀ : ℤ) ≤ valL F M₁' zx :=
      hvalM₁'_mono (q₀ : ℤ) m zx hm_ge_q₀ hzx_m
    let uz : L := 1 - normLM F hLM₁' (1 - zx)
    have huz_q₀ : uz = 0 ∨ (q₀ : ℤ) ≤ valL F L uz := hNorm_1_sub zx hzx_q₀
    have huz_1 : uz = 0 ∨ (1 : ℤ) ≤ valL F L uz :=
      hvalL_mono 1 (q₀ : ℤ) uz (by exact_mod_cast hq₀_ge1) huz_q₀
    have hnorm_PM : normLM F hLM₁' (P_M₁' x) = s_L ^ p * Nm * (1 - uz) := by
      have h1 : normLM F hLM₁' (1 - zx) = 1 - uz := by dsimp [uz]; ring
      rw [hPM_eq, map_mul, h1]
      dsimp [x, Nm]
      rw [map_mul, hnorm_incl_LM₁' s_L]
    have hdiff_u : normLM F hLM₁' (P_M₁' x) - u =
        - ((u₀' - s_L ^ p) + s_L ^ p * uz) * Nm := by
      rw [hnorm_PM, ← hu₀'_Nm]
      ring
    have hs_L_p_int : s_L ^ p = 0 ∨ (0 : ℤ) ≤ valL F L (s_L ^ p) := by
      have h1 := hvalL_pow_ge s_L p 0 hs_L_int
      simpa using h1
    have hs_L_uz_1 : s_L ^ p * uz = 0 ∨ (1 : ℤ) ≤ valL F L (s_L ^ p * uz) := by
      have h1 := hvalL_mul_ge 0 1 (s_L ^ p) uz hs_L_p_int huz_1
      simpa using h1
    have hsum_1 : (u₀' - s_L ^ p) + s_L ^ p * uz = 0 ∨
        (1 : ℤ) ≤ valL F L ((u₀' - s_L ^ p) + s_L ^ p * uz) :=
      hvalL_add 1 (u₀' - s_L ^ p) (s_L ^ p * uz) hs_L_frob hs_L_uz_1
    have hneg_sum_1 : - ((u₀' - s_L ^ p) + s_L ^ p * uz) = 0 ∨
        (1 : ℤ) ≤ valL F L (- ((u₀' - s_L ^ p) + s_L ^ p * uz)) := by
      rcases hsum_1 with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rw [hvalL_neg]; exact hle
    have hdiff_u_val : normLM F hLM₁' (P_M₁' x) - u = 0 ∨
        1 + m ≤ valL F L (normLM F hLM₁' (P_M₁' x) - u) := by
      rw [hdiff_u]
      exact hvalL_mul_ge 1 m (- ((u₀' - s_L ^ p) + s_L ^ p * uz)) Nm
        hneg_sum_1 (Or.inr (by rw [hNm_val]))
    have hA_diff_eq : A * normLM F hLM₁' (P_M₁' x) - x₁ =
        A * (normLM F hLM₁' (P_M₁' x) - u) := by
      calc A * normLM F hLM₁' (P_M₁' x) - x₁
          = A * normLM F hLM₁' (P_M₁' x) - A * u := by rw [hAu]
        _ = A * (normLM F hLM₁' (P_M₁' x) - u) := by ring
    have hA_diff_val : A * normLM F hLM₁' (P_M₁' x) - x₁ = 0 ∨
        -nL ≤ valL F L (A * normLM F hLM₁' (P_M₁' x) - x₁) := by
      rw [hA_diff_eq]
      have hmul := hvalL_mul_ge (valL F L A) (1 + m) A (normLM F hLM₁' (P_M₁' x) - u)
        (Or.inr le_rfl) hdiff_u_val
      refine hvalL_mono (-nL) (valL F L A + (1 + m)) _ ?_ hmul
      dsimp [nL] at *
      omega
    have hψ_diff_1 : ψ (A * normLM F hLM₁' (P_M₁' x) - x₁) = 1 :=
      hψ_triv (A * normLM F hLM₁' (P_M₁' x) - x₁) hA_diff_val
    have hψ_AN_1 : ψ (A * normLM F hLM₁' (P_M₁' x)) = 1 :=
      hψ_A_vanish x hx_q
    have hsplit_x₁ : A * normLM F hLM₁' (P_M₁' x) =
        (A * normLM F hLM₁' (P_M₁' x) - x₁) + x₁ := by ring
    rw [hsplit_x₁, AddChar.map_add_eq_mul, hψ_diff_1, one_mul] at hψ_AN_1
    exact hx₁_nontriv hψ_AN_1

theorem ld_ch12_wild_odd_totally_ramified_symm_norm_char_congruence_p3 (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
