    conv_lhs => rw [← List.ofFn_get D_orb, List.map_ofFn, List.prod_ofFn]
    rfl
  have h_prod_t :
      (D_orb.map fun t =>
        tateEps F t.field
          (recChar F rec t.field t.χ * χ'.comp (Units.map (normLM F t.le)))
          (traceChar F t.le ψ)).prod =
      ∏ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (traceChar F (D_orb.get i).le ψ) := by
    conv_lhs => rw [← List.ofFn_get D_orb, List.map_ofFn, List.prod_ofFn]
    rfl
  refine ⟨k₁, ?_⟩
  dsimp only
  rw [h_prod_u, h_prod_t]
  exact hk₁

theorem ld_ch14_lemma_14_2_and_14_3_stickelberger_pow (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (h_ge2 : 2 ≤ condExp F L (recChar F rec L χL_ext)) :
    (∃ k₁ : ℕ,
      (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ ((2 * p F) ^ k₁) =
      (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ ((2 * p F) ^ k₁)) ∧
    ((p F ≠ 2 ∧
      ∀ q : ℕ, Nat.Prime q → q ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) →
        q = 2 ∨ q = p F) →
      ∃ k₁ : ℕ,
        (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ ((p F) ^ k₁) =
        (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ
            ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ ((p F) ^ k₁)) :=
by
  obtain ⟨hFinL, hFinMC, hFinE, hFinK, hGalMCK, hSepLE, hψMC, hψE, hψK,
      hLMC_gt1, hq_gt1, hr_pos, hDegSum, hχ'_cond, hχ'E_cond, hOrb_rec, hPowRed⟩ :=
    ld_ch14_stickelberger_orbit_recChar_and_pow_reduction F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin h_wild hFinE_eq
      χL_ext hχL_ext D_orb hD₁_sub hD_orb_deg hD_orb_props h_ge2
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F M_C := hFinMC
  haveI : FiniteDimensional F E := hFinE
  haveI : FiniteDimensional F K := hFinK
  refine ⟨?_, ?_⟩
  · obtain ⟨k₁, hk₁⟩ :=
      ld_ch14_lemma_14_2b_wild_semidirect_stickelberger_2p F rec L K M_C E hLK hLM_C hM_CK hLE hEK
        h_inf h_sup hLM_C_lt hCore hGal hGalMCK hSepLE ψ hψ hψMC hψE hψK hMin h_wild hFinE_eq
        χL_ext hχL_ext D_orb hD₁_sub hDegSum hD_orb_props h_ge2 hχ'_cond hχ'E_cond hOrb_rec
        (fun M _ ψ_M hψM θ hm c'_θ hc_val hc_top =>
          (ld_ch14_single_field_stationary_phase_pow F M ψ_M hψM θ hm c'_θ hc_val hc_top).1)
    exact ⟨k₁, hPowRed ((2 * p F) ^ k₁) hk₁⟩
  · intro hBranch2
    obtain ⟨k₁, hk₁⟩ :=
      ld_ch14_lemma_14_3_wild_semidirect_stickelberger_p F rec L K M_C E hLK hLM_C hM_CK hLE hEK
        h_inf h_sup hLM_C_lt hCore hGal hGalMCK hSepLE ψ hψ hψMC hψE hψK hMin h_wild hFinE_eq
        χL_ext hχL_ext D_orb hD₁_sub hDegSum hD_orb_props h_ge2 hχ'_cond hχ'E_cond hOrb_rec
        (fun M _ ψ_M hψM θ hm heven c'_θ hc_val hc_top =>
          (ld_ch14_single_field_stationary_phase_pow F M ψ_M hψM θ hm c'_θ hc_val hc_top).2.1 heven)
        (fun M _ ψ_M hψM θ hm hp_ne2 hodd c'_θ hc_val hc_top =>
          (ld_ch14_single_field_stationary_phase_pow F M ψ_M hψM θ hm c'_θ hc_val hc_top).2.2 hp_ne2 hodd)
        hBranch2
    exact ⟨k₁, hPowRed ((p F) ^ k₁) hk₁⟩

theorem ld_ch14_single_field_coprime_weil_twist_pow_invariance (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (M K₀ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] [FiniteDimensional F K₀]
    (hMK₀ : M ≤ K₀)
    (ψ_M : AddChar M (Ω F)) (hψM : IsAdmissibleChar F M ψ_M)
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀) (hq₀_ne_p : q₀ ≠ p F)
    (ν : relWeil F M →* (Ω F)ˣ)
    (hν_rest : restrictWeilChar F hMK₀ ν = 1)
    (hν_pow : ν ^ q₀ = 1) :
    IsWeilRep F M (charRep F M ν) ∧
    condExp F M (recChar F rec M ν) ≤ 1 ∧
    ∀ (β : relWeil F M →* (Ω F)ˣ),
      IsWeilRep F M (charRep F M β) →
      2 ≤ condExp F M (recChar F rec M β) →
      (tateEpsUnit F M (recChar F rec M (ν * β)) ψ_M) ^ q₀ =
        (tateEpsUnit F M (recChar F rec M β) ψ_M) ^ q₀ :=
by
  have hFin_ULift : FiniteDimensional (Ω F) (ULift.{u} (Ω F)) :=
    Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm
  have hν_weil : IsWeilRep F M (charRep F M ν) := by
    let U : Set (AbsGal F) := (K₀.fixingSubgroup : Set (AbsGal F))
    have hU_nhds : U ∈ nhds (1 : AbsGal F) :=
      (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U).mpr
        ⟨K₀, inferInstance, Set.Subset.rfl⟩
    refine ⟨hFin_ULift, U, hU_nhds, fun w hwU _ => ?_⟩
    let w_K₀ : relWeil F K₀ := ⟨w.1, ⟨w.2.1, hwU⟩⟩
    have hw_eq : Subgroup.inclusion (relWeil_antitone F hMK₀) w_K₀ = w :=
      Subtype.ext rfl
    have hνw : ν w = 1 := by
      rw [← hw_eq]
      change (restrictWeilChar F hMK₀ ν) w_K₀ = 1
      rw [hν_rest, MonoidHom.one_apply]
    apply LinearMap.ext
    intro v
    change (ν w : Ω F) • v = v
    rw [hνw, Units.val_one, one_smul]
  obtain ⟨hp_prime, _⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨_, _, _, _, _, halg1, _⟩ := ld_addVal_finset_and_algebraMap_valL F M
  obtain ⟨hval0, hval1, _, hval_neg, hval_mul, _, _, hval_add, hUG_0, hUG_ge1, hUG_val0⟩ :=
    ld_valL_and_unitGroup_props F M
  obtain ⟨_, hSepRec_all⟩ := ld_separable_weil_char_rec_and_norm F rec
  obtain ⟨_, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  let ν'_M : Mˣ →* (Ω F)ˣ := recChar F rec M ν
  obtain ⟨ν₀', hν₀'_rec, hν₀'_cond, _⟩ := hSepRec_all M ν hν_weil
  have hν'_eq : ν'_M = ν₀' :=
    (htateEps M ψ_M hψM ν hν_weil ν₀' hν₀'_rec).1
  have hν'_rec : ∀ x : Mˣ, ν'_M x = ν (rec.recMap M x) := by
    rw [hν'_eq]; exact hν₀'_rec
  have hν'_cond : ∀ u ∈ unitGroup F M (condExp F M ν'_M), ν'_M u = 1 := by
    rw [hν'_eq]; exact hν₀'_cond
  have hν'_pow : ∀ x : Mˣ, (ν'_M x) ^ q₀ = 1 := by
    intro x
    rw [hν'_rec x, ← MonoidHom.pow_apply, hν_pow, MonoidHom.one_apply]
  let PM (k : ℤ) (z : M) : Prop := z = 0 ∨ k ≤ valL F M z
  have hPM_zero : ∀ k : ℤ, PM k 0 := fun _ => Or.inl rfl
  have hPM_one : PM 0 1 := Or.inr (by rw [hval1])
  have hPM_mono : ∀ {k₁ k₂ : ℤ} {z : M}, k₁ ≤ k₂ → PM k₂ z → PM k₁ z := by
    intro k₁ k₂ z hle hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (hle.trans hz)
  have hPM_add : ∀ {k : ℤ} {z₁ z₂ : M}, PM k z₁ → PM k z₂ → PM k (z₁ + z₂) :=
    fun hz₁ hz₂ => hval_add _ _ _ hz₁ hz₂
  have hPM_mul : ∀ {k₁ k₂ : ℤ} {z₁ z₂ : M}, PM k₁ z₁ → PM k₂ z₂ → PM (k₁ + k₂) (z₁ * z₂) := by
    intro k₁ k₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · left; rw [hz₁0, zero_mul]
    · by_cases hz₂0 : z₂ = 0
      · left; rw [hz₂0, mul_zero]
      · right
        rw [hval_mul z₁ z₂ hz₁0 hz₂0]
        have h1 := hz₁.resolve_left hz₁0
        have h2 := hz₂.resolve_left hz₂0
        omega
  have hPM_pow0 : ∀ (z : M) (n : ℕ), PM 0 z → PM 0 (z ^ n) := by
    intro z n hz
    induction n with
    | zero => rw [pow_zero]; exact hPM_one
    | succ n ih =>
      rw [pow_succ, ← zero_add (0 : ℤ)]
      exact hPM_mul ih hz
  have hPM_nat : ∀ n : ℕ, PM 0 (n : M) := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero]; exact hPM_zero 0
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hPM_add ih hPM_one
  have hPM_sum : ∀ {k : ℤ} (s : Finset ℕ) (f : ℕ → M),
      (∀ i ∈ s, PM k (f i)) → PM k (∑ i ∈ s, f i) := by
    intro k s f hf
    induction s using Finset.induction_on with
    | empty => rw [Finset.sum_empty]; exact hPM_zero k
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hPM_add (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have hp_valM : PM 1 ((p F : ℕ) : M) := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] ((p F : ℕ) : 𝒪[F]) = 0 := by
      rw [map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (p F)
    have hker : valuation F (((p F : ℕ) : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    have hpF : ((p F : ℕ) : F) = 0 ∨ 1 ≤ addVal F ((p F : ℕ) : F) := by
      by_cases hp0 : ((p F : ℕ) : F) = 0
      · exact Or.inl hp0
      · right
        have hφp : φ (valuation F ((p F : ℕ) : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
        have hlt : φ (valuation F ((p F : ℕ) : F)) < 1 := by
          rw [← map_one φ, map_lt_map_iff φ]
          exact hker
        rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
          ← Multiplicative.toAdd_lt, toAdd_one] at hlt
        unfold addVal
        rw [dif_neg hp0]
        omega
    have h := halg1 ((p F : ℕ) : F) hpF
    rwa [map_natCast (algebraMap F M) (p F)] at h
  have hUG_PM : ∀ {a : ℕ} (ha : 1 ≤ a) (u : Mˣ),
      u ∈ unitGroup F M a ↔ PM (a : ℤ) ((u : M) - 1) := by
    intro a ha u
    rw [hUG_ge1 a ha u]
    unfold PM
    rw [sub_eq_zero]
  have hUG_pow_p : ∀ {m : ℕ} (hm : 1 ≤ m) {u : Mˣ},
      u ∈ unitGroup F M m → u ^ (p F) ∈ unitGroup F M (m + 1) := by
    intro m hm u hu
    rw [hUG_PM (by omega) (u ^ (p F))]
    have hx : PM (m : ℤ) ((u : M) - 1) := (hUG_PM hm u).mp hu
    set x : M := (u : M) - 1
    have hx0 : PM 0 x := hPM_mono (by omega) hx
    have hu_eq : (u : M) = x + 1 := by dsimp [x]; ring
    have hp_pos : 0 < p F := hp_prime.pos
    have hp_two : 2 ≤ p F := hp_prime.two_le
    have h_binom : ((u ^ (p F) : Mˣ) : M) - 1 =
        (∑ i ∈ Finset.range (p F - 1),
          x ^ (i + 1) * 1 ^ (p F - (i + 1)) * ((p F).choose (i + 1) : M)) +
          x ^ (p F) := by
      rw [Units.val_pow_eq_pow_val, hu_eq, add_pow x 1 (p F), Finset.sum_range_succ]
      have hp_split : p F = (p F - 1) + 1 := by omega
      conv_lhs =>
        enter [1, 1, 1]
        rw [hp_split]
      rw [Finset.sum_range_succ']
      simp only [Nat.sub_self, pow_zero, one_pow, mul_one,
        Nat.choose_zero_right, Nat.choose_self, Nat.cast_one]
      ring
    rw [h_binom]
    have h_sum_PM : PM ((m + 1 : ℕ) : ℤ)
        (∑ i ∈ Finset.range (p F - 1),
          x ^ (i + 1) * 1 ^ (p F - (i + 1)) * ((p F).choose (i + 1) : M)) := by
      apply hPM_sum
      intro i hi
      rw [Finset.mem_range] at hi
      obtain ⟨c, hc⟩ :=
        Nat.Prime.dvd_choose_self hp_prime (Nat.succ_ne_zero i) (by omega)
      have hchoose_PM : PM 1 (((p F).choose (i + 1) : ℕ) : M) := by
        rw [hc, Nat.cast_mul, ← add_zero (1 : ℤ)]
        exact hPM_mul hp_valM (hPM_nat c)
      have hx_pow_PM : PM (m : ℤ) (x ^ (i + 1)) := by
        rw [pow_succ, ← zero_add (m : ℤ)]
        exact hPM_mul (hPM_pow0 x i hx0) hx
      simp only [one_pow, mul_one]
      have h_prod : PM ((m : ℤ) + 1) (x ^ (i + 1) * (((p F).choose (i + 1) : ℕ) : M)) :=
        hPM_mul hx_pow_PM hchoose_PM
      exact hPM_mono (by omega) h_prod
    have hx_top_PM : PM ((m + 1 : ℕ) : ℤ) (x ^ (p F)) := by
      have hp2 : p F = (p F - 2) + 2 := by omega
      rw [hp2, pow_add, sq]
      have h_prod : PM (0 + ((m : ℤ) + (m : ℤ))) (x ^ (p F - 2) * (x * x)) :=
        hPM_mul (hPM_pow0 x (p F - 2) hx0) (hPM_mul hx hx)
      exact hPM_mono (by omega) h_prod
    exact hPM_add h_sum_PM hx_top_PM
  have hUG_pow_iter : ∀ (k : ℕ) {u : Mˣ},
      u ∈ unitGroup F M 1 → u ^ ((p F) ^ k) ∈ unitGroup F M (1 + k) := by
    intro k u hu
    induction k with
    | zero =>
      rw [pow_zero, pow_one, Nat.add_zero]
      exact hu
    | succ k ih =>
      rw [pow_succ, pow_mul, ← Nat.add_assoc]
      exact hUG_pow_p (by omega) ih
  have hν'_UG1 : ∀ u ∈ unitGroup F M 1, ν'_M u = 1 := by
    intro u hu
    let a := condExp F M ν'_M
    have hu_pa : (ν'_M u) ^ ((p F) ^ a) = 1 := by
      rw [← map_pow]
      by_cases ha0 : a = 0
      · have hu_a : u ^ ((p F) ^ a) ∈ unitGroup F M a := by
          rw [ha0, hUG_0]
          exact hUG_val0 1 _ (by simpa [ha0] using hUG_pow_iter a hu)
        exact hν'_cond _ hu_a
      · have ha1 : 1 ≤ a := by omega
        have hu_1a : u ^ ((p F) ^ a) ∈ unitGroup F M (1 + a) := hUG_pow_iter a hu
        have hu_a : u ^ ((p F) ^ a) ∈ unitGroup F M a := by
          rw [hUG_PM ha1]
          exact hPM_mono (by omega) ((hUG_PM (by omega) _).mp hu_1a)
        exact hν'_cond _ hu_a
    have hcop : Nat.Coprime q₀ ((p F) ^ a) :=
      ((Nat.coprime_primes hq₀_prime hp_prime).mpr hq₀_ne_p).pow_right a
    have hgcd : (q₀.gcd ((p F) ^ a) : ℤ) = 1 := by exact_mod_cast hcop.gcd_eq_one
    have hab := Nat.gcd_eq_gcd_ab q₀ ((p F) ^ a)
    rw [hgcd] at hab
    calc ν'_M u = (ν'_M u) ^ (1 : ℤ) := (zpow_one _).symm
      _ = (ν'_M u) ^ ((q₀ : ℤ) * q₀.gcdA ((p F) ^ a) +
            (((p F) ^ a : ℕ) : ℤ) * q₀.gcdB ((p F) ^ a)) := by rw [← hab]
      _ = ((ν'_M u) ^ q₀) ^ (q₀.gcdA ((p F) ^ a)) *
            ((ν'_M u) ^ ((p F) ^ a)) ^ (q₀.gcdB ((p F) ^ a)) := by
          rw [zpow_add, zpow_mul, zpow_mul, zpow_natCast, zpow_natCast]
      _ = 1 := by rw [hν'_pow u, hu_pa, one_zpow, one_zpow, mul_one]
  have hν'_cond_le1 : condExp F M ν'_M ≤ 1 :=
    Nat.sInf_le (s := {n : ℕ | ∀ u ∈ unitGroup F M n, ν'_M u = 1}) hν'_UG1
  refine ⟨hν_weil, hν'_cond_le1, fun β hβ_weil hm => ?_⟩
  have hνβ_weil : IsWeilRep F M (charRep F M (ν * β)) := by
    rcases hν_weil with ⟨hfin, U₁, hU₁, htriv₁⟩
    rcases hβ_weil with ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    have hmul : charRep F M (ν * β) w = charRep F M ν w * charRep F M β w := by
      apply LinearMap.ext
      intro v
      change ((ν * β) w : Ω F) • v = (ν w : Ω F) • ((β w : Ω F) • v)
      rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
    rw [hmul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  let θ_M : Mˣ →* (Ω F)ˣ := recChar F rec M β
  obtain ⟨θ₀', hθ₀'_rec, _, _⟩ := hSepRec_all M β hβ_weil
  have hθ_eq : θ_M = θ₀' :=
    (htateEps M ψ_M hψM β hβ_weil θ₀' hθ₀'_rec).1
  have heps_β : (tateEpsUnit F M θ_M ψ_M : Ω F) = tateEps F M θ_M ψ_M := by
    have h := (htateEps M ψ_M hψM β hβ_weil θ₀' hθ₀'_rec).2
    change (tateEpsUnit F M θ_M ψ_M : Ω F) = tateEps F M θ₀' ψ_M at h
    rw [h, hθ_eq]
  have hθ_rec : ∀ x : Mˣ, θ_M x = β (rec.recMap M x) := by
    rw [hθ_eq]; exact hθ₀'_rec
  have hνθ_rec : ∀ x : Mˣ, (ν'_M * θ_M) x = (ν * β) (rec.recMap M x) := by
    intro x
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hν'_rec x, hθ_rec x]
  obtain ⟨hrec_νβ, heps_νβ⟩ :=
    htateEps M ψ_M hψM (ν * β) hνβ_weil (ν'_M * θ_M) hνθ_rec
  let m := condExp F M θ_M
  have hm' : 2 ≤ m := hm
  have hd_ge1 : 1 ≤ m / 2 := by omega
  have hν'_triv_d : ∀ u ∈ unitGroup F M (m / 2), ν'_M u = 1 := by
    intro u hu
    apply hν'_UG1 u
    rw [hUG_PM le_rfl u]
    exact hPM_mono (by omega) ((hUG_PM hd_ge1 u).mp hu)
  obtain ⟨⟨c_θ, hc_val, hc_stat⟩, hTwist_all⟩ :=
    ld_tame_stationary_phase_and_stable_twist F M ψ_M hψM θ_M hm
  have h_stable : tateEps F M (ν'_M * θ_M) ψ_M =
      (ν'_M c_θ : Ω F) * tateEps F M θ_M ψ_M :=
    ((hTwist_all c_θ hc_val hc_stat).1 ν'_M hν'_triv_d).2
  have h_pow_val :
      ((tateEpsUnit F M (recChar F rec M (ν * β)) ψ_M : Ω F)) ^ q₀ =
        ((tateEpsUnit F M θ_M ψ_M : Ω F)) ^ q₀ := by
    rw [heps_νβ, heps_β, h_stable, mul_pow, ← Units.val_pow_eq_pow_val,
      hν'_pow c_θ, Units.val_one, one_mul]
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
  exact h_pow_val

theorem ld_ch14_wild_semidirect_unitGroup_norm_and_trace_one_nontrivial (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGalLMC : IsGaloisExt F L M_C) (hGalMCK : IsGaloisExt F M_C K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hp_prime : Nat.Prime (p F))
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp)
    (hq_eq : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (hFrobSurjMC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F))))
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (k : ℕ) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hy₁ : ∃ y₁ : M_C, (y₁ = 0 ∨ 0 ≤ valL F M_C y₁) ∧ traceLM F hLM_C y₁ = 1) :
    (∀ z : M_Cˣ, ∃ w : Kˣ,
      z * (Units.map (normLM F hM_CK) w)⁻¹ ∈ unitGroup F M_C 1) ∧
    (∀ w : Kˣ,
      Units.map (normLM F hM_CK) w ∈ unitGroup F M_C 1 → w ∈ unitGroup F K 1) ∧
    (∃ u_star ∈ unitGroup F M_C 1,
      (χ'.comp (Units.map (normLM F hLM_C))) u_star ≠ 1) :=
by
  
  have h_valL_pkg : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B],
      valL F B 0 = 0 ∧
      valL F B 1 = 0 ∧
      valL F B (-1) = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B)) ∧
      (∀ m : ℤ, ∃ c : Bˣ, valL F B (c : B) = m) ∧
      (∀ (k_val : ℤ) (x y : B),
        (x = 0 ∨ k_val ≤ valL F B x) → (y = 0 ∨ k_val ≤ valL F B y) →
          (x + y = 0 ∨ k_val ≤ valL F B (x + y))) ∧
      (∀ u : Bˣ, u ∈ unitGroup F B 0 ↔ valL F B (u : B) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Bˣ,
        u ∈ unitGroup F B a ↔ ((u : B) = 1 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1))) ∧
      (∀ (a : ℕ) (u : Bˣ), u ∈ unitGroup F B a → valL F B (u : B) = 0) ∧
      (((p F : ℕ) : B) = 0 ∨ 1 ≤ valL F B ((p F : ℕ) : B)) := by
    clear! L M_C K hp_prime
    intro B _
    have halg : ∀ z : B,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F B = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq B.val B.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F B 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F B 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : B, x ≠ 0 → y ≠ 0 → relVal F B (x * y) = relVal F B x + relVal F B y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F B (-1) = 0 := by
      have hne : (-1 : B) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F B ((-1 : B) * (-1 : B)) = relVal F B (-1) + relVal F B (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : B) * (-1 : B) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : B, relVal F B (-x) = relVal F B x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : B) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : B) = (-1 : B) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Bˣ, relVal F B ((u⁻¹ : Bˣ) : B) = - relVal F B (u : B) := by
      intro u
      have hmul : relVal F B ((u : B) * ((u⁻¹ : Bˣ) : B)) =
          relVal F B (u : B) + relVal F B ((u⁻¹ : Bˣ) : B) :=
        hrel_mul (u : B) ((u⁻¹ : Bˣ) : B) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Bˣ) (n : ℕ),
        relVal F B (((u ^ n : Bˣ) : B)) = (n : ℤ) * relVal F B (u : B) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Bˣ) (m : ℤ),
        relVal F B (((u ^ m : Bˣ) : B)) = m * relVal F B (u : B) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F B (((u ^ (n : ℤ) : Bˣ) : B)) = (n : ℤ) * relVal F B (u : B)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : B := algebraMap F B π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F B x₀ = (Module.finrank F B : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F B) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F B := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : B, x ≠ 0 ∧ relVal F B x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F B, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfB_mem : resDeg F B ∈ S := Nat.sInf_mem hS_nonempty
    have hfB_le : resDeg F B ≤ Module.finrank F B := Nat.sInf_le ⟨hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    obtain ⟨hfB_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfB_mem
    let ϖB : Bˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖB : relVal F B (ϖB : B) = (resDeg F B : ℤ) := hrel_ϖ₀
    have hfB_int_pos : (0 : ℤ) < (resDeg F B : ℤ) := Nat.cast_pos.mpr hfB_pos
    have hfB_int_ne : (resDeg F B : ℤ) ≠ 0 := ne_of_gt hfB_int_pos
    have hdiv : ∀ x : B, relVal F B x = (resDeg F B : ℤ) * valL F B x := by
      intro x
      by_cases hx : x = 0
