  intro p a b u W n₁ C P_star q₀ D H
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  let t₁ : ℕ := bM₁' - 1
  let t₂ : ℕ := bE' - 1
  let δ : ℕ := bE' - bM₁'
  let m : ℕ := a_lam - bE'
  let q_lam : ℕ := (a_lam + p - 1) / p
  let L₀ : ℤ := max 0 ((a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)))
  let B_u₁' : ℤ := min (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) (a_lam : ℤ)
  let n₂ : E' := IntermediateField.inclusion hLE' u * a
  let N₁ : L := normLM F hLM₁' (1 + n₁)
  have ht₁_z : (bM₁' : ℤ) = (t₁ : ℤ) + 1 := by dsimp [t₁]; omega
  have ht₂_z : (bE' : ℤ) = (t₂ : ℤ) + 1 := by dsimp [t₂]; omega
  have hδ_z : (t₂ : ℤ) = (t₁ : ℤ) + (δ : ℤ) := by dsimp [t₁, t₂, δ]; omega
  have ha_z : (a_lam : ℤ) = (bE' : ℤ) + (m : ℤ) := by dsimp [m]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have hp1_z : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hp_z : (3 : ℤ) ≤ (p : ℤ) := by omega
  have hm_z : (1 : ℤ) ≤ (m : ℤ) := by omega
  have ht₁_z_ge1 : (1 : ℤ) ≤ (t₁ : ℤ) := by omega
  have hδ_z_ge0 : (0 : ℤ) ≤ (δ : ℤ) := by omega
  have hpm_z : (t₁ : ℤ) + 1 ≤ (p : ℤ) * (m : ℤ) := by
    have h : t₁ + 1 ≤ p * m := Nat.succ_le_of_lt hpm_gt_t₁
    have hz : ((t₁ + 1 : ℕ) : ℤ) ≤ ((p * m : ℕ) : ℤ) := by exact_mod_cast h
    push_cast at hz
    exact hz
  have hq_val : 1 ≤ (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by omega
  have hq0_val : 1 ≤ ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
    have h : 1 * 1 ≤ (p - 1) * m := Nat.mul_le_mul (by omega) hm_ge1
    have hz : ((1 * 1 : ℕ) : ℤ) ≤ (((p - 1) * m : ℕ) : ℤ) := by exact_mod_cast h
    push_cast at hz
    exact hz
  have hH_nonneg : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) := by positivity
  have hH_eq : ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) =
      ((p - 1 : ℕ) : ℤ) * (δ : ℤ) := by
    rw [hδ_z]; ring
  have hL₀_ge0 : 0 ≤ L₀ := le_max_left 0 _
  have hL₀_add : (a_lam : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) + L₀ := by
    have h := le_max_right 0 ((a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)))
    change (a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) ≤ L₀ at h
    linarith only [h]
  have hpL₀_bound : (p : ℤ) * L₀ - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤
      (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    dsimp [L₀]
    rcases le_total 0 ((a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) with hle | hle
    · rw [max_eq_right hle]
      have hid : ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) -
          ((p : ℤ) * ((a_lam : ℤ) - ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) -
            ((p - 1 : ℕ) : ℤ) * (bE' : ℤ)) =
          ((p : ℤ) - 1) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ) - 1) +
            ((p : ℤ) - 3) * (t₁ : ℤ) +
            ((p : ℤ) * ((p : ℤ) - 1) - 1) * (δ : ℤ) + ((p : ℤ) - 2) := by
        rw [ha_z, ht₂_z, hδ_z, hp1_z]; ring
      have hterm1 : 0 ≤ ((p : ℤ) - 1) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ) - 1) :=
        mul_nonneg (by omega) (by omega)
      have hterm2 : 0 ≤ ((p : ℤ) - 3) * (t₁ : ℤ) :=
        mul_nonneg (by omega) (by omega)
      have hterm3 : 0 ≤ ((p : ℤ) * ((p : ℤ) - 1) - 1) * (δ : ℤ) := by
        apply mul_nonneg _ hδ_z_ge0
        have hp2 : 0 ≤ ((p : ℤ) - 3) * ((p : ℤ) + 2) := mul_nonneg (by omega) (by omega)
        linarith only [hp2]
      linarith only [hid, hterm1, hterm2, hterm3, hp_z]
    · rw [max_eq_left hle]
      have hterm : 0 ≤ ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) := by positivity
      linarith only [hterm, hq_val]
  have hr_L₀ : ∀ r : ℕ, 1 ≤ r →
      (p : ℤ) * L₀ - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤
        (r : ℤ) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) := by
    intro r hr
    have hr_z : (1 : ℤ) ≤ (r : ℤ) := by exact_mod_cast hr
    have hmul : 1 * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) ≤ (r : ℤ) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) :=
      mul_le_mul_of_nonneg_right hr_z (by omega)
    linarith only [hpL₀_bound, hmul]
  have hr_L₁ : ∀ r : ℕ, 1 ≤ r →
      (p : ℤ) * (0 : ℤ) - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤
        (r : ℤ) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) := by
    intro r hr
    have hr_z : (1 : ℤ) ≤ (r : ℤ) := by exact_mod_cast hr
    have hmul : 1 * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) ≤ (r : ℤ) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) :=
      mul_le_mul_of_nonneg_right hr_z (by omega)
    have hterm : 0 ≤ ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) := by positivity
    linarith only [hq_val, hmul, hterm]
  have h_q0H_q0 : (a_lam : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) + ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
    have hid : (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) + ((p - 1 : ℕ) : ℤ) * (m : ℤ)) - (a_lam : ℤ) =
        ((p : ℤ) * (m : ℤ) - (t₁ : ℤ) - 1) + ((p : ℤ) - 3) * (m : ℤ) + ((p : ℤ) - 2) * (δ : ℤ) := by
      rw [ha_z, ht₂_z, hδ_z, hp1_z]; ring
    have hterm1 : 0 ≤ ((p : ℤ) - 3) * (m : ℤ) := mul_nonneg (by omega) (by omega)
    have hterm2 : 0 ≤ ((p : ℤ) - 2) * (δ : ℤ) := mul_nonneg (by omega) hδ_z_ge0
    linarith only [hid, hq_val, hterm1, hterm2]
  have h_2q0H : (a_lam : ℤ) ≤ 2 * (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) := by
    have hdiff : ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) + ((p - 1 : ℕ) : ℤ) * (m : ℤ) ≤
        2 * (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) := by
      linarith only [hH_nonneg]
    linarith only [h_q0H_q0, hdiff]
  have hq_lam_le : (q_lam : ℤ) ≤ B_u₁' := by
    dsimp [B_u₁']
    rw [le_min_iff]
    have hpq_lam : (p : ℤ) * (q_lam : ℤ) ≤ (a_lam : ℤ) + (p : ℤ) - 1 := by
      have h : p * q_lam ≤ a_lam + p - 1 := by
        dsimp [q_lam]
        rw [mul_comm]
        exact Nat.div_mul_le_self (a_lam + p - 1) p
      have h3 : ((p * q_lam : ℕ) : ℤ) ≤ ((a_lam + p - 1 : ℕ) : ℤ) := by
        exact_mod_cast h
      have h4 : ((a_lam + p - 1 : ℕ) : ℤ) = (a_lam : ℤ) + (p : ℤ) - 1 := by omega
      push_cast at h3
      linarith only [h3, h4]
    have h1 : (p : ℤ) * (q_lam : ℤ) ≤ (p : ℤ) * (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) := by
      have hid : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) - ((a_lam : ℤ) + (p : ℤ) - 1) =
          ((p : ℤ) - 2) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ) - 1) +
            ((p : ℤ) - 3) * (t₁ : ℤ) +
            ((p : ℤ) - 1) * ((m : ℤ) - 1) +
            ((p : ℤ) * ((p : ℤ) - 1) - 1) * (δ : ℤ) + ((p : ℤ) - 3) := by
        rw [ha_z, ht₂_z, hδ_z, hp1_z]; ring
      have htA : 0 ≤ ((p : ℤ) - 2) * ((p : ℤ) * (m : ℤ) - (t₁ : ℤ) - 1) :=
        mul_nonneg (by omega) (by omega)
      have htB : 0 ≤ ((p : ℤ) - 3) * (t₁ : ℤ) :=
        mul_nonneg (by omega) (by omega)
      have htC : 0 ≤ ((p : ℤ) - 1) * ((m : ℤ) - 1) :=
        mul_nonneg (by omega) (by omega)
      have htD : 0 ≤ ((p : ℤ) * ((p : ℤ) - 1) - 1) * (δ : ℤ) := by
        apply mul_nonneg _ hδ_z_ge0
        have hp2 : 0 ≤ ((p : ℤ) - 3) * ((p : ℤ) + 2) := mul_nonneg (by omega) (by omega)
        linarith only [hp2]
      linarith only [hpq_lam, hid, htA, htB, htC, htD, hp_z]
    have h2 : (p : ℤ) * (q_lam : ℤ) ≤ (p : ℤ) * (a_lam : ℤ) := by
      have hid : (p : ℤ) * (a_lam : ℤ) - ((a_lam : ℤ) + (p : ℤ) - 1) =
          ((p : ℤ) - 1) * ((a_lam : ℤ) - 1) := by ring
      have htA : 0 ≤ ((p : ℤ) - 1) * ((a_lam : ℤ) - 1) := mul_nonneg (by omega) (by omega)
      linarith only [hpq_lam, hid, htA]
    exact ⟨le_of_mul_le_mul_left h1 (by omega), le_of_mul_le_mul_left h2 (by omega)⟩
  have h2B_ge : (a_lam : ℤ) ≤ 2 * B_u₁' := by
    dsimp [B_u₁']
    rcases le_total (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) (a_lam : ℤ) with hle | hle
    · rw [min_eq_left hle]; exact h_2q0H
    · rw [min_eq_right hle]; omega

  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add, _⟩ :=
    hvalL_props
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _⟩ :=
    hvalE'_props
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv, _, hvalM₁'_add, _⟩ :=
    hvalM₁'_props

  have hvalL_sub : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    refine hvalL_add k x (-y) hx ?_
    rcases hy with rfl | hy
    · exact Or.inl neg_zero
    · exact Or.inr (by rwa [hvalL_neg])
  have hvalL_mono : ∀ (k₁ k₂ : ℤ) (x : L),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hvalL_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalL_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalL_pow_eq : ∀ (x : L) (hx : x ≠ 0) (n : ℕ),
      x ^ n ≠ 0 ∧ valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x hx n
    induction n with
    | zero =>
      rw [pow_zero]
      refine ⟨one_ne_zero, ?_⟩
      rw [hvalL_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      refine ⟨pow_ne_zero (n + 1) hx, ?_⟩
      rw [pow_succ', hvalL_mul x (x ^ n) hx ih.1, ih.2]
      push_cast
      ring
  have hvalL_pow_ge : ∀ (x : L) (n : ℕ) (q : ℤ),
      (x = 0 ∨ q ≤ valL F L x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F L (x ^ n)) := by
    intro x n q hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hvalL_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ]
      have hmul := hvalL_mul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
      have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
      rwa [heq]
  have hvalL_sum : ∀ (S : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ S, f i)) := by
    intro S f k hf
    induction' S using Finset.induction_on with i S hi ih
    · left; exact Finset.sum_empty
    · rw [Finset.sum_insert hi]
      exact hvalL_add k (f i) (∑ j ∈ S, f j)
        (hf i (Finset.mem_insert_self i S))
        (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
  have hvalL_natCast : ∀ n : ℕ, ((n : ℕ) : L) = 0 ∨ (0 : ℤ) ≤ valL F L ((n : ℕ) : L) := by
    intro n
    induction n with
    | zero => left; exact Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hvalL_add 0 ((n : ℕ) : L) 1 ih (Or.inr (by rw [hvalL_1]))
  have hvalL_inv_elem : ∀ (x : L) (hx : x ≠ 0),
      x⁻¹ ≠ 0 ∧ valL F L (x⁻¹) = - valL F L x := by
    intro x hx
    refine ⟨inv_ne_zero hx, ?_⟩
    have h := hvalL_inv (Units.mk0 x hx)
    simpa using h
  have hvalL_neg1_pow : ∀ (n : ℕ) (x : L),
      ((-1 : L) ^ n * x = 0 ↔ x = 0) ∧ valL F L ((-1 : L) ^ n * x) = valL F L x := by
    intro n x
    rcases neg_one_pow_eq_or L n with h1 | hneg1
    · rw [h1, one_mul]; exact ⟨Iff.rfl, rfl⟩
    · rw [hneg1, neg_one_mul, neg_eq_zero, hvalL_neg]; exact ⟨Iff.rfl, rfl⟩
  have hvalL_strict : ∀ (y₁ y₂ : L),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F L y₁ + 1 ≤ valL F L y₂) →
      y₁ + y₂ ≠ 0 ∧ valL F L (y₁ + y₂) = valL F L y₁ := by
    intro y₁ y₂ hy₁ hy₂
    have hne : y₁ + y₂ ≠ 0 := by
      intro h0
      have hy₂_eq : y₂ = -y₁ := eq_neg_of_add_eq_zero_right h0
      rcases hy₂ with hy₂0 | hy₂_ge
      · exact hy₁ (neg_eq_zero.mp (hy₂_eq.symm.trans hy₂0))
      · rw [hy₂_eq, hvalL_neg] at hy₂_ge
        omega
    have hge : valL F L y₁ ≤ valL F L (y₁ + y₂) := by
      have h := hvalL_add (valL F L y₁) y₁ y₂ (Or.inr le_rfl)
        (hvalL_mono (valL F L y₁) (valL F L y₁ + 1) y₂ (by omega) hy₂)
      exact h.resolve_left hne
    have hle : valL F L (y₁ + y₂) ≤ valL F L y₁ := by
      by_contra! hgt
      have hsub := hvalL_sub (valL F L y₁ + 1) (y₁ + y₂) y₂ (Or.inr (by omega)) hy₂
      have hid : (y₁ + y₂) - y₂ = y₁ := by ring
      rw [hid] at hsub
      have hge1 := hsub.resolve_left hy₁
      omega
    exact ⟨hne, le_antisymm hle hge⟩
  have hvalL_one_add : ∀ (z : L),
      (z = 0 ∨ 1 ≤ valL F L z) → 1 + z ≠ 0 ∧ valL F L (1 + z) = 0 := by
    intro z hz
    have h := hvalL_strict 1 z one_ne_zero (by rwa [hvalL_1, zero_add])
    rwa [hvalL_1] at h

  have hvalE'_pow_ge : ∀ (x : E') (n : ℕ) (q : ℤ),
      (x = 0 ∨ q ≤ valL F E' x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F E' (x ^ n)) := by
    intro x n q hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hvalE'_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ]
      by_cases hxn : x ^ n = 0
      · left; rw [hxn, zero_mul]
      · by_cases hx0 : x = 0
        · left; rw [hx0, mul_zero]
        · right
          rw [hvalE'_mul (x ^ n) x hxn hx0]
          have h := add_le_add (ih.resolve_left hxn) (hx.resolve_left hx0)
          have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
          rwa [heq]
  have hvalE'_one_add : ∀ (z : E'),
      (z = 0 ∨ 1 ≤ valL F E' z) → 1 + z ≠ 0 ∧ valL F E' (1 + z) = 0 := by
    intro z hz
    have hne : (1 : E') + z ≠ 0 := by
      intro h0
      have hz_eq : z = -1 := eq_neg_of_add_eq_zero_right h0
      rcases hz with hz0 | hz_ge
      · exact one_ne_zero (neg_eq_zero.mp (hz_eq.symm.trans hz0))
      · rw [hz_eq, hvalE'_neg1] at hz_ge
        omega
    have hge : 0 ≤ valL F E' (1 + z) := by
      have hz0 : z = 0 ∨ 0 ≤ valL F E' z := by
        rcases hz with rfl | hz; · exact Or.inl rfl
        · exact Or.inr (by omega)
      exact (hvalE'_add 0 1 z (Or.inr (by rw [hvalE'_1])) hz0).resolve_left hne
    have hle : valL F E' (1 + z) ≤ 0 := by
      by_contra! hgt
      have hz' : -z = 0 ∨ 1 ≤ valL F E' (-z) := by
        rcases hz with rfl | hz; · exact Or.inl neg_zero
        · exact Or.inr (by rwa [hvalE'_neg])
      have hsub := hvalE'_add 1 (1 + z) (-z) (Or.inr (by omega)) hz'
      have hid : (1 : E') + z + -z = 1 := by ring
      rw [hid, hvalE'_1] at hsub
      have hge1 := hsub.resolve_left one_ne_zero
      omega
    exact ⟨hne, le_antisymm hle hge⟩

  have hvalM₁'_pow_ge : ∀ (x : M₁') (n : ℕ) (q : ℤ),
      (x = 0 ∨ q ≤ valL F M₁' x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M₁' (x ^ n)) := by
    intro x n q hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hvalM₁'_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ]
      by_cases hxn : x ^ n = 0
      · left; rw [hxn, zero_mul]
      · by_cases hx0 : x = 0
        · left; rw [hx0, mul_zero]
        · right
          rw [hvalM₁'_mul (x ^ n) x hxn hx0]
          have h := add_le_add (ih.resolve_left hxn) (hx.resolve_left hx0)
          have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
          rwa [heq]
  have hvalM₁'_one_add : ∀ (z : M₁'),
      (z = 0 ∨ 1 ≤ valL F M₁' z) → 1 + z ≠ 0 ∧ valL F M₁' (1 + z) = 0 := by
    intro z hz
    have hne : (1 : M₁') + z ≠ 0 := by
      intro h0
      have hz_eq : z = -1 := eq_neg_of_add_eq_zero_right h0
      rcases hz with hz0 | hz_ge
      · exact one_ne_zero (neg_eq_zero.mp (hz_eq.symm.trans hz0))
      · rw [hz_eq, hvalM₁'_neg1] at hz_ge
        omega
    have hge : 0 ≤ valL F M₁' (1 + z) := by
      have hz0 : z = 0 ∨ 0 ≤ valL F M₁' z := by
        rcases hz with rfl | hz; · exact Or.inl rfl
        · exact Or.inr (by omega)
      exact (hvalM₁'_add 0 1 z (Or.inr (by rw [hvalM₁'_1])) hz0).resolve_left hne
    have hle : valL F M₁' (1 + z) ≤ 0 := by
      by_contra! hgt
      have hz' : -z = 0 ∨ 1 ≤ valL F M₁' (-z) := by
        rcases hz with rfl | hz; · exact Or.inl neg_zero
        · exact Or.inr (by rwa [hvalM₁'_neg])
      have hsub := hvalM₁'_add 1 (1 + z) (-z) (Or.inr (by omega)) hz'
      have hid : (1 : M₁') + z + -z = 1 := by ring
      rw [hid, hvalM₁'_1] at hsub
      have hge1 := hsub.resolve_left one_ne_zero
      omega
    exact ⟨hne, le_antisymm hle hge⟩

  have hcoprime_val_L : ∀ r ∈ Finset.Icc 1 (p - 1),
      ((r : ℕ) : L) ≠ 0 ∧ valL F L ((r : ℕ) : L) = 0 := by
    intro r hr
    obtain ⟨hr1, hr2⟩ := Finset.mem_Icc.mp hr
    have hcop : Nat.Coprime r p :=
      ((Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt hr1 (by omega))).symm
    have hmod : r ^ (p - 1) ≡ 1 [MOD p] := by
      rw [← Nat.totient_prime hPrime]
      exact Nat.ModEq.pow_totient hcop
    have hrem : r ^ (p - 1) % p = 1 := by
      change r ^ (p - 1) % p = 1 % p at hmod
      rwa [Nat.mod_eq_of_lt hPrime.one_lt] at hmod
    have hdiv_nat : p * (r ^ (p - 1) / p) + 1 = r * r ^ (p - 2) := by
      calc p * (r ^ (p - 1) / p) + 1 = p * (r ^ (p - 1) / p) + r ^ (p - 1) % p := by rw [hrem]
        _ = r ^ (p - 1) := Nat.div_add_mod (r ^ (p - 1)) p
        _ = r ^ ((p - 2) + 1) := by congr 1; omega
        _ = r * r ^ (p - 2) := pow_succ' r (p - 2)
    have hcast := congrArg (Nat.cast : ℕ → L) hdiv_nat
    push_cast at hcast
    have hnot_bad : ¬ (((r : ℕ) : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((r : ℕ) : L)) := by
      intro hbad
      have hpow_ge : ((r : ℕ) : L) ^ (p - 2) = 0 ∨ (0 : ℤ) ≤ valL F L (((r : ℕ) : L) ^ (p - 2)) := by
        have h := hvalL_pow_ge ((r : ℕ) : L) (p - 2) 0 (hvalL_natCast r)
        rwa [mul_zero] at h
      have hrhs_ge : ((r : ℕ) : L) * ((r : ℕ) : L) ^ (p - 2) = 0 ∨
          (1 : ℤ) ≤ valL F L (((r : ℕ) : L) * ((r : ℕ) : L) ^ (p - 2)) := by
        have h := hvalL_mul_ge 1 0 ((r : ℕ) : L) (((r : ℕ) : L) ^ (p - 2)) hbad hpow_ge
        rwa [add_zero] at h
      have hlhs_ge : ((p : ℕ) : L) * ((r ^ (p - 1) / p : ℕ) : L) = 0 ∨
          (1 : ℤ) ≤ valL F L (((p : ℕ) : L) * ((r ^ (p - 1) / p : ℕ) : L)) := by
        have h := hvalL_mul_ge 1 0 ((p : ℕ) : L) ((r ^ (p - 1) / p : ℕ) : L)
          hp_valL (hvalL_natCast (r ^ (p - 1) / p))
        rwa [add_zero] at h
      have hsub := hvalL_sub 1 (((r : ℕ) : L) * ((r : ℕ) : L) ^ (p - 2))
        (((p : ℕ) : L) * ((r ^ (p - 1) / p : ℕ) : L)) hrhs_ge hlhs_ge
      have hid : ((r : ℕ) : L) * ((r : ℕ) : L) ^ (p - 2) -
          ((p : ℕ) : L) * ((r ^ (p - 1) / p : ℕ) : L) = 1 := by
        linear_combination -hcast
      rw [hid, hvalL_1] at hsub
      rcases hsub with h10 | h1ge
      · exact one_ne_zero h10
      · omega
    rcases hvalL_natCast r with hr0 | hr_ge0
    · exfalso; exact hnot_bad (Or.inl hr0)
    · have hr_ne0 : ((r : ℕ) : L) ≠ 0 := fun hr0 => hnot_bad (Or.inl hr0)
      have hr_lt1 : valL F L ((r : ℕ) : L) < 1 := by
        by_contra! hge1
        exact hnot_bad (Or.inr hge1)
      exact ⟨hr_ne0, by omega⟩

  have hcoprime_inv_val_L : ∀ r ∈ Finset.Icc 1 (p - 1),
      (((r : ℕ) : L)⁻¹) ≠ 0 ∧ valL F L (((r : ℕ) : L)⁻¹) = 0 := by
    intro r hr
    obtain ⟨hne, hval⟩ := hcoprime_val_L r hr
    obtain ⟨hinv_ne, hinv_val⟩ := hvalL_inv_elem ((r : ℕ) : L) hne
    rw [hval, neg_zero] at hinv_val
    exact ⟨hinv_ne, hinv_val⟩

  have hnorm_incl : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      (hLM : L ≤ M) (x : L),
      normLM F hLM (IntermediateField.inclusion hLM x) =
        x ^ (Module.finrank L (IntermediateField.extendScalars hLM)) := by
    intro M _ hLM x
    have h1 : normLM F hLM (IntermediateField.inclusion hLM x) =
        (Algebra.norm L (S := IntermediateField.extendScalars hLM))
          ((algebraMap L (IntermediateField.extendScalars hLM)) x) := rfl
    rw [h1, Algebra.norm_algebraMap]

  have htrace_smul : ∀ {M : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F M]
      (hLM : L ≤ M) (x : L) (z : M),
      traceLM F hLM (IntermediateField.inclusion hLM x * z) = x * traceLM F hLM z := by
    intro M _ hLM x z
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLM)).map_smul' x
      (toExtendScalars F hLM z)

  have hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = p := by
    obtain ⟨ϖ, hϖ⟩ := hvalL_surj 1
    have h1 : valL F L (normLM F hLM₁' (IntermediateField.inclusion hLM₁' (ϖ : L))) = (p : ℤ) := by
      rw [hval_norm_LM₁', hval_LM₁', hϖ, mul_one]
    have h2 : valL F L (normLM F hLM₁' (IntermediateField.inclusion hLM₁' (ϖ : L))) =
        (Module.finrank L (IntermediateField.extendScalars hLM₁') : ℤ) := by
      rw [hnorm_incl hLM₁' (ϖ : L), (hvalL_pow_eq (ϖ : L) (Units.ne_zero ϖ) _).2, hϖ, mul_one]
    have h3 : (Module.finrank L (IntermediateField.extendScalars hLM₁') : ℤ) = (p : ℤ) :=
      h2.symm.trans h1
    exact_mod_cast h3

  have ha_ne0 : a ≠ 0 := Units.ne_zero (Units.map (normLM F hE'K₁) Δ)
  have hb_ne0 : b ≠ 0 := Units.ne_zero (Units.map (normLM F hM₁'K₁) Δ)
  have ha_val : valL F E' a = -(t₁ : ℤ) := by
    dsimp [a, t₁]; rw [hval_norm_E'K₁, hΔ_val]
  have hb_val : valL F M₁' b = -(t₁ : ℤ) := by
    dsimp [b, t₁]; rw [hval_norm_M₁'K₁, hΔ_val]
  have hNa_ne0 : normLM F hLE' a ≠ 0 :=
    Units.ne_zero (Units.map (normLM F hLE') (Units.map (normLM F hE'K₁) Δ))
  have hNa_val : valL F L (normLM F hLE' a) = -(t₁ : ℤ) := by
    rw [hval_norm_LE', ha_val]
  have hNa_eq_Nb : normLM F hLE' a = normLM F hLM₁' b :=
    (hTowerNormTr (Δ : K₁)).1

  have hu_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero γ⁻¹)
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u]
    rw [hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero γ⁻¹),
      hvalL_inv γ, hα_val, hγ_val]
    omega
  have hu_pow_ne0 : ∀ k : ℕ, u ^ k ≠ 0 := fun k => (hvalL_pow_eq u hu_ne0 k).1
  have hu_pow_val : ∀ k : ℕ, valL F L (u ^ k) = (k : ℤ) * (m : ℤ) := by
    intro k
    rw [(hvalL_pow_eq u hu_ne0 k).2, hu_val]

  have hq₀_ne0 : q₀ ≠ 0 := hu_pow_ne0 (p - 1)
  have hq₀_val : valL F L q₀ = ((p - 1 : ℕ) : ℤ) * (m : ℤ) := hu_pow_val (p - 1)

  have hn₁_ne0 : n₁ ≠ 0 :=
    mul_ne_zero ((map_ne_zero (IntermediateField.inclusion hLM₁')).mpr hu_ne0) hb_ne0
  have hn₁_val : valL F M₁' n₁ = (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    dsimp [n₁]
    rw [hvalM₁'_mul _ b ((map_ne_zero (IntermediateField.inclusion hLM₁')).mpr hu_ne0) hb_ne0,
      hval_LM₁', hu_val, hb_val]
    ring
  have hn₂_ne0 : n₂ ≠ 0 :=
    mul_ne_zero ((map_ne_zero (IntermediateField.inclusion hLE')).mpr hu_ne0) ha_ne0
  have hn₂_val : valL F E' n₂ = (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    dsimp [n₂]
    rw [hvalE'_mul _ a ((map_ne_zero (IntermediateField.inclusion hLE')).mpr hu_ne0) ha_ne0,
      hval_LE', hu_val, ha_val]
    ring

  have hN_n₂ : normLM F hLE' n₂ = u ^ p * normLM F hLE' a := by
    dsimp [n₂]
    rw [map_mul, hnorm_incl hLE' u]
  have hN_n₁ : normLM F hLM₁' n₁ = u ^ p * normLM F hLE' a := by
    dsimp [n₁]
    rw [map_mul, hnorm_incl hLM₁' u, hdegM₁', ← hNa_eq_Nb]
  have hup_Na_ne0 : u ^ p * normLM F hLE' a ≠ 0 := mul_ne_zero (hu_pow_ne0 p) hNa_ne0
  have hup_Na_val : valL F L (u ^ p * normLM F hLE' a) = (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    rw [hvalL_mul (u ^ p) (normLM F hLE' a) (hu_pow_ne0 p) hNa_ne0, hu_pow_val p, hNa_val]
    ring

  have hH_val : H = 0 ∨ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) ≤ valL F L H := by
    dsimp [H]
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩
    rcases he_Δ_val (p - 1) hp1_mem with h0 | hge
    · left
      rw [h0, neg_zero]
      have h1 : normLM F hLM₁' 0 =
          (Algebra.norm L (S := IntermediateField.extendScalars hLM₁'))
            ((algebraMap L (IntermediateField.extendScalars hLM₁')) 0) := rfl
      rw [h1, Algebra.norm_algebraMap, hdegM₁', zero_pow hPrime.ne_zero]
    · by_cases hH0 : normLM F hLM₁' (- e_Δ (p - 1)) = 0
      · exact Or.inl hH0
      · right
        rw [hval_norm_LM₁', hvalM₁'_neg]
        change ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (e_Δ (p - 1)) at hge
        rwa [hH_eq] at hge

  obtain ⟨hC_ne0, hC_val0⟩ := hvalE'_one_add n₂ (Or.inr (by rw [hn₂_val]; exact hq_val))
  obtain ⟨hD_ne0, hD_val0⟩ :=
    hvalL_one_add (u ^ p * normLM F hLE' a) (Or.inr (by rw [hup_Na_val]; exact hq_val))
  have hP_ne0 : P_star ≠ 0 :=
    Units.ne_zero (Units.map (normLM F hLE') (Units.mk0 C hC_ne0))
  have hP_val0 : valL F L P_star = 0 := by
    dsimp [P_star]; rw [hval_norm_LE', hC_val0]
  have hPq₀_strict : P_star - q₀ ≠ 0 ∧ valL F L (P_star - q₀) = 0 := by
    have h := hvalL_strict P_star (-q₀) hP_ne0
      (Or.inr (by rw [hvalL_neg, hP_val0, zero_add, hq₀_val]; exact hq0_val))
    rwa [← sub_eq_add_neg, hP_val0] at h
  obtain ⟨hPq₀_ne0, hPq₀_val0⟩ := hPq₀_strict
  obtain ⟨h1n₁_ne0, h1n₁_val0⟩ := hvalM₁'_one_add n₁ (Or.inr (by rw [hn₁_val]; exact hq_val))
  have hN₁_ne0 : N₁ ≠ 0 :=
    Units.ne_zero (Units.map (normLM F hLM₁') (Units.mk0 (1 + n₁) h1n₁_ne0))
  have hN₁_val0 : valL F L N₁ = 0 := by
    dsimp [N₁]; rw [hval_norm_LM₁', h1n₁_val0]

  have hs_LE'_n₂_L₀ : ∀ r ∈ Finset.Icc 1 (p - 1),
      s_LE' n₂ r = 0 ∨ L₀ ≤ valL F L (s_LE' n₂ r) := by
    intro r hr
    exact hs_LE'_val n₂ r hr ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) L₀
      (Or.inr (by rw [hn₂_val])) (hr_L₀ r (Finset.mem_Icc.mp hr).1)
  have hs_LE'_n₂_0 : ∀ r ∈ Finset.Icc 1 (p - 1),
      s_LE' n₂ r = 0 ∨ (0 : ℤ) ≤ valL F L (s_LE' n₂ r) := by
    intro r hr
    exact hvalL_mono 0 L₀ (s_LE' n₂ r) hL₀_ge0 (hs_LE'_n₂_L₀ r hr)
  have htr_LM₁'_n₁_0 : ∀ r ∈ Finset.Icc 1 (p - 1),
      traceLM F hLM₁' (n₁ ^ r) = 0 ∨ (0 : ℤ) ≤ valL F L (traceLM F hLM₁' (n₁ ^ r)) := by
    intro r hr
    apply htr_LM₁' 0 (n₁ ^ r)
    have hpow := hvalM₁'_pow_ge n₁ r ((p : ℤ) * (m : ℤ) - (t₁ : ℤ)) (Or.inr (by rw [hn₁_val]))
    exact (Or.imp_right (le_trans (hr_L₁ r (Finset.mem_Icc.mp hr).1)) hpow)

  have hP_sub_D_eq : P_star - D = ∑ r ∈ Finset.Icc 1 (p - 1), s_LE' n₂ r := by
    have h := hs_LE'_norm_one_add n₂
    change P_star - 1 = (∑ r ∈ Finset.Icc 1 (p - 1), s_LE' n₂ r) + normLM F hLE' n₂ at h
    rw [hN_n₂] at h
    dsimp [D]
    linear_combination h
  have hP_sub_D_L₀ : P_star - D = 0 ∨ L₀ ≤ valL F L (P_star - D) := by
    rw [hP_sub_D_eq]
    exact hvalL_sum (Finset.Icc 1 (p - 1)) (fun r => s_LE' n₂ r) L₀ hs_LE'_n₂_L₀

  have htr_diff : ∀ k ∈ Finset.Icc 1 (p - 1),
      (traceLM F hLM₁' (n₁ ^ k) - traceLM F hLE' (n₂ ^ k)) -
        (if k = p - 1 then ((p - 1 : ℕ) : L) * u ^ (p - 1) * (1 - H) else 0) = 0 ∨
        (a_lam : ℤ) ≤
          valL F L
            ((traceLM F hLM₁' (n₁ ^ k) - traceLM F hLE' (n₂ ^ k)) -
              (if k = p - 1 then ((p - 1 : ℕ) : L) * u ^ (p - 1) * (1 - H) else 0)) := by
    intro k hk
    have hn₁_pow : traceLM F hLM₁' (n₁ ^ k) = u ^ k * traceLM F hLM₁' (b ^ k) := by
      have hp_eq : n₁ ^ k = IntermediateField.inclusion hLM₁' (u ^ k) * b ^ k := by
        dsimp [n₁]; rw [mul_pow, map_pow]
      rw [hp_eq, htrace_smul hLM₁']
    have hn₂_pow : traceLM F hLE' (n₂ ^ k) = u ^ k * traceLM F hLE' (a ^ k) := by
      have hp_eq : n₂ ^ k = IntermediateField.inclusion hLE' (u ^ k) * a ^ k := by
        dsimp [n₂]; rw [mul_pow, map_pow]
      rw [hp_eq, htrace_smul hLE']
    have hsub_eq : traceLM F hLM₁' (n₁ ^ k) - traceLM F hLE' (n₂ ^ k) =
        u ^ k * (traceLM F hLM₁' (b ^ k) - traceLM F hLE' (a ^ k)) := by
      rw [hn₁_pow, hn₂_pow, mul_sub]
    rw [hsub_eq]
    exact hLem9_15 k hk

  let diff_s : ℕ → L := fun r =>
    s_LM₁' n₁ r - s_LE' n₂ r + (if r = p - 1 then u ^ (p - 1) * (1 - H) else 0)
  have hdiff_s : ∀ r : ℕ, r ∈ Finset.Icc 1 (p - 1) →
      diff_s r = 0 ∨ (a_lam : ℤ) ≤ valL F L (diff_s r) := by
    intro r
    induction' r using Nat.strong_induction_on with r ih
    intro hr
    obtain ⟨hr1, hr2⟩ := Finset.mem_Icc.mp hr
    let term_fn : ℕ → L := fun j =>
      (-1 : L) ^ (j - 1) * s_LM₁' n₁ j * traceLM F hLM₁' (n₁ ^ (r - j)) -
        (-1 : L) ^ (j - 1) * s_LE' n₂ j * traceLM F hLE' (n₂ ^ (r - j))
    have hterm_bound : ∀ j ∈ Finset.Icc 1 (r - 1),
        term_fn j = 0 ∨ (a_lam : ℤ) ≤ valL F L (term_fn j) := by
      intro j hj
      obtain ⟨hj1, hj2⟩ := Finset.mem_Icc.mp hj
      have hj_lt : j < r := by omega
      have hj_ne_p1 : j ≠ p - 1 := by omega
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      have hrj_ne_p1 : r - j ≠ p - 1 := by omega
      have hrj_mem : r - j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hs_j : s_LM₁' n₁ j - s_LE' n₂ j = 0 ∨
          (a_lam : ℤ) ≤ valL F L (s_LM₁' n₁ j - s_LE' n₂ j) := by
        have h := ih j hj_lt hj_mem
        dsimp [diff_s] at h
        rwa [if_neg hj_ne_p1, add_zero] at h
      have htr_rj : traceLM F hLM₁' (n₁ ^ (r - j)) - traceLM F hLE' (n₂ ^ (r - j)) = 0 ∨
          (a_lam : ℤ) ≤ valL F L (traceLM F hLM₁' (n₁ ^ (r - j)) - traceLM F hLE' (n₂ ^ (r - j))) := by
        have h := htr_diff (r - j) hrj_mem
        rwa [if_neg hrj_ne_p1, sub_zero] at h
      have hp1_val := hvalL_mul_ge (a_lam : ℤ) 0
        (s_LM₁' n₁ j - s_LE' n₂ j) (traceLM F hLM₁' (n₁ ^ (r - j)))
        hs_j (htr_LM₁'_n₁_0 (r - j) hrj_mem)
      rw [add_zero] at hp1_val
      have hp2_val := hvalL_mul_ge 0 (a_lam : ℤ)
        (s_LE' n₂ j) (traceLM F hLM₁' (n₁ ^ (r - j)) - traceLM F hLE' (n₂ ^ (r - j)))
        (hs_LE'_n₂_0 j hj_mem) htr_rj
      rw [zero_add] at hp2_val
      have hsum_p := hvalL_add (a_lam : ℤ) _ _ hp1_val hp2_val
      have hid : term_fn j = (-1 : L) ^ (j - 1) *
          ((s_LM₁' n₁ j - s_LE' n₂ j) * traceLM F hLM₁' (n₁ ^ (r - j)) +
            s_LE' n₂ j * (traceLM F hLM₁' (n₁ ^ (r - j)) - traceLM F hLE' (n₂ ^ (r - j)))) := by
        dsimp [term_fn]; ring
      rw [hid, (hvalL_neg1_pow (j - 1) _).1, (hvalL_neg1_pow (j - 1) _).2]
      exact hsum_p
    have hsum_bound := hvalL_sum (Finset.Icc 1 (r - 1)) term_fn (a_lam : ℤ) hterm_bound
    have hneg_sum : - (∑ j ∈ Finset.Icc 1 (r - 1), term_fn j) = 0 ∨
        (a_lam : ℤ) ≤ valL F L (- (∑ j ∈ Finset.Icc 1 (r - 1), term_fn j)) := by
      rcases hsum_bound with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rwa [hvalL_neg]
    have hnewton_diff : - (∑ j ∈ Finset.Icc 1 (r - 1), term_fn j) =
        (-1 : L) ^ (r - 1) * ((r : ℕ) : L) * (s_LM₁' n₁ r - s_LE' n₂ r) -
          (traceLM F hLM₁' (n₁ ^ r) - traceLM F hLE' (n₂ ^ r)) := by
      have hn1 := hs_LM₁'_newton n₁ r hr
      have hn2 := hs_LE'_newton n₂ r hr
      have hsum_sub : ∑ j ∈ Finset.Icc 1 (r - 1), term_fn j =
          (∑ j ∈ Finset.Icc 1 (r - 1), (-1 : L) ^ (j - 1) * s_LM₁' n₁ j * traceLM F hLM₁' (n₁ ^ (r - j))) -
            (∑ j ∈ Finset.Icc 1 (r - 1), (-1 : L) ^ (j - 1) * s_LE' n₂ j * traceLM F hLE' (n₂ ^ (r - j))) := by
        dsimp [term_fn]
        exact Finset.sum_sub_distrib _ _
      linear_combination -hsum_sub - hn1 + hn2
    rw [hnewton_diff] at hneg_sum
    have hcomb := hvalL_add (a_lam : ℤ) _ _ hneg_sum (htr_diff r hr)
    have hcomb_eq :
        ((-1 : L) ^ (r - 1) * ((r : ℕ) : L) * (s_LM₁' n₁ r - s_LE' n₂ r) -
          (traceLM F hLM₁' (n₁ ^ r) - traceLM F hLE' (n₂ ^ r))) +
          ((traceLM F hLM₁' (n₁ ^ r) - traceLM F hLE' (n₂ ^ r)) -
            (if r = p - 1 then ((p - 1 : ℕ) : L) * u ^ (p - 1) * (1 - H) else 0)) =
        (-1 : L) ^ (r - 1) * ((r : ℕ) : L) * diff_s r := by
      dsimp only [diff_s]
      by_cases hr_top : r = p - 1
      · simp only [hr_top, ↓reduceIte]
        have hp_odd_prop : Odd p := hPrime.odd_of_ne_two hp_odd
        have hp2_odd : Odd (p - 1 - 1) := by
          rcases hp_odd_prop with ⟨k, hk⟩
          exact ⟨k - 1, by omega⟩
        rw [hp2_odd.neg_one_pow]
        ring
      · simp only [hr_top, ↓reduceIte]
        ring
    rw [hcomb_eq, mul_assoc ((-1 : L) ^ (r - 1)), (hvalL_neg1_pow (r - 1) _).1,
      (hvalL_neg1_pow (r - 1) _).2] at hcomb
    have hmul_inv := hvalL_mul_ge 0 (a_lam : ℤ) (((r : ℕ) : L)⁻¹) (((r : ℕ) : L) * diff_s r)
      (Or.inr (by rw [(hcoprime_inv_val_L r hr).2])) hcomb
    have hid_inv : (((r : ℕ) : L)⁻¹) * (((r : ℕ) : L) * diff_s r) = diff_s r :=
      inv_mul_cancel_left₀ (hcoprime_val_L r hr).1 (diff_s r)
    rwa [zero_add, hid_inv] at hmul_inv

  have hsum_diff_s := hvalL_sum (Finset.Icc 1 (p - 1)) diff_s (a_lam : ℤ) hdiff_s
  have hsum_diff_eq : ∑ r ∈ Finset.Icc 1 (p - 1), diff_s r = N₁ - (P_star - q₀) - q₀ * H := by
    have hsplit1 : ∑ r ∈ Finset.Icc 1 (p - 1), diff_s r =
        (∑ r ∈ Finset.Icc 1 (p - 1), (s_LM₁' n₁ r - s_LE' n₂ r)) +
          (∑ r ∈ Finset.Icc 1 (p - 1), (if r = p - 1 then u ^ (p - 1) * (1 - H) else 0)) := by
      dsimp [diff_s]
      exact Finset.sum_add_distrib
    have hsplit2 : ∑ r ∈ Finset.Icc 1 (p - 1), (s_LM₁' n₁ r - s_LE' n₂ r) =
        (∑ r ∈ Finset.Icc 1 (p - 1), s_LM₁' n₁ r) - (∑ r ∈ Finset.Icc 1 (p - 1), s_LE' n₂ r) :=
      Finset.sum_sub_distrib _ _
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩
    have hite : (∑ r ∈ Finset.Icc 1 (p - 1), (if r = p - 1 then u ^ (p - 1) * (1 - H) else 0)) =
        q₀ * (1 - H) := by
      rw [Finset.sum_ite_eq' (Finset.Icc 1 (p - 1)) (p - 1) (fun _ => u ^ (p - 1) * (1 - H)),
        if_pos hp1_mem]
    have hnorm1 := hs_LM₁'_norm_one_add n₁
    have hnorm2 := hs_LE'_norm_one_add n₂
    change N₁ - 1 = (∑ r ∈ Finset.Icc 1 (p - 1), s_LM₁' n₁ r) + normLM F hLM₁' n₁ at hnorm1
    change P_star - 1 = (∑ r ∈ Finset.Icc 1 (p - 1), s_LE' n₂ r) + normLM F hLE' n₂ at hnorm2
    rw [hN_n₁] at hnorm1
    rw [hN_n₂] at hnorm2
    rw [hsplit1, hsplit2, hite]
    linear_combination - hnorm1 + hnorm2
  rw [hsum_diff_eq] at hsum_diff_s

  let u₁' : L := 1 - (P_star - q₀) * N₁⁻¹
  obtain ⟨hN₁_inv_ne0, hN₁_inv_val0⟩ := hvalL_inv_elem N₁ hN₁_ne0
  rw [hN₁_val0, neg_zero] at hN₁_inv_val0
  obtain ⟨hD_inv_ne0, hD_inv_val0⟩ := hvalL_inv_elem D hD_ne0
  rw [hD_val0, neg_zero] at hD_inv_val0

  have hu₁'_step1 : u₁' - q₀ * H * N₁⁻¹ = 0 ∨
      (a_lam : ℤ) ≤ valL F L (u₁' - q₀ * H * N₁⁻¹) := by
    have h := hvalL_mul_ge (a_lam : ℤ) 0 (N₁ - (P_star - q₀) - q₀ * H) (N₁⁻¹)
      hsum_diff_s (Or.inr (by rw [hN₁_inv_val0]))
    have hid : (N₁ - (P_star - q₀) - q₀ * H) * N₁⁻¹ = u₁' - q₀ * H * N₁⁻¹ := by
      dsimp [u₁']
      linear_combination mul_inv_cancel₀ hN₁_ne0
    rwa [add_zero, hid] at h

  have hq₀H_val : q₀ * H = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) ≤ valL F L (q₀ * H) := by
    have h := hvalL_mul_ge (((p - 1 : ℕ) : ℤ) * (m : ℤ)) (((p - 1 : ℕ) : ℤ) * (δ : ℤ)) q₀ H
      (Or.inr (by rw [hq₀_val])) hH_val
    have heq : ((p - 1 : ℕ) : ℤ) * (m : ℤ) + ((p - 1 : ℕ) : ℤ) * (δ : ℤ) =
        ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) := by ring
    rwa [heq] at h

  have hq₀H_DN₁ : q₀ * H * (D - N₁) = 0 ∨ (a_lam : ℤ) ≤ valL F L (q₀ * H * (D - N₁)) := by
    have ht1 : (q₀ * H) * (P_star - D) = 0 ∨ (a_lam : ℤ) ≤ valL F L ((q₀ * H) * (P_star - D)) :=
      hvalL_mono (a_lam : ℤ) _ _ hL₀_add (hvalL_mul_ge _ _ (q₀ * H) (P_star - D) hq₀H_val hP_sub_D_L₀)
    have ht2 : (q₀ * H) * (N₁ - (P_star - q₀) - q₀ * H) = 0 ∨
        (a_lam : ℤ) ≤ valL F L ((q₀ * H) * (N₁ - (P_star - q₀) - q₀ * H)) := by
      have hle_sum : (a_lam : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) + (a_lam : ℤ) := by
        linarith only [hq0_val, hH_nonneg]
      exact hvalL_mono (a_lam : ℤ) _ _ hle_sum
        (hvalL_mul_ge _ _ (q₀ * H) (N₁ - (P_star - q₀) - q₀ * H) hq₀H_val hsum_diff_s)
    have ht3 : (q₀ * H) * q₀ = 0 ∨ (a_lam : ℤ) ≤ valL F L ((q₀ * H) * q₀) :=
      hvalL_mono (a_lam : ℤ) _ _ h_q0H_q0
        (hvalL_mul_ge _ _ (q₀ * H) q₀ hq₀H_val (Or.inr (by rw [hq₀_val])))
    have ht4 : (q₀ * H) * (q₀ * H) = 0 ∨ (a_lam : ℤ) ≤ valL F L ((q₀ * H) * (q₀ * H)) := by
      have h := hvalL_mul_ge _ _ (q₀ * H) (q₀ * H) hq₀H_val hq₀H_val
      have hle2 : (a_lam : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) +
          ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) := by linarith only [h_2q0H]
      exact hvalL_mono (a_lam : ℤ) _ _ hle2 h
    have hs1 := hvalL_sub (a_lam : ℤ) _ _ ht3 ht4
    have hs2 := hvalL_sub (a_lam : ℤ) _ _ hs1 ht1
    have hs3 := hvalL_sub (a_lam : ℤ) _ _ hs2 ht2
    have hid : ((q₀ * H) * q₀ - (q₀ * H) * (q₀ * H)) - (q₀ * H) * (P_star - D) -
        (q₀ * H) * (N₁ - (P_star - q₀) - q₀ * H) = q₀ * H * (D - N₁) := by ring
    rwa [hid] at hs3

  have hu₁'_step2 : q₀ * H * N₁⁻¹ - q₀ * H * D⁻¹ = 0 ∨
      (a_lam : ℤ) ≤ valL F L (q₀ * H * N₁⁻¹ - q₀ * H * D⁻¹) := by
    have hm1 := hvalL_mul_ge (a_lam : ℤ) 0 (q₀ * H * (D - N₁)) (N₁⁻¹)
      hq₀H_DN₁ (Or.inr (by rw [hN₁_inv_val0]))
    rw [add_zero] at hm1
    have hm2 := hvalL_mul_ge (a_lam : ℤ) 0 (q₀ * H * (D - N₁) * N₁⁻¹) (D⁻¹)
      hm1 (Or.inr (by rw [hD_inv_val0]))
    have hid : q₀ * H * (D - N₁) * N₁⁻¹ * D⁻¹ = q₀ * H * N₁⁻¹ - q₀ * H * D⁻¹ := by
      linear_combination (q₀ * H * N₁⁻¹) * mul_inv_cancel₀ hD_ne0 -
        (q₀ * H * D⁻¹) * mul_inv_cancel₀ hN₁_ne0
    rwa [add_zero, hid] at hm2

  have hu₁'_approx : u₁' - q₀ * H * D⁻¹ = 0 ∨
      (a_lam : ℤ) ≤ valL F L (u₁' - q₀ * H * D⁻¹) := by
    have h := hvalL_add (a_lam : ℤ) (u₁' - q₀ * H * N₁⁻¹) (q₀ * H * N₁⁻¹ - q₀ * H * D⁻¹)
      hu₁'_step1 hu₁'_step2
    have hid : (u₁' - q₀ * H * N₁⁻¹) + (q₀ * H * N₁⁻¹ - q₀ * H * D⁻¹) = u₁' - q₀ * H * D⁻¹ := by
      ring
    rwa [hid] at h

  have hq₀HD_val : q₀ * H * D⁻¹ = 0 ∨
      ((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ)) ≤ valL F L (q₀ * H * D⁻¹) := by
    have h := hvalL_mul_ge (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) 0 (q₀ * H) (D⁻¹)
      hq₀H_val (Or.inr (by rw [hD_inv_val0]))
    rwa [add_zero] at h

  have hu₁'_B : u₁' = 0 ∨ B_u₁' ≤ valL F L u₁' := by
    have h1 := hvalL_mono B_u₁' (a_lam : ℤ) (u₁' - q₀ * H * D⁻¹) (min_le_right _ _) hu₁'_approx
    have h2 := hvalL_mono B_u₁' (((p - 1 : ℕ) : ℤ) * ((m : ℤ) + (δ : ℤ))) (q₀ * H * D⁻¹)
      (min_le_left _ _) hq₀HD_val
    have hsum := hvalL_add B_u₁' (u₁' - q₀ * H * D⁻¹) (q₀ * H * D⁻¹) h1 h2
    rwa [sub_add_cancel] at hsum

  have hu₁'_q : u₁' = 0 ∨ (q_lam : ℤ) ≤ valL F L u₁' :=
    hvalL_mono (q_lam : ℤ) B_u₁' u₁' hq_lam_le hu₁'_B

  have hhigher_terms : ∀ j ∈ Finset.Icc 2 (p - 1),
      ((j : ℕ) : L)⁻¹ * u₁' ^ j = 0 ∨ (a_lam : ℤ) ≤ valL F L (((j : ℕ) : L)⁻¹ * u₁' ^ j) := by
    intro j hj
    obtain ⟨hj2, hjp1⟩ := Finset.mem_Icc.mp hj
    have hj_mem1 : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hjp1⟩
    have hpow := hvalL_pow_ge u₁' j B_u₁' hu₁'_B
    have hjB_ge : (a_lam : ℤ) ≤ (j : ℤ) * B_u₁' := by
      have hj_z : (2 : ℤ) ≤ (j : ℤ) := by exact_mod_cast hj2
      have hB_nonneg : 0 ≤ B_u₁' := by
        dsimp [B_u₁']; rw [le_min_iff]; exact ⟨by linarith only [hq0_val, hH_nonneg], by omega⟩
      have hmul : 2 * B_u₁' ≤ (j : ℤ) * B_u₁' := mul_le_mul_of_nonneg_right hj_z hB_nonneg
      linarith only [h2B_ge, hmul]
    have hpow_a := hvalL_mono (a_lam : ℤ) ((j : ℤ) * B_u₁') (u₁' ^ j) hjB_ge hpow
    have hmul := hvalL_mul_ge 0 (a_lam : ℤ) (((j : ℕ) : L)⁻¹) (u₁' ^ j)
      (Or.inr (by rw [(hcoprime_inv_val_L j hj_mem1).2])) hpow_a
    rwa [zero_add] at hmul

  have hsum_higher := hvalL_sum (Finset.Icc 2 (p - 1))
    (fun j => ((j : ℕ) : L)⁻¹ * u₁' ^ j) (a_lam : ℤ) hhigher_terms

  have hlog_sum_approx :
      (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) - q₀ * H * D⁻¹ = 0 ∨
      (a_lam : ℤ) ≤
        valL F L ((∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) - q₀ * H * D⁻¹) := by
    have hsplit : ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j =
        u₁' + ∑ j ∈ Finset.Icc 2 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j := by
      rw [← Finset.insert_Icc_add_one_left_eq_Icc (by omega : 1 ≤ p - 1),
        Finset.sum_insert (by simp)]
      simp
    have h := hvalL_add (a_lam : ℤ) (u₁' - q₀ * H * D⁻¹)
      (∑ j ∈ Finset.Icc 2 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) hu₁'_approx hsum_higher
    have hid : (u₁' - q₀ * H * D⁻¹) +
        (∑ j ∈ Finset.Icc 2 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) =
        (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) - q₀ * H * D⁻¹ := by
      rw [hsplit]; ring
    rwa [hid] at h

  have h2_mem : 2 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  obtain ⟨h2_ne0, h2_val0⟩ := hcoprime_val_L 2 h2_mem
  have h2γ_val : valL F L (2 * (γ : L)) = -(a_lam : ℤ) - condExpChar F L ψ := by
    change valL F L (((2 : ℕ) : L) * (γ : L)) = -(a_lam : ℤ) - condExpChar F L ψ
    rw [hvalL_mul ((2 : ℕ) : L) (γ : L) h2_ne0 (Units.ne_zero γ), h2_val0, zero_add, hγ_val]

  have hαW_eq : (α : L) * W = (γ : L) := by
    dsimp [W]
    rw [← mul_assoc, mul_comm (α : L) (γ : L), mul_assoc]
    have hinv : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    rw [hinv, mul_one]

  refine ⟨hC_ne0, hC_val0, hD_ne0, hD_val0, hP_ne0, hP_val0, hPq₀_ne0, hPq₀_val0,
    hN₁_ne0, hN₁_val0, ?_⟩
  intro hU₁
  have hu₁'_one : 1 - u₁' ≠ 0 := by
    dsimp [u₁']
    rw [sub_sub_cancel]
    exact hU₁
  have hmk_eq : Units.mk0 ((P_star - q₀) * N₁⁻¹) hU₁ = Units.mk0 (1 - u₁') hu₁'_one :=
    Units.ext (sub_sub_cancel 1 ((P_star - q₀) * N₁⁻¹)).symm
  rw [hmk_eq, hlam_log u₁' hu₁'_q hu₁'_one]
  let arg_diff : L :=
    2 * (γ : L) * (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) -
      2 * (α : L) * (W * u ^ (p - 1) * H * D⁻¹)
  have harg_diff_eq : arg_diff =
      (2 * (γ : L)) * ((∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) - q₀ * H * D⁻¹) := by
    dsimp [arg_diff, q₀]
    calc 2 * (γ : L) * (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) -
          2 * (α : L) * (W * u ^ (p - 1) * H * D⁻¹)
        = 2 * (γ : L) * (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) -
          2 * ((α : L) * W) * (u ^ (p - 1) * H * D⁻¹) := by ring
      _ = (2 * (γ : L)) *
          ((∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) - u ^ (p - 1) * H * D⁻¹) := by
        rw [hαW_eq]; ring
  have harg_diff_val : arg_diff = 0 ∨ -condExpChar F L ψ ≤ valL F L arg_diff := by
    rw [harg_diff_eq]
    have h := hvalL_mul_ge (-(a_lam : ℤ) - condExpChar F L ψ) (a_lam : ℤ) (2 * (γ : L))
      ((∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) - q₀ * H * D⁻¹)
      (Or.inr (by rw [h2γ_val])) hlog_sum_approx
    have heq : (-(a_lam : ℤ) - condExpChar F L ψ) + (a_lam : ℤ) = -condExpChar F L ψ := by ring
    rwa [heq] at h
  have hψ_diff : ψ arg_diff = 1 := hψ_triv arg_diff harg_diff_val
  have harg_split :
      2 * (γ : L) * (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₁' ^ j) =
        arg_diff + 2 * (α : L) * (W * u ^ (p - 1) * H * D⁻¹) := by
    dsimp [arg_diff]; ring
  rw [harg_split, AddChar.map_add_eq_mul, hψ_diff, one_mul]

theorem ld_ch12_wild_odd_tot_ram_u2_k_rat_newton_and_unit_factorization (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (bE' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbE'_lt_lam : bE' < a_lam)
    (hp_valL : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : L) = 0 ∨
      (1 : ℤ) ≤ valL F L ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : L))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
