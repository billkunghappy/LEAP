      invFun := fun z =>
        ⟨(ρ.symm ⟨z.1, (IntermediateField.mem_extendScalars hLE).mp z.2⟩).1,
          (IntermediateField.mem_extendScalars hLE).mpr (ρ.symm _).2⟩
      left_inv := fun z => Subtype.ext (congrArg Subtype.val (ρ.left_inv _))
      right_inv := fun z => Subtype.ext (congrArg Subtype.val (ρ.right_inv _))
      map_mul' := fun z₁ z₂ => Subtype.ext (congrArg Subtype.val (map_mul ρ _ _))
      map_add' := fun z₁ z₂ => Subtype.ext (congrArg Subtype.val (map_add ρ _ _))
      commutes' := fun a => Subtype.ext (congrArg Subtype.val (hρ a)) }
  let τ_σ : G_LE := toGLE σ hσ_L
  let τ_0 : G_LE := toGLE σ_0 hσ_0_L
  have hτ_σ_ne : τ_σ ≠ 1 := by
    intro h1
    apply hσ_ne
    apply AlgEquiv.ext
    intro y
    let z : E' := ⟨y.1, (IntermediateField.mem_extendScalars hLE).mpr y.2⟩
    have hz : τ_σ z = z := by
      rw [h1]
      rfl
    exact Subtype.ext (congrArg Subtype.val hz)
  have hτ_σ_pow : τ_σ ^ ℓ = 1 := by
    rw [← hcard_GLE]
    exact pow_card_eq_one
  have hτ_σ_ord : orderOf τ_σ = ℓ := orderOf_eq_prime hτ_σ_pow hτ_σ_ne
  let f_σ : Fin ℓ → G_LE := fun k => τ_σ ^ k.1
  have hf_σ_inj : Function.Injective f_σ := by
    have h_le : ∀ k₁ k₂ : Fin ℓ, k₂.1 ≤ k₁.1 → f_σ k₁ = f_σ k₂ → k₁ = k₂ := by
      intro k₁ k₂ hle heq
      have hsplit : k₁.1 = (k₁.1 - k₂.1) + k₂.1 := (Nat.sub_add_cancel hle).symm
      have hpow_sub : τ_σ ^ (k₁.1 - k₂.1) = 1 := by
        apply mul_right_cancel (b := τ_σ ^ k₂.1)
        rw [← pow_add, ← hsplit, one_mul]
        exact heq
      have hdvd : ℓ ∣ k₁.1 - k₂.1 := by
        have hdvd₀ : orderOf τ_σ ∣ k₁.1 - k₂.1 := orderOf_dvd_iff_pow_eq_one.mpr hpow_sub
        rwa [hτ_σ_ord] at hdvd₀
      have hlt : k₁.1 - k₂.1 < ℓ := Nat.lt_of_le_of_lt (Nat.sub_le k₁.1 k₂.1) k₁.2
      have hsub0 : k₁.1 - k₂.1 = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      ext
      omega
    intro k₁ k₂ heq
    rcases le_total k₂.1 k₁.1 with hle | hle
    · exact h_le k₁ k₂ hle heq
    · exact (h_le k₂ k₁ hle heq.symm).symm
  have hf_σ_bij : Function.Bijective f_σ :=
    (Fintype.bijective_iff_injective_and_card f_σ).mpr
      ⟨hf_σ_inj, (Fintype.card_fin ℓ).trans hcard_GLE.symm⟩
  obtain ⟨k, hk⟩ := hf_σ_bij.2 τ_0
  have hτ_pow_act : ∀ (m : ℕ) (z : E'),
      ((τ_σ ^ m) z).1 = ((σ ^ m) ⟨z.1, (IntermediateField.mem_extendScalars hLE).mp z.2⟩).1 := by
    intro m
    induction' m with m ih
    · intro z
      rfl
    · intro z
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply]
      exact congrArg (fun u : E => (σ u).1) (Subtype.ext (ih z))
  have hσ0_eq : σ_0 = σ ^ k.1 := by
    apply AlgEquiv.ext
    intro y
    let z : E' := ⟨y.1, (IntermediateField.mem_extendScalars hLE).mpr y.2⟩
    have hz : ((τ_σ ^ k.1) z).1 = (τ_0 z).1 := congrArg (fun g : G_LE => (g z).1) hk
    apply Subtype.ext
    exact (hz.symm.trans (hτ_pow_act k.1 z))
  have hrec_eq : recChar F rec E χE_1 = χE' := by
    apply MonoidHom.ext
    intro y
    let y' : Eˣ := Units.map σ_0.symm.toRingEquiv.toMonoidHom y
    have hy' : Units.map σ_0.toRingEquiv.toMonoidHom y' = y :=
      Units.ext (σ_0.apply_symm_apply y.1)
    have h1 := hrec_σ_0 y'
    have h2 : χE' (Units.map σ_0.toRingEquiv.toMonoidHom y') = χE' y' := by
      rw [hσ0_eq]
      exact hσ_pow_all k.1 y'
    rw [hy'] at h1 h2
    exact h1.trans h2.symm
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨_, hWeil_norm⟩ := ld_separable_weil_char_rec_and_norm F rec
  let ψE := traceChar F hLE ψ
  have hψE : IsAdmissibleChar F E ψE := ((htraceChar L E hLE hAbLE.2.2).2 ψ hψ).1
  obtain ⟨θ₀, hθ₀_rec, _, _⟩ := hWeil_norm E χE hχE_weil
  have hχE'_eq_θ₀ : χE' = θ₀ := (htateEps E ψE hψE χE hχE_weil θ₀ hθ₀_rec).1
  have hχE'_rec : ∀ y : Eˣ, χE' y = χE (rec.recMap E y) := hχE'_eq_θ₀ ▸ hθ₀_rec
  obtain ⟨θ₁, hθ₁_rec, _, _⟩ := hWeil_norm E χE_1 hχE_1_weil
  have hχE1_eq_θ₁ : recChar F rec E χE_1 = θ₁ :=
    (htateEps E ψE hψE χE_1 hχE_1_weil θ₁ hθ₁_rec).1
  have hχE1_rec : ∀ y : Eˣ, (recChar F rec E χE_1) y = χE_1 (rec.recMap E y) :=
    hχE1_eq_θ₁ ▸ hθ₁_rec
  have hδE_rec : ∀ y : Eˣ, δE (rec.recMap E y) = 1 := by
    intro y
    change χE_1 (rec.recMap E y) * (χE (rec.recMap E y))⁻¹ = 1
    rw [← hχE1_rec y, ← hχE'_rec y, hrec_eq, mul_inv_cancel]
  have hδE_all : δE = 1 := by
    apply MonoidHom.ext
    intro w
    obtain ⟨y, hy⟩ := rec.surj_rec E K₁ hEK₁ hAbEK₁ w
    have htriv : δE ((rec.recMap E y)⁻¹ * w) = 1 := hδE_kerK₁ _ hy
    rw [map_mul, map_inv, hδE_rec y, inv_one, one_mul] at htriv
    exact htriv
  exact hδE_ne hδE_all

theorem ld_ch12_tame_coprime_base_char_and_unit_triv (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E M₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E] [FiniteDimensional F M₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hTame : Module.finrank L (IntermediateField.extendScalars hLE) ≠ p F)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (χE' : Eˣ →* (Ω F)ˣ) (χM₁' : M₁ˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1)
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1)
    (hνM₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1)
    (hξE_ne : νM₁.comp (Units.map (normLM F hLE)) ≠ 1)
    (hcond_χE'_pos : 1 ≤ condExp F E χE')
    (hχE'_cond : ∀ u ∈ unitGroup F E (condExp F E χE'), χE' u = 1)
    (hcond_χM₁'_pos : 1 ≤ condExp F M₁ χM₁')
    (hχM₁'_cond : ∀ u ∈ unitGroup F M₁ (condExp F M₁ χM₁'), χM₁' u = 1)
    (hχE_pow : ∀ y : Eˣ,
      (χE' y) ^ (Module.finrank L (IntermediateField.extendScalars hLE)) =
        χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom (Units.map (normLM F hLE) y)))
    (hχM₁_pow : ∀ z : M₁ˣ,
      (χM₁' z) ^ (Module.finrank L (IntermediateField.extendScalars hLE)) =
        χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom (Units.map (normLM F hLM₁) z)))
    (hCommonRest : ∀ x : Lˣ,
      χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)), (νE ^ j) x) =
      χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)), (νM₁ ^ j) x)) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    (∀ u ∈ unitGroup F L 1, νE u = 1 ∧ νM₁ u = 1) ∧
    condExp F L νE ≤ 1 ∧
    condExp F L νM₁ ≤ 1 ∧
    ¬ (condExp F L νE = 0 ∧ condExp F L νM₁ = 0) ∧
    ∃ (lam_L : Lˣ →* (Ω F)ˣ),
      (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νE ^ j * lam_L)), (νE ^ j * lam_L) u = 1) ∧
      (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j * lam_L)), (νM₁ ^ j * lam_L) u = 1) ∧
      (∀ u ∈ unitGroup F E (condExp F E (lam_L.comp (Units.map (normLM F hLE)))),
        (lam_L.comp (Units.map (normLM F hLE))) u = 1) ∧
      (∀ u ∈ unitGroup F M₁ (condExp F M₁ (lam_L.comp (Units.map (normLM F hLM₁)))),
        (lam_L.comp (Units.map (normLM F hLM₁))) u = 1) ∧
      (∀ u ∈ unitGroup F E 1,
        (χE' * (lam_L.comp (Units.map (normLM F hLE)))⁻¹) u = 1) ∧
      (∀ u ∈ unitGroup F M₁ 1,
        (χM₁' * (lam_L.comp (Units.map (normLM F hLM₁)))⁻¹) u = 1) ∧
      (∀ x : Lˣ,
        (χE' * (lam_L.comp (Units.map (normLM F hLE)))⁻¹)
            (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
          (∏ j ∈ Finset.range ℓ, (νE ^ j) x) =
        (χM₁' * (lam_L.comp (Units.map (normLM F hLM₁)))⁻¹)
            (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) *
          (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x)) ∧
      (¬ (2 ≤ condExp F L lam_L) →
        condExp F E χE' = 1 ∧ condExp F M₁ χM₁' = 1 ∧
        (∀ u ∈ unitGroup F E 1, χE' u = 1) ∧
        (∀ u ∈ unitGroup F M₁ 1, χM₁' u = 1)) :=
by
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt
  have hp : Nat.Prime (p F) := (ld_frob_pow_on_primeToP_roots F).1
  have hcop : Nat.Coprime ℓ (p F) :=
    (Nat.Prime.coprime_iff_not_dvd hPrime).mpr fun hdvd =>
      hTame ((Nat.dvd_prime hp).mp hdvd |>.resolve_left hPrime.ne_one)

  
  have hpF : (p F : F) = 0 ∨ 1 ≤ addVal F (p F : F) := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] (p F : 𝒪[F]) = 0 := by
      rw [map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (p F)
    have hker : valuation F ((p F : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    by_cases hp0 : (p F : F) = 0
    · exact Or.inl hp0
    · right
      have hφp : φ (valuation F (p F : F)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
      have hlt : φ (valuation F (p F : F)) < 1 := by
        rw [← map_one φ, map_lt_map_iff φ]
        exact hker
      rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
        ← Multiplicative.toAdd_lt, toAdd_one] at hlt
      unfold addVal
      rw [dif_neg hp0]
      omega

  have hUnitShift : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ {a b : ℕ}, a ≤ b → unitGroup F M b ≤ unitGroup F M a) ∧
      (∀ (d : ℕ) (u : Mˣ), u ∈ unitGroup F M 1 → u ^ ((p F) ^ d) ∈ unitGroup F M (1 + d)) := by
    intro M _
    obtain ⟨_, hval1, _, _, hval_mul, _, _, hval_add, hunit0, hunit_ge1, hunit_val0⟩ :=
      ld_valL_and_unitGroup_props F M
    obtain ⟨_, _, _, _, _, halg1, _⟩ := ld_addVal_finset_and_algebraMap_valL F M
    have hp_valM : ((p F : ℕ) : M) = 0 ∨ 1 ≤ valL F M ((p F : ℕ) : M) := by
      simpa using halg1 (p F : F) hpF
    have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : M),
        (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · exact Or.inl (by rw [hx0, zero_mul])
      · by_cases hy0 : y = 0
        · exact Or.inl (by rw [hy0, mul_zero])
        · right
          have h1 : k₁ ≤ valL F M x := hx.resolve_left hx0
          have h2 : k₂ ≤ valL F M y := hy.resolve_left hy0
          rw [hval_mul x y hx0 hy0]
          omega
    have hval_pow_ge : ∀ (n : ℕ) (m : ℤ) (x : M),
        (x = 0 ∨ m ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * m ≤ valL F M (x ^ n)) := by
      intro n m x hx
      induction n with
      | zero =>
        right
        rw [pow_zero, hval1]
        simp
      | succ n ih =>
        rw [pow_succ]
        have hmul := hval_mul_ge ((n : ℤ) * m) m (x ^ n) x ih hx
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          have heq : ((n + 1 : ℕ) : ℤ) * m = (n : ℤ) * m + m := by push_cast; ring
          rw [heq]
          exact hge
    have hval_finset_sum : ∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i)) := by
      intro S f k hS
      induction S using Finset.induction_on with
      | empty =>
        left
        simp
      | @insert a s ha ih =>
        rw [Finset.sum_insert ha]
        have ha_val := hS a (Finset.mem_insert_self a s)
        have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
        exact hval_add k (f a) (∑ i ∈ s, f i) ha_val hs_val
    have hval_nat : ∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ valL F M (n : M) := by
      intro n
      induction n with
      | zero => exact Or.inl Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hval_add 0 (n : M) 1 ih (Or.inr (by rw [hval1]))
    have hunit_anti : ∀ {a b : ℕ}, a ≤ b → unitGroup F M b ≤ unitGroup F M a := by
      intro a b hle u hu
      by_cases ha0 : a = 0
      · subst ha0
        exact (hunit0 u).mpr (hunit_val0 b u hu)
      · have ha1 : 1 ≤ a := by omega
        have hb1 : 1 ≤ b := by omega
        rw [hunit_ge1 a ha1 u]
        rcases (hunit_ge1 b hb1 u).mp hu with h1 | hge
        · exact Or.inl h1
        · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
    have hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F M m,
        u ^ (p F) ∈ unitGroup F M (m + 1) := by
      intro m hm u hu
      let x : M := (u : M) - 1
      have hx : x = 0 ∨ (m : ℤ) ≤ valL F M x := by
        rcases (hunit_ge1 m hm u).mp hu with h1 | hge
        · left
          dsimp [x]
          rw [h1, sub_self]
        · exact Or.inr hge
      have hu_eq : (u : M) = x + 1 := by
        dsimp [x]
        ring
      have hpow_sub : ((u ^ (p F) : Mˣ) : M) - 1 =
          ∑ k ∈ Finset.range (p F), (x ^ (k + 1) * ((p F).choose (k + 1) : M)) := by
        rw [Units.val_pow_eq_pow_val, hu_eq, add_pow x 1 (p F), Finset.sum_range_succ']
        simp [one_pow]
      have hsum_val : (∑ k ∈ Finset.range (p F), (x ^ (k + 1) * ((p F).choose (k + 1) : M))) = 0 ∨
          ((m + 1 : ℕ) : ℤ) ≤
            valL F M (∑ k ∈ Finset.range (p F), (x ^ (k + 1) * ((p F).choose (k + 1) : M))) := by
        apply hval_finset_sum (Finset.range (p F)) _ ((m + 1 : ℕ) : ℤ)
        intro k _
        by_cases hk0 : k = 0
        · subst hk0
          simp only [zero_add, pow_one, Nat.choose_one_right]
          have hmul := hval_mul_ge (m : ℤ) 1 x ((p F : ℕ) : M) hx hp_valM
          rcases hmul with h0 | hge
          · exact Or.inl h0
          · right
            push_cast
            omega
        · have hx_pow := hval_pow_ge (k + 1) (m : ℤ) x hx
          have hx_pow' : x ^ (k + 1) = 0 ∨ ((m + 1 : ℕ) : ℤ) ≤ valL F M (x ^ (k + 1)) := by
            rcases hx_pow with h0 | hge
            · exact Or.inl h0
            · right
              have hle : ((m + 1 : ℕ) : ℤ) ≤ ((k + 1 : ℕ) : ℤ) * (m : ℤ) := by
                have hk1 : 1 ≤ k := Nat.pos_of_ne_zero hk0
                push_cast
                nlinarith
              exact le_trans hle hge
          have hmul := hval_mul_ge ((m + 1 : ℕ) : ℤ) 0
            (x ^ (k + 1)) ((p F).choose (k + 1) : M) hx_pow' (hval_nat _)
          simpa using hmul
      rw [hunit_ge1 (m + 1) (by omega) (u ^ (p F)), hpow_sub]
      rcases hsum_val with h0 | hge
      · left
        exact sub_eq_zero.mp (hpow_sub.trans h0)
      · exact Or.inr hge
    have hunit_pow_pd : ∀ (d : ℕ) (u : Mˣ),
        u ∈ unitGroup F M 1 → u ^ ((p F) ^ d) ∈ unitGroup F M (1 + d) := by
      intro d u hu
      induction d with
      | zero => simpa using hu
      | succ d ih =>
        rw [pow_succ, pow_mul, ← Nat.add_assoc]
        exact hunit_pow_p (1 + d) (by omega) (u ^ ((p F) ^ d)) ih
    exact ⟨hunit_anti, hunit_pow_pd⟩

  obtain ⟨hunit_anti_L, hunit_pow_pd_L⟩ := hUnitShift L
  obtain ⟨hunit_anti_E, hunit_pow_pd_E⟩ := hUnitShift E
  obtain ⟨hunit_anti_M₁, hunit_pow_pd_M₁⟩ := hUnitShift M₁

  have hν_triv1_gen : ∀ (ν : Lˣ →* (Ω F)ˣ), ν ^ ℓ = 1 →
      (∀ u ∈ unitGroup F L (condExp F L ν), ν u = 1) →
      (∀ u ∈ unitGroup F L 1, ν u = 1) ∧ condExp F L ν ≤ 1 := by
    intro ν hν_pow hν_cond1
    have htriv : ∀ u ∈ unitGroup F L 1, ν u = 1 := by
      intro u hu
      set d : ℕ := condExp F L ν
      have hu_pd : u ^ ((p F) ^ d) ∈ unitGroup F L d :=
        hunit_anti_L (by omega : d ≤ 1 + d) (hunit_pow_pd_L d u hu)
      have hpow_pd : (ν u) ^ ((p F) ^ d) = 1 := by
        rw [← map_pow]
        exact hν_cond1 _ hu_pd
      have hpow_ell : (ν u) ^ ℓ = 1 := by
        rw [← MonoidHom.pow_apply, hν_pow, MonoidHom.one_apply]
      have hcop_d : Nat.Coprime ℓ ((p F) ^ d) := hcop.pow_right d
      have hgcd := (pow_gcd_eq_one (a := ν u) (m := ℓ) (n := (p F) ^ d)).mpr ⟨hpow_ell, hpow_pd⟩
      rwa [hcop_d.gcd_eq_one, pow_one] at hgcd
    exact ⟨htriv, Nat.sInf_le htriv⟩

  have hνE_cond1 : ∀ u ∈ unitGroup F L (condExp F L νE), νE u = 1 := by
    intro u
    have h := hνE_cond 1 hℓ_gt1 u
    rwa [pow_one νE] at h
  have hνM₁_cond1 : ∀ u ∈ unitGroup F L (condExp F L νM₁), νM₁ u = 1 := by
    intro u
    have h := hνM₁_cond 1 hℓ_gt1 u
    rwa [pow_one νM₁] at h
  obtain ⟨hνE_triv1, hcond_νE_le1⟩ := hν_triv1_gen νE hνE_pow hνE_cond1
  obtain ⟨hνM₁_triv1, hcond_νM₁_le1⟩ := hν_triv1_gen νM₁ hνM₁_pow hνM₁_cond1
  have hν_triv1 : ∀ u ∈ unitGroup F L 1, νE u = 1 ∧ νM₁ u = 1 :=
    fun u hu => ⟨hνE_triv1 u hu, hνM₁_triv1 u hu⟩

  
  obtain ⟨hval0_L, hval1_L, _, _, hval_mul_L, hval_inv_L, hval_surj_L, _, hunit0_L, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_zpow_L : ∀ (u : Lˣ) (m : ℤ),
      valL F L (((u ^ m : Lˣ) : L)) = m * valL F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * valL F L (u : L)
      rw [zpow_natCast, Units.val_pow_eq_pow_val, hval_pow_L (u : L) n (Units.ne_zero u)]
    | negSucc n =>
      rw [zpow_negSucc, hval_inv_L (u ^ (n + 1)), Units.val_pow_eq_pow_val,
        hval_pow_L (u : L) (n + 1) (Units.ne_zero u), Int.negSucc_eq]
      push_cast
      ring

  have hroot_exh : ∀ (ζ ξ : (Ω F)ˣ), ζ ≠ 1 → ζ ^ ℓ = 1 → ξ ^ ℓ = 1 →
      ∃ k < ℓ, ζ ^ k = ξ := by
    intro ζ ξ hζ_ne hζ_pow hξ
    have hord : orderOf ζ = ℓ := orderOf_eq_prime hζ_pow hζ_ne
    let ϕ : Fin ℓ → Ω F := fun i => ((ζ ^ (i : ℕ) : (Ω F)ˣ) : Ω F)
    have hpow_inj_le : ∀ {a b : ℕ}, a ≤ b → b < ℓ → ζ ^ a = ζ ^ b → a = b := by
      intro a b hab hb heq
      have hsub : ζ ^ (b - a) * ζ ^ a = 1 * ζ ^ a := by
        rw [← pow_add, Nat.sub_add_cancel hab, one_mul, heq]
      have hpow_sub : ζ ^ (b - a) = 1 := mul_right_cancel hsub
      have hdvd : ℓ ∣ b - a := by
        rw [← hord]
        exact orderOf_dvd_iff_pow_eq_one.mpr hpow_sub
      have hlt : b - a < ℓ := by omega
      have hzero : b - a = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      omega
    have hϕ_inj : Function.Injective ϕ := by
      intro i j hij
      have hζ_ij : ζ ^ (i : ℕ) = ζ ^ (j : ℕ) := Units.ext hij
      rcases le_total (i : ℕ) (j : ℕ) with hle | hle
      · exact Fin.ext (hpow_inj_le hle j.2 hζ_ij)
      · exact Fin.ext (hpow_inj_le hle i.2 hζ_ij.symm).symm
    let P_poly : Polynomial (Ω F) := Polynomial.X ^ ℓ - Polynomial.C 1
    have hP_ne : P_poly ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hℓ_pos 1
    have hP_deg : P_poly.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    let S_img : Finset (Ω F) := (Finset.univ : Finset (Fin ℓ)).image ϕ
    let R_fin : Finset (Ω F) := P_poly.roots.toFinset
    have hsub_roots : S_img ⊆ R_fin := by
      intro z hz
      rcases Finset.mem_image.mp hz with ⟨i, _, rfl⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P_poly, ϕ]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← pow_mul, mul_comm (i : ℕ) ℓ, pow_mul, ← Units.val_pow_eq_pow_val,
        hζ_pow, Units.val_one, one_pow]
    have hcard_le : R_fin.card ≤ S_img.card := by
      calc R_fin.card
        _ ≤ P_poly.roots.card := Multiset.toFinset_card_le P_poly.roots
        _ ≤ P_poly.natDegree := Polynomial.card_roots' P_poly
        _ = ℓ := hP_deg
        _ = (Finset.univ : Finset (Fin ℓ)).card := (Fintype.card_fin ℓ).symm
        _ = S_img.card := (Finset.card_image_of_injective _ hϕ_inj).symm
    have hS_eq_R : S_img = R_fin := Finset.eq_of_subset_of_card_le hsub_roots hcard_le
    have hξ_mem : (ξ : Ω F) ∈ R_fin := by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P_poly]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← Units.val_pow_eq_pow_val, hξ, Units.val_one]
    rw [← hS_eq_R] at hξ_mem
    rcases Finset.mem_image.mp hξ_mem with ⟨i, _, hi⟩
    exact ⟨i.1, i.2, Units.ext hi⟩

  obtain ⟨ϖ_L, hϖ_L⟩ := hval_surj_L 1
  have hν_not_both0 : ¬ (condExp F L νE = 0 ∧ condExp F L νM₁ = 0) := by
    rintro ⟨hcE0, hcM0⟩
    have hνE_triv0 : ∀ u ∈ unitGroup F L 0, νE u = 1 := hcE0 ▸ hνE_cond1
    have hνM₁_triv0 : ∀ u ∈ unitGroup F L 0, νM₁ u = 1 := hcM0 ▸ hνM₁_cond1
    have hunram_eval : ∀ (ν : Lˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F L 0, ν u = 1) →
        ∀ x : Lˣ, ν x = (ν ϖ_L) ^ (valL F L (x : L)) := by
      intro ν htriv0 x
      let m : ℤ := valL F L (x : L)
      let u_x : Lˣ := x * (ϖ_L ^ m)⁻¹
      have hu_x_mem : u_x ∈ unitGroup F L 0 := by
        rw [hunit0_L]
        change valL F L (((x * (ϖ_L ^ m)⁻¹ : Lˣ) : L)) = 0
        rw [Units.val_mul, hval_mul_L (x : L) _ (Units.ne_zero x) (Units.ne_zero _),
          hval_inv_L (ϖ_L ^ m), hval_zpow_L ϖ_L m, hϖ_L, mul_one]
        change m + -m = 0
        omega
      have hx_eq : x = u_x * ϖ_L ^ m := by
        dsimp [u_x]
        exact (inv_mul_cancel_right x (ϖ_L ^ m)).symm
      calc ν x = ν (u_x * ϖ_L ^ m) := congrArg ν hx_eq
        _ = ν u_x * ν (ϖ_L ^ m) := map_mul ν u_x (ϖ_L ^ m)
        _ = 1 * (ν ϖ_L) ^ m := by rw [htriv0 u_x hu_x_mem, map_zpow]
        _ = (ν ϖ_L) ^ (valL F L (x : L)) := one_mul _
    have hζ_ne : νE ϖ_L ≠ 1 := by
      intro h1
      apply hνE_ne
      ext x
      rw [hunram_eval νE hνE_triv0 x, h1, one_zpow, MonoidHom.one_apply]
    have hζ_pow : (νE ϖ_L) ^ ℓ = 1 := by
      rw [← MonoidHom.pow_apply, hνE_pow, MonoidHom.one_apply]
    have hξ_pow : (νM₁ ϖ_L) ^ ℓ = 1 := by
      rw [← MonoidHom.pow_apply, hνM₁_pow, MonoidHom.one_apply]
    obtain ⟨k, _, hk⟩ := hroot_exh (νE ϖ_L) (νM₁ ϖ_L) hζ_ne hζ_pow hξ_pow
    have hνM₁_eq_pow : ∀ x : Lˣ, νM₁ x = (νE x) ^ k := by
      intro x
      rw [hunram_eval νM₁ hνM₁_triv0 x, hunram_eval νE hνE_triv0 x, ← hk,
        ← zpow_natCast, ← zpow_natCast, ← zpow_mul, mul_comm (k : ℤ), zpow_mul]
    apply hξE_ne
    apply MonoidHom.ext
    intro y
    change νM₁ (Units.map (normLM F hLE) y) = 1
    rw [hνM₁_eq_pow (Units.map (normLM F hLE) y),
      (hνE_ker (Units.map (normLM F hLE) y)).mp ⟨y, rfl⟩, one_pow]

  
  obtain ⟨haddVal1, _, haddVal_mul, _, _, _, _⟩ := ld_addVal_finset_and_algebraMap_valL F L
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q_z : ℤ := valL F M z
      set r_z : ℤ := relVal F M z % f
      have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
          linarith
        let k : ℕ := r_z.toNat
        have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith

  obtain ⟨hresDeg_L_pos, hdiv_L⟩ := hrelVal_div L hval_surj_L

  have hBranchUnit : ∀ (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N]
      (hLN : L ≤ N), IsGaloisExt F L N →
      Module.finrank L (IntermediateField.extendScalars hLN) = ℓ →
      (∀ (m : ℕ), ∀ v ∈ unitGroup F L m,
        Units.map (IntermediateField.inclusion hLN).toMonoidHom v ∈ unitGroup F N m) ∧
      (∀ u ∈ unitGroup F N 1,
        Units.map (normLM F hLN) u ∈ unitGroup F L 1) ∧
      (∀ x : Lˣ,
        Units.map (normLM F hLN) (Units.map (IntermediateField.inclusion hLN).toMonoidHom x) =
          x ^ ℓ) := by
    intro N _ hLN hGalLN hdegLN
    obtain ⟨hval0_N, _, _, _, _, _, hval_surj_N, _, hunit0_N, hunit_ge1_N, _⟩ :=
      ld_valL_and_unitGroup_props F N
    obtain ⟨_, _, _, _, _, _, _, _, _, hunit_ge1_L, _⟩ :=
      ld_valL_and_unitGroup_props F L
    obtain ⟨hresDeg_N_pos, hdiv_N⟩ := hrelVal_div N hval_surj_N
    have hfN_int_ne : (resDeg F N : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hresDeg_N_pos)
    let N' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLN
    let eF : N ≃ₐ[F] N' :=
      { toExtendScalars F hLN with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLN).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F N' := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F L N' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L N' := Module.Finite.of_restrictScalars_finite F L N'
    have hrelVal_norm : ∀ y : N, relVal F L (normLM F hLN y) = relVal F N y := by
      intro y
      change addVal F (Algebra.norm F (Algebra.norm L (toExtendScalars F hLN y))) =
        addVal F (Algebra.norm F y)
      have h1 : Algebra.norm F (Algebra.norm L (toExtendScalars F hLN y)) =
          Algebra.norm F (toExtendScalars F hLN y) := Algebra.norm_norm
      have h2 : Algebra.norm F y = Algebra.norm F (toExtendScalars F hLN y) :=
        Algebra.norm_eq_of_algEquiv eF y
      rw [h1, ← h2]
    have hnorm_inc : ∀ x : L,
        normLM F hLN (IntermediateField.inclusion hLN x) = x ^ ℓ := by
      intro x
      change Algebra.norm L (algebraMap L N' x) = x ^ ℓ
      rw [Algebra.norm_algebraMap, hdegLN]
    have hnorm_inc_unit : ∀ x : Lˣ,
        Units.map (normLM F hLN) (Units.map (IntermediateField.inclusion hLN).toMonoidHom x) =
          x ^ ℓ := by
      intro x
      apply Units.ext
      exact hnorm_inc (x : L)
    have hValInc_rel : ∀ z : L,
        (resDeg F N : ℤ) * valL F N (IntermediateField.inclusion hLN z) =
          ((resDeg F L : ℤ) * (ℓ : ℤ)) * valL F L z := by
      intro z
      by_cases hz0 : z = 0
      · rw [hz0, map_zero, hval0_N, hval0_L, mul_zero, mul_zero]
      · calc (resDeg F N : ℤ) * valL F N (IntermediateField.inclusion hLN z)
          _ = relVal F N (IntermediateField.inclusion hLN z) := (hdiv_N _).symm
          _ = relVal F L (normLM F hLN (IntermediateField.inclusion hLN z)) :=
              (hrelVal_norm _).symm
          _ = relVal F L (z ^ ℓ) := by rw [hnorm_inc z]
          _ = (resDeg F L : ℤ) * valL F L (z ^ ℓ) := hdiv_L _
          _ = (resDeg F L : ℤ) * ((ℓ : ℤ) * valL F L z) := by
              rw [hval_pow_L z ℓ hz0]
          _ = ((resDeg F L : ℤ) * (ℓ : ℤ)) * valL F L z := by ring
    set e_NL : ℤ := valL F N (IntermediateField.inclusion hLN (ϖ_L : L))
    have he_rel : (resDeg F N : ℤ) * e_NL = (resDeg F L : ℤ) * (ℓ : ℤ) := by
      have h := hValInc_rel (ϖ_L : L)
      rwa [hϖ_L, mul_one] at h
    have he_pos : 1 ≤ e_NL := by
      have hposL : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hresDeg_L_pos
      have hpos_ell : (0 : ℤ) < (ℓ : ℤ) := Nat.cast_pos.mpr hℓ_pos
      have hposN : (0 : ℤ) < (resDeg F N : ℤ) := Nat.cast_pos.mpr hresDeg_N_pos
      nlinarith
    have hValInc : ∀ z : L,
        valL F N (IntermediateField.inclusion hLN z) = e_NL * valL F L z := by
      intro z
      apply mul_left_cancel₀ hfN_int_ne
      calc (resDeg F N : ℤ) * valL F N (IntermediateField.inclusion hLN z)
        _ = ((resDeg F L : ℤ) * (ℓ : ℤ)) * valL F L z := hValInc_rel z
        _ = ((resDeg F N : ℤ) * e_NL) * valL F L z := by rw [← he_rel]
        _ = (resDeg F N : ℤ) * (e_NL * valL F L z) := by ring
    have hinc_unit : ∀ (m : ℕ), ∀ v ∈ unitGroup F L m,
        Units.map (IntermediateField.inclusion hLN).toMonoidHom v ∈ unitGroup F N m := by
      intro m v hv
      by_cases hm0 : m = 0
      · subst hm0
        rw [hunit0_N]
        change valL F N (IntermediateField.inclusion hLN (v : L)) = 0
        rw [hValInc (v : L), (hunit0_L v).mp hv, mul_zero]
      · have hm1 : 1 ≤ m := by omega
        rw [hunit_ge1_N m hm1]
        rcases (hunit_ge1_L m hm1 v).mp hv with h1 | hge
        · left
          change IntermediateField.inclusion hLN (v : L) = 1
          rw [h1, map_one]
        · right
          change (m : ℤ) ≤ valL F N (IntermediateField.inclusion hLN (v : L) - 1)
          rw [← map_one (IntermediateField.inclusion hLN), ← map_sub, hValInc ((v : L) - 1)]
          nlinarith
    have hinj_LN : Function.Injective (IntermediateField.inclusion hLN) :=
      (IntermediateField.inclusion hLN).injective
    have hinc_unit1_iff : ∀ x : Lˣ,
        Units.map (IntermediateField.inclusion hLN).toMonoidHom x ∈ unitGroup F N 1 →
          x ∈ unitGroup F L 1 := by
      intro x hx
      rw [hunit_ge1_L 1 le_rfl]
      rcases (hunit_ge1_N 1 le_rfl _).mp hx with h1 | hge
      · left
        exact hinj_LN (by simpa using h1)
      · right
        change 1 ≤ valL F N (IntermediateField.inclusion hLN (x : L) - 1) at hge
        rw [← map_one (IntermediateField.inclusion hLN), ← map_sub, hValInc ((x : L) - 1)] at hge
        by_contra hlt
        have hle0 : valL F L ((x : L) - 1) ≤ 0 := by omega
        have hmul_le0 : e_NL * valL F L ((x : L) - 1) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
        omega
    have hGalLN' : IsGalois L ↥N' := by
      have hSepLN' : Algebra.IsSeparable L N' := hGalLN.2.2.2 hLN
      haveI : Algebra.IsSeparable L N' := hSepLN'
      have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
          [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
          (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
          IsGalois k K₀ := by
        intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
        let N_sep : IntermediateField k Ω_bar := separableClosure k Ω_bar
        haveI : IsGalois k N_sep := separableClosure.isGalois k Ω_bar
        haveI : Normal k N_sep := IsGalois.to_normal
        have hK₀N : K₀ ≤ N_sep := by
          intro z hz
          rw [mem_separableClosure_iff]
          let x : K₀ := ⟨z, hz⟩
          have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
          have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
          change (minpoly k z).Separable
          rw [hmin]
          exact hx
        let K_N : IntermediateField k N_sep := K₀.comap N_sep.val
        have hKN_map : K_N.map N_sep.val = K₀ := by
          ext z
          refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
          rintro ⟨y, hy, rfl⟩
          exact hy
        have hKN_norm : K_N.fixingSubgroup.Normal := by
          refine ⟨fun h hh g => ?_⟩
          obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
          obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
          rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
          have hτ_fix : ∀ x ∈ K₀, τ x = x := by
            intro x hx
            let z : N_sep := ⟨x, hK₀N hx⟩
            have hz : (AlgEquiv.restrictNormalHom ↥N_sep τ) z = z := hh z hx
            have h1 : (((AlgEquiv.restrictNormalHom ↥N_sep τ) z : ↥N_sep) : Ω_bar) = x :=
              congrArg Subtype.val hz
            rwa [AlgEquiv.restrictNormalHom_apply] at h1
          intro y hy
          apply Subtype.ext
          rw [← map_inv, ← map_mul, ← map_mul]
          change ((AlgEquiv.restrictNormalHom N_sep (σ * τ * σ⁻¹) y : N_sep) : Ω_bar) = y.1
          rw [AlgEquiv.restrictNormalHom_apply]
          exact h_norm_fix σ τ hτ_fix y.1 hy
        haveI : K_N.fixingSubgroup.Normal := hKN_norm
        haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
        let e_KN : ↥K_N ≃ₐ[k] ↥K₀ :=
          (K_N.equivMap N_sep.val).trans (IntermediateField.equivOfEq hKN_map)
        exact IsGalois.of_algEquiv e_KN
      haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
      haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
      have hN'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
          (∀ x ∈ N', τ x = x) → ∀ x ∈ N', (σ * τ * σ⁻¹) x = x := by
        intro σ τ hτ
        let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
        let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
        have hτN : τ_F.1 ∈ N.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro x hx
          exact hτ x ((IntermediateField.mem_extendScalars hLN).mpr hx)
        have hconjN : (σ_F * τ_F * σ_F⁻¹).1 ∈ N.fixingSubgroup :=
          hGalLN.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτN
        intro x hx
        rw [IntermediateField.mem_fixingSubgroup_iff] at hconjN
        exact hconjN x ((IntermediateField.mem_extendScalars hLN).mp hx)
      exact helper_isGalois L (AlgebraicClosure F) N' hN'_norm_fix
    haveI : IsGalois L ↥N' := hGalLN'
    let G : Type u := (N' ≃ₐ[L] N')
    let fromExtendScalars : N' →+* N :=
      { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLN).mp z.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let actHom : G → (N →+* N) := fun σ =>
      fromExtendScalars.comp (σ.toRingEquiv.toRingHom.comp (toExtendScalars F hLN))
    have hact_norm : ∀ y : N,
        IntermediateField.inclusion hLN (normLM F hLN y) = ∏ τ : G, actHom τ y := by
      intro y
      have h1 := congrArg fromExtendScalars
        (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLN y))
      exact h1.trans (map_prod fromExtendScalars (fun τ : G => τ (toExtendScalars F hLN y)) Finset.univ)
    have hnorm_act : ∀ (σ : G) (y : N), normLM F hLN (actHom σ y) = normLM F hLN y := by
      intro σ y
      apply hinj_LN
      rw [hact_norm (actHom σ y), hact_norm y]
      have hmul : (∏ τ : G, actHom τ (actHom σ y)) = ∏ τ : G, actHom (τ * σ) y :=
        Finset.prod_congr rfl fun τ _ => rfl
      rw [hmul]
      exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => actHom τ y)
    have hact_val : ∀ (σ : G) (y : N), valL F N (actHom σ y) = valL F N y := by
      intro σ y
      apply mul_left_cancel₀ hfN_int_ne
      rw [← hdiv_N (actHom σ y), ← hdiv_N y, ← hrelVal_norm (actHom σ y), ← hrelVal_norm y,
        hnorm_act σ y]
    have hval_prod_N : ∀ (S : Finset G) (f : G → Nˣ),
        ((∏ σ ∈ S, f σ : Nˣ) : N) = ∏ σ ∈ S, ((f σ : Nˣ) : N) := by
      intro S f
      induction' S using Finset.induction_on with σ S' hσ ih
      · rfl
      · rw [Finset.prod_insert hσ, Finset.prod_insert hσ, Units.val_mul, ih]
    have hnorm_unit1 : ∀ u ∈ unitGroup F N 1,
        Units.map (normLM F hLN) u ∈ unitGroup F L 1 := by
      intro u hu
      apply hinc_unit1_iff
      have hprod_mem : (∏ σ : G, Units.map (actHom σ).toMonoidHom u) ∈ unitGroup F N 1 := by
        apply (unitGroup F N 1).prod_mem
        intro σ _
        rw [hunit_ge1_N 1 le_rfl]
        rcases (hunit_ge1_N 1 le_rfl u).mp hu with h1 | hge
        · left
          change actHom σ (u : N) = 1
          rw [h1, map_one]
        · right
          change 1 ≤ valL F N (actHom σ (u : N) - 1)
          rw [← map_one (actHom σ), ← map_sub, hact_val σ ((u : N) - 1)]
          exact hge
      have hprod_eq :
          Units.map (IntermediateField.inclusion hLN).toMonoidHom (Units.map (normLM F hLN) u) =
            ∏ σ : G, Units.map (actHom σ).toMonoidHom u := by
        apply Units.ext
        change IntermediateField.inclusion hLN (normLM F hLN (u : N)) =
          ((∏ σ : G, Units.map (actHom σ).toMonoidHom u : Nˣ) : N)
        rw [hact_norm (u : N), hval_prod_N]
        rfl
      rwa [hprod_eq]
    exact ⟨hinc_unit, hnorm_unit1, hnorm_inc_unit⟩

  obtain ⟨hinc_unit_E, hnorm_unit1_E, hnorm_inc_E⟩ := hBranchUnit E hLE hGalLE rfl
  obtain ⟨hinc_unit_M₁, hnorm_unit1_M₁, hnorm_inc_M₁⟩ := hBranchUnit M₁ hLM₁ hGalLM₁ hdegM₁

  
  set D : ℕ := max (condExp F E χE') (condExp F M₁ χM₁')
  set P : ℕ := (p F) ^ D
  have hD_pos : 1 ≤ D := le_trans hcond_χE'_pos (le_max_left _ _)
  have hP_ge2 : 2 ≤ P := by
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ 2 ^ D := Nat.pow_le_pow_right (by omega) hD_pos
      _ ≤ (p F) ^ D := Nat.pow_le_pow_left hp.two_le D
  have hP_int_pos : (0 : ℤ) < (P : ℤ) := by omega
  have hP_int_gt1 : (1 : ℤ) < (P : ℤ) := by omega
  have hcop_P : Nat.Coprime ℓ P := hcop.pow_right D
  have hbez : (1 : ℤ) = (ℓ : ℤ) * Nat.gcdA ℓ P + (P : ℤ) * Nat.gcdB ℓ P := by
    have h := Nat.gcd_eq_gcd_ab ℓ P
    rw [hcop_P.gcd_eq_one, Nat.cast_one] at h
    exact h
  set a_mod : ℤ := Nat.gcdA ℓ P % (P : ℤ)
  have ha_nonneg : 0 ≤ a_mod := Int.emod_nonneg (Nat.gcdA ℓ P) (by omega)
  set m_ℓ : ℕ := a_mod.toNat
  have hm_cast : (m_ℓ : ℤ) = a_mod := Int.toNat_of_nonneg ha_nonneg
  have hmod1 : ((ℓ * m_ℓ : ℕ) : ℤ) % (P : ℤ) = 1 := by
    calc ((ℓ * m_ℓ : ℕ) : ℤ) % (P : ℤ)
      _ = ((ℓ : ℤ) * a_mod) % (P : ℤ) := by push_cast; rw [hm_cast]
      _ = ((ℓ : ℤ) * (Nat.gcdA ℓ P % (P : ℤ))) % (P : ℤ) := rfl
      _ = ((ℓ : ℤ) * Nat.gcdA ℓ P) % (P : ℤ) := by
          rw [Int.mul_emod, Int.emod_emod, ← Int.mul_emod]
      _ = ((ℓ : ℤ) * Nat.gcdA ℓ P + (P : ℤ) * Nat.gcdB ℓ P) % (P : ℤ) := by
          rw [Int.add_mul_emod_self_left]
      _ = (1 : ℤ) % (P : ℤ) := by rw [← hbez]
      _ = 1 := Int.emod_eq_of_lt (by omega) hP_int_gt1
  have hℓm_pos : 1 ≤ ℓ * m_ℓ := by
    by_contra h0
    have h0' : ℓ * m_ℓ = 0 := by omega
    rw [h0', Nat.cast_zero, Int.zero_emod] at hmod1
    omega
  have hdiv_mod := Int.emod_add_ediv ((ℓ * m_ℓ : ℕ) : ℤ) (P : ℤ)
  rw [hmod1] at hdiv_mod
  have hdvd_int : (P : ℤ) ∣ ((ℓ * m_ℓ - 1 : ℕ) : ℤ) :=
    ⟨((ℓ * m_ℓ : ℕ) : ℤ) / (P : ℤ), by omega⟩
  have hdvd_nat : P ∣ ℓ * m_ℓ - 1 := Int.ofNat_dvd.mp hdvd_int
  set k_quot : ℕ := (ℓ * m_ℓ - 1) / P
  have h_ell_m : ℓ * m_ℓ = P * k_quot + 1 := by
    have hmul : P * k_quot = ℓ * m_ℓ - 1 := Nat.mul_div_cancel' hdvd_nat
    omega

  let lam_L : Lˣ →* (Ω F)ˣ :=
    (χE'.comp (Units.map (IntermediateField.inclusion hLE).toMonoidHom)) ^ m_ℓ

  have hχE'_triv_D : ∀ u ∈ unitGroup F E D, χE' u = 1 :=
    fun u hu => hχE'_cond u (hunit_anti_E (le_max_left _ _) hu)
  have hχM₁'_triv_D : ∀ w ∈ unitGroup F M₁ D, χM₁' w = 1 :=
    fun w hw => hχM₁'_cond w (hunit_anti_M₁ (le_max_right _ _) hw)

  have hχE'_pow_P : ∀ u ∈ unitGroup F E 1, (χE' u) ^ P = 1 := by
    intro u hu
    rw [← map_pow]
    exact hχE'_triv_D (u ^ P) (hunit_anti_E (by omega : D ≤ 1 + D) (hunit_pow_pd_E D u hu))
  have hχM₁'_pow_P : ∀ w ∈ unitGroup F M₁ 1, (χM₁' w) ^ P = 1 := by
    intro w hw
    rw [← map_pow]
    exact hχM₁'_triv_D (w ^ P) (hunit_anti_M₁ (by omega : D ≤ 1 + D) (hunit_pow_pd_M₁ D w hw))

  have hlam_normE_eq : ∀ u ∈ unitGroup F E 1,
      (lam_L.comp (Units.map (normLM F hLE))) u = χE' u := by
    intro u hu
    set x : Lˣ := Units.map (normLM F hLE) u
    have hx1 : x ∈ unitGroup F L 1 := hnorm_unit1_E u hu
    obtain ⟨hνEx, hνM₁x⟩ := hν_triv1 x hx1
    have hprod_νE : (∏ j ∈ Finset.range ℓ, (νE ^ j) x) = 1 := by
      apply Finset.prod_eq_one
      intro j _
      rw [MonoidHom.pow_apply, hνEx, one_pow]
    have hprod_νM₁ : (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x) = 1 := by
      apply Finset.prod_eq_one
      intro j _
      rw [MonoidHom.pow_apply, hνM₁x, one_pow]
    have hrest_x : χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) =
        χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) := by
      have h := hCommonRest x
      rwa [hprod_νE, hprod_νM₁, mul_one, mul_one] at h
    have hpow_u : (χE' u) ^ ℓ =
        χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) :=
      (hχE_pow u).trans hrest_x.symm
    change (χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x)) ^ m_ℓ = χE' u
    rw [← hpow_u, ← pow_mul, h_ell_m, pow_add, pow_mul, hχE'_pow_P u hu,
      one_pow, pow_one, one_mul]

  have hlam_normM₁_eq : ∀ w ∈ unitGroup F M₁ 1,
      (lam_L.comp (Units.map (normLM F hLM₁))) w = χM₁' w := by
    intro w hw
    set x : Lˣ := Units.map (normLM F hLM₁) w
    change (χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x)) ^ m_ℓ = χM₁' w
    rw [← hχM₁_pow w, ← pow_mul, h_ell_m, pow_add, pow_mul, hχM₁'_pow_P w hw,
      one_pow, pow_one, one_mul]

  have hsub5_5 : ∀ u ∈ unitGroup F E 1,
      (χE' * (lam_L.comp (Units.map (normLM F hLE)))⁻¹) u = 1 := by
    intro u hu
    rw [MonoidHom.mul_apply, MonoidHom.inv_apply, hlam_normE_eq u hu, mul_inv_cancel]

  have hsub5_6 : ∀ w ∈ unitGroup F M₁ 1,
      (χM₁' * (lam_L.comp (Units.map (normLM F hLM₁)))⁻¹) w = 1 := by
    intro w hw
    rw [MonoidHom.mul_apply, MonoidHom.inv_apply, hlam_normM₁_eq w hw, mul_inv_cancel]

  have hcond_self_of_D : ∀ (M : IntermediateField F (AlgebraicClosure F)) (θ : Mˣ →* (Ω F)ˣ),
      (∀ u ∈ unitGroup F M D, θ u = 1) →
      ∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1 :=
    fun M θ hD => Nat.sInf_mem (⟨D, hD⟩ : {a : ℕ | ∀ u ∈ unitGroup F M a, θ u = 1}.Nonempty)

  have hlam_triv_D : ∀ v ∈ unitGroup F L D, lam_L v = 1 := by
    intro v hv
    change (χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom v)) ^ m_ℓ = 1
    rw [hχE'_triv_D _ (hinc_unit_E D v hv), one_pow]

  have hlam_L_cond : ∀ v ∈ unitGroup F L (condExp F L lam_L), lam_L v = 1 :=
    hcond_self_of_D L lam_L hlam_triv_D

  have hsub5_1 : ∀ j < ℓ,
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j * lam_L)), (νE ^ j * lam_L) u = 1 := by
    intro j _
    apply hcond_self_of_D L (νE ^ j * lam_L)
    intro v hv
    have hv1 : v ∈ unitGroup F L 1 := hunit_anti_L hD_pos hv
    rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hνE_triv1 v hv1, hlam_triv_D v hv,
      one_pow, mul_one]

  have hsub5_2 : ∀ j < ℓ,
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j * lam_L)), (νM₁ ^ j * lam_L) u = 1 := by
    intro j _
    apply hcond_self_of_D L (νM₁ ^ j * lam_L)
    intro v hv
    have hv1 : v ∈ unitGroup F L 1 := hunit_anti_L hD_pos hv
    rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hνM₁_triv1 v hv1, hlam_triv_D v hv,
      one_pow, mul_one]

  have hsub5_3 : ∀ u ∈ unitGroup F E (condExp F E (lam_L.comp (Units.map (normLM F hLE)))),
      (lam_L.comp (Units.map (normLM F hLE))) u = 1 := by
    apply hcond_self_of_D E (lam_L.comp (Units.map (normLM F hLE)))
    intro u hu
    rw [hlam_normE_eq u (hunit_anti_E hD_pos hu), hχE'_triv_D u hu]

  have hsub5_4 : ∀ w ∈ unitGroup F M₁ (condExp F M₁ (lam_L.comp (Units.map (normLM F hLM₁)))),
      (lam_L.comp (Units.map (normLM F hLM₁))) w = 1 := by
    apply hcond_self_of_D M₁ (lam_L.comp (Units.map (normLM F hLM₁)))
    intro w hw
    rw [hlam_normM₁_eq w (hunit_anti_M₁ hD_pos hw), hχM₁'_triv_D w hw]

  have hsub5_7 : ∀ x : Lˣ,
      (χE' * (lam_L.comp (Units.map (normLM F hLE)))⁻¹)
          (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
        (∏ j ∈ Finset.range ℓ, (νE ^ j) x) =
      (χM₁' * (lam_L.comp (Units.map (normLM F hLM₁)))⁻¹)
          (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) *
        (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x) := by
    intro x
    have hnormE_x : (lam_L.comp (Units.map (normLM F hLE)))
        (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) = lam_L (x ^ ℓ) := by
      change lam_L (Units.map (normLM F hLE)
        (Units.map (IntermediateField.inclusion hLE).toMonoidHom x)) = lam_L (x ^ ℓ)
      rw [hnorm_inc_E x]
    have hnormM₁_x : (lam_L.comp (Units.map (normLM F hLM₁)))
        (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) = lam_L (x ^ ℓ) := by
      change lam_L (Units.map (normLM F hLM₁)
        (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x)) = lam_L (x ^ ℓ)
      rw [hnorm_inc_M₁ x]
    simp only [MonoidHom.mul_apply, MonoidHom.inv_apply, hnormE_x, hnormM₁_x]
    calc (χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) * (lam_L (x ^ ℓ))⁻¹) *
          (∏ j ∈ Finset.range ℓ, (νE ^ j) x)
      _ = (χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
            (∏ j ∈ Finset.range ℓ, (νE ^ j) x)) * (lam_L (x ^ ℓ))⁻¹ := by ac_rfl
      _ = (χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) *
            (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x)) * (lam_L (x ^ ℓ))⁻¹ := by
          rw [hCommonRest x]
      _ = (χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) * (lam_L (x ^ ℓ))⁻¹) *
            (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x) := by ac_rfl

  have hsub5_8 : ¬ (2 ≤ condExp F L lam_L) →
      condExp F E χE' = 1 ∧ condExp F M₁ χM₁' = 1 ∧
      (∀ u ∈ unitGroup F E 1, χE' u = 1) ∧
      (∀ u ∈ unitGroup F M₁ 1, χM₁' u = 1) := by
    intro hnot2
    have hle1 : condExp F L lam_L ≤ 1 := by omega
    have hlam_triv1 : ∀ v ∈ unitGroup F L 1, lam_L v = 1 :=
      fun v hv => hlam_L_cond v (hunit_anti_L hle1 hv)
    have hχE'_triv1 : ∀ u ∈ unitGroup F E 1, χE' u = 1 := by
      intro u hu
      rw [← hlam_normE_eq u hu]
      exact hlam_triv1 _ (hnorm_unit1_E u hu)
    have hχM₁'_triv1 : ∀ w ∈ unitGroup F M₁ 1, χM₁' w = 1 := by
      intro w hw
      rw [← hlam_normM₁_eq w hw]
      exact hlam_triv1 _ (hnorm_unit1_M₁ w hw)
    have hcondE_le1 : condExp F E χE' ≤ 1 := Nat.sInf_le hχE'_triv1
    have hcondM₁_le1 : condExp F M₁ χM₁' ≤ 1 := Nat.sInf_le hχM₁'_triv1
    exact ⟨le_antisymm hcondE_le1 hcond_χE'_pos,
      le_antisymm hcondM₁_le1 hcond_χM₁'_pos,
      hχE'_triv1, hχM₁'_triv1⟩

  exact ⟨hν_triv1, hcond_νE_le1, hcond_νM₁_le1, hν_not_both0,
    ⟨lam_L, hsub5_1, hsub5_2, hsub5_3, hsub5_4, hsub5_5, hsub5_6, hsub5_7, hsub5_8⟩⟩

theorem ld_ch12_tame_bicyclic_base_char_and_pow_rel (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    [FiniteDimensional F M₁] [FiniteDimensional F K₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hGalEK₁ : IsGaloisExt F E K₁) (hGalM₁K₁ : IsGaloisExt F M₁ K₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hAbEK₁ : IsAbelianExt F hEK₁) (hAbM₁K₁ : IsAbelianExt F hM₁K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hTame : Module.finrank L (IntermediateField.extendScalars hLE) ≠ p F)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_inf : E ⊓ M₁ = L) (h_sup : E ⊔ M₁ = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (χM₁ : relWeil F M₁ →* (Ω F)ˣ) (hχM₁_weil : IsWeilRep F M₁ (charRep F M₁ χM₁))
