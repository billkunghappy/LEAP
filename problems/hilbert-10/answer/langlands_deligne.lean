    have htr_u1 := htr_bound (u + 1 : ℤ) (w + z) hwz_tr_in
    have hnw_u1 := hnorm_val_ge (u + 1 : ℤ) w (hval_le_K hu1_le_d₁ hw)
    have hsum_u1 := hval_add_M (u + 1 : ℤ) (traceLM F hMK (w + z)) (normLM F hMK w) htr_u1 hnw_u1
    have heq : normLM F hMK (1 + w) - 1 = traceLM F hMK (w + z) + normLM F hMK w := by
      rw [hnorm_eq]
      ring
    rwa [heq]
  · intro u hu_ge w hw
    set d : ℕ := t + p * (u - t)
    have hd_ge1 : 1 ≤ d := by omega
    have hut : ((u - t : ℕ) : ℤ) = (u : ℤ) - (t : ℤ) := by omega
    have hut_ge1 : (1 : ℤ) ≤ (u : ℤ) - (t : ℤ) := by omega
    have ht_int_ge1 : (1 : ℤ) ≤ (t : ℤ) := by omega
    have hd_int : (d : ℤ) = (t : ℤ) + (p : ℤ) * ((u : ℤ) - (t : ℤ)) := by
      dsimp [d]
      push_cast
      rw [hut]
    have hw_tr_in : w = 0 ∨
        (p : ℤ) * (u : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K w := by
      apply hval_le_K _ hw
      rw [hd_int, hp_sub1_int]
      linarith
    have htr_w := htr_bound (u : ℤ) w hw_tr_in
    obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp d hd_ge1 w hw
    have hprod_ut : (0 : ℤ) ≤ ((p : ℤ) - 1) * ((u : ℤ) - (t : ℤ) - 1) :=
      mul_nonneg (by omega) (by omega)
    have hz_tr_in : z = 0 ∨
        (p : ℤ) * (u + 1 : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K z := by
      apply hval_le_K _ hz
      have h2d : (2 * d : ℤ) = 2 * (d : ℤ) := by push_cast; ring
      rw [h2d, hd_int, hp_sub1_int]
      linarith
    have htr_z := htr_bound (u + 1 : ℤ) z hz_tr_in
    have hu1_le_d : (u + 1 : ℤ) ≤ (d : ℤ) := by
      rw [hd_int]
      linarith
    have hnw_u1 := hnorm_val_ge (u + 1 : ℤ) w (hval_le_K hu1_le_d hw)
    have hsum_u1 := hval_add_M (u + 1 : ℤ) (traceLM F hMK z) (normLM F hMK w) htr_z hnw_u1
    have heq : normLM F hMK (1 + w) - (1 + traceLM F hMK w) =
        traceLM F hMK z + normLM F hMK w := by
      rw [hnorm_eq, map_add (traceLM F hMK) w z]
      ring
    refine ⟨htr_w, ?_⟩
    rwa [heq]

theorem ld_ch14_wild_tower_sub_and_super_norm_comp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M_C M_1 K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F M_1] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K) (hMC_M1 : M_C ≤ M_1) (hM1_K : M_1 ≤ K)
    (hp_prime : Nat.Prime (p F))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (ϖ_K : Kˣ) (ϖ_M1 : M_1ˣ) (ϖ_MC : M_Cˣ)
    (hϖ_norm1 : Units.map (normLM F hM1_K) ϖ_K = ϖ_M1)
    (hϖ_norm2 : Units.map (normLM F hMC_M1) ϖ_M1 = ϖ_MC)
    (hϖ_M1 : valL F M_1 (ϖ_M1 : M_1) = 1)
    (hϖ_MC : valL F M_C (ϖ_MC : M_C) = 1)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (hValNorm_KM1 : ∀ w : K, valL F M_1 (normLM F hM1_K w) = valL F K w)
    (hSub_KM1 : ∀ (v : ℕ), 1 ≤ v → v < t → ∀ w : K, (w = 0 ∨ (v : ℤ) ≤ valL F K w) →
      normLM F hM1_K (1 + w) - (1 + normLM F hM1_K w) = 0 ∨
        (v + 1 : ℤ) ≤ valL F M_1 (normLM F hM1_K (1 + w) - (1 + normLM F hM1_K w)))
    (hStab_KM1 : ∀ (m : ℕ), 1 ≤ m → m ≤ t + 1 → ∀ w : K, (w = 0 ∨ (m : ℤ) ≤ valL F K w) →
      normLM F hM1_K (1 + w) - 1 = 0 ∨
        (m : ℤ) ≤ valL F M_1 (normLM F hM1_K (1 + w) - 1))
    (hSuperStab_KM1 : ∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : K, (w = 0 ∨ ((t + 1 + (p F) * (u - t) : ℕ) : ℤ) ≤ valL F K w) →
        normLM F hM1_K (1 + w) - 1 = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_1 (normLM F hM1_K (1 + w) - 1))
    (hSuper_KM1 : ∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : K, (w = 0 ∨ ((t + (p F) * (u - t) : ℕ) : ℤ) ≤ valL F K w) →
        (traceLM F hM1_K w = 0 ∨ (u : ℤ) ≤ valL F M_1 (traceLM F hM1_K w)) ∧
        (normLM F hM1_K (1 + w) - (1 + traceLM F hM1_K w) = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_1 (normLM F hM1_K (1 + w) - (1 + traceLM F hM1_K w))))
    (hValNorm_M1MC : ∀ w : M_1, valL F M_C (normLM F hMC_M1 w) = valL F M_1 w)
    (hSub_M1MC : ∀ (v : ℕ), 1 ≤ v → v < t → ∀ w : M_1, (w = 0 ∨ (v : ℤ) ≤ valL F M_1 w) →
      normLM F hMC_M1 (1 + w) - (1 + normLM F hMC_M1 w) = 0 ∨
        (v + 1 : ℤ) ≤ valL F M_C (normLM F hMC_M1 (1 + w) - (1 + normLM F hMC_M1 w)))
    (hStab_M1MC : ∀ (m : ℕ), 1 ≤ m → m ≤ t + 1 → ∀ w : M_1, (w = 0 ∨ (m : ℤ) ≤ valL F M_1 w) →
      normLM F hMC_M1 (1 + w) - 1 = 0 ∨
        (m : ℤ) ≤ valL F M_C (normLM F hMC_M1 (1 + w) - 1))
    (hSuperStab_M1MC : ∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : M_1, (w = 0 ∨ ((t + 1 + ((p F) ^ r) * (u - t) : ℕ) : ℤ) ≤ valL F M_1 w) →
        normLM F hMC_M1 (1 + w) - 1 = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_C (normLM F hMC_M1 (1 + w) - 1))
    (hSuper_M1MC : ∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : M_1, (w = 0 ∨ ((t + ((p F) ^ r) * (u - t) : ℕ) : ℤ) ≤ valL F M_1 w) →
        (traceLM F hMC_M1 w = 0 ∨ (u : ℤ) ≤ valL F M_C (traceLM F hMC_M1 w)) ∧
        (normLM F hMC_M1 (1 + w) - (1 + traceLM F hMC_M1 w) = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_C (normLM F hMC_M1 (1 + w) - (1 + traceLM F hMC_M1 w)))) :
    let q := (p F) ^ (r + 1)
    (∀ (v : ℕ), 1 ≤ v → v < t → ∀ w : K, (w = 0 ∨ (v : ℤ) ≤ valL F K w) →
      normLM F hM_CK (1 + w) - (1 + normLM F hM_CK w) = 0 ∨
        (v + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - (1 + normLM F hM_CK w))) ∧
    (∀ (m : ℕ), 1 ≤ m → m ≤ t + 1 → ∀ w : K, (w = 0 ∨ (m : ℤ) ≤ valL F K w) →
      normLM F hM_CK (1 + w) - 1 = 0 ∨
        (m : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - 1)) ∧
    (∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : K, (w = 0 ∨ ((t + 1 + q * (u - t) : ℕ) : ℤ) ≤ valL F K w) →
        normLM F hM_CK (1 + w) - 1 = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - 1)) ∧
    (∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : K, (w = 0 ∨ ((t + q * (u - t) : ℕ) : ℤ) ≤ valL F K w) →
        (traceLM F hM_CK w = 0 ∨ (u : ℤ) ≤ valL F M_C (traceLM F hM_CK w)) ∧
        (normLM F hM_CK (1 + w) - (1 + traceLM F hM_CK w) = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - (1 + traceLM F hM_CK w)))) :=
by
  intro q
  have hvalL_props_gen : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L],
      valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0) := by
    intro L _
    have halg_gen : ∀ (F₀ : Type u) [Field F₀]
        (L₀ : IntermediateField F₀ (AlgebraicClosure F₀)) [FiniteDimensional F₀ L₀] (z : L₀),
        minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z ∧
        ∃ m : ℕ,
          Algebra.norm F₀ z = ((-1) ^ (minpoly F₀ z).natDegree * (minpoly F₀ z).coeff 0) ^ m ∧
          Module.finrank F₀ L₀ = (minpoly F₀ z).natDegree * m := by
      intro F₀ _ L₀ _ z
      have hmin_coe : minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z :=
        minpoly.algHom_eq L₀.val L₀.val.injective z
      have hz : IsIntegral F₀ z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F₀ z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F₀ pb.gen = minpoly F₀ z := by
        have hval : (IntermediateField.adjoin F₀ {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F₀ {z}).val
          (IntermediateField.adjoin F₀ {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F₀ z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F₀ z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    have halg := halg_gen F L
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F L (-1) = 0 := by
      have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : L) * (-1 : L) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : L) = (-1 : L) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := fun h0 => hφπ_ne (by simp [h0])
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hmem_deg : Module.finrank F L ∈ S := ⟨hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem ⟨Module.finrank F L, hmem_deg⟩
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q_x : ℤ := valL F L x
        set rem : ℤ := relVal F L x % f
        have hediv : f * q_x + rem = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ rem := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : rem < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : rem = 0 := by
          by_contra hr_ne
          have hr_pos' : 0 < rem := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q_x) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = rem := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q_x), hrel_ϖL]
            linarith
          let k_r : ℕ := rem.toNat
          have hk_eq : (k_r : ℤ) = rem := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k_r := by omega
          have hk_lt : k_r < resDeg F L := by omega
          have hk_mem : k_r ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k_r := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F L 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval1 : valL F L 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg1 : valL F L (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
      intro x
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L) := by
      intro u
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_add : ∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : L,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : L, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F L z ≤ valL F L w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F L) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun _ => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfL_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : L) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          exact le_trans (hx.resolve_left hx_ne) hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          exact le_trans (hy.resolve_left hy_ne) hval_y
    have hgen_val0 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1)) → valL F L (u : L) = 0 := by
      intro a ha u hu
      rcases hu with hu1 | hua
      · rw [hu1, hval1]
      · have h_ge0 : (0 : ℤ) ≤ valL F L (u : L) := by
          have hadd := hval_add 0 ((u : L) - 1) 1 (Or.inr (by omega)) (Or.inr (by rw [hval1]))
          have heq : ((u : L) - 1) + 1 = (u : L) := sub_add_cancel (u : L) 1
          rw [heq] at hadd
          exact hadd.resolve_left (Units.ne_zero u)
        have h_le0 : valL F L (u : L) ≤ 0 := by
          by_contra hlt
          have hge1 : (1 : ℤ) ≤ valL F L (-(u : L)) := by
            rw [hval_neg]
            omega
          have hadd := hval_add 1 ((u : L) - 1) (-(u : L)) (Or.inr (by omega)) (Or.inr hge1)
          have heq : ((u : L) - 1) + (-(u : L)) = -1 := by ring
          rw [heq, hval_neg1] at hadd
          have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
          have h10 : (1 : ℤ) ≤ 0 := hadd.resolve_left hne
          omega
        omega
    have hunit0 : ∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0 := by
      let H₀ : Subgroup Lˣ := {
        carrier := {u : Lˣ | valL F L (u : L) = 0}
        one_mem' := by
          change valL F L ((1 : Lˣ) : L) = 0
          rw [Units.val_one, hval1]
        mul_mem' := by
          intro u v hu hv
          change valL F L ((u * v : Lˣ) : L) = 0
          rw [Units.val_mul, hval_mul _ _ (Units.ne_zero u) (Units.ne_zero v), hu, hv, add_zero]
        inv_mem' := by
          intro u hu
          change valL F L ((u⁻¹ : Lˣ) : L) = 0
          rw [hval_inv u, hu, neg_zero]
      }
      have hcl_le : unitGroup F L 0 ≤ H₀ := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [H₀] using hu
      have hle_cl : H₀ ≤ unitGroup F L 0 := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [H₀] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_ge1 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1)) := by
      intro a ha
      have ha0 : a ≠ 0 := by omega
      let Ha : Subgroup Lˣ := {
        carrier := {u : Lˣ | (u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1)}
        one_mem' := Or.inl Units.val_one
        mul_mem' := by
          intro u v hu hv
          change ((u * v : Lˣ) : L) = 1 ∨ (a : ℤ) ≤ valL F L (((u * v : Lˣ) : L) - 1)
          have hu0 : valL F L (u : L) = 0 := hgen_val0 a ha u hu
          have hterm1 : (u : L) * ((v : L) - 1) = 0 ∨
              (a : ℤ) ≤ valL F L ((u : L) * ((v : L) - 1)) := by
            by_cases hsub : (v : L) - 1 = 0
            · left; rw [hsub, mul_zero]
            · right
              have hv1 : (v : L) ≠ 1 := sub_ne_zero.mp hsub
              have hva : (a : ℤ) ≤ valL F L ((v : L) - 1) := hv.resolve_left hv1
              rw [hval_mul (u : L) ((v : L) - 1) (Units.ne_zero u) hsub, hu0, zero_add]
              exact hva
          have hterm2 : (u : L) - 1 = 0 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1) := by
            rcases hu with hu1 | hua
            · exact Or.inl (sub_eq_zero.mpr hu1)
            · exact Or.inr hua
          have hadd := hval_add (a : ℤ) ((u : L) * ((v : L) - 1)) ((u : L) - 1) hterm1 hterm2
          have hsplit : (u : L) * ((v : L) - 1) + ((u : L) - 1) = ((u * v : Lˣ) : L) - 1 := by
            rw [Units.val_mul]
            ring
          rw [hsplit] at hadd
          rcases hadd with h0 | hle
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hle
        inv_mem' := by
          intro u hu
          change ((u⁻¹ : Lˣ) : L) = 1 ∨ (a : ℤ) ≤ valL F L (((u⁻¹ : Lˣ) : L) - 1)
          have hu0 : valL F L (u : L) = 0 := hgen_val0 a ha u hu
          have hu_inv0 : valL F L ((u⁻¹ : Lˣ) : L) = 0 := by
            rw [hval_inv u, hu0, neg_zero]
          have hinv_split : (((u⁻¹ : Lˣ) : L) - 1) = - (((u⁻¹ : Lˣ) : L) * ((u : L) - 1)) := by
            have hmul : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := Units.inv_mul u
            linear_combination hmul
          by_cases hsub : (u : L) - 1 = 0
          · left
            apply sub_eq_zero.mp
            rw [hinv_split, hsub, mul_zero, neg_zero]
          · right
            have hu1 : (u : L) ≠ 1 := sub_ne_zero.mp hsub
            have hua : (a : ℤ) ≤ valL F L ((u : L) - 1) := hu.resolve_left hu1
            rw [hinv_split, hval_neg,
              hval_mul ((u⁻¹ : Lˣ) : L) ((u : L) - 1) (Units.ne_zero u⁻¹) hsub,
              hu_inv0, zero_add]
            exact hua
      }
      have hcl_le : unitGroup F L a ≤ Ha := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [Ha, ha0] using hu
      have hle_cl : Ha ≤ unitGroup F L a := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [Ha, ha0] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_val0 : ∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0 := by
      intro a u hu
      by_cases ha : a = 0
      · rw [ha] at hu
        exact (hunit0 u).mp hu
      · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
        exact hgen_val0 a ha1 u ((hunit_ge1 a ha1 u).mp hu)
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv,
      hval_add, hunit0, hunit_ge1, hunit_val0⟩

  rcases hvalL_props_gen M_C with ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC,
    hval_inv_MC, hval_add_MC, hunit0_MC, hunit_ge1_MC, hunit_val0_MC⟩
  rcases hvalL_props_gen M_1 with ⟨hval0_M1, hval1_M1, hval_neg1_M1, hval_neg_M1, hval_mul_M1,
    hval_inv_M1, hval_add_M1, hunit0_M1, hunit_ge1_M1, hunit_val0_M1⟩

  let P_MC : ℤ → M_C → Prop := fun m z => z = 0 ∨ m ≤ valL F M_C z
  let P_M1 : ℤ → M_1 → Prop := fun m w => w = 0 ∨ m ≤ valL F M_1 w
  let P_K : ℤ → K → Prop := fun m w => w = 0 ∨ m ≤ valL F K w

  have hPMC_add : ∀ (m : ℤ) {z₁ z₂ : M_C}, P_MC m z₁ → P_MC m z₂ → P_MC m (z₁ + z₂) :=
    fun m {z₁ z₂} h1 h2 => hval_add_MC m z₁ z₂ h1 h2
  have hPMC_mul : ∀ {m₁ m₂ : ℤ} {z₁ z₂ : M_C},
      P_MC m₁ z₁ → P_MC m₂ z₂ → P_MC (m₁ + m₂) (z₁ * z₂) := by
    intro m₁ m₂ z₁ z₂ h1 h2
    by_cases hz₁ : z₁ = 0
    · exact Or.inl (by rw [hz₁, zero_mul])
    · by_cases hz₂ : z₂ = 0
      · exact Or.inl (by rw [hz₂, mul_zero])
      · right
        rw [hval_mul_MC z₁ z₂ hz₁ hz₂]
        have h1' := h1.resolve_left hz₁
        have h2' := h2.resolve_left hz₂
        omega
  have hPMC_0mul : ∀ (m : ℤ) {z₁ z₂ : M_C}, P_MC 0 z₁ → P_MC m z₂ → P_MC m (z₁ * z₂) := by
    intro m z₁ z₂ h1 h2
    have h := hPMC_mul h1 h2
    rwa [zero_add] at h

  have hPM1_mul : ∀ {m₁ m₂ : ℤ} {w₁ w₂ : M_1},
      P_M1 m₁ w₁ → P_M1 m₂ w₂ → P_M1 (m₁ + m₂) (w₁ * w₂) := by
    intro m₁ m₂ w₁ w₂ h1 h2
    by_cases hw₁ : w₁ = 0
    · exact Or.inl (by rw [hw₁, zero_mul])
    · by_cases hw₂ : w₂ = 0
      · exact Or.inl (by rw [hw₂, mul_zero])
      · right
        rw [hval_mul_M1 w₁ w₂ hw₁ hw₂]
        have h1' := h1.resolve_left hw₁
        have h2' := h2.resolve_left hw₂
        omega
  have hPM1_0mul : ∀ (m : ℤ) {w₁ w₂ : M_1}, P_M1 0 w₁ → P_M1 m w₂ → P_M1 m (w₁ * w₂) := by
    intro m w₁ w₂ h1 h2
    have h := hPM1_mul h1 h2
    rwa [zero_add] at h
  have hPM1_le : ∀ {m₁ m₂ : ℤ} {w : M_1}, m₁ ≤ m₂ → P_M1 m₂ w → P_M1 m₁ w := by
    intro m₁ m₂ w hle hw
    rcases hw with rfl | hw
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hw)
  have h1_add_ne_zero_M1 : ∀ {w : M_1}, P_M1 1 w → 1 + w ≠ 0 := by
    intro w hw h0
    have hw_eq : w = -1 := by linear_combination h0
    have hw_ne : w ≠ 0 := by
      rw [hw_eq]
      exact neg_ne_zero.mpr one_ne_zero
    have hw_val : 1 ≤ valL F M_1 w := hw.resolve_left hw_ne
    rw [hw_eq, hval_neg1_M1] at hw_val
    omega

  have hnorm_zero_KM1 : normLM F hM1_K 0 = 0 := by
    have hmul : normLM F hM1_K 0 * (ϖ_M1 : M_1) = normLM F hM1_K 0 := by
      have h1 : (normLM F hM1_K (ϖ_K : K) : M_1) = (ϖ_M1 : M_1) :=
        congr_arg Units.val hϖ_norm1
      calc normLM F hM1_K 0 * (ϖ_M1 : M_1)
        _ = normLM F hM1_K 0 * normLM F hM1_K (ϖ_K : K) := by rw [← h1]
        _ = normLM F hM1_K (0 * (ϖ_K : K)) := (map_mul (normLM F hM1_K) 0 (ϖ_K : K)).symm
        _ = normLM F hM1_K 0 := by rw [zero_mul]
    have hsub : normLM F hM1_K 0 * ((ϖ_M1 : M_1) - 1) = 0 := by
      linear_combination hmul
    rcases mul_eq_zero.mp hsub with h0 | hϖ1
    · exact h0
    · exfalso
      have h_eq1 : (ϖ_M1 : M_1) = 1 := sub_eq_zero.mp hϖ1
      have h_val : valL F M_1 (ϖ_M1 : M_1) = 0 := by rw [h_eq1, hval1_M1]
      omega
  have hnorm_val_ge_KM1 : ∀ (k : ℤ) {w : K}, P_K k w → P_M1 k (normLM F hM1_K w) := by
    intro k w hw
    rcases hw with rfl | hw
    · exact Or.inl hnorm_zero_KM1
    · exact Or.inr (by rw [hValNorm_KM1 w]; exact hw)
  have hnorm_zero_M1MC : normLM F hMC_M1 0 = 0 := by
    have hmul : normLM F hMC_M1 0 * (ϖ_MC : M_C) = normLM F hMC_M1 0 := by
      have h1 : (normLM F hMC_M1 (ϖ_M1 : M_1) : M_C) = (ϖ_MC : M_C) :=
        congr_arg Units.val hϖ_norm2
      calc normLM F hMC_M1 0 * (ϖ_MC : M_C)
        _ = normLM F hMC_M1 0 * normLM F hMC_M1 (ϖ_M1 : M_1) := by rw [← h1]
        _ = normLM F hMC_M1 (0 * (ϖ_M1 : M_1)) := (map_mul (normLM F hMC_M1) 0 (ϖ_M1 : M_1)).symm
        _ = normLM F hMC_M1 0 := by rw [zero_mul]
    have hsub : normLM F hMC_M1 0 * ((ϖ_MC : M_C) - 1) = 0 := by
      linear_combination hmul
    rcases mul_eq_zero.mp hsub with h0 | hϖ1
    · exact h0
    · exfalso
      have h_eq1 : (ϖ_MC : M_C) = 1 := sub_eq_zero.mp hϖ1
      have h_val : valL F M_C (ϖ_MC : M_C) = 0 := by rw [h_eq1, hval1_MC]
      omega
  have hnorm_val_ge_M1MC : ∀ (k : ℤ) {w : M_1}, P_M1 k w → P_MC k (normLM F hMC_M1 w) := by
    intro k w hw
    rcases hw with rfl | hw
    · exact Or.inl hnorm_zero_M1MC
    · exact Or.inr (by rw [hValNorm_M1MC w]; exact hw)

  have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
      [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
      (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      [FiniteDimensional K₀ M₀] (z : E₀),
      @Algebra.trace L₀ E₀ _ _ algLE z =
        @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
    intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
    by_cases hFin : FiniteDimensional M₀ E₀
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
      simp [htr1, htr2]
  have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (h : A ≤ B) (y : B),
      @Algebra.trace A B _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
    intro A B h y
    letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm
  have htrace_trans : ∀ w : K,
      traceLM F hM_CK w = traceLM F hMC_M1 (traceLM F hM1_K w) := by
    intro w
    rw [← htrace_eq_inclusion hM_CK w,
        ← htrace_eq_inclusion hM1_K w,
        ← htrace_eq_inclusion hMC_M1]
    exact htrace_trans_aux F M_C M_1 K
      (IntermediateField.inclusion hMC_M1).toAlgebra
      (IntermediateField.inclusion hM1_K).toAlgebra
      (IntermediateField.inclusion hM_CK).toAlgebra
      (fun _ => rfl) (fun _ => rfl) w

  have hnorm_trans_aux : ∀ (L₀ M₀ E₀ : Type u) [Field L₀] [Field M₀] [Field E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      (z : E₀),
      @Algebra.norm L₀ E₀ _ _ algLE z =
        @Algebra.norm L₀ M₀ _ _ algLM (@Algebra.norm M₀ E₀ _ _ algME z) := by
    intro L₀ M₀ E₀ _ _ _ algLM algME algLE h2 z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    exact (Algebra.norm_norm (R := L₀) (S := M₀) (A := E₀) (a := z)).symm
  have hnorm_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (h : A ≤ B) (y : B),
      @Algebra.norm A B _ _ (IntermediateField.inclusion h).toAlgebra y = normLM F h y := by
    intro A B h y
    letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.norm_eq_of_algEquiv e y).symm
  have hnorm_trans : ∀ w : K,
      normLM F hM_CK w = normLM F hMC_M1 (normLM F hM1_K w) := by
    intro w
    rw [← hnorm_eq_inclusion hM_CK w,
        ← hnorm_eq_inclusion hM1_K w,
        ← hnorm_eq_inclusion hMC_M1]
    exact hnorm_trans_aux M_C M_1 K
      (IntermediateField.inclusion hMC_M1).toAlgebra
      (IntermediateField.inclusion hM1_K).toAlgebra
      (IntermediateField.inclusion hM_CK).toAlgebra
      (fun _ => rfl) w

  have hMulRem : ∀ (w₁ e₁ : M_1) (γ : M_C) (k m : ℤ),
      P_M1 1 w₁ →
      P_M1 k e₁ →
      P_MC m (normLM F hMC_M1 (1 + w₁) - γ) →
      (∀ r₁ : M_1, P_M1 k r₁ → P_MC m (normLM F hMC_M1 (1 + r₁) - 1)) →
      P_MC m (normLM F hMC_M1 (1 + w₁ + e₁) - γ) := by
    intro w₁ e₁ γ k m hw1_1 he1 hα_γ hStab_step
    have h1w1_ne : 1 + w₁ ≠ 0 := h1_add_ne_zero_M1 hw1_1
    let u_w1 : M_1ˣ := Units.mk0 (1 + w₁) h1w1_ne
    have hu_w1_mem1 : u_w1 ∈ unitGroup F M_1 1 := by
      rw [hunit_ge1_M1 1 le_rfl u_w1]
      have h_sub : (u_w1 : M_1) - 1 = w₁ := by change (1 + w₁) - 1 = w₁; ring
      rw [h_sub]
      rcases hw1_1 with h0 | hle
      · exact Or.inl (by change 1 + w₁ = 1; rw [h0, add_zero])
      · exact Or.inr hle
    have hu_w1_val0 : valL F M_1 (u_w1 : M_1) = 0 := hunit_val0_M1 1 u_w1 hu_w1_mem1
    have hu_w1_inv_val0 : valL F M_1 ((u_w1⁻¹ : M_1ˣ) : M_1) = 0 := by
      rw [hval_inv_M1 u_w1, hu_w1_val0, neg_zero]
    have hu_w1_inv_int : P_M1 0 ((u_w1⁻¹ : M_1ˣ) : M_1) := Or.inr (by rw [hu_w1_inv_val0])
    let r₁ : M_1 := ((u_w1⁻¹ : M_1ˣ) : M_1) * e₁
    have hr₁ : P_M1 k r₁ := hPM1_0mul k hu_w1_inv_int he1
    have hβ_1 : P_MC m (normLM F hMC_M1 (1 + r₁) - 1) := hStab_step r₁ hr₁
    have h1w1_int : P_M1 0 (1 + w₁) := Or.inr (by rw [← hu_w1_val0]; rfl)
    have hα_int : P_MC 0 (normLM F hMC_M1 (1 + w₁)) := hnorm_val_ge_M1MC 0 h1w1_int
    have h_fac : 1 + w₁ + e₁ = (1 + w₁) * (1 + r₁) := by
      have hmul : (1 + w₁) * ((u_w1⁻¹ : M_1ˣ) : M_1) = 1 := Units.mul_inv u_w1
      dsimp [r₁]
      linear_combination -e₁ * hmul
    have h_norm_fac : normLM F hMC_M1 (1 + w₁ + e₁) =
        normLM F hMC_M1 (1 + w₁) * normLM F hMC_M1 (1 + r₁) := by
      rw [h_fac, map_mul]
    have h_id : normLM F hMC_M1 (1 + w₁ + e₁) - γ =
        normLM F hMC_M1 (1 + w₁) * (normLM F hMC_M1 (1 + r₁) - 1) +
        (normLM F hMC_M1 (1 + w₁) - γ) := by
      rw [h_norm_fac]
      ring
    rw [h_id]
    exact hPMC_add m (hPMC_0mul m hα_int hβ_1) hα_γ

  let q₁ : ℕ := (p F) ^ r
  have hq1_pos : 1 ≤ q₁ := Nat.one_le_pow r (p F) hp_prime.pos
  have hq_split : q = q₁ * (p F) := pow_succ (p F) r

  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro v hv_ge1 hv_lt w hw
    let w₁ : M_1 := normLM F hM1_K w
    let e₁ : M_1 := normLM F hM1_K (1 + w) - (1 + w₁)
    have hw₁ : P_M1 (v : ℤ) w₁ := hnorm_val_ge_KM1 (v : ℤ) hw
    have hw1_1 : P_M1 1 w₁ := hPM1_le (by omega) hw₁
    have he₁ : P_M1 (v + 1 : ℤ) e₁ := hSub_KM1 v hv_ge1 hv_lt w hw
    have hα_γ : P_MC (v + 1 : ℤ) (normLM F hMC_M1 (1 + w₁) - (1 + normLM F hM_CK w)) := by
      rw [hnorm_trans w]
      exact hSub_M1MC v hv_ge1 hv_lt w₁ hw₁
    have hStab_step : ∀ r₁ : M_1, P_M1 (v + 1 : ℤ) r₁ →
        P_MC (v + 1 : ℤ) (normLM F hMC_M1 (1 + r₁) - 1) := by
      intro r₁ hr₁
      have hr₁' : r₁ = 0 ∨ ((v + 1 : ℕ) : ℤ) ≤ valL F M_1 r₁ := by
        simpa [Nat.cast_add, Nat.cast_one] using hr₁
      have h := hStab_M1MC (v + 1) (by omega) (by omega) r₁ hr₁'
      simpa [Nat.cast_add, Nat.cast_one] using h
    have h_sum : 1 + w₁ + e₁ = normLM F hM1_K (1 + w) := by
      dsimp [e₁]; ring
    rw [hnorm_trans (1 + w), ← h_sum]
    exact hMulRem w₁ e₁ (1 + normLM F hM_CK w) (v + 1 : ℤ) (v + 1 : ℤ)
      hw1_1 he₁ hα_γ hStab_step
  · 
    intro m hm_ge1 hm_le w hw
    let w' : M_1 := normLM F hM1_K (1 + w) - 1
    have hw' : P_M1 (m : ℤ) w' := hStab_KM1 m hm_ge1 hm_le w hw
    have h_sum : 1 + w' = normLM F hM1_K (1 + w) := by
      dsimp [w']; ring
    rw [hnorm_trans (1 + w), ← h_sum]
    exact hStab_M1MC m hm_ge1 hm_le w' hw'
  · 
    intro u hu_ge w hw
    let u₁ : ℕ := t + q₁ * (u - t)
    have hut_pos : 1 ≤ u - t := by omega
    have hq1_ut_pos : 1 ≤ q₁ * (u - t) := Nat.mul_le_mul hq1_pos hut_pos
    have hu1_ge : t + 1 ≤ u₁ := by omega
    have hu1_sub : u₁ - t = q₁ * (u - t) := Nat.add_sub_cancel_left t (q₁ * (u - t))
    have h_idx1 : t + 1 + (p F) * (u₁ - t) = t + 1 + q * (u - t) := by
      rw [hu1_sub, hq_split]
      ring
    have h_idx2 : ((t + 1 + q₁ * (u - t) : ℕ) : ℤ) = (u₁ + 1 : ℤ) := by
      dsimp [u₁]
      push_cast
      ring
    let w' : M_1 := normLM F hM1_K (1 + w) - 1
    have hw'_u1 : P_M1 (u₁ + 1 : ℤ) w' :=
      hSuperStab_KM1 u₁ hu1_ge w (by rwa [h_idx1])
    have hw'_q1 : P_M1 ((t + 1 + q₁ * (u - t) : ℕ) : ℤ) w' := by
      rwa [h_idx2]
    have h_sum : 1 + w' = normLM F hM1_K (1 + w) := by
      dsimp [w']; ring
    rw [hnorm_trans (1 + w), ← h_sum]
    exact hSuperStab_M1MC u hu_ge w' hw'_q1
  · 
    intro u hu_ge w hw
    let u₁ : ℕ := t + q₁ * (u - t)
    have hut_pos : 1 ≤ u - t := by omega
    have hq1_ut_pos : 1 ≤ q₁ * (u - t) := Nat.mul_le_mul hq1_pos hut_pos
    have hu1_ge : t + 1 ≤ u₁ := by omega
    have hu1_sub : u₁ - t = q₁ * (u - t) := Nat.add_sub_cancel_left t (q₁ * (u - t))
    have h_idx1 : t + (p F) * (u₁ - t) = t + q * (u - t) := by
      rw [hu1_sub, hq_split]
      ring
    have h_idx3 : ((t + 1 + q₁ * (u - t) : ℕ) : ℤ) = (u₁ + 1 : ℤ) := by
      dsimp [u₁]
      push_cast
      ring
    obtain ⟨htr_KM1, hrem_KM1⟩ := hSuper_KM1 u₁ hu1_ge w (by rwa [h_idx1])
    let w₁ : M_1 := traceLM F hM1_K w
    let e₁ : M_1 := normLM F hM1_K (1 + w) - (1 + w₁)
    have hw₁_q1 : P_M1 ((t + q₁ * (u - t) : ℕ) : ℤ) w₁ := htr_KM1
    have hw1_1 : P_M1 1 w₁ := hPM1_le (by omega) htr_KM1
    have he₁_q1 : P_M1 ((t + 1 + q₁ * (u - t) : ℕ) : ℤ) e₁ := by
      rwa [h_idx3]
    obtain ⟨htr_M1MC, hrem_M1MC⟩ := hSuper_M1MC u hu_ge w₁ hw₁_q1
    refine ⟨?_, ?_⟩
    · rw [htrace_trans w]
      exact htr_M1MC
    · have hα_γ : P_MC (u + 1 : ℤ) (normLM F hMC_M1 (1 + w₁) - (1 + traceLM F hM_CK w)) := by
        rw [htrace_trans w]
        exact hrem_M1MC
      have h_sum : 1 + w₁ + e₁ = normLM F hM1_K (1 + w) := by
        dsimp [e₁]; ring
      rw [hnorm_trans (1 + w), ← h_sum]
      exact hMulRem w₁ e₁ (1 + traceLM F hM_CK w)
        ((t + 1 + q₁ * (u - t) : ℕ) : ℤ) (u + 1 : ℤ)
        hw1_1 he₁_q1 hα_γ (hSuperStab_M1MC u hu_ge)

theorem ld_ch14_diamond_pullback_norm_expansions_on_E (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (hDiamondTrNorm : ∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y))
    (t k a : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k) (ha_ge2 : 2 ≤ a)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_E : Eˣ) (ϖ_L : Lˣ)
    (hϖ_normK : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_normE : Units.map (normLM F hLE) ϖ_E = ϖ_L)
    (hϖ_valK : valL F K (ϖ_K : K) = 1)
    (hϖ_valMC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_valE : valL F E (ϖ_E : E) = 1)
    (hϖ_valL : valL F L (ϖ_L : L) = 1)
    (hp_prime : Nat.Prime (p F))
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp) (a_coeff : Fin r_exp → M_C)
    (hq_pow : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (ha_int : ∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j))
    (hP_def : ∀ z : M_C,
      P_poly z =
        z ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
          ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ))))
    (hP_norm : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
        (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) = 0 ∨
        (t + 1 : ℤ) ≤ valL F M_C
          (normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
            (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C))))
    (hSub_KMC : ∀ (v : ℕ), 1 ≤ v → v < t → ∀ w : K, (w = 0 ∨ (v : ℤ) ≤ valL F K w) →
      normLM F hM_CK (1 + w) - (1 + normLM F hM_CK w) = 0 ∨
        (v + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - (1 + normLM F hM_CK w)))
    (hStab_KMC : ∀ (m : ℕ), 1 ≤ m → m ≤ t + 1 → ∀ w : K, (w = 0 ∨ (m : ℤ) ≤ valL F K w) →
      normLM F hM_CK (1 + w) - 1 = 0 ∨
        (m : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - 1))
    (hSuper_KMC : ∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : K, (w = 0 ∨
        ((t + Module.finrank M_C (IntermediateField.extendScalars hM_CK) * (u - t) : ℕ) : ℤ) ≤
          valL F K w) →
        (traceLM F hM_CK w = 0 ∨ (u : ℤ) ≤ valL F M_C (traceLM F hM_CK w)) ∧
        (normLM F hM_CK (1 + w) - (1 + traceLM F hM_CK w) = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - (1 + traceLM F hM_CK w)))) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    (∀ y₀ : E, (y₀ = 0 ∨ 0 ≤ valL F E y₀) →
      ∀ x₀ : L, (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
        (y₀ - IntermediateField.inclusion hLE x₀ = 0 ∨
          1 ≤ valL F E (y₀ - IntermediateField.inclusion hLE x₀)) →
        normLM F hLE y₀ - x₀ ^ q = 0 ∨ 1 ≤ valL F L (normLM F hLE y₀ - x₀ ^ q)) ∧
    (k * (a - 1) < t →
      ∀ y : E, (y = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F E y) →
        normLM F hLE (1 + y) - (1 + normLM F hLE y) = 0 ∨
          (a : ℤ) ≤ valL F L (normLM F hLE (1 + y) - (1 + normLM F hLE y))) ∧
    (k * (a - 1) = t →
      ∃ (z_η : M_Cˣ),
        valL F M_C (z_η : M_C) = 0 ∧
        (z_η ^ q) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (a - 1)) *
            (ϖ_MC ^ t)⁻¹)⁻¹ ∈ unitGroup F M_C 1 ∧
        ∀ (y : E), (y = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F E y) →
          ∀ (x₀ : L), (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
            ((((ϖ_E ^ (a - 1))⁻¹ : Eˣ) : E) * y - IntermediateField.inclusion hLE x₀ = 0 ∨
              1 ≤ valL F E ((((ϖ_E ^ (a - 1))⁻¹ : Eˣ) : E) * y -
                IntermediateField.inclusion hLE x₀)) →
            ∃ (s₀ : L),
              (s₀ = 0 ∨ 0 ≤ valL F L s₀) ∧
              (normLM F hLE (1 + y) - (1 + ((ϖ_L ^ (a - 1) : Lˣ) : L) * s₀) = 0 ∨
                (a : ℤ) ≤ valL F L
                  (normLM F hLE (1 + y) - (1 + ((ϖ_L ^ (a - 1) : Lˣ) : L) * s₀))) ∧
              (IntermediateField.inclusion hLM_C s₀ *
                  (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (a - 1)) *
                    (ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) -
                P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)) = 0 ∨
                1 ≤ valL F M_C
                  (IntermediateField.inclusion hLM_C s₀ *
                      (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (a - 1)) *
                        (ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) -
                    P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C))))) ∧
    (t < k * (a - 1) →
      let a_E := q * a - ((q - 1) / k) * (t + k)
      a < a_E ∧
      ∀ y : E, (y = 0 ∨ ((a_E - 1 : ℕ) : ℤ) ≤ valL F E y) →
        (traceLM F hLE y = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F L (traceLM F hLE y)) ∧
        (normLM F hLE (1 + y) - (1 + traceLM F hLE y) = 0 ∨
          (a : ℤ) ≤ valL F L (normLM F hLE (1 + y) - (1 + traceLM F hLE y)))) :=
by
  intro q
  
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    _, hval_add_L, hunit0_L, hunit_ge1_L, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC,
    _, hval_add_MC, hunit0_MC, hunit_ge1_MC, _⟩ := ld_valL_and_unitGroup_props F M_C
  obtain ⟨hval0_E, hval1_E, hval_neg1_E, hval_neg_E, hval_mul_E, hval_inv_E,
    _, hval_add_E, hunit0_E, hunit_ge1_E, _⟩ := ld_valL_and_unitGroup_props F E
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K,
    _, hval_add_K, hunit0_K, hunit_ge1_K, _⟩ := ld_valL_and_unitGroup_props F K

  have hval_unit_mul : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u v : Mˣ), valL F M ((u * v : Mˣ) : M) = valL F M (u : M) + valL F M (v : M) := by
    intro M _ u v
    have hM := ld_valL_and_unitGroup_props F M
    rw [Units.val_mul]
    exact hM.2.2.2.2.1 (u : M) (v : M) (Units.ne_zero u) (Units.ne_zero v)
  have hval_unit_inv : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ), valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
    intro M _ u
    exact (ld_valL_and_unitGroup_props F M).2.2.2.2.2.1 u
  have hval_unit_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ), valL F M ((u ^ n : Mˣ) : M) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero =>
      simp [hM.2.1]
    | succ n ih =>
      rw [pow_succ, hval_unit_mul M (u ^ n) u, ih]
      push_cast
      ring
  have hval_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (x : M) (n : ℕ), x ≠ 0 → valL F M (x ^ n) = (n : ℤ) * valL F M x := by
    intro M _ x n hx
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero =>
      simp [hM.2.1]
    | succ n ih =>
      rw [pow_succ, hM.2.2.2.2.1 (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hval_sub_ge : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (m : ℤ) (x y : M),
      (x = 0 ∨ m ≤ valL F M x) → (y = 0 ∨ m ≤ valL F M y) →
        (x - y = 0 ∨ m ≤ valL F M (x - y)) := by
    intro M _ m x y hx hy
    have hM := ld_valL_and_unitGroup_props F M
    have hny : -y = 0 ∨ m ≤ valL F M (-y) := by
      rcases hy with rfl | hy
      · left; rw [neg_zero]
      · right; rw [hM.2.2.2.1]; exact hy
    have h := hM.2.2.2.2.2.2.2.1 m x (-y) hx hny
    rwa [← sub_eq_add_neg] at h
  have hval_mul_ge : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (m₁ m₂ : ℤ) (x y : M),
      (x = 0 ∨ m₁ ≤ valL F M x) → (y = 0 ∨ m₂ ≤ valL F M y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F M (x * y)) := by
    intro M _ m₁ m₂ x y hx hy
    have hM := ld_valL_and_unitGroup_props F M
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        rw [hM.2.2.2.2.1 x y hx0 hy0]
        omega

  have hcoe_inc_unit : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      (h : M₁ ≤ M₂) (u : M₁ˣ),
      ((Units.map (IntermediateField.inclusion h).toMonoidHom u : M₂ˣ) : M₂) =
        IntermediateField.inclusion h (u : M₁) := fun _ _ _ _ => rfl
  have hnorm_inc : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₁] [FiniteDimensional F M₂] (h : M₁ ≤ M₂) (x : M₁),
      normLM F h (IntermediateField.inclusion h x) =
        x ^ (Module.finrank M₁ (IntermediateField.extendScalars h)) := by
    intro M₁ M₂ _ _ h x
    haveI : FiniteDimensional F (IntermediateField.extendScalars h) := ‹FiniteDimensional F M₂›
    haveI : IsScalarTower F M₁ (IntermediateField.extendScalars h) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional M₁ (IntermediateField.extendScalars h) :=
      Module.Finite.of_restrictScalars_finite F M₁ (IntermediateField.extendScalars h)
    haveI : Module.Free M₁ (IntermediateField.extendScalars h) :=
      Module.Free.of_divisionRing M₁ (IntermediateField.extendScalars h)
    change Algebra.norm M₁ (toExtendScalars F h (IntermediateField.inclusion h x)) =
      x ^ (Module.finrank M₁ (IntermediateField.extendScalars h))
    have hto : toExtendScalars F h (IntermediateField.inclusion h x) =
        algebraMap M₁ (IntermediateField.extendScalars h) x := rfl
    rw [hto, Algebra.norm_algebraMap]
  have hnorm_inc_unit : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₁] [FiniteDimensional F M₂] (h : M₁ ≤ M₂) (u : M₁ˣ),
      Units.map (normLM F h) (Units.map (IntermediateField.inclusion h).toMonoidHom u) =
        u ^ (Module.finrank M₁ (IntermediateField.extendScalars h)) := by
    intro M₁ M₂ _ _ h u
    apply Units.ext
    change normLM F h (IntermediateField.inclusion h (u : M₁)) =
      ((u ^ (Module.finrank M₁ (IntermediateField.extendScalars h)) : M₁ˣ) : M₁)
    rw [hnorm_inc M₁ M₂ h (u : M₁), Units.val_pow_eq_pow_val]

  
  have hPullL : ∀ (m : ℤ) (x : L),
      (IntermediateField.inclusion hLM_C x = 0 ∨
        (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C (IntermediateField.inclusion hLM_C x)) →
      (x = 0 ∨ m ≤ valL F L x) := by
    intro m x hx
    by_cases hx0 : x = 0
    · exact Or.inl hx0
    · right
      have hincl_ne : IntermediateField.inclusion hLM_C x ≠ 0 :=
        (map_ne_zero_iff (IntermediateField.inclusion hLM_C)
          (IntermediateField.inclusion hLM_C).injective).mpr hx0
      have hge : (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C (IntermediateField.inclusion hLM_C x) :=
        hx.resolve_left hincl_ne
      rw [hValAlgMCL x] at hge
      have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
      by_contra hlt
      have hle : valL F L x ≤ m - 1 := by omega
      have hmul : (k : ℤ) * valL F L x ≤ (k : ℤ) * (m - 1) :=
        mul_le_mul_of_nonneg_left hle (by omega)
      linarith
  have hPushEK : ∀ (m : ℤ) (y : E),
      (y = 0 ∨ m ≤ valL F E y) →
      (IntermediateField.inclusion hEK y = 0 ∨
        (k : ℤ) * m ≤ valL F K (IntermediateField.inclusion hEK y)) := by
    intro m y hy
    rcases hy with rfl | hy
    · left; rw [map_zero]
    · right
      rw [hValAlgKE y]
      have hk_nonneg : (0 : ℤ) ≤ (k : ℤ) := by omega
      exact mul_le_mul_of_nonneg_left hy hk_nonneg

  have hp_ge2 : 2 ≤ p F := hp_prime.two_le
  have hq_ge2 : 2 ≤ q := by
    change 2 ≤ Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    rw [hq_pow]
    calc 2 ≤ (p F) ^ 1 := by simp [hp_ge2]
      _ ≤ (p F) ^ r_exp := Nat.pow_le_pow_right hp_prime.pos hr_exp_pos
  have hq_ge1 : 1 ≤ q := by omega

  
  have hnormE_zero : normLM F hLE 0 = 0 := by
    have hϖ_normE_coe : normLM F hLE (ϖ_E : E) = (ϖ_L : L) :=
      congrArg (fun u : Lˣ => (u : L)) hϖ_normE
    have hmul : normLM F hLE 0 * (ϖ_L : L) = normLM F hLE 0 := by
      calc normLM F hLE 0 * (ϖ_L : L)
          = normLM F hLE 0 * normLM F hLE (ϖ_E : E) := by rw [hϖ_normE_coe]
        _ = normLM F hLE (0 * (ϖ_E : E)) := (map_mul (normLM F hLE) 0 (ϖ_E : E)).symm
        _ = normLM F hLE 0 := by rw [zero_mul]
    have hsub : normLM F hLE 0 * ((ϖ_L : L) - 1) = 0 := by linear_combination hmul
    have hne : (ϖ_L : L) - 1 ≠ 0 := by
      intro h0
      have heq : (ϖ_L : L) = 1 := sub_eq_zero.mp h0
      have h1 : valL F L (ϖ_L : L) = 0 := by rw [heq, hval1_L]
      omega
    exact (mul_eq_zero.mp hsub).resolve_right hne

  have hStab1_EL : ∀ δ_E : E, (δ_E = 0 ∨ 1 ≤ valL F E δ_E) →
      normLM F hLE (1 + δ_E) - 1 = 0 ∨ 1 ≤ valL F L (normLM F hLE (1 + δ_E) - 1) := by
    intro δ_E hδ_E
    let w₁ : K := IntermediateField.inclusion hEK δ_E
    have hw₁ : w₁ = 0 ∨ ((1 : ℕ) : ℤ) ≤ valL F K w₁ := by
      rcases hPushEK 1 δ_E hδ_E with h0 | hge
      · exact Or.inl h0
      · right
        have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
        dsimp only [w₁]
        push_cast
        linarith
    have hMC := hStab_KMC 1 le_rfl (by omega) w₁ hw₁
    have h1w₁ : 1 + w₁ = IntermediateField.inclusion hEK (1 + δ_E) := by
      dsimp only [w₁]
      rw [map_add, map_one]
