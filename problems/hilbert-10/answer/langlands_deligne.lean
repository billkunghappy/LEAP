    have hq1_mt_pos : 1 ≤ q₁ * (m - t) := Nat.mul_le_mul hq1_pos hmt_pos
    have hr1_ge : r₁ ≥ t + 1 := by omega
    have hr1_sub : r₁ - t = q₁ * (m - t) := Nat.add_sub_cancel_left t (q₁ * (m - t))
    have h_idx1 : t + 1 + (p F) * (r₁ - t) = t + 1 + q * (m - t) := by
