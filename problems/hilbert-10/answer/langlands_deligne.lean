        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul, mul_one,
          h_card_G_mul, hCard_C, Nat.cast_mul,
          inv_mul_cancel_left₀ (by exact_mod_cast (Nat.card_pos (α := H)).ne')]
      · rw [if_neg hc1]
        have h_term : ∀ x : G,
