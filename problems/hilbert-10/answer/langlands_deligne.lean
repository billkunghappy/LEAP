          _ = (uL ^ (ℓ : ℤ)) ^ (Nat.gcdA ℓ 4) * (uL ^ (4 : ℤ)) ^ (Nat.gcdB ℓ 4) := by
              rw [zpow_add, zpow_mul, zpow_mul]
