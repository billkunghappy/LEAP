        rw [h_eq]
      rw [← h_shift_mul, ← h_shift_mul, inv_mul_cancel, h_shift_one] at h1
      have h_mem : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ M_lam := by
        rw [hM_lam]
        intro c hc
        have h_sub : (⟨((cosetRep u₁)⁻¹ * cosetRep u₂)⁻¹ * c.1 * ((cosetRep u₁)⁻¹ * cosetRep u₂), hc⟩ : C) =
            ⟨((cosetRep u₁)⁻¹ * cosetRep u₂)⁻¹ * c.1 * ((cosetRep u₁)⁻¹ * cosetRep u₂),
              h_conj ((cosetRep u₁)⁻¹ * cosetRep u₂) c⟩ := rfl
        rw [h_sub]
        exact congr_fun h1.symm c
      have hq : (QuotientGroup.mk (cosetRep u₁) : G ⧸ M_lam) = QuotientGroup.mk (cosetRep u₂) :=
        QuotientGroup.eq.mpr h_mem
      have h_out₁ : (QuotientGroup.mk (cosetRep u₁) : G ⧸ M_lam) = u₁ := Quotient.out_eq u₁
      have h_out₂ : (QuotientGroup.mk (cosetRep u₂) : G ⧸ M_lam) = u₂ := Quotient.out_eq u₂
      rw [← h_out₁, ← h_out₂, hq]
    let Ψ : ((G ⧸ M_lam) → Ω F) →ₗ[Ω F] Q :=
      { toFun := fun α => ∑ u : G ⧸ M_lam, α u • σ (cosetRep u) w_bar
