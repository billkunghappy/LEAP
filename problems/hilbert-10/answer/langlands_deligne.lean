by
  classical
  intro θE' θM₁' ψE' ψM₁' cE' cM₁' H₁ H₂
  set r : ℕ := condExp F L νE' / 2
  set n_ψ : ℤ := condExpChar F L ψ
  have hr_ge1 : 1 ≤ r := by omega
  have hT₂_eq : condExp F L νE' = 2 * r := by omega
  have hT₁_eq : condExp F L νM₁' = 2 * r := by omega
  have hr_M₁'_eq : condExp F L νM₁' / 2 = r := by omega
  have hm₁_eq : condExp F M₁' θM₁' = 4 * r - 1 := by
    change condExp F M₁' (recChar F rec M₁' χM₁') = 4 * r - 1; omega
  have hm₂_eq : condExp F E' θE' = 4 * r - 1 := by
    change condExp F E' (recChar F rec E' χE') = 4 * r - 1; omega
  have hdegM₁'_2 : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
