      rw [hnorm_ϖ, hϖ_pow]
    rw [hval_norm, hval_incl, hϖ] at hval_eq
    omega
  have hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    hfinrank_two M₁' hLM₁' hval_normM₁' hval_LM₁'
  have hdegE' : Module.finrank L (IntermediateField.extendScalars hLE') = 2 :=
    hfinrank_two E' hLE' hval_normE' hval_LE'
  have hQuad_M₁' :
      (∀ (u v : L) (w : M₁'),
        traceLM F hLM₁' (IntermediateField.inclusion hLM₁' u + IntermediateField.inclusion hLM₁' v * w) =
          (2 : L) * u + v * traceLM F hLM₁' w ∧
        normLM F hLM₁' (IntermediateField.inclusion hLM₁' u + IntermediateField.inclusion hLM₁' v * w) =
          u ^ 2 + u * v * traceLM F hLM₁' w + v ^ 2 * normLM F hLM₁' w) ∧
      (∀ (u : L) (w : M₁'),
        normLM F hLM₁' (w - IntermediateField.inclusion hLM₁' u) =
          normLM F hLM₁' w - u * traceLM F hLM₁' w + u ^ 2) := by
    let M₁'' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM₁'
    haveI : FiniteDimensional F M₁'' := ‹FiniteDimensional F M₁'›
    haveI : IsScalarTower F L M₁'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L M₁'' := Module.Finite.of_restrictScalars_finite F L M₁''
    obtain ⟨h1, h2⟩ := hQuad_gen L M₁'' hdegM₁'
    exact ⟨fun u v w => h1 u v (toExtendScalars F hLM₁' w),
      fun u w => h2 u (toExtendScalars F hLM₁' w)⟩
  have hQuad_E' :
      (∀ (u v : L) (w : E'),
        traceLM F hLE' (IntermediateField.inclusion hLE' u + IntermediateField.inclusion hLE' v * w) =
          (2 : L) * u + v * traceLM F hLE' w ∧
        normLM F hLE' (IntermediateField.inclusion hLE' u + IntermediateField.inclusion hLE' v * w) =
          u ^ 2 + u * v * traceLM F hLE' w + v ^ 2 * normLM F hLE' w) ∧
      (∀ (u : L) (w : E'),
        normLM F hLE' (w - IntermediateField.inclusion hLE' u) =
          normLM F hLE' w - u * traceLM F hLE' w + u ^ 2) := by
    let E'' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE'
    haveI : FiniteDimensional F E'' := ‹FiniteDimensional F E'›
    haveI : IsScalarTower F L E'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L E'' := Module.Finite.of_restrictScalars_finite F L E''
    obtain ⟨h1, h2⟩ := hQuad_gen L E'' hdegE'
    exact ⟨fun u v w => h1 u v (toExtendScalars F hLE' w),
      fun u w => h2 u (toExtendScalars F hLE' w)⟩
  have hCoordTrNorm : ∀ s₀ s₁ : L,
      traceLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        2 * s₀ - s₁ ∧
      normLM F hLM₁'
