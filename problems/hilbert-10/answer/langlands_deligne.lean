by
  intro a r m₁ m₂ ψE' ψM₁' θE' θM₁'
  have ha_ge1 : 1 ≤ a := by dsimp [a]; omega
  have hr_ge_a : a ≤ r := by dsimp [a, r]; omega
  have hT1_eq : condExp F L νM₁' = 2 * a := by dsimp [a]; omega
  have hT2_eq : condExp F L νE' = 2 * r := by dsimp [r]; omega
  have hm₁_eq : m₁ = 4 * r - 1 := by dsimp [m₁, θM₁']; omega
  have hm₂_eq : m₂ = 2 * a + 2 * r - 1 := by dsimp [m₂, θE']; omega
  have hm₁_half : (m₁ + 1) / 2 = 2 * r := by omega
  have hm₂_half : (m₂ + 1) / 2 = a + r := by omega
  have hT2_half : (condExp F L νE' + 1) / 2 = r := by omega
  have hT1_half : (condExp F L νM₁' + 1) / 2 = a := by omega
  have hValPkg : ∀ (B : IntermediateField F (AlgebraicClosure F)),
      (valL F B 0 = 0 ∧ valL F B 1 = 0 ∧ valL F B (-1) = 0 ∧
        (∀ x : B, valL F B (-x) = valL F B x) ∧
        (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
        (∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B)) ∧
        (∀ m : ℤ, ∃ c : Bˣ, valL F B (c : B) = m) ∧
        (∀ (k : ℤ) (x y : B),
          (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
            (x + y = 0 ∨ k ≤ valL F B (x + y))) ∧
        (∀ u : Bˣ, u ∈ unitGroup F B 0 ↔ valL F B (u : B) = 0) ∧
        (∀ (a : ℕ), 1 ≤ a → ∀ u : Bˣ,
          u ∈ unitGroup F B a ↔ ((u : B) = 1 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1))) ∧
        (∀ (a : ℕ) (u : Bˣ), u ∈ unitGroup F B a → valL F B (u : B) = 0)) →
      (∀ (k₁ k₂ : ℤ) (x y : B),
        (x = 0 ∨ k₁ ≤ valL F B x) → (y = 0 ∨ k₂ ≤ valL F B y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F B (x * y))) ∧
      (∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x - y = 0 ∨ k ≤ valL F B (x - y))) ∧
      (∀ (k₁ k₂ : ℤ) (x y : B),
        x ≠ 0 → valL F B x = k₁ → (y = 0 ∨ k₂ ≤ valL F B y) → k₁ < k₂ →
          x + y ≠ 0 ∧ valL F B (x + y) = k₁) ∧
      (∀ (z : B), (z = 0 ∨ 1 ≤ valL F B z) → 1 + z ≠ 0) ∧
      (∀ (u : Bˣ) (n : ℕ), valL F B (((u ^ n : Bˣ) : B)) = (n : ℤ) * valL F B (u : B)) ∧
      (∀ (m₁ m₂ : ℕ), 1 ≤ m₁ → m₁ ≤ m₂ → ∀ u : Bˣ, u ∈ unitGroup F B m₂ → u ∈ unitGroup F B m₁) ∧
      (∀ (u v : Bˣ), valL F B (((u * v⁻¹ : Bˣ) : B)) = valL F B (u : B) - valL F B (v : B)) ∧
      (∀ (u v : Bˣ), (((u * v⁻¹)⁻¹ : Bˣ) : B) = ((u⁻¹ : Bˣ) : B) * (v : B)) := by
    clear * -
    intro B ⟨h0, h1, hneg1, hneg, hmul, hinv, hex, hadd, hug0, huga, huga_val⟩
    have hmul_b : ∀ (k₁ k₂ : ℤ) (x y : B),
        (x = 0 ∨ k₁ ≤ valL F B x) → (y = 0 ∨ k₂ ≤ valL F B y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F B (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · exact Or.inl (by simp [hx0])
      · by_cases hy0 : y = 0
        · exact Or.inl (by simp [hy0])
        · right
          rw [hmul x y hx0 hy0]
          have hx1 := hx.resolve_left hx0
          have hy1 := hy.resolve_left hy0
          omega
    have hsub_b : ∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x - y = 0 ∨ k ≤ valL F B (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      apply hadd k x (-y) hx
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · right; rwa [hneg]
    have heq_lt : ∀ (k₁ k₂ : ℤ) (x y : B),
        x ≠ 0 → valL F B x = k₁ → (y = 0 ∨ k₂ ≤ valL F B y) → k₁ < k₂ →
          x + y ≠ 0 ∧ valL F B (x + y) = k₁ := by
      intro k₁ k₂ x y hx0 hxv hy hk
      have hne : x + y ≠ 0 := by
        intro hsum
        have hyx : y = -x := eq_neg_of_add_eq_zero_right hsum
        have hy0 : y ≠ 0 := by rw [hyx]; exact neg_ne_zero.mpr hx0
        have hyv : valL F B y = k₁ := by rw [hyx, hneg, hxv]
        have hy_ge := hy.resolve_left hy0
        omega
      have hge : k₁ ≤ valL F B (x + y) := by
        have h := hadd k₁ x y (Or.inr (by omega)) (hy.imp id (fun h => by omega))
        exact h.resolve_left hne
      have hle : valL F B (x + y) ≤ k₁ := by
        by_contra hlt
        push_neg at hlt
        let m := min (valL F B (x + y)) k₂
        have hm_gt : k₁ < m := lt_min hlt hk
        have hxy_m : x + y = 0 ∨ m ≤ valL F B (x + y) := Or.inr (min_le_left _ _)
        have hny_m : -y = 0 ∨ m ≤ valL F B (-y) := by
          rcases hy with rfl | hy
          · exact Or.inl neg_zero
          · right; rw [hneg]; exact le_trans (min_le_right _ _) hy
        have hx_m := hadd m (x + y) (-y) hxy_m hny_m
        rw [add_neg_cancel_right] at hx_m
        have hx_ge := hx_m.resolve_left hx0
        omega
      exact ⟨hne, le_antisymm hle hge⟩
    have h1add : ∀ (z : B), (z = 0 ∨ 1 ≤ valL F B z) → 1 + z ≠ 0 := by
      intro z hz
      exact (heq_lt 0 1 1 z one_ne_zero h1 hz (by omega)).1
    have hpow : ∀ (u : Bˣ) (n : ℕ), valL F B (((u ^ n : Bˣ) : B)) = (n : ℤ) * valL F B (u : B) := by
      intro u n
      induction n with
      | zero => simp [h1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hmul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hug_mono : ∀ (m₁ m₂ : ℕ), 1 ≤ m₁ → m₁ ≤ m₂ → ∀ u : Bˣ, u ∈ unitGroup F B m₂ → u ∈ unitGroup F B m₁ := by
      intro m₁ m₂ hm₁ hm₁₂ u hu
      rw [huga m₁ hm₁ u]
      rw [huga m₂ (by omega) u] at hu
      exact hu.imp id (fun h => by omega)
    have hmul_inv : ∀ (u v : Bˣ), valL F B (((u * v⁻¹ : Bˣ) : B)) = valL F B (u : B) - valL F B (v : B) := by
      intro u v
      rw [Units.val_mul, hmul _ _ (Units.ne_zero _) (Units.ne_zero _), hinv v]
      ring
    have hinv_mul_inv : ∀ (u v : Bˣ), (((u * v⁻¹)⁻¹ : Bˣ) : B) = ((u⁻¹ : Bˣ) : B) * (v : B) := by
      intro u v
      rw [mul_inv, inv_inv, Units.val_mul]
    exact ⟨hmul_b, hsub_b, heq_lt, h1add, hpow, hug_mono, hmul_inv, hinv_mul_inv⟩
