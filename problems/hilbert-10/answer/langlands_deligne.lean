        rw [ha₁_eq, h_exp, h_sum_single] at h
        linear_combination h
      exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hd_pow)
    have hfrob_pow_inj : ∀ n : ℕ, Function.Injective (fun a : k_K => a ^ ((p F) ^ n)) := by
      intro n
      induction n with
      | zero =>
        intro a₁ a₂ h
        simpa using h
      | succ n ih =>
        intro a₁ a₂ h
        change a₁ ^ ((p F) ^ (n + 1)) = a₂ ^ ((p F) ^ (n + 1)) at h
        rw [pow_succ', pow_mul, pow_mul] at h
        exact hfrob_p_inj (ih h)
    refine ⟨hCyclic_H₀, ?_⟩
    intro i h hh₀ hfix_i
    set q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    obtain ⟨r_exp, _, hq_eq⟩ := hq_pow
    obtain ⟨ϖ_i, hϖ_i⟩ := hUnifFi i
    set π_i : K := IntermediateField.inclusion hM_CK
