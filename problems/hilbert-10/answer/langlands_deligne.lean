  have hC_coe : (C : K₁) = C_val := rfl
  have hC_val : valL F K₁ (C : K₁) = 1 - 2 * (a : ℤ) := hC_val_elem
  have hnorm_trE' : normLM F hLE' (traceLM F hE'K₁ (C : K₁)) = β₂ + (4 * c₀ + 4 * c₀ ^ 2) := by
    rw [hC_coe, htrE'_eq]
