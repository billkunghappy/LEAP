  let U_v_nz : ∀ v : ℕ, Finset (Fin v → Fin p) := fun v => (U_v v).filter (fun g => ¬ P0_v v g)
  let U_v_mid : ∀ v : ℕ, Finset (Fin v → Fin p) := fun v => (U_v_nz v).filter (Pmid_v v)
  let U_v_high : ∀ v : ℕ, Finset (Fin v → Fin p) := fun v => (U_v_nz v).filter (fun g => ¬ Pmid_v v g)
