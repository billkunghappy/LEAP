  have hdet_ne : M.det ≠ 0 := by
    rw [hdet_d]
    exact Finset.prod_ne_zero_iff.mpr (fun r _ => hd_ne r)
  have hψ_sum : ∀ (g : Fin f → k_L) (s : Finset (Fin f)),
      ψ_ref (∑ r ∈ s, g r) = ∏ r ∈ s, ψ_ref (g r) := by
    intro g s
    induction s using Finset.induction_on with
    | empty => simp [AddChar.map_zero_eq_one]
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha, AddChar.map_add_eq_mul, ih, Finset.prod_insert ha]
  have hquad_coord : ∀ x : Fin f → k_L,
      Algebra.trace k_L k_M (algebraMap k_L k_M c_0 * (b * ((v_basis.equivFun.symm x) ^ 2))) =
        ∑ r : Fin f, c_0 * (d r * (x r ^ 2)) := by
    intro x
    set y := v_basis.equivFun.symm x
    have hy_eq : y = ∑ r : Fin f, x r • v_basis r := v_basis.equivFun_symm_apply x
    have hc0_smul : algebraMap k_L k_M c_0 * (b * y ^ 2) = c_0 • (b * y * y) := by
      rw [Algebra.smul_def, sq, mul_assoc b y y]
    rw [hc0_smul, map_smul, smul_eq_mul, ← hB_apply]
    have hByy : B_b y y = ∑ r : Fin f, d r * (x r ^ 2) := by
      have h1 : B_b y y = ∑ r : Fin f, x r * B_b y (v_basis r) := by
        have h_rhs : B_b y y = (B_b y) (∑ r : Fin f, x r • v_basis r) := by
          congr 1
        rw [h_rhs, map_sum]
        refine Finset.sum_congr rfl (fun r _ => ?_)
        rw [map_smul, smul_eq_mul]
      rw [h1]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      have hsymm_yr : B_b y (v_basis r) = B_b (v_basis r) y := hSymm.eq y (v_basis r)
      have h2 : B_b (v_basis r) y = x r * d r := by
        rw [hy_eq, map_sum]
        rw [Finset.sum_eq_single r]
        · rw [map_smul, smul_eq_mul, hB_apply, ← hd_def r]
        · intro s _ hsr
          rw [map_smul, smul_eq_mul, hB_apply, hortho' r s hsr.symm, mul_zero]
        · intro hr
          exact absurd (Finset.mem_univ r) hr
      rw [hsymm_yr, h2]
      ring
    rw [hByy, Finset.mul_sum]
  have hsum_factor :
      (∑ y : k_M,
        ψ_ref (Algebra.trace k_L k_M
          (algebraMap k_L k_M c_0 * (b * (y ^ 2))))) =
        ∏ r : Fin f, (∑ x : k_L, ψ_ref (c_0 * (d r * (x ^ 2)))) := by
    have hreindex :
        (∑ y : k_M,
          ψ_ref (Algebra.trace k_L k_M
            (algebraMap k_L k_M c_0 * (b * (y ^ 2))))) =
        ∑ x : Fin f → k_L,
          ψ_ref (Algebra.trace k_L k_M
            (algebraMap k_L k_M c_0 * (b * ((v_basis.equivFun.symm x) ^ 2)))) := by
      exact (Fintype.sum_equiv v_basis.equivFun.toEquiv.symm
        (fun x => ψ_ref (Algebra.trace k_L k_M
          (algebraMap k_L k_M c_0 * (b * ((v_basis.equivFun.symm x) ^ 2)))))
        (fun y => ψ_ref (Algebra.trace k_L k_M
          (algebraMap k_L k_M c_0 * (b * (y ^ 2)))))
        (fun x => rfl)).symm
    rw [hreindex]
    have hcongr :
        (∑ x : Fin f → k_L,
          ψ_ref (Algebra.trace k_L k_M
            (algebraMap k_L k_M c_0 * (b * ((v_basis.equivFun.symm x) ^ 2))))) =
        ∑ x : Fin f → k_L, ∏ r : Fin f, ψ_ref (c_0 * (d r * (x r ^ 2))) := by
      refine Finset.sum_congr rfl (fun x _ => ?_)
      rw [hquad_coord x, hψ_sum]
    rw [hcongr]
    exact (Fintype.prod_sum (fun (r : Fin f) (a : k_L) => ψ_ref (c_0 * (d r * (a ^ 2))))).symm
  
  let q_L := Fintype.card k_L
  let V : Matrix (Fin f) (Fin f) k_M :=
    Matrix.of (fun r j : Fin f => (v r) ^ (q_L ^ j.1))
  let D_b : Matrix (Fin f) (Fin f) k_M :=
    Matrix.diagonal (fun j : Fin f => b ^ (q_L ^ j.1))
  have h2_kM : (2 : k_M) ≠ 0 := by
    have h := (RingHom.injective (algebraMap k_L k_M)).ne hNe2
    rwa [map_ofNat, map_zero] at h
  have hM_eq : (algebraMap k_L k_M).mapMatrix M = V * D_b * V.transpose := by
    ext r s
    dsimp only [M, V, D_b]
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
      FiniteField.algebraMap_trace_eq_sum_pow k_L k_M (b * v r * v s),
      Nat.card_eq_fintype_card, ← Fin.sum_univ_eq_sum_range,
      Matrix.mul_apply]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Matrix.mul_diagonal, Matrix.transpose_apply, Matrix.of_apply, Matrix.of_apply]
    repeat rw [mul_pow]
    ring
  have hdet_M : algebraMap k_L k_M M.det =
      algebraMap k_L k_M (Algebra.norm k_L b) * (V.det) ^ 2 := by
    have h1 := congrArg Matrix.det hM_eq
    rw [← RingHom.map_det, Matrix.det_mul, Matrix.det_mul, Matrix.det_diagonal,
      Matrix.det_transpose] at h1
    have hnorm : (∏ j : Fin f, b ^ (q_L ^ j.1)) = algebraMap k_L k_M (Algebra.norm k_L b) := by
      rw [FiniteField.algebraMap_norm_eq_prod_pow k_L k_M b,
        Nat.card_eq_fintype_card, ← Fin.prod_univ_eq_prod_range]
    rw [hnorm] at h1
    linear_combination h1
  have hM_det_ne_kM : algebraMap k_L k_M M.det ≠ 0 := by
    have h := (RingHom.injective (algebraMap k_L k_M)).ne hdet_ne
    rwa [map_zero] at h
  have hV_det_ne : V.det ≠ 0 := by
    intro hV0
    apply hM_det_ne_kM
    rw [hdet_M, hV0, sq, mul_zero, mul_zero]
  let Φ : k_M →+* k_M := (FiniteField.frobeniusAlgHom k_L k_M).toRingHom
  have hΦ_apply : ∀ z : k_M, Φ z = z ^ q_L := FiniteField.frobeniusAlgHom_apply k_L k_M
  have hfinRotate_props : ∀ (n : ℕ), 0 < n →
      ((Equiv.Perm.sign (finRotate n) : ℤˣ) : k_M) = (-1 : k_M) ^ (n - 1) ∧
      ∀ j : Fin n, (finRotate n j).1 = if j.1 + 1 = n then 0 else j.1 + 1 := by
    intro n hn
    rcases n with _ | m
    · omega
    · refine ⟨?_, ?_⟩
      · rw [sign_finRotate m, Nat.add_sub_cancel]
        simp
      · intro j
        rw [coe_finRotate]
        by_cases hj : j = Fin.last m
        · subst hj
          simp [Fin.last]
        · have hj_val : j.1 + 1 ≠ m + 1 := by
            intro h_eq
            apply hj
            ext
            dsimp only [Fin.last]
            omega
          rw [if_neg hj, if_neg hj_val]
  have hf_pos : 0 < f := Module.finrank_pos
  obtain ⟨hsign_rot, hval_rot⟩ := hfinRotate_props f hf_pos
  have hcard_kM : Fintype.card k_M = q_L ^ f := Module.card_eq_pow_finrank
  have hΦ_V : Φ.mapMatrix V = V.submatrix id (finRotate f) := by
    ext r j
    dsimp only [V]
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.submatrix_apply, id_eq,
      Matrix.of_apply, Matrix.of_apply, hΦ_apply, ← pow_mul, ← pow_succ, hval_rot j]
    by_cases hj : j.1 + 1 = f
    · rw [if_pos hj, hj, pow_zero, pow_one, ← hcard_kM, FiniteField.pow_card]
    · rw [if_neg hj]
  have hV_det_qL : (V.det) ^ q_L = (-1 : k_M) ^ (f - 1) * V.det := by
    calc (V.det) ^ q_L
        = Φ V.det := (hΦ_apply V.det).symm
      _ = (Φ.mapMatrix V).det := RingHom.map_det Φ V
      _ = (V.submatrix id (finRotate f)).det := congrArg Matrix.det hΦ_V
      _ = ((Equiv.Perm.sign (finRotate f) : ℤˣ) : k_M) * V.det :=
          Matrix.det_permute' (finRotate f) V
      _ = (-1 : k_M) ^ (f - 1) * V.det := by rw [hsign_rot]
  have hqL_gt1 : 1 < q_L := Fintype.one_lt_card
  have hV_det_qL_sub1 : (V.det) ^ (q_L - 1) = (-1 : k_M) ^ (f - 1) := by
    apply mul_right_cancel₀ hV_det_ne
    rw [← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ q_L)]
    exact hV_det_qL
  have hqL_odd : Odd q_L := by
    obtain ⟨n, hchar, m, _, hcard⟩ := FiniteField.card' k_L
    have hn_eq : n = p_F := (ringChar.eq k_L n).symm.trans hring
    rw [hn_eq] at hcard
    change q_L = p_F ^ (m : ℕ) at hcard
    rw [hcard]
    exact (hp.odd_of_ne_two hp_ne2).pow
  have hqL_div2 : 2 * (q_L / 2) = q_L - 1 := by
    rcases hqL_odd with ⟨m, hm⟩
    omega
  have hpow_half :
      (algebraMap k_L k_M M.det) ^ (q_L / 2) =
        (algebraMap k_L k_M (Algebra.norm k_L b)) ^ (q_L / 2) * (-1 : k_M) ^ (f - 1) := by
    calc (algebraMap k_L k_M M.det) ^ (q_L / 2)
        = (algebraMap k_L k_M (Algebra.norm k_L b) * (V.det) ^ 2) ^ (q_L / 2) := by
          rw [hdet_M]
      _ = (algebraMap k_L k_M (Algebra.norm k_L b)) ^ (q_L / 2) *
            (V.det) ^ (2 * (q_L / 2)) := by
          rw [mul_pow, ← pow_mul]
      _ = (algebraMap k_L k_M (Algebra.norm k_L b)) ^ (q_L / 2) * (-1 : k_M) ^ (f - 1) := by
          rw [hqL_div2, hV_det_qL_sub1]
  have hquad_M :
      (algebraMap k_L k_M M.det) ^ (q_L / 2) =
        ((quadraticChar k_L M.det : ℤ) : k_M) := by
    rw [← map_pow, ← quadraticChar_eq_pow_of_char_ne_two' hring_ne2 M.det, map_intCast]
  have hquad_b :
      (algebraMap k_L k_M (Algebra.norm k_L b)) ^ (q_L / 2) =
        ((quadraticChar k_L (Algebra.norm k_L b) : ℤ) : k_M) := by
    rw [← map_pow, ← quadraticChar_eq_pow_of_char_ne_two' hring_ne2 (Algebra.norm k_L b),
      map_intCast]
  have hcast_eq :
      ((quadraticChar k_L M.det : ℤ) : k_M) =
        (((-1 : ℤ) ^ (f - 1) * quadraticChar k_L (Algebra.norm k_L b) : ℤ) : k_M) := by
    rw [← hquad_M, hpow_half, hquad_b, Int.cast_mul, Int.cast_pow, Int.cast_neg, Int.cast_one,
      mul_comm]
  have hnb_ne : Algebra.norm k_L b ≠ 0 := Algebra.norm_ne_zero_iff.mpr hb
  have hs₁_sq : (quadraticChar k_L M.det) ^ 2 = 1 := by
    rw [← map_pow]
    exact quadraticChar_sq_one' hdet_ne
  have hs₂_sq : ((-1 : ℤ) ^ (f - 1) * quadraticChar k_L (Algebra.norm k_L b)) ^ 2 = 1 := by
    rw [mul_pow, ← pow_mul, mul_comm (f - 1) 2, pow_mul, neg_one_sq, one_pow, one_mul, ← map_pow]
    exact quadraticChar_sq_one' hnb_ne
  have hstick :
      quadraticChar k_L M.det =
        (-1 : ℤ) ^ (f - 1) * quadraticChar k_L (Algebra.norm k_L b) := by
    rcases sq_eq_one_iff.mp hs₁_sq with hs₁ | hs₁ <;>
      rcases sq_eq_one_iff.mp hs₂_sq with hs₂ | hs₂
    · rw [hs₁, hs₂]
    · exfalso
      rw [hs₁, hs₂, Int.cast_one, Int.cast_neg, Int.cast_one] at hcast_eq
      have h20 : (2 : k_M) = 0 := by linear_combination hcast_eq
      exact h2_kM h20
    · exfalso
      rw [hs₁, hs₂, Int.cast_neg, Int.cast_one] at hcast_eq
      have h20 : (2 : k_M) = 0 := by linear_combination -hcast_eq
      exact h2_kM h20
    · rw [hs₁, hs₂]
  
  have hc0_map :
      (-1 : k_M) ^ ((p_F - 1) / 2) * (2 : k_M)⁻¹ = algebraMap k_L k_M c_0 := by
    dsimp only [c_0]
    rw [map_mul, map_pow, map_neg, map_one, map_inv₀, map_ofNat]
  have hsum_lhs :
      (∑ y : k_M,
        ψ_ref (Algebra.trace k_L k_M
          ((-1 : k_M) ^ ((p_F - 1) / 2) * (2 : k_M)⁻¹ * (b * (y ^ 2))))) =
      ∑ y : k_M,
        ψ_ref (Algebra.trace k_L k_M
          (algebraMap k_L k_M c_0 * (b * (y ^ 2)))) := by
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [hc0_map]
  rw [hsum_lhs, hsum_factor]
  have hprod_eval :
      (∏ r : Fin f, (∑ x : k_L, ψ_ref (c_0 * (d r * (x ^ 2))))) =
        (∏ r : Fin f, (((quadraticChar k_L (d r) : ℤ) : R) * G_L)) := by
    refine Finset.prod_congr rfl (fun r _ => ?_)
    exact hConj2_main (d r) (hd_ne r)
  rw [hprod_eval, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  congr 1
  rw [← Int.cast_prod, ← map_prod, ← hdet_d, hstick]

theorem ld_ch14_odd_p_base_ref_char_and_gauss_factor (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (c'_χ' : Lˣ)
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (k_L : Type u) [Field k_L] [Fintype k_L]
    (resL : L → k_L) (ψ_0L : AddChar k_L (Ω F))
    (hresL_props :
      IsResidueFieldMap F L k_L resL ∧
      IsStatResChar F L ψ χ' ϖ_L c'_χ' k_L resL ψ_0L)
    (hcard_kL : Fintype.card k_L = qL F L)
    (hp_char : ((p F : ℕ) : k_L) = 0)
    (hHD_base : ∀ (ψ_ref : AddChar k_L (Ω F)), ψ_ref ≠ 1 →
      let G_L : Ω F :=
        ∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))
      G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : Ω F) * (Fintype.card k_L : Ω F) ∧
      (∀ a : k_L, a ≠ 0 →
        (∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (a * (x ^ 2)))) =
          ((quadraticChar k_L a : ℤ) : Ω F) * G_L)) :
    let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
    let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
    ∃ (ψ_ref : AddChar k_L (Ω F)),
      let G_L : Ω F :=
        ∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))
      ψ_ref ≠ 1 ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ψ_ref (resL x) = ψ (((c₀⁻¹ : Lˣ) : L) * x)) ∧
      G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : Ω F) * (qL F L : Ω F) ∧
      valL F L (u_χ' : L) = 0 ∧
      resL (u_χ' : L) ≠ 0 ∧
      (condExp F L χ' % 2 = 1 →
        oddStatGaussFactor F L χ' k_L ψ_0L =
          ((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)) :=
by
  classical
  let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
  let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, _, hval_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hψ_triv, hψ_nontriv, _, _⟩ :=
    ld_condExp_and_condExpChar_spec F L ψ hψ χ'
  obtain ⟨⟨hres0, hres1, hres_ring, hres_ker, hres_surj⟩, hstat_res⟩ := hresL_props

  
  let PL (m : ℤ) (x : L) : Prop := x = 0 ∨ m ≤ valL F L x
  have hPL_zero : ∀ m : ℤ, PL m 0 := fun _ => Or.inl rfl
  have hPL_of_val : ∀ {m : ℤ} {x : L}, valL F L x = m → PL m x := fun h => Or.inr (by omega)
  have hPL_mono : ∀ {m₁ m₂ : ℤ} {x : L}, m₁ ≤ m₂ → PL m₂ x → PL m₁ x := by
    intro m₁ m₂ x hm hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hx)
  have hPL_neg : ∀ {m : ℤ} {x : L}, PL m x → PL m (-x) := by
    intro m x hx
    rcases hx with rfl | hx
    · rw [neg_zero]; exact Or.inl rfl
    · right; rw [hval_neg]; exact hx
  have hPL_add : ∀ {m : ℤ} {x y : L}, PL m x → PL m y → PL m (x + y) :=
    fun hx hy => hval_add _ _ _ hx hy
  have hPL_sub : ∀ {m : ℤ} {x y : L}, PL m x → PL m y → PL m (x - y) := by
    intro m x y hx hy
    rw [sub_eq_add_neg]
    exact hPL_add hx (hPL_neg hy)
  have hPL_mul : ∀ {m₁ m₂ : ℤ} {x y : L}, PL m₁ x → PL m₂ y → PL (m₁ + m₂) (x * y) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega

  have hresL_sub_mem1 : ∀ {x₁ x₂ : L}, PL 0 x₁ → PL 0 x₂ → resL x₁ = resL x₂ → PL 1 (x₁ - x₂) := by
    intro x₁ x₂ hx₁ hx₂ hres
    have hsub_int : PL 0 (x₁ - x₂) := hPL_sub hx₁ hx₂
    have hres_sub : resL (x₁ - x₂) = 0 := by
      rw [sub_eq_add_neg, (hres_ring x₁ (-x₂) hx₁ (hPL_neg hx₂)).1,
        (hres_ring x₂ 0 hx₂ (hPL_zero 0)).2.2, hres, add_neg_cancel]
    exact (hres_ker (x₁ - x₂) hsub_int).mp hres_sub

  
  have hϖ_pow : ∀ n : ℕ, valL F L ((ϖ_L ^ n : Lˣ) : L) = (n : ℤ) := by
    intro n
    induction n with
    | zero =>
      rw [pow_zero, Units.val_one, hval1, Nat.cast_zero]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero (ϖ_L ^ n)) (Units.ne_zero ϖ_L),
        ih, hϖ_L, Nat.cast_add, Nat.cast_one]

  have hϖ_zpow : ∀ m : ℤ, valL F L ((ϖ_L ^ m : Lˣ) : L) = m := by
    intro m
    cases m with
    | ofNat n =>
      rw [Int.ofNat_eq_coe, zpow_natCast]
      exact hϖ_pow n
    | negSucc n =>
      rw [zpow_negSucc, hval_inv (ϖ_L ^ (n + 1)), hϖ_pow (n + 1), Int.negSucc_eq]
      omega

  have hc₀_val : valL F L (c₀ : L) = 1 + condExpChar F L ψ := hϖ_zpow (1 + condExpChar F L ψ)
  have hc₀_inv_val : valL F L ((c₀⁻¹ : Lˣ) : L) = -(1 + condExpChar F L ψ) := by
    rw [hval_inv c₀, hc₀_val]

  
  have hψ_congr : ∀ {x y : L}, PL (-condExpChar F L ψ) (x - y) → ψ x = ψ y := by
    intro x y hxy
    have h_eq : x = (x - y) + y := by ring
    rw [h_eq, ψ.map_add_eq_mul, hψ_triv (x - y) hxy, one_mul]

  let liftL : k_L → L := fun a => Classical.choose (hres_surj a)
  have hliftL_int : ∀ a : k_L, PL 0 (liftL a) :=
    fun a => (Classical.choose_spec (hres_surj a)).1
  have hliftL_res : ∀ a : k_L, resL (liftL a) = a :=
    fun a => (Classical.choose_spec (hres_surj a)).2

  let ψ_ref_fun : k_L → Ω F := fun a => ψ (((c₀⁻¹ : Lˣ) : L) * liftL a)

  have hψ_ref_fun_spec : ∀ x : L, PL 0 x → ψ_ref_fun (resL x) = ψ (((c₀⁻¹ : Lˣ) : L) * x) := by
    intro x hx
    dsimp only [ψ_ref_fun]
    symm
    apply hψ_congr
    have h_eq : ((c₀⁻¹ : Lˣ) : L) * x - ((c₀⁻¹ : Lˣ) : L) * liftL (resL x) =
        ((c₀⁻¹ : Lˣ) : L) * (x - liftL (resL x)) := by ring
    rw [h_eq]
    have hΔ1 : PL 1 (x - liftL (resL x)) :=
      hresL_sub_mem1 hx (hliftL_int (resL x)) (hliftL_res (resL x)).symm
    exact hPL_mono (by omega) (hPL_mul (hPL_of_val hc₀_inv_val) hΔ1)

  have hψ_ref_0 : ψ_ref_fun 0 = 1 := by
    rw [← hres0, hψ_ref_fun_spec 0 (hPL_zero 0), mul_zero, ψ.map_zero_eq_one]

  have hψ_ref_add : ∀ a b : k_L, ψ_ref_fun (a + b) = ψ_ref_fun a * ψ_ref_fun b := by
    intro a b
    set xa := liftL a
    set xb := liftL b
    have hxa : PL 0 xa := hliftL_int a
    have hxb : PL 0 xb := hliftL_int b
    have hab_res : a + b = resL (xa + xb) := by
      rw [(hres_ring xa xb hxa hxb).1, hliftL_res a, hliftL_res b]
    rw [hab_res, hψ_ref_fun_spec (xa + xb) (hPL_add hxa hxb),
      ← hliftL_res a, ← hliftL_res b, hψ_ref_fun_spec xa hxa, hψ_ref_fun_spec xb hxb,
      ← ψ.map_add_eq_mul]
    congr 1
    ring

  let ψ_ref : AddChar k_L (Ω F) :=
    { toFun := ψ_ref_fun
      map_zero_eq_one' := hψ_ref_0
      map_add_eq_mul' := hψ_ref_add }

  have hψ_ref_apply : ∀ a : k_L, ψ_ref a = ψ_ref_fun a := fun _ => rfl

  have hψ_ref_spec : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_ref (resL x) = ψ (((c₀⁻¹ : Lˣ) : L) * x) :=
    fun x hx => hψ_ref_fun_spec x hx

  have hψ_ref_ne : ψ_ref ≠ 1 := by
    intro h_eq1
    obtain ⟨x₁, _, hx₁_val, hx₁_ψ⟩ := hψ_nontriv
    set y₁ : L := (c₀ : L) * x₁
    have hy₁_int : PL 0 y₁ := by
      dsimp only [y₁]
      exact hPL_mono (by omega) (hPL_mul (hPL_of_val hc₀_val) (Or.inr hx₁_val))
    have hy₁_cancel : ((c₀⁻¹ : Lˣ) : L) * y₁ = x₁ := by
      have hc_cancel : ((c₀⁻¹ : Lˣ) : L) * (c₀ : L) = 1 := by exact_mod_cast Units.inv_mul c₀
      calc ((c₀⁻¹ : Lˣ) : L) * ((c₀ : L) * x₁)
        _ = (((c₀⁻¹ : Lˣ) : L) * (c₀ : L)) * x₁ := by ring
        _ = 1 * x₁ := by rw [hc_cancel]
        _ = x₁ := one_mul x₁
    have hval1_eval : ψ_ref (resL y₁) = 1 := by
      rw [h_eq1, AddChar.one_apply]
    rw [hψ_ref_spec y₁ hy₁_int, hy₁_cancel] at hval1_eval
    exact hx₁_ψ hval1_eval

  let G_L : Ω F :=
    ∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))

  have hG_L_sq : G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : Ω F) * (qL F L : Ω F) := by
    have hsq := (hHD_base ψ_ref hψ_ref_ne).1
    rwa [hcard_kL] at hsq

  
  have hu_val : valL F L (u_χ' : L) = 0 := by
    dsimp only [u_χ']
    rw [Units.val_mul,
      hval_mul _ _ (Units.ne_zero (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹) (Units.ne_zero c'_χ'),
      hval_inv (ϖ_L ^ (condExp F L χ' - 1) * c₀), Units.val_mul,
      hval_mul _ _ (Units.ne_zero (ϖ_L ^ (condExp F L χ' - 1))) (Units.ne_zero c₀),
      hϖ_pow (condExp F L χ' - 1), hc₀_val, hc_L_val]
    omega

  have hu_int : PL 0 (u_χ' : L) := hPL_of_val hu_val

  have hu_res_ne : resL (u_χ' : L) ≠ 0 := by
    intro h0
    rcases (hres_ker (u_χ' : L) hu_int).mp h0 with h_zero | h_ge1
    · exact Units.ne_zero u_χ' h_zero
    · omega

  have hu_inv_val : valL F L ((u_χ'⁻¹ : Lˣ) : L) = 0 := by
    rw [hval_inv u_χ', hu_val, neg_zero]
  have hu_inv_int : PL 0 ((u_χ'⁻¹ : Lˣ) : L) := hPL_of_val hu_inv_val

  have hu_inv_res : resL ((u_χ'⁻¹ : Lˣ) : L) = (resL (u_χ' : L))⁻¹ := by
    have hmul1 : resL (u_χ' : L) * resL ((u_χ'⁻¹ : Lˣ) : L) = 1 := by
      rw [← (hres_ring (u_χ' : L) ((u_χ'⁻¹ : Lˣ) : L) hu_int hu_inv_int).2.1,
        ← Units.val_mul, mul_inv_cancel, Units.val_one, hres1]
    calc resL ((u_χ'⁻¹ : Lˣ) : L)
      _ = 1 * resL ((u_χ'⁻¹ : Lˣ) : L) := (one_mul _).symm
      _ = ((resL (u_χ' : L))⁻¹ * resL (u_χ' : L)) * resL ((u_χ'⁻¹ : Lˣ) : L) := by
          rw [inv_mul_cancel₀ hu_res_ne]
      _ = (resL (u_χ' : L))⁻¹ * (resL (u_χ' : L) * resL ((u_χ'⁻¹ : Lˣ) : L)) := by ring
      _ = (resL (u_χ' : L))⁻¹ * 1 := by rw [hmul1]
      _ = (resL (u_χ' : L))⁻¹ := mul_one _

  
  have hodd_gauss : condExp F L χ' % 2 = 1 →
      oddStatGaussFactor F L χ' k_L ψ_0L =
        ((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) *
          ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) := by
    intro hodd
    have hdiv2 : 2 * (condExp F L χ' / 2) = condExp F L χ' - 1 := by omega
    have h_units_eq : c'_χ'⁻¹ * (ϖ_L ^ (2 * (condExp F L χ' / 2))) = c₀⁻¹ * u_χ'⁻¹ := by
      rw [hdiv2]
      dsimp only [u_χ']
      rw [mul_inv_rev, inv_inv]
      calc c'_χ'⁻¹ * ϖ_L ^ (condExp F L χ' - 1)
        _ = c'_χ'⁻¹ * (c₀⁻¹ * (c₀ * ϖ_L ^ (condExp F L χ' - 1))) := by rw [inv_mul_cancel_left]
        _ = c₀⁻¹ * (c'_χ'⁻¹ * (ϖ_L ^ (condExp F L χ' - 1) * c₀)) := by ac_rfl
    have h_val_eq : ∀ x : L,
        ((c'_χ'⁻¹ : Lˣ) : L) * (((ϖ_L ^ (2 * (condExp F L χ' / 2)) : Lˣ) : L) * x) =
          ((c₀⁻¹ : Lˣ) : L) * (((u_χ'⁻¹ : Lˣ) : L) * x) := by
      intro x
      have hcoe := congrArg (fun v : Lˣ => (v : L)) h_units_eq
      simp only [Units.val_mul] at hcoe
      calc ((c'_χ'⁻¹ : Lˣ) : L) * (((ϖ_L ^ (2 * (condExp F L χ' / 2)) : Lˣ) : L) * x)
        _ = (((c'_χ'⁻¹ : Lˣ) : L) * ((ϖ_L ^ (2 * (condExp F L χ' / 2)) : Lˣ) : L)) * x := by ring
        _ = (((c₀⁻¹ : Lˣ) : L) * ((u_χ'⁻¹ : Lˣ) : L)) * x := by rw [hcoe]
        _ = ((c₀⁻¹ : Lˣ) : L) * (((u_χ'⁻¹ : Lˣ) : L) * x) := by ring
    have hψ0L_eq : ∀ b : k_L, ψ_0L b = ψ_ref ((resL (u_χ' : L))⁻¹ * b) := by
      intro b
      set xb := liftL b
      have hxb_int : PL 0 xb := hliftL_int b
      have huxb_int : PL 0 (((u_χ'⁻¹ : Lˣ) : L) * xb) := by
        simpa using hPL_mul hu_inv_int hxb_int
      have huxb_res : resL (((u_χ'⁻¹ : Lˣ) : L) * xb) = (resL (u_χ' : L))⁻¹ * b := by
        rw [(hres_ring ((u_χ'⁻¹ : Lˣ) : L) xb hu_inv_int hxb_int).2.1,
          hu_inv_res, hliftL_res b]
      rw [← hliftL_res b, hstat_res xb hxb_int, h_val_eq xb,
        ← hψ_ref_spec (((u_χ'⁻¹ : Lˣ) : L) * xb) huxb_int,
        huxb_res, hliftL_res b]
    unfold oddStatGaussFactor
    rw [if_pos hodd]
    have hsum_eq :
        (∑ x : k_L, ψ_0L ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))) =
        (∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ *
          ((resL (u_χ' : L))⁻¹ * (x ^ 2)))) := by
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [hψ0L_eq]
      congr 1
      ring
    have hscale := (hHD_base ψ_ref hψ_ref_ne).2 ((resL (u_χ' : L))⁻¹) (inv_ne_zero hu_res_ne)
    have hquad_inv : quadraticChar k_L ((resL (u_χ' : L))⁻¹) =
        quadraticChar k_L (resL (u_χ' : L)) := by
      set u₀ := resL (u_χ' : L)
      have h1 : u₀⁻¹ * u₀ ^ 2 = u₀ := by
        rw [sq, inv_mul_cancel_left₀ hu_res_ne]
      calc quadraticChar k_L (u₀⁻¹)
        _ = quadraticChar k_L (u₀⁻¹) * 1 := (mul_one _).symm
        _ = quadraticChar k_L (u₀⁻¹) * quadraticChar k_L (u₀ ^ 2) := by
            rw [quadraticChar_sq_one' hu_res_ne]
        _ = quadraticChar k_L (u₀⁻¹ * u₀ ^ 2) := (map_mul (quadraticChar k_L) _ _).symm
        _ = quadraticChar k_L u₀ := by rw [h1]
    rw [hsum_eq, hscale, hquad_inv]
    change (qL F L : Ω F) ^ ((p F - 1) / 2) *
        (((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) * G_L) =
      ((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) *
        ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)
    ring

  exact ⟨ψ_ref, hψ_ref_ne, hψ_ref_spec, hG_L_sq, hu_val, hu_res_ne, hodd_gauss⟩

theorem ld_ch14_local_to_residue_algebra_and_basis_val (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M]
    (hLM : L ≤ M)
    (k f_M : ℕ) (hk_ge1 : 1 ≤ k) (hf_M_ge1 : 1 ≤ f_M)
    (hfinrank_LM : Module.finrank L (IntermediateField.extendScalars hLM) = k * f_M)
    (hresDeg_LM : resDeg F M = f_M * resDeg F L)
    (hValNorm_LM : ∀ z : M, valL F L (normLM F hLM z) = (f_M : ℤ) * valL F M z)
    (ϖ_M : Mˣ) (hϖ_M : valL F M (ϖ_M : M) = 1)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    (resL : L → k_L) (resM : M → k_M)
    (hresL_map : IsResidueFieldMap F L k_L resL)
    (hresM_map : IsResidueFieldMap F M k_M resM)
    (hcard_kL : Fintype.card k_L = qL F L)
    (hcard_kM : Fintype.card k_M = qL F M) :
    qL F M = (qL F L) ^ f_M ∧
    (∀ x : L, valL F M (IntermediateField.inclusion hLM x) = (k : ℤ) * valL F L x) ∧
    ∃ (hAlg : Algebra k_L k_M),
      letI : Algebra k_L k_M := hAlg
      Module.finrank k_L k_M = f_M ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resM (IntermediateField.inclusion hLM x) = algebraMap k_L k_M (resL x)) ∧
      (∀ (e : Module.Basis (Fin f_M) k_L k_M) (u : Fin f_M → M),
        (∀ r : Fin f_M, u r = 0 ∨ 0 ≤ valL F M (u r)) →
        (∀ r : Fin f_M, resM (u r) = e r) →
        let w : Fin f_M × Fin k → IntermediateField.extendScalars hLM :=
          fun p => toExtendScalars F hLM (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M))
        LinearIndependent L w ∧
        ∀ (g : Fin f_M × Fin k → L) (s₀ : Fin k),
          ((∑ p : Fin f_M × Fin k,
              IntermediateField.inclusion hLM (g p) *
                (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M))) = 0 ∨
            ((s₀ : ℕ) + 1 : ℤ) ≤
              valL F M
                (∑ p : Fin f_M × Fin k,
                  IntermediateField.inclusion hLM (g p) *
                    (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M)))) →
          ∀ r : Fin f_M, g (r, s₀) = 0 ∨ 1 ≤ valL F L (g (r, s₀))) :=
by
  classical
  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hvalM_0, hvalM_1, hvalM_neg1, hvalM_neg, hvalM_mul, hvalM_inv, _, hvalM_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M
  obtain ⟨hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ := hresL_map
  obtain ⟨hresM_0, hresM_1, hresM_ring, hresM_ker, hresM_surj⟩ := hresM_map

  
  have hq_M : qL F M = (qL F L) ^ f_M := by
    unfold qL
    rw [hresDeg_LM, mul_comm f_M (resDeg F L), pow_mul]

  
  have hvalL_pow : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero =>
      rw [pow_zero, hvalL_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ, hvalL_mul (x ^ n) x (pow_ne_zero n hx) hx, ih, Nat.cast_add, Nat.cast_one,
        add_one_mul]

  have hValAlg_LM : ∀ x : L, valL F M (IntermediateField.inclusion hLM x) = (k : ℤ) * valL F L x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, map_zero, hvalM_0, hvalL_0, mul_zero]
    · have hto_eq : toExtendScalars F hLM (IntermediateField.inclusion hLM x) =
          algebraMap L (IntermediateField.extendScalars hLM) x := Subtype.ext rfl
      have hnorm_inc : normLM F hLM (IntermediateField.inclusion hLM x) = x ^ (k * f_M) := by
        change Algebra.norm L (toExtendScalars F hLM (IntermediateField.inclusion hLM x)) = x ^ (k * f_M)
        rw [hto_eq, Algebra.norm_algebraMap, hfinrank_LM]
      have h1 := hValNorm_LM (IntermediateField.inclusion hLM x)
      rw [hnorm_inc, hvalL_pow x (k * f_M) hx, Nat.cast_mul] at h1
      have hf_ne0 : (f_M : ℤ) ≠ 0 := by omega
      apply mul_left_cancel₀ hf_ne0
      linarith

  
  let PL (m : ℤ) (x : L) : Prop := x = 0 ∨ m ≤ valL F L x
  let PM (m : ℤ) (z : M) : Prop := z = 0 ∨ m ≤ valL F M z
  have hPL_zero : ∀ m : ℤ, PL m 0 := fun _ => Or.inl rfl
  have hPL_one : PL 0 1 := Or.inr (by rw [hvalL_1])
  have hPL_mono : ∀ {m₁ m₂ : ℤ} {x : L}, m₁ ≤ m₂ → PL m₂ x → PL m₁ x := by
    intro m₁ m₂ x hm hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hx)
  have hPL_neg : ∀ {m : ℤ} {x : L}, PL m x → PL m (-x) := by
    intro m x hx
    rcases hx with rfl | hx
    · rw [neg_zero]; exact Or.inl rfl
    · right; rw [hvalL_neg]; exact hx
  have hPL_add : ∀ {m : ℤ} {x y : L}, PL m x → PL m y → PL m (x + y) :=
    fun hx hy => hvalL_add _ _ _ hx hy
  have hPL_sub : ∀ {m : ℤ} {x y : L}, PL m x → PL m y → PL m (x - y) := by
    intro m x y hx hy
    rw [sub_eq_add_neg]
    exact hPL_add hx (hPL_neg hy)
  have hPL_mul : ∀ {m₁ m₂ : ℤ} {x y : L}, PL m₁ x → PL m₂ y → PL (m₁ + m₂) (x * y) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalL_mul x y hx0 hy0]
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        omega

  have hPM_zero : ∀ m : ℤ, PM m 0 := fun _ => Or.inl rfl
  have hPM_one : PM 0 1 := Or.inr (by rw [hvalM_1])
  have hPM_mono : ∀ {m₁ m₂ : ℤ} {z : M}, m₁ ≤ m₂ → PM m₂ z → PM m₁ z := by
    intro m₁ m₂ z hm hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hz)
  have hPM_neg : ∀ {m : ℤ} {z : M}, PM m z → PM m (-z) := by
    intro m z hz
    rcases hz with rfl | hz
    · rw [neg_zero]; exact Or.inl rfl
    · right; rw [hvalM_neg]; exact hz
  have hPM_add : ∀ {m : ℤ} {z₁ z₂ : M}, PM m z₁ → PM m z₂ → PM m (z₁ + z₂) :=
    fun hz₁ hz₂ => hvalM_add _ _ _ hz₁ hz₂
  have hPM_sub : ∀ {m : ℤ} {z₁ z₂ : M}, PM m z₁ → PM m z₂ → PM m (z₁ - z₂) := by
    intro m z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    exact hPM_add hz₁ (hPM_neg hz₂)
  have hPM_mul : ∀ {m₁ m₂ : ℤ} {z₁ z₂ : M}, PM m₁ z₁ → PM m₂ z₂ → PM (m₁ + m₂) (z₁ * z₂) := by
    intro m₁ m₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · left; rw [hz₁0, zero_mul]
    · by_cases hz₂0 : z₂ = 0
      · left; rw [hz₂0, mul_zero]
      · right
        rw [hvalM_mul z₁ z₂ hz₁0 hz₂0]
        have hz₁' := hz₁.resolve_left hz₁0
        have hz₂' := hz₂.resolve_left hz₂0
        omega

  have hresL_sub_mem1 : ∀ {x₁ x₂ : L}, PL 0 x₁ → PL 0 x₂ → resL x₁ = resL x₂ → PL 1 (x₁ - x₂) := by
    intro x₁ x₂ hx₁ hx₂ hres
    have hsub_int : PL 0 (x₁ - x₂) := hPL_sub hx₁ hx₂
    have hres_sub : resL (x₁ - x₂) = 0 := by
      rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ (hPL_neg hx₂)).1,
        (hresL_ring x₂ 0 hx₂ (hPL_zero 0)).2.2, hres, add_neg_cancel]
    exact (hresL_ker (x₁ - x₂) hsub_int).mp hres_sub

  have hresM_eq_of_mem1 : ∀ {z₁ z₂ : M}, PM 0 z₁ → PM 0 z₂ → PM 1 (z₁ - z₂) → resM z₁ = resM z₂ := by
    intro z₁ z₂ _ hz₂ h1
    have hsub0 : PM 0 (z₁ - z₂) := hPM_mono (by omega) h1
    have hres0 : resM (z₁ - z₂) = 0 := (hresM_ker (z₁ - z₂) hsub0).mpr h1
    have h_eq : z₁ = (z₁ - z₂) + z₂ := by ring
    rw [h_eq, (hresM_ring (z₁ - z₂) z₂ hsub0 hz₂).1, hres0, zero_add]

  let liftL : k_L → L := fun a => Classical.choose (hresL_surj a)
  have hliftL_int : ∀ a : k_L, PL 0 (liftL a) :=
    fun a => (Classical.choose_spec (hresL_surj a)).1
  have hliftL_res : ∀ a : k_L, resL (liftL a) = a :=
    fun a => (Classical.choose_spec (hresL_surj a)).2

  have hinc_int : ∀ {x : L}, PL 0 x → PM 0 (IntermediateField.inclusion hLM x) := by
    intro x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hValAlg_LM x]
      exact mul_nonneg (by omega) hx
  have hinc_mem1 : ∀ {x : L}, PL 1 x → PM 1 (IntermediateField.inclusion hLM x) := by
    intro x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hValAlg_LM x]
      nlinarith

  let ι_fun : k_L → k_M := fun a => resM (IntermediateField.inclusion hLM (liftL a))
  have hι_fun_spec : ∀ x : L, PL 0 x →
      resM (IntermediateField.inclusion hLM x) = ι_fun (resL x) := by
    intro x hx
    dsimp only [ι_fun]
    apply hresM_eq_of_mem1 (hinc_int hx) (hinc_int (hliftL_int (resL x)))
    rw [← map_sub]
    exact hinc_mem1 (hresL_sub_mem1 hx (hliftL_int (resL x)) (hliftL_res (resL x)).symm)

  let ι_LM : k_L →+* k_M :=
    { toFun := ι_fun
      map_zero' := by
        rw [← hresL_0, ← hι_fun_spec 0 (hPL_zero 0), map_zero, hresM_0]
      map_one' := by
        rw [← hresL_1, ← hι_fun_spec 1 hPL_one, map_one, hresM_1]
      map_add' := fun a₁ a₂ => by
        set x₁ := liftL a₁
        set x₂ := liftL a₂
        have hx₁ : PL 0 x₁ := hliftL_int a₁
        have hx₂ : PL 0 x₂ := hliftL_int a₂
        have hsum_res : a₁ + a₂ = resL (x₁ + x₂) := by
          rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res a₁, hliftL_res a₂]
        rw [hsum_res, ← hι_fun_spec (x₁ + x₂) (hPL_add hx₁ hx₂),
          ← hliftL_res a₁, ← hliftL_res a₂,
          ← hι_fun_spec x₁ hx₁, ← hι_fun_spec x₂ hx₂, map_add,
          (hresM_ring _ _ (hinc_int hx₁) (hinc_int hx₂)).1]
      map_mul' := fun a₁ a₂ => by
        set x₁ := liftL a₁
        set x₂ := liftL a₂
        have hx₁ : PL 0 x₁ := hliftL_int a₁
        have hx₂ : PL 0 x₂ := hliftL_int a₂
        have hmul_res : a₁ * a₂ = resL (x₁ * x₂) := by
          rw [(hresL_ring x₁ x₂ hx₁ hx₂).2.1, hliftL_res a₁, hliftL_res a₂]
        rw [hmul_res, ← hι_fun_spec (x₁ * x₂) (by simpa using hPL_mul hx₁ hx₂),
          ← hliftL_res a₁, ← hliftL_res a₂,
          ← hι_fun_spec x₁ hx₁, ← hι_fun_spec x₂ hx₂, map_mul,
          (hresM_ring _ _ (hinc_int hx₁) (hinc_int hx₂)).2.1] }

  let hAlg : Algebra k_L k_M := RingHom.toAlgebra ι_LM
  letI : Algebra k_L k_M := hAlg

  have hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resM (IntermediateField.inclusion hLM x) = algebraMap k_L k_M (resL x) :=
    fun x hx => hι_fun_spec x hx

  have hfinrank_res : Module.finrank k_L k_M = f_M := by
    have hcard_pow : Fintype.card k_M = (Fintype.card k_L) ^ (Module.finrank k_L k_M) :=
      Module.card_eq_pow_finrank
    have hqL_gt1 : 1 < qL F L := by
      rw [← hcard_kL]
      exact Fintype.one_lt_card
    rw [hcard_kM, hcard_kL, hq_M] at hcard_pow
    exact (Nat.pow_right_injective hqL_gt1 hcard_pow).symm

  
  have hval_ϖ_pow : ∀ n : ℕ, valL F M ((ϖ_M ^ n : Mˣ) : M) = (n : ℤ) := by
    intro n
    induction n with
    | zero =>
      rw [pow_zero, Units.val_one, hvalM_1, Nat.cast_zero]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hvalM_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_M, Nat.cast_add, Nat.cast_one]

  have hresM_sum_fin : ∀ (S : Finset (Fin f_M)) (f : Fin f_M → M),
      (∀ r ∈ S, PM 0 (f r)) →
      PM 0 (∑ r ∈ S, f r) ∧ resM (∑ r ∈ S, f r) = ∑ r ∈ S, resM (f r) := by
    intro S f hf
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, Finset.sum_empty, hresM_0]
      exact ⟨hPM_zero 0, rfl⟩
    | @insert a S ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      have ha_int := hf a (Finset.mem_insert_self a S)
      have hS := ih (fun r hr => hf r (Finset.mem_insert_of_mem hr))
      refine ⟨hPM_add ha_int hS.1, ?_⟩
      rw [(hresM_ring (f a) (∑ r ∈ S, f r) ha_int hS.1).1, hS.2]

  have hvalM_sum_ge : ∀ (S : Finset (Fin k)) (m : ℤ) (f : Fin k → M),
      (∀ s ∈ S, PM m (f s)) → PM m (∑ s ∈ S, f s) := by
    intro S m f hf
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty]
      exact hPM_zero m
    | @insert a S ha ih =>
      rw [Finset.sum_insert ha]
      exact hPM_add (hf a (Finset.mem_insert_self a S))
        (ih (fun s hs => hf s (Finset.mem_insert_of_mem hs)))

  have hvalM_add_strict : ∀ (x y : M),
      x ≠ 0 → PM (valL F M x + 1) y →
      x + y ≠ 0 ∧ valL F M (x + y) = valL F M x := by
    intro x y hx hy
    rcases hy with rfl | hy
    · rw [add_zero]
      exact ⟨hx, rfl⟩
    · have hxy_ne : x + y ≠ 0 := by
        intro h0
        have hy_eq : y = -x := eq_neg_of_add_eq_zero_right h0
        have hval_y : valL F M y = valL F M x := by rw [hy_eq, hvalM_neg]
        omega
      refine ⟨hxy_ne, ?_⟩
      have hge : valL F M x ≤ valL F M (x + y) := by
        have h1 := hPM_add (Or.inr (le_refl (valL F M x))) (Or.inr (by omega : valL F M x ≤ valL F M y))
        exact h1.resolve_left hxy_ne
      by_contra hne
      have hgt : valL F M x + 1 ≤ valL F M (x + y) := by omega
      have h2 := hPM_add (Or.inr hgt) (hPM_neg (Or.inr hy))
      have hxeq : (x + y) + (-y) = x := by ring
      rw [hxeq] at h2
      have hle : valL F M x + 1 ≤ valL F M x := h2.resolve_left hx
      omega

  refine ⟨hq_M, hValAlg_LM, hAlg, hfinrank_res, hres_alg, ?_⟩
  intro e u hu_int hu_res
  dsimp only

  
  have h_u_block : ∀ (c : Fin f_M → L), (∃ r₀ : Fin f_M, c r₀ ≠ 0) →
      ∃ r_star : Fin f_M,
        c r_star ≠ 0 ∧
        (∀ r : Fin f_M, c r ≠ 0 → valL F L (c r_star) ≤ valL F L (c r)) ∧
        (∑ r : Fin f_M, IntermediateField.inclusion hLM (c r) * u r) ≠ 0 ∧
        valL F M (∑ r : Fin f_M, IntermediateField.inclusion hLM (c r) * u r) =
          (k : ℤ) * valL F L (c r_star) := by
    intro c ⟨r₀, hr₀⟩
    let A : Finset (Fin f_M) := Finset.univ.filter (fun r => c r ≠ 0)
    have hA_ne : A.Nonempty := ⟨r₀, Finset.mem_filter.mpr ⟨Finset.mem_univ r₀, hr₀⟩⟩
    obtain ⟨r_star, hr_star_mem, hr_star_min⟩ :=
      Finset.exists_min_image A (fun r => valL F L (c r)) hA_ne
    have hc_star : c r_star ≠ 0 := (Finset.mem_filter.mp hr_star_mem).2
    have hmin_all : ∀ r : Fin f_M, c r ≠ 0 → valL F L (c r_star) ≤ valL F L (c r) :=
      fun r hr => hr_star_min r (Finset.mem_filter.mpr ⟨Finset.mem_univ r, hr⟩)
    let u_star : Lˣ := Units.mk0 (c r_star) hc_star
    let c_inv : L := ((u_star⁻¹ : Lˣ) : L)
    have hval_cinv : valL F L c_inv = - valL F L (c r_star) := hvalL_inv u_star
    let d : Fin f_M → L := fun r => c_inv * c r
    have hd_int : ∀ r : Fin f_M, PL 0 (d r) := by
      intro r
      by_cases hcr : c r = 0
      · left; dsimp [d]; rw [hcr, mul_zero]
      · right
        dsimp [d]
        rw [hvalL_mul c_inv (c r) (Units.ne_zero _) hcr, hval_cinv]
        have hle := hmin_all r hcr
        omega
    have hd_star : d r_star = 1 := by
      dsimp [d, c_inv, u_star]
      exact inv_mul_cancel₀ hc_star
    have hterm_int : ∀ r : Fin f_M, PM 0 (IntermediateField.inclusion hLM (d r) * u r) := by
      intro r
      rw [← zero_add (0 : ℤ)]
      exact hPM_mul (hinc_int (hd_int r)) (hu_int r)
    let S_d : M := ∑ r : Fin f_M, IntermediateField.inclusion hLM (d r) * u r
    have hSd_sum := hresM_sum_fin Finset.univ
      (fun r => IntermediateField.inclusion hLM (d r) * u r) (fun r _ => hterm_int r)
    have hSd_int : PM 0 S_d := hSd_sum.1
    have hSd_res : resM S_d = ∑ r : Fin f_M, resL (d r) • e r := by
      rw [hSd_sum.2]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [(hresM_ring (IntermediateField.inclusion hLM (d r)) (u r)
            (hinc_int (hd_int r)) (hu_int r)).2.1,
        hres_alg (d r) (hd_int r), hu_res r, ← Algebra.smul_def]
    have hSd_res_ne : resM S_d ≠ 0 := by
      intro hres0
      rw [hSd_res] at hres0
      have hd_zero := Fintype.linearIndependent_iff.mp e.linearIndependent
        (fun r => resL (d r)) hres0 r_star
      rw [hd_star, hresL_1] at hd_zero
      exact one_ne_zero hd_zero
    have hSd_not_mem1 : ¬ PM 1 S_d := by
      intro h1
      exact hSd_res_ne ((hresM_ker S_d hSd_int).mpr h1)
    have hSd_ne0 : S_d ≠ 0 := fun h0 => hSd_not_mem1 (Or.inl h0)
    have hSd_val0 : valL F M S_d = 0 := by
      have hge0 : 0 ≤ valL F M S_d := hSd_int.resolve_left hSd_ne0
      have hlt1 : ¬ (1 ≤ valL F M S_d) := fun hge1 => hSd_not_mem1 (Or.inr hge1)
      omega
    have hsum_eq : (∑ r : Fin f_M, IntermediateField.inclusion hLM (c r) * u r) =
        IntermediateField.inclusion hLM (c r_star) * S_d := by
      dsimp [S_d]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      have hmul_inv : c r_star * c_inv = 1 := mul_inv_cancel₀ hc_star
      have hcd : c r_star * d r = c r := by
        dsimp only [d]
        rw [← mul_assoc, hmul_inv, one_mul]
      rw [← mul_assoc, ← map_mul, hcd]
    have hinc_c_ne0 : IntermediateField.inclusion hLM (c r_star) ≠ 0 :=
      (map_ne_zero _).mpr hc_star
    have hsum_ne0 : (∑ r : Fin f_M, IntermediateField.inclusion hLM (c r) * u r) ≠ 0 := by
      rw [hsum_eq]
      exact mul_ne_zero hinc_c_ne0 hSd_ne0
    have hsum_val : valL F M (∑ r : Fin f_M, IntermediateField.inclusion hLM (c r) * u r) =
        (k : ℤ) * valL F L (c r_star) := by
      rw [hsum_eq, hvalM_mul _ _ hinc_c_ne0 hSd_ne0, hValAlg_LM (c r_star), hSd_val0, add_zero]
    exact ⟨r_star, hc_star, hmin_all, hsum_ne0, hsum_val⟩

  
  let S_row (g : Fin f_M × Fin k → L) (s : Fin k) : M :=
    ∑ r : Fin f_M, IntermediateField.inclusion hLM (g (r, s)) * u r
  let T_layer (g : Fin f_M × Fin k → L) (s : Fin k) : M :=
    S_row g s * ((ϖ_M ^ (s : ℕ) : Mˣ) : M)

  have h_sum_decomp : ∀ (g : Fin f_M × Fin k → L),
      (∑ p : Fin f_M × Fin k,
        IntermediateField.inclusion hLM (g p) * (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M))) =
      ∑ s : Fin k, T_layer g s := by
    intro g
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    refine Finset.sum_congr rfl fun s _ => ?_
    dsimp [T_layer, S_row]
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [mul_assoc]

  have hT_zero_of_all_zero : ∀ (g : Fin f_M × Fin k → L) (s : Fin k),
      (∀ r : Fin f_M, g (r, s) = 0) → T_layer g s = 0 := by
    intro g s hall
    have hS0 : S_row g s = 0 := by
      dsimp [S_row]
      refine Finset.sum_eq_zero fun r _ => ?_
      rw [hall r, map_zero, zero_mul]
    dsimp [T_layer]
    rw [hS0, zero_mul]

  have hT_of_exists_ne : ∀ (g : Fin f_M × Fin k → L) (s : Fin k),
      (∃ r : Fin f_M, g (r, s) ≠ 0) →
      ∃ r_s : Fin f_M,
        g (r_s, s) ≠ 0 ∧
        (∀ r : Fin f_M, g (r, s) ≠ 0 → valL F L (g (r_s, s)) ≤ valL F L (g (r, s))) ∧
        T_layer g s ≠ 0 ∧
        valL F M (T_layer g s) = ((s : ℕ) : ℤ) + (k : ℤ) * valL F L (g (r_s, s)) := by
    intro g s hex
    obtain ⟨r_s, hr_s_ne, hr_s_min, hS_ne, hS_val⟩ := h_u_block (fun r => g (r, s)) hex
    have hϖ_ne : ((ϖ_M ^ (s : ℕ) : Mˣ) : M) ≠ 0 := Units.ne_zero _
    have hT_ne : T_layer g s ≠ 0 := mul_ne_zero hS_ne hϖ_ne
    have hT_val : valL F M (T_layer g s) = ((s : ℕ) : ℤ) + (k : ℤ) * valL F L (g (r_s, s)) := by
      dsimp only [T_layer]
      rw [hvalM_mul _ _ hS_ne hϖ_ne, hS_val, hval_ϖ_pow (s : ℕ), add_comm]
    exact ⟨r_s, hr_s_ne, hr_s_min, hT_ne, hT_val⟩

  have hT_val_mod : ∀ (g : Fin f_M × Fin k → L) (s : Fin k),
      T_layer g s ≠ 0 → valL F M (T_layer g s) % (k : ℤ) = ((s : ℕ) : ℤ) := by
    intro g s hT_ne
    have hex : ∃ r : Fin f_M, g (r, s) ≠ 0 := by
      by_contra hall
      push_neg at hall
      exact hT_ne (hT_zero_of_all_zero g s hall)
    obtain ⟨r_s, _, _, _, hT_val⟩ := hT_of_exists_ne g s hex
    rw [hT_val, Int.add_mul_emod_self_left,
      Int.emod_eq_of_lt (Nat.cast_nonneg _) (by exact_mod_cast s.2)]

  have hT_val_inj : ∀ (g : Fin f_M × Fin k → L) (s₁ s₂ : Fin k),
      T_layer g s₁ ≠ 0 → T_layer g s₂ ≠ 0 → s₁ ≠ s₂ →
      valL F M (T_layer g s₁) ≠ valL F M (T_layer g s₂) := by
    intro g s₁ s₂ h1 h2 hne hval_eq
    have hmod_eq : valL F M (T_layer g s₁) % (k : ℤ) = valL F M (T_layer g s₂) % (k : ℤ) := by
      rw [hval_eq]
    rw [hT_val_mod g s₁ h1, hT_val_mod g s₂ h2] at hmod_eq
    have hnat_eq : (s₁ : ℕ) = (s₂ : ℕ) := by exact_mod_cast hmod_eq
    exact hne (Fin.ext hnat_eq)

  have h_layer_min_val : ∀ (g : Fin f_M × Fin k → L) (s₀ : Fin k),
      T_layer g s₀ ≠ 0 →
      (∑ s : Fin k, T_layer g s) ≠ 0 ∧
      valL F M (∑ s : Fin k, T_layer g s) ≤ valL F M (T_layer g s₀) := by
    intro g s₀ hs₀_ne
    let J_nz : Finset (Fin k) := Finset.univ.filter (fun s => T_layer g s ≠ 0)
    have hs₀_mem : s₀ ∈ J_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ s₀, hs₀_ne⟩
    obtain ⟨s_star, hs_star_mem, hs_star_min⟩ :=
      Finset.exists_min_image J_nz (fun s => valL F M (T_layer g s)) ⟨s₀, hs₀_mem⟩
    have hs_star_ne : T_layer g s_star ≠ 0 := (Finset.mem_filter.mp hs_star_mem).2
    have herase : ∀ s ∈ Finset.univ.erase s_star,
        PM (valL F M (T_layer g s_star) + 1) (T_layer g s) := by
      intro s hs
      have hne_s : s ≠ s_star := Finset.ne_of_mem_erase hs
      by_cases hTs : T_layer g s = 0
      · exact Or.inl hTs
      · right
        have hs_mem : s ∈ J_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ s, hTs⟩
        have hle := hs_star_min s hs_mem
        have hval_ne := hT_val_inj g s_star s hs_star_ne hTs hne_s.symm
        omega
    have hrest_ge := hvalM_sum_ge (Finset.univ.erase s_star)
      (valL F M (T_layer g s_star) + 1) (T_layer g) herase
    have hsplit : (∑ s : Fin k, T_layer g s) =
        T_layer g s_star + ∑ s ∈ Finset.univ.erase s_star, T_layer g s :=
      (Finset.add_sum_erase Finset.univ (T_layer g) (Finset.mem_univ s_star)).symm
    obtain ⟨hsum_ne, hsum_val⟩ :=
      hvalM_add_strict (T_layer g s_star) (∑ s ∈ Finset.univ.erase s_star, T_layer g s)
        hs_star_ne hrest_ge
    rw [← hsplit] at hsum_ne hsum_val
    refine ⟨hsum_ne, ?_⟩
    rw [hsum_val]
    exact hs_star_min s₀ hs₀_mem

  refine ⟨?_, ?_⟩
  · 
    rw [Fintype.linearIndependent_iff]
    intro g hg_sum p₀
    have h_smul_to : ∀ (p : Fin f_M × Fin k),
        g p • toExtendScalars F hLM (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M)) =
          toExtendScalars F hLM
            (IntermediateField.inclusion hLM (g p) *
              (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M))) :=
      fun _ => Subtype.ext rfl
    have hg_sum' :
        toExtendScalars F hLM
          (∑ p : Fin f_M × Fin k,
            IntermediateField.inclusion hLM (g p) *
              (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M))) = 0 := by
      rw [map_sum]
      simpa only [h_smul_to] using hg_sum
    have h_sum_M_zero :
        (∑ p : Fin f_M × Fin k,
          IntermediateField.inclusion hLM (g p) *
            (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M))) = 0 :=
      Subtype.ext (congrArg Subtype.val hg_sum')
    rw [h_sum_decomp g] at h_sum_M_zero
    by_contra hp₀_ne
    have hex_p₀ : ∃ r : Fin f_M, g (r, p₀.2) ≠ 0 := ⟨p₀.1, hp₀_ne⟩
    obtain ⟨_, _, _, hT_p₀_ne, _⟩ := hT_of_exists_ne g p₀.2 hex_p₀
    obtain ⟨hsum_ne, _⟩ := h_layer_min_val g p₀.2 hT_p₀_ne
    exact hsum_ne h_sum_M_zero
  · 
    intro g s₀ h_bound r
    rw [h_sum_decomp g] at h_bound
    by_cases hgr : g (r, s₀) = 0
    · exact Or.inl hgr
    · right
      obtain ⟨r_s, _, hr_s_min, hT_s₀_ne, hT_s₀_val⟩ := hT_of_exists_ne g s₀ ⟨r, hgr⟩
      obtain ⟨hsum_ne, hsum_le⟩ := h_layer_min_val g s₀ hT_s₀_ne
      have hge_s₀ : ((s₀ : ℕ) + 1 : ℤ) ≤ valL F M (∑ s : Fin k, T_layer g s) :=
        h_bound.resolve_left hsum_ne
      have hineq : ((s₀ : ℕ) + 1 : ℤ) ≤ ((s₀ : ℕ) : ℤ) + (k : ℤ) * valL F L (g (r_s, s₀)) := by
        rw [← hT_s₀_val]
        exact le_trans hge_s₀ hsum_le
      have hkm_ge1 : (1 : ℤ) ≤ (k : ℤ) * valL F L (g (r_s, s₀)) := by omega
      have hm_ge1 : (1 : ℤ) ≤ valL F L (g (r_s, s₀)) := by
        by_contra hlt
        push_neg at hlt
        have hmul_le0 : (k : ℤ) * valL F L (g (r_s, s₀)) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) (by omega)
        omega
      exact le_trans hm_ge1 (hr_s_min r hgr)

theorem ld_ch14_local_to_residue_trace_and_stat_gauss (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M]
    (hLM : L ≤ M)
    (ψ : AddChar L (Ω F))
    (hψM : IsAdmissibleChar F M (traceChar F hLM ψ))
    (k f_M : ℕ) (hk_ge1 : 1 ≤ k) (hf_M_ge1 : 1 ≤ f_M)
    (hfinrank_LM : Module.finrank L (IntermediateField.extendScalars hLM) = k * f_M)
    (hq_M : qL F M = (qL F L) ^ f_M)
    (hValAlg_LM : ∀ x : L, valL F M (IntermediateField.inclusion hLM x) = (k : ℤ) * valL F L x)
    (hnM : condExpChar F M (traceChar F hLM ψ) = (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (ϖ_M : Mˣ) (hϖ_M : valL F M (ϖ_M : M) = 1)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (resL : L → k_L) (resM : M → k_M)
    (hresL_map : IsResidueFieldMap F L k_L resL)
    (hresM_map : IsResidueFieldMap F M k_M resM)
    (hfinrank_res : Module.finrank k_L k_M = f_M)
    (hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resM (IntermediateField.inclusion hLM x) = algebraMap k_L k_M (resL x))
    (hBasis_val : ∀ (e : Module.Basis (Fin f_M) k_L k_M) (u : Fin f_M → M),
      (∀ r : Fin f_M, u r = 0 ∨ 0 ≤ valL F M (u r)) →
      (∀ r : Fin f_M, resM (u r) = e r) →
      let w : Fin f_M × Fin k → IntermediateField.extendScalars hLM :=
        fun p => toExtendScalars F hLM (u p.1 * ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M))
      LinearIndependent L w ∧
      ∀ (g : Fin f_M × Fin k → L) (s₀ : Fin k),
        ((∑ p : Fin f_M × Fin k,
            IntermediateField.inclusion hLM (g p) *
