  have hnorm_trans : ∀ w : K,
      normLM F hM_CK w = normLM F hMC_M1 (normLM F hM1_K w) := by
    intro w
    rw [← hnorm_eq_inclusion hM_CK w,
        ← hnorm_eq_inclusion hM1_K w,
        ← hnorm_eq_inclusion hMC_M1]
    exact hnorm_trans_aux M_C M_1 K
      (IntermediateField.inclusion hMC_M1).toAlgebra
      (IntermediateField.inclusion hM1_K).toAlgebra
      (IntermediateField.inclusion hM_CK).toAlgebra
      (fun _ => rfl) w
  have hnorm_units_trans : ∀ w : Kˣ,
      Units.map (normLM F hM_CK) w =
        Units.map (normLM F hMC_M1) (Units.map (normLM F hM1_K) w) := by
    intro w
    apply Units.ext
    exact hnorm_trans (w : K)
  have hinc_trans : ∀ z : M_C,
      IntermediateField.inclusion hM_CK z =
        IntermediateField.inclusion hM1_K (IntermediateField.inclusion hMC_M1 z) :=
    fun _ => rfl
  have htr_smul_aux : ∀ (L₀ M₀ : Type u) [Field L₀] [Field M₀] (algLM : Algebra L₀ M₀)
      (z₀ : L₀) (w₀ : M₀),
      @Algebra.trace L₀ M₀ _ _ algLM (@algebraMap L₀ M₀ _ _ algLM z₀ * w₀) =
        z₀ * @Algebra.trace L₀ M₀ _ _ algLM w₀ := by
    intro L₀ M₀ _ _ algLM z₀ w₀
    letI : Algebra L₀ M₀ := algLM
    rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  have htr_smul_M1 : ∀ (z : M_C) (w : M_1),
      traceLM F hMC_M1 (IntermediateField.inclusion hMC_M1 z * w) =
        z * traceLM F hMC_M1 w := by
    intro z w
    rw [← htrace_eq_inclusion hMC_M1, ← htrace_eq_inclusion hMC_M1]
    exact htr_smul_aux M_C M_1 (IntermediateField.inclusion hMC_M1).toAlgebra z w

  let q₁ : ℕ := (p F) ^ r
  have hq1_pos : 1 ≤ q₁ := Nat.one_le_pow r (p F) hp_prime.pos
  have hq_split : q = q₁ * (p F) := pow_succ (p F) r

  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · 
    intro m hm w hw
    rw [hnorm_units_trans w]
    exact hnorm_le_M1MC m hm _ (hnorm_le_KM1 m hm w hw)
  · 
    intro m hm u hu
    obtain ⟨w₁, hw₁, he₀⟩ := hnorm_surj_lt_M1MC m hm u hu
    obtain ⟨w, hw, he₁⟩ := hnorm_surj_lt_KM1 m hm w₁ hw₁
    refine ⟨w, hw, ?_⟩
    have hm1_le : m + 1 ≤ t + 1 := by omega
    have he₂ : Units.map (normLM F hMC_M1) ((Units.map (normLM F hM1_K) w) * w₁⁻¹) ∈
