        rw [hsum_u, ← hactK₁_trace ((Δ : K₁) ^ p), ← hactK₁_trace (Δ : K₁),
            Finset.sum_const, Finset.card_univ, hcard_GK₁,
            nsmul_eq_mul, map_sub, map_sub, map_mul, map_natCast]
      exact (IntermediateField.inclusion hE'K₁).injective h_inc
    have h_id_pow :
        traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a =
          traceLM F hE'K₁ u + traceLM F hE'K₁ (Δ : K₁) := by
      rw [htr_u_eq]
      ring
    have h1_mem : 1 ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
    have htr_Δ :
        traceLM F hE'K₁ (Δ : K₁) = 0 ∨
          ((3 * m₁ : ℕ) : ℤ) ≤ valL F E' (traceLM F hE'K₁ (Δ : K₁)) := by
      simpa [pow_one] using hΔ_tr_low 1 h1_mem
    rw [h_id_pow]
    exact valE'_add_ge htr_u htr_Δ
  exact ⟨hΔ_tr_low, hΔ_tr_top, hΔ_tr_pow⟩

theorem ld_wild_odd_tot_ram_as_charpoly_and_power_traces (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t₁ m₁ : ℕ) (ht₁_ge1 : 1 ≤ t₁) (hm₁_gt : t₁ < m₁)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y)
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * ((t₁ + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (G_K₁ : Type u) [Group G_K₁] [Fintype G_K₁]
    (act_K₁ : G_K₁ → K₁ → K₁) (y₁_K₁ : K₁)
    (hcard_GK₁ : Fintype.card G_K₁ = p)
    (hactK₁_one : ∀ w : K₁, act_K₁ 1 w = w)
    (hactK₁_mul : ∀ (σ τ : G_K₁) (w : K₁), act_K₁ (σ * τ) w = act_K₁ σ (act_K₁ τ w))
    (hactK₁_ring : ∀ σ : G_K₁,
      act_K₁ σ 0 = 0 ∧ act_K₁ σ 1 = 1 ∧
      (∀ w₁ w₂ : K₁,
        act_K₁ σ (w₁ + w₂) = act_K₁ σ w₁ + act_K₁ σ w₂ ∧
        act_K₁ σ (w₁ * w₂) = act_K₁ σ w₁ * act_K₁ σ w₂ ∧
        act_K₁ σ (-w₁) = -act_K₁ σ w₁))
    (hactK₁_incl : ∀ (σ : G_K₁) (y : E'),
      act_K₁ σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y)
    (hactK₁_val : ∀ (σ : G_K₁) (w : K₁), valL F K₁ (act_K₁ σ w) = valL F K₁ w)
    (hactK₁_trace : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G_K₁, act_K₁ σ w)
    (hactK₁_norm : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G_K₁, act_K₁ σ w)
    (hy₁K₁_tr : traceLM F hE'K₁ y₁_K₁ = 1)
    (Δ : K₁ˣ) (hΔ_val : valL F K₁ (Δ : K₁) = -(t₁ : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin p → E',
      w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)) :
    (∀ a_target : E',
      ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a_target = 0 ∨
        ((4 * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a_target)) →
      (normLM F hE'K₁ (Δ : K₁) - a_target = 0 ∨
        ((3 * m₁ : ℕ) : ℤ) ≤ valL F E' (normLM F hE'K₁ (Δ : K₁) - a_target)) ∧
      ((Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))) ∧
    (((Δ : K₁) ^ p - (Δ : K₁) -
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
      ((4 * p * m₁ : ℕ) : ℤ) ≤
        valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)))) →
      let a := normLM F hE'K₁ (Δ : K₁)
      (∀ j ∈ Finset.Icc 1 (p - 2),
        traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
          ((3 * m₁ : ℕ) : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j))) ∧
      (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E'))) ∧
      (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a = 0 ∨
        ((3 * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a))) :=
by
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  refine ⟨fun a_target hΔ_as_target => ?_, fun hΔ_as => ?_⟩
  · obtain ⟨hnorm_congr, hΔ_as_norm, _⟩ :=
      ld_wild_odd_tot_ram_as_charpoly_remainder_and_norm F E' K₁ hE'K₁
        p hPrime hp_odd t₁ m₁ ht₁_ge1 hm₁_gt
        hvalE'_props hvalK₁_props hval_E'K₁
        G_K₁ act_K₁ y₁_K₁ hcard_GK₁ hactK₁_one hactK₁_mul hactK₁_ring
        hactK₁_incl hactK₁_trace hactK₁_norm hy₁K₁_tr
        Δ hΔ_val hΔ_basis a_target hΔ_as_target
    exact ⟨hnorm_congr, hΔ_as_norm⟩
  · obtain ⟨_, _, r, hr_val, hPΔ_eq⟩ :=
      ld_wild_odd_tot_ram_as_charpoly_remainder_and_norm F E' K₁ hE'K₁
        p hPrime hp_odd t₁ m₁ ht₁_ge1 hm₁_gt
        hvalE'_props hvalK₁_props hval_E'K₁
        G_K₁ act_K₁ y₁_K₁ hcard_GK₁ hactK₁_one hactK₁_mul hactK₁_ring
        hactK₁_incl hactK₁_trace hactK₁_norm hy₁K₁_tr
        Δ hΔ_val hΔ_basis (normLM F hE'K₁ (Δ : K₁)) hΔ_as
    exact ld_wild_odd_tot_ram_as_formal_deriv_power_traces F E' K₁ hE'K₁
      p hPrime hp_odd t₁ m₁ ht₁_ge1 hm₁_gt
      hvalE'_props hvalK₁_props hval_E'K₁ htr_E'K₁
      G_K₁ act_K₁ hcard_GK₁ hactK₁_ring hactK₁_incl hactK₁_val hactK₁_trace
      Δ hΔ_val (normLM F hE'K₁ (Δ : K₁)) r hΔ_as hr_val hPΔ_eq

theorem ld_wild_odd_bicyclic_galois_lift_and_jump_shift_on_M1 (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p)
    (bM₁' : ℕ) (hbM₁'_ge2 : 2 ≤ bM₁')
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) = (p : ℤ) * valL F L x)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z)
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (ϖ_M₁' : M₁'ˣ) (hϖ_M₁' : valL F M₁' (ϖ_M₁' : M₁') = 1)
    (hBasis_M₁' : ∀ z : M₁',
      ∃ c : Fin p → L,
        z = ∑ i : Fin p,
          IntermediateField.inclusion hLM₁' (c i) * ((ϖ_M₁' : M₁') ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (z = 0 ∨ m ≤ valL F M₁' z) ↔
            ∀ i : Fin p,
              c i = 0 ∨ m ≤ (p : ℤ) * valL F L (c i) + (i : ℤ))
    (G_M₁' : Type u) [Group G_M₁'] [Fintype G_M₁'] (act_M₁' : G_M₁' → M₁' → M₁')
    (hcard_GM₁' : Fintype.card G_M₁' = p)
    (hactM₁'_one : ∀ z : M₁', act_M₁' 1 z = z)
    (hactM₁'_mul : ∀ (σ τ : G_M₁') (z : M₁'), act_M₁' (σ * τ) z = act_M₁' σ (act_M₁' τ z))
    (hactM₁'_ring : ∀ σ : G_M₁',
      act_M₁' σ 0 = 0 ∧ act_M₁' σ 1 = 1 ∧
      (∀ z₁ z₂ : M₁',
        act_M₁' σ (z₁ + z₂) = act_M₁' σ z₁ + act_M₁' σ z₂ ∧
        act_M₁' σ (z₁ * z₂) = act_M₁' σ z₁ * act_M₁' σ z₂ ∧
        act_M₁' σ (-z₁) = -act_M₁' σ z₁))
    (hactM₁'_incl : ∀ (σ : G_M₁') (x : L),
      act_M₁' σ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hjump_M₁' : ∀ τ : G_M₁', τ ≠ 1 →
      (ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁') ≠ 0 ∧
      valL F M₁' ((ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁')) = (bM₁' : ℤ)) :
    ∃ (τ : M₁' ≃ₐ[F] M₁') (τ_lift : K₁ ≃ₐ[F] K₁),
      (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hE'K₁ y) ∧
      (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
      (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
      (∀ θ : M₁', θ ≠ 0 →
        τ θ - θ = 0 ∨ valL F M₁' θ + ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (τ θ - θ)) ∧
      (τ (ϖ_M₁' : M₁') - (ϖ_M₁' : M₁') ≠ 0 ∧
        valL F M₁' (τ (ϖ_M₁' : M₁') - (ϖ_M₁' : M₁')) = ((bM₁' - 1 : ℕ) : ℤ) + 1) :=
by
  classical
  
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hcard_gt1 : 1 < Fintype.card G_M₁' := by
    rw [hcard_GM₁']
    exact hp_gt1
  obtain ⟨σ₀, hσ₀_ne1⟩ := @Fintype.exists_ne_of_one_lt_card G_M₁' _ hcard_gt1 1

  
  let τ : M₁' ≃ₐ[F] M₁' :=
    { toFun := act_M₁' σ₀
      invFun := act_M₁' σ₀⁻¹
      left_inv := fun z => by rw [← hactM₁'_mul, inv_mul_cancel, hactM₁'_one]
      right_inv := fun z => by rw [← hactM₁'_mul, mul_inv_cancel, hactM₁'_one]
      map_mul' := fun z₁ z₂ => ((hactM₁'_ring σ₀).2.2 z₁ z₂).2.1
      map_add' := fun z₁ z₂ => ((hactM₁'_ring σ₀).2.2 z₁ z₂).1
      commutes' := fun a => by
        rw [← (IntermediateField.inclusion hLM₁').commutes a]
        exact hactM₁'_incl σ₀ (algebraMap F L a) }
  have hτ_apply : ∀ z : M₁', τ z = act_M₁' σ₀ z := fun _ => rfl
  have hτ_incl : ∀ x : L,
      τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x :=
    hactM₁'_incl σ₀
  obtain ⟨τ_lift, hτ_E', hτ_M₁', hτ_valK₁, _⟩ := hGalLift τ hτ_incl

  have hτ_valM₁' : ∀ z : M₁', valL F M₁' (τ z) = valL F M₁' z := by
    intro z
    have h1 : valL F K₁ (IntermediateField.inclusion hM₁'K₁ (τ z)) =
        (p : ℤ) * valL F M₁' (τ z) := hval_M₁'K₁ (τ z)
    have h2 : valL F K₁ (IntermediateField.inclusion hM₁'K₁ (τ z)) =
        (p : ℤ) * valL F M₁' z := by
      rw [← hτ_M₁' z, hτ_valK₁, hval_M₁'K₁ z]
    have h3 : (p : ℤ) * valL F M₁' (τ z) = (p : ℤ) * valL F M₁' z :=
      h1.symm.trans h2
    have hp_z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
    nlinarith

  
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul,
    hvalM₁'_inv, hvalM₁'_surj, hvalM₁'_add, _⟩ := hvalM₁'_props
  set π : M₁' := (ϖ_M₁' : M₁')
  set t₁ : ℕ := bM₁' - 1
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_M₁'
  have hbM₁'_eq : (bM₁' : ℤ) = (t₁ : ℤ) + 1 := by
    dsimp [t₁]
    omega

  have hjump₀ := hjump_M₁' σ₀ hσ₀_ne1
  have hϖ_jump : τ π - π ≠ 0 ∧ valL F M₁' (τ π - π) = (t₁ : ℤ) + 1 := by
    have hneg : τ π - π = -(π - act_M₁' σ₀ π) := by
      change act_M₁' σ₀ π - π = -(π - act_M₁' σ₀ π)
      ring
    refine ⟨?_, ?_⟩
    · rw [hneg]
      exact neg_ne_zero.mpr hjump₀.1
    · rw [hneg, hvalM₁'_neg, hjump₀.2, hbM₁'_eq]

  have hτ_pi_diff : τ π - π = 0 ∨ (t₁ : ℤ) + 1 ≤ valL F M₁' (τ π - π) :=
    Or.inr (by rw [hϖ_jump.2])

  have hval_pi_pow : ∀ k : ℕ, π ^ k ≠ 0 ∧ valL F M₁' (π ^ k) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      refine ⟨by simp, ?_⟩
      rw [pow_zero, Nat.cast_zero, hvalM₁'_1]
    | succ k ih =>
      refine ⟨pow_ne_zero (k + 1) hπ_ne0, ?_⟩
      rw [pow_succ, hvalM₁'_mul (π ^ k) π ih.1 hπ_ne0, ih.2, hϖ_M₁']
      push_cast
      ring

  have hval_mul_ge_M₁' : ∀ (k₁ k₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F M₁' x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F M₁' y := hy.resolve_left hy0
        rw [hvalM₁'_mul x y hx0 hy0]
        omega

  have hval_finset_sum_M₁' : ∀ {α : Type} (S : Finset α) (f : α → M₁') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M₁' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M₁' (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hvalM₁'_add k (f a) (∑ i ∈ s, f i) ha_val hs_val

  
  have hτ_pi_pow_diff : ∀ n : ℕ, 1 ≤ n →
      (τ π) ^ n - π ^ n = 0 ∨
        (n : ℤ) + (t₁ : ℤ) ≤ valL F M₁' ((τ π) ^ n - π ^ n) := by
    intro n
    induction n with
    | zero =>
      intro h
      omega
    | succ n ih =>
      intro _
      by_cases hn0 : n = 0
      · subst hn0
        simpa [pow_one, add_comm] using hτ_pi_diff
      · have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
        have h_id : (τ π) ^ (n + 1) - π ^ (n + 1) =
            ((τ π) ^ n - π ^ n) * τ π + π ^ n * (τ π - π) := by
          rw [pow_succ (τ π) n, pow_succ π n]
          ring
        have hτπ_val : τ π = 0 ∨ (1 : ℤ) ≤ valL F M₁' (τ π) :=
          Or.inr (by rw [hτ_valM₁' π, hϖ_M₁'])
        have hπn_val : π ^ n = 0 ∨ (n : ℤ) ≤ valL F M₁' (π ^ n) :=
          Or.inr (by rw [(hval_pi_pow n).2])
        have ht1 := hval_mul_ge_M₁' ((n : ℤ) + (t₁ : ℤ)) 1
          ((τ π) ^ n - π ^ n) (τ π) (ih hn1) hτπ_val
        have ht2 := hval_mul_ge_M₁' (n : ℤ) ((t₁ : ℤ) + 1)
          (π ^ n) (τ π - π) hπn_val hτ_pi_diff
        have ht1' : ((τ π) ^ n - π ^ n) * τ π = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t₁ : ℤ) ≤
              valL F M₁' (((τ π) ^ n - π ^ n) * τ π) := by
          rcases ht1 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        have ht2' : π ^ n * (τ π - π) = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t₁ : ℤ) ≤
              valL F M₁' (π ^ n * (τ π - π)) := by
          rcases ht2 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        rw [h_id]
        exact hvalM₁'_add (((n + 1 : ℕ) : ℤ) + (t₁ : ℤ)) _ _ ht1' ht2'

  have hτ_shift_M₁' : ∀ θ : M₁', θ ≠ 0 →
      τ θ - θ = 0 ∨ valL F M₁' θ + (t₁ : ℤ) ≤ valL F M₁' (τ θ - θ) := by
    intro θ _
    set m : ℤ := valL F M₁' θ
    obtain ⟨c, hθ_eq, hθ_iff⟩ := hBasis_M₁' θ
    have hc_bound := (hθ_iff m).mp (Or.inr le_rfl)
    have hτ_θ_sub : τ θ - θ =
        ∑ i : Fin p, IntermediateField.inclusion hLM₁' (c i) *
          ((τ π) ^ (i : ℕ) - π ^ (i : ℕ)) := by
      conv_lhs => rw [hθ_eq]
      rw [map_sum τ, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul τ, map_pow τ, hτ_incl (c i), ← mul_sub]
    rw [hτ_θ_sub]
    apply hval_finset_sum_M₁' Finset.univ _ (m + (t₁ : ℤ))
    intro i _
    by_cases hi0 : (i : ℕ) = 0
    · left
      rw [hi0, pow_zero, pow_zero, sub_self, mul_zero]
    · have hi1 : 1 ≤ (i : ℕ) := Nat.one_le_iff_ne_zero.mpr hi0
      rcases hc_bound i with hci0 | hci_ge
      · left
        rw [hci0, map_zero, zero_mul]
      · have hinc_val : IntermediateField.inclusion hLM₁' (c i) = 0 ∨
            (p : ℤ) * valL F L (c i) ≤
              valL F M₁' (IntermediateField.inclusion hLM₁' (c i)) :=
          Or.inr (by rw [hval_LM₁' (c i)])
        have hdiff_val := hτ_pi_pow_diff (i : ℕ) hi1
        have hmul := hval_mul_ge_M₁' ((p : ℤ) * valL F L (c i)) (((i : ℕ) : ℤ) + (t₁ : ℤ))
          (IntermediateField.inclusion hLM₁' (c i))
          ((τ π) ^ (i : ℕ) - π ^ (i : ℕ)) hinc_val hdiff_val
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          change m ≤ (p : ℤ) * valL F L (c i) + ((i : ℕ) : ℤ) at hci_ge
          omega

  exact ⟨τ, τ_lift, hτ_E', hτ_M₁', hτ_valK₁, hτ_shift_M₁', hϖ_jump⟩

theorem ld_wild_odd_bicyclic_as_aut_shift_unit_and_rem_bound (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t₁ t₂ : ℕ) (ht₁_ge1 : 1 ≤ t₁) (ht_le : t₁ ≤ t₂) (ht₁_ndvd : ¬ (p ∣ t₁))
    (hp_valK₁ : ((p : ℕ) : K₁) = 0 ∨
      ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z)
    (τ : M₁' ≃ₐ[F] M₁') (τ_lift : K₁ ≃ₐ[F] K₁)
    (hτ_E' : ∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
      IntermediateField.inclusion hE'K₁ y)
    (hτ_M₁' : ∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
      IntermediateField.inclusion hM₁'K₁ (τ z))
    (hτ_valK₁ : ∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w)
    (z₀ : M₁') (hz₀_val : valL F M₁' z₀ = 1)
    (hz₀_jump : τ z₀ - z₀ ≠ 0 ∧ valL F M₁' (τ z₀ - z₀) = (t₁ : ℤ) + 1)
    (Δ : K₁ˣ) (hΔ_val : valL F K₁ (Δ : K₁) = -(t₁ : ℤ))
    (hΔ_as_t₂ :
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin p → E',
      w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p,
            Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)) :
    (∀ (C : Fin p → E') (m : ℤ),
      ((∑ i : Fin p, IntermediateField.inclusion hE'K₁ (C i) * ((Δ : K₁) ^ (i : ℕ))) = 0 ∨
        m ≤ valL F K₁ (∑ i : Fin p, IntermediateField.inclusion hE'K₁ (C i) * ((Δ : K₁) ^ (i : ℕ)))) ↔
        ∀ i : Fin p,
          C i = 0 ∨ m ≤ (p : ℤ) * valL F E' (C i) - (i : ℤ) * (t₁ : ℤ)) ∧
    (∀ k : ℕ, 1 ≤ k → k < p → ((k : ℕ) : E') ≠ 0 ∧ valL F E' ((k : ℕ) : E') = 0) ∧
    (∃ (D₀ : E') (δ_plus : K₁),
      τ_lift (Δ : K₁) = (Δ : K₁) + IntermediateField.inclusion hE'K₁ D₀ + δ_plus ∧
      D₀ ≠ 0 ∧
      valL F E' D₀ = 0 ∧
      (δ_plus = 0 ∨ (((p - 1) * (p - 1) * t₁ : ℕ) : ℤ) ≤ valL F K₁ δ_plus)) :=
by
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _⟩ :=
    hvalE'_props
  obtain ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, _, hvalK₁_add, _⟩ :=
    hvalK₁_props
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := hPrime.pos

  
  have val_neg_K₁ : ∀ {k : ℤ} {w : K₁},
      (w = 0 ∨ k ≤ valL F K₁ w) → (-w = 0 ∨ k ≤ valL F K₁ (-w)) := by
    intro k w hw
    rcases hw with rfl | hw
    · simp
    · right
      rw [hvalK₁_neg w]
      exact hw
  have val_add_K₁ : ∀ {k : ℤ} {w₁ w₂ : K₁},
      (w₁ = 0 ∨ k ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k ≤ valL F K₁ w₂) →
        (w₁ + w₂ = 0 ∨ k ≤ valL F K₁ (w₁ + w₂)) := by
    intro k w₁ w₂ hw₁ hw₂
    exact hvalK₁_add k w₁ w₂ hw₁ hw₂
  have val_sub_K₁ : ∀ {k : ℤ} {w₁ w₂ : K₁},
      (w₁ = 0 ∨ k ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k ≤ valL F K₁ w₂) →
        (w₁ - w₂ = 0 ∨ k ≤ valL F K₁ (w₁ - w₂)) := by
    intro k w₁ w₂ hw₁ hw₂
    rw [sub_eq_add_neg]
    exact val_add_K₁ hw₁ (val_neg_K₁ hw₂)
  have val_mul_K₁ : ∀ {k₁ k₂ : ℤ} {w₁ w₂ : K₁},
      (w₁ = 0 ∨ k₁ ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k₂ ≤ valL F K₁ w₂) →
        (w₁ * w₂ = 0 ∨ k₁ + k₂ ≤ valL F K₁ (w₁ * w₂)) := by
    intro k₁ k₂ w₁ w₂ hw₁ hw₂
    by_cases hw₁0 : w₁ = 0
    · exact Or.inl (by simp [hw₁0])
    · by_cases hw₂0 : w₂ = 0
      · exact Or.inl (by simp [hw₂0])
      · right
        rw [hvalK₁_mul w₁ w₂ hw₁0 hw₂0]
        exact add_le_add (hw₁.resolve_left hw₁0) (hw₂.resolve_left hw₂0)
  have val_mono_K₁ : ∀ {k₁ k₂ : ℤ} {w : K₁},
      k₁ ≤ k₂ → (w = 0 ∨ k₂ ≤ valL F K₁ w) → (w = 0 ∨ k₁ ≤ valL F K₁ w) := by
    intro k₁ k₂ w hk hw
    exact hw.imp_right (le_trans hk)
  have val_pow_K₁ : ∀ {q : ℤ} {w : K₁},
      (w = 0 ∨ q ≤ valL F K₁ w) → ∀ (k : ℕ), w ^ k = 0 ∨ (k : ℤ) * q ≤ valL F K₁ (w ^ k) := by
    intro q w hw k
    induction k with
    | zero =>
      right
      rw [pow_zero, hvalK₁_1]
      omega
    | succ k ih =>
      rw [pow_succ]
      have hmul := val_mul_K₁ ih hw
      refine val_mono_K₁ ?_ hmul
      push_cast
      linarith
  have val_sum_K₁ : ∀ {α : Type} (S : Finset α) (f : α → K₁) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ S, f i)) := by
    intro α S f k hf
    induction S using Finset.induction_on with
    | empty =>
      exact Or.inl (by simp)
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact val_add_K₁ (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have val_natCast_K₁ : ∀ (n : ℕ), ((n : ℕ) : K₁) = 0 ∨ (0 : ℤ) ≤ valL F K₁ ((n : ℕ) : K₁) := by
    intro n
    induction n with
    | zero => exact Or.inl (by simp)
    | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one]
      exact val_add_K₁ ih (Or.inr (by rw [hvalK₁_1]))
  have hval_pow_eq_K₁ : ∀ {w : K₁}, w ≠ 0 → ∀ (k : ℕ),
      w ^ k ≠ 0 ∧ valL F K₁ (w ^ k) = (k : ℤ) * valL F K₁ w := by
    intro w hw k
    induction k with
    | zero =>
      exact ⟨by simp, by simp [hvalK₁_1]⟩
    | succ k ih =>
      rw [pow_succ]
      refine ⟨mul_ne_zero ih.1 hw, ?_⟩
      rw [hvalK₁_mul (w ^ k) w ih.1 hw, ih.2]
      push_cast
      ring
  have hval_strict_K₁ : ∀ {w₁ w₂ : K₁},
      w₁ ≠ 0 →
      (w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ w₂) →
      w₁ + w₂ ≠ 0 ∧ valL F K₁ (w₁ + w₂) = valL F K₁ w₁ := by
    intro w₁ w₂ hw₁ hw₂
    have hw₁_ge : w₁ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ w₁ := Or.inr le_rfl
    have hw₂_ge : w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ w₂ := val_mono_K₁ (by omega) hw₂
    have hsum_ge : w₁ + w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ (w₁ + w₂) :=
      val_add_K₁ hw₁_ge hw₂_ge
    have hnot_gt : ¬ (w₁ + w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := by
      intro hgt
      have hsub := val_sub_K₁ hgt hw₂
      have hid : (w₁ + w₂) - w₂ = w₁ := by ring
      rw [hid] at hsub
      rcases hsub with h0 | hle
      · exact hw₁ h0
      · omega
    have hsum_ne : w₁ + w₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hge : valL F K₁ w₁ ≤ valL F K₁ (w₁ + w₂) := hsum_ge.resolve_left hsum_ne
    have hlt : ¬ (valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := fun hle => hnot_gt (Or.inr hle)
    exact ⟨hsum_ne, by omega⟩
  have val_incl_E'K₁ : ∀ {m : ℤ} {y : E'},
      (y = 0 ∨ m ≤ valL F E' y) →
      IntermediateField.inclusion hE'K₁ y = 0 ∨
        (p : ℤ) * m ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ y) := by
    intro m y hy
    rcases hy with rfl | hy
    · exact Or.inl (map_zero _)
    · right
      rw [hval_E'K₁ y]
      exact mul_le_mul_of_nonneg_left hy (Nat.cast_nonneg p)

  have val_neg_E' : ∀ {k : ℤ} {x : E'},
      (x = 0 ∨ k ≤ valL F E' x) → (-x = 0 ∨ k ≤ valL F E' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right
      rw [hvalE'_neg x]
      exact hx
  have val_add_E' : ∀ {k : ℤ} {x₁ x₂ : E'},
      (x₁ = 0 ∨ k ≤ valL F E' x₁) → (x₂ = 0 ∨ k ≤ valL F E' x₂) →
        (x₁ + x₂ = 0 ∨ k ≤ valL F E' (x₁ + x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    exact hvalE'_add k x₁ x₂ hx₁ hx₂
  have val_sub_E' : ∀ {k : ℤ} {x₁ x₂ : E'},
      (x₁ = 0 ∨ k ≤ valL F E' x₁) → (x₂ = 0 ∨ k ≤ valL F E' x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F E' (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    exact val_add_E' hx₁ (val_neg_E' hx₂)
  have val_mul_E' : ∀ {k₁ k₂ : ℤ} {x₁ x₂ : E'},
      (x₁ = 0 ∨ k₁ ≤ valL F E' x₁) → (x₂ = 0 ∨ k₂ ≤ valL F E' x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F E' (x₁ * x₂)) := by
    intro k₁ k₂ x₁ x₂ hx₁ hx₂
    by_cases hx₁0 : x₁ = 0
    · exact Or.inl (by simp [hx₁0])
    · by_cases hx₂0 : x₂ = 0
      · exact Or.inl (by simp [hx₂0])
      · right
        rw [hvalE'_mul x₁ x₂ hx₁0 hx₂0]
        exact add_le_add (hx₁.resolve_left hx₁0) (hx₂.resolve_left hx₂0)
  have val_mono_E' : ∀ {k₁ k₂ : ℤ} {x : E'},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F E' x) → (x = 0 ∨ k₁ ≤ valL F E' x) := by
    intro k₁ k₂ x hk hx
    exact hx.imp_right (le_trans hk)
  have val_natCast_E' : ∀ (n : ℕ), ((n : ℕ) : E') = 0 ∨ (0 : ℤ) ≤ valL F E' ((n : ℕ) : E') := by
    intro n
    induction n with
    | zero => exact Or.inl (by simp)
    | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one]
      exact val_add_E' ih (Or.inr (by rw [hvalE'_1]))
  have val_intCast_E' : ∀ (z : ℤ), (z : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (z : E') := by
    intro z
    cases z with
    | ofNat n =>
      simpa using val_natCast_E' n
    | negSucc n =>
      rw [Int.cast_negSucc]
      exact val_neg_E' (val_natCast_E' (n + 1))
  have hval_strict_E' : ∀ {x₁ x₂ : E'},
      x₁ ≠ 0 →
      (x₂ = 0 ∨ valL F E' x₁ + 1 ≤ valL F E' x₂) →
      x₁ + x₂ ≠ 0 ∧ valL F E' (x₁ + x₂) = valL F E' x₁ := by
    intro x₁ x₂ hx₁ hx₂
    have hx₁_ge : x₁ = 0 ∨ valL F E' x₁ ≤ valL F E' x₁ := Or.inr le_rfl
    have hx₂_ge : x₂ = 0 ∨ valL F E' x₁ ≤ valL F E' x₂ := val_mono_E' (by omega) hx₂
    have hsum_ge : x₁ + x₂ = 0 ∨ valL F E' x₁ ≤ valL F E' (x₁ + x₂) :=
      val_add_E' hx₁_ge hx₂_ge
    have hnot_gt : ¬ (x₁ + x₂ = 0 ∨ valL F E' x₁ + 1 ≤ valL F E' (x₁ + x₂)) := by
      intro hgt
      have hsub := val_sub_E' hgt hx₂
      have hid : (x₁ + x₂) - x₂ = x₁ := by ring
      rw [hid] at hsub
      rcases hsub with h0 | hle
      · exact hx₁ h0
      · omega
    have hsum_ne : x₁ + x₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hge : valL F E' x₁ ≤ valL F E' (x₁ + x₂) := hsum_ge.resolve_left hsum_ne
    have hlt : ¬ (valL F E' x₁ + 1 ≤ valL F E' (x₁ + x₂)) := fun hle => hnot_gt (Or.inr hle)
    exact ⟨hsum_ne, by omega⟩

  
  let t_term : (Fin p → E') → Fin p → K₁ :=
    fun C i => IntermediateField.inclusion hE'K₁ (C i) * ((Δ : K₁) ^ (i : ℕ))
  let v_term : (Fin p → E') → Fin p → ℤ :=
    fun C i => (p : ℤ) * valL F E' (C i) - (i : ℤ) * (t₁ : ℤ)
  have ht_term_zero : ∀ (C : Fin p → E') (i : Fin p), C i = 0 → t_term C i = 0 := by
    intro C i hCi
    dsimp [t_term]
    rw [hCi, map_zero, zero_mul]
  have ht_term_nz : ∀ (C : Fin p → E') (i : Fin p), C i ≠ 0 →
      t_term C i ≠ 0 ∧ valL F K₁ (t_term C i) = v_term C i := by
    intro C i hCi
    dsimp [t_term, v_term]
    have hincl_ne : IntermediateField.inclusion hE'K₁ (C i) ≠ 0 := by
      intro h0
      exact hCi ((IntermediateField.inclusion hE'K₁).injective (h0.trans (map_zero _).symm))
    have hΔ_ne : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
    obtain ⟨hpow_ne, hpow_val⟩ := hval_pow_eq_K₁ hΔ_ne (i : ℕ)
    refine ⟨mul_ne_zero hincl_ne hpow_ne, ?_⟩
    rw [hvalK₁_mul _ _ hincl_ne hpow_ne, hval_E'K₁ (C i), hpow_val, hΔ_val]
    ring
  have hv_term_inj_le : ∀ (C : Fin p → E') (i j : Fin p),
      (i : ℕ) ≤ (j : ℕ) → v_term C i = v_term C j → i = j := by
    intro C i j hij_le hij
    dsimp [v_term] at hij
    set d : ℕ := (j : ℕ) - (i : ℕ)
    set v_diff : ℤ := valL F E' (C j) - valL F E' (C i)
    have hd_cast : (d : ℤ) = (j : ℤ) - (i : ℤ) := by
      dsimp [d]
      omega
    have hrel : (d : ℤ) * (t₁ : ℤ) = (p : ℤ) * v_diff := by
      dsimp [v_diff]
      rw [hd_cast]
      linarith
    have hv_diff_nonneg : 0 ≤ v_diff := by
      have hdt_nonneg : 0 ≤ (d : ℤ) * (t₁ : ℤ) :=
        mul_nonneg (Nat.cast_nonneg d) (Nat.cast_nonneg t₁)
      rw [hrel] at hdt_nonneg
      by_contra hlt
      have hneg : v_diff < 0 := not_le.mp hlt
      have hp_pos_z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
      have hmul_neg : (p : ℤ) * v_diff < 0 := mul_neg_of_pos_of_neg hp_pos_z hneg
      omega
    set q : ℕ := v_diff.toNat
    have hq_cast : (q : ℤ) = v_diff := Int.toNat_of_nonneg hv_diff_nonneg
    have hrel_nat_z : ((d * t₁ : ℕ) : ℤ) = ((p * q : ℕ) : ℤ) := by
      push_cast
      rw [hq_cast, hrel]
    have hrel_nat : d * t₁ = p * q := by exact_mod_cast hrel_nat_z
    have hdvd_mul : p ∣ d * t₁ := ⟨q, hrel_nat⟩
    have hdvd_d : p ∣ d := (hPrime.dvd_mul.mp hdvd_mul).resolve_right ht₁_ndvd
    have hd_lt : d < p := by
      dsimp [d]
      have hj_lt : (j : ℕ) < p := j.isLt
      omega
    have hd_eq0 : d = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_d hd_lt
    apply Fin.ext
    dsimp [d] at hd_eq0
    omega
  have hv_term_inj : ∀ (C : Fin p → E') (i j : Fin p), v_term C i = v_term C j → i = j := by
    intro C i j hij
    rcases le_total (i : ℕ) (j : ℕ) with hij_le | hji_le
    · exact hv_term_inj_le C i j hij_le hij
    · exact (hv_term_inj_le C j i hji_le hij.symm).symm
  have hval_sum_ge : ∀ (C : Fin p → E') (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, C i = 0 ∨ m ≤ v_term C i) →
      (∑ i ∈ S, t_term C i) = 0 ∨ m ≤ valL F K₁ (∑ i ∈ S, t_term C i) := by
    intro C S m hS
    apply val_sum_K₁ S (t_term C) m
    intro i hi
    by_cases hCi : C i = 0
    · exact Or.inl (ht_term_zero C i hCi)
    · right
      rw [(ht_term_nz C i hCi).2]
      exact (hS i hi).resolve_left hCi
  have hsum_min_nz : ∀ (C : Fin p → E') (i : Fin p), C i ≠ 0 →
      ∃ i₀ : Fin p, C i₀ ≠ 0 ∧ v_term C i₀ ≤ v_term C i ∧
        (∑ j : Fin p, t_term C j) ≠ 0 ∧
        valL F K₁ (∑ j : Fin p, t_term C j) = v_term C i₀ := by
    intro C i hCi
    let S_nz : Finset (Fin p) := Finset.univ.filter (fun j : Fin p => C j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hCi⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term C) ⟨i, hi_mem⟩
    have hi₀_nz : C i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hi₀_le_i : v_term C i₀ ≤ v_term C i := hi₀_min i hi_mem
    have herase_bound : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
        C j = 0 ∨ v_term C i₀ + 1 ≤ v_term C j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hCj : C j = 0
      · exact Or.inl hCj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hCj⟩
        have hle : v_term C i₀ ≤ v_term C j := hi₀_min j hj_mem
        have hne : v_term C i₀ ≠ v_term C j := fun heq => hj_ne (hv_term_inj C i₀ j heq).symm
        omega
    have herase_sum := hval_sum_ge C ((Finset.univ : Finset (Fin p)).erase i₀) (v_term C i₀ + 1) herase_bound
    obtain ⟨ht_i₀_nz, ht_i₀_val⟩ := ht_term_nz C i₀ hi₀_nz
    have herase_sum' :
        (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term C j) = 0 ∨
          valL F K₁ (t_term C i₀) + 1 ≤ valL F K₁ (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term C j) := by
      rw [ht_i₀_val]
      exact herase_sum
    obtain ⟨hadd_nz, hadd_val⟩ := hval_strict_K₁ ht_i₀_nz herase_sum'
    have hsum_split : t_term C i₀ + ∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term C j =
        ∑ j : Fin p, t_term C j :=
      Finset.add_sum_erase Finset.univ (t_term C) (Finset.mem_univ i₀)
    rw [hsum_split] at hadd_nz hadd_val
    rw [ht_i₀_val] at hadd_val
    exact ⟨i₀, hi₀_nz, hi₀_le_i, hadd_nz, hadd_val⟩
  have hval_sum_iff : ∀ (C : Fin p → E') (m : ℤ),
      ((∑ i : Fin p, t_term C i) = 0 ∨ m ≤ valL F K₁ (∑ i : Fin p, t_term C i)) ↔
        ∀ i : Fin p, C i = 0 ∨ m ≤ v_term C i := by
    intro C m
    refine ⟨?_, ?_⟩
    · intro hsum i
      by_cases hCi : C i = 0
      · exact Or.inl hCi
      · right
        obtain ⟨i₀, _, hi₀_le, hsum_nz, hsum_val⟩ := hsum_min_nz C i hCi
        rcases hsum with h0 | hm_le
        · exact False.elim (hsum_nz h0)
        · rw [hsum_val] at hm_le
          exact le_trans hm_le hi₀_le
    · intro h_all
      exact hval_sum_ge C Finset.univ m (fun i _ => h_all i)

  
  have hp_valE' : ((p : ℕ) : E') = 0 ∨ (1 : ℤ) ≤ valL F E' ((p : ℕ) : E') := by
    by_cases hp0 : ((p : ℕ) : E') = 0
    · exact Or.inl hp0
    · right
      have hincl_p : IntermediateField.inclusion hE'K₁ ((p : ℕ) : E') = ((p : ℕ) : K₁) :=
        map_natCast (IntermediateField.inclusion hE'K₁) p
      have hpK₁_ne : ((p : ℕ) : K₁) ≠ 0 := by
        intro h0
        exact hp0 ((IntermediateField.inclusion hE'K₁).injective
          (hincl_p.trans (h0.trans (map_zero _).symm)))
      have hpK₁_ge : ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁) :=
        hp_valK₁.resolve_left hpK₁_ne
      rw [← hincl_p, hval_E'K₁] at hpK₁_ge
      have hp_le_P₂ : p ≤ p * (p - 1) * t₂ := by
        have h1 : 1 ≤ (p - 1) * t₂ := by
          calc 1 = 1 * 1 := by ring
            _ ≤ (p - 1) * t₂ := Nat.mul_le_mul (by omega) (le_trans ht₁_ge1 ht_le)
        calc p = p * 1 := by ring
          _ ≤ p * ((p - 1) * t₂) := Nat.mul_le_mul_left p h1
          _ = p * (p - 1) * t₂ := by ring
      have hp_le_z : (p : ℤ) ≤ ((p * (p - 1) * t₂ : ℕ) : ℤ) := by exact_mod_cast hp_le_P₂
      nlinarith [hp_ge3, hp_le_z, hpK₁_ge]
  have hcoprime_E' : ∀ k : ℕ, 1 ≤ k → k < p →
      ((k : ℕ) : E') ≠ 0 ∧ valL F E' ((k : ℕ) : E') = 0 := by
    intro k hk_ge1 hk_lt
    have hcop : Nat.Coprime k p :=
      ((Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt (by omega) hk_lt)).symm
    have hbez : ((k : ℕ) : E') * (Nat.gcdA k p : E') =
        (1 : E') + (- (((p : ℕ) : E') * (Nat.gcdB k p : E'))) := by
      have h := congrArg (Int.cast : ℤ → E') (Nat.gcd_eq_gcd_ab k p)
      rw [hcop.gcd_eq_one] at h
      push_cast at h
      linear_combination -h
    have hw₂_ge : - (((p : ℕ) : E') * (Nat.gcdB k p : E')) = 0 ∨
        valL F E' (1 : E') + 1 ≤ valL F E' (- (((p : ℕ) : E') * (Nat.gcdB k p : E'))) := by
      have hmul := val_mul_E' hp_valE' (val_intCast_E' (Nat.gcdB k p))
      have hneg := val_neg_E' hmul
      rcases hneg with h0 | hge
      · exact Or.inl h0
      · right
        rw [hvalE'_1]
        omega
    have hstrict := hval_strict_E' (one_ne_zero : (1 : E') ≠ 0) hw₂_ge
    rw [← hbez, hvalE'_1] at hstrict
    have hk_ne0 : ((k : ℕ) : E') ≠ 0 := left_ne_zero_of_mul hstrict.1
    have ha_ne0 : (Nat.gcdA k p : E') ≠ 0 := right_ne_zero_of_mul hstrict.1
    have hk_ge0 : 0 ≤ valL F E' ((k : ℕ) : E') := (val_natCast_E' k).resolve_left hk_ne0
    have ha_ge0 : 0 ≤ valL F E' (Nat.gcdA k p : E') :=
      (val_intCast_E' (Nat.gcdA k p)).resolve_left ha_ne0
    have hmul_val := hstrict.2
    rw [hvalE'_mul ((k : ℕ) : E') (Nat.gcdA k p : E') hk_ne0 ha_ne0] at hmul_val
    exact ⟨hk_ne0, by omega⟩

  
  
  set P₂ : ℤ := ((p * (p - 1) * t₂ : ℕ) : ℤ)
  set M_target : ℤ := (((p - 1) * (p - 1) * t₁ : ℕ) : ℤ)
  have hM_target_ge4 : (4 : ℤ) ≤ M_target := by
    have h1 : 4 ≤ (p - 1) * (p - 1) * t₁ := by
      calc 4 = 2 * 2 * 1 := by ring
        _ ≤ (p - 1) * (p - 1) * t₁ :=
          Nat.mul_le_mul (Nat.mul_le_mul (by omega) (by omega)) ht₁_ge1
    dsimp [M_target]
    exact_mod_cast h1
  have hP₂_ge_M_target : M_target + ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ P₂ := by
    have h1 : (p - 1) * (p - 1) * t₁ + (p - 1) * t₁ ≤ p * (p - 1) * t₂ := by
      have hp_eq : (p - 1) + 1 = p := Nat.sub_add_cancel hp_pos
      calc (p - 1) * (p - 1) * t₁ + (p - 1) * t₁
        _ = ((p - 1) + 1) * (p - 1) * t₁ := by ring
        _ = p * (p - 1) * t₁ := by rw [hp_eq]
        _ ≤ p * (p - 1) * t₂ := Nat.mul_le_mul_left (p * (p - 1)) ht_le
    have h1z : (((p - 1) * (p - 1) * t₁ + (p - 1) * t₁ : ℕ) : ℤ) ≤ P₂ := by
      dsimp [P₂]
      exact_mod_cast h1
    rw [Nat.cast_add, Nat.cast_mul (p - 1) t₁] at h1z
    exact h1z
  have hP₂_ge_M : M_target ≤ P₂ := by
    have h0 : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) :=
      mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
    linarith [hP₂_ge_M_target, h0]
  have hP₂_sub_pt₁ : (3 : ℤ) ≤ P₂ - (p : ℤ) * (t₁ : ℤ) := by
    have h1 : p * t₁ + 3 ≤ p * (p - 1) * t₂ := by
      have hpt1 : 3 ≤ p * t₁ := by
        calc 3 = 3 * 1 := by ring
          _ ≤ p * t₁ := Nat.mul_le_mul hp_ge3 ht₁_ge1
      calc p * t₁ + 3
        _ ≤ p * t₁ + p * t₁ := by omega
        _ = p * 2 * t₁ := by ring
        _ ≤ p * (p - 1) * t₁ :=
          Nat.mul_le_mul_right t₁ (Nat.mul_le_mul_left p (by omega))
        _ ≤ p * (p - 1) * t₂ := Nat.mul_le_mul_left (p * (p - 1)) ht_le
    have h1z : (p : ℤ) * (t₁ : ℤ) + 3 ≤ P₂ := by
      dsimp [P₂]
      exact_mod_cast h1
    linarith
  have hchoose_val : ∀ (j : ℕ), 0 < j → j < p →
      ((Nat.choose p j : ℕ) : K₁) = 0 ∨ P₂ ≤ valL F K₁ ((Nat.choose p j : ℕ) : K₁) := by
    intro j hj_pos hj_lt
    obtain ⟨q, hq⟩ := Nat.Prime.dvd_choose_self hPrime (by omega) hj_lt
    rw [hq, Nat.cast_mul]
    exact val_mono_K₁ (by omega) (val_mul_K₁ hp_valK₁ (val_natCast_K₁ q))
  have hbinom_decomp : ∀ (x y : K₁),
      (x + y) ^ p - (x ^ p + y ^ p) =
        ∑ k ∈ Finset.range (p - 1),
          x ^ (k + 1) * y ^ (p - (k + 1)) * ((Nat.choose p (k + 1) : ℕ) : K₁) := by
    intro x y
    let g : ℕ → K₁ := fun j => x ^ j * y ^ (p - j) * ((Nat.choose p j : ℕ) : K₁)
    have h1 : (x + y) ^ p = ∑ j ∈ Finset.range (p + 1), g j := add_pow x y p
    have h2 : ∑ j ∈ Finset.range (p + 1), g j = (∑ j ∈ Finset.range p, g j) + g p :=
      Finset.sum_range_succ g p
    have hgp : g p = x ^ p := by
      dsimp [g]
      rw [Nat.sub_self, pow_zero, Nat.choose_self, Nat.cast_one, mul_one, mul_one]
    have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp_pos).symm
    have h3 : ∑ j ∈ Finset.range p, g j =
        (∑ k ∈ Finset.range (p - 1), g (k + 1)) + g 0 := by
      conv_lhs => rw [hp_eq]
      exact Finset.sum_range_succ' g (p - 1)
    have hg0 : g 0 = y ^ p := by
      dsimp [g]
      rw [pow_zero, Nat.choose_zero_right, Nat.cast_one, one_mul, mul_one]
    rw [h1, h2, hgp, h3, hg0]
    ring
  have hbinom_cross : ∀ (x y : K₁) (vx vy M : ℤ),
      (x = 0 ∨ vx ≤ valL F K₁ x) →
      (y = 0 ∨ vy ≤ valL F K₁ y) →
      (∀ k < p - 1, M ≤ ((k + 1 : ℕ) : ℤ) * vx + ((p - (k + 1) : ℕ) : ℤ) * vy + P₂) →
      (x + y) ^ p - (x ^ p + y ^ p) = 0 ∨ M ≤ valL F K₁ ((x + y) ^ p - (x ^ p + y ^ p)) := by
    intro x y vx vy M hx hy hM
    rw [hbinom_decomp x y]
    apply val_sum_K₁ (Finset.range (p - 1)) _ M
    intro k hk
    have hk_lt : k < p - 1 := Finset.mem_range.mp hk
    have hx_pow := val_pow_K₁ hx (k + 1)
    have hy_pow := val_pow_K₁ hy (p - (k + 1))
    have hch := hchoose_val (k + 1) (by omega) (by omega)
    exact val_mono_K₁ (hM k hk_lt) (val_mul_K₁ (val_mul_K₁ hx_pow hy_pow) hch)

  
  set δ : K₁ := τ_lift (Δ : K₁) - (Δ : K₁)
  set δ_AS : K₁ := (Δ : K₁) ^ p - (Δ : K₁) -
    IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))
  have hτ_Δ_eq : τ_lift (Δ : K₁) = (Δ : K₁) + δ := by dsimp [δ]; ring
  have hτ_δ_AS : τ_lift δ_AS - δ_AS = ((Δ : K₁) + δ) ^ p - (Δ : K₁) ^ p - δ := by
    dsimp [δ_AS]
    rw [map_sub, map_sub, map_pow, hτ_E', hτ_Δ_eq]
    ring
  have hτ_δ_AS_val : τ_lift δ_AS = 0 ∨ P₂ ≤ valL F K₁ (τ_lift δ_AS) := by
    rcases hΔ_as_t₂ with h0 | hge
    · exact Or.inl (by rw [h0, map_zero])
    · right
      rw [hτ_valK₁]
      exact hge
  have h_AS_diff : ((Δ : K₁) + δ) ^ p - (Δ : K₁) ^ p - δ = 0 ∨
      P₂ ≤ valL F K₁ (((Δ : K₁) + δ) ^ p - (Δ : K₁) ^ p - δ) := by
    rw [← hτ_δ_AS]
    exact val_sub_K₁ hτ_δ_AS_val hΔ_as_t₂
  have hΔ_ge : (Δ : K₁) = 0 ∨ -(t₁ : ℤ) ≤ valL F K₁ (Δ : K₁) :=
    Or.inr (by rw [hΔ_val])
  have hτΔ_ge : τ_lift (Δ : K₁) = 0 ∨ -(t₁ : ℤ) ≤ valL F K₁ (τ_lift (Δ : K₁)) :=
    Or.inr (by rw [hτ_valK₁, hΔ_val])
  have hδ_ge_neg_t₁ : δ = 0 ∨ -(t₁ : ℤ) ≤ valL F K₁ δ :=
    val_sub_K₁ hτΔ_ge hΔ_ge
  have hcross_0 : ((Δ : K₁) + δ) ^ p - ((Δ : K₁) ^ p + δ ^ p) = 0 ∨
      (0 : ℤ) ≤ valL F K₁ (((Δ : K₁) + δ) ^ p - ((Δ : K₁) ^ p + δ ^ p)) := by
    apply hbinom_cross (Δ : K₁) δ (-(t₁ : ℤ)) (-(t₁ : ℤ)) 0 hΔ_ge hδ_ge_neg_t₁
    intro k hk_lt
    have hk_sum : ((k + 1 : ℕ) : ℤ) + ((p - (k + 1) : ℕ) : ℤ) = (p : ℤ) := by omega
    nlinarith [hP₂_sub_pt₁, hk_sum]
  have hδp_sub_δ_0 : δ ^ p - δ = 0 ∨ (0 : ℤ) ≤ valL F K₁ (δ ^ p - δ) := by
    have hid : δ ^ p - δ =
        (((Δ : K₁) + δ) ^ p - (Δ : K₁) ^ p - δ) -
          (((Δ : K₁) + δ) ^ p - ((Δ : K₁) ^ p + δ ^ p)) := by ring
    rw [hid]
    exact val_sub_K₁ (val_mono_K₁ (by omega) h_AS_diff) hcross_0
  have hδ_ge0 : δ = 0 ∨ (0 : ℤ) ≤ valL F K₁ δ := by
    by_cases hδ0 : δ = 0
    · exact Or.inl hδ0
    · right
      by_contra hlt
      have hneg : valL F K₁ δ ≤ -1 := by omega
      obtain ⟨hδp_ne, hδp_val⟩ := hval_pow_eq_K₁ hδ0 p
      have hneg_δ_gt : -δ = 0 ∨ valL F K₁ (δ ^ p) + 1 ≤ valL F K₁ (-δ) := by
        right
        rw [hvalK₁_neg, hδp_val]
        nlinarith [hp_ge3, hneg]
      obtain ⟨hsum_ne, hsum_val⟩ := hval_strict_K₁ hδp_ne hneg_δ_gt
      have hid : δ ^ p + (-δ) = δ ^ p - δ := by ring
      rw [hid] at hsum_ne hsum_val
      rw [hδp_val] at hsum_val
      have hge0 := hδp_sub_δ_0.resolve_left hsum_ne
      nlinarith [hp_ge3, hneg, hsum_val, hge0]
  have hcross_M : ((Δ : K₁) + δ) ^ p - ((Δ : K₁) ^ p + δ ^ p) = 0 ∨
      M_target ≤ valL F K₁ (((Δ : K₁) + δ) ^ p - ((Δ : K₁) ^ p + δ ^ p)) := by
    apply hbinom_cross (Δ : K₁) δ (-(t₁ : ℤ)) 0 M_target hΔ_ge hδ_ge0
    intro k hk_lt
    have hk1 : ((k + 1 : ℕ) : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by omega
    nlinarith [hP₂_ge_M_target, hk1]
  have hδp_sub_δ_M : δ ^ p - δ = 0 ∨ M_target ≤ valL F K₁ (δ ^ p - δ) := by
    have hid : δ ^ p - δ =
        (((Δ : K₁) + δ) ^ p - (Δ : K₁) ^ p - δ) -
          (((Δ : K₁) + δ) ^ p - ((Δ : K₁) ^ p + δ ^ p)) := by ring
    rw [hid]
    exact val_sub_K₁ (val_mono_K₁ hP₂_ge_M h_AS_diff) hcross_M

  
  obtain ⟨D, hδ_eq, hD_iff⟩ := hΔ_basis δ
  let i₀ : Fin p := ⟨0, hp_pos⟩
  let D₀ : E' := D i₀
  let D_plus : Fin p → E' := fun i => if i = i₀ then 0 else D i
  set δ_plus : K₁ := ∑ i : Fin p, t_term D_plus i
  have hD_plus_i₀ : D_plus i₀ = 0 := if_pos rfl
  have hδ_decomp : δ = IntermediateField.inclusion hE'K₁ D₀ + δ_plus := by
    have hsplit_D := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) (t_term D)
      (Finset.mem_univ i₀)).symm
    have htD_i₀ : t_term D i₀ = IntermediateField.inclusion hE'K₁ D₀ := by
      dsimp [t_term, i₀, D₀]
      rw [pow_zero, mul_one]
    have hsplit_Dp := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) (t_term D_plus)
      (Finset.mem_univ i₀)).symm
    have htDp_i₀ : t_term D_plus i₀ = 0 := ht_term_zero D_plus i₀ hD_plus_i₀
    have herase_eq : (∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term D i) =
        ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term D_plus i := by
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_ne : i ≠ i₀ := (Finset.mem_erase.mp hi).1
      dsimp [t_term, D_plus]
      rw [if_neg hi_ne]
    change δ = IntermediateField.inclusion hE'K₁ D₀ + ∑ i : Fin p, t_term D_plus i
    rw [hδ_eq]
    change (∑ i : Fin p, t_term D i) = _
    rw [hsplit_D, htD_i₀, herase_eq, hsplit_Dp, htDp_i₀, zero_add]
  have hτ_Δ : τ_lift (Δ : K₁) = (Δ : K₁) + IntermediateField.inclusion hE'K₁ D₀ + δ_plus := by
    rw [hτ_Δ_eq, hδ_decomp]
    ring
  have hD_all0 := (hD_iff 0).mp hδ_ge0
  have hD₀_ge0 : D₀ = 0 ∨ (0 : ℤ) ≤ valL F E' D₀ := by
    rcases hD_all0 i₀ with h0 | hge
    · exact Or.inl h0
    · right
      change (0 : ℤ) ≤ (p : ℤ) * valL F E' D₀ - (0 : ℤ) * (t₁ : ℤ) at hge
      nlinarith [hp_ge3, hge]
  have hD₀_K₁_ge0 : IntermediateField.inclusion hE'K₁ D₀ = 0 ∨
      (0 : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ D₀) :=
    val_mono_K₁ (by omega) (val_incl_E'K₁ hD₀_ge0)
  have hD_plus_ge1 : ∀ i : Fin p, D_plus i = 0 ∨ (1 : ℤ) ≤ v_term D_plus i := by
    intro i
    by_cases hi : i = i₀
    · exact Or.inl (by dsimp [D_plus]; rw [if_pos hi])
    · have hDp_eq : D_plus i = D i := by dsimp [D_plus]; rw [if_neg hi]
      have hv_eq : v_term D_plus i = v_term D i := by dsimp [v_term]; rw [hDp_eq]
      rw [hDp_eq, hv_eq]
      rcases hD_all0 i with h0 | hge
      · exact Or.inl h0
      · right
        change (0 : ℤ) ≤ v_term D i at hge
        have hne0 : v_term D i ≠ 0 := by
          intro heq0
          let D_test : Fin p → E' := fun j => if j = i₀ then 1 else D j
          have hvt_i : v_term D_test i = v_term D i := by
            dsimp [v_term, D_test]
            rw [if_neg hi]
          have hvt_0 : v_term D_test i₀ = 0 := by
            dsimp [v_term, D_test, i₀]
            rw [hvalE'_1]
            ring
          have hinj := hv_term_inj D_test i i₀ (by rw [hvt_i, heq0, hvt_0])
          exact hi hinj
        omega
  have hδ_plus_ge1 : δ_plus = 0 ∨ (1 : ℤ) ≤ valL F K₁ δ_plus :=
    (hval_sum_iff D_plus 1).mpr hD_plus_ge1
  have hδ_plus_M : δ_plus = 0 ∨ M_target ≤ valL F K₁ δ_plus := by
    by_cases hδp0 : δ_plus = 0
    · exact Or.inl hδp0
    · right
      set q_plus : ℤ := valL F K₁ δ_plus
      have hq_ge1 : (1 : ℤ) ≤ q_plus := hδ_plus_ge1.resolve_left hδp0
      by_contra hlt
      have hq1_le_M : q_plus + 1 ≤ M_target := by omega
      have hcross_q : (IntermediateField.inclusion hE'K₁ D₀ + δ_plus) ^ p -
          ((IntermediateField.inclusion hE'K₁ D₀) ^ p + δ_plus ^ p) = 0 ∨
          q_plus + 1 ≤ valL F K₁ ((IntermediateField.inclusion hE'K₁ D₀ + δ_plus) ^ p -
            ((IntermediateField.inclusion hE'K₁ D₀) ^ p + δ_plus ^ p)) := by
        apply hbinom_cross (IntermediateField.inclusion hE'K₁ D₀) δ_plus 0 q_plus (q_plus + 1)
          hD₀_K₁_ge0 (Or.inr le_rfl)
        intro k hk_lt
        have hpk1 : (1 : ℤ) ≤ ((p - (k + 1) : ℕ) : ℤ) := by omega
        nlinarith [hpk1, hq_ge1, hP₂_ge_M, hM_target_ge4]
      have hpow_q : δ_plus ^ p = 0 ∨ q_plus + 1 ≤ valL F K₁ (δ_plus ^ p) := by
        refine val_mono_K₁ ?_ (val_pow_K₁ (Or.inr (le_rfl : q_plus ≤ valL F K₁ δ_plus)) p)
        nlinarith [hp_ge3, hq_ge1]
      have hδp_sub_D₀p : δ ^ p - IntermediateField.inclusion hE'K₁ (D₀ ^ p) = 0 ∨
          q_plus + 1 ≤ valL F K₁ (δ ^ p - IntermediateField.inclusion hE'K₁ (D₀ ^ p)) := by
        have hid : δ ^ p - IntermediateField.inclusion hE'K₁ (D₀ ^ p) =
            ((IntermediateField.inclusion hE'K₁ D₀ + δ_plus) ^ p -
              ((IntermediateField.inclusion hE'K₁ D₀) ^ p + δ_plus ^ p)) + δ_plus ^ p := by
          rw [hδ_decomp, map_pow]
          ring
        rw [hid]
        exact val_add_K₁ hcross_q hpow_q
      have hδ_sub_D₀p : δ - IntermediateField.inclusion hE'K₁ (D₀ ^ p) = 0 ∨
          q_plus + 1 ≤ valL F K₁ (δ - IntermediateField.inclusion hE'K₁ (D₀ ^ p)) := by
        have hid : δ - IntermediateField.inclusion hE'K₁ (D₀ ^ p) =
            (δ ^ p - IntermediateField.inclusion hE'K₁ (D₀ ^ p)) - (δ ^ p - δ) := by ring
        rw [hid]
        exact val_sub_K₁ hδp_sub_D₀p (val_mono_K₁ hq1_le_M hδp_sub_δ_M)
      let D_mod : Fin p → E' := fun i => if i = i₀ then D₀ - D₀ ^ p else D i
      have hsum_mod : (∑ i : Fin p, t_term D_mod i) =
          δ - IntermediateField.inclusion hE'K₁ (D₀ ^ p) := by
        have hsplit_mod := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) (t_term D_mod)
          (Finset.mem_univ i₀)).symm
        have ht_mod0 : t_term D_mod i₀ =
            IntermediateField.inclusion hE'K₁ D₀ - IntermediateField.inclusion hE'K₁ (D₀ ^ p) := by
          dsimp [t_term, D_mod, i₀]
          rw [pow_zero, mul_one, map_sub]
        have hsplit_Dp := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) (t_term D_plus)
          (Finset.mem_univ i₀)).symm
        have htDp_i₀ : t_term D_plus i₀ = 0 := ht_term_zero D_plus i₀ hD_plus_i₀
        have herase_eq : (∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term D_mod i) =
            ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term D_plus i := by
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_ne : i ≠ i₀ := (Finset.mem_erase.mp hi).1
          dsimp [t_term, D_mod, D_plus]
          rw [if_neg hi_ne, if_neg hi_ne]
        rw [hsplit_mod, ht_mod0, herase_eq,
          show (∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term D_plus i) = δ_plus by
            dsimp [δ_plus]; rw [hsplit_Dp, htDp_i₀, zero_add],
          hδ_decomp]
        ring
      rw [← hsum_mod] at hδ_sub_D₀p
      have hmod_all := (hval_sum_iff D_mod (q_plus + 1)).mp hδ_sub_D₀p
      have hDp_q1 : ∀ i : Fin p, D_plus i = 0 ∨ q_plus + 1 ≤ v_term D_plus i := by
        intro i
        by_cases hi : i = i₀
        · exact Or.inl (by dsimp [D_plus]; rw [if_pos hi])
        · have h1 : D_plus i = D_mod i := by dsimp [D_plus, D_mod]; rw [if_neg hi, if_neg hi]
          have h2 : v_term D_plus i = v_term D_mod i := by dsimp [v_term]; rw [h1]
          rw [h1, h2]
          exact hmod_all i
      have hδp_q1 : δ_plus = 0 ∨ q_plus + 1 ≤ valL F K₁ δ_plus :=
        (hval_sum_iff D_plus (q_plus + 1)).mpr hDp_q1
      have hge_q1 : q_plus + 1 ≤ q_plus := hδp_q1.resolve_left hδp0
      omega

  
  have hD₀_unit : D₀ ≠ 0 ∧ valL F E' D₀ = 0 := by
    by_contra hnot_unit
    have hD₀_ge1 : D₀ = 0 ∨ (1 : ℤ) ≤ valL F E' D₀ := by
      rcases hD₀_ge0 with hD₀0 | hge0
      · exact Or.inl hD₀0
      · by_cases hD₀0 : D₀ = 0
        · exact Or.inl hD₀0
        · right
          have hne0 : valL F E' D₀ ≠ 0 := fun h0 => hnot_unit ⟨hD₀0, h0⟩
          omega
    have hD₀_K₁_ge1 : IntermediateField.inclusion hE'K₁ D₀ = 0 ∨
        (1 : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ D₀) := by
      refine val_mono_K₁ ?_ (val_incl_E'K₁ hD₀_ge1)
      omega
    have hδ_ge1 : δ = 0 ∨ (1 : ℤ) ≤ valL F K₁ δ := by
      rw [hδ_decomp]
      exact val_add_K₁ hD₀_K₁_ge1 (val_mono_K₁ (by omega) hδ_plus_M)
    have hδ_M : δ = 0 ∨ M_target ≤ valL F K₁ δ := by
      by_cases hδ0 : δ = 0
      · exact Or.inl hδ0
      · right
        have hge1 : (1 : ℤ) ≤ valL F K₁ δ := hδ_ge1.resolve_left hδ0
        obtain ⟨_, hδp_val⟩ := hval_pow_eq_K₁ hδ0 p
        have hδp_gt : δ ^ p = 0 ∨ valL F K₁ (-δ) + 1 ≤ valL F K₁ (δ ^ p) := by
          right
          rw [hvalK₁_neg, hδp_val]
          nlinarith [hp_ge3, hge1]
        obtain ⟨hsum_ne, hsum_val⟩ := hval_strict_K₁ (neg_ne_zero.mpr hδ0) hδp_gt
        have hid : -δ + δ ^ p = δ ^ p - δ := by ring
        rw [hid] at hsum_ne hsum_val
        rw [hvalK₁_neg] at hsum_val
        have hge_M := hδp_sub_δ_M.resolve_left hsum_ne
        omega
    have hΔ_pow_shift : ∀ n : ℕ, 1 ≤ n →
        (τ_lift (Δ : K₁)) ^ n - (Δ : K₁) ^ n = 0 ∨
          -((n : ℤ) - 1) * (t₁ : ℤ) + M_target ≤
            valL F K₁ ((τ_lift (Δ : K₁)) ^ n - (Δ : K₁) ^ n) := by
      intro n hn
      induction n with
      | zero => omega
      | succ m ih =>
        by_cases hm0 : m = 0
        · subst hm0
          simp only [Nat.zero_add, pow_one, Nat.cast_one, sub_self, neg_zero, zero_mul, zero_add]
          exact hδ_M
        · have hm_ge1 : 1 ≤ m := by omega
          have ihm := ih hm_ge1
          have hid : (τ_lift (Δ : K₁)) ^ (m + 1) - (Δ : K₁) ^ (m + 1) =
              ((τ_lift (Δ : K₁)) ^ m - (Δ : K₁) ^ m) * τ_lift (Δ : K₁) +
                (Δ : K₁) ^ m * δ := by
            rw [pow_succ, pow_succ]
            dsimp [δ]
            ring
          have ht1 := val_mul_K₁ ihm hτΔ_ge
          have ht2 := val_mul_K₁ (val_pow_K₁ hΔ_ge m) hδ_M
          rw [hid]
          refine val_add_K₁ (val_mono_K₁ ?_ ht1) (val_mono_K₁ ?_ ht2)
          · push_cast; linarith
          · push_cast; linarith
    set w₀ : K₁ := IntermediateField.inclusion hM₁'K₁ z₀
    have hw₀_val : valL F K₁ w₀ = (p : ℤ) := by
      dsimp [w₀]
      rw [hval_M₁'K₁, hz₀_val, mul_one]
    obtain ⟨Z₀, hw₀_eq, hZ₀_iff⟩ := hΔ_basis w₀
    have hZ₀_all := (hZ₀_iff (p : ℤ)).mp (Or.inr (by rw [hw₀_val]))
    have hτ_w₀_diff : τ_lift w₀ - w₀ =
        ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Z₀ i) *
          ((τ_lift (Δ : K₁)) ^ (i : ℕ) - (Δ : K₁) ^ (i : ℕ)) := by
      conv_lhs => rw [hw₀_eq]
      rw [map_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, map_pow, hτ_E' (Z₀ i), ← mul_sub]
    have hτ_w₀_bound : τ_lift w₀ - w₀ = 0 ∨
        (p : ℤ) + (t₁ : ℤ) + M_target ≤ valL F K₁ (τ_lift w₀ - w₀) := by
      rw [hτ_w₀_diff]
      apply val_sum_K₁ Finset.univ _ ((p : ℤ) + (t₁ : ℤ) + M_target)
      intro i _
      by_cases hi0 : (i : ℕ) = 0
      · left
        rw [hi0, pow_zero, pow_zero, sub_self, mul_zero]
      · have hi_ge1 : 1 ≤ (i : ℕ) := by omega
        rcases hZ₀_all i with hZi0 | hZi_ge
        · left
          rw [hZi0, map_zero, zero_mul]
        · have hZi_K₁ : IntermediateField.inclusion hE'K₁ (Z₀ i) = 0 ∨
              (p : ℤ) + (i : ℤ) * (t₁ : ℤ) ≤
                valL F K₁ (IntermediateField.inclusion hE'K₁ (Z₀ i)) := by
            right
            rw [hval_E'K₁ (Z₀ i)]
            linarith
          have hpow_i := hΔ_pow_shift (i : ℕ) hi_ge1
          refine val_mono_K₁ ?_ (val_mul_K₁ hZi_K₁ hpow_i)
          linarith
    have hτ_w₀_M₁' : τ_lift w₀ - w₀ = IntermediateField.inclusion hM₁'K₁ (τ z₀ - z₀) := by
      dsimp [w₀]
      rw [hτ_M₁' z₀, map_sub]
    have hτ_w₀_ne0 : τ_lift w₀ - w₀ ≠ 0 := by
      rw [hτ_w₀_M₁']
      intro h0
      exact hz₀_jump.1 ((IntermediateField.inclusion hM₁'K₁).injective
        (h0.trans (map_zero _).symm))
    have hτ_w₀_exact : valL F K₁ (τ_lift w₀ - w₀) = (p : ℤ) * ((t₁ : ℤ) + 1) := by
      rw [hτ_w₀_M₁', hval_M₁'K₁ (τ z₀ - z₀), hz₀_jump.2]
    have hge_jump := hτ_w₀_bound.resolve_left hτ_w₀_ne0
    rw [hτ_w₀_exact] at hge_jump
    have hgap_nat : p * (t₁ + 1) + 2 ≤ p + t₁ + (p - 1) * (p - 1) * t₁ := by
      have hp_eq : (p - 1) + 1 = p := Nat.sub_add_cancel hp_pos
      have hp2_eq : (p - 2) + 1 = p - 1 := by omega
      have h2_le : 2 ≤ (p - 1) * (p - 2) * t₁ := by
        calc 2 = 2 * 1 * 1 := by ring
          _ ≤ (p - 1) * (p - 2) * t₁ :=
            Nat.mul_le_mul (Nat.mul_le_mul (by omega) (by omega)) ht₁_ge1
      have hid_nat : p * (t₁ + 1) + (p - 1) * (p - 2) * t₁ =
          p + t₁ + (p - 1) * (p - 1) * t₁ := by
        calc p * (t₁ + 1) + (p - 1) * (p - 2) * t₁
          _ = p + ((p - 1) + 1) * t₁ + (p - 1) * (p - 2) * t₁ := by
            rw [hp_eq]; ring
          _ = p + t₁ + (p - 1) * ((p - 2) + 1) * t₁ := by ring
          _ = p + t₁ + (p - 1) * (p - 1) * t₁ := by rw [hp2_eq]
      omega
    have hgap_z : (p : ℤ) * ((t₁ : ℤ) + 1) + 2 ≤ (p : ℤ) + (t₁ : ℤ) + M_target := by
      dsimp [M_target]
      exact_mod_cast hgap_nat
    omega

  exact ⟨hval_sum_iff, hcoprime_E', ⟨D₀, δ_plus, hτ_Δ, hD₀_unit.1, hD₀_unit.2, hδ_plus_M⟩⟩

theorem ld_wild_odd_bicyclic_upper_triangular_back_substitution (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t₁ : ℕ) (ht₁_ge1 : 1 ≤ t₁)
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
