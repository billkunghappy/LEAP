    intro m hm
    have h := hval_pow_sub_K₁ (Δ_conj m) ((Δ : K₁) + ξ m) (-(((t₁ : ℕ) : ℤ))) (((B₀ : ℕ) : ℤ))
      (hΔ_conj_val m hm).1 (hξΔ_val m hm).2.1
      (hΔ_conj_val m hm).2 (hξΔ_val m hm).2.2
