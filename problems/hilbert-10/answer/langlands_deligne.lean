    have hres_sub : resFi i (y₁ - y₂) = 0 := by
      rw [sub_eq_add_neg, ((hresFi_map i).2.2.1 y₁ (-y₂) hy₁ (hPFi_neg hy₂)).1,
        ((hresFi_map i).2.2.1 y₂ 0 hy₂ (hPFi_zero i 0)).2.2, hres, add_neg_cancel]
    exact ((hresFi_map i).2.2.2.1 (y₁ - y₂) hsub_int).mp hres_sub

  have hφ_loc_mem : ∀ (j : Fin (q - 1)) {m : ℤ} {y : (D_orb.get (idx_all j)).field},
