          rcases hcase with hp5 | hblt
          · have hp_z_ge5 : (5 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp5
            nlinarith
          · have ht_lt : (t₁ : ℤ) + 1 ≤ (t₂ : ℤ) := by omega
            nlinarith
        linarith
    · push_neg at hcase
      have hp3 : p = 3 := by omega
      have hb_eq : bE' = bM₁' := by omega
      have ht_eq : t₂ = t₁ := by omega
      have hp_z : (p : ℤ) = 3 := by exact_mod_cast hp3
      have hp_sub_z3 : ((p - 1 : ℕ) : ℤ) = 2 := by omega
      have ht_eq_z : (t₂ : ℤ) = (t₁ : ℤ) := by exact_mod_cast ht_eq
      have he_M_nonneg : ∀ k : ℕ, k ≤ p - 1 → e_M k = 0 ∨ 0 ≤ valL F M₁' (e_M k) := by
        intro k hk
        by_cases hk0 : k = 0
        · right; rw [hk0, he_M_0, hvalM₁'_1]
        · have hk_mem : k ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hk⟩
          rcases he_M_val k hk_mem with h0 | hle_k
          · left; exact h0
          · right
            have hk_le2 : (k : ℤ) ≤ 2 := by omega
            nlinarith
      have hex_1 : ∃ τ₁ : G_M₁', (f τ₁ : ℕ) = 1 := by
        by_contra h_no1
        push_neg at h_no1
        have hdvd2 : ∀ τ ∈ (Finset.univ : Finset G_M₁'), 2 ∣ (f τ : ℕ) := by
          intro τ _
          have h1 : (f τ : ℕ) ≤ p - 1 := hle τ
          have h2 : (f τ : ℕ) ≠ 1 := h_no1 τ
          have h02 : (f τ : ℕ) = 0 ∨ (f τ : ℕ) = 2 := by omega
          rcases h02 with h0 | h2'
          · rw [h0]; exact dvd_zero 2
          · rw [h2']
        have hdvd_sum : 2 ∣ ∑ τ : G_M₁', (f τ : ℕ) := Finset.dvd_sum hdvd2
        rw [hsum, hp3] at hdvd_sum
        omega
      obtain ⟨τ₁, hτ₁⟩ := hex_1
      rw [← Finset.mul_prod_erase Finset.univ (fun τ => act_M₁' τ (e_M (f τ : ℕ))) (Finset.mem_univ τ₁)]
      have hfirst : act_M₁' τ₁ (e_M (f τ₁ : ℕ)) = 0 ∨
          (bE' : ℤ) ≤ valL F M₁' (act_M₁' τ₁ (e_M (f τ₁ : ℕ))) := by
        rw [hτ₁]
        exact hactM₁'_bound τ₁ (e_M 1) (bE' : ℤ) he_M_1_up
      have hrest : (∏ τ ∈ Finset.univ.erase τ₁, act_M₁' τ (e_M (f τ : ℕ))) = 0 ∨
          0 ≤ valL F M₁' (∏ τ ∈ Finset.univ.erase τ₁, act_M₁' τ (e_M (f τ : ℕ))) := by
        apply hprod_nonneg_gen M₁' hvalM₁'_1 hvalM₁'_mul
        intro τ _
        exact hactM₁'_bound τ (e_M (f τ : ℕ)) 0 (he_M_nonneg (f τ : ℕ) (hle τ))
      have hcomb := hmul_gen M₁' hvalM₁'_mul (bE' : ℤ) 0 _ _ hfirst hrest
      rcases hcomb with h0 | hle_prod
      · left; exact h0
      · right
        have htarget_eq : (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) = (bE' : ℤ) := by
          rw [hp_z, hp_sub_z3, hb_eq]
          ring
        linarith
  exact ⟨hConj1, hConj2, hConj3, hConj4⟩

theorem ld_wild_odd_k1_poly_coeff_eq_and_trace_diff_bound (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (bE' bM₁' : ℕ)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (a : E') (b : M₁') (e_M1 : M₁') (e_E1 : E') (Z_mixed : M₁') (Z'_mixed : E')
    (A : ℕ → M₁') (B : ℕ → E')
    (hpoly_eq : ∀ c : L,
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁
        (1 + ∑ w ∈ Finset.Icc 1 (p ^ 2), (IntermediateField.inclusion hLM₁' c) ^ w * A w) =
      IntermediateField.inclusion hE'K₁
        (1 + ∑ w ∈ Finset.Icc 1 (p ^ 2), (IntermediateField.inclusion hLE' c) ^ w * B w))
    (hAp :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      A p = IntermediateField.inclusion hLM₁'
        (traceLM F hLM₁' b + normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed))
    (hBp :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      B p = IntermediateField.inclusion hLE'
        (traceLM F hLE' a + normLM F hLE' e_E1 + traceLM F hLE' Z'_mixed))
    (hnorm_E1 : normLM F hLE' e_E1 = 0 ∨ (bE' : ℤ) ≤ valL F L (normLM F hLE' e_E1))
    (hZ'_mixed : Z'_mixed = 0 ∨ (bE' : ℤ) ≤ valL F E' Z'_mixed)
    (hnorm_M1 : normLM F hLM₁' e_M1 = 0 ∨ (bE' : ℤ) ≤ valL F L (normLM F hLM₁' e_M1))
    (hZ_mixed :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      Z_mixed = 0 ∨
        (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ valL F M₁' Z_mixed) :
    traceLM F hLM₁' b - traceLM F hLE' a = 0 ∨
      (bE' : ℤ) ≤ valL F L (traceLM F hLM₁' b - traceLM F hLE' a) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  have hp_pos : 1 ≤ p := hPrime.pos
  have hvalL_neg : ∀ x : L, valL F L (-x) = valL F L x := hvalL_props.2.2.2.1
  have hvalL_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m := hvalL_props.2.2.2.2.2.2.1
  have hvalL_add : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x + y = 0 ∨ k ≤ valL F L (x + y)) := hvalL_props.2.2.2.2.2.2.2.1
  have hvalK₁_1 : valL F K₁ 1 = 0 := hvalK₁_props.2.1
  have hvalK₁_neg : ∀ x : K₁, valL F K₁ (-x) = valL F K₁ x := hvalK₁_props.2.2.2.1
  have hvalK₁_mul : ∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y :=
    hvalK₁_props.2.2.2.2.1
  have hvalK₁_add : ∀ (k : ℤ) (x y : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x + y = 0 ∨ k ≤ valL F K₁ (x + y)) := hvalK₁_props.2.2.2.2.2.2.2.1
  let ιLE' : L →+* E' := (IntermediateField.inclusion hLE').toRingHom
  let ιE'K₁ : E' →+* K₁ := (IntermediateField.inclusion hE'K₁).toRingHom
  let ιLK₁ : L →+* K₁ := ιE'K₁.comp ιLE'
  have hincl_diamond : ∀ x : L,
      IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' x) = ιLK₁ x := by
    intro x
    exact Subtype.ext rfl
  have hincl_E'K₁ : ∀ x : L,
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' x) = ιLK₁ x := by
    intro x
    rfl
  have hιLK₁_inj : Function.Injective ιLK₁ := ιLK₁.injective
  have hval_LK₁ : ∀ x : L,
      valL F K₁ (ιLK₁ x) = ((p : ℤ) * (p : ℤ)) * valL F L x := by
    intro x
    change valL F K₁ (IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' x)) =
      ((p : ℤ) * (p : ℤ)) * valL F L x
    rw [hval_E'K₁, hval_LE']
    ring
  let d : ℕ → K₁ := fun w =>
    IntermediateField.inclusion hM₁'K₁ (A w) - IntermediateField.inclusion hE'K₁ (B w)
  have hdiff_sum_zero : ∀ c : L,
      (∑ w ∈ Finset.Icc 1 (p ^ 2), (ιLK₁ c) ^ w * d w) = 0 := by
    intro c
    have hM : IntermediateField.inclusion hM₁'K₁
        (1 + ∑ w ∈ Finset.Icc 1 (p ^ 2), (IntermediateField.inclusion hLM₁' c) ^ w * A w) =
        1 + ∑ w ∈ Finset.Icc 1 (p ^ 2), (ιLK₁ c) ^ w * IntermediateField.inclusion hM₁'K₁ (A w) := by
      rw [map_add, map_one, map_sum]
      congr 1
    have hE : IntermediateField.inclusion hE'K₁
        (1 + ∑ w ∈ Finset.Icc 1 (p ^ 2), (IntermediateField.inclusion hLE' c) ^ w * B w) =
        1 + ∑ w ∈ Finset.Icc 1 (p ^ 2), (ιLK₁ c) ^ w * IntermediateField.inclusion hE'K₁ (B w) := by
      rw [map_add, map_one, map_sum]
      congr 1
    have heq := hpoly_eq c
    dsimp only at heq
    rw [hM, hE] at heq
    have hsum_eq :
        (∑ w ∈ Finset.Icc 1 (p ^ 2), (ιLK₁ c) ^ w * IntermediateField.inclusion hM₁'K₁ (A w)) =
          ∑ w ∈ Finset.Icc 1 (p ^ 2), (ιLK₁ c) ^ w * IntermediateField.inclusion hE'K₁ (B w) := by
      linear_combination heq
    rw [← sub_eq_zero, ← Finset.sum_sub_distrib] at hsum_eq
    rw [← hsum_eq]
    refine Finset.sum_congr rfl fun w _ => ?_
    dsimp only [d]
    ring
  have hpow_val : ∀ (w : K₁) (hw : w ≠ 0) (r : ℕ),
      w ^ r ≠ 0 ∧ valL F K₁ (w ^ r) = (r : ℤ) * valL F K₁ w := by
    intro w hw r
    induction r with
    | zero =>
      rw [pow_zero]
      refine ⟨one_ne_zero, ?_⟩
      rw [hvalK₁_1, Nat.cast_zero, zero_mul]
    | succ r ih =>
      have hne : w ^ (r + 1) ≠ 0 := pow_ne_zero (r + 1) hw
      refine ⟨hne, ?_⟩
      rw [pow_succ', hvalK₁_mul w (w ^ r) hw ih.1, ih.2]
      push_cast
      ring
  have hsum_valK₁ : ∀ (S : Finset ℕ) (f : ℕ → K₁) (B₀ : ℤ),
      (∀ r ∈ S, f r = 0 ∨ B₀ ≤ valL F K₁ (f r)) →
      (∑ r ∈ S, f r) = 0 ∨ B₀ ≤ valL F K₁ (∑ r ∈ S, f r) := by
    intro S f B₀
    induction S using Finset.induction_on with
    | empty =>
      intro _
      exact Or.inl Finset.sum_empty
    | @insert a₀ S' ha ih =>
      intro hS
      rw [Finset.sum_insert ha]
      have h1 : f a₀ = 0 ∨ B₀ ≤ valL F K₁ (f a₀) := hS a₀ (Finset.mem_insert_self a₀ S')
      have h2 : (∑ r ∈ S', f r) = 0 ∨ B₀ ≤ valL F K₁ (∑ r ∈ S', f r) :=
        ih (fun r hr => hS r (Finset.mem_insert_of_mem hr))
      exact hvalK₁_add B₀ (f a₀) (∑ r ∈ S', f r) h1 h2
  have hpoly_zero : ∀ (n : ℕ) (d₀ : ℕ → K₁),
      (∀ c : L, (∑ r ∈ Finset.Icc 1 n, (ιLK₁ c) ^ r * d₀ r) = 0) →
      ∀ r ∈ Finset.Icc 1 n, d₀ r = 0 := by
    intro n
    induction n with
    | zero =>
      intro d₀ _ r hr
      simp at hr
    | succ n ih =>
      intro d₀ hd
      have hd_top : d₀ (n + 1) = 0 := by
        by_contra hne_top
        let M : ℤ :=
          (∑ r ∈ Finset.Icc 1 n, |valL F K₁ (d₀ r) - valL F K₁ (d₀ (n + 1))|) + 1
        have hM_sum_nonneg :
            0 ≤ ∑ r ∈ Finset.Icc 1 n, |valL F K₁ (d₀ r) - valL F K₁ (d₀ (n + 1))| :=
          Finset.sum_nonneg (fun r _ => abs_nonneg _)
        have hM_ge1 : 1 ≤ M := by
          dsimp only [M]
          linarith
        obtain ⟨u, hu_val⟩ := hvalL_surj (-M)
        let c : L := (u : L)
        have hc_ne0 : c ≠ 0 := Units.ne_zero u
        have hιc_ne0 : ιLK₁ c ≠ 0 := (map_ne_zero_iff ιLK₁ hιLK₁_inj).mpr hc_ne0
        let P₂ : ℤ := ((p : ℤ) * (p : ℤ)) * M
        have hp_int_ge1 : (1 : ℤ) ≤ (p : ℤ) := by omega
        have hp2_ge1 : (1 : ℤ) ≤ (p : ℤ) * (p : ℤ) := by nlinarith
        have hP₂_ge_M : M ≤ P₂ := by
          dsimp only [P₂]
          nlinarith
        have hP₂_nonneg : 0 ≤ P₂ := by linarith
        have hval_ιc : valL F K₁ (ιLK₁ c) = - P₂ := by
          rw [hval_LK₁ c, hu_val]
          dsimp only [P₂]
          ring
        let V_top : ℤ :=
          - (((n + 1 : ℕ) : ℤ) * P₂) + valL F K₁ (d₀ (n + 1))
        have htop_ne0 : (ιLK₁ c) ^ (n + 1) * d₀ (n + 1) ≠ 0 :=
          mul_ne_zero (pow_ne_zero (n + 1) hιc_ne0) hne_top
        have htop_val : valL F K₁ ((ιLK₁ c) ^ (n + 1) * d₀ (n + 1)) = V_top := by
          rw [hvalK₁_mul ((ιLK₁ c) ^ (n + 1)) (d₀ (n + 1))
            (pow_ne_zero (n + 1) hιc_ne0) hne_top,
            (hpow_val (ιLK₁ c) hιc_ne0 (n + 1)).2, hval_ιc]
          dsimp only [V_top]
          ring
        have hlow_term : ∀ r ∈ Finset.Icc 1 n,
            (ιLK₁ c) ^ r * d₀ r = 0 ∨ V_top + 1 ≤ valL F K₁ ((ιLK₁ c) ^ r * d₀ r) := by
          intro r hr
          by_cases hdr : d₀ r = 0
          · left; rw [hdr, mul_zero]
          · right
            have hr_le : r ≤ n := (Finset.mem_Icc.mp hr).2
            have habs_le : |valL F K₁ (d₀ r) - valL F K₁ (d₀ (n + 1))| ≤ M - 1 := by
              have hsingle := Finset.single_le_sum
                (f := fun k => |valL F K₁ (d₀ k) - valL F K₁ (d₀ (n + 1))|)
                (fun k _ => abs_nonneg _) hr
              dsimp only [M]
              linarith
            have hdiff_le : valL F K₁ (d₀ (n + 1)) - valL F K₁ (d₀ r) ≤ M - 1 := by
              have hneg := neg_le_abs (valL F K₁ (d₀ r) - valL F K₁ (d₀ (n + 1)))
              linarith
            have hval_r :
                valL F K₁ ((ιLK₁ c) ^ r * d₀ r) =
                  - ((r : ℤ) * P₂) + valL F K₁ (d₀ r) := by
              rw [hvalK₁_mul ((ιLK₁ c) ^ r) (d₀ r) (pow_ne_zero r hιc_ne0) hdr,
                (hpow_val (ιLK₁ c) hιc_ne0 r).2, hval_ιc]
              ring
            rw [hval_r]
            dsimp only [V_top]
            have hstep1 : (1 : ℤ) ≤ ((n + 1 : ℕ) : ℤ) - (r : ℤ) := by omega
            have hstep2 : P₂ ≤ (((n + 1 : ℕ) : ℤ) - (r : ℤ)) * P₂ := by nlinarith
            linarith
        have hlow_sum := hsum_valK₁ (Finset.Icc 1 n) (fun r => (ιLK₁ c) ^ r * d₀ r)
          (V_top + 1) hlow_term
        have hsplit :
            (∑ r ∈ Finset.Icc 1 (n + 1), (ιLK₁ c) ^ r * d₀ r) =
              (∑ r ∈ Finset.Icc 1 n, (ιLK₁ c) ^ r * d₀ r) +
                (ιLK₁ c) ^ (n + 1) * d₀ (n + 1) :=
          Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => (ιLK₁ c) ^ r * d₀ r)
        have hsum0 :
            (∑ r ∈ Finset.Icc 1 n, (ιLK₁ c) ^ r * d₀ r) +
              (ιLK₁ c) ^ (n + 1) * d₀ (n + 1) = 0 := by
          rw [← hsplit]
          exact hd c
        have heq_neg :
            (ιLK₁ c) ^ (n + 1) * d₀ (n + 1) =
              - (∑ r ∈ Finset.Icc 1 n, (ιLK₁ c) ^ r * d₀ r) := by
          linear_combination hsum0
        rcases hlow_sum with hlow0 | hlow_ge
        · rw [hlow0, neg_zero] at heq_neg
          exact htop_ne0 heq_neg
        · dsimp only at hlow_ge
          have hval_eq :
              valL F K₁ ((ιLK₁ c) ^ (n + 1) * d₀ (n + 1)) =
                valL F K₁ (∑ r ∈ Finset.Icc 1 n, (ιLK₁ c) ^ r * d₀ r) := by
            rw [heq_neg, hvalK₁_neg]
          linarith [htop_val, hval_eq, hlow_ge]
      have hd_low : ∀ c : L, (∑ r ∈ Finset.Icc 1 n, (ιLK₁ c) ^ r * d₀ r) = 0 := by
        intro c
        have hsplit :=
          Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => (ιLK₁ c) ^ r * d₀ r)
        rw [hd c, hd_top, mul_zero, add_zero] at hsplit
        exact hsplit.symm
      intro r hr
      rcases Nat.eq_or_lt_of_le (Finset.mem_Icc.mp hr).2 with rfl | hlt
      · exact hd_top
      · exact ih d₀ hd_low r
          (Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp hr).1, Nat.lt_succ_iff.mp hlt⟩)
  have hp_mem : p ∈ Finset.Icc 1 (p ^ 2) := by
    rw [Finset.mem_Icc]
    refine ⟨hp_pos, ?_⟩
    nlinarith
  have hdp0 : d p = 0 := hpoly_zero (p ^ 2) d hdiff_sum_zero p hp_mem
  have hAp_eq_Bp :
      IntermediateField.inclusion hM₁'K₁ (A p) =
        IntermediateField.inclusion hE'K₁ (B p) :=
    sub_eq_zero.mp hdp0
  have hAp' : A p = IntermediateField.inclusion hLM₁'
      (traceLM F hLM₁' b + normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed) := hAp
  have hBp' : B p = IntermediateField.inclusion hLE'
      (traceLM F hLE' a + normLM F hLE' e_E1 + traceLM F hLE' Z'_mixed) := hBp
  rw [hAp', hBp', hincl_diamond, hincl_E'K₁] at hAp_eq_Bp
  have hL_eq :
      traceLM F hLM₁' b + normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed =
        traceLM F hLE' a + normLM F hLE' e_E1 + traceLM F hLE' Z'_mixed :=
    hιLK₁_inj hAp_eq_Bp
  have htr_diff_eq :
      traceLM F hLM₁' b - traceLM F hLE' a =
        (normLM F hLE' e_E1 + traceLM F hLE' Z'_mixed) +
          (- (normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed)) := by
    linear_combination hL_eq
  have htr_Z :
      traceLM F hLM₁' Z_mixed = 0 ∨ (bE' : ℤ) ≤ valL F L (traceLM F hLM₁' Z_mixed) :=
    htr_LM₁' (bE' : ℤ) Z_mixed hZ_mixed
  have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hZ'_bound :
      Z'_mixed = 0 ∨
        (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ valL F E' Z'_mixed := by
    rcases hZ'_mixed with h0 | hle
    · exact Or.inl h0
    · right
      have heq_bE' : (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) = (bE' : ℤ) := by
        rw [hp_sub]
        ring
      rw [heq_bE']
      exact hle
  have htr_Z' :
      traceLM F hLE' Z'_mixed = 0 ∨ (bE' : ℤ) ≤ valL F L (traceLM F hLE' Z'_mixed) :=
    htr_LE' (bE' : ℤ) Z'_mixed hZ'_bound
  have hS_E' :
      normLM F hLE' e_E1 + traceLM F hLE' Z'_mixed = 0 ∨
        (bE' : ℤ) ≤ valL F L (normLM F hLE' e_E1 + traceLM F hLE' Z'_mixed) :=
    hvalL_add (bE' : ℤ) (normLM F hLE' e_E1) (traceLM F hLE' Z'_mixed) hnorm_E1 htr_Z'
  have hS_M₁' :
      normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed = 0 ∨
        (bE' : ℤ) ≤ valL F L (normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed) :=
    hvalL_add (bE' : ℤ) (normLM F hLM₁' e_M1) (traceLM F hLM₁' Z_mixed) hnorm_M1 htr_Z
  have hS_M₁'_neg :
      - (normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed) = 0 ∨
        (bE' : ℤ) ≤ valL F L (- (normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed)) := by
    rcases hS_M₁' with h0 | hle
    · left; rw [h0, neg_zero]
    · right; rw [hvalL_neg]; exact hle
  rw [htr_diff_eq]
  exact hvalL_add (bE' : ℤ)
    (normLM F hLE' e_E1 + traceLM F hLE' Z'_mixed)
    (- (normLM F hLM₁' e_M1 + traceLM F hLM₁' Z_mixed))
    hS_E' hS_M₁'_neg

theorem ld_wild_odd_bicyclic_weight_p_orbit_trace_norm_congr (F : Type u) [Field F]
