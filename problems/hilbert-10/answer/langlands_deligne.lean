  have hx_val : (q₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ) := hx.resolve_left hx_ne
  have hmul_X_gen : ∀ (Y : M₁') (B_Y : ℤ),
      ((p * t₂ + 1 : ℕ) : ℤ) ≤ (q₁ : ℤ) + (k : ℤ) * (t₁ : ℤ) + B_Y →
      (Y = 0 ∨ B_Y ≤ valL F M₁' Y) →
      (IntermediateField.inclusion hLM₁' X * Y = 0 ∨
        ((p * t₂ + 1 : ℕ) : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' X * Y)) := by
    intro Y B_Y hB_Y hY
    by_cases hX_zero : IntermediateField.inclusion hLM₁' X = 0
    · exact Or.inl (by rw [hX_zero, zero_mul])
    · rcases hY with rfl | hY_val
      · exact Or.inl (mul_zero _)
      · by_cases hY_zero : Y = 0
        · exact Or.inl (by rw [hY_zero, mul_zero])
        · right
          have hval_X : valL F M₁' (IntermediateField.inclusion hLM₁' X) = (p : ℤ) * valL F E' x := by
            rw [hval_LM₁' X, hval_norm_LE' x]
          rw [hvalM₁'_mul _ _ hX_zero hY_zero, hval_X]
          linarith
  have hk_pow_mem_2_p : k_pow ∈ Finset.Icc 2 p := by
    rw [Finset.mem_Icc]; dsimp [k_pow]; omega
  let V_pert : ℤ := ((p * t₂ + 1 : ℕ) : ℤ) + (t₁ : ℤ) - (q₁ : ℤ)
  have hk_pow_z : (k_pow : ℤ) = (k : ℤ) + 1 := by dsimp [k_pow]
  have h1 : IntermediateField.inclusion hLM₁' X *
      (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - P_k) = 0 ∨
      ((p * t₂ + 1 : ℕ) : ℤ) ≤
        valL F M₁' (IntermediateField.inclusion hLM₁' X *
          (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - P_k)) := by
    apply hmul_X_gen _ (V_pert - (k_pow : ℤ) * (t₁ : ℤ))
    · dsimp only [V_pert]
      rw [hk_pow_z]
      linarith
    · exact hPert_bound k_pow hk_pow_mem_2_p
  by_cases hkp1 : (k : ℕ) = p - 1
  · have hk_ne_p2 : (k : ℕ) ≠ p - 2 := by omega
    have hk_pow_eq_p : k_pow = p := by dsimp [k_pow]; omega
    have h2 : IntermediateField.inclusion hLM₁' X * (P_k - Q_k) = 0 ∨
        ((p * t₂ + 1 : ℕ) : ℤ) ≤
          valL F M₁' (IntermediateField.inclusion hLM₁' X * (P_k - Q_k)) := by
      apply hmul_X_gen (P_k - Q_k) (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ))
      · have hk_z : (k : ℤ) = ((p - 1 : ℕ) : ℤ) := by exact_mod_cast hkp1
        rw [hk_z, hp1_z, hp2_z, hpt₂_z]
        linarith
      · dsimp only [P_k, Q_k]
        rw [hk_pow_eq_p]
        exact hPp_Qp_bound
    have hsum := hvalM₁'_add ((p * t₂ + 1 : ℕ) : ℤ) _ _ h1 h2
    have hring : IntermediateField.inclusion hLM₁' X *
          (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - P_k) +
        IntermediateField.inclusion hLM₁' X * (P_k - Q_k) =
        IntermediateField.inclusion hLM₁' X *
          (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - Q_k) := by ring
    rw [hring] at hsum
    exact hkne_psi hk_ne_p2 hsum
  · have hk_le_p2 : (k : ℕ) ≤ p - 2 := by omega
    have hk_pow_mem : k_pow ∈ Finset.Icc 2 (p - 1) := by
      rw [Finset.mem_Icc]; dsimp [k_pow]; omega
    let B_k : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k_pow : ℤ) * (t₁ : ℤ)
    have hBk_ineq : ((p * t₂ + 1 : ℕ) : ℤ) ≤ (q₁ : ℤ) + (k : ℤ) * (t₁ : ℤ) + B_k := by
      dsimp only [B_k]
      rw [hk_pow_z, hp1_z, hpt₂_z]
      linarith
    let P_main : M₁' := ((p : ℕ) : M₁') * b ^ k_pow +
      (if k_pow = p - 1 then ((p - 1 : ℕ) : M₁') else 0) +
      ∑ v ∈ Finset.range (k_pow + 1),
        (-1 : M₁') ^ (p - k_pow + v) * ((p - 1 : ℕ) : M₁') *
          ((k_pow.choose (v + 1) : ℕ) : M₁') * S_prod v (p - k_pow + v)
    let Q_main : M₁' := ((p : ℕ) : M₁') * b ^ k_pow +
      ∑ v ∈ Finset.range (k_pow + 1),
        (-1 : M₁') ^ (k_pow - v) * ((k_pow.choose v : ℕ) : M₁') * S_last v (p - k_pow + v)
    let diff_fn : ℕ → M₁' := fun v =>
      (-1 : M₁') ^ (p - k_pow + v) * ((p - 1 : ℕ) : M₁') *
          ((k_pow.choose (v + 1) : ℕ) : M₁') * S_prod v (p - k_pow + v) -
        (-1 : M₁') ^ (k_pow - v) * ((k_pow.choose v : ℕ) : M₁') * S_last v (p - k_pow + v)
    have hPQ_err : (P_k - P_main) - (Q_k - Q_main) = 0 ∨
        B_k ≤ valL F M₁' ((P_k - P_main) - (Q_k - Q_main)) :=
      hvalM₁'_sub B_k (P_k - P_main) (Q_k - Q_main)
        (hP_exp k_pow hk_pow_mem) (hQ_exp k_pow hk_pow_mem)
    by_cases hkeq : (k : ℕ) = p - 2
    · have hk_pow_eq : k_pow = p - 1 := by dsimp [k_pow]; omega
      have hsum_low : (∑ v ∈ Finset.range (p - 1), diff_fn v) = 0 ∨
          B_k ≤ valL F M₁' (∑ v ∈ Finset.range (p - 1), diff_fn v) := by
        apply hvalM₁'_sum (Finset.range (p - 1)) diff_fn B_k
        intro v hv
        rw [Finset.mem_range] at hv
        exact hSwap k_pow hk_pow_mem v (by omega) (by omega)
      have hOrbit' : S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p = 0 ∨
          B_k ≤ valL F M₁' (S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p) := by
        dsimp [B_k]
        rw [hk_pow_eq]
        exact hOrbit
      have hmain_diff := hvalM₁'_sub B_k (∑ v ∈ Finset.range (p - 1), diff_fn v)
        (S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p) hsum_low hOrbit'
      have hcomb := hvalM₁'_add B_k ((P_k - P_main) - (Q_k - Q_main)) _ hPQ_err hmain_diff
      have htop_term : diff_fn (p - 1) = - S_last (p - 1) p := by
        dsimp only [diff_fn]
        have hchoose0 : k_pow.choose (p - 1 + 1) = 0 :=
          Nat.choose_eq_zero_of_lt (by omega)
        have hchoose1 : k_pow.choose (p - 1) = 1 := by
          rw [hk_pow_eq]
          exact Nat.choose_self (p - 1)
        have hsub0 : k_pow - (p - 1) = 0 := by omega
        have hweight_p : p - k_pow + (p - 1) = p := by omega
        rw [hchoose0, hchoose1, hsub0, hweight_p]
        simp
      have hsum_split : ∑ v ∈ Finset.range (k_pow + 1), diff_fn v =
          (∑ v ∈ Finset.range (p - 1), diff_fn v) - S_last (p - 1) p := by
        rw [hk_pow_eq, Finset.sum_range_succ, htop_term, sub_eq_add_neg]
      have hring_comb : ((P_k - P_main) - (Q_k - Q_main)) +
          ((∑ v ∈ Finset.range (p - 1), diff_fn v) -
            (S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p)) =
          P_k - Q_k - ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) := by
        have hPM_QM : P_main - Q_main =
            ((p - 1 : ℕ) : M₁') + ∑ v ∈ Finset.range (k_pow + 1), diff_fn v := by
          dsimp only [P_main, Q_main, diff_fn]
          rw [if_pos hk_pow_eq, Finset.sum_sub_distrib]
          ring
        have hsub_id : (P_k - P_main) - (Q_k - Q_main) = (P_k - Q_k) - (P_main - Q_main) := by ring
        rw [hsub_id, hPM_QM, hsum_split, he_def_one]
        ring
      rw [hring_comb] at hcomb
      have h2 := hmul_X_gen _ B_k hBk_ineq hcomb
      have hsum := hvalM₁'_add ((p * t₂ + 1 : ℕ) : ℤ) _ _ h1 h2
      have hring : IntermediateField.inclusion hLM₁' X *
            (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - P_k) +
          IntermediateField.inclusion hLM₁' X *
            (P_k - Q_k - ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p)) =
          IntermediateField.inclusion hLM₁' X *
            (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - Q_k -
              ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p)) := by ring
      rw [hring] at hsum
      exact hkeq_psi hkeq hsum
    · have hk_pow_ne : k_pow ≠ p - 1 := by dsimp [k_pow]; omega
      have hsum_diff : (∑ v ∈ Finset.range (k_pow + 1), diff_fn v) = 0 ∨
          B_k ≤ valL F M₁' (∑ v ∈ Finset.range (k_pow + 1), diff_fn v) := by
        apply hvalM₁'_sum (Finset.range (k_pow + 1)) diff_fn B_k
        intro v hv
        rw [Finset.mem_range] at hv
        exact hSwap k_pow hk_pow_mem v (by omega) (by dsimp [k_pow] at hv; omega)
      have hcomb := hvalM₁'_add B_k ((P_k - P_main) - (Q_k - Q_main))
        (∑ v ∈ Finset.range (k_pow + 1), diff_fn v) hPQ_err hsum_diff
      have hring_comb : ((P_k - P_main) - (Q_k - Q_main)) +
          (∑ v ∈ Finset.range (k_pow + 1), diff_fn v) = P_k - Q_k := by
        dsimp only [P_main, Q_main, diff_fn]
        rw [if_neg hk_pow_ne, Finset.sum_sub_distrib]
        ring
      rw [hring_comb] at hcomb
      have h2 := hmul_X_gen (P_k - Q_k) B_k hBk_ineq hcomb
      have hsum := hvalM₁'_add ((p * t₂ + 1 : ℕ) : ℤ) _ _ h1 h2
      have hring : IntermediateField.inclusion hLM₁' X *
            (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - P_k) +
          IntermediateField.inclusion hLM₁' X * (P_k - Q_k) =
          IntermediateField.inclusion hLM₁' X *
            (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k_pow)) - Q_k) := by ring
      rw [hring] at hsum
      exact hkne_psi hkeq hsum

theorem ld_ch12_wild_odd_upper_edge_symm_bridge_and_deep_filt (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hBK : B ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hWild : p = EllipticRootNumber.p F)
    (hp_odd : EllipticRootNumber.p F ≠ 2)
    (hdegBK : Module.finrank B (IntermediateField.extendScalars hBK) = p)
    (T q₁ m_B : ℕ) (hT_ge2 : 2 ≤ T)
    (hval_norm_BK : ∀ w : K₁, valL F B (normLM F hBK w) = valL F K₁ w)
    (htr_BK : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ valL F K₁ w) →
      (traceLM F hBK w = 0 ∨ m ≤ valL F B (traceLM F hBK w)))
    (s : K₁ → ℕ → B)
    (hs_val : ∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * q →
        (s w r = 0 ∨ m ≤ valL F B (s w r)))
    (hs_norm_one_add : ∀ w : K₁,
      normLM F hBK (1 + w) - 1 =
        (∑ r ∈ Finset.Icc 1 (p - 1), s w r) + normLM F hBK w)
    (hs_newton1 : ∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      (-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s w r - traceLM F hBK (w ^ r) =
        - ∑ j ∈ Finset.Icc 1 (r - 1),
            (-1 : B) ^ (j - 1) * s w j * traceLM F hBK (w ^ (r - j))) :
    let P_B := fun z : B => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : B)⁻¹ * z ^ j
    (∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : B) ≠ 0 ∧ valL F B (((j : ℕ) : B)⁻¹) = 0) ∧
    (∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
      (1 - normLM F hBK (1 - w) =
        (∑ r ∈ Finset.Icc 1 (p - 1), (- s (-w) r)) + normLM F hBK w) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        traceLM F hBK (w ^ r) =
          ((r : ℕ) : B) * (- s (-w) r) +
            ∑ l ∈ Finset.Icc 1 (r - 1), (- s (-w) l) * traceLM F hBK (w ^ (r - l))) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        (- s (-w) r) = 0 ∨
          (((q₁ + (p - 1) * T) / p : ℕ) : ℤ) ≤ valL F B (- s (-w) r)) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        traceLM F hBK (w ^ r) = 0 ∨
          (((q₁ + (p - 1) * T) / p : ℕ) : ℤ) ≤ valL F B (traceLM F hBK (w ^ r))) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        (- s (-w) r) = 0 ∨
          (r : ℤ) * (q₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) ≤
            (p : ℤ) * valL F B (- s (-w) r)) ∧
      (normLM F hBK w = 0 ∨ (q₁ : ℤ) ≤ valL F B (normLM F hBK w))) ∧
    (∀ w : K₁, (w = 0 ∨ ((p * m_B : ℕ) : ℤ) ≤ valL F K₁ w) →
      let u_B := 1 - normLM F hBK (1 - w)
      (u_B = 0 ∨ (m_B : ℤ) ≤ valL F B u_B) ∧
      (P_B u_B = 0 ∨ (m_B : ℤ) ≤ valL F B (P_B u_B))) :=
by
  intro P_B
  have hval_props : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L],
      valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) := by
    intro L _
    have halg : ∀ z : L,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F L = (minpoly F z).natDegree * m := by
      clear hWild hp_odd hval_norm_BK htr_BK hs_val
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq L.val L.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
