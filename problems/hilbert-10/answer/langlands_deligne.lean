      have h2 := hmul_K₁ _ _ _ _ h1 hW3_or
      have h3 := hmul_K₁ _ _ _ _ h2 hAp1_or
      have h4 := hmul_K₁ _ _ _ _ h3 hDinv2_or
      rcases h4 with h0 | hle
      · exact Or.inl h0
      · right
        apply le_trans _ hle
        rw [← sub_nonneg]
        have hid :
            v_wt + 0 + - 3 * (p : ℤ) * (p : ℤ) * (m : ℤ) +
                - ((p - 1 : ℕ) : ℤ) * (p : ℤ) * (p : ℤ) * (m : ℤ) +
                2 * (p : ℤ) * (p : ℤ) * (p : ℤ) * (m : ℤ) - K =
              (a_p ^ 2 + 6 * a_p + 7) * a_pm + (a_p ^ 2 + 6 * a_p + 6) +
                (a_p ^ 2 + 5 * a_p + 4) * (t₁ : ℤ) + (a_p + 1) * (p : ℤ) * a_d := by
