      intro k
      dsimp only [w_bar]
      have h_inter : π (rightTransRep F H k.1 w₀) = σ k.1 (π w₀) :=
        LinearMap.congr_fun (hπ_inter k.1) w₀
      rw [← h_inter, h_tau_M k, map_smul]
      rfl
    have hψ_on_C : ∀ c : C, (ψ_lam ⟨c.1, hC_le c.2⟩ : Ω F) = lam c := by
      intro c
      change w₀.1 c.1 = lam c
      have h1 : c.1 = 1 * c.1 := (one_mul c.1).symm
      rw [h1]
      exact hw₀_eval 1 H.one_mem c
