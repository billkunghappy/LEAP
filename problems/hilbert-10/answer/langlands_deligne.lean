      (z = 0 ∨ (q₀ : ℤ) ≤ valL F A z) →
      (R = 0 ∨ (q₀ : ℤ) + (m : ℤ) ≤ valL F A R) →
      ((z + R) ^ (k + 1) - z ^ (k + 1) = 0 ∨
        ((k + 1 : ℕ) : ℤ) * (q₀ : ℤ) + (m : ℤ) ≤ valL F A ((z + R) ^ (k + 1) - z ^ (k + 1))) := by
