      rwa [map_natCast (algebraMap F K) (p F)] at h
    have hp_kK : ((p F : ℕ) : k_K) = 0 := by
      rw [← (hresK_nat (p F)).2]
      exact (hresK_ker ((p F : ℕ) : K) (hresK_nat (p F)).1).mpr hp_valK
    have hfrob_p_inj : Function.Injective (fun a : k_K => a ^ (p F)) := by
      intro a₁ a₂ h
      change a₁ ^ (p F) = a₂ ^ (p F) at h
      set d : k_K := a₁ - a₂
      have ha₁_eq : a₁ = a₂ + d := by dsimp [d]; ring
      have h_exp : (a₂ + d) ^ (p F) =
