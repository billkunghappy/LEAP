      have hbE'1_ge1 : 1 ≤ bE' - 1 := by omega
      have hmul_ge1 : 1 ≤ (p - 1) * (bE' - 1) := by nlinarith [hp1_ge2, hbE'1_ge1]
      have hbt_ge_p : p ≤ p * (p - 1) * (bE' - 1) := by
        calc p = p * 1 := (Nat.mul_one p).symm
          _ ≤ p * ((p - 1) * (bE' - 1)) := Nat.mul_le_mul_left p hmul_ge1
          _ = p * (p - 1) * (bE' - 1) := (Nat.mul_assoc p (p - 1) (bE' - 1)).symm
      have hbt_int : (p : ℤ) ≤ ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) := by
        exact_mod_cast hbt_ge_p
      have hp_int_ge3 : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
      have hge_p : (p : ℤ) ≤ (p : ℤ) * valL F M₁' ((p : ℕ) : M₁') := le_trans hbt_int hge
      by_contra hlt
      have hle0 : valL F M₁' ((p : ℕ) : M₁') ≤ 0 := by omega
      nlinarith [hp_int_ge3, hge_p, hle0]
  have hBinomTail :
      (∀ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁') ≠ 0) →
      ∀ y x : M₁',
        P_M₁' (y + x - y * x) - P_M₁' y - P_M₁' x =
          - ∑ a ∈ Finset.Icc 1 (p - 1),
              ((a : ℕ) : M₁')⁻¹ * y ^ a *
                (∑ m ∈ Finset.range a, ((p - 1).choose m : M₁') * (1 - x) ^ m * x ^ (p - 1 - m)) :=
    fun hj_ne0 y x => ld_trunc_log_binomial_tail_ring_identity M₁' p hPrime hp_odd hj_ne0 y x
  have hCobound_q :=
    ld_ch12_wild_odd_tot_ram_symm_norm_char_coboundary_eval_on_q_p3
      F L M₁' hLM₁' p hPrime hp_odd ψ νE' νM₁'
      hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd hp_valM₁' hnM₁'_eq
      hvalL_props hvalM₁'_props hval_LM₁' χ₁ c_νE' hc_νE'_val
      (normLM F hM₁'K₁ (Δ : K₁)) (- e_Δ (p - 1)) hb_val hχ₁_log hψM₁'_triv
      hBinomTail k σ hσ_L hσ_symm_shift hσ_char hσ_b_shift
  exact ⟨he_p1_eq, k, hk_mem, hCobound_q⟩

theorem ld_ch12_wild_odd_tot_ram_symm_norm_char_direct_eval_on_q_p3 (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (p ∣ (condExp F L νM₁' - 1)))
    (hp_valL : ((p : ℕ) : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((p : ℕ) : L))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) = (p : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (condExp F L νM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_νE'_log :
      let c₂ := (condExp F L νE' + p - 1) / p
      ∀ u : L, (u = 0 ∨ (c₂ : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (νE' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
            ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j)))
    (hNormLog_M₁' :
      let bM₁' := condExp F L νM₁'
      let q₀ := (bM₁' + p - 1) / p
      let P_L := fun u : L => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
      let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
      ∀ (h : ℕ) (z : M₁'), (z = 0 ∨ ((q₀ + h : ℕ) : ℤ) ≤ valL F M₁' z) →
        let u_z := 1 - normLM F hLM₁' (1 - z)
        (u_z = 0 ∨ (q₀ : ℤ) ≤ valL F L u_z) ∧
        (P_L u_z - (traceLM F hLM₁' (P_M₁' z) + normLM F hLM₁' (P_M₁' z)) = 0 ∨
          ((bM₁' + h : ℕ) : ℤ) ≤
            valL F L (P_L u_z - (traceLM F hLM₁' (P_M₁' z) + normLM F hLM₁' (P_M₁' z)))))
    (hψ_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) :
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let t₁ := bM₁' - 1
    let ct := (t₁ + p - 1) / p
    let q := (bE' - bM₁') + ct
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    let ψM₁' := traceChar F hLM₁' ψ
    let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
    (∀ (m : ℤ), 0 ≤ m → ∀ z : M₁',
      (z = 0 ∨ m ≤ valL F M₁' z) → (P_M₁' z = 0 ∨ m ≤ valL F M₁' (P_M₁' z))) ∧
    (∀ x : M₁', (x = 0 ∨ (q : ℤ) ≤ valL F M₁' x) →
      ∀ hx : 1 - x ≠ 0,
        ((ξM₁' (Units.mk0 (1 - x) hx) : Ω F)⁻¹) ^ 2 =
          ψM₁' (2 * IntermediateField.inclusion hLM₁' (((c_νE'⁻¹ : Lˣ) : L)) * P_M₁' x) *
            ψ (2 * ((c_νE'⁻¹ : Lˣ) : L) * normLM F hLM₁' (P_M₁' x))) :=
by
  classical
  intro bE' bM₁' t₁ ct q ξM₁' ψM₁' P_M₁'
  set P_L : L → L := fun u => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
  set c₂ : ℕ := (bE' + p - 1) / p
  set q₀ : ℕ := (bM₁' + p - 1) / p
  set α : L := ((c_νE'⁻¹ : Lˣ) : L)
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := Nat.lt_of_le_of_ne hp_ge2 (Ne.symm hp_odd)
  have ht₁_ge1 : 1 ≤ t₁ := Nat.le_sub_of_add_le hbM₁'_ge2
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    _, hval_add_L, _, _, _⟩ := hvalL_props
  obtain ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
    hval_ex_M₁', hval_add_M₁', _, _, _⟩ := hvalM₁'_props
  have hmul_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rw [hval_mul_L x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hneg_L : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hx_ge
    · exact Or.inl neg_zero
    · right; rw [hval_neg_L x]; exact hx_ge
  have hsub_L : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_L k x (-y) hx (hneg_L k y hy)
  have hmono_L : ∀ (k₁ k₂ : ℤ) (x : L),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx_ge
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx_ge)
  have hpow_L : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) →
        ∀ n : ℕ, x ^ n = 0 ∨ (n : ℤ) * k ≤ valL F L (x ^ n) := by
    intro k x hx n
    induction n with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul, hval1_L]
      exact Or.inr le_rfl
    | succ n ih =>
      rw [pow_succ]
      have hmul := hmul_L ((n : ℤ) * k) k (x ^ n) x ih hx
      have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by push_cast; ring
      rwa [heq]
  have hsum_L : ∀ (S : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction' S using Finset.induction_on with a s ha ih
    · rw [Finset.sum_empty]; exact Or.inl rfl
    · rw [Finset.sum_insert ha]
      exact hval_add_L k (f a) (∑ i ∈ s, f i)
        (hS a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
  have hstrict_L : ∀ (w₁ w₂ : L),
      w₁ ≠ 0 → (w₂ = 0 ∨ valL F L w₁ + 1 ≤ valL F L w₂) →
        w₁ + w₂ ≠ 0 ∧ valL F L (w₁ + w₂) = valL F L w₁ := by
    intro w₁ w₂ hw₁ hw₂
    have hw₁_ge : w₁ = 0 ∨ valL F L w₁ ≤ valL F L w₁ := Or.inr le_rfl
    have hw₂_ge : w₂ = 0 ∨ valL F L w₁ ≤ valL F L w₂ := by
      rcases hw₂ with rfl | hge
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hsum_ge := hval_add_L (valL F L w₁) w₁ w₂ hw₁_ge hw₂_ge
    have hsum_ne0 : w₁ + w₂ ≠ 0 := by
      intro h0
      have hw₂_eq : w₂ = -w₁ := eq_neg_of_add_eq_zero_right h0
      rcases hw₂ with hw₂0 | hge
      · exact hw₁ (neg_eq_zero.mp (hw₂_eq.symm.trans hw₂0))
      · rw [hw₂_eq, hval_neg_L w₁] at hge
        omega
    have hge1 : valL F L w₁ ≤ valL F L (w₁ + w₂) := hsum_ge.resolve_left hsum_ne0
    have hle1 : valL F L (w₁ + w₂) ≤ valL F L w₁ := by
      by_contra hlt
      push_neg at hlt
      have hsum_ge' : w₁ + w₂ = 0 ∨ valL F L w₁ + 1 ≤ valL F L (w₁ + w₂) := Or.inr (by omega)
      have hnw₂_ge : -w₂ = 0 ∨ valL F L w₁ + 1 ≤ valL F L (-w₂) :=
        hneg_L (valL F L w₁ + 1) w₂ hw₂
      have hw₁_back := hval_add_L (valL F L w₁ + 1) (w₁ + w₂) (-w₂) hsum_ge' hnw₂_ge
      rw [add_neg_cancel_right] at hw₁_back
      have hbad := hw₁_back.resolve_left hw₁
      omega
    exact ⟨hsum_ne0, le_antisymm hle1 hge1⟩
  have hnat_L : ∀ n : ℕ, (n : L) = 0 ∨ 0 ≤ valL F L (n : L) := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero]; exact Or.inl rfl
    | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one]
      exact hval_add_L 0 (n : L) 1 ih (Or.inr (by rw [hval1_L]))
  have hint_L : ∀ z : ℤ, (z : L) = 0 ∨ 0 ≤ valL F L (z : L) := by
    intro z
    cases z with
    | ofNat n =>
      rw [Int.ofNat_eq_natCast, Int.cast_natCast]
      exact hnat_L n
    | negSucc n =>
      rw [Int.cast_negSucc]
      exact hneg_L 0 (((n + 1 : ℕ) : L)) (hnat_L (n + 1))
  have hmul_M₁' : ∀ (k₁ k₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rw [hval_mul_M₁' x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hneg_M₁' : ∀ (k : ℤ) (x : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (-x = 0 ∨ k ≤ valL F M₁' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx_ge
    · exact Or.inl neg_zero
    · right; rw [hval_neg_M₁' x]; exact hx_ge
  have hsub_M₁' : ∀ (k : ℤ) (x y : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x - y = 0 ∨ k ≤ valL F M₁' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_M₁' k x (-y) hx (hneg_M₁' k y hy)
  have hmono_M₁' : ∀ (k₁ k₂ : ℤ) (x : M₁'),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M₁' x) → (x = 0 ∨ k₁ ≤ valL F M₁' x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx_ge
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx_ge)
  have hpow_M₁' : ∀ (k : ℤ) (x : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) →
        ∀ n : ℕ, x ^ n = 0 ∨ (n : ℤ) * k ≤ valL F M₁' (x ^ n) := by
    intro k x hx n
    induction n with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul, hval1_M₁']
      exact Or.inr le_rfl
    | succ n ih =>
      rw [pow_succ]
      have hmul := hmul_M₁' ((n : ℤ) * k) k (x ^ n) x ih hx
      have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by push_cast; ring
      rwa [heq]
  have hsum_M₁' : ∀ (S : Finset ℕ) (f : ℕ → M₁') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M₁' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M₁' (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction' S using Finset.induction_on with a s ha ih
    · rw [Finset.sum_empty]; exact Or.inl rfl
    · rw [Finset.sum_insert ha]
      exact hval_add_M₁' k (f a) (∑ i ∈ s, f i)
        (hS a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
  have hstrict_M₁' : ∀ (w₁ w₂ : M₁'),
      w₁ ≠ 0 → (w₂ = 0 ∨ valL F M₁' w₁ + 1 ≤ valL F M₁' w₂) →
        w₁ + w₂ ≠ 0 ∧ valL F M₁' (w₁ + w₂) = valL F M₁' w₁ := by
    intro w₁ w₂ hw₁ hw₂
    have hw₁_ge : w₁ = 0 ∨ valL F M₁' w₁ ≤ valL F M₁' w₁ := Or.inr le_rfl
    have hw₂_ge : w₂ = 0 ∨ valL F M₁' w₁ ≤ valL F M₁' w₂ := by
      rcases hw₂ with rfl | hge
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hsum_ge := hval_add_M₁' (valL F M₁' w₁) w₁ w₂ hw₁_ge hw₂_ge
    have hsum_ne0 : w₁ + w₂ ≠ 0 := by
      intro h0
      have hw₂_eq : w₂ = -w₁ := eq_neg_of_add_eq_zero_right h0
      rcases hw₂ with hw₂0 | hge
      · exact hw₁ (neg_eq_zero.mp (hw₂_eq.symm.trans hw₂0))
      · rw [hw₂_eq, hval_neg_M₁' w₁] at hge
        omega
    have hge1 : valL F M₁' w₁ ≤ valL F M₁' (w₁ + w₂) := hsum_ge.resolve_left hsum_ne0
    have hle1 : valL F M₁' (w₁ + w₂) ≤ valL F M₁' w₁ := by
      by_contra hlt
      push_neg at hlt
      have hsum_ge' : w₁ + w₂ = 0 ∨ valL F M₁' w₁ + 1 ≤ valL F M₁' (w₁ + w₂) := Or.inr (by omega)
      have hnw₂_ge : -w₂ = 0 ∨ valL F M₁' w₁ + 1 ≤ valL F M₁' (-w₂) :=
        hneg_M₁' (valL F M₁' w₁ + 1) w₂ hw₂
      have hw₁_back := hval_add_M₁' (valL F M₁' w₁ + 1) (w₁ + w₂) (-w₂) hsum_ge' hnw₂_ge
      rw [add_neg_cancel_right] at hw₁_back
      have hbad := hw₁_back.resolve_left hw₁
      omega
    exact ⟨hsum_ne0, le_antisymm hle1 hge1⟩
  have hnat_M₁' : ∀ n : ℕ, (n : M₁') = 0 ∨ 0 ≤ valL F M₁' (n : M₁') := by
    intro n
    induction n with
