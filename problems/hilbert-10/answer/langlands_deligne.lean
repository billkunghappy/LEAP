      linarith

theorem ld_ch12_wild_odd_tot_ram_teichmuller_norm_sum_approx (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLM₁' : IsGaloisExt F L M₁') (hGalE'K₁ : IsGaloisExt F E' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (hTeich : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (b : ℕ), 2 ≤ b →
      (valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
        (∀ x : M, valL F M (-x) = valL F M x) ∧
        (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
        (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
        (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
        (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
        (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
          u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
        (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0)) →
      (((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : M) = 0 ∨
        (1 : ℤ) ≤ valL F M ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : M)) →
      ∀ (N : M), (N = 0 ∨ 0 ≤ valL F M N) →
      ∀ (τ_u τ_t : ℕ → Mˣ),
        (∀ j < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < j →
          (τ_t j : M) = (j : M) ^ ((Module.finrank L (IntermediateField.extendScalars hLE')) ^ b) ∧
          τ_u j = (τ_t j) ^ (Module.finrank L (IntermediateField.extendScalars hLE'))) →
        let p := Module.finrank L (IntermediateField.extendScalars hLE')
        (∀ j < p, 0 < j →
          (τ_t j : M) - (τ_u j : M) = 0 ∨
            (b + 1 : ℤ) ≤ valL F M ((τ_t j : M) - (τ_u j : M))) ∧
        (∀ j < p, 0 < j →
          (τ_u j : M) ^ (p - 1) - 1 = 0 ∨
            (b + 1 : ℤ) ≤ valL F M ((τ_u j : M) ^ (p - 1) - 1)) ∧
        ((∏ j ∈ (Finset.range p).erase 0, (N + (τ_u j : M))) - (N ^ (p - 1) - 1) = 0 ∨
          (b + 1 : ℤ) ≤
            valL F M
              ((∏ j ∈ (Finset.range p).erase 0, (N + (τ_u j : M))) - (N ^ (p - 1) - 1))) ∧
        (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
          (∑ j ∈ (Finset.range p).erase 0, (τ_u j : M) ^ r) -
            (if (p - 1) ∣ r then ((p - 1 : ℕ) : M) else 0) = 0 ∨
            (b + 1 : ℤ) ≤
              valL F M
                ((∑ j ∈ (Finset.range p).erase 0, (τ_u j : M) ^ r) -
                  (if (p - 1) ∣ r then ((p - 1 : ℕ) : M) else 0))))
    (s₁ : K₁ → ℕ → M₁')
    (hs₁_1 : ∀ w : K₁, s₁ w 1 = traceLM F hM₁'K₁ w)
    (hs₁_val : ∀ (w : K₁) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ (r : ℤ) * q →
        (s₁ w r = 0 ∨ m ≤ valL F M₁' (s₁ w r)))
    (hs₁_norm_one_add : ∀ w : K₁,
      normLM F hM₁'K₁ (1 + w) - 1 =
        (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          s₁ w r) + normLM F hM₁'K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')))
    (hTwistedTr : ∀ (Y : E') (i : ℕ),
      i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let d₁ := m₁ / 2
    let b := normLM F hM₁'K₁ (Δ : K₁)
    ∃ τ_unit : ℕ → Lˣ,
      (∀ m < p, 0 < m → valL F L (τ_unit m : L) = 0) ∧
      (∀ m < p, 0 < m →
        (τ_unit m : L) ^ (p - 1) - 1 = 0 ∨
          ((3 * p * m₁ + 1 : ℕ) : ℤ) ≤ valL F L ((τ_unit m : L) ^ (p - 1) - 1)) ∧
      (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
        (∑ m ∈ (Finset.range p).erase 0,
            IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
          (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0) = 0 ∨
          ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
            valL F M₁'
              ((∑ m ∈ (Finset.range p).erase 0,
                  IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
                (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0))) ∧
      ∀ (j : Fin p) (x : E'),
        1 ≤ (j : ℕ) →
        (x = 0 ∨ (d₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (j : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) →
        let k := (j : ℕ) + 1
        let X := normLM F hLE' x
        let P_k := b ^ k +
          ∑ m ∈ (Finset.range p).erase 0,
            normLM F hM₁'K₁
              ((Δ : K₁) + IntermediateField.inclusion hM₁'K₁
                (IntermediateField.inclusion hLM₁' (τ_unit m : L))) ^ k
        IntermediateField.inclusion hLM₁' X *
          (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k) = 0 ∨
          ((p * (bE' - 1) + 1 : ℕ) : ℤ) ≤
            valL F M₁'
              (IntermediateField.inclusion hLM₁' X *
                (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k)) :=
by
  intro p m₁ d₁ b
  obtain ⟨Δ_gal, hΔ_gal_tr, _, hΔ_gal_as, hδ_gal_props, hδ_gal_diff⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_lift_and_unit_diff_ne_zero F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLM₁' hGalE'K₁ hPrime hp_odd hdegM₁' hdegE'K₁
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalE'_props hvalM₁'_props hvalK₁_props
      hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁ hGalLift
      Δ hΔ_val hΔ_as hΔ_tr_top
  obtain ⟨τ_unit, Δ_conj, u_fn, c_coeff, hτ_val0, hτ_p1, hτ_pow_sum, hΔ_conj_tr, hc_dvd, hu_props⟩ :=
    ld_ch12_wild_odd_tot_ram_teichmuller_bijection_and_quotient_approx_ne_zero F L E' M₁' K₁
      hLE' hLM₁' hM₁'K₁ hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalL_props hvalM₁'_props hvalK₁_props
      hval_LM₁' hval_M₁'K₁ hTeich
      Δ hΔ_val Δ_gal hΔ_gal_tr hΔ_gal_as hδ_gal_props hδ_gal_diff
  refine ⟨τ_unit, hτ_val0, hτ_p1, hτ_pow_sum, ?_⟩
  intro j x hj_ge1 hx k X P_k
  have hval_finset_sum : ∀ (S : Finset ℕ) (f : ℕ → M₁') (q : ℤ),
      (∀ a ∈ S, f a = 0 ∨ q ≤ valL F M₁' (f a)) →
      (∑ a ∈ S, f a) = 0 ∨ q ≤ valL F M₁' (∑ a ∈ S, f a) := by
    intro S f q hS
    induction S using Finset.cons_induction with
    | empty =>
      left
      simp
    | cons a s ha ih =>
      rw [Finset.sum_cons]
      have ha_bound : f a = 0 ∨ q ≤ valL F M₁' (f a) := hS a (Finset.mem_cons_self a s)
      have hs_bound : (∑ y ∈ s, f y) = 0 ∨ q ≤ valL F M₁' (∑ y ∈ s, f y) :=
        ih (fun y hy => hS y (Finset.mem_cons_of_mem hy))
      exact hvalM₁'_props.2.2.2.2.2.2.2.1 q (f a) (∑ y ∈ s, f y) ha_bound hs_bound
  have hrew : IntermediateField.inclusion hLM₁' X *
      (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k) =
      ∑ m ∈ (Finset.range p).erase 0,
        IntermediateField.inclusion hLM₁' X *
          ((normLM F hM₁'K₁ (Δ_conj m)) ^ k -
            (normLM F hM₁'K₁
              ((Δ : K₁) + IntermediateField.inclusion hM₁'K₁
                (IntermediateField.inclusion hLM₁' (τ_unit m : L)))) ^ k) := by
    dsimp only [P_k]
    rw [hΔ_conj_tr k, add_sub_add_left_eq_sub, ← Finset.sum_sub_distrib, Finset.mul_sum]
  rw [hrew]
  apply hval_finset_sum
  intro m hm
  have hm_ne0 : m ≠ 0 := (Finset.mem_erase.mp hm).1
  have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm).2
  have hm_pos : 0 < m := Nat.pos_of_ne_zero hm_ne0
  obtain ⟨hΔ_conj_eq, hu_val, hu_approx⟩ := hu_props m hm_lt hm_pos
  have hξ_val : valL F M₁' (IntermediateField.inclusion hLM₁' (τ_unit m : L)) = 0 := by
    rw [hval_LM₁' (τ_unit m : L), hτ_val0 m hm_lt hm_pos, mul_zero]
  rw [hΔ_conj_eq]
  exact ld_ch12_wild_odd_tot_ram_multiplicative_perturbation_norm_bound F L E' M₁' K₁
    hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
    ht₁_ndvd hp_valK₁ hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
    hval_norm_LE' hval_LM₁' hval_M₁'K₁ hval_norm_M₁'K₁ htr_M₁'K₁
    s₁ hs₁_1 hs₁_val hs₁_norm_one_add Δ hΔ_val hTwistedTr
    c_coeff hc_dvd
    (IntermediateField.inclusion hLM₁' (τ_unit m : L)) hξ_val
    (u_fn m) hu_val hu_approx j x hj_ge1 hx

theorem ld_ch12_wild_odd_tot_ram_power_trace_newton_and_kp_diff (F : Type u) [Field F]
