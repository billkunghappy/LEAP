    refine ⟨htM₁'_ne, htM₁'_val, fun htM₁' => ?_⟩
    intro cνM₁'
    refine ⟨?_, ?_⟩
    · rw [hL_mul_inv α (Units.map (normLM F hLM₁') (Units.mk0 tM₁' htM₁')),
