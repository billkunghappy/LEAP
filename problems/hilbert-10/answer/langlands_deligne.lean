    hL_eq_lt 0 (2 * (e : ℤ) + 1 - (a : ℤ)) β₂ δ_tr hβ₂ hβ₂_val hδ_val (by omega)
  have hβ₁_δ : β₁ + δ_tr ≠ 0 ∧ valL F L (β₁ + δ_tr) = 2 * ((e : ℤ) - (a : ℤ)) + 1 :=
    hL_eq_lt (2 * ((e : ℤ) - (a : ℤ)) + 1) (2 * (e : ℤ) + 1 - (a : ℤ)) β₁ δ_tr
      hβ₁ hβ₁_val hδ_val (by omega)
  have hcνE'_pkg : ∀ (tE' : E'), normLM F hLE' tE' = β₂ + δ_tr →
      tE' ≠ 0 ∧
      valL F E' tE' = 0 ∧
      ∀ htE' : tE' ≠ 0,
        let cνE' : Lˣ := α * (Units.map (normLM F hLE') (Units.mk0 tE' htE'))⁻¹
        valL F L (cνE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ ∧
        ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
