  let x₀ : Lˣ := (-u_j)⁻¹ * c_νE'
  have hx₀_inv : ((x₀⁻¹ : Lˣ) : L) = - (j : L) * α₀ := by
    have h1 : x₀⁻¹ = c_νE'⁻¹ * (-u_j) := by
      dsimp [x₀]
      rw [mul_inv_rev, inv_inv]
    rw [h1, Units.val_mul, Units.val_neg]
    change α₀ * - (j : L) = - (j : L) * α₀
    ring
  have hx₀_val : valL F L (x₀ : L) = (bE' : ℤ) + condExpChar F L ψ := by
    change valL F L ((((-u_j)⁻¹ * c_νE' : Lˣ) : L)) = (bE' : ℤ) + condExpChar F L ψ
    rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
      hval_inv_L (-u_j), Units.val_neg, hval_neg_L]
    change - valL F L (j : L) + valL F L (c_νE' : L) = (bE' : ℤ) + condExpChar F L ψ
    rw [hj_L_val, neg_zero, zero_add, hc_νE'_val]

  
  have hMC_Δ' := hModelCompat_all Δ' hΔ'_val hΔ'_as
  have ha'_val : valL F E' (normLM F hE'K₁ (Δ' : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) := hMC_Δ'.1
  have hb'_val : valL F M₁' (normLM F hM₁'K₁ (Δ' : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) := hMC_Δ'.2.1
  have hCompat_Δ' := hMC_Δ'.2.2.2.2 c_νE' hc_νE'_val hc_νE'_stat
  set a' : E' := normLM F hE'K₁ (Δ' : K₁)
  set b' : M₁' := normLM F hM₁'K₁ (Δ' : K₁)
  have hb'_ne : b' ≠ 0 := by
    intro h0
    rw [h0, hval0_M₁'] at hb'_val
    omega
  set x₀_inv_M₁' : M₁' := IntermediateField.inclusion hLM₁' (((x₀⁻¹ : Lˣ) : L))
  have hx₀_inv_M₁'_ne : x₀_inv_M₁' ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLM₁')).mpr (Units.ne_zero x₀⁻¹)
