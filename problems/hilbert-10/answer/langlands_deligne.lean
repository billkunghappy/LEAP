    by_cases hδ0 : δ_w = 0
    · left
      have hw_eq : w = P_A z := sub_eq_zero.mp hδ0
      rw [hw_eq, sub_self]
    · have hδ_ge : (q₀ : ℤ) + (T : ℤ) ≤ valL F A δ_w := hδ_val.resolve_left hδ0
      have hδ_q₀ : δ_w = 0 ∨ (q₀ : ℤ) ≤ valL F A δ_w := Or.inr (by omega)
      have hnorm_δ : normLM F hLA δ_w = 0 ∨ (T : ℤ) ≤ valL F L (normLM F hLA δ_w) := by
        right
        rw [hval_norm_LA δ_w]
        have : (0 : ℤ) ≤ (q₀ : ℤ) := by omega
        omega
      have hadd_norm := hNormAdd_0 (P_A z) δ_w (hPA_val z hz) hδ_q₀
      have hw_add : P_A z + δ_w = w := by
        dsimp [δ_w]
