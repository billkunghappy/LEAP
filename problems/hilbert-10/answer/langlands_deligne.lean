              rw [inv_mul_cancel₀ hg_ne, one_mul]; ring
          _ = g⁻¹ * ((g * β₁ * (1 + 4 * f) - f * β₂ * (1 - 4 * g)) * B) := by ring
      rw [hid]
      exact hP_mono (2 * (r : ℤ)) (hP_mul hP_ginv (hP_mul hΔ_odd hB_val)) (by omega)
    rw [hψ_eq_2r _ _ hrem]
    exact hE'_scaled_odd t₁ ht₁
  have hM₁'_odd_to_even : ∀ s₁ : L, (s₁ = 0 ∨ 3 * (a : ℤ) - 1 ≤ 2 * valL F L s₁) →
      let s₀' := -(2 * (f * s₁))
      ψ (((α⁻¹ : Lˣ) : L) * (β₁ * (s₁ + f * s₁ ^ 2))) =
        ψ (((α⁻¹ : Lˣ) : L) * (β₁ * (2 * s₀' + s₀' ^ 2))) := by
    intro s₁ hs₁
    dsimp only
    have hs₁_sq : s₁ ^ 2 = 0 ∨ (3 * (a : ℤ) - 1) ≤ valL F L (s₁ ^ 2) := hP_sq_iff.mp hs₁
    set B := s₁ + f * s₁ ^ 2
    set s₀' := -(2 * (f * s₁))
    have hrem : β₁ * B - (β₁ * (1 + 4 * f) * B + β₁ * (2 * s₀' + s₀' ^ 2)) = 0 ∨
