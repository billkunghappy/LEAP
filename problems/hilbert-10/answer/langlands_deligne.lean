  set w_inv := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E'))
  set w_pow := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1))
  have hw2_inv_ne0 : ((w₂⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero w₂⁻¹
  have hw2_inv_val : valL F E' ((w₂⁻¹ : E'ˣ) : E') = ((m_exp : ℕ) : ℤ) := by
    rw [hval_inv_E' w₂, hw₂_val]
    dsimp [m_exp]; omega
  have hw_inv_ne0 : w_inv ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hw2_inv_ne0
  have hw_inv_val : valL F K₁ w_inv = ((M : ℕ) : ℤ) := by
    dsimp [w_inv, M]
    rw [hval_E'K₁, hw2_inv_val]
  have hw_pow_val : valL F K₁ w_pow = ((p - 1 : ℕ) : ℤ) * ((M : ℕ) : ℤ) := by
    dsimp [w_pow, M]
    rw [hval_E'K₁, hval_pow_E' _ (p - 1) hw2_inv_ne0, hw2_inv_val]
    ring
  have hξ_zero_or_val0 : ∀ m < p, ξ m = 0 ∨ valL F K₁ (ξ m) = 0 := by
    intro m hm
