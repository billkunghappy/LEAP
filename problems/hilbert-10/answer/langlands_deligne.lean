    have hζ_ord : orderOf ζ = ℓ := orderOf_eq_prime hζ_pow hζ_ne
    have hnorm_range_iff : ∀ z : M_Cˣ,
        z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ℓ : ℤ) ∣ valL F M_C (z : M_C) := by
      intro z
