      have hpj_cast : (((p - 1) - j : ℕ) : ℤ) = ((p - 1 : ℕ) : ℤ) - (j : ℤ) :=
        Nat.cast_sub (by omega)
      have ht_diff : ((t₂ + (bE' - bM₁') : ℕ) : ℤ) = 2 * (t₂ : ℤ) - (t₁ : ℤ) := by
        dsimp [t₁, t₂]
        omega
      rw [hpj_cast, sub_mul] at hge
      rw [ht_diff]
      linarith

  exact ⟨hTwistedTr, e_Δ, W_as, he_Δ_1, he_Δ_val, he_Δ_poly, he_Δ_cayley, he_Δ_tr_p1,
    hW_as_eq, hW_as_val⟩

theorem ld_wild_odd_bicyclic_cayley_norm_diff_basis_decomp (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ))
    (hCoeffExtr : ∀ (θ : M₁') (Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E'),
      IntermediateField.inclusion hM₁'K₁ θ =
        ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
      ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        Y i = 0 ∨ valL F M₁' θ + (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F E' (Y i))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) -
          (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_cayley : IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ : K₁)) -
      ((Δ : K₁) ^ (Module.finrank L (IntermediateField.extendScalars hLE')) +
        ∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) *
            ((Δ : K₁) ^ (Module.finrank L (IntermediateField.extendScalars hLE') - i))) = 0)
    (W_as : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E')
    (hW_as_eq : (Δ : K₁) ^ (Module.finrank L (IntermediateField.extendScalars hLE')) - (Δ : K₁) -
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) =
        ∑ l : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hE'K₁ (W_as l) * ((Δ : K₁) ^ (l : ℕ)))
    (hW_as_val : ∀ l : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
      W_as l = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) ≤
          valL F E' (W_as l)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    ∃ (Z : Fin p → E') (s₀ : E'),
      IntermediateField.inclusion hM₁'K₁ b - IntermediateField.inclusion hE'K₁ a =
        ∑ l : Fin p, IntermediateField.inclusion hE'K₁ (Z l) * ((Δ : K₁) ^ (l : ℕ)) ∧
      (s₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((bE' - bM₁' : ℕ) : ℤ) ≤ valL F E' s₀) ∧
      (IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) - IntermediateField.inclusion hE'K₁ s₀ = 0 ∨
        ((p * (p - 1) * (bE' - bM₁') + (p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) -
            IntermediateField.inclusion hE'K₁ s₀)) ∧
      (Z ⟨0, hPrime.pos⟩ = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) ≤ valL F E' (Z ⟨0, hPrime.pos⟩)) ∧
      (Z ⟨1, hPrime.one_lt⟩ - (1 - s₀) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (Z ⟨1, hPrime.one_lt⟩ - (1 - s₀))) ∧
      (∀ l : Fin p, 2 ≤ (l : ℕ) →
        Z l = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (l : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) ≤
            valL F E' (Z l)) :=
by
  have h_abs : ∀ {E₀ M₀ K₀ : Type u} [Field E₀] [Field M₀] [Field K₀]
      (vE : E₀ → ℤ) (vM : M₀ → ℤ) (vK : K₀ → ℤ)
      (ιE : E₀ →+* K₀) (ιM : M₀ →+* K₀)
      (p bE₀ bM₀ : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
      (hbE_ge2 : 2 ≤ bE₀) (hbM_ge2 : 2 ≤ bM₀) (hb_le : bM₀ ≤ bE₀)
      (hvE_neg : ∀ x : E₀, vE (-x) = vE x)
      (hvE_mul : ∀ x y : E₀, x ≠ 0 → y ≠ 0 → vE (x * y) = vE x + vE y)
      (hvE_add : ∀ (k : ℤ) (x y : E₀),
        (x = 0 ∨ k ≤ vE x) → (y = 0 ∨ k ≤ vE y) → (x + y = 0 ∨ k ≤ vE (x + y)))
      (hvK_1 : vK 1 = 0)
      (hvK_neg : ∀ x : K₀, vK (-x) = vK x)
      (hvK_mul : ∀ x y : K₀, x ≠ 0 → y ≠ 0 → vK (x * y) = vK x + vK y)
      (hvK_add : ∀ (k : ℤ) (x y : K₀),
        (x = 0 ∨ k ≤ vK x) → (y = 0 ∨ k ≤ vK y) → (x + y = 0 ∨ k ≤ vK (x + y)))
      (hv_EK : ∀ y : E₀, vK (ιE y) = (p : ℤ) * vE y)
      (a : E₀) (b : M₀) (Δ : K₀) (hΔ_ne : Δ ≠ 0)
      (hΔ_val : vK Δ = -((bM₀ - 1 : ℕ) : ℤ))
      (ha_val : vE a = -((bM₀ - 1 : ℕ) : ℤ))
      (hΔ_basis : ∀ w : K₀, ∃ Y : Fin p → E₀,
        w = ∑ i : Fin p, ιE (Y i) * (Δ ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (w = 0 ∨ m ≤ vK w) ↔
            ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * vE (Y i) - (i : ℤ) * ((bM₀ - 1 : ℕ) : ℤ))
      (hCoeffExtr : ∀ (θ : M₀) (Y : Fin p → E₀),
        ιM θ = ∑ i : Fin p, ιE (Y i) * (Δ ^ (i : ℕ)) →
        ∀ i : Fin p, Y i = 0 ∨ vM θ + (i : ℤ) * ((bM₀ - 1 : ℕ) : ℤ) ≤ vE (Y i))
      (e_Δ : ℕ → M₀)
      (he_Δ_val : ∀ i ∈ Finset.Icc 1 (p - 1),
        e_Δ i = 0 ∨
          ((p - 1 : ℕ) : ℤ) * ((bE₀ - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₀ - 1 : ℕ) : ℤ) ≤ vM (e_Δ i))
      (he_Δ_cayley : ιM b -
        (Δ ^ p + ∑ i ∈ Finset.Icc 1 (p - 1), (-1 : K₀) ^ i * ιM (e_Δ i) * (Δ ^ (p - i))) = 0)
      (W_as : Fin p → E₀)
      (hW_as_eq : Δ ^ p - Δ - ιE a = ∑ l : Fin p, ιE (W_as l) * (Δ ^ (l : ℕ)))
      (hW_as_val : ∀ l : Fin p,
        W_as l = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((bE₀ - 1 : ℕ) : ℤ) ≤ vE (W_as l)),
      ∃ (Z : Fin p → E₀) (s₀ : E₀),
        ιM b - ιE a = ∑ l : Fin p, ιE (Z l) * (Δ ^ (l : ℕ)) ∧
        (s₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((bE₀ - bM₀ : ℕ) : ℤ) ≤ vE s₀) ∧
        (ιM (- e_Δ (p - 1)) - ιE s₀ = 0 ∨
          ((p * (p - 1) * (bE₀ - bM₀) + (p - 1) * (bM₀ - 1) : ℕ) : ℤ) ≤
            vK (ιM (- e_Δ (p - 1)) - ιE s₀)) ∧
        (Z ⟨0, hPrime.pos⟩ = 0 ∨
          ((p - 1 : ℕ) : ℤ) * ((bE₀ - 1 : ℕ) : ℤ) - ((bM₀ - 1 : ℕ) : ℤ) ≤ vE (Z ⟨0, hPrime.pos⟩)) ∧
        (Z ⟨1, hPrime.one_lt⟩ - (1 - s₀) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * ((bE₀ - 1 : ℕ) : ℤ) ≤ vE (Z ⟨1, hPrime.one_lt⟩ - (1 - s₀))) ∧
        (∀ l : Fin p, 2 ≤ (l : ℕ) →
          Z l = 0 ∨
            ((p - 1 : ℕ) : ℤ) * ((bE₀ - 1 : ℕ) : ℤ) -
              ((p - (l : ℕ) : ℕ) : ℤ) * ((bM₀ - 1 : ℕ) : ℤ) ≤ vE (Z l)) := by
    clear! F bE' bM₁'
    intro E₀ M₀ K₀ _ _ _ vE vM vK ιE ιM p bE₀ bM₀ hPrime hp_odd hbE_ge2 hbM_ge2 hb_le
      hvE_neg hvE_mul hvE_add hvK_1 hvK_neg hvK_mul hvK_add hv_EK
      a b Δ hΔ_ne hΔ_val ha_val hΔ_basis hCoeffExtr e_Δ he_Δ_val he_Δ_cayley W_as hW_as_eq hW_as_val
    obtain ⟨t₁, ht₁_def⟩ : ∃ t₁ : ℕ, t₁ = bM₀ - 1 := ⟨_, rfl⟩
    obtain ⟨t₂, ht₂_def⟩ : ∃ t₂ : ℕ, t₂ = bE₀ - 1 := ⟨_, rfl⟩
    rw [← ht₁_def] at hΔ_val ha_val hΔ_basis hCoeffExtr he_Δ_val ⊢
    rw [← ht₂_def] at he_Δ_val hW_as_val ⊢
    have hvE_sum : ∀ {α : Type} (S : Finset α) (f : α → E₀) (m : ℤ),
        (∀ x ∈ S, f x = 0 ∨ m ≤ vE (f x)) →
        (∑ x ∈ S, f x) = 0 ∨ m ≤ vE (∑ x ∈ S, f x) := by
      intro α S f m hS
      induction S using Finset.induction_on with
      | empty => simp
      | @insert x s hx ih =>
        rw [Finset.sum_insert hx]
        exact hvE_add m (f x) (∑ y ∈ s, f y)
          (hS x (Finset.mem_insert_self x s))
          (ih (fun y hy => hS y (Finset.mem_insert_of_mem hy)))
    have hvK_sum : ∀ {α : Type} (S : Finset α) (f : α → K₀) (m : ℤ),
        (∀ x ∈ S, f x = 0 ∨ m ≤ vK (f x)) →
        (∑ x ∈ S, f x) = 0 ∨ m ≤ vK (∑ x ∈ S, f x) := by
      intro α S f m hS
      induction S using Finset.induction_on with
      | empty => simp
      | @insert x s hx ih =>
        rw [Finset.sum_insert hx]
        exact hvK_add m (f x) (∑ y ∈ s, f y)
          (hS x (Finset.mem_insert_self x s))
          (ih (fun y hy => hS y (Finset.mem_insert_of_mem hy)))
    have hvE_neg1_pow : ∀ (i : ℕ) (y : E₀), vE ((-1 : E₀) ^ i * y) = vE y := by
      intro i y
      rcases Nat.even_or_odd i with hi | hi
      · rw [hi.neg_one_pow, one_mul]
      · rw [hi.neg_one_pow, neg_one_mul, hvE_neg]
    have hvK_neg1_pow : ∀ (i : ℕ) (w : K₀), vK ((-1 : K₀) ^ i * w) = vK w := by
      intro i w
      rcases Nat.even_or_odd i with hi | hi
      · rw [hi.neg_one_pow, one_mul]
      · rw [hi.neg_one_pow, neg_one_mul, hvK_neg]
    have hvK_Δ_pow : ∀ k : ℕ, (Δ ^ k) ≠ 0 ∧ vK (Δ ^ k) = - (k : ℤ) * (t₁ : ℤ) := by
      intro k
      refine ⟨pow_ne_zero k hΔ_ne, ?_⟩
      induction k with
      | zero => simp [hvK_1]
      | succ k ih =>
        rw [pow_succ, hvK_mul _ _ (pow_ne_zero k hΔ_ne) hΔ_ne, ih, hΔ_val]
        push_cast
        ring
