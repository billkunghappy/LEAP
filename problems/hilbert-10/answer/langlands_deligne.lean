        have h1 : 2 * (1 + t₁) ≤ i * (p * m_exp) := Nat.mul_le_mul (by omega) hpm_ge
        have h1' : 2 + 2 * t₁ ≤ i * p * m_exp := by
          calc 2 + 2 * t₁ = 2 * (1 + t₁) := by ring
