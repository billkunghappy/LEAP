        rwa [heq]
    have hvalM₁'_neg1_pow_mul : ∀ (n : ℕ) (x : R_M),
        vM₁' ((-1 : R_M) ^ n * x) = vM₁' x := by
      intro n x
      induction n with
      | zero => rw [pow_zero, one_mul]
      | succ n ih =>
        rw [pow_succ', mul_assoc, neg_one_mul, hvalM₁'_neg, ih]
    have hvalM₁'_sum_ge : ∀ (S : Finset ℕ) (f : ℕ → R_M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ vM₁' (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ vM₁' (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvalM₁'_add k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    have hvalM₁'_natCast : ∀ n : ℕ, (n : R_M) = 0 ∨ (0 : ℤ) ≤ vM₁' (n : R_M) := by
      intro n
      induction n with
      | zero => left; exact Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hvalM₁'_add 0 (n : R_M) 1 ih (Or.inr (by rw [hvalM₁'_1]))
    have hvalM₁'_intCast : ∀ z : ℤ, (z : R_M) = 0 ∨ (0 : ℤ) ≤ vM₁' (z : R_M) := by
      intro z
      obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg z
      · rw [Int.cast_natCast]
        exact hvalM₁'_natCast n
      · rw [Int.cast_neg, Int.cast_natCast]
        rcases hvalM₁'_natCast n with h0 | hge
        · left; rw [h0, neg_zero]
        · right; rwa [hvalM₁'_neg]

    have hvalK₁_mono : ∀ (k₁ k₂ : ℤ) (x : R_K),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ vK₁ x) → (x = 0 ∨ k₁ ≤ vK₁ x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvalK₁_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : R_K),
        (x = 0 ∨ k₁ ≤ vK₁ x) → (y = 0 ∨ k₂ ≤ vK₁ y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ vK₁ (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvalK₁_mul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvalK₁_pow_ge : ∀ (x : R_K) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ vK₁ x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ vK₁ (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        rw [pow_zero, hvalK₁_1, Nat.cast_zero, zero_mul]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvalK₁_mul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvalK₁_neg1_pow_mul : ∀ (n : ℕ) (x : R_K),
        vK₁ ((-1 : R_K) ^ n * x) = vK₁ x := by
      intro n x
      induction n with
      | zero => rw [pow_zero, one_mul]
      | succ n ih =>
        rw [pow_succ', mul_assoc, neg_one_mul, hvalK₁_neg, ih]
    have hvalK₁_sum_ge : ∀ (S : Finset ℕ) (f : ℕ → R_K) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ vK₁ (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ vK₁ (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvalK₁_add k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    clear hvalK₁_1 hvalK₁_mul

    intro t₁ t₂ m₁ q₁ b V_pert
    have ht₁_def : t₁ = bM₁' - 1 := rfl
    have ht₂_def : t₂ = bE' - 1 := rfl
    have hm₁_def : m₁ = 2 * bM₁' - 1 + p * (bE' - bM₁') := rfl
    have hq₁_def : q₁ = (m₁ + p - 1) / p := rfl
    have hb_def : b = nmM₁'K₁ Δ_val := rfl
    have hV_pert_def : V_pert = ((p * t₂ + 1 : ℕ) : ℤ) + (t₁ : ℤ) - (q₁ : ℤ) := rfl
    dsimp only at hτ_pow_sum hClaimA hClaimB
    rw [← ht₁_def, ← ht₂_def] at hClaimA hClaimB he_Δ_val
    rw [← hm₁_def] at hτ_p1 hτ_pow_sum
    clear_value t₁ t₂ m₁ q₁ b V_pert

    obtain ⟨δ, hδ_def⟩ : ∃ δ : ℕ, δ = bE' - bM₁' := ⟨_, rfl⟩
    obtain ⟨T₁, hT₁_def⟩ : ∃ T₁ : ℕ, T₁ = (bM₁' - 1) + p * (bE' - bM₁') + 1 := ⟨_, rfl⟩

    have hp_pos : 0 < p := hPrime.pos
    have hp_pos_z : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
    have hp_ge2 : 2 ≤ p := hPrime.two_le
    have hp_ge3 : 3 ≤ p := by omega
    have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
    have hp1_even : Even (p - 1) := Nat.Odd.sub_odd hp_odd_nat odd_one
    have hneg1_p1_K₁ : (-1 : R_K) ^ (p - 1) = 1 := Even.neg_one_pow hp1_even
    have ht₁_ge1 : 1 ≤ t₁ := by omega
    have ht₂_ge1 : 1 ≤ t₂ := by omega
    have ht_le : t₁ ≤ t₂ := by omega
    have ht₂_eq : t₂ = t₁ + δ := by omega
    have hT₁_eq : T₁ = t₁ + p * δ + 1 := by rw [hT₁_def, ht₁_def, hδ_def]
    have hm₁_eq : m₁ = 2 * t₁ + 1 + p * δ := by
      rw [hm₁_def, ht₁_def, hδ_def]
      omega
    have hp_sub1_z : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub (by omega : 1 ≤ p)
    have hp_sub2_z : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := Nat.cast_sub (by omega : 2 ≤ p)
    have hp_sub3_z : ((p - 3 : ℕ) : ℤ) = (p : ℤ) - 3 := Nat.cast_sub (by omega : 3 ≤ p)
    have hp_sub_p1 : p - (p - 1) = 1 := by omega
    have hp_eq_p1_add1 : p = (p - 1) + 1 := by omega
    have hp1_ge1 : 1 ≤ p - 1 := by omega
    have hp1_gt1 : 1 < p - 1 := by omega
    have hp2_ge1 : 1 ≤ p - 2 := by omega

    
    have hq₁_mul : m₁ ≤ p * q₁ := by
      have hdiv := Nat.div_add_mod (m₁ + p - 1) p
      have hmod := Nat.mod_lt (m₁ + p - 1) hp_pos
      rw [← hq₁_def] at hdiv
      omega
    have hq₁_ge1 : 1 ≤ q₁ := by
      have hm₁_ge1 : 1 ≤ m₁ := by omega
      rw [hq₁_def]
      exact (Nat.le_div_iff_mul_le hp_pos).mpr (by omega)
    have hq₁_le : q₁ ≤ t₂ + 1 := by
      have h2p : 2 * t₁ ≤ p * t₁ := Nat.mul_le_mul_right t₁ hp_ge2
      have hle_mul : m₁ + p - 1 ≤ (t₂ + 1) * p := by
        have h1 : (t₂ + 1) * p = p * t₁ + p * δ + p := by rw [ht₂_eq]; ring
        omega
      rw [hq₁_def]
      exact Nat.div_le_of_le_mul (by linarith [hle_mul])

    let m₀ : ℤ := ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ)
    have hm₀_def : m₀ = ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := rfl
    clear_value m₀
    let V_nu : ℤ := ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)
    have hV_nu_def : V_nu = ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := rfl
    clear_value V_nu
    let V_lin : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ)
    have hV_lin_def : V_lin = 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := rfl
    clear_value V_lin
    let q_u : ℤ := ((p * (p - 1) * (bE' - 1) - (p - 2) * (bM₁' - 1) : ℕ) : ℤ)
    let q_err : ℤ := ((2 * p * (p - 1) * (bE' - 1) - (2 * p - 3) * (bM₁' - 1) : ℕ) : ℤ)

    have hq_u_eq : q_u = (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by
      dsimp [q_u]
      rw [← ht₁_def, ← ht₂_def]
      have hle : (p - 2) * t₁ ≤ p * (p - 1) * t₂ := by
        have h1 : p - 2 ≤ p * (p - 1) := by nlinarith
        exact Nat.mul_le_mul h1 ht_le
      rw [Nat.cast_sub hle]
      push_cast
      ring
    have hq_err_eq : q_err = 2 * (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((2 * p - 3 : ℕ) : ℤ) * (t₁ : ℤ) := by
      dsimp [q_err]
      rw [← ht₁_def, ← ht₂_def]
      have hle : (2 * p - 3) * t₁ ≤ 2 * p * (p - 1) * t₂ := by
        have h1 : 2 * p - 3 ≤ 2 * p * (p - 1) := by
          calc 2 * p - 3 ≤ 2 * p * 1 := by omega
            _ ≤ 2 * p * (p - 1) := Nat.mul_le_mul_left (2 * p) (by omega)
        exact Nat.mul_le_mul h1 ht_le
      rw [Nat.cast_sub hle]
      push_cast
      ring

    have hm₀_ge_t₂ : (t₂ : ℤ) ≤ m₀ := by
      have hmul : (p - 2) * t₁ ≤ (p - 2) * t₂ := Nat.mul_le_mul_left (p - 2) ht_le
      have hmul_z : (((p - 2) * t₁ : ℕ) : ℤ) ≤ (((p - 2) * t₂ : ℕ) : ℤ) := by exact_mod_cast hmul
      have hp12 : ((p - 1 : ℕ) : ℤ) = ((p - 2 : ℕ) : ℤ) + 1 := by omega
      push_cast at hmul_z
      rw [hm₀_def, hp12]
      linarith only [hmul_z]
    have hm₀_ge_t₁ : (t₁ : ℤ) ≤ m₀ := le_trans (by exact_mod_cast ht_le) hm₀_ge_t₂
    have hm₀_ge1 : (1 : ℤ) ≤ m₀ := le_trans (by exact_mod_cast ht₁_ge1) hm₀_ge_t₁
    have hm₀_nonneg : (0 : ℤ) ≤ m₀ := by linarith only [hm₀_ge1]
    have hm₀_le_p1t₂ : m₀ ≤ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
      have h : (0 : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by positivity
      linarith only [hm₀_def, h]
    have hpm₀_ge_m₀ : m₀ ≤ (p : ℤ) * m₀ := by
      have h1 : (1 : ℤ) * m₀ ≤ (p : ℤ) * m₀ :=
        Int.mul_le_mul_of_nonneg_right (by omega : (1 : ℤ) ≤ (p : ℤ)) hm₀_nonneg
      linarith only [h1]
    have hpm₀_ge_3m₀ : (3 : ℤ) * m₀ ≤ (p : ℤ) * m₀ :=
      Int.mul_le_mul_of_nonneg_right (by omega : (3 : ℤ) ≤ (p : ℤ)) hm₀_nonneg

    have hV_pert_eq : V_pert = (p : ℤ) * (t₂ : ℤ) + 1 + (t₁ : ℤ) - (q₁ : ℤ) := by
      rw [hV_pert_def]
      push_cast
      ring
    have hV_pert_le_V_lin_t₁ : V_pert ≤ V_lin + (t₁ : ℤ) := by
      have hmul : (p - 2) * t₁ ≤ (p - 2) * t₂ := Nat.mul_le_mul_left (p - 2) ht_le
      have hmul_z : ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₂ : ℤ) := by
        have h : (((p - 2) * t₁ : ℕ) : ℤ) ≤ (((p - 2) * t₂ : ℕ) : ℤ) := by exact_mod_cast hmul
        push_cast at h
        exact h
      have hq₁_ge1_z : (1 : ℤ) ≤ (q₁ : ℤ) := by exact_mod_cast hq₁_ge1
      rw [hp_sub2_z] at hmul_z
      rw [hV_pert_eq, hV_lin_def, hp_sub1_z, hp_sub2_z]
      linarith
    have hV_nu_nonneg : (0 : ℤ) ≤ V_nu := by rw [hV_nu_def]; positivity
    have hV_nu_le_V_lin : V_nu ≤ V_lin := by
      rw [hV_lin_def, hV_nu_def]
      linarith only [hm₀_def, hm₀_nonneg]
    have hV_lin_nonneg : (0 : ℤ) ≤ V_lin := le_trans hV_nu_nonneg hV_nu_le_V_lin
    have hV_nu_le_V_pert : V_nu ≤ V_pert := by
      have hq₁_le_z : (q₁ : ℤ) ≤ (t₂ : ℤ) + 1 := by exact_mod_cast hq₁_le
      have ht₁_pos_z : (1 : ℤ) ≤ (t₁ : ℤ) := by exact_mod_cast ht₁_ge1
      rw [hV_pert_eq, hV_nu_def, hp_sub1_z]
      linarith
    have hV_pert_nonneg : (0 : ℤ) ≤ V_pert := le_trans hV_nu_nonneg hV_nu_le_V_pert
    have hV_pert_le_2V_nu : V_pert ≤ 2 * V_nu := by
      have hp3_t₁ : (0 : ℤ) ≤ ((p - 3 : ℕ) : ℤ) * (t₁ : ℤ) := by positivity
      rw [hp_sub3_z] at hp3_t₁
      have hlin_le : V_lin + (t₁ : ℤ) ≤ 2 * V_nu := by
        rw [hV_lin_def, hV_nu_def, hp_sub2_z]
        linarith
      exact le_trans hV_pert_le_V_lin_t₁ hlin_le
    have hq_u_ge_V_pert : V_pert ≤ q_u := by
      have h1 : 2 * (p - 1) * t₂ + t₁ ≤ p * (p - 1) * t₂ := by
        have ht₁_le : t₁ ≤ 1 * (p - 1) * t₂ := by nlinarith
        calc 2 * (p - 1) * t₂ + t₁
            ≤ 2 * (p - 1) * t₂ + 1 * (p - 1) * t₂ := Nat.add_le_add_left ht₁_le _
          _ = 3 * ((p - 1) * t₂) := by ring
          _ ≤ p * ((p - 1) * t₂) := Nat.mul_le_mul_right ((p - 1) * t₂) hp_ge3
          _ = p * (p - 1) * t₂ := by ring
      have h1z : ((2 * (p - 1) * t₂ + t₁ : ℕ) : ℤ) ≤ ((p * (p - 1) * t₂ : ℕ) : ℤ) := by
        exact_mod_cast h1
      push_cast at h1z
      have hV_tmp := hV_pert_le_V_lin_t₁
      rw [hV_lin_def] at hV_tmp
      rw [hq_u_eq]
      linarith
    have hq_u_nonneg : (0 : ℤ) ≤ q_u := le_trans hV_pert_nonneg hq_u_ge_V_pert

    have hpV_pert_le :
        (p : ℤ) * V_pert - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ) ≤ ((p : ℤ) ^ 2 - 1) * (t₁ : ℤ) := by
      have hq₁_mul_z : (m₁ : ℤ) ≤ (p : ℤ) * (q₁ : ℤ) := by exact_mod_cast hq₁_mul
      have hδ_z : (δ : ℤ) = (t₂ : ℤ) - (t₁ : ℤ) := by omega
      have hm₁_z : (m₁ : ℤ) = 2 * (t₁ : ℤ) + 1 + (p : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) := by
        have h1 : (m₁ : ℤ) = ((2 * t₁ + 1 + p * δ : ℕ) : ℤ) := by rw [hm₁_eq]
        push_cast at h1
        rw [hδ_z] at h1
        exact h1
      have hT₁_z : (T₁ : ℤ) = (t₁ : ℤ) + (p : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) + 1 := by
        have h1 : (T₁ : ℤ) = ((t₁ + p * δ + 1 : ℕ) : ℤ) := by rw [hT₁_eq]
        push_cast at h1
        rw [hδ_z] at h1
        exact h1
      have hid :
          (p : ℤ) * V_pert - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ) - (((p : ℤ) ^ 2 - 1) * (t₁ : ℤ)) =
          (m₁ : ℤ) - (p : ℤ) * (q₁ : ℤ) := by
        rw [hV_pert_eq, hp_sub1_z, hm₁_z, hT₁_z]
        ring
      linarith
    have htr_err_cond : (p : ℤ) * V_pert - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ) ≤ q_err := by
      have h2p3_z : ((2 * p - 3 : ℕ) : ℤ) = 2 * (p : ℤ) - 3 := Nat.cast_sub (by omega : 3 ≤ 2 * p)
      have ht_diff : (0 : ℤ) ≤ 2 * (p : ℤ) * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) :=
        mul_nonneg (by positivity) (by omega)
      have hp2_sq : (0 : ℤ) ≤ ((p - 2 : ℕ) : ℤ) ^ 2 * (t₁ : ℤ) := by positivity
      have hid :
          q_err - (((p : ℤ) ^ 2 - 1) * (t₁ : ℤ)) =
          2 * (p : ℤ) * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
            ((p - 2 : ℕ) : ℤ) ^ 2 * (t₁ : ℤ) := by
        rw [hq_err_eq, hp_sub1_z, hp_sub2_z, h2p3_z]
        ring
      linarith
    have hs₁_ge2_cond : ∀ r : ℕ, 2 ≤ r →
        (p : ℤ) * V_pert - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ) ≤ (r : ℤ) * q_u := by
      intro r hr
      have ht_diff : (0 : ℤ) ≤ 2 * (p : ℤ) * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) :=
        mul_nonneg (by positivity) (by omega)
      have hp2_sq : (0 : ℤ) ≤ (((p - 2 : ℕ) : ℤ) ^ 2 + 1) * (t₁ : ℤ) := by positivity
      have hid :
          2 * q_u - (((p : ℤ) ^ 2 - 1) * (t₁ : ℤ)) =
          2 * (p : ℤ) * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
            (((p - 2 : ℕ) : ℤ) ^ 2 + 1) * (t₁ : ℤ) := by
        rw [hq_u_eq, hp_sub1_z, hp_sub2_z]
        ring
      have hr_q : 2 * q_u ≤ (r : ℤ) * q_u :=
        Int.mul_le_mul_of_nonneg_right (by omega : (2 : ℤ) ≤ (r : ℤ)) hq_u_nonneg
      linarith

    have hpm₁_ge_p1t₂ : ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
      have hm₁_ge : t₂ ≤ m₁ := by
        have h : 1 * (bE' - bM₁') ≤ p * (bE' - bM₁') :=
          Nat.mul_le_mul_right (bE' - bM₁') (by omega : 1 ≤ p)
        omega
      have h1 : (p - 1) * t₂ ≤ p * m₁ := Nat.mul_le_mul (by omega) hm₁_ge
      have h_m1_le : m₁ ≤ 3 * p * m₁ + 1 := by
        calc m₁ = 1 * m₁ := (one_mul m₁).symm
          _ ≤ (3 * p) * m₁ := Nat.mul_le_mul_right m₁ (by omega : 1 ≤ 3 * p)
          _ ≤ 3 * p * m₁ + 1 := Nat.le_succ _
      have h2 : p * m₁ ≤ p * (3 * p * m₁ + 1) := Nat.mul_le_mul_left p h_m1_le
      have h3 : (((p - 1) * t₂ : ℕ) : ℤ) ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
        exact_mod_cast le_trans h1 h2
      push_cast at h3
      exact h3
    have hpm₁_ge_m₀ : m₀ ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := le_trans hm₀_le_p1t₂ hpm₁_ge_p1t₂
    have hpm₁_ge_V_pert : V_pert ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
      have hm₁_ge : t₂ + t₁ + 1 ≤ m₁ := by
        have h : 1 * δ ≤ p * δ := Nat.mul_le_mul_right δ (by omega : 1 ≤ p)
        omega
      have h1 : p * t₂ + t₁ + 1 ≤ p * m₁ := by
        calc p * t₂ + t₁ + 1 ≤ p * t₂ + p * t₁ + p * 1 := by nlinarith
          _ = p * (t₂ + t₁ + 1) := by ring
          _ ≤ p * m₁ := Nat.mul_le_mul_left p hm₁_ge
      have h_m1_le : m₁ ≤ 3 * p * m₁ + 1 := by
        calc m₁ = 1 * m₁ := (one_mul m₁).symm
          _ ≤ (3 * p) * m₁ := Nat.mul_le_mul_right m₁ (by omega : 1 ≤ 3 * p)
          _ ≤ 3 * p * m₁ + 1 := Nat.le_succ _
      have h2 : p * m₁ ≤ p * (3 * p * m₁ + 1) := Nat.mul_le_mul_left p h_m1_le
      have h3 : ((p * t₂ + t₁ + 1 : ℕ) : ℤ) ≤ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
        exact_mod_cast le_trans h1 h2
      have h3_lhs : ((p * t₂ + t₁ + 1 : ℕ) : ℤ) = (p : ℤ) * (t₂ : ℤ) + (t₁ : ℤ) + 1 := by
        push_cast; ring
      have hq₁_ge1_z : (1 : ℤ) ≤ (q₁ : ℤ) := by exact_mod_cast hq₁_ge1
      rw [h3_lhs] at h3
      rw [hV_pert_eq]
      linarith

    
    have hp_valM₁' : ∀ q : ℤ, q ≤ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) →
        ((p : ℕ) : R_M) = 0 ∨ q ≤ vM₁' ((p : ℕ) : R_M) := by
      intro q hq
      have hincl : iM₁'K₁ ((p : ℕ) : R_M) = ((p : ℕ) : R_K) := map_natCast iM₁'K₁ p
      rcases hp_valK₁ with hp0 | hp_ge
      · left
        exact (map_eq_zero_iff iM₁'K₁ hiM₁'K₁).mp (hincl.trans hp0)
      · right
        have hge' : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) ≤
            (p : ℤ) * vM₁' ((p : ℕ) : R_M) := by
          calc (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
              = ((p * (p - 1) * t₂ : ℕ) : ℤ) := by push_cast; ring
            _ ≤ vK₁ ((p : ℕ) : R_K) := by rw [ht₂_def]; exact hp_ge
            _ = (p : ℤ) * vM₁' ((p : ℕ) : R_M) := by rw [← hincl, hval_M₁'K₁]
        exact le_trans hq (le_of_mul_le_mul_left hge' hp_pos_z)
    clear hp_valK₁

    have hc_valM₁' : ∀ r < p - 2,
        (c_coeff r : R_M) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ vM₁' (c_coeff r : R_M) := by
      intro r hr
      obtain ⟨d_r, hd_r⟩ := hc_dvd r hr
      rw [hd_r, Int.cast_mul, Int.cast_natCast]
      have hmul := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
        ((p : ℕ) : R_M) (d_r : R_M) (hp_valM₁' _ le_rfl) (hvalM₁'_intCast d_r)
      rwa [add_zero] at hmul

    have hchoose_valM₁' : ∀ r ∈ Finset.Icc 1 (p - 1),
        ((p.choose r : ℕ) : R_M) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ vM₁' ((p.choose r : ℕ) : R_M) := by
      intro r hr
      obtain ⟨hr1, hr2⟩ := Finset.mem_Icc.mp hr
      obtain ⟨k, hk⟩ := Nat.Prime.dvd_choose_self hPrime (by omega : r ≠ 0) (by omega : r < p)
      rw [hk, Nat.cast_mul]
      have hmul := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
        ((p : ℕ) : R_M) (k : R_M) (hp_valM₁' _ le_rfl) (hvalM₁'_natCast k)
      rwa [add_zero] at hmul

    have hΔ_val' : vK₁ Δ_val = -(t₁ : ℤ) := by rw [hΔ_val, ← ht₁_def]
    clear hΔ_val
    have hb_val : vM₁' b = -(t₁ : ℤ) := by rw [hb_def, hval_norm_M₁'K₁, hΔ_val']
    have hb_pow_val : ∀ r : ℕ, b ^ r = 0 ∨ -(r : ℤ) * (t₁ : ℤ) ≤ vM₁' (b ^ r) := by
      intro r
      have h := hvalM₁'_pow_ge b r (-(t₁ : ℤ)) (Or.inr (by rw [hb_val]))
      have heq : (r : ℤ) * (-(t₁ : ℤ)) = -(r : ℤ) * (t₁ : ℤ) := by ring
      rwa [heq] at h

    have htr_M₁'K₁_0 : ∀ w : R_K,
        (w = 0 ∨ - (((p - 1 : ℕ) : ℤ) * (((t₁ + p * (bE' - bM₁') + 1 : ℕ) : ℤ))) ≤ vK₁ w) →
        (trM₁'K₁ w = 0 ∨ (0 : ℤ) ≤ vM₁' (trM₁'K₁ w)) := by
      intro w hw
      apply htr_M₁'K₁ 0 w
      rw [mul_zero, zero_sub, ← ht₁_def]
      exact hw
    have htr_M₁'K₁_m : ∀ (m : ℤ) (w : R_K),
        (w = 0 ∨ (p : ℤ) * m ≤ vK₁ w) →
        (trM₁'K₁ w = 0 ∨ m ≤ vM₁' (trM₁'K₁ w)) := by
      intro m w hw
      apply htr_M₁'K₁ m w
      refine hvalK₁_mono _ ((p : ℤ) * m) w ?_ hw
      have hT : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (((bM₁' - 1) + p * (bE' - bM₁') + 1 : ℕ) : ℤ) := by
        positivity
      linarith only [hT]

    have hIcc_1_p2_idx : ∀ i ∈ Finset.Icc 1 (p - 2),
        i ∈ Finset.Icc 1 (p - 1) ∧ i ≤ p ∧ ((p - i : ℕ) : ℤ) = (p : ℤ) - (i : ℤ) ∧
          (i : ℤ) * (t₁ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := by
      intro i hi
      obtain ⟨hi1, hi2⟩ := Finset.mem_Icc.mp hi
      refine ⟨Finset.mem_Icc.mpr ⟨hi1, by omega⟩, by omega, Nat.cast_sub (by omega : i ≤ p), ?_⟩
      exact_mod_cast Nat.mul_le_mul_right t₁ hi2
    have hIcc_2_p1_idx : ∀ r ∈ Finset.Icc 2 (p - 1),
        r ∈ Finset.Icc 1 (p - 1) ∧
          ((p - r : ℕ) : ℤ) * (t₁ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) ∧
          (r : ℤ) * (t₁ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (((t₁ + p * (bE' - bM₁') + 1 : ℕ) : ℤ)) := by
      intro r hr
      obtain ⟨hr2, hr_p1⟩ := Finset.mem_Icc.mp hr
      have hpr_le : (p - r) * t₁ ≤ (p - 2) * t₁ := Nat.mul_le_mul_right t₁ (by omega : p - r ≤ p - 2)
      have hpr_z : (((p - r) * t₁ : ℕ) : ℤ) ≤ (((p - 2) * t₁ : ℕ) : ℤ) := by exact_mod_cast hpr_le
      have hr_le : r * t₁ ≤ (p - 1) * (t₁ + p * (bE' - bM₁') + 1) :=
        Nat.mul_le_mul hr_p1 (by omega : t₁ ≤ t₁ + p * (bE' - bM₁') + 1)
      have hr_z : ((r * t₁ : ℕ) : ℤ) ≤ (((p - 1) * (t₁ + p * (bE' - bM₁') + 1) : ℕ) : ℤ) := by
        exact_mod_cast hr_le
      push_cast at hpr_z hr_z
      exact ⟨Finset.mem_Icc.mpr ⟨by omega, hr_p1⟩, hpr_z, hr_z⟩
    have hIcc_1_p1_idx : ∀ s ∈ Finset.Icc 1 (p - 1),
        s ≤ p ∧ ((p - s : ℕ) : ℤ) = (p : ℤ) - (s : ℤ) ∧
          ((p - s : ℕ) : ℤ) * (t₁ : ℤ) ≤
            ((p - 1 : ℕ) : ℤ) * (((t₁ + p * (bE' - bM₁') + 1 : ℕ) : ℤ)) := by
      intro s hs
      obtain ⟨hs1, hs2⟩ := Finset.mem_Icc.mp hs
      have hps_le : (p - s) * t₁ ≤ (p - 1) * (t₁ + p * (bE' - bM₁') + 1) :=
        Nat.mul_le_mul (by omega : p - s ≤ p - 1) (by omega : t₁ ≤ t₁ + p * (bE' - bM₁') + 1)
      have hps_z : (((p - s) * t₁ : ℕ) : ℤ) ≤
          (((p - 1) * (t₁ + p * (bE' - bM₁') + 1) : ℕ) : ℤ) := by exact_mod_cast hps_le
      push_cast at hps_z
      exact ⟨by omega, Nat.cast_sub (by omega : s ≤ p), hps_z⟩

    have herase_range : (Finset.range p).erase 0 = Finset.Icc 1 (p - 1) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_Icc]
      omega
    have herase_Icc_bot : (Finset.Icc 1 (p - 1)).erase 1 = Finset.Icc 2 (p - 1) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_Icc]
      omega
    have herase_Icc_top : (Finset.Icc 1 (p - 1)).erase (p - 1) = Finset.Icc 1 (p - 2) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_Icc]
      omega
    have hIcc_split_top : ∀ {R : Type u} [AddCommMonoid R] (f : ℕ → R),
        (∑ r ∈ Finset.Icc 1 (p - 1), f r) =
          (∑ r ∈ Finset.Icc 1 (p - 2), f r) + f (p - 1) := by
      intro R _ f
      have hp1 : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hp1_ge1, le_rfl⟩
      rw [← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) f hp1, herase_Icc_top, add_comm]
    have hadd_pow_split1 : ∀ {R : Type u} [CommRing R] (x y : R),
        (x + y) ^ p =
          y ^ p +
            (∑ r ∈ Finset.Icc 1 (p - 1), x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)) +
            x ^ p := by
      intro R _ x y
      let f : ℕ → R := fun r => x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)
      have h0 : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
      have hsplit : (∑ r ∈ Finset.range (p + 1), f r) =
          f 0 + (∑ r ∈ Finset.Icc 1 (p - 1), f r) + f p := by
        rw [Finset.sum_range_succ f p, ← Finset.add_sum_erase (Finset.range p) f h0, herase_range]
      have hf0 : f 0 = y ^ p := by
        dsimp [f]
        rw [pow_zero, one_mul, Nat.choose_zero_right, Nat.cast_one, mul_one]
      have hfp : f p = x ^ p := by
        dsimp [f]
        rw [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one, mul_one]
      rw [add_pow x y p]
      exact hsplit.trans (by rw [hf0, hfp])
    have hadd_pow_split2 : ∀ {R : Type u} [CommRing R] (x y : R),
        (x + y) ^ p =
          y ^ p + x * y ^ (p - 1) * ((p : ℕ) : R) +
            (∑ r ∈ Finset.Icc 2 (p - 1), x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)) +
            x ^ p := by
      intro R _ x y
      let f : ℕ → R := fun r => x ^ r * y ^ (p - r) * ((p.choose r : ℕ) : R)
      have h1 : 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨le_rfl, hp1_ge1⟩
      have hsplit : (∑ r ∈ Finset.Icc 1 (p - 1), f r) =
          f 1 + ∑ r ∈ Finset.Icc 2 (p - 1), f r := by
        rw [← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) f h1, herase_Icc_bot]
      have hf1 : f 1 = x * y ^ (p - 1) * ((p : ℕ) : R) := by
        dsimp [f]
        rw [pow_one, Nat.choose_one_right]
      rw [hadd_pow_split1 x y, hsplit, hf1, ← add_assoc (y ^ p)]

    have hp1_t₁_le_t₂ : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
      exact_mod_cast Nat.mul_le_mul_left (p - 1) ht_le
    have h2t₁_le_p2t₁ : 2 * (t₁ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) + (t₁ : ℤ) := by
      have h1 : 1 * t₁ ≤ (p - 2) * t₁ := Nat.mul_le_mul_right t₁ hp2_ge1
      have h2_le : 2 * t₁ ≤ (p - 2) * t₁ + t₁ := by
        calc 2 * t₁ = 1 * t₁ + t₁ := by ring
          _ ≤ (p - 2) * t₁ + t₁ := Nat.add_le_add_right h1 t₁
      have h2_z : ((2 * t₁ : ℕ) : ℤ) ≤ (((p - 2) * t₁ + t₁ : ℕ) : ℤ) := by exact_mod_cast h2_le
      push_cast at h2_z
      exact h2_z
    have hτ1_mem : 1 ∈ Finset.Icc 1 (2 * (p - 1)) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
    have hndvd1 : ¬ ((p - 1) ∣ 1) := Nat.not_dvd_of_pos_of_lt Nat.one_pos hp1_gt1

    
    let S_p : Finset ℕ := (Finset.range p).erase 0
    have hS_p_def : S_p = (Finset.range p).erase 0 := rfl
    clear_value S_p
    let ξ : ℕ → R_M := fun m => iLM₁' (τ_val m)
    have hξ_def : ∀ m, ξ m = iLM₁' (τ_val m) := fun _ => rfl
    clear_value ξ
    let s₀_m : R_M := 1 + e_Δ (p - 1)
    have hs₀_m_def : s₀_m = 1 + e_Δ (p - 1) := rfl
    clear_value s₀_m
    let W_fn : ℕ → R_M := fun m => ξ m ^ p + ∑ i ∈ Finset.Icc 1 (p - 1), ξ m ^ (p - i) * e_Δ i
    have hW_fn_def : ∀ m, W_fn m = ξ m ^ p + ∑ i ∈ Finset.Icc 1 (p - 1), ξ m ^ (p - i) * e_Δ i :=
      fun _ => rfl
    clear_value W_fn
    let B_tilde : ℕ → R_M := fun m =>
      (ξ m ^ p - ξ m) + ∑ i ∈ Finset.Icc 1 (p - 2), ξ m ^ (p - i) * e_Δ i
    have hB_tilde_def : ∀ m, B_tilde m =
        (ξ m ^ p - ξ m) + ∑ i ∈ Finset.Icc 1 (p - 2), ξ m ^ (p - i) * e_Δ i := fun _ => rfl
    clear_value B_tilde

    have hs₀_m_int : s₀_m = 0 ∨ (0 : ℤ) ≤ vM₁' s₀_m := by
      have he_p1_int : e_Δ (p - 1) = 0 ∨ (0 : ℤ) ≤ vM₁' (e_Δ (p - 1)) := by
        have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hp1_ge1, le_rfl⟩
        refine hvalM₁'_mono 0 _ _ ?_ (he_Δ_val (p - 1) hp1_mem)
        linarith only [hp1_t₁_le_t₂]
      rw [hs₀_m_def]
      exact hvalM₁'_add 0 1 (e_Δ (p - 1)) (Or.inr (by rw [hvalM₁'_1])) he_p1_int
    have hs₀_m_pow_int : ∀ r : ℕ, s₀_m ^ r = 0 ∨ (0 : ℤ) ≤ vM₁' (s₀_m ^ r) := by
      intro r
      have h := hvalM₁'_pow_ge s₀_m r 0 hs₀_m_int
      rwa [mul_zero] at h

    have hξ_props : ∀ m ∈ S_p,
        (ξ m = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m)) ∧
        (∀ k : ℕ, ξ m ^ k = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m ^ k)) ∧
        (ξ m ^ p - ξ m = 0 ∨ m₀ ≤ vM₁' (ξ m ^ p - ξ m)) ∧
        nmM₁'K₁ (Δ_val + iM₁'K₁ (ξ m)) = W_fn m + b ∧
        W_fn m = ξ m * s₀_m + B_tilde m ∧
        (B_tilde m = 0 ∨ m₀ ≤ vM₁' (B_tilde m)) ∧
        (W_fn m = 0 ∨ (0 : ℤ) ≤ vM₁' (W_fn m)) := by
      intro m hm
      rw [hS_p_def] at hm
      have hm_pos : 0 < m := Nat.pos_of_ne_zero (Finset.mem_erase.mp hm).1
      have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm).2
      have hξ_ne0 : ξ m ≠ 0 := by
        rw [hξ_def]
        exact (map_ne_zero_iff iLM₁' hiLM₁').mpr (hτ_ne0 m)
      have hmul_inv : ξ m * (ξ m)⁻¹ = 1 := mul_inv_cancel₀ hξ_ne0
      have hξ_int : ξ m = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m) := by
        right
        rw [hξ_def, hval_LM₁', hτ_val0 m hm_lt hm_pos, mul_zero]
      have hξ_pow_int : ∀ k : ℕ, ξ m ^ k = 0 ∨ (0 : ℤ) ≤ vM₁' (ξ m ^ k) := by
        intro k
        have h := hvalM₁'_pow_ge (ξ m) k 0 hξ_int
        rwa [mul_zero] at h
      have hξ_p_sub : ξ m ^ p - ξ m = 0 ∨ m₀ ≤ vM₁' (ξ m ^ p - ξ m) := by
        have hτ_m := hτ_p1 m hm_lt hm_pos
        have hξ_p1_val :
            iLM₁' ((τ_val m) ^ (p - 1) - 1) = 0 ∨
              m₀ ≤ vM₁' (iLM₁' ((τ_val m) ^ (p - 1) - 1)) := by
          rcases hτ_m with h0 | hge
          · left; rw [h0, map_zero]
          · right
            rw [hval_LM₁']
            have hmul_p : ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
                (p : ℤ) * vL ((τ_val m) ^ (p - 1) - 1) := by
              calc ((p * (3 * p * m₁ + 1) : ℕ) : ℤ)
                  = (p : ℤ) * ((3 * p * m₁ + 1 : ℕ) : ℤ) := by push_cast; ring
                _ ≤ (p : ℤ) * vL ((τ_val m) ^ (p - 1) - 1) :=
                  Int.mul_le_mul_of_nonneg_left hge (Nat.cast_nonneg p)
            exact le_trans hpm₁_ge_m₀ hmul_p
        have hξ_factor : ξ m ^ p - ξ m =
            ξ m * iLM₁' ((τ_val m) ^ (p - 1) - 1) := by
          have h1 : iLM₁' ((τ_val m) ^ (p - 1) - 1) = ξ m ^ (p - 1) - 1 := by
            rw [map_sub, map_pow, map_one, ← hξ_def]
          rw [h1, mul_sub, mul_one, ← pow_succ', ← hp_eq_p1_add1]
        rw [hξ_factor]
        have hmul := hvalM₁'_mul_ge 0 m₀ (ξ m)
          (iLM₁' ((τ_val m) ^ (p - 1) - 1))
          hξ_int hξ_p1_val
        rwa [zero_add] at hmul
      have hnorm_W : nmM₁'K₁ (Δ_val + iM₁'K₁ (ξ m)) = W_fn m + b := by
        have hfactor : Δ_val + iM₁'K₁ (ξ m) =
            iM₁'K₁ (ξ m) * (1 + iM₁'K₁ ((ξ m)⁻¹) * Δ_val) := by
          have h1 : iM₁'K₁ (ξ m) * iM₁'K₁ ((ξ m)⁻¹) = 1 := by
            rw [← map_mul, hmul_inv, map_one]
          calc Δ_val + iM₁'K₁ (ξ m)
              = iM₁'K₁ (ξ m) + 1 * Δ_val := by ring
            _ = iM₁'K₁ (ξ m) + (iM₁'K₁ (ξ m) * iM₁'K₁ ((ξ m)⁻¹)) * Δ_val := by rw [← h1]
            _ = iM₁'K₁ (ξ m) * (1 + iM₁'K₁ ((ξ m)⁻¹) * Δ_val) := by ring
        have hpow_cancel : ∀ i : ℕ, i ≤ p → ξ m ^ p * ((ξ m)⁻¹) ^ i = ξ m ^ (p - i) := by
          intro i hi
          calc ξ m ^ p * ((ξ m)⁻¹) ^ i
              = ξ m ^ ((p - i) + i) * ((ξ m)⁻¹) ^ i := by rw [Nat.sub_add_cancel hi]
            _ = ξ m ^ (p - i) * (ξ m ^ i * ((ξ m)⁻¹) ^ i) := by rw [pow_add, mul_assoc]
            _ = ξ m ^ (p - i) * (ξ m * (ξ m)⁻¹) ^ i := by rw [← mul_pow]
            _ = ξ m ^ (p - i) := by rw [hmul_inv, one_pow, mul_one]
        rw [hfactor, nmM₁'K₁.map_mul, hnorm_incl_M₁'K₁ (ξ m), he_Δ_poly ((ξ m)⁻¹), ← hb_def]
        have hsum_cancel :
            ξ m ^ p * (∑ i ∈ Finset.Icc 1 (p - 1), ((ξ m)⁻¹) ^ i * e_Δ i) =
              ∑ i ∈ Finset.Icc 1 (p - 1), ξ m ^ (p - i) * e_Δ i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_le : i ≤ p := (hIcc_1_p1_idx i hi).1
          rw [← mul_assoc, hpow_cancel i hi_le]
        have htop_cancel : ξ m ^ p * (((ξ m)⁻¹) ^ p * b) = b := by
          rw [← mul_assoc, hpow_cancel p le_rfl, Nat.sub_self, pow_zero, one_mul]
        rw [mul_add, mul_add, mul_one, hsum_cancel, htop_cancel, hW_fn_def]
      have hW_split : W_fn m = ξ m * s₀_m + B_tilde m := by
        rw [hW_fn_def, hB_tilde_def, hs₀_m_def,
          hIcc_split_top (fun i => ξ m ^ (p - i) * e_Δ i), hp_sub_p1, pow_one]
        ring
      have hB_tilde_val : B_tilde m = 0 ∨ m₀ ≤ vM₁' (B_tilde m) := by
        rw [hB_tilde_def]
        refine hvalM₁'_add m₀ _ _ hξ_p_sub ?_
        apply hvalM₁'_sum_ge
        intro i hi
        obtain ⟨hi_mem, _, _, hi_mul⟩ := hIcc_1_p2_idx i hi
        have hmul := hvalM₁'_mul_ge 0
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ))
          (ξ m ^ (p - i)) (e_Δ i) (hξ_pow_int (p - i)) (he_Δ_val i hi_mem)
        refine hvalM₁'_mono m₀ _ _ ?_ hmul
        linarith only [hm₀_def, hi_mul]
      have hW_int : W_fn m = 0 ∨ (0 : ℤ) ≤ vM₁' (W_fn m) := by
        rw [hW_split]
        have h1 := hvalM₁'_mul_ge 0 0 (ξ m) s₀_m hξ_int hs₀_m_int
        rw [add_zero] at h1
        have h2 := hvalM₁'_mono 0 m₀ (B_tilde m) hm₀_nonneg hB_tilde_val
        exact hvalM₁'_add 0 _ _ h1 h2
      exact ⟨hξ_int, hξ_pow_int, hξ_p_sub, hnorm_W, hW_split, hB_tilde_val, hW_int⟩

    have hWb_pow_props : ∀ (W : R_M), (W = 0 ∨ (0 : ℤ) ≤ vM₁' W) →
        (∀ k : ℕ, (W + b) ^ k = 0 ∨ -(k : ℤ) * (t₁ : ℤ) ≤ vM₁' ((W + b) ^ k)) ∧
        (∀ k : ℕ, 1 ≤ k →
          (W + b) ^ k - b ^ k = 0 ∨ -((k - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ vM₁' ((W + b) ^ k - b ^ k)) := by
      intro W hW
      have hWb_val : W + b = 0 ∨ -(t₁ : ℤ) ≤ vM₁' (W + b) := by
        have hW_t1 : W = 0 ∨ -(t₁ : ℤ) ≤ vM₁' W :=
          hvalM₁'_mono (-(t₁ : ℤ)) 0 W (by omega) hW
        exact hvalM₁'_add (-(t₁ : ℤ)) W b hW_t1 (Or.inr (by rw [hb_val]))
      have hWb_pow_val : ∀ k : ℕ, (W + b) ^ k = 0 ∨ -(k : ℤ) * (t₁ : ℤ) ≤ vM₁' ((W + b) ^ k) := by
        intro k
        have h := hvalM₁'_pow_ge (W + b) k (-(t₁ : ℤ)) hWb_val
        have heq : (k : ℤ) * (-(t₁ : ℤ)) = -(k : ℤ) * (t₁ : ℤ) := by ring
        rwa [heq] at h
      have hWb_sub_succ : ∀ n : ℕ,
          (W + b) ^ (n + 1) - b ^ (n + 1) = 0 ∨
            -(n : ℤ) * (t₁ : ℤ) ≤ vM₁' ((W + b) ^ (n + 1) - b ^ (n + 1)) := by
        intro n
        induction n with
        | zero =>
          have hid : (W + b) ^ 1 - b ^ 1 = W := by ring
          rw [hid, Nat.cast_zero, neg_zero, zero_mul]
          exact hW
        | succ n ih =>
          have hid : (W + b) ^ (n + 2) - b ^ (n + 2) =
              ((W + b) ^ (n + 1) - b ^ (n + 1)) * (W + b) + b ^ (n + 1) * W := by
            rw [pow_succ (W + b) (n + 1), pow_succ b (n + 1)]
            ring
          rw [hid]
          have hterm1 := hvalM₁'_mul_ge (-(n : ℤ) * (t₁ : ℤ)) (-(t₁ : ℤ))
            ((W + b) ^ (n + 1) - b ^ (n + 1)) (W + b) ih hWb_val
          have hterm1' : ((W + b) ^ (n + 1) - b ^ (n + 1)) * (W + b) = 0 ∨
              -((n + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
                vM₁' (((W + b) ^ (n + 1) - b ^ (n + 1)) * (W + b)) := by
            refine hvalM₁'_mono _ _ _ ?_ hterm1
            push_cast
            exact le_of_eq (by ring)
          have hterm2 := hvalM₁'_mul_ge (-((n + 1 : ℕ) : ℤ) * (t₁ : ℤ)) 0
            (b ^ (n + 1)) W (hb_pow_val (n + 1)) hW
          rw [add_zero] at hterm2
          exact hvalM₁'_add (-((n + 1 : ℕ) : ℤ) * (t₁ : ℤ)) _ _ hterm1' hterm2
      refine ⟨hWb_pow_val, ?_⟩
      intro k hk
      have hk_eq : k = (k - 1) + 1 := by omega
      conv_lhs => rw [hk_eq]
      conv_rhs => rw [hk_eq]
      exact hWb_sub_succ (k - 1)

    
    let θ₀ : R_M := (c_coeff 0 : R_M) * trM₁'K₁ (Δ_val ^ (p - 2))
    have hθ₀_def : θ₀ = (c_coeff 0 : R_M) * trM₁'K₁ (Δ_val ^ (p - 2)) := rfl
    clear_value θ₀
    have hθ₀_val : θ₀ = 0 ∨ V_lin ≤ vM₁' θ₀ := by
      rw [hθ₀_def]
      have hmul := hvalM₁'_mul_ge
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ))
        (c_coeff 0 : R_M) (trM₁'K₁ (Δ_val ^ (p - 2)))
        (hc_valM₁' 0 hp2_ge1) (hClaimA (p - 2))
      refine hvalM₁'_mono V_lin _ _ ?_ hmul
      rw [hV_lin_def]
      exact le_of_eq (by ring)

    have hν_m_props : ∀ m ∈ S_p,
        let ν_m := nmM₁'K₁ (1 + u_fn m) - 1
        (ν_m - θ₀ * ξ m = 0 ∨ V_pert ≤ vM₁' (ν_m - θ₀ * ξ m)) ∧
        (ν_m = 0 ∨ V_nu ≤ vM₁' ν_m) := by
      intro m hm
      have hm_S := hm
      rw [hS_p_def] at hm_S
      have hm_pos : 0 < m := Nat.pos_of_ne_zero (Finset.mem_erase.mp hm_S).1
      have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm_S).2
      obtain ⟨_, hu_m_val, hu_m_approx⟩ := hu_props m hm_lt hm_pos
      obtain ⟨hξ_int, hξ_pow_int, _, _, _, _, _⟩ := hξ_props m hm
      let ξ_K : R_K := iM₁'K₁ (ξ m)
      have hξ_K_eq : iM₁'K₁ (iLM₁' (τ_val m)) = ξ_K := by dsimp [ξ_K]; rw [hξ_def]
      let Q_m : R_K := ∑ r ∈ Finset.range (p - 2),
        (c_coeff r : R_K) * ξ_K ^ (r + 1) * (Δ_val ^ (p - 2 - r))
      have htr_Qm_sub : trM₁'K₁ Q_m - θ₀ * ξ m = 0 ∨
          V_pert ≤ vM₁' (trM₁'K₁ Q_m - θ₀ * ξ m) := by
        have hp2_eq : p - 2 = (p - 3) + 1 := by omega
        have hQm_split :
            Q_m =
              (∑ r' ∈ Finset.range (p - 3),
                (c_coeff (r' + 1) : R_K) * ξ_K ^ (r' + 2) * (Δ_val ^ (p - 2 - (r' + 1)))) +
              (c_coeff 0 : R_K) * ξ_K ^ 1 * (Δ_val ^ (p - 2)) := by
          dsimp [Q_m]
          have hrange : Finset.range (p - 2) = Finset.range ((p - 3) + 1) := by rw [← hp2_eq]
          rw [hrange, Finset.sum_range_succ', Nat.sub_zero]
        have htr_r0 :
            trM₁'K₁ ((c_coeff 0 : R_K) * ξ_K ^ 1 * (Δ_val ^ (p - 2))) = θ₀ * ξ m := by
          have hcast : (c_coeff 0 : R_K) * ξ_K ^ 1 = iM₁'K₁ ((c_coeff 0 : R_M) * ξ m) := by
            dsimp [ξ_K]
            rw [pow_one, map_mul, map_intCast]
          rw [hcast, htr_smul_M₁'K₁, hθ₀_def]
          ring
        have htr_Qm_eq :
            trM₁'K₁ Q_m - θ₀ * ξ m =
              ∑ r' ∈ Finset.range (p - 3),
                trM₁'K₁ ((c_coeff (r' + 1) : R_K) * ξ_K ^ (r' + 2) * (Δ_val ^ (p - 2 - (r' + 1)))) := by
          rw [hQm_split, trM₁'K₁.map_add, htr_r0, map_sum, add_sub_cancel_right]
        rw [htr_Qm_eq]
        apply hvalM₁'_sum_ge
        intro r' hr'
        have hr'_lt : r' < p - 3 := Finset.mem_range.mp hr'
        have hterm_eq :
            trM₁'K₁ ((c_coeff (r' + 1) : R_K) * ξ_K ^ (r' + 2) * (Δ_val ^ (p - 2 - (r' + 1)))) =
              ((c_coeff (r' + 1) : R_M) * ξ m ^ (r' + 2)) *
                trM₁'K₁ (Δ_val ^ (p - 2 - (r' + 1))) := by
          have hcast : (c_coeff (r' + 1) : R_K) * ξ_K ^ (r' + 2) =
              iM₁'K₁ ((c_coeff (r' + 1) : R_M) * ξ m ^ (r' + 2)) := by
            dsimp [ξ_K]
            rw [map_mul, map_intCast, map_pow]
          rw [hcast, htr_smul_M₁'K₁]
        rw [hterm_eq]
        have hc_ξ := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
          (c_coeff (r' + 1) : R_M) (ξ m ^ (r' + 2))
          (hc_valM₁' (r' + 1) (by omega)) (hξ_pow_int (r' + 2))
        rw [add_zero] at hc_ξ
        have hprod := hvalM₁'_mul_ge
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 - (r' + 1) : ℕ) : ℤ) * (t₁ : ℤ))
          ((c_coeff (r' + 1) : R_M) * ξ m ^ (r' + 2))
          (trM₁'K₁ (Δ_val ^ (p - 2 - (r' + 1))))
          hc_ξ (hClaimA (p - 2 - (r' + 1)))
        refine hvalM₁'_mono V_pert _ _ ?_ hprod
        have hdeg_le : p - 2 - (r' + 1) ≤ p - 3 := by omega
        have hmul_le : ((p - 2 - (r' + 1) : ℕ) : ℤ) * (t₁ : ℤ) ≤ ((p - 3 : ℕ) : ℤ) * (t₁ : ℤ) := by
          exact_mod_cast Nat.mul_le_mul_right t₁ hdeg_le
        rw [hp_sub3_z] at hmul_le
        have hV_tmp := hV_pert_le_V_lin_t₁
        rw [hV_lin_def, hp_sub2_z] at hV_tmp
        linarith
      have htr_err : trM₁'K₁ (u_fn m - Q_m) = 0 ∨
          V_pert ≤ vM₁' (trM₁'K₁ (u_fn m - Q_m)) := by
        have herr_K₁ : u_fn m - Q_m = 0 ∨ q_err ≤ vK₁ (u_fn m - Q_m) := by
          dsimp [Q_m, q_err]
          rw [← hξ_K_eq]
          exact hu_m_approx
        have herr_cond : u_fn m - Q_m = 0 ∨
            (p : ℤ) * V_pert - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ) ≤ vK₁ (u_fn m - Q_m) :=
          hvalK₁_mono _ q_err (u_fn m - Q_m) htr_err_cond herr_K₁
        apply htr_M₁'K₁ V_pert (u_fn m - Q_m)
        rwa [← hT₁_def]
      have htr_um_sub : trM₁'K₁ (u_fn m) - θ₀ * ξ m = 0 ∨
          V_pert ≤ vM₁' (trM₁'K₁ (u_fn m) - θ₀ * ξ m) := by
        have hadd := hvalM₁'_add V_pert (trM₁'K₁ (u_fn m - Q_m)) (trM₁'K₁ Q_m - θ₀ * ξ m)
          htr_err htr_Qm_sub
        have hid : trM₁'K₁ (u_fn m - Q_m) + (trM₁'K₁ Q_m - θ₀ * ξ m) =
            trM₁'K₁ (u_fn m) - θ₀ * ξ m := by
          rw [map_sub]
          ring
        rwa [hid] at hadd
      let R_high : R_M := (∑ r ∈ (Finset.Icc 1 (p - 1)).erase 1, s₁ (u_fn m) r) + nmM₁'K₁ (u_fn m)
      have h1_mem : 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨le_rfl, hp1_ge1⟩
      have hν_decomp : nmM₁'K₁ (1 + u_fn m) - 1 = trM₁'K₁ (u_fn m) + R_high := by
        dsimp [R_high]
        rw [hs₁_norm_one_add (u_fn m),
          ← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) (fun r => s₁ (u_fn m) r) h1_mem,
          hs₁_1 (u_fn m), add_assoc]
      have hR_high_val : R_high = 0 ∨ V_pert ≤ vM₁' R_high := by
        have hu_K₁ : u_fn m = 0 ∨ q_u ≤ vK₁ (u_fn m) := hu_m_val
        rcases hu_K₁ with hu0 | hu_ge
        · left
          have h0 := hν_decomp
          rw [hu0, add_zero, map_one, sub_self, map_zero, zero_add] at h0
          exact h0.symm
        · have hsum_ge2 :
              (∑ r ∈ (Finset.Icc 1 (p - 1)).erase 1, s₁ (u_fn m) r) = 0 ∨
                V_pert ≤ vM₁' (∑ r ∈ (Finset.Icc 1 (p - 1)).erase 1, s₁ (u_fn m) r) := by
            apply hvalM₁'_sum_ge
            intro r hr
            have hr_ne1 : r ≠ 1 := (Finset.mem_erase.mp hr).1
            have hr_Icc : r ∈ Finset.Icc 1 (p - 1) := (Finset.mem_erase.mp hr).2
            have hr_ge1 : 1 ≤ r := (Finset.mem_Icc.mp hr_Icc).1
            have hr_ge2 : 2 ≤ r := by omega
            apply hs₁_val (u_fn m) r hr_Icc q_u V_pert (Or.inr hu_ge)
            rw [← hT₁_def]
            exact hs₁_ge2_cond r hr_ge2
          have hnorm_u : nmM₁'K₁ (u_fn m) = 0 ∨ V_pert ≤ vM₁' (nmM₁'K₁ (u_fn m)) :=
            Or.inr (by rw [hval_norm_M₁'K₁]; exact le_trans hq_u_ge_V_pert hu_ge)
          exact hvalM₁'_add V_pert _ _ hsum_ge2 hnorm_u
      have hν_sub :
          (nmM₁'K₁ (1 + u_fn m) - 1) - θ₀ * ξ m = 0 ∨
            V_pert ≤ vM₁' ((nmM₁'K₁ (1 + u_fn m) - 1) - θ₀ * ξ m) := by
        have hadd := hvalM₁'_add V_pert (trM₁'K₁ (u_fn m) - θ₀ * ξ m) R_high htr_um_sub hR_high_val
        have hid : (trM₁'K₁ (u_fn m) - θ₀ * ξ m) + R_high =
            (nmM₁'K₁ (1 + u_fn m) - 1) - θ₀ * ξ m := by
          rw [hν_decomp]
          ring
        rwa [hid] at hadd
      have hθ₀_ξ_val : θ₀ * ξ m = 0 ∨ V_nu ≤ vM₁' (θ₀ * ξ m) := by
        have hmul := hvalM₁'_mul_ge V_lin 0 θ₀ (ξ m) hθ₀_val hξ_int
        rw [add_zero] at hmul
        exact hvalM₁'_mono V_nu V_lin _ hV_nu_le_V_lin hmul
      have hν_val :
          nmM₁'K₁ (1 + u_fn m) - 1 = 0 ∨ V_nu ≤ vM₁' (nmM₁'K₁ (1 + u_fn m) - 1) := by
        have hsub_nu := hvalM₁'_mono V_nu V_pert _ hV_nu_le_V_pert hν_sub
        have hadd := hvalM₁'_add V_nu ((nmM₁'K₁ (1 + u_fn m) - 1) - θ₀ * ξ m) (θ₀ * ξ m)
          hsub_nu hθ₀_ξ_val
        rwa [sub_add_cancel] at hadd
      exact ⟨hν_sub, hν_val⟩

    
    have hν_quad : ∀ (ν : R_M), (ν = 0 ∨ V_nu ≤ vM₁' ν) →
        ∀ k : ℕ,
          (1 + ν) ^ k - 1 - ((k : ℕ) : R_M) * ν = 0 ∨
            V_pert ≤ vM₁' ((1 + ν) ^ k - 1 - ((k : ℕ) : R_M) * ν) := by
      intro ν hν
      have h1_add_ν : 1 + ν = 0 ∨ (0 : ℤ) ≤ vM₁' (1 + ν) :=
        hvalM₁'_add 0 1 ν (Or.inr (by rw [hvalM₁'_1]))
          (hvalM₁'_mono 0 V_nu ν hV_nu_nonneg hν)
      have hν_sq : ν ^ 2 = 0 ∨ 2 * V_nu ≤ vM₁' (ν ^ 2) := by
        have h := hvalM₁'_pow_ge ν 2 V_nu hν
        rwa [Nat.cast_ofNat] at h
      have hquad_2V : ∀ k : ℕ,
          (1 + ν) ^ k - 1 - ((k : ℕ) : R_M) * ν = 0 ∨
            2 * V_nu ≤ vM₁' ((1 + ν) ^ k - 1 - ((k : ℕ) : R_M) * ν) := by
        intro k
        induction k with
        | zero =>
          left
          push_cast
          ring
        | succ k ih =>
          have hid : (1 + ν) ^ (k + 1) - 1 - ((k + 1 : ℕ) : R_M) * ν =
              ((1 + ν) ^ k - 1 - ((k : ℕ) : R_M) * ν) * (1 + ν) + ((k : ℕ) : R_M) * ν ^ 2 := by
            rw [pow_succ]
            push_cast
            ring
          rw [hid]
          have hterm1 := hvalM₁'_mul_ge (2 * V_nu) 0
            ((1 + ν) ^ k - 1 - ((k : ℕ) : R_M) * ν) (1 + ν) ih h1_add_ν
          rw [add_zero] at hterm1
          have hterm2 := hvalM₁'_mul_ge 0 (2 * V_nu)
            ((k : ℕ) : R_M) (ν ^ 2) (hvalM₁'_natCast k) hν_sq
          rw [zero_add] at hterm2
          exact hvalM₁'_add (2 * V_nu) _ _ hterm1 hterm2
      intro k
      exact hvalM₁'_mono V_pert (2 * V_nu) _ hV_pert_le_2V_nu (hquad_2V k)

    have hsum_ξ_raw := hτ_pow_sum 1 hτ1_mem
    rw [if_neg hndvd1, sub_zero, ← hS_p_def] at hsum_ξ_raw
    have hsum_ξ_p3 :
        (∑ m ∈ S_p, ξ m) = 0 ∨
          ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤ vM₁' (∑ m ∈ S_p, ξ m) := by
      have heq_pow1 :
          (∑ m ∈ S_p, iLM₁' (τ_val m) ^ 1) = ∑ m ∈ S_p, ξ m := by
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [pow_one, ← hξ_def]
      rwa [heq_pow1] at hsum_ξ_raw

    have hConj1 : ∀ k ∈ Finset.Icc 2 p,
        let P_k := b ^ k +
          ∑ m ∈ (Finset.range p).erase 0,
            nmM₁'K₁ (Δ_val + iM₁'K₁ (iLM₁' (τ_val m))) ^ k
        iLM₁' (trLM₁' (b ^ k)) - P_k = 0 ∨
          V_pert - (k : ℤ) * (t₁ : ℤ) ≤
            vM₁' (iLM₁' (trLM₁' (b ^ k)) - P_k) := by
      intro k hk P_k
      have hk_ge2 : 2 ≤ k := (Finset.mem_Icc.mp hk).1
      have hk_ge1 : 1 ≤ k := by omega
      have hk_sub1_z : ((k - 1 : ℕ) : ℤ) = (k : ℤ) - 1 := Nat.cast_sub hk_ge1
      let B_val : ℤ := V_pert - (k : ℤ) * (t₁ : ℤ)
      have hterm_bound : ∀ m ∈ S_p,
          (nmM₁'K₁ (Δ_conj m)) ^ k - (W_fn m + b) ^ k - ((k : ℕ) : R_M) * b ^ k * θ₀ * ξ m = 0 ∨
            B_val ≤ vM₁' ((nmM₁'K₁ (Δ_conj m)) ^ k - (W_fn m + b) ^ k - ((k : ℕ) : R_M) * b ^ k * θ₀ * ξ m) := by
        intro m hm
        have hm_S := hm
        rw [hS_p_def] at hm_S
        have hm_pos : 0 < m := Nat.pos_of_ne_zero (Finset.mem_erase.mp hm_S).1
        have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm_S).2
        obtain ⟨hΔ_conj_m, _, _⟩ := hu_props m hm_lt hm_pos
        obtain ⟨hξ_int, _, _, hnorm_W, _, _, hW_int⟩ := hξ_props m hm
        obtain ⟨hWb_pow, hWb_sub⟩ := hWb_pow_props (W_fn m) hW_int
        obtain ⟨hν_sub, hν_val⟩ := hν_m_props m hm
        let B_m : R_M := W_fn m + b
        let ν_m : R_M := nmM₁'K₁ (1 + u_fn m) - 1
        have hnorm_conj : nmM₁'K₁ (Δ_conj m) = B_m * (1 + ν_m) := by
          have h1 : Δ_conj m = (Δ_val + iM₁'K₁ (ξ m)) * (1 + u_fn m) := by
            rw [hξ_def]; exact hΔ_conj_m
          have h2 : nmM₁'K₁ (1 + u_fn m) = 1 + ν_m := by dsimp [ν_m]; ring
          rw [h1, nmM₁'K₁.map_mul, hnorm_W, h2]
        have hdecomp :
            (nmM₁'K₁ (Δ_conj m)) ^ k - B_m ^ k - ((k : ℕ) : R_M) * b ^ k * θ₀ * ξ m =
              B_m ^ k * ((1 + ν_m) ^ k - 1 - ((k : ℕ) : R_M) * ν_m) +
                ((k : ℕ) : R_M) * (B_m ^ k * (ν_m - θ₀ * ξ m)) +
                ((k : ℕ) : R_M) * ((B_m ^ k - b ^ k) * (θ₀ * ξ m)) := by
          rw [hnorm_conj, mul_pow]
          ring
        have hpiece1 :
            B_m ^ k * ((1 + ν_m) ^ k - 1 - ((k : ℕ) : R_M) * ν_m) = 0 ∨
              B_val ≤ vM₁' (B_m ^ k * ((1 + ν_m) ^ k - 1 - ((k : ℕ) : R_M) * ν_m)) := by
          have hmul := hvalM₁'_mul_ge (-(k : ℤ) * (t₁ : ℤ)) V_pert
            (B_m ^ k) ((1 + ν_m) ^ k - 1 - ((k : ℕ) : R_M) * ν_m)
            (hWb_pow k) (hν_quad ν_m hν_val k)
          refine hvalM₁'_mono B_val _ _ ?_ hmul
          dsimp [B_val]
          exact le_of_eq (by ring)
        have hpiece2 :
            ((k : ℕ) : R_M) * (B_m ^ k * (ν_m - θ₀ * ξ m)) = 0 ∨
