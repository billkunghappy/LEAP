      hq_norm_tr_K₁ h w (by rw [hdE_def]; exact hw)
    rw [hTh_eq] at hq_raw
    have hquad_diff :
        (2 * u - u ^ 2) - traceLM F hM₁'K₁ (2 * w - w ^ 2) = 0 ∨
