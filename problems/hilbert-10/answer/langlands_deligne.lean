            ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x)) ∧
      H 0 = 1 ∧
      (∀ a₁ a₂ : k_L, H (a₁ + a₂) = H a₁ * H a₂ * ψ₀ (a₁ * a₂)) := by
    intro θ c δ hθ_triv hc_stat hδ_val hquad H
    have hP_δ : P (d : ℤ) (δ : L) := hP_of_val hδ_val
    have hδx_P1 : ∀ {x : L}, P 0 x → P 1 ((δ : L) * x) :=
      fun hx => hP_mono (by omega) (hP_mul hP_δ hx)
    have hH_spec : ∀ x : L, P 0 x → ∀ hx : 1 + (δ : L) * x ≠ 0,
        H (resL x) =
          (θ (Units.mk0 (1 + (δ : L) * x) hx) : Ω F)⁻¹ *
            ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x) := by
      intro x₁ hx₁ hx₁_ne
      set x₂ := liftL (resL x₁)
      have hx₂ : P 0 x₂ := hliftL_int (resL x₁)
      have hx₂_ne : 1 + (δ : L) * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
      dsimp only [H]
      rw [dif_pos hx₂_ne]
      have h12 : P 1 (x₁ - x₂) :=
        hresL_sub_mem1 hx₁ hx₂ (hliftL_res (resL x₁)).symm
      have hδ12_stat : P (((b + 1) / 2 : ℕ) : ℤ) ((δ : L) * (x₁ - x₂)) :=
        hP_mono (by omega) (hP_mul hP_δ h12)
      have hδ12_P1 : P 1 ((δ : L) * (x₁ - x₂)) := hP_mono (by omega) hδ12_stat
      have hw_ne : 1 + (δ : L) * (x₁ - x₂) ≠ 0 := h1_add_ne hδ12_P1
      set u₁ := Units.mk0 (1 + (δ : L) * x₁) hx₁_ne
      set u₂ := Units.mk0 (1 + (δ : L) * x₂) hx₂_ne
      set w := Units.mk0 (1 + (δ : L) * (x₁ - x₂)) hw_ne
      have hu₁_val : valL F L (u₁ : L) = 0 := h1_add_val (hδx_P1 hx₁)
      have hpoly : ((u₂ * w : Lˣ) : L) - (u₁ : L) =
          (δ : L) ^ 2 * (x₂ * (x₁ - x₂)) := by
        dsimp only [u₁, u₂, w]
        rw [Units.val_mul, Units.val_mk0, Units.val_mk0, Units.val_mk0]
        ring
      have hpoly_Pb : P (b : ℤ) (((u₂ * w : Lˣ) : L) - (u₁ : L)) := by
        rw [hpoly]
        exact hP_mono (by omega) (hP_mul (hP_sq hP_δ) (hP_mul hx₂ h12))
      have hθ_eq : θ (u₂ * w) = θ u₁ := hθ_congr θ hθ_triv hu₁_val hpoly_Pb
      have hθ_mul : (θ u₁ : Ω F) = (θ u₂ : Ω F) * (θ w : Ω F) := by
        rw [← hθ_eq, map_mul, Units.val_mul]
      have hθ_w : (θ w : Ω F) = ψ (((c⁻¹ : Lˣ) : L) * ((δ : L) * (x₁ - x₂))) :=
        hc_stat ((δ : L) * (x₁ - x₂)) hδ12_stat hw_ne
      have hψ_split : ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₁) =
          ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₂) * (θ w : Ω F) := by
        rw [hθ_w, ← ψ.map_add_eq_mul]
        congr 1
        ring
      rw [hθ_mul, hψ_split, mul_inv]
      calc (θ u₂ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₂)
        _ = (θ u₂ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₂) * 1 := (mul_one _).symm
        _ = (θ u₂ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₂) *
            ((θ w : Ω F)⁻¹ * (θ w : Ω F)) := by
          rw [inv_mul_cancel₀ (Units.ne_zero (θ w))]
        _ = (θ u₂ : Ω F)⁻¹ * (θ w : Ω F)⁻¹ *
            (ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₂) * (θ w : Ω F)) := by
          ring
    have hH_0 : H 0 = 1 := by
      have h1_0_ne : 1 + (δ : L) * (0 : L) ≠ 0 := by simp
      rw [← hresL_0, hH_spec 0 (hP_zero 0) h1_0_ne]
      have hmk_one : Units.mk0 (1 + (δ : L) * (0 : L)) h1_0_ne = 1 := by
        apply Units.ext; simp
      rw [hmk_one, map_one, Units.val_one, inv_one, one_mul, mul_zero, ψ.map_zero_eq_one]
    have hH_add : ∀ a₁ a₂ : k_L, H (a₁ + a₂) = H a₁ * H a₂ * ψ₀ (a₁ * a₂) := by
      intro a₁ a₂
      set x₁ := liftL a₁
      set x₂ := liftL a₂
      have hx₁ : P 0 x₁ := hliftL_int a₁
      have hx₂ : P 0 x₂ := hliftL_int a₂
      have hx12 : P 0 (x₁ + x₂) := hP_add hx₁ hx₂
      have hmul12 : P 0 (x₁ * x₂) := hP_mono (by omega) (hP_mul hx₁ hx₂)
      have hu₁_ne : 1 + (δ : L) * x₁ ≠ 0 := h1_add_ne (hδx_P1 hx₁)
      have hu₂_ne : 1 + (δ : L) * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
      have hu12_ne : 1 + (δ : L) * (x₁ + x₂) ≠ 0 := h1_add_ne (hδx_P1 hx12)
      have hδ2_stat : P (((b + 1) / 2 : ℕ) : ℤ) ((δ : L) ^ 2 * (x₁ * x₂)) :=
        hP_mono (by omega) (hP_mul (hP_sq hP_δ) hmul12)
      have hwq_ne : 1 + (δ : L) ^ 2 * (x₁ * x₂) ≠ 0 :=
        h1_add_ne (hP_mono (by omega) hδ2_stat)
      set u₁ := Units.mk0 (1 + (δ : L) * x₁) hu₁_ne
      set u₂ := Units.mk0 (1 + (δ : L) * x₂) hu₂_ne
      set u₁₂ := Units.mk0 (1 + (δ : L) * (x₁ + x₂)) hu12_ne
      set w_q := Units.mk0 (1 + (δ : L) ^ 2 * (x₁ * x₂)) hwq_ne
      have hu1u2_val : valL F L ((u₁ * u₂ : Lˣ) : L) = 0 := by
        rw [Units.val_mul, hval_mul (u₁ : L) (u₂ : L) (Units.ne_zero _) (Units.ne_zero _)]
        dsimp only [u₁, u₂]
        rw [Units.val_mk0, Units.val_mk0,
          h1_add_val (hδx_P1 hx₁), h1_add_val (hδx_P1 hx₂), add_zero]
      have hpoly_q : ((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L) =
          (δ : L) ^ 2 * ((δ : L) * (x₁ * x₂ * (x₁ + x₂))) := by
        dsimp only [u₁, u₂, u₁₂, w_q]
        rw [Units.val_mul, Units.val_mul, Units.val_mk0, Units.val_mk0,
          Units.val_mk0, Units.val_mk0]
        ring
      have hpoly_q_Pb : P (b : ℤ) (((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L)) := by
        rw [hpoly_q]
        exact hP_mono (by omega)
          (hP_mul (hP_sq hP_δ) (hP_mul hP_δ (hP_mul hmul12 hx12)))
      have hθ_q_eq : θ (u₁₂ * w_q) = θ (u₁ * u₂) :=
        hθ_congr θ hθ_triv hu1u2_val hpoly_q_Pb
      have hθ_inv_eq : (θ u₁₂ : Ω F)⁻¹ =
          (θ u₁ : Ω F)⁻¹ * (θ u₂ : Ω F)⁻¹ * (θ w_q : Ω F) := by
        have h1 : (θ u₁₂ : Ω F) * (θ w_q : Ω F) = (θ u₁ : Ω F) * (θ u₂ : Ω F) := by
          exact_mod_cast (map_mul θ u₁₂ w_q).symm.trans (hθ_q_eq.trans (map_mul θ u₁ u₂))
        rw [← mul_inv, ← h1, mul_inv, mul_assoc, inv_mul_cancel₀ (Units.ne_zero (θ w_q)), mul_one]
      have hθ_wq : (θ w_q : Ω F) = ψ₀ (a₁ * a₂) := by
        rw [hc_stat ((δ : L) ^ 2 * (x₁ * x₂)) hδ2_stat hwq_ne, ← mul_assoc,
          hquad (x₁ * x₂) hmul12, (hresL_ring x₁ x₂ hx₁ hx₂).2.1,
          hliftL_res a₁, hliftL_res a₂]
      have hres_add : a₁ + a₂ = resL (x₁ + x₂) := by
        rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res a₁, hliftL_res a₂]
      have hψ_add : ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * (x₁ + x₂)) =
          ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₁) *
            ψ (((c⁻¹ : Lˣ) : L) * (δ : L) * x₂) := by
        rw [← ψ.map_add_eq_mul]
        congr 1
        ring
      rw [hres_add, hH_spec (x₁ + x₂) hx12 hu12_ne,
        ← hliftL_res a₁, ← hliftL_res a₂,
        hH_spec x₁ hx₁ hu₁_ne, hH_spec x₂ hx₂ hu₂_ne,
        hliftL_res a₁, hliftL_res a₂, hθ_inv_eq, hθ_wq, hψ_add]
      ring
    exact ⟨hH_spec, hH_0, hH_add⟩
  have hRL_inj : Set.InjOn resL R_L := by
    intro r₁ hr₁ r₂ hr₂ hres_eq
    by_contra hr_ne
    have hval0_sub : valL F L (r₁ - r₂) = 0 := hRL_sep r₁ hr₁ r₂ hr₂ hr_ne
    have hsub_P1 : P 1 (r₁ - r₂) :=
      hresL_sub_mem1 (hRL_int r₁ hr₁) (hRL_int r₂ hr₂) hres_eq
    rcases hsub_P1 with hsub0 | hval1_sub
    · exact hr_ne (sub_eq_zero.mp hsub0)
    · omega
  have hRL_image : R_L.image resL = Finset.univ := by
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Finset.card_image_of_injOn hRL_inj, hRL_card]
  have hRL_surj_univ : ∀ b_res ∈ (Finset.univ : Finset k_L), ∃ r ∈ R_L, resL r = b_res := by
    intro b_res hb_res
    rw [← hRL_image] at hb_res
    exact Finset.mem_image.mp hb_res
  have hRL_sum_bij : ∀ g : k_L → Ω F, (∑ r ∈ R_L, g (resL r)) = ∑ x : k_L, g x := by
    intro g
    refine Finset.sum_bij (fun r _ => resL r) ?_ ?_ ?_ ?_
    · intro r _; exact Finset.mem_univ _
    · intro r₁ hr₁ r₂ hr₂ heq; exact hRL_inj hr₁ hr₂ heq
    · intro b_res hb_res
      obtain ⟨r, hr, hres⟩ := hRL_surj_univ b_res hb_res
      exact ⟨r, hr, hres⟩
    · intro _ _; rfl
  let H_τ : k_L → Ω F := fun a =>
    if hx : 1 + (δ_τ : L) * liftL a ≠ 0 then
      (ν₁ (Units.mk0 (1 + (δ_τ : L) * liftL a) hx) : Ω F)⁻¹ *
        ψ (A * (δ_τ : L) * liftL a)
    else 0
  let H_χ : k_L → Ω F := fun a =>
    if hx : 1 + (δ_χ : L) * liftL a ≠ 0 then
      (χ' (Units.mk0 (1 + (δ_χ : L) * liftL a) hx) : Ω F)⁻¹ *
        ψ (((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * liftL a)
    else 0
  have hHτ_all :
      (∀ x : L, P 0 x → ∀ hx : 1 + (δ_τ : L) * x ≠ 0,
        H_τ (resL x) =
          (ν₁ (Units.mk0 (1 + (δ_τ : L) * x) hx) : Ω F)⁻¹ *
            ψ (A * (δ_τ : L) * x)) ∧
      H_τ 0 = 1 ∧
      (∀ a₁ a₂ : k_L, H_τ (a₁ + a₂) = H_τ a₁ * H_τ a₂ * ψ₀ (a₁ * a₂)) :=
    hPolar_gen ν₁ c_τ δ_τ hν₁_triv hc_τ_stat hδτ_val hquad_τ
  obtain ⟨hHτ_spec, hHτ_0, hHτ_add⟩ := hHτ_all
  have hc_χ_stat' : ∀ x : L, P (((b + 1) / 2 : ℕ) : ℤ) x → ∀ hx : 1 + x ≠ 0,
      (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x) := by
    intro x hx hx_ne
    apply hc_χ_stat x
    rwa [hab_eq]
  have hHχ_all :
      (∀ x : L, P 0 x → ∀ hx : 1 + (δ_χ : L) * x ≠ 0,
        H_χ (resL x) =
          (χ' (Units.mk0 (1 + (δ_χ : L) * x) hx) : Ω F)⁻¹ *
            ψ (((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * x)) ∧
      H_χ 0 = 1 ∧
      (∀ a₁ a₂ : k_L, H_χ (a₁ + a₂) = H_χ a₁ * H_χ a₂ * ψ₀ (a₁ * a₂)) :=
    hPolar_gen χ' c_χ δ_χ hχ'_triv hc_χ_stat' hδχ_val hquad_χ
  obtain ⟨hHχ_spec, hHχ_0, hHχ_add⟩ := hHχ_all
  have hS_τ : (∑ r ∈ R_L,
      if hr : 1 + (δ_τ : L) * r ≠ 0 then
        (ν₁ (Units.mk0 (1 + (δ_τ : L) * r) hr) : Ω F)⁻¹ *
          ψ (A * (δ_τ : L) * r)
      else 0) = (∑ x : k_L, H_τ x) := by
    rw [← hRL_sum_bij H_τ]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_ne : 1 + (δ_τ : L) * r ≠ 0 :=
      h1_add_ne (hP_mono (by omega) (hP_mul (hP_of_val hδτ_val) (hRL_int r hr)))
    rw [dif_pos hr_ne, hHτ_spec r (hRL_int r hr) hr_ne]
  have hS_χ : (∑ r ∈ R_L,
      if hr : 1 + (δ_χ : L) * r ≠ 0 then
        (χ' (Units.mk0 (1 + (δ_χ : L) * r) hr) : Ω F)⁻¹ *
          ψ (((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * r)
      else 0) = (∑ y : k_L, H_χ y) := by
    rw [← hRL_sum_bij H_χ]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_ne : 1 + (δ_χ : L) * r ≠ 0 :=
      h1_add_ne (hP_mono (by omega) (hP_mul (hP_of_val hδχ_val) (hRL_int r hr)))
    rw [dif_pos hr_ne, hHχ_spec r (hRL_int r hr) hr_ne]
  have h1_lt_p : 1 < Module.finrank L (IntermediateField.extendScalars hLK) := by omega
  obtain ⟨hτ_tilde1, hτ_unit1, _, _, _, _, _, hc_twist1_inv⟩ :=
    hτ_props 1 h1_lt_p (by omega)
  have hτ_unit1_val : (τ_unit 1 : L) = 1 := by
    rw [hτ_unit1, Units.val_pow_eq_pow_val, hτ_tilde1, Nat.cast_one, one_pow, one_pow]
  have hc_twist1_eq : (((c_twist 1)⁻¹ : Lˣ) : L) = ((c_χ⁻¹ : Lˣ) : L) + A := by
    rw [hc_twist1_inv, hτ_unit1_val, hcχ_inv_eq]
    ring
  have hδ_mul_u0 : ∀ r : L, (δ_τ : L) * r = (δ_χ : L) * ((u_0 : L) * r) := by
    intro r
    have h_u : δ_χ * u_0 = δ_τ := inv_mul_cancel_right δ_τ u_0
    have h_val : (δ_χ : L) * (u_0 : L) = (δ_τ : L) := by
      exact_mod_cast h_u
    rw [← mul_assoc, h_val]
  have hS_twist : (∑ r ∈ R_L,
      if hr : 1 + (δ_τ : L) * r ≠ 0 then
        ((ν₁ * χ') (Units.mk0 (1 + (δ_τ : L) * r) hr) : Ω F)⁻¹ *
          ψ ((((c_twist 1)⁻¹ : Lˣ) : L) * (δ_τ : L) * r)
      else 0) = (∑ w : k_L, H_χ (resL (u_0 : L) * w) * H_τ w) := by
    rw [← hRL_sum_bij (fun w => H_χ (resL (u_0 : L) * w) * H_τ w)]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_int : P 0 r := hRL_int r hr
    have hu0r_int : P 0 ((u_0 : L) * r) :=
      hP_mono (by omega) (hP_mul (hP_of_val hu0_val) hr_int)
    have hr_ne : 1 + (δ_τ : L) * r ≠ 0 :=
      h1_add_ne (hP_mono (by omega) (hP_mul (hP_of_val hδτ_val) hr_int))
    have hr_ne_χ : 1 + (δ_χ : L) * ((u_0 : L) * r) ≠ 0 := by
      rwa [← hδ_mul_u0 r]
    have hmk_eq : Units.mk0 (1 + (δ_τ : L) * r) hr_ne =
        Units.mk0 (1 + (δ_χ : L) * ((u_0 : L) * r)) hr_ne_χ := by
      apply Units.ext
      simp [hδ_mul_u0 r]
    have hres_u0r : resL (u_0 : L) * resL r = resL ((u_0 : L) * r) :=
      ((hresL_ring (u_0 : L) r (hP_of_val hu0_val) hr_int).2.1).symm
    have hψ_twist : ψ ((((c_twist 1)⁻¹ : Lˣ) : L) * (δ_τ : L) * r) =
        ψ (((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * ((u_0 : L) * r)) *
          ψ (A * (δ_τ : L) * r) := by
      rw [← ψ.map_add_eq_mul, hc_twist1_eq]
      congr 1
      calc (((c_χ⁻¹ : Lˣ) : L) + A) * (δ_τ : L) * r
        _ = ((c_χ⁻¹ : Lˣ) : L) * ((δ_τ : L) * r) + A * (δ_τ : L) * r := by ring
        _ = ((c_χ⁻¹ : Lˣ) : L) * ((δ_χ : L) * ((u_0 : L) * r)) + A * (δ_τ : L) * r := by
          rw [hδ_mul_u0 r]
        _ = ((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * ((u_0 : L) * r) + A * (δ_τ : L) * r := by ring
    rw [dif_pos hr_ne, MonoidHom.mul_apply, Units.val_mul, mul_inv,
      hres_u0r, hHχ_spec ((u_0 : L) * r) hu0r_int hr_ne_χ,
      hHτ_spec r hr_int hr_ne, ← hmk_eq, hψ_twist]
    ring
  exact ⟨ψ₀, H_τ, H_χ, hψ₀_spec, hHτ_spec, hHχ_spec, hψ₀_0, hψ₀_add, hψ₀_sq, hψ₀_ne1,
    hHτ_0, hHτ_add, hHχ_0, hHχ_add, hS_τ, hS_χ, hS_twist⟩

theorem ld_dyadic_boundary_K_sum_and_prefactor_assembly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp_eq2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hab_eq : condExp F L χ' = condExp F L ν₁)
    (hb_odd : condExp F L ν₁ % 2 = 1)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
