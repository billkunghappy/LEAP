    have h_pow_eq :
        (a_tilde m) ^ (d_exp m) =
          ι_res ((α_L ^ q)⁻¹ * (γ_L m)⁻¹ * (c_E0 ^ q * c_m)) := by
      rw [map_mul, map_mul, map_mul, map_inv₀, map_inv₀, map_pow, map_pow]
      change (a_tilde m) ^ (d_exp m) = (α_M ^ q)⁻¹ * (γ_M m)⁻¹ * (ι_res c_E0 ^ q * ι_res c_m)
      rw [← h_eq]
      calc (a_tilde m) ^ (d_exp m)
          = ((α_M ^ q * (α_M ^ q)⁻¹) * (γ_M m * (γ_M m)⁻¹)) * (a_tilde m) ^ (d_exp m) := by
            rw [mul_inv_cancel₀ hαM_q_ne, mul_inv_cancel₀ hγM_ne, mul_one, one_mul]
        _ = (α_M ^ q)⁻¹ * (γ_M m)⁻¹ * (α_M ^ q * γ_M m * (a_tilde m) ^ (d_exp m)) := by ring
    exact h_frob_mem_range (r_exp - (m : ℕ)) (a_tilde m)
      ((α_L ^ q)⁻¹ * (γ_L m)⁻¹ * (c_E0 ^ q * c_m)) h_pow_eq
  have ha_tilde_all : ∀ m : Fin r_exp, ∃ c : k_L, a_tilde m = ι_res c := by
    intro m
    by_cases hm : m = m₀
    · exact ⟨c_E0, hm ▸ hc_E0⟩
    · exact ha_tilde_mem m (Finset.mem_erase.mpr ⟨hm, Finset.mem_univ m⟩)
  let c_E (m : Fin r_exp) : k_L := (ha_tilde_all m).choose
  have hc_E_spec : ∀ m : Fin r_exp, a_tilde m = ι_res (c_E m) :=
    fun m => (ha_tilde_all m).choose_spec
  have h_neg1_pow_p : ∀ n : ℕ, 1 ≤ n → (-1 : k_M) ^ (p ^ n - 1) = 1 := by
    intro n _
    by_cases hp2 : p = 2
    · have h2_zero : (2 : k_M) = 0 := by exact_mod_cast (hp2 ▸ hchar_M)
      have h_neg1 : (-1 : k_M) = 1 := by linear_combination -h2_zero
      rw [h_neg1, one_pow]
    · have hp_odd : Odd p := hp.odd_of_ne_two hp2
      have hpn_odd : Odd (p ^ n) := Odd.pow hp_odd
      have hpn1_even : Even (p ^ n - 1) := Nat.Odd.sub_odd hpn_odd odd_one
      exact hpn1_even.neg_one_pow
  have hQ₁_eval_neg1 :
      Polynomial.eval (-1 : k_M) Q₁ =
        ω_tilde ^ q +
          ((∑ m ∈ S_pos, α_M ^ q * γ_M m * (a_tilde m) ^ (d_exp m)) + α_M ^ q) := by
    dsimp [Q₁, B₁]
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_X, Polynomial.eval_pow, Polynomial.eval_finset_sum]
    have h_q1 : (-1 : k_M) ^ (q - 1) = 1 := by
      rw [hq_pow]
      exact h_neg1_pow_p r_exp hr_exp_pos
    have h_sum_neg1 :
        (∑ m ∈ S_pos, (α_M ^ q * γ_M m * (a_tilde m) ^ (d_exp m)) * (-1 : k_M) ^ (d_exp m - 1)) =
          ∑ m ∈ S_pos, α_M ^ q * γ_M m * (a_tilde m) ^ (d_exp m) := by
      refine Finset.sum_congr rfl (fun m hm => ?_)
      have hm_ne : m ≠ m₀ := (Finset.mem_erase.mp hm).1
      have hm_val_ne : (m : ℕ) ≠ 0 := fun h0 => hm_ne (Fin.ext h0)
      have h_sub_ge1 : 1 ≤ r_exp - (m : ℕ) := by omega
      have h_dm1 : (-1 : k_M) ^ (d_exp m - 1) = 1 :=
        h_neg1_pow_p (r_exp - (m : ℕ)) h_sub_ge1
      rw [h_dm1, mul_one]
    rw [h_q1, mul_one, h_sum_neg1]
  have hP_eval0 :
      Polynomial.eval (0 : k_M) (Polynomial.C (ω_tilde ^ q) * P_α) =
        ω_tilde ^ q * ∏ j : Fin (q - 1), (- α_bar j) := by
    dsimp [P_α]
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_prod,
      Polynomial.eval_sub, Polynomial.eval_X, zero_sub]
  have h_prod_neg_α : ω_tilde ^ q * (∏ j : Fin (q - 1), (- α_bar j)) = α_M ^ q := by
    have heval0 := congrArg (Polynomial.eval (0 : k_M)) hQ₁_eq
    rw [hQ₁_eval0, hP_eval0] at heval0
    exact heval0.symm
  have hP_eval_neg1 :
      Polynomial.eval (-1 : k_M) (Polynomial.C (ω_tilde ^ q) * P_α) =
        α_M ^ q * ι_res U_θ_bar := by
    dsimp [P_α]
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_prod,
      Polynomial.eval_sub, Polynomial.eval_X]
    have h_factor : ∀ j : Fin (q - 1),
        -1 - α_bar j = (- α_bar j) * (1 + (α_bar j)⁻¹) := by
      intro j
      have h_inv : α_bar j * (α_bar j)⁻¹ = 1 := mul_inv_cancel₀ (hα_bar_ne j)
      calc -1 - α_bar j
          = - (α_bar j * (α_bar j)⁻¹) - α_bar j := by rw [h_inv]
        _ = (- α_bar j) * (1 + (α_bar j)⁻¹) := by ring
    simp_rw [h_factor]
    rw [Finset.prod_mul_distrib, ← mul_assoc, h_prod_neg_α, ← hU_θ_prod]
  have hU_θ_eq_M :
      ι_res ((c_E m₀) ^ q + ((∑ m ∈ S_pos, α_L ^ q * γ_L m * (c_E m) ^ (d_exp m)) + α_L ^ q)) =
        ι_res (α_L ^ q * U_θ_bar) := by
    have heval := congrArg (Polynomial.eval (-1 : k_M)) hQ₁_eq
    rw [hQ₁_eval_neg1, hP_eval_neg1] at heval
    have hω_eq : ω_tilde = ι_res (c_E m₀) := hc_E_spec m₀
    rw [hω_eq] at heval
    simp only [hc_E_spec, map_add, map_mul, map_pow, map_sum] at heval ⊢
    exact heval
  have hU_θ_eq_L :
      α_L ^ q * U_θ_bar =
        (c_E m₀) ^ q + ((∑ m ∈ S_pos, α_L ^ q * γ_L m * (c_E m) ^ (d_exp m)) + α_L ^ q) :=
    (ι_res.injective hU_θ_eq_M).symm
  have hU_θ_formula :
      U_θ_bar =
        (α_L ^ q)⁻¹ * (c_E m₀) ^ q +
          ((∑ m ∈ S_pos, γ_L m * (c_E m) ^ (d_exp m)) + 1) := by
    have hαL_q_ne : α_L ^ q ≠ 0 := pow_ne_zero q hαL_ne
    calc U_θ_bar
        = (α_L ^ q)⁻¹ * (α_L ^ q * U_θ_bar) := by
          rw [← mul_assoc, inv_mul_cancel₀ hαL_q_ne, one_mul]
      _ = (α_L ^ q)⁻¹ *
            ((c_E m₀) ^ q + ((∑ m ∈ S_pos, α_L ^ q * γ_L m * (c_E m) ^ (d_exp m)) + α_L ^ q)) := by
          rw [hU_θ_eq_L]
      _ = (α_L ^ q)⁻¹ * (c_E m₀) ^ q +
            ((α_L ^ q)⁻¹ * (∑ m ∈ S_pos, α_L ^ q * γ_L m * (c_E m) ^ (d_exp m)) +
              (α_L ^ q)⁻¹ * α_L ^ q) := by
          ring
      _ = (α_L ^ q)⁻¹ * (c_E m₀) ^ q +
            ((∑ m ∈ S_pos, γ_L m * (c_E m) ^ (d_exp m)) + 1) := by
          rw [inv_mul_cancel₀ hαL_q_ne, Finset.mul_sum]
          congr 2
          refine Finset.sum_congr rfl (fun m _ => ?_)
          calc (α_L ^ q)⁻¹ * (α_L ^ q * γ_L m * (c_E m) ^ (d_exp m))
              = ((α_L ^ q)⁻¹ * α_L ^ q) * (γ_L m * (c_E m) ^ (d_exp m)) := by ring
            _ = γ_L m * (c_E m) ^ (d_exp m) := by rw [inv_mul_cancel₀ hαL_q_ne, one_mul]
  have hs₀_eq_M :
      ι_res s₀_bar =
        ι_res (x₀_bar ^ q + ∑ m : Fin r_exp, c_E m * x₀_bar ^ (p ^ (m : ℕ))) := by
    rw [hs₀_tilde]
    simp only [hc_E_spec, map_add, map_mul, map_pow, map_sum]
  have hs₀_eq_L :
      s₀_bar =
        x₀_bar ^ q +
          (c_E m₀ * x₀_bar ^ (p ^ (m₀ : ℕ)) +
            ∑ m ∈ S_pos, c_E m * x₀_bar ^ (p ^ (m : ℕ))) := by
    have h1 := ι_res.injective hs₀_eq_M
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ m₀)] at h1
    exact h1
  have hψL_m₀ :
      ψ_L (c_E m₀ * x₀_bar ^ (p ^ (m₀ : ℕ))) =
        ψ_L (((α_L ^ q)⁻¹ * (c_E m₀) ^ q) * x₀_bar ^ q) := by
    change ψ_L (c_E m₀ * x₀_bar ^ (p ^ 0)) = _
    rw [pow_zero, pow_one, ← hαL_inv_frob (c_E m₀ * x₀_bar)]
    congr 1
    rw [mul_pow]
    ring
  have hψL_m : ∀ m ∈ S_pos,
      ψ_L (c_E m * x₀_bar ^ (p ^ (m : ℕ))) =
        ψ_L ((γ_L m * (c_E m) ^ (d_exp m)) * x₀_bar ^ q) := by
    intro m _
    rw [← hγL_frob m (c_E m * x₀_bar ^ (p ^ (m : ℕ)))]
    congr 1
    rw [mul_pow, ← pow_mul, h_pow_d m]
    ring
  have h_prod_L :
      (∏ m ∈ S_pos, ψ_L (c_E m * x₀_bar ^ (p ^ (m : ℕ)))) =
        ψ_L ((∑ m ∈ S_pos, γ_L m * (c_E m) ^ (d_exp m)) * x₀_bar ^ q) := by
    rw [Finset.sum_mul, hψL_sum S_pos]
    exact Finset.prod_congr rfl (fun m hm => hψL_m m hm)
  rw [hs₀_eq_L, hψL_add, hψL_add, hψL_m₀, hψL_sum S_pos, h_prod_L, ← hψL_add, ← hψL_add]
  congr 1
  rw [hU_θ_formula]
  ring

theorem ld_ch14_higher_cond_vieta_and_critical_polynomial_on_MC (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_Cˣ →* (Ω F)ˣ))
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hν_inj : Function.Injective ν_all)
    (hν_props : ∀ j,
      ν_all j ≠ 1 ∧
      (ν_all j) ^ (p F) = 1 ∧
      (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
      (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
      (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
      (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
      ∀ w : M_Cˣ,
        (ν_all j) w =
          ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
            (Units.map (σ_all j).toRingEquiv.toMonoidHom w))
    (hν_prod : ∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_orb (idx_all j))) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)))
    (hFrobSurjL : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (hFrobSurjLp : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (p F) = 0 ∨ 1 ≤ valL F L (x - s ^ (p F))))
    (hFrobSurjMC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F))))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hTrBoundMCL : ∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hTrFrobMCL : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F) = 0 ∨
        1 ≤ valL F L (traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F)))
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
        valL F (D_orb.get i).field x)
    (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_L : Lˣ)
    (hϖ_valMC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_valL : valL F L (ϖ_L : L) = 1)
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp) (a_coeff : Fin r_exp → M_C)
    (hq_pow : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (ha_int : ∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j))
    (ha0_tr : a_coeff ⟨0, hr_exp_pos⟩ -
      (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) = 0 ∨
      1 ≤ valL F M_C (a_coeff ⟨0, hr_exp_pos⟩ -
        (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)))
    (hTr_val0 : valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)) = 0)
    (hP_def : ∀ z : M_C,
      P_poly z =
        z ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
          ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ))))
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc₁_val : valL F L ((((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ' : Lˣ) : L)) =
      1 + condExpChar F L ψ)
    (hc_μ_val : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (c'_μ i : (D_orb.get i).field) =
        (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))
    (u_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hu_all_def : ∀ j,
      u_all j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          ((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ') *
          (ϖ_MC ^ t) *
          (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c'_μ (idx_all j))))⁻¹)
    (hu_all_val : ∀ j, valL F M_C ((u_all j : M_Cˣ) : M_C) = 0)
    (hu_all_P : ∀ j, ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceChar F hLM_C ψ)
        ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          ((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ'))⁻¹ : M_Cˣ) : M_C) *
          ((u_all j : M_C) * P_poly z)) = 1)
    (hu_all_inj : ∀ j₁ j₂,
      ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
      j₁ = j₂) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let a := condExp F L χ'
    let c₁ : Lˣ := (ϖ_L ^ (a - 1))⁻¹ * c'_χ'
    ∃ (u_α : Lˣ) (u_ω : M_Cˣ),
      valL F L (u_α : L) = 0 ∧
      valL F M_C (u_ω : M_C) = 0 ∧
      (u_ω : M_C) = (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ψ (((c₁⁻¹ : Lˣ) : L) * ((u_α : L) * x)) =
          ψ (((c₁⁻¹ : Lˣ) : L) * (x ^ q))) ∧
      (∏ j : Fin (q - 1), u_all j) *
        (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (u_α ^ q))⁻¹ *
        (u_ω ^ q) ∈ unitGroup F M_C 1 ∧
      (k * (a - 1) = t →
        ∀ (v_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
          (∀ i : Fin D_orb.length,
            let F_i := (D_orb.get i).field
            let α_i : F_iˣ :=
              Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ' *
                (c'_μ i)⁻¹
            valL F F_i (v_θ i : F_i) = 0 ∧
            (v_θ i : F_i) = 1 + ((α_i⁻¹ : F_iˣ) : F_i)) →
          ∀ (z_η : M_Cˣ),
            valL F M_C (z_η : M_C) = 0 →
            (z_η ^ q) *
              (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (a - 1)) *
                (ϖ_MC ^ t)⁻¹)⁻¹ ∈ unitGroup F M_C 1 →
            ∀ (x₀ s₀ : L),
              (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
              (s₀ = 0 ∨ 0 ≤ valL F L s₀) →
              (IntermediateField.inclusion hLM_C s₀ *
                  (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (a - 1)) *
                    (ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) -
                P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)) = 0 ∨
                1 ≤ valL F M_C
                  (IntermediateField.inclusion hLM_C s₀ *
                      (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (a - 1)) *
                        (ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) -
                    P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)))) →
              ψ (((c₁⁻¹ : Lˣ) : L) * s₀) =
                ψ (((c₁⁻¹ : Lˣ) : L) *
                  ((((∏ i : Fin D_orb.length,
                    Units.map (normLM F (D_orb.get i).le) (v_θ i)) : Lˣ) : L) *
                    (x₀ ^ q)))) :=
by
  have hp : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
  obtain ⟨u_α, k_L, hField_kL, hFin_kL, resL, k_M, hField_kM, hFin_kM, resM,
      ι_res, ψ_L, ψ_M, α_L, a_bar, β,
      hu_α_val, hu_α_frob,
      hresL_0, hresL_1, hresL_ring, hresL_ker,
      hresM_0, hresM_1, hresM_ring, hresM_ker,
      hι_res, hβ_def, hchar_L, hchar_M,
      hψL_0, hψL_add, hψL_ne, hψM_0, hψM_add, hψM_ne,
      hαL_ne, hαL_frob, hFrob_lift,
      hβ_inj, hβ_ne, hβ_P, hBridge_Y0, hBridge_crit⟩ :=
    ld_ch14_higher_cond_local_to_residue_frob_bridge F L K M_C hLM_C hM_CK
      ψ hψ hψMC χ' hFrobSurjL t k ht_ge1 hk_ge1
      hValAlgMCL hTrBoundMCL hTrFrobMCL hnMC
      P_poly ϖ_K ϖ_MC ϖ_L r_exp hr_exp_pos a_coeff hq_pow ha_int ha0_tr hTr_val0 hP_def
      c'_χ' hc₁_val u_all hu_all_val hu_all_P hu_all_inj
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  letI : Field k_M := hField_kM
  letI : Fintype k_M := hFin_kM
  have hαM_ne : ι_res α_L ≠ 0 :=
    fun h0 => hαL_ne (ι_res.injective (h0.trans ι_res.map_zero.symm))
  have hαM_frob : ∀ w : k_M, ψ_M (ι_res α_L * w) = ψ_M (w ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))) := by
    intro w
    have hinv : ∀ b : k_L,
        ψ_L (((α_L ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))⁻¹) *
          b ^ ((p F) ^ r_exp)) = ψ_L b := by
      intro b
      rw [← hq_pow]
      calc ψ_L ((α_L ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))⁻¹ *
            b ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
          = ψ_L ((α_L⁻¹ * b) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))) := by
            rw [mul_pow, inv_pow]
        _ = ψ_L (α_L * (α_L⁻¹ * b)) := (hαL_frob (α_L⁻¹ * b)).symm
        _ = ψ_L b := by rw [← mul_assoc, mul_inv_cancel₀ hαL_ne, one_mul]
    have hM_inv := hFrob_lift r_exp
      ((α_L ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))⁻¹) hinv (ι_res α_L * w)
    rw [← hq_pow, map_inv₀, map_pow, mul_pow, ← mul_assoc,
      inv_mul_cancel₀ (pow_ne_zero _ hαM_ne), one_mul] at hM_inv
    exact hM_inv.symm
  have hVieta_res :=
    ld_ch14_finite_field_adjoint_vieta_root_product F k_M
      (p F) r_exp (Module.finrank M_C (IntermediateField.extendScalars hM_CK))
      hp hr_exp_pos hq_pow hchar_M ψ_M hψM_0 hψM_add hψM_ne
      (ι_res α_L) hαM_ne hαM_frob a_bar β hβ_inj hβ_ne hβ_P
  obtain ⟨u_ω, hu_ω_val, hu_ω_def, hVieta⟩ := hBridge_Y0 hVieta_res
  refine ⟨u_α, u_ω, hu_α_val, hu_ω_val, hu_ω_def, hu_α_frob, hVieta, ?_⟩
  intro hcrit v_θ hv_θ z_η hz_η_val hz_η_pow x₀ s₀ hx₀ hs₀ hs₀_poly
  obtain ⟨hu_ϖ_val, hu_ϖ_ne, hP_α_coeff, hU_θ_spec⟩ :=
    ld_ch14_critical_orbit_lagrange_and_prod_bridge F L K M_C hLM_C hM_CK
      ψ D_orb hFinFi χ' h_ge2 hFiMC μ'_orb ν_all σ_all idx_all hν_props hν_prod
      t k ht_ge1 hk_ge1 hValAlgMCL hValAlgFiMC ϖ_MC ϖ_L hϖ_valMC hϖ_valL
      r_exp hr_exp_pos hq_pow c'_χ' c'_μ hc_L_val hc_μ_val u_all hu_all_def hu_all_val
      k_L resL k_M resM ι_res hresM_0 hresM_1 hresM_ring hresM_ker hι_res β hβ_def hcrit
  obtain ⟨hU_θ_val, hU_θ_prod⟩ := hU_θ_spec v_θ hv_θ
  obtain ⟨hz_η_pow_res, hs₀_eq_res, hψ_goal⟩ :=
    hBridge_crit
      (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (v_θ i))
      (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (condExp F L χ' - 1)) *
        (ϖ_MC ^ t)⁻¹)
      z_η x₀ s₀ hU_θ_val hu_ϖ_val hz_η_val hz_η_pow hx₀ hs₀ hs₀_poly
  apply hψ_goal
  exact ld_ch14_finite_field_critical_polynomial_vieta_eval F k_L k_M ι_res
    (p F) r_exp (Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    hp hr_exp_pos hq_pow hchar_L hchar_M
    ψ_L hψL_0 hψL_add hψL_ne ψ_M hψM_0 hψM_add hψM_ne
    α_L hαL_ne hαL_frob hFrob_lift a_bar hVieta_res.1 β hβ_inj hβ_ne hβ_P
    (resM ((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (condExp F L χ' - 1)) *
      (ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C))
    (resM (z_η : M_C)) hu_ϖ_ne hz_η_pow_res hP_α_coeff
    (resL ((∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (v_θ i) : Lˣ) : L))
    (resL x₀) (resL s₀) hU_θ_prod hs₀_eq_res

theorem ld_ch14_norm_unitGroup_one_and_top_conductor (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M_C K E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F K] [FiniteDimensional F E]
    (hM_CK : M_C ≤ K)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z) :
    (∀ w₁ ∈ unitGroup F K 1,
      Units.map (normLM F hM_CK) w₁ ∈ unitGroup F M_C 1) ∧
    (∀ (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (χ'_E : Eˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F E (condExp F E χ'_E), χ'_E u = 1) →
        ∀ (m : ℕ), 2 ≤ m →
        ∀ (c' : Eˣ),
          valL F E (c' : E) = (m : ℤ) + condExpChar F E ψ_E →
          (∀ y : E, (y = 0 ∨ ((m - 1 : ℕ) : ℤ) ≤ valL F E y) →
            ∀ hy : 1 + y ≠ 0,
              (χ'_E (Units.mk0 (1 + y) hy) : Ω F) = ψ_E (((c'⁻¹ : Eˣ) : E) * y)) →
          condExp F E χ'_E = m) :=
by
  have halg_gen : ∀ (F₀ : Type u) [Field F₀] [Algebra F₀ (AlgebraicClosure F)]
      (L₀ : IntermediateField F₀ (AlgebraicClosure F)) [FiniteDimensional F₀ L₀] (z : L₀),
      minpoly F₀ (z : AlgebraicClosure F) = minpoly F₀ z ∧
      ∃ m : ℕ,
        Algebra.norm F₀ z = ((-1) ^ (minpoly F₀ z).natDegree * (minpoly F₀ z).coeff 0) ^ m ∧
        Module.finrank F₀ L₀ = (minpoly F₀ z).natDegree * m := by
    intro F₀ _ _ L₀ _ z
    have hmin_coe : minpoly F₀ (z : AlgebraicClosure F) = minpoly F₀ z :=
      minpoly.algHom_eq L₀.val L₀.val.injective z
    have hz : IsIntegral F₀ z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F₀ z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F₀ pb.gen = minpoly F₀ z := by
      have hval : (IntermediateField.adjoin F₀ {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F₀ {z}).val
        (IntermediateField.adjoin F₀ {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F₀ z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F₀ z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
    Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  have hspec_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (z : M),
      (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) =
        ‖Algebra.norm F z‖ := by
    intro M _ z
    obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg_gen F M z
    have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
        ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
      rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
    have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
      rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
      exact_mod_cast minpoly.natDegree_pos hz
    rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
       ← Real.rpow_natCast]
    congr 1
    push_cast
    rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
  have h_valL_props : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L],
      valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0) ∧
      (∀ w z : L, w ≠ 0 →
        spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
          spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
        z ≠ 0 ∧ valL F L z ≤ valL F L w) := by
    intro L _
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F L (-1) = 0 := by
      have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : L) * (-1 : L) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : L) = (-1 : L) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q : ℤ := valL F L x
        set r : ℤ := relVal F L x % f
        have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F L := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F L 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval1 : valL F L 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg1 : valL F L (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
