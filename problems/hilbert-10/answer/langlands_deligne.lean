    have hv₁_sub : (v₁ : M₁') - 1 = (τ₁ z₁ - z₁) * z₁⁻¹ := by
      change τ₁ z₁ * z₁⁻¹ - 1 = (τ₁ z₁ - z₁) * z₁⁻¹
      calc τ₁ z₁ * z₁⁻¹ - 1 = τ₁ z₁ * z₁⁻¹ - z₁ * z₁⁻¹ := by rw [mul_inv_cancel₀ hz₁_ne]
        _ = (τ₁ z₁ - z₁) * z₁⁻¹ := by ring
    have hτ₁_W : τ₁ W = ι ((α⁻¹ : Lˣ) : L) * τ₁ a₁ * ((z₁ - τ₁ z₁) * (τ₁ z₁)⁻¹) := by
      change τ₁ (ι ((α⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1)) = _
      rw [hv₁_sub, map_mul, map_mul, hτ₁_L, map_mul, map_sub τ₁ (τ₁ z₁) z₁, hτ₁_τ₁_z₁, map_inv₀]
    have h1p2x_sq : (1 + 2 * x) * (1 + 2 * x) = ι (1 + 4 * f) := by
      calc (1 + 2 * x) * (1 + 2 * x)
        _ = 1 + 4 * (x ^ 2 + x) := by ring
        _ = 1 + 4 * ι f := by rw [hx_sq]
        _ = ι (1 + 4 * f) := by simp only [map_add, map_one, map_mul, map_ofNat]
    have hdiff_z₁ : τ₁ z₁ - z₁ = ι s₀ * (1 + 2 * x) := by
      rw [hτ₁_z₁]; dsimp [z₁]; ring
    have hdiff_a₁ : a₁ * τ₁ z₁ - τ₁ a₁ * z₁ = - ι (k₀ - (f - d ^ 2 * g) * s₀) * (1 + 2 * x) := by
      have hτ₁_a₁ : τ₁ a₁ = ι (f - d ^ 2 * g) - ι k₀ * (-1 - x) := by
        dsimp [a₁]; rw [map_sub, hτ₁_L, map_mul, hτ₁_L, hx_conj]
      rw [hτ₁_z₁, hτ₁_a₁]
      dsimp [a₁, z₁]
      simp only [map_sub, map_mul]
      ring
    have hW_tr_mul : ι (traceLM F hLM₁' W * V) = ι (- (((α⁻¹ : Lˣ) : L) * B_comm)) := by
      rw [map_mul, hτ₁_tr W, ← hz₁_mul]
      calc (W + τ₁ W) * (z₁ * τ₁ z₁)
        _ = (ι ((α⁻¹ : Lˣ) : L) * a₁ * ((τ₁ z₁ - z₁) * z₁⁻¹) +
              ι ((α⁻¹ : Lˣ) : L) * τ₁ a₁ * ((z₁ - τ₁ z₁) * (τ₁ z₁)⁻¹)) * (z₁ * τ₁ z₁) := by
            rw [hτ₁_W]; change (ι ((α⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1) + _) * _ = _; rw [hv₁_sub]
        _ = ι ((α⁻¹ : Lˣ) : L) * (τ₁ z₁ - z₁) *
              (a₁ * (z₁⁻¹ * z₁) * τ₁ z₁ - τ₁ a₁ * z₁ * ((τ₁ z₁)⁻¹ * τ₁ z₁)) := by ring
        _ = ι ((α⁻¹ : Lˣ) : L) * (τ₁ z₁ - z₁) * (a₁ * τ₁ z₁ - τ₁ a₁ * z₁) := by
            rw [inv_mul_cancel₀ hz₁_ne, inv_mul_cancel₀ hτ₁z₁_ne, mul_one, mul_one]
        _ = - (ι ((α⁻¹ : Lˣ) : L) * ι s₀ * ι (k₀ - (f - d ^ 2 * g) * s₀) *
              ((1 + 2 * x) * (1 + 2 * x))) := by
            rw [hdiff_z₁, hdiff_a₁]; ring
        _ = ι (- (((α⁻¹ : Lˣ) : L) * B_comm)) := by
            rw [h1p2x_sq]; simp only [B_comm, map_neg, map_mul]; ring
    have htr_W : traceLM F hLM₁' W = - (((α⁻¹ : Lˣ) : L) * B_comm) * V⁻¹ := by
      have h1 := ι.injective hW_tr_mul
      calc traceLM F hLM₁' W = (traceLM F hLM₁' W * V) * V⁻¹ := by rw [mul_inv_cancel_right₀ hV_ne]
        _ = - (((α⁻¹ : Lˣ) : L) * B_comm) * V⁻¹ := by rw [h1]
    change (θM₁' v₁ : Ω F) = ψ (traceLM F hLM₁' W)
    rw [hθ_val, htr_W]
    have hV_inv_val : valL F L V⁻¹ = 0 := by
      have := hval_inv (Units.mk0 V hV_ne)
      change valL F L V⁻¹ = - valL F L V at this
      rw [this, hV_val, neg_zero]
    have hVQ_inv : V⁻¹ * Q⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F L (V⁻¹ * Q⁻¹) :=
      hP_mono 0 (hP_mul (Or.inr (le_of_eq hV_inv_val.symm)) (Or.inr (le_of_eq hQ_inv_val.symm))) (by omega)
    have hrem_comm : (β₂ * u_Q) - (- B_comm * V⁻¹) = 0 ∨
        2 * (r : ℤ) ≤ valL F L ((β₂ * u_Q) - (- B_comm * V⁻¹)) := by
      have hid : (β₂ * u_Q) - (- B_comm * V⁻¹) =
          (B_comm * Q - β₂ * (Q - V) * V) * (V⁻¹ * Q⁻¹) := by
        dsimp [u_Q]
        calc β₂ * (-(Q - V) * Q⁻¹) - (- B_comm * V⁻¹)
          _ = β₂ * (-(Q - V) * (V * V⁻¹) * Q⁻¹) + B_comm * (Q * Q⁻¹) * V⁻¹ := by
              rw [mul_inv_cancel₀ hV_ne, mul_inv_cancel₀ hQ_ne]; ring
          _ = (B_comm * Q - β₂ * (Q - V) * V) * (V⁻¹ * Q⁻¹) := by ring
      rw [hid]
      exact hP_mono (2 * (r : ℤ)) (hP_mul hRem hVQ_inv) (by omega)
    have heq := hψ_eq_2r (β₂ * u_Q) (- B_comm * V⁻¹) hrem_comm
    rwa [← mul_assoc, show ((α⁻¹ : Lˣ) : L) * (- B_comm * V⁻¹) =
      - (((α⁻¹ : Lˣ) : L) * B_comm) * V⁻¹ by ring] at heq
  exact ⟨α, hβ₁, hβ₂, hα_val, hcν₂_val, hcν₂_stat_goal, hcν₁_val, hcν₁_stat, hNormPhaseM₁', hCommM₁'⟩

theorem ld_ch12_wild_dyadic_even_breaks_min_cond_frob_shift_and_quad_norm (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' θM₁' = 2 * condExp F L νE' - 1)
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hStatM₁' : ∃ c_θ₁ : M₁'ˣ,
      valL F M₁' (c_θ₁ : M₁') =
        (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ) ∧
      ∀ z : M₁',
        (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
            (traceChar F hLM₁' ψ) (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
