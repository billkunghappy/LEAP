        Units.map (normLM F hLE) c_E = (ϖ_L ^ m_E) * (u_TE ^ q) * (u_α ^ q)⁻¹ := by
      dsimp only [c_E, w_E, v₀]
      rw [map_mul, map_zpow, hϖ_normE, hnorm_inc_unit L E hLE (u_TE * u_α⁻¹), hFinE_eq,
