      apply hs_val w r (Finset.mem_Icc.mpr ⟨by omega, hr_le⟩) (d₁ : ℤ) (v2 : ℤ) hw
      have hmul : p * v2 ≤ 2 * d₁ + (p - 1) * T := Nat.mul_div_le (2 * d₁ + (p - 1) * T) p
      have hmul_int : (p : ℤ) * (v2 : ℤ) ≤ 2 * (d₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by
        exact_mod_cast hmul
      have hrd1 : 2 * (d₁ : ℤ) ≤ (r : ℤ) * (d₁ : ℤ) := by
        exact_mod_cast Nat.mul_le_mul_right d₁ hr2
      omega
    have hs2_v2 : s2 = 0 ∨ (v2 : ℤ) ≤ vB s2 :=
      hs_v2 2 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
    have hS3_v2 : S3 = 0 ∨ (v2 : ℤ) ≤ vB S3 := by
      apply hvalB_sum_ge (Finset.Icc 3 (p - 1)) (fun r => s w r) (v2 : ℤ)
      intro r hr
      have hr' := Finset.mem_Icc.mp hr
      have hr_mem2 : r ∈ Finset.Icc 2 (p - 1) :=
        Finset.mem_Icc.mpr ⟨by omega, hr'.2⟩
      exact hs_v2 r hr_mem2
    have hs2_S3_v2 : s2 + S3 = 0 ∨ (v2 : ℤ) ≤ vB (s2 + S3) :=
      hvalB_add (v2 : ℤ) s2 S3 hs2_v2 hS3_v2
    let m_rem : ℤ := (M : ℤ) - (v2 : ℤ)
    have hm_rem_v1 : m_rem ≤ (v1 : ℤ) := by omega
    have hm_rem_v2 : m_rem ≤ (v2 : ℤ) := by omega
    have hm_rem_d1 : m_rem ≤ (d₁ : ℤ) := by omega
    have h2Tw_rem : 2 * Tw = 0 ∨ m_rem ≤ vB (2 * Tw) := by
      have h2Tw := hvalB_mul_ge 0 (v1 : ℤ) (2 : B) Tw h2B_nonneg hTw_v1
      exact hvalB_mono (by omega) h2Tw
    have hs2_rem : s2 = 0 ∨ m_rem ≤ vB s2 :=
      hvalB_mono hm_rem_v2 hs2_v2
    have hS3_rem : S3 = 0 ∨ m_rem ≤ vB S3 :=
      hvalB_mono hm_rem_v2 hS3_v2
    have h2Nw_rem : 2 * Nw = 0 ∨ m_rem ≤ vB (2 * Nw) := by
      have hNw_d1 : Nw = 0 ∨ (d₁ : ℤ) ≤ vB Nw := hnorm_val_ge (d₁ : ℤ) w hw
      have h2Nw := hvalB_mul_ge 0 (d₁ : ℤ) (2 : B) Nw h2B_nonneg hNw_d1
      exact hvalB_mono (by omega) h2Nw
    have hfac_rem : (2 * Tw + s2 + S3 + 2 * Nw) = 0 ∨
        m_rem ≤ vB (2 * Tw + s2 + S3 + 2 * Nw) := by
      have ha := hvalB_add m_rem (2 * Tw) s2 h2Tw_rem hs2_rem
      have hb := hvalB_add m_rem (2 * Tw + s2) S3 ha hS3_rem
      exact hvalB_add m_rem (2 * Tw + s2 + S3) (2 * Nw) hb h2Nw_rem
    have hquad_piece :
        (- ((s2 + S3) * (2 * Tw + s2 + S3 + 2 * Nw))) = 0 ∨
        (M : ℤ) ≤ vB (- ((s2 + S3) * (2 * Tw + s2 + S3 + 2 * Nw))) := by
      have hprod := hvalB_mul_ge (v2 : ℤ) m_rem
        (s2 + S3) (2 * Tw + s2 + S3 + 2 * Nw) hs2_S3_v2 hfac_rem
      have hneg := hvalB_neg_ge ((v2 : ℤ) + m_rem) _ hprod
      exact hvalB_mono (by dsimp only [m_rem]; omega) hneg
    have h2S3_sub_N3_eq :
        2 * S3 - N3 =
          ∑ r ∈ Finset.Icc 3 (p - 1),
            (2 * s w r - 2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹ * trK (w ^ r)) := by
      dsimp only [S3, N3]
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    have hnewton_piece :
        2 * S3 - N3 = 0 ∨ (M : ℤ) ≤ vB (2 * S3 - N3) := by
      rw [h2S3_sub_N3_eq]
      apply hvalB_sum_ge (Finset.Icc 3 (p - 1))
        (fun r => 2 * s w r - 2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹ * trK (w ^ r))
        (M : ℤ)
      intro r hr
      have hr3 : 3 ≤ r := (Finset.mem_Icc.mp hr).1
      have hr_le : r ≤ p - 1 := (Finset.mem_Icc.mp hr).2
      have hr_mem : r ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hr_le⟩
      have hneg_sq : (-1 : B) ^ (r - 1) * (-1 : B) ^ (r - 1) = 1 := by
        rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
      have hr_inv_mul : ((r : ℕ) : B)⁻¹ * ((r : ℕ) : B) = 1 :=
        inv_mul_cancel₀ (hrB_ne0 r hr_mem)
      have hnewt := hs_newton1 w r hr_mem
      have hsub_tr :
          trK (w ^ r) =
            (-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s w r +
            ∑ j ∈ Finset.Icc 1 (r - 1),
              (-1 : B) ^ (j - 1) * s w j * trK (w ^ (r - j)) := by
        linear_combination -hnewt
      have hcancel :
          2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹ *
            ((-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s w r) = 2 * s w r := by
        calc 2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹ *
              ((-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s w r)
          _ = 2 * ((-1 : B) ^ (r - 1) * (-1 : B) ^ (r - 1)) *
              (((r : ℕ) : B)⁻¹ * ((r : ℕ) : B)) * s w r := by ring
          _ = 2 * 1 * 1 * s w r := by rw [hneg_sq, hr_inv_mul]
          _ = 2 * s w r := by ring
      have hr_eq :
          2 * s w r - 2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹ * trK (w ^ r) =
          (- (2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹)) *
            (∑ j ∈ Finset.Icc 1 (r - 1),
              (-1 : B) ^ (j - 1) * s w j * trK (w ^ (r - j))) := by
        rw [hsub_tr, mul_add, hcancel, sub_add_cancel_left, neg_mul]
      have hpref_nonneg :
          (- (2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹)) = 0 ∨
          (0 : ℤ) ≤ vB (- (2 * (-1 : B) ^ (r - 1) * ((r : ℕ) : B)⁻¹)) := by
        have hsign : (-1 : B) ^ (r - 1) = 0 ∨ (0 : ℤ) ≤ vB ((-1 : B) ^ (r - 1)) :=
          hvalB_pow_nonneg (-1 : B) (Or.inr (by rw [hvalB_neg1])) (r - 1)
        have hrinv0 : (((r : ℕ) : B)⁻¹) = 0 ∨ (0 : ℤ) ≤ vB (((r : ℕ) : B)⁻¹) :=
          Or.inr (by rw [hvalB_rinv r hr_mem])
        have ha := hvalB_mul_ge 0 0 (2 : B) ((-1 : B) ^ (r - 1)) h2B_nonneg hsign
        have hb := hvalB_mul_ge (0 + 0) 0 (2 * (-1 : B) ^ (r - 1)) (((r : ℕ) : B)⁻¹) ha hrinv0
        exact hvalB_mono (by omega) (hvalB_neg_ge ((0 + 0) + 0) _ hb)
      have hinner_sum :
          (∑ j ∈ Finset.Icc 1 (r - 1),
            (-1 : B) ^ (j - 1) * s w j * trK (w ^ (r - j))) = 0 ∨
          (M : ℤ) ≤ vB (∑ j ∈ Finset.Icc 1 (r - 1),
            (-1 : B) ^ (j - 1) * s w j * trK (w ^ (r - j))) := by
        apply hvalB_sum_ge (Finset.Icc 1 (r - 1))
          (fun j => (-1 : B) ^ (j - 1) * s w j * trK (w ^ (r - j))) (M : ℤ)
        intro j hj
        have hj1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
        have hj_le : j ≤ r - 1 := (Finset.mem_Icc.mp hj).2
        have hsign_j : (-1 : B) ^ (j - 1) = 0 ∨ (0 : ℤ) ≤ vB ((-1 : B) ^ (j - 1)) :=
          hvalB_pow_nonneg (-1 : B) (Or.inr (by rw [hvalB_neg1])) (j - 1)
        by_cases hj_eq1 : j = 1
        · subst hj_eq1
          have hsj : s w 1 = 0 ∨ (v1 : ℤ) ≤ vB (s w 1) := by
            rw [hs1 w]
            exact hTw_v1
          have htr_rj : trK (w ^ (r - 1)) = 0 ∨
              (v2 : ℤ) ≤ vB (trK (w ^ (r - 1))) :=
            htr_pow_v2 (r - 1) (by omega)
          have ha := hvalB_mul_ge 0 (v1 : ℤ) ((-1 : B) ^ (1 - 1)) (s w 1) hsign_j hsj
          have hb := hvalB_mul_ge (0 + (v1 : ℤ)) (v2 : ℤ)
            ((-1 : B) ^ (1 - 1) * s w 1) (trK (w ^ (r - 1))) ha htr_rj
          exact hvalB_mono (by omega) hb
        · have hj2 : 2 ≤ j := by omega
          have hsj : s w j = 0 ∨ (v2 : ℤ) ≤ vB (s w j) :=
            hs_v2 j (Finset.mem_Icc.mpr ⟨hj2, by omega⟩)
          have htr_rj : trK (w ^ (r - j)) = 0 ∨
              (v1 : ℤ) ≤ vB (trK (w ^ (r - j))) :=
            htr_pow_v1 (r - j) (by omega)
          have ha := hvalB_mul_ge 0 (v2 : ℤ) ((-1 : B) ^ (j - 1)) (s w j) hsign_j hsj
          have hb := hvalB_mul_ge (0 + (v2 : ℤ)) (v1 : ℤ)
            ((-1 : B) ^ (j - 1) * s w j) (trK (w ^ (r - j))) ha htr_rj
          exact hvalB_mono (by omega) hb
      rw [hr_eq]
      exact hvalB_mono (by omega) (hvalB_mul_ge 0 (M : ℤ) _ _ hpref_nonneg hinner_sum)
    rw [hConj3_id]
    exact hvalB_add (M : ℤ) _ _ hquad_piece hnewton_piece
  have hConj4 : ∀ (d : ℕ), d₁ ≤ d → ∀ z : K, (z = 0 ∨ (d : ℤ) ≤ vK z) →
      let v := (2 : K)⁻¹ * z ^ 2
      (v = 0 ∨ (2 * (d : ℤ)) ≤ vK v) ∧
      (v = 0 ∨ (d₁ : ℤ) ≤ vK v) ∧
      2 * trK v = trK (z ^ 2) ∧
      (2 * nmK v - nmK (z ^ 2) = 0 ∨
        (M : ℤ) ≤ vB (2 * nmK v - nmK (z ^ 2))) ∧
      (nmK (v ^ 2) = 0 ∨ (M : ℤ) ≤ vB (nmK (v ^ 2))) ∧
      (2 * trK v * nmK v = 0 ∨
        (M : ℤ) ≤ vB (2 * trK v * nmK v)) := by
    intro d hd z hz v
    have hz2 : z ^ 2 = 0 ∨ 2 * (d : ℤ) ≤ vK (z ^ 2) := by
      have h := hvalK_pow_ge (d : ℤ) z hz 2
      rwa [Nat.cast_ofNat] at h
    have h2inv_K_nonneg : ((2 : K)⁻¹) = 0 ∨ (0 : ℤ) ≤ vK ((2 : K)⁻¹) :=
      Or.inr (by rw [hvalK_2inv])
    have hv_2d : v = 0 ∨ (2 * (d : ℤ)) ≤ vK v := by
      dsimp only [v]
      exact hvalK_mono (by omega) (hvalK_mul_ge 0 (2 * (d : ℤ)) ((2 : K)⁻¹) (z ^ 2) h2inv_K_nonneg hz2)
    have hv_d1 : v = 0 ∨ (d₁ : ℤ) ≤ vK v :=
      hvalK_mono (by omega : (d₁ : ℤ) ≤ 2 * (d : ℤ)) hv_2d
    have h2v_eq : (2 : K) * v = z ^ 2 := by
      dsimp only [v]
      rw [← mul_assoc, mul_inv_cancel₀ h2K_ne0, one_mul]
    have htr_v : 2 * trK v = trK (z ^ 2) := by
      calc 2 * trK v
        _ = trK v + trK v := two_mul _
        _ = trK (v + v) := (trK.map_add v v).symm
        _ = trK ((2 : K) * v) := by rw [← two_mul]
        _ = trK (z ^ 2) := by rw [h2v_eq]
    have hnorm_v_2d : nmK v = 0 ∨ (2 * (d : ℤ)) ≤ vB (nmK v) :=
      hnorm_val_ge (2 * (d : ℤ)) v hv_2d
    have hnorm_z2_eq : nmK (z ^ 2) = (2 : B) ^ p * nmK v := by
      rw [← h2v_eq, map_mul, hnorm_2K]
    have h2_pow_p : (2 : B) ^ p = (2 : B) ^ (p - 1) * (2 : B) := by
      have hp_eq : p = (p - 1) + 1 := by omega
      conv_lhs => rw [hp_eq, pow_succ]
    have hnorm_diff_eq :
        2 * nmK v - nmK (z ^ 2) =
          - ((2 : B) * ((2 : B) ^ (p - 1) - 1) * nmK v) := by
      rw [hnorm_z2_eq, h2_pow_p]
      ring
    have hnorm_diff_M :
        2 * nmK v - nmK (z ^ 2) = 0 ∨
        (M : ℤ) ≤ vB (2 * nmK v - nmK (z ^ 2)) := by
      rw [hnorm_diff_eq]
      have ha := hvalB_mul_ge 0 ((M : ℤ) - 2 * (d₁ : ℤ))
        (2 : B) ((2 : B) ^ (p - 1) - 1) h2B_nonneg hval_fermat2
      have hb := hvalB_mul_ge (0 + ((M : ℤ) - 2 * (d₁ : ℤ))) (2 * (d : ℤ))
        ((2 : B) * ((2 : B) ^ (p - 1) - 1)) (nmK v) ha hnorm_v_2d
      have hneg := hvalB_neg_ge ((0 + ((M : ℤ) - 2 * (d₁ : ℤ))) + 2 * (d : ℤ)) _ hb
      exact hvalB_mono (by omega) hneg
    have hnorm_v2_M :
        nmK (v ^ 2) = 0 ∨ (M : ℤ) ≤ vB (nmK (v ^ 2)) := by
      rw [sq, map_mul]
      have hprod := hvalB_mul_ge (2 * (d : ℤ)) (2 * (d : ℤ))
        (nmK v) (nmK v) hnorm_v_2d hnorm_v_2d
      exact hvalB_mono (by omega) hprod
    have h2tr_v_v2 :
        2 * trK v = 0 ∨ (v2 : ℤ) ≤ vB (2 * trK v) := by
      rw [htr_v, ← hs1 (z ^ 2)]
      apply hs_val (z ^ 2) 1 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
        (2 * (d : ℤ)) (v2 : ℤ) hz2
      have hmul : p * v2 ≤ 2 * d₁ + (p - 1) * T := Nat.mul_div_le (2 * d₁ + (p - 1) * T) p
      have hmul_int : (p : ℤ) * (v2 : ℤ) ≤ 2 * (d₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by
        exact_mod_cast hmul
      have hd_int : (d₁ : ℤ) ≤ (d : ℤ) := by exact_mod_cast hd
      push_cast
      omega
    have hprod_tr_norm_M :
        2 * trK v * nmK v = 0 ∨
        (M : ℤ) ≤ vB (2 * trK v * nmK v) := by
      have hprod := hvalB_mul_ge (v2 : ℤ) (2 * (d : ℤ))
        (2 * trK v) (nmK v) h2tr_v_v2 hnorm_v_2d
      exact hvalB_mono (by omega) hprod
    exact ⟨hv_2d, hv_d1, htr_v, hnorm_diff_M, hnorm_v2_M, hprod_tr_norm_M⟩
  exact ⟨hConj1, hConj2, hConj3, hConj4⟩

theorem ld_ch12_wild_odd_tot_ram_monomial_unit_factorization (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
