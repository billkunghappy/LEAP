  have h2_val : valL F L (2 : L) = (e : ℤ) := by omega
  let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
  have hu₂_mul_inv : (2 : L) * ((u₂⁻¹ : Lˣ) : L) = 1 := u₂.mul_inv
  have hu₂_inv_ne : ((u₂⁻¹ : Lˣ) : L) ≠ 0 := (u₂⁻¹ : Lˣ).ne_zero
