            (traceChar F hLM₁' ψ) (2 * IntermediateField.inclusion hLM₁' (((c_νE'⁻¹ : Lˣ) : L)) *
              b * (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j)))
    (hψM₁'_triv : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
        (traceChar F hLM₁' ψ) z = 1)
    (hBinomTail :
      (∀ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁') ≠ 0) →
      ∀ y x : M₁',
        let P_M := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
        P_M (y + x - y * x) - P_M y - P_M x =
          - ∑ a ∈ Finset.Icc 1 (p - 1),
              ((a : ℕ) : M₁')⁻¹ * y ^ a *
                (∑ m ∈ Finset.range a, ((p - 1).choose m : M₁') * (1 - x) ^ m * x ^ (p - 1 - m)))
    (k : ℕ) (σ : M₁' ≃ₐ[F] M₁')
    (hσ_L : ∀ x : L, σ (IntermediateField.inclusion hLM₁' x) =
      IntermediateField.inclusion hLM₁' x)
    (hσ_symm_shift :
      let t₁ := condExp F L νM₁' - 1
      let ct := (t₁ + p - 1) / p
