    · linear_combination htr
    · linear_combination hnorm
  have hnorm_shift : ∀ c₀ : L,
      let p_X := 2 * c₀
      normLM F hLM₁' (h₁ - IntermediateField.inclusion hLM₁' p_X) =
        β₁ + 4 * c₀ + 4 * c₀ ^ 2 ∧
