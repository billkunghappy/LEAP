    have h_ediv : (p : ℤ) * m_val + A_num % (p : ℤ) = A_num := Int.mul_ediv_add_emod A_num (p : ℤ)
    have h_emod_nonneg : 0 ≤ A_num % (p : ℤ) := Int.emod_nonneg A_num (by omega)
    have h_emod_lt : A_num % (p : ℤ) < (p : ℤ) := Int.emod_lt_of_pos A_num (by omega)
    have h_emod_le : A_num % (p : ℤ) ≤ (p : ℤ) - 1 := by omega
