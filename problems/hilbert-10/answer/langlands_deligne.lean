      push_neg at h_all
      have hlam_all : ∀ c : C, lam c = 1 := by
        intro c
        rw [← hψ_on_C c, h_all c, Units.val_one]
      have hw₀_eq_triv : w₀ = w_triv := by
        apply Subtype.ext
        funext g
        obtain ⟨h, hh, c, hc, rfl⟩ := hG_mul g
        change w₀.1 (h * (⟨c, hc⟩ : C).1) = w_triv.1 (h * c)
        rw [hw₀_eval h hh ⟨c, hc⟩, hlam_all ⟨c, hc⟩, hw_triv (h * c)]
