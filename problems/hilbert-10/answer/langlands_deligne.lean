      have h2 := hmul_K₁ _ _ _ _ h1 hq_nat_or
      have h3 := hmul_K₁ _ _ _ _ h2 hW3_or
      have h4 := hmul_K₁ _ _ _ _ h3 hLp1_or
      have h5 := hmul_K₁ _ _ _ _ h4 hAp1_or
