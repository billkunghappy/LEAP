by
  have h_abs_group : ∀ (G₀ : Type u) [Group G₀] [Fintype G₀]
      (C H : Subgroup G₀) [hC_norm : C.Normal],
      (∀ a ∈ C, ∀ b ∈ C, a * b = b * a) →
      (∀ g : G₀, g ∈ H → g ∈ C → g = 1) →
      H ⊔ C = ⊤ →
      (∀ g : G₀, ∃ h ∈ H, ∃ c ∈ C, g = h * c) ∧
      Nat.card G₀ = Nat.card H * Nat.card C ∧
      (∃ Z_H : Subgroup G₀,
        Z_H.Normal ∧
        Z_H ≤ H ∧
        (∀ h : G₀, h ∈ Z_H ↔ h ∈ H ∧ ∀ c ∈ C, h * c = c * h)) ∧
      (∀ (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
