      · exact Or.inl h0
      · right; rw [hvalE'_1]; omega
    have h := hvalE'_strict 1 (x ^ p - IntermediateField.inclusion hLE' q₀) one_ne_zero hlt
    rwa [hvalE'_1] at h
  have hW_E'_ne0 : W_E' ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hW_L_ne0
  have hW_E'_val : valL F E' W_E' = -(((p * m : ℕ) : ℤ)) := by
    dsimp [W_E']
    rw [hval_LE', hW_L_val]
    push_cast; ring
  have hW_E'_p_ne0 : W_E' ^ p ≠ 0 := pow_ne_zero p hW_E'_ne0
  have hW_E'_p_val : valL F E' (W_E' ^ p) = -(((p * p * m : ℕ) : ℤ)) := by
    rw [hvalE'_pow W_E' p hW_E'_ne0, hW_E'_val]
    push_cast; ring
  have hap_ne0 : a ^ p ≠ 0 := pow_ne_zero p ha_ne0
  have hap_val : valL F E' (a ^ p) = -(((p * t₁ : ℕ) : ℤ)) := by
    rw [hvalE'_pow a p ha_ne0, ha_val]
    push_cast; ring
  obtain ⟨hWW_ne0, hWW_val⟩ :
      W_E' ^ p - W_E' ≠ 0 ∧ valL F E' (W_E' ^ p - W_E') = -(((p * p * m : ℕ) : ℤ)) := by
    rw [sub_eq_add_neg]
    have h := hvalE'_strict (W_E' ^ p) (-W_E') hW_E'_p_ne0
      (Or.inr (by rw [hW_E'_p_val, hvalE'_neg, hW_E'_val]; omega))
    rwa [hW_E'_p_val] at h
  have hD₀_ne0 : D₀_E' ≠ 0 := by
    dsimp [D₀_E']
    exact (hvalE'_strict (W_E' ^ p - W_E') (a ^ p) hWW_ne0
      (Or.inr (by rw [hWW_val, hap_val]; omega))).1

  
  have hw₂_ne0 : (w₂ : E') ≠ 0 := Units.ne_zero w₂
  have hnorm_w₂_L : normLM F hLE' (w₂ : E') = (γ : L) * ((α⁻¹ : Lˣ) : L) :=
    congrArg Units.val hw₂_norm
  have hu_norm_w₂_L : u * normLM F hLE' (w₂ : E') = 1 := by
    have hα_inv : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    have hγ_inv : (γ : L) * ((γ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv γ
    dsimp [u]
    rw [hnorm_w₂_L]
    linear_combination ((γ : L) * ((γ⁻¹ : Lˣ) : L)) * hα_inv + hγ_inv
  have hu_norm_w₂ :
      IntermediateField.inclusion hLE' u *
        IntermediateField.inclusion hLE' (normLM F hLE' (w₂ : E')) = 1 := by
    rw [← map_mul, hu_norm_w₂_L, map_one]
  have huw₂_cayley :
      IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1 =
        ∑ i ∈ Finset.Icc 1 (p - 1),
          IntermediateField.inclusion hLE' u *
            ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
              (w₂ : E') ^ (p - i)) := by
    have hcay := hs_LE'_cayley (w₂ : E')
    change (w₂ : E') ^ p =
      IntermediateField.inclusion hLE' (normLM F hLE' (w₂ : E')) +
        ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
            (w₂ : E') ^ (p - i) at hcay
    rw [hcay, mul_add, hu_norm_w₂, Finset.mul_sum]
    ring
  have huw₂_pow_sub :
      IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1 = 0 ∨
        (((p - 1) * t₂ : ℕ) : ℤ) ≤
          valL F E' (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) := by
    rw [huw₂_cayley]
    apply hvalE'_sum_ge (Finset.Icc 1 (p - 1))
      (fun i =>
        IntermediateField.inclusion hLE' u *
          ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
            (w₂ : E') ^ (p - i)))
      ((((p - 1) * t₂ : ℕ) : ℤ))
    intro i hi
    obtain ⟨hi1, hip1⟩ := Finset.mem_Icc.mp hi
    let X_i : ℤ := ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) - (i : ℤ) * (m : ℤ)
    let m_i : ℤ := X_i / (p : ℤ)
    let r_i : ℤ := X_i % (p : ℤ)
    have hdiv_eq : (p : ℤ) * m_i + r_i = X_i := Int.mul_ediv_add_emod X_i (p : ℤ)
    have hr_nonneg : 0 ≤ r_i := Int.emod_nonneg X_i hp_ne0_int
    have hr_lt : r_i < (p : ℤ) := Int.emod_lt_of_pos X_i hp_pos_int
    have hs_cond :
        (p : ℤ) * m_i - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ (i : ℤ) * (-(m : ℤ)) := by
      dsimp [X_i] at hdiv_eq
      linarith
    have hs_val_L : s_LE' (w₂ : E') i = 0 ∨ m_i ≤ valL F L (s_LE' (w₂ : E') i) :=
      hs_LE'_val (w₂ : E') i hi (-(m : ℤ)) m_i (Or.inr (le_of_eq hw₂_val.symm)) hs_cond
    have hs_val_E' :
        IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) = 0 ∨
          (p : ℤ) * m_i ≤ valL F E' (IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i)) := by
      rcases hs_val_L with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LE' (s_LE' (w₂ : E') i)]
        exact mul_le_mul_of_nonneg_left hge (by positivity)
    have hneg_i : (-1 : E') ^ (i - 1) = 0 ∨ 0 ≤ valL F E' ((-1 : E') ^ (i - 1)) :=
      Or.inr (by rw [(hneg1_pow_E' (i - 1)).2])
    have hw₂_pi :
        (w₂ : E') ^ (p - i) = 0 ∨
          ((p - i : ℕ) : ℤ) * (-(m : ℤ)) ≤ valL F E' ((w₂ : E') ^ (p - i)) := by
      right
      rw [hvalE'_pow (w₂ : E') (p - i) hw₂_ne0, hw₂_val]
    have hu_b :
        IntermediateField.inclusion hLE' u = 0 ∨
          (p : ℤ) * (m : ℤ) ≤ valL F E' (IntermediateField.inclusion hLE' u) :=
      Or.inr (by rw [hu_E'_val])
    have h1 := hvalE'_mul_ge 0 ((p : ℤ) * m_i)
      ((-1 : E') ^ (i - 1)) (IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i))
      hneg_i hs_val_E'
    have h2 := hvalE'_mul_ge (0 + (p : ℤ) * m_i) (((p - i : ℕ) : ℤ) * (-(m : ℤ)))
      ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i))
      ((w₂ : E') ^ (p - i)) h1 hw₂_pi
    have h3 := hvalE'_mul_ge ((p : ℤ) * (m : ℤ))
      ((0 + (p : ℤ) * m_i) + ((p - i : ℕ) : ℤ) * (-(m : ℤ)))
      (IntermediateField.inclusion hLE' u)
      ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
        (w₂ : E') ^ (p - i))
      hu_b h2
    rcases h3 with h0 | hge
    · exact Or.inl h0
    · right
      have hpi_cast : ((p - i : ℕ) : ℤ) = (p : ℤ) - (i : ℤ) := Nat.cast_sub (by omega)
      dsimp [X_i] at hdiv_eq
      rw [hpi_cast] at hge
      rw [hp1_cast] at hdiv_eq
      push_cast
      rw [hp1_cast, hbE'1_cast]
      linarith
  have huw₂_pow :
      1 - IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) = 0 ∨
        (((p - 1) * t₂ : ℕ) : ℤ) ≤
          valL F E' (1 - IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p)) := by
    have hneg_eq :
