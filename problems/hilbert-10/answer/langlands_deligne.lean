        simp [D, hnot_lt, hne]
      rw [hDij]
      have hC_ij := hvalE'_sign_mul i _ (C i j) (hC_val i hi j)
      have hterm := hval_term_K₁ (p - i + (j : ℕ)) _ ((-1 : E') ^ i * C i j) hC_ij
      rcases hterm with hterm | hterm
      · exact Or.inl hterm
      · right
        have hi_le : i ≤ p - 1 := (Finset.mem_Icc.mp hi).2
        have hexp_z : ((p - i + (j : ℕ) : ℕ) : ℤ) = (p : ℤ) - (i : ℤ) + (j : ℤ) := by omega
        rw [hexp_z] at hterm
        have h_alg :
            (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) + (j : ℤ) * (t₁ : ℤ)) -
              ((p : ℤ) - (i : ℤ) + (j : ℤ)) * (t₁ : ℤ) =
            M_rem + (((p : ℤ) - 1) * ((j : ℤ) - (i : ℤ) - 1)) * (t₁ : ℤ) := by
          dsimp [M_rem]
          ring
        rw [h_alg] at hterm
        have h_nonneg : 0 ≤ (((p : ℤ) - 1) * ((j : ℤ) - (i : ℤ) - 1)) * (t₁ : ℤ) := by
          apply mul_nonneg
          · apply mul_nonneg (by omega)
            have : (i : ℤ) + 1 ≤ (j : ℤ) := by exact_mod_cast hji
            omega
          · omega
        linarith
  have hR'_basis := ((hΔ_basis R_rem).choose_spec.2 M_rem).mp hR_rem_val
  have hR'_0_val :
      R' j₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) ≤ valL F E' (R' j₀) := by
    rcases hR'_basis j₀ with h0 | hle
    · exact Or.inl h0
    · right
      change M_rem ≤ (p : ℤ) * valL F E' (R' j₀) - (j₀ : ℤ) * (t₁ : ℤ) at hle
      have hj₀_z : (j₀ : ℤ) = 0 := rfl
      have hp_z : 3 ≤ (p : ℤ) := by omega
      have ht₁_z : 1 ≤ (t₁ : ℤ) := by omega
      change (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) ≤ _ at hle
      nlinarith
  have hR'_pos_val : ∀ l : Fin p, 1 ≤ (l : ℕ) →
      R' l = 0 ∨ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (R' l) := by
    intro l hl_pos
    rcases hR'_basis l with h0 | hle
    · exact Or.inl h0
    · right
      change M_rem ≤ (p : ℤ) * valL F E' (R' l) - (l : ℤ) * (t₁ : ℤ) at hle
      have hl_z : 1 ≤ (l : ℤ) := by exact_mod_cast hl_pos
      have hp_z : 3 ≤ (p : ℤ) := by omega
      have ht₁_z : 1 ≤ (t₁ : ℤ) := by omega
      change (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) ≤ _ at hle
      nlinarith
  have hZ0 :
      Z j₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) ≤ valL F E' (Z j₀) := by
    have hj₀_ne1 : (j₀ : ℕ) ≠ 1 := Nat.zero_ne_one
    have hZ0_eq : Z j₀ =
        W_as j₀ + (∑ i ∈ Finset.Icc 1 (p - 1), ∑ j : Fin p, B i j j₀) + R' j₀ := by
      simp [Z, hj₀_ne1]
    rw [hZ0_eq]
    apply hvalE'_add (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ))
    · apply hvalE'_add (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ))
      · rcases hW_as_val j₀ with h0 | hle
        · exact Or.inl h0
        · right
          change ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (W_as j₀) at hle
          have ht₁_z : 1 ≤ (t₁ : ℤ) := by omega
          linarith
      · apply hvalE'_sum (Finset.Icc 1 (p - 1))
        intro i hi
        apply hvalE'_sum Finset.univ
        intro j _
        have hi_le : i ≤ p - 1 := (Finset.mem_Icc.mp hi).2
        have h_ne0 : (j₀ : ℕ) ≠ p - i + (j : ℕ) := by
          change 0 ≠ p - i + (j : ℕ)
          omega
        by_cases hji : (j : ℕ) < i
        · simp [B, hji, h_ne0]
        · by_cases hjeq : (j : ℕ) = i
          · have hB_eq : B i j j₀ = (-1 : E') ^ i * C i j * a := by
              simp [B, hji, hjeq, j₀]
            rw [hB_eq]
            have hC_ij : (-1 : E') ^ i * C i j = 0 ∨
                ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' ((-1 : E') ^ i * C i j) := by
              have h1 := hvalE'_sign_mul i _ (C i j) (hC_val i hi j)
              rcases h1 with h1 | h1
              · exact Or.inl h1
              · right
                rw [hjeq] at h1
                linarith
            exact ha_val_mul (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) ((-1 : E') ^ i * C i j) hC_ij
          · simp [B, hji, hjeq]
    · exact hR'_0_val
  have hZ1 :
      Z j₁ - (1 - s₀) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (Z j₁ - (1 - s₀)) := by
    have hB_sum_j₁ :
        (∑ i ∈ Finset.Icc 1 (p - 1), ∑ j : Fin p, B i j j₁) = - s₀ := by
      rw [Finset.sum_eq_single (p - 1)]
      · rw [Fintype.sum_eq_single j₀]
        · have hj₀_lt : (j₀ : ℕ) < p - 1 := by
            change 0 < p - 1
            omega
          have hl₁_eq : (j₁ : ℕ) = p - (p - 1) + (j₀ : ℕ) := by
            change 1 = p - (p - 1) + 0
            omega
          simp [B, hj₀_lt, hl₁_eq, hneg1_p1, s₀]
        · intro j hj
          have hj_ne0 : (j : ℕ) ≠ 0 := fun h => hj (Fin.ext h)
          have hl₁_ne : (j₁ : ℕ) ≠ p - (p - 1) + (j : ℕ) := by
            change 1 ≠ p - (p - 1) + (j : ℕ)
            omega
          have hj₁_ne0 : (j₁ : ℕ) ≠ 0 := Nat.one_ne_zero
          by_cases hji : (j : ℕ) < p - 1
          · simp [B, hji, hl₁_ne]
          · simp [B, hji, hj₁_ne0]
      · intro i hi hi_ne
        apply Finset.sum_eq_zero
        intro j _
        have hi_le : i ≤ p - 1 := (Finset.mem_Icc.mp hi).2
        have hl₁_ne : (j₁ : ℕ) ≠ p - i + (j : ℕ) := by
          change 1 ≠ p - i + (j : ℕ)
          omega
        have hj₁_ne0 : (j₁ : ℕ) ≠ 0 := Nat.one_ne_zero
        by_cases hji : (j : ℕ) < i
        · simp [B, hji, hl₁_ne]
        · simp [B, hji, hj₁_ne0]
      · intro hp1_not_mem
        exact False.elim (hp1_not_mem hp1_mem)
    have hZ1_sub : Z j₁ - (1 - s₀) = W_as j₁ + R' j₁ := by
      have hj₁_eq1 : (j₁ : ℕ) = 1 := rfl
      simp only [Z, hj₁_eq1, ↓reduceIte, hB_sum_j₁]
      ring
    rw [hZ1_sub]
    exact hvalE'_add (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) (W_as j₁) (R' j₁)
      (hW_as_val j₁) (hR'_pos_val j₁ le_rfl)
  have hZl : ∀ l : Fin p, 2 ≤ (l : ℕ) →
      Z l = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (l : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) ≤
          valL F E' (Z l) := by
    intro l hl_ge2
    have hl_ne1 : (l : ℕ) ≠ 1 := by omega
    have hl_ne0 : (l : ℕ) ≠ 0 := by omega
    have hZl_eq : Z l =
        W_as l + (∑ i ∈ Finset.Icc 1 (p - 1), ∑ j : Fin p, B i j l) + R' l := by
      simp [Z, hl_ne1]
    rw [hZl_eq]
    have h_nonneg_sub : 0 ≤ ((p - (l : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) := by positivity
    apply hvalE'_add (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (l : ℕ) : ℕ) : ℤ) * (t₁ : ℤ))
    · apply hvalE'_add (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (l : ℕ) : ℕ) : ℤ) * (t₁ : ℤ))
      · rcases hW_as_val l with h0 | hle
        · exact Or.inl h0
        · right
          change ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (W_as l) at hle
          linarith
      · apply hvalE'_sum (Finset.Icc 1 (p - 1))
        intro i hi
        apply hvalE'_sum Finset.univ
        intro j _
