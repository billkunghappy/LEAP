      rw [map_natCast, map_neg, map_one] at hw
      exact hw
    have h_vp_p : padicValNat p p = 1 := by
      have h1 := padicValNat.prime_pow (p := p) 1
      rwa [pow_one] at h1
    have h_ordC_p : ordC p = 1 := by
      dsimp only [ordC]
      rw [h_vp_p, pow_one, Nat.div_self hp.pos]
    have h_quot_ind : ∀ q₀ : ℕ, ordF (p * q₀) = (-1 : k_M) ^ q₀ * ordF q₀ := by
      intro q₀
      induction q₀ with
      | zero => simp [ordF, ordC]
