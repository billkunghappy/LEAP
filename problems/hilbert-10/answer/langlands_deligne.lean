      rw [hCH w₀]
      ring
    rw [hsub, Finset.sum_mul]
  have h2x_val : 2 * x = 0 ∨ (d₂ : ℤ) ≤ valL F E' (2 * x) := by
    rw [two_mul]
    exact hval_add_E' (d₂ : ℤ) x x hx hx
  have hR₁_val : R₁ = 0 ∨ (bE' : ℤ) ≤ valL F E' R₁ := by
    rw [hR₁_eq]
    apply hval_sum_E' (Finset.Icc 1 (p - 1)) termE' (bE' : ℤ)
    intro r hr
    have hr_bounds := Finset.mem_Icc.mp hr
    let A_r : ℤ := ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) - (r : ℤ) * (h₀ : ℤ)
    let m_r : ℤ := A_r / (p : ℤ)
    have hp_pos_Z : (0 : ℤ) < (p : ℤ) := by omega
    have h_ediv := Int.mul_ediv_add_emod A_r (p : ℤ)
    have h_emod_nonneg := Int.emod_nonneg A_r (ne_of_gt hp_pos_Z)
    have h_emod_lt := Int.emod_lt_of_pos A_r hp_pos_Z
    have h_pmr_le : (p : ℤ) * m_r - ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) + 1 : ℤ) ≤
        (r : ℤ) * (-(h₀ : ℤ)) := by
      rw [hbE'_sub1_cast]
      dsimp [m_r, A_r] at h_ediv ⊢
      linarith
    have hs_r : s w₀ r = 0 ∨ m_r ≤ valL F L (s w₀ r) :=
      hs_val w₀ r hr (-(h₀ : ℤ)) m_r hw₀ h_pmr_le
    have hincl_sr : IntermediateField.inclusion hLE' (s w₀ r) = 0 ∨
        (p : ℤ) * m_r ≤ valL F E' (IntermediateField.inclusion hLE' (s w₀ r)) := by
      rcases hs_r with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LE' (s w₀ r)]
        exact mul_le_mul_of_nonneg_left hge (by positivity)
    have h_neg1_pow : (-1 : E') ^ (r - 1) = 0 ∨ (0 : ℤ) ≤ valL F E' ((-1 : E') ^ (r - 1)) := by
      rcases neg_one_pow_eq_or E' (r - 1) with h1 | hm1
      · right; rw [h1, hval1_E']
      · right; rw [hm1, hval_neg1_E']
    have hw₀_pr : w₀ ^ (p - r) = 0 ∨
        ((p - r : ℕ) : ℤ) * (-(h₀ : ℤ)) ≤ valL F E' (w₀ ^ (p - r)) :=
      hval_pow_E' (p - r) (-(h₀ : ℤ)) w₀ hw₀
    have h_m1 := hval_mul_bound_E' 0 ((p : ℤ) * m_r) _ _ h_neg1_pow hincl_sr
    have h_m2 := hval_mul_bound_E' (0 + (p : ℤ) * m_r) (((p - r : ℕ) : ℤ) * (-(h₀ : ℤ)))
      _ _ h_m1 hw₀_pr
    have h_m3 := hval_mul_bound_E'
      (0 + (p : ℤ) * m_r + ((p - r : ℕ) : ℤ) * (-(h₀ : ℤ))) (d₂ : ℤ)
      _ _ h_m2 h2x_val
    rcases h_m3 with h0 | hge
    · left; exact h0
    · right
      have hpr_cast : ((p - r : ℕ) : ℤ) = (p : ℤ) - (r : ℤ) := by omega
      have h_p3_bE' : ((p : ℤ) - 3) * 2 ≤ ((p : ℤ) - 3) * (bE' : ℤ) :=
        mul_le_mul_of_nonneg_left (by omega) (by omega)
      have h_pmr_ge : A_r - ((p : ℤ) - 1) ≤ (p : ℤ) * m_r := by
        have h_ediv' : (p : ℤ) * m_r + A_r % (p : ℤ) = A_r := h_ediv
        linarith
      have h_Ar_alg : A_r + ((p : ℤ) - (r : ℤ)) * (-(h₀ : ℤ)) =
          (bE' : ℤ) + (bE' : ℤ) + ((p : ℤ) - 3) * (bE' : ℤ) - (p : ℤ) * (h₀ : ℤ) := by
        dsimp [A_r]
        rw [hp_sub1_cast]
        ring
      have h_ineq : (bE' : ℤ) ≤
          0 + (p : ℤ) * m_r + ((p - r : ℕ) : ℤ) * (-(h₀ : ℤ)) + (d₂ : ℤ) := by
        rw [hpr_cast]
        linarith
      exact h_ineq.trans hge
  have hR_val : R₁ + R₂ = 0 ∨ (bE' : ℤ) ≤ valL F E' (R₁ + R₂) :=
    hval_add_E' (bE' : ℤ) R₁ R₂ hR₁_val hR₂_val
  have htr_R_val : traceLM F hLE' (R₁ + R₂) = 0 ∨
      (bE' : ℤ) ≤ valL F L (traceLM F hLE' (R₁ + R₂)) := by
    apply htr_LE' (bE' : ℤ) (R₁ + R₂)
    rcases hR_val with h0 | hge
    · left; exact h0
    · right
      have h_id : (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) = (bE' : ℤ) := by
        rw [hp_sub1_cast]; ring
      rw [h_id]
      exact hge
  
  have hw₀x_val : w₀ * x = 0 ∨ (((bE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' (w₀ * x) := by
    rcases hval_mul_bound_E' (-(h₀ : ℤ)) (d₂ : ℤ) w₀ x hw₀ hx with h0 | hge
    · left; exact h0
    · right; linarith
  let Q_v : L := 2 * (traceLM F hLE' (w₀ * x) + normLM F hLE' w₀ * normLM F hLE' x)
  have hψ_Qv : ψ (α₀ * Q_v) = 1 := by
    have h1 := hψ_Q (w₀ * x) hw₀x_val
    rw [map_mul (normLM F hLE') w₀ x] at h1
    exact h1
  have htr_smul : ∀ (a : L) (y : E'),
      traceLM F hLE' (IntermediateField.inclusion hLE' a * y) = a * traceLM F hLE' y := by
    intro a y
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLE')).map_smul' a
      (toExtendScalars F hLE' y)
  let LHS_L : L := traceLM F hLE' ((w₀ ^ p - w₀) * (2 * x - x ^ 2))
  have hLHS_char : ψE' (IntermediateField.inclusion hLE' α₀ * (w₀ ^ p - w₀) * (2 * x - x ^ 2)) =
      ψ (α₀ * LHS_L) := by
    change ψ (traceLM F hLE' (IntermediateField.inclusion hLE' α₀ * (w₀ ^ p - w₀) * (2 * x - x ^ 2))) = _
    rw [mul_assoc, htr_smul α₀ ((w₀ ^ p - w₀) * (2 * x - x ^ 2))]
  have h_decomp_E' : (w₀ ^ p - w₀) * (2 * x - x ^ 2) =
      IntermediateField.inclusion hLE' (normLM F hLE' w₀) * (x + x) - (w₀ * x + w₀ * x) +
        (R₁ + R₂) := by
    dsimp [R₁, R₂]; ring
  have hLHS_L_eq : LHS_L =
      normLM F hLE' w₀ * (traceLM F hLE' x + traceLM F hLE' x) -
        (traceLM F hLE' (w₀ * x) + traceLM F hLE' (w₀ * x)) +
        traceLM F hLE' (R₁ + R₂) := by
    dsimp [LHS_L]
    rw [h_decomp_E', map_add, map_sub, htr_smul (normLM F hLE' w₀) (x + x), map_add, map_add]
  let RHS_L : L := normLM F hLE' w₀ * (2 * u_x - u_x ^ 2)
  have h_diff_eq : (LHS_L + Q_v) - RHS_L =
      traceLM F hLE' (R₁ + R₂) - normLM F hLE' w₀ * Δ_u := by
    dsimp [Q_v, RHS_L, Δ_u]
    rw [hLHS_L_eq]
    ring
  have h_diff_val : (LHS_L + Q_v) - RHS_L = 0 ∨
      (bE' : ℤ) ≤ valL F L ((LHS_L + Q_v) - RHS_L) := by
    rw [h_diff_eq]
    exact hval_sub_L (bE' : ℤ) _ _ htr_R_val hRHS_rem
  have hψ_diff : ψ (α₀ * ((LHS_L + Q_v) - RHS_L)) = 1 :=
    hψ_triv ((LHS_L + Q_v) - RHS_L) h_diff_val
  refine ⟨hu_x_d₂, ?_⟩
  rw [hLHS_char]
  have h1 : ψ (α₀ * LHS_L) = ψ (α₀ * (LHS_L + Q_v)) := by
    have hsplit : α₀ * (LHS_L + Q_v) = α₀ * LHS_L + α₀ * Q_v := by ring
    rw [hsplit, AddChar.map_add_eq_mul, hψ_Qv, mul_one]
  have h2 : ψ (α₀ * (LHS_L + Q_v)) = ψ (α₀ * RHS_L) := by
    have hsplit : α₀ * (LHS_L + Q_v) = α₀ * ((LHS_L + Q_v) - RHS_L) + α₀ * RHS_L := by ring
    rw [hsplit, AddChar.map_add_eq_mul, hψ_diff, one_mul]
  have h3 : α₀ * RHS_L = α₀ * normLM F hLE' w₀ * (2 * u_x - u_x ^ 2) := by
    dsimp [RHS_L]; ring
  rw [h1, h2, h3]

theorem ld_ch12_wild_odd_totally_ramified_residue_as_hyperplane_peeling (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E') (hGalLE' : IsGaloisExt F L E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (bM₁' : ℕ) (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ condExp F L νE')
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hBoxed :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let t₁ := bM₁' - 1
      let h₀ := t₁ / p
      let m₂ := bE' + bM₁' - 1
      let d₂ := m₂ / 2
      let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      ∀ w₀ : E', (w₀ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₀) →
        ∀ x : E', (x = 0 ∨ (d₂ : ℤ) ≤ valL F E' x) →
          let u_x := normLM F hLE' (1 + x) - 1
          (u_x = 0 ∨ (d₂ : ℤ) ≤ valL F L u_x) ∧
          ψE' (IntermediateField.inclusion hLE' α₀ * (w₀ ^ p - w₀) * (2 * x - x ^ 2)) =
            ψ (α₀ * normLM F hLE' w₀ * (2 * u_x - u_x ^ 2))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    ∀ (j : ℕ), 0 < j → j < p →
      ∀ (σ : E' ≃ₐ[F] E'),
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∃ y : E', σ y ≠ y) →
        ∀ (ϖ_E' : E'ˣ), valL F E' (ϖ_E' : E') = 1 →
          let x_star := (σ (ϖ_E' : E')) * ((ϖ_E'⁻¹ : E'ˣ) : E') - 1
          ∀ Y₁ : E', (Y₁ = 0 ∨ 0 ≤ valL F E' Y₁) →
            ψE' (IntermediateField.inclusion hLE' α₀ * Y₁ * (2 * x_star - x_star ^ 2)) = 1 →
            ∃ w_zero : E',
              (w_zero = 0 ∨ 0 ≤ valL F E' w_zero) ∧
              (Y₁ + (j : E') * (w_zero ^ p - w_zero) = 0 ∨
                1 ≤ valL F E' (Y₁ + (j : E') * (w_zero ^ p - w_zero))) :=
by
  intro p α₀ ψE' j hj_pos hj_lt σ hσ_L hσ_ne ϖ_E' hϖ_E' x_star Y₁ hY₁ hY₁_char
  set bE' : ℕ := condExp F L νE'
  set t₁ : ℕ := bM₁' - 1
  set h₀ : ℕ := t₁ / p
  set m₂ : ℕ := bE' + bM₁' - 1
  set d₂ : ℕ := m₂ / 2
  let E'' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE'
  haveI : FiniteDimensional F E'' := ‹FiniteDimensional F E'›
  haveI : IsScalarTower F L E'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L E'' := Module.Finite.of_restrictScalars_finite F L E''
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd' : p ≠ 2 := by
    change Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2
    rw [hWild]
    exact hp_odd
  have hp_ge3 : 3 ≤ p := by omega
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega

  
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    _, hval_add_L, _, _, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
    _, hval_add_E', _, _, _⟩ := ld_valL_and_unitGroup_props F E'
  obtain ⟨hadd1, hadd_neg, hadd_mul, hadd_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ :=
    ld_valL_mod_one_finset F L hval0_L hval_neg_L hval_mul_L hval_add_L
      hadd1 hadd_neg hadd_mul hadd_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hval0_L hval1_L hval_neg1_L hval_neg_L
      hval_mul_L hval_inv_L hval_add_L S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL

  have hνE'_triv : ∀ u ∈ unitGroup F L (condExp F L νE'), νE' u = 1 := by
    intro u hu
    have hpow1 : νE' ^ 1 = νE' := MonoidHom.ext fun x => pow_one (νE' x)
    have h1 := hνE'_cond 1 hp_gt1
    rw [hpow1] at h1
    exact h1 u hu
  have hνE'_norm : ∀ w : E'ˣ, νE' (Units.map (normLM F hLE') w) = 1 :=
    fun w => (hνE'_ker (Units.map (normLM F hLE') w)).mp ⟨w, rfl⟩
  have hBasis :=
    (ld_wild_one_way_norm_ker_total_ramification_and_power_basis F L E' hLE' hGalLE'
      hPrime νE' hbE'_ge2 hνE'_triv hνE'_norm).2.2.1 ϖ_E' hϖ_E'
  obtain ⟨G, instGroupG, instFintypeG, act, t, _,
    hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, hact_faithful, hact_val, hact_trace, hact_norm,
    ht_ge1, _, _, _, hjump⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L E' hLE' hGalLE' hPrime hWild
      hadd1 halg1 hvalL_props hvalE'_props hval_norm_LE' hval_LE' ϖ_E' hϖ_E' hBasis
  letI : Group G := instGroupG
  letI : Fintype G := instFintypeG
  obtain ⟨htr_bound_t, htr_surj_t⟩ :=
    ld_wild_euler_lagrange_trace_formula F L E' hLE' hPrime
      hvalL_props hvalE'_props hval_LE' ϖ_E' hϖ_E' hBasis
      G act hcard_G hact_one hact_mul hact_ring hact_incl hact_trace t hjump
  have hnorm_exp :=
    ld_wild_free_orbit_norm_expansion F L E' hLE' hPrime hvalE'_props
      G act hcard_G hact_one hact_mul hact_ring hact_val hact_trace hact_norm

  have hval_neg_ge_L : ∀ {k : ℤ} {x : L},
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hge
    · left; simp
    · right; rwa [hval_neg_L]
  have hval_neg_ge_E' : ∀ {k : ℤ} {y : E'},
      (y = 0 ∨ k ≤ valL F E' y) → (-y = 0 ∨ k ≤ valL F E' (-y)) := by
    intro k y hy
    rcases hy with rfl | hge
    · left; simp
    · right; rwa [hval_neg_E']
  have hval_sub_L : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    exact hval_add_L k x₁ (-x₂) hx₁ (hval_neg_ge_L hx₂)
  have hval_sub_E' : ∀ (k : ℤ) (y₁ y₂ : E'),
      (y₁ = 0 ∨ k ≤ valL F E' y₁) → (y₂ = 0 ∨ k ≤ valL F E' y₂) →
        (y₁ - y₂ = 0 ∨ k ≤ valL F E' (y₁ - y₂)) := by
    intro k y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg]
    exact hval_add_E' k y₁ (-y₂) hy₁ (hval_neg_ge_E' hy₂)
  have hval_mul_ge_L : ∀ {k₁ k₂ : ℤ} {x₁ x₂ : L},
      (x₁ = 0 ∨ k₁ ≤ valL F L x₁) → (x₂ = 0 ∨ k₂ ≤ valL F L x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F L (x₁ * x₂)) := by
    intro k₁ k₂ x₁ x₂ hx₁ hx₂
    by_cases h1 : x₁ = 0
    · exact Or.inl (by rw [h1, zero_mul])
    · by_cases h2 : x₂ = 0
      · exact Or.inl (by rw [h2, mul_zero])
      · right
        rw [hval_mul_L x₁ x₂ h1 h2]
        have hg1 := hx₁.resolve_left h1
        have hg2 := hx₂.resolve_left h2
        omega
  have hval_mul_ge_E' : ∀ {k₁ k₂ : ℤ} {y₁ y₂ : E'},
      (y₁ = 0 ∨ k₁ ≤ valL F E' y₁) → (y₂ = 0 ∨ k₂ ≤ valL F E' y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F E' (y₁ * y₂)) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · exact Or.inl (by rw [h1, zero_mul])
    · by_cases h2 : y₂ = 0
      · exact Or.inl (by rw [h2, mul_zero])
      · right
        rw [hval_mul_E' y₁ y₂ h1 h2]
        have hg1 := hy₁.resolve_left h1
        have hg2 := hy₂.resolve_left h2
        omega
  have h1_int_L : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) :=
    Or.inr (le_of_eq hval1_L.symm)
  have hnat_val_L : ∀ n : ℕ, (n : L) = 0 ∨ 0 ≤ valL F L (n : L) := by
    intro n
    induction n with
    | zero => left; simp
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_L 0 (n : L) 1 ih h1_int_L
  have hint_val_L : ∀ z : ℤ, (z : L) = 0 ∨ 0 ≤ valL F L (z : L) := by
    intro z
    cases z with
    | ofNat n =>
      rw [Int.ofNat_eq_coe, Int.cast_natCast]
      exact hnat_val_L n
    | negSucc n =>
      rw [Int.cast_negSucc]
      exact hval_neg_ge_L (hnat_val_L (n + 1))
  have hpow_val_L : ∀ (s : L), (s = 0 ∨ 0 ≤ valL F L s) →
      ∀ n : ℕ, (s ^ n = 0 ∨ 0 ≤ valL F L (s ^ n)) := by
    intro s hs n
    induction n with
    | zero => rw [pow_zero]; exact h1_int_L
    | succ n ih =>
      rw [pow_succ]
      rcases hval_mul_ge_L ih hs with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
  have hresL_sub : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ (hval_neg_ge_L hx₂)).1,
      (hresL_ring x₂ x₂ hx₂ hx₂).2.2, ← sub_eq_add_neg]
  have hresL_nat : ∀ n : ℕ, resL (n : L) = (n : k_L) := by
    intro n
    induction n with
    | zero => simp [hresL_0]
    | succ n ih =>
      rw [Nat.cast_succ, (hresL_ring (n : L) 1 (hnat_val_L n) h1_int_L).1,
        ih, hresL_1, Nat.cast_succ]
  have hresL_pow : ∀ (s : L), (s = 0 ∨ 0 ≤ valL F L s) →
      ∀ n : ℕ, resL (s ^ n) = (resL s) ^ n := by
    intro s hs n
    induction n with
    | zero => simp [hresL_1]
    | succ n ih =>
      rw [pow_succ, (hresL_ring (s ^ n) s (hpow_val_L s hs n) hs).2.1, ih, pow_succ]

  have htr_smul : ∀ (a : L) (z : E'),
      traceLM F hLE' (IntermediateField.inclusion hLE' a * z) = a * traceLM F hLE' z := by
    intro a z
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE'
        (traceLM F hLE' (IntermediateField.inclusion hLE' a * z)) =
      IntermediateField.inclusion hLE' (a * traceLM F hLE' z)
    rw [map_mul (IntermediateField.inclusion hLE'), hact_trace, hact_trace, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun τ _ => ?_)
    rw [((hact_ring τ).2.2 _ _).2.1, hact_incl τ a]
  have htr1 : traceLM F hLE' (1 : E') = (p : L) := by
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE' (traceLM F hLE' (1 : E')) =
      IntermediateField.inclusion hLE' (p : L)
    rw [hact_trace (1 : E')]
    have hsum1 : (∑ τ : G, act τ (1 : E')) = ∑ _τ : G, (1 : E') :=
      Finset.sum_congr rfl (fun τ _ => (hact_ring τ).2.1)
    rw [hsum1, Finset.sum_const, Finset.card_univ, hcard_G, nsmul_one, map_natCast]
  have hp_valL : (p : L) = 0 ∨ 1 ≤ valL F L (p : L) := by
    have h1_bound : (1 : E') = 0 ∨
        (p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ valL F E' (1 : E') := by
      right
      rw [hval1_E', hp_sub1_int]
      have hb_int : (2 : ℤ) ≤ (bE' : ℤ) := by exact_mod_cast hbE'_ge2
      have hp_int : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
      nlinarith
    have htr_1 := htr_LE' 1 (1 : E') h1_bound
    rwa [htr1] at htr_1
  have hp_kL : (p : k_L) = 0 := by
    rw [← hresL_nat p]
    exact (hresL_ker (p : L) (hnat_val_L p)).mpr hp_valL
  have hcop_unit_L : ∀ d : ℕ, 0 < d → d < p → (d : L) ≠ 0 ∧ valL F L (d : L) = 0 := by
    intro d hd_pos hd_lt
    have hndvd : ¬ (p ∣ d) := Nat.not_dvd_of_pos_of_lt hd_pos hd_lt
    have hd_cop : d.Coprime p := (hPrime.coprime_iff_not_dvd.mpr hndvd).symm
    have hbez_int : ((d.gcd p : ℕ) : ℤ) = (d : ℤ) * d.gcdA p + (p : ℤ) * d.gcdB p :=
      Nat.gcd_eq_gcd_ab d p
    rw [hd_cop.gcd_eq_one] at hbez_int
    have hbez : (1 : L) = (d : L) * (d.gcdA p : L) + (p : L) * (d.gcdB p : L) := by
      have hcast := congrArg (Int.cast : ℤ → L) hbez_int
      push_cast at hcast
      exact hcast
    have hp_term : (p : L) * (d.gcdB p : L) = 0 ∨
        1 ≤ valL F L ((p : L) * (d.gcdB p : L)) := by
      rcases hval_mul_ge_L hp_valL (hint_val_L (d.gcdB p)) with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hd_ne0 : (d : L) ≠ 0 := by
      intro hd0
      rw [hd0, zero_mul, zero_add] at hbez
      rw [← hbez] at hp_term
      rcases hp_term with h1_0 | h1_ge1
      · exact one_ne_zero h1_0
      · rw [hval1_L] at h1_ge1; omega
    refine ⟨hd_ne0, ?_⟩
    have hd_ge0 : 0 ≤ valL F L (d : L) := (hnat_val_L d).resolve_left hd_ne0
    by_contra hne0
    have hd_ge1 : 1 ≤ valL F L (d : L) := by omega
    have hd_term : (d : L) * (d.gcdA p : L) = 0 ∨
        1 ≤ valL F L ((d : L) * (d.gcdA p : L)) := by
      rcases hval_mul_ge_L (Or.inr hd_ge1) (hint_val_L (d.gcdA p)) with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum1 := hval_add_L 1 _ _ hd_term hp_term
    rw [← hbez] at hsum1
    rcases hsum1 with h1_0 | h1_ge1
    · exact one_ne_zero h1_0
    · rw [hval1_L] at h1_ge1; omega

  
  have hSpecL := ld_condExp_and_condExpChar_spec F L ψ hψ 1
  have hSpecE' := ld_condExp_and_condExpChar_spec F E' ψE' hψE' 1
  have hψE'_app : ∀ w : E', ψE' w = ψ (traceLM F hLE' w) := fun _ => rfl
  have ht_eq : t + 1 = bE' := by
    have hb_le_t1 : bE' ≤ t + 1 := by
      obtain ⟨y₁, hy₁_tr, _, hy₁_nz⟩ := htr_surj_t (1 : L)
      obtain ⟨hy₁_ne0, hy₁_val⟩ := hy₁_nz one_ne_zero
      by_contra hgt
      have hbound : y₁ = 0 ∨
          (p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ valL F E' y₁ := by
        right
        change valL F E' y₁ =
          (p : ℤ) * valL F L (1 : L) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) at hy₁_val
        rw [hy₁_val, hval1_L, hp_sub1_int]
        have ht_lt : (t + 1 : ℤ) + 1 ≤ (bE' : ℤ) := by omega
        have hp_int : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
        nlinarith
      have htr_1 := htr_LE' 1 y₁ hbound
      rw [hy₁_tr, hval1_L] at htr_1
      rcases htr_1 with h1_0 | h1_ge1
      · exact one_ne_zero h1_0
      · omega
    have ht1_le_b : t + 1 ≤ bE' := by
      obtain ⟨w₂, _, hw₂_val, hw₂_ψ⟩ := hSpecE'.2.1
      by_contra hgt
      have hbound : w₂ = 0 ∨
          (p : ℤ) * (-condExpChar F L ψ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F E' w₂ := by
        right
        have hlt_int : (bE' : ℤ) + 1 ≤ (t + 1 : ℤ) := by omega
        have hp_int : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
        have hn_le : (p : ℤ) * (-condExpChar F L ψ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤
            -(condExpChar F E' ψE' + 1) := by
          change -(condExpChar F E' (traceChar F hLE' ψ) + 1) ≤ valL F E' w₂ at hw₂_val
          change (p : ℤ) * (-condExpChar F L ψ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤
            -(condExpChar F E' (traceChar F hLE' ψ) + 1)
          rw [hnE'_eq, hp_sub1_int]
          nlinarith
        exact le_trans hn_le hw₂_val
      have htr_w₂ := htr_bound_t (-condExpChar F L ψ) w₂ hbound
      have htriv : ψE' w₂ = 1 := by
        rw [hψE'_app]
        exact hSpecL.1 (traceLM F hLE' w₂) htr_w₂
      exact hw₂_ψ htriv
    omega

  let fromExtendScalars : E'' →+* E' :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLE').mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let φ_act : G → (E' →+* E') := fun γ =>
    { toFun := act γ
      map_one' := (hact_ring γ).2.1
      map_mul' := fun w₁ w₂ => ((hact_ring γ).2.2 w₁ w₂).2.1
      map_zero' := (hact_ring γ).1
      map_add' := fun w₁ w₂ => ((hact_ring γ).2.2 w₁ w₂).1 }
  let φ_G : G → (E'' →ₐ[L] E'') := fun γ =>
    { (toExtendScalars F hLE').comp ((φ_act γ).comp fromExtendScalars) with
      commutes' := fun x => by
        change toExtendScalars F hLE' (act γ (IntermediateField.inclusion hLE' x)) =
          algebraMap L E'' x
        rw [hact_incl γ x]
        rfl }
  have hφG_inj : Function.Injective φ_G := by
    intro γ₁ γ₂ h_eq
    have h1 : γ₁ * γ₂⁻¹ = 1 := by
      apply hact_faithful (γ₁ * γ₂⁻¹)
      intro w
      have h_app : φ_G γ₁ (toExtendScalars F hLE' (act γ₂⁻¹ w)) =
          φ_G γ₂ (toExtendScalars F hLE' (act γ₂⁻¹ w)) :=
        congrArg (fun f : E'' →ₐ[L] E'' => f (toExtendScalars F hLE' (act γ₂⁻¹ w))) h_eq
      have h_from : act γ₁ (act γ₂⁻¹ w) = act γ₂ (act γ₂⁻¹ w) :=
        congrArg fromExtendScalars h_app
      rw [← hact_mul, ← hact_mul, mul_inv_cancel, hact_one] at h_from
      exact h_from
    exact mul_inv_eq_one.mp h1
  have hcard_le1 : Fintype.card G ≤ Fintype.card (E'' →ₐ[L] E'') :=
    Fintype.card_le_of_injective φ_G hφG_inj
  have hcard_le2 : Fintype.card (E'' →ₐ[L] E'') ≤ p := @AlgHom.card_le L E'' _ _ _ _
  have hcard_eq : Fintype.card G = Fintype.card (E'' →ₐ[L] E'') := by omega
  have hφG_bij : Function.Bijective φ_G :=
    (Fintype.bijective_iff_injective_and_card φ_G).mpr ⟨hφG_inj, hcard_eq⟩
  let f_σ : E'' →ₐ[L] E'' :=
    { (toExtendScalars F hLE').comp (σ.toRingEquiv.toRingHom.comp fromExtendScalars) with
      commutes' := fun x => by
        change toExtendScalars F hLE' (σ (IntermediateField.inclusion hLE' x)) =
          algebraMap L E'' x
        rw [hσ_L x]
        rfl }
  obtain ⟨γ, hγ_eq⟩ := hφG_bij.2 f_σ
  have hσ_act : ∀ w : E', σ w = act γ w := by
    intro w
    have h1 : φ_G γ (toExtendScalars F hLE' w) = f_σ (toExtendScalars F hLE' w) :=
      congrArg (fun f : E'' →ₐ[L] E'' => f (toExtendScalars F hLE' w)) hγ_eq
    exact (congrArg fromExtendScalars h1).symm
  have hγ_ne1 : γ ≠ 1 := by
    rcases hσ_ne with ⟨y₀, hy₀_ne⟩
    intro hγ1
    apply hy₀_ne
    rw [hσ_act y₀, hγ1, hact_one y₀]

  obtain ⟨hδ_ne0, hδ_val⟩ := hjump γ hγ_ne1
  have hx_star_eq : x_star = -((ϖ_E' : E') - act γ (ϖ_E' : E')) * ((ϖ_E'⁻¹ : E'ˣ) : E') := by
    dsimp only [x_star]
    rw [hσ_act (ϖ_E' : E'), neg_sub, sub_mul, Units.mul_inv]
  have hx_star_ne0 : x_star ≠ 0 := by
    rw [hx_star_eq]
    exact mul_ne_zero (neg_ne_zero.mpr hδ_ne0) (Units.ne_zero ϖ_E'⁻¹)
  have hx_star_val : valL F E' x_star = (t : ℤ) := by
    rw [hx_star_eq, hval_mul_E' _ _ (neg_ne_zero.mpr hδ_ne0) (Units.ne_zero ϖ_E'⁻¹),
      hval_neg_E', hδ_val, hval_inv_E' ϖ_E', hϖ_E']
    ring
  have hx_star_d₂ : x_star = 0 ∨ (d₂ : ℤ) ≤ valL F E' x_star := by
    right
    rw [hx_star_val]
    omega

  have hnorm_act_γ : normLM F hLE' (act γ (ϖ_E' : E')) = normLM F hLE' (ϖ_E' : E') := by
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE' (normLM F hLE' (act γ (ϖ_E' : E'))) =
      IntermediateField.inclusion hLE' (normLM F hLE' (ϖ_E' : E'))
    rw [hact_norm (act γ (ϖ_E' : E')), hact_norm (ϖ_E' : E')]
    have hmul_prod : (∏ τ : G, act τ (act γ (ϖ_E' : E'))) = ∏ τ : G, act (τ * γ) (ϖ_E' : E') :=
      Finset.prod_congr rfl (fun τ _ => (hact_mul τ γ (ϖ_E' : E')).symm)
    rw [hmul_prod]
    exact Equiv.prod_comp (Equiv.mulRight γ) (fun τ => act τ (ϖ_E' : E'))
  have hnorm_1_add_x_star : normLM F hLE' (1 + x_star) = 1 := by
    have h1x : 1 + x_star = act γ (ϖ_E' : E') * ((ϖ_E'⁻¹ : E'ˣ) : E') := by
      dsimp only [x_star]
      rw [hσ_act (ϖ_E' : E')]
      ring
    rw [h1x, map_mul (normLM F hLE'), hnorm_act_γ, ← map_mul (normLM F hLE'),
      Units.mul_inv, map_one]
  have hu_x_star : normLM F hLE' (1 + x_star) - 1 = 0 := by
    rw [hnorm_1_add_x_star, sub_self]

  obtain ⟨z_star, hz_star_val, hnorm_x_star_eq⟩ :=
    hnorm_exp t ht_ge1 x_star (Or.inr (le_of_eq hx_star_val.symm))
  have htr_z_star_bE' : traceLM F hLE' z_star = 0 ∨ (bE' : ℤ) ≤ valL F L (traceLM F hLE' z_star) := by
    apply htr_LE' (bE' : ℤ) z_star
    rcases hz_star_val with rfl | hge
    · exact Or.inl rfl
    · right
      have h1 : (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) = (bE' : ℤ) := by
        rw [hp_sub1_int]; ring
      rw [h1]
      omega
  have hneg_tr_z_star : - traceLM F hLE' z_star = 0 ∨
      (t + 1 : ℤ) ≤ valL F L (- traceLM F hLE' z_star) := by
    rcases hval_neg_ge_L htr_z_star_bE' with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  let u_xstar : E'ˣ := Units.mk0 x_star hx_star_ne0
  have hnorm_x_star_ne0 : normLM F hLE' x_star ≠ 0 :=
    Units.ne_zero (Units.map (normLM F hLE') u_xstar)
  have hneg_norm_x_star_ne0 : - normLM F hLE' x_star ≠ 0 := neg_ne_zero.mpr hnorm_x_star_ne0
  have hneg_norm_x_star_val : valL F L (- normLM F hLE' x_star) = (t : ℤ) := by
    rw [hval_neg_L, hval_norm_LE' x_star, hx_star_val]
  have htr_x_star_decomp :
      traceLM F hLE' x_star = - normLM F hLE' x_star + (- traceLM F hLE' z_star) := by
    rw [hnorm_1_add_x_star, map_add (traceLM F hLE') x_star z_star] at hnorm_x_star_eq
    linear_combination -hnorm_x_star_eq
  have htr_x_star_ge : traceLM F hLE' x_star = 0 ∨ (t : ℤ) ≤ valL F L (traceLM F hLE' x_star) := by
    rw [htr_x_star_decomp]
    apply hval_add_L (t : ℤ) (- normLM F hLE' x_star) (- traceLM F hLE' z_star)
      (Or.inr (le_of_eq hneg_norm_x_star_val.symm))
    rcases hneg_tr_z_star with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have htr_x_star_not_gt :
      ¬ (traceLM F hLE' x_star = 0 ∨ (t + 1 : ℤ) ≤ valL F L (traceLM F hLE' x_star)) := by
    intro hgt
    have hsum := hval_sub_L (t + 1 : ℤ) (traceLM F hLE' x_star) (- traceLM F hLE' z_star)
      hgt hneg_tr_z_star
    have hid : traceLM F hLE' x_star - (- traceLM F hLE' z_star) = - normLM F hLE' x_star := by
      rw [htr_x_star_decomp]; ring
    rw [hid] at hsum
    rcases hsum with h0 | hge
    · exact hneg_norm_x_star_ne0 h0
    · rw [hneg_norm_x_star_val] at hge; omega
  have htr_x_star_ne0 : traceLM F hLE' x_star ≠ 0 :=
    fun h0 => htr_x_star_not_gt (Or.inl h0)
  have htr_x_star_val : valL F L (traceLM F hLE' x_star) = (t : ℤ) := by
    have hge := htr_x_star_ge.resolve_left htr_x_star_ne0
    by_contra hne
    exact htr_x_star_not_gt (Or.inr (by omega))

  set β : L := α₀ * 2 * traceLM F hLE' x_star
  obtain ⟨h2_ne0, h2_val0⟩ := hcop_unit_L 2 (by omega) hp_ge3
  have h2_eq : ((2 : ℕ) : L) = (2 : L) := by norm_num
  rw [h2_eq] at h2_ne0 h2_val0
  have hα₀_ne0 : α₀ ≠ 0 := Units.ne_zero c_νE'⁻¹
  have hα₀_val : valL F L α₀ = -((bE' : ℤ) + condExpChar F L ψ) := by
