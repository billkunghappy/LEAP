    (hy_rT : y = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y)
    (hy_3mE : y = 0 ∨ (condExp F E' θE' : ℤ) ≤ 3 * valL F E' y)
    (hy_rU : y = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y)
    (hy_trU : y = 0 ∨
      2 * (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) - (condExp F L νE' : ℤ) ≤ valL F E' y)
    (hy : 1 + y ≠ 0) :
    let A := normLM F hLE' x
    (θE' (Units.mk0 (1 + y) hy) : Ω F) =
      ψ (((c_ν⁻¹ : Lˣ) : L) *
        ((A + c) * traceLM F hLE' y + A * normLM F hLE' y)) :=
by
  intro A
  
  set T := condExp F L νE'
  set mM₁' := condExp F M₁' θM₁'
  set mE' := condExp F E' θE'
  set h := mM₁' - T
  set r_T := (T + 1) / 2
  set r_U := (mM₁' + 1) / 2
  set n := condExpChar F L ψ
  set b := traceLM F hLE' x
  set ψM₁' := traceChar F hLM₁' ψ
  have hdegLM₁'_2 : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    hdegM₁'.trans hdeg2
  have hdegE'K₁_2 : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 :=
    hdegE'K₁.trans hdeg2
  have hdegM₁'K₁_2 : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 :=
    hdegM₁'K₁.trans hdeg2
  have hnorm_zero : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂] (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      normLM F hM₀M₂ 0 = 0 := by
    intro M₀ M₂ _ _ hM₀M₂ hdeg
    have h1 := ((hQuadNorm M₀ M₂ hM₀M₂ hdeg).2 1 0).1
    rw [map_one, add_zero, map_one, map_zero] at h1
    linear_combination -h1
  have hnorm_incl : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂] (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      ∀ a : M₀, normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ a) = a ^ 2 := by
    intro M₀ M₂ _ _ hM₀M₂ hdeg a
    have h1 := ((hQuadNorm M₀ M₂ hM₀M₂ hdeg).2 a 0).1
    rw [add_zero, map_zero, hnorm_zero M₀ M₂ hM₀M₂ hdeg, mul_zero, add_zero, add_zero] at h1
