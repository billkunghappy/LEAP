    induction' n using Nat.strong_induction_on with n ih
    rcases eq_or_ne n 0 with rfl | hn0
    · simp
    · have hn_pos : 0 < n := Nat.pos_of_ne_zero hn0
      set q₀ := n / p
      set r₀ := n % p
      have hq₀_lt : q₀ < n := Nat.div_lt_self hn_pos hp.one_lt
