        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hFiMC).mpr hx)
      have hconjMC : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
        hGalFiMC.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτMC
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjMC
      exact hconjMC x ((IntermediateField.mem_extendScalars hFiMC).mp hx)
    exact helper_isGalois F_i (AlgebraicClosure F) M_C_Fi hMC_norm_fix
  haveI : IsGalois F_i ↥M_C_Fi := hGalFiMC'
  let G : Type u := (M_C_Fi ≃ₐ[F_i] M_C_Fi)
  let fromExtendScalars : M_C_Fi →+* M_C := e_MC_Fi.symm.toRingHom
  let act : G → M_C → M_C := fun σ z => fromExtendScalars (σ (toExtendScalars F hFiMC z))
  have hact_one : ∀ z : M_C, act 1 z = z := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (z : M_C), act (σ * τ) z = act σ (act τ z) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ z₁ z₂ : M_C,
        act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
        act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
        act σ (-z₁) = -act σ z₁) := by
    intro σ
    refine ⟨by change fromExtendScalars (σ 0) = 0; rw [map_zero, map_zero],
      by change fromExtendScalars (σ 1) = 1; rw [map_one, map_one],
      fun z₁ z₂ => ⟨?_, ?_, ?_⟩⟩
    · change fromExtendScalars (σ (toExtendScalars F hFiMC z₁ + toExtendScalars F hFiMC z₂)) = _
      rw [map_add, map_add]
    · change fromExtendScalars (σ (toExtendScalars F hFiMC z₁ * toExtendScalars F hFiMC z₂)) = _
      rw [map_mul, map_mul]
    · change fromExtendScalars (σ (-toExtendScalars F hFiMC z₁)) = _
      rw [map_neg, map_neg]
  have hact_incl : ∀ (σ : G) (x : F_i),
      act σ (IntermediateField.inclusion hFiMC x) = IntermediateField.inclusion hFiMC x := by
    intro σ x
    change fromExtendScalars (σ (algebraMap F_i M_C_Fi x)) = IntermediateField.inclusion hFiMC x
    rw [σ.commutes x]
    rfl
  have hact_faithful : ∀ σ : G, (∀ z : M_C, act σ z = z) → σ = 1 := by
    intro σ h
    apply AlgEquiv.ext
    intro y
    exact congrArg (toExtendScalars F hFiMC) (h (fromExtendScalars y))
  have hact_val : ∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z := by
    intro σ z
    let φ_σ : M_C ≃ₐ[F] M_C := e_MC_Fi.trans ((σ.restrictScalars F).trans e_MC_Fi.symm)
    have hφ : φ_σ z = act σ z := rfl
    unfold valL relVal
    rw [← hφ, Algebra.norm_eq_of_algEquiv φ_σ z]
  have hact_trace : ∀ z : M_C,
      IntermediateField.inclusion hFiMC (traceLM F hFiMC z) = ∑ σ : G, act σ z := by
    intro z
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := F_i) (L := M_C_Fi) (toExtendScalars F hFiMC z))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hFiMC z)) Finset.univ)
  have hact_norm : ∀ z : M_C,
      IntermediateField.inclusion hFiMC (normLM F hFiMC z) = ∏ σ : G, act σ z := by
    intro z
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms F_i (toExtendScalars F hFiMC z))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hFiMC z)) Finset.univ)
  have hinj_FiMC : Function.Injective (IntermediateField.inclusion hFiMC) :=
    (IntermediateField.inclusion hFiMC).injective
  have hTrBoundFi : ∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
      (traceLM F hFiMC z = 0 ∨ m ≤ valL F F_i (traceLM F hFiMC z)) := by
    intro m z hz
    have hz_act : ∀ σ : G, act σ z = 0 ∨ m ≤ valL F M_C (act σ z) := by
      intro σ
      rcases hz with rfl | hge
      · exact Or.inl (by rw [(hact_ring σ).1])
      · exact Or.inr (by rw [hact_val σ z]; exact hge)
    have h_sum_bound : ∀ S : Finset G,
        (∑ σ ∈ S, act σ z) = 0 ∨ m ≤ valL F M_C (∑ σ ∈ S, act σ z) := by
      intro S
      induction' S using Finset.induction_on with τ S' hτ ih
      · exact Or.inl Finset.sum_empty
      · rw [Finset.sum_insert hτ]
        exact hvalMC_add m (act τ z) (∑ σ ∈ S', act σ z) (hz_act τ) ih
    have h_univ := h_sum_bound Finset.univ
    rw [← hact_trace z] at h_univ
    rcases h_univ with h0 | hge
    · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hFiMC) hinj_FiMC).mp h0)
    · rw [hValAlgFiMC (traceLM F hFiMC z)] at hge
      exact Or.inr hge
  have hring_id : ∀ (a S_sum P : M_C),
      (1 + a) * P - (1 + (a + S_sum)) =
        (P - (1 + S_sum)) + a * S_sum + a * (P - (1 + S_sum)) :=
    fun _ _ _ => by ring
  have hNormRemFi : ∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
      normLM F hFiMC (1 + z) - (1 + traceLM F hFiMC z) = 0 ∨
        2 * valL F M_C z ≤
          valL F F_i (normLM F hFiMC (1 + z) - (1 + traceLM F hFiMC z)) := by
    intro z hz
    by_cases hz0 : z = 0
    · exact Or.inl (by rw [hz0]; simp)
    · have hd : 1 ≤ valL F M_C z := hz.resolve_left hz0
      let d : ℤ := valL F M_C z
      have hz_act : ∀ σ : G, act σ z = 0 ∨ d ≤ valL F M_C (act σ z) := by
        intro σ
        exact Or.inr (by rw [hact_val σ z])
      have h_ind : ∀ S : Finset G,
          ((∑ σ ∈ S, act σ z) = 0 ∨ d ≤ valL F M_C (∑ σ ∈ S, act σ z)) ∧
          ((∏ σ ∈ S, (1 + act σ z)) - (1 + ∑ σ ∈ S, act σ z) = 0 ∨
            2 * d ≤ valL F M_C ((∏ σ ∈ S, (1 + act σ z)) - (1 + ∑ σ ∈ S, act σ z))) := by
        intro S
        induction' S using Finset.induction_on with τ S' hτ ih
        · exact ⟨Or.inl Finset.sum_empty,
            Or.inl (by rw [Finset.prod_empty, Finset.sum_empty, add_zero, sub_self])⟩
        · rw [Finset.sum_insert hτ, Finset.prod_insert hτ]
          let a := act τ z
          let S_sum := ∑ σ ∈ S', act σ z
          let P := ∏ σ ∈ S', (1 + act σ z)
          let R := P - (1 + S_sum)
          have ih1 : S_sum = 0 ∨ d ≤ valL F M_C S_sum := ih.1
          have ih2 : R = 0 ∨ 2 * d ≤ valL F M_C R := ih.2
          have ha : a = 0 ∨ d ≤ valL F M_C a := hz_act τ
          have hsum : a + S_sum = 0 ∨ d ≤ valL F M_C (a + S_sum) :=
            hvalMC_add d a S_sum ha ih1
          refine ⟨hsum, ?_⟩
          rw [hring_id a S_sum P]
          change (R + a * S_sum + a * R = 0) ∨ 2 * d ≤ valL F M_C (R + a * S_sum + a * R)
          have haS : a * S_sum = 0 ∨ 2 * d ≤ valL F M_C (a * S_sum) := by
            by_cases ha0 : a = 0
            · exact Or.inl (by rw [ha0, zero_mul])
            · by_cases hS0 : S_sum = 0
              · exact Or.inl (by rw [hS0, mul_zero])
              · right
                rw [hvalMC_mul a S_sum ha0 hS0]
                have h1 := ha.resolve_left ha0
                have h2 := ih1.resolve_left hS0
                omega
          have haR : a * R = 0 ∨ 2 * d ≤ valL F M_C (a * R) := by
            by_cases ha0 : a = 0
            · exact Or.inl (by rw [ha0, zero_mul])
            · by_cases hR0 : R = 0
              · exact Or.inl (by rw [hR0, mul_zero])
              · right
                rw [hvalMC_mul a R ha0 hR0]
                have h1 := ha.resolve_left ha0
                have h2 := ih2.resolve_left hR0
                omega
          exact hvalMC_add (2 * d) (R + a * S_sum) (a * R)
            (hvalMC_add (2 * d) R (a * S_sum) ih2 haS) haR
      have h_univ := (h_ind Finset.univ).2
      have hprod_eq : (∏ σ : G, (1 + act σ z)) =
          IntermediateField.inclusion hFiMC (normLM F hFiMC (1 + z)) := by
        rw [hact_norm (1 + z)]
        refine Finset.prod_congr rfl fun σ _ => ?_
        rw [((hact_ring σ).2.2 1 z).1, (hact_ring σ).2.1]
      have h_diff_eq : (∏ σ : G, (1 + act σ z)) - (1 + ∑ σ : G, act σ z) =
          IntermediateField.inclusion hFiMC (normLM F hFiMC (1 + z) - (1 + traceLM F hFiMC z)) := by
        rw [hprod_eq, ← hact_trace z]
        simp only [map_sub, map_add, map_one]
      rw [h_diff_eq] at h_univ
      rcases h_univ with h0 | hge
      · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hFiMC) hinj_FiMC).mp h0)
      · rw [hValAlgFiMC (normLM F hFiMC (1 + z) - (1 + traceLM F hFiMC z))] at hge
        exact Or.inr hge
  exact ⟨hNormFi, hTrBoundFi, hNormRemFi, hf_i_ex,
    G, inferInstance, inferInstance, act,
    hact_one, hact_mul, hact_ring, hact_incl, hact_faithful, hact_val, hact_trace⟩

theorem ld_ch14_wild_diamond_and_unramified_orbits (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hGalFiMC : ∀ i : Fin D_orb.length, IsGaloisExt F (D_orb.get i).field M_C)
    (hp_prime : Nat.Prime (p F))
    (hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (k : ℕ) (hk_ge1 : 1 ≤ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hresE : resDeg F E = resDeg F L)
    (hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
        valL F (D_orb.get i).field x) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let r_orb := D_orb.length
    qL F E = qL F L ∧
    (∀ y : E, valL F L (normLM F hLE y) = valL F E y) ∧
    (∀ x : L, valL F E (IntermediateField.inclusion hLE x) = (q : ℤ) * valL F L x) ∧
    (∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x))) ∧
    (∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y)) ∧
    (∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z))) ∧
    (∀ (m : ℤ) (w : K),
      (w = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F K w) →
      (traceLM F hEK w = 0 ∨ m ≤ valL F E (traceLM F hEK w))) ∧
    (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F) = 0 ∨
        1 ≤ valL F L (traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F))) ∧
    (∀ i : Fin r_orb,
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      (∃ y_Fi : M_C, (y_Fi = 0 ∨ 0 ≤ valL F M_C y_Fi) ∧
        traceLM F (hFiMC i) y_Fi = 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x)) :=
by
  obtain ⟨hqE, hValNormE, hValAlgE, hResLiftE, hDiamondTrNorm⟩ :=
    ld_ch14_wild_diamond_basis_and_trace_norm_compat F L K M_C E hLM_C hM_CK hLE hEK
      hFinE_eq hq_gt1 hValAlgK k hk_dvd hValAlgKE hresE
  obtain ⟨hTrBoundMCL, hTrBoundKE, hTrFrobMCL⟩ :=
    ld_ch14_wild_tame_trace_bounds_and_frob_congruence F L K M_C E hLK hLM_C hM_CK hLE hEK
      hGal hMin hp_prime k hk_ge1 hValAlgMCL hValAlgKE
  obtain ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv,
    hvalMC_surj, hvalMC_add, _, _, _⟩ := ld_valL_and_unitGroup_props F M_C
  have hvalMC_8 : valL F M_C 0 = 0 ∧ valL F M_C 1 = 0 ∧ valL F M_C (-1) = 0 ∧
      (∀ x : M_C, valL F M_C (-x) = valL F M_C x) ∧
      (∀ x y : M_C, x ≠ 0 → y ≠ 0 → valL F M_C (x * y) = valL F M_C x + valL F M_C y) ∧
      (∀ u : M_Cˣ, valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = - valL F M_C (u : M_C)) ∧
      (∀ m : ℤ, ∃ c : M_Cˣ, valL F M_C (c : M_C) = m) ∧
      (∀ (k : ℤ) (x y : M_C),
        (x = 0 ∨ k ≤ valL F M_C x) → (y = 0 ∨ k ≤ valL F M_C y) →
          (x + y = 0 ∨ k ≤ valL F M_C (x + y))) :=
    ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv, hvalMC_surj, hvalMC_add⟩
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halgMC0, halgMC1,
    R_F, hRF_0, hRF_mod1⟩ := ld_addVal_finset_and_algebraMap_valL F M_C
  obtain ⟨S₁_MC, hS₁_MC⟩ :=
    ld_valL_mod_one_finset F M_C hvalMC0 hvalMC_neg hvalMC_mul hvalMC_add
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halgMC0 halgMC1 R_F hRF_0 hRF_mod1
  obtain ⟨k_MC, hField_kMC, hFin_kMC, resMC, hresMC_0, hresMC_1,
    hresMC_ring, hresMC_ker, hresMC_surj⟩ :=
    ld_valL_residue_field_exists F M_C hvalMC0 hvalMC1 hvalMC_neg1 hvalMC_neg
      hvalMC_mul hvalMC_inv hvalMC_add S₁_MC hS₁_MC
  letI : Field k_MC := hField_kMC
  letI : Fintype k_MC := hFin_kMC
  refine ⟨hqE, hValNormE, hValAlgE, hResLiftE, hDiamondTrNorm,
    hTrBoundMCL, hTrBoundKE, hTrFrobMCL, ?_⟩
  intro i
  set F_i := (D_orb.get i).field
  haveI : FiniteDimensional F F_i := hFinFi i
  obtain ⟨hNormFi, hTrBoundFi, hNormRemFi, hf_i_ex,
    G, hGrpG, hFinG, act, hact_one, hact_mul, hact_ring,
    hact_incl, hact_faithful, hact_val, hact_trace⟩ :=
    ld_ch14_unramified_orbit_norm_trace_and_degree F L F_i M_C hLM_C (D_orb.get i).le (hFiMC i)
      (hGalFiMC i) k hk_ge1 hValAlgMCL (hValAlgFiMC i)
  letI : Group G := hGrpG
  letI : Fintype G := hFinG
  obtain ⟨hvalFi0, hvalFi1, hvalFi_neg1, hvalFi_neg, hvalFi_mul, hvalFi_inv,
    hvalFi_surj, hvalFi_add, _, _, _⟩ := ld_valL_and_unitGroup_props F F_i
  have hvalFi_8 : valL F F_i 0 = 0 ∧ valL F F_i 1 = 0 ∧ valL F F_i (-1) = 0 ∧
      (∀ x : F_i, valL F F_i (-x) = valL F F_i x) ∧
      (∀ x y : F_i, x ≠ 0 → y ≠ 0 → valL F F_i (x * y) = valL F F_i x + valL F F_i y) ∧
      (∀ u : F_iˣ, valL F F_i ((u⁻¹ : F_iˣ) : F_i) = - valL F F_i (u : F_i)) ∧
      (∀ m : ℤ, ∃ c : F_iˣ, valL F F_i (c : F_i) = m) ∧
      (∀ (k : ℤ) (x y : F_i),
        (x = 0 ∨ k ≤ valL F F_i x) → (y = 0 ∨ k ≤ valL F F_i y) →
          (x + y = 0 ∨ k ≤ valL F F_i (x + y))) :=
    ⟨hvalFi0, hvalFi1, hvalFi_neg1, hvalFi_neg, hvalFi_mul, hvalFi_inv, hvalFi_surj, hvalFi_add⟩
  obtain ⟨_, _, _, _, halgFi0, halgFi1, _, _, _⟩ := ld_addVal_finset_and_algebraMap_valL F F_i
  obtain ⟨S₁_Fi, hS₁_Fi⟩ :=
    ld_valL_mod_one_finset F F_i hvalFi0 hvalFi_neg hvalFi_mul hvalFi_add
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halgFi0 halgFi1 R_F hRF_0 hRF_mod1
  obtain ⟨k_Fi, hField_kFi, _, resFi, hresFi_0, hresFi_1,
    hresFi_ring, hresFi_ker, hresFi_surj⟩ :=
    ld_valL_residue_field_exists F F_i hvalFi0 hvalFi1 hvalFi_neg1 hvalFi_neg
      hvalFi_mul hvalFi_inv hvalFi_add S₁_Fi hS₁_Fi
  letI : Field k_Fi := hField_kFi
  obtain ⟨hAlg_k, π_res, hres_alg, hπ_res⟩ :=
    ld_unramified_residue_algebra_and_galois_hom F F_i M_C (hFiMC i) (hValAlgFiMC i)
      hvalFi_8 hvalMC_8 G act hact_one hact_mul hact_ring hact_incl hact_val
      k_Fi k_MC resFi resMC hresFi_0 hresFi_1 hresFi_ring hresFi_ker hresFi_surj
      hresMC_0 hresMC_1 hresMC_ring hresMC_ker hresMC_surj
  letI : Algebra k_Fi k_MC := hAlg_k
  have hπ_inj : Function.Injective π_res := by
    rw [injective_iff_map_eq_one]
    intro σ hσ1
    apply ld_unramified_inertia_trivial_of_resK_fix F F_i M_C (hFiMC i) (hValAlgFiMC i)
      hvalFi_surj hvalMC_8 G act hact_ring hact_incl hact_faithful hact_val
      k_MC resMC hresMC_0 hresMC_1 hresMC_ring hresMC_ker σ
    intro y hy
    rw [← hπ_res σ y hy, hσ1]
    rfl
  have hy_Fi :=
    ld_unramified_trace_one_of_galois_inj F F_i M_C (hFiMC i) (hValAlgFiMC i)
      hTrBoundFi hvalFi_8 hvalMC_8 G act hact_ring hact_incl hact_val hact_trace
      k_Fi k_MC resFi resMC hresFi_ker hresMC_0 hresMC_ring hresMC_surj
      hres_alg π_res hπ_inj hπ_res
  exact ⟨hNormFi, hTrBoundFi, hNormRemFi, hy_Fi, hf_i_ex⟩

theorem ld_ch14_wild_power_basis_and_euler_lagrange_trace (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] [FiniteDimensional F K]
    (hMK : M ≤ K) (hGal : IsGaloisExt F M K)
    (hq_ge2 : 2 ≤ Module.finrank M (IntermediateField.extendScalars hMK))
    (hValNorm : ∀ w : K, valL F M (normLM F hMK w) = valL F K w)
    (hValAlg : ∀ z : M,
      valL F K (IntermediateField.inclusion hMK z) =
        (Module.finrank M (IntermediateField.extendScalars hMK) : ℤ) * valL F M z)
    (ϖ_K : Kˣ) (ϖ_M : Mˣ)
    (hϖ_norm : Units.map (normLM F hMK) ϖ_K = ϖ_M)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_M : valL F M (ϖ_M : M) = 1)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (hJump : ∀ σ ∈ M.fixingSubgroup, σ ∉ K.fixingSubgroup →
      ∀ hσw : (σ : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K,
        (ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) ≠ 0 ∧
        valL F K ((ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K)) =
