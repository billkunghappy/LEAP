      have hx₀_e₂ : e₂ x₀ = toExtendScalars F hE₁F₁ u₁ :=
        Subtype.ext (h_inv_apply γ u₁.1)
      have h_norm_eq : Algebra.norm E₂ x₀ = e₁.symm (Algebra.norm E₁ (e₂ x₀)) :=
        Algebra.norm_eq_of_equiv_equiv e₁ e₂ h_comm_alg x₀
      change Algebra.norm E₂ x₀ = (z' : E₂)
      rw [h_norm_eq, hx₀_e₂]
      change ϕ (normLM F hE₁F₁ u₁) = ϕ (z : E₁)
      rw [hu₁]
    have hz'_fix_F₀ : (rec.recMap E₂ z' : AbsGal F) ∈ F₀.fixingSubgroup :=
      (rec.ker_rec E₂ F₀ hE₂F₀ hAbE₂F₀ z').mpr ⟨u₀, hu₀_norm⟩
    have hγ₂_fix_F₁ : γ₂ ∈ F₁.fixingSubgroup :=
      (h_fix_F₀ (rec.recMap E₂ z' : AbsGal F)).mp hz'_fix_F₀
    have hσ₂_mem : σ₂ ∈ H₁_sub := by
      rw [← h_fix_H₁, IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      apply Subtype.ext
      rw [hσ₂ x]
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hγ₂_fix_F₁ x.1 ((h_mem_F₁ x).mpr hx)
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hσ₂_mem
    have hγ₂_ζ : γ₂ ζ_N = γ₁ ζ_N := by
      have hγ₂_p : IsPrimeToPRootOfUnity F (γ₂ ζ_N) := h_primeToP_map γ₂ ζ_N hζ_p
      have h1 : γ₁⁻¹ (γ₂ ζ_N) = ζ_N := by
        rw [hγ₁_frob (γ₂ ζ_N) hγ₂_p, ← hγ₂_frob (γ₂ ζ_N) hγ₂_p, h_inv_apply γ₂ ζ_N]
      calc γ₂ ζ_N = γ₁ (γ₁⁻¹ (γ₂ ζ_N)) := (h_apply_inv γ₁ (γ₂ ζ_N)).symm
        _ = γ₁ ζ_N := congrArg (⇑γ₁) h1
    have hk_ζ :
        (((σ₁ ^ k) ⟨ζ_N, (IntermediateField.mem_extendScalars hE₁M').mpr hζ_mem⟩ : M_ext') :
          AlgebraicClosure F) = γ₁ ζ_N := by
      rw [hk, hσ₂ ⟨ζ_N, (IntermediateField.mem_extendScalars hE₁M').mpr hζ_mem⟩, hγ₂_ζ]
    have h_eq_M₀ :=
      ld_frob_zpow_eq_on_subfield_of_primitiveRoot F E₁ E₁ M₀ M' le_rfl hE₁M₀ hM₀M' hGalE₁M₀
        (resDeg F E₁) hf_E₁ hq ζ_N hζ_prim hζ_p hζ_mem
        γ₁ hγ₁_E₁ hγ₁_frob σ₁ hσ₁ k hk_ζ
    have hdiff_Mab :
        (((rec.recMap E₁ z)⁻¹ * conjHom_g (rec.recMap E₂ z') : relWeil F E₁) : AbsGal F) ∈
          M_ab.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro a ha
      have ha_M₀ : a ∈ M₀ := hMabM₀ ha
      have ha_eq : γ₂ a = γ₁ a := by
        have h1 := h_eq_M₀ a ha_M₀
        rw [hk, hσ₂ ⟨a, (IntermediateField.mem_extendScalars hE₁M').mpr (hM₀M' ha_M₀)⟩] at h1
        exact h1
      change (γ₁⁻¹ * γ₂) a = a
      rw [AlgEquiv.mul_apply, ha_eq, h_inv_apply γ₁ a]
    have hχ_ab_eq : χ_ab (conjHom_g (rec.recMap E₂ z')) = χ_ab (rec.recMap E₁ z) := by
      have htriv : χ_ab ((rec.recMap E₁ z)⁻¹ * conjHom_g (rec.recMap E₂ z')) = 1 :=
        hχ_ab_ker ((rec.recMap E₁ z)⁻¹ * conjHom_g (rec.recMap E₂ z')) hdiff_Mab
      rw [map_mul, map_inv, inv_mul_eq_one] at htriv
      exact htriv.symm
    change θ₂ (ϕ_u z) = θ₁ z
    rw [hθ₂_rec z', hθ₁_rec z, hχ₂_conj (rec.recMap E₂ z'), hχ₁_eq,
      MonoidHom.mul_apply, MonoidHom.mul_apply, hω_eq, hχ_ab_eq]
  obtain ⟨_, hval_one, _, _, hval_mul, hval_inv, hval_surj, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E₁
  obtain ⟨ϖ_E₁, hϖ_E₁⟩ := hval_surj 1
  have hval_pow : ∀ n : ℕ, valL F E₁ (((ϖ_E₁ ^ n : E₁ˣ) : E₁)) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simpa using hval_one
    · rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_E₁, Nat.cast_add, Nat.cast_one]
  have hval_zpow : ∀ m : ℤ, valL F E₁ (((ϖ_E₁ ^ m : E₁ˣ) : E₁)) = m := by
    intro m
    cases m with
    | ofNat n => simpa using hval_pow n
    | negSucc n =>
      rw [zpow_negSucc, hval_inv, hval_pow (n + 1)]
      rfl
  have hrec_eq : ∀ y : E₁ˣ, θ₂ (ϕ_u y) = θ₁ y := by
    intro y
    set m_y : ℤ := valL F E₁ (y : E₁)
    let u : E₁ˣ := y * ϖ_E₁ ^ (-m_y)
    have hval_u : valL F E₁ (u : E₁) = 0 := by
      change valL F E₁ ((y : E₁) * ((ϖ_E₁ ^ (-m_y) : E₁ˣ) : E₁)) = 0
      rw [hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hval_zpow (-m_y)]
      change m_y + -m_y = 0
      omega
    have hval_ϖu : valL F E₁ (((ϖ_E₁ * u : E₁ˣ) : E₁)) = 1 := by
      rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hϖ_E₁, hval_u, add_zero]
    have hy_eq : y = (ϖ_E₁ * u) * ϖ_E₁ ^ (m_y - 1) := by
      have h1 : (ϖ_E₁ * u) * ϖ_E₁ ^ (m_y - 1) =
          y * (ϖ_E₁ ^ (1 : ℤ) * ϖ_E₁ ^ (-m_y) * ϖ_E₁ ^ (m_y - 1)) := by
        dsimp [u]
        rw [zpow_one]
        ac_rfl
      rw [h1, ← zpow_add, ← zpow_add, show (1 : ℤ) + -m_y + (m_y - 1) = 0 by omega,
        zpow_zero, mul_one]
    change Ψ₁ y = Ψ₂ y
    rw [hy_eq, Ψ₁.map_mul (ϖ_E₁ * u), Ψ₁.map_zpow, Ψ₂.map_mul (ϖ_E₁ * u), Ψ₂.map_zpow,
      hΨ_unif (ϖ_E₁ * u) hval_ϖu, hΨ_unif ϖ_E₁ hϖ_E₁]
  
  let ϕ_L : IntermediateField.extendScalars hLE₁ ≃ₐ[L] IntermediateField.extendScalars hLE₂ :=
    { toFun := fun x =>
        ⟨(ϕ ⟨x.1, (IntermediateField.mem_extendScalars hLE₁).mp x.2⟩).1,
          (IntermediateField.mem_extendScalars hLE₂).mpr
            (ϕ ⟨x.1, (IntermediateField.mem_extendScalars hLE₁).mp x.2⟩).2⟩
      invFun := fun y =>
        ⟨(ϕ.symm ⟨y.1, (IntermediateField.mem_extendScalars hLE₂).mp y.2⟩).1,
          (IntermediateField.mem_extendScalars hLE₁).mpr
            (ϕ.symm ⟨y.1, (IntermediateField.mem_extendScalars hLE₂).mp y.2⟩).2⟩
      left_inv := fun x => Subtype.ext (congrArg Subtype.val (ϕ.symm_apply_apply ⟨x.1, _⟩))
      right_inv := fun y => Subtype.ext (congrArg Subtype.val (ϕ.apply_symm_apply ⟨y.1, _⟩))
      map_mul' := fun x y => Subtype.ext (congrArg Subtype.val (map_mul ϕ ⟨x.1, _⟩ ⟨y.1, _⟩))
      map_add' := fun x y => Subtype.ext (congrArg Subtype.val (map_add ϕ ⟨x.1, _⟩ ⟨y.1, _⟩))
      commutes' := fun r => Subtype.ext (by
        change ((ϕ ⟨r.1, hLE₁ r.2⟩ : E₂) : AlgebraicClosure F) = r.1
        exact (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγL r.1 r.2) }
  have htraceChar_ϕ : ∀ x : E₁,
      traceChar F hLE₂ ψ (ϕ x) = traceChar F hLE₁ ψ x := by
    intro x
    change ψ (Algebra.trace L (IntermediateField.extendScalars hLE₂) (toExtendScalars F hLE₂ (ϕ x))) =
      ψ (Algebra.trace L (IntermediateField.extendScalars hLE₁) (toExtendScalars F hLE₁ x))
    have h_app : toExtendScalars F hLE₂ (ϕ x) = ϕ_L (toExtendScalars F hLE₁ x) := rfl
    rw [h_app, Algebra.trace_eq_of_algEquiv ϕ_L (toExtendScalars F hLE₁ x)]
  have htateEpsUnit_eq :
      tateEpsUnit F E₂ θ₂ (traceChar F hLE₂ ψ) = tateEpsUnit F E₁ θ₁ (traceChar F hLE₁ ψ) :=
    (ld_ch13_2_tateEpsUnit_algEquiv_invariance F E₁ E₂ ϕ
      (traceChar F hLE₁ ψ) hψ₁ (traceChar F hLE₂ ψ) htraceChar_ϕ
      θ₁ hθ₁_cond θ₂ hrec_eq).2
  have heval_eq :
      evalMonomialTerm F rec (fun _ E _ => f E) L ψ t' =
        evalMonomialTerm F rec (fun _ E _ => f E) L ψ t := by
    change (tateEpsUnit F E₂ θ₂ (traceChar F hLE₂ ψ) * f E₂) ^ t.coeff =
      (tateEpsUnit F E₁ θ₁ (traceChar F hLE₁ ψ) * f E₁) ^ t.coeff
    rw [htateEpsUnit_eq, hf_eq]
  have hrest_eq :
      restrictWeilChar F hE₂K t'.χ = conjWeilChar F hGal g (restrictWeilChar F htK t.χ) := by
    apply MonoidHom.ext
    intro w
    rfl
  exact ⟨t', ht'Wf, htr_eq, heval_eq, hE₂K, hrest_eq⟩

theorem ld_ch17_stabilizer_isotypic_descent (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (χK : relWeil F K →* (Ω F)ˣ)
    (D₁ : List (MonomialTerm F L))
    (hD₁ : IsHomogeneousDecompOn F L K χK D₁) :
    D₁ = [] ∨
    IsInvariantWeilChar F L K χK ∨
    ∃ (L₀ : IntermediateField F (AlgebraicClosure F)) (hLL₀ : L ≤ L₀) (hL₀K : L₀ ≤ K)
      (D₀ : List (MonomialTerm F L₀)),
      IsGaloisExt F L₀ K ∧
      Algebra.IsSeparable L (IntermediateField.extendScalars hLL₀) ∧
      Module.finrank L₀ (IntermediateField.extendScalars hL₀K) <
        Module.finrank L (IntermediateField.extendScalars hLK) ∧
      D₁ = D₀.map (MonomialTerm.restrict F hLL₀) ∧
      IsMonomialDecomp F L₀ 0 D₀ ∧
      (∀ t ∈ D₀, t.field ≤ K) :=
by
  rcases D₁ with _ | ⟨t₀, tl⟩
  · exact Or.inl rfl
  · by_cases hInv : IsInvariantWeilChar F L K χK
    · exact Or.inr (Or.inl hInv)
    · refine Or.inr (Or.inr ?_)
      obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
      have ht₀Wf : t₀.Wf F L := hD₁.1.1 t₀ List.mem_cons_self
      obtain ⟨ht₀K, ht₀χ⟩ := hD₁.2 t₀ List.mem_cons_self
      have hWeilK : IsWeilRep F K (charRep F K χK) := by
        obtain ⟨hFinW, U, hU, htriv⟩ := ht₀Wf.2.2
        refine ⟨hFinW, U, hU, fun w hwU hwI => ?_⟩
        let w₀ : relWeil F t₀.field := Subgroup.inclusion (relWeil_antitone F ht₀K) w
        have hw₀ : charRep F t₀.field t₀.χ w₀ = 1 := htriv w₀ hwU hwI
        have hχ_eq : χK w = t₀.χ w₀ := by
          rw [← ht₀χ]
          rfl
        change (χK w : Ω F) • LinearMap.id = 1
        rw [hχ_eq]
        exact hw₀
      have h_exists_not_conj : ∃ g₀ : relWeil F L, conjWeilChar F hGal g₀ χK ≠ χK := by
        by_contra h_all
        push_neg at h_all
        apply hInv
        refine ⟨hWeilK, fun g w hgw => ?_⟩
        have h1 : (conjWeilChar F hGal g⁻¹ χK) w = χK w := by
          rw [h_all g⁻¹]
        have h2 : (conjWeilChar F hGal g⁻¹ χK) w =
            χK ⟨(g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹, hgw⟩ := by
          have hm : conjWeilElt F hGal (g⁻¹)⁻¹ w =
              ⟨(g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹, hgw⟩ := by
            ext
            simp [conjWeilElt]
          exact congrArg χK hm
        rw [← h2, h1]
      obtain ⟨g₀, hg₀_ne⟩ := h_exists_not_conj
      have hconj_one : conjWeilChar F hGal 1 χK = χK := by
        ext w
        change (χK (conjWeilElt F hGal (1 : relWeil F L)⁻¹ w) : Ω F) = χK w
        have h1 : conjWeilElt F hGal (1 : relWeil F L)⁻¹ w = w := by
          ext
          simp [conjWeilElt]
        rw [h1]
      have hconj_mul : ∀ (g₁ g₂ : relWeil F L) (χ : relWeil F K →* (Ω F)ˣ),
          conjWeilChar F hGal (g₁ * g₂) χ =
            conjWeilChar F hGal g₁ (conjWeilChar F hGal g₂ χ) := by
        intro g₁ g₂ χ
        ext w
        change (χ (conjWeilElt F hGal (g₁ * g₂)⁻¹ w) : Ω F) =
          (χ (conjWeilElt F hGal g₂⁻¹ (conjWeilElt F hGal g₁⁻¹ w)) : Ω F)
        have hm : conjWeilElt F hGal (g₁ * g₂)⁻¹ w =
            conjWeilElt F hGal g₂⁻¹ (conjWeilElt F hGal g₁⁻¹ w) := by
          ext
          simp [conjWeilElt, mul_assoc]
        rw [hm]
      let S_χ : Subgroup (relWeil F L) :=
        { carrier := {g : relWeil F L | conjWeilChar F hGal g χK = χK}
          one_mem' := hconj_one
          mul_mem' := fun {g₁ g₂} h₁ h₂ => by
            change conjWeilChar F hGal (g₁ * g₂) χK = χK
            rw [hconj_mul, h₂, h₁]
          inv_mem' := fun {g} hg => by
            change conjWeilChar F hGal g⁻¹ χK = χK
            calc conjWeilChar F hGal g⁻¹ χK
              _ = conjWeilChar F hGal g⁻¹ (conjWeilChar F hGal g χK) := by rw [hg]
              _ = conjWeilChar F hGal (g⁻¹ * g) χK := (hconj_mul g⁻¹ g χK).symm
              _ = conjWeilChar F hGal 1 χK := by rw [inv_mul_cancel]
              _ = χK := hconj_one }
      have h_sub_in_S : ∀ (E : IntermediateField F (AlgebraicClosure F))
          (hLE : L ≤ E) (hEK : E ≤ K) (χE : relWeil F E →* (Ω F)ˣ),
          restrictWeilChar F hEK χE = χK →
          ∀ g : relWeil F L, (g : AbsGal F) ∈ relWeil F E → g ∈ S_χ := by
        intro E _ hEK χE hrest g hgE
        change conjWeilChar F hGal g χK = χK
        ext w
        let g_E : relWeil F E := ⟨g.1, hgE⟩
        let ι_KE : relWeil F K →* relWeil F E := Subgroup.inclusion (relWeil_antitone F hEK)
        have h_elt : ι_KE (conjWeilElt F hGal g⁻¹ w) = g_E⁻¹ * ι_KE w * g_E := by
          apply Subtype.ext
          change ((g⁻¹ : relWeil F L) : AbsGal F) * (w : AbsGal F) * ((g⁻¹ : relWeil F L) : AbsGal F)⁻¹ =
            (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F)
          simp
        have h1 : χK (conjWeilElt F hGal g⁻¹ w) = χE (ι_KE (conjWeilElt F hGal g⁻¹ w)) := by
          rw [← hrest]
          rfl
        have h2 : χK w = χE (ι_KE w) := by
          rw [← hrest]
          rfl
        change (χK (conjWeilElt F hGal g⁻¹ w) : Ω F) = (χK w : Ω F)
        rw [h1, h2, h_elt, map_mul, map_mul, map_inv, mul_comm (χE g_E)⁻¹, inv_mul_cancel_right]
      let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
      let G' := (K' ≃ₐ[L] K')
      have hFinK : FiniteDimensional F K := hGal.2.1
      haveI : FiniteDimensional F K := hFinK
      have hFinL : FiniteDimensional F L :=
        Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
          (IntermediateField.inclusion hLK).injective
      haveI : FiniteDimensional F L := hFinL
      haveI : FiniteDimensional F K' := hFinK
      haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hFinLK' : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
      haveI : FiniteDimensional L K' := hFinLK'
      have hSep_iff : ∀ (A B : IntermediateField F (AlgebraicClosure F)) (hAB : A ≤ B),
          Algebra.IsSeparable A (IntermediateField.extendScalars hAB) ↔
            B ≤ IntermediateField.restrictScalars F (separableClosure A (AlgebraicClosure F)) := by
        intro A B hAB
        let S := IntermediateField.extendScalars hAB
        have hmin : ∀ x : S, IsSeparable A x.1 ↔ IsSeparable A x := by
          intro x
          change (minpoly A (S.val x)).Separable ↔ (minpoly A x).Separable
          rw [minpoly.algHom_eq S.val S.val.injective x]
        constructor
        · intro hSep z hz
          rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
          let x : S := ⟨z, (IntermediateField.mem_extendScalars hAB).mpr hz⟩
          exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable A S _ _ _ hSep x)
        · intro hle
          refine ⟨fun x => (hmin x).mp ?_⟩
          have hz : x.1 ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
          exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
      have hSepLK : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
      haveI : Algebra.IsSeparable L K' := hSepLK
      have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
          [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
          (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
          IsGalois k K₀ := by
        intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
        let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
        haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
        haveI : Normal k N := IsGalois.to_normal
        have hK₀N : K₀ ≤ N := by
          intro z hz
          rw [mem_separableClosure_iff]
          let x : K₀ := ⟨z, hz⟩
          have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
          have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
          change (minpoly k z).Separable
          rw [hmin]
          exact hx
        let K_N : IntermediateField k N := K₀.comap N.val
        have hKN_map : K_N.map N.val = K₀ := by
          ext z
          refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
          rintro ⟨y, hy, rfl⟩
          exact hy
        have hKN_norm : K_N.fixingSubgroup.Normal := by
          refine ⟨fun h hh g => ?_⟩
          obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
          obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
          rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
          have hτ_fix : ∀ x ∈ K₀, τ x = x := by
            intro x hx
            let z : N := ⟨x, hK₀N hx⟩
            have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
            have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
            rwa [AlgEquiv.restrictNormalHom_apply] at h1
          intro y hy
          apply Subtype.ext
          rw [← map_inv, ← map_mul, ← map_mul]
          change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
          rw [AlgEquiv.restrictNormalHom_apply]
          exact h_norm_fix σ τ hτ_fix y.1 hy
        haveI : K_N.fixingSubgroup.Normal := hKN_norm
        haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
        let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
        exact IsGalois.of_algEquiv e_KN
      haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
      haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
      have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
          (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
        intro σ τ hτ
        let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
        let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
        have hτK : τ_F.1 ∈ K.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro x hx
          exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
        have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
          hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
        intro x hx
        rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
        exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
      have hGalLK' : IsGalois L ↥K' := helper_isGalois L (AlgebraicClosure F) K' hK'_norm_fix
      haveI : IsGalois L ↥K' := hGalLK'
      haveI : Normal L ↥K' := IsGalois.to_normal
      let π : relWeil F L →* G' :=
        (AlgEquiv.restrictNormalHom K').comp
          ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
            (Subgroup.inclusion (inf_le_right : relWeil F L ≤ L.fixingSubgroup)))
      have hπ : ∀ (w : relWeil F L) (x : K'),
          ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) := by
        intro w x
        change ((AlgEquiv.restrictNormalHom K'
          ((IntermediateField.fixingSubgroupEquiv L) ⟨w.1, w.2.2⟩) x : K') : AlgebraicClosure F) =
          (w : AbsGal F) (x : AlgebraicClosure F)
        rw [AlgEquiv.restrictNormalHom_apply]
        rfl
      let H_KL : Subgroup (relWeil F L) := (relWeil F K).subgroupOf (relWeil F L)
      let bar_π : (relWeil F L ⧸ H_KL) → G' := fun u => π (cosetRep u)
      have h_ker_π : ∀ w : relWeil F L, π w = 1 → w ∈ H_KL := by
        intro w hw
        rw [Subgroup.mem_subgroupOf]
        refine Subgroup.mem_inf.mpr ⟨w.2.1, ?_⟩
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro z hz
        let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
        have h1 := hπ w x
        rw [hw] at h1
        exact h1.symm
      have hbar_π_inj : Function.Injective bar_π := by
        intro u₁ u₂ h_eq
        change π (cosetRep u₁) = π (cosetRep u₂) at h_eq
        have h1 : π ((cosetRep u₁)⁻¹ * cosetRep u₂) = 1 := by
          rw [map_mul, map_inv, h_eq, inv_mul_cancel]
        have h2 : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ H_KL := h_ker_π _ h1
        have h3 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_KL) =
            QuotientGroup.mk (cosetRep u₂) := QuotientGroup.eq.mpr h2
        have h_out1 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_KL) = u₁ :=
          Quotient.out_eq u₁
        have h_out2 : (QuotientGroup.mk (cosetRep u₂) : relWeil F L ⧸ H_KL) = u₂ :=
          Quotient.out_eq u₂
        rw [h_out1, h_out2] at h3
        exact h3
      obtain ⟨hFin_quot_KL, hCard_quot_KL⟩ :=
        ld_relWeil_quotient_card_eq_finrank F hp hFrob L K hLK hSepLK
      letI : Finite (relWeil F L ⧸ H_KL) := hFin_quot_KL
      letI : Fintype (relWeil F L ⧸ H_KL) := Fintype.ofFinite (relWeil F L ⧸ H_KL)
      have h_card_eq : Fintype.card (relWeil F L ⧸ H_KL) = Fintype.card G' := by
        rw [← Nat.card_eq_fintype_card, hCard_quot_KL, ← IsGalois.card_aut_eq_finrank L K',
          Nat.card_eq_fintype_card]
      have hbar_π_bij : Function.Bijective bar_π :=
        (Fintype.bijective_iff_injective_and_card bar_π).mpr ⟨hbar_π_inj, h_card_eq⟩
      have hsurj : Function.Surjective π := by
        intro g
        obtain ⟨u, hu⟩ := hbar_π_bij.2 g
        exact ⟨cosetRep u, hu⟩
      let M₀ : Subgroup G' := S_χ.map π
      let E₀ : IntermediateField L K' := IntermediateField.fixedField M₀
      let L₀ : IntermediateField F (AlgebraicClosure F) :=
        (IntermediateField.lift E₀).restrictScalars F
      have hLL₀ : L ≤ L₀ := by
        intro z hz
        rw [IntermediateField.mem_restrictScalars]
        exact (IntermediateField.lift E₀).algebraMap_mem ⟨z, hz⟩
      have hL₀K : L₀ ≤ K := by
        intro z hz
        have hz_lift : z ∈ IntermediateField.lift E₀ :=
          (IntermediateField.mem_restrictScalars F).mp hz
        have hzK' : z ∈ K' := IntermediateField.lift_le E₀ hz_lift
        exact (IntermediateField.mem_extendScalars hLK).mp hzK'
      have hE₀_fix : E₀.fixingSubgroup = M₀ := IntermediateField.fixingSubgroup_fixedField M₀
      have hStab : ∀ g : relWeil F L,
          conjWeilChar F hGal g χK = χK ↔ (g : AbsGal F) ∈ relWeil F L₀ := by
        intro g
        change g ∈ S_χ ↔ (g : AbsGal F) ∈ relWeil F L₀
        have h_weil_L₀ : (g : AbsGal F) ∈ relWeil F L₀ ↔ (g : AbsGal F) ∈ L₀.fixingSubgroup := by
          change ((g : AbsGal F) ∈ weilGroup F ∧ (g : AbsGal F) ∈ L₀.fixingSubgroup) ↔ _
          exact and_iff_right g.2.1
        have h_fix_E₀ : (g : AbsGal F) ∈ L₀.fixingSubgroup ↔ π g ∈ E₀.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
          constructor
          · intro hg x hxE₀
            apply Subtype.ext
            rw [hπ g x]
            have hxL₀ : x.1 ∈ L₀ :=
              (IntermediateField.mem_restrictScalars F).mpr ((IntermediateField.mem_lift x).mpr hxE₀)
            exact hg x.1 hxL₀
          · intro hπg z hzL₀
            let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hL₀K hzL₀)⟩
            have hxE₀ : x ∈ E₀ :=
              (IntermediateField.mem_lift x).mp ((IntermediateField.mem_restrictScalars F).mp hzL₀)
            have h1 := congrArg Subtype.val (hπg x hxE₀)
            rwa [hπ g x] at h1
        rw [h_weil_L₀, h_fix_E₀, hE₀_fix]
        constructor
        · intro hg
          exact Subgroup.mem_map_of_mem π hg
        · intro hπg
          obtain ⟨s, hs, hs_eq⟩ := Subgroup.mem_map.mp hπg
          have h_ker : π (s⁻¹ * g) = 1 := by
            rw [map_mul, map_inv, hs_eq, inv_mul_cancel]
          have h_mem_KL : s⁻¹ * g ∈ H_KL := h_ker_π (s⁻¹ * g) h_ker
          have h_in_S : s⁻¹ * g ∈ S_χ :=
            h_sub_in_S K hLK le_rfl χK rfl (s⁻¹ * g) h_mem_KL
          have h_mul : s * (s⁻¹ * g) ∈ S_χ := S_χ.mul_mem hs h_in_S
          rwa [mul_inv_cancel_left] at h_mul
      let toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)), L ≤ A → IntermediateField L K' :=
        fun A hLA => (IntermediateField.extendScalars hLA).comap K'.val
      have h_mem_toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A) (x : K'),
          x ∈ toSub A hLA ↔ x.1 ∈ A :=
        fun A hLA _ => IntermediateField.mem_extendScalars hLA
      have hSub_le : ∀ (E : IntermediateField F (AlgebraicClosure F))
          (hLE : L ≤ E) (hEK : E ≤ K) (χE : relWeil F E →* (Ω F)ˣ),
          restrictWeilChar F hEK χE = χK → L₀ ≤ E := by
        intro E hLE hEK χE hrest z hz
        have hzL : z ∈ IntermediateField.lift E₀ :=
          (IntermediateField.mem_restrictScalars F).mp hz
        have hzK' : z ∈ K' := IntermediateField.lift_le E₀ hzL
        let x : K' := ⟨z, hzK'⟩
        have hxM₀ : x ∈ E₀ := (IntermediateField.mem_lift x).mp hzL
        have h_fix_sub : (toSub E hLE).fixingSubgroup ≤ M₀ := by
          intro γ hγ
          obtain ⟨g, rfl⟩ := hsurj γ
          have hgE : (g : AbsGal F) ∈ relWeil F E := by
            refine Subgroup.mem_inf.mpr ⟨g.2.1, ?_⟩
            rw [IntermediateField.mem_fixingSubgroup_iff]
            intro y hyE
            let yK' : K' := ⟨y, (IntermediateField.mem_extendScalars hLK).mpr (hEK hyE)⟩
            have hy_sub : yK' ∈ toSub E hLE := (h_mem_toSub E hLE yK').mpr hyE
            have h1 := congrArg Subtype.val ((IntermediateField.mem_fixingSubgroup_iff _ (π g)).mp hγ yK' hy_sub)
            rwa [hπ g yK'] at h1
          exact Subgroup.mem_map_of_mem π (h_sub_in_S E hLE hEK χE hrest g hgE)
        have hx_fix : x ∈ IntermediateField.fixedField (toSub E hLE).fixingSubgroup := by
          rw [IntermediateField.mem_fixedField_iff]
          intro γ hγ
          exact (IntermediateField.mem_fixedField_iff M₀ x).mp hxM₀ γ (h_fix_sub hγ)
        rw [IsGalois.fixedField_fixingSubgroup (toSub E hLE)] at hx_fix
        exact (h_mem_toSub E hLE x).mp hx_fix
      have hSep₀ : Algebra.IsSeparable L (IntermediateField.extendScalars hLL₀) := by
        rw [hSep_iff L L₀ hLL₀]
        exact hL₀K.trans ((hSep_iff L K hLK).mp hSepLK)
      have hGal₀ : IsGaloisExt F L₀ K := by
        refine ⟨hL₀K, hFinK, ?_, ?_⟩
        · intro σ hσL₀ τ hτK
          exact hGal.2.2.1 σ (IntermediateField.fixingSubgroup_le hLL₀ hσL₀) τ hτK
        · intro h
          rw [hSep_iff L₀ K h]
          intro z hz
          rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
          have hzL : IsSeparable L z := by
            have hK_sep := (hSep_iff L K hLK).mp hSepLK hz
            exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
          exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLL₀)) hzL
      have hL₀_ne_L : L₀ ≠ L := by
        intro hEq
        have hg₀_L₀ : (g₀ : AbsGal F) ∈ relWeil F L₀ := by
          rw [hEq]
          exact g₀.2
        exact hg₀_ne ((hStab g₀).mpr hg₀_L₀)
      haveI : FiniteDimensional F L₀ :=
        Module.Finite.of_injective (IntermediateField.inclusion hL₀K).toLinearMap
          (IntermediateField.inclusion hL₀K).injective
      have hlt : Module.finrank L₀ (IntermediateField.extendScalars hL₀K) <
          Module.finrank L (IntermediateField.extendScalars hLK) := by
        haveI : IsScalarTower F L (IntermediateField.extendScalars hLL₀) :=
          IsScalarTower.of_algebraMap_eq fun _ => rfl
        haveI : IsScalarTower F L₀ (IntermediateField.extendScalars hL₀K) :=
          IsScalarTower.of_algebraMap_eq fun _ => rfl
        have h1 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLL₀) =
            Module.finrank F L₀ :=
          Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLL₀)
        have h2 : Module.finrank F L₀ * Module.finrank L₀ (IntermediateField.extendScalars hL₀K) =
            Module.finrank F K :=
          Module.finrank_mul_finrank F L₀ (IntermediateField.extendScalars hL₀K)
        have h3 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) =
            Module.finrank F K :=
          Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLK)
        have hposL : 0 < Module.finrank F L := Module.finrank_pos
        have hposK : 0 < Module.finrank F K := Module.finrank_pos
        have hmul_eq : Module.finrank F L *
            (Module.finrank L (IntermediateField.extendScalars hLL₀) *
              Module.finrank L₀ (IntermediateField.extendScalars hL₀K)) =
            Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) := by
          rw [← mul_assoc, h1, h2, h3]
        have hdeg_eq : Module.finrank L (IntermediateField.extendScalars hLL₀) *
            Module.finrank L₀ (IntermediateField.extendScalars hL₀K) =
            Module.finrank L (IntermediateField.extendScalars hLK) :=
          Nat.eq_of_mul_eq_mul_left hposL hmul_eq
        have hpos_L₀K : 0 < Module.finrank L₀ (IntermediateField.extendScalars hL₀K) := by
          by_contra h0
          have h0' : Module.finrank L₀ (IntermediateField.extendScalars hL₀K) = 0 :=
            Nat.eq_zero_of_not_pos h0
          rw [h0', mul_zero] at h2
          exact (ne_of_gt hposK) h2.symm
        have hgt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLL₀) := by
          by_contra hle1
          have hle1' : Module.finrank L (IntermediateField.extendScalars hLL₀) ≤ 1 :=
            not_lt.mp hle1
          have hfin_le : Module.finrank F L₀ ≤ Module.finrank F L := by
            calc Module.finrank F L₀
              _ = Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLL₀) := h1.symm
              _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hle1'
              _ = Module.finrank F L := mul_one _
          have hEq : L = L₀ := IntermediateField.eq_of_le_of_finrank_le hLL₀ hfin_le
          exact hL₀_ne_L hEq.symm
        calc Module.finrank L₀ (IntermediateField.extendScalars hL₀K)
          _ = 1 * Module.finrank L₀ (IntermediateField.extendScalars hL₀K) := (one_mul _).symm
          _ < Module.finrank L (IntermediateField.extendScalars hLL₀) *
              Module.finrank L₀ (IntermediateField.extendScalars hL₀K) :=
            Nat.mul_lt_mul_of_pos_right hgt1 hpos_L₀K
          _ = Module.finrank L (IntermediateField.extendScalars hLK) := hdeg_eq
      have h_reindex : ∀ (L_sub : List (MonomialTerm F L)),
          (∀ t ∈ L_sub, t.Wf F L) →
          (∀ t ∈ L_sub, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = χK) →
          ∃ D₀ : List (MonomialTerm F L₀),
            L_sub = D₀.map (MonomialTerm.restrict F hLL₀) ∧
            (∀ t ∈ D₀, t.Wf F L₀) ∧
            (∀ t ∈ D₀, (t.restrict F hLL₀).Wf F L) ∧
            (∀ t ∈ D₀, t.field ≤ K) ∧
            (∀ t ∈ D₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = χK) := by
        intro L_sub
        induction L_sub with
        | nil =>
          intro _ _
          exact ⟨[], rfl, by simp, by simp, by simp, by simp⟩
        | cons t tl ih =>
          intro hWf hK
          have htWf : t.Wf F L := hWf t List.mem_cons_self
          obtain ⟨htK, htχ⟩ := hK t List.mem_cons_self
          have hL₀t : L₀ ≤ t.field := hSub_le t.field t.le htK t.χ htχ
          let t' : MonomialTerm F L₀ := ⟨t.coeff, t.field, hL₀t, t.χ⟩
          have ht'_rest : t'.restrict F hLL₀ = t := rfl
          have ht'_Wf : t'.Wf F L₀ := by
            refine ⟨htWf.1, ?_, htWf.2.2⟩
            rw [hSep_iff L₀ t.field hL₀t]
            intro z hz
            rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
            have hzL : IsSeparable L z := by
              have ht_sep := (hSep_iff L t.field t.le).mp htWf.2.1 hz
              exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp ht_sep)
            exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLL₀)) hzL
          obtain ⟨D_tl, hD_tl_eq, hD_tl_Wf, hD_tl_WfL, hD_tl_K, hD_tl_χ⟩ :=
            ih (fun s hs => hWf s (List.mem_cons_of_mem t hs))
               (fun s hs => hK s (List.mem_cons_of_mem t hs))
          refine ⟨t' :: D_tl, ?_, ?_, ?_, ?_, ?_⟩
          · simp only [List.map_cons, ht'_rest, ← hD_tl_eq]
          · intro s hs
            rcases List.mem_cons.mp hs with rfl | hs
            · exact ht'_Wf
            · exact hD_tl_Wf s hs
          · intro s hs
            rcases List.mem_cons.mp hs with rfl | hs
            · rw [ht'_rest]
              exact htWf
            · exact hD_tl_WfL s hs
          · intro s hs
            rcases List.mem_cons.mp hs with rfl | hs
            · exact htK
            · exact hD_tl_K s hs
          · intro s hs
            rcases List.mem_cons.mp hs with rfl | hs
            · exact ⟨htK, htχ⟩
            · exact hD_tl_χ s hs
      obtain ⟨D₀, hD₁_eq, hD₀_Wf, hD₀_WfL, hD₀_K, hD₀_χ⟩ :=
        h_reindex (t₀ :: tl) hD₁.1.1 hD₁.2
      have h_frob_trace : ∀ (M : IntermediateField F (AlgebraicClosure F))
          (t : MonomialTerm F M) (g : relWeil F M)
          [Fintype (relWeil F M ⧸ (relWeil F t.field).subgroupOf (relWeil F M))],
          t.trace F M g =
            ∑ u₀ : relWeil F M ⧸ (relWeil F t.field).subgroupOf (relWeil F M),
              if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ (relWeil F t.field).subgroupOf (relWeil F M) then
                t.coeff • (t.χ (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F t.le)
                  ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F)
              else 0 := by
        intro M t g _
        let G_M := relWeil F M
        let E := t.field
        let H_E : Subgroup G_M := (relWeil F E).subgroupOf G_M
        let W := ULift.{u} (Ω F)
        let e_sub : H_E ≃* relWeil F E := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F t.le)
        let ρ : Representation (Ω F) H_E W := (charRep F E t.χ).comp e_sub.toMonoidHom
        let u : G_M → G_M ⧸ H_E := fun x => QuotientGroup.mk x⁻¹
        let r : G_M → G_M := fun x => cosetRep (u x)
        have h_xr_mem : ∀ x : G_M, x * r x ∈ H_E := by
          intro x
          have hout : (r x : G_M ⧸ H_E) = u x := Quotient.out_eq (u x)
          have hrel : (r x)⁻¹ * x⁻¹ ∈ H_E := QuotientGroup.eq.mp hout
          have hinv : (x * r x)⁻¹ ∈ H_E := by
            rw [mul_inv_rev]
            exact hrel
          exact (Subgroup.inv_mem_iff H_E).mp hinv
        have hu_mul : ∀ (h₀ : H_E) (x : G_M), u ((h₀ : G_M) * x) = u x := by
          intro h₀ x
          apply QuotientGroup.eq.mpr
          rw [inv_inv, mul_inv_cancel_right]
          exact h₀.2
        have hr_mul : ∀ (h₀ : H_E) (x : G_M), r ((h₀ : G_M) * x) = r x := by
          intro h₀ x
          dsimp only [r]
          rw [hu_mul h₀ x]
        have hu_rep_inv : ∀ u₀ : G_M ⧸ H_E, u (cosetRep u₀)⁻¹ = u₀ := by
          intro u₀
          dsimp only [u]
          rw [inv_inv]
          exact Quotient.out_eq u₀
        have hr_rep_inv : ∀ u₀ : G_M ⧸ H_E, r (cosetRep u₀)⁻¹ = cosetRep u₀ := by
          intro u₀
          dsimp only [r]
          rw [hu_rep_inv u₀]
        have hu_iff : ∀ (u₀ : G_M ⧸ H_E) (g₀ : G_M),
            u ((cosetRep u₀)⁻¹ * g₀) = u₀ ↔ (cosetRep u₀)⁻¹ * g₀ * cosetRep u₀ ∈ H_E := by
          intro u₀ g₀
          have h1 : u ((cosetRep u₀)⁻¹ * g₀) = QuotientGroup.mk (s := H_E) ((cosetRep u₀)⁻¹ * g₀)⁻¹ := rfl
          have h2 : u₀ = QuotientGroup.mk (s := H_E) (cosetRep u₀) := (Quotient.out_eq u₀).symm
          rw [h1]
          conv_lhs => rhs; rw [h2]
          rw [QuotientGroup.eq, inv_inv]
        let Φ : indSpace H_E ρ ≃ₗ[Ω F] ((G_M ⧸ H_E) → Ω F) :=
          { toFun := fun f u₀ => (f.1 (cosetRep u₀)⁻¹).down
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl
            invFun := fun φ =>
              ⟨fun x => ρ ⟨x * r x, h_xr_mem x⟩ (ULift.up (φ (u x))), fun h₀ x => by
                dsimp only
                rw [hu_mul h₀ x]
                have h_sub : (⟨((h₀ : G_M) * x) * r ((h₀ : G_M) * x), h_xr_mem ((h₀ : G_M) * x)⟩ : H_E) =
                    h₀ * ⟨x * r x, h_xr_mem x⟩ := by
                  apply Subtype.ext
                  change ((h₀ : G_M) * x) * r ((h₀ : G_M) * x) = (h₀ : G_M) * (x * r x)
                  rw [hr_mul h₀ x, mul_assoc]
                rw [h_sub, map_mul, Module.End.mul_apply]⟩
            left_inv := fun f => Subtype.ext (funext fun x => by
              dsimp only
              have hf := f.2 ⟨x * r x, h_xr_mem x⟩ (r x)⁻¹
              change ρ ⟨x * r x, h_xr_mem x⟩ (f.1 (r x)⁻¹) = f.1 x
              rw [← hf]
              change f.1 ((x * r x) * (r x)⁻¹) = f.1 x
              rw [mul_inv_cancel_right])
            right_inv := fun φ => funext fun u₀ => by
              dsimp only
              rw [hu_rep_inv u₀]
              have h_one : (⟨(cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹, h_xr_mem (cosetRep u₀)⁻¹⟩ : H_E) = 1 := by
                apply Subtype.ext
                change (cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹ = 1
                rw [hr_rep_inv u₀, inv_mul_cancel]
              rw [h_one, map_one, Module.End.one_apply] }
        let T : ((G_M ⧸ H_E) → Ω F) →ₗ[Ω F] ((G_M ⧸ H_E) → Ω F) := Φ.conj (indRep H_E ρ g)
        have h_tr_ind : LinearMap.trace (Ω F) (indSpace H_E ρ) (indRep H_E ρ g) =
            ∑ u₀ : G_M ⧸ H_E,
              if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H_E then
                (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F)
              else 0 := by
          have h_conj : LinearMap.trace (Ω F) (indSpace H_E ρ) (indRep H_E ρ g) =
              LinearMap.trace (Ω F) ((G_M ⧸ H_E) → Ω F) T :=
            (LinearMap.trace_conj' (indRep H_E ρ g) Φ).symm
          rw [h_conj]
          have h_decomp : T = ∑ u₀ : G_M ⧸ H_E,
              (LinearMap.single (Ω F) (fun _ : G_M ⧸ H_E => Ω F) u₀).comp
                ((LinearMap.proj u₀).comp T) := by
            apply LinearMap.ext
            intro φ
            funext u₁
            simp [LinearMap.sum_apply, LinearMap.comp_apply]
          rw [h_decomp, map_sum]
          apply Finset.sum_congr rfl
          intro u₀ _
          have h_comm : LinearMap.trace (Ω F) ((G_M ⧸ H_E) → Ω F)
              ((LinearMap.single (Ω F) (fun _ : G_M ⧸ H_E => Ω F) u₀).comp
                ((LinearMap.proj u₀).comp T)) =
              LinearMap.trace (Ω F) (Ω F)
                (((LinearMap.proj u₀).comp T).comp
                  (LinearMap.single (Ω F) (fun _ : G_M ⧸ H_E => Ω F) u₀)) :=
            (LinearMap.trace_comp_comm'
              (LinearMap.single (Ω F) (fun _ : G_M ⧸ H_E => Ω F) u₀)
              ((LinearMap.proj u₀).comp T)).symm
          rw [h_comm]
          let B : Ω F →ₗ[Ω F] Ω F :=
            ((LinearMap.proj u₀).comp T).comp (LinearMap.single (Ω F) (fun _ : G_M ⧸ H_E => Ω F) u₀)
          change LinearMap.trace (Ω F) (Ω F) B = _
          by_cases hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H_E
          · rw [dif_pos hc]
            have hu_eq : u ((cosetRep u₀)⁻¹ * g) = u₀ := (hu_iff u₀ g).mpr hc
            have hr_eq : r ((cosetRep u₀)⁻¹ * g) = cosetRep u₀ := congrArg cosetRep hu_eq
            have hB : B = (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F) • LinearMap.id := by
              apply LinearMap.ext
              intro a
              change (ρ ⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩
                (ULift.up (Pi.single (M := fun _ : G_M ⧸ H_E => Ω F) u₀ a (u ((cosetRep u₀)⁻¹ * g))))).down =
                (t.χ (e_sub ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩) : Ω F) * a
              rw [hu_eq, Pi.single_eq_same]
              have h_sub_eq : (⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩ : H_E) =
                  ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩ := by
                apply Subtype.ext
                change ((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g) = (cosetRep u₀)⁻¹ * g * cosetRep u₀
                rw [hr_eq]
              rw [h_sub_eq]
              rfl
            rw [hB, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one, smul_eq_mul, mul_one]
          · rw [dif_neg hc]
            have hu_ne : u ((cosetRep u₀)⁻¹ * g) ≠ u₀ := fun h => hc ((hu_iff u₀ g).mp h)
            have hB : B = 0 := by
              apply LinearMap.ext
              intro a
              change (ρ ⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩
                (ULift.up (Pi.single (M := fun _ : G_M ⧸ H_E => Ω F) u₀ a (u ((cosetRep u₀)⁻¹ * g))))).down = 0
              rw [Pi.single_eq_of_ne hu_ne]
              change (ρ ⟨((cosetRep u₀)⁻¹ * g) * r ((cosetRep u₀)⁻¹ * g), h_xr_mem ((cosetRep u₀)⁻¹ * g)⟩
                (0 : W)).down = 0
              rw [map_zero]
              rfl
            rw [hB, map_zero]
        change t.coeff • LinearMap.trace (Ω F) (indSpace H_E ρ) (indRep H_E ρ g) = _
        rw [h_tr_ind, Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro u₀ _
        split_ifs with hc
        · rfl
        · exact smul_zero t.coeff
      let ι_L₀L : relWeil F L₀ →* relWeil F L := Subgroup.inclusion (relWeil_antitone F hLL₀)
      let ι_KL : relWeil F K →* relWeil F L := Subgroup.inclusion (relWeil_antitone F hLK)
      let X := relWeil F K →* (Ω F)ˣ
      let v : X → (relWeil F K → Ω F) := fun χ w => (χ w : Ω F)
      have h_lin_indep : LinearIndependent (Ω F) v := by
        have h1 : LinearIndependent (Ω F) (fun f : relWeil F K →* Ω F => ⇑f) :=
          linearIndependent_monoidHom (relWeil F K) (Ω F)
        let emb : X → (relWeil F K →* Ω F) := fun χ => (Units.coeHom (Ω F)).comp χ
        have hemb : Function.Injective emb := by
          intro χ₁ χ₂ h
          ext w
          exact DFunLike.congr_fun h w
        exact h1.comp emb hemb
      have hterm_finsupp : ∀ (w₀ : relWeil F L₀) (t : MonomialTerm F L₀),
          t.Wf F L₀ → (t.restrict F hLL₀).Wf F L →
          (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = χK) →
          ∃ l_t : X →₀ Ω F,
            (∀ w : relWeil F K,
              Finsupp.linearCombination (Ω F) v l_t w =
                (t.restrict F hLL₀).trace F L (ι_L₀L w₀ * ι_KL w)) ∧
            l_t χK = t.trace F L₀ w₀ := by
        intro w₀ t htWf htWfL ⟨htK, htχ⟩
        let E := t.field
        haveI : FiniteDimensional F E := htWf.1
        let G_L := relWeil F L
        let G_L₀ := relWeil F L₀
        let H_EL : Subgroup G_L := (relWeil F E).subgroupOf G_L
        let H_EL₀ : Subgroup G_L₀ := (relWeil F E).subgroupOf G_L₀
        let e_EL : H_EL ≃* relWeil F E :=
          Subgroup.subgroupOfEquivOfLe (relWeil_antitone F (hLL₀.trans t.le))
        let e_EL₀ : H_EL₀ ≃* relWeil F E :=
          Subgroup.subgroupOfEquivOfLe (relWeil_antitone F t.le)
        have hFin_EL : Finite (G_L ⧸ H_EL) :=
          (ld_relWeil_quotient_card_eq_finrank F hp hFrob L E (hLL₀.trans t.le) htWfL.2.1).1
        have hFin_EL₀ : Finite (G_L₀ ⧸ H_EL₀) :=
          (ld_relWeil_quotient_card_eq_finrank F hp hFrob L₀ E t.le htWf.2.1).1
        letI fFin_EL : Fintype (G_L ⧸ H_EL) := Fintype.ofFinite (G_L ⧸ H_EL)
        letI fFin_EL₀ : Fintype (G_L₀ ⧸ H_EL₀) := Fintype.ofFinite (G_L₀ ⧸ H_EL₀)
        let c : G_L ⧸ H_EL → Ω F := fun u₀ =>
          if hc₀ : (cosetRep u₀)⁻¹ * ι_L₀L w₀ * cosetRep u₀ ∈ H_EL then
            t.coeff • (t.χ (e_EL ⟨(cosetRep u₀)⁻¹ * ι_L₀L w₀ * cosetRep u₀, hc₀⟩) : Ω F)
          else 0
        let l_t : X →₀ Ω F :=
          ∑ u₀ : G_L ⧸ H_EL,
            Finsupp.single (conjWeilChar F hGal (cosetRep u₀) χK) (c u₀)
        refine ⟨l_t, ?_, ?_⟩
        · intro w
          rw [@h_frob_trace L (t.restrict F hLL₀) (ι_L₀L w₀ * ι_KL w) fFin_EL]
          dsimp only [l_t]
          rw [map_sum, Finset.sum_apply]
          apply Finset.sum_congr rfl
          intro u₀ _
          rw [Finsupp.linearCombination_single, Pi.smul_apply, smul_eq_mul]
          let s : G_L := cosetRep u₀
          have hw_s : s⁻¹ * ι_KL w * s ∈ H_EL := by
            change ((s⁻¹ * ι_KL w * s : G_L) : AbsGal F) ∈ relWeil F E
            have h_eq : ((s⁻¹ * ι_KL w * s : G_L) : AbsGal F) =
                (conjWeilElt F hGal s⁻¹ w : AbsGal F) := rfl
            rw [h_eq]
            exact relWeil_antitone F htK (conjWeilElt F hGal s⁻¹ w).2
          have h_mul_eq : s⁻¹ * (ι_L₀L w₀ * ι_KL w) * s =
              (s⁻¹ * ι_L₀L w₀ * s) * (s⁻¹ * ι_KL w * s) := by
            group
          have h_mem_iff : s⁻¹ * (ι_L₀L w₀ * ι_KL w) * s ∈ H_EL ↔ s⁻¹ * ι_L₀L w₀ * s ∈ H_EL := by
            rw [h_mul_eq]
            exact Subgroup.mul_mem_cancel_right H_EL hw_s
          have h_char_eq : (t.χ (e_EL ⟨s⁻¹ * ι_KL w * s, hw_s⟩) : Ω F) =
              v (conjWeilChar F hGal s χK) w := by
            dsimp only [v]
            rw [← htχ]
            have hm : e_EL ⟨s⁻¹ * ι_KL w * s, hw_s⟩ =
                Subgroup.inclusion (relWeil_antitone F htK) (conjWeilElt F hGal s⁻¹ w) := by
              ext
              rfl
            exact congrArg (fun x => (t.χ x : Ω F)) hm
          change c u₀ * v (conjWeilChar F hGal s χK) w =
            if hc : s⁻¹ * (ι_L₀L w₀ * ι_KL w) * s ∈ H_EL then
              t.coeff • (t.χ (e_EL ⟨s⁻¹ * (ι_L₀L w₀ * ι_KL w) * s, hc⟩) : Ω F)
            else 0
          by_cases hc₀ : s⁻¹ * ι_L₀L w₀ * s ∈ H_EL
          · have hc : s⁻¹ * (ι_L₀L w₀ * ι_KL w) * s ∈ H_EL := h_mem_iff.mpr hc₀
            have hc_def : c u₀ = t.coeff • (t.χ (e_EL ⟨s⁻¹ * ι_L₀L w₀ * s, hc₀⟩) : Ω F) := dif_pos hc₀
            rw [hc_def, dif_pos hc]
            have h_sub_mul : (⟨s⁻¹ * (ι_L₀L w₀ * ι_KL w) * s, hc⟩ : H_EL) =
                ⟨s⁻¹ * ι_L₀L w₀ * s, hc₀⟩ * ⟨s⁻¹ * ι_KL w * s, hw_s⟩ := by
              apply Subtype.ext
              exact h_mul_eq
            rw [h_sub_mul, map_mul, map_mul, Units.val_mul, ← h_char_eq, zsmul_eq_mul, zsmul_eq_mul, mul_assoc]
          · have hc : s⁻¹ * (ι_L₀L w₀ * ι_KL w) * s ∉ H_EL := fun h => hc₀ (h_mem_iff.mp h)
            have hc_def : c u₀ = 0 := dif_neg hc₀
            rw [hc_def, dif_neg hc, zero_mul]
        · rw [@h_frob_trace L₀ t w₀ fFin_EL₀]
          dsimp only [l_t]
          rw [Finsupp.finset_sum_apply]
          have h_single_eq : ∀ u₀ : G_L ⧸ H_EL,
              (Finsupp.single (conjWeilChar F hGal (cosetRep u₀) χK) (c u₀)) χK =
                if (cosetRep u₀).1 ∈ relWeil F L₀ then c u₀ else 0 := by
            intro u₀
            rw [Finsupp.single_apply]
            have h_iff : (conjWeilChar F hGal (cosetRep u₀) χK = χK) ↔
                ((cosetRep u₀).1 ∈ relWeil F L₀) := hStab (cosetRep u₀)
            by_cases hL₀ : (cosetRep u₀).1 ∈ relWeil F L₀
            · rw [if_pos (h_iff.mpr hL₀), if_pos hL₀]
            · rw [if_neg (fun h => hL₀ (h_iff.mp h)), if_neg hL₀]
          have h_sum_single :
              (∑ u₀ : G_L ⧸ H_EL,
                (Finsupp.single (conjWeilChar F hGal (cosetRep u₀) χK) (c u₀)) χK) =
              ∑ u₀ ∈ Finset.univ.filter (fun u₀ : G_L ⧸ H_EL => (cosetRep u₀).1 ∈ relWeil F L₀), c u₀ := by
            rw [Finset.sum_filter]
            exact Finset.sum_congr rfl fun u₀ _ => h_single_eq u₀
          rw [h_sum_single]
          symm
          let S_stab : Finset (G_L ⧸ H_EL) :=
            Finset.univ.filter (fun u₀ : G_L ⧸ H_EL => (cosetRep u₀).1 ∈ relWeil F L₀)
          let i_map : ∀ v₀ ∈ (Finset.univ : Finset (G_L₀ ⧸ H_EL₀)), G_L ⧸ H_EL :=
            fun v₀ _ => QuotientGroup.mk (ι_L₀L (cosetRep v₀))
          let j_map : ∀ u₀ ∈ S_stab, G_L₀ ⧸ H_EL₀ :=
            fun u₀ hu₀ => QuotientGroup.mk ⟨(cosetRep u₀).1, (Finset.mem_filter.mp hu₀).2⟩
          have hi_mem : ∀ v₀ (hv₀ : v₀ ∈ (Finset.univ : Finset (G_L₀ ⧸ H_EL₀))),
              i_map v₀ hv₀ ∈ S_stab := by
            intro v₀ hv₀
            rw [Finset.mem_filter]
            refine ⟨Finset.mem_univ _, ?_⟩
            have hout : (QuotientGroup.mk (cosetRep (i_map v₀ hv₀)) : G_L ⧸ H_EL) =
                QuotientGroup.mk (ι_L₀L (cosetRep v₀)) := Quotient.out_eq (i_map v₀ hv₀)
            have hrel : (ι_L₀L (cosetRep v₀))⁻¹ * cosetRep (i_map v₀ hv₀) ∈ H_EL :=
              QuotientGroup.eq.mp hout.symm
            have hrel_L₀ : (((ι_L₀L (cosetRep v₀))⁻¹ * cosetRep (i_map v₀ hv₀) : G_L) : AbsGal F) ∈
                relWeil F L₀ :=
              relWeil_antitone F t.le hrel
            have h1 : ((ι_L₀L (cosetRep v₀) : G_L) : AbsGal F) ∈ relWeil F L₀ := (cosetRep v₀).2
            have h_prod := (relWeil F L₀).mul_mem h1 hrel_L₀
            change (cosetRep v₀).1 *
              ((cosetRep v₀).1⁻¹ * (cosetRep (i_map v₀ hv₀)).1) ∈ relWeil F L₀ at h_prod
            rwa [mul_inv_cancel_left] at h_prod
          have hj_mem : ∀ u₀ (hu₀ : u₀ ∈ S_stab), j_map u₀ hu₀ ∈ (Finset.univ : Finset (G_L₀ ⧸ H_EL₀)) :=
            fun _ _ => Finset.mem_univ _
          refine Finset.sum_bij' i_map j_map hi_mem hj_mem ?_ ?_ ?_
          · intro v₀ hv₀
            dsimp only [j_map]
            refine Eq.trans (QuotientGroup.eq.mpr ?_) (Quotient.out_eq v₀)
            have hout_i : (QuotientGroup.mk (cosetRep (i_map v₀ hv₀)) : G_L ⧸ H_EL) =
                QuotientGroup.mk (ι_L₀L (cosetRep v₀)) := Quotient.out_eq (i_map v₀ hv₀)
            have h_mem_i : (cosetRep (i_map v₀ hv₀))⁻¹ * ι_L₀L (cosetRep v₀) ∈ H_EL :=
              QuotientGroup.eq.mp hout_i
            exact h_mem_i
          · intro u₀ hu₀
            dsimp only [i_map]
            refine Eq.trans (QuotientGroup.eq.mpr ?_) (Quotient.out_eq u₀)
            let g₀ : G_L₀ := ⟨(cosetRep u₀).1, (Finset.mem_filter.mp hu₀).2⟩
            have hout_j : (QuotientGroup.mk (cosetRep (j_map u₀ hu₀)) : G_L₀ ⧸ H_EL₀) =
                QuotientGroup.mk g₀ := Quotient.out_eq (j_map u₀ hu₀)
            have h_mem_j : (cosetRep (j_map u₀ hu₀))⁻¹ * g₀ ∈ H_EL₀ :=
              QuotientGroup.eq.mp hout_j
            exact h_mem_j
          · intro v₀ hv₀
            let s₀ : G_L₀ := cosetRep v₀
            let s : G_L := cosetRep (i_map v₀ hv₀)
            have hout : (QuotientGroup.mk s : G_L ⧸ H_EL) = QuotientGroup.mk (ι_L₀L s₀) :=
              Quotient.out_eq (i_map v₀ hv₀)
            have hrel : (ι_L₀L s₀)⁻¹ * s ∈ H_EL := QuotientGroup.eq.mp hout.symm
            let h_sub : H_EL := ⟨(ι_L₀L s₀)⁻¹ * s, hrel⟩
            let z₀ : G_L₀ := s₀⁻¹ * w₀ * s₀
            let z : G_L := s⁻¹ * ι_L₀L w₀ * s
            have hz_conj : z = h_sub.1⁻¹ * ι_L₀L z₀ * h_sub.1 := by
              apply Subtype.ext
              change (s : AbsGal F)⁻¹ * (w₀ : AbsGal F) * (s : AbsGal F) =
                ((s₀ : AbsGal F)⁻¹ * (s : AbsGal F))⁻¹ *
                  ((s₀ : AbsGal F)⁻¹ * (w₀ : AbsGal F) * (s₀ : AbsGal F)) *
                  ((s₀ : AbsGal F)⁻¹ * (s : AbsGal F))
              group
            have hz_iff : z₀ ∈ H_EL₀ ↔ z ∈ H_EL := by
              have h1 : z₀ ∈ H_EL₀ ↔ ι_L₀L z₀ ∈ H_EL := Iff.rfl
              rw [h1, hz_conj]
              have h2 : h_sub.1⁻¹ * ι_L₀L z₀ * h_sub.1 ∈ H_EL ↔
                  h_sub.1⁻¹ * ι_L₀L z₀ ∈ H_EL := Subgroup.mul_mem_cancel_right H_EL h_sub.2
              have h3 : h_sub.1⁻¹ * ι_L₀L z₀ ∈ H_EL ↔ ι_L₀L z₀ ∈ H_EL :=
                Subgroup.mul_mem_cancel_left H_EL (H_EL.inv_mem h_sub.2)
              exact (h2.trans h3).symm
            dsimp only [c]
            change (if hc₀ : z₀ ∈ H_EL₀ then t.coeff • (t.χ (e_EL₀ ⟨z₀, hc₀⟩) : Ω F) else 0) =
              (if hc : z ∈ H_EL then t.coeff • (t.χ (e_EL ⟨z, hc⟩) : Ω F) else 0)
            by_cases hc₀ : z₀ ∈ H_EL₀
            · have hc : z ∈ H_EL := hz_iff.mp hc₀
              rw [dif_pos hc₀, dif_pos hc]
              congr 1
              congr 1
              have h_e_eq : e_EL ⟨z, hc⟩ = (e_EL h_sub)⁻¹ * e_EL₀ ⟨z₀, hc₀⟩ * e_EL h_sub := by
                apply Subtype.ext
                change (z : AbsGal F) =
                  ((h_sub.1 : G_L) : AbsGal F)⁻¹ * (z₀ : AbsGal F) * ((h_sub.1 : G_L) : AbsGal F)
                exact congrArg Subtype.val hz_conj
              rw [h_e_eq, map_mul, map_mul, map_inv, mul_comm (t.χ (e_EL h_sub))⁻¹,
                inv_mul_cancel_right]
            · have hc : z ∉ H_EL := fun h => hc₀ (hz_iff.mpr h)
              rw [dif_neg hc₀, dif_neg hc]
      have hlist_finsupp : ∀ (w₀ : relWeil F L₀) (L_sub : List (MonomialTerm F L₀)),
          (∀ t ∈ L_sub, t.Wf F L₀) →
          (∀ t ∈ L_sub, (t.restrict F hLL₀).Wf F L) →
          (∀ t ∈ L_sub, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = χK) →
          ∃ L_fin : X →₀ Ω F,
            (∀ w : relWeil F K,
              Finsupp.linearCombination (Ω F) v L_fin w =
                monomialListTrace F L (L_sub.map (MonomialTerm.restrict F hLL₀))
                  (ι_L₀L w₀ * ι_KL w)) ∧
            L_fin χK = monomialListTrace F L₀ L_sub w₀ := by
        intro w₀ L_sub
        induction L_sub with
        | nil =>
          intro _ _ _
          refine ⟨0, ?_, ?_⟩
          · intro w
            simp [monomialListTrace]
          · simp [monomialListTrace]
        | cons t tl ih =>
          intro hWf hWfL hχ
          obtain ⟨l_t, hl_t_tr, hl_t_χK⟩ :=
            hterm_finsupp w₀ t (hWf t List.mem_cons_self)
              (hWfL t List.mem_cons_self) (hχ t List.mem_cons_self)
          obtain ⟨L_tl, hL_tl_tr, hL_tl_χK⟩ :=
            ih (fun s hs => hWf s (List.mem_cons_of_mem t hs))
               (fun s hs => hWfL s (List.mem_cons_of_mem t hs))
               (fun s hs => hχ s (List.mem_cons_of_mem t hs))
          refine ⟨l_t + L_tl, ?_, ?_⟩
          · intro w
            simp only [map_add, Pi.add_apply, hl_t_tr w, hL_tl_tr w,
              monomialListTrace, List.map_cons, List.sum_cons]
          · simp only [Finsupp.add_apply, hl_t_χK, hL_tl_χK,
              monomialListTrace, List.map_cons, List.sum_cons]
      have hD₀_decomp : IsMonomialDecomp F L₀ 0 D₀ := by
        refine ⟨hD₀_Wf, ?_⟩
        intro w₀
        change (0 : Ω F) = monomialListTrace F L₀ D₀ w₀
        obtain ⟨L_fin, hL_fin_tr, hL_fin_χK⟩ :=
          hlist_finsupp w₀ D₀ hD₀_Wf hD₀_WfL hD₀_χ
        have h_comb_zero : Finsupp.linearCombination (Ω F) v L_fin = 0 := by
          ext w
          rw [Pi.zero_apply, hL_fin_tr w, ← hD₁_eq, ← hD₁.1.2 (ι_L₀L w₀ * ι_KL w), Pi.zero_apply]
        have hL_fin_zero : L_fin = 0 :=
          linearIndependent_iff.mp h_lin_indep L_fin h_comb_zero
        rw [← hL_fin_χK, hL_fin_zero, Finsupp.zero_apply]
      exact ⟨L₀, hLL₀, hL₀K, D₀, hGal₀, hSep₀, hlt, hD₁_eq, hD₀_decomp, hD₀_K⟩

theorem ld_ch17_orbit_reduction (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_cand : IsCandidateLambdaOn F rec L K hLK ψ f)
    (hHom : ∀ (χK : relWeil F K →* (Ω F)ˣ),
      IsInvariantWeilChar F L K χK →
      ∀ (D₀ : List (MonomialTerm F L)),
        IsHomogeneousDecompOn F L K χK D₀ →
        evalMonomialList F rec (fun _ E _ => f E) L ψ D₀ = 1) :
    IsLambdaFuncOn F rec L K ψ f :=
by
  have hconj_one : ∀ (χ : relWeil F K →* (Ω F)ˣ),
      conjWeilChar F hGal 1 χ = χ := by
    intro χ
    ext w
    change (χ (conjWeilElt F hGal (1 : relWeil F L)⁻¹ w) : Ω F) = χ w
    have h1 : conjWeilElt F hGal (1 : relWeil F L)⁻¹ w = w := by
      ext
      simp [conjWeilElt]
    rw [h1]
  have hconj_mul : ∀ (g₁ g₂ : relWeil F L) (χ : relWeil F K →* (Ω F)ˣ),
      conjWeilChar F hGal (g₁ * g₂) χ =
        conjWeilChar F hGal g₁ (conjWeilChar F hGal g₂ χ) := by
    intro g₁ g₂ χ
    ext w
    change (χ (conjWeilElt F hGal (g₁ * g₂)⁻¹ w) : Ω F) =
      (χ (conjWeilElt F hGal g₂⁻¹ (conjWeilElt F hGal g₁⁻¹ w)) : Ω F)
    have hm : conjWeilElt F hGal (g₁ * g₂)⁻¹ w =
        conjWeilElt F hGal g₂⁻¹ (conjWeilElt F hGal g₁⁻¹ w) := by
      ext
      simp [conjWeilElt, mul_assoc]
    rw [hm]
  have heval_filter : ∀ (D : List (MonomialTerm F L)) (b : MonomialTerm F L → Bool),
      evalMonomialList F rec (fun _ E _ => f E) L ψ D =
        evalMonomialList F rec (fun _ E _ => f E) L ψ (D.filter b) *
          evalMonomialList F rec (fun _ E _ => f E) L ψ (D.filter (fun t => !b t)) := by
    intro D b
    induction D with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      simp only [evalMonomialList] at ih
      cases hb : b t <;>
        simp [evalMonomialList, List.filter_cons, hb, ih, mul_assoc, mul_left_comm, mul_comm]
  have h_align_list : ∀ (χ₀ : relWeil F K →* (Ω F)ˣ) (L_orb : List (MonomialTerm F L)),
      (∀ t ∈ L_orb, t.Wf F L) →
      (∀ t ∈ L_orb, t.field ≤ K) →
      (∀ t ∈ L_orb, ∃ g : relWeil F L, conjWeilChar F hGal g (termWeilCharOn F L K t) = χ₀) →
      ∃ D₁ : List (MonomialTerm F L),
        (∀ t' ∈ D₁, t'.Wf F L) ∧
        (∀ w : relWeil F L, monomialListTrace F L D₁ w = monomialListTrace F L L_orb w) ∧
        evalMonomialList F rec (fun _ E _ => f E) L ψ D₁ =
          evalMonomialList F rec (fun _ E _ => f E) L ψ L_orb ∧
        (∀ t' ∈ D₁, ∃ ht'K : t'.field ≤ K, restrictWeilChar F ht'K t'.χ = χ₀) := by
    intro χ₀ L_orb
    induction L_orb with
    | nil =>
      intro _ _ _
      exact ⟨[], by simp, fun _ => rfl, rfl, by simp⟩
    | cons t tl ih =>
      intro hWf hK horb
      have htWf : t.Wf F L := hWf t (by simp)
      have htK : t.field ≤ K := hK t (by simp)
      obtain ⟨g, hg⟩ := horb t (by simp)
      have hterm_eq : termWeilCharOn F L K t = restrictWeilChar F htK t.χ := dif_pos htK
      rw [hterm_eq] at hg
      obtain ⟨t', ht'Wf, ht'tr, ht'eval, ht'K, ht'χ⟩ :=
        ld_ch17_conj_monomial_term F rec L K hLK hGal ψ hψ f hf_cand t htWf htK g
      rw [hg] at ht'χ
      obtain ⟨D_tl, hD_tl_Wf, hD_tl_tr, hD_tl_eval, hD_tl_K⟩ :=
        ih (fun s hs => hWf s (by simp [hs]))
           (fun s hs => hK s (by simp [hs]))
           (fun s hs => horb s (by simp [hs]))
      refine ⟨t' :: D_tl, ?_, ?_, ?_, ?_⟩
      · intro s hs
        rw [List.mem_cons] at hs
        rcases hs with rfl | hs
        · exact ht'Wf
        · exact hD_tl_Wf s hs
      · intro w
        have htr_w := hD_tl_tr w
        simp only [monomialListTrace, List.map_cons, List.sum_cons] at htr_w ⊢
        rw [ht'tr w, htr_w]
      · simp only [evalMonomialList, List.map_cons, List.prod_cons] at hD_tl_eval ⊢
        rw [ht'eval, hD_tl_eval]
      · intro s hs
        rw [List.mem_cons] at hs
        rcases hs with rfl | hs
        · exact ⟨ht'K, ht'χ⟩
        · exact hD_tl_K s hs
  have htrace_trans_aux : ∀ (K₀ L₀ M E : Type u) [Field K₀] [Field L₀] [Field M] [Field E]
      [Algebra K₀ L₀] [Algebra K₀ M] [Algebra K₀ E]
      (algLM : Algebra L₀ M) (algME : Algebra M E) (algLE : Algebra L₀ E)
      (h1 : ∀ x : K₀, @algebraMap L₀ M _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M x)
      (h2 : ∀ x : L₀, @algebraMap M E _ _ algME (@algebraMap L₀ M _ _ algLM x) =
        @algebraMap L₀ E _ _ algLE x)
      [FiniteDimensional K₀ M] (z : E),
      @Algebra.trace L₀ E _ _ algLE z =
        @Algebra.trace L₀ M _ _ algLM (@Algebra.trace M E _ _ algME z) := by
    intro K₀ L₀ M E _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L₀ M := algLM
    letI : Algebra M E := algME
    letI : Algebra L₀ E := algLE
    haveI : IsScalarTower K₀ L₀ M := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L₀ M E := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L₀ M := Module.Finite.of_restrictScalars_finite K₀ L₀ M
    by_cases hFin : FiniteDimensional M E
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M E = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L₀ E = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L₀ E := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L₀ M E)
      simp [htr1, htr2]
  have htrace_eq_inclusion : ∀ {L₀ M : IntermediateField F (AlgebraicClosure F)}
      (h : L₀ ≤ M) (y : M),
      @Algebra.trace L₀ M _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
    intro L₀ M h y
    letI : Algebra L₀ M := (IntermediateField.inclusion h).toAlgebra
    let e : M ≃ₐ[L₀] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm
  have htrace_trans : ∀ (L₀ M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (h : L₀ ≤ M) (h' : M ≤ E) (z : E),
      traceLM F (h.trans h') z = traceLM F h (traceLM F h' z) := by
    intro L₀ M E _ h h' z
    rw [← htrace_eq_inclusion (h.trans h') z,
        ← htrace_eq_inclusion h' z,
        ← htrace_eq_inclusion h]
    exact htrace_trans_aux F L₀ M E
      (IntermediateField.inclusion h).toAlgebra
      (IntermediateField.inclusion h').toAlgebra
      (IntermediateField.inclusion (h.trans h')).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z
  have htraceChar_trans : ∀ (M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (h₁ : L ≤ M) (h₂ : M ≤ E),
      traceChar F (h₁.trans h₂) ψ = traceChar F h₂ (traceChar F h₁ ψ) := by
    intro M E _ h₁ h₂
    ext z
    simp [traceChar, htrace_trans L M E h₁ h₂ z]
  have heval_restrict_f : ∀ (L₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L₀]
      (hLL₀ : L ≤ L₀) (hL₀K : L₀ ≤ K),
      Algebra.IsSeparable L (IntermediateField.extendScalars hLL₀) →
      Module.finrank L₀ (IntermediateField.extendScalars hL₀K) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      ∀ (D₀ : List (MonomialTerm F L₀)),
        (∀ t ∈ D₀, t.Wf F L₀) →
        (∀ t ∈ D₀, t.field ≤ K) →
        evalMonomialList F rec (fun _ E _ => f E) L ψ (D₀.map (MonomialTerm.restrict F hLL₀)) =
          evalMonomialList F rec
              (fun _ E _ => galoisLam F rec L₀ K (traceChar F hLL₀ ψ) E)
              L₀ (traceChar F hLL₀ ψ) D₀ *
            (f L₀) ^ (monomialListDeg F L₀ D₀) := by
    intro L₀ _ hLL₀ hL₀K hSep₀ hlt D₀ hWf₀ hK₀
    induction D₀ with
    | nil =>
      simp [evalMonomialList, monomialListDeg]
    | cons t tl ih =>
      have htWf : t.Wf F L₀ := hWf₀ t (by simp)
      have htK : t.field ≤ K := hK₀ t (by simp)
      have htlWf : ∀ t' ∈ tl, t'.Wf F L₀ := fun t' ht' => hWf₀ t' (by simp [ht'])
      have htlK : ∀ t' ∈ tl, t'.field ≤ K := fun t' ht' => hK₀ t' (by simp [ht'])
      have htr_eq : traceChar F (hLL₀.trans t.le) ψ = traceChar F t.le (traceChar F hLL₀ ψ) :=
        htraceChar_trans L₀ t.field hLL₀ t.le
      have hf_eq : f t.field =
          galoisLam F rec L₀ K (traceChar F hLL₀ ψ) t.field *
            (f L₀) ^ (Module.finrank L₀ (IntermediateField.extendScalars t.le)) :=
        hf_cand.2.2.2 L₀ t.field hLL₀ t.le hL₀K htK hSep₀ htWf.2.1 hlt
      have hterm : evalMonomialTerm F rec (fun _ E _ => f E) L ψ (t.restrict F hLL₀) =
          evalMonomialTerm F rec
              (fun _ E _ => galoisLam F rec L₀ K (traceChar F hLL₀ ψ) E)
              L₀ (traceChar F hLL₀ ψ) t *
            (f L₀) ^ (t.deg F L₀) := by
        simp only [evalMonomialTerm, MonomialTerm.restrict, MonomialTerm.deg]
        rw [htr_eq, hf_eq, ← mul_assoc, mul_zpow, ← zpow_natCast, ← zpow_mul,
          mul_comm (Module.finrank L₀ (IntermediateField.extendScalars t.le) : ℤ) t.coeff]
      simp only [evalMonomialList, monomialListDeg, List.map_cons, List.prod_cons, List.sum_cons] at ih ⊢
      rw [hterm, ih htlWf htlK, zpow_add]
      ac_rfl
  refine ⟨hf_cand.1, ?_⟩
  have hMain : ∀ (n : ℕ) (D : List (MonomialTerm F L)),
      D.length = n →
      IsMonomialDecomp F L 0 D →
      (∀ t ∈ D, t.field ≤ K) →
      evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1 := by
    intro n
    induction' n using Nat.strong_induction_on with n ih
    intro D hlen hD hDK
    cases D with
    | nil =>
      simp [evalMonomialList]
    | cons t₀ tl =>
      let χ₀ : relWeil F K →* (Ω F)ˣ := termWeilCharOn F L K t₀
      let P : (relWeil F K →* (Ω F)ˣ) → Prop :=
        fun χ => ∃ g : relWeil F L, conjWeilChar F hGal g χ = χ₀
      have hP : ∀ (g : relWeil F L) (χ : relWeil F K →* (Ω F)ˣ),
          P (conjWeilChar F hGal g χ) ↔ P χ := by
        intro g χ
        constructor
        · rintro ⟨g', hg'⟩
          exact ⟨g' * g, by rw [hconj_mul, hg']⟩
        · rintro ⟨g', hg'⟩
          exact ⟨g' * g⁻¹, by rw [← hconj_mul, mul_assoc, inv_mul_cancel, mul_one, hg']⟩
      have hnotP : ∀ (g : relWeil F L) (χ : relWeil F K →* (Ω F)ˣ),
          (¬ P (conjWeilChar F hGal g χ)) ↔ ¬ P χ :=
        fun g χ => not_congr (hP g χ)
      set b : MonomialTerm F L → Bool := fun t => decide (P (termWeilCharOn F L K t))
      set D_orb := (t₀ :: tl).filter b
      set D_rest := (t₀ :: tl).filter (fun t => !b t)
      have hD_orb : IsMonomialDecomp F L 0 D_orb :=
        ld_ch17_orbit_partition_trace_zero F L K hLK hGal (t₀ :: tl) hD hDK P hP
      have hD_rest_eq : D_rest =
          (t₀ :: tl).filter (fun t => decide (¬ P (termWeilCharOn F L K t))) := by
        have hfun : (fun t => !b t) = (fun t => decide (¬ P (termWeilCharOn F L K t))) := by
          ext t
          simp [b, decide_not]
        simp only [D_rest, hfun]
      have hD_rest : IsMonomialDecomp F L 0 D_rest := by
        rw [hD_rest_eq]
        exact ld_ch17_orbit_partition_trace_zero F L K hLK hGal (t₀ :: tl) hD hDK
          (fun χ => ¬ P χ) hnotP
      have hPt₀ : P (termWeilCharOn F L K t₀) := ⟨1, hconj_one χ₀⟩
      have hbt₀ : b t₀ = true := decide_eq_true hPt₀
      have hD_rest_tl : D_rest = tl.filter (fun t => !b t) := by
        simp [D_rest, List.filter_cons, hbt₀]
      have hlen_lt : D_rest.length < n := by
        rw [← hlen, hD_rest_tl, List.length_cons]
        exact Nat.lt_succ_of_le (List.length_filter_le _ tl)
      have hD_rest_K : ∀ t ∈ D_rest, t.field ≤ K := by
        intro t ht
        exact hDK t (List.mem_of_mem_filter ht)
      have heval_rest : evalMonomialList F rec (fun _ E _ => f E) L ψ D_rest = 1 :=
        ih D_rest.length hlen_lt D_rest rfl hD_rest hD_rest_K
      have hD_orb_Wf : ∀ t ∈ D_orb, t.Wf F L := hD_orb.1
      have hD_orb_K : ∀ t ∈ D_orb, t.field ≤ K :=
        fun t ht => hDK t (List.mem_of_mem_filter ht)
      have hD_orb_P : ∀ t ∈ D_orb,
          ∃ g : relWeil F L, conjWeilChar F hGal g (termWeilCharOn F L K t) = χ₀ := by
        intro t ht
        have hbt : b t = true := (List.mem_filter.mp ht).2
        exact of_decide_eq_true hbt
      obtain ⟨D₁, hD₁_Wf, hD₁_tr, hD₁_eval, hD₁_K⟩ :=
        h_align_list χ₀ D_orb hD_orb_Wf hD_orb_K hD_orb_P
      have hD₁_hom : IsHomogeneousDecompOn F L K χ₀ D₁ := by
        refine ⟨⟨hD₁_Wf, ?_⟩, hD₁_K⟩
        intro w
        rw [hD₁_tr w]
        exact hD_orb.2 w
      have heval_D₁ : evalMonomialList F rec (fun _ E _ => f E) L ψ D₁ = 1 := by
        rcases ld_ch17_stabilizer_isotypic_descent F L K hLK hGal χ₀ D₁ hD₁_hom with
          rfl | hInv | ⟨L₀, hLL₀, hL₀K, D₀, hGal₀, hSep₀, hlt, rfl, hD₀, hD₀K⟩
        · simp [evalMonomialList]
        · exact hHom χ₀ hInv D₁ hD₁_hom
        · haveI : FiniteDimensional F K := hGal.2.1
          haveI : FiniteDimensional F L₀ :=
            Module.Finite.of_injective (IntermediateField.inclusion hL₀K).toLinearMap
              (IntermediateField.inclusion hL₀K).injective
          have hψ₀ : IsAdmissibleChar F L₀ (traceChar F hLL₀ ψ) :=
            ld_traceChar_admissible F L L₀ hLL₀ hSep₀ ψ hψ
          let V₀ : Type u := (⊥ : Submodule (Ω F) (ULift.{u} (Ω F)))
          let σ₀ : Representation (Ω F) (relWeil F L₀) V₀ := 1
          have hσ₀_weil : IsWeilRep F L₀ σ₀ :=
            ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
          have hD₀_σ₀ : IsMonomialDecomp F L₀
              (fun w => LinearMap.trace (Ω F) V₀ (σ₀ w)) D₀ := by
            refine ⟨hD₀.1, ?_⟩
            intro w
            dsimp only
            have htr0 : LinearMap.trace (Ω F) V₀ (σ₀ w) = 0 := by
              have hsub : Subsingleton (V₀ →ₗ[Ω F] V₀) := inferInstance
              rw [Subsingleton.elim (σ₀ w) 0, map_zero]
            rw [htr0]
            exact hD₀.2 w
          have hdeg₀ : monomialListDeg F L₀ D₀ = 0 := by
            rw [ld_monomial_deg_eq_finrank F L₀ σ₀ hσ₀_weil D₀ hD₀_σ₀]
            have hfin0 : Module.finrank (Ω F) V₀ = 0 :=
              Module.finrank_zero_of_subsingleton
            rw [hfin0, Nat.cast_zero]
          have hlam₀ : evalMonomialList F rec
              (fun _ E _ => galoisLam F rec L₀ K (traceChar F hLL₀ ψ) E)
              L₀ (traceChar F hLL₀ ψ) D₀ = 1 :=
            (hTheory.1 L₀ K hL₀K hGal₀ hlt (traceChar F hLL₀ ψ) hψ₀).2 D₀ hD₀ hD₀K
          rw [heval_restrict_f L₀ hLL₀ hL₀K hSep₀ hlt D₀ hD₀.1 hD₀K,
            hlam₀, hdeg₀, zpow_zero, mul_one]
      rw [heval_filter (t₀ :: tl) b, ← hD₁_eval, heval_D₁, heval_rest, mul_one]
  intro D hD hDK
  exact hMain D.length D rfl hD hDK

theorem ld_lambda_system_exists (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F) :
    ∃ lam : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ,
      (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
        (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ → lam L L ψ = 1) ∧
      (∀ (L M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
        (h₁ : L ≤ M) (h₂ : M ≤ E),
        Algebra.IsSeparable L (IntermediateField.extendScalars h₁) →
        Algebra.IsSeparable M (IntermediateField.extendScalars h₂) →
        ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
          lam L E ψ =
            lam M E (traceChar F h₁ ψ) *
              (lam L M ψ) ^ (Module.finrank M (IntermediateField.extendScalars h₂))) ∧
      (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
        (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
        ∀ (D : List (MonomialTerm F L)),
          IsMonomialDecomp F L 0 D →
          evalMonomialList F rec lam L ψ D = 1) :=
by
  refine ⟨globalLam F rec, ?_⟩
  apply (ld_lambda_uniqueness_and_closure F rec).2
  have hAll : ∀ m : ℕ,
      ∀ (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
        IsGaloisExt F L K →
        Module.finrank L (IntermediateField.extendScalars hLK) = m →
        ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
          IsLambdaFuncOn F rec L K ψ (galoisLam F rec L K ψ) := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro L K hLK hGal hdeg ψ hψ
    have hBelow : LambdaExistsBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)) := by
      intro L' K' hLK' hGal' hlt ψ' hψ'
      rw [hdeg] at hlt
      exact ih _ hlt L' K' hLK' hGal' rfl ψ' hψ'
    have hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)) :=
      (ld_lambda_uniqueness_and_closure F rec).1 _ hBelow
    obtain ⟨f, hf_cand, hf_ext⟩ :=
      ld_ch16_and_19_1_candidate_lambda F rec L K hLK hGal ψ hψ hTheory
    have hf_lam : IsLambdaFuncOn F rec L K ψ f := by
      apply ld_ch17_orbit_reduction F rec L K hLK hGal ψ hψ hTheory f hf_cand
      intro χK hInv D₀ hD₀
      by_cases hext : ∃ χL : relWeil F L →* (Ω F)ˣ,
          IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK
      · exact hf_ext χK hext D₀ hD₀
      · exact ld_ch18_19_2_non_extended_inv_char F rec L K hLK hGal ψ hψ hTheory f hf_cand
          χK hInv hext D₀ hD₀
    exact Classical.epsilon_spec (⟨f, hf_lam⟩ : ∃ g, IsLambdaFuncOn F rec L K ψ g)
  intro n
  apply (ld_lambda_uniqueness_and_closure F rec).1 n
  intro L K hLK hGal hlt ψ hψ
  exact hAll _ L K hLK hGal rfl ψ hψ

theorem langlands_deligne (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F) :
    Nonempty (LocalConstants F rec) :=
by
  obtain ⟨lam, hlam_self, hlam_trans, hlam_zero⟩ := ld_lambda_system_exists F rec
  obtain ⟨htrace_exact, hchar_decomp, hind_decomp⟩ := ld_trace_exact_and_char F
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  have htrace_append : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (D₁ D₂ : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (D₁ ++ D₂) w =
        monomialListTrace F L D₁ w + monomialListTrace F L D₂ w := by
    intro L D₁ D₂ w
    simp [monomialListTrace, List.map_append, List.sum_append]
  have htrace_neg : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (D : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (D.map (MonomialTerm.neg F L)) w =
        - monomialListTrace F L D w := by
    intro L D w
    induction D with
    | nil => simp [monomialListTrace]
    | cons t tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F L).trace F L w = - (t.trace F L w) := by
        simp [MonomialTerm.neg, MonomialTerm.trace, neg_smul]
      rw [ht, ih]
      ring
  have heval_append : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (ψ : AddChar L (Ω F)) (D₁ D₂ : List (MonomialTerm F L)),
      evalMonomialList F rec lam L ψ (D₁ ++ D₂) =
        evalMonomialList F rec lam L ψ D₁ * evalMonomialList F rec lam L ψ D₂ := by
    intro L ψ D₁ D₂
    simp [evalMonomialList, List.map_append, List.prod_append]
  have heval_neg : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (ψ : AddChar L (Ω F)) (D : List (MonomialTerm F L)),
      evalMonomialList F rec lam L ψ (D.map (MonomialTerm.neg F L)) =
        (evalMonomialList F rec lam L ψ D)⁻¹ := by
    intro L ψ D
    induction D with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have ht : evalMonomialTerm F rec lam L ψ (t.neg F L) =
          (evalMonomialTerm F rec lam L ψ t)⁻¹ := by
        simp [MonomialTerm.neg, evalMonomialTerm, zpow_neg]
      rw [ht, ih, mul_inv]
  have heval_eq : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
      ∀ (tr : relWeil F L → Ω F) (D : List (MonomialTerm F L)),
        IsMonomialDecomp F L tr D →
        epsFromTrace F rec lam L tr ψ = evalMonomialList F rec lam L ψ D := by
    intro L _ ψ hψ tr D hD
    have hex : ∃ D' : List (MonomialTerm F L), IsMonomialDecomp F L tr D' := ⟨D, hD⟩
    have hdef : epsFromTrace F rec lam L tr ψ =
        evalMonomialList F rec lam L ψ hex.choose := dif_pos hex
    rw [hdef]
    set D₀ := hex.choose
    have hD₀ : IsMonomialDecomp F L tr D₀ := hex.choose_spec
    have hzero : IsMonomialDecomp F L 0 (D ++ D₀.map (MonomialTerm.neg F L)) := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rw [List.mem_append] at ht
        rcases ht with ht | ht
        · exact hD.1 t ht
        · rw [List.mem_map] at ht
          rcases ht with ⟨t₀, ht₀, rfl⟩
          exact hD₀.1 t₀ ht₀
      · intro w
        rw [Pi.zero_apply, htrace_append, htrace_neg, ← hD.2 w, ← hD₀.2 w, add_neg_cancel]
    have hprod := hlam_zero L ψ hψ (D ++ D₀.map (MonomialTerm.neg F L)) hzero
    rw [heval_append, heval_neg] at hprod
    exact (mul_inv_eq_one.mp hprod).symm
  have heval_restrict : ∀ (L M : IntermediateField F (AlgebraicClosure F))
      (h : L ≤ M), Algebra.IsSeparable L (IntermediateField.extendScalars h) →
      ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
      ∀ (D : List (MonomialTerm F M)),
        (∀ t ∈ D, t.Wf F M) →
        evalMonomialList F rec lam L ψ (D.map (MonomialTerm.restrict F h)) =
          evalMonomialList F rec lam M (traceChar F h ψ) D *
            (lam L M ψ) ^ (monomialListDeg F M D) := by
    intro L M h hSep ψ hψ D hWf
    induction D with
    | nil =>
      simp [evalMonomialList, monomialListDeg]
    | cons t tl ih =>
      have htWf : t.Wf F M := hWf t (by simp)
      have htlWf : ∀ t' ∈ tl, t'.Wf F M := fun t' ht' => hWf t' (by simp [ht'])
      haveI : FiniteDimensional F t.field := htWf.1
      have hSep_t : Algebra.IsSeparable M (IntermediateField.extendScalars t.le) := htWf.2.1
      haveI : FiniteDimensional F M := (htraceChar M t.field t.le hSep_t).1
      have htr_eq : traceChar F (h.trans t.le) ψ = traceChar F t.le (traceChar F h ψ) :=
        ((htraceChar L M h hSep).2 ψ hψ).2.2 t.field t.le
      have hlam_eq : lam L t.field ψ =
          lam M t.field (traceChar F h ψ) *
            (lam L M ψ) ^ (Module.finrank M (IntermediateField.extendScalars t.le)) :=
        hlam_trans L M t.field h t.le hSep hSep_t ψ hψ
      have hterm : evalMonomialTerm F rec lam L ψ (t.restrict F h) =
          evalMonomialTerm F rec lam M (traceChar F h ψ) t *
            (lam L M ψ) ^ (t.deg F M) := by
        simp only [evalMonomialTerm, MonomialTerm.restrict, MonomialTerm.deg]
        rw [htr_eq, hlam_eq, ← mul_assoc, mul_zpow, ← zpow_natCast, ← zpow_mul,
          mul_comm (Module.finrank M (IntermediateField.extendScalars t.le) : ℤ) t.coeff]
      simp only [evalMonomialList, monomialListDeg, List.map_cons, List.prod_cons, List.sum_cons] at ih ⊢
      rw [hterm, ih htlWf, zpow_add]
      ac_rfl
  refine ⟨{
    eps := fun L {V} _ _ σ ψ =>
      epsFromTrace F rec lam L (fun w => LinearMap.trace (Ω F) V (σ w)) ψ
    eps_exact := ?_
    eps_ind := ?_
    eps_char := ?_
  }⟩
  · intro L _ ψ hψ V₁ V V₂ _ _ _ _ _ _ σ₁ σ σ₂ hσ₁ hσ hσ₂ f g hf hg hinj hsurj hker
    obtain ⟨D₁, hD₁⟩ := ld_brauer_monomial_decomp F L σ₁ hσ₁
    obtain ⟨D₂, hD₂⟩ := ld_brauer_monomial_decomp F L σ₂ hσ₂
    have hD : IsMonomialDecomp F L (fun w => LinearMap.trace (Ω F) V (σ w)) (D₁ ++ D₂) := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rw [List.mem_append] at ht
        rcases ht with ht | ht
        · exact hD₁.1 t ht
        · exact hD₂.1 t ht
      · intro w
        dsimp only
        have h1 : LinearMap.trace (Ω F) V₁ (σ₁ w) = monomialListTrace F L D₁ w := hD₁.2 w
        have h2 : LinearMap.trace (Ω F) V₂ (σ₂ w) = monomialListTrace F L D₂ w := hD₂.2 w
        rw [htrace_exact L σ₁ σ σ₂ hσ₁ hσ hσ₂ f g hf hg hinj hsurj hker w,
          htrace_append, h1, h2]
    rw [heval_eq L ψ hψ _ (D₁ ++ D₂) hD, heval_eq L ψ hψ _ D₁ hD₁,
      heval_eq L ψ hψ _ D₂ hD₂, heval_append]
  · intro L M _ h hSep ψ hψ V₁ V₂ _ _ _ _ σ₁ σ₂ hσ₁ hσ₂ hdim
    haveI : FiniteDimensional F L := (htraceChar L M h hSep).1
    have hψM : IsAdmissibleChar F M (traceChar F h ψ) := ((htraceChar L M h hSep).2 ψ hψ).1
    obtain ⟨D₁, hD₁⟩ := ld_brauer_monomial_decomp F M σ₁ hσ₁
    obtain ⟨D₂, hD₂⟩ := ld_brauer_monomial_decomp F M σ₂ hσ₂
    have hind₁ := hind_decomp L M h hSep σ₁ hσ₁ D₁ hD₁
    have hind₂ := hind_decomp L M h hSep σ₂ hσ₂ D₂ hD₂
    rw [heval_eq L ψ hψ _ (D₁.map (MonomialTerm.restrict F h)) hind₁.1,
      heval_eq L ψ hψ _ (D₂.map (MonomialTerm.restrict F h)) hind₂.1,
      heval_eq M (traceChar F h ψ) hψM _ D₁ hD₁,
      heval_eq M (traceChar F h ψ) hψM _ D₂ hD₂,
      heval_restrict L M h hSep ψ hψ D₁ hD₁.1,
      heval_restrict L M h hSep ψ hψ D₂ hD₂.1,
      hind₁.2, hind₂.2, hdim]
    ac_rfl
  · intro L _ ψ hψ χ hχ χ' hχ'
    have hD := hchar_decomp L χ hχ
    have hSep_self : Algebra.IsSeparable L (IntermediateField.extendScalars (le_rfl : L ≤ L)) :=
      (hD.1 ⟨1, L, le_rfl, χ⟩ (by simp)).2.1
    rw [heval_eq L ψ hψ _ [⟨1, L, le_rfl, χ⟩] hD]
    simp only [evalMonomialList, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
      mul_one, evalMonomialTerm, zpow_one]
    have htr_self : traceChar F (le_rfl : L ≤ L) ψ = ψ :=
      ((htraceChar L L le_rfl hSep_self).2 ψ hψ).2.1
    rw [htr_self, hlam_self L ψ hψ, mul_one]
    exact (htateEps L ψ hψ χ hχ χ' hχ').2
