    have h_ker : (ι_M m)⁻¹ * x ∈ H_F' := by
      rw [← hπF'_eq_one, map_mul, map_inv]
      change (π_M m)⁻¹ * π_F' x = 1
      rw [hm, inv_mul_cancel]
    let y : G_F' := ⟨((ι_M m)⁻¹ * x : G_L).1, h_ker⟩
    refine ⟨m, y, ?_⟩
    apply Subtype.ext
    change (m : AbsGal F) * ((m : AbsGal F)⁻¹ * (x : AbsGal F)) = (x : AbsGal F)
    exact mul_inv_cancel_left (m : AbsGal F) (x : AbsGal F)
  choose h_M y_F' h_decomp using h_fact
  let H_M : Subgroup G_L := G_M.subgroupOf G_L
  let H_M'_F' : Subgroup G_F' := (relWeil F M').subgroupOf G_F'
  let W_V := ULift.{u} (Ω F)
  let e_M : H_M ≃* G_M := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLM)
  let e_M'_F' : H_M'_F' ≃* relWeil F M' :=
    Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hF'M')
  let χM' : relWeil F M' →* (Ω F)ˣ := restrictWeilChar F hMM' χM
  let ρ_M : Representation (Ω F) H_M W_V := (charRep F M χM).comp e_M.toMonoidHom
  let ρ_M' : Representation (Ω F) H_M'_F' W_V :=
    (charRep F M' χM').comp e_M'_F'.toMonoidHom
  have h_uniq_M' : ∀ (φ : indSpace H_M'_F' ρ_M') (m₁ m₂ : G_M) (y₁ y₂ : G_F'),
      ι_M m₁ * ι_F' y₁ = ι_M m₂ * ι_F' y₂ →
      (χM m₁ : Ω F) • φ.1 y₁ = (χM m₂ : Ω F) • φ.1 y₂ := by
    intro φ m₁ m₂ y₁ y₂ heq
    have heq_gal : (m₁ : AbsGal F) * (y₁ : AbsGal F) = (m₂ : AbsGal F) * (y₂ : AbsGal F) :=
      congrArg Subtype.val heq
    let δ_gal : AbsGal F := (m₂ : AbsGal F)⁻¹ * (m₁ : AbsGal F)
    have hδ_eq_y : δ_gal = (y₂ : AbsGal F) * (y₁ : AbsGal F)⁻¹ := by
      dsimp [δ_gal]
      calc (m₂ : AbsGal F)⁻¹ * (m₁ : AbsGal F)
          = (m₂ : AbsGal F)⁻¹ * ((m₁ : AbsGal F) * (y₁ : AbsGal F)) * (y₁ : AbsGal F)⁻¹ := by group
        _ = (m₂ : AbsGal F)⁻¹ * ((m₂ : AbsGal F) * (y₂ : AbsGal F)) * (y₁ : AbsGal F)⁻¹ := by
          rw [heq_gal]
        _ = (y₂ : AbsGal F) * (y₁ : AbsGal F)⁻¹ := by group
    have hδ_weil : δ_gal ∈ weilGroup F := (m₂⁻¹ * m₁).2.1
    have hδ_M : δ_gal ∈ M.fixingSubgroup := (m₂⁻¹ * m₁).2.2
    have hδ_F' : δ_gal ∈ F'.fixingSubgroup := by
      rw [hδ_eq_y]
      exact (y₂ * y₁⁻¹).2.2
    have hδ_M' : δ_gal ∈ M'.fixingSubgroup := by
      change δ_gal ∈ (M ⊔ F').fixingSubgroup
      rw [IntermediateField.fixingSubgroup_sup]
      exact ⟨hδ_M, hδ_F'⟩
    let δ_F' : G_F' := ⟨δ_gal, hδ_weil, hδ_F'⟩
    have hδ_mem : δ_F' ∈ H_M'_F' := ⟨hδ_weil, hδ_M'⟩
    let δ_sub : H_M'_F' := ⟨δ_F', hδ_mem⟩
    have hy₂_eq : y₂ = (δ_sub : G_F') * y₁ := by
      apply Subtype.ext
      change (y₂ : AbsGal F) = δ_gal * (y₁ : AbsGal F)
      rw [hδ_eq_y, inv_mul_cancel_right]
    have hm₁_eq : m₁ = m₂ * Subgroup.inclusion (relWeil_antitone F hMM') (e_M'_F' δ_sub) := by
      apply Subtype.ext
      change (m₁ : AbsGal F) = (m₂ : AbsGal F) * δ_gal
      dsimp [δ_gal]
      exact (mul_inv_cancel_left (m₂ : AbsGal F) (m₁ : AbsGal F)).symm
    have hφ_y₂ : φ.1 y₂ =
        (χM (Subgroup.inclusion (relWeil_antitone F hMM') (e_M'_F' δ_sub)) : Ω F) • φ.1 y₁ := by
      rw [hy₂_eq, φ.2 δ_sub y₁]
      rfl
    rw [hφ_y₂, smul_smul, ← Units.val_mul, ← map_mul, ← hm₁_eq]
  let Φ_ind : indSpace H_M ρ_M ≃ₗ[Ω F] indSpace H_M'_F' ρ_M' :=
    { toFun := fun f =>
        ⟨fun y => f.1 (ι_F' y), fun h' y => by
          have h_sub_mem : ι_F' (h' : G_F') ∈ H_M :=
            ⟨(h' : G_F').2.1, IntermediateField.fixingSubgroup_le hMM' h'.2.2⟩
          have h_eq := f.2 ⟨ι_F' (h' : G_F'), h_sub_mem⟩ (ι_F' y)
          change f.1 (ι_F' ((h' : G_F') * y)) = ρ_M' h' (f.1 (ι_F' y))
          rw [map_mul]
          exact h_eq⟩
      map_add' := fun _ _ => Subtype.ext (funext fun _ => rfl)
      map_smul' := fun _ _ => Subtype.ext (funext fun _ => rfl)
      invFun := fun φ =>
        ⟨fun x => (χM (h_M x) : Ω F) • φ.1 (y_F' x), fun h x => by
          dsimp only
          have h_eq : ι_M (h_M ((h : G_L) * x)) * ι_F' (y_F' ((h : G_L) * x)) =
              ι_M (e_M h * h_M x) * ι_F' (y_F' x) := by
            rw [h_decomp ((h : G_L) * x), map_mul, mul_assoc, h_decomp x]
            rfl
          have h_u := h_uniq_M' φ (h_M ((h : G_L) * x)) (e_M h * h_M x)
            (y_F' ((h : G_L) * x)) (y_F' x) h_eq
          rw [h_u, map_mul, Units.val_mul, mul_smul]
          rfl⟩
      left_inv := fun f => by
        apply Subtype.ext
        funext x
        dsimp only
        have h_sub : ι_M (h_M x) ∈ H_M := (h_M x).2
        have h_eq := f.2 ⟨ι_M (h_M x), h_sub⟩ (ι_F' (y_F' x))
        change (χM (h_M x) : Ω F) • f.1 (ι_F' (y_F' x)) = f.1 x
        have h_lhs : ρ_M ⟨ι_M (h_M x), h_sub⟩ (f.1 (ι_F' (y_F' x))) =
            (χM (h_M x) : Ω F) • f.1 (ι_F' (y_F' x)) := rfl
        rw [← h_lhs, ← h_eq, h_decomp x]
      right_inv := fun φ => by
        apply Subtype.ext
        funext y
        dsimp only
        have h_eq : ι_M (h_M (ι_F' y)) * ι_F' (y_F' (ι_F' y)) = ι_M 1 * ι_F' y := by
          rw [h_decomp (ι_F' y), map_one, one_mul]
        have h_u := h_uniq_M' φ (h_M (ι_F' y)) 1 (y_F' (ι_F' y)) y h_eq
        rw [h_u, map_one, Units.val_one, one_smul] }
  have hTr_t' : ∀ w : G_F',
      (⟨1, M, hLM, χM⟩ : MonomialTerm F L).trace F L (ι_F' w) =
      (⟨1, M', hF'M', χM'⟩ : MonomialTerm F F').trace F F' w := by
    intro w
    simp only [MonomialTerm.trace, one_smul]
    have h_conj : Φ_ind.conj (indLM F hLM (charRep F M χM) (ι_F' w)) =
        indLM F hF'M' (charRep F M' χM') w := by
      apply LinearMap.ext
      intro φ
      apply Subtype.ext
      funext y
      have h1 : ((Φ_ind.conj (indLM F hLM (charRep F M χM) (ι_F' w))) φ).1 y =
          (Φ_ind.symm φ).1 (ι_F' y * ι_F' w) := rfl
      have h2 : ((indLM F hF'M' (charRep F M' χM') w) φ).1 y = φ.1 (y * w) := rfl
      have h3 : (Φ_ind.symm φ).1 (ι_F' (y * w)) = (Φ_ind (Φ_ind.symm φ)).1 (y * w) := rfl
      rw [h1, h2, ← map_mul, h3, Φ_ind.apply_symm_apply]
    exact (LinearMap.trace_conj' (indLM F hLM (charRep F M χM) (ι_F' w)) Φ_ind).symm.trans
      (by rw [h_conj])
  let ν_M : G_M →* (Ω F)ˣ := restrictWeilChar F hLM ν₁
  have hν_M_eq : ν_M = bar_ν₁.comp π_M := rfl
  have hν_M_weil : IsWeilRep F M (charRep F M ν_M) := hWeil_rest hLM hν₁_weil
  have hν_M_restM' : restrictWeilChar F hMM' ν_M = 1 := by
    apply MonoidHom.ext
    intro w
    change restrictWeilChar F hLF' ν₁ (Subgroup.inclusion (relWeil_antitone F hF'M') w) = 1
    rw [hν₁_restF', MonoidHom.one_apply]
  let term_M : ℕ → MonomialTerm F M := fun j => ⟨1, M, le_rfl, ν_M ^ j⟩
  let D_M : List (MonomialTerm F M) := (List.range q₀).map term_M
  have h_term_wf : ∀ j : ℕ, (term_M j).Wf F M :=
    fun j => ⟨inferInstance, hSepMM, hWeil_pow M hν_M_weil j⟩
  have h_term_trace_M : ∀ (j : ℕ) (w : G_M),
      (term_M j).trace F M w = (ν_M w : Ω F) ^ j := by
    intro j w
    have h1 := ((ld_trace_exact_and_char F).2.1 M (ν_M ^ j) (hWeil_pow M hν_M_weil j)).2 w
    simp only [monomialListTrace, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
      add_zero] at h1
    have h_fin_ulift : Module.finrank (Ω F) (ULift.{u} (Ω F)) = 1 := by
      rw [LinearEquiv.finrank_eq (ULift.moduleEquiv : ULift.{u} (Ω F) ≃ₗ[Ω F] Ω F),
        Module.finrank_self]
    have h_tr_char : LinearMap.trace (Ω F) (ULift.{u} (Ω F)) (charRep F M (ν_M ^ j) w) =
        (ν_M w : Ω F) ^ j := by
      change LinearMap.trace (Ω F) (ULift.{u} (Ω F)) (((ν_M ^ j) w : Ω F) • LinearMap.id) = _
      rw [map_smul, LinearMap.trace_id, h_fin_ulift, Nat.cast_one, smul_eq_mul, mul_one,
        MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
    exact h1.symm.trans h_tr_char
  have h_list_trace_M : ∀ (n : ℕ) (w : G_M),
      monomialListTrace F M ((List.range n).map term_M) w =
        ∑ j ∈ Finset.range n, (ν_M w : Ω F) ^ j := by
    intro n w
    induction n with
    | zero => simp [monomialListTrace]
    | succ n ih =>
      rw [List.range_succ, List.map_append, List.map_singleton,
        monomialListTrace, List.map_append, List.sum_append,
        List.map_singleton, List.sum_singleton, ← monomialListTrace,
        ih, h_term_trace_M n w, Finset.sum_range_succ]
  choose s_M hs_M using hπM_surj
  let e_M' : H_M' ≃* relWeil F M' := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hMM')
  let ρ_1 : Representation (Ω F) H_M' W_V := (charRep F M' 1).comp e_M'.toMonoidHom
  have hρ_1_apply : ∀ (h : H_M') (v : W_V), ρ_1 h v = v := by
    intro h v
    change ((1 : relWeil F M' →* (Ω F)ˣ) (e_M' h) : Ω F) • v = v
    rw [MonoidHom.one_apply, Units.val_one, one_smul]
  let Ψ_M : indSpace H_M' ρ_1 ≃ₗ[Ω F] (Q_F' → Ω F) :=
    { toFun := fun f b => (f.1 (s_M b)).down
      map_add' := fun _ _ => funext fun _ => rfl
      map_smul' := fun _ _ => funext fun _ => rfl
      invFun := fun φ =>
        ⟨fun x => ULift.up (φ (π_M x)), fun h x => by
          dsimp only
          rw [hρ_1_apply]
          have hπ_h : π_M (h : G_M) = 1 := (hπM_eq_one (h : G_M)).mpr h.2
          rw [map_mul, hπ_h, one_mul]⟩
      left_inv := fun f => by
        apply Subtype.ext
        funext x
        dsimp only
        have h_ker : x * (s_M (π_M x))⁻¹ ∈ H_M' := by
          rw [← hπM_eq_one, map_mul, map_inv, hs_M (π_M x), mul_inv_cancel]
        have h_eq := f.2 ⟨x * (s_M (π_M x))⁻¹, h_ker⟩ (s_M (π_M x))
        rw [hρ_1_apply] at h_eq
        have h_cancel : (x * (s_M (π_M x))⁻¹) * s_M (π_M x) = x :=
          inv_mul_cancel_right x (s_M (π_M x))
        change ULift.up (f.1 (s_M (π_M x))).down = f.1 x
        rw [ULift.up_down, ← h_eq, h_cancel]
      right_inv := fun φ => by
        funext b
        dsimp only
        rw [hs_M b] }
  have h_ind1_trace : ∀ w : G_M,
      (⟨1, M', hMM', 1⟩ : MonomialTerm F M).trace F M w =
        if π_M w = 1 then (q₀ : Ω F) else 0 := by
    intro w
    simp only [MonomialTerm.trace, one_smul]
    let T : (Q_F' → Ω F) →ₗ[Ω F] (Q_F' → Ω F) := Ψ_M.conj (indRep H_M' ρ_1 w)
    have h_conj : LinearMap.trace (Ω F) (indSpace H_M' ρ_1) (indRep H_M' ρ_1 w) =
        LinearMap.trace (Ω F) (Q_F' → Ω F) T :=
      (LinearMap.trace_conj' (indRep H_M' ρ_1 w) Ψ_M).symm
    change LinearMap.trace (Ω F) (indSpace H_M' ρ_1) (indRep H_M' ρ_1 w) = _
    rw [h_conj]
    have h_decomp_T : T = ∑ b : Q_F',
        (LinearMap.single (Ω F) (fun _ : Q_F' => Ω F) b).comp
          ((LinearMap.proj b).comp T) := by
      apply LinearMap.ext
      intro φ
      funext b₁
      simp [LinearMap.sum_apply, LinearMap.comp_apply]
    rw [h_decomp_T, map_sum]
    have h_diag : ∀ b : Q_F',
        LinearMap.trace (Ω F) (Q_F' → Ω F)
          ((LinearMap.single (Ω F) (fun _ : Q_F' => Ω F) b).comp
            ((LinearMap.proj b).comp T)) =
          if π_M w = 1 then (1 : Ω F) else 0 := by
      intro b
      have h_comm : LinearMap.trace (Ω F) (Q_F' → Ω F)
          ((LinearMap.single (Ω F) (fun _ : Q_F' => Ω F) b).comp
            ((LinearMap.proj b).comp T)) =
          LinearMap.trace (Ω F) (Ω F)
            (((LinearMap.proj b).comp T).comp
              (LinearMap.single (Ω F) (fun _ : Q_F' => Ω F) b)) :=
        (LinearMap.trace_comp_comm'
          (LinearMap.single (Ω F) (fun _ : Q_F' => Ω F) b)
          ((LinearMap.proj b).comp T)).symm
      rw [h_comm]
      let B : Ω F →ₗ[Ω F] Ω F :=
        ((LinearMap.proj b).comp T).comp (LinearMap.single (Ω F) (fun _ : Q_F' => Ω F) b)
      change LinearMap.trace (Ω F) (Ω F) B = _
      by_cases hw1 : π_M w = 1
      · rw [if_pos hw1]
        have hB : B = LinearMap.id := by
          apply LinearMap.ext
          intro a
          change Pi.single (M := fun _ : Q_F' => Ω F) b a (π_M (s_M b * w)) = a
          rw [map_mul, hs_M b, hw1, mul_one, Pi.single_eq_same]
        rw [hB, LinearMap.trace_id, Module.finrank_self, Nat.cast_one]
      · rw [if_neg hw1]
        have h_ne : π_M (s_M b * w) ≠ b := by
          rw [map_mul, hs_M b]
          intro h_eq
          exact hw1 (mul_left_cancel (h_eq.trans (mul_one b).symm))
        have hB : B = 0 := by
          apply LinearMap.ext
          intro a
          change Pi.single (M := fun _ : Q_F' => Ω F) b a (π_M (s_M b * w)) = 0
          rw [Pi.single_eq_of_ne h_ne]
        rw [hB, map_zero]
    simp_rw [h_diag]
    by_cases hw1 : π_M w = 1
    · simp only [hw1, if_true, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
        hCard_QF', nsmul_one]
    · simp only [hw1, if_false, Finset.sum_const_zero]
  have hDM_sub : IsSubMonomialDecomp F M M M' hMM' D_M := by
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · intro s hs
      rw [List.mem_map] at hs
      rcases hs with ⟨j, _, rfl⟩
      exact h_term_wf j
    · intro w
      dsimp only [D_M]
      rw [h_ind1_trace w, h_list_trace_M q₀ w]
      by_cases hw1 : π_M w = 1
      · rw [if_pos hw1]
        have hν1 : (ν_M w : Ω F) = 1 := by
          change (bar_ν₁ (π_M w) : Ω F) = 1
          rw [hw1, map_one, Units.val_one]
        simp [hν1]
      · rw [if_neg hw1]
        have hν_ne1 : (ν_M w : Ω F) ≠ 1 := hbar_ν₁_ne_one (π_M w) hw1
        have hν_pow : (ν_M w : Ω F) ^ q₀ = 1 := hbar_ν₁_pow (π_M w)
        rw [geom_sum_eq hν_ne1 q₀, hν_pow, sub_self, zero_div]
    · intro s hs
      rw [List.mem_map] at hs
      rcases hs with ⟨j, _, rfl⟩
      exact le_rfl
  have hDM_rest1 : ∀ s ∈ D_M, ∃ hsM' : s.field ≤ M', restrictWeilChar F hsM' s.χ = 1 := by
    intro s hs
    rw [List.mem_map] at hs
    rcases hs with ⟨j, _, rfl⟩
    refine ⟨hMM', ?_⟩
    apply MonoidHom.ext
    intro w
    change (restrictWeilChar F hMM' ν_M w) ^ j = 1
    rw [hν_M_restM', MonoidHom.one_apply, one_pow]
  have htr_self_M : ∀ (ψM : AddChar M (Ω F)),
      traceChar F (le_rfl : M ≤ M) ψM = ψM := by
    intro ψM
    ext x
    change ψM (traceLM F (le_rfl : M ≤ M) x) = ψM x
    congr 1
    dsimp [traceLM, toExtendScalars]
    let e : M ≃ₐ[M] IntermediateField.extendScalars (le_rfl : M ≤ M) :=
      { toFun := fun y => ⟨y.1, y.2⟩
        invFun := fun y => ⟨y.1, y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    have he := Algebra.trace_eq_of_algEquiv e x
    rw [Algebra.trace_self_apply] at he
    exact he
  have hDM_eval : ∀ (ψM : AddChar M (Ω F)),
      evalMonomialList F rec (fun _ _ _ => 1) M ψM D_M =
        (∏ j ∈ Finset.range q₀,
          tateEpsUnit F M
            (recChar F rec M (restrictWeilChar F hLM (ν₁ ^ j))) ψM) ∧
      evalMonomialList F rec (fun _ _ _ => 1) M ψM
          (D_M.map (twistMonomialTerm F M χM)) =
        (∏ j ∈ Finset.range q₀,
          tateEpsUnit F M
            (recChar F rec M (restrictWeilChar F hLM (ν₁ ^ j) * χM)) ψM) := by
    intro ψM
    have h_rest_pow : ∀ j : ℕ, ν_M ^ j = restrictWeilChar F hLM (ν₁ ^ j) :=
      fun j => MonoidHom.ext fun _ => rfl
    have h_rest_self : restrictWeilChar F (le_rfl : M ≤ M) χM = χM :=
      MonoidHom.ext fun _ => rfl
    have h_eval_n : ∀ n : ℕ,
        evalMonomialList F rec (fun _ _ _ => 1) M ψM ((List.range n).map term_M) =
          (∏ j ∈ Finset.range n,
            tateEpsUnit F M
              (recChar F rec M (restrictWeilChar F hLM (ν₁ ^ j))) ψM) ∧
        evalMonomialList F rec (fun _ _ _ => 1) M ψM
            (((List.range n).map term_M).map (twistMonomialTerm F M χM)) =
          (∏ j ∈ Finset.range n,
            tateEpsUnit F M
              (recChar F rec M (restrictWeilChar F hLM (ν₁ ^ j) * χM)) ψM) := by
      intro n
      induction n with
      | zero => simp [evalMonomialList]
      | succ n ih =>
        refine ⟨?_, ?_⟩
        · rw [List.range_succ, List.map_append, List.map_singleton,
            evalMonomialList, List.map_append, List.prod_append,
            List.map_singleton, List.prod_singleton, ← evalMonomialList,
            ih.1, Finset.prod_range_succ]
          congr 1
          dsimp [evalMonomialTerm, term_M]
          rw [htr_self_M ψM, h_rest_pow n, mul_one, zpow_one]
        · rw [List.range_succ, List.map_append, List.map_singleton,
            List.map_append, List.map_singleton,
            evalMonomialList, List.map_append, List.prod_append,
            List.map_singleton, List.prod_singleton, ← evalMonomialList,
            ih.2, Finset.prod_range_succ]
          congr 1
          dsimp [evalMonomialTerm, twistMonomialTerm, term_M]
          rw [htr_self_M ψM, h_rest_pow n, h_rest_self, mul_one, zpow_one]
    exact h_eval_n q₀
  exact ⟨hWf_t', hTr_t', D_M, hDM_sub, hDM_rest1, hDM_eval⟩

theorem ld_ch13_2_tateEpsUnit_algEquiv_invariance (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M₁] [FiniteDimensional F M₂]
    (ϕ : M₁ ≃ₐ[F] M₂)
    (ψ₁ : AddChar M₁ (Ω F)) (hψ₁ : IsAdmissibleChar F M₁ ψ₁)
    (ψ₂ : AddChar M₂ (Ω F)) (hψ_eq : ∀ x : M₁, ψ₂ (ϕ x) = ψ₁ x)
    (θ₁ : M₁ˣ →* (Ω F)ˣ)
    (hθ₁_cond : ∀ u ∈ unitGroup F M₁ (condExp F M₁ θ₁), θ₁ u = 1)
    (θ₂ : M₂ˣ →* (Ω F)ˣ)
