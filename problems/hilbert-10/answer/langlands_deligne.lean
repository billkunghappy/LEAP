      (Or.inr (by rw [hw_pow_val])) hfb_val
  have hDiff_pow_val : ∀ m' < p,
      ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i) = 0 ∨
        ((B₀ : ℕ) : ℤ) - ((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i) := by
    intro m' hm'
    rw [← geom_sum₂_mul (Δ_conj m') ((Δ : K₁) + ξ m') i]
    have hgeom : (∑ k ∈ Finset.range i, (Δ_conj m') ^ k * ((Δ : K₁) + ξ m') ^ (i - 1 - k)) = 0 ∨
        -(((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)) ≤
          valL F K₁ (∑ k ∈ Finset.range i, (Δ_conj m') ^ k * ((Δ : K₁) + ξ m') ^ (i - 1 - k)) := by
      refine hval_sum (Finset.range i) _ (-(((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ))) fun k hk => ?_
      have hk_lt : k < i := Finset.mem_range.mp hk
      have h1_ne0 : (Δ_conj m') ^ k ≠ 0 := pow_ne_zero k (hΔ_conj_val m' hm').1
      have h2_ne0 : ((Δ : K₁) + ξ m') ^ (i - 1 - k) ≠ 0 :=
        pow_ne_zero (i - 1 - k) (hΔ_xi_val m' hm').1
      right
      rw [hval_mul_K₁ _ _ h1_ne0 h2_ne0,
        hval_pow_K₁ _ (hΔ_conj_val m' hm').1 k, (hΔ_conj_val m' hm').2,
        hval_pow_K₁ _ (hΔ_xi_val m' hm').1 (i - 1 - k), (hΔ_xi_val m' hm').2]
      have hk_mul : (k + (i - 1 - k)) * t₁ = (i - 1) * t₁ := by
        congr 1
        omega
      have hk_cast : (((k + (i - 1 - k)) * t₁ : ℕ) : ℤ) = (((i - 1) * t₁ : ℕ) : ℤ) := by
        exact_mod_cast hk_mul
      change -(((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)) ≤
