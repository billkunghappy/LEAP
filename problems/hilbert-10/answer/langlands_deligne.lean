      exact mul_ne_zero hSj₀_ne (Units.ne_zero _)
    let J_nz : Finset (Fin e) := Finset.univ.filter (fun j => T_j j ≠ 0)
    have hj₀_mem : p₀.2 ∈ J_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ p₀.2, hTj₀_ne⟩
    obtain ⟨j_star, hj_star_mem, hj_star_min⟩ :=
      Finset.exists_min_image J_nz (fun j => valL F M (T_j j)) ⟨p₀.2, hj₀_mem⟩
    have hTj_star : T_j j_star ≠ 0 := (Finset.mem_filter.mp hj_star_mem).2
    set v_star : ℤ := valL F M (T_j j_star)
    have herase : ∀ j ∈ (Finset.univ : Finset (Fin e)).erase j_star,
        T_j j = 0 ∨ v_star + 1 ≤ valL F M (T_j j) := by
      intro j hj
      have hj_ne : j ≠ j_star := (Finset.mem_erase.mp hj).1
      by_cases hTj : T_j j = 0
      · exact Or.inl hTj
      · right
        have hj_mem : j ∈ J_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hTj⟩
        have hle := hj_star_min j hj_mem
        have hne_val : valL F M (T_j j) ≠ v_star := by
          intro heq
          have hmod_eq : (j.1 : ℤ) = (j_star.1 : ℤ) := by
            rw [← hTj_mod j hTj, ← hTj_mod j_star hTj_star, heq]
          exact hj_ne (Fin.ext (Nat.cast_injective hmod_eq))
        omega
    set R_star : M := ∑ j ∈ (Finset.univ : Finset (Fin e)).erase j_star, T_j j
    have hR_val : R_star = 0 ∨ v_star + 1 ≤ valL F M R_star :=
      hval_sum_ge ((Finset.univ : Finset (Fin e)).erase j_star) T_j (v_star + 1) herase
    have hadd_R : T_j j_star + R_star = 0 := by
      dsimp [R_star]
      rw [Finset.add_sum_erase Finset.univ T_j (Finset.mem_univ j_star), hsum_T]
    have hR_eq : R_star = - T_j j_star := eq_neg_of_add_eq_zero_right hadd_R
    have hR_ne : R_star ≠ 0 := by
      rw [hR_eq]
      exact neg_ne_zero.mpr hTj_star
    have hR_vstar : valL F M R_star = v_star := by
      rw [hR_eq, hval_neg]
    have hR_ge : v_star + 1 ≤ valL F M R_star := hR_val.resolve_left hR_ne
    omega

  
  have h1_step : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ (a : Fin f₀ → F) (y₁ : M),
        (∀ i : Fin f₀, a i = 0 ∨ 0 ≤ addVal F (a i)) ∧
        (y₁ = 0 ∨ 0 ≤ valL F M y₁) ∧
        x = (∑ i : Fin f₀, algebraMap F M (a i) * u i) + (ϖ_M : M) * y₁ := by
    intro x hx
    obtain ⟨a, ha_int, hdiff_max⟩ := hu_span x hx
    set d_x : M := x - (∑ i : Fin f₀, algebraMap F M (a i) * u i)
    let y₁ : M := ((ϖ_M⁻¹ : Mˣ) : M) * d_x
    have hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M y₁ := by
      by_cases hdx0 : d_x = 0
      · left; dsimp [y₁]; rw [hdx0, mul_zero]
      · right
        have hdx1 : 1 ≤ valL F M d_x := hdiff_max.resolve_left hdx0
        dsimp [y₁]
        rw [hval_mul _ _ (Units.ne_zero _) hdx0, hval_inv ϖ_M, hϖ_M]
        omega
    have hx_eq : x = (∑ i : Fin f₀, algebraMap F M (a i) * u i) + (ϖ_M : M) * y₁ := by
      dsimp [y₁, d_x]
      rw [← mul_assoc, Units.mul_inv, one_mul, add_sub_cancel]
    exact ⟨a, y₁, ha_int, hy₁_int, hx_eq⟩
  have hr_step : ∀ (r : ℕ) (x : M), (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ (B : ℕ → Fin f₀ → F) (y_r : M),
        (∀ (j : ℕ) (i : Fin f₀), B j i = 0 ∨ 0 ≤ addVal F (B j i)) ∧
        (y_r = 0 ∨ 0 ≤ valL F M y_r) ∧
        x = (∑ j ∈ Finset.range r,
              (∑ i : Fin f₀, algebraMap F M (B j i) * u i) * ((ϖ_M ^ j : Mˣ) : M)) +
            ((ϖ_M ^ r : Mˣ) : M) * y_r := by
    intro r
    induction r with
    | zero =>
      intro x hx
      refine ⟨fun _ _ => 0, x, fun _ _ => Or.inl rfl, hx, ?_⟩
      simp
    | succ r ih =>
      intro x hx
      obtain ⟨B, y_r, hB_int, hyr_int, hx_eq⟩ := ih x hx
      obtain ⟨a, y_next, ha_int, hynext_int, hyr_eq⟩ := h1_step y_r hyr_int
      let B' : ℕ → Fin f₀ → F := Function.update B r a
      have hB'_int : ∀ (j : ℕ) (i : Fin f₀), B' j i = 0 ∨ 0 ≤ addVal F (B' j i) := by
        intro j i
        dsimp [B']
        by_cases hjr : j = r
        · subst hjr; rw [Function.update_self]; exact ha_int i
        · rw [Function.update_of_ne hjr]; exact hB_int j i
      have hsum_range :
          (∑ j ∈ Finset.range (r + 1),
            (∑ i : Fin f₀, algebraMap F M (B' j i) * u i) * ((ϖ_M ^ j : Mˣ) : M)) =
          (∑ j ∈ Finset.range r,
            (∑ i : Fin f₀, algebraMap F M (B j i) * u i) * ((ϖ_M ^ j : Mˣ) : M)) +
          (∑ i : Fin f₀, algebraMap F M (a i) * u i) * ((ϖ_M ^ r : Mˣ) : M) := by
        rw [Finset.sum_range_succ]
        congr 1
        · apply Finset.sum_congr rfl
          intro j hj
          have hj_ne : j ≠ r := ne_of_lt (Finset.mem_range.mp hj)
          dsimp [B']
          rw [Function.update_of_ne hj_ne]
        · dsimp [B']
          rw [Function.update_self]
      refine ⟨B', y_next, hB'_int, hynext_int, ?_⟩
      rw [hsum_range, hx_eq, hyr_eq, pow_succ, Units.val_mul]
      ring
  have he_step : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ (A : Fin f₀ × Fin e → F) (R : M),
        (∀ p : Fin f₀ × Fin e, A p = 0 ∨ 0 ≤ addVal F (A p)) ∧
        (R = 0 ∨ 0 ≤ valL F M R) ∧
        x = (∑ p : Fin f₀ × Fin e, algebraMap F M (A p) * w p) +
            algebraMap F M π * R := by
    intro x hx
    obtain ⟨B, y_e, hB_int, hye_int, hx_eq⟩ := hr_step e x hx
    let A : Fin f₀ × Fin e → F := fun p => B p.2.1 p.1
    have hA_int : ∀ p : Fin f₀ × Fin e, A p = 0 ∨ 0 ≤ addVal F (A p) :=
      fun p => hB_int p.2.1 p.1
    have hsum_A :
        (∑ p : Fin f₀ × Fin e, algebraMap F M (A p) * w p) =
        ∑ j ∈ Finset.range e,
          (∑ i : Fin f₀, algebraMap F M (B j i) * u i) * ((ϖ_M ^ j : Mˣ) : M) := by
      rw [Fintype.sum_prod_type, Finset.sum_comm, ← Fin.sum_univ_eq_sum_range]
      apply Finset.sum_congr rfl
      intro j _
      dsimp [A, w]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      rw [mul_assoc]
    let R : M := (algebraMap F M π)⁻¹ * (((ϖ_M ^ e : Mˣ) : M) * y_e)
    have hR_int : R = 0 ∨ 0 ≤ valL F M R := by
      by_cases hye0 : y_e = 0
      · left; dsimp [R]; rw [hye0, mul_zero, mul_zero]
      · right
        have hye_ge0 : 0 ≤ valL F M y_e := hye_int.resolve_left hye0
        have hrem_ne : ((ϖ_M ^ e : Mˣ) : M) * y_e ≠ 0 := mul_ne_zero (Units.ne_zero _) hye0
        have hinv_eq : (algebraMap F M π)⁻¹ = algebraMap F M (π⁻¹) := (map_inv₀ _ π).symm
        have hinv_ne : (algebraMap F M π)⁻¹ ≠ 0 := inv_ne_zero halg_π_ne
        change 0 ≤ valL F M ((algebraMap F M π)⁻¹ * (((ϖ_M ^ e : Mˣ) : M) * y_e))
        rw [hval_mul _ _ hinv_ne hrem_ne, hinv_eq, halg_val (π⁻¹) (inv_ne_zero hπ_ne),
          haddVal_inv π hπ_ne, hadd_π, hval_mul _ _ (Units.ne_zero _) hye0,
          hval_unit_pow ϖ_M e, hϖ_M, mul_one]
        omega
    refine ⟨A, R, hA_int, hR_int, ?_⟩
    rw [hsum_A, hx_eq]
    congr 1
    dsimp [R]
    rw [mul_inv_cancel_left₀ halg_π_ne]
  have hspan_int : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      x ∈ Submodule.span F (Set.range w) := by
    intro x hx
    let IntM := {z : M // z = 0 ∨ 0 ≤ valL F M z}
    let nextM : IntM → IntM := fun z =>
      ⟨(he_step z.1 z.2).choose_spec.choose, (he_step z.1 z.2).choose_spec.choose_spec.2.1⟩
    let x_seq : ℕ → IntM := fun n => Nat.rec ⟨x, hx⟩ (fun _ z => nextM z) n
    let d_seq : ℕ → Fin f₀ × Fin e → F := fun n =>
      (he_step (x_seq n).1 (x_seq n).2).choose
    have hd_seq_int : ∀ (n : ℕ) (p : Fin f₀ × Fin e),
        d_seq n p = 0 ∨ 0 ≤ addVal F (d_seq n p) :=
      fun n => (he_step (x_seq n).1 (x_seq n).2).choose_spec.choose_spec.1
    have hx_seq_step : ∀ n : ℕ,
        (x_seq n).1 =
          (∑ p : Fin f₀ × Fin e, algebraMap F M (d_seq n p) * w p) +
          algebraMap F M π * (x_seq (n + 1)).1 :=
      fun n => (he_step (x_seq n).1 (x_seq n).2).choose_spec.choose_spec.2.2
    let C_K : ℕ → Fin f₀ × Fin e → F := fun K p =>
      ∑ n ∈ Finset.range K, d_seq n p * π ^ n
    have hCK_exp : ∀ K : ℕ,
        x = (∑ p : Fin f₀ × Fin e, algebraMap F M (C_K K p) * w p) +
            algebraMap F M (π ^ K) * (x_seq K).1 := by
      intro K
      induction K with
      | zero =>
        dsimp [C_K, x_seq]
        simp
      | succ K ih =>
        have hsum_succ :
            (∑ p : Fin f₀ × Fin e, algebraMap F M (C_K (K + 1) p) * w p) =
            (∑ p : Fin f₀ × Fin e, algebraMap F M (C_K K p) * w p) +
            algebraMap F M (π ^ K) *
              (∑ p : Fin f₀ × Fin e, algebraMap F M (d_seq K p) * w p) := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro p _
          dsimp [C_K]
          rw [Finset.sum_range_succ, map_add, map_mul]
          ring
        rw [hsum_succ, pow_succ, map_mul, ih, hx_seq_step K]
        ring
    have hπ_mem_O : π ∈ 𝒪[F] := (hmem_O π).mpr (Or.inr (by rw [hadd_π]; omega))
    have hπ_val_le1 : valuation F π ≤ 1 := by rwa [← Valuation.mem_integer_iff]
    have hd_mem_O : ∀ (n : ℕ) (p : Fin f₀ × Fin e), d_seq n p ∈ 𝒪[F] :=
      fun n p => (hmem_O (d_seq n p)).mpr (hd_seq_int n p)
    have hd_val_le1 : ∀ (n : ℕ) (p : Fin f₀ × Fin e), valuation F (d_seq n p) ≤ 1 := by
      intro n p
      have h := hd_mem_O n p
      rwa [← Valuation.mem_integer_iff]
    have hCK_mem_O : ∀ (K : ℕ) (p : Fin f₀ × Fin e), C_K K p ∈ 𝒪[F] := by
      intro K p
      dsimp [C_K]
      exact Subring.sum_mem 𝒪[F] (fun n _ => Subring.mul_mem 𝒪[F] (hd_mem_O n p) (Subring.pow_mem 𝒪[F] hπ_mem_O n))
    let t_p : Fin f₀ × Fin e → ℕ → Set 𝒪[F] := fun p K =>
      {z : 𝒪[F] | valuation F ((z : F) - C_K K p) ≤ valuation F (π ^ K)}
    have ht_nonempty_iInter : ∀ p : Fin f₀ × Fin e, (⋂ K : ℕ, t_p p K).Nonempty := by
      intro p
      have h_anti : ∀ K : ℕ, t_p p (K + 1) ⊆ t_p p K := by
        intro K z hz
        change valuation F ((z : F) - C_K (K + 1) p) ≤ valuation F (π ^ (K + 1)) at hz
        change valuation F ((z : F) - C_K K p) ≤ valuation F (π ^ K)
        have hsplit : (z : F) - C_K K p = ((z : F) - C_K (K + 1) p) + d_seq K p * π ^ K := by
          dsimp [C_K]
          rw [Finset.sum_range_succ]
          ring
        have h1 : valuation F ((z : F) - C_K (K + 1) p) ≤ valuation F (π ^ K) := by
          calc valuation F ((z : F) - C_K (K + 1) p)
            _ ≤ valuation F (π ^ (K + 1)) := hz
            _ = valuation F (π ^ K) * valuation F π := by rw [pow_succ, map_mul]
            _ ≤ valuation F (π ^ K) := mul_le_of_le_one_right' hπ_val_le1
        have h2 : valuation F (d_seq K p * π ^ K) ≤ valuation F (π ^ K) := by
          rw [map_mul]
          exact mul_le_of_le_one_left' (hd_val_le1 K p)
        rw [hsplit]
        exact le_trans (Valuation.map_add _ _ _) (max_le h1 h2)
      have h_nonempty : ∀ K : ℕ, (t_p p K).Nonempty := by
        intro K
        refine ⟨⟨C_K K p, hCK_mem_O K p⟩, ?_⟩
        change valuation F (C_K K p - C_K K p) ≤ valuation F (π ^ K)
        simp
      have h_closed : ∀ K : ℕ, IsClosed (t_p p K) := by
        intro K
        exact IsClosed.preimage (continuous_subtype_val.sub continuous_const)
          (IsValuativeTopology.isClosed_closedBall (valuation F (π ^ K)))
      have h_compact : IsCompact (t_p p 0) := IsClosed.isCompact (h_closed 0)
      exact IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
        (t_p p) h_anti h_nonempty h_compact h_closed
    let z_inf : Fin f₀ × Fin e → 𝒪[F] := fun p => (ht_nonempty_iInter p).choose
    let c_inf : Fin f₀ × Fin e → F := fun p => ((z_inf p : 𝒪[F]) : F)
    have hc_inf_ball : ∀ (p : Fin f₀ × Fin e) (K : ℕ),
        valuation F (c_inf p - C_K K p) ≤ valuation F (π ^ K) :=
      fun p K => Set.mem_iInter.mp (ht_nonempty_iInter p).choose_spec K
    set Δ : M := x - ∑ p : Fin f₀ × Fin e, algebraMap F M (c_inf p) * w p
    have hΔ_val : ∀ K : ℕ, Δ = 0 ∨ (K : ℤ) ≤ valL F M Δ := by
      intro K
      let b_K : Fin f₀ × Fin e → F := fun p => (c_inf p - C_K K p) * (π ^ K)⁻¹
      have hbK_int : ∀ p : Fin f₀ × Fin e, b_K p = 0 ∨ 0 ≤ addVal F (b_K p) := by
        intro p
        have hπK_ne : π ^ K ≠ 0 := pow_ne_zero K hπ_ne
        have hv_pos : 0 < valuation F (π ^ K) :=
          zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hπK_ne)
        have hv_bK : valuation F (b_K p) ≤ 1 := by
          dsimp [b_K]
          rw [map_mul, map_inv₀]
          exact (mul_inv_le_iff₀ hv_pos).mpr (by rw [one_mul]; exact hc_inf_ball p K)
        have hbK_mem : b_K p ∈ 𝒪[F] := by rwa [Valuation.mem_integer_iff]
        exact (hmem_O (b_K p)).mp hbK_mem
      have hc_inf_eq : ∀ p : Fin f₀ × Fin e, c_inf p = C_K K p + π ^ K * b_K p := by
        intro p
        dsimp [b_K]
        rw [mul_comm (π ^ K), inv_mul_cancel_right₀ (pow_ne_zero K hπ_ne), add_sub_cancel]
      let rem_K : M := (x_seq K).1 - ∑ p : Fin f₀ × Fin e, algebraMap F M (b_K p) * w p
      have hrem_int : rem_K = 0 ∨ 0 ≤ valL F M rem_K := by
        have hsum_bK_int : (∑ p : Fin f₀ × Fin e, algebraMap F M (b_K p) * w p) = 0 ∨
            0 ≤ valL F M (∑ p : Fin f₀ × Fin e, algebraMap F M (b_K p) * w p) := by
          refine (hresM_sum Finset.univ
            (fun p : Fin f₀ × Fin e => algebraMap F M (b_K p) * w p) ?_).1
          intro p _
          have hw_int : w p = 0 ∨ 0 ≤ valL F M (w p) := by
            dsimp [w]
            refine hintM_mul (u p.1) ((ϖ_M ^ (p.2 : ℕ) : Mˣ) : M) (hu_int p.1) (Or.inr ?_)
            rw [hval_unit_pow ϖ_M (p.2 : ℕ), hϖ_M, mul_one]
            exact Nat.cast_nonneg _
          exact hintM_mul _ _ (halg0 (b_K p) (hbK_int p)) hw_int
        exact hintM_sub (x_seq K).1 _ (x_seq K).2 hsum_bK_int
      have hΔ_eq : Δ = algebraMap F M (π ^ K) * rem_K := by
        have hsum_c :
            (∑ p : Fin f₀ × Fin e, algebraMap F M (c_inf p) * w p) =
            (∑ p : Fin f₀ × Fin e, algebraMap F M (C_K K p) * w p) +
            algebraMap F M (π ^ K) *
              (∑ p : Fin f₀ × Fin e, algebraMap F M (b_K p) * w p) := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro p _
          rw [hc_inf_eq p, map_add, map_mul]
          ring
        dsimp [Δ, rem_K]
        rw [hCK_exp K, hsum_c]
        ring
      by_cases hrem0 : rem_K = 0
      · left; rw [hΔ_eq, hrem0, mul_zero]
      · right
        have halg_πK_ne : algebraMap F M (π ^ K) ≠ 0 :=
          halg_ne (π ^ K) (pow_ne_zero K hπ_ne)
        have hrem_ge0 : 0 ≤ valL F M rem_K := hrem_int.resolve_left hrem0
        rw [hΔ_eq, hval_mul _ _ halg_πK_ne hrem0, halg_val (π ^ K) (pow_ne_zero K hπ_ne),
          haddVal_pow π K hπ_ne, hadd_π, mul_one]
        nlinarith [he_ge1]
    have hΔ_zero : Δ = 0 := by
      by_contra hΔ_ne
      let K₀ : ℕ := (valL F M Δ).toNat + 1
      have hge := (hΔ_val K₀).resolve_left hΔ_ne
      omega
    have hx_sum : x = ∑ p : Fin f₀ × Fin e, c_inf p • w p := by
      have hsub0 : x = ∑ p : Fin f₀ × Fin e, algebraMap F M (c_inf p) * w p :=
        sub_eq_zero.mp hΔ_zero
      rw [hsub0]
      apply Finset.sum_congr rfl
      intro p _
      rw [Algebra.smul_def]
    rw [hx_sum]
    exact Submodule.sum_mem _ (fun p _ =>
      Submodule.smul_mem _ (c_inf p) (Submodule.subset_span ⟨p, rfl⟩))
  have hspan : ⊤ ≤ Submodule.span F (Set.range w) := by
    intro z _
    let N : ℕ := (- valL F M z).toNat
    let x : M := algebraMap F M (π ^ N) * z
    have hx_int : x = 0 ∨ 0 ≤ valL F M x := by
      by_cases hz0 : z = 0
      · left; dsimp [x]; rw [hz0, mul_zero]
      · right
        have halg_πN_ne : algebraMap F M (π ^ N) ≠ 0 :=
          halg_ne (π ^ N) (pow_ne_zero N hπ_ne)
        dsimp [x]
        rw [hval_mul _ _ halg_πN_ne hz0, halg_val (π ^ N) (pow_ne_zero N hπ_ne),
          haddVal_pow π N hπ_ne, hadd_π, mul_one]
        have hN_ge : - valL F M z ≤ (N : ℤ) := by dsimp [N]; omega
        nlinarith [he_ge1]
    have hx_mem : x ∈ Submodule.span F (Set.range w) := hspan_int x hx_int
    have hz_eq : z = (π ^ N)⁻¹ • x := by
      dsimp [x]
      rw [Algebra.smul_def, map_inv₀, inv_mul_cancel_left₀
        (halg_ne (π ^ N) (pow_ne_zero N hπ_ne))]
    rw [hz_eq]
    exact Submodule.smul_mem _ _ hx_mem

  
  let B_M : Module.Basis (Fin f₀ × Fin e) F M := Module.Basis.mk hli hspan
  have hfinrank_B : Module.finrank F M = f₀ * e := by
    rw [Module.finrank_eq_card_basis B_M, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]
  have hf₀_eq : resDeg F M = f₀ := by
    have hmul_eq : resDeg F M * e = f₀ * e := hfinrank_eq.symm.trans hfinrank_B
    exact Nat.eq_of_mul_eq_mul_right he_ge1 hmul_eq
  refine ⟨?_, hp_kM, hp_M⟩
  unfold qL
  rw [hcard_kM, hf₀_eq]

theorem ld_ch14_top_stat_congruence_and_odd_quadratic_phase (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ψ_M : AddChar M (Ω F)) (θ : Mˣ →* (Ω F)ˣ)
    (hm : 2 ≤ condExp F M θ)
    (hp : Nat.Prime (p F))
    (hp_valM : ((p F : ℕ) : M) = 0 ∨ 1 ≤ valL F M ((p F : ℕ) : M))
    (hSpecM : (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
      (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) ∧
      (condExp F M θ ≠ 0 →
        (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F M (condExp F M θ - 1), θ u₀ ≠ 1)) ∧
      valL F M ((tateElt F M θ ψ_M : Mˣ) : M) =
        (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hvalM_props : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
