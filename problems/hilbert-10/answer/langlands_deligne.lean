            rw [hw1, mul_one, inv_mul_cancel]
            exact H.one_mem
          rw [dif_pos hc_mem, MonoidHom.one_apply, Units.val_one]
        have h_card_H_quot : Fintype.card (G₀ ⧸ H) = q₀ := by
          rw [← Nat.card_eq_fintype_card, hCard_GH]
        rw [h_sum_q, Finset.sum_const, Finset.card_univ, h_card_H_quot, nsmul_eq_mul, mul_one]
      · rw [if_neg hc1]
        refine Finset.sum_eq_zero fun u₀ _ => ?_
        have hc_not_H : ¬ ((cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ H) := by
          intro h_in_H
