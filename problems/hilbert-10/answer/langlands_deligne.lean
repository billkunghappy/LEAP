theorem ld_ch12_wild_odd_tot_ram_as_coeff_extraction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (ϖ_M₁' : M₁'ˣ) (hϖ_M₁' : valL F M₁' (ϖ_M₁' : M₁') = 1)
    (hBasis_M₁' : ∀ z : M₁',
      ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → L,
        z = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hLM₁' (c i) * ((ϖ_M₁' : M₁') ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (z = 0 ∨ m ≤ valL F M₁' z) ↔
            ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
              c i = 0 ∨
                m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                  valL F L (c i) + (i : ℤ))
    (G_M₁' : Type u) [Group G_M₁'] [Fintype G_M₁'] (act_M₁' : G_M₁' → M₁' → M₁')
    (hcard_GM₁' : Fintype.card G_M₁' = Module.finrank L (IntermediateField.extendScalars hLE'))
    (hactM₁'_one : ∀ z : M₁', act_M₁' 1 z = z)
    (hactM₁'_mul : ∀ (σ τ : G_M₁') (z : M₁'), act_M₁' (σ * τ) z = act_M₁' σ (act_M₁' τ z))
    (hactM₁'_ring : ∀ σ : G_M₁',
      act_M₁' σ 0 = 0 ∧ act_M₁' σ 1 = 1 ∧
      (∀ z₁ z₂ : M₁',
        act_M₁' σ (z₁ + z₂) = act_M₁' σ z₁ + act_M₁' σ z₂ ∧
        act_M₁' σ (z₁ * z₂) = act_M₁' σ z₁ * act_M₁' σ z₂ ∧
        act_M₁' σ (-z₁) = -act_M₁' σ z₁))
    (hactM₁'_incl : ∀ (σ : G_M₁') (x : L),
      act_M₁' σ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hactM₁'_val : ∀ (σ : G_M₁') (z : M₁'), valL F M₁' (act_M₁' σ z) = valL F M₁' z)
    (hjump_M₁' : ∀ τ : G_M₁', τ ≠ 1 →
      (ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁') ≠ 0 ∧
      valL F M₁' ((ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁')) = (bM₁' : ℤ))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as_t₂ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    ∀ (θ : M₁') (Y : Fin p → E'),
      IntermediateField.inclusion hM₁'K₁ θ =
        ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
      ∀ i : Fin p,
        Y i = 0 ∨
          valL F M₁' θ + (i : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) :=
by
  obtain ⟨hΔ_coeff_val, hcoprime_E', τ, τ_lift, w₀,
    hτ_E', hτ_M₁', hτ_val, hτ_shift, hw₀_ne0, hw₀_val, hw₀_jump_ne0, hw₀_jump_val⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_lift_and_m1_shift F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime bE' bM₁' hbE'_ge2 hbM₁'_ge2 ht₁_ndvd hp_valK₁
      hvalE'_props hvalM₁'_props hvalK₁_props hval_LM₁' hval_E'K₁ hval_M₁'K₁ hGalLift
      ϖ_M₁' hϖ_M₁' hBasis_M₁' G_M₁' act_M₁' hcard_GM₁' hactM₁'_one hactM₁'_mul
      hactM₁'_ring hactM₁'_incl hactM₁'_val hjump_M₁' Δ hΔ_val
  obtain ⟨D₀, δ_plus, hΔ_shift, hD₀_ne0, hD₀_val, hδ_plus_val⟩ :=
    ld_ch12_wild_odd_tot_ram_as_delta_shift_unit_decomp F L E' K₁
      hLE' hE'K₁ hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd hp_valK₁
      hvalE'_props hvalK₁_props hval_E'K₁ Δ hΔ_val hΔ_as_t₂ hΔ_basis hΔ_coeff_val
      τ_lift hτ_E' hτ_val w₀ hw₀_ne0 hw₀_val hw₀_jump_ne0 hw₀_jump_val
  exact ld_ch12_wild_odd_tot_ram_upper_triangular_back_subst F L E' M₁' K₁
    hLE' hE'K₁ hM₁'K₁ hPrime hp_odd bM₁' hbM₁'_ge2
    hvalE'_props hvalM₁'_props hvalK₁_props hval_E'K₁ hval_M₁'K₁
    Δ hΔ_val hΔ_basis hΔ_coeff_val hcoprime_E'
    τ τ_lift hτ_E' hτ_M₁' hτ_val hτ_shift
    D₀ δ_plus hΔ_shift hD₀_ne0 hD₀_val hδ_plus_val

theorem ld_ch12_wild_odd_tot_ram_twisted_trace_and_symm_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (y₁_M₁' : M₁')
    (hy₁M₁'_tr : traceLM F hLM₁' y₁_M₁' = 1)
    (hy₁M₁'_ne0 : y₁_M₁' ≠ 0)
    (hy₁M₁'_val : valL F M₁' y₁_M₁' =
      -(((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
        ((bM₁' - 1 : ℕ) : ℤ)))
    (hSymm_M₁'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁),
        Fintype.card G = Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ (σ τ : G) (w : K₁), act (σ * τ) w = act σ (act τ w)) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (z : M₁'),
          act σ (IntermediateField.inclusion hM₁'K₁ z) = IntermediateField.inclusion hM₁'K₁ z) →
        (∀ (σ : G) (w : K₁), valL F K₁ (act σ w) = valL F K₁ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hM₁'K₁ (traceLM F hM₁'K₁ w) = ∑ σ : G, act σ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) = ∏ σ : G, act σ w) →
        let p := Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)
        let t' := (bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') * (bE' - bM₁')
        ∃ s : K₁ → ℕ → M₁',
          (∀ w : K₁, s w 1 = traceLM F hM₁'K₁ w) ∧
          (∀ w : K₁, 2 * s w 2 = (traceLM F hM₁'K₁ w) ^ 2 - traceLM F hM₁'K₁ (w ^ 2)) ∧
          (∀ w : K₁, w ≠ 0 → s w (p - 1) = normLM F hM₁'K₁ w * traceLM F hM₁'K₁ (w⁻¹)) ∧
          (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
            ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
              (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t' + 1 : ℤ) ≤ (r : ℤ) * q →
              (s w r = 0 ∨ m ≤ valL F M₁' (s w r))) ∧
          (∀ (w : K₁) (c : M₁'),
            normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * w) =
              1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s w r) +
                c ^ p * normLM F hM₁'K₁ w))
    (hCayley_M₁'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁) (s : K₁ → ℕ → M₁'),
        Fintype.card G = Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (z : M₁'),
          act σ (IntermediateField.inclusion hM₁'K₁ z) = IntermediateField.inclusion hM₁'K₁ z) →
        (∀ w : K₁,
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) = ∏ σ : G, act σ w) →
        (∀ (w : K₁) (c : M₁'),
          normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * w) =
            1 + (∑ r ∈ Finset.Icc 1 (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) - 1),
              c ^ r * s w r) +
              c ^ (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) * normLM F hM₁'K₁ w) →
        let p := Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)
        (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
          IntermediateField.inclusion hM₁'K₁ (s w r) =
            ∑ S ∈ ((Finset.univ : Finset G).powerset.filter (fun S => S.card = r)),
              ∏ σ ∈ S, act σ w) ∧
        (∀ w : K₁,
          w ^ p =
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) +
              ∑ i ∈ Finset.Icc 1 (p - 1),
                (-1 : K₁) ^ (i - 1) * IntermediateField.inclusion hM₁'K₁ (s w i) * w ^ (p - i)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as_t₂ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_tr_low_t₂ : ∀ j ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 2),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        (((p - 1) * (bE' - 1) : ℕ) : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j)))
    (hΔ_tr_top_t₂ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        (((p - 1) * (bE' - 1) : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')))
    (hΔ_tr_pow_t₂ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * normLM F hE'K₁ (Δ : K₁) = 0 ∨
        (((p - 1) * (bE' - 1) : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) -
            ((p : ℕ) : E') * normLM F hE'K₁ (Δ : K₁)))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ))
    (hCoeffExtr : ∀ (θ : M₁') (Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E'),
      IntermediateField.inclusion hM₁'K₁ θ =
        ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
      ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        Y i = 0 ∨ valL F M₁' θ + (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F E' (Y i)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    (∀ (Y : E') (i : ℕ), i ∈ Finset.Icc 1 (p - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)))) ∧
    ∃ (e_Δ : ℕ → M₁') (W_as : Fin p → E'),
      e_Δ 1 = traceLM F hM₁'K₁ (Δ : K₁) ∧
      (∀ i ∈ Finset.Icc 1 (p - 1),
        e_Δ i = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤ valL F M₁' (e_Δ i)) ∧
      (∀ c : M₁',
        normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * (Δ : K₁)) =
          1 + (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e_Δ i) + c ^ p * b) ∧
      (IntermediateField.inclusion hM₁'K₁ b -
        ((Δ : K₁) ^ p +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0) ∧
      (traceLM F hM₁'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : M₁') * (- e_Δ (p - 1)) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * ((t₂ + (bE' - bM₁') : ℕ) : ℤ) ≤
          valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ (p - 1)) -
            ((p - 1 : ℕ) : M₁') * (- e_Δ (p - 1)))) ∧
      (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a =
        ∑ l : Fin p, IntermediateField.inclusion hE'K₁ (W_as l) * ((Δ : K₁) ^ (l : ℕ)) ∧
      (∀ l : Fin p, W_as l = 0 ∨ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (W_as l)) :=
by
  intro p t₁ t₂ a b
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by
    change 3 ≤ Module.finrank L (IntermediateField.extendScalars hLE')
    omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  let δ_AS : K₁ := (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ a
  have hΔ_as_t₂' : δ_AS = 0 ∨ ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ δ_AS := hΔ_as_t₂
  obtain ⟨W_as, hW_as_eq, hW_as_iff⟩ := hΔ_basis δ_AS
  have hW_as_raw := (hW_as_iff ((p * (p - 1) * t₂ : ℕ) : ℤ)).mp hΔ_as_t₂'
  have hW_as_val : ∀ l : Fin p, W_as l = 0 ∨ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (W_as l) := by
    intro l
    rcases hW_as_raw l with h0 | hge
    · exact Or.inl h0
    · right
      have hl_nonneg : 0 ≤ (l : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) := by positivity
      have hcast_lhs : ((p * (p - 1) * t₂ : ℕ) : ℤ) =
          (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) := by
        push_cast
        ring
      rw [hcast_lhs] at hge
      have hmul_le : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) ≤ (p : ℤ) * valL F E' (W_as l) := by
        linarith
      have hp_pos_int : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
      exact le_of_mul_le_mul_left hmul_le hp_pos_int

  
  have hval_helpers : ∀ {M : Type u} [Field M] (v : M → ℤ),
      v 1 = 0 →
      (∀ x : M, v (-x) = v x) →
      (∀ x y : M, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
      (∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) → (x + y = 0 ∨ k ≤ v (x + y))) →
      (∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y))) ∧
      (∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x))) ∧
      (∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M)) ∧
      (∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M)) := by
    intro M _ v hv1 h_neg h_mul h_add
    have hmul_b : ∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y)) := by
      intro m₁ m₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          have hvx : m₁ ≤ v x := hx.resolve_left hx0
          have hvy : m₂ ≤ v y := hy.resolve_left hy0
          rw [h_mul x y hx0 hy0]
          linarith
    have hsum_b : ∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x)) := by
      intro α s f k hs
      induction s using Finset.induction_on with
      | empty => exact Or.inl Finset.sum_empty
      | @insert x s' hx ih =>
        rw [Finset.sum_insert hx]
        exact h_add k (f x) (∑ y ∈ s', f y)
          (hs x (Finset.mem_insert_self x s'))
          (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
    have hnat_b : ∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M) := by
      intro n
      induction n with
      | zero => left; simp
      | succ m ih =>
        rw [Nat.cast_succ]
        exact h_add 0 (m : M) 1 ih (Or.inr (by rw [hv1]))
    have hint_b : ∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M) := by
      intro z
      cases z with
      | ofNat n => simpa using hnat_b n
      | negSucc n =>
        rw [Int.cast_negSucc]
        rcases hnat_b (n + 1) with h0 | hge
        · left; exact neg_eq_zero.mpr h0
        · right; rw [h_neg]; exact hge
    exact ⟨hmul_b, hsum_b, hnat_b, hint_b⟩

  obtain ⟨hvalL_0, hvalL_1, _, _, _, _, _, _, _⟩ := hvalL_props
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _⟩ := hvalE'_props
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv, _, hvalM₁'_add, _⟩ := hvalM₁'_props
  obtain ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, _, hvalK₁_add, _⟩ := hvalK₁_props

  obtain ⟨hmul_E', hsum_E', hnat_E', _⟩ :=
    hval_helpers (valL F E') hvalE'_1 hvalE'_neg hvalE'_mul hvalE'_add
  obtain ⟨hmul_M₁', hsum_M₁', hnat_M₁', hint_M₁'⟩ :=
    hval_helpers (valL F M₁') hvalM₁'_1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_add
  obtain ⟨hmul_K₁, _, _, _⟩ :=
    hval_helpers (valL F K₁) hvalK₁_1 hvalK₁_neg hvalK₁_mul hvalK₁_add

  have htr_smul : ∀ {E₀ K₀ : IntermediateField F (AlgebraicClosure F)} (h : E₀ ≤ K₀)
      (y : E₀) (w : K₀),
      traceLM F h (IntermediateField.inclusion h y * w) = y * traceLM F h w := by
    intro E₀ K₀ h y w
    letI : Algebra E₀ E₀ := Algebra.id E₀
    letI : Module E₀ E₀ := Semiring.toModule
    exact (Algebra.trace E₀ (IntermediateField.extendScalars h)).map_smul' y (toExtendScalars F h w)

  
  have hΔ_ne0 : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
  have hval_pow_Δ : ∀ r : ℕ, (Δ : K₁) ^ r ≠ 0 ∧ valL F K₁ ((Δ : K₁) ^ r) = - (r : ℤ) * (t₁ : ℤ) := by
    intro r
    induction r with
    | zero =>
      refine ⟨by simp, ?_⟩
      simp [hvalK₁_1]
    | succ r ih =>
      rw [pow_succ]
      have hne : (Δ : K₁) ^ r * (Δ : K₁) ≠ 0 := mul_ne_zero ih.1 hΔ_ne0
      refine ⟨hne, ?_⟩
      rw [hvalK₁_mul ((Δ : K₁) ^ r) (Δ : K₁) ih.1 hΔ_ne0, ih.2, hΔ_val]
      dsimp [t₁]
      push_cast
      ring
  have hval_a : a = 0 ∨ -(t₁ : ℤ) ≤ valL F E' a := by
    right
    dsimp [a, t₁]
    rw [hval_norm_E'K₁ (Δ : K₁), hΔ_val]
  have hPowTr_le_p : ∀ k : ℕ, 1 ≤ k → k ≤ p →
      traceLM F hE'K₁ ((Δ : K₁) ^ k) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ k)) := by
    intro k hk1 hkp
    by_cases hk_low : k ≤ p - 2
    · have hk_mem : k ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨hk1, hk_low⟩
      rcases hΔ_tr_low_t₂ k hk_mem with h0 | hge
      · exact Or.inl h0
      · right
        have h_le_nat : (p - 1) * t₁ ≤ (p - 1) * (bE' - 1) :=
          Nat.mul_le_mul_left (p - 1) ht_le
        have h_le_int : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
            (((p - 1) * (bE' - 1) : ℕ) : ℤ) := by
          have h2 : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ (((p - 1) * (bE' - 1) : ℕ) : ℤ) := by
            exact_mod_cast h_le_nat
          have h5 : 0 ≤ (k : ℤ) * (t₁ : ℤ) := by positivity
          linarith
        exact le_trans h_le_int hge
    · by_cases hk_top : k = p - 1
      · subst hk_top
        rw [sub_self]
        have hdecomp : traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) =
            ((p - 1 : ℕ) : E') + (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
          ring
        rw [hdecomp]
        have hterm1 : ((p - 1 : ℕ) : E') = 0 ∨ 0 ≤ valL F E' ((p - 1 : ℕ) : E') :=
          hnat_E' (p - 1)
        have hterm2 : traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
            0 ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
          rcases hΔ_tr_top_t₂ with h0 | hge
          · exact Or.inl h0
          · exact Or.inr (le_trans (by positivity) hge)
        exact hvalE'_add 0 _ _ hterm1 hterm2
      · have hk_eq_p : k = p := by omega
        subst hk_eq_p
        have hbound_eq : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (p : ℤ) * (t₁ : ℤ) = -(t₁ : ℤ) := by
          have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
          rw [hp_sub]
          ring
        rw [hbound_eq]
        have hdecomp : traceLM F hE'K₁ ((Δ : K₁) ^ p) =
            ((p : ℕ) : E') * a + (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a) := by
          ring
        rw [hdecomp]
        have hterm1 : ((p : ℕ) : E') * a = 0 ∨ -(t₁ : ℤ) ≤ valL F E' (((p : ℕ) : E') * a) := by
          have h := hmul_E' 0 (-(t₁ : ℤ)) ((p : ℕ) : E') a (hnat_E' p) hval_a
          rwa [zero_add] at h
        have hterm2 : traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a = 0 ∨
            -(t₁ : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * a) := by
          rcases hΔ_tr_pow_t₂ with h0 | hge
          · exact Or.inl h0
          · right
            have h0_le : (-(t₁ : ℤ)) ≤ (((p - 1) * (bE' - 1) : ℕ) : ℤ) := by
              have : 0 ≤ (t₁ : ℤ) := by positivity
              have : 0 ≤ (((p - 1) * (bE' - 1) : ℕ) : ℤ) := by positivity
              linarith
            exact le_trans h0_le hge
        exact hvalE'_add (-(t₁ : ℤ)) _ _ hterm1 hterm2

  have hPowTr_E'K₁ : ∀ k ∈ Finset.Icc 1 (2 * p - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ k) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ k)) := by
    intro k hk
    obtain ⟨hk1, hk2⟩ := Finset.mem_Icc.mp hk
    by_cases hkp : k ≤ p
    · exact hPowTr_le_p k hk1 hkp
    · set r : ℕ := k - p
      have hr1 : 1 ≤ r := by omega
      have hr_le : r ≤ p - 2 := by omega
      have hk_eq : k = p + r := by omega
      let B_k : ℤ := ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (k : ℤ) * (t₁ : ℤ)
      have hpow_decomp : (Δ : K₁) ^ k =
          (Δ : K₁) ^ (r + 1) + IntermediateField.inclusion hE'K₁ a * ((Δ : K₁) ^ r) +
            δ_AS * ((Δ : K₁) ^ r) := by
        rw [hk_eq, pow_add, pow_succ']
        dsimp [δ_AS]
        ring
      have htr_decomp : traceLM F hE'K₁ ((Δ : K₁) ^ k) =
          (traceLM F hE'K₁ ((Δ : K₁) ^ (r + 1)) + a * traceLM F hE'K₁ ((Δ : K₁) ^ r)) +
            traceLM F hE'K₁ (δ_AS * ((Δ : K₁) ^ r)) := by
        rw [hpow_decomp, map_add, map_add, htr_smul hE'K₁ a ((Δ : K₁) ^ r)]
      rw [htr_decomp]
      have hterm1 : traceLM F hE'K₁ ((Δ : K₁) ^ (r + 1)) = 0 ∨
          B_k ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (r + 1))) := by
        rcases hPowTr_le_p (r + 1) (by omega) (by omega) with h0 | hge
        · exact Or.inl h0
        · right
          have hle : ((r + 1 : ℕ) : ℤ) ≤ (k : ℤ) := by exact_mod_cast (by omega : r + 1 ≤ k)
          have hmul : ((r + 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ (k : ℤ) * (t₁ : ℤ) :=
            mul_le_mul_of_nonneg_right hle (by positivity)
          dsimp [B_k]
          linarith
      have hterm2 : a * traceLM F hE'K₁ ((Δ : K₁) ^ r) = 0 ∨
          B_k ≤ valL F E' (a * traceLM F hE'K₁ ((Δ : K₁) ^ r)) := by
        have h_tr_r := hPowTr_le_p r hr1 (by omega)
        have h_prod := hmul_E' (-(t₁ : ℤ)) (((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (r : ℤ) * (t₁ : ℤ))
          a (traceLM F hE'K₁ ((Δ : K₁) ^ r)) hval_a h_tr_r
        rcases h_prod with h0 | hge
        · exact Or.inl h0
        · right
          have hle : (r : ℤ) + 1 ≤ (k : ℤ) := by exact_mod_cast (by omega : r + 1 ≤ k)
          have hmul : ((r : ℤ) + 1) * (t₁ : ℤ) ≤ (k : ℤ) * (t₁ : ℤ) :=
            mul_le_mul_of_nonneg_right hle (by positivity)
          dsimp [B_k]
          linarith
      have hterm3 : traceLM F hE'K₁ (δ_AS * ((Δ : K₁) ^ r)) = 0 ∨
          B_k ≤ valL F E' (traceLM F hE'K₁ (δ_AS * ((Δ : K₁) ^ r))) := by
        apply htr_E'K₁ B_k (δ_AS * ((Δ : K₁) ^ r))
        have hΔr_bound : (Δ : K₁) ^ r = 0 ∨ -(r : ℤ) * (t₁ : ℤ) ≤ valL F K₁ ((Δ : K₁) ^ r) := by
          right; rw [(hval_pow_Δ r).2]
        have h_prod := hmul_K₁ ((p * (p - 1) * t₂ : ℕ) : ℤ) (-(r : ℤ) * (t₁ : ℤ))
          δ_AS ((Δ : K₁) ^ r) hΔ_as_t₂' hΔr_bound
        rcases h_prod with h0 | hge
        · exact Or.inl h0
        · right
          have hBk_nonpos : B_k ≤ 0 := by
            have hle : ((p - 1 : ℕ) : ℤ) ≤ (k : ℤ) := by exact_mod_cast (by omega : p - 1 ≤ k)
            have hmul : ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ (k : ℤ) * (t₁ : ℤ) :=
              mul_le_mul_of_nonneg_right hle (by positivity)
            dsimp [B_k]
            linarith
          have hpBk_nonpos : (p : ℤ) * B_k ≤ 0 :=
            mul_nonpos_of_nonneg_of_nonpos (by positivity) hBk_nonpos
          have hsub_nonneg : 0 ≤ ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) := by positivity
          have hr_le_ppt : r * t₁ ≤ p * (p - 1) * t₂ := by
            have h1 : r ≤ p * (p - 1) := by
              have : 1 ≤ p - 1 := by omega
              have : p ≤ p * (p - 1) := Nat.le_mul_of_pos_right p this
              omega
            exact Nat.mul_le_mul h1 ht_le
          have hr_le_int : (r : ℤ) * (t₁ : ℤ) ≤ ((p * (p - 1) * t₂ : ℕ) : ℤ) := by
            exact_mod_cast hr_le_ppt
          linarith
      exact hvalE'_add B_k _ _ (hvalE'_add B_k _ _ hterm1 hterm2) hterm3

  
  have hTwistedTr : ∀ (Y : E') (i : ℕ), i ∈ Finset.Icc 1 (p - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))) := by
    intro Y i hi
    obtain ⟨hi1, hip1⟩ := Finset.mem_Icc.mp hi
    by_cases hY : Y = 0
    · exact Or.inl hY
    · right
      set T_i : M₁' := traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))
      by_cases hT_i : T_i = 0
      · exact Or.inl hT_i
      · right
        by_contra hlt
        push_neg at hlt
        let u_T : M₁'ˣ := Units.mk0 T_i hT_i
        have hval_inv_Ti : valL F M₁' (T_i⁻¹) = - valL F M₁' T_i := by
          simpa [u_T] using hvalM₁'_inv u_T
        have hinv_ne0 : T_i⁻¹ ≠ 0 := inv_ne_zero hT_i
        let θ : M₁' := T_i⁻¹ * y₁_M₁'
        have hval_θ : valL F M₁' θ =
            - valL F M₁' T_i - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) := by
          dsimp [θ, t₁]
          rw [hvalM₁'_mul (T_i⁻¹) y₁_M₁' hinv_ne0 hy₁M₁'_ne0, hval_inv_Ti, hy₁M₁'_val]
          ring
        obtain ⟨Y_θ, hY_θ_eq, _⟩ := hΔ_basis (IntermediateField.inclusion hM₁'K₁ θ)
        have hY_θ_val := hCoeffExtr θ Y_θ hY_θ_eq
        let S : Fin p → E' := fun j =>
          (Y * Y_θ j) * traceLM F hE'K₁ ((Δ : K₁) ^ ((j : ℕ) + i))
        have htr_sum_eq_one : traceLM F hLE' (∑ j : Fin p, S j) = 1 := by
          have h1 : traceLM F hLM₁' (traceLM F hM₁'K₁
              (IntermediateField.inclusion hM₁'K₁ θ *
                (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)))) = 1 := by
            rw [htr_smul hM₁'K₁ θ _,
              show traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = T_i from rfl]
            have hθT : θ * T_i = y₁_M₁' := by
              dsimp [θ]
              rw [mul_comm, mul_inv_cancel_left₀ hT_i]
            rw [hθT, hy₁M₁'_tr]
          have h2 : traceLM F hLE' (traceLM F hE'K₁
              (IntermediateField.inclusion hM₁'K₁ θ *
                (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)))) = 1 := by
            rw [(hTowerNormTr _).2, h1]
          have h3 : traceLM F hE'K₁
              (IntermediateField.inclusion hM₁'K₁ θ *
                (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))) =
              ∑ j : Fin p, S j := by
            rw [hY_θ_eq, Finset.sum_mul, map_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            have hmul_eq :
                (IntermediateField.inclusion hE'K₁ (Y_θ j) * ((Δ : K₁) ^ (j : ℕ))) *
                  (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) =
                IntermediateField.inclusion hE'K₁ (Y * Y_θ j) * ((Δ : K₁) ^ ((j : ℕ) + i)) := by
              rw [map_mul, pow_add]
              ring
            rw [hmul_eq, htr_smul hE'K₁ (Y * Y_θ j) ((Δ : K₁) ^ ((j : ℕ) + i))]
          rwa [← h3]
        have hbE'_mul : ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) =
            ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + (p : ℤ) - 1 := by
          have hbE'_eq : (bE' : ℤ) = (t₂ : ℤ) + 1 := by dsimp [t₂]; omega
          have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
          rw [hbE'_eq, mul_add, mul_one, hp_sub]
          ring
        have hS_bound : ∀ j ∈ (Finset.univ : Finset (Fin p)),
            S j = 0 ∨
              (p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ valL F E' (S j) := by
          intro j _
          have hji_mem : (j : ℕ) + i ∈ Finset.Icc 1 (2 * p - 2) := by
            rw [Finset.mem_Icc]
            have hj_lt : (j : ℕ) < p := j.2
            omega
          have hYY_bound : Y * Y_θ j = 0 ∨
              (valL F E' Y + (valL F M₁' θ + (j : ℤ) * (t₁ : ℤ))) ≤ valL F E' (Y * Y_θ j) :=
            hmul_E' (valL F E' Y) (valL F M₁' θ + (j : ℤ) * (t₁ : ℤ)) Y (Y_θ j)
              (Or.inr le_rfl) (hY_θ_val j)
          have htr_bound := hPowTr_E'K₁ ((j : ℕ) + i) hji_mem
          have hSj := hmul_E'
            (valL F E' Y + (valL F M₁' θ + (j : ℤ) * (t₁ : ℤ)))
            (((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) - (((j : ℕ) + i : ℕ) : ℤ) * (t₁ : ℤ))
            (Y * Y_θ j) (traceLM F hE'K₁ ((Δ : K₁) ^ ((j : ℕ) + i)))
            hYY_bound htr_bound
          rcases hSj with h0 | hge
          · exact Or.inl h0
          · right
            have hji_cast : (((j : ℕ) + i : ℕ) : ℤ) * (t₁ : ℤ) =
                (j : ℤ) * (t₁ : ℤ) + (i : ℤ) * (t₁ : ℤ) := by
              push_cast
              ring
            rw [hji_cast] at hge
            linarith
        have hsum_bound := @hsum_E' (Fin p) Finset.univ S
          ((p : ℤ) * 1 - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ)) hS_bound
        have htr_L := htr_LE' 1 (∑ j : Fin p, S j) hsum_bound
        rw [htr_sum_eq_one, hvalL_1] at htr_L
        rcases htr_L with h10 | h1le0
        · exact one_ne_zero h10
        · omega

  have hTr_M₁'K₁_pow : ∀ i ∈ Finset.Icc 1 (p - 1),
      traceLM F hM₁'K₁ ((Δ : K₁) ^ i) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ i)) := by
    intro i hi
    have h := hTwistedTr 1 i hi
    rw [map_one, one_mul, hvalE'_1, add_zero] at h
    exact h.resolve_left one_ne_zero

  
  let K₁' := IntermediateField.extendScalars hM₁'K₁
  have hFinM₁'K₁' : FiniteDimensional M₁' K₁' := by
    haveI : FiniteDimensional F K₁' := ‹FiniteDimensional F K₁›
    haveI : IsScalarTower F M₁' K₁' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F M₁' K₁'
  haveI : FiniteDimensional M₁' K₁' := hFinM₁'K₁'
  have hGalM₁'K₁' : IsGalois M₁' ↥K₁' := by
    have hSepM₁'K₁' : Algebra.IsSeparable M₁' K₁' := hGalM₁'K₁.2.2.2 hM₁'K₁
    haveI : Algebra.IsSeparable M₁' K₁' := hSepM₁'K₁'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal M₁' (AlgebraicClosure F) := Normal.tower_top_of_normal F M₁' (AlgebraicClosure F)
    have hK₁'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[M₁'] AlgebraicClosure F),
        (∀ x ∈ K₁', τ x = x) → ∀ x ∈ K₁', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : M₁'.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M₁').symm σ
      let τ_F : M₁'.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M₁').symm τ
      have hτK₁ : τ_F.1 ∈ K₁.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hM₁'K₁).mpr hx)
      have hconjK₁ : (σ_F * τ_F * σ_F⁻¹).1 ∈ K₁.fixingSubgroup :=
        hGalM₁'K₁.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK₁
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK₁
      exact hconjK₁ x ((IntermediateField.mem_extendScalars hM₁'K₁).mp hx)
    exact helper_isGalois M₁' (AlgebraicClosure F) K₁' hK₁'_norm_fix
  haveI : IsGalois M₁' ↥K₁' := hGalM₁'K₁'
  let G : Type u := (K₁' ≃ₐ[M₁'] K₁')
  have hcard_G : Fintype.card G = Module.finrank M₁' K₁' :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank M₁' K₁')
  let fromExtendScalars : K₁' →+* K₁ :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hM₁'K₁).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → K₁ → K₁ := fun σ w => fromExtendScalars (σ (toExtendScalars F hM₁'K₁ w))
  have hact_one : ∀ w : K₁, act 1 w = w := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (w : K₁), act (σ * τ) w = act σ (act τ w) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ w₁ w₂ : K₁,
        act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
        act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
        act σ (-w₁) = -act σ w₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun w₁ w₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (z : M₁'),
      act σ (IntermediateField.inclusion hM₁'K₁ z) = IntermediateField.inclusion hM₁'K₁ z := by
    intro σ z
    change fromExtendScalars (σ (algebraMap M₁' K₁' z)) = IntermediateField.inclusion hM₁'K₁ z
    rw [σ.commutes z]
    rfl
  have hact_trace : ∀ w : K₁,
      IntermediateField.inclusion hM₁'K₁ (traceLM F hM₁'K₁ w) = ∑ σ : G, act σ w := by
    intro w
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := M₁') (L := K₁') (toExtendScalars F hM₁'K₁ w))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hM₁'K₁ w)) Finset.univ)
  have hact_norm : ∀ w : K₁,
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) = ∏ σ : G, act σ w := by
    intro w
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms M₁' (toExtendScalars F hM₁'K₁ w))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hM₁'K₁ w)) Finset.univ)
  let ι_M₁' := IntermediateField.inclusion hM₁'K₁
  have hι_M₁'_inj : Function.Injective ι_M₁' := (IntermediateField.inclusion hM₁'K₁).injective
  have hnorm_act : ∀ (σ : G) (w : K₁), normLM F hM₁'K₁ (act σ w) = normLM F hM₁'K₁ w := by
    intro σ w
    apply hι_M₁'_inj
    rw [hact_norm (act σ w), hact_norm w]
    have hmul : (∏ τ : G, act τ (act σ w)) = ∏ τ : G, act (τ * σ) w := by
      refine Finset.prod_congr rfl fun τ _ => ?_
      rw [hact_mul]
    rw [hmul]
    exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => act τ w)
  have hact_val : ∀ (σ : G) (w : K₁), valL F K₁ (act σ w) = valL F K₁ w := by
    intro σ w
    rw [← hval_norm_M₁'K₁ (act σ w), hnorm_act σ w, hval_norm_M₁'K₁ w]

  obtain ⟨s, hs_one, _, _, _, hs_poly⟩ :=
    hSymm_M₁'K₁ G act hcard_G hact_one hact_mul hact_ring hact_incl hact_val hact_trace hact_norm
  obtain ⟨hs_incl, hs_cayley⟩ :=
    hCayley_M₁'K₁ G act s hcard_G hact_one hact_ring hact_incl hact_norm hs_poly
  let e_Δ : ℕ → M₁' := fun i => s (Δ : K₁) i
  have he_Δ_1 : e_Δ 1 = traceLM F hM₁'K₁ (Δ : K₁) := hs_one (Δ : K₁)
  have he_Δ_poly : ∀ c : M₁',
      normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * (Δ : K₁)) =
        1 + (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e_Δ i) + c ^ p * b := by
    intro c
    have h := hs_poly (Δ : K₁) c
    rwa [hdegM₁'K₁] at h
  have he_Δ_cayley :
      IntermediateField.inclusion hM₁'K₁ b -
        ((Δ : K₁) ^ p +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0 := by
    have hcay := hs_cayley (Δ : K₁)
    rw [hdegM₁'K₁] at hcay
    have hsum_neg :
        (∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) =
        - ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : K₁) ^ (i - 1) * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i)) := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi1 : 1 ≤ i := (Finset.mem_Icc.mp hi).1
      have hpow : (-1 : K₁) ^ i = - ((-1 : K₁) ^ (i - 1)) := by
        have h1 : (-1 : K₁) ^ ((i - 1) + 1) = - ((-1 : K₁) ^ (i - 1)) := by
          rw [pow_succ]
          ring
        rwa [Nat.sub_add_cancel hi1] at h1
      rw [hpow]
      ring
    rw [hsum_neg]
    dsimp [b, e_Δ] at hcay ⊢
    rw [hcay]
    ring

  
  let φ_G : G → (K₁ →+* K₁) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun w₁ w₂ => ((hact_ring σ).2.2 w₁ w₂).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun w₁ w₂ => ((hact_ring σ).2.2 w₁ w₂).1 }
  have hact_pow : ∀ (σ : G) (m : ℕ), act σ ((Δ : K₁) ^ m) = (act σ (Δ : K₁)) ^ m :=
    fun σ m => map_pow (φ_G σ) (Δ : K₁) m
  let U_G : Finset G := Finset.univ
  let P_card : ℕ → Finset (Finset G) := fun r => U_G.powerset.filter (fun S => S.card = r)
  let P_Δ : Finset G → K₁ := fun S => ∏ σ ∈ S, act σ (Δ : K₁)
  let E_Δ : ℕ → K₁ := fun j => ∑ S ∈ P_card j, P_Δ S
  let T_pow : ℕ → K₁ := fun m => ∑ τ ∈ U_G, (act τ (Δ : K₁)) ^ m
  have hmem_P : ∀ (r : ℕ) (S : Finset G), S ∈ P_card r ↔ S.card = r := by
    intro r S; simp [P_card, U_G]
  have hT_pow_eq : ∀ m : ℕ, T_pow m = ι_M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ m)) := by
    intro m
    dsimp only [T_pow, U_G, ι_M₁']
    rw [hact_trace ((Δ : K₁) ^ m)]
    refine Finset.sum_congr rfl fun τ _ => (hact_pow τ m).symm
  have hE_eq_e : ∀ {j : ℕ}, j ∈ Finset.Icc 1 (p - 1) → E_Δ j = ι_M₁' (e_Δ j) := by
    intro j hj
    have hj' : j ∈ Finset.Icc 1 (Module.finrank M₁' K₁' - 1) := by
      rwa [hdegM₁'K₁]
    exact (hs_incl (Δ : K₁) j hj').symm
  let A_Δ : ℕ → ℕ → K₁ := fun j m =>
    ∑ τ ∈ U_G, ∑ S ∈ (P_card j).filter (fun S => τ ∈ S), P_Δ S * (act τ (Δ : K₁)) ^ m
  let B_Δ : ℕ → ℕ → K₁ := fun j m =>
    ∑ τ ∈ U_G, ∑ S ∈ (P_card j).filter (fun S => τ ∉ S), P_Δ S * (act τ (Δ : K₁)) ^ m
  have hET_split : ∀ j m : ℕ, E_Δ j * T_pow m = A_Δ j m + B_Δ j m := by
    intro j m
    dsimp only [E_Δ, T_pow, A_Δ, B_Δ]
    rw [Finset.sum_mul_sum, Finset.sum_comm, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun τ _ => ?_
    exact (Finset.sum_filter_add_sum_filter_not (P_card j) (fun S => τ ∈ S)
      (fun S => P_Δ S * (act τ (Δ : K₁)) ^ m)).symm
  have hBA : ∀ j m : ℕ, B_Δ j (m + 1) = A_Δ (j + 1) m := by
    intro j m
    dsimp only [B_Δ, A_Δ]
    refine Finset.sum_congr rfl fun τ _ => ?_
    refine Finset.sum_bij (fun S _ => insert τ S) ?_ ?_ ?_ ?_
    · intro S hS
      rw [Finset.mem_filter, hmem_P] at hS
      rw [Finset.mem_filter, hmem_P]
      exact ⟨by rw [Finset.card_insert_of_notMem hS.2, hS.1], Finset.mem_insert_self τ S⟩
    · intro S₁ hS₁ S₂ hS₂ heq
      dsimp only at heq
      rw [Finset.mem_filter] at hS₁ hS₂
      have h := congrArg (fun T : Finset G => T.erase τ) heq
      dsimp only at h
      rwa [Finset.erase_insert hS₁.2, Finset.erase_insert hS₂.2] at h
    · intro T hT
      rw [Finset.mem_filter, hmem_P] at hT
      refine ⟨T.erase τ, ?_, Finset.insert_erase hT.2⟩
      rw [Finset.mem_filter, hmem_P]
      refine ⟨?_, Finset.notMem_erase τ T⟩
      rw [Finset.card_erase_of_mem hT.2, hT.1]
      rfl
    · intro S hS
      rw [Finset.mem_filter] at hS
      have hP_ins : P_Δ (insert τ S) = act τ (Δ : K₁) * P_Δ S := Finset.prod_insert hS.2
      rw [hP_ins, pow_succ]
      ring
  have hP1_filter : ∀ τ : G, (P_card 1).filter (fun S => τ ∈ S) = {{τ}} := by
    intro τ
    ext S
    simp only [Finset.mem_filter, hmem_P, Finset.mem_singleton]
    constructor
    · rintro ⟨hcard1, hτ⟩
      obtain ⟨σ, rfl⟩ := Finset.card_eq_one.mp hcard1
      rw [Finset.mem_singleton.mp hτ]
    · rintro rfl
      exact ⟨Finset.card_singleton τ, Finset.mem_singleton_self τ⟩
  have hA_one : ∀ m : ℕ, A_Δ 1 m = T_pow (m + 1) := by
    intro m
    dsimp only [A_Δ, T_pow, P_Δ]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [hP1_filter τ, Finset.sum_singleton, Finset.prod_singleton, pow_succ']
  have hA_zero : ∀ k : ℕ, A_Δ k 0 = (k : K₁) * E_Δ k := by
    intro k
    dsimp only [A_Δ, E_Δ]
    have h1 : (∑ τ ∈ U_G, ∑ S ∈ (P_card k).filter (fun S => τ ∈ S), P_Δ S * (act τ (Δ : K₁)) ^ 0) =
        ∑ τ ∈ U_G, ∑ S ∈ P_card k, if τ ∈ S then P_Δ S else 0 := by
      refine Finset.sum_congr rfl fun τ _ => ?_
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun S _ => ?_
      rw [pow_zero, mul_one]
    rw [h1, Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun S hS => ?_
    rw [← Finset.sum_filter]
    have hU_S : U_G.filter (fun τ => τ ∈ S) = S := by ext τ; simp [U_G]
    rw [hU_S, Finset.sum_const, nsmul_eq_mul, (hmem_P k S).mp hS]
  have h_telescope : ∀ (f : ℕ → K₁) (n : ℕ),
      (∑ j ∈ Finset.Icc 1 n, (f j - f (j + 1))) = f 1 - f (n + 1) := by
    intro f n
    induction n with
    | zero => simp
    | succ m ih =>
      rw [Finset.sum_Icc_succ_top (Nat.le_add_left 1 m), ih]
      ring
  have hNewton_K₁ : ∀ {k : ℕ}, 1 ≤ k →
      (∑ j ∈ Finset.Icc 1 (k - 1), (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j)) =
        T_pow k - (-1 : K₁) ^ (k - 1) * (k : K₁) * E_Δ k := by
    intro k hk
    let F_k : ℕ → K₁ := fun j => (-1 : K₁) ^ (j - 1) * A_Δ j (k - j)
    have hterm : ∀ j ∈ Finset.Icc 1 (k - 1),
        (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j) = F_k j - F_k (j + 1) := by
      intro j hj
      obtain ⟨hj1, hjk⟩ := Finset.mem_Icc.mp hj
      have hk_sub : k - j = (k - (j + 1)) + 1 := by omega
      have hj_pow : (-1 : K₁) ^ ((j + 1) - 1) = (-1 : K₁) ^ (j - 1) * (-1 : K₁) := by
        have hj_eq : (j + 1) - 1 = (j - 1) + 1 := by omega
        rw [hj_eq, pow_succ]
      dsimp only [F_k]
      rw [mul_assoc, hET_split j (k - j), hk_sub, hBA j (k - (j + 1)), ← hk_sub, hj_pow]
      ring
    rw [Finset.sum_congr rfl hterm, h_telescope F_k (k - 1)]
    dsimp only [F_k]
    have hk1 : (k - 1) + 1 = k := Nat.sub_add_cancel hk
    rw [hk1, Nat.sub_self 1, pow_zero, one_mul, hA_one (k - 1), hk1, Nat.sub_self k, hA_zero k, mul_assoc]
  have hNewton_M₁' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      (-1 : M₁') ^ (k - 1) * ((k : ℕ) : M₁') * e_Δ k =
        traceLM F hM₁'K₁ ((Δ : K₁) ^ k) -
          ∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j)) := by
    intro k hk
    obtain ⟨hk1, hkp1⟩ := Finset.mem_Icc.mp hk
    apply hι_M₁'_inj
    have hL : ι_M₁' ((-1 : M₁') ^ (k - 1) * ((k : ℕ) : M₁') * e_Δ k) =
        (-1 : K₁) ^ (k - 1) * (k : K₁) * E_Δ k := by
      rw [map_mul, map_mul, map_pow, map_neg, map_one, map_natCast, ← hE_eq_e hk]
    have hR : ι_M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ k) -
        ∑ j ∈ Finset.Icc 1 (k - 1),
          (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j))) =
        T_pow k - ∑ j ∈ Finset.Icc 1 (k - 1), (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j) := by
      rw [map_sub, ← hT_pow_eq k, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun j hj => ?_
      obtain ⟨hj1, hjk1⟩ := Finset.mem_Icc.mp hj
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      rw [map_mul, map_mul, map_pow, map_neg, map_one, ← hE_eq_e hj_mem, ← hT_pow_eq (k - j)]
    rw [hL, hR, hNewton_K₁ hk1]
    ring

  
  have hp_valM₁' : ((p : ℕ) : M₁') = 0 ∨ 1 ≤ valL F M₁' ((p : ℕ) : M₁') := by
    have hincl_p : ι_M₁' ((p : ℕ) : M₁') = ((p : ℕ) : K₁) := map_natCast ι_M₁' p
    rcases hp_valK₁ with h0 | hge
    · left
      apply hι_M₁'_inj
      rw [hincl_p, h0, map_zero]
    · right
      rw [← hincl_p, hval_M₁'K₁ ((p : ℕ) : M₁')] at hge
      have hp_le : (p : ℤ) * 1 ≤ ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) := by
        have h_nat : p * 1 ≤ p * (p - 1) * (bE' - 1) := by
          have h1 : 1 ≤ (p - 1) * (bE' - 1) := Nat.mul_pos (by omega) (by omega)
          have h2 : p * 1 ≤ p * ((p - 1) * (bE' - 1)) := Nat.mul_le_mul_left p h1
          rwa [← mul_assoc] at h2
        exact_mod_cast h_nat
      have hmul_le : (p : ℤ) * 1 ≤ (p : ℤ) * valL F M₁' ((p : ℕ) : M₁') := le_trans hp_le hge
      have hp_pos_int : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
      exact le_of_mul_le_mul_left hmul_le hp_pos_int

  have hcoprime_val_M₁' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      ((k : ℕ) : M₁') ≠ 0 ∧ valL F M₁' ((k : ℕ) : M₁') = 0 := by
    intro k hk
    obtain ⟨hk1, hkp1⟩ := Finset.mem_Icc.mp hk
    have hnot_ge1 : ¬ (((k : ℕ) : M₁') = 0 ∨ 1 ≤ valL F M₁' ((k : ℕ) : M₁')) := by
      intro hk_bad
      have hndvd : ¬ (p ∣ k) := Nat.not_dvd_of_pos_of_lt hk1 (by omega)
      have hcop : Nat.Coprime p k := (Nat.Prime.coprime_iff_not_dvd hPrime).mpr hndvd
      have hgcd : Nat.gcd k p = 1 := Nat.Coprime.gcd_eq_one hcop.symm
      have hbez_int : (1 : ℤ) = (k : ℤ) * Nat.gcdA k p + (p : ℤ) * Nat.gcdB k p := by
        have h := Nat.gcd_eq_gcd_ab k p
        rw [hgcd] at h
        simpa using h
      have hbez_M₁' : (1 : M₁') =
          ((k : ℕ) : M₁') * (Nat.gcdA k p : M₁') + ((p : ℕ) : M₁') * (Nat.gcdB k p : M₁') := by
        have h := congrArg (Int.cast : ℤ → M₁') hbez_int
        push_cast at h
        exact h
      have hterm1 : ((k : ℕ) : M₁') * (Nat.gcdA k p : M₁') = 0 ∨
          1 ≤ valL F M₁' (((k : ℕ) : M₁') * (Nat.gcdA k p : M₁')) := by
        have h := hmul_M₁' 1 0 ((k : ℕ) : M₁') (Nat.gcdA k p : M₁') hk_bad (hint_M₁' (Nat.gcdA k p))
        rwa [add_zero] at h
      have hterm2 : ((p : ℕ) : M₁') * (Nat.gcdB k p : M₁') = 0 ∨
          1 ≤ valL F M₁' (((p : ℕ) : M₁') * (Nat.gcdB k p : M₁')) := by
        have h := hmul_M₁' 1 0 ((p : ℕ) : M₁') (Nat.gcdB k p : M₁') hp_valM₁' (hint_M₁' (Nat.gcdB k p))
        rwa [add_zero] at h
      have hsum := hvalM₁'_add 1 _ _ hterm1 hterm2
      rw [← hbez_M₁', hvalM₁'_1] at hsum
      rcases hsum with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    rcases hnat_M₁' k with hk0 | hk_ge0
    · exact False.elim (hnot_ge1 (Or.inl hk0))
    · refine ⟨fun hk0 => hnot_ge1 (Or.inl hk0), ?_⟩
      have hk_lt1 : valL F M₁' ((k : ℕ) : M₁') < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot_ge1 (Or.inr hge1)
      omega

  have hval_neg1_pow_M₁' : ∀ m : ℕ,
      (-1 : M₁') ^ m ≠ 0 ∧ valL F M₁' ((-1 : M₁') ^ m) = 0 := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero]
      exact ⟨one_ne_zero, hvalM₁'_1⟩
    | succ m ih =>
      rw [pow_succ]
      have hneg1_ne0 : (-1 : M₁') ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hne : (-1 : M₁') ^ m * (-1 : M₁') ≠ 0 := mul_ne_zero ih.1 hneg1_ne0
      refine ⟨hne, ?_⟩
      rw [hvalM₁'_mul _ _ ih.1 hneg1_ne0, ih.2, hvalM₁'_neg1, add_zero]

  
  have he_Δ_val : ∀ k ∈ Finset.Icc 1 (p - 1),
      e_Δ k = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤ valL F M₁' (e_Δ k) := by
    intro k hk
    induction' k using Nat.strong_induction_on with k ih
    obtain ⟨hk1, hkp1⟩ := Finset.mem_Icc.mp hk
    let B_k : ℤ := ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ)
    have hsum_val :
        (∑ j ∈ Finset.Icc 1 (k - 1),
          (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j))) = 0 ∨
        B_k ≤ valL F M₁'
          (∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j))) := by
      apply @hsum_M₁' ℕ (Finset.Icc 1 (k - 1))
        (fun j => (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j))) B_k
      intro j hj
      obtain ⟨hj1, hjk1⟩ := Finset.mem_Icc.mp hj
      have hj_lt : j < k := by omega
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      have hkj_mem : k - j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hej := ih j hj_lt hj_mem
      have htr_kj := hTr_M₁'K₁_pow (k - j) hkj_mem
      have hneg_j : (-1 : M₁') ^ (j - 1) = 0 ∨ 0 ≤ valL F M₁' ((-1 : M₁') ^ (j - 1)) :=
        Or.inr (by rw [(hval_neg1_pow_M₁' (j - 1)).2])
      have h1 := hmul_M₁' 0 (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (j : ℤ) * (t₁ : ℤ))
        ((-1 : M₁') ^ (j - 1)) (e_Δ j) hneg_j hej
      have h2 := hmul_M₁'
        (0 + (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (j : ℤ) * (t₁ : ℤ)))
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((k - j : ℕ) : ℤ) * (t₁ : ℤ))
        ((-1 : M₁') ^ (j - 1) * e_Δ j) (traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j)))
        h1 htr_kj
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right
        have hkj_cast : ((k - j : ℕ) : ℤ) = (k : ℤ) - (j : ℤ) := Nat.cast_sub (by omega)
        have ht₂_nonneg : 0 ≤ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by positivity
        rw [hkj_cast, sub_mul] at hge
        dsimp [B_k]
        linarith
    have hneg_sum_val :
        - (∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j))) = 0 ∨
        B_k ≤ valL F M₁'
          (- (∑ j ∈ Finset.Icc 1 (k - 1),
              (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ (k - j)))) := by
      rcases hsum_val with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hvalM₁'_neg]; exact hge
    have hrhs_val :
        (-1 : M₁') ^ (k - 1) * ((k : ℕ) : M₁') * e_Δ k = 0 ∨
          B_k ≤ valL F M₁' ((-1 : M₁') ^ (k - 1) * ((k : ℕ) : M₁') * e_Δ k) := by
      rw [hNewton_M₁' hk, sub_eq_add_neg]
      exact hvalM₁'_add B_k _ _ (hTr_M₁'K₁_pow k hk) hneg_sum_val
    obtain ⟨hneg_ne0, hneg_val0⟩ := hval_neg1_pow_M₁' (k - 1)
    obtain ⟨hk_ne0, hk_val0⟩ := hcoprime_val_M₁' hk
    have hcoeff_ne0 : (-1 : M₁') ^ (k - 1) * ((k : ℕ) : M₁') ≠ 0 := mul_ne_zero hneg_ne0 hk_ne0
    have hcoeff_val0 : valL F M₁' ((-1 : M₁') ^ (k - 1) * ((k : ℕ) : M₁')) = 0 := by
      rw [hvalM₁'_mul _ _ hneg_ne0 hk_ne0, hneg_val0, hk_val0, add_zero]
    by_cases hek0 : e_Δ k = 0
    · exact Or.inl hek0
    · right
      have hprod_ne0 : (-1 : M₁') ^ (k - 1) * ((k : ℕ) : M₁') * e_Δ k ≠ 0 :=
        mul_ne_zero hcoeff_ne0 hek0
      have hge := hrhs_val.resolve_left hprod_ne0
      rw [hvalM₁'_mul _ _ hcoeff_ne0 hek0, hcoeff_val0, zero_add] at hge
      exact hge

  
  have he_Δ_tr_p1 :
      traceLM F hM₁'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : M₁') * (- e_Δ (p - 1)) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * ((t₂ + (bE' - bM₁') : ℕ) : ℤ) ≤
          valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ (p - 1)) -
            ((p - 1 : ℕ) : M₁') * (- e_Δ (p - 1))) := by
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩
    obtain ⟨m_half, hm_half⟩ := hp_odd_nat
    have hp_sub2_odd : 2 * ((p - 3) / 2) + 1 = (p - 1) - 1 := by omega
    have hneg_p2 : (-1 : M₁') ^ ((p - 1) - 1) = -1 := by
      rw [← hp_sub2_odd, pow_succ, pow_mul, neg_one_sq, one_pow, one_mul]
    have hdiff_eq :
        traceLM F hM₁'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : M₁') * (- e_Δ (p - 1)) =
          ∑ j ∈ Finset.Icc 1 ((p - 1) - 1),
            (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ ((p - 1) - j)) := by
      have hnewt := hNewton_M₁' hp1_mem
      rw [hneg_p2] at hnewt
      linear_combination -hnewt
    rw [hdiff_eq]
    apply @hsum_M₁' ℕ (Finset.Icc 1 ((p - 1) - 1))
      (fun j => (-1 : M₁') ^ (j - 1) * e_Δ j * traceLM F hM₁'K₁ ((Δ : K₁) ^ ((p - 1) - j)))
      (((p - 1 : ℕ) : ℤ) * ((t₂ + (bE' - bM₁') : ℕ) : ℤ))
    intro j hj
    obtain ⟨hj1, hjp2⟩ := Finset.mem_Icc.mp hj
    have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
    have hpj_mem : (p - 1) - j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    have hej := he_Δ_val j hj_mem
    have htr_pj := hTr_M₁'K₁_pow ((p - 1) - j) hpj_mem
    have hneg_j : (-1 : M₁') ^ (j - 1) = 0 ∨ 0 ≤ valL F M₁' ((-1 : M₁') ^ (j - 1)) :=
      Or.inr (by rw [(hval_neg1_pow_M₁' (j - 1)).2])
    have h1 := hmul_M₁' 0 (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (j : ℤ) * (t₁ : ℤ))
      ((-1 : M₁') ^ (j - 1)) (e_Δ j) hneg_j hej
    have h2 := hmul_M₁'
      (0 + (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (j : ℤ) * (t₁ : ℤ)))
      (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (((p - 1) - j : ℕ) : ℤ) * (t₁ : ℤ))
      ((-1 : M₁') ^ (j - 1) * e_Δ j) (traceLM F hM₁'K₁ ((Δ : K₁) ^ ((p - 1) - j)))
      h1 htr_pj
    rcases h2 with h0 | hge
    · exact Or.inl h0
    · right
      have hpj_cast : (((p - 1) - j : ℕ) : ℤ) = ((p - 1 : ℕ) : ℤ) - (j : ℤ) :=
        Nat.cast_sub (by omega)
      have ht_diff : ((t₂ + (bE' - bM₁') : ℕ) : ℤ) = 2 * (t₂ : ℤ) - (t₁ : ℤ) := by
        dsimp [t₁, t₂]
        omega
      rw [hpj_cast, sub_mul] at hge
      rw [ht_diff]
      linarith

  exact ⟨hTwistedTr, e_Δ, W_as, he_Δ_1, he_Δ_val, he_Δ_poly, he_Δ_cayley, he_Δ_tr_p1,
    hW_as_eq, hW_as_val⟩

theorem ld_ch12_wild_odd_tot_ram_norm_diff_as_expansion (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_basis : ∀ w : K₁, ∃ Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E',
      w = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            Y i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ))
    (hCoeffExtr : ∀ (θ : M₁') (Y : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E'),
      IntermediateField.inclusion hM₁'K₁ θ =
        ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) →
      ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        Y i = 0 ∨ valL F M₁' θ + (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F E' (Y i))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) -
          (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_cayley : IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ : K₁)) -
      ((Δ : K₁) ^ (Module.finrank L (IntermediateField.extendScalars hLE')) +
        ∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) *
            ((Δ : K₁) ^ (Module.finrank L (IntermediateField.extendScalars hLE') - i))) = 0)
    (W_as : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → E')
    (hW_as_eq : (Δ : K₁) ^ (Module.finrank L (IntermediateField.extendScalars hLE')) - (Δ : K₁) -
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) =
        ∑ l : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hE'K₁ (W_as l) * ((Δ : K₁) ^ (l : ℕ)))
    (hW_as_val : ∀ l : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
      W_as l = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) ≤
          valL F E' (W_as l)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    ∃ (Z : Fin p → E') (s₀ : E'),
      IntermediateField.inclusion hM₁'K₁ b - IntermediateField.inclusion hE'K₁ a =
        ∑ l : Fin p, IntermediateField.inclusion hE'K₁ (Z l) * ((Δ : K₁) ^ (l : ℕ)) ∧
      (s₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((bE' - bM₁' : ℕ) : ℤ) ≤ valL F E' s₀) ∧
      (IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) - IntermediateField.inclusion hE'K₁ s₀ = 0 ∨
        ((p * (p - 1) * (bE' - bM₁') + (p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) -
            IntermediateField.inclusion hE'K₁ s₀)) ∧
      (Z ⟨0, hPrime.pos⟩ = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) ≤ valL F E' (Z ⟨0, hPrime.pos⟩)) ∧
      (Z ⟨1, hPrime.one_lt⟩ - (1 - s₀) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F E' (Z ⟨1, hPrime.one_lt⟩ - (1 - s₀))) ∧
      (∀ l : Fin p, 2 ≤ (l : ℕ) →
        Z l = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (l : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) ≤
            valL F E' (Z l)) :=
by
  intro p t₁ t₂ a b
  have hp_def : p = Module.finrank L (IntermediateField.extendScalars hLE') := rfl
  have ht₁_def : t₁ = bM₁' - 1 := rfl
  have ht₂_def : t₂ = bE' - 1 := rfl
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := hPrime.pos
  have hp_one_lt : 1 < p := hPrime.one_lt
  have ht₁_ge1 : 1 ≤ t₁ := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by omega
  have ht_le : t₁ ≤ t₂ := by omega
  have heven_p1 : Even (p - 1) := by
    have hmod : p % 2 = 1 := (Nat.Prime.mod_two_eq_one_iff_ne_two hPrime).mpr hp_odd
    exact Nat.even_iff.mpr (by omega)
  have hneg1_p1 : (-1 : E') ^ (p - 1) = 1 := Even.neg_one_pow heven_p1
  let j₀ : Fin p := ⟨0, hp_pos⟩
  let j₁ : Fin p := ⟨1, hp_one_lt⟩
  rcases hvalE'_props with ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, _, _, hvalE'_add, _⟩
  rcases hvalK₁_props with ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, _, _, hvalK₁_add, _⟩
  have hvalE'_sum : ∀ {α : Type} (S : Finset α) (f : α → E') (m : ℤ),
      (∀ x ∈ S, f x = 0 ∨ m ≤ valL F E' (f x)) →
      ((∑ x ∈ S, f x) = 0 ∨ m ≤ valL F E' (∑ x ∈ S, f x)) := by
    intro α S f m hf
    induction S using Finset.cons_induction with
    | empty => exact Or.inl Finset.sum_empty
    | cons x s hx ih =>
      rw [Finset.sum_cons]
      exact hvalE'_add m (f x) (∑ y ∈ s, f y)
        (hf x (Finset.mem_cons_self x s))
        (ih (fun y hy => hf y (Finset.mem_cons.mpr (Or.inr hy))))
  have hvalK₁_sum : ∀ {α : Type} (S : Finset α) (f : α → K₁) (m : ℤ),
      (∀ x ∈ S, f x = 0 ∨ m ≤ valL F K₁ (f x)) →
      ((∑ x ∈ S, f x) = 0 ∨ m ≤ valL F K₁ (∑ x ∈ S, f x)) := by
    intro α S f m hf
    induction S using Finset.cons_induction with
    | empty => exact Or.inl Finset.sum_empty
    | cons x s hx ih =>
      rw [Finset.sum_cons]
      exact hvalK₁_add m (f x) (∑ y ∈ s, f y)
        (hf x (Finset.mem_cons_self x s))
        (ih (fun y hy => hf y (Finset.mem_cons.mpr (Or.inr hy))))
  have hvalE'_neg_or : ∀ (m : ℤ) (x : E'),
      (x = 0 ∨ m ≤ valL F E' x) → (-x = 0 ∨ m ≤ valL F E' (-x)) := by
    intro m x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · rw [hvalE'_neg]
      exact Or.inr hx
  have hvalE'_sign_mul : ∀ (i : ℕ) (m : ℤ) (x : E'),
      (x = 0 ∨ m ≤ valL F E' x) →
      ((-1 : E') ^ i * x = 0 ∨ m ≤ valL F E' ((-1 : E') ^ i * x)) := by
    intro i m x hx
    rcases Nat.even_or_odd i with hi | hi
    · rw [Even.neg_one_pow hi, one_mul]
      exact hx
    · rw [Odd.neg_one_pow hi, neg_one_mul]
      exact hvalE'_neg_or m x hx
  have ha_val : valL F E' a = -(t₁ : ℤ) := by
    change valL F E' (normLM F hE'K₁ (Δ : K₁)) = -((bM₁' - 1 : ℕ) : ℤ)
    rw [hval_norm_E'K₁, hΔ_val]
  have ha_val_mul : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ m ≤ valL F E' y) →
      (y * a = 0 ∨ m - (t₁ : ℤ) ≤ valL F E' (y * a)) := by
    intro m y hy
    by_cases hy0 : y = 0
    · rw [hy0, zero_mul]; exact Or.inl rfl
    · by_cases ha0 : a = 0
      · rw [ha0, mul_zero]; exact Or.inl rfl
      · rcases hy with rfl | hy
        · contradiction
        · right
          rw [hvalE'_mul y a hy0 ha0, ha_val]
          linarith
  have hvalK₁_mul_or : ∀ (m₁ m₂ : ℤ) (x y : K₁),
      (x = 0 ∨ m₁ ≤ valL F K₁ x) →
      (y = 0 ∨ m₂ ≤ valL F K₁ y) →
      (x * y = 0 ∨ m₁ + m₂ ≤ valL F K₁ (x * y)) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · rw [hx0, zero_mul]; exact Or.inl rfl
    · by_cases hy0 : y = 0
      · rw [hy0, mul_zero]; exact Or.inl rfl
      · rcases hx with rfl | hx
        · contradiction
        · rcases hy with rfl | hy
          · contradiction
          · right
            rw [hvalK₁_mul x y hx0 hy0]
            linarith
  have hΔ_pow_val : ∀ k : ℕ,
      (Δ : K₁) ^ k ≠ 0 ∧ valL F K₁ ((Δ : K₁) ^ k) = - (k : ℤ) * (t₁ : ℤ) := by
    intro k
    induction k with
    | zero =>
      simp [hvalK₁_1]
    | succ k ih =>
      have hΔ_ne0 : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
      have hpow_ne0 : (Δ : K₁) ^ (k + 1) ≠ 0 := pow_ne_zero (k + 1) hΔ_ne0
      refine ⟨hpow_ne0, ?_⟩
      rw [pow_succ, hvalK₁_mul _ _ ih.1 hΔ_ne0, ih.2, hΔ_val]
      change - (k : ℤ) * (t₁ : ℤ) + - (t₁ : ℤ) = - ((k + 1 : ℕ) : ℤ) * (t₁ : ℤ)
      push_cast
      ring
  have hval_incl_E'K₁ : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ m ≤ valL F E' y) →
      (IntermediateField.inclusion hE'K₁ y = 0 ∨
        (p : ℤ) * m ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ y)) := by
    intro m y hy
    rcases hy with rfl | hy
    · rw [map_zero]; exact Or.inl rfl
    · right
      rw [hval_E'K₁ y]
      change (p : ℤ) * m ≤ (p : ℤ) * valL F E' y
      nlinarith
  have hval_term_K₁ : ∀ (k : ℕ) (m : ℤ) (y : E'),
      (y = 0 ∨ m ≤ valL F E' y) →
      (IntermediateField.inclusion hE'K₁ y * ((Δ : K₁) ^ k) = 0 ∨
        (p : ℤ) * m - (k : ℤ) * (t₁ : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hE'K₁ y * ((Δ : K₁) ^ k))) := by
    intro k m y hy
    have h1 := hval_incl_E'K₁ m y hy
    have h2 : (Δ : K₁) ^ k = 0 ∨ - (k : ℤ) * (t₁ : ℤ) ≤ valL F K₁ ((Δ : K₁) ^ k) :=
      Or.inr (le_of_eq (hΔ_pow_val k).2.symm)
    have h3 := hvalK₁_mul_or ((p : ℤ) * m) (- (k : ℤ) * (t₁ : ℤ)) _ _ h1 h2
    rcases h3 with h3 | h3
    · exact Or.inl h3
    · right; linarith
  let C (i : ℕ) (j : Fin p) : E' :=
    if e_Δ i = 0 then 0
    else (hΔ_basis (IntermediateField.inclusion hM₁'K₁ (e_Δ i))).choose j
  have hC_eq : ∀ i : ℕ,
      IntermediateField.inclusion hM₁'K₁ (e_Δ i) =
        ∑ j : Fin p, IntermediateField.inclusion hE'K₁ (C i j) * ((Δ : K₁) ^ (j : ℕ)) := by
    intro i
    by_cases h0 : e_Δ i = 0
    · simp [C, h0]
    · have hspec := (hΔ_basis (IntermediateField.inclusion hM₁'K₁ (e_Δ i))).choose_spec.1
      simpa [C, h0] using hspec
  have hC_val : ∀ i ∈ Finset.Icc 1 (p - 1), ∀ j : Fin p,
