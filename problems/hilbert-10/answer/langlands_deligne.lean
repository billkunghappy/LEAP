  have hvalM₁'_inv_eq : ∀ (x : M₁') (hx : x ≠ 0), valL F M₁' x⁻¹ = - valL F M₁' x := by
    intro x hx
    exact hvalM₁'_inv (Units.mk0 x hx)
  
  have hσ_ψM₁' : ∀ z : M₁', ψM₁' (σ z) = ψM₁' z := by
    intro z
    let σ_M₁'' : (IntermediateField.extendScalars hLM₁') ≃ₐ[L]
        (IntermediateField.extendScalars hLM₁') :=
      { toFun := fun w =>
          ⟨(σ ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).1,
            (IntermediateField.mem_extendScalars hLM₁').mpr
              (σ ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).2⟩
        invFun := fun w =>
          ⟨(σ.symm ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).1,
            (IntermediateField.mem_extendScalars hLM₁').mpr
              (σ.symm ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).2⟩
        left_inv := fun w => Subtype.ext (congrArg Subtype.val (σ.left_inv _))
        right_inv := fun w => Subtype.ext (congrArg Subtype.val (σ.right_inv _))
