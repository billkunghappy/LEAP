    have ht₁_ge1 : 1 ≤ t₁ := by omega
    have ht₂_ge_t₁ : t₁ ≤ t₂ := by omega
    have ht₂_sub_t₁ : (t₂ : ℤ) - (t₁ : ℤ) = ((bE₀ - bM₀ : ℕ) : ℤ) := by omega
    choose C hC_eq hC_basis using fun i => hΔ_basis (ιM (e_Δ i))
    have hC_val : ∀ i ∈ Finset.Icc 1 (p - 1), ∀ j : Fin p,
        C i j = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (t₁ : ℤ) + ((j : ℕ) : ℤ) * (t₁ : ℤ) ≤
            vE (C i j) := by
      intro i hi j
      rcases he_Δ_val i hi with he0 | he_ge
      · have hinc0 : ιM (e_Δ i) = 0 := by rw [he0, map_zero]
        have hspec := (hC_basis i ((p : ℤ) * vE (C i j) - (j : ℤ) * (t₁ : ℤ) + 1)).mp
          (Or.inl hinc0) j
        rcases hspec with hC0 | hle
        · exact Or.inl hC0
        · omega
      · rcases hCoeffExtr (e_Δ i) (C i) (hC_eq i) j with hC0 | hle
        · exact Or.inl hC0
        · right; linarith only [he_ge, hle]
    let j₀ : Fin p := ⟨0, hPrime.pos⟩
    obtain ⟨s₀, hs₀_def⟩ : ∃ s₀ : E₀, s₀ = - C (p - 1) j₀ := ⟨_, rfl⟩
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]; omega
    have hs₀_val : s₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((bE₀ - bM₀ : ℕ) : ℤ) ≤ vE s₀ := by
      rcases hC_val (p - 1) hp1_mem j₀ with hC0 | hle
      · left; rw [hs₀_def, hC0, neg_zero]
      · right
        rw [hs₀_def, hvE_neg]
        change ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) + (0 : ℤ) * (t₁ : ℤ) ≤
          vE (C (p - 1) j₀) at hle
        nlinarith only [hle, ht₂_sub_t₁]
