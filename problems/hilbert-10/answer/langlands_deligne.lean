      have hT_sum : T = ∑ u₀ : Q_A,
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => V_Ω) u₀) ∘ₗ
            LinearMap.proj (R := Ω F) (φ := fun _ => V_Ω) u₀ := by
        apply LinearMap.ext
        intro φ
        have hφ : (∑ u₀ : Q_A, LinearMap.single (Ω F) (fun _ => V_Ω) u₀ (φ u₀)) = φ := by
          ext u₁
          simpa [LinearMap.single_apply] using congr_fun (Finset.univ_sum_single φ) u₁
        calc T φ = T (∑ u₀ : Q_A, LinearMap.single (Ω F) (fun _ => V_Ω) u₀ (φ u₀)) := by rw [hφ]
          _ = ∑ u₀ : Q_A, T (LinearMap.single (Ω F) (fun _ => V_Ω) u₀ (φ u₀)) := map_sum T _ _
          _ = (∑ u₀ : Q_A,
                (T ∘ₗ LinearMap.single (Ω F) (fun _ => V_Ω) u₀) ∘ₗ
                  LinearMap.proj (R := Ω F) (φ := fun _ => V_Ω) u₀) φ := by
            rw [LinearMap.sum_apply]
            rfl
      change LinearMap.trace (Ω F) (indSpace N_A ρ_A) (indRep N_A ρ_A w) = _
      rw [htr_conj, hT_sum, map_sum]
      apply Finset.sum_congr rfl
      intro u₀ _
      rw [LinearMap.trace_comp_comm']
      let x₀ : W := (cosetRep u₀)⁻¹ * w
      have hu_iff : u_fn x₀ = u₀ ↔ (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ N_A := by
        have hout : QuotientGroup.mk (cosetRep u₀) = u₀ := Quotient.out_eq u₀
        conv_lhs => rw [← hout]
        dsimp only [u_fn]
        rw [QuotientGroup.eq, inv_inv]
      by_cases h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ N_A
      · rw [dif_pos h_mem]
        have hu_eq : u_fn x₀ = u₀ := hu_iff.mpr h_mem
        have hr_eq : r_fn x₀ = cosetRep u₀ := by dsimp only [r_fn]; rw [hu_eq]
        have hB : LinearMap.proj (R := Ω F) (φ := fun _ => V_Ω) u₀ ∘ₗ
            (T ∘ₗ LinearMap.single (Ω F) (fun _ => V_Ω) u₀) =
            ρ_A ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩ := by
          apply LinearMap.ext
          intro v
          change ρ_A ⟨x₀ * r_fn x₀, h_xr_mem x₀⟩ (LinearMap.single (Ω F) (fun _ => V_Ω) u₀ v (u_fn x₀)) =
            ρ_A ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩ v
          rw [LinearMap.single_apply, hu_eq, Pi.single_eq_same]
          have h_sub : (⟨x₀ * r_fn x₀, h_xr_mem x₀⟩ : N_A) =
              ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩ := by
            apply Subtype.ext
            change x₀ * r_fn x₀ = (cosetRep u₀)⁻¹ * w * cosetRep u₀
            rw [hr_eq]
          rw [h_sub]
        rw [hB, h_tr_char]
      · rw [dif_neg h_mem]
        have hu_ne : u_fn x₀ ≠ u₀ := fun h_eq => h_mem (hu_iff.mp h_eq)
        have hB : LinearMap.proj (R := Ω F) (φ := fun _ => V_Ω) u₀ ∘ₗ
            (T ∘ₗ LinearMap.single (Ω F) (fun _ => V_Ω) u₀) = 0 := by
          apply LinearMap.ext
          intro v
          change ρ_A ⟨x₀ * r_fn x₀, h_xr_mem x₀⟩ (LinearMap.single (Ω F) (fun _ => V_Ω) u₀ v (u_fn x₀)) = 0
          rw [LinearMap.single_apply, Pi.single_eq_of_ne hu_ne, map_zero]
        rw [hB, map_zero]
    intro w
    rw [h_coset_trace w]
    by_cases hw_K₁ : (w : AbsGal F) ∈ K₁.fixingSubgroup
    · rw [dif_pos hw_K₁]
      let w_K₁ : relWeil F K₁ := ⟨w.1, w.2.1, hw_K₁⟩
      have h_each : ∀ u₀ : Q_A,
          (if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ N_A then
            (χA (e_A ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩) : Ω F)
          else 0) = (χK₁ w_K₁ : Ω F) := by
        intro u₀
        let x : W := cosetRep u₀
        have hx_K₁ : (x⁻¹ : AbsGal F) * (w : AbsGal F) * (x⁻¹ : AbsGal F)⁻¹ ∈ relWeil F K₁ := by
          refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem x⁻¹.2.1 w.2.1) ((weilGroup F).inv_mem x⁻¹.2.1), ?_⟩
          exact hGalF'K₁.2.2.1 (x⁻¹ : AbsGal F) x⁻¹.2.2 (w : AbsGal F) hw_K₁
        have h_mem : x⁻¹ * w * x ∈ N_A := by
          rw [hNA_iff]
          have h1 : (x⁻¹ : AbsGal F) * (w : AbsGal F) * (x⁻¹ : AbsGal F)⁻¹ ∈ A.fixingSubgroup :=
            IntermediateField.fixingSubgroup_le hAK₁ hx_K₁.2
          change (x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F)⁻¹⁻¹ ∈ A.fixingSubgroup at h1
          rw [inv_inv] at h1
          exact h1
        rw [dif_pos h_mem]
        let w'_K₁ : relWeil F K₁ := ⟨(x⁻¹ : AbsGal F) * (w : AbsGal F) * (x⁻¹ : AbsGal F)⁻¹, hx_K₁⟩
        have h_eA_eq : e_A ⟨x⁻¹ * w * x, h_mem⟩ = Subgroup.inclusion (relWeil_antitone F hAK₁) w'_K₁ := by
          apply Subtype.ext
          change (x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) =
            (x : AbsGal F)⁻¹ * (w : AbsGal F) * ((x : AbsGal F)⁻¹)⁻¹
          group
        have hχ_eq : χA (e_A ⟨x⁻¹ * w * x, h_mem⟩) = χK₁ w_K₁ := by
          rw [h_eA_eq]
          change restrictWeilChar F hAK₁ χA w'_K₁ = χK₁ w_K₁
          rw [hχA_rest]
          exact hInvK₁.2 x⁻¹ w_K₁ hx_K₁
        exact congrArg Units.val hχ_eq
      rw [Finset.sum_congr rfl (fun u₀ _ => h_each u₀), Finset.sum_const, Finset.card_univ,
        nsmul_eq_mul, ← Nat.card_eq_fintype_card, hCard_QA]
    · rw [dif_neg hw_K₁]
      by_cases hw_A : (w : AbsGal F) ∈ A.fixingSubgroup
      · have hw_NA : w ∈ N_A := (hNA_iff w).mpr hw_A
        have hx_NA : ∀ x : W, x⁻¹ * w * x ∈ N_A :=
          fun x => hNA_norm.conj_mem' w hw_NA x
        let w_A : relWeil F A := ⟨w.1, w.2.1, hw_A⟩
        let α : W → (Ω F)ˣ := fun x => χA (e_A ⟨x⁻¹ * w * x, hx_NA x⟩)
        have hα_left : ∀ (n : N_A) (x : W), α ((n : W) * x) = α x := by
          intro n x
          have hn_conj : x⁻¹ * (n : W) * x ∈ N_A := hNA_norm.conj_mem' (n : W) n.2 x
          let n_x : relWeil F A := e_A ⟨x⁻¹ * (n : W) * x, hn_conj⟩
          have h_eq_A : e_A ⟨((n : W) * x)⁻¹ * w * ((n : W) * x), hx_NA ((n : W) * x)⟩ =
              n_x⁻¹ * e_A ⟨x⁻¹ * w * x, hx_NA x⟩ * n_x := by
            apply Subtype.ext
            change ((n : AbsGal F) * (x : AbsGal F))⁻¹ * (w : AbsGal F) * ((n : AbsGal F) * (x : AbsGal F)) =
              ((x : AbsGal F)⁻¹ * (n : AbsGal F) * (x : AbsGal F))⁻¹ *
                ((x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F)) *
                ((x : AbsGal F)⁻¹ * (n : AbsGal F) * (x : AbsGal F))
            group
          change χA (e_A ⟨((n : W) * x)⁻¹ * w * ((n : W) * x), hx_NA ((n : W) * x)⟩) = α x
          rw [h_eq_A, map_mul, map_mul, map_inv, mul_right_comm, inv_mul_cancel, one_mul]
        have hα_quot : ∀ x y : W, (QuotientGroup.mk x : Q_A) = QuotientGroup.mk y → α x = α y := by
          intro x y hq
          have hrel : x⁻¹ * y ∈ N_A := QuotientGroup.eq.mp hq
          have hrel' : y * x⁻¹ ∈ N_A := by
            have h1 := hNA_norm.conj_mem (x⁻¹ * y) hrel x
            have h2 : x * (x⁻¹ * y) * x⁻¹ = y * x⁻¹ := by group
            rwa [h2] at h1
          let n : N_A := ⟨y * x⁻¹, hrel'⟩
          have hy : y = (n : W) * x := by
            dsimp [n]
            exact (inv_mul_cancel_right y x).symm
          rw [hy, hα_left n x]
        have hα_right : ∀ x g : W, α (x * g) = α x * (α g * (χA w_A)⁻¹) := by
          intro x g
          have hc_K₁ : (x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) * (w : AbsGal F)⁻¹ ∈
              relWeil F K₁ := by
            refine ⟨(weilGroup F).mul_mem
              ((weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem x.2.1) w.2.1) x.2.1)
              ((weilGroup F).inv_mem w.2.1), hCommK₁ x w⟩
          let c_x : relWeil F K₁ :=
            ⟨(x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) * (w : AbsGal F)⁻¹, hc_K₁⟩
          have hgc_K₁ : (g⁻¹ : AbsGal F) * (c_x : AbsGal F) * (g⁻¹ : AbsGal F)⁻¹ ∈ relWeil F K₁ := by
            refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem g⁻¹.2.1 c_x.2.1) ((weilGroup F).inv_mem g⁻¹.2.1), ?_⟩
            exact hGalF'K₁.2.2.1 (g⁻¹ : AbsGal F) g⁻¹.2.2 (c_x : AbsGal F) c_x.2.2
          let gc_x : relWeil F K₁ :=
            ⟨(g⁻¹ : AbsGal F) * (c_x : AbsGal F) * (g⁻¹ : AbsGal F)⁻¹, hgc_K₁⟩
          have hInv_c : χK₁ gc_x = χK₁ c_x := hInvK₁.2 g⁻¹ c_x hgc_K₁
          have hχA_cx : χK₁ c_x = α x * (χA w_A)⁻¹ := by
            dsimp only [χK₁]
            rw [← hχA_rest]
            change χA (Subgroup.inclusion (relWeil_antitone F hAK₁) c_x) = α x * (χA w_A)⁻¹
            have h_cx_eq : Subgroup.inclusion (relWeil_antitone F hAK₁) c_x =
                e_A ⟨x⁻¹ * w * x, hx_NA x⟩ * w_A⁻¹ := by
              apply Subtype.ext
              rfl
            rw [h_cx_eq, map_mul, map_inv]
          have h_xg_eq : e_A ⟨(x * g)⁻¹ * w * (x * g), hx_NA (x * g)⟩ =
              Subgroup.inclusion (relWeil_antitone F hAK₁) gc_x * e_A ⟨g⁻¹ * w * g, hx_NA g⟩ := by
            apply Subtype.ext
            change ((x : AbsGal F) * (g : AbsGal F))⁻¹ * (w : AbsGal F) * ((x : AbsGal F) * (g : AbsGal F)) =
              ((g : AbsGal F)⁻¹ * ((x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) * (w : AbsGal F)⁻¹) *
                ((g : AbsGal F)⁻¹)⁻¹) * ((g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F))
            group
          change χA (e_A ⟨(x * g)⁻¹ * w * (x * g), hx_NA (x * g)⟩) = α x * (α g * (χA w_A)⁻¹)
          have hχA_gcx : χA (Subgroup.inclusion (relWeil_antitone F hAK₁) gc_x) = χK₁ gc_x := by
            dsimp only [χK₁]
            rw [← hχA_rest]
            rfl
          have hαg_def : χA (e_A ⟨g⁻¹ * w * g, hx_NA g⟩) = α g := rfl
          rw [h_xg_eq, map_mul, hχA_gcx, hInv_c, hχA_cx, hαg_def]
          ac_rfl
        obtain ⟨g, hgw, h_ne⟩ := hNonInv w_A hw_K₁
        have hαg_eq : α g = χA ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hgw⟩ := rfl
        let c_unit : (Ω F)ˣ := α g * (χA w_A)⁻¹
        let c : Ω F := (c_unit : Ω F)
        have hc_ne1 : c ≠ 1 := by
          intro hc1
          have hcu1 : c_unit = 1 := Units.ext hc1
          have h1 : α g = χA w_A := mul_inv_eq_one.mp hcu1
          exact h_ne (hαg_eq ▸ h1)
        let f : Q_A → Ω F := fun u₀ => (α (cosetRep u₀) : Ω F)
        have h_sum_eq_f : (∑ u₀ : Q_A,
            if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ N_A then
              (χA (e_A ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩) : Ω F)
            else 0) = ∑ u₀ : Q_A, f u₀ := by
          apply Finset.sum_congr rfl
          intro u₀ _
          rw [dif_pos (hx_NA (cosetRep u₀))]
        rw [h_sum_eq_f]
        let u₁ : Q_A := QuotientGroup.mk g
        have hf_mul : ∀ u₀ : Q_A, f (u₀ * u₁) = f u₀ * c := by
          intro u₀
          have hout1 : (QuotientGroup.mk (cosetRep (u₀ * u₁)) : Q_A) = u₀ * u₁ :=
            Quotient.out_eq (u₀ * u₁)
          have hout0 : (QuotientGroup.mk (cosetRep u₀) : Q_A) = u₀ :=
            Quotient.out_eq u₀
          have hq : (QuotientGroup.mk (cosetRep (u₀ * u₁)) : Q_A) =
              QuotientGroup.mk (cosetRep u₀ * g) := by
            rw [hout1, QuotientGroup.mk_mul, hout0]
          have h1 : α (cosetRep (u₀ * u₁)) = α (cosetRep u₀) * c_unit := by
            rw [hα_quot _ _ hq, hα_right (cosetRep u₀) g]
          exact congrArg Units.val h1
        have h_reindex : (∑ u₀ : Q_A, f u₀) = ∑ u₀ : Q_A, f (u₀ * u₁) :=
          (Fintype.sum_equiv (Equiv.mulRight u₁) (fun u₀ => f (u₀ * u₁)) f (fun _ => rfl)).symm
        have h_sum_c : (∑ u₀ : Q_A, f u₀) = (∑ u₀ : Q_A, f u₀) * c := by
          calc (∑ u₀ : Q_A, f u₀)
            _ = ∑ u₀ : Q_A, f (u₀ * u₁) := h_reindex
            _ = ∑ u₀ : Q_A, (f u₀ * c) := Finset.sum_congr rfl (fun u₀ _ => hf_mul u₀)
            _ = (∑ u₀ : Q_A, f u₀) * c := (Finset.sum_mul _ _ _).symm
        have h_sub_zero : (∑ u₀ : Q_A, f u₀) * (c - 1) = 0 := by
          rw [mul_sub, mul_one, ← h_sum_c, sub_self]
        exact (mul_eq_zero.mp h_sub_zero).resolve_right (sub_ne_zero.mpr hc_ne1)
      · apply Finset.sum_eq_zero
        intro u₀ _
        have h_not_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∉ N_A := by
          intro h_mem
          have h1 := hNA_norm.conj_mem ((cosetRep u₀)⁻¹ * w * cosetRep u₀) h_mem (cosetRep u₀)
          have h2 : cosetRep u₀ * ((cosetRep u₀)⁻¹ * w * cosetRep u₀) * (cosetRep u₀)⁻¹ = w := by group
          rw [h2, hNA_iff] at h1
          exact hw_A h1
        rw [dif_neg h_not_mem]
  
  obtain ⟨_, htrE⟩ := h_stage5 E hF'E hEK₁ hGalF'E χE hχE_weil rfl hNonInvE
  obtain ⟨hWfM₁, htrM₁⟩ := h_stage5 M₁ hF'M₁ hM₁K₁ hGalF'M₁ χM₁ hχM₁_weil hχM₁_rest hNonInvM₁
  have hDecomp : IsMonomialDecomp F F'
      (fun w => (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w)
      [⟨1, M₁, hF'M₁, χM₁⟩] := by
    refine ⟨fun t ht => ?_, fun w => ?_⟩
    · simp only [List.mem_singleton] at ht
      rw [ht]
      exact hWfM₁
    · simp only [monomialListTrace, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
        add_zero]
      rw [htrE w, htrM₁ w, hdegF'M₁]
  exact ⟨K₁, M₁, hF'M₁, hM₁M, hEK₁, hM₁K₁, hK₁K, χM₁,
    hDecomp, hGalF'K₁, hGalF'E, hGalF'M₁, hGalEK₁, hGalM₁K₁,
    hdegF'E, hdegF'M₁, hdegEK₁, hdegM₁K₁, hdegF'K₁,
    h_inf, h_sup, hInvK₁, hχM₁_weil, hχM₁_rest, hχK₁_rest⟩

theorem ld_ch12_bicyclic_galois_abelian_and_third_subfield (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hGalEK₁ : IsGaloisExt F E K₁) (hGalM₁K₁ : IsGaloisExt F M₁ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_inf : E ⊓ M₁ = L) (h_sup : E ⊔ M₁ = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    FiniteDimensional F L ∧
    FiniteDimensional F E ∧
    FiniteDimensional F M₁ ∧
    FiniteDimensional F K₁ ∧
    IsAbelianExt F hLE ∧
    IsAbelianExt F hLM₁ ∧
    IsAbelianExt F hEK₁ ∧
    IsAbelianExt F hM₁K₁ ∧
    (∀ (U : IntermediateField F (AlgebraicClosure F)) (hLU : L ≤ U) (hUK₁ : U ≤ K₁),
      Module.finrank L (IntermediateField.extendScalars hLU) = ℓ →
      IsGaloisExt F L U ∧
      IsGaloisExt F U K₁ ∧
      Module.finrank U (IntermediateField.extendScalars hUK₁) = ℓ ∧
      ∃ χU : relWeil F U →* (Ω F)ˣ,
        IsWeilRep F U (charRep F U χU) ∧
        restrictWeilChar F hUK₁ χU = χK₁) ∧
    (∀ (A B : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hLB : L ≤ B) (hAK₁ : A ≤ K₁) (hBK₁ : B ≤ K₁),
      IsGaloisExt F L A → IsGaloisExt F B K₁ →
      Module.finrank L (IntermediateField.extendScalars hLA) = ℓ →
      Module.finrank B (IntermediateField.extendScalars hBK₁) = ℓ →
      A ⊔ B = K₁ →
      ∀ y : Aˣ,
        Units.map (normLM F hBK₁) (Units.map (IntermediateField.inclusion hAK₁).toMonoidHom y) =
          Units.map (IntermediateField.inclusion hLB).toMonoidHom (Units.map (normLM F hLA) y) ∧
        Units.map (normLM F hAK₁) (Units.map (IntermediateField.inclusion hAK₁).toMonoidHom y) =
          y ^ (Module.finrank A (IntermediateField.extendScalars hAK₁))) :=
by
  haveI : FiniteDimensional F K₁ := hGalLK₁.2.1
  have hFin_sub : ∀ {B : IntermediateField F (AlgebraicClosure F)},
      B ≤ K₁ → FiniteDimensional F B :=
    fun hBK₁ => Module.Finite.of_injective (IntermediateField.inclusion hBK₁).toLinearMap
      (IntermediateField.inclusion hBK₁).injective
  have hLK₁ : L ≤ K₁ := hLE.trans hEK₁
  haveI : FiniteDimensional F L := hFin_sub hLK₁
  haveI : FiniteDimensional F E := hFin_sub hEK₁
  haveI : FiniteDimensional F M₁ := hFin_sub hM₁K₁
  have hSepLK₁ : Algebra.IsSeparable L (IntermediateField.extendScalars hLK₁) :=
    hGalLK₁.2.2.2 hLK₁
  have hSep_sub : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hLA : L ≤ A) (hAB : A ≤ B) (hBK₁ : B ≤ K₁),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) := by
    intro A B hLA hAB hBK₁
    refine ⟨fun x => ?_⟩
    let B_A := IntermediateField.extendScalars hAB
    let K_L := IntermediateField.extendScalars hLK₁
    have hxB : (x : AlgebraicClosure F) ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
    let x_K : K_L := ⟨x.1, (IntermediateField.mem_extendScalars hLK₁).mpr (hBK₁ hxB)⟩
    have hsep_xK : IsSeparable L x_K := Algebra.IsSeparable.isSeparable L x_K
    have hmin_KL : minpoly L (x : AlgebraicClosure F) = minpoly L x_K :=
      minpoly.algHom_eq K_L.val K_L.val.injective x_K
    have hsep_L_bar : IsSeparable L (x : AlgebraicClosure F) := by
      change (minpoly L (x : AlgebraicClosure F)).Separable
      rw [hmin_KL]
