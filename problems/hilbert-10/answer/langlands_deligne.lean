    have hι_target :
        ι U_target =
          ((∏ j : Fin (q - 1), u_all j) * (ι (u_α ^ q))⁻¹ * (u_ω ^ q)) *
            (ι (c₁ ^ q * (ϖ_L ^ m_E)⁻¹) * (ϖ_MC ^ (t * (q - 1))) * (u_zδ ^ q)⁻¹)⁻¹ *
            (ι u_TE * (u_zδ * u_ω)⁻¹) ^ q := by
      let P_all : M_Cˣ := ∏ j : Fin (q - 1), u_all j
      let C1_M : M_Cˣ := ι (c₁ ^ (q - 1)) * (ϖ_MC ^ (t * (q - 1)))
