      · exact Or.inl h0
      · right; push_cast; omega
  have hY_ge1_val : Y_ge1 = 0 ∨ 1 ≤ valL F E' Y_ge1 := by
    dsimp only [Y_ge1]
    have hsum_ge1 : ∀ (S : Finset (Fin p)) (f : Fin p → E'),
        (∀ i ∈ S, f i = 0 ∨ 1 ≤ valL F E' (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ 1 ≤ valL F E' (∑ i ∈ S, f i)) := by
      intro S f hS
      induction S using Finset.induction_on with
      | empty => left; simp
      | @insert a s ha ih =>
        rw [Finset.sum_insert ha]
        exact hval_add_E' 1 (f a) (∑ i ∈ s, f i)
          (hS a (Finset.mem_insert_self a s))
          (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
    apply hsum_ge1
    intro i hi
    have hi_ne0 : (i : ℕ) ≠ 0 := by
      intro h0
      exact (Finset.mem_erase.mp hi).1 (Fin.ext h0)
    have hi_ge1 : 1 ≤ (i : ℕ) := Nat.one_le_iff_ne_zero.mpr hi_ne0
    have hi_lt : (i : ℕ) < p := i.isLt
    have hci_val : c i = 0 ∨ 0 ≤ valL F L (c i) := by
      rcases hc_val i with h0 | hge
      · exact Or.inl h0
      · right
        have hi_lt_int : (i : ℤ) < (p : ℤ) := by exact_mod_cast hi_lt
        nlinarith
    have hci_E' : IntermediateField.inclusion hLE' (c i) = 0 ∨
        0 ≤ valL F E' (IntermediateField.inclusion hLE' (c i)) := by
      rcases hci_val with h0 | hge
      · left; rw [h0, map_zero]
      · right
