      intro h hh hcomm
      refine ⟨hh, ?_⟩
      intro c hc
      have hcL : c ∈ H_L' := hH₀_le_HL' hc
      have h1 : h * c * h⁻¹ * c⁻¹ ∈ H_F' := hN₁_le_HF' (hcomm c hcL)
      have h2 : h * c * h⁻¹ * c⁻¹ ∈ H₀ :=
        H₀.mul_mem (‹H₀.Normal›.conj_mem c hc h) (H₀.inv_mem hc)
