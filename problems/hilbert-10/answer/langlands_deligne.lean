  change ψ (((c_ν⁻¹ : Lˣ) : L) * Δ₄) = 1 at hTraceM₁
  rw [hTraceE, hTraceM₁, mul_one] at hψ_diff
  rw [hM₁'_term, hE'_term]
  change κ * ψ (((c_ν⁻¹ : Lˣ) : L) * Δ₃) = (κ * ψ (((c_ν⁻¹ : Lˣ) : L) * Δ₁)) * _
