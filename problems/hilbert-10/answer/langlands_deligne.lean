    hχ₂K₁_cond, hχ₂_twist_pack, hχ₁_twist_pack,
    Or.inr ⟨hbE'_lt_lam, hbM₁'_sub1_lt,
      fun j hj => (hνE'_lam_dom j hj).2, fun j hj => (hνM₁'_lam_dom j hj).2,
      hθE'_cond_eq, hθM₁'_cond_eq⟩⟩

theorem ld_ch12_wild_odd_totally_ramified_min_cond_and_twist_decomp (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hNormFactor : ∀ x : Lˣ, ∃ (y : E'ˣ) (z : M₁'ˣ),
      x = Units.map (normLM F hLE') y * Units.map (normLM F hLM₁') z)
    (hχE'_comp : (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁)
    (hχM₁'_comp : (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
      (recChar F rec K₁ χK₁) u = 1)
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
        (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
      condExp F E' (ξE' ^ j * recChar F rec E' χE') =
        condExp F E' (recChar F rec E' χE'))
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁')),
        (ξM₁' ^ j * recChar F rec M₁' χM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') =
        condExp F M₁' (recChar F rec M₁' χM₁'))
    (hCommonRest : ∀ x : Lˣ,
      (recChar F rec E' χE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
      (recChar F rec M₁' χM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x))
    (hξE'_cond : condExp F E' (νM₁'.comp (Units.map (normLM F hLE'))) = condExp F L νM₁')
    (hξM₁'_cond : condExp F M₁' (νE'.comp (Units.map (normLM F hLM₁'))) =
      condExp F L νM₁' +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁'))
    (hCondRel : condExp F E' (recChar F rec E' χE') +
      (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * condExp F L νE' =
      condExp F M₁' (recChar F rec M₁' χM₁') +
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * condExp F L νM₁') :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let m₁ := 2 * bM₁' - 1 + ℓ * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    let θE' := recChar F rec E' χE'
    let θM₁' := recChar F rec M₁' χM₁'
    m₁ ≤ condExp F M₁' θM₁' ∧
    m₂ ≤ condExp F E' θE' ∧
    ∃ (χ₁ : M₁'ˣ →* (Ω F)ˣ) (χ₂ : E'ˣ →* (Ω F)ˣ) (lam_L : Lˣ →* (Ω F)ˣ),
      θM₁' = χ₁ * lam_L.comp (Units.map (normLM F hLM₁')) ∧
      θE' = χ₂ * lam_L.comp (Units.map (normLM F hLE')) ∧
      χ₂.comp (Units.map (normLM F hE'K₁)) = χ₁.comp (Units.map (normLM F hM₁'K₁)) ∧
      (∀ x : Lˣ,
        χ₂ (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
          χ₁ (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x)) ∧
      condExp F M₁' χ₁ = m₁ ∧
      condExp F E' χ₂ = m₂ ∧
      (∀ u ∈ unitGroup F K₁ (condExp F K₁ (χ₂.comp (Units.map (normLM F hE'K₁)))),
        (χ₂.comp (Units.map (normLM F hE'K₁))) u = 1) ∧
      (∀ j < ℓ,
        condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
        (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
        ∃ σ : E' ≃ₐ[F] E',
          (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
          ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y)) ∧
      (∀ j < ℓ,
        condExp F M₁' (ξM₁' ^ j * χ₁) = m₁ ∧
        (∀ u ∈ unitGroup F M₁' m₁, (ξM₁' ^ j * χ₁) u = 1) ∧
        ∃ τ : M₁' ≃ₐ[F] M₁',
          (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
          ∀ z : M₁'ˣ, (ξM₁' ^ j * χ₁) z = χ₁ (Units.map τ.toRingEquiv.toMonoidHom z)) ∧
      (lam_L = 1 ∨
        (bE' < condExp F L lam_L ∧
         bM₁' - 1 < ℓ * (condExp F L lam_L - bE') ∧
         (∀ j < ℓ,
           ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * lam_L)), (νE' ^ j * lam_L) u = 1) ∧
         (∀ j < ℓ,
           ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * lam_L)), (νM₁' ^ j * lam_L) u = 1) ∧
         condExp F E' θE' = bE' + ℓ * (condExp F L lam_L - bE') ∧
         condExp F M₁' θM₁' = bM₁' + ℓ * (condExp F L lam_L - bM₁'))) :=
by
  intro ℓ bE' bM₁' m₁ m₂ ξE' ξM₁' θE' θM₁'
  obtain ⟨hTwistsE', hTwistsM₁', hNormTrans, hNormInc⟩ :=
    ld_ch12_bicyclic_tot_ram_galois_conjugate_twists_and_norm_trans F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf h_sup
      χK₁ hInvK₁ hneK₁ χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest ψ hψ
      νE' νM₁' hνE'_pow hνE'_ne hνE'_ker hνM₁'_pow hνM₁'_ne hνM₁'_ker
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt
  have hbξE'_ge2 : 2 ≤ condExp F E' ξE' := hξE'_cond.symm ▸ hbM₁'_ge2
  have hbξM₁'_ge2 : 2 ≤ condExp F M₁' ξM₁' := by
    rw [hξM₁'_cond]; omega
  have hξE'_cond1 : ∀ u ∈ unitGroup F E' (condExp F E' ξE'), ξE' u = 1 := by
    have h : ∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ 1)), (ξE' ^ 1) u = 1 :=
      (hξE'_props 1 hℓ_gt1).2.1
    rwa [pow_one ξE'] at h
  have hθE'_cond : ∀ u ∈ unitGroup F E' (condExp F E' θE'), θE' u = 1 := by
    have h : ∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ 0 * θE')), (ξE' ^ 0 * θE') u = 1 :=
      (hξE'_props 0 hℓ_pos).2.2.1
    rwa [pow_zero ξE', one_mul θE'] at h
  have hξM₁'_cond1 : ∀ u ∈ unitGroup F M₁' (condExp F M₁' ξM₁'), ξM₁' u = 1 := by
    have h : ∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ 1)), (ξM₁' ^ 1) u = 1 :=
      (hξM₁'_props 1 hℓ_gt1).2.1
    rwa [pow_one ξM₁'] at h
  have hθM₁'_cond : ∀ u ∈ unitGroup F M₁' (condExp F M₁' θM₁'), θM₁' u = 1 := by
    have h : ∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ 0 * θM₁')), (ξM₁' ^ 0 * θM₁') u = 1 :=
      (hξM₁'_props 0 hℓ_pos).2.2.1
    rwa [pow_zero ξM₁', one_mul θM₁'] at h
  have hMinBound_E' : ∀ χ₂ : E'ˣ →* (Ω F)ˣ,
      (∀ u ∈ unitGroup F E' (condExp F E' χ₂), χ₂ u = 1) →
      (∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ, (ξE' * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y)) →
      m₂ ≤ condExp F E' χ₂ := by
    intro χ₂ hχ₂_cond ⟨σ, hσ_L, hσ_twist⟩
    have h := (ld_wild_odd_single_ext_min_cond_and_deep_norm_triv F L E' hLE' hGalLE'
      hPrime hWild hp_odd ψ hψ hψE' νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ge2
      ξE' χ₂ hbξE'_ge2 hξE'_cond1 hχ₂_cond σ hσ_L hσ_twist).1
    rwa [hξE'_cond] at h
  have hPrimeM₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) :=
    hdegM₁'.symm ▸ hPrime
  have hWildM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = p F :=
    hdegM₁'.trans hWild
  have hνM₁'_pow' : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) = 1 :=
    hdegM₁'.symm ▸ hνM₁'_pow
  have hνM₁'_cond' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1 := by
    intro j hj
    exact hνM₁'_cond j (hdegM₁' ▸ hj)
  have hMinBound_M₁' : ∀ χ₁ : M₁'ˣ →* (Ω F)ˣ,
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' χ₁), χ₁ u = 1) →
      (∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        ∀ z : M₁'ˣ, (ξM₁' * χ₁) z = χ₁ (Units.map τ.toRingEquiv.toMonoidHom z)) →
      m₁ ≤ condExp F M₁' χ₁ := by
    intro χ₁ hχ₁_cond ⟨τ, hτ_L, hτ_twist⟩
    have h := (ld_wild_odd_single_ext_min_cond_and_deep_norm_triv F L M₁' hLM₁' hGalLM₁'
      hPrimeM₁' hWildM₁' hp_odd ψ hψ hψM₁' νM₁' hνM₁'_pow' hνM₁'_ne hνM₁'_ker hνM₁'_cond'
      hbM₁'_ge2 ξM₁' χ₁ hbξM₁'_ge2 hξM₁'_cond1 hχ₁_cond τ hτ_L hτ_twist).1
    rw [hξM₁'_cond] at h
    have heq : bM₁' + (bM₁' + ℓ * (bE' - bM₁')) - 1 = m₁ := by dsimp [m₁, bM₁', bE', ℓ]; omega
    rwa [heq] at h
  obtain ⟨σ₁, hσ₁_L, _, hσ₁_twist_raw⟩ := hTwistsE' 1 hℓ_gt1
  have hσ₁_twist : ∀ y : E'ˣ, (ξE' * θE') y = θE' (Units.map σ₁.toRingEquiv.toMonoidHom y) := by
    have h : ∀ y : E'ˣ, (ξE' ^ 1 * θE') y = θE' (Units.map σ₁.toRingEquiv.toMonoidHom y) :=
      hσ₁_twist_raw
    rwa [pow_one ξE'] at h
  obtain ⟨τ₁, hτ₁_L, _, hτ₁_twist_raw⟩ := hTwistsM₁' 1 hℓ_gt1
  have hτ₁_twist : ∀ z : M₁'ˣ, (ξM₁' * θM₁') z = θM₁' (Units.map τ₁.toRingEquiv.toMonoidHom z) := by
    have h : ∀ z : M₁'ˣ, (ξM₁' ^ 1 * θM₁') z = θM₁' (Units.map τ₁.toRingEquiv.toMonoidHom z) :=
      hτ₁_twist_raw
    rwa [pow_one ξM₁'] at h
  obtain ⟨hm₂_le_raw, _, hNormLe_E', hNormGt_E'⟩ :=
    ld_wild_odd_single_ext_min_cond_and_deep_norm_triv F L E' hLE' hGalLE'
      hPrime hWild hp_odd ψ hψ hψE' νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ge2
      ξE' θE' hbξE'_ge2 hξE'_cond1 hθE'_cond σ₁ hσ₁_L hσ₁_twist
  have hm₂_le : m₂ ≤ condExp F E' θE' := by
    rwa [hξE'_cond] at hm₂_le_raw
  obtain ⟨hm₁_le_raw, hDeepTriv_raw, _, hNormGt_M₁'_raw⟩ :=
    ld_wild_odd_single_ext_min_cond_and_deep_norm_triv F L M₁' hLM₁' hGalLM₁'
      hPrimeM₁' hWildM₁' hp_odd ψ hψ hψM₁' νM₁' hνM₁'_pow' hνM₁'_ne hνM₁'_ker hνM₁'_cond'
      hbM₁'_ge2 ξM₁' θM₁' hbξM₁'_ge2 hξM₁'_cond1 hθM₁'_cond τ₁ hτ₁_L hτ₁_twist
  have hm₁_eq_add : bM₁' + condExp F M₁' ξM₁' - 1 = m₁ := by
    rw [hξM₁'_cond]; dsimp [m₁, bM₁', bE', ℓ]; omega
  have hm₁_le : m₁ ≤ condExp F M₁' θM₁' := hm₁_eq_add ▸ hm₁_le_raw
  have hDeepTriv_M₁' : ∀ w ∈ unitGroup F M₁' m₁,
      Units.map (normLM F hLM₁') w ∈ unitGroup F L (bM₁' + condExp F M₁' θM₁') →
      θM₁' w = 1 := hm₁_eq_add ▸ hDeepTriv_raw
  have hNormGt_M₁' : ∀ r ≥ bM₁',
      ∀ w ∈ unitGroup F M₁' (bM₁' + ℓ * (r - (bM₁' - 1))),
      Units.map (normLM F hLM₁') w ∈ unitGroup F L (r + 1) := by
    simpa only [hdegM₁'] using hNormGt_M₁'_raw
  refine ⟨hm₁_le, hm₂_le, ?_⟩
  rcases eq_or_lt_of_le hm₂_le with hm₂_eq | hm₂_lt
  · have hm₂_eq' : condExp F E' θE' = m₂ := hm₂_eq.symm
    have hm₁_eq' : condExp F M₁' θM₁' = m₁ := by
      have h1 : (condExp F E' θE' : ℤ) + ((ℓ - 1 : ℕ) : ℤ) * (bE' : ℤ) =
          (condExp F M₁' θM₁' : ℤ) + ((ℓ - 1 : ℕ) : ℤ) * (bM₁' : ℤ) := by
        exact_mod_cast hCondRel
      have h2 : (condExp F E' θE' : ℤ) = (bE' : ℤ) + (bM₁' : ℤ) - 1 := by
        dsimp [m₂] at hm₂_eq'
        omega
      have hsub : ((bE' - bM₁' : ℕ) : ℤ) = (bE' : ℤ) - (bM₁' : ℤ) := by
        dsimp [bE', bM₁']
        omega
      have hbM₁'_ge2' : 2 ≤ bM₁' := hbM₁'_ge2
      have h3 : (m₁ : ℤ) = 2 * (bM₁' : ℤ) - 1 + (ℓ : ℤ) * ((bE' - bM₁' : ℕ) : ℤ) := by
        dsimp [m₁]
        omega
      rw [hsub] at h3
      have h4 : ((ℓ - 1 : ℕ) : ℤ) = (ℓ : ℤ) - 1 := by omega
      rw [h4] at h1
      have h5 : (condExp F M₁' θM₁' : ℤ) = (m₁ : ℤ) := by linarith
      exact Int.ofNat.inj h5
    refine ⟨θM₁', θE', 1, ?_, ?_, ?_, hCommonRest, hm₁_eq', hm₂_eq', ?_, ?_, ?_, Or.inl rfl⟩
    · ext; simp
    · ext; simp
    · exact hχE'_comp.trans hχM₁'_comp.symm
    · intro u hu
      rw [hχE'_comp] at hu ⊢
      exact hχK₁_cond u hu
    · intro j hj
      have hcond_j : condExp F E' (ξE' ^ j * θE') = m₂ :=
        ((hξE'_props j hj).2.2.2).trans hm₂_eq'
      have htriv_j : ∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * θE') u = 1 := by
        rw [← hcond_j]
        exact (hξE'_props j hj).2.2.1
      obtain ⟨σ, hσ_L, _, hσ_twist⟩ := hTwistsE' j hj
      exact ⟨hcond_j, htriv_j, σ, hσ_L, hσ_twist⟩
    · intro j hj
      have hcond_j : condExp F M₁' (ξM₁' ^ j * θM₁') = m₁ :=
        ((hξM₁'_props j hj).2.2.2).trans hm₁_eq'
      have htriv_j : ∀ u ∈ unitGroup F M₁' m₁, (ξM₁' ^ j * θM₁') u = 1 := by
        rw [← hcond_j]
        exact (hξM₁'_props j hj).2.2.1
      obtain ⟨τ, hτ_L, _, hτ_twist⟩ := hTwistsM₁' j hj
      exact ⟨hcond_j, htriv_j, τ, hτ_L, hτ_twist⟩
  · exact ld_ch12_wild_odd_tot_ram_higher_cond_char_descent F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime hWild hp_odd
      hdegM₁' hdegE'K₁ hdegM₁'K₁ ψ hψ hψE' hψM₁' νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hbE'_ge2 hbM₁'_ge2 hb_le θE' θM₁' (recChar F rec K₁ χK₁)
      hχE'_comp hχM₁'_comp hχK₁_cond hξE'_props hξM₁'_props hCommonRest
      hξE'_cond hξM₁'_cond hCondRel hTwistsE' hTwistsM₁' hNormTrans hNormInc
      hm₂_lt hDeepTriv_M₁' hNormLe_E' hNormGt_E' hNormGt_M₁' hMinBound_E' hMinBound_M₁'

theorem ld_bicyclic_diamond_norm_trace_and_galois_lift (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_sup : E' ⊔ M₁' = K₁) :
    (∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y)) ∧
    (∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z)) ∧
    (∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w)) ∧
    (∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w))) ∧
    (∀ σ : E' ≃ₐ[F] E',
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      ∃ σ_lift : K₁ ≃ₐ[F] K₁,
        (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ z) ∧
        (∀ y : E', σ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ (σ y)) ∧
        (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hM₁'K₁ (σ_lift w) = normLM F hM₁'K₁ w ∧
          normLM F hE'K₁ (σ_lift w) = σ (normLM F hE'K₁ w))) :=
by
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k K₀ := by
    intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  have hIsGalois_of_ext : ∀ {A₀ B₀ : IntermediateField F (AlgebraicClosure F)}
      (hAB : A₀ ≤ B₀), IsGaloisExt F A₀ B₀ → IsGalois A₀ (IntermediateField.extendScalars hAB) := by
    intro A₀ B₀ hAB hGalAB
    let B' := IntermediateField.extendScalars hAB
    haveI : Algebra.IsSeparable A₀ B' := hGalAB.2.2.2 hAB
    haveI : Normal A₀ (AlgebraicClosure F) := Normal.tower_top_of_normal F A₀ (AlgebraicClosure F)
    refine helper_isGalois A₀ (AlgebraicClosure F) B' ?_
    intro σ τ hτ
    let σ_F : A₀.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A₀).symm σ
    let τ_F : A₀.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A₀).symm τ
    have hτB : τ_F.1 ∈ B₀.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hAB).mpr hx)
    have hconjB : (σ_F * τ_F * σ_F⁻¹).1 ∈ B₀.fixingSubgroup :=
      hGalAB.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτB
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjB
    exact hconjB x ((IntermediateField.mem_extendScalars hAB).mp hx)
  have h_tower_norm_trace_gen : ∀ (A B C : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F B] [FiniteDimensional F C]
      (hAB : A ≤ B) (hBC : B ≤ C) (u : C),
      normLM F hAB (normLM F hBC u) = normLM F (hAB.trans hBC) u ∧
      traceLM F hAB (traceLM F hBC u) = traceLM F (hAB.trans hBC) u := by
    intro A B C _ _ hAB hBC u
    have hAC : A ≤ C := hAB.trans hBC
    let S_AB := IntermediateField.extendScalars hAB
    let S_BC := IntermediateField.extendScalars hBC
    let S_AC := IntermediateField.extendScalars hAC
    let f_BC : B →+* S_AC :=
      { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAC).mpr (hBC z.2)⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let f_SAB : S_AB →+* S_AC :=
      { toFun := fun z =>
          ⟨z.1, (IntermediateField.mem_extendScalars hAC).mpr
            (hBC ((IntermediateField.mem_extendScalars hAB).mp z.2))⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    haveI : FiniteDimensional F S_AB := ‹FiniteDimensional F B›
    haveI : FiniteDimensional F S_AC := ‹FiniteDimensional F C›
    haveI : Module.Finite ↥A ↥S_AB := Module.Finite.of_restrictScalars_finite F ↥A ↥S_AB
    letI algB : Algebra ↥B ↥S_AC := RingHom.toAlgebra f_BC
    letI : SMul ↥B ↥S_AC := @Algebra.toSMul ↥B ↥S_AC _ _ algB
    letI algSAB : Algebra ↥S_AB ↥S_AC := RingHom.toAlgebra f_SAB
    letI : SMul ↥S_AB ↥S_AC := @Algebra.toSMul ↥S_AB ↥S_AC _ _ algSAB
    letI : Module ↥S_AB ↥S_AC := algSAB.toModule
    haveI : IsScalarTower ↥A ↥S_AB ↥S_AC := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower F ↥S_AB ↥S_AC := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Module.Finite ↥S_AB ↥S_AC := Module.Finite.of_restrictScalars_finite F ↥S_AB ↥S_AC
    let e_BC : S_BC ≃ₐ[B] S_AC :=
      { toFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hAC).mpr
            ((IntermediateField.mem_extendScalars hBC).mp x.2)⟩
        invFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hBC).mpr
            ((IntermediateField.mem_extendScalars hAC).mp x.2)⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    let e_B : B ≃+* S_AB :=
      { toExtendScalars F hAB with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    let u_BC : S_BC := toExtendScalars F hBC u
    let u_AC : S_AC := toExtendScalars F hAC u
    have h1_n : Algebra.norm B u_AC = normLM F hBC u :=
      Algebra.norm_eq_of_algEquiv e_BC u_BC
    have h2_n : toExtendScalars F hAB (Algebra.norm B u_AC) = Algebra.norm S_AB u_AC :=
      Algebra.norm_eq_of_ringEquiv e_B (RingHom.ext fun _ => rfl) u_AC
    have h3_n : Algebra.norm A (Algebra.norm S_AB u_AC) = normLM F hAC u :=
      Algebra.norm_norm
    have h_norm : normLM F hAB (normLM F hBC u) = normLM F hAC u := by
      change Algebra.norm A (toExtendScalars F hAB (normLM F hBC u)) = normLM F hAC u
      rw [← h1_n, h2_n, h3_n]
    have h1_t : Algebra.trace B S_AC u_AC = traceLM F hBC u :=
      Algebra.trace_eq_of_algEquiv e_BC u_BC
    have h2_t : toExtendScalars F hAB (Algebra.trace B S_AC u_AC) = Algebra.trace S_AB S_AC u_AC :=
      Algebra.trace_eq_of_ringEquiv e_B (RingHom.ext fun _ => rfl) u_AC
    have h3_t : Algebra.trace A S_AB (Algebra.trace S_AB S_AC u_AC) = traceLM F hAC u :=
      Algebra.trace_trace u_AC
    have h_trace : traceLM F hAB (traceLM F hBC u) = traceLM F hAC u := by
      change Algebra.trace A S_AB (toExtendScalars F hAB (traceLM F hBC u)) = traceLM F hAC u
      rw [← h1_t, h2_t, h3_t]
    exact ⟨h_norm, h_trace⟩
  have h_diamond_compat_and_lift : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B]
      (hLA : L ≤ A) (hLB : L ≤ B) (hAK₁ : A ≤ K₁) (hBK₁ : B ≤ K₁),
      IsGaloisExt F L A → IsGaloisExt F A K₁ → IsGaloisExt F B K₁ →
      Module.finrank B (IntermediateField.extendScalars hBK₁) =
        Module.finrank L (IntermediateField.extendScalars hLA) →
      A ⊔ B = K₁ →
      (∀ y : A,
        normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
          IntermediateField.inclusion hLB (normLM F hLA y) ∧
        traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
          IntermediateField.inclusion hLB (traceLM F hLA y)) ∧
      (∀ τ : A ≃ₐ[F] A,
        (∀ x : L, τ (IntermediateField.inclusion hLA x) = IntermediateField.inclusion hLA x) →
        ∃ τ_lift : K₁ ≃ₐ[F] K₁,
          (∀ y : B, τ_lift (IntermediateField.inclusion hBK₁ y) =
            IntermediateField.inclusion hBK₁ y) ∧
          (∀ z : A, τ_lift (IntermediateField.inclusion hAK₁ z) =
            IntermediateField.inclusion hAK₁ (τ z)) ∧
          (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
          (∀ w : K₁,
            normLM F hBK₁ (τ_lift w) = normLM F hBK₁ w ∧
            normLM F hAK₁ (τ_lift w) = τ (normLM F hAK₁ w))) := by
    intro A B _ _ hLA hLB hAK₁ hBK₁ hGalLA hGalAK₁ hGalBK₁ hdeg h_sup_AB
    let A' := IntermediateField.extendScalars hLA
    let K₁_B := IntermediateField.extendScalars hBK₁
    let K₁_A := IntermediateField.extendScalars hAK₁
    haveI : FiniteDimensional F A' := ‹FiniteDimensional F A›
    haveI : FiniteDimensional F K₁_B := ‹FiniteDimensional F K₁›
    haveI : FiniteDimensional F K₁_A := ‹FiniteDimensional F K₁›
    haveI : FiniteDimensional L A' := Module.Finite.of_restrictScalars_finite F L A'
    haveI : FiniteDimensional B K₁_B := Module.Finite.of_restrictScalars_finite F B K₁_B
    haveI : FiniteDimensional A K₁_A := Module.Finite.of_restrictScalars_finite F A K₁_A
    haveI : IsGalois L A' := hIsGalois_of_ext hLA hGalLA
    haveI : Normal L A' := IsGalois.to_normal
    haveI : IsGalois B K₁_B := hIsGalois_of_ext hBK₁ hGalBK₁
    haveI : Normal B K₁_B := IsGalois.to_normal
    haveI : IsGalois A K₁_A := hIsGalois_of_ext hAK₁ hGalAK₁
    haveI : Normal A K₁_A := IsGalois.to_normal
    haveI : Normal B (AlgebraicClosure F) := Normal.tower_top_of_normal F B (AlgebraicClosure F)
    let G_A := A' ≃ₐ[L] A'
    let G_B := K₁_B ≃ₐ[B] K₁_B
    let G_K₁A := K₁_A ≃ₐ[A] K₁_A
    have hcard_GB_GA : Fintype.card G_B = Fintype.card G_A := by
      rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank B K₁_B, hdeg,
        ← IsGalois.card_aut_eq_finrank L A', Nat.card_eq_fintype_card]
    let Φ_BL : B.fixingSubgroup →* G_A :=
      (AlgEquiv.restrictNormalHom A').comp
        ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
          (Subgroup.inclusion (IntermediateField.fixingSubgroup_le hLB)))
    let Ψ_B : B.fixingSubgroup →* G_B :=
      (AlgEquiv.restrictNormalHom K₁_B).comp
        (IntermediateField.fixingSubgroupEquiv B).toMonoidHom
    have hΦ_apply : ∀ (γ : B.fixingSubgroup) (x : A'),
        ((Φ_BL γ x : A') : AlgebraicClosure F) = γ.1 x.1 := by
      intro γ x
      change ((AlgEquiv.restrictNormalHom A'
        ((IntermediateField.fixingSubgroupEquiv L)
          ⟨γ.1, IntermediateField.fixingSubgroup_le hLB γ.2⟩) x : A') :
          AlgebraicClosure F) = γ.1 x.1
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    have hΨ_apply : ∀ (γ : B.fixingSubgroup) (z : K₁_B),
        ((Ψ_B γ z : K₁_B) : AlgebraicClosure F) = γ.1 z.1 := by
      intro γ z
      change ((AlgEquiv.restrictNormalHom K₁_B
        ((IntermediateField.fixingSubgroupEquiv B) γ) z : K₁_B) :
          AlgebraicClosure F) = γ.1 z.1
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    have hΨ_surj : Function.Surjective Ψ_B :=
      (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
        (IntermediateField.fixingSubgroupEquiv B).surjective
    choose lift_B hlift_B using hΨ_surj
    let ρ : G_B → G_A := fun τ => Φ_BL (lift_B τ)
    have hfix_sup_AB : A.fixingSubgroup ⊓ B.fixingSubgroup = K₁.fixingSubgroup := by
      rw [← IntermediateField.fixingSubgroup_sup, h_sup_AB]
    have hρ_inj : Function.Injective ρ := by
      intro τ₁ τ₂ hρ_eq
      let γ : B.fixingSubgroup := (lift_B τ₁)⁻¹ * lift_B τ₂
      have hΦ_γ : Φ_BL γ = 1 := by
        change Φ_BL ((lift_B τ₁)⁻¹ * lift_B τ₂) = 1
        rw [map_mul, map_inv]
        exact inv_mul_eq_one.mpr hρ_eq
      have hγ_A : γ.1 ∈ A.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro a ha
        let x : A' := ⟨a, (IntermediateField.mem_extendScalars hLA).mpr ha⟩
        have hx : Φ_BL γ x = x := by rw [hΦ_γ]; rfl
        have hx_val := congrArg Subtype.val hx
        rwa [hΦ_apply γ x] at hx_val
      have hγ_K₁ : γ.1 ∈ K₁.fixingSubgroup := by
        rw [← hfix_sup_AB]
        exact ⟨hγ_A, γ.2⟩
      have hΨ_γ : Ψ_B γ = 1 := by
        apply AlgEquiv.ext
        intro z
        apply Subtype.ext
        rw [hΨ_apply γ z]
        rw [IntermediateField.mem_fixingSubgroup_iff] at hγ_K₁
        exact hγ_K₁ z.1 ((IntermediateField.mem_extendScalars hBK₁).mp z.2)
      have hΨ_eq : Ψ_B (lift_B τ₁) = Ψ_B (lift_B τ₂) := by
        apply inv_mul_eq_one.mp
        rw [← map_inv, ← map_mul]
        exact hΨ_γ
      rwa [hlift_B τ₁, hlift_B τ₂] at hΨ_eq
    have hρ_bij : Function.Bijective ρ :=
      (Fintype.bijective_iff_injective_and_card ρ).mpr ⟨hρ_inj, hcard_GB_GA⟩
    have hρ_act : ∀ (y : A) (γ : G_B),
        ((γ (toExtendScalars F hBK₁ (IntermediateField.inclusion hAK₁ y)) : K₁_B) :
          AlgebraicClosure F) =
        ((ρ γ (toExtendScalars F hLA y) : A') : AlgebraicClosure F) := by
      intro y γ
      have h1 : ((ρ γ (toExtendScalars F hLA y) : A') : AlgebraicClosure F) =
          (lift_B γ).1 y.1 :=
        hΦ_apply (lift_B γ) (toExtendScalars F hLA y)
      have h2 : ((Ψ_B (lift_B γ) (toExtendScalars F hBK₁ (IntermediateField.inclusion hAK₁ y)) :
          K₁_B) : AlgebraicClosure F) = (lift_B γ).1 y.1 :=
        hΨ_apply (lift_B γ) (toExtendScalars F hBK₁ (IntermediateField.inclusion hAK₁ y))
      rw [hlift_B γ] at h2
      exact h2.trans h1.symm
    refine ⟨?_, ?_⟩
    · intro y
      let y_A : A' := toExtendScalars F hLA y
      let y_B : K₁_B := toExtendScalars F hBK₁ (IntermediateField.inclusion hAK₁ y)
      have hNorm_B : (normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
          ∏ γ : G_B, ((γ y_B : K₁_B) : AlgebraicClosure F) := by
        have h1 := congrArg K₁_B.val (Algebra.norm_eq_prod_automorphisms B y_B)
        rw [map_prod] at h1
        exact h1
      have hNorm_A : (normLM F hLA y : AlgebraicClosure F) =
          ∏ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) := by
        have h1 := congrArg A'.val (Algebra.norm_eq_prod_automorphisms L y_A)
        rw [map_prod] at h1
        exact h1
      have hProd_eq : (∏ γ : G_B, ((γ y_B : K₁_B) : AlgebraicClosure F)) =
          ∏ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) :=
        Fintype.prod_bijective ρ hρ_bij _ _ (hρ_act y)
      have hNorm_diamond : normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
          IntermediateField.inclusion hLB (normLM F hLA y) := by
        apply Subtype.ext
        change (normLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
          (normLM F hLA y : AlgebraicClosure F)
        rw [hNorm_B, hNorm_A, hProd_eq]
      have hTrace_B : (traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
          ∑ γ : G_B, ((γ y_B : K₁_B) : AlgebraicClosure F) := by
        have h1 := congrArg K₁_B.val (trace_eq_sum_automorphisms (K := B) y_B)
        rw [map_sum] at h1
        exact h1
      have hTrace_A : (traceLM F hLA y : AlgebraicClosure F) =
          ∑ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) := by
        have h1 := congrArg A'.val (trace_eq_sum_automorphisms (K := L) y_A)
        rw [map_sum] at h1
        exact h1
      have hSum_eq : (∑ γ : G_B, ((γ y_B : K₁_B) : AlgebraicClosure F)) =
          ∑ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) :=
        Fintype.sum_bijective ρ hρ_bij _ _ (hρ_act y)
      have hTrace_diamond : traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) =
          IntermediateField.inclusion hLB (traceLM F hLA y) := by
        apply Subtype.ext
        change (traceLM F hBK₁ (IntermediateField.inclusion hAK₁ y) : AlgebraicClosure F) =
          (traceLM F hLA y : AlgebraicClosure F)
        rw [hTrace_B, hTrace_A, hSum_eq]
      exact ⟨hNorm_diamond, hTrace_diamond⟩
    · intro τ hτ_L
      let τ_A : G_A :=
        { toFun := fun z =>
            ⟨(τ ⟨z.1, (IntermediateField.mem_extendScalars hLA).mp z.2⟩).1,
              (IntermediateField.mem_extendScalars hLA).mpr
                (τ ⟨z.1, (IntermediateField.mem_extendScalars hLA).mp z.2⟩).2⟩
          invFun := fun z =>
            ⟨(τ.symm ⟨z.1, (IntermediateField.mem_extendScalars hLA).mp z.2⟩).1,
              (IntermediateField.mem_extendScalars hLA).mpr
                (τ.symm ⟨z.1, (IntermediateField.mem_extendScalars hLA).mp z.2⟩).2⟩
          left_inv := fun z => Subtype.ext (congrArg Subtype.val (τ.left_inv _))
          right_inv := fun z => Subtype.ext (congrArg Subtype.val (τ.right_inv _))
          map_mul' := fun z₁ z₂ => Subtype.ext (congrArg Subtype.val (map_mul τ _ _))
          map_add' := fun z₁ z₂ => Subtype.ext (congrArg Subtype.val (map_add τ _ _))
          commutes' := fun x => Subtype.ext (congrArg Subtype.val (hτ_L x)) }
      obtain ⟨γ_B, hγ_B⟩ := hρ_bij.2 τ_A
      let τ_lift : K₁ ≃ₐ[F] K₁ :=
        { toFun := fun w =>
            ⟨(γ_B (toExtendScalars F hBK₁ w)).1,
              (IntermediateField.mem_extendScalars hBK₁).mp (γ_B (toExtendScalars F hBK₁ w)).2⟩
          invFun := fun w =>
            ⟨(γ_B.symm (toExtendScalars F hBK₁ w)).1,
              (IntermediateField.mem_extendScalars hBK₁).mp
                (γ_B.symm (toExtendScalars F hBK₁ w)).2⟩
          left_inv := fun w =>
            Subtype.ext (congrArg Subtype.val (γ_B.left_inv (toExtendScalars F hBK₁ w)))
          right_inv := fun w =>
            Subtype.ext (congrArg Subtype.val (γ_B.right_inv (toExtendScalars F hBK₁ w)))
          map_mul' := fun w₁ w₂ => Subtype.ext (congrArg Subtype.val (map_mul γ_B _ _))
          map_add' := fun w₁ w₂ => Subtype.ext (congrArg Subtype.val (map_add γ_B _ _))
          commutes' := fun c => by
            apply Subtype.ext
            have hc : toExtendScalars F hBK₁ (algebraMap F K₁ c) =
                algebraMap B K₁_B (algebraMap F B c) := rfl
            exact congrArg Subtype.val (hc ▸ γ_B.commutes (algebraMap F B c)) }
      have hτ_lift_B : ∀ y : B,
          τ_lift (IntermediateField.inclusion hBK₁ y) = IntermediateField.inclusion hBK₁ y := by
        intro y
        apply Subtype.ext
        have hy : toExtendScalars F hBK₁ (IntermediateField.inclusion hBK₁ y) =
            algebraMap B K₁_B y := rfl
        exact congrArg Subtype.val (hy ▸ γ_B.commutes y)
      have hτ_lift_A : ∀ z : A,
          τ_lift (IntermediateField.inclusion hAK₁ z) =
            IntermediateField.inclusion hAK₁ (τ z) := by
        intro z
        apply Subtype.ext
        have h1 := hρ_act z γ_B
        change ((γ_B (toExtendScalars F hBK₁ (IntermediateField.inclusion hAK₁ z)) : K₁_B) :
          AlgebraicClosure F) = (τ z : AlgebraicClosure F)
        rw [h1, hγ_B]
        rfl
      have hτ_lift_symm_A : ∀ z : A,
          τ_lift.symm (IntermediateField.inclusion hAK₁ z) =
            IntermediateField.inclusion hAK₁ (τ.symm z) := by
        intro z
        apply τ_lift.injective
        rw [τ_lift.apply_symm_apply, hτ_lift_A, τ.apply_symm_apply]
      have hτ_lift_val : ∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w := by
        intro w
        unfold valL relVal
        rw [Algebra.norm_eq_of_algEquiv τ_lift w]
      have hτ_lift_normB : ∀ w : K₁, normLM F hBK₁ (τ_lift w) = normLM F hBK₁ w := by
        intro w
        have hw : toExtendScalars F hBK₁ (τ_lift w) = γ_B (toExtendScalars F hBK₁ w) := rfl
        unfold normLM
        rw [MonoidHom.comp_apply, MonoidHom.comp_apply, RingHom.toMonoidHom_eq_coe,
          MonoidHom.coe_coe, hw]
        exact Algebra.norm_eq_of_algEquiv γ_B (toExtendScalars F hBK₁ w)
      have hτ_lift_normA : ∀ w : K₁, normLM F hAK₁ (τ_lift w) = τ (normLM F hAK₁ w) := by
        intro w
        let τ_tilde : K₁_A ≃+* K₁_A :=
          { toFun := fun x =>
              toExtendScalars F hAK₁ (τ_lift ⟨x.1, (IntermediateField.mem_extendScalars hAK₁).mp x.2⟩)
            invFun := fun x =>
              toExtendScalars F hAK₁
                (τ_lift.symm ⟨x.1, (IntermediateField.mem_extendScalars hAK₁).mp x.2⟩)
            left_inv := fun x => Subtype.ext (congrArg Subtype.val (τ_lift.left_inv _))
            right_inv := fun x => Subtype.ext (congrArg Subtype.val (τ_lift.right_inv _))
            map_mul' := fun x₁ x₂ => Subtype.ext (congrArg Subtype.val (map_mul τ_lift _ _))
            map_add' := fun x₁ x₂ => Subtype.ext (congrArg Subtype.val (map_add τ_lift _ _)) }
        have hτ_tilde_alg : ∀ a : A,
            τ_tilde (algebraMap A K₁_A a) = algebraMap A K₁_A (τ a) := by
          intro a
          apply Subtype.ext
          exact congrArg Subtype.val (hτ_lift_A a)
        have hτ_tilde_symm_alg : ∀ a : A,
            τ_tilde.symm (algebraMap A K₁_A a) = algebraMap A K₁_A (τ.symm a) := by
          intro a
          apply Subtype.ext
          exact congrArg Subtype.val (hτ_lift_symm_A a)
        let c_fwd : G_K₁A → G_K₁A := fun σ =>
          { τ_tilde.symm.trans (σ.toRingEquiv.trans τ_tilde) with
            commutes' := fun a => by
              change τ_tilde (σ (τ_tilde.symm (algebraMap A K₁_A a))) = algebraMap A K₁_A a
              rw [hτ_tilde_symm_alg a, σ.commutes (τ.symm a), hτ_tilde_alg (τ.symm a),
                τ.apply_symm_apply] }
        let c_inv : G_K₁A → G_K₁A := fun σ =>
          { τ_tilde.trans (σ.toRingEquiv.trans τ_tilde.symm) with
            commutes' := fun a => by
              change τ_tilde.symm (σ (τ_tilde (algebraMap A K₁_A a))) = algebraMap A K₁_A a
              rw [hτ_tilde_alg a, σ.commutes (τ a), hτ_tilde_symm_alg (τ a),
                τ.symm_apply_apply] }
        let e_τ : G_K₁A ≃ G_K₁A :=
          { toFun := c_fwd
            invFun := c_inv
            left_inv := fun σ => by
              apply AlgEquiv.ext
              intro x
              change τ_tilde.symm (τ_tilde (σ (τ_tilde.symm (τ_tilde x)))) = σ x
              rw [τ_tilde.symm_apply_apply, τ_tilde.symm_apply_apply]
            right_inv := fun σ => by
              apply AlgEquiv.ext
              intro x
              change τ_tilde (τ_tilde.symm (σ (τ_tilde (τ_tilde.symm x)))) = σ x
              rw [τ_tilde.apply_symm_apply, τ_tilde.apply_symm_apply] }
        let w_A : K₁_A := toExtendScalars F hAK₁ w
        have hw_A : toExtendScalars F hAK₁ (τ_lift w) = τ_tilde w_A := rfl
        have h_prod : (∏ σ : G_K₁A, σ (τ_tilde w_A)) =
            τ_tilde (∏ σ : G_K₁A, σ w_A) := by
          rw [← Equiv.prod_comp e_τ (fun σ => σ (τ_tilde w_A))]
          have h_term : ∀ σ : G_K₁A, e_τ σ (τ_tilde w_A) = τ_tilde (σ w_A) := by
            intro σ
            change τ_tilde (σ (τ_tilde.symm (τ_tilde w_A))) = τ_tilde (σ w_A)
            rw [τ_tilde.symm_apply_apply]
          simp_rw [h_term]
          exact (map_prod τ_tilde (fun σ : G_K₁A => σ w_A) Finset.univ).symm
        have h1 : algebraMap A K₁_A (normLM F hAK₁ (τ_lift w)) =
            ∏ σ : G_K₁A, σ (τ_tilde w_A) := by
          unfold normLM
          rw [MonoidHom.comp_apply, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe, hw_A]
          exact Algebra.norm_eq_prod_automorphisms A (τ_tilde w_A)
        have h2 : algebraMap A K₁_A (normLM F hAK₁ w) =
            ∏ σ : G_K₁A, σ w_A :=
          Algebra.norm_eq_prod_automorphisms A w_A
        have h3 : algebraMap A K₁_A (normLM F hAK₁ (τ_lift w)) =
            algebraMap A K₁_A (τ (normLM F hAK₁ w)) := by
          rw [h1, h_prod, ← h2, hτ_tilde_alg]
        exact (algebraMap A K₁_A).injective h3
      exact ⟨τ_lift, hτ_lift_B, hτ_lift_A, hτ_lift_val,
        fun w => ⟨hτ_lift_normB w, hτ_lift_normA w⟩⟩
  have hdeg_E'K₁_M₁' : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLM₁') :=
    hdegE'K₁.trans hdegM₁'.symm
  have h_sup_symm : M₁' ⊔ E' = K₁ := (sup_comm M₁' E').trans h_sup
  have h_E'_M₁' := h_diamond_compat_and_lift E' M₁' hLE' hLM₁' hE'K₁ hM₁'K₁
    hGalLE' hGalE'K₁ hGalM₁'K₁ hdegM₁'K₁ h_sup
  have h_M₁'_E' := h_diamond_compat_and_lift M₁' E' hLM₁' hLE' hM₁'K₁ hE'K₁
    hGalLM₁' hGalM₁'K₁ hGalE'K₁ hdeg_E'K₁_M₁' h_sup_symm
  refine ⟨h_E'_M₁'.1, h_M₁'_E'.1, ?_, h_M₁'_E'.2, h_E'_M₁'.2⟩
  intro w
  have hE' := h_tower_norm_trace_gen L E' K₁ hLE' hE'K₁ w
  have hM₁' := h_tower_norm_trace_gen L M₁' K₁ hLM₁' hM₁'K₁ w
  have h_le_eq : hLE'.trans hE'K₁ = hLM₁'.trans hM₁'K₁ := rfl
  exact ⟨hE'.1.trans (h_le_eq ▸ hM₁'.1.symm), hE'.2.trans (h_le_eq ▸ hM₁'.2.symm)⟩

theorem ld_wild_bottom_edges_cond_val_and_galois_package (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (χ₁ : M₁'ˣ →* (Ω F)ˣ) (χ₂ : E'ˣ →* (Ω F)ˣ)
    (hχ₂_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
      (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y))
    (hχ₁_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      let m₁ := 2 * condExp F L νM₁' - 1 +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁')
      condExp F M₁' (ξM₁' ^ j * χ₁) = m₁ ∧
      (∀ u ∈ unitGroup F M₁' m₁, (ξM₁' ^ j * χ₁) u = 1) ∧
      ∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        ∀ z : M₁'ˣ, (ξM₁' ^ j * χ₁) z = χ₁ (Units.map τ.toRingEquiv.toMonoidHom z)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let t₂ := bE' - 1
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    condExpChar F E' ψE' = (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ∧
    condExpChar F M₁' ψM₁' = (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ∧
    condExp F E' ξE' = bM₁' ∧
    condExp F M₁' ξM₁' = bM₁' + p * (bE' - bM₁') ∧
    (∀ u ∈ unitGroup F E' (condExp F E' ξE'), ξE' u = 1) ∧
    (∀ u ∈ unitGroup F M₁' (condExp F M₁' ξM₁'), ξM₁' u = 1) ∧
    (∀ y : E', valL F L (normLM F hLE' y) = valL F E' y) ∧
    (∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = (p : ℤ) * valL F L x) ∧
    (∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z) ∧
    (∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = (p : ℤ) * valL F L x) ∧
    (∀ (m : ℤ) (y : E'),
      (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y))) ∧
    (∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z))) ∧
    (∃ (ϖ_E' : E'ˣ) (G_E' : Type u) (_ : Group G_E') (_ : Fintype G_E')
       (act_E' : G_E' → E' → E') (y₁_E' : E'),
      valL F E' (ϖ_E' : E') = 1 ∧
      (∀ y : E', ∃ c : Fin p → L,
        y = ∑ i : Fin p, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (y = 0 ∨ m ≤ valL F E' y) ↔
            ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F L (c i) + (i : ℤ)) ∧
      Fintype.card G_E' = p ∧
      (∀ y : E', act_E' 1 y = y) ∧
      (∀ (σ τ : G_E') (y : E'), act_E' (σ * τ) y = act_E' σ (act_E' τ y)) ∧
      (∀ σ : G_E',
        act_E' σ 0 = 0 ∧ act_E' σ 1 = 1 ∧
        (∀ y₁ y₂ : E',
          act_E' σ (y₁ + y₂) = act_E' σ y₁ + act_E' σ y₂ ∧
          act_E' σ (y₁ * y₂) = act_E' σ y₁ * act_E' σ y₂ ∧
          act_E' σ (-y₁) = -act_E' σ y₁)) ∧
      (∀ (σ : G_E') (x : L),
        act_E' σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
      (∀ (σ : G_E') (y : E'), valL F E' (act_E' σ y) = valL F E' y) ∧
      (∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = ∑ σ : G_E', act_E' σ y) ∧
      (∀ τ : G_E', τ ≠ 1 →
        (ϖ_E' : E') - act_E' τ (ϖ_E' : E') ≠ 0 ∧
        valL F E' ((ϖ_E' : E') - act_E' τ (ϖ_E' : E')) = (t₂ + 1 : ℤ)) ∧
      traceLM F hLE' y₁_E' = 1 ∧
      y₁_E' ≠ 0 ∧
      valL F E' y₁_E' = -(((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))) ∧
    (∃ (τ : M₁' ≃ₐ[F] M₁') (z₀ : M₁'),
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
      τ z₀ ≠ z₀ ∧
      (∀ ϖ_M₁' : M₁'ˣ, valL F M₁' (ϖ_M₁' : M₁') = 1 →
        (Units.map τ.toRingEquiv.toMonoidHom ϖ_M₁') * ϖ_M₁'⁻¹ ∉ unitGroup F M₁' bM₁')) :=
by
  intro p bE' bM₁' t₂ ψE' ψM₁' ξE' ξM₁'
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt

  
  let m₂ := bE' + bM₁' - 1
  have hm₂_triv0 := (hχ₂_twists 0 hp_pos).2.1
  have hm₂_triv1 := (hχ₂_twists 1 hp_gt1).2.1
  have h_mem_E' : m₂ ∈ {a : ℕ | ∀ u ∈ unitGroup F E' a, ξE' u = 1} := by
    intro u hu
