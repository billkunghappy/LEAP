    (B p - traceLM F hLE' (e' p)) (-(A p - traceLM F hLM₁' (e_ext p)))
    hB_p hA_p_neg
  have hdiff_eq :
      (B p - traceLM F hLE' (e' p)) + (-(A p - traceLM F hLM₁' (e_ext p))) =
        traceLM F hLM₁' b - traceLM F hLE' a := by
    rw [hAp_eq_Bp, he'_p, he_ext_p]
    ring
  rwa [hdiff_eq] at hcomb

theorem ld_ch12_wild_odd_totally_ramified_twisted_symm_and_trace_norm_congr_p3 (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
