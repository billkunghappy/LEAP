      rw [hgh_ring] at hgh_sum
      rw [hψ_2α_congr (g_fn z_k + h_fn z_k)
        (((p - 1 : ℕ) : R_L) * ((trLE' x + nmLE' x) - (trLE' (x * s₀) + nmLE' (x * s₀)))) hgh_sum]
