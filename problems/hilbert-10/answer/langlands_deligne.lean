        evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, E, hLE, χE⟩ =
          evalMonomialList F rec (fun _ E' _ => f E') L ψ D_E := by
    intro E hLE hEK χE ht_wf hχE_rest
    by_cases hEM : E ≤ M
    · refine ⟨[⟨1, E, hLE, χE⟩], ⟨?_, ?_⟩, ?_, ?_⟩
      · intro s hs
        simp only [List.mem_singleton] at hs
        rw [hs]
        exact ht_wf
      · intro w
        simp [monomialListTrace]
      · intro s hs
        simp only [List.mem_singleton] at hs
        rw [hs]
