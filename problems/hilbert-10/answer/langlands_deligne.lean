      have h_step : τ₀ (toExtendScalars F hLM₁' z) = toExtendScalars F hLM₁' (σ₀ z) := rfl
      rw [pow_succ, AlgEquiv.mul_apply, h_step, ih (σ₀ z), pow_succ, AlgEquiv.mul_apply]
  have hτ₀_bij : Function.Bijective (fun r : Fin p => τ₀ ^ r.1) := by
    have h_le : ∀ r₁ r₂ : Fin p, r₂.1 ≤ r₁.1 → τ₀ ^ r₁.1 = τ₀ ^ r₂.1 → r₁ = r₂ := by
      intro r₁ r₂ hle heq
      have h_fix : ((g₀ ^ (r₁.1 - r₂.1) : relWeil F L) : AbsGal F) ∈ M₁'.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro a ha
        let z : M₁' := ⟨a, ha⟩
        have hz_eq : (((τ₀ ^ r₁.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F) =
            (((τ₀ ^ r₂.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F) := by
          rw [heq]
        have h1 : (((τ₀ ^ r₁.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F) =
            ((g₀ : AbsGal F) ^ r₁.1) a :=
          (hτ₀_pow_eq r₁.1 z).trans (hσ₀_pow_act r₁.1 z)
        have h2 : (((τ₀ ^ r₂.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F) =
            ((g₀ : AbsGal F) ^ r₂.1) a :=
          (hτ₀_pow_eq r₂.1 z).trans (hσ₀_pow_act r₂.1 z)
        have h_act : ((g₀ : AbsGal F) ^ r₁.1) a = ((g₀ : AbsGal F) ^ r₂.1) a :=
          (h1.symm.trans hz_eq).trans h2
        have h_split : r₁.1 = r₂.1 + (r₁.1 - r₂.1) := (Nat.add_sub_of_le hle).symm
        change ((g₀ : AbsGal F) ^ (r₁.1 - r₂.1)) a = a
        apply ((g₀ : AbsGal F) ^ r₂.1).injective
        change ((g₀ : AbsGal F) ^ r₂.1 * (g₀ : AbsGal F) ^ (r₁.1 - r₂.1)) a =
          ((g₀ : AbsGal F) ^ r₂.1) a
        rw [← pow_add, ← h_split]
        exact h_act
      have hμ_1 : ζM₁' ^ (r₁.1 - r₂.1) = 1 := by
        rw [← map_pow]
        exact (hμM₁'_ker (g₀ ^ (r₁.1 - r₂.1))).mp h_fix
      have h_pow_val : (ζM₁' : Ω F) ^ (r₁.1 - r₂.1) = (ζM₁' : Ω F) ^ 0 := by
        rw [pow_zero, ← Units.val_pow_eq_pow_val, hμ_1, Units.val_one]
      have hsub_lt : r₁.1 - r₂.1 < p := Nat.lt_of_le_of_lt (Nat.sub_le r₁.1 r₂.1) r₁.2
      have hsub0 : r₁.1 - r₂.1 = 0 :=
        hζM₁'_prim.injOn_pow (Finset.mem_range.mpr hsub_lt) (Finset.mem_range.mpr hPrime.pos)
          h_pow_val
      ext
      omega
    have h_inj : Function.Injective (fun r : Fin p => τ₀ ^ r.1) := by
      intro r₁ r₂ heq
      rcases le_total r₂.1 r₁.1 with hle | hle
      · exact h_le r₁ r₂ hle heq
      · exact (h_le r₂ r₁ hle heq.symm).symm
    exact (Fintype.bijective_iff_injective_and_card _).mpr
      ⟨h_inj, (Fintype.card_fin p).trans hcard_GLM₁'.symm⟩
  have hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range p, (σ₀ ^ k) z := by
    intro z
    apply Subtype.ext
    have h1_ext : algebraMap L M₁'_ext (Algebra.trace L M₁'_ext (toExtendScalars F hLM₁' z)) =
        ∑ σ : G_LM₁', σ (toExtendScalars F hLM₁' z) :=
      trace_eq_sum_automorphisms (toExtendScalars F hLM₁' z)
    have h1 := congrArg M₁'_ext.val h1_ext
    rw [map_sum] at h1
    have h2 : (∑ σ : G_LM₁', ((σ (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F)) =
        ∑ k : Fin p, (((τ₀ ^ k.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F) :=
      (Fintype.sum_bijective (fun k : Fin p => τ₀ ^ k.1) hτ₀_bij
        (fun k : Fin p => (((τ₀ ^ k.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F))
        (fun σ : G_LM₁' => ((σ (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F))
        (fun _ => rfl)).symm
    have h2' : (∑ k : Fin p, (((τ₀ ^ k.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F)) =
        ∑ k : Fin p, (((σ₀ ^ k.1) z : M₁') : AlgebraicClosure F) :=
      Finset.sum_congr rfl fun k _ => hτ₀_pow_eq k.1 z
    have h3 : (∑ k : Fin p, (((σ₀ ^ k.1) z : M₁') : AlgebraicClosure F)) =
        ∑ k ∈ Finset.range p, (((σ₀ ^ k) z : M₁') : AlgebraicClosure F) :=
      Fin.sum_univ_eq_sum_range (fun k : ℕ => (((σ₀ ^ k) z : M₁') : AlgebraicClosure F)) p
    have h4 : (((∑ k ∈ Finset.range p, (σ₀ ^ k) z : M₁') : AlgebraicClosure F)) =
        ∑ k ∈ Finset.range p, (((σ₀ ^ k) z : M₁') : AlgebraicClosure F) :=
      map_sum M₁'.val (fun k : ℕ => (σ₀ ^ k) z) (Finset.range p)
    exact (h1.trans ((h2.trans h2').trans h3)).trans h4.symm
  have hσ₀_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
      ∏ k ∈ Finset.range p, (σ₀ ^ k) z := by
    intro z
    apply Subtype.ext
    have h1 := congrArg M₁'_ext.val (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLM₁' z))
    rw [map_prod] at h1
    have h2 : (∏ σ : G_LM₁', ((σ (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F)) =
        ∏ k : Fin p, (((τ₀ ^ k.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F) :=
      (Fintype.prod_bijective (fun k : Fin p => τ₀ ^ k.1) hτ₀_bij
        (fun k : Fin p => (((τ₀ ^ k.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F))
        (fun σ : G_LM₁' => ((σ (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F))
        (fun _ => rfl)).symm
    have h2' : (∏ k : Fin p, (((τ₀ ^ k.1) (toExtendScalars F hLM₁' z) : M₁'_ext) : AlgebraicClosure F)) =
        ∏ k : Fin p, (((σ₀ ^ k.1) z : M₁') : AlgebraicClosure F) :=
      Finset.prod_congr rfl fun k _ => hτ₀_pow_eq k.1 z
    have h3 : (∏ k : Fin p, (((σ₀ ^ k.1) z : M₁') : AlgebraicClosure F)) =
        ∏ k ∈ Finset.range p, (((σ₀ ^ k) z : M₁') : AlgebraicClosure F) :=
      Fin.prod_univ_eq_prod_range (fun k : ℕ => (((σ₀ ^ k) z : M₁') : AlgebraicClosure F)) p
    have h4 : (((∏ k ∈ Finset.range p, (σ₀ ^ k) z : M₁') : AlgebraicClosure F)) =
        ∏ k ∈ Finset.range p, (((σ₀ ^ k) z : M₁') : AlgebraicClosure F) :=
      map_prod M₁'.val (fun k : ℕ => (σ₀ ^ k) z) (Finset.range p)
    exact (h1.trans ((h2.trans h2').trans h3)).trans h4.symm
  have hnorm_σ₀ : ∀ z : M₁'ˣ,
      Units.map (normLM F hLM₁') (Units.map σ₀.toRingEquiv.toMonoidHom z) =
        Units.map (normLM F hLM₁') z := by
    intro z
    apply Units.ext
    change normLM F hLM₁' (σ₀ z.1) = normLM F hLM₁' z.1
    have h_ext : toExtendScalars F hLM₁' (σ₀ z.1) = τ₀ (toExtendScalars F hLM₁' z.1) := rfl
    unfold normLM
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply, RingHom.toMonoidHom_eq_coe,
      MonoidHom.coe_coe, h_ext]
    exact Algebra.norm_eq_of_algEquiv τ₀ (toExtendScalars F hLM₁' z.1)
  have hξM₁'_σ₀ : ∀ z : M₁'ˣ,
      ξM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z) = ξM₁' z := by
    intro z
    change νE' (Units.map (normLM F hLM₁') (Units.map σ₀.toRingEquiv.toMonoidHom z)) =
      νE' (Units.map (normLM F hLM₁') z)
    rw [hnorm_σ₀ z]
  let j₀ : ℕ := p - c
  have hj₀_pos : 0 < j₀ := by omega
  have hj₀_lt : j₀ < p := by omega
  have hj₀_add_c : j₀ + c = p := by omega
  have hFrobTwist_one : ∀ z : M₁'ˣ,
      θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z) = (ξM₁' z) ^ j₀ * θM₁' z := by
    intro z
    have h1 := hrec_σ₀ z
    rw [hrec_χM₁'_1, MonoidHom.mul_apply, MonoidHom.pow_apply, hξM₁'_σ₀ z] at h1
    have hpow_p : (ξM₁' z) ^ p = 1 := by
      rw [← MonoidHom.pow_apply, hξM₁'_pow, MonoidHom.one_apply]
    calc θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z)
      _ = 1 * θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z) := (one_mul _).symm
      _ = (ξM₁' z) ^ p * θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z) := by rw [hpow_p]
      _ = (ξM₁' z) ^ (j₀ + c) * θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z) := by rw [hj₀_add_c]
      _ = (ξM₁' z) ^ j₀ * ((ξM₁' z) ^ c * θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z)) := by
          rw [pow_add, mul_assoc]
      _ = (ξM₁' z) ^ j₀ * θM₁' z := by rw [h1]
  have hFrobTwist : ∀ (r : ℕ) (z : M₁'ˣ),
      θM₁' (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z) =
        (ξM₁' z) ^ (r * j₀) * θM₁' z := by
    intro r
    induction' r with r ih
    · intro z
      have h0 : Units.map (σ₀ ^ (0 : ℕ)).toRingEquiv.toMonoidHom z = z := by
        apply Units.ext
        rfl
      rw [h0, zero_mul, pow_zero, one_mul]
    · intro z
      let z' : M₁'ˣ := Units.map σ₀.toRingEquiv.toMonoidHom z
      have h_step : Units.map (σ₀ ^ (r + 1)).toRingEquiv.toMonoidHom z =
          Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z' := by
        apply Units.ext
        change ((σ₀ ^ (r + 1)) z.1 : M₁') = ((σ₀ ^ r) (σ₀ z.1) : M₁')
        rw [pow_succ, AlgEquiv.mul_apply]
      rw [h_step, ih z', hξM₁'_σ₀ z, hFrobTwist_one z, ← mul_assoc, ← pow_add, add_mul, one_mul]
  exact ⟨htraceChar_E'K₁, σ₀, j₀, hj₀_pos, hj₀_lt, hσ₀_L, hσ₀_val, hσ₀_tr, hσ₀_norm, hFrobTwist⟩

theorem ld_ch12_wild_odd_unramified_diamond_cond_and_frob_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hνE'M₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hUnramM₁' : condExp F L νM₁' = 0)
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (hχE'_comp : (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁)
    (hχM₁'_comp : (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
      (recChar F rec K₁ χK₁) u = 1)
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
        (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
      condExp F E' (ξE' ^ j * recChar F rec E' χE') =
        condExp F E' (recChar F rec E' χE'))
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁')),
        (ξM₁' ^ j * recChar F rec M₁' χM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') =
        condExp F M₁' (recChar F rec M₁' χM₁')) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let T := condExp F L νE'
    let θE' := recChar F rec E' χE'
    let θM₁' := recChar F rec M₁' χM₁'
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let ψK₁ := traceChar F (hLE'.trans hE'K₁) ψ
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    let mE' := condExp F E' θE'
    let mM₁' := condExp F M₁' θM₁'
    T ≤ mM₁' ∧
    mE' = T + p * (mM₁' - T) ∧
    condExpChar F M₁' ψM₁' = condExpChar F L ψ ∧
    condExpChar F E' ψE' = (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (T : ℤ) ∧
    condExpChar F K₁ ψK₁ = condExpChar F E' ψE' ∧
    ξM₁' ^ p = 1 ∧
    ξM₁' ≠ 1 ∧
    condExp F M₁' ξM₁' = T ∧
    ((qL F E' : Ω F) ^ (4 * condExpChar F E' ψE' + 2 * (mE' : ℤ))) *
        ((qL F L : Ω F) ^ (2 * (((p - 1 : ℕ) : ℤ) * (condExp F L νM₁' : ℤ)))) =
      ((qL F M₁' : Ω F) ^ (4 * condExpChar F M₁' ψM₁' + 2 * (mM₁' : ℤ))) *
        ((qL F L : Ω F) ^ (2 * (((p - 1 : ℕ) : ℤ) * (T : ℤ)))) ∧
    (∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x) ∧
    (∀ z : M₁', valL F L (normLM F hLM₁' z) = (p : ℤ) * valL F M₁' z) ∧
    (∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = (p : ℤ) * valL F L x) ∧
    (∀ y : E', valL F L (normLM F hLE' y) = valL F E' y) ∧
    (∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y) ∧
    (∀ w : K₁, valL F E' (normLM F hE'K₁ w) = (p : ℤ) * valL F K₁ w) ∧
    (∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z) ∧
    (∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w) ∧
    (∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z))) ∧
    (∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w))) ∧
    (∀ (d : ℕ), 1 ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w)))) ∧
    (∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y)) ∧
    (∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z)) ∧
    (∃ (y₁ : M₁') (w₁ : K₁) (σ₀ : M₁' ≃ₐ[F] M₁') (j₀ : ℕ),
      (y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) ∧
      traceLM F hLM₁' y₁ = 1 ∧
      (w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) ∧
      traceLM F hE'K₁ w₁ = 1 ∧
      0 < j₀ ∧ j₀ < p ∧
      (∀ x : L, σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
      (∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z) ∧
      (∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
        ∑ k ∈ Finset.range p, (σ₀ ^ k) z) ∧
      (∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) =
        ∏ k ∈ Finset.range p, (σ₀ ^ k) z) ∧
      (∀ (r : ℕ) (z : M₁'ˣ),
        θM₁' (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z) =
          (ξM₁' z) ^ (r * j₀) * θM₁' z)) :=
by
  obtain ⟨htraceChar_E'K₁, σ₀, j₀, hj₀_pos, hj₀_lt, hσ₀_L, hσ₀_val, hσ₀_tr, hσ₀_norm, hFrobTwist⟩ :=
    ld_ch12_bicyclic_frob_generator_and_conj_twist F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hPrime hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf h_sup
      χK₁ hInvK₁ hneK₁ χM₁' hχM₁'_weil hχM₁'_rest ψ hψ νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνM₁'_pow hνM₁'_ne hνM₁'_ker
  obtain ⟨hT_le, hmE'_eq, hnM₁'_eq, hnE'_eq, hnK₁_eq, hξM₁'_pow, hξM₁'_ne, hξM₁'_cond_eq,
    hq_pow_eq, hval_LM₁', hval_norm_LM₁', hval_LE', hval_norm_LE',
    hval_E'K₁, hval_norm_E'K₁, hval_M₁'K₁, hval_norm_M₁'K₁,
    htr_bound_LM₁', htr_bound_E'K₁, hnorm_lin_E'K₁,
    ⟨y₁, w₁, hy₁_int, hy₁_tr, hw₁_int, hw₁_tr⟩⟩ :=
    ld_ch12_wild_odd_unramified_four_edge_cond_and_val_package F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime hWild hdegM₁' hdegE'K₁ hdegM₁'K₁
      ψ hψ hψE' hψM₁' htraceChar_E'K₁ νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hνM₁'E'_cond hνE'M₁'_cond hbE'_ge2 hUnramM₁' hMinM₁' hMinE'
      (recChar F rec E' χE') (recChar F rec M₁' χM₁') (recChar F rec K₁ χK₁)
      hχE'_comp hχM₁'_comp hχK₁_cond hξE'_props hξM₁'_props
  have hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y) :=
    fun y => ld_bicyclic_diamond_norm_and_trace_compat F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLE' hGalM₁'K₁ hdegM₁'K₁ h_sup y
  have hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z) :=
    fun z => ld_bicyclic_diamond_norm_and_trace_compat F L M₁' E' K₁
      hLM₁' hLE' hM₁'K₁ hE'K₁ hGalLM₁' hGalE'K₁ (hdegE'K₁.trans hdegM₁'.symm)
      ((sup_comm M₁' E').trans h_sup) z
  exact ⟨hT_le, hmE'_eq, hnM₁'_eq, hnE'_eq, hnK₁_eq, hξM₁'_pow, hξM₁'_ne, hξM₁'_cond_eq,
    hq_pow_eq, hval_LM₁', hval_norm_LM₁', hval_LE', hval_norm_LE',
    hval_E'K₁, hval_norm_E'K₁, hval_M₁'K₁, hval_norm_M₁'K₁,
    htr_bound_LM₁', htr_bound_E'K₁, hnorm_lin_E'K₁, hDiamond_E', hDiamond_M₁',
    ⟨y₁, w₁, σ₀, j₀, hy₁_int, hy₁_tr, hw₁_int, hw₁_tr, hj₀_pos, hj₀_lt,
     hσ₀_L, hσ₀_val, hσ₀_tr, hσ₀_norm, hFrobTwist⟩⟩

theorem ld_wild_odd_quad_norm_trace_norm_congruence (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hp_val : ((Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : L) = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤
        valL F L ((Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : L))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (s : K → ℕ → L)
    (hs1 : ∀ y : K, s y 1 = traceLM F hLK y)
    (hs2 : ∀ y : K, 2 * s y 2 = (traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2))
    (hs_val : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) * (T : ℤ) ≤
            (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_poly : ∀ (y : K) (c : L),
      normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
        1 + (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
          c ^ r * s y r) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ∀ (h : ℕ) (z : K),
      (z = 0 ∨ (((T + p * h) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      let u := normLM F hLK (1 + z) - 1
      let q_z := (2 : K)⁻¹ * (2 * z - z ^ 2)
      (2 * u - u ^ 2) - (traceLM F hLK (2 * z - z ^ 2) + 2 * normLM F hLK q_z) = 0 ∨
        ((T + h : ℕ) : ℤ) ≤
          valL F L ((2 * u - u ^ 2) - (traceLM F hLK (2 * z - z ^ 2) + 2 * normLM F hLK q_z)) :=
by
  intro p h z hz u q_z
  change Nat.Prime p at hPrime
  change p ≠ 2 at hp_odd
  change ((p : ℕ) : L) = 0 ∨ ((T - T / 2 : ℕ) : ℤ) ≤ valL F L ((p : ℕ) : L) at hp_val
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  rcases hvalL_props with
    ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, _, hval_add, _⟩
  have hval_neg_ge : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hkx
    · left; simp
    · right; rwa [hval_neg]
  have hval_sub_ge : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add k x (-y) hx (hval_neg_ge k y hy)
  have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : k₁ ≤ valL F L x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        linarith
  have hval_mono : ∀ {k₁ k₂ : ℤ} {x : L},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx'
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx')
  have hval_sum_ge : ∀ (S : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ a ∈ S, f a = 0 ∨ k ≤ valL F L (f a)) →
        ((∑ a ∈ S, f a) = 0 ∨ k ≤ valL F L (∑ a ∈ S, f a)) := by
    intro S f k hS
    induction' S using Finset.induction_on with a S ha ih
    · left; simp
    · rw [Finset.sum_insert ha]
      apply hval_add k (f a) (∑ x ∈ S, f x)
      · exact hS a (Finset.mem_insert_self a S)
      · exact ih (fun x hx => hS x (Finset.mem_insert_of_mem hx))
  have hnat_val : ∀ n : ℕ, (n : L) = 0 ∨ (0 : ℤ) ≤ valL F L (n : L) := by
    intro n
    induction' n with n ih
    · left; simp
    · rw [Nat.cast_succ]
      exact hval_add 0 (n : L) 1 ih (Or.inr (by rw [hval1]))
  have hp_ge1 : ((p : ℕ) : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((p : ℕ) : L) :=
    hval_mono (by omega : (1 : ℤ) ≤ ((T - T / 2 : ℕ) : ℤ)) hp_val
  have h2_not_pos : ¬ ((2 : L) = 0 ∨ (1 : ℤ) ≤ valL F L (2 : L)) := by
    intro h2_bad
    rcases hp_odd_nat with ⟨k_p, hk_p⟩
    have h2kp : (2 : L) * (k_p : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((2 : L) * (k_p : L)) := by
      simpa using hval_mul_ge 1 0 (2 : L) (k_p : L) h2_bad (hnat_val k_p)
    have h1_bad : ((p : ℕ) : L) - (2 : L) * (k_p : L) = 0 ∨
        (1 : ℤ) ≤ valL F L (((p : ℕ) : L) - (2 : L) * (k_p : L)) :=
      hval_sub_ge 1 ((p : ℕ) : L) ((2 : L) * (k_p : L)) hp_ge1 h2kp
    have h1_eq : ((p : ℕ) : L) - (2 : L) * (k_p : L) = 1 := by
      rw [hk_p]; push_cast; ring
    rw [h1_eq, hval1] at h1_bad
    rcases h1_bad with h10 | h1le0
    · exact one_ne_zero h10
    · omega
  have h2L_ne0 : (2 : L) ≠ 0 := fun h0 => h2_not_pos (Or.inl h0)
  have hvalL_2 : valL F L (2 : L) = 0 := by
    have h2_ge0 : (2 : L) = 0 ∨ (0 : ℤ) ≤ valL F L (2 : L) := by
      simpa using hnat_val 2
    have h2_ge0' : (0 : ℤ) ≤ valL F L (2 : L) := h2_ge0.resolve_left h2L_ne0
    have h2_not1 : ¬ ((1 : ℤ) ≤ valL F L (2 : L)) := fun h1 => h2_not_pos (Or.inr h1)
    omega
  let u2 : Lˣ := Units.mk0 (2 : L) h2L_ne0
  have hvalL_2inv : valL F L ((2 : L)⁻¹) = 0 := by
    have hinv := hval_inv u2
    change valL F L ((2 : L)⁻¹) = - valL F L (2 : L) at hinv
    rw [hinv, hvalL_2, neg_zero]
  have hval_pow_nonneg : ∀ (c : L), (c = 0 ∨ (0 : ℤ) ≤ valL F L c) →
      ∀ r : ℕ, c ^ r = 0 ∨ (0 : ℤ) ≤ valL F L (c ^ r) := by
    intro c hc r
    induction' r with r ih
    · rw [pow_zero]; exact Or.inr (by rw [hval1])
    · rw [pow_succ]
      simpa using hval_mul_ge 0 0 (c ^ r) c ih hc
  have hval_2inv_pow : ∀ r : ℕ, ((2 : L)⁻¹) ^ r = 0 ∨ (0 : ℤ) ≤ valL F L (((2 : L)⁻¹) ^ r) :=
    hval_pow_nonneg ((2 : L)⁻¹) (Or.inr (by rw [hvalL_2inv]))
  have hval_neg2inv_pow : ∀ r : ℕ,
      (-(2 : L)⁻¹) ^ r = 0 ∨ (0 : ℤ) ≤ valL F L ((-(2 : L)⁻¹) ^ r) :=
    hval_pow_nonneg (-(2 : L)⁻¹) (Or.inr (by rw [hval_neg, hvalL_2inv]))
  have hcop : Nat.Coprime 2 p := by
    rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd hPrime]
    intro hdvd
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
    · exact hPrime.ne_one h1
    · exact hp_odd h2
  have hfermat_mod : 2 ^ (p - 1) ≡ 1 [MOD p] := by
    have htot := Nat.ModEq.pow_totient hcop
    rwa [Nat.totient_prime hPrime] at htot
  have hfermat_dvd : p ∣ 2 ^ (p - 1) - 1 :=
    (Nat.modEq_iff_dvd' Nat.one_le_two_pow).mp hfermat_mod.symm
  rcases hfermat_dvd with ⟨k_f, hk_f⟩
  have hfermat_L : (2 : L) ^ (p - 1) - 1 = ((p : ℕ) : L) * (k_f : L) := by
    have hcast := congrArg (Nat.cast (R := L)) hk_f
    rw [Nat.cast_sub Nat.one_le_two_pow, Nat.cast_pow, Nat.cast_ofNat, Nat.cast_one,
      Nat.cast_mul] at hcast
    exact hcast
  have hval_fermat : (2 : L) ^ (p - 1) - 1 = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤ valL F L ((2 : L) ^ (p - 1) - 1) := by
    rw [hfermat_L]
    simpa using hval_mul_ge ((T - T / 2 : ℕ) : ℤ) 0 ((p : ℕ) : L) (k_f : L) hp_val (hnat_val k_f)
  set d_E : ℕ := (T + p * h) / 2
  set s1 : L := s z 1
  set s2 : L := s z 2
  set R3 : L := ∑ r ∈ Finset.Icc 3 (p - 1), s z r
  set ep : L := normLM F hLK z
  set S_neg : L := ∑ r ∈ Finset.Icc 1 (p - 1), (-(2 : L)⁻¹) ^ r * s z r
  have hIcc_split : Finset.Icc 1 (p - 1) = insert 1 (insert 2 (Finset.Icc 3 (p - 1))) := by
    ext r
    simp only [Finset.mem_Icc, Finset.mem_insert]
    omega
  have h1_not_mem : (1 : ℕ) ∉ insert 2 (Finset.Icc 3 (p - 1)) := by
    simp only [Finset.mem_insert, Finset.mem_Icc]
    omega
  have h2_not_mem : (2 : ℕ) ∉ Finset.Icc 3 (p - 1) := by
    simp only [Finset.mem_Icc]
    omega
  have hu_eq : u = s1 + s2 + R3 + ep := by
    have hpoly1 := hs_poly z 1
    simp only [map_one, one_mul, one_pow] at hpoly1
    change normLM F hLK (1 + z) = 1 + (∑ r ∈ Finset.Icc 1 (p - 1), s z r) + ep at hpoly1
    rw [hIcc_split, Finset.sum_insert h1_not_mem, Finset.sum_insert h2_not_mem] at hpoly1
    change normLM F hLK (1 + z) = 1 + (s1 + (s2 + R3)) + ep at hpoly1
    change normLM F hLK (1 + z) - 1 = s1 + s2 + R3 + ep
    linear_combination hpoly1
  have htr_eq : traceLM F hLK (2 * z - z ^ 2) = 2 * s1 + 2 * s2 - s1 ^ 2 := by
    have htr1 : traceLM F hLK z = s1 := (hs1 z).symm
    have htr2 : 2 * s2 = s1 ^ 2 - traceLM F hLK (z ^ 2) := by
      have h2 := hs2 z
      rw [← hs1 z] at h2
      exact h2
    have htr_lin : traceLM F hLK (2 * z - z ^ 2) = 2 * traceLM F hLK z - traceLM F hLK (z ^ 2) := by
      rw [map_sub, two_mul, map_add, two_mul]
    linear_combination htr_lin + 2 * htr1 - htr2
  have h2K_eq : IntermediateField.inclusion hLK (2 : L) = (2 : K) :=
    map_ofNat (IntermediateField.inclusion hLK) 2
  have h2K_ne0 : (2 : K) ≠ 0 := by
    intro h0
    apply h2L_ne0
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (2 : L) = IntermediateField.inclusion hLK 0
    rw [h2K_eq, h0, map_zero]
  have hq_z_eq : q_z = z * (1 + IntermediateField.inclusion hLK (-(2 : L)⁻¹) * z) := by
    change (2 : K)⁻¹ * (2 * z - z ^ 2) = z * (1 + IntermediateField.inclusion hLK (-(2 : L)⁻¹) * z)
    rw [map_neg, map_inv₀, h2K_eq]
    calc (2 : K)⁻¹ * (2 * z - z ^ 2)
      _ = z * ((2 : K)⁻¹ * (2 : K) - (2 : K)⁻¹ * z) := by ring
      _ = z * (1 + -(2 : K)⁻¹ * z) := by rw [inv_mul_cancel₀ h2K_ne0]; ring
  have hnorm_qz_eq : normLM F hLK q_z = ep * (1 + S_neg - ((2 : L)⁻¹) ^ p * ep) := by
    rw [hq_z_eq, map_mul, hs_poly z (-(2 : L)⁻¹)]
    have hneg_pow : (-(2 : L)⁻¹) ^ p = - (((2 : L)⁻¹) ^ p) :=
      Odd.neg_pow hp_odd_nat ((2 : L)⁻¹)
    change ep * (1 + S_neg + (-(2 : L)⁻¹) ^ p * ep) = ep * (1 + S_neg - ((2 : L)⁻¹) ^ p * ep)
    rw [hneg_pow]
    ring
  have h2_pow_p : (2 : L) * ((2 : L)⁻¹) ^ p = ((2 : L)⁻¹) ^ (p - 1) := by
    have hp_eq : p = (p - 1) + 1 := by omega
    conv_lhs => rw [hp_eq, pow_succ]
    calc (2 : L) * (((2 : L)⁻¹) ^ (p - 1) * (2 : L)⁻¹)
      _ = ((2 : L)⁻¹) ^ (p - 1) * ((2 : L) * (2 : L)⁻¹) := by ring
      _ = ((2 : L)⁻¹) ^ (p - 1) * 1 := by rw [mul_inv_cancel₀ h2L_ne0]
      _ = ((2 : L)⁻¹) ^ (p - 1) := mul_one _
  have h2_pow_pm1 : ((2 : L)⁻¹) ^ (p - 1) * (2 : L) ^ (p - 1) = 1 := by
    rw [← mul_pow, inv_mul_cancel₀ h2L_ne0, one_pow]
  have hmain_id :
      (2 * u - u ^ 2) - (traceLM F hLK (2 * z - z ^ 2) + 2 * normLM F hLK q_z) =
        (- (((2 : L)⁻¹) ^ (p - 1) * ((2 : L) ^ (p - 1) - 1) * ep ^ 2)) +
        (R3 * (2 - 2 * s1 - 2 * s2 - R3 - 2 * ep)) +
        (- (2 * s1 * s2 + s2 ^ 2)) +
        (- ((2 : L) * ep * (s1 + s2 + S_neg))) := by
    rw [hu_eq, htr_eq, hnorm_qz_eq]
    linear_combination (ep ^ 2) * h2_pow_p + (ep ^ 2) * h2_pow_pm1
  have hs0_zero : ∀ r ∈ Finset.Icc 1 (p - 1), s 0 r = 0 := by
    intro r hr
    have hr1 : 1 ≤ r := (Finset.mem_Icc.mp hr).1
    let m0 : ℤ := max 1 (valL F L (s 0 r) + 1)
    let q0 : ℤ := (p : ℤ) * m0
    have hm0_ge1 : 1 ≤ m0 := le_max_left 1 _
    have hm0_gt : valL F L (s 0 r) + 1 ≤ m0 := le_max_right 1 _
    have hq0_nonneg : 0 ≤ q0 := by
      dsimp only [q0]
      nlinarith
    have hineq0 : (p : ℤ) * m0 - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * q0 := by
      dsimp only [q0]
      have hr1_int : (1 : ℤ) ≤ (r : ℤ) := by exact_mod_cast hr1
      have h1 : (p : ℤ) * m0 ≤ (r : ℤ) * ((p : ℤ) * m0) := by nlinarith
      have h2 : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by positivity
      linarith
    rcases hs_val 0 r hr q0 m0 (Or.inl rfl) hineq0 with hs0 | hle
    · exact hs0
    · omega
  have hnorm0 : normLM F hLK 0 = 0 := by
    have hpoly0 := hs_poly 0 1
    simp only [mul_zero, add_zero, map_one, one_pow, one_mul] at hpoly0
    have hsum0 : (∑ r ∈ Finset.Icc 1 (p - 1), s 0 r) = 0 :=
      Finset.sum_eq_zero hs0_zero
    rw [hsum0] at hpoly0
    linear_combination -hpoly0
  have hep_val : ep = 0 ∨ (d_E : ℤ) ≤ valL F L ep := by
    rcases hz with rfl | hz_val
    · left
      exact hnorm0
    · right
      dsimp only [ep]
      rw [hval_norm z]
      exact hz_val
  have hep_sq : ep ^ 2 = 0 ∨ (d_E : ℤ) + (d_E : ℤ) ≤ valL F L (ep ^ 2) := by
    rw [sq]
    exact hval_mul_ge (d_E : ℤ) (d_E : ℤ) ep ep hep_val hep_val
  have hpiece1 :
      (- (((2 : L)⁻¹) ^ (p - 1) * ((2 : L) ^ (p - 1) - 1) * ep ^ 2)) = 0 ∨
      ((T + h : ℕ) : ℤ) ≤
        valL F L (- (((2 : L)⁻¹) ^ (p - 1) * ((2 : L) ^ (p - 1) - 1) * ep ^ 2)) := by
    have h12 := hval_mul_ge 0 ((T - T / 2 : ℕ) : ℤ)
      (((2 : L)⁻¹) ^ (p - 1)) ((2 : L) ^ (p - 1) - 1)
      (hval_2inv_pow (p - 1)) hval_fermat
    have h123 := hval_mul_ge (0 + ((T - T / 2 : ℕ) : ℤ)) ((d_E : ℤ) + (d_E : ℤ))
      ((((2 : L)⁻¹) ^ (p - 1)) * ((2 : L) ^ (p - 1) - 1)) (ep ^ 2)
      h12 hep_sq
    have hneg := hval_neg_ge
      ((0 + ((T - T / 2 : ℕ) : ℤ)) + ((d_E : ℤ) + (d_E : ℤ)))
      ((((2 : L)⁻¹) ^ (p - 1)) * ((2 : L) ^ (p - 1) - 1) * ep ^ 2)
      h123
    apply hval_mono _ hneg
    have hph : 3 * h ≤ p * h := Nat.mul_le_mul_right h hp_ge3
    have hdE_def : d_E = (T + p * h) / 2 := rfl
    omega
  have hs_nonneg : ∀ r ∈ Finset.Icc 1 (p - 1), s z r = 0 ∨ (0 : ℤ) ≤ valL F L (s z r) := by
    intro r hr
    apply hs_val z r hr (d_E : ℤ) 0 hz
    have h1 : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by positivity
    have h2 : (0 : ℤ) ≤ (r : ℤ) * (d_E : ℤ) := by positivity
    linarith
  have hs1_nonneg : s1 = 0 ∨ (0 : ℤ) ≤ valL F L s1 :=
    hs_nonneg 1 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
  have hs2_nonneg : s2 = 0 ∨ (0 : ℤ) ≤ valL F L s2 :=
    hs_nonneg 2 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
  have hR3_nonneg : R3 = 0 ∨ (0 : ℤ) ≤ valL F L R3 := by
    apply hval_sum_ge (Finset.Icc 3 (p - 1)) (fun r => s z r) 0
    intro r hr
    have hr' : r ∈ Finset.Icc 1 (p - 1) := by
      simp only [Finset.mem_Icc] at hr ⊢
      omega
    exact hs_nonneg r hr'
  have hep_nonneg : ep = 0 ∨ (0 : ℤ) ≤ valL F L ep :=
    hval_mono (by positivity) hep_val
  have h2_nonneg : (2 : L) = 0 ∨ (0 : ℤ) ≤ valL F L (2 : L) :=
    Or.inr (by rw [hvalL_2])
  have h2s1_nonneg : 2 * s1 = 0 ∨ (0 : ℤ) ≤ valL F L (2 * s1) := by
    simpa using hval_mul_ge 0 0 (2 : L) s1 h2_nonneg hs1_nonneg
  have h2s2_nonneg : 2 * s2 = 0 ∨ (0 : ℤ) ≤ valL F L (2 * s2) := by
    simpa using hval_mul_ge 0 0 (2 : L) s2 h2_nonneg hs2_nonneg
  have h2ep_nonneg : 2 * ep = 0 ∨ (0 : ℤ) ≤ valL F L (2 * ep) := by
    simpa using hval_mul_ge 0 0 (2 : L) ep h2_nonneg hep_nonneg
  have hfactor_nonneg :
      (2 - 2 * s1 - 2 * s2 - R3 - 2 * ep) = 0 ∨
      (0 : ℤ) ≤ valL F L (2 - 2 * s1 - 2 * s2 - R3 - 2 * ep) := by
    have ha := hval_sub_ge 0 (2 : L) (2 * s1) h2_nonneg h2s1_nonneg
    have hb := hval_sub_ge 0 (2 - 2 * s1) (2 * s2) ha h2s2_nonneg
    have hc := hval_sub_ge 0 (2 - 2 * s1 - 2 * s2) R3 hb hR3_nonneg
    exact hval_sub_ge 0 (2 - 2 * s1 - 2 * s2 - R3) (2 * ep) hc h2ep_nonneg
  have hdE_ge1 : 1 ≤ d_E := by
    have hdE_def : d_E = (T + p * h) / 2 := rfl
    omega
  have hR3_val : R3 = 0 ∨ ((T + h : ℕ) : ℤ) ≤ valL F L R3 := by
    apply hval_sum_ge (Finset.Icc 3 (p - 1)) (fun r => s z r) ((T + h : ℕ) : ℤ)
    intro r hr
    have hr3 : 3 ≤ r := (Finset.mem_Icc.mp hr).1
    have hr_le : r ≤ p - 1 := (Finset.mem_Icc.mp hr).2
    have hr_mem : r ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hr_le⟩
    apply hs_val z r hr_mem (d_E : ℤ) ((T + h : ℕ) : ℤ) hz
    have hdE_def : d_E = (T + p * h) / 2 := rfl
    have h_nat : T + p * h ≤ r * d_E := by
      have h1 : T + p * h ≤ 3 * d_E := by omega
      have h2 : 3 * d_E ≤ r * d_E := Nat.mul_le_mul_right d_E hr3
      exact le_trans h1 h2
    have h_int : (T : ℤ) + (p : ℤ) * (h : ℤ) ≤ (r : ℤ) * (d_E : ℤ) := by
      exact_mod_cast h_nat
    rw [hp_sub]
    push_cast
    linarith
  have hpiece2 :
      (R3 * (2 - 2 * s1 - 2 * s2 - R3 - 2 * ep)) = 0 ∨
      ((T + h : ℕ) : ℤ) ≤ valL F L (R3 * (2 - 2 * s1 - 2 * s2 - R3 - 2 * ep)) := by
    simpa using hval_mul_ge ((T + h : ℕ) : ℤ) 0 R3 (2 - 2 * s1 - 2 * s2 - R3 - 2 * ep)
      hR3_val hfactor_nonneg
  set v1 : ℕ := (d_E + (p - 1) * T) / p
  set v2 : ℕ := (2 * d_E + (p - 1) * T) / p
  have hs1_v1 : s1 = 0 ∨ (v1 : ℤ) ≤ valL F L s1 := by
    apply hs_val z 1 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩) (d_E : ℤ) (v1 : ℤ) hz
    change (p : ℤ) * (v1 : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ ((1 : ℕ) : ℤ) * (d_E : ℤ)
    have hmul : p * v1 ≤ d_E + (p - 1) * T := Nat.mul_div_le (d_E + (p - 1) * T) p
    have hmul_int : (p : ℤ) * (v1 : ℤ) ≤ (d_E : ℤ) + ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by
      exact_mod_cast hmul
    push_cast
    linarith
  have hs2_v2 : s2 = 0 ∨ (v2 : ℤ) ≤ valL F L s2 := by
    apply hs_val z 2 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩) (d_E : ℤ) (v2 : ℤ) hz
    change (p : ℤ) * (v2 : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ ((2 : ℕ) : ℤ) * (d_E : ℤ)
    have hmul : p * v2 ≤ 2 * d_E + (p - 1) * T := Nat.mul_div_le (2 * d_E + (p - 1) * T) p
    have hmul_int : (p : ℤ) * (v2 : ℤ) ≤ 2 * (d_E : ℤ) + ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by
      exact_mod_cast hmul
    push_cast
    linarith
  have hv1_low : d_E + (p - 1) * T + 1 ≤ p * v1 + p := by
    have hdiv := Nat.div_add_mod (d_E + (p - 1) * T) p
    have hmod := Nat.mod_lt (d_E + (p - 1) * T) hp_pos
    change p * v1 + (d_E + (p - 1) * T) % p = d_E + (p - 1) * T at hdiv
    omega
  have hv2_low : 2 * d_E + (p - 1) * T + 1 ≤ p * v2 + p := by
    have hdiv := Nat.div_add_mod (2 * d_E + (p - 1) * T) p
    have hmod := Nat.mod_lt (2 * d_E + (p - 1) * T) hp_pos
    change p * v2 + (2 * d_E + (p - 1) * T) % p = 2 * d_E + (p - 1) * T at hdiv
    omega
  have hkey_ineq : p * (T + h + 2) ≤ 3 * d_E + 2 * (p - 1) * T + 2 := by
    have hdE_def : d_E = (T + p * h) / 2 := rfl
    have h1 : (T : ℤ) + (p : ℤ) * (h : ℤ) ≤ 2 * (d_E : ℤ) + 1 := by omega
    have h2 : (1 : ℤ) ≤ (d_E : ℤ) := by omega
    have h3 : (2 : ℤ) ≤ (p : ℤ) := by omega
    have h4 : (2 : ℤ) ≤ (T : ℤ) := by omega
    have h5 : (p : ℤ) * ((T : ℤ) + (h : ℤ) + 2) ≤
        3 * (d_E : ℤ) + 2 * ((p - 1 : ℕ) : ℤ) * (T : ℤ) + 2 := by
      rw [hp_sub]
      nlinarith
    exact_mod_cast h5
  have hv12_ge : T + h ≤ v1 + v2 := by
    have hmul : p * (T + h + 2) ≤ p * (v1 + v2 + 2) := by
      calc p * (T + h + 2)
        _ ≤ 3 * d_E + 2 * (p - 1) * T + 2 := hkey_ineq
        _ = (d_E + (p - 1) * T + 1) + (2 * d_E + (p - 1) * T + 1) := by ring
        _ ≤ (p * v1 + p) + (p * v2 + p) := add_le_add hv1_low hv2_low
        _ = p * (v1 + v2 + 2) := by ring
    have hle := Nat.le_of_mul_le_mul_left hmul hp_pos
    omega
  have hv22_ge : T + h ≤ 2 * v2 := by
    have hmul : p * (T + h + 2) ≤ p * (2 * v2 + 2) := by
      calc p * (T + h + 2)
        _ ≤ 3 * d_E + 2 * (p - 1) * T + 2 := hkey_ineq
        _ ≤ 4 * d_E + 2 * (p - 1) * T + 2 := by omega
        _ = (2 * d_E + (p - 1) * T + 1) + (2 * d_E + (p - 1) * T + 1) := by ring
        _ ≤ (p * v2 + p) + (p * v2 + p) := add_le_add hv2_low hv2_low
        _ = p * (2 * v2 + 2) := by ring
    have hle := Nat.le_of_mul_le_mul_left hmul hp_pos
    omega
  have hpiece3 :
      (- (2 * s1 * s2 + s2 ^ 2)) = 0 ∨
      ((T + h : ℕ) : ℤ) ≤ valL F L (- (2 * s1 * s2 + s2 ^ 2)) := by
    have h2s1s2 : 2 * s1 * s2 = 0 ∨ ((T + h : ℕ) : ℤ) ≤ valL F L (2 * s1 * s2) := by
      have ha := hval_mul_ge 0 (v1 : ℤ) (2 : L) s1 h2_nonneg hs1_v1
      have hb := hval_mul_ge (0 + (v1 : ℤ)) (v2 : ℤ) (2 * s1) s2 ha hs2_v2
      exact hval_mono (by omega) hb
    have hs2sq : s2 ^ 2 = 0 ∨ ((T + h : ℕ) : ℤ) ≤ valL F L (s2 ^ 2) := by
      rw [sq]
      have ha := hval_mul_ge (v2 : ℤ) (v2 : ℤ) s2 s2 hs2_v2 hs2_v2
      exact hval_mono (by omega) ha
    exact hval_neg_ge ((T + h : ℕ) : ℤ) (2 * s1 * s2 + s2 ^ 2)
      (hval_add ((T + h : ℕ) : ℤ) (2 * s1 * s2) (s2 ^ 2) h2s1s2 hs2sq)
  set m1 : ℤ := ((T + h : ℕ) : ℤ) - (d_E : ℤ)
  have hm1_ineq : (p : ℤ) * m1 - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (d_E : ℤ) := by
    have hdE_def : d_E = (T + p * h) / 2 := rfl
    have h1 : T + p * h ≤ 3 * d_E := by omega
    have h2 : 3 * d_E ≤ (p + 1) * d_E := Nat.mul_le_mul_right d_E (by omega)
    have h3 : T + p * h ≤ (p + 1) * d_E := le_trans h1 h2
    have h3_int : (T : ℤ) + (p : ℤ) * (h : ℤ) ≤ ((p : ℤ) + 1) * (d_E : ℤ) := by
      exact_mod_cast h3
    dsimp only [m1]
    rw [hp_sub]
    push_cast
    linarith
  have hs_m1 : ∀ r ∈ Finset.Icc 1 (p - 1), s z r = 0 ∨ m1 ≤ valL F L (s z r) := by
    intro r hr
    have hr1 : 1 ≤ r := (Finset.mem_Icc.mp hr).1
    apply hs_val z r hr (d_E : ℤ) m1 hz
    have hrdE : (d_E : ℤ) ≤ (r : ℤ) * (d_E : ℤ) := by
      have hr1_int : (1 : ℤ) ≤ (r : ℤ) := by exact_mod_cast hr1
      nlinarith
    exact le_trans hm1_ineq hrdE
  have hs1_m1 : s1 = 0 ∨ m1 ≤ valL F L s1 :=
    hs_m1 1 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
  have hs2_m1 : s2 = 0 ∨ m1 ≤ valL F L s2 :=
    hs_m1 2 (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
  have hS_neg_m1 : S_neg = 0 ∨ m1 ≤ valL F L S_neg := by
    apply hval_sum_ge (Finset.Icc 1 (p - 1)) (fun r => (-(2 : L)⁻¹) ^ r * s z r) m1
    intro r hr
    simpa using hval_mul_ge 0 m1 ((-(2 : L)⁻¹) ^ r) (s z r)
      (hval_neg2inv_pow r) (hs_m1 r hr)
  have hsum_m1 : (s1 + s2 + S_neg) = 0 ∨ m1 ≤ valL F L (s1 + s2 + S_neg) :=
    hval_add m1 (s1 + s2) S_neg (hval_add m1 s1 s2 hs1_m1 hs2_m1) hS_neg_m1
  have hpiece4 :
      (- ((2 : L) * ep * (s1 + s2 + S_neg))) = 0 ∨
      ((T + h : ℕ) : ℤ) ≤ valL F L (- ((2 : L) * ep * (s1 + s2 + S_neg))) := by
    have h2ep : (2 : L) * ep = 0 ∨ (d_E : ℤ) ≤ valL F L ((2 : L) * ep) := by
      simpa using hval_mul_ge 0 (d_E : ℤ) (2 : L) ep h2_nonneg hep_val
    have hprod := hval_mul_ge (d_E : ℤ) m1 ((2 : L) * ep) (s1 + s2 + S_neg) h2ep hsum_m1
    have hneg := hval_neg_ge ((d_E : ℤ) + m1) ((2 : L) * ep * (s1 + s2 + S_neg)) hprod
    exact hval_mono (by dsimp only [m1]; omega) hneg
  rw [hmain_id]
  have h12 := hval_add ((T + h : ℕ) : ℤ) _ _ hpiece1 hpiece2
  have h123 := hval_add ((T + h : ℕ) : ℤ) _ _ h12 hpiece3
  exact hval_add ((T + h : ℕ) : ℤ) _ _ h123 hpiece4

theorem ld_wild_odd_symm_subset_sum_and_cayley_hamilton (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
      IntermediateField.inclusion hLK x)
    (hact_norm : ∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y)
    (s : K → ℕ → L)
    (hs_poly : ∀ (y : K) (c : L),
      normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
        1 + (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
          c ^ r * s y r) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    (∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      IntermediateField.inclusion hLK (s y r) =
        ∑ S ∈ ((Finset.univ : Finset G).powerset.filter (fun S => S.card = r)),
          ∏ σ ∈ S, act σ y) ∧
    (∀ y : K,
      y ^ p =
        IntermediateField.inclusion hLK (normLM F hLK y) +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K) ^ (i - 1) * IntermediateField.inclusion hLK (s y i) * y ^ (p - i)) :=
by
  rcases hvalL_props with
    ⟨_, _, _, _, _, _, hvalL_surj, _, _, _, _⟩
  rcases hvalK_props with
    ⟨_, hvalK1, _, hvalK_neg, hvalK_mul, _, _, hvalK_add, _, _, _⟩
  intro p
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  let ι := IntermediateField.inclusion hLK
  let U_G : Finset G := Finset.univ
  have hcard_univ : U_G.card = p := Finset.card_univ.trans hcard_G
  let U_pow : Finset (Finset G) := U_G.powerset
  let P_card : ℕ → Finset (Finset G) := fun r => U_pow.filter (fun S => S.card = r)
  let P : K → Finset G → K := fun y S => ∏ σ ∈ S, act σ y
  let E : K → ℕ → K := fun y r => ∑ S ∈ P_card r, P y S
  
  have hmem_P : ∀ (r : ℕ) (S : Finset G), S ∈ P_card r ↔ S.card = r := by
    intro r S
    simp [P_card, U_pow, U_G]
  have hP0_eq : P_card 0 = {∅} := by
    ext S
    simp [hmem_P, Finset.card_eq_zero]
  have hPp_eq : P_card p = {U_G} := by
    ext S
    simp only [hmem_P, Finset.mem_singleton]
    constructor
    · intro h
      exact Finset.eq_univ_of_card S (h.trans hcard_G.symm)
    · rintro rfl
      exact hcard_univ
  have hprod_linear : ∀ (y w z : K),
      (∏ σ ∈ U_G, (w * act σ y + z)) =
        z ^ p +
          (∑ r ∈ Finset.Icc 1 (p - 1), w ^ r * E y r * z ^ (p - r)) +
          w ^ p * ι (normLM F hLK y) := by
    intro y w z
    let Q : Finset G → K := fun S => w ^ S.card * P y S * z ^ (p - S.card)
    have hprod_powerset : (∏ σ ∈ U_G, (w * act σ y + z)) = ∑ S ∈ U_pow, Q S := by
      rw [Finset.prod_add (fun σ => w * act σ y) (fun _ => z) U_G]
      refine Finset.sum_congr rfl fun S _ => ?_
      dsimp only [Q, P]
      rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_const,
        Finset.card_sdiff_of_subset (Finset.subset_univ S), hcard_univ]
    let F_term : ℕ → K := fun r => w ^ r * E y r * z ^ (p - r)
    have hmaps_card : ∀ S ∈ U_pow, S.card ∈ Finset.range (p + 1) := by
      intro S _
      rw [Finset.mem_range]
      have hle : S.card ≤ U_G.card := Finset.card_le_univ S
      omega
    have hsum_fiber : (∑ S ∈ U_pow, Q S) = ∑ r ∈ Finset.range (p + 1), F_term r := by
      rw [← Finset.sum_fiberwise_of_maps_to hmaps_card Q]
      refine Finset.sum_congr rfl fun r _ => ?_
      change (∑ S ∈ P_card r, Q S) = F_term r
      have h1 : (∑ S ∈ P_card r, Q S) =
          ∑ S ∈ P_card r, (w ^ r * P y S * z ^ (p - r)) := by
        refine Finset.sum_congr rfl fun S hS => ?_
        have hcard : S.card = r := (hmem_P r S).mp hS
        dsimp only [Q]
        rw [hcard]
      have h2 : (∑ S ∈ P_card r, (w ^ r * P y S * z ^ (p - r))) =
          w ^ r * (∑ S ∈ P_card r, P y S) * z ^ (p - r) := by
        rw [Finset.mul_sum, Finset.sum_mul]
      rw [h1, h2]
    have hrange_split :
        (∑ r ∈ Finset.range (p + 1), F_term r) =
          F_term 0 + (∑ r ∈ Finset.Icc 1 (p - 1), F_term r) + F_term p := by
      rw [Finset.sum_range_succ F_term p]
      have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hPrime.pos
      rw [← Finset.add_sum_erase (Finset.range p) F_term h0_mem]
      have herase_eq : (Finset.range p).erase 0 = Finset.Icc 1 (p - 1) := by
        ext r
        simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_Icc]
        omega
      rw [herase_eq]
    have hF0 : F_term 0 = z ^ p := by
      dsimp only [F_term, E]
      rw [hP0_eq, Finset.sum_singleton]
      have hP_empty : P y ∅ = 1 := Finset.prod_empty
      rw [hP_empty, pow_zero, Nat.sub_zero, one_mul, one_mul]
    have hFp : F_term p = w ^ p * ι (normLM F hLK y) := by
      dsimp only [F_term, E]
      rw [hPp_eq, Finset.sum_singleton]
      have hP_univ : P y U_G = ι (normLM F hLK y) := (hact_norm y).symm
      rw [hP_univ, Nat.sub_self, pow_zero, mul_one]
    rw [hprod_powerset, hsum_fiber, hrange_split, hF0, hFp]
  
  have hnorm_E : ∀ (y : K) (c : L),
      ι (normLM F hLK (1 + ι c * y)) =
        1 + (∑ r ∈ Finset.Icc 1 (p - 1), (ι c) ^ r * E y r) +
          (ι c) ^ p * ι (normLM F hLK y) := by
    intro y c
    have h1 : ι (normLM F hLK (1 + ι c * y)) = ∏ σ ∈ U_G, (ι c * act σ y + 1) := by
      rw [hact_norm (1 + ι c * y)]
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [((hact_ring σ).2.2 1 (ι c * y)).1, (hact_ring σ).2.1,
        ((hact_ring σ).2.2 (ι c) y).2.1, hact_incl σ c, add_comm]
    rw [h1, hprod_linear y (ι c) 1, one_pow]
    congr 2
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [one_pow, mul_one]
  have hnorm_s : ∀ (y : K) (c : L),
      ι (normLM F hLK (1 + ι c * y)) =
        1 + (∑ r ∈ Finset.Icc 1 (p - 1), (ι c) ^ r * ι (s y r)) +
          (ι c) ^ p * ι (normLM F hLK y) := by
    intro y c
    change ι (normLM F hLK (1 + IntermediateField.inclusion hLK c * y)) = _
    rw [hs_poly y c]
    change ι (1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) + c ^ p * normLM F hLK y) = _
    rw [map_add, map_add, map_one, map_sum, map_mul, map_pow]
    congr 2
  have hdiff_sum_zero : ∀ (y : K) (c : L),
      (∑ r ∈ Finset.Icc 1 (p - 1), (ι c) ^ r * (ι (s y r) - E y r)) = 0 := by
    intro y c
    have h1 := hnorm_s y c
    rw [hnorm_E y c] at h1
    have h2 : (∑ r ∈ Finset.Icc 1 (p - 1), (ι c) ^ r * ι (s y r)) =
        ∑ r ∈ Finset.Icc 1 (p - 1), (ι c) ^ r * E y r := by
      linear_combination -h1
    rw [← sub_eq_zero, ← Finset.sum_sub_distrib] at h2
    rw [← h2]
    refine Finset.sum_congr rfl fun r _ => ?_
    ring
  have hpow_val : ∀ (w : K) (hw : w ≠ 0) (r : ℕ),
      w ^ r ≠ 0 ∧ valL F K (w ^ r) = (r : ℤ) * valL F K w := by
    intro w hw r
    induction r with
    | zero =>
      rw [pow_zero]
      refine ⟨one_ne_zero, ?_⟩
      rw [hvalK1, Nat.cast_zero, zero_mul]
    | succ r ih =>
      have hne : w ^ (r + 1) ≠ 0 := pow_ne_zero (r + 1) hw
      refine ⟨hne, ?_⟩
      rw [pow_succ', hvalK_mul w (w ^ r) hw ih.1, ih.2]
      push_cast
      ring
  have hsum_valK : ∀ (S : Finset ℕ) (f : ℕ → K) (B : ℤ),
      (∀ r ∈ S, f r = 0 ∨ B ≤ valL F K (f r)) →
      (∑ r ∈ S, f r) = 0 ∨ B ≤ valL F K (∑ r ∈ S, f r) := by
    intro S f B
    induction S using Finset.induction_on with
    | empty =>
      intro _
      exact Or.inl Finset.sum_empty
    | @insert a S' ha ih =>
      intro hS
      rw [Finset.sum_insert ha]
      have h1 : f a = 0 ∨ B ≤ valL F K (f a) := hS a (Finset.mem_insert_self a S')
      have h2 : (∑ r ∈ S', f r) = 0 ∨ B ≤ valL F K (∑ r ∈ S', f r) :=
        ih (fun r hr => hS r (Finset.mem_insert_of_mem hr))
      exact hvalK_add B (f a) (∑ r ∈ S', f r) h1 h2
  have hpoly_zero : ∀ (n : ℕ) (d : ℕ → K),
      (∀ c : L, (∑ r ∈ Finset.Icc 1 n, (ι c) ^ r * d r) = 0) →
      ∀ r ∈ Finset.Icc 1 n, d r = 0 := by
    intro n
    induction n with
    | zero =>
      intro d _ r hr
      simp at hr
    | succ n ih =>
      intro d hd
      have hd_top : d (n + 1) = 0 := by
        by_contra hne_top
        let M : ℤ :=
          (∑ r ∈ Finset.Icc 1 n, |valL F K (d r) - valL F K (d (n + 1))|) + 1
        have hM_sum_nonneg :
            0 ≤ ∑ r ∈ Finset.Icc 1 n, |valL F K (d r) - valL F K (d (n + 1))| :=
          Finset.sum_nonneg (fun r _ => abs_nonneg _)
        have hM_ge1 : 1 ≤ M := by
          dsimp only [M]
          linarith
        obtain ⟨u, hu_val⟩ := hvalL_surj (-M)
        let c : L := (u : L)
        have hc_ne0 : c ≠ 0 := Units.ne_zero u
        have hιc_ne0 : ι c ≠ 0 := (map_ne_zero_iff ι ι.injective).mpr hc_ne0
        have hval_ιc : valL F K (ι c) = - ((p : ℤ) * M) := by
          change valL F K (IntermediateField.inclusion hLK c) = - ((p : ℤ) * M)
          rw [hval_alg c, hu_val]
          ring
        let V_top : ℤ :=
          - (((n + 1 : ℕ) : ℤ) * ((p : ℤ) * M)) + valL F K (d (n + 1))
        have htop_ne0 : (ι c) ^ (n + 1) * d (n + 1) ≠ 0 :=
          mul_ne_zero (pow_ne_zero (n + 1) hιc_ne0) hne_top
        have htop_val : valL F K ((ι c) ^ (n + 1) * d (n + 1)) = V_top := by
          rw [hvalK_mul ((ι c) ^ (n + 1)) (d (n + 1))
            (pow_ne_zero (n + 1) hιc_ne0) hne_top,
            (hpow_val (ι c) hιc_ne0 (n + 1)).2, hval_ιc]
          dsimp only [V_top]
          ring
        have hlow_term : ∀ r ∈ Finset.Icc 1 n,
            (ι c) ^ r * d r = 0 ∨ V_top + 1 ≤ valL F K ((ι c) ^ r * d r) := by
          intro r hr
          by_cases hdr : d r = 0
          · left; rw [hdr, mul_zero]
          · right
            have hr_le : r ≤ n := (Finset.mem_Icc.mp hr).2
            have habs_le : |valL F K (d r) - valL F K (d (n + 1))| ≤ M - 1 := by
              have hsingle := Finset.single_le_sum
                (f := fun k => |valL F K (d k) - valL F K (d (n + 1))|)
                (fun k _ => abs_nonneg _) hr
              dsimp only [M]
              linarith
            have hdiff_le : valL F K (d (n + 1)) - valL F K (d r) ≤ M - 1 := by
              have hneg := neg_le_abs (valL F K (d r) - valL F K (d (n + 1)))
              linarith
            have hval_r :
                valL F K ((ι c) ^ r * d r) =
                  - ((r : ℤ) * ((p : ℤ) * M)) + valL F K (d r) := by
              rw [hvalK_mul ((ι c) ^ r) (d r) (pow_ne_zero r hιc_ne0) hdr,
                (hpow_val (ι c) hιc_ne0 r).2, hval_ιc]
              ring
            rw [hval_r]
            dsimp only [V_top]
            have hstep1 : (1 : ℤ) ≤ ((n + 1 : ℕ) : ℤ) - (r : ℤ) := by omega
            have hstep2 : (1 : ℤ) * M ≤ (p : ℤ) * M := by
              apply mul_le_mul_of_nonneg_right <;> omega
            have hstep3 :
                (p : ℤ) * M ≤
                  (((n + 1 : ℕ) : ℤ) - (r : ℤ)) * ((p : ℤ) * M) := by
              have hpm : 0 ≤ (p : ℤ) * M := by positivity
              nlinarith
            linarith
        have hlow_sum := hsum_valK (Finset.Icc 1 n) (fun r => (ι c) ^ r * d r)
          (V_top + 1) hlow_term
        have hsplit :
            (∑ r ∈ Finset.Icc 1 (n + 1), (ι c) ^ r * d r) =
              (∑ r ∈ Finset.Icc 1 n, (ι c) ^ r * d r) +
                (ι c) ^ (n + 1) * d (n + 1) :=
          Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => (ι c) ^ r * d r)
        have hsum0 :
            (∑ r ∈ Finset.Icc 1 n, (ι c) ^ r * d r) +
              (ι c) ^ (n + 1) * d (n + 1) = 0 := by
          rw [← hsplit]
          exact hd c
        have heq_neg :
            (ι c) ^ (n + 1) * d (n + 1) =
              - (∑ r ∈ Finset.Icc 1 n, (ι c) ^ r * d r) := by
          linear_combination hsum0
        rcases hlow_sum with hlow0 | hlow_ge
        · rw [hlow0, neg_zero] at heq_neg
          exact htop_ne0 heq_neg
        · dsimp only at hlow_ge
          have hval_eq :
              valL F K ((ι c) ^ (n + 1) * d (n + 1)) =
                valL F K (∑ r ∈ Finset.Icc 1 n, (ι c) ^ r * d r) := by
            rw [heq_neg, hvalK_neg]
          linarith [htop_val, hval_eq, hlow_ge]
      have hd_low : ∀ c : L, (∑ r ∈ Finset.Icc 1 n, (ι c) ^ r * d r) = 0 := by
        intro c
        have hsplit :=
          Finset.sum_Icc_succ_top (Nat.le_add_left 1 n) (fun r => (ι c) ^ r * d r)
        rw [hd c, hd_top, mul_zero, add_zero] at hsplit
        exact hsplit.symm
      intro r hr
      rcases Nat.eq_or_lt_of_le (Finset.mem_Icc.mp hr).2 with rfl | hlt
      · exact hd_top
      · exact ih d hd_low r
          (Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp hr).1, Nat.lt_succ_iff.mp hlt⟩)
  have hs_incl : ∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      ι (s y r) = E y r := by
    intro y r hr
    have h0 := hpoly_zero (p - 1) (fun k => ι (s y k) - E y k) (hdiff_sum_zero y) r hr
    exact sub_eq_zero.mp h0
  
  have hs_cayley : ∀ y : K,
      y ^ p =
        ι (normLM F hLK y) +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K) ^ (i - 1) * ι (s y i) * y ^ (p - i) := by
    intro y
    obtain ⟨k_p, hk_p⟩ := hp_odd_nat
    have hprod0 : (∏ σ ∈ U_G, (1 * act σ y + (-y))) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ (1 : G))
      rw [hact_one y, one_mul, add_neg_cancel]
    have hexp := hprod_linear y 1 (-y)
    rw [hprod0, Odd.neg_pow ⟨k_p, hk_p⟩ y, one_pow, one_mul] at hexp
    have hsum_eq :
        (∑ i ∈ Finset.Icc 1 (p - 1), (1 : K) ^ i * E y i * (-y) ^ (p - i)) =
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K) ^ (i - 1) * ι (s y i) * y ^ (p - i) := by
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_bounds := Finset.mem_Icc.mp hi
      have hsign_sum : (p - i) + (i - 1) = 2 * k_p := by omega
      have hsign_prod : (-1 : K) ^ (p - i) * (-1 : K) ^ (i - 1) = 1 := by
        rw [← pow_add, hsign_sum, pow_mul, neg_one_sq, one_pow]
      have hsign_sq : (-1 : K) ^ (i - 1) * (-1 : K) ^ (i - 1) = 1 := by
        rw [← pow_add, show (i - 1) + (i - 1) = 2 * (i - 1) by omega, pow_mul, neg_one_sq, one_pow]
      have hsign_eq : (-1 : K) ^ (p - i) = (-1 : K) ^ (i - 1) := by
        calc (-1 : K) ^ (p - i)
          _ = (-1 : K) ^ (p - i) * ((-1 : K) ^ (i - 1) * (-1 : K) ^ (i - 1)) := by
              rw [hsign_sq, mul_one]
          _ = ((-1 : K) ^ (p - i) * (-1 : K) ^ (i - 1)) * (-1 : K) ^ (i - 1) := by ring
          _ = (-1 : K) ^ (i - 1) := by rw [hsign_prod, one_mul]
      rw [one_pow, one_mul, ← hs_incl y i hi, neg_pow y (p - i), hsign_eq]
      ring
    rw [hsum_eq] at hexp
    linear_combination hexp
  exact ⟨hs_incl, hs_cayley⟩

theorem ld_wild_odd_two_step_newton_trace_identity (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (hact_norm : ∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y)
    (s : K → ℕ → L)
    (hs_incl : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      IntermediateField.inclusion hLK (s y r) =
        ∑ S ∈ ((Finset.univ : Finset G).powerset.filter (fun S => S.card = r)),
          ∏ σ ∈ S, act σ y) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ∀ y : K,
      traceLM F hLK (y ^ p) - (p : L) * normLM F hLK y =
        - (p : L) * (∑ r ∈ Finset.Icc 1 ((p - 1) / 2), s y r * s y (p - r)) +
          ∑ r ∈ Finset.Icc 1 (p - 1),
            ∑ j ∈ Finset.Icc 1 (p - r - 1),
              (-1 : L) ^ (r + j) * s y r * s y j * traceLM F hLK (y ^ (p - r - j)) :=
by
  intro p y
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  obtain ⟨m_half, hm_half⟩ := hp_odd_nat
  have hp_sub_even : 2 * ((p - 1) / 2) = p - 1 := by omega
  have hp_sub2_odd : 2 * ((p - 3) / 2) + 1 = p - 2 := by omega
  let ι := IntermediateField.inclusion hLK
  have hι_inj : Function.Injective ι := (IntermediateField.inclusion hLK).injective
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).1 }
  have hact_pow : ∀ (σ : G) (m : ℕ), act σ (y ^ m) = (act σ y) ^ m :=
    fun σ m => map_pow (φ σ) y m
  let U_G : Finset G := Finset.univ
  let P_card : ℕ → Finset (Finset G) := fun r => U_G.powerset.filter (fun S => S.card = r)
  let P : Finset G → K := fun S => ∏ σ ∈ S, act σ y
  let E : ℕ → K := fun j => ∑ S ∈ P_card j, P S
  let T_pow : ℕ → K := fun m => ∑ τ ∈ U_G, (act τ y) ^ m
  have hcard_univ : U_G.card = p := Finset.card_univ.trans hcard_G
  have hmem_P : ∀ (r : ℕ) (S : Finset G), S ∈ P_card r ↔ S.card = r := by
    intro r S
    simp [P_card, U_G]
  have hT_pow_eq : ∀ m : ℕ, T_pow m = ι (traceLM F hLK (y ^ m)) := by
    intro m
    dsimp only [T_pow, U_G, ι]
    rw [hact_trace (y ^ m)]
    refine Finset.sum_congr rfl fun τ _ => (hact_pow τ m).symm
  have hE_eq_s : ∀ {j : ℕ}, j ∈ Finset.Icc 1 (p - 1) → E j = ι (s y j) := by
    intro j hj
    exact (hs_incl y j hj).symm
  have hPp_eq : P_card p = {U_G} := by
    ext S
    simp only [hmem_P, Finset.mem_singleton]
    exact ⟨fun h => Finset.eq_univ_of_card S (h.trans hcard_G.symm), fun h => h ▸ hcard_univ⟩
  have hE_p : E p = ι (normLM F hLK y) := by
    dsimp only [E, P, ι]
    rw [hPp_eq, Finset.sum_singleton, ← hact_norm y]
  let A : ℕ → ℕ → K := fun j m =>
    ∑ τ ∈ U_G, ∑ S ∈ (P_card j).filter (fun S => τ ∈ S), P S * (act τ y) ^ m
  let B : ℕ → ℕ → K := fun j m =>
    ∑ τ ∈ U_G, ∑ S ∈ (P_card j).filter (fun S => τ ∉ S), P S * (act τ y) ^ m
  have hET_split : ∀ j m : ℕ, E j * T_pow m = A j m + B j m := by
    intro j m
    dsimp only [E, T_pow, A, B]
    rw [Finset.sum_mul_sum, Finset.sum_comm, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun τ _ => ?_
    exact (Finset.sum_filter_add_sum_filter_not (P_card j) (fun S => τ ∈ S)
      (fun S => P S * (act τ y) ^ m)).symm
  have hBA : ∀ j m : ℕ, B j (m + 1) = A (j + 1) m := by
    intro j m
    dsimp only [B, A]
    refine Finset.sum_congr rfl fun τ _ => ?_
    refine Finset.sum_bij (fun S _ => insert τ S) ?_ ?_ ?_ ?_
    · intro S hS
      rw [Finset.mem_filter, hmem_P] at hS
      rw [Finset.mem_filter, hmem_P]
      exact ⟨by rw [Finset.card_insert_of_notMem hS.2, hS.1], Finset.mem_insert_self τ S⟩
    · intro S₁ hS₁ S₂ hS₂ heq
      dsimp only at heq
      rw [Finset.mem_filter] at hS₁ hS₂
      have h := congrArg (fun T : Finset G => T.erase τ) heq
      dsimp only at h
      rwa [Finset.erase_insert hS₁.2, Finset.erase_insert hS₂.2] at h
    · intro T hT
      rw [Finset.mem_filter, hmem_P] at hT
      refine ⟨T.erase τ, ?_, Finset.insert_erase hT.2⟩
      rw [Finset.mem_filter, hmem_P]
      refine ⟨?_, Finset.notMem_erase τ T⟩
      rw [Finset.card_erase_of_mem hT.2, hT.1]
      rfl
    · intro S hS
      rw [Finset.mem_filter] at hS
      have hP_ins : P (insert τ S) = act τ y * P S := Finset.prod_insert hS.2
      rw [hP_ins, pow_succ]
      ring
  have hP1_filter : ∀ τ : G, (P_card 1).filter (fun S => τ ∈ S) = {{τ}} := by
    intro τ
    ext S
    simp only [Finset.mem_filter, hmem_P, Finset.mem_singleton]
    constructor
    · rintro ⟨hcard1, hτ⟩
      obtain ⟨a, rfl⟩ := Finset.card_eq_one.mp hcard1
      rw [Finset.mem_singleton.mp hτ]
    · rintro rfl
      exact ⟨Finset.card_singleton τ, Finset.mem_singleton_self τ⟩
  have hA_one : ∀ m : ℕ, A 1 m = T_pow (m + 1) := by
    intro m
    dsimp only [A, T_pow, P]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [hP1_filter τ, Finset.sum_singleton, Finset.prod_singleton, pow_succ']
  have hA_zero : ∀ k : ℕ, A k 0 = (k : K) * E k := by
    intro k
    dsimp only [A, E]
    have h1 : (∑ τ ∈ U_G, ∑ S ∈ (P_card k).filter (fun S => τ ∈ S), P S * (act τ y) ^ 0) =
        ∑ τ ∈ U_G, ∑ S ∈ P_card k, if τ ∈ S then P S else 0 := by
      refine Finset.sum_congr rfl fun τ _ => ?_
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun S _ => ?_
      rw [pow_zero, mul_one]
    rw [h1, Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun S hS => ?_
    rw [← Finset.sum_filter]
    have hU_S : U_G.filter (fun τ => τ ∈ S) = S := by
      ext τ
      simp [U_G]
    rw [hU_S, Finset.sum_const, nsmul_eq_mul, (hmem_P k S).mp hS]
  have h_telescope : ∀ (f : ℕ → K) (n : ℕ),
      (∑ j ∈ Finset.Icc 1 n, (f j - f (j + 1))) = f 1 - f (n + 1) := by
    intro f n
    induction n with
    | zero => simp
    | succ m ih =>
      rw [Finset.sum_Icc_succ_top (Nat.le_add_left 1 m), ih]
      ring
  have hNewton_K : ∀ {k : ℕ}, 1 ≤ k →
      (∑ j ∈ Finset.Icc 1 (k - 1), (-1 : K) ^ (j - 1) * E j * T_pow (k - j)) =
        T_pow k - (-1 : K) ^ (k - 1) * (k : K) * E k := by
    intro k hk
    let F_k : ℕ → K := fun j => (-1 : K) ^ (j - 1) * A j (k - j)
    have hterm : ∀ j ∈ Finset.Icc 1 (k - 1),
        (-1 : K) ^ (j - 1) * E j * T_pow (k - j) = F_k j - F_k (j + 1) := by
      intro j hj
      obtain ⟨hj1, hjk⟩ := Finset.mem_Icc.mp hj
      have hk_sub : k - j = (k - (j + 1)) + 1 := by omega
      have hj_pow : (-1 : K) ^ ((j + 1) - 1) = (-1 : K) ^ (j - 1) * (-1 : K) := by
        have hj_eq : (j + 1) - 1 = (j - 1) + 1 := by omega
        rw [hj_eq, pow_succ]
      dsimp only [F_k]
      rw [mul_assoc, hET_split j (k - j), hk_sub, hBA j (k - (j + 1)), ← hk_sub, hj_pow]
      ring
    rw [Finset.sum_congr rfl hterm, h_telescope F_k (k - 1)]
    dsimp only [F_k]
    have hk1 : (k - 1) + 1 = k := Nat.sub_add_cancel hk
    rw [hk1, Nat.sub_self 1, pow_zero, one_mul, hA_one (k - 1), hk1, Nat.sub_self k, hA_zero k, mul_assoc]
  have hneg1_pm1 : (-1 : L) ^ (p - 1) = 1 := by
    rw [← hp_sub_even, pow_mul, neg_one_sq, one_pow]
  have hneg1_pm2 : ∀ {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      (-1 : L) ^ (r - 1) * (-1 : L) ^ (p - r - 1) = -1 := by
    intro r hr
    rw [Finset.mem_Icc] at hr
    have hexp : (r - 1) + (p - r - 1) = 2 * ((p - 3) / 2) + 1 := by omega
    rw [← pow_add, hexp, pow_succ, pow_mul, neg_one_sq, one_pow, one_mul]
  have hneg1_rj : ∀ {r j : ℕ}, 1 ≤ r → 1 ≤ j →
      (-1 : L) ^ (r - 1) * (-1 : L) ^ (j - 1) = (-1 : L) ^ (r + j) := by
    intro r j hr hj
    have hexp : r + j = ((r - 1) + (j - 1)) + 2 := by omega
    rw [hexp, pow_add, pow_add, neg_one_sq, mul_one]
  have hNewton_p :
      traceLM F hLK (y ^ p) - (p : L) * normLM F hLK y =
        ∑ r ∈ Finset.Icc 1 (p - 1),
          (-1 : L) ^ (r - 1) * s y r * traceLM F hLK (y ^ (p - r)) := by
    apply hι_inj
    have hL : ι (traceLM F hLK (y ^ p) - (p : L) * normLM F hLK y) =
        T_pow p - (-1 : K) ^ (p - 1) * (p : K) * E p := by
      have hnegK : (-1 : K) ^ (p - 1) = 1 := by
        rw [← hp_sub_even, pow_mul, neg_one_sq, one_pow]
      rw [map_sub, map_mul, map_natCast, ← hT_pow_eq p, ← hE_p, hnegK, one_mul]
    have hR : ι (∑ r ∈ Finset.Icc 1 (p - 1),
        (-1 : L) ^ (r - 1) * s y r * traceLM F hLK (y ^ (p - r))) =
        ∑ r ∈ Finset.Icc 1 (p - 1), (-1 : K) ^ (r - 1) * E r * T_pow (p - r) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun r hr => ?_
      rw [map_mul, map_mul, map_pow, map_neg, map_one, ← hE_eq_s hr, ← hT_pow_eq (p - r)]
    rw [hL, hR, hNewton_K (by omega : 1 ≤ p)]
  have hNewton_sub : ∀ {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      traceLM F hLK (y ^ (p - r)) =
        (-1 : L) ^ (p - r - 1) * ((p - r : ℕ) : L) * s y (p - r) +
          ∑ j ∈ Finset.Icc 1 (p - r - 1),
            (-1 : L) ^ (j - 1) * s y j * traceLM F hLK (y ^ (p - r - j)) := by
    intro r hr
    rw [Finset.mem_Icc] at hr
    have hpr_mem : p - r ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]
      omega
    apply hι_inj
    have hR : ι ((-1 : L) ^ (p - r - 1) * ((p - r : ℕ) : L) * s y (p - r) +
        ∑ j ∈ Finset.Icc 1 (p - r - 1),
          (-1 : L) ^ (j - 1) * s y j * traceLM F hLK (y ^ (p - r - j))) =
        (-1 : K) ^ (p - r - 1) * ((p - r : ℕ) : K) * E (p - r) +
          ∑ j ∈ Finset.Icc 1 (p - r - 1),
            (-1 : K) ^ (j - 1) * E j * T_pow (p - r - j) := by
      rw [map_add, map_mul, map_mul, map_pow, map_neg, map_one, map_natCast,
        ← hE_eq_s hpr_mem, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun j hj => ?_
      rw [Finset.mem_Icc] at hj
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := by
        rw [Finset.mem_Icc]
        omega
      rw [map_mul, map_mul, map_pow, map_neg, map_one, ← hE_eq_s hj_mem, ← hT_pow_eq (p - r - j)]
    rw [← hT_pow_eq (p - r), hR, hNewton_K (by omega : 1 ≤ p - r)]
    ring
  have hSub_step :
      traceLM F hLK (y ^ p) - (p : L) * normLM F hLK y =
        - (∑ r ∈ Finset.Icc 1 (p - 1), ((p - r : ℕ) : L) * s y r * s y (p - r)) +
          ∑ r ∈ Finset.Icc 1 (p - 1),
            ∑ j ∈ Finset.Icc 1 (p - r - 1),
              (-1 : L) ^ (r + j) * s y r * s y j * traceLM F hLK (y ^ (p - r - j)) := by
    rw [hNewton_p, ← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun r hr => ?_
    rw [hNewton_sub hr, mul_add, Finset.mul_sum]
    congr 1
    · have hsign := hneg1_pm2 hr
      calc
        (-1 : L) ^ (r - 1) * s y r *
            ((-1 : L) ^ (p - r - 1) * ((p - r : ℕ) : L) * s y (p - r)) =
          ((-1 : L) ^ (r - 1) * (-1 : L) ^ (p - r - 1)) *
            (((p - r : ℕ) : L) * s y r * s y (p - r)) := by ring
        _ = (-1) * (((p - r : ℕ) : L) * s y r * s y (p - r)) := by rw [hsign]
        _ = -(((p - r : ℕ) : L) * s y r * s y (p - r)) := by ring
    · refine Finset.sum_congr rfl fun j hj => ?_
      rw [Finset.mem_Icc] at hr hj
      have hsign := hneg1_rj hr.1 hj.1
      calc
        (-1 : L) ^ (r - 1) * s y r *
            ((-1 : L) ^ (j - 1) * s y j * traceLM F hLK (y ^ (p - r - j))) =
          ((-1 : L) ^ (r - 1) * (-1 : L) ^ (j - 1)) *
            (s y r * s y j * traceLM F hLK (y ^ (p - r - j))) := by ring
        _ = (-1 : L) ^ (r + j) * s y r * s y j * traceLM F hLK (y ^ (p - r - j)) := by
          rw [hsign]
          ring
  let I₁ := Finset.Icc 1 ((p - 1) / 2)
  let I₂ := Finset.Icc ((p - 1) / 2 + 1) (p - 1)
  have hI_disj : Disjoint I₁ I₂ := by
    rw [Finset.disjoint_left]
    intro r hr₁ hr₂
    simp only [I₁, I₂, Finset.mem_Icc] at hr₁ hr₂
    omega
  have hI_union : I₁ ∪ I₂ = Finset.Icc 1 (p - 1) := by
    ext r
    simp only [I₁, I₂, Finset.mem_union, Finset.mem_Icc]
    omega
  have hI₂_bij :
      (∑ r ∈ I₂, ((p - r : ℕ) : L) * s y r * s y (p - r)) =
        ∑ r ∈ I₁, (r : L) * s y (p - r) * s y r := by
    refine Finset.sum_bij (fun r _ => p - r) ?_ ?_ ?_ ?_
    · intro r hr
      simp only [I₁, I₂, Finset.mem_Icc] at hr ⊢
      omega
    · intro r₁ hr₁ r₂ hr₂ heq
      dsimp only at heq
      simp only [I₂, Finset.mem_Icc] at hr₁ hr₂
      omega
    · intro r' hr'
      simp only [I₁, I₂, Finset.mem_Icc] at hr' ⊢
      refine ⟨p - r', ⟨by omega, by omega⟩, by omega⟩
    · intro r hr
      simp only [I₂, Finset.mem_Icc] at hr
      have hsub : p - (p - r) = r := by omega
      rw [hsub]
  have h_pair_sum :
      (∑ r ∈ Finset.Icc 1 (p - 1), ((p - r : ℕ) : L) * s y r * s y (p - r)) =
        (p : L) * (∑ r ∈ I₁, s y r * s y (p - r)) := by
    rw [← hI_union, Finset.sum_union hI_disj, hI₂_bij, ← Finset.sum_add_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun r hr => ?_
    simp only [I₁, Finset.mem_Icc] at hr
    have hcast : ((p - r : ℕ) : L) = (p : L) - (r : L) := Nat.cast_sub (by omega)
    rw [hcast]
    ring
  rw [hSub_step, h_pair_sum, neg_mul]

theorem ld_wild_odd_cayley_hamilton_and_two_step_newton (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let T := condExp F L ν₁
    ((p : L) = 0 ∨ ((T - T / 2 : ℕ) : ℤ) ≤ valL F L (p : L)) ∧
    (∀ (m : ℤ) (y : K),
      (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) ∧
    (∀ (h : ℕ) (z : K),
      (z = 0 ∨ (((T + p * h) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      let u := normLM F hLK (1 + z) - 1
      let q_z := (2 : K)⁻¹ * (2 * z - z ^ 2)
      (2 * u - u ^ 2) - (traceLM F hLK (2 * z - z ^ 2) + 2 * normLM F hLK q_z) = 0 ∨
        ((T + h : ℕ) : ℤ) ≤
          valL F L ((2 * u - u ^ 2) - (traceLM F hLK (2 * z - z ^ 2) + 2 * normLM F hLK q_z))) ∧
    ∃ s : K → ℕ → L,
      (∀ y : K, s y 1 = traceLM F hLK y) ∧
      (∀ y : K, 2 * s y 2 = (traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2)) ∧
      (∀ y : K, y ≠ 0 → s y (p - 1) = normLM F hLK y * traceLM F hLK (y⁻¹)) ∧
      (∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
        ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
          (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * q →
          (s y r = 0 ∨ m ≤ valL F L (s y r))) ∧
      (∀ (y : K) (c : L),
        normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
          1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) +
            c ^ p * normLM F hLK y) ∧
      (∀ y : K,
        y ^ p =
          IntermediateField.inclusion hLK (normLM F hLK y) +
            ∑ i ∈ Finset.Icc 1 (p - 1),
              (-1 : K) ^ (i - 1) * IntermediateField.inclusion hLK (s y i) * y ^ (p - i)) ∧
      (∀ y : K,
        traceLM F hLK (y ^ p) - (p : L) * normLM F hLK y =
          - (p : L) * (∑ r ∈ Finset.Icc 1 ((p - 1) / 2), s y r * s y (p - r)) +
            ∑ r ∈ Finset.Icc 1 (p - 1),
              ∑ j ∈ Finset.Icc 1 (p - r - 1),
                (-1 : L) ^ (r + j) * s y r * s y j * traceLM F hLK (y ^ (p - r - j))) :=
by
  intro p T
  have hp_odd' : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2 :=
    hWild.symm ▸ hp_odd
  have hRam : condExp F L ν₁ ≠ 0 := by omega
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalK_props := ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L
      hvalL_props.1 hvalL_props.2.1 hvalL_props.2.2.1 hvalL_props.2.2.2.1
      hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1 S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  obtain ⟨_, _, _, hval_norm, hval_alg, hfrob_surj, _, _,
    ϖ_K, ϖ_L, hϖ_norm, hϖ_K, hϖ_L, hBasis⟩ :=
    ld_wild_total_ramification_and_power_basis F L K hLK hPrime ν₁
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hRam hWild
      haddVal1 haddVal_mul halg1 hvalL_props hvalK_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨G, hGroupG, hFinG, act, _, _, hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, _, hact_val, hact_trace, hact_norm, _, _, _, _, _⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L K hLK hGal hPrime hWild
      haddVal1 halg1 hvalL_props hvalK_props hval_norm hval_alg ϖ_K hϖ_K hBasis
  letI : Group G := hGroupG
  letI : Fintype G := hFinG
  obtain ⟨t, w_star, ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm,
    htr_bound_t, htr_surj, hnorm_exp⟩ :=
    ld_wild_galois_jump_and_euler_trace_formula F L K hLK hGal hPrime hWild
      haddVal1 halg1 hvalL_props hvalK_props hval_norm hval_alg ϖ_K hϖ_K hBasis
  obtain ⟨hb_eq, _, _, _, _, _⟩ :=
    ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L K hLK hPrime ν₁
      hν₁_ker hν₁_cond hvalL_props hvalK_props hval_norm hval_alg hfrob_surj
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L hBasis
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t w_star ht_ge1 hw_star_t hw_star_nt1 hw_star_norm htr_bound_t htr_surj hnorm_exp
  have hT_eq : (T : ℤ) = (t + 1 : ℤ) := by
    change (condExp F L ν₁ : ℤ) = (t + 1 : ℤ)
    exact_mod_cast hb_eq
  have htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)) := by
    intro m y hy
    rw [hT_eq] at hy
    exact htr_bound_t m y hy
  have htr_one : traceLM F hLK (1 : K) = (p : L) := by
    have hinj : Function.Injective (IntermediateField.inclusion hLK) :=
      (IntermediateField.inclusion hLK).injective
    apply hinj
    rw [hact_trace 1]
    have h1 : (∑ σ : G, act σ (1 : K)) = ∑ _σ : G, (1 : K) :=
      Finset.sum_congr rfl fun σ _ => (hact_ring σ).2.1
    rw [h1, Finset.sum_const, Finset.card_univ, hcard_G, nsmul_one, map_natCast]
  have hp_ge3 : 3 ≤ p := by
    have := hPrime.two_le
    omega
  have hp_val : (p : L) = 0 ∨ ((T - T / 2 : ℕ) : ℤ) ≤ valL F L (p : L) := by
    rw [← htr_one]
    apply htr_bound ((T - T / 2 : ℕ) : ℤ) 1
    right
    rw [hvalK_props.2.1]
    have h_le : (p : ℤ) * ((T - T / 2 : ℕ) : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by
      have hT2 : 1 ≤ T / 2 := by omega
      have h_sub : ((T - T / 2 : ℕ) : ℤ) = (T : ℤ) - ((T / 2 : ℕ) : ℤ) := by omega
      have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
      rw [h_sub, hp_sub]
      have h3 : (T : ℤ) ≤ 3 * ((T / 2 : ℕ) : ℤ) := by omega
      have hp3 : 3 * ((T / 2 : ℕ) : ℤ) ≤ (p : ℤ) * ((T / 2 : ℕ) : ℤ) := by
        apply mul_le_mul_of_nonneg_right <;> omega
      linarith
    linarith
  obtain ⟨s, hs1, hs2, hsp1, hs_val_t, hs_poly⟩ :=
    ld_wild_odd_free_orbit_symm_functions F L K hLK hPrime hp_odd' hvalK_props
      t htr_bound_t G act hcard_G hact_one hact_mul hact_ring hact_incl hact_val
      hact_trace hact_norm
  have hs_val : ∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)) := by
    intro y r hr q m hy hqm
    rw [hT_eq] at hqm
    exact hs_val_t y r hr q m hy hqm
  have hq_norm_tr :=
    ld_wild_odd_quad_norm_trace_norm_congruence F L K hLK hPrime hp_odd'
      T hb_ge2 hp_val hvalL_props hval_norm s hs1 hs2 hs_val hs_poly
  obtain ⟨hs_incl, hs_cayley⟩ :=
    ld_wild_odd_symm_subset_sum_and_cayley_hamilton F L K hLK hPrime hp_odd'
      hvalL_props hvalK_props hval_alg G act hcard_G hact_one hact_ring
      hact_incl hact_norm s hs_poly
  have hs_newton2 :=
    ld_wild_odd_two_step_newton_trace_identity F L K hLK hPrime hp_odd'
      G act hcard_G hact_ring hact_trace hact_norm s hs_incl
  exact ⟨hp_val, htr_bound, hq_norm_tr, s, hs1, hs2, hsp1, hs_val, hs_poly, hs_cayley, hs_newton2⟩

theorem ld_stable_range_unramified_frob_descent_to_base (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (p : ℕ) (hPrime : Nat.Prime p) (hp_eq : p = EllipticRootNumber.p F) (hp_odd : EllipticRootNumber.p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (θM₁' ξM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hξM₁'_cond_eq : condExp F M₁' ξM₁' = T)
    (hξM₁'_triv : ∀ u ∈ unitGroup F M₁' (condExp F M₁' ξM₁'), ξM₁' u = 1)
    (hStable : 2 * T ≤ condExp F M₁' θM₁')
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (y₁ : M₁') (hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁') (j₀ : ℕ)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range p, (σ₀ ^ k) z)
    (hFrobTwist : ∀ (r : ℕ) (z : M₁'ˣ),
      θM₁' (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z) = (ξM₁' z) ^ (r * j₀) * θM₁' z)
    (c_U : M₁'ˣ)
    (hc_U_val : valL F M₁' (c_U : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc_U_stat : ∀ z : M₁',
      (z = 0 ∨ ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          (traceChar F hLM₁' ψ) (((c_U⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2))) :
    let mM₁' := condExp F M₁' θM₁'
    let ψM₁' := traceChar F hLM₁' ψ
    (∀ a : L, traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a) = (p : L) * a) ∧
    ∃ c_L : Lˣ,
      let cM₁' := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_L
      valL F L (c_L : L) = (mM₁' : ℤ) + condExpChar F L ψ ∧
      valL F M₁' (cM₁' : M₁') = (mM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁', (z = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2))) :=
by
  have htr_smul : ∀ (a : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a * z) = a * traceLM F hLM₁' z := by
    clear * -
    letI : Module L L := Semiring.toModule
    letI : SMul L L := Mul.toSMul L
    intro a z
    exact (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' a
      (toExtendScalars F hLM₁' z)
  
  have halg : ∀ z : M₁',
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F M₁' = (minpoly F z).natDegree * m := by
    clear * -
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq M₁'.val M₁'.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  have hrel0 : relVal F M₁' 0 = 0 := by
    unfold relVal
    rw [Algebra.norm_zero, haddVal0]
  have hrel1 : relVal F M₁' 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x y : M₁', x ≠ 0 → y ≠ 0 → relVal F M₁' (x * y) = relVal F M₁' x + relVal F M₁' y := by
    intro x y hx hy
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ hnx hny]
  have hrel_neg1 : relVal F M₁' (-1) = 0 := by
    have hne : (-1 : M₁') ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hsq : relVal F M₁' ((-1 : M₁') * (-1 : M₁')) = relVal F M₁' (-1) + relVal F M₁' (-1) :=
      hrel_mul (-1) (-1) hne hne
    have h1 : (-1 : M₁') * (-1 : M₁') = 1 := by ring
    rw [h1, hrel1] at hsq
    omega
  have hrel_neg : ∀ x : M₁', relVal F M₁' (-x) = relVal F M₁' x := by
    intro x
    by_cases hx : x = 0
    · simp [hx]
    · have hne1 : (-1 : M₁') ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hneg_eq : (-x : M₁') = (-1 : M₁') * x := by ring
      rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
  have hrel_inv : ∀ u : M₁'ˣ, relVal F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - relVal F M₁' (u : M₁') := by
    intro u
    have hmul : relVal F M₁' ((u : M₁') * ((u⁻¹ : M₁'ˣ) : M₁')) =
        relVal F M₁' (u : M₁') + relVal F M₁' ((u⁻¹ : M₁'ˣ) : M₁') :=
      hrel_mul (u : M₁') ((u⁻¹ : M₁'ˣ) : M₁') (Units.ne_zero u) (Units.ne_zero u⁻¹)
    rw [Units.mul_inv, hrel1] at hmul
    omega
  have hrel_pow : ∀ (u : M₁'ˣ) (n : ℕ),
      relVal F M₁' (((u ^ n : M₁'ˣ) : M₁')) = (n : ℤ) * relVal F M₁' (u : M₁') := by
    intro u n
    induction n with
    | zero => simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hrel_zpow : ∀ (u : M₁'ˣ) (m : ℤ),
      relVal F M₁' (((u ^ m : M₁'ˣ) : M₁')) = m * relVal F M₁' (u : M₁') := by
    intro u m
    cases m with
    | ofNat n =>
      change relVal F M₁' (((u ^ (n : ℤ) : M₁'ˣ) : M₁')) = (n : ℤ) * relVal F M₁' (u : M₁')
      rw [zpow_natCast, hrel_pow]
    | negSucc n =>
      rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
      push_cast
      ring
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : M₁' := algebraMap F M₁' π
  have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F M₁' x₀ = (Module.finrank F M₁' : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M₁') hπ_ne, hadd_π, mul_one]
  have hfin_pos : 0 < Module.finrank F M₁' := Module.finrank_pos
  let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M₁', x ≠ 0 ∧ relVal F M₁' x = k}
  have hS_nonempty : S.Nonempty := ⟨Module.finrank F M₁', hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfL_mem : resDeg F M₁' ∈ S := Nat.sInf_mem hS_nonempty
  obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
  let ϖM : M₁'ˣ := Units.mk0 ϖ₀ hϖ₀_ne
  have hrel_ϖM : relVal F M₁' (ϖM : M₁') = (resDeg F M₁' : ℤ) := hrel_ϖ₀
  have hfL_int_pos : (0 : ℤ) < (resDeg F M₁' : ℤ) := Nat.cast_pos.mpr hfL_pos
  have hfL_int_ne : (resDeg F M₁' : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
  have hdiv : ∀ x : M₁', relVal F M₁' x = (resDeg F M₁' : ℤ) * valL F M₁' x := by
    intro x
    by_cases hx : x = 0
    · unfold valL
      rw [hx, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M₁' : ℤ)
      set q : ℤ := valL F M₁' x
      set r : ℤ := relVal F M₁' x % f
      have hediv : f * q + r = relVal F M₁' x := Int.mul_ediv_add_emod (relVal F M₁' x) f
      have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M₁' x) hfL_int_ne
      have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M₁' x) hfL_int_pos
      have hr_zero : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
        let y : M₁' := x * (((ϖM ^ (-q) : M₁'ˣ) : M₁'))
        have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
        have hrel_y : relVal F M₁' y = r := by
          dsimp [y]
          rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q), hrel_ϖM]
          linarith
        let k : ℕ := r.toNat
        have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M₁' ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  have hvalM0 : valL F M₁' 0 = 0 := by
    have h := hdiv 0
    rw [hrel0] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hvalM1 : valL F M₁' 1 = 0 := by
    have h := hdiv 1
    rw [hrel1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hvalM_neg1 : valL F M₁' (-1) = 0 := by
    have h := hdiv (-1)
    rw [hrel_neg1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hvalM_neg : ∀ x : M₁', valL F M₁' (-x) = valL F M₁' x := by
    intro x
    apply mul_left_cancel₀ hfL_int_ne
    rw [← hdiv (-x), ← hdiv x, hrel_neg]
  have hvalM_mul : ∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y := by
    intro x y hx hy
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
  have hvalM_inv : ∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁') := by
    intro u
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
  have hvalM_add : ∀ (k : ℤ) (x y : M₁'),
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x + y = 0 ∨ k ≤ valL F M₁' (x + y)) := by
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
      Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
    have hspec_pow : ∀ z : M₁',
        (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M₁') =
          ‖Algebra.norm F z‖ := by
      intro z
      obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
      have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
          ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
        rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
      have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
        rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
        exact_mod_cast minpoly.natDegree_pos hz
      rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
         ← Real.rpow_natCast]
      congr 1
      push_cast
      rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
    have hspec_le : ∀ w z : M₁', w ≠ 0 →
        spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
          spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
        z ≠ 0 ∧ valL F M₁' z ≤ valL F M₁' w := by
      intro w z hw hle
      have hpow_le :
          (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F M₁') ≤
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M₁') :=
        pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
      rw [hspec_pow w, hspec_pow z] at hpow_le
      have hv_eq : ∀ a : F, ‖a‖ =
          ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
            (valuation F a) : ℝ) := fun a => rfl
