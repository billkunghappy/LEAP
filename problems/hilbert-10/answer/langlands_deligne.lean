              (ϖ_M1 : M_1) - (⟨(σ : AbsGal F) (ϖ_M1 : AlgebraicClosure F), hσw⟩ : M_1) ≠ 0 ∧
              valL F M_1 ((ϖ_M1 : M_1) - (⟨(σ : AbsGal F) (ϖ_M1 : AlgebraicClosure F), hσw⟩ : M_1)) =
