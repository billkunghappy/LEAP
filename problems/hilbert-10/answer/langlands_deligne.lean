      have hfactor :
          Δ_val + ξ_fn m = iM₁'K₁ (ξ_base m) * (1 + iM₁'K₁ ((ξ_base m)⁻¹) * Δ_val) := by
        have h1 : iM₁'K₁ (ξ_base m) * iM₁'K₁ ((ξ_base m)⁻¹) = 1 := by
          rw [← map_mul, hmul_inv, map_one]
        dsimp only [ξ_fn]
        linear_combination - Δ_val * h1
      have hB_expand :
