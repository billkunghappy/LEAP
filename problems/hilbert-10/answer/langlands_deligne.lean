      rw [hadd_eq, hval1_K₁] at h1_ge1
      rcases h1_ge1 with h10 | h1_le
      · exact one_ne_zero h10
      · omega
  have hy_ne : 1 + y ≠ 0 := hy_1_ne_and_val0.1
  have hy_1_val0 : valL F K₁ (1 + y) = 0 := hy_1_ne_and_val0.2
  have h1_add_uM : 1 + u_M = normLM F hM₁'K₁ (1 + y) := by
    change 1 + (normLM F hM₁'K₁ (1 + y) - 1) = normLM F hM₁'K₁ (1 + y)
    ring
  have hu_M_ne : 1 + u_M ≠ 0 := by
    rw [h1_add_uM]
