  have hvalE'_mul_bound : ∀ (k₁ k₂ : ℤ) (a₁ a₂ : E'),
      (a₁ = 0 ∨ k₁ ≤ valL F E' a₁) → (a₂ = 0 ∨ k₂ ≤ valL F E' a₂) →
        (a₁ * a₂ = 0 ∨ k₁ + k₂ ≤ valL F E' (a₁ * a₂)) := by
    intro k₁ k₂ a₁ a₂ ha₁ ha₂
