  rcases hvalL_props with ⟨_, _, _, _, _, hvalL_inv, _, _, _, _, _⟩
  rcases hvalM₁'_props with ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv,
    _, hvalM₁'_add, _, _, _⟩
  have hvalM₁'_sub : ∀ (m : ℤ) (x y : M₁'),
