  let M₁'' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM₁'
  haveI : FiniteDimensional F M₁'' := ‹FiniteDimensional F M₁'›
  haveI : IsScalarTower F L M₁'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L M₁'' := Module.Finite.of_restrictScalars_finite F L M₁''
  let fromExtendScalars_M₁' : M₁'' →+* M₁' :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLM₁').mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
