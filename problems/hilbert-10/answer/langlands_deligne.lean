      hP_mono 0 (hP_mul (Or.inr (le_of_eq hV_inv_val.symm)) (Or.inr (le_of_eq hQ_inv_val.symm))) (by omega)
    have hrem_comm : (β₂ * u_Q) - (B_comm * V⁻¹) = 0 ∨
        (2 * (e : ℤ) + 1) ≤ valL F L ((β₂ * u_Q) - (B_comm * V⁻¹)) := by
      have hid : (β₂ * u_Q) - (B_comm * V⁻¹) =
          -(B_comm * Q - β₂ * (V - Q) * V) * (V⁻¹ * Q⁻¹) := by
        dsimp [u_Q]
        calc β₂ * ((V - Q) * Q⁻¹) - B_comm * V⁻¹
          _ = β₂ * ((V - Q) * (V * V⁻¹) * Q⁻¹) - B_comm * (Q * Q⁻¹) * V⁻¹ := by
              rw [mul_inv_cancel₀ hV_ne, mul_inv_cancel₀ hQ_ne]; ring
          _ = -(B_comm * Q - β₂ * (V - Q) * V) * (V⁻¹ * Q⁻¹) := by ring
      rw [hid]
      exact hP_mono (2 * (e : ℤ) + 1) (hP_mul (hP_neg hRem) hVQ_inv) (by omega)
    have heq := hψ_eq_2e1 (β₂ * u_Q) (B_comm * V⁻¹) hrem_comm
    rwa [← mul_assoc, show ((α⁻¹ : Lˣ) : L) * (B_comm * V⁻¹) =
      (((α⁻¹ : Lˣ) : L) * B_comm) * V⁻¹ by ring] at heq
  exact ⟨α, hβ₁, hβ₂, hα_val, hcν₂_val, hcν₂_stat_goal, hNormPhaseE', hcν₁_val, hcν₁_stat, hNormPhaseM₁', hCommM₁'⟩

theorem ld_ch12_wild_dyadic_odd_max_break_min_cond_frob_shift_and_quad_norm (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
