        le_trans (le_max_right t (k * (a - 1))) (le_max_right (c_i - 1) m₀)
      have hψ_Δ : ∀ x : F_i, (M : ℤ) ≤ valL F F_i x → ψ_Fi (Δ_i * x) = 1 := by
        intro x hx_M
        have hx_ge1 : 1 ≤ valL F F_i x := by omega
        have hx : 1 + x ≠ 0 := by
          intro h0
          have hx_neg1 : x = -1 := eq_neg_of_add_eq_zero_right h0
          rw [hx_neg1, hval_neg1_Fi] at hx_ge1
          omega
        have hx_θ : x = 0 ∨ ((c_i - 1 : ℕ) : ℤ) ≤ valL F F_i x := Or.inr (by omega)
        have hx_μ : x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x := by
          rw [(hFi_ram i).1]
          exact Or.inr (by omega)
        have hx_χ : x = 0 ∨ ((k * (a - 1) : ℕ) : ℤ) ≤ valL F F_i x := Or.inr (by omega)
        have h1 := (hc_orb i).2.2.2.2.2 x hx_θ hx
        have h2 := (hc_orb i).2.2.2.1 x hx_μ hx
        have h3 := hχ'Fi_top i x hx_χ hx
        have hθ_mul : (θ_i (Units.mk0 (1 + x) hx) : Ω F) =
            (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) *
              ((χ'.comp (Units.map (normLM F (D_orb.get i).le))) (Units.mk0 (1 + x) hx) : Ω F) := rfl
        rw [hθ_mul, h2, h3] at h1
        have hS_x : ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x) *
            ψ_Fi ((((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i) * x) = ψ_Fi (S_i * x) := by
          rw [← AddChar.map_add_eq_mul, ← add_mul]
        rw [hS_x] at h1
        have hθ_x : (((c'_θ i)⁻¹ : F_iˣ) : F_i) * x = Δ_i * x + S_i * x := by
          dsimp [Δ_i]
          ring
        rw [hθ_x, AddChar.map_add_eq_mul] at h1
        have hψ_ne0 : ψ_Fi (S_i * x) ≠ 0 := by
          intro h0
          have hmul1 : ψ_Fi (S_i * x) * ψ_Fi (-(S_i * x)) = 1 := by
            rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
          rw [h0, zero_mul] at hmul1
