        have hconj : c * n⁻¹ * c⁻¹ ∈ N := hN_norm.conj_mem n⁻¹ (N.inv_mem hn) c
        have heq : n * c * n⁻¹ * c⁻¹ = n * (c * n⁻¹ * c⁻¹) := by group
        rw [heq]
        exact N.mul_mem hn hconj
      have h_in_C : n * c * n⁻¹ * c⁻¹ ∈ C :=
        C.mul_mem (hC_norm.conj_mem c hc n) (C.inv_mem hc)
      have h_one : n * c * n⁻¹ * c⁻¹ = 1 := h_disj_NC _ h_in_N h_in_C
