      map_zero' := (hactM₁'_ring γ).1
      map_add' := fun z₁ z₂ => ((hactM₁'_ring γ).2.2 z₁ z₂).1 }
  let φ_G_M₁' : G_M₁' → (M₁'' →ₐ[L] M₁'') := fun γ =>
    { (toExtendScalars F hLM₁').comp ((φ_act_M₁' γ).comp fromExtendScalars_M₁') with
      commutes' := fun x => by
        change toExtendScalars F hLM₁' (act_M₁' γ (IntermediateField.inclusion hLM₁' x)) =
          algebraMap L M₁'' x
        rw [hactM₁'_incl γ x]
        rfl }
  have hφG_inj_M₁' : Function.Injective φ_G_M₁' := by
    intro γ₁ γ₂ h_eq
    have h1 : γ₁ * γ₂⁻¹ = 1 := by
      apply hactM₁'_faithful (γ₁ * γ₂⁻¹)
      intro z
      have h_app : φ_G_M₁' γ₁ (toExtendScalars F hLM₁' (act_M₁' γ₂⁻¹ z)) =
          φ_G_M₁' γ₂ (toExtendScalars F hLM₁' (act_M₁' γ₂⁻¹ z)) :=
        congrArg (fun f : M₁'' →ₐ[L] M₁'' => f (toExtendScalars F hLM₁' (act_M₁' γ₂⁻¹ z))) h_eq
      have h_from : act_M₁' γ₁ (act_M₁' γ₂⁻¹ z) = act_M₁' γ₂ (act_M₁' γ₂⁻¹ z) :=
        congrArg fromExtendScalars_M₁' h_app
      rw [← hactM₁'_mul, ← hactM₁'_mul, mul_inv_cancel, hactM₁'_one] at h_from
      exact h_from
    exact mul_inv_eq_one.mp h1
  have hcard_le1_M₁' : Fintype.card G_M₁' ≤ Fintype.card (M₁'' →ₐ[L] M₁'') :=
    Fintype.card_le_of_injective φ_G_M₁' hφG_inj_M₁'
  have hcard_le2_M₁' : Fintype.card (M₁'' →ₐ[L] M₁'') ≤ Module.finrank L M₁'' :=
    @AlgHom.card_le L M₁'' _ _ _ _
  have hcard_eq_M₁' : Fintype.card G_M₁' = Fintype.card (M₁'' →ₐ[L] M₁'') :=
    le_antisymm hcard_le1_M₁' (hcard_le2_M₁'.trans (le_of_eq hcard_GM₁'_raw.symm))
  have hφG_bij_M₁' : Function.Bijective φ_G_M₁' :=
    (Fintype.bijective_iff_injective_and_card φ_G_M₁').mpr ⟨hφG_inj_M₁', hcard_eq_M₁'⟩
  let f_τ : M₁'' →ₐ[L] M₁'' :=
    { (toExtendScalars F hLM₁').comp (τ.toRingEquiv.toRingHom.comp fromExtendScalars_M₁') with
       commutes' := fun x => by
         change toExtendScalars F hLM₁' (τ (IntermediateField.inclusion hLM₁' x)) =
           algebraMap L M₁'' x
         rw [hτ_L x]
         rfl }
  obtain ⟨γ_τ, hγ_τ_eq⟩ := hφG_bij_M₁'.2 f_τ
  have hτ_act : ∀ z : M₁', τ z = act_M₁' γ_τ z := by
    intro z
    have h1 : φ_G_M₁' γ_τ (toExtendScalars F hLM₁' z) = f_τ (toExtendScalars F hLM₁' z) :=
      congrArg (fun f : M₁'' →ₐ[L] M₁'' => f (toExtendScalars F hLM₁' z)) hγ_τ_eq
    exact (congrArg fromExtendScalars_M₁' h1).symm
  have hγ_ne1 : γ_τ ≠ 1 := by
    intro h1
    apply hτ_z₀
    rw [hτ_act z₀, h1, hactM₁'_one]

  rcases hvalM₁'_props with ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁',
    hval_inv_M₁', hval_surj_M₁', hval_add_M₁', hunit0_M₁', hunit_ge1_M₁', hunit_val0_M₁'⟩
  have hval_pow_M₁' : ∀ (z : M₁') (n : ℕ), z ≠ 0 → valL F M₁' (z ^ n) = (n : ℤ) * valL F M₁' z := by
    intro z n hz
    induction n with
    | zero => simp [hval1_M₁']
    | succ n ih =>
      rw [pow_succ, hval_mul_M₁' (z ^ n) z (pow_ne_zero n hz) hz, ih]
      push_cast
      ring
  have hval_mul_ge_M₁' : ∀ (k₁ k₂ : ℤ) (z₁ z₂ : M₁'),
      (z₁ = 0 ∨ k₁ ≤ valL F M₁' z₁) → (z₂ = 0 ∨ k₂ ≤ valL F M₁' z₂) →
        (z₁ * z₂ = 0 ∨ k₁ + k₂ ≤ valL F M₁' (z₁ * z₂)) := by
    intro k₁ k₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · exact Or.inl (by rw [hz₁0, zero_mul])
    · by_cases hz₂0 : z₂ = 0
      · exact Or.inl (by rw [hz₂0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F M₁' z₁ := hz₁.resolve_left hz₁0
        have h2 : k₂ ≤ valL F M₁' z₂ := hz₂.resolve_left hz₂0
        rw [hval_mul_M₁' z₁ z₂ hz₁0 hz₂0]
        omega
  have hval_finset_sum_M₁' : ∀ {α : Type} (S : Finset α) (f : α → M₁') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M₁' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M₁' (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_M₁' k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hResSurj_M₁' : ∀ z : M₁', (z = 0 ∨ 0 ≤ valL F M₁' z) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (z - IntermediateField.inclusion hLM₁' x = 0 ∨
          1 ≤ valL F M₁' (z - IntermediateField.inclusion hLM₁' x)) := by
    intro z hz
    obtain ⟨c, hz_eq, hval_iff⟩ := hBasis_M₀ z
    let t_term (i : Fin p) : M₁' := IntermediateField.inclusion hLM₁' (c i) * ((ϖ_M₀ : M₁') ^ (i : ℕ))
    let i_zero : Fin p := ⟨0, hp_pos⟩
    let x : L := c i_zero
    have hc_all := (hval_iff 0).mp hz
    have hx : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc_all i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (p : ℤ) * valL F L x + (0 : ℤ) at hge
        nlinarith
    have ht_zero : t_term i_zero = IntermediateField.inclusion hLM₁' x := by
      dsimp [t_term, i_zero, x]
      rw [pow_zero, mul_one]
    have hz_sub : z - IntermediateField.inclusion hLM₁' x =
        ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i_zero, t_term i := by
      have hsum := (Finset.add_sum_erase (Finset.univ : Finset (Fin p)) t_term
        (Finset.mem_univ i_zero)).symm
      rw [ht_zero] at hsum
      rw [hz_eq]
      change (∑ i : Fin p, t_term i) - IntermediateField.inclusion hLM₁' x = _
      rw [hsum, add_sub_cancel_left]
    refine ⟨x, hx, ?_⟩
    rw [hz_sub]
    apply hval_finset_sum_M₁' ((Finset.univ : Finset (Fin p)).erase i_zero) t_term 1
    intro i hi
    have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
    have hi_ge1 : (1 : ℤ) ≤ (i.1 : ℤ) := by
      have hne0 : i.1 ≠ 0 := fun h0 => hi_ne (Fin.ext h0)
      omega
    by_cases hci0 : c i = 0
    · left
      dsimp [t_term]
      rw [hci0, map_zero, zero_mul]
    · right
      have hci_ge : 0 ≤ (p : ℤ) * valL F L (c i) + (i.1 : ℤ) := (hc_all i).resolve_left hci0
      have hi_lt : (i.1 : ℤ) < (p : ℤ) := Nat.cast_lt.mpr i.2
      have hci_val_ge0 : 0 ≤ valL F L (c i) := by nlinarith
      have hinc_ne : IntermediateField.inclusion hLM₁' (c i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hLM₁').toRingHom).ne hci0
      have hpow_ne : ((ϖ_M₀ : M₁') ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_M₀)
      dsimp [t_term]
      rw [hval_mul_M₁' _ _ hinc_ne hpow_ne, hval_LM₁' (c i),
        hval_pow_M₁' (ϖ_M₀ : M₁') (i : ℕ) (Units.ne_zero ϖ_M₀), hϖ_M₀, mul_one]
      nlinarith
  have hval_add_eq_left_M₁' : ∀ {a b : M₁'}, a ≠ 0 →
      (b = 0 ∨ valL F M₁' a + 1 ≤ valL F M₁' b) →
      a + b ≠ 0 ∧ valL F M₁' (a + b) = valL F M₁' a := by
    intro a b ha hb
    rcases hb with rfl | hb_ge
    · rw [add_zero]
      exact ⟨ha, rfl⟩
    · have hab_ne0 : a + b ≠ 0 := by
        intro h0
        have hb_eq : b = -a := eq_neg_of_add_eq_zero_right h0
        have hv : valL F M₁' b = valL F M₁' a := by rw [hb_eq, hval_neg_M₁']
        omega
      have h_ge : valL F M₁' a ≤ valL F M₁' (a + b) := by
        have h1 := hval_add_M₁' (valL F M₁' a) a b (Or.inr le_rfl) (Or.inr (by omega))
        exact h1.resolve_left hab_ne0
      have h_le : valL F M₁' (a + b) ≤ valL F M₁' a := by
        by_contra h_gt
        push_neg at h_gt
        have ha_eq : a = (a + b) + (-b) := by ring
        have h2 := hval_add_M₁' (valL F M₁' a + 1) (a + b) (-b)
          (Or.inr (by omega)) (Or.inr (by rw [hval_neg_M₁']; omega))
        rw [← ha_eq] at h2
        have h3 := h2.resolve_left ha
        omega
      exact ⟨hab_ne0, le_antisymm h_le h_ge⟩

  have hτ_unif_nt : ∀ ϖ_M₁' : M₁'ˣ, valL F M₁' (ϖ_M₁' : M₁') = 1 →
      (Units.map τ.toRingEquiv.toMonoidHom ϖ_M₁') * ϖ_M₁'⁻¹ ∉ unitGroup F M₁' bM₁' := by
    intro ϖ_M₁' hϖ_M₁'
    let u : M₁'ˣ := ϖ_M₁' * ϖ_M₀⁻¹
    have hu_val : valL F M₁' (u : M₁') = 0 := by
      change valL F M₁' ((ϖ_M₁' : M₁') * ((ϖ_M₀⁻¹ : M₁'ˣ) : M₁')) = 0
      rw [hval_mul_M₁' _ _ (Units.ne_zero ϖ_M₁') (Units.ne_zero ϖ_M₀⁻¹),
        hϖ_M₁', hval_inv_M₁' ϖ_M₀, hϖ_M₀]
      ring
    obtain ⟨x, hx_val, hr_val⟩ := hResSurj_M₁' (u : M₁') (Or.inr (by omega))
    let r : M₁' := (u : M₁') - IntermediateField.inclusion hLM₁' x
    have hu_decomp : (u : M₁') = IntermediateField.inclusion hLM₁' x + r := by
      dsimp [r]; ring
    have hinc_x_ne0 : IntermediateField.inclusion hLM₁' x ≠ 0 := by
      intro h0
      have hr_eq : (u : M₁') = r := by rw [hu_decomp, h0, zero_add]
      rcases hr_val with hr0 | hr_ge1
      · exact Units.ne_zero u (hr_eq.trans hr0)
      · change 1 ≤ valL F M₁' r at hr_ge1
        rw [← hr_eq, hu_val] at hr_ge1
        omega
    have hx_ne0 : x ≠ 0 := fun h0 => hinc_x_ne0 (by rw [h0, map_zero])
    have hx_val_ge0 : 0 ≤ valL F L x := hx_val.resolve_left hx_ne0
    have hinc_x_val0 : valL F M₁' (IntermediateField.inclusion hLM₁' x) = 0 := by
      by_contra hne0
      have hinc_ge0 : 0 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x) := by
        rw [hval_LM₁' x]; nlinarith
      have hinc_ge1 : 1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x) := by omega
      have hu_ge1 := hval_add_M₁' 1 (IntermediateField.inclusion hLM₁' x) r
        (Or.inr hinc_ge1) hr_val
      rw [← hu_decomp] at hu_ge1
      have hge1 := hu_ge1.resolve_left (Units.ne_zero u)
      omega
    let z₂ : M₁' := r * (ϖ_M₀ : M₁')
    have hz₂_val : z₂ = 0 ∨ 2 ≤ valL F M₁' z₂ :=
      hval_mul_ge_M₁' 1 1 r (ϖ_M₀ : M₁') hr_val (Or.inr (by omega))
    have hϖ_decomp : (ϖ_M₁' : M₁') =
        IntermediateField.inclusion hLM₁' x * (ϖ_M₀ : M₁') + z₂ := by
      dsimp [z₂]
      rw [← add_mul, ← hu_decomp]
      change (ϖ_M₁' : M₁') = ((ϖ_M₁' : M₁') * ((ϖ_M₀⁻¹ : M₁'ˣ) : M₁')) * (ϖ_M₀ : M₁')
      rw [mul_assoc, Units.inv_mul, mul_one]
    let δ₀ : M₁' := act_M₁' γ_τ (ϖ_M₀ : M₁') - (ϖ_M₀ : M₁')
    obtain ⟨hjump_ne0, hjump_val⟩ := hjump_M₀ γ_τ hγ_ne1
    have hδ₀_neg : δ₀ = -((ϖ_M₀ : M₁') - act_M₁' γ_τ (ϖ_M₀ : M₁')) := by
      dsimp [δ₀]; ring
    have hδ₀_ne0 : δ₀ ≠ 0 := by
      rw [hδ₀_neg, neg_ne_zero]
      exact hjump_ne0
    have hδ₀_val : valL F M₁' δ₀ = (bM₁' : ℤ) := by
      rw [hδ₀_neg, hval_neg_M₁', hjump_val, htM₁'_add1_int]
    let T₁ : M₁' := IntermediateField.inclusion hLM₁' x * δ₀
    have hT₁_ne0 : T₁ ≠ 0 := mul_ne_zero hinc_x_ne0 hδ₀_ne0
    have hT₁_val : valL F M₁' T₁ = (bM₁' : ℤ) := by
      dsimp [T₁]
      rw [hval_mul_M₁' _ _ hinc_x_ne0 hδ₀_ne0, hinc_x_val0, hδ₀_val, zero_add]
    let T₂ : M₁' := act_M₁' γ_τ z₂ - z₂
    have hT₂_val : T₂ = 0 ∨ valL F M₁' T₁ + 1 ≤ valL F M₁' T₂ := by
      have h := hact_shift_M₁' γ_τ z₂ 2 hz₂_val
      rcases h with h0 | hge
      · exact Or.inl h0
      · right
        change 2 + (t_M₁' : ℤ) ≤ valL F M₁' T₂ at hge
        rw [hT₁_val]
        omega
    have hτ_diff_decomp : τ (ϖ_M₁' : M₁') - (ϖ_M₁' : M₁') = T₁ + T₂ := by
      conv_lhs => rw [hϖ_decomp]
      rw [map_add τ, map_mul τ, hτ_L x, hτ_act (ϖ_M₀ : M₁'), hτ_act z₂]
      dsimp [T₁, T₂, δ₀]
      ring
    obtain ⟨hτ_diff_ne0, hτ_diff_val⟩ := hval_add_eq_left_M₁' hT₁_ne0 hT₂_val
    rw [← hτ_diff_decomp] at hτ_diff_ne0 hτ_diff_val
    let w : M₁'ˣ := (Units.map τ.toRingEquiv.toMonoidHom ϖ_M₁') * ϖ_M₁'⁻¹
    have hw_sub : (w : M₁') - 1 =
        (τ (ϖ_M₁' : M₁') - (ϖ_M₁' : M₁')) * ((ϖ_M₁'⁻¹ : M₁'ˣ) : M₁') := by
      change τ (ϖ_M₁' : M₁') * ((ϖ_M₁'⁻¹ : M₁'ˣ) : M₁') - 1 = _
      rw [sub_mul, Units.mul_inv]
    have hw_sub_ne0 : (w : M₁') - 1 ≠ 0 := by
      rw [hw_sub]
      exact mul_ne_zero hτ_diff_ne0 (Units.ne_zero ϖ_M₁'⁻¹)
    have hw_sub_val : valL F M₁' ((w : M₁') - 1) = (bM₁' : ℤ) - 1 := by
      rw [hw_sub, hval_mul_M₁' _ _ hτ_diff_ne0 (Units.ne_zero ϖ_M₁'⁻¹),
        hτ_diff_val, hT₁_val, hval_inv_M₁' ϖ_M₁', hϖ_M₁']
      ring
    intro hw_mem
    rcases (hunit_ge1_M₁' bM₁' (by omega) w).mp hw_mem with hw1 | hw_ge
    · exact hw_sub_ne0 (sub_eq_zero.mpr hw1)
    · rw [hw_sub_val] at hw_ge
      omega

  exact ⟨hnE'_eq, hnM₁'_eq, hξE'_cond, hξM₁'_cond, hξE'_triv, hξM₁'_triv,
    hval_norm_LE', hval_LE', hval_norm_LM₁', hval_LM₁',
    htr_LE', htr_LM₁', hPkg_LE', ⟨τ, z₀, hτ_L, hτ_z₀, hτ_unif_nt⟩⟩

theorem ld_wild_one_way_norm_ker_total_ramification_and_power_basis (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hBK₁ : B ≤ K₁) (hGalBK₁ : IsGaloisExt F B K₁)
    (hPrime : Nat.Prime (Module.finrank B (IntermediateField.extendScalars hBK₁)))
    (ξB : Bˣ →* (Ω F)ˣ)
    (hbξ_ge2 : 2 ≤ condExp F B ξB)
    (hξB_triv : ∀ u ∈ unitGroup F B (condExp F B ξB), ξB u = 1)
    (hξB_norm : ∀ w : K₁ˣ, ξB (Units.map (normLM F hBK₁) w) = 1) :
    let p := Module.finrank B (IntermediateField.extendScalars hBK₁)
    (∀ w : K₁, valL F B (normLM F hBK₁ w) = valL F K₁ w) ∧
    (∀ y : B, valL F K₁ (IntermediateField.inclusion hBK₁ y) = (p : ℤ) * valL F B y) ∧
    (∀ ϖ_K₁ : K₁ˣ, valL F K₁ (ϖ_K₁ : K₁) = 1 →
      ∀ w : K₁, ∃ c : Fin p → B,
        w = ∑ i : Fin p, IntermediateField.inclusion hBK₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (w = 0 ∨ m ≤ valL F K₁ w) ↔
            ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F B (c i) + (i : ℤ)) ∧
    (∃ ϖ_K₁ : K₁ˣ, valL F K₁ (ϖ_K₁ : K₁) = 1) :=
by
  obtain ⟨hval0_B, hval1_B, hval_neg1_B, hval_neg_B, hval_mul_B,
    hval_inv_B, hval_surj_B, hval_add_B, hunit0_B, hunit_ge1_B, hunit_val0_B⟩ :=
    ld_valL_and_unitGroup_props F B
  obtain ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁,
    hval_inv_K₁, hval_surj_K₁, hval_add_K₁, hunit0_K₁, hunit_ge1_K₁, hunit_val0_K₁⟩ :=
    ld_valL_and_unitGroup_props F K₁
  set K₁' := IntermediateField.extendScalars hBK₁
  set p := Module.finrank B K₁'
  have hp_pos : 0 < p := hPrime.pos
  have hp_int_pos : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
  have hp_int_ne : (p : ℤ) ≠ 0 := ne_of_gt hp_int_pos

  
  have hval_pow_B : ∀ (y : B) (n : ℕ), y ≠ 0 → valL F B (y ^ n) = (n : ℤ) * valL F B y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_B]
    | succ n ih =>
      rw [pow_succ, hval_mul_B (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_pow_K₁ : ∀ (w : K₁) (n : ℕ), w ≠ 0 → valL F K₁ (w ^ n) = (n : ℤ) * valL F K₁ w := by
    intro w n hw
    induction n with
    | zero => simp [hval1_K₁]
    | succ n ih =>
      rw [pow_succ, hval_mul_K₁ (w ^ n) w (pow_ne_zero n hw) hw, ih]
      push_cast
      ring
  have hval_mul_ge_B : ∀ (k₁ k₂ : ℤ) (x y : B),
      (x = 0 ∨ k₁ ≤ valL F B x) → (y = 0 ∨ k₂ ≤ valL F B y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F B (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F B x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F B y := hy.resolve_left hy0
        rw [hval_mul_B x y hx0 hy0]
        omega
  have hval_mul_ge_K₁ : ∀ (k₁ k₂ : ℤ) (x y : K₁),
      (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F K₁ x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F K₁ y := hy.resolve_left hy0
        rw [hval_mul_K₁ x y hx0 hy0]
        omega

  
  set φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    unfold addVal
    rw [dif_neg one_ne_zero]
    have hφ1 : φ (valuation F 1) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr one_ne_zero)
    have hunz1 : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz1, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hφa : φ (valuation F a) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    have hφb : φ (valuation F b) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hb)
    have hφab : φ (valuation F (a * b)) ≠ 0 :=
      (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hab)
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]

  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S.Nonempty := by
      by_contra hne
      have hempty : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q_z : ℤ := valL F M z
      set r_z : ℤ := relVal F M z % f
      have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
          linarith
        let k : ℕ := r_z.toNat
        have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith

  obtain ⟨hresDeg_B_pos, hdiv_B⟩ := hrelVal_div B hval_surj_B
  obtain ⟨hresDeg_K₁_pos, hdiv_K₁⟩ := hrelVal_div K₁ hval_surj_K₁
  have hfB_int_ne : (resDeg F B : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hresDeg_B_pos)

  let eF : K₁ ≃ₐ[F] K₁' :=
    { toExtendScalars F hBK₁ with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hBK₁).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }

  have hrelVal_norm : ∀ w : K₁, relVal F B (normLM F hBK₁ w) = relVal F K₁ w := by
    intro w
    haveI : FiniteDimensional F K₁' := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F B K₁' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional B K₁' := Module.Finite.of_restrictScalars_finite F B K₁'
    change addVal F (Algebra.norm F (Algebra.norm B (toExtendScalars F hBK₁ w))) =
      addVal F (Algebra.norm F w)
    have h1 : Algebra.norm F (Algebra.norm B (toExtendScalars F hBK₁ w)) =
        Algebra.norm F (toExtendScalars F hBK₁ w) := Algebra.norm_norm
    have h2 : Algebra.norm F w = Algebra.norm F (toExtendScalars F hBK₁ w) :=
      Algebra.norm_eq_of_algEquiv eF w
    rw [h1, ← h2]

  have hnorm_inc : ∀ y : B,
      normLM F hBK₁ (IntermediateField.inclusion hBK₁ y) = y ^ p := by
    intro y
    change Algebra.norm B (algebraMap B K₁' y) = y ^ p
    exact Algebra.norm_algebraMap y

  
  have hResDeg : resDeg F K₁ = resDeg F B := by
    obtain ⟨c₁, hc₁⟩ := hval_surj_K₁ 1
    have hrel_c₁ : (resDeg F K₁ : ℤ) =
        (resDeg F B : ℤ) * valL F B (normLM F hBK₁ (c₁ : K₁)) := by
      calc (resDeg F K₁ : ℤ)
        _ = (resDeg F K₁ : ℤ) * valL F K₁ (c₁ : K₁) := by rw [hc₁, mul_one]
        _ = relVal F K₁ (c₁ : K₁) := (hdiv_K₁ (c₁ : K₁)).symm
        _ = relVal F B (normLM F hBK₁ (c₁ : K₁)) := (hrelVal_norm (c₁ : K₁)).symm
        _ = (resDeg F B : ℤ) * valL F B (normLM F hBK₁ (c₁ : K₁)) := hdiv_B _
    have hdvd1_int : (resDeg F B : ℤ) ∣ (resDeg F K₁ : ℤ) := ⟨_, hrel_c₁⟩
    have hdvd1_nat : resDeg F B ∣ resDeg F K₁ := Int.ofNat_dvd.mp hdvd1_int
    rcases hdvd1_nat with ⟨k, hk⟩
    obtain ⟨ϖ_B, hϖ_B⟩ := hval_surj_B 1
    let y_B : K₁ := IntermediateField.inclusion hBK₁ (ϖ_B : B)
    have hrel_yB_1 : relVal F K₁ y_B = (resDeg F B : ℤ) * (p : ℤ) := by
      calc relVal F K₁ y_B
        _ = relVal F B (normLM F hBK₁ y_B) := (hrelVal_norm y_B).symm
        _ = relVal F B ((ϖ_B : B) ^ p) := by dsimp [y_B]; rw [hnorm_inc (ϖ_B : B)]
        _ = (resDeg F B : ℤ) * valL F B ((ϖ_B : B) ^ p) := hdiv_B _
        _ = (resDeg F B : ℤ) * ((p : ℤ) * valL F B (ϖ_B : B)) := by
            rw [hval_pow_B (ϖ_B : B) p (Units.ne_zero ϖ_B)]
        _ = (resDeg F B : ℤ) * (p : ℤ) := by rw [hϖ_B, mul_one]
    have hrel_yB_2 : relVal F K₁ y_B = (resDeg F B : ℤ) * ((k : ℤ) * valL F K₁ y_B) := by
      rw [hdiv_K₁ y_B, hk, Nat.cast_mul, mul_assoc]
    have hp_eq_k : (p : ℤ) = (k : ℤ) * valL F K₁ y_B :=
      mul_left_cancel₀ hfB_int_ne (hrel_yB_1.symm.trans hrel_yB_2)
    have hdvd_p_int : (k : ℤ) ∣ (p : ℤ) := ⟨valL F K₁ y_B, hp_eq_k⟩
    have hdvd_p : k ∣ p := Int.ofNat_dvd.mp hdvd_p_int
    rcases (Nat.dvd_prime hPrime).mp hdvd_p with hk1 | hkp
    · rw [hk, hk1, mul_one]
    · exfalso
      have hval_norm_unram : ∀ w : K₁,
          valL F B (normLM F hBK₁ w) = (p : ℤ) * valL F K₁ w := by
        intro w
        apply mul_left_cancel₀ hfB_int_ne
        calc (resDeg F B : ℤ) * valL F B (normLM F hBK₁ w)
          _ = relVal F B (normLM F hBK₁ w) := (hdiv_B _).symm
          _ = relVal F K₁ w := hrelVal_norm w
          _ = (resDeg F K₁ : ℤ) * valL F K₁ w := hdiv_K₁ w
          _ = (resDeg F B : ℤ) * ((p : ℤ) * valL F K₁ w) := by
              rw [hk, hkp, Nat.cast_mul, mul_assoc]
      have hval_alg_unram : ∀ y : B,
          valL F K₁ (IntermediateField.inclusion hBK₁ y) = valL F B y := by
        intro y
        by_cases hy0 : y = 0
        · rw [hy0, map_zero, hval0_K₁, hval0_B]
        · apply mul_left_cancel₀ hp_int_ne
          calc (p : ℤ) * valL F K₁ (IntermediateField.inclusion hBK₁ y)
            _ = valL F B (normLM F hBK₁ (IntermediateField.inclusion hBK₁ y)) :=
                (hval_norm_unram _).symm
            _ = valL F B (y ^ p) := by rw [hnorm_inc y]
            _ = (p : ℤ) * valL F B y := hval_pow_B y p hy0
      obtain ⟨_, ⟨y₁, hy₁_val, hy₁_tr⟩, hnorm_lin1, _⟩ :=
        ld_ch10_unramified_residue_galois_bridge F B K₁ hBK₁ hGalBK₁ hPrime
          hval_norm_unram hval_alg_unram
      have htrace_smul : ∀ (x : B) (w : K₁),
          traceLM F hBK₁ (IntermediateField.inclusion hBK₁ x * w) = x * traceLM F hBK₁ w := by
        letI : Module B B := Semiring.toModule
        intro x w
        exact (Algebra.trace B K₁').map_smul' x (toExtendScalars F hBK₁ w)
      set bξ := condExp F B ξB
      set d := bξ - 1
      have hd_ge1 : 1 ≤ d := by omega
      have hbξ_pos : 1 ≤ bξ := by omega
      have htriv_d : ∀ u ∈ unitGroup F B d, ξB u = 1 := by
        intro u hu
        let x : B := (u : B) - 1
        have hx_val : x = 0 ∨ (d : ℤ) ≤ valL F B x := by
          rcases (hunit_ge1_B d hd_ge1 u).mp hu with h1 | hge
          · left
            dsimp [x]
            rw [h1, sub_self]
          · exact Or.inr hge
        have hx_K₁ : IntermediateField.inclusion hBK₁ x = 0 ∨
            (d : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hBK₁ x) := by
          rcases hx_val with h0 | hge
          · left
            rw [h0, map_zero]
          · right
            rwa [hval_alg_unram x]
        let w : K₁ := IntermediateField.inclusion hBK₁ x * y₁
        have hw_val : w = 0 ∨ (d : ℤ) ≤ valL F K₁ w := by
          simpa [w] using hval_mul_ge_K₁ (d : ℤ) 0 (IntermediateField.inclusion hBK₁ x) y₁
            hx_K₁ hy₁_val
        have h1w_ne0 : 1 + w ≠ 0 := by
          intro h0
          have hw_eq : w = -1 := eq_neg_of_add_eq_zero_right h0
          rcases hw_val with hw0 | hw_ge
          · rw [hw_eq] at hw0
            exact neg_ne_zero.mpr one_ne_zero hw0
          · rw [hw_eq, hval_neg1_K₁] at hw_ge
            omega
        let v : K₁ˣ := Units.mk0 (1 + w) h1w_ne0
        have htr_w : 1 + traceLM F hBK₁ w = (u : B) := by
          dsimp [w, x]
          rw [htrace_smul ((u : B) - 1) y₁, hy₁_tr, mul_one]
          ring
        have hlin := hnorm_lin1 d hd_ge1 w hw_val
        rw [htr_w] at hlin
        let δ : B := normLM F hBK₁ (1 + w) - (u : B)
        have hδ_val : δ = 0 ∨ (bξ : ℤ) ≤ valL F B δ := by
          rcases hlin with h0 | hge
          · exact Or.inl h0
          · right
            dsimp [δ]
            omega
        let z_u : Bˣ := (Units.map (normLM F hBK₁) v) * u⁻¹
        have hzu_sub : (z_u : B) - 1 = δ * ((u⁻¹ : Bˣ) : B) := by
          change normLM F hBK₁ (1 + w) * ((u⁻¹ : Bˣ) : B) - 1 =
            (normLM F hBK₁ (1 + w) - (u : B)) * ((u⁻¹ : Bˣ) : B)
          rw [sub_mul, Units.mul_inv]
        have hu_inv_val0 : valL F B ((u⁻¹ : Bˣ) : B) = 0 := by
          rw [hval_inv_B u, hunit_val0_B d u hu, neg_zero]
        have hzu_mem : z_u ∈ unitGroup F B bξ := by
          rw [hunit_ge1_B bξ hbξ_pos z_u]
          have hmul := hval_mul_ge_B (bξ : ℤ) 0 δ ((u⁻¹ : Bˣ) : B) hδ_val
            (Or.inr (le_of_eq hu_inv_val0.symm))
          rw [add_zero, ← hzu_sub] at hmul
          rcases hmul with h0 | hge
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hge
        have hξ_zu : ξB z_u = 1 := hξB_triv z_u hzu_mem
        dsimp [z_u] at hξ_zu
        rw [map_mul, hξB_norm v, one_mul, map_inv, inv_eq_one] at hξ_zu
        exact hξ_zu
      have hbξ_le_d : bξ ≤ d := Nat.sInf_le htriv_d
      omega

  have hval_norm : ∀ w : K₁, valL F B (normLM F hBK₁ w) = valL F K₁ w := by
    intro w
    apply mul_left_cancel₀ hfB_int_ne
    calc (resDeg F B : ℤ) * valL F B (normLM F hBK₁ w)
      _ = relVal F B (normLM F hBK₁ w) := (hdiv_B (normLM F hBK₁ w)).symm
      _ = relVal F K₁ w := hrelVal_norm w
      _ = (resDeg F K₁ : ℤ) * valL F K₁ w := hdiv_K₁ w
      _ = (resDeg F B : ℤ) * valL F K₁ w := by rw [hResDeg]

  have hval_alg : ∀ y : B,
      valL F K₁ (IntermediateField.inclusion hBK₁ y) = (p : ℤ) * valL F B y := by
    intro y
    by_cases hy0 : y = 0
    · rw [hy0, map_zero, hval0_K₁, hval0_B, mul_zero]
    · rw [← hval_norm (IntermediateField.inclusion hBK₁ y), hnorm_inc y, hval_pow_B y p hy0]

  
  have hval_strict_K₁ : ∀ (w₁ w₂ : K₁),
      w₁ ≠ 0 → (w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ w₂) →
        w₁ + w₂ ≠ 0 ∧ valL F K₁ (w₁ + w₂) = valL F K₁ w₁ := by
    intro w₁ w₂ hw₁ hw₂
    set v₁ : ℤ := valL F K₁ w₁
    have hw₂_ge : w₂ = 0 ∨ v₁ ≤ valL F K₁ w₂ := by
      rcases hw₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : w₁ + w₂ = 0 ∨ v₁ ≤ valL F K₁ (w₁ + w₂) :=
      hval_add_K₁ v₁ w₁ w₂ (Or.inr le_rfl) hw₂_ge
    have hnot_gt : ¬ (w₁ + w₂ = 0 ∨ v₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := by
      intro hgt
      have hneg_w₂ : -w₂ = 0 ∨ v₁ + 1 ≤ valL F K₁ (-w₂) := by
        rcases hw₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_K₁]
          exact hge
      have hw₁_gt := hval_add_K₁ (v₁ + 1) (w₁ + w₂) (-w₂) hgt hneg_w₂
      have heq_w₁ : (w₁ + w₂) + (-w₂) = w₁ := by ring
      rw [heq_w₁] at hw₁_gt
      rcases hw₁_gt with h10 | h1ge
      · exact hw₁ h10
      · omega
    have hsum_ne : w₁ + w₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K₁ (w₁ + w₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  have hBasis : ∀ ϖ_K₁ : K₁ˣ, valL F K₁ (ϖ_K₁ : K₁) = 1 →
      ∀ w : K₁, ∃ c : Fin p → B,
        w = ∑ i : Fin p, IntermediateField.inclusion hBK₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (w = 0 ∨ m ≤ valL F K₁ w) ↔
            ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F B (c i) + (i : ℤ) := by
    intro ϖ_K₁ hϖ_K₁
    let t_term (c : Fin p → B) (i : Fin p) : K₁ :=
      IntermediateField.inclusion hBK₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ))
    let v_term (c : Fin p → B) (i : Fin p) : ℤ :=
      (p : ℤ) * valL F B (c i) + (i.1 : ℤ)
    have ht_term_zero : ∀ (c : Fin p → B) (i : Fin p), c i = 0 → t_term c i = 0 := by
      intro c i hci
      dsimp [t_term]
      rw [hci, map_zero, zero_mul]
    have ht_term_nz : ∀ (c : Fin p → B) (i : Fin p),
        c i ≠ 0 → t_term c i ≠ 0 ∧ valL F K₁ (t_term c i) = v_term c i := by
      intro c i hci
      have hinc_ne : IntermediateField.inclusion hBK₁ (c i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hBK₁).toRingHom).ne hci
      have hpow_ne : ((ϖ_K₁ : K₁) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_K₁)
      refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
      dsimp [t_term, v_term]
      rw [hval_mul_K₁ _ _ hinc_ne hpow_ne, hval_alg (c i),
        hval_pow_K₁ (ϖ_K₁ : K₁) (i : ℕ) (Units.ne_zero ϖ_K₁), hϖ_K₁, mul_one]
    have hv_term_inj : ∀ (c : Fin p → B) (i j : Fin p),
        v_term c i = v_term c j → i = j := by
      intro c i j hij
      have hmod : ∀ k : Fin p, v_term c k % (p : ℤ) = (k.1 : ℤ) := by
        intro k
        dsimp [v_term]
        have hcomm : (p : ℤ) * valL F B (c k) + (k.1 : ℤ) =
            (k.1 : ℤ) + (p : ℤ) * valL F B (c k) := by ring
        rw [hcomm, Int.add_mul_emod_self_left,
          Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
      have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
        rw [← hmod i, ← hmod j, hij]
      exact Fin.ext (Nat.cast_injective hmod_eq)
    have hval_sum_ge : ∀ (c : Fin p → B) (S : Finset (Fin p)) (m : ℤ),
        (∀ i ∈ S, c i = 0 ∨ m ≤ v_term c i) →
          ((∑ i ∈ S, t_term c i) = 0 ∨ m ≤ valL F K₁ (∑ i ∈ S, t_term c i)) := by
      intro c S m hS
      induction S using Finset.induction_on with
      | empty =>
        left
        simp
      | @insert a s ha ih =>
        rw [Finset.sum_insert ha]
        have ha_t : t_term c a = 0 ∨ m ≤ valL F K₁ (t_term c a) := by
          by_cases hca : c a = 0
          · exact Or.inl (ht_term_zero c a hca)
          · right
            rw [(ht_term_nz c a hca).2]
            exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
        have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
        exact hval_add_K₁ m (t_term c a) (∑ i ∈ s, t_term c i) ha_t hs_t
    have hsum_min_nz : ∀ (c : Fin p → B) (i : Fin p),
        c i ≠ 0 →
          ∃ i₀ : Fin p, c i₀ ≠ 0 ∧ v_term c i₀ ≤ v_term c i ∧
            (∑ j : Fin p, t_term c j) ≠ 0 ∧
            valL F K₁ (∑ j : Fin p, t_term c j) = v_term c i₀ := by
      intro c i hci
      let S_nz : Finset (Fin p) := (Finset.univ : Finset (Fin p)).filter (fun j => c j ≠ 0)
      have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
      obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term c) ⟨i, hi_mem⟩
      have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
      have hle_i : v_term c i₀ ≤ v_term c i := hi₀_min i hi_mem
      have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
          c j = 0 ∨ v_term c i₀ + 1 ≤ v_term c j := by
        intro j hj
        have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
        by_cases hcj : c j = 0
        · exact Or.inl hcj
        · right
          have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
          have hle_j : v_term c i₀ ≤ v_term c j := hi₀_min j hj_mem
          have hne_v : v_term c i₀ ≠ v_term c j := fun heq => hj_ne (hv_term_inj c i₀ j heq).symm
          omega
      have hrem := hval_sum_ge c ((Finset.univ : Finset (Fin p)).erase i₀)
        (v_term c i₀ + 1) herase_ge
      obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz c i₀ hci₀
      rw [← hti₀_val] at hrem
      have hstrict := hval_strict_K₁ (t_term c i₀)
        (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term c j) hti₀_ne hrem
      rw [Finset.add_sum_erase Finset.univ (t_term c) (Finset.mem_univ i₀), hti₀_val] at hstrict
      exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩
    have hval_sum_iff : ∀ (c : Fin p → B) (m : ℤ),
        ((∑ i : Fin p, t_term c i) = 0 ∨ m ≤ valL F K₁ (∑ i : Fin p, t_term c i)) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ v_term c i := by
      intro c m
      refine ⟨?_, fun hall => hval_sum_ge c Finset.univ m (fun i _ => hall i)⟩
      intro hsum i
      by_cases hci : c i = 0
      · exact Or.inl hci
      · right
        obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_nz c i hci
        have hm_le : m ≤ valL F K₁ (∑ j : Fin p, t_term c j) := hsum.resolve_left hsum_ne
        omega
    have hlin_zero : ∀ (c : Fin p → B),
        (∑ i : Fin p, t_term c i) = 0 → ∀ i : Fin p, c i = 0 := by
      intro c hsum0 i
      by_contra hci
      obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_nz c i hci
      exact hsum_ne hsum0
    let b_vec : Fin p → K₁' := fun i => (toExtendScalars F hBK₁ (ϖ_K₁ : K₁)) ^ (i : ℕ)
    have hli : LinearIndependent B b_vec := by
      rw [Fintype.linearIndependent_iff]
      intro c hc
      have hsum_eq : toExtendScalars F hBK₁ (∑ i : Fin p, t_term c i) =
          ∑ i : Fin p, c i • b_vec i := by
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro i _
        dsimp [t_term, b_vec]
        rw [map_mul, map_pow]
        rfl
      have hsum0 : (∑ i : Fin p, t_term c i) = 0 := by
        apply eF.injective
        change toExtendScalars F hBK₁ (∑ i : Fin p, t_term c i) = 0
        rw [hsum_eq, hc]
      exact hlin_zero c hsum0
    haveI : Nonempty (Fin p) := ⟨⟨0, hp_pos⟩⟩
    haveI : FiniteDimensional F K₁' := Module.Finite.equiv eF.toLinearEquiv
    haveI : IsScalarTower F B K₁' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional B K₁' := Module.Finite.of_restrictScalars_finite F B K₁'
    have hcard : Fintype.card (Fin p) = Module.finrank B K₁' := Fintype.card_fin p
    let B_basis : Module.Basis (Fin p) B K₁' := basisOfLinearIndependentOfCardEqFinrank hli hcard
    intro w
    let c : Fin p → B := fun i => B_basis.repr (toExtendScalars F hBK₁ w) i
    have hw_eq : w = ∑ i : Fin p, t_term c i := by
      apply eF.injective
      change toExtendScalars F hBK₁ w = toExtendScalars F hBK₁ (∑ i : Fin p, t_term c i)
      have hrepr := (B_basis.sum_repr (toExtendScalars F hBK₁ w)).symm
      rw [hrepr, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [B_basis, c, t_term, b_vec]
      rw [coe_basisOfLinearIndependentOfCardEqFinrank hli hcard, map_mul, map_pow]
      rfl
    refine ⟨c, hw_eq, fun m => ?_⟩
    rw [hw_eq]
    exact hval_sum_iff c m

  exact ⟨hval_norm, hval_alg, hBasis, hval_surj_K₁ 1⟩

theorem ld_wild_tot_ram_jump_trace_cond_and_norm_filtration (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K₁]
    (hBK₁ : B ≤ K₁) (hGalBK₁ : IsGaloisExt F B K₁)
    (hPrime : Nat.Prime (Module.finrank B (IntermediateField.extendScalars hBK₁)))
    (hWild : Module.finrank B (IntermediateField.extendScalars hBK₁) = p F)
    (hval_norm : ∀ w : K₁, valL F B (normLM F hBK₁ w) = valL F K₁ w)
    (hval_alg : ∀ y : B,
      valL F K₁ (IntermediateField.inclusion hBK₁ y) =
        (Module.finrank B (IntermediateField.extendScalars hBK₁) : ℤ) * valL F B y)
    (ϖ_K₁ : K₁ˣ) (hϖ_K₁ : valL F K₁ (ϖ_K₁ : K₁) = 1)
    (hBasis : ∀ w : K₁, ∃ c : Fin (Module.finrank B (IntermediateField.extendScalars hBK₁)) → B,
      w = ∑ i : Fin (Module.finrank B (IntermediateField.extendScalars hBK₁)),
        IntermediateField.inclusion hBK₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin (Module.finrank B (IntermediateField.extendScalars hBK₁)),
            c i = 0 ∨
              m ≤ (Module.finrank B (IntermediateField.extendScalars hBK₁) : ℤ) *
                valL F B (c i) + (i : ℤ))
    (ψB : AddChar B (Ω F)) (hψB : IsAdmissibleChar F B ψB)
    (ξB : Bˣ →* (Ω F)ˣ)
    (hξB_triv : ∀ u ∈ unitGroup F B (condExp F B ξB), ξB u = 1)
    (hξB_norm : ∀ w : K₁ˣ, ξB (Units.map (normLM F hBK₁) w) = 1) :
    let p := Module.finrank B (IntermediateField.extendScalars hBK₁)
    ∃ (u : ℕ) (G_K₁ : Type u) (_ : Group G_K₁) (_ : Fintype G_K₁)
      (act_K₁ : G_K₁ → K₁ → K₁) (y₁_K₁ : K₁),
      1 ≤ u ∧
      Fintype.card G_K₁ = p ∧
      (∀ w : K₁, act_K₁ 1 w = w) ∧
      (∀ (σ τ : G_K₁) (w : K₁), act_K₁ (σ * τ) w = act_K₁ σ (act_K₁ τ w)) ∧
      (∀ σ : G_K₁,
        act_K₁ σ 0 = 0 ∧ act_K₁ σ 1 = 1 ∧
        (∀ w₁ w₂ : K₁,
          act_K₁ σ (w₁ + w₂) = act_K₁ σ w₁ + act_K₁ σ w₂ ∧
          act_K₁ σ (w₁ * w₂) = act_K₁ σ w₁ * act_K₁ σ w₂ ∧
          act_K₁ σ (-w₁) = -act_K₁ σ w₁)) ∧
      (∀ (σ : G_K₁) (y : B),
        act_K₁ σ (IntermediateField.inclusion hBK₁ y) = IntermediateField.inclusion hBK₁ y) ∧
      (∀ (σ : G_K₁) (w : K₁), valL F K₁ (act_K₁ σ w) = valL F K₁ w) ∧
      (∀ w : K₁, IntermediateField.inclusion hBK₁ (traceLM F hBK₁ w) = ∑ σ : G_K₁, act_K₁ σ w) ∧
      (∀ w : K₁, IntermediateField.inclusion hBK₁ (normLM F hBK₁ w) = ∏ σ : G_K₁, act_K₁ σ w) ∧
      (∀ τ : G_K₁, τ ≠ 1 →
        (ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁) ≠ 0 ∧
        valL F K₁ ((ϖ_K₁ : K₁) - act_K₁ τ (ϖ_K₁ : K₁)) = (u + 1 : ℤ)) ∧
      traceLM F hBK₁ y₁_K₁ = 1 ∧
      y₁_K₁ ≠ 0 ∧
      valL F K₁ y₁_K₁ = -(((p - 1 : ℕ) : ℤ) * (u : ℤ)) ∧
      (∀ (m : ℤ) (w : K₁),
        (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
        (traceLM F hBK₁ w = 0 ∨ m ≤ valL F B (traceLM F hBK₁ w))) ∧
      condExpChar F K₁ (traceChar F hBK₁ ψB) =
        (p : ℤ) * condExpChar F B ψB + ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) ∧
      condExp F B ξB ≤ u + 1 ∧
      (∀ m ≤ u + 1, ∀ w ∈ unitGroup F K₁ m,
        Units.map (normLM F hBK₁) w ∈ unitGroup F B m) ∧
      (∀ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : B, τ_lift (IntermediateField.inclusion hBK₁ y) =
          IntermediateField.inclusion hBK₁ y) →
        (∃ w₀ : K₁, τ_lift w₀ ≠ w₀) →
        ∀ m ≤ u, (Units.map τ_lift.toRingEquiv.toMonoidHom ϖ_K₁) * ϖ_K₁⁻¹ ∈ unitGroup F K₁ m) :=
by
  intro p
  let K₁' : IntermediateField B (AlgebraicClosure F) := IntermediateField.extendScalars hBK₁
  haveI : FiniteDimensional F K₁' := ‹FiniteDimensional F K₁›
  haveI : IsScalarTower F B K₁' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional B K₁' := Module.Finite.of_restrictScalars_finite F B K₁'
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega

  
  have hvalB_props := ld_valL_and_unitGroup_props F B
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  obtain ⟨hval0_B, hval1_B, hval_neg1_B, hval_neg_B, hval_mul_B, hval_inv_B,
    hval_surj_B, hval_add_B, hunit0_B, hunit_ge1_B, hunit_val0_B⟩ :=
    ld_valL_and_unitGroup_props F B
  obtain ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁,
    hval_surj_K₁, hval_add_K₁, hunit0_K₁, hunit_ge1_K₁, hunit_val0_K₁⟩ :=
    ld_valL_and_unitGroup_props F K₁
  obtain ⟨haddVal1, _, _, _, _, halg1, _⟩ := ld_addVal_finset_and_algebraMap_valL F B

  have hval_le_K₁ : ∀ {k₁ k₂ : ℤ} {w : K₁},
      k₁ ≤ k₂ → (w = 0 ∨ k₂ ≤ valL F K₁ w) → (w = 0 ∨ k₁ ≤ valL F K₁ w) := by
    intro k₁ k₂ w hle hw
    rcases hw with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hval_mul_ge_B : ∀ (k₁ k₂ : ℤ) (x₁ x₂ : B),
      (x₁ = 0 ∨ k₁ ≤ valL F B x₁) → (x₂ = 0 ∨ k₂ ≤ valL F B x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F B (x₁ * x₂)) := by
    intro k₁ k₂ x₁ x₂ hx₁ hx₂
    by_cases h1 : x₁ = 0
    · exact Or.inl (by rw [h1, zero_mul])
    · by_cases h2 : x₂ = 0
      · exact Or.inl (by rw [h2, mul_zero])
      · right
        rw [hval_mul_B x₁ x₂ h1 h2]
        have hg1 := hx₁.resolve_left h1
        have hg2 := hx₂.resolve_left h2
        omega
  have hval_mul_ge_K₁ : ∀ (k₁ k₂ : ℤ) (w₁ w₂ : K₁),
      (w₁ = 0 ∨ k₁ ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k₂ ≤ valL F K₁ w₂) →
        (w₁ * w₂ = 0 ∨ k₁ + k₂ ≤ valL F K₁ (w₁ * w₂)) := by
    intro k₁ k₂ w₁ w₂ hw₁ hw₂
    by_cases h1 : w₁ = 0
    · exact Or.inl (by rw [h1, zero_mul])
    · by_cases h2 : w₂ = 0
      · exact Or.inl (by rw [h2, mul_zero])
      · right
        rw [hval_mul_K₁ w₁ w₂ h1 h2]
        have hg1 := hw₁.resolve_left h1
        have hg2 := hw₂.resolve_left h2
        omega
  have hunit_anti_K₁ : ∀ {a b : ℕ}, a ≤ b → ∀ {w : K₁ˣ},
      w ∈ unitGroup F K₁ b → w ∈ unitGroup F K₁ a := by
    intro a b hab w hw
    by_cases ha0 : a = 0
    · subst ha0
      exact (hunit0_K₁ w).mpr (hunit_val0_K₁ b w hw)
    · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      have hb1 : 1 ≤ b := le_trans ha1 hab
      rw [hunit_ge1_K₁ a ha1 w]
      rcases (hunit_ge1_K₁ b hb1 w).mp hw with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by omega) hge)
  have h1_add_ne_zero_K₁ : ∀ {w : K₁}, (w = 0 ∨ 1 ≤ valL F K₁ w) → 1 + w ≠ 0 := by
    intro w hw h0
    have h1_eq : (1 : K₁) = -w := eq_neg_of_add_eq_zero_left h0
    rcases hw with hw0 | hge
    · rw [hw0, neg_zero] at h1_eq
      exact one_ne_zero h1_eq
    · have hv : valL F K₁ (1 : K₁) = valL F K₁ w := by rw [h1_eq, hval_neg_K₁]
      rw [hval1_K₁] at hv
      omega

  obtain ⟨G_K₁, instGroupGK₁, instFintypeGK₁, act_K₁, u, w_star,
    hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, hact_faithful, hact_val, hact_trace, hact_norm,
    hu_ge1, hw_star_u, hw_star_nt1, hw_star_norm, hjump⟩ :=
    ld_wild_galois_aut_and_ramification_jump F B K₁ hBK₁ hGalBK₁ hPrime hWild
      haddVal1 halg1 hvalB_props hvalK₁_props hval_norm hval_alg ϖ_K₁ hϖ_K₁ hBasis
  letI : Group G_K₁ := instGroupGK₁
  letI : Fintype G_K₁ := instFintypeGK₁
  obtain ⟨htr_bound_raw, htr_surj⟩ :=
    ld_wild_euler_lagrange_trace_formula F B K₁ hBK₁ hPrime
      hvalB_props hvalK₁_props hval_alg ϖ_K₁ hϖ_K₁ hBasis
      G_K₁ act_K₁ hcard_G hact_one hact_mul hact_ring hact_incl hact_trace u hjump
  have hnorm_exp :=
    ld_wild_free_orbit_norm_expansion F B K₁ hBK₁ hPrime hvalK₁_props
      G_K₁ act_K₁ hcard_G hact_one hact_mul hact_ring hact_val hact_trace hact_norm

  have hu_add1_int : ((u + 1 : ℕ) : ℤ) = (u + 1 : ℤ) := by push_cast; ring
  have htr_bound : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hBK₁ w = 0 ∨ m ≤ valL F B (traceLM F hBK₁ w)) := by
    intro m w hw
    rw [hu_add1_int] at hw
    exact htr_bound_raw m w hw

  obtain ⟨y₁_K₁, hy₁_tr, _, hy₁_nz⟩ := htr_surj (1 : B)
  obtain ⟨hy₁_ne0, hy₁_val_raw⟩ := hy₁_nz one_ne_zero
  have hy₁_val : valL F K₁ y₁_K₁ = -(((p - 1 : ℕ) : ℤ) * (u : ℤ)) := by
    change valL F K₁ y₁_K₁ =
      (p : ℤ) * valL F B (1 : B) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (u + 1 : ℤ) at hy₁_val_raw
    rw [hy₁_val_raw, hval1_B]
    ring

  
  let ψK₁ := traceChar F hBK₁ ψB
  have hψK₁ : IsAdmissibleChar F K₁ ψK₁ :=
    ld_traceChar_admissible F B K₁ hBK₁ (hGalBK₁.2.2.2 hBK₁) ψB hψB
  have hψK₁_app : ∀ w : K₁, ψK₁ w = ψB (traceLM F hBK₁ w) := fun _ => rfl
  have hSpecB := ld_condExp_and_condExpChar_spec F B ψB hψB 1
  have hSpecK₁ := ld_condExp_and_condExpChar_spec F K₁ ψK₁ hψK₁ 1
  let nB := condExpChar F B ψB
  let nK₁ := condExpChar F K₁ ψK₁
  let N_K₁ : ℤ := (p : ℤ) * nB + ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ)
  have hnK₁ : nK₁ = N_K₁ := by
    have hle1 : nK₁ ≤ N_K₁ := by
      obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩ := hSpecB.2.1
      obtain ⟨w₁, hw₁_tr, _, hw₁_ne_prop⟩ := htr_surj x₁
      obtain ⟨hw₁_ne0, hw₁_val_eq⟩ := hw₁_ne_prop hx₁_ne0
      have hw₁_ψ : ψK₁ w₁ ≠ 1 := by
        rw [hψK₁_app, hw₁_tr]
        exact hx₁_ψ
      have hw₁_val : -(N_K₁ + 1) ≤ valL F K₁ w₁ := by
        change valL F K₁ w₁ =
          (p : ℤ) * valL F B x₁ + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (u + 1 : ℤ) at hw₁_val_eq
        rw [hw₁_val_eq]
        have hmul : (p : ℤ) * (-(nB + 1)) ≤ (p : ℤ) * valL F B x₁ :=
          mul_le_mul_of_nonneg_left hx₁_val (by omega)
        have hrhs_eq :
            (p : ℤ) * (-(nB + 1)) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (u + 1 : ℤ) =
              -(N_K₁ + 1) := by
          dsimp [N_K₁]
          rw [hp_sub1_int]
          ring
        linarith
      by_contra hlt
      push_neg at hlt
      have htriv : ψK₁ w₁ = 1 := hSpecK₁.1 w₁ (Or.inr (by change -nK₁ ≤ valL F K₁ w₁; omega))
      exact hw₁_ψ htriv
    have hle2 : N_K₁ ≤ nK₁ := by
      obtain ⟨w₂, hw₂_ne0, hw₂_val, hw₂_ψ⟩ := hSpecK₁.2.1
      by_contra hlt
      push_neg at hlt
      have hbound : (p : ℤ) * (-nB) - ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) ≤ valL F K₁ w₂ := by
        have h1 : (p : ℤ) * (-nB) - ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) = -N_K₁ := by
          dsimp [N_K₁]
          ring
        rw [h1]
        change -(nK₁ + 1) ≤ valL F K₁ w₂ at hw₂_val
        omega
      have htr_val := htr_bound (-nB) w₂ (Or.inr hbound)
      have htriv : ψK₁ w₂ = 1 := by
        rw [hψK₁_app]
        apply hSpecB.1 (traceLM F hBK₁ w₂)
        rcases htr_val with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by change -nB ≤ valL F B (traceLM F hBK₁ w₂); omega)
      exact hw₂_ψ htriv
    omega

  
  let ϖ_B : Bˣ := Units.map (normLM F hBK₁) ϖ_K₁
  have hϖ_B_val : valL F B (ϖ_B : B) = 1 := by
    change valL F B (normLM F hBK₁ (ϖ_K₁ : K₁)) = 1
    rw [hval_norm (ϖ_K₁ : K₁), hϖ_K₁]
  have hnorm_zero : normLM F hBK₁ 0 = 0 := by
    by_contra h0
    have h1 : normLM F hBK₁ 0 = normLM F hBK₁ 0 * (ϖ_B : B) := by
      calc normLM F hBK₁ 0
        _ = normLM F hBK₁ (0 * (ϖ_K₁ : K₁)) := by rw [zero_mul]
        _ = normLM F hBK₁ 0 * normLM F hBK₁ (ϖ_K₁ : K₁) := map_mul (normLM F hBK₁) 0 (ϖ_K₁ : K₁)
        _ = normLM F hBK₁ 0 * (ϖ_B : B) := rfl
    have h2 : valL F B (normLM F hBK₁ 0) = valL F B (normLM F hBK₁ 0) + 1 := by
      conv_lhs => rw [h1]
      rw [hval_mul_B _ _ h0 (Units.ne_zero ϖ_B), hϖ_B_val]
    omega
  have hnorm_val_ge : ∀ (k : ℤ) (w : K₁),
      (w = 0 ∨ k ≤ valL F K₁ w) →
        (normLM F hBK₁ w = 0 ∨ k ≤ valL F B (normLM F hBK₁ w)) := by
    intro k w hw
    rcases hw with hw0 | hge
    · exact Or.inl (by rw [hw0, hnorm_zero])
    · right
      rw [hval_norm w]
      exact hge

  have hnorm_le : ∀ m ≤ u + 1, ∀ w ∈ unitGroup F K₁ m,
      Units.map (normLM F hBK₁) w ∈ unitGroup F B m := by
    intro m hm_le w hw
    by_cases hm0 : m = 0
    · subst hm0
      rw [hunit0_B]
      have hw0 : valL F K₁ (w : K₁) = 0 := (hunit0_K₁ w).mp hw
      change valL F B (normLM F hBK₁ (w : K₁)) = 0
      rw [hval_norm (w : K₁), hw0]
    · have hm_ge1 : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      let y : K₁ := (w : K₁) - 1
      have hy : y = 0 ∨ (m : ℤ) ≤ valL F K₁ y := by
        rcases (hunit_ge1_K₁ m hm_ge1 w).mp hw with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      have hw_eq : (w : K₁) = 1 + y := by dsimp [y]; ring
      obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp m hm_ge1 y hy
      have hz_m : z = 0 ∨ (m : ℤ) ≤ valL F K₁ z := hval_le_K₁ (by omega) hz
      have hyz_m : y + z = 0 ∨ (m : ℤ) ≤ valL F K₁ (y + z) := hval_add_K₁ (m : ℤ) y z hy hz_m
      have hyz_tr_in : y + z = 0 ∨
          (p : ℤ) * (m : ℤ) - ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) ≤ valL F K₁ (y + z) := by
        apply hval_le_K₁ _ hyz_m
        rw [hp_sub1_int, hu_add1_int]
        have hm_le_int : (m : ℤ) ≤ (u + 1 : ℤ) := by omega
        nlinarith
      have htr_m : traceLM F hBK₁ (y + z) = 0 ∨ (m : ℤ) ≤ valL F B (traceLM F hBK₁ (y + z)) :=
        htr_bound (m : ℤ) (y + z) hyz_tr_in
      have hny_m : normLM F hBK₁ y = 0 ∨ (m : ℤ) ≤ valL F B (normLM F hBK₁ y) :=
        hnorm_val_ge (m : ℤ) y hy
      have hsum_m := hval_add_B (m : ℤ) (traceLM F hBK₁ (y + z)) (normLM F hBK₁ y) htr_m hny_m
      have hsub_eq : (((Units.map (normLM F hBK₁) w : Bˣ) : B)) - 1 =
          traceLM F hBK₁ (y + z) + normLM F hBK₁ y := by
        change normLM F hBK₁ (w : K₁) - 1 = _
        rw [hw_eq, hnorm_eq]
        ring
      rw [hunit_ge1_B m hm_ge1, hsub_eq]
      rcases hsum_m with h0 | hge
      · left
        exact sub_eq_zero.mp (hsub_eq.trans h0)
      · exact Or.inr hge

  have hnorm_gt_surj : ∀ r ≥ u + 1, ∀ v ∈ unitGroup F B r,
      ∃ w ∈ unitGroup F K₁ (u + p * (r - u)),
        (Units.map (normLM F hBK₁) w) * v⁻¹ ∈ unitGroup F B (r + 1) := by
    intro r hr_ge v hv
    set N : ℕ := u + p * (r - u)
    have hru_ge1 : 1 ≤ r - u := by omega
    have hN_ge3 : 3 ≤ N := by
      dsimp [N]
      nlinarith
    have hN_ge1 : 1 ≤ N := by omega
    have hr_ge1 : 1 ≤ r := by omega
    by_cases hv1 : (v : B) = 1
    · have hv_eq1 : v = 1 := Units.ext hv1
      refine ⟨1, Subgroup.one_mem _, ?_⟩
      rw [hv_eq1, map_one, inv_one, mul_one]
      exact Subgroup.one_mem _
    · let x₀ : B := (v : B) - 1
      have hx₀_ne : x₀ ≠ 0 := sub_ne_zero.mpr hv1
      have hx₀_val : (r : ℤ) ≤ valL F B x₀ :=
        ((hunit_ge1_B r hr_ge1 v).mp hv).resolve_left hv1
      obtain ⟨y₀, hy₀_tr, _, hy₀_nz⟩ := htr_surj x₀
      obtain ⟨hy₀_ne, hy₀_val⟩ := hy₀_nz hx₀_ne
      have hN_int : (N : ℤ) =
          (p : ℤ) * (r : ℤ) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (u + 1 : ℤ) := by
        dsimp [N]
        have hru_eq : ((r - u : ℕ) : ℤ) = (r : ℤ) - (u : ℤ) := by omega
        rw [hp_sub1_int]
        push_cast
        rw [hru_eq]
        ring
      have hy₀_geN : (N : ℤ) ≤ valL F K₁ y₀ := by
        change valL F K₁ y₀ =
          (p : ℤ) * valL F B x₀ + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (u + 1 : ℤ) at hy₀_val
        rw [hy₀_val, hN_int]
        nlinarith
      have h1y₀_ne : 1 + y₀ ≠ 0 :=
        h1_add_ne_zero_K₁ (Or.inr (by omega))
      let w : K₁ˣ := Units.mk0 (1 + y₀) h1y₀_ne
      have hw_mem : w ∈ unitGroup F K₁ N := by
        rw [hunit_ge1_K₁ N hN_ge1 w]
        right
        have hsub : (w : K₁) - 1 = y₀ := by change (1 + y₀) - 1 = y₀; ring
        rw [hsub]
        exact hy₀_geN
      obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp N hN_ge1 y₀ (Or.inr hy₀_geN)
      have hz_tr_in : z = 0 ∨
          (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) ≤ valL F K₁ z := by
        apply hval_le_K₁ _ hz
        have hM_eq : (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * ((u + 1 : ℕ) : ℤ) =
            (N : ℤ) + 1 := by
          rw [hu_add1_int, hN_int, hp_sub1_int]
          push_cast
          ring
        rw [hM_eq]
        omega
      have htr_z := htr_bound ((r + 1 : ℕ) : ℤ) z hz_tr_in
      have hr1_le_N : ((r + 1 : ℕ) : ℤ) ≤ (N : ℤ) := by
        dsimp [N]
        have hru_eq : ((r - u : ℕ) : ℤ) = (r : ℤ) - (u : ℤ) := by omega
        have hru_int : (1 : ℤ) ≤ ((r - u : ℕ) : ℤ) := by omega
        push_cast
        nlinarith
      have hny₀_r1 : normLM F hBK₁ y₀ = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F B (normLM F hBK₁ y₀) :=
        hnorm_val_ge ((r + 1 : ℕ) : ℤ) y₀ (Or.inr (le_trans hr1_le_N hy₀_geN))
      have hsum_r1 := hval_add_B ((r + 1 : ℕ) : ℤ)
        (traceLM F hBK₁ z) (normLM F hBK₁ y₀) htr_z hny₀_r1
      have hnw_sub_v : ((Units.map (normLM F hBK₁) w : Bˣ) : B) - (v : B) =
          traceLM F hBK₁ z + normLM F hBK₁ y₀ := by
        change normLM F hBK₁ (1 + y₀) - (v : B) = _
        have hv_eq' : (v : B) = 1 + x₀ := by dsimp [x₀]; ring
        rw [hv_eq', hnorm_eq, map_add (traceLM F hBK₁) y₀ z, hy₀_tr]
        ring
      have hv_inv_val0 : valL F B (((v⁻¹ : Bˣ) : B)) = 0 := by
        rw [hval_inv_B v, hunit_val0_B r v hv, neg_zero]
      have hprod_sub : ((((Units.map (normLM F hBK₁) w) * v⁻¹ : Bˣ) : B)) - 1 =
          (((Units.map (normLM F hBK₁) w : Bˣ) : B) - (v : B)) * (((v⁻¹ : Bˣ) : B)) := by
        change ((Units.map (normLM F hBK₁) w : Bˣ) : B) * (((v⁻¹ : Bˣ) : B)) - 1 = _
        rw [sub_mul, Units.mul_inv]
      refine ⟨w, hw_mem, ?_⟩
      rw [hunit_ge1_B (r + 1) (by omega)]
      rw [← hnw_sub_v] at hsum_r1
      have hmul := hval_mul_ge_B ((r + 1 : ℕ) : ℤ) 0
        (((Units.map (normLM F hBK₁) w : Bˣ) : B) - (v : B)) (((v⁻¹ : Bˣ) : B))
        hsum_r1 (Or.inr (by omega))
      rw [add_zero, ← hprod_sub] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge

  have hstep_triv : ∀ r ≥ u + 1,
      (∀ v ∈ unitGroup F B (r + 1), ξB v = 1) →
        (∀ v₀ ∈ unitGroup F B r, ξB v₀ = 1) := by
    intro r hr_ge htriv_r1 v₀ hv₀
    obtain ⟨w, _, hrem⟩ := hnorm_gt_surj r hr_ge v₀ hv₀
    set v : Bˣ := (Units.map (normLM F hBK₁) w) * v₀⁻¹
    have hv1 : ξB v = 1 := htriv_r1 v hrem
    have hnw1 : ξB (Units.map (normLM F hBK₁) w) = 1 := hξB_norm w
    have hv₀_eq : v₀ = v⁻¹ * Units.map (normLM F hBK₁) w := by
      dsimp [v]
      rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
    rw [hv₀_eq, map_mul, map_inv, hv1, hnw1, inv_one, one_mul]
  have hdesc_triv : ∀ k : ℕ,
      (∀ v ∈ unitGroup F B (u + 1 + k), ξB v = 1) →
        (∀ v₀ ∈ unitGroup F B (u + 1), ξB v₀ = 1) := by
    intro k
    induction k with
    | zero =>
      intro h
      simpa using h
    | succ k ih =>
      intro h
      apply ih
      exact hstep_triv (u + 1 + k) (by omega) h
  have hcond_le : condExp F B ξB ≤ u + 1 := by
    set b : ℕ := condExp F B ξB
    have hb_triv : ∀ v ∈ unitGroup F B b, ξB v = 1 := hξB_triv
    rcases le_or_gt b (u + 1) with hle | hgt
    · exact hle
    · have hb_eq : b = u + 1 + (b - (u + 1)) := by omega
      rw [hb_eq] at hb_triv
      have htriv_u1 := hdesc_triv (b - (u + 1)) hb_triv
      exact Nat.sInf_le htriv_u1

  
  let fromExtendScalars : K₁' →+* K₁ :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hBK₁).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let φ_act : G_K₁ → (K₁ →+* K₁) := fun γ =>
    { toFun := act_K₁ γ
      map_one' := (hact_ring γ).2.1
      map_mul' := fun w₁ w₂ => ((hact_ring γ).2.2 w₁ w₂).2.1
      map_zero' := (hact_ring γ).1
      map_add' := fun w₁ w₂ => ((hact_ring γ).2.2 w₁ w₂).1 }
  let φ_G : G_K₁ → (K₁' →ₐ[B] K₁') := fun γ =>
    { (toExtendScalars F hBK₁).comp ((φ_act γ).comp fromExtendScalars) with
      commutes' := fun y => by
        change toExtendScalars F hBK₁ (act_K₁ γ (IntermediateField.inclusion hBK₁ y)) =
          algebraMap B K₁' y
        rw [hact_incl γ y]
        rfl }
  have hφG_inj : Function.Injective φ_G := by
    intro γ₁ γ₂ h_eq
    have h1 : γ₁ * γ₂⁻¹ = 1 := by
      apply hact_faithful (γ₁ * γ₂⁻¹)
      intro w
      have h_app : φ_G γ₁ (toExtendScalars F hBK₁ (act_K₁ γ₂⁻¹ w)) =
          φ_G γ₂ (toExtendScalars F hBK₁ (act_K₁ γ₂⁻¹ w)) :=
        congrArg (fun f : K₁' →ₐ[B] K₁' => f (toExtendScalars F hBK₁ (act_K₁ γ₂⁻¹ w))) h_eq
      have h_from : act_K₁ γ₁ (act_K₁ γ₂⁻¹ w) = act_K₁ γ₂ (act_K₁ γ₂⁻¹ w) :=
        congrArg fromExtendScalars h_app
      rw [← hact_mul, ← hact_mul, mul_inv_cancel, hact_one] at h_from
      exact h_from
    exact mul_inv_eq_one.mp h1
  have hcard_le1 : Fintype.card G_K₁ ≤ Fintype.card (K₁' →ₐ[B] K₁') :=
    Fintype.card_le_of_injective φ_G hφG_inj
  have hcard_le2 : Fintype.card (K₁' →ₐ[B] K₁') ≤ p := @AlgHom.card_le B K₁' _ _ _ _
  have hcard_eq : Fintype.card G_K₁ = Fintype.card (K₁' →ₐ[B] K₁') := by omega
  have hφG_bij : Function.Bijective φ_G :=
    (Fintype.bijective_iff_injective_and_card φ_G).mpr ⟨hφG_inj, hcard_eq⟩

  have hτ_lift_filt : ∀ τ_lift : K₁ ≃ₐ[F] K₁,
      (∀ y : B, τ_lift (IntermediateField.inclusion hBK₁ y) =
        IntermediateField.inclusion hBK₁ y) →
      (∃ w₀ : K₁, τ_lift w₀ ≠ w₀) →
      ∀ m ≤ u, (Units.map τ_lift.toRingEquiv.toMonoidHom ϖ_K₁) * ϖ_K₁⁻¹ ∈ unitGroup F K₁ m := by
    intro τ_lift hτ_B ⟨w₀, hw₀_ne⟩ m hm_le
    let f_τ : K₁' →ₐ[B] K₁' :=
      { (toExtendScalars F hBK₁).comp (τ_lift.toRingEquiv.toRingHom.comp fromExtendScalars) with
        commutes' := fun y => by
          change toExtendScalars F hBK₁ (τ_lift (IntermediateField.inclusion hBK₁ y)) =
            algebraMap B K₁' y
          rw [hτ_B y]
          rfl }
    obtain ⟨γ, hγ_eq⟩ := hφG_bij.2 f_τ
    have hτ_act : ∀ w : K₁, τ_lift w = act_K₁ γ w := by
      intro w
      have h1 : φ_G γ (toExtendScalars F hBK₁ w) = f_τ (toExtendScalars F hBK₁ w) :=
        congrArg (fun f : K₁' →ₐ[B] K₁' => f (toExtendScalars F hBK₁ w)) hγ_eq
      exact (congrArg fromExtendScalars h1).symm
    have hγ_ne1 : γ ≠ 1 := by
      intro hγ1
      apply hw₀_ne
      rw [hτ_act w₀, hγ1, hact_one w₀]
    obtain ⟨_, hδ_val⟩ := hjump γ hγ_ne1
    let w_τ : K₁ˣ := (Units.map τ_lift.toRingEquiv.toMonoidHom ϖ_K₁) * ϖ_K₁⁻¹
    have hw_τ_sub : (w_τ : K₁) - 1 =
        -(((ϖ_K₁ : K₁) - act_K₁ γ (ϖ_K₁ : K₁)) * (((ϖ_K₁⁻¹ : K₁ˣ) : K₁))) := by
      change τ_lift (ϖ_K₁ : K₁) * (((ϖ_K₁⁻¹ : K₁ˣ) : K₁)) - 1 = _
      rw [hτ_act (ϖ_K₁ : K₁), sub_mul, Units.mul_inv]
      ring
    have hneg_δ_val : -((ϖ_K₁ : K₁) - act_K₁ γ (ϖ_K₁ : K₁)) = 0 ∨
        (u + 1 : ℤ) ≤ valL F K₁ (-((ϖ_K₁ : K₁) - act_K₁ γ (ϖ_K₁ : K₁))) := by
      right
      rw [hval_neg_K₁, hδ_val]
    have hϖ_inv_val : (((ϖ_K₁⁻¹ : K₁ˣ) : K₁)) = 0 ∨
        (-1 : ℤ) ≤ valL F K₁ (((ϖ_K₁⁻¹ : K₁ˣ) : K₁)) := by
      right
      rw [hval_inv_K₁ ϖ_K₁, hϖ_K₁]
    have hmul_val := hval_mul_ge_K₁ (u + 1 : ℤ) (-1 : ℤ)
      (-((ϖ_K₁ : K₁) - act_K₁ γ (ϖ_K₁ : K₁))) (((ϖ_K₁⁻¹ : K₁ˣ) : K₁))
      hneg_δ_val hϖ_inv_val
    rw [neg_mul, ← hw_τ_sub] at hmul_val
    have hw_τ_u : w_τ ∈ unitGroup F K₁ u := by
      rw [hunit_ge1_K₁ u hu_ge1 w_τ]
      rcases hmul_val with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · right
        omega
    exact hunit_anti_K₁ hm_le hw_τ_u

  exact ⟨u, G_K₁, instGroupGK₁, instFintypeGK₁, act_K₁, y₁_K₁,
    hu_ge1, hcard_G, hact_one, hact_mul, hact_ring,
    hact_incl, hact_val, hact_trace, hact_norm, hjump,
    hy₁_tr, hy₁_ne0, hy₁_val, htr_bound, hnK₁, hcond_le, hnorm_le, hτ_lift_filt⟩

theorem ld_ch12_wild_odd_tot_ram_four_edge_cond_val_and_jump_package (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (χ₁ : M₁'ˣ →* (Ω F)ˣ) (χ₂ : E'ˣ →* (Ω F)ˣ)
    (hχ₂_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
      (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y))
    (hχ₁_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
