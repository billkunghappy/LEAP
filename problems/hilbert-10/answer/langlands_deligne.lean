    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m)
    (hGauss : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)) (χ_M : Mˣ →* (Ω F)ˣ),
      condExp F M χ_M = 1 →
      valL F M ((tateElt F M χ_M ψ_M : Mˣ) : M) =
        (condExp F M χ_M : ℤ) + condExpChar F M ψ_M →
      Set.Finite {u : Mˣ ⧸ unitGroup F M (condExp F M χ_M) |
        valL F M ((cosetRep u : Mˣ) : M) = 0} →
      (valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
        (∀ x : M, valL F M (-x) = valL F M x) ∧
        (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
        (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
        (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
          u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
        (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0)) →
      ∀ (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M),
        resM 0 = 0 → resM 1 = 1 →
        (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
          resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
          resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
          resM (-x₁) = -resM x₁) →
        (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
          (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) →
        (∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a) →
        ∀ (c_M : Mˣ), valL F M (c_M : M) = 1 + condExpChar F M ψ_M →
        ∀ (χ_tilde ψ_tilde : k_M → Ω F),
          χ_tilde 0 = 0 →
          (∀ u : Mˣ, valL F M (u : M) = 0 → χ_tilde (resM (u : M)) = (χ_M u : Ω F)⁻¹) →
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            ψ_tilde (resM x) = ψ_M (((c_M⁻¹ : Mˣ) : M) * x)) →
          tateEps F M χ_M ψ_M =
            (qL F M : Ω F) ^ condExpChar F M ψ_M * (χ_M c_M : Ω F) *
              (∑ a : k_M, χ_tilde a * ψ_tilde a))
    (hStatL : ∀ (θ : Lˣ →* (Ω F)ˣ), 2 ≤ condExp F L θ →
      let m := condExp F L θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Lˣ,
        valL F L (c_θ : L) = (m : ℤ) + condExpChar F L ψ ∧
        ∀ x : L, (x = 0 ∨ (r₀ : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_θ⁻¹ : Lˣ) : L) * x)) ∧
      (∀ (c : Lˣ),
        valL F L (c : L) = (m : ℤ) + condExpChar F L ψ →
        (∀ x : L, (x = 0 ∨ (r₀ : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c⁻¹ : Lˣ) : L) * x)) →
        ∀ (ν : Lˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F L d, ν u = 1) →
          condExp F L (ν * θ) = m ∧
          tateEps F L (ν * θ) ψ = (ν c : Ω F) * tateEps F L θ ψ)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  obtain ⟨c_τ, hc_τ_val, hc_τ_stat⟩ := (hStatL ν₁ hb_ge2).1
  have hprod_twist :=
    ld_wild_cond_one_stable_twist_prod F L K hLK hPrime ψ ν₁ χ' hχ'_cond hb_ge2 hν_cond_eq ha1
      hvalL_props hvalK_props.2.1 k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
      t ht_ge1 htr_bound hStatL c_τ hc_τ_val hc_τ_stat
  obtain ⟨resK, hresK_0, hresK_1, hresK_ring, hresK_ker, hresK_surj, _, hresK_lift, hresK_norm⟩ :=
    ld_wild_power_basis_residue_bridge F L K hLK hPrime hval_norm hval_alg hvalL_props hvalK_props
      ϖ_K hϖ_K hBasis k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj t ht_ge1 hnorm_le
  obtain ⟨c_K, hc_K_val, hc_K_norm, hc_K_psi⟩ :=
    ld_wild_cond_one_trace_dual_and_frob_shift F L K hLK hPrime ψ ν₁ χ' hν₁_ker hval_norm hval_alg
      hfrob_surj hnK ha1 hvalL_props hvalK_props hSpecL ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      resK hresK_ker hresK_lift hresK_norm t ht_ge1 hb_eq htr_bound htr_surj hnorm_exp
      c_τ hc_τ_val hc_τ_stat
  have hgauss_eq :=
    ld_wild_cond_one_gauss_frob_comparison F L K hLK hPrime ψ ν₁ χ' hχ'_cond hqK hval_norm
      hfrob_surj ha1 haK hvalL_props hvalK_props hSpecL hSpecK hFinL1 hFinK1
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      resK hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj hresK_norm hGauss
      ((-1 : Lˣ) * c_τ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1))
      c_K hc_K_val hc_K_norm hc_K_psi
  have h0_mem : 0 ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)) :=
    Finset.mem_range.mpr hPrime.pos
  have hν0 : ν₁ ^ (0 : ℕ) = 1 := pow_zero ν₁
  have hν0_χ : ν₁ ^ (0 : ℕ) * χ' = χ' := (congr_arg (· * χ') hν0).trans (one_mul χ')
  have hprod1 : (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
      tateEps F L (ν₁ ^ j) ψ) =
      tateEps F L 1 ψ *
        ∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          tateEps F L (ν₁ ^ j) ψ := by
    rw [← Finset.mul_prod_erase (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)))
          (fun j => tateEps F L (ν₁ ^ j) ψ) h0_mem]
    exact congr_arg (· * _) (congr_arg (fun θ => tateEps F L θ ψ) hν0)
  have hprod2 : (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
      tateEps F L (ν₁ ^ j * χ') ψ) =
      tateEps F L χ' ψ *
        ∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          tateEps F L (ν₁ ^ j * χ') ψ := by
    rw [← Finset.mul_prod_erase (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)))
          (fun j => tateEps F L (ν₁ ^ j * χ') ψ) h0_mem]
    exact congr_arg (· * _) (congr_arg (fun θ => tateEps F L θ ψ) hν0_χ)
  rw [hprod1, hprod2, hprod_twist]
  calc
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
        (tateEps F L 1 ψ *
          ∏ x ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
            tateEps F L (ν₁ ^ x) ψ) =
      (tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) * tateEps F L 1 ψ) *
        ∏ x ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          tateEps F L (ν₁ ^ x) ψ := by ring
    _ = (tateEps F K 1 (traceChar F hLK ψ) * tateEps F L χ' ψ *
          (χ' ((-1 : Lˣ) * c_τ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) : Ω F)) *
        ∏ x ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          tateEps F L (ν₁ ^ x) ψ := by rw [hgauss_eq]
    _ = tateEps F K 1 (traceChar F hLK ψ) *
        (tateEps F L χ' ψ *
          ((χ' ((-1 : Lˣ) * c_τ ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) : Ω F) *
            ∏ x ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
              tateEps F L (ν₁ ^ x) ψ)) := by ring

theorem ld_wild_low_cond_res_finsets_and_teichmuller_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
