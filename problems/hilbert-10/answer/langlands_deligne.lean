        (fun p _ => γ_m d hd_ge1 p.1 * p.2)
        (fun u _ => (π_m d u, (γ_m d hd_ge1 (π_m d u))⁻¹ * u))
      · intro p hp; exact hbij_hi hd_ge1 hd1_le_a p hp
      · intro u hu; exact hbij_hj hd_ge1 hd1_le_a u hu
      · intro p hp; exact hbij_left_inv hd_ge1 hd1_le_a p hp
      · intro u _; exact hbij_right_inv hd_ge1 u
      · intro p hp
        have hp2_e : p.2 ∈ H e := by
          rw [← congrArg H he_eq]
          exact (Finset.mem_product.mp hp).2
        rw [hf_mul_He (hγ_m_mem hd_ge1 hd_le_a p.1) hp2_e, hf_γ p.1]
    rw [← hsum_bij, Finset.sum_product]
    have hinner : ∀ b ∈ (Finset.univ : Finset k_M),
        (∑ _h ∈ H (d + 1), Q_M b) = ((H e).card : Ω F) * Q_M b := by
      intro b _
      rw [congrArg H he_eq, Finset.sum_const, nsmul_eq_mul]
    rw [Finset.sum_congr rfl hinner, ← Finset.mul_sum, hHe_card, Nat.cast_pow]

theorem ld_cond_ge_two_odd_quadratic_poly_lam (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (χ' : Lˣ →* (Ω F)ˣ)
    (d : ℕ) (hd : 1 ≤ d) (hcond_odd : condExp F L χ' = 2 * d + 1)
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L χ' ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1)) ∧
      valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hvalL_props : valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (ϖ c_L : Lˣ) (hϖ : valL F L (ϖ : L) = 1)
    (hc_L_val : valL F L (c_L : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_L_stat : ∀ w ∈ unitGroup F L (condExp F L χ' - condExp F L χ' / 2),
      (χ' w : Ω F) = ψ (((c_L⁻¹ : Lˣ) : L) * ((w : L) - 1))) :
    ∃ (Q_L : k_L → Ω F) (ψ_0 : k_L → Ω F) (lam₂ : Polynomial k_L → Ω F),
      (∀ (x : L) (hx_int : x = 0 ∨ 0 ≤ valL F L x)
        (hx_ne : 1 + ((ϖ ^ d : Lˣ) : L) * x ≠ 0),
        Q_L (resL x) =
          (χ' (Units.mk0 (1 + ((ϖ ^ d : Lˣ) : L) * x) hx_ne) : Ω F)⁻¹ *
            ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * x)) ∧
      (∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
        ψ_0 (resL x) = ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * x)) ∧
      (∀ f : Polynomial k_L,
        lam₂ f = Q_L (-f.nextCoeff) *
          ψ_0 (-(if f.natDegree < 2 then 0 else f.coeff (f.natDegree - 2)))) ∧
      (∀ x : k_L, lam₂ (Polynomial.X - Polynomial.C x) = Q_L x) ∧
      lam₂ 1 = 1 ∧
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → lam₂ (f * g) = lam₂ f * lam₂ g) ∧
      (∀ (k : ℕ), 2 ≤ k →
        (∑ c : Fin k → k_L,
          lam₂ (Polynomial.X ^ k + ∑ i : Fin k, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalL_props
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, hχ'_spec, _⟩ := hSpecL
  set a : ℕ := condExp F L χ'
  set n_L : ℤ := condExpChar F L ψ
  have ha_ne0 : a ≠ 0 := by omega
  have ha_ge1 : 1 ≤ a := by omega
  have hχ'_triv : ∀ u ∈ unitGroup F L a, χ' u = 1 := (hχ'_spec ha_ne0).1
  have he_eq : a - a / 2 = d + 1 := by omega
  have hc_stat' : ∀ w ∈ unitGroup F L (d + 1),
      (χ' w : Ω F) = ψ (((c_L⁻¹ : Lˣ) : L) * ((w : L) - 1)) := by
    intro w hw
    exact hc_L_stat w (he_eq.symm ▸ hw)
  have hϖ_pow : ∀ m : ℕ, valL F L ((ϖ ^ m : Lˣ) : L) = (m : ℤ) := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero, Units.val_one, Nat.cast_zero]
      exact hval1
    | succ m ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul _ _ (Units.ne_zero (ϖ ^ m)) (Units.ne_zero ϖ), ih, hϖ]
      push_cast
      ring
  have hval_mul_bound : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' : k₁ ≤ valL F L x := hx.resolve_left hx0
        have hy' : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hval_ϖm_mul : ∀ (m : ℕ) (k : ℤ) (z : L),
      (z = 0 ∨ k ≤ valL F L z) →
      (((ϖ ^ m : Lˣ) : L) * z = 0 ∨ (m : ℤ) + k ≤ valL F L (((ϖ ^ m : Lˣ) : L) * z)) := by
    intro m k z hz
    exact hval_mul_bound (m : ℤ) k ((ϖ ^ m : Lˣ) : L) z (Or.inr (by rw [hϖ_pow m])) hz
  have hone_add_ne : ∀ (m : ℕ), 1 ≤ m → ∀ (z : L),
      (z = 0 ∨ (m : ℤ) ≤ valL F L z) → 1 + z ≠ 0 := by
    intro m hm z hz h0
    have hz_neg1 : z = -1 := eq_neg_of_add_eq_zero_right h0
    rcases hz with rfl | hge
    · rw [add_zero] at h0
      exact one_ne_zero h0
    · rw [hz_neg1, hval_neg1] at hge
      omega
  have hunit_one_add : ∀ (m : ℕ) (hm : 1 ≤ m) (z : L)
      (hz : z = 0 ∨ (m : ℤ) ≤ valL F L z),
      Units.mk0 (1 + z) (hone_add_ne m hm z hz) ∈ unitGroup F L m := by
    intro m hm z hz
    rw [hunit_ge1 m hm]
    rcases hz with rfl | hge
    · left
      change 1 + (0 : L) = 1
      exact add_zero 1
    · right
      change (m : ℤ) ≤ valL F L ((1 + z) - 1)
      rw [add_sub_cancel_left]
      exact hge
  have hψ_c_triv : ∀ (y : L), (y = 0 ∨ (a : ℤ) ≤ valL F L y) →
      ψ (((c_L⁻¹ : Lˣ) : L) * y) = 1 := by
    intro y hy
    apply hψ_triv
    by_cases hy0 : y = 0
    · left; rw [hy0, mul_zero]
    · right
      have hy_ge : (a : ℤ) ≤ valL F L y := hy.resolve_left hy0
      rw [hval_mul ((c_L⁻¹ : Lˣ) : L) y (Units.ne_zero c_L⁻¹) hy0,
        hval_inv c_L, hc_L_val]
      omega
  set s_L : k_L → L := fun b => (hresL_surj b).choose
  have hs_L_int : ∀ b : k_L, s_L b = 0 ∨ 0 ≤ valL F L (s_L b) :=
    fun b => (hresL_surj b).choose_spec.1
  have hs_L_res : ∀ b : k_L, resL (s_L b) = b :=
    fun b => (hresL_surj b).choose_spec.2
  have hx_d_val : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
      (((ϖ ^ d : Lˣ) : L) * x = 0 ∨ (d : ℤ) ≤ valL F L (((ϖ ^ d : Lˣ) : L) * x)) := by
    intro x hx
    have h := hval_ϖm_mul d 0 x hx
    rwa [add_zero] at h
  have hx_d_ne : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
      1 + ((ϖ ^ d : Lˣ) : L) * x ≠ 0 :=
    fun x hx => hone_add_ne d hd (((ϖ ^ d : Lˣ) : L) * x) (hx_d_val x hx)
  set Q_L : k_L → Ω F := fun b =>
    (χ' (Units.mk0 (1 + ((ϖ ^ d : Lˣ) : L) * s_L b)
      (hx_d_ne (s_L b) (hs_L_int b))) : Ω F)⁻¹ *
      ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * s_L b)
  set ψ_0 : k_L → Ω F := fun b =>
    ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * s_L b)
  set c₂ : Polynomial k_L → k_L := fun f =>
    if f.natDegree < 2 then 0 else f.coeff (f.natDegree - 2)
  set lam₂ : Polynomial k_L → Ω F := fun f =>
    Q_L (-f.nextCoeff) * ψ_0 (-c₂ f)
  have hneg_int : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) → (-x = 0 ∨ 0 ≤ valL F L (-x)) := by
    intro x hx
    rcases hx with rfl | hge
    · left; exact neg_zero
    · right; rw [hval_neg]; exact hge
  have hres_sub_val1 : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
      (x - s_L (resL x) = 0 ∨ 1 ≤ valL F L (x - s_L (resL x))) := by
    intro x hx_int
    set b : k_L := resL x
    set δ : L := x - s_L b
    have hδ_int : δ = 0 ∨ 0 ≤ valL F L δ := by
      dsimp only [δ]
      rw [sub_eq_add_neg]
      exact hval_add 0 x (-(s_L b)) hx_int (hneg_int (s_L b) (hs_L_int b))
    have hδ_res : resL δ = 0 := by
      dsimp only [δ]
      rw [sub_eq_add_neg,
        (hresL_ring x (-(s_L b)) hx_int (hneg_int (s_L b) (hs_L_int b))).1,
        (hresL_ring (s_L b) (s_L b) (hs_L_int b) (hs_L_int b)).2.2,
        hs_L_res b]
      exact add_neg_cancel b
    exact (hresL_ker δ hδ_int).mp hδ_res
  have hψ_0_int : ∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_0 (resL x) = ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * x) := by
    intro x hx_int
    set b : k_L := resL x
    set δ : L := x - s_L b
    have hδ1 : δ = 0 ∨ 1 ≤ valL F L δ := hres_sub_val1 x hx_int
    set y : L := ((ϖ ^ (2 * d) : Lˣ) : L) * δ
    have hy_val : y = 0 ∨ (a : ℤ) ≤ valL F L y := by
      have h := hval_ϖm_mul (2 * d) 1 δ hδ1
      rcases h with h0 | hge
      · left; exact h0
      · right; dsimp only [y]; omega
    have hψ_y : ψ (((c_L⁻¹ : Lˣ) : L) * y) = 1 := hψ_c_triv y hy_val
    have h_decomp : ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * x =
        ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * s_L b + ((c_L⁻¹ : Lˣ) : L) * y := by
      dsimp only [y, δ]
      ring
    dsimp only [ψ_0]
    rw [h_decomp, ψ.map_add_eq_mul, hψ_y, mul_one]
  have hψ_0_zero : ψ_0 0 = 1 := by
    rw [← hresL_0, hψ_0_int 0 (Or.inl rfl), mul_zero, ψ.map_zero_eq_one]
  have hψ_0_add : ∀ b₁ b₂ : k_L, ψ_0 (b₁ + b₂) = ψ_0 b₁ * ψ_0 b₂ := by
    intro b₁ b₂
    have hab_int : s_L b₁ + s_L b₂ = 0 ∨ 0 ≤ valL F L (s_L b₁ + s_L b₂) :=
      hval_add 0 (s_L b₁) (s_L b₂) (hs_L_int b₁) (hs_L_int b₂)
    have hab_res : resL (s_L b₁ + s_L b₂) = b₁ + b₂ := by
      rw [(hresL_ring (s_L b₁) (s_L b₂) (hs_L_int b₁) (hs_L_int b₂)).1,
        hs_L_res b₁, hs_L_res b₂]
    rw [← hab_res, hψ_0_int (s_L b₁ + s_L b₂) hab_int, mul_add, ψ.map_add_eq_mul]
  have hQ_L_int : ∀ (x : L) (hx_int : x = 0 ∨ 0 ≤ valL F L x)
      (hx_ne : 1 + ((ϖ ^ d : Lˣ) : L) * x ≠ 0),
      Q_L (resL x) =
        (χ' (Units.mk0 (1 + ((ϖ ^ d : Lˣ) : L) * x) hx_ne) : Ω F)⁻¹ *
          ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * x) := by
    intro x hx_int hx_ne
    set b : k_L := resL x
    set s : L := s_L b
    set δ : L := x - s
    have hδ1 : δ = 0 ∨ 1 ≤ valL F L δ := hres_sub_val1 x hx_int
    set u_x : Lˣ := Units.mk0 (1 + ((ϖ ^ d : Lˣ) : L) * x) hx_ne
    set u_s : Lˣ := Units.mk0 (1 + ((ϖ ^ d : Lˣ) : L) * s) (hx_d_ne s (hs_L_int b))
    have hu_s_mem : u_s ∈ unitGroup F L d :=
      hunit_one_add d hd (((ϖ ^ d : Lˣ) : L) * s) (hx_d_val s (hs_L_int b))
    have hu_s_val0 : valL F L (u_s : L) = 0 := hunit_val0 d u_s hu_s_mem
    have hu_s_inv_val0 : valL F L ((u_s⁻¹ : Lˣ) : L) = 0 := by
      rw [hval_inv u_s, hu_s_val0, neg_zero]
    set w : Lˣ := u_s⁻¹ * u_x
    have hu_s_inv_mul : ((u_s⁻¹ : Lˣ) : L) * (u_s : L) = 1 := by
      exact_mod_cast Units.inv_mul u_s
    have hw_sub : (w : L) - 1 = ((u_s⁻¹ : Lˣ) : L) * (((ϖ ^ d : Lˣ) : L) * δ) := by
      calc (w : L) - 1 = ((u_s⁻¹ : Lˣ) : L) * (u_x : L) - ((u_s⁻¹ : Lˣ) : L) * (u_s : L) := by
            rw [Units.val_mul, hu_s_inv_mul]
        _ = ((u_s⁻¹ : Lˣ) : L) * ((1 + ((ϖ ^ d : Lˣ) : L) * x) - (1 + ((ϖ ^ d : Lˣ) : L) * s)) := by
            change ((u_s⁻¹ : Lˣ) : L) * (1 + ((ϖ ^ d : Lˣ) : L) * x) -
              ((u_s⁻¹ : Lˣ) : L) * (1 + ((ϖ ^ d : Lˣ) : L) * s) = _
            ring
        _ = ((u_s⁻¹ : Lˣ) : L) * (((ϖ ^ d : Lˣ) : L) * δ) := by
            dsimp only [δ]
            ring
    have hw_sub_val : (w : L) - 1 = 0 ∨ (d + 1 : ℤ) ≤ valL F L ((w : L) - 1) := by
      rw [hw_sub]
      have h1 := hval_ϖm_mul d 1 δ hδ1
      have h2 := hval_mul_bound 0 ((d : ℤ) + 1) ((u_s⁻¹ : Lˣ) : L) (((ϖ ^ d : Lˣ) : L) * δ)
        (Or.inr (by omega)) h1
      rwa [zero_add] at h2
    have hw_mem : w ∈ unitGroup F L (d + 1) := by
      rw [hunit_ge1 (d + 1) (by omega) w]
      rcases hw_sub_val with h0 | hge
      · left; exact sub_eq_zero.mp h0
      · right; exact_mod_cast hge
    have hχ'_w_stat : (χ' w : Ω F) = ψ (((c_L⁻¹ : Lˣ) : L) * ((w : L) - 1)) :=
      hc_stat' w hw_mem
    have hπ2d_eq : ((ϖ ^ (2 * d) : Lˣ) : L) = ((ϖ ^ d : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) := by
      rw [← Units.val_mul, ← pow_add, two_mul]
    set y_err : L := - (((u_s⁻¹ : Lˣ) : L) * s * (((ϖ ^ (2 * d) : Lˣ) : L) * δ))
    have hy_err_eq : ((w : L) - 1) - ((ϖ ^ d : Lˣ) : L) * δ = y_err := by
      have hus_def : (u_s : L) = 1 + ((ϖ ^ d : Lˣ) : L) * s := rfl
      calc ((w : L) - 1) - ((ϖ ^ d : Lˣ) : L) * δ
          = (((u_s⁻¹ : Lˣ) : L) - 1) * (((ϖ ^ d : Lˣ) : L) * δ) := by
            rw [hw_sub]; ring
        _ = (((u_s⁻¹ : Lˣ) : L) - (((u_s⁻¹ : Lˣ) : L) * (u_s : L))) * (((ϖ ^ d : Lˣ) : L) * δ) := by
            rw [hu_s_inv_mul]
        _ = - (((u_s⁻¹ : Lˣ) : L) * s * ((((ϖ ^ d : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L)) * δ)) := by
            rw [hus_def]; ring
        _ = y_err := by
            dsimp only [y_err]
            rw [hπ2d_eq]
    have hy_err_val : y_err = 0 ∨ (a : ℤ) ≤ valL F L y_err := by
      have h_us_s : ((u_s⁻¹ : Lˣ) : L) * s = 0 ∨ 0 ≤ valL F L (((u_s⁻¹ : Lˣ) : L) * s) := by
        have h := hval_mul_bound 0 0 ((u_s⁻¹ : Lˣ) : L) s (Or.inr (by omega)) (hs_L_int b)
        rwa [add_zero] at h
      have h_2d_δ : ((ϖ ^ (2 * d) : Lˣ) : L) * δ = 0 ∨
          ((2 * d : ℕ) : ℤ) + 1 ≤ valL F L (((ϖ ^ (2 * d) : Lˣ) : L) * δ) :=
        hval_ϖm_mul (2 * d) 1 δ hδ1
      have h_prod := hval_mul_bound 0 (((2 * d : ℕ) : ℤ) + 1)
        (((u_s⁻¹ : Lˣ) : L) * s) (((ϖ ^ (2 * d) : Lˣ) : L) * δ) h_us_s h_2d_δ
      rcases h_prod with h0 | hge
      · left; dsimp only [y_err]; rw [h0, neg_zero]
      · right; dsimp only [y_err]; rw [hval_neg]; omega
    have hψ_err : ψ (((c_L⁻¹ : Lˣ) : L) * y_err) = 1 := hψ_c_triv y_err hy_err_val
    have hχ'_w : (χ' w : Ω F) = ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * δ) := by
      have h_split : ((c_L⁻¹ : Lˣ) : L) * ((w : L) - 1) =
          ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * δ + ((c_L⁻¹ : Lˣ) : L) * y_err := by
        rw [← hy_err_eq]; ring
      rw [hχ'_w_stat, h_split, ψ.map_add_eq_mul, hψ_err, mul_one]
    have hux_eq : u_s * w = u_x := mul_inv_cancel_left u_s u_x
    have hχ'_ux : (χ' u_x : Ω F)⁻¹ = (χ' u_s : Ω F)⁻¹ * (χ' w : Ω F)⁻¹ := by
      rw [← hux_eq, map_mul, Units.val_mul, mul_inv]
    have hψ_x : ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * x) =
        ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * s) * (χ' w : Ω F) := by
      have hx_eq : ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * x =
          ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * s +
            ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * δ := by
        dsimp only [δ]; ring
      rw [hx_eq, ψ.map_add_eq_mul, ← hχ'_w]
    have hcancel : (χ' w : Ω F)⁻¹ * (χ' w : Ω F) = 1 :=
      inv_mul_cancel₀ (Units.ne_zero (χ' w))
