    let N_fn : ℕ → R_M := fun m => nmM₁'K₁ (Δ_conj m)
    let B_fn : ℕ → R_M := fun m => nmM₁'K₁ (Δ_val + ξ_fn m)

    have hB_sub_b : ∀ m < p, 0 < m →
        (B_fn m - b = 0 ∨ (0 : ℤ) ≤ vM₁' (B_fn m - b)) ∧
