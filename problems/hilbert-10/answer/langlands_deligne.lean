                      ((c_ν⁻¹ : Lˣ) : L) * (u_frak * (y ^ 2 - y)) := by ring
                rw [hlin, AddChar.map_add_eq_mul, hψ_cy₀, hψ_as_triv y hy_int, mul_one]
          obtain ⟨hw_int, hw_res, hw_ψ⟩ := hw_rep_spec
          have hzw_int : z - w_rep = 0 ∨ 0 ≤ valL F L (z - w_rep) :=
            hvalL_sub 0 z w_rep hz hw_int
          have hzw_res0 : resL (z - w_rep) = 0 := by
            rw [hresL_sub z w_rep hz hw_int, hw_res, sub_self]
          have hzw_val1 : z - w_rep = 0 ∨ 1 ≤ valL F L (z - w_rep) :=
            (hresL_ker (z - w_rep) hzw_int).mp hzw_res0
          have huzw_T : u_frak * (z - w_rep) = 0 ∨ (T : ℤ) ≤ valL F L (u_frak * (z - w_rep)) := by
            have hm := hvalL_mul_ge ((T : ℤ) - 1) 1 u_frak (z - w_rep)
              (Or.inr (le_of_eq hu_val.symm)) hzw_val1
            exact hvalL_mono (by omega) hm
          have hψ_zw : ψ (((c_ν⁻¹ : Lˣ) : L) * (u_frak * (z - w_rep))) = 1 :=
            hψ_cν_triv (u_frak * (z - w_rep)) huzw_T
          have hz_split : ((c_ν⁻¹ : Lˣ) : L) * (u_frak * z) =
              ((c_ν⁻¹ : Lˣ) : L) * (u_frak * w_rep) +
                ((c_ν⁻¹ : Lˣ) : L) * (u_frak * (z - w_rep)) := by ring
          rw [hz_split, AddChar.map_add_eq_mul, hw_ψ, hψ_zw, mul_one]
        set z₁ : L := (c_ν : L) * u_frak⁻¹ * x₁
        have hu_inv_val : valL F L (u_frak⁻¹) = -((T : ℤ) - 1) := by
          rw [hvalL_inv0 u_frak hu_ne, hu_val]
        have hz₁_int : z₁ = 0 ∨ 0 ≤ valL F L z₁ := by
          have hm1 := hvalL_mul_ge ((T : ℤ) + n) (-((T : ℤ) - 1)) (c_ν : L) (u_frak⁻¹)
            (Or.inr (le_of_eq hc_ν_val.symm)) (Or.inr (le_of_eq hu_inv_val.symm))
          have hm2 := hvalL_mul_ge (((T : ℤ) + n) + (-((T : ℤ) - 1))) (-(n + 1))
            ((c_ν : L) * u_frak⁻¹) x₁ hm1 (Or.inr hx₁_val)
          exact hvalL_mono (by omega) hm2
        have hψ_z₁ : ψ (((c_ν⁻¹ : Lˣ) : L) * (u_frak * z₁)) = 1 :=
          hψ_all_int z₁ hz₁_int
        have hz₁_simp : ((c_ν⁻¹ : Lˣ) : L) * (u_frak * z₁) = x₁ := by
          change ((c_ν⁻¹ : Lˣ) : L) * (u_frak * ((c_ν : L) * u_frak⁻¹ * x₁)) = x₁
          calc ((c_ν⁻¹ : Lˣ) : L) * (u_frak * ((c_ν : L) * u_frak⁻¹ * x₁))
              = (u_frak * u_frak⁻¹) * (((c_ν⁻¹ : Lˣ) : L) * (c_ν : L)) * x₁ := by ring
            _ = 1 * 1 * x₁ := by rw [mul_inv_cancel₀ hu_ne, Units.inv_mul]
            _ = x₁ := by ring
        rw [hz₁_simp] at hψ_z₁
        exact hx₁_ψ hψ_z₁
    · exact hψ_cu_neg1

theorem ld_ch12_wild_dyadic_unramified_model_twist_and_stat_elements (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hUnramM₁' : condExp F L νM₁' = 0)
    (hνM₁'_val : ∀ x : Lˣ, (νM₁' x : Ω F) = (-1 : Ω F) ^ (valL F L (x : L)))
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hmE'_ge2 : 2 ≤ condExp F E' θE')
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' θE'), θE' u = 1)
    (hθM₁'_triv : ∀ u ∈ unitGroup F M₁' (condExp F M₁' θM₁'), θM₁' u = 1)
    (hCommonRest : ∀ x : Lˣ,
      θE' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) * νE' x =
      θM₁' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) * νM₁' x)
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnK₁_eq : condExpChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ) =
      condExpChar F E' (traceChar F hLE' ψ))
    (hξM₁'_pow : (νE'.comp (Units.map (normLM F hLM₁'))) ^ 2 = 1)
    (hξM₁'_ne : νE'.comp (Units.map (normLM F hLM₁')) ≠ 1)
    (hξM₁'_ker : ∀ z : M₁'ˣ,
      z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔
        (νE'.comp (Units.map (normLM F hLM₁'))) z = 1)
    (hξM₁'_cond : ∀ j < 2,
      ∀ u ∈ unitGroup F M₁' (condExp F M₁' ((νE'.comp (Units.map (normLM F hLM₁'))) ^ j)),
        ((νE'.comp (Units.map (normLM F hLM₁'))) ^ j) u = 1)
    (hξM₁'_cond_eq : condExp F M₁' (νE'.comp (Units.map (normLM F hLM₁'))) = condExp F L νE')
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = 2 * valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = 2 * valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = 2 * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_bound_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (d : M₁') (c : L) (σ_U : M₁' ≃ₐ[F] M₁') (σ_E : E' ≃ₐ[F] E')
    (hd_val : valL F M₁' d = 0) (hc_val : valL F L c = 0)
    (hd_tr : traceLM F hLM₁' d = 1) (hd_norm : normLM F hLM₁' d = -c)
    (hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c)
    (hσ_U_L : ∀ x : L,
      σ_U (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ_U_val : ∀ z : M₁', valL F M₁' (σ_U z) = valL F M₁' z)
    (hσ_U_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + σ_U z)
    (hσ_U_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * σ_U z)
    (hσ_U_twist : ∀ z : M₁'ˣ,
      θM₁' (Units.map σ_U.toRingEquiv.toMonoidHom z) =
        (νE'.comp (Units.map (normLM F hLM₁'))) z * θM₁' z)
    (hσ_E_L : ∀ x : L,
      σ_E (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ_E_val : ∀ y : E', valL F E' (σ_E y) = valL F E' y)
    (hσ_E_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ_E y)
    (hσ_E_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ_E y)
    (hσ_E_twist : ∀ y : E'ˣ,
      θE' (Units.map σ_E.toRingEquiv.toMonoidHom y) =
        (νM₁'.comp (Units.map (normLM F hLE'))) y * θE' y)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y)) :
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let mE' := condExp F E' θE'
    let h := mM₁' - T
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ (c_ν : Lˣ) (x : E') (C : K₁ˣ) (cM₁' : M₁'ˣ) (cE' : E'ˣ),
      let A := normLM F hLE' x
      (C : K₁) = IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d ∧
      valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ ∧
      (∀ u : L, (u = 0 ∨ (((T + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
        ∀ hu : 1 + u ≠ 0,
          (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u)) ∧
      valL F M₁' (cM₁' : M₁') = (mM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁', (z = 0 ∨ (((mM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) = ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z)) ∧
      valL F E' (cE' : E') = (mE' : ℤ) + condExpChar F E' ψE' ∧
      (∀ y : E', (y = 0 ∨ (((mE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
        ∀ hy : 1 + y ≠ 0,
          (θE' (Units.mk0 (1 + y) hy) : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * y)) ∧
      (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
          ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) =
        (-1 : Ω F) ^ T * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) *
          ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) ∧
      (h = 0 →
        (x = 0 ∨ 0 ≤ valL F E' x) ∧
        cM₁' = (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) *
          (Units.map (normLM F hM₁'K₁) C)⁻¹ ∧
        cE' = (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) *
          (Units.map (normLM F hE'K₁) C)⁻¹) ∧
      (0 < h →
        x ≠ 0 ∧
        valL F E' x = -(h : ℤ) ∧
        valL F L A = -(h : ℤ) ∧
        (∀ u : L, (u = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F L u) →
          ∀ hu : 1 + IntermediateField.inclusion hLM₁' u ≠ 0,
            (θM₁' (Units.mk0 (1 + IntermediateField.inclusion hLM₁' u) hu) : Ω F)⁻¹ *
              ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' u) = 1) ∧
        (∀ (δ_U : Lˣ) (r₁ r₂ : L),
          valL F L (δ_U : L) = ((mM₁' / 2 : ℕ) : ℤ) →
          (r₁ = 0 ∨ 0 ≤ valL F L r₁) →
          (r₂ = 0 ∨ 0 ≤ valL F L r₂) →
          ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') *
            IntermediateField.inclusion hLM₁' (((δ_U : L) ^ 2) * r₁ * r₂) * d) =
            ψ (((c_ν⁻¹ : Lˣ) : L) * A * ((δ_U : L) ^ 2) * r₁ * r₂)) ∧
        (T % 2 = 1 →
          ∀ v : E', (v = 0 ∨ ((mE' / 2 : ℕ) : ℤ) ≤ valL F E' v) →
            ∀ (hv : 1 + v ≠ 0) (hw : 1 + normLM F hLE' (x * v) ≠ 0),
              (θE' (Units.mk0 (1 + v) hv) : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * v) =
                ((νE' (Units.mk0 (1 + normLM F hLE' (x * v)) hw) : Ω F)⁻¹ *
                  ψ (((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' (x * v)))⁻¹)) :=
by
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalE' := ld_valL_and_unitGroup_props F E'
  obtain ⟨S₁_L, hS₁_L⟩ :=
    ld_valL_mod_one_finset F L hvalL.1 hvalL.2.2.2.1 hvalL.2.2.2.2.1 hvalL.2.2.2.2.2.2.2.1
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hk_L_field, hk_L_fin, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hvalL.1 hvalL.2.1 hvalL.2.2.1 hvalL.2.2.2.1
      hvalL.2.2.2.2.1 hvalL.2.2.2.2.2.1 hvalL.2.2.2.2.2.2.2.1 S₁_L hS₁_L
  letI : Field k_L := hk_L_field
  letI : Fintype k_L := hk_L_fin
  have hRam_E' : condExp F L νE' ≠ 0 := by omega
  obtain ⟨_, _, _, _, hval_alg_LE', hfrob_surj_L, _, hu₁_pow_LE', ϖ_E', ϖ_L,
    hϖ_norm, hϖ_E', hϖ_L, hBasis_E'⟩ :=
    ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hRam_E' hWild
      haddVal1 haddVal_mul halg1 hvalL hvalE'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨t, w_star, ht_ge1, hw_star_t, hw_star_nt1, hw_star_norm,
    htr_bound_E', htr_surj_E', hnorm_exp_E'⟩ :=
    ld_wild_galois_jump_and_euler_trace_formula F L E' hLE' hGalLE' hPrime hWild
      haddVal1 halg1 hvalL hvalE' hval_norm_LE' hval_alg_LE' ϖ_E' hϖ_E' hBasis_E'
  obtain ⟨hT_eq_t1, _, _, hnorm_surj_lt_E', _, _⟩ :=
    ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L E' hLE' hPrime νE'
      hνE'_ker hνE'_cond hvalL hvalE' hval_norm_LE' hval_alg_LE' hfrob_surj_L
      ϖ_E' ϖ_L hϖ_norm hϖ_E' hϖ_L hBasis_E'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t w_star ht_ge1 hw_star_t hw_star_nt1 hw_star_norm
      htr_bound_E' htr_surj_E' hnorm_exp_E'
  obtain ⟨y_tr1, hy_tr1_tr, _, hy_tr1_spec⟩ := htr_surj_E' 1
  have h1_ne0 : (1 : L) ≠ 0 := one_ne_zero
  obtain ⟨hy_tr1_ne, hy_tr1_val0⟩ := hy_tr1_spec h1_ne0
  have hy_tr1_val : valL F E' y_tr1 = 1 - (condExp F L νE' : ℤ) := by
    rw [hy_tr1_val0, hvalL.2.1, hdeg2, hT_eq_t1]
    push_cast
    ring
  have hnorm_surj_lt' : ∀ m < condExp F L νE' - 1, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F E' m,
        (Units.map (normLM F hLE') w) * u⁻¹ ∈ unitGroup F L (m + 1) := by
    intro m hm
    exact hnorm_surj_lt_E' m (by omega)
  obtain ⟨c_ν, x, C, cM₁', hC_eq, hc_ν_val, hc_ν_stat, hcM₁'_eq,
    hZM₁'_coe, hZE'_coe, hZE'_val, hcM₁'_val, hcM₁'_stat,
    hb_val, h2_val, hu_even, hu_odd, h9_zero, h9_pos⟩ :=
    ld_ch12_wild_dyadic_unramified_norm_rep_and_m1_stat F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' hdegE'K₁ hdegM₁'K₁
      ψ hψ hψM₁' νE' hνE'_pow hνE'_ker hνE'_cond hbE'_ge2
      θM₁' hmM₁'_ge2 hT_le hnM₁'_eq hξM₁'_cond hξM₁'_cond_eq
      hval_LM₁' hval_norm_LM₁' hval_LE' hval_norm_LE' hval_norm_E'K₁ hval_norm_M₁'K₁
      htr_bound_LM₁' htr_bound_LE' hDiamond_E' hDiamond_M₁'
      d c σ_U hd_val hc_val hd_tr hd_norm hd_sq
      hσ_U_L hσ_U_val hσ_U_tr hσ_U_twist hQuadNorm
      hu₁_pow_LE' ϖ_E' ϖ_L hϖ_norm hϖ_E' hϖ_L hBasis_E'
      y_tr1 hy_tr1_ne hy_tr1_tr hy_tr1_val hnorm_surj_lt'
  obtain ⟨cE', hcE'_val, hcE'_stat, hcE'_eq_zero, hMultPref, hTrDiff_zero, h10_pos⟩ :=
    ld_ch12_wild_dyadic_unramified_e_stat_and_crit_rec F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' hdegE'K₁ hdegM₁'K₁
      ψ hψ hψE' hψM₁' νE' νM₁' hνE'_pow hνE'_ker hνE'_cond hbE'_ge2 hνM₁'_val
      θE' θM₁' θK₁ hχE'_comp hχM₁'_comp hθE'_triv hCommonRest
      hT_le hmE'_eq hnM₁'_eq hnE'_eq hξM₁'_ker
      hval_LM₁' hval_norm_LM₁' hval_LE' hval_norm_LE' hval_E'K₁ hval_M₁'K₁
      htr_bound_LM₁' htr_bound_LE' hDiamond_E' hDiamond_M₁'
      d c σ_E hd_val hc_val hd_tr hd_norm hd_sq
      hσ_E_L hσ_E_val hσ_E_tr hσ_E_norm hσ_E_twist hQuadNorm
      c_ν x C cM₁' hc_ν_val hc_ν_stat hcM₁'_eq
      hZM₁'_coe hZE'_coe hZE'_val hcM₁'_stat hb_val
      (fun hh => (h9_zero hh).1)
      (fun hh => ⟨(h9_pos hh).1, (h9_pos hh).2.1, (h9_pos hh).2.2.1⟩)
  have hPrefactor :=
    ld_ch12_wild_dyadic_unramified_artin_schreier_prefactor_sign F L E' M₁'
      hLE' hLM₁' hdeg2 hdegM₁' ψ hψ νE' νM₁' hνE'_pow hνE'_ker hνE'_cond hbE'_ge2
      θE' θM₁' hT_le hval_norm_LM₁' hval_LE' hval_norm_LE' htr_bound_LM₁'
      d c σ_E hc_val hd_tr hd_norm hσ_E_val hσ_E_tr hσ_E_norm hQuadNorm
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      c_ν x cM₁' cE' hc_ν_val hc_ν_stat h2_val hu_even hu_odd
      (fun hh => (h9_zero hh).2)
      (fun hh => ⟨(h9_pos hh).1, (h9_pos hh).2.1, (h9_pos hh).2.2.1⟩)
      hMultPref hTrDiff_zero (fun hh => (h10_pos hh).1)
  refine ⟨c_ν, x, C, cM₁', cE', hC_eq, hc_ν_val, hc_ν_stat,
    hcM₁'_val, hcM₁'_stat, hcE'_val, hcE'_stat, hPrefactor, ?_, ?_⟩
  · intro hh
    exact ⟨(h9_zero hh).1, hcM₁'_eq, hcE'_eq_zero hh⟩
  · intro hh
    obtain ⟨hx_ne, hx_val, hA_val, hCritM₁'_polar⟩ := h9_pos hh
    obtain ⟨_, hCritM₁'_base, hCritE'_rec⟩ := h10_pos hh
    exact ⟨hx_ne, hx_val, hA_val, hCritM₁'_base, hCritM₁'_polar, hCritE'_rec⟩

theorem ld_ch12_wild_dyadic_pos_shift_res_finset_and_uniformizers (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (d : M₁') (σ_U : M₁' ≃ₐ[F] M₁')
    (hd_val : valL F M₁' d = 0) (hd_tr : traceLM F hLM₁' d = 1)
    (hσ_U_L : ∀ x : L,
      σ_U (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ_U_val : ∀ z : M₁', valL F M₁' (σ_U z) = valL F M₁' z)
    (hσ_U_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + σ_U z) :
    ∃ (k_L : Type u) (_ : Field k_L) (_ : Fintype k_L) (resL : L → k_L)
      (R_L : Finset L) (ϖ_E' : E'ˣ) (ϖ_L : Lˣ),
      let R_E' : Finset E' := R_L.image (IntermediateField.inclusion hLE')
      let R_M₁' : Finset M₁' :=
        (R_L ×ˢ R_L).image (fun p =>
          IntermediateField.inclusion hLM₁' p.1 + IntermediateField.inclusion hLM₁' p.2 * d)
      Fintype.card k_L = qL F L ∧
      (2 : k_L) = 0 ∧
      resL 0 = 0 ∧
      resL 1 = 1 ∧
      (∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
        resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
        resL (-x₁) = -resL x₁) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x))) ∧
      (∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a) ∧
      R_L.card = Fintype.card k_L ∧
      (∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r) ∧
      (∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r)) ∧
      R_E'.card = qL F L ∧
      (∀ r ∈ R_E', r = 0 ∨ 0 ≤ valL F E' r) ∧
      (∀ r₁ ∈ R_E', ∀ r₂ ∈ R_E', r₁ ≠ r₂ → valL F E' (r₁ - r₂) = 0) ∧
      (∀ y : E', (y = 0 ∨ 0 ≤ valL F E' y) → ∃ r ∈ R_E', y - r = 0 ∨ 1 ≤ valL F E' (y - r)) ∧
      Set.InjOn
        (fun p : L × L =>
          IntermediateField.inclusion hLM₁' p.1 + IntermediateField.inclusion hLM₁' p.2 * d)
        (R_L ×ˢ R_L) ∧
      R_M₁'.card = (qL F L) ^ 2 ∧
      (∀ w ∈ R_M₁', w = 0 ∨ 0 ≤ valL F M₁' w) ∧
      (∀ w₁ ∈ R_M₁', ∀ w₂ ∈ R_M₁', w₁ ≠ w₂ → valL F M₁' (w₁ - w₂) = 0) ∧
      (∀ w : M₁', (w = 0 ∨ 0 ≤ valL F M₁' w) →
        ∃ r ∈ R_M₁', w - r = 0 ∨ 1 ≤ valL F M₁' (w - r)) ∧
      Units.map (normLM F hLE') ϖ_E' = ϖ_L ∧
      valL F E' (ϖ_E' : E') = 1 ∧
      valL F L (ϖ_L : L) = 1 ∧
      (∀ r : L, normLM F hLE' (IntermediateField.inclusion hLE' r) = r ^ 2) :=
by
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalE' := ld_valL_and_unitGroup_props F E'
  have hvalM₁' := ld_valL_and_unitGroup_props F M₁'
  rcases hvalL with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, _, _, _⟩
  rcases hvalE' with ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E',
    hval_inv_E', hval_surj_E', hval_add_E', _, _, _⟩
  rcases hvalM₁' with ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁',
    hval_inv_M₁', hval_surj_M₁', hval_add_M₁', _, _, _⟩
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_sub_L : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    have hneg2 : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_L]; exact hge)
    exact hval_add_L k x₁ (-x₂) hx₁ hneg2
  have hval_mul_ge_M₁' : ∀ (k₁ k₂ : ℤ) (z₁ z₂ : M₁'),
      (z₁ = 0 ∨ k₁ ≤ valL F M₁' z₁) → (z₂ = 0 ∨ k₂ ≤ valL F M₁' z₂) →
        (z₁ * z₂ = 0 ∨ k₁ + k₂ ≤ valL F M₁' (z₁ * z₂)) := by
    intro k₁ k₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · exact Or.inl (by rw [hz₁0, zero_mul])
    · by_cases hz₂0 : z₂ = 0
      · exact Or.inl (by rw [hz₂0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F M₁' z₁ := hz₁.resolve_left hz₁0
        have h2 : k₂ ≤ valL F M₁' z₂ := hz₂.resolve_left hz₂0
        rw [hval_mul_M₁' z₁ z₂ hz₁0 hz₂0]
        omega
  have hval_sub_M₁' : ∀ (k : ℤ) (z₁ z₂ : M₁'),
      (z₁ = 0 ∨ k ≤ valL F M₁' z₁) → (z₂ = 0 ∨ k ≤ valL F M₁' z₂) →
        (z₁ - z₂ = 0 ∨ k ≤ valL F M₁' (z₁ - z₂)) := by
    intro k z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    have hneg2 : -z₂ = 0 ∨ k ≤ valL F M₁' (-z₂) := by
      rcases hz₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_M₁']; exact hge)
    exact hval_add_M₁' k z₁ (-z₂) hz₁ hneg2
  have hval_pow_E' : ∀ (y : E') (n : ℕ), y ≠ 0 → valL F E' (y ^ n) = (n : ℤ) * valL F E' y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_E']
    | succ n ih =>
      rw [pow_succ, hval_mul_E' (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_finset_sum_E' : ∀ {α : Type} (S : Finset α) (f : α → E') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F E' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty => exact Or.inl (by simp)
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add_E' k (f a) (∑ i ∈ s, f i)
        (hS a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hval0_L hval_neg_L hval_mul_L hval_add_L
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L
      hval0_L hval1_L hval_neg1_L hval_neg_L hval_mul_L hval_inv_L hval_add_L S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  obtain ⟨hkL_card, hp_kL, hp_L⟩ :=
    ld_valL_residue_field_card_eq_qL F L
      ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L, hval_add_L⟩
      ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  have hchar2 : (2 : k_L) = 0 := by
    rw [hp2, Nat.cast_two] at hp_kL
    exact hp_kL
  have h2_L_val : (2 : L) = 0 ∨ 1 ≤ valL F L (2 : L) := by
    rw [hp2, Nat.cast_two] at hp_L
    exact hp_L
  obtain ⟨_, _, _, _, hval_alg_LE', _, _, _,
    ϖ_E', ϖ_L, hϖ_norm, hϖ_E', hϖ_L, hBasis⟩ :=
    ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond (by omega : condExp F L νE' ≠ 0) hWild
      haddVal1 haddVal_mul halg1
      (ld_valL_and_unitGroup_props F L) (ld_valL_and_unitGroup_props F E')
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  have hresL_sub : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    have hneg2 : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_L]; exact hge)
    have hadd := (hresL_ring x₁ (-x₂) hx₁ hneg2).1
    have hneg := (hresL_ring x₂ x₂ hx₂ hx₂).2.2
    rw [sub_eq_add_neg, hadd, hneg, ← sub_eq_add_neg]
  let liftL : k_L → L := fun a => (hresL_surj a).choose
  have hliftL : ∀ a : k_L, (liftL a = 0 ∨ 0 ≤ valL F L (liftL a)) ∧ resL (liftL a) = a :=
    fun a => (hresL_surj a).choose_spec
  have hliftL_inj : Function.Injective liftL := by
    intro a₁ a₂ h
    have h1 := (hliftL a₁).2
    have h2 := (hliftL a₂).2
    rw [h] at h1
    exact h1.symm.trans h2
  let R_L : Finset L := Finset.univ.image liftL
  let R_E' : Finset E' := R_L.image (IntermediateField.inclusion hLE')
  have hRL_card : R_L.card = Fintype.card k_L := by
    dsimp [R_L]
    rw [Finset.card_image_of_injective _ hliftL_inj, Finset.card_univ]
  have hRE'_card : R_E'.card = qL F L := by
    dsimp [R_E']
    have hinj : Function.Injective (IntermediateField.inclusion hLE') :=
      (IntermediateField.inclusion hLE').injective
    rw [Finset.card_image_of_injective _ hinj, hRL_card, hkL_card]
  have hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨a, _, rfl⟩
    exact (hliftL a).1
  have hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0 := by
    intro r₁ hr₁ r₂ hr₂ hr_ne
    rcases Finset.mem_image.mp hr₁ with ⟨a₁, _, rfl⟩
    rcases Finset.mem_image.mp hr₂ with ⟨a₂, _, rfl⟩
    have hsub_int : liftL a₁ - liftL a₂ = 0 ∨ 0 ≤ valL F L (liftL a₁ - liftL a₂) :=
      hval_sub_L 0 (liftL a₁) (liftL a₂) (hliftL a₁).1 (hliftL a₂).1
    have hsub_ne : liftL a₁ - liftL a₂ ≠ 0 := sub_ne_zero.mpr hr_ne
    have hge0 : 0 ≤ valL F L (liftL a₁ - liftL a₂) := hsub_int.resolve_left hsub_ne
    by_contra hne0
    have hge1 : 1 ≤ valL F L (liftL a₁ - liftL a₂) := by omega
    have hres0 : resL (liftL a₁ - liftL a₂) = 0 :=
      (hresL_ker (liftL a₁ - liftL a₂) hsub_int).mpr (Or.inr hge1)
    rw [hresL_sub (liftL a₁) (liftL a₂) (hliftL a₁).1 (hliftL a₂).1,
      (hliftL a₁).2, (hliftL a₂).2] at hres0
    exact hr_ne (congrArg liftL (sub_eq_zero.mp hres0))
  have hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r) := by
    intro x hx
    refine ⟨liftL (resL x), Finset.mem_image_of_mem liftL (Finset.mem_univ (resL x)), ?_⟩
    have hsub_int : x - liftL (resL x) = 0 ∨ 0 ≤ valL F L (x - liftL (resL x)) :=
      hval_sub_L 0 x (liftL (resL x)) hx (hliftL (resL x)).1
    apply (hresL_ker (x - liftL (resL x)) hsub_int).mp
    rw [hresL_sub x (liftL (resL x)) hx (hliftL (resL x)).1, (hliftL (resL x)).2, sub_self]
  have hRE'_int : ∀ r ∈ R_E', r = 0 ∨ 0 ≤ valL F E' r := by
    intro r hr
    rcases Finset.mem_image.mp hr with ⟨r_L, hr_L, rfl⟩
    rcases hRL_int r_L hr_L with rfl | hge0
    · exact Or.inl (map_zero _)
    · right
      rw [hval_LE' r_L]
      omega
  have hRE'_sep : ∀ r₁ ∈ R_E', ∀ r₂ ∈ R_E', r₁ ≠ r₂ → valL F E' (r₁ - r₂) = 0 := by
    intro r₁ hr₁ r₂ hr₂ hr_ne
    rcases Finset.mem_image.mp hr₁ with ⟨x₁, hx₁, rfl⟩
    rcases Finset.mem_image.mp hr₂ with ⟨x₂, hx₂, rfl⟩
    have hx_ne : x₁ ≠ x₂ := fun h => hr_ne (congrArg (IntermediateField.inclusion hLE') h)
    rw [← map_sub, hval_LE' (x₁ - x₂), hRL_sep x₁ hx₁ x₂ hx₂ hx_ne, mul_zero]
  let p_deg := Module.finrank L (IntermediateField.extendScalars hLE')
  have hp_pos : 0 < p_deg := hPrime.pos
  have hp_ge2 : 2 ≤ p_deg := hPrime.two_le
  have hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2 := hWild.trans hp2
  have hResSurj_E' : ∀ y : E', (y = 0 ∨ 0 ≤ valL F E' y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE' x = 0 ∨
          1 ≤ valL F E' (y - IntermediateField.inclusion hLE' x)) := by
    intro y hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis y
    let t_term (i : Fin p_deg) : E' :=
      IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ))
    let i_zero : Fin p_deg := ⟨0, hp_pos⟩
    let x : L := c i_zero
    have hc_all := (hval_iff 0).mp hy
    have hx : x = 0 ∨ 0 ≤ valL F L x := by
      rcases hc_all i_zero with h0 | hge
      · exact Or.inl h0
      · right
        change 0 ≤ (p_deg : ℤ) * valL F L x + (0 : ℤ) at hge
        have hp_int_pos : (0 : ℤ) < (p_deg : ℤ) := Nat.cast_pos.mpr hp_pos
        nlinarith
    have ht_zero : t_term i_zero = IntermediateField.inclusion hLE' x := by
      dsimp [t_term, i_zero, x]
      rw [pow_zero, mul_one]
    have hy_sub : y - IntermediateField.inclusion hLE' x =
        ∑ i ∈ (Finset.univ : Finset (Fin p_deg)).erase i_zero, t_term i := by
      have hsum := (Finset.add_sum_erase (Finset.univ : Finset (Fin p_deg)) t_term
        (Finset.mem_univ i_zero)).symm
      rw [ht_zero] at hsum
      rw [hy_eq]
      change (∑ i : Fin p_deg, t_term i) - IntermediateField.inclusion hLE' x = _
      rw [hsum, add_sub_cancel_left]
    refine ⟨x, hx, ?_⟩
    rw [hy_sub]
    apply hval_finset_sum_E' ((Finset.univ : Finset (Fin p_deg)).erase i_zero) t_term 1
    intro i hi
    have hi_ne : i ≠ i_zero := (Finset.mem_erase.mp hi).1
    have hi_ge1 : (1 : ℤ) ≤ (i.1 : ℤ) := by
      have hne0 : i.1 ≠ 0 := fun h0 => hi_ne (Fin.ext h0)
      omega
    have hi_lt : (i.1 : ℤ) < (p_deg : ℤ) := Nat.cast_lt.mpr i.2
    by_cases hci0 : c i = 0
    · left
      dsimp [t_term]
      rw [hci0, map_zero, zero_mul]
    · right
      have hci_ge : 0 ≤ (p_deg : ℤ) * valL F L (c i) + (i.1 : ℤ) :=
        (hc_all i).resolve_left hci0
      have hci_val_ge0 : 0 ≤ valL F L (c i) := by nlinarith
      have hinc_ne : IntermediateField.inclusion hLE' (c i) ≠ 0 :=
        (RingHom.injective (IntermediateField.inclusion hLE').toRingHom).ne hci0
      have hpow_ne : ((ϖ_E' : E') ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_E')
      dsimp [t_term]
      rw [hval_mul_E' _ _ hinc_ne hpow_ne, hval_alg_LE' (c i),
        hval_pow_E' (ϖ_E' : E') (i : ℕ) (Units.ne_zero ϖ_E'), hϖ_E', mul_one]
      nlinarith
  have hRE'_surj : ∀ y : E', (y = 0 ∨ 0 ≤ valL F E' y) →
      ∃ r ∈ R_E', y - r = 0 ∨ 1 ≤ valL F E' (y - r) := by
    intro y hy
    obtain ⟨x, hx_int, hyx⟩ := hResSurj_E' y hy
    obtain ⟨r_L, hr_L_mem, hxr⟩ := hRL_surj x hx_int
    refine ⟨IntermediateField.inclusion hLE' r_L,
      Finset.mem_image_of_mem _ hr_L_mem, ?_⟩
    have hxr_E' : IntermediateField.inclusion hLE' x - IntermediateField.inclusion hLE' r_L = 0 ∨
        1 ≤ valL F E' (IntermediateField.inclusion hLE' x - IntermediateField.inclusion hLE' r_L) := by
      rw [← map_sub]
      rcases hxr with h0 | hge1
      · exact Or.inl (by rw [h0, map_zero])
      · right
        rw [hval_LE' (x - r_L)]
        omega
    have hadd_eq : y - IntermediateField.inclusion hLE' r_L =
        (y - IntermediateField.inclusion hLE' x) +
          (IntermediateField.inclusion hLE' x - IntermediateField.inclusion hLE' r_L) := by ring
    rw [hadd_eq]
    exact hval_add_E' 1 _ _ hyx hxr_E'
  have hnorm_incl : ∀ r : L, normLM F hLE' (IntermediateField.inclusion hLE' r) = r ^ 2 := by
    intro r
    have h1 : normLM F hLE' (IntermediateField.inclusion hLE' r) =
        Algebra.norm L ((algebraMap L (IntermediateField.extendScalars hLE')) r) := rfl
    rw [h1, Algebra.norm_algebraMap, hdeg2]
  have hd_int : d = 0 ∨ 0 ≤ valL F M₁' d := Or.inr (by omega)
  have hσ_U_d_int : σ_U d = 0 ∨ 0 ≤ valL F M₁' (σ_U d) := Or.inr (by rw [hσ_U_val d]; omega)
  have hσ_U_d : σ_U d = 1 - d := by
    have h := hσ_U_tr d
    rw [hd_tr, map_one] at h
    linear_combination -h
  have hσ_U_d_inv : σ_U (σ_U d) = d := by
    rw [hσ_U_d, map_sub, map_one, hσ_U_d]
    ring
  have h2_M₁'_val : (2 : M₁') = 0 ∨ 1 ≤ valL F M₁' (2 : M₁') := by
    have hmap : IntermediateField.inclusion hLM₁' (2 : L) = (2 : M₁') := map_ofNat _ 2
    rw [← hmap]
    rcases h2_L_val with h0 | hge1
    · exact Or.inl (by rw [h0, map_zero])
    · right
      rw [hval_LM₁' (2 : L)]
      exact hge1
  have hval_incl_M₁' : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) ↔
        (IntermediateField.inclusion hLM₁' x = 0 ∨
          k ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x)) := by
    intro k x
    have hinj : Function.Injective (IntermediateField.inclusion hLM₁') :=
      (IntermediateField.inclusion hLM₁').injective
    have hzero : IntermediateField.inclusion hLM₁' x = 0 ↔ x = 0 :=
      ⟨fun h => hinj (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩
    rw [hzero, hval_LM₁' x]
  have hval_σ_U : ∀ (k : ℤ) (z : M₁'),
      (z = 0 ∨ k ≤ valL F M₁' z) → (σ_U z = 0 ∨ k ≤ valL F M₁' (σ_U z)) := by
    intro k z hz
    rcases hz with rfl | hge
    · exact Or.inl (map_zero σ_U)
    · exact Or.inr (by rw [hσ_U_val z]; exact hge)
  have hCoordVal : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) →
      (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      (IntermediateField.inclusion hLM₁' x₁ + IntermediateField.inclusion hLM₁' x₂ * d = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x₁ +
          IntermediateField.inclusion hLM₁' x₂ * d)) →
      (x₁ = 0 ∨ 1 ≤ valL F L x₁) ∧ (x₂ = 0 ∨ 1 ≤ valL F L x₂) := by
    intro x₁ x₂ hx₁ hx₂ hz
    let z : M₁' := IntermediateField.inclusion hLM₁' x₁ + IntermediateField.inclusion hLM₁' x₂ * d
    have hσz : σ_U z = 0 ∨ 1 ≤ valL F M₁' (σ_U z) := hval_σ_U 1 z hz
    have hsum_val : z + σ_U z = 0 ∨ 1 ≤ valL F M₁' (z + σ_U z) :=
      hval_add_M₁' 1 z (σ_U z) hz hσz
    have hsum_eq : z + σ_U z = IntermediateField.inclusion hLM₁' ((2 : L) * x₁ + x₂) := by
      dsimp [z]
      rw [map_add, map_mul, hσ_U_L x₁, hσ_U_L x₂, hσ_U_d, map_add, map_mul, map_ofNat]
      ring
    rw [hsum_eq] at hsum_val
    have h2x₁_x₂ : (2 : L) * x₁ + x₂ = 0 ∨ 1 ≤ valL F L ((2 : L) * x₁ + x₂) :=
      (hval_incl_M₁' 1 ((2 : L) * x₁ + x₂)).mpr hsum_val
    have h2x₁ : (2 : L) * x₁ = 0 ∨ 1 ≤ valL F L ((2 : L) * x₁) := by
      simpa using hval_mul_ge_L 1 0 (2 : L) x₁ h2_L_val hx₁
    have hx₂_val : x₂ = 0 ∨ 1 ≤ valL F L x₂ := by
      have hsub := hval_sub_L 1 ((2 : L) * x₁ + x₂) ((2 : L) * x₁) h2x₁_x₂ h2x₁
      have heq : (2 : L) * x₁ + x₂ - (2 : L) * x₁ = x₂ := by ring
      rwa [heq] at hsub
    have hx₂_M₁' : IntermediateField.inclusion hLM₁' x₂ = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x₂) :=
      (hval_incl_M₁' 1 x₂).mp hx₂_val
    have hx₂d_M₁' : IntermediateField.inclusion hLM₁' x₂ * d = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x₂ * d) := by
      simpa using hval_mul_ge_M₁' 1 0 (IntermediateField.inclusion hLM₁' x₂) d hx₂_M₁' hd_int
    have hx₁_M₁' : IntermediateField.inclusion hLM₁' x₁ = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' x₁) := by
      have hsub := hval_sub_M₁' 1 z (IntermediateField.inclusion hLM₁' x₂ * d) hz hx₂d_M₁'
      have heq : z - IntermediateField.inclusion hLM₁' x₂ * d =
          IntermediateField.inclusion hLM₁' x₁ := by
        dsimp [z]
        ring
      rwa [heq] at hsub
    exact ⟨(hval_incl_M₁' 1 x₁).mpr hx₁_M₁', hx₂_val⟩
  let ϕ_U : L × L → M₁' := fun p =>
    IntermediateField.inclusion hLM₁' p.1 + IntermediateField.inclusion hLM₁' p.2 * d
  let R_M₁' : Finset M₁' := (R_L ×ˢ R_L).image ϕ_U
  have hPairEq : ∀ p q : L × L,
      p.1 ∈ R_L → p.2 ∈ R_L → q.1 ∈ R_L → q.2 ∈ R_L →
      (ϕ_U p - ϕ_U q = 0 ∨ 1 ≤ valL F M₁' (ϕ_U p - ϕ_U q)) →
      p = q := by
    intro p q hp1 hp2 hq1 hq2 hdiff
    have hdiff_eq : ϕ_U p - ϕ_U q =
        IntermediateField.inclusion hLM₁' (p.1 - q.1) +
          IntermediateField.inclusion hLM₁' (p.2 - q.2) * d := by
      dsimp [ϕ_U]
      rw [map_sub, map_sub]
      ring
    rw [hdiff_eq] at hdiff
    have hpq1_int : p.1 - q.1 = 0 ∨ 0 ≤ valL F L (p.1 - q.1) :=
      hval_sub_L 0 p.1 q.1 (hRL_int p.1 hp1) (hRL_int q.1 hq1)
    have hpq2_int : p.2 - q.2 = 0 ∨ 0 ≤ valL F L (p.2 - q.2) :=
      hval_sub_L 0 p.2 q.2 (hRL_int p.2 hp2) (hRL_int q.2 hq2)
    obtain ⟨h1_val, h2_val⟩ := hCoordVal (p.1 - q.1) (p.2 - q.2) hpq1_int hpq2_int hdiff
    have hpq1 : p.1 = q.1 := by
      by_contra hne
      rcases h1_val with h0 | hge1
      · exact hne (sub_eq_zero.mp h0)
      · have h0 := hRL_sep p.1 hp1 q.1 hq1 hne
        omega
    have hpq2 : p.2 = q.2 := by
      by_contra hne
      rcases h2_val with h0 | hge1
      · exact hne (sub_eq_zero.mp h0)
      · have h0 := hRL_sep p.2 hp2 q.2 hq2 hne
        omega
    exact Prod.ext hpq1 hpq2
  have hRM₁'_inj : Set.InjOn ϕ_U (R_L ×ˢ R_L) := by
    intro p hp q hq hpq
    exact hPairEq p q hp.1 hp.2 hq.1 hq.2 (Or.inl (sub_eq_zero.mpr hpq))
  have hRM₁'_inj_finset : Set.InjOn ϕ_U ↑(R_L ×ˢ R_L : Finset (L × L)) := by
    intro p hp q hq hpq
    rw [Finset.mem_coe, Finset.mem_product] at hp hq
    exact hPairEq p q hp.1 hp.2 hq.1 hq.2 (Or.inl (sub_eq_zero.mpr hpq))
  have hRM₁'_card : R_M₁'.card = (qL F L) ^ 2 := by
    dsimp [R_M₁']
    rw [Finset.card_image_of_injOn hRM₁'_inj_finset, Finset.card_product, hRL_card, hkL_card, sq]
  have hRM₁'_int : ∀ w ∈ R_M₁', w = 0 ∨ 0 ≤ valL F M₁' w := by
    intro w hw
    rcases Finset.mem_image.mp hw with ⟨p, hp, rfl⟩
    rw [Finset.mem_product] at hp
    have hp1_M₁' : IntermediateField.inclusion hLM₁' p.1 = 0 ∨
        0 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' p.1) :=
      (hval_incl_M₁' 0 p.1).mp (hRL_int p.1 hp.1)
    have hp2_M₁' : IntermediateField.inclusion hLM₁' p.2 = 0 ∨
        0 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' p.2) :=
      (hval_incl_M₁' 0 p.2).mp (hRL_int p.2 hp.2)
    have hp2d_M₁' : IntermediateField.inclusion hLM₁' p.2 * d = 0 ∨
        0 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' p.2 * d) := by
      simpa using hval_mul_ge_M₁' 0 0 (IntermediateField.inclusion hLM₁' p.2) d hp2_M₁' hd_int
    exact hval_add_M₁' 0 _ _ hp1_M₁' hp2d_M₁'
  have hRM₁'_sep : ∀ w₁ ∈ R_M₁', ∀ w₂ ∈ R_M₁', w₁ ≠ w₂ → valL F M₁' (w₁ - w₂) = 0 := by
    intro w₁ hw₁ w₂ hw₂ hw_ne
    have hsub_int : w₁ - w₂ = 0 ∨ 0 ≤ valL F M₁' (w₁ - w₂) :=
      hval_sub_M₁' 0 w₁ w₂ (hRM₁'_int w₁ hw₁) (hRM₁'_int w₂ hw₂)
    have hsub_ne : w₁ - w₂ ≠ 0 := sub_ne_zero.mpr hw_ne
    have hge0 : 0 ≤ valL F M₁' (w₁ - w₂) := hsub_int.resolve_left hsub_ne
    by_contra hne0
    have hge1 : 1 ≤ valL F M₁' (w₁ - w₂) := by omega
    rcases Finset.mem_image.mp hw₁ with ⟨p, hp, rfl⟩
    rcases Finset.mem_image.mp hw₂ with ⟨q, hq, rfl⟩
    rw [Finset.mem_product] at hp hq
    have hpq : p = q := hPairEq p q hp.1 hp.2 hq.1 hq.2 (Or.inr hge1)
    exact hw_ne (congrArg ϕ_U hpq)
  have hRM₁'_surj : ∀ w : M₁', (w = 0 ∨ 0 ≤ valL F M₁' w) →
      ∃ r ∈ R_M₁', w - r = 0 ∨ 1 ≤ valL F M₁' (w - r) := by
    intro w hw
    have hσw_int : σ_U w = 0 ∨ 0 ≤ valL F M₁' (σ_U w) := hval_σ_U 0 w hw
    have hwσd_int : w * σ_U d = 0 ∨ 0 ≤ valL F M₁' (w * σ_U d) := by
      simpa using hval_mul_ge_M₁' 0 0 w (σ_U d) hw hσ_U_d_int
    let a₁ : L := traceLM F hLM₁' (w * σ_U d)
    let a₂ : L := traceLM F hLM₁' w
    have ha₁_int : a₁ = 0 ∨ 0 ≤ valL F L a₁ := htr_bound_LM₁' 0 (w * σ_U d) hwσd_int
    have ha₂_int : a₂ = 0 ∨ 0 ≤ valL F L a₂ := htr_bound_LM₁' 0 w hw
    have ha₁_eq : IntermediateField.inclusion hLM₁' a₁ = w * (1 - d) + σ_U w * d := by
      dsimp [a₁]
      rw [hσ_U_tr (w * σ_U d), map_mul, hσ_U_d_inv, hσ_U_d]
    have ha₂_eq : IntermediateField.inclusion hLM₁' a₂ = w + σ_U w := hσ_U_tr w
    have hw_ident : w - (IntermediateField.inclusion hLM₁' a₁ +
        IntermediateField.inclusion hLM₁' a₂ * d) = -((2 : M₁') * σ_U w * d) := by
      rw [ha₁_eq, ha₂_eq]
      ring
    have h2σw_val : (2 : M₁') * σ_U w = 0 ∨ 1 ≤ valL F M₁' ((2 : M₁') * σ_U w) := by
      simpa using hval_mul_ge_M₁' 1 0 (2 : M₁') (σ_U w) h2_M₁'_val hσw_int
    have h2σwd_val : (2 : M₁') * σ_U w * d = 0 ∨ 1 ≤ valL F M₁' ((2 : M₁') * σ_U w * d) := by
      simpa using hval_mul_ge_M₁' 1 0 ((2 : M₁') * σ_U w) d h2σw_val hd_int
    have hwa_val : w - (IntermediateField.inclusion hLM₁' a₁ +
        IntermediateField.inclusion hLM₁' a₂ * d) = 0 ∨
        1 ≤ valL F M₁' (w - (IntermediateField.inclusion hLM₁' a₁ +
          IntermediateField.inclusion hLM₁' a₂ * d)) := by
      rw [hw_ident]
      rcases h2σwd_val with h0 | hge1
      · exact Or.inl (by rw [h0, neg_zero])
      · exact Or.inr (by rw [hval_neg_M₁']; exact hge1)
    obtain ⟨r₁, hr₁_mem, har₁⟩ := hRL_surj a₁ ha₁_int
    obtain ⟨r₂, hr₂_mem, har₂⟩ := hRL_surj a₂ ha₂_int
    have har₁_M₁' : IntermediateField.inclusion hLM₁' (a₁ - r₁) = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (a₁ - r₁)) :=
      (hval_incl_M₁' 1 (a₁ - r₁)).mp har₁
    have har₂_M₁' : IntermediateField.inclusion hLM₁' (a₂ - r₂) = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (a₂ - r₂)) :=
      (hval_incl_M₁' 1 (a₂ - r₂)).mp har₂
    have har₂d_M₁' : IntermediateField.inclusion hLM₁' (a₂ - r₂) * d = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (a₂ - r₂) * d) := by
      simpa using hval_mul_ge_M₁' 1 0 (IntermediateField.inclusion hLM₁' (a₂ - r₂)) d har₂_M₁' hd_int
    have har_sum_val : IntermediateField.inclusion hLM₁' (a₁ - r₁) +
        IntermediateField.inclusion hLM₁' (a₂ - r₂) * d = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (a₁ - r₁) +
          IntermediateField.inclusion hLM₁' (a₂ - r₂) * d) :=
      hval_add_M₁' 1 _ _ har₁_M₁' har₂d_M₁'
    have hmem_prod : (r₁, r₂) ∈ R_L ×ˢ R_L := Finset.mem_product.mpr ⟨hr₁_mem, hr₂_mem⟩
    refine ⟨ϕ_U (r₁, r₂), Finset.mem_image_of_mem ϕ_U hmem_prod, ?_⟩
    have hsplit : w - ϕ_U (r₁, r₂) =
        (w - (IntermediateField.inclusion hLM₁' a₁ + IntermediateField.inclusion hLM₁' a₂ * d)) +
          (IntermediateField.inclusion hLM₁' (a₁ - r₁) +
            IntermediateField.inclusion hLM₁' (a₂ - r₂) * d) := by
      dsimp [ϕ_U]
      rw [map_sub, map_sub]
      ring
    rw [hsplit]
    exact hval_add_M₁' 1 _ _ hwa_val har_sum_val
  refine ⟨k_L, hField_kL, hFin_kL, resL, R_L, ϖ_E', ϖ_L,
    hkL_card, hchar2, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj,
    hRL_card, hRL_int, hRL_sep, hRL_surj,
    hRE'_card, hRE'_int, hRE'_sep, hRE'_surj,
    hRM₁'_inj, hRM₁'_card, hRM₁'_int, hRM₁'_sep, hRM₁'_surj,
    hϖ_norm, hϖ_E', hϖ_L, hnorm_incl⟩

theorem ld_ch12_wild_dyadic_pos_shift_M1_eps_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (ψ : AddChar L (Ω F))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' : Lˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hPosShift : condExp F L νE' < condExp F M₁' θM₁')
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (d : M₁') (hd_val : valL F M₁' d = 0)
    (c_ν : Lˣ) (x : E') (cM₁' : M₁'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hcM₁'_val : valL F M₁' (cM₁' : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
