      exact hg y.1 hx
  have hM_sub_card : ∀ i : Fin r_orb,
      Nat.card (G ⧸ M_sub i) =
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) := by
    intro i
    have hmul_fix : Module.finrank L ↥(IntermediateField.extendScalars (D_orb.get i).le) *
        Nat.card (M_sub i) = Module.finrank L ↥K' :=
      h_abs_finrank ↥L ↥K' (AlgebraicClosure F) K'.val
        (IntermediateField.extendScalars (D_orb.get i).le)
        (fun z hz => ⟨⟨z, (IntermediateField.mem_extendScalars hLK).mpr
          (hM_CK (hFiMC i ((IntermediateField.mem_extendScalars (D_orb.get i).le).mp hz)))⟩, rfl⟩)
    have hM_pos : 0 < Nat.card (M_sub i) := Nat.card_pos
    apply Nat.eq_of_mul_eq_mul_right hM_pos
    rw [← Subgroup.index_eq_card (M_sub i), Subgroup.index_mul_card (M_sub i),
      h_card_G, ← hmul_fix]
  have hM_sub_props : ∀ i : Fin r_orb,
      Nat.card (G ⧸ M_sub i) =
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) ∧
      ∀ g : G, g ∈ M_sub i ↔
        ∀ (x : AlgebraicClosure F) (hx : x ∈ (D_orb.get i).field),
          ((g ⟨x, (IntermediateField.mem_extendScalars hLK).mpr
            (hM_CK (hFiMC i hx))⟩ : K') : AlgebraicClosure F) = x :=
    fun i => ⟨hM_sub_card i, hM_sub_mem i⟩
  have h_mem_Fi : ∀ (i : Fin r_orb) (w : relWeil F L),
      w ∈ (relWeil F (D_orb.get i).field).subgroupOf (relWeil F L) ↔ π w ∈ M_sub i := by
    intro i w
    change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ (D_orb.get i).field.fixingSubgroup) ↔
      π w ∈ M_sub i
    have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
    rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff, hM_sub_mem i (π w)]
    refine ⟨fun hw x hx => ?_, fun hw x hx => ?_⟩
    · rw [hπ w]
      exact hw x hx
    · have h1 := hπ w ⟨x, (IntermediateField.mem_extendScalars hLK).mpr (hM_CK (hFiMC i hx))⟩
      exact h1.symm.trans (hw x hx)
  have h_mem_MC_fixed : ∀ x : K', (x : AlgebraicClosure F) ∈ M_C ↔ x ∈ IntermediateField.fixedField C := by
    intro x
    rw [← h_C_eq_MC]
    exact (IntermediateField.mem_restrictScalars F).trans (IntermediateField.mem_lift x)
  have h_weil_pres_MC : ∀ (w : relWeil F L), ∀ z ∈ M_C, (w : AbsGal F) z ∈ M_C := by
    intro w z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hM_CK hz)⟩
    have hx_fix : x ∈ IntermediateField.fixedField C := (h_mem_MC_fixed x).mp hz
    change (w : AbsGal F) (x : AlgebraicClosure F) ∈ M_C
    rw [← hπ w x, h_mem_MC_fixed (π w x), IntermediateField.mem_fixedField_iff]
    intro c hc
    have h_conj_C : (π w)⁻¹ * c * π w ∈ C := hC_conj hc (π w)
    have h_fix_conj : ((π w)⁻¹ * c * π w) x = x :=
      (IntermediateField.mem_fixedField_iff C x).mp hx_fix _ h_conj_C
    have h1 : (π w) (((π w)⁻¹ * c * π w) x) = (π w) x :=
      congrArg (π w) h_fix_conj
    have h2 : (π w) (((π w)⁻¹ * c * π w) x) = c (π w x) := by
      change (π w * ((π w)⁻¹ * c * π w)) x = (c * π w) x
      have h_grp : π w * ((π w)⁻¹ * c * π w) = c * π w := by group
      rw [h_grp]
    exact h2.symm.trans h1
  obtain ⟨idx_all, u_all, γ_all, hBij, hγ_spec, hCosetInj⟩ :=
    h_s1_abs G π C H M_sub q hq_gt1 hDegSum hsurj hCard_C hCard_GH
      h_disj_HC h_ker_π h_mem_H h_mem_C h_mem_Fi hM_sub_card
  refine ⟨M_sub, idx_all, u_all, γ_all, hBij, hM_sub_props,
    fun j => ⟨fun x => by rw [← hγ_spec j, hπ (γ_all j) x], h_weil_pres_MC (γ_all j)⟩,
    hCosetInj⟩

theorem ld_ch14_wild_orbit_recChar_and_tateEps_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
