  obtain ⟨s₁, _, _, hs₁_val', hs₁_norm_one_add', _, _⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F M₁' K₁ hM₁'K₁ hGalM₁'K₁
      hPrime_M₁'K₁ hp_odd_M₁'K₁ hvalM₁'_props hvalK₁_props hval_M₁'K₁' hval_norm_M₁'K₁
      T_jump hT_ge1 htr_M₁'K₁'
      (fun t htr G _ _ act hcard h1 hmul hring hincl hval htrG hnormG =>
        ld_wild_odd_free_orbit_symm_functions F M₁' K₁ hM₁'K₁ hPrime_M₁'K₁ hp_odd_M₁'K₁
          hvalK₁_props t htr G act hcard h1 hmul hring hincl hval htrG hnormG)
      (fun G _ _ act s_fn hcard h1 hring hincl hnormG hpoly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F M₁' K₁ hM₁'K₁ hPrime_M₁'K₁
          hp_odd_M₁'K₁ hvalM₁'_props hvalK₁_props hval_M₁'K₁' G act hcard h1 hring
          hincl hnormG s_fn hpoly)
  have hs₁_val : ∀ (w : K₁) (r : ℕ),
      r ∈ Finset.Icc 1 (p - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T_jump : ℤ) ≤ (r : ℤ) * q →
        (s₁ w r = 0 ∨ m ≤ valL F M₁' (s₁ w r)) := by
    intro w r hr q m hw hqm
    have hr' : r ∈ Finset.Icc 1 (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) - 1) := by
      rwa [hdegM₁'K₁]
    have hqm' : (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) * m -
        ((Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) - 1 : ℕ) : ℤ) *
          (T_jump : ℤ) ≤ (r : ℤ) * q := by
      rwa [hdegM₁'K₁]
    exact hs₁_val' w r hr' q m hw hqm'
  have hs₁_norm_one_add : ∀ w : K₁,
      normLM F hM₁'K₁ (1 + w) - 1 =
        (∑ r ∈ Finset.Icc 1 (p - 1), s₁ w r) + normLM F hM₁'K₁ w := by
    intro w
    have h := hs₁_norm_one_add' w
    rwa [hdegM₁'K₁] at h
  obtain ⟨τ_unit, hτ_val0, _, hτ_pow_sum, hξ_props, hξ_diff, hξ_prod⟩ :=
    ld_ch12_wild_odd_tot_ram_teichmuller_unit_lifts_and_distinctness F L E' M₁' K₁
      hLE' hLM₁' hM₁'K₁ hPrime hp_odd' bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalL_props hvalM₁'_props hvalK₁_props hval_LM₁' hval_M₁'K₁
      (fun M _ b_exp hb_ge2 hvalM hp_val1 N hN τ_u τ_t hτ_def =>
        ld_wild_odd_prime_teichmuller_power_congruences F M p b_exp hPrime hp_odd' hb_ge2
          hvalM hp_val1 N hN τ_u τ_t hτ_def)
  obtain ⟨Δ_gal, hΔ_gal0, hW_gal_sum, hQ_gal_sum, hTr_gal_sum,
      hΔ_gal_val, hΔ_gal_as, hδ_gal_props, hδ_gal_diff⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_lift_trace_comm_and_unit_shifts F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hPrime hp_odd' hdegM₁' hdegE'K₁ hdegM₁'K₁
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalE'_props hvalM₁'_props hvalK₁_props
      hval_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁ hGalLift
      Δ hΔ_val hΔ_as hΔ_tr_top u w₂
  obtain ⟨ξ, Δ_conj, hξ0, hΔ_conj0, hξ_def, hξ_out, hξ_pow_sum_K₁,
      hΔ_conj_val, hW_conj_sum, hQ_conj_sum, hTr_top_conj_sum,
      hΔ_conj_as, hΔ_conj_approx0⟩ :=
    ld_ch12_wild_odd_tot_ram_teichmuller_range_bijection_and_conj_sums F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd' bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hvalK₁_props hval_M₁'K₁ Δ u w₂
      τ_unit hτ_pow_sum hξ_props hξ_diff hξ_prod
      Δ_gal hΔ_gal0 hW_gal_sum hQ_gal_sum hTr_gal_sum
      hΔ_gal_val hΔ_gal_as hδ_gal_props hδ_gal_diff
  have hs9 :=
    ld_ch12_wild_odd_tot_ram_second_order_as_and_norm_perturbation F L E' M₁' K₁
      hLE' hLM₁' hM₁'K₁ hPrime hp_odd' hdegM₁'K₁
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
      hvalL_props hvalM₁'_props hvalK₁_props
      hval_LM₁' hval_M₁'K₁ hval_norm_M₁'K₁
      s₁ hs₁_val hs₁_norm_one_add Δ hΔ_val e_Δ he_Δ_val he_Δ_poly
      τ_unit hτ_val0 ξ Δ_conj hξ0 hΔ_conj0 hξ_def hξ_out hΔ_conj_as hΔ_conj_approx0
  exact ⟨ξ, Δ_conj, hξ0, hΔ_conj0, hξ_out, hξ_pow_sum_K₁, hΔ_conj_val,
    hW_conj_sum, hQ_conj_sum, hTr_top_conj_sum,
    fun m hm => ⟨hΔ_conj_approx0 m hm, (hs9 m hm).1, (hs9 m hm).2.1, (hs9 m hm).2.2⟩⟩

theorem ld_ch12_wild_odd_tot_ram_lval_and_rat_weight_identities (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (α γ : Lˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (ξ : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let m := a_lam - bE'
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let n := u_M₁' * b
    let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
    let b_K₁ := IntermediateField.inclusion hM₁'K₁ b
    let L_val := W_K₁ + b_K₁
    let D_norm := L_val ^ p - L_val
    let A_star := (Δ : K₁) - L_val
    let fb := b_K₁ * (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹
    L_val ≠ 0 ∧ D_norm ≠ 0 ∧
    valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ D_norm = -(((p * p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ A_star = -(((p * p * m : ℕ) : ℤ)) ∧
    (∀ m' < p,
      L_val + ξ m' ≠ 0 ∧ valL F K₁ (L_val + ξ m') = -(((p * p * m : ℕ) : ℤ))) ∧
    W_K₁ ≠ 0 ∧ valL F K₁ W_K₁ = -(((p * p * m : ℕ) : ℤ)) ∧
    b_K₁ ≠ 0 ∧ valL F K₁ b_K₁ = -(((p * t₁ : ℕ) : ℤ)) ∧
    (∀ m' < p,
      (Δ : K₁) + ξ m' ≠ 0 ∧ valL F K₁ ((Δ : K₁) + ξ m') = -((t₁ : ℕ) : ℤ)) ∧
    (∀ N : M₁',
      IntermediateField.inclusion hM₁'K₁ N *
          (IntermediateField.inclusion hM₁'K₁ (1 + u_M₁' * N))⁻¹ =
        W_K₁ * IntermediateField.inclusion hM₁'K₁ N *
          (W_K₁ + IntermediateField.inclusion hM₁'K₁ N)⁻¹) ∧
    (∀ z : M₁',
      IntermediateField.inclusion hM₁'K₁ (z * (1 + n)⁻¹ ^ 2) =
        IntermediateField.inclusion hM₁'K₁ z * W_K₁ ^ 2 * (L_val ^ 2)⁻¹) ∧
    (fb = 0 ∨ -(((p * t₁ : ℕ) : ℤ)) ≤ valL F K₁ fb) :=
by
  intro p t₁ m b u W u_M₁' n W_K₁ b_K₁ L_val D_norm A_star fb
  obtain ⟨_, _, _, _, hval_mul_L, hval_inv_L, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, hval1_K₁, _, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁, _, hval_add_K₁, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K₁
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpt₁_lt_ppm : p * t₁ < p * p * m := by
    have h1 : p * t₁ < p * (p * m) := Nat.mul_lt_mul_of_pos_left hpm_gt_t₁ (by omega)
    linarith [show p * (p * m) = p * p * m by ring]
  have hppm_lt_pppm : p * p * m < p * p * p * m := by
    have hpos : 0 < p * p * m := by positivity
    nlinarith
  have ht₁_lt_pt₁ : t₁ < p * t₁ := by nlinarith
  have hval_pow_K₁ : ∀ (x : K₁) (k : ℕ), x ≠ 0 → valL F K₁ (x ^ k) = (k : ℤ) * valL F K₁ x := by
    intro x k hx
    induction k with
    | zero => simp [hval1_K₁]
    | succ k ih =>
      rw [pow_succ, hval_mul_K₁ (x ^ k) x (pow_ne_zero k hx) hx, ih]
      push_cast
      ring
  have hval_inv_elt_K₁ : ∀ (x : K₁), x ≠ 0 → valL F K₁ x⁻¹ = - valL F K₁ x := by
    intro x hx
    exact hval_inv_K₁ (Units.mk0 x hx)
  have hval_add_strict : ∀ (x y : K₁),
      x ≠ 0 → (y = 0 ∨ valL F K₁ x < valL F K₁ y) →
        x + y ≠ 0 ∧ valL F K₁ (x + y) = valL F K₁ x := by
    intro x y hx hxy
    rcases hxy with rfl | hlt
    · simp [hx]
    · by_cases hy0 : y = 0
      · simp [hy0, hx]
      · have hxy_ne0 : x + y ≠ 0 := by
          intro h0
          have hx_eq : x = -y := eq_neg_of_add_eq_zero_left h0
          have hveq : valL F K₁ x = valL F K₁ y := by rw [hx_eq, hval_neg_K₁]
          omega
        have hge : valL F K₁ x ≤ valL F K₁ (x + y) :=
          (hval_add_K₁ (valL F K₁ x) x y (Or.inr le_rfl) (Or.inr (le_of_lt hlt))).resolve_left hxy_ne0
        have hle : valL F K₁ (x + y) ≤ valL F K₁ x := by
          by_contra hgt
          push_neg at hgt
          set k : ℤ := min (valL F K₁ (x + y)) (valL F K₁ y)
          have hk_xy : x + y = 0 ∨ k ≤ valL F K₁ (x + y) := Or.inr (min_le_left _ _)
          have hk_ny : -y = 0 ∨ k ≤ valL F K₁ (-y) := by
            right; rw [hval_neg_K₁]; exact min_le_right _ _
          have hsum := hval_add_K₁ k (x + y) (-y) hk_xy hk_ny
          rw [add_neg_cancel_right] at hsum
          have hk_le : k ≤ valL F K₁ x := hsum.resolve_left hx
          have hlt_k : valL F K₁ x < k := lt_min hgt hlt
          omega
        exact ⟨hxy_ne0, le_antisymm hle hge⟩
  have hW_L_ne0 : W ≠ 0 := mul_ne_zero (Units.ne_zero γ) (Units.ne_zero α⁻¹)
  have hW_L_val : valL F L W = -((m : ℕ) : ℤ) := by
    dsimp [W, m]
    rw [hval_mul_L (γ : L) ((α⁻¹ : Lˣ) : L) (Units.ne_zero γ) (Units.ne_zero α⁻¹),
      hval_inv_L α, hγ_val, hα_val]
    omega
  have hW_E'_ne0 : IntermediateField.inclusion hLE' W ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hW_L_ne0
  have hW_ne0 : W_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hW_E'_ne0
  have hW_val : valL F K₁ W_K₁ = -(((p * p * m : ℕ) : ℤ)) := by
    dsimp [W_K₁]
    rw [hval_E'K₁, hval_LE', hW_L_val]
    push_cast
    ring
  have hb_M₁'_ne0 : b ≠ 0 := Units.ne_zero (Units.map (normLM F hM₁'K₁) Δ)
  have hb_ne0 : b_K₁ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hM₁'K₁)).mpr hb_M₁'_ne0
  have hb_val : valL F K₁ b_K₁ = -(((p * t₁ : ℕ) : ℤ)) := by
    dsimp [b_K₁, b, t₁]
    rw [hval_M₁'K₁, hval_norm_M₁'K₁, hΔ_val]
    push_cast
    ring
  obtain ⟨hL_ne0, hL_val⟩ : L_val ≠ 0 ∧ valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) := by
    have h := hval_add_strict W_K₁ b_K₁ hW_ne0 (Or.inr (by rw [hW_val, hb_val]; omega))
    rwa [hW_val] at h
  obtain ⟨hD_ne0, hD_val⟩ : D_norm ≠ 0 ∧ valL F K₁ D_norm = -(((p * p * p * m : ℕ) : ℤ)) := by
    have hLp_ne0 : L_val ^ p ≠ 0 := pow_ne_zero p hL_ne0
    have hLp_val : valL F K₁ (L_val ^ p) = -(((p * p * p * m : ℕ) : ℤ)) := by
      rw [hval_pow_K₁ L_val p hL_ne0, hL_val]
      push_cast
      ring
    have hD_eq : D_norm = L_val ^ p + (-L_val) := sub_eq_add_neg (L_val ^ p) L_val
    rw [hD_eq]
    have h := hval_add_strict (L_val ^ p) (-L_val) hLp_ne0
      (Or.inr (by rw [hLp_val, hval_neg_K₁, hL_val]; omega))
    rwa [hLp_val] at h
  have hA_val : valL F K₁ A_star = -(((p * p * m : ℕ) : ℤ)) := by
    have hA_eq : A_star = (-L_val) + (Δ : K₁) := by dsimp [A_star]; ring
    rw [hA_eq]
    have h := hval_add_strict (-L_val) (Δ : K₁) (neg_ne_zero.mpr hL_ne0)
      (Or.inr (by rw [hval_neg_K₁, hL_val, hΔ_val]; omega))
    rw [hval_neg_K₁, hL_val] at h
    exact h.2
  have hξ_zero_or_val0 : ∀ m' < p, ξ m' = 0 ∨ valL F K₁ (ξ m') = 0 := by
    intro m' hm'
    by_cases hm'0 : m' = 0
    · left; rw [hm'0, hξ0]
    · right; exact (hξ_props m' hm' (Nat.pos_of_ne_zero hm'0)).2.1
  have hL_xi_val : ∀ m' < p,
      L_val + ξ m' ≠ 0 ∧ valL F K₁ (L_val + ξ m') = -(((p * p * m : ℕ) : ℤ)) := by
    intro m' hm'
    have hlt : ξ m' = 0 ∨ valL F K₁ L_val < valL F K₁ (ξ m') := by
      rcases hξ_zero_or_val0 m' hm' with h0 | hv0
      · exact Or.inl h0
      · right; rw [hL_val, hv0]; omega
    have h := hval_add_strict L_val (ξ m') hL_ne0 hlt
    rwa [hL_val] at h
  have hΔ_xi_val : ∀ m' < p,
      (Δ : K₁) + ξ m' ≠ 0 ∧ valL F K₁ ((Δ : K₁) + ξ m') = -((t₁ : ℕ) : ℤ) := by
    intro m' hm'
    have hlt : ξ m' = 0 ∨ valL F K₁ (Δ : K₁) < valL F K₁ (ξ m') := by
      rcases hξ_zero_or_val0 m' hm' with h0 | hv0
      · exact Or.inl h0
      · right; rw [hΔ_val, hv0]; omega
    have h := hval_add_strict (Δ : K₁) (ξ m') (Units.ne_zero Δ) hlt
    rwa [hΔ_val] at h
  have hWu_L : W * u = 1 := by
    dsimp [W, u]
    linear_combination ((γ : L) * ((γ⁻¹ : Lˣ) : L)) * Units.mul_inv α + Units.mul_inv γ
  have hincl_diamond : ∀ x : L,
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' x) =
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' x) :=
    fun _ => Subtype.ext rfl
  have hWu_K₁ : W_K₁ * IntermediateField.inclusion hM₁'K₁ u_M₁' = 1 := by
    dsimp [W_K₁, u_M₁']
    rw [hincl_diamond W, ← map_mul, ← map_mul, hWu_L, map_one, map_one]
  have hW_inv : W_K₁ * W_K₁⁻¹ = 1 := mul_inv_cancel₀ hW_ne0
  have hdenom_factor : ∀ N : M₁',
      IntermediateField.inclusion hM₁'K₁ (1 + u_M₁' * N) =
        W_K₁⁻¹ * (W_K₁ + IntermediateField.inclusion hM₁'K₁ N) := by
    intro N
    rw [map_add, map_one, map_mul]
    linear_combination (W_K₁⁻¹ * IntermediateField.inclusion hM₁'K₁ N) * hWu_K₁ -
      (1 + IntermediateField.inclusion hM₁'K₁ u_M₁' * IntermediateField.inclusion hM₁'K₁ N) * hW_inv
  have hwt_rew : ∀ N : M₁',
      IntermediateField.inclusion hM₁'K₁ N *
          (IntermediateField.inclusion hM₁'K₁ (1 + u_M₁' * N))⁻¹ =
        W_K₁ * IntermediateField.inclusion hM₁'K₁ N *
          (W_K₁ + IntermediateField.inclusion hM₁'K₁ N)⁻¹ := by
    intro N
    rw [hdenom_factor N, mul_inv, inv_inv]
    ring
  have hs_wt_rew : ∀ z : M₁',
      IntermediateField.inclusion hM₁'K₁ (z * (1 + n)⁻¹ ^ 2) =
        IntermediateField.inclusion hM₁'K₁ z * W_K₁ ^ 2 * (L_val ^ 2)⁻¹ := by
    intro z
    dsimp [n, L_val, b_K₁]
    rw [map_mul, map_pow, map_inv₀, hdenom_factor b, mul_inv, inv_inv, mul_pow, ← inv_pow]
    ring
  have hfb_val : fb = 0 ∨ -(((p * t₁ : ℕ) : ℤ)) ≤ valL F K₁ fb := by
    right
    have hfb_eq : fb = W_K₁ * b_K₁ * L_val⁻¹ := hwt_rew b
    have hWb_ne0 : W_K₁ * b_K₁ ≠ 0 := mul_ne_zero hW_ne0 hb_ne0
    have hLinv_ne0 : L_val⁻¹ ≠ 0 := inv_ne_zero hL_ne0
    rw [hfb_eq, hval_mul_K₁ (W_K₁ * b_K₁) L_val⁻¹ hWb_ne0 hLinv_ne0,
      hval_mul_K₁ W_K₁ b_K₁ hW_ne0 hb_ne0, hval_inv_elt_K₁ L_val hL_ne0,
      hW_val, hb_val, hL_val]
    omega
  exact ⟨hL_ne0, hD_ne0, hL_val, hD_val, hA_val, hL_xi_val,
    hW_ne0, hW_val, hb_ne0, hb_val, hΔ_xi_val, hwt_rew, hs_wt_rew, hfb_val⟩

theorem ld_ch12_wild_odd_tot_ram_conj_norm_weight_perturbations_and_teich_sum (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (Δ : K₁ˣ)
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (ξ Δ_conj : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hΔ_conj_approx : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
