        (hf a_idx (Finset.mem_insert_self a_idx s))
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hvalM₁'_natCast : ∀ (n : ℕ),
      ((n : ℕ) : M₁') = 0 ∨ (0 : ℤ) ≤ valL F M₁' ((n : ℕ) : M₁') := by
