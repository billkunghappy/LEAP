          have hb0 := hvalL_mul_bound 0 (2 * ((T : ℤ) - (r_U : ℤ)) + ((h : ℕ) : ℤ))
            c (b ^ 2 * A⁻¹) (Or.inr (by rw [hc_val])) hb2A_bound
          exact hb0.imp id (fun hle => by omega)
        have hucb2A_T :
            u * (c * (b ^ 2 * A⁻¹)) = 0 ∨ (T : ℤ) ≤ valL F L (u * (c * (b ^ 2 * A⁻¹))) := by
          have hb0 := hvalL_mul_bound (d_U : ℤ) (2 * ((T : ℤ) - (r_U : ℤ)) + ((h : ℕ) : ℤ))
            u (c * (b ^ 2 * A⁻¹)) hu_bound hcb2A_bound
          exact hb0.imp id (fun hle => by omega)
        have hdiff_T :
            u * (T_E' + 1) - u * T_M₁' = 0 ∨ (T : ℤ) ≤ valL F L (u * (T_E' + 1) - u * T_M₁') := by
          have hsub : u * (T_E' + 1) - u * T_M₁' = -(u * (c * (b ^ 2 * A⁻¹))) := by
            have htd : T_M₁' - T_E' - 1 = c * (b ^ 2 * A⁻¹) := hTrDiff_pos hh
            linear_combination -u * htd
          rw [hsub]
          rcases hucb2A_T with h0 | hle
          · left; rw [h0, neg_zero]
          · right; rw [hvalL_neg]; exact hle
        change (θM₁' (Units.mk0 (1 + IntermediateField.inclusion hLM₁' u) hu) : Ω F) =
          ψ (traceLM F hLM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' u))
        rw [hCR2, htr_M₁'_u]
        exact hψ_congr_T _ _ hdiff_T
    rw [← hθ_eq]
    exact inv_mul_cancel₀ (Units.ne_zero _)
  · intro hT_odd v hv_bound hv hw
    let d_E : ℕ := mE' / 2
    let d_T : ℕ := T / 2
    let N_xv : L := normLM F hLE' (x * v)
    have hd_E_def : d_E = mE' / 2 := rfl
    have hd_T_def : d_T = T / 2 := rfl
    have hMv0 : (θE' (Units.mk0 (1 + v) hv) : Ω F) =
        ψ (((c_ν⁻¹ : Lˣ) : L) *
          ((A + c) * traceLM F hLE' v + A * normLM F hLE' v)) :=
      hMaster v
        (hv_bound.imp id (fun hle => by omega))
        (hv_bound.imp id (fun hle => by omega))
        (hv_bound.imp id (fun hle => by omega))
        (hv_bound.imp id (fun hle => by omega))
        hv
    have hAN_v : A * normLM F hLE' v = N_xv := (map_mul (normLM F hLE') x v).symm
    let P : Ω F := ψ (((c_ν⁻¹ : Lˣ) : L) * ((A + c) * traceLM F hLE' v))
    let Q : Ω F := ψ (((c_ν⁻¹ : Lˣ) : L) * N_xv)
    have hMv : (θE' (Units.mk0 (1 + v) hv) : Ω F) = P * Q := by
      rw [hMv0, hAN_v]
      have hexp : ((c_ν⁻¹ : Lˣ) : L) * ((A + c) * traceLM F hLE' v + N_xv) =
          ((c_ν⁻¹ : Lˣ) : L) * ((A + c) * traceLM F hLE' v) +
            ((c_ν⁻¹ : Lˣ) : L) * N_xv := by ring
      rw [hexp, AddChar.map_add_eq_mul]
    let w : E' := σ_E x * v
    have hw_bound : w = 0 ∨ (d_T : ℤ) ≤ valL F E' w := by
      have hσx_bound : σ_E x = 0 ∨ -((h : ℕ) : ℤ) ≤ valL F E' (σ_E x) := by
        right; rw [hσ_E_val x, hx_val]
      have hb0 := hvalE'_mul_bound (-((h : ℕ) : ℤ)) (d_E : ℤ) (σ_E x) v hσx_bound hv_bound
      change w = 0 ∨ -((h : ℕ) : ℤ) + (d_E : ℤ) ≤ valL F E' w at hb0
      exact hb0.imp id (fun hle => by omega)
    have htr_w : traceLM F hLE' w = 0 ∨ (r_T : ℤ) ≤ valL F L (traceLM F hLE' w) :=
      htr_bound_LE' (r_T : ℤ) w (hw_bound.imp id (fun hle => by omega))
    have hnorm_w_eq : normLM F hLE' w = N_xv := by
      dsimp only [w, N_xv]
      rw [map_mul, map_mul, hnorm_σx]
    have hN_xv_bound : N_xv = 0 ∨ (d_T : ℤ) ≤ valL F L N_xv := by
      rw [← hnorm_w_eq]
      rcases hw_bound with h0 | hle
      · left; rw [h0, hnorm_zero_E']
      · right; rw [hval_norm_LE' w]; exact hle
    let R : Ω F := ψ (((c_ν⁻¹ : Lˣ) : L) * traceLM F hLE' w)
    have htr_cE_v :
        traceLM F hLE' (((cE'⁻¹ : E'ˣ) : E') * v) =
          ((c_ν⁻¹ : Lˣ) : L) *
            ((A + c) * traceLM F hLE' v + traceLM F hLE' w -
              c * b * traceLM F hLE' (v * x⁻¹)) := by
      rw [hcE'_inv_pos hh, mul_assoc, hxy_pos_id hh v, htr_smul_E',
        map_sub, map_add, htr_smul_E', htr_smul_E']
    have hx_inv_val : valL F E' x⁻¹ = ((h : ℕ) : ℤ) := by
      have h1 := hvalE'_inv (Units.mk0 x hx_ne)
      simp only [Units.val_inv_eq_inv_val, Units.val_mk0] at h1
      rw [h1, hx_val, neg_neg]
    have hvx_inv_bound : v * x⁻¹ = 0 ∨ (d_E : ℤ) + ((h : ℕ) : ℤ) ≤ valL F E' (v * x⁻¹) :=
      hvalE'_mul_bound (d_E : ℤ) ((h : ℕ) : ℤ) v x⁻¹ hv_bound (Or.inr (by rw [hx_inv_val]))
    have htr_vx_inv_rU :
        traceLM F hLE' (v * x⁻¹) = 0 ∨ (r_U : ℤ) ≤ valL F L (traceLM F hLE' (v * x⁻¹)) :=
      htr_bound_LE' (r_U : ℤ) (v * x⁻¹) (hvx_inv_bound.imp id (fun hle => by omega))
    have hcb_bound : c * b = 0 ∨ (T : ℤ) - (r_U : ℤ) ≤ valL F L (c * b) := by
      have hb0 := hvalL_mul_bound 0 ((T : ℤ) - (r_U : ℤ)) c b
        (Or.inr (by rw [hc_val])) hb_val'
      exact hb0.imp id (fun hle => by omega)
    have hcb_tr_T :
        c * b * traceLM F hLE' (v * x⁻¹) = 0 ∨
          (T : ℤ) ≤ valL F L (c * b * traceLM F hLE' (v * x⁻¹)) := by
      have hb0 := hvalL_mul_bound ((T : ℤ) - (r_U : ℤ)) (r_U : ℤ)
        (c * b) (traceLM F hLE' (v * x⁻¹)) hcb_bound htr_vx_inv_rU
      exact hb0.imp id (fun hle => by omega)
    have hψE'_v : ψE' (((cE'⁻¹ : E'ˣ) : E') * v) = P * R := by
      change ψ (traceLM F hLE' (((cE'⁻¹ : E'ˣ) : E') * v)) = P * R
      rw [htr_cE_v]
      have hdiff_T :
          ((A + c) * traceLM F hLE' v + traceLM F hLE' w -
              c * b * traceLM F hLE' (v * x⁻¹)) -
            ((A + c) * traceLM F hLE' v + traceLM F hLE' w) = 0 ∨
          (T : ℤ) ≤ valL F L
            (((A + c) * traceLM F hLE' v + traceLM F hLE' w -
                c * b * traceLM F hLE' (v * x⁻¹)) -
              ((A + c) * traceLM F hLE' v + traceLM F hLE' w)) := by
        have hsub : ((A + c) * traceLM F hLE' v + traceLM F hLE' w -
            c * b * traceLM F hLE' (v * x⁻¹)) -
          ((A + c) * traceLM F hLE' v + traceLM F hLE' w) =
          -(c * b * traceLM F hLE' (v * x⁻¹)) := by ring
        rw [hsub]
        rcases hcb_tr_T with h0 | hle
        · left; rw [h0, neg_zero]
        · right; rw [hvalL_neg]; exact hle
      rw [hψ_congr_T _ _ hdiff_T]
      have hexp : ((c_ν⁻¹ : Lˣ) : L) * ((A + c) * traceLM F hLE' v + traceLM F hLE' w) =
          ((c_ν⁻¹ : Lˣ) : L) * ((A + c) * traceLM F hLE' v) +
            ((c_ν⁻¹ : Lˣ) : L) * traceLM F hLE' w := by ring
      rw [hexp, AddChar.map_add_eq_mul]
    let u' : L := (1 + N_xv)⁻¹ * traceLM F hLE' w
    have hval_1N_inv : valL F L ((1 + N_xv)⁻¹) = 0 := by
      have hval_1N := hvalL_one_add_eq_zero N_xv (hN_xv_bound.imp id (fun hle => by omega)) hw
      have h1 := hvalL_inv (Units.mk0 (1 + N_xv) hw)
      simp only [Units.val_inv_eq_inv_val, Units.val_mk0] at h1
      rw [h1, hval_1N, neg_zero]
    have hu'_bound : u' = 0 ∨ (r_T : ℤ) ≤ valL F L u' := by
      have hb0 := hvalL_mul_bound 0 (r_T : ℤ) ((1 + N_xv)⁻¹) (traceLM F hLE' w)
        (Or.inr (by rw [hval_1N_inv])) htr_w
      change u' = 0 ∨ 0 + (r_T : ℤ) ≤ valL F L u' at hb0
      exact hb0.imp id (fun hle => by omega)
    have hu'1 : 1 + u' ≠ 0 :=
      hone_add_ne_zero_L u' (hu'_bound.imp id (fun hle => by omega))
    have hw1 : 1 + w ≠ 0 :=
      hone_add_ne_zero_E' w (hw_bound.imp id (fun hle => by omega))
    have hnorm_1w : normLM F hLE' (1 + w) = (1 + N_xv) * (1 + u') := by
      have hq := ((hQuadNorm L E' hLE' hdeg2).2 1 w).1
      rw [map_one] at hq
      rw [hq, hnorm_w_eq]
      dsimp only [u']
      linear_combination traceLM F hLE' w * (mul_inv_cancel₀ hw).symm
    have hunit_prod :
        Units.mk0 (1 + N_xv) hw * Units.mk0 (1 + u') hu'1 =
          Units.map (normLM F hLE') (Units.mk0 (1 + w) hw1) := by
      ext
      simp [Units.val_mk0, hnorm_1w]
    have hν_prod :
        (νE' (Units.mk0 (1 + N_xv) hw) : Ω F) * (νE' (Units.mk0 (1 + u') hu'1) : Ω F) = 1 := by
      have h1 : νE' (Units.mk0 (1 + N_xv) hw * Units.mk0 (1 + u') hu'1) = 1 := by
        rw [← hνE'_ker]
        exact ⟨Units.mk0 (1 + w) hw1, hunit_prod.symm⟩
      rw [map_mul] at h1
      simpa only [Units.val_mul, Units.val_one] using congrArg Units.val h1
    have hν_eq_u' :
        (νE' (Units.mk0 (1 + N_xv) hw) : Ω F) = (νE' (Units.mk0 (1 + u') hu'1) : Ω F) := by
      have hsq := hνE'_sq (Units.mk0 (1 + N_xv) hw)
      linear_combination
        (νE' (Units.mk0 (1 + u') hu'1) : Ω F) * hsq -
        (νE' (Units.mk0 (1 + N_xv) hw) : Ω F) * hν_prod
    have hu'_diff_T :
        u' - traceLM F hLE' w = 0 ∨ (T : ℤ) ≤ valL F L (u' - traceLM F hLE' w) := by
      have hsub : u' - traceLM F hLE' w = -(u' * N_xv) := by
        dsimp only [u']
        linear_combination traceLM F hLE' w * mul_inv_cancel₀ hw
      rw [hsub]
      have hb0 := hvalL_mul_bound (r_T : ℤ) (d_T : ℤ) u' N_xv hu'_bound hN_xv_bound
      rcases hb0 with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rw [hvalL_neg]; omega
    have hν_eq_R : (νE' (Units.mk0 (1 + N_xv) hw) : Ω F) = R := by
      rw [hν_eq_u', hc_ν_stat u' hu'_bound hu'1]
      exact hψ_congr_T u' (traceLM F hLE' w) hu'_diff_T
    have hP_ne : P ≠ 0 :=
      left_ne_zero_of_mul (hMv ▸ Units.ne_zero (θE' (Units.mk0 (1 + v) hv)))
    change (θE' (Units.mk0 (1 + v) hv) : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * v) =
      ((νE' (Units.mk0 (1 + N_xv) hw) : Ω F)⁻¹ * Q)⁻¹
    rw [hMv, hψE'_v, hν_eq_R, mul_inv, mul_inv, inv_inv]
    linear_combination (Q⁻¹ * R) * inv_mul_cancel₀ hP_ne

theorem ld_ch12_wild_dyadic_unramified_e_stat_and_crit_rec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hνM₁'_val : ∀ x : Lˣ, (νM₁' x : Ω F) = (-1 : Ω F) ^ (valL F L (x : L)))
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' θE'), θE' u = 1)
    (hCommonRest : ∀ x : Lˣ,
      θE' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) * νE' x =
      θM₁' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) * νM₁' x)
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hξM₁'_ker : ∀ z : M₁'ˣ,
      z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔
        (νE'.comp (Units.map (normLM F hLM₁'))) z = 1)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = 2 * valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = 2 * valL F M₁' z)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (d : M₁') (c : L) (σ_E : E' ≃ₐ[F] E')
    (hd_val : valL F M₁' d = 0) (hc_val : valL F L c = 0)
    (hd_tr : traceLM F hLM₁' d = 1) (hd_norm : normLM F hLM₁' d = -c)
    (hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c)
    (hσ_E_L : ∀ x : L,
      σ_E (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ_E_val : ∀ y : E', valL F E' (σ_E y) = valL F E' y)
    (hσ_E_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ_E y)
    (hσ_E_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ_E y)
    (hσ_E_twist : ∀ y : E'ˣ,
      θE' (Units.map σ_E.toRingEquiv.toMonoidHom y) =
        (νM₁'.comp (Units.map (normLM F hLE'))) y * θE' y)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (c_ν : Lˣ) (x : E') (C : K₁ˣ) (cM₁' : M₁'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u))
    (hcM₁'_eq : cM₁' = (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) *
      (Units.map (normLM F hM₁'K₁) C)⁻¹)
    (hZM₁'_coe : ((Units.map (normLM F hM₁'K₁) C : M₁'ˣ) : M₁') =
      IntermediateField.inclusion hLM₁' (normLM F hLE' x) +
        IntermediateField.inclusion hLM₁' (traceLM F hLE' x) * d + d ^ 2)
    (hZE'_coe : ((Units.map (normLM F hE'K₁) C : E'ˣ) : E') =
      x ^ 2 + x - IntermediateField.inclusion hLE' c)
    (hZE'_val : valL F E' ((Units.map (normLM F hE'K₁) C : E'ˣ) : E') =
      -2 * ((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
    (hb_val : traceLM F hLE' x = 0 ∨
      (condExp F L νE' : ℤ) - (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤
        valL F L (traceLM F hLE' x))
    (hx_zero : condExp F M₁' θM₁' - condExp F L νE' = 0 → (x = 0 ∨ 0 ≤ valL F E' x))
    (hx_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' →
      x ≠ 0 ∧
      valL F E' x = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ) ∧
      valL F L (normLM F hLE' x) = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ)) :
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let mE' := condExp F E' θE'
    let h := mM₁' - T
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let A := normLM F hLE' x
    let b := traceLM F hLE' x
    ∃ (cE' : E'ˣ),
      valL F E' (cE' : E') = (mE' : ℤ) + condExpChar F E' ψE' ∧
      (∀ y : E', (y = 0 ∨ (((mE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
        ∀ hy : 1 + y ≠ 0,
          (θE' (Units.mk0 (1 + y) hy) : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * y)) ∧
      (h = 0 → cE' = (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) *
        (Units.map (normLM F hE'K₁) C)⁻¹) ∧
      (θE' cE' : Ω F) * (νE' c_ν : Ω F) =
        (-1 : Ω F) ^ h * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) ∧
      (h = 0 →
        traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
          traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
          (4 * A - b ^ 2) + 4 * c) ∧
      (0 < h →
        traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
          traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
          c * (b ^ 2 * A⁻¹) ∧
        (∀ u : L, (u = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F L u) →
          ∀ hu : 1 + IntermediateField.inclusion hLM₁' u ≠ 0,
            (θM₁' (Units.mk0 (1 + IntermediateField.inclusion hLM₁' u) hu) : Ω F)⁻¹ *
              ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' u) = 1) ∧
        (T % 2 = 1 →
          ∀ v : E', (v = 0 ∨ ((mE' / 2 : ℕ) : ℤ) ≤ valL F E' v) →
            ∀ (hv : 1 + v ≠ 0) (hw : 1 + normLM F hLE' (x * v) ≠ 0),
              (θE' (Units.mk0 (1 + v) hv) : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * v) =
                ((νE' (Units.mk0 (1 + normLM F hLE' (x * v)) hw) : Ω F)⁻¹ *
                  ψ (((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' (x * v)))⁻¹)) :=
by
  have hψ_triv := (ld_condExp_and_condExpChar_spec F L ψ hψ νE').1
  have hA_bound : normLM F hLE' x = 0 ∨
      -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ) ≤ valL F L (normLM F hLE' x) := by
    by_cases hh0 : condExp F M₁' θM₁' - condExp F L νE' = 0
    · rcases hx_zero hh0 with hx0 | hx_ge0
      · right
        rw [hval_norm_LE', hx0, (ld_valL_and_unitGroup_props F E').1]
        omega
      · right
        rw [hval_norm_LE']
        omega
    · right
      have hh_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' := Nat.pos_of_ne_zero hh0
      exact le_of_eq (hx_pos hh_pos).2.2.symm
  obtain ⟨cE', hcE'_val, hcE'_eq_zero, hcE'_inv_zero, hcE'_inv_pos,
    hMultPref, hTrDiff_zero, hTrDiff_pos⟩ :=
    ld_ch12_wild_dyadic_unramified_cE_prefactor_and_trace_diff F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' ψ νE' νM₁' hνM₁'_val
      θE' θM₁' θK₁ hχE'_comp hχM₁'_comp hCommonRest hmE'_eq hnE'_eq hval_LE'
      d c σ_E hd_tr hd_sq hσ_E_L hσ_E_val hσ_E_tr hσ_E_norm hσ_E_twist hQuadNorm
      c_ν x C cM₁' hc_ν_val hcM₁'_eq hZM₁'_coe hZE'_coe hZE'_val hx_pos
  have hMaster := fun (y : E') hy_rT hy_3mE hy_rU hy_trU hy =>
    ld_ch12_wild_dyadic_unramified_k1_norm_pullback_master F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' hdegE'K₁ hdegM₁'K₁
      ψ hψ_triv νE' hbE'_ge2 θE' θM₁' θK₁ hχE'_comp hχM₁'_comp hθE'_triv
      hT_le hmE'_eq hξM₁'_ker
      hval_LM₁' hval_norm_LM₁' hval_LE' hval_norm_LE'
      htr_bound_LM₁' htr_bound_LE' hDiamond_E' hDiamond_M₁'
      d c σ_E hd_val hc_val hd_tr hd_norm hd_sq hσ_E_L hσ_E_tr hσ_E_norm hQuadNorm
      c_ν x C cM₁' hc_ν_val hc_ν_stat hcM₁'_eq hZM₁'_coe hcM₁'_stat hb_val hA_bound
      y hy_rT hy_3mE hy_rU hy_trU hy
  obtain ⟨hcE'_stat, hPosDed⟩ :=
    ld_ch12_wild_dyadic_unramified_cE_stat_and_crit_deductions F L E' M₁'
      hLE' hLM₁' hdeg2 ψ hψ_triv νE' νM₁' hνE'_pow hνE'_ker hbE'_ge2 hνM₁'_val
      θE' θM₁' hCommonRest hT_le hmE'_eq
      hval_LM₁' hval_LE' hval_norm_LE' htr_bound_LE'
      c σ_E hc_val hσ_E_val hσ_E_tr hσ_E_norm hQuadNorm
      c_ν x cM₁' cE' hc_ν_val hc_ν_stat hcM₁'_stat hb_val hx_zero hx_pos
      hcE'_inv_zero hcE'_inv_pos hTrDiff_pos hMaster
  refine ⟨cE', hcE'_val, hcE'_stat, hcE'_eq_zero, hMultPref, hTrDiff_zero, ?_⟩
  intro hh
  exact ⟨hTrDiff_pos hh, (hPosDed hh).1, (hPosDed hh).2⟩

theorem ld_ch12_wild_dyadic_unramified_artin_schreier_prefactor_sign (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = 2 * valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (d : M₁') (c : L) (σ_E : E' ≃ₐ[F] E')
    (hc_val : valL F L c = 0)
    (hd_tr : traceLM F hLM₁' d = 1) (hd_norm : normLM F hLM₁' d = -c)
    (hσ_E_val : ∀ y : E', valL F E' (σ_E y) = valL F E' y)
    (hσ_E_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ_E y)
    (hσ_E_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ_E y)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (c_ν : Lˣ) (x : E') (cM₁' : M₁'ˣ) (cE' : E'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u))
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (hu_even : condExp F M₁' θM₁' % 2 = 0 →
      ((if condExp F M₁' θM₁' - condExp F L νE' = 0 then (4 : L)
        else (traceLM F hLE' x) ^ 2 * (normLM F hLE' x)⁻¹) = 0 ∨
        (condExp F L νE' : ℤ) ≤
          valL F L (if condExp F M₁' θM₁' - condExp F L νE' = 0 then (4 : L)
            else (traceLM F hLE' x) ^ 2 * (normLM F hLE' x)⁻¹)))
    (hu_odd : condExp F M₁' θM₁' % 2 = 1 →
      (if condExp F M₁' θM₁' - condExp F L νE' = 0 then (4 : L)
        else (traceLM F hLE' x) ^ 2 * (normLM F hLE' x)⁻¹) ≠ 0 ∧
      valL F L (if condExp F M₁' θM₁' - condExp F L νE' = 0 then (4 : L)
        else (traceLM F hLE' x) ^ 2 * (normLM F hLE' x)⁻¹) = (condExp F L νE' : ℤ) - 1)
    (hdisc_zero : condExp F M₁' θM₁' - condExp F L νE' = 0 →
      (4 * normLM F hLE' x - (traceLM F hLE' x) ^ 2 = 0 ∨
        (condExp F L νE' : ℤ) ≤ valL F L (4 * normLM F hLE' x - (traceLM F hLE' x) ^ 2)))
    (hx_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' →
      x ≠ 0 ∧
      valL F E' x = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ) ∧
      valL F L (normLM F hLE' x) = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ))
    (hMultPref :
      (θE' cE' : Ω F) * (νE' c_ν : Ω F) =
        (-1 : Ω F) ^ (condExp F M₁' θM₁' - condExp F L νE') *
          (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F))
    (hTrDiff_zero : condExp F M₁' θM₁' - condExp F L νE' = 0 →
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
        traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
        (4 * normLM F hLE' x - (traceLM F hLE' x) ^ 2) + 4 * c)
    (hTrDiff_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' →
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
        traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
        c * ((traceLM F hLE' x) ^ 2 * (normLM F hLE' x)⁻¹)) :
    let T := condExp F L νE'
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
        ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) =
      (-1 : Ω F) ^ T * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) *
        ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) :=
by
  intro T ψE' ψM₁'
  set mM₁' := condExp F M₁' θM₁'
  set h := mM₁' - T
  set r_T := (T + 1) / 2
  set d_T := T / 2
  set n := condExpChar F L ψ
  set A := normLM F hLE' x
  set b := traceLM F hLE' x
  set u_frak : L := if h = 0 then (4 : L) else b ^ 2 * A⁻¹
  
  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, _, _⟩ :=
    ld_condExp_and_condExpChar_spec F L ψ hψ νE'
  have hvalL_mono : ∀ {k₁ k₂ : ℤ} {z : L}, k₁ ≤ k₂ →
      (z = 0 ∨ k₂ ≤ valL F L z) → (z = 0 ∨ k₁ ≤ valL F L z) := by
    intro k₁ k₂ z hk hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hz)
  have hvalL_sub : ∀ (k : ℤ) (z₁ z₂ : L),
      (z₁ = 0 ∨ k ≤ valL F L z₁) → (z₂ = 0 ∨ k ≤ valL F L z₂) →
      (z₁ - z₂ = 0 ∨ k ≤ valL F L (z₁ - z₂)) := by
    intro k z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    apply hvalL_add k z₁ (-z₂) hz₁
    rcases hz₂ with rfl | hz₂
    · left; exact neg_zero
    · right; rwa [hvalL_neg]
  have hvalL_mul_ge : ∀ (k₁ k₂ : ℤ) (z₁ z₂ : L),
      (z₁ = 0 ∨ k₁ ≤ valL F L z₁) → (z₂ = 0 ∨ k₂ ≤ valL F L z₂) →
      (z₁ * z₂ = 0 ∨ k₁ + k₂ ≤ valL F L (z₁ * z₂)) := by
    intro k₁ k₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · left; rw [hz₁0, zero_mul]
    · by_cases hz₂0 : z₂ = 0
      · left; rw [hz₂0, mul_zero]
      · right
        have hk₁ : k₁ ≤ valL F L z₁ := hz₁.resolve_left hz₁0
        have hk₂ : k₂ ≤ valL F L z₂ := hz₂.resolve_left hz₂0
        rw [hvalL_mul z₁ z₂ hz₁0 hz₂0]
        omega
  have hvalL_inv0 : ∀ (z : L) (hz : z ≠ 0), valL F L (z⁻¹) = - valL F L z := by
    intro z hz
    have hinv := hvalL_inv (Units.mk0 z hz)
    rwa [Units.val_inv_eq_inv_val] at hinv
  have hc_ν_inv_val : valL F L ((c_ν⁻¹ : Lˣ) : L) = -((T : ℤ) + n) := by
    rw [hvalL_inv c_ν, hc_ν_val]
  have hψ_cν_triv : ∀ z : L, (z = 0 ∨ (T : ℤ) ≤ valL F L z) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * z) = 1 := by
    intro z hz
    have hm := hvalL_mul_ge (-((T : ℤ) + n)) (T : ℤ) ((c_ν⁻¹ : Lˣ) : L) z
      (Or.inr (le_of_eq hc_ν_inv_val.symm)) hz
    exact hψ_triv (((c_ν⁻¹ : Lˣ) : L) * z) (hvalL_mono (by omega) hm)
  have h1_add_ne_zero : ∀ u : L, (u = 0 ∨ 1 ≤ valL F L u) → 1 + u ≠ 0 := by
    intro u hu h0
    have hu_eq : u = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hu_eq] at hu
    rcases hu with hneg0 | hle
    · exact neg_ne_zero.mpr one_ne_zero hneg0
    · rw [hvalL_neg1] at hle
      omega
  have hνE'_sq_one : ∀ u : Lˣ, (νE' u : Ω F) ^ 2 = 1 := by
    intro u
    have hpow := hνE'_pow
    rw [hdeg2] at hpow
    have hu := congrArg (fun (χ : Lˣ →* (Ω F)ˣ) => (χ u : Ω F)) hpow
    simpa using hu
  have hψ_cν_two : ∀ z : L, (z = 0 ∨ (r_T : ℤ) ≤ valL F L z) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * ((2 : L) * z)) = 1 := by
    intro z hz
    have hz1 : z = 0 ∨ 1 ≤ valL F L z := hvalL_mono (by omega) hz
    have h1z : 1 + z ≠ 0 := h1_add_ne_zero z hz1
    have htwo : ((c_ν⁻¹ : Lˣ) : L) * ((2 : L) * z) =
        ((c_ν⁻¹ : Lˣ) : L) * z + ((c_ν⁻¹ : Lˣ) : L) * z := by ring
    rw [htwo, AddChar.map_add_eq_mul, ← sq, ← hc_ν_stat z hz h1z]
    exact hνE'_sq_one (Units.mk0 (1 + z) h1z)
  
  have htr_LE'_smul : ∀ (a : L) (y : E'),
      traceLM F hLE' (IntermediateField.inclusion hLE' a * y) = a * traceLM F hLE' y := by
    intro a y
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLE')).map_smul' a
      (toExtendScalars F hLE' y)
  have htr_LM₁'_smul : ∀ (a : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a * z) = a * traceLM F hLM₁' z := by
    intro a z
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' a
      (toExtendScalars F hLM₁' z)
  set TM₁' : L :=
    traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁'))
  set TE' : L :=
    traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E'))
  set Δ : L := TM₁' - TE' - 1
  have hψM₁'_eq : ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) = ψ (((c_ν⁻¹ : Lˣ) : L) * TM₁') := by
    change ψ (traceLM F hLM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁'))) = _
    have hmul : (((cM₁'⁻¹ : M₁'ˣ) : M₁')) =
        IntermediateField.inclusion hLM₁' ((c_ν⁻¹ : Lˣ) : L) *
          (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) := by
      rw [← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
    rw [hmul, htr_LM₁'_smul]
  have hψE'_eq : ψE' (((cE'⁻¹ : E'ˣ) : E')) = ψ (((c_ν⁻¹ : Lˣ) : L) * TE') := by
    change ψ (traceLM F hLE' (((cE'⁻¹ : E'ˣ) : E'))) = _
    have hmul : (((cE'⁻¹ : E'ˣ) : E')) =
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) *
          (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) := by
      rw [← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
    rw [hmul, htr_LE'_smul]
