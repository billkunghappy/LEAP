theorem ld_ch10_fml_wild_ramified (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hMinCond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L χ' ≤ condExp F L (ν₁ ^ j * χ'))
    (hRam : condExp F L ν₁ ≠ 0)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  obtain ⟨hb_ge2, hν_cond_eq, hqK, hval_norm, hnK, hCond_le, hCond_gt, hW0⟩ :=
    ld_ch10_wild_ramification_and_cond_formulas F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hRam hEqP
  by_cases ha0 : condExp F L χ' = 0
  · exact hW0 ha0
  · have ha_ge1 : 1 ≤ condExp F L χ' := Nat.one_le_iff_ne_zero.mpr ha0
    by_cases hab : condExp F L χ' ≤ condExp F L ν₁
    · obtain ⟨haK, htwist_cond⟩ := hCond_le hab
      exact ld_ch10_fml_wild_low_cond F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
        hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hRam hEqP
        hb_ge2 hν_cond_eq hqK hval_norm hnK ha_ge1 hab haK htwist_cond
    · have hba : condExp F L ν₁ < condExp F L χ' := not_le.mp hab
      obtain ⟨haK, htwist_cond⟩ := hCond_gt hba
      by_cases ha2b : condExp F L χ' < 2 * condExp F L ν₁
      · exact ld_ch10_fml_wild_mid_cond F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
          hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hRam hEqP
          hb_ge2 hν_cond_eq hqK hval_norm hnK hba ha2b haK htwist_cond
      · have h2ba : 2 * condExp F L ν₁ ≤ condExp F L χ' := not_lt.mp ha2b
        exact ld_ch10_fml_wild_stable_cond F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
          hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hRam hEqP
          hb_ge2 hν_cond_eq hqK hval_norm hnK h2ba haK htwist_cond

theorem ld_ch10_first_main_lemma_cyclic (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hMC : M_C = L)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D₀ : List (MonomialTerm F L))
    (hD₀_sub : IsSubMonomialDecomp F L M_C E hLE D₀)
    (hD₀_rest1 : ∀ t ∈ D₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) :
    tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
    tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (D₀.map (twistMonomialTerm F L χL_ext)) :=
by
  have hL_MC : L = M_C := hMC.symm
  have hK_E : K = E := h_sup.symm.trans (sup_eq_left.mpr (hMC ▸ hLE))
  subst hL_MC
  subst hK_E
  obtain ⟨hPrime, hAb, μ₁, hμ₁_weil, hμ₁_rest, hμ₁_pow, hμ₁_ne, heval_D₀, heval_Dt⟩ :=
    ld_ch10_monomial_list_to_cyclic_char_prod F rec L K hLK hGal ψ hψ hMin χL_ext hχL_ext
      D₀ hD₀_sub hD₀_rest1
  rw [heval_D₀, heval_Dt]
  obtain ⟨ν₁, χ', hν₁_pow, hν₁_ne, hν₁_ker, hν₁_cond, hχ'_cond, hχ'K_cond, hMinCond, hRed⟩ :=
    ld_ch10_recChar_norm_and_min_cond_reduction F rec L K hLK hGal hAb hPrime ψ hψ
      μ₁ χL_ext hμ₁_weil hμ₁_rest hμ₁_pow hμ₁_ne hχL_ext
  apply hRed
  by_cases hUnram : condExp F L ν₁ = 0
  · exact ld_ch10_fml_unramified F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
      hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hUnram
  · by_cases hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F
    · exact ld_ch10_fml_wild_ramified F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
        hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hUnram hEqP
    · exact ld_ch10_fml_tame_ramified F L K hLK hGal hAb hPrime ψ hψ ν₁ χ'
        hν₁_pow hν₁_ne hν₁_ker hν₁_cond hχ'_cond hχ'K_cond hMinCond hUnram hEqP

theorem ld_ch13_14_sub_monomial_invariance_and_descent (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext)) :
    (∀ (D₀ D₁ : List (MonomialTerm F L)),
      IsSubMonomialDecomp F L M_C E hLE D₀ →
      IsSubMonomialDecomp F L M_C E hLE D₁ →
      tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ D₁ =
      tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (D₁.map (twistMonomialTerm F L χL_ext)) →
      tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
      tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (D₀.map (twistMonomialTerm F L χL_ext))) ∧
    (∀ (F' E' : IntermediateField F (AlgebraicClosure F))
      (hLF' : L ≤ F') (hF'E' : F' ≤ E') (hE'K : E' ≤ K),
      L < F' →
      ∀ (χF' : relWeil F F' →* (Ω F)ˣ),
        IsWeilRep F F' (charRep F F' χF') →
      ∀ (D_F' : List (MonomialTerm F F')),
        IsMonomialDecomp F F'
          (fun w => (⟨1, E', hF'E', 1⟩ : MonomialTerm F F').trace F F' w) D_F' →
        (∀ t ∈ D_F', t.field ≤ K) →
        tateEpsUnit F E' (recChar F rec E' (restrictWeilChar F hF'E' χF'))
            (traceChar F (hLF'.trans hF'E') ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ) D_F' =
        tateEpsUnit F E' (recChar F rec E' 1)
            (traceChar F (hLF'.trans hF'E') ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)
            (D_F'.map (twistMonomialTerm F F' χF'))) :=
by
  have htrace_append : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (D₁ D₂ : List (MonomialTerm F M)) (w : relWeil F M),
      monomialListTrace F M (D₁ ++ D₂) w =
        monomialListTrace F M D₁ w + monomialListTrace F M D₂ w := by
    intro M D₁ D₂ w
    simp [monomialListTrace, List.map_append, List.sum_append]
  have htrace_neg : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (D : List (MonomialTerm F M)) (w : relWeil F M),
      monomialListTrace F M (D.map (MonomialTerm.neg F M)) w =
        - monomialListTrace F M D w := by
    intro M D w
    induction D with
    | nil => simp [monomialListTrace]
    | cons t tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F M).trace F M w = - (t.trace F M w) := by
        simp [MonomialTerm.neg, MonomialTerm.trace, neg_smul]
      rw [ht, ih]
      ring
  have heval_append : ∀ (lam : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)), AddChar L' (Ω F) → (Ω F)ˣ)
      (M : IntermediateField F (AlgebraicClosure F))
      (ψM : AddChar M (Ω F)) (D₁ D₂ : List (MonomialTerm F M)),
      evalMonomialList F rec lam M ψM (D₁ ++ D₂) =
        evalMonomialList F rec lam M ψM D₁ * evalMonomialList F rec lam M ψM D₂ := by
    intro lam M ψM D₁ D₂
    simp [evalMonomialList, List.map_append, List.prod_append]
  have heval_neg : ∀ (lam : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)), AddChar L' (Ω F) → (Ω F)ˣ)
      (M : IntermediateField F (AlgebraicClosure F))
      (ψM : AddChar M (Ω F)) (D : List (MonomialTerm F M)),
      evalMonomialList F rec lam M ψM (D.map (MonomialTerm.neg F M)) =
        (evalMonomialList F rec lam M ψM D)⁻¹ := by
    intro lam M ψM D
    induction D with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have ht : evalMonomialTerm F rec lam M ψM (t.neg F M) =
          (evalMonomialTerm F rec lam M ψM t)⁻¹ := by
        simp [MonomialTerm.neg, evalMonomialTerm, zpow_neg]
      rw [ht, ih, mul_inv]
  have heval_cons : ∀ (lam : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)), AddChar L' (Ω F) → (Ω F)ˣ)
      (M : IntermediateField F (AlgebraicClosure F))
      (ψM : AddChar M (Ω F)) (t : MonomialTerm F M) (tl : List (MonomialTerm F M)),
      evalMonomialList F rec lam M ψM (t :: tl) =
        evalMonomialTerm F rec lam M ψM t * evalMonomialList F rec lam M ψM tl := by
    intro lam M ψM t tl
    simp [evalMonomialList]
  have htwist_wf : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (χM : relWeil F M →* (Ω F)ˣ),
      IsWeilRep F M (charRep F M χM) →
      ∀ (t : MonomialTerm F M), t.Wf F M → (twistMonomialTerm F M χM t).Wf F M := by
    clear! rec L K M_C E ψ χL_ext
    clear htrace_append htrace_neg
    intro M χM hχM t ht
    refine ⟨ht.1, ht.2.1, ht.2.2.1, ?_⟩
    obtain ⟨U₁, hU₁, htriv₁⟩ := ht.2.2.2
    obtain ⟨U₂, hU₂, htriv₂⟩ := hχM.2
    refine ⟨U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    let wM : relWeil F M := Subgroup.inclusion (relWeil_antitone F t.le) w
    have hw₁ := htriv₁ w hw.1 hwI
    have hw₂ := htriv₂ wM hw.2 hwI
    have h1 : (t.χ w : Ω F) = 1 := by
      have happ := congrArg (fun (f : ULift.{u} (Ω F) →ₗ[Ω F] ULift.{u} (Ω F)) => (f (ULift.up 1)).down) hw₁
      change (t.χ w : Ω F) * (1 : Ω F) = 1 at happ
      rwa [mul_one] at happ
    have h2 : (restrictWeilChar F t.le χM w : Ω F) = 1 := by
      have happ := congrArg (fun (f : ULift.{u} (Ω F) →ₗ[Ω F] ULift.{u} (Ω F)) => (f (ULift.up 1)).down) hw₂
      change (restrictWeilChar F t.le χM w : Ω F) * (1 : Ω F) = 1 at happ
      rwa [mul_one] at happ
    change ((t.χ * restrictWeilChar F t.le χM) w : Ω F) • LinearMap.id = 1
    have hmul : ((t.χ * restrictWeilChar F t.le χM) w : Ω F) = 1 := by
      change (t.χ w : Ω F) * (restrictWeilChar F t.le χM w : Ω F) = 1
      rw [h1, h2, mul_one]
    rw [hmul, one_smul]
    rfl
  have htwist_trace : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (χM : relWeil F M →* (Ω F)ˣ)
      (t : MonomialTerm F M) (w : relWeil F M),
      (twistMonomialTerm F M χM t).trace F M w = (χM w : Ω F) * t.trace F M w := by
    clear! rec L K M_C E ψ χL_ext
    clear htrace_append htrace_neg htwist_wf
    rintro M χM ⟨coeff, E_t, hME_t, χ₁⟩ w
    let χ₂ := χ₁ * restrictWeilChar F hME_t χM
    let H_t := (relWeil F E_t).subgroupOf (relWeil F M)
    let e_t := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hME_t)
    let ρ₁ := (charRep F E_t χ₁).comp e_t.toMonoidHom
    let ρ₂ := (charRep F E_t χ₂).comp e_t.toMonoidHom
    let Ψ : indSpace H_t ρ₁ ≃ₗ[Ω F] indSpace H_t ρ₂ :=
      { toFun := fun f =>
          ⟨fun x => (χM x : Ω F) • f.1 x, fun h x => by
            change (χM ((h : relWeil F M) * x) : Ω F) • f.1 ((h : relWeil F M) * x) =
              (χ₂ (e_t h) : Ω F) • ((χM x : Ω F) • f.1 x)
            have hf_hx : f.1 ((h : relWeil F M) * x) = (χ₁ (e_t h) : Ω F) • f.1 x := f.2 h x
            have hχ₂_eq : (χ₂ (e_t h) : Ω F) =
