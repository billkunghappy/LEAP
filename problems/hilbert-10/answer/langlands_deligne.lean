        dsimp [a_last]
        rw [if_pos ⟨hD_pos, hD_le_p⟩]
      have hlast_val : (Φ_v g (Fin.last v) : ℕ) = p - D_deg v g := by
        dsimp [Φ_v]
        rw [Fin.snoc_last, halast_val]
      have hp_sub_last : p - (Φ_v g (Fin.last v) : ℕ) = D_deg v g := by
        rw [hlast_val]
        omega
      have hprod_split :
          (∏ s : Fin (v + 1), e_def (Φ_v g s)) = prod_e v g * e_fn (D_deg v g) := by
        rw [Fin.prod_univ_castSucc]
        have hinit_prod : (∏ i : Fin v, e_def (Φ_v g i.castSucc)) = prod_e v g := by
          refine Finset.prod_congr rfl fun i _ => ?_
          dsimp [Φ_v]
          rw [Fin.snoc_castSucc]
        have hlast_e : e_def (Φ_v g (Fin.last v)) = e_fn (D_deg v g) := by
          rw [he_def_def, hp_sub_last]
        rw [hinit_prod, hlast_e]
      dsimp [main_mid_term]
      rw [hp_sub_last, hprod_split]
      ring

  
  have hQk_sub_Qmain :
      Q_k - Q_main =
        ∑ v ∈ Finset.range (k + 1),
          (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') *
            ((∑ g ∈ U_v_mid v, err_mid v g) + (∑ g ∈ U_v_high v, tr_term v g)) := by
    have hmid_split : ∀ v ∈ Finset.range (k + 1),
        (∑ g ∈ U_v_mid v, tr_term v g) =
          S_last v (p - k + v) + (∑ g ∈ U_v_mid v, err_mid v g) := by
      intro v hv
      rw [← hmid_bij v hv, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun g _ => ?_
      dsimp only [tr_term, main_mid_term, err_mid]
      ring
    have hQk_part :
        Q_k =
          (∑ v ∈ Finset.range (k + 1),
            (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') * (∑ g ∈ U_v_0 v, tr_term v g)) +
          (∑ v ∈ Finset.range (k + 1),
            (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') * S_last v (p - k + v)) +
          (∑ v ∈ Finset.range (k + 1),
            (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') *
              ((∑ g ∈ U_v_mid v, err_mid v g) + (∑ g ∈ U_v_high v, tr_term v g))) := by
      rw [hQk_expand, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun v hv => ?_
      rw [hsplit_U v, hmid_split v hv]
      ring
    dsimp only [Q_main]
    rw [hQk_part, hsum_v_0]
    ring
  rw [hQk_sub_Qmain]
  apply hvalM₁'_sum (Finset.range (k + 1)) _ B_k
  intro v hv
  have hmid_sum_val :
      (∑ g ∈ U_v_mid v, err_mid v g) = 0 ∨
        B_k ≤ valL F M₁' (∑ g ∈ U_v_mid v, err_mid v g) :=
    hvalM₁'_sum (U_v_mid v) (err_mid v) B_k (herr_mid_val v hv)
  have hhigh_sum_val :
      (∑ g ∈ U_v_high v, tr_term v g) = 0 ∨
        B_k ≤ valL F M₁' (∑ g ∈ U_v_high v, tr_term v g) :=
    hvalM₁'_sum (U_v_high v) (tr_term v) B_k (hhigh_val v hv)
  have hinner_val := hvalM₁'_add B_k
    (∑ g ∈ U_v_mid v, err_mid v g) (∑ g ∈ U_v_high v, tr_term v g)
    hmid_sum_val hhigh_sum_val
  have hchoose_mul := hvalM₁'_mul_ge 0 B_k ((k.choose v : ℕ) : M₁') _
    (hvalM₁'_natCast (k.choose v)) hinner_val
  rw [zero_add] at hchoose_mul
  rw [mul_assoc]
  exact hvalM₁'_neg1_pow_bound (k - v) _ B_k hchoose_mul

theorem ld_ch12_wild_odd_tot_ram_deficit_tuple_swap_and_cyclic_orbit (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M₁' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M₁']
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (t₁ t₂ : ℕ) (ht₁_ge1 : 1 ≤ t₁) (ht_le : t₁ ≤ t₂)
    (hp_valM₁' : ((p : ℕ) : M₁') = 0 ∨
      (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F M₁' ((p : ℕ) : M₁'))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (e_def : Fin p → M₁')
    (he_def_val0 : ∀ a : Fin p,
      e_def a = 0 ∨ ((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ) ≤ valL F M₁' (e_def a))
    (he_def_val_pos : ∀ a : Fin p, (a : ℕ) ≠ 0 →
      e_def a = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (a : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (e_def a)) :
    let S_prod : ℕ → ℕ → M₁' := fun v w =>
      ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
          (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
        ∏ s : Fin (v + 1), e_def (d s)
    let S_last : ℕ → ℕ → M₁' := fun v w =>
      ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
          (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
        ((p - (d (Fin.last v) : ℕ) : ℕ) : M₁') * ∏ s : Fin (v + 1), e_def (d s)
    (∀ k ∈ Finset.Icc 2 (p - 1), ∀ v ≤ k, v + 1 ≤ p - 1 →
      let diff_v :=
        (-1 : M₁') ^ (p - k + v) * ((p - 1 : ℕ) : M₁') *
            ((k.choose (v + 1) : ℕ) : M₁') * S_prod v (p - k + v) -
          (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') * S_last v (p - k + v)
      diff_v = 0 ∨
        2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤ valL F M₁' diff_v) ∧
    (let d_one : Fin p := ⟨1, hPrime.one_lt⟩
     let diff_top := S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p
     diff_top = 0 ∨
       2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
         valL F M₁' diff_top) :=
by
  intro S_prod S_last
  classical
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have ht₂_ge1 : 1 ≤ t₂ := le_trans ht₁_ge1 ht_le
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, _, _, hvalM₁'_add, _⟩ :=
    hvalM₁'_props

  
  have hmul_M₁' : ∀ (m₁ m₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ m₁ ≤ valL F M₁' x) → (y = 0 ∨ m₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F M₁' (x * y)) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hvx : m₁ ≤ valL F M₁' x := hx.resolve_left hx0
        have hvy : m₂ ≤ valL F M₁' y := hy.resolve_left hy0
        rw [hvalM₁'_mul x y hx0 hy0]
        linarith
  have hsum_M₁' : ∀ {α : Type} (s : Finset α) (f : α → M₁') (k : ℤ),
      (∀ x ∈ s, f x = 0 ∨ k ≤ valL F M₁' (f x)) →
      ((∑ x ∈ s, f x) = 0 ∨ k ≤ valL F M₁' (∑ x ∈ s, f x)) := by
    intro α s f k hs
    induction s using Finset.induction_on with
    | empty => exact Or.inl Finset.sum_empty
    | @insert x s' hx ih =>
      rw [Finset.sum_insert hx]
      exact hvalM₁'_add k (f x) (∑ y ∈ s', f y)
        (hs x (Finset.mem_insert_self x s'))
        (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
  have hprod_M₁' : ∀ {α : Type} (s : Finset α) (f : α → M₁') (g : α → ℤ),
      (∀ x ∈ s, f x = 0 ∨ g x ≤ valL F M₁' (f x)) →
      ((∏ x ∈ s, f x) = 0 ∨ (∑ x ∈ s, g x) ≤ valL F M₁' (∏ x ∈ s, f x)) := by
    intro α s f g hs
    induction s using Finset.induction_on with
    | empty =>
      right
      rw [Finset.sum_empty, Finset.prod_empty, hvalM₁'_1]
    | @insert x s' hx ih =>
      rw [Finset.prod_insert hx, Finset.sum_insert hx]
      exact hmul_M₁' (g x) (∑ y ∈ s', g y) (f x) (∏ y ∈ s', f y)
        (hs x (Finset.mem_insert_self x s'))
        (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
  have hnat_M₁' : ∀ n : ℕ, (n : M₁') = 0 ∨ 0 ≤ valL F M₁' (n : M₁') := by
    intro n
    induction n with
    | zero => left; simp
    | succ m ih =>
      rw [Nat.cast_succ]
      exact hvalM₁'_add 0 (m : M₁') 1 ih (Or.inr (by rw [hvalM₁'_1]))
  have hint_M₁' : ∀ z : ℤ, (z : M₁') = 0 ∨ 0 ≤ valL F M₁' (z : M₁') := by
    intro z
    cases z with
    | ofNat n => simpa using hnat_M₁' n
    | negSucc n =>
      rw [Int.cast_negSucc]
      rcases hnat_M₁' (n + 1) with h0 | hge
      · left; exact neg_eq_zero.mpr h0
      · right; rw [hvalM₁'_neg]; exact hge
  have hval_neg1_pow_M₁' : ∀ m : ℕ,
      (-1 : M₁') ^ m ≠ 0 ∧ valL F M₁' ((-1 : M₁') ^ m) = 0 := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero]
      exact ⟨one_ne_zero, hvalM₁'_1⟩
    | succ m ih =>
      rw [pow_succ]
      have hneg1_ne0 : (-1 : M₁') ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hne : (-1 : M₁') ^ m * (-1 : M₁') ≠ 0 := mul_ne_zero ih.1 hneg1_ne0
      refine ⟨hne, ?_⟩
      rw [hvalM₁'_mul _ _ ih.1 hneg1_ne0, ih.2, hvalM₁'_neg1, add_zero]
  have hp_val_ge1 : ((p : ℕ) : M₁') = 0 ∨ 1 ≤ valL F M₁' ((p : ℕ) : M₁') := by
    rcases hp_valM₁' with hp0 | hge
    · exact Or.inl hp0
    · right
      have h1 : 1 ≤ (p - 1) * t₂ := Nat.mul_pos (by omega) ht₂_ge1
      have h2 : (1 : ℤ) ≤ (((p - 1) * t₂ : ℕ) : ℤ) := by exact_mod_cast h1
      linarith
  have hcoprime_val_M₁' : ∀ {n : ℕ}, 1 ≤ n → n ≤ p - 1 →
      ((n : ℕ) : M₁') ≠ 0 ∧ valL F M₁' ((n : ℕ) : M₁') = 0 := by
    intro n hn1 hnp1
    have hnot_ge1 : ¬ (((n : ℕ) : M₁') = 0 ∨ 1 ≤ valL F M₁' ((n : ℕ) : M₁')) := by
      intro hn_bad
      have hndvd : ¬ (p ∣ n) := Nat.not_dvd_of_pos_of_lt hn1 (by omega)
      have hcop : Nat.Coprime p n := (Nat.Prime.coprime_iff_not_dvd hPrime).mpr hndvd
      have hgcd : Nat.gcd n p = 1 := Nat.Coprime.gcd_eq_one hcop.symm
      have hbez_int : (1 : ℤ) = (n : ℤ) * Nat.gcdA n p + (p : ℤ) * Nat.gcdB n p := by
        have h := Nat.gcd_eq_gcd_ab n p
        rw [hgcd] at h
        simpa using h
      have hbez_M₁' : (1 : M₁') =
          ((n : ℕ) : M₁') * (Nat.gcdA n p : M₁') + ((p : ℕ) : M₁') * (Nat.gcdB n p : M₁') := by
        have h := congrArg (Int.cast : ℤ → M₁') hbez_int
        push_cast at h
        exact h
      have hterm1 : ((n : ℕ) : M₁') * (Nat.gcdA n p : M₁') = 0 ∨
          1 ≤ valL F M₁' (((n : ℕ) : M₁') * (Nat.gcdA n p : M₁')) := by
        have h := hmul_M₁' 1 0 ((n : ℕ) : M₁') (Nat.gcdA n p : M₁') hn_bad (hint_M₁' (Nat.gcdA n p))
        rwa [add_zero] at h
      have hterm2 : ((p : ℕ) : M₁') * (Nat.gcdB n p : M₁') = 0 ∨
          1 ≤ valL F M₁' (((p : ℕ) : M₁') * (Nat.gcdB n p : M₁')) := by
        have h := hmul_M₁' 1 0 ((p : ℕ) : M₁') (Nat.gcdB n p : M₁') hp_val_ge1 (hint_M₁' (Nat.gcdB n p))
        rwa [add_zero] at h
      have hsum := hvalM₁'_add 1 _ _ hterm1 hterm2
      rw [← hbez_M₁', hvalM₁'_1] at hsum
      rcases hsum with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    rcases hnat_M₁' n with hn0 | hn_ge0
    · exact False.elim (hnot_ge1 (Or.inl hn0))
    · refine ⟨fun hn0 => hnot_ge1 (Or.inl hn0), ?_⟩
      have hn_lt1 : valL F M₁' ((n : ℕ) : M₁') < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot_ge1 (Or.inr hge1)
      omega

  
  have he_def_val_pos' : ∀ (a : Fin p), (a : ℕ) ≠ 0 →
      e_def a = 0 ∨
        (((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)) +
          ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) ≤ valL F M₁' (e_def a) := by
    intro a ha
    rcases he_def_val_pos a ha with h0 | hge
    · exact Or.inl h0
    · right
      have ha_lt : (a : ℕ) < p := a.2
      have hpa : ((p - (a : ℕ) : ℕ) : ℤ) = (p : ℤ) - ((a : ℕ) : ℤ) := by omega
      have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
      rw [hpa] at hge
      rw [hp1] at hge ⊢
      linarith
  have hprod_val_pos : ∀ (v w : ℕ), 1 ≤ w →
      ∀ (d : Fin (v + 1) → Fin p),
        (∑ s : Fin (v + 1), (d s : ℕ)) = w →
        (∏ s : Fin (v + 1), e_def (d s)) = 0 ∨
          ((w : ℤ) - ((v + 1 : ℕ) : ℤ)) * (t₁ : ℤ) +
            ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) ≤
              valL F M₁' (∏ s : Fin (v + 1), e_def (d s)) := by
    intro v w hw d hwt
    have hnot_all0 : ¬ (∀ s ∈ (Finset.univ : Finset (Fin (v + 1))), (d s : ℕ) = 0) := by
      intro hall0
      have h0 : (∑ s : Fin (v + 1), (d s : ℕ)) = 0 := Finset.sum_eq_zero_iff.mpr hall0
      omega
    push_neg at hnot_all0
    obtain ⟨s₀, _, hs₀⟩ := hnot_all0
    have hprod_eq : (∏ s : Fin (v + 1), e_def (d s)) =
        e_def (d s₀) * ∏ s ∈ (Finset.univ : Finset (Fin (v + 1))).erase s₀, e_def (d s) :=
      (Finset.mul_prod_erase Finset.univ (fun s => e_def (d s)) (Finset.mem_univ s₀)).symm
    rw [hprod_eq]
    have h1 := he_def_val_pos' (d s₀) hs₀
    have h2 := hprod_M₁' ((Finset.univ : Finset (Fin (v + 1))).erase s₀)
      (fun s => e_def (d s)) (fun s => ((d s : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ))
      (fun s _ => he_def_val0 (d s))
    have h12 := hmul_M₁'
      ((((d s₀ : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)) + ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)))
      (∑ s ∈ (Finset.univ : Finset (Fin (v + 1))).erase s₀, (((d s : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)))
      (e_def (d s₀))
      (∏ s ∈ (Finset.univ : Finset (Fin (v + 1))).erase s₀, e_def (d s))
      h1 h2
    rcases h12 with h0 | hge
    · exact Or.inl h0
    · right
      have hsum_erase :
          (((d s₀ : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)) +
            (∑ s ∈ (Finset.univ : Finset (Fin (v + 1))).erase s₀,
              (((d s : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ))) =
          ∑ s : Fin (v + 1), (((d s : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)) :=
        Finset.add_sum_erase Finset.univ
          (fun s : Fin (v + 1) => ((d s : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ))
          (Finset.mem_univ s₀)
      have hsum_eval :
          (∑ s : Fin (v + 1), (((d s : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ))) =
            ((w : ℤ) - ((v + 1 : ℕ) : ℤ)) * (t₁ : ℤ) := by
        rw [Finset.sum_sub_distrib, ← Finset.sum_mul, Finset.sum_const, Finset.card_univ,
          Fintype.card_fin, nsmul_eq_mul]
        have hwt_int : (∑ s : Fin (v + 1), ((d s : ℕ) : ℤ)) = (w : ℤ) := by
          exact_mod_cast hwt
        rw [hwt_int]
        ring
      linarith
  have hS_prod_val : ∀ k ∈ Finset.Icc 2 (p - 1), ∀ v ≤ k,
      S_prod v (p - k + v) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (S_prod v (p - k + v)) := by
    intro k hk v hv
    obtain ⟨hk2, hkp1⟩ := Finset.mem_Icc.mp hk
    dsimp only [S_prod]
    apply hsum_M₁' _ _ (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ))
    intro d hd
    have hwt : (∑ s : Fin (v + 1), (d s : ℕ)) = p - k + v := (Finset.mem_filter.mp hd).2
    have hw_pos : 1 ≤ p - k + v := by omega
    rcases hprod_val_pos v (p - k + v) hw_pos d hwt with h0 | hge
    · exact Or.inl h0
    · right
      have h_eq : (((p - k + v : ℕ) : ℤ) - ((v + 1 : ℕ) : ℤ)) * (t₁ : ℤ) +
          ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) =
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ) := by
        have h1 : ((p - k + v : ℕ) : ℤ) - ((v + 1 : ℕ) : ℤ) = ((p - 1 : ℕ) : ℤ) - (k : ℤ) := by
          omega
        rw [h1]
        ring
      linarith

  
  have hS_last_swap : ∀ (v w : ℕ), w ≤ (v + 1) * p →
      ((v + 1 : ℕ) : M₁') * S_last v w = (((v + 1) * p - w : ℕ) : M₁') * S_prod v w := by
    intro v w hw_le
    let T_vw : Finset (Fin (v + 1) → Fin p) :=
      (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
        (fun d => (∑ r : Fin (v + 1), (d r : ℕ)) = w)
    let swap_tup : Fin (v + 1) → (Fin (v + 1) → Fin p) → (Fin (v + 1) → Fin p) :=
      fun s d r => d (Equiv.swap s (Fin.last v) r)
    have hswap_last : ∀ s : Fin (v + 1),
        S_last v w =
          ∑ d ∈ T_vw, ((p - (d s : ℕ) : ℕ) : M₁') * ∏ r : Fin (v + 1), e_def (d r) := by
      intro s
      dsimp only [S_last]
      change (∑ d ∈ T_vw, ((p - (d (Fin.last v) : ℕ) : ℕ) : M₁') * ∏ r : Fin (v + 1), e_def (d r)) = _
