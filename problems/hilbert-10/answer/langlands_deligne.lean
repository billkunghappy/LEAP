      have h_le : fieldOf M_A ≤ fieldOf (M₁ ⊔ M₂) := (h_le_iff M_A (M₁ ⊔ M₂)).mpr hsup
      rwa [hA] at h_le
  have h_inf_eq_sup : ∀ M₁ M₂ : Subgroup G, fieldOf (M₁ ⊓ M₂) = fieldOf M₁ ⊔ fieldOf M₂ := by
    intro M₁ M₂
    apply le_antisymm
    · let A := fieldOf M₁ ⊔ fieldOf M₂
      have hLA : L ≤ A := (hL_fieldOf M₁).trans le_sup_left
      have hAK : A ≤ K := sup_le (h_fieldOf_le_K M₁) (h_fieldOf_le_K M₂)
      let M_A := (toSub A hLA).fixingSubgroup
      have hA : fieldOf M_A = A := h_fieldOf_fixing A hLA hAK
      have h1 : M_A ≤ M₁ := (h_le_iff M₁ M_A).mp (hA.symm ▸ le_sup_left)
      have h2 : M_A ≤ M₂ := (h_le_iff M₂ M_A).mp (hA.symm ▸ le_sup_right)
      have hinf : M_A ≤ M₁ ⊓ M₂ := le_inf h1 h2
      have h_le : fieldOf (M₁ ⊓ M₂) ≤ fieldOf M_A := (h_le_iff (M₁ ⊓ M₂) M_A).mpr hinf
      rwa [hA] at h_le
    · exact sup_le ((h_le_iff _ _).mpr inf_le_left) ((h_le_iff _ _).mpr inf_le_right)
  have h_mem_fixing : ∀ (A : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hAK : A ≤ K) (w : relWeil F L),
      w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ π w ∈ (toSub A hLA).fixingSubgroup := by
    intro A hLA hAK w
    change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ A.fixingSubgroup) ↔
      π w ∈ (toSub A hLA).fixingSubgroup
    have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
    rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff,
      IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hw x hx
      apply Subtype.ext
      rw [hπ w x]
      exact hw x.1 ((h_mem_toSub A hLA x).mp hx)
    · intro hπw z hzA
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hAK hzA)⟩
      have hxA : x ∈ toSub A hLA := (h_mem_toSub A hLA x).mpr hzA
      have h1 := hπ w x
      have h2 : π w x = x := hπw x hxA
      rw [h2] at h1
      exact h1.symm
  have h_weil_fieldOf : ∀ (M : Subgroup G) (w : relWeil F L),
      w ∈ (relWeil F (fieldOf M)).subgroupOf (relWeil F L) ↔ π w ∈ M := by
    intro M w
    rw [h_mem_fixing (fieldOf M) (hL_fieldOf M) (h_fieldOf_le_K M) w,
      h_fixing_toSub_fieldOf M]
  have h_field_H : fieldOf H = E := by
    have hH_eq : H = (toSub E hLE).fixingSubgroup := by
      ext g
      obtain ⟨w, rfl⟩ := hsurj g
      exact (h_mem_H w).symm.trans (h_mem_fixing E hLE hEK w)
    rw [hH_eq]
    exact h_fieldOf_fixing E hLE hEK
  have h_finrank_L_index : ∀ M : Subgroup G,
      Module.finrank L (IntermediateField.extendScalars (hL_fieldOf M)) = M.index := by
    intro M
    let A_ext := IntermediateField.extendScalars (hL_fieldOf M)
    have hmul : Module.finrank L ↥A_ext * Nat.card ((toSub (fieldOf M) (hL_fieldOf M)).fixingSubgroup) =
        Module.finrank L ↥K' :=
      h_abs_finrank ↥L ↥K' (AlgebraicClosure F) K'.val A_ext (fun z hz =>
        ⟨⟨z, (IntermediateField.mem_extendScalars hLK).mpr
          (h_fieldOf_le_K M ((IntermediateField.mem_extendScalars (hL_fieldOf M)).mp hz))⟩, rfl⟩)
    rw [h_fixing_toSub_fieldOf M, ← IsGalois.card_aut_eq_finrank L K',
      ← Subgroup.index_mul_card M] at hmul
    exact Nat.eq_of_mul_eq_mul_right (h_sub_card_pos M) hmul
  have h_finrank_relIndex : ∀ (M₁ M₂ : Subgroup G) (h : fieldOf M₂ ≤ fieldOf M₁),
      Module.finrank ↥(fieldOf M₂) (IntermediateField.extendScalars h) = M₁.relIndex M₂ := by
    intro M₁ M₂ h
    have hM : M₁ ≤ M₂ := (h_le_iff M₂ M₁).mp h
    haveI : FiniteDimensional F (fieldOf M₁) :=
      Module.Finite.of_injective (IntermediateField.inclusion (h_fieldOf_le_K M₁)).toLinearMap
        (IntermediateField.inclusion (h_fieldOf_le_K M₁)).injective
    obtain ⟨hmul, hpos, _⟩ := h_tower_finrank L (fieldOf M₂) (fieldOf M₁)
      (hL_fieldOf M₁) (hL_fieldOf M₂) h
    have hpos_idx : 0 < M₂.index := h_finrank_L_index M₂ ▸ hpos
    rw [h_finrank_L_index M₂, h_finrank_L_index M₁] at hmul
    have hrel : M₂.index * (M₁.relIndex M₂) = M₁.index := by
      rw [mul_comm, Subgroup.relIndex_mul_index hM]
    exact Nat.eq_of_mul_eq_mul_left hpos_idx (hmul.trans hrel.symm)
  let res_L : L.fixingSubgroup →* G :=
    (AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv L).toMonoidHom
  have h_res_apply : ∀ (σ : L.fixingSubgroup) (x : K'),
      ((res_L σ x : K') : AlgebraicClosure F) = σ.1 x.1 := by
    intro σ x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv L) σ) x : K') : AlgebraicClosure F) = σ.1 x.1
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have h_res_surj : Function.Surjective res_L :=
    (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
      (IntermediateField.fixingSubgroupEquiv L).surjective
  have h_res_fix : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A) (hAK : A ≤ K)
      (σ : L.fixingSubgroup),
      σ.1 ∈ A.fixingSubgroup ↔ res_L σ ∈ (toSub A hLA).fixingSubgroup := by
    intro A hLA hAK σ
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hσ y hy
      apply Subtype.ext
      rw [h_res_apply σ y]
      exact hσ y.1 ((h_mem_toSub A hLA y).mp hy)
    · intro hσ x hx
      let y : K' := ⟨x, (IntermediateField.mem_extendScalars hLK).mpr (hAK hx)⟩
      have hy : y ∈ toSub A hLA := (h_mem_toSub A hLA y).mpr hx
      have h1 := congrArg Subtype.val (hσ y hy)
      rwa [h_res_apply σ y] at h1
  have h_res_fieldOf : ∀ (M : Subgroup G) (σ : L.fixingSubgroup),
      σ.1 ∈ (fieldOf M).fixingSubgroup ↔ res_L σ ∈ M := by
    intro M σ
    rw [h_res_fix (fieldOf M) (hL_fieldOf M) (h_fieldOf_le_K M) σ, h_fixing_toSub_fieldOf M]
  have h_gal_fieldOf : ∀ (M₁ M₂ : Subgroup G),
      M₂ ≤ M₁ →
      (∀ g ∈ M₁, ∀ n ∈ M₂, g * n * g⁻¹ ∈ M₂) →
      IsGaloisExt F (fieldOf M₁) (fieldOf M₂) := by
    intro M₁ M₂ hM₂₁ h_conj
    have hle : fieldOf M₁ ≤ fieldOf M₂ := (h_le_iff M₁ M₂).mpr hM₂₁
    haveI : FiniteDimensional F (fieldOf M₂) :=
      Module.Finite.of_injective (IntermediateField.inclusion (h_fieldOf_le_K M₂)).toLinearMap
        (IntermediateField.inclusion (h_fieldOf_le_K M₂)).injective
    refine ⟨hle, inferInstance, ?_, fun h =>
      h_sep_sub (fieldOf M₁) (fieldOf M₂) (hL_fieldOf M₁) h (h_fieldOf_le_K M₂)⟩
    intro σ hσ τ hτ
    let σ' : L.fixingSubgroup := ⟨σ, IntermediateField.fixingSubgroup_le (hL_fieldOf M₁) hσ⟩
    let τ' : L.fixingSubgroup := ⟨τ, IntermediateField.fixingSubgroup_le (hL_fieldOf M₂) hτ⟩
    have hσM₁ : res_L σ' ∈ M₁ := (h_res_fieldOf M₁ σ').mp hσ
    have hτM₂ : res_L τ' ∈ M₂ := (h_res_fieldOf M₂ τ').mp hτ
    have hconjM₂ : res_L (σ' * τ' * σ'⁻¹) ∈ M₂ := by
      rw [map_mul, map_mul, map_inv]
      exact h_conj (res_L σ') hσM₁ (res_L τ') hτM₂
    exact (h_res_fieldOf M₂ (σ' * τ' * σ'⁻¹)).mpr hconjM₂
  have h_ab_fieldOf : ∀ (M₁ M₂ : Subgroup G) (h : fieldOf M₁ ≤ fieldOf M₂),
      (∀ g ∈ M₁, ∀ n ∈ M₂, g * n * g⁻¹ ∈ M₂) →
      (∀ a ∈ M₁, ∀ b ∈ M₁, a * b * a⁻¹ * b⁻¹ ∈ M₂) →
      IsAbelianExt F h := by
    intro M₁ M₂ h h_conj h_comm
    have hM₂₁ : M₂ ≤ M₁ := (h_le_iff M₁ M₂).mp h
    have hGal₁₂ := h_gal_fieldOf M₁ M₂ hM₂₁ h_conj
    refine ⟨hGal₁₂.2.2.1, ?_, hGal₁₂.2.2.2 h⟩
    intro σ hσ τ hτ
    let σ' : L.fixingSubgroup := ⟨σ, IntermediateField.fixingSubgroup_le (hL_fieldOf M₁) hσ⟩
    let τ' : L.fixingSubgroup := ⟨τ, IntermediateField.fixingSubgroup_le (hL_fieldOf M₁) hτ⟩
    have hσM₁ : res_L σ' ∈ M₁ := (h_res_fieldOf M₁ σ').mp hσ
    have hτM₁ : res_L τ' ∈ M₁ := (h_res_fieldOf M₁ τ').mp hτ
    have hcommM₂ : res_L (σ' * τ' * σ'⁻¹ * τ'⁻¹) ∈ M₂ := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv]
      exact h_comm (res_L σ') hσM₁ (res_L τ') hτM₁
    exact (h_res_fieldOf M₂ (σ' * τ' * σ'⁻¹ * τ'⁻¹)).mpr hcommM₂
  have h_exists_norm_sub : ∀ (A : IntermediateField F (AlgebraicClosure F)),
      L ≤ A → A ≤ K → IsGaloisExt F L A →
      ∃ M : Subgroup G, M.Normal ∧ fieldOf M = A := by
    intro A hLA hAK hGalA
    let M := (toSub A hLA).fixingSubgroup
    refine ⟨M, ⟨?_⟩, h_fieldOf_fixing A hLA hAK⟩
    intro n hn g
    obtain ⟨σ, rfl⟩ := h_res_surj g
    obtain ⟨τ, rfl⟩ := h_res_surj n
    have hτA : τ.1 ∈ A.fixingSubgroup := (h_res_fix A hLA hAK τ).mpr hn
    have hconjA : (σ * τ * σ⁻¹).1 ∈ A.fixingSubgroup := hGalA.2.2.1 σ.1 σ.2 τ.1 hτA
    have hres : res_L (σ * τ * σ⁻¹) = res_L σ * res_L τ * (res_L σ)⁻¹ := by
      rw [map_mul, map_mul, map_inv]
    rw [← hres]
    exact (h_res_fix A hLA hAK (σ * τ * σ⁻¹)).mp hconjA
  have h_min_of_prime : ∀ (B M_mid T : IntermediateField F (AlgebraicClosure F))
      (hBM : B ≤ M_mid) (hMT : M_mid ≤ T),
      T ≤ K →
      IsGaloisExt F B M_mid →
      IsAbelianExt F hMT →
      Nat.Prime (Module.finrank M_mid (IntermediateField.extendScalars hMT)) →
      IsMinimalAbelianNormalSubfield F B T (hBM.trans hMT) M_mid hBM hMT := by
    intro B M_mid T hBM hMT hTK hGalBM hAbMT hPrime
    haveI : FiniteDimensional F T :=
      Module.Finite.of_injective (IntermediateField.inclusion hTK).toLinearMap
        (IntermediateField.inclusion hTK).injective
    haveI : FiniteDimensional F M_mid := hGalBM.2.1
    haveI : FiniteDimensional F B :=
      Module.Finite.of_injective (IntermediateField.inclusion hBM).toLinearMap
        (IntermediateField.inclusion hBM).injective
    obtain ⟨hmul_BT, hpos_BM, _⟩ := h_tower_finrank B M_mid T (hBM.trans hMT) hBM hMT
    have hlt_BT : Module.finrank B (IntermediateField.extendScalars hBM) <
        Module.finrank B (IntermediateField.extendScalars (hBM.trans hMT)) := by
      rw [← hmul_BT]
      exact lt_mul_of_one_lt_right hpos_BM hPrime.one_lt
    have h_dichot : ∀ (E₀ : IntermediateField F (AlgebraicClosure F)),
        E₀ ≤ T → E₀ ≤ M_mid ∨ E₀ ⊔ M_mid = T := by
      intro E₀ hE₀T
      let E₁ := E₀ ⊔ M_mid
      have hME₁ : M_mid ≤ E₁ := le_sup_right
      have hE₁T : E₁ ≤ T := sup_le hE₀T hMT
      haveI : FiniteDimensional F E₁ :=
        Module.Finite.of_injective (IntermediateField.inclusion hE₁T).toLinearMap
          (IntermediateField.inclusion hE₁T).injective
      obtain ⟨hmul_MT, hpos_ME₁, hF_ME₁⟩ := h_tower_finrank M_mid E₁ T hMT hME₁ hE₁T
      have hdvd : Module.finrank M_mid (IntermediateField.extendScalars hME₁) ∣
          Module.finrank M_mid (IntermediateField.extendScalars hMT) :=
        ⟨Module.finrank E₁ (IntermediateField.extendScalars hE₁T), hmul_MT.symm⟩
      rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq_p
      · left
        have hF_le : Module.finrank F E₁ ≤ Module.finrank F M_mid := by
          rw [← hF_ME₁, h1, mul_one]
        have h_eq : M_mid = E₁ := IntermediateField.eq_of_le_of_finrank_le hME₁ hF_le
        exact le_sup_left.trans h_eq.symm.le
      · right
        have h1_top : Module.finrank E₁ (IntermediateField.extendScalars hE₁T) = 1 := by
          apply Nat.eq_of_mul_eq_mul_left hpos_ME₁
          rw [hmul_MT, heq_p, mul_one]
        have hF_E₁T := (h_tower_finrank E₁ T T hE₁T hE₁T le_rfl).2.2
        have hF_le : Module.finrank F T ≤ Module.finrank F E₁ := by
          rw [← hF_E₁T, h1_top, mul_one]
        exact IntermediateField.eq_of_le_of_finrank_le hE₁T hF_le
    refine ⟨hGalBM, hAbMT, hlt_BT, ?_, ?_⟩
    · intro K₁ _ hK₁T _
      exact h_dichot K₁ hK₁T
    · intro E₀ _ hE₀T
      rcases h_dichot E₀ hE₀T with hle | hsup
      · exact Or.inl hle
      · exact Or.inr (Or.inr hsup)
  have hBranchA : (∃ (H' : Subgroup H),
        H'.Normal ∧
        (∀ a b : H, a * b * a⁻¹ * b⁻¹ ∈ H') ∧
        H'.index = q₀) →
      ∃ (F' : IntermediateField F (AlgebraicClosure F)) (hLF' : L ≤ F'),
        F' ≤ M_C ∧
        L < F' ∧
        IsGaloisExt F L F' ∧
        IsAbelianExt F hLF' ∧
        Module.finrank L (IntermediateField.extendScalars hLF') = q₀ := by
    rintro ⟨H', hH'_norm, hH'_comm, hH'_idx⟩
    haveI : H'.Normal := hH'_norm
    let M_F' : Subgroup G := H'.comap proj_H
    let F' : IntermediateField F (AlgebraicClosure F) := fieldOf M_F'
    have hLF' : L ≤ F' := hL_fieldOf M_F'
    have hF'K : F' ≤ K := h_fieldOf_le_K M_F'
    have hC_le_MF' : C ≤ M_F' := by
      intro c hc
      rw [Subgroup.mem_comap, (hproj_ker c).mpr hc]
      exact H'.one_mem
    have hF'_le_MC : F' ≤ M_C := h_sub_MC M_F' hC_le_MF'
    have hMF'_idx : M_F'.index = q₀ := by
      rw [Subgroup.index_comap_of_surjective H' hproj_surj, hH'_idx]
    have hFin_LF' : Module.finrank L (IntermediateField.extendScalars hLF') = q₀ := by
      rw [h_finrank_L_index M_F', hMF'_idx]
    have hMF'_lt_top : M_F' < ⊤ := by
      rw [lt_top_iff_ne_top]
      intro htop
      have h1 : M_F'.index = 1 := by rw [htop, Subgroup.index_top]
      rw [hMF'_idx] at h1
      exact hq₀_prime.ne_one h1
    have hL_lt_F' : L < F' := h_sub_lt M_F' hMF'_lt_top
    haveI : FiniteDimensional F F' :=
      Module.Finite.of_injective (IntermediateField.inclusion hF'K).toLinearMap
        (IntermediateField.inclusion hF'K).injective
    have h_conj_F' : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ F'.fixingSubgroup,
        σ * τ * σ⁻¹ ∈ F'.fixingSubgroup := by
      intro σ hσ τ hτ
      let σ' : L.fixingSubgroup := ⟨σ, hσ⟩
      let τ' : L.fixingSubgroup := ⟨τ, IntermediateField.fixingSubgroup_le hLF' hτ⟩
      have hτM : (proj_H.comp res_L) τ' ∈ H' := (h_res_fieldOf M_F' τ').mp hτ
      have hconj : (proj_H.comp res_L) (σ' * τ' * σ'⁻¹) ∈ H' :=
        (h_hom_conj_comm H (proj_H.comp res_L) H' hH'_comm σ' τ').1 hτM
      exact (h_res_fieldOf M_F' (σ' * τ' * σ'⁻¹)).mpr hconj
    have h_comm_F' : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ L.fixingSubgroup,
        σ * τ * σ⁻¹ * τ⁻¹ ∈ F'.fixingSubgroup := by
      intro σ hσ τ hτ
      let σ' : L.fixingSubgroup := ⟨σ, hσ⟩
      let τ' : L.fixingSubgroup := ⟨τ, hτ⟩
      have hcomm : (proj_H.comp res_L) (σ' * τ' * σ'⁻¹ * τ'⁻¹) ∈ H' :=
        (h_hom_conj_comm H (proj_H.comp res_L) H' hH'_comm σ' τ').2
      exact (h_res_fieldOf M_F' (σ' * τ' * σ'⁻¹ * τ'⁻¹)).mpr hcomm
    have hGalLF' : IsGaloisExt F L F' :=
      ⟨hLF', inferInstance, h_conj_F', fun h => h_sep_sub L F' le_rfl h hF'K⟩
    have hAbLF' : IsAbelianExt F hLF' :=
      ⟨h_conj_F', h_comm_F', h_sep_sub L F' le_rfl hLF' hF'K⟩
    exact ⟨F', hLF', hF'_le_MC, hL_lt_F', hGalLF', hAbLF', hFin_LF'⟩
  exact ⟨hBranchA, proj_H, hproj_mul, hproj_id, hproj_surj, hproj_ker, hcomap_mem,
    h_field_H, h_bounds, h_le_iff, h_eq_iff, h_lt_iff, h_sup_eq_inf, h_inf_eq_sup,
    h_finrank_relIndex, h_weil_fieldOf, h_fix_fieldOf, h_gal_fieldOf, h_ab_fieldOf,
    h_exists_norm_sub, h_min_of_prime⟩

theorem ld_ch14_tame_subdiamond_fields_and_galois_props (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀)
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (h_sub_MC : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      C ≤ M → (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ M_C)
    (h_field_top : (IntermediateField.lift (IntermediateField.fixedField (⊤ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)))).restrictScalars F = L)
    (proj_H : (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) →* H)
    (hproj_id : ∀ h : H, proj_H h.1 = h)
    (hproj_surj : Function.Surjective proj_H)
    (hproj_ker : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      proj_H g = 1 ↔ g ∈ C)
    (hcomap_mem : ∀ (S : Subgroup H)
      (g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      g ∈ S.comap proj_H ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c)
    (h_field_H : (IntermediateField.lift (IntermediateField.fixedField H)).restrictScalars F = E)
    (h_bounds : ∀ M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      L ≤ (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ∧
      (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ K)
    (h_le_iff : ∀ M₁ M₂ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      (IntermediateField.lift (IntermediateField.fixedField M₁)).restrictScalars F ≤
        (IntermediateField.lift (IntermediateField.fixedField M₂)).restrictScalars F ↔ M₂ ≤ M₁)
    (h_eq_iff : ∀ M₁ M₂ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      (IntermediateField.lift (IntermediateField.fixedField M₁)).restrictScalars F =
        (IntermediateField.lift (IntermediateField.fixedField M₂)).restrictScalars F ↔ M₁ = M₂)
    (h_lt_iff : ∀ M₁ M₂ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      (IntermediateField.lift (IntermediateField.fixedField M₁)).restrictScalars F <
        (IntermediateField.lift (IntermediateField.fixedField M₂)).restrictScalars F ↔ M₂ < M₁)
    (h_sup_eq_inf : ∀ M₁ M₂ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      (IntermediateField.lift (IntermediateField.fixedField (M₁ ⊔ M₂))).restrictScalars F =
        (IntermediateField.lift (IntermediateField.fixedField M₁)).restrictScalars F ⊓
          (IntermediateField.lift (IntermediateField.fixedField M₂)).restrictScalars F)
    (h_inf_eq_sup : ∀ M₁ M₂ : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      (IntermediateField.lift (IntermediateField.fixedField (M₁ ⊓ M₂))).restrictScalars F =
        (IntermediateField.lift (IntermediateField.fixedField M₁)).restrictScalars F ⊔
