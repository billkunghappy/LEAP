          ((z + R) ^ (k + 1) - z ^ (k + 1)) * (z + R) + z ^ (k + 1) * R := by ring
      rw [hsplit]
      have hterm1 := hval_mul_ge_A (((k + 1 : ℕ) : ℤ) * (q₀ : ℤ) + (m : ℤ)) (q₀ : ℤ)
        ((z + R) ^ (k + 1) - z ^ (k + 1)) (z + R) ih hzR
      have hzk1 := hval_pow_ge_A k (q₀ : ℤ) z hz
      have hterm2 := hval_mul_ge_A (((k + 1 : ℕ) : ℤ) * (q₀ : ℤ)) ((q₀ : ℤ) + (m : ℤ))
        (z ^ (k + 1)) R hzk1 hR
      have heq1 : ((k + 1 : ℕ) : ℤ) * (q₀ : ℤ) + (m : ℤ) + (q₀ : ℤ) =
          ((k + 1 + 1 : ℕ) : ℤ) * (q₀ : ℤ) + (m : ℤ) := by
        push_cast
        ring
      have heq2 : ((k + 1 : ℕ) : ℤ) * (q₀ : ℤ) + ((q₀ : ℤ) + (m : ℤ)) =
          ((k + 1 + 1 : ℕ) : ℤ) * (q₀ : ℤ) + (m : ℤ) := by
