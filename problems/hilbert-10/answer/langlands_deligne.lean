        (quadraticChar k_L P_ξ) ^ (u - 1) :=
by
  intro q u c₀ Θ_orb P_ξ
  have hp : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
  have hp_ge3 : 3 ≤ p F := by
    have h2 := hp.two_le
    omega
  have hq_ge3 : 3 ≤ q := by
    change 3 ≤ Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    rw [hq_pow]
    calc 3 ≤ p F := hp_ge3
      _ = (p F) ^ 1 := (pow_one (p F)).symm
      _ ≤ (p F) ^ r_exp := Nat.pow_le_pow_right (by omega) hr_exp_pos
  have hq_odd : Odd q := by
    change Odd (Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    rw [hq_pow]
    exact (hp.odd_of_ne_two hp_ne2).pow
  have hqu : q - 1 = k * u := (Nat.mul_div_cancel' hk_dvd).symm
  have hu_pos : 1 ≤ u := by
    by_contra hu0
    have hu_eq0 : u = 0 := Nat.eq_zero_of_not_pos hu0
    have hq1 : q - 1 = 0 := by rw [hqu, hu_eq0, mul_zero]
    omega
  let f_i : Fin D_orb.length → ℕ :=
    fun i => Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k
  have hf_spec : ∀ i : Fin D_orb.length,
      1 ≤ f_i i ∧
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i i := by
    intro i
    obtain ⟨_, _, _, _, _, _, _, f₀, hf₀_pos, hfin_eq, _, _⟩ := hFi_ram i
    have hfi_eq : f_i i = f₀ := by
      dsimp only [f_i]
