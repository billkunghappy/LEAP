    have hFin : FiniteDimensional (Ω F) (indSpace H ρ) := Module.Finite.equiv Φ.symm
    refine ⟨hFin, fun g => ?_⟩
    let T : ((G ⧸ H) → W) →ₗ[Ω F] ((G ⧸ H) → W) := Φ.conj (indRep H ρ g)
    have htr_conj : LinearMap.trace (Ω F) (indSpace H ρ) (indRep H ρ g) =
        LinearMap.trace (Ω F) ((G ⧸ H) → W) T :=
