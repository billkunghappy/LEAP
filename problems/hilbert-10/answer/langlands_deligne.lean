          dsimp only [D_t]
          rw [hscale_trace, ← hD_E_decomp.2 w, ht_tr]
        dsimp only
        rw [htrace_append, hcons_tr, hD_t_tr]
        exact congrArg (t.trace F L w + ·) (hD_tl_decomp.2 w)
      · intro s hs
        rw [List.mem_append] at hs
        rcases hs with hs | hs
        · rw [List.mem_map] at hs
          rcases hs with ⟨s₀, hs₀, rfl⟩
          exact hD_E_M s₀ hs₀
        · exact hD_tl_M s hs
      · have hcons_ev : evalMonomialList F rec (fun _ E _ => f E) L ψ (t :: tl) =
            evalMonomialTerm F rec (fun _ E _ => f E) L ψ t *
              evalMonomialList F rec (fun _ E _ => f E) L ψ tl := by
