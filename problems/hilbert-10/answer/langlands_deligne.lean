        map_smul' := fun a α => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, ← Finset.smul_sum, RingHom.id_apply] }
    have hΨ_apply : ∀ α : (G ⧸ M_lam) → Ω F, Ψ α = ∑ u : G ⧸ M_lam, α u • σ (cosetRep u) w_bar :=
