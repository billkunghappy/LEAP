        hw22p1_val, hw₂_val, hC2_val0]
      dsimp [m]
      push_cast
      ring_nf
      exact le_rfl
    have hnega_val : -a = 0 ∨ -((t₁ : ℕ) : ℤ) ≤ valL F E' (-a) := by
      right
      rw [hvalE'_neg, ha_val]
    have h1 := hmul_E' (-((t₁ : ℕ) : ℤ)) (((p - 1 : ℕ) : ℤ) * (δ : ℤ)) (-a) s₀ hnega_val hs₀_val
    rcases hmul_E' (-((t₁ : ℕ) : ℤ) + ((p - 1 : ℕ) : ℤ) * (δ : ℤ)) (2 * ((p - 1 : ℕ) : ℤ) * (m : ℤ))
      (-a * s₀) (((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹) h1 hinv_val with h0 | hge
    · exact Or.inl h0
    · right
      have hδ_nonneg : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) := by positivity
      have h2p1_ge : t₁ + 2 ≤ 2 * (p - 1) * m := by
        have hp_split : 2 * (p - 1) = p + (p - 2) := by omega
        have hpm : t₁ + 1 ≤ p * m := hpm_gt_t₁
        have hp2m : 1 ≤ (p - 2) * m := Nat.mul_pos (by omega) hm_ge1
        calc t₁ + 2 = (t₁ + 1) + 1 := by omega
          _ ≤ p * m + (p - 2) * m := Nat.add_le_add hpm hp2m
          _ = (p + (p - 2)) * m := by ring
          _ = 2 * (p - 1) * m := by rw [hp_split]
      have h2p1_int : (t₁ : ℤ) + 2 ≤ 2 * ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
        exact_mod_cast h2p1_ge
      dsimp [y_T]
      linarith
  have hB_term2 :
      (2 : E')⁻¹ * ((p - 2 : ℕ) : E')⁻¹ * y_s = 0 ∨
        (1 : ℤ) ≤ valL F E' ((2 : E')⁻¹ * ((p - 2 : ℕ) : E')⁻¹ * y_s) := by
    have hc1 : (2 : E')⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F E' ((2 : E')⁻¹) := Or.inr (by rw [h2_inv_val0])
    have hc2 : ((p - 2 : ℕ) : E')⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F E' (((p - 2 : ℕ) : E')⁻¹) :=
      Or.inr (by rw [hcp2_inv_val0])
    have hc12 := hmul_E' 0 0 ((2 : E')⁻¹) (((p - 2 : ℕ) : E')⁻¹) hc1 hc2
    have hprod := hmul_E' (0 + 0) 1 ((2 : E')⁻¹ * ((p - 2 : ℕ) : E')⁻¹) y_s hc12 hys_val1
    simpa using hprod
  have hB_term3 :
      (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ * y_T = 0 ∨
        (1 : ℤ) ≤ valL F E' ((2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ * y_T) := by
    have hc1 : (2 : E')⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F E' ((2 : E')⁻¹) := Or.inr (by rw [h2_inv_val0])
    have hc2 : ((p - 1 : ℕ) : E')⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F E' (((p - 1 : ℕ) : E')⁻¹) :=
      Or.inr (by rw [hcp1_inv_val0])
    have hc12 := hmul_E' 0 0 ((2 : E')⁻¹) (((p - 1 : ℕ) : E')⁻¹) hc1 hc2
    have hprod := hmul_E' (0 + 0) 1 ((2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹) y_T hc12 hyT_val1
    simpa using hprod
  have hB_rem_val : B_rem = 0 ∨ (1 : ℤ) ≤ valL F E' B_rem :=
    hvalE'_add 1 _ _ (hvalE'_add 1 _ _ hB_term1 hB_term2) hB_term3
  
  have hModel_sub_RHS0 : S_model - S_RHS0 = 0 ∨ (bE' : ℤ) ≤ valL F E' (S_model - S_RHS0) := by
    rw [hModel_sub_RHS0_eq]
    rcases hmul_E' (((p - 1) * (bE' - 1) : ℕ) : ℤ) 1 ((p : ℕ) : E') B_rem hp_valE' hB_rem_val with h0 | hge
    · exact Or.inl h0
    · right
      have hbE_le : bE' ≤ (p - 1) * (bE' - 1) + 1 := by
        have h1 : 1 * (bE' - 1) ≤ (p - 1) * (bE' - 1) := Nat.mul_le_mul_right (bE' - 1) (by omega)
        omega
      have hbE_int : (bE' : ℤ) ≤ (((p - 1) * (bE' - 1) : ℕ) : ℤ) + 1 := by exact_mod_cast hbE_le
      exact le_trans hbE_int hge
  have h_tot_eq : LHS - RHS = (LHS - S_model) + (S_model - S_RHS0) + (S_RHS0 - RHS) := by ring
  change LHS - RHS = 0 ∨ (bE' : ℤ) ≤ valL F E' (LHS - RHS)
  rw [h_tot_eq]
  exact hvalE'_add (bE' : ℤ) _ _
    (hvalE'_add (bE' : ℤ) _ _ hLHS_sub_model hModel_sub_RHS0) hRHS0_sub_RHS

theorem ld_ch12_wild_odd_tot_ram_linear_quad_trace_simplification (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (e_Δ : ℕ → M₁') (s₀ : E')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_cayley :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ : K₁)) -
        ((Δ : K₁) ^ p +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0)
    (hs₀_val : s₀ = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
        ((bE' - bM₁' : ℕ) : ℤ) ≤ valL F E' s₀)
    (hs₀_approx :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) - IntermediateField.inclusion hE'K₁ s₀ = 0 ∨
        ((p * (p - 1) * (bE' - bM₁') + (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) -
            IntermediateField.inclusion hE'K₁ s₀))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hw₂_norm : Units.map (normLM F hLE') w₂ = γ * α⁻¹)
    (hT_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T)
    (hT_approx :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      IntermediateField.inclusion hM₁'K₁ T +
        IntermediateField.inclusion hE'K₁ ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀) = 0 ∨
        (((p - 1) * p * m + p * (p - 1) * δ + (p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ T +
              IntermediateField.inclusion hE'K₁ ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀)))
    (hW_interp :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let s := - e_Δ (p - 1)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let n := IntermediateField.inclusion hLM₁' u * b
      let W_fn : ℕ → E' := fun i =>
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
            (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
      let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
      let u_M₁' := IntermediateField.inclusion hLM₁' u
      let L_val := W_K₁ + IntermediateField.inclusion hM₁'K₁ b
      let D_norm := L_val ^ p - L_val
      let A_star := (Δ : K₁) - L_val
      ∀ i ∈ Finset.Icc 1 (p - 1),
        let W_interp :=
          ((p - 1 : ℕ) : K₁) * W_K₁ *
              IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
              (if i = p - 1 then 1 else 0) -
            ((p - 1 : ℕ) : K₁) * W_K₁ ^ 2 *
              IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
              A_star ^ i * D_norm⁻¹ -
            ((p - 1 : ℕ) : K₁) *
              IntermediateField.inclusion hM₁'K₁ (s * (1 + u_M₁' * b)⁻¹ ^ 2) *
              (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 2)) *
                  (if i = p - 2 then 1 else 0) +
                ((i : ℕ) : K₁) *
                  IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
                  (Δ : K₁) * (if i = p - 1 then 1 else 0))
        IntermediateField.inclusion hE'K₁ (W_fn i) - W_interp = 0 ∨
          ((1 + p * t₂ : ℕ) : ℤ) ≤
            valL F K₁ (IntermediateField.inclusion hE'K₁ (W_fn i) - W_interp))
    (hQ_interp :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let n := IntermediateField.inclusion hLM₁' u * b
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      let Q_quad : E' :=
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
            (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
      let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
      let L_val := W_K₁ + IntermediateField.inclusion hM₁'K₁ b
      let D_norm := L_val ^ p - L_val
      let A_star := (Δ : K₁) - L_val
      let Q_interp :=
        ((p - 1 : ℕ) : K₁) *
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
          IntermediateField.inclusion hM₁'K₁ T * W_K₁ ^ 2 *
          A_star ^ (p - 2) * ((Δ : K₁) - IntermediateField.inclusion hM₁'K₁ b) * D_norm⁻¹
      IntermediateField.inclusion hE'K₁ Q_quad - Q_interp = 0 ∨
        ((1 + p * t₂ : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hE'K₁ Q_quad - Q_interp)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let n := IntermediateField.inclusion hLM₁' u * b
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let W_fn : ℕ → E' := fun i =>
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
    let Q_quad : E' :=
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
          (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
    let C := 1 + IntermediateField.inclusion hLE' u * a
    let W_E' := IntermediateField.inclusion hLE' W
    let D₀_E' := W_E' ^ p - W_E' + a ^ p
    let F_fn : ℕ → E' := fun i =>
      W_E' * D₀_E'⁻¹ * ((W_E' + a) * (((w₂⁻¹ : E'ˣ) : E'))) ^ i
    let y_sT := s₀ * ((w₂ : E') ^ (p - 2) * C)⁻¹
    C ≠ 0 ∧ valL F E' C = 0 ∧
    D₀_E' ≠ 0 ∧
    (((∑ i ∈ Finset.Icc 1 (p - 1), (-1 : E') ^ i * ((i : ℕ) : E')⁻¹ * W_fn i) +
        (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad) -
      (- W_E' * F_fn (p - 1) +
        W_E' * (∑ i ∈ Finset.Icc 1 (p - 2), ((i : ℕ) : E')⁻¹ * F_fn i) +
        W_E' * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) +
        (2 : E')⁻¹ * y_sT) = 0 ∨
      (bE' : ℤ) ≤
        valL F E'
          (((∑ i ∈ Finset.Icc 1 (p - 1), (-1 : E') ^ i * ((i : ℕ) : E')⁻¹ * W_fn i) +
              (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad) -
            (- W_E' * F_fn (p - 1) +
              W_E' * (∑ i ∈ Finset.Icc 1 (p - 2), ((i : ℕ) : E')⁻¹ * F_fn i) +
              W_E' * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) +
              (2 : E')⁻¹ * y_sT))) :=
by
  dsimp only
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalE' := ld_valL_and_unitGroup_props F E'
  have hp_odd_LE' : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2 :=
    hWild.symm ▸ hp_odd
  obtain ⟨s_LE', _, _, hs_LE'_val, _, hs_LE'_cayley, _⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F L E' hLE' hGalLE'
      hPrime hp_odd_LE' hvalL hvalE' hval_LE' hval_norm_LE' bE' (by omega) htr_LE'
      (fun t htr G _ _ act hcard h1 hmul hring hincl hval htr_s hnorm_p =>
        ld_wild_odd_free_orbit_symm_functions F L E' hLE' hPrime hp_odd_LE' hvalE' t htr
          G act hcard h1 hmul hring hincl hval htr_s hnorm_p)
      (fun G _ _ act s hcard h1 hring hincl hnorm_p hs_poly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F L E' hLE' hPrime hp_odd_LE'
          hvalL hvalE' hval_LE' G act hcard h1 hring hincl hnorm_p s hs_poly)
  obtain ⟨hC_ne0, hC_val0, h1n_ne0, h1n_val0, hD₀_ne0, hD₀_val,
      _, _, _, _, hA_star_ne0, hA_star_val, hp_valE',
      hρ_val, hh_diff_val, hb_sub_a_val, hDenom_repl, hDenom_p2⟩ :=
    ld_ch12_wild_odd_tot_ram_charpoly_splits_and_denom_replacement F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hWild hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_LE' hval_LM₁' hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      Δ hΔ_val hΔ_as e_Δ he_Δ_val he_Δ_cayley α γ w₂ hα_val hγ_val hw₂_val
  obtain ⟨hC_inv_sq_approx, hW_thm97⟩ :=
    ld_ch12_wild_odd_tot_ram_linear_trace_eval_thm_9_7 F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hWild hp_odd ψ
      bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_LE' hval_LM₁' hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      Δ hΔ_val e_Δ s₀ he_Δ_val hs₀_val hs₀_approx α γ w₂ hα_val hγ_val hw₂_val hW_interp
      hC_ne0 hC_val0 h1n_ne0 h1n_val0 hD₀_ne0 hD₀_val hA_star_ne0 hA_star_val
      hρ_val hh_diff_val hb_sub_a_val hDenom_repl hDenom_p2
