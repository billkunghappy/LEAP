            IntermediateField.inclusion hLM₁' (((m : ℕ) : L)⁻¹ * Z ^ (p * m)) *
              (b * normLM F hM₁'K₁ (z ^ m)) := by
        rw [htr_wZ_M₁' m, hnm_pow_wZ_M₁' m, map_mul, map_mul, map_inv₀, map_natCast]
        ring
      rw [hsplit, map_add, htr_smul_LM₁', htr_smul_LM₁']
    have hterm1_E' : ∀ m : ℕ,
        traceLM F hLE'
          (a * (((m : ℕ) : E')⁻¹ * (traceLM F hE'K₁ (w_Z ^ m) + (normLM F hE'K₁ w_Z) ^ m))) =
          ((m : ℕ) : L)⁻¹ * Z ^ m * traceLM F hLE' (a * traceLM F hE'K₁ (z ^ m)) +
            ((m : ℕ) : L)⁻¹ * Z ^ (p * m) * traceLM F hLE' (a * normLM F hE'K₁ (z ^ m)) := by
      intro m
      have hsplit :
          a * (((m : ℕ) : E')⁻¹ * (traceLM F hE'K₁ (w_Z ^ m) + (normLM F hE'K₁ w_Z) ^ m)) =
            IntermediateField.inclusion hLE' (((m : ℕ) : L)⁻¹ * Z ^ m) *
              (a * traceLM F hE'K₁ (z ^ m)) +
            IntermediateField.inclusion hLE' (((m : ℕ) : L)⁻¹ * Z ^ (p * m)) *
              (a * normLM F hE'K₁ (z ^ m)) := by
        rw [htr_wZ_E' m, hnm_pow_wZ_E' m, map_mul, map_mul, map_inv₀, map_natCast]
        ring
      rw [hsplit, map_add, htr_smul_LE', htr_smul_LE']
    have hterm1_diff : ∀ m : ℕ,
        traceLM F hLM₁'
          (b * (((m : ℕ) : M₁')⁻¹ * (traceLM F hM₁'K₁ (w_Z ^ m) + (normLM F hM₁'K₁ w_Z) ^ m))) -
        traceLM F hLE'
          (a * (((m : ℕ) : E')⁻¹ * (traceLM F hE'K₁ (w_Z ^ m) + (normLM F hE'K₁ w_Z) ^ m))) =
        ((m : ℕ) : L)⁻¹ * (Z ^ m * g_fn (z ^ m) + Z ^ (p * m) * h_fn (z ^ m)) := by
      intro m
      rw [hterm1_M₁' m, hterm1_E' m]
      dsimp only [g_fn, h_fn]
      ring
    have hterm2_M₁' : ∀ j r : ℕ,
        traceLM F hLM₁'
          (b * (((r : ℕ) : M₁')⁻¹ * traceLM F hM₁'K₁ (w_Z ^ r) * (normLM F hM₁'K₁ w_Z) ^ j)) =
          ((r : ℕ) : L)⁻¹ * Z ^ (r + p * j) *
            traceLM F hLM₁' (b * traceLM F hM₁'K₁ (z ^ r) * (normLM F hM₁'K₁ z) ^ j) := by
      intro j r
      have hsplit :
          b * (((r : ℕ) : M₁')⁻¹ * traceLM F hM₁'K₁ (w_Z ^ r) * (normLM F hM₁'K₁ w_Z) ^ j) =
            IntermediateField.inclusion hLM₁' (((r : ℕ) : L)⁻¹ * Z ^ (r + p * j)) *
              (b * traceLM F hM₁'K₁ (z ^ r) * (normLM F hM₁'K₁ z) ^ j) := by
        rw [htr_wZ_M₁' r, hnm_wZ_M₁', mul_pow, ← map_pow, ← pow_mul,
          pow_add Z r (p * j), map_mul, map_mul, map_inv₀, map_natCast]
        ring
      rw [hsplit, htr_smul_LM₁']
    have hterm2_E' : ∀ j r : ℕ,
        traceLM F hLE'
          (a * (((r : ℕ) : E')⁻¹ * traceLM F hE'K₁ (w_Z ^ r) * (normLM F hE'K₁ w_Z) ^ j)) =
          ((r : ℕ) : L)⁻¹ * Z ^ (r + p * j) *
            traceLM F hLE' (a * traceLM F hE'K₁ (z ^ r) * (normLM F hE'K₁ z) ^ j) := by
      intro j r
      have hsplit :
          a * (((r : ℕ) : E')⁻¹ * traceLM F hE'K₁ (w_Z ^ r) * (normLM F hE'K₁ w_Z) ^ j) =
            IntermediateField.inclusion hLE' (((r : ℕ) : L)⁻¹ * Z ^ (r + p * j)) *
              (a * traceLM F hE'K₁ (z ^ r) * (normLM F hE'K₁ z) ^ j) := by
        rw [htr_wZ_E' r, hnm_wZ_E', mul_pow, ← map_pow, ← pow_mul,
          pow_add Z r (p * j), map_mul, map_mul, map_inv₀, map_natCast]
        ring
      rw [hsplit, htr_smul_LE']
    have hterm2_diff : ∀ j r : ℕ,
        traceLM F hLM₁'
          (b * (((r : ℕ) : M₁')⁻¹ * traceLM F hM₁'K₁ (w_Z ^ r) * (normLM F hM₁'K₁ w_Z) ^ j)) -
        traceLM F hLE'
          (a * (((r : ℕ) : E')⁻¹ * traceLM F hE'K₁ (w_Z ^ r) * (normLM F hE'K₁ w_Z) ^ j)) =
        ((r : ℕ) : L)⁻¹ * Z ^ (r + p * j) * Φ_fn z j r := by
      intro j r
      rw [hterm2_M₁' j r, hterm2_E' j r]
      dsimp only [Φ_fn]
      ring
    dsimp only [E_M₁', E_E', T_poly]
    rw [mul_add, mul_add, map_add, map_add, add_sub_add_comm]
    congr 1
    · rw [Finset.mul_sum, Finset.mul_sum, map_sum, map_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun m _ => hterm1_diff m
    · rw [Finset.mul_sum, Finset.mul_sum, map_sum, map_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.mul_sum, Finset.mul_sum, map_sum, map_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun r _ => hterm2_diff j r
  
  have hF_poly : ∀ (Z : L) (z : K₁),
      (Z = 0 ∨ 0 ≤ vL Z) →
      (z = 0 ∨ (q₁ : ℤ) ≤ vK₁ z) →
      let w_Z := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' Z) * z
      (w_Z = 0 ∨ (q₁ : ℤ) ≤ vK₁ w_Z) ∧
      (F_fn w_Z - T_poly z Z = 0 ∨ (bE' : ℤ) ≤ vL (F_fn w_Z - T_poly z Z)) := by
    intro Z z hZ hz w_Z
    have hZ_E' : IntermediateField.inclusion hLE' Z = 0 ∨
        (0 : ℤ) ≤ vE' (IntermediateField.inclusion hLE' Z) :=
      hvalE'_mono (by omega : (0 : ℤ) ≤ (p : ℤ) * 0) (hinc_LE'_val 0 Z hZ)
    have hZ_K₁ : IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' Z) = 0 ∨
        (0 : ℤ) ≤ vK₁ (IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' Z)) :=
      hvalK₁_mono (by omega : (0 : ℤ) ≤ (p : ℤ) * 0)
        (hinc_E'K₁_val 0 (IntermediateField.inclusion hLE' Z) hZ_E')
    have hw_Z : w_Z = 0 ∨ (q₁ : ℤ) ≤ vK₁ w_Z :=
      hvalK₁_mono (by omega : (q₁ : ℤ) ≤ 0 + (q₁ : ℤ))
        (hvalK₁_mul_ge 0 (q₁ : ℤ) _ z hZ_K₁ hz)
    refine ⟨hw_Z, ?_⟩
    set u₁ := 1 - normLM F hM₁'K₁ (1 - w_Z)
    set u₂ := 1 - normLM F hE'K₁ (1 - w_Z)
    have hrem₁ : P_M₁' u₁ - E_M₁' w_Z = 0 ∨ (m₁ : ℤ) ≤ vM₁' (P_M₁' u₁ - E_M₁' w_Z) :=
      (hExp_M₁' w_Z hw_Z).2
    have hrem₂ : P_E' u₂ - E_E' w_Z = 0 ∨ (m₂ : ℤ) ≤ vE' (P_E' u₂ - E_E' w_Z) :=
      (hExp_E' w_Z hw_Z).2
    have hdiff := hBridge_bE' (P_M₁' u₁ - E_M₁' w_Z) (P_E' u₂ - E_E' w_Z) hrem₁ hrem₂
    have halg :
        traceLM F hLM₁' (b * (P_M₁' u₁ - E_M₁' w_Z)) -
          traceLM F hLE' (a * (P_E' u₂ - E_E' w_Z)) =
        F_fn w_Z - T_poly z Z := by
      rw [← hE_diff_eq Z z]
      change traceLM F hLM₁' (b * (P_M₁' u₁ - E_M₁' w_Z)) -
          traceLM F hLE' (a * (P_E' u₂ - E_E' w_Z)) =
        (traceLM F hLM₁' (b * P_M₁' u₁) - traceLM F hLE' (a * P_E' u₂)) -
          (traceLM F hLM₁' (b * E_M₁' w_Z) - traceLM F hLE' (a * E_E' w_Z))
      rw [mul_sub, mul_sub, map_sub (traceLM F hLM₁'), map_sub (traceLM F hLE')]
      ring
    rwa [halg] at hdiff
  exact ⟨hz_k_val, hF_val, hGHPhi_val, hF_poly⟩

theorem ld_ch12_wild_odd_tot_ram_teichmuller_weighted_sum_cancellation (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (p bE' t₁ q_p : ℕ) (hPrime : Nat.Prime p) (hp_ne2 : p ≠ 2)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hj_inv : ∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : L) ≠ 0 ∧ valL F L (((j : ℕ) : L)⁻¹) = 0)
    (ψ : AddChar L (Ω F)) (α : L)
    (τ_unit : ℕ → Lˣ)
    (hτ_unit_val : ∀ c ∈ (Finset.range p).erase 0,
      valL F L (τ_unit c : L) = 0 ∧
      valL F L (((τ_unit c)⁻¹ : Lˣ) : L) = 0 ∧
      ((τ_unit c : L) ^ (p - 1) - 1 = 0 ∨
        ((bE' + t₁ + 1 : ℕ) : ℤ) ≤ valL F L ((τ_unit c : L) ^ (p - 1) - 1)))
    (hτ_sum_ndvd : ∀ A ∈ Finset.Icc 1 (2 * (p - 1)),
      ¬ ((p - 1) ∣ A) →
      (∑ c ∈ (Finset.range p).erase 0, (τ_unit c : L) ^ A) = 0 ∨
        ((bE' + t₁ + 1 : ℕ) : ℤ) ≤
          valL F L (∑ c ∈ (Finset.range p).erase 0, (τ_unit c : L) ^ A))
    (hψ_triv_bE' : ∀ y : L, (y = 0 ∨ (bE' : ℤ) ≤ valL F L y) → ψ (2 * α * y) = 1)
    (hψ_pow_c : ∀ c ∈ (Finset.range p).erase 0,
      ∀ v : L, (v = 0 ∨ (q_p : ℤ) ≤ valL F L v) →
        (ψ (2 * α * v)) ^ (c ^ (p - 2)) =
          ψ (2 * α * ((((τ_unit c)⁻¹ : Lˣ) : L) * v)))
    (F_c G₁ H₁ : ℕ → L) (Φ₀ : ℕ → ℕ → L)
    (hFc_val : ∀ c ∈ (Finset.range p).erase 0,
      F_c c = 0 ∨ (q_p : ℤ) ≤ valL F L (F_c c))
    (hGH_val : ∀ m ∈ Finset.Icc 1 (p - 1),
      (G₁ m = 0 ∨ -(t₁ : ℤ) ≤ valL F L (G₁ m)) ∧
      (H₁ m = 0 ∨ -(t₁ : ℤ) ≤ valL F L (H₁ m)))
    (hPhi_val : ∀ j ∈ Finset.Icc 1 (p - 2), ∀ r ∈ Finset.Icc 1 (p - 1),
      Φ₀ j r = 0 ∨ -(t₁ : ℤ) ≤ valL F L (Φ₀ j r))
    (hPhi_diag : ∀ j ∈ Finset.Icc 1 (p - 2),
      Φ₀ j (p - j) = 0 ∨ (bE' : ℤ) ≤ valL F L (Φ₀ j (p - j)))
    (hGH_char1 : ψ (2 * α * (G₁ 1 + H₁ 1)) = 1)
    (hFc_poly : ∀ c ∈ (Finset.range p).erase 0,
      let Z := (τ_unit c : L)
      let T_c :=
        (∑ m ∈ Finset.Icc 1 (p - 1),
          ((m : ℕ) : L)⁻¹ * (Z ^ m * G₁ m + Z ^ (p * m) * H₁ m)) +
        (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
          ((r : ℕ) : L)⁻¹ * Z ^ (r + p * j) * Φ₀ j r)
      F_c c - T_c = 0 ∨ (bE' : ℤ) ≤ valL F L (F_c c - T_c)) :
    ∏ c ∈ (Finset.range p).erase 0, (ψ (2 * α * F_c c)) ^ (c ^ (p - 2)) = 1 :=
by
  rcases hvalL_props with
    ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _, _, _⟩
  have hvalL_neg_ge : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · rw [hvalL_neg]
      exact Or.inr hx
  have hvalL_sub : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hvalL_add k x (-y) hx (hvalL_neg_ge k y hy)
  have hvalL_mono : ∀ (k₁ k₂ : ℤ) (x : L),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hvalL_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by simp [hx0])
    · by_cases hy0 : y = 0
      · exact Or.inl (by simp [hy0])
      · rcases hx with rfl | hx
        · contradiction
        · rcases hy with rfl | hy
          · contradiction
          · right
            rw [hvalL_mul x y hx0 hy0]
            exact add_le_add hx hy
  have hvalL_mul_zero_left : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ (0 : ℤ) ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x * y = 0 ∨ k ≤ valL F L (x * y)) := by
    intro k x y hx hy
    have h := hvalL_mul_ge 0 k x y hx hy
    rwa [zero_add] at h
  have hvalL_pow_ge0 : ∀ (x : L) (n : ℕ),
      (x = 0 ∨ (0 : ℤ) ≤ valL F L x) →
        (x ^ n = 0 ∨ (0 : ℤ) ≤ valL F L (x ^ n)) := by
    intro x n hx
    induction n with
    | zero =>
      rw [pow_zero]
      exact Or.inr (le_of_eq hvalL_1.symm)
    | succ n ih =>
      rw [pow_succ']
      exact hvalL_mul_zero_left 0 x (x ^ n) hx ih
  have hvalL_sum_ge : ∀ (s : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ s, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ s, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ s, f i)) := by
    intro s f k hf
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty]
      exact Or.inl rfl
    | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      apply hvalL_add k (f a) (∑ i ∈ s, f i)
      · exact hf a (Finset.mem_insert_self a s)
      · exact ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hp_two_le : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := by omega
  set S_p : Finset ℕ := (Finset.range p).erase 0
  set B_tau : ℤ := ((bE' + t₁ + 1 : ℕ) : ℤ)
  have hSp_card : S_p.card = p - 1 := by
    dsimp [S_p]
    rw [Finset.card_erase_of_mem (Finset.mem_range.mpr hp_pos), Finset.card_range]
  have hSp_sum_one : (∑ _c ∈ S_p, (1 : L)) = ((p - 1 : ℕ) : L) := by
    rw [Finset.sum_const, hSp_card, nsmul_eq_mul, mul_one]
  have hτ_val0 : ∀ c ∈ S_p, (τ_unit c : L) = 0 ∨ (0 : ℤ) ≤ valL F L (τ_unit c : L) :=
    fun c hc => Or.inr (le_of_eq (hτ_unit_val c hc).1.symm)
  have hτ_inv_val0 : ∀ c ∈ S_p,
      (((τ_unit c)⁻¹ : Lˣ) : L) = 0 ∨ (0 : ℤ) ≤ valL F L (((τ_unit c)⁻¹ : Lˣ) : L) :=
    fun c hc => Or.inr (le_of_eq (hτ_unit_val c hc).2.1.symm)
  have hj_inv_val0 : ∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : L)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F L (((j : ℕ) : L)⁻¹) :=
    fun j hj => Or.inr (le_of_eq (hj_inv j hj).2.symm)
  have hBtau_sub_t1 : (bE' : ℤ) ≤ B_tau + -(t₁ : ℤ) := by
    dsimp [B_tau]
    omega
  have hτ_p1_pow : ∀ c ∈ S_p, ∀ q : ℕ,
      ((τ_unit c : L) ^ (p - 1)) ^ q - 1 = 0 ∨
        B_tau ≤ valL F L (((τ_unit c : L) ^ (p - 1)) ^ q - 1) := by
    intro c hc q
    induction q with
    | zero =>
      exact Or.inl (by ring)
    | succ q ih =>
      set u_c : L := (τ_unit c : L) ^ (p - 1)
      have hu_val0 : u_c = 0 ∨ (0 : ℤ) ≤ valL F L u_c :=
        hvalL_pow_ge0 (τ_unit c : L) (p - 1) (hτ_val0 c hc)
      have hu_step : u_c ^ (q + 1) - 1 = u_c * (u_c ^ q - 1) + (u_c - 1) := by
        rw [pow_succ']
        ring
      rw [hu_step]
      exact hvalL_add B_tau (u_c * (u_c ^ q - 1)) (u_c - 1)
        (hvalL_mul_zero_left B_tau u_c (u_c ^ q - 1) hu_val0 ih)
        (hτ_unit_val c hc).2.2
  have hτ_exp_red_id : ∀ (c q A : ℕ),
      (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ ((p - 1) * q + A + 1) -
        (τ_unit c : L) ^ A =
      (τ_unit c : L) ^ A * (((τ_unit c : L) ^ (p - 1)) ^ q - 1) := by
    intro c q A
    have hpow : (τ_unit c : L) ^ ((p - 1) * q + A + 1) =
        (τ_unit c : L) * ((τ_unit c : L) ^ A * ((τ_unit c : L) ^ (p - 1)) ^ q) := by
      rw [show (p - 1) * q + A + 1 = 1 + (A + (p - 1) * q) by omega,
        pow_add, pow_one, pow_add, pow_mul]
    have hinv : (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) = 1 :=
      Units.inv_mul (τ_unit c)
    rw [hpow, ← mul_assoc, hinv, one_mul]
    ring
  have hτ_weighted_pow_ndvd : ∀ (q A : ℕ),
      A ∈ Finset.Icc 1 (2 * (p - 1)) →
      ¬ ((p - 1) ∣ A) →
      (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ ((p - 1) * q + A + 1)) = 0 ∨
        B_tau ≤ valL F L
          (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ ((p - 1) * q + A + 1)) := by
    intro q A hA_Icc hA_ndvd
    have hsum_split :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ ((p - 1) * q + A + 1)) =
        (∑ c ∈ S_p,
          ((((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ ((p - 1) * q + A + 1) -
            (τ_unit c : L) ^ A)) +
        (∑ c ∈ S_p, (τ_unit c : L) ^ A) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun c _ => ?_
      ring
    rw [hsum_split]
    apply hvalL_add B_tau
    · apply hvalL_sum_ge S_p _ B_tau
      intro c hc
      rw [hτ_exp_red_id c q A]
      exact hvalL_mul_zero_left B_tau ((τ_unit c : L) ^ A)
        (((τ_unit c : L) ^ (p - 1)) ^ q - 1)
        (hvalL_pow_ge0 (τ_unit c : L) A (hτ_val0 c hc))
        (hτ_p1_pow c hc q)
    · exact hτ_sum_ndvd A hA_Icc hA_ndvd
  set W_GH : ℕ → L := fun m =>
    ∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) *
      (((m : ℕ) : L)⁻¹ * ((τ_unit c : L) ^ m * G₁ m + (τ_unit c : L) ^ (p * m) * H₁ m))
  have h1_mem_Icc : 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
  have hW_GH_1 :
      W_GH 1 - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1) = 0 ∨
        (bE' : ℤ) ≤ valL F L (W_GH 1 - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1)) := by
    have hW1_eq :
        W_GH 1 - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1) =
        (∑ c ∈ S_p, ((τ_unit c : L) ^ (p - 1) - 1)) * H₁ 1 := by
      have hterm1 : ∀ c ∈ S_p,
          (((τ_unit c)⁻¹ : Lˣ) : L) *
            (((1 : ℕ) : L)⁻¹ * ((τ_unit c : L) ^ 1 * G₁ 1 + (τ_unit c : L) ^ (p * 1) * H₁ 1)) =
          (1 : L) * G₁ 1 + (τ_unit c : L) ^ (p - 1) * H₁ 1 := by
        intro c _
        have hinv : (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) = 1 :=
          Units.inv_mul (τ_unit c)
        have hp1 : (τ_unit c : L) ^ (p * 1) = (τ_unit c : L) * (τ_unit c : L) ^ (p - 1) := by
          rw [show p * 1 = 1 + (p - 1) by omega, pow_add, pow_one]
        rw [Nat.cast_one, inv_one, one_mul, pow_one, hp1]
        calc (((τ_unit c)⁻¹ : Lˣ) : L) *
              ((τ_unit c : L) * G₁ 1 + (τ_unit c : L) * (τ_unit c : L) ^ (p - 1) * H₁ 1)
            = ((((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L)) * G₁ 1 +
              ((((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L)) * (τ_unit c : L) ^ (p - 1) * H₁ 1 := by
              ring
          _ = (1 : L) * G₁ 1 + (τ_unit c : L) ^ (p - 1) * H₁ 1 := by
              rw [hinv]
              ring
      have hW1_sum : W_GH 1 =
          ((p - 1 : ℕ) : L) * G₁ 1 + (∑ c ∈ S_p, (τ_unit c : L) ^ (p - 1)) * H₁ 1 := by
        dsimp [W_GH]
        rw [Finset.sum_congr rfl hterm1, Finset.sum_add_distrib, ← Finset.sum_mul,
          ← Finset.sum_mul, hSp_sum_one]
      have hdiff_sum :
          (∑ c ∈ S_p, ((τ_unit c : L) ^ (p - 1) - 1)) =
          (∑ c ∈ S_p, (τ_unit c : L) ^ (p - 1)) - ((p - 1 : ℕ) : L) := by
        rw [Finset.sum_sub_distrib, hSp_sum_one]
      rw [hW1_sum, hdiff_sum]
      ring
    rw [hW1_eq]
    have hsum_val :
        (∑ c ∈ S_p, ((τ_unit c : L) ^ (p - 1) - 1)) = 0 ∨
          B_tau ≤ valL F L (∑ c ∈ S_p, ((τ_unit c : L) ^ (p - 1) - 1)) :=
      hvalL_sum_ge S_p _ B_tau (fun c hc => (hτ_unit_val c hc).2.2)
    have hH1_val : H₁ 1 = 0 ∨ -(t₁ : ℤ) ≤ valL F L (H₁ 1) :=
      (hGH_val 1 h1_mem_Icc).2
    exact hvalL_mono (bE' : ℤ) (B_tau + -(t₁ : ℤ)) _ hBtau_sub_t1
      (hvalL_mul_ge B_tau (-(t₁ : ℤ)) _ (H₁ 1) hsum_val hH1_val)
  have hW_GH_ge2 : ∀ m ∈ (Finset.Icc 1 (p - 1)).erase 1,
      W_GH m = 0 ∨ (bE' : ℤ) ≤ valL F L (W_GH m) := by
    intro m hm
    have hm_ne1 : m ≠ 1 := (Finset.mem_erase.mp hm).1
    have hm_Icc : m ∈ Finset.Icc 1 (p - 1) := (Finset.mem_erase.mp hm).2
    have hm_ge1 : 1 ≤ m := (Finset.mem_Icc.mp hm_Icc).1
    have hm_le : m ≤ p - 1 := (Finset.mem_Icc.mp hm_Icc).2
    have hm_ge2 : 2 ≤ m := by omega
    have hWm_eq :
        W_GH m = ((m : ℕ) : L)⁻¹ *
          ((∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ m) * G₁ m +
           (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (p * m)) * H₁ m) := by
      dsimp [W_GH]
      rw [Finset.sum_mul, Finset.sum_mul, ← Finset.sum_add_distrib, Finset.mul_sum]
      refine Finset.sum_congr rfl fun c _ => ?_
      ring
    set A : ℕ := m - 1
    have hA_Icc : A ∈ Finset.Icc 1 (2 * (p - 1)) :=
      Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    have hA_ndvd : ¬ ((p - 1) ∣ A) :=
      Nat.not_dvd_of_pos_of_lt (by omega) (by omega)
    have hm_exp : m = (p - 1) * 0 + A + 1 := by omega
    have hpm_exp : p * m = (p - 1) * m + A + 1 := by
      have hp_split : p = (p - 1) + 1 := by omega
      calc p * m = ((p - 1) + 1) * m := by rw [← hp_split]
        _ = (p - 1) * m + m := by ring
        _ = (p - 1) * m + A + 1 := by omega
    have hsum1 :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ m) = 0 ∨
          B_tau ≤ valL F L (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ m) := by
      rw [hm_exp]
      exact hτ_weighted_pow_ndvd 0 A hA_Icc hA_ndvd
    have hsum2 :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (p * m)) = 0 ∨
          B_tau ≤ valL F L
            (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (p * m)) := by
      rw [hpm_exp]
      exact hτ_weighted_pow_ndvd m A hA_Icc hA_ndvd
    have hG_term :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ m) * G₁ m = 0 ∨
          (bE' : ℤ) ≤ valL F L
            ((∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ m) * G₁ m) :=
      hvalL_mono (bE' : ℤ) (B_tau + -(t₁ : ℤ)) _ hBtau_sub_t1
        (hvalL_mul_ge B_tau (-(t₁ : ℤ)) _ (G₁ m) hsum1 (hGH_val m hm_Icc).1)
    have hH_term :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (p * m)) * H₁ m = 0 ∨
          (bE' : ℤ) ≤ valL F L
            ((∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (p * m)) * H₁ m) :=
      hvalL_mono (bE' : ℤ) (B_tau + -(t₁ : ℤ)) _ hBtau_sub_t1
        (hvalL_mul_ge B_tau (-(t₁ : ℤ)) _ (H₁ m) hsum2 (hGH_val m hm_Icc).2)
    rw [hWm_eq]
    exact hvalL_mul_zero_left (bE' : ℤ) (((m : ℕ) : L)⁻¹) _
      (hj_inv_val0 m hm_Icc)
      (hvalL_add (bE' : ℤ) _ _ hG_term hH_term)
  have hW_GH_sum :
      (∑ m ∈ Finset.Icc 1 (p - 1), W_GH m) - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1) = 0 ∨
        (bE' : ℤ) ≤ valL F L
          ((∑ m ∈ Finset.Icc 1 (p - 1), W_GH m) - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1)) := by
    have hsplit :
        (∑ m ∈ Finset.Icc 1 (p - 1), W_GH m) - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1) =
        (W_GH 1 - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1)) +
          (∑ m ∈ (Finset.Icc 1 (p - 1)).erase 1, W_GH m) := by
      rw [← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) W_GH h1_mem_Icc]
      ring
    rw [hsplit]
    exact hvalL_add (bE' : ℤ) _ _ hW_GH_1
      (hvalL_sum_ge ((Finset.Icc 1 (p - 1)).erase 1) W_GH (bE' : ℤ) hW_GH_ge2)
  set W_Phi : ℕ → ℕ → L := fun j r =>
    ((r : ℕ) : L)⁻¹ *
      (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j)) *
      Φ₀ j r
  have hW_Phi_term : ∀ j ∈ Finset.Icc 1 (p - 2), ∀ r ∈ Finset.Icc 1 (p - 1),
      W_Phi j r = 0 ∨ (bE' : ℤ) ≤ valL F L (W_Phi j r) := by
    intro j hj r hr
    have hj_ge1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
    have hj_le : j ≤ p - 2 := (Finset.mem_Icc.mp hj).2
    have hr_ge1 : 1 ≤ r := (Finset.mem_Icc.mp hr).1
    have hr_le : r ≤ p - 1 := (Finset.mem_Icc.mp hr).2
    by_cases hr_diag : r = p - j
    · have hsum_val0 :
          (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j)) = 0 ∨
            (0 : ℤ) ≤ valL F L
              (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j)) :=
        hvalL_sum_ge S_p _ 0 fun c hc =>
          hvalL_mul_zero_left 0 (((τ_unit c)⁻¹ : Lˣ) : L) ((τ_unit c : L) ^ (r + p * j))
            (hτ_inv_val0 c hc)
            (hvalL_pow_ge0 (τ_unit c : L) (r + p * j) (hτ_val0 c hc))
      have hleft_val0 :
          ((r : ℕ) : L)⁻¹ *
            (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j)) = 0 ∨
          (0 : ℤ) ≤ valL F L
            (((r : ℕ) : L)⁻¹ *
              (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j))) :=
        hvalL_mul_zero_left 0 (((r : ℕ) : L)⁻¹) _ (hj_inv_val0 r hr) hsum_val0
      have hPhi_diag_r : Φ₀ j r = 0 ∨ (bE' : ℤ) ≤ valL F L (Φ₀ j r) := by
        rw [hr_diag]
        exact hPhi_diag j hj
      exact hvalL_mul_zero_left (bE' : ℤ) _ (Φ₀ j r) hleft_val0 hPhi_diag_r
    · set A : ℕ := r + j - 1
      have hA_Icc : A ∈ Finset.Icc 1 (2 * (p - 1)) :=
        Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hA_ndvd : ¬ ((p - 1) ∣ A) := by
        rintro ⟨k, hk⟩
        rcases k with _ | _ | k
        · omega
        · omega
        · have hk2 : (p - 1) * 2 ≤ (p - 1) * (k + 1 + 1) :=
            Nat.mul_le_mul_left (p - 1) (by omega)
          omega
      have hrpj_exp : r + p * j = (p - 1) * j + A + 1 := by
        have hp_split : p = (p - 1) + 1 := by omega
        calc r + p * j = r + ((p - 1) + 1) * j := by rw [← hp_split]
          _ = (p - 1) * j + (r + j) := by ring
          _ = (p - 1) * j + A + 1 := by omega
      have hsum_val :
          (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j)) = 0 ∨
            B_tau ≤ valL F L
              (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j)) := by
        rw [hrpj_exp]
        exact hτ_weighted_pow_ndvd j A hA_Icc hA_ndvd
      have hleft_val :
          ((r : ℕ) : L)⁻¹ *
            (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j)) = 0 ∨
          B_tau ≤ valL F L
            (((r : ℕ) : L)⁻¹ *
              (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (τ_unit c : L) ^ (r + p * j))) :=
        hvalL_mul_zero_left B_tau (((r : ℕ) : L)⁻¹) _ (hj_inv_val0 r hr) hsum_val
      exact hvalL_mono (bE' : ℤ) (B_tau + -(t₁ : ℤ)) _ hBtau_sub_t1
        (hvalL_mul_ge B_tau (-(t₁ : ℤ)) _ (Φ₀ j r) hleft_val (hPhi_val j hj r hr))
  have hW_Phi_sum :
      (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1), W_Phi j r) = 0 ∨
        (bE' : ℤ) ≤ valL F L
          (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1), W_Phi j r) :=
    hvalL_sum_ge (Finset.Icc 1 (p - 2)) _ (bE' : ℤ) fun j hj =>
      hvalL_sum_ge (Finset.Icc 1 (p - 1)) _ (bE' : ℤ) fun r hr =>
        hW_Phi_term j hj r hr
  set T_fn : ℕ → L := fun c =>
    (∑ m ∈ Finset.Icc 1 (p - 1),
      ((m : ℕ) : L)⁻¹ * ((τ_unit c : L) ^ m * G₁ m + (τ_unit c : L) ^ (p * m) * H₁ m)) +
    (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
      ((r : ℕ) : L)⁻¹ * (τ_unit c : L) ^ (r + p * j) * Φ₀ j r)
  have hFc_minus_Tc_sum :
      (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c) -
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * T_fn c) = 0 ∨
      (bE' : ℤ) ≤ valL F L
        ((∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c) -
          (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * T_fn c)) := by
    have hsub_eq :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c) -
          (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * T_fn c) =
        ∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * (F_c c - T_fn c) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun c _ => ?_
      ring
    rw [hsub_eq]
    exact hvalL_sum_ge S_p _ (bE' : ℤ) fun c hc =>
      hvalL_mul_zero_left (bE' : ℤ) (((τ_unit c)⁻¹ : Lˣ) : L) (F_c c - T_fn c)
        (hτ_inv_val0 c hc) (hFc_poly c hc)
  have hTc_sum_eq :
      (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * T_fn c) =
      (∑ m ∈ Finset.Icc 1 (p - 1), W_GH m) +
        (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1), W_Phi j r) := by
    have h1 :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) *
          (∑ m ∈ Finset.Icc 1 (p - 1),
            ((m : ℕ) : L)⁻¹ *
              ((τ_unit c : L) ^ m * G₁ m + (τ_unit c : L) ^ (p * m) * H₁ m))) =
        ∑ m ∈ Finset.Icc 1 (p - 1), W_GH m := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
    have h2 :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) *
          (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
            ((r : ℕ) : L)⁻¹ * (τ_unit c : L) ^ (r + p * j) * Φ₀ j r)) =
        ∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1), W_Phi j r := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun r _ => ?_
      dsimp [W_Phi]
      rw [Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun c _ => ?_
      ring
    calc (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * T_fn c)
        = (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) *
            (∑ m ∈ Finset.Icc 1 (p - 1),
              ((m : ℕ) : L)⁻¹ *
                ((τ_unit c : L) ^ m * G₁ m + (τ_unit c : L) ^ (p * m) * H₁ m))) +
          (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) *
            (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
              ((r : ℕ) : L)⁻¹ * (τ_unit c : L) ^ (r + p * j) * Φ₀ j r)) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun c _ => ?_
          dsimp [T_fn]
          ring
      _ = (∑ m ∈ Finset.Icc 1 (p - 1), W_GH m) +
            (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1), W_Phi j r) := by
          rw [h1, h2]
  have hTotal_diff_val :
      (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c) -
        ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1) = 0 ∨
      (bE' : ℤ) ≤ valL F L
        ((∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c) -
          ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1)) := by
    have hsplit :
        (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c) -
          ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1) =
        ((∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c) -
          (∑ c ∈ S_p, (((τ_unit c)⁻¹ : Lˣ) : L) * T_fn c)) +
        (((∑ m ∈ Finset.Icc 1 (p - 1), W_GH m) - ((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1)) +
          (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1), W_Phi j r)) := by
      rw [hTc_sum_eq]
      ring
    rw [hsplit]
    exact hvalL_add (bE' : ℤ) _ _ hFc_minus_Tc_sum
      (hvalL_add (bE' : ℤ) _ _ hW_GH_sum hW_Phi_sum)
  have hψ_prod_sum : ∀ (s : Finset ℕ) (f : ℕ → L),
      (∏ c ∈ s, ψ (2 * α * f c)) = ψ (2 * α * ∑ c ∈ s, f c) := by
    intro s f
    induction s using Finset.induction_on with
    | empty =>
      simp [AddChar.map_zero_eq_one]
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, mul_add,
        AddChar.map_add_eq_mul, ih]
  have hψ_congr : ∀ x y : L,
      (x - y = 0 ∨ (bE' : ℤ) ≤ valL F L (x - y)) →
      ψ (2 * α * x) = ψ (2 * α * y) := by
    intro x y hxy
    have h1 : ψ (2 * α * (x - y)) = 1 := hψ_triv_bE' (x - y) hxy
    have hx_eq : 2 * α * x = 2 * α * (x - y) + 2 * α * y := by ring
    rw [hx_eq, AddChar.map_add_eq_mul, h1, one_mul]
  have hprod_eq :
      (∏ c ∈ S_p, (ψ (2 * α * F_c c)) ^ (c ^ (p - 2))) =
      ∏ c ∈ S_p, ψ (2 * α * ((((τ_unit c)⁻¹ : Lˣ) : L) * F_c c)) :=
    Finset.prod_congr rfl fun c hc => hψ_pow_c c hc (F_c c) (hFc_val c hc)
  rw [hprod_eq, hψ_prod_sum S_p (fun c => (((τ_unit c)⁻¹ : Lˣ) : L) * F_c c)]
  rw [hψ_congr _ (((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1)) hTotal_diff_val]
  have hnsmul :
      2 * α * (((p - 1 : ℕ) : L) * (G₁ 1 + H₁ 1)) =
      (p - 1) • (2 * α * (G₁ 1 + H₁ 1)) := by
    rw [nsmul_eq_mul]
    ring
  rw [hnsmul, AddChar.map_nsmul_eq_pow, hGH_char1, one_pow]

theorem ld_ch12_wild_odd_totally_ramified_teichmuller_weighted_sum_monomial_vanish (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((condExp F L νM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (condExp F L νE' - condExp F L νM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (ha_val : valL F E' (normLM F hE'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hb_val : valL F M₁' (normLM F hM₁'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hMono_vanish :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let t₁ := bM₁' - 1
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let q₁ := (m₁ + p - 1) / p
      let a := normLM F hE'K₁ (Δ : K₁)
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let α := ((c_νE'⁻¹ : Lˣ) : L)
      let g_fn := fun z : K₁ =>
        traceLM F hLM₁' (b * traceLM F hM₁'K₁ z) -
          traceLM F hLE' (a * traceLM F hE'K₁ z)
      let h_fn := fun z : K₁ =>
        traceLM F hLM₁' (b * normLM F hM₁'K₁ z) -
          traceLM F hLE' (a * normLM F hE'K₁ z)
      ∀ (k : Fin p) (x : E'),
        (x = 0 ∨ (q₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ)) →
        let z_k := IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (k : ℕ))
        ψ (2 * α * (g_fn z_k + h_fn z_k)) = 1 ∧
        ∀ j ∈ Finset.Icc 1 (p - 2),
          let r := p - j
          let Φ :=
            traceLM F hLM₁' (b * traceLM F hM₁'K₁ (z_k ^ r) * (normLM F hM₁'K₁ z_k) ^ j) -
              traceLM F hLE' (a * traceLM F hE'K₁ (z_k ^ r) * (normLM F hE'K₁ z_k) ^ j)
          Φ = 0 ∨ (bE' : ℤ) ≤ valL F L Φ)
    (hExp_M₁' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let q₁ := (m₁ + p - 1) / p
      let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
      let E_M₁' := fun w : K₁ =>
        (∑ m ∈ Finset.Icc 1 (p - 1),
          ((m : ℕ) : M₁')⁻¹ * (traceLM F hM₁'K₁ (w ^ m) + (normLM F hM₁'K₁ w) ^ m)) +
        (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
          ((r : ℕ) : M₁')⁻¹ * traceLM F hM₁'K₁ (w ^ r) * (normLM F hM₁'K₁ w) ^ j)
      ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
        let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
        (u₁ = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' u₁) ∧
        (P_M₁' u₁ - E_M₁' w = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (P_M₁' u₁ - E_M₁' w)))
    (hExp_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let m₂ := bE' + bM₁' - 1
      let q₁ := (m₁ + p - 1) / p
      let q₂ := (m₂ + p - 1) / p
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      let E_E' := fun w : K₁ =>
        (∑ m ∈ Finset.Icc 1 (p - 1),
          ((m : ℕ) : E')⁻¹ * (traceLM F hE'K₁ (w ^ m) + (normLM F hE'K₁ w) ^ m)) +
        (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
          ((r : ℕ) : E')⁻¹ * traceLM F hE'K₁ (w ^ r) * (normLM F hE'K₁ w) ^ j)
      ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
        let u₂ := 1 - normLM F hE'K₁ (1 - w)
        (u₂ = 0 ∨ (q₂ : ℤ) ≤ valL F E' u₂) ∧
        (P_E' u₂ - E_E' w = 0 ∨ (m₂ : ℤ) ≤ valL F E' (P_E' u₂ - E_E' w))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let t₁ := bM₁' - 1
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let q₁ := (m₁ + p - 1) / p
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let α := ((c_νE'⁻¹ : Lˣ) : L)
    let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
    let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
    let F_fn := fun w : K₁ =>
      traceLM F hLM₁' (b * P_M₁' (1 - normLM F hM₁'K₁ (1 - w))) -
        traceLM F hLE' (a * P_E' (1 - normLM F hE'K₁ (1 - w)))
    ∃ τ_unit : ℕ → Lˣ,
      (∀ c ∈ (Finset.range p).erase 0,
        ((τ_unit c : L) - (c : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((τ_unit c : L) - (c : L))) ∧
        ∃ k_c : ℕ, c * c ^ (p - 2) = 1 + p * k_c) ∧
      (∀ (k : Fin p) (x : E'),
        (x = 0 ∨ (q₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (k : ℤ) * (t₁ : ℤ)) →
        let z_k := IntermediateField.inclusion hE'K₁ x * ((Δ : K₁) ^ (k : ℕ))
        ∏ c ∈ (Finset.range p).erase 0,
          (ψ (2 * α * F_fn (IntermediateField.inclusion hE'K₁
            (IntermediateField.inclusion hLE' (τ_unit c : L)) * z_k))) ^ (c ^ (p - 2)) = 1) :=
by
  intro p bE' bM₁' t₁ m₁ q₁ a b α P_E' P_M₁' F_fn
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  have hψ_triv := (ld_condExp_and_condExpChar_spec F L ψ hψ νE').1
  have hp_ne2 : p ≠ 2 := by
    dsimp only [p]
    rw [hWild]
    exact hp_odd
  have ht₁_ge1 : 1 ≤ t₁ := by omega
  have hb_ge2 : 2 ≤ bE' + t₁ := by omega
  have hTeich :
      ((p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L)) →
      ∀ (τ_unit τ_tilde : ℕ → Lˣ),
        (∀ j < p, 0 < j →
          (τ_tilde j : L) = (j : L) ^ (p ^ (bE' + t₁)) ∧
          τ_unit j = (τ_tilde j) ^ p) →
        (∀ j < p, 0 < j →
          (τ_unit j : L) ^ (p - 1) - 1 = 0 ∨
            ((bE' + t₁ : ℕ) + 1 : ℤ) ≤ valL F L ((τ_unit j : L) ^ (p - 1) - 1)) ∧
        (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
          (∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
            (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
            ((bE' + t₁ : ℕ) + 1 : ℤ) ≤
              valL F L
                ((∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
                  (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0))) := by
    intro hp_val1 τ_unit τ_tilde hτ_def
    have hT := ld_wild_odd_prime_teichmuller_power_congruences F L p (bE' + t₁)
      hPrime hp_ne2 hb_ge2 hvalL_props hp_val1 0 (Or.inl rfl) τ_unit τ_tilde hτ_def
    exact ⟨hT.2.1, hT.2.2.2⟩
  obtain ⟨hj_inv, τ_unit, hτ_c_props, hτ_unit_val, hτ_sum_ndvd, hψ_triv_bE', hψ_pow_c⟩ :=
    ld_ch12_wild_odd_tot_ram_teichmuller_units_and_c_pow_char_bridge F L E' hLE'
      hPrime hWild hp_odd ψ νE' hbE'_ge2 t₁ ht₁_ge1 c_νE' hc_νE'_val
      htr_LE' hvalL_props hvalE'_props.2.1 hψ_triv hTeich
  obtain ⟨hz_k_val, hF_val, hGHPhi_val, hF_poly⟩ :=
    ld_ch12_wild_odd_tot_ram_scaled_F_fn_expansion_and_term_bounds F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hWild hp_odd hdegE'K₁ hdegM₁'K₁
      νE' νM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      hval_LE' hval_LM₁' hval_E'K₁ hval_norm_E'K₁ hval_norm_M₁'K₁
      htr_LE' htr_LM₁' htr_E'K₁ htr_M₁'K₁
      Δ hΔ_val ha_val hb_val hj_inv hExp_M₁' hExp_E'
  refine ⟨τ_unit, hτ_c_props, ?_⟩
  intro k x hx z_k
  have hz_k : z_k = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ z_k := hz_k_val k x hx
  obtain ⟨hGH_char1, hPhi_diag⟩ := hMono_vanish k x hx
  obtain ⟨hGH_val, hPhi_val⟩ := hGHPhi_val z_k hz_k
  set q_p := (bE' + p - 1) / p
  let F_c : ℕ → L := fun c =>
    F_fn (IntermediateField.inclusion hE'K₁
      (IntermediateField.inclusion hLE' (τ_unit c : L)) * z_k)
  let G₁ : ℕ → L := fun m =>
    traceLM F hLM₁' (b * traceLM F hM₁'K₁ (z_k ^ m)) -
      traceLM F hLE' (a * traceLM F hE'K₁ (z_k ^ m))
  let H₁ : ℕ → L := fun m =>
    traceLM F hLM₁' (b * normLM F hM₁'K₁ (z_k ^ m)) -
      traceLM F hLE' (a * normLM F hE'K₁ (z_k ^ m))
  let Φ₀ : ℕ → ℕ → L := fun j r =>
    traceLM F hLM₁' (b * traceLM F hM₁'K₁ (z_k ^ r) * (normLM F hM₁'K₁ z_k) ^ j) -
      traceLM F hLE' (a * traceLM F hE'K₁ (z_k ^ r) * (normLM F hE'K₁ z_k) ^ j)
  have hFc_val : ∀ c ∈ (Finset.range p).erase 0,
      F_c c = 0 ∨ (q_p : ℤ) ≤ valL F L (F_c c) := by
    intro c hc
    have hZ : (τ_unit c : L) = 0 ∨ (0 : ℤ) ≤ valL F L (τ_unit c : L) :=
      Or.inr (le_of_eq (hτ_unit_val c hc).1.symm)
    exact hF_val _ (hF_poly (τ_unit c : L) z_k hZ hz_k).1
  have hFc_poly : ∀ c ∈ (Finset.range p).erase 0,
      let Z := (τ_unit c : L)
      let T_c :=
        (∑ m ∈ Finset.Icc 1 (p - 1),
          ((m : ℕ) : L)⁻¹ * (Z ^ m * G₁ m + Z ^ (p * m) * H₁ m)) +
        (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
          ((r : ℕ) : L)⁻¹ * Z ^ (r + p * j) * Φ₀ j r)
      F_c c - T_c = 0 ∨ (bE' : ℤ) ≤ valL F L (F_c c - T_c) := by
    intro c hc
    have hZ : (τ_unit c : L) = 0 ∨ (0 : ℤ) ≤ valL F L (τ_unit c : L) :=
      Or.inr (le_of_eq (hτ_unit_val c hc).1.symm)
    exact (hF_poly (τ_unit c : L) z_k hZ hz_k).2
  have hGH_char1' : ψ (2 * α * (G₁ 1 + H₁ 1)) = 1 := by
    dsimp only [G₁, H₁]
    rw [pow_one]
    exact hGH_char1
  exact ld_ch12_wild_odd_tot_ram_teichmuller_weighted_sum_cancellation F L
    p bE' t₁ q_p hPrime hp_ne2 hvalL_props hj_inv ψ α τ_unit
    hτ_unit_val hτ_sum_ndvd hψ_triv_bE' hψ_pow_c
    F_c G₁ H₁ Φ₀ hFc_val hGH_val hPhi_val hPhi_diag hGH_char1' hFc_poly

theorem ld_ch12_wild_odd_tot_ram_unit_model_char_mult_and_deep_base (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
