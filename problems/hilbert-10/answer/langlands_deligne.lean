      right
      rw [hw₂_val]
    have hm_cond : (p : ℤ) * m_val - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ (i : ℤ) * q := by
      linarith [h_ediv, h_emod_nonneg, hA_num_def, hq_def]
    have hs_L := hs_LE'_val (w₂ : E') i hi q m_val hw₂_q hm_cond
    rcases hs_L with h0 | hge
    · left; rw [h0, map_zero]
    · right
      rw [hval_LE', ← hp_def]
      have hpm : (p : ℤ) * m_val ≤ (p : ℤ) * valL F L (s_LE' (w₂ : E') i) :=
        mul_le_mul_of_nonneg_left hge (by omega)
