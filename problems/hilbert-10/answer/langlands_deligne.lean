  obtain ⟨x_0, hx0_int, hx_x0⟩ := hResSurj_E' x hx_int
  let δ_T : Lˣ := ϖ_L ^ d_T
  let δ_E : E'ˣ := ϖ_E' ^ d_T
  let δ_U : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom δ_T
  have hδ_T_val : valL F L (δ_T : L) = (d_T : ℤ) := by
    change valL F L (((ϖ_L ^ d_T : Lˣ) : L)) = (d_T : ℤ)
    rw [Units.val_pow_eq_pow_val]
    exact hϖ_L_pow_val d_T
  have hδ_E_val : valL F E' (δ_E : E') = (d_T : ℤ) := by
