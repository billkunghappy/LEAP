    have hw₁_or : w₁ = 0 ∨ (a : ℤ) ≤ valL F M₁' w₁ := by
      have hιβ₁_inv : ι (β₁⁻¹) = 0 ∨ -(4 * (e : ℤ) + 2 - 4 * (a : ℤ)) ≤ valL F M₁' (ι (β₁⁻¹)) :=
