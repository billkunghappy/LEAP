import Mathlib
import WeilDeligneDefs
set_option maxHeartbeats 4000000

noncomputable section

set_option linter.unusedSectionVars false

open scoped Classical
open ValuativeRel

universe u

/-! ### Statement (originally `langlands_deligne.lean`) -/

open EllipticRootNumber

/--
**Langlands–Deligne: existence of local constants (ε-factors)** (Deligne, *Les constantes des
équations fonctionnelles des fonctions L*, 1973, Théorème 4.1; Tate, *Number theoretic
background*, 1979, Theorem 3.4.1; Dokchitser, *Notes on the parity conjecture*, Theorem 3.12).
Let `F` be a non-archimedean local field with algebraic closure `F̄`, let `Ω = Q̄_ℓ` for a prime
`ℓ ≠ p`, and let `rec` be a local reciprocity map for `F` (`local_reciprocity`). Normalise
the Haar measure of every finite extension `L/F` inside `F̄` by `dx(𝒪_L) = 1`. Then there is a
rule `ε` assigning to every finite `L/F` inside `F̄`, every representation `σ` of the Weil group
`W_L` on an `Ω`-vector space and every additive character `ψ` of `L` a constant
`ε(σ, ψ) ∈ Ω^×` such that, for Weil representations `σ` (finite-dimensional, trivial on an open
subgroup of inertia) and admissible `ψ` (nontrivial, locally constant):
(1) (Multiplicativity) `ε(σ, ψ) = ε(σ₁, ψ) ε(σ₂, ψ)` for every short exact sequence
`0 → σ₁ → σ → σ₂ → 0` of representations of `W_L`;
(2) (Inductivity in degree `0`) for every finite separable `M/L` inside `F̄` and all
representations `σ₁, σ₂` of `W_M` of the same dimension,
`ε(Ind_{W_M}^{W_L} σ₁, ψ) · ε(σ₂, ψ ∘ Tr_{M/L}) = ε(Ind_{W_M}^{W_L} σ₂, ψ) · ε(σ₁, ψ ∘ Tr_{M/L})`;
(3) (Quasi-characters) for every character `χ : W_L → Ω^×` and the character `χ' = χ ∘ rec_L`
of `L^×`, `ε(χ, ψ)` equals Tate's local constant: with `a(χ')` the conductor exponent of `χ'`,
`n(ψ)` the conductor exponent of `ψ`, `q_L` the residue cardinality of `L` and `c ∈ L^×` of
valuation `a(χ') + n(ψ)`,
`ε(χ, ψ) = q_L^{n(ψ)} · χ'(c)` if `χ'` is unramified, and
`ε(χ, ψ) = q_L^{n(ψ)} · ∑_{u ∈ 𝒪_L^× / (1 + 𝔭_L^{a(χ')})} χ'(c⁻¹ u)⁻¹ ψ(c⁻¹ u)` otherwise.
(Property (4) of Dokchitser's Theorem 3.12, the passage from Weil to Weil–Deligne
representations, is Deligne's formula (8.12) and is built into the definition `epsWD` in
`RootNumberDefs.lean`.)
-/
noncomputable def tateEpsUnit (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (χ' : Lˣ →* (Ω F)ˣ) (ψ : AddChar L (Ω F)) : (Ω F)ˣ :=
  if h : tateEps F L χ' ψ ≠ 0 then Units.mk0 (tateEps F L χ' ψ) h else 1

noncomputable def recChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L : IntermediateField F (AlgebraicClosure F))
    (χ : relWeil F L →* (Ω F)ˣ) : Lˣ →* (Ω F)ˣ :=
  Classical.epsilon fun χ' : Lˣ →* (Ω F)ˣ => ∀ x : Lˣ, χ' x = χ (rec.recMap L x)

structure MonomialTerm (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) where
  coeff : ℤ
  field : IntermediateField F (AlgebraicClosure F)
  le : L ≤ field
  χ : relWeil F field →* (Ω F)ˣ

def MonomialTerm.Wf (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (t : MonomialTerm F L) : Prop :=
  FiniteDimensional F t.field ∧
    Algebra.IsSeparable L (IntermediateField.extendScalars t.le) ∧
    IsWeilRep F t.field (charRep F t.field t.χ)

def MonomialTerm.neg (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (t : MonomialTerm F L) : MonomialTerm F L :=
  ⟨-t.coeff, t.field, t.le, t.χ⟩

def MonomialTerm.restrict (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {L M : IntermediateField F (AlgebraicClosure F)}
    (h : L ≤ M) (t : MonomialTerm F M) : MonomialTerm F L :=
  ⟨t.coeff, t.field, h.trans t.le, t.χ⟩

noncomputable def MonomialTerm.trace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (t : MonomialTerm F L) (w : relWeil F L) : Ω F :=
  t.coeff • LinearMap.trace (Ω F) _ (indLM F t.le (charRep F t.field t.χ) w)

noncomputable def MonomialTerm.deg (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (t : MonomialTerm F L) : ℤ :=
  t.coeff * (Module.finrank L (IntermediateField.extendScalars t.le) : ℤ)

noncomputable def monomialListTrace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (D : List (MonomialTerm F L)) (w : relWeil F L) : Ω F :=
  (D.map fun t => t.trace F L w).sum

noncomputable def monomialListDeg (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (D : List (MonomialTerm F L)) : ℤ :=
  (D.map fun t => t.deg F L).sum

def IsMonomialDecomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (tr : relWeil F L → Ω F) (D : List (MonomialTerm F L)) : Prop :=
  (∀ t ∈ D, t.Wf F L) ∧ ∀ w : relWeil F L, tr w = monomialListTrace F L D w

noncomputable def evalMonomialTerm (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (lam : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ)
    (L : IntermediateField F (AlgebraicClosure F)) (ψ : AddChar L (Ω F))
    (t : MonomialTerm F L) : (Ω F)ˣ :=
  (tateEpsUnit F t.field (recChar F rec t.field t.χ) (traceChar F t.le ψ) *
    lam L t.field ψ) ^ t.coeff

noncomputable def evalMonomialList (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (lam : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ)
    (L : IntermediateField F (AlgebraicClosure F)) (ψ : AddChar L (Ω F))
    (D : List (MonomialTerm F L)) : (Ω F)ˣ :=
  (D.map (evalMonomialTerm F rec lam L ψ)).prod

noncomputable def epsFromTrace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (lam : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ)
    (L : IntermediateField F (AlgebraicClosure F)) (tr : relWeil F L → Ω F)
    (ψ : AddChar L (Ω F)) : (Ω F)ˣ :=
  if h : ∃ D : List (MonomialTerm F L), IsMonomialDecomp F L tr D then
    evalMonomialList F rec lam L ψ h.choose
  else 1
def IsGaloisExt (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) : Prop :=
  L ≤ K ∧ FiniteDimensional F K ∧
  (∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ K.fixingSubgroup, σ * τ * σ⁻¹ ∈ K.fixingSubgroup) ∧
  ∀ h : L ≤ K, Algebra.IsSeparable L (IntermediateField.extendScalars h)


def IsLambdaFuncOn (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (ψ : AddChar L (Ω F))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ) : Prop :=
  f L = 1 ∧
  ∀ D : List (MonomialTerm F L),
    IsMonomialDecomp F L 0 D →
    (∀ t ∈ D, t.field ≤ K) →
    evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1


noncomputable def galoisLam (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (ψ : AddChar L (Ω F)) :
    IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ :=
  Classical.epsilon fun f => IsLambdaFuncOn F rec L K ψ f


noncomputable def globalLam (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E : IntermediateField F (AlgebraicClosure F)) (ψ : AddChar L (Ω F)) : (Ω F)ˣ :=
  if h : ∃ K : IntermediateField F (AlgebraicClosure F), IsGaloisExt F L K ∧ E ≤ K then
    galoisLam F rec L h.choose ψ E
  else 1


def restrictWeilChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {E K : IntermediateField F (AlgebraicClosure F)} (h : E ≤ K)
    (χ : relWeil F E →* (Ω F)ˣ) : relWeil F K →* (Ω F)ˣ :=
  χ.comp (Subgroup.inclusion (relWeil_antitone F h))


def IsHomogeneousDecompOn (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (χK : relWeil F K →* (Ω F)ˣ)
    (D : List (MonomialTerm F L)) : Prop :=
  IsMonomialDecomp F L 0 D ∧
  ∀ t ∈ D, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = χK


def IsInvariantWeilChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (χK : relWeil F K →* (Ω F)ˣ) : Prop :=
  IsWeilRep F K (charRep F K χK) ∧
  ∀ (g : relWeil F L) (w : relWeil F K)
    (hgw : (g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹ ∈ relWeil F K),
    χK ⟨(g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹, hgw⟩ = χK w


def LambdaExistsBelow (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F) (n : ℕ) : Prop :=
  ∀ (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
    IsGaloisExt F L K →
    Module.finrank L (IntermediateField.extendScalars hLK) < n →
    ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
      IsLambdaFuncOn F rec L K ψ (galoisLam F rec L K ψ)


def LambdaTheoryBelow (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F) (n : ℕ) : Prop :=
  LambdaExistsBelow F rec n ∧
  (∀ (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
    IsGaloisExt F L K →
    Module.finrank L (IntermediateField.extendScalars hLK) < n →
    ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
    ∀ (g : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ),
      IsLambdaFuncOn F rec L K ψ g →
      ∀ E, L ≤ E → E ≤ K → g E = galoisLam F rec L K ψ E) ∧
  (∀ (L M E K : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (h₁ : L ≤ M) (h₂ : M ≤ E),
    E ≤ K → IsGaloisExt F L K → IsGaloisExt F M K →
    Module.finrank L (IntermediateField.extendScalars hLK) < n →
    ∀ (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
      IsAdmissibleChar F M (traceChar F h₁ ψ) ∧
      galoisLam F rec L K ψ E =
        galoisLam F rec M K (traceChar F h₁ ψ) E *
          (galoisLam F rec L K ψ M) ^ (Module.finrank M (IntermediateField.extendScalars h₂)))


def IsCandidateLambdaOn (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K) (ψ : AddChar L (Ω F))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ) : Prop :=
  f L = 1 ∧
  (∀ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
    K₁ ≤ K → IsGaloisExt F L K₁ →
    Module.finrank L (IntermediateField.extendScalars hLK₁) <
      Module.finrank L (IntermediateField.extendScalars hLK) →
    ∀ E, L ≤ E → E ≤ K₁ → f E = galoisLam F rec L K₁ ψ E) ∧
  (∀ σ ∈ L.fixingSubgroup, ∀ E, L ≤ E → E ≤ K →
    f (E.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) = f E) ∧
  (∀ (M E : IntermediateField F (AlgebraicClosure F)) (h₁ : L ≤ M) (h₂ : M ≤ E) (hMK : M ≤ K),
    E ≤ K →
    Algebra.IsSeparable L (IntermediateField.extendScalars h₁) →
    Algebra.IsSeparable M (IntermediateField.extendScalars h₂) →
    Module.finrank M (IntermediateField.extendScalars hMK) <
      Module.finrank L (IntermediateField.extendScalars hLK) →
    f E =
      galoisLam F rec M K (traceChar F h₁ ψ) E *
        (f M) ^ (Module.finrank M (IntermediateField.extendScalars h₂)))
noncomputable def shiftLamFunc (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (E : IntermediateField F (AlgebraicClosure F)) : (Ω F)ˣ :=
  if h : M ≤ E then
    f E * ((f M) ^ (Module.finrank M (IntermediateField.extendScalars h)))⁻¹
  else 1
def IsMinimalAbelianNormalSubfield (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (M_C : IntermediateField F (AlgebraicClosure F)) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) : Prop :=
  IsGaloisExt F L M_C ∧
  IsAbelianExt F hM_CK ∧
  Module.finrank L (IntermediateField.extendScalars hLM_C) <
    Module.finrank L (IntermediateField.extendScalars hLK) ∧
  (∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
    L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → K₁ ≤ M_C ∨ K₁ ⊔ M_C = K) ∧
  (∀ (E : IntermediateField F (AlgebraicClosure F)),
    L ≤ E → E ≤ K → E ≤ M_C ∨ L < E ⊓ M_C ∨ E ⊔ M_C = K)


def IsSubMonomialDecomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L M_C E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E)
    (D₀ : List (MonomialTerm F L)) : Prop :=
  IsMonomialDecomp F L
    (fun w => (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w) D₀ ∧
  ∀ t ∈ D₀, t.field ≤ M_C


noncomputable def candLamFrom (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L M_C : IntermediateField F (AlgebraicClosure F)) (ψ : AddChar L (Ω F))
    (E : IntermediateField F (AlgebraicClosure F)) : (Ω F)ˣ :=
  if hLE : L ≤ E then
    if hD : ∃ D₀ : List (MonomialTerm F L), IsSubMonomialDecomp F L M_C E hLE D₀ then
      (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ))⁻¹ *
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ hD.choose
    else 1
  else 1


def HasMackeyDecompOn (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (ψ : AddChar L (Ω F)) : Prop :=
  (∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K)
    (hF'E : E ⊓ M_C ≤ E) (hF'K : E ⊓ M_C ≤ K)
    (χL : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ),
    IsWeilRep F L (charRep F L χL) →
    IsWeilRep F E (charRep F E χE) →
    restrictWeilChar F hEK χE = restrictWeilChar F hLK χL →
    ∃ D_M : List (MonomialTerm F (E ⊓ M_C)),
      IsMonomialDecomp F (E ⊓ M_C)
        (fun w => (⟨1, E, hF'E, χE⟩ : MonomialTerm F (E ⊓ M_C)).trace F (E ⊓ M_C) w) D_M ∧
      (∀ t ∈ D_M, t.field ≤ M_C) ∧
      (∀ t ∈ D_M, ∃ htK : t.field ≤ K,
        restrictWeilChar F htK t.χ = restrictWeilChar F hLK χL) ∧
      monomialListDeg F (E ⊓ M_C) D_M =
        (Module.finrank ↥(E ⊓ M_C) (IntermediateField.extendScalars hF'E) : ℤ) ∧
      (χL = 1 → χE = 1 →
        ∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
          L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
          ∀ t ∈ D_M, t.field ≤ K₁)) ∧
  (∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K),
    E ⊓ M_C = L → E ⊔ M_C = K →
    ∀ (χL : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ),
      IsWeilRep F L (charRep F L χL) →
      IsWeilRep F E (charRep F E χE) →
      restrictWeilChar F hEK χE = restrictWeilChar F hLK χL →
      ∃ D_t : List (MonomialTerm F L),
        IsMonomialDecomp F L
          (fun w => (⟨1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w) D_t ∧
        (∀ s ∈ D_t, s.field ≤ M_C) ∧
        (∀ s ∈ D_t, ∃ hsK : s.field ≤ K,
          restrictWeilChar F hsK s.χ = restrictWeilChar F hLK χL) ∧
        evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, χE⟩ =
          evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D_t)


def IsCandNormSubAndConj (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (ψ : AddChar L (Ω F))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ) : Prop :=
  f L = 1 ∧
  (∀ E, L ≤ E → E ≤ M_C → f E = galoisLam F rec L M_C ψ E) ∧
  (∀ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
    K₁ ≤ K → IsGaloisExt F L K₁ →
    Module.finrank L (IntermediateField.extendScalars hLK₁) <
      Module.finrank L (IntermediateField.extendScalars hLK) →
    ∀ E, L ≤ E → E ≤ K₁ → f E = galoisLam F rec L K₁ ψ E) ∧
  (∀ σ ∈ L.fixingSubgroup, ∀ E, L ≤ E → E ≤ K →
    f (E.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) = f E) ∧
  (∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K)
    (hLF' : L ≤ E ⊓ M_C) (hF'E : E ⊓ M_C ≤ E),
    L < E ⊓ M_C →
    f E =
      galoisLam F rec (E ⊓ M_C) K (traceChar F hLF' ψ) E *
        (f (E ⊓ M_C)) ^ (Module.finrank ↥(E ⊓ M_C) (IntermediateField.extendScalars hF'E)))
def IsQuasiElementary {G : Type u} [Group G] (H : Subgroup G) : Prop :=
  ∃ (p : ℕ) (C : Subgroup H) (_ : Fact p.Prime) (_ : C.Normal),
    IsCyclic C ∧ IsPGroup p (H ⧸ C)


noncomputable def indCharTrace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {G : Type u} [Group G] [Fintype G]
    (H : Subgroup G) (ψ : H →* (Ω F)ˣ) (g : G) : Ω F :=
  (Nat.card H : Ω F)⁻¹ *
    ∑ x : G,
      if h : x * g * x⁻¹ ∈ H then
        (ψ ⟨x * g * x⁻¹, h⟩ : Ω F)
      else 0
noncomputable def fixedCosetCount {G : Type u} [Group G]
    (H : Subgroup G) (g : G) : ℤ :=
  (Nat.card {u : G ⧸ H | g • u = u} : ℤ)

def InQESpan {G : Type u} [Group G] (f : G → ℤ) : Prop :=
  ∃ (L_qe : List (ℤ × Subgroup G)),
    (∀ p ∈ L_qe, IsQuasiElementary p.2) ∧
    ∀ g : G, (L_qe.map fun p => p.1 * fixedCosetCount p.2 g).sum = f g

def HasCyclicFixedCosetProps (G : Type u) [Group G] [Fintype G] : Prop :=
  ∀ y₀ : G,
    let C₀ := Subgroup.zpowers y₀
    let n := Nat.card C₀
    IsQuasiElementary C₀ ∧
    (∀ g : G, n < Nat.card (Subgroup.zpowers g) → fixedCosetCount C₀ g = 0) ∧
    (∀ g : G, Nat.card (Subgroup.zpowers g) = n →
      (¬ ∃ x : G, x * g * x⁻¹ ∈ C₀) → fixedCosetCount C₀ g = 0) ∧
    (∀ g : G, Nat.card (Subgroup.zpowers g) = n →
      (∃ x : G, x * g * x⁻¹ ∈ C₀) →
      ∀ H : Subgroup G, fixedCosetCount H g = fixedCosetCount H y₀) ∧
    fixedCosetCount C₀ y₀ = (C₀.relIndex C₀.normalizer : ℤ) ∧
    0 < fixedCosetCount C₀ y₀ ∧
    fixedCosetCount C₀ y₀ ∣ (Fintype.card G : ℤ)
noncomputable def indRepTrace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {G : Type u} [Group G] [Fintype G]
    (H : Subgroup G) {V : Type u} [AddCommGroup V] [Module (Ω F) V]
    (τ : Representation (Ω F) H V) (g : G) : Ω F :=
  (Nat.card H : Ω F)⁻¹ *
    ∑ x : G,
      if h : x * g * x⁻¹ ∈ H then
        LinearMap.trace (Ω F) V (τ ⟨x * g * x⁻¹, h⟩)
      else 0


def subRep {k : Type*} [Field k] {H : Type u} [Group H] {V : Type u} [AddCommGroup V] [Module k V]
    (τ : Representation k H V) (W : Submodule k V)
    (hW : ∀ h : H, W ≤ Submodule.comap (τ h) W) : Representation k H W where
  toFun h := (τ h).restrict (fun x hx => hW h hx)
  map_one' := LinearMap.ext fun x => Subtype.ext (by
    change (τ 1 x.1 : V) = x.1
    rw [map_one, Module.End.one_apply])
  map_mul' h₁ h₂ := LinearMap.ext fun x => Subtype.ext (by
    change (τ (h₁ * h₂) x.1 : V) = τ h₁ (τ h₂ x.1)
    rw [map_mul, Module.End.mul_apply])


def quotRep {k : Type*} [Field k] {H : Type u} [Group H] {V : Type u} [AddCommGroup V] [Module k V]
    (τ : Representation k H V) (W : Submodule k V)
    (hW : ∀ h : H, W ≤ Submodule.comap (τ h) W) : Representation k H (V ⧸ W) where
  toFun h := Submodule.mapQ W W (τ h) (hW h)
  map_one' := LinearMap.ext fun q => Submodule.Quotient.induction_on W q fun x => by
    change Submodule.Quotient.mk (τ 1 x) = Submodule.Quotient.mk x
    rw [map_one, Module.End.one_apply]
  map_mul' h₁ h₂ := LinearMap.ext fun q => Submodule.Quotient.induction_on W q fun x => by
    change Submodule.Quotient.mk (τ (h₁ * h₂) x) = Submodule.Quotient.mk (τ h₁ (τ h₂ x))
    rw [map_mul, Module.End.mul_apply]
def twistMonomialTerm (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (χL : relWeil F L →* (Ω F)ˣ) (t : MonomialTerm F L) : MonomialTerm F L :=
  ⟨t.coeff, t.field, t.le, t.χ * restrictWeilChar F t.le χL⟩
def scaleMonomialTerm (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (c : ℤ) (s : MonomialTerm F L) : MonomialTerm F L :=
  ⟨c * s.coeff, s.field, s.le, s.χ⟩
def leftInvSpace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {G : Type u} [Group G] (H : Subgroup G) :
    Submodule (Ω F) (G → Ω F) where
  carrier := {φ | ∀ (h : H) (x : G), φ ((h : G) * x) = φ x}
  zero_mem' := fun _ _ => rfl
  add_mem' := fun {φ₁ φ₂} h₁ h₂ h x => by
    change φ₁ ((h : G) * x) + φ₂ ((h : G) * x) = φ₁ x + φ₂ x
    rw [h₁ h x, h₂ h x]
  smul_mem' := fun c {φ} hφ h x => by
    change c • φ ((h : G) * x) = c • φ x
    rw [hφ h x]


def rightTransRep (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {G : Type u} [Group G] (H : Subgroup G) :
    Representation (Ω F) G (leftInvSpace F H) where
  toFun g :=
    { toFun := fun φ =>
        ⟨fun x => φ.1 (x * g), fun h x => by
          change φ.1 ((h : G) * x * g) = φ.1 (x * g)
          rw [mul_assoc]
          exact φ.2 h (x * g)⟩
      map_add' := fun φ₁ φ₂ => Subtype.ext (funext fun x => rfl)
      map_smul' := fun c φ => Subtype.ext (funext fun x => rfl) }
  map_one' := LinearMap.ext fun φ => Subtype.ext (funext fun x => by
    change φ.1 (x * 1) = φ.1 x
    rw [mul_one])
  map_mul' g₁ g₂ := LinearMap.ext fun φ => Subtype.ext (funext fun x => by
    change φ.1 (x * (g₁ * g₂)) = φ.1 (x * g₁ * g₂)
    rw [mul_assoc])
def leftEquivSpace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {G : Type u} [Group G] (H : Subgroup G)
    (ψ_H : H →* (Ω F)ˣ) : Submodule (Ω F) (G → Ω F) where
  carrier := {φ | ∀ (h : H) (x : G), φ ((h : G) * x) = (ψ_H h : Ω F) * φ x}
  zero_mem' := fun h x => by
    change (0 : Ω F) = (ψ_H h : Ω F) * 0
    rw [mul_zero]
  add_mem' := fun {φ₁ φ₂} h₁ h₂ h x => by
    change φ₁ ((h : G) * x) + φ₂ ((h : G) * x) = (ψ_H h : Ω F) * (φ₁ x + φ₂ x)
    rw [h₁ h x, h₂ h x, mul_add]
  smul_mem' := fun c {φ} hφ h x => by
    change c * φ ((h : G) * x) = (ψ_H h : Ω F) * (c * φ x)
    rw [hφ h x, mul_left_comm]


def rightEquivTransRep (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {G : Type u} [Group G] (H : Subgroup G)
    (ψ_H : H →* (Ω F)ˣ) : Representation (Ω F) G (leftEquivSpace F H ψ_H) where
  toFun g :=
    { toFun := fun φ =>
        ⟨fun x => φ.1 (x * g), fun h x => by
          change φ.1 ((h : G) * x * g) = (ψ_H h : Ω F) * φ.1 (x * g)
          rw [mul_assoc]
          exact φ.2 h (x * g)⟩
      map_add' := fun φ₁ φ₂ => Subtype.ext (funext fun x => rfl)
      map_smul' := fun c φ => Subtype.ext (funext fun x => rfl) }
  map_one' := LinearMap.ext fun φ => Subtype.ext (funext fun x => by
    change φ.1 (x * 1) = φ.1 x
    rw [mul_one])
  map_mul' g₁ g₂ := LinearMap.ext fun φ => Subtype.ext (funext fun x => by
    change φ.1 (x * (g₁ * g₂)) = φ.1 (x * g₁ * g₂)
    rw [mul_assoc])
def elemSymmRange {R : Type*} [CommRing R] (g : ℕ → R) : ℕ → ℕ → R
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | m + 1, 0 => 1
  | m + 1, k + 1 => elemSymmRange g m (k + 1) + g m * elemSymmRange g m k
def IsResidueFieldMap (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F))
    (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M) : Prop :=
  resM 0 = 0 ∧ resM 1 = 1 ∧
  (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
    resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
    resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
    resM (-x₁) = -resM x₁) ∧
  (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) ∧
  (∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a)

def IsStatResChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F))
    (ψ_M : AddChar M (Ω F)) (θ : Mˣ →* (Ω F)ˣ) (ϖ_M c'_θ : Mˣ)
    (k_M : Type u) [Field k_M] (resM : M → k_M) (ψ_0M : AddChar k_M (Ω F)) : Prop :=
  ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
    ψ_0M (resM x) =
      ψ_M (((c'_θ⁻¹ : Mˣ) : M) *
        (((ϖ_M ^ (2 * (condExp F M θ / 2)) : Mˣ) : M) * x))

noncomputable def statHalfCondFactor (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F))
    (ψ_M : AddChar M (Ω F)) (θ : Mˣ →* (Ω F)ˣ) : Ω F :=
  (qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))

noncomputable def oddStatGaussFactor (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) (θ : Mˣ →* (Ω F)ˣ)
    (k_M : Type u) [Field k_M] [Fintype k_M] (ψ_0M : AddChar k_M (Ω F)) : Ω F :=
  if condExp F M θ % 2 = 1 then
    (qL F M : Ω F) ^ ((p F - 1) / 2) *
      (∑ x : k_M, ψ_0M ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ * (x ^ 2)))
  else 1
def conjWeilElt (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {L K : IntermediateField F (AlgebraicClosure F)} (hGal : IsGaloisExt F L K)
    (g : relWeil F L) (w : relWeil F K) : relWeil F K :=
  ⟨(g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹,
    ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ g.2.1 w.2.1) (Subgroup.inv_mem _ g.2.1),
     hGal.2.2.1 g.1 g.2.2 w.1 w.2.2⟩⟩

def conjWeilChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {L K : IntermediateField F (AlgebraicClosure F)} (hGal : IsGaloisExt F L K)
    (g : relWeil F L) (χK : relWeil F K →* (Ω F)ˣ) : relWeil F K →* (Ω F)ˣ where
  toFun w := χK (conjWeilElt F hGal g⁻¹ w)
  map_one' := by
    have h1 : conjWeilElt F hGal g⁻¹ 1 = 1 := by ext; simp [conjWeilElt]
    rw [h1, map_one]
  map_mul' w₁ w₂ := by
    have hm : conjWeilElt F hGal g⁻¹ (w₁ * w₂) =
        conjWeilElt F hGal g⁻¹ w₁ * conjWeilElt F hGal g⁻¹ w₂ := by
      ext; simp [conjWeilElt, mul_assoc]
    rw [hm, map_mul]

noncomputable def termWeilCharOn (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    (t : MonomialTerm F L) : relWeil F K →* (Ω F)ˣ :=
  if h : t.field ≤ K then restrictWeilChar F h t.χ else 1
def mackeyField (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {L : IntermediateField F (AlgebraicClosure F)}
    (A B : IntermediateField F (AlgebraicClosure F))
    (w : relWeil F L) : IntermediateField F (AlgebraicClosure F) :=
  A ⊔ B.map ((w : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)


def mackeyConjHom (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {L : IntermediateField F (AlgebraicClosure F)}
    (A B : IntermediateField F (AlgebraicClosure F))
    (w : relWeil F L) :
    relWeil F (mackeyField F A B w) →* relWeil F B where
  toFun u :=
    ⟨(w : AbsGal F)⁻¹ * (u : AbsGal F) * (w : AbsGal F),
      ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem w.2.1) u.2.1) w.2.1,
        (IntermediateField.mem_fixingSubgroup_iff B _).mpr fun x hx => by
          have hwx : (w : AbsGal F) x ∈ mackeyField F A B w :=
            (show B.map ((w : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) ≤
              mackeyField F A B w from le_sup_right) ⟨x, hx, rfl⟩
          have hu : (u : AbsGal F) ((w : AbsGal F) x) = (w : AbsGal F) x :=
            (IntermediateField.mem_fixingSubgroup_iff (mackeyField F A B w) (u : AbsGal F)).mp
              u.2.2 ((w : AbsGal F) x) hwx
          change (w : AbsGal F)⁻¹ ((u : AbsGal F) ((w : AbsGal F) x)) = x
          rw [hu]
          exact (w : AbsGal F).symm_apply_apply x⟩⟩
  map_one' := Subtype.ext (by simp)
  map_mul' u₁ u₂ := Subtype.ext (by
    change (w : AbsGal F)⁻¹ * ((u₁ : AbsGal F) * (u₂ : AbsGal F)) * (w : AbsGal F) =
      ((w : AbsGal F)⁻¹ * (u₁ : AbsGal F) * (w : AbsGal F)) *
        ((w : AbsGal F)⁻¹ * (u₂ : AbsGal F) * (w : AbsGal F))
    group)


def mackeyChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {L A B : IntermediateField F (AlgebraicClosure F)}
    (χA : relWeil F A →* (Ω F)ˣ) (χB : relWeil F B →* (Ω F)ˣ)
    (w : relWeil F L) :
    relWeil F (mackeyField F A B w) →* (Ω F)ˣ :=
  (restrictWeilChar F (show A ≤ mackeyField F A B w from le_sup_left) χA) *
    (χB.comp (mackeyConjHom F A B w))


def mackeyTerm (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {L : IntermediateField F (AlgebraicClosure F)}
    (A B : IntermediateField F (AlgebraicClosure F))
    (χA : relWeil F A →* (Ω F)ˣ) (χB : relWeil F B →* (Ω F)ˣ)
    (w : relWeil F L) : MonomialTerm F A :=
  ⟨1, mackeyField F A B w, show A ≤ mackeyField F A B w from le_sup_left, mackeyChar F χA χB w⟩

theorem ld_indLM_trace_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (h : L ≤ M) (hSep : Algebra.IsSeparable L (IntermediateField.extendScalars h))
    {V : Type u} [AddCommGroup V] [Module (Ω F) V]
    (σ : Representation (Ω F) (relWeil F M) V) (hσ : IsWeilRep F M σ)
    (D : List (MonomialTerm F M))
    (hD : IsMonomialDecomp F M (fun w => LinearMap.trace (Ω F) V (σ w)) D)
    (w : relWeil F L) :
    LinearMap.trace (Ω F) _ (indLM F h σ w) =
      monomialListTrace F L (D.map (MonomialTerm.restrict F h)) w :=
by
  have hFinQuot : ∀ (L' M' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M']
      (h' : L' ≤ M'), Finite (relWeil F L' ⧸ (relWeil F M').subgroupOf (relWeil F L')) := by
    intro L' M' _ h'
    let E' := IntermediateField.extendScalars h'
    let e_F : M' ≃ₐ[F] E' :=
      { toFun := toExtendScalars F h'
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h').mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F E' := Module.Finite.equiv e_F.toLinearEquiv
    haveI : IsScalarTower F L' E' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L' E' := Module.Finite.of_restrictScalars_finite F L' E'
    letI : Fintype (E' →ₐ[L'] AlgebraicClosure F) :=
      minpoly.AlgHom.fintype L' E' (AlgebraicClosure F)
    let G_L' := relWeil F L'
    let H_ML' := (relWeil F M').subgroupOf G_L'
    let res : G_L' ⧸ H_ML' → (E' →ₐ[L'] AlgebraicClosure F) := fun u =>
      { toFun := fun x => ((cosetRep u : G_L') : AbsGal F) x.1
        map_one' := map_one ((cosetRep u : G_L') : AbsGal F)
        map_mul' := fun x y => map_mul ((cosetRep u : G_L') : AbsGal F) x.1 y.1
        map_zero' := map_zero ((cosetRep u : G_L') : AbsGal F)
        map_add' := fun x y => map_add ((cosetRep u : G_L') : AbsGal F) x.1 y.1
        commutes' := fun r => (cosetRep u).2.2 r }
    have hinj : Function.Injective res := by
      intro u₁ u₂ h_eq
      let g₁ : G_L' := cosetRep u₁
      let g₂ : G_L' := cosetRep u₂
      have h_mem : g₁⁻¹ * g₂ ∈ H_ML' := by
        rw [Subgroup.mem_subgroupOf]
        refine ⟨(g₁⁻¹ * g₂).2.1, ?_⟩
        intro y
        let y_E : E' := ⟨y.1, (IntermediateField.mem_extendScalars h').mpr y.2⟩
        have hy : (g₁ : AbsGal F) y.1 = (g₂ : AbsGal F) y.1 := AlgHom.congr_fun h_eq y_E
        change ((g₁ : AbsGal F)⁻¹ * (g₂ : AbsGal F)) y.1 = y.1
        rw [AlgEquiv.mul_apply, ← hy, ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
      have hq : (g₁ : G_L' ⧸ H_ML') = (g₂ : G_L' ⧸ H_ML') := QuotientGroup.eq.mpr h_mem
      have h1 : (g₁ : G_L' ⧸ H_ML') = u₁ := Quotient.out_eq u₁
      have h2 : (g₂ : G_L' ⧸ H_ML') = u₂ := Quotient.out_eq u₂
      rw [← h1, ← h2, hq]
    exact Finite.of_injective res hinj
  have hFrob : ∀ {G : Type u} [Group G] (H : Subgroup G) [Fintype (G ⧸ H)]
      {W : Type u} [AddCommGroup W] [Module (Ω F) W] [FiniteDimensional (Ω F) W]
      (ρ : Representation (Ω F) H W),
      FiniteDimensional (Ω F) (indSpace H ρ) ∧
      ∀ g : G,
        LinearMap.trace (Ω F) (indSpace H ρ) (indRep H ρ g) =
          ∑ u₀ : G ⧸ H,
            if h_mem : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then
              LinearMap.trace (Ω F) W (ρ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, h_mem⟩)
            else 0 := by
    intro G _ H _ W _ _ _ ρ
    let u : G → G ⧸ H := fun x => QuotientGroup.mk x⁻¹
    let r : G → G := fun x => cosetRep (u x)
    have h_xr_mem : ∀ x : G, x * r x ∈ H := by
      intro x
      have hout : (r x : G ⧸ H) = u x := Quotient.out_eq (u x)
      have hrel : (r x)⁻¹ * x⁻¹ ∈ H := QuotientGroup.eq.mp hout
      have hinv : (x * r x)⁻¹ ∈ H := by
        rw [mul_inv_rev]
        exact hrel
      exact (Subgroup.inv_mem_iff H).mp hinv
    have hu_mul : ∀ (h₀ : H) (x : G), u ((h₀ : G) * x) = u x := by
      intro h₀ x
      apply QuotientGroup.eq.mpr
      rw [inv_inv, mul_inv_cancel_right]
      exact h₀.2
    have hr_mul : ∀ (h₀ : H) (x : G), r ((h₀ : G) * x) = r x := by
      intro h₀ x
      dsimp only [r]
      rw [hu_mul h₀ x]
    have hu_rep_inv : ∀ u₀ : G ⧸ H, u (cosetRep u₀)⁻¹ = u₀ := by
      intro u₀
      dsimp only [u]
      rw [inv_inv]
      exact Quotient.out_eq u₀
    have hr_rep_inv : ∀ u₀ : G ⧸ H, r (cosetRep u₀)⁻¹ = cosetRep u₀ := by
      intro u₀
      dsimp only [r]
      rw [hu_rep_inv u₀]
    let Φ : indSpace H ρ ≃ₗ[Ω F] ((G ⧸ H) → W) :=
      { toFun := fun f u₀ => f.1 (cosetRep u₀)⁻¹
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        invFun := fun φ =>
          ⟨fun x => ρ ⟨x * r x, h_xr_mem x⟩ (φ (u x)), fun h₀ x => by
            dsimp only
            rw [hu_mul h₀ x]
            have h_sub : (⟨((h₀ : G) * x) * r ((h₀ : G) * x), h_xr_mem ((h₀ : G) * x)⟩ : H) =
                h₀ * ⟨x * r x, h_xr_mem x⟩ := by
              apply Subtype.ext
              change ((h₀ : G) * x) * r ((h₀ : G) * x) = (h₀ : G) * (x * r x)
              rw [hr_mul h₀ x, mul_assoc]
            rw [h_sub, map_mul, Module.End.mul_apply]⟩
        left_inv := fun f => Subtype.ext (funext fun x => by
          dsimp only
          have hf := f.2 ⟨x * r x, h_xr_mem x⟩ (r x)⁻¹
          change ρ ⟨x * r x, h_xr_mem x⟩ (f.1 (r x)⁻¹) = f.1 x
          rw [← hf]
          change f.1 ((x * r x) * (r x)⁻¹) = f.1 x
          rw [mul_inv_cancel_right])
        right_inv := fun φ => funext fun u₀ => by
          dsimp only
          rw [hu_rep_inv u₀]
          have h_one : (⟨(cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹, h_xr_mem (cosetRep u₀)⁻¹⟩ : H) = 1 := by
            apply Subtype.ext
            change (cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹ = 1
            rw [hr_rep_inv u₀, inv_mul_cancel]
          rw [h_one, map_one, Module.End.one_apply] }
    have hFin : FiniteDimensional (Ω F) (indSpace H ρ) := Module.Finite.equiv Φ.symm
    refine ⟨hFin, fun g => ?_⟩
    let T : ((G ⧸ H) → W) →ₗ[Ω F] ((G ⧸ H) → W) := Φ.conj (indRep H ρ g)
    have htr_conj : LinearMap.trace (Ω F) (indSpace H ρ) (indRep H ρ g) =
        LinearMap.trace (Ω F) ((G ⧸ H) → W) T :=
      (LinearMap.trace_conj' (indRep H ρ g) Φ).symm
    have hT_sum : T = ∑ u₀ : G ⧸ H,
        (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u₀) ∘ₗ
          LinearMap.proj (R := Ω F) (φ := fun _ => W) u₀ := by
      apply LinearMap.ext
      intro φ
      have hφ : (∑ u₀ : G ⧸ H, LinearMap.single (Ω F) (fun _ => W) u₀ (φ u₀)) = φ := by
        ext u₁
        simpa [LinearMap.single_apply] using
          congr_fun (Finset.univ_sum_single φ) u₁
      calc T φ = T (∑ u₀ : G ⧸ H, LinearMap.single (Ω F) (fun _ => W) u₀ (φ u₀)) := by rw [hφ]
        _ = ∑ u₀ : G ⧸ H, T (LinearMap.single (Ω F) (fun _ => W) u₀ (φ u₀)) := map_sum T _ _
        _ = (∑ u₀ : G ⧸ H,
              (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u₀) ∘ₗ
                LinearMap.proj (R := Ω F) (φ := fun _ => W) u₀) φ := by
          rw [LinearMap.sum_apply]
          rfl
    rw [htr_conj, hT_sum, map_sum]
    apply Finset.sum_congr rfl
    intro u₀ _
    rw [LinearMap.trace_comp_comm']
    let x₀ : G := (cosetRep u₀)⁻¹ * g
    have hu_iff : u x₀ = u₀ ↔ (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H := by
      have hout : QuotientGroup.mk (cosetRep u₀) = u₀ := Quotient.out_eq u₀
      conv_lhs => rw [← hout]
      dsimp only [u]
      rw [QuotientGroup.eq, inv_inv]
    by_cases h_mem : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H
    · rw [dif_pos h_mem]
      have hu_eq : u x₀ = u₀ := hu_iff.mpr h_mem
      have hr_eq : r x₀ = cosetRep u₀ := by
        dsimp only [r]
        rw [hu_eq]
      have hB : LinearMap.proj (R := Ω F) (φ := fun _ => W) u₀ ∘ₗ
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u₀) =
          ρ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, h_mem⟩ := by
        apply LinearMap.ext
        intro v
        change ρ ⟨x₀ * r x₀, h_xr_mem x₀⟩ (LinearMap.single (Ω F) (fun _ => W) u₀ v (u x₀)) =
          ρ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, h_mem⟩ v
        rw [LinearMap.single_apply, hu_eq, Pi.single_eq_same]
        have h_sub : (⟨x₀ * r x₀, h_xr_mem x₀⟩ : H) =
            ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, h_mem⟩ := by
          apply Subtype.ext
          change x₀ * r x₀ = (cosetRep u₀)⁻¹ * g * cosetRep u₀
          rw [hr_eq]
        rw [h_sub]
      rw [hB]
    · rw [dif_neg h_mem]
      have hu_ne : u x₀ ≠ u₀ := fun h_eq => h_mem (hu_iff.mp h_eq)
      have hB : LinearMap.proj (R := Ω F) (φ := fun _ => W) u₀ ∘ₗ
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => W) u₀) = 0 := by
        apply LinearMap.ext
        intro v
        change ρ ⟨x₀ * r x₀, h_xr_mem x₀⟩ (LinearMap.single (Ω F) (fun _ => W) u₀ v (u x₀)) = 0
        rw [LinearMap.single_apply, Pi.single_eq_of_ne hu_ne, map_zero]
      rw [hB, map_zero]
  have hTrans : ∀ (E : IntermediateField F (AlgebraicClosure F)) (h' : M ≤ E)
      {W : Type u} [AddCommGroup W] [Module (Ω F) W]
      (τ : Representation (Ω F) (relWeil F E) W),
      LinearMap.trace (Ω F) _ (indLM F (h.trans h') τ w) =
        LinearMap.trace (Ω F) _ (indLM F h (indLM F h' τ) w) := by
    intro E h' W _ _ τ
    let G_L := relWeil F L
    let G_M := relWeil F M
    let G_E := relWeil F E
    let H_ML := G_M.subgroupOf G_L
    let H_EM := G_E.subgroupOf G_M
    let H_EL := G_E.subgroupOf G_L
    let e_ML := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F h)
    let e_EM := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F h')
    let e_EL := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F (h.trans h'))
    let ι_ML := Subgroup.inclusion (relWeil_antitone F h)
    let ρ_EM := τ.comp e_EM.toMonoidHom
    let ρ_EL := τ.comp e_EL.toMonoidHom
    let ρ_ML := (indLM F h' τ).comp e_ML.toMonoidHom
    let Θ : indSpace H_ML ρ_ML ≃ₗ[Ω F] indSpace H_EL ρ_EL :=
      { toFun := fun f =>
          ⟨fun l => (f.1 l).1 1, fun k l => by
            let k_ML : H_ML := ⟨(k : G_L), (relWeil_antitone F h') k.2⟩
            let k_EM : H_EM := ⟨e_ML k_ML, k.2⟩
            have hf1 := congr_fun (Subtype.ext_iff.mp (f.2 k_ML l)) 1
            have hf2 := (f.1 l).2 k_EM 1
            change (f.1 ((k_ML : G_L) * l)).1 1 = τ (e_EL k) ((f.1 l).1 1)
            rw [hf1]
            change (f.1 l).1 (1 * e_ML k_ML) = τ (e_EM k_EM) ((f.1 l).1 1)
            rw [one_mul, ← mul_one (e_ML k_ML)]
            exact hf2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        invFun := fun F₀ =>
          ⟨fun l =>
            ⟨fun m => F₀.1 (ι_ML m * l), fun k m => by
              let k_EL : H_EL := ⟨ι_ML (k : G_M), k.2⟩
              have hF := F₀.2 k_EL (ι_ML m * l)
              change F₀.1 (ι_ML ((k : G_M) * m) * l) = τ (e_EM k) (F₀.1 (ι_ML m * l))
              have h_mul : ι_ML ((k : G_M) * m) * l = (k_EL : G_L) * (ι_ML m * l) := by
                rw [map_mul, mul_assoc]
              rw [h_mul]
              exact hF⟩,
            fun m₀ l => Subtype.ext (funext fun m => by
              change F₀.1 (ι_ML m * ((m₀ : G_L) * l)) = F₀.1 (ι_ML (m * e_ML m₀) * l)
              rw [← mul_assoc, map_mul]
              rfl)⟩
        left_inv := fun f => Subtype.ext (funext fun l => Subtype.ext (funext fun m => by
          let m_ML : H_ML := ⟨ι_ML m, m.2⟩
          have hf := congr_fun (Subtype.ext_iff.mp (f.2 m_ML l)) 1
          change (f.1 ((m_ML : G_L) * l)).1 1 = (f.1 l).1 m
          rw [hf]
          change (f.1 l).1 (1 * m) = (f.1 l).1 m
          rw [one_mul]))
        right_inv := fun F₀ => Subtype.ext (funext fun l => by
          change F₀.1 (ι_ML 1 * l) = F₀.1 l
          rw [map_one, one_mul]) }
    have hconj : Θ.conj (indLM F h (indLM F h' τ) w) = indLM F (h.trans h') τ w := by
      apply LinearMap.ext
      intro F₀
      apply Subtype.ext
      funext l
      change F₀.1 (ι_ML 1 * (l * w)) = F₀.1 (l * w)
      rw [map_one, one_mul]
    letI : AddCommGroup (indSpace H_EM ρ_EM) := Submodule.addCommGroup (indSpace H_EM ρ_EM)
    letI : AddCommGroup (indSpace H_ML ρ_ML) := Submodule.addCommGroup (indSpace H_ML ρ_ML)
    have htr := (LinearMap.trace_conj' (indLM F h (indLM F h' τ) w) Θ).symm
    rw [hconj] at htr
    exact htr.symm
  let G_L := relWeil F L
  let G_M := relWeil F M
  let H_ML := G_M.subgroupOf G_L
  let e_ML := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F h)
  haveI : Finite (G_L ⧸ H_ML) := hFinQuot L M h
  letI : Fintype (G_L ⧸ H_ML) := Fintype.ofFinite (G_L ⧸ H_ML)
  haveI : FiniteDimensional (Ω F) V := hσ.1
  have htr_σ := (hFrob H_ML (σ.comp e_ML.toMonoidHom)).2 w
  change LinearMap.trace (Ω F) _ (indRep H_ML (σ.comp e_ML.toMonoidHom) w) = _
  rw [htr_σ]
  have h_sum_eq :
      (∑ u₀ : G_L ⧸ H_ML,
        if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ H_ML then
          LinearMap.trace (Ω F) V ((σ.comp e_ML.toMonoidHom) ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩)
        else 0) =
      (∑ u₀ : G_L ⧸ H_ML,
        if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ H_ML then
          monomialListTrace F M D (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩)
        else 0) := by
    apply Finset.sum_congr rfl
    intro u₀ _
    split_ifs with h_mem
    · exact hD.2 (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩)
    · rfl
  rw [h_sum_eq]
  have hWf : ∀ t ∈ D, t.Wf F M := hD.1
  clear hD h_sum_eq htr_σ
  induction D with
  | nil =>
    simp [monomialListTrace]
  | cons t tl ih =>
    have ht : t.Wf F M := hWf t (by simp)
    have htl : ∀ t' ∈ tl, t'.Wf F M := fun t' ht' => hWf t' (by simp [ht'])
    simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
    have h_split :
        (∑ u₀ : G_L ⧸ H_ML,
          if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ H_ML then
            t.trace F M (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩) +
              (tl.map fun x => x.trace F M (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩)).sum
          else 0) =
        (∑ u₀ : G_L ⧸ H_ML,
          if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ H_ML then
            t.trace F M (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩)
          else 0) +
        (∑ u₀ : G_L ⧸ H_ML,
          if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ H_ML then
            (tl.map fun x => x.trace F M (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩)).sum
          else 0) := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro u₀ _
      split_ifs <;> simp
    rw [h_split, ih htl]
    congr 1
    simp only [MonomialTerm.trace, MonomialTerm.restrict]
    have h_smul :
        (∑ u₀ : G_L ⧸ H_ML,
          if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ H_ML then
            t.coeff • LinearMap.trace (Ω F) _
              (indLM F t.le (charRep F t.field t.χ) (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩))
          else 0) =
        t.coeff • (∑ u₀ : G_L ⧸ H_ML,
          if h_mem : (cosetRep u₀)⁻¹ * w * cosetRep u₀ ∈ H_ML then
            LinearMap.trace (Ω F) _
              (indLM F t.le (charRep F t.field t.χ) (e_ML ⟨(cosetRep u₀)⁻¹ * w * cosetRep u₀, h_mem⟩))
          else 0) := by
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro u₀ _
      split_ifs <;> simp
    rw [h_smul]
    congr 1
    haveI : FiniteDimensional F t.field := ht.1
    haveI : FiniteDimensional (Ω F) (ULift.{u} (Ω F)) := ht.2.2.1
    let G_E := relWeil F t.field
    let H_EM := G_E.subgroupOf G_M
    let e_EM := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F t.le)
    haveI : Finite (G_M ⧸ H_EM) := hFinQuot M t.field t.le
    letI : Fintype (G_M ⧸ H_EM) := Fintype.ofFinite (G_M ⧸ H_EM)
    let σ_t := indLM F t.le (charRep F t.field t.χ)
    haveI : FiniteDimensional (Ω F)
        (indSpace H_EM ((charRep F t.field t.χ).comp e_EM.toMonoidHom)) :=
      (hFrob H_EM ((charRep F t.field t.χ).comp e_EM.toMonoidHom)).1
    have htr_t := (hFrob H_ML (σ_t.comp e_ML.toMonoidHom)).2 w
    change _ = LinearMap.trace (Ω F) _ (indLM F (h.trans t.le) (charRep F t.field t.χ) w)
    rw [hTrans t.field t.le (charRep F t.field t.χ)]
    exact htr_t.symm

theorem ld_indLM_charRep_trace_one_eq_card (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M E : IntermediateField F (AlgebraicClosure F)) (h' : M ≤ E)
    (χ : relWeil F E →* (Ω F)ˣ)
    (hFin : Finite (relWeil F M ⧸ (relWeil F E).subgroupOf (relWeil F M))) :
    LinearMap.trace (Ω F) _ (indLM F h' (charRep F E χ) 1) =
      (Nat.card (relWeil F M ⧸ (relWeil F E).subgroupOf (relWeil F M)) : Ω F) :=
by
  let G := relWeil F M
  let H := (relWeil F E).subgroupOf G
  let W := ULift.{u} (Ω F)
  let e_sub := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F h')
  let ρ : Representation (Ω F) H W := (charRep F E χ).comp e_sub.toMonoidHom
  letI : Fintype (G ⧸ H) := Fintype.ofFinite (G ⧸ H)
  let u : G → G ⧸ H := fun x => QuotientGroup.mk x⁻¹
  let r : G → G := fun x => cosetRep (u x)
  have h_xr_mem : ∀ x : G, x * r x ∈ H := by
    intro x
    have hout : (r x : G ⧸ H) = u x := Quotient.out_eq (u x)
    have hrel : (r x)⁻¹ * x⁻¹ ∈ H := QuotientGroup.eq.mp hout
    have hinv : (x * r x)⁻¹ ∈ H := by
      rw [mul_inv_rev]
      exact hrel
    exact (Subgroup.inv_mem_iff H).mp hinv
  have hu_mul : ∀ (h₀ : H) (x : G), u ((h₀ : G) * x) = u x := by
    intro h₀ x
    apply QuotientGroup.eq.mpr
    rw [inv_inv, mul_inv_cancel_right]
    exact h₀.2
  have hr_mul : ∀ (h₀ : H) (x : G), r ((h₀ : G) * x) = r x := by
    intro h₀ x
    dsimp only [r]
    rw [hu_mul h₀ x]
  have hu_rep_inv : ∀ u₀ : G ⧸ H, u (cosetRep u₀)⁻¹ = u₀ := by
    intro u₀
    dsimp only [u]
    rw [inv_inv]
    exact Quotient.out_eq u₀
  have hr_rep_inv : ∀ u₀ : G ⧸ H, r (cosetRep u₀)⁻¹ = cosetRep u₀ := by
    intro u₀
    dsimp only [r]
    rw [hu_rep_inv u₀]
  let Φ : indSpace H ρ ≃ₗ[Ω F] ((G ⧸ H) → Ω F) :=
    { toFun := fun f u₀ => (f.1 (cosetRep u₀)⁻¹).down
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      invFun := fun φ =>
        ⟨fun x => ρ ⟨x * r x, h_xr_mem x⟩ (ULift.up (φ (u x))), fun h₀ x => by
          dsimp only
          rw [hu_mul h₀ x]
          have h_sub : (⟨((h₀ : G) * x) * r ((h₀ : G) * x), h_xr_mem ((h₀ : G) * x)⟩ : H) =
              h₀ * ⟨x * r x, h_xr_mem x⟩ := by
            apply Subtype.ext
            change ((h₀ : G) * x) * r ((h₀ : G) * x) = (h₀ : G) * (x * r x)
            rw [hr_mul h₀ x, mul_assoc]
          rw [h_sub, map_mul, Module.End.mul_apply]⟩
      left_inv := fun f => Subtype.ext (funext fun x => by
        dsimp only
        have hf := f.2 ⟨x * r x, h_xr_mem x⟩ (r x)⁻¹
        change ρ ⟨x * r x, h_xr_mem x⟩ (f.1 (r x)⁻¹) = f.1 x
        rw [← hf]
        change f.1 ((x * r x) * (r x)⁻¹) = f.1 x
        rw [mul_inv_cancel_right])
      right_inv := fun φ => funext fun u₀ => by
        dsimp only
        rw [hu_rep_inv u₀]
        have h_one : (⟨(cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹, h_xr_mem (cosetRep u₀)⁻¹⟩ : H) = 1 := by
          apply Subtype.ext
          change (cosetRep u₀)⁻¹ * r (cosetRep u₀)⁻¹ = 1
          rw [hr_rep_inv u₀, inv_mul_cancel]
        rw [h_one, map_one, Module.End.one_apply] }
  haveI : Module.Finite (Ω F) (indSpace H ρ) := Module.Finite.equiv Φ.symm
  change LinearMap.trace (Ω F) (indSpace H ρ) (indRep H ρ 1) = (Nat.card (G ⧸ H) : Ω F)
  rw [map_one, LinearMap.trace_one, LinearEquiv.finrank_eq Φ, Module.finrank_pi (R := Ω F),
    ← Nat.card_eq_fintype_card]

theorem ld_frob_pow_on_primeToP_roots (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    Nat.Prime (p F) ∧
    (∀ (N : ℕ), 0 < N → ¬ p F ∣ N →
      (N : F) ≠ 0 ∧
      (∃ τ : AbsGal F, ∀ ζ : AlgebraicClosure F, ζ ^ N = 1 → τ ζ = ζ ^ (q F)) ∧
      (∀ σ₀ : AbsGal F, ∃ k : ℕ, ∀ ζ : AlgebraicClosure F, ζ ^ N = 1 → σ₀ ζ = ζ ^ ((q F) ^ k))) :=
by
  have hs1 :
      Nat.Prime (p F) ∧
      (∀ (N : ℕ), ¬ p F ∣ N → (N : 𝓀[F]) ≠ 0 ∧ (N : F) ≠ 0) ∧
      (∀ (N : ℕ), 0 < N →
        ∃ ζ₀ : AlgebraicClosure F, ζ₀ ^ N = 1 ∧
          ∀ ζ : AlgebraicClosure F, ζ ^ N = 1 → ∃ m : ℕ, ζ = ζ₀ ^ m) ∧
      (∀ (ζ₀ : AlgebraicClosure F),
        Polynomial.aeval (ζ₀ ^ (q F)) (minpoly F ζ₀) = 0 →
        ∃ τ : AbsGal F, τ ζ₀ = ζ₀ ^ (q F)) := by
    haveI : CharP 𝓀[F] (p F) := ringChar.of_eq rfl
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    have hp_ne : p F ≠ 0 := CharP.char_ne_zero_of_finite 𝓀[F] (p F)
    haveI : NeZero (p F) := ⟨hp_ne⟩
    have hp_prime : Nat.Prime (p F) := (CharP.char_is_prime_of_pos 𝓀[F] (p F)).1
    refine ⟨hp_prime, ?_, ?_, ?_⟩
    · intro N hpN
      have hN_res : (N : 𝓀[F]) ≠ 0 := by
        intro h0
        exact hpN ((CharP.cast_eq_zero_iff 𝓀[F] (p F) N).mp h0)
      refine ⟨hN_res, ?_⟩
      intro h0
      apply hN_res
      have hO : (N : 𝒪[F]) = 0 := Subtype.ext (by rw [Subring.coe_natCast, h0, ZeroMemClass.coe_zero])
      have hres := congrArg (IsLocalRing.residue 𝒪[F]) hO
      rwa [map_natCast, map_zero] at hres
    · intro N hN_pos
      haveI : NeZero N := ⟨hN_pos.ne'⟩
      obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := rootsOfUnity N (AlgebraicClosure F))
      refine ⟨((g₀ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F), ?_, ?_⟩
      · exact (mem_rootsOfUnity' N (g₀ : (AlgebraicClosure F)ˣ)).mp g₀.2
      · intro ζ hζ
        have hζ0 : ζ ≠ 0 := by
          intro h
          rw [h, zero_pow hN_pos.ne'] at hζ
          exact zero_ne_one hζ
        let u : (AlgebraicClosure F)ˣ := Units.mk0 ζ hζ0
        have hu : u ∈ rootsOfUnity N (AlgebraicClosure F) := (mem_rootsOfUnity' N u).mpr hζ
        obtain ⟨m, hm⟩ := (Submonoid.mem_powers_iff _ _).mp (hg₀ ⟨u, hu⟩)
        refine ⟨m, ?_⟩
        have hm1 : ((g₀ ^ m : rootsOfUnity N (AlgebraicClosure F)) : (AlgebraicClosure F)ˣ) = u :=
          congrArg Subtype.val hm
        rw [Subgroup.coe_pow] at hm1
        have hm2 : (((g₀ : (AlgebraicClosure F)ˣ) ^ m : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) =
            (u : AlgebraicClosure F) := congrArg Units.val hm1
        rw [Units.val_pow_eq_pow_val] at hm2
        exact hm2.symm
    · intro ζ₀ haeval
      have hInt : IsIntegral F ζ₀ := Algebra.IsIntegral.isIntegral ζ₀
      have hmin_eq : minpoly F (ζ₀ ^ (q F)) = minpoly F ζ₀ :=
        (minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hInt) haeval (minpoly.monic hInt)).symm
      have horb : ζ₀ ^ (q F) ∈ MulAction.orbit (AbsGal F) ζ₀ :=
