    (R_L : Finset L) (R_K : Finset K) (c_τ : Lˣ) (u : Kˣ) (N : Lˣ)
    (τ_unit τ_tilde : ℕ → Lˣ) (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRK_card : R_K.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
