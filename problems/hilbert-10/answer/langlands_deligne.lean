          · have hm₂_eq : m₂ + 1 = ℓ := by omega
            rw [Nat.mod_eq_of_lt h1, hm₂_eq, Nat.mod_self] at h_eq
            omega
          · have hm₁_eq : m₁ + 1 = ℓ := by omega
            rw [hm₁_eq, Nat.mod_self, Nat.mod_eq_of_lt h2] at h_eq
