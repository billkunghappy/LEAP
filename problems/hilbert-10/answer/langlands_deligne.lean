      condExp F M₁' θM₁' ≤ condExp F M₁' (ξM₁' ^ j * θM₁') :=
    fun j hj => le_of_eq ((hξM₁'_props j (hdegM₁'K₁ ▸ hj)).2.2.2.1).symm
  obtain ⟨_, _, _, hval_normM₁'K₁, _, hCond_leM₁'K₁, hCond_gtM₁'K₁, _⟩ :=
    hWildCond M₁' K₁ hM₁'K₁ hGalM₁'K₁ hAbM₁'K₁ hPrimeM₁'K₁
      ψM₁' hψM₁' ξM₁' θM₁' hξM₁'_pow hξM₁'_ne hξM₁'_ker hξM₁'_cond_all hθM₁'_cond_all hθM₁'K₁_cond
      hMinCondM₁'K₁ hbξM₁'_ne0 hWildM₁'K₁
  have hM₁'K₁_pair : condExp F M₁' ξM₁' ≤ condExp F M₁' θM₁' ∧
      condExp F K₁ θK₁ = condExp F M₁' ξM₁' + 2 * (condExp F M₁' θM₁' - condExp F M₁' ξM₁') := by
    by_cases hle : condExp F M₁' θM₁' ≤ condExp F M₁' ξM₁'
    · have h1_lt : 1 < Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) :=
        hdegM₁'K₁.symm ▸ hPrime.one_lt
      have heq1 : condExp F M₁' (ξM₁' ^ 1 * θM₁') = condExp F M₁' ξM₁' :=
        (hCond_leM₁'K₁ hle).2 1 h1_lt Nat.one_pos
      have heq2 : condExp F M₁' (ξM₁' ^ 1 * θM₁') = condExp F M₁' θM₁' :=
        (hξM₁'_props 1 hPrime.one_lt).2.2.2.1
      have heq_θξ : condExp F M₁' θM₁' = condExp F M₁' ξM₁' := heq2.symm.trans heq1
      have hK₁_eq : condExp F K₁ θK₁ = condExp F M₁' θM₁' := by
        have h := (hCond_leM₁'K₁ hle).1
        rw [← hχM₁'_comp', h]
      refine ⟨le_of_eq heq_θξ.symm, ?_⟩
      rw [hK₁_eq, heq_θξ, Nat.sub_self, mul_zero, add_zero]
    · have hlt : condExp F M₁' ξM₁' < condExp F M₁' θM₁' := not_le.mp hle
      have hK₁_eq : condExp F K₁ θK₁ =
          condExp F M₁' ξM₁' + 2 * (condExp F M₁' θM₁' - condExp F M₁' ξM₁') := by
        have h := (hCond_gtM₁'K₁ hlt).1
        rw [← hχM₁'_comp', h, hdegM₁'K₁, hdeg2]
      exact ⟨le_of_lt hlt, hK₁_eq⟩
  have hleM₁' : condExp F M₁' ξM₁' ≤ condExp F M₁' θM₁' := hM₁'K₁_pair.1
  have hK₁_M₁' : condExp F K₁ θK₁ =
      condExp F M₁' ξM₁' + 2 * (condExp F M₁' θM₁' - condExp F M₁' ξM₁') := hM₁'K₁_pair.2
  have hqK₁ : qL F K₁ = qL F L := hqK₁_E'.trans hqE'
  have hval_normK₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w ∧
      valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w :=
    fun w => ⟨hval_normE'K₁ w, hval_normM₁'K₁ w⟩
  have hθM₁'_cond : ∀ u ∈ unitGroup F M₁' (condExp F M₁' θM₁'), θM₁' u = 1 := by
    have h0 : ∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ 0 * θM₁')),
        (ξM₁' ^ 0 * θM₁') u = 1 := (hξM₁'_props 0 hPrime.pos).2.2.1
    have h0_eq : condExp F M₁' (ξM₁' ^ 0 * θM₁') = condExp F M₁' θM₁' :=
      (hξM₁'_props 0 hPrime.pos).2.2.2.1
    intro u hu
    rw [← h0_eq] at hu
    have hu1 := h0 u hu
    simpa only [pow_zero, one_mul] using hu1
  clear hWildCond hξE'_props hξM₁'_props hCond_leE' hCond_leM₁' hCond_gtM₁'
    hCond_leE'K₁ hCond_gtE'K₁ hCond_leM₁'K₁ hCond_gtM₁'K₁
  have hcond_sum : condExp F E' θE' + condExp F L νE' =
      condExp F M₁' θM₁' + condExp F L νM₁' := by
    rw [hcond_ξE'] at hleE' hK₁_E'
    rw [hcond_ξM₁'] at hleM₁' hK₁_M₁'
    omega
  obtain ⟨_, σ₀, j₀, hj₀_pos, hj₀_lt, hσ₀_L, _, _, _, hσ₀_twist_pow⟩ :=
    ld_ch12_bicyclic_frob_generator_and_conj_twist F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hPrime hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf h_sup
      χK₁ hInvK₁ hneK₁ χM₁' hχM₁'_weil hχM₁'_rest ψ hψ νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνM₁'_pow hνM₁'_ne hνM₁'_ker
  have hj₀_eq1 : j₀ = 1 := by
    rw [hdeg2] at hj₀_lt
    omega
  have hσ₀_twist : ∀ z : M₁'ˣ,
      θM₁' (Units.map σ₀.toRingEquiv.toMonoidHom z) = ξM₁' z * θM₁' z := by
    intro z
    have h := hσ₀_twist_pow 1 z
    simp only [hj₀_eq1, mul_one, pow_one] at h
    exact h
  have hT1_even : condExp F L νM₁' % 2 = 0 :=
    ld_ch12_wild_dyadic_tot_ram_min_break_even F L E' M₁'
      hLE' hLM₁' hGalLE' hGalLM₁' hPrime hWild hp2 hdegM₁' ψ hψ νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hbE'_ge2 hbM₁'_ge2 hMinM₁' hQuadNorm
  clear hQuadNorm
  obtain ⟨hm1_min_bound, hm1_parity⟩ :=
    ld_ch12_wild_dyadic_tot_ram_m1_min_or_even_dichotomy F L M₁'
      hLM₁' hGalLM₁' hPrimeM₁' hWildM₁' hp2 ψ hψ hψM₁' νM₁'
      hνM₁'_pow' hνM₁'_ne hνM₁'_ker hνM₁'_cond' hbM₁'_ge2
      ξM₁' θM₁' hmM₁'_ge2 hξM₁'_cond1 hθM₁'_cond σ₀ hσ₀_L hσ₀_twist hbξM₁'_ge2
  have hCondDichotomy :
      (condExp F M₁' θM₁' = 2 * condExp F L νE' - 1 ∧
        condExp F E' θE' = condExp F L νM₁' + condExp F L νE' - 1) ∨
      (2 * condExp F L νE' ≤ condExp F M₁' θM₁' ∧
        condExp F M₁' θM₁' % 2 = 0 ∧
        condExp F E' θE' =
          condExp F M₁' θM₁' + condExp F L νM₁' - condExp F L νE') := by
    rw [hcond_ξM₁'] at hm1_min_bound hm1_parity
    rcases eq_or_lt_of_le hm1_min_bound with hm1_eq | hm1_gt
    · left
      omega
    · right
      have hm1_ge : 2 * condExp F L νE' ≤ condExp F M₁' θM₁' := by omega
      have hmod : (condExp F M₁' θM₁' - condExp F L νM₁') % 2 = 0 :=
        hm1_parity (by omega)
      omega
  exact ⟨hqE', hqM₁', hqK₁, hval_normE', hval_normM₁', hval_normK₁,
    hnE', hnM₁', heps1_E', heps1_M₁', hcond_ξE', hcond_ξM₁',
    hcond_sum, hCondDichotomy, hT1_even⟩

theorem ld_ch12_wild_dyadic_even_breaks_two_val_and_base_quadratic_generators (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hStatL : ∃ c_ν₂ : Lˣ,
      valL F L (c_ν₂ : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ ∧
      ∀ x : L, (x = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (νE' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₂⁻¹ : Lˣ) : L) * x))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (htr_surj_E' : ∀ x : L, ∃ y_x : E',
      traceLM F hLE' y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 → y_x ≠ 0 ∧ valL F E' y_x = 2 * valL F L x + 1 - (condExp F L νE' : ℤ)))
    (htr_surj_M₁' : ∀ x : L, ∃ z_x : M₁',
      traceLM F hLM₁' z_x = x ∧
      (x = 0 → z_x = 0) ∧
      (x ≠ 0 → z_x ≠ 0 ∧ valL F M₁' z_x = 2 * valL F L x + 1 - (condExp F L νM₁' : ℤ)))
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (hσ₂_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ₂ y)
    (hσ₂_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ₂ y) :
    let a := condExp F L νM₁' / 2
    let r := condExp F L νE' / 2
    ((2 : L) = 0 ∨ (r : ℤ) ≤ valL F L (2 : L)) ∧
    ∃ (x₀ : M₁') (y : E') (f₀ g : L),
      x₀ ≠ 0 ∧ y ≠ 0 ∧ f₀ ≠ 0 ∧ g ≠ 0 ∧
      valL F M₁' x₀ = (1 - 2 * (a : ℤ)) ∧
      valL F L f₀ = (1 - 2 * (a : ℤ)) ∧
      valL F E' y = (1 - 2 * (r : ℤ)) ∧
      valL F L g = (1 - 2 * (r : ℤ)) ∧
      traceLM F hLM₁' x₀ = -1 ∧
      normLM F hLM₁' x₀ = -f₀ ∧
      x₀ ^ 2 + x₀ = IntermediateField.inclusion hLM₁' f₀ ∧
      τ₁ x₀ = -1 - x₀ ∧
      traceLM F hLE' y = -1 ∧
      normLM F hLE' y = -g ∧
      y ^ 2 + y = IntermediateField.inclusion hLE' g ∧
      σ₂ y = -1 - y ∧
      ∀ w : L, (w = 0 ∨ (1 - (a : ℤ)) ≤ valL F L w) →
        let x : M₁' := x₀ + IntermediateField.inclusion hLM₁' w * (1 + 2 * x₀)
        let f : L := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
        x ≠ 0 ∧ f ≠ 0 ∧
        valL F M₁' x = (1 - 2 * (a : ℤ)) ∧
        valL F L f = (1 - 2 * (a : ℤ)) ∧
        traceLM F hLM₁' x = -1 ∧
        normLM F hLM₁' x = -f ∧
        x ^ 2 + x = IntermediateField.inclusion hLM₁' f ∧
        τ₁ x = -1 - x :=
by
  dsimp only
  set a : ℕ := condExp F L νM₁' / 2
  set r : ℕ := condExp F L νE' / 2
  have ha_ge1 : 1 ≤ a := by omega
  have hr_ge1 : 1 ≤ r := by omega
  have har_le : a ≤ r := by omega
  have hT1_eq : condExp F L νM₁' = 2 * a := by omega
  have hT2_eq : condExp F L νE' = 2 * r := by omega
  have hT2_half : (condExp F L νE' + 1) / 2 = r := by omega
  rcases hvalL_props with ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
    hval_add, hunit0, hunita, hunit_val0⟩
  have h2_val : (2 : L) = 0 ∨ (r : ℤ) ≤ valL F L (2 : L) := by
    by_cases h2_zero : (2 : L) = 0
    · exact Or.inl h2_zero
    · right
      by_contra hlt
      push_neg at hlt
      let u₂ : Lˣ := Units.mk0 (2 : L) h2_zero
      have hu₂_val : valL F L ((u₂⁻¹ : Lˣ) : L) = - valL F L (2 : L) := hval_inv u₂
      rcases hStatL with ⟨c_ν₂, hc_val, hc_stat⟩
      rcases hSpecL.2 with ⟨x₁, hx₁_ne, hx₁_val, hx₁_ne1⟩
      let w₀ : L := (c_ν₂ : L) * ((u₂⁻¹ : Lˣ) : L) * x₁
      have hc_ne : (c_ν₂ : L) ≠ 0 := c_ν₂.ne_zero
      have hu₂_inv_ne : ((u₂⁻¹ : Lˣ) : L) ≠ 0 := (u₂⁻¹ : Lˣ).ne_zero
      have hc_u₂_ne : (c_ν₂ : L) * ((u₂⁻¹ : Lˣ) : L) ≠ 0 := mul_ne_zero hc_ne hu₂_inv_ne
      have hw₀_ne : w₀ ≠ 0 := mul_ne_zero hc_u₂_ne hx₁_ne
      have hw₀_val_eq : valL F L w₀ =
          valL F L (c_ν₂ : L) + valL F L ((u₂⁻¹ : Lˣ) : L) + valL F L x₁ := by
        dsimp only [w₀]
        rw [hval_mul _ _ hc_u₂_ne hx₁_ne, hval_mul _ _ hc_ne hu₂_inv_ne]
      have hw₀_val_ge : (r : ℤ) ≤ valL F L w₀ := by
        omega
      have h1w₀_ne : 1 + w₀ ≠ 0 := by
        intro h1w₀
        have hw₀_eq_neg1 : w₀ = -1 := by linear_combination h1w₀
        have hw₀_val0 : valL F L w₀ = 0 := by rw [hw₀_eq_neg1, hval_neg1]
        omega
      let u_w₀ : Lˣ := Units.mk0 (1 + w₀) h1w₀_ne
      let z₀ : L := (2 : L) * w₀ + w₀ ^ 2
      have h2_mul_u₂_inv : (2 : L) * ((u₂⁻¹ : Lˣ) : L) = 1 := u₂.mul_inv
      have h2w₀_eq : (2 : L) * w₀ = (c_ν₂ : L) * x₁ := by
        calc (2 : L) * w₀
          _ = (c_ν₂ : L) * ((2 : L) * ((u₂⁻¹ : Lˣ) : L)) * x₁ := by dsimp only [w₀]; ring
          _ = (c_ν₂ : L) * 1 * x₁ := by rw [h2_mul_u₂_inv]
          _ = (c_ν₂ : L) * x₁ := by ring
      have h2w₀_ne : (2 : L) * w₀ ≠ 0 := by
        rw [h2w₀_eq]
        exact mul_ne_zero hc_ne hx₁_ne
      have h2w₀_val : valL F L ((2 : L) * w₀) = valL F L (c_ν₂ : L) + valL F L x₁ := by
        rw [h2w₀_eq]
        exact hval_mul _ _ hc_ne hx₁_ne
      have h2w₀_dom : (2 : L) * w₀ = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((2 : L) * w₀) := by
        right
        omega
      have hw₀_sq_ne : w₀ ^ 2 ≠ 0 := pow_ne_zero 2 hw₀_ne
      have hw₀_sq_val : valL F L (w₀ ^ 2) = valL F L w₀ + valL F L w₀ := by
        have hsq : w₀ ^ 2 = w₀ * w₀ := sq w₀
        rw [hsq]
        exact hval_mul w₀ w₀ hw₀_ne hw₀_ne
      have hw₀_sq_dom : w₀ ^ 2 = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L (w₀ ^ 2) := by
        right
        omega
      have hz₀_dom : z₀ = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L z₀ :=
        hval_add (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ((2 : L) * w₀) (w₀ ^ 2) h2w₀_dom hw₀_sq_dom
      have h1z₀_eq : 1 + z₀ = (1 + w₀) ^ 2 := by
        dsimp only [z₀]
        ring
      have h1z₀_ne : 1 + z₀ ≠ 0 := by
        rw [h1z₀_eq]
        exact pow_ne_zero 2 h1w₀_ne
      have hstat_z₀ := hc_stat z₀ hz₀_dom h1z₀_ne
      have hu_z₀_eq : Units.mk0 (1 + z₀) h1z₀_ne = u_w₀ ^ 2 := by
        ext
        simp [u_w₀, h1z₀_eq]
      have hνE'_sq : νE' ^ 2 = 1 := by
        rw [← hdeg2]
        exact hνE'_pow
      have hνE'_u_z₀ : νE' (Units.mk0 (1 + z₀) h1z₀_ne) = 1 := by
        rw [hu_z₀_eq, map_pow]
        change (νE' ^ 2) u_w₀ = 1
        rw [hνE'_sq, MonoidHom.one_apply]
      have hc_inv_mul_c : ((c_ν₂⁻¹ : Lˣ) : L) * (c_ν₂ : L) = 1 := c_ν₂.inv_mul
      have hcz₀_eq : ((c_ν₂⁻¹ : Lˣ) : L) * z₀ = x₁ + ((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2 := by
        calc ((c_ν₂⁻¹ : Lˣ) : L) * z₀
          _ = ((c_ν₂⁻¹ : Lˣ) : L) * ((2 : L) * w₀) + ((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2 := by
            dsimp only [z₀]; ring
          _ = (((c_ν₂⁻¹ : Lˣ) : L) * (c_ν₂ : L)) * x₁ + ((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2 := by
            rw [h2w₀_eq]; ring
          _ = 1 * x₁ + ((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2 := by rw [hc_inv_mul_c]
          _ = x₁ + ((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2 := by ring
      have hc_inv_ne : ((c_ν₂⁻¹ : Lˣ) : L) ≠ 0 := (c_ν₂⁻¹ : Lˣ).ne_zero
      have hc_inv_val : valL F L ((c_ν₂⁻¹ : Lˣ) : L) = - valL F L (c_ν₂ : L) := hval_inv c_ν₂
      have hcw₀_sq_val : valL F L (((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2) =
          valL F L ((c_ν₂⁻¹ : Lˣ) : L) + valL F L (w₀ ^ 2) :=
        hval_mul _ _ hc_inv_ne hw₀_sq_ne
      have hcw₀_sq_dom : ((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2 = 0 ∨
          -condExpChar F L ψ ≤ valL F L (((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2) := by
        right
        omega
      have hψ_cw₀_sq : ψ (((c_ν₂⁻¹ : Lˣ) : L) * w₀ ^ 2) = 1 :=
        hSpecL.1 _ hcw₀_sq_dom
      rw [hνE'_u_z₀, Units.val_one, hcz₀_eq, AddChar.map_add_eq_mul, hψ_cw₀_sq, mul_one] at hstat_z₀
      exact hx₁_ne1 hstat_z₀.symm
  have hneg1_ne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
  rcases htr_surj_M₁' (-1 : L) with ⟨x₀, hx₀_tr, _, hx₀_ne_val⟩
  rcases hx₀_ne_val hneg1_ne with ⟨hx₀_ne, hx₀_val_raw⟩
  have hx₀_val : valL F M₁' x₀ = 1 - 2 * (a : ℤ) := by omega
  let f₀ : L := - normLM F hLM₁' x₀
  have hx₀_norm : normLM F hLM₁' x₀ = -f₀ := by
    dsimp only [f₀]
    rw [neg_neg]
  have hf₀_val : valL F L f₀ = 1 - 2 * (a : ℤ) := by
    dsimp only [f₀]
    rw [hval_neg, hval_normM₁' x₀, hx₀_val]
  have hf₀_ne : f₀ ≠ 0 := by
    intro hf₀_zero
    have hf₀_val0 : valL F L f₀ = 0 := by rw [hf₀_zero, hval0]
    omega
  have hx₀_conj : τ₁ x₀ = -1 - x₀ := by
    have htr := hτ₁_tr x₀
    rw [hx₀_tr, map_neg, map_one] at htr
    linear_combination -htr
  have hx₀_sq : x₀ ^ 2 + x₀ = IntermediateField.inclusion hLM₁' f₀ := by
    have hnorm := hτ₁_norm x₀
    rw [hx₀_norm, map_neg, hx₀_conj] at hnorm
    linear_combination hnorm
  rcases htr_surj_E' (-1 : L) with ⟨y, hy_tr, _, hy_ne_val⟩
  rcases hy_ne_val hneg1_ne with ⟨hy_ne, hy_val_raw⟩
  have hy_val : valL F E' y = 1 - 2 * (r : ℤ) := by omega
  let g : L := - normLM F hLE' y
  have hy_norm : normLM F hLE' y = -g := by
    dsimp only [g]
    rw [neg_neg]
  have hg_val : valL F L g = 1 - 2 * (r : ℤ) := by
    dsimp only [g]
    rw [hval_neg, hval_normE' y, hy_val]
  have hg_ne : g ≠ 0 := by
    intro hg_zero
    have hg_val0 : valL F L g = 0 := by rw [hg_zero, hval0]
    omega
  have hy_conj : σ₂ y = -1 - y := by
    have htr := hσ₂_tr y
    rw [hy_tr, map_neg, map_one] at htr
    linear_combination -htr
  have hy_sq : y ^ 2 + y = IntermediateField.inclusion hLE' g := by
    have hnorm := hσ₂_norm y
    rw [hy_norm, map_neg, hy_conj] at hnorm
    linear_combination hnorm
  refine ⟨h2_val, x₀, y, f₀, g, hx₀_ne, hy_ne, hf₀_ne, hg_ne, hx₀_val, hf₀_val, hy_val, hg_val,
    hx₀_tr, hx₀_norm, hx₀_sq, hx₀_conj, hy_tr, hy_norm, hy_sq, hy_conj, ?_⟩
  intro w hw
  set x : M₁' := x₀ + IntermediateField.inclusion hLM₁' w * (1 + 2 * x₀)
  set f : L := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
  have hx_conj : τ₁ x = -1 - x := by
    have hτ₁_x : τ₁ x = τ₁ x₀ + τ₁ (IntermediateField.inclusion hLM₁' w) * (1 + 2 * τ₁ x₀) := by
      dsimp only [x]
      simp [map_add, map_mul, map_one, map_ofNat]
    rw [hτ₁_x, hτ₁_L w, hx₀_conj]
    dsimp only [x]
    ring
  have hx_tr : traceLM F hLM₁' x = -1 := by
    apply (IntermediateField.inclusion hLM₁').injective
    change IntermediateField.inclusion hLM₁' (traceLM F hLM₁' x) =
      IntermediateField.inclusion hLM₁' (-1)
    rw [hτ₁_tr x, hx_conj, map_neg, map_one]
    ring
  have hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f := by
    have hf_map : IntermediateField.inclusion hLM₁' f =
        IntermediateField.inclusion hLM₁' f₀ +
          (IntermediateField.inclusion hLM₁' w + (IntermediateField.inclusion hLM₁' w) ^ 2) *
            (1 + 4 * IntermediateField.inclusion hLM₁' f₀) := by
      dsimp only [f]
      simp [map_add, map_mul, map_pow, map_one, map_ofNat]
    rw [hf_map]
    dsimp only [x]
    linear_combination (1 + 2 * IntermediateField.inclusion hLM₁' w) ^ 2 * hx₀_sq
  have hx_norm : normLM F hLM₁' x = -f := by
    apply (IntermediateField.inclusion hLM₁').injective
    change IntermediateField.inclusion hLM₁' (normLM F hLM₁' x) =
      IntermediateField.inclusion hLM₁' (-f)
    rw [hτ₁_norm x, hx_conj, map_neg, ← hx_sq]
    ring
  have hw_dom : w = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F L w := by
    rcases hw with rfl | hw_ge
    · exact Or.inl rfl
    · right; omega
  have hw_sq_dom : w ^ 2 = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F L (w ^ 2) := by
    rcases hw with rfl | hw_ge
    · left; ring
    · by_cases hw_zero : w = 0
      · left; rw [hw_zero]; ring
      · right
        have hsq : w ^ 2 = w * w := sq w
        have hval_w2 : valL F L (w ^ 2) = valL F L w + valL F L w := by
          rw [hsq]
          exact hval_mul w w hw_zero hw_zero
        omega
  have hww2_dom : w + w ^ 2 = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F L (w + w ^ 2) :=
    hval_add (2 - 2 * (a : ℤ)) w (w ^ 2) hw_dom hw_sq_dom
  have h4f₀_dom : (4 : L) * f₀ = 0 ∨ 0 ≤ valL F L ((4 : L) * f₀) := by
    have h4_eq : (4 : L) * f₀ = (2 : L) * ((2 : L) * f₀) := by ring
    rcases h2_val with h2_zero | h2_ge
    · left
      rw [h4_eq, h2_zero, zero_mul]
    · by_cases h2_zero : (2 : L) = 0
      · left
        rw [h4_eq, h2_zero, zero_mul]
      · right
        have h2f₀_ne : (2 : L) * f₀ ≠ 0 := mul_ne_zero h2_zero hf₀_ne
        have h2f₀_val : valL F L ((2 : L) * f₀) = valL F L (2 : L) + valL F L f₀ :=
          hval_mul (2 : L) f₀ h2_zero hf₀_ne
        have h4f₀_val : valL F L ((4 : L) * f₀) = valL F L (2 : L) + valL F L ((2 : L) * f₀) := by
          rw [h4_eq]
          exact hval_mul (2 : L) ((2 : L) * f₀) h2_zero h2f₀_ne
        omega
  have h1_dom : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := by
    right; omega
  have h14f₀_dom : 1 + (4 : L) * f₀ = 0 ∨ 0 ≤ valL F L (1 + (4 : L) * f₀) :=
    hval_add 0 1 ((4 : L) * f₀) h1_dom h4f₀_dom
  let δ_f : L := (w + w ^ 2) * (1 + 4 * f₀)
  have hδ_dom : δ_f = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F L δ_f := by
    rcases hww2_dom with hww2_zero | hww2_ge
    · left
      dsimp only [δ_f]
      rw [hww2_zero, zero_mul]
    · rcases h14f₀_dom with h14_zero | h14_ge
      · left
        dsimp only [δ_f]
        rw [h14_zero, mul_zero]
      · by_cases hww2_zero : w + w ^ 2 = 0
        · left
          dsimp only [δ_f]
          rw [hww2_zero, zero_mul]
        · by_cases h14_zero : 1 + (4 : L) * f₀ = 0
          · left
            dsimp only [δ_f]
            rw [h14_zero, mul_zero]
          · right
            have hδ_val : valL F L δ_f = valL F L (w + w ^ 2) + valL F L (1 + 4 * f₀) :=
              hval_mul (w + w ^ 2) (1 + 4 * f₀) hww2_zero h14_zero
            omega
  have hf_eq : f = f₀ + δ_f := rfl
  have hf₀_dom : f₀ = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F L f₀ := by
    right; omega
  have hδ_dom_weak : δ_f = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F L δ_f := by
    rcases hδ_dom with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hf_dom : f = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F L f :=
    hval_add (1 - 2 * (a : ℤ)) f₀ δ_f hf₀_dom hδ_dom_weak
  have hf_ne : f ≠ 0 := by
    intro hf_zero
    have hδ_eq_neg_f₀ : δ_f = -f₀ := by linear_combination hf_zero - hf_eq
    have hδ_ne : δ_f ≠ 0 := by
      rw [hδ_eq_neg_f₀]
      exact neg_ne_zero.mpr hf₀_ne
    have hδ_val : valL F L δ_f = 1 - 2 * (a : ℤ) := by
      rw [hδ_eq_neg_f₀, hval_neg, hf₀_val]
    rcases hδ_dom with h0 | hge
    · exact hδ_ne h0
    · omega
  have hf_ge : 1 - 2 * (a : ℤ) ≤ valL F L f := by
    rcases hf_dom with h0 | hge
    · exact False.elim (hf_ne h0)
    · exact hge
  have hf_val : valL F L f = 1 - 2 * (a : ℤ) := by
    by_contra hne
    have hf_ge2 : f = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F L f := by
      right; omega
    have hneg_δ_dom : -δ_f = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F L (-δ_f) := by
      rcases hδ_dom with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg]; exact hge
    have hf₀_from_f : f + (-δ_f) = f₀ := by linear_combination hf_eq
    have hf₀_dom2 := hval_add (2 - 2 * (a : ℤ)) f (-δ_f) hf_ge2 hneg_δ_dom
    rw [hf₀_from_f] at hf₀_dom2
    rcases hf₀_dom2 with h0 | hge
    · exact hf₀_ne h0
    · omega
  have hx_val : valL F M₁' x = 1 - 2 * (a : ℤ) := by
    rw [← hval_normM₁' x, hx_norm, hval_neg, hf_val]
  have hx_ne : x ≠ 0 := by
    intro hx_zero
    have htr0 : traceLM F hLM₁' x = 0 := by rw [hx_zero, map_zero]
    rw [hx_tr] at htr0
    exact hneg1_ne htr0
  exact ⟨hx_ne, hf_ne, hx_val, hf_val, hx_tr, hx_norm, hx_sq, hx_conj⟩

theorem ld_ch12_wild_dyadic_even_breaks_frob_alignment_inductive (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (a r : ℕ) (ha_ge1 : 1 ≤ a) (hr_ge_a : a ≤ r)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧ (x - s ^ 2 = 0 ∨ 1 ≤ valL F L (x - s ^ 2)))
    (h2_val : (2 : L) = 0 ∨ (r : ℤ) ≤ valL F L (2 : L))
    (f₀ g : L) (hf₀_ne : f₀ ≠ 0) (hg_ne : g ≠ 0)
    (hf₀_val : valL F L f₀ = (1 - 2 * (a : ℤ)))
    (hg_val : valL F L g = (1 - 2 * (r : ℤ))) :
    ∃ (w d : L),
      let f := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
      let E := f + d ^ 2 * g
      (w = 0 ∨ (1 - (a : ℤ)) ≤ valL F L w) ∧
      d ≠ 0 ∧
      valL F L d = ((r : ℤ) - (a : ℤ)) ∧
      (E = 0 ∨ (1 - (a : ℤ)) ≤ valL F L E) :=
by
  have hL_mono : ∀ {m₁ m₂ : ℤ} {z : L},
      m₁ ≤ m₂ → (z = 0 ∨ m₂ ≤ valL F L z) → (z = 0 ∨ m₁ ≤ valL F L z) := by
    intro m₁ m₂ z hm hz
    rcases hz with rfl | hz
    · left; rfl
    · right; omega
  have hL_neg : ∀ {m : ℤ} {z : L},
      (z = 0 ∨ m ≤ valL F L z) → (-z = 0 ∨ m ≤ valL F L (-z)) := by
    intro m z hz
    rcases hz with rfl | hz
    · left; simp
    · right; rw [hvalL_props.2.2.2.1]; exact hz
  have hL_add : ∀ {m : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m ≤ valL F L z₁) → (z₂ = 0 ∨ m ≤ valL F L z₂) →
      (z₁ + z₂ = 0 ∨ m ≤ valL F L (z₁ + z₂)) :=
    fun hz₁ hz₂ => hvalL_props.2.2.2.2.2.2.2.1 _ _ _ hz₁ hz₂
  have hL_sub : ∀ {m : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m ≤ valL F L z₁) → (z₂ = 0 ∨ m ≤ valL F L z₂) →
      (z₁ - z₂ = 0 ∨ m ≤ valL F L (z₁ - z₂)) := by
    intro m z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    exact hL_add hz₁ (hL_neg hz₂)
  have hL_mul : ∀ {m₁ m₂ : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m₁ ≤ valL F L z₁) → (z₂ = 0 ∨ m₂ ≤ valL F L z₂) →
      (z₁ * z₂ = 0 ∨ m₁ + m₂ ≤ valL F L (z₁ * z₂)) := by
    intro m₁ m₂ z₁ z₂ hz₁ hz₂
    by_cases h1 : z₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : z₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rcases hz₁ with rfl | hz₁
        · exact False.elim (h1 rfl)
        · rcases hz₂ with rfl | hz₂
          · exact False.elim (h2 rfl)
          · rw [hvalL_props.2.2.2.2.1 z₁ z₂ h1 h2]
            omega
  have hL_sq : ∀ {m : ℤ} {z : L},
      (z = 0 ∨ m ≤ valL F L z) → (z ^ 2 = 0 ∨ 2 * m ≤ valL F L (z ^ 2)) := by
    intro m z hz
    rw [sq]
    exact hL_mono (by omega) (hL_mul hz hz)
  have hL_dom : ∀ {x y : L},
      x ≠ 0 → (y = 0 ∨ valL F L x + 1 ≤ valL F L y) →
      x + y ≠ 0 ∧ valL F L (x + y) = valL F L x := by
    intro x y hx hy
    have hge : x + y = 0 ∨ valL F L x ≤ valL F L (x + y) :=
      hL_add (Or.inr le_rfl) (hL_mono (by omega) hy)
    have hnot : ¬ (x + y = 0 ∨ valL F L x + 1 ≤ valL F L (x + y)) := by
      intro hxy
      have hx_eq : x = (x + y) - y := by ring
      have hx_ge : (x + y) - y = 0 ∨ valL F L x + 1 ≤ valL F L ((x + y) - y) :=
        hL_sub hxy hy
      rw [← hx_eq] at hx_ge
      rcases hx_ge with h0 | hle
      · exact hx h0
      · omega
    rcases hge with h0 | hle
    · exact False.elim (hnot (Or.inl h0))
    · refine ⟨fun h0 => hnot (Or.inl h0), ?_⟩
      by_contra hne
      apply hnot
      right
      omega
  have h4_ge : (4 : L) = 0 ∨ 2 * (r : ℤ) ≤ valL F L (4 : L) := by
    have h4_eq : (4 : L) = (2 : L) ^ 2 := by norm_num
    rw [h4_eq]
    exact hL_sq h2_val
  have hf₀_ge : f₀ = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F L f₀ :=
    Or.inr (by rw [hf₀_val])
  have h4f₀_ge : 4 * f₀ = 0 ∨ valL F L 1 + 1 ≤ valL F L (4 * f₀) :=
    hL_mono (by rw [hvalL_props.2.1]; omega) (hL_mul h4_ge hf₀_ge)
  obtain ⟨h14_ne, h14_val_raw⟩ := hL_dom (one_ne_zero : (1 : L) ≠ 0) h4f₀_ge
  have h14_val : valL F L (1 + 4 * f₀) = 0 := h14_val_raw.trans hvalL_props.2.1
  have hFrob_cancel : ∀ (X Y : L) (hY : Y ≠ 0) (m₀ : ℤ),
      (X = 0 ∨ 2 * m₀ + valL F L Y ≤ valL F L X) →
      ∃ δ : L,
        (δ = 0 ∨ m₀ ≤ valL F L δ) ∧
        (X + δ ^ 2 * Y = 0 ∨ 2 * m₀ + valL F L Y + 1 ≤ valL F L (X + δ ^ 2 * Y)) := by
    intro X Y hY m₀ hX
    obtain ⟨π₀, hπ₀⟩ := hvalL_props.2.2.2.2.2.2.1 m₀
    have hπ₀_inv_val : valL F L ((π₀⁻¹ : Lˣ) : L) = -m₀ := by
      rw [hvalL_props.2.2.2.2.2.1 π₀, hπ₀]
    let u_Y : Lˣ := Units.mk0 Y hY
    have hu_Y_inv_val : valL F L ((u_Y⁻¹ : Lˣ) : L) = -valL F L Y := by
      rw [hvalL_props.2.2.2.2.2.1 u_Y]
      rfl
    let u_X : L := -X * ((u_Y⁻¹ : Lˣ) : L) * ((π₀⁻¹ : Lˣ) : L) ^ 2
    have hu_Y_inv_ge : ((u_Y⁻¹ : Lˣ) : L) = 0 ∨ -valL F L Y ≤ valL F L ((u_Y⁻¹ : Lˣ) : L) :=
      Or.inr (by rw [hu_Y_inv_val])
    have hπ₀_inv_ge : ((π₀⁻¹ : Lˣ) : L) = 0 ∨ -m₀ ≤ valL F L ((π₀⁻¹ : Lˣ) : L) :=
      Or.inr (by rw [hπ₀_inv_val])
    have hu_X_ge : u_X = 0 ∨ 0 ≤ valL F L u_X :=
      hL_mono (by omega) (hL_mul (hL_mul (hL_neg hX) hu_Y_inv_ge) (hL_sq hπ₀_inv_ge))
    obtain ⟨s, hs_val, hs_sq⟩ := hfrob_surj u_X hu_X_ge
    let δ : L := (π₀ : L) * s
    have hπ₀_ge : (π₀ : L) = 0 ∨ m₀ ≤ valL F L (π₀ : L) :=
      Or.inr (by rw [hπ₀])
    have hδ_ge : δ = 0 ∨ m₀ ≤ valL F L δ :=
      hL_mono (by omega) (hL_mul hπ₀_ge hs_val)
    have hY_uY : Y * ((u_Y⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_Y
    have hπ₀_mul : (π₀ : L) * ((π₀⁻¹ : Lˣ) : L) = 1 := Units.mul_inv π₀
    have hX_id : X + δ ^ 2 * Y = -Y * (π₀ : L) ^ 2 * (u_X - s ^ 2) := by
      dsimp only [δ, u_X]
      calc X + ((π₀ : L) * s) ^ 2 * Y
        _ = X * (Y * ((u_Y⁻¹ : Lˣ) : L)) * ((π₀ : L) * ((π₀⁻¹ : Lˣ) : L)) ^ 2 +
            ((π₀ : L) * s) ^ 2 * Y := by
          rw [hY_uY, hπ₀_mul]
          ring
        _ = -Y * (π₀ : L) ^ 2 * (-X * ((u_Y⁻¹ : Lˣ) : L) * ((π₀⁻¹ : Lˣ) : L) ^ 2 - s ^ 2) := by
          ring
    refine ⟨δ, hδ_ge, ?_⟩
    rw [hX_id]
    have hY_ge : Y = 0 ∨ valL F L Y ≤ valL F L Y := Or.inr le_rfl
    exact hL_mono (by omega) (hL_mul (hL_mul (hL_neg hY_ge) (hL_sq hπ₀_ge)) hs_sq)
  let E_fn : L → L → L := fun w d => f₀ + (w + w ^ 2) * (1 + 4 * f₀) + d ^ 2 * g
  have h1_ge : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hvalL_props.2.1])
  have hg_ge : g = 0 ∨ 1 - 2 * (r : ℤ) ≤ valL F L g := Or.inr (by rw [hg_val])
  have h14_ge : 1 + 4 * f₀ = 0 ∨ 0 ≤ valL F L (1 + 4 * f₀) := Or.inr (by rw [h14_val])
  have h_ind : ∀ k : ℕ, k ≤ a →
      ∃ w d : L,
        (w = 0 ∨ 1 - (a : ℤ) ≤ valL F L w) ∧
        (d = 0 ∨ (r : ℤ) - (a : ℤ) ≤ valL F L d) ∧
        (E_fn w d = 0 ∨ 1 - 2 * (a : ℤ) + (k : ℤ) ≤ valL F L (E_fn w d)) := by
    intro k
    induction k with
    | zero =>
      intro _
      refine ⟨0, 0, Or.inl rfl, Or.inl rfl, ?_⟩
      have hE0 : E_fn 0 0 = f₀ := by dsimp only [E_fn]; ring
      rw [hE0]
      exact hL_mono (by omega) hf₀_ge
    | succ k ih =>
      intro hk1
      obtain ⟨w, d, hw, hd, hE⟩ := ih (by omega)
      by_cases hk_even : k % 2 = 0
      · let m_d : ℤ := (r : ℤ) - (a : ℤ) + ((k / 2 : ℕ) : ℤ)
        have hE_md : E_fn w d = 0 ∨ 2 * m_d + valL F L g ≤ valL F L (E_fn w d) :=
          hL_mono (by dsimp only [m_d]; rw [hg_val]; omega) hE
        obtain ⟨δ_d, hδ_d, hE_cancel⟩ := hFrob_cancel (E_fn w d) g hg_ne m_d hE_md
        refine ⟨w, d + δ_d, hw, hL_add hd (hL_mono (by dsimp only [m_d]; omega) hδ_d), ?_⟩
        have hE_expand : E_fn w (d + δ_d) = (E_fn w d + δ_d ^ 2 * g) + 2 * d * δ_d * g := by
          dsimp only [E_fn]; ring
        rw [hE_expand]
        have h1_part : E_fn w d + δ_d ^ 2 * g = 0 ∨
            1 - 2 * (a : ℤ) + ((k + 1 : ℕ) : ℤ) ≤ valL F L (E_fn w d + δ_d ^ 2 * g) :=
          hL_mono (by dsimp only [m_d]; rw [hg_val]; omega) hE_cancel
        have h2_part : 2 * d * δ_d * g = 0 ∨
            1 - 2 * (a : ℤ) + ((k + 1 : ℕ) : ℤ) ≤ valL F L (2 * d * δ_d * g) :=
          hL_mono (by dsimp only [m_d]; omega) (hL_mul (hL_mul (hL_mul h2_val hd) hδ_d) hg_ge)
        exact hL_add h1_part h2_part
      · let m_w : ℤ := 1 - (a : ℤ) + ((k / 2 : ℕ) : ℤ)
        have hE_mw : E_fn w d = 0 ∨ 2 * m_w + valL F L (1 + 4 * f₀) ≤ valL F L (E_fn w d) :=
          hL_mono (by dsimp only [m_w]; rw [h14_val]; omega) hE
        obtain ⟨δ_w, hδ_w, hE_cancel⟩ := hFrob_cancel (E_fn w d) (1 + 4 * f₀) h14_ne m_w hE_mw
        refine ⟨w + δ_w, d, hL_add hw (hL_mono (by dsimp only [m_w]; omega) hδ_w), hd, ?_⟩
        have hE_expand : E_fn (w + δ_w) d =
            (E_fn w d + δ_w ^ 2 * (1 + 4 * f₀)) + δ_w * (1 + 2 * w) * (1 + 4 * f₀) := by
          dsimp only [E_fn]; ring
        rw [hE_expand]
        have h1_part : E_fn w d + δ_w ^ 2 * (1 + 4 * f₀) = 0 ∨
            1 - 2 * (a : ℤ) + ((k + 1 : ℕ) : ℤ) ≤ valL F L (E_fn w d + δ_w ^ 2 * (1 + 4 * f₀)) :=
          hL_mono (by dsimp only [m_w]; rw [h14_val]; omega) hE_cancel
        have h12w_ge : 1 + 2 * w = 0 ∨ 0 ≤ valL F L (1 + 2 * w) :=
          hL_add h1_ge (hL_mono (by omega) (hL_mul h2_val hw))
        have h2_part : δ_w * (1 + 2 * w) * (1 + 4 * f₀) = 0 ∨
            1 - 2 * (a : ℤ) + ((k + 1 : ℕ) : ℤ) ≤ valL F L (δ_w * (1 + 2 * w) * (1 + 4 * f₀)) :=
          hL_mono (by dsimp only [m_w]; omega) (hL_mul (hL_mul hδ_w h12w_ge) h14_ge)
        exact hL_add h1_part h2_part
  obtain ⟨w, d, hw, _, hE_raw⟩ := h_ind a le_rfl
  have hE : E_fn w d = 0 ∨ 1 - (a : ℤ) ≤ valL F L (E_fn w d) :=
    hL_mono (by omega) hE_raw
  have hd2g_eq : d ^ 2 * g = -f₀ + (E_fn w d - (w + w ^ 2) * (1 + 4 * f₀)) := by
    dsimp only [E_fn]; ring
  have hww2_ge : w + w ^ 2 = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F L (w + w ^ 2) :=
    hL_add (hL_mono (by omega) hw) (hL_mono (by omega) (hL_sq hw))
  have hrem_ge : E_fn w d - (w + w ^ 2) * (1 + 4 * f₀) = 0 ∨
      valL F L (-f₀) + 1 ≤ valL F L (E_fn w d - (w + w ^ 2) * (1 + 4 * f₀)) := by
    rw [hvalL_props.2.2.2.1 f₀, hf₀_val]
    exact hL_sub (hL_mono (by omega) hE) (hL_mono (by omega) (hL_mul hww2_ge h14_ge))
  have hnf₀_ne : -f₀ ≠ 0 := neg_ne_zero.mpr hf₀_ne
  obtain ⟨hd2g_ne_raw, hd2g_val_raw⟩ := hL_dom hnf₀_ne hrem_ge
  rw [← hd2g_eq] at hd2g_ne_raw hd2g_val_raw
  rw [hvalL_props.2.2.2.1 f₀, hf₀_val] at hd2g_val_raw
  have hd_ne : d ≠ 0 := by
    intro hd0
    apply hd2g_ne_raw
    rw [hd0]
    ring
  have hd2_ne : d ^ 2 ≠ 0 := pow_ne_zero 2 hd_ne
  have hd2g_expand : valL F L (d ^ 2 * g) = 2 * valL F L d + (1 - 2 * (r : ℤ)) := by
    rw [hvalL_props.2.2.2.2.1 (d ^ 2) g hd2_ne hg_ne, sq d,
      hvalL_props.2.2.2.2.1 d d hd_ne hd_ne, hg_val]
    ring
  have hd_val : valL F L d = (r : ℤ) - (a : ℤ) := by omega
  exact ⟨w, d, hw, hd_ne, hd_val, hE⟩

theorem ld_ch12_wild_dyadic_even_breaks_equal_cond_as_norm_vanishing (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hT2_even : condExp F L νE' % 2 = 0)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (hσ₂_L : ∀ x : L, σ₂ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ₂_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ₂ y)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁') (y : E') (f g d : L)
    (hg_ne : g ≠ 0)
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hg_val : valL F L g = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hy_sq : y ^ 2 + y = IntermediateField.inclusion hLE' g)
    (hy_conj : σ₂ y = -1 - y)
    (hE_val : f + d ^ 2 * g = 0 ∨ (1 - ((condExp F L νE' / 2 : ℕ) : ℤ)) ≤ valL F L (f + d ^ 2 * g))
    (hk0_bad : 1 + d = 0 ∨ (1 : ℤ) ≤ valL F L (1 + d)) :
    let r := condExp F L νE' / 2
    f ≠ 0 ∧
    (∀ u ∈ unitGroup F L (2 * r), νE' u = 1 ∧ νM₁' u = 1 ∧ (νM₁' * νE') u = 1) ∧
    (∀ u : Lˣ, νE' u ^ 2 = 1 ∧ νM₁' u ^ 2 = 1) ∧
    (∀ s : L, (s = 0 ∨ 0 ≤ valL F L s) →
      ∀ hs : 1 - (s + s ^ 2) * f⁻¹ ≠ 0,
        νM₁' (Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs) = 1 ∧
        νE' (Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs) = 1) :=
by
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_a, hunit_val0⟩ := hvalL_props
  intro r
  have hr_def : r = condExp F L νE' / 2 := rfl
  have hr_ge1 : 1 ≤ r := by omega
  have hcond_E' : condExp F L νE' = 2 * r := by omega
  change valL F L f = 1 - 2 * (r : ℤ) at hf_val
  change valL F L g = 1 - 2 * (r : ℤ) at hg_val
  change (2 : L) = 0 ∨ (r : ℤ) ≤ valL F L (2 : L) at h2_val
  change f + d ^ 2 * g = 0 ∨ 1 - (r : ℤ) ≤ valL F L (f + d ^ 2 * g) at hE_val
  have hf_ne : f ≠ 0 := by
    intro hf0
    rw [hf0, hval0] at hf_val
    omega
  have h1_lt : 1 < Module.finrank L (IntermediateField.extendScalars hLE') := by omega
  have hpow1_E : νE' ^ (1 : ℕ) = νE' := pow_one νE'
  have hpow1_M : νM₁' ^ (1 : ℕ) = νM₁' := pow_one νM₁'
  have htriv_2r : ∀ u ∈ unitGroup F L (2 * r), νE' u = 1 ∧ νM₁' u = 1 ∧ (νM₁' * νE') u = 1 := by
    intro u hu
    have hνE'_u : νE' u = 1 := by
      have h := hνE'_cond 1 h1_lt u
      rw [hpow1_E, hcond_E'] at h
      exact h hu
    have hcond_prod : condExp F L (νM₁' * νE') = 2 * r := by
      have h := (hMinM₁' 1 h1_lt).2
      rw [hpow1_M, hcond_E'] at h
      exact h
    have hprod_u : (νM₁' * νE') u = 1 := by
      have h := hνM₁'E'_cond 1 h1_lt u
      rw [hpow1_M, hcond_prod] at h
      exact h hu
    have hνM₁'_u : νM₁' u = 1 := by
      have hmul : (νM₁' * νE') u = νM₁' u * νE' u := rfl
      rw [hmul, hνE'_u, mul_one] at hprod_u
      exact hprod_u
    exact ⟨hνE'_u, hνM₁'_u, hprod_u⟩
  have hexp2 : ∀ u : Lˣ, νE' u ^ 2 = 1 ∧ νM₁' u ^ 2 = 1 := by
    intro u
    refine ⟨?_, ?_⟩
    · rw [← map_pow]
      apply (hνE'_ker (u ^ 2)).mp
      refine ⟨Units.map (IntermediateField.inclusion hLE').toMonoidHom u, ?_⟩
      apply Units.ext
      apply (IntermediateField.inclusion hLE').injective
      have h1 := hσ₂_norm (IntermediateField.inclusion hLE' (u : L))
      have h2 := hσ₂_L (u : L)
      rw [h2] at h1
      change IntermediateField.inclusion hLE' (normLM F hLE' (IntermediateField.inclusion hLE' (u : L))) =
        IntermediateField.inclusion hLE' (((u ^ 2 : Lˣ) : L))
      rw [h1, Units.val_pow_eq_pow_val, sq, map_mul]
    · rw [← map_pow]
      apply (hνM₁'_ker (u ^ 2)).mp
      refine ⟨Units.map (IntermediateField.inclusion hLM₁').toMonoidHom u, ?_⟩
      apply Units.ext
      apply (IntermediateField.inclusion hLM₁').injective
      have h1 := hτ₁_norm (IntermediateField.inclusion hLM₁' (u : L))
      have h2 := hτ₁_L (u : L)
      rw [h2] at h1
      change IntermediateField.inclusion hLM₁' (normLM F hLM₁' (IntermediateField.inclusion hLM₁' (u : L))) =
        IntermediateField.inclusion hLM₁' (((u ^ 2 : Lˣ) : L))
      rw [h1, Units.val_pow_eq_pow_val, sq, map_mul]
  have hval_bound_mul : ∀ (k₁ k₂ : ℤ) (a b : L),
      (a = 0 ∨ k₁ ≤ valL F L a) → (b = 0 ∨ k₂ ≤ valL F L b) →
      (a * b = 0 ∨ k₁ + k₂ ≤ valL F L (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · left; rw [ha0, zero_mul]
    · by_cases hb0 : b = 0
      · left; rw [hb0, mul_zero]
      · right
        rcases ha with rfl | ha
        · contradiction
        · rcases hb with rfl | hb
          · contradiction
          · rw [hval_mul a b ha0 hb0]
            omega
  have hval_inv_eq : ∀ (a : L) (ha : a ≠ 0), valL F L a⁻¹ = - valL F L a := by
    intro a ha
    have h := hval_inv (Units.mk0 a ha)
    simp only [Units.val_inv_eq_inv_val, Units.val_mk0] at h
    exact h
  have hval_dom1 : ∀ (a : L), (a = 0 ∨ 1 ≤ valL F L a) →
      1 + a ≠ 0 ∧ valL F L (1 + a) = 0 := by
    intro a ha
    have hne : 1 + a ≠ 0 := by
      intro h0
      have ha_eq : a = -1 := by linear_combination h0
      rw [ha_eq] at ha
      rcases ha with hneg1_0 | hval_ge1
      · have h10 : (1 : L) = 0 := by linear_combination -hneg1_0
        exact one_ne_zero h10
      · rw [hval_neg1] at hval_ge1
        omega
    refine ⟨hne, ?_⟩
    have hge0 : 1 + a = 0 ∨ 0 ≤ valL F L (1 + a) := by
      apply hval_add 0 1 a
      · right; omega
      · rcases ha with rfl | ha
        · left; rfl
        · right; omega
    rcases hge0 with h0 | hge0
    · contradiction
    · by_contra hne0
      have hge1 : 1 ≤ valL F L (1 + a) := by omega
      have hna : -a = 0 ∨ 1 ≤ valL F L (-a) := by
        rcases ha with rfl | ha
        · left; simp
        · right; rw [hval_neg]; exact ha
      have hsum := hval_add 1 (1 + a) (-a) (Or.inr hge1) hna
      have heq1 : (1 + a) + (-a) = (1 : L) := by ring
      rw [heq1] at hsum
      rcases hsum with h10 | hval1_ge1
      · exact one_ne_zero h10
      · omega
  set k₀ : L := 1 + d
  set E : L := f + d ^ 2 * g
  have hk₀_sq : k₀ ^ 2 = 0 ∨ 2 ≤ valL F L (k₀ ^ 2) := by
    have h := hval_bound_mul 1 1 k₀ k₀ hk0_bad hk0_bad
    rwa [← sq] at h
  have h2k₀ : -(2 * k₀) = 0 ∨ 2 ≤ valL F L (-(2 * k₀)) := by
    have h := hval_bound_mul (r : ℤ) 1 (2 : L) k₀ h2_val hk0_bad
    rcases h with h0 | hge
    · left; rw [h0, neg_zero]
    · right; rw [hval_neg]; omega
  have hk₀_quad : k₀ ^ 2 - 2 * k₀ = 0 ∨ 2 ≤ valL F L (k₀ ^ 2 - 2 * k₀) := by
    have h := hval_add 2 (k₀ ^ 2) (-(2 * k₀)) hk₀_sq h2k₀
    rwa [← sub_eq_add_neg] at h
  have hterm1 : (k₀ ^ 2 - 2 * k₀) * g = 0 ∨ 2 - 2 * (r : ℤ) ≤ valL F L ((k₀ ^ 2 - 2 * k₀) * g) := by
    have h := hval_bound_mul 2 (1 - 2 * (r : ℤ)) (k₀ ^ 2 - 2 * k₀) g hk₀_quad (Or.inr (by omega))
    rcases h with h0 | hge
    · left; exact h0
    · right; omega
  have hterm2 : 2 * g = 0 ∨ 2 - 2 * (r : ℤ) ≤ valL F L (2 * g) := by
    have h := hval_bound_mul (r : ℤ) (1 - 2 * (r : ℤ)) (2 : L) g h2_val (Or.inr (by omega))
    rcases h with h0 | hge
    · left; exact h0
    · right; omega
  have htermE : -E = 0 ∨ 2 - 2 * (r : ℤ) ≤ valL F L (-E) := by
    rcases hE_val with h0 | hge
    · left; change -E = 0; rw [h0, neg_zero]
    · right; rw [hval_neg]; change 1 - (r : ℤ) ≤ valL F L E at hge; omega
  have hgf_val : g - f = 0 ∨ 2 - 2 * (r : ℤ) ≤ valL F L (g - f) := by
    have h12 := hval_add (2 - 2 * (r : ℤ)) ((k₀ ^ 2 - 2 * k₀) * g) (2 * g) hterm1 hterm2
    have hsum := hval_add (2 - 2 * (r : ℤ)) (-E) ((k₀ ^ 2 - 2 * k₀) * g + 2 * g) htermE h12
    have hid : -E + ((k₀ ^ 2 - 2 * k₀) * g + 2 * g) = g - f := by
      dsimp [E, k₀]
      ring
    rwa [hid] at hsum
  have hfinv_val : valL F L f⁻¹ = 2 * (r : ℤ) - 1 := by
    rw [hval_inv_eq f hf_ne]
    omega
  have hginv_val : valL F L g⁻¹ = 2 * (r : ℤ) - 1 := by
    rw [hval_inv_eq g hg_ne]
    omega
  have hinv_diff : f⁻¹ - g⁻¹ = 0 ∨ (2 * r : ℤ) ≤ valL F L (f⁻¹ - g⁻¹) := by
    have h1 := hval_bound_mul (2 - 2 * (r : ℤ)) (2 * (r : ℤ) - 1) (g - f) f⁻¹ hgf_val (Or.inr (by omega))
    have h2 := hval_bound_mul ((2 - 2 * (r : ℤ)) + (2 * (r : ℤ) - 1)) (2 * (r : ℤ) - 1)
      ((g - f) * f⁻¹) g⁻¹ h1 (Or.inr (by omega))
    have hid : (g - f) * f⁻¹ * g⁻¹ = f⁻¹ - g⁻¹ := by
      field_simp [hf_ne, hg_ne]
    rw [hid] at h2
    rcases h2 with h0 | hge
    · left; exact h0
    · right; omega
  refine ⟨hf_ne, htriv_2r, hexp2, ?_⟩
  intro s hs_val hs
  have hνM₁'_f : νM₁' (Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs) = 1 := by
    let z_s : M₁' := 1 + IntermediateField.inclusion hLM₁' (s * f⁻¹) * x
    have hnorm_zs : normLM F hLM₁' z_s = 1 - (s + s ^ 2) * f⁻¹ := by
      apply (IntermediateField.inclusion hLM₁').injective
      have h1 := hτ₁_norm z_s
      have hτ_zs : τ₁ z_s = 1 + IntermediateField.inclusion hLM₁' (s * f⁻¹) * (-1 - x) := by
        dsimp [z_s]
        rw [map_add, map_one, map_mul, hτ₁_L (s * f⁻¹), hx_conj]
      rw [hτ_zs] at h1
      have hring : z_s * (1 + IntermediateField.inclusion hLM₁' (s * f⁻¹) * (-1 - x)) =
          1 - IntermediateField.inclusion hLM₁' (s * f⁻¹) -
            (IntermediateField.inclusion hLM₁' (s * f⁻¹)) ^ 2 * (x ^ 2 + x) := by
        dsimp [z_s]
        ring
      rw [hring, hx_sq] at h1
      have hmap : (1 : M₁') - IntermediateField.inclusion hLM₁' (s * f⁻¹) -
          (IntermediateField.inclusion hLM₁' (s * f⁻¹)) ^ 2 * IntermediateField.inclusion hLM₁' f =
          IntermediateField.inclusion hLM₁' (1 - s * f⁻¹ - (s * f⁻¹) ^ 2 * f) := by
        simp
      rw [hmap] at h1
      have hL_id : 1 - s * f⁻¹ - (s * f⁻¹) ^ 2 * f = 1 - (s + s ^ 2) * f⁻¹ := by
        field_simp [hf_ne]
        ring
      rw [hL_id] at h1
      exact h1
    have hzs_ne : z_s ≠ 0 := by
      intro hz0
      have h0 := hτ₁_norm z_s
      rw [hnorm_zs, hz0, zero_mul] at h0
      exact hs ((map_eq_zero (IntermediateField.inclusion hLM₁')).mp h0)
    apply (hνM₁'_ker _).mp
    refine ⟨Units.mk0 z_s hzs_ne, ?_⟩
    apply Units.ext
    exact hnorm_zs
  have hs_sq : s ^ 2 = 0 ∨ 0 ≤ valL F L (s ^ 2) := by
    have h := hval_bound_mul 0 0 s s hs_val hs_val
    rwa [← sq] at h
  have hssq : s + s ^ 2 = 0 ∨ 0 ≤ valL F L (s + s ^ 2) :=
    hval_add 0 s (s ^ 2) hs_val hs_sq
  have hsg_term : -((s + s ^ 2) * g⁻¹) = 0 ∨ 1 ≤ valL F L (-((s + s ^ 2) * g⁻¹)) := by
    have h := hval_bound_mul 0 (2 * (r : ℤ) - 1) (s + s ^ 2) g⁻¹ hssq (Or.inr (by omega))
    rcases h with h0 | hge
    · left; rw [h0, neg_zero]
    · right; rw [hval_neg]; omega
  have hsg_dom : 1 - (s + s ^ 2) * g⁻¹ ≠ 0 ∧ valL F L (1 - (s + s ^ 2) * g⁻¹) = 0 := by
    have h := hval_dom1 (-((s + s ^ 2) * g⁻¹)) hsg_term
    rwa [← sub_eq_add_neg] at h
  have hsg : 1 - (s + s ^ 2) * g⁻¹ ≠ 0 := hsg_dom.1
  have hsg_val0 : valL F L (1 - (s + s ^ 2) * g⁻¹) = 0 := hsg_dom.2
  have hνE'_g : νE' (Units.mk0 (1 - (s + s ^ 2) * g⁻¹) hsg) = 1 := by
    let y_s : E' := 1 + IntermediateField.inclusion hLE' (s * g⁻¹) * y
    have hnorm_ys : normLM F hLE' y_s = 1 - (s + s ^ 2) * g⁻¹ := by
      apply (IntermediateField.inclusion hLE').injective
      have h1 := hσ₂_norm y_s
      have hσ_ys : σ₂ y_s = 1 + IntermediateField.inclusion hLE' (s * g⁻¹) * (-1 - y) := by
        dsimp [y_s]
        rw [map_add, map_one, map_mul, hσ₂_L (s * g⁻¹), hy_conj]
      rw [hσ_ys] at h1
      have hring : y_s * (1 + IntermediateField.inclusion hLE' (s * g⁻¹) * (-1 - y)) =
          1 - IntermediateField.inclusion hLE' (s * g⁻¹) -
            (IntermediateField.inclusion hLE' (s * g⁻¹)) ^ 2 * (y ^ 2 + y) := by
        dsimp [y_s]
        ring
      rw [hring, hy_sq] at h1
      have hmap : (1 : E') - IntermediateField.inclusion hLE' (s * g⁻¹) -
          (IntermediateField.inclusion hLE' (s * g⁻¹)) ^ 2 * IntermediateField.inclusion hLE' g =
          IntermediateField.inclusion hLE' (1 - s * g⁻¹ - (s * g⁻¹) ^ 2 * g) := by
        simp
      rw [hmap] at h1
      have hL_id : 1 - s * g⁻¹ - (s * g⁻¹) ^ 2 * g = 1 - (s + s ^ 2) * g⁻¹ := by
        field_simp [hg_ne]
        ring
      rw [hL_id] at h1
      exact h1
    have hys_ne : y_s ≠ 0 := by
      intro hy0
      have h0 := hσ₂_norm y_s
      rw [hnorm_ys, hy0, zero_mul] at h0
      exact hsg ((map_eq_zero (IntermediateField.inclusion hLE')).mp h0)
    apply (hνE'_ker _).mp
    refine ⟨Units.mk0 y_s hys_ne, ?_⟩
    apply Units.ext
    exact hnorm_ys
  let u_f : Lˣ := Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs
  let u_g : Lˣ := Units.mk0 (1 - (s + s ^ 2) * g⁻¹) hsg
  have hquo_mem : u_f * u_g⁻¹ ∈ unitGroup F L (2 * r) := by
    rw [hunit_a (2 * r) (by omega) (u_f * u_g⁻¹)]
    have hsub_id : ((u_f * u_g⁻¹ : Lˣ) : L) - 1 =
        -(s + s ^ 2) * (f⁻¹ - g⁻¹) * (1 - (s + s ^ 2) * g⁻¹)⁻¹ := by
      calc ((u_f * u_g⁻¹ : Lˣ) : L) - 1
        _ = (1 - (s + s ^ 2) * f⁻¹) * (1 - (s + s ^ 2) * g⁻¹)⁻¹ -
              (1 - (s + s ^ 2) * g⁻¹) * (1 - (s + s ^ 2) * g⁻¹)⁻¹ := by
            rw [mul_inv_cancel₀ hsg]
            rfl
        _ = -(s + s ^ 2) * (f⁻¹ - g⁻¹) * (1 - (s + s ^ 2) * g⁻¹)⁻¹ := by
            ring
    have hneg_ssq : -(s + s ^ 2) = 0 ∨ 0 ≤ valL F L (-(s + s ^ 2)) := by
      rcases hssq with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg]; exact hge
    have hug_inv_val : valL F L (1 - (s + s ^ 2) * g⁻¹)⁻¹ = 0 := by
      rw [hval_inv_eq (1 - (s + s ^ 2) * g⁻¹) hsg, hsg_val0, neg_zero]
    have hm1 := hval_bound_mul 0 (2 * r : ℤ) (-(s + s ^ 2)) (f⁻¹ - g⁻¹) hneg_ssq hinv_diff
    have hm2 := hval_bound_mul (0 + (2 * r : ℤ)) 0 (-(s + s ^ 2) * (f⁻¹ - g⁻¹))
      (1 - (s + s ^ 2) * g⁻¹)⁻¹ hm1 (Or.inr (by omega))
    rw [← hsub_id] at hm2
    rcases hm2 with h0 | hge
    · left; exact sub_eq_zero.mp h0
    · right; omega
  have hνE'_quo : νE' (u_f * u_g⁻¹) = 1 := (htriv_2r (u_f * u_g⁻¹) hquo_mem).1
  have hνE'_f : νE' u_f = 1 := by
    have heq : u_f = (u_f * u_g⁻¹) * u_g := by group
    rw [heq, map_mul, hνE'_quo, hνE'_g, mul_one]
  exact ⟨hνM₁'_f, hνE'_f⟩

theorem ld_ch12_wild_dyadic_even_breaks_as_coker_unit_filter_contradiction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (r : ℕ) (hr_ge1 : 1 ≤ r)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hcond_M₁' : condExp F L νM₁' = 2 * r)
    (hcond_E' : condExp F L νE' = 2 * r)
    (hcond_prod : condExp F L (νM₁' * νE') = 2 * r)
    (htriv_2r : ∀ u ∈ unitGroup F L (2 * r), νE' u = 1 ∧ νM₁' u = 1 ∧ (νM₁' * νE') u = 1)
    (hsq_one : ∀ u : Lˣ, νE' u ^ 2 = 1 ∧ νM₁' u ^ 2 = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hAS_coker : ((2 : ℕ) : k_L) = 0 →
      ∃ a₁ : k_L, ∀ c : k_L, ∃ (e₀ : Fin 2) (a : k_L),
        c = ((e₀ : ℕ) : k_L) * a₁ + (a ^ 2 + (1 : k_L) * a))
    (h2_val : (2 : L) = 0 ∨ (r : ℤ) ≤ valL F L (2 : L))
    (f : L) (hf_ne : f ≠ 0) (hf_val : valL F L f = (1 - 2 * (r : ℤ)))
    (hAS_ker : ∀ s : L, (s = 0 ∨ 0 ≤ valL F L s) →
      ∀ hs : 1 - (s + s ^ 2) * f⁻¹ ≠ 0,
        νM₁' (Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs) = 1 ∧
        νE' (Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs) = 1) :
    False :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_sub_L : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    apply hval_add_L k x (-y) hx
    rcases hy with rfl | hy
    · left; simp
    · right; rw [hval_neg_L]; exact hy
  have hval_one_sub_L : ∀ x : L, (x = 0 ∨ (1 : ℤ) ≤ valL F L x) →
      1 - x ≠ 0 ∧ valL F L (1 - x) = 0 ∧
      ((1 - x)⁻¹ = 0 ∨ 0 ≤ valL F L (1 - x)⁻¹) := by
    intro x hx
    have h1_int : (1 : L) = 0 ∨ (0 : ℤ) ≤ valL F L 1 := Or.inr (by rw [hval1_L])
    have hx_int : x = 0 ∨ (0 : ℤ) ≤ valL F L x := by
      rcases hx with rfl | hx
      · left; rfl
      · right; omega
    have h1x_ne : 1 - x ≠ 0 := by
      intro h0
      have hx1 : x = 1 := (sub_eq_zero.mp h0).symm
      rcases hx with hx0 | hx_ge1
      · exact one_ne_zero (hx1.symm.trans hx0)
      · rw [hx1, hval1_L] at hx_ge1
        omega
    have h1x_ge0 : (0 : ℤ) ≤ valL F L (1 - x) :=
      (hval_sub_L 0 1 x h1_int hx_int).resolve_left h1x_ne
    have h1x_not_ge1 : ¬ ((1 : ℤ) ≤ valL F L (1 - x)) := by
      intro hge1
      have h1_sum : (1 - x) + x = (1 : L) := sub_add_cancel 1 x
      have h1_ge1 := hval_add_L 1 (1 - x) x (Or.inr hge1) hx
      rw [h1_sum, hval1_L] at h1_ge1
      rcases h1_ge1 with h10 | h1_le
      · exact one_ne_zero h10
      · omega
    have h1x_val : valL F L (1 - x) = 0 := by omega
    let u1x : Lˣ := Units.mk0 (1 - x) h1x_ne
    have h1x_inv_val : valL F L (1 - x)⁻¹ = 0 := by
      have hu : ((u1x⁻¹ : Lˣ) : L) = (1 - x)⁻¹ := rfl
      rw [← hu, hval_inv_L u1x]
      change - valL F L (1 - x) = 0
      rw [h1x_val, neg_zero]
    exact ⟨h1x_ne, h1x_val, Or.inr (by rw [h1x_inv_val])⟩
  let uf : Lˣ := Units.mk0 f hf_ne
  have hfinv_val : valL F L f⁻¹ = 2 * (r : ℤ) - 1 := by
    have hu : ((uf⁻¹ : Lˣ) : L) = f⁻¹ := rfl
    rw [← hu, hval_inv_L uf]
    change - valL F L f = 2 * (r : ℤ) - 1
    rw [hf_val]
    omega
  have hfinv_ge : f⁻¹ = 0 ∨ (2 * (r : ℤ) - 1) ≤ valL F L f⁻¹ := by
    right; rw [hfinv_val]
  have hresL_sub : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    have hneg₂ : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hx₂
      · left; simp
      · right; rw [hval_neg_L]; exact hx₂
    rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ hneg₂).1,
      (hresL_ring x₂ 0 hx₂ (Or.inl rfl)).2.2, ← sub_eq_add_neg]
  have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by rw [hval1_L])
  have h2_int : (2 : L) = 0 ∨ 0 ≤ valL F L (2 : L) := by
    rcases h2_val with h0 | hge
    · left; exact h0
    · right; omega
  have h2_ge1 : (2 : L) = 0 ∨ 1 ≤ valL F L (2 : L) := by
    rcases h2_val with h0 | hge
    · left; exact h0
    · right; omega
  have hres_2 : resL (2 : L) = 0 := (hresL_ker (2 : L) h2_int).mpr h2_ge1
  have hchar2 : ((2 : ℕ) : k_L) = 0 := by
    have h11 : ((1 : L) + 1) = (2 : L) := by norm_num
    have hres_11 : resL ((1 : L) + 1) = ((2 : ℕ) : k_L) := by
      rw [(hresL_ring 1 1 h1_int h1_int).1, hresL_1]
      norm_num
    rw [← hres_11, h11, hres_2]
  obtain ⟨a₁, hAS_decomp⟩ := hAS_coker hchar2
  obtain ⟨s₁, hs₁_int, hres_s₁⟩ := hresL_surj a₁
  have hs₁_finv_ge : s₁ * f⁻¹ = 0 ∨ (1 : ℤ) ≤ valL F L (s₁ * f⁻¹) := by
    rcases hval_mul_ge_L 0 (2 * (r : ℤ) - 1) s₁ f⁻¹ hs₁_int hfinv_ge with h0 | hge
    · left; exact h0
    · right; omega
  obtain ⟨hu₁_ne, hu₁_val, hu₁_inv_int⟩ := hval_one_sub_L (s₁ * f⁻¹) hs₁_finv_ge
  let u₁ : Lˣ := Units.mk0 (1 - s₁ * f⁻¹) hu₁_ne
  have hcoset_decomp : ∀ u ∈ unitGroup F L (2 * r - 1),
      ∃ (e₀ : Fin 2) (s : L),
        (s = 0 ∨ 0 ≤ valL F L s) ∧
        ∃ (hs_ne : 1 - (s + s ^ 2) * f⁻¹ ≠ 0),
          (e₀ = 0 →
            u * (Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs_ne)⁻¹ ∈ unitGroup F L (2 * r)) ∧
          (e₀ ≠ 0 →
            u * (u₁ * Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs_ne)⁻¹ ∈ unitGroup F L (2 * r)) := by
    intro u hu
    have hu_mem := (hunit_ge1_L (2 * r - 1) (by omega) u).mp hu
    have hu_sub_val : (u : L) - 1 = 0 ∨ (2 * (r : ℤ) - 1) ≤ valL F L ((u : L) - 1) := by
      rcases hu_mem with hu1 | hge
      · left; rw [hu1, sub_self]
      · right
        have hcast : ((2 * r - 1 : ℕ) : ℤ) = 2 * (r : ℤ) - 1 := by omega
        omega
    have h1u_val : 1 - (u : L) = 0 ∨ (2 * (r : ℤ) - 1) ≤ valL F L (1 - (u : L)) := by
      have hneg_eq : 1 - (u : L) = -((u : L) - 1) := by ring
      rcases hu_sub_val with h0 | hge
      · left; rw [hneg_eq, h0, neg_zero]
      · right; rw [hneg_eq, hval_neg_L]; exact hge
    let z : L := (1 - (u : L)) * f
    have hf_ge : f = 0 ∨ (1 - 2 * (r : ℤ)) ≤ valL F L f := Or.inr (by rw [hf_val])
    have hz_int : z = 0 ∨ 0 ≤ valL F L z := by
      dsimp [z]
      rcases hval_mul_ge_L (2 * (r : ℤ) - 1) (1 - 2 * (r : ℤ)) (1 - (u : L)) f h1u_val hf_ge with h0 | hge
      · left; exact h0
      · right; omega
    have hu_eq_z : (u : L) = 1 - z * f⁻¹ := by
      dsimp [z]
      rw [mul_assoc, mul_inv_cancel₀ hf_ne, mul_one, sub_sub_cancel]
    obtain ⟨e₀, a₀, hres_z⟩ := hAS_decomp (resL z)
    obtain ⟨s, hs_int, hres_s⟩ := hresL_surj a₀
    have hs2_int : s ^ 2 = 0 ∨ 0 ≤ valL F L (s ^ 2) := by
      rw [sq]
      rcases hval_mul_ge_L 0 0 s s hs_int hs_int with h0 | hge
      · left; exact h0
      · right; omega
    have hs_poly_int : s + s ^ 2 = 0 ∨ 0 ≤ valL F L (s + s ^ 2) :=
      hval_add_L 0 s (s ^ 2) hs_int hs2_int
    have hs_finv_ge : (s + s ^ 2) * f⁻¹ = 0 ∨ (1 : ℤ) ≤ valL F L ((s + s ^ 2) * f⁻¹) := by
      rcases hval_mul_ge_L 0 (2 * (r : ℤ) - 1) (s + s ^ 2) f⁻¹ hs_poly_int hfinv_ge with h0 | hge
      · left; exact h0
      · right; omega
    obtain ⟨hs_ne, hs_val0, hvs_inv_int⟩ := hval_one_sub_L ((s + s ^ 2) * f⁻¹) hs_finv_ge
    let v_s : Lˣ := Units.mk0 (1 - (s + s ^ 2) * f⁻¹) hs_ne
    have hres_s2 : resL (s ^ 2) = a₀ ^ 2 := by
      rw [sq, (hresL_ring s s hs_int hs_int).2.1, hres_s, sq]
    have hres_s_poly : resL (s + s ^ 2) = a₀ ^ 2 + (1 : k_L) * a₀ := by
      rw [(hresL_ring s (s ^ 2) hs_int hs2_int).1, hres_s, hres_s2]
      ring
    refine ⟨e₀, s, hs_int, hs_ne, ?_, ?_⟩
    · intro he₀
      have hres_z0 : resL z = resL (s + s ^ 2) := by
        rw [hres_z, he₀, Fin.val_zero, Nat.cast_zero, zero_mul, zero_add, hres_s_poly]
      have hres_diff : resL (z - (s + s ^ 2)) = 0 := by
        rw [hresL_sub z (s + s ^ 2) hz_int hs_poly_int, hres_z0, sub_self]
      have hz_diff_int : z - (s + s ^ 2) = 0 ∨ 0 ≤ valL F L (z - (s + s ^ 2)) :=
        hval_sub_L 0 z (s + s ^ 2) hz_int hs_poly_int
      have hz_diff_ge1 : z - (s + s ^ 2) = 0 ∨ 1 ≤ valL F L (z - (s + s ^ 2)) :=
        (hresL_ker (z - (s + s ^ 2)) hz_diff_int).mp hres_diff
      have hneg_diff_ge1 : -(z - (s + s ^ 2)) = 0 ∨ 1 ≤ valL F L (-(z - (s + s ^ 2))) := by
        rcases hz_diff_ge1 with h0 | hge
        · left; rw [h0, neg_zero]
        · right; rw [hval_neg_L]; exact hge
      have hlin_ge : -(z - (s + s ^ 2)) * f⁻¹ = 0 ∨
          (2 * (r : ℤ)) ≤ valL F L (-(z - (s + s ^ 2)) * f⁻¹) := by
        rcases hval_mul_ge_L 1 (2 * (r : ℤ) - 1) (-(z - (s + s ^ 2))) f⁻¹ hneg_diff_ge1 hfinv_ge with h0 | hge
        · left; exact h0
        · right; omega
      have hprod_ge : (-(z - (s + s ^ 2)) * f⁻¹) * (1 - (s + s ^ 2) * f⁻¹)⁻¹ = 0 ∨
          (2 * (r : ℤ)) ≤ valL F L ((-(z - (s + s ^ 2)) * f⁻¹) * (1 - (s + s ^ 2) * f⁻¹)⁻¹) := by
        rcases hval_mul_ge_L (2 * (r : ℤ)) 0 (-(z - (s + s ^ 2)) * f⁻¹) (1 - (s + s ^ 2) * f⁻¹)⁻¹ hlin_ge hvs_inv_int with h0 | hge
        · left; exact h0
        · right; omega
      have h_id1 : ((u * v_s⁻¹ : Lˣ) : L) - 1 =
          (-(z - (s + s ^ 2)) * f⁻¹) * (1 - (s + s ^ 2) * f⁻¹)⁻¹ := by
        have h1 : (v_s : L) * ((v_s⁻¹ : Lˣ) : L) = 1 := Units.mul_inv v_s
        have h2 : ((u * v_s⁻¹ : Lˣ) : L) - 1 = ((u : L) - (v_s : L)) * ((v_s⁻¹ : Lˣ) : L) := by
          rw [Units.val_mul, sub_mul, h1]
        rw [h2]
        change ((u : L) - (1 - (s + s ^ 2) * f⁻¹)) * (1 - (s + s ^ 2) * f⁻¹)⁻¹ = _
        rw [hu_eq_z]
        ring
      rw [hunit_ge1_L (2 * r) (by omega)]
      rcases hprod_ge with h0 | hge
      · left; exact sub_eq_zero.mp (h_id1.trans h0)
      · right
