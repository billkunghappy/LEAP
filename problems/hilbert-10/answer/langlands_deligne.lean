theorem ld_ch14_subfield_monomial_trace_to_H_sum_fixed (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal]
    (h_field_C : (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F = M_C)
    (projH : (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) →* H)
    (hprojH_id : ∀ h : H, projH h.1 = h)
    (hprojH_mul_C : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      (projH g).1⁻¹ * g ∈ C)
    (A B : IntermediateField F (AlgebraicClosure F))
    (hLA : L ≤ A) (hAB : A ≤ B) (hBMC : B ≤ M_C)
    (H_A : Subgroup H)
    (h_mem_A : ∀ w : relWeil F L,
      w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ projH (π w) ∈ H_A)
    (χ_B : relWeil F B →* (Ω F)ˣ)
    (hχ_B_restK : restrictWeilChar F (hBMC.trans hM_CK) χ_B = 1) :
    ∃ (H_B : Subgroup H)
      (M_B : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
      (ψ_B : M_B →* (Ω F)ˣ),
      (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).Wf F A ∧
      H_B ≤ H_A ∧
      (∀ h : H, h ∈ H_B ↔
        ∀ x : IntermediateField.extendScalars hLK,
          (x : AlgebraicClosure F) ∈ B → h.1 x = x) ∧
      (∀ x : IntermediateField.extendScalars hLK,
        (x : AlgebraicClosure F) ∈ B ↔ ∀ h ∈ H_B, ∀ c ∈ C, (h.1 * c) x = x) ∧
      (∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
        g ∈ M_B ↔ projH g ∈ H_B) ∧
      (∀ w : relWeil F L,
        w ∈ (relWeil F B).subgroupOf (relWeil F L) ↔ π w ∈ M_B) ∧
      (∀ (w_B : relWeil F B)
        (hm : π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) ∈ M_B),
        χ_B w_B = ψ_B ⟨π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B), hm⟩) ∧
      ∀ w : relWeil F A,
        (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).trace F A w =
          (Nat.card H_B : Ω F)⁻¹ *
            ∑ y : H_A,
              if hm : y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLA) w) * y.1.1⁻¹ ∈ M_B then
                (ψ_B ⟨y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLA) w) * y.1.1⁻¹, hm⟩ : Ω F)
              else 0 :=
by
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  letI : DivisionMonoid H := (Subgroup.toGroup H).toDivisionMonoid
  letI : InvolutiveInv H := (Subgroup.toGroup H).toDivisionMonoid.toInvolutiveInv
  letI : DivisionMonoid H_A := (Subgroup.toGroup H_A).toDivisionMonoid
  letI : InvolutiveInv H_A := (Subgroup.toGroup H_A).toDivisionMonoid.toInvolutiveInv
  letI : DivisionMonoid (relWeil F L) := (Subgroup.toGroup (relWeil F L)).toDivisionMonoid
  letI : InvolutiveInv (relWeil F L) := (Subgroup.toGroup (relWeil F L)).toDivisionMonoid.toInvolutiveInv
  letI : DivisionMonoid (relWeil F A) := (Subgroup.toGroup (relWeil F A)).toDivisionMonoid
  letI : InvolutiveInv (relWeil F A) := (Subgroup.toGroup (relWeil F A)).toDivisionMonoid.toInvolutiveInv
  letI : DivisionMonoid (relWeil F B) := (Subgroup.toGroup (relWeil F B)).toDivisionMonoid
  letI : InvolutiveInv (relWeil F B) := (Subgroup.toGroup (relWeil F B)).toDivisionMonoid.toInvolutiveInv
  have hLB : L ≤ B := hLA.trans hAB
  have hBK : B ≤ K := hBMC.trans hM_CK
  have hAK : A ≤ K := hAB.trans hBK
  
  haveI hFinB : FiniteDimensional F B :=
    Module.Finite.of_injective (IntermediateField.inclusion hBK).toLinearMap
      (IntermediateField.inclusion hBK).injective
  have hSepAB : Algebra.IsSeparable A (IntermediateField.extendScalars hAB) := by
    refine ⟨fun x => ?_⟩
    let B_A := IntermediateField.extendScalars hAB
    have hxB : (x : AlgebraicClosure F) ∈ B :=
      (IntermediateField.mem_extendScalars hAB).mp x.2
    let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hBK hxB)⟩
    have hsep_xK : (minpoly L x_K).Separable := Algebra.IsSeparable.isSeparable L x_K
    have hmin_KL : minpoly L (x : AlgebraicClosure F) = minpoly L x_K :=
      minpoly.algHom_eq K'.val K'.val.injective x_K
    have hmin_BA : minpoly A (x : AlgebraicClosure F) = minpoly A x :=
      minpoly.algHom_eq B_A.val B_A.val.injective x
    have h_dvd : minpoly A (x : AlgebraicClosure F) ∣
        (minpoly L (x : AlgebraicClosure F)).map (IntermediateField.inclusion hLA) := by
      apply minpoly.dvd A (x : AlgebraicClosure F)
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      exact minpoly.aeval L (x : AlgebraicClosure F)
    change (minpoly A x).Separable
    rw [← hmin_BA]
    exact Polynomial.Separable.of_dvd
      (Polynomial.Separable.map (hmin_KL.symm ▸ hsep_xK)) h_dvd
  have hWeilB : IsWeilRep F B (charRep F B χ_B) := by
    refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
    let U : Set (AbsGal F) := (K.fixingSubgroup : Set (AbsGal F))
    have hU_nhds : U ∈ nhds (1 : AbsGal F) :=
      (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U).mpr
        ⟨K, inferInstance, Set.Subset.rfl⟩
    refine ⟨U, hU_nhds, fun w hwU _ => ?_⟩
    let w_K : relWeil F K := ⟨w.1, ⟨w.2.1, hwU⟩⟩
    have hχ_w : χ_B w = 1 := by
      have h1 : restrictWeilChar F hBK χ_B w_K = 1 := by
        rw [hχ_B_restK, MonoidHom.one_apply]
      exact h1
    change (χ_B w : Ω F) • LinearMap.id = 1
    rw [hχ_w, Units.val_one, one_smul]
    rfl
  have hWf : (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).Wf F A := ⟨hFinB, hSepAB, hWeilB⟩
  
  obtain ⟨H_B, M_B, hHB_le_HA, hHB_iff, h_fix_B, hMB_iff, h_mem_B⟩ :
      ∃ (H_B : Subgroup H) (M_B : Subgroup G),
        H_B ≤ H_A ∧
        (∀ h : H, h ∈ H_B ↔ ∀ x : K', (x : AlgebraicClosure F) ∈ B → h.1 x = x) ∧
        (∀ x : K', (x : AlgebraicClosure F) ∈ B ↔ ∀ h ∈ H_B, ∀ c ∈ C, (h.1 * c) x = x) ∧
        (∀ g : G, g ∈ M_B ↔ projH g ∈ H_B) ∧
        (∀ w : relWeil F L, w ∈ (relWeil F B).subgroupOf (relWeil F L) ↔ π w ∈ M_B) := by
    let B_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLB
    let B' : IntermediateField L K' := B_L.comap K'.val
    have hB'_mem : ∀ x : K', x ∈ B' ↔ (x : AlgebraicClosure F) ∈ B :=
      fun x => IntermediateField.mem_extendScalars hLB
    let H_B : Subgroup H := B'.fixingSubgroup.subgroupOf H
    let M_B : Subgroup G := H_B.comap projH
    have hHB_iff : ∀ h : H, h ∈ H_B ↔ ∀ x : K', (x : AlgebraicClosure F) ∈ B → h.1 x = x := by
      intro h
      change h.1 ∈ B'.fixingSubgroup ↔ ∀ x : K', (x : AlgebraicClosure F) ∈ B → h.1 x = x
      rw [IntermediateField.mem_fixingSubgroup_iff]
      refine ⟨fun hh x hxB => hh x ((hB'_mem x).mpr hxB),
        fun hh x hxB' => hh x ((hB'_mem x).mp hxB')⟩
    have hMB_iff : ∀ g : G, g ∈ M_B ↔ projH g ∈ H_B := fun _ => Iff.rfl
    have hC_fix_MC : ∀ (c : G), c ∈ C → ∀ (x : K'), (x : AlgebraicClosure F) ∈ M_C → c x = x := by
      intro c hcC x hxMC
      have hx_rs : (x : AlgebraicClosure F) ∈
          (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F := by
        rwa [h_field_C]
      have hx_lift : (x : AlgebraicClosure F) ∈
          IntermediateField.lift (IntermediateField.fixedField C) :=
        (IntermediateField.mem_restrictScalars F).mp hx_rs
      have hx_fix : x ∈ IntermediateField.fixedField C :=
        (IntermediateField.mem_lift x).mp hx_lift
      exact (IntermediateField.mem_fixedField_iff C x).mp hx_fix c hcC
    have hB'_fix_eq_MB : ∀ g : G, g ∈ B'.fixingSubgroup ↔ g ∈ M_B := by
      intro g
      rw [IntermediateField.mem_fixingSubgroup_iff, hMB_iff, hHB_iff]
      let h := projH g
      let c := h.1⁻¹ * g
      have hcC : c ∈ C := hprojH_mul_C g
      have hg_eq : g = h.1 * c := by dsimp [h, c]; group
      constructor
      · intro hg x hxB
        have hcx : c x = x := hC_fix_MC c hcC x (hBMC hxB)
        have hgx : g x = x := hg x ((hB'_mem x).mpr hxB)
        calc h.1 x = h.1 (c x) := by rw [hcx]
          _ = (h.1 * c) x := rfl
          _ = g x := by rw [← hg_eq]
          _ = x := hgx
      · intro hh x hxB'
        have hxB : (x : AlgebraicClosure F) ∈ B := (hB'_mem x).mp hxB'
        have hcx : c x = x := hC_fix_MC c hcC x (hBMC hxB)
        calc g x = (h.1 * c) x := by rw [hg_eq]
          _ = h.1 (c x) := rfl
          _ = h.1 x := by rw [hcx]
          _ = x := hh x hxB
    have h_fix_B : ∀ x : K',
        (x : AlgebraicClosure F) ∈ B ↔ ∀ h ∈ H_B, ∀ c ∈ C, (h.1 * c) x = x := by
      intro x
      rw [← hB'_mem x, ← IsGalois.fixedField_fixingSubgroup B',
        IntermediateField.mem_fixedField_iff]
      constructor
      · intro hx h hhB c hcC
        have hxB' : x ∈ B' := by
          rwa [← IsGalois.fixedField_fixingSubgroup B', IntermediateField.mem_fixedField_iff]
        have hxB : (x : AlgebraicClosure F) ∈ B := (hB'_mem x).mp hxB'
        have hcx : c x = x := hC_fix_MC c hcC x (hBMC hxB)
        calc (h.1 * c) x = h.1 (c x) := rfl
          _ = h.1 x := by rw [hcx]
          _ = x := (hHB_iff h).mp hhB x hxB
      · intro hhc g hg
        have hgM : g ∈ M_B := (hB'_fix_eq_MB g).mp hg
        have hhB : projH g ∈ H_B := hgM
        let c := (projH g).1⁻¹ * g
        have hcC : c ∈ C := hprojH_mul_C g
        have hg_eq : g = (projH g).1 * c := by dsimp [c]; group
        rw [hg_eq]
        exact hhc (projH g) hhB c hcC
    have h_mem_B : ∀ w : relWeil F L,
        w ∈ (relWeil F B).subgroupOf (relWeil F L) ↔ π w ∈ M_B := by
      intro w
      rw [← hB'_fix_eq_MB (π w)]
      have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
      change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ B.fixingSubgroup) ↔
        π w ∈ B'.fixingSubgroup
      rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff,
        IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hw x hxB'
        apply Subtype.ext
        have h1 := hπ w x
        change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) x.1 at h1
        rw [h1]
        exact hw x.1 ((hB'_mem x).mp hxB')
