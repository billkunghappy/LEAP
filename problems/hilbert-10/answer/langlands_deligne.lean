    have hterm3 :
        η * (C ^ p - Q_E') * U₁ = 0 ∨
          B_7 ≤ valL F E' (η * (C ^ p - Q_E') * U₁) := by
      have h1 := hvalE'_mul_ge 0 B_7 η (C ^ p - Q_E') hη_b0 hCp_QE'
