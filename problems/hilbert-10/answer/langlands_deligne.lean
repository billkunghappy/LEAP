      (τ_t j : K₁) = (j : K₁) ^ (p ^ b_teich) ∧ τ_u j = (τ_t j) ^ p := by
    intro j hj_lt hj_pos
    have hj_ne : (j : K₁) ≠ 0 := (hj_unit_K₁ j hj_lt hj_pos).1
    have hu_coe : (u_nat j : K₁) = (j : K₁) := by
      dsimp [u_nat]
      rw [dif_pos hj_ne]
      rfl
    refine ⟨?_, rfl⟩
    change (u_nat j : K₁) ^ (p ^ b_teich) = (j : K₁) ^ (p ^ b_teich)
    rw [hu_coe]
  have hτ_u_approx : ∀ j < p, 0 < j →
      (τ_u j : K₁) - (j : K₁) = 0 ∨ B₀ ≤ valL F K₁ ((τ_u j : K₁) - (j : K₁)) := by
    intro j hj_lt hj_pos
    have hτu_coe : (τ_u j : K₁) = (j : K₁) ^ (p ^ (b_teich + 1)) := by
      change (τ_t j : K₁) ^ p = (j : K₁) ^ (p ^ (b_teich + 1))
      rw [(hτ_def j hj_lt hj_pos).1, ← pow_mul, ← pow_succ]
    have hzmod : ((j : ZMod p)) ^ (p ^ (b_teich + 1)) = (j : ZMod p) :=
      ZMod.pow_card_pow (n := b_teich + 1) (j : ZMod p)
    have hzmod_int : (((j : ℤ) ^ (p ^ (b_teich + 1)) : ℤ) : ZMod p) = ((j : ℤ) : ZMod p) := by
      push_cast
      exact hzmod
    have hdvd : (p : ℤ) ∣ ((j : ℤ) ^ (p ^ (b_teich + 1)) - (j : ℤ)) :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub (j : ℤ) ((j : ℤ) ^ (p ^ (b_teich + 1))) p).mp
        hzmod_int.symm
    rcases hdvd with ⟨c_j, hcj⟩
    have hcj_K₁ : (τ_u j : K₁) - (j : K₁) = ((p : ℕ) : K₁) * (c_j : K₁) := by
      rw [hτu_coe]
      have hcast := congrArg (Int.cast : ℤ → K₁) hcj
      push_cast at hcast
      exact hcast
    rw [hcj_K₁]
    refine val_mono_K₁ ?_ (val_mul_K₁ hp_valK₁ (val_intCast_K₁ c_j))
    linarith [hB₀_le_bteich]
  have hτ_u_diff : ∀ j₁ < p, ∀ j₂ < p, 0 < j₁ → 0 < j₂ → j₁ ≠ j₂ →
      (τ_u j₂ : K₁) - (τ_u j₁ : K₁) ≠ 0 ∧ valL F K₁ ((τ_u j₂ : K₁) - (τ_u j₁ : K₁)) = 0 := by
    intro j₁ hj₁_lt j₂ hj₂_lt hj₁_pos hj₂_pos hne
    obtain ⟨hj_ne, hj_val⟩ := hj_diff_unit_K₁ j₁ hj₁_lt j₂ hj₂_lt hj₁_pos hj₂_pos hne
    have herr : ((τ_u j₂ : K₁) - (j₂ : K₁)) - ((τ_u j₁ : K₁) - (j₁ : K₁)) = 0 ∨
        (1 : ℤ) ≤ valL F K₁ (((τ_u j₂ : K₁) - (j₂ : K₁)) - ((τ_u j₁ : K₁) - (j₁ : K₁))) :=
      val_mono_K₁ hB₀_ge1
        (val_sub_K₁ (hτ_u_approx j₂ hj₂_lt hj₂_pos) (hτ_u_approx j₁ hj₁_lt hj₁_pos))
    have hsplit : (τ_u j₂ : K₁) - (τ_u j₁ : K₁) =
        ((j₂ : K₁) - (j₁ : K₁)) + (((τ_u j₂ : K₁) - (j₂ : K₁)) - ((τ_u j₁ : K₁) - (j₁ : K₁))) := by
      ring
    rw [hsplit]
    exact hval_unit_add_pos ((j₂ : K₁) - (j₁ : K₁)) _ hj_ne hj_val herr

  
  have hx₀_ne : x₀ ≠ 0 := by
    dsimp [x₀]
    exact (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hD₀_ne0
  have hx₀_val : valL F K₁ x₀ = 0 := by
    dsimp [x₀]
    rw [hval_E'K₁ D₀, hD₀_val0, mul_zero]
  have hx₀_fact : x₀ ^ p - x₀ = x₀ * (x₀ ^ (p - 1) - 1) := by
    have hp_eq : (p - 1) + 1 = p := Nat.sub_add_cancel hp_pos
    calc x₀ ^ p - x₀ = x₀ ^ ((p - 1) + 1) - x₀ := by rw [hp_eq]
      _ = x₀ * x₀ ^ (p - 1) - x₀ := by rw [pow_succ']
      _ = x₀ * (x₀ ^ (p - 1) - 1) := by ring
  have hx₀_as : x₀ ^ p - x₀ = 0 ∨ B₀ ≤ valL F K₁ (x₀ ^ p - x₀) := hD₀_as
  rw [hx₀_fact] at hx₀_as
  have hx₀_p1 : x₀ ^ (p - 1) - 1 = 0 ∨ B₀ ≤ valL F K₁ (x₀ ^ (p - 1) - 1) :=
    hval_cancel_unit B₀ x₀ (x₀ ^ (p - 1) - 1) hx₀_ne hx₀_val hx₀_as
  have hneg_x₀_p1 : (-x₀) ^ (p - 1) - 1 = 0 ∨ B₀ ≤ valL F K₁ ((-x₀) ^ (p - 1) - 1) := by
    rw [hneg_pow_p1 x₀]
    exact hx₀_p1
  have hneg_x₀_val : -x₀ = 0 ∨ 0 ≤ valL F K₁ (-x₀) := Or.inr (by rw [hvalK₁_neg, hx₀_val])
  have hteich_sub : (∏ j ∈ S', (-x₀ + (τ_u j : K₁))) - ((-x₀) ^ (p - 1) - 1) = 0 ∨
      B₀ ≤ valL F K₁ ((∏ j ∈ S', (-x₀ + (τ_u j : K₁))) - ((-x₀) ^ (p - 1) - 1)) :=
    val_mono_K₁ hB₀_le_bteich1 (hTeich_K₁ (-x₀) hneg_x₀_val τ_u τ_t hτ_def)
