  have hnorm_x_d₂ := hnorm_val_L (d₂ : ℤ) x hx
  have hnorm_w₀_val := hnorm_val_L (-(h₀ : ℤ)) w₀ hw₀
  have hu_x_d₂ : u_x = 0 ∨ (d₂ : ℤ) ≤ valL F L u_x := by
    rw [hu_x_eq]
    exact hval_add_L (d₂ : ℤ) _ _
      (hval_add_L (d₂ : ℤ) _ _ htr_x_d₂ hnorm_x_d₂)
      htr_zx_d₂
  have hu_x_sq : u_x ^ 2 = 0 ∨ (bE' : ℤ) + (h₀ : ℤ) ≤ valL F L (u_x ^ 2) := by
    rw [sq]
    rcases hval_mul_bound_L (d₂ : ℤ) (d₂ : ℤ) u_x u_x hu_x_d₂ hu_x_d₂ with h0 | hge
    · left; exact h0
    · right; linarith
  let Δ_u : L := (2 * u_x - u_x ^ 2) - 2 * (traceLM F hLE' x + normLM F hLE' x)
  have hΔ_u_eq : Δ_u = (traceLM F hLE' z_x + traceLM F hLE' z_x) - u_x ^ 2 := by
    dsimp [Δ_u]; rw [hu_x_eq]; ring
  have hΔ_u_val : Δ_u = 0 ∨ (bE' : ℤ) + (h₀ : ℤ) ≤ valL F L Δ_u := by
    rw [hΔ_u_eq]
    exact hval_sub_L ((bE' : ℤ) + (h₀ : ℤ)) _ _
      (hval_add_L ((bE' : ℤ) + (h₀ : ℤ)) _ _ htr_zx_bE'_h₀ htr_zx_bE'_h₀)
      hu_x_sq
  have hRHS_rem : normLM F hLE' w₀ * Δ_u = 0 ∨
      (bE' : ℤ) ≤ valL F L (normLM F hLE' w₀ * Δ_u) := by
    rcases hval_mul_bound_L (-(h₀ : ℤ)) ((bE' : ℤ) + (h₀ : ℤ)) _ _ hnorm_w₀_val hΔ_u_val with h0 | hge
    · left; exact h0
    · right; linarith
  
  let R₁ : E' := (w₀ ^ p - IntermediateField.inclusion hLE' (normLM F hLE' w₀)) * (2 * x)
  let R₂ : E' := (w₀ ^ p - w₀) * (-(x ^ 2))
  have hw₀_p : w₀ ^ p = 0 ∨ -(p : ℤ) * (h₀ : ℤ) ≤ valL F E' (w₀ ^ p) := by
    rcases hval_pow_E' p (-(h₀ : ℤ)) w₀ hw₀ with h0 | hge
    · left; exact h0
    · right; linarith
  have hw₀_ph₀ : w₀ = 0 ∨ -(p : ℤ) * (h₀ : ℤ) ≤ valL F E' w₀ := by
    rcases hw₀ with rfl | hw₀_ge
    · left; rfl
    · right
      have h_le : -(p : ℤ) * (h₀ : ℤ) ≤ -(h₀ : ℤ) := by
