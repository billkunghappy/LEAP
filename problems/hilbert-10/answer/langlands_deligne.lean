        _ = d + ε * (d * ((u_d⁻¹ : Lˣ) : L)) := by rw [hd_inv]
        _ = d * (1 + q) := by dsimp [q]; ring
    rw [hdiff_eq]
    refine ⟨mul_ne_zero hd_ne0 h1q_unit.1, ?_⟩
    rw [hval_mul_L d (1 + q) hd_ne0 h1q_unit.1, hd_val0, h1q_unit.2, add_zero]
  have hConj5 : ∀ m₁' < p, ∀ m₂' < p, 0 < m₁' → 0 < m₂' → m₁' ≠ m₂' →
      let ξ_1 := ι₂ (ι₁ (τ_unit m₁' : L))
      let ξ_2 := ι₂ (ι₁ (τ_unit m₂' : L))
      ξ_2 - ξ_1 ≠ 0 ∧ valL F K₁ (ξ_2 - ξ_1) = 0 := by
    intro m₁' hm₁'_lt m₂' hm₂'_lt hm₁'_pos hm₂'_pos hm_ne
    dsimp only
    have hdiff_L : (τ_unit m₂' : L) - (τ_unit m₁' : L) ≠ 0 ∧
        valL F L ((τ_unit m₂' : L) - (τ_unit m₁' : L)) = 0 := by
      rcases lt_or_gt_of_ne hm_ne with hlt | hgt
      · exact hdiff_lt_L m₁' m₂' hm₂'_lt hm₁'_pos hlt
      · have hrev := hdiff_lt_L m₂' m₁' hm₁'_lt hm₂'_pos hgt
        have hneg : (τ_unit m₂' : L) - (τ_unit m₁' : L) = -((τ_unit m₁' : L) - (τ_unit m₂' : L)) := by
          ring
        rw [hneg]
        refine ⟨neg_ne_zero.mpr hrev.1, ?_⟩
        rw [hval_neg_L, hrev.2]
    have hsub_map : ι₂ (ι₁ (τ_unit m₂' : L)) - ι₂ (ι₁ (τ_unit m₁' : L)) =
        ι₂ (ι₁ ((τ_unit m₂' : L) - (τ_unit m₁' : L))) := by
      rw [map_sub, map_sub]
    rw [hsub_map]
    refine ⟨?_, ?_⟩
    · intro h0
      apply hdiff_L.1
      apply hι₁_inj
      apply hι₂_inj
      rw [h0, map_zero, map_zero]
    · rw [hval_LK₁, hdiff_L.2, mul_zero, mul_zero]
  have hConj6 : ∀ N : K₁, (N = 0 ∨ 0 ≤ valL F K₁ N) →
      (∏ m ∈ S', (N + ι₂ (ι₁ (τ_unit m : L)))) - (N ^ (p - 1) - 1) = 0 ∨
        ((p * (p - 1) * (bE' - 1) - (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁ ((∏ m ∈ S', (N + ι₂ (ι₁ (τ_unit m : L)))) - (N ^ (p - 1) - 1)) := by
    intro N hN
    let τ_t_K₁ : ℕ → K₁ˣ := fun j =>
      Units.map ι₂.toMonoidHom (Units.map ι₁.toMonoidHom (τ_tilde j))
    let τ_u_K₁ : ℕ → K₁ˣ := fun j => (τ_t_K₁ j) ^ p
    have hτ_def_K₁ : ∀ j < p, 0 < j →
        (τ_t_K₁ j : K₁) = (j : K₁) ^ (p ^ B) ∧ τ_u_K₁ j = (τ_t_K₁ j) ^ p := by
      intro j hj hj0
      refine ⟨?_, rfl⟩
      change ι₂ (ι₁ (τ_tilde j : L)) = (j : K₁) ^ (p ^ B)
      rw [hτ_tilde_coe j hj hj0, map_pow, map_pow, map_natCast, map_natCast]
    have hτ_u_K₁_coe : ∀ j : ℕ, (τ_u_K₁ j : K₁) = ι₂ (ι₁ (τ_unit j : L)) := by
      intro j
      change (ι₂ (ι₁ (τ_tilde j : L))) ^ p = ι₂ (ι₁ ((τ_tilde j : L) ^ p))
