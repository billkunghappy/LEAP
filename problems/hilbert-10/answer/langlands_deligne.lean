      have hring2 :
          (iLM₁' X *
            (iLM₁' (trLM₁' (b ^ k_pow)) - Q k_pow -
              ((p - 1 : ℕ) : R_M) * (1 - s₁ ^ p)) +
          iLM₁' X *
            (Q k_pow - iLM₁' (trLE' (a ^ k_pow)))) -
