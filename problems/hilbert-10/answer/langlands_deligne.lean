      rw [hν_w, ← ψ.map_add_eq_mul]
      congr 1
      ring
    rw [hν_mul, hψ_split, mul_inv]
    calc (ν₁ u₂ : Ω F)⁻¹ * ψ (A * (δ_b : L) * x₂)
