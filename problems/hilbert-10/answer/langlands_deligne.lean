        exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
    haveI : FiniteDimensional F M_C :=
      Module.Finite.of_injective (IntermediateField.inclusion hM_CK).toLinearMap
        (IntermediateField.inclusion hM_CK).injective
    refine ⟨M_C, hLM_C, hM_CK, ?_, ?_, ?_, ?_, ?_⟩
    · refine ⟨hLM_C, inferInstance, ?_, ?_⟩
      · intro σ hσ τ hτ
        have hτL : τ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM_C hτ
        let σ' : L.fixingSubgroup := ⟨σ, hσ⟩
        let τ' : L.fixingSubgroup := ⟨τ, hτL⟩
        have hτC : res τ' ∈ C := (h_res_MC τ').mp hτ
        have hconjC : res (σ' * τ' * σ'⁻¹) ∈ C := by
          rw [map_mul, map_mul, map_inv]
          exact hC_norm.conj_mem (res τ') hτC (res σ')
        exact (h_res_MC (σ' * τ' * σ'⁻¹)).mpr hconjC
      · intro h
        rw [hSep_iff L M_C h]
        exact hM_CK.trans ((hSep_iff L K hLK).mp (hGal.2.2.2 hLK))
    · refine ⟨?_, ?_, ?_⟩
      · intro σ hσ τ hτ
        exact hGal.2.2.1 σ (IntermediateField.fixingSubgroup_le hLM_C hσ) τ hτ
      · intro σ hσ τ hτ
        let σ' : L.fixingSubgroup := ⟨σ, IntermediateField.fixingSubgroup_le hLM_C hσ⟩
        let τ' : L.fixingSubgroup := ⟨τ, IntermediateField.fixingSubgroup_le hLM_C hτ⟩
        have hσC : res σ' ∈ C := (h_res_MC σ').mp hσ
        have hτC : res τ' ∈ C := (h_res_MC τ').mp hτ
        have hcomm1 : res (σ' * τ' * σ'⁻¹ * τ'⁻¹) = 1 := by
          rw [map_mul, map_mul, map_mul, map_inv, map_inv, hC_ab (res σ') hσC (res τ') hτC,
            mul_inv_cancel_right, mul_inv_cancel]
        exact (h_res_K (σ' * τ' * σ'⁻¹ * τ'⁻¹)).mpr hcomm1
      · rw [hSep_iff M_C K hM_CK]
        intro z hz
        rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
        have hzL : IsSeparable L z := by
          have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) hz
          exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
        exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLM_C)) hzL
    · exact helper_fixedField_finrank_lt L (AlgebraicClosure F) K' C hC_ne
    · intro K₁ hLK₁ hK₁K hGal₁
      let K₁' := toSub K₁ hLK₁
      let H₁ := K₁'.fixingSubgroup
      have hH₁_norm : H₁.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := h_res_surj g
        obtain ⟨τ, rfl⟩ := h_res_surj h
        have hτK₁ : τ.1 ∈ K₁.fixingSubgroup := (h_res_fix K₁ hLK₁ hK₁K τ).mpr hh
        have hconj : (σ * τ * σ⁻¹).1 ∈ K₁.fixingSubgroup := hGal₁.2.2.1 σ.1 σ.2 τ.1 hτK₁
        have hres_conj : res (σ * τ * σ⁻¹) = res σ * res τ * (res σ)⁻¹ := by
          rw [map_mul, map_mul, map_inv]
        rw [← hres_conj]
        exact (h_res_fix K₁ hLK₁ hK₁K (σ * τ * σ⁻¹)).mp hconj
      let e := IsGalois.intermediateFieldEquivSubgroup (F := L) (E := K')
      rcases hC_norm_dich H₁ hH₁_norm with hle | hbot
      · left
        have h1 : e K₁' ≤ e M_C' := by
          change M_C'.fixingSubgroup ≤ H₁
          rwa [h_MC'_fix]
        have h2 : K₁' ≤ M_C' := (e.le_iff_le.mp h1)
        rw [← h_toSub_MC, h_toSub_le K₁ M_C hLK₁ hK₁K hLM_C] at h2
        exact h2
      · right
        have h1 : e (K₁' ⊔ M_C') = e ⊤ := by
          rw [OrderIso.map_sup, OrderIso.map_top]
          change H₁ ⊓ M_C'.fixingSubgroup = ⊥
          rwa [h_MC'_fix]
        have h2 : K₁' ⊔ M_C' = ⊤ := e.injective h1
        rw [← h_toSub_MC, ← h_toSub_sup K₁ M_C hLK₁ hK₁K hLM_C hM_CK, ← h_toSub_top,
          h_toSub_eq (K₁ ⊔ M_C) K (hLK₁.trans le_sup_left) (sup_le hK₁K hM_CK) hLK le_rfl] at h2
        exact h2
    · intro E hLE hEK
      let E' := toSub E hLE
      let H := E'.fixingSubgroup
      let e := IsGalois.intermediateFieldEquivSubgroup (F := L) (E := K')
      rcases hC_trich H with hle | hlt | hbot
      · left
        have h1 : e E' ≤ e M_C' := by
          change M_C'.fixingSubgroup ≤ H
          rwa [h_MC'_fix]
        have h2 : E' ≤ M_C' := e.le_iff_le.mp h1
        rw [← h_toSub_MC, h_toSub_le E M_C hLE hEK hLM_C] at h2
        exact h2
      · right; left
        have h1 : e ⊥ < e (E' ⊓ M_C') := by
          rw [OrderIso.map_bot, OrderIso.map_inf]
          change H ⊔ M_C'.fixingSubgroup < ⊤
          rwa [h_MC'_fix]
        have h2 : ⊥ < E' ⊓ M_C' := e.lt_iff_lt.mp h1
        rw [← h_toSub_bot, ← h_toSub_MC, ← h_toSub_inf E M_C hLE hLM_C] at h2
        refine lt_of_le_of_ne (le_inf hLE hLM_C) fun heq => ?_
        exact h2.ne ((h_toSub_eq L (E ⊓ M_C) le_rfl hLK (le_inf hLE hLM_C)
          (inf_le_left.trans hEK)).mpr heq)
      · right; right
        have h1 : e (E' ⊔ M_C') = e ⊤ := by
          rw [OrderIso.map_sup, OrderIso.map_top]
          change H ⊓ M_C'.fixingSubgroup = ⊥
          rwa [h_MC'_fix]
        have h2 : E' ⊔ M_C' = ⊤ := e.injective h1
        rw [← h_toSub_MC, ← h_toSub_sup E M_C hLE hEK hLM_C hM_CK, ← h_toSub_top,
          h_toSub_eq (E ⊔ M_C) K (hLE.trans le_sup_left) (sup_le hEK hM_CK) hLK le_rfl] at h2
        exact h2

theorem ld_ch15_galois_subgroups_and_weil_proj (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K M_C E F' : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hLF' : L ≤ F') (hF'E : F' ≤ E) (hF'M_C : F' ≤ M_C)
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK) :
    let hF'K : F' ≤ K := hF'E.trans hEK
    let K' := IntermediateField.extendScalars hF'K
    FiniteDimensional F F' ∧
    FiniteDimensional F K ∧
    FiniteDimensional F' K' ∧
    IsGalois F' K' ∧
    ∃ (π : relWeil F F' →* (K' ≃ₐ[F'] K'))
      (C H : Subgroup (K' ≃ₐ[F'] K')),
      (∀ (w : relWeil F F') (x : K'),
        ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F)) ∧
      Function.Surjective π ∧
      C.Normal ∧
      (∀ a ∈ C, ∀ b ∈ C, a * b = b * a) ∧
      (∀ w : relWeil F F', w ∈ (relWeil F E).subgroupOf (relWeil F F') ↔ π w ∈ H) ∧
      (∀ (M : Subgroup (K' ≃ₐ[F'] K')), C ≤ M →
        (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ M_C) ∧
      (∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
        L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
        ∀ (M : Subgroup (K' ≃ₐ[F'] K')),
          (∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ M) →
          (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ K₁) :=
by
  let hF'K : F' ≤ K := hF'E.trans hEK
  let K' : IntermediateField F' (AlgebraicClosure F) := IntermediateField.extendScalars hF'K
  let G' := (K' ≃ₐ[F'] K')
  have hFinK : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F K := hFinK
  have hFinF' : FiniteDimensional F F' :=
    Module.Finite.of_injective (IntermediateField.inclusion hF'K).toLinearMap
      (IntermediateField.inclusion hF'K).injective
  haveI : FiniteDimensional F F' := hFinF'
  haveI : FiniteDimensional F K' := hFinK
  haveI : IsScalarTower F F' K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hFinF'K' : FiniteDimensional F' K' := Module.Finite.of_restrictScalars_finite F F' K'
  haveI : FiniteDimensional F' K' := hFinF'K'
  have hSep_iff : ∀ (A B : IntermediateField F (AlgebraicClosure F)) (hAB : A ≤ B),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) ↔
        B ≤ IntermediateField.restrictScalars F (separableClosure A (AlgebraicClosure F)) := by
    intro A B hAB
    let S := IntermediateField.extendScalars hAB
    have hmin : ∀ x : S, IsSeparable A x.1 ↔ IsSeparable A x := by
      intro x
      change (minpoly A (S.val x)).Separable ↔ (minpoly A x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hAB).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable A S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hSepF'K : Algebra.IsSeparable F' K' := by
    rw [hSep_iff F' K hF'K]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z := by
      have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) hz
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLF')) hzL
  haveI : Algebra.IsSeparable F' K' := hSepF'K
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k K₀ := by
    intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal F' (AlgebraicClosure F) := Normal.tower_top_of_normal F F' (AlgebraicClosure F)
  have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[F'] AlgebraicClosure F),
      (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
    intro σ τ hτ
    let σ_F : F'.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv F').symm σ
    let τ_F : F'.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv F').symm τ
    have hσL : σ_F.1 ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLF' σ_F.2
    have hτK : τ_F.1 ∈ K.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hF'K).mpr hx)
    have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
      hGal.2.2.1 σ_F.1 hσL τ_F.1 hτK
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
    exact hconjK x ((IntermediateField.mem_extendScalars hF'K).mp hx)
  have hGalF'K' : IsGalois F' ↥K' := helper_isGalois F' (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois F' ↥K' := hGalF'K'
  haveI : Normal F' ↥K' := IsGalois.to_normal
  let π : relWeil F F' →* G' :=
    (AlgEquiv.restrictNormalHom K').comp
      ((IntermediateField.fixingSubgroupEquiv F').toMonoidHom.comp
        (Subgroup.inclusion (inf_le_right : relWeil F F' ≤ F'.fixingSubgroup)))
  have hπ : ∀ (w : relWeil F F') (x : K'),
      ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) := by
    intro w x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv F') ⟨w.1, w.2.2⟩) x : K') : AlgebraicClosure F) =
      (w : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  let H_KF' : Subgroup (relWeil F F') := (relWeil F K).subgroupOf (relWeil F F')
  let bar_π : (relWeil F F' ⧸ H_KF') → G' := fun u => π (cosetRep u)
  have h_ker_π : ∀ w : relWeil F F', π w = 1 → w ∈ H_KF' := by
    intro w hw
    rw [Subgroup.mem_subgroupOf]
    refine Subgroup.mem_inf.mpr ⟨w.2.1, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr hz⟩
    have h1 := hπ w x
    rw [hw] at h1
    exact h1.symm
  have hbar_π_inj : Function.Injective bar_π := by
    intro u₁ u₂ h_eq
    change π (cosetRep u₁) = π (cosetRep u₂) at h_eq
    have h1 : π ((cosetRep u₁)⁻¹ * cosetRep u₂) = 1 := by
      rw [map_mul, map_inv, h_eq, inv_mul_cancel]
    have h2 : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ H_KF' := h_ker_π _ h1
    have h3 : (QuotientGroup.mk (cosetRep u₁) : relWeil F F' ⧸ H_KF') =
        QuotientGroup.mk (cosetRep u₂) := QuotientGroup.eq.mpr h2
    have h_out1 : (QuotientGroup.mk (cosetRep u₁) : relWeil F F' ⧸ H_KF') = u₁ :=
      Quotient.out_eq u₁
    have h_out2 : (QuotientGroup.mk (cosetRep u₂) : relWeil F F' ⧸ H_KF') = u₂ :=
      Quotient.out_eq u₂
    rw [h_out1, h_out2] at h3
    exact h3
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFin_quot, hCard_quot⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob F' K hF'K hSepF'K
  letI : Finite (relWeil F F' ⧸ H_KF') := hFin_quot
  letI : Fintype (relWeil F F' ⧸ H_KF') := Fintype.ofFinite (relWeil F F' ⧸ H_KF')
  have h_card_eq : Fintype.card (relWeil F F' ⧸ H_KF') = Fintype.card G' := by
    rw [← Nat.card_eq_fintype_card, hCard_quot, ← IsGalois.card_aut_eq_finrank F' K',
      Nat.card_eq_fintype_card]
  have hbar_π_bij : Function.Bijective bar_π :=
    (Fintype.bijective_iff_injective_and_card bar_π).mpr ⟨hbar_π_inj, h_card_eq⟩
  have hsurj : Function.Surjective π := by
    intro g
    obtain ⟨u, hu⟩ := hbar_π_bij.2 g
    exact ⟨cosetRep u, hu⟩
  let toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)), F' ≤ A → IntermediateField F' K' :=
    fun A hF'A => (IntermediateField.extendScalars hF'A).comap K'.val
  have h_mem_toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hF'A : F' ≤ A) (x : K'),
      x ∈ toSub A hF'A ↔ x.1 ∈ A :=
    fun A hF'A _ => IntermediateField.mem_extendScalars hF'A
  let C : Subgroup G' := (toSub M_C hF'M_C).fixingSubgroup
  let H : Subgroup G' := (toSub E hF'E).fixingSubgroup
  let res_F' : F'.fixingSubgroup →* G' :=
    (AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv F').toMonoidHom
  have h_res_apply : ∀ (σ : F'.fixingSubgroup) (x : K'),
      ((res_F' σ x : K') : AlgebraicClosure F) = σ.1 x.1 := by
    intro σ x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv F') σ) x : K') : AlgebraicClosure F) = σ.1 x.1
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have h_res_surj : Function.Surjective res_F' :=
    (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
      (IntermediateField.fixingSubgroupEquiv F').surjective
  have h_res_fix : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hF'A : F' ≤ A) (hAK : A ≤ K)
      (σ : F'.fixingSubgroup),
      σ.1 ∈ A.fixingSubgroup ↔ res_F' σ ∈ (toSub A hF'A).fixingSubgroup := by
    intro A hF'A hAK σ
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hσ y hy
      apply Subtype.ext
      rw [h_res_apply σ y]
      exact hσ y.1 ((h_mem_toSub A hF'A y).mp hy)
    · intro hσ x hx
      let y : K' := ⟨x, (IntermediateField.mem_extendScalars hF'K).mpr (hAK hx)⟩
      have hy : y ∈ toSub A hF'A := (h_mem_toSub A hF'A y).mpr hx
      have h1 := congrArg Subtype.val (hσ y hy)
      rwa [h_res_apply σ y] at h1
  have h_res_K : ∀ σ : F'.fixingSubgroup, σ.1 ∈ K.fixingSubgroup ↔ res_F' σ = 1 := by
    intro σ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hσ
      apply AlgEquiv.ext
      intro y
      apply Subtype.ext
      rw [h_res_apply σ y]
      exact hσ y.1 ((IntermediateField.mem_extendScalars hF'K).mp y.2)
    · intro h1 x hx
      let y : K' := ⟨x, (IntermediateField.mem_extendScalars hF'K).mpr hx⟩
      have hy : res_F' σ y = y := by rw [h1]; rfl
      have hy_val := congrArg Subtype.val hy
      rwa [h_res_apply σ y] at hy_val
  have hC_norm : C.Normal := by
    refine ⟨fun c hc g => ?_⟩
    obtain ⟨σ, rfl⟩ := h_res_surj g
    obtain ⟨τ, rfl⟩ := h_res_surj c
    have hσL : σ.1 ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLF' σ.2
    have hτM : τ.1 ∈ M_C.fixingSubgroup := (h_res_fix M_C hF'M_C hM_CK τ).mpr hc
    have hconj : (σ * τ * σ⁻¹).1 ∈ M_C.fixingSubgroup := hMin.1.2.2.1 σ.1 hσL τ.1 hτM
    have hres_conj : res_F' (σ * τ * σ⁻¹) = res_F' σ * res_F' τ * (res_F' σ)⁻¹ := by
      rw [map_mul, map_mul, map_inv]
    rw [← hres_conj]
    exact (h_res_fix M_C hF'M_C hM_CK (σ * τ * σ⁻¹)).mp hconj
  have hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a := by
    intro a ha b hb
    obtain ⟨σ, rfl⟩ := h_res_surj a
    obtain ⟨τ, rfl⟩ := h_res_surj b
    have hσM : σ.1 ∈ M_C.fixingSubgroup := (h_res_fix M_C hF'M_C hM_CK σ).mpr ha
    have hτM : τ.1 ∈ M_C.fixingSubgroup := (h_res_fix M_C hF'M_C hM_CK τ).mpr hb
    have hcommK : (σ * τ * σ⁻¹ * τ⁻¹).1 ∈ K.fixingSubgroup := hMin.2.1.2.1 σ.1 hσM τ.1 hτM
    have hcomm1 : res_F' (σ * τ * σ⁻¹ * τ⁻¹) = 1 := (h_res_K (σ * τ * σ⁻¹ * τ⁻¹)).mp hcommK
    rw [map_mul, map_mul, map_mul, map_inv, map_inv] at hcomm1
    calc res_F' σ * res_F' τ
      _ = (res_F' σ * res_F' τ * (res_F' σ)⁻¹ * (res_F' τ)⁻¹) * (res_F' τ * res_F' σ) := by group
      _ = 1 * (res_F' τ * res_F' σ) := by rw [hcomm1]
      _ = res_F' τ * res_F' σ := one_mul _
  have h_mem_H : ∀ w : relWeil F F', w ∈ (relWeil F E).subgroupOf (relWeil F F') ↔ π w ∈ H := by
    intro w
    change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ E.fixingSubgroup) ↔ π w ∈ H
    have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
    rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff,
      IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hw x hx
      apply Subtype.ext
      rw [hπ w x]
      exact hw x.1 ((h_mem_toSub E hF'E x).mp hx)
    · intro hπw z hzE
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr (hEK hzE)⟩
      have hxE : x ∈ toSub E hF'E := (h_mem_toSub E hF'E x).mpr hzE
      have h1 := hπ w x
      have h2 : π w x = x := hπw x hxE
      rw [h2] at h1
      exact h1.symm
  have h_fix_le : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hF'A : F' ≤ A)
      (M : Subgroup G'), (toSub A hF'A).fixingSubgroup ≤ M →
      (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ A := by
    intro A hF'A M hM z hz
    have hzL : z ∈ IntermediateField.lift (IntermediateField.fixedField M) :=
      (IntermediateField.mem_restrictScalars F).mp hz
    have hzK' : z ∈ K' := IntermediateField.lift_le (IntermediateField.fixedField M) hzL
    let x : K' := ⟨z, hzK'⟩
    have hxM : x ∈ IntermediateField.fixedField M := (IntermediateField.mem_lift x).mp hzL
    have hx_fix : x ∈ IntermediateField.fixedField (toSub A hF'A).fixingSubgroup := by
      rw [IntermediateField.mem_fixedField_iff]
      intro g hg
      exact (IntermediateField.mem_fixedField_iff M x).mp hxM g (hM hg)
    rw [IsGalois.fixedField_fixingSubgroup (toSub A hF'A)] at hx_fix
    exact (h_mem_toSub A hF'A x).mp hx_fix
  have h_sub_MC : ∀ (M : Subgroup G'), C ≤ M →
      (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ M_C :=
    fun M hCM => h_fix_le M_C hF'M_C M hCM
  have h_sub_K₁ : ∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
      L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
      ∀ (M : Subgroup G'),
        (∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ M) →
        (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ≤ K₁ := by
    intro K₁ _ hK₁K hGal₁ hEK₁ hsup M hM_cent
    have hF'K₁ : F' ≤ K₁ := hF'E.trans hEK₁
    let H₁ : Subgroup G' := (toSub K₁ hF'K₁).fixingSubgroup
    apply h_fix_le K₁ hF'K₁ M
    have hH₁_norm : H₁.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := h_res_surj g
      obtain ⟨τ, rfl⟩ := h_res_surj h
      have hσL : σ.1 ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLF' σ.2
      have hτK₁ : τ.1 ∈ K₁.fixingSubgroup := (h_res_fix K₁ hF'K₁ hK₁K τ).mpr hh
      have hconj : (σ * τ * σ⁻¹).1 ∈ K₁.fixingSubgroup := hGal₁.2.2.1 σ.1 hσL τ.1 hτK₁
      have hres_conj : res_F' (σ * τ * σ⁻¹) = res_F' σ * res_F' τ * (res_F' σ)⁻¹ := by
        rw [map_mul, map_mul, map_inv]
      rw [← hres_conj]
      exact (h_res_fix K₁ hF'K₁ hK₁K (σ * τ * σ⁻¹)).mp hconj
    let F_int : IntermediateField F (AlgebraicClosure F) :=
      (IntermediateField.lift (IntermediateField.fixedField (H₁ ⊓ C))).restrictScalars F
    have hK₁_le_int : K₁ ≤ F_int := by
      intro z hz
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr (hK₁K hz)⟩
      have hxK₁ : x ∈ toSub K₁ hF'K₁ := (h_mem_toSub K₁ hF'K₁ x).mpr hz
      have hx_fix : x ∈ IntermediateField.fixedField (H₁ ⊓ C) := by
        rw [IntermediateField.mem_fixedField_iff]
        intro g hg
        exact (IntermediateField.mem_fixingSubgroup_iff _ g).mp hg.1 x hxK₁
      exact (IntermediateField.mem_restrictScalars F).mpr ((IntermediateField.mem_lift x).mpr hx_fix)
    have hMC_le_int : M_C ≤ F_int := by
      intro z hz
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr (hM_CK hz)⟩
      have hxMC : x ∈ toSub M_C hF'M_C := (h_mem_toSub M_C hF'M_C x).mpr hz
      have hx_fix : x ∈ IntermediateField.fixedField (H₁ ⊓ C) := by
        rw [IntermediateField.mem_fixedField_iff]
        intro g hg
        exact (IntermediateField.mem_fixingSubgroup_iff _ g).mp hg.2 x hxMC
      exact (IntermediateField.mem_restrictScalars F).mpr ((IntermediateField.mem_lift x).mpr hx_fix)
    have hK_le_int : K ≤ F_int := by
      rw [← hsup]
      exact sup_le hK₁_le_int hMC_le_int
    have h_disj : ∀ γ : G', γ ∈ H₁ → γ ∈ C → γ = 1 := by
      intro γ hγH₁ hγC
      apply AlgEquiv.ext
      intro x
      have hxK : x.1 ∈ K := (IntermediateField.mem_extendScalars hF'K).mp x.2
      have hx_int : x.1 ∈ F_int := hK_le_int hxK
      have hx_fix : x ∈ IntermediateField.fixedField (H₁ ⊓ C) :=
        (IntermediateField.mem_lift x).mp ((IntermediateField.mem_restrictScalars F).mp hx_int)
      exact (IntermediateField.mem_fixedField_iff (H₁ ⊓ C) x).mp hx_fix γ ⟨hγH₁, hγC⟩
    intro h₁ hh₁
    have hh₁H : h₁ ∈ H := by
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh₁ ⊢
      intro x hxE
      exact hh₁ x ((h_mem_toSub K₁ hF'K₁ x).mpr (hEK₁ ((h_mem_toSub E hF'E x).mp hxE)))
    apply hM_cent h₁ hh₁H
    intro c hc
    have h_comm_H₁ : h₁ * c * h₁⁻¹ * c⁻¹ ∈ H₁ := by
      have h_conj : c * h₁⁻¹ * c⁻¹ ∈ H₁ := hH₁_norm.conj_mem h₁⁻¹ (H₁.inv_mem hh₁) c
      have heq : h₁ * c * h₁⁻¹ * c⁻¹ = h₁ * (c * h₁⁻¹ * c⁻¹) := by group
      rw [heq]
      exact H₁.mul_mem hh₁ h_conj
    have h_comm_C : h₁ * c * h₁⁻¹ * c⁻¹ ∈ C :=
      C.mul_mem (hC_norm.conj_mem c hc h₁) (C.inv_mem hc)
    have h_comm_one : h₁ * c * h₁⁻¹ * c⁻¹ = 1 := h_disj _ h_comm_H₁ h_comm_C
    calc h₁ * c
      _ = (h₁ * c * h₁⁻¹ * c⁻¹) * (c * h₁) := by group
      _ = 1 * (c * h₁) := by rw [h_comm_one]
      _ = c * h₁ := one_mul _
  exact ⟨hFinF', hFinK, hFinF'K', hGalF'K', π, C, H, hπ, hsurj, hC_norm, hC_ab, h_mem_H, h_sub_MC, h_sub_K₁⟩

theorem ld_ch15_weil_galois_twisted_bridge (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K E F' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F F'] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLE : L ≤ E) (hEK : E ≤ K)
    (hLF' : L ≤ F') (hF'E : F' ≤ E) (hF'K : F' ≤ K)
    [FiniteDimensional F' (IntermediateField.extendScalars hF'K)]
    [IsGalois F' (IntermediateField.extendScalars hF'K)]
    (π : relWeil F F' →* (IntermediateField.extendScalars hF'K ≃ₐ[F'] IntermediateField.extendScalars hF'K))
    (hπ : ∀ (w : relWeil F F') (x : IntermediateField.extendScalars hF'K),
      ((π w x : IntermediateField.extendScalars hF'K) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    (H : Subgroup (IntermediateField.extendScalars hF'K ≃ₐ[F'] IntermediateField.extendScalars hF'K))
    (h_mem_H : ∀ w : relWeil F F', w ∈ (relWeil F E).subgroupOf (relWeil F F') ↔ π w ∈ H)
    (χL : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ)
    (hχL : IsWeilRep F L (charRep F L χL))
    (hχE : IsWeilRep F E (charRep F E χE))
    (h_rest : restrictWeilChar F hEK χE = restrictWeilChar F hLK χL) :
    let K' := IntermediateField.extendScalars hF'K
    (∀ (M : Subgroup (K' ≃ₐ[F'] K')) (ψ : M →* (Ω F)ˣ),
      ∃ t : MonomialTerm F F',
        t.Wf F F' ∧
        t.field = (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F ∧
        (∃ htK : t.field ≤ K,
          restrictWeilChar F htK t.χ = restrictWeilChar F hLK χL) ∧
        ∀ w : relWeil F F',
          t.trace F F' w =
            (restrictWeilChar F hLF' χL w : Ω F) * indCharTrace F M ψ (π w)) ∧
    ((⟨1, E, hF'E, χE⟩ : MonomialTerm F F').Wf F F' ∧
      ∃ (ψ_H : H →* (Ω F)ˣ),
        ∀ w : relWeil F F',
          (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w =
            (restrictWeilChar F hLF' χL w : Ω F) * indCharTrace F H ψ_H (π w)) :=
by
  intro K'
  let G := (K' ≃ₐ[F'] K')
  let G_F' := relWeil F F'
  let ω : G_F' →* (Ω F)ˣ := restrictWeilChar F hLF' χL
  have h_bridge : ∀ (E₁ : IntermediateField F (AlgebraicClosure F))
      (hF'E₁ : F' ≤ E₁) (hE₁K : E₁ ≤ K) (M : Subgroup G)
      (h_mem : ∀ w : G_F', w ∈ (relWeil F E₁).subgroupOf G_F' ↔ π w ∈ M)
      (ψ : M →* (Ω F)ˣ),
      let ι : relWeil F E₁ →* G_F' := Subgroup.inclusion (relWeil_antitone F hF'E₁)
      let π_E₁ : relWeil F E₁ →* M :=
        { toFun := fun w => ⟨π (ι w), (h_mem (ι w)).mp w.2⟩
          map_one' := Subtype.ext (by simp)
          map_mul' := fun x y => Subtype.ext (by simp) }
      let χ_E₁ : relWeil F E₁ →* (Ω F)ˣ := (ω.comp ι) * (ψ.comp π_E₁)
      (⟨1, E₁, hF'E₁, χ_E₁⟩ : MonomialTerm F F').Wf F F' ∧
      restrictWeilChar F hE₁K χ_E₁ = restrictWeilChar F hLK χL ∧
      ∀ w : G_F',
        (⟨1, E₁, hF'E₁, χ_E₁⟩ : MonomialTerm F F').trace F F' w =
          (ω w : Ω F) * indCharTrace F M ψ (π w) := by
    intro E₁ hF'E₁ hE₁K M h_mem ψ ι π_E₁ χ_E₁
    haveI : FiniteDimensional F E₁ :=
      Module.Finite.of_injective (IntermediateField.inclusion hE₁K).toLinearMap
        (IntermediateField.inclusion hE₁K).injective
    have hSep_E₁ : Algebra.IsSeparable F' (IntermediateField.extendScalars hF'E₁) := by
      refine ⟨fun x => ?_⟩
      let E₁' : IntermediateField F' (AlgebraicClosure F) := IntermediateField.extendScalars hF'E₁
      have hxE₁ : (x : AlgebraicClosure F) ∈ E₁ := (IntermediateField.mem_extendScalars hF'E₁).mp x.2
      let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hF'K).mpr (hE₁K hxE₁)⟩
      have hsep_K : IsSeparable F' x_K := Algebra.IsSeparable.isSeparable F' x_K
      have hmin_E₁ : minpoly F' (x : AlgebraicClosure F) = minpoly F' x :=
        minpoly.algHom_eq E₁'.val E₁'.val.injective x
      have hmin_K : minpoly F' (x_K : AlgebraicClosure F) = minpoly F' x_K :=
        minpoly.algHom_eq K'.val K'.val.injective x_K
      change (minpoly F' x).Separable
      rw [← hmin_E₁]
      change (minpoly F' (x_K : AlgebraicClosure F)).Separable
      rw [hmin_K]
      exact hsep_K
    have hWeil_E₁ : IsWeilRep F E₁ (charRep F E₁ χ_E₁) := by
      refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
      obtain ⟨_, U_L, hU_L, hχL_triv⟩ := hχL
      let U_K : Set (AbsGal F) := (K.fixingSubgroup : Set (AbsGal F))
      have hU_K : U_K ∈ nhds (1 : AbsGal F) :=
        (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U_K).mpr
          ⟨K, inferInstance, Set.Subset.rfl⟩
      refine ⟨U_L ∩ U_K, Filter.inter_mem hU_L hU_K, fun w hwU hwI => ?_⟩
      let w_L : relWeil F L := Subgroup.inclusion (relWeil_antitone F hLF') (ι w)
      have h_rep : charRep F L χL w_L = 1 := hχL_triv w_L hwU.1 hwI
      have h_eval : (charRep F L χL w_L (ULift.up 1)).down =
          ((1 : Module.End (Ω F) (ULift.{u} (Ω F))) (ULift.up 1)).down :=
        congrArg (fun f : Module.End (Ω F) (ULift.{u} (Ω F)) => (f (ULift.up 1)).down) h_rep
      change (χL w_L : Ω F) * 1 = 1 at h_eval
      rw [mul_one] at h_eval
      have hω_w : ω (ι w) = 1 := Units.ext h_eval
      have hπ_w : π (ι w) = 1 := by
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        have h1 := hπ (ι w) x
        change ((π (ι w) x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        have hxK : (x : AlgebraicClosure F) ∈ K := (IntermediateField.mem_extendScalars hF'K).mp x.2
        exact (IntermediateField.mem_fixingSubgroup_iff K (w : AbsGal F)).mp hwU.2 x.1 hxK
      have hπE₁_w : π_E₁ w = 1 := Subtype.ext hπ_w
      have hχ_w : χ_E₁ w = 1 := by
        change ω (ι w) * ψ (π_E₁ w) = 1
        rw [hω_w, hπE₁_w, map_one, mul_one]
      change (χ_E₁ w : Ω F) • LinearMap.id = 1
      rw [hχ_w, Units.val_one, one_smul]
      rfl
    have hWf : (⟨1, E₁, hF'E₁, χ_E₁⟩ : MonomialTerm F F').Wf F F' := ⟨inferInstance, hSep_E₁, hWeil_E₁⟩
    have h_rest_E₁ : restrictWeilChar F hE₁K χ_E₁ = restrictWeilChar F hLK χL := by
      apply MonoidHom.ext
      intro w
      let ι_K : relWeil F K →* relWeil F E₁ := Subgroup.inclusion (relWeil_antitone F hE₁K)
      have hπ_w : π (ι (ι_K w)) = 1 := by
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        have h1 := hπ (ι (ι_K w)) x
        change ((π (ι (ι_K w)) x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        have hxK : (x : AlgebraicClosure F) ∈ K := (IntermediateField.mem_extendScalars hF'K).mp x.2
        exact (IntermediateField.mem_fixingSubgroup_iff K (w : AbsGal F)).mp w.2.2 x.1 hxK
      have hπE₁_w : π_E₁ (ι_K w) = 1 := Subtype.ext hπ_w
      change ω (ι (ι_K w)) * ψ (π_E₁ (ι_K w)) = restrictWeilChar F hLK χL w
      rw [hπE₁_w, map_one, mul_one]
      rfl
    refine ⟨hWf, h_rest_E₁, fun w => ?_⟩
    let H_E₁ : Subgroup G_F' := (relWeil F E₁).subgroupOf G_F'
    let W := ULift.{u} (Ω F)
    let e_sub : H_E₁ ≃* relWeil F E₁ := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hF'E₁)
    let ρ_E₁ : Representation (Ω F) H_E₁ W := (charRep F E₁ χ_E₁).comp e_sub.toMonoidHom
    let s : G ⧸ M → G_F' := fun u₀ => (hsurj (cosetRep u₀)).choose
    have hs_spec : ∀ u₀ : G ⧸ M, π (s u₀) = cosetRep u₀ :=
      fun u₀ => (hsurj (cosetRep u₀)).choose_spec
    let u : G_F' → G ⧸ M := fun x => QuotientGroup.mk (π x)⁻¹
    let r : G_F' → G_F' := fun x => s (u x)
    have h_xr_mem : ∀ x : G_F', x * r x ∈ H_E₁ := by
      intro x
      rw [h_mem]
      change π (x * s (u x)) ∈ M
      rw [map_mul, hs_spec (u x)]
      have hout : QuotientGroup.mk (s := M) (cosetRep (u x)) = QuotientGroup.mk (s := M) (π x)⁻¹ :=
        Quotient.out_eq (u x)
      have hrel : (cosetRep (u x))⁻¹ * (π x)⁻¹ ∈ M := QuotientGroup.eq.mp hout
      have hinv : (π x * cosetRep (u x))⁻¹ ∈ M := by
        have heq : (π x * cosetRep (u x))⁻¹ = (cosetRep (u x))⁻¹ * (π x)⁻¹ := mul_inv_rev _ _
        rw [heq]
        exact hrel
      exact M.inv_mem_iff.mp hinv
    have hu_mul : ∀ (h₀ : H_E₁) (x : G_F'), u ((h₀ : G_F') * x) = u x := by
      intro h₀ x
      change QuotientGroup.mk (s := M) (π ((h₀ : G_F') * x))⁻¹ = QuotientGroup.mk (s := M) (π x)⁻¹
      rw [QuotientGroup.eq]
      have heq : ((π ((h₀ : G_F') * x))⁻¹)⁻¹ * (π x)⁻¹ = π (h₀ : G_F') := by
        rw [inv_inv, map_mul, mul_inv_cancel_right]
      rw [heq]
      exact (h_mem (h₀ : G_F')).mp h₀.2
    have hr_mul : ∀ (h₀ : H_E₁) (x : G_F'), r ((h₀ : G_F') * x) = r x := by
      intro h₀ x
      exact congrArg s (hu_mul h₀ x)
    have hu_rep_inv : ∀ u₀ : G ⧸ M, u (s u₀)⁻¹ = u₀ := by
      intro u₀
      change QuotientGroup.mk (s := M) (π (s u₀)⁻¹)⁻¹ = u₀
      rw [map_inv, inv_inv, hs_spec u₀]
      exact Quotient.out_eq u₀
    have hr_rep_inv : ∀ u₀ : G ⧸ M, r (s u₀)⁻¹ = s u₀ := by
      intro u₀
      exact congrArg s (hu_rep_inv u₀)
    have hu_iff : ∀ u₀ : G ⧸ M,
        u ((s u₀)⁻¹ * w) = u₀ ↔ (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M := by
      intro u₀
      have h1 : u ((s u₀)⁻¹ * w) = QuotientGroup.mk (s := M) (π ((s u₀)⁻¹ * w))⁻¹ := rfl
      have h2 : u₀ = QuotientGroup.mk (s := M) (cosetRep u₀) := (Quotient.out_eq u₀).symm
      rw [h1]
      conv_lhs => rhs; rw [h2]
      rw [QuotientGroup.eq, inv_inv, map_mul, map_inv, hs_spec u₀]
    let Φ : indSpace H_E₁ ρ_E₁ ≃ₗ[Ω F] ((G ⧸ M) → Ω F) :=
      { toFun := fun f u₀ => (f.1 (s u₀)⁻¹).down
        map_add' := fun f₁ f₂ => funext fun u₀ => rfl
        map_smul' := fun c f => funext fun u₀ => rfl
        invFun := fun φ =>
          ⟨fun x => ρ_E₁ ⟨x * r x, h_xr_mem x⟩ (ULift.up (φ (u x))), by
            intro h₀ x
            dsimp only
            rw [hu_mul h₀ x]
            have hsub : (⟨((h₀ : G_F') * x) * r ((h₀ : G_F') * x), h_xr_mem ((h₀ : G_F') * x)⟩ : H_E₁) =
                h₀ * ⟨x * r x, h_xr_mem x⟩ := by
              apply Subtype.ext
              change ((h₀ : G_F') * x) * r ((h₀ : G_F') * x) = (h₀ : G_F') * (x * r x)
              rw [hr_mul h₀ x, mul_assoc]
            rw [hsub, map_mul, Module.End.mul_apply]⟩
        left_inv := fun f => by
          apply Subtype.ext
          funext x
          dsimp only
          have h_eq : f.1 ((x * r x) * (r x)⁻¹) =
              ρ_E₁ ⟨x * r x, h_xr_mem x⟩ (f.1 (r x)⁻¹) :=
            f.2 ⟨x * r x, h_xr_mem x⟩ (r x)⁻¹
          have h_cancel : (x * r x) * (r x)⁻¹ = x := mul_inv_cancel_right x (r x)
          rw [h_cancel] at h_eq
          exact h_eq.symm
        right_inv := fun φ => by
          funext u₀
          dsimp only
          rw [hu_rep_inv u₀]
          have h_one : (⟨(s u₀)⁻¹ * r (s u₀)⁻¹, h_xr_mem (s u₀)⁻¹⟩ : H_E₁) = 1 := by
            apply Subtype.ext
            change (s u₀)⁻¹ * r (s u₀)⁻¹ = 1
            rw [hr_rep_inv u₀, inv_mul_cancel]
          rw [h_one, map_one, Module.End.one_apply] }
    let T : ((G ⧸ M) → Ω F) →ₗ[Ω F] ((G ⧸ M) → Ω F) := Φ.conj (indRep H_E₁ ρ_E₁ w)
    have h_tr_ind : LinearMap.trace (Ω F) (indSpace H_E₁ ρ_E₁) (indRep H_E₁ ρ_E₁ w) =
        ∑ u₀ : G ⧸ M,
          (ω w : Ω F) *
            if hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M then
              (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)
            else 0 := by
      have h_conj : LinearMap.trace (Ω F) (indSpace H_E₁ ρ_E₁) (indRep H_E₁ ρ_E₁ w) =
          LinearMap.trace (Ω F) ((G ⧸ M) → Ω F) T :=
        (LinearMap.trace_conj' (indRep H_E₁ ρ_E₁ w) Φ).symm
      rw [h_conj]
      have h_decomp : T = ∑ u₀ : G ⧸ M,
          (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀).comp
            ((LinearMap.proj u₀).comp T) := by
        apply LinearMap.ext
        intro φ
        funext u₁
        simp [LinearMap.sum_apply, LinearMap.comp_apply]
      rw [h_decomp, map_sum]
      apply Finset.sum_congr rfl
      intro u₀ _
      have h_comm : LinearMap.trace (Ω F) ((G ⧸ M) → Ω F)
          ((LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀).comp
            ((LinearMap.proj u₀).comp T)) =
          LinearMap.trace (Ω F) (Ω F)
            (((LinearMap.proj u₀).comp T).comp
              (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)) :=
        (LinearMap.trace_comp_comm'
          (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)
          ((LinearMap.proj u₀).comp T)).symm
      rw [h_comm]
      let B : Ω F →ₗ[Ω F] Ω F :=
        ((LinearMap.proj u₀).comp T).comp (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)
      change LinearMap.trace (Ω F) (Ω F) B = _
      by_cases hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M
      · rw [dif_pos hc]
        have hu_eq : u ((s u₀)⁻¹ * w) = u₀ := (hu_iff u₀).mpr hc
        have hr_eq : r ((s u₀)⁻¹ * w) = s u₀ := congrArg s hu_eq
        have hB : B = ((ω w : Ω F) * (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)) • LinearMap.id := by
          apply LinearMap.ext
          intro a
          change (ρ_E₁ ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (ULift.up (Pi.single (M := fun _ : G ⧸ M => Ω F) u₀ a (u ((s u₀)⁻¹ * w))))).down =
            ((ω w : Ω F) * (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)) * a
          rw [hu_eq, Pi.single_eq_same]
          have h_ω : ω (ι (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩)) = ω w := by
            change ω (((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w)) = ω w
            rw [hr_eq, map_mul, map_mul, map_inv, mul_comm (ω (s u₀))⁻¹ (ω w), mul_assoc,
              inv_mul_cancel, mul_one]
          have h_πE₁ : π_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) =
              ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ := by
            apply Subtype.ext
            change π (((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w)) = (cosetRep u₀)⁻¹ * π w * cosetRep u₀
            rw [hr_eq, map_mul, map_mul, map_inv, hs_spec u₀]
          change (χ_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) : Ω F) * a = _
          have h_χ : χ_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) =
              ω w * ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ := by
            change ω (ι (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩)) *
              ψ (π_E₁ (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩)) = _
            rw [h_ω, h_πE₁]
          rw [h_χ, Units.val_mul]
        rw [hB, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one, smul_eq_mul, mul_one]
      · rw [dif_neg hc, mul_zero]
        have hu_ne : u ((s u₀)⁻¹ * w) ≠ u₀ := fun h => hc ((hu_iff u₀).mp h)
        have hB : B = 0 := by
          apply LinearMap.ext
          intro a
          change (ρ_E₁ ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (ULift.up (Pi.single (M := fun _ : G ⧸ M => Ω F) u₀ a (u ((s u₀)⁻¹ * w))))).down = 0
          rw [Pi.single_eq_of_ne hu_ne]
          change (ρ_E₁ ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (0 : W)).down = 0
          rw [map_zero]
          rfl
        rw [hB, map_zero]
    let u_G : G → G ⧸ M := fun x => QuotientGroup.mk x⁻¹
    let r_G : G → G := fun x => cosetRep (u_G x)
    have h_xr_G : ∀ x : G, x * r_G x ∈ M := by
      intro x
      have hout : QuotientGroup.mk (s := M) (r_G x) = QuotientGroup.mk (s := M) x⁻¹ :=
        Quotient.out_eq (u_G x)
      have hrel : (r_G x)⁻¹ * x⁻¹ ∈ M := QuotientGroup.eq.mp hout
      have hinv : (x * r_G x)⁻¹ ∈ M := by
        have heq : (x * r_G x)⁻¹ = (r_G x)⁻¹ * x⁻¹ := mul_inv_rev _ _
        rw [heq]
        exact hrel
      exact M.inv_mem_iff.mp hinv
    have hu_mul_G : ∀ (y : M) (x : G), u_G ((y : G) * x) = u_G x := by
      intro y x
      change QuotientGroup.mk (s := M) ((y : G) * x)⁻¹ = QuotientGroup.mk (s := M) x⁻¹
      rw [QuotientGroup.eq]
      have heq : (((y : G) * x)⁻¹)⁻¹ * x⁻¹ = (y : G) := by
        rw [inv_inv, mul_inv_cancel_right]
      rw [heq]
      exact y.2
    have hr_mul_G : ∀ (y : M) (x : G), r_G ((y : G) * x) = r_G x := by
      intro y x
      exact congrArg cosetRep (hu_mul_G y x)
    have hu_rep_G : ∀ u₀ : G ⧸ M, u_G (cosetRep u₀)⁻¹ = u₀ := by
      intro u₀
      change QuotientGroup.mk (s := M) ((cosetRep u₀)⁻¹)⁻¹ = u₀
      rw [inv_inv]
      exact Quotient.out_eq u₀
    have hr_rep_G : ∀ u₀ : G ⧸ M, r_G (cosetRep u₀)⁻¹ = cosetRep u₀ := by
      intro u₀
      exact congrArg cosetRep (hu_rep_G u₀)
    let e_coset : (G ⧸ M) × M ≃ G :=
      { toFun := fun p => (p.2 : G) * (cosetRep p.1)⁻¹
        invFun := fun x => (u_G x, ⟨x * r_G x, h_xr_G x⟩)
        left_inv := fun ⟨u₀, y⟩ => by
          dsimp only
          have hu : u_G ((y : G) * (cosetRep u₀)⁻¹) = u₀ := by
            rw [hu_mul_G y (cosetRep u₀)⁻¹, hu_rep_G u₀]
          have hr : r_G ((y : G) * (cosetRep u₀)⁻¹) = cosetRep u₀ := by
            rw [hr_mul_G y (cosetRep u₀)⁻¹, hr_rep_G u₀]
          ext
          · exact hu
          · dsimp only
            rw [hr, inv_mul_cancel_right]
        right_inv := fun x => by
          dsimp only
          exact mul_inv_cancel_right x (r_G x) }
    have h_indChar : indCharTrace F M ψ (π w) =
        ∑ u₀ : G ⧸ M,
          if hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M then
            (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)
          else 0 := by
      unfold indCharTrace
      set g := π w
      have h_sum_eq : (∑ x : G, if h : x * g * x⁻¹ ∈ M then (ψ ⟨x * g * x⁻¹, h⟩ : Ω F) else 0) =
          ∑ p : (G ⧸ M) × M,
            if h : e_coset p * g * (e_coset p)⁻¹ ∈ M then
              (ψ ⟨e_coset p * g * (e_coset p)⁻¹, h⟩ : Ω F)
            else 0 :=
        (Fintype.sum_equiv e_coset _ _ (fun _ => rfl)).symm
      rw [h_sum_eq, Fintype.sum_prod_type]
      have h_inner : ∀ u₀ : G ⧸ M,
          (∑ y : M,
            if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M then
              (ψ ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : Ω F)
            else 0) =
          (Nat.card M : Ω F) *
            if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ M then
              (ψ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩ : Ω F)
            else 0 := by
        intro u₀
        set c := (cosetRep u₀)⁻¹ * g * cosetRep u₀
        have h_term : ∀ y : M,
            (if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M then
              (ψ ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : Ω F)
            else 0) =
            if hc : c ∈ M then (ψ ⟨c, hc⟩ : Ω F) else 0 := by
          intro y
          have h_conj_y : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ = (y : G) * c * (y : G)⁻¹ := by
            change ((y : G) * (cosetRep u₀)⁻¹) * g * ((y : G) * (cosetRep u₀)⁻¹)⁻¹ =
              (y : G) * ((cosetRep u₀)⁻¹ * g * cosetRep u₀) * (y : G)⁻¹
            group
          have h_mem_iff : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M ↔ c ∈ M := by
            rw [h_conj_y]
            constructor
            · intro h
              have h1 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) ∈ M :=
                M.mul_mem (M.mul_mem (M.inv_mem y.2) h) y.2
              have h2 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) = c := by group
              rw [h2] at h1
              exact h1
            · intro hc
              exact M.mul_mem (M.mul_mem y.2 hc) (M.inv_mem y.2)
          by_cases hc : c ∈ M
          · have hyc : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M := h_mem_iff.mpr hc
            rw [dif_pos hyc, dif_pos hc]
            have h_sub_eq : (⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, hyc⟩ : M) =
                y * ⟨c, hc⟩ * y⁻¹ := by
              apply Subtype.ext
              exact h_conj_y
            rw [h_sub_eq, map_mul, map_mul, map_inv, mul_comm (ψ y), mul_inv_cancel_right]
          · have hyc : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∉ M :=
              fun h => hc (h_mem_iff.mp h)
            rw [dif_neg hyc, dif_neg hc]
        simp_rw [h_term]
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
      simp_rw [h_inner, ← Finset.mul_sum]
      have hM_ne : (Nat.card M : Ω F) ≠ 0 := by
        exact_mod_cast (Nat.card_pos (α := M)).ne'
      exact inv_mul_cancel_left₀ hM_ne _
    change (1 : ℤ) • LinearMap.trace (Ω F) (indSpace H_E₁ ρ_E₁) (indRep H_E₁ ρ_E₁ w) =
      (ω w : Ω F) * indCharTrace F M ψ (π w)
    rw [one_smul, h_tr_ind, ← Finset.mul_sum, h_indChar]
  refine ⟨?_, ?_⟩
  · intro M ψ
    let E₀ : IntermediateField F' K' := IntermediateField.fixedField M
    let E_F' : IntermediateField F' (AlgebraicClosure F) := IntermediateField.lift E₀
    let E_M : IntermediateField F (AlgebraicClosure F) := E_F'.restrictScalars F
    have hF'E_M : F' ≤ E_M := by
      intro z hz
      exact (IntermediateField.mem_restrictScalars F).mpr (E_F'.algebraMap_mem ⟨z, hz⟩)
    have hE_MK : E_M ≤ K := by
      intro z hz
      have hzF' : z ∈ E_F' := (IntermediateField.mem_restrictScalars F).mp hz
      have hzK' : z ∈ K' := IntermediateField.lift_le E₀ hzF'
      exact (IntermediateField.mem_extendScalars hF'K).mp hzK'
    have h_fix : E₀.fixingSubgroup = M := IntermediateField.fixingSubgroup_fixedField M
    have h_mem_M : ∀ w : G_F', w ∈ (relWeil F E_M).subgroupOf G_F' ↔ π w ∈ M := by
      intro w
      change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ E_M.fixingSubgroup) ↔ π w ∈ M
      have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
      rw [and_iff_right hw_weil, ← h_fix, IntermediateField.mem_fixingSubgroup_iff,
        IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hw x hx
        apply Subtype.ext
        have h1 := hπ w x
        change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        have hxF' : (x : AlgebraicClosure F) ∈ E_F' := (IntermediateField.mem_lift x).mpr hx
        have hxE : (x : AlgebraicClosure F) ∈ E_M :=
          (IntermediateField.mem_restrictScalars F).mpr hxF'
        exact hw x.1 hxE
      · intro hπw z hzE
        have hzF' : z ∈ E_F' := (IntermediateField.mem_restrictScalars F).mp hzE
        have hzK' : z ∈ K' := IntermediateField.lift_le E₀ hzF'
        let x : K' := ⟨z, hzK'⟩
        have hxE₀ : x ∈ E₀ := (IntermediateField.mem_lift x).mp hzF'
        have h1 := hπ w x
        change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) z at h1
        have h2 : π w x = x := hπw x hxE₀
        rw [h2] at h1
        exact h1.symm
    obtain ⟨hWf, h_rest_M, htr⟩ := h_bridge E_M hF'E_M hE_MK M h_mem_M ψ
    exact ⟨⟨1, E_M, hF'E_M, _⟩, hWf, rfl, ⟨hE_MK, h_rest_M⟩, htr⟩
  · let ι_E : relWeil F E →* G_F' := Subgroup.inclusion (relWeil_antitone F hF'E)
    let π_E : relWeil F E →* H :=
      { toFun := fun w => ⟨π (ι_E w), (h_mem_H (ι_E w)).mp w.2⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun x y => Subtype.ext (by simp) }
    have hsurj_E : Function.Surjective π_E := by
      intro h
      obtain ⟨w, hw⟩ := hsurj (h : G)
      have hw_H : π w ∈ H := by
        rw [hw]
        exact h.2
      have hw_E : w ∈ (relWeil F E).subgroupOf G_F' := (h_mem_H w).mpr hw_H
      let w_E : relWeil F E := ⟨w.1, hw_E⟩
      have hι_w : ι_E w_E = w := Subtype.ext rfl
      refine ⟨w_E, Subtype.ext ?_⟩
      change π (ι_E w_E) = (h : G)
      rw [hι_w, hw]
    let θ_E : relWeil F E →* (Ω F)ˣ := χE * (ω.comp ι_E)⁻¹
    have hker_E : ∀ w : relWeil F E, π_E w = 1 → θ_E w = 1 := by
      intro w hπ_w
      have hπ_val : π (ι_E w) = 1 := congrArg Subtype.val hπ_w
      have hw_K : (w : AbsGal F) ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro z hz
        let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr hz⟩
        have h1 := hπ (ι_E w) x
        change ((π (ι_E w) x : K') : AlgebraicClosure F) = (w : AbsGal F) z at h1
        rw [hπ_val] at h1
        exact h1.symm
      let w_K : relWeil F K := ⟨w.1, w.2.1, hw_K⟩
      have h_eq : χE w = ω (ι_E w) := by
        have h_rest_w : restrictWeilChar F hEK χE w_K = restrictWeilChar F hLK χL w_K :=
          congr_fun (congr_arg DFunLike.coe h_rest) w_K
        exact h_rest_w
      change χE w * (ω (ι_E w))⁻¹ = 1
      rw [h_eq, mul_inv_cancel]
    let s_H : H → relWeil F E := fun h => (hsurj_E h).choose
    have hs_H : ∀ h : H, π_E (s_H h) = h := fun h => (hsurj_E h).choose_spec
    have hθ_sec : ∀ w : relWeil F E, θ_E (s_H (π_E w)) = θ_E w := by
      intro w
      have hker : π_E ((s_H (π_E w))⁻¹ * w) = 1 := by
        apply mul_left_cancel (a := π_E (s_H (π_E w)))
        calc π_E (s_H (π_E w)) * π_E ((s_H (π_E w))⁻¹ * w)
            = π_E (s_H (π_E w) * ((s_H (π_E w))⁻¹ * w)) := (map_mul π_E _ _).symm
          _ = π_E w := by rw [mul_inv_cancel_left]
          _ = π_E (s_H (π_E w)) := (hs_H (π_E w)).symm
          _ = π_E (s_H (π_E w)) * 1 := (mul_one _).symm
      have h1 : θ_E ((s_H (π_E w))⁻¹ * w) = 1 := hker_E _ hker
      calc θ_E (s_H (π_E w)) = θ_E (s_H (π_E w)) * 1 := (mul_one _).symm
        _ = θ_E (s_H (π_E w)) * θ_E ((s_H (π_E w))⁻¹ * w) := by rw [h1]
        _ = θ_E (s_H (π_E w) * ((s_H (π_E w))⁻¹ * w)) := (map_mul θ_E _ _).symm
        _ = θ_E w := by rw [mul_inv_cancel_left]
    let ψ_H : H →* (Ω F)ˣ :=
      { toFun := fun h => θ_E (s_H h)
        map_one' := by
          calc θ_E (s_H 1) = θ_E (s_H (π_E 1)) := by rw [map_one]
            _ = θ_E 1 := hθ_sec 1
            _ = 1 := map_one θ_E
        map_mul' := fun h₁ h₂ => by
          calc θ_E (s_H (h₁ * h₂)) = θ_E (s_H (π_E (s_H h₁ * s_H h₂))) := by
                rw [map_mul, hs_H h₁, hs_H h₂]
            _ = θ_E (s_H h₁ * s_H h₂) := hθ_sec (s_H h₁ * s_H h₂)
            _ = θ_E (s_H h₁) * θ_E (s_H h₂) := map_mul θ_E _ _ }
    have hχE_eq : (ω.comp ι_E) * (ψ_H.comp π_E) = χE := by
      apply MonoidHom.ext
      intro w
      change ω (ι_E w) * θ_E (s_H (π_E w)) = χE w
      rw [hθ_sec w]
      change ω (ι_E w) * (χE w * (ω (ι_E w))⁻¹) = χE w
      rw [mul_comm (ω (ι_E w)), inv_mul_cancel_right]
    obtain ⟨hWf_E, _, htr_E⟩ := h_bridge E hF'E hEK H h_mem_H ψ_H
    rw [hχE_eq] at hWf_E htr_E
    exact ⟨hWf_E, ψ_H, htr_E⟩

theorem ld_ch15_prod_subgroup_pushforward (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (H : Subgroup G) (ψ_H : H →* (Ω F)ˣ) :
    ∃ (M : Subgroup G) (_ : (C.subgroupOf M).Normal) (ψ_H' : H.subgroupOf M →* (Ω F)ˣ),
      (∀ a ∈ C.subgroupOf M, ∀ b ∈ C.subgroupOf M, a * b = b * a) ∧
      (∀ m : M, ∃ h ∈ H.subgroupOf M, ∃ c ∈ C.subgroupOf M, m = h * c) ∧
      ∀ (L_M : List (Σ (K : Subgroup M), (K →* (Ω F)ˣ))),
        (∀ p ∈ L_M, C.subgroupOf M ≤ p.1) →
        (∀ p ∈ L_M, ∀ h ∈ H.subgroupOf M, (∀ c ∈ C.subgroupOf M, h * c = c * h) → h ∈ p.1) →
        (∀ m : M,
          indCharTrace F (H.subgroupOf M) ψ_H' m =
            (L_M.map fun p => indCharTrace F p.1 p.2 m).sum) →
        ∃ (L_G : List (Σ (K : Subgroup G), (K →* (Ω F)ˣ))),
          (∀ p ∈ L_G, C ≤ p.1) ∧
          (∀ p ∈ L_G, ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ p.1) ∧
          ∀ g : G,
            indCharTrace F H ψ_H g =
              (L_G.map fun p => indCharTrace F p.1 p.2 g).sum :=
by
  let hC_norm : C.Normal := inferInstance
  let M : Subgroup G :=
    { carrier := {g : G | ∃ h ∈ H, ∃ c ∈ C, g = h * c}
      one_mem' := ⟨1, H.one_mem, 1, C.one_mem, (mul_one 1).symm⟩
      mul_mem' := by
        rintro g₁ g₂ ⟨h₁, hh₁, c₁, hc₁, rfl⟩ ⟨h₂, hh₂, c₂, hc₂, rfl⟩
        refine ⟨h₁ * h₂, H.mul_mem hh₁ hh₂, (h₂⁻¹ * c₁ * (h₂⁻¹)⁻¹) * c₂,
          C.mul_mem (hC_norm.conj_mem c₁ hc₁ h₂⁻¹) hc₂, ?_⟩
        group
      inv_mem' := by
        rintro g ⟨h, hh, c, hc, rfl⟩
        refine ⟨h⁻¹, H.inv_mem hh, h * c⁻¹ * h⁻¹,
          hC_norm.conj_mem c⁻¹ (C.inv_mem hc) h, ?_⟩
        group }
  have hHM : H ≤ M := fun h hh => ⟨h, hh, 1, C.one_mem, (mul_one h).symm⟩
  have hCM : C ≤ M := fun c hc => ⟨1, H.one_mem, c, hc, (one_mul c).symm⟩
  let incH : H.subgroupOf M →* H :=
    { toFun := fun x => ⟨x.1.1, x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  let ψ_H' : H.subgroupOf M →* (Ω F)ˣ := ψ_H.comp incH
  refine ⟨M, inferInstance, ψ_H', ?_, ?_, ?_⟩
  · intro a ha b hb
    exact Subtype.ext (hC_ab a.1 ha b.1 hb)
  · intro m
    rcases m.2 with ⟨h, hh, c, hc, hm_eq⟩
    refine ⟨⟨h, hHM hh⟩, hh, ⟨c, hCM hc⟩, hc, Subtype.ext hm_eq⟩
  · intro L_M hL_M_le hL_M_cent hL_M_sum
    let liftSub (K : Subgroup M) : Subgroup G := Subgroup.map M.subtype K
    let liftChar (K : Subgroup M) (ψ : K →* (Ω F)ˣ) : liftSub K →* (Ω F)ˣ :=
      ψ.comp (Subgroup.equivMapOfInjective K M.subtype M.subtype_injective).symm.toMonoidHom
    have h_lift_le : ∀ (K : Subgroup M), C.subgroupOf M ≤ K → C ≤ liftSub K := by
      intro K hCK c hc
      have hc_sub : (⟨c, hCM hc⟩ : M) ∈ C.subgroupOf M := hc
      exact Subgroup.mem_map.mpr ⟨⟨c, hCM hc⟩, hCK hc_sub, rfl⟩
    have h_lift_cent : ∀ (K : Subgroup M),
        (∀ h' ∈ H.subgroupOf M, (∀ c' ∈ C.subgroupOf M, h' * c' = c' * h') → h' ∈ K) →
        ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ liftSub K := by
      intro K hK_cent h hh h_comm
      let h' : M := ⟨h, hHM hh⟩
      have hh'_H : h' ∈ H.subgroupOf M := hh
      have hh'_comm : ∀ c' ∈ C.subgroupOf M, h' * c' = c' * h' := by
        intro c' hc'
        exact Subtype.ext (h_comm c'.1 hc')
      exact Subgroup.mem_map.mpr ⟨h', hK_cent h' hh'_H hh'_comm, rfl⟩
    have h_push_one : ∀ (K : Subgroup M) (ψ : K →* (Ω F)ˣ) (g : G),
        (Nat.card M : Ω F)⁻¹ *
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
            else 0) =
        indCharTrace F (liftSub K) (liftChar K ψ) g := by
      intro K ψ g
      let K' : Subgroup G := liftSub K
      let e₀ := Subgroup.equivMapOfInjective K M.subtype M.subtype_injective
      let e := e₀.symm
      let ψ' : K' →* (Ω F)ˣ := liftChar K ψ
      let B : G → Ω F := fun z =>
        if hz' : z * g * z⁻¹ ∈ K' then
          (ψ' ⟨z * g * z⁻¹, hz'⟩ : Ω F)
        else 0
      have h_conj_G : ∀ (x : G) (y : M),
          ((y : G) * x) * g * ((y : G) * x)⁻¹ = (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ := by
        intro x y
        group
      have h_term : ∀ (x : G) (y : M),
          (if hx : x * g * x⁻¹ ∈ M then
            if hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ K then
              (ψ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ : Ω F)
            else 0
          else 0) = B ((y : G) * x) := by
        intro x y
        dsimp only [B]
        by_cases hz' : ((y : G) * x) * g * ((y : G) * x)⁻¹ ∈ K'
        · have hz_M : ((y : G) * x) * g * ((y : G) * x)⁻¹ ∈ M :=
            Subgroup.map_subtype_le K hz'
          have hx : x * g * x⁻¹ ∈ M := by
            have h_eq : x * g * x⁻¹ = (y : G)⁻¹ * (((y : G) * x) * g * ((y : G) * x)⁻¹) * (y : G) := by
              group
            rw [h_eq]
            exact M.mul_mem (M.mul_mem (M.inv_mem y.2) hz_M) y.2
          have hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ K := by
            rcases Subgroup.mem_map.mp hz' with ⟨u, hu, hu_eq⟩
            have hu_sub : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ = u := by
              ext
              change (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ = (u : G)
              rw [← h_conj_G x y]
              exact hu_eq.symm
            exact hu_sub.symm ▸ hu
          have he_eq : e ⟨((y : G) * x) * g * ((y : G) * x)⁻¹, hz'⟩ =
              ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ := by
            apply (MulEquiv.symm_apply_eq e₀).mpr
            ext
            change ((y : G) * x) * g * ((y : G) * x)⁻¹ = (y : G) * (x * g * x⁻¹) * (y : G)⁻¹
            exact h_conj_G x y
          rw [dif_pos hx, dif_pos hy, dif_pos hz']
          change (ψ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ : Ω F) =
            (ψ (e ⟨((y : G) * x) * g * ((y : G) * x)⁻¹, hz'⟩) : Ω F)
          rw [he_eq]
        · rw [dif_neg hz']
          split_ifs with hx hy
          · exfalso
            apply hz'
            rw [Subgroup.mem_map]
            refine ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy, ?_⟩
            change (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ = ((y : G) * x) * g * ((y : G) * x)⁻¹
            exact (h_conj_G x y).symm
          · rfl
          · rfl
      have h_summand : ∀ x : G,
          (if hx : x * g * x⁻¹ ∈ M then
            indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
          else 0) =
          (Nat.card K : Ω F)⁻¹ * ∑ y : M, B ((y : G) * x) := by
        intro x
        have h_sum_y : (∑ y : M, B ((y : G) * x)) =
            ∑ y : M,
              (if hx : x * g * x⁻¹ ∈ M then
                if hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ K then
                  (ψ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ : Ω F)
                else 0
              else 0) :=
          Finset.sum_congr rfl fun y _ => (h_term x y).symm
        rw [h_sum_y]
        by_cases hx : x * g * x⁻¹ ∈ M
        · rw [dif_pos hx]
          unfold indCharTrace
          congr 1
          refine Finset.sum_congr rfl fun y _ => ?_
          rw [dif_pos hx]
        · rw [dif_neg hx]
          have h0 : (∑ y : M,
              if hx' : x * g * x⁻¹ ∈ M then
                if hy : y * ⟨x * g * x⁻¹, hx'⟩ * y⁻¹ ∈ K then
                  (ψ ⟨y * ⟨x * g * x⁻¹, hx'⟩ * y⁻¹, hy⟩ : Ω F)
                else 0
              else 0) = 0 := by
            refine Finset.sum_eq_zero fun y _ => ?_
            rw [dif_neg hx]
          rw [h0, mul_zero]
      have h_shift : ∀ y : M, (∑ x : G, B ((y : G) * x)) = ∑ z : G, B z := by
        intro y
        exact Fintype.sum_equiv (Equiv.mulLeft (y : G)) (fun x => B ((y : G) * x)) B (fun x => rfl)
      have h_card_K' : Nat.card K' = Nat.card K := Subgroup.card_subtype M K
      have h_card_M_pos : 0 < Nat.card M := Nat.card_pos
      have h_card_M_ne : (Nat.card M : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_M_pos.ne'
      have h_lhs : (∑ x : G,
          if hx : x * g * x⁻¹ ∈ M then
            indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
          else 0) =
        (Nat.card K : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z) := by
        calc (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
            else 0)
          _ = ∑ x : G, ((Nat.card K : Ω F)⁻¹ * ∑ y : M, B ((y : G) * x)) :=
            Finset.sum_congr rfl fun x _ => h_summand x
          _ = (Nat.card K : Ω F)⁻¹ * ∑ x : G, ∑ y : M, B ((y : G) * x) := by
            rw [← Finset.mul_sum]
          _ = (Nat.card K : Ω F)⁻¹ * ∑ y : M, ∑ x : G, B ((y : G) * x) := by
            rw [Finset.sum_comm]
          _ = (Nat.card K : Ω F)⁻¹ * ∑ _y : M, ∑ z : G, B z := by
            congr 1
            refine Finset.sum_congr rfl fun y _ => h_shift y
          _ = (Nat.card K : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
      rw [h_lhs, ← h_card_K']
      change (Nat.card M : Ω F)⁻¹ * ((Nat.card K' : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z)) =
        (Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z
      calc (Nat.card M : Ω F)⁻¹ * ((Nat.card K' : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z))
        _ = ((Nat.card M : Ω F)⁻¹ * (Nat.card M : Ω F)) * ((Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z) := by
          ring
        _ = 1 * ((Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z) := by
          rw [inv_mul_cancel₀ h_card_M_ne]
        _ = (Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z := one_mul _
    have h_push_H : ∀ g : G,
        indCharTrace F H ψ_H g =
          (Nat.card M : Ω F)⁻¹ *
            ∑ x : G,
              if hx : x * g * x⁻¹ ∈ M then
                indCharTrace F (H.subgroupOf M) ψ_H' ⟨x * g * x⁻¹, hx⟩
              else 0 := by
      intro g
      rw [h_push_one (H.subgroupOf M) ψ_H' g]
      have h_map_H : liftSub (H.subgroupOf M) = H := Subgroup.map_subgroupOf_eq_of_le hHM
      unfold indCharTrace
      have h_card : Nat.card (liftSub (H.subgroupOf M)) = Nat.card H := by
        rw [h_map_H]
      rw [h_card]
      congr 1
      refine Finset.sum_congr rfl fun z _ => ?_
      have h_iff : z * g * z⁻¹ ∈ H ↔ z * g * z⁻¹ ∈ liftSub (H.subgroupOf M) := by
        rw [h_map_H]
      by_cases hzH : z * g * z⁻¹ ∈ H
      · have hzL : z * g * z⁻¹ ∈ liftSub (H.subgroupOf M) := h_iff.mp hzH
        rw [dif_pos hzH, dif_pos hzL]
        let e₀ := Subgroup.equivMapOfInjective (H.subgroupOf M) M.subtype M.subtype_injective
        have h_val : ((e₀.symm ⟨z * g * z⁻¹, hzL⟩ : H.subgroupOf M).1 : G) = z * g * z⁻¹ :=
          congr_arg Subtype.val (MulEquiv.apply_symm_apply e₀ ⟨z * g * z⁻¹, hzL⟩)
        have h_inc : incH (e₀.symm ⟨z * g * z⁻¹, hzL⟩) = ⟨z * g * z⁻¹, hzH⟩ :=
          Subtype.ext h_val
        change (ψ_H ⟨z * g * z⁻¹, hzH⟩ : Ω F) =
          (ψ_H (incH (e₀.symm ⟨z * g * z⁻¹, hzL⟩)) : Ω F)
        rw [h_inc]
      · have hzL : z * g * z⁻¹ ∉ liftSub (H.subgroupOf M) := fun h => hzH (h_iff.mpr h)
        rw [dif_neg hzH, dif_neg hzL]
    let liftPair : (Σ (K : Subgroup M), (K →* (Ω F)ˣ)) → (Σ (K : Subgroup G), (K →* (Ω F)ˣ)) :=
      fun p => ⟨liftSub p.1, liftChar p.1 p.2⟩
    have h_list_push : ∀ (L : List (Σ (K : Subgroup M), (K →* (Ω F)ˣ))) (g : G),
        (Nat.card M : Ω F)⁻¹ *
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              (L.map fun p => indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩).sum
            else 0) =
        ((L.map liftPair).map fun q => indCharTrace F q.1 q.2 g).sum := by
      intro L
      induction L with
      | nil =>
        intro g
        simp
      | cons p tl ih =>
        intro g
        simp only [List.map_cons, List.sum_cons]
        have h_sum_add : (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩ +
                (tl.map fun q => indCharTrace F q.1 q.2 ⟨x * g * x⁻¹, hx⟩).sum
            else 0) =
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩
            else 0) +
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              (tl.map fun q => indCharTrace F q.1 q.2 ⟨x * g * x⁻¹, hx⟩).sum
            else 0) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun x _ => ?_
          split_ifs <;> simp
        rw [h_sum_add, mul_add, h_push_one p.1 p.2 g, ih g]
    refine ⟨L_M.map liftPair, ?_, ?_, ?_⟩
    · intro q hq
      rcases List.mem_map.mp hq with ⟨p, hp, rfl⟩
      exact h_lift_le p.1 (hL_M_le p hp)
    · intro q hq
      rcases List.mem_map.mp hq with ⟨p, hp, rfl⟩
      exact h_lift_cent p.1 (hL_M_cent p hp)
    · intro g
      rw [h_push_H g]
      have h_sum_eq : (∑ x : G,
          if hx : x * g * x⁻¹ ∈ M then
            indCharTrace F (H.subgroupOf M) ψ_H' ⟨x * g * x⁻¹, hx⟩
          else 0) =
        ∑ x : G,
          if hx : x * g * x⁻¹ ∈ M then
            (L_M.map fun p => indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩).sum
          else 0 := by
        refine Finset.sum_congr rfl fun x _ => ?_
        split_ifs with hx
        · exact hL_M_sum ⟨x * g * x⁻¹, hx⟩
        · rfl
      rw [h_sum_eq, h_list_push L_M g]

theorem ld_ch15_rightEquivTransRep_trace_and_quot_add (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G] :
    (∀ (H : Subgroup G) (ψ_H : H →* (Ω F)ˣ) (g : G),
      LinearMap.trace (Ω F) (leftEquivSpace F H ψ_H) (rightEquivTransRep F H ψ_H g) =
        indCharTrace F H ψ_H g) ∧
    (∀ {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q]
      (σ : Representation (Ω F) G Q) (W : Submodule (Ω F) Q)
      (hW : ∀ g : G, W ≤ Submodule.comap (σ g) W) (g : G),
      LinearMap.trace (Ω F) Q (σ g) =
        LinearMap.trace (Ω F) W (subRep σ W hW g) +
          LinearMap.trace (Ω F) (Q ⧸ W) (quotRep σ W hW g)) :=
by
  refine ⟨?_, ?_⟩
  · intro H ψ_H g
    let u_of : G → G ⧸ H := fun x => QuotientGroup.mk x⁻¹
    let r_of : G → G := fun x => cosetRep (u_of x)
    have h_xr_mem : ∀ x : G, x * r_of x ∈ H := by
      intro x
      have hout : (QuotientGroup.mk (r_of x) : G ⧸ H) = u_of x := Quotient.out_eq (u_of x)
      have hrel : (r_of x)⁻¹ * x⁻¹ ∈ H := QuotientGroup.eq.mp hout
      have hinv : (x * r_of x)⁻¹ ∈ H := by
        rw [mul_inv_rev]
        exact hrel
      exact (Subgroup.inv_mem_iff H).mp hinv
    have hu_mul : ∀ (h : H) (x : G), u_of ((h : G) * x) = u_of x := by
      intro h x
      apply QuotientGroup.eq.mpr
      rw [inv_inv, mul_inv_cancel_right]
      exact h.2
    have hr_mul : ∀ (h : H) (x : G), r_of ((h : G) * x) = r_of x := by
      intro h x
      dsimp only [r_of]
      rw [hu_mul h x]
    have hu_rep_inv : ∀ u : G ⧸ H, u_of (cosetRep u)⁻¹ = u := by
      intro u
      dsimp only [u_of]
      rw [inv_inv]
      exact Quotient.out_eq u
    have hr_rep_inv : ∀ u : G ⧸ H, r_of (cosetRep u)⁻¹ = cosetRep u := by
      intro u
      dsimp only [r_of]
      rw [hu_rep_inv u]
    let Φ : leftEquivSpace F H ψ_H ≃ₗ[Ω F] ((G ⧸ H) → Ω F) :=
      { toFun := fun φ u => φ.1 (cosetRep u)⁻¹
        invFun := fun α =>
          ⟨fun x => (ψ_H ⟨x * r_of x, h_xr_mem x⟩ : Ω F) * α (u_of x),
           fun h x => by
             change (ψ_H ⟨((h : G) * x) * r_of ((h : G) * x), h_xr_mem ((h : G) * x)⟩ : Ω F) *
                 α (u_of ((h : G) * x)) =
               (ψ_H h : Ω F) * ((ψ_H ⟨x * r_of x, h_xr_mem x⟩ : Ω F) * α (u_of x))
             have h_sub : (⟨((h : G) * x) * r_of ((h : G) * x), h_xr_mem ((h : G) * x)⟩ : H) =
                 h * ⟨x * r_of x, h_xr_mem x⟩ := by
               apply Subtype.ext
               change ((h : G) * x) * r_of ((h : G) * x) = (h : G) * (x * r_of x)
               rw [hr_mul h x, mul_assoc]
             rw [h_sub, map_mul, Units.val_mul, hu_mul h x, mul_assoc]⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        left_inv := fun φ => by
          apply Subtype.ext
          funext x
          change (ψ_H ⟨x * r_of x, h_xr_mem x⟩ : Ω F) * φ.1 (r_of x)⁻¹ = φ.1 x
          have h_equiv := φ.2 ⟨x * r_of x, h_xr_mem x⟩ (r_of x)⁻¹
          change φ.1 ((x * r_of x) * (r_of x)⁻¹) =
            (ψ_H ⟨x * r_of x, h_xr_mem x⟩ : Ω F) * φ.1 (r_of x)⁻¹ at h_equiv
          rw [mul_inv_cancel_right] at h_equiv
          exact h_equiv.symm
        right_inv := fun α => by
          funext u
          change (ψ_H ⟨(cosetRep u)⁻¹ * r_of (cosetRep u)⁻¹, h_xr_mem (cosetRep u)⁻¹⟩ : Ω F) *
              α (u_of (cosetRep u)⁻¹) = α u
          have h_one : (⟨(cosetRep u)⁻¹ * r_of (cosetRep u)⁻¹, h_xr_mem (cosetRep u)⁻¹⟩ : H) = 1 := by
            apply Subtype.ext
            change (cosetRep u)⁻¹ * r_of (cosetRep u)⁻¹ = 1
            rw [hr_rep_inv u, inv_mul_cancel]
          rw [h_one, map_one, Units.val_one, one_mul, hu_rep_inv u] }
    have h_coset_trace :
        LinearMap.trace (Ω F) (leftEquivSpace F H ψ_H) (rightEquivTransRep F H ψ_H g) =
          ∑ u : G ⧸ H,
            if hm : (cosetRep u)⁻¹ * g * cosetRep u ∈ H then
              (ψ_H ⟨(cosetRep u)⁻¹ * g * cosetRep u, hm⟩ : Ω F)
            else 0 := by
      let T : ((G ⧸ H) → Ω F) →ₗ[Ω F] ((G ⧸ H) → Ω F) := Φ.conj (rightEquivTransRep F H ψ_H g)
      have htr_conj :
          LinearMap.trace (Ω F) (leftEquivSpace F H ψ_H) (rightEquivTransRep F H ψ_H g) =
            LinearMap.trace (Ω F) ((G ⧸ H) → Ω F) T :=
        (LinearMap.trace_conj' (rightEquivTransRep F H ψ_H g) Φ).symm
      have hT_sum : T = ∑ u : G ⧸ H,
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) ∘ₗ
            LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u := by
        apply LinearMap.ext
        intro α
        have hα : (∑ u : G ⧸ H, LinearMap.single (Ω F) (fun _ => Ω F) u (α u)) = α := by
          ext u₁
          simpa [LinearMap.single_apply] using
            congr_fun (Finset.univ_sum_single α) u₁
        calc T α = T (∑ u : G ⧸ H, LinearMap.single (Ω F) (fun _ => Ω F) u (α u)) := by rw [hα]
          _ = ∑ u : G ⧸ H, T (LinearMap.single (Ω F) (fun _ => Ω F) u (α u)) := map_sum T _ _
          _ = (∑ u : G ⧸ H,
                (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) ∘ₗ
                  LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u) α := by
            rw [LinearMap.sum_apply]
            rfl
      rw [htr_conj, hT_sum, map_sum]
      apply Finset.sum_congr rfl
      intro u _
      rw [LinearMap.trace_comp_comm']
      have hu_iff : u_of ((cosetRep u)⁻¹ * g) = u ↔ (cosetRep u)⁻¹ * g * cosetRep u ∈ H := by
        have hout : (QuotientGroup.mk (cosetRep u) : G ⧸ H) = u := Quotient.out_eq u
        calc u_of ((cosetRep u)⁻¹ * g) = u
            ↔ QuotientGroup.mk (((cosetRep u)⁻¹ * g)⁻¹) = QuotientGroup.mk (cosetRep u) := by
              dsimp only [u_of]
              rw [hout]
          _ ↔ (cosetRep u)⁻¹ * g * cosetRep u ∈ H := by
              rw [QuotientGroup.eq, inv_inv]
      by_cases hm : (cosetRep u)⁻¹ * g * cosetRep u ∈ H
      · rw [dif_pos hm]
        have hu_eq : u_of ((cosetRep u)⁻¹ * g) = u := hu_iff.mpr hm
        have hr_eq : r_of ((cosetRep u)⁻¹ * g) = cosetRep u := by
          dsimp only [r_of]
          rw [hu_eq]
        have h_comp :
            LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u ∘ₗ
              (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) =
            (ψ_H ⟨(cosetRep u)⁻¹ * g * cosetRep u, hm⟩ : Ω F) • LinearMap.id := by
          apply LinearMap.ext
          intro c
          change (ψ_H ⟨((cosetRep u)⁻¹ * g) * r_of ((cosetRep u)⁻¹ * g),
              h_xr_mem ((cosetRep u)⁻¹ * g)⟩ : Ω F) *
            (LinearMap.single (Ω F) (fun _ => Ω F) u c) (u_of ((cosetRep u)⁻¹ * g)) =
            (ψ_H ⟨(cosetRep u)⁻¹ * g * cosetRep u, hm⟩ : Ω F) * c
          have h_sub_u :
              (⟨((cosetRep u)⁻¹ * g) * r_of ((cosetRep u)⁻¹ * g),
                h_xr_mem ((cosetRep u)⁻¹ * g)⟩ : H) =
              ⟨(cosetRep u)⁻¹ * g * cosetRep u, hm⟩ := by
            apply Subtype.ext
            change ((cosetRep u)⁻¹ * g) * r_of ((cosetRep u)⁻¹ * g) =
              (cosetRep u)⁻¹ * g * cosetRep u
            rw [hr_eq]
          rw [h_sub_u, LinearMap.single_apply, hu_eq, Pi.single_eq_same]
        rw [h_comp, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one,
          smul_eq_mul, mul_one]
      · rw [dif_neg hm]
        have hu_ne : u_of ((cosetRep u)⁻¹ * g) ≠ u := fun h_eq => hm (hu_iff.mp h_eq)
        have h_comp :
            LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u ∘ₗ
              (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) = 0 := by
          apply LinearMap.ext
          intro c
          change (ψ_H ⟨((cosetRep u)⁻¹ * g) * r_of ((cosetRep u)⁻¹ * g),
              h_xr_mem ((cosetRep u)⁻¹ * g)⟩ : Ω F) *
            (LinearMap.single (Ω F) (fun _ => Ω F) u c) (u_of ((cosetRep u)⁻¹ * g)) = 0
          rw [LinearMap.single_apply, Pi.single_eq_of_ne hu_ne, mul_zero]
        rw [h_comp, map_zero]
    rw [h_coset_trace]
    unfold indCharTrace
    let e_prod : (G ⧸ H) × H ≃ G :=
      { toFun := fun p => (p.2 : G) * (cosetRep p.1)⁻¹
        invFun := fun x => (u_of x, ⟨x * r_of x, h_xr_mem x⟩)
        left_inv := fun ⟨u₀, z⟩ => by
          dsimp only
          have hu1 : u_of ((z : G) * (cosetRep u₀)⁻¹) = u₀ := by
            rw [hu_mul z (cosetRep u₀)⁻¹, hu_rep_inv u₀]
          have hr1 : r_of ((z : G) * (cosetRep u₀)⁻¹) = cosetRep u₀ := by
            dsimp only [r_of]
            rw [hu1]
          ext
          · exact hu1
          · change ((z : G) * (cosetRep u₀)⁻¹) * r_of ((z : G) * (cosetRep u₀)⁻¹) = z.1
            rw [hr1, inv_mul_cancel_right]
        right_inv := fun x => by
          dsimp only [r_of]
          exact mul_inv_cancel_right x (r_of x) }
    have h_term_inv : ∀ (u₀ : G ⧸ H) (z : H),
        (if hx : e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹ ∈ H then
          (ψ_H ⟨e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹, hx⟩ : Ω F)
        else 0) =
        (if hm : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then
          (ψ_H ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hm⟩ : Ω F)
        else 0) := by
      intro u₀ z
      let x : G := e_prod (u₀, z)
      let x₀ : G := (cosetRep u₀)⁻¹ * g * cosetRep u₀
      have hx_eq : x * g * x⁻¹ = (z : G) * x₀ * (z : G)⁻¹ := by
        change (z : G) * (cosetRep u₀)⁻¹ * g * ((z : G) * (cosetRep u₀)⁻¹)⁻¹ =
          (z : G) * ((cosetRep u₀)⁻¹ * g * cosetRep u₀) * (z : G)⁻¹
        group
      have h_mem_iff : x * g * x⁻¹ ∈ H ↔ x₀ ∈ H := by
        rw [hx_eq, mul_assoc]
        rw [Subgroup.mul_mem_cancel_left H z.2]
        exact Subgroup.mul_mem_cancel_right H (Subgroup.inv_mem H z.2)
      by_cases hm : x₀ ∈ H
      · have hx : x * g * x⁻¹ ∈ H := h_mem_iff.mpr hm
        rw [dif_pos hx, dif_pos hm]
        have h_sub_eq : (⟨x * g * x⁻¹, hx⟩ : H) = z * ⟨x₀, hm⟩ * z⁻¹ := by
          apply Subtype.ext
          change x * g * x⁻¹ = (z : G) * x₀ * (z : G)⁻¹
          exact hx_eq
        rw [h_sub_eq, map_mul, map_mul, map_inv]
        simp only [Units.val_mul]
        calc (ψ_H z : Ω F) * (ψ_H ⟨x₀, hm⟩ : Ω F) * ((ψ_H z)⁻¹ : (Ω F)ˣ)
            = (ψ_H ⟨x₀, hm⟩ : Ω F) * ((ψ_H z : Ω F) * ((ψ_H z)⁻¹ : (Ω F)ˣ)) := by ring
          _ = (ψ_H ⟨x₀, hm⟩ : Ω F) * 1 := by rw [Units.mul_inv]
          _ = (ψ_H ⟨x₀, hm⟩ : Ω F) := mul_one _
      · have hx : ¬ (x * g * x⁻¹ ∈ H) := fun hx' => hm (h_mem_iff.mp hx')
        rw [dif_neg hx, dif_neg hm]
    have h_sum_G :
        (∑ x : G,
          if hx : x * g * x⁻¹ ∈ H then
            (ψ_H ⟨x * g * x⁻¹, hx⟩ : Ω F)
          else 0) =
        (Nat.card H : Ω F) *
          ∑ u₀ : G ⧸ H,
            if hm : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then
              (ψ_H ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hm⟩ : Ω F)
            else 0 := by
      rw [← Fintype.sum_equiv e_prod
        (fun p =>
          if hx : e_prod p * g * (e_prod p)⁻¹ ∈ H then
            (ψ_H ⟨e_prod p * g * (e_prod p)⁻¹, hx⟩ : Ω F)
          else 0)
        _ (fun _ => rfl)]
      rw [Fintype.sum_prod_type]
      have h_inner : ∀ u₀ : G ⧸ H,
          (∑ z : H,
            if hx : e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹ ∈ H then
              (ψ_H ⟨e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹, hx⟩ : Ω F)
            else 0) =
          (Nat.card H : Ω F) *
            (if hm : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then
              (ψ_H ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hm⟩ : Ω F)
            else 0) := by
        intro u₀
        have h_congr :
            (∑ z : H,
              if hx : e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹ ∈ H then
                (ψ_H ⟨e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹, hx⟩ : Ω F)
              else 0) =
            ∑ _z : H,
              (if hm : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then
                (ψ_H ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hm⟩ : Ω F)
              else 0) :=
          Finset.sum_congr rfl fun z _ => h_term_inv u₀ z
        rw [h_congr, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
      rw [Finset.sum_congr rfl fun u₀ _ => h_inner u₀, ← Finset.mul_sum]
    rw [h_sum_G]
    have h_card_pos : 0 < Nat.card H := Nat.card_pos
    have h_card_ne : (Nat.card H : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_pos.ne'
    exact (inv_mul_cancel_left₀ h_card_ne _).symm
  · intro Q _ _ _ σ W hW g
    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective W.mkQ (Submodule.range_mkQ W)
    have hmem : ∀ v : Q, ((LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ) v ∈ W := by
      intro v
      have hker : ((LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ) v ∈ LinearMap.ker W.mkQ := by
        rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply,
          LinearMap.comp_apply, map_sub]
        change W.mkQ v - (W.mkQ ∘ₗ s) (W.mkQ v) = 0
        rw [hs, LinearMap.id_apply, sub_self]
      rwa [Submodule.ker_mkQ W] at hker
    let p : Q →ₗ[Ω F] W :=
      LinearMap.codRestrict W ((LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ) hmem
    have hfp : W.subtype ∘ₗ p = (LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ := by
      ext v
      rfl
    have hpf : p ∘ₗ W.subtype = LinearMap.id := by
      ext w
      change ((p (W.subtype w) : W) : Q) = w.1
      rw [LinearMap.codRestrict_apply, LinearMap.sub_apply, LinearMap.id_apply,
        LinearMap.comp_apply, Submodule.coe_subtype, Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero W).mpr w.2, map_zero, sub_zero]
    have hfp_id : W.subtype ∘ₗ p + s ∘ₗ W.mkQ = LinearMap.id := by
      rw [hfp, sub_add_cancel]
    have hf_comm : W.subtype ∘ₗ subRep σ W hW g = σ g ∘ₗ W.subtype := by
      ext x
      rfl
    have hq_comm : W.mkQ ∘ₗ σ g = quotRep σ W hW g ∘ₗ W.mkQ := by
      ext x
      rfl
    have h_decomp : σ g =
        (W.subtype ∘ₗ subRep σ W hW g) ∘ₗ p + (σ g ∘ₗ s) ∘ₗ W.mkQ := by
      calc σ g = σ g ∘ₗ LinearMap.id := (LinearMap.comp_id (σ g)).symm
        _ = σ g ∘ₗ (W.subtype ∘ₗ p + s ∘ₗ W.mkQ) := by rw [hfp_id]
        _ = (σ g ∘ₗ W.subtype) ∘ₗ p + (σ g ∘ₗ s) ∘ₗ W.mkQ := by
          rw [LinearMap.comp_add, LinearMap.comp_assoc, LinearMap.comp_assoc]
        _ = (W.subtype ∘ₗ subRep σ W hW g) ∘ₗ p + (σ g ∘ₗ s) ∘ₗ W.mkQ := by
          rw [hf_comm]
    have htr1 : LinearMap.trace (Ω F) Q ((W.subtype ∘ₗ subRep σ W hW g) ∘ₗ p) =
        LinearMap.trace (Ω F) W (subRep σ W hW g) := by
      rw [LinearMap.trace_comp_comm' p (W.subtype ∘ₗ subRep σ W hW g),
        ← LinearMap.comp_assoc, hpf, LinearMap.id_comp]
    have htr2 : LinearMap.trace (Ω F) Q ((σ g ∘ₗ s) ∘ₗ W.mkQ) =
        LinearMap.trace (Ω F) (Q ⧸ W) (quotRep σ W hW g) := by
      rw [LinearMap.trace_comp_comm' W.mkQ (σ g ∘ₗ s),
        ← LinearMap.comp_assoc, hq_comm, LinearMap.comp_assoc, hs, LinearMap.comp_id]
    rw [h_decomp, map_add, htr1, htr2]

theorem ld_ch15_fourier_weight_lift_and_stabilizer_char (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (H : Subgroup G) (ψ_H : H →* (Ω F)ˣ) (hG_mul : ∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q] [Nontrivial Q]
    (σ : Representation (Ω F) G Q)
    (π : leftEquivSpace F H ψ_H →ₗ[Ω F] Q) (hπ_surj : Function.Surjective π)
    (hπ_inter : ∀ g : G, π ∘ₗ rightEquivTransRep F H ψ_H g = σ g ∘ₗ π) :
    ∃ (lam : C → Ω F) (M_lam : Subgroup G) (ψ_lam : M_lam →* (Ω F)ˣ) (w_bar : Q),
      C ≤ M_lam ∧
      (∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ M_lam) ∧
      (∀ g : G, g ∈ M_lam ↔ ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C), lam ⟨g⁻¹ * c.1 * g, hc⟩ = lam c) ∧
      w_bar ≠ 0 ∧
      (∀ c : C, σ c.1 w_bar = lam c • w_bar) ∧
      (∀ k : M_lam, σ k.1 w_bar = (ψ_lam k : Ω F) • w_bar) :=
by
  have hC_comm : ∀ a b : C, σ a.1 ∘ₗ σ b.1 = σ b.1 ∘ₗ σ a.1 := by
    intro a b
    rw [← Module.End.mul_eq_comp, ← map_mul, hC_ab a.1 a.2 b.1 b.2, map_mul, Module.End.mul_eq_comp]
  let E : Finset C → (C → Ω F) → Submodule (Ω F) Q := fun S μ =>
    { carrier := {q : Q | ∀ c ∈ S, σ c.1 q = μ c • q}
      zero_mem' := fun c _ => by simp
      add_mem' := fun {x y} hx hy c hc => by
        change σ c.1 (x + y) = μ c • (x + y)
        rw [map_add, hx c hc, hy c hc, smul_add]
      smul_mem' := fun r {x} hx c hc => by
        change σ c.1 (r • x) = μ c • (r • x)
        rw [map_smul, hx c hc, smul_comm r (μ c)] }
  have h_fin : ∀ S : Finset C, ∃ μ : C → Ω F, E S μ ≠ ⊥ := by
    intro S
    induction' S using Finset.induction_on with b S₀ hb ih
    · obtain ⟨q₀, hq₀⟩ := exists_ne (0 : Q)
      refine ⟨0, (Submodule.ne_bot_iff _).mpr ⟨q₀, ?_, hq₀⟩⟩
      intro c hc
      simp at hc
    · rcases ih with ⟨μ₀, hW₀_ne⟩
      let W₀ := E S₀ μ₀
      have hW₀_inv : ∀ x ∈ W₀, σ b.1 x ∈ W₀ := by
        intro x hx a ha
        have h_comm : (σ a.1 ∘ₗ σ b.1) x = (σ b.1 ∘ₗ σ a.1) x := by
          rw [hC_comm a b]
        change σ a.1 (σ b.1 x) = σ b.1 (σ a.1 x) at h_comm
        have hxa : σ a.1 x = μ₀ a • x := hx a ha
        change σ a.1 (σ b.1 x) = μ₀ a • σ b.1 x
        rw [h_comm, hxa, map_smul]
      haveI : Nontrivial W₀ := Submodule.nontrivial_iff_ne_bot.mpr hW₀_ne
      let f_b : W₀ →ₗ[Ω F] W₀ := (σ b.1).restrict hW₀_inv
      obtain ⟨r, hr⟩ := Module.End.exists_eigenvalue f_b
      obtain ⟨w, hw_mem, hw_ne⟩ := hr.exists_hasEigenvector
      have hw_eq : f_b w = r • w := Module.End.mem_eigenspace_iff.mp hw_mem
      have h_bw : σ b.1 w.1 = r • w.1 := congr_arg Subtype.val hw_eq
      have hw_val_ne : w.1 ≠ 0 := fun h0 => hw_ne (Subtype.ext h0)
      let μ : C → Ω F := Function.update μ₀ b r
      refine ⟨μ, (Submodule.ne_bot_iff _).mpr ⟨w.1, ?_, hw_val_ne⟩⟩
      intro a ha
      change σ a.1 w.1 = μ a • w.1
      rcases Finset.mem_insert.mp ha with rfl | ha_S₀
      · dsimp only [μ]
        rw [Function.update_self]
        exact h_bw
      · have hab : a ≠ b := fun h => hb (h ▸ ha_S₀)
        dsimp only [μ]
        rw [Function.update_of_ne hab]
        exact w.2 a ha_S₀
  obtain ⟨lam, h_ne_bot⟩ := h_fin Finset.univ
  obtain ⟨q₀, hq₀_mem, hq₀_ne⟩ := (Submodule.ne_bot_iff _).mp h_ne_bot
  have hq₀_eig : ∀ c : C, σ c.1 q₀ = lam c • q₀ := fun c => hq₀_mem c (Finset.mem_univ c)
  have h_smul_inj : ∀ r₁ r₂ : Ω F, r₁ • q₀ = r₂ • q₀ → r₁ = r₂ := by
    intro r₁ r₂ h_eq
    have h_sub : (r₁ - r₂) • q₀ = 0 := by rw [sub_smul, h_eq, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h_sub).resolve_right hq₀_ne)
  have hlam_one : lam 1 = 1 := by
    apply h_smul_inj
    rw [← hq₀_eig 1, Subgroup.coe_one, map_one, Module.End.one_apply, one_smul]
  have hlam_mul : ∀ a b : C, lam (a * b) = lam a * lam b := by
    intro a b
    apply h_smul_inj
    rw [← hq₀_eig (a * b), Subgroup.coe_mul, map_mul, Module.End.mul_apply,
      hq₀_eig b, map_smul, hq₀_eig a, smul_smul, mul_comm]
  have hlam_inv_mul : ∀ c : C, lam c⁻¹ * lam c = 1 := by
    intro c
    rw [← hlam_mul c⁻¹ c, inv_mul_cancel, hlam_one]
  obtain ⟨v₀, hv₀⟩ := hπ_surj q₀
  let w : leftEquivSpace F H ψ_H :=
    (Nat.card C : Ω F)⁻¹ • ∑ c : C, lam c⁻¹ • rightEquivTransRep F H ψ_H c.1 v₀
  have h_pi_term : ∀ c : C, π (lam c⁻¹ • rightEquivTransRep F H ψ_H c.1 v₀) = q₀ := by
    intro c
    have h_inter : π (rightEquivTransRep F H ψ_H c.1 v₀) = σ c.1 (π v₀) :=
      LinearMap.congr_fun (hπ_inter c.1) v₀
    rw [map_smul, h_inter, hv₀, hq₀_eig c, smul_smul, hlam_inv_mul c, one_smul]
  have hC_ne : (Nat.card C : Ω F) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Nat.card_pos (α := C)).ne'
  have hw_pi : π w = q₀ := by
    dsimp only [w]
    rw [map_smul, map_sum]
    have h_sum : (∑ c : C, π (lam c⁻¹ • rightEquivTransRep F H ψ_H c.1 v₀)) = ∑ _c : C, q₀ :=
      Finset.sum_congr rfl fun c _ => h_pi_term c
    rw [h_sum, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
      ← Nat.cast_smul_eq_nsmul (Ω F), inv_smul_smul₀ hC_ne]
  have hw_eig : ∀ a : C, rightEquivTransRep F H ψ_H a.1 w = lam a • w := by
    intro a
    have h_sum_eq :
        (∑ c : C, (rightEquivTransRep F H ψ_H a.1) (lam c⁻¹ • (rightEquivTransRep F H ψ_H c.1) v₀)) =
          ∑ c : C, lam a • (lam c⁻¹ • (rightEquivTransRep F H ψ_H c.1) v₀) := by
      refine (Fintype.sum_equiv (Equiv.mulLeft a⁻¹)
        (fun c => lam a • (lam c⁻¹ • (rightEquivTransRep F H ψ_H c.1) v₀))
        (fun c => (rightEquivTransRep F H ψ_H a.1) (lam c⁻¹ • (rightEquivTransRep F H ψ_H c.1) v₀))
        (fun c => ?_)).symm
      change lam a • (lam c⁻¹ • (rightEquivTransRep F H ψ_H c.1) v₀) =
        (rightEquivTransRep F H ψ_H a.1) (lam (a⁻¹ * c)⁻¹ • (rightEquivTransRep F H ψ_H (a⁻¹ * c).1) v₀)
      rw [map_smul]
      have h_rep : rightEquivTransRep F H ψ_H a.1 (rightEquivTransRep F H ψ_H (a⁻¹ * c).1 v₀) =
          rightEquivTransRep F H ψ_H c.1 v₀ := by
        rw [← Module.End.mul_apply, ← map_mul, ← Subgroup.coe_mul, mul_inv_cancel_left]
      have h_lam : lam (a⁻¹ * c)⁻¹ = lam a * lam c⁻¹ := by
        rw [mul_inv_rev, inv_inv, hlam_mul, mul_comm]
      rw [h_rep, h_lam, mul_smul]
    dsimp only [w]
    rw [map_smul, map_sum, h_sum_eq, ← Finset.smul_sum, smul_comm]
  have h_w_eval : ∀ (h : H) (c : C), w.1 ((h : G) * c.1) = (ψ_H h : Ω F) * (lam c * w.1 1) := by
    intro h c
    have h1 : w.1 ((h : G) * c.1) = (ψ_H h : Ω F) * w.1 c.1 := w.2 h c.1
    have h2 : (rightEquivTransRep F H ψ_H c.1 w).1 1 = w.1 c.1 := by
      change w.1 (1 * c.1) = w.1 c.1
      rw [one_mul]
    have h3 : (rightEquivTransRep F H ψ_H c.1 w).1 1 = lam c * w.1 1 := by
      rw [hw_eig c]
      rfl
    rw [h1, ← h2, h3]
  have hw_one_ne : w.1 1 ≠ 0 := by
    intro h0
    have hw_zero : w = 0 := by
      apply Subtype.ext
      funext g
      obtain ⟨h, hh, c, hc, rfl⟩ := hG_mul g
      change w.1 ((⟨h, hh⟩ : H).1 * (⟨c, hc⟩ : C).1) = 0
      rw [h_w_eval ⟨h, hh⟩ ⟨c, hc⟩, h0, mul_zero, mul_zero]
    have hq₀_zero : q₀ = 0 := by
      rw [← hw_pi, hw_zero, map_zero]
    exact hq₀_ne hq₀_zero
  let w₀ : leftEquivSpace F H ψ_H := (w.1 1)⁻¹ • w
  let w_bar : Q := π w₀
  have hw_bar_eq : w_bar = (w.1 1)⁻¹ • q₀ := by
    dsimp only [w_bar, w₀]
    rw [map_smul, hw_pi]
  have hw_bar_ne : w_bar ≠ 0 := by
    rw [hw_bar_eq]
    exact smul_ne_zero (inv_ne_zero hw_one_ne) hq₀_ne
  have hw_bar_C : ∀ c : C, σ c.1 w_bar = lam c • w_bar := by
    intro c
    rw [hw_bar_eq, map_smul, hq₀_eig c, smul_comm]
  have hw₀_eval : ∀ (h : H) (c : C), w₀.1 ((h : G) * c.1) = (ψ_H h : Ω F) * lam c := by
    intro h c
    change (w.1 1)⁻¹ * w.1 ((h : G) * c.1) = (ψ_H h : Ω F) * lam c
    rw [h_w_eval h c]
    calc (w.1 1)⁻¹ * ((ψ_H h : Ω F) * (lam c * w.1 1))
        = ((ψ_H h : Ω F) * lam c) * ((w.1 1)⁻¹ * w.1 1) := by ring
      _ = ((ψ_H h : Ω F) * lam c) * 1 := by rw [inv_mul_cancel₀ hw_one_ne]
      _ = (ψ_H h : Ω F) * lam c := mul_one _
  have hC_norm : C.Normal := inferInstance
  have h_conj : ∀ (g : G) (c : C), g⁻¹ * c.1 * g ∈ C := by
    intro g c
    simpa [mul_assoc] using hC_norm.conj_mem c.1 c.2 g⁻¹
  let shift : G → (C → Ω F) → (C → Ω F) := fun g μ c =>
    μ ⟨g⁻¹ * c.1 * g, h_conj g c⟩
  have h_shift_one : ∀ μ : C → Ω F, shift 1 μ = μ := by
    intro μ
    funext c
    dsimp only [shift]
    congr 1
    apply Subtype.ext
    group
  have h_shift_mul : ∀ (x y : G) (μ : C → Ω F), shift (x * y) μ = shift x (shift y μ) := by
    intro x y μ
    funext c
    dsimp only [shift]
    congr 1
    apply Subtype.ext
    group
  let M_lam : Subgroup G :=
    { carrier := {g : G | shift g lam = lam}
      one_mem' := h_shift_one lam
      mul_mem' := fun {x y} hx hy => by
        change shift (x * y) lam = lam
        rw [h_shift_mul, hy, hx]
      inv_mem' := fun {x} hx => by
        change shift x⁻¹ lam = lam
        have h1 : shift x⁻¹ (shift x lam) = shift x⁻¹ lam := by rw [hx]
        rw [← h_shift_mul, inv_mul_cancel, h_shift_one] at h1
        exact h1.symm }
  have hM_lam : ∀ g : G, g ∈ M_lam ↔ ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C), lam ⟨g⁻¹ * c.1 * g, hc⟩ = lam c := by
    intro g
    change shift g lam = lam ↔ _
    rw [funext_iff]
    constructor
    · intro hg c hc
      have h_sub : (⟨g⁻¹ * c.1 * g, hc⟩ : C) = ⟨g⁻¹ * c.1 * g, h_conj g c⟩ := rfl
      rw [h_sub]
      exact hg c
    · intro hg c
      exact hg c (h_conj g c)
  have h_cent_le : ∀ g : G, (∀ c ∈ C, g * c = c * g) → g ∈ M_lam := by
    intro g h_comm
    rw [hM_lam]
    intro c hc
    congr 1
    apply Subtype.ext
    change g⁻¹ * c.1 * g = c.1
    rw [mul_assoc, ← h_comm c.1 c.2, inv_mul_cancel_left]
  have hC_le : C ≤ M_lam := fun a ha => h_cent_le a (hC_ab a ha)
  have hH_cent : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ M_lam :=
    fun h _ h_comm => h_cent_le h h_comm
  have h_tau_M : ∀ k : M_lam, rightEquivTransRep F H ψ_H k.1 w₀ = w₀.1 k.1 • w₀ := by
    intro k
    obtain ⟨h_k, hh_k, c_k, hc_k, hk_eq⟩ := hG_mul k.1
    have hw₀_k : w₀.1 k.1 = (ψ_H ⟨h_k, hh_k⟩ : Ω F) * lam ⟨c_k, hc_k⟩ := by
      rw [hk_eq]
      exact hw₀_eval ⟨h_k, hh_k⟩ ⟨c_k, hc_k⟩
    have h_conj_hk : ∀ c : C, lam ⟨h_k⁻¹ * c.1 * h_k, h_conj h_k c⟩ = lam c := by
      intro c
      have h_eq_c : h_k⁻¹ * c.1 * h_k = k.1⁻¹ * c.1 * k.1 := by
        have h_in_C : h_k⁻¹ * c.1 * h_k ∈ C := h_conj h_k c
        have h_comm_ck : (h_k⁻¹ * c.1 * h_k) * c_k = c_k * (h_k⁻¹ * c.1 * h_k) :=
          hC_ab _ h_in_C c_k hc_k
        calc h_k⁻¹ * c.1 * h_k
            = c_k⁻¹ * (c_k * (h_k⁻¹ * c.1 * h_k)) := by group
          _ = c_k⁻¹ * ((h_k⁻¹ * c.1 * h_k) * c_k) := by rw [← h_comm_ck]
          _ = (h_k * c_k)⁻¹ * c.1 * (h_k * c_k) := by group
          _ = k.1⁻¹ * c.1 * k.1 := by rw [← hk_eq]
      have h_sub : (⟨h_k⁻¹ * c.1 * h_k, h_conj h_k c⟩ : C) = ⟨k.1⁻¹ * c.1 * k.1, h_conj k.1 c⟩ := by
        apply Subtype.ext
        exact h_eq_c
      rw [h_sub]
      exact (hM_lam k.1).mp k.2 c (h_conj k.1 c)
    apply Subtype.ext
    funext x
    obtain ⟨h_x, hh_x, c_x, hc_x, rfl⟩ := hG_mul x
    change w₀.1 ((h_x * c_x) * k.1) = w₀.1 k.1 * w₀.1 ((⟨h_x, hh_x⟩ : H).1 * (⟨c_x, hc_x⟩ : C).1)
    have h_prod : (h_x * c_x) * k.1 = (h_x * h_k) * ((h_k⁻¹ * c_x * h_k) * c_k) := by
      rw [hk_eq]
      group
    let h_prod_H : H := ⟨h_x, hh_x⟩ * ⟨h_k, hh_k⟩
    let c_conj : C := ⟨h_k⁻¹ * c_x * h_k, h_conj h_k ⟨c_x, hc_x⟩⟩
    let c_prod : C := c_conj * ⟨c_k, hc_k⟩
    have h_prod_coe : (h_x * c_x) * k.1 = (h_prod_H : G) * c_prod.1 := h_prod
    rw [h_prod_coe, hw₀_eval h_prod_H c_prod, hw₀_eval ⟨h_x, hh_x⟩ ⟨c_x, hc_x⟩, hw₀_k]
    dsimp only [h_prod_H, c_prod]
    rw [map_mul, Units.val_mul, hlam_mul, h_conj_hk ⟨c_x, hc_x⟩]
    ring
  have hw₀_one : w₀.1 1 = 1 := by
    have h1 : (1 : G) = ((1 : H) : G) * (1 : C).1 := by simp
    rw [h1, hw₀_eval 1 1, map_one, Units.val_one, hlam_one, mul_one]
  have hw₀_mul : ∀ k₁ k₂ : M_lam, w₀.1 (k₁ * k₂).1 = w₀.1 k₁.1 * w₀.1 k₂.1 := by
    intro k₁ k₂
    have h_ev := congr_fun (congr_arg Subtype.val (h_tau_M k₂)) k₁.1
    change w₀.1 (k₁.1 * k₂.1) = w₀.1 k₂.1 * w₀.1 k₁.1 at h_ev
    rw [Subgroup.coe_mul, h_ev, mul_comm]
  let ψ_lam : M_lam →* (Ω F)ˣ :=
    { toFun := fun k =>
        { val := w₀.1 k.1
          inv := w₀.1 (k⁻¹).1
          val_inv := by rw [← hw₀_mul, mul_inv_cancel, Subgroup.coe_one, hw₀_one]
          inv_val := by rw [← hw₀_mul, inv_mul_cancel, Subgroup.coe_one, hw₀_one] }
      map_one' := Units.ext hw₀_one
      map_mul' := fun k₁ k₂ => Units.ext (hw₀_mul k₁ k₂) }
  have hw_bar_M : ∀ k : M_lam, σ k.1 w_bar = (ψ_lam k : Ω F) • w_bar := by
    intro k
    dsimp only [w_bar]
    have h_inter : π (rightEquivTransRep F H ψ_H k.1 w₀) = σ k.1 (π w₀) :=
      LinearMap.congr_fun (hπ_inter k.1) w₀
    rw [← h_inter, h_tau_M k, map_smul]
    rfl
  exact ⟨lam, M_lam, ψ_lam, w_bar, hC_le, hH_cent, hM_lam, hw_bar_ne, hw_bar_C, hw_bar_M⟩

theorem ld_ch15_abelian_normal_mackey_indCharTrace (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (H : Subgroup G) (ψ_H : H →* (Ω F)ˣ) :
    ∃ (L_mon : List (Σ (M : Subgroup G), (M →* (Ω F)ˣ))),
      (∀ p ∈ L_mon, C ≤ p.1) ∧
      (∀ p ∈ L_mon, ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ p.1) ∧
      ∀ g : G,
        indCharTrace F H ψ_H g =
          (L_mon.map fun p => indCharTrace F p.1 p.2 g).sum :=
by
  have h_prod_case : ∀ (d : ℕ) (M : Type u) [Group M] [Fintype M]
      (C' : Subgroup M) [C'.Normal]
      (hC'_ab : ∀ a ∈ C', ∀ b ∈ C', a * b = b * a)
      (H' : Subgroup M) (ψ_H' : H' →* (Ω F)ˣ)
      (hM_mul : ∀ m : M, ∃ h ∈ H', ∃ c ∈ C', m = h * c)
      {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q]
      (σ : Representation (Ω F) M Q)
      (π : leftEquivSpace F H' ψ_H' →ₗ[Ω F] Q),
      Function.Surjective π →
      (∀ m : M, π ∘ₗ rightEquivTransRep F H' ψ_H' m = σ m ∘ₗ π) →
      Module.finrank (Ω F) Q = d →
      ∃ (L_Q : List (Σ (K : Subgroup M), (K →* (Ω F)ˣ))),
        (∀ p ∈ L_Q, C' ≤ p.1) ∧
        (∀ p ∈ L_Q, ∀ h ∈ H', (∀ c ∈ C', h * c = c * h) → h ∈ p.1) ∧
        ∀ m : M,
          LinearMap.trace (Ω F) Q (σ m) =
            (L_Q.map fun p => indCharTrace F p.1 p.2 m).sum := by
    intro d
    induction' d using Nat.strong_induction_on with d ih
    intro M _ _ C' _ hC'_ab H' ψ_H' hM_mul Q _ _ _ σ π hπ_surj hπ_inter hd
    rcases Nat.eq_zero_or_pos (Module.finrank (Ω F) Q) with hd0 | hd_pos
    · haveI : Subsingleton Q := Module.finrank_zero_iff.mp hd0
      refine ⟨[], by simp, by simp, fun m => ?_⟩
      have h0 : σ m = 0 := Subsingleton.elim _ _
      simp [h0]
    · haveI : Nontrivial Q := Module.nontrivial_of_finrank_pos hd_pos
      obtain ⟨lam, M_lam, ψ_lam, w_bar, hC'_le, hC'_cent, hM_lam, hw_ne, hw_C, hw_M⟩ :=
        ld_ch15_fourier_weight_lift_and_stabilizer_char F M C' hC'_ab H' ψ_H' hM_mul σ π hπ_surj hπ_inter
      obtain ⟨W, hW, hW_ne_bot, hW_tr⟩ :=
        ld_weight_orbit_submodule_trace F M C' σ lam M_lam hM_lam ψ_lam w_bar hw_ne hw_C hw_M
      haveI : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hW_ne_bot
      have hW_pos : 0 < Module.finrank (Ω F) W := Module.finrank_pos
      have h_add_dim : Module.finrank (Ω F) (Q ⧸ W) + Module.finrank (Ω F) W =
          Module.finrank (Ω F) Q :=
        Submodule.finrank_quotient_add_finrank W
      have h_lt : Module.finrank (Ω F) (Q ⧸ W) < d := by omega
      let π' : leftEquivSpace F H' ψ_H' →ₗ[Ω F] (Q ⧸ W) := W.mkQ ∘ₗ π
      have hπ'_surj : Function.Surjective π' :=
        (Submodule.mkQ_surjective W).comp hπ_surj
      have hπ'_inter : ∀ m : M, π' ∘ₗ rightEquivTransRep F H' ψ_H' m = quotRep σ W hW m ∘ₗ π' := by
        intro m
        have hq_comm : W.mkQ ∘ₗ σ m = quotRep σ W hW m ∘ₗ W.mkQ := by
          ext x
          rfl
        calc W.mkQ ∘ₗ π ∘ₗ rightEquivTransRep F H' ψ_H' m
            = W.mkQ ∘ₗ (π ∘ₗ rightEquivTransRep F H' ψ_H' m) := rfl
          _ = W.mkQ ∘ₗ (σ m ∘ₗ π) := by rw [hπ_inter m]
          _ = (W.mkQ ∘ₗ σ m) ∘ₗ π := rfl
          _ = (quotRep σ W hW m ∘ₗ W.mkQ) ∘ₗ π := by rw [hq_comm]
          _ = quotRep σ W hW m ∘ₗ (W.mkQ ∘ₗ π) := rfl
      obtain ⟨L_quot, hL_quot_le, hL_quot_cent, hL_quot_tr⟩ :=
        ih (Module.finrank (Ω F) (Q ⧸ W)) h_lt M C' hC'_ab H' ψ_H' hM_mul
          (quotRep σ W hW) π' hπ'_surj hπ'_inter rfl
      have h_quot_add := (ld_ch15_rightEquivTransRep_trace_and_quot_add F M).2 σ W hW
      refine ⟨⟨M_lam, ψ_lam⟩ :: L_quot, ?_, ?_, ?_⟩
      · intro p hp
        rw [List.mem_cons] at hp
        rcases hp with rfl | hp
        · exact hC'_le
        · exact hL_quot_le p hp
      · intro p hp
        rw [List.mem_cons] at hp
        rcases hp with rfl | hp
        · exact hC'_cent
        · exact hL_quot_cent p hp
      · intro m
        simp only [List.map_cons, List.sum_cons]
        rw [h_quot_add m, hW_tr m, hL_quot_tr m]
  obtain ⟨M, hC'_norm, ψ_H', hC'_ab, hM_mul, h_push⟩ :=
    ld_ch15_prod_subgroup_pushforward F G C hC_ab H ψ_H
  haveI : (C.subgroupOf M).Normal := hC'_norm
  obtain ⟨L_M, hL_M_le, hL_M_cent, hL_M_tr⟩ :=
    h_prod_case (Module.finrank (Ω F) (leftEquivSpace F (H.subgroupOf M) ψ_H'))
      M (C.subgroupOf M) hC'_ab (H.subgroupOf M) ψ_H' hM_mul
      (rightEquivTransRep F (H.subgroupOf M) ψ_H') LinearMap.id
      Function.surjective_id (fun _ => rfl) rfl
  have h_tr_init := (ld_ch15_rightEquivTransRep_trace_and_quot_add F M).1 (H.subgroupOf M) ψ_H'
  apply h_push L_M hL_M_le hL_M_cent
  intro m
  rw [← h_tr_init m, hL_M_tr m]

theorem ld_ch15_mackey_orbit_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K M_C E F' : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hLF' : L ≤ F') (hF'E : F' ≤ E) (hF'M_C : F' ≤ M_C) (hF'_inf : E ⊓ M_C ≤ F')
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (χL : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ)
    (hχL : IsWeilRep F L (charRep F L χL))
    (hχE : IsWeilRep F E (charRep F E χE))
    (h_rest : restrictWeilChar F hEK χE = restrictWeilChar F hLK χL) :
    ∃ D_M : List (MonomialTerm F F'),
      IsMonomialDecomp F F'
        (fun w => (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w) D_M ∧
      (∀ t ∈ D_M, t.field ≤ M_C) ∧
      (∀ t ∈ D_M, ∃ htK : t.field ≤ K,
        restrictWeilChar F htK t.χ = restrictWeilChar F hLK χL) ∧
      monomialListDeg F F' D_M =
        (Module.finrank ↥F' (IntermediateField.extendScalars hF'E) : ℤ) ∧
      (χL = 1 → χE = 1 →
        ∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
          L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
          ∀ t ∈ D_M, t.field ≤ K₁) :=
by
  let hF'K : F' ≤ K := hF'E.trans hEK
  let K' := IntermediateField.extendScalars hF'K
  obtain ⟨hFinF', hFinK, hFinF'K', hGalF'K', π, C, H, hπ, hsurj, hC_norm, hC_ab, h_mem_H, h_sub_MC, h_sub_K₁⟩ :=
    ld_ch15_galois_subgroups_and_weil_proj F L K M_C E F' hLK hLM_C hM_CK hLE hEK hLF' hF'E hF'M_C hGal hMin
  haveI : FiniteDimensional F F' := hFinF'
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional F' K' := hFinF'K'
  haveI : IsGalois F' K' := hGalF'K'
  haveI : C.Normal := hC_norm
  obtain ⟨h_lift_sub, hwf_E, ψ_H, htr_E⟩ :=
    ld_ch15_weil_galois_twisted_bridge F L K E F' hLK hLE hEK hLF' hF'E hF'K π hπ hsurj H h_mem_H χL χE hχL hχE h_rest
  obtain ⟨L_mon, hL_C, hL_cent, hL_sum⟩ :=
    ld_ch15_abelian_normal_mackey_indCharTrace F (K' ≃ₐ[F'] K') C hC_ab H ψ_H
  have h_build : ∀ (L_sub : List (Σ (M : Subgroup (K' ≃ₐ[F'] K')), (M →* (Ω F)ˣ))),
      (∀ p ∈ L_sub, C ≤ p.1) →
      (∀ p ∈ L_sub, ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ p.1) →
      ∃ D_M : List (MonomialTerm F F'),
        (∀ t ∈ D_M, t.Wf F F') ∧
        (∀ t ∈ D_M, t.field ≤ M_C) ∧
        (∀ t ∈ D_M, ∃ htK : t.field ≤ K,
          restrictWeilChar F htK t.χ = restrictWeilChar F hLK χL) ∧
        (∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
          L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
          ∀ t ∈ D_M, t.field ≤ K₁) ∧
        ∀ w : relWeil F F',
          monomialListTrace F F' D_M w =
            (restrictWeilChar F hLF' χL w : Ω F) *
              (L_sub.map fun p => indCharTrace F p.1 p.2 (π w)).sum := by
    intro L_sub h_sub_C h_sub_cent
    induction L_sub with
    | nil =>
      exact ⟨[], by simp, by simp, by simp, fun _ _ _ _ _ _ t ht => by simp at ht,
        fun w => by simp [monomialListTrace]⟩
    | cons p tl ih =>
      have hp_C : C ≤ p.1 := h_sub_C p List.mem_cons_self
      have hp_cent : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ p.1 :=
        h_sub_cent p List.mem_cons_self
      have htl_C : ∀ p' ∈ tl, C ≤ p'.1 :=
        fun p' hp' => h_sub_C p' (List.mem_cons_of_mem p hp')
      have htl_cent : ∀ p' ∈ tl, ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h ∈ p'.1 :=
        fun p' hp' => h_sub_cent p' (List.mem_cons_of_mem p hp')
      obtain ⟨D_tl, hD_tl_wf, hD_tl_MC, hD_tl_rest, hD_tl_K₁, hD_tl_tr⟩ := ih htl_C htl_cent
      obtain ⟨t_p, ht_p_wf, ht_p_field, ht_p_rest, ht_p_tr⟩ := h_lift_sub p.1 p.2
      have ht_p_MC : t_p.field ≤ M_C := by
        rw [ht_p_field]
        exact h_sub_MC p.1 hp_C
      have ht_p_K₁ : ∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
          L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
          t_p.field ≤ K₁ := by
        intro K₁ hLK₁ hK₁K hGal₁ hEK₁ hsup
        rw [ht_p_field]
        exact h_sub_K₁ K₁ hLK₁ hK₁K hGal₁ hEK₁ hsup p.1 hp_cent
      refine ⟨t_p :: D_tl, ?_, ?_, ?_, ?_, ?_⟩
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_p_wf
        · exact hD_tl_wf t ht
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_p_MC
        · exact hD_tl_MC t ht
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_p_rest
        · exact hD_tl_rest t ht
      · intro K₁ hLK₁ hK₁K hGal₁ hEK₁ hsup t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_p_K₁ K₁ hLK₁ hK₁K hGal₁ hEK₁ hsup
        · exact hD_tl_K₁ K₁ hLK₁ hK₁K hGal₁ hEK₁ hsup t ht
      · intro w
        simp only [monomialListTrace, List.map_cons, List.sum_cons] at hD_tl_tr ⊢
        rw [ht_p_tr w, hD_tl_tr w, mul_add]
  obtain ⟨D_M, hD_M_wf, hD_M_MC, hD_M_rest, hD_M_K₁, hD_M_tr⟩ := h_build L_mon hL_C hL_cent
  have hD_M_decomp : IsMonomialDecomp F F'
      (fun w => (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w) D_M := by
    refine ⟨hD_M_wf, fun w => ?_⟩
    dsimp only
    rw [htr_E w, hD_M_tr w, hL_sum (π w)]
  have htrace_neg : ∀ (D : List (MonomialTerm F F')) (w : relWeil F F'),
      monomialListTrace F F' (D.map (MonomialTerm.neg F F')) w =
        - monomialListTrace F F' D w := by
    intro D w
    induction D with
    | nil => simp [monomialListTrace]
    | cons t tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F F').trace F F' w = - (t.trace F F' w) := by
        simp [MonomialTerm.neg, MonomialTerm.trace, neg_smul]
      rw [ht, ih]
      ring
  have hdeg_neg : ∀ (D : List (MonomialTerm F F')),
      monomialListDeg F F' (D.map (MonomialTerm.neg F F')) =
        - monomialListDeg F F' D := by
    intro D
    induction D with
    | nil => simp [monomialListDeg]
    | cons t tl ih =>
      simp only [monomialListDeg, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F F').deg F F' = - (t.deg F F') := by
        simp [MonomialTerm.neg, MonomialTerm.deg, neg_mul]
      rw [ht, ih]
      omega
  let V₀ := Fin 0 → ULift.{u} (Ω F)
  let σ₀ : Representation (Ω F) (relWeil F F') V₀ := 1
  have hσ₀ : IsWeilRep F F' σ₀ := ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
  have htr₀ : (fun w => LinearMap.trace (Ω F) V₀ (σ₀ w)) = 0 := by
    funext w
    rw [Subsingleton.elim (σ₀ w) 0, map_zero]
    rfl
  let D_zero : List (MonomialTerm F F') :=
    ⟨1, E, hF'E, χE⟩ :: D_M.map (MonomialTerm.neg F F')
  have hD_zero : IsMonomialDecomp F F' (fun w => LinearMap.trace (Ω F) V₀ (σ₀ w)) D_zero := by
    rw [htr₀]
    refine ⟨?_, ?_⟩
    · intro t ht
      rcases List.mem_cons.mp ht with rfl | ht
      · exact hwf_E
      · rcases List.mem_map.mp ht with ⟨t₀, ht₀, rfl⟩
        exact hD_M_wf t₀ ht₀
    · intro w
      have htr_cons : monomialListTrace F F' D_zero w =
          (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w +
            monomialListTrace F F' (D_M.map (MonomialTerm.neg F F')) w := rfl
      have h_eqE : (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w =
          monomialListTrace F F' D_M w := hD_M_decomp.2 w
      rw [Pi.zero_apply, htr_cons, htrace_neg D_M w, h_eqE, add_neg_cancel]
  have hdeg₀ := ld_monomial_deg_eq_finrank F F' σ₀ hσ₀ D_zero hD_zero
  have hfin_V₀ : Module.finrank (Ω F) V₀ = 0 := Module.finrank_zero_of_subsingleton
  rw [hfin_V₀, Nat.cast_zero] at hdeg₀
  have hD_M_deg : monomialListDeg F F' D_M =
      (Module.finrank ↥F' (IntermediateField.extendScalars hF'E) : ℤ) := by
    have hdeg_cons : monomialListDeg F F' D_zero =
        (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').deg F F' +
          monomialListDeg F F' (D_M.map (MonomialTerm.neg F F')) := rfl
    rw [hdeg_cons, hdeg_neg D_M] at hdeg₀
    simp only [MonomialTerm.deg, one_mul] at hdeg₀
    omega
  exact ⟨D_M, hD_M_decomp, hD_M_MC, hD_M_rest, hD_M_deg, fun _ _ => hD_M_K₁⟩

theorem ld_ch15_semidirect_weil_char_ext (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K)
    (hGal : IsGaloisExt F L K) (hGalMC : IsGaloisExt F L M_C)
    (χL : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ)
    (hχL : IsWeilRep F L (charRep F L χL))
    (hχE : IsWeilRep F E (charRep F E χE))
    (h_rest : restrictWeilChar F hEK χE = restrictWeilChar F hLK χL) :
    (IsWeilRep F L (charRep F L 1) ∧ IsWeilRep F E (charRep F E 1)) ∧
    ∃ χL_ext : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL_ext) ∧
      restrictWeilChar F hLE χL_ext = χE ∧
      restrictWeilChar F hLK χL_ext = restrictWeilChar F hLK χL :=
by
  have hFin_Ω : FiniteDimensional (Ω F) (ULift.{u} (Ω F)) :=
    Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm
  have hWeil1 : ∀ M : IntermediateField F (AlgebraicClosure F),
      IsWeilRep F M (charRep F M 1) := by
    intro M
    refine ⟨hFin_Ω, Set.univ, Filter.univ_mem, fun w _ _ => ?_⟩
    change ((1 : relWeil F M →* (Ω F)ˣ) w : Ω F) • LinearMap.id = 1
    rw [MonoidHom.one_apply, Units.val_one, one_smul]
    rfl
  refine ⟨⟨hWeil1 L, hWeil1 E⟩, ?_⟩
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  have hFinK : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional F K' := hFinK
  haveI : FiniteDimensional L K' := FiniteDimensional.right F L K'
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  have hSepLK : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
  haveI : Algebra.IsSeparable L K' := hSepLK
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k K₀ := by
    clear * -
    intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
      (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
    intro σ τ hτ
    let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
    let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
    have hτK : τ_F.1 ∈ K.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
    have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
      hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
    exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
  have hGalLK' : IsGalois L ↥K' := helper_isGalois L (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois L ↥K' := hGalLK'
  haveI : Normal L ↥K' := IsGalois.to_normal
  letI : Fintype G := Fintype.ofFinite G
  let toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)), L ≤ A → IntermediateField L K' :=
    fun A hLA => (IntermediateField.extendScalars hLA).comap K'.val
  have h_mem_toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A) (y : K'),
      y ∈ toSub A hLA ↔ y.1 ∈ A :=
    fun A hLA _ => IntermediateField.mem_extendScalars hLA
  have h_toSub_le : ∀ (E₁ E₂ : IntermediateField F (AlgebraicClosure F))
      (hLE₁ : L ≤ E₁) (hEK₁ : E₁ ≤ K) (hLE₂ : L ≤ E₂),
      toSub E₁ hLE₁ ≤ toSub E₂ hLE₂ ↔ E₁ ≤ E₂ := by
    intro E₁ E₂ hLE₁ hEK₁ hLE₂
    constructor
    · intro hle x hx
      have hy : (⟨x, (IntermediateField.mem_extendScalars hLK).mpr (hEK₁ hx)⟩ : K') ∈ toSub E₁ hLE₁ :=
        (h_mem_toSub E₁ hLE₁ _).mpr hx
      exact (h_mem_toSub E₂ hLE₂ _).mp (hle hy)
    · intro hle y hy
      exact (h_mem_toSub E₂ hLE₂ y).mpr (hle ((h_mem_toSub E₁ hLE₁ y).mp hy))
  have h_toSub_bot : toSub L le_rfl = ⊥ := by
    ext y
    rw [h_mem_toSub, IntermediateField.mem_bot]
    refine ⟨fun hy => ⟨⟨y.1, hy⟩, rfl⟩, ?_⟩
    rintro ⟨a, rfl⟩
    exact a.2
  have h_toSub_top : toSub K hLK = ⊤ := by
    ext y
    rw [h_mem_toSub]
    simp [(IntermediateField.mem_extendScalars hLK).mp y.2]
  have h_toSub_inf : ∀ (E₁ E₂ : IntermediateField F (AlgebraicClosure F))
      (hLE₁ : L ≤ E₁) (hLE₂ : L ≤ E₂),
      toSub (E₁ ⊓ E₂) (le_inf hLE₁ hLE₂) = toSub E₁ hLE₁ ⊓ toSub E₂ hLE₂ := by
    intro E₁ E₂ hLE₁ hLE₂
    ext y
    rw [h_mem_toSub, IntermediateField.mem_inf, IntermediateField.mem_inf,
      h_mem_toSub, h_mem_toSub]
  have h_toSub_sup : ∀ (E₁ E₂ : IntermediateField F (AlgebraicClosure F))
      (hLE₁ : L ≤ E₁) (hEK₁ : E₁ ≤ K) (hLE₂ : L ≤ E₂) (hEK₂ : E₂ ≤ K),
      toSub (E₁ ⊔ E₂) (hLE₁.trans le_sup_left) = toSub E₁ hLE₁ ⊔ toSub E₂ hLE₂ := by
    intro E₁ E₂ hLE₁ hEK₁ hLE₂ hEK₂
    apply le_antisymm
    · let S' : IntermediateField L K' := toSub E₁ hLE₁ ⊔ toSub E₂ hLE₂
      let S : IntermediateField F (AlgebraicClosure F) := (S'.map K'.val).restrictScalars F
      have hE₁S : E₁ ≤ S := by
        intro x hx
        have h_le₁ : toSub E₁ hLE₁ ≤ S' := le_sup_left
        have hy : (⟨x, (IntermediateField.mem_extendScalars hLK).mpr (hEK₁ hx)⟩ : K') ∈ S' :=
          h_le₁ ((h_mem_toSub E₁ hLE₁ _).mpr hx)
        exact ⟨_, hy, rfl⟩
      have hE₂S : E₂ ≤ S := by
        intro x hx
        have h_le₂ : toSub E₂ hLE₂ ≤ S' := le_sup_right
        have hy : (⟨x, (IntermediateField.mem_extendScalars hLK).mpr (hEK₂ hx)⟩ : K') ∈ S' :=
          h_le₂ ((h_mem_toSub E₂ hLE₂ _).mpr hx)
        exact ⟨_, hy, rfl⟩
      have hsupS : E₁ ⊔ E₂ ≤ S := sup_le hE₁S hE₂S
      intro y hy
      have hyS : y.1 ∈ S := hsupS ((h_mem_toSub (E₁ ⊔ E₂) _ y).mp hy)
      rcases hyS with ⟨z, hz, hzy⟩
      have hzy' : z = y := Subtype.ext hzy
      rwa [← hzy']
    · exact sup_le
        ((h_toSub_le E₁ (E₁ ⊔ E₂) hLE₁ hEK₁ _).mpr le_sup_left)
        ((h_toSub_le E₂ (E₁ ⊔ E₂) hLE₂ hEK₂ _).mpr le_sup_right)
  let E' : IntermediateField L K' := toSub E hLE
  let M_C' : IntermediateField L K' := toSub M_C hLM_C
  let H : Subgroup G := E'.fixingSubgroup
  let C : Subgroup G := M_C'.fixingSubgroup
  have h_inf' : E' ⊓ M_C' = ⊥ := by
    rw [← h_toSub_inf E M_C hLE hLM_C, ← h_toSub_bot]
    apply le_antisymm
    · exact (h_toSub_le (E ⊓ M_C) L (le_inf hLE hLM_C) (inf_le_left.trans hEK) le_rfl).mpr (le_of_eq h_inf)
    · exact (h_toSub_le L (E ⊓ M_C) le_rfl hLK (le_inf hLE hLM_C)).mpr (le_of_eq h_inf.symm)
  have h_sup' : E' ⊔ M_C' = ⊤ := by
    rw [← h_toSub_sup E M_C hLE hEK hLM_C hM_CK, ← h_toSub_top]
    apply le_antisymm
    · exact (h_toSub_le (E ⊔ M_C) K (hLE.trans le_sup_left) (sup_le hEK hM_CK) hLK).mpr (le_of_eq h_sup)
    · exact (h_toSub_le K (E ⊔ M_C) hLK le_rfl (hLE.trans le_sup_left)).mpr (le_of_eq h_sup.symm)
  have helper_galois_lattice : ∀ (k K₀ : Type u) [Field k] [Field K₀] [Algebra k K₀]
      [FiniteDimensional k K₀] [IsGalois k K₀] (A B : IntermediateField k K₀),
      A ⊓ B = ⊥ → A ⊔ B = ⊤ →
      A.fixingSubgroup ⊔ B.fixingSubgroup = ⊤ ∧ A.fixingSubgroup ⊓ B.fixingSubgroup = ⊥ := by
    clear * -
    intro k K₀ _ _ _ _ _ A B h_ab_inf h_ab_sup
    refine ⟨?_, ?_⟩
    · let e := IsGalois.intermediateFieldEquivSubgroup (F := k) (E := K₀)
      have h1 : e (A ⊓ B) = e ⊥ := congrArg e h_ab_inf
      rw [OrderIso.map_inf, OrderIso.map_bot] at h1
      exact h1
    · have h1 : (A ⊔ B).fixingSubgroup = (⊤ : IntermediateField k K₀).fixingSubgroup :=
        congrArg IntermediateField.fixingSubgroup h_ab_sup
      rw [IntermediateField.fixingSubgroup_sup, IntermediateField.fixingSubgroup_top] at h1
      exact h1
  obtain ⟨h_sup_HC, h_inf_HC⟩ := helper_galois_lattice L K' E' M_C' h_inf' h_sup'
  obtain ⟨res, h_res_apply, h_res_surj⟩ : ∃ res : L.fixingSubgroup →* G,
      (∀ (σ : L.fixingSubgroup) (y : K'), ((res σ y : K') : AlgebraicClosure F) = σ.1 y.1) ∧
      Function.Surjective res := by
    refine ⟨(AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv L).toMonoidHom,
      fun σ y => ?_,
      (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
        (IntermediateField.fixingSubgroupEquiv L).surjective⟩
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv L) σ) y : K') : AlgebraicClosure F) = σ.1 y.1
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have h_res_fix : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A) (hAK : A ≤ K)
      (σ : L.fixingSubgroup),
      σ.1 ∈ A.fixingSubgroup ↔ res σ ∈ (toSub A hLA).fixingSubgroup := by
    intro A hLA hAK σ
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hσ y hy
      apply Subtype.ext
      rw [h_res_apply σ y]
      exact hσ y.1 ((h_mem_toSub A hLA y).mp hy)
    · intro hσ x hx
      let y : K' := ⟨x, (IntermediateField.mem_extendScalars hLK).mpr (hAK hx)⟩
      have hy : y ∈ toSub A hLA := (h_mem_toSub A hLA y).mpr hx
      have h1 := congrArg Subtype.val (hσ y hy)
      rwa [h_res_apply σ y] at h1
  have h_res_K : ∀ σ : L.fixingSubgroup, σ.1 ∈ K.fixingSubgroup ↔ res σ = 1 := by
    intro σ
    rw [h_res_fix K hLK le_rfl σ, h_toSub_top, IntermediateField.fixingSubgroup_top, Subgroup.mem_bot]
  have hC_norm : C.Normal := by
    refine ⟨fun c hc g => ?_⟩
    obtain ⟨σ, rfl⟩ := h_res_surj g
    obtain ⟨τ, rfl⟩ := h_res_surj c
    have hτM : τ.1 ∈ M_C.fixingSubgroup := (h_res_fix M_C hLM_C hM_CK τ).mpr hc
    have hconj : (σ * τ * σ⁻¹).1 ∈ M_C.fixingSubgroup := hGalMC.2.2.1 σ.1 σ.2 τ.1 hτM
    have hres_conj : res (σ * τ * σ⁻¹) = res σ * res τ * (res σ)⁻¹ := by
      rw [map_mul, map_mul, map_inv]
    rw [← hres_conj]
    exact (h_res_fix M_C hLM_C hM_CK (σ * τ * σ⁻¹)).mp hconj
  haveI : C.Normal := hC_norm
  let φ : H →* (G ⧸ C) := (QuotientGroup.mk' C).comp H.subtype
  have hφ_inj : Function.Injective φ := by
    intro h₁ h₂ h_eq
    have h1 : (QuotientGroup.mk (h₁ : G) : G ⧸ C) = QuotientGroup.mk (h₂ : G) := h_eq
    have h_mem_C : (h₁ : G)⁻¹ * (h₂ : G) ∈ C := QuotientGroup.eq.mp h1
    have h_mem_H : (h₁ : G)⁻¹ * (h₂ : G) ∈ H := H.mul_mem (H.inv_mem h₁.2) h₂.2
    have h_mem_inf : (h₁ : G)⁻¹ * (h₂ : G) ∈ H ⊓ C := ⟨h_mem_H, h_mem_C⟩
    rw [h_inf_HC, Subgroup.mem_bot] at h_mem_inf
    exact Subtype.ext (inv_mul_eq_one.mp h_mem_inf)
  have hφ_surj : Function.Surjective φ := by
    have hH_le : H ≤ φ.range.comap (QuotientGroup.mk' C) := by
      intro h hh
      rw [Subgroup.mem_comap]
      exact ⟨⟨h, hh⟩, rfl⟩
    have hC_le : C ≤ φ.range.comap (QuotientGroup.mk' C) := by
      intro c hc
      rw [Subgroup.mem_comap]
      have hc1 : (QuotientGroup.mk' C) c = 1 := (QuotientGroup.eq_one_iff c).mpr hc
      rw [hc1]
      exact φ.range.one_mem
    have htop_le : (⊤ : Subgroup G) ≤ φ.range.comap (QuotientGroup.mk' C) := by
      rw [← h_sup_HC]
      exact sup_le hH_le hC_le
    intro q
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective C q
    exact htop_le (Subgroup.mem_top g)
  let e_HC : H ≃* (G ⧸ C) := MulEquiv.ofBijective φ ⟨hφ_inj, hφ_surj⟩
  let π_L : relWeil F L →* G :=
    res.comp (Subgroup.inclusion (inf_le_right : relWeil F L ≤ L.fixingSubgroup))
  let W_KL : Subgroup (relWeil F L) := (relWeil F K).subgroupOf (relWeil F L)
  let bar_π_L : (relWeil F L ⧸ W_KL) → G := fun u => π_L (cosetRep u)
  have h_ker_π_L : ∀ w : relWeil F L, π_L w = 1 → w ∈ W_KL := by
    intro w hw
    rw [Subgroup.mem_subgroupOf]
    refine Subgroup.mem_inf.mpr ⟨w.2.1, ?_⟩
    exact (h_res_K ⟨w.1, w.2.2⟩).mpr hw
  have hbar_π_L_inj : Function.Injective bar_π_L := by
    intro u₁ u₂ h_eq
    change π_L (cosetRep u₁) = π_L (cosetRep u₂) at h_eq
    have h1 : π_L ((cosetRep u₁)⁻¹ * cosetRep u₂) = 1 := by
      rw [map_mul, map_inv, h_eq, inv_mul_cancel]
    have h2 : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ W_KL := h_ker_π_L _ h1
    have h3 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ W_KL) =
        QuotientGroup.mk (cosetRep u₂) := QuotientGroup.eq.mpr h2
    have h_out1 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ W_KL) = u₁ :=
      Quotient.out_eq u₁
    have h_out2 : (QuotientGroup.mk (cosetRep u₂) : relWeil F L ⧸ W_KL) = u₂ :=
      Quotient.out_eq u₂
    rw [h_out1, h_out2] at h3
    exact h3
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFin_quot, hCard_quot⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob L K hLK hSepLK
  letI : Finite (relWeil F L ⧸ W_KL) := hFin_quot
  letI : Fintype (relWeil F L ⧸ W_KL) := Fintype.ofFinite (relWeil F L ⧸ W_KL)
  have h_card_eq : Fintype.card (relWeil F L ⧸ W_KL) = Fintype.card G := by
    rw [← Nat.card_eq_fintype_card, hCard_quot, ← IsGalois.card_aut_eq_finrank L K',
      Nat.card_eq_fintype_card]
  have hbar_π_L_bij : Function.Bijective bar_π_L :=
    (Fintype.bijective_iff_injective_and_card bar_π_L).mpr ⟨hbar_π_L_inj, h_card_eq⟩
  have hπL_surj : Function.Surjective π_L := by
    intro g
    obtain ⟨u, hu⟩ := hbar_π_L_bij.2 g
    exact ⟨cosetRep u, hu⟩
  have helper_char_ext : ∀ {G₀ : Type u} [Group G₀] (π_L : relWeil F L →* G₀)
      (H₀ C₀ : Subgroup G₀) [C₀.Normal] (e_HC : H₀ ≃* (G₀ ⧸ C₀)),
      Function.Surjective π_L →
      (∀ w : relWeil F L, w.1 ∈ K.fixingSubgroup ↔ π_L w = 1) →
      (∀ w : relWeil F L, w.1 ∈ E.fixingSubgroup ↔ π_L w ∈ H₀) →
      (∀ h : H₀, e_HC h = QuotientGroup.mk' C₀ h.1) →
      ∃ χL_ext : relWeil F L →* (Ω F)ˣ,
        IsWeilRep F L (charRep F L χL_ext) ∧
        restrictWeilChar F hLE χL_ext = χE ∧
        restrictWeilChar F hLK χL_ext = restrictWeilChar F hLK χL := by
    clear * - hFin_Ω hFinK hχL h_rest
    intro G₀ _ π_L H₀ C₀ _ e_HC hπL_surj hπL_K hπL_E he_HC
    haveI : FiniteDimensional F K := hFinK
    let ι_LE : relWeil F E →* relWeil F L := Subgroup.inclusion (relWeil_antitone F hLE)
    have hπL_mem_H : ∀ w : relWeil F E, π_L (ι_LE w) ∈ H₀ :=
      fun w => (hπL_E (ι_LE w)).mp w.2.2
    let π_E : relWeil F E →* H₀ :=
      { toFun := fun w => ⟨π_L (ι_LE w), hπL_mem_H w⟩
        map_one' := Subtype.ext (by
          change π_L (ι_LE 1) = 1
          rw [map_one, map_one])
        map_mul' := fun w₁ w₂ => Subtype.ext (by
          change π_L (ι_LE (w₁ * w₂)) = π_L (ι_LE w₁) * π_L (ι_LE w₂)
          rw [map_mul, map_mul]) }
    obtain ⟨s_E, hs_E⟩ : ∃ s_E : H₀ → relWeil F E, ∀ h : H₀, π_E (s_E h) = h := by
      refine ⟨fun h => ⟨(hπL_surj h.1).choose.1, ⟨(hπL_surj h.1).choose.2.1, ?_⟩⟩, fun h => ?_⟩
      · have h1 : π_L (hπL_surj h.1).choose ∈ H₀ := by
          rw [(hπL_surj h.1).choose_spec]
          exact h.2
        exact (hπL_E (hπL_surj h.1).choose).mpr h1
      · apply Subtype.ext
        change π_L (hπL_surj h.1).choose = h.1
        exact (hπL_surj h.1).choose_spec
    let θ_E : relWeil F E →* (Ω F)ˣ := χE * (restrictWeilChar F hLE χL)⁻¹
    have h_theta_ker : ∀ w : relWeil F E, π_E w = 1 → θ_E w = 1 := by
      intro w hw
      have hw1 : π_L (ι_LE w) = 1 := congrArg Subtype.val hw
      have hwK : w.1 ∈ K.fixingSubgroup := (hπL_K (ι_LE w)).mpr hw1
      let w_K : relWeil F K := ⟨w.1, w.2.1, hwK⟩
      have h_eq_K : restrictWeilChar F hEK χE w_K = restrictWeilChar F hLK χL w_K :=
        congrArg (fun f => f w_K) h_rest
      change χE w * (χL (ι_LE w))⁻¹ = 1
      have h1 : restrictWeilChar F hEK χE w_K = χE w := rfl
      have h2 : restrictWeilChar F hLK χL w_K = χL (ι_LE w) := rfl
      rw [h1, h2] at h_eq_K
      rw [h_eq_K, mul_inv_cancel]
    have h_theta_eval : ∀ (w : relWeil F E) (h : H₀), π_E w = h → θ_E w = θ_E (s_E h) := by
      intro w h h_eq
      have h_ker : π_E ((s_E h)⁻¹ * w) = 1 := by
        rw [map_mul, map_inv, hs_E h, h_eq, inv_mul_cancel]
      have h_one : θ_E ((s_E h)⁻¹ * w) = 1 := h_theta_ker _ h_ker
      rw [map_mul, map_inv] at h_one
      exact (inv_mul_eq_one.mp h_one).symm
    obtain ⟨θ_bar_E, hθ_bar_E⟩ : ∃ θ_bar_E : H₀ →* (Ω F)ˣ, ∀ w : relWeil F E, θ_bar_E (π_E w) = θ_E w := by
      refine ⟨{
        toFun := fun h => θ_E (s_E h)
        map_one' := (h_theta_eval 1 1 (map_one π_E)).symm.trans (map_one θ_E)
        map_mul' := fun h₁ h₂ => (h_theta_eval (s_E h₁ * s_E h₂) (h₁ * h₂) (by
          rw [map_mul, hs_E h₁, hs_E h₂])).symm.trans (map_mul θ_E (s_E h₁) (s_E h₂))
      }, fun w => (h_theta_eval w (π_E w) rfl).symm⟩
    let θ_L : relWeil F L →* (Ω F)ˣ :=
      θ_bar_E.comp (e_HC.symm.toMonoidHom.comp ((QuotientGroup.mk' C₀).comp π_L))
    let χL_ext : relWeil F L →* (Ω F)ˣ := θ_L * χL
    have hχL_ext_E : restrictWeilChar F hLE χL_ext = χE := by
      apply MonoidHom.ext
      intro w
      have h_proj : (QuotientGroup.mk' C₀) (π_L (ι_LE w)) = e_HC (π_E w) :=
        (he_HC (π_E w)).symm
      have h_symm : e_HC.symm ((QuotientGroup.mk' C₀) (π_L (ι_LE w))) = π_E w := by
        rw [h_proj, e_HC.symm_apply_apply]
      have h_theta : θ_L (ι_LE w) = θ_E w := by
        change θ_bar_E (e_HC.symm ((QuotientGroup.mk' C₀) (π_L (ι_LE w)))) = θ_E w
        rw [h_symm, hθ_bar_E w]
      change θ_L (ι_LE w) * χL (ι_LE w) = χE w
      rw [h_theta]
      change χE w * (χL (ι_LE w))⁻¹ * χL (ι_LE w) = χE w
      exact inv_mul_cancel_right (χE w) (χL (ι_LE w))
    have hχL_ext_K : restrictWeilChar F hLK χL_ext = restrictWeilChar F hLK χL := by
      apply MonoidHom.ext
      intro w
      let ι_LK : relWeil F K →* relWeil F L := Subgroup.inclusion (relWeil_antitone F hLK)
      have h_π1 : π_L (ι_LK w) = 1 := (hπL_K (ι_LK w)).mp w.2.2
      have h_theta1 : θ_L (ι_LK w) = 1 := by
        change θ_bar_E (e_HC.symm ((QuotientGroup.mk' C₀) (π_L (ι_LK w)))) = 1
        rw [h_π1, map_one, map_one, map_one]
      change θ_L (ι_LK w) * χL (ι_LK w) = χL (ι_LK w)
      rw [h_theta1, one_mul]
    have hχL_ext_weil : IsWeilRep F L (charRep F L χL_ext) := by
      obtain ⟨_, U_χL, hU_nhds, hU_triv⟩ := hχL
      have hUK_nhds : (K.fixingSubgroup : Set (AbsGal F)) ∈ nhds (1 : AbsGal F) := by
        rw [krullTopology_mem_nhds_one_iff]
        exact ⟨K, inferInstance, Set.Subset.rfl⟩
      refine ⟨hFin_Ω, U_χL ∩ (K.fixingSubgroup : Set (AbsGal F)),
        Filter.inter_mem hU_nhds hUK_nhds, fun w hw hwI => ?_⟩
      have h_χL_1 : χL w = 1 := by
        have h1 := hU_triv w hw.1 hwI
        have h2 : (charRep F L χL w (ULift.up (1 : Ω F))).down =
            ((1 : ULift.{u} (Ω F) →ₗ[Ω F] ULift.{u} (Ω F)) (ULift.up (1 : Ω F))).down :=
          congrArg (fun (f : ULift.{u} (Ω F) →ₗ[Ω F] ULift.{u} (Ω F)) =>
            (f (ULift.up (1 : Ω F))).down) h1
        change (χL w : Ω F) * 1 = 1 at h2
        rw [mul_one] at h2
        exact Units.ext h2
      have h_π1 : π_L w = 1 := (hπL_K w).mp hw.2
      have h_θL_1 : θ_L w = 1 := by
        change θ_bar_E (e_HC.symm ((QuotientGroup.mk' C₀) (π_L w))) = 1
        rw [h_π1, map_one, map_one, map_one]
      have h_ext_1 : χL_ext w = 1 := by
        change θ_L w * χL w = 1
        rw [h_θL_1, h_χL_1, mul_one]
      change (χL_ext w : Ω F) • LinearMap.id = 1
      rw [h_ext_1, Units.val_one, one_smul]
      rfl
    exact ⟨χL_ext, hχL_ext_weil, hχL_ext_E, hχL_ext_K⟩
  exact helper_char_ext π_L H C e_HC hπL_surj
    (fun w => h_res_K ⟨w.1, w.2.2⟩)
    (fun w => h_res_fix E hLE hEK ⟨w.1, w.2.2⟩)
    (fun _ => rfl)

theorem ld_ch15_twist_monomial_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLE : L ≤ E) (ψ : AddChar L (Ω F))
    (χL χL_ext : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ)
    (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (hχL_ext_E : restrictWeilChar F hLE χL_ext = χE)
    (hχL_ext_K : restrictWeilChar F hLK χL_ext = restrictWeilChar F hLK χL)
    (D₀ : List (MonomialTerm F L))
    (hD₀_sub : IsSubMonomialDecomp F L M_C E hLE D₀)
    (hD₀_rest1 : ∀ t ∈ D₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) :
    let D_t := D₀.map (twistMonomialTerm F L χL_ext)
    IsMonomialDecomp F L
      (fun w => (⟨1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w) D_t ∧
    (∀ s ∈ D_t, s.field ≤ M_C) ∧
    (∀ s ∈ D_t, ∃ hsK : s.field ≤ K,
      restrictWeilChar F hsK s.χ = restrictWeilChar F hLK χL) ∧
    (∀ g : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ,
      evalMonomialList F rec (fun _ E' _ => g E') L ψ D_t *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
      evalMonomialList F rec (fun _ _ _ => 1) L ψ D_t *
        evalMonomialList F rec (fun _ E' _ => g E') L ψ D₀) :=
by
  have h_abstract_ind_trace : ∀ {k : Type} [Field k] {G : Type u} [Group G]
      (H : Subgroup G) {V : Type u} [AddCommGroup V] [Module k V]
      (ρ₁ ρ₂ : Representation k H V) (χ : G →* kˣ),
      (∀ (h : H) (v : V), ρ₂ h v = (χ (h : G) : k) • ρ₁ h v) →
      ∀ w : G,
        LinearMap.trace k (indSpace H ρ₂) (indRep H ρ₂ w) =
          (χ w : k) * LinearMap.trace k (indSpace H ρ₁) (indRep H ρ₁ w) := by
    clear * -
    intro k _ G _ H V _ _ ρ₁ ρ₂ χ hρ w
    obtain ⟨Ψ, hΨ_conj⟩ : ∃ Ψ : indSpace H ρ₁ ≃ₗ[k] indSpace H ρ₂,
        indRep H ρ₂ w = (χ w : k) • (Ψ.conj (indRep H ρ₁ w)) := by
      let Ψ₀ : indSpace H ρ₁ ≃ₗ[k] indSpace H ρ₂ :=
        { toFun := fun f =>
            ⟨fun x => (χ x : k) • f.1 x, fun h x => by
              change (χ ((h : G) * x) : k) • f.1 ((h : G) * x) =
                ρ₂ h ((χ x : k) • f.1 x)
              rw [f.2 h x, (ρ₂ h).map_smul, hρ h (f.1 x), map_mul, Units.val_mul,
                mul_comm (χ (h : G) : k) (χ x : k), mul_smul]⟩
          invFun := fun g =>
            ⟨fun x => (((χ x)⁻¹ : kˣ) : k) • g.1 x, fun h x => by
              change (((χ ((h : G) * x))⁻¹ : kˣ) : k) • g.1 ((h : G) * x) =
                ρ₁ h ((((χ x)⁻¹ : kˣ) : k) • g.1 x)
              have h_inv : (χ ((h : G) * x))⁻¹ * χ (h : G) = (χ x)⁻¹ := by
                rw [map_mul, mul_inv_rev, inv_mul_cancel_right]
              rw [g.2 h x, hρ h (g.1 x), (ρ₁ h).map_smul, smul_smul, ← Units.val_mul, h_inv]⟩
          left_inv := fun f => Subtype.ext (funext fun x => by
            change (((χ x)⁻¹ : kˣ) : k) • ((χ x : k) • f.1 x) = f.1 x
            rw [smul_smul, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul])
          right_inv := fun g => Subtype.ext (funext fun x => by
            change (χ x : k) • ((((χ x)⁻¹ : kˣ) : k) • g.1 x) = g.1 x
            rw [smul_smul, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_smul])
          map_add' := fun f₁ f₂ => Subtype.ext (funext fun x =>
            smul_add (χ x : k) (f₁.1 x) (f₂.1 x))
          map_smul' := fun c f => Subtype.ext (funext fun x =>
            smul_comm (χ x : k) c (f.1 x)) }
      refine ⟨Ψ₀, ?_⟩
      apply LinearMap.ext
      intro g
      apply Subtype.ext
      funext x
      change g.1 (x * w) =
        (χ w : k) • ((χ x : k) • ((((χ (x * w))⁻¹ : kˣ) : k) • g.1 (x * w)))
      have h_unit : χ w * χ x * (χ (x * w))⁻¹ = 1 := by
        rw [map_mul, mul_comm (χ w) (χ x), mul_inv_cancel]
      rw [← mul_smul, ← mul_smul, ← Units.val_mul, ← Units.val_mul, h_unit, Units.val_one, one_smul]
    rw [hΨ_conj, map_smul, LinearMap.trace_conj', smul_eq_mul]
  have h_comm4 : ∀ {G₀ : Type} [CommGroup G₀] (x₁ x₂ y z₁ z₂ z₃ z₄ : G₀),
      z₁ * z₂ = z₃ * z₄ →
      (x₁ * y * z₁) * (x₂ * z₂) = (x₁ * z₃) * (x₂ * y * z₄) := by
    clear * -
    intro G₀ _ x₁ x₂ y z₁ z₂ z₃ z₄ hz
    calc (x₁ * y * z₁) * (x₂ * z₂)
        = x₁ * (y * (z₁ * (x₂ * z₂))) := by rw [mul_assoc, mul_assoc]
      _ = x₁ * (y * (x₂ * (z₁ * z₂))) := by rw [mul_left_comm z₁ x₂ z₂]
      _ = x₁ * (x₂ * (y * (z₁ * z₂))) := by rw [mul_left_comm y x₂ (z₁ * z₂)]
      _ = (x₁ * x₂ * y) * (z₁ * z₂) := by rw [← mul_assoc, ← mul_assoc]
      _ = (x₁ * x₂ * y) * (z₃ * z₄) := congrArg ((x₁ * x₂ * y) * ·) hz
      _ = x₁ * ((x₂ * y) * (z₃ * z₄)) := by rw [mul_assoc x₁ x₂ y, mul_assoc]
      _ = x₁ * (z₃ * ((x₂ * y) * z₄)) := by rw [mul_left_comm (x₂ * y) z₃ z₄]
      _ = (x₁ * z₃) * (x₂ * y * z₄) := by rw [← mul_assoc]
  have htwist_wf : ∀ t : MonomialTerm F L,
      t.Wf F L → (twistMonomialTerm F L χL_ext t).Wf F L := by
    intro t ht
    refine ⟨ht.1, ht.2.1, ht.2.2.1, ?_⟩
    rcases ht.2.2.2 with ⟨U₁, hU₁, htriv₁⟩
    rcases hχL_ext.2 with ⟨U₂, hU₂, htriv₂⟩
    refine ⟨U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    let w_L : relWeil F L := Subgroup.inclusion (relWeil_antitone F t.le) w
    have h1 : charRep F t.field t.χ w = 1 := htriv₁ w hw.1 hwI
    have h1_val : (t.χ w : Ω F) = 1 := by
      have hev := congrArg (fun f : Module.End (Ω F) (ULift.{u} (Ω F)) => (f (ULift.up 1)).down) h1
      change (t.χ w : Ω F) * 1 = 1 at hev
      rwa [mul_one] at hev
    have h2 : charRep F L χL_ext w_L = 1 := htriv₂ w_L hw.2 hwI
    have h2_val : (restrictWeilChar F t.le χL_ext w : Ω F) = 1 := by
      have hev := congrArg (fun f : Module.End (Ω F) (ULift.{u} (Ω F)) => (f (ULift.up 1)).down) h2
      change (χL_ext w_L : Ω F) * 1 = 1 at hev
      rw [mul_one] at hev
      exact hev
    have h_mul_val : ((t.χ * restrictWeilChar F t.le χL_ext) w : Ω F) = 1 := by
      change (t.χ w : Ω F) * (restrictWeilChar F t.le χL_ext w : Ω F) = 1
      rw [h1_val, h2_val, mul_one]
    change ((t.χ * restrictWeilChar F t.le χL_ext) w : Ω F) • LinearMap.id = 1
    rw [h_mul_val, one_smul]
    rfl
  have htwist_trace : ∀ (t : MonomialTerm F L) (w : relWeil F L),
      (twistMonomialTerm F L χL_ext t).trace F L w =
        (χL_ext w : Ω F) * t.trace F L w := by
    intro t w
    let M := t.field
    let hLM := t.le
    let χ₁ := t.χ
    let χ₂ := t.χ * restrictWeilChar F hLM χL_ext
    let H_M : Subgroup (relWeil F L) := (relWeil F M).subgroupOf (relWeil F L)
    let e_M : H_M ≃* relWeil F M := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLM)
    let ρ₁ : Representation (Ω F) H_M (ULift.{u} (Ω F)) :=
      (charRep F M χ₁).comp e_M.toMonoidHom
    let ρ₂ : Representation (Ω F) H_M (ULift.{u} (Ω F)) :=
      (charRep F M χ₂).comp e_M.toMonoidHom
    have hρ : ∀ (h : H_M) (v : ULift.{u} (Ω F)),
        ρ₂ h v = (χL_ext (h : relWeil F L) : Ω F) • ρ₁ h v := by
      intro h v
      change ((χ₁ (e_M h) : Ω F) * (χL_ext (h : relWeil F L) : Ω F)) • v =
        (χL_ext (h : relWeil F L) : Ω F) • ((χ₁ (e_M h) : Ω F) • v)
      rw [mul_comm (χ₁ (e_M h) : Ω F), mul_smul]
    have htr_ind : LinearMap.trace (Ω F) (indSpace H_M ρ₂) (indRep H_M ρ₂ w) =
        (χL_ext w : Ω F) * LinearMap.trace (Ω F) (indSpace H_M ρ₁) (indRep H_M ρ₁ w) :=
      h_abstract_ind_trace H_M ρ₁ ρ₂ χL_ext hρ w
    calc (twistMonomialTerm F L χL_ext t).trace F L w
        = t.coeff • LinearMap.trace (Ω F) (indSpace H_M ρ₂) (indRep H_M ρ₂ w) := rfl
      _ = t.coeff • ((χL_ext w : Ω F) * LinearMap.trace (Ω F) (indSpace H_M ρ₁) (indRep H_M ρ₁ w)) :=
          congrArg (t.coeff • ·) htr_ind
      _ = (t.coeff : Ω F) * ((χL_ext w : Ω F) * LinearMap.trace (Ω F) (indSpace H_M ρ₁) (indRep H_M ρ₁ w)) :=
          zsmul_eq_mul _ _
      _ = (χL_ext w : Ω F) * ((t.coeff : Ω F) * LinearMap.trace (Ω F) (indSpace H_M ρ₁) (indRep H_M ρ₁ w)) :=
          mul_left_comm _ _ _
      _ = (χL_ext w : Ω F) * (t.coeff • LinearMap.trace (Ω F) (indSpace H_M ρ₁) (indRep H_M ρ₁ w)) :=
          congrArg ((χL_ext w : Ω F) * ·) (zsmul_eq_mul _ _).symm
      _ = (χL_ext w : Ω F) * t.trace F L w := rfl
  have htwist_list_trace : ∀ (D : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (D.map (twistMonomialTerm F L χL_ext)) w =
        (χL_ext w : Ω F) * monomialListTrace F L D w := by
    intro D w
    induction D with
    | nil =>
      change (0 : Ω F) = (χL_ext w : Ω F) * 0
      exact (mul_zero _).symm
    | cons t tl ih =>
      change (twistMonomialTerm F L χL_ext t).trace F L w +
          monomialListTrace F L (tl.map (twistMonomialTerm F L χL_ext)) w =
        (χL_ext w : Ω F) * (t.trace F L w + monomialListTrace F L tl w)
      exact (congrArg₂ (· + ·) (htwist_trace t w) ih).trans (mul_add _ _ _).symm
  intro D_t
  have hDt_decomp : IsMonomialDecomp F L
      (fun w => (⟨1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w) D_t := by
    refine ⟨?_, ?_⟩
    · intro s hs
      rcases List.mem_map.mp hs with ⟨t, ht, rfl⟩
      exact htwist_wf t (hD₀_sub.1.1 t ht)
    · intro w
      have h_term_eq : (⟨1, E, hLE, χE⟩ : MonomialTerm F L) =
          twistMonomialTerm F L χL_ext ⟨1, E, hLE, 1⟩ :=
        congrArg (MonomialTerm.mk 1 E hLE)
          (hχL_ext_E.symm.trans (one_mul (restrictWeilChar F hLE χL_ext)).symm)
      have h_tr_eq1 : (⟨1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w =
          (twistMonomialTerm F L χL_ext ⟨1, E, hLE, 1⟩).trace F L w :=
        congrArg (fun s : MonomialTerm F L => s.trace F L w) h_term_eq
      have h_tr_eq2 : (twistMonomialTerm F L χL_ext ⟨1, E, hLE, 1⟩).trace F L w =
          (χL_ext w : Ω F) * (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w :=
        htwist_trace ⟨1, E, hLE, 1⟩ w
      have h_tr_eq3 : (χL_ext w : Ω F) * (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w =
          (χL_ext w : Ω F) * monomialListTrace F L D₀ w :=
        congrArg ((χL_ext w : Ω F) * ·) (hD₀_sub.1.2 w)
      exact (h_tr_eq1.trans (h_tr_eq2.trans h_tr_eq3)).trans (htwist_list_trace D₀ w).symm
  have hDt_le : ∀ s ∈ D_t, s.field ≤ M_C := by
    intro s hs
    rcases List.mem_map.mp hs with ⟨t, ht, rfl⟩
    exact hD₀_sub.2 t ht
  have hDt_rest : ∀ s ∈ D_t, ∃ hsK : s.field ≤ K,
      restrictWeilChar F hsK s.χ = restrictWeilChar F hLK χL := by
    intro s hs
    rcases List.mem_map.mp hs with ⟨t, ht, rfl⟩
    obtain ⟨htK, hrest1⟩ := hD₀_rest1 t ht
    refine ⟨htK, ?_⟩
    apply MonoidHom.ext
    intro w
    have h_rest_t : restrictWeilChar F htK t.χ w = 1 :=
      congrFun (congrArg DFunLike.coe hrest1) w
    have h_rest_ext : restrictWeilChar F htK (restrictWeilChar F t.le χL_ext) w =
        restrictWeilChar F hLK χL w := by
      have h_eq : restrictWeilChar F htK (restrictWeilChar F t.le χL_ext) =
          restrictWeilChar F hLK χL_ext := rfl
      rw [h_eq, hχL_ext_K]
    change restrictWeilChar F htK t.χ w *
      restrictWeilChar F htK (restrictWeilChar F t.le χL_ext) w =
      restrictWeilChar F hLK χL w
    rw [h_rest_t, h_rest_ext, one_mul]
  have hDt_factor : ∀ g : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ,
      evalMonomialList F rec (fun _ E' _ => g E') L ψ D_t *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
      evalMonomialList F rec (fun _ _ _ => 1) L ψ D_t *
        evalMonomialList F rec (fun _ E' _ => g E') L ψ D₀ := by
    intro g
    have h_term_factor : ∀ s : MonomialTerm F L,
        evalMonomialTerm F rec (fun _ E' _ => g E') L ψ s =
          evalMonomialTerm F rec (fun _ _ _ => 1) L ψ s * (g s.field) ^ s.coeff := by
      intro s
      unfold evalMonomialTerm
      rw [mul_one, mul_zpow]
    have h_list_factor : ∀ D : List (MonomialTerm F L),
        evalMonomialList F rec (fun _ E' _ => g E') L ψ (D.map (twistMonomialTerm F L χL_ext)) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ D =
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (D.map (twistMonomialTerm F L χL_ext)) *
          evalMonomialList F rec (fun _ E' _ => g E') L ψ D := by
      intro D
      induction D with
      | nil => rfl
      | cons t tl ih =>
        let t' := twistMonomialTerm F L χL_ext t
        have h_head_t' : evalMonomialTerm F rec (fun _ E' _ => g E') L ψ t' =
            evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t' * (g t.field) ^ t.coeff :=
          h_term_factor t'
        have h_head_t : evalMonomialTerm F rec (fun _ E' _ => g E') L ψ t =
            evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t * (g t.field) ^ t.coeff :=
          h_term_factor t
        change (evalMonomialTerm F rec (fun _ E' _ => g E') L ψ t' *
            evalMonomialList F rec (fun _ E' _ => g E') L ψ (tl.map (twistMonomialTerm F L χL_ext))) *
          (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ tl) =
          (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t' *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ (tl.map (twistMonomialTerm F L χL_ext))) *
          (evalMonomialTerm F rec (fun _ E' _ => g E') L ψ t *
            evalMonomialList F rec (fun _ E' _ => g E') L ψ tl)
        rw [h_head_t', h_head_t]
        exact h_comm4 _ _ _ _ _ _ _ ih
    exact h_list_factor D₀
  exact ⟨hDt_decomp, hDt_le, hDt_rest, hDt_factor⟩

theorem ld_ch15_candLam_normal_descent_and_ratio (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K) (h_sup : E ⊔ M_C = K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ)
    (hWeil1E : IsWeilRep F E (charRep F E 1))
    (hχE : IsWeilRep F E (charRep F E χE))
    (hχL_ext_E : restrictWeilChar F hLE χL_ext = χE)
    (D₀ : List (MonomialTerm F L))
    (hD₀_sub : IsSubMonomialDecomp F L M_C E hLE D₀)
    (hD₀_K₁ : ∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
      L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
      ∀ t ∈ D₀, t.field ≤ K₁)
    (hDt_decomp : IsMonomialDecomp F L
      (fun w => (⟨1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w)
      (D₀.map (twistMonomialTerm F L χL_ext)))
    (hDt_factor : ∀ g : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ,
      evalMonomialList F rec (fun _ E' _ => g E') L ψ (D₀.map (twistMonomialTerm F L χL_ext)) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (D₀.map (twistMonomialTerm F L χL_ext)) *
        evalMonomialList F rec (fun _ E' _ => g E') L ψ D₀)
    (hOr : (∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
        K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
        Module.finrank L (IntermediateField.extendScalars hLK₁) <
          Module.finrank L (IntermediateField.extendScalars hLK)) ∨
      tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
      tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (D₀.map (twistMonomialTerm F L χL_ext))) :
    evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, χE⟩ =
      evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
        (D₀.map (twistMonomialTerm F L χL_ext)) :=
by
  let D_t := D₀.map (twistMonomialTerm F L χL_ext)
  have htrace_append : ∀ (D₁ D₂ : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (D₁ ++ D₂) w =
        monomialListTrace F L D₁ w + monomialListTrace F L D₂ w := by
    intro D₁ D₂ w
    simp [monomialListTrace, List.map_append, List.sum_append]
  have htrace_neg : ∀ (D : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (D.map (MonomialTerm.neg F L)) w =
        - monomialListTrace F L D w := by
    intro D w
    induction D with
    | nil => simp [monomialListTrace]
    | cons t tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F L).trace F L w = - (t.trace F L w) := by
        simp [MonomialTerm.neg, MonomialTerm.trace, neg_smul]
      rw [ht, ih]
      ring
  have heval_append : ∀ (lam : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ)
      (D₁ D₂ : List (MonomialTerm F L)),
      evalMonomialList F rec lam L ψ (D₁ ++ D₂) =
        evalMonomialList F rec lam L ψ D₁ * evalMonomialList F rec lam L ψ D₂ := by
    intro lam D₁ D₂
    simp [evalMonomialList, List.map_append, List.prod_append]
  have heval_neg : ∀ (lam : ∀ (L E : IntermediateField F (AlgebraicClosure F)), AddChar L (Ω F) → (Ω F)ˣ)
      (D : List (MonomialTerm F L)),
      evalMonomialList F rec lam L ψ (D.map (MonomialTerm.neg F L)) =
        (evalMonomialList F rec lam L ψ D)⁻¹ := by
    intro lam D
    induction D with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have ht : evalMonomialTerm F rec lam L ψ (t.neg F L) =
          (evalMonomialTerm F rec lam L ψ t)⁻¹ := by
        simp [MonomialTerm.neg, evalMonomialTerm, zpow_neg]
      rw [ht, ih, mul_inv]
  have hLamMC : IsLambdaFuncOn F rec L M_C ψ (galoisLam F rec L M_C ψ) :=
    hTheory.1 L M_C hLM_C hMin.1 hMin.2.2.1 ψ hψ
  have hD_ex : ∃ D₀' : List (MonomialTerm F L), IsSubMonomialDecomp F L M_C E hLE D₀' :=
    ⟨D₀, hD₀_sub⟩
  have h_cand : candLamFrom F rec L M_C ψ E =
      (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ))⁻¹ *
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₀ := by
    have h_def : candLamFrom F rec L M_C ψ E =
        (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ))⁻¹ *
          evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ hD_ex.choose := by
      unfold candLamFrom
      rw [dif_pos hLE, dif_pos hD_ex]
    rw [h_def]
    congr 1
    set D₁ := hD_ex.choose
    have hD₁ : IsSubMonomialDecomp F L M_C E hLE D₁ := hD_ex.choose_spec
    have hzero : IsMonomialDecomp F L 0 (D₁ ++ D₀.map (MonomialTerm.neg F L)) := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rw [List.mem_append] at ht
        rcases ht with ht | ht
        · exact hD₁.1.1 t ht
        · rw [List.mem_map] at ht
          rcases ht with ⟨t₀, ht₀, rfl⟩
          exact hD₀_sub.1.1 t₀ ht₀
      · intro w
        rw [Pi.zero_apply, htrace_append, htrace_neg, ← hD₁.1.2 w, ← hD₀_sub.1.2 w, add_neg_cancel]
    have hle_MC : ∀ t ∈ D₁ ++ D₀.map (MonomialTerm.neg F L), t.field ≤ M_C := by
      intro t ht
      rw [List.mem_append] at ht
      rcases ht with ht | ht
      · exact hD₁.2 t ht
      · rw [List.mem_map] at ht
        rcases ht with ⟨t₀, ht₀, rfl⟩
        exact hD₀_sub.2 t₀ ht₀
    have hprod := hLamMC.2 (D₁ ++ D₀.map (MonomialTerm.neg F L)) hzero hle_MC
    rw [heval_append, heval_neg] at hprod
    exact mul_inv_eq_one.mp hprod
  have hSep_sub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A),
      A ≤ K → Algebra.IsSeparable L (IntermediateField.extendScalars hLA) := by
    intro A hLA hAK
    let K' := IntermediateField.extendScalars hLK
    have hSepK : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    refine ⟨fun x => ?_⟩
    let y : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr
      (hAK ((IntermediateField.mem_extendScalars hLA).mp x.2))⟩
    have hy : IsSeparable L y := @Algebra.IsSeparable.isSeparable L K' _ _ _ hSepK y
    have hmin_x : minpoly L (x.1 : AlgebraicClosure F) = minpoly L x :=
      minpoly.algHom_eq (IntermediateField.extendScalars hLA).val
        (IntermediateField.extendScalars hLA).val.injective x
    have hmin_y : minpoly L (y.1 : AlgebraicClosure F) = minpoly L y :=
      minpoly.algHom_eq K'.val K'.val.injective y
    change (minpoly L x).Separable
    rw [← hmin_x]
    change (minpoly L (y.1 : AlgebraicClosure F)).Separable
    rw [hmin_y]
    exact hy
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  let S : IntermediateField L (AlgebraicClosure F) := separableClosure L (AlgebraicClosure F)
  haveI : IsGalois L S := separableClosure.isGalois L (AlgebraicClosure F)
  haveI : Normal L S := IsGalois.to_normal
  have hGal_stable : ∀ (M : IntermediateField F (AlgebraicClosure F)),
      IsGaloisExt F L M → ∀ σ ∈ L.fixingSubgroup, ∀ x ∈ M, σ x ∈ M := by
    intro M hGalM σ hσ x hx
    have hLM : L ≤ M := hGalM.1
    let M' := IntermediateField.extendScalars hLM
    have hSepM : Algebra.IsSeparable L M' := hGalM.2.2.2 hLM
    have hMS : ∀ z ∈ M, z ∈ S := by
      intro z hz
      rw [mem_separableClosure_iff]
      let u : M' := ⟨z, (IntermediateField.mem_extendScalars hLM).mpr hz⟩
      have hu : IsSeparable L u := @Algebra.IsSeparable.isSeparable L M' _ _ _ hSepM u
      change (minpoly L (M'.val u)).Separable
      rw [minpoly.algHom_eq M'.val M'.val.injective u]
      exact hu
    let M_S : IntermediateField L S := M'.comap S.val
    have hmem_MS : ∀ y : S, y ∈ M_S ↔ (y : AlgebraicClosure F) ∈ M :=
      fun y => IntermediateField.mem_extendScalars hLM
    let σ_L : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F :=
      (IntermediateField.fixingSubgroupEquiv L) ⟨σ, hσ⟩
    let y_x : S := ⟨x, hMS x hx⟩
    let y' : S := (AlgEquiv.restrictNormalHom S σ_L) y_x
    have hy'_val : (y' : AlgebraicClosure F) = σ x :=
      AlgEquiv.restrictNormalHom_apply S σ_L y_x
    rw [← hy'_val, ← hmem_MS y', ← InfiniteGalois.fixedField_fixingSubgroup M_S,
      IntermediateField.mem_fixedField_iff]
    intro g hg
    obtain ⟨τ_L, rfl⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) g
    let τ : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ_L
    have hτ_apply : ∀ z : AlgebraicClosure F, τ.1 z = τ_L z := fun _ => rfl
    have hτ_M : τ.1 ∈ M.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro z hz
      let y_z : S := ⟨z, hMS z hz⟩
      have hy_z : y_z ∈ M_S := (hmem_MS y_z).mpr hz
      have hgz : (AlgEquiv.restrictNormalHom S τ_L) y_z = y_z :=
        (IntermediateField.mem_fixingSubgroup_iff _ _).mp hg y_z hy_z
      have hgz_val : (((AlgEquiv.restrictNormalHom S τ_L) y_z : S) : AlgebraicClosure F) = z :=
        congrArg Subtype.val hgz
      rw [AlgEquiv.restrictNormalHom_apply] at hgz_val
      rw [hτ_apply]
      exact hgz_val
    have hconj : σ⁻¹ * τ.1 * σ ∈ M.fixingSubgroup :=
      hGalM.2.2.1 σ⁻¹ (Subgroup.inv_mem _ hσ) τ.1 hτ_M
    have hfix_x : (σ⁻¹ * τ.1 * σ) x = x :=
      (IntermediateField.mem_fixingSubgroup_iff _ _).mp hconj x hx
    have hτ_σx : τ_L (σ x) = σ x := by
      rw [← hτ_apply]
      calc τ.1 (σ x)
        _ = σ (σ⁻¹ (τ.1 (σ x))) := (σ.apply_symm_apply _).symm
        _ = σ ((σ⁻¹ * τ.1 * σ) x) := rfl
        _ = σ x := by rw [hfix_x]
    apply Subtype.ext
    rw [AlgEquiv.restrictNormalHom_apply, hy'_val, hτ_σx]
  rcases hOr with ⟨K₁, hLK₁, hK₁K, hGal₁, hEK₁, hlt₁⟩ | hRatio
  · have hsup₁ : K₁ ⊔ M_C = K := by
      rcases hMin.2.2.2.1 K₁ hLK₁ hK₁K hGal₁ with hK₁MC | hsup₁
      · exfalso
        have hEMC : E ≤ M_C := hEK₁.trans hK₁MC
        have hKMC : K ≤ M_C := h_sup ▸ sup_le hEMC le_rfl
        have hMC_eq : M_C = K := le_antisymm hM_CK hKMC
        subst hMC_eq
        exact (lt_irrefl _ hMin.2.2.1)
      · exact hsup₁
    have hD₀_le_K₁ : ∀ t ∈ D₀, t.field ≤ K₁ :=
      hD₀_K₁ K₁ hLK₁ hK₁K hGal₁ hEK₁ hsup₁
    set N : IntermediateField F (AlgebraicClosure F) := K₁ ⊓ M_C
    have hLN : L ≤ N := le_inf hLK₁ hLM_C
    have hNK₁ : N ≤ K₁ := inf_le_left
    have hNM_C : N ≤ M_C := inf_le_right
    haveI : FiniteDimensional F K := hGal.2.1
    haveI : FiniteDimensional F L :=
      Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
        (IntermediateField.inclusion hLK).injective
    haveI : FiniteDimensional F M_C := hMin.1.2.1
    haveI : FiniteDimensional F N :=
      Module.Finite.of_injective (IntermediateField.inclusion hNM_C).toLinearMap
        (IntermediateField.inclusion hNM_C).injective
    have hGalN : IsGaloisExt F L N := by
      refine ⟨hLN, inferInstance, ?_, fun h => hSep_sub N h (hNM_C.trans hM_CK)⟩
      intro σ hσ τ hτ
      rw [IntermediateField.mem_fixingSubgroup_iff] at hτ ⊢
      intro z hz
      have hσ_inv : σ⁻¹ ∈ L.fixingSubgroup := Subgroup.inv_mem _ hσ
      have h_inv_N : σ⁻¹ z ∈ N :=
        ⟨hGal_stable K₁ hGal₁ σ⁻¹ hσ_inv z (hNK₁ hz),
         hGal_stable M_C hMin.1 σ⁻¹ hσ_inv z (hNM_C hz)⟩
      calc (σ * τ * σ⁻¹) z
        _ = σ (τ (σ⁻¹ z)) := rfl
        _ = σ (σ⁻¹ z) := by rw [hτ (σ⁻¹ z) h_inv_N]
        _ = z := σ.apply_symm_apply z
    have hltN : Module.finrank L (IntermediateField.extendScalars hLN) <
        Module.finrank L (IntermediateField.extendScalars hLK) := by
      haveI : IsScalarTower F L (IntermediateField.extendScalars hLN) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower F L (IntermediateField.extendScalars hLM_C) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hmul0 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLN) =
          Module.finrank F N :=
        Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLN)
      have hmulC : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM_C) =
          Module.finrank F M_C :=
        Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLM_C)
      have hfin_le : Module.finrank F N ≤ Module.finrank F M_C :=
        LinearMap.finrank_le_finrank_of_injective
          (f := (IntermediateField.inclusion hNM_C).toLinearMap)
          (IntermediateField.inclusion hNM_C).injective
      have hposL : 0 < Module.finrank F L := Module.finrank_pos
      have hle_L : Module.finrank L (IntermediateField.extendScalars hLN) ≤
          Module.finrank L (IntermediateField.extendScalars hLM_C) := by
        apply Nat.le_of_mul_le_mul_left _ hposL
        rw [hmul0, hmulC]
        exact hfin_le
      exact lt_of_le_of_lt hle_L hMin.2.2.1
    have hLamK₁ : IsLambdaFuncOn F rec L K₁ ψ (galoisLam F rec L K₁ ψ) :=
      hTheory.1 L K₁ hLK₁ hGal₁ hlt₁ ψ hψ
    have hLamMC_on_N : IsLambdaFuncOn F rec L N ψ (galoisLam F rec L M_C ψ) :=
      ⟨hLamMC.1, fun D hD hle => hLamMC.2 D hD (fun t ht => (hle t ht).trans hNM_C)⟩
    have hLamK₁_on_N : IsLambdaFuncOn F rec L N ψ (galoisLam F rec L K₁ ψ) :=
      ⟨hLamK₁.1, fun D hD hle => hLamK₁.2 D hD (fun t ht => (hle t ht).trans hNK₁)⟩
    have h_eq_on_N : ∀ E', L ≤ E' → E' ≤ N →
        galoisLam F rec L M_C ψ E' = galoisLam F rec L K₁ ψ E' := by
      intro E' hLE' hE'N
      have h1 := hTheory.2.1 L N hLN hGalN hltN ψ hψ (galoisLam F rec L M_C ψ) hLamMC_on_N E' hLE' hE'N
      have h2 := hTheory.2.1 L N hLN hGalN hltN ψ hψ (galoisLam F rec L K₁ ψ) hLamK₁_on_N E' hLE' hE'N
      exact h1.trans h2.symm
    have h_eval_D₀_eq :
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₀ =
          evalMonomialList F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ D₀ := by
      unfold evalMonomialList
      congr 1
      apply List.map_congr_left
      intro t ht
      unfold evalMonomialTerm
      dsimp only
      rw [h_eq_on_N t.field t.le (le_inf (hD₀_le_K₁ t ht) (hD₀_sub.2 t ht))]
    have h_eval_Dt_eq :
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D_t =
          evalMonomialList F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ D_t := by
      unfold evalMonomialList
      congr 1
      apply List.map_congr_left
      intro s hs
      rcases List.mem_map.mp hs with ⟨t, ht, rfl⟩
      unfold evalMonomialTerm
      dsimp only [twistMonomialTerm]
      rw [h_eq_on_N t.field t.le (le_inf (hD₀_le_K₁ t ht) (hD₀_sub.2 t ht))]
    haveI : FiniteDimensional F E :=
      Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
        (IntermediateField.inclusion hEK).injective
    let t_E1 : MonomialTerm F L := ⟨1, E, hLE, 1⟩
    let t_Eχ : MonomialTerm F L := ⟨1, E, hLE, χE⟩
    have ht_E1_wf : t_E1.Wf F L := ⟨inferInstance, hSep_sub E hLE hEK, hWeil1E⟩
    have ht_Eχ_wf : t_Eχ.Wf F L := ⟨inferInstance, hSep_sub E hLE hEK, hχE⟩
    have hzero₁ : IsMonomialDecomp F L 0 ([t_E1] ++ D₀.map (MonomialTerm.neg F L)) := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rw [List.mem_append] at ht
        rcases ht with ht | ht
        · rw [List.mem_singleton] at ht
          subst ht
          exact ht_E1_wf
        · rcases List.mem_map.mp ht with ⟨t₀, ht₀, rfl⟩
          exact hD₀_sub.1.1 t₀ ht₀
      · intro w
        have h_tr1 : monomialListTrace F L [t_E1] w = monomialListTrace F L D₀ w :=
          (add_zero (t_E1.trace F L w)).trans (hD₀_sub.1.2 w)
        rw [Pi.zero_apply, htrace_append, htrace_neg, h_tr1, add_neg_cancel]
    have hle₁ : ∀ t ∈ ([t_E1] ++ D₀.map (MonomialTerm.neg F L)), t.field ≤ K₁ := by
      intro t ht
      rw [List.mem_append] at ht
      rcases ht with ht | ht
      · rw [List.mem_singleton] at ht
        subst ht
        exact hEK₁
      · rcases List.mem_map.mp ht with ⟨t₀, ht₀, rfl⟩
        exact hD₀_le_K₁ t₀ ht₀
    have hprod₁ := hLamK₁.2 ([t_E1] ++ D₀.map (MonomialTerm.neg F L)) hzero₁ hle₁
    rw [heval_append, heval_neg] at hprod₁
    have h_D₀_K₁ : evalMonomialList F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ D₀ =
        evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ t_E1 := by
      have h_eq1 := (mul_inv_eq_one.mp hprod₁).symm
      simpa only [evalMonomialList, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
        mul_one] using h_eq1
    have h_cand_eq_K₁ : candLamFrom F rec L M_C ψ E = galoisLam F rec L K₁ ψ E := by
      rw [h_cand, h_eval_D₀_eq, h_D₀_K₁]
      simp only [t_E1, evalMonomialTerm, zpow_one, inv_mul_cancel_left]
    have hzero₂ : IsMonomialDecomp F L 0 ([t_Eχ] ++ D_t.map (MonomialTerm.neg F L)) := by
      refine ⟨?_, ?_⟩
      · intro s hs
        rw [List.mem_append] at hs
        rcases hs with hs | hs
        · rw [List.mem_singleton] at hs
          subst hs
          exact ht_Eχ_wf
        · rcases List.mem_map.mp hs with ⟨s₀, hs₀, rfl⟩
          exact hDt_decomp.1 s₀ hs₀
      · intro w
        have h_trχ : monomialListTrace F L [t_Eχ] w = monomialListTrace F L D_t w :=
          (add_zero (t_Eχ.trace F L w)).trans (hDt_decomp.2 w)
        rw [Pi.zero_apply, htrace_append, htrace_neg, h_trχ, add_neg_cancel]
    have hle₂ : ∀ s ∈ ([t_Eχ] ++ D_t.map (MonomialTerm.neg F L)), s.field ≤ K₁ := by
      intro s hs
      rw [List.mem_append] at hs
      rcases hs with hs | hs
      · rw [List.mem_singleton] at hs
        subst hs
        exact hEK₁
      · rcases List.mem_map.mp hs with ⟨s₀, hs₀, rfl⟩
        rcases List.mem_map.mp hs₀ with ⟨t₀, ht₀, rfl⟩
        exact hD₀_le_K₁ t₀ ht₀
    have hprod₂ := hLamK₁.2 ([t_Eχ] ++ D_t.map (MonomialTerm.neg F L)) hzero₂ hle₂
    rw [heval_append, heval_neg] at hprod₂
    have h_Dt_K₁ : evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ t_Eχ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ D_t := by
      have h_eq2 := mul_inv_eq_one.mp hprod₂
      simpa only [evalMonomialList, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
        mul_one] using h_eq2
    rw [h_eval_Dt_eq, ← h_Dt_K₁]
    simp only [t_Eχ, evalMonomialTerm, zpow_one, h_cand_eq_K₁]
  · rw [hχL_ext_E] at hRatio
    have h_fac := hDt_factor (galoisLam F rec L M_C ψ)
    set ε_χ := tateEpsUnit F E (recChar F rec E χE) (traceChar F hLE ψ)
    set ε_1 := tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ)
    set E1_0 := evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀
    set E1_t := evalMonomialList F rec (fun _ _ _ => 1) L ψ D_t
    set Elam_0 := evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₀
    set Elam_t := evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D_t
    change (ε_χ * candLamFrom F rec L M_C ψ E) ^ (1 : ℤ) = Elam_t
    rw [zpow_one, h_cand]
    apply mul_right_cancel (b := ε_1 * E1_0)
    calc (ε_χ * (ε_1⁻¹ * Elam_0)) * (ε_1 * E1_0)
      _ = (ε_χ * E1_0) * Elam_0 * (ε_1⁻¹ * ε_1) := by ac_rfl
      _ = (ε_χ * E1_0) * Elam_0 := by rw [inv_mul_cancel, mul_one]
      _ = (ε_1 * E1_t) * Elam_0 := by rw [hRatio]
      _ = ε_1 * (E1_t * Elam_0) := by ac_rfl
      _ = ε_1 * (Elam_t * E1_0) := by rw [← h_fac]
      _ = Elam_t * (ε_1 * E1_0) := by ac_rfl

theorem ld_ch15_char_ext_and_normal_descent (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (χL : relWeil F L →* (Ω F)ˣ) (χE : relWeil F E →* (Ω F)ˣ)
    (hχL : IsWeilRep F L (charRep F L χL))
    (hχE : IsWeilRep F E (charRep F E χE))
    (h_rest : restrictWeilChar F hEK χE = restrictWeilChar F hLK χL) :
    (IsWeilRep F L (charRep F L 1) ∧ IsWeilRep F E (charRep F E 1)) ∧
    ∃ χL_ext : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL_ext) ∧
      restrictWeilChar F hLE χL_ext = χE ∧
      restrictWeilChar F hLK χL_ext = restrictWeilChar F hLK χL ∧
      ∀ (D₀ : List (MonomialTerm F L)),
        IsSubMonomialDecomp F L M_C E hLE D₀ →
        (∀ t ∈ D₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) →
        (∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
          L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
          ∀ t ∈ D₀, t.field ≤ K₁) →
        let D_t := D₀.map (twistMonomialTerm F L χL_ext)
        IsMonomialDecomp F L
          (fun w => (⟨1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w) D_t ∧
        (∀ s ∈ D_t, s.field ≤ M_C) ∧
        (∀ s ∈ D_t, ∃ hsK : s.field ≤ K,
          restrictWeilChar F hsK s.χ = restrictWeilChar F hLK χL) ∧
        (((∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
            K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
            Module.finrank L (IntermediateField.extendScalars hLK₁) <
              Module.finrank L (IntermediateField.extendScalars hLK)) ∨
          tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
          tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
            evalMonomialList F rec (fun _ _ _ => 1) L ψ D_t) →
          evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, χE⟩ =
            evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D_t) :=
by
  obtain ⟨hWeil1, χL_ext, hχL_ext, hχL_ext_E, hχL_ext_K⟩ :=
    ld_ch15_semidirect_weil_char_ext F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hGal hMin.1 χL χE hχL hχE h_rest
  refine ⟨hWeil1, χL_ext, hχL_ext, hχL_ext_E, hχL_ext_K, ?_⟩
  intro D₀ hD₀_sub hD₀_rest1 hD₀_K₁
  obtain ⟨hDt_decomp, hDt_le, hDt_rest, hDt_factor⟩ :=
    ld_ch15_twist_monomial_decomp F rec L K M_C E hLK hLE ψ χL χL_ext χE
      hχL_ext hχL_ext_E hχL_ext_K D₀ hD₀_sub hD₀_rest1
  refine ⟨hDt_decomp, hDt_le, hDt_rest, fun hOr => ?_⟩
  exact ld_ch15_candLam_normal_descent_and_ratio F rec L K M_C E hLK hLM_C hM_CK
    hLE hEK h_sup hGal ψ hψ hTheory hMin χL_ext χE hWeil1.2 hχE hχL_ext_E
    D₀ hD₀_sub hD₀_K₁ hDt_decomp hDt_factor hOr

theorem ld_ch10_monomial_list_to_cyclic_char_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK L le_rfl hLK)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D₀ : List (MonomialTerm F L))
    (hD₀_sub : IsSubMonomialDecomp F L L K hLK D₀)
    (hD₀_rest1 : ∀ t ∈ D₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) :
    Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
    IsAbelianExt F hLK ∧
    ∃ μ₁ : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L μ₁) ∧
      restrictWeilChar F hLK μ₁ = 1 ∧
      μ₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1 ∧
      μ₁ ≠ 1 ∧
      evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEpsUnit F L (recChar F rec L (μ₁ ^ j)) ψ) ∧
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (D₀.map (twistMonomialTerm F L χL_ext)) =
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          tateEpsUnit F L (recChar F rec L (μ₁ ^ j * χL_ext)) ψ) :=
by
  have hAb : IsAbelianExt F hLK := hMin.2.1
  obtain ⟨hFinL, hFinK, hFinLK', hGalLK', π, C, H, hπ, hsurj, _, _, h_mem_H, _, _⟩ :=
    ld_ch15_galois_subgroups_and_weil_proj F L K L K L hLK le_rfl hLK hLK le_rfl
      le_rfl hLK le_rfl hGal hMin
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G' := (K' ≃ₐ[L] K')
  let ℓ : ℕ := Module.finrank L K'
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional L K' := hFinLK'
  haveI : IsGalois L K' := hGalLK'
  have hπ_eq_one_iff : ∀ w : relWeil F L,
      π w = 1 ↔ w ∈ (relWeil F K).subgroupOf (relWeil F L) := by
    intro w
    change π w = 1 ↔ (w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ K.fixingSubgroup
    have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
    rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff, AlgEquiv.ext_iff]
    constructor
    · intro hw z hz
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
      have h1 := congrArg Subtype.val (hw x)
      rwa [hπ w x] at h1
    · intro hw x
      apply Subtype.ext
      rw [hπ w x]
      exact hw x.1 ((IntermediateField.mem_extendScalars hLK).mp x.2)
  have hH_eq_bot : ∀ g : G', g ∈ H ↔ g = 1 := by
    intro g
    obtain ⟨w, rfl⟩ := hsurj g
    rw [← h_mem_H w, hπ_eq_one_iff w]
  let L' : IntermediateField L (AlgebraicClosure F) :=
    IntermediateField.extendScalars (le_rfl : L ≤ L)
  haveI : FiniteDimensional F L' := hFinL
  haveI : IsScalarTower F L L' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hmul_LL : Module.finrank F L * Module.finrank L L' = Module.finrank F L :=
    Module.finrank_mul_finrank F L L'
  have hpos_FL : 0 < Module.finrank F L := Module.finrank_pos
  have hfin_LL : Module.finrank L L' = 1 :=
    Nat.eq_of_mul_eq_mul_left hpos_FL (hmul_LL.trans (mul_one _).symm)
  have hgt : 1 < ℓ := by
    have hlt := hMin.2.2.1
    rwa [hfin_LL] at hlt
  let p₀ : ℕ := Nat.minFac ℓ
  have hp₀ : Nat.Prime p₀ := Nat.minFac_prime (ne_of_gt hgt)
  haveI : Fact (Nat.Prime p₀) := ⟨hp₀⟩
  have hcard_G' : Nat.card G' = ℓ := IsGalois.card_aut_eq_finrank L K'
  have hdvd_G' : p₀ ∣ Nat.card G' := by
    rw [hcard_G']
    exact Nat.minFac_dvd ℓ
  obtain ⟨σ₀, hσ₀_ord⟩ := exists_prime_orderOf_dvd_card' (G := G') p₀ hdvd_G'
  let H₀ : Subgroup G' := Subgroup.zpowers σ₀
  let E₀ : IntermediateField L K' := IntermediateField.fixedField H₀
  let E_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.lift E₀
  let E' : IntermediateField F (AlgebraicClosure F) := E_L.restrictScalars F
  have hLE' : L ≤ E' := fun z hz =>
    (IntermediateField.mem_restrictScalars F).mpr (E_L.algebraMap_mem ⟨z, hz⟩)
  have hE'K : E' ≤ K := fun z hz =>
    (IntermediateField.mem_extendScalars hLK).mp
      (IntermediateField.lift_le E₀ ((IntermediateField.mem_restrictScalars F).mp hz))
  have hH₀_top : H₀ = ⊤ := by
    rcases hMin.2.2.2.2 E' hLE' hE'K with hE'L | hlt_inf | hsup_eq
    · have hE₀_bot : E₀ = ⊥ := by
        apply le_antisymm _ bot_le
        intro x hx
        have hxE' : (x : AlgebraicClosure F) ∈ E' :=
          (IntermediateField.mem_restrictScalars F).mpr ((IntermediateField.mem_lift x).mpr hx)
        have hxL : (x : AlgebraicClosure F) ∈ L := hE'L hxE'
        have hx_eq : (algebraMap L K') ⟨x.1, hxL⟩ = x := rfl
        rw [← hx_eq]
        exact (⊥ : IntermediateField L K').algebraMap_mem ⟨x.1, hxL⟩
      rw [← IntermediateField.fixingSubgroup_fixedField H₀]
      change E₀.fixingSubgroup = ⊤
      rw [hE₀_bot, IntermediateField.fixingSubgroup_bot]
    · exfalso
      have hinf : E' ⊓ L = L := inf_eq_right.mpr hLE'
      rw [hinf] at hlt_inf
      exact lt_irrefl L hlt_inf
    · exfalso
      have hE'K_eq : E' = K := (sup_eq_left.mpr hLE').symm.trans hsup_eq
      have hσ₀_one : σ₀ = 1 := by
        apply AlgEquiv.ext
        intro x
        have hxK : (x : AlgebraicClosure F) ∈ K := (IntermediateField.mem_extendScalars hLK).mp x.2
        have hxE' : (x : AlgebraicClosure F) ∈ E' := hE'K_eq.symm ▸ hxK
        have hxE₀ : x ∈ E₀ :=
          (IntermediateField.mem_lift x).mp ((IntermediateField.mem_restrictScalars F).mp hxE')
        exact (IntermediateField.mem_fixedField_iff H₀ x).mp hxE₀ σ₀ (Subgroup.mem_zpowers σ₀)
      rw [hσ₀_one, orderOf_one] at hσ₀_ord
      exact hp₀.ne_one hσ₀_ord.symm
  have hℓ_eq_p₀ : ℓ = p₀ := by
