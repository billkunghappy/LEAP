            ext
            exact h.symm
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hbk, mul_zero]
        · intro h
          exact False.elim (h (Finset.mem_univ _))
      have coeff_polyPhi_eq : ∀ {m : ℕ} (c : Fin m → k_L),
          (polyPhi m c).coeff m = 1 := by
        intro m c
        dsimp [polyPhi]
        rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_pos rfl,
          Polynomial.finset_sum_coeff]
        suffices h : (∑ i : Fin m, (Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)).coeff m) = 0 by
          rw [h, add_zero]
        apply Finset.sum_eq_zero
        intro i _
        have hid : m ≠ (i : ℕ) := by omega
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hid, mul_zero]
      have coeff_polyPhi_gt : ∀ {m : ℕ} (c : Fin m → k_L) {k : ℕ} (hk : m < k),
          (polyPhi m c).coeff k = 0 := by
        intro m c k hk
        dsimp [polyPhi]
        rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
          Polynomial.finset_sum_coeff]
        apply Finset.sum_eq_zero
        intro i _
        have hik : k ≠ (i : ℕ) := by omega
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hik, mul_zero]
      have polyPhi_injective : ∀ m : ℕ, Function.Injective (polyPhi m) := by
        intro m c₁ c₂ h
        funext i
        have h1 := coeff_polyPhi_lt c₁ i.isLt
        have h2 := coeff_polyPhi_lt c₂ i.isLt
        have hi : (⟨(i : ℕ), i.isLt⟩ : Fin m) = i := Fin.ext rfl
        rw [hi] at h1 h2
        rw [← h1, ← h2, h]
      have polyPhi_monic_and_natDegree : ∀ {m : ℕ} (c : Fin m → k_L),
          (polyPhi m c).Monic ∧ (polyPhi m c).natDegree = m := by
        intro m c
        have hle : (polyPhi m c).natDegree ≤ m := by
          rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
          intro N hN
          exact coeff_polyPhi_gt c hN
        have hge : m ≤ (polyPhi m c).natDegree := by
          apply Polynomial.le_natDegree_of_ne_zero
          rw [coeff_polyPhi_eq]
          exact one_ne_zero
        have hdeg : (polyPhi m c).natDegree = m := le_antisymm hle hge
        refine ⟨?_, hdeg⟩
        rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg, coeff_polyPhi_eq]
      have eq_polyPhi_of_monic_natDegree : ∀ {m : ℕ} {f : Polynomial k_L},
          f.Monic → f.natDegree = m → polyPhi m (fun i : Fin m => f.coeff (i : ℕ)) = f := by
        intro m f hf_mon hf_deg
        ext k
        rcases lt_trichotomy k m with hlt | rfl | hgt
        · exact coeff_polyPhi_lt _ hlt
        · rw [coeff_polyPhi_eq]
          have hlead : f.coeff k = f.leadingCoeff := by rw [Polynomial.leadingCoeff, hf_deg]
          rw [hlead, hf_mon.leadingCoeff]
        · rw [coeff_polyPhi_gt _ hgt, Polynomial.coeff_eq_zero_of_natDegree_lt (hf_deg ▸ hgt)]
      have hM_eq_image : ∀ m : ℕ, M_poly m = Finset.univ.image (polyPhi m) := by
        intro m
        ext f
        rw [hM_mem, Finset.mem_image]
        simp only [Finset.mem_univ, true_and]
        constructor
        · rintro ⟨hf_mon, hf_deg⟩
          exact ⟨fun i => f.coeff (i : ℕ), eq_polyPhi_of_monic_natDegree hf_mon hf_deg⟩
        · rintro ⟨c, rfl⟩
          exact polyPhi_monic_and_natDegree c
      refine ⟨?_, ?_⟩
      · intro m
        rw [hM_eq_image m, Finset.card_image_of_injective _ (polyPhi_injective m),
          Finset.card_univ, Fintype.card_fun, Fintype.card_fin]
      · intro m μ
        rw [hM_eq_image m, Finset.sum_image (fun x _ y _ h => polyPhi_injective m h)]
    have prime_pow_base_unique : ∀ (P₁ P₂ : Polynomial k_L) (k₁ k₂ : ℕ),
        P₁.Monic → Irreducible P₁ → 1 ≤ k₁ →
        P₂.Monic → Irreducible P₂ → 1 ≤ k₂ →
        P₁ ^ k₁ = P₂ ^ k₂ → P₁ = P₂ := by
      intro P₁ P₂ k₁ k₂ hP₁_mon hP₁_irr hk₁ hP₂_mon hP₂_irr _hk₂ heq
      have hdvd_pow : P₁ ∣ P₂ ^ k₂ := heq ▸ dvd_pow_self P₁ (by omega)
      have hP₁_prime : Prime P₁ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hP₁_irr
      have hdvd : P₁ ∣ P₂ := hP₁_prime.dvd_of_dvd_pow hdvd_pow
      have hassoc : Associated P₁ P₂ :=
        (Irreducible.dvd_irreducible_iff_associated hP₁_irr hP₂_irr).mp hdvd
      exact Polynomial.eq_of_monic_of_associated hP₁_mon hP₂_mon hassoc
    let S_lam : ℕ → Ω F := fun m => ∑ Q ∈ M_poly m, (Λ_poly Q : Ω F) * lam₂ Q
    let A_lam : ℕ → Ω F := fun m => ∑ B ∈ M_poly m, lam₂ B
    let a₁ : Ω F := ∑ x : k_L, lam₂ (Polynomial.X - Polynomial.C x)
    have hA0 : A_lam 0 = 1 := by
      dsimp [A_lam]
      rw [hM_zero, Finset.sum_singleton, hlam₂_1]
    have hA1 : A_lam 1 = a₁ := hM_one lam₂
    have hAvan : ∀ m, 2 ≤ m → A_lam m = 0 := by
      intro m hm2
      dsimp [A_lam]
      rw [hM_deg_sum m lam₂, hlam₂_van m hm2]
    have hS_lam_ind : ∀ n, 1 ≤ n → S_lam n = (-1 : Ω F) ^ (n - 1) * a₁ ^ n := by
      intro n
      induction n with
      | zero => intro h; omega
      | succ m ih =>
        intro _
        have hconv : (∑ k ∈ Finset.Icc 1 (m + 1), S_lam k * A_lam (m + 1 - k)) =
            ((m + 1 : ℕ) : Ω F) * A_lam (m + 1) :=
          hNewton lam₂ hlam₂_mul (m + 1)
        rcases Nat.eq_zero_or_pos m with rfl | hm_pos
        · simp only [zero_add, Finset.Icc_self, Finset.sum_singleton, tsub_self, hA0, mul_one,
            Nat.cast_one, hA1, one_mul] at hconv
          rw [Nat.sub_self, pow_zero, pow_one, one_mul, hconv]
        · rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ m + 1), tsub_self, hA0, mul_one,
            hAvan (m + 1) (by omega), mul_zero] at hconv
          have hsum_single : (∑ k ∈ Finset.Icc 1 m, S_lam k * A_lam (m + 1 - k)) =
              S_lam m * a₁ := by
            rw [Finset.sum_eq_single m]
            · have hsub : m + 1 - m = 1 := by omega
              rw [hsub, hA1]
            · intro k hk_mem hkm
              rw [Finset.mem_Icc] at hk_mem
              rw [hAvan (m + 1 - k) (by omega), mul_zero]
            · intro hm_not_mem
              exact False.elim (hm_not_mem (Finset.mem_Icc.mpr ⟨hm_pos, le_rfl⟩))
          rw [hsum_single] at hconv
          have hSm1 : S_lam (m + 1) = - (S_lam m * a₁) := eq_neg_of_add_eq_zero_right hconv
          rw [hSm1, ih hm_pos]
          have hm_eq : m = (m - 1) + 1 := by omega
          conv_rhs => rw [Nat.add_sub_cancel, hm_eq, pow_succ (-1 : Ω F) (m - 1), ← hm_eq,
            pow_succ a₁ m]
          ring
    have hS_lam_fk : (∑ P ∈ M_poly f_k, (Λ_poly P : Ω F) * lam₂ P) =
        (-1 : Ω F) ^ (f_k - 1) * a₁ ^ f_k :=
      hS_lam_ind f_k (by omega)
    let q : ℕ := Fintype.card k_L
    let μ₁ : Polynomial k_L → Ω F := fun _ => 1
    let S₁ : ℕ → Ω F := fun m => ∑ Q ∈ M_poly m, (Λ_poly Q : Ω F) * μ₁ Q
    let A₁ : ℕ → Ω F := fun m => ∑ B ∈ M_poly m, μ₁ B
    have hA₁ : ∀ m, A₁ m = (q : Ω F) ^ m := by
      intro m
      simp only [A₁, μ₁, q, Finset.sum_const, nsmul_eq_mul, mul_one, hM_card m, Nat.cast_pow]
    have hS₁_ind : ∀ n, 1 ≤ n → S₁ n = (q : Ω F) ^ n := by
      intro n
      induction' n using Nat.strong_induction_on with n ih
      intro hn
      have hconv : (∑ k ∈ Finset.Icc 1 n, S₁ k * A₁ (n - k)) = (n : Ω F) * A₁ n :=
        hNewton μ₁ (fun _ _ _ _ => (mul_one 1).symm) n
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ m + 1), tsub_self, hA₁ 0, pow_zero, mul_one,
        hA₁ (m + 1)] at hconv
      have hsum_prev : (∑ k ∈ Finset.Icc 1 m, S₁ k * A₁ (m + 1 - k)) =
          (m : Ω F) * (q : Ω F) ^ (m + 1) := by
        have hcongr : ∀ k ∈ Finset.Icc 1 m, S₁ k * A₁ (m + 1 - k) = (q : Ω F) ^ (m + 1) := by
          intro k hk_mem
          rw [Finset.mem_Icc] at hk_mem
          rw [ih k (by omega) hk_mem.1, hA₁ (m + 1 - k), ← pow_add]
          congr 1
          omega
        rw [Finset.sum_congr rfl hcongr, Finset.sum_const, Nat.card_Icc,
          Nat.add_sub_cancel, nsmul_eq_mul]
      rw [hsum_prev] at hconv
      have h_rhs : ((m + 1 : ℕ) : Ω F) * (q : Ω F) ^ (m + 1) =
          (m : Ω F) * (q : Ω F) ^ (m + 1) + (q : Ω F) ^ (m + 1) := by
        push_cast
        ring
      rw [h_rhs] at hconv
      exact add_left_cancel hconv
    have hΛ_sum_card : (∑ P ∈ M_poly f_k, Λ_poly P) = (Fintype.card k_L) ^ f_k := by
      have hS₁_fk := hS₁_ind f_k (by omega)
      simp only [S₁, μ₁, mul_one, q] at hS₁_fk
      have hcast : (((∑ P ∈ M_poly f_k, Λ_poly P : ℕ) : Ω F)) =
          (((Fintype.card k_L) ^ f_k : ℕ) : Ω F) := by
        push_cast
        exact hS₁_fk
      exact Nat.cast_injective hcast
    let F_b : k_M → Polynomial k_L := fun b =>
      (minpoly k_L b) ^ (f_k / (minpoly k_L b).natDegree)
    have h_props : ∀ b : k_M,
        (minpoly k_L b).Monic ∧ Irreducible (minpoly k_L b) ∧
        1 ≤ f_k / (minpoly k_L b).natDegree ∧
        F_b b ∈ M_poly f_k ∧ Λ_poly (F_b b) = (minpoly k_L b).natDegree := by
      intro b
      have hb : IsIntegral k_L b := Algebra.IsIntegral.isIntegral b
      have hmon : (minpoly k_L b).Monic := minpoly.monic hb
      have hirr : Irreducible (minpoly k_L b) := minpoly.irreducible hb
      have hmul : (minpoly k_L b).natDegree *
          Module.finrank (IntermediateField.adjoin k_L ({b} : Set k_M)) k_M = f_k := by
        rw [← IntermediateField.adjoin.finrank hb]
        exact Module.finrank_mul_finrank k_L (IntermediateField.adjoin k_L ({b} : Set k_M)) k_M
      have hdvd : (minpoly k_L b).natDegree ∣ f_k :=
        ⟨Module.finrank (IntermediateField.adjoin k_L ({b} : Set k_M)) k_M, hmul.symm⟩
      have hk_mul : (f_k / (minpoly k_L b).natDegree) * (minpoly k_L b).natDegree = f_k :=
        Nat.div_mul_cancel hdvd
      have hk_pos : 1 ≤ f_k / (minpoly k_L b).natDegree := by
        rcases Nat.eq_zero_or_pos (f_k / (minpoly k_L b).natDegree) with h0 | hpos
        · rw [h0, zero_mul] at hk_mul
          omega
        · exact hpos
      have hF_mem : F_b b ∈ M_poly f_k := by
        rw [hM_mem]
        refine ⟨hmon.pow _, ?_⟩
        rw [hmon.natDegree_pow, hk_mul]
      have hΛ_eq : Λ_poly (F_b b) = (minpoly k_L b).natDegree :=
        hΛ_prime_pow (minpoly k_L b) _ hmon hirr hk_pos
      exact ⟨hmon, hirr, hk_pos, hF_mem, hΛ_eq⟩
    let fib : Polynomial k_L → Finset k_M := fun P =>
      Finset.univ.filter (fun b : k_M => F_b b = P)
    have hfib_le : ∀ P ∈ M_poly f_k, (fib P).card ≤ Λ_poly P := by
      intro P _
      by_cases hne : (fib P).Nonempty
      · obtain ⟨b₀, hb₀⟩ := hne
        rw [Finset.mem_filter] at hb₀
        have hFb₀ : F_b b₀ = P := hb₀.2
        have hΛP : Λ_poly P = (minpoly k_L b₀).natDegree := by
          rw [← hFb₀, (h_props b₀).2.2.2.2]
        let Q₀ : Polynomial k_M := Polynomial.map (algebraMap k_L k_M) (minpoly k_L b₀)
        have hQ₀_mon : Q₀.Monic := (h_props b₀).1.map (algebraMap k_L k_M)
        have hQ₀_ne : Q₀ ≠ 0 := hQ₀_mon.ne_zero
        have hQ₀_deg : Q₀.natDegree = (minpoly k_L b₀).natDegree :=
          (h_props b₀).1.natDegree_map (algebraMap k_L k_M)
        have hsub : fib P ⊆ Q₀.roots.toFinset := by
          intro b hb
          rw [Finset.mem_filter] at hb
          have hmin_eq : minpoly k_L b = minpoly k_L b₀ :=
            prime_pow_base_unique (minpoly k_L b) (minpoly k_L b₀) _ _
              (h_props b).1 (h_props b).2.1 (h_props b).2.2.1
              (h_props b₀).1 (h_props b₀).2.1 (h_props b₀).2.2.1
              (hb.2.trans hFb₀.symm)
          rw [Multiset.mem_toFinset, Polynomial.mem_roots hQ₀_ne, Polynomial.IsRoot.def,
            Polynomial.eval_map, ← Polynomial.aeval_def, ← hmin_eq, minpoly.aeval]
        calc (fib P).card ≤ Q₀.roots.toFinset.card := Finset.card_le_card hsub
          _ ≤ Q₀.roots.card := Multiset.toFinset_card_le _
          _ ≤ Q₀.natDegree := Polynomial.card_roots' Q₀
          _ = Λ_poly P := by rw [hQ₀_deg, hΛP]
      · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.card_empty]
        exact Nat.zero_le _
    have hsum_fib : (∑ P ∈ M_poly f_k, (fib P).card) = ∑ P ∈ M_poly f_k, Λ_poly P := by
      have h1 : (∑ P ∈ M_poly f_k, (fib P).card) = (Finset.univ : Finset k_M).card :=
        (Finset.card_eq_sum_card_fiberwise (f := F_b) (s := Finset.univ) (t := M_poly f_k)
          (fun b _ => (h_props b).2.2.2.1)).symm
      rw [h1, Finset.card_univ, Module.card_eq_pow_finrank (K := k_L) (V := k_M), hΛ_sum_card]
    have hfib_eq : ∀ P ∈ M_poly f_k, (fib P).card = Λ_poly P :=
      (Finset.sum_eq_sum_iff_of_le hfib_le).mp hsum_fib
    have hsum_eq := (Finset.sum_fiberwise_of_maps_to' (s := (Finset.univ : Finset k_M))
      (t := M_poly f_k) (g := F_b) (f := lam₂) (fun b _ => (h_props b).2.2.2.1)).symm
    have h_lhs : (∑ b : k_M, lam₂ (F_b b)) = ∑ P ∈ M_poly f_k, (Λ_poly P : Ω F) * lam₂ P := by
      rw [hsum_eq]
      apply Finset.sum_congr rfl
      intro P hP
      change (∑ _b ∈ fib P, lam₂ P) = (Λ_poly P : Ω F) * lam₂ P
      rw [Finset.sum_const, nsmul_eq_mul, hfib_eq P hP]
    have ha₁_eq : a₁ = ∑ x : k_L, Q_L x :=
      Finset.sum_congr rfl (fun x _ => hlam₂_lin x)
    have hQ_M_sum : (∑ b : k_M, lam₂ (F_b b)) =
        (-1 : Ω F) ^ (f_H - 1) * (∑ x : k_L, Q_L x) ^ f_H := by
      rw [h_lhs, hS_lam_fk, ha₁_eq, hfinrank_res]
    have ha_odd_MC : condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) =
        2 * (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) / 2) + 1 := by
      rw [hcond_MC]; omega
    have hd_eq : condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) / 2 = d₀ := by
      rw [hcond_MC]
    have hodd_eval := hEval.2 ha_odd_MC ϖ_M hϖ_M_val (fun b => lam₂ (F_b b)) (by
      intro z hz_int hz_ne
      simp only [hd_eq] at hz_ne ⊢
      exact hodd_bridge z hz_int hz_ne)
    rw [hd_eq, hc_M_χ, hc_M_ψ, hcard_Ω, hQ_M_sum] at hodd_eval
    rw [hodd_eval]
    ring

theorem ld_ch13_tame_higher_cond_untwisted_mc_gauss_and_vand (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (χ' : Lˣ →* (Ω F)ˣ) (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (ha2 : 2 ≤ condExp F L χ')
    (hν_props : ∀ i : Fin r,
      (ν_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      ν_orb i ≠ 1 ∧
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)), ((ν_orb i) ^ k) u = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
          ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1))
    (hν_orb_sum : ∀ (ν₀ : M_Cˣ →* (Ω F)ˣ),
      ν₀ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 → ν₀ ≠ 1 →
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1) →
      ∀ z : M_Cˣ,
        1 + (∑ i : Fin r,
          ∑ c ∈ (Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
            (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
              (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1),
            (((ν_orb i) ^ c) z : Ω F)) =
          ∑ j ∈ Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK)),
            ((ν₀ ^ j) z : Ω F))
    (hν_cond1 : ∀ i : Fin r,
      condExp F M_C (ν_orb i) = 1 ∧
      (∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1))
    (hν_triv_L : ∀ (i : Fin r) (x : Lˣ),
      (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom x) = 1)
    (ϖ_L c_L : Lˣ) (hϖ_L_val : valL F L (ϖ_L : L) = 1)
    (hc_L_val : valL F L (c_L : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hval_alg_MC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x)
    (hcondChar_MC : condExpChar F M_C (traceChar F hLM_C ψ) = condExpChar F L ψ)
    (hval_alg_E : ∀ x : L, valL F E (IntermediateField.inclusion hLE x) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hResSurj_E : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨ 1 ≤ valL F E (y - IntermediateField.inclusion hLE x)))
    (hcondChar_E : condExpChar F E (traceChar F hLE ψ) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] (resL : L → k_L) (resM : M_C → k_M)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
      resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
      resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
      resM (-z₁) = -resM z₁)
    (hresM_ker : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) → (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M_C z)))
    (hresM_surj : ∀ b : k_M, ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧ resM z = b)
    (hres_tr_norm_MC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      resL (traceLM F hLM_C z) = Algebra.trace k_L k_M (resM z) ∧
      resL (normLM F hLM_C z) = Algebra.norm k_L (resM z))
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (hSpec_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ),
        (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
        (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) ∧
        (condExp F M θ ≠ 0 →
          (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) ∧
          (∃ u₀ ∈ unitGroup F M (condExp F M θ - 1), θ u₀ ≠ 1)) ∧
        valL F M ((tateElt F M θ ψ_M : Mˣ) : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hGauss_MC : ∀ (i : Fin r) (c_M : M_Cˣ),
      valL F M_C (c_M : M_C) = 1 + condExpChar F M_C (traceChar F hLM_C ψ) →
      ∀ (χ_tilde ψ_tilde : k_M → Ω F),
        χ_tilde 0 = 0 →
        (∀ u : M_Cˣ, valL F M_C (u : M_C) = 0 → χ_tilde (resM (u : M_C)) = ((ν_orb i) u : Ω F)⁻¹) →
        (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
          ψ_tilde (resM z) = (traceChar F hLM_C ψ) (((c_M⁻¹ : M_Cˣ) : M_C) * z)) →
        tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ) =
          (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) * ((ν_orb i) c_M : Ω F) *
            (∑ b : k_M, χ_tilde b * ψ_tilde b))
    (hVand_orbit :
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : k_L) ≠ 0 →
      ∀ (ψ_k : AddChar k_L (Ω F)), ψ_k ≠ 1 →
      ∀ (μ_tilde : Fin r → (k_Mˣ →* (Ω F)ˣ)),
        (∀ i : Fin r,
          (μ_tilde i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
          μ_tilde i ≠ 1) →
        (∀ y : k_Mˣ,
          1 + (∑ i : Fin r,
            ∑ c ∈ (Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
              (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
                (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1),
              (((μ_tilde i) ^ c) y : Ω F)) =
            ∑ j ∈ Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK)),
              (((μ_tilde ⟨0, hr_pos⟩) ^ j) y : Ω F)) →
        (∏ i : Fin r,
          (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) *
            ψ_k (Algebra.trace k_L k_M (y : k_M)))) =
          (Fintype.card k_L : Ω F) ^ ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / 2) ∧
        (∀ (φ_L : k_L → Ω F),
          φ_L 0 = 1 →
          (∀ x y : k_L, φ_L (x + y) = φ_L x * φ_L y * ψ_k (x * y)) →
          (∑ x : k_L, φ_L x) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) =
            (-1 : Ω F) ^ (r * (Module.finrank L (IntermediateField.extendScalars hLM_C) - 1)) *
              (Fintype.card k_L : Ω F) ^
                ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / 2) *
              (∑ x : k_L, (φ_L x) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))))) :
    (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
      ((qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ)) ^ r *
        (Fintype.card k_L : Ω F) ^
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / 2) ∧
    (condExp F L χ' % 2 = 1 →
      ∀ (Q_L ψ_0 : k_L → Ω F),
        (∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
          ψ_0 (resL x) =
            ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ_L ^ (2 * (condExp F L χ' / 2)) : Lˣ) : L) * x)) →
        Q_L 0 = 1 →
        (∀ x y : k_L, Q_L (x + y) = Q_L x * Q_L y * ψ_0 (x * y)) →
        (∑ x : k_L, Q_L x) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) =
          (-1 : Ω F) ^ (r * (Module.finrank L (IntermediateField.extendScalars hLM_C) - 1)) *
            (Fintype.card k_L : Ω F) ^
              ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / 2) *
            (∑ x : k_L, (Q_L x) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))) :=
by
  classical
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
  obtain ⟨hval0_E, hval1_E, hval_neg1_E, hval_neg_E, hval_mul_E, hval_inv_E, _, hval_add_E,
    hunit0_E, hunit_ge1_E, hunit_val0_E⟩ := hval_all E
  obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC, _, hval_add_MC,
    hunit0_MC, hunit_ge1_MC, hunit_val0_MC⟩ := hval_all M_C
  set ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  set f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
  set a := condExp F L χ'
  set n : ℤ := condExpChar F L ψ

  
  
  
  have hvalL_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    have hneg₂ : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_L k x₁ (-x₂) hx₁ hneg₂

  have hvalL_mul_int : ∀ (x₁ x₂ : L) (k₁ k₂ : ℤ),
      (x₁ = 0 ∨ k₁ ≤ valL F L x₁) → (x₂ = 0 ∨ k₂ ≤ valL F L x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ k₁ k₂ hx₁ hx₂
    by_cases hx₁0 : x₁ = 0
    · left; rw [hx₁0, zero_mul]
    · by_cases hx₂0 : x₂ = 0
      · left; rw [hx₂0, mul_zero]
      · right
        have h1 := hx₁.resolve_left hx₁0
        have h2 := hx₂.resolve_left hx₂0
        rw [hval_mul_L x₁ x₂ hx₁0 hx₂0]
        omega

  have hvalL_pow_unit : ∀ (u : Lˣ) (m : ℕ),
      valL F L ((u ^ m : Lˣ) : L) = (m : ℤ) * valL F L (u : L) := by
    intro u m
    induction m with
    | zero =>
      rw [pow_zero, Units.val_one, hval1_L, Nat.cast_zero, zero_mul]
    | succ m ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul_L ((u ^ m : Lˣ) : L) (u : L) (Units.ne_zero _) (Units.ne_zero _),
        ih, Nat.cast_succ]
      ring

  have hϖ_pow_val : ∀ m : ℕ, valL F L ((ϖ_L ^ m : Lˣ) : L) = (m : ℤ) := by
    intro m
    rw [hvalL_pow_unit, hϖ_L_val, mul_one]

  set c₁ : Lˣ := c_L * (ϖ_L ^ (a - 1))⁻¹
  have hc₁_inv_eq : c₁⁻¹ = c_L⁻¹ * (ϖ_L ^ (a - 1)) := by
    dsimp only [c₁]
    rw [mul_inv_rev, inv_inv, mul_comm]
  have hc₁_inv_coe : ((c₁⁻¹ : Lˣ) : L) = ((c_L⁻¹ : Lˣ) : L) * ((ϖ_L ^ (a - 1) : Lˣ) : L) := by
    rw [hc₁_inv_eq, Units.val_mul]
  have hc₁_val : valL F L (c₁ : L) = 1 + n := by
    dsimp only [c₁]
    rw [Units.val_mul,
      hval_mul_L (c_L : L) (((ϖ_L ^ (a - 1))⁻¹ : Lˣ) : L) (Units.ne_zero _) (Units.ne_zero _),
      hc_L_val, hval_inv_L, hϖ_pow_val]
    omega

  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, _, _⟩ := hSpec_all L ψ hψ χ'
  set s_L : k_L → L := fun b => (hresL_surj b).choose
  have hs_L_int : ∀ b : k_L, s_L b = 0 ∨ 0 ≤ valL F L (s_L b) :=
    fun b => (hresL_surj b).choose_spec.1
  have hs_L_res : ∀ b : k_L, resL (s_L b) = b :=
    fun b => (hresL_surj b).choose_spec.2
  set ψ_tilde : k_L → Ω F := fun b => ψ (((c₁⁻¹ : Lˣ) : L) * s_L b)
  have hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x) := by
    intro x hx_int
    set b : k_L := resL x
    have hneg_s_int : -(s_L b) = 0 ∨ 0 ≤ valL F L (-(s_L b)) := by
      rcases hs_L_int b with hs0 | hsge
      · left; rw [hs0, neg_zero]
      · right; rw [hval_neg_L]; exact hsge
    set d : L := x - s_L b
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := hvalL_sub 0 x (s_L b) hx_int (hs_L_int b)
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg, (hresL_ring x (-(s_L b)) hx_int hneg_s_int).1,
        (hresL_ring (s_L b) (s_L b) (hs_L_int b) (hs_L_int b)).2.2, hs_L_res b]
      exact add_neg_cancel b
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set w : L := ((c₁⁻¹ : Lˣ) : L) * d
    have hw_cond : w = 0 ∨ -n ≤ valL F L w := by
      by_cases hd0 : d = 0
      · left; dsimp only [w]; rw [hd0, mul_zero]
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        dsimp only [w]
        rw [hval_mul_L ((c₁⁻¹ : Lˣ) : L) d (Units.ne_zero c₁⁻¹) hd0,
          hval_inv_L c₁, hc₁_val]
        omega
    have hψ_w : ψ w = 1 := hψ_triv w hw_cond
    have hx_decomp : ((c₁⁻¹ : Lˣ) : L) * x = ((c₁⁻¹ : Lˣ) : L) * s_L b + w := by
      dsimp only [w, d]; ring
    rw [hx_decomp, ψ.map_add_eq_mul, hψ_w, mul_one]
  have hψ_zero : ψ_tilde 0 = 1 := by
    rw [← hresL_0, hψ_int 0 (Or.inl rfl), mul_zero, ψ.map_zero_eq_one]
  have hψ_add : ∀ a b : k_L, ψ_tilde (a + b) = ψ_tilde a * ψ_tilde b := by
    intro a b
    have hab_int : s_L a + s_L b = 0 ∨ 0 ≤ valL F L (s_L a + s_L b) :=
      hval_add_L 0 (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)
    have hab_res : resL (s_L a + s_L b) = a + b := by
      rw [(hresL_ring (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)).1, hs_L_res a, hs_L_res b]
    rw [← hab_res, hψ_int (s_L a + s_L b) hab_int, mul_add, ψ.map_add_eq_mul]
  let ψ_k : AddChar k_L (Ω F) :=
    { toFun := ψ_tilde
      map_zero_eq_one' := hψ_zero
      map_add_eq_mul' := hψ_add }
  have hψ_k_apply : ∀ b : k_L, ψ_k b = ψ_tilde b := fun _ => rfl
  have hψ_k_ne : ψ_k ≠ 1 := by
    intro hψ1
    set z₁ : L := (c₁ : L) * x₁
    have hz₁_val : 0 ≤ valL F L z₁ := by
      dsimp only [z₁]
      rw [hval_mul_L (c₁ : L) x₁ (Units.ne_zero c₁) hx₁_ne, hc₁_val]
      omega
    have hinv_c₁ : ((c₁⁻¹ : Lˣ) : L) * (c₁ : L) = 1 := by exact_mod_cast Units.inv_mul c₁
    have heval : ψ_k (resL z₁) = ψ x₁ := by
      rw [hψ_k_apply, hψ_int z₁ (Or.inr hz₁_val)]
      dsimp only [z₁]
      rw [← mul_assoc, hinv_c₁, one_mul]
    have h1 : ψ_k (resL z₁) = 1 := by rw [hψ1]; rfl
    exact hx₁_ψ (heval.symm.trans h1)

  
  
  
  let E' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE
  have hto_inc_E : ∀ x : L,
      toExtendScalars F hLE (IntermediateField.inclusion hLE x) = algebraMap L E' x :=
    fun _ => rfl
  have htrace_inc_E : ∀ x : L,
      traceLM F hLE (IntermediateField.inclusion hLE x) = (ℓ : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change Algebra.trace L E' (toExtendScalars F hLE (IntermediateField.inclusion hLE x)) = (ℓ : L) * x
    rw [hto_inc_E x, Algebra.trace_algebraMap x, hFinE_eq, nsmul_eq_mul]

  have hnat_int_resL : ∀ m : ℕ,
      ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      refine ⟨Or.inl (Nat.cast_zero), ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ m ih =>
      have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hval1_L])
      have hm1_int : ((m : L) + 1) = 0 ∨ 0 ≤ valL F L ((m : L) + 1) :=
        hval_add_L 0 (m : L) 1 ih.1 h1_int
      refine ⟨by simpa [Nat.cast_succ] using hm1_int, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1, Nat.cast_succ]

  obtain ⟨hψE_triv, ⟨y₁, hy₁_ne, hy₁_val, hy₁_ψE⟩, _, _⟩ :=
    hSpec_all E (traceChar F hLE ψ) hψE 1
  set c₁_E : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom c₁
  have hc₁_E_coe : (c₁_E : E) = IntermediateField.inclusion hLE (c₁ : L) := rfl
  have hc₁_E_inv_coe : ((c₁_E⁻¹ : Eˣ) : E) =
      IntermediateField.inclusion hLE ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_E_val : valL F E (c₁_E : E) = 1 + condExpChar F E (traceChar F hLE ψ) := by
    rw [hc₁_E_coe, hval_alg_E (c₁ : L), hc₁_val, hcondChar_E]
    ring

  have hNeChar : (ℓ : k_L) ≠ 0 := by
    intro hℓ0
    set y₀ : E := (c₁_E : E) * y₁
    have hy₀_val : 0 ≤ valL F E y₀ := by
      dsimp only [y₀]
      rw [hval_mul_E (c₁_E : E) y₁ (Units.ne_zero c₁_E) hy₁_ne, hc₁_E_val]
      omega
    obtain ⟨x₀, hx₀_int, hy₀_x₀⟩ := hResSurj_E y₀ (Or.inr hy₀_val)
    set z : E := y₀ - IntermediateField.inclusion hLE x₀
    set wz : E := ((c₁_E⁻¹ : Eˣ) : E) * z
    have hwz_cond : wz = 0 ∨ -condExpChar F E (traceChar F hLE ψ) ≤ valL F E wz := by
      by_cases hz0 : z = 0
      · left; dsimp only [wz]; rw [hz0, mul_zero]
      · right
        have hz_ge1 : 1 ≤ valL F E z := hy₀_x₀.resolve_left hz0
        dsimp only [wz]
        rw [hval_mul_E ((c₁_E⁻¹ : Eˣ) : E) z (Units.ne_zero _) hz0, hval_inv_E c₁_E, hc₁_E_val]
        omega
    have hψE_wz : (traceChar F hLE ψ) wz = 1 := hψE_triv wz hwz_cond
    have hinv_c₁E : ((c₁_E⁻¹ : Eˣ) : E) * (c₁_E : E) = 1 := by exact_mod_cast Units.inv_mul c₁_E
    have hy₁_decomp : y₁ = IntermediateField.inclusion hLE (((c₁⁻¹ : Lˣ) : L) * x₀) + wz := by
      have hy₁_eq : y₁ = ((c₁_E⁻¹ : Eˣ) : E) * y₀ := by
        dsimp only [y₀]
        rw [← mul_assoc, hinv_c₁E, one_mul]
      rw [hy₁_eq]
      dsimp only [wz, z]
      rw [hc₁_E_inv_coe, map_mul]
      ring
    have htr_inc_cx₀ :
        (traceChar F hLE ψ) (IntermediateField.inclusion hLE (((c₁⁻¹ : Lˣ) : L) * x₀)) =
          ψ (((c₁⁻¹ : Lˣ) : L) * ((ℓ : L) * x₀)) := by
      change ψ (traceLM F hLE (IntermediateField.inclusion hLE (((c₁⁻¹ : Lˣ) : L) * x₀))) = _
      rw [htrace_inc_E]
      congr 1
      ring
    have hℓ_int : (ℓ : L) = 0 ∨ 0 ≤ valL F L (ℓ : L) := (hnat_int_resL ℓ).1
    have hℓ_res : resL (ℓ : L) = (ℓ : k_L) := (hnat_int_resL ℓ).2
    have hℓx₀_int : (ℓ : L) * x₀ = 0 ∨ 0 ≤ valL F L ((ℓ : L) * x₀) := by
      simpa using hvalL_mul_int (ℓ : L) x₀ 0 0 hℓ_int hx₀_int
    have hℓx₀_res : resL ((ℓ : L) * x₀) = (ℓ : k_L) * resL x₀ := by
      rw [(hresL_ring (ℓ : L) x₀ hℓ_int hx₀_int).2.1, hℓ_res]
    have heval : (traceChar F hLE ψ) y₁ = 1 := by
      rw [hy₁_decomp, (traceChar F hLE ψ).map_add_eq_mul, hψE_wz, mul_one, htr_inc_cx₀,
        ← hψ_int ((ℓ : L) * x₀) hℓx₀_int, hℓx₀_res, hℓ0, zero_mul, hψ_zero]
    exact hy₁_ψE heval

  let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
  have hto_inc_MC : ∀ x : L,
      toExtendScalars F hLM_C (IntermediateField.inclusion hLM_C x) = algebraMap L M_C' x :=
    fun _ => rfl
  have htrace_mul_inc_MC : ∀ (x : L) (z : M_C),
      traceLM F hLM_C (IntermediateField.inclusion hLM_C x * z) =
        x * traceLM F hLM_C z := by
    letI : Module L L := Semiring.toModule
    intro x z
    have h1 : toExtendScalars F hLM_C (IntermediateField.inclusion hLM_C x * z) =
        x • toExtendScalars F hLM_C z := by
      rw [map_mul, hto_inc_MC x, Algebra.smul_def]
    have h2 := (Algebra.trace L M_C').map_smul' x (toExtendScalars F hLM_C z)
    exact (congrArg (Algebra.trace L M_C') h1).trans h2

  have htr_int_MC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ 0 ≤ valL F L (traceLM F hLM_C z)) := by
    intro z hz
    set t : L := traceLM F hLM_C z
    by_cases ht0 : t = 0
    · exact Or.inl ht0
    · right
      by_contra hlt
      set u_t : Lˣ := Units.mk0 t ht0
      have hut_inv_val : 1 ≤ valL F L ((u_t⁻¹ : Lˣ) : L) := by
        rw [hval_inv_L u_t]
        change 1 ≤ - valL F L t
        omega
      set z' : M_C := IntermediateField.inclusion hLM_C ((u_t⁻¹ : Lˣ) : L) * z
      have hz'_p1 : z' = 0 ∨ 1 ≤ valL F M_C z' := by
        by_cases hz0 : z = 0
        · left; dsimp only [z']; rw [hz0, mul_zero]
        · right
          have hz_ge0 : 0 ≤ valL F M_C z := hz.resolve_left hz0
          have hinc_ne : IntermediateField.inclusion hLM_C ((u_t⁻¹ : Lˣ) : L) ≠ 0 := by
            intro h0
            exact Units.ne_zero u_t⁻¹
              ((IntermediateField.inclusion hLM_C).injective (h0.trans (map_zero _).symm))
          dsimp only [z']
          rw [hval_mul_MC _ z hinc_ne hz0, hval_alg_MC]
          omega
      have hz'_int : z' = 0 ∨ 0 ≤ valL F M_C z' := by
        rcases hz'_p1 with h0 | h1
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hresM_z' : resM z' = 0 := (hresM_ker z' hz'_int).mpr hz'_p1
      have htr_z' : traceLM F hLM_C z' = 1 := by
        dsimp only [z']
        rw [htrace_mul_inc_MC]
        exact_mod_cast Units.inv_mul u_t
      have hresL_tr : resL (traceLM F hLM_C z') = 0 := by
        rw [(hres_tr_norm_MC z' hz'_int).1, hresM_z', map_zero]
      rw [htr_z', hresL_1] at hresL_tr
      exact one_ne_zero hresL_tr

  
  
  
  set s_M : k_M → M_C := fun b => (hresM_surj b).choose
  have hs_M_int : ∀ b : k_M, s_M b = 0 ∨ 0 ≤ valL F M_C (s_M b) :=
    fun b => (hresM_surj b).choose_spec.1
  have hs_M_res : ∀ b : k_M, resM (s_M b) = b :=
    fun b => (hresM_surj b).choose_spec.2
  have hs_M_ne : ∀ b : k_M, b ≠ 0 → s_M b ≠ 0 := by
    intro b hb h0
    apply hb
    rw [← hs_M_res b, h0, hresM_0]
  have hs_M_val0 : ∀ b : k_M, b ≠ 0 → valL F M_C (s_M b) = 0 := by
    intro b hb
    have hge0 : 0 ≤ valL F M_C (s_M b) := (hs_M_int b).resolve_left (hs_M_ne b hb)
    by_contra hne
    have hge1 : 1 ≤ valL F M_C (s_M b) := by omega
    have hres0 : resM (s_M b) = 0 := (hresM_ker (s_M b) (hs_M_int b)).mpr (Or.inr hge1)
    rw [hs_M_res b] at hres0
    exact hb hres0
  set v_M : k_Mˣ → M_Cˣ := fun y => Units.mk0 (s_M (y : k_M)) (hs_M_ne (y : k_M) (Units.ne_zero y))
  have hv_M_val0 : ∀ y : k_Mˣ, valL F M_C ((v_M y : M_Cˣ) : M_C) = 0 :=
    fun y => hs_M_val0 (y : k_M) (Units.ne_zero y)
  have hv_M_int : ∀ y : k_Mˣ, ((v_M y : M_Cˣ) : M_C) = 0 ∨ 0 ≤ valL F M_C ((v_M y : M_Cˣ) : M_C) :=
    fun y => hs_M_int (y : k_M)
  have hv_M_res : ∀ y : k_Mˣ, resM ((v_M y : M_Cˣ) : M_C) = (y : k_M) :=
    fun y => hs_M_res (y : k_M)
  have hdesc_unit_MC : ∀ (θ : M_Cˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F M_C 1, θ u = 1) →
      ∀ (u : M_Cˣ) (y : k_Mˣ), valL F M_C (u : M_C) = 0 → resM (u : M_C) = (y : k_M) →
        (θ (v_M y))⁻¹ = (θ u)⁻¹ := by
    intro θ hθ1 u y hu_val hu_res
    have hu_int : (u : M_C) = 0 ∨ 0 ≤ valL F M_C (u : M_C) := Or.inr (by omega)
    have hneg_v_int : -((v_M y : M_Cˣ) : M_C) = 0 ∨ 0 ≤ valL F M_C (-((v_M y : M_Cˣ) : M_C)) := by
      right; rw [hval_neg_MC, hv_M_val0 y]
    set d : M_C := (u : M_C) - ((v_M y : M_Cˣ) : M_C)
    have hd_int : d = 0 ∨ 0 ≤ valL F M_C d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_MC 0 (u : M_C) (-((v_M y : M_Cˣ) : M_C)) hu_int hneg_v_int
    have hd_res : resM d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg,
        (hresM_ring (u : M_C) (-((v_M y : M_Cˣ) : M_C)) hu_int hneg_v_int).1,
        (hresM_ring ((v_M y : M_Cˣ) : M_C) ((v_M y : M_Cˣ) : M_C) (hv_M_int y) (hv_M_int y)).2.2,
        hu_res, hv_M_res y, add_neg_cancel]
    have hd1 : d = 0 ∨ 1 ≤ valL F M_C d := (hresM_ker d hd_int).mp hd_res
    set h : M_Cˣ := (v_M y)⁻¹ * u
    have hh_sub : (h : M_C) - 1 = (((v_M y)⁻¹ : M_Cˣ) : M_C) * d := by
      have hinv : (((v_M y)⁻¹ : M_Cˣ) : M_C) * ((v_M y : M_Cˣ) : M_C) = 1 := by
        exact_mod_cast Units.inv_mul (v_M y)
      calc (h : M_C) - 1 =
            (((v_M y)⁻¹ : M_Cˣ) : M_C) * (u : M_C) - (((v_M y)⁻¹ : M_Cˣ) : M_C) * ((v_M y : M_Cˣ) : M_C) := by
            rw [Units.val_mul, hinv]
        _ = (((v_M y)⁻¹ : M_Cˣ) : M_C) * d := by dsimp only [d]; ring
    have hh_mem : h ∈ unitGroup F M_C 1 := by
      rw [hunit_ge1_MC 1 le_rfl h]
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : M_C) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : 1 ≤ valL F M_C d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul_MC (((v_M y)⁻¹ : M_Cˣ) : M_C) d (Units.ne_zero (v_M y)⁻¹) hd0,
          hval_inv_MC (v_M y), hv_M_val0 y]
        omega
    have hθ_h : θ h = 1 := hθ1 h hh_mem
    have hθ_u : θ u = θ (v_M y) := by
      have huv : v_M y * h = u := mul_inv_cancel_left (v_M y) u
      rw [← huv, map_mul, hθ_h, mul_one]
    rw [hθ_u]
  let mkDescCharM : ∀ (θ : M_Cˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F M_C 1, θ u = 1) → (k_Mˣ →* (Ω F)ˣ) :=
    fun θ hθ1 =>
      { toFun := fun y => (θ (v_M y))⁻¹
        map_one' := by
          have h1 : (θ (v_M 1))⁻¹ = (θ 1)⁻¹ :=
            hdesc_unit_MC θ hθ1 1 1 (by rw [Units.val_one, hval1_MC])
              (by rw [Units.val_one, hresM_1, Units.val_one])
          rw [h1, map_one, inv_one]
        map_mul' := fun y₁ y₂ => by
          have hab_val : valL F M_C ((v_M y₁ * v_M y₂ : M_Cˣ) : M_C) = 0 := by
            rw [Units.val_mul,
              hval_mul_MC ((v_M y₁ : M_Cˣ) : M_C) ((v_M y₂ : M_Cˣ) : M_C)
                (Units.ne_zero (v_M y₁)) (Units.ne_zero (v_M y₂)),
              hv_M_val0 y₁, hv_M_val0 y₂, add_zero]
          have hab_res : resM ((v_M y₁ * v_M y₂ : M_Cˣ) : M_C) = ((y₁ * y₂ : k_Mˣ) : k_M) := by
            rw [Units.val_mul,
              (hresM_ring ((v_M y₁ : M_Cˣ) : M_C) ((v_M y₂ : M_Cˣ) : M_C)
                (hv_M_int y₁) (hv_M_int y₂)).2.1,
              hv_M_res y₁, hv_M_res y₂, Units.val_mul]
          have hm := hdesc_unit_MC θ hθ1 (v_M y₁ * v_M y₂) (y₁ * y₂) hab_val hab_res
          rw [hm, map_mul, mul_inv] }
  let μ_tilde : Fin r → (k_Mˣ →* (Ω F)ˣ) := fun i => mkDescCharM (ν_orb i) (hν_cond1 i).2
  have hμ_unit : ∀ (i : Fin r) (u : M_Cˣ) (y : k_Mˣ),
      valL F M_C (u : M_C) = 0 → resM (u : M_C) = (y : k_M) →
        (μ_tilde i) y = ((ν_orb i) u)⁻¹ :=
    fun i u y hu hy => hdesc_unit_MC (ν_orb i) (hν_cond1 i).2 u y hu hy

  have hμ_props : ∀ i : Fin r, (μ_tilde i) ^ ℓ = 1 ∧ μ_tilde i ≠ 1 := by
    intro i
    refine ⟨?_, ?_⟩
    · apply MonoidHom.ext
      intro y
      rw [MonoidHom.pow_apply, MonoidHom.one_apply]
      change ((ν_orb i) (v_M y))⁻¹ ^ ℓ = 1
      rw [inv_pow, ← MonoidHom.pow_apply, (hν_props i).1, MonoidHom.one_apply, inv_one]
    · intro hμ1
      have hspec_ν :=
        (hSpec_all M_C (traceChar F hLM_C ψ) hψMC (ν_orb i)).2.2.1 (by rw [(hν_cond1 i).1]; omega)
      obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := hspec_ν.2
      rw [(hν_cond1 i).1] at hu₀_mem
      have hu₀_val : valL F M_C (u₀ : M_C) = 0 := (hunit0_MC u₀).mp hu₀_mem
      have hu₀_res_ne : resM (u₀ : M_C) ≠ 0 := by
        intro h0
        rcases (hresM_ker (u₀ : M_C) (Or.inr (by omega))).mp h0 with h1 | h2
        · exact Units.ne_zero u₀ h1
        · omega
      set y₀ : k_Mˣ := Units.mk0 (resM (u₀ : M_C)) hu₀_res_ne
      have hμ_y₀ : (μ_tilde i) y₀ = ((ν_orb i) u₀)⁻¹ := hμ_unit i u₀ y₀ hu₀_val rfl
      have hμ_1 : (μ_tilde i) y₀ = 1 := by rw [hμ1]; rfl
      exact hu₀_ne (inv_eq_one.mp (hμ_y₀.symm.trans hμ_1))

  have hμ_orb_sum : ∀ y : k_Mˣ,
      1 + (∑ i : Fin r,
        ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
          (((μ_tilde i) ^ c) y : Ω F)) =
        ∑ j ∈ Finset.range ℓ, (((μ_tilde ⟨0, hr_pos⟩) ^ j) y : Ω F) := by
    intro y
    have hpow_eq : ∀ (i : Fin r) (m : ℕ),
        (((μ_tilde i) ^ m) y : Ω F) = (((ν_orb i) ^ m) ((v_M y)⁻¹) : Ω F) := by
      intro i m
      congr 1
      rw [MonoidHom.pow_apply, MonoidHom.pow_apply]
      change (((ν_orb i) (v_M y))⁻¹) ^ m = ((ν_orb i) ((v_M y)⁻¹)) ^ m
      rw [map_inv]
    simp_rw [hpow_eq]
    exact hν_orb_sum (ν_orb ⟨0, hr_pos⟩) (hν_props ⟨0, hr_pos⟩).1 (hν_props ⟨0, hr_pos⟩).2.1
      (hν_props ⟨0, hr_pos⟩).2.2.1 ((v_M y)⁻¹)

  
  
  
  set c₁_M : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁
  have hc₁_M_coe : (c₁_M : M_C) = IntermediateField.inclusion hLM_C (c₁ : L) := rfl
  have hc₁_M_inv_coe : ((c₁_M⁻¹ : M_Cˣ) : M_C) =
      IntermediateField.inclusion hLM_C ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_M_val : valL F M_C (c₁_M : M_C) = 1 + condExpChar F M_C (traceChar F hLM_C ψ) := by
    rw [hc₁_M_coe, hval_alg_MC (c₁ : L), hc₁_val, hcondChar_MC]
  have hν_c₁M : ∀ i : Fin r, (ν_orb i) c₁_M = 1 := fun i => hν_triv_L i c₁

  set ψ_tilde_M : k_M → Ω F := fun b => ψ_k (Algebra.trace k_L k_M b)
  have hψM_int : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ψ_tilde_M (resM z) = (traceChar F hLM_C ψ) (((c₁_M⁻¹ : M_Cˣ) : M_C) * z) := by
    intro z hz
    have htr_int : traceLM F hLM_C z = 0 ∨ 0 ≤ valL F L (traceLM F hLM_C z) := htr_int_MC z hz
    have htr_res : resL (traceLM F hLM_C z) = Algebra.trace k_L k_M (resM z) :=
      (hres_tr_norm_MC z hz).1
    dsimp only [ψ_tilde_M]
    rw [← htr_res, hψ_k_apply, hψ_int (traceLM F hLM_C z) htr_int]
    change ψ (((c₁⁻¹ : Lˣ) : L) * traceLM F hLM_C z) =
      ψ (traceLM F hLM_C (((c₁_M⁻¹ : M_Cˣ) : M_C) * z))
    rw [hc₁_M_inv_coe, htrace_mul_inc_MC]

  have hsum_units_kM : ∀ (θ_M : k_Mˣ →* (Ω F)ˣ),
      (∑ b : k_M, (if hb : b = 0 then (0 : Ω F) else (θ_M (Units.mk0 b hb) : Ω F)) * ψ_tilde_M b) =
        ∑ y : k_Mˣ, (θ_M y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M)) := by
    intro θ_M
    have herase :
        (∑ b : k_M, (if hb : b = 0 then (0 : Ω F) else (θ_M (Units.mk0 b hb) : Ω F)) * ψ_tilde_M b) =
          ∑ b ∈ (Finset.univ : Finset k_M).erase 0,
            (if hb : b = 0 then (0 : Ω F) else (θ_M (Units.mk0 b hb) : Ω F)) * ψ_tilde_M b := by
      exact (Finset.sum_erase Finset.univ (by simp)).symm
    rw [herase]
    refine (Finset.sum_bij (fun (y : k_Mˣ) _ => (y : k_M)) ?_ ?_ ?_ ?_).symm
    · intro y _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero y, Finset.mem_univ _⟩
    · intro y₁ _ y₂ _ h
      exact Units.ext h
    · intro b hb
      have hb_ne : b ≠ 0 := (Finset.mem_erase.mp hb).1
      exact ⟨Units.mk0 b hb_ne, Finset.mem_univ _, rfl⟩
    · intro y _
      rw [dif_neg (Units.ne_zero y), Units.mk0_val]

  set Q_MC : Ω F := (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ)
  have htate_MC_untwist : ∀ i : Fin r,
      tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ) =
        Q_MC * (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M))) := by
    intro i
    set χ_tilde_i : k_M → Ω F := fun b =>
      if hb : b = 0 then 0 else ((μ_tilde i) (Units.mk0 b hb) : Ω F)
    have hχ_zero : χ_tilde_i 0 = 0 := dif_pos rfl
    have hχ_unit : ∀ u : M_Cˣ, valL F M_C (u : M_C) = 0 →
        χ_tilde_i (resM (u : M_C)) = ((ν_orb i) u : Ω F)⁻¹ := by
      intro u hu
      have hres_ne : resM (u : M_C) ≠ 0 := by
        intro h0
        rcases (hresM_ker (u : M_C) (Or.inr (by omega))).mp h0 with h1 | h2
        · exact Units.ne_zero u h1
        · omega
      dsimp only [χ_tilde_i]
      rw [dif_neg hres_ne, hμ_unit i u (Units.mk0 (resM (u : M_C)) hres_ne) hu rfl,
        Units.val_inv_eq_inv_val]
    have hG := hGauss_MC i c₁_M hc₁_M_val χ_tilde_i ψ_tilde_M hχ_zero hχ_unit hψM_int
    rw [hG, hν_c₁M i, Units.val_one, mul_one, hsum_units_kM (μ_tilde i)]

  have hprod_MC_untwist :
      (∏ i : Fin r, tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ)) =
        Q_MC ^ r *
          (∏ i : Fin r,
            (∑ y : k_Mˣ, ((μ_tilde i) y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M)))) := by
    rw [Finset.prod_congr rfl (fun i _ => htate_MC_untwist i),
      Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

  have hVand := hVand_orbit hNeChar ψ_k hψ_k_ne μ_tilde hμ_props hμ_orb_sum
  refine ⟨?_, ?_⟩
  · rw [hprod_MC_untwist, hVand.1]
  · intro ha_odd Q_L ψ_0 hψ0_spec hQL_0 hQL_add
    have ha_sub_eq : a - 1 = 2 * (a / 2) := by omega
    have hψ0_eq_ψk : ∀ b : k_L, ψ_0 b = ψ_k b := by
      intro b
      rw [← hs_L_res b, hψ0_spec (s_L b) (hs_L_int b), hψ_k_apply, hψ_int (s_L b) (hs_L_int b),
        hc₁_inv_coe, ha_sub_eq]
    have hQL_add_k : ∀ x y : k_L, Q_L (x + y) = Q_L x * Q_L y * ψ_k (x * y) := by
      intro x y
      rw [hQL_add x y, hψ0_eq_ψk (x * y)]
    exact hVand.2 Q_L hQL_0 hQL_add_k

theorem ld_ch13_tame_higher_cond_odd_hasse_sums_le (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K) (hLE : L ≤ E)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F))
    (χ' : Lˣ →* (Ω F)ˣ)
    (ha2 : 2 ≤ condExp F L χ')
    (ha_odd : condExp F L χ' % 2 = 1)
    (ϖ_L c_L : Lˣ) (hϖ_L_val : valL F L (ϖ_L : L) = 1)
    (hval_alg_E : ∀ x : L, valL F E (IntermediateField.inclusion hLE x) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hcond_E : condExp F E (χ'.comp (Units.map (normLM F hLE))) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) * (condExp F L χ' - 1) + 1)
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (liftL : k_L → L) (R_L : Finset L) (R_E : Finset E) (c_E : Eˣ)
    (hliftL : ∀ b : k_L, (liftL b = 0 ∨ 0 ≤ valL F L (liftL b)) ∧ resL (liftL b) = b)
    (hRL_sum : ∀ g : L → Ω F, (∑ r ∈ R_L, g r) = ∑ b : k_L, g (liftL b))
    (hRE_sum : ∀ g_E : E → Ω F,
      (∑ r ∈ R_E, g_E r) = ∑ b : k_L, g_E (IntermediateField.inclusion hLE (liftL b)))
    (hc_E_inv : ((c_E⁻¹ : Eˣ) : E) = IntermediateField.inclusion hLE ((c_L⁻¹ : Lˣ) : L))
    (Q_L : k_L → Ω F)
    (hQL_spec : ∀ (x : L) (hx_int : x = 0 ∨ 0 ≤ valL F L x)
      (hx_ne : 1 + ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * x ≠ 0),
      Q_L (resL x) =
        (χ' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * x) hx_ne) : Ω F)⁻¹ *
          ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * x)) :
    ∃ (δ_L : Lˣ) (δ_E : Eˣ),
      valL F L (δ_L : L) = ((condExp F L χ' / 2 : ℕ) : ℤ) ∧
      valL F E (δ_E : E) =
        ((condExp F E (χ'.comp (Units.map (normLM F hLE))) / 2 : ℕ) : ℤ) ∧
      (∑ r ∈ R_L,
        if hr : 1 + (δ_L : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + (δ_L : L) * r) hr) : Ω F)⁻¹ *
            ψ (((c_L⁻¹ : Lˣ) : L) * (δ_L : L) * r)
        else 0) = (∑ b : k_L, Q_L b) ∧
      (∑ r ∈ R_E,
        if hr : 1 + (δ_E : E) * r ≠ 0 then
          ((χ'.comp (Units.map (normLM F hLE))) (Units.mk0 (1 + (δ_E : E) * r) hr) : Ω F)⁻¹ *
            (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * (δ_E : E) * r)
        else 0) =
        (∑ b : k_L, (Q_L b) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))) :=
by
  classical
  set ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  set a := condExp F L χ'
  set d := a / 2
  set A := condExp F E (χ'.comp (Units.map (normLM F hLE)))
  set D := A / 2
  have hd_ge1 : 1 ≤ d := by omega
  have ha_sub1 : a - 1 = 2 * d := by omega
  have hD_eq : D = ℓ * d := by
    dsimp only [D]
    rw [hcond_E]
    have hmul : ℓ * (a - 1) + 1 = 2 * (ℓ * d) + 1 := by
      rw [ha_sub1]
      ring
    omega
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, _, _, _, _, _, _⟩ := hval_all L
  have hϖ_pow_val : ∀ m : ℕ, valL F L ((ϖ_L ^ m : Lˣ) : L) = (m : ℤ) := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero, Units.val_one, hval1_L, Nat.cast_zero]
    | succ m ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul_L ((ϖ_L ^ m : Lˣ) : L) (ϖ_L : L) (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_L_val, Nat.cast_succ]
  set δ_L : Lˣ := ϖ_L ^ d
  set δ_E : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom δ_L
  have hδ_L_val : valL F L (δ_L : L) = (d : ℤ) := hϖ_pow_val d
  have hδ_E_coe : (δ_E : E) = IntermediateField.inclusion hLE (δ_L : L) := rfl
  have hδ_E_val : valL F E (δ_E : E) = (D : ℤ) := by
    rw [hδ_E_coe, hval_alg_E (δ_L : L), hδ_L_val, hD_eq, Nat.cast_mul]
  have h1_add_δx_ne : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → 1 + (δ_L : L) * x ≠ 0 := by
    intro x hx h0
    have hz_neg1 : (δ_L : L) * x = -1 := eq_neg_of_add_eq_zero_right h0
    by_cases hx0 : x = 0
    · rw [hx0, mul_zero] at hz_neg1
      exact one_ne_zero (neg_eq_zero.mp hz_neg1.symm)
    · have hx_ge0 : 0 ≤ valL F L x := hx.resolve_left hx0
      have hv := congrArg (valL F L) hz_neg1
      rw [hval_mul_L (δ_L : L) x (Units.ne_zero δ_L) hx0, hδ_L_val, hval_neg1_L] at hv
      omega
  have hsum_L :
      (∑ r ∈ R_L,
        if hr : 1 + (δ_L : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + (δ_L : L) * r) hr) : Ω F)⁻¹ *
            ψ (((c_L⁻¹ : Lˣ) : L) * (δ_L : L) * r)
        else 0) = (∑ b : k_L, Q_L b) := by
    rw [hRL_sum (fun r : L =>
      if hr : 1 + (δ_L : L) * r ≠ 0 then
        (χ' (Units.mk0 (1 + (δ_L : L) * r) hr) : Ω F)⁻¹ *
          ψ (((c_L⁻¹ : Lˣ) : L) * (δ_L : L) * r)
      else 0)]
    apply Finset.sum_congr rfl
    intro b _
    dsimp only
    set x : L := liftL b
    have hx_int : x = 0 ∨ 0 ≤ valL F L x := (hliftL b).1
    have hx_res : resL x = b := (hliftL b).2
    have hrL : 1 + (δ_L : L) * x ≠ 0 := h1_add_δx_ne x hx_int
    rw [dif_pos hrL, ← hx_res]
    exact (hQL_spec x hx_int hrL).symm
  let E' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE
  have hinc_alg : ∀ u : L, toExtendScalars F hLE (IntermediateField.inclusion hLE u) = algebraMap L E' u :=
    fun _ => rfl
  have hnorm_inc : ∀ u : L, normLM F hLE (IntermediateField.inclusion hLE u) = u ^ ℓ := by
    intro u
    change Algebra.norm L (toExtendScalars F hLE (IntermediateField.inclusion hLE u)) = u ^ ℓ
    rw [hinc_alg u, Algebra.norm_algebraMap, hFinE_eq]
  have htrace_inc : ∀ u : L, traceLM F hLE (IntermediateField.inclusion hLE u) = ℓ • u := by
    intro u
    change Algebra.trace L E' (toExtendScalars F hLE (IntermediateField.inclusion hLE u)) = ℓ • u
    rw [hinc_alg u, Algebra.trace_algebraMap, hFinE_eq]
  have hsum_E :
      (∑ r ∈ R_E,
        if hr : 1 + (δ_E : E) * r ≠ 0 then
          ((χ'.comp (Units.map (normLM F hLE))) (Units.mk0 (1 + (δ_E : E) * r) hr) : Ω F)⁻¹ *
            (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * (δ_E : E) * r)
        else 0) = (∑ b : k_L, (Q_L b) ^ ℓ) := by
    rw [hRE_sum (fun r : E =>
      if hr : 1 + (δ_E : E) * r ≠ 0 then
        ((χ'.comp (Units.map (normLM F hLE))) (Units.mk0 (1 + (δ_E : E) * r) hr) : Ω F)⁻¹ *
          (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * (δ_E : E) * r)
      else 0)]
    apply Finset.sum_congr rfl
    intro b _
    dsimp only
    set x : L := liftL b
    have hx_int : x = 0 ∨ 0 ≤ valL F L x := (hliftL b).1
    have hx_res : resL x = b := (hliftL b).2
    have hrL : 1 + (δ_L : L) * x ≠ 0 := h1_add_δx_ne x hx_int
    have hinc_1_x :
        1 + (δ_E : E) * IntermediateField.inclusion hLE x =
          IntermediateField.inclusion hLE (1 + (δ_L : L) * x) := by
      rw [hδ_E_coe, map_add, map_one, map_mul]
    have hrE : 1 + (δ_E : E) * IntermediateField.inclusion hLE x ≠ 0 := by
      rw [hinc_1_x]
      exact (map_ne_zero (IntermediateField.inclusion hLE)).mpr hrL
    rw [dif_pos hrE]
    have hnorm_unit :
        Units.map (normLM F hLE)
          (Units.mk0 (1 + (δ_E : E) * IntermediateField.inclusion hLE x) hrE) =
          (Units.mk0 (1 + (δ_L : L) * x) hrL) ^ ℓ := by
      apply Units.ext
      change normLM F hLE (1 + (δ_E : E) * IntermediateField.inclusion hLE x) =
        (1 + (δ_L : L) * x) ^ ℓ
      rw [hinc_1_x, hnorm_inc]
    have hχE_term :
        (((χ'.comp (Units.map (normLM F hLE)))
          (Units.mk0 (1 + (δ_E : E) * IntermediateField.inclusion hLE x) hrE) : Ω F)⁻¹) =
          ((χ' (Units.mk0 (1 + (δ_L : L) * x) hrL) : Ω F)⁻¹) ^ ℓ := by
      rw [MonoidHom.comp_apply, hnorm_unit, map_pow, Units.val_pow_eq_pow_val, inv_pow]
    have hψE_term :
        (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * (δ_E : E) * IntermediateField.inclusion hLE x) =
          (ψ (((c_L⁻¹ : Lˣ) : L) * (δ_L : L) * x)) ^ ℓ := by
      have hinc_prod :
          ((c_E⁻¹ : Eˣ) : E) * (δ_E : E) * IntermediateField.inclusion hLE x =
            IntermediateField.inclusion hLE (((c_L⁻¹ : Lˣ) : L) * (δ_L : L) * x) := by
        rw [hc_E_inv, hδ_E_coe, ← map_mul, ← map_mul]
      rw [hinc_prod]
      change ψ (traceLM F hLE (IntermediateField.inclusion hLE (((c_L⁻¹ : Lˣ) : L) * (δ_L : L) * x))) = _
      rw [htrace_inc, AddChar.map_nsmul_eq_pow]
    rw [hχE_term, hψE_term, ← mul_pow, ← hQL_spec x hx_int hrL, hx_res]
  exact ⟨δ_L, δ_E, hδ_L_val, hδ_E_val, hsum_L, hsum_E⟩

theorem ld_ch13_tame_higher_cond_twisted_mc_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hOdd_ℓ : Module.finrank M_C (IntermediateField.extendScalars hM_CK) ≠ 2)
    (ψ : AddChar L (Ω F))
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (r : ℕ)
    (hr_mul : r * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (ha2 : 2 ≤ condExp F L χ')
    (hν_cond1 : ∀ i : Fin r,
      condExp F M_C (ν_orb i) = 1 ∧
      (∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1))
    (hν_triv_L : ∀ (i : Fin r) (x : Lˣ),
      (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom x) = 1)
    (hcond_MC : condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ')
    (hcond_E : condExp F E (χ'.comp (Units.map (normLM F hLE))) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) * (condExp F L χ' - 1) + 1)
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (hStat : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      let m := condExp F M θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (r₀ : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c_θ⁻¹ : Mˣ) : M) * x)) ∧
      (∀ (c : Mˣ),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
        (∀ x : M, (x = 0 ∨ (r₀ : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c⁻¹ : Mˣ) : M) * x)) →
        (∀ (ν : Mˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F M d, ν u = 1) →
          condExp F M (ν * θ) = m ∧
          tateEps F M (ν * θ) ψ_M = (ν c : Ω F) * tateEps F M θ ψ_M) ∧
        (∀ (R_M : Finset M) (δ : Mˣ),
          (∀ r ∈ R_M, r = 0 ∨ 0 ≤ valL F M r) →
          (∀ r₁ ∈ R_M, ∀ r₂ ∈ R_M, r₁ ≠ r₂ → valL F M (r₁ - r₂) = 0) →
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            ∃ r ∈ R_M, x - r = 0 ∨ 1 ≤ valL F M (x - r)) →
          valL F M (δ : M) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F M θ ψ_M =
              (qL F M : Ω F) ^ condExpChar F M ψ_M *
                (R_M.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_M (((c⁻¹ : Mˣ) : M))) ∧
          (m % 2 = 1 →
            tateEps F M θ ψ_M =
              (qL F M : Ω F) ^ condExpChar F M ψ_M *
                (R_M.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_M (((c⁻¹ : Mˣ) : M)) *
                ∑ r ∈ R_M,
                  if hr : 1 + (δ : M) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : M) * r) hr) : Ω F)⁻¹ *
                      ψ_M (((c⁻¹ : Mˣ) : M) * (δ : M) * r)
                  else 0))))
    (c_L : Lˣ)
    (hMC_stat_val : valL F M_C
      ((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c_L : M_Cˣ) : M_C) =
      (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) : ℤ) +
        condExpChar F M_C (traceChar F hLM_C ψ))
    (hMC_stat_x : ∀ x : M_C,
      (x = 0 ∨ (((condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) + 1) / 2 : ℕ) : ℤ) ≤ valL F M_C x) →
      ∀ hx : 1 + x ≠ 0,
        ((χ'.comp (Units.map (normLM F hLM_C))) (Units.mk0 (1 + x) hx) : Ω F) =
          (traceChar F hLM_C ψ)
            ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c_L)⁻¹ : M_Cˣ) : M_C) * x)) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    let a := condExp F L χ'
    let d := a / 2
    let A := condExp F E (χ'.comp (Units.map (normLM F hLE)))
    let D := A / 2
    (∏ i : Fin r,
      tateEps F M_C (ν_orb i * χ'.comp (Units.map (normLM F hLM_C)))
        (traceChar F hLM_C ψ)) =
      (tateEps F M_C (χ'.comp (Units.map (normLM F hLM_C))) (traceChar F hLM_C ψ)) ^ r ∧
    (a % 2 = 0 →
      A % 2 = 0 ∧
      ∀ (Q_E Q_L Q_MC C X P : Ω F),
        (Q_E * C ^ D * X ^ ℓ * P ^ ℓ) * Q_L * (Q_MC ^ r * C ^ ((ℓ - 1) / 2)) =
          Q_E * (Q_L * C ^ d * X * P) * (Q_MC * (C ^ d) ^ f_H * X ^ f_H * P ^ f_H) ^ r) ∧
    (a % 2 = 1 →
      A % 2 = 1 ∧
      ∀ (Q_E Q_L Q_MC C X P S₁ S₂ : Ω F),
        S₁ ^ ℓ = (-1 : Ω F) ^ (r * (f_H - 1)) * C ^ ((ℓ - 1) / 2) * S₂ →
        (Q_E * C ^ D * X ^ ℓ * P ^ ℓ * S₂) * Q_L * (Q_MC ^ r * C ^ ((ℓ - 1) / 2)) =
          Q_E * (Q_L * C ^ d * X * P * S₁) *
            (Q_MC * (C ^ d) ^ f_H * X ^ f_H * P ^ f_H * (-1 : Ω F) ^ (f_H - 1) * S₁ ^ f_H) ^ r) :=
by
  set ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  set f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
  set a := condExp F L χ'
  set d := a / 2
  set A := condExp F E (χ'.comp (Units.map (normLM F hLE)))
  set D := A / 2
  set χ'_MC := χ'.comp (Units.map (normLM F hLM_C))
  set ψ_MC := traceChar F hLM_C ψ
  set c_MC : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c_L
  have ha2_MC : 2 ≤ condExp F M_C χ'_MC := by
    rw [hcond_MC]
    exact ha2
  have hd_MC_ge1 : 1 ≤ condExp F M_C χ'_MC / 2 := by omega
  have hν_triv_d : ∀ (i : Fin r) (u : M_Cˣ),
      u ∈ unitGroup F M_C (condExp F M_C χ'_MC / 2) → (ν_orb i) u = 1 := by
    intro i u hu
    have hvalMC_u := (hval_all M_C).2.2.2.2.2.2.2.2.2.1
    have hu_iff := (hvalMC_u (condExp F M_C χ'_MC / 2) hd_MC_ge1 u).mp hu
    have hu1 : u ∈ unitGroup F M_C 1 := by
      rw [hvalMC_u 1 le_rfl u]
      rcases hu_iff with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (by omega)
    exact (hν_cond1 i).2 u hu1
  have hStatMC := (hStat M_C ψ_MC hψMC χ'_MC ha2_MC).2 c_MC hMC_stat_val hMC_stat_x
  have hterm : ∀ i ∈ (Finset.univ : Finset (Fin r)),
      tateEps F M_C (ν_orb i * χ'_MC) ψ_MC = tateEps F M_C χ'_MC ψ_MC := by
    intro i _
    have h := (hStatMC.1 (ν_orb i) (hν_triv_d i)).2
    have htriv : ((ν_orb i) c_MC : Ω F) = 1 := by
      rw [hν_triv_L i c_L, Units.val_one]
    rw [h, htriv, one_mul]
  have hTwist_MC :
      (∏ i : Fin r, tateEps F M_C (ν_orb i * χ'_MC) ψ_MC) =
        (tateEps F M_C χ'_MC ψ_MC) ^ r := by
    rw [Finset.prod_congr rfl hterm, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  have hℓ_odd : ℓ % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime_MCK).resolve_left hOdd_ℓ
  have hℓ_ge2 : 2 ≤ ℓ := hPrime_MCK.two_le
  have hfr_mul : f_H * r = ℓ - 1 := by
    rw [mul_comm]
    exact hr_mul
  have hℓ_rf : 1 + f_H * r = ℓ := by omega
  have hpow_rf : ∀ Y : Ω F, Y ^ ℓ = Y * (Y ^ f_H) ^ r := by
    intro Y
    calc Y ^ ℓ
        = Y ^ (1 + f_H * r) := by rw [← hℓ_rf]
      _ = Y ^ 1 * Y ^ (f_H * r) := pow_add Y 1 (f_H * r)
      _ = Y * (Y ^ f_H) ^ r := by rw [pow_one, pow_mul]
  have hEven_alg : a % 2 = 0 →
      A % 2 = 0 ∧
      ∀ (Q_E Q_L Q_MC C X P : Ω F),
        (Q_E * C ^ D * X ^ ℓ * P ^ ℓ) * Q_L * (Q_MC ^ r * C ^ ((ℓ - 1) / 2)) =
          Q_E * (Q_L * C ^ d * X * P) * (Q_MC * (C ^ d) ^ f_H * X ^ f_H * P ^ f_H) ^ r := by
    intro ha_even
    have hA_arith : A % 2 = 0 ∧ D + (ℓ - 1) / 2 = ℓ * d := by
      have hd_eq : d = (d - 1) + 1 := by omega
      have ha_eq : a - 1 = 2 * (d - 1) + 1 := by omega
      have hℓ_eq : ℓ = 2 * ((ℓ - 1) / 2) + 1 := by omega
      have hA_eq :
          A = 2 * (2 * ((ℓ - 1) / 2) * (d - 1) + (ℓ - 1) / 2 + (d - 1) + 1) := by
        conv_lhs => rw [hcond_E, hℓ_eq, ha_eq]
        ring
      have hld_eq :
          ℓ * d =
            (2 * ((ℓ - 1) / 2) * (d - 1) + (ℓ - 1) / 2 + (d - 1) + 1) +
              (ℓ - 1) / 2 := by
        conv_lhs => rw [hℓ_eq, hd_eq]
        ring
      omega
    refine ⟨hA_arith.1, ?_⟩
    intro Q_E Q_L Q_MC C X P
    have hC_ev : C ^ D * C ^ ((ℓ - 1) / 2) = C ^ d * ((C ^ d) ^ f_H) ^ r := by
      calc C ^ D * C ^ ((ℓ - 1) / 2)
          = C ^ (D + (ℓ - 1) / 2) := (pow_add C D ((ℓ - 1) / 2)).symm
        _ = C ^ (ℓ * d) := by rw [hA_arith.2]
        _ = C ^ (d * ℓ) := by rw [mul_comm ℓ d]
        _ = (C ^ d) ^ ℓ := pow_mul C d ℓ
        _ = C ^ d * ((C ^ d) ^ f_H) ^ r := hpow_rf (C ^ d)
    calc (Q_E * C ^ D * X ^ ℓ * P ^ ℓ) * Q_L * (Q_MC ^ r * C ^ ((ℓ - 1) / 2))
        = Q_E * Q_L * Q_MC ^ r * (C ^ D * C ^ ((ℓ - 1) / 2)) * X ^ ℓ * P ^ ℓ := by ring
      _ = Q_E * Q_L * Q_MC ^ r * (C ^ d * ((C ^ d) ^ f_H) ^ r) *
            (X * (X ^ f_H) ^ r) * (P * (P ^ f_H) ^ r) := by
          rw [hC_ev, hpow_rf X, hpow_rf P]
      _ = Q_E * (Q_L * C ^ d * X * P) * (Q_MC * (C ^ d) ^ f_H * X ^ f_H * P ^ f_H) ^ r := by
          rw [mul_pow, mul_pow, mul_pow]
          ring
  have hOdd_alg : a % 2 = 1 →
      A % 2 = 1 ∧
      ∀ (Q_E Q_L Q_MC C X P S₁ S₂ : Ω F),
        S₁ ^ ℓ = (-1 : Ω F) ^ (r * (f_H - 1)) * C ^ ((ℓ - 1) / 2) * S₂ →
        (Q_E * C ^ D * X ^ ℓ * P ^ ℓ * S₂) * Q_L * (Q_MC ^ r * C ^ ((ℓ - 1) / 2)) =
          Q_E * (Q_L * C ^ d * X * P * S₁) *
            (Q_MC * (C ^ d) ^ f_H * X ^ f_H * P ^ f_H * (-1 : Ω F) ^ (f_H - 1) * S₁ ^ f_H) ^ r := by
    intro ha_odd
    have hA_arith_odd : A % 2 = 1 ∧ D = ℓ * d := by
      have ha_eq : a - 1 = 2 * d := by omega
      have hA_eq : A = 2 * (ℓ * d) + 1 := by
        rw [hcond_E, ha_eq]
        ring
      omega
    refine ⟨hA_arith_odd.1, ?_⟩
    intro Q_E Q_L Q_MC C X P S₁ S₂ hS₁
    have hC_od : C ^ D = C ^ d * ((C ^ d) ^ f_H) ^ r := by
      calc C ^ D
          = C ^ (ℓ * d) := by rw [hA_arith_odd.2]
        _ = C ^ (d * ℓ) := by rw [mul_comm ℓ d]
        _ = (C ^ d) ^ ℓ := pow_mul C d ℓ
        _ = C ^ d * ((C ^ d) ^ f_H) ^ r := hpow_rf (C ^ d)
    have hsign_cancel :
        (-1 : Ω F) ^ (r * (f_H - 1)) * ((-1 : Ω F) ^ (f_H - 1)) ^ r = 1 := by
      rw [← pow_mul, mul_comm (f_H - 1) r, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
    symm
    calc Q_E * (Q_L * C ^ d * X * P * S₁) *
          (Q_MC * (C ^ d) ^ f_H * X ^ f_H * P ^ f_H * (-1 : Ω F) ^ (f_H - 1) * S₁ ^ f_H) ^ r
        = Q_E * Q_L * Q_MC ^ r * (C ^ d * ((C ^ d) ^ f_H) ^ r) *
            (X * (X ^ f_H) ^ r) * (P * (P ^ f_H) ^ r) *
            ((-1 : Ω F) ^ (f_H - 1)) ^ r * (S₁ * (S₁ ^ f_H) ^ r) := by
          rw [mul_pow, mul_pow, mul_pow, mul_pow, mul_pow]
          ring
      _ = Q_E * Q_L * Q_MC ^ r * C ^ D * X ^ ℓ * P ^ ℓ *
            ((-1 : Ω F) ^ (f_H - 1)) ^ r *
            ((-1 : Ω F) ^ (r * (f_H - 1)) * C ^ ((ℓ - 1) / 2) * S₂) := by
          rw [← hC_od, ← hpow_rf X, ← hpow_rf P, ← hpow_rf S₁, hS₁]
      _ = Q_E * Q_L * Q_MC ^ r * C ^ D * X ^ ℓ * P ^ ℓ * C ^ ((ℓ - 1) / 2) * S₂ *
            ((-1 : Ω F) ^ (r * (f_H - 1)) * ((-1 : Ω F) ^ (f_H - 1)) ^ r) := by
          ring
      _ = (Q_E * C ^ D * X ^ ℓ * P ^ ℓ * S₂) * Q_L * (Q_MC ^ r * C ^ ((ℓ - 1) / 2)) := by
          rw [hsign_cancel, mul_one]
          ring
  exact ⟨hTwist_MC, hEven_alg, hOdd_alg⟩

theorem ld_ch13_tame_higher_cond_orbit_assembly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hOdd_ℓ : Module.finrank M_C (IntermediateField.extendScalars hM_CK) ≠ 2)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hr_mul : r * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (ha2 : 2 ≤ condExp F L χ')
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hν_props : ∀ i : Fin r,
      (ν_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      ν_orb i ≠ 1 ∧
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ (ν_orb i) z = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k)), ((ν_orb i) ^ k) u = 1) ∧
      (∀ k < Module.finrank M_C (IntermediateField.extendScalars hM_CK),
        ∀ u ∈ unitGroup F M_C (condExp F M_C ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C)))),
          ((ν_orb i) ^ k * χ'.comp (Units.map (normLM F hLM_C))) u = 1))
    (hν_orb_sum : ∀ (ν₀ : M_Cˣ →* (Ω F)ˣ),
      ν₀ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 → ν₀ ≠ 1 →
      (∀ z : M_Cˣ, z ∈ Set.range (Units.map (normLM F hM_CK)) ↔ ν₀ z = 1) →
      ∀ z : M_Cˣ,
        1 + (∑ i : Fin r,
          ∑ c ∈ (Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK))).filter
            (fun c : ℕ => c ≠ 0 ∧ c ^ (Module.finrank L (IntermediateField.extendScalars hLM_C)) %
              (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1),
            (((ν_orb i) ^ c) z : Ω F)) =
          ∑ j ∈ Finset.range (Module.finrank M_C (IntermediateField.extendScalars hM_CK)),
            ((ν₀ ^ j) z : Ω F))
    (hν_cond1 : ∀ i : Fin r,
      condExp F M_C (ν_orb i) = 1 ∧
      (∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1))
    (hν_triv_L : ∀ (i : Fin r) (x : Lˣ),
      (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom x) = 1)
    (ϖ_L : Lˣ) (hϖ_L_val : valL F L (ϖ_L : L) = 1)
    (hval_alg_MC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x)
    (hcondChar_MC : condExpChar F M_C (traceChar F hLM_C ψ) = condExpChar F L ψ)
    (hcond_MC : condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) = condExp F L χ')
    (hval_alg_E : ∀ x : L, valL F E (IntermediateField.inclusion hLE x) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hResSurj_E : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨ 1 ≤ valL F E (y - IntermediateField.inclusion hLE x)))
    (htr_bound_E : ∀ (m : ℤ) (y : E),
      (y = 0 ∨ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
        ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1) ≤ valL F E y) →
      (traceLM F hLE y = 0 ∨ m ≤ valL F L (traceLM F hLE y)))
    (hnorm_rem_E : ∀ y : E, (y = 0 ∨ 1 ≤ valL F E y) →
      normLM F hLE (1 + y) - (1 + traceLM F hLE y) = 0 ∨
        2 * valL F E y ≤
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) *
            valL F L (normLM F hLE (1 + y) - (1 + traceLM F hLE y)))
    (hcondChar_E : condExpChar F E (traceChar F hLE ψ) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (hcond_E : condExp F E (χ'.comp (Units.map (normLM F hLE))) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) * (condExp F L χ' - 1) + 1)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] (resL : L → k_L) (resM : M_C → k_M)
    (hNotDvd : ∀ d : ℕ, 1 ≤ d → d < Module.finrank L (IntermediateField.extendScalars hLM_C) →
      ¬ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) ∣ ((Fintype.card k_L) ^ d - 1)))
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
      resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
      resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
      resM (-z₁) = -resM z₁)
    (hresM_ker : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) → (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M_C z)))
    (hresM_surj : ∀ b : k_M, ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧ resM z = b)
    (hres_tr_norm_MC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      resL (traceLM F hLM_C z) = Algebra.trace k_L k_M (resM z) ∧
      resL (normLM F hLM_C z) = Algebra.norm k_L (resM z))
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (hSpec_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ),
        (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
        (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) ∧
        (condExp F M θ ≠ 0 →
          (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) ∧
          (∃ u₀ ∈ unitGroup F M (condExp F M θ - 1), θ u₀ ≠ 1)) ∧
        valL F M ((tateElt F M θ ψ_M : Mˣ) : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hGauss_MC : ∀ (i : Fin r) (c_M : M_Cˣ),
      valL F M_C (c_M : M_C) = 1 + condExpChar F M_C (traceChar F hLM_C ψ) →
      ∀ (χ_tilde ψ_tilde : k_M → Ω F),
        χ_tilde 0 = 0 →
        (∀ u : M_Cˣ, valL F M_C (u : M_C) = 0 → χ_tilde (resM (u : M_C)) = ((ν_orb i) u : Ω F)⁻¹) →
        (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
          ψ_tilde (resM z) = (traceChar F hLM_C ψ) (((c_M⁻¹ : M_Cˣ) : M_C) * z)) →
        tateEps F M_C (ν_orb i) (traceChar F hLM_C ψ) =
          (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) * ((ν_orb i) c_M : Ω F) *
            (∑ b : k_M, χ_tilde b * ψ_tilde b))
    (hStat : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      let m := condExp F M θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (r₀ : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c_θ⁻¹ : Mˣ) : M) * x)) ∧
      (∀ (c : Mˣ),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
        (∀ x : M, (x = 0 ∨ (r₀ : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c⁻¹ : Mˣ) : M) * x)) →
        (∀ (ν : Mˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F M d, ν u = 1) →
          condExp F M (ν * θ) = m ∧
          tateEps F M (ν * θ) ψ_M = (ν c : Ω F) * tateEps F M θ ψ_M) ∧
        (∀ (R_M : Finset M) (δ : Mˣ),
          (∀ r ∈ R_M, r = 0 ∨ 0 ≤ valL F M r) →
          (∀ r₁ ∈ R_M, ∀ r₂ ∈ R_M, r₁ ≠ r₂ → valL F M (r₁ - r₂) = 0) →
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            ∃ r ∈ R_M, x - r = 0 ∨ 1 ≤ valL F M (x - r)) →
          valL F M (δ : M) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F M θ ψ_M =
              (qL F M : Ω F) ^ condExpChar F M ψ_M *
                (R_M.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_M (((c⁻¹ : Mˣ) : M))) ∧
          (m % 2 = 1 →
            tateEps F M θ ψ_M =
              (qL F M : Ω F) ^ condExpChar F M ψ_M *
                (R_M.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_M (((c⁻¹ : Mˣ) : M)) *
                ∑ r ∈ R_M,
                  if hr : 1 + (δ : M) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : M) * r) hr) : Ω F)⁻¹ *
                      ψ_M (((c⁻¹ : Mˣ) : M) * (δ : M) * r)
                  else 0))))
    (c_L : Lˣ)
    (hc_L_val : valL F L (c_L : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_L_stat_x : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_L⁻¹ : Lˣ) : L) * x))
    (heps_E1 : tateEps F E 1 (traceChar F hLE ψ) =
      (qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ))
    (heps_L1 : tateEps F L 1 ψ = (qL F L : Ω F) ^ condExpChar F L ψ)
    (liftL : k_L → L) (R_L : Finset L) (R_E : Finset E) (c_E : Eˣ)
    (hliftL : ∀ b : k_L, (liftL b = 0 ∨ 0 ≤ valL F L (liftL b)) ∧ resL (liftL b) = b)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_dist : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_mod : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hRL_card : (R_L.card : Ω F) = (Fintype.card k_L : Ω F))
    (hRL_sum : ∀ g : L → Ω F, (∑ r ∈ R_L, g r) = ∑ b : k_L, g (liftL b))
    (hRE_int : ∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r)
    (hRE_dist : ∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0)
    (hRE_mod : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ r ∈ R_E, y - r = 0 ∨ 1 ≤ valL F E (y - r))
    (hRE_card : (R_E.card : Ω F) = (Fintype.card k_L : Ω F))
    (hRE_sum : ∀ g_E : E → Ω F,
      (∑ r ∈ R_E, g_E r) = ∑ b : k_L, g_E (IntermediateField.inclusion hLE (liftL b)))
    (hc_E_inv : ((c_E⁻¹ : Eˣ) : E) = IntermediateField.inclusion hLE ((c_L⁻¹ : Lˣ) : L))
    (hA2 : 2 ≤ condExp F E (χ'.comp (Units.map (normLM F hLE))))
    (hcE_val : valL F E (c_E : E) =
      (condExp F E (χ'.comp (Units.map (normLM F hLE))) : ℤ) +
        condExpChar F E (traceChar F hLE ψ))
    (hcE_stat : ∀ y : E,
      (y = 0 ∨ (((condExp F E (χ'.comp (Units.map (normLM F hLE))) + 1) / 2 : ℕ) : ℤ) ≤ valL F E y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLE))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * y))
    (hcE_χ : ((χ'.comp (Units.map (normLM F hLE))) c_E : Ω F) =
      (χ' c_L : Ω F) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hcE_ψ : (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E)) =
      (ψ (((c_L⁻¹ : Lˣ) : L))) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hMC_stat_val : valL F M_C
      ((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c_L : M_Cˣ) : M_C) =
      (condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) : ℤ) +
        condExpChar F M_C (traceChar F hLM_C ψ))
    (hMC_stat_x : ∀ x : M_C,
      (x = 0 ∨ (((condExp F M_C (χ'.comp (Units.map (normLM F hLM_C))) + 1) / 2 : ℕ) : ℤ) ≤ valL F M_C x) →
      ∀ hx : 1 + x ≠ 0,
        ((χ'.comp (Units.map (normLM F hLM_C))) (Units.mk0 (1 + x) hx) : Ω F) =
          (traceChar F hLM_C ψ)
            ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c_L)⁻¹ : M_Cˣ) : M_C) * x))
    (hMC_even : condExp F L χ' % 2 = 0 →
      tateEps F M_C (χ'.comp (Units.map (normLM F hLM_C))) (traceChar F hLM_C ψ) =
        (qL F M_C : Ω F) ^ condExpChar F M_C (traceChar F hLM_C ψ) *
          (((Fintype.card k_L : Ω F) ^ (condExp F L χ' / 2)) ^
            (Module.finrank L (IntermediateField.extendScalars hLM_C))) *
