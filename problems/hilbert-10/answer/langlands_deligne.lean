    exact Classical.choose_spec hex
  have orb_rep : ∀ f : G → Fin (p + 1), orb (rep f) = orb f :=
    fun f => orb_eq_of_mem (rep_mem_orb f)
  have rep_eq_iff : ∀ (f₁ f₂ : G → Fin (p + 1)), rep f₁ = rep f₂ ↔ orb f₁ = orb f₂ := by
    intro f₁ f₂
    constructor
    · intro h
      rw [← orb_rep f₁, h, orb_rep f₂]
    · intro h
      exact congrArg chooseOrb h
  have R_sub_mixed : ∀ f₀ ∈ R_mixed, f₀ ∈ F_mixed ∧ rep f₀ = f₀ := by
    intro f₀ hf₀
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hf₀
    obtain ⟨σ, _, hσ⟩ := Finset.mem_image.mp (rep_mem_orb f)
    refine ⟨hσ ▸ trF_mem_mixed hf σ, ?_⟩
    exact (rep_eq_iff (rep f) f).mpr (orb_rep f)
  have hfiber : ∀ f₀ ∈ R_mixed,
      F_mixed.filter (fun f => rep f = f₀) = orb f₀ := by
    intro f₀ hf₀
    obtain ⟨hf₀_M, hf₀_rep⟩ := R_sub_mixed f₀ hf₀
    ext f
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨_, hrep⟩
      have horb : orb f = orb f₀ := (rep_eq_iff f f₀).mp (hrep.trans hf₀_rep.symm)
      rw [← horb]
      exact mem_orb_self f
    · intro hmem
      obtain ⟨σ, _, rfl⟩ := Finset.mem_image.mp hmem
      refine ⟨trF_mem_mixed hf₀_M σ, ?_⟩
      have horb : orb (trF σ f₀) = orb f₀ := orb_trF σ f₀
      exact ((rep_eq_iff (trF σ f₀) f₀).mpr horb).trans hf₀_rep
  have hsum_mixed : (∑ f ∈ F_mixed, P_e f) = ι (traceLM F hLM Z_mixed) := by
    rw [← Finset.sum_fiberwise_of_maps_to (fun f hf => Finset.mem_image_of_mem rep hf) P_e]
    have h1 :
        (∑ f₀ ∈ R_mixed, ∑ f ∈ F_mixed with rep f = f₀, P_e f) =
          ∑ f₀ ∈ R_mixed, ∑ σ ∈ U_G, act σ (P_e f₀) := by
      refine Finset.sum_congr rfl fun f₀ hf₀ => ?_
      have hf₀_M : f₀ ∈ F_mixed := (R_sub_mixed f₀ hf₀).1
      rw [hfiber f₀ hf₀]
      change (∑ f ∈ U_G.image (fun σ => trF σ f₀), P_e f) = _
      rw [Finset.sum_image (fun σ₁ _ σ₂ _ h => trF_inj hf₀_M h)]
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact P_e_trF σ f₀
    rw [h1, Finset.sum_comm]
    have h2 :
        (∑ σ ∈ U_G, ∑ f₀ ∈ R_mixed, act σ (P_e f₀)) =
          ∑ σ : G, act σ Z_mixed := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact (map_sum (φ σ) P_e R_mixed).symm
    rw [h2, ← hact_trace Z_mixed]
  have hAp :
      A p = ι (traceLM F hLM (e p) + normLM F hLM (e 1) + traceLM F hLM Z_mixed) := by
    rw [hAp_split, hsum_single, hsum_const, hsum_mixed, ← map_add, ← map_add]
  have hZ_mixed_bound :
      ∀ (B_mixed : ℤ),
        (∀ f : G → Fin (p + 1),
          (∑ τ : G, (f τ : ℕ)) = p →
          (∀ τ : G, (f τ : ℕ) ≤ p - 1) →
          ¬ (∀ τ : G, (f τ : ℕ) = 1) →
          (∏ τ : G, act τ (e (f τ : ℕ))) = 0 ∨
            B_mixed ≤ valL F M (∏ τ : G, act τ (e (f τ : ℕ)))) →
        Z_mixed = 0 ∨ B_mixed ≤ valL F M Z_mixed := by
    intro B_mixed hB
    have hterm : ∀ f₀ ∈ R_mixed, P_e f₀ = 0 ∨ B_mixed ≤ valL F M (P_e f₀) := by
      intro f₀ hf₀
      obtain ⟨hwt, hbound, hnot_const⟩ := (hmem_mixed f₀).mp (R_sub_mixed f₀ hf₀).1
      exact hB f₀ hwt hbound hnot_const
    have hsub : ∀ T : Finset (G → Fin (p + 1)), T ⊆ R_mixed →
        (∑ f₀ ∈ T, P_e f₀) = 0 ∨ B_mixed ≤ valL F M (∑ f₀ ∈ T, P_e f₀) := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro _
        exact Or.inl Finset.sum_empty
      | @insert f₀ T' hf₀ ih =>
        intro hT
        rw [Finset.sum_insert hf₀]
        have h1 : P_e f₀ = 0 ∨ B_mixed ≤ valL F M (P_e f₀) :=
          hterm f₀ (hT (Finset.mem_insert_self f₀ T'))
        have h2 : (∑ f ∈ T', P_e f) = 0 ∨ B_mixed ≤ valL F M (∑ f ∈ T', P_e f) :=
          ih (Finset.Subset.trans (Finset.subset_insert f₀ T') hT)
        exact hvalM_add B_mixed (P_e f₀) (∑ f ∈ T', P_e f) h1 h2
    exact hsub R_mixed (Finset.Subset.refl R_mixed)
  exact ⟨A, Z_mixed, hA_poly, hAp, hZ_mixed_bound⟩

theorem ld_wild_odd_m1_e1_val_upgrade_and_mixed_tuple_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (ϖ_M₁' : M₁'ˣ) (hϖ_M₁' : valL F M₁' (ϖ_M₁' : M₁') = 1)
    (hBasis_M₁' : ∀ z : M₁',
      ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → L,
        z = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hLM₁' (c i) * ((ϖ_M₁' : M₁') ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (z = 0 ∨ m ≤ valL F M₁' z) ↔
            ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
              c i = 0 ∨
                m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                  valL F L (c i) + (i : ℤ))
    (G_M₁' : Type u) [Group G_M₁'] [Fintype G_M₁'] (act_M₁' : G_M₁' → M₁' → M₁')
    (hcard_GM₁' : Fintype.card G_M₁' = Module.finrank L (IntermediateField.extendScalars hLE'))
    (hactM₁'_one : ∀ z : M₁', act_M₁' 1 z = z)
    (hactM₁'_ring : ∀ σ : G_M₁',
      act_M₁' σ 0 = 0 ∧ act_M₁' σ 1 = 1 ∧
      (∀ z₁ z₂ : M₁',
        act_M₁' σ (z₁ + z₂) = act_M₁' σ z₁ + act_M₁' σ z₂ ∧
        act_M₁' σ (z₁ * z₂) = act_M₁' σ z₁ * act_M₁' σ z₂ ∧
        act_M₁' σ (-z₁) = -act_M₁' σ z₁))
    (hactM₁'_incl : ∀ (σ : G_M₁') (x : L),
      act_M₁' σ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hactM₁'_val : ∀ (σ : G_M₁') (z : M₁'), valL F M₁' (act_M₁' σ z) = valL F M₁' z)
    (hactM₁'_trace : ∀ z : M₁',
      IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = ∑ σ : G_M₁', act_M₁' σ z)
    (hactM₁'_norm : ∀ z : M₁',
      IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = ∏ σ : G_M₁', act_M₁' σ z)
    (y₁_M₁' : M₁')
    (hy₁M₁'_tr : traceLM F hLM₁' y₁_M₁' = 1)
    (hy₁M₁'_ne0 : y₁_M₁' ≠ 0)
    (hy₁M₁'_val : valL F M₁' y₁_M₁' =
      -(((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
        ((bM₁' - 1 : ℕ) : ℤ)))
    (G_E' : Type u) [Group G_E'] [Fintype G_E'] (act_E' : G_E' → E' → E')
    (hcard_GE' : Fintype.card G_E' = Module.finrank L (IntermediateField.extendScalars hLE'))
    (hactE'_one : ∀ y : E', act_E' 1 y = y)
    (hactE'_ring : ∀ σ : G_E',
      act_E' σ 0 = 0 ∧ act_E' σ 1 = 1 ∧
      (∀ y₁ y₂ : E',
        act_E' σ (y₁ + y₂) = act_E' σ y₁ + act_E' σ y₂ ∧
        act_E' σ (y₁ * y₂) = act_E' σ y₁ * act_E' σ y₂ ∧
        act_E' σ (-y₁) = -act_E' σ y₁))
    (hactE'_val : ∀ (σ : G_E') (y : E'), valL F E' (act_E' σ y) = valL F E' y)
    (hactE'_norm : ∀ y : E',
      IntermediateField.inclusion hLE' (normLM F hLE' y) = ∏ σ : G_E', act_E' σ y)
    (Δ : K₁ˣ)
    (hΔ_tr_low_bE' : ∀ j ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j)))
    (e_M : ℕ → M₁') (he_M_0 : e_M 0 = 1) (he_M_1 : e_M 1 = traceLM F hM₁'K₁ (Δ : K₁))
    (he_M_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_M i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) -
          (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_M i))
    (e_E' : ℕ → E') (he_E'_0 : e_E' 0 = 1)
    (he_E'_low : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 2),
      e_E' i = 0 ∨ (bE' : ℤ) ≤ valL F E' (e_E' i))
    (he_E'_top : e_E' (Module.finrank L (IntermediateField.extendScalars hLE') - 1) = 0 ∨
      0 ≤ valL F E' (e_E' (Module.finrank L (IntermediateField.extendScalars hLE') - 1))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    (normLM F hLE' (e_E' 1) = 0 ∨ (bE' : ℤ) ≤ valL F L (normLM F hLE' (e_E' 1))) ∧
    (∀ g : G_E' → Fin (p + 1),
      (∑ σ : G_E', (g σ : ℕ)) = p →
      (∀ σ : G_E', (g σ : ℕ) ≤ p - 1) →
      ¬ (∀ σ : G_E', (g σ : ℕ) = 1) →
      (∏ σ : G_E', act_E' σ (e_E' (g σ : ℕ))) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (∏ σ : G_E', act_E' σ (e_E' (g σ : ℕ)))) ∧
    (normLM F hLM₁' (e_M 1) = 0 ∨ (bE' : ℤ) ≤ valL F L (normLM F hLM₁' (e_M 1))) ∧
    (∀ f : G_M₁' → Fin (p + 1),
      (∑ τ : G_M₁', (f τ : ℕ)) = p →
      (∀ τ : G_M₁', (f τ : ℕ) ≤ p - 1) →
      ¬ (∀ τ : G_M₁', (f τ : ℕ) = 1) →
      (∏ τ : G_M₁', act_M₁' τ (e_M (f τ : ℕ))) = 0 ∨
        (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤
          valL F M₁' (∏ τ : G_M₁', act_M₁' τ (e_M (f τ : ℕ)))) :=
by
  dsimp only
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set t₁ : ℕ := bM₁' - 1
  set t₂ : ℕ := bE' - 1
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  have hp_ge3 : 3 ≤ p := by
    obtain ⟨k_p, hk_p⟩ := hp_odd_nat
    omega
  have hp_cases : p = 3 ∨ 5 ≤ p := by
    obtain ⟨k_p, hk_p⟩ := hp_odd_nat
    omega
  have hp_sub1_z : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by omega
  have ht_le : t₁ ≤ t₂ := by omega
  have hp_z_ge3 : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
  have ht₁_z_ge1 : (1 : ℤ) ≤ (t₁ : ℤ) := by exact_mod_cast ht₁_ge1
  have ht₂_z_ge1 : (1 : ℤ) ≤ (t₂ : ℤ) := by exact_mod_cast ht₂_ge1
  have ht_z_le : (t₁ : ℤ) ≤ (t₂ : ℤ) := by exact_mod_cast ht_le
  have hbM₁'_eq_z : (bM₁' : ℤ) = (t₁ : ℤ) + 1 := by omega
  have hbE'_eq_z : (bE' : ℤ) = (t₂ : ℤ) + 1 := by omega
  rcases hvalL_props with ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    _, hvalL_add, _, _, _⟩
  rcases hvalE'_props with ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv,
    _, hvalE'_add, _, _, _⟩
  rcases hvalM₁'_props with ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv,
    _, hvalM₁'_add, _, _, _⟩
  have hmul_gen : ∀ (M : IntermediateField F (AlgebraicClosure F)),
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) →
      ∀ (m₁ m₂ : ℤ) (x y : M),
        (x = 0 ∨ m₁ ≤ valL F M x) → (y = 0 ∨ m₂ ≤ valL F M y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F M (x * y)) := by
    intro M hmul m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' : m₁ ≤ valL F M x := hx.resolve_left hx0
        have hy' : m₂ ≤ valL F M y := hy.resolve_left hy0
        rw [hmul x y hx0 hy0]
        linarith
  have hsum_gen : ∀ (M : IntermediateField F (AlgebraicClosure F)),
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) →
      ∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ a ∈ s, f a = 0 ∨ k ≤ valL F M (f a)) →
        ((∑ a ∈ s, f a) = 0 ∨ k ≤ valL F M (∑ a ∈ s, f a)) := by
    intro M hadd α s f k hf
    induction' s using Finset.induction_on with a s ha ih
    · left; simp
    · rw [Finset.sum_insert ha]
      apply hadd k (f a) (∑ x ∈ s, f x)
      · exact hf a (Finset.mem_insert_self a s)
      · exact ih (fun x hx => hf x (Finset.mem_insert_of_mem hx))
  have hprod_sum_gen : ∀ (M : IntermediateField F (AlgebraicClosure F)),
      valL F M 1 = 0 →
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) →
      ∀ {α : Type u} (s : Finset α) (f : α → M) (B : α → ℤ),
        (∀ a ∈ s, f a = 0 ∨ B a ≤ valL F M (f a)) →
        ((∏ a ∈ s, f a) = 0 ∨ (∑ a ∈ s, B a) ≤ valL F M (∏ a ∈ s, f a)) := by
