    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal M_C (AlgebraicClosure F) := Normal.tower_top_of_normal F M_C (AlgebraicClosure F)
    have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[M_C] AlgebraicClosure F),
        (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : M_C.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_C).symm σ
      let τ_F : M_C.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_C).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hM_CK).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGalMCK.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hM_CK).mp hx)
    exact helper_isGalois M_C (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois M_C ↥K' := hGalMCK'
  let G : Type u := (K' ≃ₐ[M_C] K')
  let fromExtendScalars : K' →+* K :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hM_CK).mp z.2⟩
