      G₀ act hact_one hact_mul hact_ring hact_val hC_mem_iff hG₀_iff hJumpK_C H₀ hH₀_iff
  refine ⟨H₀, hH₀_norm, hCyclic_H₀, hCyclic_quot, ?_⟩
  intro t ht h hh₀ hfix_t
  obtain ⟨i, rfl⟩ := List.mem_iff_get.mp ht
  apply hDisj_idx i h hh₀
  intro x
  let w_x : K := IntermediateField.inclusion hM_CK (IntermediateField.inclusion (hFiMC i) x)
  have hx_mem : ((toExtendScalars F hLK w_x : K') : AlgebraicClosure F) ∈ (D_orb.get i).field := x.2
