      have ht₁_z : (1 : ℤ) ≤ (t₁ : ℤ) := by exact_mod_cast ht₁_ge1
      have ht_le_z : (t₁ : ℤ) ≤ (t₂ : ℤ) := by exact_mod_cast ht_le
      have hp3_z : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
      have hk_pm : (1 : ℤ) ≤ ((k : ℤ) - 1) * ((p : ℤ) * (m_u : ℤ) - (t₁ : ℤ)) := by
        have h1 : (1 : ℤ) ≤ (k : ℤ) - 1 := by linarith
        have h2 : (1 : ℤ) ≤ (p : ℤ) * (m_u : ℤ) - (t₁ : ℤ) := by linarith
