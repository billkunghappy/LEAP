  exact ⟨h2_ne, x₀, R₀, f₀, ρ₀, h2_val, hx₀_ne, hR₀_ne, hf₀_ne, hρ₀_ne,
    hx₀_val, hf₀_val, hR₀_val, hρ₀_val, hx₀_tr, hx₀_norm, hx₀_sq, hx₀_conj,
