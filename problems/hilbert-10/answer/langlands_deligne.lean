  let H_E : Subgroup G := (toSub E hLE).fixingSubgroup
  let H_M₁ : Subgroup G := (toSub M₁ hLM₁).fixingSubgroup
  have h_fieldOf_E : fieldOf H_E = E := h_fieldOf_fixing E hLE hEK₁
  have h_fieldOf_M₁ : fieldOf H_M₁ = M₁ := h_fieldOf_fixing M₁ hLM₁ hM₁K₁
  have h_fixing_K₁ : (toSub K₁ hLK₁).fixingSubgroup = ⊥ := by
