        have hw₁_coe : normLM F hM_CK (w₁ : K) = (zMC : M_C) := congrArg Units.val hw₁
        have hrel_w₁ : relVal F K (w₁ : K) = ((ℓ * resDeg F M_C : ℕ) : ℤ) := by
