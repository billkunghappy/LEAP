    have h1 := congrArg (Int.cast : ℤ → E') hc₂
    push_cast at h1
    rw [hξj_p_coe]
    exact h1
  have ha₀j_diff :
      a₀_j - (j : E') * a₀ = 0 ∨
        (((p - 1) * t₂ : ℕ) : ℤ) + (-(t₁ : ℤ)) ≤ valL F E' (a₀_j - (j : E') * a₀) := by
    have hid : a₀_j - (j : E') * a₀ = (((p : ℕ) : E') * (c₂ : E')) * a₀ := by
      rw [ha₀j_eq, ← hc₂_E']
      ring
    rw [hid]
    exact val_mono_E' (by omega)
      (val_mul_E' (val_mul_E' hp_valE' (val_intCast_E' c₂)) (Or.inr (le_of_eq ha₀_val.symm)))
  have h_two_t₂ : 2 * t₂ ≤ (p - 1) * t₂ := Nat.mul_le_mul_right t₂ (by omega)
  have hY₀j_coboundary : ∀ y : E'ˣ,
      let x_y := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
      ψE' (2 * IntermediateField.inclusion hLE' α * (B₂ - a₀_j) * P_E' x_y) = 1 := by
    intro y
    set w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
    set x_y := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
    have hxy_neg_wy : x_y = -w_y := by
      dsimp [x_y, w_y]
      ring
    have hx_y_q₂ : x_y = 0 ∨ (q₂ : ℤ) ≤ valL F E' x_y := by
      rw [hxy_neg_wy]
      exact val_mono_E' (by exact_mod_cast hq₂_le_t₂) (val_neg_E' (hσ_w_prop y).1)
    have hP_xy : P_E' x_y = 0 ∨ (q₂ : ℤ) ≤ valL F E' (P_E' x_y) :=
      (hP_E' x_y 0 hx_y_q₂ (Or.inl rfl)).2.1
    have h2_val : (2 : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (2 : E') := val_natCast_E' 2
    have hdiff_val :
        2 * (a₀_j - (j : E') * a₀) * P_E' x_y = 0 ∨
          (bE' : ℤ) ≤ valL F E' (2 * (a₀_j - (j : E') * a₀) * P_E' x_y) := by
      refine val_mono_E' (by omega) (val_mul_E' (val_mul_E' h2_val ha₀j_diff) hP_xy)
    have hψ_diff :
        ψE' (IntermediateField.inclusion hLE' α *
          (2 * (a₀_j - (j : E') * a₀) * P_E' x_y)) = 1 :=
      hψE'_α_triv _ hdiff_val
    have hsplit :
        2 * IntermediateField.inclusion hLE' α * (B₂ - (j : E') * a₀) * P_E' x_y =
          2 * IntermediateField.inclusion hLE' α * (B₂ - a₀_j) * P_E' x_y +
          IntermediateField.inclusion hLE' α * (2 * (a₀_j - (j : E') * a₀) * P_E' x_y) := by
      ring
    have h0 := hY₀_coboundary y
    change ψE' (2 * IntermediateField.inclusion hLE' α * (B₂ - (j : E') * a₀) * P_E' x_y) = 1 at h0
    rw [hsplit, AddChar.map_add_eq_mul, hψ_diff, mul_one] at h0
    exact h0
  let Y_of : E' → E' := fun w => B₂ - (a₀_j + w ^ p - w)
  have hh₀_nonneg : (0 : ℤ) ≤ (h₀ : ℤ) := Nat.cast_nonneg h₀
  have hp_h₀_lt : p * h₀ + 1 ≤ t₁ := by
    have hdiv : p * h₀ + t₁ % p = t₁ := Nat.div_add_mod t₁ p
    have hmod_ne0 : t₁ % p ≠ 0 := mt Nat.dvd_iff_mod_eq_zero.mpr ht₁_ndvd
    omega
  have hp_h₀_bE' : p * h₀ + bE' ≤ (p - 1) * t₂ := by omega
  have hchoose_val : ∀ (k : ℕ), 0 < k → k < p →
      ((Nat.choose p k : ℕ) : E') = 0 ∨
        (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((Nat.choose p k : ℕ) : E') := by
    intro k hk_pos hk_lt
    obtain ⟨q, hq⟩ := Nat.Prime.dvd_choose_self hPrime (by omega) hk_lt
    rw [hq, Nat.cast_mul]
    exact val_mono_E' (by omega) (val_mul_E' hp_valE' (val_natCast_E' q))
  have hbinom_decomp : ∀ (w₁ w₂ : E'),
      (w₁ + w₂) ^ p - (w₁ ^ p + w₂ ^ p) =
        ∑ k ∈ Finset.range (p - 1),
          w₁ ^ (k + 1) * w₂ ^ (p - (k + 1)) * ((Nat.choose p (k + 1) : ℕ) : E') := by
    intro w₁ w₂
    let g : ℕ → E' := fun k => w₁ ^ k * w₂ ^ (p - k) * ((Nat.choose p k : ℕ) : E')
    have h1 : (w₁ + w₂) ^ p = ∑ k ∈ Finset.range (p + 1), g k := add_pow w₁ w₂ p
    have h2 : ∑ k ∈ Finset.range (p + 1), g k = (∑ k ∈ Finset.range p, g k) + g p :=
      Finset.sum_range_succ g p
    have hgp : g p = w₁ ^ p := by
      dsimp [g]
      rw [Nat.sub_self, pow_zero, Nat.choose_self, Nat.cast_one, mul_one, mul_one]
    have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp_pos).symm
    have h3 : ∑ k ∈ Finset.range p, g k =
        (∑ k ∈ Finset.range (p - 1), g (k + 1)) + g 0 := by
      conv_lhs => rw [hp_eq]
      exact Finset.sum_range_succ' g (p - 1)
    have hg0 : g 0 = w₂ ^ p := by
      dsimp [g]
      rw [pow_zero, Nat.choose_zero_right, Nat.cast_one, one_mul, mul_one]
    rw [h1, h2, hgp, h3, hg0]
    ring
  have hbinom_h₀ : ∀ (w₁ w₂ : E'),
      (w₁ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₁) →
      (w₂ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₂) →
      (w₁ + w₂) ^ p - (w₁ ^ p + w₂ ^ p) = 0 ∨
        (bE' : ℤ) ≤ valL F E' ((w₁ + w₂) ^ p - (w₁ ^ p + w₂ ^ p)) := by
    intro w₁ w₂ hw₁ hw₂
    rw [hbinom_decomp w₁ w₂]
    apply val_sum_E' (Finset.range (p - 1)) _ (bE' : ℤ)
    intro k hk
    have hk_lt : k < p - 1 := Finset.mem_range.mp hk
    have hw₁_pow := val_pow_E' hw₁ (k + 1)
    have hw₂_pow := val_pow_E' hw₂ (p - (k + 1))
    have hch := hchoose_val (k + 1) (by omega) (by omega)
    have hbound_k : (bE' : ℤ) ≤
        ((k + 1 : ℕ) : ℤ) * (-(h₀ : ℤ)) +
          ((p - (k + 1) : ℕ) : ℤ) * (-(h₀ : ℤ)) +
            (((p - 1) * t₂ : ℕ) : ℤ) := by
      have hk_sum : ((k + 1 : ℕ) : ℤ) + ((p - (k + 1) : ℕ) : ℤ) = (p : ℤ) := by omega
      have hph₀_cast : (p : ℤ) * (h₀ : ℤ) = ((p * h₀ : ℕ) : ℤ) := by
        push_cast
        ring
      have h_ineq_z : ((p * h₀ : ℕ) : ℤ) + (bE' : ℤ) ≤ (((p - 1) * t₂ : ℕ) : ℤ) := by
        exact_mod_cast hp_h₀_bE'
      have hlin : ((k + 1 : ℕ) : ℤ) * (-(h₀ : ℤ)) +
          ((p - (k + 1) : ℕ) : ℤ) * (-(h₀ : ℤ)) = -((p : ℤ) * (h₀ : ℤ)) := by
        calc ((k + 1 : ℕ) : ℤ) * (-(h₀ : ℤ)) + ((p - (k + 1) : ℕ) : ℤ) * (-(h₀ : ℤ))
          _ = (((k + 1 : ℕ) : ℤ) + ((p - (k + 1) : ℕ) : ℤ)) * (-(h₀ : ℤ)) := by ring
          _ = (p : ℤ) * (-(h₀ : ℤ)) := by rw [hk_sum]
          _ = -((p : ℤ) * (h₀ : ℤ)) := by ring
      linarith
    exact val_mono_E' hbound_k (val_mul_E' (val_mul_E' hw₁_pow hw₂_pow) hch)
  have hY_add_step : ∀ (w₁ w₂ : E') (m : ℤ),
      m ≤ (bE' : ℤ) →
      (w₁ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₁) →
      (w₂ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₂) →
      (Y_of w₁ - (w₂ ^ p - w₂) = 0 ∨
        m ≤ valL F E' (Y_of w₁ - (w₂ ^ p - w₂))) →
      (w₁ + w₂ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' (w₁ + w₂)) ∧
      (Y_of (w₁ + w₂) = 0 ∨ m ≤ valL F E' (Y_of (w₁ + w₂))) := by
    intro w₁ w₂ m hm hw₁ hw₂ hY_step
    refine ⟨val_add_E' hw₁ hw₂, ?_⟩
    have hid : Y_of (w₁ + w₂) =
        (Y_of w₁ - (w₂ ^ p - w₂)) - ((w₁ + w₂) ^ p - (w₁ ^ p + w₂ ^ p)) := by
      dsimp [Y_of]
      ring
    rw [hid]
    exact val_sub_E' hY_step (val_mono_E' hm (hbinom_h₀ w₁ w₂ hw₁ hw₂))
  have hP_L_zero : (∑ k ∈ Finset.Icc 1 (p - 1), ((k : ℕ) : L)⁻¹ * (0 : L) ^ k) = 0 := by
    apply Finset.sum_eq_zero
    intro k hk
    have hk_ge1 : 1 ≤ k := (Finset.mem_Icc.mp hk).1
    rw [zero_pow (by omega), mul_zero]
  have hY_coboundary : ∀ (w : E'),
      (w = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w) →
      ∀ (y : E'ˣ),
        let x_y := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
        ψE' (2 * IntermediateField.inclusion hLE' α * Y_of w * P_E' x_y) = 1 := by
    intro w hw y
    set w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
    set x_y := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
    obtain ⟨hw_y_t₂, hu_wy_zero⟩ := hσ_w_prop y
    have hxy_neg_wy : x_y = -w_y := by
      dsimp [x_y, w_y]
      ring
    have hx_y_q₂ : x_y = 0 ∨ (q₂ : ℤ) ≤ valL F E' x_y := by
      rw [hxy_neg_wy]
      exact val_mono_E' (by exact_mod_cast hq₂_le_t₂) (val_neg_E' hw_y_t₂)
    have hshift_xy := (hShift_E'.1 w hw x_y hx_y_q₂).2
    have hu_xy_zero : 1 - normLM F hLE' (1 - x_y) = 0 := by
      have h1 : 1 - x_y = 1 + w_y := by
        dsimp [x_y, w_y]
        ring
      rw [h1]
      linear_combination -hu_wy_zero
    have hψ_wp : ψE' (2 * IntermediateField.inclusion hLE' α * (w ^ p - w) * P_E' x_y) = 1 := by
      rw [hshift_xy, hu_xy_zero]
      dsimp only
      rw [hP_L_zero, mul_zero, AddChar.map_zero_eq_one]
    have hsplit :
        2 * IntermediateField.inclusion hLE' α * (B₂ - a₀_j) * P_E' x_y =
          2 * IntermediateField.inclusion hLE' α * Y_of w * P_E' x_y +
          2 * IntermediateField.inclusion hLE' α * (w ^ p - w) * P_E' x_y := by
      dsimp [Y_of]
      ring
    have h0 := hY₀j_coboundary y
    change ψE' (2 * IntermediateField.inclusion hLE' α * (B₂ - a₀_j) * P_E' x_y) = 1 at h0
    rw [hsplit, AddChar.map_add_eq_mul, hψ_wp, mul_one] at h0
    exact h0
  have h_descent : ∀ (n : ℕ), n ≤ t₁ →
      ∃ w : E', (w = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w) ∧
        (Y_of w = 0 ∨ -((t₁ - n : ℕ) : ℤ) ≤ valL F E' (Y_of w)) := by
    intro n
    induction n with
    | zero =>
      intro _
      refine ⟨0, Or.inl rfl, ?_⟩
      have hY0 : Y_of 0 = B₂ - a₀_j := by
        dsimp [Y_of]
        rw [zero_pow hp_pos.ne']
        ring
      rw [Nat.sub_zero, hY0]
      exact val_sub_E' (Or.inr (le_of_eq hB₂_val.symm)) (Or.inr (le_of_eq ha₀j_val.symm))
    | succ n ih =>
      intro hn1
      obtain ⟨w_n, hw_n, hY_n⟩ := ih (by omega)
      set r := t₁ - n
      have hr_ge1 : 1 ≤ r := by omega
      have hr_le : r ≤ t₁ := by omega
      have hr_sub : -((t₁ - (n + 1) : ℕ) : ℤ) = -(r : ℤ) + 1 := by omega
      rw [hr_sub]
      by_cases hdvd : p ∣ r
      · set k := r / p
        have hp_k : p * k = r := Nat.mul_div_cancel' hdvd
        have hk_ge1 : 1 ≤ k := by
          rcases eq_or_ne k 0 with hk0 | hk_ne0
          · rw [hk0, mul_zero] at hp_k
            omega
          · exact Nat.pos_of_ne_zero hk_ne0
        have hk_le_h₀ : k ≤ h₀ := Nat.div_le_div_right hr_le
        have hY_n_pk : Y_of w_n = 0 ∨ -((p * k : ℕ) : ℤ) ≤ valL F E' (Y_of w_n) := by
          rwa [hp_k]
        obtain ⟨w_k, hw_k, hY_wk⟩ := hShift_E'.2.1 k hk_ge1 hk_le_h₀ (Y_of w_n) hY_n_pk
        have hw_k_h₀ : w_k = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w_k :=
          val_mono_E' (by omega) hw_k
        obtain ⟨hw_add, hY_add⟩ :=
          hY_add_step w_n w_k (-((p * k : ℕ) : ℤ) + 1) (by omega) hw_n hw_k_h₀ hY_wk
        rw [hp_k] at hY_add
        exact ⟨w_n + w_k, hw_add, hY_add⟩
      · refine ⟨w_n, hw_n, ?_⟩
        exact hσ_nondiv_upgrade r hr_ge1 hr_le hdvd (Y_of w_n) hY_n
          (fun u₁ _ => hY_coboundary w_n hw_n u₁)
  obtain ⟨w_neg, hw_neg, hY_neg_raw⟩ := h_descent t₁ le_rfl
  have hY_neg : Y_of w_neg = 0 ∨ (0 : ℤ) ≤ valL F E' (Y_of w_neg) := by
    simpa using hY_neg_raw
  have hψ_xstar :
      ψE' (2 * IntermediateField.inclusion hLE' α * Y_of w_neg *
        P_E' (1 - (σ (ϖ_E' : E')) * ((ϖ_E'⁻¹ : E'ˣ) : E'))) = 1 :=
    hY_coboundary w_neg hw_neg ϖ_E'
  obtain ⟨w_zero, hw_zero, hY_zero⟩ :=
    hShift_E'.2.2.1 σ hσ_L hσ_ne ϖ_E' hϖ_E' (Y_of w_neg) hY_neg hψ_xstar
  obtain ⟨hw_le0, hY_le0⟩ :=
    hY_add_step w_neg w_zero 1 (by omega) hw_neg (val_mono_E' (by linarith) hw_zero) hY_zero
  obtain ⟨w_high, hw_high, hY_high⟩ := hShift_E'.2.2.2 (Y_of (w_neg + w_zero)) hY_le0
  obtain ⟨hw₀, hY_w₀⟩ :=
    hY_add_step (w_neg + w_zero) w_high (bE' : ℤ) le_rfl hw_le0
      (val_mono_E' (by linarith) hw_high) hY_high
  set w₀ := (w_neg + w_zero) + w_high
  obtain ⟨Δ', hΔ'_val, hΔ'_as, hΔ'_norm⟩ :=
    (hΔ_univ Δ₀_j hΔ₀j_val hΔ₀j_as).2.2.2.2.2.2 w₀ hw₀
  have hbE'_le_3p2m₁ : (bE' : ℤ) ≤ ((3 * p * p * m₁ : ℕ) : ℤ) := by
    have h3p2_ge1 : 1 ≤ 3 * p * p :=
      Nat.mul_pos (Nat.mul_pos (by omega) hp_pos) hp_pos
    have hmul : 1 * bE' ≤ (3 * p * p) * m₁ := Nat.mul_le_mul h3p2_ge1 hm₁_ge_bE'
    have hle_nat : bE' ≤ 3 * p * p * m₁ := by linarith
    exact_mod_cast hle_nat
  set δ_norm := normLM F hE'K₁ (Δ' : K₁) - (a₀_j + w₀ ^ p - w₀)
  have hδ_ge : δ_norm = 0 ∨ (bE' : ℤ) ≤ valL F E' δ_norm :=
    val_mono_E' hbE'_le_3p2m₁ hΔ'_norm
  have hB₂_Δ' :
      B₂ - normLM F hE'K₁ (Δ' : K₁) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (B₂ - normLM F hE'K₁ (Δ' : K₁)) := by
    have hid : B₂ - normLM F hE'K₁ (Δ' : K₁) = Y_of w₀ - δ_norm := by
      dsimp [Y_of, δ_norm, a₀_j]
      ring
    rw [hid]
    exact val_sub_E' hY_w₀ hδ_ge
  have hc₂₀_inv_eq : - ((c₂₀⁻¹ : E'ˣ) : E') = IntermediateField.inclusion hLE' α * B₂ := by
    dsimp only [B₂, α]
    rw [mul_neg, ← mul_assoc, ← map_mul]
    have hinv_mul : ((c_νE'⁻¹ : Lˣ) : L) * (c_νE' : L) = 1 := by
      exact_mod_cast Units.inv_mul c_νE'
    rw [hinv_mul, map_one, one_mul]
  refine ⟨Δ', hΔ'_val, hΔ'_as, ?_⟩
  intro x hx_val hx
  have hPx_q₂ : P_E' x = 0 ∨ (q₂ : ℤ) ≤ valL F E' (P_E' x) :=
    (hP_E' x 0 hx_val (Or.inl rfl)).2.1
  have hPx0 : P_E' x = 0 ∨ (0 : ℤ) ≤ valL F E' (P_E' x) :=
    val_mono_E' (by omega) hPx_q₂
  have h2_val : (2 : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (2 : E') := val_natCast_E' 2
  have hrem_val :
      2 * (B₂ - normLM F hE'K₁ (Δ' : K₁)) * P_E' x = 0 ∨
        (bE' : ℤ) ≤ valL F E' (2 * (B₂ - normLM F hE'K₁ (Δ' : K₁)) * P_E' x) :=
    val_mono_E' (by omega) (val_mul_E' (val_mul_E' h2_val hB₂_Δ') hPx0)
  have hψ_rem :
      ψE' (IntermediateField.inclusion hLE' α *
        (2 * (B₂ - normLM F hE'K₁ (Δ' : K₁)) * P_E' x)) = 1 :=
    hψE'_α_triv _ hrem_val
  have hlog_split :
      - 2 * ((c₂₀⁻¹ : E'ˣ) : E') * P_E' x =
        (2 * IntermediateField.inclusion hLE' α *
          normLM F hE'K₁ (Δ' : K₁) * P_E' x) +
        IntermediateField.inclusion hLE' α *
          (2 * (B₂ - normLM F hE'K₁ (Δ' : K₁)) * P_E' x) := by
    have hneg2 : - 2 * ((c₂₀⁻¹ : E'ˣ) : E') = 2 * (- ((c₂₀⁻¹ : E'ˣ) : E')) := by ring
    rw [hneg2, hc₂₀_inv_eq]
    ring
  have hlog := hc₂₀_log x hx_val hx
  change (χ₂ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
    ψE' (- 2 * ((c₂₀⁻¹ : E'ˣ) : E') * P_E' x) at hlog
  rw [hlog_split, AddChar.map_add_eq_mul, hψ_rem, mul_one] at hlog
  exact hlog

theorem ld_wild_odd_tot_ram_one_over_p_second_branch_conjugation_p3 (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hp_valM₁' : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : M₁') = 0 ∨
      (1 : ℤ) ≤ valL F M₁' ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : M₁'))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νM₁' : ℤ))
    (hψM₁'_triv : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
      (traceChar F hLM₁' ψ) z = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
