            rw [hTE_decomp]
            apply hval_add_MC 0 ((u_zδ * u_ω : M_Cˣ) : M_C) rem_MC
            · exact Or.inr (by omega)
            · rcases hrem_MC_val with hrem0 | hrem1
              · exact Or.inl hrem0
              · exact Or.inr (by omega)
          rcases hMC_ge0 with hMC0 | hMC_ge0
          · exact False.elim (h0 ((map_eq_zero_iff (IntermediateField.inclusion hLM_C)
              (IntermediateField.inclusion hLM_C).injective).mp hMC0))
