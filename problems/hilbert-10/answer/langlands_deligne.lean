        Units.map (normLM F hLE') C₂ * (Units.map (normLM F hLM₁') A₁)⁻¹ := by
      group
    rw [hinv]
    apply Units.ext
    rw [Units.val_mul, Units.val_mul, Units.val_inv_eq_inv_val, hnorm_C₂, hnorm_A₁, mul_inv]
    dsimp [U₁, U₂]
    rw [h1_sub_norm_krat_inv]
    dsimp [F_star]
    linear_combination
      P_star * normLM F hLE' (1 - k_rat) * (normLM F hLM₁' (1 + n₁))⁻¹ * hγp_mul_inv
      - P_star * normLM F hLE' (1 - k_rat) * (normLM F hLM₁' (1 + n₁))⁻¹ * hPq₀_mul_inv
  have hlam_split :
      ((lam_L (Units.map (normLM F hLM₁') A₁ * (Units.map (normLM F hLE') C₂)⁻¹) : Ω F) ^ 2)⁻¹ =
        (lam_L U₁ : Ω F) ^ 2 * (lam_L U₂ : Ω F) ^ 2 := by
    have h1 : (lam_L ((Units.map (normLM F hLM₁') A₁ *
        (Units.map (normLM F hLE') C₂)⁻¹)⁻¹) : Ω F) ^ 2 =
        (lam_L U₁ : Ω F) ^ 2 * (lam_L U₂ : Ω F) ^ 2 := by
      rw [hUnit_eq, map_mul, Units.val_mul, mul_pow]
    rw [map_inv, Units.val_inv_eq_inv_val, inv_pow] at h1
    exact h1
  
  have hu_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero (γ⁻¹))
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hvalL_mul _ _ (Units.ne_zero α) (Units.ne_zero (γ⁻¹)), hα_val, hvalL_inv γ, hγ_val]
    omega
  have hF_ne0 : F_star ≠ 0 := mul_ne_zero hP_ne0 (inv_ne_zero hPq₀_ne0)
  have hF_val0 : valL F L F_star = 0 := by
    dsimp [F_star]
    rw [hvalL_mul _ _ hP_ne0 (inv_ne_zero hPq₀_ne0), hP_val0, hvalL_inv0 _ hPq₀_ne0, hPq₀_val0]
    omega
  have hu_E'_ne0 : IntermediateField.inclusion hLE' u ≠ 0 :=
    (IntermediateField.inclusion hLE').injective.ne hu_ne0
  have hk_rat_ne0 : k_rat ≠ 0 :=
    mul_ne_zero (mul_ne_zero hu_E'_ne0 (Units.ne_zero w₂)) (inv_ne_zero hC_ne0)
  have hk_rat_val : valL F E' k_rat = ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
    dsimp [k_rat]
    rw [hvalE'_mul _ _ (mul_ne_zero hu_E'_ne0 (Units.ne_zero w₂)) (inv_ne_zero hC_ne0),
      hvalE'_mul _ _ hu_E'_ne0 (Units.ne_zero w₂), hval_LE' u, hu_val, hw₂_val,
      hvalE'_inv0 C hC_ne0, hC_val0]
    have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    rw [hp1]
    dsimp [m]
    ring
  have hneg_krat_ne0 : -k_rat ≠ 0 := neg_ne_zero.mpr hk_rat_ne0
  have hneg_krat_val : valL F E' (-k_rat) = ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
    rw [hvalE'_neg, hk_rat_val]
  let q_lam : ℕ := (a_lam + p - 1) / p
  let b_sym : ℕ := ((p - 1) * a_lam) / p
  have hqlam_le_bsym : q_lam ≤ b_sym := by
    apply Nat.div_le_div_right
    have hmul : (p - 2) * 2 ≤ (p - 2) * a_lam := Nat.mul_le_mul_left (p - 2) (by omega)
    have heq : (p - 1) * a_lam = a_lam + (p - 2) * a_lam := by
      rw [show p - 1 = 1 + (p - 2) by omega, Nat.add_mul, Nat.one_mul]
    omega
  have hdiv_bsym := Nat.div_add_mod ((p - 1) * a_lam) p
  have hmod_bsym := Nat.mod_lt ((p - 1) * a_lam) hp_pos
  have hp_bsym_le : p * b_sym ≤ (p - 1) * a_lam := by
    dsimp [b_sym] at hdiv_bsym ⊢
    omega
  have halam_le_2bsym : a_lam ≤ 2 * b_sym := by
    by_contra! hlt
    have hle1 : 2 * b_sym + 1 ≤ a_lam := by omega
    have h_id : 2 * ((p - 1) * a_lam) = (p - 2) * a_lam + p * a_lam := by
      rw [← Nat.mul_assoc, show 2 * (p - 1) = (p - 2) + p by omega, Nat.add_mul]
    have h_p2 : (p - 2) * 3 ≤ (p - 2) * a_lam := Nat.mul_le_mul_left (p - 2) (by omega)
    have h_p : 2 * (p * b_sym) + p ≤ p * a_lam := by
      calc 2 * (p * b_sym) + p = p * (2 * b_sym + 1) := by ring
        _ ≤ p * a_lam := Nat.mul_le_mul_left p hle1
    have h_div : (p - 1) * a_lam ≤ p * b_sym + (p - 1) := by
      dsimp [b_sym] at hdiv_bsym ⊢
      omega
    omega
  have hbsym_cond : ∀ r ∈ Finset.Icc 1 (p - 1),
      (p : ℤ) * (b_sym : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤
        (r : ℤ) * (((p - 1 : ℕ) : ℤ) * (m : ℤ)) := by
    intro r hr
    obtain ⟨hr1, _⟩ := Finset.mem_Icc.mp hr
    have h1 : (p : ℤ) * (b_sym : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (a_lam : ℤ) := by
      exact_mod_cast hp_bsym_le
    have h2 : (a_lam : ℤ) = (bE' : ℤ) + (m : ℤ) := by exact_mod_cast ha_lam_eq
    rw [h2, mul_add] at h1
    have h3 : (1 : ℤ) * (((p - 1 : ℕ) : ℤ) * (m : ℤ)) ≤
        (r : ℤ) * (((p - 1 : ℕ) : ℤ) * (m : ℤ)) := by
      apply mul_le_mul_of_nonneg_right (by omega)
      positivity
    linarith
  have hs_val : ∀ r ∈ Finset.Icc 1 (p - 1),
      s_LE' (-k_rat) r = 0 ∨ (b_sym : ℤ) ≤ valL F L (s_LE' (-k_rat) r) := by
    intro r hr
    exact hs_LE'_val (-k_rat) r hr (((p - 1 : ℕ) : ℤ) * (m : ℤ)) (b_sym : ℤ)
      (Or.inr (le_of_eq hneg_krat_val.symm)) (hbsym_cond r hr)
  have htr_val : ∀ r ∈ Finset.Icc 1 (p - 1),
      traceLM F hLE' ((-k_rat) ^ r) = 0 ∨
        (b_sym : ℤ) ≤ valL F L (traceLM F hLE' ((-k_rat) ^ r)) := by
    intro r hr
    apply htr_LE' (b_sym : ℤ) ((-k_rat) ^ r)
    right
    rw [(hvalE'_pow (-k_rat) hneg_krat_ne0 r).2, hneg_krat_val]
    exact hbsym_cond r hr
  let u₂' : L := 1 - (U₂ : L)
  have hu₂'_eq : u₂' = - F_star * ∑ r ∈ Finset.Icc 1 (p - 1), s_LE' (-k_rat) r := by
    have hnorm_expand : normLM F hLE' (1 - k_rat) - 1 =
        (∑ r ∈ Finset.Icc 1 (p - 1), s_LE' (-k_rat) r) - normLM F hLE' k_rat := by
      have h1 := hs_LE'_norm_one_add (-k_rat)
      rw [← sub_eq_add_neg, hnorm_neg_LE', ← sub_eq_add_neg] at h1
      exact h1
    have hU₂_val : (U₂ : L) = normLM F hLE' (1 - k_rat) * F_star := by
      dsimp [U₂]
      rw [h1_sub_norm_krat_inv]
    dsimp [u₂']
    rw [hU₂_val]
    linear_combination - h1_sub_norm_krat_mul_F - F_star * hnorm_expand
  have hu₂'_bsym : u₂' = 0 ∨ (b_sym : ℤ) ≤ valL F L u₂' := by
    rw [hu₂'_eq]
    have hsum_val := hvalL_sum (Finset.Icc 1 (p - 1)) (fun r => s_LE' (-k_rat) r) (b_sym : ℤ) hs_val
    have hnegF_val : - F_star = 0 ∨ (0 : ℤ) ≤ valL F L (- F_star) := by
      right; rw [hvalL_neg, hF_val0]
    simpa using hvalL_mul_ge (- F_star) _ 0 (b_sym : ℤ) hnegF_val hsum_val
  have hu₂'_qlam : u₂' = 0 ∨ (q_lam : ℤ) ≤ valL F L u₂' :=
    hvalL_mono (q_lam : ℤ) (b_sym : ℤ) u₂' (by exact_mod_cast hqlam_le_bsym) hu₂'_bsym
  
  have h2γ_ne0 : 2 * (γ : L) ≠ 0 := mul_ne_zero h2_L_ne0 (Units.ne_zero γ)
  have h2γ_val : valL F L (2 * (γ : L)) = -(a_lam : ℤ) - condExpChar F L ψ := by
    rw [hvalL_mul _ _ h2_L_ne0 (Units.ne_zero γ), h2_L_val0, zero_add, hγ_val]
  have hψ_alam : ∀ R : L, (R = 0 ∨ (a_lam : ℤ) ≤ valL F L R) → ψ (2 * (γ : L) * R) = 1 := by
    intro R hR
    apply hψ_triv
    have hm := hvalL_mul_ge (2 * (γ : L)) R (-(a_lam : ℤ) - condExpChar F L ψ) (a_lam : ℤ)
      (Or.inr (le_of_eq h2γ_val.symm)) hR
    rcases hm with hm | hm
    · exact Or.inl hm
    · right; omega
  have hu₂'_ne0 : 1 - u₂' ≠ 0 := by
    dsimp [u₂']
    rw [sub_sub_cancel]
    exact Units.ne_zero U₂
  have hmk0_U₂ : Units.mk0 (1 - u₂') hu₂'_ne0 = U₂ := by
    apply Units.ext
    dsimp [u₂']
    exact sub_sub_cancel 1 (U₂ : L)
  have hlam_U₂_raw :
      (lam_L U₂ : Ω F) ^ 2 =
        ψ (2 * (γ : L) * (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₂' ^ j)) := by
    have h := hlam_log u₂' hu₂'_qlam hu₂'_ne0
    rwa [hmk0_U₂] at h
  let S_tail : L := ∑ j ∈ Finset.Icc 2 (p - 1), ((j : ℕ) : L)⁻¹ * u₂' ^ j
  have hsum_peel :
      (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u₂' ^ j) = u₂' + S_tail := by
    have hIcc : Finset.Icc 1 (p - 1) = insert 1 (Finset.Icc 2 (p - 1)) := by
      ext j
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    have hnot_mem : 1 ∉ Finset.Icc 2 (p - 1) := by
      simp [Finset.mem_Icc]
    rw [hIcc, Finset.sum_insert hnot_mem]
    simp [S_tail]
  have hStail_val : S_tail = 0 ∨ (a_lam : ℤ) ≤ valL F L S_tail := by
    apply hvalL_sum (Finset.Icc 2 (p - 1)) _ (a_lam : ℤ)
    intro j hj
    obtain ⟨hj2, hjp1⟩ := Finset.mem_Icc.mp hj
    have hj_mem1 : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hjp1⟩
    have hj_inv_val : ((j : ℕ) : L)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F L (((j : ℕ) : L)⁻¹) := by
      right; rw [(hcoprime_val_L hj_mem1).2.2]
    have hpow_val := hvalL_pow_ge1 u₂' (b_sym : ℤ) j (by omega) hu₂'_bsym
    have h2b_le_jb : 2 * (b_sym : ℤ) ≤ (j : ℤ) * (b_sym : ℤ) := by
      apply mul_le_mul_of_nonneg_right (by omega) (by positivity)
    have halam_le_jb : (a_lam : ℤ) ≤ (j : ℤ) * (b_sym : ℤ) := by
      have h1 : (a_lam : ℤ) ≤ 2 * (b_sym : ℤ) := by exact_mod_cast halam_le_2bsym
      linarith
    have hpow_alam := hvalL_mono (a_lam : ℤ) ((j : ℤ) * (b_sym : ℤ)) (u₂' ^ j) halam_le_jb hpow_val
    simpa using hvalL_mul_ge (((j : ℕ) : L)⁻¹) (u₂' ^ j) 0 (a_lam : ℤ) hj_inv_val hpow_alam
  have hnewton_approx : ∀ r ∈ Finset.Icc 1 (p - 1),
      s_LE' (-k_rat) r + ((r : ℕ) : L)⁻¹ * traceLM F hLE' (k_rat ^ r) = 0 ∨
        (a_lam : ℤ) ≤ valL F L (s_LE' (-k_rat) r + ((r : ℕ) : L)⁻¹ * traceLM F hLE' (k_rat ^ r)) := by
    intro r hr
    obtain ⟨hr1, hrp1⟩ := Finset.mem_Icc.mp hr
    have hnewt := hs_LE'_newton (-k_rat) r hr
    rw [htr_neg_pow_LE' k_rat r] at hnewt
    set S_inner : L := ∑ j ∈ Finset.Icc 1 (r - 1),
      (-1 : L) ^ (j - 1) * s_LE' (-k_rat) j * traceLM F hLE' ((-k_rat) ^ (r - j))
    have hsign_sq : (-1 : L) ^ (r - 1) * (-1 : L) ^ (r - 1) - 1 = 0 := by
      rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow, sub_self]
    have hsign_prod : (-1 : L) ^ (r - 1) * (-1 : L) ^ r + 1 = 0 := by
      have hr_eq : (-1 : L) ^ r = (-1 : L) ^ (r - 1) * (-1 : L) := by
        rw [← pow_succ, show r - 1 + 1 = r by omega]
      rw [hr_eq]
      linear_combination - hsign_sq
    have hr_inv : ((r : ℕ) : L)⁻¹ * ((r : ℕ) : L) - 1 = 0 :=
      sub_eq_zero.mpr (inv_mul_cancel₀ (hcoprime_val_L hr).1)
    have hlin_eq :
        s_LE' (-k_rat) r + ((r : ℕ) : L)⁻¹ * traceLM F hLE' (k_rat ^ r) =
          - (-1 : L) ^ (r - 1) * ((r : ℕ) : L)⁻¹ * S_inner := by
      linear_combination
        (-1 : L) ^ (r - 1) * ((r : ℕ) : L)⁻¹ * hnewt
        - (-1 : L) ^ (r - 1) * (-1 : L) ^ (r - 1) * s_LE' (-k_rat) r * hr_inv
        - s_LE' (-k_rat) r * hsign_sq
        + ((r : ℕ) : L)⁻¹ * traceLM F hLE' (k_rat ^ r) * hsign_prod
    have hS_inner_val : S_inner = 0 ∨ (a_lam : ℤ) ≤ valL F L S_inner := by
      apply hvalL_sum (Finset.Icc 1 (r - 1)) _ (a_lam : ℤ)
      intro j hj
      obtain ⟨hj1, hjr1⟩ := Finset.mem_Icc.mp hj
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      have hrj_mem : r - j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hsign_val : (-1 : L) ^ (j - 1) = 0 ∨ (0 : ℤ) ≤ valL F L ((-1 : L) ^ (j - 1)) := by
        right; rw [(hvalL_neg1_pow (j - 1)).2]
      have hsj_val := hs_val j hj_mem
      have htr_rj_val := htr_val (r - j) hrj_mem
      have hm1 := hvalL_mul_ge ((-1 : L) ^ (j - 1)) (s_LE' (-k_rat) j) 0 (b_sym : ℤ) hsign_val hsj_val
      have hm2 := hvalL_mul_ge _ (traceLM F hLE' ((-k_rat) ^ (r - j))) (0 + (b_sym : ℤ)) (b_sym : ℤ) hm1 htr_rj_val
      apply hvalL_mono (a_lam : ℤ) (0 + (b_sym : ℤ) + (b_sym : ℤ)) _ _ hm2
      have h1 : (a_lam : ℤ) ≤ 2 * (b_sym : ℤ) := by exact_mod_cast halam_le_2bsym
      omega
    have hcoeff_val : - (-1 : L) ^ (r - 1) * ((r : ℕ) : L)⁻¹ = 0 ∨
        (0 : ℤ) ≤ valL F L (- (-1 : L) ^ (r - 1) * ((r : ℕ) : L)⁻¹) := by
      have h1 : - (-1 : L) ^ (r - 1) = 0 ∨ (0 : ℤ) ≤ valL F L (- (-1 : L) ^ (r - 1)) := by
        right; rw [hvalL_neg, (hvalL_neg1_pow (r - 1)).2]
      have h2 : ((r : ℕ) : L)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F L (((r : ℕ) : L)⁻¹) := by
        right; rw [(hcoprime_val_L hr).2.2]
      simpa using hvalL_mul_ge _ _ 0 0 h1 h2
    rw [hlin_eq]
    simpa using hvalL_mul_ge _ S_inner 0 (a_lam : ℤ) hcoeff_val hS_inner_val
  let S_target_L : L :=
    F_star * ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * traceLM F hLE' (k_rat ^ j)
  have hu₂'_sub_target :
      u₂' - S_target_L =
        - F_star * ∑ r ∈ Finset.Icc 1 (p - 1),
          (s_LE' (-k_rat) r + ((r : ℕ) : L)⁻¹ * traceLM F hLE' (k_rat ^ r)) := by
    rw [hu₂'_eq]
    dsimp [S_target_L]
    rw [Finset.sum_add_distrib]
    ring
  have hu₂'_sub_val : u₂' - S_target_L = 0 ∨ (a_lam : ℤ) ≤ valL F L (u₂' - S_target_L) := by
    rw [hu₂'_sub_target]
    have hsum := hvalL_sum (Finset.Icc 1 (p - 1)) _ (a_lam : ℤ) hnewton_approx
    have hnegF : - F_star = 0 ∨ (0 : ℤ) ≤ valL F L (- F_star) := by
      right; rw [hvalL_neg, hF_val0]
    simpa using hvalL_mul_ge (- F_star) _ 0 (a_lam : ℤ) hnegF hsum
  have hRem_val :
      (u₂' + S_tail) - S_target_L = 0 ∨
        (a_lam : ℤ) ≤ valL F L ((u₂' + S_tail) - S_target_L) := by
    rw [show (u₂' + S_tail) - S_target_L = (u₂' - S_target_L) + S_tail by ring]
    exact hvalL_add (a_lam : ℤ) (u₂' - S_target_L) S_tail hu₂'_sub_val hStail_val
  have hlam_U₂_L : (lam_L U₂ : Ω F) ^ 2 = ψ (2 * (γ : L) * S_target_L) := by
    rw [hlam_U₂_raw, hsum_peel]
    have hdecomp : 2 * (γ : L) * (u₂' + S_tail) =
        2 * (γ : L) * ((u₂' + S_tail) - S_target_L) + 2 * (γ : L) * S_target_L := by ring
    rw [hdecomp, AddChar.map_add_eq_mul, hψ_alam _ hRem_val, one_mul]
  
  have htr_pull :
      2 * (γ : L) * S_target_L =
        traceLM F hLE'
          (2 * IntermediateField.inclusion hLE' (α : L) *
            IntermediateField.inclusion hLE' (W * F_star) *
            (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * k_rat ^ j)) := by
    dsimp [S_target_L]
    rw [← hα_W, show 2 * ((α : L) * W) *
        (F_star * ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * traceLM F hLE' (k_rat ^ j)) =
        ∑ j ∈ Finset.Icc 1 (p - 1),
          (2 * (α : L) * (W * F_star) * ((j : ℕ) : L)⁻¹) * traceLM F hLE' (k_rat ^ j) by
      rw [Finset.mul_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring]
    rw [Finset.mul_sum, map_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [← htr_smul_LE']
    congr 1
    simp only [map_mul, map_ofNat, map_inv₀, map_natCast]
    ring
  rw [hlam_split, hlam_U₂_L, htr_pull]
  rfl

theorem ld_ch12_wild_odd_tot_ram_q2_twisting_char_linearization (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
