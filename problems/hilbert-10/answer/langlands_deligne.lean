    · obtain ⟨hne, hval⟩ := hδ_diff_lt s₂ s₁ hs₂₁ hs₁_lt
      have hneg : Δ_gal s₂ - Δ_gal s₁ = - (Δ_gal s₁ - Δ_gal s₂) := by ring
      rw [hneg]
      exact ⟨neg_ne_zero.mpr hne, by rw [hvalK₁_neg, hval]⟩
  have hδ_as_B₀' : ∀ s : ℕ,
      (Δ_gal s - (Δ : K₁)) ^ p - (Δ_gal s - (Δ : K₁)) = 0 ∨
        ((p * (p - 1) * (bE' - 1) - (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁ ((Δ_gal s - (Δ : K₁)) ^ p - (Δ_gal s - (Δ : K₁))) := by
    intro s
    have h := hδ_as_B₀ s
    dsimp [δ_gal, B₀] at h
    rwa [ht₁_def, ht₂_def] at h
  exact ⟨Δ_gal, hΔ_gal0, hW_gal_sum, hQ_gal_sum, hTr_gal_sum,
    hΔ_gal_val, hΔ_gal_as,
    fun s hs_lt hs_pos =>
      ⟨(hδ_ne0_and_val_eq0 s hs_lt hs_pos).1,
       (hδ_ne0_and_val_eq0 s hs_lt hs_pos).2,
       hδ_as_B₀' s⟩,
    hδ_gal_diff⟩

theorem ld_ch12_wild_odd_tot_ram_teichmuller_range_bijection_and_conj_sums (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (Δ : K₁ˣ) (u : L) (w₂ : E'ˣ)
    (τ_unit : ℕ → Lˣ)
    (hτ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0,
          IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0) = 0 ∨
        ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F M₁'
            ((∑ m ∈ (Finset.range p).erase 0,
                IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0)))
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let ξ_m := IntermediateField.inclusion hM₁'K₁
        (IntermediateField.inclusion hLM₁' (τ_unit m : L))
      valL F K₁ ξ_m = 0 ∧
      (ξ_m ^ p - ξ_m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ (ξ_m ^ p - ξ_m)))
    (hξ_diff : ∀ m₁' < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ m₂' < Module.finrank L (IntermediateField.extendScalars hLE'),
        0 < m₁' → 0 < m₂' → m₁' ≠ m₂' →
        let ξ_1 := IntermediateField.inclusion hM₁'K₁
          (IntermediateField.inclusion hLM₁' (τ_unit m₁' : L))
        let ξ_2 := IntermediateField.inclusion hM₁'K₁
          (IntermediateField.inclusion hLM₁' (τ_unit m₂' : L))
        ξ_2 - ξ_1 ≠ 0 ∧ valL F K₁ (ξ_2 - ξ_1) = 0)
    (hξ_prod : ∀ N : K₁, (N = 0 ∨ 0 ≤ valL F K₁ N) →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (∏ m ∈ (Finset.range p).erase 0,
          (N + IntermediateField.inclusion hM₁'K₁
            (IntermediateField.inclusion hLM₁' (τ_unit m : L)))) -
        (N ^ (p - 1) - 1) = 0 ∨
        ((p * (p - 1) * (bE' - 1) - (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∏ m ∈ (Finset.range p).erase 0,
                (N + IntermediateField.inclusion hM₁'K₁
                  (IntermediateField.inclusion hLM₁' (τ_unit m : L)))) -
              (N ^ (p - 1) - 1)))
    (Δ_gal : ℕ → K₁)
    (hΔ_gal0 : Δ_gal 0 = (Δ : K₁))
    (hW_gal_sum : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let u_M₁' := IntermediateField.inclusion hLM₁' u
      let n := u_M₁' * b
      let W_fn : ℕ → E' := fun i =>
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
            (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
      IntermediateField.inclusion hE'K₁ (W_fn i) =
        ∑ s ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
            (Δ_gal s) ^ i *
            IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_gal s)) *
            (IntermediateField.inclusion hM₁'K₁
              (1 + u_M₁' * normLM F hM₁'K₁ (Δ_gal s)))⁻¹)
    (hQ_gal_sum :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let u_M₁' := IntermediateField.inclusion hLM₁' u
      let n := u_M₁' * b
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      let Q_quad : E' :=
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
            (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
      IntermediateField.inclusion hE'K₁ Q_quad =
        ∑ s ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
            (Δ_gal s) ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁
              (normLM F hM₁'K₁ (Δ_gal s) *
                traceLM F hM₁'K₁
                  ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) *
                    Δ_gal s) ^ (p - 1))) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ (Δ_gal s)) ^ 2))⁻¹)
    (hTr_gal_sum :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1))) =
        ∑ s ∈ Finset.range p, (Δ_gal s) ^ (p - 1))
    (hΔ_gal_val : ∀ s : ℕ, Δ_gal s ≠ 0 ∧ valL F K₁ (Δ_gal s) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_gal_as : ∀ s : ℕ,
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (Δ_gal s) ^ p - (Δ : K₁) ^ p - (Δ_gal s - (Δ : K₁)) = 0 ∨
        ((4 * p * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ_gal s) ^ p - (Δ : K₁) ^ p - (Δ_gal s - (Δ : K₁))))
    (hδ_gal_props : ∀ s < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < s →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      Δ_gal s - (Δ : K₁) ≠ 0 ∧
      valL F K₁ (Δ_gal s - (Δ : K₁)) = 0 ∧
      ((Δ_gal s - (Δ : K₁)) ^ p - (Δ_gal s - (Δ : K₁)) = 0 ∨
        ((p * (p - 1) * (bE' - 1) - (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁ ((Δ_gal s - (Δ : K₁)) ^ p - (Δ_gal s - (Δ : K₁)))))
    (hδ_gal_diff : ∀ s₁ < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ s₂ < Module.finrank L (IntermediateField.extendScalars hLE'),
        0 < s₁ → 0 < s₂ → s₁ ≠ s₂ →
        (Δ_gal s₂ - (Δ : K₁)) - (Δ_gal s₁ - (Δ : K₁)) ≠ 0 ∧
        valL F K₁ ((Δ_gal s₂ - (Δ : K₁)) - (Δ_gal s₁ - (Δ : K₁))) = 0) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let n := u_M₁' * b
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let W_fn : ℕ → E' := fun i =>
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
    let Q_quad : E' :=
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
          (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
    ∃ (ξ Δ_conj : ℕ → K₁),
      ξ 0 = 0 ∧
      Δ_conj 0 = (Δ : K₁) ∧
      (∀ m < p, 0 < m →
        ξ m = IntermediateField.inclusion hM₁'K₁
          (IntermediateField.inclusion hLM₁' (τ_unit m : L))) ∧
      (∀ m < p, 0 < m →
        ξ m ≠ 0 ∧
        valL F K₁ (ξ m) = 0 ∧
        ((ξ m) ^ p - ξ m = 0 ∨
          ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m))) ∧
      (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
        (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
          (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
          ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
            valL F K₁
              ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
                (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0))) ∧
      (∀ m < p, Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -(t₁ : ℤ)) ∧
      (∀ i ∈ Finset.Icc 1 (p - 1),
        IntermediateField.inclusion hE'K₁ (W_fn i) =
          ∑ m ∈ Finset.range p,
            IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
              (Δ_conj m) ^ i *
              IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) *
              (IntermediateField.inclusion hM₁'K₁
                (1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)))⁻¹) ∧
      (IntermediateField.inclusion hE'K₁ Q_quad =
        ∑ m ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
            (Δ_conj m) ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁
              (normLM F hM₁'K₁ (Δ_conj m) *
                traceLM F hM₁'K₁
                  ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) *
                    Δ_conj m) ^ (p - 1))) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)) ^ 2))⁻¹) ∧
      (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1))) =
        ∑ m ∈ Finset.range p, (Δ_conj m) ^ (p - 1)) ∧
      (∀ m < p,
        (Δ_conj m) ^ p - (Δ : K₁) ^ p - (Δ_conj m - (Δ : K₁)) = 0 ∨
          ((4 * p * p * p * m₁ : ℕ) : ℤ) ≤
            valL F K₁ ((Δ_conj m) ^ p - (Δ : K₁) ^ p - (Δ_conj m - (Δ : K₁)))) ∧
      (∀ m < p,
        Δ_conj m - ((Δ : K₁) + ξ m) = 0 ∨
          ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ) ≤
            valL F K₁ (Δ_conj m - ((Δ : K₁) + ξ m))) :=
by
  intro p t₁ t₂ m₁ b z u_M₁' n T W_fn Q_quad
  set S' : Finset ℕ := (Finset.range p).erase 0
  set B₀ : ℤ := ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ)
  set δ : ℕ → K₁ := fun s => Δ_gal s - (Δ : K₁)
  set ξ_pos : ℕ → K₁ := fun m =>
    IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' (τ_unit m : L))
  set ξ : ℕ → K₁ := fun m => if m = 0 then 0 else ξ_pos m
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hB₀_ge1 : (1 : ℤ) ≤ B₀ := by
    dsimp only [B₀, t₁, t₂]
    have h1 : 2 * 1 ≤ (p - 1) * (bE' - 1) :=
      Nat.mul_le_mul (by omega) (by omega)
    have h2 : (p - 1) * (bM₁' - 1) ≤ (p - 1) * (bE' - 1) :=
      Nat.mul_le_mul_left (p - 1) (by omega)
    have h3 : 3 * ((p - 1) * (bE' - 1)) ≤ p * ((p - 1) * (bE' - 1)) :=
      Nat.mul_le_mul_right ((p - 1) * (bE' - 1)) hp_ge3
    have h4 : p * ((p - 1) * (bE' - 1)) = p * (p - 1) * (bE' - 1) := by ring
    omega
  have hp1_even : Even (p - 1) := by
    rcases hPrime.odd_of_ne_two hp_odd with ⟨k, hk⟩
    exact ⟨k, by omega⟩
  have hneg_pow_p1 : ∀ x : K₁, (-x) ^ (p - 1) = x ^ (p - 1) := fun x =>
    hp1_even.neg_pow x
  rcases hvalK₁_props with
    ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
      hval_add, hunit0, hunit_a, hunit_val0⟩
  have hval_sub : ∀ (k : ℤ) (x y : K₁),
      (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
        (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
    intro k x y hx hy
    have hy_neg : -y = 0 ∨ k ≤ valL F K₁ (-y) := by
      rw [neg_eq_zero, hval_neg]
      exact hy
    rw [sub_eq_add_neg]
    exact hval_add k x (-y) hx hy_neg
  have hval_cancel_unit : ∀ (k : ℤ) (u x : K₁),
      u ≠ 0 → valL F K₁ u = 0 →
      (u * x = 0 ∨ k ≤ valL F K₁ (u * x)) →
      (x = 0 ∨ k ≤ valL F K₁ x) := by
    intro k u x hu_ne hu_val hux
    by_cases hx : x = 0
    · exact Or.inl hx
    · right
      have hux_ne : u * x ≠ 0 := mul_ne_zero hu_ne hx
      rcases hux with h0 | hle
      · exact False.elim (hux_ne h0)
      · rw [hval_mul u x hu_ne hx, hu_val, zero_add] at hle
        exact hle
  have hval_unit_add_pos : ∀ (u z : K₁),
      u ≠ 0 → valL F K₁ u = 0 →
      (z = 0 ∨ (1 : ℤ) ≤ valL F K₁ z) →
      u + z ≠ 0 ∧ valL F K₁ (u + z) = 0 := by
    intro u z hu_ne hu_val hz
    have h_ne : u + z ≠ 0 := by
      intro h0
      have hz_eq : z = -u := by linear_combination h0
      have hz_ne : z ≠ 0 := by
        rw [hz_eq]
        exact neg_ne_zero.mpr hu_ne
      have hz_val : valL F K₁ z = 0 := by
        rw [hz_eq, hval_neg, hu_val]
      rcases hz with rfl | hle
      · exact hz_ne rfl
      · omega
    have hu0 : u = 0 ∨ (0 : ℤ) ≤ valL F K₁ u := Or.inr (by omega)
    have hz0 : z = 0 ∨ (0 : ℤ) ≤ valL F K₁ z := by
      rcases hz with rfl | hle
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have huz0 : (0 : ℤ) ≤ valL F K₁ (u + z) := by
      rcases hval_add 0 u z hu0 hz0 with h0 | hle
      · exact False.elim (h_ne h0)
      · exact hle
    have huz_le0 : valL F K₁ (u + z) ≤ 0 := by
      by_contra hlt
      have hge1 : (1 : ℤ) ≤ valL F K₁ (u + z) := by omega
      have hsub := hval_sub 1 (u + z) z (Or.inr hge1) hz
      rw [add_sub_cancel_right] at hsub
      rcases hsub with h0 | hle
      · exact hu_ne h0
      · omega
    exact ⟨h_ne, by omega⟩
  have hprod_unit : ∀ (T₀ : Finset ℕ) (f : ℕ → K₁),
      (∀ m ∈ T₀, f m ≠ 0 ∧ valL F K₁ (f m) = 0) →
      (∏ m ∈ T₀, f m) ≠ 0 ∧ valL F K₁ (∏ m ∈ T₀, f m) = 0 := by
    intro T₀ f
    induction' T₀ using Finset.cons_induction with a s ha ih
    · intro _
      simp [hval1]
    · intro hT
      rw [Finset.prod_cons]
      have ha_prop : f a ≠ 0 ∧ valL F K₁ (f a) = 0 :=
        hT a (Finset.mem_cons_self a s)
      have hs_prop : (∏ m ∈ s, f m) ≠ 0 ∧ valL F K₁ (∏ m ∈ s, f m) = 0 :=
        ih (fun m hm => hT m (Finset.mem_cons_of_mem hm))
      refine ⟨mul_ne_zero ha_prop.1 hs_prop.1, ?_⟩
      rw [hval_mul (f a) (∏ m ∈ s, f m) ha_prop.1 hs_prop.1, ha_prop.2, hs_prop.2, add_zero]
  have hprod_mem_pos : ∀ (T₀ : Finset ℕ) (f : ℕ → K₁),
      ((∏ m ∈ T₀, f m) = 0 ∨ (1 : ℤ) ≤ valL F K₁ (∏ m ∈ T₀, f m)) →
      ∃ m ∈ T₀, f m = 0 ∨ (1 : ℤ) ≤ valL F K₁ (f m) := by
    intro T₀ f
    induction' T₀ using Finset.cons_induction with a s ha ih
    · intro h
      rw [Finset.prod_empty] at h
      rcases h with h0 | hle
      · exact False.elim (one_ne_zero h0)
      · rw [hval1] at hle
        omega
    · intro h
      rw [Finset.prod_cons] at h
      by_cases hfa : f a = 0 ∨ (1 : ℤ) ≤ valL F K₁ (f a)
      · exact ⟨a, Finset.mem_cons_self a s, hfa⟩
      · push_neg at hfa
        rcases hfa with ⟨hfa_ne, hfa_lt1⟩
        have hs_pos : (∏ m ∈ s, f m) = 0 ∨ (1 : ℤ) ≤ valL F K₁ (∏ m ∈ s, f m) := by
          by_cases hps : (∏ m ∈ s, f m) = 0
          · exact Or.inl hps
          · right
            have hmul_ne : f a * (∏ m ∈ s, f m) ≠ 0 := mul_ne_zero hfa_ne hps
            rcases h with h0 | hle
            · exact False.elim (hmul_ne h0)
            · rw [hval_mul (f a) (∏ m ∈ s, f m) hfa_ne hps] at hle
              omega
        rcases ih hs_pos with ⟨m, hm_s, hm_prop⟩
        exact ⟨m, Finset.mem_cons_of_mem hm_s, hm_prop⟩
  have hξ0 : ξ 0 = 0 := if_pos rfl
  have hξ_def : ∀ m < p, 0 < m → ξ m = ξ_pos m := by
    intro m _ hm_pos
    exact if_neg (Nat.ne_of_gt hm_pos)
  have hξ_out : ∀ m < p, 0 < m →
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)) := by
    intro m hm_lt hm_pos
    rw [hξ_def m hm_lt hm_pos]
    have h_ne : ξ_pos m ≠ 0 := by
      intro h0
      have h1 : IntermediateField.inclusion hLM₁' (τ_unit m : L) = 0 :=
        (IntermediateField.inclusion hM₁'K₁).injective
          (by rw [map_zero]; exact h0)
      have h2 : (τ_unit m : L) = 0 :=
        (IntermediateField.inclusion hLM₁').injective
          (by rw [map_zero]; exact h1)
      exact Units.ne_zero (τ_unit m) h2
    exact ⟨h_ne, hξ_props m hm_lt hm_pos⟩
  have hξ_pow_sum_K₁ : ∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
      (∑ m ∈ S', (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ S', (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)) := by
    intro r hr
    set D_M₁' : M₁' :=
      (∑ m ∈ S', IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0)
    set D_K₁ : K₁ :=
      (∑ m ∈ S', (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)
    have hsum_eq : ∑ m ∈ S', (ξ m) ^ r =
        IntermediateField.inclusion hM₁'K₁
          (∑ m ∈ S', IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) := by
      rw [map_sum]
      refine Finset.sum_congr rfl ?_
      intro m hm
      have hm_ne0 : m ≠ 0 := (Finset.mem_erase.mp hm).1
      have hξm : ξ m = ξ_pos m := if_neg hm_ne0
      rw [hξm]
      exact (map_pow (IntermediateField.inclusion hM₁'K₁)
        (IntermediateField.inclusion hLM₁' (τ_unit m : L)) r).symm
    have hif_eq : (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) =
        IntermediateField.inclusion hM₁'K₁
          (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0) := by
      split_ifs
      · exact (map_natCast (IntermediateField.inclusion hM₁'K₁) (p - 1)).symm
      · exact (map_zero (IntermediateField.inclusion hM₁'K₁)).symm
    have hD_eq : D_K₁ = IntermediateField.inclusion hM₁'K₁ D_M₁' := by
      dsimp only [D_K₁, D_M₁']
      rw [hsum_eq, hif_eq, ← map_sub]
    have hτ_r := hτ_pow_sum r hr
    change D_M₁' = 0 ∨ ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤ valL F M₁' D_M₁' at hτ_r
    rcases hτ_r with h0 | hle
    · left
      rw [hD_eq, h0, map_zero]
    · right
      rw [hD_eq, hval_M₁'K₁ D_M₁']
      have hp_nonneg : (0 : ℤ) ≤ (p : ℤ) := by positivity
      have hmul := mul_le_mul_of_nonneg_left hle hp_nonneg
      have hcast : ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) =
          (p : ℤ) * ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) := by
        push_cast
        ring
      rw [hcast]
      exact hmul
  have h_match : ∀ s ∈ S', ∃ m ∈ S',
      Δ_gal s - ((Δ : K₁) + ξ_pos m) = 0 ∨ B₀ ≤ valL F K₁ (Δ_gal s - ((Δ : K₁) + ξ_pos m)) := by
    intro s hs
    have hs_ne0 : s ≠ 0 := (Finset.mem_erase.mp hs).1
    have hs_lt : s < p := Finset.mem_range.mp (Finset.mem_erase.mp hs).2
    have hs_pos : 0 < s := Nat.pos_of_ne_zero hs_ne0
    obtain ⟨hδ_ne, hδ_val, hδ_p⟩ := hδ_gal_props s hs_lt hs_pos
    change δ s ≠ 0 at hδ_ne
    change valL F K₁ (δ s) = 0 at hδ_val
    change (δ s) ^ p - δ s = 0 ∨ B₀ ≤ valL F K₁ ((δ s) ^ p - δ s) at hδ_p
    have hδ_fact : (δ s) ^ p - δ s = δ s * ((δ s) ^ (p - 1) - 1) := by
      have hp_eq : (p - 1) + 1 = p := Nat.sub_add_cancel (by omega)
      calc
        (δ s) ^ p - δ s = (δ s) ^ ((p - 1) + 1) - δ s := by rw [hp_eq]
        _ = δ s * (δ s) ^ (p - 1) - δ s := by rw [pow_succ']
        _ = δ s * ((δ s) ^ (p - 1) - 1) := by ring
    rw [hδ_fact] at hδ_p
    have hδ_p1 : (δ s) ^ (p - 1) - 1 = 0 ∨ B₀ ≤ valL F K₁ ((δ s) ^ (p - 1) - 1) :=
      hval_cancel_unit B₀ (δ s) ((δ s) ^ (p - 1) - 1) hδ_ne hδ_val hδ_p
    have hneg_δ_p1 : (-δ s) ^ (p - 1) - 1 = 0 ∨ B₀ ≤ valL F K₁ ((-δ s) ^ (p - 1) - 1) := by
      rw [hneg_pow_p1 (δ s)]
      exact hδ_p1
    have hneg_δ_val : -δ s = 0 ∨ 0 ≤ valL F K₁ (-δ s) := by
      right
      rw [hval_neg, hδ_val]
    have hprod_sub := hξ_prod (-δ s) hneg_δ_val
    change (∏ m ∈ S', (-δ s + ξ_pos m)) - ((-δ s) ^ (p - 1) - 1) = 0 ∨
      B₀ ≤ valL F K₁ ((∏ m ∈ S', (-δ s + ξ_pos m)) - ((-δ s) ^ (p - 1) - 1)) at hprod_sub
    have hprod_B₀ :
        (∏ m ∈ S', (-δ s + ξ_pos m)) = 0 ∨ B₀ ≤ valL F K₁ (∏ m ∈ S', (-δ s + ξ_pos m)) := by
      have hadd := hval_add B₀ ((∏ m ∈ S', (-δ s + ξ_pos m)) - ((-δ s) ^ (p - 1) - 1))
        ((-δ s) ^ (p - 1) - 1) hprod_sub hneg_δ_p1
      rw [sub_add_cancel] at hadd
      exact hadd
    have hprod_pos : (∏ m ∈ S', (-δ s + ξ_pos m)) = 0 ∨
        (1 : ℤ) ≤ valL F K₁ (∏ m ∈ S', (-δ s + ξ_pos m)) := by
      rcases hprod_B₀ with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    obtain ⟨m_s, hm_s_mem, hm_s_mod1⟩ := hprod_mem_pos S' (fun m => -δ s + ξ_pos m) hprod_pos
    have hm_s_ne0 : m_s ≠ 0 := (Finset.mem_erase.mp hm_s_mem).1
    have hm_s_lt : m_s < p := Finset.mem_range.mp (Finset.mem_erase.mp hm_s_mem).2
    have hm_s_pos : 0 < m_s := Nat.pos_of_ne_zero hm_s_ne0
    have h_other_unit : ∀ m' ∈ S'.erase m_s,
        -δ s + ξ_pos m' ≠ 0 ∧ valL F K₁ (-δ s + ξ_pos m') = 0 := by
      intro m' hm'
      have hm'_ne_ms : m' ≠ m_s := (Finset.mem_erase.mp hm').1
      have hm'_S' : m' ∈ S' := (Finset.mem_erase.mp hm').2
      have hm'_ne0 : m' ≠ 0 := (Finset.mem_erase.mp hm'_S').1
      have hm'_lt : m' < p := Finset.mem_range.mp (Finset.mem_erase.mp hm'_S').2
      have hm'_pos : 0 < m' := Nat.pos_of_ne_zero hm'_ne0
      obtain ⟨hξ_ne, hξ_val⟩ :=
        hξ_diff m_s hm_s_lt m' hm'_lt hm_s_pos hm'_pos (Ne.symm hm'_ne_ms)
      change ξ_pos m' - ξ_pos m_s ≠ 0 at hξ_ne
      change valL F K₁ (ξ_pos m' - ξ_pos m_s) = 0 at hξ_val
      have h_split : -δ s + ξ_pos m' = (ξ_pos m' - ξ_pos m_s) + (-δ s + ξ_pos m_s) := by ring
      rw [h_split]
      exact hval_unit_add_pos (ξ_pos m' - ξ_pos m_s) (-δ s + ξ_pos m_s) hξ_ne hξ_val hm_s_mod1
    obtain ⟨hP_ne, hP_val⟩ := hprod_unit (S'.erase m_s) (fun m' => -δ s + ξ_pos m') h_other_unit
    have hprod_eq : (∏ m' ∈ S'.erase m_s, (-δ s + ξ_pos m')) * (-δ s + ξ_pos m_s) =
        ∏ m ∈ S', (-δ s + ξ_pos m) :=
      Finset.prod_erase_mul S' (fun m => -δ s + ξ_pos m) hm_s_mem
    rw [← hprod_eq] at hprod_B₀
    have hms_B₀ : -δ s + ξ_pos m_s = 0 ∨ B₀ ≤ valL F K₁ (-δ s + ξ_pos m_s) :=
      hval_cancel_unit B₀ (∏ m' ∈ S'.erase m_s, (-δ s + ξ_pos m')) (-δ s + ξ_pos m_s)
        hP_ne hP_val hprod_B₀
    refine ⟨m_s, hm_s_mem, ?_⟩
    have h_neg_eq : Δ_gal s - ((Δ : K₁) + ξ_pos m_s) = -(-δ s + ξ_pos m_s) := by
      dsimp only [δ]
      ring
    rw [h_neg_eq, neg_eq_zero, hval_neg]
    exact hms_B₀
  let φ : ℕ → ℕ := fun s => if hs : s ∈ S' then Classical.choose (h_match s hs) else 0
  have hφ_mem : ∀ s ∈ S', φ s ∈ S' := by
    intro s hs
    dsimp only [φ]
    rw [dif_pos hs]
    exact (Classical.choose_spec (h_match s hs)).1
  have hφ_approx : ∀ s ∈ S',
      Δ_gal s - ((Δ : K₁) + ξ_pos (φ s)) = 0 ∨
        B₀ ≤ valL F K₁ (Δ_gal s - ((Δ : K₁) + ξ_pos (φ s))) := by
    intro s hs
    dsimp only [φ]
    rw [dif_pos hs]
    exact (Classical.choose_spec (h_match s hs)).2
  have hφ_maps : Set.MapsTo φ ↑S' ↑S' := fun s hs => hφ_mem s hs
  have hφ_inj : Set.InjOn φ ↑S' := by
    intro s₁ hs₁ s₂ hs₂ hφ_eq
    by_contra hs_ne
    have hs₁' : s₁ ∈ S' := hs₁
    have hs₂' : s₂ ∈ S' := hs₂
    have hs₁_ne0 : s₁ ≠ 0 := (Finset.mem_erase.mp hs₁').1
    have hs₁_lt : s₁ < p := Finset.mem_range.mp (Finset.mem_erase.mp hs₁').2
    have hs₁_pos : 0 < s₁ := Nat.pos_of_ne_zero hs₁_ne0
    have hs₂_ne0 : s₂ ≠ 0 := (Finset.mem_erase.mp hs₂').1
    have hs₂_lt : s₂ < p := Finset.mem_range.mp (Finset.mem_erase.mp hs₂').2
    have hs₂_pos : 0 < s₂ := Nat.pos_of_ne_zero hs₂_ne0
    have hdiff_eq : (Δ_gal s₂ - (Δ : K₁)) - (Δ_gal s₁ - (Δ : K₁)) =
        (Δ_gal s₂ - ((Δ : K₁) + ξ_pos (φ s₂))) - (Δ_gal s₁ - ((Δ : K₁) + ξ_pos (φ s₁))) := by
      rw [hφ_eq]
      ring
    have hdiff_B₀ : (Δ_gal s₂ - (Δ : K₁)) - (Δ_gal s₁ - (Δ : K₁)) = 0 ∨
        B₀ ≤ valL F K₁ ((Δ_gal s₂ - (Δ : K₁)) - (Δ_gal s₁ - (Δ : K₁))) := by
      rw [hdiff_eq]
      exact hval_sub B₀ (Δ_gal s₂ - ((Δ : K₁) + ξ_pos (φ s₂)))
        (Δ_gal s₁ - ((Δ : K₁) + ξ_pos (φ s₁))) (hφ_approx s₂ hs₂') (hφ_approx s₁ hs₁')
    obtain ⟨hδ_diff_ne, hδ_diff_val⟩ :=
      hδ_gal_diff s₁ hs₁_lt s₂ hs₂_lt hs₁_pos hs₂_pos hs_ne
    rcases hdiff_B₀ with h0 | hle
    · exact hδ_diff_ne h0
    · omega
  have hφ_surj : Set.SurjOn φ ↑S' ↑S' :=
    Finset.surjOn_of_injOn_of_card_le φ hφ_maps hφ_inj le_rfl
  have h_pre : ∀ m ∈ S', ∃ s ∈ S', φ s = m := fun m hm => hφ_surj hm
  let σ : ℕ → ℕ := fun m => if hm : m ∈ S' then Classical.choose (h_pre m hm) else 0
  have hσ_mem : ∀ m ∈ S', σ m ∈ S' := by
    intro m hm
    dsimp only [σ]
    rw [dif_pos hm]
    exact (Classical.choose_spec (h_pre m hm)).1
  have hφ_σ : ∀ m ∈ S', φ (σ m) = m := by
    intro m hm
    dsimp only [σ]
    rw [dif_pos hm]
    exact (Classical.choose_spec (h_pre m hm)).2
  have hσ_φ : ∀ s ∈ S', σ (φ s) = s := by
    intro s hs
    have hφs : φ s ∈ S' := hφ_mem s hs
    exact hφ_inj (hσ_mem (φ s) hφs) hs (hφ_σ (φ s) hφs)
  have h0_not_S' : 0 ∉ S' := fun h => (Finset.mem_erase.mp h).1 rfl
  have hφ0 : φ 0 = 0 := dif_neg h0_not_S'
  have hσ0 : σ 0 = 0 := dif_neg h0_not_S'
  have hφ_range : ∀ s ∈ Finset.range p, φ s ∈ Finset.range p := by
    intro s hs
    by_cases hs0 : s = 0
    · rw [hs0, hφ0]
      exact Finset.mem_range.mpr hPrime.pos
    · have hs_S' : s ∈ S' := Finset.mem_erase.mpr ⟨hs0, hs⟩
      exact (Finset.mem_erase.mp (hφ_mem s hs_S')).2
  have hσ_φ_range : ∀ s ∈ Finset.range p, σ (φ s) = s := by
    intro s hs
    by_cases hs0 : s = 0
    · rw [hs0, hφ0, hσ0]
    · have hs_S' : s ∈ S' := Finset.mem_erase.mpr ⟨hs0, hs⟩
