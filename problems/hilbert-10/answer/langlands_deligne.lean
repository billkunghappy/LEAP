    (hN₁_val :
      let a := condExp F L νM₁' / 2
      let k₀ := 1 + d
      let h₀ := f + g + 4 * f * g
      let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
        IntermediateField.inclusion hLM₁' k₀ * x
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      valL F M₁' (a₁ + IntermediateField.inclusion hLM₁' A + Q₁) = 1 - 2 * (a : ℤ))
    (hcM₁'_stat_N₁ :
      let k₀ := 1 + d
      let h₀ := f + g + 4 * f * g
      let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
        IntermediateField.inclusion hLM₁' k₀ * x
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      let N₁ : M₁' := a₁ + IntermediateField.inclusion hLM₁' A + Q₁
      ∀ z : M₁',
        (z = 0 ∨ (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          ((recChar F rec M₁' χM₁') (Units.mk0 (1 + z) hz) : Ω F) =
            (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L)) * N₁ * z)) :
    let a := condExp F L νM₁' / 2
    let r := condExp F L νE' / 2
    let m₁ := condExp F M₁' (recChar F rec M₁' χM₁')
    let m₂ := condExp F E' (recChar F rec E' χE')
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let θE' := recChar F rec E' χE'
    let θM₁' := recChar F rec M₁' χM₁'
    ∃ (C : K₁ˣ) (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0) (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0),
      let cE' : E'ˣ :=
        Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
          (Units.map (normLM F hE'K₁) C)⁻¹
      let cνE' : Lˣ :=
        α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹
      let cM₁' : M₁'ˣ :=
        Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
          (Units.map (normLM F hM₁'K₁) C)⁻¹
      let cνM₁' : Lˣ :=
        α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹
      valL F K₁ (C : K₁) = (1 - 2 * (a : ℤ)) ∧
      valL F E' (cE' : E') = (m₂ : ℤ) + condExpChar F E' ψE' ∧
      (∀ w : E', (w = 0 ∨ (((m₂ + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w) →
        ∀ hw : 1 + w ≠ 0,
          (θE' (Units.mk0 (1 + w) hw) : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * w)) ∧
      valL F M₁' (cM₁' : M₁') = (m₁ : ℤ) + condExpChar F M₁' ψM₁' ∧
