        let ψ_Fi := traceChar F (D_orb.get i).le ψ
        let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
        valL F F_i (ϖ_Fi i : F_i) = 1 ∧
        IsResidueFieldMap F F_i (k_Fi i) (resFi i) ∧
        IsStatResChar F F_i ψ_Fi (μ'_orb i) (ϖ_Fi i) (c'_μ i) (k_Fi i) (resFi i) (ψ_0μ i) ∧
        IsStatResChar F F_i ψ_Fi θ_i (ϖ_Fi i) (c'_θ i) (k_Fi i) (resFi i) (ψ_0θ i)) :=
by
  have hfinrank_tower : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      Module.finrank F A * Module.finrank A (IntermediateField.extendScalars hAB) =
        Module.finrank F B := by
    intro A B _ _ hAB
    let B' : IntermediateField A (AlgebraicClosure F) := IntermediateField.extendScalars hAB
    let e_B : B ≃ₐ[F] B' :=
      { toExtendScalars F hAB with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hAB).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F B' := Module.Finite.equiv e_B.toLinearEquiv
    haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    rw [Module.finrank_mul_finrank F A B']
    exact (LinearEquiv.finrank_eq e_B.toLinearEquiv).symm
  have hp_prime : Nat.Prime (p F) := (ld_frob_pow_on_primeToP_roots F).1
  have hp_ge2 : 2 ≤ p F := hp_prime.two_le
  have hp_ne2 : p F ≠ 2 := hBranch2.1
  have hp_ge3 : 3 ≤ p F := by omega
  set q_MCK : ℕ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  obtain ⟨r_exp, hr_exp, hq_eq⟩ := hq_pow
  have hq_ge3 : 3 ≤ q_MCK := by
    have h1 : (p F) ^ 1 ≤ (p F) ^ r_exp := Nat.pow_le_pow_right (by omega) hr_exp
    rw [pow_one, ← hq_eq] at h1
    omega
  have hlen_pos : 0 < D_orb.length := by
    by_contra h0
    have hsum0 : (∑ i : Fin D_orb.length,
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) = 0 :=
      Finset.sum_eq_zero (fun i _ => by have := i.2; omega)
