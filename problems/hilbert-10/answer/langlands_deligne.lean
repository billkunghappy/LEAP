            congr 1; apply Subtype.ext
            change π (ι_LA (((s_A u₀)⁻¹ * w) * r_A ((s_A u₀)⁻¹ * w))) =
              (cosetRep u₀).1.1⁻¹ * π (ι_LA w) * (cosetRep u₀).1.1
            rw [hr_eq, map_mul, map_mul, map_mul, map_mul, map_inv, map_inv, hs_A_π u₀]
          rw [h_χ]
        rw [hB_lin, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one,
          smul_eq_mul, mul_one]
      · rw [dif_neg hc]
        have hu_ne : u_A ((s_A u₀)⁻¹ * w) ≠ u₀ := fun h => hc ((hu_iff w u₀).mp h)
        have hB_lin : B_lin = 0 := by
          apply LinearMap.ext; intro a
          change (ρ_B ⟨((s_A u₀)⁻¹ * w) * r_A ((s_A u₀)⁻¹ * w), h_xr_mem ((s_A u₀)⁻¹ * w)⟩
            (ULift.up (Pi.single (M := fun _ : H_A ⧸ H'_B => Ω F) u₀ a
              (u_A ((s_A u₀)⁻¹ * w))))).down = 0
          rw [Pi.single_eq_of_ne hu_ne]
          change (ρ_B _ (0 : W_V)).down = 0
          rw [map_zero]; rfl
        rw [hB_lin, map_zero]
    let g_w : G := π (ι_LA w)
    have h_sum_eq :
        (∑ y : H_A,
          if hm : y.1.1 * g_w * y.1.1⁻¹ ∈ M_B then
            (ψ_B ⟨y.1.1 * g_w * y.1.1⁻¹, hm⟩ : Ω F)
          else 0) =
        ∑ p : (H_A ⧸ H'_B) × H'_B,
          if hm : (e_coset p).1.1 * g_w * (e_coset p).1.1⁻¹ ∈ M_B then
            (ψ_B ⟨(e_coset p).1.1 * g_w * (e_coset p).1.1⁻¹, hm⟩ : Ω F)
          else 0 :=
      (Fintype.sum_equiv e_coset _ _ (fun _ => rfl)).symm
    have h_inner : ∀ u₀ : H_A ⧸ H'_B,
        (∑ z : H'_B,
          if hm : (e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹ ∈ M_B then
            (ψ_B ⟨(e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹, hm⟩ : Ω F)
          else 0) =
        (Nat.card H_B : Ω F) *
          if hc : (cosetRep u₀).1.1⁻¹ * g_w * (cosetRep u₀).1.1 ∈ M_B then
            (ψ_B ⟨(cosetRep u₀).1.1⁻¹ * g_w * (cosetRep u₀).1.1, hc⟩ : Ω F)
          else 0 := by
      intro u₀
      let c_u : G := (cosetRep u₀).1.1⁻¹ * g_w * (cosetRep u₀).1.1
      have h_term : ∀ z : H'_B,
          (if hm : (e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹ ∈ M_B then
            (ψ_B ⟨(e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹, hm⟩ : Ω F)
          else 0) =
          if hc : c_u ∈ M_B then (ψ_B ⟨c_u, hc⟩ : Ω F) else 0 := by
        intro z
        have hz_MB : z.1.1.1 ∈ M_B := by
          rw [hMB_iff, hprojH_id]
          exact z.2
        let m_z : M_B := ⟨z.1.1.1, hz_MB⟩
        have h_conj_z : (e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹ =
            z.1.1.1 * c_u * z.1.1.1⁻¹ := by
          have he : (e_coset (u₀, z)).1.1 = z.1.1.1 * (cosetRep u₀).1.1⁻¹ :=
            congrArg (fun x : H_A => x.1.1) (he_coset u₀ z)
          rw [he]
          change (z.1.1.1 * (cosetRep u₀).1.1⁻¹) * g_w * (z.1.1.1 * (cosetRep u₀).1.1⁻¹)⁻¹ =
            z.1.1.1 * ((cosetRep u₀).1.1⁻¹ * g_w * (cosetRep u₀).1.1) * z.1.1.1⁻¹
          group
        have h_mem_iff : (e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹ ∈ M_B ↔
            c_u ∈ M_B := by
          rw [h_conj_z]
          refine ⟨fun hm => ?_, fun hc => M_B.mul_mem (M_B.mul_mem hz_MB hc) (M_B.inv_mem hz_MB)⟩
          have h1 : z.1.1.1⁻¹ * (z.1.1.1 * c_u * z.1.1.1⁻¹) * z.1.1.1 ∈ M_B :=
            M_B.mul_mem (M_B.mul_mem (M_B.inv_mem hz_MB) hm) hz_MB
          have h2 : z.1.1.1⁻¹ * (z.1.1.1 * c_u * z.1.1.1⁻¹) * z.1.1.1 = c_u := by group
          rwa [h2] at h1
        by_cases hc : c_u ∈ M_B
        · have hzc : (e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹ ∈ M_B :=
            h_mem_iff.mpr hc
          rw [dif_pos hzc, dif_pos hc]
          have h_sub_eq : (⟨(e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹, hzc⟩ : M_B) =
              m_z * ⟨c_u, hc⟩ * m_z⁻¹ := Subtype.ext h_conj_z
          rw [h_sub_eq, map_mul, map_mul, map_inv, mul_comm (ψ_B m_z), mul_inv_cancel_right]
        · have hzc : (e_coset (u₀, z)).1.1 * g_w * (e_coset (u₀, z)).1.1⁻¹ ∉ M_B :=
            fun hm => hc (h_mem_iff.mp hm)
          rw [dif_neg hzc, dif_neg hc]
      simp_rw [h_term]
      have h_card_eq : Fintype.card H'_B = Nat.card H_B := by
        rw [← Nat.card_eq_fintype_card]
        exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hHB_le_HA).toEquiv
      rw [Finset.sum_const, Finset.card_univ, h_card_eq, nsmul_eq_mul]
    change (1 : ℤ) • LinearMap.trace (Ω F) (indSpace W_BA ρ_B) (indRep W_BA ρ_B w) =
      (Nat.card H_B : Ω F)⁻¹ *
        ∑ y : H_A,
          if hm : y.1.1 * g_w * y.1.1⁻¹ ∈ M_B then
            (ψ_B ⟨y.1.1 * g_w * y.1.1⁻¹, hm⟩ : Ω F)
          else 0
    rw [one_smul, h_tr_ind, h_sum_eq, Fintype.sum_prod_type]
    simp_rw [h_inner, ← Finset.mul_sum]
    have hHB_ne : (Nat.card H_B : Ω F) ≠ 0 := by
      exact_mod_cast (Nat.card_pos (α := H_B)).ne'
    exact (inv_mul_cancel_left₀ hHB_ne _).symm
  exact ⟨H_B, M_B, ψ_B, hWf, hHB_le_HA, hHB_iff, h_fix_B, hMB_iff, h_mem_B, hψ_B_eq, h_tr_A⟩

theorem ld_ch14_group_double_coset_sum_identities_iff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (G : Type u) [Group G] [Fintype G]
    (H : Subgroup G) (projH : G →* H)
    (hprojH_id : ∀ h : H, projH h.1 = h)
    (N₁ H_L' H_F' : Subgroup H)
    (hHL'_norm : H_L'.Normal)
    (hN₁_le_HL' : N₁ ≤ H_L') (hN₁_le_HF' : N₁ ≤ H_F')
    (hHF'_HL'_inf : ∀ h : H, h ∈ H_F' → h ∈ H_L' → h ∈ N₁)
    (r : ℕ) (c_rep : Fin r → H)
    (hc_rep : ∀ a : Fin r, c_rep a ∈ H_L' ∧ c_rep a ∉ N₁)
    (K_t : Subgroup H) (h_rep : List H)
    (hKt_le_HF' : K_t ≤ H_F')
    (hKt_HL'_iff : ∀ k ∈ K_t, k ∈ H_L' ↔ k ∈ N₁)
    (hh_rep_mem : ∀ b : Fin h_rep.length, h_rep.get b ∈ H_F')
    (hFib_L' : ∀ u : H,
      Nat.card {p : K_t × Fin h_rep.length × H_L' //
        p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1 = u} =
      Nat.card ↥(K_t ⊓ N₁))
    (hFib_F' : ∀ u : H, u ∉ H_F' →
      Nat.card {p : K_t × Fin r × Fin h_rep.length × H_F' //
        p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u} =
      Nat.card ↥(K_t ⊓ N₁))
    (hConj_Kt : ∀ (a : Fin r) (b : Fin h_rep.length) (x : H) (g : H),
      x ∈ H_F' → g ∈ H_F' →
      (((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ↔
        ((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ⊓ N₁))
    (M_Kt : Subgroup G)
    (hM_Kt_iff : ∀ g : G, g ∈ M_Kt ↔ projH g ∈ K_t)
    (ψ'_t : M_Kt →* (Ω F)ˣ) :
    (∀ (g : G), projH g ∈ H_L' →
      (∀ (b : Fin h_rep.length) (y : H_L'),
        ((h_rep.get b)⁻¹ * y.1).1 * g * ((h_rep.get b)⁻¹ * y.1).1⁻¹ ∈ M_Kt ↔
          (h_rep.get b)⁻¹ * y.1 * (projH g) * y.1⁻¹ * (h_rep.get b) ∈ K_t ⊓ N₁) ∧
      (Nat.card K_t : Ω F)⁻¹ *
          (∑ u : H,
            if hm : u.1 * g * u.1⁻¹ ∈ M_Kt then
              (ψ'_t ⟨u.1 * g * u.1⁻¹, hm⟩ : Ω F)
            else 0) =
        ∑ b : Fin h_rep.length,
          (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
            ∑ y : H_L',
              if hm : ((h_rep.get b)⁻¹ * y.1).1 * g * ((h_rep.get b)⁻¹ * y.1).1⁻¹ ∈ M_Kt then
                (ψ'_t ⟨((h_rep.get b)⁻¹ * y.1).1 * g * ((h_rep.get b)⁻¹ * y.1).1⁻¹, hm⟩ : Ω F)
              else 0) ∧
    (∀ (g : G), projH g ∈ H_F' →
      (∀ (a : Fin r) (b : Fin h_rep.length) (y : H_F'),
        ((c_rep a * h_rep.get b)⁻¹ * y.1).1 * g *
            ((c_rep a * h_rep.get b)⁻¹ * y.1).1⁻¹ ∈ M_Kt ↔
          (c_rep a * h_rep.get b)⁻¹ * y.1 * (projH g) * y.1⁻¹ *
            (c_rep a * h_rep.get b) ∈ K_t ⊓ N₁) ∧
      (Nat.card K_t : Ω F)⁻¹ *
          (∑ u : H,
            if hm : u.1 * g * u.1⁻¹ ∈ M_Kt then
              (ψ'_t ⟨u.1 * g * u.1⁻¹, hm⟩ : Ω F)
            else 0) =
        (Nat.card K_t : Ω F)⁻¹ *
            (∑ y : H_F',
              if hm : y.1.1 * g * y.1.1⁻¹ ∈ M_Kt then
                (ψ'_t ⟨y.1.1 * g * y.1.1⁻¹, hm⟩ : Ω F)
              else 0) +
          ∑ a : Fin r, ∑ b : Fin h_rep.length,
            (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
              ∑ y : H_F',
                if hm : ((c_rep a * h_rep.get b)⁻¹ * y.1).1 * g *
                    ((c_rep a * h_rep.get b)⁻¹ * y.1).1⁻¹ ∈ M_Kt then
                  (ψ'_t ⟨((c_rep a * h_rep.get b)⁻¹ * y.1).1 * g *
                    ((c_rep a * h_rep.get b)⁻¹ * y.1).1⁻¹, hm⟩ : Ω F)
                else 0) :=
by
  have hKt_ne : (Nat.card K_t : Ω F) ≠ 0 := by
    exact_mod_cast (Nat.card_pos (α := K_t)).ne'
  have hKtN₁_ne : (Nat.card ↥(K_t ⊓ N₁) : Ω F) ≠ 0 := by
    exact_mod_cast (Nat.card_pos (α := ↥(K_t ⊓ N₁))).ne'
  let f_g (g : G) (u : H) : Ω F :=
    if hm : u.1 * g * u.1⁻¹ ∈ M_Kt then
      (ψ'_t ⟨u.1 * g * u.1⁻¹, hm⟩ : Ω F)
    else 0
  have hf_inv : ∀ (g : G) (k : K_t) (v : H), f_g g (k.1 * v) = f_g g v := by
    intro g k v
    have hk_M : k.1.1 ∈ M_Kt := (hM_Kt_iff k.1.1).mpr ((hprojH_id k.1).symm ▸ k.2)
    have h_conj_eq : (k.1 * v).1 * g * (k.1 * v).1⁻¹ = k.1.1 * (v.1 * g * v.1⁻¹) * k.1.1⁻¹ := by
      simp [mul_assoc]
    have h_mem_iff : (k.1 * v).1 * g * (k.1 * v).1⁻¹ ∈ M_Kt ↔ v.1 * g * v.1⁻¹ ∈ M_Kt := by
      rw [h_conj_eq, Subgroup.mul_mem_cancel_right M_Kt (M_Kt.inv_mem hk_M),
        Subgroup.mul_mem_cancel_left M_Kt hk_M]
    by_cases hm : v.1 * g * v.1⁻¹ ∈ M_Kt
    · have hm' : (k.1 * v).1 * g * (k.1 * v).1⁻¹ ∈ M_Kt := h_mem_iff.mpr hm
      dsimp only [f_g]
      rw [dif_pos hm', dif_pos hm]
      congr 1
      have hsub : (⟨(k.1 * v).1 * g * (k.1 * v).1⁻¹, hm'⟩ : M_Kt) =
          ⟨k.1.1, hk_M⟩ * ⟨v.1 * g * v.1⁻¹, hm⟩ * (⟨k.1.1, hk_M⟩)⁻¹ :=
        Subtype.ext h_conj_eq
      rw [hsub, map_mul, map_mul, map_inv, mul_right_comm, mul_inv_cancel, one_mul]
    · have hm' : (k.1 * v).1 * g * (k.1 * v).1⁻¹ ∉ M_Kt := fun h => hm (h_mem_iff.mp h)
      dsimp only [f_g]
      rw [dif_neg hm', dif_neg hm]
  refine ⟨?_, ?_⟩
  · intro g hg
    refine ⟨?_, ?_⟩
    · intro b y
      let v : H := (h_rep.get b)⁻¹ * y.1
      have hproj_conj : projH (v.1 * g * v.1⁻¹) =
          (h_rep.get b)⁻¹ * y.1 * (projH g) * y.1⁻¹ * (h_rep.get b) := by
        have hv : projH v.1 = v := hprojH_id v
        have hvinv : projH (v.1⁻¹) = v⁻¹ := by rw [map_inv, hv]
        rw [map_mul, map_mul, hv, hvinv]
        simp [v, mul_assoc]
      have h_in_HL' : (h_rep.get b)⁻¹ * y.1 * (projH g) * y.1⁻¹ * (h_rep.get b) ∈ H_L' := by
        have h1 : y.1 * (projH g) * y.1⁻¹ ∈ H_L' :=
          H_L'.mul_mem (H_L'.mul_mem y.2 hg) (H_L'.inv_mem y.2)
        have h2 := hHL'_norm.conj_mem _ h1 (h_rep.get b)⁻¹
        simpa [mul_assoc] using h2
      rw [hM_Kt_iff, hproj_conj, Subgroup.mem_inf]
      exact ⟨fun hk => ⟨hk, (hKt_HL'_iff _ hk).mp h_in_HL'⟩, fun h => h.1⟩
    · change (Nat.card K_t : Ω F)⁻¹ * (∑ u : H, f_g g u) =
        ∑ b : Fin h_rep.length,
          (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
            ∑ y : H_L', f_g g ((h_rep.get b)⁻¹ * y.1)
      let Φ_L' : K_t × Fin h_rep.length × H_L' → H :=
        fun p => p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1
      have hSum_fib_L' :
          (∑ p : K_t × Fin h_rep.length × H_L', f_g g (Φ_L' p)) =
            (Nat.card ↥(K_t ⊓ N₁) : Ω F) * ∑ u : H, f_g g u := by
        rw [← Fintype.sum_fiberwise' Φ_L' (f_g g), Finset.mul_sum]
        refine Finset.sum_congr rfl fun u _ => ?_
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
        dsimp only [Φ_L']
        rw [hFib_L' u]
      have hSum_prod_L' :
          (∑ p : K_t × Fin h_rep.length × H_L', f_g g (Φ_L' p)) =
            (Nat.card K_t : Ω F) *
              ∑ b : Fin h_rep.length, ∑ y : H_L', f_g g ((h_rep.get b)⁻¹ * y.1) := by
        rw [Fintype.sum_prod_type]
        have h_inner : ∀ k : K_t,
            (∑ x : Fin h_rep.length × H_L', f_g g (Φ_L' (k, x))) =
              ∑ b : Fin h_rep.length, ∑ y : H_L', f_g g ((h_rep.get b)⁻¹ * y.1) := by
          intro k
          rw [Fintype.sum_prod_type]
          refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun y _ => ?_
          dsimp only [Φ_L']
          rw [mul_assoc]
          exact hf_inv g k ((h_rep.get b)⁻¹ * y.1)
        simp_rw [h_inner]
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
      rw [← Finset.mul_sum]
      have h_eq := hSum_fib_L'.symm.trans hSum_prod_L'
      calc (Nat.card K_t : Ω F)⁻¹ * (∑ u : H, f_g g u)
          = (Nat.card K_t : Ω F)⁻¹ * ((Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
              ((Nat.card ↥(K_t ⊓ N₁) : Ω F) * (∑ u : H, f_g g u))) := by
            rw [inv_mul_cancel_left₀ hKtN₁_ne]
        _ = (Nat.card K_t : Ω F)⁻¹ * ((Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
              ((Nat.card K_t : Ω F) *
                ∑ b : Fin h_rep.length, ∑ y : H_L', f_g g ((h_rep.get b)⁻¹ * y.1))) := by
            rw [h_eq]
        _ = (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
              ∑ b : Fin h_rep.length, ∑ y : H_L', f_g g ((h_rep.get b)⁻¹ * y.1) := by
            rw [← mul_assoc, mul_right_comm (Nat.card K_t : Ω F)⁻¹, inv_mul_cancel_left₀ hKt_ne,
              mul_comm]
  · intro g hg
    refine ⟨?_, ?_⟩
    · intro a b y
      let v : H := (c_rep a * h_rep.get b)⁻¹ * y.1
      have hproj_conj : projH (v.1 * g * v.1⁻¹) = v * (projH g) * v⁻¹ := by
        rw [map_mul, map_mul, map_inv, hprojH_id v]
      have h_conj_iff : v * (projH g) * v⁻¹ ∈ K_t ↔ v * (projH g) * v⁻¹ ∈ K_t ⊓ N₁ :=
        hConj_Kt a b y.1 (projH g) y.2 hg
      rw [hM_Kt_iff, hproj_conj, h_conj_iff]
      have hv_eq : v * (projH g) * v⁻¹ =
          (c_rep a * h_rep.get b)⁻¹ * y.1 * (projH g) * y.1⁻¹ * (c_rep a * h_rep.get b) := by
        simp [v, mul_assoc]
      rw [hv_eq]
    · change (Nat.card K_t : Ω F)⁻¹ * (∑ u : H, f_g g u) =
        (Nat.card K_t : Ω F)⁻¹ * (∑ y : H_F', f_g g y.1) +
          ∑ a : Fin r, ∑ b : Fin h_rep.length,
            (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
              ∑ y : H_F', f_g g ((c_rep a * h_rep.get b)⁻¹ * y.1)
      have hPhi_not_mem : ∀ p : K_t × Fin r × Fin h_rep.length × H_F',
          p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 ∉ H_F' := by
        intro p hu
        have h_c_inv : (c_rep p.2.1)⁻¹ =
            (h_rep.get p.2.2.1) * p.1.1⁻¹ *
              (p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1) * p.2.2.2.1⁻¹ := by
          group
        have h_c_inv_mem : (c_rep p.2.1)⁻¹ ∈ H_F' := by
          rw [h_c_inv]
          exact H_F'.mul_mem
            (H_F'.mul_mem
              (H_F'.mul_mem (hh_rep_mem p.2.2.1) (H_F'.inv_mem (hKt_le_HF' p.1.2)))
              hu)
            (H_F'.inv_mem p.2.2.2.2)
        have hc_HF' : c_rep p.2.1 ∈ H_F' := H_F'.inv_mem_iff.mp h_c_inv_mem
        exact (hc_rep p.2.1).2 (hHF'_HL'_inf (c_rep p.2.1) hc_HF' (hc_rep p.2.1).1)
      let Φ_F' : K_t × Fin r × Fin h_rep.length × H_F' → {u : H // u ∉ H_F'} :=
        fun p => ⟨p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1, hPhi_not_mem p⟩
      have hSum_fib_F' :
          (∑ p : K_t × Fin r × Fin h_rep.length × H_F', f_g g (Φ_F' p).1) =
            (Nat.card ↥(K_t ⊓ N₁) : Ω F) * ∑ u : {u : H // u ∉ H_F'}, f_g g u.1 := by
        rw [← Fintype.sum_fiberwise' Φ_F' (fun u : {u : H // u ∉ H_F'} => f_g g u.1),
          Finset.mul_sum]
        refine Finset.sum_congr rfl fun u _ => ?_
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
        have hcard_eq : Nat.card {p : K_t × Fin r × Fin h_rep.length × H_F' // Φ_F' p = u} =
            Nat.card {p : K_t × Fin r × Fin h_rep.length × H_F' //
              p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u.1} :=
          Nat.card_congr (Equiv.subtypeEquivRight fun p => Subtype.ext_iff)
        rw [hcard_eq, hFib_F' u.1 u.2]
      have hSum_prod_F' :
          (∑ p : K_t × Fin r × Fin h_rep.length × H_F', f_g g (Φ_F' p).1) =
            (Nat.card K_t : Ω F) *
              ∑ a : Fin r, ∑ b : Fin h_rep.length, ∑ y : H_F',
                f_g g ((c_rep a * h_rep.get b)⁻¹ * y.1) := by
        rw [Fintype.sum_prod_type]
        have h_inner : ∀ k : K_t,
            (∑ x : Fin r × Fin h_rep.length × H_F', f_g g (Φ_F' (k, x)).1) =
              ∑ a : Fin r, ∑ b : Fin h_rep.length, ∑ y : H_F',
                f_g g ((c_rep a * h_rep.get b)⁻¹ * y.1) := by
          intro k
          rw [Fintype.sum_prod_type]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [Fintype.sum_prod_type]
          refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun y _ => ?_
          dsimp only [Φ_F']
          rw [mul_assoc]
          exact hf_inv g k ((c_rep a * h_rep.get b)⁻¹ * y.1)
        simp_rw [h_inner]
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
      have h_comp_eq :
          (Nat.card K_t : Ω F)⁻¹ * (∑ u : {u : H // u ∉ H_F'}, f_g g u.1) =
            ∑ a : Fin r, ∑ b : Fin h_rep.length,
              (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
                ∑ y : H_F', f_g g ((c_rep a * h_rep.get b)⁻¹ * y.1) := by
        simp_rw [← Finset.mul_sum]
        have h_eq := hSum_fib_F'.symm.trans hSum_prod_F'
        calc (Nat.card K_t : Ω F)⁻¹ * (∑ u : {u : H // u ∉ H_F'}, f_g g u.1)
            = (Nat.card K_t : Ω F)⁻¹ * ((Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
                ((Nat.card ↥(K_t ⊓ N₁) : Ω F) * (∑ u : {u : H // u ∉ H_F'}, f_g g u.1))) := by
              rw [inv_mul_cancel_left₀ hKtN₁_ne]
          _ = (Nat.card K_t : Ω F)⁻¹ * ((Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
                ((Nat.card K_t : Ω F) *
                  ∑ a : Fin r, ∑ b : Fin h_rep.length, ∑ y : H_F',
                    f_g g ((c_rep a * h_rep.get b)⁻¹ * y.1))) := by
              rw [h_eq]
          _ = (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
                ∑ a : Fin r, ∑ b : Fin h_rep.length, ∑ y : H_F',
                  f_g g ((c_rep a * h_rep.get b)⁻¹ * y.1) := by
              rw [← mul_assoc, mul_right_comm (Nat.card K_t : Ω F)⁻¹, inv_mul_cancel_left₀ hKt_ne,
                mul_comm]
      have h_part :
          (∑ u : H, f_g g u) =
            (∑ y : H_F', f_g g y.1) + (∑ u : {u : H // u ∉ H_F'}, f_g g u.1) := by
        rw [← Fintype.sum_subtype_add_sum_subtype (fun u : H => u ∈ H_F') (f_g g)]
      rw [h_part, mul_add, h_comp_eq]

theorem ld_ch14_single_orbit_base_conj_and_trace_bridge_iff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E F' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hLF' : L ≤ F') (hF'K : F' ≤ K)
    (ψ : AddChar L (Ω F)) (χL_ext : relWeil F L →* (Ω F)ˣ)
    (htr_F' : ∀ (B : IntermediateField F (AlgebraicClosure F)) (hF'B : F' ≤ B),
      traceChar F (hLF'.trans hF'B) ψ = traceChar F hF'B (traceChar F hLF' ψ))
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal]
    (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
    (projH : (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) →* H)
    (hprojH_id : ∀ h : H, projH h.1 = h)
    (hprojH_sub : ∀ (S : Subgroup H)
      (g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      projH g ∈ S ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c)
    (N₁ H_L' H_F' H₀ : Subgroup H)
    (h_mem_F' : ∀ w : relWeil F L,
      w ∈ (relWeil F F').subgroupOf (relWeil F L) ↔ ∃ h ∈ H_F', ∃ c ∈ C, π w = h.1 * c)
    (h_fix_F' : ∀ x : IntermediateField.extendScalars hLK,
      (x : AlgebraicClosure F) ∈ F' ↔ ∀ h ∈ H_F', ∀ c ∈ C, (h.1 * c) x = x)
    (r : ℕ) (c_rep : Fin r → H)
    (hCoset_decomp : ∀ (H_t : Subgroup H),
      (∀ h ∈ H_t, h ∈ H₀ → h = 1) →
      ∃ (c_t : H) (K_t : Subgroup H) (h_rep : List H),
        c_t ∈ H₀ ∧
        (∀ h : H, h ∈ K_t ↔ c_t⁻¹ * h * c_t ∈ H_t) ∧
        K_t ≤ H_F' ∧
        (∀ k ∈ K_t, k ∈ H_L' ↔ k ∈ N₁) ∧
        (∀ b : Fin h_rep.length, h_rep.get b ∈ H_F') ∧
        (∀ u : H,
          Nat.card {p : K_t × Fin h_rep.length × H_L' //
            p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1 = u} =
          Nat.card ↥(K_t ⊓ N₁)) ∧
        (∀ u : H, u ∉ H_F' →
          Nat.card {p : K_t × Fin r × Fin h_rep.length × H_F' //
            p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u} =
          Nat.card ↥(K_t ⊓ N₁)) ∧
        (∀ (a : Fin r) (b : Fin h_rep.length) (x : H) (g : H),
          x ∈ H_F' → g ∈ H_F' →
          (((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ↔
            ((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ⊓ N₁)))
    (hConjEval : ∀ (F_s : IntermediateField F (AlgebraicClosure F))
      (hLFs : L ≤ F_s) (hFsMC : F_s ≤ M_C)
      (χ_s : relWeil F F_s →* (Ω F)ˣ),
      IsWeilRep F F_s (charRep F F_s χ_s) →
      χ_s ^ (p F) = 1 →
      restrictWeilChar F (hFsMC.trans hM_CK) χ_s = 1 →
      (∃ hsE : F_s ≤ E ⊔ F_s, restrictWeilChar F hsE χ_s = 1) →
      restrictWeilChar F hFsMC χ_s ≠ 1 →
      ∀ (g : relWeil F L), (g : AbsGal F) ∈ E.fixingSubgroup →
      let γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F := (g : AbsGal F)
      let F_g : IntermediateField F (AlgebraicClosure F) := F_s.map γ
      ∃ (hLFg : L ≤ F_g) (hFgMC : F_g ≤ M_C)
        (χ_g : relWeil F F_g →* (Ω F)ˣ),
        (∀ (w : relWeil F F_g)
          (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F F_s),
          χ_g w = χ_s ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩) ∧
        (∀ x : AlgebraicClosure F, x ∈ F_g ↔ (g : AbsGal F)⁻¹ x ∈ F_s) ∧
        IsWeilRep F F_g (charRep F F_g χ_g) ∧
        χ_g ^ (p F) = 1 ∧
        restrictWeilChar F (hFgMC.trans hM_CK) χ_g = 1 ∧
        (∃ hgE' : F_g ≤ E ⊔ F_g, restrictWeilChar F hgE' χ_g = 1) ∧
        restrictWeilChar F hFgMC χ_g ≠ 1 ∧
        tateEpsUnit F F_g (recChar F rec F_g χ_g) (traceChar F hLFg ψ) =
          tateEpsUnit F F_s (recChar F rec F_s χ_s) (traceChar F hLFs ψ) ∧
        tateEpsUnit F F_g
            (recChar F rec F_g (χ_g * restrictWeilChar F hLFg χL_ext))
            (traceChar F hLFg ψ) =
          tateEpsUnit F F_s
            (recChar F rec F_s (χ_s * restrictWeilChar F hLFs χL_ext))
            (traceChar F hLFs ψ))
    (hTraceH : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hAB : A ≤ B) (hBMC : B ≤ M_C)
      (H_A : Subgroup H),
      (∀ w : relWeil F L,
        w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ projH (π w) ∈ H_A) →
      ∀ (χ_B : relWeil F B →* (Ω F)ˣ),
        restrictWeilChar F (hBMC.trans hM_CK) χ_B = 1 →
        ∃ (H_B : Subgroup H)
          (M_B : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
          (ψ_B : M_B →* (Ω F)ˣ),
          (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).Wf F A ∧
          H_B ≤ H_A ∧
          (∀ h : H, h ∈ H_B ↔
            ∀ x : IntermediateField.extendScalars hLK,
              (x : AlgebraicClosure F) ∈ B → h.1 x = x) ∧
          (∀ x : IntermediateField.extendScalars hLK,
            (x : AlgebraicClosure F) ∈ B ↔ ∀ h ∈ H_B, ∀ c ∈ C, (h.1 * c) x = x) ∧
          (∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
            g ∈ M_B ↔ projH g ∈ H_B) ∧
          (∀ w : relWeil F L,
            w ∈ (relWeil F B).subgroupOf (relWeil F L) ↔ π w ∈ M_B) ∧
          (∀ (w_B : relWeil F B)
            (hm : π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) ∈ M_B),
            χ_B w_B = ψ_B ⟨π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B), hm⟩) ∧
          ∀ w : relWeil F A,
            (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).trace F A w =
              (Nat.card H_B : Ω F)⁻¹ *
                ∑ y : H_A,
                  if hm : y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLA) w) * y.1.1⁻¹ ∈ M_B then
                    (ψ_B ⟨y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLA) w) * y.1.1⁻¹, hm⟩ : Ω F)
                  else 0)
    (t : MonomialTerm F L)
    (ht_wf : t.Wf F L)
    (ht_props :
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (ht_disj : ∀ h ∈ H₀,
      (∀ x : IntermediateField.extendScalars hLK,
        (x : AlgebraicClosure F) ∈ t.field → h.1 x = x) →
      h = 1) :
    ∃ (F'_t : IntermediateField F (AlgebraicClosure F))
      (hLF'_t : L ≤ F'_t) (hF'_tMC : F'_t ≤ M_C)
      (χ'_t : relWeil F F'_t →* (Ω F)ˣ)
      (K_t : Subgroup H) (h_rep : List H)
      (M_Kt : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
      (ψ'_t : M_Kt →* (Ω F)ˣ)
      (t_F'0 : MonomialTerm F F'),
      IsWeilRep F F'_t (charRep F F'_t χ'_t) ∧
      χ'_t ^ (p F) = 1 ∧
      restrictWeilChar F (hF'_tMC.trans hM_CK) χ'_t = 1 ∧
      (∃ hgE' : F'_t ≤ E ⊔ F'_t, restrictWeilChar F hgE' χ'_t = 1) ∧
      restrictWeilChar F hF'_tMC χ'_t ≠ 1 ∧
      K_t ≤ H_F' ∧
      (∀ k ∈ K_t, k ∈ H_L' ↔ k ∈ N₁) ∧
      (∀ b : Fin h_rep.length, h_rep.get b ∈ H_F') ∧
      (∀ u : H,
        Nat.card {p : K_t × Fin h_rep.length × H_L' //
          p.1.1 * (h_rep.get p.2.1)⁻¹ * p.2.2.1 = u} =
        Nat.card ↥(K_t ⊓ N₁)) ∧
      (∀ u : H, u ∉ H_F' →
        Nat.card {p : K_t × Fin r × Fin h_rep.length × H_F' //
          p.1.1 * (c_rep p.2.1 * h_rep.get p.2.2.1)⁻¹ * p.2.2.2.1 = u} =
        Nat.card ↥(K_t ⊓ N₁)) ∧
      (∀ (a : Fin r) (b : Fin h_rep.length) (x : H) (g : H),
        x ∈ H_F' → g ∈ H_F' →
        (((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ↔
          ((c_rep a * h_rep.get b)⁻¹ * x) * g * ((c_rep a * h_rep.get b)⁻¹ * x)⁻¹ ∈ K_t ⊓ N₁)) ∧
      (∀ h : H, h ∈ K_t ↔
        ∀ x : IntermediateField.extendScalars hLK,
          (x : AlgebraicClosure F) ∈ F'_t → h.1 x = x) ∧
      (∀ x : IntermediateField.extendScalars hLK,
        (x : AlgebraicClosure F) ∈ F'_t ↔ ∀ k ∈ K_t, ∀ c ∈ C, (k.1 * c) x = x) ∧
      (∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
        g ∈ M_Kt ↔ projH g ∈ K_t) ∧
      (∀ w : relWeil F L,
        w ∈ (relWeil F F'_t).subgroupOf (relWeil F L) ↔ π w ∈ M_Kt) ∧
      (∀ (w_B : relWeil F F'_t)
        (hm : π (Subgroup.inclusion (relWeil_antitone F hLF'_t) w_B) ∈ M_Kt),
        χ'_t w_B = ψ'_t ⟨π (Subgroup.inclusion (relWeil_antitone F hLF'_t) w_B), hm⟩) ∧
      t_F'0.Wf F F' ∧
      t_F'0.field ≤ K ∧
      (∀ w : relWeil F F',
        t_F'0.trace F F' w =
          (Nat.card K_t : Ω F)⁻¹ *
            ∑ y : H_F',
              if hm : y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLF') w) * y.1.1⁻¹ ∈ M_Kt then
                (ψ'_t ⟨y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLF') w) * y.1.1⁻¹, hm⟩ : Ω F)
              else 0) ∧
      evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ) t_F'0 =
        evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t ∧
      evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)
          (twistMonomialTerm F F' (restrictWeilChar F hLF' χL_ext) t_F'0) =
        evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext t) ∧
      ∀ w_L : relWeil F L,
        t.trace F L w_L =
          (Nat.card K_t : Ω F)⁻¹ *
            ∑ u : H,
              if hm : u.1 * π w_L * u.1⁻¹ ∈ M_Kt then
                (ψ'_t ⟨u.1 * π w_L * u.1⁻¹, hm⟩ : Ω F)
              else 0 :=
by
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  have hprojH_conj : ∀ (γ : H) (m : G), projH (γ.1⁻¹ * m * γ.1) = γ⁻¹ * projH m * γ := by
    intro γ m
    rw [map_mul, map_mul, ← Subgroup.coe_inv, hprojH_id, hprojH_id]
  
  obtain ⟨ht_coeff, _, ht_MC, ht_pow, ⟨htK, ht_restK⟩, ht_restE, ht_neMC⟩ := ht_props
  have ht_restK' : restrictWeilChar F (ht_MC.trans hM_CK) t.χ = 1 := ht_restK
  have h_proj_L : ∀ w : relWeil F L,
      w ∈ (relWeil F L).subgroupOf (relWeil F L) ↔ projH (π w) ∈ (⊤ : Subgroup H) := by
    intro w
    simp [Subgroup.mem_subgroupOf]
  obtain ⟨H_t, M_t, ψ_t, _, _, hHt_mem, hFt_fix, hMt_mem, hWt_mem, hχt_eq, ht_tr_top⟩ :=
    hTraceH L t.field le_rfl t.le ht_MC ⊤ h_proj_L t.χ ht_restK'
  have hHt_disj : ∀ h ∈ H_t, h ∈ H₀ → h = 1 :=
    fun h hht hh₀ => ht_disj h hh₀ ((hHt_mem h).mp hht)
  obtain ⟨c_t, K_t, h_rep, hc_t_mem, hKt_iff, hKt_le_HF', hKt_HL'_iff,
      hh_rep_mem, hFib_L', hFib_F', hConj_Kt⟩ :=
    hCoset_decomp H_t hHt_disj
  
  let g_ct : relWeil F L := (hsurj c_t.1).choose
  have hg_ct_π : π g_ct = c_t.1 := (hsurj c_t.1).choose_spec
  have hg_ct_E : (g_ct : AbsGal F) ∈ E.fixingSubgroup := by
    have h1 : π g_ct ∈ H := by rw [hg_ct_π]; exact c_t.2
    exact ((h_mem_H g_ct).mpr h1).2
  have hg_ct_inv : ∀ x : K',
      (g_ct : AbsGal F)⁻¹ (x : AlgebraicClosure F) = ((c_t.1⁻¹ x : K') : AlgebraicClosure F) := by
    intro x
    have h1 := hπ g_ct (c_t.1⁻¹ x)
    have hcx : c_t.1 (c_t.1⁻¹ x) = x := AlgEquiv.apply_symm_apply c_t.1 x
    rw [hg_ct_π, hcx] at h1
    calc (g_ct : AbsGal F)⁻¹ (x : AlgebraicClosure F)
        = (g_ct : AbsGal F)⁻¹ ((g_ct : AbsGal F) ((c_t.1⁻¹ x : K') : AlgebraicClosure F)) := by
          rw [← h1]
      _ = ((c_t.1⁻¹ x : K') : AlgebraicClosure F) :=
          (g_ct : AbsGal F).symm_apply_apply _
  let γ_ct : AlgebraicClosure F →ₐ[F] AlgebraicClosure F := (g_ct : AbsGal F)
  let F'_t : IntermediateField F (AlgebraicClosure F) := t.field.map γ_ct
  obtain ⟨hLF'_t, hF'_tMC, χ'_t, hχ'_t_apply, hF'_t_mem, hχ'_t_weil, hχ'_t_pow,
      hχ'_t_restK, hχ'_t_restE, hχ'_t_neMC, heps_F'_t_un, heps_F'_t_tw⟩ :=
    hConjEval t.field t.le ht_MC t.χ ht_wf.2.2 ht_pow ht_restK' ht_restE (ht_neMC ht_MC) g_ct hg_ct_E
  
  have hF'F'_t : F' ≤ F'_t := by
    intro z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hF'K hz)⟩
    rw [hF'_t_mem z]
    have h_inv_z : (g_ct : AbsGal F)⁻¹ z = ((c_t.1⁻¹ x : K') : AlgebraicClosure F) :=
      hg_ct_inv x
    rw [h_inv_z, hFt_fix (c_t.1⁻¹ x)]
    intro h₀ hh₀ c hc
    let k : H := c_t * h₀ * c_t⁻¹
    have hk_Kt : k ∈ K_t := by
      rw [hKt_iff]
      have heq : c_t⁻¹ * k * c_t = h₀ := by dsimp [k]; group
      rw [heq]
      exact hh₀
    have hk_HF' : k ∈ H_F' := hKt_le_HF' hk_Kt
    let c' : G := c_t.1 * c * c_t.1⁻¹
    have hc' : c' ∈ C := Subgroup.Normal.conj_mem ‹C.Normal› c hc c_t.1
    have hfix_x : (k.1 * c') x = x := (h_fix_F' x).mp hz k hk_HF' c' hc'
    have hmul_eq : k.1 * c' = c_t.1 * (h₀.1 * c) * c_t.1⁻¹ := by
      change (c_t.1 * h₀.1 * c_t.1⁻¹) * (c_t.1 * c * c_t.1⁻¹) = c_t.1 * (h₀.1 * c) * c_t.1⁻¹
      group
    rw [hmul_eq] at hfix_x
    calc (h₀.1 * c) (c_t.1⁻¹ x)
        = c_t.1⁻¹ ((c_t.1 * (h₀.1 * c) * c_t.1⁻¹) x) := by
          change ((h₀.1 * c) * c_t.1⁻¹) x = (c_t.1⁻¹ * (c_t.1 * (h₀.1 * c) * c_t.1⁻¹)) x
          congr 1; group
      _ = c_t.1⁻¹ x := by rw [hfix_x]
  
  have h_proj_F' : ∀ w : relWeil F L,
      w ∈ (relWeil F F').subgroupOf (relWeil F L) ↔ projH (π w) ∈ H_F' :=
    fun w => (h_mem_F' w).trans (hprojH_sub H_F' (π w)).symm
  obtain ⟨H_F'_t, M_Kt, ψ'_t, ht_F'0_wf, _, hHF'_t_mem, hF'_t_fix',
      hMKt_mem, hWF'_t_mem, hχ'_t_eq, ht_F'0_tr⟩ :=
    hTraceH F' F'_t hLF' hF'F'_t hF'_tMC H_F' h_proj_F' χ'_t hχ'_t_restK
  have hHF'_t_eq_Kt : H_F'_t = K_t := by
    apply Subgroup.ext
    intro h
    rw [hHF'_t_mem h, hKt_iff h, hHt_mem (c_t⁻¹ * h * c_t)]
    constructor
    · intro hh y hy
      let x : K' := c_t.1 y
      have hx_inv : c_t.1⁻¹ x = y := AlgEquiv.symm_apply_apply c_t.1 y
      have hx_F'_t : (x : AlgebraicClosure F) ∈ F'_t := by
        rw [hF'_t_mem (x : AlgebraicClosure F), hg_ct_inv x, hx_inv]
        exact hy
      have hhx : h.1 x = x := hh x hx_F'_t
      calc (c_t⁻¹ * h * c_t).1 y
          = c_t.1⁻¹ (h.1 x) := rfl
        _ = c_t.1⁻¹ x := by rw [hhx]
        _ = y := hx_inv
    · intro hh x hx
      have hy : ((c_t.1⁻¹ x : K') : AlgebraicClosure F) ∈ t.field := by
        rw [← hg_ct_inv x]
        exact (hF'_t_mem (x : AlgebraicClosure F)).mp hx
      have hhy : (c_t⁻¹ * h * c_t).1 (c_t.1⁻¹ x) = c_t.1⁻¹ x := hh (c_t.1⁻¹ x) hy
      calc h.1 x
          = c_t.1 ((c_t⁻¹ * h * c_t).1 (c_t.1⁻¹ x)) := by
            change h.1 x = (c_t.1 * (c_t.1⁻¹ * h.1 * c_t.1) * c_t.1⁻¹) x
            congr 1; group
        _ = c_t.1 (c_t.1⁻¹ x) := by rw [hhy]
        _ = x := AlgEquiv.apply_symm_apply c_t.1 x
  rw [hHF'_t_eq_Kt] at hHF'_t_mem hF'_t_fix' hMKt_mem ht_F'0_tr
  
  let t_F'0 : MonomialTerm F F' := ⟨1, F'_t, hF'F'_t, χ'_t⟩
  have ht_eq : t = ⟨1, t.field, t.le, t.χ⟩ := by
    cases t
    dsimp at ht_coeff
    subst ht_coeff
    rfl
  have heval_tF'0_un :
      evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ) t_F'0 =
        evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t := by
    change (tateEpsUnit F F'_t (recChar F rec F'_t χ'_t)
        (traceChar F hF'F'_t (traceChar F hLF' ψ)) * 1) ^ (1 : ℤ) =
      (tateEpsUnit F t.field (recChar F rec t.field t.χ)
        (traceChar F t.le ψ) * 1) ^ t.coeff
    rw [ht_coeff, mul_one, mul_one, zpow_one, zpow_one, ← htr_F' F'_t hF'F'_t]
    exact heps_F'_t_un
  have heval_tF'0_tw :
      evalMonomialTerm F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)
          (twistMonomialTerm F F' (restrictWeilChar F hLF' χL_ext) t_F'0) =
        evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext t) := by
    have hrest_eq : restrictWeilChar F hF'F'_t (restrictWeilChar F hLF' χL_ext) =
        restrictWeilChar F hLF'_t χL_ext := rfl
    change (tateEpsUnit F F'_t
        (recChar F rec F'_t (χ'_t * restrictWeilChar F hF'F'_t (restrictWeilChar F hLF' χL_ext)))
        (traceChar F hF'F'_t (traceChar F hLF' ψ)) * 1) ^ (1 : ℤ) =
      (tateEpsUnit F t.field
        (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext))
        (traceChar F t.le ψ) * 1) ^ t.coeff
    rw [ht_coeff, mul_one, mul_one, zpow_one, zpow_one, hrest_eq, ← htr_F' F'_t hF'F'_t]
    exact heps_F'_t_tw
  
  have hMKt_iff_Mt : ∀ m : G, m ∈ M_Kt ↔ c_t.1⁻¹ * m * c_t.1 ∈ M_t := by
    intro m
    rw [hMKt_mem m, hMt_mem (c_t.1⁻¹ * m * c_t.1), hprojH_conj c_t m, hKt_iff (projH m)]
  have hψ'_t_eq_ψ_t : ∀ (m : G) (hm : m ∈ M_Kt),
      ψ'_t ⟨m, hm⟩ = ψ_t ⟨c_t.1⁻¹ * m * c_t.1, (hMKt_iff_Mt m).mp hm⟩ := by
    intro m hm
    have hm' : c_t.1⁻¹ * m * c_t.1 ∈ M_t := (hMKt_iff_Mt m).mp hm
    let w₀ : relWeil F L := (hsurj m).choose
    have hw₀_π : π w₀ = m := (hsurj m).choose_spec
    have hw₀_F'_t : w₀ ∈ (relWeil F F'_t).subgroupOf (relWeil F L) :=
      (hWF'_t_mem w₀).mpr (hw₀_π.symm ▸ hm)
    let w_B : relWeil F F'_t := ⟨w₀.1, hw₀_F'_t⟩
    have hw_B_inc : Subgroup.inclusion (relWeil_antitone F hLF'_t) w_B = w₀ := Subtype.ext rfl
    have hm_B : π (Subgroup.inclusion (relWeil_antitone F hLF'_t) w_B) ∈ M_Kt := by
      rw [hw_B_inc, hw₀_π]; exact hm
    let w_conj : relWeil F L := g_ct⁻¹ * w₀ * g_ct
    have hw_conj_π : π w_conj = c_t.1⁻¹ * m * c_t.1 := by
      change π (g_ct⁻¹ * w₀ * g_ct) = c_t.1⁻¹ * m * c_t.1
      rw [map_mul, map_mul, map_inv, hg_ct_π, hw₀_π]
    have hw_conj_t : w_conj ∈ (relWeil F t.field).subgroupOf (relWeil F L) :=
      (hWt_mem w_conj).mpr (hw_conj_π.symm ▸ hm')
    have hw_conj_mem :
        (g_ct : AbsGal F)⁻¹ * (w_B : AbsGal F) * (g_ct : AbsGal F) ∈ relWeil F t.field :=
      hw_conj_t
    let w_t : relWeil F t.field :=
      ⟨(g_ct : AbsGal F)⁻¹ * (w_B : AbsGal F) * (g_ct : AbsGal F), hw_conj_mem⟩
    have hw_t_inc : Subgroup.inclusion (relWeil_antitone F (le_rfl.trans t.le)) w_t = w_conj :=
      Subtype.ext rfl
    have hm_t : π (Subgroup.inclusion (relWeil_antitone F (le_rfl.trans t.le)) w_t) ∈ M_t := by
      rw [hw_t_inc, hw_conj_π]; exact hm'
    have h1 : ψ'_t ⟨m, hm⟩ = χ'_t w_B := by
      rw [hχ'_t_eq w_B hm_B]
      congr 1; apply Subtype.ext; dsimp only
      rw [hw_B_inc, hw₀_π]
    have h2 : χ'_t w_B = t.χ w_t := hχ'_t_apply w_B hw_conj_mem
    have h3 : t.χ w_t = ψ_t ⟨c_t.1⁻¹ * m * c_t.1, hm'⟩ := by
      rw [hχt_eq w_t hm_t]
      congr 1; apply Subtype.ext; dsimp only
      rw [hw_t_inc, hw_conj_π]
    exact h1.trans (h2.trans h3)
  let e_Kt : K_t ≃ H_t :=
    { toFun := fun k => ⟨c_t⁻¹ * k.1 * c_t, (hKt_iff k.1).mp k.2⟩
      invFun := fun h => ⟨c_t * h.1 * c_t⁻¹, (hKt_iff (c_t * h.1 * c_t⁻¹)).mpr (by
        have heq : c_t⁻¹ * (c_t * h.1 * c_t⁻¹) * c_t = h.1 := by group
        rw [heq]; exact h.2)⟩
      left_inv := fun k => Subtype.ext (by dsimp only; group)
      right_inv := fun h => Subtype.ext (by dsimp only; group) }
  have hcard_Kt : Nat.card K_t = Nat.card H_t := Nat.card_congr e_Kt
  let e_top : (⊤ : Subgroup H) ≃ H :=
    { toFun := fun y => c_t * y.1
      invFun := fun u => ⟨c_t⁻¹ * u, trivial⟩
      left_inv := fun y => Subtype.ext (by dsimp only; group)
      right_inv := fun u => by dsimp only; group }
  have ht_tr_H : ∀ w_L : relWeil F L,
      t.trace F L w_L =
        (Nat.card K_t : Ω F)⁻¹ *
          ∑ u : H,
            if hm : u.1 * π w_L * u.1⁻¹ ∈ M_Kt then
              (ψ'_t ⟨u.1 * π w_L * u.1⁻¹, hm⟩ : Ω F)
            else 0 := by
    intro w_L
    have htr1 := ht_tr_top w_L
    rw [← ht_eq] at htr1
    have hinc_id : Subgroup.inclusion (relWeil_antitone F le_rfl) w_L = w_L := Subtype.ext rfl
    rw [hinc_id, ← hcard_Kt] at htr1
    rw [htr1]
    congr 1
    refine Fintype.sum_equiv e_top _ _ (fun y => ?_)
    let u : H := e_top y
    let m_u : G := u.1 * π w_L * u.1⁻¹
    let m_y : G := y.1.1 * π w_L * y.1.1⁻¹
    have hconj_eq : c_t.1⁻¹ * m_u * c_t.1 = m_y := by
      change c_t.1⁻¹ * ((c_t.1 * y.1.1) * π w_L * (c_t.1 * y.1.1)⁻¹) * c_t.1 =
        y.1.1 * π w_L * y.1.1⁻¹
      group
    by_cases hm : m_u ∈ M_Kt
    · have hm_y : m_y ∈ M_t := hconj_eq ▸ (hMKt_iff_Mt m_u).mp hm
      change (if hm_y' : m_y ∈ M_t then (ψ_t ⟨m_y, hm_y'⟩ : Ω F) else 0) =
        (if hm' : m_u ∈ M_Kt then (ψ'_t ⟨m_u, hm'⟩ : Ω F) else 0)
      rw [dif_pos hm_y, dif_pos hm, hψ'_t_eq_ψ_t m_u hm]
      congr 1; congr 1
      exact Subtype.ext hconj_eq.symm
    · have hm_y : m_y ∉ M_t := fun hy => hm ((hMKt_iff_Mt m_u).mpr (hconj_eq.symm ▸ hy))
      change (if hm_y' : m_y ∈ M_t then (ψ_t ⟨m_y, hm_y'⟩ : Ω F) else 0) =
        (if hm' : m_u ∈ M_Kt then (ψ'_t ⟨m_u, hm'⟩ : Ω F) else 0)
      rw [dif_neg hm_y, dif_neg hm]
  exact ⟨F'_t, hLF'_t, hF'_tMC, χ'_t, K_t, h_rep, M_Kt, ψ'_t, t_F'0,
    hχ'_t_weil, hχ'_t_pow, hχ'_t_restK, hχ'_t_restE, hχ'_t_neMC,
    hKt_le_HF', hKt_HL'_iff, hh_rep_mem, hFib_L', hFib_F', hConj_Kt,
    hHF'_t_mem, hF'_t_fix', hMKt_mem, hWF'_t_mem, hχ'_t_eq,
    ht_F'0_wf, hF'_tMC.trans hM_CK, ht_F'0_tr,
    heval_tF'0_un, heval_tF'0_tw, ht_tr_H⟩

theorem ld_ch14_sup_M1_compositum_restriction_and_fixing_subgroup (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E L' M₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hLL' : L ≤ L') (hL'M₁ : L' ≤ M₁) (hM₁MC : M₁ ≤ M_C)
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal]
    (projH : (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) →* H)
    (hprojH_id : ∀ h : H, projH h.1 = h)
    (hprojH_sub : ∀ (S : Subgroup H)
      (g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      projH g ∈ S ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c)
    (N₁ : Subgroup H)
    (h_mem_M₁ : ∀ w : relWeil F L,
      w ∈ (relWeil F M₁).subgroupOf (relWeil F L) ↔ ∃ h ∈ N₁, ∃ c ∈ C, π w = h.1 * c)
    (hTraceH : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hAB : A ≤ B) (hBMC : B ≤ M_C)
      (H_A : Subgroup H),
      (∀ w : relWeil F L,
        w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ projH (π w) ∈ H_A) →
      ∀ (χ_B : relWeil F B →* (Ω F)ˣ),
        restrictWeilChar F (hBMC.trans hM_CK) χ_B = 1 →
        ∃ (H_B : Subgroup H)
          (M_B : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
          (ψ_B : M_B →* (Ω F)ˣ),
          (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).Wf F A ∧
          H_B ≤ H_A ∧
          (∀ h : H, h ∈ H_B ↔
            ∀ x : IntermediateField.extendScalars hLK,
              (x : AlgebraicClosure F) ∈ B → h.1 x = x) ∧
          (∀ x : IntermediateField.extendScalars hLK,
            (x : AlgebraicClosure F) ∈ B ↔ ∀ h ∈ H_B, ∀ c ∈ C, (h.1 * c) x = x) ∧
          (∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
            g ∈ M_B ↔ projH g ∈ H_B) ∧
          (∀ w : relWeil F L,
            w ∈ (relWeil F B).subgroupOf (relWeil F L) ↔ π w ∈ M_B) ∧
          (∀ (w_B : relWeil F B)
            (hm : π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) ∈ M_B),
            χ_B w_B = ψ_B ⟨π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B), hm⟩) ∧
          ∀ w : relWeil F A,
            (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).trace F A w =
              (Nat.card H_B : Ω F)⁻¹ *
                ∑ y : H_A,
                  if hm : y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLA) w) * y.1.1⁻¹ ∈ M_B then
                    (ψ_B ⟨y.1.1 * π (Subgroup.inclusion (relWeil_antitone F hLA) w) * y.1.1⁻¹, hm⟩ : Ω F)
                  else 0)
    (F'_t : IntermediateField F (AlgebraicClosure F))
    (hLF'_t : L ≤ F'_t) (hF'_tMC : F'_t ≤ M_C)
    (χ'_t : relWeil F F'_t →* (Ω F)ˣ)
    (hχ'_t_pow : χ'_t ^ (p F) = 1)
    (hχ'_t_restK : restrictWeilChar F (hF'_tMC.trans hM_CK) χ'_t = 1)
    (hχ'_t_restE : ∃ hgE' : F'_t ≤ E ⊔ F'_t, restrictWeilChar F hgE' χ'_t = 1)
    (hχ'_t_neMC : restrictWeilChar F hF'_tMC χ'_t ≠ 1)
    (K_t : Subgroup H)
    (hKt_mem : ∀ h : H, h ∈ K_t ↔
      ∀ x : IntermediateField.extendScalars hLK,
        (x : AlgebraicClosure F) ∈ F'_t → h.1 x = x)
    (M_Kt : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hMKt_mem : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      g ∈ M_Kt ↔ projH g ∈ K_t)
    (hWF'_t_mem : ∀ w : relWeil F L,
      w ∈ (relWeil F F'_t).subgroupOf (relWeil F L) ↔ π w ∈ M_Kt)
    (ψ'_t : M_Kt →* (Ω F)ˣ)
    (hχ'_t_eq : ∀ (w_B : relWeil F F'_t)
      (hm : π (Subgroup.inclusion (relWeil_antitone F hLF'_t) w_B) ∈ M_Kt),
      χ'_t w_B = ψ'_t ⟨π (Subgroup.inclusion (relWeil_antitone F hLF'_t) w_B), hm⟩) :
    ∃ (S_t : IntermediateField F (AlgebraicClosure F))
      (hLS_t : L ≤ S_t) (hM₁S_t : M₁ ≤ S_t) (hS_tMC : S_t ≤ M_C)
      (χ_St : relWeil F S_t →* (Ω F)ˣ),
      IsWeilRep F S_t (charRep F S_t χ_St) ∧
      χ_St ^ (p F) = 1 ∧
      restrictWeilChar F (hS_tMC.trans hM_CK) χ_St = 1 ∧
      (∃ hStE : S_t ≤ E ⊔ S_t, restrictWeilChar F hStE χ_St = 1) ∧
      restrictWeilChar F hS_tMC χ_St ≠ 1 ∧
      (∀ h : H,
        (∀ x : IntermediateField.extendScalars hLK,
          (x : AlgebraicClosure F) ∈ S_t → h.1 x = x) ↔
        h ∈ K_t ⊓ N₁) ∧
      ∀ (w_S : relWeil F S_t)
        (hm : π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S) ∈ M_Kt),
        χ_St w_S = ψ'_t ⟨π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S), hm⟩ :=
by
  let S_t : IntermediateField F (AlgebraicClosure F) := F'_t ⊔ M₁
  have hF'_tSt : F'_t ≤ S_t := le_sup_left
  have hM₁S_t : M₁ ≤ S_t := le_sup_right
  have hS_tMC : S_t ≤ M_C := sup_le hF'_tMC hM₁MC
  have hLS_t : L ≤ S_t := hLF'_t.trans hF'_tSt
  let χ_St : relWeil F S_t →* (Ω F)ˣ := restrictWeilChar F hF'_tSt χ'_t
  have hχ_St_restK : restrictWeilChar F (hS_tMC.trans hM_CK) χ_St = 1 := by
    apply MonoidHom.ext
    intro w
    let w₁ : relWeil F S_t := Subgroup.inclusion (relWeil_antitone F (hS_tMC.trans hM_CK)) w
    let u₁ : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F hF'_tSt) w₁
    let u₂ : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F (hF'_tMC.trans hM_CK)) w
    have hu₁ : (u₁ : AbsGal F) = (w : AbsGal F) :=
      (Subgroup.coe_inclusion _ w₁).trans (Subgroup.coe_inclusion _ w)
    have hu₂ : (u₂ : AbsGal F) = (w : AbsGal F) := Subgroup.coe_inclusion _ w
    have hu : u₁ = u₂ := Subtype.ext (hu₁.trans hu₂.symm)
    have h_lhs : (restrictWeilChar F (hS_tMC.trans hM_CK) χ_St) w = χ'_t u₁ :=
      (MonoidHom.comp_apply _ _ w).trans (MonoidHom.comp_apply _ _ w₁)
    have h_mid : χ'_t u₂ = (restrictWeilChar F (hF'_tMC.trans hM_CK) χ'_t) w :=
      (MonoidHom.comp_apply _ _ w).symm
    exact h_lhs.trans ((congr_arg χ'_t hu).trans (h_mid.trans (DFunLike.congr_fun hχ'_t_restK w)))
  have hχ_St_neMC : restrictWeilChar F hS_tMC χ_St ≠ 1 := by
    intro h_eq
    apply hχ'_t_neMC
    apply MonoidHom.ext
    intro w
    let w₁ : relWeil F S_t := Subgroup.inclusion (relWeil_antitone F hS_tMC) w
    let u₁ : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F hF'_tSt) w₁
    let u₂ : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F hF'_tMC) w
    have hu₁ : (u₁ : AbsGal F) = (w : AbsGal F) :=
      (Subgroup.coe_inclusion _ w₁).trans (Subgroup.coe_inclusion _ w)
    have hu₂ : (u₂ : AbsGal F) = (w : AbsGal F) := Subgroup.coe_inclusion _ w
    have hu : u₂ = u₁ := Subtype.ext (hu₂.trans hu₁.symm)
    have h_lhs : (restrictWeilChar F hF'_tMC χ'_t) w = χ'_t u₂ := MonoidHom.comp_apply _ _ w
    have h_mid : χ'_t u₁ = (restrictWeilChar F hS_tMC χ_St) w :=
      ((MonoidHom.comp_apply _ _ w).trans (MonoidHom.comp_apply _ _ w₁)).symm
    exact h_lhs.trans ((congr_arg χ'_t hu).trans (h_mid.trans (DFunLike.congr_fun h_eq w)))
  have hχ_St_pow : χ_St ^ (p F) = 1 := by
    apply MonoidHom.ext
    intro w
    let u : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F hF'_tSt) w
    have h0 : χ_St w = χ'_t u := MonoidHom.comp_apply _ _ w
    have h1 : (χ_St ^ (p F)) w = (χ_St w) ^ (p F) := MonoidHom.pow_apply χ_St (p F) w
    have h2 : (χ'_t ^ (p F)) u = (1 : relWeil F F'_t →* (Ω F)ˣ) u := DFunLike.congr_fun hχ'_t_pow u
    have h3 : (χ'_t ^ (p F)) u = (χ'_t u) ^ (p F) := MonoidHom.pow_apply χ'_t (p F) u
    exact h1.trans ((congr_arg (fun z : (Ω F)ˣ => z ^ (p F)) h0).trans
      (h3.symm.trans (h2.trans ((MonoidHom.one_apply u).trans (MonoidHom.one_apply w).symm))))
  have hχ_St_restE : ∃ hStE : S_t ≤ E ⊔ S_t, restrictWeilChar F hStE χ_St = 1 := by
    obtain ⟨hgE', hχ'_t_E⟩ := hχ'_t_restE
    have hStE : S_t ≤ E ⊔ S_t := le_sup_right
    have hEF'_t_ES_t : E ⊔ F'_t ≤ E ⊔ S_t := sup_le_sup_left hF'_tSt E
    refine ⟨hStE, ?_⟩
    apply MonoidHom.ext
    intro w
    let w₁ : relWeil F S_t := Subgroup.inclusion (relWeil_antitone F hStE) w
    let w₂ : relWeil F (E ⊔ F'_t) := Subgroup.inclusion (relWeil_antitone F hEF'_t_ES_t) w
    let u₁ : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F hF'_tSt) w₁
    let u₂ : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F hgE') w₂
    have hu₁ : (u₁ : AbsGal F) = (w : AbsGal F) :=
      (Subgroup.coe_inclusion _ w₁).trans (Subgroup.coe_inclusion _ w)
    have hu₂ : (u₂ : AbsGal F) = (w : AbsGal F) :=
      (Subgroup.coe_inclusion _ w₂).trans (Subgroup.coe_inclusion _ w)
    have hu : u₁ = u₂ := Subtype.ext (hu₁.trans hu₂.symm)
    have h_lhs : (restrictWeilChar F hStE χ_St) w = χ'_t u₁ :=
      (MonoidHom.comp_apply _ _ w).trans (MonoidHom.comp_apply _ _ w₁)
    have h_mid : χ'_t u₂ = (restrictWeilChar F hgE' χ'_t) w₂ :=
      (MonoidHom.comp_apply _ _ w₂).symm
    have h_rhs : (restrictWeilChar F hgE' χ'_t) w₂ = 1 :=
      (DFunLike.congr_fun hχ'_t_E w₂).trans (MonoidHom.one_apply w₂)
    exact h_lhs.trans ((congr_arg χ'_t hu).trans (h_mid.trans (h_rhs.trans (MonoidHom.one_apply w).symm)))
  have h_proj_L : ∀ w : relWeil F L,
      w ∈ (relWeil F L).subgroupOf (relWeil F L) ↔ projH (π w) ∈ (⊤ : Subgroup H) :=
    fun w => ⟨fun _ => Subgroup.mem_top _, fun _ => w.2⟩
  obtain ⟨_, _, _, hSt_wf, _⟩ :=
    hTraceH L S_t le_rfl hLS_t hS_tMC ⊤ h_proj_L χ_St hχ_St_restK
  have hχ_St_weil : IsWeilRep F S_t (charRep F S_t χ_St) := hSt_wf.2.2
  have h_proj_M₁ : ∀ w : relWeil F L,
      w ∈ (relWeil F M₁).subgroupOf (relWeil F L) ↔ projH (π w) ∈ N₁ :=
    fun w => (h_mem_M₁ w).trans (hprojH_sub N₁ (π w)).symm
  obtain ⟨H_M₁, _, _, _, hHM₁_le_N₁, hHM₁_mem, _⟩ :=
    hTraceH M₁ M₁ (hLL'.trans hL'M₁) le_rfl hM₁MC N₁ h_proj_M₁ 1 (MonoidHom.one_comp _)
  have hSt_fix_iff : ∀ h : H,
      (∀ x : IntermediateField.extendScalars hLK, (x : AlgebraicClosure F) ∈ S_t → h.1 x = x) ↔
        h ∈ K_t ⊓ N₁ := by
    intro h
    constructor
    · intro hh
      have hk : h ∈ K_t := (hKt_mem h).mpr (fun x hx => hh x (hF'_tSt hx))
      have hn : h ∈ N₁ := hHM₁_le_N₁ ((hHM₁_mem h).mpr (fun x hx => hh x (hM₁S_t hx)))
      exact ⟨hk, hn⟩
    · rintro ⟨hk, hn⟩ x hx
      obtain ⟨w_h, hπ_wh⟩ := hsurj h.1
      have hproj_wh : projH (π w_h) ∈ K_t :=
        ((congr_arg projH hπ_wh).trans (hprojH_id h)).symm ▸ hk
      have hwh_F'_t : w_h ∈ (relWeil F F'_t).subgroupOf (relWeil F L) :=
        (hWF'_t_mem w_h).mpr ((hMKt_mem (π w_h)).mpr hproj_wh)
      have hwh_M₁ : w_h ∈ (relWeil F M₁).subgroupOf (relWeil F L) :=
        (h_mem_M₁ w_h).mpr ⟨h, hn, 1, C.one_mem, hπ_wh.trans (mul_one h.1).symm⟩
      have hw_F'_t : (w_h : AbsGal F) ∈ F'_t.fixingSubgroup := hwh_F'_t.2
      have hw_M₁ : (w_h : AbsGal F) ∈ M₁.fixingSubgroup := hwh_M₁.2
      have hw_inf : (w_h : AbsGal F) ∈ F'_t.fixingSubgroup ⊓ M₁.fixingSubgroup :=
        ⟨hw_F'_t, hw_M₁⟩
      have hw_St : (w_h : AbsGal F) ∈ S_t.fixingSubgroup :=
        (SetLike.ext_iff.mp IntermediateField.fixingSubgroup_sup (w_h : AbsGal F)).mpr hw_inf
      have h1 : ((h.1 x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
          ((π w_h x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) :=
        congr_arg Subtype.val (DFunLike.congr_fun hπ_wh.symm x)
      have h2 : ((π w_h x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
          (w_h : AbsGal F) (x : AlgebraicClosure F) := hπ w_h x
      have h3 : (w_h : AbsGal F) (x : AlgebraicClosure F) = (x : AlgebraicClosure F) :=
        (IntermediateField.mem_fixingSubgroup_iff S_t (w_h : AbsGal F)).mp hw_St
          (x : AlgebraicClosure F) hx
      exact Subtype.ext (h1.trans (h2.trans h3))
  have hχ_St_eq : ∀ (w_S : relWeil F S_t)
      (hm : π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S) ∈ M_Kt),
      χ_St w_S = ψ'_t ⟨π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S), hm⟩ := by
    intro w_S hm
    let w_B : relWeil F F'_t := Subgroup.inclusion (relWeil_antitone F hF'_tSt) w_S
    let u₁ : relWeil F L := Subgroup.inclusion (relWeil_antitone F hLF'_t) w_B
    let u₂ : relWeil F L := Subgroup.inclusion (relWeil_antitone F hLS_t) w_S
    have hu₁ : (u₁ : AbsGal F) = (w_S : AbsGal F) :=
      (Subgroup.coe_inclusion _ w_B).trans (Subgroup.coe_inclusion _ w_S)
    have hu₂ : (u₂ : AbsGal F) = (w_S : AbsGal F) := Subgroup.coe_inclusion _ w_S
    have hw_eq : u₁ = u₂ := Subtype.ext (hu₁.trans hu₂.symm)
    have hm_B : π u₁ ∈ M_Kt := (congr_arg (fun z => π z ∈ M_Kt) hw_eq).mpr hm
    have hsub_eq : (⟨π u₁, hm_B⟩ : M_Kt) = ⟨π u₂, hm⟩ :=
      Subtype.ext (congr_arg π hw_eq)
    have h_lhs : χ_St w_S = χ'_t w_B := MonoidHom.comp_apply _ _ w_S
    exact h_lhs.trans ((hχ'_t_eq w_B hm_B).trans (congr_arg ψ'_t hsub_eq))
  exact ⟨S_t, hLS_t, hM₁S_t, hS_tMC, χ_St,
    hχ_St_weil, hχ_St_pow, hχ_St_restK, hχ_St_restE, hχ_St_neMC,
    hSt_fix_iff, hχ_St_eq⟩

theorem ld_ch14_sup_M1_gamma_conj_family_and_subfield_trace_iff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
