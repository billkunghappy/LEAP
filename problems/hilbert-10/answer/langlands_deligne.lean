      rw [dif_neg hx, dif_neg hy]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ x y : F, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
      intro x y hx hy
      have hxy : x * y ≠ 0 := mul_ne_zero hx hy
      have hvx : valuation F x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
      have hφx : φ (valuation F x) ≠ 0 := (map_ne_zero _).mpr hvx
      have hvy : valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hφy : φ (valuation F y) ≠ 0 := (map_ne_zero _).mpr hvy
      have hvxy : valuation F (x * y) ≠ 0 := (Valuation.ne_zero_iff _).mpr hxy
      have hφxy : φ (valuation F (x * y)) ≠ 0 := (map_ne_zero _).mpr hvxy
      unfold addVal
      rw [dif_neg hxy, dif_neg hx, dif_neg hy]
      have hunz : WithZero.unzero hφxy = WithZero.unzero hφx * WithZero.unzero hφy := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (x : F) (k : ℕ), x ≠ 0 → addVal F (x ^ k) = (k : ℤ) * addVal F x := by
      intro x k hx
      have hxk : x ^ k ≠ 0 := pow_ne_zero k hx
      have hvx : valuation F x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
      have hφx : φ (valuation F x) ≠ 0 := (map_ne_zero _).mpr hvx
      have hvxk : valuation F (x ^ k) ≠ 0 := (Valuation.ne_zero_iff _).mpr hxk
      have hφxk : φ (valuation F (x ^ k)) ≠ 0 := (map_ne_zero _).mpr hvxk
      unfold addVal
      rw [dif_neg hxk, dif_neg hx]
      have hunz : WithZero.unzero hφxk = (WithZero.unzero hφx) ^ k := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F M (-1) = 0 := by
      have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F M ((-1 : M) * (-1 : M)) = relVal F M (-1) + relVal F M (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : M) * (-1 : M) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : M, relVal F M (-x) = relVal F M x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : M) = (-1 : M) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul : relVal F M ((u : M) * ((u⁻¹ : Mˣ) : M)) =
          relVal F M (u : M) + relVal F M ((u⁻¹ : Mˣ) : M) :=
        hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (k : ℕ),
        relVal F M (((u ^ k : Mˣ) : M)) = (k : ℤ) * relVal F M (u : M) := by
      intro u k
      induction k with
      | zero =>
        simp [hrel1]
      | succ k ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (k : ℤ),
        relVal F M (((u ^ k : Mˣ) : M)) = k * relVal F M (u : M) := by
      intro u k
      cases k with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : M := algebraMap F M π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F M x₀ = (Module.finrank F M : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F M := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F M, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfM_mem : resDeg F M ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖ₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    have hdiv : ∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F M : ℤ)
        set q : ℤ := valL F M x
        set r : ℤ := relVal F M x % f
        have hediv : f * q + r = relVal F M x := Int.mul_ediv_add_emod (relVal F M x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M x) hfM_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M x) hfM_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : M := x * (((ϖM ^ (-q) : Mˣ) : M))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F M y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q), hrel_ϖM]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F M := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F M 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval1 : valL F M 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg1 : valL F M (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg : ∀ x : M, valL F M (-x) = valL F M x := by
      intro x
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
      intro u
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_add : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : M,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, k, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ k := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : M, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F M z ≤ valL F M w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F M) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ x : F, ‖x‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F x) : ℝ) := fun x => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfM_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : M) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F M x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F M y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_add⟩

  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv_unit, hvalL_add⟩ :=
    hval_props L
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv_unit, hvalE'_add⟩ :=
    hval_props E'
  obtain ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv_unit, hvalK₁_add⟩ :=
    hval_props K₁

  have hvalE'_mono : ∀ (q₁ q₂ : ℤ) (x : E'),
      q₁ ≤ q₂ → (x = 0 ∨ q₂ ≤ valL F E' x) → (x = 0 ∨ q₁ ≤ valL F E' x) := by
    intro q₁ q₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hvalE'_mul_ge : ∀ (q₁ q₂ : ℤ) (x y : E'),
      (x = 0 ∨ q₁ ≤ valL F E' x) → (y = 0 ∨ q₂ ≤ valL F E' y) →
        (x * y = 0 ∨ q₁ + q₂ ≤ valL F E' (x * y)) := by
    intro q₁ q₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalE'_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalE'_pow_eq : ∀ (x : E') (hx : x ≠ 0) (k : ℕ),
      x ^ k ≠ 0 ∧ valL F E' (x ^ k) = (k : ℤ) * valL F E' x := by
    intro x hx k
    induction k with
    | zero =>
      rw [pow_zero]
      refine ⟨one_ne_zero, ?_⟩
      rw [hvalE'_1, Nat.cast_zero, zero_mul]
    | succ k ih =>
      refine ⟨pow_ne_zero (k + 1) hx, ?_⟩
      rw [pow_succ', hvalE'_mul x (x ^ k) hx ih.1, ih.2]
      push_cast
      ring
  have hvalE'_inv : ∀ (x : E'), x ≠ 0 → valL F E' x⁻¹ = - valL F E' x := by
    intro x hx
    have h := hvalE'_inv_unit (Units.mk0 x hx)
    rwa [Units.val_inv_eq_inv_val] at h
  have hvalE'_neg1_pow_mul : ∀ (k : ℕ) (x : E'),
      valL F E' ((-1 : E') ^ k * x) = valL F E' x := by
    intro k x
    induction k with
    | zero => rw [pow_zero, one_mul]
    | succ k ih => rw [pow_succ', mul_assoc, neg_one_mul, hvalE'_neg, ih]
  have hvalE'_sum : ∀ {α : Type} (S : Finset α) (f : α → E') (q : ℤ),
      (∀ x ∈ S, f x = 0 ∨ q ≤ valL F E' (f x)) →
        ((∑ x ∈ S, f x) = 0 ∨ q ≤ valL F E' (∑ x ∈ S, f x)) := by
    intro α S f q hf
    induction' S using Finset.induction_on with x S hx ih
    · left; exact Finset.sum_empty
    · rw [Finset.sum_insert hx]
      exact hvalE'_add q (f x) (∑ y ∈ S, f y)
        (hf x (Finset.mem_insert_self x S))
        (ih (fun y hy => hf y (Finset.mem_insert_of_mem hy)))
  have hvalE'_mul4 : ∀ (q₁ q₂ q₃ q₄ q : ℤ) (x₁ x₂ x₃ x₄ : E'),
      (x₁ = 0 ∨ q₁ ≤ valL F E' x₁) →
      (x₂ = 0 ∨ q₂ ≤ valL F E' x₂) →
      (x₃ = 0 ∨ q₃ ≤ valL F E' x₃) →
      (x₄ = 0 ∨ q₄ ≤ valL F E' x₄) →
      q ≤ q₁ + q₂ + q₃ + q₄ →
      (x₁ * x₂ * x₃ * x₄ = 0 ∨ q ≤ valL F E' (x₁ * x₂ * x₃ * x₄)) := by
    intro q₁ q₂ q₃ q₄ q x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hq
    have h12 := hvalE'_mul_ge q₁ q₂ x₁ x₂ h₁ h₂
    have h123 := hvalE'_mul_ge (q₁ + q₂) q₃ (x₁ * x₂) x₃ h12 h₃
    have h1234 := hvalE'_mul_ge (q₁ + q₂ + q₃) q₄ (x₁ * x₂ * x₃) x₄ h123 h₄
    exact hvalE'_mono q (q₁ + q₂ + q₃ + q₄) (x₁ * x₂ * x₃ * x₄) hq h1234

  have hvalK₁_mono : ∀ (q₁ q₂ : ℤ) (x : K₁),
      q₁ ≤ q₂ → (x = 0 ∨ q₂ ≤ valL F K₁ x) → (x = 0 ∨ q₁ ≤ valL F K₁ x) := by
    intro q₁ q₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hvalK₁_mul_ge : ∀ (q₁ q₂ : ℤ) (x y : K₁),
      (x = 0 ∨ q₁ ≤ valL F K₁ x) → (y = 0 ∨ q₂ ≤ valL F K₁ y) →
        (x * y = 0 ∨ q₁ + q₂ ≤ valL F K₁ (x * y)) := by
    intro q₁ q₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalK₁_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalK₁_natCast : ∀ k : ℕ, ((k : ℕ) : K₁) = 0 ∨ (0 : ℤ) ≤ valL F K₁ ((k : ℕ) : K₁) := by
    intro k
    induction k with
    | zero => left; exact Nat.cast_zero
    | succ k ih =>
      rw [Nat.cast_succ]
      exact hvalK₁_add 0 (k : K₁) 1 ih (Or.inr (by rw [hvalK₁_1]))
  have hvalK₁_mul4 : ∀ (q₁ q₂ q₃ q₄ q : ℤ) (x₁ x₂ x₃ x₄ : K₁),
      (x₁ = 0 ∨ q₁ ≤ valL F K₁ x₁) →
      (x₂ = 0 ∨ q₂ ≤ valL F K₁ x₂) →
      (x₃ = 0 ∨ q₃ ≤ valL F K₁ x₃) →
      (x₄ = 0 ∨ q₄ ≤ valL F K₁ x₄) →
      q ≤ q₁ + q₂ + q₃ + q₄ →
      (x₁ * x₂ * x₃ * x₄ = 0 ∨ q ≤ valL F K₁ (x₁ * x₂ * x₃ * x₄)) := by
    intro q₁ q₂ q₃ q₄ q x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hq
    have h12 := hvalK₁_mul_ge q₁ q₂ x₁ x₂ h₁ h₂
    have h123 := hvalK₁_mul_ge (q₁ + q₂) q₃ (x₁ * x₂) x₃ h12 h₃
    have h1234 := hvalK₁_mul_ge (q₁ + q₂ + q₃) q₄ (x₁ * x₂ * x₃) x₄ h123 h₄
    exact hvalK₁_mono q (q₁ + q₂ + q₃ + q₄) (x₁ * x₂ * x₃ * x₄) hq h1234

  have pullback_E'K₁ : ∀ X : E',
      (IntermediateField.inclusion hE'K₁ X = 0 ∨
        ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ X)) →
      (X = 0 ∨ (bE' : ℤ) ≤ valL F E' X) := by
    intro X hX
    rcases hX with h0 | hge
    · left
      exact (map_eq_zero_iff (IntermediateField.inclusion hE'K₁)
        (IntermediateField.inclusion hE'K₁).injective).mp h0
    · right
      rw [hval_E'K₁ X, ← hp_def] at hge
      have hcast : ((1 + p * t₂ : ℕ) : ℤ) = 1 + (p : ℤ) * (t₂ : ℤ) := by push_cast; ring
      rw [hcast] at hge
      have hlt : ¬ (valL F E' X ≤ (t₂ : ℤ)) := by
        intro hle
        have hmul : (p : ℤ) * valL F E' X ≤ (p : ℤ) * (t₂ : ℤ) :=
          mul_le_mul_of_nonneg_left hle (by omega)
        omega
      omega

  
  have hu_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero (γ⁻¹))
  have hu_val : valL F L u = (m : ℤ) := by
    rw [hu_def, hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero (γ⁻¹)),
      hvalL_inv_unit γ, hα_val, hγ_val]
    omega
  have hu_E'_val : valL F E' (IntermediateField.inclusion hLE' u) = (p : ℤ) * (m : ℤ) := by
    rw [hval_LE' u, ← hp_def, hu_val]

  have hw₂_inv_val : valL F E' ((w₂⁻¹ : E'ˣ) : E') = (m : ℤ) := by
    rw [hvalE'_inv_unit w₂, hw₂_val, neg_neg]
  have hw₂_inv_p1_val :
      valL F E' (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) = ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
    rw [(hvalE'_pow_eq ((w₂⁻¹ : E'ˣ) : E') (Units.ne_zero (w₂⁻¹)) (p - 1)).2, hw₂_inv_val]
  have hw₂_inv_p1_K₁_val :
      valL F K₁ (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1))) =
        ((p - 1 : ℕ) : ℤ) * (p : ℤ) * (m : ℤ) := by
    rw [hval_E'K₁, ← hp_def, hw₂_inv_p1_val]
    ring

  have ha_val : valL F E' a = -(t₁ : ℤ) := by
    rw [ha_def, hval_norm_E'K₁, hΔ_val]
  have hC_val0' : valL F E' C = 0 := hC_val0
  have hC_inv_ne0 : C⁻¹ ≠ 0 := inv_ne_zero hC_ne0
  have hC_inv_val : valL F E' C⁻¹ = 0 := by
    rw [hvalE'_inv C hC_ne0, hC_val0', neg_zero]
  have hC_inv_sq_val : valL F E' (C⁻¹ ^ 2) = 0 := by
    rw [(hvalE'_pow_eq C⁻¹ hC_inv_ne0 2).2, hC_inv_val, mul_zero]

  set P_out : K₁ :=
    ((p - 1 : ℕ) : K₁) * IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1))
  set F₁ : K₁ := IntermediateField.inclusion hM₁'K₁ T
  set F₂ : K₁ := W_K₁ ^ 2 * A_star ^ (p - 2) * D_norm⁻¹
  set F₃ : K₁ := (Δ : K₁) - IntermediateField.inclusion hM₁'K₁ b
  set G₁ : K₁ := - IntermediateField.inclusion hE'K₁ ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀)
  set G₂ : K₁ := - IntermediateField.inclusion hE'K₁ (C⁻¹ ^ 2)
  set G₃ : K₁ := - IntermediateField.inclusion hE'K₁ a

  have hP_out_val : P_out = 0 ∨ ((p - 1 : ℕ) : ℤ) * (p : ℤ) * (m : ℤ) ≤ valL F K₁ P_out := by
    have h := hvalK₁_mul_ge 0 (((p - 1 : ℕ) : ℤ) * (p : ℤ) * (m : ℤ))
      ((p - 1 : ℕ) : K₁) (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)))
      (hvalK₁_natCast (p - 1)) (Or.inr (by rw [hw₂_inv_p1_K₁_val]))
    simpa [P_out] using h

  have hF₁_sub_G₁ : F₁ - G₁ = 0 ∨
      (((p - 1) * p * m + p * (p - 1) * δ + (p - 1) * t₁ : ℕ) : ℤ) ≤ valL F K₁ (F₁ - G₁) := by
    have heq : F₁ - G₁ =
        IntermediateField.inclusion hM₁'K₁ T +
          IntermediateField.inclusion hE'K₁ ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀) := by
      dsimp [F₁, G₁]; ring
    rw [heq]
    exact hT_approx

  have hG₁_val : G₁ = 0 ∨
      (((p - 1 : ℕ) : ℤ) * (p : ℤ) * (m : ℤ) + (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (δ : ℤ)) ≤
        valL F K₁ G₁ := by
    have hs₀_val' : s₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) ≤ valL F E' s₀ := hs₀_val
    have hmul_E' := hvalE'_mul_ge (((p - 1 : ℕ) : ℤ) * (m : ℤ)) (((p - 1 : ℕ) : ℤ) * (δ : ℤ))
      (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) s₀ (Or.inr (by rw [hw₂_inv_p1_val])) hs₀_val'
    rcases hmul_E' with h0 | hge
    · left
      dsimp [G₁]
      rw [h0, map_zero, neg_zero]
    · right
      dsimp [G₁]
      rw [hvalK₁_neg, hval_E'K₁, ← hp_def]
      have hpmul : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (m : ℤ) + ((p - 1 : ℕ) : ℤ) * (δ : ℤ)) ≤
          (p : ℤ) * valL F E' ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀) :=
        mul_le_mul_of_nonneg_left hge (by omega)
      linarith

  have hF₂_sub_G₂ : F₂ - G₂ = 0 ∨ ((p * p * m : ℕ) : ℤ) - (t₁ : ℤ) ≤ valL F K₁ (F₂ - G₂) := by
    have heq : F₂ - G₂ = W_K₁ ^ 2 * A_star ^ (p - 2) * D_norm⁻¹ +
        IntermediateField.inclusion hE'K₁ (C⁻¹ ^ 2) := by
      dsimp [F₂, G₂]; ring
    rw [heq]
    exact hC_inv_sq_approx

  have hG₂_val : G₂ = 0 ∨ (0 : ℤ) ≤ valL F K₁ G₂ := by
    right
    dsimp [G₂]
    rw [hvalK₁_neg, hval_E'K₁, hC_inv_sq_val, mul_zero]

  have hF₂_val : F₂ = 0 ∨ (0 : ℤ) ≤ valL F K₁ F₂ := by
    have hge0 : (0 : ℤ) ≤ ((p * p * m : ℕ) : ℤ) - (t₁ : ℤ) := by
      have hcast : ((p * p * m : ℕ) : ℤ) = (p : ℤ) * ((p : ℤ) * (m : ℤ)) := by push_cast; ring
      rw [hcast]
      have h1 : (3 : ℤ) * ((t₁ : ℤ) + 1) ≤ (p : ℤ) * ((p : ℤ) * (m : ℤ)) := by
        calc (3 : ℤ) * ((t₁ : ℤ) + 1)
          _ ≤ (p : ℤ) * ((t₁ : ℤ) + 1) := mul_le_mul_of_nonneg_right (by omega) (by omega)
          _ ≤ (p : ℤ) * ((p : ℤ) * (m : ℤ)) := mul_le_mul_of_nonneg_left hpm_z (by omega)
      omega
    have hdiff0 := hvalK₁_mono 0 (((p * p * m : ℕ) : ℤ) - (t₁ : ℤ)) (F₂ - G₂) hge0 hF₂_sub_G₂
    have hadd := hvalK₁_add 0 (F₂ - G₂) G₂ hdiff0 hG₂_val
    rwa [sub_add_cancel] at hadd

  have hF₃_sub_G₃ : F₃ - G₃ = 0 ∨
      ((p * (p - 1) * δ : ℕ) : ℤ) - (t₁ : ℤ) ≤ valL F K₁ (F₃ - G₃) := by
    let h_diff : K₁ := IntermediateField.inclusion hM₁'K₁ b -
      ((Δ : K₁) + IntermediateField.inclusion hE'K₁ a)
    have hh : h_diff = 0 ∨ ((p * (p - 1) * δ : ℕ) : ℤ) - (t₁ : ℤ) ≤ valL F K₁ h_diff := hh_diff_val
    have heq : F₃ - G₃ = - h_diff := by dsimp [F₃, G₃, h_diff]; ring
    rw [heq]
    rcases hh with h0 | hge
    · left; rw [h0, neg_zero]
    · right; rwa [hvalK₁_neg]

  have hG₃_val : G₃ = 0 ∨ -(p : ℤ) * (t₁ : ℤ) ≤ valL F K₁ G₃ := by
    right
    dsimp [G₃]
    rw [hvalK₁_neg, hval_E'K₁, ← hp_def, ha_val]
    linarith

  have hF₃_val : F₃ = 0 ∨ -(p : ℤ) * (t₁ : ℤ) ≤ valL F K₁ F₃ := by
    have hle : -(p : ℤ) * (t₁ : ℤ) ≤ ((p * (p - 1) * δ : ℕ) : ℤ) - (t₁ : ℤ) := by
      have h0 : (0 : ℤ) ≤ ((p * (p - 1) * δ : ℕ) : ℤ) := Nat.cast_nonneg _
      have h1 : (1 : ℤ) * (t₁ : ℤ) ≤ (p : ℤ) * (t₁ : ℤ) :=
        mul_le_mul_of_nonneg_right (by omega) (by omega)
      linarith
    have hdiff := hvalK₁_mono (-(p : ℤ) * (t₁ : ℤ))
      (((p * (p - 1) * δ : ℕ) : ℤ) - (t₁ : ℤ)) (F₃ - G₃) hle hF₃_sub_G₃
    have hadd := hvalK₁_add (-(p : ℤ) * (t₁ : ℤ)) (F₃ - G₃) G₃ hdiff hG₃_val
    rwa [sub_add_cancel] at hadd

  
  have hyT_pow_inv :
      (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * (C⁻¹ ^ 2) =
        ((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹ := by
    rw [Units.val_inv_eq_inv_val w₂, inv_pow, inv_pow, ← mul_inv, ← pow_add, ← two_mul, ← mul_inv]
  have hyT_prod_E' :
      ((p - 1 : ℕ) : E') * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
        ((- ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀)) * (- (C⁻¹ ^ 2)) * (- a)) =
        ((p - 1 : ℕ) : E') * y_T := by
    rw [hyT_def, ← hyT_pow_inv]
    ring
  have hG_prod_K₁ :
      P_out * (G₁ * G₂ * G₃) =
        IntermediateField.inclusion hE'K₁ (((p - 1 : ℕ) : E') * y_T) := by
    rw [← hyT_prod_E']
    dsimp [P_out, G₁, G₂, G₃]
    simp only [map_mul, map_neg, map_natCast]

  set Q_interp : K₁ :=
    ((p - 1 : ℕ) : K₁) *
      IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
      IntermediateField.inclusion hM₁'K₁ T * W_K₁ ^ 2 *
      A_star ^ (p - 2) * ((Δ : K₁) - IntermediateField.inclusion hM₁'K₁ b) * D_norm⁻¹
  have hQ_telesc :
