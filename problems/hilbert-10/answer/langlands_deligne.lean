  let c_s2 : L := -2 * (f - d ^ 2 * g) * (2 * (f - d ^ 2 * g) + (1 + d))
  have hB_sub_QV_eq : B_comm - β₂ * (Q - V) = s₀ * c_s1 + s₀ ^ 2 * c_s2 := by
    dsimp [B_comm, β₂, Q, V, k₀, c_s1, c_s2]
