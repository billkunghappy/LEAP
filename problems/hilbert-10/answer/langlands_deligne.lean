        have hpiece3 :
            ((k : ℕ) : R_M) * ((B_m ^ k - b ^ k) * (θ₀ * ξ m)) = 0 ∨
              B_val ≤ vM₁' (((k : ℕ) : R_M) * ((B_m ^ k - b ^ k) * (θ₀ * ξ m))) := by
          have hθξ := hvalM₁'_mul_ge V_lin 0 θ₀ (ξ m) hθ₀_val hξ_int
          rw [add_zero] at hθξ
          have hmul1 := hvalM₁'_mul_ge (-((k - 1 : ℕ) : ℤ) * (t₁ : ℤ)) V_lin
            (B_m ^ k - b ^ k) (θ₀ * ξ m) (hWb_sub k hk_ge1) hθξ
          have hmul2 := hvalM₁'_mul_ge 0 (-((k - 1 : ℕ) : ℤ) * (t₁ : ℤ) + V_lin)
            ((k : ℕ) : R_M) ((B_m ^ k - b ^ k) * (θ₀ * ξ m)) (hvalM₁'_natCast k) hmul1
          refine hvalM₁'_mono B_val _ _ ?_ hmul2
          dsimp [B_val]
          rw [hk_sub1_z]
          linarith only [hV_pert_le_V_lin_t₁]
        rw [hdecomp]
        exact hvalM₁'_add B_val _ _ (hvalM₁'_add B_val _ _ hpiece1 hpiece2) hpiece3
      have hsum_ξ_pert : (∑ m ∈ S_p, ξ m) = 0 ∨ V_pert ≤ vM₁' (∑ m ∈ S_p, ξ m) :=
        hvalM₁'_mono V_pert _ _ hpm₁_ge_V_pert hsum_ξ_p3
      have htail_bound :
          ((k : ℕ) : R_M) * b ^ k * θ₀ * (∑ m ∈ S_p, ξ m) = 0 ∨
            B_val ≤ vM₁' (((k : ℕ) : R_M) * b ^ k * θ₀ * (∑ m ∈ S_p, ξ m)) := by
        have hkb := hvalM₁'_mul_ge 0 (-(k : ℤ) * (t₁ : ℤ))
          ((k : ℕ) : R_M) (b ^ k) (hvalM₁'_natCast k) (hb_pow_val k)
        rw [zero_add] at hkb
        have hθ₀_int : θ₀ = 0 ∨ (0 : ℤ) ≤ vM₁' θ₀ :=
          hvalM₁'_mono 0 V_lin θ₀ hV_lin_nonneg hθ₀_val
        have hkbθ := hvalM₁'_mul_ge (-(k : ℤ) * (t₁ : ℤ)) 0
          (((k : ℕ) : R_M) * b ^ k) θ₀ hkb hθ₀_int
        rw [add_zero] at hkbθ
        have hmul := hvalM₁'_mul_ge (-(k : ℤ) * (t₁ : ℤ)) V_pert
          (((k : ℕ) : R_M) * b ^ k * θ₀) (∑ m ∈ S_p, ξ m) hkbθ hsum_ξ_pert
        refine hvalM₁'_mono B_val _ _ ?_ hmul
        dsimp [B_val]
        exact le_of_eq (by ring)
      have htotal_eq :
          iLM₁' (trLM₁' (b ^ k)) - P_k =
            (∑ m ∈ S_p,
              ((nmM₁'K₁ (Δ_conj m)) ^ k - (W_fn m + b) ^ k - ((k : ℕ) : R_M) * b ^ k * θ₀ * ξ m)) +
              ((k : ℕ) : R_M) * b ^ k * θ₀ * (∑ m ∈ S_p, ξ m) := by
        have htr_k := hΔ_conj_tr k
        dsimp only at htr_k
        rw [← hb_def, ← hS_p_def] at htr_k
        have hPk_eq : P_k = b ^ k + ∑ m ∈ S_p, (W_fn m + b) ^ k := by
          dsimp [P_k]
          rw [← hS_p_def]
          congr 1
          refine Finset.sum_congr rfl fun m hm => ?_
          rw [← hξ_def, (hξ_props m hm).2.2.2.1]
        have hsplit_sum :
            (∑ m ∈ S_p,
              ((nmM₁'K₁ (Δ_conj m)) ^ k - (W_fn m + b) ^ k - ((k : ℕ) : R_M) * b ^ k * θ₀ * ξ m)) =
