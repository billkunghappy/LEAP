  have hΘ_gen_val_res : ∀ (t' k' : ℕ), k' * t = t' * k →
      ∀ i : Fin D_orb.length,
        valL F (D_orb.get i).field ((Θ_gen t' k' i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 0 ∧
        resFi i ((Θ_gen t' k' i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) ≠ 0 := by
    intro t' k' htk i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    have hvFi := ld_valL_and_unitGroup_props F (D_orb.get i).field
    have hval0 : valL F (D_orb.get i).field ((Θ_gen t' k' i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 0 := by
      dsimp only [Θ_gen]
      rw [Units.val_mul,
        hvFi.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_unit_pow (D_orb.get i).field (α_orb i) k',
        hval_unit_pow (D_orb.get i).field _ t',
