  have h2c0_not_dom : ¬ ((2 : L) * (c 0) = 0 ∨ (e : ℤ) + 1 ≤ valL F L ((2 : L) * (c 0))) := by
    intro hdom
    have hce_dom := hvalL_add ((e : ℤ) + 1) ((2 : L) * (c 0)) (traceLM F hLE' r_e) hdom htr_r_e
