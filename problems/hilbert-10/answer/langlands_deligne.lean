        ((recChar F rec M₁' χM₁') cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)))
    (hCritPointwise :
      let e := condExp F L νE' / 2
      let δ_L : Lˣ := ϖ_L ^ e
      let δ_M₁' : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom δ_L
      ∀ (r s : L),
        (r = 0 ∨ 0 ≤ valL F L r) →
        (s = 0 ∨ 0 ≤ valL F L s) →
        (s - r ^ 2 = 0 ∨ 1 ≤ valL F L (s - r ^ 2)) →
        1 + (δ_L : L) * s ≠ 0 ∧
        1 + (δ_M₁' : M₁') * IntermediateField.inclusion hLM₁' s ≠ 0 ∧
