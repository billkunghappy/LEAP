            dsimp [c₀]
            rw [hvalE'_mul _ _ hnat_ne0 hD₀_ne0, hnat_val0, hD₀_val, add_zero]
          by_cases hYj₀ : Y j₀ = 0
          · exact Or.inl hYj₀
          · right
            have hprod_ne0 : c₀ * Y j₀ ≠ 0 := mul_ne_zero hc₀_ne0 hYj₀
            have hle := hprod_val.resolve_left hprod_ne0
            rw [hvalE'_mul c₀ (Y j₀) hc₀_ne0 hYj₀, hc₀_val0, zero_add] at hle
