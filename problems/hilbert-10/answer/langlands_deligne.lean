      htr_LE' htr_LM₁' htr_E'K₁ htr_M₁'K₁ hDiamond_E' hTowerNormTr
      Δ hΔ_val hΔ_basis s₁ s₂ s_LE'
      hs₁_val hs₁_cayley hs₂_val hs₂_cayley hsLE'_val hsLE'_cayley
