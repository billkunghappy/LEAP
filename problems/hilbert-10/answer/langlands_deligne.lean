    have htr_σ : traceLM F hLM₁' (σ z) = traceLM F hLM₁' z :=
      Algebra.trace_eq_of_algEquiv σ_M₁'' (toExtendScalars F hLM₁' z)
    change ψ (traceLM F hLM₁' (σ z)) = ψ (traceLM F hLM₁' z)
    rw [htr_σ]
  have hP_M₁'_map : ∀ (τ : M₁' ≃ₐ[F] M₁') (z : M₁'), τ (P_M₁' z) = P_M₁' (τ z) := by
    intro τ z
    dsimp only [P_M₁']
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, map_inv₀, map_natCast, map_pow]
  
  have hcoprime_inv_mod_p : ∀ j : ℕ, 1 ≤ j → j < p → ∃ m : ℕ, j * j ^ (p - 2) = p * m + 1 := by
    intro j hj1 hj_lt
    haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
    haveI : Fact (1 < p) := ⟨hp_gt1⟩
    have hj_ne0 : ((j : ℕ) : ZMod p) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff]
      exact Nat.not_dvd_of_pos_of_lt (by omega) hj_lt
    have hpow_zmod : ((j * j ^ (p - 2) : ℕ) : ZMod p) = 1 := by
      push_cast
      have h1 : (j : ZMod p) * (j : ZMod p) ^ (p - 2) = (j : ZMod p) ^ (p - 1) := by
        calc (j : ZMod p) * (j : ZMod p) ^ (p - 2)
            = (j : ZMod p) ^ 1 * (j : ZMod p) ^ (p - 2) := by rw [pow_one]
          _ = (j : ZMod p) ^ (1 + (p - 2)) := by rw [← pow_add]
          _ = (j : ZMod p) ^ (p - 1) := by congr 1; omega
      rw [h1]
      exact ZMod.pow_card_sub_one_eq_one hj_ne0
    have hval_zmod := congrArg ZMod.val hpow_zmod
    rw [ZMod.val_natCast, ZMod.val_one p] at hval_zmod
    refine ⟨(j * j ^ (p - 2)) / p, ?_⟩
    have hdiv := Nat.div_add_mod (j * j ^ (p - 2)) p
    omega
  have hvalM₁'_coprime_inv : ∀ j : ℕ, 1 ≤ j → j < p →
      ((j : ℕ) : M₁') ≠ 0 ∧ valL F M₁' (((j : ℕ) : M₁')⁻¹) = 0 := by
    intro j hj1 hj_lt
    obtain ⟨m, hm⟩ := hcoprime_inv_mod_p j hj1 hj_lt
    have hm_M : ((j : ℕ) : M₁') * ((j ^ (p - 2) : ℕ) : M₁') =
