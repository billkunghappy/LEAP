      dsimp [f_mul] at heq
      have h_eq_inv : h₂⁻¹ * h₁ = c₂ * c₁⁻¹ := by
        calc h₂⁻¹ * h₁ = h₂⁻¹ * (h₁ * c₁) * c₁⁻¹ := by group
          _ = h₂⁻¹ * (h₂ * c₂) * c₁⁻¹ := by rw [heq]
          _ = c₂ * c₁⁻¹ := by group
      have h_in_H : h₂⁻¹ * h₁ ∈ H := H.mul_mem (H.inv_mem hh₂) hh₁
      have h_in_C : h₂⁻¹ * h₁ ∈ C := by
        rw [h_eq_inv]
        exact C.mul_mem hc₂ (C.inv_mem hc₁)
