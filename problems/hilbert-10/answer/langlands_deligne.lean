          (tateEps F L lam_L ψ) ^ ℓ := by
        rw [hRest_val]
    _ = (((χM₁' * (lam_L.comp (Units.map (normLM F hLM₁)))⁻¹)
            (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom c_lam) : (Ω F)ˣ) : Ω F) *
          tateEps F E 1 (traceChar F hLE ψ) *
          (tateEps F M₁ 1 (traceChar F hLM₁ ψ) *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j * lam_L) ψ)) := by
        rw [hProd_M₁]
        ring
    _ = tateEps F M₁ χM₁' (traceChar F hLM₁ ψ) * tateEps F E 1 (traceChar F hLE ψ) *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) := by
        rw [← hFML_M₁, hEps_M₁]
        ring

theorem ld_ch12_tame_ramified_cond_one_residue_gauss_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L N : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F N] (hLN : L ≤ N)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLN)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψN : IsAdmissibleChar F N (traceChar F hLN ψ))
    (νN : Lˣ →* (Ω F)ˣ) (χN' : Nˣ →* (Ω F)ˣ)
    (hνN_pow : νN ^ (Module.finrank L (IntermediateField.extendScalars hLN)) = 1)
    (hνN_triv1 : ∀ u ∈ unitGroup F L 1, νN u = 1)
    (hνN_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLN),
      j ≠ 0 → condExp F L (νN ^ j) = 1)
    (hcondN1 : condExp F N χN' = 1)
    (hχN_triv1 : ∀ u ∈ unitGroup F N 1, χN' u = 1)
    (hResDeg : resDeg F N = resDeg F L)
    (hValAlg : ∀ x : L,
      valL F N (IntermediateField.inclusion hLN x) =
        (Module.finrank L (IntermediateField.extendScalars hLN) : ℤ) * valL F L x)
    (hCondψN : condExpChar F N (traceChar F hLN ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLN) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (hResSurj : ∀ y : N, (y = 0 ∨ 0 ≤ valL F N y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLN x = 0 ∨
          1 ≤ valL F N (y - IntermediateField.inclusion hLN x)))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (c₁ : Lˣ) (hc₁_val : valL F L (c₁ : L) = 1 + condExpChar F L ψ)
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (hSpec_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ),
        (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
        (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) ∧
        (condExp F M θ ≠ 0 →
          (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) ∧
          (∃ u₀ ∈ unitGroup F M (condExp F M θ - 1), θ u₀ ≠ 1)) ∧
        valL F M ((tateElt F M θ ψ_M : Mˣ) : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hGauss_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (χ_M : Mˣ →* (Ω F)ˣ), condExp F M χ_M = 1 →
      ∀ (k_R : Type u) [Field k_R] [Fintype k_R] (resR : M → k_R),
        resR 0 = 0 → resR 1 = 1 →
        (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
          resR (x₁ + x₂) = resR x₁ + resR x₂ ∧
          resR (x₁ * x₂) = resR x₁ * resR x₂ ∧
          resR (-x₁) = -resR x₁) →
        (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (resR x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) →
        (∀ a : k_R, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resR x = a) →
        ∀ (c_M : Mˣ), valL F M (c_M : M) = 1 + condExpChar F M ψ_M →
        ∀ (χ_tilde ψ_tilde : k_R → Ω F),
          χ_tilde 0 = 0 →
          (∀ u : Mˣ, valL F M (u : M) = 0 → χ_tilde (resR (u : M)) = (χ_M u : Ω F)⁻¹) →
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            ψ_tilde (resR x) = ψ_M (((c_M⁻¹ : Mˣ) : M) * x)) →
          tateEps F M χ_M ψ_M =
            (qL F M : Ω F) ^ condExpChar F M ψ_M * (χ_M c_M : Ω F) *
              (∑ a : k_R, χ_tilde a * ψ_tilde a)) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLN)
    let n_L := condExpChar F L ψ
    let ψN := traceChar F hLN ψ
    ∃ (hNeChar : (ℓ : k_L) ≠ 0)
      (ψ_k : AddChar k_L (Ω F))
      (ν_k χ_L : k_Lˣ →* (Ω F)ˣ),
      ψ_k ≠ 1 ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ψ_k (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x)) ∧
      ν_k ^ ℓ = 1 ∧
      ν_k ≠ 1 ∧
      (∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
        ν_k a = (νN u)⁻¹ ∧
        χ_L a = (χN' (Units.map (IntermediateField.inclusion hLN).toMonoidHom u))⁻¹) ∧
      tateEps F N 1 ψN = (qL F L : Ω F) ^ ((ℓ : ℤ) * (n_L + 1) - 1) ∧
      (∀ (ψ_k' : AddChar k_L (Ω F)),
        (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
          ψ_k' (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x)) →
        tateEps F N χN' ψN =
          (qL F L : Ω F) ^ ((ℓ : ℤ) * (n_L + 1) - 1) *
            (χN' (Units.map (IntermediateField.inclusion hLN).toMonoidHom c₁) : Ω F) *
            ((χ_L (Units.mk0 (ℓ : k_L) hNeChar))⁻¹ : Ω F) *
            (∑ x : k_Lˣ, (χ_L x : Ω F) * ψ_k' (x : k_L)) ∧
        (∏ j ∈ Finset.range ℓ, tateEps F L (νN ^ j) ψ) =
          ((qL F L : Ω F) ^ n_L) ^ ℓ *
            (∏ j ∈ Finset.range ℓ, ((νN ^ j) c₁ : Ω F)) *
            (∏ j ∈ (Finset.range ℓ).erase 0,
              (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k' (x : k_L)))) :=
by
  classical
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
  obtain ⟨hval0_N, hval1_N, hval_neg1_N, hval_neg_N, hval_mul_N, hval_inv_N, _, hval_add_N,
    hunit0_N, hunit_ge1_N, hunit_val0_N⟩ := hval_all N
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLN)
  set n_L := condExpChar F L ψ
  set ψN := traceChar F hLN ψ
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt

  
  
  
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, _, _⟩ := hSpec_all L ψ hψ 1
  set s_L : k_L → L := fun a => (hresL_surj a).choose
  have hs_L_int : ∀ a : k_L, s_L a = 0 ∨ 0 ≤ valL F L (s_L a) :=
    fun a => (hresL_surj a).choose_spec.1
  have hs_L_res : ∀ a : k_L, resL (s_L a) = a :=
    fun a => (hresL_surj a).choose_spec.2
  have hs_L_ne : ∀ a : k_L, a ≠ 0 → s_L a ≠ 0 := by
    intro a ha h0
    apply ha
    rw [← hs_L_res a, h0, hresL_0]
  have hs_L_val0 : ∀ a : k_L, a ≠ 0 → valL F L (s_L a) = 0 := by
    intro a ha
    have hge0 : 0 ≤ valL F L (s_L a) := (hs_L_int a).resolve_left (hs_L_ne a ha)
    by_contra hne
    have hge1 : 1 ≤ valL F L (s_L a) := by omega
    have hres0 : resL (s_L a) = 0 := (hresL_ker (s_L a) (hs_L_int a)).mpr (Or.inr hge1)
    rw [hs_L_res a] at hres0
    exact ha hres0
  set ψ_tilde : k_L → Ω F := fun a => ψ (((c₁⁻¹ : Lˣ) : L) * s_L a)
  have hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x) := by
    intro x hx_int
    set a : k_L := resL x
    have hneg_s_int : -(s_L a) = 0 ∨ 0 ≤ valL F L (-(s_L a)) := by
      rcases hs_L_int a with hs0 | hsge
      · left; rw [hs0, neg_zero]
      · right; rw [hval_neg_L]; exact hsge
    set d : L := x - s_L a
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 x (-(s_L a)) hx_int hneg_s_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg, (hresL_ring x (-(s_L a)) hx_int hneg_s_int).1,
        (hresL_ring (s_L a) (s_L a) (hs_L_int a) (hs_L_int a)).2.2, hs_L_res a]
      exact add_neg_cancel a
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set w : L := ((c₁⁻¹ : Lˣ) : L) * d
    have hw_cond : w = 0 ∨ -n_L ≤ valL F L w := by
      by_cases hd0 : d = 0
      · left; dsimp only [w]; rw [hd0, mul_zero]
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        dsimp only [w]
        rw [hval_mul_L ((c₁⁻¹ : Lˣ) : L) d (Units.ne_zero c₁⁻¹) hd0,
          hval_inv_L c₁, hc₁_val]
        omega
    have hψ_w : ψ w = 1 := hψ_triv w hw_cond
    have hx_decomp : ((c₁⁻¹ : Lˣ) : L) * x = ((c₁⁻¹ : Lˣ) : L) * s_L a + w := by
      dsimp only [w, d]; ring
    rw [hx_decomp, ψ.map_add_eq_mul, hψ_w, mul_one]
  have hψ_zero : ψ_tilde 0 = 1 := by
    rw [← hresL_0, hψ_int 0 (Or.inl rfl), mul_zero, ψ.map_zero_eq_one]
  have hψ_add : ∀ a b : k_L, ψ_tilde (a + b) = ψ_tilde a * ψ_tilde b := by
    intro a b
    have hab_int : s_L a + s_L b = 0 ∨ 0 ≤ valL F L (s_L a + s_L b) :=
      hval_add_L 0 (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)
    have hab_res : resL (s_L a + s_L b) = a + b := by
      rw [(hresL_ring (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)).1, hs_L_res a, hs_L_res b]
    rw [← hab_res, hψ_int (s_L a + s_L b) hab_int, mul_add, ψ.map_add_eq_mul]
  let ψ_k : AddChar k_L (Ω F) :=
    { toFun := ψ_tilde
      map_zero_eq_one' := hψ_zero
      map_add_eq_mul' := hψ_add }
  have hψ_k_apply : ∀ a : k_L, ψ_k a = ψ_tilde a := fun _ => rfl
  have hψ_k_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_k (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x) :=
    fun x hx => hψ_int x hx
  have hψ_k_ne : ψ_k ≠ 1 := by
    intro hψ1
    set z₁ : L := (c₁ : L) * x₁
    have hz₁_val : 0 ≤ valL F L z₁ := by
      dsimp only [z₁]
      rw [hval_mul_L (c₁ : L) x₁ (Units.ne_zero c₁) hx₁_ne, hc₁_val]
      omega
    have hinv_c₁ : ((c₁⁻¹ : Lˣ) : L) * (c₁ : L) = 1 := by exact_mod_cast Units.inv_mul c₁
    have heval : ψ_k (resL z₁) = ψ x₁ := by
      rw [hψ_k_apply, hψ_int z₁ (Or.inr hz₁_val)]
      dsimp only [z₁]
      rw [← mul_assoc, hinv_c₁, one_mul]
    have h1 : ψ_k (resL z₁) = 1 := by rw [hψ1]; rfl
    exact hx₁_ψ (heval.symm.trans h1)

  set v_unit : k_Lˣ → Lˣ := fun a => Units.mk0 (s_L (a : k_L)) (hs_L_ne (a : k_L) (Units.ne_zero a))
  have hv_unit_val0 : ∀ a : k_Lˣ, valL F L ((v_unit a : Lˣ) : L) = 0 :=
    fun a => hs_L_val0 (a : k_L) (Units.ne_zero a)
  have hv_unit_int : ∀ a : k_Lˣ, ((v_unit a : Lˣ) : L) = 0 ∨ 0 ≤ valL F L ((v_unit a : Lˣ) : L) :=
    fun a => hs_L_int (a : k_L)
  have hv_unit_res : ∀ a : k_Lˣ, resL ((v_unit a : Lˣ) : L) = (a : k_L) :=
    fun a => hs_L_res (a : k_L)
  have hdesc_unit : ∀ (θ : Lˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F L 1, θ u = 1) →
      ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
        (θ (v_unit a))⁻¹ = (θ u)⁻¹ := by
    intro θ hθ1 u a hu_val hu_res
    have hu_int : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
    have hneg_v_int : -((v_unit a : Lˣ) : L) = 0 ∨ 0 ≤ valL F L (-((v_unit a : Lˣ) : L)) := by
      right; rw [hval_neg_L, hv_unit_val0 a]
    set d : L := (u : L) - ((v_unit a : Lˣ) : L)
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 (u : L) (-((v_unit a : Lˣ) : L)) hu_int hneg_v_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg,
        (hresL_ring (u : L) (-((v_unit a : Lˣ) : L)) hu_int hneg_v_int).1,
        (hresL_ring ((v_unit a : Lˣ) : L) ((v_unit a : Lˣ) : L) (hv_unit_int a) (hv_unit_int a)).2.2,
        hu_res, hv_unit_res a, add_neg_cancel]
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set h : Lˣ := (v_unit a)⁻¹ * u
    have hh_sub : (h : L) - 1 = (((v_unit a)⁻¹ : Lˣ) : L) * d := by
      have hinv : (((v_unit a)⁻¹ : Lˣ) : L) * ((v_unit a : Lˣ) : L) = 1 := by
        exact_mod_cast Units.inv_mul (v_unit a)
      calc (h : L) - 1 =
            (((v_unit a)⁻¹ : Lˣ) : L) * (u : L) - (((v_unit a)⁻¹ : Lˣ) : L) * ((v_unit a : Lˣ) : L) := by
            rw [Units.val_mul, hinv]
        _ = (((v_unit a)⁻¹ : Lˣ) : L) * d := by dsimp only [d]; ring
    have hh_mem : h ∈ unitGroup F L 1 := by
      rw [hunit_ge1_L 1 le_rfl h]
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul_L (((v_unit a)⁻¹ : Lˣ) : L) d (Units.ne_zero (v_unit a)⁻¹) hd0,
          hval_inv_L (v_unit a), hv_unit_val0 a]
        omega
    have hθ_h : θ h = 1 := hθ1 h hh_mem
    have hθ_u : θ u = θ (v_unit a) := by
      have huv : v_unit a * h = u := mul_inv_cancel_left (v_unit a) u
      rw [← huv, map_mul, hθ_h, mul_one]
    rw [hθ_u]
  let mkDescChar : ∀ (θ : Lˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F L 1, θ u = 1) → (k_Lˣ →* (Ω F)ˣ) :=
    fun θ hθ1 =>
      { toFun := fun a => (θ (v_unit a))⁻¹
        map_one' := by
          have h1 : (θ (v_unit 1))⁻¹ = (θ 1)⁻¹ :=
            hdesc_unit θ hθ1 1 1 (by rw [Units.val_one, hval1_L]) (by rw [Units.val_one, hresL_1, Units.val_one])
          rw [h1, map_one, inv_one]
        map_mul' := fun a b => by
          have hab_val : valL F L ((v_unit a * v_unit b : Lˣ) : L) = 0 := by
            rw [Units.val_mul,
              hval_mul_L ((v_unit a : Lˣ) : L) ((v_unit b : Lˣ) : L)
                (Units.ne_zero (v_unit a)) (Units.ne_zero (v_unit b)),
              hv_unit_val0 a, hv_unit_val0 b, add_zero]
          have hab_res : resL ((v_unit a * v_unit b : Lˣ) : L) = ((a * b : k_Lˣ) : k_L) := by
            rw [Units.val_mul,
              (hresL_ring ((v_unit a : Lˣ) : L) ((v_unit b : Lˣ) : L)
                (hv_unit_int a) (hv_unit_int b)).2.1,
              hv_unit_res a, hv_unit_res b, Units.val_mul]
          have hm := hdesc_unit θ hθ1 (v_unit a * v_unit b) (a * b) hab_val hab_res
          rw [hm, map_mul, mul_inv] }

  set χNL' : Lˣ →* (Ω F)ˣ := χN'.comp (Units.map (IntermediateField.inclusion hLN).toMonoidHom)
  have hχNL_triv1 : ∀ u ∈ unitGroup F L 1, χNL' u = 1 := by
    intro u hu
    have hu1 : (u : L) = 1 ∨ (1 : ℤ) ≤ valL F L ((u : L) - 1) :=
      (hunit_ge1_L 1 le_rfl u).mp hu
    set w_u : Nˣ := Units.map (IntermediateField.inclusion hLN).toMonoidHom u
    have hw_u_coe : (w_u : N) = IntermediateField.inclusion hLN (u : L) := rfl
    have hw_u_mem : w_u ∈ unitGroup F N 1 := by
      rw [hunit_ge1_N 1 le_rfl w_u]
      rcases hu1 with hu_eq1 | hu_ge1
      · left
        rw [hw_u_coe, hu_eq1, map_one]
      · right
        have hsub : (w_u : N) - 1 = IntermediateField.inclusion hLN ((u : L) - 1) := by
          rw [hw_u_coe, map_sub, map_one]
        rw [hsub, hValAlg ((u : L) - 1)]
        calc (1 : ℤ) ≤ (ℓ : ℤ) * 1 := by omega
          _ ≤ (ℓ : ℤ) * valL F L ((u : L) - 1) :=
            mul_le_mul_of_nonneg_left hu_ge1 (by omega)
    exact hχN_triv1 w_u hw_u_mem

  let ν_k : k_Lˣ →* (Ω F)ˣ := mkDescChar νN hνN_triv1
  let χ_L : k_Lˣ →* (Ω F)ˣ := mkDescChar χNL' hχNL_triv1
  have hν_k_unit : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
      ν_k a = (νN u)⁻¹ := fun u a hu ha => hdesc_unit νN hνN_triv1 u a hu ha
  have hχ_L_unit : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
      χ_L a = (χN' (Units.map (IntermediateField.inclusion hLN).toMonoidHom u))⁻¹ :=
    fun u a hu ha => hdesc_unit χNL' hχNL_triv1 u a hu ha
  have hν_pow : ν_k ^ ℓ = 1 := by
    apply MonoidHom.ext
    intro a
    rw [MonoidHom.pow_apply, MonoidHom.one_apply]
    change (νN (v_unit a))⁻¹ ^ ℓ = 1
    rw [inv_pow, ← MonoidHom.pow_apply, hνN_pow, MonoidHom.one_apply, inv_one]
  have hν_ne : ν_k ≠ 1 := by
    intro hν1
    have hνN_pow1 : νN ^ 1 = νN := by
      apply MonoidHom.ext
      intro x
      rw [MonoidHom.pow_apply, pow_one]
    have hcond_νN : condExp F L νN = 1 := by
      have h1 := hνN_cond_eq 1 hℓ_gt1 one_ne_zero
      rwa [hνN_pow1] at h1
    have hspec_νN := (hSpec_all L ψ hψ νN).2.2.1 (by omega)
    obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := hspec_νN.2
    rw [hcond_νN] at hu₀_mem
    have hu₀_val : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀_mem
    have hu₀_res_ne : resL (u₀ : L) ≠ 0 := by
      intro h0
      rcases (hresL_ker (u₀ : L) (Or.inr (by omega))).mp h0 with h1 | h2
      · exact Units.ne_zero u₀ h1
      · omega
    set a₀ : k_Lˣ := Units.mk0 (resL (u₀ : L)) hu₀_res_ne
    have hνk_a₀ : ν_k a₀ = (νN u₀)⁻¹ := hν_k_unit u₀ a₀ hu₀_val rfl
    have hνk_1 : ν_k a₀ = 1 := by rw [hν1]; rfl
    exact hu₀_ne (inv_eq_one.mp (hνk_a₀.symm.trans hνk_1))

  have hsum_units_kL : ∀ (θ_k : k_Lˣ →* (Ω F)ˣ),
      (∑ a : k_L, (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a) =
        ∑ x : k_Lˣ, (θ_k x : Ω F) * ψ_k (x : k_L) := by
    intro θ_k
    have herase :
        (∑ a : k_L, (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a) =
          ∑ a ∈ (Finset.univ : Finset k_L).erase 0,
            (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a := by
      exact (Finset.sum_erase Finset.univ (by simp)).symm
    rw [herase]
    refine (Finset.sum_bij (fun (x : k_Lˣ) _ => (x : k_L)) ?_ ?_ ?_ ?_).symm
    · intro x _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero x, Finset.mem_univ _⟩
    · intro x₁ _ x₂ _ h
      exact Units.ext h
    · intro a ha
      have ha_ne : a ≠ 0 := (Finset.mem_erase.mp ha).1
      exact ⟨Units.mk0 a ha_ne, Finset.mem_univ _, rfl⟩
    · intro x _
      rw [dif_neg (Units.ne_zero x), Units.mk0_val, hψ_k_apply]

  have hGaussL_eval : ∀ (θ : Lˣ →* (Ω F)ˣ) (θ_k : k_Lˣ →* (Ω F)ˣ),
      condExp F L θ = 1 →
      (∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) → θ_k a = (θ u)⁻¹) →
      tateEps F L θ ψ =
        (qL F L : Ω F) ^ n_L * (θ c₁ : Ω F) *
          (∑ x : k_Lˣ, (θ_k x : Ω F) * ψ_k (x : k_L)) := by
    intro θ θ_k hcond hθ_unit
    set χ_tilde_θ : k_L → Ω F := fun a =>
      if ha : a = 0 then 0 else (θ_k (Units.mk0 a ha) : Ω F)
    have hχ_zero : χ_tilde_θ 0 = 0 := dif_pos rfl
    have hχ_unit : ∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde_θ (resL (u : L)) = (θ u : Ω F)⁻¹ := by
      intro u hu
      have hres_ne : resL (u : L) ≠ 0 := by
        intro h0
        rcases (hresL_ker (u : L) (Or.inr (by omega))).mp h0 with h1 | h2
        · exact Units.ne_zero u h1
        · omega
      dsimp only [χ_tilde_θ]
      rw [dif_neg hres_ne, hθ_unit u (Units.mk0 (resL (u : L)) hres_ne) hu rfl,
        Units.val_inv_eq_inv_val]
    have hG := hGauss_all L ψ hψ θ hcond k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      c₁ hc₁_val χ_tilde_θ ψ_tilde hχ_zero hχ_unit hψ_int
    rw [hG, hsum_units_kL θ_k]

  have htate_ν : ∀ j ∈ (Finset.range ℓ).erase 0,
      tateEps F L (νN ^ j) ψ =
        (qL F L : Ω F) ^ n_L * ((νN ^ j) c₁ : Ω F) *
          (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L)) := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < ℓ := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hcond_j : condExp F L (νN ^ j) = 1 := hνN_cond_eq j hj_lt hj_ne0
    have hunit_j : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
        (ν_k ^ j) a = ((νN ^ j) u)⁻¹ := by
      intro u a hu ha
      rw [MonoidHom.pow_apply, MonoidHom.pow_apply, hν_k_unit u a hu ha, inv_pow]
    exact hGaussL_eval (νN ^ j) (ν_k ^ j) hcond_j hunit_j

  have hcond_one_char : ∀ (M : IntermediateField F (AlgebraicClosure F)),
      condExp F M 1 = 0 := by
    intro M
    exact Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
  have htate_triv : ∀ (M : IntermediateField F (AlgebraicClosure F)) (ψ_M : AddChar M (Ω F)),
      tateEps F M 1 ψ_M = (qL F M : Ω F) ^ condExpChar F M ψ_M := by
    intro M ψ_M
    dsimp only [tateEps]
    rw [if_pos (hcond_one_char M), MonoidHom.one_apply, Units.val_one, mul_one]
  have htate_ν0 : tateEps F L (νN ^ 0) ψ = (qL F L : Ω F) ^ n_L := by
    rw [pow_zero]
    exact htate_triv L ψ

  have h0_mem : 0 ∈ Finset.range ℓ := Finset.mem_range.mpr hℓ_pos
  have hprod_c₁_erase :
      (∏ j ∈ (Finset.range ℓ).erase 0, ((νN ^ j) c₁ : Ω F)) =
        ∏ j ∈ Finset.range ℓ, ((νN ^ j) c₁ : Ω F) := by
    rw [← Finset.mul_prod_erase (Finset.range ℓ) (fun j => ((νN ^ j) c₁ : Ω F)) h0_mem,
      MonoidHom.pow_apply, pow_zero, Units.val_one, one_mul]
  have hprod_ν :
      (∏ j ∈ Finset.range ℓ, tateEps F L (νN ^ j) ψ) =
        ((qL F L : Ω F) ^ n_L) ^ ℓ *
          (∏ j ∈ Finset.range ℓ, ((νN ^ j) c₁ : Ω F)) *
          (∏ j ∈ (Finset.range ℓ).erase 0,
            (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L))) := by
    set Q_L : Ω F := (qL F L : Ω F) ^ n_L
    rw [← Finset.mul_prod_erase (Finset.range ℓ) (fun j => tateEps F L (νN ^ j) ψ) h0_mem,
      htate_ν0, Finset.prod_congr rfl htate_ν,
      Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_const, Finset.card_erase_of_mem h0_mem, Finset.card_range,
      hprod_c₁_erase, ← mul_assoc, ← mul_assoc, ← pow_succ',
      Nat.sub_add_cancel hℓ_pos]

  
  
  
  have hqL_N : qL F N = qL F L := by
    unfold qL
    rw [hResDeg]
  have htate_N1 : tateEps F N 1 ψN = (qL F L : Ω F) ^ ((ℓ : ℤ) * (n_L + 1) - 1) := by
    rw [htate_triv N ψN, hqL_N, hCondψN]

  let resN : N → k_L := fun y =>
    if hy : y = 0 ∨ 0 ≤ valL F N y then resL (hResSurj y hy).choose else 0
  have hinc_int_N : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (IntermediateField.inclusion hLN x = 0 ∨ 0 ≤ valL F N (IntermediateField.inclusion hLN x)) := by
    intro x hx
    rcases hx with rfl | hx_ge0
    · left; exact map_zero _
    · right; rw [hValAlg x]; exact mul_nonneg (by omega) hx_ge0
  have hinc_p1_N : ∀ x : L,
      (IntermediateField.inclusion hLN x = 0 ∨ 1 ≤ valL F N (IntermediateField.inclusion hLN x)) ↔
        (x = 0 ∨ 1 ≤ valL F L x) := by
    intro x
    constructor
    · intro h
      rcases h with h0 | hge1
      · left
        exact (IntermediateField.inclusion hLN).injective (h0.trans (map_zero _).symm)
      · right
        rw [hValAlg x] at hge1
        by_contra hlt
        have hle0 : valL F L x ≤ 0 := by omega
        have hmul_le0 : (ℓ : ℤ) * valL F L x ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
        omega
    · intro h
      rcases h with rfl | hge1
      · left; exact map_zero _
      · right
        rw [hValAlg x]
        calc (1 : ℤ) ≤ (ℓ : ℤ) * 1 := by omega
          _ ≤ (ℓ : ℤ) * valL F L x := mul_le_mul_of_nonneg_left hge1 (by omega)
  have hvalN_sub : ∀ (k : ℤ) (y₁ y₂ : N),
      (y₁ = 0 ∨ k ≤ valL F N y₁) → (y₂ = 0 ∨ k ≤ valL F N y₂) →
        (y₁ - y₂ = 0 ∨ k ≤ valL F N (y₁ - y₂)) := by
    intro k y₁ y₂ hy₁ hy₂
    have hneg₂ : -y₂ = 0 ∨ k ≤ valL F N (-y₂) := by
      rcases hy₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_N]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_N k y₁ (-y₂) hy₁ hneg₂
  have hvalL_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    have hneg₂ : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_L k x₁ (-x₂) hx₁ hneg₂
  have hresN_char : ∀ (y : N) (hy : y = 0 ∨ 0 ≤ valL F N y) (x : L)
      (hx : x = 0 ∨ 0 ≤ valL F L x),
      (y - IntermediateField.inclusion hLN x = 0 ∨
        1 ≤ valL F N (y - IntermediateField.inclusion hLN x)) →
      resN y = resL x := by
    intro y hy x hx hyx
    dsimp only [resN]
    rw [dif_pos hy]
    set x₀ : L := (hResSurj y hy).choose
    have hx₀_int : x₀ = 0 ∨ 0 ≤ valL F L x₀ := (hResSurj y hy).choose_spec.1
    have hyx₀ : y - IntermediateField.inclusion hLN x₀ = 0 ∨
        1 ≤ valL F N (y - IntermediateField.inclusion hLN x₀) := (hResSurj y hy).choose_spec.2
    have hinc_diff_eq :
        IntermediateField.inclusion hLN (x₀ - x) =
          (y - IntermediateField.inclusion hLN x) - (y - IntermediateField.inclusion hLN x₀) := by
      rw [map_sub]; ring
    have hinc_diff_p1 :
        IntermediateField.inclusion hLN (x₀ - x) = 0 ∨
          1 ≤ valL F N (IntermediateField.inclusion hLN (x₀ - x)) := by
      rw [hinc_diff_eq]
      exact hvalN_sub 1 _ _ hyx hyx₀
    have hdiff_p1 : x₀ - x = 0 ∨ 1 ≤ valL F L (x₀ - x) := (hinc_p1_N (x₀ - x)).mp hinc_diff_p1
    have hdiff_int : x₀ - x = 0 ∨ 0 ≤ valL F L (x₀ - x) := hvalL_sub 0 x₀ x hx₀_int hx
    have hres_diff : resL (x₀ - x) = 0 := (hresL_ker (x₀ - x) hdiff_int).mpr hdiff_p1
    have hneg_x_int : -x = 0 ∨ 0 ≤ valL F L (-x) := by
      rcases hx with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    have hres_sub : resL (x₀ - x) = resL x₀ - resL x := by
      rw [sub_eq_add_neg, (hresL_ring x₀ (-x) hx₀_int hneg_x_int).1,
        (hresL_ring x x hx hx).2.2, sub_eq_add_neg]
    exact sub_eq_zero.mp (hres_sub ▸ hres_diff)
  have hresN_inc : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resN (IntermediateField.inclusion hLN x) = resL x := by
    intro x hx
    exact hresN_char (IntermediateField.inclusion hLN x) (hinc_int_N x hx) x hx
      (Or.inl (sub_self _))
  have hresN_0 : resN 0 = 0 := by
    have h := hresN_inc 0 (Or.inl rfl)
    rwa [map_zero, hresL_0] at h
  have hresN_1 : resN 1 = 1 := by
    have h := hresN_inc 1 (Or.inr (by rw [hval1_L]))
    rwa [map_one, hresL_1] at h
  have hresN_surj : ∀ a : k_L, ∃ y : N, (y = 0 ∨ 0 ≤ valL F N y) ∧ resN y = a := by
    intro a
    exact ⟨IntermediateField.inclusion hLN (s_L a), hinc_int_N (s_L a) (hs_L_int a),
      (hresN_inc (s_L a) (hs_L_int a)).trans (hs_L_res a)⟩
  have hvalN_mul_int : ∀ (y₁ y₂ : N) (k₁ k₂ : ℤ),
      (y₁ = 0 ∨ k₁ ≤ valL F N y₁) → (y₂ = 0 ∨ k₂ ≤ valL F N y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F N (y₁ * y₂)) := by
    intro y₁ y₂ k₁ k₂ hy₁ hy₂
    by_cases hy₁0 : y₁ = 0
    · left; rw [hy₁0, zero_mul]
    · by_cases hy₂0 : y₂ = 0
      · left; rw [hy₂0, mul_zero]
      · right
        have h1 := hy₁.resolve_left hy₁0
        have h2 := hy₂.resolve_left hy₂0
        rw [hval_mul_N y₁ y₂ hy₁0 hy₂0]
        omega
  have hvalL_mul_int : ∀ (x₁ x₂ : L) (k₁ k₂ : ℤ),
      (x₁ = 0 ∨ k₁ ≤ valL F L x₁) → (x₂ = 0 ∨ k₂ ≤ valL F L x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ k₁ k₂ hx₁ hx₂
    by_cases hx₁0 : x₁ = 0
    · left; rw [hx₁0, zero_mul]
    · by_cases hx₂0 : x₂ = 0
      · left; rw [hx₂0, mul_zero]
      · right
        have h1 := hx₁.resolve_left hx₁0
        have h2 := hx₂.resolve_left hx₂0
        rw [hval_mul_L x₁ x₂ hx₁0 hx₂0]
        omega
  have hresN_ring : ∀ y₁ y₂ : N, (y₁ = 0 ∨ 0 ≤ valL F N y₁) → (y₂ = 0 ∨ 0 ≤ valL F N y₂) →
      resN (y₁ + y₂) = resN y₁ + resN y₂ ∧
      resN (y₁ * y₂) = resN y₁ * resN y₂ ∧
      resN (-y₁) = -resN y₁ := by
    intro y₁ y₂ hy₁ hy₂
    obtain ⟨x₁, hx₁_int, hy₁_x₁⟩ := hResSurj y₁ hy₁
    obtain ⟨x₂, hx₂_int, hy₂_x₂⟩ := hResSurj y₂ hy₂
    have hr₁ : resN y₁ = resL x₁ := hresN_char y₁ hy₁ x₁ hx₁_int hy₁_x₁
    have hr₂ : resN y₂ = resL x₂ := hresN_char y₂ hy₂ x₂ hx₂_int hy₂_x₂
    have hringL := hresL_ring x₁ x₂ hx₁_int hx₂_int
    refine ⟨?_, ?_, ?_⟩
    · have hy_add : y₁ + y₂ = 0 ∨ 0 ≤ valL F N (y₁ + y₂) := hval_add_N 0 y₁ y₂ hy₁ hy₂
      have hx_add : x₁ + x₂ = 0 ∨ 0 ≤ valL F L (x₁ + x₂) := hval_add_L 0 x₁ x₂ hx₁_int hx₂_int
      have hdiff_eq : (y₁ + y₂) - IntermediateField.inclusion hLN (x₁ + x₂) =
          (y₁ - IntermediateField.inclusion hLN x₁) + (y₂ - IntermediateField.inclusion hLN x₂) := by
        rw [map_add]; ring
      have hdiff_p1 : (y₁ + y₂) - IntermediateField.inclusion hLN (x₁ + x₂) = 0 ∨
          1 ≤ valL F N ((y₁ + y₂) - IntermediateField.inclusion hLN (x₁ + x₂)) := by
        rw [hdiff_eq]
        exact hval_add_N 1 _ _ hy₁_x₁ hy₂_x₂
      rw [hresN_char (y₁ + y₂) hy_add (x₁ + x₂) hx_add hdiff_p1, hringL.1, hr₁, hr₂]
    · have hy_mul : y₁ * y₂ = 0 ∨ 0 ≤ valL F N (y₁ * y₂) := by
        simpa using hvalN_mul_int y₁ y₂ 0 0 hy₁ hy₂
      have hx_mul : x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂) := by
        simpa using hvalL_mul_int x₁ x₂ 0 0 hx₁_int hx₂_int
      have hdiff_eq : y₁ * y₂ - IntermediateField.inclusion hLN (x₁ * x₂) =
          (y₁ - IntermediateField.inclusion hLN x₁) * y₂ +
            IntermediateField.inclusion hLN x₁ * (y₂ - IntermediateField.inclusion hLN x₂) := by
        rw [map_mul]; ring
      have ht1 : (y₁ - IntermediateField.inclusion hLN x₁) * y₂ = 0 ∨
          1 ≤ valL F N ((y₁ - IntermediateField.inclusion hLN x₁) * y₂) := by
        simpa using hvalN_mul_int _ y₂ 1 0 hy₁_x₁ hy₂
      have ht2 : IntermediateField.inclusion hLN x₁ * (y₂ - IntermediateField.inclusion hLN x₂) = 0 ∨
          1 ≤ valL F N (IntermediateField.inclusion hLN x₁ * (y₂ - IntermediateField.inclusion hLN x₂)) := by
        simpa using hvalN_mul_int _ _ 0 1 (hinc_int_N x₁ hx₁_int) hy₂_x₂
      have hdiff_p1 : y₁ * y₂ - IntermediateField.inclusion hLN (x₁ * x₂) = 0 ∨
          1 ≤ valL F N (y₁ * y₂ - IntermediateField.inclusion hLN (x₁ * x₂)) := by
        rw [hdiff_eq]
        exact hval_add_N 1 _ _ ht1 ht2
      rw [hresN_char (y₁ * y₂) hy_mul (x₁ * x₂) hx_mul hdiff_p1, hringL.2.1, hr₁, hr₂]
    · have hy_neg : -y₁ = 0 ∨ 0 ≤ valL F N (-y₁) := by
        rcases hy₁ with rfl | hge
        · left; exact neg_zero
        · right; rw [hval_neg_N]; exact hge
      have hx_neg : -x₁ = 0 ∨ 0 ≤ valL F L (-x₁) := by
        rcases hx₁_int with rfl | hge
        · left; exact neg_zero
        · right; rw [hval_neg_L]; exact hge
      have hdiff_eq : -y₁ - IntermediateField.inclusion hLN (-x₁) =
          -(y₁ - IntermediateField.inclusion hLN x₁) := by
        rw [map_neg]; ring
      have hdiff_p1 : -y₁ - IntermediateField.inclusion hLN (-x₁) = 0 ∨
          1 ≤ valL F N (-y₁ - IntermediateField.inclusion hLN (-x₁)) := by
        rw [hdiff_eq]
        rcases hy₁_x₁ with h0 | hge1
        · left; rw [h0, neg_zero]
        · right; rw [hval_neg_N]; exact hge1
      rw [hresN_char (-y₁) hy_neg (-x₁) hx_neg hdiff_p1, hringL.2.2, hr₁]
  have hresN_ker : ∀ y : N, (y = 0 ∨ 0 ≤ valL F N y) →
      (resN y = 0 ↔ (y = 0 ∨ 1 ≤ valL F N y)) := by
    intro y hy
    obtain ⟨x, hx_int, hyx⟩ := hResSurj y hy
    rw [hresN_char y hy x hx_int hyx, hresL_ker x hx_int, ← hinc_p1_N x]
    constructor
    · intro hinc
      have hy_eq : y = (y - IntermediateField.inclusion hLN x) + IntermediateField.inclusion hLN x := by
        ring
      rw [hy_eq]
      exact hval_add_N 1 _ _ hyx hinc
    · intro hy_p1
      have hinc_eq : IntermediateField.inclusion hLN x = y - (y - IntermediateField.inclusion hLN x) := by
        ring
      rw [hinc_eq]
      exact hvalN_sub 1 _ _ hy_p1 hyx

  set c₁_N : Nˣ := Units.map (IntermediateField.inclusion hLN).toMonoidHom c₁
  have hc₁_N_coe : (c₁_N : N) = IntermediateField.inclusion hLN (c₁ : L) := rfl
  have hc₁_N_inv_coe : ((c₁_N⁻¹ : Nˣ) : N) =
      IntermediateField.inclusion hLN ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_N_val : valL F N (c₁_N : N) = 1 + condExpChar F N ψN := by
    rw [hc₁_N_coe, hValAlg (c₁ : L), hc₁_val, hCondψN]
    ring
  let N' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLN
  have hto_inc_N : ∀ x : L,
      toExtendScalars F hLN (IntermediateField.inclusion hLN x) = algebraMap L N' x :=
    fun _ => rfl
  have htrace_inc_N : ∀ x : L,
      traceLM F hLN (IntermediateField.inclusion hLN x) = (ℓ : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change Algebra.trace L N' (toExtendScalars F hLN (IntermediateField.inclusion hLN x)) = (ℓ : L) * x
    rw [hto_inc_N x, Algebra.trace_algebraMap x, nsmul_eq_mul]

  set χ_tilde_N : k_L → Ω F := fun a =>
    if ha : a = 0 then 0 else (χ_L (Units.mk0 a ha) : Ω F)
  set ψ_tilde_N : k_L → Ω F := fun a => ψ_k ((ℓ : k_L) * a)
  have hχN_zero : χ_tilde_N 0 = 0 := dif_pos rfl
  have hχN_unit : ∀ w : Nˣ, valL F N (w : N) = 0 →
      χ_tilde_N (resN (w : N)) = (χN' w : Ω F)⁻¹ := by
    intro w hw_val
    have hw_int : (w : N) = 0 ∨ 0 ≤ valL F N (w : N) := Or.inr (by omega)
    obtain ⟨x, hx_int, hwx⟩ := hResSurj (w : N) hw_int
    have hres_w : resN (w : N) = resL x := hresN_char (w : N) hw_int x hx_int hwx
    have hres_w_ne : resN (w : N) ≠ 0 := by
      intro h0
      rcases (hresN_ker (w : N) hw_int).mp h0 with h1 | h2
      · exact Units.ne_zero w h1
      · omega
    have hres_x_ne : resL x ≠ 0 := hres_w ▸ hres_w_ne
    have hx_ne : x ≠ 0 := by
      intro h0; apply hres_x_ne; rw [h0, hresL_0]
    have hx_val0 : valL F L x = 0 := by
      have hge0 : 0 ≤ valL F L x := hx_int.resolve_left hx_ne
      by_contra hne0
      have hge1 : 1 ≤ valL F L x := by omega
      exact hres_x_ne ((hresL_ker x hx_int).mpr (Or.inr hge1))
    set u_x : Lˣ := Units.mk0 x hx_ne
    set w_x : Nˣ := Units.map (IntermediateField.inclusion hLN).toMonoidHom u_x
    have hw_x_coe : (w_x : N) = IntermediateField.inclusion hLN x := rfl
    have hw_x_val0 : valL F N (w_x : N) = 0 := by
      rw [hw_x_coe, hValAlg x, hx_val0, mul_zero]
    set h : Nˣ := w_x⁻¹ * w
    have hh_sub : (h : N) - 1 = ((w_x⁻¹ : Nˣ) : N) * ((w : N) - IntermediateField.inclusion hLN x) := by
      have hinv : ((w_x⁻¹ : Nˣ) : N) * IntermediateField.inclusion hLN x = 1 := by
        exact_mod_cast Units.inv_mul w_x
      calc (h : N) - 1 = ((w_x⁻¹ : Nˣ) : N) * (w : N) - ((w_x⁻¹ : Nˣ) : N) * IntermediateField.inclusion hLN x := by
            rw [Units.val_mul, hinv]
        _ = ((w_x⁻¹ : Nˣ) : N) * ((w : N) - IntermediateField.inclusion hLN x) := by ring
    have hh_mem : h ∈ unitGroup F N 1 := by
      rw [hunit_ge1_N 1 le_rfl h]
      rcases hwx with hd0 | hd1
      · left
        have hsub0 : (h : N) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ne : (w : N) - IntermediateField.inclusion hLN x ≠ 0 := by
          intro h0; rw [h0, hval0_N] at hd1; omega
        rw [hh_sub, hval_mul_N ((w_x⁻¹ : Nˣ) : N) _ (Units.ne_zero w_x⁻¹) hd_ne,
          hval_inv_N w_x, hw_x_val0]
        omega
    have hχN_h : χN' h = 1 := hχN_triv1 h hh_mem
    have hχN_w : χN' w = χN' w_x := by
      have hww : w_x * h = w := mul_inv_cancel_left w_x w
      rw [← hww, map_mul, hχN_h, mul_one]
    set a_w : k_Lˣ := Units.mk0 (resN (w : N)) hres_w_ne
    have hχL_aw : χ_L a_w = (χN' w_x)⁻¹ := hχ_L_unit u_x a_w hx_val0 hres_w.symm
    dsimp only [χ_tilde_N]
    rw [dif_neg hres_w_ne]
    change (χ_L a_w : Ω F) = (χN' w : Ω F)⁻¹
    rw [hχL_aw, hχN_w, Units.val_inv_eq_inv_val]

  have hnat_int_resL : ∀ m : ℕ,
      ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      refine ⟨Or.inl (Nat.cast_zero), ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ m ih =>
      have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hval1_L])
      have hm1_int : ((m : L) + 1) = 0 ∨ 0 ≤ valL F L ((m : L) + 1) :=
        hval_add_L 0 (m : L) 1 ih.1 h1_int
      refine ⟨by simpa [Nat.cast_succ] using hm1_int, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1, Nat.cast_succ]

  obtain ⟨hψN_triv, ⟨y₁, hy₁_ne, hy₁_val, hy₁_ψN⟩, _, _⟩ :=
    hSpec_all N ψN hψN χN'
  have hψN_int : ∀ y : N, (y = 0 ∨ 0 ≤ valL F N y) →
      ψ_tilde_N (resN y) = ψN (((c₁_N⁻¹ : Nˣ) : N) * y) := by
    intro y hy
    obtain ⟨x, hx_int, hyx⟩ := hResSurj y hy
    have hres_y : resN y = resL x := hresN_char y hy x hx_int hyx
    set z : N := y - IntermediateField.inclusion hLN x
    set w_z : N := ((c₁_N⁻¹ : Nˣ) : N) * z
    have hw_z_cond : w_z = 0 ∨ -condExpChar F N ψN ≤ valL F N w_z := by
      by_cases hz0 : z = 0
      · left; dsimp only [w_z]; rw [hz0, mul_zero]
      · right
        have hz_ge1 : 1 ≤ valL F N z := hyx.resolve_left hz0
        dsimp only [w_z]
        rw [hval_mul_N ((c₁_N⁻¹ : Nˣ) : N) z (Units.ne_zero c₁_N⁻¹) hz0,
          hval_inv_N c₁_N, hc₁_N_val]
        omega
    have hψN_wz : ψN w_z = 1 := hψN_triv w_z hw_z_cond
    have hy_decomp : ((c₁_N⁻¹ : Nˣ) : N) * y =
        IntermediateField.inclusion hLN (((c₁⁻¹ : Lˣ) : L) * x) + w_z := by
      dsimp only [w_z, z]
      rw [hc₁_N_inv_coe, map_mul]
      ring
    have htr_inc_cx :
        ψN (IntermediateField.inclusion hLN (((c₁⁻¹ : Lˣ) : L) * x)) =
          ψ (((c₁⁻¹ : Lˣ) : L) * ((ℓ : L) * x)) := by
      change ψ (traceLM F hLN (IntermediateField.inclusion hLN (((c₁⁻¹ : Lˣ) : L) * x))) = _
      rw [htrace_inc_N]
      congr 1
      ring
    have hℓ_int : (ℓ : L) = 0 ∨ 0 ≤ valL F L (ℓ : L) := (hnat_int_resL ℓ).1
    have hℓ_res : resL (ℓ : L) = (ℓ : k_L) := (hnat_int_resL ℓ).2
    have hℓx_int : (ℓ : L) * x = 0 ∨ 0 ≤ valL F L ((ℓ : L) * x) := by
      simpa using hvalL_mul_int (ℓ : L) x 0 0 hℓ_int hx_int
    have hℓx_res : resL ((ℓ : L) * x) = (ℓ : k_L) * resN y := by
      rw [(hresL_ring (ℓ : L) x hℓ_int hx_int).2.1, hℓ_res, hres_y]
    rw [hy_decomp, ψN.map_add_eq_mul, hψN_wz, mul_one, htr_inc_cx,
      ← hψ_int ((ℓ : L) * x) hℓx_int, ← hψ_k_apply, hℓx_res]

  have hNeChar : (ℓ : k_L) ≠ 0 := by
    intro hℓ0
    set y₀ : N := (c₁_N : N) * y₁
    have hy₀_val : 0 ≤ valL F N y₀ := by
      dsimp only [y₀]
      rw [hval_mul_N (c₁_N : N) y₁ (Units.ne_zero c₁_N) hy₁_ne, hc₁_N_val]
      omega
    have hinv_c₁N : ((c₁_N⁻¹ : Nˣ) : N) * (c₁_N : N) = 1 := by exact_mod_cast Units.inv_mul c₁_N
    have heval : ψ_tilde_N (resN y₀) = ψN y₁ := by
      rw [hψN_int y₀ (Or.inr hy₀_val)]
      dsimp only [y₀]
      rw [← mul_assoc, hinv_c₁N, one_mul]
    have h1 : ψ_tilde_N (resN y₀) = 1 := by
      dsimp only [ψ_tilde_N]
      rw [hℓ0, zero_mul, ψ_k.map_zero_eq_one]
    exact hy₁_ψN (heval.symm.trans h1)

  have hGaussN_raw := hGauss_all N ψN hψN χN' hcondN1
    k_L resN hresN_0 hresN_1 hresN_ring hresN_ker hresN_surj
    c₁_N hc₁_N_val χ_tilde_N ψ_tilde_N hχN_zero hχN_unit hψN_int
  set ℓ_u : k_Lˣ := Units.mk0 (ℓ : k_L) hNeChar
  have hsum_N_units :
      (∑ a : k_L, χ_tilde_N a * ψ_tilde_N a) =
        ∑ u : k_Lˣ, (χ_L u : Ω F) * ψ_k ((ℓ : k_L) * (u : k_L)) := by
    have herase :
        (∑ a : k_L, χ_tilde_N a * ψ_tilde_N a) =
          ∑ a ∈ (Finset.univ : Finset k_L).erase 0, χ_tilde_N a * ψ_tilde_N a := by
      exact (Finset.sum_erase Finset.univ (by rw [hχN_zero, zero_mul])).symm
    rw [herase]
    refine (Finset.sum_bij (fun (u : k_Lˣ) _ => (u : k_L)) ?_ ?_ ?_ ?_).symm
    · intro u _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero u, Finset.mem_univ _⟩
    · intro u₁ _ u₂ _ h
      exact Units.ext h
    · intro a ha
      have ha_ne : a ≠ 0 := (Finset.mem_erase.mp ha).1
      exact ⟨Units.mk0 a ha_ne, Finset.mem_univ _, rfl⟩
    · intro u _
      dsimp only [χ_tilde_N, ψ_tilde_N]
      rw [dif_neg (Units.ne_zero u), Units.mk0_val]
  have hsum_N_reindex :
      (∑ u : k_Lˣ, (χ_L u : Ω F) * ψ_k ((ℓ : k_L) * (u : k_L))) =
        ((χ_L ℓ_u)⁻¹ : Ω F) *
          (∑ x : k_Lˣ, (χ_L x : Ω F) * ψ_k (x : k_L)) := by
    rw [Finset.mul_sum]
    refine Finset.sum_bij (fun (u : k_Lˣ) _ => ℓ_u * u) ?_ ?_ ?_ ?_
    · intro u _; exact Finset.mem_univ _
    · intro u₁ _ u₂ _ h; exact mul_left_cancel h
    · intro x _
      exact ⟨ℓ_u⁻¹ * x, Finset.mem_univ _, mul_inv_cancel_left ℓ_u x⟩
    · intro u _
      have hval_mul : ((ℓ : k_L) * (u : k_L)) = ((ℓ_u * u : k_Lˣ) : k_L) := rfl
      have hχ_mul_u : (χ_L (ℓ_u * u) : Ω F) =
          (χ_L ℓ_u : Ω F) * (χ_L u : Ω F) := by
        rw [map_mul, Units.val_mul]
      have hinv_cancel :
          ((χ_L ℓ_u)⁻¹ : Ω F) * (χ_L ℓ_u : Ω F) = 1 := by
        rw [← Units.val_inv_eq_inv_val, ← Units.val_mul, inv_mul_cancel, Units.val_one]
      rw [hval_mul, hχ_mul_u, ← mul_assoc, ← mul_assoc, hinv_cancel, one_mul]
  have htate_Nχ :
      tateEps F N χN' ψN =
        (qL F L : Ω F) ^ ((ℓ : ℤ) * (n_L + 1) - 1) *
          (χN' c₁_N : Ω F) *
          ((χ_L ℓ_u)⁻¹ : Ω F) *
          (∑ x : k_Lˣ, (χ_L x : Ω F) * ψ_k (x : k_L)) := by
    rw [hGaussN_raw, hqL_N, hCondψN, hsum_N_units, hsum_N_reindex]
    ring

  have hψ_k'_eq : ∀ (ψ_k' : AddChar k_L (Ω F)),
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ψ_k' (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x)) →
      ψ_k' = ψ_k := by
    intro ψ_k' hψ_k'
    apply AddChar.ext
    intro a
    rw [← hs_L_res a, hψ_k' (s_L a) (hs_L_int a), hψ_k_apply, hs_L_res a]

  refine ⟨hNeChar, ψ_k, ν_k, χ_L, hψ_k_ne, hψ_k_int, hν_pow, hν_ne,
    fun u a hu ha => ⟨hν_k_unit u a hu ha, hχ_L_unit u a hu ha⟩,
    htate_N1, ?_⟩
  intro ψ_k' hψ_k'
  rw [hψ_k'_eq ψ_k' hψ_k']
  exact ⟨htate_Nχ, hprod_ν⟩

theorem ld_ch12_unramified_galois_frob_and_trace_norm_compat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M] (hLM : L ≤ M)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM)))
    (hval_norm : ∀ z : M, valL F L (normLM F hLM z) =
      (Module.finrank L (IntermediateField.extendScalars hLM) : ℤ) * valL F M z)
    (htr_bound : ∀ (m : ℤ) (z : M), (z = 0 ∨ m ≤ valL F M z) →
      (traceLM F hLM z = 0 ∨ m ≤ valL F L (traceLM F hLM z)))
    (hvalM_props : valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))))
    (G : Type u) [Group G] [Fintype G] (act : G → M → M)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLM))
    (hact_one : ∀ z : M, act 1 z = z)
    (hact_mul : ∀ (σ τ : G) (z : M), act (σ * τ) z = act σ (act τ z))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ z₁ z₂ : M,
        act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
        act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
        act σ (-z₁) = -act σ z₁))
    (hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLM x) = IntermediateField.inclusion hLM x)
    (hact_faithful : ∀ σ : G, (∀ z : M, act σ z = z) → σ = 1)
    (hact_val : ∀ (σ : G) (z : M), valL F M (act σ z) = valL F M z)
    (hact_trace : ∀ z : M, IntermediateField.inclusion hLM (traceLM F hLM z) = ∑ σ : G, act σ z)
    (hact_norm : ∀ z : M, IntermediateField.inclusion hLM (normLM F hLM z) = ∏ σ : G, act σ z)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] [CharP k_L (p F)] [CharP k_M (p F)]
    (resL : L → k_L) (resM : M → k_M)
    (hfinrank_res : Module.finrank k_L k_M =
      Module.finrank L (IntermediateField.extendScalars hLM))
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ z₁ z₂ : M, (z₁ = 0 ∨ 0 ≤ valL F M z₁) → (z₂ = 0 ∨ 0 ≤ valL F M z₂) →
      resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
      resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
      resM (-z₁) = -resM z₁)
    (hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resM (IntermediateField.inclusion hLM x) = algebraMap k_L k_M (resL x))
    (π_res : G →* (k_M ≃ₐ[k_L] k_M))
    (hπ_inj : Function.Injective π_res)
    (hπ_res : ∀ (σ : G) (z : M), (z = 0 ∨ 0 ≤ valL F M z) →
      π_res σ (resM z) = resM (act σ z)) :
    (∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
      resL (traceLM F hLM z) = Algebra.trace k_L k_M (resM z) ∧
      resL (normLM F hLM z) = Algebra.norm k_L (resM z)) ∧
    ∃ (σ_frob : M ≃ₐ[F] M),
      (∀ x : L, σ_frob (IntermediateField.inclusion hLM x) =
        IntermediateField.inclusion hLM x) ∧
      σ_frob ≠ 1 ∧
      (∀ z : M, valL F M (σ_frob z) = valL F M z) ∧
      (∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
        resM (σ_frob z) = (resM z) ^ (Fintype.card k_L)) :=
by
  rcases hvalM_props with ⟨hvalM0, hvalM1, hvalM_neg1, hvalM_neg, hvalM_mul, hvalM_inv, hvalM_add⟩
  haveI : FiniteDimensional k_L k_M := Module.Finite.of_finite
  set ℓ := Module.finrank k_L k_M
  have hPrime_res : Nat.Prime ℓ := hfinrank_res.symm ▸ hPrime
  have hℓ_pos : 0 < ℓ := hPrime_res.pos
  have hcard_G_res : Fintype.card G = ℓ := hcard_G.trans hfinrank_res.symm
  let H : Subgroup (k_M ≃ₐ[k_L] k_M) := π_res.range
  have hcard_H : Nat.card H = Fintype.card G := by
    change Nat.card (Set.range π_res) = Fintype.card G
    rw [Nat.card_range_of_injective hπ_inj, Nat.card_eq_fintype_card]
  have hfin_H : Module.finrank ↥(IntermediateField.fixedField H) k_M = ℓ := by
    rw [IntermediateField.finrank_fixedField_eq_card H, hcard_H, hcard_G_res]
  have hmul_H := Module.finrank_mul_finrank k_L ↥(IntermediateField.fixedField H) k_M
  have hfin_kL_H : Module.finrank k_L ↥(IntermediateField.fixedField H) = 1 := by
    nlinarith
  have hle_fixed : IntermediateField.fixedField (⊤ : Subgroup (k_M ≃ₐ[k_L] k_M)) ≤
      IntermediateField.fixedField H := by
    intro x hx ⟨φ, _⟩
    exact hx ⟨φ, Subgroup.mem_top φ⟩
  have hmono_top : Module.finrank k_L ↥(IntermediateField.fixedField (⊤ : Subgroup (k_M ≃ₐ[k_L] k_M))) ≤
      Module.finrank k_L ↥(IntermediateField.fixedField H) :=
    @Submodule.finrank_mono k_L k_M _ _ _ _
      (IntermediateField.fixedField (⊤ : Subgroup (k_M ≃ₐ[k_L] k_M))).toSubalgebra.toSubmodule
      (IntermediateField.fixedField H).toSubalgebra.toSubmodule _ (fun x hx => hle_fixed hx)
  have hbot_eq : (⊥ : IntermediateField k_L k_M) =
      IntermediateField.fixedField (⊤ : Subgroup (k_M ≃ₐ[k_L] k_M)) := by
    apply IntermediateField.eq_of_le_of_finrank_le bot_le
    rw [IntermediateField.finrank_bot]
    omega
  haveI : IsGalois k_L k_M := IsGalois.of_fixedField_eq_bot k_L k_M hbot_eq.symm
  have hcard_aut : Fintype.card (k_M ≃ₐ[k_L] k_M) = Fintype.card G := by
    rw [Fintype.card_eq_nat_card, IsGalois.card_aut_eq_finrank k_L k_M]
    exact hcard_G_res.symm
  have hπ_bij : Function.Bijective π_res :=
    (Fintype.bijective_iff_injective_and_card π_res).mpr ⟨hπ_inj, hcard_aut.symm⟩
  let e_π : G ≃ (k_M ≃ₐ[k_L] k_M) := Equiv.ofBijective π_res hπ_bij
  have hIntM_add : ∀ x₁ x₂ : M,
      (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      (x₁ + x₂ = 0 ∨ 0 ≤ valL F M (x₁ + x₂)) := hvalM_add 0
  have hIntM_mul : ∀ x₁ x₂ : M,
      (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      (x₁ * x₂ = 0 ∨ 0 ≤ valL F M (x₁ * x₂)) := by
    intro x₁ x₂ hx₁ hx₂
    by_cases h1 : x₁ = 0
    · exact Or.inl (by simp [h1])
    · by_cases h2 : x₂ = 0
      · exact Or.inl (by simp [h2])
      · right
        rw [hvalM_mul x₁ x₂ h1 h2]
        rcases hx₁ with rfl | hx₁
        · exact False.elim (h1 rfl)
        · rcases hx₂ with rfl | hx₂
          · exact False.elim (h2 rfl)
          · omega
  refine ⟨?_, ?_⟩
  · intro y hy
    set b : k_M := resM y
    have htr_b : algebraMap k_L k_M (Algebra.trace k_L k_M b) = ∑ σ : G, π_res σ b := by
      rw [trace_eq_sum_automorphisms b, ← Equiv.sum_comp e_π (fun φ : k_M ≃ₐ[k_L] k_M => φ b)]
      rfl
    have hnorm_b : algebraMap k_L k_M (Algebra.norm k_L b) = ∏ σ : G, π_res σ b := by
      rw [Algebra.norm_eq_prod_automorphisms k_L b, ← Equiv.prod_comp e_π (fun φ : k_M ≃ₐ[k_L] k_M => φ b)]
      rfl
    let w : G → M := fun σ => act σ y
    have hw_int : ∀ σ : G, w σ = 0 ∨ 0 ≤ valL F M (w σ) := by
      intro σ
      rcases hy with rfl | hy_ge
      · exact Or.inl (hact_ring σ).1
      · exact Or.inr (by change 0 ≤ valL F M (act σ y); rw [hact_val σ y]; exact hy_ge)
    have hπ_w : ∀ σ : G, π_res σ b = resM (w σ) := fun σ => hπ_res σ y hy
    have hsum_T : ∀ T : Finset G,
        ((∑ σ ∈ T, w σ) = 0 ∨ 0 ≤ valL F M (∑ σ ∈ T, w σ)) ∧
        resM (∑ σ ∈ T, w σ) = ∑ σ ∈ T, resM (w σ) := by
      intro T
      induction' T using Finset.induction_on with τ S' hτ ih
      · simp [hresM_0]
      · rw [Finset.sum_insert hτ, Finset.sum_insert hτ]
        refine ⟨hIntM_add _ _ (hw_int τ) ih.1, ?_⟩
        rw [(hresM_ring (w τ) (∑ σ ∈ S', w σ) (hw_int τ) ih.1).1, ih.2]
    have hprod_T : ∀ T : Finset G,
        ((∏ σ ∈ T, w σ) = 0 ∨ 0 ≤ valL F M (∏ σ ∈ T, w σ)) ∧
        resM (∏ σ ∈ T, w σ) = ∏ σ ∈ T, resM (w σ) := by
      intro T
      induction' T using Finset.induction_on with τ S' hτ ih
      · simp [hresM_1, hvalM1]
      · rw [Finset.prod_insert hτ, Finset.prod_insert hτ]
        refine ⟨hIntM_mul _ _ (hw_int τ) ih.1, ?_⟩
        rw [(hresM_ring (w τ) (∏ σ ∈ S', w σ) (hw_int τ) ih.1).2.1, ih.2]
    have htr_int : traceLM F hLM y = 0 ∨ 0 ≤ valL F L (traceLM F hLM y) :=
      htr_bound 0 y hy
    have hy_val_nonneg : 0 ≤ valL F M y := by
      rcases hy with rfl | hy_ge
      · rw [hvalM0]
      · exact hy_ge
    have hnorm_int : normLM F hLM y = 0 ∨ 0 ≤ valL F L (normLM F hLM y) := by
      right
      rw [hval_norm y]
      exact mul_nonneg (Nat.cast_nonneg _) hy_val_nonneg
    have htr_alg_sum : algebraMap k_L k_M (resL (traceLM F hLM y)) = ∑ σ : G, π_res σ b := by
      rw [← hres_alg (traceLM F hLM y) htr_int, hact_trace y]
      change resM (∑ σ : G, w σ) = _
      rw [(hsum_T Finset.univ).2]
      simp_rw [hπ_w]
    have hnorm_alg_prod : algebraMap k_L k_M (resL (normLM F hLM y)) = ∏ σ : G, π_res σ b := by
      rw [← hres_alg (normLM F hLM y) hnorm_int, hact_norm y]
      change resM (∏ σ : G, w σ) = _
      rw [(hprod_T Finset.univ).2]
      simp_rw [hπ_w]
    exact ⟨(algebraMap k_L k_M).injective (htr_alg_sum.trans htr_b.symm),
      (algebraMap k_L k_M).injective (hnorm_alg_prod.trans hnorm_b.symm)⟩
  · set q_L := Fintype.card k_L
    have hqL_gt1 : 1 < q_L := Fintype.one_lt_card
    obtain ⟨n₀, hp_prime, hq_L_pow⟩ := FiniteField.card k_L (p F)
    haveI : Fact (Nat.Prime (p F)) := ⟨hp_prime⟩
    let frobHom : k_M →ₐ[k_L] k_M :=
      { toFun := fun b => b ^ q_L
        map_one' := one_pow q_L
        map_mul' := fun x y => mul_pow x y q_L
        map_zero' := zero_pow (by omega)
        map_add' := fun x y => by
          change (x + y) ^ (Fintype.card k_L) = x ^ (Fintype.card k_L) + y ^ (Fintype.card k_L)
          rw [hq_L_pow]
          exact add_pow_char_pow x y (p F) (n₀ : ℕ)
        commutes' := fun c => by
          change (algebraMap k_L k_M c) ^ q_L = algebraMap k_L k_M c
          rw [← map_pow, FiniteField.pow_card c] }
    have hfrob_bij : Function.Bijective frobHom :=
      (Fintype.bijective_iff_injective_and_card frobHom).mpr ⟨frobHom.toRingHom.injective, rfl⟩
    let frobEquiv : k_M ≃ₐ[k_L] k_M := AlgEquiv.ofBijective frobHom hfrob_bij
    have hfrob_apply : ∀ b : k_M, frobEquiv b = b ^ q_L := fun _ => rfl
    have hfrob_ne1 : frobEquiv ≠ 1 := by
      intro hfrob1
      have hb_qL : ∀ b : k_M, b ^ q_L = b := by
        intro b
        rw [← hfrob_apply b, hfrob1]
        rfl
      let Q : Polynomial k_M := Polynomial.X ^ q_L - Polynomial.X
      have hQ_deg : Q.natDegree = q_L := by
        change (Polynomial.X ^ q_L - Polynomial.X : Polynomial k_M).natDegree = q_L
        rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
        · exact Polynomial.natDegree_X_pow q_L
        · rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X]
          exact hqL_gt1
      have hQ_ne : Q ≠ 0 := by
        intro h0
        have h1 : Q.natDegree = 0 := by rw [h0, Polynomial.natDegree_zero]
        omega
      have huniv_roots : (Finset.univ : Finset k_M).val ≤ Q.roots := by
        rw [Multiset.le_iff_subset (Finset.univ : Finset k_M).nodup]
        intro b _
        rw [Polynomial.mem_roots hQ_ne, Polynomial.IsRoot.def, Polynomial.eval_sub,
          Polynomial.eval_pow, Polynomial.eval_X, hb_qL b, sub_self]
      have hcard_kM_le : Fintype.card k_M ≤ q_L := by
        calc Fintype.card k_M = (Finset.univ : Finset k_M).val.card := rfl
          _ ≤ Q.roots.card := Multiset.card_le_card huniv_roots
          _ ≤ Q.natDegree := Polynomial.card_roots' Q
          _ = q_L := hQ_deg
      have hcard_kM_eq : Fintype.card k_M = q_L ^ ℓ :=
        Module.card_eq_pow_finrank (K := k_L) (V := k_M)
      have hlt_pow : q_L ^ 1 < q_L ^ ℓ := Nat.pow_lt_pow_right hqL_gt1 hPrime_res.one_lt
      rw [pow_one] at hlt_pow
      omega
    let g_frob : G := e_π.symm frobEquiv
    have hπ_gfrob : π_res g_frob = frobEquiv := e_π.apply_symm_apply frobEquiv
    have hg_frob_ne1 : g_frob ≠ 1 := by
      intro hg1
      apply hfrob_ne1
      rw [← hπ_gfrob, hg1, map_one]
    let σ_frob : M ≃ₐ[F] M :=
      { toFun := act g_frob
        invFun := act g_frob⁻¹
        left_inv := fun z => by rw [← hact_mul, inv_mul_cancel, hact_one]
        right_inv := fun z => by rw [← hact_mul, mul_inv_cancel, hact_one]
        map_mul' := fun z₁ z₂ => ((hact_ring g_frob).2.2 z₁ z₂).2.1
        map_add' := fun z₁ z₂ => ((hact_ring g_frob).2.2 z₁ z₂).1
        commutes' := fun r => by
          rw [← (IntermediateField.inclusion hLM).commutes r]
          exact hact_incl g_frob (algebraMap F L r) }
    refine ⟨σ_frob, fun x => hact_incl g_frob x, ?_, fun z => hact_val g_frob z, ?_⟩
    · intro hσ1
      apply hg_frob_ne1
      apply hact_faithful g_frob
      intro z
      change σ_frob z = z
      rw [hσ1]
      rfl
    · intro z hz
      change resM (act g_frob z) = (resM z) ^ q_L
      rw [← hπ_res g_frob z hz, hπ_gfrob]
      rfl

theorem ld_ch12_unramified_cond_one_residue_gauss_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L N M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F N] [FiniteDimensional F M]
    (hLN : L ≤ N) (hLM : L ≤ M)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψM : IsAdmissibleChar F M (traceChar F hLM ψ))
    (νM : Lˣ →* (Ω F)ˣ) (χN' : Nˣ →* (Ω F)ˣ) (χM' : Mˣ →* (Ω F)ˣ)
    (hνM_pow : νM ^ (Module.finrank L (IntermediateField.extendScalars hLM)) = 1)
    (hνM_ne : νM ≠ 1)
    (hνM_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM),
      ∀ u ∈ unitGroup F L (condExp F L (νM ^ j)), (νM ^ j) u = 1)
    (hUnram : condExp F L νM = 0)
    (hcondM1 : condExp F M χM' = 1)
    (hχM_triv1 : ∀ u ∈ unitGroup F M 1, χM' u = 1)
    (hχM_pow : ∀ z : Mˣ,
      (χM' z) ^ (Module.finrank L (IntermediateField.extendScalars hLM)) =
        χN' (Units.map (IntermediateField.inclusion hLN).toMonoidHom (Units.map (normLM F hLM) z)))
    (hConj_M : ∀ (σ : M ≃ₐ[F] M),
      (∀ x : L, σ (IntermediateField.inclusion hLM x) = IntermediateField.inclusion hLM x) →
      σ ≠ 1 →
      ∃ z₀ ∈ unitGroup F M 0,
        χM' (Units.map σ.toRingEquiv.toMonoidHom z₀) ≠ χM' z₀)
    (hqL_M : qL F M = (qL F L) ^ (Module.finrank L (IntermediateField.extendScalars hLM)))
    (hval_norm : ∀ z : M, valL F L (normLM F hLM z) =
      (Module.finrank L (IntermediateField.extendScalars hLM) : ℤ) * valL F M z)
    (hval_alg : ∀ x : L, valL F M (IntermediateField.inclusion hLM x) = valL F L x)
    (htr_bound : ∀ (m : ℤ) (z : M), (z = 0 ∨ m ≤ valL F M z) →
      (traceLM F hLM z = 0 ∨ m ≤ valL F L (traceLM F hLM z)))
    (hcondChar_M : condExpChar F M (traceChar F hLM ψ) = condExpChar F L ψ)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (resL : L → k_L) (resM : M → k_M)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ z₁ z₂ : M, (z₁ = 0 ∨ 0 ≤ valL F M z₁) → (z₂ = 0 ∨ 0 ≤ valL F M z₂) →
      resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
      resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
      resM (-z₁) = -resM z₁)
    (hresM_ker : ∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
      (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M z)))
    (hresM_surj : ∀ b : k_M, ∃ z : M, (z = 0 ∨ 0 ≤ valL F M z) ∧ resM z = b)
    (hres_tr_norm : ∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
      resL (traceLM F hLM z) = Algebra.trace k_L k_M (resM z) ∧
      resL (normLM F hLM z) = Algebra.norm k_L (resM z))
    (σ_frob : M ≃ₐ[F] M)
    (hσ_frob_L : ∀ x : L, σ_frob (IntermediateField.inclusion hLM x) =
      IntermediateField.inclusion hLM x)
    (hσ_frob_ne : σ_frob ≠ 1)
    (hσ_frob_val : ∀ z : M, valL F M (σ_frob z) = valL F M z)
    (hσ_frob_res : ∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
      resM (σ_frob z) = (resM z) ^ (Fintype.card k_L))
    (ϖ_L : Lˣ) (hϖ_L_val : valL F L (ϖ_L : L) = 1)
    (c₁ : Lˣ) (hc₁_eq : c₁ = ϖ_L ^ ((1 : ℤ) + condExpChar F L ψ))
    (ψ_k : AddChar k_L (Ω F))
    (hψ_k_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_k (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x))
    (χ_L : k_Lˣ →* (Ω F)ˣ)
    (hχ_L_unit : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
      χ_L a = (χN' (Units.map (IntermediateField.inclusion hLN).toMonoidHom u))⁻¹)
    (hval_all : ∀ (K₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K₀],
      valL F K₀ 0 = 0 ∧ valL F K₀ 1 = 0 ∧ valL F K₀ (-1) = 0 ∧
      (∀ x : K₀, valL F K₀ (-x) = valL F K₀ x) ∧
      (∀ x y : K₀, x ≠ 0 → y ≠ 0 → valL F K₀ (x * y) = valL F K₀ x + valL F K₀ y) ∧
      (∀ u : K₀ˣ, valL F K₀ ((u⁻¹ : K₀ˣ) : K₀) = - valL F K₀ (u : K₀)) ∧
      (∀ m : ℤ, ∃ c : K₀ˣ, valL F K₀ (c : K₀) = m) ∧
      (∀ (k : ℤ) (x y : K₀),
        (x = 0 ∨ k ≤ valL F K₀ x) → (y = 0 ∨ k ≤ valL F K₀ y) →
          (x + y = 0 ∨ k ≤ valL F K₀ (x + y))) ∧
      (∀ u : K₀ˣ, u ∈ unitGroup F K₀ 0 ↔ valL F K₀ (u : K₀) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₀ˣ,
        u ∈ unitGroup F K₀ a ↔ ((u : K₀) = 1 ∨ (a : ℤ) ≤ valL F K₀ ((u : K₀) - 1))) ∧
      (∀ (a : ℕ) (u : K₀ˣ), u ∈ unitGroup F K₀ a → valL F K₀ (u : K₀) = 0))
    (hSpec_all : ∀ (K₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K₀]
      (ψ₀ : AddChar K₀ (Ω F)), IsAdmissibleChar F K₀ ψ₀ →
      ∀ (θ : K₀ˣ →* (Ω F)ˣ),
        (∀ x : K₀, (x = 0 ∨ -condExpChar F K₀ ψ₀ ≤ valL F K₀ x) → ψ₀ x = 1) ∧
        (∃ x₁ : K₀, x₁ ≠ 0 ∧ -(condExpChar F K₀ ψ₀ + 1) ≤ valL F K₀ x₁ ∧ ψ₀ x₁ ≠ 1) ∧
        (condExp F K₀ θ ≠ 0 →
          (∀ u ∈ unitGroup F K₀ (condExp F K₀ θ), θ u = 1) ∧
          (∃ u₀ ∈ unitGroup F K₀ (condExp F K₀ θ - 1), θ u₀ ≠ 1)) ∧
        valL F K₀ ((tateElt F K₀ θ ψ₀ : K₀ˣ) : K₀) = (condExp F K₀ θ : ℤ) + condExpChar F K₀ ψ₀)
    (hGauss_all : ∀ (K₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K₀]
      (ψ₀ : AddChar K₀ (Ω F)), IsAdmissibleChar F K₀ ψ₀ →
      ∀ (χ_0 : K₀ˣ →* (Ω F)ˣ), condExp F K₀ χ_0 = 1 →
      ∀ (k_R : Type u) [Field k_R] [Fintype k_R] (resR : K₀ → k_R),
        resR 0 = 0 → resR 1 = 1 →
        (∀ x₁ x₂ : K₀, (x₁ = 0 ∨ 0 ≤ valL F K₀ x₁) → (x₂ = 0 ∨ 0 ≤ valL F K₀ x₂) →
          resR (x₁ + x₂) = resR x₁ + resR x₂ ∧
          resR (x₁ * x₂) = resR x₁ * resR x₂ ∧
          resR (-x₁) = -resR x₁) →
        (∀ x : K₀, (x = 0 ∨ 0 ≤ valL F K₀ x) → (resR x = 0 ↔ (x = 0 ∨ 1 ≤ valL F K₀ x))) →
        (∀ a : k_R, ∃ x : K₀, (x = 0 ∨ 0 ≤ valL F K₀ x) ∧ resR x = a) →
        ∀ (c_0 : K₀ˣ), valL F K₀ (c_0 : K₀) = 1 + condExpChar F K₀ ψ₀ →
        ∀ (χ_tilde ψ_tilde : k_R → Ω F),
          χ_tilde 0 = 0 →
          (∀ u : K₀ˣ, valL F K₀ (u : K₀) = 0 → χ_tilde (resR (u : K₀)) = (χ_0 u : Ω F)⁻¹) →
          (∀ x : K₀, (x = 0 ∨ 0 ≤ valL F K₀ x) →
            ψ_tilde (resR x) = ψ₀ (((c_0⁻¹ : K₀ˣ) : K₀) * x)) →
          tateEps F K₀ χ_0 ψ₀ =
            (qL F K₀ : Ω F) ^ condExpChar F K₀ ψ₀ * (χ_0 c_0 : Ω F) *
              (∑ a : k_R, χ_tilde a * ψ_tilde a)) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLM)
    let n_L := condExpChar F L ψ
    let ψM := traceChar F hLM ψ
    ∃ (χ_M : k_Mˣ →* (Ω F)ˣ),
      (∀ y : k_Mˣ, (χ_M y) ^ ℓ = χ_L (Units.map (Algebra.norm k_L (S := k_M)) y)) ∧
      χ_M ^ (Fintype.card k_L) ≠ χ_M ∧
      tateEps F M 1 ψM = ((qL F L : Ω F) ^ n_L) ^ ℓ ∧
      (∏ j ∈ Finset.range ℓ, tateEps F L (νM ^ j) ψ) =
        ((qL F L : Ω F) ^ n_L) ^ ℓ * (-1 : Ω F) ^ (ℓ - 1) *
          (∏ j ∈ Finset.range ℓ, ((νM ^ j) c₁ : Ω F)) ∧
      tateEps F M χM' ψM =
        ((qL F L : Ω F) ^ n_L) ^ ℓ *
          (χM' (Units.map (IntermediateField.inclusion hLM).toMonoidHom c₁) : Ω F) *
          (∑ y : k_Mˣ, (χ_M y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M))) :=
by
  classical
  dsimp only
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLM)
  set n_L := condExpChar F L ψ
  set ψM := traceChar F hLM ψ
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
  obtain ⟨hval0_M, hval1_M, hval_neg1_M, hval_neg_M, hval_mul_M, hval_inv_M, _, hval_add_M,
    hunit0_M, hunit_ge1_M, hunit_val0_M⟩ := hval_all M
  let valHomL : Lˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (valL F L (u : L))
      map_one' := by rw [Units.val_one, hval1_L]; rfl
      map_mul' := fun u v => by
        rw [Units.val_mul, hval_mul_L (u : L) (v : L) (Units.ne_zero u) (Units.ne_zero v),
          ofAdd_add] }
  have hval_zpow_L : ∀ (u : Lˣ) (m : ℤ),
      valL F L ((u ^ m : Lˣ) : L) = m * valL F L (u : L) := by
    intro u m
    have hz := congrArg Multiplicative.toAdd (map_zpow valHomL u m)
    rw [toAdd_zpow] at hz
    change valL F L ((u ^ m : Lˣ) : L) = m • valL F L (u : L) at hz
    rw [hz, smul_eq_mul]
  have hc₁_val : valL F L (c₁ : L) = 1 + n_L := by
    rw [hc₁_eq, hval_zpow_L, hϖ_L_val, mul_one]
  have hϖ_nL_val : valL F L ((ϖ_L ^ n_L : Lˣ) : L) = n_L := by
    rw [hval_zpow_L, hϖ_L_val, mul_one]
  have hcond_1M : condExp F M 1 = 0 := by
    apply Nat.eq_zero_of_le_zero
    have hmem : (0 : ℕ) ∈ {a : ℕ | ∀ w ∈ unitGroup F M a, (1 : Mˣ →* (Ω F)ˣ) w = 1} :=
      fun _ _ => rfl
    exact Nat.sInf_le hmem
  have hQ_M_eq : (qL F M : Ω F) ^ condExpChar F M ψM = ((qL F L : Ω F) ^ n_L) ^ ℓ := by
    rw [hcondChar_M, hqL_M, Nat.cast_pow, ← zpow_natCast, ← zpow_mul,
      mul_comm (ℓ : ℤ) n_L, zpow_mul, zpow_natCast]
  have htate_M1 : tateEps F M 1 ψM = ((qL F L : Ω F) ^ n_L) ^ ℓ := by
    unfold tateEps
    rw [hcond_1M, if_pos rfl, MonoidHom.one_apply, Units.val_one, mul_one, hQ_M_eq]
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt
  have hνM_unit0 : ∀ u ∈ unitGroup F L 0, νM u = 1 := by
    intro u hu
    have h := hνM_cond 1 hℓ_gt1 u
    rw [pow_one νM, hUnram] at h
    exact h hu
  have hνMj_unit0 : ∀ (j : ℕ), ∀ u ∈ unitGroup F L 0, (νM ^ j) u = 1 := by
    intro j u hu
    rw [MonoidHom.pow_apply, hνM_unit0 u hu, one_pow]
  have hcond_νMj : ∀ j : ℕ, condExp F L (νM ^ j) = 0 := by
    intro j
    apply Nat.eq_zero_of_le_zero
    exact Nat.sInf_le (hνMj_unit0 j)
  have htateEps_νMj : ∀ j : ℕ,
      tateEps F L (νM ^ j) ψ = (qL F L : Ω F) ^ n_L * ((νM ^ j) (ϖ_L ^ n_L) : Ω F) := by
    intro j
    set c₀ : Lˣ := tateElt F L (νM ^ j) ψ
    have hc₀_val : valL F L (c₀ : L) = n_L := by
      have h := (hSpec_all L ψ hψ (νM ^ j)).2.2.2
      rw [hcond_νMj j, Nat.cast_zero, zero_add] at h
      exact h
    let u₀ : Lˣ := c₀ * (ϖ_L ^ n_L)⁻¹
    have hu₀_val : valL F L (u₀ : L) = 0 := by
      dsimp only [u₀]
      rw [Units.val_mul, hval_mul_L (c₀ : L) _ (Units.ne_zero c₀) (Units.ne_zero _),
        hval_inv_L (ϖ_L ^ n_L), hc₀_val, hϖ_nL_val]
      omega
    have hu₀_mem : u₀ ∈ unitGroup F L 0 := (hunit0_L u₀).mpr hu₀_val
    have hc₀_eq : c₀ = u₀ * (ϖ_L ^ n_L) := by
      dsimp only [u₀]
      rw [inv_mul_cancel_right]
    have hνMj_c₀ : (νM ^ j) c₀ = (νM ^ j) (ϖ_L ^ n_L) := by
      rw [hc₀_eq, map_mul, hνMj_unit0 j u₀ hu₀_mem, one_mul]
    unfold tateEps
    change (qL F L : Ω F) ^ n_L *
        (if condExp F L (νM ^ j) = 0 then ((νM ^ j) c₀ : Ω F) else _) = _
    rw [hcond_νMj j, if_pos rfl, hνMj_c₀]
  set ζ : (Ω F)ˣ := νM ϖ_L
  have hνM_eq_zpow : ∀ x : Lˣ, νM x = ζ ^ (valL F L (x : L)) := by
    intro x
    set m : ℤ := valL F L (x : L)
    let u : Lˣ := x * (ϖ_L ^ m)⁻¹
    have hu_val : valL F L (u : L) = 0 := by
      dsimp only [u]
      rw [Units.val_mul, hval_mul_L (x : L) _ (Units.ne_zero x) (Units.ne_zero _),
        hval_inv_L (ϖ_L ^ m), hval_zpow_L ϖ_L m, hϖ_L_val, mul_one]
      omega
    have hu_mem : u ∈ unitGroup F L 0 := (hunit0_L u).mpr hu_val
    have hx_eq : x = u * (ϖ_L ^ m) := by
      dsimp only [u]
      rw [inv_mul_cancel_right]
    conv_lhs => rw [hx_eq]
    rw [map_mul, hνM_unit0 u hu_mem, one_mul, map_zpow]
  have hζ_pow : ζ ^ ℓ = 1 := by
    dsimp only [ζ]
    rw [← MonoidHom.pow_apply, hνM_pow, MonoidHom.one_apply]
  have hζ_ne : ζ ≠ 1 := by
    intro h1
    apply hνM_ne
    ext x
    rw [hνM_eq_zpow x, h1, one_zpow, MonoidHom.one_apply]
  set ζ₀ : Ω F := (ζ : Ω F)
  have hζ₀_pow : ζ₀ ^ ℓ = 1 := by
    dsimp only [ζ₀]
    rw [← Units.val_pow_eq_pow_val, hζ_pow, Units.val_one]
  have hζ₀_ne : ζ₀ ≠ 1 := by
    intro h1
    apply hζ_ne
    exact Units.ext h1
  have hζ₀_prod : (∏ j ∈ Finset.range ℓ, ζ₀ ^ j) = (-1 : Ω F) ^ (ℓ - 1) := by
    rw [Finset.prod_pow_eq_pow_sum, Finset.sum_range_id]
    by_cases h2 : ℓ = 2
    · have hζ₀_sq : ζ₀ ^ 2 = 1 := h2 ▸ hζ₀_pow
      have hζ₀_neg1 : ζ₀ = -1 := (sq_eq_one_iff.mp hζ₀_sq).resolve_left hζ₀_ne
      rw [h2, hζ₀_neg1]
    · have hodd : ℓ % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime).resolve_left h2
      let k : ℕ := (ℓ - 1) / 2
      have hk : ℓ - 1 = 2 * k := by omega
      have hdiv2 : ℓ * (ℓ - 1) / 2 = ℓ * k := by
        rw [hk]
        have hmul : ℓ * (2 * k) = 2 * (ℓ * k) := by ring
        rw [hmul, Nat.mul_div_right _ (by omega)]
      have hlhs : ζ₀ ^ (ℓ * (ℓ - 1) / 2) = 1 := by
        rw [hdiv2, pow_mul, hζ₀_pow, one_pow]
      have hrhs : (-1 : Ω F) ^ (ℓ - 1) = 1 := by
        rw [hk, pow_mul]
        norm_num
      rw [hlhs, hrhs]
  have hc₁_mul : c₁ = ϖ_L * (ϖ_L ^ n_L) := by
    rw [hc₁_eq, zpow_add, zpow_one]
  have hprod_c₁ :
      (∏ j ∈ Finset.range ℓ, ((νM ^ j) c₁ : Ω F)) =
        (-1 : Ω F) ^ (ℓ - 1) * (∏ j ∈ Finset.range ℓ, ((νM ^ j) (ϖ_L ^ n_L) : Ω F)) := by
    have hcongr :
        (∏ j ∈ Finset.range ℓ, ((νM ^ j) c₁ : Ω F)) =
          ∏ j ∈ Finset.range ℓ, (ζ₀ ^ j * ((νM ^ j) (ϖ_L ^ n_L) : Ω F)) := by
      apply Finset.prod_congr rfl
      intro j _
      rw [hc₁_mul, map_mul (νM ^ j), Units.val_mul, MonoidHom.pow_apply νM j ϖ_L,
        Units.val_pow_eq_pow_val]
    rw [hcongr, Finset.prod_mul_distrib, hζ₀_prod]
  have hsign_sq : (-1 : Ω F) ^ (ℓ - 1) * (-1 : Ω F) ^ (ℓ - 1) = 1 := by
    rw [← mul_pow]
    norm_num
  have hprod_νM :
      (∏ j ∈ Finset.range ℓ, tateEps F L (νM ^ j) ψ) =
        ((qL F L : Ω F) ^ n_L) ^ ℓ * (-1 : Ω F) ^ (ℓ - 1) *
          (∏ j ∈ Finset.range ℓ, ((νM ^ j) c₁ : Ω F)) := by
    have hcongr :
        (∏ j ∈ Finset.range ℓ, tateEps F L (νM ^ j) ψ) =
          ∏ j ∈ Finset.range ℓ, ((qL F L : Ω F) ^ n_L * ((νM ^ j) (ϖ_L ^ n_L) : Ω F)) := by
      apply Finset.prod_congr rfl
      intro j _
      exact htateEps_νMj j
    rw [hcongr, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range, hprod_c₁]
    calc ((qL F L : Ω F) ^ n_L) ^ ℓ * (∏ j ∈ Finset.range ℓ, ((νM ^ j) (ϖ_L ^ n_L) : Ω F))
      _ = ((qL F L : Ω F) ^ n_L) ^ ℓ * 1 * (∏ j ∈ Finset.range ℓ, ((νM ^ j) (ϖ_L ^ n_L) : Ω F)) := by ring
      _ = ((qL F L : Ω F) ^ n_L) ^ ℓ * ((-1 : Ω F) ^ (ℓ - 1) * (-1 : Ω F) ^ (ℓ - 1)) *
            (∏ j ∈ Finset.range ℓ, ((νM ^ j) (ϖ_L ^ n_L) : Ω F)) := by rw [hsign_sq]
      _ = ((qL F L : Ω F) ^ n_L) ^ ℓ * (-1 : Ω F) ^ (ℓ - 1) *
            ((-1 : Ω F) ^ (ℓ - 1) * (∏ j ∈ Finset.range ℓ, ((νM ^ j) (ϖ_L ^ n_L) : Ω F))) := by ring
  set s_M : k_M → M := fun b => (hresM_surj b).choose
  have hs_M_int : ∀ b : k_M, s_M b = 0 ∨ 0 ≤ valL F M (s_M b) :=
    fun b => (hresM_surj b).choose_spec.1
  have hs_M_res : ∀ b : k_M, resM (s_M b) = b :=
    fun b => (hresM_surj b).choose_spec.2
  have hs_M_ne : ∀ b : k_M, b ≠ 0 → s_M b ≠ 0 := by
    intro b hb h0
    apply hb
    rw [← hs_M_res b, h0, hresM_0]
  have hs_M_val0 : ∀ b : k_M, b ≠ 0 → valL F M (s_M b) = 0 := by
    intro b hb
    have hge0 : 0 ≤ valL F M (s_M b) := (hs_M_int b).resolve_left (hs_M_ne b hb)
    by_contra hne
    have hge1 : 1 ≤ valL F M (s_M b) := by omega
    have hres0 : resM (s_M b) = 0 := (hresM_ker (s_M b) (hs_M_int b)).mpr (Or.inr hge1)
    rw [hs_M_res b] at hres0
    exact hb hres0
  set v_M : k_Mˣ → Mˣ := fun y => Units.mk0 (s_M (y : k_M)) (hs_M_ne (y : k_M) (Units.ne_zero y))
  have hv_M_val0 : ∀ y : k_Mˣ, valL F M ((v_M y : Mˣ) : M) = 0 :=
    fun y => hs_M_val0 (y : k_M) (Units.ne_zero y)
  have hv_M_int : ∀ y : k_Mˣ, ((v_M y : Mˣ) : M) = 0 ∨ 0 ≤ valL F M ((v_M y : Mˣ) : M) :=
    fun y => hs_M_int (y : k_M)
  have hv_M_res : ∀ y : k_Mˣ, resM ((v_M y : Mˣ) : M) = (y : k_M) :=
    fun y => hs_M_res (y : k_M)
  have hdesc_unit_M : ∀ (u : Mˣ) (y : k_Mˣ),
      valL F M (u : M) = 0 → resM (u : M) = (y : k_M) →
        (χM' (v_M y))⁻¹ = (χM' u)⁻¹ := by
    intro u y hu_val hu_res
    have hu_int : (u : M) = 0 ∨ 0 ≤ valL F M (u : M) := Or.inr (by omega)
    have hneg_v_int : -((v_M y : Mˣ) : M) = 0 ∨ 0 ≤ valL F M (-((v_M y : Mˣ) : M)) := by
      right; rw [hval_neg_M, hv_M_val0 y]
    set d : M := (u : M) - ((v_M y : Mˣ) : M)
    have hd_int : d = 0 ∨ 0 ≤ valL F M d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_M 0 (u : M) (-((v_M y : Mˣ) : M)) hu_int hneg_v_int
    have hd_res : resM d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg,
        (hresM_ring (u : M) (-((v_M y : Mˣ) : M)) hu_int hneg_v_int).1,
        (hresM_ring ((v_M y : Mˣ) : M) ((v_M y : Mˣ) : M) (hv_M_int y) (hv_M_int y)).2.2,
        hu_res, hv_M_res y, add_neg_cancel]
    have hd1 : d = 0 ∨ 1 ≤ valL F M d := (hresM_ker d hd_int).mp hd_res
    set h : Mˣ := (v_M y)⁻¹ * u
    have hh_sub : (h : M) - 1 = (((v_M y)⁻¹ : Mˣ) : M) * d := by
      have hinv : (((v_M y)⁻¹ : Mˣ) : M) * ((v_M y : Mˣ) : M) = 1 := by
        exact_mod_cast Units.inv_mul (v_M y)
      calc (h : M) - 1 =
            (((v_M y)⁻¹ : Mˣ) : M) * (u : M) - (((v_M y)⁻¹ : Mˣ) : M) * ((v_M y : Mˣ) : M) := by
            rw [Units.val_mul, hinv]
        _ = (((v_M y)⁻¹ : Mˣ) : M) * d := by dsimp only [d]; ring
    have hh_mem : h ∈ unitGroup F M 1 := by
      rw [hunit_ge1_M 1 le_rfl h]
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : M) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : 1 ≤ valL F M d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul_M (((v_M y)⁻¹ : Mˣ) : M) d (Units.ne_zero (v_M y)⁻¹) hd0,
          hval_inv_M (v_M y), hv_M_val0 y]
        omega
    have hχ_h : χM' h = 1 := hχM_triv1 h hh_mem
    have hχ_u : χM' u = χM' (v_M y) := by
      have huv : v_M y * h = u := mul_inv_cancel_left (v_M y) u
      rw [← huv, map_mul, hχ_h, mul_one]
    rw [hχ_u]
  let χ_M : k_Mˣ →* (Ω F)ˣ :=
    { toFun := fun y => (χM' (v_M y))⁻¹
      map_one' := by
        have h1 : (χM' (v_M 1))⁻¹ = (χM' 1)⁻¹ :=
          hdesc_unit_M 1 1 (by rw [Units.val_one, hval1_M])
            (by rw [Units.val_one, hresM_1, Units.val_one])
        rw [h1, map_one, inv_one]
      map_mul' := fun y₁ y₂ => by
        have hab_val : valL F M ((v_M y₁ * v_M y₂ : Mˣ) : M) = 0 := by
          rw [Units.val_mul,
            hval_mul_M ((v_M y₁ : Mˣ) : M) ((v_M y₂ : Mˣ) : M)
              (Units.ne_zero (v_M y₁)) (Units.ne_zero (v_M y₂)),
            hv_M_val0 y₁, hv_M_val0 y₂, add_zero]
        have hab_res : resM ((v_M y₁ * v_M y₂ : Mˣ) : M) = ((y₁ * y₂ : k_Mˣ) : k_M) := by
          rw [Units.val_mul,
            (hresM_ring ((v_M y₁ : Mˣ) : M) ((v_M y₂ : Mˣ) : M)
              (hv_M_int y₁) (hv_M_int y₂)).2.1,
            hv_M_res y₁, hv_M_res y₂, Units.val_mul]
        have hm := hdesc_unit_M (v_M y₁ * v_M y₂) (y₁ * y₂) hab_val hab_res
        rw [hm, map_mul, mul_inv] }
  have hχ_M_unit : ∀ (u : Mˣ) (y : k_Mˣ),
      valL F M (u : M) = 0 → resM (u : M) = (y : k_M) →
        χ_M y = (χM' u)⁻¹ :=
    fun u y hu hy => hdesc_unit_M u y hu hy
  have hχ_M_pow : ∀ y : k_Mˣ,
      (χ_M y) ^ ℓ = χ_L (Units.map (Algebra.norm k_L (S := k_M)) y) := by
    intro y
    set w : Mˣ := v_M y
    set u_L : Lˣ := Units.map (normLM F hLM) w
    set a_y : k_Lˣ := Units.map (Algebra.norm k_L (S := k_M)) y
    have hu_L_val0 : valL F L (u_L : L) = 0 := by
      change valL F L (normLM F hLM (w : M)) = 0
      rw [hval_norm (w : M), hv_M_val0 y, mul_zero]
    have hu_L_res : resL (u_L : L) = (a_y : k_L) := by
      change resL (normLM F hLM (w : M)) = Algebra.norm k_L (y : k_M)
      rw [← hv_M_res y]
      exact (hres_tr_norm (w : M) (hv_M_int y)).2
    have hχL_ay := hχ_L_unit u_L a_y hu_L_val0 hu_L_res
    have hχM_y : χ_M y = (χM' w)⁻¹ := rfl
    rw [hχM_y, inv_pow, hχM_pow w, hχL_ay]
  have hχ_M_frob_ne : χ_M ^ (Fintype.card k_L) ≠ χ_M := by
    intro h_eq
    obtain ⟨z₀, hz₀_mem, hz₀_ne⟩ := hConj_M σ_frob hσ_frob_L hσ_frob_ne
    have hz₀_val0 : valL F M (z₀ : M) = 0 := (hunit0_M z₀).mp hz₀_mem
    have hz₀_int : (z₀ : M) = 0 ∨ 0 ≤ valL F M (z₀ : M) := Or.inr (by omega)
    have hz₀_res_ne : resM (z₀ : M) ≠ 0 := by
      intro h0
      rcases (hresM_ker (z₀ : M) hz₀_int).mp h0 with h1 | h2
      · exact Units.ne_zero z₀ h1
      · omega
    set y₀ : k_Mˣ := Units.mk0 (resM (z₀ : M)) hz₀_res_ne
    set z₁ : Mˣ := Units.map σ_frob.toRingEquiv.toMonoidHom z₀
    have hz₁_coe : (z₁ : M) = σ_frob (z₀ : M) := rfl
    have hz₁_val0 : valL F M (z₁ : M) = 0 := by
      rw [hz₁_coe, hσ_frob_val (z₀ : M), hz₀_val0]
    have hz₁_res : resM (z₁ : M) = ((y₀ ^ (Fintype.card k_L) : k_Mˣ) : k_M) := by
      rw [hz₁_coe, hσ_frob_res (z₀ : M) hz₀_int, Units.val_pow_eq_pow_val]
      rfl
    have h1 : (χ_M ^ (Fintype.card k_L)) y₀ = (χM' z₁)⁻¹ := by
      rw [MonoidHom.pow_apply, ← map_pow,
        hχ_M_unit z₁ (y₀ ^ (Fintype.card k_L)) hz₁_val0 hz₁_res]
    have h2 : χ_M y₀ = (χM' z₀)⁻¹ := hχ_M_unit z₀ y₀ hz₀_val0 rfl
    have heq_y₀ : (χ_M ^ (Fintype.card k_L)) y₀ = χ_M y₀ := by rw [h_eq]
    rw [h1, h2, inv_inj] at heq_y₀
    exact hz₀_ne heq_y₀
  let M' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM
  have hto_inc_M : ∀ x : L,
      toExtendScalars F hLM (IntermediateField.inclusion hLM x) = algebraMap L M' x :=
    fun _ => rfl
  have htrace_mul_inc : ∀ (x : L) (z : M),
      traceLM F hLM (IntermediateField.inclusion hLM x * z) = x * traceLM F hLM z := by
    letI : Module L L := Semiring.toModule
    intro x z
    have h1 : toExtendScalars F hLM (IntermediateField.inclusion hLM x * z) =
        x • toExtendScalars F hLM z := by
      rw [map_mul, hto_inc_M x, Algebra.smul_def]
    have h2 := (Algebra.trace L M').map_smul' x (toExtendScalars F hLM z)
    exact (congrArg (Algebra.trace L M') h1).trans h2
  set c₁_M : Mˣ := Units.map (IntermediateField.inclusion hLM).toMonoidHom c₁
  have hc₁_M_coe : (c₁_M : M) = IntermediateField.inclusion hLM (c₁ : L) := rfl
  have hc₁_M_inv_coe : ((c₁_M⁻¹ : Mˣ) : M) =
      IntermediateField.inclusion hLM ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_M_val : valL F M (c₁_M : M) = 1 + condExpChar F M ψM := by
    rw [hc₁_M_coe, hval_alg (c₁ : L), hc₁_val, hcondChar_M]
  set ψ_tilde_M : k_M → Ω F := fun b => ψ_k (Algebra.trace k_L k_M b)
  have hψM_int : ∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
      ψ_tilde_M (resM z) = ψM (((c₁_M⁻¹ : Mˣ) : M) * z) := by
    intro z hz
    have htr_int : traceLM F hLM z = 0 ∨ 0 ≤ valL F L (traceLM F hLM z) := htr_bound 0 z hz
    have htr_res : resL (traceLM F hLM z) = Algebra.trace k_L k_M (resM z) :=
      (hres_tr_norm z hz).1
    dsimp only [ψ_tilde_M]
    rw [← htr_res, hψ_k_int (traceLM F hLM z) htr_int]
    change ψ (((c₁⁻¹ : Lˣ) : L) * traceLM F hLM z) =
      ψ (traceLM F hLM (((c₁_M⁻¹ : Mˣ) : M) * z))
    rw [hc₁_M_inv_coe, htrace_mul_inc]
  set χ_tilde_M : k_M → Ω F := fun b =>
    if hb : b = 0 then 0 else (χ_M (Units.mk0 b hb) : Ω F)
  have hχM_zero : χ_tilde_M 0 = 0 := dif_pos rfl
  have hχM_unit : ∀ u : Mˣ, valL F M (u : M) = 0 →
      χ_tilde_M (resM (u : M)) = (χM' u : Ω F)⁻¹ := by
    intro u hu
    have hres_ne : resM (u : M) ≠ 0 := by
      intro h0
      rcases (hresM_ker (u : M) (Or.inr (by omega))).mp h0 with h1 | h2
      · exact Units.ne_zero u h1
      · omega
    dsimp only [χ_tilde_M]
    rw [dif_neg hres_ne, hχ_M_unit u (Units.mk0 (resM (u : M)) hres_ne) hu rfl,
      Units.val_inv_eq_inv_val]
  have hsum_units_kM :
      (∑ b : k_M, χ_tilde_M b * ψ_tilde_M b) =
        ∑ y : k_Mˣ, (χ_M y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M)) := by
    have herase :
        (∑ b : k_M, χ_tilde_M b * ψ_tilde_M b) =
          ∑ b ∈ (Finset.univ : Finset k_M).erase 0, χ_tilde_M b * ψ_tilde_M b := by
      exact (Finset.sum_erase Finset.univ (by rw [hχM_zero, zero_mul])).symm
    rw [herase]
    refine (Finset.sum_bij (fun (y : k_Mˣ) _ => (y : k_M)) ?_ ?_ ?_ ?_).symm
    · intro y _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero y, Finset.mem_univ _⟩
    · intro y₁ _ y₂ _ h
      exact Units.ext h
    · intro b hb
      have hb_ne : b ≠ 0 := (Finset.mem_erase.mp hb).1
      exact ⟨Units.mk0 b hb_ne, Finset.mem_univ _, rfl⟩
    · intro y _
      dsimp only [χ_tilde_M, ψ_tilde_M]
      rw [dif_neg (Units.ne_zero y), Units.mk0_val]
  have htate_Mχ :
      tateEps F M χM' ψM =
        ((qL F L : Ω F) ^ n_L) ^ ℓ *
          (χM' c₁_M : Ω F) *
          (∑ y : k_Mˣ, (χ_M y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M))) := by
    have hG := hGauss_all M ψM hψM χM' hcondM1
      k_M resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
      c₁_M hc₁_M_val χ_tilde_M ψ_tilde_M hχM_zero hχM_unit hψM_int
    rw [hG, hQ_M_eq, hsum_units_kM]
  exact ⟨χ_M, hχ_M_pow, hχ_M_frob_ne, htate_M1, hprod_νM, htate_Mχ⟩

theorem ld_ch12_tame_finite_field_cyclic_order_ell_prod_and_gauss_assembly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (k_L : Type u) [Field k_L] [Fintype k_L]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ) (hNeChar : (ℓ : k_L) ≠ 0)
    (ψ_k : AddChar k_L (Ω F)) :
    (∀ (ν₁ ν₂ χ₁ χ₂ : k_Lˣ →* (Ω F)ˣ),
      ν₁ ^ ℓ = 1 → ν₁ ≠ 1 →
      ν₂ ^ ℓ = 1 → ν₂ ≠ 1 →
      (∀ a : k_Lˣ,
        (χ₁ a)⁻¹ * (∏ j ∈ Finset.range ℓ, ((ν₁ ^ j) a)⁻¹) =
        (χ₂ a)⁻¹ * (∏ j ∈ Finset.range ℓ, ((ν₂ ^ j) a)⁻¹)) →
      ∀ (Q_ram Q_unr C₁ C₂ : Ω F) (U₁ U₂ : (Ω F)ˣ),
        C₁ * (U₁ : Ω F) = C₂ * (U₂ : Ω F) →
        Q_ram * C₁ * ((χ₁ (Units.mk0 (ℓ : k_L) hNeChar))⁻¹ : Ω F) *
          (∑ x : k_Lˣ, (χ₁ x : Ω F) * ψ_k (x : k_L)) *
          Q_ram *
          (Q_unr * (U₁ : Ω F) *
            (∏ j ∈ (Finset.range ℓ).erase 0,
              (∑ x : k_Lˣ, ((ν₁ ^ j) x : Ω F) * ψ_k (x : k_L)))) =
        Q_ram * C₂ * ((χ₂ (Units.mk0 (ℓ : k_L) hNeChar))⁻¹ : Ω F) *
          (∑ x : k_Lˣ, (χ₂ x : Ω F) * ψ_k (x : k_L)) *
          Q_ram *
          (Q_unr * (U₂ : Ω F) *
            (∏ j ∈ (Finset.range ℓ).erase 0,
              (∑ x : k_Lˣ, ((ν₂ ^ j) x : Ω F) * ψ_k (x : k_L))))) ∧
    (∀ (Q_ram Q_unr C_N C_M G_N G_ν G_M : Ω F) (U_N U_M : (Ω F)ˣ),
      U_N = 1 →
      C_N * (U_N : Ω F) = C_M * (U_M : Ω F) →
      let LHS_SML := (Q_ram * C_N * G_N) * Q_unr * (Q_unr * (U_N : Ω F) * G_ν)
      let RHS_SML := (Q_unr * C_M * G_M) * Q_ram *
        (Q_unr * (-1 : Ω F) ^ (ℓ - 1) * (U_M : Ω F))
      let LHS_G := (-1 : Ω F) ^ (ℓ - 1) * G_M
      let RHS_G := G_N * G_ν
      LHS_SML ≠ 0 →
      LHS_SML ^ ℓ = RHS_SML ^ ℓ →
      (RHS_G ≠ 0 → LHS_G ^ ℓ = RHS_G ^ ℓ → LHS_G = RHS_G) →
      LHS_SML = RHS_SML) :=
by
  classical
  refine ⟨?_, ?_⟩
  · intro ν₁ ν₂ χ₁ χ₂ hν₁_pow hν₁_ne hν₂_pow hν₂_ne hRest Q_ram Q_unr C₁ C₂ U₁ U₂ hCU
    haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := k_Lˣ)
    have hν₁g_ne : ν₁ g ≠ 1 := by
      intro h1
      apply hν₁_ne
      ext a
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
      rw [map_zpow, h1, one_zpow, MonoidHom.one_apply]
    set ζ : (Ω F)ˣ := ν₁ g
    set ξ : (Ω F)ˣ := ν₂ g
    have hζ_pow : ζ ^ ℓ = 1 := by
      dsimp [ζ]
      rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
    have hξ_pow : ξ ^ ℓ = 1 := by
      dsimp [ξ]
      rw [← MonoidHom.pow_apply, hν₂_pow, MonoidHom.one_apply]
    have hord : orderOf ζ = ℓ := orderOf_eq_prime hζ_pow hν₁g_ne
    let ϕ : Fin ℓ → Ω F := fun i => ((ζ ^ (i : ℕ) : (Ω F)ˣ) : Ω F)
    have hpow_inj_le : ∀ {a b : ℕ}, a ≤ b → b < ℓ → ζ ^ a = ζ ^ b → a = b := by
      intro a b hab hb heq
      have hsub : ζ ^ (b - a) * ζ ^ a = 1 * ζ ^ a := by
        rw [← pow_add, Nat.sub_add_cancel hab, one_mul, heq]
      have hpow_sub : ζ ^ (b - a) = 1 := mul_right_cancel hsub
      have hdvd : ℓ ∣ b - a := by
        rw [← hord]
        exact orderOf_dvd_iff_pow_eq_one.mpr hpow_sub
      have hlt : b - a < ℓ := by omega
      have hzero : b - a = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      omega
    have hϕ_inj : Function.Injective ϕ := by
      intro i j hij
      have hζ_ij : ζ ^ (i : ℕ) = ζ ^ (j : ℕ) := Units.ext hij
      rcases le_total (i : ℕ) (j : ℕ) with hle | hle
      · exact Fin.ext (hpow_inj_le hle j.2 hζ_ij)
      · exact Fin.ext (hpow_inj_le hle i.2 hζ_ij.symm).symm
    let P_poly : Polynomial (Ω F) := Polynomial.X ^ ℓ - Polynomial.C 1
    have hP_ne : P_poly ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hPrime.pos 1
    have hP_deg : P_poly.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    let S_img : Finset (Ω F) := (Finset.univ : Finset (Fin ℓ)).image ϕ
    let R_fin : Finset (Ω F) := P_poly.roots.toFinset
    have hsub_roots : S_img ⊆ R_fin := by
      intro z hz
      rcases Finset.mem_image.mp hz with ⟨i, _, rfl⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P_poly, ϕ]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← pow_mul, mul_comm (i : ℕ) ℓ, pow_mul, ← Units.val_pow_eq_pow_val,
        hζ_pow, Units.val_one, one_pow]
    have hcard_le : R_fin.card ≤ S_img.card := by
      calc R_fin.card
        _ ≤ P_poly.roots.card := Multiset.toFinset_card_le P_poly.roots
        _ ≤ P_poly.natDegree := Polynomial.card_roots' P_poly
        _ = ℓ := hP_deg
        _ = (Finset.univ : Finset (Fin ℓ)).card := (Fintype.card_fin ℓ).symm
        _ = S_img.card := (Finset.card_image_of_injective _ hϕ_inj).symm
    have hS_eq_R : S_img = R_fin := Finset.eq_of_subset_of_card_le hsub_roots hcard_le
    have hξ_mem : (ξ : Ω F) ∈ R_fin := by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P_poly]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero]
      rw [← Units.val_pow_eq_pow_val, hξ_pow, Units.val_one]
    rw [← hS_eq_R] at hξ_mem
    rcases Finset.mem_image.mp hξ_mem with ⟨i_s, _, hi_s⟩
    set s : ℕ := i_s.1
    have hs_lt : s < ℓ := i_s.2
    have hs_eq : ζ ^ s = ξ := Units.ext hi_s
    have hν₂_eq : ν₂ = ν₁ ^ s := by
      apply MonoidHom.ext
      intro a
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
      rw [map_zpow ν₂, map_zpow (ν₁ ^ s), MonoidHom.pow_apply, hs_eq]
    have hs_ne0 : s ≠ 0 := by
      intro hs0
      apply hν₂_ne
      apply MonoidHom.ext
      intro a
      rw [hν₂_eq, hs0, MonoidHom.pow_apply, pow_zero, MonoidHom.one_apply]
    have hs_pos : 0 < s := Nat.pos_of_ne_zero hs_ne0
    have hcop : Nat.Coprime ℓ s :=
      (Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt hs_pos hs_lt)
    have hpow_mod : ∀ j : ℕ, ν₁ ^ ((s * j) % ℓ) = ν₂ ^ j := by
      intro j
      apply MonoidHom.ext
      intro a
      have hdiv := Nat.div_add_mod (s * j) ℓ
      have h1 : (ν₁ a) ^ ℓ = 1 := by
        rw [← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply]
      have h2 : ν₂ a = (ν₁ a) ^ s := by
        rw [hν₂_eq, MonoidHom.pow_apply]
      calc (ν₁ ^ ((s * j) % ℓ)) a
        _ = (ν₁ a) ^ ((s * j) % ℓ) := MonoidHom.pow_apply ν₁ ((s * j) % ℓ) a
        _ = ((ν₁ a) ^ ℓ) ^ ((s * j) / ℓ) * (ν₁ a) ^ ((s * j) % ℓ) := by
            rw [h1, one_pow, one_mul]
        _ = (ν₁ a) ^ (ℓ * ((s * j) / ℓ) + (s * j) % ℓ) := by
            rw [← pow_mul, ← pow_add]
        _ = (ν₁ a) ^ (s * j) := by rw [hdiv]
        _ = ((ν₁ a) ^ s) ^ j := pow_mul (ν₁ a) s j
        _ = (ν₂ a) ^ j := by rw [← h2]
        _ = (ν₂ ^ j) a := (MonoidHom.pow_apply ν₂ j a).symm
    let μ : ℕ → ℕ := fun j => (s * j) % ℓ
    have hinj_mod : ∀ {j₁ j₂ : ℕ}, j₁ < ℓ → j₂ < ℓ → μ j₁ = μ j₂ → j₁ = j₂ :=
      fun hj₁ hj₂ heq =>
        Nat.ModEq.eq_of_lt_of_lt (Nat.ModEq.cancel_left_of_coprime hcop heq) hj₁ hj₂
    have hsub_range : (Finset.range ℓ).image μ ⊆ Finset.range ℓ :=
      Finset.image_subset_iff.mpr fun j _ => Finset.mem_range.mpr (Nat.mod_lt (s * j) hPrime.pos)
    have hinj_range : Set.InjOn μ (Finset.range ℓ) :=
      fun j₁ hj₁ j₂ hj₂ heq => hinj_mod (Finset.mem_range.mp hj₁) (Finset.mem_range.mp hj₂) heq
    have himg_range : (Finset.range ℓ).image μ = Finset.range ℓ :=
      Finset.eq_of_subset_of_card_le hsub_range
        (le_of_eq (Finset.card_image_of_injOn hinj_range).symm)
    have hsub_erase : ((Finset.range ℓ).erase 0).image μ ⊆ (Finset.range ℓ).erase 0 := by
      rw [Finset.image_subset_iff]
      intro j hj
      rcases Finset.mem_erase.mp hj with ⟨hj_ne0, hj_mem⟩
      have hj_lt : j < ℓ := Finset.mem_range.mp hj_mem
      refine Finset.mem_erase.mpr ⟨?_, Finset.mem_range.mpr (Nat.mod_lt (s * j) hPrime.pos)⟩
      intro hμ0
      have hμ_eq : μ j = μ 0 := by
        dsimp [μ] at hμ0 ⊢
        rw [hμ0]
      exact hj_ne0 (hinj_mod hj_lt hPrime.pos hμ_eq)
    have hinj_erase : Set.InjOn μ ((Finset.range ℓ).erase 0) :=
      fun j₁ hj₁ j₂ hj₂ heq =>
        hinj_mod (Finset.mem_range.mp (Finset.mem_erase.mp hj₁).2)
          (Finset.mem_range.mp (Finset.mem_erase.mp hj₂).2) heq
    have himg_erase : ((Finset.range ℓ).erase 0).image μ = (Finset.range ℓ).erase 0 :=
      Finset.eq_of_subset_of_card_le hsub_erase
        (le_of_eq (Finset.card_image_of_injOn hinj_erase).symm)
    have hprod_unit : ∀ a : k_Lˣ,
        (∏ j ∈ Finset.range ℓ, ((ν₁ ^ j) a)⁻¹) =
          ∏ j ∈ Finset.range ℓ, ((ν₂ ^ j) a)⁻¹ := by
      intro a
      calc (∏ j ∈ Finset.range ℓ, ((ν₁ ^ j) a)⁻¹)
        _ = ∏ k ∈ (Finset.range ℓ).image μ, ((ν₁ ^ k) a)⁻¹ := by rw [himg_range]
        _ = ∏ j ∈ Finset.range ℓ, ((ν₁ ^ (μ j)) a)⁻¹ := Finset.prod_image hinj_range
        _ = ∏ j ∈ Finset.range ℓ, ((ν₂ ^ j) a)⁻¹ := by
            refine Finset.prod_congr rfl fun j _ => ?_
            rw [hpow_mod j]
    have hχ_eq : χ₁ = χ₂ := by
      apply MonoidHom.ext
      intro a
      have h := hRest a
      rw [hprod_unit a] at h
      exact inv_inj.mp (mul_right_cancel h)
    have hprod_gauss :
        (∏ j ∈ (Finset.range ℓ).erase 0,
          (∑ x : k_Lˣ, ((ν₁ ^ j) x : Ω F) * ψ_k (x : k_L))) =
        (∏ j ∈ (Finset.range ℓ).erase 0,
          (∑ x : k_Lˣ, ((ν₂ ^ j) x : Ω F) * ψ_k (x : k_L))) := by
      calc (∏ j ∈ (Finset.range ℓ).erase 0,
            (∑ x : k_Lˣ, ((ν₁ ^ j) x : Ω F) * ψ_k (x : k_L)))
        _ = ∏ k ∈ ((Finset.range ℓ).erase 0).image μ,
              (∑ x : k_Lˣ, ((ν₁ ^ k) x : Ω F) * ψ_k (x : k_L)) := by rw [himg_erase]
        _ = ∏ j ∈ (Finset.range ℓ).erase 0,
              (∑ x : k_Lˣ, ((ν₁ ^ (μ j)) x : Ω F) * ψ_k (x : k_L)) :=
            Finset.prod_image hinj_erase
        _ = ∏ j ∈ (Finset.range ℓ).erase 0,
              (∑ x : k_Lˣ, ((ν₂ ^ j) x : Ω F) * ψ_k (x : k_L)) := by
            refine Finset.prod_congr rfl fun j _ => ?_
            rw [hpow_mod j]
    rw [hχ_eq, hprod_gauss]
    linear_combination
      Q_ram * ((χ₂ (Units.mk0 (ℓ : k_L) hNeChar))⁻¹ : Ω F) *
        (∑ x : k_Lˣ, (χ₂ x : Ω F) * ψ_k (x : k_L)) *
        Q_ram * Q_unr *
        (∏ j ∈ (Finset.range ℓ).erase 0,
          (∑ x : k_Lˣ, ((ν₂ ^ j) x : Ω F) * ψ_k (x : k_L))) * hCU
  · intro Q_ram Q_unr C_N C_M G_N G_ν G_M U_N U_M hUN hCU LHS_SML RHS_SML LHS_G RHS_G
      hLHS_ne0 hPow hGauss
    have hCN_eq : C_N = C_M * (U_M : Ω F) := by
      have h := hCU
      rw [hUN, Units.val_one, mul_one] at h
      exact h
    set P : Ω F := Q_ram * Q_unr ^ 2 * C_N
    have hLHS_eq : LHS_SML = P * RHS_G := by
      dsimp [LHS_SML, P, RHS_G]
      rw [hUN, Units.val_one]
      ring
    have hRHS_eq : RHS_SML = P * LHS_G := by
      dsimp [RHS_SML, P, LHS_G]
      rw [hCN_eq]
      ring
    have hmul_ne0 : P * RHS_G ≠ 0 := hLHS_eq ▸ hLHS_ne0
    have hP_ne0 : P ≠ 0 := left_ne_zero_of_mul hmul_ne0
    have hRHS_G_ne0 : RHS_G ≠ 0 := right_ne_zero_of_mul hmul_ne0
    have hPow_G : LHS_G ^ ℓ = RHS_G ^ ℓ := by
      have hPow' : P ^ ℓ * RHS_G ^ ℓ = P ^ ℓ * LHS_G ^ ℓ := by
        rw [← mul_pow, ← mul_pow, ← hLHS_eq, ← hRHS_eq, hPow]
      exact (mul_left_cancel₀ (pow_ne_zero ℓ hP_ne0) hPow').symm
    have hG_eq : LHS_G = RHS_G := hGauss hRHS_G_ne0 hPow_G
    rw [hLHS_eq, hRHS_eq, hG_eq]

theorem ld_ch12_tame_cond_one_local_to_residue_gauss_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E M₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E] [FiniteDimensional F M₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hTame : Module.finrank L (IntermediateField.extendScalars hLE) ≠ p F)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψM₁ : IsAdmissibleChar F M₁ (traceChar F hLM₁ ψ))
    (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (χE' : Eˣ →* (Ω F)ˣ) (χM₁' : M₁ˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1)
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1)
    (hνM₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1)
    (hν_triv1 : ∀ u ∈ unitGroup F L 1, νE u = 1 ∧ νM₁ u = 1)
    (hν_not_both0 : ¬ (condExp F L νE = 0 ∧ condExp F L νM₁ = 0))
    (hχE_pow : ∀ y : Eˣ,
      (χE' y) ^ (Module.finrank L (IntermediateField.extendScalars hLE)) =
        χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom (Units.map (normLM F hLE) y)))
    (hχM₁_pow : ∀ z : M₁ˣ,
      (χM₁' z) ^ (Module.finrank L (IntermediateField.extendScalars hLE)) =
        χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom (Units.map (normLM F hLM₁) z)))
    (hConj_unit :
      (condExp F L νE ≠ 0 ∧ condExp F L νM₁ = 0 →
        ∀ (σ : M₁ ≃ₐ[F] M₁),
          (∀ x : L, σ (IntermediateField.inclusion hLM₁ x) = IntermediateField.inclusion hLM₁ x) →
          σ ≠ 1 →
          ∃ z₀ ∈ unitGroup F M₁ 0,
            χM₁' (Units.map σ.toRingEquiv.toMonoidHom z₀) ≠ χM₁' z₀) ∧
      (condExp F L νM₁ ≠ 0 ∧ condExp F L νE = 0 →
        ∀ (σ : E ≃ₐ[F] E),
          (∀ x : L, σ (IntermediateField.inclusion hLE x) = IntermediateField.inclusion hLE x) →
          σ ≠ 1 →
          ∃ y₀ ∈ unitGroup F E 0,
            χE' (Units.map σ.toRingEquiv.toMonoidHom y₀) ≠ χE' y₀))
    (hRest : ∀ x : Lˣ,
      χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)), (νE ^ j) x) =
      χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)), (νM₁ ^ j) x))
    (hcondE1 : condExp F E χE' = 1) (hcondM₁1 : condExp F M₁ χM₁' = 1)
    (hχE_triv1 : ∀ u ∈ unitGroup F E 1, χE' u = 1)
    (hχM₁_triv1 : ∀ u ∈ unitGroup F M₁ 1, χM₁' u = 1)
    (hLHS_ne0 :
      let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
      let ψE := traceChar F hLE ψ
      let ψM₁ := traceChar F hLM₁ ψ
      tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ) ≠ 0)
    (hRHS_ne0 :
      let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
      let ψE := traceChar F hLE ψ
      let ψM₁ := traceChar F hLM₁ ψ
      tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) ≠ 0)
    (hPow :
      let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
      let ψE := traceChar F hLE ψ
      let ψM₁ := traceChar F hLM₁ ψ
      (tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ)) ^ ℓ =
        (tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ)) ^ ℓ)
    (hFF_Gauss : ∀ (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
      [Algebra k_L k_M] [CharP k_L (p F)] [CharP k_M (p F)],
      Module.finrank k_L k_M = Module.finrank L (IntermediateField.extendScalars hLE) →
      ∀ (hNeChar : (Module.finrank L (IntermediateField.extendScalars hLE) : k_L) ≠ 0)
        (ψ_k : AddChar k_L (Ω F)), ψ_k ≠ 1 →
      ∀ (ν_k χ_L : k_Lˣ →* (Ω F)ˣ) (χ_M : k_Mˣ →* (Ω F)ˣ),
        ν_k ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1 →
        ν_k ≠ 1 →
        (∀ y : k_Mˣ,
          (χ_M y) ^ (Module.finrank L (IntermediateField.extendScalars hLE)) =
            χ_L (Units.map (Algebra.norm k_L (S := k_M)) y)) →
        χ_M ^ (Fintype.card k_L) ≠ χ_M →
        let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
