theorem ld_ch12_finite_field_card_and_subfield_generator (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] [CharP k_L (p F)] [CharP k_M (p F)]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ)
    (hfinrank : Module.finrank k_L k_M = ℓ)
    (ν_k : k_Lˣ →* (Ω F)ˣ)
    (hν_pow : ν_k ^ ℓ = 1)
    (hν_ne : ν_k ≠ 1) :
    let p := p F
    let q := Fintype.card k_L
    let Q := Fintype.card k_M
    let S := (Q - 1) / (q - 1)
    Nat.Prime p ∧
    ∃ (f : ℕ) (g_0 g_M : k_Mˣ) (g_L : k_Lˣ),
      0 < f ∧
      q = p ^ f ∧
      Q = q ^ ℓ ∧
      ℓ ∣ (q - 1) ∧
      2 ≤ q - 1 ∧
      2 ≤ Q - 1 ∧
      (q - 1) * S = Q - 1 ∧
      ¬ (p ∣ (Q - 1)) ∧
      IsPrimitiveRoot (g_0 : k_M) (Q - 1) ∧
      g_M = g_0 ^ p ∧
      (∀ y : k_Mˣ, ∃ m < Q - 1, g_M ^ m = y) ∧
      orderOf g_M = Q - 1 ∧
      (∀ x : k_Lˣ, ∃ m < q - 1, g_L ^ m = x) ∧
      orderOf g_L = q - 1 ∧
      Units.map (algebraMap k_L k_M).toMonoidHom g_L = g_M ^ S :=
by
  dsimp only
  set p₀ := p F
  set q₀ := Fintype.card k_L
  set Q₀ := Fintype.card k_M
  set S := (Q₀ - 1) / (q₀ - 1)
  obtain ⟨f_pnat, hp, hq_eq₀⟩ := FiniteField.card k_L p₀
  set f : ℕ := (f_pnat : ℕ)
  have hq_eq : q₀ = p₀ ^ f := hq_eq₀
  have hf_pos : 0 < f := f_pnat.pos
  have hQ_eq : Q₀ = q₀ ^ ℓ := by
    have hcard := Module.card_eq_pow_finrank (K := k_L) (V := k_M)
    rw [hfinrank] at hcard
    exact hcard
  have hdvd_q1 : ℓ ∣ (q₀ - 1) := by
    obtain ⟨x₀, hx₀_ne⟩ := DFunLike.ne_iff.mp hν_ne
    rw [MonoidHom.one_apply] at hx₀_ne
    have hx₀_pow : (ν_k x₀) ^ ℓ = 1 := by
      simpa only [MonoidHom.pow_apply, MonoidHom.one_apply] using DFunLike.congr_fun hν_pow x₀
    haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
    have hord_νx₀ : orderOf (ν_k x₀) = ℓ := orderOf_eq_prime hx₀_pow hx₀_ne
    have hdvd1 : ℓ ∣ orderOf x₀ := hord_νx₀ ▸ orderOf_map_dvd ν_k x₀
    have hdvd2 : orderOf x₀ ∣ Fintype.card k_Lˣ := orderOf_dvd_card
    rw [Fintype.card_units] at hdvd2
    exact dvd_trans hdvd1 hdvd2
  have hq_ge2 : 2 ≤ q₀ := by
    calc 2 = 2 ^ 1 := rfl
      _ ≤ p₀ ^ 1 := Nat.pow_le_pow_left hp.two_le 1
      _ ≤ p₀ ^ f := Nat.pow_le_pow_right hp.pos hf_pos
      _ = q₀ := hq_eq.symm
  have hq1_pos : 0 < q₀ - 1 := by omega
  have hq1_ge2 : 2 ≤ q₀ - 1 := by
    have hle := Nat.le_of_dvd hq1_pos hdvd_q1
    have h2 := hPrime.two_le
    omega
  have hQ_ge_q : q₀ ≤ Q₀ := by
    calc q₀ = q₀ ^ 1 := (pow_one q₀).symm
      _ ≤ q₀ ^ ℓ := Nat.pow_le_pow_right (by omega) hPrime.pos
      _ = Q₀ := hQ_eq.symm
  have hQ1_ge2 : 2 ≤ Q₀ - 1 := by omega
  have hdvd_Q1 : (q₀ - 1) ∣ (Q₀ - 1) := by
    have hdvd := Nat.sub_dvd_pow_sub_pow q₀ 1 ℓ
    rw [one_pow, ← hQ_eq] at hdvd
    exact hdvd
  have hS_mul : (q₀ - 1) * S = Q₀ - 1 := Nat.mul_div_cancel' hdvd_Q1
  have h_not_dvd : ¬ (p₀ ∣ (Q₀ - 1)) := by
    intro hp_dvd_Q1
    have hQ_pow : Q₀ = p₀ ^ (f * ℓ) := by rw [hQ_eq, hq_eq, ← pow_mul]
    have hfl_pos : 0 < f * ℓ := Nat.mul_pos hf_pos hPrime.pos
    have hp_dvd_Q : p₀ ∣ Q₀ := by
      rw [hQ_pow]
      exact dvd_pow_self p₀ hfl_pos.ne'
    have hQ_add : (Q₀ - 1) + 1 = Q₀ := by omega
    rw [← hQ_add] at hp_dvd_Q
    have hp_dvd_1 : p₀ ∣ 1 := (Nat.dvd_add_right hp_dvd_Q1).mp hp_dvd_Q
    exact hp.not_dvd_one hp_dvd_1
  obtain ⟨g_0, hg_0_ord⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := k_Mˣ)
  rw [Nat.card_eq_fintype_card, Fintype.card_units] at hg_0_ord
  have hg_0_prim : IsPrimitiveRoot (g_0 : k_M) (Q₀ - 1) :=
    IsPrimitiveRoot.iff_orderOf.mpr (by rw [orderOf_units, hg_0_ord])
  let g_M : k_Mˣ := g_0 ^ p₀
  have hg_M_eq : g_M = g_0 ^ p₀ := rfl
  have hcop : Nat.Coprime p₀ (Q₀ - 1) := (Nat.Prime.coprime_iff_not_dvd hp).mpr h_not_dvd
  have hg_M_ord : orderOf g_M = Q₀ - 1 := by
    rw [orderOf_pow, hg_0_ord, hcop.symm.gcd_eq_one, Nat.div_one]
  have hg_M_surj : ∀ y : k_Mˣ, ∃ m < Q₀ - 1, g_M ^ m = y := by
    let s_M : Finset k_Mˣ := (Finset.range (Q₀ - 1)).image (fun m => g_M ^ m)
    have hinj_M : Set.InjOn (fun m => g_M ^ m) ↑(Finset.range (Q₀ - 1)) := by
      rw [Finset.coe_range, ← hg_M_ord]
      exact pow_injOn_Iio_orderOf
    have hcard_sM : s_M.card = Q₀ - 1 := by
      rw [Finset.card_image_of_injOn hinj_M, Finset.card_range]
    have hcard_univ_M : (Finset.univ : Finset k_Mˣ).card = Q₀ - 1 := by
      rw [Finset.card_univ, Fintype.card_units]
    have hs_M_univ : s_M = Finset.univ :=
      Finset.eq_of_subset_of_card_le (Finset.subset_univ s_M) (by omega)
    intro y
    have hy : y ∈ s_M := hs_M_univ ▸ Finset.mem_univ y
    rcases Finset.mem_image.mp hy with ⟨m, hm_range, hm_eq⟩
    exact ⟨m, Finset.mem_range.mp hm_range, hm_eq⟩
  let ι : k_Lˣ →* k_Mˣ := Units.map (algebraMap k_L k_M).toMonoidHom
  have hι_inj : Function.Injective ι :=
    Units.map_injective (algebraMap k_L k_M).injective
  let I : Finset k_Mˣ := Finset.univ.image ι
  let P : Finset k_Mˣ := (Finset.range (q₀ - 1)).image (fun r => (g_M ^ S) ^ r)
  have hI_sub_P : I ⊆ P := by
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨x, _, rfl⟩
    obtain ⟨m, hm_lt, hm_eq⟩ := hg_M_surj (ι x)
    have hx_pow : x ^ (q₀ - 1) = 1 := by
      have hcard_u : Fintype.card k_Lˣ = q₀ - 1 := Fintype.card_units k_L
      rw [← hcard_u]
      exact pow_card_eq_one
    have hgm_pow : g_M ^ (m * (q₀ - 1)) = 1 := by
      rw [pow_mul, hm_eq, ← map_pow, hx_pow, map_one]
    have hdvd_ord : Q₀ - 1 ∣ m * (q₀ - 1) := by
      rw [← hg_M_ord]
      exact orderOf_dvd_iff_pow_eq_one.mpr hgm_pow
    have hdvd_S : S ∣ m := by
      have hdvd_mul : S * (q₀ - 1) ∣ m * (q₀ - 1) := by
        rwa [mul_comm S, hS_mul]
      exact (Nat.mul_dvd_mul_iff_right hq1_pos).mp hdvd_mul
    rcases hdvd_S with ⟨r, rfl⟩
    have hr_lt : r < q₀ - 1 :=
      Nat.lt_of_mul_lt_mul_left (a := S) (by rwa [mul_comm S (q₀ - 1), hS_mul])
    exact Finset.mem_image.mpr ⟨r, Finset.mem_range.mpr hr_lt, by rw [← pow_mul, hm_eq]⟩
  have hcard_I : I.card = q₀ - 1 := by
    rw [Finset.card_image_of_injective _ hι_inj, Finset.card_univ, Fintype.card_units]
  have hcard_P_le : P.card ≤ q₀ - 1 := by
    calc P.card ≤ (Finset.range (q₀ - 1)).card := Finset.card_image_le
      _ = q₀ - 1 := Finset.card_range (q₀ - 1)
  have hI_eq_P : I = P :=
    Finset.eq_of_subset_of_card_le hI_sub_P (by omega)
  have hgMS_mem_P : g_M ^ S ∈ P := by
    refine Finset.mem_image.mpr ⟨1, Finset.mem_range.mpr (by omega), pow_one _⟩
  have hgMS_mem_I : g_M ^ S ∈ I := hI_eq_P ▸ hgMS_mem_P
  rcases Finset.mem_image.mp hgMS_mem_I with ⟨g_L, _, hg_L_map⟩
  have hg_L_surj : ∀ x : k_Lˣ, ∃ m < q₀ - 1, g_L ^ m = x := by
    intro x
    have hx_mem_I : ι x ∈ I := Finset.mem_image_of_mem ι (Finset.mem_univ x)
    have hx_mem_P : ι x ∈ P := hI_eq_P ▸ hx_mem_I
    rcases Finset.mem_image.mp hx_mem_P with ⟨m, hm_range, hm_eq⟩
    rw [← hg_L_map, ← map_pow] at hm_eq
    exact ⟨m, Finset.mem_range.mp hm_range, hι_inj hm_eq⟩
  have hS_pos : 0 < S :=
    Nat.pos_of_ne_zero fun h0 => by rw [h0, mul_zero] at hS_mul; omega
  have hg_L_ord : orderOf g_L = q₀ - 1 := by
    rw [← orderOf_injective ι hι_inj g_L, hg_L_map, orderOf_pow, hg_M_ord,
      ← hS_mul, Nat.gcd_mul_left_left, Nat.mul_div_left _ hS_pos]
  exact ⟨hp, f, g_0, g_M, g_L, hf_pos, hq_eq, hQ_eq, hdvd_q1, hq1_ge2, hQ1_ge2,
    hS_mul, h_not_dvd, hg_0_prim, hg_M_eq, hg_M_surj, hg_M_ord, hg_L_surj, hg_L_ord, hg_L_map⟩

theorem ld_ch12_cyclotomic_poly_transfer_and_teichmuller (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_M : Type u) [Field k_M] [Fintype k_M] [CharP k_M (p F)]
    (hp : Nat.Prime (p F))
    (hQ1_ge2 : 2 ≤ Fintype.card k_M - 1)
    (h_not_dvd : ¬ ((p F) ∣ (Fintype.card k_M - 1)))
    (g_0 g_M : k_Mˣ)
    (hg_0_prim : IsPrimitiveRoot (g_0 : k_M) (Fintype.card k_M - 1))
    (hg_M_eq : g_M = g_0 ^ (p F))
    (hg_M_ord : orderOf g_M = Fintype.card k_M - 1)
    (hg_M_surj : ∀ y : k_Mˣ, ∃ m < Fintype.card k_M - 1, g_M ^ m = y) :
    let p := p F
    let N := Fintype.card k_M - 1
    ∃ (ω_M : k_Mˣ →* (Ω F)ˣ) (ϖ : Ω F)
      (Φ_Ω : Polynomial ℤ →+* Ω F) (Φ_M : Polynomial ℤ →+* k_M)
      (P_Z P_ϖ : Polynomial ℤ),
      orderOf (ω_M g_M) = N ∧
      ϖ ≠ 0 ∧
      IsPrimitiveRoot (1 + ϖ) p ∧
      Φ_Ω P_Z = (ω_M g_M : Ω F) ∧
      Φ_M P_Z = (g_M : k_M) ∧
      Φ_Ω P_ϖ = ϖ ∧
      Φ_M P_ϖ = 0 ∧
      (∀ P₁ P₂ : Polynomial ℤ, Φ_Ω P₁ = Φ_Ω P₂ → Φ_M P₁ = Φ_M P₂) :=
by
  dsimp only
  set p := p F
  set N := Fintype.card k_M - 1
  have hN_pos : 0 < N := by omega
  have hN_ne0 : N ≠ 0 := by omega
  have hNp_pos : 0 < N * p := Nat.mul_pos hN_pos hp.pos
  haveI : NeZero ((N * p : ℕ) : ℚ_[ell F]) := ⟨Nat.cast_ne_zero.mpr hNp_pos.ne'⟩
  haveI : HasEnoughRootsOfUnity (Ω F) (N * p) :=
    AlgebraicClosure.hasEnoughRootsOfUnity ℚ_[ell F] (N * p)
  obtain ⟨ζ, hζ_prim⟩ := HasEnoughRootsOfUnity.prim (M := Ω F) (n := N * p)
  set ζ_N : Ω F := ζ ^ p
  set ζ_p : Ω F := ζ ^ N
  have hζ_N : IsPrimitiveRoot ζ_N N :=
    IsPrimitiveRoot.pow hNp_pos hζ_prim (Nat.mul_comm N p)
  have hζ_p : IsPrimitiveRoot ζ_p p :=
    IsPrimitiveRoot.pow hNp_pos hζ_prim rfl
  set ϖ : Ω F := ζ_p - 1
  have h1_add_ϖ : 1 + ϖ = ζ_p := add_sub_cancel 1 ζ_p
  have hζ_p_prim : IsPrimitiveRoot (1 + ϖ) p := by
    rw [h1_add_ϖ]
    exact hζ_p
  have hϖ_ne0 : ϖ ≠ 0 := sub_ne_zero.mpr (hζ_p.ne_one hp.one_lt)
  have hζ_N_ne0 : ζ_N ≠ 0 := hζ_N.ne_zero hN_ne0
  set u_ζ : (Ω F)ˣ := Units.mk0 ζ_N hζ_N_ne0
  have hu_ord : orderOf u_ζ = N := by
    rw [← orderOf_units, Units.val_mk0, ← hζ_N.eq_orderOf]
  let e : k_Mˣ → ℕ := fun y => Nat.find (hg_M_surj y)
  have he_pow : ∀ y : k_Mˣ, g_M ^ (e y) = y :=
    fun y => (Nat.find_spec (hg_M_surj y)).2
  have h_pow_eq : ∀ (y : k_Mˣ) (m : ℕ), g_M ^ m = y → u_ζ ^ m = u_ζ ^ (e y) := by
    intro y m hm
    have h1 : g_M ^ m = g_M ^ (e y) := hm.trans (he_pow y).symm
    rw [pow_eq_pow_iff_modEq, hg_M_ord] at h1
    rw [pow_eq_pow_iff_modEq, hu_ord]
    exact h1
  let ω_M : k_Mˣ →* (Ω F)ˣ := {
    toFun := fun y => u_ζ ^ (e y)
    map_one' := (h_pow_eq 1 0 (pow_zero g_M)).symm.trans (pow_zero u_ζ)
    map_mul' := fun y₁ y₂ =>
      (h_pow_eq (y₁ * y₂) (e y₁ + e y₂) (by rw [pow_add, he_pow, he_pow])).symm.trans
        (pow_add u_ζ (e y₁) (e y₂))
  }
  have hω_gM : ω_M g_M = u_ζ :=
    (h_pow_eq g_M 1 (pow_one g_M)).symm.trans (pow_one u_ζ)
  have hω_M_ord : orderOf (ω_M g_M) = N := by
    rw [hω_gM, hu_ord]
  let Φ_Ω : Polynomial ℤ →+* Ω F := (Polynomial.aeval ζ).toRingHom
  let Φ_M : Polynomial ℤ →+* k_M :=
    (Polynomial.evalRingHom (g_0 : k_M)).comp (Polynomial.mapRingHom (Int.castRingHom k_M))
  have hΦ_Ω_X : Φ_Ω Polynomial.X = ζ := Polynomial.aeval_X ζ
  have hΦ_M_X : Φ_M Polynomial.X = (g_0 : k_M) := by
    simp [Φ_M]
  set P_Z : Polynomial ℤ := Polynomial.X ^ p
  set P_ϖ : Polynomial ℤ := Polynomial.X ^ N - 1
  have hΦ_Ω_Z : Φ_Ω P_Z = (ω_M g_M : Ω F) := by
    rw [map_pow, hΦ_Ω_X, hω_gM, Units.val_mk0]
  have hΦ_M_Z : Φ_M P_Z = (g_M : k_M) := by
    rw [map_pow, hΦ_M_X, hg_M_eq, Units.val_pow_eq_pow_val]
  have hΦ_Ω_ϖ : Φ_Ω P_ϖ = ϖ := by
    rw [map_sub, map_pow, map_one, hΦ_Ω_X]
  have hΦ_M_ϖ : Φ_M P_ϖ = 0 := by
    rw [map_sub, map_pow, map_one, hΦ_M_X, hg_0_prim.pow_eq_one, sub_self]
  have hTransfer : ∀ P₁ P₂ : Polynomial ℤ, Φ_Ω P₁ = Φ_Ω P₂ → Φ_M P₁ = Φ_M P₂ := by
    intro P₁ P₂ h_eq
    have h_aeval : (Polynomial.aeval ζ) (P₁ - P₂) = 0 := by
      change Φ_Ω (P₁ - P₂) = 0
      rw [map_sub, sub_eq_zero]
      exact h_eq
    have h_dvd_min : minpoly ℤ ζ ∣ (P₁ - P₂) :=
      minpoly.isIntegrallyClosed_dvd (hζ_prim.isIntegral hNp_pos) h_aeval
    have h_dvd_cyc : Polynomial.cyclotomic (N * p) ℤ ∣ (P₁ - P₂) := by
      rwa [Polynomial.cyclotomic_eq_minpoly hζ_prim hNp_pos]
    have h_map_dvd : Φ_M (Polynomial.cyclotomic (N * p) ℤ) ∣ Φ_M (P₁ - P₂) :=
      map_dvd Φ_M h_dvd_cyc
    haveI : Fact p.Prime := ⟨hp⟩
    have h_cyc_zero : Φ_M (Polynomial.cyclotomic (N * p) ℤ) = 0 := by
      change Polynomial.eval (g_0 : k_M)
        (Polynomial.map (Int.castRingHom k_M) (Polynomial.cyclotomic (N * p) ℤ)) = 0
      rw [Polynomial.map_cyclotomic_int,
        Polynomial.cyclotomic_mul_prime_eq_pow_of_not_dvd k_M h_not_dvd,
        Polynomial.eval_pow,
        Polynomial.IsRoot.def.mp (hg_0_prim.isRoot_cyclotomic hN_pos),
        zero_pow (Nat.sub_ne_zero_of_lt hp.one_lt)]
    rw [h_cyc_zero, zero_dvd_iff, map_sub, sub_eq_zero] at h_map_dvd
    exact h_map_dvd
  exact ⟨ω_M, ϖ, Φ_Ω, Φ_M, P_Z, P_ϖ, hω_M_ord, hϖ_ne0, hζ_p_prim,
    hΦ_Ω_Z, hΦ_M_Z, hΦ_Ω_ϖ, hΦ_M_ϖ, hTransfer⟩

theorem ld_ch12_trace_addChar_and_first_gauss_poly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] [CharP k_L (p F)] [CharP k_M (p F)]
    (hp : Nat.Prime (p F))
    (hq1_ge2 : 2 ≤ Fintype.card k_L - 1)
    (hQ1_ge2 : 2 ≤ Fintype.card k_M - 1)
    (g_L : k_Lˣ) (g_M : k_Mˣ)
    (hg_L_ord : orderOf g_L = Fintype.card k_L - 1)
    (hg_L_surj : ∀ x : k_Lˣ, ∃ m < Fintype.card k_L - 1, g_L ^ m = x)
    (hg_M_ord : orderOf g_M = Fintype.card k_M - 1)
    (hg_M_surj : ∀ y : k_Mˣ, ∃ m < Fintype.card k_M - 1, g_M ^ m = y)
    (ω_M : k_Mˣ →* (Ω F)ˣ)
    (hω_M_ord : orderOf (ω_M g_M) = Fintype.card k_M - 1)
    (hg_L_map : Units.map (algebraMap k_L k_M).toMonoidHom g_L =
      g_M ^ ((Fintype.card k_M - 1) / (Fintype.card k_L - 1)))
    (hS_mul : (Fintype.card k_L - 1) * ((Fintype.card k_M - 1) / (Fintype.card k_L - 1)) =
      Fintype.card k_M - 1)
    (ϖ : Ω F) (hζ_p : IsPrimitiveRoot (1 + ϖ) (p F))
    (Φ_Ω : Polynomial ℤ →+* Ω F) (Φ_M : Polynomial ℤ →+* k_M)
    (P_Z P_ϖ : Polynomial ℤ)
    (hΦ_Ω_Z : Φ_Ω P_Z = (ω_M g_M : Ω F))
    (hΦ_M_Z : Φ_M P_Z = (g_M : k_M))
    (hΦ_Ω_ϖ : Φ_Ω P_ϖ = ϖ)
    (hΦ_M_ϖ : Φ_M P_ϖ = 0) :
    let p := p F
    let ω_L := ω_M.comp (Units.map (algebraMap k_L k_M).toMonoidHom)
    ∃ (ψ_0L : AddChar k_L (Ω F)) (P_1L P_1M : Polynomial ℤ),
      ψ_0L ≠ 1 ∧
      orderOf (ω_L g_L) = Fintype.card k_L - 1 ∧
      (∀ x : k_L, ψ_0L (x ^ p) = ψ_0L x) ∧
      (∀ y : k_M,
        ψ_0L (Algebra.trace k_L k_M (y ^ p)) = ψ_0L (Algebra.trace k_L k_M y)) ∧
      Φ_M P_1L = -1 ∧
      Φ_M P_1M = -1 ∧
      (∑ x : k_Lˣ, ((ω_L x)⁻¹ : Ω F) * ψ_0L (x : k_L)) = Φ_Ω P_1L * ϖ ∧
      (∑ y : k_Mˣ, ((ω_M y)⁻¹ : Ω F) * ψ_0L (Algebra.trace k_L k_M (y : k_M))) = Φ_Ω P_1M * ϖ :=
by
  dsimp only
  set q1 := Fintype.card k_L - 1
  set Q1 := Fintype.card k_M - 1
  set S := Q1 / q1
  set ω_L := ω_M.comp (Units.map (algebraMap k_L k_M).toMonoidHom)
  have hS_ne0 : S ≠ 0 := by
    intro h0
    have hmul : q1 * S = 0 := by rw [h0, mul_zero]
    rw [hS_mul] at hmul
    omega
  have hω_L_eq : ω_L g_L = (ω_M g_M) ^ S := by
    change ω_M (Units.map (algebraMap k_L k_M).toMonoidHom g_L) = (ω_M g_M) ^ S
    rw [hg_L_map, map_pow]
  have hω_L_ord : orderOf (ω_L g_L) = q1 := by
    rw [hω_L_eq, orderOf_pow' (ω_M g_M) hS_ne0, hω_M_ord]
    have hdvd : S ∣ Q1 := ⟨q1, by rw [mul_comm, hS_mul]⟩
    rw [Nat.gcd_eq_right hdvd, ← hS_mul]
    exact Nat.mul_div_left q1 (Nat.pos_of_ne_zero hS_ne0)
  have hΦ_Ω_ZL : Φ_Ω (P_Z ^ S) = (ω_L g_L : Ω F) := by
    rw [map_pow, hΦ_Ω_Z, ← Units.val_pow_eq_pow_val, ← hω_L_eq]
  have hΦ_M_ZL : Φ_M (P_Z ^ S) = algebraMap k_L k_M (g_L : k_L) := by
    rw [map_pow, hΦ_M_Z, ← Units.val_pow_eq_pow_val, ← hg_L_map]
    rfl
  haveI : Fact (Nat.Prime (p F)) := ⟨hp⟩
  letI : Algebra (ZMod (p F)) k_L := ZMod.algebra k_L (p F)
  letI : Algebra (ZMod (p F)) k_M := ZMod.algebra k_M (p F)
  haveI : IsScalarTower (ZMod (p F)) k_L k_M :=
    IsScalarTower.of_algebraMap_eq' (Subsingleton.elim _ _)
  let d_L := Module.finrank (ZMod (p F)) k_L
  let d_M := Module.finrank (ZMod (p F)) k_M
  let t_L : k_L → ℕ := fun x => (Algebra.trace (ZMod (p F)) k_L x).val
  let t_M : k_M → ℕ := fun y => (Algebra.trace (ZMod (p F)) k_M y).val
  have hζ_pow_p : (1 + ϖ) ^ (p F) = 1 := hζ_p.pow_eq_one
  let ψ_0L : AddChar k_L (Ω F) := {
    toFun := fun x => (1 + ϖ) ^ (t_L x)
    map_zero_eq_one' := by
      simp [t_L, map_zero, ZMod.val_zero]
    map_add_eq_mul' := fun x₁ x₂ => by
      dsimp only [t_L]
      set a := Algebra.trace (ZMod (p F)) k_L x₁
      set b := Algebra.trace (ZMod (p F)) k_L x₂
      have hadd : Algebra.trace (ZMod (p F)) k_L (x₁ + x₂) = a + b := map_add _ x₁ x₂
      rw [hadd, ZMod.val_add, ← pow_add]
      have hdiv : a.val + b.val = (p F) * ((a.val + b.val) / (p F)) + (a.val + b.val) % (p F) :=
        (Nat.div_add_mod (a.val + b.val) (p F)).symm
      conv_rhs => rw [hdiv, pow_add, pow_mul, hζ_pow_p, one_pow, one_mul]
  }
  have hψ_0L_ne1 : ψ_0L ≠ 1 := by
    intro h1
    have htr_ne0 : Algebra.trace (ZMod (p F)) k_L ≠ 0 := Algebra.trace_ne_zero (ZMod (p F)) k_L
    obtain ⟨x₀, hx₀⟩ : ∃ x₀ : k_L, Algebra.trace (ZMod (p F)) k_L x₀ ≠ 0 := by
      by_contra h
      push_neg at h
      apply htr_ne0
      ext x
      exact h x
    have hval_pos : 0 < t_L x₀ := ZMod.val_pos.mpr hx₀
    have hval_lt : t_L x₀ < p F := ZMod.val_lt _
    have hord_ζ : orderOf (1 + ϖ) = p F := IsPrimitiveRoot.iff_orderOf.mp hζ_p
    have hpow_ne1 : (1 + ϖ) ^ (t_L x₀) ≠ 1 :=
      pow_ne_one_of_lt_orderOf hval_pos.ne' (by rw [hord_ζ]; exact hval_lt)
    have heval : ψ_0L x₀ = 1 := by
      rw [h1]
      rfl
    exact hpow_ne1 heval
  have hfield_props : ∀ (k : Type u) [Field k] [Fintype k] [CharP k (p F)],
      letI : Algebra (ZMod (p F)) k := ZMod.algebra k (p F)
      0 < Module.finrank (ZMod (p F)) k ∧
      Fintype.card k = (p F) ^ (Module.finrank (ZMod (p F)) k) ∧
      (∀ x : k,
        (((Algebra.trace (ZMod (p F)) k x).val : ℕ) : k) =
          ∑ i ∈ Finset.range (Module.finrank (ZMod (p F)) k), x ^ ((p F) ^ i)) ∧
      (∀ x : k, Algebra.trace (ZMod (p F)) k (x ^ (p F)) = Algebra.trace (ZMod (p F)) k x) := by
    intro k _ _ _
    letI : Algebra (ZMod (p F)) k := ZMod.algebra k (p F)
    have hd_pos : 0 < Module.finrank (ZMod (p F)) k := Module.finrank_pos
    have hcard : Fintype.card k = (p F) ^ (Module.finrank (ZMod (p F)) k) := by
      have hc := Module.card_eq_pow_finrank (K := ZMod (p F)) (V := k)
      rw [ZMod.card (p F)] at hc
      exact hc
    have hsum : ∀ x : k,
        (((Algebra.trace (ZMod (p F)) k x).val : ℕ) : k) =
          ∑ i ∈ Finset.range (Module.finrank (ZMod (p F)) k), x ^ ((p F) ^ i) := by
      intro x
      have h1 := FiniteField.algebraMap_trace_eq_sum_pow (ZMod (p F)) k x
      rw [Nat.card_zmod (p F)] at h1
      have hcast : algebraMap (ZMod (p F)) k (Algebra.trace (ZMod (p F)) k x) =
          (((Algebra.trace (ZMod (p F)) k x).val : ℕ) : k) := by
        rw [← map_natCast (algebraMap (ZMod (p F)) k), ZMod.natCast_zmod_val]
      rw [← hcast, h1]
    have hfrob : ∀ x : k, Algebra.trace (ZMod (p F)) k (x ^ (p F)) = Algebra.trace (ZMod (p F)) k x := by
      intro x
      apply (algebraMap (ZMod (p F)) k).injective
      have h1 := FiniteField.algebraMap_trace_eq_sum_pow (ZMod (p F)) k x
      have h2 := FiniteField.algebraMap_trace_eq_sum_pow (ZMod (p F)) k (x ^ (p F))
      rw [Nat.card_zmod (p F)] at h1 h2
      have h3 := congr_arg (frobenius k (p F)) h1
      rw [frobenius_def, ← map_pow, ZMod.pow_card, map_sum] at h3
      have hsum_eq :
          (∑ i ∈ Finset.range (Module.finrank (ZMod (p F)) k), frobenius k (p F) (x ^ ((p F) ^ i))) =
            ∑ i ∈ Finset.range (Module.finrank (ZMod (p F)) k), (x ^ (p F)) ^ ((p F) ^ i) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [frobenius_def, ← pow_mul, mul_comm, pow_mul]
      rw [hsum_eq, ← h2] at h3
      exact h3.symm
    exact ⟨hd_pos, hcard, hsum, hfrob⟩
  obtain ⟨hd_L_pos, hcard_L, hsum_L, hfrob_L⟩ := hfield_props k_L
  obtain ⟨hd_M_pos, hcard_M, hsum_M, hfrob_M⟩ := hfield_props k_M
  have htr_M : ∀ y : k_M, t_L (Algebra.trace k_L k_M y) = t_M y := by
    intro y
    dsimp only [t_L, t_M]
    rw [Algebra.trace_trace (R := ZMod (p F)) (S := k_L) (T := k_M) y]
  have hgauss_poly : ∀ (k : Type u) [Field k] [Fintype k] [Algebra k k_M] [CharP k (p F)]
      (hk1_ge2 : 2 ≤ Fintype.card k - 1)
      (d : ℕ) (hd_pos : 0 < d) (hcard_k : Fintype.card k = (p F) ^ d)
      (g_k : kˣ) (hg_k_ord : orderOf g_k = Fintype.card k - 1)
      (hg_k_surj : ∀ x : kˣ, ∃ m < Fintype.card k - 1, g_k ^ m = x)
      (ω_k : kˣ →* (Ω F)ˣ) (hω_k_ord : orderOf (ω_k g_k) = Fintype.card k - 1)
      (P_Zk : Polynomial ℤ)
      (hΦ_Ω_Zk : Φ_Ω P_Zk = (ω_k g_k : Ω F))
      (hΦ_M_Zk : Φ_M P_Zk = algebraMap k k_M (g_k : k))
      (t_k : k → ℕ)
      (ht_k_sum : ∀ x : k, (t_k x : k) = ∑ i ∈ Finset.range d, x ^ ((p F) ^ i)),
      ∃ P_1k : Polynomial ℤ,
        Φ_M P_1k = -1 ∧
        (∑ x : kˣ, ((ω_k x)⁻¹ : Ω F) * (1 + ϖ) ^ (t_k (x : k))) = Φ_Ω P_1k * ϖ := by
    intro k _ _ _ _ hk1_ge2 d hd_pos hcard_k g_k hg_k_ord hg_k_surj ω_k hω_k_ord P_Zk
      hΦ_Ω_Zk hΦ_M_Zk t_k ht_k_sum
    set N := Fintype.card k - 1
    let dlog : kˣ → ℕ := fun x => Nat.find (hg_k_surj x)
    have hdlog_lt : ∀ x : kˣ, dlog x < N := fun x => (Nat.find_spec (hg_k_surj x)).1
    have hdlog_eq : ∀ x : kˣ, g_k ^ (dlog x) = x := fun x => (Nat.find_spec (hg_k_surj x)).2
    let P_1k : Polynomial ℤ :=
      ∑ x : kˣ, P_Zk ^ (N - dlog x) * (∑ j ∈ Finset.range (t_k (x : k)), (1 + P_ϖ) ^ j)
    have hω_inv : ∀ x : kˣ, Φ_Ω (P_Zk ^ (N - dlog x)) = ((ω_k x)⁻¹ : Ω F) := by
      intro x
      have h1 : (ω_k g_k) ^ (N - dlog x) = (ω_k x)⁻¹ := by
        apply eq_inv_of_mul_eq_one_left
        have h2 : ω_k x = (ω_k g_k) ^ (dlog x) := by
          rw [← map_pow, hdlog_eq x]
        rw [h2, ← pow_add, Nat.sub_add_cancel (le_of_lt (hdlog_lt x)), ← hω_k_ord, pow_orderOf_eq_one]
      rw [map_pow, hΦ_Ω_Zk, ← Units.val_pow_eq_pow_val, h1, Units.val_inv_eq_inv_val]
    have hg_inv : ∀ x : kˣ, Φ_M (P_Zk ^ (N - dlog x)) = algebraMap k k_M ((x : k)⁻¹) := by
      intro x
      have h1 : g_k ^ (N - dlog x) = x⁻¹ := by
        apply eq_inv_of_mul_eq_one_left
        calc g_k ^ (N - dlog x) * x
          _ = g_k ^ (N - dlog x) * g_k ^ (dlog x) := by rw [hdlog_eq x]
          _ = g_k ^ N := by rw [← pow_add, Nat.sub_add_cancel (le_of_lt (hdlog_lt x))]
          _ = 1 := by rw [← hg_k_ord, pow_orderOf_eq_one]
      rw [map_pow, hΦ_M_Zk, ← map_pow, ← Units.val_pow_eq_pow_val, h1, Units.val_inv_eq_inv_val]
    have hω_sum_zero : (∑ x : kˣ, ((ω_k x)⁻¹ : Ω F)) = 0 := by
      have hω_ne1 : ω_k g_k ≠ 1 := by
        intro h
        rw [h, orderOf_one] at hω_k_ord
        omega
      have hω_inv_ne1 : ((ω_k g_k)⁻¹ : Ω F) - 1 ≠ 0 := by
        rw [sub_ne_zero]
        intro h
        have h' : (ω_k g_k : Ω F) = 1 := inv_eq_one.mp h
        exact hω_ne1 (Units.ext h')
      have hshift : (∑ x : kˣ, ((ω_k x)⁻¹ : Ω F)) =
          ((ω_k g_k)⁻¹ : Ω F) * (∑ x : kˣ, ((ω_k x)⁻¹ : Ω F)) := by
        have hcomp := Equiv.sum_comp (Equiv.mulLeft g_k) (fun x : kˣ => ((ω_k x)⁻¹ : Ω F))
        conv_lhs => rw [← hcomp]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun x _ => ?_
        change ((ω_k (g_k * x) : Ω F))⁻¹ = ((ω_k g_k : Ω F))⁻¹ * ((ω_k x : Ω F))⁻¹
        rw [map_mul, Units.val_mul, mul_inv_rev, mul_comm]
      have hsub : (((ω_k g_k)⁻¹ : Ω F) - 1) * (∑ x : kˣ, ((ω_k x)⁻¹ : Ω F)) = 0 := by
        rw [sub_mul, one_mul, ← hshift, sub_self]
      exact (mul_eq_zero.mp hsub).resolve_left hω_inv_ne1
    refine ⟨P_1k, ?_, ?_⟩
    · dsimp only [P_1k]
      rw [map_sum]
      have hterm_M : ∀ x : kˣ,
          Φ_M (P_Zk ^ (N - dlog x) * ∑ j ∈ Finset.range (t_k (x : k)), (1 + P_ϖ) ^ j) =
            algebraMap k k_M ((x : k)⁻¹ * (t_k (x : k) : k)) := by
        intro x
        rw [map_mul, hg_inv x, map_sum]
        have hgeom_M : (∑ j ∈ Finset.range (t_k (x : k)), Φ_M ((1 + P_ϖ) ^ j)) =
            algebraMap k k_M (t_k (x : k) : k) := by
          have h1 : ∀ j : ℕ, Φ_M ((1 + P_ϖ) ^ j) = 1 := by
            intro j
            rw [map_pow, map_add, map_one, hΦ_M_ϖ, add_zero, one_pow]
          simp_rw [h1]
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one, map_natCast]
        rw [hgeom_M, ← map_mul]
      have hsum_M :
          (∑ x : kˣ, Φ_M (P_Zk ^ (N - dlog x) * ∑ j ∈ Finset.range (t_k (x : k)), (1 + P_ϖ) ^ j)) =
            algebraMap k k_M (∑ x : kˣ, (x : k)⁻¹ * (t_k (x : k) : k)) := by
        rw [map_sum]
        exact Finset.sum_congr rfl fun x _ => hterm_M x
      rw [hsum_M]
      have hinner : (∑ x : kˣ, (x : k)⁻¹ * (t_k (x : k) : k)) = -1 := by
        have hswap : (∑ x : kˣ, (x : k)⁻¹ * (t_k (x : k) : k)) =
            ∑ i ∈ Finset.range d, ∑ x : kˣ, (x : k)⁻¹ * (x : k) ^ ((p F) ^ i) := by
          calc (∑ x : kˣ, (x : k)⁻¹ * (t_k (x : k) : k))
            _ = ∑ x : kˣ, ∑ i ∈ Finset.range d, (x : k)⁻¹ * (x : k) ^ ((p F) ^ i) := by
              refine Finset.sum_congr rfl fun x _ => ?_
              rw [ht_k_sum (x : k), Finset.mul_sum]
            _ = ∑ i ∈ Finset.range d, ∑ x : kˣ, (x : k)⁻¹ * (x : k) ^ ((p F) ^ i) :=
              Finset.sum_comm
        rw [hswap]
        have hd_eq : d = (d - 1) + 1 := (Nat.sub_add_cancel hd_pos).symm
        rw [hd_eq, Finset.sum_range_succ']
        have hi0 : (∑ x : kˣ, (x : k)⁻¹ * (x : k) ^ ((p F) ^ 0)) = -1 := by
          have h1 : ∀ x : kˣ, (x : k)⁻¹ * (x : k) ^ ((p F) ^ 0) = 1 := by
            intro x
            rw [pow_zero, pow_one, inv_mul_cancel₀ (Units.ne_zero x)]
          simp_rw [h1]
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_units, nsmul_eq_mul, mul_one]
          have hcard_pos : 1 ≤ Fintype.card k := by omega
          rw [Nat.cast_sub hcard_pos, hcard_k, Nat.cast_pow, CharP.cast_eq_zero k (p F),
            zero_pow hd_pos.ne', zero_sub, Nat.cast_one]
        have hrest : (∑ k_0 ∈ Finset.range (d - 1),
            ∑ x : kˣ, (x : k)⁻¹ * (x : k) ^ ((p F) ^ (k_0 + 1))) = 0 := by
          refine Finset.sum_eq_zero fun k_0 hk_0 => ?_
          rw [Finset.mem_range] at hk_0
          set i := k_0 + 1
          have hi_pos : 1 ≤ i := Nat.le_add_left 1 k_0
          have hi_lt : i < d := by omega
          have hp_ge2 : 2 ≤ p F := hp.two_le
          have hpi_ge2 : 2 ≤ (p F) ^ i := by
            calc 2 ≤ (p F) ^ 1 := by rw [pow_one]; exact hp_ge2
              _ ≤ (p F) ^ i := Nat.pow_le_pow_right (by omega) hi_pos
          have hpi_lt : (p F) ^ i < Fintype.card k := by
            rw [hcard_k]
            exact Nat.pow_lt_pow_right (by omega) hi_lt
          set m := (p F) ^ i - 1
          have hm_pos : 0 < m := by omega
          have hm_lt : m < N := by omega
          have hterm_pow : (∑ x : kˣ, (x : k)⁻¹ * (x : k) ^ ((p F) ^ i)) =
              ∑ x : kˣ, (x : k) ^ m := by
            refine Finset.sum_congr rfl fun x _ => ?_
            have hpow_split : (x : k) ^ ((p F) ^ i) = (x : k) * (x : k) ^ m := by
              have heq : (p F) ^ i = 1 + m := by omega
              rw [heq, pow_add, pow_one]
            rw [hpow_split, inv_mul_cancel_left₀ (Units.ne_zero x)]
          rw [hterm_pow]
          have hgm_ne1 : g_k ^ m ≠ 1 :=
            pow_ne_one_of_lt_orderOf hm_pos.ne' (by rw [hg_k_ord]; exact hm_lt)
          have hgm_sub_ne0 : (g_k : k) ^ m - 1 ≠ 0 := by
            rw [sub_ne_zero, ← Units.val_pow_eq_pow_val]
            intro h
            exact hgm_ne1 (Units.ext h)
          have hshift_m : (∑ x : kˣ, (x : k) ^ m) =
              (g_k : k) ^ m * (∑ x : kˣ, (x : k) ^ m) := by
            have hcomp := Equiv.sum_comp (Equiv.mulLeft g_k) (fun x : kˣ => (x : k) ^ m)
            conv_lhs => rw [← hcomp]
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun x _ => ?_
            change ((g_k * x : kˣ) : k) ^ m = (g_k : k) ^ m * (x : k) ^ m
            rw [Units.val_mul, mul_pow]
          have hsub_m : ((g_k : k) ^ m - 1) * (∑ x : kˣ, (x : k) ^ m) = 0 := by
            rw [sub_mul, one_mul, ← hshift_m, sub_self]
          exact (mul_eq_zero.mp hsub_m).resolve_left hgm_sub_ne0
        rw [hrest, hi0, zero_add]
      rw [hinner, map_neg, map_one]
    · dsimp only [P_1k]
      rw [map_sum, Finset.sum_mul]
      have hterm_Ω : ∀ x : kˣ,
          Φ_Ω (P_Zk ^ (N - dlog x) * ∑ j ∈ Finset.range (t_k (x : k)), (1 + P_ϖ) ^ j) * ϖ =
            ((ω_k x)⁻¹ : Ω F) * ((1 + ϖ) ^ (t_k (x : k)) - 1) := by
        intro x
        rw [map_mul, hω_inv x, mul_assoc]
        congr 1
        rw [map_sum]
        have hgeom :
            (∑ j ∈ Finset.range (t_k (x : k)), Φ_Ω ((1 + P_ϖ) ^ j)) * ϖ =
              (1 + ϖ) ^ (t_k (x : k)) - 1 := by
          have h1 : (∑ j ∈ Finset.range (t_k (x : k)), Φ_Ω ((1 + P_ϖ) ^ j)) =
              ∑ j ∈ Finset.range (t_k (x : k)), (1 + ϖ) ^ j := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_pow, map_add, map_one, hΦ_Ω_ϖ]
          have h2 := geom_sum_mul (1 + ϖ) (t_k (x : k))
          have h3 : (1 + ϖ) - 1 = ϖ := by ring
          rw [h3] at h2
          rw [h1, h2]
        exact hgeom
      have hsum_Ω :
          (∑ x : kˣ, Φ_Ω (P_Zk ^ (N - dlog x) * ∑ j ∈ Finset.range (t_k (x : k)), (1 + P_ϖ) ^ j) * ϖ) =
            ∑ x : kˣ, (((ω_k x)⁻¹ : Ω F) * (1 + ϖ) ^ (t_k (x : k)) - ((ω_k x)⁻¹ : Ω F)) := by
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [hterm_Ω x, mul_sub, mul_one]
      rw [hsum_Ω, Finset.sum_sub_distrib, hω_sum_zero, sub_zero]
  obtain ⟨P_1L, hΦ_M_1L, hG_L_1⟩ :=
    hgauss_poly k_L hq1_ge2 d_L hd_L_pos hcard_L g_L hg_L_ord hg_L_surj ω_L hω_L_ord
      (P_Z ^ S) hΦ_Ω_ZL hΦ_M_ZL t_L hsum_L
  letI : Algebra k_M k_M := Algebra.id k_M
  obtain ⟨P_1M, hΦ_M_1M, hG_M_1⟩ :=
    hgauss_poly k_M hQ1_ge2 d_M hd_M_pos hcard_M g_M hg_M_ord hg_M_surj ω_M hω_M_ord
      P_Z hΦ_Ω_Z hΦ_M_Z t_M hsum_M
  refine ⟨ψ_0L, P_1L, P_1M, hψ_0L_ne1, hω_L_ord, ?_, ?_, hΦ_M_1L, hΦ_M_1M, ?_, ?_⟩
  · intro x
    change (1 + ϖ) ^ (t_L (x ^ (p F))) = (1 + ϖ) ^ (t_L x)
    dsimp only [t_L]
    rw [hfrob_L x]
  · intro y
    change (1 + ϖ) ^ (t_L (Algebra.trace k_L k_M (y ^ (p F)))) =
      (1 + ϖ) ^ (t_L (Algebra.trace k_L k_M y))
    rw [htr_M (y ^ (p F)), htr_M y]
    dsimp only [t_M]
    rw [hfrob_M y]
  · rw [← hG_L_1]
    rfl
  · rw [← hG_M_1]
    refine Finset.sum_congr rfl fun y _ => ?_
    change ((ω_M y)⁻¹ : Ω F) * (1 + ϖ) ^ (t_L (Algebra.trace k_L k_M (y : k_M))) =
      ((ω_M y)⁻¹ : Ω F) * (1 + ϖ) ^ (t_M (y : k_M))
    rw [htr_M (y : k_M)]

theorem ld_ch12_jacobi_one_step_polynomial (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k k_M : Type u) [Field k] [Fintype k] [Field k_M] [Fintype k_M]
    [Algebra k k_M] [CharP k (p F)] [CharP k_M (p F)]
    (hp : Nat.Prime (p F))
    (hk1_ge2 : 2 ≤ Fintype.card k - 1)
    (g_k : kˣ)
    (hg_k_ord : orderOf g_k = Fintype.card k - 1)
    (hg_k_surj : ∀ x : kˣ, ∃ m < Fintype.card k - 1, g_k ^ m = x)
    (ω_k : kˣ →* (Ω F)ˣ)
    (hω_k_ord : orderOf (ω_k g_k) = Fintype.card k - 1)
    (ψ_k : AddChar k (Ω F))
    (hψ_frob : ∀ x : k, ψ_k (x ^ (p F)) = ψ_k x)
    (Φ_Ω : Polynomial ℤ →+* Ω F) (Φ_M : Polynomial ℤ →+* k_M)
    (P_Zk : Polynomial ℤ)
    (hΦ_Ω_Zk : Φ_Ω P_Zk = (ω_k g_k : Ω F))
    (hΦ_M_Zk : Φ_M P_Zk = algebraMap k k_M (g_k : k)) :
    let p := p F
    let N_k := Fintype.card k - 1
    let G_k := fun c : ℕ => ∑ x : kˣ, (((ω_k ^ c) x)⁻¹ : Ω F) * ψ_k (x : k)
    (∀ m : ℕ, G_k (p * m) = G_k m) ∧
    ∃ (P_step : ℕ → Polynomial ℤ),
      ∀ c : ℕ, 0 < c → c + 1 < N_k →
        G_k c * G_k 1 = Φ_Ω (P_step c) * G_k (c + 1) ∧
        Φ_M (P_step c) = -((c + 1 : ℕ) : k_M) :=
by
  intro p_val N_k G_k
  haveI : Fact p_val.Prime := ⟨hp⟩
  
  let φ : kˣ →* kˣ := Units.map (frobenius k p_val).toMonoidHom
  have hφ_val : ∀ x : kˣ, ((φ x : kˣ) : k) = (x : k) ^ p_val := fun x => rfl
  have hφ_pow : ∀ x : kˣ, φ x = x ^ p_val := by
    intro x; ext; exact hφ_val x
  have hφ_inj : Function.Injective φ :=
    Units.map_injective (RingHom.injective (frobenius k p_val))
  have hφ_bij : Function.Bijective φ :=
    (Fintype.bijective_iff_injective_and_card φ).mpr ⟨hφ_inj, rfl⟩
  have hG_frob : ∀ m : ℕ, G_k (p_val * m) = G_k m := by
    intro m
    dsimp only [G_k]
    refine Fintype.sum_bijective φ hφ_bij _ _ fun x => ?_
    rw [hφ_val x, hψ_frob (x : k), hφ_pow x]
    simp only [MonoidHom.pow_apply, map_pow, ← pow_mul, mul_comm p_val m]
  
  have hchar_zero : ∀ j : ℕ, 0 < j → j < N_k → ∑ x : kˣ, (((ω_k ^ j) x)⁻¹ : Ω F) = 0 := by
    intro j hj_pos hj_lt
    set S := ∑ x : kˣ, (((ω_k ^ j) x)⁻¹ : Ω F)
    have hS_eq : (((ω_k ^ j) g_k)⁻¹ : Ω F) * S = S := by
      rw [Finset.mul_sum]
      refine Fintype.sum_equiv (Equiv.mulLeft g_k) _ _ fun x => ?_
      change (((ω_k ^ j) g_k)⁻¹ : Ω F) * (((ω_k ^ j) x)⁻¹ : Ω F) =
        (((ω_k ^ j) (g_k * x))⁻¹ : Ω F)
      rw [map_mul, Units.val_mul, mul_inv]
    have h_sub : ((((ω_k ^ j) g_k)⁻¹ : Ω F) - 1) * S = 0 := by
      rw [sub_mul, one_mul, hS_eq, sub_self]
    have h_pow_ne1 : (ω_k g_k) ^ j ≠ 1 :=
      pow_ne_one_of_lt_orderOf hj_pos.ne' (by rw [hω_k_ord]; exact hj_lt)
    have h_sub_ne0 : (((ω_k ^ j) g_k)⁻¹ : Ω F) - 1 ≠ 0 := by
      intro h_eq
      apply h_pow_ne1
      have h_val1 : (((ω_k ^ j) g_k : (Ω F)ˣ) : Ω F)⁻¹ = 1 := sub_eq_zero.mp h_eq
      have h_val2 : (((ω_k ^ j) g_k : (Ω F)ˣ) : Ω F) = 1 := inv_eq_one.mp h_val1
      rw [← MonoidHom.pow_apply]
      ext
      exact h_val2
    exact (mul_eq_zero.mp h_sub).resolve_left h_sub_ne0
  have hpow_zero : ∀ j : ℕ, 0 < j → j < N_k → ∑ x : kˣ, (x : k) ^ j = 0 := by
    intro j hj_pos hj_lt
    set S' := ∑ x : kˣ, (x : k) ^ j
    have hS'_eq : (g_k : k) ^ j * S' = S' := by
      rw [Finset.mul_sum]
      refine Fintype.sum_equiv (Equiv.mulLeft g_k) _ _ fun x => ?_
      change (g_k : k) ^ j * (x : k) ^ j = ((g_k * x : kˣ) : k) ^ j
      rw [Units.val_mul, mul_pow]
    have h_sub : ((g_k : k) ^ j - 1) * S' = 0 := by
      rw [sub_mul, one_mul, hS'_eq, sub_self]
    have h_pow_ne1 : g_k ^ j ≠ 1 :=
      pow_ne_one_of_lt_orderOf hj_pos.ne' (by rw [hg_k_ord]; exact hj_lt)
    have h_sub_ne0 : (g_k : k) ^ j - 1 ≠ 0 := by
      intro h_eq
      apply h_pow_ne1
      ext
      rw [Units.val_pow_eq_pow_val, Units.val_one]
      exact sub_eq_zero.mp h_eq
    exact (mul_eq_zero.mp h_sub).resolve_left h_sub_ne0
  have hω_dlog : ∀ (c m : ℕ) (x : kˣ), c ≤ N_k → g_k ^ m = x →
      ((ω_k g_k : Ω F)) ^ ((N_k - c) * m) = (((ω_k ^ c) x)⁻¹ : Ω F) := by
    intro c m x hc_le hgm
    have hω_N : (ω_k g_k) ^ N_k = 1 := by
      rw [show N_k = orderOf (ω_k g_k) from hω_k_ord.symm]
      exact pow_orderOf_eq_one (ω_k g_k)
    have hx_eq : (ω_k g_k) ^ m = ω_k x := by rw [← map_pow, hgm]
    have hx_N : (ω_k x) ^ N_k = 1 := by
      rw [← hx_eq, ← pow_mul, mul_comm, pow_mul, hω_N, one_pow]
    have h_mul : (ω_k x) ^ (N_k - c) * (ω_k x) ^ c = 1 := by
      rw [← pow_add, Nat.sub_add_cancel hc_le, hx_N]
    have h_inv : (ω_k x) ^ (N_k - c) = ((ω_k ^ c) x)⁻¹ := by
      rw [MonoidHom.pow_apply]
      exact mul_eq_one_iff_eq_inv.mp h_mul
    rw [pow_mul', ← Units.val_pow_eq_pow_val, hx_eq, ← Units.val_pow_eq_pow_val, h_inv,
      Units.val_inv_eq_inv_val]
  
  have h_double_sum : ∀ c : ℕ, 0 < c → c + 1 < N_k →
      G_k c * G_k 1 =
        (∑ u : kˣ,
          if h : (1 - (u : k)) ≠ 0 then
            (((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (Units.mk0 (1 - (u : k)) h))⁻¹ : Ω F)
          else 0) * G_k (c + 1) := by
    intro c hc_pos hc_lt
    let f : kˣ → kˣ → Ω F := fun x₁ x₂ =>
      (((ω_k ^ c) x₁)⁻¹ : Ω F) * ((ω_k x₂)⁻¹ : Ω F) * ψ_k ((x₁ : k) + (x₂ : k))
    have hLHS_expand : G_k c * G_k 1 = ∑ x₁ : kˣ, ∑ x₂ : kˣ, f x₁ x₂ := by
      dsimp only [G_k, f]
      rw [Finset.sum_mul_sum]
      apply Finset.sum_congr rfl
      intro x₁ _
      apply Finset.sum_congr rfl
      intro x₂ _
      rw [MonoidHom.pow_apply ω_k 1, pow_one, AddChar.map_add_eq_mul]
      ring
    have hLHS_split : ∑ x₁ : kˣ, ∑ x₂ : kˣ, f x₁ x₂ =
        (∑ x₁ : kˣ, f x₁ (-x₁)) +
        ∑ x₁ : kˣ, ∑ x₂ ∈ (Finset.univ : Finset kˣ).erase (-x₁), f x₁ x₂ := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro x₁ _
      exact (Finset.add_sum_erase Finset.univ (fun x₂ => f x₁ x₂) (Finset.mem_univ (-x₁))).symm
    have h_diag_zero : ∑ x₁ : kˣ, f x₁ (-x₁) = 0 := by
      have h_term : ∀ x₁ : kˣ, f x₁ (-x₁) =
          ((ω_k (-1))⁻¹ : Ω F) * (((ω_k ^ (c + 1)) x₁)⁻¹ : Ω F) := by
        intro x₁
        dsimp only [f]
        have h_add : (x₁ : k) + ((-x₁ : kˣ) : k) = 0 := by
          rw [Units.val_neg, add_neg_cancel]
        have h_neg : (-x₁ : kˣ) = (-1 : kˣ) * x₁ := neg_eq_neg_one_mul x₁
        rw [h_add, AddChar.map_zero_eq_one, mul_one, h_neg, map_mul,
          MonoidHom.pow_apply, MonoidHom.pow_apply, pow_succ]
        simp only [Units.val_mul, mul_inv]
        ring
      calc ∑ x₁ : kˣ, f x₁ (-x₁)
        _ = ∑ x₁ : kˣ, ((ω_k (-1))⁻¹ : Ω F) * (((ω_k ^ (c + 1)) x₁)⁻¹ : Ω F) :=
            Finset.sum_congr rfl fun x₁ _ => h_term x₁
        _ = ((ω_k (-1))⁻¹ : Ω F) * ∑ x₁ : kˣ, (((ω_k ^ (c + 1)) x₁)⁻¹ : Ω F) :=
            (Finset.mul_sum _ _ _).symm
        _ = ((ω_k (-1))⁻¹ : Ω F) * 0 := by rw [hchar_zero (c + 1) (by omega) hc_lt]
        _ = 0 := mul_zero _
    let S₀₁ : Finset kˣ := (Finset.univ : Finset kˣ).erase 1
    let v_mk : kˣ → kˣ := fun u =>
      if h : (1 - (u : k)) ≠ 0 then Units.mk0 (1 - (u : k)) h else 1
    have hu_sub : ∀ u ∈ S₀₁, (1 - (u : k)) ≠ 0 := by
      intro u hu h_eq
      apply Finset.ne_of_mem_erase hu
      ext
      rw [Units.val_one]
      exact (sub_eq_zero.mp h_eq).symm
    have hv_mk_val : ∀ u ∈ S₀₁, ((v_mk u : kˣ) : k) = 1 - (u : k) := by
      intro u hu
      dsimp only [v_mk]
      rw [dif_pos (hu_sub u hu), Units.val_mk0]
    have h_map_val : ∀ u ∈ S₀₁, ∀ x₁ : kˣ,
        ((v_mk u * (u⁻¹ * x₁) : kˣ) : k) = ((u⁻¹ * x₁ : kˣ) : k) - (x₁ : k) := by
      intro u hu x₁
      have h_ut : (u : k) * ((u⁻¹ * x₁ : kˣ) : k) = (x₁ : k) := by
        rw [← Units.val_mul, mul_inv_cancel_left]
      rw [Units.val_mul, hv_mk_val u hu, sub_mul, one_mul, h_ut]
    have h_u_erase :
        (∑ u : kˣ,
          if h : (1 - (u : k)) ≠ 0 then
            (((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (Units.mk0 (1 - (u : k)) h))⁻¹ : Ω F)
          else 0) =
        ∑ u ∈ S₀₁,
          (((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (v_mk u))⁻¹ : Ω F) := by
      rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ (1 : kˣ))]
      have h1 : ¬ ((1 - ((1 : kˣ) : k)) ≠ 0) := by simp
      rw [dif_neg h1, zero_add]
      apply Finset.sum_congr rfl
      intro u hu
      dsimp only [v_mk]
      rw [dif_pos (hu_sub u hu), dif_pos (hu_sub u hu)]
    have hRHS_expand :
        (∑ u ∈ S₀₁,
          (((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (v_mk u))⁻¹ : Ω F)) * G_k (c + 1) =
        ∑ x₁ : kˣ, ∑ u ∈ S₀₁,
          f x₁ (v_mk u * (u⁻¹ * x₁)) := by
      rw [Finset.sum_mul]
      have h_inner : ∀ u ∈ S₀₁,
          ((((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (v_mk u))⁻¹ : Ω F)) * G_k (c + 1) =
          ∑ x₁ : kˣ, f x₁ (v_mk u * (u⁻¹ * x₁)) := by
        intro u hu
        dsimp only [G_k]
        rw [Finset.mul_sum]
        refine (Fintype.sum_equiv (Equiv.mulLeft u⁻¹) _ _ fun x₁ => ?_).symm
        change f x₁ (v_mk u * (u⁻¹ * x₁)) =
          ((((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (v_mk u))⁻¹ : Ω F)) *
            ((((ω_k ^ (c + 1)) (u⁻¹ * x₁))⁻¹ : Ω F) * ψ_k ((u⁻¹ * x₁ : kˣ) : k))
        set t : kˣ := u⁻¹ * x₁
        have hut : u * t = x₁ := mul_inv_cancel_left u x₁
        have h_char :
            ((((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (v_mk u))⁻¹ : Ω F)) *
              ((((ω_k ^ (c + 1)) t)⁻¹ : Ω F) * ψ_k (t : k)) =
            (((ω_k ^ c) x₁)⁻¹ : Ω F) * ((ω_k (v_mk u * t))⁻¹ : Ω F) * ψ_k (t : k) := by
          have hc_mul : (ω_k ^ c) u * (ω_k ^ c) t = (ω_k ^ c) x₁ := by
            rw [← map_mul, hut]
          have hv_mul : ω_k (v_mk u) * ω_k t = ω_k (v_mk u * t) := (map_mul ω_k (v_mk u) t).symm
          have h_c1 : (ω_k ^ (c + 1)) t = (ω_k ^ c) t * ω_k t := by
            simp only [MonoidHom.pow_apply, pow_succ]
          rw [h_c1, ← hc_mul, ← hv_mul]
          simp only [Units.val_mul, mul_inv]
          ring
        have h_add : (x₁ : k) + ((v_mk u * t : kˣ) : k) = (t : k) := by
          rw [h_map_val u hu x₁, add_sub_cancel]
        dsimp only [f]
        rw [h_add, h_char]
      rw [Finset.sum_congr rfl h_inner, Finset.sum_comm]
    have h_bij : ∀ x₁ : kˣ,
        ∑ u ∈ S₀₁, f x₁ (v_mk u * (u⁻¹ * x₁)) =
        ∑ x₂ ∈ (Finset.univ : Finset kˣ).erase (-x₁), f x₁ x₂ := by
      intro x₁
      refine Finset.sum_bij
        (fun u _ => v_mk u * (u⁻¹ * x₁))
        (fun u hu => ?_)
        (fun u₁ hu₁ u₂ hu₂ h_eq => ?_)
        (fun x₂ hx₂ => ?_)
        (fun u _ => rfl)
      · 
        rw [Finset.mem_erase]
        refine ⟨?_, Finset.mem_univ _⟩
        intro h_neg
        have h_val : ((v_mk u * (u⁻¹ * x₁) : kˣ) : k) = ((-x₁ : kˣ) : k) :=
          congrArg Units.val h_neg
        rw [h_map_val u hu x₁, Units.val_neg] at h_val
        have ht_zero : ((u⁻¹ * x₁ : kˣ) : k) = 0 := by linear_combination h_val
        exact Units.ne_zero (u⁻¹ * x₁) ht_zero
      · 
        have h_val : ((v_mk u₁ * (u₁⁻¹ * x₁) : kˣ) : k) =
            ((v_mk u₂ * (u₂⁻¹ * x₁) : kˣ) : k) := congrArg Units.val h_eq
        rw [h_map_val u₁ hu₁ x₁, h_map_val u₂ hu₂ x₁] at h_val
        have ht_eq : ((u₁⁻¹ * x₁ : kˣ) : k) = ((u₂⁻¹ * x₁ : kˣ) : k) :=
          sub_left_inj.mp h_val
        have ht_u : u₁⁻¹ * x₁ = u₂⁻¹ * x₁ := Units.ext ht_eq
        exact inv_injective (mul_right_cancel ht_u)
      · 
        have hx₂_ne : x₂ ≠ -x₁ := Finset.ne_of_mem_erase hx₂
        have h_sum_ne0 : (x₁ : k) + (x₂ : k) ≠ 0 := by
          intro h0
          apply hx₂_ne
          ext
          rw [Units.val_neg]
          exact eq_neg_of_add_eq_zero_right h0
        let t : kˣ := Units.mk0 ((x₁ : k) + (x₂ : k)) h_sum_ne0
        let u : kˣ := x₁ * t⁻¹
        have hu_mem : u ∈ S₀₁ := by
          rw [Finset.mem_erase]
          refine ⟨?_, Finset.mem_univ _⟩
          intro hu1
          have hxt : x₁ = t := mul_inv_eq_one.mp hu1
          have h_val : (x₁ : k) = (x₁ : k) + (x₂ : k) := congrArg Units.val hxt
          have hx₂_zero : (x₂ : k) = 0 := by linear_combination -h_val
          exact Units.ne_zero x₂ hx₂_zero
        refine ⟨u, hu_mem, ?_⟩
        have hut : u⁻¹ * x₁ = t := by
          dsimp only [u]
          rw [mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one]
        ext
        change ((v_mk u * (u⁻¹ * x₁) : kˣ) : k) = (x₂ : k)
        rw [h_map_val u hu_mem x₁, hut]
        change ((x₁ : k) + (x₂ : k)) - (x₁ : k) = (x₂ : k)
        ring
    rw [hLHS_expand, hLHS_split, h_diag_zero, zero_add, h_u_erase, hRHS_expand]
    exact (Finset.sum_congr rfl fun x₁ _ => h_bij x₁).symm
  
  have h_geom_eval : ∀ c : ℕ, 0 < c → c + 1 < N_k →
      ∑ u : kˣ, (u : k) ^ (N_k - c) * (1 - (u : k)) ^ (N_k - 1) = -((c + 1 : ℕ) : k) := by
    intro c hc_pos hc_lt
    set m := N_k - c
    have hm_ge2 : 2 ≤ m := by omega
    have hm_lt : m < N_k := by omega
    let S₀₁ : Finset kˣ := (Finset.univ : Finset kˣ).erase 1
    have hu_sub : ∀ u ∈ S₀₁, (1 - (u : k)) ≠ 0 := by
      intro u hu h_eq
      apply Finset.ne_of_mem_erase hu
      ext
      rw [Units.val_one]
      exact (sub_eq_zero.mp h_eq).symm
    have h_split1 :
        ∑ u : kˣ, (u : k) ^ m * (1 - (u : k)) ^ (N_k - 1) =
        ∑ u ∈ S₀₁, (u : k) ^ m * (1 - (u : k)) ^ (N_k - 1) := by
      rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ (1 : kˣ))]
      have h0 : (1 - ((1 : kˣ) : k)) ^ (N_k - 1) = 0 := by
        rw [Units.val_one, sub_self, zero_pow (by omega)]
      rw [h0, mul_zero, zero_add]
    have h_ptwise : ∀ u ∈ S₀₁,
        (u : k) ^ m * (1 - (u : k)) ^ (N_k - 1) =
        (1 - (u : k)) ^ (N_k - 1) - ∑ j ∈ Finset.range m, (u : k) ^ j := by
      intro u hu
      have h_fermat : (1 - (u : k)) ^ N_k = 1 :=
        FiniteField.pow_card_sub_one_eq_one (1 - (u : k)) (hu_sub u hu)
      have h_pow_mul : (1 - (u : k)) ^ (N_k - 1) * (1 - (u : k)) = 1 := by
        rw [← pow_succ, show N_k - 1 + 1 = N_k by omega, h_fermat]
      have h_geom := mul_neg_geom_sum (u : k) m
      have h_mul := congrArg ((1 - (u : k)) ^ (N_k - 1) * ·) h_geom
      dsimp only at h_mul
      rw [← mul_assoc, h_pow_mul, one_mul, mul_sub, mul_one] at h_mul
      linear_combination h_mul
    have h_sum_diff :
        ∑ u ∈ S₀₁, (u : k) ^ m * (1 - (u : k)) ^ (N_k - 1) =
        (∑ u ∈ S₀₁, (1 - (u : k)) ^ (N_k - 1)) -
        ∑ u ∈ S₀₁, ∑ j ∈ Finset.range m, (u : k) ^ j := by
      rw [Finset.sum_congr rfl h_ptwise, Finset.sum_sub_distrib]
    have h_sum1 : ∑ u ∈ S₀₁, (1 - (u : k)) ^ (N_k - 1) = -1 := by
      have h_inv : ∑ u ∈ S₀₁, (1 - (u : k)) ^ (N_k - 1) =
          ∑ v ∈ S₀₁, (v : k) ^ (N_k - 1) := by
        refine Finset.sum_bij
          (fun u hu => Units.mk0 (1 - (u : k)) (hu_sub u hu))
          (fun u hu => ?_)
          (fun u₁ hu₁ u₂ hu₂ h_eq => ?_)
          (fun v hv => ?_)
          (fun u hu => rfl)
        · rw [Finset.mem_erase]
          refine ⟨?_, Finset.mem_univ _⟩
          intro h1
          have h_val : (1 - (u : k)) = 1 := congrArg Units.val h1
          have hu0 : (u : k) = 0 := by linear_combination -h_val
          exact Units.ne_zero u hu0
        · have h_val : 1 - (u₁ : k) = 1 - (u₂ : k) := congrArg Units.val h_eq
          ext
          linear_combination -h_val
        · refine ⟨Units.mk0 (1 - (v : k)) (hu_sub v hv), ?_, ?_⟩
          · rw [Finset.mem_erase]
            refine ⟨?_, Finset.mem_univ _⟩
            intro h1
            have h_val : (1 - (v : k)) = 1 := congrArg Units.val h1
            have hv0 : (v : k) = 0 := by linear_combination -h_val
            exact Units.ne_zero v hv0
          · ext
            change 1 - (1 - (v : k)) = (v : k)
            ring
      rw [h_inv, Finset.sum_erase_eq_sub (Finset.mem_univ (1 : kˣ)),
        hpow_zero (N_k - 1) (by omega) (by omega), Units.val_one, one_pow, zero_sub]
    have h_sum2 : ∑ u ∈ S₀₁, ∑ j ∈ Finset.range m, (u : k) ^ j = (c : k) := by
      rw [Finset.sum_comm]
      have h_inner : ∀ j ∈ Finset.range m,
          ∑ u ∈ S₀₁, (u : k) ^ j = (∑ u : kˣ, (u : k) ^ j) - 1 := by
        intro j _
        rw [Finset.sum_erase_eq_sub (Finset.mem_univ (1 : kˣ)), Units.val_one, one_pow]
      rw [Finset.sum_congr rfl h_inner, Finset.sum_sub_distrib, Finset.sum_const,
        Finset.card_range, nsmul_eq_mul, mul_one]
      rw [← Finset.add_sum_erase (Finset.range m) _ (Finset.mem_range.mpr (by omega : 0 < m))]
      have h_j0 : ∑ u : kˣ, (u : k) ^ 0 = (N_k : k) := by
        simp only [pow_zero, Finset.sum_const, Finset.card_univ, Fintype.card_units,
          nsmul_eq_mul, mul_one]
        rfl
      have h_jpos : ∑ j ∈ (Finset.range m).erase 0, ∑ u : kˣ, (u : k) ^ j = 0 := by
        apply Finset.sum_eq_zero
        intro j hj
        have hj_ne0 : j ≠ 0 := Finset.ne_of_mem_erase hj
        have hj_lt_m : j < m := Finset.mem_range.mp (Finset.mem_of_mem_erase hj)
        exact hpow_zero j (by omega) (by omega)
      have h_mc : (N_k : k) - (m : k) = (c : k) := by
        have h_add : m + c = N_k := Nat.sub_add_cancel (by omega)
        have h_cast : (m : k) + (c : k) = (N_k : k) := by
          rw [← Nat.cast_add, h_add]
        linear_combination -h_cast
      rw [h_j0, h_jpos, add_zero, h_mc]
    rw [h_split1, h_sum_diff, h_sum1, h_sum2, Nat.cast_add, Nat.cast_one]
    ring
  
  let dlog : kˣ → ℕ := fun x => (hg_k_surj x).choose
  have hdlog : ∀ x : kˣ, g_k ^ (dlog x) = x := fun x => (hg_k_surj x).choose_spec.2
  have hk_dlog : ∀ (a : ℕ) (x : kˣ),
      (algebraMap k k_M (g_k : k)) ^ (a * dlog x) = algebraMap k k_M ((x : k) ^ a) := by
    intro a x
    rw [pow_mul', ← map_pow, ← Units.val_pow_eq_pow_val, hdlog x, map_pow]
  refine ⟨hG_frob, ⟨fun c =>
    ∑ u : kˣ,
      if h : (1 - (u : k)) ≠ 0 then
        P_Zk ^ ((N_k - c) * dlog u + (N_k - 1) * dlog (Units.mk0 (1 - (u : k)) h))
      else 0, ?_⟩⟩
  intro c hc_pos hc_lt
  have hc_le : c ≤ N_k := by omega
  have h1_le : 1 ≤ N_k := by omega
  refine ⟨?_, ?_⟩
  · have hΦ_Ω_eval : Φ_Ω (∑ u : kˣ,
        if h : (1 - (u : k)) ≠ 0 then
          P_Zk ^ ((N_k - c) * dlog u + (N_k - 1) * dlog (Units.mk0 (1 - (u : k)) h))
        else 0) =
      ∑ u : kˣ,
        if h : (1 - (u : k)) ≠ 0 then
          (((ω_k ^ c) u)⁻¹ : Ω F) * ((ω_k (Units.mk0 (1 - (u : k)) h))⁻¹ : Ω F)
        else 0 := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro u _
      split_ifs with h
      · rw [map_pow, pow_add, hΦ_Ω_Zk, hω_dlog c (dlog u) u hc_le (hdlog u),
          hω_dlog 1 (dlog (Units.mk0 (1 - (u : k)) h)) (Units.mk0 (1 - (u : k)) h)
            h1_le (hdlog (Units.mk0 (1 - (u : k)) h)),
          pow_one ω_k]
      · exact map_zero Φ_Ω
    rw [hΦ_Ω_eval]
    exact h_double_sum c hc_pos hc_lt
  · have hΦ_M_eval : Φ_M (∑ u : kˣ,
        if h : (1 - (u : k)) ≠ 0 then
          P_Zk ^ ((N_k - c) * dlog u + (N_k - 1) * dlog (Units.mk0 (1 - (u : k)) h))
        else 0) =
      algebraMap k k_M (∑ u : kˣ, (u : k) ^ (N_k - c) * (1 - (u : k)) ^ (N_k - 1)) := by
      rw [map_sum, map_sum]
      apply Finset.sum_congr rfl
      intro u _
      split_ifs with h
      · rw [map_pow, pow_add, hΦ_M_Zk, hk_dlog (N_k - c) u,
          hk_dlog (N_k - 1) (Units.mk0 (1 - (u : k)) h), ← map_mul]
        rfl
      · push_neg at h
        have h0 : (1 - (u : k)) ^ (N_k - 1) = 0 := by
          rw [h, zero_pow (by omega)]
        rw [h0, mul_zero, map_zero, map_zero]
    rw [hΦ_M_eval, h_geom_eval c hc_pos hc_lt, map_neg, map_natCast]

theorem ld_ch12_gauss_jacobi_base_p_recursion (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_M : Type u) [Field k_M] [CharP k_M (p F)]
    (hp : Nat.Prime (p F))
    (M_0 : ℕ)
    (ϖ : Ω F)
    (Φ_Ω : Polynomial ℤ →+* Ω F) (Φ_M : Polynomial ℤ →+* k_M)
    (G : ℕ → Ω F)
    (P_1 : Polynomial ℤ)
    (P_step : ℕ → Polynomial ℤ)
    (hG_1 : G 1 = Φ_Ω P_1 * ϖ)
    (hG_mul_p : ∀ m : ℕ, G ((p F) * m) = G m)
    (hG_step : ∀ c : ℕ, 0 < c → c + 1 < M_0 →
      G c * G 1 = Φ_Ω (P_step c) * G (c + 1) ∧
      Φ_M (P_step c) = -((c + 1 : ℕ) : k_M)) :
    let p := p F
    ∃ (P_J : ℕ → Polynomial ℤ),
      ∀ c : ℕ, 0 < c → c < M_0 →
        let s_c := (p.digits c).sum
        Φ_Ω (P_J c) * G c = (Φ_Ω P_1 * ϖ) ^ s_c ∧
        Φ_M (P_J c) =
          (-1 : k_M) ^ (s_c - 1) * (((p.digits c).map Nat.factorial).prod : k_M) ∧
        Φ_M (P_J c) ≠ 0 :=
by
  dsimp only
  set p := p F
  have hp_gt1 : 1 < p := hp.one_lt
  have hp_pos : 0 < p := hp.pos
  have h_rec : ∀ c : ℕ, ∃ P : Polynomial ℤ,
      0 < c → c < M_0 →
        let s_c := (p.digits c).sum
        1 ≤ s_c ∧
        Φ_Ω P * G c = (Φ_Ω P_1 * ϖ) ^ s_c ∧
        Φ_M P =
          (-1 : k_M) ^ (s_c - 1) * (((p.digits c).map Nat.factorial).prod : k_M) ∧
        Φ_M P ≠ 0 := by
    intro c
    induction' c using Nat.strong_induction_on with c ih
    by_cases hc_valid : 0 < c ∧ c < M_0
    · rcases hc_valid with ⟨hc_pos, hc_lt⟩
      by_cases hc1 : c = 1
      · refine ⟨1, fun _ _ => ?_⟩
        subst hc1
        have hdig1 : p.digits 1 = [1] := Nat.digits_of_lt p 1 one_ne_zero hp_gt1
        dsimp only
        rw [hdig1]
        simp [hG_1]
      · by_cases hmod0 : c % p = 0
        · set m := c / p
          have h_pm : p * m = c := by
            have hd := Nat.div_add_mod c p
            rw [hmod0, add_zero] at hd
            exact hd
          have hm_pos : 0 < m := by
            by_contra hm0
            have hm_eq0 : m = 0 := Nat.eq_zero_of_not_pos hm0
            rw [hm_eq0, mul_zero] at h_pm
            omega
          have hm_lt : m < c := Nat.div_lt_self hc_pos hp_gt1
          have hm_lt_M0 : m < M_0 := lt_trans hm_lt hc_lt
          obtain ⟨P_m, hP_m⟩ := ih m hm_lt
          obtain ⟨hs_m, hΩ_m, hM_m, hne_m⟩ := hP_m hm_pos hm_lt_M0
          refine ⟨P_m, fun _ _ => ?_⟩
          have hdig_c : p.digits c = 0 :: p.digits m := by
            rw [Nat.digits_def' hp_gt1 hc_pos, hmod0]
          have hG_c : G c = G m := by
            rw [← h_pm]
            exact hG_mul_p m
          dsimp only at hs_m hΩ_m hM_m ⊢
          rw [hdig_c, List.sum_cons, zero_add, List.map_cons, List.prod_cons,
            Nat.factorial_zero, one_mul, hG_c]
          exact ⟨hs_m, hΩ_m, hM_m, hne_m⟩
        · set b := c - 1
          set r := c % p
          set m := c / p
          have hb_pos : 0 < b := by omega
          have hb_lt : b < c := by omega
          have hb_succ : b + 1 = c := by omega
          have hb_lt_M0 : b < M_0 := lt_trans hb_lt hc_lt
          have hr_pos : 0 < r := Nat.pos_of_ne_zero hmod0
          have hr_lt : r < p := Nat.mod_lt c hp_pos
          have hr1_lt : r - 1 < p := by omega
          have hc_div : p * m + r = c := Nat.div_add_mod c p
          have hb_eq : b = (r - 1) + p * m := by omega
          have hb_mod : b % p = r - 1 := by
            rw [hb_eq, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hr1_lt]
          have hb_div : b / p = m := by
            rw [hb_eq, Nat.add_mul_div_left _ _ hp_pos, Nat.div_eq_of_lt hr1_lt, zero_add]
          have hdig_c : p.digits c = r :: p.digits m := Nat.digits_def' hp_gt1 hc_pos
          have hdig_b : p.digits b = (r - 1) :: p.digits m := by
            rw [Nat.digits_def' hp_gt1 hb_pos, hb_mod, hb_div]
          obtain ⟨P_b, hP_b⟩ := ih b hb_lt
          obtain ⟨hs_b, hΩ_b, hM_b, hne_b⟩ := hP_b hb_pos hb_lt_M0
          obtain ⟨hstep_Ω, hstep_M⟩ := hG_step b hb_pos (by rw [hb_succ]; exact hc_lt)
          rw [hb_succ] at hstep_Ω hstep_M
          refine ⟨P_b * P_step b, fun _ _ => ?_⟩
          dsimp only at hs_b hΩ_b hM_b ⊢
          set s_b := (p.digits b).sum
          set s_c := (p.digits c).sum
          have hs_c_eq : s_c = s_b + 1 := by
            dsimp only [s_c, s_b]
            rw [hdig_c, hdig_b, List.sum_cons, List.sum_cons]
            omega
          have hs_c_pos : 1 ≤ s_c := by omega
          have hs_c_sub1 : s_c - 1 = (s_b - 1) + 1 := by omega
          have hr_fact : r.factorial = r * (r - 1).factorial := by
            conv_lhs => rw [show r = (r - 1) + 1 by omega]
            rw [Nat.factorial_succ]
            congr 1
            omega
          have hprod_c_eq :
              ((p.digits c).map Nat.factorial).prod =
                r * ((p.digits b).map Nat.factorial).prod := by
            rw [hdig_c, hdig_b, List.map_cons, List.prod_cons,
              List.map_cons, List.prod_cons, hr_fact, mul_assoc]
          have hc_cast : (c : k_M) = (r : k_M) := by
            calc (c : k_M) = ((p * m + r : ℕ) : k_M) := by rw [hc_div]
              _ = (p : k_M) * (m : k_M) + (r : k_M) := by push_cast; ring
              _ = 0 * (m : k_M) + (r : k_M) := by rw [CharP.cast_eq_zero k_M p]
              _ = (r : k_M) := by ring
          have hstep_M_r : Φ_M (P_step b) = -(r : k_M) := by
            rw [hstep_M, hc_cast]
          have hr_not_dvd : ¬ (p ∣ r) := Nat.not_dvd_of_pos_of_lt hr_pos hr_lt
          have hr_ne0 : (r : k_M) ≠ 0 := by
            intro hr0
            exact hr_not_dvd ((CharP.cast_eq_zero_iff k_M p r).mp hr0)
          have hstep_ne0 : Φ_M (P_step b) ≠ 0 := by
            rw [hstep_M_r]
            exact neg_ne_zero.mpr hr_ne0
          refine ⟨hs_c_pos, ?_, ?_, ?_⟩
          · calc Φ_Ω (P_b * P_step b) * G c
              _ = Φ_Ω P_b * (Φ_Ω (P_step b) * G c) := by rw [map_mul, mul_assoc]
              _ = Φ_Ω P_b * (G b * G 1) := by rw [← hstep_Ω]
              _ = (Φ_Ω P_b * G b) * G 1 := by ring
              _ = (Φ_Ω P_1 * ϖ) ^ s_b * (Φ_Ω P_1 * ϖ) := by rw [hΩ_b, hG_1]
              _ = (Φ_Ω P_1 * ϖ) ^ (s_b + 1) := (pow_succ _ _).symm
              _ = (Φ_Ω P_1 * ϖ) ^ s_c := by rw [hs_c_eq]
          · calc Φ_M (P_b * P_step b)
              _ = Φ_M P_b * Φ_M (P_step b) := map_mul Φ_M P_b (P_step b)
              _ = ((-1 : k_M) ^ (s_b - 1) * (((p.digits b).map Nat.factorial).prod : k_M)) *
                    (-(r : k_M)) := by rw [hM_b, hstep_M_r]
              _ = ((-1 : k_M) ^ (s_b - 1) * (-1 : k_M)) *
                    ((r : k_M) * (((p.digits b).map Nat.factorial).prod : k_M)) := by ring
              _ = (-1 : k_M) ^ (s_c - 1) * (((p.digits c).map Nat.factorial).prod : k_M) := by
                  rw [← pow_succ, ← hs_c_sub1, ← Nat.cast_mul, ← hprod_c_eq]
          · rw [map_mul]
            exact mul_ne_zero hne_b hstep_ne0
    · refine ⟨1, fun hc_pos hc_lt => False.elim (hc_valid ⟨hc_pos, hc_lt⟩)⟩
  obtain ⟨P_J, hP_J⟩ := Classical.axiomOfChoice h_rec
  refine ⟨P_J, fun c hc_pos hc_lt => ?_⟩
  obtain ⟨_, h1, h2, h3⟩ := hP_J c hc_pos hc_lt
  exact ⟨h1, h2, h3⟩

theorem ld_ch12_tame_cyclotomic_gauss_jacobi_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] [CharP k_L (p F)] [CharP k_M (p F)]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ)
    (hfinrank : Module.finrank k_L k_M = ℓ)
    (hNeChar : (ℓ : k_L) ≠ 0)
    (ν_k : k_Lˣ →* (Ω F)ˣ)
    (hν_pow : ν_k ^ ℓ = 1)
    (hν_ne : ν_k ≠ 1) :
    let p := p F
    let q := Fintype.card k_L
    let Q := Fintype.card k_M
    ∃ (f : ℕ) (g_M : k_Mˣ) (ω_M : k_Mˣ →* (Ω F)ˣ)
      (ψ_0L : AddChar k_L (Ω F)) (ϖ : Ω F)
      (Φ_Ω : Polynomial ℤ →+* Ω F) (Φ_M : Polynomial ℤ →+* k_M)
      (P_Z P_1L P_1M : Polynomial ℤ)
      (P_JL P_JM : ℕ → Polynomial ℤ),
      0 < f ∧
      q = p ^ f ∧
      Q = q ^ ℓ ∧
      ℓ ∣ (q - 1) ∧
      (∀ y : k_Mˣ, ∃ m < Q - 1, g_M ^ m = y) ∧
      orderOf g_M = Q - 1 ∧
      orderOf (ω_M g_M) = Q - 1 ∧
      ψ_0L ≠ 1 ∧
      ϖ ≠ 0 ∧
      Φ_Ω P_Z = (ω_M g_M : Ω F) ∧
      Φ_M P_Z = (g_M : k_M) ∧
      (∀ P₁ P₂ : Polynomial ℤ, Φ_Ω P₁ = Φ_Ω P₂ → Φ_M P₁ = Φ_M P₂) ∧
      Φ_M P_1L = -1 ∧
      Φ_M P_1M = -1 ∧
      (∀ a : ℕ, 0 < a → a < q - 1 →
        let ω_L := ω_M.comp (Units.map (algebraMap k_L k_M).toMonoidHom)
        let s_a := (p.digits a).sum
        Φ_Ω (P_JL a) *
          (∑ x : k_Lˣ, (((ω_L ^ a) x)⁻¹ : Ω F) * ψ_0L (x : k_L)) =
          (Φ_Ω P_1L * ϖ) ^ s_a ∧
        Φ_M (P_JL a) =
          (-1 : k_M) ^ (s_a - 1) * (((p.digits a).map Nat.factorial).prod : k_M) ∧
        Φ_M (P_JL a) ≠ 0) ∧
      (∀ b : ℕ, 0 < b → b < Q - 1 →
        let s_b := (p.digits b).sum
        Φ_Ω (P_JM b) *
          (∑ y : k_Mˣ, (((ω_M ^ b) y)⁻¹ : Ω F) *
            ψ_0L (Algebra.trace k_L k_M (y : k_M))) =
          (Φ_Ω P_1M * ϖ) ^ s_b ∧
        Φ_M (P_JM b) =
          (-1 : k_M) ^ (s_b - 1) * (((p.digits b).map Nat.factorial).prod : k_M) ∧
        Φ_M (P_JM b) ≠ 0) :=
by
  obtain ⟨hp, f, g_0, g_M, g_L, hf_pos, hq_eq, hQ_eq, hdvd_q1,
    hq1_ge2, hQ1_ge2, hS_mul, h_not_dvd, hg_0_prim, hg_M_eq,
    hg_M_surj, hg_M_ord, hg_L_surj, hg_L_ord, hg_L_map⟩ :=
    ld_ch12_finite_field_card_and_subfield_generator F k_L k_M ℓ hPrime hfinrank ν_k hν_pow hν_ne
  obtain ⟨ω_M, ϖ, Φ_Ω, Φ_M, P_Z, P_ϖ, hω_M_ord, hϖ_ne0, hζ_p,
    hΦ_Ω_Z, hΦ_M_Z, hΦ_Ω_ϖ, hΦ_M_ϖ, hTransfer⟩ :=
    ld_ch12_cyclotomic_poly_transfer_and_teichmuller F k_M hp hQ1_ge2 h_not_dvd
      g_0 g_M hg_0_prim hg_M_eq hg_M_ord hg_M_surj
  obtain ⟨ψ_0L, P_1L, P_1M, hψ_0L_ne1, hω_L_ord, hψ_0L_frob, hψ_0M_frob,
    hΦ_M_1L, hΦ_M_1M, hG_L_1, hG_M_1⟩ :=
    ld_ch12_trace_addChar_and_first_gauss_poly F k_L k_M hp hq1_ge2 hQ1_ge2
      g_L g_M hg_L_ord hg_L_surj hg_M_ord hg_M_surj ω_M hω_M_ord hg_L_map hS_mul
      ϖ hζ_p Φ_Ω Φ_M P_Z P_ϖ hΦ_Ω_Z hΦ_M_Z hΦ_Ω_ϖ hΦ_M_ϖ
  set S := (Fintype.card k_M - 1) / (Fintype.card k_L - 1)
  set ω_L := ω_M.comp (Units.map (algebraMap k_L k_M).toMonoidHom)
  have hΦ_Ω_ZL : Φ_Ω (P_Z ^ S) = (ω_L g_L : Ω F) := by
    rw [map_pow, hΦ_Ω_Z, ← Units.val_pow_eq_pow_val, ← map_pow, ← hg_L_map, MonoidHom.comp_apply]
  have hΦ_M_ZL : Φ_M (P_Z ^ S) = algebraMap k_L k_M (g_L : k_L) := by
    rw [map_pow, hΦ_M_Z, ← Units.val_pow_eq_pow_val, ← hg_L_map]
    rfl
  obtain ⟨hG_L_mul_p, P_step_L, hG_L_step⟩ :=
    ld_ch12_jacobi_one_step_polynomial F k_L k_M hp hq1_ge2 g_L hg_L_ord hg_L_surj
      ω_L hω_L_ord ψ_0L hψ_0L_frob Φ_Ω Φ_M (P_Z ^ S) hΦ_Ω_ZL hΦ_M_ZL
  obtain ⟨P_JL, hP_JL⟩ :=
    ld_ch12_gauss_jacobi_base_p_recursion F k_M hp (Fintype.card k_L - 1) ϖ Φ_Ω Φ_M
      (fun a => ∑ x : k_Lˣ, (((ω_L ^ a) x)⁻¹ : Ω F) * ψ_0L (x : k_L))
      P_1L P_step_L
      (by simpa only [MonoidHom.pow_apply, pow_one] using hG_L_1)
      hG_L_mul_p hG_L_step
  let ψ_0M : AddChar k_M (Ω F) := ψ_0L.compAddMonoidHom (Algebra.trace k_L k_M).toAddMonoidHom
  have hψ_0M_apply : ∀ y : k_M, ψ_0M y = ψ_0L (Algebra.trace k_L k_M y) :=
    fun y => AddChar.compAddMonoidHom_apply ψ_0L (Algebra.trace k_L k_M).toAddMonoidHom y
  obtain ⟨hG_M_mul_p, P_step_M, hG_M_step⟩ :=
    ld_ch12_jacobi_one_step_polynomial F k_M k_M hp hQ1_ge2 g_M hg_M_ord hg_M_surj
      ω_M hω_M_ord ψ_0M hψ_0M_frob Φ_Ω Φ_M P_Z hΦ_Ω_Z hΦ_M_Z
  obtain ⟨P_JM, hP_JM⟩ :=
    ld_ch12_gauss_jacobi_base_p_recursion F k_M hp (Fintype.card k_M - 1) ϖ Φ_Ω Φ_M
      (fun b => ∑ y : k_Mˣ, (((ω_M ^ b) y)⁻¹ : Ω F) * ψ_0M (y : k_M))
      P_1M P_step_M
      (by simpa only [MonoidHom.pow_apply, pow_one, hψ_0M_apply] using hG_M_1)
      hG_M_mul_p hG_M_step
  refine ⟨f, g_M, ω_M, ψ_0L, ϖ, Φ_Ω, Φ_M, P_Z, P_1L, P_1M, P_JL, P_JM,
    hf_pos, hq_eq, hQ_eq, hdvd_q1, hg_M_surj, hg_M_ord, hω_M_ord,
    hψ_0L_ne1, hϖ_ne0, hΦ_Ω_Z, hΦ_M_Z, hTransfer, hΦ_M_1L, hΦ_M_1M,
    hP_JL, fun b hb_pos hb_lt => by simpa only [hψ_0M_apply] using hP_JM b hb_pos hb_lt⟩

theorem ld_ch12_tame_base_p_digit_and_factorial_congruence (k_M : Type u) [Field k_M]
    (p f ℓ a : ℕ) (hp : Nat.Prime p) (hPrime : Nat.Prime ℓ) (hTame : ℓ ≠ p)
    [CharP k_M p]
    (hf_pos : 0 < f)
    (hdvd : ℓ ∣ (p ^ f - 1))
    (ha_pos : 0 < a) (ha_lt : a < p ^ f - 1) (ha_not_dvd : ¬ (ℓ ∣ a)) :
    let q := p ^ f
    let h := (q - 1) / ℓ
    let S := (q ^ ℓ - 1) / (q - 1)
    let a_star := (a * S) / ℓ
    0 < a_star ∧
    a_star < q ^ ℓ - 1 ∧
    ℓ * a_star = a * S ∧
    (∀ j ∈ (Finset.range ℓ).erase 0, 0 < j * h ∧ j * h < q - 1) ∧
    (p.digits a_star).sum =
      (p.digits a).sum + ∑ j ∈ (Finset.range ℓ).erase 0, (p.digits (j * h)).sum ∧
    (ℓ : k_M) ^ a * (((p.digits a_star).map Nat.factorial).prod : k_M) =
      (((p.digits a).map Nat.factorial).prod : k_M) *
        ∏ j ∈ (Finset.range ℓ).erase 0, (((p.digits (j * h)).map Nat.factorial).prod : k_M) :=
by
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  have h_s1 : ∀ (n : ℕ) (δ : ℕ → ℕ), (∀ r < n, δ r < p ^ f) →
      (p.digits (∑ r ∈ Finset.range n, δ r * (p ^ f) ^ r)).sum =
        ∑ r ∈ Finset.range n, (p.digits (δ r)).sum ∧
      ((p.digits (∑ r ∈ Finset.range n, δ r * (p ^ f) ^ r)).map Nat.factorial).prod =
        ∏ r ∈ Finset.range n, ((p.digits (δ r)).map Nat.factorial).prod := by
    intro n δ hδ
    have h_step1 : ∀ (x y : ℕ), x < p →
        (p.digits (x + p * y)).sum = x + (p.digits y).sum ∧
        ((p.digits (x + p * y)).map Nat.factorial).prod =
          x.factorial * ((p.digits y).map Nat.factorial).prod := by
      intro x y hx
      rcases eq_or_ne x 0 with rfl | hx0
      · rcases eq_or_ne y 0 with rfl | hy0
        · simp
        · rw [Nat.digits_add p hp.one_lt 0 y hx (Or.inr hy0)]
          simp
      · rw [Nat.digits_add p hp.one_lt x y hx (Or.inl hx0)]
        simp
    have h_step2 : ∀ (k u v : ℕ), u < p ^ k →
        (p.digits (u + p ^ k * v)).sum = (p.digits u).sum + (p.digits v).sum ∧
        ((p.digits (u + p ^ k * v)).map Nat.factorial).prod =
          ((p.digits u).map Nat.factorial).prod * ((p.digits v).map Nat.factorial).prod := by
      intro k
      induction k with
      | zero =>
        intro u v hu
        have hu0 : u = 0 := by simpa using hu
        subst hu0
        simp
      | succ k ih =>
        intro u v hu
        have hmod : u % p < p := Nat.mod_lt u hp.pos
        have hdiv : u / p < p ^ k := by
          rw [Nat.div_lt_iff_lt_mul hp.pos]
          simpa [pow_succ', mul_comm] using hu
        have hu_eq : u = u % p + p * (u / p) := (Nat.mod_add_div u p).symm
        have huv_eq : u + p ^ (k + 1) * v = u % p + p * (u / p + p ^ k * v) := by
          calc u + p ^ (k + 1) * v = (u % p + p * (u / p)) + p * p ^ k * v := by
                rw [← hu_eq, pow_succ']
            _ = u % p + p * (u / p + p ^ k * v) := by ring
        obtain ⟨hs_uv, hp_uv⟩ := h_step1 (u % p) (u / p + p ^ k * v) hmod
        obtain ⟨hs_u, hp_u⟩ := h_step1 (u % p) (u / p) hmod
        obtain ⟨hs_ih, hp_ih⟩ := ih (u / p) v hdiv
        refine ⟨?_, ?_⟩
        · rw [huv_eq, hs_uv, hs_ih, ← add_assoc, ← hs_u, ← hu_eq]
        · rw [huv_eq, hp_uv, hp_ih, ← mul_assoc, ← hp_u, ← hu_eq]
    induction n generalizing δ with
    | zero => simp
    | succ m ih =>
      have h_sum_eq :
          ∑ r ∈ Finset.range (m + 1), δ r * (p ^ f) ^ r =
            δ 0 + p ^ f * ∑ r ∈ Finset.range m, δ (r + 1) * (p ^ f) ^ r := by
        rw [Finset.sum_range_succ', pow_zero, mul_one, add_comm, Finset.mul_sum]
        congr 1
        apply Finset.sum_congr rfl
        intro r _
        rw [pow_succ']
        ring
      obtain ⟨hs2, hp2⟩ :=
        h_step2 f (δ 0) (∑ r ∈ Finset.range m, δ (r + 1) * (p ^ f) ^ r) (hδ 0 (Nat.succ_pos m))
      obtain ⟨hs_ih, hp_ih⟩ :=
        ih (fun r => δ (r + 1)) (fun r hr => hδ (r + 1) (Nat.succ_lt_succ hr))
      refine ⟨?_, ?_⟩
      · rw [h_sum_eq, hs2, hs_ih, Finset.sum_range_succ', add_comm]
      · rw [h_sum_eq, hp2, hp_ih, Finset.prod_range_succ', mul_comm]
  have h_s2 : ∀ (q : ℕ), 2 ≤ q → ℓ ∣ (q - 1) → a < q - 1 →
      let h := (q - 1) / ℓ
      let S := (q ^ ℓ - 1) / (q - 1)
      let a_star := (a * S) / ℓ
      let γ := fun j : ℕ => (a + j) / ℓ + j * h
      let δ := fun r : ℕ => γ (((ℓ - 1 - r) * a) % ℓ)
      0 < a_star ∧
      a_star < q ^ ℓ - 1 ∧
      ℓ * a_star = a * S ∧
      (∀ j ∈ (Finset.range ℓ).erase 0, 0 < j * h ∧ j * h < q - 1) ∧
      (∀ r < ℓ, δ r < q) ∧
      a_star = ∑ r ∈ Finset.range ℓ, δ r * q ^ r ∧
      (∀ F : ℕ → ℕ,
        (∑ r ∈ Finset.range ℓ, F (δ r) = ∑ j ∈ Finset.range ℓ, F (γ j)) ∧
        (∏ r ∈ Finset.range ℓ, F (δ r) = ∏ j ∈ Finset.range ℓ, F (γ j))) := by
    intro q hq hdvd_q ha_lt_q
    dsimp only
    set h := (q - 1) / ℓ
    set S := (q ^ ℓ - 1) / (q - 1)
