  have hConj1 : traceLM F hM₁'K₁ C = h₁ - IntermediateField.inclusion hLM₁' p_X := by
    rw [hC_M₁', (hQuadAff M₁' K₁ hM₁'K₁ hdeg2_M₁'K₁ U₁ V₁
      (IntermediateField.inclusion hE'K₁ y)).1, hyK₁_tr]
    dsimp only [U₁, V₁, h₁, p_X]
    simp only [map_sub, map_mul, map_ofNat]
    ring
  let U₂ : E' := (IntermediateField.inclusion hLE' d - IntermediateField.inclusion hLE' c₁) * y -
    IntermediateField.inclusion hLE' c₀
  let V₂ : E' := 1 - IntermediateField.inclusion hLE' c₁ * (1 + 2 * y)
  have hC_E' : C = IntermediateField.inclusion hE'K₁ U₂ +
      IntermediateField.inclusion hE'K₁ V₂ * IntermediateField.inclusion hM₁'K₁ x := by
    change (IntermediateField.inclusion hM₁'K₁ x +
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' d * y)) -
      (IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
        IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ *
          (IntermediateField.inclusion hM₁'K₁ x + IntermediateField.inclusion hE'K₁ y +
            2 * IntermediateField.inclusion hM₁'K₁ x * IntermediateField.inclusion hE'K₁ y)) =
      IntermediateField.inclusion hE'K₁ U₂ +
