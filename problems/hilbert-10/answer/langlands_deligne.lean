            rw [map_mul, hφa, hφb, mul_one]
          inv_mem' := by
            rintro a ⟨ha, hφa⟩
            refine ⟨C.inv_mem ha, ?_⟩
            change φ_C (⟨a, ha⟩⁻¹) = 1
            rw [map_inv, hφa, inv_one] }
      have hK_ψ_norm : K_ψ.Normal := by
        refine ⟨fun n hn g => ?_⟩
        rcases hn with ⟨hnC, hφn⟩
        have hgnC : g * n * g⁻¹ ∈ C := ‹C.Normal›.conj_mem n hnC g
        refine ⟨hgnC, ?_⟩
        have hc_conj : (g⁻¹)⁻¹ * n * g⁻¹ ∈ C := by
          rw [inv_inv]
          exact hgnC
        have hgM : g⁻¹ ∈ M := hM_top.symm ▸ Subgroup.mem_top g⁻¹
        have h_stab := (hM_stab g⁻¹).mp hgM ⟨n, hnC⟩ hc_conj
        have h_sub_eq : (⟨g * n * g⁻¹, hC_le hgnC⟩ : M) =
            ⟨(g⁻¹)⁻¹ * n * g⁻¹, hC_le hc_conj⟩ := Subtype.ext (by group)
        change ψ ⟨g * n * g⁻¹, hC_le hgnC⟩ = 1
        rw [h_sub_eq, h_stab]
        exact hφn
      have hK_bot : K_ψ = ⊥ := by
        rcases hC_min_norm K_ψ hK_ψ_norm with hbot | hle
        · exact hbot
        · exfalso
          obtain ⟨c₀, hc₀_ne⟩ := hc_ne
          obtain ⟨hc₀C, hφc₀⟩ := hle c₀.2
          exact hc₀_ne hφc₀
      letI : Fintype H := Fintype.ofFinite H
      have hH_card : 1 < Fintype.card H := by
        rwa [← Nat.card_eq_fintype_card]
      obtain ⟨h₀, hh₀_ne⟩ := Fintype.exists_ne_of_one_lt_card hH_card (1 : H)
      have hh₀1_ne : h₀.1 ≠ 1 := fun h => hh₀_ne (Subtype.ext h)
      have h_not_comm : ¬ ∀ c ∈ C, h₀.1 * c = c * h₀.1 :=
        fun hcomm => hh₀1_ne (hZ_H h₀.1 h₀.2 hcomm)
      push_neg at h_not_comm
      obtain ⟨c₁, hc₁C, hc₁_ne⟩ := h_not_comm
      have hc₁_conj : (h₀.1)⁻¹ * c₁ * h₀.1 ∈ C := by
        have h1 : (h₀.1)⁻¹ * c₁ * ((h₀.1)⁻¹)⁻¹ ∈ C := ‹C.Normal›.conj_mem c₁ hc₁C (h₀.1)⁻¹
        rwa [inv_inv] at h1
      have hh₀M : h₀.1 ∈ M := hM_top.symm ▸ Subgroup.mem_top h₀.1
      have h_stab := (hM_stab h₀.1).mp hh₀M ⟨c₁, hc₁C⟩ hc₁_conj
      have hzC : (h₀.1)⁻¹ * c₁ * h₀.1 * c₁⁻¹ ∈ C := C.mul_mem hc₁_conj (C.inv_mem hc₁C)
      have hz_ker : (h₀.1)⁻¹ * c₁ * h₀.1 * c₁⁻¹ ∈ K_ψ := by
        refine ⟨hzC, ?_⟩
        change φ_C (⟨(h₀.1)⁻¹ * c₁ * h₀.1, hc₁_conj⟩ * ⟨c₁, hc₁C⟩⁻¹) = 1
        rw [map_mul, map_inv]
        change ψ ⟨(h₀.1)⁻¹ * c₁ * h₀.1, hC_le hc₁_conj⟩ * (ψ ⟨c₁, hC_le hc₁C⟩)⁻¹ = 1
        rw [h_stab, mul_inv_cancel]
      rw [hK_bot, Subgroup.mem_bot] at hz_ker
      have h_conj_eq : (h₀.1)⁻¹ * c₁ * h₀.1 = c₁ := mul_inv_eq_one.mp hz_ker
      have h_comm : h₀.1 * c₁ = c₁ * h₀.1 := by
        calc h₀.1 * c₁ = h₀.1 * ((h₀.1)⁻¹ * c₁ * h₀.1) := by rw [h_conj_eq]
          _ = (h₀.1 * (h₀.1)⁻¹) * c₁ * h₀.1 := by simp [mul_assoc]
          _ = c₁ * h₀.1 := by rw [mul_inv_cancel, one_mul]
      exact hc₁_ne h_comm
    have ht_pow : χ_E_M ^ ℓ = 1 := by
      apply MonoidHom.ext
      intro w
      change (ψ (π_E_M w)) ^ ℓ = 1
      obtain ⟨c, hc_eq⟩ := hm_C (π_E_M w)
      rw [hc_eq, ← map_pow]
      have hc_pow : (⟨c.1, hC_le c.2⟩ : M) ^ ℓ = 1 := by
        apply Subtype.ext
        exact hC_exp c.1 c.2
      rw [hc_pow, map_one]
    have ht_restE : ∃ htE : E_M ≤ E ⊔ E_M, restrictWeilChar F htE χ_E_M = 1 := by
      refine ⟨le_sup_right, ?_⟩
      apply MonoidHom.ext
      intro w
      let w_L : G_L := Subgroup.inclusion (relWeil_antitone F (hLE_M.trans le_sup_right)) w
      have hw_sup : w_L ∈ (relWeil F (E ⊔ E_M)).subgroupOf G_L := w.2
      obtain ⟨hπH, hπM⟩ := h_mem_sup M w_L hw_sup
      have h_eq : π_E_M (Subgroup.inclusion (relWeil_antitone F le_sup_right) w) = ⟨π w_L, hπM⟩ :=
        Subtype.ext rfl
      change ψ (π_E_M (Subgroup.inclusion (relWeil_antitone F le_sup_right) w)) = 1
      rw [h_eq]
      exact hh_triv (π w_L) hπH hπM
    have ht_restMC : ∀ htM : E_M ≤ M_C, restrictWeilChar F htM χ_E_M ≠ 1 := by
      intro htM h_eq1
      obtain ⟨c, hc_ne1⟩ := hc_ne
      obtain ⟨w_L, hw_L⟩ := hsurj c.1
      have hw_MC : w_L ∈ (relWeil F M_C).subgroupOf G_L :=
        (h_mem_C w_L).mpr (hw_L.symm ▸ c.2)
      let w_M : relWeil F M_C := ⟨w_L.1, hw_MC⟩
      have h_eval : restrictWeilChar F htM χ_E_M w_M = 1 :=
        congrFun (congrArg DFunLike.coe h_eq1) w_M
      have h_π : π_E_M (Subgroup.inclusion (relWeil_antitone F htM) w_M) = ⟨c.1, hC_le c.2⟩ := by
        apply Subtype.ext
        exact hw_L
      change ψ (π_E_M (Subgroup.inclusion (relWeil_antitone F htM) w_M)) = 1 at h_eval
      rw [h_π] at h_eval
      exact hc_ne1 h_eval
    have ht_prime : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) →
        E_M = M_C := by
      intro hPrime_MCK
      have hPrime_C : Nat.Prime (Nat.card C) := hCard_C.symm ▸ hPrime_MCK
      have h_dvd : Nat.card φ_C.ker ∣ Nat.card C := Subgroup.card_subgroup_dvd_card φ_C.ker
      have h_ker_bot : φ_C.ker = ⊥ := by
        rcases (Nat.dvd_prime hPrime_C).mp h_dvd with h1 | htop
        · exact (Subgroup.eq_bot_iff_card φ_C.ker).mpr h1
        · exfalso
          have hker_top : φ_C.ker = ⊤ := Subgroup.eq_top_of_card_eq φ_C.ker htop
          obtain ⟨c₀, hc₀_ne⟩ := hc_ne
          have hc₀_ker : c₀ ∈ φ_C.ker := hker_top.symm ▸ Subgroup.mem_top c₀
          exact hc₀_ne (MonoidHom.mem_ker.mp hc₀_ker)
      have hM_le_C : M ≤ C := by
        intro m hm
        obtain ⟨h, hhH, c₀, hc₀C, rfl⟩ := hG_mul m
        have hhM : h ∈ M := by
          have heq : h = (h * c₀) * c₀⁻¹ := by group
          rw [heq]
          exact M.mul_mem hm (M.inv_mem (hC_le hc₀C))
        have hh_comm : ∀ c ∈ C, h * c = c * h := by
          intro c hcC
          have hc_conj : h⁻¹ * c * h ∈ C := by
            have h1 : h⁻¹ * c * (h⁻¹)⁻¹ ∈ C := ‹C.Normal›.conj_mem c hcC h⁻¹
            rwa [inv_inv] at h1
          have h_stab := (hM_stab h).mp hhM ⟨c, hcC⟩ hc_conj
          have h_in_ker : ⟨h⁻¹ * c * h, hc_conj⟩ * (⟨c, hcC⟩ : C)⁻¹ ∈ φ_C.ker := by
            rw [MonoidHom.mem_ker, map_mul, map_inv]
            change ψ ⟨h⁻¹ * c * h, hC_le hc_conj⟩ * (ψ ⟨c, hC_le hcC⟩)⁻¹ = 1
            rw [h_stab, mul_inv_cancel]
          rw [h_ker_bot, Subgroup.mem_bot] at h_in_ker
          have h_sub_eq : (⟨h⁻¹ * c * h, hc_conj⟩ : C) = ⟨c, hcC⟩ := mul_inv_eq_one.mp h_in_ker
          have h_val_eq : h⁻¹ * c * h = c := congrArg Subtype.val h_sub_eq
          calc h * c = h * (h⁻¹ * c * h) := by rw [h_val_eq]
            _ = c * h := by group
        have hh1 : h = 1 := hZ_H h hhH hh_comm
        rw [hh1, one_mul]
        exact hc₀C
      have hM_eq_C : M = C := le_antisymm hM_le_C hC_le
      change (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F = M_C
      rw [hM_eq_C, h_field_C]
    exact ⟨⟨1, E_M, hLE_M, χ_E_M⟩, ht_wf, ht_deg, ht_tr,
      ⟨rfl, h_lt_L M hM_lt_top, h_sub_MC M hC_le, ht_pow, ⟨hE_MK, ht_restK⟩, ht_restE, ht_restMC⟩,
      ht_prime⟩
  clear h_bridge
  have h_build : ∀ (L_sub : List (Σ (M : Subgroup G), (M →* (Ω F)ˣ))),
      (∀ p ∈ L_sub,
        ∃ hC_le : C ≤ p.1,
          (∃ c : C, p.2 ⟨c.1, hC_le c.2⟩ ≠ 1) ∧
          (∀ m : p.1, ∃ c : C, p.2 m = p.2 ⟨c.1, hC_le c.2⟩) ∧
          (∀ h ∈ H, ∀ hh : h ∈ p.1, p.2 ⟨h, hh⟩ = 1) ∧
          (∀ g : G, g ∈ p.1 ↔
            ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C),
              p.2 ⟨g⁻¹ * c.1 * g, hC_le hc⟩ = p.2 ⟨c.1, hC_le c.2⟩)) →
      ∃ D_sub : List (MonomialTerm F L),
        (∀ t ∈ D_sub, t.Wf F L) ∧
        (L_sub.map fun p => indCharTrace F p.1 p.2 1).sum =
          ((monomialListDeg F L D_sub : ℤ) : Ω F) ∧
        (∀ w : G_L,
          monomialListTrace F L D_sub w =
            (L_sub.map fun p => indCharTrace F p.1 p.2 (π w)).sum) ∧
        (∀ t ∈ D_sub,
          t.coeff = 1 ∧
          L < t.field ∧
          t.field ≤ M_C ∧
          t.χ ^ ℓ = 1 ∧
          (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
          (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
          (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1)) ∧
        (Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) →
          ∀ t ∈ D_sub, t.field = M_C) := by
    intro L_sub h_sub_props
    induction L_sub with
    | nil =>
      refine ⟨[], by simp, Int.cast_zero.symm, fun _ => rfl,
        by simp, fun _ t ht => by simp at ht⟩
    | cons p tl ih =>
      have hp := h_sub_props p List.mem_cons_self
      have htl := fun p' hp' => h_sub_props p' (List.mem_cons_of_mem p hp')
      obtain ⟨t_p, ht_wf, ht_deg, ht_tr, ht_props, ht_prime⟩ := h_term_lift p.1 p.2 hp
      obtain ⟨D_tl, hD_wf, hD_deg, hD_tr, hD_props, hD_prime⟩ := ih htl
      refine ⟨t_p :: D_tl, ?_, ?_, ?_, ?_, ?_⟩
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_wf
        · exact hD_wf t ht
      · change indCharTrace F p.1 p.2 1 + (tl.map fun p => indCharTrace F p.1 p.2 1).sum =
          (((t_p.deg F L + monomialListDeg F L D_tl : ℤ) : Ω F))
        rw [ht_deg, hD_deg, Int.cast_add]
      · intro w
        change t_p.trace F L w + monomialListTrace F L D_tl w =
          indCharTrace F p.1 p.2 (π w) + (tl.map fun p => indCharTrace F p.1 p.2 (π w)).sum
        rw [ht_tr w, hD_tr w]
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_props
        · exact hD_props t ht
      · intro hPrime t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_prime hPrime
        · exact hD_prime hPrime t ht
  obtain ⟨D_orb, hD_wf, hD_deg, hD_tr, hD_props, hD_prime⟩ := h_build L_orb hL_props
  clear h_term_lift h_build
  have hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb) := by
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · intro t ht
      rcases List.mem_cons.mp ht with rfl | ht
      · exact hwf_L
      · exact hD_wf t ht
    · intro w
      change (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L w + monomialListTrace F L D_orb w
      rw [htr_L w, hD_tr w, ← hL_sum (π w), htr_E w]
    · intro t ht
      rcases List.mem_cons.mp ht with rfl | ht
      · exact hLM_C
      · exact (hD_props t ht).2.2.1
  have hdeg_top : indCharTrace F (⊤ : Subgroup G) 1 1 = ((1 : ℤ) : Ω F) := by
    unfold indCharTrace
    have h_term : ∀ x : G,
        (if h : x * 1 * x⁻¹ ∈ (⊤ : Subgroup G) then
          ((1 : (⊤ : Subgroup G) →* (Ω F)ˣ) ⟨x * 1 * x⁻¹, h⟩ : Ω F)
        else 0) = 1 := fun x => by simp [Subgroup.mem_top]
    simp_rw [h_term]
    rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul, mul_one,
      Subgroup.card_top, inv_mul_cancel₀ (by exact_mod_cast (Nat.card_pos (α := G)).ne'),
      Int.cast_one]
  have hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1 := by
    have h_sum1 := hL_sum 1
    rw [hdeg_E, hdeg_top, hD_deg, ← Int.cast_add] at h_sum1
    have h_inj : ((⟨1, E, hLE, 1⟩ : MonomialTerm F L).deg F L : ℤ) =
        1 + monomialListDeg F L D_orb :=
      Int.cast_injective h_sum1
    change 1 * (Module.finrank L (IntermediateField.extendScalars hLE) : ℤ) =
      1 + monomialListDeg F L D_orb at h_inj
    rw [one_mul, hFinE_eq, add_comm] at h_inj
    exact eq_sub_of_add_eq h_inj.symm
  have h_deg_const : ∀ (D : List (MonomialTerm F L)),
      (∀ t ∈ D, t.coeff = 1 ∧ t.field = M_C) →
      monomialListDeg F L D =
        (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) * (D.length : ℤ) := by
    intro D hD
    induction D with
    | nil => exact (mul_zero _).symm
    | cons t tl ih =>
      obtain ⟨hc, hf⟩ := hD t List.mem_cons_self
      have htl := fun t' ht' => hD t' (List.mem_cons_of_mem t ht')
      have ht_deg : t.deg F L = (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) := by
        rcases t with ⟨coeff, field, hle, χ⟩
        dsimp only at hc hf
        subst hc
        subst hf
        have hle_eq : hle = hLM_C := Subsingleton.elim hle hLM_C
        subst hle_eq
        exact one_mul _
      change t.deg F L + monomialListDeg F L tl =
        (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) * ((tl.length + 1 : ℕ) : ℤ)
      rw [ht_deg, ih htl, Nat.cast_add, Nat.cast_one, mul_add, mul_one, add_comm]
  refine ⟨D_orb, hD₁_sub, hD_orb_deg, hD_props, fun hPrime_MCK => ⟨?_, hD_prime hPrime_MCK⟩⟩
  have h_deg_eq_mul : monomialListDeg F L D_orb =
      (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) * (D_orb.length : ℤ) :=
    h_deg_const D_orb (fun t ht => ⟨(hD_props t ht).1, hD_prime hPrime_MCK t ht⟩)
  rw [hD_orb_deg] at h_deg_eq_mul
  have h_cast : ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) =
      ((Module.finrank L (IntermediateField.extendScalars hLM_C) * D_orb.length : ℕ) : ℤ) := by
    rw [Nat.cast_sub (le_of_lt hMCK_gt1), Nat.cast_one, Nat.cast_mul, ← h_deg_eq_mul]
  exact ⟨D_orb.length, Int.ofNat.inj h_cast⟩

theorem ld_ch13_14_canonical_orbit_decomp_and_structure (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK) :
    1 < Module.finrank L (IntermediateField.extendScalars hLM_C) ∧
    1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK) ∧
    Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) ∧
    ∃ (ℓ : ℕ) (D_orb : List (MonomialTerm F L)),
      Nat.Prime ℓ ∧
      ℓ ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK) ∧
      IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb) ∧
      monomialListDeg F L D_orb =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1 ∧
      (∀ t ∈ D_orb,
        t.coeff = 1 ∧
        L < t.field ∧
        t.field ≤ M_C ∧
        t.χ ^ ℓ = 1 ∧
        (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
        (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
        (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1)) ∧
      (¬ (p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK)) →
        ℓ ≠ p F ∧
        Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) ∧
        Module.finrank L (IntermediateField.extendScalars hLM_C) ∣
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) ∧
        ∀ t ∈ D_orb, t.field = M_C) ∧
      (p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK) →
        ℓ = p F) :=
by
  let K' := IntermediateField.extendScalars hLK
  obtain ⟨hFinLMC_gt1, hFinMCK_gt1, hFinE_eq, hFinL, hFinK, hFinLK', hGalLK',
      π, C, H, hπ, hsurj, hC_norm, hC_ab, hCard_C, hCard_H, hG_mul, hZ_H, hC_min_norm,
      h_mem_H, h_mem_C, h_sub_MC, h_lt_L, _, h_field_C, h_mem_sup⟩ :=
    ld_ch13_14_semidirect_galois_group_structure F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hMin
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional L K' := hFinLK'
  haveI : IsGalois L K' := hGalLK'
  haveI : C.Normal := hC_norm
  letI : Fintype (K' ≃ₐ[L] K') := AlgEquiv.fintype L K'
  have hC_gt1 : 1 < Nat.card C := hCard_C.symm ▸ hFinMCK_gt1
  have hH_gt1 : 1 < Nat.card H := hCard_H.symm ▸ hFinLMC_gt1
  obtain ⟨L_orb, hL_sum, hL_props⟩ :=
    ld_ch13_14_semidirect_nontrivial_mackey_indCharTrace F (K' ≃ₐ[L] K') C hC_ab H hG_mul
  obtain ⟨ℓ, hPrime_ℓ, hℓ_dvd_C, hC_exp, hTame_C, hWild_C⟩ :=
    ld_ch13_14_lemma_6_4_prime_exp_and_tame_cyclic F L K hLK hGal C H hC_ab
      hC_gt1 hH_gt1 hZ_H hC_min_norm
  obtain ⟨D_orb, hD₁_sub, hD_orb_deg, hD_orb_props, hTame_lift⟩ :=
    ld_ch13_14_orbit_monomial_list_lift F L K M_C E hLK hLM_C hM_CK hLE hEK
      hFinMCK_gt1 hFinE_eq π C H hπ hsurj hC_ab hCard_C hH_gt1 hG_mul hZ_H hC_min_norm
      h_mem_H h_mem_C h_sub_MC h_lt_L h_field_C h_mem_sup ℓ hC_exp L_orb hL_sum hL_props
  have hℓ_dvd : ℓ ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK) :=
    hCard_C ▸ hℓ_dvd_C
  refine ⟨hFinLMC_gt1, hFinMCK_gt1, hFinE_eq, ℓ, D_orb,
    hPrime_ℓ, hℓ_dvd, hD₁_sub, hD_orb_deg, hD_orb_props, ?_, ?_⟩
  · intro hp_ndvd
    have hp_ndvd_C : ¬ (p F ∣ Nat.card C) := by
      rw [hCard_C]
      exact hp_ndvd
    obtain ⟨hℓ_ne_p, hPrime_C⟩ := hTame_C hp_ndvd_C
    have hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) :=
      hCard_C ▸ hPrime_C
    obtain ⟨h_dvd_sub1, h_field_eq⟩ := hTame_lift hPrime_MCK
    exact ⟨hℓ_ne_p, hPrime_MCK, h_dvd_sub1, h_field_eq⟩
  · intro hp_dvd
    apply hWild_C
    rw [hCard_C]
    exact hp_dvd

theorem ld_ch13_tame_monomial_orbit_to_weil_chars (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hLM_C_lt : L < M_C)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (χL_ext : relWeil F L →* (Ω F)ˣ)
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      t.field = M_C ∧
      t.χ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1)) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    let r := D_orb.length
    FiniteDimensional F L ∧
    FiniteDimensional F M_C ∧
    FiniteDimensional F E ∧
    FiniteDimensional F K ∧
    IsGaloisExt F M_C K ∧
    Algebra.IsSeparable L (IntermediateField.extendScalars hLM_C) ∧
    Algebra.IsSeparable L (IntermediateField.extendScalars hLE) ∧
    IsAdmissibleChar F M_C (traceChar F hLM_C ψ) ∧
    IsAdmissibleChar F E (traceChar F hLE ψ) ∧
    IsAdmissibleChar F K (traceChar F hLK ψ) ∧
    1 < f_H ∧
    ℓ ≠ 2 ∧
    1 ≤ r ∧
    r * f_H = ℓ - 1 ∧
    ∃ μ_orb : Fin r → (relWeil F M_C →* (Ω F)ˣ),
      (∀ i : Fin r,
        IsWeilRep F M_C (charRep F M_C (μ_orb i)) ∧
        restrictWeilChar F hM_CK (μ_orb i) = 1 ∧
        (μ_orb i) ^ ℓ = 1 ∧
        μ_orb i ≠ 1) ∧
      (∀ w : relWeil F L,
        (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w =
          (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L w +
            ∑ i : Fin r, (⟨1, M_C, hLM_C, μ_orb i⟩ : MonomialTerm F L).trace F L w) ∧
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
        tateEpsUnit F L (recChar F rec L 1) ψ *
          (∏ i : Fin r,
            tateEpsUnit F M_C (recChar F rec M_C (μ_orb i)) (traceChar F hLM_C ψ)) ∧
      evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext)) =
        tateEpsUnit F L (recChar F rec L χL_ext) ψ *
          (∏ i : Fin r,
            tateEpsUnit F M_C
              (recChar F rec M_C (μ_orb i * restrictWeilChar F hLM_C χL_ext))
              (traceChar F hLM_C ψ)) :=
by
  have hFinK : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F K := hFinK
  have hFinL : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  have hFinMC : FiniteDimensional F M_C :=
    Module.Finite.of_injective (IntermediateField.inclusion hM_CK).toLinearMap
      (IntermediateField.inclusion hM_CK).injective
  have hFinE : FiniteDimensional F E :=
    Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
      (IntermediateField.inclusion hEK).injective
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F M_C := hFinMC
  haveI : FiniteDimensional F E := hFinE
  have hGalMCK : IsGaloisExt F M_C K :=
    ((ld_galois_closure_directed_system F).2.1 L M_C K hLM_C hM_CK hGal).1
  have h_sep : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A) (hAK : A ≤ K),
      Algebra.IsSeparable L (IntermediateField.extendScalars hLA) := by
    intro A hLA hAK
    let S_A := IntermediateField.extendScalars hLA
    let K' := IntermediateField.extendScalars hLK
    haveI : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
    refine ⟨fun x => ?_⟩
    have hxA : (x : AlgebraicClosure F) ∈ A := (IntermediateField.mem_extendScalars hLA).mp x.2
    let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hAK hxA)⟩
    have hmin1 : (minpoly L (S_A.val x)).Separable ↔ (minpoly L x).Separable := by
      rw [minpoly.algHom_eq S_A.val S_A.val.injective x]
    have hmin2 : (minpoly L (K'.val x_K)).Separable ↔ (minpoly L x_K).Separable := by
      rw [minpoly.algHom_eq K'.val K'.val.injective x_K]
    exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable L x_K))
  have hSepLMC : Algebra.IsSeparable L (IntermediateField.extendScalars hLM_C) :=
    h_sep M_C hLM_C hM_CK
  have hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE) :=
    h_sep E hLE hEK
  have hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ) :=
    ld_traceChar_admissible F L M_C hLM_C hSepLMC ψ hψ
  have hψE : IsAdmissibleChar F E (traceChar F hLE ψ) :=
    ld_traceChar_admissible F L E hLE hSepLE ψ hψ
  have hψK : IsAdmissibleChar F K (traceChar F hLK ψ) :=
    ld_traceChar_admissible F L K hLK (hGal.2.2.2 hLK) ψ hψ
  have hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C) := by
    by_contra h_not_gt
    have hle : Module.finrank L (IntermediateField.extendScalars hLM_C) ≤ 1 := not_lt.mp h_not_gt
    let MC_ext := IntermediateField.extendScalars hLM_C
    haveI : FiniteDimensional F ↥MC_ext := hFinMC
    haveI : IsScalarTower F L ↥MC_ext := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hmul : Module.finrank F L * Module.finrank L ↥MC_ext = Module.finrank F M_C :=
      Module.finrank_mul_finrank F L ↥MC_ext
    have hFMC_le : Module.finrank F M_C ≤ Module.finrank F L := by
      calc Module.finrank F M_C
        _ = Module.finrank F L * Module.finrank L ↥MC_ext := hmul.symm
        _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hle
        _ = Module.finrank F L := mul_one _
    exact hLM_C_lt.ne (IntermediateField.eq_of_le_of_finrank_le hLM_C hFMC_le)
  have h_deg_const : ∀ (D : List (MonomialTerm F L)),
      (∀ t ∈ D, t.coeff = 1 ∧ t.field = M_C) →
      monomialListDeg F L D =
        (D.length : ℤ) * (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) := by
    intro D hD
    induction D with
    | nil => simp [monomialListDeg]
    | cons t tl ih =>
      obtain ⟨hc, hf⟩ := hD t List.mem_cons_self
      have htl := fun t' ht' => hD t' (List.mem_cons_of_mem t ht')
      have ht_deg : t.deg F L = (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) := by
        rcases t with ⟨coeff, field, hle, χ⟩
        dsimp only at hc hf
        subst hc
        subst hf
        have hle_eq : hle = hLM_C := Subsingleton.elim hle hLM_C
        subst hle_eq
        exact one_mul _
      change t.deg F L + monomialListDeg F L tl =
        ((tl.length + 1 : ℕ) : ℤ) * (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ)
      rw [ht_deg, ih htl, Nat.cast_add, Nat.cast_one]
      ring
  have h_deg_eq_mul : monomialListDeg F L D_orb =
      (D_orb.length : ℤ) * (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) :=
    h_deg_const D_orb (fun t ht => ⟨(hD_orb_props t ht).1, (hD_orb_props t ht).2.1⟩)
  rw [hD_orb_deg] at h_deg_eq_mul
  have hℓ_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK) := hPrime_MCK.one_lt
  have h_cast : ((D_orb.length * Module.finrank L (IntermediateField.extendScalars hLM_C) : ℕ) : ℤ) =
      ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) := by
    rw [Nat.cast_mul, Nat.cast_sub (le_of_lt hℓ_gt1), Nat.cast_one, ← h_deg_eq_mul]
  have hr_mul : D_orb.length * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 :=
    Int.ofNat.inj h_cast
  have hr_pos : 1 ≤ D_orb.length := by
    by_contra h0
    have hr0 : D_orb.length = 0 := by omega
    rw [hr0, zero_mul] at hr_mul
    omega
  have hOdd_ℓ : Module.finrank M_C (IntermediateField.extendScalars hM_CK) ≠ 2 := by
    intro h2
    rw [h2] at hr_mul
    have h_ge : 2 ≤ D_orb.length * Module.finrank L (IntermediateField.extendScalars hLM_C) :=
      Nat.mul_le_mul hr_pos hf_H_gt1
    omega
  have h_term_i : ∀ i : Fin D_orb.length,
      ∃ μ : relWeil F M_C →* (Ω F)ˣ,
        D_orb.get i = ⟨1, M_C, hLM_C, μ⟩ ∧
        IsWeilRep F M_C (charRep F M_C μ) ∧
        restrictWeilChar F hM_CK μ = 1 ∧
        μ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
        μ ≠ 1 := by
    intro i
    set t := D_orb.get i with ht_def
    have ht_mem : t ∈ D_orb := List.get_mem D_orb i
    have ht_wf : t.Wf F L := hD₁_sub.1.1 t (List.mem_cons_of_mem _ ht_mem)
    obtain ⟨hc, hf, hpow, ⟨htK, hrestK⟩, _, hnot1⟩ := hD_orb_props t ht_mem
    rcases t with ⟨coeff, field, hle, χ⟩
    dsimp only at hc hf hpow htK hrestK hnot1 ht_wf
    subst hc
    subst hf
    have hle_eq : hle = hLM_C := Subsingleton.elim hle hLM_C
    subst hle_eq
    have htK_eq : htK = hM_CK := Subsingleton.elim htK hM_CK
    subst htK_eq
    have hχ_ne1 : χ ≠ 1 := by
      intro h1
      apply hnot1 le_rfl
      rw [h1]
      exact MonoidHom.ext fun _ => rfl
    exact ⟨χ, rfl, ht_wf.2.2, hrestK, hpow, hχ_ne1⟩
  choose μ_orb hμ_eq hμ_props using h_term_i
  have h_map_sum : ∀ (f : MonomialTerm F L → Ω F),
      (D_orb.map f).sum =
        ∑ i : Fin D_orb.length, f ⟨1, M_C, hLM_C, μ_orb i⟩ := by
    intro f
    have h1 : (D_orb.map f).sum = ((List.ofFn D_orb.get).map f).sum :=
      congrArg (fun l : List (MonomialTerm F L) => (l.map f).sum) (List.ofFn_get D_orb).symm
    rw [h1, List.map_ofFn, List.sum_ofFn]
    apply Finset.sum_congr rfl
    intro i _
    exact congrArg f (hμ_eq i)
  have h_map_prod : ∀ (f : MonomialTerm F L → (Ω F)ˣ),
      (D_orb.map f).prod =
        ∏ i : Fin D_orb.length, f ⟨1, M_C, hLM_C, μ_orb i⟩ := by
    intro f
    have h1 : (D_orb.map f).prod = ((List.ofFn D_orb.get).map f).prod :=
      congrArg (fun l : List (MonomialTerm F L) => (l.map f).prod) (List.ofFn_get D_orb).symm
    rw [h1, List.map_ofFn, List.prod_ofFn]
    apply Finset.prod_congr rfl
    intro i _
    exact congrArg f (hμ_eq i)
  have htrace_self : ∀ x : L, traceLM F (le_rfl : L ≤ L) x = x := by
    intro x
    let e : L ≃ₐ[L] IntermediateField.extendScalars (le_rfl : L ≤ L) :=
      AlgEquiv.ofBijective (Algebra.ofId L (IntermediateField.extendScalars (le_rfl : L ≤ L)))
        ⟨(algebraMap L _).injective,
         fun y => ⟨⟨y.1, (IntermediateField.mem_extendScalars le_rfl).mp y.2⟩, rfl⟩⟩
    have he : toExtendScalars F (le_rfl : L ≤ L) x = e x := rfl
    change Algebra.trace L (IntermediateField.extendScalars (le_rfl : L ≤ L))
      (toExtendScalars F le_rfl x) = x
    rw [he, Algebra.trace_eq_of_algEquiv e x, Algebra.trace_self_apply]
  have htr_self : traceChar F (le_rfl : L ≤ L) ψ = ψ := by
    ext x
    simp [traceChar, htrace_self x]
  have h_rest_id : (1 : relWeil F L →* (Ω F)ˣ) * restrictWeilChar F (le_rfl : L ≤ L) χL_ext = χL_ext :=
    MonoidHom.ext fun _ => one_mul _
  refine ⟨hFinL, hFinMC, hFinE, hFinK, hGalMCK, hSepLMC, hSepLE,
    hψMC, hψE, hψK, hf_H_gt1, hOdd_ℓ, hr_pos, hr_mul,
    μ_orb, hμ_props, ?_, ?_, ?_⟩
  · intro w
    have hw := hD₁_sub.1.2 w
    simp only [monomialListTrace, List.map_cons, List.sum_cons] at hw
    rw [hw, h_map_sum (fun t => t.trace F L w)]
  · simp only [evalMonomialList, List.map_cons, List.prod_cons,
      h_map_prod (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ)]
    simp only [evalMonomialTerm, htr_self, mul_one, zpow_one]
  · simp only [evalMonomialList, List.map_cons, List.prod_cons, List.map_map,
      h_map_prod (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ ∘ twistMonomialTerm F L χL_ext)]
    simp only [Function.comp_apply, twistMonomialTerm, evalMonomialTerm,
      htr_self, h_rest_id, mul_one, zpow_one]

theorem ld_ch13_tame_galois_semidirect_proj_and_char_descent (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K)
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (r : ℕ)
    (μ_orb : Fin r → (relWeil F M_C →* (Ω F)ˣ))
    (hμ_props : ∀ i : Fin r,
      IsWeilRep F M_C (charRep F M_C (μ_orb i)) ∧
      restrictWeilChar F hM_CK (μ_orb i) = 1 ∧
      (μ_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      μ_orb i ≠ 1)
    (htrace_eq : ∀ w : relWeil F L,
      (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L w +
          ∑ i : Fin r, (⟨1, M_C, hLM_C, μ_orb i⟩ : MonomialTerm F L).trace F L w) :
    let K' := IntermediateField.extendScalars hLK
    let G := (K' ≃ₐ[L] K')
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    ∃ (C H : Subgroup G) (hC_norm : C.Normal) (_ : Fintype G) (_ : Fintype H) (_ : Fintype C)
      (π_MC : relWeil F M_C →* C) (μ_bar : Fin r → (C →* (Ω F)ˣ)),
      (∀ a ∈ C, ∀ b ∈ C, a * b = b * a) ∧
      Nat.card C = ℓ ∧
      Nat.card H = f_H ∧
      (∀ w : relWeil F M_C, (w : AbsGal F) ∈ K.fixingSubgroup ↔ π_MC w = 1) ∧
      (∀ i : Fin r,
        (∀ w : relWeil F M_C, μ_orb i w = μ_bar i (π_MC w)) ∧
        (μ_bar i) ^ ℓ = 1 ∧
        μ_bar i ≠ 1) ∧
      (∀ c : C,
        1 + (∑ i : Fin r,
          ∑ h : H,
            (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F)) =
          if c = 1 then (ℓ : Ω F) else 0) ∧
      ((∀ h₁ h₂ : H, h₁ * h₂ = h₂ * h₁) → IsAbelianExt F hLM_C) ∧
      ((∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1) →
        ∀ σ ∈ L.fixingSubgroup,
          (∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) →
          σ ∈ M_C.fixingSubgroup) :=
by
  have h_comm_eq : ∀ (G₀ : Type u) [Group G₀] (a b : G₀),
      a * b * a⁻¹ * b⁻¹ = 1 → a * b = b * a := by
    clear * -
    intro G₀ _ a b h
    calc a * b = (a * b * a⁻¹ * b⁻¹) * (b * a) := by group
      _ = 1 * (b * a) := by rw [h]
      _ = b * a := one_mul _
  have h_abs_finrank : ∀ (k E₀ Ω_bar : Type u) [Field k] [Field E₀] [Field Ω_bar]
      [Algebra k E₀] [Algebra k Ω_bar] [FiniteDimensional k E₀] [IsGalois k E₀]
      (f : E₀ →ₐ[k] Ω_bar) (A_ext : IntermediateField k Ω_bar),
      (∀ z ∈ A_ext, ∃ y : E₀, f y = z) →
      Module.finrank k ↥A_ext * Nat.card ((A_ext.comap f).fixingSubgroup) =
        Module.finrank k E₀ := by
    clear * -
    intro k E₀ Ω_bar _ _ _ _ _ _ _ f A_ext h_surj
    let A' : IntermediateField k E₀ := A_ext.comap f
    have hA'_map : A'.map f = A_ext := by
      ext z
      refine ⟨?_, fun hz => ?_⟩
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · obtain ⟨y, rfl⟩ := h_surj z hz
        exact ⟨y, hz, rfl⟩
    have hfin_A' : Module.finrank k ↥A' = Module.finrank k ↥A_ext := by
      have h1 : Module.finrank k ↥A' = Module.finrank k ↥(A'.map f) :=
        LinearEquiv.finrank_eq (A'.equivMap f).toLinearEquiv
      rwa [hA'_map] at h1
    have hmul : Module.finrank k ↥(IntermediateField.fixedField A'.fixingSubgroup) *
        Module.finrank ↥(IntermediateField.fixedField A'.fixingSubgroup) E₀ =
        Module.finrank k E₀ :=
      Module.finrank_mul_finrank k ↥(IntermediateField.fixedField A'.fixingSubgroup) E₀
    rwa [IntermediateField.finrank_fixedField_eq_card A'.fixingSubgroup,
      IsGalois.fixedField_fixingSubgroup A', hfin_A'] at hmul
  have h_tower_finrank : ∀ (L₀ A₀ K₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F L₀] [FiniteDimensional F K₀]
      (hLK₀ : L₀ ≤ K₀) (hLA₀ : L₀ ≤ A₀) (hAK₀ : A₀ ≤ K₀),
      Module.finrank L₀ (IntermediateField.extendScalars hLA₀) *
        Module.finrank A₀ (IntermediateField.extendScalars hAK₀) =
        Module.finrank L₀ (IntermediateField.extendScalars hLK₀) ∧
      0 < Module.finrank L₀ (IntermediateField.extendScalars hLA₀) ∧
      Module.finrank F L₀ * Module.finrank L₀ (IntermediateField.extendScalars hLA₀) =
        Module.finrank F A₀ := by
    clear * -
    intro L₀ A₀ K₀ hFinL₀ hFinK₀ hLK₀ hLA₀ hAK₀
    let K' := IntermediateField.extendScalars hLK₀
    let A_ext := IntermediateField.extendScalars hLA₀
    let K_A := IntermediateField.extendScalars hAK₀
    haveI : FiniteDimensional F A₀ :=
      Module.Finite.of_injective (IntermediateField.inclusion hAK₀).toLinearMap
        (IntermediateField.inclusion hAK₀).injective
