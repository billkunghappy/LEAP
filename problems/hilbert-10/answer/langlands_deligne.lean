    have hEq1 : tateEps F K₁ χK₁' ψK₁ * (∏ j ∈ Finset.range ℓ, tateEps F E (ξE ^ j) ψE) =
        tateEps F K₁ 1 ψK₁ * (tateEps F E χE' ψE) ^ ℓ := by
