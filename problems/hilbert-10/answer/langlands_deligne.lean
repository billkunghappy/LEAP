        ((2 * p * (p - 1) * (bE' - 1) - (2 * p - 3) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁ (u_fn m - Q_m) := by
    rw [hu_sub_Q]
    have hinv_ge : (((w_unit m hm_lt hm_pos)⁻¹ : K₁ˣ) : K₁) = 0 ∨
        (t₁ : ℤ) ≤ valL F K₁ (((w_unit m hm_lt hm_pos)⁻¹ : K₁ˣ) : K₁) :=
      Or.inr (le_of_eq (hw_inv_val m hm_lt hm_pos).symm)
    have hmul := hvalK₁_mul_ge _ _ (2 * B₀) (t₁ : ℤ) h_rem_val hinv_ge
    apply hvalK₁_mono ((2 * p * (p - 1) * (bE' - 1) - (2 * p - 3) * (bM₁' - 1) : ℕ) : ℤ)
      (2 * B₀ + (t₁ : ℤ)) _ _ hmul
    have hsub_le3 : (2 * p - 3) * t₁ ≤ 2 * p * (p - 1) * t₂ := by
      have h1 : 2 * p - 3 ≤ 2 * (p - 1) := by omega
      calc (2 * p - 3) * t₁ ≤ (2 * (p - 1)) * t₁ := Nat.mul_le_mul_right t₁ h1
        _ = 2 * ((p - 1) * t₁) := by ring
        _ ≤ 2 * (p * (p - 1) * t₂) := Nat.mul_le_mul_left 2 hB₀_sub_le
        _ = 2 * p * (p - 1) * t₂ := by ring
    have hp23_cast : ((2 * p - 3 : ℕ) : ℤ) = 2 * (p : ℤ) - 3 := by omega
    change ((2 * p * (p - 1) * t₂ - (2 * p - 3) * t₁ : ℕ) : ℤ) ≤ 2 * B₀ + (t₁ : ℤ)
    rw [Nat.cast_sub hsub_le3, hB₀_eq]
    push_cast
    rw [hp1_cast, hp23_cast]
    linarith
  exact ⟨h_conj_2a, h_conj_2b, h_conj_2c⟩

theorem ld_ch12_wild_odd_tot_ram_teichmuller_bijection_and_quotient_approx_ne_zero (F : Type u) [Field F]
