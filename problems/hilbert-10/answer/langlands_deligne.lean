      right; rw [hvalE'_props.2.2.2.2.2.1 cE', hcE'_val]
    rcases hE'_mul_b _ _ _ _ hcE'_inv_b hy with h0 | hge
    · exact hSpecE' _ (Or.inl h0)
    · exact hSpecE' _ (Or.inr (by omega))
  have hΦ_mul : ∀ u₁ u₂ : E'ˣ,
      u₁ ∈ unitGroup F E' (a + e) → u₂ ∈ unitGroup F E' (a + e) →
      ψE' (((cE'⁻¹ : E'ˣ) : E') * (((u₁ * u₂ : E'ˣ) : E') - 1)) =
        ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u₁ : E') - 1)) *
          ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u₂ : E') - 1)) := by
    intro u₁ u₂ hu₁ hu₂
    let w₁ : E' := (u₁ : E') - 1
    let w₂ : E' := (u₂ : E') - 1
    have hw₁_b : w₁ = 0 ∨ ((a + e : ℕ) : ℤ) ≤ valL F E' w₁ := by
      rcases (hvalE'_props.2.2.2.2.2.2.2.2.2.1 (a + e) (by omega) u₁).mp hu₁ with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    have hw₂_b : w₂ = 0 ∨ ((a + e : ℕ) : ℤ) ≤ valL F E' w₂ := by
      rcases (hvalE'_props.2.2.2.2.2.2.2.2.2.1 (a + e) (by omega) u₂).mp hu₂ with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    have hw₁₂_b : w₁ * w₂ = 0 ∨ (m₂ : ℤ) ≤ valL F E' (w₁ * w₂) :=
      (hE'_mul_b _ _ w₁ w₂ hw₁_b hw₂_b).imp id (fun h => by omega)
    have hsplit : ((cE'⁻¹ : E'ˣ) : E') * (((u₁ * u₂ : E'ˣ) : E') - 1) =
        (((cE'⁻¹ : E'ˣ) : E') * w₁ + ((cE'⁻¹ : E'ˣ) : E') * w₂) +
          ((cE'⁻¹ : E'ˣ) : E') * (w₁ * w₂) := by
      rw [Units.val_mul]
      dsimp [w₁, w₂]
      ring
    rw [hsplit, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, hψE'_vanish _ hw₁₂_b, mul_one]
  have hDesc : ∀ (k : ℕ) (r_lvl : ℕ), a + e ≤ r_lvl → m₂ - r_lvl = k →
      ∀ u ∈ unitGroup F E' r_lvl,
        (θE' u : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u : E') - 1)) := by
    intro k
    induction k with
    | zero =>
      intro r_lvl hr hk u hu
      have hr_ge : m₂ ≤ r_lvl := by omega
      have hu_m₂ : u ∈ unitGroup F E' m₂ := hE'_ug_mono m₂ r_lvl (by omega) hr_ge u hu
      have hθ1 : θE' u = 1 := hθE'_triv u hu_m₂
      have hw_b : (u : E') - 1 = 0 ∨ (m₂ : ℤ) ≤ valL F E' ((u : E') - 1) := by
        rcases (hvalE'_props.2.2.2.2.2.2.2.2.2.1 m₂ (by omega) u).mp hu_m₂ with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      rw [hθ1, Units.val_one, hψE'_vanish _ hw_b]
    | succ k ih =>
      intro r_lvl hr hk u hu
      obtain ⟨W, hW_mem, hv_mem⟩ := hnorm_surj_gt_E'K₁ r_lvl (by omega) u hu
      let uW : E'ˣ := Units.map (normLM F hE'K₁) W
      let v : E'ˣ := uW * u⁻¹
      have hW_2e1 : W ∈ unitGroup F K₁ (2 * e + 1) :=
        hK₁_ug_mono (2 * e + 1) _ (by omega) (by omega) W hW_mem
      have hv_ae : v ∈ unitGroup F E' (a + e) :=
        hE'_ug_mono (a + e) (r_lvl + 1) (by omega) (by omega) v hv_mem
      have hu_ae : u ∈ unitGroup F E' (a + e) :=
        hE'_ug_mono (a + e) r_lvl (by omega) hr u hu
      have huW_eq : uW = v * u := by
        dsimp [v]
        exact (inv_mul_cancel_right uW u).symm
      have hv_ih : (θE' v : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((v : E') - 1)) :=
        ih (r_lvl + 1) (by omega) (by omega) v hv_mem
      have hpull : (θE' uW : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uW : E') - 1)) :=
        hNorm2e1 W hW_2e1
      have hθ_mul : (θE' uW : Ω F) = (θE' v : Ω F) * (θE' u : Ω F) := by
        rw [huW_eq, map_mul, Units.val_mul]
      have hψ_mul : ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uW : E') - 1)) =
          ψE' (((cE'⁻¹ : E'ˣ) : E') * ((v : E') - 1)) *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u : E') - 1)) := by
        rw [huW_eq]
        exact hΦ_mul v u hv_ae hu_ae
      rw [hθ_mul, hψ_mul, ← hv_ih] at hpull
      exact mul_left_cancel₀ (Units.ne_zero (θE' v)) hpull
  intro w hw hw1
  let u : E'ˣ := Units.mk0 (1 + w) hw1
  have hu_mem : u ∈ unitGroup F E' (a + e) := by
    rw [hvalE'_props.2.2.2.2.2.2.2.2.2.1 (a + e) (by omega) u]
    have hsub : (u : E') - 1 = w := add_sub_cancel_left 1 w
    rw [hsub]
    rw [hm₂_half] at hw
    rcases hw with rfl | hge
    · left; exact add_zero 1
    · right; exact hge
  have hres := hDesc (m₂ - (a + e)) (a + e) (le_refl _) rfl u hu_mem
  have hsub : (u : E') - 1 = w := add_sub_cancel_left 1 w
  rwa [hsub] at hres

theorem ld_ch12_wild_dyadic_odd_max_break_min_cond_pointwise_crit_pullback (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
