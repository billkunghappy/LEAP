        simpa using h
      have hsum_inner : L_val * (N_m - b_K₁) + ξ m' * C_m = 0 ∨
          -(((p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (L_val * (N_m - b_K₁) + ξ m' * C_m) :=
        hval_add_K₁ (-(((p * p * m : ℕ) : ℤ))) _ _ hLNb_val hξC_val
      have hW2ξ_val : W_K₁ ^ 2 * ξ m' = 0 ∨
          -(((2 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (W_K₁ ^ 2 * ξ m') := by
        have h := hval_mul_ge_K₁ (-(((2 * p * p * m : ℕ) : ℤ))) 0 (W_K₁ ^ 2) (ξ m')
