        exact hC_le i (hC_conj c.2 (cosetRep u₀))
      rw [dif_pos hc_mem]
      congr 2
      apply Subtype.ext
      change (cosetRep u₀)⁻¹ * π w * cosetRep u₀ = (cosetRep u₀)⁻¹ * c.1 * cosetRep u₀
