          omega
        exact ⟨hne0, le_antisymm hle0 hge0⟩
      have hS_mul_μ : (c'_μ i : F_i) * S_i = 1 + (((α_orb i)⁻¹ : F_iˣ) : F_i) := by
        have h1 : ((α_orb i)⁻¹ : F_iˣ) = c'_μ i * (c'_χ'_Fi i)⁻¹ := by
          dsimp [α_orb]
          rw [mul_inv_rev, inv_inv]
        have h2 : (c'_μ i : F_i) * (((c'_μ i)⁻¹ : F_iˣ) : F_i) = 1 := Units.mul_inv (c'_μ i)
        rw [h1, Units.val_mul]
