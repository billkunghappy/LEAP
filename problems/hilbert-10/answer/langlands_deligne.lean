    rw [← hm₁_def] at hτ_p1 hτ_pow_sum
    have htr_M₁'K₁_0 : ∀ w : R_K,
        (w = 0 ∨ - (((p - 1 : ℕ) : ℤ) * (((t₁ + p * (bE' - bM₁') + 1 : ℕ) : ℤ))) ≤ vK₁ w) →
