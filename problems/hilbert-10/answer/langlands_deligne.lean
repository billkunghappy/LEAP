      push_cast at hk_cast ⊢
      linarith
    exact hmul_bound (-(((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ))) ((B₀ : ℕ) : ℤ)
      (((B₀ : ℕ) : ℤ) - ((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)) _ _ (by omega)
      hgeom (hΔ_conj_approx m' hm').1
  set Term1 := (w_pow * fb) * (∑ m' ∈ Finset.range p, ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i))
  set Term2 := ∑ m' ∈ Finset.range p,
    w_pow * ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i) * (f_conj m' - fb)
  have hsplit : IntermediateField.inclusion hE'K₁ (W_fn i) - W_shift = Term1 + Term2 := by
    have hW := hW_conj_sum i hi
    dsimp only at hW
    rw [hW]
    dsimp [W_shift, Term1, Term2, w_pow, f_conj, fb]
    rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun m' _ => ?_
    ring
  have hTerm2 : Term2 = 0 ∨ ((1 + p * t₂ : ℕ) : ℤ) ≤ valL F K₁ Term2 := by
    refine hval_sum (Finset.range p) _ ((1 + p * t₂ : ℕ) : ℤ) fun m' hm' => ?_
    have hm'_lt : m' < p := Finset.mem_range.mp hm'
    have hwD : w_pow * ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i) = 0 ∨
        ((i * p * m_exp : ℕ) : ℤ) + (((B₀ : ℕ) : ℤ) - ((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)) ≤
          valL F K₁ (w_pow * ((Δ_conj m') ^ i - ((Δ : K₁) + ξ m') ^ i)) :=
      hmul_bound ((i * p * m_exp : ℕ) : ℤ)
        (((B₀ : ℕ) : ℤ) - ((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ))
        (((i * p * m_exp : ℕ) : ℤ) + (((B₀ : ℕ) : ℤ) - ((i - 1 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ)))
        _ _ (le_refl _) (Or.inr (le_of_eq hw_pow_val.symm)) (hDiff_pow_val m' hm'_lt)
    refine hmul_bound _ 0 ((1 + p * t₂ : ℕ) : ℤ) _ _ ?_ hwD (hf_conj_diff m' hm'_lt)
    have h1 : 1 * (1 + t₁) ≤ i * (p * m_exp) := Nat.mul_le_mul (by omega) hpm_ge
    have h1' : 1 + t₁ ≤ i * p * m_exp := by
      calc 1 + t₁ = 1 * (1 + t₁) := by ring
        _ ≤ i * (p * m_exp) := h1
        _ = i * p * m_exp := by ring
    have h2 : (i - 1) * t₁ ≤ (p - 2) * t₁ := Nat.mul_le_mul_right t₁ (by omega)
    have h_nat : (1 + p * t₂) + (i - 1) * t₁ + (p - 1) * t₁ ≤
        i * p * m_exp + (B₀ + (p - 1) * t₁) := by
      rw [hB₀_add]
      linarith [h1', h2, h_base_t₂]
    have hz : (((1 + p * t₂) + (i - 1) * t₁ + (p - 1) * t₁ : ℕ) : ℤ) ≤
