      hwt_rew (normLM F hM₁'K₁ (Δ_conj m'))
    have hCL_ne0 : C_m * L_val ≠ 0 := mul_ne_zero hC_ne0 hL_ne0
    have hC_inv : C_m * C_m⁻¹ = 1 := mul_inv_cancel₀ hC_ne0
    have hL_inv : L_val * L_val⁻¹ = 1 := mul_inv_cancel₀ hL_ne0
    have hCL_inv : (C_m * L_val) * (C_m * L_val)⁻¹ = 1 := mul_inv_cancel₀ hCL_ne0
    have hdiff_eq : f_conj m' - fb = (N_m - b_K₁) * (W_K₁ ^ 2 * (C_m * L_val)⁻¹) := by
      rw [hf_conj_eq, hfb_eq]
      linear_combination (W_K₁ * N_m * L_val * (C_m * L_val)⁻¹) * hC_inv -
        (W_K₁ * b_K₁ * C_m * (C_m * L_val)⁻¹) * hL_inv -
        (W_K₁ * N_m * C_m⁻¹ - W_K₁ * b_K₁ * L_val⁻¹) * hCL_inv
    have hfac_ne0 : W_K₁ ^ 2 * (C_m * L_val)⁻¹ ≠ 0 :=
      mul_ne_zero hW2_ne0 (inv_ne_zero hCL_ne0)
    have hfac_val0 : valL F K₁ (W_K₁ ^ 2 * (C_m * L_val)⁻¹) = 0 := by
      rw [hval_mul_K₁ (W_K₁ ^ 2) (C_m * L_val)⁻¹ hW2_ne0 (inv_ne_zero hCL_ne0),
        hval_inv_elt_K₁ (C_m * L_val) hCL_ne0, hval_mul_K₁ C_m L_val hC_ne0 hL_ne0,
        hW2_val, hC_val, hL_val]
      push_cast; ring
    rw [hdiff_eq]
    have h := hval_mul_ge_K₁ 0 0 (N_m - b_K₁) (W_K₁ ^ 2 * (C_m * L_val)⁻¹)
      hNb_val (Or.inr (by rw [hfac_val0]))
    rcases h with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by linarith)
  · intro i hi W_shift W_teich
    have hi_bounds : 1 ≤ i ∧ i ≤ p - 1 := Finset.mem_Icc.mp hi
    set f_teich : ℕ → K₁ := fun m' =>
      W_K₁ * (b_K₁ + ξ m') * (L_val + ξ m')⁻¹ -
        s_K₁ * W_K₁ ^ 2 * (L_val ^ 2)⁻¹ * ξ m'
    have hf_diff_teich : ∀ m' < p,
        f_conj m' - f_teich m' = 0 ∨
          ((p * t₂ : ℕ) : ℤ) ≤ valL F K₁ (f_conj m' - f_teich m') := by
      intro m' hm'
      obtain ⟨hR_val, hNb_val, hC_ne0, hC_val⟩ := hR_and_C m' hm'
      obtain ⟨hA_ne0, hA_val⟩ := hL_xi_val m' hm'
      set N_m := IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m'))
      set R_m := N_m - (b_K₁ + ξ m' - ξ m' * s_K₁)
      set C_m := W_K₁ + N_m
      set X_m := b_K₁ + ξ m'
      set A_m := L_val + ξ m'
      set D_m := C_m * A_m * L_val ^ 2
      have hf_conj_eq : f_conj m' = W_K₁ * N_m * C_m⁻¹ :=
        hwt_rew (normLM F hM₁'K₁ (Δ_conj m'))
      have hCA_ne0 : C_m * A_m ≠ 0 := mul_ne_zero hC_ne0 hA_ne0
      have hD_ne0 : D_m ≠ 0 := mul_ne_zero hCA_ne0 hL2_ne0
      have hC_inv : C_m * C_m⁻¹ = 1 := mul_inv_cancel₀ hC_ne0
      have hA_inv : A_m * A_m⁻¹ = 1 := mul_inv_cancel₀ hA_ne0
      have hL2_inv : L_val ^ 2 * (L_val ^ 2)⁻¹ = 1 := mul_inv_cancel₀ hL2_ne0
      have hD_inv : D_m * D_m⁻¹ = 1 := mul_inv_cancel₀ hD_ne0
      set T₁ := W_K₁ ^ 2 * L_val ^ 2 * R_m
      set T₂ := W_K₁ ^ 2 * ξ m' * s_K₁ * (L_val * (N_m - b_K₁) + ξ m' * C_m)
      have hmaster : f_conj m' - f_teich m' = (T₁ + T₂) * D_m⁻¹ := by
        dsimp [f_teich, T₁, T₂]
        rw [hf_conj_eq]
        dsimp [R_m, C_m, X_m, A_m, D_m, L_val] at hC_inv hA_inv hL2_inv hD_inv ⊢
        linear_combination
          (W_K₁ * N_m * (W_K₁ + b_K₁ + ξ m') * (W_K₁ + b_K₁) ^ 2 *
            ((W_K₁ + N_m) * (W_K₁ + b_K₁ + ξ m') * (W_K₁ + b_K₁) ^ 2)⁻¹) * hC_inv -
          (W_K₁ * (b_K₁ + ξ m') * (W_K₁ + N_m) * (W_K₁ + b_K₁) ^ 2 *
            ((W_K₁ + N_m) * (W_K₁ + b_K₁ + ξ m') * (W_K₁ + b_K₁) ^ 2)⁻¹) * hA_inv +
          (s_K₁ * W_K₁ ^ 2 * ξ m' * (W_K₁ + N_m) * (W_K₁ + b_K₁ + ξ m') *
            ((W_K₁ + N_m) * (W_K₁ + b_K₁ + ξ m') * (W_K₁ + b_K₁) ^ 2)⁻¹) * hL2_inv -
          (W_K₁ * N_m * (W_K₁ + N_m)⁻¹ -
            (W_K₁ * (b_K₁ + ξ m') * (W_K₁ + b_K₁ + ξ m')⁻¹ -
              s_K₁ * W_K₁ ^ 2 * ((W_K₁ + b_K₁) ^ 2)⁻¹ * ξ m')) * hD_inv
      have hW2L2_ne0 : W_K₁ ^ 2 * L_val ^ 2 ≠ 0 := mul_ne_zero hW2_ne0 hL2_ne0
      have hW2L2_val : valL F K₁ (W_K₁ ^ 2 * L_val ^ 2) = -(((4 * p * p * m : ℕ) : ℤ)) := by
        rw [hval_mul_K₁ _ _ hW2_ne0 hL2_ne0, hW2_val, hL2_val]; push_cast; ring
      have hT₁_val : T₁ = 0 ∨
          ((p * t₂ : ℕ) : ℤ) - (((4 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ T₁ := by
        have h := hval_mul_ge_K₁ (-(((4 * p * p * m : ℕ) : ℤ))) ((p * t₂ : ℕ) : ℤ)
          (W_K₁ ^ 2 * L_val ^ 2) R_m (Or.inr (by rw [hW2L2_val])) hR_val
        rcases h with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by linarith)
      have hLNb_val : L_val * (N_m - b_K₁) = 0 ∨
          -(((p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (L_val * (N_m - b_K₁)) := by
        have h := hval_mul_ge_K₁ (-(((p * p * m : ℕ) : ℤ))) 0 L_val (N_m - b_K₁)
          (Or.inr (by rw [hL_val])) hNb_val
        simpa using h
      have hξC_val : ξ m' * C_m = 0 ∨
          -(((p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (ξ m' * C_m) := by
        have h := hval_mul_ge_K₁ 0 (-(((p * p * m : ℕ) : ℤ))) (ξ m') C_m
