    have hge0 : 0 ≤ valL F M₁' (f_M p₁ - f_M p₂) := hsub_int.resolve_left hsub_ne
    by_contra hne0
    have hge1 : 1 ≤ valL F M₁' (f_M p₁ - f_M p₂) := by omega
    have hp_eq := hf_M_sep_pairs p₁ hp₁ p₂ hp₂ (Or.inr hge1)
    exact hw_ne (congrArg f_M hp_eq)
  have hRM₁'_surj : ∀ w : M₁', (w = 0 ∨ 0 ≤ valL F M₁' w) →
      ∃ r ∈ R_M₁', w - r = 0 ∨ 1 ≤ valL F M₁' (w - r) := by
    intro w hw
    have hw1d_int : w * (1 - d) = 0 ∨ 0 ≤ valL F M₁' (w * (1 - d)) := by
      have h := hval_mul_ge_M₁' 0 0 w (1 - d) hw hone_sub_d_int
      rwa [add_zero] at h
    set a₁ : L := traceLM F hLM₁' (w * (1 - d))
    set a₂ : L := traceLM F hLM₁' w
    have ha₁_int : a₁ = 0 ∨ 0 ≤ valL F L a₁ := htr_bound_LM₁' 0 (w * (1 - d)) hw1d_int
    have ha₂_int : a₂ = 0 ∨ 0 ≤ valL F L a₂ := htr_bound_LM₁' 0 w hw
    obtain ⟨r₁, hr₁_mem, ha₁_r₁⟩ := hRL_surj a₁ ha₁_int
    obtain ⟨r₂, hr₂_mem, ha₂_r₂⟩ := hRL_surj a₂ ha₂_int
    have hr_pair_mem : (r₁, r₂) ∈ R_L ×ˢ R_L := Finset.mem_product.mpr ⟨hr₁_mem, hr₂_mem⟩
    refine ⟨f_M (r₁, r₂), Finset.mem_image_of_mem f_M hr_pair_mem, ?_⟩
    have hrem_a : w - f_M (a₁, a₂) =
        - (IntermediateField.inclusion hLM₁' (2 : L) * σ_U w * d) := by
      dsimp [f_M, a₁, a₂]
      rw [hσ_U_tr (w * (1 - d)), hσ_U_tr w, map_mul σ_U w (1 - d), hσ_U_one_sub_d,
        map_ofNat (IntermediateField.inclusion hLM₁') 2]
      ring
    have h2_M₁'_ge1 : IntermediateField.inclusion hLM₁' (2 : L) = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (2 : L)) := by
      rcases h2_ge1 with h0 | hge1
      · exact Or.inl (by rw [h0, map_zero])
      · right; rwa [hval_LM₁' (2 : L)]
    have hσ_w_int : σ_U w = 0 ∨ 0 ≤ valL F M₁' (σ_U w) := by
      rcases hw with h0 | hge0
      · exact Or.inl (by rw [h0, map_zero])
      · right; rwa [hσ_U_val w]
    have h2σw : IntermediateField.inclusion hLM₁' (2 : L) * σ_U w = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (2 : L) * σ_U w) := by
      have h := hval_mul_ge_M₁' 1 0 _ (σ_U w) h2_M₁'_ge1 hσ_w_int
      rwa [add_zero] at h
    have h2σwd : IntermediateField.inclusion hLM₁' (2 : L) * σ_U w * d = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (2 : L) * σ_U w * d) := by
      have h := hval_mul_ge_M₁' 1 0 _ d h2σw hd_int
      rwa [add_zero] at h
    have hrem_a_ge1 : w - f_M (a₁, a₂) = 0 ∨ 1 ≤ valL F M₁' (w - f_M (a₁, a₂)) := by
      rw [hrem_a]
      rcases h2σwd with h0 | hge1
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rwa [hval_neg_M₁']
    have hdiff_r1 : IntermediateField.inclusion hLM₁' (a₁ - r₁) = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (a₁ - r₁)) := by
      rcases ha₁_r₁ with h0 | hge1
      · exact Or.inl (by rw [h0, map_zero])
      · right; rwa [hval_LM₁' (a₁ - r₁)]
    have hdiff_r2 : IntermediateField.inclusion hLM₁' (a₂ - r₂) = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (a₂ - r₂)) := by
      rcases ha₂_r₂ with h0 | hge1
      · exact Or.inl (by rw [h0, map_zero])
      · right; rwa [hval_LM₁' (a₂ - r₂)]
    have hdiff_r2d : IntermediateField.inclusion hLM₁' (a₂ - r₂) * d = 0 ∨
        1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (a₂ - r₂) * d) := by
      have h := hval_mul_ge_M₁' 1 0 _ d hdiff_r2 hd_int
      rwa [add_zero] at h
    have hdiff_fM : f_M (a₁, a₂) - f_M (r₁, r₂) = 0 ∨
        1 ≤ valL F M₁' (f_M (a₁, a₂) - f_M (r₁, r₂)) := by
      have heq : f_M (a₁, a₂) - f_M (r₁, r₂) =
          IntermediateField.inclusion hLM₁' (a₁ - r₁) +
            IntermediateField.inclusion hLM₁' (a₂ - r₂) * d := by
        dsimp [f_M]; rw [map_sub, map_sub]; ring
      rw [heq]
      exact hval_add_M₁' 1 _ _ hdiff_r1 hdiff_r2d
    have htotal : (w - f_M (a₁, a₂)) + (f_M (a₁, a₂) - f_M (r₁, r₂)) = w - f_M (r₁, r₂) := by
      ring
    have h := hval_add_M₁' 1 _ _ hrem_a_ge1 hdiff_fM
    rwa [htotal] at h
  refine ⟨hchar2, h2_val, x_0, δ_T, δ_E, δ_U, liftL,
    hx0_int, hx_x0, hδ_T_val, hδ_E_val, hδ_U_val, hδ_norm, hδ_U_eq, hliftL, ?_⟩
  intro hOddHyp
  have hδ_E_val_m : valL F E' (δ_E : E') = ((condExp F E' θE' / 2 : ℕ) : ℤ) := by
    rw [hmE'_T]; exact hδ_E_val
  have hδ_U_val_m : valL F M₁' (δ_U : M₁') = ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) := by
    rw [hmM₁'_T]; exact hδ_U_val
  obtain ⟨hEpsE'_even, hEpsE'_odd⟩ :=
    ((hStat E' ψE' hψE' θE' hmE'_ge2).2 cE' hcE'_val hcE'_stat).2
      R_E' δ_E hRE'_int hRE'_sep hRE'_surj hδ_E_val_m
  obtain ⟨hEpsM₁'_even, hEpsM₁'_odd⟩ :=
    ((hStat M₁' ψM₁' hψM₁' θM₁' hmM₁'_ge2).2 cM₁' hcM₁'_val hcM₁'_stat).2
      R_M₁' δ_U hRM₁'_int hRM₁'_sep hRM₁'_surj hδ_U_val_m
  obtain ⟨hEpsL_even, hEpsL_odd⟩ :=
    ((hStat L ψ hψ νE' hbE'_ge2).2 c_ν hc_ν_val hc_ν_stat).2
      R_L δ_T hRL_int hRL_sep hRL_surj hδ_T_val
  have hRM₁'_card_pow :
      (R_M₁'.card : Ω F) ^ d_T =
        (Fintype.card k_L : Ω F) ^ d_T * (Fintype.card k_L : Ω F) ^ d_T := by
    rw [hRM₁'_card, Nat.cast_mul, mul_pow]
  rcases Nat.mod_two_eq_zero_or_one T with hT_even | hT_odd
  · have hmE'_even : condExp F E' θE' % 2 = 0 := by rw [hmE'_T]; exact hT_even
    have hmM₁'_even : condExp F M₁' θM₁' % 2 = 0 := by rw [hmM₁'_T]; exact hT_even
    have hE' := hEpsE'_even hmE'_even
    have hM₁' := hEpsM₁'_even hmM₁'_even
    have hL := hEpsL_even hT_even
    change tateEps F E' θE' ψE' =
      (qL F E' : Ω F) ^ condExpChar F E' ψE' *
        (R_E'.card : Ω F) ^ (condExp F E' θE' / 2) *
        (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E')) at hE'
    change tateEps F M₁' θM₁' ψM₁' =
      (qL F M₁' : Ω F) ^ condExpChar F M₁' ψM₁' *
        (R_M₁'.card : Ω F) ^ (condExp F M₁' θM₁' / 2) *
        (θM₁' cM₁' : Ω F) * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) at hM₁'
    change tateEps F L νE' ψ =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        (R_L.card : Ω F) ^ d_T *
        (νE' c_ν : Ω F) * ψ (((c_ν⁻¹ : Lˣ) : L)) at hL
    rw [hmE'_T, hRE'_card] at hE'
    rw [hmM₁'_T, hRM₁'_card_pow] at hM₁'
    rw [hRL_card] at hL
    rw [hE', hM₁', hL, heps_M₁'_1, heps_E'_1, heps_νM₁']
    linear_combination
      (qL F E' : Ω F) ^ condExpChar F E' ψE' *
        (qL F M₁' : Ω F) ^ condExpChar F M₁' ψM₁' *
        (qL F L : Ω F) ^ condExpChar F L ψ *
        (Fintype.card k_L : Ω F) ^ d_T *
        (Fintype.card k_L : Ω F) ^ d_T * hPrefactor
  · have hmE'_odd : condExp F E' θE' % 2 = 1 := by rw [hmE'_T]; exact hT_odd
    have hmM₁'_odd : condExp F M₁' θM₁' % 2 = 1 := by rw [hmM₁'_T]; exact hT_odd
    have hE' := hEpsE'_odd hmE'_odd
    have hM₁' := hEpsM₁'_odd hmM₁'_odd
    have hL := hEpsL_odd hT_odd
    change tateEps F E' θE' ψE' =
      (qL F E' : Ω F) ^ condExpChar F E' ψE' *
        (R_E'.card : Ω F) ^ (condExp F E' θE' / 2) *
        (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E')) *
        ∑ r ∈ R_E',
          if hr : 1 + (δ_E : E') * r ≠ 0 then
            (θE' (Units.mk0 (1 + (δ_E : E') * r) hr) : Ω F)⁻¹ *
              ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ_E : E') * r)
          else 0 at hE'
    change tateEps F M₁' θM₁' ψM₁' =
      (qL F M₁' : Ω F) ^ condExpChar F M₁' ψM₁' *
        (R_M₁'.card : Ω F) ^ (condExp F M₁' θM₁' / 2) *
        (θM₁' cM₁' : Ω F) * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) *
        ∑ r ∈ R_M₁',
          if hr : 1 + (δ_U : M₁') * r ≠ 0 then
            (θM₁' (Units.mk0 (1 + (δ_U : M₁') * r) hr) : Ω F)⁻¹ *
              ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_U : M₁') * r)
          else 0 at hM₁'
    change tateEps F L νE' ψ =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        (R_L.card : Ω F) ^ d_T *
        (νE' c_ν : Ω F) * ψ (((c_ν⁻¹ : Lˣ) : L)) *
        ∑ r ∈ R_L,
          if hr : 1 + (δ_T : L) * r ≠ 0 then
            (νE' (Units.mk0 (1 + (δ_T : L) * r) hr) : Ω F)⁻¹ *
              ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r)
          else 0 at hL
    rw [hmE'_T, hRE'_card] at hE'
    rw [hmM₁'_T, hRM₁'_card_pow] at hM₁'
    rw [hRL_card] at hL
    let g_L : L → Ω F := fun r =>
      if hr : 1 + (δ_T : L) * r ≠ 0 then
        (νE' (Units.mk0 (1 + (δ_T : L) * r) hr) : Ω F)⁻¹ *
          ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r)
      else 0
    let g_E' : E' → Ω F := fun r =>
      if hr : 1 + (δ_E : E') * r ≠ 0 then
        (θE' (Units.mk0 (1 + (δ_E : E') * r) hr) : Ω F)⁻¹ *
          ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ_E : E') * r)
      else 0
    let g_M₁' : M₁' → Ω F := fun w =>
      if hw : 1 + (δ_U : M₁') * w ≠ 0 then
        (θM₁' (Units.mk0 (1 + (δ_U : M₁') * w) hw) : Ω F)⁻¹ *
          ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_U : M₁') * w)
      else 0
    have hsum_L : (∑ r ∈ R_L, g_L r) = ∑ a : k_L, g_L (liftL a) := by
      dsimp [R_L]
      exact Finset.sum_image (fun a₁ _ a₂ _ h => hliftL_inj h)
    have hsum_E' :
        (∑ r ∈ R_E', g_E' r) =
          ∑ a : k_L, g_E' (IntermediateField.inclusion hLE' (liftL a)) := by
      dsimp [R_E', R_L]
      rw [Finset.sum_image (fun r₁ _ r₂ _ h => hinj_E' h),
        Finset.sum_image (fun a₁ _ a₂ _ h => hliftL_inj h)]
    have hsum_M₁' :
        (∑ w ∈ R_M₁', g_M₁' w) =
          ∑ p : k_L × k_L, g_M₁' (f_M (liftL p.1, liftL p.2)) := by
      dsimp [R_M₁']
      rw [Finset.sum_image hRM₁'_inj, Finset.sum_product]
      have hinner : ∀ r₁ : L,
          (∑ r₂ ∈ R_L, g_M₁' (f_M (r₁, r₂))) =
            ∑ a₂ : k_L, g_M₁' (f_M (r₁, liftL a₂)) := by
        intro r₁
        dsimp [R_L]
        exact Finset.sum_image (fun a₁ _ a₂ _ h => hliftL_inj h)
      simp_rw [hinner]
      have houter :
          (∑ r₁ ∈ R_L, ∑ a₂ : k_L, g_M₁' (f_M (r₁, liftL a₂))) =
            ∑ a₁ : k_L, ∑ a₂ : k_L, g_M₁' (f_M (liftL a₁, liftL a₂)) := by
        dsimp [R_L]
        exact Finset.sum_image (fun a₁ _ a₂ _ h => hliftL_inj h)
      rw [houter, Fintype.sum_prod_type]
    have hSumEq :
        (∑ p : k_L × k_L, g_M₁' (f_M (liftL p.1, liftL p.2))) =
          (∑ a : k_L, g_E' (IntermediateField.inclusion hLE' (liftL a))) *
            (∑ a : k_L, g_L (liftL a)) :=
      hOddHyp hT_odd
    change tateEps F E' θE' ψE' =
      (qL F E' : Ω F) ^ condExpChar F E' ψE' *
        (Fintype.card k_L : Ω F) ^ d_T *
        (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E')) *
        (∑ r ∈ R_E', g_E' r) at hE'
    change tateEps F M₁' θM₁' ψM₁' =
      (qL F M₁' : Ω F) ^ condExpChar F M₁' ψM₁' *
        ((Fintype.card k_L : Ω F) ^ d_T * (Fintype.card k_L : Ω F) ^ d_T) *
        (θM₁' cM₁' : Ω F) * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) *
        (∑ w ∈ R_M₁', g_M₁' w) at hM₁'
    change tateEps F L νE' ψ =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        (Fintype.card k_L : Ω F) ^ d_T *
        (νE' c_ν : Ω F) * ψ (((c_ν⁻¹ : Lˣ) : L)) *
        (∑ r ∈ R_L, g_L r) at hL
    rw [hsum_E'] at hE'
    rw [hsum_M₁', hSumEq] at hM₁'
    rw [hsum_L] at hL
    rw [hE', hM₁', hL, heps_M₁'_1, heps_E'_1, heps_νM₁']
    linear_combination
      (qL F E' : Ω F) ^ condExpChar F E' ψE' *
        (qL F M₁' : Ω F) ^ condExpChar F M₁' ψM₁' *
        (qL F L : Ω F) ^ condExpChar F L ψ *
        (Fintype.card k_L : Ω F) ^ d_T *
        (Fintype.card k_L : Ω F) ^ d_T *
        (∑ a : k_L, g_E' (IntermediateField.inclusion hLE' (liftL a))) *
        (∑ a : k_L, g_L (liftL a)) * hPrefactor

theorem ld_ch12_wild_dyadic_unramified_min_cond_odd_biquad_norm_terms (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hT_odd : condExp F L νE' % 2 = 1)
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hMinEq : condExp F M₁' θM₁' = condExp F L νE')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = 2 * valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (d : M₁') (hd_val : valL F M₁' d = 0)
    (c_ν : Lˣ) (C : K₁ˣ) (cM₁' : M₁'ˣ) (cE' : E'ˣ)
    (hcM₁'_eq : cM₁' = (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) *
      (Units.map (normLM F hM₁'K₁) C)⁻¹)
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
    (hcE'_eq : cE' = (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) *
      (Units.map (normLM F hE'K₁) C)⁻¹)
    (hcE'_stat : ∀ y : E',
      (y = 0 ∨ (((condExp F E' θE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      ∀ hy : 1 + y ≠ 0,
        (θE' (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * y))
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
