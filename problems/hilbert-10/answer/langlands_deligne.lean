          - (((n + 1 : ℕ) : ℤ) * M) + valL F L (d (n + 1))
        have htop_ne0 : c ^ (n + 1) * d (n + 1) ≠ 0 :=
          mul_ne_zero (pow_ne_zero (n + 1) hc_ne0) hne_top
        have htop_val : valL F L (c ^ (n + 1) * d (n + 1)) = V_top := by
