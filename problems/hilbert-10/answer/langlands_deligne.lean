  have hFinF'L' : Module.finrank L (IntermediateField.extendScalars hLF') =
      Module.finrank L' (IntermediateField.extendScalars hL'M₁) :=
    hFinLF'_eq.trans hFinL'M₁_eq.symm
  have hTameEL' : ¬ (p F ∣ Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) := by
