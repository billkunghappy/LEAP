        let p := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
        ∃ s : K₁ → ℕ → E',
          (∀ w : K₁, s w 1 = traceLM F hE'K₁ w) ∧
          (∀ w : K₁, 2 * s w 2 = (traceLM F hE'K₁ w) ^ 2 - traceLM F hE'K₁ (w ^ 2)) ∧
          (∀ w : K₁, w ≠ 0 → s w (p - 1) = normLM F hE'K₁ w * traceLM F hE'K₁ (w⁻¹)) ∧
          (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
            ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
              (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ (r : ℤ) * q →
              (s w r = 0 ∨ m ≤ valL F E' (s w r))) ∧
          (∀ (w : K₁) (c : E'),
            normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * w) =
              1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s w r) +
                c ^ p * normLM F hE'K₁ w) := by
    intro G _ _ act hcard h1 hmul hring hincl hval htr hnorm
    obtain ⟨s, hs1, hs2, hsp1, hs_val, hs_poly⟩ :=
      ld_wild_odd_free_orbit_symm_functions F E' K₁ hE'K₁ hPrime_E'K₁ hp_odd_E'K₁
        hvalK₁_props (bM₁' - 1) htr_E'K₁' G act hcard h1 hmul hring hincl hval htr hnorm
    refine ⟨s, hs1, hs2, hsp1, fun w r hr q m hw hqm => hs_val w r hr q m hw ?_, hs_poly⟩
    have hbM₁'_cast : ((bM₁' - 1 : ℕ) + 1 : ℤ) = (bM₁' : ℤ) := by omega
    rwa [hbM₁'_cast]
  have hCayley_E'K₁ := fun (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁)
      (s : K₁ → ℕ → E') hcard h1 hring hincl hnorm hpoly =>
    ld_wild_odd_symm_subset_sum_and_cayley_hamilton F E' K₁ hE'K₁ hPrime_E'K₁ hp_odd_E'K₁
      hvalE'_props hvalK₁_props hval_E'K₁' G act hcard h1 hring hincl hnorm s hpoly
  have hp_pos : 1 ≤ p := hPrime.pos
  have hbE'_le_3pm₁ : (bE' : ℤ) ≤
      ((3 * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) : ℕ) : ℤ) := by
    have h_nat : bE' ≤ 3 * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) := by
      have h1 : bE' - bM₁' ≤ p * (bE' - bM₁') := Nat.le_mul_of_pos_left _ hp_pos
      have h2 : 2 * bM₁' - 1 + p * (bE' - bM₁') ≤ 3 * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) :=
        Nat.le_mul_of_pos_left _ (by omega)
      omega
    exact_mod_cast h_nat
  have hΔ_tr_low_bE' : ∀ j ∈ Finset.Icc 1 (p - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j)) := by
    intro j hj
    rcases hΔ_tr_low j hj with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hbE'_le_3pm₁ hge)
  have hΔ_tr_top_bE' :
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        (bE' : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
    rcases hΔ_tr_top with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hbE'_le_3pm₁ hge)
  have hTrNormCongr :=
    ld_wild_odd_bicyclic_weight_p_orbit_trace_norm_congr F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalE'K₁ hPrime hp_odd' hdegM₁' hdegE'K₁
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      hval_LE' hval_norm_LE' hval_LM₁' hval_norm_LM₁' hval_E'K₁ hval_norm_E'K₁
      htr_LE' htr_LM₁' hTowerNormTr
      ϖ_M₁' hϖ_M₁' hBasis_M₁'
      G_M₁' act_M₁' hcard_GM₁' hactM₁'_one hactM₁'_mul hactM₁'_ring
      hactM₁'_incl hactM₁'_val hactM₁'_trace hactM₁'_norm
      y₁_M₁' hy₁M₁'_tr hy₁M₁'_ne0 hy₁M₁'_val
      G_E' act_E' hcard_GE' hactE'_one hactE'_mul hactE'_ring
      hactE'_incl hactE'_val hactE'_trace hactE'_norm
      hSymm_E'K₁ hCayley_E'K₁
      Δ hΔ_val hΔ_tr_low_bE' hΔ_tr_top_bE'
      e_Δ he_Δ_1 he_Δ_val he_Δ_poly
  exact ⟨hCoeffExtr, hTwistedTr,
    ⟨e_Δ, he_Δ_1, he_Δ_val, he_Δ_poly, he_Δ_cayley, he_Δ_tr_p1,
      Z, s₀, hb_sub_a, hs₀_val, hs₀_approx, hZ0, hZ1, hZl⟩,
    hTrNormCongr⟩

theorem ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F B] [FiniteDimensional F K] (hBK : B ≤ K)
    (hGal : IsGaloisExt F B K)
    (hPrime : Nat.Prime (Module.finrank B (IntermediateField.extendScalars hBK)))
    (hp_odd : Module.finrank B (IntermediateField.extendScalars hBK) ≠ 2)
    (hvalB_props : valL F B 0 = 0 ∧ valL F B 1 = 0 ∧ valL F B (-1) = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B)) ∧
      (∀ m : ℤ, ∃ c : Bˣ, valL F B (c : B) = m) ∧
      (∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x + y = 0 ∨ k ≤ valL F B (x + y))) ∧
      (∀ u : Bˣ, u ∈ unitGroup F B 0 ↔ valL F B (u : B) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Bˣ,
        u ∈ unitGroup F B a ↔ ((u : B) = 1 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1))) ∧
      (∀ (a : ℕ) (u : Bˣ), u ∈ unitGroup F B a → valL F B (u : B) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_BK : ∀ x : B,
      valL F K (IntermediateField.inclusion hBK x) =
        (Module.finrank B (IntermediateField.extendScalars hBK) : ℤ) * valL F B x)
    (hval_norm : ∀ w : K, valL F B (normLM F hBK w) = valL F K w)
    (T : ℕ) (hT_ge1 : 1 ≤ T)
    (htr_BK : ∀ (m : ℤ) (w : K),
      (w = 0 ∨
        (Module.finrank B (IntermediateField.extendScalars hBK) : ℤ) * m -
          ((Module.finrank B (IntermediateField.extendScalars hBK) - 1 : ℕ) : ℤ) *
            (T : ℤ) ≤ valL F K w) →
      (traceLM F hBK w = 0 ∨ m ≤ valL F B (traceLM F hBK w)))
    (hSymm :
      ∀ (t : ℕ),
        (∀ (m : ℤ) (y : K),
          (y = 0 ∨
            (Module.finrank B (IntermediateField.extendScalars hBK) : ℤ) * m -
              ((Module.finrank B (IntermediateField.extendScalars hBK) - 1 : ℕ) : ℤ) *
                (t + 1 : ℤ) ≤ valL F K y) →
          (traceLM F hBK y = 0 ∨ m ≤ valL F B (traceLM F hBK y))) →
        ∀ (G : Type u) [Group G] [Fintype G] (act : G → K → K),
          Fintype.card G = Module.finrank B (IntermediateField.extendScalars hBK) →
          (∀ y : K, act 1 y = y) →
          (∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y)) →
          (∀ σ : G,
            act σ 0 = 0 ∧ act σ 1 = 1 ∧
            (∀ y₁ y₂ : K,
              act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
              act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
              act σ (-y₁) = -act σ y₁)) →
          (∀ (σ : G) (x : B), act σ (IntermediateField.inclusion hBK x) =
            IntermediateField.inclusion hBK x) →
          (∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y) →
          (∀ y : K, IntermediateField.inclusion hBK (traceLM F hBK y) = ∑ σ : G, act σ y) →
          (∀ y : K, IntermediateField.inclusion hBK (normLM F hBK y) = ∏ σ : G, act σ y) →
          let p := Module.finrank B (IntermediateField.extendScalars hBK)
          ∃ s : K → ℕ → B,
            (∀ y : K, s y 1 = traceLM F hBK y) ∧
            (∀ y : K, 2 * s y 2 = (traceLM F hBK y) ^ 2 - traceLM F hBK (y ^ 2)) ∧
            (∀ y : K, y ≠ 0 → s y (p - 1) = normLM F hBK y * traceLM F hBK (y⁻¹)) ∧
            (∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
              ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
                (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (r : ℤ) * q →
                (s y r = 0 ∨ m ≤ valL F B (s y r))) ∧
            (∀ (y : K) (c : B),
              normLM F hBK (1 + IntermediateField.inclusion hBK c * y) =
                1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) +
                  c ^ p * normLM F hBK y))
    (hCayley :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K → K) (s : K → ℕ → B),
        Fintype.card G = Module.finrank B (IntermediateField.extendScalars hBK) →
        (∀ y : K, act 1 y = y) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ y₁ y₂ : K,
            act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
            act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
            act σ (-y₁) = -act σ y₁)) →
        (∀ (σ : G) (x : B), act σ (IntermediateField.inclusion hBK x) =
          IntermediateField.inclusion hBK x) →
        (∀ y : K, IntermediateField.inclusion hBK (normLM F hBK y) = ∏ σ : G, act σ y) →
        (∀ (y : K) (c : B),
          normLM F hBK (1 + IntermediateField.inclusion hBK c * y) =
            1 + (∑ r ∈ Finset.Icc 1 (Module.finrank B (IntermediateField.extendScalars hBK) - 1),
              c ^ r * s y r) +
              c ^ (Module.finrank B (IntermediateField.extendScalars hBK)) * normLM F hBK y) →
        let p := Module.finrank B (IntermediateField.extendScalars hBK)
        (∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
          IntermediateField.inclusion hBK (s y r) =
            ∑ S ∈ ((Finset.univ : Finset G).powerset.filter (fun S => S.card = r)),
              ∏ σ ∈ S, act σ y) ∧
        (∀ y : K,
          y ^ p =
            IntermediateField.inclusion hBK (normLM F hBK y) +
              ∑ i ∈ Finset.Icc 1 (p - 1),
                (-1 : K) ^ (i - 1) * IntermediateField.inclusion hBK (s y i) * y ^ (p - i))) :
    let p := Module.finrank B (IntermediateField.extendScalars hBK)
    ∃ s : K → ℕ → B,
      (∀ w : K, s w 1 = traceLM F hBK w) ∧
      (∀ w : K, 2 * s w 2 = (traceLM F hBK w) ^ 2 - traceLM F hBK (w ^ 2)) ∧
      (∀ (w : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
        ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K w) →
          (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * q →
          (s w r = 0 ∨ m ≤ valL F B (s w r))) ∧
      (∀ w : K,
        normLM F hBK (1 + w) - 1 =
          (∑ r ∈ Finset.Icc 1 (p - 1), s w r) + normLM F hBK w) ∧
      (∀ w : K,
        w ^ p =
          IntermediateField.inclusion hBK (normLM F hBK w) +
            ∑ i ∈ Finset.Icc 1 (p - 1),
              (-1 : K) ^ (i - 1) * IntermediateField.inclusion hBK (s w i) * w ^ (p - i)) ∧
      (∀ (w : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
        (-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s w r - traceLM F hBK (w ^ r) =
          - ∑ j ∈ Finset.Icc 1 (r - 1),
              (-1 : B) ^ (j - 1) * s w j * traceLM F hBK (w ^ (r - j))) :=
by
  intro p
  let K' : IntermediateField B (AlgebraicClosure F) := IntermediateField.extendScalars hBK

  
  have hFinBK' : FiniteDimensional B K' := by
    haveI : FiniteDimensional F K' := ‹FiniteDimensional F K›
    haveI : IsScalarTower F B K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F B K'
  haveI : FiniteDimensional B K' := hFinBK'

  
  have hGalBK' : IsGalois B ↥K' := by
    have hSepBK' : Algebra.IsSeparable B K' := hGal.2.2.2 hBK
    haveI : Algebra.IsSeparable B K' := hSepBK'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal B (AlgebraicClosure F) := Normal.tower_top_of_normal F B (AlgebraicClosure F)
    have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[B] AlgebraicClosure F),
        (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : B.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv B).symm σ
      let τ_F : B.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv B).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hBK).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hBK).mp hx)
    exact helper_isGalois B (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois B ↥K' := hGalBK'
  let G : Type u := (K' ≃ₐ[B] K')

  
  have hcard_G : Fintype.card G = p :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank B K')
  let fromExtendScalars : K' →+* K :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hBK).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → K → K := fun σ y => fromExtendScalars (σ (toExtendScalars F hBK y))
  let φ : G → (K →+* K) := fun σ =>
    fromExtendScalars.comp (σ.toRingHom.comp (toExtendScalars F hBK))
  have hφ_apply : ∀ (σ : G) (y : K), φ σ y = act σ y := fun _ _ => rfl
  have hact_one : ∀ y : K, act 1 y = y := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun y₁ y₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (x : B),
      act σ (IntermediateField.inclusion hBK x) = IntermediateField.inclusion hBK x := by
    intro σ x
    change fromExtendScalars (σ (algebraMap B K' x)) = IntermediateField.inclusion hBK x
    rw [σ.commutes x]
    rfl

  
  have hact_trace : ∀ y : K,
      IntermediateField.inclusion hBK (traceLM F hBK y) = ∑ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := B) (L := K') (toExtendScalars F hBK y))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hBK y)) Finset.univ)
  have hact_norm : ∀ y : K,
      IntermediateField.inclusion hBK (normLM F hBK y) = ∏ σ : G, act σ y := by
    intro y
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms B (toExtendScalars F hBK y))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hBK y)) Finset.univ)
  have hinj : Function.Injective (IntermediateField.inclusion hBK) :=
    (IntermediateField.inclusion hBK).injective
  have hnorm_act : ∀ (σ : G) (y : K), normLM F hBK (act σ y) = normLM F hBK y := by
    intro σ y
    apply hinj
    rw [hact_norm (act σ y), hact_norm y]
    have hmul : (∏ τ : G, act τ (act σ y)) = ∏ τ : G, act (τ * σ) y := by
      refine Finset.prod_congr rfl fun τ _ => ?_
