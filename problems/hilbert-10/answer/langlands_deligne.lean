        ((ν₁ * χ') (c_twist 1) : Ω F) *
        ψ (((c_χ⁻¹ : Lˣ) : L)) *
        ψ ((((c_twist 1)⁻¹ : Lˣ) : L)) *
        (H_χ B * H_τ C * ψ₀ C) := by
    have h1_lt_p : 1 < Module.finrank L (IntermediateField.extendScalars hLK) := by omega
    rcases hτ_props 1 h1_lt_p zero_lt_one with
      ⟨hτ_tilde1, hτ_unit1, _, _, _, hN1_ne_raw, hN1_val_raw, hc_twist1_inv_raw⟩
    have hτ_tilde1_eq : τ_tilde 1 = 1 := by
      apply Units.ext
      change (τ_tilde 1 : L) = 1
      rw [hτ_tilde1, Nat.cast_one, one_pow]
    have hτ_unit1_eq : τ_unit 1 = 1 := by
      rw [hτ_unit1, hτ_tilde1_eq, one_pow]
    have hτ_unit1_coe : (τ_unit 1 : L) = 1 := by rw [hτ_unit1_eq]; rfl
    have hN1_ne : (N : L) + 1 ≠ 0 := by rwa [hτ_unit1_coe] at hN1_ne_raw
    have hN1_val : valL F L ((N : L) + 1) = 0 := by rwa [hτ_unit1_coe] at hN1_val_raw
    have hc_twist1_inv : (((c_twist 1)⁻¹ : Lˣ) : L) = A * ((N : L) + 1) := by
      rwa [hτ_unit1_coe] at hc_twist1_inv_raw
    let v_N1 : Lˣ := Units.mk0 ((N : L) + 1) hN1_ne
    have hvN1_coe : (v_N1 : L) = (N : L) + 1 := rfl
    have hvN1_mul_inv : ((N : L) + 1) * ((v_N1⁻¹ : Lˣ) : L) = 1 := Units.mul_inv v_N1
    have hvN1_inv_val : valL F L ((v_N1⁻¹ : Lˣ) : L) = 0 := by
      rw [hvalL_inv v_N1, hvN1_coe, hN1_val, neg_zero]
    have hc_τ_eq_twist : c_τ = c_twist 1 * v_N1 := by
      have hinv : (c_twist 1)⁻¹ = c_τ⁻¹ * v_N1 := by
        apply Units.ext
        change (((c_twist 1)⁻¹ : Lˣ) : L) = A * (v_N1 : L)
        exact hc_twist1_inv
      calc c_τ = (c_τ⁻¹)⁻¹ := (inv_inv c_τ).symm
        _ = (c_τ⁻¹ * v_N1 * v_N1⁻¹)⁻¹ := by rw [mul_inv_cancel_right]
        _ = ((c_twist 1)⁻¹ * v_N1⁻¹)⁻¹ := by rw [hinv]
        _ = c_twist 1 * v_N1 := by rw [mul_inv_rev, inv_inv, inv_inv, mul_comm]
    let q_s : L := s * ((δ_τ⁻¹ : Lˣ) : L)
    have hδτ_inv_val : valL F L ((δ_τ⁻¹ : Lˣ) : L) = -(d : ℤ) := by
      rw [hvalL_inv δ_τ, hδτ_val]
    have hqs_diff_eq : q_s - (u_0 : L) = ((δ_τ⁻¹ : Lˣ) : L) * (s - (2 : L) * (u_0 : L)) := by
      dsimp [q_s]
      linear_combination (u_0 : L) * h2_mul_δτ_inv
    have hqs_diff_P1 : P_L 1 (q_s - (u_0 : L)) := by
      rw [hqs_diff_eq]
      have h1 : P_L (-(d : ℤ)) ((δ_τ⁻¹ : Lˣ) : L) := Or.inr (le_of_eq hδτ_inv_val.symm)
      have h2 : P_L ((d + 1 : ℕ) : ℤ) (s - (2 : L) * (u_0 : L)) := by
        change P_L (((b + 1) / 2 : ℕ) : ℤ) (s - (2 : L) * (u_0 : L)) at htr_u
        rwa [hr0_eq_d1] at htr_u
      have h3 := hPL_mul h1 h2
      exact hPL_mono (by omega) h3
    have hqs_P0 : P_L 0 q_s := by
      have h_eq : q_s = (q_s - (u_0 : L)) + (u_0 : L) := by ring
      rw [h_eq]
      exact hPL_add (hPL_mono (by omega) hqs_diff_P1) hu0_P0
    have hres_qs : resL q_s = ρ := hresL_congr hqs_P0 hu0_P0 hqs_diff_P1
    let b_0 : L := -(u_0 : L) * q_s * ((v_N1⁻¹ : Lˣ) : L)
    let c_0 : L := q_s * ((v_N1⁻¹ : Lˣ) : L)
    have hvN1_inv_P0 : P_L 0 ((v_N1⁻¹ : Lˣ) : L) := Or.inr (le_of_eq hvN1_inv_val.symm)
    have hc0_P0 : P_L 0 c_0 := by
      have h := hPL_mul hqs_P0 hvN1_inv_P0
      simpa using h
    have hb0_P0 : P_L 0 b_0 := by
      have h1 : P_L 0 (-(u_0 : L)) := hPL_neg hu0_P0
      have h2 : b_0 = (-(u_0 : L)) * c_0 := by dsimp [b_0, c_0]; ring
      rw [h2]
      simpa using hPL_mul h1 hc0_P0
    have hδχ_b0_P1 : P_L 1 ((δ_χ : L) * b_0) := by
      have h1 : P_L (d : ℤ) (δ_χ : L) := Or.inr (le_of_eq hδχ_val.symm)
      have h2 := hPL_mul h1 hb0_P0
      exact hPL_mono (by omega) h2
    have hδτ_c0_P1 : P_L 1 ((δ_τ : L) * c_0) := by
      have h1 : P_L (d : ℤ) (δ_τ : L) := Or.inr (le_of_eq hδτ_val.symm)
      have h2 := hPL_mul h1 hc0_P0
      exact hPL_mono (by omega) h2
    have hz0_ne : 1 + (δ_χ : L) * b_0 ≠ 0 := h1_add_ne_L hδχ_b0_P1
    have hz1_ne : 1 + (δ_τ : L) * c_0 ≠ 0 := h1_add_ne_L hδτ_c0_P1
    let z_0 : Lˣ := Units.mk0 (1 + (δ_χ : L) * b_0) hz0_ne
    let z_1 : Lˣ := Units.mk0 (1 + (δ_τ : L) * c_0) hz1_ne
    have hδτ_c0_eq : (δ_τ : L) * c_0 = s * ((v_N1⁻¹ : Lˣ) : L) := by
      change (2 : L) * (s * ((δ_τ⁻¹ : Lˣ) : L) * ((v_N1⁻¹ : Lˣ) : L)) = s * ((v_N1⁻¹ : Lˣ) : L)
      linear_combination s * ((v_N1⁻¹ : Lˣ) : L) * h2_mul_δτ_inv
    have hδχ_b0_eq : (δ_χ : L) * b_0 = -s * ((v_N1⁻¹ : Lˣ) : L) := by
      change ((2 : L) * ((u_0⁻¹ : Lˣ) : L)) * (-(u_0 : L) * (s * ((δ_τ⁻¹ : Lˣ) : L)) * ((v_N1⁻¹ : Lˣ) : L)) =
        -s * ((v_N1⁻¹ : Lˣ) : L)
      linear_combination
        -(2 : L) * s * ((δ_τ⁻¹ : Lˣ) : L) * ((v_N1⁻¹ : Lˣ) : L) * hu0_mul_inv -
        s * ((v_N1⁻¹ : Lˣ) : L) * h2_mul_δτ_inv
    have hc_χK_norm_inv : (Units.map (normLM F hLK) c_χK)⁻¹ = c_χ⁻¹ * (c_twist 1)⁻¹ * z_0 := by
      rw [← map_inv]
      apply Units.ext
      change normLM F hLK ((c_χK⁻¹ : Kˣ) : K) =
        ((c_χ⁻¹ : Lˣ) : L) * (((c_twist 1)⁻¹ : Lˣ) : L) * (1 + (δ_χ : L) * b_0)
      rw [hc_χK_inv, map_mul, hnorm_incl A, hnorm_sub (N : L) (u : K), hu_norm_coe,
        hc_χ_inv_coe, hc_twist1_inv, hδχ_b0_eq]
      change A ^ 2 * ((N : L) ^ 2 - (N : L) * s + (N : L)) =
        A * (N : L) * (A * ((N : L) + 1)) * (1 + -s * ((v_N1⁻¹ : Lˣ) : L))
      linear_combination A ^ 2 * (N : L) * s * hvN1_mul_inv
    have hc_χK_norm : Units.map (normLM F hLK) c_χK = c_χ * c_twist 1 * z_0⁻¹ := by
      calc Units.map (normLM F hLK) c_χK = ((Units.map (normLM F hLK) c_χK)⁻¹)⁻¹ := (inv_inv _).symm
        _ = (c_χ⁻¹ * (c_twist 1)⁻¹ * z_0)⁻¹ := by rw [hc_χK_norm_inv]
        _ = c_χ * c_twist 1 * z_0⁻¹ := by
          rw [mul_inv_rev, mul_inv_rev, inv_inv, inv_inv]
          ac_rfl
    have hmult_χK : ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) =
        (χ' c_χ : Ω F) * (χ' (c_twist 1) : Ω F) * (χ' z_0 : Ω F)⁻¹ := by
      change (χ' (Units.map (normLM F hLK) c_χK) : Ω F) = _
      rw [hc_χK_norm, map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul, Units.val_inv_eq_inv_val]
    have hnorm_1_add_u : normLM F hLK (1 + (u : K)) = ((v_N1 * z_1 : Lˣ) : L) := by
      have h1 := hnorm_add 1 (u : K)
      rw [map_one (IntermediateField.inclusion hLK), hu_norm_coe] at h1
      rw [h1]
      change 1 ^ 2 + 1 * s + (N : L) = ((N : L) + 1) * (1 + (δ_τ : L) * c_0)
      rw [hδτ_c0_eq]
      linear_combination -s * hvN1_mul_inv
    have h1_add_u_ne : 1 + (u : K) ≠ 0 := by
      intro h0
      have h := hnorm_1_add_u
      rw [h0, hnorm_0] at h
      exact Units.ne_zero (v_N1 * z_1) h.symm
    let w_1 : Kˣ := Units.mk0 (1 + (u : K)) h1_add_u_ne
    have hw1_norm : Units.map (normLM F hLK) w_1 = v_N1 * z_1 :=
      Units.ext hnorm_1_add_u
    have hν₁_vN1_z1 : ν₁ (v_N1 * z_1) = 1 :=
      (hν₁_ker (v_N1 * z_1)).mp ⟨w_1, hw1_norm⟩
    have hmult_ν₁ : (ν₁ c_τ : Ω F) = (ν₁ (c_twist 1) : Ω F) * (ν₁ z_1 : Ω F)⁻¹ := by
      have hvN1_eq : ν₁ v_N1 = (ν₁ z_1)⁻¹ := by
        rw [map_mul] at hν₁_vN1_z1
        exact eq_inv_of_mul_eq_one_left hν₁_vN1_z1
      rw [hc_τ_eq_twist, map_mul, hvN1_eq, Units.val_mul, Units.val_inv_eq_inv_val]
    have htr_cχK : traceLM F hLK ((c_χK⁻¹ : Kˣ) : K) + A =
        ((c_χ⁻¹ : Lˣ) : L) + (((c_twist 1)⁻¹ : Lˣ) : L) +
          ((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * b_0 +
          A * (δ_τ : L) * c_0 +
          A * (4 : L) * (-c_0) := by
      have htr1 : traceLM F hLK ((c_χK⁻¹ : Kˣ) : K) = A * (2 : L) * (N : L) - A * s := by
        rw [hc_χK_inv, mul_sub, map_sub, htr_smul A (IntermediateField.inclusion hLK (N : L)),
          htr_incl (N : L), htr_smul A (u : K)]
        ring
      have h4_neg_c0 : (4 : L) * (-c_0) = -(2 : L) * s * ((v_N1⁻¹ : Lˣ) : L) := by
        change (4 : L) * (-(s * ((δ_τ⁻¹ : Lˣ) : L) * ((v_N1⁻¹ : Lˣ) : L))) =
          -(2 : L) * s * ((v_N1⁻¹ : Lˣ) : L)
        linear_combination -(2 : L) * s * ((v_N1⁻¹ : Lˣ) : L) * h2_mul_δτ_inv
      rw [htr1, hc_χ_inv_coe, hc_twist1_inv,
        show A * (N : L) * (δ_χ : L) * b_0 = A * (N : L) * ((δ_χ : L) * b_0) by ring,
        show A * (δ_τ : L) * c_0 = A * ((δ_τ : L) * c_0) by ring,
        show A * (4 : L) * (-c_0) = A * ((4 : L) * (-c_0)) by ring,
        hδχ_b0_eq, hδτ_c0_eq, h4_neg_c0]
      linear_combination A * s * hvN1_mul_inv
    have hψ_add : (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) * ψ A =
        ψ (((c_χ⁻¹ : Lˣ) : L)) * ψ ((((c_twist 1)⁻¹ : Lˣ) : L)) *
          ψ (((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * b_0) *
          ψ (A * (δ_τ : L) * c_0) *
          ψ (A * (4 : L) * (-c_0)) := by
      change ψ (traceLM F hLK ((c_χK⁻¹ : Kˣ) : K)) * ψ A = _
      rw [← ψ.map_add_eq_mul, htr_cχK]
      simp only [ψ.map_add_eq_mul, mul_assoc]
    have hHχ_b0 := hHχ_spec b_0 hb0_P0 hz0_ne
    have hHτ_c0 := hHτ_spec c_0 hc0_P0 hz1_ne
    have hψ0_c0 := hψ₀_spec (-c_0) (hPL_neg hc0_P0)
    have hchar2_neg : ∀ x : k_L, -x = x := by
      intro x
      linear_combination -x * hchar2
    have hu0_sq_P0 : P_L 0 ((u_0 : L) ^ 2) := by
      rw [sq]
      simpa using hPL_mul hu0_P0 hu0_P0
    have hres_N : resL (N : L) = ρ ^ 2 := by
      rw [hresL_congr hN_P0 hu0_sq_P0 hN_u0, sq, hresL_mul hu0_P0 hu0_P0, ← sq]
    have hvN1_P0 : P_L 0 (v_N1 : L) := Or.inr (le_of_eq hN1_val.symm)
    have h1_P0 : P_L 0 (1 : L) := Or.inr (le_of_eq hvalL_1.symm)
    have hres_vN1 : resL (v_N1 : L) = (1 + ρ) ^ 2 := by
      change resL ((N : L) + 1) = (1 + ρ) ^ 2
      rw [hresL_add hN_P0 h1_P0, hres_N, hresL_1]
      linear_combination -ρ * hchar2
    have hres_vN1_inv : resL ((v_N1⁻¹ : Lˣ) : L) = ((1 + ρ) ^ 2)⁻¹ := by
      have h1 : resL ((v_N1 : L) * ((v_N1⁻¹ : Lˣ) : L)) = 1 := by
        rw [Units.mul_inv, hresL_1]
      rw [hresL_mul hvN1_P0 hvN1_inv_P0, hres_vN1] at h1
      exact eq_inv_of_mul_eq_one_right h1
    have hres_c0 : resL c_0 = C := by
      dsimp [c_0, C]
      rw [hresL_mul hqs_P0 hvN1_inv_P0, hres_qs, hres_vN1_inv, div_eq_mul_inv]
    have hres_neg_c0 : resL (-c_0) = C := by
      rw [hresL_neg hc0_P0, hchar2_neg, hres_c0]
    have hres_b0 : resL b_0 = B := by
      have hb0_eq : b_0 = (-(u_0 : L)) * c_0 := by dsimp [b_0, c_0]; ring
      rw [hb0_eq, hresL_mul (hPL_neg hu0_P0) hc0_P0, hresL_neg hu0_P0, hchar2_neg, hres_c0]
      dsimp [B, C, ρ]
      ring
    rw [hres_b0] at hHχ_b0
    rw [hres_c0] at hHτ_c0
    rw [hres_neg_c0] at hψ0_c0
    have htwist_val : ((ν₁ * χ') (c_twist 1) : Ω F) = (ν₁ (c_twist 1) : Ω F) * (χ' (c_twist 1) : Ω F) := by
      rw [MonoidHom.mul_apply, Units.val_mul]
    calc ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
          (ν₁ c_τ : Ω F) *
          (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) *
          ψ A
        = ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
            (ν₁ c_τ : Ω F) *
            ((traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) * ψ A) := by ring
      _ = ((χ' c_χ : Ω F) * (χ' (c_twist 1) : Ω F) * (χ' z_0 : Ω F)⁻¹) *
            ((ν₁ (c_twist 1) : Ω F) * (ν₁ z_1 : Ω F)⁻¹) *
            (ψ (((c_χ⁻¹ : Lˣ) : L)) * ψ ((((c_twist 1)⁻¹ : Lˣ) : L)) *
              ψ (((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * b_0) *
              ψ (A * (δ_τ : L) * c_0) *
              ψ (A * (4 : L) * (-c_0))) := by rw [hmult_χK, hmult_ν₁, hψ_add]
      _ = (χ' c_χ : Ω F) * ((ν₁ (c_twist 1) : Ω F) * (χ' (c_twist 1) : Ω F)) *
            ψ (((c_χ⁻¹ : Lˣ) : L)) * ψ ((((c_twist 1)⁻¹ : Lˣ) : L)) *
            (((χ' z_0 : Ω F)⁻¹ * ψ (((c_χ⁻¹ : Lˣ) : L) * (δ_χ : L) * b_0)) *
              ((ν₁ z_1 : Ω F)⁻¹ * ψ (A * (δ_τ : L) * c_0)) *
              ψ (A * (4 : L) * (-c_0))) := by ring
      _ = (χ' c_χ : Ω F) *
            ((ν₁ * χ') (c_twist 1) : Ω F) *
            ψ (((c_χ⁻¹ : Lˣ) : L)) *
            ψ ((((c_twist 1)⁻¹ : Lˣ) : L)) *
            (H_χ B * H_τ C * ψ₀ C) := by
          rw [← htwist_val, ← hHχ_b0, ← hHτ_c0, ← hψ0_c0]
  
  have hcond_1L : condExp F L (1 : Lˣ →* (Ω F)ˣ) = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl fun _ _ => rfl)
  have hcond_1K : condExp F K (1 : Kˣ →* (Ω F)ˣ) = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl fun _ _ => rfl)
  have htate_1L : tateEps F L 1 ψ = (qL F L : Ω F) ^ condExpChar F L ψ := by
    unfold tateEps
    rw [if_pos hcond_1L, MonoidHom.one_apply, Units.val_one, mul_one]
  have htate_1K : tateEps F K 1 ψ_K = (qL F K : Ω F) ^ condExpChar F K ψ_K := by
    unfold tateEps
    rw [if_pos hcond_1K, MonoidHom.one_apply, Units.val_one, mul_one]
  have hν₁_0 : ν₁ ^ 0 = 1 := MonoidHom.ext fun x => by simp
  have hν₁_1 : ν₁ ^ 1 = ν₁ := MonoidHom.ext fun x => by simp
  have h1_χ' : 1 * χ' = χ' := MonoidHom.ext fun x => by simp
  have hprod_LHS :
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
      (qL F L : Ω F) ^ condExpChar F L ψ * tateEps F L ν₁ ψ := by
    rw [hp_eq2, Finset.prod_range_succ, Finset.prod_range_one, hν₁_0, hν₁_1, htate_1L]
  have hprod_RHS :
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) =
      tateEps F L χ' ψ * tateEps F L (ν₁ * χ') ψ := by
    rw [hp_eq2, Finset.prod_range_succ, Finset.prod_range_one, hν₁_0, h1_χ', hν₁_1]
  
  have hEps_ν₁ :
      tateEps F L ν₁ ψ =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        (Fintype.card k_L : Ω F) ^ d *
        (ν₁ c_τ : Ω F) *
        ψ A *
        (∑ x : k_L, H_τ x) := by
    have h := ((hStat L ψ hψ ν₁ hb_ge2).2 c_τ hc_τ_val hc_τ_stat).2 R_L δ_τ
      hRL_int hRL_sep hRL_surj hδτ_val
    rw [h.2 hb_odd, hRL_card, hS_τ]
  
  have hEps_χ' :
      tateEps F L χ' ψ =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        (Fintype.card k_L : Ω F) ^ d *
        (χ' c_χ : Ω F) *
        ψ (((c_χ⁻¹ : Lˣ) : L)) *
        (∑ y : k_L, H_χ y) := by
    have hχ_ge2 : 2 ≤ condExp F L χ' := by omega
    have hδχ_val' : valL F L (δ_χ : L) = ((condExp F L χ' / 2 : ℕ) : ℤ) := by
      rw [hab_eq]; exact hδχ_val
    have hχ_odd : condExp F L χ' % 2 = 1 := by rw [hab_eq]; exact hb_odd
    have h := ((hStat L ψ hψ χ' hχ_ge2).2 c_χ hc_χ_val hc_χ_stat).2 R_L δ_χ
      hRL_int hRL_sep hRL_surj hδχ_val'
    have h2 := h.2 hχ_odd
    rw [hab_eq, hRL_card, hS_χ] at h2
    exact h2
  
  have hEps_twist :
      tateEps F L (ν₁ * χ') ψ =
      (qL F L : Ω F) ^ condExpChar F L ψ *
        (Fintype.card k_L : Ω F) ^ d *
        ((ν₁ * χ') (c_twist 1) : Ω F) *
        ψ ((((c_twist 1)⁻¹ : Lˣ) : L)) *
        (∑ w : k_L, H_χ (ρ * w) * H_τ w) := by
    have h1_lt_p : 1 < Module.finrank L (IntermediateField.extendScalars hLK) := by omega
    have hcond_tw : condExp F L (ν₁ * χ') = b := by
      have h := htwist_cond 1 h1_lt_p zero_lt_one
      rwa [hν₁_1] at h
    have htw_ge2 : 2 ≤ condExp F L (ν₁ * χ') := by omega
    rcases (hc_ν_twist 1 h1_lt_p zero_lt_one).2.2 with ⟨hc_tw_val, hc_tw_stat⟩
    have hc_tw_val' : valL F L (c_twist 1 : L) = (condExp F L (ν₁ * χ') : ℤ) + condExpChar F L ψ := by
      rw [hcond_tw]; exact hc_tw_val
    have hc_tw_stat' : ∀ x : L, (x = 0 ∨ (((condExp F L (ν₁ * χ') + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ * χ') (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_twist 1)⁻¹ : Lˣ) : L) * x) := by
      intro x hx h1x
      rw [hcond_tw] at hx
      have h := hc_tw_stat x hx h1x
      rwa [hν₁_1] at h
    have hδτ_val' : valL F L (δ_τ : L) = ((condExp F L (ν₁ * χ') / 2 : ℕ) : ℤ) := by
      rw [hcond_tw]; exact hδτ_val
    have htw_odd : condExp F L (ν₁ * χ') % 2 = 1 := by rw [hcond_tw]; exact hb_odd
    have h := ((hStat L ψ hψ (ν₁ * χ') htw_ge2).2 (c_twist 1) hc_tw_val' hc_tw_stat').2 R_L δ_τ
      hRL_int hRL_sep hRL_surj hδτ_val'
    have h2 := h.2 htw_odd
    rw [hcond_tw, hRL_card, hS_twist] at h2
    exact h2
  
  have hEps_χK :
      tateEps F K χ'_K ψ_K =
      (qL F K : Ω F) ^ condExpChar F K ψ_K *
        (Fintype.card k_L : Ω F) ^ d *
        (χ'_K c_χK : Ω F) *
        ψ_K (((c_χK⁻¹ : Kˣ) : K)) *
        (∑ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) := by
    have hcond_χK : condExp F K χ'_K = b := haK.trans hab_eq
    have hχK_ge2 : 2 ≤ condExp F K χ'_K := by omega
    have hc_χK_val' : valL F K (c_χK : K) = (condExp F K χ'_K : ℤ) + condExpChar F K ψ_K := by
      rw [haK]; exact hc_χK_val
    have hc_χK_stat' : ∀ y : K, (y = 0 ∨ (((condExp F K χ'_K + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
        ∀ hy : 1 + y ≠ 0,
          (χ'_K (Units.mk0 (1 + y) hy) : Ω F) = ψ_K (((c_χK⁻¹ : Kˣ) : K) * y) := by
      rw [haK]; exact hc_χK_stat
    have hδK_val' : valL F K (δ_K : K) = ((condExp F K χ'_K / 2 : ℕ) : ℤ) := by
      rw [hcond_χK]; exact hδK_val
    have hχK_odd : condExp F K χ'_K % 2 = 1 := by rw [hcond_χK]; exact hb_odd
    have h := ((hStat K ψ_K hψK χ'_K hχK_ge2).2 c_χK hc_χK_val' hc_χK_stat').2 R_K δ_K
      hRK_int hRK_sep hRK_surj hδK_val'
    have h2 := h.2 hχK_odd
    rw [hcond_χK, hRK_card, hS_K] at h2
    exact h2
  
  rw [hprod_LHS, hprod_RHS, htate_1K, hEps_χK, hEps_ν₁, hEps_χ', hEps_twist]
  dsimp only at hChar2Ident
  let P_0 : Ω F :=
    (qL F K : Ω F) ^ condExpChar F K ψ_K *
      ((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
      ((Fintype.card k_L : Ω F) ^ d) ^ 2
  let M_RHS : Ω F :=
    (χ' c_χ : Ω F) * ((ν₁ * χ') (c_twist 1) : Ω F) *
      ψ (((c_χ⁻¹ : Lˣ) : L)) * ψ ((((c_twist 1)⁻¹ : Lˣ) : L))
  calc ((qL F K : Ω F) ^ condExpChar F K ψ_K *
          (Fintype.card k_L : Ω F) ^ d *
          (χ'_K c_χK : Ω F) *
          ψ_K (((c_χK⁻¹ : Kˣ) : K)) *
          (∑ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z))) *
        ((qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F L : Ω F) ^ condExpChar F L ψ *
            (Fintype.card k_L : Ω F) ^ d *
            (ν₁ c_τ : Ω F) *
            ψ A *
            (∑ x : k_L, H_τ x)))
      = P_0 *
          ((χ'_K c_χK : Ω F) * (ν₁ c_τ : Ω F) * ψ_K (((c_χK⁻¹ : Kˣ) : K)) * ψ A) *
          (∑ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) *
          (∑ x : k_L, H_τ x) := by dsimp [P_0]; ring
    _ = P_0 *
          (M_RHS * (H_χ B * H_τ C * ψ₀ C)) *
          (∑ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) *
          (∑ x : k_L, H_τ x) := by rw [hPrefactor]
    _ = P_0 * M_RHS *
          (H_χ B * H_τ C * ψ₀ C *
            (∑ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) *
            (∑ x : k_L, H_τ x)) := by ring
    _ = P_0 * M_RHS *
          ((∑ y : k_L, H_χ y) * (∑ w : k_L, H_χ (ρ * w) * H_τ w)) := by rw [hChar2Ident]
    _ = (qL F K : Ω F) ^ condExpChar F K ψ_K *
          (((qL F L : Ω F) ^ condExpChar F L ψ *
              (Fintype.card k_L : Ω F) ^ d *
              (χ' c_χ : Ω F) *
              ψ (((c_χ⁻¹ : Lˣ) : L)) *
              (∑ y : k_L, H_χ y)) *
            ((qL F L : Ω F) ^ condExpChar F L ψ *
              (Fintype.card k_L : Ω F) ^ d *
              ((ν₁ * χ') (c_twist 1) : Ω F) *
              ψ ((((c_twist 1)⁻¹ : Lˣ) : L)) *
              (∑ w : k_L, H_χ (ρ * w) * H_τ w))) := by dsimp [P_0, M_RHS]; ring

theorem ld_dyadic_boundary_char2_translation_identity (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L : Type u) [Field k_L] [Fintype k_L]
    (hchar2 : (2 : k_L) = 0)
    (ψ₀ H_τ H_χ : k_L → Ω F)
    (hψ₀_0 : ψ₀ 0 = 1)
    (hψ₀_add : ∀ x y : k_L, ψ₀ (x + y) = ψ₀ x * ψ₀ y)
    (hψ₀_sq : ∀ x : k_L, ψ₀ (x ^ 2) = ψ₀ x)
    (hψ₀_ne1 : ∃ x₀ : k_L, ψ₀ x₀ ≠ 1)
    (hHτ_0 : H_τ 0 = 1)
    (hHτ_add : ∀ x y : k_L, H_τ (x + y) = H_τ x * H_τ y * ψ₀ (x * y))
    (hHχ_0 : H_χ 0 = 1)
    (hHχ_add : ∀ x y : k_L, H_χ (x + y) = H_χ x * H_χ y * ψ₀ (x * y))
    (ρ : k_L) (hρ_ne0 : ρ ≠ 0) (hρ_ne1 : 1 + ρ ≠ 0) :
    let B := ρ ^ 2 / (1 + ρ) ^ 2
    let C := ρ / (1 + ρ) ^ 2
    H_χ B * H_τ C * ψ₀ C *
      (∑ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) *
      (∑ x : k_L, H_τ x) =
    (∑ y : k_L, H_χ y) * (∑ w : k_L, H_χ (ρ * w) * H_τ w) :=
by
  intro B C
  have hadd_self : ∀ x : k_L, x + x = 0 := by
    intro x
    calc x + x = (1 + 1 : k_L) * x := by ring
      _ = (2 : k_L) * x := by norm_num
      _ = 0 := by rw [hchar2, zero_mul]
  have hneg_eq : ∀ x : k_L, -x = x := by
    intro x
    exact neg_eq_iff_add_eq_zero.mpr (hadd_self x)
  have hsub_eq : ∀ x y : k_L, x - y = x + y := by
    intro x y
    rw [sub_eq_add_neg, hneg_eq]
  have h1_add_ρ_sq : (1 + ρ) ^ 2 = 1 + ρ ^ 2 := by
    calc (1 + ρ) ^ 2 = 1 + ρ ^ 2 + (2 : k_L) * ρ := by ring
      _ = 1 + ρ ^ 2 := by rw [hchar2, zero_mul, add_zero]
  have hψ₀_self : ∀ x : k_L, ψ₀ x * ψ₀ x = 1 := by
    intro x
    rw [← hψ₀_add, hadd_self, hψ₀_0]
  have hHτ_self : ∀ x : k_L, H_τ x * H_τ x * ψ₀ x = 1 := by
    intro x
    have hx2 : ψ₀ (x * x) = ψ₀ x := by rw [← sq, hψ₀_sq]
    calc H_τ x * H_τ x * ψ₀ x = H_τ x * H_τ x * ψ₀ (x * x) := by rw [hx2]
      _ = H_τ (x + x) := (hHτ_add x x).symm
      _ = 1 := by rw [hadd_self, hHτ_0]
  have hHχ_self : ∀ x : k_L, H_χ x * H_χ x * ψ₀ x = 1 := by
    intro x
    have hx2 : ψ₀ (x * x) = ψ₀ x := by rw [← sq, hψ₀_sq]
    calc H_χ x * H_χ x * ψ₀ x = H_χ x * H_χ x * ψ₀ (x * x) := by rw [hx2]
      _ = H_χ (x + x) := (hHχ_add x x).symm
      _ = 1 := by rw [hadd_self, hHχ_0]
  have hψ₀_artin : ∀ w : k_L, ψ₀ (w + w ^ 2) = 1 := by
    intro w
    rw [hψ₀_add, hψ₀_sq, hψ₀_self]
  let ϕ : k_L → Ω F := fun x => H_χ x * H_τ x * ψ₀ x
  have hϕ_0 : ϕ 0 = 1 := by
    dsimp [ϕ]
    rw [hHχ_0, hHτ_0, hψ₀_0, mul_one, mul_one]
  have hϕ_add : ∀ x y : k_L, ϕ (x + y) = ϕ x * ϕ y := by
    intro x y
    dsimp [ϕ]
    rw [hHχ_add, hHτ_add, hψ₀_add]
    calc H_χ x * H_χ y * ψ₀ (x * y) * (H_τ x * H_τ y * ψ₀ (x * y)) * (ψ₀ x * ψ₀ y)
      _ = (H_χ x * H_τ x * ψ₀ x) * (H_χ y * H_τ y * ψ₀ y) * (ψ₀ (x * y) * ψ₀ (x * y)) := by ring
      _ = (H_χ x * H_τ x * ψ₀ x) * (H_χ y * H_τ y * ψ₀ y) * 1 := by rw [hψ₀_self]
      _ = (H_χ x * H_τ x * ψ₀ x) * (H_χ y * H_τ y * ψ₀ y) := by ring
  have hHχ_eq_ϕ : ∀ x : k_L, H_χ x = H_τ x * ϕ x := by
    intro x
    dsimp [ϕ]
    calc H_χ x = H_χ x * 1 := (mul_one _).symm
      _ = H_χ x * (H_τ x * H_τ x * ψ₀ x) := by rw [← hHτ_self x]
      _ = H_τ x * (H_χ x * H_τ x * ψ₀ x) := by ring
  have hψ₀_orth : ∀ x : k_L, x ≠ 0 → (∑ c : k_L, ψ₀ (c * x)) = 0 := by
    intro x hx
    obtain ⟨x₀, hx₀⟩ := hψ₀_ne1
    let δ : k_L := x₀ * x⁻¹
    have hshift : ∀ c : k_L, ψ₀ ((c + δ) * x) = ψ₀ x₀ * ψ₀ (c * x) := by
      intro c
      have hcx : (c + δ) * x = x₀ + c * x := by
        dsimp [δ]
        calc (c + x₀ * x⁻¹) * x = c * x + x₀ * (x⁻¹ * x) := by ring
          _ = c * x + x₀ * 1 := by rw [inv_mul_cancel₀ hx]
          _ = x₀ + c * x := by ring
      rw [hcx, hψ₀_add]
    have hsum_eq : (∑ c : k_L, ψ₀ ((c + δ) * x)) = ∑ c : k_L, ψ₀ (c * x) := by
      apply Fintype.sum_equiv (Equiv.addRight δ)
      intro c
      simp only [Equiv.coe_addRight]
    have hsum_mul : (∑ c : k_L, ψ₀ ((c + δ) * x)) = ψ₀ x₀ * (∑ c : k_L, ψ₀ (c * x)) := by
      simp_rw [hshift]
      rw [← Finset.mul_sum]
    have hzero : (ψ₀ x₀ - 1) * (∑ c : k_L, ψ₀ (c * x)) = 0 := by
      calc (ψ₀ x₀ - 1) * (∑ c : k_L, ψ₀ (c * x))
        _ = ψ₀ x₀ * (∑ c : k_L, ψ₀ (c * x)) - (∑ c : k_L, ψ₀ (c * x)) := by ring
        _ = (∑ c : k_L, ψ₀ ((c + δ) * x)) - (∑ c : k_L, ψ₀ (c * x)) := by rw [← hsum_mul]
        _ = 0 := by rw [hsum_eq, sub_self]
    exact (mul_eq_zero.mp hzero).resolve_left (sub_ne_zero.mpr hx₀)
  let S : k_L → Ω F := fun c => ∑ x : k_L, ϕ x * ψ₀ (c * x)
  have hsum_S : (∑ c : k_L, S c) = (Fintype.card k_L : Ω F) := by
    dsimp [S]
    rw [Finset.sum_comm]
    have hinner : ∀ x : k_L, (∑ c : k_L, ϕ x * ψ₀ (c * x)) = ϕ x * (∑ c : k_L, ψ₀ (c * x)) := by
      intro x
      rw [← Finset.mul_sum]
    simp_rw [hinner]
    rw [Finset.sum_eq_single (0 : k_L)]
    · simp only [mul_zero, hϕ_0, hψ₀_0, one_mul, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
    · intro x _ hx0
      rw [hψ₀_orth x hx0, mul_zero]
    · intro h0
      exact False.elim (h0 (Finset.mem_univ 0))
  have hsum_S_ne0 : (∑ c : k_L, S c) ≠ 0 := by
    rw [hsum_S]
    exact Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  obtain ⟨c, _, hc_ne0⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum_S_ne0
  have hHχ_fourier : ∀ y : k_L, H_χ y = H_τ y * ψ₀ (c * y) := by
    intro y
    have hSc_shift : (∑ x : k_L, ϕ (x + y) * ψ₀ (c * (x + y))) = S c := by
      apply Fintype.sum_equiv (Equiv.addRight y)
      intro x
      simp only [Equiv.coe_addRight]
    have hterm : ∀ x : k_L, ϕ (x + y) * ψ₀ (c * (x + y)) =
        (ϕ y * ψ₀ (c * y)) * (ϕ x * ψ₀ (c * x)) := by
      intro x
      have hcy : c * (x + y) = c * x + c * y := by ring
      rw [hϕ_add, hcy, hψ₀_add]
      ring
    have hSc_mul : (ϕ y * ψ₀ (c * y)) * S c = S c := by
      calc (ϕ y * ψ₀ (c * y)) * S c
        _ = ∑ x : k_L, (ϕ y * ψ₀ (c * y)) * (ϕ x * ψ₀ (c * x)) := by
          dsimp [S]
          rw [Finset.mul_sum]
        _ = ∑ x : k_L, ϕ (x + y) * ψ₀ (c * (x + y)) := by simp_rw [← hterm]
        _ = S c := hSc_shift
    have hϕ_ψ : ϕ y * ψ₀ (c * y) = 1 := (mul_left_eq_self₀.mp hSc_mul).resolve_right hc_ne0
    have hϕ_eq : ϕ y = ψ₀ (c * y) := by
      calc ϕ y = ϕ y * 1 := (mul_one _).symm
        _ = ϕ y * (ψ₀ (c * y) * ψ₀ (c * y)) := by rw [← hψ₀_self (c * y)]
        _ = (ϕ y * ψ₀ (c * y)) * ψ₀ (c * y) := by ring
        _ = 1 * ψ₀ (c * y) := by rw [hϕ_ψ]
        _ = ψ₀ (c * y) := one_mul _
    rw [hHχ_eq_ϕ y, hϕ_eq]
  have hSum_χ : (∑ y : k_L, H_χ y) = H_τ c * ψ₀ c * (∑ x : k_L, H_τ x) := by
    have hshift_χ : ∀ y : k_L, H_χ y = (H_τ c * ψ₀ c) * H_τ (y + c) := by
      intro y
      have h1 : H_τ (y + c) = H_τ c * H_χ y := by
        rw [hHτ_add y c, mul_comm y c, hHχ_fourier y]
        ring
      calc H_χ y = 1 * H_χ y := (one_mul _).symm
        _ = (H_τ c * H_τ c * ψ₀ c) * H_χ y := by rw [← hHτ_self c]
        _ = (H_τ c * ψ₀ c) * (H_τ c * H_χ y) := by ring
        _ = (H_τ c * ψ₀ c) * H_τ (y + c) := by rw [← h1]
    simp_rw [hshift_χ, ← Finset.mul_sum]
    congr 1
    apply Fintype.sum_equiv (Equiv.addRight c)
    intro y
    simp only [Equiv.coe_addRight]
  let Q : k_L → Ω F := fun w => H_χ (ρ * w) * H_τ w
  let a_star : k_L := c / (1 + ρ) + C
  have ha_star_lin : (1 + ρ ^ 2) * a_star = c + c * ρ + ρ := by
    rw [← h1_add_ρ_sq]
    dsimp [a_star, C]
    field_simp [hρ_ne1]
  have hQ_shift : ∀ z : k_L, Q (z + a_star) = Q a_star * (H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) := by
    intro z
    have hρ_add : ρ * (z + a_star) = ρ * z + ρ * a_star := by ring
    have h_quad : (ρ * z) * (ρ * a_star) + z * a_star = c * z + c * (ρ * z) + ρ * z := by
      calc (ρ * z) * (ρ * a_star) + z * a_star
        _ = ((1 + ρ ^ 2) * a_star) * z := by ring
        _ = (c + c * ρ + ρ) * z := by rw [ha_star_lin]
        _ = c * z + c * (ρ * z) + ρ * z := by ring
    have hψ_quad : ψ₀ ((ρ * z) * (ρ * a_star)) * ψ₀ (z * a_star) =
        ψ₀ (c * z) * ψ₀ (c * (ρ * z)) * ψ₀ (ρ * z) := by
      rw [← hψ₀_add, h_quad, hψ₀_add, hψ₀_add]
    have hHχ_ρz : H_χ (ρ * z) * H_τ z * (ψ₀ (c * z) * ψ₀ (c * (ρ * z)) * ψ₀ (ρ * z)) =
        H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z) := by
      rw [hHχ_fourier (ρ * z), hHχ_fourier z]
      calc H_τ (ρ * z) * ψ₀ (c * (ρ * z)) * H_τ z * (ψ₀ (c * z) * ψ₀ (c * (ρ * z)) * ψ₀ (ρ * z))
        _ = H_τ z * ψ₀ (c * z) * H_τ (ρ * z) * ψ₀ (ρ * z) * (ψ₀ (c * (ρ * z)) * ψ₀ (c * (ρ * z))) := by ring
        _ = H_τ z * ψ₀ (c * z) * H_τ (ρ * z) * ψ₀ (ρ * z) * 1 := by rw [hψ₀_self]
        _ = H_τ z * ψ₀ (c * z) * H_τ (ρ * z) * ψ₀ (ρ * z) := by ring
    dsimp [Q]
    rw [hρ_add, hHχ_add, hHτ_add]
    calc H_χ (ρ * z) * H_χ (ρ * a_star) * ψ₀ (ρ * z * (ρ * a_star)) *
          (H_τ z * H_τ a_star * ψ₀ (z * a_star))
      _ = (H_χ (ρ * a_star) * H_τ a_star) *
          (H_χ (ρ * z) * H_τ z * (ψ₀ (ρ * z * (ρ * a_star)) * ψ₀ (z * a_star))) := by ring
      _ = (H_χ (ρ * a_star) * H_τ a_star) *
          (H_χ (ρ * z) * H_τ z * (ψ₀ (c * z) * ψ₀ (c * (ρ * z)) * ψ₀ (ρ * z))) := by rw [hψ_quad]
      _ = (H_χ (ρ * a_star) * H_τ a_star) * (H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) := by rw [hHχ_ρz]
  let Q_inv : Ω F := H_τ (ρ * a_star) * H_τ a_star * ψ₀ (a_star + ρ * a_star + c * (ρ * a_star))
  have hQ_inv : Q a_star * Q_inv = 1 := by
    dsimp [Q, Q_inv]
    rw [hHχ_fourier (ρ * a_star), hψ₀_add, hψ₀_add]
    calc H_τ (ρ * a_star) * ψ₀ (c * (ρ * a_star)) * H_τ a_star *
          (H_τ (ρ * a_star) * H_τ a_star * (ψ₀ a_star * ψ₀ (ρ * a_star) * ψ₀ (c * (ρ * a_star))))
      _ = (H_τ (ρ * a_star) * H_τ (ρ * a_star) * ψ₀ (ρ * a_star)) *
          (H_τ a_star * H_τ a_star * ψ₀ a_star) *
          (ψ₀ (c * (ρ * a_star)) * ψ₀ (c * (ρ * a_star))) := by ring
      _ = 1 * 1 * 1 := by rw [hHτ_self (ρ * a_star), hHτ_self a_star, hψ₀_self (c * (ρ * a_star))]
      _ = 1 := by ring
  have hSum_K : (∑ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) =
      Q_inv * (∑ w : k_L, H_χ (ρ * w) * H_τ w) := by
    have hterm_K : ∀ z : k_L, H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z) = Q_inv * Q (z + a_star) := by
      intro z
      calc H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)
        _ = 1 * (H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) := (one_mul _).symm
        _ = (Q a_star * Q_inv) * (H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z)) := by rw [← hQ_inv]
        _ = Q_inv * (Q a_star * (H_χ z * H_τ (ρ * z) * ψ₀ (ρ * z))) := by ring
        _ = Q_inv * Q (z + a_star) := by rw [← hQ_shift z]
    simp_rw [hterm_K, ← Finset.mul_sum]
    congr 1
    apply Fintype.sum_equiv (Equiv.addRight a_star)
    intro z
    simp only [Equiv.coe_addRight, Q]
  let w_as : k_L := c * ρ / (1 + ρ)
  have h_uv_sum : (a_star + B) + (ρ * a_star + C) = c := by
    have h1 : (1 + ρ) * ((a_star + B) + (ρ * a_star + C) - c) = 0 := by
      dsimp [a_star, B, C]
      calc (1 + ρ) * ((c / (1 + ρ) + ρ / (1 + ρ) ^ 2 + ρ ^ 2 / (1 + ρ) ^ 2) +
            (ρ * (c / (1 + ρ) + ρ / (1 + ρ) ^ 2) + ρ / (1 + ρ) ^ 2) - c)
        _ = (2 : k_L) * ρ := by
          field_simp [hρ_ne1]
          ring
        _ = 0 := by rw [hchar2, zero_mul]
    exact sub_eq_zero.mp ((mul_eq_zero.mp h1).resolve_left hρ_ne1)
  have h_aB_eq : a_star * B = ρ * a_star * C := by
    dsimp [B, C]
    ring
  have h_a_lin : a_star + ρ * a_star = c + B + C := by
    dsimp [a_star, B, C]
    field_simp [hρ_ne1]
    ring
  have h_cra_eq : c * (ρ * a_star) = c * w_as + c * B := by
    dsimp [a_star, B, C, w_as]
    field_simp [hρ_ne1]
  have h_uv_prod : (a_star + B) * (ρ * a_star + C) = B + c * w_as + (w_as + w_as ^ 2) := by
    rw [← hsub_eq w_as (w_as ^ 2)]
    dsimp [a_star, B, C, w_as]
    field_simp [hρ_ne1]
    ring
  have hHτ_aB : H_τ a_star * H_τ B = H_τ (a_star + B) * ψ₀ (a_star * B) := by
    rw [hHτ_add a_star B]
    calc H_τ a_star * H_τ B = H_τ a_star * H_τ B * 1 := (mul_one _).symm
      _ = H_τ a_star * H_τ B * (ψ₀ (a_star * B) * ψ₀ (a_star * B)) := by rw [← hψ₀_self]
      _ = H_τ a_star * H_τ B * ψ₀ (a_star * B) * ψ₀ (a_star * B) := by ring
  have hHτ_raC : H_τ (ρ * a_star) * H_τ C = H_τ (ρ * a_star + C) * ψ₀ (a_star * B) := by
    have h1 : H_τ (ρ * a_star) * H_τ C = H_τ (ρ * a_star + C) * ψ₀ (ρ * a_star * C) := by
      rw [hHτ_add (ρ * a_star) C]
      calc H_τ (ρ * a_star) * H_τ C = H_τ (ρ * a_star) * H_τ C * 1 := (mul_one _).symm
        _ = H_τ (ρ * a_star) * H_τ C * (ψ₀ (ρ * a_star * C) * ψ₀ (ρ * a_star * C)) := by rw [← hψ₀_self]
        _ = H_τ (ρ * a_star) * H_τ C * ψ₀ (ρ * a_star * C) * ψ₀ (ρ * a_star * C) := by ring
    rw [h1, ← h_aB_eq]
  have hHτ_four : H_τ B * H_τ C * H_τ (ρ * a_star) * H_τ a_star =
      H_τ c * ψ₀ B * ψ₀ (c * w_as) := by
    have h_prod : H_τ (a_star + B) * H_τ (ρ * a_star + C) =
        H_τ c * ψ₀ ((a_star + B) * (ρ * a_star + C)) := by
      have h_add := hHτ_add (a_star + B) (ρ * a_star + C)
      rw [h_uv_sum] at h_add
      calc H_τ (a_star + B) * H_τ (ρ * a_star + C)
        _ = H_τ (a_star + B) * H_τ (ρ * a_star + C) * 1 := (mul_one _).symm
        _ = H_τ (a_star + B) * H_τ (ρ * a_star + C) *
            (ψ₀ ((a_star + B) * (ρ * a_star + C)) * ψ₀ ((a_star + B) * (ρ * a_star + C))) := by
          rw [← hψ₀_self]
        _ = (H_τ (a_star + B) * H_τ (ρ * a_star + C) * ψ₀ ((a_star + B) * (ρ * a_star + C))) *
            ψ₀ ((a_star + B) * (ρ * a_star + C)) := by ring
        _ = H_τ c * ψ₀ ((a_star + B) * (ρ * a_star + C)) := by rw [← h_add]
    have h_ψ_prod : ψ₀ ((a_star + B) * (ρ * a_star + C)) = ψ₀ B * ψ₀ (c * w_as) := by
      rw [h_uv_prod, hψ₀_add, hψ₀_add, hψ₀_artin w_as, mul_one]
    calc H_τ B * H_τ C * H_τ (ρ * a_star) * H_τ a_star
      _ = (H_τ a_star * H_τ B) * (H_τ (ρ * a_star) * H_τ C) := by ring
      _ = (H_τ (a_star + B) * ψ₀ (a_star * B)) * (H_τ (ρ * a_star + C) * ψ₀ (a_star * B)) := by
        rw [hHτ_aB, hHτ_raC]
      _ = (H_τ (a_star + B) * H_τ (ρ * a_star + C)) * (ψ₀ (a_star * B) * ψ₀ (a_star * B)) := by ring
      _ = (H_τ (a_star + B) * H_τ (ρ * a_star + C)) * 1 := by rw [hψ₀_self]
      _ = H_τ c * ψ₀ ((a_star + B) * (ρ * a_star + C)) := by rw [mul_one, h_prod]
      _ = H_τ c * (ψ₀ B * ψ₀ (c * w_as)) := by rw [h_ψ_prod]
      _ = H_τ c * ψ₀ B * ψ₀ (c * w_as) := by ring
  have hψ_Qinv : ψ₀ (a_star + ρ * a_star + c * (ρ * a_star)) =
      ψ₀ c * ψ₀ B * ψ₀ C * ψ₀ (c * w_as) * ψ₀ (c * B) := by
    rw [h_a_lin, h_cra_eq, hψ₀_add, hψ₀_add, hψ₀_add, hψ₀_add]
    ring
  have hPref_eq : H_χ B * H_τ C * ψ₀ C * Q_inv = H_τ c * ψ₀ c := by
    dsimp [Q_inv]
    rw [hHχ_fourier B, hψ_Qinv]
    calc H_τ B * ψ₀ (c * B) * H_τ C * ψ₀ C *
          (H_τ (ρ * a_star) * H_τ a_star * (ψ₀ c * ψ₀ B * ψ₀ C * ψ₀ (c * w_as) * ψ₀ (c * B)))
      _ = (H_τ B * H_τ C * H_τ (ρ * a_star) * H_τ a_star) * ψ₀ c * ψ₀ B * ψ₀ (c * w_as) *
          (ψ₀ C * ψ₀ C) * (ψ₀ (c * B) * ψ₀ (c * B)) := by ring
      _ = (H_τ c * ψ₀ B * ψ₀ (c * w_as)) * ψ₀ c * ψ₀ B * ψ₀ (c * w_as) * 1 * 1 := by
        rw [hHτ_four, hψ₀_self C, hψ₀_self (c * B)]
      _ = H_τ c * ψ₀ c * (ψ₀ B * ψ₀ B) * (ψ₀ (c * w_as) * ψ₀ (c * w_as)) := by ring
      _ = H_τ c * ψ₀ c * 1 * 1 := by rw [hψ₀_self B, hψ₀_self (c * w_as)]
      _ = H_τ c * ψ₀ c := by ring
  rw [hSum_K, hSum_χ]
  calc H_χ B * H_τ C * ψ₀ C * (Q_inv * ∑ w : k_L, H_χ (ρ * w) * H_τ w) * ∑ x : k_L, H_τ x
    _ = (H_χ B * H_τ C * ψ₀ C * Q_inv) * (∑ w : k_L, H_χ (ρ * w) * H_τ w) * (∑ x : k_L, H_τ x) := by ring
    _ = (H_τ c * ψ₀ c) * (∑ w : k_L, H_χ (ρ * w) * H_τ w) * (∑ x : k_L, H_τ x) := by rw [hPref_eq]
    _ = H_τ c * ψ₀ c * (∑ x : k_L, H_τ x) * (∑ w : k_L, H_χ (ρ * w) * H_τ w) := by ring

theorem ld_wild_low_cond_dyadic_boundary_case (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_eq2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (hab_eq : condExp F L χ' = condExp F L ν₁)
    (hb_odd : condExp F L ν₁ % 2 = 1)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁)
    (haddVal1 : addVal F 1 = 0)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (w_star : Kˣ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (hw_star_t : w_star ∈ unitGroup F K t)
    (hw_star_nt1 : w_star ∉ unitGroup F K (t + 1))
    (hw_star_norm : Units.map (normLM F hLK) w_star = 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (htr_surj : ∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x +
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (R_L : Finset L) (R_K : Finset K) (c_τ : Lˣ) (u : Kˣ) (N : Lˣ)
    (τ_unit τ_tilde : ℕ → Lˣ) (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRK_card : R_K.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hRK_int : ∀ r ∈ R_K, r = 0 ∨ 0 ≤ valL F K r)
    (hRK_sep : ∀ r₁ ∈ R_K, ∀ r₂ ∈ R_K, r₁ ≠ r₂ → valL F K (r₁ - r₂) = 0)
    (hRK_surj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → ∃ r ∈ R_K, y - r = 0 ∨ 1 ≤ valL F K (y - r))
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x))
    (hu_norm : Units.map (normLM F hLK) u = N)
    (hu_val : valL F K (u : K) = 0)
    (hN_val : valL F L (N : L) = 0)
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hc_χK_inv : ((c_χK⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
        (IntermediateField.inclusion hLK (N : L) - (u : K)))
    (hτ_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L ν₁)) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
