            (-1 : K₁) ^ (i - 1) * IntermediateField.inclusion hM₁'K₁ (s₁ w i) *
              w ^ (Module.finrank L (IntermediateField.extendScalars hLE') - i) := by
    simpa only [hdegM₁'K₁] using hs₁_cayley_deg
  have hs₁_newton : ∀ (w : K₁) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      (-1 : M₁') ^ (r - 1) * ((r : ℕ) : M₁') * s₁ w r - traceLM F hM₁'K₁ (w ^ r) =
