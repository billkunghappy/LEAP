      have hδ_E : δ_E = 0 ∨ 1 ≤ valL F E δ_E := by
        have h := hval_mul_ge E 0 1 ((u_x₀E⁻¹ : Eˣ) : E) (y₀ - IntermediateField.inclusion hLE x₀)
          (Or.inr (by rw [hu_x₀E_inv_val0])) hyx₀
        simpa [δ_E] using h
