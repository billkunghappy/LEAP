    rw [hψ_zE, hres_zE]
  let w₀_fn : K → L := fun r =>
    if hr : PK 0 r then (hOK_decomp r hr).choose else 0
  let ϕ_K : K → k_L := fun r => resL (w₀_fn r)
  have hw₀_spec : ∀ r ∈ R_K,
      P 0 (w₀_fn r) ∧ PK 1 (r - IntermediateField.inclusion hLK (w₀_fn r)) := by
    intro r hr
    have hr_int : PK 0 r := hRK_int r hr
    dsimp only [w₀_fn]
    rw [dif_pos hr_int]
    exact (hOK_decomp r hr_int).choose_spec
  have hϕK_inj : Set.InjOn ϕ_K R_K := by
    intro r₁ hr₁ r₂ hr₂ hϕ_eq
    by_contra hr_ne
    have hval0_sub : valL F K (r₁ - r₂) = 0 := hRK_sep r₁ hr₁ r₂ hr₂ hr_ne
    have hw₁ := hw₀_spec r₁ hr₁
    have hw₂ := hw₀_spec r₂ hr₂
    have hw12_P1 : P 1 (w₀_fn r₁ - w₀_fn r₂) :=
      (hresL_sub_mem1 hw₁.1 hw₂.1).mp hϕ_eq
    have hinc12_PK1 : PK 1
        (IntermediateField.inclusion hLK (w₀_fn r₁) -
          IntermediateField.inclusion hLK (w₀_fn r₂)) := by
      rw [← map_sub]
      exact hPK_mono (by omega) (hPK_incl hw12_P1)
    have hr12_PK1 : PK 1 (r₁ - r₂) := by
      have h_eq : r₁ - r₂ =
          ((r₁ - IntermediateField.inclusion hLK (w₀_fn r₁)) -
            (r₂ - IntermediateField.inclusion hLK (w₀_fn r₂))) +
            (IntermediateField.inclusion hLK (w₀_fn r₁) -
              IntermediateField.inclusion hLK (w₀_fn r₂)) :=
        (fun a b c d : K => by ring : ∀ a b c d : K, a - b = ((a - c) - (b - d)) + (c - d))
          r₁ r₂ (IntermediateField.inclusion hLK (w₀_fn r₁))
          (IntermediateField.inclusion hLK (w₀_fn r₂))
      rw [h_eq]
      exact hPK_add (hPK_sub hw₁.2 hw₂.2) hinc12_PK1
    rcases hr12_PK1 with hsub0 | hval1_sub
    · exact hr_ne (sub_eq_zero.mp hsub0)
    · omega
  have hϕK_image : R_K.image ϕ_K = Finset.univ := by
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Finset.card_image_of_injOn hϕK_inj, hRK_card]
  have hϕK_surj : ∀ Z ∈ (Finset.univ : Finset k_L), ∃ r ∈ R_K, ϕ_K r = Z := by
    intro Z hZ
    rw [← hϕK_image] at hZ
    exact Finset.mem_image.mp hZ
  have hS_K_polar : (∑ r ∈ R_K, T_K r) =
      (∑ Z : k_L,
        H_χ (Z ^ p) * (H_τ (d₀ * Z ^ p))⁻¹ *
          ψ₀ ((2 : k_L)⁻¹ * μ * (d₀ - ζ ^ 2) * Z ^ 2)) := by
    refine Finset.sum_bij (fun r _ => ϕ_K r) ?_ ?_ ?_ ?_
    · intro r _; exact Finset.mem_univ _
    · intro r₁ hr₁ r₂ hr₂ heq; exact hϕK_inj hr₁ hr₂ heq
    · intro Z hZ
      obtain ⟨r, hr, hZ_eq⟩ := hϕK_surj Z hZ
      exact ⟨r, hr, hZ_eq⟩
    · intro r hr
      have hw := hw₀_spec r hr
      have hw_inc : PK 0 (IntermediateField.inclusion hLK (w₀_fn r)) := by
        have h1 := hPK_incl hw.1
        rwa [mul_zero] at h1
      rw [hTK_congr (hRK_int r hr) hw_inc hw.2,
        hTK_polar_E (w₀_fn r) hw.1, hquad_phase_eval (w₀_fn r) hw.1]
  exact ⟨hfrob_kL, ζ, hd₀_eq, hd₀_shift, hS_K_polar⟩

theorem ld_wild_odd_prime_hasse_sums_to_residue_quad (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_ne2 : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (hab_eq : condExp F L χ' = condExp F L ν₁)
    (hb_odd : condExp F L ν₁ % 2 = 1)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m)
    (R_L : Finset L) (R_K : Finset K) (c_τ : Lˣ) (u : Kˣ) (N : Lˣ)
    (τ_unit τ_tilde : ℕ → Lˣ) (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRK_card : R_K.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRK_int : ∀ r ∈ R_K, r = 0 ∨ 0 ≤ valL F K r)
    (hRK_sep : ∀ r₁ ∈ R_K, ∀ r₂ ∈ R_K, r₁ ≠ r₂ → valL F K (r₁ - r₂) = 0)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x))
    (hu_norm : Units.map (normLM F hLK) u = N)
    (hu_val : valL F K (u : K) = 0)
    (hN_val : valL F L (N : L) = 0)
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hc_χK_inv : ((c_χK⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
        (IntermediateField.inclusion hLK (N : L) - (u : K)))
    (hτ_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L ν₁)) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
      ν₁ (τ_unit j) = 1 ∧
      c_ν j = c_τ * (τ_unit j)⁻¹ ∧
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
      (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)))
    (hc_χ_val : valL F L (c_χ : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x))
    (hc_χK_val : valL F K (c_χK : K) = (condExp F L χ' : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (hc_χK_stat : ∀ y : K, (y = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * y))
    (hc_ν_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      valL F L (c_ν j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x)) ∧
      valL F L (c_twist j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
            ψ ((((c_twist j)⁻¹ : Lˣ) : L) * x)))
    (hchar_kL : (Module.finrank L (IntermediateField.extendScalars hLK) : k_L) = 0 ∧ (2 : k_L) ≠ 0)
    (hτ_mod : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      ((τ_unit j : L) - (j : L) = 0 ∨
        ((condExp F L ν₁ / 2 + 1 : ℕ) : ℤ) ≤ valL F L ((τ_unit j : L) - (j : L))) ∧
      resL (τ_unit j : L) = (j : k_L))
    (μ : k_L) (hμ_ne : μ ≠ 0)
    (hμ_res : resL (traceLM F hLK (((ϖ_K ^ t : Kˣ) : K)) * (((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) = μ)
    (hquad_err : ∀ w : K, (w = 0 ∨ ((condExp F L ν₁ / 2 : ℕ) : ℤ) ≤ valL F K w) →
      (traceLM F hLK w = 0 ∨ ((condExp F L ν₁ / 2 + 1 : ℕ) : ℤ) ≤ valL F L (traceLM F hLK w)) ∧
      ((normLM F hLK (1 + w) - 1 - traceLM F hLK w - normLM F hLK w) = 0 ∨
        ((2 * (condExp F L ν₁ / 2) : ℕ) : ℤ) ≤
          valL F L (normLM F hLK (1 + w) - 1 - traceLM F hLK w - normLM F hLK w)) ∧
      (2 * (normLM F hLK (1 + w) - 1 - traceLM F hLK w - normLM F hLK w) +
          traceLM F hLK (w ^ 2) = 0 ∨
        (condExp F L ν₁ : ℤ) ≤
          valL F L
            (2 * (normLM F hLK (1 + w) - 1 - traceLM F hLK w - normLM F hLK w) +
              traceLM F hLK (w ^ 2)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let d := condExp F L ν₁ / 2
    ∃ (ψ₀ : k_L → Ω F) (ζ d₀ B_χ B_τ C₀ : k_L),
      ψ₀ 0 = 1 ∧
      (∀ x y : k_L, ψ₀ (x + y) = ψ₀ x * ψ₀ y) ∧
      (∃ x₀ : k_L, ψ₀ x₀ ≠ 1) ∧
      (∀ y : k_L, ψ₀ (y ^ p) = ψ₀ (- μ * y)) ∧
      d₀ = ζ ^ p ∧
      (∀ j ∈ Finset.range p, d₀ + (j : k_L) ≠ 0) ∧
      C₀ ^ p = B_χ - d₀ * B_τ ∧
      (∑ r ∈ R_L,
        if hr : 1 + ((ϖ_L ^ d : Lˣ) : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
            ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * r)
        else 0) =
        (∑ x : k_L, ψ₀ ((2 : k_L)⁻¹ * d₀ * x ^ 2 + B_χ * x)) ∧
      (∀ j ∈ (Finset.range p).erase 0,
        (∑ r ∈ R_L,
          if hr : 1 + ((ϖ_L ^ d : Lˣ) : L) * r ≠ 0 then
            ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
              ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * r)
          else 0) =
          (∑ x : k_L, ψ₀ ((2 : k_L)⁻¹ * (j : k_L) * x ^ 2 + (j : k_L) * B_τ * x)) ∧
        (∑ r ∈ R_L,
          if hr : 1 + ((ϖ_L ^ d : Lˣ) : L) * r ≠ 0 then
            ((ν₁ ^ j * χ') (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
              ψ ((((c_twist j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * r)
          else 0) =
          (∑ x : k_L,
            ψ₀ ((2 : k_L)⁻¹ * (d₀ + (j : k_L)) * x ^ 2 + (B_χ + (j : k_L) * B_τ) * x))) ∧
      (∑ r ∈ R_K,
        if hr : 1 + ((ϖ_K ^ d : Kˣ) : K) * r ≠ 0 then
          ((χ'.comp (Units.map (normLM F hLK)))
            (Units.mk0 (1 + ((ϖ_K ^ d : Kˣ) : K) * r) hr) : Ω F)⁻¹ *
            (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * ((ϖ_K ^ d : Kˣ) : K) * r)
        else 0) =
        (∑ Z : k_L, ψ₀ ((2 : k_L)⁻¹ * (μ * (d₀ - ζ)) * Z ^ 2 + (- μ * C₀) * Z)) :=
by
  obtain ⟨ψ₀, H_τ, H_χ, hψ₀_spec, hHτ_spec, hHχ_spec,
    hψ₀_0, hψ₀_add, hψ₀_ne, hψ₀_frob,
    hHτ_0, hHτ_add, hHχ_0, hHχ_add, hS_χ_polar, hS_ν_twist_polar⟩ :=
    ld_wild_odd_prime_L_polar_functions_and_R_L_sums F L K hLK hPrime ψ ν₁ χ'
      hν₁_ker hb_ge2 hval_alg hab_eq hb_odd hvalL_props hvalK_props hSpecL
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t ht_ge1 hb_eq htr_bound hnorm_exp
      R_L c_τ N τ_unit τ_tilde c_ν c_twist c_χ
      hRL_card hRL_int hRL_sep hc_τ_val hc_τ_stat hN_val hc_χ_eq hτ_props
      hc_χ_val hc_χ_stat hτ_mod μ hμ_res
  obtain ⟨hfrob_kL, ζ, hd₀_eq, hd₀_shift, hS_K_polar⟩ :=
    ld_wild_odd_prime_K_hasse_sum_polar_decomp F L K hLK hPrime ψ ν₁ χ'
      hν₁_ker hb_ge2 hval_norm hval_alg hfrob_surj hab_eq hb_odd haK
      hvalL_props hvalK_props hSpecL hSpecK ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L hBasis
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t ht_ge1 hb_eq htr_bound hnorm_le
      R_K c_τ u N τ_unit τ_tilde c_ν c_twist c_χ c_χK
      hRK_card hRK_int hRK_sep hc_τ_val hc_τ_stat hu_norm hu_val hN_val hc_χ_eq hc_χK_inv
      hτ_props hc_χ_val hc_χ_stat hc_χK_val hc_χK_stat
      hchar_kL hτ_mod μ hμ_res hquad_err ψ₀ H_τ H_χ hψ₀_spec hHτ_spec hHχ_spec
  obtain ⟨B_χ, B_τ, hHτ_quad, hHχ_quad, hHτ_pow, hHτ_Hχ, hK_quad⟩ :=
    ld_wild_odd_prime_finite_field_polar_to_quad F k_L
      (Module.finrank L (IntermediateField.extendScalars hLK))
      hPrime hchar_kL.1 hchar_kL.2 ψ₀ H_τ H_χ hψ₀_0 hψ₀_add hψ₀_ne
      μ ζ (resL (N : L)) hψ₀_frob hd₀_eq hHτ_0 hHτ_add hHχ_0 hHχ_add
  obtain ⟨C₀, hC₀_pow⟩ := hfrob_kL (B_χ - resL (N : L) * B_τ)
  refine ⟨ψ₀, ζ, resL (N : L), B_χ, B_τ, C₀,
    hψ₀_0, hψ₀_add, hψ₀_ne, hψ₀_frob, hd₀_eq, hd₀_shift, hC₀_pow, ?_, ?_, ?_⟩
  · rw [hS_χ_polar]
    exact Finset.sum_congr rfl (fun x _ => hHχ_quad x)
  · intro j hj
    refine ⟨?_, ?_⟩
    · rw [(hS_ν_twist_polar j hj).1]
      exact Finset.sum_congr rfl (fun x _ => hHτ_pow j x)
    · rw [(hS_ν_twist_polar j hj).2]
      exact Finset.sum_congr rfl (fun x _ => hHτ_Hχ j x)
  · rw [hS_K_polar]
    exact Finset.sum_congr rfl (fun Z _ => hK_quad C₀ hC₀_pow Z)

theorem ld_wild_odd_prime_finite_field_pencil_identity (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (p : ℕ) (hPrime : Nat.Prime p) (hp_ne2 : p ≠ 2) (hchar : (p : k) = 0) (h2_ne : (2 : k) ≠ 0)
    (ψ₀ : k → Ω F)
    (hψ₀_0 : ψ₀ 0 = 1)
    (hψ₀_add : ∀ x y : k, ψ₀ (x + y) = ψ₀ x * ψ₀ y)
    (hψ₀_ne : ∃ x₀ : k, ψ₀ x₀ ≠ 1)
    (μ lam ζ d₀ B_χ B_τ C₀ : k)
    (hμ_ne : μ ≠ 0) (hlam_ne : lam ≠ 0)
    (hμ_eq : μ = (∏ j ∈ (Finset.range p).erase 0, (j : k)) * lam ^ (p - 1))
    (hψ₀_frob : ∀ y : k, ψ₀ (y ^ p) = ψ₀ (- μ * y))
    (hd₀_eq : d₀ = ζ ^ p)
    (hd₀_shift : ∀ j ∈ Finset.range p, d₀ + (j : k) ≠ 0)
    (hC₀_pow : C₀ ^ p = B_χ - d₀ * B_τ) :
    (∑ Z : k, ψ₀ ((2 : k)⁻¹ * (μ * (d₀ - ζ)) * Z ^ 2 + (- μ * C₀) * Z)) *
      (∏ j ∈ (Finset.range p).erase 0,
        (∑ x : k, ψ₀ ((2 : k)⁻¹ * (j : k) * x ^ 2 + (j : k) * B_τ * x))) =
    (∑ x : k, ψ₀ ((2 : k)⁻¹ * d₀ * x ^ 2 + B_χ * x)) *
      (∏ j ∈ (Finset.range p).erase 0,
        (∑ x : k,
          ψ₀ ((2 : k)⁻¹ * (d₀ + (j : k)) * x ^ 2 + (B_χ + (j : k) * B_τ) * x))) :=
by
  suffices h_gen : ∀ (R : Type) [Field R] (ψ₀ : k → R),
      ψ₀ 0 = 1 →
      (∀ x y : k, ψ₀ (x + y) = ψ₀ x * ψ₀ y) →
      (∃ x₀ : k, ψ₀ x₀ ≠ 1) →
      (∀ y : k, ψ₀ (y ^ p) = ψ₀ (- μ * y)) →
      (∑ Z : k, ψ₀ ((2 : k)⁻¹ * (μ * (d₀ - ζ)) * Z ^ 2 + (- μ * C₀) * Z)) *
        (∏ j ∈ (Finset.range p).erase 0,
          (∑ x : k, ψ₀ ((2 : k)⁻¹ * (j : k) * x ^ 2 + (j : k) * B_τ * x))) =
      (∑ x : k, ψ₀ ((2 : k)⁻¹ * d₀ * x ^ 2 + B_χ * x)) *
        (∏ j ∈ (Finset.range p).erase 0,
          (∑ x : k,
            ψ₀ ((2 : k)⁻¹ * (d₀ + (j : k)) * x ^ 2 + (B_χ + (j : k) * B_τ) * x))) by
    exact h_gen (Ω F) ψ₀ hψ₀_0 hψ₀_add hψ₀_ne hψ₀_frob
  clear * - hPrime hp_ne2 hchar h2_ne hμ_ne hlam_ne hμ_eq hd₀_eq hd₀_shift hC₀_pow
  intro R _ ψ₀ hψ₀_0 hψ₀_add hψ₀_ne hψ₀_frob
  
  let G : k → R := fun A => ∑ x : k, ψ₀ ((2 : k)⁻¹ * A * x ^ 2)
  have h_comp_sq : ∀ A B : k, A ≠ 0 →
      (∑ x : k, ψ₀ ((2 : k)⁻¹ * A * x ^ 2 + B * x)) =
        ψ₀ (- (2 : k)⁻¹ * B ^ 2 * A⁻¹) * G A := by
    intro A B hA
    rw [← Fintype.sum_equiv (Equiv.addRight (- A⁻¹ * B)) _ _ (fun _ => rfl)]
    have h2A : (2 : k) * (2 : k)⁻¹ = 1 := mul_inv_cancel₀ h2_ne
    have hAA : A * A⁻¹ = 1 := mul_inv_cancel₀ hA
    have h_ident : ∀ x : k,
        (2 : k)⁻¹ * A * (x + (- A⁻¹ * B)) ^ 2 + B * (x + (- A⁻¹ * B)) =
          (- (2 : k)⁻¹ * B ^ 2 * A⁻¹) + (2 : k)⁻¹ * A * x ^ 2 := by
      intro x
      calc (2 : k)⁻¹ * A * (x + (- A⁻¹ * B)) ^ 2 + B * (x + (- A⁻¹ * B))
          = (2 : k)⁻¹ * A * x ^ 2 - ((2 : k) * (2 : k)⁻¹) * (A * A⁻¹) * B * x +
              (2 : k)⁻¹ * (A * A⁻¹) * A⁻¹ * B ^ 2 + B * x - 1 * A⁻¹ * B ^ 2 := by ring
        _ = (2 : k)⁻¹ * A * x ^ 2 - 1 * 1 * B * x +
              (2 : k)⁻¹ * 1 * A⁻¹ * B ^ 2 + B * x - ((2 : k) * (2 : k)⁻¹) * A⁻¹ * B ^ 2 := by
            rw [h2A, hAA]
        _ = (- (2 : k)⁻¹ * B ^ 2 * A⁻¹) + (2 : k)⁻¹ * A * x ^ 2 := by ring
    have h_summand : ∀ x : k,
        ψ₀ ((2 : k)⁻¹ * A * (x + (- A⁻¹ * B)) ^ 2 + B * (x + (- A⁻¹ * B))) =
          ψ₀ (- (2 : k)⁻¹ * B ^ 2 * A⁻¹) * ψ₀ ((2 : k)⁻¹ * A * x ^ 2) := by
      intro x
      rw [h_ident x, hψ₀_add]
    simp_rw [Equiv.coe_addRight, h_summand, ← Finset.mul_sum]
    rfl
  have hG_sq : ∀ A s : k, s ≠ 0 → G (A * s ^ 2) = G A := by
    intro A s hs
    dsimp only [G]
    rw [← Fintype.sum_equiv (Equiv.mulLeft₀ s hs) _
      (fun x => ψ₀ ((2 : k)⁻¹ * A * x ^ 2)) (fun _ => rfl)]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    change ψ₀ ((2 : k)⁻¹ * (A * s ^ 2) * x ^ 2) = ψ₀ ((2 : k)⁻¹ * A * (s * x) ^ 2)
    congr 1
    ring
  obtain ⟨x₀, hx₀⟩ := hψ₀_ne
  have h_orth : ∀ c : k, c ≠ 0 → (∑ x : k, ψ₀ (c * x)) = 0 := by
    intro c hc
    have hshift : (∑ x : k, ψ₀ (c * x)) = (∑ x : k, ψ₀ (c * x)) * ψ₀ x₀ := by
      conv_lhs =>
        rw [← Fintype.sum_equiv (Equiv.addRight (c⁻¹ * x₀)) _ _ (fun _ => rfl)]
      have hterm : ∀ x : k, ψ₀ (c * (x + c⁻¹ * x₀)) = ψ₀ (c * x) * ψ₀ x₀ := by
        intro x
        have hcx : c * (x + c⁻¹ * x₀) = c * x + x₀ := by
          rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hc, one_mul]
        rw [hcx, hψ₀_add]
      simp_rw [Equiv.coe_addRight, hterm, ← Finset.sum_mul]
    have hzero : (∑ x : k, ψ₀ (c * x)) * (ψ₀ x₀ - 1) = 0 := by
      linear_combination -hshift
    exact (mul_eq_zero.mp hzero).resolve_right (sub_ne_zero.mpr hx₀)
  obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := kˣ)
  have hord_g₀ : orderOf g₀ = Fintype.card kˣ := by
    rw [orderOf_eq_card_of_forall_mem_powers hg₀, Nat.card_eq_fintype_card]
  have hneg1_ne : (-1 : kˣ) ≠ 1 := by
    intro h
    apply h2_ne
    have h1 : (-1 : k) = 1 := congrArg Units.val h
    linear_combination -h1
  have hord_neg1 : orderOf (-1 : kˣ) = 2 :=
    @orderOf_eq_prime kˣ _ (-1) 2 ⟨Nat.prime_two⟩ (by ext; simp) hneg1_ne
  have h2_dvd : 2 ∣ Fintype.card kˣ := hord_neg1 ▸ orderOf_dvd_card
  let m : ℕ := Fintype.card kˣ / 2
  have hcard_units : Fintype.card kˣ = 2 * m := (Nat.mul_div_cancel' h2_dvd).symm
  have hm_pos : 0 < m := by
    have hpos : 0 < Fintype.card kˣ := Fintype.card_pos
    omega
  let S₀ : Finset k := (Finset.univ : Finset k).erase 0
  have h_sum_S₀ : ∀ f : k → R,
      (∑ x ∈ S₀, f x) = ∑ j ∈ Finset.range (2 * m), f ((g₀ ^ j : kˣ) : k) := by
    intro f
    symm
    refine Finset.sum_bij (fun j _ => ((g₀ ^ j : kˣ) : k)) ?_ ?_ ?_ ?_
    · intro j _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero (g₀ ^ j), Finset.mem_univ _⟩
    · intro i hi j hj hij
      have hi' : i < orderOf g₀ := by
        rw [hord_g₀, hcard_units]
        exact Finset.mem_range.mp hi
      have hj' : j < orderOf g₀ := by
        rw [hord_g₀, hcard_units]
        exact Finset.mem_range.mp hj
      exact pow_injOn_Iio_orderOf hi' hj' (Units.ext hij)
    · intro x hx
      have hx0 : x ≠ 0 := (Finset.mem_erase.mp hx).1
      obtain ⟨n, hn⟩ := hg₀ (Units.mk0 x hx0)
      refine ⟨n % (2 * m), Finset.mem_range.mpr (Nat.mod_lt n (by omega)), ?_⟩
      dsimp only
      have hpow : g₀ ^ (n % (2 * m)) = g₀ ^ n := by
        conv_rhs => rw [← Nat.div_add_mod n (2 * m)]
        rw [pow_add, pow_mul, ← hcard_units, ← hord_g₀, pow_orderOf_eq_one, one_pow, one_mul]
      have hn' : g₀ ^ n = Units.mk0 x hx0 := hn
      rw [hpow, hn']
      rfl
    · intro _ _
      rfl
  let h_seq : ℕ → R := fun n => ψ₀ ((2 : k)⁻¹ * ((g₀ ^ n : kˣ) : k))
  have hg₀_2m : g₀ ^ (2 * m) = 1 := by
    rw [← hcard_units, ← hord_g₀, pow_orderOf_eq_one]
  have h_even_sum :
      (∑ j ∈ Finset.range (2 * m), h_seq (2 * j)) = 2 * ∑ j ∈ Finset.range m, h_seq (2 * j) := by
    have hm_add : 2 * m = m + m := by omega
    rw [hm_add, Finset.sum_range_add]
    have hshift : ∀ j ∈ Finset.range m, h_seq (2 * (m + j)) = h_seq (2 * j) := by
      intro j _
      dsimp only [h_seq]
      have hpow : g₀ ^ (2 * (m + j)) = g₀ ^ (2 * j) := by
        rw [Nat.mul_add, pow_add, hg₀_2m, one_mul]
      rw [hpow]
    rw [Finset.sum_congr rfl hshift, two_mul]
  have h_odd_sum :
      (∑ j ∈ Finset.range (2 * m), h_seq (2 * j + 1)) =
        2 * ∑ j ∈ Finset.range m, h_seq (2 * j + 1) := by
    have hm_add : 2 * m = m + m := by omega
    rw [hm_add, Finset.sum_range_add]
    have hshift : ∀ j ∈ Finset.range m, h_seq (2 * (m + j) + 1) = h_seq (2 * j + 1) := by
      intro j _
      dsimp only [h_seq]
      have hpow : g₀ ^ (2 * (m + j) + 1) = g₀ ^ (2 * j + 1) := by
        have h_exp : 2 * (m + j) + 1 = 2 * m + (2 * j + 1) := by omega
        rw [h_exp, pow_add, hg₀_2m, one_mul]
      rw [hpow]
    rw [Finset.sum_congr rfl hshift, two_mul]
  have h_eo : ∀ n : ℕ,
      (∑ j ∈ Finset.range n, h_seq (2 * j)) + (∑ j ∈ Finset.range n, h_seq (2 * j + 1)) =
        ∑ j ∈ Finset.range (2 * n), h_seq j := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      have h2n : 2 * (n + 1) = 2 * n + 1 + 1 := by omega
      rw [Finset.sum_range_succ, Finset.sum_range_succ, h2n,
        Finset.sum_range_succ, Finset.sum_range_succ, ← ih]
      ring
  have hG1_eq : G 1 = 1 + ∑ j ∈ Finset.range (2 * m), h_seq (2 * j) := by
    dsimp only [G]
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ (0 : k)), h_sum_S₀]
    have h0 : ψ₀ ((2 : k)⁻¹ * 1 * (0 : k) ^ 2) = 1 := by simp [hψ₀_0]
    rw [h0]
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp only [h_seq]
    congr 1
    rw [mul_one, ← Units.val_pow_eq_pow_val, ← pow_mul']
  have hGg₀_eq : G (g₀ : k) = 1 + ∑ j ∈ Finset.range (2 * m), h_seq (2 * j + 1) := by
    dsimp only [G]
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ (0 : k)), h_sum_S₀]
    have h0 : ψ₀ ((2 : k)⁻¹ * (g₀ : k) * (0 : k) ^ 2) = 1 := by simp [hψ₀_0]
    rw [h0]
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp only [h_seq]
    congr 1
    rw [pow_add g₀ (2 * j) 1, pow_one, pow_mul', Units.val_mul, ← Units.val_pow_eq_pow_val]
    ring
  have h_lin_sum : 1 + (∑ j ∈ Finset.range (2 * m), h_seq j) = 0 := by
    have h_univ := h_orth (2 : k)⁻¹ (inv_ne_zero h2_ne)
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ (0 : k)), h_sum_S₀] at h_univ
    simpa [h_seq, hψ₀_0] using h_univ
  have hGg₀_neg : G (g₀ : k) = - G 1 := by
    have h_add : G 1 + G (g₀ : k) = 2 * (1 + ∑ j ∈ Finset.range (2 * m), h_seq j) := by
      rw [hG1_eq, hGg₀_eq, h_even_sum, h_odd_sum, ← h_eo m]
      ring
    rw [h_lin_sum, mul_zero] at h_add
    exact eq_neg_of_add_eq_zero_right h_add
  let η : k → R := fun a => if a = 0 then 0 else if a ^ m = 1 then 1 else -1
  have h_pow_m_sq : ∀ a : k, a ≠ 0 → a ^ m = 1 ∨ a ^ m = -1 := by
    intro a ha
    apply sq_eq_one_iff.mp
    rw [← pow_mul', ← hcard_units]
    have hu : (Units.mk0 a ha) ^ (Fintype.card kˣ) = 1 := pow_card_eq_one
    exact congrArg Units.val hu
  have hneg1_ne_k : (-1 : k) ≠ 1 := by
    intro h
    exact h2_ne (by linear_combination -h)
  have hη_mul : ∀ A B : k, A ≠ 0 → B ≠ 0 → η (A * B) = η A * η B := by
    intro A B hA hB
    have hAB : A * B ≠ 0 := mul_ne_zero hA hB
    dsimp only [η]
    rw [if_neg hAB, if_neg hA, if_neg hB, mul_pow]
    rcases h_pow_m_sq A hA with hAm | hAm <;> rcases h_pow_m_sq B hB with hBm | hBm
    · rw [hAm, hBm, mul_one, if_pos rfl, mul_one]
    · rw [hAm, hBm, one_mul, if_pos rfl, if_neg hneg1_ne_k, one_mul]
    · rw [hAm, hBm, mul_one, if_pos rfl, if_neg hneg1_ne_k, mul_one]
    · have h1 : (-1 : k) * (-1) = 1 := by ring
      rw [hAm, hBm, h1, if_pos rfl, if_neg hneg1_ne_k]
      ring
  have hη_1 : η 1 = 1 := by
    dsimp only [η]
    rw [if_neg one_ne_zero, one_pow, if_pos rfl]
  have hη_sq : ∀ A s : k, A ≠ 0 → s ≠ 0 → η (A * s ^ 2) = η A := by
    intro A s hA hs
    have hs2 : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
    rw [hη_mul A (s ^ 2) hA hs2]
    have hη_s2 : η (s ^ 2) = 1 := by
      dsimp only [η]
      rw [if_neg hs2, ← pow_mul, ← hcard_units]
      have hu : (Units.mk0 s hs) ^ (Fintype.card kˣ) = 1 := pow_card_eq_one
      have hs_2m : s ^ (Fintype.card kˣ) = 1 := congrArg Units.val hu
      rw [hs_2m, if_pos rfl]
    rw [hη_s2, mul_one]
  have hη_g₀ : η (g₀ : k) = -1 := by
    dsimp only [η]
    rw [if_neg (Units.ne_zero g₀)]
    have hg₀_m_ne : ((g₀ : k) ^ m) ≠ 1 := by
      intro h1
      have hu : g₀ ^ m = 1 := Units.ext (by simpa [Units.val_pow_eq_pow_val] using h1)
      have hlt : m < orderOf g₀ := by
        rw [hord_g₀, hcard_units]
        omega
      exact pow_ne_one_of_lt_orderOf hm_pos.ne' hlt hu
    rw [if_neg hg₀_m_ne]
  have hG_η : ∀ A : k, A ≠ 0 → G A = η A * G 1 := by
    intro A hA
    obtain ⟨n, hn⟩ := hg₀ (Units.mk0 A hA)
    have hn_val : ((g₀ : k) ^ n) = A := by
      have h := congrArg Units.val hn
      simpa [Units.val_pow_eq_pow_val] using h
    set k_half : ℕ := n / 2
    set s : k := (g₀ : k) ^ k_half
    have hs : s ≠ 0 := pow_ne_zero _ (Units.ne_zero g₀)
    have hn_div : n = 2 * k_half + n % 2 := (Nat.div_add_mod n 2).symm
    rcases Nat.mod_two_eq_zero_or_one n with hmod0 | hmod1
    · have hA_eq : A = 1 * s ^ 2 := by
        rw [← hn_val, hn_div, hmod0, add_zero, pow_mul', one_mul]
      rw [hA_eq, hG_sq 1 s hs, hη_sq 1 s one_ne_zero hs, hη_1, one_mul]
    · have hA_eq : A = (g₀ : k) * s ^ 2 := by
        rw [← hn_val, hn_div, hmod1, pow_add, pow_one, pow_mul', mul_comm]
      rw [hA_eq, hG_sq (g₀ : k) s hs, hη_sq (g₀ : k) s (Units.ne_zero g₀) hs,
        hGg₀_neg, hη_g₀, neg_one_mul]
  have h_single : ∀ A B : k, A ≠ 0 →
      (∑ x : k, ψ₀ ((2 : k)⁻¹ * A * x ^ 2 + B * x)) =
        ψ₀ (- (2 : k)⁻¹ * B ^ 2 * A⁻¹) * η A * (∑ x : k, ψ₀ ((2 : k)⁻¹ * x ^ 2)) := by
    intro A B hA
    have hG1 : G 1 = ∑ x : k, ψ₀ ((2 : k)⁻¹ * x ^ 2) := by
      dsimp only [G]
      simp [mul_one]
    rw [h_comp_sq A B hA, hG_η A hA, hG1, ← mul_assoc]
  have h_prod : ∀ (S : Finset ℕ) (A B : ℕ → k),
      (∀ j ∈ S, A j ≠ 0) →
      (∏ j ∈ S, (∑ x : k, ψ₀ ((2 : k)⁻¹ * A j * x ^ 2 + B j * x))) =
        ψ₀ (∑ j ∈ S, (- (2 : k)⁻¹ * (B j) ^ 2 * (A j)⁻¹)) *
          η (∏ j ∈ S, A j) *
          (∑ x : k, ψ₀ ((2 : k)⁻¹ * x ^ 2)) ^ S.card := by
    intro S A B hS
    induction S using Finset.induction_on with
    | empty =>
      simp [hψ₀_0, hη_1]
    | @insert a s ha ih =>
      have ha_ne : A a ≠ 0 := hS a (Finset.mem_insert_self a s)
      have hs_ne : ∀ j ∈ s, A j ≠ 0 := fun j hj => hS j (Finset.mem_insert_of_mem hj)
      have hprod_s_ne : (∏ j ∈ s, A j) ≠ 0 := Finset.prod_ne_zero_iff.mpr hs_ne
      rw [Finset.prod_insert ha, Finset.sum_insert ha, Finset.prod_insert ha,
        Finset.card_insert_of_notMem ha, h_single (A a) (B a) ha_ne, ih hs_ne,
        hψ₀_add, hη_mul (A a) (∏ j ∈ s, A j) ha_ne hprod_s_ne, pow_succ']
      ring
  
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hring : ringChar k = p := by
    have hdvd : ringChar k ∣ p := (ringChar.spec k p).mp hchar
    rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | hp
    · exfalso
      have h0 : ((1 : ℕ) : k) = 0 := (ringChar.spec k 1).mpr (h1 ▸ dvd_refl _)
      rw [Nat.cast_one] at h0
      exact one_ne_zero h0
    · exact hp
  haveI : CharP k p := CharP.mk (fun x => by rw [← hring]; exact ringChar.spec k x)
  have hj_ne : ∀ j ∈ (Finset.range p).erase 0, (j : k) ≠ 0 := by
    intro j hj
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    rw [Ne, CharP.cast_eq_zero_iff k p j]
    exact Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
  have h_odd : p % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime).resolve_left hp_ne2
  let M : ℕ := (p - 1) / 2
  have hp1 : p - 1 = 2 * M := by omega
  have hp_eq : p = 2 * M + 1 := by omega
  have hsum_range : (∑ j ∈ Finset.range p, (j : k)) = 0 := by
    have h_id : ∑ j ∈ Finset.range p, j = p * M := by
      rw [Finset.sum_range_id, hp1, ← mul_assoc, mul_comm p 2, mul_assoc,
        Nat.mul_div_right _ (by omega)]
    have h_cast : ((∑ j ∈ Finset.range p, j : ℕ) : k) = 0 := by
      rw [h_id, Nat.cast_mul, hchar, zero_mul]
    simpa [Nat.cast_sum] using h_cast
  have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hPrime.pos
  have hsum_j : (∑ j ∈ (Finset.range p).erase 0, (j : k)) = 0 := by
    have h := Finset.add_sum_erase (Finset.range p) (fun j : ℕ => (j : k)) h0_mem
    dsimp only at h
    rw [Nat.cast_zero, zero_add, hsum_range] at h
    exact h
  have h_nat_frob : ∀ n : ℕ, (n : k) ^ p = (n : k) := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, zero_pow hPrime.ne_zero]
    | succ n ih => rw [Nat.cast_succ, add_pow_char, ih, one_pow]
  have h_neg_frob : ∀ j : ℕ, (- (j : k)) ^ p = - (j : k) := by
    intro j
    have hsub := sub_pow_char (0 : k) (j : k) (p := p)
    rw [zero_sub, zero_pow hPrime.ne_zero, zero_sub, h_nat_frob] at hsub
    exact hsub
  let v : ℕ → k := fun j => - (j : k)
  have hv_inj : Set.InjOn v ↑(Finset.range p) := by
    intro i hi j hj hij
    have hi_lt : i < p := Finset.mem_range.mp (Finset.mem_coe.mp hi)
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_coe.mp hj)
    have h_eq : (i : k) = (j : k) := neg_inj.mp hij
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · have h_sub : ((j - i : ℕ) : k) = 0 := by
        rw [Nat.cast_sub (le_of_lt hlt), h_eq, sub_self]
      have hdvd : p ∣ (j - i) := (CharP.cast_eq_zero_iff k p (j - i)).mp h_sub
      exact Nat.not_dvd_of_pos_of_lt (by omega) (by omega) hdvd
    · have h_sub : ((i - j : ℕ) : k) = 0 := by
        rw [Nat.cast_sub (le_of_lt hgt), h_eq, sub_self]
      have hdvd : p ∣ (i - j) := (CharP.cast_eq_zero_iff k p (i - j)).mp h_sub
      exact Nat.not_dvd_of_pos_of_lt (by omega) (by omega) hdvd
  let P : Polynomial k := ∏ j ∈ Finset.range p, (Polynomial.X + Polynomial.C (j : k))
  let Q : Polynomial k := Polynomial.X ^ p - Polynomial.X
  have hP_monic : P.Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun j _ => Polynomial.monic_X_add_C (j : k))
  have hP_natDeg : P.natDegree = p := by
    dsimp only [P]
    rw [Polynomial.natDegree_prod_of_monic (Finset.range p)
      (fun j : ℕ => Polynomial.X + Polynomial.C (j : k))
      (fun j _ => Polynomial.monic_X_add_C (j : k))]
    simp only [Polynomial.natDegree_X_add_C, Finset.sum_const, Finset.card_range, smul_eq_mul, mul_one]
  have hP_deg : P.degree = (p : WithBot ℕ) := by
    rw [Polynomial.degree_eq_natDegree hP_monic.ne_zero, hP_natDeg]
  have hdeg_lt : (Polynomial.X : Polynomial k).degree < ((Polynomial.X : Polynomial k) ^ p).degree := by
    rw [Polynomial.degree_X, Polynomial.degree_X_pow]
    exact WithBot.coe_lt_coe.mpr hPrime.one_lt
  have hQ_monic : Q.Monic :=
    Polynomial.Monic.sub_of_left (Polynomial.monic_X_pow p) hdeg_lt
  have hQ_deg : Q.degree = P.degree := by
    dsimp only [Q]
    rw [Polynomial.degree_sub_eq_left_of_degree_lt hdeg_lt, Polynomial.degree_X_pow, hP_deg]
  have hPQ_deg : (P - Q).degree < ((Finset.range p).card : WithBot ℕ) := by
    rw [Finset.card_range, ← hP_deg]
    exact Polynomial.degree_sub_lt hQ_deg.symm hP_monic.ne_zero
      (by rw [hP_monic.leadingCoeff, hQ_monic.leadingCoeff])
  have hPQ_eval : ∀ j ∈ Finset.range p, Polynomial.eval (v j) (P - Q) = 0 := by
    intro j hj
    rw [Polynomial.eval_sub]
    have hP0 : Polynomial.eval (v j) P = 0 := by
      dsimp only [P, v]
      rw [Polynomial.eval_prod]
      refine Finset.prod_eq_zero hj ?_
      simp
    have hQ0 : Polynomial.eval (v j) Q = 0 := by
      dsimp only [Q, v]
      simp [h_neg_frob j]
    rw [hP0, hQ0, sub_self]
  have hPQ_zero : P - Q = 0 := by
    rw [Lagrange.eq_interpolate hv_inj hPQ_deg, Lagrange.interpolate_eq_sum]
    refine Finset.sum_eq_zero (fun j hj => ?_)
    rw [hPQ_eval j hj]
    simp
  have hPQ : P = Q := sub_eq_zero.mp hPQ_zero
  have hprod_d₀ : (∏ j ∈ Finset.range p, (d₀ + (j : k))) = (d₀ - ζ) ^ p := by
    have heval := congrArg (Polynomial.eval d₀) hPQ
    dsimp only [P, Q] at heval
    simp only [Polynomial.eval_prod, Polynomial.eval_add, Polynomial.eval_X,
      Polynomial.eval_C, Polynomial.eval_sub, Polynomial.eval_pow] at heval
    rw [heval, sub_pow_char, ← hd₀_eq]
  have hd₀_pow_ne : (d₀ - ζ) ^ p ≠ 0 := by
    rw [← hprod_d₀]
    exact Finset.prod_ne_zero_iff.mpr hd₀_shift
  have hd₀_sub_ne : d₀ - ζ ≠ 0 := fun h => hd₀_pow_ne (by rw [h, zero_pow hPrime.ne_zero])
  have hderiv_eval :
      (∑ j ∈ Finset.range p, ∏ i ∈ (Finset.range p).erase j, (d₀ + (i : k))) = -1 := by
    have hderiv := congrArg (fun f => Polynomial.eval d₀ (Polynomial.derivative f)) hPQ
    dsimp only [P, Q] at hderiv
    rw [Polynomial.derivative_prod_finset, Polynomial.derivative_sub,
      Polynomial.derivative_X_pow, Polynomial.derivative_X] at hderiv
    simp only [Polynomial.derivative_add, Polynomial.derivative_X, Polynomial.derivative_C,
      add_zero, mul_one, Polynomial.eval_finset_sum, Polynomial.eval_prod,
      Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C,
      Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_one, hchar, zero_mul, zero_sub] at hderiv
    exact hderiv
  have hsum_inv : (∑ j ∈ Finset.range p, (d₀ + (j : k))⁻¹) = - ((d₀ - ζ) ^ p)⁻¹ := by
    have h_term : ∀ j ∈ Finset.range p,
        (d₀ + (j : k))⁻¹ * (d₀ - ζ) ^ p = ∏ i ∈ (Finset.range p).erase j, (d₀ + (i : k)) := by
      intro j hj
      rw [← hprod_d₀, ← Finset.mul_prod_erase (Finset.range p) (fun i => d₀ + (i : k)) hj,
        inv_mul_cancel_left₀ (hd₀_shift j hj)]
    have h_mul : (∑ j ∈ Finset.range p, (d₀ + (j : k))⁻¹) * (d₀ - ζ) ^ p = -1 := by
      rw [Finset.sum_mul, Finset.sum_congr rfl h_term, hderiv_eval]
    calc (∑ j ∈ Finset.range p, (d₀ + (j : k))⁻¹)
        = ((∑ j ∈ Finset.range p, (d₀ + (j : k))⁻¹) * (d₀ - ζ) ^ p) * ((d₀ - ζ) ^ p)⁻¹ := by
          rw [mul_inv_cancel_right₀ hd₀_pow_ne]
      _ = - ((d₀ - ζ) ^ p)⁻¹ := by rw [h_mul, neg_one_mul]
  have hpf_sum :
      (∑ j ∈ Finset.range p, (B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹) =
        - (B_χ - d₀ * B_τ) ^ 2 * ((d₀ - ζ) ^ p)⁻¹ := by
    have h_decomp : ∀ j ∈ Finset.range p,
        (B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹ =
          (B_χ - d₀ * B_τ) ^ 2 * (d₀ + (j : k))⁻¹ +
            ((2 * B_χ * B_τ - d₀ * B_τ ^ 2) + B_τ ^ 2 * (j : k)) := by
      intro j hj
      have hdj : d₀ + (j : k) ≠ 0 := hd₀_shift j hj
      apply mul_right_cancel₀ hdj
      calc (B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹ * (d₀ + (j : k))
          = (B_χ + (j : k) * B_τ) ^ 2 * ((d₀ + (j : k))⁻¹ * (d₀ + (j : k))) := by ring
        _ = (B_χ + (j : k) * B_τ) ^ 2 := by rw [inv_mul_cancel₀ hdj, mul_one]
        _ = (B_χ - d₀ * B_τ) ^ 2 * ((d₀ + (j : k))⁻¹ * (d₀ + (j : k))) +
              ((2 * B_χ * B_τ - d₀ * B_τ ^ 2) + B_τ ^ 2 * (j : k)) * (d₀ + (j : k)) := by
            rw [inv_mul_cancel₀ hdj]
            ring
        _ = ((B_χ - d₀ * B_τ) ^ 2 * (d₀ + (j : k))⁻¹ +
              ((2 * B_χ * B_τ - d₀ * B_τ ^ 2) + B_τ ^ 2 * (j : k))) * (d₀ + (j : k)) := by ring
    rw [Finset.sum_congr rfl h_decomp, Finset.sum_add_distrib, Finset.sum_add_distrib,
      ← Finset.mul_sum, ← Finset.mul_sum, hsum_inv, hsum_range,
      Finset.sum_const, Finset.card_range, nsmul_eq_mul, hchar, zero_mul, mul_zero,
      add_zero, add_zero]
    ring
  
  have h_lhs2 :
      ψ₀ (∑ j ∈ (Finset.range p).erase 0, (- (2 : k)⁻¹ * ((j : k) * B_τ) ^ 2 * (j : k)⁻¹)) = 1 := by
    have hterm : ∀ j ∈ (Finset.range p).erase 0,
        - (2 : k)⁻¹ * ((j : k) * B_τ) ^ 2 * (j : k)⁻¹ = (- (2 : k)⁻¹ * B_τ ^ 2) * (j : k) := by
      intro j hj
      have hj0 := hj_ne j hj
      calc - (2 : k)⁻¹ * ((j : k) * B_τ) ^ 2 * (j : k)⁻¹
          = (- (2 : k)⁻¹ * B_τ ^ 2) * (j : k) * ((j : k) * (j : k)⁻¹) := by ring
        _ = (- (2 : k)⁻¹ * B_τ ^ 2) * (j : k) := by rw [mul_inv_cancel₀ hj0, mul_one]
    rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, hsum_j, mul_zero, hψ₀_0]
  have h2_frob : ((2 : k)⁻¹) ^ p = (2 : k)⁻¹ := by
    have h2 : (2 : k) ^ p = (2 : k) := by
      have h11 : ((1 : k) + 1) ^ p = (1 : k) ^ p + (1 : k) ^ p := add_pow_char (1 : k) 1 p
      norm_num at h11 ⊢
      exact h11
    rw [inv_pow, h2]
  let y : k := (2 : k)⁻¹ * C₀ ^ 2 * (d₀ - ζ)⁻¹
  have hy_arg : - (2 : k)⁻¹ * (- μ * C₀) ^ 2 * (μ * (d₀ - ζ))⁻¹ = - μ * y := by
    dsimp only [y]
    rw [mul_inv]
    calc - (2 : k)⁻¹ * (- μ * C₀) ^ 2 * (μ⁻¹ * (d₀ - ζ)⁻¹)
        = (- μ * ((2 : k)⁻¹ * C₀ ^ 2 * (d₀ - ζ)⁻¹)) * (μ * μ⁻¹) := by ring
      _ = - μ * ((2 : k)⁻¹ * C₀ ^ 2 * (d₀ - ζ)⁻¹) := by rw [mul_inv_cancel₀ hμ_ne, mul_one]
  have hy_pow :
      y ^ p = ∑ j ∈ Finset.range p, (- (2 : k)⁻¹ * (B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹) := by
    dsimp only [y]
    have h_assoc :
        (∑ j ∈ Finset.range p, (- (2 : k)⁻¹ * (B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹)) =
          (- (2 : k)⁻¹) * ∑ j ∈ Finset.range p, ((B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun _ _ => by ring)
    rw [h_assoc, hpf_sum, mul_pow, mul_pow, h2_frob, pow_right_comm C₀ 2 p, hC₀_pow, inv_pow]
    ring
  have hphase_eq :
      ψ₀ (- (2 : k)⁻¹ * (- μ * C₀) ^ 2 * (μ * (d₀ - ζ))⁻¹) *
        ψ₀ (∑ j ∈ (Finset.range p).erase 0, (- (2 : k)⁻¹ * ((j : k) * B_τ) ^ 2 * (j : k)⁻¹)) =
      ψ₀ (∑ j ∈ Finset.range p, (- (2 : k)⁻¹ * (B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹)) := by
    rw [h_lhs2, mul_one, hy_arg, ← hψ₀_frob y, hy_pow]
  set P_p : k := ∏ j ∈ (Finset.range p).erase 0, (j : k)
  have hPp_ne : P_p ≠ 0 := Finset.prod_ne_zero_iff.mpr hj_ne
  let s : k := P_p * lam ^ M * ((d₀ - ζ) ^ M)⁻¹
  have hs_ne : s ≠ 0 :=
    mul_ne_zero (mul_ne_zero hPp_ne (pow_ne_zero M hlam_ne)) (inv_ne_zero (pow_ne_zero M hd₀_sub_ne))
  have hsq_eq : (μ * (d₀ - ζ)) * P_p = (∏ j ∈ Finset.range p, (d₀ + (j : k))) * s ^ 2 := by
    have hμ_P : μ = P_p * (lam ^ M) ^ 2 := by
      rw [hμ_eq, hp1, pow_mul']
    have hprod_P : (∏ j ∈ Finset.range p, (d₀ + (j : k))) = (d₀ - ζ) * ((d₀ - ζ) ^ M) ^ 2 := by
      rw [hprod_d₀, hp_eq, pow_add, pow_one, pow_mul', mul_comm]
    have hdM_ne : (d₀ - ζ) ^ M ≠ 0 := pow_ne_zero M hd₀_sub_ne
    have hdM_inv : (d₀ - ζ) ^ M * ((d₀ - ζ) ^ M)⁻¹ = 1 := mul_inv_cancel₀ hdM_ne
    calc (μ * (d₀ - ζ)) * P_p
        = (P_p * (lam ^ M) ^ 2 * (d₀ - ζ)) * P_p := by rw [hμ_P]
      _ = (d₀ - ζ) * (((d₀ - ζ) ^ M * ((d₀ - ζ) ^ M)⁻¹) ^ 2) * P_p ^ 2 * (lam ^ M) ^ 2 := by
          rw [hdM_inv, one_pow]
          ring
      _ = ((d₀ - ζ) * ((d₀ - ζ) ^ M) ^ 2) * (P_p * lam ^ M * ((d₀ - ζ) ^ M)⁻¹) ^ 2 := by ring
      _ = (∏ j ∈ Finset.range p, (d₀ + (j : k))) * s ^ 2 := by rw [← hprod_P]
  
  have h_rhs_comb :
      (∑ x : k, ψ₀ ((2 : k)⁻¹ * d₀ * x ^ 2 + B_χ * x)) *
        (∏ j ∈ (Finset.range p).erase 0,
          (∑ x : k, ψ₀ ((2 : k)⁻¹ * (d₀ + (j : k)) * x ^ 2 + (B_χ + (j : k) * B_τ) * x))) =
      ∏ j ∈ Finset.range p,
        (∑ x : k, ψ₀ ((2 : k)⁻¹ * (d₀ + (j : k)) * x ^ 2 + (B_χ + (j : k) * B_τ) * x)) := by
    have h0 := Finset.mul_prod_erase (Finset.range p)
      (fun j => ∑ x : k, ψ₀ ((2 : k)⁻¹ * (d₀ + (j : k)) * x ^ 2 + (B_χ + (j : k) * B_τ) * x))
      h0_mem
    dsimp only at h0
    rw [Nat.cast_zero, add_zero, zero_mul, add_zero] at h0
    exact h0
  have hA_K_ne : μ * (d₀ - ζ) ≠ 0 := mul_ne_zero hμ_ne hd₀_sub_ne
  have hPd₀_ne : (∏ j ∈ Finset.range p, (d₀ + (j : k))) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr hd₀_shift
  have hcard_erase : ((Finset.range p).erase 0).card = p - 1 := by
    rw [Finset.card_erase_of_mem h0_mem, Finset.card_range]
  set G₁ : R := ∑ x : k, ψ₀ ((2 : k)⁻¹ * x ^ 2)
  have hG_pow : G₁ * G₁ ^ (p - 1) = G₁ ^ p := by
    rw [← pow_succ', Nat.sub_add_cancel hPrime.pos]
  have hη_eq :
      η (μ * (d₀ - ζ)) * η P_p = η (∏ j ∈ Finset.range p, (d₀ + (j : k))) := by
    rw [← hη_mul _ _ hA_K_ne hPp_ne, hsq_eq, hη_sq _ s hPd₀_ne hs_ne]
  rw [h_rhs_comb,
    h_single (μ * (d₀ - ζ)) (- μ * C₀) hA_K_ne,
    h_prod ((Finset.range p).erase 0) (fun j => (j : k)) (fun j => (j : k) * B_τ) hj_ne,
    h_prod (Finset.range p) (fun j => d₀ + (j : k)) (fun j => B_χ + (j : k) * B_τ) hd₀_shift,
    hcard_erase, Finset.card_range]
  calc (ψ₀ (- (2 : k)⁻¹ * (- μ * C₀) ^ 2 * (μ * (d₀ - ζ))⁻¹) * η (μ * (d₀ - ζ)) * G₁) *
        (ψ₀ (∑ j ∈ (Finset.range p).erase 0, (- (2 : k)⁻¹ * ((j : k) * B_τ) ^ 2 * (j : k)⁻¹)) *
          η P_p * G₁ ^ (p - 1))
      = (ψ₀ (- (2 : k)⁻¹ * (- μ * C₀) ^ 2 * (μ * (d₀ - ζ))⁻¹) *
          ψ₀ (∑ j ∈ (Finset.range p).erase 0, (- (2 : k)⁻¹ * ((j : k) * B_τ) ^ 2 * (j : k)⁻¹))) *
        (η (μ * (d₀ - ζ)) * η P_p) *
        (G₁ * G₁ ^ (p - 1)) := by ring
    _ = ψ₀ (∑ j ∈ Finset.range p, (- (2 : k)⁻¹ * (B_χ + (j : k) * B_τ) ^ 2 * (d₀ + (j : k))⁻¹)) *
          η (∏ j ∈ Finset.range p, (d₀ + (j : k))) * G₁ ^ p := by
        rw [hphase_eq, hη_eq, hG_pow]

theorem ld_wild_low_cond_odd_prime_boundary_pencil (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_ne2 : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
