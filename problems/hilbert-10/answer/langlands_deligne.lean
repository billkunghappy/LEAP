            (Units.map (IntermediateField.inclusion hM₁K₁).toMonoidHom z) := by rw [hχE'_norm]
      _ = χE' (Units.map (normLM F hEK₁)
            (Units.map (IntermediateField.inclusion hM₁K₁).toMonoidHom z)) := rfl
