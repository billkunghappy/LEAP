      have ha_S₁ : a ∈ S₁_C := hsub (Finset.mem_insert_self a s)
      have ha_ne1 : a ≠ 1 := (Finset.mem_erase.mp ha_S₁).1
      have ha_val_ne1 : a.1 ≠ 1 := fun h1 => ha_ne1 (Subtype.ext h1)
      have hs_sub : s ⊆ S₁_C := fun x hx => hsub (Finset.mem_insert_of_mem hx)
      obtain ⟨hs_ne0, hs_val⟩ := ih hs_sub
      obtain ⟨ha_ne0, ha_val⟩ := hJumpK_C a.1 a.2 ha_val_ne1 ϖ₀ hϖ₀
      rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha]
      refine ⟨mul_ne_zero ha_ne0 hs_ne0, ?_⟩
      rw [hval_mul_K _ _ ha_ne0 hs_ne0, ha_val, hs_val]
      push_cast
      ring
  have hS₁_C_card : S₁_C.card = q - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ (1 : C)), Finset.card_univ, hcard_C_fintype]
  have hδ_pi_ne0 : δ_pi ≠ 0 := (hprod_SC S₁_C (Finset.Subset.refl S₁_C)).1
  have hδ_pi_val : valL F K δ_pi = ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
    have h := (hprod_SC S₁_C (Finset.Subset.refl S₁_C)).2
    rwa [hS₁_C_card] at h
  have hδ_pi_inv_ne0 : δ_pi⁻¹ ≠ 0 := inv_ne_zero hδ_pi_ne0
  have hδ_pi_inv_val : valL F K δ_pi⁻¹ = - (((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) := by
    set u_δ : Kˣ := Units.mk0 δ_pi hδ_pi_ne0
    have h1 : δ_pi⁻¹ = ((u_δ⁻¹ : Kˣ) : K) := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    have h2 : (u_δ : K) = δ_pi := Units.val_mk0 hδ_pi_ne0
    rw [h1, hval_inv_K u_δ, h2, hδ_pi_val]
  let v_C : C → K := fun c => act c.1 π₀
  have hInjOn_C : Set.InjOn v_C ↑U_C := by
    intro c₁ _ c₂ _ h_eq
    change act c₁.1 π₀ = act c₂.1 π₀ at h_eq
    by_contra hne
    have h_inv_ne1 : (c₁⁻¹ * c₂ : C).1 ≠ 1 := by
      intro h1
      have hc_eq : c₁⁻¹ * c₂ = 1 := Subtype.ext h1
      exact hne (inv_mul_eq_one.mp hc_eq)
    have h_fix : act (c₁⁻¹ * c₂ : C).1 π₀ = π₀ := by
      change act (c₁.1⁻¹ * c₂.1) π₀ = π₀
      rw [hact_mul c₁.1⁻¹ c₂.1 π₀, ← h_eq, ← hact_mul c₁.1⁻¹ c₁.1 π₀, inv_mul_cancel, hact_one]
    exact (hJumpK_C (c₁⁻¹ * c₂ : C).1 (c₁⁻¹ * c₂ : C).2 h_inv_ne1 ϖ₀ hϖ₀).1
      (sub_eq_zero.mpr h_fix.symm)
  have hact_δ_pi : ∀ c : C, act c.1 δ_pi = ∏ γ ∈ U_C.erase c, (v_C c - v_C γ) := by
    intro c
    have hmap : act c.1 δ_pi = ∏ ρ ∈ S₁_C, (v_C c - v_C (c * ρ)) := by
      change φ_act c.1 (∏ ρ ∈ S₁_C, (π₀ - act ρ.1 π₀)) = _
      rw [map_prod (φ_act c.1)]
      refine Finset.prod_congr rfl (fun ρ _ => ?_)
      rw [map_sub (φ_act c.1), hφ_apply, hφ_apply, ← hact_mul c.1 ρ.1 π₀]
      rfl
    rw [hmap]
    refine Finset.prod_bij (fun (ρ : C) _ => c * ρ) ?_ ?_ ?_ ?_
    · intro ρ hρ
      have hρ_ne1 : ρ ≠ 1 := (Finset.mem_erase.mp hρ).1
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h_eq
      have h1 : c⁻¹ * (c * ρ) = c⁻¹ * c := congrArg (c⁻¹ * ·) h_eq
      rw [inv_mul_cancel_left, inv_mul_cancel] at h1
      exact hρ_ne1 h1
    · intro ρ₁ _ ρ₂ _ h_eq
      exact mul_left_cancel h_eq
    · intro γ hγ
      have hγ_ne : γ ≠ c := (Finset.mem_erase.mp hγ).1
      refine ⟨c⁻¹ * γ, ?_, mul_inv_cancel_left c γ⟩
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h1
      exact hγ_ne (inv_mul_eq_one.mp h1).symm
    · intro ρ _
      rfl
  have hact_term_C : ∀ (c : C) (k : ℕ),
      act c.1 (π₀ ^ k * δ_pi⁻¹) = (v_C c) ^ k / (∏ γ ∈ U_C.erase c, (v_C c - v_C γ)) := by
    intro c k
    change φ_act c.1 (π₀ ^ k * δ_pi⁻¹) = _
    rw [map_mul (φ_act c.1), map_pow (φ_act c.1), map_inv₀ (φ_act c.1),
      hφ_apply, hφ_apply, hact_δ_pi c, div_eq_mul_inv]
  let Q_C : C → Polynomial K := fun c =>
    ∏ γ ∈ U_C.erase c, (Polynomial.X - Polynomial.C (v_C γ))
  have hQ_C_coeff : ∀ c : C, (Q_C c).coeff (q - 1) = 1 := by
    intro c
    have hmonic_fac : ∀ γ ∈ U_C.erase c, (Polynomial.X - Polynomial.C (v_C γ)).Monic :=
      fun γ _ => Polynomial.monic_X_sub_C (v_C γ)
    have hmonic : (Q_C c).Monic :=
      Polynomial.monic_prod_of_monic (U_C.erase c) _ hmonic_fac
    have hdeg : (Q_C c).natDegree = q - 1 := by
      dsimp only [Q_C]
      rw [Polynomial.natDegree_prod_of_monic (U_C.erase c) _ hmonic_fac]
      have hsum1 : (∑ γ ∈ U_C.erase c, (Polynomial.X - Polynomial.C (v_C γ)).natDegree) =
          ∑ _γ ∈ U_C.erase c, 1 := by
        refine Finset.sum_congr rfl (fun γ _ => Polynomial.natDegree_X_sub_C (v_C γ))
      rw [hsum1, Finset.sum_const, smul_eq_mul, mul_one,
        Finset.card_erase_of_mem (Finset.mem_univ c), Finset.card_univ, hcard_C_fintype]
    rw [← hdeg]
    exact Polynomial.Monic.coeff_natDegree hmonic
  have hEuler : ∀ k < q,
      traceLM F hM_CK (π₀ ^ k * δ_pi⁻¹) = if q - 1 = k then 1 else 0 := by
    intro k hk
    have hdeg : (Polynomial.X ^ k : Polynomial K).degree < (U_C.card : WithBot ℕ) := by
      rw [Polynomial.degree_X_pow k, Finset.card_univ, hcard_C_fintype]
      exact WithBot.coe_lt_coe.mpr hk
    have hLag := @Lagrange.eq_interpolate K _ C _ U_C v_C (Polynomial.X ^ k) hInjOn_C hdeg
    rw [Lagrange.interpolate_eq_sum] at hLag
    have hcoeff := congrArg (fun P_poly : Polynomial K => P_poly.coeff (q - 1)) hLag
    dsimp only at hcoeff
    rw [Polynomial.coeff_X_pow k (q - 1), Polynomial.finset_sum_coeff] at hcoeff
    have hrhs : (∑ c ∈ U_C,
        (Polynomial.C (Polynomial.eval (v_C c) (Polynomial.X ^ k) /
          ∏ γ ∈ U_C.erase c, (v_C c - v_C γ)) * Q_C c).coeff (q - 1)) =
        IntermediateField.inclusion hM_CK (traceLM F hM_CK (π₀ ^ k * δ_pi⁻¹)) := by
      rw [hact_trace_MCK (π₀ ^ k * δ_pi⁻¹)]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [Polynomial.coeff_C_mul, hQ_C_coeff c, mul_one, Polynomial.eval_X_pow, hact_term_C c k]
    rw [hrhs] at hcoeff
    apply (IntermediateField.inclusion hM_CK).injective
    change IntermediateField.inclusion hM_CK (traceLM F hM_CK (π₀ ^ k * δ_pi⁻¹)) =
      IntermediateField.inclusion hM_CK (if q - 1 = k then 1 else 0)
    rw [← hcoeff]
    split_ifs <;> simp
  obtain ⟨ϖ_MC, hϖ_MC⟩ := hval_surj_MC 1
  have hval_MC_pow : ∀ m : ℕ, valL F M_C (((ϖ_MC ^ m : M_Cˣ) : M_C)) = (m : ℤ) := by
    intro m
    induction m with
    | zero => simp [hval1_MC]
    | succ m ih =>
      rw [pow_succ, Units.val_mul, hval_mul_MC _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_MC]
      push_cast
      ring
  have hval_K_pow : ∀ m : ℕ, valL F K (((ϖ₀ ^ m : Kˣ) : K)) = (m : ℤ) := by
    intro m
    rw [Units.val_pow_eq_pow_val, (hval_pi₀_pow m).2]
  have h_approx : ∀ (n : ℕ) (w : K), P 0 w →
      ∃ (a : Fin e_MCK → M_C) (r : K),
        P (n : ℤ) r ∧
        w = (∑ j : Fin e_MCK, IntermediateField.inclusion hM_CK (a j) * (π₀ ^ (j : ℕ))) + r := by
    intro n w hw
    induction n with
    | zero =>
      refine ⟨fun _ => 0, w, hw, ?_⟩
      simp
    | succ n ih =>
      obtain ⟨a, r, hr_n, hw_eq⟩ := ih
      let q_n : ℕ := n / e_MCK
      let r_n : ℕ := n % e_MCK
      have hdiv_mod : e_MCK * q_n + r_n = n := Nat.div_add_mod n e_MCK
      have hdiv_mod_Z : (e_MCK : ℤ) * (q_n : ℤ) + (r_n : ℤ) = (n : ℤ) := by
        exact_mod_cast hdiv_mod
      have hr_n_lt : r_n < e_MCK := Nat.mod_lt n he_pos
      let j₀ : Fin e_MCK := ⟨r_n, hr_n_lt⟩
      let u_MC : M_Cˣ := ϖ_MC ^ q_n
      let u_K : Kˣ := ϖ₀ ^ r_n
      let π_n : K := IntermediateField.inclusion hM_CK (u_MC : M_C) * (u_K : K)
      let π_n_inv : K :=
        IntermediateField.inclusion hM_CK ((u_MC⁻¹ : M_Cˣ) : M_C) * ((u_K⁻¹ : Kˣ) : K)
      have hπ_n_mul : π_n * π_n_inv = 1 := by
        dsimp [π_n, π_n_inv]
        have h1 : IntermediateField.inclusion hM_CK (u_MC : M_C) *
            IntermediateField.inclusion hM_CK ((u_MC⁻¹ : M_Cˣ) : M_C) = 1 := by
          rw [← map_mul (IntermediateField.inclusion hM_CK), Units.mul_inv, map_one]
        have h2 : (u_K : K) * ((u_K⁻¹ : Kˣ) : K) = 1 := Units.mul_inv u_K
        calc (IntermediateField.inclusion hM_CK (u_MC : M_C) * (u_K : K)) *
              (IntermediateField.inclusion hM_CK ((u_MC⁻¹ : M_Cˣ) : M_C) * ((u_K⁻¹ : Kˣ) : K))
            = (IntermediateField.inclusion hM_CK (u_MC : M_C) *
                IntermediateField.inclusion hM_CK ((u_MC⁻¹ : M_Cˣ) : M_C)) *
              ((u_K : K) * ((u_K⁻¹ : Kˣ) : K)) := by ring
          _ = 1 * 1 := by rw [h1, h2]
          _ = 1 := mul_one 1
      have hπ_n_inv_mul : π_n_inv * π_n = 1 := by
        rw [mul_comm, hπ_n_mul]
      have hu_MC_inc_ne0 : IntermediateField.inclusion hM_CK (u_MC : M_C) ≠ 0 :=
        (map_ne_zero (IntermediateField.inclusion hM_CK)).mpr (Units.ne_zero u_MC)
      have hu_MC_inv_inc_ne0 : IntermediateField.inclusion hM_CK ((u_MC⁻¹ : M_Cˣ) : M_C) ≠ 0 :=
        (map_ne_zero (IntermediateField.inclusion hM_CK)).mpr (Units.ne_zero u_MC⁻¹)
      have hP_π_n : P (n : ℤ) π_n := by
        right
        dsimp [π_n]
        rw [hval_mul_K _ _ hu_MC_inc_ne0 (Units.ne_zero u_K),
          hincl_e (u_MC : M_C), hval_MC_pow q_n, hval_K_pow r_n]
        linarith
      have hP_π_n_inv : P (-(n : ℤ)) π_n_inv := by
        right
        dsimp [π_n_inv]
        rw [hval_mul_K _ _ hu_MC_inv_inc_ne0 (Units.ne_zero u_K⁻¹),
          hincl_e ((u_MC⁻¹ : M_Cˣ) : M_C), hval_inv_MC u_MC, hval_MC_pow q_n,
          hval_inv_K u_K, hval_K_pow r_n]
        linarith
      set y : K := r * π_n_inv
      have hy0 : P 0 y := by
        have h1 := hP_mul hr_n hP_π_n_inv
        simpa using h1
      obtain ⟨z₀, _, hy_z₀⟩ := hResLiftK y hy0
      set r' : K := (y - IntermediateField.inclusion hM_CK z₀) * π_n
      have hr'_n1 : P (n + 1 : ℤ) r' := by
        have h1 := hP_mul hy_z₀ hP_π_n
        simpa [add_comm] using h1
      have hu_K_eq : (u_K : K) = π₀ ^ (j₀ : ℕ) := Units.val_pow_eq_pow_val ϖ₀ r_n
      have hr_decomp : r =
          IntermediateField.inclusion hM_CK (z₀ * (u_MC : M_C)) * (π₀ ^ (j₀ : ℕ)) + r' := by
        dsimp [r', y, π_n]
        rw [sub_mul, mul_assoc r π_n_inv, hπ_n_inv_mul, mul_one,
          map_mul (IntermediateField.inclusion hM_CK), hu_K_eq]
        ring
      let a' : Fin e_MCK → M_C := fun j => a j + if j = j₀ then z₀ * (u_MC : M_C) else 0
      refine ⟨a', r', hr'_n1, ?_⟩
      have hsum_a' : (∑ j : Fin e_MCK, IntermediateField.inclusion hM_CK (a' j) * (π₀ ^ (j : ℕ))) =
          (∑ j : Fin e_MCK, IntermediateField.inclusion hM_CK (a j) * (π₀ ^ (j : ℕ))) +
            IntermediateField.inclusion hM_CK (z₀ * (u_MC : M_C)) * (π₀ ^ (j₀ : ℕ)) := by
        have h1 : ∀ j : Fin e_MCK,
            IntermediateField.inclusion hM_CK (a' j) * (π₀ ^ (j : ℕ)) =
              IntermediateField.inclusion hM_CK (a j) * (π₀ ^ (j : ℕ)) +
                if j = j₀ then
                  IntermediateField.inclusion hM_CK (z₀ * (u_MC : M_C)) * (π₀ ^ (j₀ : ℕ))
                else 0 := by
          intro j
          dsimp [a']
          rw [map_add, add_mul]
          congr 1
          split_ifs with hj
          · subst hj; rfl
          · rw [map_zero, zero_mul]
        simp_rw [h1, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, if_true]
      rw [hsum_a', add_assoc, ← hr_decomp, ← hw_eq]
  have he_eq_q : e_MCK = q := by
    have he_le_q : e_MCK ≤ q := by
      calc e_MCK ≤ e_MCK * f_MCK := Nat.le_mul_of_pos_right e_MCK hf_pos
        _ = q := hef_eq
    by_contra hne
    have he_lt_q : e_MCK < q := lt_of_le_of_ne he_le_q hne
    let N : ℕ := (q - 1) * (t + 1) + 1
    obtain ⟨a, r, hr_N, hw_eq⟩ := h_approx N (π₀ ^ (q - 1)) (hP_pow (q - 1) hP0_π₀)
    have hmul_eq : π₀ ^ (q - 1) * δ_pi⁻¹ =
        (∑ j : Fin e_MCK,
          IntermediateField.inclusion hM_CK (a j) * (π₀ ^ (j : ℕ) * δ_pi⁻¹)) +
          r * δ_pi⁻¹ := by
      calc π₀ ^ (q - 1) * δ_pi⁻¹
          = ((∑ j : Fin e_MCK, IntermediateField.inclusion hM_CK (a j) * (π₀ ^ (j : ℕ))) + r) *
              δ_pi⁻¹ := by rw [← hw_eq]
        _ = (∑ j : Fin e_MCK,
              IntermediateField.inclusion hM_CK (a j) * (π₀ ^ (j : ℕ) * δ_pi⁻¹)) +
              r * δ_pi⁻¹ := by
            rw [add_mul, Finset.sum_mul]
            congr 1
            refine Finset.sum_congr rfl (fun j _ => mul_assoc _ _ _)
    have htr_eq := congrArg (traceLM F hM_CK) hmul_eq
    rw [map_add (traceLM F hM_CK), map_sum (traceLM F hM_CK),
      hEuler (q - 1) (Nat.sub_lt hq_pos zero_lt_one), if_pos rfl] at htr_eq
    have hsum_zero : (∑ j : Fin e_MCK,
        traceLM F hM_CK (IntermediateField.inclusion hM_CK (a j) * (π₀ ^ (j : ℕ) * δ_pi⁻¹))) = 0 := by
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have hj_lt : (j : ℕ) < q := lt_trans j.2 he_lt_q
      have hj_ne : q - 1 ≠ (j : ℕ) := by
        have h1 : (j : ℕ) < e_MCK := j.2
        omega
      rw [htr_smul (a j), hEuler j.1 hj_lt, if_neg hj_ne, mul_zero]
    rw [hsum_zero, zero_add] at htr_eq
    have hincl_tr : (1 : K) = ∑ c : C, act c.1 (r * δ_pi⁻¹) := by
      calc (1 : K) = IntermediateField.inclusion hM_CK 1 := (map_one _).symm
        _ = IntermediateField.inclusion hM_CK (traceLM F hM_CK (r * δ_pi⁻¹)) := by rw [← htr_eq]
        _ = ∑ c : C, act c.1 (r * δ_pi⁻¹) := hact_trace_MCK (r * δ_pi⁻¹)
    have hrδ_P1 : P 1 (r * δ_pi⁻¹) := by
      have hδ_inv_P : P (-(((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ))) δ_pi⁻¹ :=
        Or.inr (le_of_eq hδ_pi_inv_val.symm)
      have h1 := hP_mul hr_N hδ_inv_P
      have hN_eq : (N : ℤ) + (-(((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ))) = 1 := by
        dsimp [N]
        push_cast
        ring
      rwa [hN_eq] at h1
    have hsum_P1 : ∀ (S : Finset C), P 1 (∑ c ∈ S, act c.1 (r * δ_pi⁻¹)) := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        rw [Finset.sum_empty]
        exact hP_zero 1
      | @insert c s hc ih =>
        rw [Finset.sum_insert hc]
        exact hP_add 1 ((hP_act 1 c.1 (r * δ_pi⁻¹)).mpr hrδ_P1) ih
    have h1_P1 : P 1 1 := by
      rw [hincl_tr]
      exact hsum_P1 Finset.univ
    rcases h1_P1 with h10 | h1_le
    · exact one_ne_zero h10
    · rw [hval1_K] at h1_le
      omega
  have hf_eq_1 : f_MCK = 1 := by
    rw [he_eq_q] at hef_eq
    nlinarith
  have hresK : resDeg F K = resDeg F M_C := by
    rw [hres_f, hf_eq_1, one_mul]
  have hqK : qL F K = qL F M_C := by
    unfold qL
    rw [hresK]
  have hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w := by
    intro w
    rw [hnorm_f w, hf_eq_1, Nat.cast_one, one_mul]
  have hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z := by
    intro z
    rw [hincl_e z, he_eq_q]
  refine ⟨hqK, hresK, hValNormK, hValAlgK, hResLiftK,
    t, G_sub 0, ht_ge1, hGi_norm 0, hC_le_G0, ?_, ?_, hJumpK_C⟩
  · intro g
    exact Iff.rfl
  · intro c hc w hw
    exact hC_le_Gt hc w hw

theorem ld_ch14_serre_commutator_and_tame_inertia_divisibility (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hp_prime : Nat.Prime (p F))
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp)
    (hq_eq : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (G : Type u) [Group G] [Fintype G] (C H G₀ : Subgroup G)
    (act : G → K → K) (act_MC : H → M_C → M_C)
    [C.Normal] [G₀.Normal]
    (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (hcard_C : Nat.card C = Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hG_mul : ∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1)
    (hact_one : ∀ w : K, act 1 w = w)
    (hact_mul : ∀ (g₁ g₂ : G) (w : K), act (g₁ * g₂) w = act g₁ (act g₂ w))
    (hact_ring : ∀ g : G,
      act g 0 = 0 ∧ act g 1 = 1 ∧
      (∀ w₁ w₂ : K,
        act g (w₁ + w₂) = act g w₁ + act g w₂ ∧
        act g (w₁ * w₂) = act g w₁ * act g w₂ ∧
        act g (-w₁) = -act g w₁))
    (hact_incl_L : ∀ (g : G) (x : L),
      act g (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x)
    (hact_val : ∀ (g : G) (w : K), valL F K (act g w) = valL F K w)
    (hact_MC_compat : ∀ (h : H) (z : M_C),
      IntermediateField.inclusion hM_CK (act_MC h z) =
        act h.1 (IntermediateField.inclusion hM_CK z))
    (hC_le_G₀ : C ≤ G₀)
    (hG₀_iff : ∀ g : G,
      g ∈ G₀ ↔ ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
        (act g w - w = 0 ∨ 1 ≤ valL F K (act g w - w)))
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (hC_le_Gt : ∀ c ∈ C, ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      (act c w - w = 0 ∨ (t + 1 : ℤ) ≤ valL F K (act c w - w)))
    (hJumpK_C : ∀ c ∈ C, c ≠ 1 → ∀ (ϖ_K : Kˣ), valL F K (ϖ_K : K) = 1 →
      (ϖ_K : K) - act c (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act c (ϖ_K : K)) = (t + 1 : ℤ))
    (h_gcd_roots_bound : ∀ (α : Type u) [Fintype α] (m n : ℕ), 0 < m →
      ∀ u : α → K,
        (∀ a : α, u a = 0 ∨ 0 ≤ valL F K (u a)) →
        (∀ a : α, (u a) ^ m - 1 = 0 ∨ 1 ≤ valL F K ((u a) ^ m - 1)) →
        (∀ a : α, (u a) ^ n - 1 = 0 ∨ 1 ≤ valL F K ((u a) ^ n - 1)) →
        (∀ a₁ a₂ : α, (u a₁ - u a₂ = 0 ∨ 1 ≤ valL F K (u a₁ - u a₂)) → a₁ = a₂) →
        Fintype.card α ≤ m.gcd n) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    ∃ (I_H : Subgroup H),
      I_H.Normal ∧
      1 ≤ Nat.card I_H ∧
      Nat.card I_H ∣ (q - 1) ∧
      ¬ (p F ∣ Nat.card I_H) ∧
      (∀ h : H,
        h ∈ I_H ↔ ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
          (act h.1 w - w = 0 ∨ 1 ≤ valL F K (act h.1 w - w))) ∧
      (∀ h : H,
        h ∈ I_H ↔ ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
          (act_MC h z - z = 0 ∨ 1 ≤ valL F M_C (act_MC h z - z))) ∧
      (∀ σ ∈ G₀, σ ∉ C →
        Function.Surjective (fun c : C =>
          (⟨σ * c.1 * σ⁻¹ * c.1⁻¹,
            C.mul_mem (‹C.Normal›.conj_mem c.1 c.2 σ) (C.inv_mem c.2)⟩ : C))) ∧
      (∀ e_MCL : ℕ,
        1 ≤ e_MCL →
        (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (e_MCL : ℤ) * valL F L x) →
        Nat.card I_H ∣ q * e_MCL) :=
by
  classical
  intro q
  have hq_gt1 : 1 < q := by
    change 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    rw [hq_eq]
    exact one_lt_pow₀ hp_prime.one_lt (by omega)
  have hq_pos : 0 < q := by omega
  have hcard_C_fintype : Fintype.card C = q :=
    Nat.card_eq_fintype_card.symm.trans hcard_C
  have h_valL_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      0 < resDeg F M ∧
      (∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x) ∧
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) := by
    clear! L K M_C hp_prime r_exp G t
    intro L _
    have halg : ∀ z : L,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F L = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq L.val L.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F L (-1) = 0 := by
      have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : L) * (-1 : L) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : L) = (-1 : L) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q : ℤ := valL F L x
        set r : ℤ := relVal F L x % f
        have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F L := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F L 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval1 : valL F L 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg1 : valL F L (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
      intro x
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L) := by
      intro u
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_surj : ∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m := by
      intro m
      refine ⟨ϖL ^ m, ?_⟩
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv, hrel_zpow ϖL m, hrel_ϖL, mul_comm]
    have hval_add : ∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : L,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : L, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F L z ≤ valL F L w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F L) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfL_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : L) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F L x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F L y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    exact ⟨hfL_pos, hdiv, hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩
  obtain ⟨_, _, _, _, _, _, _, _, hval_surj_L, _⟩ := h_valL_props L
  obtain ⟨_, _, hval0_MC, _, _, _, _, _, _, _⟩ := h_valL_props M_C
  obtain ⟨_, _, hval0_K, hval1_K, _, hval_neg_K, hval_mul_K, hval_inv_K, hval_surj_K, hval_add_K⟩ :=
