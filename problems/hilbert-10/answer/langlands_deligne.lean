  have hw₀_as : w₀ ^ p - w₀ = 0 ∨ -(p : ℤ) * (h₀ : ℤ) ≤ valL F E' (w₀ ^ p - w₀) :=
    hval_sub_E' (-(p : ℤ) * (h₀ : ℤ)) (w₀ ^ p) w₀ hw₀_p hw₀_ph₀
  have hx_sq_neg : -(x ^ 2) = 0 ∨ 2 * (d₂ : ℤ) ≤ valL F E' (-(x ^ 2)) := by
