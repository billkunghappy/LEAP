    (hΔ_coeff_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      ∀ (Y : Fin p → E') (m : ℤ),
        ((∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))) = 0 ∨
          m ≤ valL F K₁ (∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)))) ↔
        ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ))
