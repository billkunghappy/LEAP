        have hpbt := hvalM₁'_mul_ge
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + (-((p - 1 : ℕ) : ℤ) * (t₁ : ℤ)))
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ))
          (((p : ℕ) : R_M) * b ^ (p - 1)) (trM₁'K₁ W_Δ) hpb htr_W_Δ_val
        have hpbt_m0 :
            ((p : ℕ) : R_M) * b ^ (p - 1) * trM₁'K₁ W_Δ = 0 ∨
            m₀ ≤ vM₁' (((p : ℕ) : R_M) * b ^ (p - 1) * trM₁'K₁ W_Δ) := by
          refine hvalM₁'_mono m₀ _ _ ?_ hpbt
          linarith only [hm₀_def, hp1_t₁_le_t₂, h2t₁_le_p2t₁]
        rcases hpbt_m0 with h0 | hge
        · left; rw [h0, neg_zero]
        · right; rwa [hvalM₁'_neg]
      have hq_piece2 :
          (∑ r ∈ Finset.Icc 2 (p - 1),
            ((p.choose r : ℕ) : R_M) * b ^ (p - r) * trM₁'K₁ ((-W_Δ) ^ r)) = 0 ∨
          m₀ ≤ vM₁'
            (∑ r ∈ Finset.Icc 2 (p - 1),
              ((p.choose r : ℕ) : R_M) * b ^ (p - r) * trM₁'K₁ ((-W_Δ) ^ r)) := by
        apply hvalM₁'_sum_ge
        intro r hr
        obtain ⟨hr_mem, hpr_z, hr_z⟩ := hIcc_2_p1_idx r hr
        have hWr_val := hvalK₁_pow_ge (-W_Δ) r (-(t₁ : ℤ)) hnegW_Δ_val
        have htr_Wr : trM₁'K₁ ((-W_Δ) ^ r) = 0 ∨
            (0 : ℤ) ≤ vM₁' (trM₁'K₁ ((-W_Δ) ^ r)) := by
          apply htr_M₁'K₁_0 ((-W_Δ) ^ r)
          refine hvalK₁_mono _ _ _ ?_ hWr_val
          linarith only [hr_z]
        have hcb := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) (-((p - r : ℕ) : ℤ) * (t₁ : ℤ))
          ((p.choose r : ℕ) : R_M) (b ^ (p - r))
          (hchoose_valM₁' r hr_mem) (hb_pow_val (p - r))
        have hcbt := hvalM₁'_mul_ge
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + (-((p - r : ℕ) : ℤ) * (t₁ : ℤ))) 0
          (((p.choose r : ℕ) : R_M) * b ^ (p - r)) (trM₁'K₁ ((-W_Δ) ^ r))
