    change ((p : ℕ) : E') = 0 ∨
      ((1 : ℤ) ≤ valL F E' ((p : ℕ) : E') ∧
        (m₂ : ℤ) - 2 * (d₁ : ℤ) ≤ valL F E' ((p : ℕ) : E'))
    rcases hp_valK₁ with hp0 | hpv
    · left
      apply (IntermediateField.inclusion hE'K₁).injective
      rw [map_natCast, map_zero]
