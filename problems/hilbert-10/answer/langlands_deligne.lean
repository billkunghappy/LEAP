  let F₀ : IntermediateField F (AlgebraicClosure F) := (D_orb.get i₀).field
  haveI : FiniteDimensional F F₀ := hFinFi i₀
  obtain ⟨f₀, _, hdeg₀⟩ := hFi_deg i₀
  have h_mul_LMC : Module.finrank F L *
      (Module.finrank L (IntermediateField.extendScalars (D_orb.get i₀).le) *
        Module.finrank F₀ (IntermediateField.extendScalars (hFiMC i₀))) =
      Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM_C) := by
    rw [← mul_assoc, hfinrank_tower L F₀ (D_orb.get i₀).le,
      hfinrank_tower F₀ M_C (hFiMC i₀), hfinrank_tower L M_C hLM_C]
  have h_LMC_eq : Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i₀).le) *
        Module.finrank F₀ (IntermediateField.extendScalars (hFiMC i₀)) :=
    (Nat.eq_of_mul_eq_mul_left Module.finrank_pos h_mul_LMC).symm
  have hk_dvd_LMC : k ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) := by
    refine ⟨f₀ * Module.finrank F₀ (IntermediateField.extendScalars (hFiMC i₀)), ?_⟩
    rw [h_LMC_eq, hdeg₀, mul_assoc]
  have hk_even_or1 : k = 1 ∨ 2 ∣ k := by
    by_cases hk1 : k = 1
    · exact Or.inl hk1
    · right
      obtain ⟨q₀, hq₀_prime, hq₀_dvd_k⟩ := Nat.exists_prime_and_dvd hk1
      have hq₀_dvd_LMC : q₀ ∣ Module.finrank L (IntermediateField.extendScalars hLM_C) :=
        dvd_trans hq₀_dvd_k hk_dvd_LMC
      rcases hBranch2.2 q₀ hq₀_prime hq₀_dvd_LMC with rfl | rfl
      · exact hq₀_dvd_k
      · exfalso
        have hp_dvd_sub : p F ∣ q_MCK - 1 := dvd_trans hq₀_dvd_k hk_dvd
        have hp_dvd_q : p F ∣ q_MCK := by
          rw [hq_eq]
          exact dvd_pow_self (p F) (by omega)
        have hq_add : (q_MCK - 1) + 1 = q_MCK := by omega
        rw [← hq_add] at hp_dvd_q
