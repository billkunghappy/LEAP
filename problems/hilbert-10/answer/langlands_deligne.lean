        ∃ (H_B : Subgroup H)
          (M_B : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
          (ψ_B : M_B →* (Ω F)ˣ),
          (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).Wf F A ∧
          H_B ≤ H_A ∧
          (∀ h : H, h ∈ H_B ↔
            ∀ x : IntermediateField.extendScalars hLK,
