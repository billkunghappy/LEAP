        ring
    · intro u w
      have heq : w - algebraMap K S u = algebraMap K S (-u) + w := by
        rw [map_neg]
        ring
      rw [heq, hnorm_add (-u) w]
      ring
  have hfinrank_two : ∀ (M₂ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M₂]
      (h : L ≤ M₂),
      (∀ w : M₂, valL F L (normLM F h w) = valL F M₂ w) →
      (∀ c : L, valL F M₂ (IntermediateField.inclusion h c) = 2 * valL F L c) →
      Module.finrank L (IntermediateField.extendScalars h) = 2 := by
    intro M₂ _ h hval_norm hval_incl
    obtain ⟨ϖ, hϖ⟩ := hvalL_props.2.2.2.2.2.2.1 1
    have hϖ_pow : ∀ n : ℕ, valL F L ((ϖ : L) ^ n) = (n : ℤ) := by
      intro n
      induction' n with n ih
      · simp [hvalL_props.2.1]
      · rw [pow_succ,
