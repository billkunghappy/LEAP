  obtain ⟨htE', htE'_val, hcνE'_rest⟩ := hcνE'_pkg (traceLM F hE'K₁ (C : K₁)) hnorm_trE'
  obtain ⟨hcνE'_val, hcνE'_stat⟩ := hcνE'_rest htE'
  have hnorm_trM₁' : normLM F hLM₁' (traceLM F hM₁'K₁ (C : K₁)) = β₁ + (4 * c₀ + 4 * c₀ ^ 2) := by
    rw [hC_coe, htrM₁'_eq]
    have hntM₁' : normLM F hLM₁' (h₁ - IntermediateField.inclusion hLM₁' p_X) = β₁ + 4 * c₀ + 4 * c₀ ^ 2 := hnorm_tr_M₁'
    rw [hntM₁']
    ring
  obtain ⟨htM₁', htM₁'_val, hcνM₁'_rest⟩ := hcνM₁'_pkg (traceLM F hM₁'K₁ (C : K₁)) hnorm_trM₁'
  obtain ⟨hcνM₁'_val, hcνM₁'_stat⟩ := hcνM₁'_rest htM₁'
  let cE' : E'ˣ :=
    Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
