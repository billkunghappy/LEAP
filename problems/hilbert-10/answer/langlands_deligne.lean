      have hp1 : 1 + (p - 1) = p := by omega
      have hb_eq : bM₁' + (bE' - bM₁') = bE' := by omega
      have hbM₁'_sub2 : bM₁' - 2 + 2 = bM₁' := by omega
      have h2b : 2 * bM₁' - 2 = bM₁' + (bM₁' - 2) := by omega
