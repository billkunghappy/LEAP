    · left; exact h0
    · right; linarith
  let termE' : ℕ → E' := fun r =>
    (-1 : E') ^ (r - 1) * IntermediateField.inclusion hLE' (s w₀ r) * w₀ ^ (p - r) * (2 * x)
  have hR₁_eq : R₁ = ∑ r ∈ Finset.Icc 1 (p - 1), termE' r := by
    dsimp [R₁, termE']
    have hsub : w₀ ^ p - IntermediateField.inclusion hLE' (normLM F hLE' w₀) =
