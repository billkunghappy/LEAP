    ring
  have hβ₁_val : valL F L β₁ = 2 * ((e : ℤ) - (a : ℤ)) + 1 := by
    have hβ₁_eq : β₁ = -(4 * f) := by dsimp [β₁]; ring
    rw [hβ₁_eq, hneg, hmul (4 : L) f h4_ne hf_ne, h4_val, hf_val]
    dsimp [a]
    ring
  have hβ₂_val : valL F L β₂ = 0 := by
    have hβ₂_eq : β₂ = 1 + (-ρ) := by dsimp [β₂]; ring
    have hneg_ρ_b : -ρ = 0 ∨ 2 * (e : ℤ) + 1 - 2 * (a : ℤ) ≤ valL F L (-ρ) := by
      right
      rw [hneg, hρ_val]
    rw [hβ₂_eq]
    exact (hL_eq_lt 0 (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) 1 (-ρ) one_ne_zero h1 hneg_ρ_b (by omega)).2
  let a_ceil : ℕ := (a + 1) / 2
  have ha_ceil : 2 * a_ceil = a ∨ 2 * a_ceil = a + 1 := by dsimp [a_ceil]; omega
  have h4_b : (4 : L) = 0 ∨ 2 * (e : ℤ) ≤ valL F L (4 : L) := Or.inr (by rw [h4_val])
  have hc₀_b : c₀ = 0 ∨ 1 - (a_ceil : ℤ) ≤ valL F L c₀ := hc₀_val
  have h4c₀_b : 4 * c₀ = 0 ∨ 2 * (e : ℤ) + 1 - (a : ℤ) ≤ valL F L (4 * c₀) :=
    (hL_mul_b _ _ (4 : L) c₀ h4_b hc₀_b).imp id (fun h => by omega)
  have hc₀_sq_b : c₀ ^ 2 = 0 ∨ 2 * (1 - (a_ceil : ℤ)) ≤ valL F L (c₀ ^ 2) := by
    rw [sq]
