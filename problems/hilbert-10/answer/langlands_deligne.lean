theorem ld_ch12_wild_odd_tot_ram_finite_interpolation_and_conj_sums (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLM₁' : IsGaloisExt F L M₁') (hGalE'K₁ : IsGaloisExt F E' K₁)
    (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))))
    (hΔ_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')))
    (hTwistedTr : ∀ (Y : E') (i : ℕ),
      i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_poly : ∀ c : M₁',
      normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * (Δ : K₁)) =
        1 + (∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          c ^ i * e_Δ i) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLE')) *
            normLM F hM₁'K₁ (Δ : K₁))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hT_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₂ := bE' - 1
    let m := a_lam - bE'
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let s := - e_Δ (p - 1)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let n := IntermediateField.inclusion hLM₁' u * b
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let W_fn : ℕ → E' := fun i =>
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
    let Q_quad : E' :=
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
          (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
    let W_K₁ := IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' W)
    let u_M₁' := IntermediateField.inclusion hLM₁' u
    let L_val := W_K₁ + IntermediateField.inclusion hM₁'K₁ b
    let D_norm := L_val ^ p - L_val
    let A_star := (Δ : K₁) - L_val
    L_val ≠ 0 ∧ D_norm ≠ 0 ∧
    valL F K₁ L_val = -(((p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ D_norm = -(((p * p * p * m : ℕ) : ℤ)) ∧
    valL F K₁ A_star = -(((p * p * m : ℕ) : ℤ)) ∧
    (∀ i ∈ Finset.Icc 1 (p - 1),
      let W_interp :=
        ((p - 1 : ℕ) : K₁) * W_K₁ *
            IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
            (if i = p - 1 then 1 else 0) -
          ((p - 1 : ℕ) : K₁) * W_K₁ ^ 2 *
            IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i) *
            A_star ^ i * D_norm⁻¹ -
          ((p - 1 : ℕ) : K₁) *
            IntermediateField.inclusion hM₁'K₁ (s * (1 + u_M₁' * b)⁻¹ ^ 2) *
            (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 2)) *
                (if i = p - 2 then 1 else 0) +
              ((i : ℕ) : K₁) *
                IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
                (Δ : K₁) * (if i = p - 1 then 1 else 0))
      IntermediateField.inclusion hE'K₁ (W_fn i) - W_interp = 0 ∨
        ((1 + p * t₂ : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hE'K₁ (W_fn i) - W_interp)) ∧
    (let Q_interp :=
       ((p - 1 : ℕ) : K₁) *
         IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
         IntermediateField.inclusion hM₁'K₁ T * W_K₁ ^ 2 *
         A_star ^ (p - 2) * ((Δ : K₁) - IntermediateField.inclusion hM₁'K₁ b) * D_norm⁻¹
     IntermediateField.inclusion hE'K₁ Q_quad - Q_interp = 0 ∨
       ((1 + p * t₂ : ℕ) : ℤ) ≤
         valL F K₁ (IntermediateField.inclusion hE'K₁ Q_quad - Q_interp)) :=
by
  intro p t₂ m b s u W z n T W_fn Q_quad W_K₁ u_M₁' L_val D_norm A_star
  obtain ⟨_, _, _, _, hvalL_mul, hvalL_inv, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, _, _, _, _, hvalE'_inv, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  obtain ⟨hvalM₁'_0, hvalM₁'_1, _, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv, _, hvalM₁'_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M₁'
  obtain ⟨_, hvalK₁_1, _, hvalK₁_neg, hvalK₁_mul, _, _, hvalK₁_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F K₁
  obtain ⟨ξ, Δ_conj, hξ0, hΔ_conj0, hξ_props, hξ_pow_sum, hΔ_conj_val,
      hW_conj_sum, hQ_conj_sum, hTr_top_conj_sum, hΔ_conj_approx⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_teichmuller_conj_trace_and_norm_approx F L E' M₁' K₁
