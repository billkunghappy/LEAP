        set q : ℤ := valL F M z
        set r : ℤ := relVal F M z % f
        have hediv : f * q + r = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M z) hfM_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
