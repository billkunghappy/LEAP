        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F B : ℤ)
        set q : ℤ := valL F B x
        set r : ℤ := relVal F B x % f
        have hediv : f * q + r = relVal F B x := Int.mul_ediv_add_emod (relVal F B x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F B x) hfB_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F B x) hfB_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : B := x * (((ϖB ^ (-q) : Bˣ) : B))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F B y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖB (-q), hrel_ϖB]
            linarith
          let k_r : ℕ := r.toNat
          have hk_eq : (k_r : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k_r := by omega
          have hk_lt : k_r < resDeg F B := by omega
          have hk_mem : k_r ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F B ≤ k_r := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F B 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfB_int_ne
    have hval1 : valL F B 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfB_int_ne
    have hval_neg1 : valL F B (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfB_int_ne
    have hval_neg : ∀ x : B, valL F B (-x) = valL F B x := by
      intro x
      apply mul_left_cancel₀ hfB_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfB_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B) := by
      intro u
      apply mul_left_cancel₀ hfB_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_surj : ∀ m : ℤ, ∃ c : Bˣ, valL F B (c : B) = m := by
      intro m
      refine ⟨ϖB ^ m, ?_⟩
      apply mul_left_cancel₀ hfB_int_ne
      rw [← hdiv, hrel_zpow ϖB m, hrel_ϖB, mul_comm]
    have hval_add : ∀ (k_val : ℤ) (x y : B),
        (x = 0 ∨ k_val ≤ valL F B x) → (y = 0 ∨ k_val ≤ valL F B y) →
          (x + y = 0 ∨ k_val ≤ valL F B (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : B,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F B) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : B, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F B z ≤ valL F B w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F B) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F B) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfB_int_pos hrel_le
      intro k_val x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : B) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k_val ≤ valL F B x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k_val ≤ valL F B y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    have hgen_val0 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Bˣ,
        ((u : B) = 1 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1)) → valL F B (u : B) = 0 := by
      intro a ha u hu
      rcases hu with hu1 | hua
      · rw [hu1, hval1]
      · have h_ge0 : (0 : ℤ) ≤ valL F B (u : B) := by
          have hadd := hval_add 0 ((u : B) - 1) 1 (Or.inr (by omega)) (Or.inr (by rw [hval1]))
          have heq : ((u : B) - 1) + 1 = (u : B) := sub_add_cancel (u : B) 1
          rw [heq] at hadd
          exact hadd.resolve_left (Units.ne_zero u)
        have h_le0 : valL F B (u : B) ≤ 0 := by
          by_contra hlt
          have hge1 : (1 : ℤ) ≤ valL F B (-(u : B)) := by
            rw [hval_neg]
            omega
          have hadd := hval_add 1 ((u : B) - 1) (-(u : B)) (Or.inr (by omega)) (Or.inr hge1)
          have heq : ((u : B) - 1) + (-(u : B)) = -1 := by ring
          rw [heq, hval_neg1] at hadd
          have hne : (-1 : B) ≠ 0 := neg_ne_zero.mpr one_ne_zero
          have h10 : (1 : ℤ) ≤ 0 := hadd.resolve_left hne
          omega
        omega
    have hunit0 : ∀ u : Bˣ, u ∈ unitGroup F B 0 ↔ valL F B (u : B) = 0 := by
      let H₀ : Subgroup Bˣ := {
        carrier := {u : Bˣ | valL F B (u : B) = 0}
        one_mem' := by
          change valL F B ((1 : Bˣ) : B) = 0
          rw [Units.val_one, hval1]
        mul_mem' := by
          intro u v hu hv
          change valL F B ((u * v : Bˣ) : B) = 0
          rw [Units.val_mul, hval_mul _ _ (Units.ne_zero u) (Units.ne_zero v), hu, hv, add_zero]
        inv_mem' := by
          intro u hu
          change valL F B ((u⁻¹ : Bˣ) : B) = 0
          rw [hval_inv u, hu, neg_zero]
      }
      have hcl_le : unitGroup F B 0 ≤ H₀ := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [H₀] using hu
      have hle_cl : H₀ ≤ unitGroup F B 0 := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [H₀] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_ge1 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Bˣ,
        u ∈ unitGroup F B a ↔ ((u : B) = 1 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1)) := by
      intro a ha
      have ha0 : a ≠ 0 := by omega
      let Ha : Subgroup Bˣ := {
        carrier := {u : Bˣ | (u : B) = 1 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1)}
        one_mem' := Or.inl Units.val_one
        mul_mem' := by
          intro u v hu hv
          change ((u * v : Bˣ) : B) = 1 ∨ (a : ℤ) ≤ valL F B (((u * v : Bˣ) : B) - 1)
          have hu0 : valL F B (u : B) = 0 := hgen_val0 a ha u hu
          have hterm1 : (u : B) * ((v : B) - 1) = 0 ∨
              (a : ℤ) ≤ valL F B ((u : B) * ((v : B) - 1)) := by
            by_cases hsub : (v : B) - 1 = 0
            · left
              rw [hsub, mul_zero]
            · right
              have hv1 : (v : B) ≠ 1 := sub_ne_zero.mp hsub
              have hva : (a : ℤ) ≤ valL F B ((v : B) - 1) := hv.resolve_left hv1
              rw [hval_mul (u : B) ((v : B) - 1) (Units.ne_zero u) hsub, hu0, zero_add]
              exact hva
          have hterm2 : (u : B) - 1 = 0 ∨ (a : ℤ) ≤ valL F B ((u : B) - 1) := by
            rcases hu with hu1 | hua
            · exact Or.inl (sub_eq_zero.mpr hu1)
            · exact Or.inr hua
          have hadd := hval_add (a : ℤ) ((u : B) * ((v : B) - 1)) ((u : B) - 1) hterm1 hterm2
          have hsplit : (u : B) * ((v : B) - 1) + ((u : B) - 1) = ((u * v : Bˣ) : B) - 1 := by
            rw [Units.val_mul]
            ring
          rw [hsplit] at hadd
          rcases hadd with h0 | hle
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hle
        inv_mem' := by
          intro u hu
          change ((u⁻¹ : Bˣ) : B) = 1 ∨ (a : ℤ) ≤ valL F B (((u⁻¹ : Bˣ) : B) - 1)
          have hu0 : valL F B (u : B) = 0 := hgen_val0 a ha u hu
          have hu_inv0 : valL F B ((u⁻¹ : Bˣ) : B) = 0 := by
            rw [hval_inv u, hu0, neg_zero]
          have hinv_split : (((u⁻¹ : Bˣ) : B) - 1) = - (((u⁻¹ : Bˣ) : B) * ((u : B) - 1)) := by
            have hmul : ((u⁻¹ : Bˣ) : B) * (u : B) = 1 := Units.inv_mul u
            linear_combination hmul
          by_cases hsub : (u : B) - 1 = 0
          · left
            apply sub_eq_zero.mp
            rw [hinv_split, hsub, mul_zero, neg_zero]
          · right
            have hu1 : (u : B) ≠ 1 := sub_ne_zero.mp hsub
            have hua : (a : ℤ) ≤ valL F B ((u : B) - 1) := hu.resolve_left hu1
            rw [hinv_split, hval_neg,
              hval_mul ((u⁻¹ : Bˣ) : B) ((u : B) - 1) (Units.ne_zero u⁻¹) hsub,
              hu_inv0, zero_add]
            exact hua
      }
      have hcl_le : unitGroup F B a ≤ Ha := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [Ha, ha0] using hu
      have hle_cl : Ha ≤ unitGroup F B a := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [Ha, ha0] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_val0 : ∀ (a : ℕ) (u : Bˣ), u ∈ unitGroup F B a → valL F B (u : B) = 0 := by
      intro a u hu
      by_cases ha : a = 0
      · rw [ha] at hu
        exact (hunit0 u).mp hu
      · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
        exact hgen_val0 a ha1 u ((hunit_ge1 a ha1 u).mp hu)
    have hp_valB : ((p F : ℕ) : B) = 0 ∨ 1 ≤ valL F B ((p F : ℕ) : B) := by
      have hres0 : IsLocalRing.residue 𝒪[F] ((p F : ℕ) : 𝒪[F]) = 0 := by
        rw [map_natCast]
        exact CharP.cast_eq_zero 𝓀[F] (p F)
      have hker : valuation F (((p F : ℕ) : 𝒪[F]) : F) < 1 := by
        rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
      by_cases hp0 : ((p F : ℕ) : F) = 0
      · left
        rw [← map_natCast (algebraMap F B) (p F), hp0, map_zero]
      · right
        have hφp : φ (valuation F ((p F : ℕ) : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
        have hlt : φ (valuation F ((p F : ℕ) : F)) < 1 := by
          rw [← map_one φ, map_lt_map_iff φ]
          exact hker
        rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
          ← Multiplicative.toAdd_lt, toAdd_one] at hlt
        have hpF1 : 1 ≤ addVal F ((p F : ℕ) : F) := by
          unfold addVal
          rw [dif_neg hp0]
          omega
        have hvalL_alg : valL F B (algebraMap F B ((p F : ℕ) : F)) =
            ((Module.finrank F B : ℤ) * addVal F ((p F : ℕ) : F)) / (resDeg F B : ℤ) := by
          unfold valL relVal
          rw [Algebra.norm_algebraMap, haddVal_pow ((p F : ℕ) : F) (Module.finrank F B) hp0]
        rw [← map_natCast (algebraMap F B) (p F), hvalL_alg]
        have hfB_leZ : (resDeg F B : ℤ) ≤ (Module.finrank F B : ℤ) := Nat.cast_le.mpr hfB_le
        exact Int.le_ediv_of_mul_le hfB_int_pos (by nlinarith)
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
      hval_add, hunit0, hunit_ge1, hunit_val0, hp_valB⟩

  
  have hcond_spec : condExp F L χ' ≠ 0 →
      (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
      (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1) := by
    intro ha
    set Sχ : Set ℕ := {a : ℕ | ∀ u ∈ unitGroup F L a, χ' u = 1}
    have hne_χ : Sχ.Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro hemp
      apply ha
      change sInf Sχ = 0
      exact Nat.sInf_eq_zero.mpr (Or.inr hemp)
    have hmem_χ : condExp F L χ' ∈ Sχ := Nat.sInf_mem hne_χ
    have hnot_χ : condExp F L χ' - 1 ∉ Sχ := by
      have hlt : condExp F L χ' - 1 < sInf Sχ := by
        change condExp F L χ' - 1 < condExp F L χ'
        omega
      exact notMem_of_lt_csInf hlt (OrderBot.bddBelow Sχ)
    change ¬ (∀ u ∈ unitGroup F L (condExp F L χ' - 1), χ' u = 1) at hnot_χ
    push_neg at hnot_χ
    exact ⟨hmem_χ, hnot_χ⟩

  
  let PB (B : IntermediateField F (AlgebraicClosure F)) (m : ℤ) (z : B) : Prop :=
    z = 0 ∨ m ≤ valL F B z
  have hPB_zero : ∀ (B : IntermediateField F (AlgebraicClosure F)) (m : ℤ), PB B m 0 :=
    fun _ _ => Or.inl rfl
  have hPB_one : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B],
      PB B 0 1 := by
    intro B _
    right
    rw [(h_valL_pkg B).2.1]
  have hPB_mono : ∀ (B : IntermediateField F (AlgebraicClosure F)) {m₁ m₂ : ℤ} {z : B},
      m₁ ≤ m₂ → PB B m₂ z → PB B m₁ z := by
    intro B m₁ m₂ z hle hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hz)
  have hPB_neg : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      {m : ℤ} {z : B}, PB B m z → PB B m (-z) := by
    intro B _ m z hz
    rcases hz with rfl | hz
    · exact Or.inl neg_zero
    · right
      rw [(h_valL_pkg B).2.2.2.1]
      exact hz
  have hPB_add : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      {m : ℤ} {z₁ z₂ : B}, PB B m z₁ → PB B m z₂ → PB B m (z₁ + z₂) := by
    intro B _ m z₁ z₂ hz₁ hz₂
    exact (h_valL_pkg B).2.2.2.2.2.2.2.1 m z₁ z₂ hz₁ hz₂
  have hPB_sub : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      {m : ℤ} {z₁ z₂ : B}, PB B m z₁ → PB B m z₂ → PB B m (z₁ - z₂) := by
    intro B _ m z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    exact hPB_add B hz₁ (hPB_neg B hz₂)
  have hPB_mul : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      {m₁ m₂ : ℤ} {z₁ z₂ : B}, PB B m₁ z₁ → PB B m₂ z₂ → PB B (m₁ + m₂) (z₁ * z₂) := by
    intro B _ m₁ m₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · left; rw [hz₁0, zero_mul]
    · by_cases hz₂0 : z₂ = 0
      · left; rw [hz₂0, mul_zero]
      · right
        rw [(h_valL_pkg B).2.2.2.2.1 z₁ z₂ hz₁0 hz₂0]
        have h1 := hz₁.resolve_left hz₁0
        have h2 := hz₂.resolve_left hz₂0
        omega
  have hPB_pow0 : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      {z : B} (n : ℕ), PB B 0 z → PB B 0 (z ^ n) := by
    intro B _ z n hz
    induction n with
    | zero =>
      rw [pow_zero]
      exact hPB_one B
    | succ n ih =>
      rw [pow_succ, ← zero_add (0 : ℤ)]
      exact hPB_mul B ih hz
  have hPB_nat : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (n : ℕ), PB B 0 (n : B) := by
    intro B _ n
    induction n with
    | zero =>
      rw [Nat.cast_zero]
      exact hPB_zero B 0
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hPB_add B ih (hPB_one B)
  have hval_pow : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (z : B) (n : ℕ), z ≠ 0 → valL F B (z ^ n) = (n : ℤ) * valL F B z := by
    intro B _ z n hz
    induction n with
    | zero =>
      rw [pow_zero, (h_valL_pkg B).2.1]
      simp
    | succ n ih =>
      rw [pow_succ, (h_valL_pkg B).2.2.2.2.1 (z ^ n) z (pow_ne_zero n hz) hz, ih]
      push_cast
      ring
  have hval_zpow : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (u : Bˣ) (m : ℤ), valL F B ((u ^ m : Bˣ) : B) = m * valL F B (u : B) := by
    intro B _ u m
    cases m with
    | ofNat n =>
      change valL F B (((u ^ (n : ℤ) : Bˣ) : B)) = (n : ℤ) * valL F B (u : B)
      rw [zpow_natCast, Units.val_pow_eq_pow_val, hval_pow B (u : B) n (Units.ne_zero u)]
    | negSucc n =>
      rw [zpow_negSucc, (h_valL_pkg B).2.2.2.2.2.1 (u ^ (n + 1)),
        Units.val_pow_eq_pow_val, hval_pow B (u : B) (n + 1) (Units.ne_zero u), Int.negSucc_eq]
      push_cast
      ring
  have hPB_eq_val0 : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      {z w : B}, z ≠ 0 → valL F B z = 0 → PB B 1 (z - w) → w ≠ 0 ∧ valL F B w = 0 := by
    intro B _ z w hz_ne hz_val hdiff
    have hw_ne : w ≠ 0 := by
      rintro rfl
      rw [sub_zero] at hdiff
      have h1 : 1 ≤ valL F B z := hdiff.resolve_left hz_ne
      omega
    have hz_0 : PB B 0 z := Or.inr (by omega)
    have hdiff_0 : PB B 0 (z - w) := hPB_mono B (by omega) hdiff
    have hw_0 : PB B 0 w := by
      have h := hPB_sub B hz_0 hdiff_0
      have heq : z - (z - w) = w := by ring
      rwa [heq] at h
    have hw_ge0 : 0 ≤ valL F B w := hw_0.resolve_left hw_ne
    have hw_le0 : valL F B w ≤ 0 := by
      by_contra hlt
      have hw_1 : PB B 1 w := Or.inr (by omega)
      have hz_1 : PB B 1 z := by
        have h := hPB_add B hdiff hw_1
        have heq : (z - w) + w = z := sub_add_cancel z w
        rwa [heq] at h
      have h1 : 1 ≤ valL F B z := hz_1.resolve_left hz_ne
      omega
    exact ⟨hw_ne, by omega⟩

  
  have hPMC_pow_sub : ∀ (n : ℕ) (x y : M_C),
      PB M_C 0 x → PB M_C 0 y → PB M_C 1 (x - y) → PB M_C 1 (x ^ n - y ^ n) := by
    intro n x y hx hy hxy
    induction n with
    | zero =>
      rw [pow_zero, pow_zero, sub_self]
      exact hPB_zero M_C 1
    | succ n ih =>
      have h_ident : x ^ (n + 1) - y ^ (n + 1) = x * (x ^ n - y ^ n) + (x - y) * y ^ n := by ring
      rw [h_ident]
      have h1 : PB M_C 1 (x * (x ^ n - y ^ n)) := by
        have h := hPB_mul M_C hx ih
        rwa [zero_add] at h
      have h2 : PB M_C 1 ((x - y) * y ^ n) := by
        have h := hPB_mul M_C hxy (hPB_pow0 M_C n hy)
        rwa [add_zero] at h
      exact hPB_add M_C h1 h2
  have hFrobIterMC : ∀ (m : ℕ) (z : M_C),
      PB M_C 0 z → ∃ s : M_C, PB M_C 0 s ∧ PB M_C 1 (z - s ^ ((p F) ^ m)) := by
    intro m
    induction m with
    | zero =>
      intro z hz
      refine ⟨z, hz, ?_⟩
      rw [pow_zero, pow_one, sub_self]
      exact hPB_zero M_C 1
    | succ m ih =>
      intro z hz
      obtain ⟨s₁, hs₁_0, hz_s₁⟩ := ih z hz
      obtain ⟨s, hs_0, hs₁_s⟩ := hFrobSurjMC s₁ hs₁_0
      refine ⟨s, hs_0, ?_⟩
      have hsp_0 : PB M_C 0 (s ^ (p F)) := hPB_pow0 M_C (p F) hs_0
      have hpow_diff : PB M_C 1 (s₁ ^ ((p F) ^ m) - (s ^ (p F)) ^ ((p F) ^ m)) :=
        hPMC_pow_sub ((p F) ^ m) s₁ (s ^ (p F)) hs₁_0 hsp_0 hs₁_s
      rw [← pow_mul, ← pow_succ'] at hpow_diff
      have hsum := hPB_add M_C hz_s₁ hpow_diff
      have heq : (z - s₁ ^ ((p F) ^ m)) + (s₁ ^ ((p F) ^ m) - s ^ ((p F) ^ (m + 1))) =
          z - s ^ ((p F) ^ (m + 1)) := by ring
      rwa [heq] at hsum
  let q_deg : ℕ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  have hq_pos : 1 ≤ q_deg := by
    change 1 ≤ Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    rw [hq_eq]
    exact Nat.one_le_pow r_exp (p F) hp_prime.pos
  have hConj1 : ∀ z : M_Cˣ, ∃ w : Kˣ,
      z * (Units.map (normLM F hM_CK) w)⁻¹ ∈ unitGroup F M_C 1 := by
    obtain ⟨ϖ_K, hϖK_val⟩ := (h_valL_pkg K).2.2.2.2.2.2.1 1
    let ϖ_MC : M_Cˣ := Units.map (normLM F hM_CK) ϖ_K
    have hϖMC_val : valL F M_C (ϖ_MC : M_C) = 1 := by
      change valL F M_C (normLM F hM_CK (ϖ_K : K)) = 1
      rw [hValNormK (ϖ_K : K), hϖK_val]
    intro z
    set m : ℤ := valL F M_C (z : M_C)
    let v : M_Cˣ := z * ϖ_MC ^ (-m)
    have hv_val : valL F M_C (v : M_C) = 0 := by
      change valL F M_C ((z : M_C) * ((ϖ_MC ^ (-m) : M_Cˣ) : M_C)) = 0
      rw [(h_valL_pkg M_C).2.2.2.2.1 (z : M_C) _ (Units.ne_zero z) (Units.ne_zero _),
        hval_zpow M_C ϖ_MC (-m), hϖMC_val]
      omega
    have hv_0 : PB M_C 0 (v : M_C) := Or.inr (by omega)
    obtain ⟨s₀, hs₀_0, hv_s₀⟩ := hFrobIterMC r_exp (v : M_C) hv_0
    have hsq_eq : s₀ ^ ((p F) ^ r_exp) = s₀ ^ q_deg := by rw [← hq_eq]
    rw [hsq_eq] at hv_s₀
    obtain ⟨hsq_ne, hsq_val0⟩ := hPB_eq_val0 M_C (Units.ne_zero v) hv_val hv_s₀
    have hs₀_ne : s₀ ≠ 0 := by
      rintro rfl
      exact hsq_ne (zero_pow (by omega))
    let s : M_Cˣ := Units.mk0 s₀ hs₀_ne
    let w : Kˣ := ϖ_K ^ m * Units.map (IntermediateField.inclusion hM_CK).toMonoidHom s
    refine ⟨w, ?_⟩
    have hnorm_incl : normLM F hM_CK (IntermediateField.inclusion hM_CK s₀) = s₀ ^ q_deg := by
      change Algebra.norm M_C (algebraMap M_C (IntermediateField.extendScalars hM_CK) s₀) = s₀ ^ q_deg
      exact Algebra.norm_algebraMap s₀
    have hnorm_s : Units.map (normLM F hM_CK)
        (Units.map (IntermediateField.inclusion hM_CK).toMonoidHom s) = s ^ q_deg := by
      apply Units.ext
      change normLM F hM_CK (IntermediateField.inclusion hM_CK s₀) = ((s ^ q_deg : M_Cˣ) : M_C)
      rw [hnorm_incl, Units.val_pow_eq_pow_val]
      rfl
    have hnorm_w : Units.map (normLM F hM_CK) w = ϖ_MC ^ m * s ^ q_deg := by
      change Units.map (normLM F hM_CK)
        (ϖ_K ^ m * Units.map (IntermediateField.inclusion hM_CK).toMonoidHom s) = _
      rw [map_mul, map_zpow, hnorm_s]
    have hu_eq : z * (Units.map (normLM F hM_CK) w)⁻¹ = v * (s ^ q_deg)⁻¹ := by
      rw [hnorm_w, mul_inv, ← mul_assoc]
      congr 1
      change z * (ϖ_MC ^ m)⁻¹ = z * ϖ_MC ^ (-m)
      rw [zpow_neg]
    rw [hu_eq, (h_valL_pkg M_C).2.2.2.2.2.2.2.2.2.1 1 le_rfl]
    have hsq_inv_val : valL F M_C ((((s ^ q_deg)⁻¹ : M_Cˣ) : M_C)) = 0 := by
      rw [(h_valL_pkg M_C).2.2.2.2.2.1 (s ^ q_deg), Units.val_pow_eq_pow_val]
      change - valL F M_C (s₀ ^ q_deg) = 0
      rw [hsq_val0, neg_zero]
    have hsq_inv_0 : PB M_C 0 ((((s ^ q_deg)⁻¹ : M_Cˣ) : M_C)) := Or.inr (by omega)
    have hdiff_u : (((v * (s ^ q_deg)⁻¹ : M_Cˣ) : M_C) - 1) =
        ((v : M_C) - s₀ ^ q_deg) * ((((s ^ q_deg)⁻¹ : M_Cˣ) : M_C)) := by
      have hmul : (s₀ ^ q_deg) * ((((s ^ q_deg)⁻¹ : M_Cˣ) : M_C)) = 1 :=
        Units.mul_inv (s ^ q_deg)
      rw [sub_mul, hmul]
      rfl
    have hprod_1 : PB M_C 1 ((((v * (s ^ q_deg)⁻¹ : M_Cˣ) : M_C) - 1)) := by
      rw [hdiff_u, ← add_zero (1 : ℤ)]
      exact hPB_mul M_C hv_s₀ hsq_inv_0
    rcases hprod_1 with h0 | hle
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hle

  
  have helper_isGalois : ∀ (k₀ Ω_bar : Type u) [Field k₀] [Field Ω_bar] [Algebra k₀ Ω_bar]
      [Normal k₀ Ω_bar] (K₀ : IntermediateField k₀ Ω_bar) [hSepK₀ : Algebra.IsSeparable k₀ K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k₀] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k₀ K₀ := by
    intro k₀ Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k₀ Ω_bar := separableClosure k₀ Ω_bar
    haveI : IsGalois k₀ N := separableClosure.isGalois k₀ Ω_bar
    haveI : Normal k₀ N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k₀ x := @Algebra.IsSeparable.isSeparable k₀ K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k₀ z = minpoly k₀ x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k₀ z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k₀ N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k₀ K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k₀] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have hGalNormTraceLin : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B]
      (hAB : A ≤ B) (hGalAB : IsGaloisExt F A B),
      (∀ (x : A) (y : B),
        traceLM F hAB (IntermediateField.inclusion hAB x * y) = x * traceLM F hAB y) ∧
      (∀ (d : ℤ), 1 ≤ d → ∀ (z : B), PB B d z →
        PB B (2 * d) (IntermediateField.inclusion hAB
          (normLM F hAB (1 + z) - (1 + traceLM F hAB z))) ∧
        PB B d (IntermediateField.inclusion hAB (normLM F hAB (1 + z) - 1))) := by
    intro A B _ _ hAB hGalAB
    let B_A : IntermediateField A (AlgebraicClosure F) := IntermediateField.extendScalars hAB
    let e_BA : B ≃ₐ[F] B_A :=
      { toExtendScalars F hAB with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    let fromBA : B_A →+* B := e_BA.symm.toRingHom
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : FiniteDimensional F B_A := Module.Finite.equiv e_BA.toLinearEquiv
    haveI : IsScalarTower F A B_A := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional A B_A := Module.Finite.of_restrictScalars_finite F A B_A
    haveI : Normal A (AlgebraicClosure F) := Normal.tower_top_of_normal F A (AlgebraicClosure F)
    haveI : Algebra.IsSeparable A B_A := hGalAB.2.2.2 hAB
    have hGalBA : IsGalois A ↥B_A := by
      refine helper_isGalois A (AlgebraicClosure F) B_A (fun σ τ hτ => ?_)
      let σ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm σ
      let τ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm τ
      have hτB : τ_F.1 ∈ B.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hAB).mpr hx)
      have hconjB : (σ_F * τ_F * σ_F⁻¹).1 ∈ B.fixingSubgroup :=
        hGalAB.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτB
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjB
      exact hconjB x ((IntermediateField.mem_extendScalars hAB).mp hx)
    haveI : IsGalois A ↥B_A := hGalBA
    let G_AB := (B_A ≃ₐ[A] B_A)
    letI : Fintype G_AB := AlgEquiv.fintype A B_A
    let act_AB : G_AB → B → B := fun σ z => fromBA (σ (toExtendScalars F hAB z))
    have hact_zero : ∀ σ : G_AB, act_AB σ 0 = 0 := by
      intro σ
      change fromBA (σ 0) = 0
      rw [map_zero, map_zero]
    have hact_one_el : ∀ σ : G_AB, act_AB σ 1 = 1 := by
      intro σ
      change fromBA (σ 1) = 1
      rw [map_one, map_one]
    have hact_add : ∀ (σ : G_AB) (z₁ z₂ : B), act_AB σ (z₁ + z₂) = act_AB σ z₁ + act_AB σ z₂ := by
      intro σ z₁ z₂
      change fromBA (σ (toExtendScalars F hAB z₁ + toExtendScalars F hAB z₂)) = _
      rw [map_add, map_add]
    have hact_mul_el : ∀ (σ : G_AB) (z₁ z₂ : B), act_AB σ (z₁ * z₂) = act_AB σ z₁ * act_AB σ z₂ := by
      intro σ z₁ z₂
      change fromBA (σ (toExtendScalars F hAB z₁ * toExtendScalars F hAB z₂)) = _
      rw [map_mul, map_mul]
    have hact_incl : ∀ (σ : G_AB) (x : A),
        act_AB σ (IntermediateField.inclusion hAB x) = IntermediateField.inclusion hAB x := by
      intro σ x
      change fromBA (σ (algebraMap A B_A x)) = IntermediateField.inclusion hAB x
      rw [σ.commutes x]
      rfl
    have hact_val : ∀ (σ : G_AB) (z : B), valL F B (act_AB σ z) = valL F B z := by
      intro σ z
      let φ_σ : B ≃ₐ[F] B := e_BA.trans ((σ.restrictScalars F).trans e_BA.symm)
      have hφ : φ_σ z = act_AB σ z := rfl
      unfold valL relVal
      rw [← hφ, Algebra.norm_eq_of_algEquiv φ_σ z]
    have htrace_sum : ∀ z : B,
        IntermediateField.inclusion hAB (traceLM F hAB z) = ∑ σ : G_AB, act_AB σ z := by
      intro z
      have h1 := congrArg fromBA
        (trace_eq_sum_automorphisms (K := A) (L := B_A) (toExtendScalars F hAB z))
      have h2 : fromBA (∑ σ : G_AB, σ (toExtendScalars F hAB z)) =
          ∑ σ : G_AB, fromBA (σ (toExtendScalars F hAB z)) :=
        map_sum fromBA (fun σ : G_AB => σ (toExtendScalars F hAB z)) Finset.univ
      rw [h2] at h1
      exact h1
    have hnorm_prod : ∀ z : B,
        IntermediateField.inclusion hAB (normLM F hAB z) = ∏ σ : G_AB, act_AB σ z := by
      intro z
      have h1 := congrArg fromBA
        (Algebra.norm_eq_prod_automorphisms A (toExtendScalars F hAB z))
      have h2 : fromBA (∏ σ : G_AB, σ (toExtendScalars F hAB z)) =
          ∏ σ : G_AB, fromBA (σ (toExtendScalars F hAB z)) :=
        map_prod fromBA (fun σ : G_AB => σ (toExtendScalars F hAB z)) Finset.univ
      rw [h2] at h1
      exact h1
    refine ⟨?_, ?_⟩
    · intro x y
      have h_eq : IntermediateField.inclusion hAB
          (traceLM F hAB (IntermediateField.inclusion hAB x * y)) =
          IntermediateField.inclusion hAB (x * traceLM F hAB y) := by
        rw [htrace_sum, map_mul (IntermediateField.inclusion hAB), htrace_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun σ _ => ?_
        rw [hact_mul_el, hact_incl]
      exact (IntermediateField.inclusion hAB).injective h_eq
    · intro d hd z hz
      have hσz : ∀ σ : G_AB, PB B d (act_AB σ z) := by
        intro σ
        rcases hz with rfl | hz_val
        · rw [hact_zero]; exact Or.inl rfl
        · right; rw [hact_val]; exact hz_val
      have hS_ind : ∀ S : Finset G_AB,
          PB B d (∑ σ ∈ S, act_AB σ z) ∧
          PB B (2 * d) ((∏ σ ∈ S, (1 + act_AB σ z)) - (1 + ∑ σ ∈ S, act_AB σ z)) := by
        intro S
        induction S using Finset.induction_on with
        | empty =>
          simp only [Finset.sum_empty, Finset.prod_empty, add_zero, sub_self]
          exact ⟨hPB_zero B d, hPB_zero B (2 * d)⟩
        | @insert τ S hτ ih =>
          rw [Finset.sum_insert hτ, Finset.prod_insert hτ]
          set a := act_AB τ z
          set S_sum := ∑ σ ∈ S, act_AB σ z
          set P := ∏ σ ∈ S, (1 + act_AB σ z)
          have ha : PB B d a := hσz τ
          have hsum : PB B d (a + S_sum) := hPB_add B ha ih.1
          have h_ident : (1 + a) * P - (1 + (a + S_sum)) =
              (P - (1 + S_sum)) + a * S_sum + a * (P - (1 + S_sum)) := by ring
          rw [h_ident]
          have h_a_sum : PB B (2 * d) (a * S_sum) := by
            have h := hPB_mul B ha ih.1
            rwa [← two_mul] at h
          have h_a_rem : PB B (2 * d) (a * (P - (1 + S_sum))) :=
            hPB_mono B (by omega) (hPB_mul B ha ih.2)
          exact ⟨hsum, hPB_add B (hPB_add B ih.2 h_a_sum) h_a_rem⟩
      obtain ⟨h_tr_d, h_rem_2d⟩ := hS_ind Finset.univ
      have hprod_eq : (∏ σ : G_AB, (1 + act_AB σ z)) =
          IntermediateField.inclusion hAB (normLM F hAB (1 + z)) := by
        rw [hnorm_prod]
        refine Finset.prod_congr rfl fun σ _ => ?_
        rw [hact_add, hact_one_el]
      rw [← htrace_sum] at h_tr_d h_rem_2d
      rw [hprod_eq] at h_rem_2d
      have h_incl_rem : (IntermediateField.inclusion hAB (normLM F hAB (1 + z)) -
          (1 + IntermediateField.inclusion hAB (traceLM F hAB z))) =
          IntermediateField.inclusion hAB (normLM F hAB (1 + z) - (1 + traceLM F hAB z)) := by
        rw [map_sub (IntermediateField.inclusion hAB), map_add (IntermediateField.inclusion hAB),
          map_one (IntermediateField.inclusion hAB)]
      rw [h_incl_rem] at h_rem_2d
      have h_rem_d : PB B d (IntermediateField.inclusion hAB (normLM F hAB (1 + z) - 1)) := by
        have h1 := hPB_add B (hPB_mono B (by omega : d ≤ 2 * d) h_rem_2d) h_tr_d
        have heq : IntermediateField.inclusion hAB (normLM F hAB (1 + z) - (1 + traceLM F hAB z)) +
            IntermediateField.inclusion hAB (traceLM F hAB z) =
            IntermediateField.inclusion hAB (normLM F hAB (1 + z) - 1) := by
          rw [← map_add]
          congr 1
          ring
        rwa [heq] at h1
      exact ⟨h_rem_2d, h_rem_d⟩

  
  have hPMC_sum : ∀ (S : Finset ℕ) (g : ℕ → M_C),
      (∀ i ∈ S, PB M_C 1 (g i)) → PB M_C 1 (∑ i ∈ S, g i) := by
    intro S g hg
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty]
      exact hPB_zero M_C 1
    | @insert j S hj ih =>
      rw [Finset.sum_insert hj]
      exact hPB_add M_C (hg j (Finset.mem_insert_self j S))
        (ih (fun i hi => hg i (Finset.mem_insert_of_mem hi)))
  have hPMC_frob_step : ∀ z : M_C,
      PB M_C 0 z → PB M_C 1 (z ^ (p F) - 1) → PB M_C 1 (z - 1) := by
    intro z hz hzp
    set d : M_C := z - 1
    have hd_0 : PB M_C 0 d := hPB_sub M_C hz (hPB_one M_C)
    have hz_eq : 1 + d = z := add_sub_cancel 1 z
    have hp_ge2 : 2 ≤ p F := hp_prime.two_le
    have hp_split : p F = (p F - 1) + 1 := (Nat.sub_add_cancel hp_prime.pos).symm
    have h_binom : z ^ (p F) - 1 - d ^ (p F) =
        ∑ k_idx ∈ Finset.range (p F - 1),
          d ^ (p F - (k_idx + 1)) * (((p F).choose (k_idx + 1) : ℕ) : M_C) := by
      have h1 := add_pow (1 : M_C) d (p F)
      rw [hz_eq, Finset.sum_range_succ] at h1
      simp only [Nat.sub_self, pow_zero, mul_one, one_pow, one_mul, Nat.choose_self, Nat.cast_one] at h1
      conv_lhs at h1 => rw [hp_split]
      conv_rhs at h1 =>
        congr
        rw [hp_split, Finset.sum_range_succ']
      rw [← hp_split] at h1
      simp only [Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one, mul_one] at h1
      linear_combination h1
    have h_sum_1 : PB M_C 1 (z ^ (p F) - 1 - d ^ (p F)) := by
      rw [h_binom]
      refine hPMC_sum (Finset.range (p F - 1)) _ (fun k_idx hk => ?_)
      rw [Finset.mem_range] at hk
      have hk_ne0 : k_idx + 1 ≠ 0 := by omega
      have hk_lt : k_idx + 1 < p F := by omega
      obtain ⟨c, hc⟩ := Nat.Prime.dvd_choose_self hp_prime hk_ne0 hk_lt
      have h_ch : (((p F).choose (k_idx + 1) : ℕ) : M_C) = ((p F : ℕ) : M_C) * (c : M_C) := by
        rw [hc, Nat.cast_mul]
      have h_ch_1 : PB M_C 1 (((p F).choose (k_idx + 1) : ℕ) : M_C) := by
        rw [h_ch, ← add_zero (1 : ℤ)]
        exact hPB_mul M_C (h_valL_pkg M_C).2.2.2.2.2.2.2.2.2.2.2 (hPB_nat M_C c)
      have h_term_0 : PB M_C 0 (d ^ (p F - (k_idx + 1))) := hPB_pow0 M_C _ hd_0
      have h_prod := hPB_mul M_C h_term_0 h_ch_1
      rwa [zero_add] at h_prod
    have hdp_1 : PB M_C 1 (d ^ (p F)) := by
      have h := hPB_sub M_C hzp h_sum_1
      have heq : (z ^ (p F) - 1) - (z ^ (p F) - 1 - d ^ (p F)) = d ^ (p F) := by ring
      rwa [heq] at h
    by_cases hd0 : d = 0
    · exact Or.inl hd0
    · right
      have hdp0 : d ^ (p F) ≠ 0 := pow_ne_zero (p F) hd0
      have hdp_val : 1 ≤ valL F M_C (d ^ (p F)) := hdp_1.resolve_left hdp0
      rw [hval_pow M_C d (p F) hd0] at hdp_val
      have hd_ge0 : 0 ≤ valL F M_C d := hd_0.resolve_left hd0
      have hp_ge2Z : (2 : ℤ) ≤ (p F : ℤ) := Nat.ofNat_le_cast.mpr hp_ge2
      nlinarith
  have hPMC_pow_reflect : ∀ (m : ℕ) (z : M_C),
      PB M_C 0 z → PB M_C 1 (z ^ ((p F) ^ m) - 1) → PB M_C 1 (z - 1) := by
    intro m
    induction m with
    | zero =>
      intro z _ h
      rwa [pow_zero, pow_one] at h
    | succ m ih =>
      intro z hz h
      rw [pow_succ', pow_mul] at h
      have hzp : PB M_C 1 (z ^ (p F) - 1) := ih (z ^ (p F)) (hPB_pow0 M_C (p F) hz) h
      exact hPMC_frob_step z hz hzp
  have hConj2 : ∀ w : Kˣ,
      Units.map (normLM F hM_CK) w ∈ unitGroup F M_C 1 → w ∈ unitGroup F K 1 := by
    intro w hw_norm
    let u : M_Cˣ := Units.map (normLM F hM_CK) w
    have hu_val0 : valL F M_C (u : M_C) = 0 :=
      (h_valL_pkg M_C).2.2.2.2.2.2.2.2.2.2.1 1 u hw_norm
    have hw_val0 : valL F K (w : K) = 0 := by
      rw [← hValNormK (w : K)]
      exact hu_val0
    have hw_0 : PB K 0 (w : K) := Or.inr (by omega)
    obtain ⟨z₀, hz₀_0, hw_z₀⟩ := hResLiftK (w : K) hw_0
    obtain ⟨hincl_ne, hincl_val0⟩ := hPB_eq_val0 K (Units.ne_zero w) hw_val0 hw_z₀
    have hz₀_ne : z₀ ≠ 0 := by
      rintro rfl
      exact hincl_ne (map_zero _)
    let z_u : M_Cˣ := Units.mk0 z₀ hz₀_ne
    let w_z : Kˣ := Units.map (IntermediateField.inclusion hM_CK).toMonoidHom z_u
    let w₁ : Kˣ := w * w_z⁻¹
    have hwz_inv_val0 : valL F K (((w_z⁻¹ : Kˣ) : K)) = 0 := by
      rw [(h_valL_pkg K).2.2.2.2.2.1 w_z]
      change - valL F K (IntermediateField.inclusion hM_CK z₀) = 0
      rw [hincl_val0, neg_zero]
    have hwz_inv_0 : PB K 0 (((w_z⁻¹ : Kˣ) : K)) := Or.inr (by omega)
    have hw₁_sub : ((w₁ : K) - 1) =
        ((w : K) - IntermediateField.inclusion hM_CK z₀) * (((w_z⁻¹ : Kˣ) : K)) := by
      have hmul : IntermediateField.inclusion hM_CK z₀ * (((w_z⁻¹ : Kˣ) : K)) = 1 :=
        Units.mul_inv w_z
      rw [sub_mul, hmul]
      rfl
    have hw₁_1 : PB K 1 ((w₁ : K) - 1) := by
      rw [hw₁_sub, ← add_zero (1 : ℤ)]
      exact hPB_mul K hw_z₀ hwz_inv_0
    have hw₁_mem : w₁ ∈ unitGroup F K 1 := by
      rw [(h_valL_pkg K).2.2.2.2.2.2.2.2.2.1 1 le_rfl]
      rcases hw₁_1 with h0 | hle
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hle
    have hnorm_w₁_incl : PB K 1 (IntermediateField.inclusion hM_CK
        (normLM F hM_CK (w₁ : K) - 1)) := by
      have hlin := ((hGalNormTraceLin M_C K hM_CK hGalMCK).2 1 le_rfl ((w₁ : K) - 1) hw₁_1).2
      have heq : 1 + ((w₁ : K) - 1) = (w₁ : K) := add_sub_cancel 1 (w₁ : K)
      rwa [heq] at hlin
    have hnorm_w₁_1 : PB M_C 1 (normLM F hM_CK (w₁ : K) - 1) := by
      by_cases h0 : normLM F hM_CK (w₁ : K) - 1 = 0
      · exact Or.inl h0
      · right
        have hincl0 : IntermediateField.inclusion hM_CK (normLM F hM_CK (w₁ : K) - 1) ≠ 0 :=
          (map_ne_zero (IntermediateField.inclusion hM_CK)).mpr h0
        have hval := hnorm_w₁_incl.resolve_left hincl0
        rw [hValAlgK] at hval
        have hq_ge1Z : (1 : ℤ) ≤ (q_deg : ℤ) := Nat.one_le_cast.mpr hq_pos
        change 1 ≤ (q_deg : ℤ) * valL F M_C (normLM F hM_CK (w₁ : K) - 1) at hval
        by_contra hlt
        have hle0 : valL F M_C (normLM F hM_CK (w₁ : K) - 1) ≤ 0 := by omega
        have h_nonpos : (q_deg : ℤ) * valL F M_C (normLM F hM_CK (w₁ : K) - 1) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
        omega
    let u₁ : M_Cˣ := Units.map (normLM F hM_CK) w₁
    have hu₁_mem : u₁ ∈ unitGroup F M_C 1 := by
      rw [(h_valL_pkg M_C).2.2.2.2.2.2.2.2.2.1 1 le_rfl]
      rcases hnorm_w₁_1 with h0 | hle
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hle
    have hnorm_wz : Units.map (normLM F hM_CK) w_z = z_u ^ q_deg := by
      apply Units.ext
      change normLM F hM_CK (IntermediateField.inclusion hM_CK z₀) = ((z_u ^ q_deg : M_Cˣ) : M_C)
      have h1 : normLM F hM_CK (IntermediateField.inclusion hM_CK z₀) = z₀ ^ q_deg := by
        change Algebra.norm M_C (algebraMap M_C (IntermediateField.extendScalars hM_CK) z₀) = z₀ ^ q_deg
        exact Algebra.norm_algebraMap z₀
      rw [h1, Units.val_pow_eq_pow_val]
      rfl
    have hw_decomp : w₁ * w_z = w := inv_mul_cancel_right w w_z
    have hzu_pow_eq : z_u ^ q_deg = u₁⁻¹ * u := by
      rw [← hnorm_wz]
      change Units.map (normLM F hM_CK) w_z =
        (Units.map (normLM F hM_CK) w₁)⁻¹ * Units.map (normLM F hM_CK) w
      rw [← map_inv, ← map_mul, ← hw_decomp, inv_mul_cancel_left]
    have hzu_pow_mem : z_u ^ q_deg ∈ unitGroup F M_C 1 := by
      rw [hzu_pow_eq]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hu₁_mem) hw_norm
    have hzu_pow_1 : PB M_C 1 (z₀ ^ ((p F) ^ r_exp) - 1) := by
      rw [← hq_eq]
      have h := ((h_valL_pkg M_C).2.2.2.2.2.2.2.2.2.1 1 le_rfl (z_u ^ q_deg)).mp hzu_pow_mem
      change ((z_u ^ q_deg : M_Cˣ) : M_C) = 1 ∨ 1 ≤ valL F M_C (((z_u ^ q_deg : M_Cˣ) : M_C) - 1) at h
      rw [Units.val_pow_eq_pow_val] at h
      rcases h with h1 | hle
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hle
    have hz₀_1 : PB M_C 1 (z₀ - 1) := hPMC_pow_reflect r_exp z₀ hz₀_0 hzu_pow_1
    have hwz_1 : PB K 1 ((w_z : K) - 1) := by
      change PB K 1 (IntermediateField.inclusion hM_CK z₀ - 1)
      have heq : IntermediateField.inclusion hM_CK z₀ - 1 =
          IntermediateField.inclusion hM_CK (z₀ - 1) := by
        rw [map_sub, map_one]
      rw [heq]
      rcases hz₀_1 with h0 | hle
      · left; rw [h0, map_zero]
      · right
        rw [hValAlgK]
        have hq_ge1Z : (1 : ℤ) ≤ (q_deg : ℤ) := Nat.one_le_cast.mpr hq_pos
        change 1 ≤ (q_deg : ℤ) * valL F M_C (z₀ - 1)
        nlinarith
    have hwz_mem : w_z ∈ unitGroup F K 1 := by
      rw [(h_valL_pkg K).2.2.2.2.2.2.2.2.2.1 1 le_rfl]
      rcases hwz_1 with h0 | hle
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hle
    rw [← hw_decomp]
    exact Subgroup.mul_mem _ hw₁_mem hwz_mem

  
  have hConj3 : ∃ u_star ∈ unitGroup F M_C 1,
      (χ'.comp (Units.map (normLM F hLM_C))) u_star ≠ 1 := by
    set a := condExp F L χ'
    have ha_ne0 : a ≠ 0 := by omega
    have ha1_ge1 : 1 ≤ a - 1 := by omega
    obtain ⟨hχ'_triv, ⟨u₀, hu₀_mem, hχ'_u₀⟩⟩ := hcond_spec ha_ne0
    set x₀ : L := (u₀ : L) - 1
    have hx₀_a1 : PB L ((a - 1 : ℕ) : ℤ) x₀ := by
      have h := ((h_valL_pkg L).2.2.2.2.2.2.2.2.2.1 (a - 1) ha1_ge1 u₀).mp hu₀_mem
      rcases h with h1 | hle
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hle
    obtain ⟨y₁, hy₁_0, hy₁_tr⟩ := hy₁
    let z₀ : M_C := IntermediateField.inclusion hLM_C x₀ * y₁
    set d : ℤ := (k : ℤ) * ((a - 1 : ℕ) : ℤ)
    have hd_ge1 : 1 ≤ d := by
      have hkZ : (1 : ℤ) ≤ (k : ℤ) := Nat.one_le_cast.mpr hk_ge1
      have ha1Z : (1 : ℤ) ≤ ((a - 1 : ℕ) : ℤ) := Nat.one_le_cast.mpr ha1_ge1
      dsimp [d]
      nlinarith
    have hincl_x₀_d : PB M_C d (IntermediateField.inclusion hLM_C x₀) := by
      rcases hx₀_a1 with hx₀0 | hx₀_val
      · left; rw [hx₀0, map_zero]
      · right
        rw [hValAlgMCL x₀]
        have hkZ : (0 : ℤ) ≤ (k : ℤ) := Nat.cast_nonneg k
        exact mul_le_mul_of_nonneg_left hx₀_val hkZ
    have hz₀_d : PB M_C d z₀ := by
      have h := hPB_mul M_C hincl_x₀_d hy₁_0
      rwa [add_zero] at h
    have hz₀_1 : PB M_C 1 z₀ := hPB_mono M_C hd_ge1 hz₀_d
    have h1z₀_ne : 1 + z₀ ≠ 0 := by
      intro h0
      have hz₀_eq : z₀ = -1 := by linear_combination h0
      rw [hz₀_eq] at hz₀_1
      have hne : (-1 : M_C) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hval := hz₀_1.resolve_left hne
      rw [(h_valL_pkg M_C).2.2.1] at hval
      omega
    let u_star : M_Cˣ := Units.mk0 (1 + z₀) h1z₀_ne
    have hustar_mem : u_star ∈ unitGroup F M_C 1 := by
      rw [(h_valL_pkg M_C).2.2.2.2.2.2.2.2.2.1 1 le_rfl]
      have hsub : (u_star : M_C) - 1 = z₀ := add_sub_cancel_left 1 z₀
      rw [hsub]
      rcases hz₀_1 with h0 | hle
      · left; change 1 + z₀ = 1; rw [h0, add_zero]
      · exact Or.inr hle
    obtain ⟨htrace_smul, hnorm_lin⟩ := hGalNormTraceLin L M_C hLM_C hGalLMC
    have htr_z₀ : traceLM F hLM_C z₀ = x₀ := by
      change traceLM F hLM_C (IntermediateField.inclusion hLM_C x₀ * y₁) = x₀
      rw [htrace_smul x₀ y₁, hy₁_tr, mul_one]
    have h1_tr_z₀ : 1 + traceLM F hLM_C z₀ = (u₀ : L) := by
      rw [htr_z₀]
      exact add_sub_cancel 1 (u₀ : L)
    have hrem_incl : PB M_C (2 * d)
        (IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + z₀) - (u₀ : L))) := by
      have h := (hnorm_lin d hd_ge1 z₀ hz₀_d).1
      rwa [h1_tr_z₀] at h
    have hrem_L : PB L (a : ℤ) (normLM F hLM_C (1 + z₀) - (u₀ : L)) := by
      by_cases h0 : normLM F hLM_C (1 + z₀) - (u₀ : L) = 0
      · exact Or.inl h0
      · right
        have hincl0 : IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + z₀) - (u₀ : L)) ≠ 0 :=
          (map_ne_zero (IntermediateField.inclusion hLM_C)).mpr h0
        have hval := hrem_incl.resolve_left hincl0
        rw [hValAlgMCL] at hval
        have hkZ : (1 : ℤ) ≤ (k : ℤ) := Nat.one_le_cast.mpr hk_ge1
        have h_2a1 : 2 * ((a - 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLM_C (1 + z₀) - (u₀ : L)) := by
          dsimp [d] at hval
          nlinarith
        omega
    let u_norm : Lˣ := Units.map (normLM F hLM_C) u_star
    have hu₀_inv_val0 : valL F L (((u₀⁻¹ : Lˣ) : L)) = 0 := by
      rw [(h_valL_pkg L).2.2.2.2.2.1 u₀,
        (h_valL_pkg L).2.2.2.2.2.2.2.2.2.2.1 (a - 1) u₀ hu₀_mem, neg_zero]
    have hu₀_inv_0 : PB L 0 (((u₀⁻¹ : Lˣ) : L)) := Or.inr (by omega)
    have hquot_sub : (((u_norm * u₀⁻¹ : Lˣ) : L) - 1) =
        (normLM F hLM_C (1 + z₀) - (u₀ : L)) * (((u₀⁻¹ : Lˣ) : L)) := by
      have hmul : (u₀ : L) * (((u₀⁻¹ : Lˣ) : L)) = 1 := Units.mul_inv u₀
      rw [sub_mul, hmul]
      rfl
    have hquot_a : PB L (a : ℤ) (((u_norm * u₀⁻¹ : Lˣ) : L) - 1) := by
      rw [hquot_sub, ← add_zero (a : ℤ)]
      exact hPB_mul L hrem_L hu₀_inv_0
    have hquot_mem : u_norm * u₀⁻¹ ∈ unitGroup F L a := by
      rw [(h_valL_pkg L).2.2.2.2.2.2.2.2.2.1 a (by omega)]
      rcases hquot_a with h0 | hle
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hle
    have hχ'_quot : χ' (u_norm * u₀⁻¹) = 1 := hχ'_triv (u_norm * u₀⁻¹) hquot_mem
    have hχ'_eq : χ' u_norm = χ' u₀ := by
      rw [map_mul, map_inv, mul_inv_eq_one] at hχ'_quot
      exact hχ'_quot
    refine ⟨u_star, hustar_mem, ?_⟩
    change χ' u_norm ≠ 1
    rw [hχ'_eq]
    exact hχ'_u₀

  
  exact ⟨hConj1, hConj2, hConj3⟩

theorem ld_ch14_wild_semidirect_pullback_and_orbit_cond_ge_two (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (hMC_decomp : ∀ z : M_Cˣ, ∃ w : Kˣ,
      z * (Units.map (normLM F hM_CK) w)⁻¹ ∈ unitGroup F M_C 1)
    (hMC_inter : ∀ w : Kˣ,
      Units.map (normLM F hM_CK) w ∈ unitGroup F M_C 1 → w ∈ unitGroup F K 1)
    (hu_star : ∃ u_star ∈ unitGroup F M_C 1,
      ((recChar F rec L χL_ext).comp (Units.map (normLM F hLM_C))) u_star ≠ 1) :
    (∀ (M' : IntermediateField F (AlgebraicClosure F))
      (hLM' : L ≤ M') (hM'K : M' ≤ K)
      (β : relWeil F M' →* (Ω F)ˣ),
      IsWeilRep F M' (charRep F M' β) →
      restrictWeilChar F hM'K β = restrictWeilChar F hLK χL_ext →
      2 ≤ condExp F M' (recChar F rec M' β)) ∧
    (∀ (F_s : IntermediateField F (AlgebraicClosure F))
      (hLFs : L ≤ F_s) (hFsMC : F_s ≤ M_C)
      (χ_s : relWeil F F_s →* (Ω F)ˣ),
      restrictWeilChar F (hFsMC.trans hM_CK) χ_s = 1 →
      restrictWeilChar F hFsMC χ_s ≠ 1 →
      IsWeilRep F F_s (charRep F F_s χ_s) ∧
      2 ≤ condExp F F_s (recChar F rec F_s χ_s)) :=
by
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear * -
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
