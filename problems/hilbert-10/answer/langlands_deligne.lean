    · right; linarith
  set T_m : ℕ → M₁' := fun m => traceLM F hM₁'K₁ ((w_inv * Δ_conj m) ^ (p - 1))
  have hTm_K₁_val : ∀ m < p,
      IntermediateField.inclusion hM₁'K₁ (T_m m) = 0 ∨
        ((p * (p - 1) * (m_exp + δ) : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hM₁'K₁ (T_m m)) := by
    intro m hm
    set z_m := w_inv * Δ_conj m
    have hz_ne0 : z ≠ 0 := mul_ne_zero hw_inv_ne0 (Units.ne_zero Δ)
    have hzm_ne0 : z_m ≠ 0 := mul_ne_zero hw_inv_ne0 (hΔ_conj_val m hm).1
    have hz_val : valL F K₁ z = ((M : ℕ) : ℤ) - ((t₁ : ℕ) : ℤ) := by
      dsimp [z, t₁]
      rw [hval_mul_K₁ w_inv (Δ : K₁) hw_inv_ne0 (Units.ne_zero Δ), hw_inv_val, hΔ_val]
