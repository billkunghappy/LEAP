        t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) :=
      ⟨x.1, x.2, rfl⟩
    have hu_gx : (u : AbsGal F) ((g : AbsGal F) x.1) = (g : AbsGal F) x.1 :=
      u.2.2 ⟨(g : AbsGal F) x.1, hgx⟩
    change ((g : AbsGal F)⁻¹ * (u : AbsGal F) * (g : AbsGal F)) x.1 = x.1
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hu_gx, ← AlgEquiv.mul_apply,
      inv_mul_cancel, AlgEquiv.one_apply]
