    have hs_val : s = 0 ∨ 2 * (d_U : ℤ) ≤ valL F L s := by
      have hs1 := hmul_val_ge_L (2 * (d_U : ℤ)) 0 ((δ_U : L) ^ 2) r₁ hδ2_val hr₁
      rw [add_zero] at hs1
      have hs2 := hmul_val_ge_L (2 * (d_U : ℤ)) 0 (((δ_U : L) ^ 2) * r₁) r₂ hs1 hr₂
      rwa [add_zero] at hs2
    set main_d : M₁' := IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * A * s) * d
    set err₁ : M₁' := IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * b * s) * d ^ 2
    set err₂ : M₁' := IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * s) * d ^ 3
    have hexpand : ((cM₁'⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' s * d =
        main_d + (err₁ + err₂) := by
      rw [hcM₁'_inv_coe, hZM₁'₀_eq]
      dsimp [main_d, err₁, err₂]
      repeat rw [map_mul]
      ring
    have herr₁_val : err₁ = 0 ∨ -condExpChar F M₁' ψM₁' ≤ valL F M₁' err₁ := by
      rw [hnM₁'_eq]
      have hc_inv : ((c_ν⁻¹ : Lˣ) : L) = 0 ∨ -((T : ℤ) + n) ≤ valL F L (((c_ν⁻¹ : Lˣ) : L)) :=
        Or.inr (by rw [hc_ν_inv_val_L])
      have hcb := hmul_val_ge_L (-((T : ℤ) + n)) ((T : ℤ) - (r_U : ℤ)) _ b hc_inv hb_val
      have hcbs := hmul_val_ge_L (-((T : ℤ) + n) + ((T : ℤ) - (r_U : ℤ))) (2 * (d_U : ℤ)) _ s hcb hs_val
      have hcbs_ge : ((c_ν⁻¹ : Lˣ) : L) * b * s = 0 ∨ -n ≤ valL F L (((c_ν⁻¹ : Lˣ) : L) * b * s) :=
        hmono_val_L (by have := hTrU_2dU_ge_T; omega) hcbs
      have hcbs_M₁' : IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * b * s) = 0 ∨
          -n ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * b * s)) := by
        rcases hcbs_ge with h0 | hge
        · left; rw [h0, map_zero]
        · right; rwa [hval_LM₁']
      exact hmul_int_M₁' (-n) _ (d ^ 2) hcbs_M₁' hd2_int
    have herr₂_val : err₂ = 0 ∨ -condExpChar F M₁' ψM₁' ≤ valL F M₁' err₂ := by
      rw [hnM₁'_eq]
      have hc_inv : ((c_ν⁻¹ : Lˣ) : L) = 0 ∨ -((T : ℤ) + n) ≤ valL F L (((c_ν⁻¹ : Lˣ) : L)) :=
        Or.inr (by rw [hc_ν_inv_val_L])
      have hcs := hmul_val_ge_L (-((T : ℤ) + n)) (2 * (d_U : ℤ)) _ s hc_inv hs_val
      have hcs_ge : ((c_ν⁻¹ : Lˣ) : L) * s = 0 ∨ -n ≤ valL F L (((c_ν⁻¹ : Lˣ) : L) * s) :=
        hmono_val_L (by have := h2dU_ge_T hh_pos; omega) hcs
      have hcs_M₁' : IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * s) = 0 ∨
          -n ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * s)) := by
        rcases hcs_ge with h0 | hge
        · left; rw [h0, map_zero]
        · right; rwa [hval_LM₁']
      exact hmul_int_M₁' (-n) _ (d ^ 3) hcs_M₁' hd3_int
    have hψ_err₁ : ψM₁' err₁ = 1 := hψM₁'_triv err₁ herr₁_val
    have hψ_err₂ : ψM₁' err₂ = 1 := hψM₁'_triv err₂ herr₂_val
    have hψ_main : ψM₁' main_d = ψ (((c_ν⁻¹ : Lˣ) : L) * A * ((δ_U : L) ^ 2) * r₁ * r₂) := by
      change ψ (traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * A * s) * d)) = _
      rw [htr_smul, hd_tr, mul_one]
      congr 1
      dsimp [s]
      ring
    rw [hexpand, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, hψ_err₁, hψ_err₂,
      mul_one, mul_one, hψ_main]
  refine ⟨C, cM₁', rfl, rfl, ?_, ?_, hZE'_val, hcM₁'_val, hcM₁'_stat, hCritM₁'_polar⟩
  · rw [hZM₁'_coe, hZM₁'₀_eq]
  · rw [hZE'_coe, hZE'₀_eq]

theorem ld_ch12_wild_dyadic_unramified_norm_rep_and_m1_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hξM₁'_cond : ∀ j < 2,
      ∀ u ∈ unitGroup F M₁' (condExp F M₁' ((νE'.comp (Units.map (normLM F hLM₁'))) ^ j)),
        ((νE'.comp (Units.map (normLM F hLM₁'))) ^ j) u = 1)
    (hξM₁'_cond_eq : condExp F M₁' (νE'.comp (Units.map (normLM F hLM₁'))) = condExp F L νE')
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = 2 * valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = 2 * valL F K₁ w)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (d : M₁') (c : L) (σ_U : M₁' ≃ₐ[F] M₁')
    (hd_val : valL F M₁' d = 0) (hc_val : valL F L c = 0)
    (hd_tr : traceLM F hLM₁' d = 1) (hd_norm : normLM F hLM₁' d = -c)
    (hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c)
    (hσ_U_L : ∀ x : L,
      σ_U (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ_U_val : ∀ z : M₁', valL F M₁' (σ_U z) = valL F M₁' z)
    (hσ_U_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + σ_U z)
    (hσ_U_twist : ∀ z : M₁'ˣ,
      θM₁' (Units.map σ_U.toRingEquiv.toMonoidHom z) =
        (νE'.comp (Units.map (normLM F hLM₁'))) z * θM₁' z)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hu₁_pow : ∀ u₁ : Lˣ, νE' u₁ ≠ 1 → ∀ ξ : (Ω F)ˣ,
      ξ ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1 →
      ∃ k < Module.finrank L (IntermediateField.extendScalars hLE'), (νE' u₁) ^ k = ξ)
    (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLE') ϖ_E' = ϖ_L)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : E', ∃ c_fn : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hLE' (c_fn i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            c_fn i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F L (c_fn i) + (i : ℤ))
    (y_tr1 : E') (hy_tr1_ne : y_tr1 ≠ 0)
    (hy_tr1_tr : traceLM F hLE' y_tr1 = 1)
    (hy_tr1_val : valL F E' y_tr1 = 1 - (condExp F L νE' : ℤ))
    (hnorm_surj_lt : ∀ m < condExp F L νE' - 1, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F E' m,
        (Units.map (normLM F hLE') w) * u⁻¹ ∈ unitGroup F L (m + 1)) :
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let h := mM₁' - T
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ (c_ν : Lˣ) (x : E') (C : K₁ˣ) (cM₁' : M₁'ˣ),
      let A := normLM F hLE' x
      let b := traceLM F hLE' x
      let u_frak : L := if h = 0 then (4 : L) else b ^ 2 * A⁻¹
      (C : K₁) = IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d ∧
      valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ ∧
      (∀ u : L, (u = 0 ∨ (((T + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
        ∀ hu : 1 + u ≠ 0,
          (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u)) ∧
      cM₁' = (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) *
        (Units.map (normLM F hM₁'K₁) C)⁻¹ ∧
      ((Units.map (normLM F hM₁'K₁) C : M₁'ˣ) : M₁') =
        IntermediateField.inclusion hLM₁' A + IntermediateField.inclusion hLM₁' b * d + d ^ 2 ∧
      ((Units.map (normLM F hE'K₁) C : E'ˣ) : E') =
        x ^ 2 + x - IntermediateField.inclusion hLE' c ∧
      valL F E' ((Units.map (normLM F hE'K₁) C : E'ˣ) : E') = -2 * (h : ℤ) ∧
      valL F M₁' (cM₁' : M₁') = (mM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁', (z = 0 ∨ (((mM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) = ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z)) ∧
      (b = 0 ∨ (T : ℤ) - (((mM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L b) ∧
      ((2 : L) = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F L (2 : L)) ∧
      (mM₁' % 2 = 0 → (u_frak = 0 ∨ (T : ℤ) ≤ valL F L u_frak)) ∧
      (mM₁' % 2 = 1 → u_frak ≠ 0 ∧ valL F L u_frak = (T : ℤ) - 1) ∧
      (h = 0 →
        (x = 0 ∨ 0 ≤ valL F E' x) ∧
        (4 * A - b ^ 2 = 0 ∨ (T : ℤ) ≤ valL F L (4 * A - b ^ 2))) ∧
      (0 < h →
        x ≠ 0 ∧
        valL F E' x = -(h : ℤ) ∧
        valL F L A = -(h : ℤ) ∧
        (∀ (δ_U : Lˣ) (r₁ r₂ : L),
          valL F L (δ_U : L) = ((mM₁' / 2 : ℕ) : ℤ) →
          (r₁ = 0 ∨ 0 ≤ valL F L r₁) →
          (r₂ = 0 ∨ 0 ≤ valL F L r₂) →
          ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') *
            IntermediateField.inclusion hLM₁' (((δ_U : L) ^ 2) * r₁ * r₂) * d) =
            ψ (((c_ν⁻¹ : Lˣ) : L) * A * ((δ_U : L) ^ 2) * r₁ * r₂))) :=
by
  obtain ⟨⟨c_ν₀, hc_ν₀_val, hc_ν₀_stat⟩, _⟩ :=
    ld_tame_stationary_phase_and_stable_twist F L ψ hψ νE' hbE'_ge2
  obtain ⟨⟨c_U, hc_U_val, hc_U_stat⟩, _⟩ :=
    ld_tame_stationary_phase_and_stable_twist F M₁' (traceChar F hLM₁' ψ) hψM₁' θM₁' hmM₁'_ge2
  have hvalE' := ld_valL_and_unitGroup_props F E'
  have h2_tr1 : traceLM F hLE' (IntermediateField.inclusion hLE' 1) = (2 : L) := by
    simpa using (hQuadNorm L E' hLE' hdeg2).1 1
  have h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L) := by
    rw [← h2_tr1, map_one]
    exact htr_bound_LE' ((condExp F L νE' / 2 : ℕ) : ℤ) 1 (Or.inr (by rw [hvalE'.2.1]; omega))
  obtain ⟨c_ν, x, hc_ν_val, hc_ν_stat, hU₁_approx, hx_zero, hx_pos⟩ :=
    ld_ch12_wild_dyadic_unramified_frob_proj_and_norm_approx F L E' M₁'
      hLE' hLM₁' hdeg2 hdegM₁' ψ hψ hψM₁' νE' hνE'_pow hνE'_ker hbE'_ge2
      θM₁' hmM₁'_ge2 hT_le hnM₁'_eq hval_LM₁' hval_norm_LM₁' hval_norm_LE' htr_bound_LM₁'
      d c σ_U hd_val hd_tr hd_sq hσ_U_L hσ_U_val hσ_U_tr hσ_U_twist hQuadNorm hu₁_pow
      h2_val c_ν₀ hc_ν₀_val hc_ν₀_stat c_U hc_U_val hc_U_stat
  obtain ⟨hb_val, _, hu_even, hu_odd, hdisc_zero⟩ :=
    ld_ch12_wild_dyadic_power_basis_trace_and_u_frak_val F L E'
      hLE' hdeg2 (condExp F L νE') (condExp F M₁' θM₁') hbE'_ge2 hT_le
      hval_LE' hval_norm_LE' htr_bound_LE' hQuadNorm
      ϖ_E' ϖ_L hϖ_norm hϖ_E' hϖ_L hBasis
      y_tr1 hy_tr1_ne hy_tr1_tr hy_tr1_val x hx_zero
      (fun hh => ⟨(hx_pos hh).1, (hx_pos hh).2.1⟩)
  obtain ⟨C, cM₁', hC_eq, hcM₁'_eq, hZM₁'_coe, hZE'_coe, hZE'_val,
    hcM₁'_val, hcM₁'_stat, hCritM₁'_polar⟩ :=
    ld_ch12_wild_dyadic_unramified_k1_norm_and_cM1_stat F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegE'K₁ hdegM₁'K₁
      ψ hψ hψM₁' (condExp F L νE') hbE'_ge2 θM₁' hT_le hnM₁'_eq
      hval_LM₁' hval_norm_E'K₁ hval_norm_M₁'K₁ hDiamond_E' hDiamond_M₁'
      d c hd_val hd_tr hd_norm hQuadNorm c_U hc_U_val hc_U_stat
      c_ν x hc_ν_val hU₁_approx hb_val
  refine ⟨c_ν, x, C, cM₁', hC_eq, hc_ν_val, hc_ν_stat, hcM₁'_eq,
    hZM₁'_coe, hZE'_coe, hZE'_val, hcM₁'_val, hcM₁'_stat,
    hb_val, h2_val, hu_even, hu_odd,
    fun hh => ⟨hx_zero hh, hdisc_zero hh⟩,
    fun hh => ⟨(hx_pos hh).1, (hx_pos hh).2.1, (hx_pos hh).2.2, hCritM₁'_polar hh⟩⟩

theorem ld_ch12_wild_dyadic_unramified_cE_prefactor_and_trace_diff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνM₁'_val : ∀ x : Lˣ, (νM₁' x : Ω F) = (-1 : Ω F) ^ (valL F L (x : L)))
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hCommonRest : ∀ x : Lˣ,
      θE' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) * νE' x =
      θM₁' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) * νM₁' x)
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (d : M₁') (c : L) (σ_E : E' ≃ₐ[F] E')
    (hd_tr : traceLM F hLM₁' d = 1)
    (hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c)
    (hσ_E_L : ∀ x : L,
      σ_E (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ_E_val : ∀ y : E', valL F E' (σ_E y) = valL F E' y)
    (hσ_E_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ_E y)
    (hσ_E_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ_E y)
    (hσ_E_twist : ∀ y : E'ˣ,
      θE' (Units.map σ_E.toRingEquiv.toMonoidHom y) =
        (νM₁'.comp (Units.map (normLM F hLE'))) y * θE' y)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (c_ν : Lˣ) (x : E') (C : K₁ˣ) (cM₁' : M₁'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hcM₁'_eq : cM₁' = (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) *
      (Units.map (normLM F hM₁'K₁) C)⁻¹)
    (hZM₁'_coe : ((Units.map (normLM F hM₁'K₁) C : M₁'ˣ) : M₁') =
      IntermediateField.inclusion hLM₁' (normLM F hLE' x) +
        IntermediateField.inclusion hLM₁' (traceLM F hLE' x) * d + d ^ 2)
    (hZE'_coe : ((Units.map (normLM F hE'K₁) C : E'ˣ) : E') =
      x ^ 2 + x - IntermediateField.inclusion hLE' c)
    (hZE'_val : valL F E' ((Units.map (normLM F hE'K₁) C : E'ˣ) : E') =
      -2 * ((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ))
    (hx_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' →
      x ≠ 0 ∧
      valL F E' x = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ) ∧
      valL F L (normLM F hLE' x) = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ)) :
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let mE' := condExp F E' θE'
    let h := mM₁' - T
    let ψE' := traceChar F hLE' ψ
    let A := normLM F hLE' x
    let b := traceLM F hLE' x
    ∃ (cE' : E'ˣ),
      valL F E' (cE' : E') = (mE' : ℤ) + condExpChar F E' ψE' ∧
      (h = 0 → cE' = (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) *
        (Units.map (normLM F hE'K₁) C)⁻¹) ∧
      (h = 0 → ((cE'⁻¹ : E'ˣ) : E') =
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) *
          (x ^ 2 + x - IntermediateField.inclusion hLE' c)) ∧
      (0 < h → ((cE'⁻¹ : E'ˣ) : E') =
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) *
          (σ_E x * x⁻¹ * (x ^ 2 + x - IntermediateField.inclusion hLE' c))) ∧
      (θE' cE' : Ω F) * (νE' c_ν : Ω F) =
        (-1 : Ω F) ^ h * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) ∧
      (h = 0 →
        traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
          traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
          (4 * A - b ^ 2) + 4 * c) ∧
      (0 < h →
        traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
          traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
          c * (b ^ 2 * A⁻¹)) :=
by
  intro T mM₁' mE' h ψE' A b
  have hvalL_0 : valL F L 0 = 0 := (ld_valL_and_unitGroup_props F L).1
  obtain ⟨_, _, _, _, hvalE'_mul, hvalE'_inv, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  have hvalE'_unit_mul : ∀ u₁ u₂ : E'ˣ,
      valL F E' ((u₁ * u₂ : E'ˣ) : E') = valL F E' (u₁ : E') + valL F E' (u₂ : E') := by
    intro u₁ u₂
    rw [Units.val_mul]
    exact hvalE'_mul (u₁ : E') (u₂ : E') (Units.ne_zero u₁) (Units.ne_zero u₂)
  let u_cν_E' : E'ˣ := Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν
  let u_cν_M₁' : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν
  let Z_E' : E'ˣ := Units.map (normLM F hE'K₁) C
  let Z_M₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) C
  let Z_hat : E'ˣ :=
    if hh : 0 < h then
      (Units.map σ_E.toRingEquiv.toMonoidHom (Units.mk0 x (hx_pos hh).1) *
        (Units.mk0 x (hx_pos hh).1)⁻¹) * Z_E'
    else Z_E'
  let cE' : E'ˣ := u_cν_E' * Z_hat⁻¹
  have hval_ucν : valL F E' (u_cν_E' : E') = 2 * ((T : ℤ) + condExpChar F L ψ) := by
    have hcoe : (u_cν_E' : E') = IntermediateField.inclusion hLE' (c_ν : L) := rfl
    rw [hcoe, hval_LE', hc_ν_val]
  have hval_Zhat : valL F E' (Z_hat : E') = -2 * ((h : ℕ) : ℤ) := by
    dsimp only [Z_hat]
    split_ifs with hh
    · set u_x : E'ˣ := Units.mk0 x (hx_pos hh).1
      set u_σx : E'ˣ := Units.map σ_E.toRingEquiv.toMonoidHom u_x
      have hσx_coe : (u_σx : E') = σ_E x := rfl
      have hx_coe : (u_x : E') = x := rfl
      rw [hvalE'_unit_mul, hvalE'_unit_mul, hvalE'_inv, hσx_coe, hx_coe, hσ_E_val x, hZE'_val]
      omega
    · exact hZE'_val
  have hcE'_val : valL F E' (cE' : E') = (mE' : ℤ) + condExpChar F E' ψE' := by
    change valL F E' ((u_cν_E' * Z_hat⁻¹ : E'ˣ) : E') = (mE' : ℤ) + condExpChar F E' ψE'
    rw [hvalE'_unit_mul, hvalE'_inv, hval_ucν, hval_Zhat]
    have hmE' : (mE' : ℤ) = (T : ℤ) + 2 * ((h : ℕ) : ℤ) := by
      exact_mod_cast hmE'_eq
    have hnE' : condExpChar F E' ψE' = 2 * condExpChar F L ψ + (T : ℤ) := hnE'_eq
    omega
  have hcE'_eq_zero : h = 0 → cE' = u_cν_E' * Z_E'⁻¹ := by
    intro hh0
    have hnot : ¬ (0 < h) := by omega
    have hZhat0 : Z_hat = Z_E' := dif_neg hnot
    change u_cν_E' * Z_hat⁻¹ = u_cν_E' * Z_E'⁻¹
    rw [hZhat0]
  have hcE'_inv_zero : h = 0 → ((cE'⁻¹ : E'ˣ) : E') =
      IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) *
        (x ^ 2 + x - IntermediateField.inclusion hLE' c) := by
    intro hh0
    have hcE'0 : cE'⁻¹ = u_cν_E'⁻¹ * Z_E' := by
      rw [hcE'_eq_zero hh0, mul_inv_rev, inv_inv, mul_comm]
    have hucν_inv_coe : ((u_cν_E'⁻¹ : E'ˣ) : E') =
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) := by
      change (((Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν)⁻¹ : E'ˣ) : E') = _
      rw [← map_inv]
      rfl
    rw [hcE'0, Units.val_mul, hucν_inv_coe, hZE'_coe]
  have hcE'_inv_pos : 0 < h → ((cE'⁻¹ : E'ˣ) : E') =
      IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) *
        (σ_E x * x⁻¹ * (x ^ 2 + x - IntermediateField.inclusion hLE' c)) := by
    intro hh
    have hZhat_pos : Z_hat =
        (Units.map σ_E.toRingEquiv.toMonoidHom (Units.mk0 x (hx_pos hh).1) *
          (Units.mk0 x (hx_pos hh).1)⁻¹) * Z_E' := dif_pos hh
    have hcE'_inv_eq : cE'⁻¹ = u_cν_E'⁻¹ * Z_hat := by
      change (u_cν_E' * Z_hat⁻¹)⁻¹ = u_cν_E'⁻¹ * Z_hat
      rw [mul_inv_rev, inv_inv, mul_comm]
    have hucν_inv_coe : ((u_cν_E'⁻¹ : E'ˣ) : E') =
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) := by
      change (((Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν)⁻¹ : E'ˣ) : E') = _
      rw [← map_inv]
      rfl
    have hZhat_coe : (Z_hat : E') =
        σ_E x * x⁻¹ * (x ^ 2 + x - IntermediateField.inclusion hLE' c) := by
      rw [hZhat_pos, Units.val_mul, Units.val_mul, Units.val_inv_eq_inv_val, hZE'_coe]
      rfl
    rw [hcE'_inv_eq, Units.val_mul, hucν_inv_coe, hZhat_coe]
  have hθ_ZE' : θE' Z_E' = θK₁ C :=
    congrFun (congrArg DFunLike.coe hχE'_comp) C
  have hθ_ZM₁' : θM₁' Z_M₁' = θK₁ C :=
    congrFun (congrArg DFunLike.coe hχM₁'_comp) C
  have hM₁'_pref : (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) =
      (θE' u_cν_E' : Ω F) * (νE' c_ν : Ω F) * (((θK₁ C)⁻¹ : (Ω F)ˣ) : Ω F) := by
    have h1 : θM₁' cM₁' * νM₁' c_ν = θE' u_cν_E' * νE' c_ν * (θK₁ C)⁻¹ := by
      rw [hcM₁'_eq, map_mul, map_inv, hθ_ZM₁', mul_right_comm, hCommonRest c_ν]
    exact_mod_cast congrArg Units.val h1
  have hθ_Zhat_inv : (θE' (Z_hat⁻¹) : Ω F) =
      (-1 : Ω F) ^ h * (((θK₁ C)⁻¹ : (Ω F)ˣ) : Ω F) := by
    dsimp only [Z_hat]
    split_ifs with hh
    · set u_x : E'ˣ := Units.mk0 x (hx_pos hh).1
      set u_σx : E'ˣ := Units.map σ_E.toRingEquiv.toMonoidHom u_x
      have htwist_u : θE' (u_σx * u_x⁻¹) = νM₁' (Units.map (normLM F hLE') u_x) := by
        rw [map_mul, map_inv, hσ_E_twist u_x, MonoidHom.comp_apply, mul_inv_cancel_right]
      have hnorm_ux_coe : ((Units.map (normLM F hLE') u_x : Lˣ) : L) = A := rfl
      have htwist_val : (θE' (u_σx * u_x⁻¹) : Ω F) = ((-1 : Ω F) ^ h)⁻¹ := by
        rw [htwist_u, hνM₁'_val (Units.map (normLM F hLE') u_x), hnorm_ux_coe,
          (hx_pos hh).2.2, zpow_neg, zpow_natCast]
      have htwist_inv_val : (((θE' (u_σx * u_x⁻¹))⁻¹ : (Ω F)ˣ) : Ω F) = (-1 : Ω F) ^ h := by
        rw [Units.val_inv_eq_inv_val, htwist_val, inv_inv]
      rw [mul_inv_rev, map_mul, map_inv, map_inv, hθ_ZE', Units.val_mul, htwist_inv_val, mul_comm]
    · have hh0 : h = 0 := by omega
      rw [hh0, pow_zero, one_mul, map_inv, hθ_ZE']
  have hMultPref : (θE' cE' : Ω F) * (νE' c_ν : Ω F) =
      (-1 : Ω F) ^ h * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) := by
    have hcE'_map : (θE' cE' : Ω F) = (θE' u_cν_E' : Ω F) * (θE' (Z_hat⁻¹) : Ω F) := by
      change (θE' (u_cν_E' * Z_hat⁻¹) : Ω F) = _
      rw [map_mul, Units.val_mul]
    rw [hcE'_map, hθ_Zhat_inv, mul_assoc ((-1 : Ω F) ^ h), hM₁'_pref]
    ring
  have hZM₁'_prod :
      IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁') =
        IntermediateField.inclusion hLM₁' A +
          IntermediateField.inclusion hLM₁' b * d + d ^ 2 := by
    have hunit : u_cν_M₁' * cM₁'⁻¹ = Z_M₁' := by
      change u_cν_M₁' * cM₁'⁻¹ = Z_M₁'
      rw [hcM₁'_eq, mul_inv_rev, inv_inv, mul_comm Z_M₁', ← mul_assoc, mul_inv_cancel, one_mul]
    have hcoe := congrArg Units.val hunit
    rw [Units.val_mul, hZM₁'_coe] at hcoe
    exact hcoe
  have htr_incl_M₁' : ∀ a : L,
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a) = (2 : L) * a :=
    (hQuadNorm L M₁' hLM₁' (hdegM₁'.trans hdeg2)).1
  have htr_smul_M₁' : ∀ (a : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a * z) = a * traceLM F hLM₁' z := by
    intro a z
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' a
      (toExtendScalars F hLM₁' z)
  have hd_sq_eq : d ^ 2 = d + IntermediateField.inclusion hLM₁' c := by
    linear_combination hd_sq
  have htr_ZM₁' :
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) =
        (2 : L) * A + b + 1 + (2 : L) * c := by
    rw [hZM₁'_prod, hd_sq_eq, map_add, map_add, map_add,
      htr_incl_M₁' A, htr_smul_M₁' b d, hd_tr, htr_incl_M₁' c]
    ring
  have hx_tr_eq : x + σ_E x = IntermediateField.inclusion hLE' b := (hσ_E_tr x).symm
  have hx_norm_eq : x * σ_E x = IntermediateField.inclusion hLE' A := (hσ_E_norm x).symm
  have hσ_E_inv : σ_E (σ_E x) = x := by
    have h1 := congrArg σ_E hx_tr_eq
    rw [map_add, hσ_E_L b, ← hx_tr_eq] at h1
    linear_combination h1
  have hc_ν_mul_inv :
      IntermediateField.inclusion hLE' (c_ν : L) *
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) = 1 := by
    rw [← map_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, map_one]
  have hTrDiff_zero : h = 0 →
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
        traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
        (4 * A - b ^ 2) + 4 * c := by
    intro hh0
    set Y₀ : E' := IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')
    have hY₀_eq : Y₀ = x ^ 2 + x - IntermediateField.inclusion hLE' c := by
      dsimp only [Y₀]
      rw [hcE'_inv_zero hh0, ← mul_assoc, hc_ν_mul_inv, one_mul]
    have hσ_Y₀ : σ_E Y₀ = (σ_E x) ^ 2 + σ_E x - IntermediateField.inclusion hLE' c := by
      rw [hY₀_eq, map_sub, map_add, map_pow, hσ_E_L c]
    have htr_Y₀_incl :
        IntermediateField.inclusion hLE' (traceLM F hLE' Y₀) =
          IntermediateField.inclusion hLE' (b ^ 2 - (2 : L) * A + b - (2 : L) * c) := by
      rw [hσ_E_tr Y₀, hσ_Y₀, hY₀_eq]
      simp only [map_sub, map_add, map_mul, map_pow, map_ofNat]
      linear_combination
        (x + σ_E x + IntermediateField.inclusion hLE' b + 1) * hx_tr_eq - 2 * hx_norm_eq
    have htr_Y₀ : traceLM F hLE' Y₀ = b ^ 2 - (2 : L) * A + b - (2 : L) * c :=
      (IntermediateField.inclusion hLE').injective htr_Y₀_incl
    rw [htr_ZM₁', htr_Y₀]
    ring
  have hTrDiff_pos : 0 < h →
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
        traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
        c * (b ^ 2 * A⁻¹) := by
    intro hh
    set Y₁ : E' := IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')
    obtain ⟨hx_ne, _, hA_val⟩ := hx_pos hh
    have hA_ne : A ≠ 0 := by
      intro h0
      change valL F L A = -((h : ℕ) : ℤ) at hA_val
      rw [h0, hvalL_0] at hA_val
      omega
    have hA_incl_ne : IntermediateField.inclusion hLE' A ≠ 0 :=
      (map_ne_zero (IntermediateField.inclusion hLE')).mpr hA_ne
    have hσx_ne : σ_E x ≠ 0 :=
      right_ne_zero_of_mul (hx_norm_eq.symm ▸ hA_incl_ne)
    have hA_x_inv : IntermediateField.inclusion hLE' A * x⁻¹ = σ_E x := by
      rw [← hx_norm_eq, mul_comm x (σ_E x), mul_assoc, mul_inv_cancel₀ hx_ne, mul_one]
    have hA_σx_inv : IntermediateField.inclusion hLE' A * (σ_E x)⁻¹ = x := by
      rw [← hx_norm_eq, mul_assoc, mul_inv_cancel₀ hσx_ne, mul_one]
    have hY₁_eq : Y₁ = σ_E x * x⁻¹ * (x ^ 2 + x - IntermediateField.inclusion hLE' c) := by
      dsimp only [Y₁]
      rw [hcE'_inv_pos hh, ← mul_assoc, hc_ν_mul_inv, one_mul]
    have hσ_Y₁ :
        σ_E Y₁ = x * (σ_E x)⁻¹ * ((σ_E x) ^ 2 + σ_E x - IntermediateField.inclusion hLE' c) := by
      rw [hY₁_eq, map_mul, map_mul, map_inv₀, hσ_E_inv, map_sub, map_add, map_pow, hσ_E_L c]
    have hAY₁ :
        IntermediateField.inclusion hLE' A * Y₁ =
          (σ_E x) ^ 2 * (x ^ 2 + x - IntermediateField.inclusion hLE' c) := by
      rw [hY₁_eq]
      linear_combination
        (σ_E x * (x ^ 2 + x - IntermediateField.inclusion hLE' c)) * hA_x_inv
    have hAσ_Y₁ :
        IntermediateField.inclusion hLE' A * σ_E Y₁ =
          x ^ 2 * ((σ_E x) ^ 2 + σ_E x - IntermediateField.inclusion hLE' c) := by
      rw [hσ_Y₁]
      linear_combination
        (x * ((σ_E x) ^ 2 + σ_E x - IntermediateField.inclusion hLE' c)) * hA_σx_inv
    have hAtr_Y₁_incl :
        IntermediateField.inclusion hLE' (A * traceLM F hLE' Y₁) =
          IntermediateField.inclusion hLE'
            (A * ((2 : L) * A + b + (2 : L) * c) - c * b ^ 2) := by
      rw [map_mul, hσ_E_tr Y₁, mul_add, hAY₁, hAσ_Y₁]
      simp only [map_sub, map_add, map_mul, map_pow, map_ofNat]
      linear_combination
        (2 * x * σ_E x + 2 * IntermediateField.inclusion hLE' A + x + σ_E x +
          2 * IntermediateField.inclusion hLE' c) * hx_norm_eq +
        (IntermediateField.inclusion hLE' A -
          IntermediateField.inclusion hLE' c *
            (x + σ_E x + IntermediateField.inclusion hLE' b)) * hx_tr_eq
    have hAtr_Y₁ :
        A * traceLM F hLE' Y₁ = A * ((2 : L) * A + b + (2 : L) * c) - c * b ^ 2 :=
      (IntermediateField.inclusion hLE').injective hAtr_Y₁_incl
    have htr_Y₁ :
        traceLM F hLE' Y₁ = ((2 : L) * A + b + (2 : L) * c) - c * (b ^ 2 * A⁻¹) := by
      apply mul_left_cancel₀ hA_ne
      rw [hAtr_Y₁]
      linear_combination (c * b ^ 2) * mul_inv_cancel₀ hA_ne
    rw [htr_ZM₁', htr_Y₁]
    ring
  exact ⟨cE', hcE'_val, hcE'_eq_zero, hcE'_inv_zero, hcE'_inv_pos,
    hMultPref, hTrDiff_zero, hTrDiff_pos⟩

theorem ld_ch12_wild_dyadic_unramified_k1_norm_pullback_master (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (hψ_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (νE' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
