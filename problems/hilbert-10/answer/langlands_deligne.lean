              (tateEpsUnit F L' (recChar F rec L' ν') (traceChar F hLL' ψ)) ^ q₀ := by
        intro ν' hν'
        obtain ⟨hν'_rest, hν'_pow⟩ := hν_props ν' hν'
        have hTw := hTwistInvL' L' E_L' hLL' (hL'M₁.trans hM₁MC) hEE_L' hL'E_L' hE_L'K
          hEL'_sup ν' hν'_rest hν'_pow
        have hSub_ν := hSubfieldInd L' E_L' hLL' hL'E_L' hE_L'K hLL'_lt ν' hTw.1
          (⟨1, L', le_rfl, 1⟩ :: D_L'_orb) hDL'_decomp hDL'_all_leK
        rw [heval_cons_un L' (traceChar F hLL' ψ) D_L'_orb,
          heval_cons_tw L' (traceChar F hLL' ψ) ν' D_L'_orb] at hSub_ν
        have hSub_ν_pow := congrArg (fun x : (Ω F)ˣ => x ^ q₀) hSub_ν
        dsimp only at hSub_ν_pow
        rw [mul_pow, mul_pow, mul_pow, mul_pow,
          hTw.2.2.2 D_L'_orb hDL'_props, ← mul_assoc, ← mul_assoc] at hSub_ν_pow
        exact mul_right_cancel hSub_ν_pow
      have hprod_eq :
          (ν_list.map (fun ν' =>
            (tateEpsUnit F E_L' (recChar F rec E_L' (restrictWeilChar F hL'E_L' ν'))
              (traceChar F (hLL'.trans hL'E_L') ψ)) ^ q₀ * eL'_1 ^ q₀)).prod =
          (ν_list.map (fun ν' =>
            eEL'_1 ^ q₀ *
              (tateEpsUnit F L' (recChar F rec L' ν') (traceChar F hLL' ψ)) ^ q₀)).prod := by
        congr 1
        exact List.map_congr_left hν_eq
      rw [List.prod_map_mul, List.prod_map_mul,
        hlist_const ν_list (fun _ => eL'_1 ^ q₀) (eL'_1 ^ q₀) (fun _ _ => rfl),
        hlist_const ν_list (fun _ => eEL'_1 ^ q₀) (eEL'_1 ^ q₀) (fun _ _ => rfl),
        hν_len, ← hlist_pow, ← hlist_pow, ← hPtameE_1_eq, ← hPtame_1_eq] at hprod_eq
      exact hprod_eq
    have h_cancel : ∀ (aL_1 aL_χ aP_orb_1 aP_orb_χ aP_tame_1 aP_tame_χ
        aE_1 aE_χ aP_tameE_1 aP_tameE_χ aF'_1 aF'_χ aE'_1 aE'_χ
        aL'_1 aL'_χ aP_L'_1 aP_L'_χ aEL'_1 aEL'_χ : (Ω F)ˣ),
        aF'_χ * (aL_1 * aP_tame_1) = aF'_1 * (aL_χ * aP_tame_χ) →
        aE'_χ * (aE_1 * aP_tameE_1) = aE'_1 * (aE_χ * aP_tameE_χ) →
        aE'_χ * (aF'_1 * (aP_orb_1 * aP_L'_1 ^ r)) =
          aE'_1 * (aF'_χ * (aP_orb_χ * aP_L'_χ ^ r)) →
        aEL'_χ * (aL'_1 * aP_L'_1) = aEL'_1 * (aL'_χ * aP_L'_χ) →
        aP_tame_χ ^ q₀ = (aL'_χ ^ q₀) ^ r →
        aP_tameE_χ ^ q₀ = (aEL'_χ ^ q₀) ^ r →
        aP_tameE_1 ^ q₀ * (aL'_1 ^ q₀) ^ r = (aEL'_1 ^ q₀) ^ r * aP_tame_1 ^ q₀ →
        (aE_χ * (aL_1 * aP_orb_1)) ^ q₀ = (aE_1 * (aL_χ * aP_orb_χ)) ^ q₀ := by
      intro aL_1 aL_χ aP_orb_1 aP_orb_χ aP_tame_1 aP_tame_χ
        aE_1 aE_χ aP_tameE_1 aP_tameE_χ aF'_1 aF'_χ aE'_1 aE'_χ
        aL'_1 aL'_χ aP_L'_1 aP_L'_χ aEL'_1 aEL'_χ
        hT1 hT2 hSF hSL h5a' h5b' h6'
      have h1 : aF'_χ ^ q₀ * aL_1 ^ q₀ * aP_tame_1 ^ q₀ =
          aF'_1 ^ q₀ * aL_χ ^ q₀ * (aL'_χ ^ q₀) ^ r := by
        have h := congrArg (fun x : (Ω F)ˣ => x ^ q₀) hT1
        dsimp only at h
        rw [mul_pow, mul_pow, mul_pow, mul_pow, ← mul_assoc, ← mul_assoc, h5a'] at h
        exact h
      have h2 : aE'_1 ^ q₀ * aE_χ ^ q₀ * (aEL'_χ ^ q₀) ^ r =
          aE'_χ ^ q₀ * aE_1 ^ q₀ * aP_tameE_1 ^ q₀ := by
        have h := congrArg (fun x : (Ω F)ˣ => x ^ q₀) hT2
        dsimp only at h
        rw [mul_pow, mul_pow, mul_pow, mul_pow, ← mul_assoc, ← mul_assoc, h5b'] at h
        exact h.symm
      have h3 : aE'_χ ^ q₀ * aF'_1 ^ q₀ * aP_orb_1 ^ q₀ * (aP_L'_1 ^ q₀) ^ r =
          aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_orb_χ ^ q₀ * (aP_L'_χ ^ q₀) ^ r := by
        have h := congrArg (fun x : (Ω F)ˣ => x ^ q₀) hSF
        dsimp only at h
        rw [mul_pow, mul_pow, mul_pow, mul_pow, mul_pow, mul_pow,
          ← pow_mul, mul_comm r q₀, pow_mul,
          ← pow_mul aP_L'_χ, mul_comm r q₀, pow_mul] at h
        calc aE'_χ ^ q₀ * aF'_1 ^ q₀ * aP_orb_1 ^ q₀ * (aP_L'_1 ^ q₀) ^ r
            = aE'_χ ^ q₀ * (aF'_1 ^ q₀ * (aP_orb_1 ^ q₀ * (aP_L'_1 ^ q₀) ^ r)) := by ac_rfl
          _ = aE'_1 ^ q₀ * (aF'_χ ^ q₀ * (aP_orb_χ ^ q₀ * (aP_L'_χ ^ q₀) ^ r)) := h
          _ = aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_orb_χ ^ q₀ * (aP_L'_χ ^ q₀) ^ r := by ac_rfl
      have h4 : (aEL'_1 ^ q₀) ^ r * (aL'_χ ^ q₀) ^ r * (aP_L'_χ ^ q₀) ^ r =
          (aEL'_χ ^ q₀) ^ r * (aL'_1 ^ q₀) ^ r * (aP_L'_1 ^ q₀) ^ r := by
        have h := congrArg (fun x : (Ω F)ˣ => (x ^ q₀) ^ r) hSL
        dsimp only at h
        rw [mul_pow, mul_pow, mul_pow, mul_pow, mul_pow, mul_pow, mul_pow, mul_pow,
          ← mul_assoc, ← mul_assoc] at h
        exact h.symm
      rw [mul_pow, mul_pow, mul_pow, mul_pow]
      apply mul_right_cancel
        (b := aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_tame_1 ^ q₀ *
          (aEL'_χ ^ q₀) ^ r * (aL'_1 ^ q₀) ^ r * (aP_L'_1 ^ q₀) ^ r)
      calc
        (aE_χ ^ q₀ * (aL_1 ^ q₀ * aP_orb_1 ^ q₀)) *
            (aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_tame_1 ^ q₀ *
              (aEL'_χ ^ q₀) ^ r * (aL'_1 ^ q₀) ^ r * (aP_L'_1 ^ q₀) ^ r)
          = (aE'_1 ^ q₀ * aE_χ ^ q₀ * (aEL'_χ ^ q₀) ^ r) *
              (aF'_χ ^ q₀ * aL_1 ^ q₀ * aP_tame_1 ^ q₀) *
              aP_orb_1 ^ q₀ * (aL'_1 ^ q₀) ^ r * (aP_L'_1 ^ q₀) ^ r := by ac_rfl
        _ = (aE'_χ ^ q₀ * aE_1 ^ q₀ * aP_tameE_1 ^ q₀) *
              (aF'_1 ^ q₀ * aL_χ ^ q₀ * (aL'_χ ^ q₀) ^ r) *
              aP_orb_1 ^ q₀ * (aL'_1 ^ q₀) ^ r * (aP_L'_1 ^ q₀) ^ r := by rw [h2, h1]
        _ = aE_1 ^ q₀ * aL_χ ^ q₀ * (aL'_χ ^ q₀) ^ r *
              (aP_tameE_1 ^ q₀ * (aL'_1 ^ q₀) ^ r) *
              (aE'_χ ^ q₀ * aF'_1 ^ q₀ * aP_orb_1 ^ q₀ * (aP_L'_1 ^ q₀) ^ r) := by ac_rfl
        _ = aE_1 ^ q₀ * aL_χ ^ q₀ * (aL'_χ ^ q₀) ^ r *
              ((aEL'_1 ^ q₀) ^ r * aP_tame_1 ^ q₀) *
              (aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_orb_χ ^ q₀ * (aP_L'_χ ^ q₀) ^ r) := by rw [h6', h3]
        _ = aE_1 ^ q₀ * aL_χ ^ q₀ * aP_orb_χ ^ q₀ *
              aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_tame_1 ^ q₀ *
              ((aEL'_1 ^ q₀) ^ r * (aL'_χ ^ q₀) ^ r * (aP_L'_χ ^ q₀) ^ r) := by ac_rfl
        _ = aE_1 ^ q₀ * aL_χ ^ q₀ * aP_orb_χ ^ q₀ *
              aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_tame_1 ^ q₀ *
              ((aEL'_χ ^ q₀) ^ r * (aL'_1 ^ q₀) ^ r * (aP_L'_1 ^ q₀) ^ r) := by rw [h4]
        _ = (aE_1 ^ q₀ * (aL_χ ^ q₀ * aP_orb_χ ^ q₀)) *
            (aE'_1 ^ q₀ * aF'_χ ^ q₀ * aP_tame_1 ^ q₀ *
              (aEL'_χ ^ q₀) ^ r * (aL'_1 ^ q₀) ^ r * (aP_L'_1 ^ q₀) ^ r) := by ac_rfl
    exact h_cancel eL_1 eL_χ P_orb_1 P_orb_χ P_tame_1 P_tame_χ
      eE_1 eE_χ P_tameE_1 P_tameE_χ eF'_1 eF'_χ eE'_1 eE'_χ
      eL'_1 eL'_χ P_L'_1 P_L'_χ eEL'_1 eEL'_χ
      hTame3ML hTame3ML_E hSub_F' hSub_L' h5a h5b h6

theorem ld_ch14_fourth_main_lemma_wild (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hSubfieldInd : ∀ (F' E' : IntermediateField F (AlgebraicClosure F))
      (hLF' : L ≤ F') (hF'E' : F' ≤ E') (hE'K : E' ≤ K),
      L < F' →
      ∀ (χF' : relWeil F F' →* (Ω F)ˣ),
        IsWeilRep F F' (charRep F F' χF') →
      ∀ (D_F' : List (MonomialTerm F F')),
        IsMonomialDecomp F F'
          (fun w => (⟨1, E', hF'E', 1⟩ : MonomialTerm F F').trace F F' w) D_F' →
        (∀ t ∈ D_F', t.field ≤ K) →
        tateEpsUnit F E' (recChar F rec E' (restrictWeilChar F hF'E' χF'))
            (traceChar F (hLF'.trans hF'E') ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ) D_F' =
        tateEpsUnit F E' (recChar F rec E' 1)
            (traceChar F (hLF'.trans hF'E') ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) F' (traceChar F hLF' ψ)
            (D_F'.map (twistMonomialTerm F F' χF')))
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_deg : monomialListDeg F L D_orb =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) - 1)
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1)) :
    tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
    tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ
        ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext)) :=
by
  have hLowCond : ∀ (χ : relWeil F L →* (Ω F)ˣ),
      IsWeilRep F L (charRep F L χ) →
      condExp F L (recChar F rec L χ) ≤ 1 →
      tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χ)) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) =
      tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ
          ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χ)) :=
    fun χ hχ h_low =>
      ld_ch14_lemma_14_2_low_conductor_exact F rec L K M_C E hLK hLM_C hM_CK hLE hEK
        h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin h_wild hFinE_eq
        D_orb hD₁_sub hD_orb_deg hD_orb_props χ hχ h_low
  by_cases h_low : condExp F L (recChar F rec L χL_ext) ≤ 1
  · exact hLowCond χL_ext hχL_ext h_low
  · have h_ge2 : 2 ≤ condExp F L (recChar F rec L χL_ext) := by omega
    have h_bezout : ∀ (x y : (Ω F)ˣ) (m n : ℕ),
        Nat.Coprime m n → x ^ m = y ^ m → x ^ n = y ^ n → x = y := by
      intro x y m n hcop hm hn
      have hgcd : (m.gcd n : ℤ) = 1 := by exact_mod_cast hcop.gcd_eq_one
      have hab := Nat.gcd_eq_gcd_ab m n
      rw [hgcd] at hab
      calc x = x ^ (1 : ℤ) := (zpow_one x).symm
        _ = x ^ ((m : ℤ) * m.gcdA n + (n : ℤ) * m.gcdB n) := by rw [← hab]
        _ = (x ^ m) ^ (m.gcdA n) * (x ^ n) ^ (m.gcdB n) := by
            rw [zpow_add, zpow_mul, zpow_mul, zpow_natCast, zpow_natCast]
        _ = (y ^ m) ^ (m.gcdA n) * (y ^ n) ^ (m.gcdB n) := by rw [hm, hn]
        _ = y ^ ((m : ℤ) * m.gcdA n + (n : ℤ) * m.gcdB n) := by
            rw [← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, ← zpow_add]
        _ = y ^ (1 : ℤ) := by rw [← hab]
        _ = y := zpow_one y
    obtain ⟨hStick_2p, hStick_p⟩ :=
      ld_ch14_lemma_14_2_and_14_3_stickelberger_pow F rec L K M_C E hLK hLM_C hM_CK hLE hEK
        h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin h_wild hFinE_eq
        χL_ext hχL_ext D_orb hD₁_sub hD_orb_deg hD_orb_props h_ge2
    rcases ld_ch14_wild_semidirect_coprime_prime_exists F L K M_C E hLK hLM_C hM_CK hLE hEK
        h_inf h_sup hLM_C_lt hCore hGal hMin h_wild with
      ⟨q₀, hq₀_prime, hq₀_dvd, hq₀_ne_p, _, hcop⟩ | ⟨hp_ne2, h2_prime, h2_dvd, hcop, h_only_2p⟩
    · obtain ⟨k₁, hk₁⟩ := hStick_2p
      obtain ⟨k₂, hk₂⟩ :=
        ld_ch14_lemma_14_4_and_14_5_subfield_ind_pow F rec L K M_C E hLK hLM_C hM_CK hLE hEK
          h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin h_wild hFinE_eq hSubfieldInd
          D_orb hD₁_sub hD_orb_deg hD_orb_props hLowCond χL_ext hχL_ext h_ge2
          q₀ hq₀_prime hq₀_dvd hq₀_ne_p
      exact h_bezout _ _ ((2 * p F) ^ k₁) (q₀ ^ k₂) (hcop.pow k₁ k₂) hk₁ hk₂
    · obtain ⟨k₁, hk₁⟩ := hStick_p ⟨hp_ne2, h_only_2p⟩
      obtain ⟨k₂, hk₂⟩ :=
        ld_ch14_lemma_14_4_and_14_5_subfield_ind_pow F rec L K M_C E hLK hLM_C hM_CK hLE hEK
          h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin h_wild hFinE_eq hSubfieldInd
          D_orb hD₁_sub hD_orb_deg hD_orb_props hLowCond χL_ext hχL_ext h_ge2
          2 h2_prime h2_dvd hp_ne2.symm
      exact h_bezout _ _ ((p F) ^ k₁) (2 ^ k₂) (hcop.pow k₁ k₂) hk₁ hk₂

theorem ld_ch13_14_semidirect_main_lemmas (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (D₀ : List (MonomialTerm F L))
    (hD₀_sub : IsSubMonomialDecomp F L M_C E hLE D₀)
    (hD₀_rest1 : ∀ t ∈ D₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) :
    tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ D₀ =
    tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
      evalMonomialList F rec (fun _ _ _ => 1) L ψ (D₀.map (twistMonomialTerm F L χL_ext)) :=
by
  obtain ⟨hD₀_inv, hSubfieldInd⟩ :=
    ld_ch13_14_sub_monomial_invariance_and_descent F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      hGal ψ hψ hTheory hMin χL_ext hχL_ext
  obtain ⟨_, _, hFinE_eq, ℓ, D_orb, hPrime_ℓ, hℓ_dvd, hD₁_sub, hD_orb_deg, hD_orb_props, hTame_branch, hWild_branch⟩ :=
    ld_ch13_14_canonical_orbit_decomp_and_structure F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hMin
  apply hD₀_inv D₀ (⟨1, L, le_rfl, 1⟩ :: D_orb) hD₀_sub hD₁_sub
  by_cases hp_dvd : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  · have hℓ_eq_p : ℓ = p F := hWild_branch hp_dvd
    have hD_orb_wild : ∀ t ∈ D_orb,
        t.coeff = 1 ∧
        L < t.field ∧
        t.field ≤ M_C ∧
        t.χ ^ (p F) = 1 ∧
        (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
        (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
        (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1) := by
      intro t ht
      obtain ⟨hc, hlt, hle, hpow, hK, hE, hM⟩ := hD_orb_props t ht
      exact ⟨hc, hlt, hle, hℓ_eq_p ▸ hpow, hK, hE, hM⟩
    exact ld_ch14_fourth_main_lemma_wild F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal ψ hψ hMin hp_dvd hFinE_eq hSubfieldInd
      χL_ext hχL_ext D_orb hD₁_sub hD_orb_deg hD_orb_wild
  · obtain ⟨_, hPrime_MCK, _, hField_MC⟩ := hTame_branch hp_dvd
    have hℓ_eq_MCK : ℓ = Module.finrank M_C (IntermediateField.extendScalars hM_CK) :=
      (Nat.dvd_prime hPrime_MCK).mp hℓ_dvd |>.resolve_left hPrime_ℓ.ne_one
    have hD_orb_tame : ∀ t ∈ D_orb,
        t.coeff = 1 ∧
        t.field = M_C ∧
        t.χ ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
        (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
        (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
        (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1) := by
      intro t ht
      obtain ⟨hc, _, _, hpow, hK, hE, hM⟩ := hD_orb_props t ht
      exact ⟨hc, hField_MC t ht, hℓ_eq_MCK ▸ hpow, hK, hE, hM⟩
    exact ld_ch13_third_main_lemma_tame F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hGal ψ hψ hMin hp_dvd hPrime_MCK hFinE_eq
      χL_ext hχL_ext D_orb hD₁_sub hD_orb_deg hD_orb_tame

theorem ld_ch15_mackey_and_main_lemma_15_3 (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK) :
    HasMackeyDecompOn F rec L K M_C hLK hLM_C hM_CK ψ :=
by
  refine ⟨?_, ?_⟩
  · intro E hLE hEK hF'E hF'K χL χE hχL hχE h_rest
    exact ld_ch15_mackey_orbit_decomp F L K M_C E (E ⊓ M_C) hLK hLM_C hM_CK hLE hEK
      (le_inf hLE hLM_C) hF'E inf_le_right le_rfl hGal hMin χL χE hχL hχE h_rest
  · intro E hLE hEK h_inf h_sup χL χE hχL hχE h_rest
    obtain ⟨⟨hWeil1L, hWeil1E⟩, χL_ext, hχL_ext, hχL_ext_E, hχL_ext_K, hDesc⟩ :=
      ld_ch15_char_ext_and_normal_descent F rec L K M_C E hLK hLM_C hM_CK hLE hEK
        h_inf h_sup hGal ψ hψ hTheory hMin χL χE hχL hχE h_rest
    obtain ⟨D₀, hD₀_decomp, hD₀_le, hD₀_rest, _, hD₀_K₁⟩ :=
      ld_ch15_mackey_orbit_decomp F L K M_C E L hLK hLM_C hM_CK hLE hEK
        le_rfl hLE hLM_C (le_of_eq h_inf) hGal hMin 1 1 hWeil1L hWeil1E rfl
    have hD₀_sub : IsSubMonomialDecomp F L M_C E hLE D₀ := ⟨hD₀_decomp, hD₀_le⟩
    have hD₀_rest1 : ∀ t ∈ D₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1 :=
      hD₀_rest
    have hD₀_K₁' : ∀ (K₁ : IntermediateField F (AlgebraicClosure F)),
        L ≤ K₁ → K₁ ≤ K → IsGaloisExt F L K₁ → E ≤ K₁ → K₁ ⊔ M_C = K →
        ∀ t ∈ D₀, t.field ≤ K₁ := hD₀_K₁ rfl rfl
    obtain ⟨hDt_decomp, hDt_le, hDt_rest, hDt_eval⟩ :=
      hDesc D₀ hD₀_sub hD₀_rest1 hD₀_K₁'
    refine ⟨D₀.map (twistMonomialTerm F L χL_ext), hDt_decomp, hDt_le, hDt_rest, hDt_eval ?_⟩
    by_cases hCore : ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
        K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
        Module.finrank L (IntermediateField.extendScalars hLK₁) <
          Module.finrank L (IntermediateField.extendScalars hLK)
    · exact Or.inl hCore
    · apply Or.inr
      by_cases hMC : M_C = L
      · exact ld_ch10_first_main_lemma_cyclic F rec L K M_C E hLK hLM_C hM_CK hLE hEK
          h_inf h_sup hMC hGal ψ hψ hMin χL_ext hχL_ext D₀ hD₀_sub hD₀_rest1
      · have hLM_C_lt : L < M_C := lt_of_le_of_ne hLM_C (Ne.symm hMC)
        exact ld_ch13_14_semidirect_main_lemmas F rec L K M_C E hLK hLM_C hM_CK hLE hEK
          h_inf h_sup hLM_C_lt hCore hGal ψ hψ hTheory hMin χL_ext hχL_ext D₀ hD₀_sub hD₀_rest1

theorem ld_ch16_candLamFrom_spec_and_sub_MC (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK) :
    (∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K)
      (hLF' : L ≤ E ⊓ M_C) (hF'E : E ⊓ M_C ≤ E)
      (D_M : List (MonomialTerm F (E ⊓ M_C))),
      IsMonomialDecomp F (E ⊓ M_C)
        (fun w => (⟨1, E, hF'E, 1⟩ : MonomialTerm F (E ⊓ M_C)).trace F (E ⊓ M_C) w) D_M →
      (∀ t ∈ D_M, t.field ≤ M_C) →
      evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
          (D_M.map (MonomialTerm.restrict F hLF'))) ∧
    candLamFrom F rec L M_C ψ L = 1 ∧
    (∀ E, L ≤ E → E ≤ M_C → candLamFrom F rec L M_C ψ E = galoisLam F rec L M_C ψ E) :=
by
  have htrace_append : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (D₁ D₂ : List (MonomialTerm F M)) (w : relWeil F M),
      monomialListTrace F M (D₁ ++ D₂) w =
        monomialListTrace F M D₁ w + monomialListTrace F M D₂ w := by
    intro M D₁ D₂ w
    simp [monomialListTrace, List.map_append, List.sum_append]
  have htrace_neg : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (D : List (MonomialTerm F M)) (w : relWeil F M),
      monomialListTrace F M (D.map (MonomialTerm.neg F M)) w =
        - monomialListTrace F M D w := by
    intro M D w
    induction D with
    | nil => simp [monomialListTrace]
    | cons t tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F M).trace F M w = - (t.trace F M w) := by
        simp [MonomialTerm.neg, MonomialTerm.trace, neg_smul]
      rw [ht, ih]
      ring
  have heval_append : ∀ (lam : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)), AddChar L' (Ω F) → (Ω F)ˣ)
      (M : IntermediateField F (AlgebraicClosure F))
      (ψM : AddChar M (Ω F)) (D₁ D₂ : List (MonomialTerm F M)),
      evalMonomialList F rec lam M ψM (D₁ ++ D₂) =
        evalMonomialList F rec lam M ψM D₁ * evalMonomialList F rec lam M ψM D₂ := by
    intro lam M ψM D₁ D₂
    simp [evalMonomialList, List.map_append, List.prod_append]
  have heval_neg : ∀ (lam : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)), AddChar L' (Ω F) → (Ω F)ˣ)
      (M : IntermediateField F (AlgebraicClosure F))
      (ψM : AddChar M (Ω F)) (D : List (MonomialTerm F M)),
      evalMonomialList F rec lam M ψM (D.map (MonomialTerm.neg F M)) =
        (evalMonomialList F rec lam M ψM D)⁻¹ := by
    intro lam M ψM D
    induction D with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have ht : evalMonomialTerm F rec lam M ψM (t.neg F M) =
          (evalMonomialTerm F rec lam M ψM t)⁻¹ := by
        simp [MonomialTerm.neg, evalMonomialTerm, zpow_neg]
      rw [ht, ih, mul_inv]
  have hLamMC : IsLambdaFuncOn F rec L M_C ψ (galoisLam F rec L M_C ψ) :=
    hTheory.1 L M_C hLM_C hMin.1 hMin.2.2.1 ψ hψ
  have hCand_sub : ∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E)
      (D₀ : List (MonomialTerm F L)),
      IsSubMonomialDecomp F L M_C E hLE D₀ →
      evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₀ := by
    intro E hLE D₀ hSub₀
    have hD : ∃ D₀' : List (MonomialTerm F L), IsSubMonomialDecomp F L M_C E hLE D₀' := ⟨D₀, hSub₀⟩
    set D₁ := hD.choose
    have hSub₁ : IsSubMonomialDecomp F L M_C E hLE D₁ := hD.choose_spec
    have hcand : candLamFrom F rec L M_C ψ E =
        (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ))⁻¹ *
          evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₁ := by
      unfold candLamFrom
      rw [dif_pos hLE, dif_pos hD]
    have hLHS : evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₁ := by
      simp only [evalMonomialTerm, zpow_one]
      rw [hcand, mul_inv_cancel_left]
    rw [hLHS]
    have hZero : IsMonomialDecomp F L 0 (D₀ ++ D₁.map (MonomialTerm.neg F L)) := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rw [List.mem_append] at ht
        rcases ht with ht | ht
        · exact hSub₀.1.1 t ht
        · rw [List.mem_map] at ht
          rcases ht with ⟨t₁, ht₁, rfl⟩
          exact hSub₁.1.1 t₁ ht₁
      · intro w
        rw [Pi.zero_apply, htrace_append, htrace_neg, ← hSub₀.1.2 w, ← hSub₁.1.2 w, add_neg_cancel]
    have hMC_Δ : ∀ t ∈ D₀ ++ D₁.map (MonomialTerm.neg F L), t.field ≤ M_C := by
      intro t ht
      rw [List.mem_append] at ht
      rcases ht with ht | ht
      · exact hSub₀.2 t ht
      · rw [List.mem_map] at ht
        rcases ht with ⟨t₁, ht₁, rfl⟩
        exact hSub₁.2 t₁ ht₁
    have hprod := hLamMC.2 (D₀ ++ D₁.map (MonomialTerm.neg F L)) hZero hMC_Δ
    rw [heval_append, heval_neg] at hprod
    exact (mul_inv_eq_one.mp hprod).symm
  have hSep_iff : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)) (hLE' : L' ≤ E'),
      Algebra.IsSeparable L' (IntermediateField.extendScalars hLE') ↔
        E' ≤ IntermediateField.restrictScalars F (separableClosure L' (AlgebraicClosure F)) := by
    intro L' E' hLE'
    let S := IntermediateField.extendScalars hLE'
    have hmin : ∀ x : S, IsSeparable L' x.1 ↔ IsSeparable L' x := by
      intro x
      change (minpoly L' (S.val x)).Separable ↔ (minpoly L' x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hLE').mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L' S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E' := (IntermediateField.mem_extendScalars hLE').mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hSep_sub : ∀ (M E' : IntermediateField F (AlgebraicClosure F))
      (hLM : L ≤ M) (hME' : M ≤ E') (hE'K : E' ≤ K),
      Algebra.IsSeparable M (IntermediateField.extendScalars hME') := by
    intro M E' hLM hME' hE'K
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z := by
      have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) (hE'K hz)
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLM)) hzL
  have hCand_decomp : ∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K)
      (hLF' : L ≤ E ⊓ M_C) (hF'E : E ⊓ M_C ≤ E)
      (D_M : List (MonomialTerm F (E ⊓ M_C))),
      IsMonomialDecomp F (E ⊓ M_C)
        (fun w => (⟨1, E, hF'E, 1⟩ : MonomialTerm F (E ⊓ M_C)).trace F (E ⊓ M_C) w) D_M →
      (∀ t ∈ D_M, t.field ≤ M_C) →
      evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
          (D_M.map (MonomialTerm.restrict F hLF')) := by
    intro E hLE hEK
    set F' : IntermediateField F (AlgebraicClosure F) := E ⊓ M_C
    intro hLF' hF'E D_M hDM_decomp hDM_MC
    haveI : FiniteDimensional F K := hGal.2.1
    haveI : FiniteDimensional F E :=
      Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
        (IntermediateField.inclusion hEK).injective
    haveI : FiniteDimensional F F' :=
      Module.Finite.of_injective (IntermediateField.inclusion (hF'E.trans hEK)).toLinearMap
        (IntermediateField.inclusion (hF'E.trans hEK)).injective
    have hSepLF' : Algebra.IsSeparable L (IntermediateField.extendScalars hLF') :=
      hSep_sub L F' le_rfl hLF' (hF'E.trans hEK)
    have hSepF'E : Algebra.IsSeparable F' (IntermediateField.extendScalars hF'E) :=
      hSep_sub F' E hLF' hF'E hEK
    let t_neg : MonomialTerm F F' := ⟨-1, E, hF'E, 1⟩
    have ht_neg_Wf : t_neg.Wf F F' :=
      ⟨inferInstance, hSepF'E, inferInstance, Set.univ, Filter.univ_mem,
        fun _ _ _ => by ext; simp [t_neg, charRep]⟩
    let σ₀ : Representation (Ω F) (relWeil F F') PUnit.{u+1} := 1
    have hσ₀ : IsWeilRep F F' σ₀ :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
    let D_zero : List (MonomialTerm F F') := t_neg :: D_M
    have hD_zero : IsMonomialDecomp F F'
        (fun w => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) D_zero := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_neg_Wf
        · exact hDM_decomp.1 t ht
      · intro w
        dsimp only
        have hw0 : σ₀ w = 0 := Subsingleton.elim (σ₀ w) 0
        rw [hw0, LinearMap.map_zero]
        change 0 = t_neg.trace F F' w + monomialListTrace F F' D_M w
        have ht_tr : t_neg.trace F F' w =
            - (⟨1, E, hF'E, 1⟩ : MonomialTerm F F').trace F F' w := by
          simp [t_neg, MonomialTerm.trace]
        have hDM_w : (⟨1, E, hF'E, 1⟩ : MonomialTerm F F').trace F F' w =
            monomialListTrace F F' D_M w := hDM_decomp.2 w
        rw [ht_tr, hDM_w]
        exact (neg_add_cancel _).symm
    have hD_res := ((ld_trace_exact_and_char F).2.2 L F' hLF' hSepLF' σ₀ hσ₀ D_zero hD_zero).1
    have hSubInd : Subsingleton
        (indSpace ((relWeil F F').subgroupOf (relWeil F L))
          (σ₀.comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLF')).toMonoidHom)) :=
      ⟨fun f g => Subtype.ext (funext fun x => Subsingleton.elim (f.1 x) (g.1 x))⟩
    have htr_res_zero : ∀ w : relWeil F L,
        LinearMap.trace (Ω F) _ (indLM F hLF' σ₀ w) = 0 := by
      intro w
      have hw : indLM F hLF' σ₀ w = 0 :=
        LinearMap.ext fun f => @Subsingleton.elim _ hSubInd _ _
      rw [hw, LinearMap.map_zero]
    set D₀ := D_M.map (MonomialTerm.restrict F hLF')
    have hSub₀ : IsSubMonomialDecomp F L M_C E hLE D₀ := by
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · intro t ht
        exact hD_res.1 t (List.mem_cons_of_mem _ ht)
      · intro w
        have htr := hD_res.2 w
        dsimp only at htr ⊢
        rw [htr_res_zero w] at htr
        change 0 = (⟨-1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w +
          monomialListTrace F L D₀ w at htr
        have ht_neg_L : (⟨-1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w =
            - (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w := by
          simp [MonomialTerm.trace]
        rw [ht_neg_L] at htr
        exact neg_add_eq_zero.mp htr.symm
      · intro t ht
        rcases List.mem_map.mp ht with ⟨t₀, ht₀, rfl⟩
        exact hDM_MC t₀ ht₀
    exact hCand_sub E hLE D₀ hSub₀
  have hCand_MC : ∀ E, L ≤ E → E ≤ M_C →
      candLamFrom F rec L M_C ψ E = galoisLam F rec L M_C ψ E := by
    intro E hLE hEM_C
    have hEK : E ≤ K := hEM_C.trans hM_CK
    haveI : FiniteDimensional F K := hGal.2.1
    haveI : FiniteDimensional F E :=
      Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
        (IntermediateField.inclusion hEK).injective
    have hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE) :=
      hSep_sub L E le_rfl hLE hEK
    let t₀ : MonomialTerm F L := ⟨1, E, hLE, 1⟩
    have ht₀_Wf : t₀.Wf F L :=
      ⟨inferInstance, hSepLE, inferInstance, Set.univ, Filter.univ_mem,
        fun _ _ _ => by ext; simp [t₀, charRep]⟩
    have hSub_single : IsSubMonomialDecomp F L M_C E hLE [t₀] := by
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · intro t ht
        rw [List.mem_singleton] at ht
        subst ht
        exact ht₀_Wf
      · intro w
        simp [monomialListTrace, t₀]
      · intro t ht
        rw [List.mem_singleton] at ht
        subst ht
        exact hEM_C
    have heq := hCand_sub E hLE [t₀] hSub_single
    simp only [t₀, evalMonomialList, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
      mul_one, evalMonomialTerm, zpow_one] at heq
    exact mul_left_cancel heq
  have hNorm : candLamFrom F rec L M_C ψ L = 1 := by
    rw [hCand_MC L le_rfl hLM_C, hLamMC.1]
  exact ⟨hCand_decomp, hNorm, hCand_MC⟩

theorem ld_ch16_candLamFrom_normal_subfields (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hMackey : HasMackeyDecompOn F rec L K M_C hLK hLM_C hM_CK ψ)
    (hCand_decomp : ∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K)
      (hLF' : L ≤ E ⊓ M_C) (hF'E : E ⊓ M_C ≤ E)
      (D_M : List (MonomialTerm F (E ⊓ M_C))),
      IsMonomialDecomp F (E ⊓ M_C)
        (fun w => (⟨1, E, hF'E, 1⟩ : MonomialTerm F (E ⊓ M_C)).trace F (E ⊓ M_C) w) D_M →
      (∀ t ∈ D_M, t.field ≤ M_C) →
      evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
          (D_M.map (MonomialTerm.restrict F hLF')))
    (hCand_MC : ∀ E, L ≤ E → E ≤ M_C → candLamFrom F rec L M_C ψ E = galoisLam F rec L M_C ψ E) :
    ∀ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K → IsGaloisExt F L K₁ →
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      ∀ E, L ≤ E → E ≤ K₁ → candLamFrom F rec L M_C ψ E = galoisLam F rec L K₁ ψ E :=
by
  have hGalSub_eq : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hLB : L ≤ B) (hAB : A ≤ B),
      IsGaloisExt F L A → IsGaloisExt F L B →
      Module.finrank L (IntermediateField.extendScalars hLA) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      Module.finrank L (IntermediateField.extendScalars hLB) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      ∀ E', L ≤ E' → E' ≤ A →
        galoisLam F rec L B ψ E' = galoisLam F rec L A ψ E' := by
    intro A B hLA hLB hAB hGalA hGalB hltA hltB E' hLE' hE'A
    have hLamB : IsLambdaFuncOn F rec L B ψ (galoisLam F rec L B ψ) :=
      hTheory.1 L B hLB hGalB hltB ψ hψ
    have hLamB_A : IsLambdaFuncOn F rec L A ψ (galoisLam F rec L B ψ) :=
      ⟨hLamB.1, fun D hD hDA => hLamB.2 D hD (fun t ht => (hDA t ht).trans hAB)⟩
    exact hTheory.2.1 L A hLA hGalA hltA ψ hψ (galoisLam F rec L B ψ) hLamB_A E' hLE' hE'A
  have hSep_iff : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)) (hLE' : L' ≤ E'),
      Algebra.IsSeparable L' (IntermediateField.extendScalars hLE') ↔
        E' ≤ IntermediateField.restrictScalars F (separableClosure L' (AlgebraicClosure F)) := by
    intro L' E' hLE'
    let S_ext := IntermediateField.extendScalars hLE'
    have hmin : ∀ x : S_ext, IsSeparable L' x.1 ↔ IsSeparable L' x := by
      intro x
      change (minpoly L' (S_ext.val x)).Separable ↔ (minpoly L' x).Separable
      rw [minpoly.algHom_eq S_ext.val S_ext.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S_ext := ⟨z, (IntermediateField.mem_extendScalars hLE').mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L' S_ext _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E' := (IntermediateField.mem_extendScalars hLE').mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hSep_sub : ∀ (M E' : IntermediateField F (AlgebraicClosure F))
      (hLM : L ≤ M) (hME' : M ≤ E') (hE'K : E' ≤ K),
      Algebra.IsSeparable M (IntermediateField.extendScalars hME') := by
    intro M E' hLM hME' hE'K
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z := by
      have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) (hE'K hz)
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLM)) hzL
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  let S : IntermediateField L (AlgebraicClosure F) := separableClosure L (AlgebraicClosure F)
  haveI : IsGalois L S := separableClosure.isGalois L (AlgebraicClosure F)
  haveI : Normal L S := IsGalois.to_normal
  have hGal_stable : ∀ (N : IntermediateField F (AlgebraicClosure F)),
      IsGaloisExt F L N → ∀ σ ∈ L.fixingSubgroup, ∀ x ∈ N, σ x ∈ N := by
    intro N hGalN σ hσ x hx
    have hLN : L ≤ N := hGalN.1
    have hNS : ∀ z ∈ N, z ∈ S := by
      intro z hz
      exact (IntermediateField.mem_restrictScalars F).mp
        ((hSep_iff L N hLN).mp (hGalN.2.2.2 hLN) hz)
    let N_S : IntermediateField L S := (IntermediateField.extendScalars hLN).comap S.val
    have hmem_NS : ∀ y : S, y ∈ N_S ↔ (y : AlgebraicClosure F) ∈ N := by
      intro y
      exact IntermediateField.mem_extendScalars hLN
    let σ_L : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F :=
      (IntermediateField.fixingSubgroupEquiv L) ⟨σ, hσ⟩
    let y_x : S := ⟨x, hNS x hx⟩
    let y' : S := (AlgEquiv.restrictNormalHom S σ_L) y_x
    have hy'_val : (y' : AlgebraicClosure F) = σ x :=
      AlgEquiv.restrictNormalHom_apply S σ_L y_x
    rw [← hy'_val, ← hmem_NS y', ← InfiniteGalois.fixedField_fixingSubgroup N_S,
      IntermediateField.mem_fixedField_iff]
    intro g hg
    obtain ⟨τ_L, rfl⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) g
    let τ : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ_L
    have hτ_apply : ∀ z : AlgebraicClosure F, τ.1 z = τ_L z := fun _ => rfl
    have hτ_N : τ.1 ∈ N.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro z hz
      let y_z : S := ⟨z, hNS z hz⟩
      have hy_z : y_z ∈ N_S := (hmem_NS y_z).mpr hz
      have hgz : (AlgEquiv.restrictNormalHom S τ_L) y_z = y_z :=
        (IntermediateField.mem_fixingSubgroup_iff _ _).mp hg y_z hy_z
      have hgz_val : (((AlgEquiv.restrictNormalHom S τ_L) y_z : S) : AlgebraicClosure F) = z :=
        congrArg Subtype.val hgz
      rw [AlgEquiv.restrictNormalHom_apply] at hgz_val
      rw [hτ_apply]
      exact hgz_val
    have hconj : σ⁻¹ * τ.1 * σ ∈ N.fixingSubgroup :=
      hGalN.2.2.1 σ⁻¹ (Subgroup.inv_mem _ hσ) τ.1 hτ_N
    have hfix_x : (σ⁻¹ * τ.1 * σ) x = x :=
      (IntermediateField.mem_fixingSubgroup_iff _ _).mp hconj x hx
    have hτ_σx : τ_L (σ x) = σ x := by
      rw [← hτ_apply]
      calc τ.1 (σ x)
        _ = σ (σ⁻¹ (τ.1 (σ x))) := (σ.apply_symm_apply _).symm
        _ = σ ((σ⁻¹ * τ.1 * σ) x) := rfl
        _ = σ x := by rw [hfix_x]
    apply Subtype.ext
    rw [AlgEquiv.restrictNormalHom_apply, hy'_val, hτ_σx]
  intro K₁ hLK₁ hK₁K hGal₁ hlt₁ E hLE hEK₁
  rcases hMin.2.2.2.1 K₁ hLK₁ hK₁K hGal₁ with hK₁_MC | hK₁_sup
  · rw [hCand_MC E hLE (hEK₁.trans hK₁_MC)]
    exact hGalSub_eq K₁ M_C hLK₁ hLM_C hK₁_MC hGal₁ hMin.1 hlt₁ hMin.2.2.1 E hLE hEK₁
  · set M₀ : IntermediateField F (AlgebraicClosure F) := K₁ ⊓ M_C
    have hLM₀ : L ≤ M₀ := le_inf hLK₁ hLM_C
    have hM₀_K₁ : M₀ ≤ K₁ := inf_le_left
    have hM₀_MC : M₀ ≤ M_C := inf_le_right
    haveI : FiniteDimensional F K := hGal.2.1
    haveI : FiniteDimensional F L :=
      Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
        (IntermediateField.inclusion hLK).injective
    haveI : FiniteDimensional F M_C := hMin.1.2.1
    haveI : FiniteDimensional F M₀ :=
      Module.Finite.of_injective (IntermediateField.inclusion hM₀_MC).toLinearMap
        (IntermediateField.inclusion hM₀_MC).injective
    have hGalM₀ : IsGaloisExt F L M₀ := by
      refine ⟨hLM₀, inferInstance, ?_, ?_⟩
      · intro σ hσ τ hτ
        rw [IntermediateField.mem_fixingSubgroup_iff] at hτ ⊢
        intro z hz
        have hσ_inv : σ⁻¹ ∈ L.fixingSubgroup := Subgroup.inv_mem _ hσ
        have hz_K₁ : z ∈ K₁ := hM₀_K₁ hz
        have hz_MC : z ∈ M_C := hM₀_MC hz
        have h_inv_M₀ : σ⁻¹ z ∈ M₀ :=
          ⟨hGal_stable K₁ hGal₁ σ⁻¹ hσ_inv z hz_K₁,
           hGal_stable M_C hMin.1 σ⁻¹ hσ_inv z hz_MC⟩
        calc (σ * τ * σ⁻¹) z
          _ = σ (τ (σ⁻¹ z)) := rfl
          _ = σ (σ⁻¹ z) := by rw [hτ (σ⁻¹ z) h_inv_M₀]
          _ = z := σ.apply_symm_apply z
      · intro h
        exact hSep_sub L M₀ le_rfl h (hM₀_MC.trans hM_CK)
    have hlt_M₀ : Module.finrank L (IntermediateField.extendScalars hLM₀) <
        Module.finrank L (IntermediateField.extendScalars hLK) := by
      haveI : IsScalarTower F L (IntermediateField.extendScalars hLM₀) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower F L (IntermediateField.extendScalars hLM_C) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hmul0 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM₀) =
          Module.finrank F M₀ :=
        Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLM₀)
      have hmulC : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM_C) =
          Module.finrank F M_C :=
        Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLM_C)
      have hfin_le : Module.finrank F M₀ ≤ Module.finrank F M_C :=
        LinearMap.finrank_le_finrank_of_injective
          (f := (IntermediateField.inclusion hM₀_MC).toLinearMap)
          (IntermediateField.inclusion hM₀_MC).injective
      have hposL : 0 < Module.finrank F L := Module.finrank_pos
      have hle_L : Module.finrank L (IntermediateField.extendScalars hLM₀) ≤
          Module.finrank L (IntermediateField.extendScalars hLM_C) := by
        apply Nat.le_of_mul_le_mul_left _ hposL
        rw [hmul0, hmulC]
        exact hfin_le
      exact lt_of_le_of_lt hle_L hMin.2.2.1
    have hEK : E ≤ K := hEK₁.trans hK₁K
    set F' : IntermediateField F (AlgebraicClosure F) := E ⊓ M_C
    have hLF' : L ≤ F' := le_inf hLE hLM_C
    have hF'E : F' ≤ E := inf_le_left
    have hF'K : F' ≤ K := hF'E.trans hEK
    haveI : FiniteDimensional F E :=
      Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
        (IntermediateField.inclusion hEK).injective
    haveI : FiniteDimensional F F' :=
      Module.Finite.of_injective (IntermediateField.inclusion hF'K).toLinearMap
        (IntermediateField.inclusion hF'K).injective
    have hWeil1_L : IsWeilRep F L (charRep F L 1) :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => by ext; simp [charRep]⟩
    have hWeil1_E : IsWeilRep F E (charRep F E 1) :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => by ext; simp [charRep]⟩
    obtain ⟨D_M, hDM_decomp, hDM_MC, _, _, hDM_K₁_imp⟩ :=
      hMackey.1 E hLE hEK hF'E hF'K 1 1 hWeil1_L hWeil1_E (by ext; rfl)
    have hDM_K₁ : ∀ t ∈ D_M, t.field ≤ K₁ :=
      hDM_K₁_imp rfl rfl K₁ hLK₁ hK₁K hGal₁ hEK₁ hK₁_sup
    set D₀ : List (MonomialTerm F L) := D_M.map (MonomialTerm.restrict F hLF')
    have h_eval_cand :
        evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
          evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₀ :=
      hCand_decomp E hLE hEK hLF' hF'E D_M hDM_decomp hDM_MC
    have h_eval_MC_K₁ :
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₀ =
          evalMonomialList F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ D₀ := by
      unfold evalMonomialList
      congr 1
      apply List.map_congr_left
      intro t ht
      rcases List.mem_map.mp ht with ⟨s, hs, rfl⟩
      have hs_M₀ : s.field ≤ M₀ := le_inf (hDM_K₁ s hs) (hDM_MC s hs)
      have hs_L : L ≤ s.field := hLF'.trans s.le
      have h1 : galoisLam F rec L M_C ψ s.field = galoisLam F rec L M₀ ψ s.field :=
        hGalSub_eq M₀ M_C hLM₀ hLM_C hM₀_MC hGalM₀ hMin.1 hlt_M₀ hMin.2.2.1 s.field hs_L hs_M₀
      have h2 : galoisLam F rec L K₁ ψ s.field = galoisLam F rec L M₀ ψ s.field :=
        hGalSub_eq M₀ K₁ hLM₀ hLK₁ hM₀_K₁ hGalM₀ hGal₁ hlt_M₀ hlt₁ s.field hs_L hs_M₀
      simp only [evalMonomialTerm, MonomialTerm.restrict, h1, h2]
    have hSepLF' : Algebra.IsSeparable L (IntermediateField.extendScalars hLF') :=
      hSep_sub L F' le_rfl hLF' hF'K
    have hSepF'E : Algebra.IsSeparable F' (IntermediateField.extendScalars hF'E) :=
      hSep_sub F' E hLF' hF'E hEK
    let t_neg : MonomialTerm F F' := ⟨-1, E, hF'E, 1⟩
    have ht_neg_Wf : t_neg.Wf F F' :=
      ⟨inferInstance, hSepF'E, hWeil1_E⟩
    let σ₀ : Representation (Ω F) (relWeil F F') PUnit.{u+1} := 1
    have hσ₀ : IsWeilRep F F' σ₀ :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
    let D_zero : List (MonomialTerm F F') := t_neg :: D_M
    have hD_zero : IsMonomialDecomp F F'
        (fun w => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) D_zero := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | ht
        · exact ht_neg_Wf
        · exact hDM_decomp.1 t ht
      · intro w
        dsimp only
        have hw0 : σ₀ w = 0 := Subsingleton.elim (σ₀ w) 0
        rw [hw0, LinearMap.map_zero]
        simp only [D_zero, monomialListTrace, List.map_cons, List.sum_cons]
        have ht_tr : t_neg.trace F F' w =
            - (⟨1, E, hF'E, 1⟩ : MonomialTerm F F').trace F F' w := by
          simp [t_neg, MonomialTerm.trace]
        have hDM_tr : (⟨1, E, hF'E, 1⟩ : MonomialTerm F F').trace F F' w =
            (D_M.map fun t => t.trace F F' w).sum := hDM_decomp.2 w
        rw [ht_tr, hDM_tr]
        exact (neg_add_cancel _).symm
    have hD_res := ((ld_trace_exact_and_char F).2.2 L F' hLF' hSepLF' σ₀ hσ₀ D_zero hD_zero).1
    have hSubInd : Subsingleton
        (indSpace ((relWeil F F').subgroupOf (relWeil F L))
          (σ₀.comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLF')).toMonoidHom)) :=
      ⟨fun f g => Subtype.ext (funext fun x => Subsingleton.elim (f.1 x) (g.1 x))⟩
    have htr_res_zero : ∀ w : relWeil F L,
        LinearMap.trace (Ω F) _ (indLM F hLF' σ₀ w) = 0 := by
      intro w
      have hw : indLM F hLF' σ₀ w = 0 :=
        LinearMap.ext fun f => @Subsingleton.elim _ hSubInd _ _
      rw [hw, LinearMap.map_zero]
    have hD_res_zero : IsMonomialDecomp F L 0 (D_zero.map (MonomialTerm.restrict F hLF')) := by
      refine ⟨hD_res.1, fun w => ?_⟩
      rw [Pi.zero_apply, ← htr_res_zero w]
      exact hD_res.2 w
    have hD_res_K₁ : ∀ t ∈ D_zero.map (MonomialTerm.restrict F hLF'), t.field ≤ K₁ := by
      intro t ht
      rcases List.mem_map.mp ht with ⟨s, hs, rfl⟩
      rcases List.mem_cons.mp hs with rfl | hs
      · exact hEK₁
      · exact hDM_K₁ s hs
    have hLamK₁ : IsLambdaFuncOn F rec L K₁ ψ (galoisLam F rec L K₁ ψ) :=
      hTheory.1 L K₁ hLK₁ hGal₁ hlt₁ ψ hψ
    have hprod := hLamK₁.2 (D_zero.map (MonomialTerm.restrict F hLF')) hD_res_zero hD_res_K₁
    simp only [D_zero, List.map_cons, evalMonomialList, List.prod_cons] at hprod
    have h_term_neg :
        evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ
          (t_neg.restrict F hLF') =
        (evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ
          ⟨1, E, hLE, 1⟩)⁻¹ := by
      simp [t_neg, MonomialTerm.restrict, evalMonomialTerm]
    rw [h_term_neg] at hprod
    have h_eval_K₁ :
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ D₀ =
          evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ ⟨1, E, hLE, 1⟩ :=
      (inv_mul_eq_one.mp hprod).symm
    have h_eq_term :
        evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
          evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L K₁ ψ E') L ψ ⟨1, E, hLE, 1⟩ := by
      rw [h_eval_cand, h_eval_MC_K₁, h_eval_K₁]
    simp only [evalMonomialTerm, zpow_one] at h_eq_term
    exact mul_left_cancel h_eq_term

theorem ld_ch16_candLamFrom_conj_inv (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) :
    ∀ σ ∈ L.fixingSubgroup, ∀ E, L ≤ E → E ≤ K →
      candLamFrom F rec L M_C ψ (E.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) =
        candLamFrom F rec L M_C ψ E :=
by
  intro σ hσ E hLE hEK
  set E' : IntermediateField F (AlgebraicClosure F) :=
    E.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  have hLE' : L ≤ E' := by
    intro x hx
    exact ⟨x, hLE hx, hσ ⟨x, hx⟩⟩
  
  let G_L := relWeil F L
  let H_K := (relWeil F K).subgroupOf G_L
  let S_LK := IntermediateField.extendScalars hLK
  haveI : FiniteDimensional F K := hGal.2.1
  have hSepLK : Algebra.IsSeparable L S_LK := hGal.2.2.2 hLK
  haveI : Algebra.IsSeparable L S_LK := hSepLK
  let e_F : K ≃ₐ[F] S_LK :=
    { toFun := toExtendScalars F hLK
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLK).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F S_LK := Module.Finite.equiv e_F.toLinearEquiv
  haveI : IsScalarTower F L S_LK := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L S_LK := Module.Finite.of_restrictScalars_finite F L S_LK
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFinQ, hCardQ⟩ := ld_relWeil_quotient_card_eq_finrank F hp hFrob L K hLK hSepLK
  letI : Finite (G_L ⧸ H_K) := hFinQ
  letI : Fintype (G_L ⧸ H_K) := Fintype.ofFinite (G_L ⧸ H_K)
  letI : Fintype (S_LK →ₐ[L] AlgebraicClosure F) :=
    minpoly.AlgHom.fintype L S_LK (AlgebraicClosure F)
  let resMap : (G_L ⧸ H_K) → (S_LK →ₐ[L] AlgebraicClosure F) := fun u =>
    { toFun := fun x => ((cosetRep u : G_L) : AbsGal F) x.1
      map_one' := map_one ((cosetRep u : G_L) : AbsGal F)
      map_mul' := fun x y => map_mul ((cosetRep u : G_L) : AbsGal F) x.1 y.1
      map_zero' := map_zero ((cosetRep u : G_L) : AbsGal F)
      map_add' := fun x y => map_add ((cosetRep u : G_L) : AbsGal F) x.1 y.1
      commutes' := fun r => (cosetRep u).2.2 r }
  have hinj : Function.Injective resMap := by
    intro u₁ u₂ h_eq
    let g₁ : G_L := cosetRep u₁
    let g₂ : G_L := cosetRep u₂
    have h_mem : g₁⁻¹ * g₂ ∈ H_K := by
      rw [Subgroup.mem_subgroupOf]
      refine ⟨(g₁⁻¹ * g₂).2.1, ?_⟩
      intro y
      let y_K : S_LK := ⟨y.1, (IntermediateField.mem_extendScalars hLK).mpr y.2⟩
      have hy : (g₁ : AbsGal F) y.1 = (g₂ : AbsGal F) y.1 := AlgHom.congr_fun h_eq y_K
      change ((g₁ : AbsGal F)⁻¹ * (g₂ : AbsGal F)) y.1 = y.1
      rw [AlgEquiv.mul_apply, ← hy, ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
    have hq : (g₁ : G_L ⧸ H_K) = (g₂ : G_L ⧸ H_K) := QuotientGroup.eq.mpr h_mem
    have h1 : (g₁ : G_L ⧸ H_K) = u₁ := Quotient.out_eq u₁
    have h2 : (g₂ : G_L ⧸ H_K) = u₂ := Quotient.out_eq u₂
    rw [← h1, ← h2, hq]
  have hcard_eq : Fintype.card (G_L ⧸ H_K) = Fintype.card (S_LK →ₐ[L] AlgebraicClosure F) := by
    rw [← Nat.card_eq_fintype_card, hCardQ, ← AlgHom.card L S_LK (AlgebraicClosure F)]
  have hbij : Function.Bijective resMap :=
    (Fintype.bijective_iff_injective_and_card resMap).mpr ⟨hinj, hcard_eq⟩
  let ι_σ : S_LK →ₐ[L] AlgebraicClosure F :=
    { toFun := fun x => σ x.1
      map_one' := map_one σ
      map_mul' := fun x y => map_mul σ x.1 y.1
      map_zero' := map_zero σ
      map_add' := fun x y => map_add σ x.1 y.1
      commutes' := fun r => hσ r }
  obtain ⟨u₀, hu₀⟩ := hbij.2 ι_σ
  let g : G_L := cosetRep u₀
  have hgE : ∀ z ∈ E, (g : AbsGal F) z = σ z := by
    intro z hz
    let z_K : S_LK := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hEK hz)⟩
    exact AlgHom.congr_fun hu₀ z_K
  
  let H_E := (relWeil F E).subgroupOf G_L
  let H_E' := (relWeil F E').subgroupOf G_L
  have hConjH : ∀ x : G_L, x ∈ H_E' ↔ g⁻¹ * x * g ∈ H_E := by
    intro x
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf]
    constructor
    · intro hx
      refine ⟨(g⁻¹ * x * g).2.1, ?_⟩
      intro z
      have hσz : σ z.1 ∈ E' := ⟨z.1, z.2, rfl⟩
      have hxσ : (x : AbsGal F) (σ z.1) = σ z.1 := hx.2 ⟨σ z.1, hσz⟩
      rw [← hgE z.1 z.2] at hxσ
      change ((g : AbsGal F)⁻¹ * (x : AbsGal F) * (g : AbsGal F)) z.1 = z.1
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hxσ, ← AlgEquiv.mul_apply,
        inv_mul_cancel, AlgEquiv.one_apply]
    · intro hxg
      refine ⟨x.2.1, ?_⟩
      intro y
      rcases y.2 with ⟨z, hz, hσz⟩
      have hgz : ((g : AbsGal F)⁻¹ * (x : AbsGal F) * (g : AbsGal F)) z = z := hxg.2 ⟨z, hz⟩
      have hx_gz : (x : AbsGal F) ((g : AbsGal F) z) = (g : AbsGal F) z := by
        have h1 := congr_arg (g : AbsGal F) hgz
        rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, ← AlgEquiv.mul_apply (g : AbsGal F),
          mul_inv_cancel, AlgEquiv.one_apply] at h1
        exact h1
      change (x : AbsGal F) y.1 = y.1
      have hσz' : σ z = y.1 := hσz
      rw [← hσz', ← hgE z hz]
      exact hx_gz
  let ρ_E := (charRep F E 1).comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE)).toMonoidHom
  let ρ_E' := (charRep F E' 1).comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE')).toMonoidHom
  have hρE : ∀ (h : H_E) (v : ULift.{u} (Ω F)), ρ_E h v = v := by
    intro h v
    change ((1 : relWeil F E →* (Ω F)ˣ) _ : Ω F) • v = v
    simp
  have hρE' : ∀ (h' : H_E') (v : ULift.{u} (Ω F)), ρ_E' h' v = v := by
    intro h' v
    change ((1 : relWeil F E' →* (Ω F)ˣ) _ : Ω F) • v = v
    simp
  let Φ : indSpace H_E ρ_E ≃ₗ[Ω F] indSpace H_E' ρ_E' :=
    { toFun := fun φ =>
        ⟨fun x => φ.1 (g⁻¹ * x), fun h' x => by
          let h : H_E := ⟨g⁻¹ * (h' : G_L) * g, (hConjH (h' : G_L)).mp h'.2⟩
          have h_grp : g⁻¹ * ((h' : G_L) * x) = (h : G_L) * (g⁻¹ * x) := by
            change g⁻¹ * ((h' : G_L) * x) = (g⁻¹ * (h' : G_L) * g) * (g⁻¹ * x)
            group
          dsimp only
          rw [h_grp, φ.2 h (g⁻¹ * x), hρE h, hρE' h']⟩
      invFun := fun ψ₀ =>
        ⟨fun x => ψ₀.1 (g * x), fun h x => by
          have hh' : g * (h : G_L) * g⁻¹ ∈ H_E' := by
            rw [hConjH]
            have h_id : g⁻¹ * (g * (h : G_L) * g⁻¹) * g = (h : G_L) := by group
            rw [h_id]
            exact h.2
          let h' : H_E' := ⟨g * (h : G_L) * g⁻¹, hh'⟩
          have h_grp : g * ((h : G_L) * x) = (h' : G_L) * (g * x) := by
            change g * ((h : G_L) * x) = (g * (h : G_L) * g⁻¹) * (g * x)
            group
          dsimp only
          rw [h_grp, ψ₀.2 h' (g * x), hρE' h', hρE h]⟩
      left_inv := fun φ => Subtype.ext (funext fun x => by simp [mul_assoc])
      right_inv := fun ψ₀ => Subtype.ext (funext fun x => by simp [mul_assoc])
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have htr_eq : ∀ w : G_L,
      (⟨1, E', hLE', 1⟩ : MonomialTerm F L).trace F L w =
        (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w := by
    intro w
    have hConj_w : Φ.conj (indLM F hLE (charRep F E 1) w) = indLM F hLE' (charRep F E' 1) w := by
      apply LinearMap.ext
      intro ψ₀
      apply Subtype.ext
      funext x
      change ψ₀.1 (g * ((g⁻¹ * x) * w)) = ψ₀.1 (x * w)
      have h_assoc : g * ((g⁻¹ * x) * w) = x * w := by group
      rw [h_assoc]
    simp only [MonomialTerm.trace, one_smul]
    rw [← hConj_w]
    exact LinearMap.trace_conj' (indLM F hLE (charRep F E 1) w) Φ
  have hSub_eq : IsSubMonomialDecomp F L M_C E' hLE' = IsSubMonomialDecomp F L M_C E hLE := by
    funext D₀
    apply propext
    simp only [IsSubMonomialDecomp, IsMonomialDecomp, htr_eq]
  
  have hrec1 : ∀ M : IntermediateField F (AlgebraicClosure F), recChar F rec M 1 = 1 := by
    intro M
    unfold recChar
    have hex : ∃ χ' : Mˣ →* (Ω F)ˣ, ∀ x : Mˣ, χ' x = (1 : relWeil F M →* (Ω F)ˣ) (rec.recMap M x) :=
      ⟨1, fun _ => rfl⟩
    have hspec := Classical.epsilon_spec hex
    exact MonoidHom.ext fun x => hspec x
  have hcond1 : ∀ M : IntermediateField F (AlgebraicClosure F), condExp F M 1 = 0 := by
    intro M
    unfold condExp
    exact Nat.sInf_eq_zero.mpr (Or.inl fun _ _ => rfl)
  have htate1 : ∀ (M : IntermediateField F (AlgebraicClosure F)) (ψM : AddChar M (Ω F)),
      tateEps F M (recChar F rec M 1) ψM = (qL F M : Ω F) ^ condExpChar F M ψM := by
    intro M ψM
    unfold tateEps
    rw [hrec1 M, if_pos (hcond1 M), MonoidHom.one_apply, Units.val_one, mul_one]
  
  let ϕ : E ≃ₐ[F] E' := E.equivMap (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  have hrelVal : ∀ x : E, relVal F E' (ϕ x) = relVal F E x := by
    intro x
    unfold relVal
    rw [Algebra.norm_eq_of_algEquiv ϕ x]
  have hresDeg : resDeg F E' = resDeg F E := by
    unfold resDeg
    congr 1
    ext k
    simp only [Set.mem_setOf_eq]
    refine and_congr_right fun _ => ?_
    constructor
    · rintro ⟨y, hy0, hyval⟩
      refine ⟨ϕ.symm y, ?_, ?_⟩
      · intro h0
        apply hy0
        rw [← ϕ.apply_symm_apply y, h0, map_zero]
      · rw [← hrelVal (ϕ.symm y), ϕ.apply_symm_apply]
        exact hyval
    · rintro ⟨x, hx0, hxval⟩
      refine ⟨ϕ x, ?_, ?_⟩
      · intro h0
        apply hx0
        rw [← ϕ.symm_apply_apply x, h0, map_zero]
      · rw [hrelVal x]
        exact hxval
  have hqL : qL F E' = qL F E := by
    unfold qL
    rw [hresDeg]
  have hvalL : ∀ x : E, valL F E' (ϕ x) = valL F E x := by
    intro x
    unfold valL
    rw [hrelVal x, hresDeg]
  let ϕ_L : IntermediateField.extendScalars hLE ≃ₐ[L] IntermediateField.extendScalars hLE' :=
    { toFun := fun x =>
        ⟨(ϕ ⟨x.1, (IntermediateField.mem_extendScalars hLE).mp x.2⟩).1,
          (IntermediateField.mem_extendScalars hLE').mpr
            (ϕ ⟨x.1, (IntermediateField.mem_extendScalars hLE).mp x.2⟩).2⟩
      invFun := fun y =>
        ⟨(ϕ.symm ⟨y.1, (IntermediateField.mem_extendScalars hLE').mp y.2⟩).1,
          (IntermediateField.mem_extendScalars hLE).mpr
            (ϕ.symm ⟨y.1, (IntermediateField.mem_extendScalars hLE').mp y.2⟩).2⟩
      left_inv := fun x => Subtype.ext (congrArg Subtype.val (ϕ.symm_apply_apply ⟨x.1, _⟩))
      right_inv := fun y => Subtype.ext (congrArg Subtype.val (ϕ.apply_symm_apply ⟨y.1, _⟩))
      map_mul' := fun x y => Subtype.ext (congrArg Subtype.val (map_mul ϕ ⟨x.1, _⟩ ⟨y.1, _⟩))
      map_add' := fun x y => Subtype.ext (congrArg Subtype.val (map_add ϕ ⟨x.1, _⟩ ⟨y.1, _⟩))
      commutes' := fun r => Subtype.ext (by
        change ((ϕ ⟨r.1, hLE r.2⟩ : E') : AlgebraicClosure F) = r.1
        rw [IntermediateField.coe_equivMap_apply]
        exact hσ r) }
  have htraceLM : ∀ x : E, traceLM F hLE' (ϕ x) = traceLM F hLE x := by
    intro x
    change Algebra.trace L (IntermediateField.extendScalars hLE') (toExtendScalars F hLE' (ϕ x)) =
      Algebra.trace L (IntermediateField.extendScalars hLE) (toExtendScalars F hLE x)
    have h_app : toExtendScalars F hLE' (ϕ x) = ϕ_L (toExtendScalars F hLE x) := rfl
    rw [h_app, Algebra.trace_eq_of_algEquiv ϕ_L (toExtendScalars F hLE x)]
  have htraceChar : ∀ x : E, traceChar F hLE' ψ (ϕ x) = traceChar F hLE ψ x := by
    intro x
    change ψ (traceLM F hLE' (ϕ x)) = ψ (traceLM F hLE x)
    rw [htraceLM x]
  have hcondExpChar : condExpChar F E' (traceChar F hLE' ψ) = condExpChar F E (traceChar F hLE ψ) := by
    unfold condExpChar
    congr 1
    ext d
    simp only [Set.mem_setOf_eq]
    constructor
    · intro hd x hx
      rw [← htraceChar x]
      apply hd (ϕ x)
      rwa [hvalL x]
    · intro hd y hy
      have hy_eq : y = ϕ (ϕ.symm y) := (ϕ.apply_symm_apply y).symm
      rw [hy_eq, htraceChar (ϕ.symm y)]
      apply hd (ϕ.symm y)
      rw [← hvalL (ϕ.symm y), ← hy_eq]
      exact hy
  have htateEps_eq :
      tateEps F E' (recChar F rec E' 1) (traceChar F hLE' ψ) =
        tateEps F E (recChar F rec E 1) (traceChar F hLE ψ) := by
    rw [htate1 E', htate1 E, hqL, hcondExpChar]
  have hEps_eq :
      tateEpsUnit F E' (recChar F rec E' 1) (traceChar F hLE' ψ) =
        tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) := by
    unfold tateEpsUnit
    simp only [htateEps_eq]
  
  change candLamFrom F rec L M_C ψ E' = candLamFrom F rec L M_C ψ E
  unfold candLamFrom
  rw [dif_pos hLE', dif_pos hLE, hEps_eq, hSub_eq]

theorem ld_ch16_candLamFrom_tower_inter (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hMackey : HasMackeyDecompOn F rec L K M_C hLK hLM_C hM_CK ψ)
    (hCand_decomp : ∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K)
      (hLF' : L ≤ E ⊓ M_C) (hF'E : E ⊓ M_C ≤ E)
      (D_M : List (MonomialTerm F (E ⊓ M_C))),
      IsMonomialDecomp F (E ⊓ M_C)
        (fun w => (⟨1, E, hF'E, 1⟩ : MonomialTerm F (E ⊓ M_C)).trace F (E ⊓ M_C) w) D_M →
      (∀ t ∈ D_M, t.field ≤ M_C) →
      evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
          (D_M.map (MonomialTerm.restrict F hLF')))
    (hCand_MC : ∀ E, L ≤ E → E ≤ M_C → candLamFrom F rec L M_C ψ E = galoisLam F rec L M_C ψ E) :
    ∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E) (hEK : E ≤ K)
      (hLF' : L ≤ E ⊓ M_C) (hF'E : E ⊓ M_C ≤ E),
      L < E ⊓ M_C →
      candLamFrom F rec L M_C ψ E =
        galoisLam F rec (E ⊓ M_C) K (traceChar F hLF' ψ) E *
          (candLamFrom F rec L M_C ψ (E ⊓ M_C)) ^
            (Module.finrank ↥(E ⊓ M_C) (IntermediateField.extendScalars hF'E)) :=
by
  have hSep_iff : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)) (hLE' : L' ≤ E'),
      Algebra.IsSeparable L' (IntermediateField.extendScalars hLE') ↔
        E' ≤ IntermediateField.restrictScalars F (separableClosure L' (AlgebraicClosure F)) := by
    intro L' E' hLE'
    let S_ext := IntermediateField.extendScalars hLE'
    have hmin : ∀ x : S_ext, IsSeparable L' x.1 ↔ IsSeparable L' x := by
      intro x
      change (minpoly L' (S_ext.val x)).Separable ↔ (minpoly L' x).Separable
      rw [minpoly.algHom_eq S_ext.val S_ext.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S_ext := ⟨z, (IntermediateField.mem_extendScalars hLE').mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L' S_ext _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E' := (IntermediateField.mem_extendScalars hLE').mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hSep_sub : ∀ (M E' : IntermediateField F (AlgebraicClosure F))
      (hLM : L ≤ M) (hME' : M ≤ E') (hE'K : E' ≤ K),
      Algebra.IsSeparable M (IntermediateField.extendScalars hME') := by
    intro M E' hLM hME' hE'K
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z := by
      have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) (hE'K hz)
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLM)) hzL
  have hGal_sub : ∀ (M N : IntermediateField F (AlgebraicClosure F))
      (hLM : L ≤ M) (hMN : M ≤ N) (hNK : N ≤ K),
      IsGaloisExt F L N → IsGaloisExt F M N := by
    intro M N hLM hMN hNK hGalLN
    refine ⟨hMN, hGalLN.2.1, ?_, fun h => hSep_sub M N hLM h hNK⟩
    intro σ hσ τ hτ
    exact hGalLN.2.2.1 σ (IntermediateField.fixingSubgroup_le hLM hσ) τ hτ
  have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
      [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
      (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      [FiniteDimensional K₀ M₀] (z : E₀),
      @Algebra.trace L₀ E₀ _ _ algLE z =
        @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
    intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
    by_cases hFin : FiniteDimensional M₀ E₀
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
      simp [htr1, htr2]
  have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (h : A ≤ B) (y : B),
      @Algebra.trace A B _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
    intro A B h y
    letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm
  have htrace_trans : ∀ (A B C : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (h : A ≤ B) (h' : B ≤ C) (z : C),
      traceLM F (h.trans h') z = traceLM F h (traceLM F h' z) := by
    intro A B C _ h h' z
    rw [← htrace_eq_inclusion (h.trans h') z,
        ← htrace_eq_inclusion h' z,
        ← htrace_eq_inclusion h]
    exact htrace_trans_aux F A B C
      (IntermediateField.inclusion h).toAlgebra
      (IntermediateField.inclusion h').toAlgebra
      (IntermediateField.inclusion (h.trans h')).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z
  intro E hLE hEK
  set F' : IntermediateField F (AlgebraicClosure F) := E ⊓ M_C
  intro hLF' hF'E hlt
  have hF'M_C : F' ≤ M_C := inf_le_right
  have hF'K : F' ≤ K := hF'E.trans hEK
  have hGalF'K : IsGaloisExt F F' K := hGal_sub F' K hLF' hF'K le_rfl hGal
  have hGalF'MC : IsGaloisExt F F' M_C := hGal_sub F' M_C hLF' hF'M_C hM_CK hMin.1
  have hSepLF' : Algebra.IsSeparable L (IntermediateField.extendScalars hLF') :=
    hSep_sub L F' le_rfl hLF' hF'K
  have hSepF'E : Algebra.IsSeparable F' (IntermediateField.extendScalars hF'E) :=
    hSep_sub F' E hLF' hF'E hEK
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F M_C := hMin.1.2.1
  haveI : FiniteDimensional F E :=
    Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
      (IntermediateField.inclusion hEK).injective
  haveI : FiniteDimensional F F' :=
    Module.Finite.of_injective (IntermediateField.inclusion hF'K).toLinearMap
      (IntermediateField.inclusion hF'K).injective
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  have hfin_mul : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      Module.finrank F A * Module.finrank A (IntermediateField.extendScalars hAB) =
        Module.finrank F B := by
    intro A B _ _ hAB
    haveI : IsScalarTower F A (IntermediateField.extendScalars hAB) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.finrank_mul_finrank F A (IntermediateField.extendScalars hAB)
  have hmul_LF' : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLF') =
      Module.finrank F F' := hfin_mul L F' hLF'
  have hmul_F'K : Module.finrank F F' * Module.finrank F' (IntermediateField.extendScalars hF'K) =
      Module.finrank F K := hfin_mul F' K hF'K
  have hmul_LK : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) =
      Module.finrank F K := hfin_mul L K hLK
  have hmul_F'MC : Module.finrank F F' * Module.finrank F' (IntermediateField.extendScalars hF'M_C) =
      Module.finrank F M_C := hfin_mul F' M_C hF'M_C
  have hmul_LMC : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank F M_C := hfin_mul L M_C hLM_C
  have hposL : 0 < Module.finrank F L := Module.finrank_pos
  have hposK : 0 < Module.finrank F K := Module.finrank_pos
  have hgt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLF') := by
    by_contra hle1
    push_neg at hle1
    have hfin_le : Module.finrank F F' ≤ Module.finrank F L := by
      calc Module.finrank F F'
        _ = Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLF') :=
            hmul_LF'.symm
        _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hle1
        _ = Module.finrank F L := Nat.mul_one _
    have heq : L = F' := IntermediateField.eq_of_le_of_finrank_le hLF' hfin_le
    exact (ne_of_lt hlt) heq
  have hlt_F'K : Module.finrank F' (IntermediateField.extendScalars hF'K) <
      Module.finrank L (IntermediateField.extendScalars hLK) := by
    have hmul_eq : Module.finrank L (IntermediateField.extendScalars hLF') *
        Module.finrank F' (IntermediateField.extendScalars hF'K) =
        Module.finrank L (IntermediateField.extendScalars hLK) := by
      apply Nat.eq_of_mul_eq_mul_left hposL
      rw [← mul_assoc, hmul_LF', hmul_F'K, hmul_LK]
    have hpos_F'K : 0 < Module.finrank F' (IntermediateField.extendScalars hF'K) := by
      by_contra h0
      have hzero : Module.finrank F' (IntermediateField.extendScalars hF'K) = 0 := by omega
      rw [hzero, mul_zero] at hmul_F'K
      omega
    calc Module.finrank F' (IntermediateField.extendScalars hF'K)
      _ = 1 * Module.finrank F' (IntermediateField.extendScalars hF'K) := (one_mul _).symm
      _ < Module.finrank L (IntermediateField.extendScalars hLF') *
          Module.finrank F' (IntermediateField.extendScalars hF'K) :=
          Nat.mul_lt_mul_of_pos_right hgt1 hpos_F'K
      _ = Module.finrank L (IntermediateField.extendScalars hLK) := hmul_eq
  have hlt_F'MC : Module.finrank F' (IntermediateField.extendScalars hF'M_C) <
      Module.finrank L (IntermediateField.extendScalars hLK) := by
    have hmul_eq : Module.finrank L (IntermediateField.extendScalars hLF') *
        Module.finrank F' (IntermediateField.extendScalars hF'M_C) =
        Module.finrank L (IntermediateField.extendScalars hLM_C) := by
      apply Nat.eq_of_mul_eq_mul_left hposL
      rw [← mul_assoc, hmul_LF', hmul_F'MC, hmul_LMC]
    have hle_MC : Module.finrank F' (IntermediateField.extendScalars hF'M_C) ≤
        Module.finrank L (IntermediateField.extendScalars hLM_C) := by
      rw [← hmul_eq]
      exact Nat.le_mul_of_pos_left _ (by omega)
    exact lt_of_le_of_lt hle_MC hMin.2.2.1
  set ψF' : AddChar F' (Ω F) := traceChar F hLF' ψ
  have hψF' : IsAdmissibleChar F F' ψF' :=
    (hTheory.2.2 L F' F' M_C hLM_C hLF' le_rfl hF'M_C hMin.1 hGalF'MC hMin.2.2.1 ψ hψ).1
  have htraceChar_trans : ∀ (E' : IntermediateField F (AlgebraicClosure F)) (h' : F' ≤ E'),
      traceChar F (hLF'.trans h') ψ = traceChar F h' ψF' := by
    intro E' h'
    ext z
    simp [ψF', traceChar, htrace_trans L F' E' hLF' h' z]
  have hWeil1_L : IsWeilRep F L (charRep F L 1) :=
    ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => by ext; simp [charRep]⟩
  have hWeil1_E : IsWeilRep F E (charRep F E 1) :=
    ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => by ext; simp [charRep]⟩
  obtain ⟨D_M, hDM_decomp, hDM_MC, _, hDM_deg, _⟩ :=
    hMackey.1 E hLE hEK hF'E hF'K 1 1 hWeil1_L hWeil1_E (by ext; rfl)
  have h_cand_eval :
      evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
          (D_M.map (MonomialTerm.restrict F hLF')) :=
    hCand_decomp E hLE hEK hLF' hF'E D_M hDM_decomp hDM_MC
  have heval_restrict_MC : ∀ (L_F' : List (MonomialTerm F F')),
      (∀ t ∈ L_F', t.field ≤ M_C) →
      evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
        (L_F'.map (MonomialTerm.restrict F hLF')) =
      evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' M_C ψF' E') F' ψF' L_F' *
        (galoisLam F rec L M_C ψ F') ^ (monomialListDeg F F' L_F') := by
    intro L_F' hLeMC
    induction L_F' with
    | nil =>
      simp [evalMonomialList, monomialListDeg]
    | cons t tl ih =>
      have htMC : t.field ≤ M_C := hLeMC t List.mem_cons_self
      have htlMC : ∀ t' ∈ tl, t'.field ≤ M_C :=
        fun t' ht' => hLeMC t' (List.mem_cons_of_mem t ht')
      have hlam_eq : galoisLam F rec L M_C ψ t.field =
          galoisLam F rec F' M_C ψF' t.field *
            (galoisLam F rec L M_C ψ F') ^
              (Module.finrank F' (IntermediateField.extendScalars t.le)) :=
        (hTheory.2.2 L F' t.field M_C hLM_C hLF' t.le htMC hMin.1 hGalF'MC hMin.2.2.1 ψ hψ).2
      have htr_eq : traceChar F (hLF'.trans t.le) ψ = traceChar F t.le ψF' :=
        htraceChar_trans t.field t.le
      have hterm : evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
          (t.restrict F hLF') =
          evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' M_C ψF' E') F' ψF' t *
            (galoisLam F rec L M_C ψ F') ^ (t.deg F F') := by
        simp only [evalMonomialTerm, MonomialTerm.restrict, MonomialTerm.deg]
        rw [htr_eq, hlam_eq, ← mul_assoc, mul_zpow, ← zpow_natCast, ← zpow_mul,
          mul_comm (Module.finrank F' (IntermediateField.extendScalars t.le) : ℤ) t.coeff]
      simp only [evalMonomialList, monomialListDeg, List.map_cons, List.prod_cons, List.sum_cons] at ih ⊢
      rw [hterm, ih htlMC, zpow_add]
      ac_rfl
  have hLamF'K : IsLambdaFuncOn F rec F' K ψF' (galoisLam F rec F' K ψF') :=
    hTheory.1 F' K hF'K hGalF'K hlt_F'K ψF' hψF'
  have hLamF'K_MC : IsLambdaFuncOn F rec F' M_C ψF' (galoisLam F rec F' K ψF') :=
    ⟨hLamF'K.1, fun D hD hDMC => hLamF'K.2 D hD (fun t ht => (hDMC t ht).trans hM_CK)⟩
  have h_eval_MC_K :
      evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' M_C ψF' E') F' ψF' D_M =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF' D_M := by
    unfold evalMonomialList
    congr 1
    apply List.map_congr_left
    intro t ht
    have h_eq := (hTheory.2.1 F' M_C hF'M_C hGalF'MC hlt_F'MC ψF' hψF'
      (galoisLam F rec F' K ψF') hLamF'K_MC t.field t.le (hDM_MC t ht)).symm
    simp only [evalMonomialTerm, h_eq]
  let t_neg : MonomialTerm F F' := ⟨-1, E, hF'E, 1⟩
  have ht_neg_Wf : t_neg.Wf F F' := ⟨inferInstance, hSepF'E, hWeil1_E⟩
  let D_zero : List (MonomialTerm F F') := t_neg :: D_M
  have hD_zero : IsMonomialDecomp F F' 0 D_zero := by
    refine ⟨?_, ?_⟩
    · intro t ht
      rcases List.mem_cons.mp ht with rfl | ht
      · exact ht_neg_Wf
      · exact hDM_decomp.1 t ht
    · intro w
      rw [Pi.zero_apply]
      simp only [D_zero, monomialListTrace, List.map_cons, List.sum_cons]
      have ht_tr : t_neg.trace F F' w =
          - (⟨1, E, hF'E, 1⟩ : MonomialTerm F F').trace F F' w := by
        simp [t_neg, MonomialTerm.trace]
      have hDM_tr : (⟨1, E, hF'E, 1⟩ : MonomialTerm F F').trace F F' w =
          (D_M.map fun t => t.trace F F' w).sum := hDM_decomp.2 w
      rw [ht_tr, hDM_tr]
      exact (neg_add_cancel _).symm
  have hD_zero_K : ∀ t ∈ D_zero, t.field ≤ K := by
    intro t ht
    rcases List.mem_cons.mp ht with rfl | ht
    · exact hEK
    · exact (hDM_MC t ht).trans hM_CK
  have hprod := hLamF'K.2 D_zero hD_zero hD_zero_K
  simp only [D_zero, evalMonomialList, List.map_cons, List.prod_cons] at hprod
  have h_term_neg :
      evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF' t_neg =
        (evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF'
          ⟨1, E, hF'E, 1⟩)⁻¹ := by
    simp [t_neg, evalMonomialTerm]
  rw [h_term_neg] at hprod
  have h_eval_DM_K :
      evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF' D_M =
        evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF'
          ⟨1, E, hF'E, 1⟩ :=
    (inv_mul_eq_one.mp hprod).symm
  have h_combined :
      evalMonomialTerm F rec (fun _ E' _ => candLamFrom F rec L M_C ψ E') L ψ ⟨1, E, hLE, 1⟩ =
        evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF'
          ⟨1, E, hF'E, 1⟩ *
        (candLamFrom F rec L M_C ψ F') ^
          (Module.finrank F' (IntermediateField.extendScalars hF'E)) := by
    rw [h_cand_eval, heval_restrict_MC D_M hDM_MC, h_eval_MC_K, h_eval_DM_K,
      hDM_deg, zpow_natCast, ← hCand_MC F' hLF' hF'M_C]
  simp only [evalMonomialTerm, zpow_one] at h_combined
  have htr_E : traceChar F hF'E ψF' = traceChar F hLE ψ :=
    (htraceChar_trans E hF'E).symm
  rw [htr_E, mul_assoc] at h_combined
  exact mul_left_cancel h_combined

theorem ld_ch16_cand_norm_sub_and_conj (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hMackey : HasMackeyDecompOn F rec L K M_C hLK hLM_C hM_CK ψ) :
    IsCandNormSubAndConj F rec L K M_C hLK ψ (candLamFrom F rec L M_C ψ) :=
by
  obtain ⟨hCand_decomp, hNorm, hCand_MC⟩ :=
    ld_ch16_candLamFrom_spec_and_sub_MC F rec L K M_C hLK hLM_C hM_CK hGal ψ hψ hTheory hMin
  have hNormSub :=
    ld_ch16_candLamFrom_normal_subfields F rec L K M_C hLK hLM_C hM_CK hGal ψ hψ hTheory hMin
      hMackey hCand_decomp hCand_MC
  have hConj :=
    ld_ch16_candLamFrom_conj_inv F rec L K M_C hLK hGal ψ
  have hTower :=
    ld_ch16_candLamFrom_tower_inter F rec L K M_C hLK hLM_C hM_CK hGal ψ hψ hTheory hMin
      hMackey hCand_decomp hCand_MC
  exact ⟨hNorm, hCand_MC, hNormSub, hConj, hTower⟩

theorem ld_ch19_1_term_to_MC_decomp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hMackey : HasMackeyDecompOn F rec L K M_C hLK hLM_C hM_CK ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_eq : f = candLamFrom F rec L M_C ψ)
    (hSub : IsCandNormSubAndConj F rec L K M_C hLK ψ f)
    (χL : relWeil F L →* (Ω F)ˣ) (hχL : IsWeilRep F L (charRep F L χL))
    (t : MonomialTerm F L) (htWf : t.Wf F L) (htK : t.field ≤ K)
    (hrest : restrictWeilChar F htK t.χ = restrictWeilChar F hLK χL) :
    ∃ D_t : List (MonomialTerm F L),
      IsMonomialDecomp F L (fun w => t.trace F L w) D_t ∧
      (∀ s ∈ D_t, s.field ≤ M_C) ∧
      evalMonomialTerm F rec (fun _ E' _ => f E') L ψ t =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D_t :=
by
  have htrace_scale : ∀ (c : ℤ) (L₀ : List (MonomialTerm F L)) (w : relWeil F L),
      monomialListTrace F L (L₀.map (scaleMonomialTerm F L c)) w =
        c • monomialListTrace F L L₀ w := by
    intro c L₀ w
    induction L₀ with
    | nil => simp [monomialListTrace]
    | cons s tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have hs : (scaleMonomialTerm F L c s).trace F L w = c • (s.trace F L w) := by
        simp [scaleMonomialTerm, MonomialTerm.trace, mul_smul]
      rw [hs, ih, smul_add]
  have heval_scale : ∀ (lam : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)), AddChar L' (Ω F) → (Ω F)ˣ)
      (c : ℤ) (L₀ : List (MonomialTerm F L)),
      evalMonomialList F rec lam L ψ (L₀.map (scaleMonomialTerm F L c)) =
        (evalMonomialList F rec lam L ψ L₀) ^ c := by
    intro lam c L₀
    induction L₀ with
    | nil => simp [evalMonomialList]
    | cons s tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have hs : evalMonomialTerm F rec lam L ψ (scaleMonomialTerm F L c s) =
          (evalMonomialTerm F rec lam L ψ s) ^ c := by
        simp only [evalMonomialTerm, scaleMonomialTerm]
        rw [mul_comm c s.coeff, zpow_mul]
      rw [hs, ih, ← mul_zpow]
  have hSep_iff : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)) (hLE' : L' ≤ E'),
      Algebra.IsSeparable L' (IntermediateField.extendScalars hLE') ↔
        E' ≤ IntermediateField.restrictScalars F (separableClosure L' (AlgebraicClosure F)) := by
    intro L' E' hLE'
    let S_ext := IntermediateField.extendScalars hLE'
    have hmin : ∀ x : S_ext, IsSeparable L' x.1 ↔ IsSeparable L' x := by
      intro x
      change (minpoly L' (S_ext.val x)).Separable ↔ (minpoly L' x).Separable
      rw [minpoly.algHom_eq S_ext.val S_ext.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S_ext := ⟨z, (IntermediateField.mem_extendScalars hLE').mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L' S_ext _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E' := (IntermediateField.mem_extendScalars hLE').mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hSep_sub : ∀ (M E' : IntermediateField F (AlgebraicClosure F))
      (hLM : L ≤ M) (hME' : M ≤ E') (hE'K : E' ≤ K),
      Algebra.IsSeparable M (IntermediateField.extendScalars hME') := by
    intro M E' hLM hME' hE'K
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z := by
      have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) (hE'K hz)
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLM)) hzL
  have hGal_sub : ∀ (M N : IntermediateField F (AlgebraicClosure F))
      (hLM : L ≤ M) (hMN : M ≤ N) (hNK : N ≤ K),
      IsGaloisExt F L N → IsGaloisExt F M N := by
    intro M N hLM hMN hNK hGalLN
    refine ⟨hMN, hGalLN.2.1, ?_, fun h => hSep_sub M N hLM h hNK⟩
    intro σ hσ τ hτ
    exact hGalLN.2.2.1 σ (IntermediateField.fixingSubgroup_le hLM hσ) τ hτ
  have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
      [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
      (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      [FiniteDimensional K₀ M₀] (z : E₀),
      @Algebra.trace L₀ E₀ _ _ algLE z =
        @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
    intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
    by_cases hFin : FiniteDimensional M₀ E₀
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
      simp [htr1, htr2]
  have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (h : A ≤ B) (y : B),
      @Algebra.trace A B _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
    intro A B h y
    letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm
  have htrace_trans : ∀ (A B C : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (h : A ≤ B) (h' : B ≤ C) (z : C),
      traceLM F (h.trans h') z = traceLM F h (traceLM F h' z) := by
    intro A B C _ h h' z
    rw [← htrace_eq_inclusion (h.trans h') z,
        ← htrace_eq_inclusion h' z,
        ← htrace_eq_inclusion h]
    exact htrace_trans_aux F A B C
      (IntermediateField.inclusion h).toAlgebra
      (IntermediateField.inclusion h').toAlgebra
      (IntermediateField.inclusion (h.trans h')).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z
  have hfin_mul : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      Module.finrank F A * Module.finrank A (IntermediateField.extendScalars hAB) =
        Module.finrank F B := by
    intro A B _ _ hAB
    haveI : IsScalarTower F A (IntermediateField.extendScalars hAB) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.finrank_mul_finrank F A (IntermediateField.extendScalars hAB)
  let E : IntermediateField F (AlgebraicClosure F) := t.field
  let hLE : L ≤ E := t.le
  let χE : relWeil F E →* (Ω F)ˣ := t.χ
  let t₁ : MonomialTerm F L := ⟨1, E, hLE, χE⟩
  have ht₁Wf : t₁.Wf F L := htWf
  have hUnit : ∃ D₁ : List (MonomialTerm F L),
      IsMonomialDecomp F L (fun w => t₁.trace F L w) D₁ ∧
      (∀ s ∈ D₁, s.field ≤ M_C) ∧
      evalMonomialTerm F rec (fun _ E' _ => f E') L ψ t₁ =
        evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₁ := by
    by_cases hEM_C : E ≤ M_C
    · refine ⟨[t₁], ⟨?_, ?_⟩, ?_, ?_⟩
      · intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact ht₁Wf
      · intro w
        simp [monomialListTrace]
      · intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact hEM_C
      · have hfE : f E = galoisLam F rec L M_C ψ E := hSub.2.1 E hLE hEM_C
        simp [t₁, evalMonomialList, evalMonomialTerm, hfE]
    · by_cases hlt : L < E ⊓ M_C
      · set F' : IntermediateField F (AlgebraicClosure F) := E ⊓ M_C
        have hLF' : L ≤ F' := le_inf hLE hLM_C
        have hF'E : F' ≤ E := inf_le_left
        have hF'M_C : F' ≤ M_C := inf_le_right
        have hF'K : F' ≤ K := hF'E.trans htK
        have hGalF'K : IsGaloisExt F F' K := hGal_sub F' K hLF' hF'K le_rfl hGal
        have hGalF'MC : IsGaloisExt F F' M_C := hGal_sub F' M_C hLF' hF'M_C hM_CK hMin.1
        have hSepLF' : Algebra.IsSeparable L (IntermediateField.extendScalars hLF') :=
          hSep_sub L F' le_rfl hLF' hF'K
        have hSepF'E : Algebra.IsSeparable F' (IntermediateField.extendScalars hF'E) :=
          hSep_sub F' E hLF' hF'E htK
        haveI : FiniteDimensional F K := hGal.2.1
        haveI : FiniteDimensional F M_C := hMin.1.2.1
        haveI : FiniteDimensional F E := htWf.1
        haveI : FiniteDimensional F F' :=
          Module.Finite.of_injective (IntermediateField.inclusion hF'K).toLinearMap
            (IntermediateField.inclusion hF'K).injective
        haveI : FiniteDimensional F L :=
          Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
            (IntermediateField.inclusion hLK).injective
        have hmul_LF' : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLF') =
            Module.finrank F F' := hfin_mul L F' hLF'
        have hmul_F'K : Module.finrank F F' * Module.finrank F' (IntermediateField.extendScalars hF'K) =
            Module.finrank F K := hfin_mul F' K hF'K
        have hmul_LK : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) =
            Module.finrank F K := hfin_mul L K hLK
        have hmul_F'MC : Module.finrank F F' * Module.finrank F' (IntermediateField.extendScalars hF'M_C) =
            Module.finrank F M_C := hfin_mul F' M_C hF'M_C
        have hmul_LMC : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM_C) =
            Module.finrank F M_C := hfin_mul L M_C hLM_C
        have hposL : 0 < Module.finrank F L := Module.finrank_pos
        have hposK : 0 < Module.finrank F K := Module.finrank_pos
        have hgt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLF') := by
          by_contra hle1
          push_neg at hle1
          have hfin_le : Module.finrank F F' ≤ Module.finrank F L := by
            calc Module.finrank F F'
              _ = Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLF') :=
                  hmul_LF'.symm
              _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hle1
              _ = Module.finrank F L := Nat.mul_one _
          have heq : L = F' := IntermediateField.eq_of_le_of_finrank_le hLF' hfin_le
          exact (ne_of_lt hlt) heq
        have hlt_F'K : Module.finrank F' (IntermediateField.extendScalars hF'K) <
            Module.finrank L (IntermediateField.extendScalars hLK) := by
          have hmul_eq : Module.finrank L (IntermediateField.extendScalars hLF') *
              Module.finrank F' (IntermediateField.extendScalars hF'K) =
              Module.finrank L (IntermediateField.extendScalars hLK) := by
            apply Nat.eq_of_mul_eq_mul_left hposL
            rw [← mul_assoc, hmul_LF', hmul_F'K, hmul_LK]
          have hpos_F'K : 0 < Module.finrank F' (IntermediateField.extendScalars hF'K) := by
            by_contra h0
            have hzero : Module.finrank F' (IntermediateField.extendScalars hF'K) = 0 := by omega
            rw [hzero, mul_zero] at hmul_F'K
            omega
          calc Module.finrank F' (IntermediateField.extendScalars hF'K)
            _ = 1 * Module.finrank F' (IntermediateField.extendScalars hF'K) := (one_mul _).symm
            _ < Module.finrank L (IntermediateField.extendScalars hLF') *
                Module.finrank F' (IntermediateField.extendScalars hF'K) :=
                Nat.mul_lt_mul_of_pos_right hgt1 hpos_F'K
            _ = Module.finrank L (IntermediateField.extendScalars hLK) := hmul_eq
        have hlt_F'MC : Module.finrank F' (IntermediateField.extendScalars hF'M_C) <
            Module.finrank L (IntermediateField.extendScalars hLK) := by
          have hmul_eq : Module.finrank L (IntermediateField.extendScalars hLF') *
              Module.finrank F' (IntermediateField.extendScalars hF'M_C) =
              Module.finrank L (IntermediateField.extendScalars hLM_C) := by
            apply Nat.eq_of_mul_eq_mul_left hposL
            rw [← mul_assoc, hmul_LF', hmul_F'MC, hmul_LMC]
          have hle_MC : Module.finrank F' (IntermediateField.extendScalars hF'M_C) ≤
              Module.finrank L (IntermediateField.extendScalars hLM_C) := by
            rw [← hmul_eq]
            exact Nat.le_mul_of_pos_left _ (by omega)
          exact lt_of_le_of_lt hle_MC hMin.2.2.1
        set ψF' : AddChar F' (Ω F) := traceChar F hLF' ψ
        have hψF' : IsAdmissibleChar F F' ψF' :=
          (hTheory.2.2 L F' F' M_C hLM_C hLF' le_rfl hF'M_C hMin.1 hGalF'MC hMin.2.2.1 ψ hψ).1
        have htraceChar_trans : ∀ (E' : IntermediateField F (AlgebraicClosure F)) (h' : F' ≤ E'),
            traceChar F (hLF'.trans h') ψ = traceChar F h' ψF' := by
          intro E' h'
          ext z
          simp [ψF', traceChar, htrace_trans L F' E' hLF' h' z]
        obtain ⟨D_M, hDM_decomp, hDM_MC, _, hDM_deg, _⟩ :=
          hMackey.1 E hLE htK hF'E hF'K χL χE hχL htWf.2.2 hrest
        let t_neg : MonomialTerm F F' := ⟨-1, E, hF'E, χE⟩
        have ht_neg_Wf : t_neg.Wf F F' := ⟨htWf.1, hSepF'E, htWf.2.2⟩
        let σ₀ : Representation (Ω F) (relWeil F F') PUnit.{u+1} := 1
        have hσ₀ : IsWeilRep F F' σ₀ :=
          ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
        let D_zero : List (MonomialTerm F F') := t_neg :: D_M
        have hD_zero_σ₀ : IsMonomialDecomp F F'
            (fun w => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) D_zero := by
          refine ⟨?_, ?_⟩
          · intro s hs
            rcases List.mem_cons.mp hs with rfl | hs
            · exact ht_neg_Wf
            · exact hDM_decomp.1 s hs
          · intro w
            dsimp only
            have hw0 : σ₀ w = 0 := Subsingleton.elim (σ₀ w) 0
            rw [hw0, LinearMap.map_zero]
            change 0 = t_neg.trace F F' w + monomialListTrace F F' D_M w
            have ht_tr : t_neg.trace F F' w =
                - (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w := by
              simp [t_neg, MonomialTerm.trace]
            have hDM_w : (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w =
                monomialListTrace F F' D_M w := hDM_decomp.2 w
            rw [ht_tr, hDM_w]
            exact (neg_add_cancel _).symm
        have hD_res := ((ld_trace_exact_and_char F).2.2 L F' hLF' hSepLF' σ₀ hσ₀ D_zero hD_zero_σ₀).1
        have hSubInd : Subsingleton
            (indSpace ((relWeil F F').subgroupOf (relWeil F L))
              (σ₀.comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLF')).toMonoidHom)) :=
          ⟨fun φ₁ φ₂ => Subtype.ext (funext fun x => Subsingleton.elim (φ₁.1 x) (φ₂.1 x))⟩
        have htr_res_zero : ∀ w : relWeil F L,
            LinearMap.trace (Ω F) _ (indLM F hLF' σ₀ w) = 0 := by
          intro w
          have hw : indLM F hLF' σ₀ w = 0 :=
            LinearMap.ext fun φ => @Subsingleton.elim _ hSubInd _ _
          rw [hw, LinearMap.map_zero]
        set D₁ := D_M.map (MonomialTerm.restrict F hLF')
        have hD₁_decomp : IsMonomialDecomp F L (fun w => t₁.trace F L w) D₁ := by
          refine ⟨?_, ?_⟩
          · intro s hs
            exact hD_res.1 s (List.mem_cons_of_mem _ hs)
          · intro w
            have htr := hD_res.2 w
            dsimp only at htr ⊢
            rw [htr_res_zero w] at htr
            change 0 = (⟨-1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w +
              monomialListTrace F L D₁ w at htr
            have ht_neg_L : (⟨-1, E, hLE, χE⟩ : MonomialTerm F L).trace F L w =
                - t₁.trace F L w := by
              simp [t₁, MonomialTerm.trace]
            rw [ht_neg_L] at htr
            exact neg_add_eq_zero.mp htr.symm
        have hD₁_MC : ∀ s ∈ D₁, s.field ≤ M_C := by
          intro s hs
          rcases List.mem_map.mp hs with ⟨s₀, hs₀, rfl⟩
          exact hDM_MC s₀ hs₀
        have heval_restrict_MC : ∀ (L_F' : List (MonomialTerm F F')),
            (∀ s ∈ L_F', s.field ≤ M_C) →
            evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
              (L_F'.map (MonomialTerm.restrict F hLF')) =
            evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' M_C ψF' E') F' ψF' L_F' *
              (galoisLam F rec L M_C ψ F') ^ (monomialListDeg F F' L_F') := by
          intro L_F' hLeMC
          induction L_F' with
          | nil =>
            simp [evalMonomialList, monomialListDeg]
          | cons s tl ih =>
            have hsMC : s.field ≤ M_C := hLeMC s List.mem_cons_self
            have htlMC : ∀ s' ∈ tl, s'.field ≤ M_C :=
              fun s' hs' => hLeMC s' (List.mem_cons_of_mem s hs')
            have hlam_eq : galoisLam F rec L M_C ψ s.field =
                galoisLam F rec F' M_C ψF' s.field *
                  (galoisLam F rec L M_C ψ F') ^
                    (Module.finrank F' (IntermediateField.extendScalars s.le)) :=
              (hTheory.2.2 L F' s.field M_C hLM_C hLF' s.le hsMC hMin.1 hGalF'MC hMin.2.2.1 ψ hψ).2
            have htr_eq : traceChar F (hLF'.trans s.le) ψ = traceChar F s.le ψF' :=
              htraceChar_trans s.field s.le
            have hterm : evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ
                (s.restrict F hLF') =
                evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' M_C ψF' E') F' ψF' s *
                  (galoisLam F rec L M_C ψ F') ^ (s.deg F F') := by
              simp only [evalMonomialTerm, MonomialTerm.restrict, MonomialTerm.deg]
              rw [htr_eq, hlam_eq, ← mul_assoc, mul_zpow, ← zpow_natCast, ← zpow_mul,
                mul_comm (Module.finrank F' (IntermediateField.extendScalars s.le) : ℤ) s.coeff]
            simp only [evalMonomialList, monomialListDeg, List.map_cons, List.prod_cons, List.sum_cons] at ih ⊢
            rw [hterm, ih htlMC, zpow_add]
            ac_rfl
        have hLamF'K : IsLambdaFuncOn F rec F' K ψF' (galoisLam F rec F' K ψF') :=
          hTheory.1 F' K hF'K hGalF'K hlt_F'K ψF' hψF'
        have hLamF'K_MC : IsLambdaFuncOn F rec F' M_C ψF' (galoisLam F rec F' K ψF') :=
          ⟨hLamF'K.1, fun D hD hDMC => hLamF'K.2 D hD (fun s hs => (hDMC s hs).trans hM_CK)⟩
        have h_eval_MC_K :
            evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' M_C ψF' E') F' ψF' D_M =
              evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF' D_M := by
          unfold evalMonomialList
          congr 1
          apply List.map_congr_left
          intro s hs
          have h_eq := (hTheory.2.1 F' M_C hF'M_C hGalF'MC hlt_F'MC ψF' hψF'
            (galoisLam F rec F' K ψF') hLamF'K_MC s.field s.le (hDM_MC s hs)).symm
          simp only [evalMonomialTerm, h_eq]
        have hD_zero : IsMonomialDecomp F F' 0 D_zero := by
          refine ⟨hD_zero_σ₀.1, fun w => ?_⟩
          rw [Pi.zero_apply]
          have htr := hD_zero_σ₀.2 w
          dsimp only at htr
          have hw0 : σ₀ w = 0 := Subsingleton.elim (σ₀ w) 0
          rw [hw0, LinearMap.map_zero] at htr
          exact htr
        have hD_zero_K : ∀ s ∈ D_zero, s.field ≤ K := by
          intro s hs
          rcases List.mem_cons.mp hs with rfl | hs
          · exact htK
          · exact (hDM_MC s hs).trans hM_CK
        have hprod := hLamF'K.2 D_zero hD_zero hD_zero_K
        simp only [D_zero, evalMonomialList, List.map_cons, List.prod_cons] at hprod
        have h_term_neg :
            evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF' t_neg =
              (evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF'
                ⟨1, E, hF'E, χE⟩)⁻¹ := by
          simp [t_neg, evalMonomialTerm]
        rw [h_term_neg] at hprod
        have h_eval_DM_K :
            evalMonomialList F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF' D_M =
              evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF'
                ⟨1, E, hF'E, χE⟩ :=
          (inv_mul_eq_one.mp hprod).symm
        have hf_E : f E = galoisLam F rec F' K ψF' E *
            (f F') ^ (Module.finrank F' (IntermediateField.extendScalars hF'E)) :=
          hSub.2.2.2.2 E hLE htK hLF' hF'E hlt
        have hf_F' : f F' = galoisLam F rec L M_C ψ F' :=
          hSub.2.1 F' hLF' hF'M_C
        have htr_E : traceChar F hLE ψ = traceChar F hF'E ψF' :=
          htraceChar_trans E hF'E
        have hDM_deg' : monomialListDeg F F' D_M =
            (Module.finrank F' (IntermediateField.extendScalars hF'E) : ℤ) :=
          hDM_deg
        refine ⟨D₁, hD₁_decomp, hD₁_MC, ?_⟩
        calc evalMonomialTerm F rec (fun _ E' _ => f E') L ψ t₁
          _ = tateEpsUnit F E (recChar F rec E χE) (traceChar F hF'E ψF') *
                (galoisLam F rec F' K ψF' E *
                  (galoisLam F rec L M_C ψ F') ^
                    (Module.finrank F' (IntermediateField.extendScalars hF'E))) := by
              simp only [t₁, evalMonomialTerm, zpow_one, htr_E, hf_E, hf_F']
          _ = evalMonomialTerm F rec (fun _ E' _ => galoisLam F rec F' K ψF' E') F' ψF'
                ⟨1, E, hF'E, χE⟩ *
              (galoisLam F rec L M_C ψ F') ^ (monomialListDeg F F' D_M) := by
              simp only [evalMonomialTerm, zpow_one, hDM_deg', zpow_natCast, mul_assoc]
          _ = evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D₁ := by
              rw [← h_eval_DM_K, ← h_eval_MC_K, ← heval_restrict_MC D_M hDM_MC]
      · have hSup : E ⊔ M_C = K := by
          rcases hMin.2.2.2.2 E hLE htK with h1 | h2 | h3
          · exact False.elim (hEM_C h1)
          · exact False.elim (hlt h2)
          · exact h3
        have hInf : E ⊓ M_C = L := (eq_of_le_of_not_lt (le_inf hLE hLM_C) hlt).symm
        obtain ⟨D₁, hD₁_decomp, hD₁_MC, _, hD₁_eval⟩ :=
          hMackey.2 E hLE htK hInf hSup χL χE hχL htWf.2.2 hrest
        refine ⟨D₁, hD₁_decomp, hD₁_MC, ?_⟩
        rw [hf_eq]
        exact hD₁_eval
  obtain ⟨D₁, hD₁_decomp, hD₁_MC, hD₁_eval⟩ := hUnit
  refine ⟨D₁.map (scaleMonomialTerm F L t.coeff), ⟨?_, ?_⟩, ?_, ?_⟩
  · intro s hs
    rcases List.mem_map.mp hs with ⟨s₁, hs₁, rfl⟩
    exact hD₁_decomp.1 s₁ hs₁
  · intro w
    dsimp only
    rw [htrace_scale, ← hD₁_decomp.2 w]
    simp [t₁, E, χE, MonomialTerm.trace]
  · intro s hs
    rcases List.mem_map.mp hs with ⟨s₁, hs₁, rfl⟩
    exact hD₁_MC s₁ hs₁
  · have ht_eval : evalMonomialTerm F rec (fun _ E' _ => f E') L ψ t =
        (evalMonomialTerm F rec (fun _ E' _ => f E') L ψ t₁) ^ t.coeff := by
      simp [t₁, E, χE, evalMonomialTerm]
    rw [ht_eval, hD₁_eval, heval_scale]

theorem ld_weak_lambda_base_shift (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L M K : IntermediateField F (AlgebraicClosure F))
    (h₁ : L ≤ M) (hMK : M ≤ K) (hGal : IsGaloisExt F L K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_hom1 : ∀ D_L : List (MonomialTerm F L),
      IsHomogeneousDecompOn F L K 1 D_L →
      evalMonomialList F rec (fun _ E _ => f E) L ψ D_L = 1) :
    IsAdmissibleChar F M (traceChar F h₁ ψ) ∧
    shiftLamFunc F M f M = 1 ∧
    ∀ D_M : List (MonomialTerm F M),
      IsHomogeneousDecompOn F M K 1 D_M →
      evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) D_M = 1 :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F M :=
    Module.Finite.of_injective (IntermediateField.inclusion hMK).toLinearMap
      (IntermediateField.inclusion hMK).injective
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion h₁).toLinearMap
      (IntermediateField.inclusion h₁).injective
  have hSep₁ : Algebra.IsSeparable L (IntermediateField.extendScalars h₁) := by
    letI algMK : Algebra (IntermediateField.extendScalars h₁)
        (IntermediateField.extendScalars (h₁.trans hMK)) :=
      inferInstanceAs (Algebra M (IntermediateField.extendScalars hMK))
    letI : SMul (IntermediateField.extendScalars h₁)
        (IntermediateField.extendScalars (h₁.trans hMK)) :=
      algMK.toSMul
    haveI : IsScalarTower L (IntermediateField.extendScalars h₁)
        (IntermediateField.extendScalars (h₁.trans hMK)) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.IsSeparable L (IntermediateField.extendScalars (h₁.trans hMK)) :=
      hGal.2.2.2 (h₁.trans hMK)
    exact Algebra.isSeparable_tower_bot_of_isSeparable L
      (IntermediateField.extendScalars h₁)
      (IntermediateField.extendScalars (h₁.trans hMK))
  have hψM : IsAdmissibleChar F M (traceChar F h₁ ψ) :=
    ld_traceChar_admissible F L M h₁ hSep₁ ψ hψ
  refine ⟨hψM, ?_, ?_⟩
  · unfold shiftLamFunc
    rw [dif_pos (le_rfl : M ≤ M)]
    haveI : IsScalarTower F M (IntermediateField.extendScalars (le_rfl : M ≤ M)) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hmul : Module.finrank F M *
        Module.finrank M (IntermediateField.extendScalars (le_rfl : M ≤ M)) =
        Module.finrank F M :=
      Module.finrank_mul_finrank F M (IntermediateField.extendScalars (le_rfl : M ≤ M))
    have hposM : 0 < Module.finrank F M := Module.finrank_pos
    have hfin1 : Module.finrank M (IntermediateField.extendScalars (le_rfl : M ≤ M)) = 1 :=
      Nat.eq_of_mul_eq_mul_left hposM (hmul.trans (mul_one _).symm)
    rw [hfin1, pow_one, mul_inv_cancel]
  · intro D hD_hom
    obtain ⟨hD, hDK_rest⟩ := hD_hom
    have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
        [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
        (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
        (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
        (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
          @algebraMap L₀ E₀ _ _ algLE x)
        [FiniteDimensional K₀ M₀] (z : E₀),
        @Algebra.trace L₀ E₀ _ _ algLE z =
          @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
      intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
      letI : Algebra L₀ M₀ := algLM
      letI : Algebra M₀ E₀ := algME
      letI : Algebra L₀ E₀ := algLE
      haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
      haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
      haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
      by_cases hFin : FiniteDimensional M₀ E₀
      · exact (Algebra.trace_trace z).symm
      · have htr1 : Algebra.trace M₀ E₀ = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          exact hFin (Module.Finite.of_basis b)
        have htr2 : Algebra.trace L₀ E₀ = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
          exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
        simp [htr1, htr2]
    have htrace_eq_inclusion : ∀ {L' M' : IntermediateField F (AlgebraicClosure F)}
        (h : L' ≤ M') (y : M'),
        @Algebra.trace L' M' _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
      intro L' M' h y
      letI : Algebra L' M' := (IntermediateField.inclusion h).toAlgebra
      let e : M' ≃ₐ[L'] IntermediateField.extendScalars h := {
        toFun := toExtendScalars F h
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl
      }
      exact (Algebra.trace_eq_of_algEquiv e y).symm
    have htraceChar_trans : ∀ (E : IntermediateField F (AlgebraicClosure F)) (h' : M ≤ E),
        traceChar F (h₁.trans h') ψ = traceChar F h' (traceChar F h₁ ψ) := by
      intro E h'
      ext z
      simp only [traceChar, AddChar.compAddMonoidHom_apply, AddMonoidHom.comp_apply]
      congr 1
      rw [← htrace_eq_inclusion (h₁.trans h') z,
          ← htrace_eq_inclusion h' z,
          ← htrace_eq_inclusion h₁]
      exact htrace_trans_aux F L M E
        (IntermediateField.inclusion h₁).toAlgebra
        (IntermediateField.inclusion h').toAlgebra
        (IntermediateField.inclusion (h₁.trans h')).toAlgebra
        (fun _ => rfl)
        (fun _ => rfl)
        z
    have heval_shift : ∀ (L_M : List (MonomialTerm F M)),
        evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) L_M *
          (f M) ^ (monomialListDeg F M L_M) =
        evalMonomialList F rec (fun _ E _ => f E) L ψ (L_M.map (MonomialTerm.restrict F h₁)) := by
      intro L_M
      induction L_M with
      | nil =>
        simp [evalMonomialList, monomialListDeg]
      | cons t tl ih =>
        have hterm : evalMonomialTerm F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) t *
            (f M) ^ (t.deg F M) =
          evalMonomialTerm F rec (fun _ E _ => f E) L ψ (t.restrict F h₁) := by
          simp only [evalMonomialTerm, MonomialTerm.restrict, MonomialTerm.deg]
          unfold shiftLamFunc
          rw [dif_pos t.le, ← htraceChar_trans t.field t.le]
          set A := tateEpsUnit F t.field (recChar F rec t.field t.χ) (traceChar F (h₁.trans t.le) ψ)
          set d := Module.finrank M (IntermediateField.extendScalars t.le)
          rw [← mul_assoc, mul_zpow, inv_zpow, ← zpow_natCast (f M) d, ← zpow_mul,
            mul_comm (d : ℤ) t.coeff, mul_assoc, inv_mul_cancel, mul_one]
        simp only [evalMonomialList, monomialListDeg, List.map_cons, List.prod_cons, List.sum_cons] at ih ⊢
        rw [zpow_add, ← ih]
        calc (evalMonomialTerm F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) t *
              evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) tl) *
              ((f M) ^ (t.deg F M) * (f M) ^ (monomialListDeg F M tl))
          _ = (evalMonomialTerm F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) t *
                (f M) ^ (t.deg F M)) *
              (evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) tl *
                (f M) ^ (monomialListDeg F M tl)) := by ac_rfl
          _ = evalMonomialTerm F rec (fun _ E _ => f E) L ψ (t.restrict F h₁) *
              (evalMonomialList F rec (fun _ E _ => shiftLamFunc F M f E) M (traceChar F h₁ ψ) tl *
                (f M) ^ (monomialListDeg F M tl)) := by rw [hterm]
    let σ₀ : Representation (Ω F) (relWeil F M) PUnit.{u+1} := 1
    have hσ₀ : IsWeilRep F M σ₀ :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
    have htr₀ : (fun w : relWeil F M => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) = 0 := by
      ext w
      have hw : σ₀ w = 0 := Subsingleton.elim _ _
      rw [hw, map_zero, Pi.zero_apply]
    have hD₀ : IsMonomialDecomp F M (fun w => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) D := by
      rw [htr₀]
      exact hD
    have hDeg : monomialListDeg F M D = 0 := by
      rw [ld_monomial_deg_eq_finrank F M σ₀ hσ₀ D hD₀, Module.finrank_zero_of_subsingleton,
        Nat.cast_zero]
    have hD_L : IsMonomialDecomp F L 0 (D.map (MonomialTerm.restrict F h₁)) := by
      refine ⟨?_, ?_⟩
      · intro t ht
        rw [List.mem_map] at ht
        rcases ht with ⟨t₀, ht₀, rfl⟩
        obtain ⟨hFin, hSepM, hWeil⟩ := hD.1 t₀ ht₀
        refine ⟨hFin, ?_, hWeil⟩
        letI algME : Algebra (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) :=
          inferInstanceAs (Algebra M (IntermediateField.extendScalars t₀.le))
        letI : SMul (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) :=
          algME.toSMul
        haveI : IsScalarTower L (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) :=
          IsScalarTower.of_algebraMap_eq fun _ => rfl
        haveI : Algebra.IsSeparable L (IntermediateField.extendScalars h₁) := hSep₁
        haveI : Algebra.IsSeparable (IntermediateField.extendScalars h₁)
            (IntermediateField.extendScalars (h₁.trans t₀.le)) := hSepM
        exact Algebra.IsSeparable.trans L (IntermediateField.extendScalars h₁)
          (IntermediateField.extendScalars (h₁.trans t₀.le))
      · intro w
        rw [Pi.zero_apply, ← ld_indLM_trace_decomp F L M h₁ hSep₁ σ₀ hσ₀ D hD₀ w]
        let tr := LinearMap.trace (Ω F)
          (indSpace ((relWeil F M).subgroupOf (relWeil F L))
            (σ₀.comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F h₁)).toMonoidHom))
        have hw : indLM F h₁ σ₀ w + indLM F h₁ σ₀ w = indLM F h₁ σ₀ w :=
          LinearMap.ext fun _ => Subtype.ext (funext fun _ => Subsingleton.elim _ _)
        have h0 : tr (indLM F h₁ σ₀ w + indLM F h₁ σ₀ w) =
            tr (indLM F h₁ σ₀ w) + tr (indLM F h₁ σ₀ w) :=
          tr.map_add' (indLM F h₁ σ₀ w) (indLM F h₁ σ₀ w)
        rw [hw] at h0
        calc (0 : Ω F) = tr (indLM F h₁ σ₀ w) - tr (indLM F h₁ σ₀ w) := (sub_self _).symm
          _ = (tr (indLM F h₁ σ₀ w) + tr (indLM F h₁ σ₀ w)) - tr (indLM F h₁ σ₀ w) :=
            congrArg (· - tr (indLM F h₁ σ₀ w)) h0
          _ = tr (indLM F h₁ σ₀ w) := add_sub_cancel_right _ _
    have hHom_L : IsHomogeneousDecompOn F L K 1 (D.map (MonomialTerm.restrict F h₁)) := by
      refine ⟨hD_L, ?_⟩
      intro t ht
      rw [List.mem_map] at ht
      rcases ht with ⟨t₀, ht₀, rfl⟩
      exact hDK_rest t₀ ht₀
    have hEq := heval_shift D
    rw [hDeg, zpow_zero, mul_one, hf_hom1 _ hHom_L] at hEq
    exact hEq

theorem ld_weak_lambda_uniqueness (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (M K : IntermediateField F (AlgebraicClosure F)) (hMK : M ≤ K)
    (hGal : IsGaloisExt F M K) (ψM : AddChar M (Ω F)) (hψM : IsAdmissibleChar F M ψM)
    (g₁ g₂ : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hg₁_norm : g₁ M = 1)
    (hg₁_hom : ∀ D : List (MonomialTerm F M),
      IsHomogeneousDecompOn F M K 1 D →
      evalMonomialList F rec (fun _ E _ => g₁ E) M ψM D = 1)
    (hg₂_norm : g₂ M = 1)
    (hg₂_hom : ∀ D : List (MonomialTerm F M),
      IsHomogeneousDecompOn F M K 1 D →
      evalMonomialList F rec (fun _ E _ => g₂ E) M ψM D = 1)
    (E : IntermediateField F (AlgebraicClosure F)) (hME : M ≤ E) (hEK : E ≤ K) :
    g₁ E = g₂ E :=
by
  have hSep_iff : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)) (hLE' : L' ≤ E'),
      Algebra.IsSeparable L' (IntermediateField.extendScalars hLE') ↔
        E' ≤ IntermediateField.restrictScalars F (separableClosure L' (AlgebraicClosure F)) := by
    intro L' E' hLE'
    let S := IntermediateField.extendScalars hLE'
    have hmin : ∀ x : S, IsSeparable L' x.1 ↔ IsSeparable L' x := by
      intro x
      change (minpoly L' (S.val x)).Separable ↔ (minpoly L' x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hLE').mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L' S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E' := (IntermediateField.mem_extendScalars hLE').mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hSep_sub : ∀ (M' K' A B : IntermediateField F (AlgebraicClosure F))
      (hMK' : M' ≤ K'), IsGaloisExt F M' K' →
      ∀ (hMA : M' ≤ A) (hAB : A ≤ B), B ≤ K' →
        Algebra.IsSeparable A (IntermediateField.extendScalars hAB) := by
    intro M' K' A B hMK' hGal' hMA hAB hBK'
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzM' : IsSeparable M' z := by
      have hK_sep := (hSep_iff M' K' hMK').mp (hGal'.2.2.2 hMK') (hBK' hz)
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hMA)) hzM'
  have hDeg1 : ∀ (M' K' : IntermediateField F (AlgebraicClosure F)) (hMK' : M' ≤ K'),
      IsGaloisExt F M' K' →
      Module.finrank M' (IntermediateField.extendScalars hMK') ≤ 1 → K' ≤ M' := by
    intro M' K' hMK' hGal' hle
    haveI : FiniteDimensional F K' := hGal'.2.1
    haveI : FiniteDimensional F (IntermediateField.extendScalars hMK') :=
      show FiniteDimensional F K' from inferInstance
    have hmul := Module.finrank_mul_finrank F M' (IntermediateField.extendScalars hMK')
    have hEqK : Module.finrank F (IntermediateField.extendScalars hMK') = Module.finrank F K' := rfl
    rw [hEqK] at hmul
    have hle_F : Module.finrank F K' ≤ Module.finrank F M' := by
      calc Module.finrank F K' = Module.finrank F M' *
            Module.finrank M' (IntermediateField.extendScalars hMK') := hmul.symm
        _ ≤ Module.finrank F M' * 1 := Nat.mul_le_mul_left _ hle
        _ = Module.finrank F M' := Nat.mul_one _
    have hEq := IntermediateField.eq_of_le_of_finrank_le hMK' hle_F
    exact hEq.symm.le
  have htrace_neg : ∀ (L' : IntermediateField F (AlgebraicClosure F))
      (D : List (MonomialTerm F L')) (w : relWeil F L'),
      monomialListTrace F L' (D.map (MonomialTerm.neg F L')) w =
        - monomialListTrace F L' D w := by
    intro L' D w
    induction D with
    | nil => simp [monomialListTrace]
    | cons t tl ih =>
      simp only [monomialListTrace, List.map_cons, List.sum_cons] at ih ⊢
      have ht : (t.neg F L').trace F L' w = - (t.trace F L' w) := by
        simp [MonomialTerm.neg, MonomialTerm.trace, neg_smul]
      rw [ht, ih]
      ring
  have heval_neg : ∀ (L' : IntermediateField F (AlgebraicClosure F))
      (lam : ∀ (L₀ E₀ : IntermediateField F (AlgebraicClosure F)), AddChar L₀ (Ω F) → (Ω F)ˣ)
      (ψ' : AddChar L' (Ω F)) (D : List (MonomialTerm F L')),
      evalMonomialList F rec lam L' ψ' (D.map (MonomialTerm.neg F L')) =
        (evalMonomialList F rec lam L' ψ' D)⁻¹ := by
    intro L' lam ψ' D
    induction D with
    | nil => simp [evalMonomialList]
    | cons t tl ih =>
      simp only [evalMonomialList, List.map_cons, List.prod_cons] at ih ⊢
      have ht : evalMonomialTerm F rec lam L' ψ' (t.neg F L') =
          (evalMonomialTerm F rec lam L' ψ' t)⁻¹ := by
        simp [MonomialTerm.neg, evalMonomialTerm, zpow_neg]
      rw [ht, ih, mul_inv]
  have heval_congr : ∀ (L' : IntermediateField F (AlgebraicClosure F))
      (lam₁ lam₂ : ∀ (L₀ E₀ : IntermediateField F (AlgebraicClosure F)), AddChar L₀ (Ω F) → (Ω F)ˣ)
      (ψ' : AddChar L' (Ω F)) (D : List (MonomialTerm F L')),
      (∀ t ∈ D, lam₁ L' t.field ψ' = lam₂ L' t.field ψ') →
      evalMonomialList F rec lam₁ L' ψ' D = evalMonomialList F rec lam₂ L' ψ' D := by
    intro L' lam₁ lam₂ ψ' D hEq
    unfold evalMonomialList
    congr 1
    apply List.map_congr_left
    intro t ht
    simp only [evalMonomialTerm, hEq t ht]
  have hUnique : ∀ (m : ℕ) (M' K' : IntermediateField F (AlgebraicClosure F)) (hMK' : M' ≤ K'),
      IsGaloisExt F M' K' →
      Module.finrank M' (IntermediateField.extendScalars hMK') = m →
      ∀ (ψM' : AddChar M' (Ω F)), IsAdmissibleChar F M' ψM' →
      ∀ (g₁' g₂' : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ),
        g₁' M' = 1 →
        (∀ D : List (MonomialTerm F M'),
          IsHomogeneousDecompOn F M' K' 1 D →
          evalMonomialList F rec (fun _ E₀ _ => g₁' E₀) M' ψM' D = 1) →
        g₂' M' = 1 →
        (∀ D : List (MonomialTerm F M'),
          IsHomogeneousDecompOn F M' K' 1 D →
          evalMonomialList F rec (fun _ E₀ _ => g₂' E₀) M' ψM' D = 1) →
        ∀ (E' : IntermediateField F (AlgebraicClosure F)), M' ≤ E' → E' ≤ K' →
          g₁' E' = g₂' E' := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro M' K' hMK' hGal' hdeg ψM' hψM' g₁' g₂' hg₁'_norm hg₁'_hom hg₂'_norm hg₂'_hom E' hME' hEK'
    by_cases hm : 1 < Module.finrank M' (IntermediateField.extendScalars hMK')
    · obtain ⟨M_C, hMM_C, hM_CK, hMin⟩ :=
        (ld_minimal_abelian_normal_subfield_and_base F rec M' K' hMK' hGal' ψM' hψM').2 hm
      have hHom_MC_to_K : ∀ D : List (MonomialTerm F M'),
          IsHomogeneousDecompOn F M' M_C 1 D → IsHomogeneousDecompOn F M' K' 1 D := by
        intro D hD
        refine ⟨hD.1, fun t ht => ?_⟩
        obtain ⟨htMC, ht_rest⟩ := hD.2 t ht
        refine ⟨htMC.trans hM_CK, MonoidHom.ext fun w => ?_⟩
        exact DFunLike.congr_fun ht_rest (Subgroup.inclusion (relWeil_antitone F hM_CK) w)
      have hEqMC : ∀ E₀, M' ≤ E₀ → E₀ ≤ M_C → g₁' E₀ = g₂' E₀ :=
        ih _ (hdeg ▸ hMin.2.2.1) M' M_C hMM_C hMin.1 rfl ψM' hψM' g₁' g₂'
          hg₁'_norm (fun D hD => hg₁'_hom D (hHom_MC_to_K D hD))
          hg₂'_norm (fun D hD => hg₂'_hom D (hHom_MC_to_K D hD))
      set F' : IntermediateField F (AlgebraicClosure F) := E' ⊓ M_C
      have hMF' : M' ≤ F' := le_inf hME' hMM_C
      have hF'E' : F' ≤ E' := inf_le_left
      have hF'M_C : F' ≤ M_C := inf_le_right
      have hF'K' : F' ≤ K' := hF'E'.trans hEK'
      haveI : FiniteDimensional F K' := hGal'.2.1
      haveI : FiniteDimensional F E' :=
        Module.Finite.of_injective (IntermediateField.inclusion hEK').toLinearMap
          (IntermediateField.inclusion hEK').injective
      haveI : FiniteDimensional F F' :=
        Module.Finite.of_injective (IntermediateField.inclusion hF'K').toLinearMap
          (IntermediateField.inclusion hF'K').injective
      have hWeilM' : IsWeilRep F M' (charRep F M' 1) :=
        ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => by ext; simp [charRep]⟩
      have hWeilE' : IsWeilRep F E' (charRep F E' 1) :=
        ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => by ext; simp [charRep]⟩
      have h_rest1 : restrictWeilChar F hEK' (1 : relWeil F E' →* (Ω F)ˣ) =
          restrictWeilChar F hMK' (1 : relWeil F M' →* (Ω F)ˣ) := by
        ext; simp [restrictWeilChar]
      obtain ⟨D_M, hDM_decomp, hDM_MC, hDM_rest, _, _⟩ :=
        ld_ch15_mackey_orbit_decomp F M' K' M_C E' F' hMK' hMM_C hM_CK hME' hEK'
          hMF' hF'E' hF'M_C le_rfl hGal' hMin 1 1 hWeilM' hWeilE' h_rest1
      have hSepMF' : Algebra.IsSeparable M' (IntermediateField.extendScalars hMF') :=
        hSep_sub M' K' M' F' hMK' hGal' le_rfl hMF' hF'K'
      have hSepF'E' : Algebra.IsSeparable F' (IntermediateField.extendScalars hF'E') :=
        hSep_sub M' K' F' E' hMK' hGal' hMF' hF'E' hEK'
      let t_E_F' : MonomialTerm F F' := ⟨1, E', hF'E', 1⟩
      have ht_E_F'_Wf : t_E_F'.Wf F F' := ⟨inferInstance, hSepF'E', hWeilE'⟩
      let σ₀ : Representation (Ω F) (relWeil F F') PUnit.{u+1} := 1
      have hσ₀ : IsWeilRep F F' σ₀ :=
        ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
      let D_zero : List (MonomialTerm F F') := t_E_F' :: D_M.map (MonomialTerm.neg F F')
      have hD_zero : IsMonomialDecomp F F'
          (fun w => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) D_zero := by
        refine ⟨?_, ?_⟩
        · intro t ht
          rcases List.mem_cons.mp ht with rfl | ht
          · exact ht_E_F'_Wf
          · rcases List.mem_map.mp ht with ⟨s, hs, rfl⟩
            exact hDM_decomp.1 s hs
        · intro w
          dsimp only
          have hw0 : σ₀ w = 0 := Subsingleton.elim (σ₀ w) 0
          rw [hw0, LinearMap.map_zero]
          change 0 = t_E_F'.trace F F' w +
            monomialListTrace F F' (D_M.map (MonomialTerm.neg F F')) w
          rw [htrace_neg F' D_M w, ← hDM_decomp.2 w]
          exact (add_neg_cancel _).symm
      set D₀ : List (MonomialTerm F M') := D_M.map (MonomialTerm.restrict F hMF')
      let t_E_M' : MonomialTerm F M' := ⟨1, E', hME', 1⟩
      let D_tot : List (MonomialTerm F M') := t_E_M' :: D₀.map (MonomialTerm.neg F M')
      have hD_tot_eq : D_zero.map (MonomialTerm.restrict F hMF') = D_tot := by
        simp [D_zero, D₀, D_tot, t_E_F', t_E_M', List.map_map, Function.comp_def,
          MonomialTerm.restrict, MonomialTerm.neg]
      have hSubInd : Subsingleton
          (indSpace ((relWeil F F').subgroupOf (relWeil F M'))
            (σ₀.comp (Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hMF')).toMonoidHom)) :=
        ⟨fun f₁ f₂ => Subtype.ext (funext fun x => Subsingleton.elim (f₁.1 x) (f₂.1 x))⟩
      have hD_tot_hom : IsHomogeneousDecompOn F M' K' 1 D_tot := by
        refine ⟨⟨?_, ?_⟩, ?_⟩
        · intro t ht
          rcases List.mem_cons.mp ht with rfl | ht
          · exact ⟨inferInstance, hSep_sub M' K' M' E' hMK' hGal' le_rfl hME' hEK', hWeilE'⟩
          · rcases List.mem_map.mp ht with ⟨t₀, ht₀, rfl⟩
            rcases List.mem_map.mp ht₀ with ⟨s, hs, rfl⟩
            have hsWf := hDM_decomp.1 s hs
            exact ⟨hsWf.1,
              hSep_sub M' K' M' s.field hMK' hGal' le_rfl (hMF'.trans s.le)
                ((hDM_MC s hs).trans hM_CK),
              hsWf.2.2⟩
        · intro w
          have htr := ld_indLM_trace_decomp F M' F' hMF' hSepMF' σ₀ hσ₀ D_zero hD_zero w
          have hw : indLM F hMF' σ₀ w = 0 :=
            LinearMap.ext fun f => @Subsingleton.elim _ hSubInd _ _
          rw [hw, LinearMap.map_zero, hD_tot_eq] at htr
          exact htr
        · intro t ht
          rcases List.mem_cons.mp ht with rfl | ht
          · refine ⟨hEK', ?_⟩
            ext; simp [t_E_M', restrictWeilChar]
          · rcases List.mem_map.mp ht with ⟨t₀, ht₀, rfl⟩
            rcases List.mem_map.mp ht₀ with ⟨s, hs, rfl⟩
            obtain ⟨hsK, hs_rest⟩ := hDM_rest s hs
            refine ⟨hsK, ?_⟩
            change restrictWeilChar F hsK s.χ = 1
            rw [hs_rest]
            ext; simp [restrictWeilChar]
      have h1 := hg₁'_hom D_tot hD_tot_hom
      have h2 := hg₂'_hom D_tot hD_tot_hom
      simp only [D_tot, evalMonomialList, List.map_cons, List.prod_cons] at h1 h2
      change evalMonomialTerm F rec (fun _ E₀ _ => g₁' E₀) M' ψM' t_E_M' *
        evalMonomialList F rec (fun _ E₀ _ => g₁' E₀) M' ψM' (D₀.map (MonomialTerm.neg F M')) = 1 at h1
      change evalMonomialTerm F rec (fun _ E₀ _ => g₂' E₀) M' ψM' t_E_M' *
        evalMonomialList F rec (fun _ E₀ _ => g₂' E₀) M' ψM' (D₀.map (MonomialTerm.neg F M')) = 1 at h2
      rw [heval_neg] at h1 h2
      have hD₀_eq : evalMonomialList F rec (fun _ E₀ _ => g₁' E₀) M' ψM' D₀ =
          evalMonomialList F rec (fun _ E₀ _ => g₂' E₀) M' ψM' D₀ := by
        apply heval_congr
        intro t₀ ht₀
        rcases List.mem_map.mp ht₀ with ⟨s, hs, rfl⟩
        exact hEqMC s.field (hMF'.trans s.le) (hDM_MC s hs)
      have hTerm_eq : evalMonomialTerm F rec (fun _ E₀ _ => g₁' E₀) M' ψM' t_E_M' =
          evalMonomialTerm F rec (fun _ E₀ _ => g₂' E₀) M' ψM' t_E_M' := by
        rw [mul_inv_eq_one.mp h1, hD₀_eq, ← mul_inv_eq_one.mp h2]
      simp only [t_E_M', evalMonomialTerm, zpow_one] at hTerm_eq
      exact mul_left_cancel hTerm_eq
    · have hKM' : K' ≤ M' := hDeg1 M' K' hMK' hGal' (not_lt.mp hm)
      have hEM' : E' = M' := le_antisymm (hEK'.trans hKM') hME'
      rw [hEM', hg₁'_norm, hg₂'_norm]
  exact hUnique _ M K hMK hGal rfl ψM hψM g₁ g₂ hg₁_norm hg₁_hom hg₂_norm hg₂_hom E hME hEK

theorem ld_ch19_1_and_16_3_tower_trans (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hMackey : HasMackeyDecompOn F rec L K M_C hLK hLM_C hM_CK ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_eq : f = candLamFrom F rec L M_C ψ)
    (hSub : IsCandNormSubAndConj F rec L K M_C hLK ψ f) :
    (∀ (M E : IntermediateField F (AlgebraicClosure F)) (h₁ : L ≤ M) (h₂ : M ≤ E) (hMK : M ≤ K),
      E ≤ K →
      Algebra.IsSeparable L (IntermediateField.extendScalars h₁) →
      Algebra.IsSeparable M (IntermediateField.extendScalars h₂) →
      Module.finrank M (IntermediateField.extendScalars hMK) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      f E =
        galoisLam F rec M K (traceChar F h₁ ψ) E *
          (f M) ^ (Module.finrank M (IntermediateField.extendScalars h₂))) ∧
    (∀ (χK : relWeil F K →* (Ω F)ˣ),
      (∃ χL : relWeil F L →* (Ω F)ˣ,
        IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK) →
      ∀ (D : List (MonomialTerm F L)),
        IsHomogeneousDecompOn F L K χK D →
        evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1) :=
by
  have hHomog : ∀ (χK : relWeil F K →* (Ω F)ˣ),
      (∃ χL : relWeil F L →* (Ω F)ˣ,
        IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK) →
      ∀ (D : List (MonomialTerm F L)),
        IsHomogeneousDecompOn F L K χK D →
        evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1 := by
    intro χK ⟨χL, hχL, hrestK⟩ D hD
    have hList : ∀ (L₀ : List (MonomialTerm F L)),
        (∀ t ∈ L₀, t.Wf F L) →
        (∀ t ∈ L₀, ∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = χK) →
        ∃ D_MC : List (MonomialTerm F L),
          IsMonomialDecomp F L (fun w => monomialListTrace F L L₀ w) D_MC ∧
          (∀ s ∈ D_MC, s.field ≤ M_C) ∧
          evalMonomialList F rec (fun _ E' _ => f E') L ψ L₀ =
            evalMonomialList F rec (fun _ E' _ => galoisLam F rec L M_C ψ E') L ψ D_MC := by
      intro L₀
      induction L₀ with
      | nil =>
        intro _ _
        refine ⟨[], ⟨by simp, fun w => rfl⟩, by simp, by simp [evalMonomialList]⟩
      | cons t tl ih =>
        intro hWf hRest
        have htWf : t.Wf F L := hWf t List.mem_cons_self
        obtain ⟨htK, ht_rest⟩ := hRest t List.mem_cons_self
        have ht_restL : restrictWeilChar F htK t.χ = restrictWeilChar F hLK χL :=
          ht_rest.trans hrestK.symm
        obtain ⟨D_t, hDt_decomp, hDt_MC, hDt_eval⟩ :=
          ld_ch19_1_term_to_MC_decomp F rec L K M_C hLK hLM_C hM_CK hGal ψ hψ hTheory hMin hMackey
            f hf_eq hSub χL hχL t htWf htK ht_restL
        obtain ⟨D_tl, hDtl_decomp, hDtl_MC, hDtl_eval⟩ :=
          ih (fun s hs => hWf s (List.mem_cons_of_mem _ hs))
             (fun s hs => hRest s (List.mem_cons_of_mem _ hs))
        refine ⟨D_t ++ D_tl, ⟨?_, ?_⟩, ?_, ?_⟩
        · intro s hs
          rw [List.mem_append] at hs
          rcases hs with hs | hs
          · exact hDt_decomp.1 s hs
          · exact hDtl_decomp.1 s hs
        · intro w
          have h1 := hDt_decomp.2 w
          have h2 := hDtl_decomp.2 w
          simp only [monomialListTrace, List.map_cons, List.sum_cons, List.map_append, List.sum_append] at h1 h2 ⊢
          rw [h1, h2]
        · intro s hs
          rw [List.mem_append] at hs
          rcases hs with hs | hs
          · exact hDt_MC s hs
          · exact hDtl_MC s hs
        · simp only [evalMonomialList, List.map_cons, List.prod_cons, List.map_append, List.prod_append] at hDt_eval hDtl_eval ⊢
          rw [hDt_eval, hDtl_eval]
    obtain ⟨D_MC, hDMC_decomp, hDMC_MC, hDMC_eval⟩ := hList D hD.1.1 hD.2
    have hDMC_zero : IsMonomialDecomp F L 0 D_MC := by
      refine ⟨hDMC_decomp.1, fun w => ?_⟩
      have h1 := hDMC_decomp.2 w
      dsimp only at h1
      rw [Pi.zero_apply, ← h1, ← hD.1.2 w, Pi.zero_apply]
    have hLamMC : IsLambdaFuncOn F rec L M_C ψ (galoisLam F rec L M_C ψ) :=
      hTheory.1 L M_C hLM_C hMin.1 hMin.2.2.1 ψ hψ
    rw [hDMC_eval]
    exact hLamMC.2 D_MC hDMC_zero hDMC_MC
  refine ⟨?_, hHomog⟩
  intro M E h₁ h₂ hMK hEK _ _ hlt
  have hWeil1 : IsWeilRep F L (charRep F L 1) :=
    ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => by ext; simp [charRep]⟩
  have hHom1 : ∀ D_L : List (MonomialTerm F L),
      IsHomogeneousDecompOn F L K 1 D_L →
      evalMonomialList F rec (fun _ E' _ => f E') L ψ D_L = 1 :=
    hHomog 1 ⟨1, hWeil1, rfl⟩
  obtain ⟨hψM, hShift_norm, hShift_hom⟩ :=
    ld_weak_lambda_base_shift F rec L M K h₁ hMK hGal ψ hψ f hHom1
  have hSep_iff : ∀ (L' E' : IntermediateField F (AlgebraicClosure F)) (hLE' : L' ≤ E'),
      Algebra.IsSeparable L' (IntermediateField.extendScalars hLE') ↔
        E' ≤ IntermediateField.restrictScalars F (separableClosure L' (AlgebraicClosure F)) := by
    intro L' E' hLE'
    let S := IntermediateField.extendScalars hLE'
    have hmin : ∀ x : S, IsSeparable L' x.1 ↔ IsSeparable L' x := by
      intro x
      change (minpoly L' (S.val x)).Separable ↔ (minpoly L' x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hLE').mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L' S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E' := (IntermediateField.mem_extendScalars hLE').mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hGalMK : IsGaloisExt F M K := by
    refine ⟨hMK, hGal.2.1, ?_, ?_⟩
    · intro σ hσ τ hτ
      exact hGal.2.2.1 σ (IntermediateField.fixingSubgroup_le h₁ hσ) τ hτ
    · intro h
      rw [hSep_iff]
      intro z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      have hzL : IsSeparable L z := by
        have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) hz
        exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
      exact IsSeparable.tower_top (↥(IntermediateField.extendScalars h₁)) hzL
  have hLamMK : IsLambdaFuncOn F rec M K (traceChar F h₁ ψ)
      (galoisLam F rec M K (traceChar F h₁ ψ)) :=
    hTheory.1 M K hMK hGalMK hlt (traceChar F h₁ ψ) hψM
  have hEq := ld_weak_lambda_uniqueness F rec M K hMK hGalMK (traceChar F h₁ ψ) hψM
    (shiftLamFunc F M f) (galoisLam F rec M K (traceChar F h₁ ψ))
    hShift_norm hShift_hom
    hLamMK.1 (fun D hD => hLamMK.2 D hD.1 (fun t ht => (hD.2 t ht).choose))
    E h₂ hEK
  unfold shiftLamFunc at hEq
  rw [dif_pos h₂] at hEq
  exact mul_inv_eq_iff_eq_mul.mp hEq

theorem ld_ch16_and_19_1_candidate_lambda (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK))) :
    ∃ f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ,
      IsCandidateLambdaOn F rec L K hLK ψ f ∧
      ∀ (χK : relWeil F K →* (Ω F)ˣ),
        (∃ χL : relWeil F L →* (Ω F)ˣ,
          IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK) →
        ∀ (D : List (MonomialTerm F L)),
          IsHomogeneousDecompOn F L K χK D →
          evalMonomialList F rec (fun _ E _ => f E) L ψ D = 1 :=
by
  have hBaseMin := ld_minimal_abelian_normal_subfield_and_base F rec L K hLK hGal ψ hψ
  by_cases hle : Module.finrank L (IntermediateField.extendScalars hLK) ≤ 1
  · exact ⟨fun _ => 1, hBaseMin.1 hle⟩
  · have hgt : 1 < Module.finrank L (IntermediateField.extendScalars hLK) := lt_of_not_ge hle
    obtain ⟨M_C, hLM_C, hM_CK, hMin⟩ := hBaseMin.2 hgt
    have hMackey : HasMackeyDecompOn F rec L K M_C hLK hLM_C hM_CK ψ :=
      ld_ch15_mackey_and_main_lemma_15_3 F rec L K M_C hLK hLM_C hM_CK hGal ψ hψ hTheory hMin
    have hSub : IsCandNormSubAndConj F rec L K M_C hLK ψ (candLamFrom F rec L M_C ψ) :=
      ld_ch16_cand_norm_sub_and_conj F rec L K M_C hLK hLM_C hM_CK hGal ψ hψ hTheory hMin hMackey
    have hMain :=
      ld_ch19_1_and_16_3_tower_trans F rec L K M_C hLK hLM_C hM_CK hGal ψ hψ hTheory hMin hMackey
        (candLamFrom F rec L M_C ψ) rfl hSub
    exact ⟨candLamFrom F rec L M_C ψ,
      ⟨hSub.1, hSub.2.2.1, hSub.2.2.2.1, hMain.1⟩,
      hMain.2⟩

theorem ld_candidate_subfield_reductions (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hTheory : LambdaTheoryBelow F rec (Module.finrank L (IntermediateField.extendScalars hLK)))
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ)
    (hf_cand : IsCandidateLambdaOn F rec L K hLK ψ f)
    (χK : relWeil F K →* (Ω F)ˣ)
    (hne : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK)
    (D : List (MonomialTerm F L)) (hD : IsHomogeneousDecompOn F L K χK D) :
    (∀ t ∈ D, ∃ htK : t.field ≤ K,
      Module.finrank t.field (IntermediateField.extendScalars htK) <
        Module.finrank L (IntermediateField.extendScalars hLK)) ∧
    (∀ (M : IntermediateField F (AlgebraicClosure F)) (hLM : L ≤ M),
      M ≤ K → IsGaloisExt F L M →
      Module.finrank L (IntermediateField.extendScalars hLM) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      ∀ (D₀ : List (MonomialTerm F L)),
        IsMonomialDecomp F L 0 D₀ →
        (∀ t ∈ D₀, t.field ≤ M) →
        evalMonomialList F rec (fun _ E _ => f E) L ψ D₀ = 1) ∧
    (∀ (F' : IntermediateField F (AlgebraicClosure F)) (hLF' : L ≤ F') (hF'K : F' ≤ K),
      Module.finrank F' (IntermediateField.extendScalars hF'K) <
        Module.finrank L (IntermediateField.extendScalars hLK) →
      ∀ (D_F' : List (MonomialTerm F F')),
        IsMonomialDecomp F F' 0 D_F' →
        (∀ t ∈ D_F', t.field ≤ K) →
        evalMonomialList F rec (fun _ E _ => f E) L ψ (D_F'.map (MonomialTerm.restrict F hLF')) = 1) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  refine ⟨?_, ?_, ?_⟩
  · have hNoExt : ∀ (E : IntermediateField F (AlgebraicClosure F)) (htK' : E ≤ K)
        (χE : relWeil F E →* (Ω F)ˣ),
        IsWeilRep F E (charRep F E χE) →
        restrictWeilChar F htK' χE = χK →
        E ≠ L := by
      rintro E htK' χE hWeil hrest' rfl
      exact hne ⟨χE, hWeil, hrest'⟩
    intro t ht
    have ht_wf : t.Wf F L := hD.1.1 t ht
    obtain ⟨htK, hrest⟩ := hD.2 t ht
    refine ⟨htK, ?_⟩
    haveI : FiniteDimensional F t.field := ht_wf.1
    haveI : IsScalarTower F L (IntermediateField.extendScalars t.le) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower F t.field (IntermediateField.extendScalars htK) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower F L (IntermediateField.extendScalars hLK) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have h1 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars t.le) =
        Module.finrank F t.field :=
      Module.finrank_mul_finrank F L (IntermediateField.extendScalars t.le)
    have h2 : Module.finrank F t.field * Module.finrank t.field (IntermediateField.extendScalars htK) =
        Module.finrank F K :=
      Module.finrank_mul_finrank F t.field (IntermediateField.extendScalars htK)
    have h3 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) =
        Module.finrank F K :=
      Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLK)
    have hposL : 0 < Module.finrank F L := Module.finrank_pos
    have hposK : 0 < Module.finrank F K := Module.finrank_pos
    have hmul_eq : Module.finrank F L *
        (Module.finrank L (IntermediateField.extendScalars t.le) *
          Module.finrank t.field (IntermediateField.extendScalars htK)) =
        Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLK) := by
      rw [← mul_assoc, h1, h2, h3]
    have hdeg_eq : Module.finrank L (IntermediateField.extendScalars t.le) *
        Module.finrank t.field (IntermediateField.extendScalars htK) =
        Module.finrank L (IntermediateField.extendScalars hLK) :=
      Nat.eq_of_mul_eq_mul_left hposL hmul_eq
    have hpos_tK : 0 < Module.finrank t.field (IntermediateField.extendScalars htK) := by
      by_contra h0
      have h0' : Module.finrank t.field (IntermediateField.extendScalars htK) = 0 :=
        Nat.eq_zero_of_not_pos h0
      rw [h0', mul_zero] at h2
      exact (ne_of_gt hposK) h2.symm
    have hgt1 : 1 < Module.finrank L (IntermediateField.extendScalars t.le) := by
      by_contra hle1
      have hle1' : Module.finrank L (IntermediateField.extendScalars t.le) ≤ 1 :=
        not_lt.mp hle1
      have hfin_le : Module.finrank F t.field ≤ Module.finrank F L := by
        calc Module.finrank F t.field
          _ = Module.finrank F L * Module.finrank L (IntermediateField.extendScalars t.le) := h1.symm
          _ ≤ Module.finrank F L * 1 := Nat.mul_le_mul_left _ hle1'
          _ = Module.finrank F L := mul_one _
      have hEq : L = t.field := IntermediateField.eq_of_le_of_finrank_le t.le hfin_le
      exact hNoExt t.field htK t.χ ht_wf.2.2 hrest hEq.symm
    calc Module.finrank t.field (IntermediateField.extendScalars htK)
      _ = 1 * Module.finrank t.field (IntermediateField.extendScalars htK) := (one_mul _).symm
      _ < Module.finrank L (IntermediateField.extendScalars t.le) *
          Module.finrank t.field (IntermediateField.extendScalars htK) :=
        Nat.mul_lt_mul_of_pos_right hgt1 hpos_tK
      _ = Module.finrank L (IntermediateField.extendScalars hLK) := hdeg_eq
  · intro M hLM hMK hGalLM hltM D₀ hD₀ hD₀_le
    have hLamM : IsLambdaFuncOn F rec L M ψ (galoisLam F rec L M ψ) :=
      hTheory.1 L M hLM hGalLM hltM ψ hψ
    have hCongr : evalMonomialList F rec (fun _ E _ => f E) L ψ D₀ =
        evalMonomialList F rec (fun _ E _ => galoisLam F rec L M ψ E) L ψ D₀ := by
      unfold evalMonomialList
      congr 1
      apply List.map_congr_left
      intro t ht
      simp only [evalMonomialTerm, hf_cand.2.1 M hLM hMK hGalLM hltM t.field t.le (hD₀_le t ht)]
    rw [hCongr]
    exact hLamM.2 D₀ hD₀ hD₀_le
  · intro F' hLF' hF'K hltF' D_F' hD_F' hD_F'_le
    haveI : FiniteDimensional F F' :=
      Module.Finite.of_injective (IntermediateField.inclusion hF'K).toLinearMap
        (IntermediateField.inclusion hF'K).injective
    have hSepLF' : Algebra.IsSeparable L (IntermediateField.extendScalars hLF') := by
      letI algF'K : Algebra (IntermediateField.extendScalars hLF')
          (IntermediateField.extendScalars (hLF'.trans hF'K)) :=
        inferInstanceAs (Algebra F' (IntermediateField.extendScalars hF'K))
      letI : SMul (IntermediateField.extendScalars hLF')
          (IntermediateField.extendScalars (hLF'.trans hF'K)) :=
        algF'K.toSMul
      haveI : IsScalarTower L (IntermediateField.extendScalars hLF')
          (IntermediateField.extendScalars (hLF'.trans hF'K)) :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : Algebra.IsSeparable L (IntermediateField.extendScalars (hLF'.trans hF'K)) :=
        hGal.2.2.2 (hLF'.trans hF'K)
      exact Algebra.isSeparable_tower_bot_of_isSeparable L
        (IntermediateField.extendScalars hLF')
        (IntermediateField.extendScalars (hLF'.trans hF'K))
    have hGalF'K : IsGaloisExt F F' K :=
      ((ld_galois_closure_directed_system F).2.1 L F' K hLF' hF'K hGal).1
    obtain ⟨hψF', _, htraceChar_trans⟩ :=
      ((ld_tateEps_char_and_traceChar F rec).1 L F' hLF' hSepLF').2 ψ hψ
    have heval_restrict_cand : ∀ (L_F' : List (MonomialTerm F F')),
        (∀ t ∈ L_F', t.Wf F F') →
        (∀ t ∈ L_F', t.field ≤ K) →
        evalMonomialList F rec (fun _ E _ => f E) L ψ (L_F'.map (MonomialTerm.restrict F hLF')) =
          evalMonomialList F rec
            (fun _ E _ => galoisLam F rec F' K (traceChar F hLF' ψ) E)
            F' (traceChar F hLF' ψ) L_F' *
          (f F') ^ (monomialListDeg F F' L_F') := by
      intro L_F' hWf hLeK
      induction L_F' with
      | nil =>
        simp [evalMonomialList, monomialListDeg]
      | cons t tl ih =>
        have htWf : t.Wf F F' := hWf t List.mem_cons_self
        have htLeK : t.field ≤ K := hLeK t List.mem_cons_self
        have htlWf : ∀ t' ∈ tl, t'.Wf F F' :=
          fun t' ht' => hWf t' (List.mem_cons_of_mem t ht')
        have htlLeK : ∀ t' ∈ tl, t'.field ≤ K :=
          fun t' ht' => hLeK t' (List.mem_cons_of_mem t ht')
        have hf_eq : f t.field =
            galoisLam F rec F' K (traceChar F hLF' ψ) t.field *
              (f F') ^ (Module.finrank F' (IntermediateField.extendScalars t.le)) :=
          hf_cand.2.2.2 F' t.field hLF' t.le hF'K htLeK hSepLF' htWf.2.1 hltF'
        have htr_eq : traceChar F (hLF'.trans t.le) ψ =
            traceChar F t.le (traceChar F hLF' ψ) :=
          htraceChar_trans t.field t.le
        have hterm : evalMonomialTerm F rec (fun _ E _ => f E) L ψ (t.restrict F hLF') =
            evalMonomialTerm F rec
              (fun _ E _ => galoisLam F rec F' K (traceChar F hLF' ψ) E)
              F' (traceChar F hLF' ψ) t *
            (f F') ^ (t.deg F F') := by
          simp only [evalMonomialTerm, MonomialTerm.restrict, MonomialTerm.deg]
          rw [htr_eq, hf_eq, ← mul_assoc, mul_zpow, ← zpow_natCast, ← zpow_mul,
            mul_comm (Module.finrank F' (IntermediateField.extendScalars t.le) : ℤ) t.coeff]
        simp only [evalMonomialList, monomialListDeg, List.map_cons, List.prod_cons, List.sum_cons] at ih ⊢
        rw [hterm, ih htlWf htlLeK, zpow_add]
        ac_rfl
    have hLamF'K : evalMonomialList F rec
        (fun _ E _ => galoisLam F rec F' K (traceChar F hLF' ψ) E)
        F' (traceChar F hLF' ψ) D_F' = 1 :=
      (hTheory.1 F' K hF'K hGalF'K hltF' (traceChar F hLF' ψ) hψF').2 D_F' hD_F' hD_F'_le
    let σ₀ : Representation (Ω F) (relWeil F F') PUnit.{u+1} := 1
    have hσ₀ : IsWeilRep F F' σ₀ :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩
    have htr₀ : (fun w : relWeil F F' => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) = 0 := by
      ext w
      have hw : σ₀ w = 0 := Subsingleton.elim _ _
      rw [hw, map_zero, Pi.zero_apply]
    have hD₀ : IsMonomialDecomp F F' (fun w => LinearMap.trace (Ω F) PUnit.{u+1} (σ₀ w)) D_F' := by
      rw [htr₀]
      exact hD_F'
    have hDeg : monomialListDeg F F' D_F' = 0 := by
      rw [ld_monomial_deg_eq_finrank F F' σ₀ hσ₀ D_F' hD₀,
        Module.finrank_zero_of_subsingleton, Nat.cast_zero]
    rw [heval_restrict_cand D_F' hD_F'.1 hD_F'_le, hLamF'K, hDeg, zpow_zero, mul_one]

theorem ld_nilpotent_central_subext (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (χK : relWeil F K →* (Ω F)ˣ) (hInv : IsInvariantWeilChar F L K χK)
    (hne : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F hLK χL = χK)
    (hNilp : Group.IsNilpotent ((IntermediateField.extendScalars hLK) ≃ₐ[L] (IntermediateField.extendScalars hLK))) :
    ∃ (M : IntermediateField F (AlgebraicClosure F)) (hLM : L ≤ M) (hMK : M ≤ K),
      IsGaloisExt F L M ∧
      IsGaloisExt F M K ∧
      Nat.Prime (Module.finrank M (IntermediateField.extendScalars hMK)) ∧
      Module.finrank L (IntermediateField.extendScalars hLM) <
        Module.finrank L (IntermediateField.extendScalars hLK) ∧
      (∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ M.fixingSubgroup,
        σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) ∧
      ∃ χM : relWeil F M →* (Ω F)ˣ,
        IsWeilRep F M (charRep F M χM) ∧ restrictWeilChar F hMK χM = χK :=
by
  
  have h_isGalois_of_norm : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar]
      [Algebra k Ω_bar] [Normal k Ω_bar]
      (K' : IntermediateField k Ω_bar) [Algebra.IsSeparable k K'],
      (∀ σ : Ω_bar ≃ₐ[k] Ω_bar, ∀ τ ∈ K'.fixingSubgroup, σ * τ * σ⁻¹ ∈ K'.fixingSubgroup) →
      IsGalois k K' := by
    intro k Ω_bar _ _ _ _ K' _ h_norm
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := Algebra.IsSeparable.isSeparable k x
      change (minpoly k (K'.val x)).Separable
      rw [minpoly.algHom_eq K'.val K'.val.injective x]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hmap_KN : K_N.map N.val = K' := by
      have hrange : N.val.fieldRange = N := by
        ext z
        exact ⟨fun ⟨y, hy⟩ => hy ▸ y.2, fun hz => ⟨⟨z, hz⟩, rfl⟩⟩
      rw [IntermediateField.map_comap_eq, hrange, inf_of_le_left hK'N]
    let e_KN : ↥K_N ≃ₐ[k] ↥K' :=
      (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hmap_KN)
    haveI : K_N.fixingSubgroup.Normal := by
      refine ⟨fun sbar hsbar tbar => ?_⟩
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar tbar
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar sbar
      rw [IntermediateField.mem_fixingSubgroup_iff] at hsbar ⊢
      intro y hy
      have hσK' : σ ∈ K'.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro z hz
        have hzN : z ∈ N := hK'N hz
        have hzKN : (⟨z, hzN⟩ : N) ∈ K_N := hz
        have h1 := congr_arg Subtype.val (hsbar ⟨z, hzN⟩ hzKN)
        have h2 : ((AlgEquiv.restrictNormalHom N σ ⟨z, hzN⟩ : N) : Ω_bar) = σ z :=
          AlgEquiv.restrictNormalHom_apply N σ ⟨z, hzN⟩
        exact h2.symm.trans h1
      have hconj := h_norm τ σ hσK'
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconj
      have h3 := hconj (y : Ω_bar) hy
      have h4 : (((AlgEquiv.restrictNormalHom N τ * AlgEquiv.restrictNormalHom N σ *
          (AlgEquiv.restrictNormalHom N τ)⁻¹) y : N) : Ω_bar) =
          (AlgEquiv.restrictNormalHom N (τ * σ * τ⁻¹) y : Ω_bar) := by
        rw [map_mul, map_mul, map_inv]
      apply Subtype.ext
      rw [h4, AlgEquiv.restrictNormalHom_apply]
      exact h3
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp inferInstance
    exact IsGalois.of_algEquiv e_KN
  
  have h_fixedField_finrank : ∀ (k E Ω_bar : Type u) [Field k] [Field E] [Field Ω_bar]
      [Algebra k E] [Algebra k Ω_bar] [FiniteDimensional k E] [IsGalois k E]
      (f : E →ₐ[k] Ω_bar) (D_c : Subgroup (E ≃ₐ[k] E)),
      Module.finrank k ((IntermediateField.fixedField D_c).map f) * Nat.card D_c =
        Module.finrank k E := by
    intro k E Ω_bar _ _ _ _ _ _ _ f D_c
    let M₀ : IntermediateField k E := IntermediateField.fixedField D_c
    have h1 : Module.finrank k M₀ = Module.finrank k (M₀.map f) :=
      (M₀.equivMap f).toLinearEquiv.finrank_eq
    rw [← h1, ← IntermediateField.finrank_fixedField_eq_card D_c]
    exact Module.finrank_mul_finrank k M₀ E
  
  have h_nilp_prime : ∀ (G : Type u) [Group G] [Finite G] [Group.IsNilpotent G],
      1 < Nat.card G →
      ∃ D_c : Subgroup G, D_c ≤ Subgroup.center G ∧ Nat.Prime (Nat.card D_c) := by
    intro G _ _ _ hcard
    have hZ_ne_bot : Subgroup.center G ≠ ⊥ := by
      intro hZ
      have h_ucs : ∀ k : ℕ, upperCentralSeries G k = ⊥ := by
        intro k
        induction k with
        | zero => exact upperCentralSeries_zero G
        | succ k ih =>
          rw [eq_bot_iff]
          intro x hx
          rw [mem_upperCentralSeries_succ_iff] at hx
          have hx1 : x ∈ upperCentralSeries G 1 := by
            rw [mem_upperCentralSeries_succ_iff, upperCentralSeries_zero]
            intro y
            rw [← ih]
            exact hx y
          rw [upperCentralSeries_one, hZ] at hx1
          exact hx1
      obtain ⟨n, hn⟩ := Group.IsNilpotent.nilpotent G
      have htop_bot : (⊤ : Subgroup G) = ⊥ := by
        rw [← hn, h_ucs n]
      have hcard1 : Nat.card G = 1 := by
        have h1 : Nat.card (⊤ : Subgroup G) = Nat.card (⊥ : Subgroup G) := by
          rw [htop_bot]
        rw [Subgroup.card_top, Subgroup.card_bot] at h1
        exact h1
      omega
    have hZ_card_ne_one : Nat.card (Subgroup.center G) ≠ 1 := by
      rwa [ne_eq, Subgroup.card_eq_one]
    obtain ⟨p₀, hp₀, hdvd⟩ := Nat.exists_prime_and_dvd hZ_card_ne_one
    haveI : Fact (Nat.Prime p₀) := ⟨hp₀⟩
    haveI : Fintype (Subgroup.center G) := Fintype.ofFinite (Subgroup.center G)
    have hdvd' : p₀ ∣ Fintype.card (Subgroup.center G) := by
      rwa [← Nat.card_eq_fintype_card]
    obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card p₀ hdvd'
    refine ⟨Subgroup.zpowers (z : G), ?_, ?_⟩
    · rw [Subgroup.zpowers_le]
      exact z.2
    · rw [Nat.card_zpowers, ← Subgroup.orderOf_mk z.1 z.2, hz]
      exact hp₀
  
  have h_cyc_ext : ∀ (W : Type u) [Group W] (N : Subgroup W) [hNorm : N.Normal]
      [Finite (W ⧸ N)] {p₀ : ℕ} [Fact p₀.Prime],
      Nat.card (W ⧸ N) = p₀ →
      ∀ (Ω₀ : Type) [Field Ω₀] [IsAlgClosed Ω₀] (χ_N : N →* Ω₀ˣ),
      (∀ (g : W) (n : N),
        χ_N ⟨g⁻¹ * (n : W) * g, hNorm.conj_mem' (n : W) n.2 g⟩ = χ_N n) →
      ∃ χ_W : W →* Ω₀ˣ, ∀ n : N, χ_W (n : W) = χ_N n := by
    intro W _ N hNorm _ p₀ _ hcard Ω₀ _ _ χ_N h_inv
    haveI : IsCyclic (W ⧸ N) := isCyclic_of_prime_card hcard
    obtain ⟨q₀, hq₀⟩ := IsCyclic.exists_monoid_generator (α := W ⧸ N)
    let g₀ : W := Quotient.out q₀
    have hg₀_mk : (QuotientGroup.mk g₀ : W ⧸ N) = q₀ := Quotient.out_eq q₀
    let m₀ : ℕ := orderOf q₀
    have hm₀_pos : 0 < m₀ := orderOf_pos q₀
    have hg₀_mem : g₀ ^ m₀ ∈ N := by
      rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, hg₀_mk]
      exact pow_orderOf_eq_one q₀
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (χ_N ⟨g₀ ^ m₀, hg₀_mem⟩ : Ω₀) hm₀_pos
    have hz0 : z ≠ 0 := by
      intro h0
      rw [h0, zero_pow hm₀_pos.ne'] at hz
      exact (Units.ne_zero _) hz.symm
    let α : Ω₀ˣ := Units.mk0 z hz0
    have hα : α ^ m₀ = χ_N ⟨g₀ ^ m₀, hg₀_mem⟩ := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val]
      exact hz
    have h_decomp : ∀ w : W, ∃ (k : ℕ) (n : N), w = g₀ ^ k * (n : W) := by
      intro w
      obtain ⟨k, hk⟩ := hq₀ (QuotientGroup.mk w)
      dsimp only at hk
      rw [← hg₀_mk, ← QuotientGroup.mk_pow] at hk
      have hmem : (g₀ ^ k)⁻¹ * w ∈ N := QuotientGroup.eq.mp hk
      refine ⟨k, ⟨(g₀ ^ k)⁻¹ * w, hmem⟩, ?_⟩
      simp
    have h_indep_le : ∀ (k₁ k₂ : ℕ) (n₁ n₂ : N), k₂ ≤ k₁ →
        g₀ ^ k₁ * (n₁ : W) = g₀ ^ k₂ * (n₂ : W) →
        α ^ k₁ * χ_N n₁ = α ^ k₂ * χ_N n₂ := by
      intro k₁ k₂ n₁ n₂ hle heq
      let d : ℕ := k₁ - k₂
      have hk₁ : k₁ = k₂ + d := (Nat.add_sub_of_le hle).symm
      have hd_eq : g₀ ^ d * (n₁ : W) = (n₂ : W) := by
        apply mul_left_cancel (a := g₀ ^ k₂)
        rw [← mul_assoc, ← pow_add, ← hk₁, heq]
      have hd_N_eq : g₀ ^ d = (n₂ : W) * (n₁ : W)⁻¹ := eq_mul_inv_of_mul_eq hd_eq
      have hd_mem : g₀ ^ d ∈ N := by
        rw [hd_N_eq]
        exact N.mul_mem n₂.2 (N.inv_mem n₁.2)
      have hqd : q₀ ^ d = 1 := by
        rw [← hg₀_mk, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
        exact hd_mem
      obtain ⟨c, hc⟩ := orderOf_dvd_iff_pow_eq_one.mpr hqd
      have hd_pow : (⟨g₀ ^ d, hd_mem⟩ : N) = ⟨g₀ ^ m₀, hg₀_mem⟩ ^ c := by
        apply Subtype.ext
        rw [Subgroup.coe_pow, ← pow_mul, ← hc]
      have hn₂_eq : n₂ = ⟨g₀ ^ d, hd_mem⟩ * n₁ := by
        apply Subtype.ext
        exact hd_eq.symm
      have hχd : χ_N ⟨g₀ ^ d, hd_mem⟩ = α ^ d := by
        rw [hd_pow, map_pow, ← hα, ← pow_mul, ← hc]
      rw [hn₂_eq, map_mul, hχd, ← mul_assoc, ← pow_add, ← hk₁]
    have h_indep : ∀ (k₁ k₂ : ℕ) (n₁ n₂ : N),
        g₀ ^ k₁ * (n₁ : W) = g₀ ^ k₂ * (n₂ : W) →
        α ^ k₁ * χ_N n₁ = α ^ k₂ * χ_N n₂ := by
      intro k₁ k₂ n₁ n₂ heq
      rcases le_total k₂ k₁ with hle | hle
      · exact h_indep_le k₁ k₂ n₁ n₂ hle heq
      · exact (h_indep_le k₂ k₁ n₂ n₁ hle heq.symm).symm
    choose kw nw h_kw_nw using h_decomp
    have h_eval : ∀ (w : W) (k : ℕ) (n : N),
        w = g₀ ^ k * (n : W) → α ^ kw w * χ_N (nw w) = α ^ k * χ_N n := by
      intro w k n hw
      exact h_indep (kw w) k (nw w) n ((h_kw_nw w).symm.trans hw)
    refine ⟨{
      toFun := fun w => α ^ kw w * χ_N (nw w)
      map_one' := by
        rw [h_eval 1 0 1 (by simp)]
        simp
      map_mul' := fun w₁ w₂ => by
        let k₁ := kw w₁
        let n₁ := nw w₁
        let k₂ := kw w₂
        let n₂ := nw w₂
        have hw₁ : w₁ = g₀ ^ k₁ * (n₁ : W) := h_kw_nw w₁
        have hw₂ : w₂ = g₀ ^ k₂ * (n₂ : W) := h_kw_nw w₂
        let n₁_conj : N := ⟨(g₀ ^ k₂)⁻¹ * (n₁ : W) * g₀ ^ k₂, hNorm.conj_mem' (n₁ : W) n₁.2 (g₀ ^ k₂)⟩
        have h_mul_eq : w₁ * w₂ = g₀ ^ (k₁ + k₂) * ((n₁_conj * n₂ : N) : W) := by
          rw [hw₁, hw₂, pow_add, Subgroup.coe_mul]
          dsimp [n₁_conj]
          group
        rw [h_eval (w₁ * w₂) (k₁ + k₂) (n₁_conj * n₂) h_mul_eq]
        rw [map_mul, h_inv (g₀ ^ k₂) n₁, pow_add]
        change α ^ k₁ * α ^ k₂ * (χ_N n₁ * χ_N n₂) = (α ^ k₁ * χ_N n₁) * (α ^ k₂ * χ_N n₂)
        ac_rfl
    }, ?_⟩
    intro n
    change α ^ kw (n : W) * χ_N (nw (n : W)) = χ_N n
    rw [h_eval (n : W) 0 n (by simp)]
    simp
  
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  haveI : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F K' := hGal.2.1
  haveI : FiniteDimensional L K' := FiniteDimensional.right F L K'
  haveI : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  have hGal' : IsGalois L K' := by
    apply h_isGalois_of_norm L (AlgebraicClosure F) K'
    intro σ τ hτ
    rw [IntermediateField.mem_fixingSubgroup_iff] at hτ ⊢
    let eL := IntermediateField.fixingSubgroupEquiv L
    have hσL : (eL.symm σ : AbsGal F) ∈ L.fixingSubgroup := (eL.symm σ).2
    have hτK : (eL.symm τ : AbsGal F) ∈ K.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro z hz
      exact hτ z ((IntermediateField.mem_extendScalars hLK).mpr hz)
    have hconj := hGal.2.2.1 _ hσL _ hτK
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconj
    intro z hz
    exact hconj z ((IntermediateField.mem_extendScalars hLK).mp hz)
  haveI : IsGalois L K' := hGal'
  haveI : Normal L K' := IsGalois.to_normal
  have hgt : 1 < Module.finrank L K' := by
    by_contra h_not_gt
    have h_le : Module.finrank L K' ≤ 1 := Nat.le_of_not_lt h_not_gt
    have hKL : K ≤ L := (ld_galois_closure_directed_system F).1 L K hLK hGal h_le
    have hLK_eq : L = K := le_antisymm hLK hKL
    subst hLK_eq
    apply hne
    refine ⟨χK, hInv.1, ?_⟩
    ext w
    rfl
  
  have hcard_G : 1 < Nat.card (K' ≃ₐ[L] K') := by
    rwa [IsGalois.card_aut_eq_finrank L K']
  obtain ⟨D_c, hDc_cent, hDc_prime⟩ := h_nilp_prime (K' ≃ₐ[L] K') hcard_G
  
  let M₀ : IntermediateField L K' := IntermediateField.fixedField D_c
  let M_L : IntermediateField L (AlgebraicClosure F) := M₀.map K'.val
  let M : IntermediateField F (AlgebraicClosure F) := M_L.restrictScalars F
  have hLM : L ≤ M := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars]
    exact M_L.algebraMap_mem ⟨z, hz⟩
  have hMK : M ≤ K := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars] at hz
    rcases hz with ⟨x, _, rfl⟩
    exact (IntermediateField.mem_extendScalars hLK).mp x.2
  have hGalMK : IsGaloisExt F M K :=
    ((ld_galois_closure_directed_system F).2.1 L M K hLM hMK hGal).1
  let π_K : L.fixingSubgroup →* (K' ≃ₐ[L] K') :=
    (AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv L).toMonoidHom
  have hπ_apply : ∀ (γ : L.fixingSubgroup) (x : K'),
      ((π_K γ x : K') : AlgebraicClosure F) = γ.1 x.1 := by
    intro γ x
    exact AlgEquiv.restrictNormalHom_apply K' ((IntermediateField.fixingSubgroupEquiv L) γ) x
  have hM₀_fix : M₀.fixingSubgroup = D_c := IntermediateField.fixingSubgroup_fixedField D_c
  have hπ_mem_M : ∀ γ : L.fixingSubgroup, γ.1 ∈ M.fixingSubgroup ↔ π_K γ ∈ D_c := by
    intro γ
    rw [← hM₀_fix, IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h x hx
      apply Subtype.ext
      rw [hπ_apply γ x]
      have hxM : x.1 ∈ M := by
        rw [IntermediateField.mem_restrictScalars]
        exact ⟨x, hx, rfl⟩
      exact h x.1 hxM
    · intro h z hz
      rw [IntermediateField.mem_restrictScalars] at hz
      rcases hz with ⟨x, hx, rfl⟩
      have h1 := congr_arg Subtype.val (h x hx)
      rw [hπ_apply γ x] at h1
      exact h1
  have hπ_mem_K : ∀ γ : L.fixingSubgroup, γ.1 ∈ K.fixingSubgroup ↔ π_K γ = 1 := by
    intro γ
    rw [IntermediateField.mem_fixingSubgroup_iff, AlgEquiv.ext_iff]
    constructor
    · intro h x
      apply Subtype.ext
      rw [hπ_apply γ x]
      exact h x.1 ((IntermediateField.mem_extendScalars hLK).mp x.2)
    · intro h z hz
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
      have h1 := congr_arg Subtype.val (h x)
      rw [hπ_apply γ x] at h1
      exact h1
  have hCent : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ M.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup := by
    intro σ hσ τ hτ
    have hτL : τ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM hτ
    let γσ : L.fixingSubgroup := ⟨σ, hσ⟩
    let γτ : L.fixingSubgroup := ⟨τ, hτL⟩
    have hτ_Dc : π_K γτ ∈ D_c := (hπ_mem_M γτ).mp hτ
    have hcomm : π_K γσ * π_K γτ = π_K γτ * π_K γσ :=
      Subgroup.mem_center_iff.mp (hDc_cent hτ_Dc) (π_K γσ)
    have hcomm_L : σ * τ * σ⁻¹ * τ⁻¹ ∈ L.fixingSubgroup :=
      (γσ * γτ * γσ⁻¹ * γτ⁻¹).2
    refine (hπ_mem_K ⟨σ * τ * σ⁻¹ * τ⁻¹, hcomm_L⟩).mpr ?_
    change π_K (γσ * γτ * γσ⁻¹ * γτ⁻¹) = 1
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hcomm]
    group
  have hGalLM : IsGaloisExt F L M := by
    haveI : FiniteDimensional F M :=
      Module.Finite.of_injective (IntermediateField.inclusion hMK).toLinearMap
        (IntermediateField.inclusion hMK).injective
    refine ⟨hLM, inferInstance, ?_, ?_⟩
    · intro σ hσ τ hτ
      have hτL : τ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM hτ
      let γσ : L.fixingSubgroup := ⟨σ, hσ⟩
      let γτ : L.fixingSubgroup := ⟨τ, hτL⟩
      have hτ_Dc : π_K γτ ∈ D_c := (hπ_mem_M γτ).mp hτ
      have hcomm : π_K γσ * π_K γτ = π_K γτ * π_K γσ :=
        Subgroup.mem_center_iff.mp (hDc_cent hτ_Dc) (π_K γσ)
      refine (hπ_mem_M (γσ * γτ * γσ⁻¹)).mpr ?_
      rw [map_mul, map_mul, map_inv, hcomm, mul_assoc, mul_inv_cancel, mul_one]
      exact hτ_Dc
    · intro h
      have hSepK : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
      refine ⟨fun x => ?_⟩
      let y : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hMK ((IntermediateField.mem_extendScalars h).mp x.2))⟩
      have hy : IsSeparable L y := @Algebra.IsSeparable.isSeparable L K' _ _ _ hSepK y
      have hmin_x : minpoly L (x.1 : AlgebraicClosure F) = minpoly L x :=
        minpoly.algHom_eq (IntermediateField.extendScalars h).val (IntermediateField.extendScalars h).val.injective x
      have hmin_y : minpoly L (y.1 : AlgebraicClosure F) = minpoly L y :=
        minpoly.algHom_eq K'.val K'.val.injective y
      change (minpoly L x).Separable
      rw [← hmin_x]
      change (minpoly L (y.1 : AlgebraicClosure F)).Separable
      rw [hmin_y]
      exact hy
  let M' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM
  have hM'_eq : M_L = M' := by
    ext z
    rfl
  have hmul1 : Module.finrank L M' * Nat.card D_c = Module.finrank L K' := by
    rw [← hM'_eq]
    exact h_fixedField_finrank L K' (AlgebraicClosure F) K'.val D_c
  have hmul2 : Module.finrank L M' * Module.finrank M (IntermediateField.extendScalars hMK) =
      Module.finrank L K' := by
    have hrel := IntermediateField.relfinrank_mul_relfinrank hLM hMK
    rwa [IntermediateField.relfinrank_eq_finrank_of_le hLM,
      IntermediateField.relfinrank_eq_finrank_of_le hMK,
      IntermediateField.relfinrank_eq_finrank_of_le hLK] at hrel
  haveI : FiniteDimensional F M := hGalLM.2.1
  haveI : FiniteDimensional F M' := hGalLM.2.1
  haveI : FiniteDimensional L M' := FiniteDimensional.right F L M'
  have hpos_M' : 0 < Module.finrank L M' := Module.finrank_pos
  have hdeg_MK : Module.finrank M (IntermediateField.extendScalars hMK) = Nat.card D_c :=
    Nat.eq_of_mul_eq_mul_left hpos_M' (hmul2.trans hmul1.symm)
  have hPrime_MK : Nat.Prime (Module.finrank M (IntermediateField.extendScalars hMK)) := by
    rwa [hdeg_MK]
  have hlt_M : Module.finrank L M' < Module.finrank L K' := by
    calc Module.finrank L M'
      _ = Module.finrank L M' * 1 := (mul_one _).symm
      _ < Module.finrank L M' * Nat.card D_c :=
        Nat.mul_lt_mul_of_pos_left hDc_prime.one_lt hpos_M'
      _ = Module.finrank L K' := hmul1
  
  let W := relWeil F M
  let N : Subgroup W := (relWeil F K).subgroupOf W
  haveI hNormN : N.Normal := ⟨fun n hn w => by
    change ((w * n * w⁻¹ : W) : AbsGal F) ∈ relWeil F K
    refine ⟨(w * n * w⁻¹ : W).2.1, ?_⟩
    exact hGalMK.2.2.1 (w : AbsGal F) w.2.2 (n : AbsGal F) hn.2⟩
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFinQuot, hCardQuot⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob M K hMK (hGalMK.2.2.2 hMK)
  haveI : Finite (W ⧸ N) := hFinQuot
  let p₀ := Module.finrank M (IntermediateField.extendScalars hMK)
  haveI : Fact p₀.Prime := ⟨hPrime_MK⟩
  let e_N : N ≃* relWeil F K := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hMK)
  let χ_N : N →* (Ω F)ˣ := χK.comp e_N.toMonoidHom
  have h_inv_N : ∀ (g : W) (n : N),
      χ_N ⟨g⁻¹ * (n : W) * g, hNormN.conj_mem' (n : W) n.2 g⟩ = χ_N n := by
    intro g n
    let g_L : relWeil F L := ⟨g.1, relWeil_antitone F hLM g.2⟩
    have h_eq : ((g⁻¹ * (n : W) * g : W) : AbsGal F) =
        (g_L⁻¹ : AbsGal F) * (e_N n : AbsGal F) * (g_L⁻¹ : AbsGal F)⁻¹ := by
      change (g.1)⁻¹ * (n : W).1 * g.1 = (g.1)⁻¹ * (n : W).1 * (g.1)⁻¹⁻¹
      rw [inv_inv]
    have hgw : (g_L⁻¹ : AbsGal F) * (e_N n : AbsGal F) * (g_L⁻¹ : AbsGal F)⁻¹ ∈ relWeil F K := by
      rw [← h_eq]
      exact hNormN.conj_mem' (n : W) n.2 g
    have h_sub : e_N ⟨g⁻¹ * (n : W) * g, hNormN.conj_mem' (n : W) n.2 g⟩ =
        ⟨(g_L⁻¹ : AbsGal F) * (e_N n : AbsGal F) * (g_L⁻¹ : AbsGal F)⁻¹, hgw⟩ :=
      Subtype.ext h_eq
    change χK (e_N ⟨g⁻¹ * (n : W) * g, hNormN.conj_mem' (n : W) n.2 g⟩) = χK (e_N n)
    rw [h_sub]
    exact hInv.2 g_L⁻¹ (e_N n) hgw
  obtain ⟨χM, hχM_ext⟩ := h_cyc_ext W N hCardQuot (Ω F) χ_N h_inv_N
  have hχM_rest : restrictWeilChar F hMK χM = χK := by
    apply MonoidHom.ext
    intro w_K
    let n_K : N := ⟨⟨w_K.1, relWeil_antitone F hMK w_K.2⟩, w_K.2⟩
    exact hχM_ext n_K
  have hχM_weil : IsWeilRep F M (charRep F M χM) := by
    refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
    rcases hInv.1.2 with ⟨U, hU_nhds, hU_triv⟩
    have hK_nhds : (K.fixingSubgroup : Set (AbsGal F)) ∈ nhds (1 : AbsGal F) :=
      (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F)
        (K.fixingSubgroup : Set (AbsGal F))).mpr ⟨K, inferInstance, Set.Subset.rfl⟩
    refine ⟨U ∩ (K.fixingSubgroup : Set (AbsGal F)), Filter.inter_mem hU_nhds hK_nhds, ?_⟩
    intro w hwU hwI
    let w_K : relWeil F K := ⟨w.1, w.2.1, hwU.2⟩
    have hw_triv : charRep F K χK w_K = 1 := hU_triv w_K hwU.1 hwI
    have hχ_eq : χM w = χK w_K := by
      rw [← hχM_rest]
      rfl
    change (χM w : Ω F) • LinearMap.id = 1
    rw [hχ_eq]
    exact hw_triv
  exact ⟨M, hLM, hMK, hGalLM, hGalMK, hPrime_MK, hlt_M, hCent, χM, hχM_weil, hχM_rest⟩

theorem ld_lemma_18_1_degenerate_commutator_decomp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M E F' : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM : L ≤ M) (hMK : M ≤ K) (hLE : L ≤ E) (hEK : E ≤ K)
    (hLF' : L ≤ F') (hF'E : F' ≤ E) (hF'M : F' ≤ M) (hF'_inf : E ⊓ M ≤ F')
    (hNotLe : ¬ E ≤ M)
    (hGal : IsGaloisExt F L K) (hGalLM : IsGaloisExt F L M) (hGalMK : IsGaloisExt F M K)
    (hPrime : Nat.Prime (Module.finrank M (IntermediateField.extendScalars hMK)))
    (hCent : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ M.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup)
    (χK : relWeil F K →* (Ω F)ˣ) (hInv : IsInvariantWeilChar F L K χK)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK χE = χK)
    (hCommTriv : ∀ (w₁ : relWeil F E) (w₂ : relWeil F M)
      (hw : (w₁ : AbsGal F) * (w₂ : AbsGal F) * (w₁ : AbsGal F)⁻¹ * (w₂ : AbsGal F)⁻¹ ∈
        relWeil F K),
      χK ⟨(w₁ : AbsGal F) * (w₂ : AbsGal F) * (w₁ : AbsGal F)⁻¹ * (w₂ : AbsGal F)⁻¹, hw⟩ = 1) :
    (∃ χF' : relWeil F F' →* (Ω F)ˣ,
      IsWeilRep F F' (charRep F F' χF') ∧
      restrictWeilChar F (hF'E.trans hEK) χF' = χK) ∧
    (∃ D_F' : List (MonomialTerm F F'),
      IsMonomialDecomp F F'
        (fun w => (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w) D_F' ∧
      ∀ s ∈ D_F', s.field ≤ M) :=
by
  
  have h_cyc_ext : ∀ (W : Type u) [Group W] (N : Subgroup W) [hNorm : N.Normal]
      [Finite (W ⧸ N)] {p₀ : ℕ} [Fact p₀.Prime],
      Nat.card (W ⧸ N) = p₀ →
      ∀ (Ω₀ : Type) [Field Ω₀] [IsAlgClosed Ω₀] (χ_N : N →* Ω₀ˣ),
      (∀ (g : W) (n : N),
        χ_N ⟨g⁻¹ * (n : W) * g, hNorm.conj_mem' (n : W) n.2 g⟩ = χ_N n) →
      ∃ χ_W : W →* Ω₀ˣ, ∀ n : N, χ_W (n : W) = χ_N n := by
    intro W _ N hNorm _ p₀ _ hcard Ω₀ _ _ χ_N h_inv
    haveI : IsCyclic (W ⧸ N) := isCyclic_of_prime_card hcard
    obtain ⟨q₀, hq₀⟩ := IsCyclic.exists_monoid_generator (α := W ⧸ N)
    let g₀ : W := Quotient.out q₀
    have hg₀_mk : (QuotientGroup.mk g₀ : W ⧸ N) = q₀ := Quotient.out_eq q₀
    let m₀ : ℕ := orderOf q₀
    have hm₀_pos : 0 < m₀ := orderOf_pos q₀
    have hg₀_mem : g₀ ^ m₀ ∈ N := by
      rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, hg₀_mk]
      exact pow_orderOf_eq_one q₀
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (χ_N ⟨g₀ ^ m₀, hg₀_mem⟩ : Ω₀) hm₀_pos
    have hz0 : z ≠ 0 := by
      intro h0
      rw [h0, zero_pow hm₀_pos.ne'] at hz
      exact (Units.ne_zero _) hz.symm
    let α : Ω₀ˣ := Units.mk0 z hz0
    have hα : α ^ m₀ = χ_N ⟨g₀ ^ m₀, hg₀_mem⟩ := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val]
      exact hz
    have h_decomp : ∀ w : W, ∃ (k : ℕ) (n : N), w = g₀ ^ k * (n : W) := by
      intro w
      obtain ⟨k, hk⟩ := hq₀ (QuotientGroup.mk w)
      dsimp only at hk
      rw [← hg₀_mk, ← QuotientGroup.mk_pow] at hk
      have hmem : (g₀ ^ k)⁻¹ * w ∈ N := QuotientGroup.eq.mp hk
      refine ⟨k, ⟨(g₀ ^ k)⁻¹ * w, hmem⟩, ?_⟩
      simp
    have h_indep_le : ∀ (k₁ k₂ : ℕ) (n₁ n₂ : N), k₂ ≤ k₁ →
        g₀ ^ k₁ * (n₁ : W) = g₀ ^ k₂ * (n₂ : W) →
        α ^ k₁ * χ_N n₁ = α ^ k₂ * χ_N n₂ := by
      intro k₁ k₂ n₁ n₂ hle heq
      let d : ℕ := k₁ - k₂
      have hk₁ : k₁ = k₂ + d := (Nat.add_sub_of_le hle).symm
      have hd_eq : g₀ ^ d * (n₁ : W) = (n₂ : W) := by
        apply mul_left_cancel (a := g₀ ^ k₂)
        rw [← mul_assoc, ← pow_add, ← hk₁, heq]
      have hd_N_eq : g₀ ^ d = (n₂ : W) * (n₁ : W)⁻¹ := eq_mul_inv_of_mul_eq hd_eq
      have hd_mem : g₀ ^ d ∈ N := by
        rw [hd_N_eq]
        exact N.mul_mem n₂.2 (N.inv_mem n₁.2)
      have hqd : q₀ ^ d = 1 := by
        rw [← hg₀_mk, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
        exact hd_mem
      obtain ⟨c, hc⟩ := orderOf_dvd_iff_pow_eq_one.mpr hqd
      have hd_pow : (⟨g₀ ^ d, hd_mem⟩ : N) = ⟨g₀ ^ m₀, hg₀_mem⟩ ^ c := by
        apply Subtype.ext
        rw [Subgroup.coe_pow, ← pow_mul, ← hc]
      have hn₂_eq : n₂ = ⟨g₀ ^ d, hd_mem⟩ * n₁ := by
        apply Subtype.ext
        exact hd_eq.symm
      have hχd : χ_N ⟨g₀ ^ d, hd_mem⟩ = α ^ d := by
        rw [hd_pow, map_pow, ← hα, ← pow_mul, ← hc]
      rw [hn₂_eq, map_mul, hχd, ← mul_assoc, ← pow_add, ← hk₁]
    have h_indep : ∀ (k₁ k₂ : ℕ) (n₁ n₂ : N),
        g₀ ^ k₁ * (n₁ : W) = g₀ ^ k₂ * (n₂ : W) →
        α ^ k₁ * χ_N n₁ = α ^ k₂ * χ_N n₂ := by
      intro k₁ k₂ n₁ n₂ heq
      rcases le_total k₂ k₁ with hle | hle
      · exact h_indep_le k₁ k₂ n₁ n₂ hle heq
      · exact (h_indep_le k₂ k₁ n₂ n₁ hle heq.symm).symm
    choose kw nw h_kw_nw using h_decomp
    have h_eval : ∀ (w : W) (k : ℕ) (n : N),
        w = g₀ ^ k * (n : W) → α ^ kw w * χ_N (nw w) = α ^ k * χ_N n := by
      intro w k n hw
      exact h_indep (kw w) k (nw w) n ((h_kw_nw w).symm.trans hw)
    refine ⟨{
      toFun := fun w => α ^ kw w * χ_N (nw w)
      map_one' := by
        rw [h_eval 1 0 1 (by simp)]
        simp
      map_mul' := fun w₁ w₂ => by
        let k₁ := kw w₁
        let n₁ := nw w₁
        let k₂ := kw w₂
        let n₂ := nw w₂
        have hw₁ : w₁ = g₀ ^ k₁ * (n₁ : W) := h_kw_nw w₁
        have hw₂ : w₂ = g₀ ^ k₂ * (n₂ : W) := h_kw_nw w₂
        let n₁_conj : N := ⟨(g₀ ^ k₂)⁻¹ * (n₁ : W) * g₀ ^ k₂, hNorm.conj_mem' (n₁ : W) n₁.2 (g₀ ^ k₂)⟩
        have h_mul_eq : w₁ * w₂ = g₀ ^ (k₁ + k₂) * ((n₁_conj * n₂ : N) : W) := by
          rw [hw₁, hw₂, pow_add, Subgroup.coe_mul]
          dsimp [n₁_conj]
          group
        rw [h_eval (w₁ * w₂) (k₁ + k₂) (n₁_conj * n₂) h_mul_eq]
        rw [map_mul, h_inv (g₀ ^ k₂) n₁, pow_add]
        change α ^ k₁ * α ^ k₂ * (χ_N n₁ * χ_N n₂) = (α ^ k₁ * χ_N n₁) * (α ^ k₂ * χ_N n₂)
        ac_rfl
    }, ?_⟩
    intro n
    change α ^ kw (n : W) * χ_N (nw (n : W)) = χ_N n
    rw [h_eval (n : W) 0 n (by simp)]
    simp
  
  have hF'K : F' ≤ K := hF'E.trans hEK
  have hGalF'K : IsGaloisExt F F' K :=
    ((ld_galois_closure_directed_system F).2.1 L F' K hLF' hF'K hGal).1
  haveI : FiniteDimensional F K := hGal.2.1
  have hFin_sub : ∀ {B : IntermediateField F (AlgebraicClosure F)},
      B ≤ K → FiniteDimensional F B :=
    fun hBK => Module.Finite.of_injective (IntermediateField.inclusion hBK).toLinearMap
      (IntermediateField.inclusion hBK).injective
  haveI : FiniteDimensional F F' := hFin_sub hF'K
  haveI : FiniteDimensional F E := hFin_sub hEK
  haveI : FiniteDimensional F M := hFin_sub hMK
  have hSepLK : Algebra.IsSeparable L (IntermediateField.extendScalars hLK) :=
    hGal.2.2.2 hLK
  have hSep_sub : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hLA : L ≤ A) (hAB : A ≤ B) (hBK : B ≤ K),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) := by
    intro A B hLA hAB hBK
    refine ⟨fun x => ?_⟩
    let B_A := IntermediateField.extendScalars hAB
    let K_L := IntermediateField.extendScalars hLK
    have hxB : (x : AlgebraicClosure F) ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
    let x_K : K_L := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hBK hxB)⟩
    have hsep_xK : IsSeparable L x_K := Algebra.IsSeparable.isSeparable L x_K
    have hmin_KL : minpoly L (x : AlgebraicClosure F) = minpoly L x_K :=
      minpoly.algHom_eq K_L.val K_L.val.injective x_K
    have hsep_L_bar : IsSeparable L (x : AlgebraicClosure F) := by
      change (minpoly L (x : AlgebraicClosure F)).Separable
      rw [hmin_KL]
      exact hsep_xK
    have hsep_A_bar : IsSeparable A (x : AlgebraicClosure F) :=
      IsSeparable.tower_top (↥(IntermediateField.extendScalars hLA)) hsep_L_bar
    have hmin_BA : minpoly A (x : AlgebraicClosure F) = minpoly A x :=
      minpoly.algHom_eq B_A.val B_A.val.injective x
    change (minpoly A x).Separable
    rw [← hmin_BA]
    exact hsep_A_bar
  have hFinrank_tower : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      Module.finrank F A * Module.finrank A (IntermediateField.extendScalars hAB) =
        Module.finrank F B := by
    intro A B _ _ hAB
    haveI : FiniteDimensional F (IntermediateField.extendScalars hAB) := ‹FiniteDimensional F B›
    haveI : IsScalarTower F A (IntermediateField.extendScalars hAB) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.finrank_mul_finrank F A (IntermediateField.extendScalars hAB)
  let ℓ := Module.finrank M (IntermediateField.extendScalars hMK)
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  let M' : IntermediateField F (AlgebraicClosure F) := E ⊔ M
  have hMM' : M ≤ M' := le_sup_right
  have hEM' : E ≤ M' := le_sup_left
  have hM'K : M' ≤ K := sup_le hEK hMK
  haveI : FiniteDimensional F M' := hFin_sub hM'K
  have hmul_MM' := hFinrank_tower hMM'
  have hmul_M'K := hFinrank_tower hM'K
  have hmul_MK := hFinrank_tower hMK
  have hpos_FM : 0 < Module.finrank F M := Module.finrank_pos
  have hmul_eq :
      Module.finrank F M *
        (Module.finrank M (IntermediateField.extendScalars hMM') *
          Module.finrank M' (IntermediateField.extendScalars hM'K)) =
      Module.finrank F M * ℓ := by
    rw [← mul_assoc, hmul_MM', hmul_M'K, hmul_MK]
  have hprod_ℓ :
      Module.finrank M (IntermediateField.extendScalars hMM') *
        Module.finrank M' (IntermediateField.extendScalars hM'K) = ℓ :=
    Nat.eq_of_mul_eq_mul_left hpos_FM hmul_eq
  have hdvd_MM' : Module.finrank M (IntermediateField.extendScalars hMM') ∣ ℓ :=
    ⟨Module.finrank M' (IntermediateField.extendScalars hM'K), hprod_ℓ.symm⟩
  have hne1_MM' : Module.finrank M (IntermediateField.extendScalars hMM') ≠ 1 := by
    intro h1
    have hle_FM' : Module.finrank F M' ≤ Module.finrank F M := by
      rw [← hmul_MM', h1, mul_one]
    have hM_eq_M' : M = M' := IntermediateField.eq_of_le_of_finrank_le hMM' hle_FM'
    exact hNotLe (hM_eq_M' ▸ hEM')
  have hFinMM'_eq : Module.finrank M (IntermediateField.extendScalars hMM') = ℓ :=
    ((Nat.dvd_prime hPrime).mp hdvd_MM').resolve_left hne1_MM'
  have h1_M'K : Module.finrank M' (IntermediateField.extendScalars hM'K) = 1 := by
    rw [hFinMM'_eq] at hprod_ℓ
    exact Nat.eq_of_mul_eq_mul_left hPrime.pos (hprod_ℓ.trans (mul_one ℓ).symm)
  have hle_FK : Module.finrank F K ≤ Module.finrank F M' := by
    rw [← hmul_M'K, h1_M'K, mul_one]
