      dsimp only [c_prod]
      rw [hlam_mul, h_conj_hk ⟨c_x, hc_x⟩, mul_comm]
    have hw₀_one : w₀.1 1 = 1 := by
      have h1 : (1 : G) = 1 * (1 : C).1 := by simp
      rw [h1, hw₀_eval 1 H.one_mem 1, hlam_one]
    have hw₀_mul : ∀ k₁ k₂ : M_lam, w₀.1 (k₁ * k₂).1 = w₀.1 k₁.1 * w₀.1 k₂.1 := by
      intro k₁ k₂
      have h_ev := congr_fun (congr_arg Subtype.val (h_tau_M k₂)) k₁.1
      change w₀.1 (k₁.1 * k₂.1) = w₀.1 k₂.1 * w₀.1 k₁.1 at h_ev
      rw [Subgroup.coe_mul, h_ev, mul_comm]
    let ψ_lam : M_lam →* (Ω F)ˣ :=
      { toFun := fun k =>
          { val := w₀.1 k.1
            inv := w₀.1 (k⁻¹).1
            val_inv := by rw [← hw₀_mul, mul_inv_cancel, Subgroup.coe_one, hw₀_one]
            inv_val := by rw [← hw₀_mul, inv_mul_cancel, Subgroup.coe_one, hw₀_one] }
