        have hM_sum_nonneg :
            0 ≤ ∑ r ∈ Finset.Icc 1 n, |valL F L (d r) - valL F L (d (n + 1))| :=
          Finset.sum_nonneg (fun r _ => abs_nonneg _)
        have hM_ge1 : 1 ≤ M := by
          dsimp only [M]
          linarith
        obtain ⟨u, hu_val⟩ := hvalL_surj (-M)
        let c : L := (u : L)
        have hc_ne0 : c ≠ 0 := Units.ne_zero u
