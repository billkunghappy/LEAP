    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    e_Δ (p - 1) = e_Δ₀ (p - 1) ∧
    (∀ (τ : M₁' ≃ₐ[F] M₁') (ψ_lift : K₁ ≃ₐ[F] K₁),
      (∀ y : E', ψ_lift (IntermediateField.inclusion hE'K₁ y) =
