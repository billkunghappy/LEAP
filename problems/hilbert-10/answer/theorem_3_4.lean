      have hz_v_ne : red z_v ≠ 0 := by
        intro h_red0
        apply hv_coord.2.2
        have hx_res : IsLocalRing.residue ↥A x_v = 0 := congrArg QuadraticAlgebra.re h_red0
        have hy_res : IsLocalRing.residue ↥A y_v = 0 := congrArg QuadraticAlgebra.im h_red0
        rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff] at hx_res hy_res
        exact ⟨hx_res, hy_res⟩
