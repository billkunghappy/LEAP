      · apply hv_W₂_a₄_lt
        intro h3n
        have he_dvd8 : 8 = e * (8 / e) := he_dvd8_id h3n
        apply hζ_km_ne
        calc ζ ^ (k * m) = ζ ^ (k * m) * (ζ ^ e) ^ ((8 / e) * k * m) := by
