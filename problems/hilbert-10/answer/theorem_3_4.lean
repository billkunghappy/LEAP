          WeierstrassCurve.Affine.negY, WeierstrassCurve.Affine.addX]
        rw [ha₁', ha₃']
        ring
      have hv_y₂_lt : v_val (y₂ - W₂'.negY x y) < 1 := by
        rw [hy₂_sub, map_mul, Valuation.map_neg]
        exact mul_lt_one_of_nonneg_of_lt_one_left (zero_le _) hv_L_lt (le_of_lt hv_x₂_lt)
      have hP₂_tors : ℓ • (WeierstrassCurve.Affine.Point.some h₂ : W₂'.Point) = 0 := by
        rw [← h2P₀_eq, nsmul_add, hP, add_zero]
      have h_double_eq_neg : P₀ + P₀ = -P₀ := by
        rw [h2P₀_eq, hP_neg_eq]
        exact h_inj h₂ h_neg hP₂_tors hP_neg_tors hv_x₂_lt hv_y₂_lt
      apply h3P₀
      have h3_eq : (3 : ℕ) • P₀ = (P₀ + P₀) + P₀ := by
        change (2 + 1) • P₀ = (P₀ + P₀) + P₀
        rw [add_nsmul, two_nsmul, one_nsmul]
      rw [h3_eq, h_double_eq_neg, neg_add_cancel]
  
  intro h_eq
  let T := EllipticRootNumber.tateModule F E
  let f₀ : T →ₗ[ℤ_[ℓ]] T := EllipticRootNumber.tateRep F E σ - LinearMap.id
  have hf₀_inj : Function.Injective f₀ := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, sub_eq_zero] at hx
    have hx_j : ∀ j : ℕ,
        EllipticRootNumber.galHom F E σ ((x.1 j : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) =
          ((x.1 j : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) := by
      intro j
      exact congrArg Subtype.val (congrFun (congrArg Subtype.val hx) j)
    have hx_zero : ∀ j : ℕ, ((x.1 j : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) = 0 := by
      intro j
      induction j with
      | zero =>
        exact h_fix ((x.1 0 : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E)
          (x.1 0).2 (hx_j 0)
      | succ j ih =>
        have h_mem : ((x.1 (j + 1) : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) ∈
            EllipticRootNumber.torsion F E (ℓ ^ (0 + 1)) := by
          rw [EllipticRootNumber.mem_torsion, zero_add, pow_one, x.2 j, ih]
        exact h_fix _ h_mem (hx_j (j + 1))
    exact Subtype.ext (funext fun j => Subtype.ext (hx_zero j))
  letI : AddCommGroup (EllipticRootNumber.VQ F E) := TensorProduct.addCommGroup
  letI : AddCommGroup (EllipticRootNumber.VBar F E) := TensorProduct.addCommGroup
  haveI : Module.Flat ℤ_[ℓ] ℚ_[ℓ] :=
    IsLocalization.flat ℚ_[ℓ] (nonZeroDivisors ℤ_[ℓ])
  let fQ : EllipticRootNumber.VQ F E →ₗ[ℚ_[ℓ]] EllipticRootNumber.VQ F E :=
    LinearMap.baseChange ℚ_[ℓ] f₀
  have hfQ_inj : Function.Injective fQ :=
    Module.Flat.lTensor_preserves_injective_linearMap f₀ hf₀_inj
  let fBar : EllipticRootNumber.VBar F E →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E :=
    LinearMap.baseChange (EllipticRootNumber.Ω F) fQ
  have hfBar_inj : Function.Injective fBar :=
    Module.Flat.lTensor_preserves_injective_linearMap fQ hfQ_inj
  have hfQ_add : fQ + LinearMap.id = LinearMap.baseChange ℚ_[ℓ] (EllipticRootNumber.tateRep F E σ) := by
    have h_id : (LinearMap.id : EllipticRootNumber.VQ F E →ₗ[ℚ_[ℓ]] EllipticRootNumber.VQ F E) =
        LinearMap.baseChange ℚ_[ℓ] (LinearMap.id : T →ₗ[ℤ_[ℓ]] T) :=
      (LinearMap.baseChange_id (R := ℤ_[ℓ]) (A := ℚ_[ℓ]) (M := T)).symm
    have h_add : LinearMap.baseChange ℚ_[ℓ] f₀ + LinearMap.baseChange ℚ_[ℓ] (LinearMap.id : T →ₗ[ℤ_[ℓ]] T) =
        LinearMap.baseChange ℚ_[ℓ] (f₀ + LinearMap.id) :=
      ((LinearMap.baseChangeHom ℤ_[ℓ] ℚ_[ℓ] T T).map_add f₀ LinearMap.id).symm
    have h_cancel : f₀ + LinearMap.id = EllipticRootNumber.tateRep F E σ :=
      sub_add_cancel (EllipticRootNumber.tateRep F E σ) LinearMap.id
    exact (congrArg (fQ + ·) h_id).trans (h_add.trans (congrArg (LinearMap.baseChange ℚ_[ℓ]) h_cancel))
  have hfBar_add : fBar + LinearMap.id = EllipticRootNumber.ellAdicRep F E σ := by
    have h_id : (LinearMap.id : EllipticRootNumber.VBar F E →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E) =
        LinearMap.baseChange (EllipticRootNumber.Ω F)
          (LinearMap.id : EllipticRootNumber.VQ F E →ₗ[ℚ_[ℓ]] EllipticRootNumber.VQ F E) :=
      (LinearMap.baseChange_id (R := ℚ_[ℓ]) (A := EllipticRootNumber.Ω F) (M := EllipticRootNumber.VQ F E)).symm
    have h_add : LinearMap.baseChange (EllipticRootNumber.Ω F) fQ +
          LinearMap.baseChange (EllipticRootNumber.Ω F)
            (LinearMap.id : EllipticRootNumber.VQ F E →ₗ[ℚ_[ℓ]] EllipticRootNumber.VQ F E) =
        LinearMap.baseChange (EllipticRootNumber.Ω F) (fQ + LinearMap.id) :=
      ((LinearMap.baseChangeHom ℚ_[ℓ] (EllipticRootNumber.Ω F)
        (EllipticRootNumber.VQ F E) (EllipticRootNumber.VQ F E)).map_add fQ LinearMap.id).symm
    exact (congrArg (fBar + ·) h_id).trans
      (h_add.trans (congrArg (LinearMap.baseChange (EllipticRootNumber.Ω F)) hfQ_add))
  have hfBar_v : fBar v = 0 := by
    have h1 : fBar v + v = v :=
      ((LinearMap.add_apply fBar LinearMap.id v).symm.trans (LinearMap.congr_fun hfBar_add v)).trans h_eq
    calc fBar v = (fBar v + v) - v := (add_sub_cancel_right (fBar v) v).symm
      _ = v - v := by rw [h1]
      _ = 0 := sub_self v
  exact hv (hfBar_inj (hfBar_v.trans (map_zero fBar).symm))

theorem ellAdicRep_dihedral_kummer_eigenbasis (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hdi : ¬ ((12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)))
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    [FiniteDimensional F H]
    (hH_sep : Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F)) (IntermediateField.extendScalars h))
    (hH_unr : H ≤ EllipticRootNumber.unramifiedClosure F)
    (hH_weil : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
        2 ∣ Multiplicative.toAdd
          (EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w)))
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hd_nonsq : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)))
    (h_valL_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a)
    (h_relVal_H : ∀ y : H, EllipticRootNumber.relVal F H y = 2 * EllipticRootNumber.valL F H y) :
    ∃ (M : IntermediateField F (AlgebraicClosure F))
      (h_HM : H ≤ M)
      (φ : EllipticRootNumber.relWeil F H →* (EllipticRootNumber.Ω F)ˣ)
      (w₀ : EllipticRootNumber.relWeil F ⊥)
      (v₁ : EllipticRootNumber.VBar F E),
      FiniteDimensional F M ∧
      EllipticRootNumber.IsAbelianExt F h_HM ∧
      EllipticRootNumber.IsWeilRep F H (EllipticRootNumber.charRep F H φ) ∧
      ¬ ((w₀ : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) ∧
      (∀ w : EllipticRootNumber.relWeil F H,
        ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
          (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w) v₁ =
            (φ w : EllipticRootNumber.Ω F) • v₁) ∧
      (∀ v : EllipticRootNumber.VBar F E, ∃! p : EllipticRootNumber.Ω F × EllipticRootNumber.Ω F,
        v = p.1 • v₁ + p.2 • ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w₀ v₁) ∧
      (∃ π : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (π : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
        IntermediateField.inclusion h (π : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
          Set.range (EllipticRootNumber.normLM F h_HM)) ∧
      (∀ u₁ ∈ EllipticRootNumber.unitGroup F H 1,
        (u₁ : H) ∈ Set.range (EllipticRootNumber.normLM F h_HM)) ∧
      (∀ w : EllipticRootNumber.relWeil F H,
        (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
          φ w = (-EllipticRootNumber.qUnit F) ^
            (Multiplicative.toAdd
              (EllipticRootNumber.weilDegreeHom F
                (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w)) / 2)) ∧
      (∀ w : EllipticRootNumber.relWeil F H,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
            φ w ^ (12 / Nat.gcd n 12) = 1) ∧
      (∃ w_in : EllipticRootNumber.relWeil F H,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w_in) = 1 ∧
        ∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 → φ w_in ^ k ≠ 1) :=
by
  classical
  have hΔ_ne : E.Δ ≠ 0 := by
    intro h0
    rw [EllipticRootNumber.addVal, dif_pos h0] at hΔ
    omega
  have hq_pos : 0 < EllipticRootNumber.q F := EllipticRootNumber.q_pos F
  have h2_dvd_q_sub_one : 2 ∣ (EllipticRootNumber.q F - 1) := by omega
  have hn_ne_6 : n ≠ 6 := by
    rintro rfl
    exact hdi h2_dvd_q_sub_one
  set e : ℕ := 12 / Nat.gcd n 12
  have he : e = 3 ∨ e = 4 ∨ e = 6 := by
    change 12 / Nat.gcd n 12 = 3 ∨ 12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6
    revert hn23 hn_ne_6
    interval_cases n <;> decide
  obtain ⟨π, ϖ, ζ, M, h_HM, τ₀, w₀, hπ_ne, hπ_val, hϖ_ne, hϖ_pow, hζ_pow, hζ_ord,
    hM_fin, hM_ab, hM_fix, h_unif_norm, h_u1_norm, hτ₀_in, hτ₀_deg, hτ₀_ζ, hτ₀_ϖ,
    hw₀_not_H, hw₀_deg, hw₀_sq_M, hw₀_τ₀, h_comm_τ₀, h_deg_zero_in⟩ :=
    exists_dihedral_kummer_extension F n hn0 hn12 hn23 hq2 hq3 hdi H h u d
      hH_unr hH_weil hu_sq hd_val hd_nonsq h_coord h_valL_coord
  haveI : FiniteDimensional F M := hM_fin
  let K := EllipticRootNumber.Ω F
  let V := EllipticRootNumber.VBar F E
  let σ : Representation K (EllipticRootNumber.relWeil F ⊥) V :=
    (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
  let ι_H := Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h)
  have hV_dim : Module.finrank K V = 2 := vBar_finrank_eq_two_of_delta_ne_zero F E hΔ_ne
  
  have h_det_nat : ∀ (g : EllipticRootNumber.AbsGal F) (m : ℕ),
      EllipticRootNumber.ActsAsFrobPow F g (m : ℤ) →
      LinearMap.det (EllipticRootNumber.ellAdicRep F E g) =
        (EllipticRootNumber.q F : K) ^ m := by
    intro g m h_frob
    rw [ellAdicRep_det_eq_algebraMap_tateRep_det F E g,
      tateRep_det_eq_q_pow_of_actsAsFrobPow_nat F E g m
        (tateRep_det_cyclotomic_spec F E hΔ_ne g) h_frob,
      map_natCast, map_natCast, Nat.cast_pow]
  have hσ_det : ∀ w : EllipticRootNumber.relWeil F ⊥,
      LinearMap.det (σ w) = (EllipticRootNumber.relNorm F ⊥ w : K) := by
    intro w
    obtain ⟨d_w, hd_frob, hd_norm⟩ := relNorm_eq_q_zpow_of_actsAsFrobPow F w
    rw [hd_norm]
    change LinearMap.det (EllipticRootNumber.ellAdicRep F E (w : EllipticRootNumber.AbsGal F)) =
      (EllipticRootNumber.q F : K) ^ d_w
    cases d_w with
    | ofNat m =>
      rw [Int.ofNat_eq_coe, zpow_natCast]
      exact h_det_nat (w : EllipticRootNumber.AbsGal F) m hd_frob
    | negSucc k =>
      set g := (w : EllipticRootNumber.AbsGal F)
      have h_frob_inv : EllipticRootNumber.ActsAsFrobPow F g⁻¹ ((k + 1 : ℕ) : ℤ) := by
        intro ζ' hζ'
        rcases hζ' with ⟨N, hN0, hpN, hζ'N⟩
        have h_inv_root : EllipticRootNumber.IsPrimeToPRootOfUnity F (g⁻¹ ζ') :=
          ⟨N, hN0, hpN, by rw [← map_pow, hζ'N, map_one]⟩
        have h1 := hd_frob (g⁻¹ ζ') h_inv_root
        have h2 : g (g⁻¹ ζ') = ζ' := AlgEquiv.apply_symm_apply g ζ'
        rw [h2] at h1
        have h_neg1 : (-Int.negSucc k).toNat = k + 1 := rfl
        have h_pos1 : (Int.negSucc k).toNat = 0 := rfl
        have h_neg2 : (-((k + 1 : ℕ) : ℤ)).toNat = 0 := by omega
        have h_pos2 : ((k + 1 : ℕ) : ℤ).toNat = k + 1 := Int.toNat_natCast (k + 1)
        rw [h_neg1, h_pos1] at h1
        rw [h_neg2, h_pos2]
        exact h1.symm
      have h_det_inv : LinearMap.det (EllipticRootNumber.ellAdicRep F E g⁻¹) =
          (EllipticRootNumber.q F : K) ^ (k + 1) :=
        h_det_nat g⁻¹ (k + 1) h_frob_inv
      have h_comp :
          EllipticRootNumber.ellAdicRep F E g ∘ₗ EllipticRootNumber.ellAdicRep F E g⁻¹ =
            LinearMap.id := by
        rw [← Module.End.mul_eq_comp, ← map_mul, mul_inv_cancel, map_one, Module.End.one_eq_id]
      have h_det_mul :
          LinearMap.det (EllipticRootNumber.ellAdicRep F E g) *
            LinearMap.det (EllipticRootNumber.ellAdicRep F E g⁻¹) = 1 := by
        rw [← LinearMap.det_comp, h_comp, LinearMap.det_id]
      rw [h_det_inv] at h_det_mul
      rw [zpow_negSucc]
      exact eq_inv_of_mul_eq_one_left h_det_mul
  have h_triv : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (w : EllipticRootNumber.AbsGal F) ϖ = ϖ →
      σ w = 1 :=
    fun w hw_in hw_fix =>
      ellAdicRep_inertia_eq_one_of_kummer_fix F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hΔ hj
        hq2 hq3 π ϖ hπ_ne hπ_val hϖ_ne hϖ_pow w hw_in hw_fix
  have hσ_triv_M : ∀ w : EllipticRootNumber.relWeil F H,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
      σ (ι_H w) = 1 := by
    intro w hwI hwM
    exact h_triv (ι_H w) hwI ((hM_fix w).mp hwM)
  have hσ_deg_zero_M : ∀ w : EllipticRootNumber.relWeil F H,
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
      (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
      σ (ι_H w) = 1 := by
    intro w hw_deg hwM
    exact hσ_triv_M w (h_deg_zero_in w hw_deg).1 hwM
  have hσ_dih : σ (w₀ * ι_H τ₀ * w₀⁻¹ * ι_H τ₀) = 1 :=
    h_triv _ hw₀_τ₀.1 hw₀_τ₀.2
  have hσ_comm_τ₀ : ∀ w : EllipticRootNumber.relWeil F H,
      σ (ι_H w * ι_H τ₀ * (ι_H w)⁻¹ * (ι_H τ₀)⁻¹) = 1 :=
    fun w => h_triv _ (h_comm_τ₀ w).1 (h_comm_τ₀ w).2
  have hσ_pow : ∀ w : EllipticRootNumber.relWeil F H,
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
      (σ (ι_H w)) ^ e = 1 := by
    intro w hw_deg
    rw [← map_pow, ← map_pow]
    exact h_triv (ι_H (w ^ e))
      (Subgroup.pow_mem (EllipticRootNumber.inertia F) (h_deg_zero_in w hw_deg).1 e)
      (h_deg_zero_in w hw_deg).2
  have hτ₀_ord : ∀ k : ℕ, k ∣ e → k < e → ∀ v : V, v ≠ 0 →
      ((σ (ι_H τ₀)) ^ k) v ≠ v := by
    intro k hk_dvd hk_lt v hv
    exact ellAdicRep_dihedral_generator_pow_ne_self F E n hn0 hn12 hn23 hΔ hj hq2 hq3
      π ϖ ζ (ι_H τ₀) hπ_ne hπ_val hϖ_ne hϖ_pow hτ₀_in hζ_pow hζ_ord hτ₀_ζ hτ₀_ϖ
      k hk_dvd hk_lt v hv
  
  have h_s5 : ∀ {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V),
      Module.finrank (EllipticRootNumber.Ω F) V = 2 →
      (∀ w : EllipticRootNumber.relWeil F H,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
        (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
        σ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w) = 1) →
      (∀ w : EllipticRootNumber.relWeil F H,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
        (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
        σ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w) = 1) →
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        LinearMap.det (σ w) = (EllipticRootNumber.relNorm F ⊥ w : EllipticRootNumber.Ω F)) →
      σ (w₀ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ *
        w₀⁻¹ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀) = 1 →
      (∀ w : EllipticRootNumber.relWeil F H,
        σ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w *
          Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ *
          (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w)⁻¹ *
          (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀)⁻¹) = 1) →
      (∀ w : EllipticRootNumber.relWeil F H,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
        (σ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w)) ^ e = 1) →
      (∀ k : ℕ, k ∣ e → k < e → ∀ v : V, v ≠ 0 →
        ((σ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀)) ^ k) v ≠ v) →
      ∃ (φ : EllipticRootNumber.relWeil F H →* (EllipticRootNumber.Ω F)ˣ) (v₁ : V),
        EllipticRootNumber.IsWeilRep F H (EllipticRootNumber.charRep F H φ) ∧
        (∀ w : EllipticRootNumber.relWeil F H,
          σ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w) v₁ =
            (φ w : EllipticRootNumber.Ω F) • v₁) ∧
        (∀ v : V, ∃! p : EllipticRootNumber.Ω F × EllipticRootNumber.Ω F,
          v = p.1 • v₁ + p.2 • σ w₀ v₁) ∧
        (∀ w : EllipticRootNumber.relWeil F H,
          (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
            φ w = (-EllipticRootNumber.qUnit F) ^
              (Multiplicative.toAdd
                (EllipticRootNumber.weilDegreeHom F
                  (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w)) / 2)) ∧
        (∀ w : EllipticRootNumber.relWeil F H,
          EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
              φ w ^ e = 1) ∧
        (∃ w_in : EllipticRootNumber.relWeil F H,
          EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w_in) = 1 ∧
          ∀ k : ℕ, k ∣ e → k < e → φ w_in ^ k ≠ 1) := by
    clear V σ hV_dim h_det_nat hσ_det h_triv hσ_triv_M hσ_deg_zero_M hσ_dih hσ_comm_τ₀ hσ_pow hτ₀_ord
    intro V _ _ σ hV_dim hσ_triv_M hσ_deg_zero_M hσ_det hσ_dih hσ_comm_τ₀ hσ_pow hτ₀_ord
    have hV_pos : 0 < Module.finrank K V := by rw [hV_dim]; omega
    haveI : FiniteDimensional K V := FiniteDimensional.of_finrank_pos hV_pos
    haveI : Nontrivial V := Module.nontrivial_of_finrank_pos hV_pos
    let T : Module.End K V := σ (ι_H τ₀)
    let S : Module.End K V := σ w₀
    obtain ⟨ξ, hξ_eig⟩ := Module.End.exists_eigenvalue T
    obtain ⟨v₁, hv₁_mem, hv₁_ne⟩ := hξ_eig.exists_hasEigenvector
    have hT_v₁ : T v₁ = ξ • v₁ := Module.End.mem_eigenspace_iff.mp hv₁_mem
    have hT_pow_v₁ : ∀ k : ℕ, (T ^ k) v₁ = (ξ ^ k) • v₁ := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ', Module.End.mul_apply, ih, map_smul, hT_v₁, smul_smul, pow_succ]
    have hTe : T ^ e = 1 := hσ_pow τ₀ hτ₀_deg
    have hξ_pow : ξ ^ e = 1 := by
      apply smul_left_injective K hv₁_ne
      dsimp only
      rw [← hT_pow_v₁ e, hTe, Module.End.one_apply, one_smul]
    have hξ_ord : ∀ k : ℕ, k ∣ e → k < e → ξ ^ k ≠ 1 := by
      intro k hk_dvd hk_lt h_eq
      apply hτ₀_ord k hk_dvd hk_lt v₁ hv₁_ne
      change (T ^ k) v₁ = v₁
      rw [hT_pow_v₁ k, h_eq, one_smul]
    have hξ_ne : ξ ^ (e - 1) ≠ ξ := by
      intro h_eq
      have he_split : e = (e - 1) + 1 := by rcases he with h3 | h4 | h6 <;> omega
      have hξ2 : ξ ^ 2 = 1 := by
        calc ξ ^ 2 = ξ * ξ := sq ξ
          _ = ξ ^ (e - 1) * ξ := by rw [h_eq]
          _ = ξ ^ ((e - 1) + 1) := (pow_succ ξ (e - 1)).symm
          _ = ξ ^ e := by rw [← he_split]
          _ = 1 := hξ_pow
      rcases he with h3 | h4 | h6
      · have hξ1 : ξ ^ 1 = 1 := by
          calc ξ ^ 1 = 1 * ξ := by rw [pow_one, one_mul]
            _ = ξ ^ 2 * ξ := by rw [hξ2]
            _ = ξ ^ 3 := (pow_succ ξ 2).symm
            _ = ξ ^ e := by rw [h3]
            _ = 1 := hξ_pow
        exact hξ_ord 1 (by rw [h3]; decide) (by rw [h3]; decide) hξ1
      · exact hξ_ord 2 (by rw [h4]; decide) (by rw [h4]; decide) hξ2
      · exact hξ_ord 2 (by rw [h6]; decide) (by rw [h6]; decide) hξ2
    let v₂ : V := S v₁
    have hv₂_ne : v₂ ≠ 0 := by
      intro h0
      change S v₁ = 0 at h0
      apply hv₁_ne
      calc v₁ = (1 : Module.End K V) v₁ := rfl
        _ = σ 1 v₁ := by rw [map_one]
        _ = σ (w₀⁻¹ * w₀) v₁ := by rw [inv_mul_cancel]
        _ = σ w₀⁻¹ (S v₁) := by rw [map_mul, Module.End.mul_apply]
        _ = σ w₀⁻¹ 0 := by rw [h0]
        _ = 0 := map_zero _
    have hTS : T * S = S * (T ^ (e - 1)) := by
      have he_split : e = (e - 1) + 1 := by rcases he with h3 | h4 | h6 <;> omega
      have hT_inv : T * (T ^ (e - 1)) = 1 := by
        rw [← pow_succ', ← he_split, hTe]
      have h_dih_expand : S * T * σ w₀⁻¹ * T = 1 := by
        calc S * T * σ w₀⁻¹ * T
          _ = σ (w₀ * ι_H τ₀ * w₀⁻¹ * ι_H τ₀) := by
            simp only [S, T, map_mul]
          _ = 1 := hσ_dih
      have hS_inv' : σ w₀⁻¹ * S = 1 := by
        rw [← map_mul, inv_mul_cancel, map_one]
      have hST : S * T = (T ^ (e - 1)) * S := by
        calc S * T
          _ = S * T * (σ w₀⁻¹ * S) := by rw [hS_inv', mul_one]
          _ = S * T * σ w₀⁻¹ * (T * (T ^ (e - 1))) * S := by rw [hT_inv]; noncomm_ring
          _ = (S * T * σ w₀⁻¹ * T) * (T ^ (e - 1)) * S := by noncomm_ring
          _ = 1 * (T ^ (e - 1)) * S := by rw [h_dih_expand]
          _ = (T ^ (e - 1)) * S := by rw [one_mul]
      calc T * S
        _ = T * S * (T * (T ^ (e - 1))) := by rw [hT_inv, mul_one]
        _ = T * (S * T) * (T ^ (e - 1)) := by noncomm_ring
        _ = T * ((T ^ (e - 1)) * S) * (T ^ (e - 1)) := by rw [hST]
        _ = (T * (T ^ (e - 1))) * S * (T ^ (e - 1)) := by noncomm_ring
        _ = 1 * S * (T ^ (e - 1)) := by rw [hT_inv]
        _ = S * (T ^ (e - 1)) := by rw [one_mul]
    have hT_v₂ : T v₂ = (ξ ^ (e - 1)) • v₂ := by
      change (T * S) v₁ = (ξ ^ (e - 1)) • (S v₁)
      rw [hTS, Module.End.mul_apply, hT_pow_v₁ (e - 1), map_smul]
    have h_li : LinearIndependent K ![v₁, v₂] := by
      rw [LinearIndependent.pair_iff]
      intro c₁ c₂ hc
      have hT_c : T (c₁ • v₁ + c₂ • v₂) = 0 := by rw [hc, map_zero]
      rw [map_add, map_smul, map_smul, hT_v₁, hT_v₂, smul_smul, smul_smul] at hT_c
      have h_sub : ((c₁ * ξ) • v₁ + (c₂ * ξ ^ (e - 1)) • v₂) -
          ξ • (c₁ • v₁ + c₂ • v₂) = 0 := by
        rw [hT_c, hc, smul_zero, sub_zero]
      rw [smul_add, smul_smul, smul_smul, mul_comm ξ c₁, mul_comm ξ c₂,
        add_sub_add_left_eq_sub, ← sub_smul] at h_sub
      have hc₂_mul : c₂ * (ξ ^ (e - 1) - ξ) = 0 := by
        have h_smul0 : (c₂ * (ξ ^ (e - 1) - ξ)) • v₂ = 0 := by
          rwa [mul_sub]
        exact (smul_eq_zero.mp h_smul0).resolve_right hv₂_ne
      have hc₂ : c₂ = 0 :=
        (mul_eq_zero.mp hc₂_mul).resolve_right (sub_ne_zero.mpr hξ_ne)
      rw [hc₂, zero_smul, add_zero] at hc
      have hc₁ : c₁ = 0 := (smul_eq_zero.mp hc).resolve_right hv₁_ne
      exact ⟨hc₁, hc₂⟩
    let B : Module.Basis (Fin 2) K V :=
      basisOfLinearIndependentOfCardEqFinrank h_li (by rw [Fintype.card_fin, hV_dim])
    have hB0 : B 0 = v₁ := by simp [B]
    have hB1 : B 1 = v₂ := by simp [B]
    have h_basis : ∀ v : V, ∃! p : K × K, v = p.1 • v₁ + p.2 • S v₁ := by
      intro v
      refine ⟨(B.repr v 0, B.repr v 1), ?_, ?_⟩
      · dsimp only
        have hv := (B.sum_repr v).symm
        rw [Fin.sum_univ_two, hB0, hB1] at hv
        exact hv
      · rintro ⟨c₁, c₂⟩ hv
        dsimp only at hv
        have h_repr : B.repr v = B.repr (c₁ • B 0 + c₂ • B 1) := by
          rw [hB0, hB1, ← hv]
        have h0 := congrFun (congrArg DFunLike.coe h_repr) 0
        have h1 := congrFun (congrArg DFunLike.coe h_repr) 1
        simp only [map_add, map_smul, Module.Basis.repr_self, Finsupp.smul_single,
          smul_eq_mul, mul_one, Finsupp.coe_add, Pi.add_apply,
          Finsupp.single_eq_same, Finsupp.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1),
          Finsupp.single_eq_of_ne (by decide : (1 : Fin 2) ≠ 0), add_zero, zero_add] at h0 h1
        exact Prod.ext h0.symm h1.symm
    have h_comm : ∀ w : EllipticRootNumber.relWeil F H,
        σ (ι_H w) * T = T * σ (ι_H w) := by
      intro w
      have h_c : σ (ι_H w) * T * σ (ι_H w)⁻¹ * σ (ι_H τ₀)⁻¹ = 1 := by
        calc σ (ι_H w) * T * σ (ι_H w)⁻¹ * σ (ι_H τ₀)⁻¹
          _ = σ (ι_H w * ι_H τ₀ * (ι_H w)⁻¹ * (ι_H τ₀)⁻¹) := by
            simp only [T, map_mul]
          _ = 1 := hσ_comm_τ₀ w
      have h1 : σ (ι_H w)⁻¹ * σ (ι_H w) = 1 := by
        rw [← map_mul, inv_mul_cancel, map_one]
      have h2 : σ (ι_H τ₀)⁻¹ * T = 1 := by
        change σ (ι_H τ₀)⁻¹ * σ (ι_H τ₀) = 1
        rw [← map_mul, inv_mul_cancel, map_one]
      calc σ (ι_H w) * T
        _ = σ (ι_H w) * T * (σ (ι_H w)⁻¹ * σ (ι_H w)) := by rw [h1, mul_one]
        _ = σ (ι_H w) * T * σ (ι_H w)⁻¹ * (σ (ι_H τ₀)⁻¹ * T) * σ (ι_H w) := by
          rw [h2]; noncomm_ring
        _ = (σ (ι_H w) * T * σ (ι_H w)⁻¹ * σ (ι_H τ₀)⁻¹) * (T * σ (ι_H w)) := by noncomm_ring
        _ = 1 * (T * σ (ι_H w)) := by rw [h_c]
        _ = T * σ (ι_H w) := by rw [one_mul]
    have h_eigen_w : ∀ w : EllipticRootNumber.relWeil F H,
        σ (ι_H w) v₁ = (B.repr (σ (ι_H w) v₁) 0) • v₁ := by
      intro w
      set a := B.repr (σ (ι_H w) v₁) 0
      set b := B.repr (σ (ι_H w) v₁) 1
      have hw_exp : σ (ι_H w) v₁ = a • v₁ + b • v₂ := by
        have hv := (B.sum_repr (σ (ι_H w) v₁)).symm
        rw [Fin.sum_univ_two, hB0, hB1] at hv
        exact hv
      have hTw1 : T (σ (ι_H w) v₁) = (ξ * a) • v₁ + (ξ ^ (e - 1) * b) • v₂ := by
        rw [hw_exp, map_add, map_smul, map_smul, hT_v₁, hT_v₂, smul_smul, smul_smul,
          mul_comm a ξ, mul_comm b (ξ ^ (e - 1))]
      have hTw2 : T (σ (ι_H w) v₁) = (ξ * a) • v₁ + (ξ * b) • v₂ := by
        have hc := LinearMap.congr_fun (h_comm w).symm v₁
        change T (σ (ι_H w) v₁) = σ (ι_H w) (T v₁) at hc
        rw [hc, hT_v₁, map_smul, hw_exp, smul_add, smul_smul, smul_smul]
      have h_eq : (ξ * a) • v₁ + (ξ ^ (e - 1) * b) • v₂ = (ξ * a) • v₁ + (ξ * b) • v₂ :=
        hTw1.symm.trans hTw2
      have hb_eq : (ξ ^ (e - 1) * b) • v₂ = (ξ * b) • v₂ := add_left_cancel h_eq
      have hb_sub : ((ξ ^ (e - 1) - ξ) * b) • v₂ = 0 := by
        rw [sub_mul, sub_smul, hb_eq, sub_self]
      have hb0 : b = 0 := by
        have h_mul0 : (ξ ^ (e - 1) - ξ) * b = 0 := (smul_eq_zero.mp hb_sub).resolve_right hv₂_ne
        exact (mul_eq_zero.mp h_mul0).resolve_left (sub_ne_zero.mpr hξ_ne)
      rw [hw_exp, hb0, zero_smul, add_zero]
    let a_fun : EllipticRootNumber.relWeil F H → K := fun w => B.repr (σ (ι_H w) v₁) 0
    have h_eigen_w' : ∀ w : EllipticRootNumber.relWeil F H,
        σ (ι_H w) v₁ = a_fun w • v₁ := h_eigen_w
    have ha_one : a_fun 1 = 1 := by
      apply smul_left_injective K hv₁_ne
      change a_fun 1 • v₁ = (1 : K) • v₁
      rw [← h_eigen_w' 1, map_one, map_one, Module.End.one_apply, one_smul]
    have ha_mul : ∀ w₁ w₂ : EllipticRootNumber.relWeil F H,
        a_fun (w₁ * w₂) = a_fun w₁ * a_fun w₂ := by
      intro w₁ w₂
      apply smul_left_injective K hv₁_ne
      change a_fun (w₁ * w₂) • v₁ = (a_fun w₁ * a_fun w₂) • v₁
      rw [← h_eigen_w' (w₁ * w₂), map_mul, map_mul, Module.End.mul_apply,
        h_eigen_w' w₂, map_smul, h_eigen_w' w₁, smul_smul, mul_comm]
    have ha_ne : ∀ w : EllipticRootNumber.relWeil F H, a_fun w ≠ 0 := by
      intro w h0
      have h_prod : a_fun w * a_fun w⁻¹ = 1 := by
        rw [← ha_mul, mul_inv_cancel, ha_one]
      rw [h0, zero_mul] at h_prod
      exact zero_ne_one h_prod
    let φ : EllipticRootNumber.relWeil F H →* Kˣ :=
      { toFun := fun w => Units.mk0 (a_fun w) (ha_ne w)
        map_one' := Units.ext ha_one
        map_mul' := fun w₁ w₂ => Units.ext (ha_mul w₁ w₂) }
    have hv₁_φ : ∀ w : EllipticRootNumber.relWeil F H,
        σ (ι_H w) v₁ = (φ w : K) • v₁ := h_eigen_w
    have hφ_eq_one_of_σ_eq_one : ∀ w : EllipticRootNumber.relWeil F H,
        σ (ι_H w) = 1 → φ w = 1 := by
      intro w hw
      apply Units.ext
      apply smul_left_injective K hv₁_ne
      dsimp only
      rw [← hv₁_φ w, hw, Module.End.one_apply, Units.val_one, one_smul]
    have hW_φ : EllipticRootNumber.IsWeilRep F H (EllipticRootNumber.charRep F H φ) := by
      refine ⟨inferInstance, ⟨(M.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)),
        IsOpen.mem_nhds M.fixingSubgroup_isOpen M.fixingSubgroup.one_mem, ?_⟩⟩
      intro w hwM hwI
      have hφ1 : φ w = 1 := hφ_eq_one_of_σ_eq_one w (hσ_triv_M w hwI hwM)
      apply LinearMap.ext
      intro x
      change (φ w : K) • x = x
      rw [hφ1, Units.val_one, one_smul]
    have hφ_pow_v₁ : ∀ (w : EllipticRootNumber.relWeil F H) (k : ℕ),
        ((σ (ι_H w)) ^ k) v₁ = ((φ w ^ k : Kˣ) : K) • v₁ := by
      intro w k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ', Module.End.mul_apply, ih, map_smul, hv₁_φ w, smul_smul,
          pow_succ, Units.val_mul]
    have hφ_pow : ∀ w : EllipticRootNumber.relWeil F H,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
        φ w ^ e = 1 := by
      intro w hw_deg
      apply Units.ext
      apply smul_left_injective K hv₁_ne
      dsimp only
      rw [← hφ_pow_v₁ w e, hσ_pow w hw_deg, Module.End.one_apply, Units.val_one, one_smul]
    have hφ_ord : ∃ w_in : EllipticRootNumber.relWeil F H,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w_in) = 1 ∧
        ∀ k : ℕ, k ∣ e → k < e → φ w_in ^ k ≠ 1 := by
      refine ⟨τ₀, hτ₀_deg, fun k hk_dvd hk_lt h_eq => ?_⟩
      apply hτ₀_ord k hk_dvd hk_lt v₁ hv₁_ne
      rw [hφ_pow_v₁ τ₀ k, h_eq, Units.val_one, one_smul]
    have hw₀_sq_deg : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) (w₀ ^ 2)) =
          Multiplicative.ofAdd (-2) := by
      rw [sq, map_mul, map_mul, hw₀_deg, ← ofAdd_add]
      rfl
    have hw₀_sq_H : ((w₀ ^ 2 : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
        H.fixingSubgroup := by
      rw [hH_weil (w₀ ^ 2), hw₀_sq_deg, toAdd_ofAdd]
      exact ⟨-1, rfl⟩
    let w_sq : EllipticRootNumber.relWeil F H :=
      ⟨(w₀ ^ 2 : EllipticRootNumber.AbsGal F), (w₀ ^ 2).2.1, hw₀_sq_H⟩
    have h_ι_w_sq : ι_H w_sq = w₀ ^ 2 := rfl
    have hS_B0 : S (B 0) = B 1 := by rw [hB0, hB1]
    have hS_B1 : S (B 1) = (φ w_sq : K) • B 0 := by
      rw [hB1, hB0]
      change (S * S) v₁ = (φ w_sq : K) • v₁
      rw [← sq, ← map_pow, ← h_ι_w_sq, hv₁_φ w_sq]
    have h_mat_00 : LinearMap.toMatrix B B S 0 0 = 0 := by
      rw [LinearMap.toMatrix_apply, hS_B0, B.repr_self,
        Finsupp.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1)]
    have h_mat_10 : LinearMap.toMatrix B B S 1 0 = 1 := by
      rw [LinearMap.toMatrix_apply, hS_B0, B.repr_self, Finsupp.single_eq_same]
    have h_mat_01 : LinearMap.toMatrix B B S 0 1 = (φ w_sq : K) := by
      rw [LinearMap.toMatrix_apply, hS_B1, map_smul, B.repr_self,
        Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.single_eq_same]
    have h_mat_11 : LinearMap.toMatrix B B S 1 1 = 0 := by
      rw [LinearMap.toMatrix_apply, hS_B1, map_smul, B.repr_self,
        Finsupp.smul_single, Finsupp.single_eq_of_ne (by decide : (1 : Fin 2) ≠ 0)]
    have h_det_S : LinearMap.det S = -(φ w_sq : K) := by
      rw [← LinearMap.det_toMatrix B S, Matrix.det_fin_two,
        h_mat_00, h_mat_10, h_mat_01, h_mat_11]
      ring
    have h_norm_w₀ : (EllipticRootNumber.relNorm F ⊥ w₀ : K) =
        ((EllipticRootNumber.qUnit F)⁻¹ : K) := by
      unfold EllipticRootNumber.relNorm EllipticRootNumber.weilNormHom
      simp only [MonoidHom.comp_apply, hw₀_deg, zpowersHom_apply, toAdd_ofAdd,
        zpow_neg, zpow_one, Units.val_inv_eq_inv_val]
    have hφ_w_sq : φ w_sq = (-EllipticRootNumber.qUnit F)⁻¹ := by
      apply Units.ext
      have h1 : -(φ w_sq : K) = ((EllipticRootNumber.qUnit F)⁻¹ : K) := by
        rw [← h_det_S, hσ_det w₀, h_norm_w₀]
      have h2 : (φ w_sq : K) = -((EllipticRootNumber.qUnit F)⁻¹ : K) := by
        linear_combination -h1
      have h3 : (((-EllipticRootNumber.qUnit F)⁻¹ : Kˣ) : K) =
          -((EllipticRootNumber.qUnit F)⁻¹ : K) := by
        have h_mul : (-(EllipticRootNumber.qUnit F : K)) *
            (-((EllipticRootNumber.qUnit F)⁻¹ : K)) = 1 := by
          rw [neg_mul_neg, ← Units.val_inv_eq_inv_val, Units.mul_inv]
        exact Units.inv_eq_of_mul_eq_one_right h_mul
      rw [h2, h3]
    have hφ_fix : ∀ w : EllipticRootNumber.relWeil F H,
        (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
        φ w = (-EllipticRootNumber.qUnit F) ^
          (Multiplicative.toAdd
            (EllipticRootNumber.weilDegreeHom F
              (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w)) / 2) := by
      intro w hw_M
      let deg_H : EllipticRootNumber.relWeil F H →* Multiplicative ℤ :=
        (EllipticRootNumber.weilDegreeHom F).comp
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H))
      set d_w : ℤ := Multiplicative.toAdd (deg_H w)
      have hd_even : 2 ∣ d_w := (hH_weil (ι_H w)).mp w.2.2
      set k : ℤ := d_w / 2
      have hdw_eq : d_w = 2 * k := (Int.mul_ediv_cancel' hd_even).symm
      let δ : EllipticRootNumber.relWeil F H := w_sq ^ k * w
      have hδ_M : (δ : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup := by
        exact M.fixingSubgroup.mul_mem (M.fixingSubgroup.zpow_mem hw₀_sq_M k) hw_M
      have h_deg_w_sq : deg_H w_sq = Multiplicative.ofAdd (-2) := hw₀_sq_deg
      have hδ_deg : EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) δ) = 1 := by
        change deg_H (w_sq ^ k * w) = 1
        rw [map_mul, map_zpow, h_deg_w_sq]
        apply Multiplicative.toAdd.injective
        rw [toAdd_mul, toAdd_zpow, toAdd_ofAdd, toAdd_one]
        change k * (-2) + d_w = 0
        rw [hdw_eq]
        ring
      have hφ_δ : φ δ = 1 := hφ_eq_one_of_σ_eq_one δ (hσ_deg_zero_M δ hδ_deg hδ_M)
      have hφ_w_eq : φ w = (φ w_sq ^ k)⁻¹ := by
        apply eq_inv_of_mul_eq_one_right
        rw [← map_zpow, ← map_mul]
        exact hφ_δ
      rw [hφ_w_eq, hφ_w_sq, inv_zpow, inv_inv]
      rfl
    exact ⟨φ, v₁, hW_φ, hv₁_φ, h_basis, hφ_fix, hφ_pow, hφ_ord⟩
  obtain ⟨φ, v₁, hW_φ, hv₁_φ, h_basis, hφ_fix, hφ_pow, hφ_ord⟩ :=
    h_s5 σ hV_dim hσ_triv_M hσ_deg_zero_M hσ_det hσ_dih hσ_comm_τ₀ hσ_pow hτ₀_ord
  exact ⟨M, h_HM, φ, w₀, v₁, hM_fin, hM_ab, hW_φ, hw₀_not_H, hv₁_φ, h_basis,
    h_unif_norm, h_u1_norm, hφ_fix, hφ_pow, hφ_ord⟩

theorem dihedral_reciprocity_char_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hdi : ¬ ((12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)))
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    [FiniteDimensional F H]
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hd_nonsq : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)))
    (h_valL_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a)
    (h_relVal_H : ∀ y : H, EllipticRootNumber.relVal F H y = 2 * EllipticRootNumber.valL F H y)
    (M : IntermediateField F (AlgebraicClosure F))
    (h_HM : H ≤ M) [FiniteDimensional F M]
    (h_ab : EllipticRootNumber.IsAbelianExt F h_HM)
    (φ : EllipticRootNumber.relWeil F H →* (EllipticRootNumber.Ω F)ˣ)
    (h_unif_norm : ∃ π : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (π : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
      IntermediateField.inclusion h (π : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
        Set.range (EllipticRootNumber.normLM F h_HM))
    (h_u1_norm : ∀ u₁ ∈ EllipticRootNumber.unitGroup F H 1,
      (u₁ : H) ∈ Set.range (EllipticRootNumber.normLM F h_HM))
    (hφ_fix : ∀ w : EllipticRootNumber.relWeil F H,
      (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
        φ w = (-EllipticRootNumber.qUnit F) ^
          (Multiplicative.toAdd
            (EllipticRootNumber.weilDegreeHom F
              (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w)) / 2))
    (hφ_pow : ∀ w : EllipticRootNumber.relWeil F H,
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
          φ w ^ (12 / Nat.gcd n 12) = 1)
    (hφ_ord : ∃ w_in : EllipticRootNumber.relWeil F H,
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w_in) = 1 ∧
      ∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 → φ w_in ^ k ≠ 1)
    (rec : EllipticRootNumber.LocalReciprocity F) :
    ∃ (φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ),
      (∀ x : Hˣ, φ' x = φ (rec.recMap H x)) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        φ' (Units.map (IntermediateField.inclusion h).toMonoidHom x) =
          (-EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) ∧
      EllipticRootNumber.condExp F H φ' = 1 ∧
      (∀ v ∈ EllipticRootNumber.unitGroup F H 0, φ' v ^ (12 / Nat.gcd n 12) = 1) ∧
      (∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 →
        ∃ v ∈ EllipticRootNumber.unitGroup F H 0, φ' v ^ k ≠ 1) :=
by
  open ValuativeRel in
  (
    let e_bot : (⊥ : IntermediateField F (AlgebraicClosure F)) ≃ₐ[F] F :=
      IntermediateField.botEquiv F (AlgebraicClosure F)
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have h_ne_val : ∀ x : F, x ≠ 0 → iso (ValuativeRel.valuation F x) ≠ 0 := by
      intro x hx
      exact (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hx)
    have h_addVal_eq : ∀ (x : F) (m : ℤ),
        iso (ValuativeRel.valuation F x) = WithZero.exp m →
        EllipticRootNumber.addVal F x = -m := by
      intro x m hxm
      have hx : x ≠ 0 := by
        intro h0
        rw [h0, Valuation.map_zero, map_zero] at hxm
        exact WithZero.exp_ne_zero hxm.symm
      unfold EllipticRootNumber.addVal
      rw [dif_neg hx]
      have hunz : WithZero.unzero (h_ne_val x hx) = Multiplicative.ofAdd m := by
        apply WithZero.coe_inj.mp
        rw [WithZero.coe_unzero, hxm]
        rfl
      rw [hunz, toAdd_ofAdd]
    have h_addVal_one : EllipticRootNumber.addVal F 1 = 0 := by
      have h1 : iso (ValuativeRel.valuation F 1) = WithZero.exp (0 : ℤ) := by
        rw [Valuation.map_one, map_one, WithZero.exp_zero]
      simpa using h_addVal_eq 1 0 h1
    have h_addVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 →
        EllipticRootNumber.addVal F (a * b) =
          EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      unfold EllipticRootNumber.addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz_mul : WithZero.unzero (h_ne_val (a * b) hab) =
          WithZero.unzero (h_ne_val a ha) * WithZero.unzero (h_ne_val b hb) := by
        apply WithZero.coe_inj.mp
        rw [WithZero.coe_unzero, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
          Valuation.map_mul, map_mul]
      rw [hunz_mul, toAdd_mul]
      omega
    obtain ⟨π₀, hπ₀_val⟩ :=
      ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
    have hπ₀_iso : iso (ValuativeRel.valuation F π₀) = WithZero.exp (-1 : ℤ) := by
      rw [hπ₀_val, OrderMonoidIso.apply_symm_apply]
    have hπ₀_ne : π₀ ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero, map_zero] at hπ₀_iso
      exact WithZero.exp_ne_zero hπ₀_iso.symm
    have hπ₀_addVal : EllipticRootNumber.addVal F π₀ = 1 := by
      simpa using h_addVal_eq π₀ (-1) hπ₀_iso
    have h_relVal_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.relVal
      have hnorm : Algebra.norm F x = e_bot x := by
        rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
        rfl
      rw [hnorm]
    have h_resDeg_bot : EllipticRootNumber.resDeg F ⊥ = 1 := by
      unfold EllipticRootNumber.resDeg
      apply IsLeast.csInf_eq
      refine ⟨⟨by omega, e_bot.symm π₀, ?_, ?_⟩, ?_⟩
      · exact (map_ne_zero e_bot.symm).mpr hπ₀_ne
      · rw [h_relVal_bot, AlgEquiv.apply_symm_apply, hπ₀_addVal]
        rfl
      · rintro k ⟨hk, _⟩
        exact hk
    have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.valL
      rw [h_resDeg_bot, Nat.cast_one, Int.ediv_one, h_relVal_bot]
    have h_addVal_zero_iff : ∀ y : F, y ≠ 0 →
        (EllipticRootNumber.addVal F y = 0 ↔ ValuativeRel.valuation F y = 1) := by
      intro y hy
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      have h_val_one : ValuativeRel.valuation F y = 1 ↔ Multiplicative.toAdd z = 0 := by
        rw [← EmbeddingLike.apply_eq_iff_eq iso, hz_eq, map_one, ← WithZero.exp_zero,
          WithZero.exp_injective.eq_iff]
      rw [h_val_one]
      omega
    have h_addVal_nonneg : ∀ y : F,
        0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
      intro y
      by_cases hy : y = 0
      · subst hy
        unfold EllipticRootNumber.addVal
        rw [dif_pos rfl, Valuation.map_zero]
        exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
      · unfold EllipticRootNumber.addVal
        rw [dif_neg hy]
        have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
        have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
        set z := WithZero.unzero hiso_ne
        have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
          rw [← WithZero.coe_unzero hiso_ne]
          rfl
        rw [← map_le_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
        omega
    have h_addVal_pos : ∀ y : F,
        (y = 0 ∨ 1 ≤ EllipticRootNumber.addVal F y) ↔ ValuativeRel.valuation F y < 1 := by
      intro y
      by_cases hy : y = 0
      · subst hy
        rw [Valuation.map_zero]
        exact ⟨fun _ => zero_lt_one, fun _ => Or.inl rfl⟩
      · rw [or_iff_right hy]
        unfold EllipticRootNumber.addVal
        rw [dif_neg hy]
        have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
        have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
        set z := WithZero.unzero hiso_ne
        have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
          rw [← WithZero.coe_unzero hiso_ne]
          rfl
        rw [← map_lt_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
        omega
    have h_coord₀ : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
        (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) ≠ 0 ∧
          EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 0) ↔
        (ValuativeRel.valuation F (e_bot a) ≤ 1 ∧
          ValuativeRel.valuation F (e_bot b) ≤ 1 ∧
          ¬ (ValuativeRel.valuation F (e_bot a) < 1 ∧ ValuativeRel.valuation F (e_bot b) < 1)) := by
      intro a b
      set w := IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)
      have hw_iff : (w ≠ 0 ∧ EllipticRootNumber.valL F H w = 0) ↔
          (0 ≤ EllipticRootNumber.valL F H w ∧ ¬ (w = 0 ∨ 1 ≤ EllipticRootNumber.valL F H w)) := by
        constructor
        · rintro ⟨hne, h0⟩
          refine ⟨by omega, ?_⟩
          rintro (hw0 | h1)
          · exact hne hw0
          · omega
        · rintro ⟨h0, hnot⟩
          push_neg at hnot
          exact ⟨hnot.1, by omega⟩
      rw [hw_iff, (h_valL_coord a b).1, (h_valL_coord a b).2,
        h_valL a, h_valL b, h_addVal_nonneg, h_addVal_nonneg,
        ← map_eq_zero e_bot, ← map_eq_zero e_bot, h_addVal_pos, h_addVal_pos, and_assoc]
    have h_mem₁ : ∀ (v : Hˣ) (a b : (⊥ : IntermediateField F (AlgebraicClosure F))),
        (v : H) = IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) →
        ValuativeRel.valuation F (e_bot a - 1) < 1 →
        ValuativeRel.valuation F (e_bot b) < 1 →
        v ∈ EllipticRootNumber.unitGroup F H 1 := by
      intro v a b hv_eq ha_lt hb_lt
      unfold EllipticRootNumber.unitGroup
      apply Subgroup.subset_closure
      rw [Set.mem_setOf_eq, if_neg Nat.one_ne_zero]
      have hv_sub : (v : H) - 1 =
          IntermediateField.inclusion h (a - 1) + IntermediateField.inclusion h b * (u : H) := by
        rw [hv_eq, map_sub, map_one]
        ring
      have h_or : (v : H) - 1 = 0 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1) := by
        rw [hv_sub, (h_valL_coord (a - 1) b).2, h_valL (a - 1), h_valL b,
          ← map_eq_zero e_bot, ← map_eq_zero e_bot, h_addVal_pos, h_addVal_pos,
          map_sub, map_one]
        exact ⟨ha_lt, hb_lt⟩
      rcases h_or with h0 | h1
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr (by exact_mod_cast h1)
    
    let N_H : Hˣ →* Fˣ := Units.map (Algebra.norm F)
    have h_norm_ne : ∀ x : Hˣ, Algebra.norm F (x : H) ≠ 0 := by
      intro x
      exact Units.ne_zero (N_H x)
    have h_valL_H_one : EllipticRootNumber.valL F H ((1 : Hˣ) : H) = 0 := by
      have h_rel : EllipticRootNumber.relVal F H ((1 : Hˣ) : H) = 0 := by
        unfold EllipticRootNumber.relVal
        rw [Units.val_one, map_one, h_addVal_one]
      have := h_relVal_H ((1 : Hˣ) : H)
      omega
    have h_valL_H_mul : ∀ x y : Hˣ,
        EllipticRootNumber.valL F H ((x * y : Hˣ) : H) =
          EllipticRootNumber.valL F H (x : H) + EllipticRootNumber.valL F H (y : H) := by
      intro x y
      have h_rel : EllipticRootNumber.relVal F H ((x * y : Hˣ) : H) =
          EllipticRootNumber.relVal F H (x : H) + EllipticRootNumber.relVal F H (y : H) := by
        unfold EllipticRootNumber.relVal
        rw [Units.val_mul, map_mul, h_addVal_mul _ _ (h_norm_ne x) (h_norm_ne y)]
      have hxy := h_relVal_H ((x * y : Hˣ) : H)
      have hx := h_relVal_H (x : H)
      have hy := h_relVal_H (y : H)
      omega
    let vH_hom : Hˣ →* Multiplicative ℤ :=
      { toFun := fun x => Multiplicative.ofAdd (EllipticRootNumber.valL F H (x : H))
        map_one' := by rw [h_valL_H_one, ofAdd_zero]
        map_mul' := fun x y => by rw [h_valL_H_mul, ofAdd_add] }
    have h_valL_H_zpow : ∀ (x : Hˣ) (m : ℤ),
        EllipticRootNumber.valL F H ((x ^ m : Hˣ) : H) =
          m * EllipticRootNumber.valL F H (x : H) := by
      intro x m
      have h_eq := congrArg Multiplicative.toAdd (map_zpow vH_hom x m)
      simpa [vH_hom, toAdd_zpow] using h_eq
    have h_unit0_eq : EllipticRootNumber.unitGroup F H 0 = vH_hom.ker := by
      unfold EllipticRootNumber.unitGroup
      have hset : {v : Hˣ |
          if (0 : ℕ) = 0 then EllipticRootNumber.valL F H (v : H) = 0
          else ((v : H) = 1 ∨ ((0 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F H ((v : H) - 1))} =
          (vH_hom.ker : Set Hˣ) := by
        ext v
        simp [vH_hom, MonoidHom.mem_ker]
      rw [hset, Subgroup.closure_eq]
    have h_unit0 : ∀ v : Hˣ,
        v ∈ EllipticRootNumber.unitGroup F H 0 ↔ EllipticRootNumber.valL F H (v : H) = 0 := by
      intro v
      rw [h_unit0_eq, MonoidHom.mem_ker]
      simp [vH_hom]
    have h_unit1_val0 : ∀ u₁ ∈ EllipticRootNumber.unitGroup F H 1,
        EllipticRootNumber.valL F H (u₁ : H) = 0 := by
      have h_le : EllipticRootNumber.unitGroup F H 1 ≤ EllipticRootNumber.unitGroup F H 0 := by
        rw [h_unit0_eq]
        unfold EllipticRootNumber.unitGroup
        apply (Subgroup.closure_le vH_hom.ker).mpr
        intro u₁ hu₁
        rw [Set.mem_setOf_eq, if_neg Nat.one_ne_zero] at hu₁
        rw [ SetLike.mem_coe, MonoidHom.mem_ker]
        change Multiplicative.ofAdd (EllipticRootNumber.valL F H (u₁ : H)) = 1
        rw [ofAdd_eq_one]
        rcases hu₁ with hu₁_eq1 | hu₁_ge1
        · have hu₁_one : u₁ = 1 := Units.ext hu₁_eq1
          rw [hu₁_one, h_valL_H_one]
        · obtain ⟨⟨a, b⟩, hab⟩ := (h_coord ((u₁ : H) - 1)).exists
          dsimp only at hab
          have hab_lt : ValuativeRel.valuation F (e_bot a) < 1 ∧
              ValuativeRel.valuation F (e_bot b) < 1 := by
            have h_or : IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
                1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) := by
              right
              rw [← hab]
              exact_mod_cast hu₁_ge1
            rw [(h_valL_coord a b).2, h_valL a, h_valL b,
              ← map_eq_zero e_bot, ← map_eq_zero e_bot, h_addVal_pos, h_addVal_pos] at h_or
            exact h_or
          have ha1_val : ValuativeRel.valuation F (e_bot (a + 1)) = 1 := by
            rw [map_add, map_one,
              Valuation.map_add_eq_of_lt_right _ (by rw [Valuation.map_one]; exact hab_lt.1),
              Valuation.map_one]
          have hu₁_ab : (u₁ : H) =
              IntermediateField.inclusion h (a + 1) + IntermediateField.inclusion h b * (u : H) := by
            calc (u₁ : H) = ((u₁ : H) - 1) + 1 := by ring
              _ = (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) + 1 := by rw [hab]
              _ = IntermediateField.inclusion h (a + 1) + IntermediateField.inclusion h b * (u : H) := by
                rw [map_add, map_one]
                ring
          have h_val0 := (h_coord₀ (a + 1) b).mpr
            ⟨le_of_eq ha1_val, le_of_lt hab_lt.2, fun ⟨h1, _⟩ => ne_of_lt h1 ha1_val⟩
          rw [← hu₁_ab] at h_val0
          exact h_val0.2
      intro u₁ hu₁
      exact (h_unit0 u₁).mp (h_le hu₁)
    let ι : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* Hˣ :=
      Units.map (IntermediateField.inclusion h).toMonoidHom
    have h_valL_bot_mul : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥
          ((x * y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) =
          EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) +
            EllipticRootNumber.valL F ⊥ (y : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
      intro x y
      rw [← h_valL_inc, ← h_valL_inc x, ← h_valL_inc y]
      exact h_valL_H_mul (ι x) (ι y)
    have h_valL_bot_zpow : ∀ (x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) (m : ℤ),
        EllipticRootNumber.valL F ⊥
          ((x ^ m : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) =
          m * EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
      intro x m
      rw [← h_valL_inc, ← h_valL_inc x]
      have h_map : ((ι x ^ m : Hˣ) : H) =
          IntermediateField.inclusion h ((x ^ m : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) := by
        rw [← map_zpow ι x m]
        rfl
      rw [← h_map]
      exact h_valL_H_zpow (ι x) m
    
    let degH : EllipticRootNumber.relWeil F H →* Multiplicative ℤ :=
      (EllipticRootNumber.weilDegreeHom F).comp
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H))
    have h_degH_rec : ∀ x : Hˣ,
        degH (rec.recMap H x) =
          Multiplicative.ofAdd (-(2 * EllipticRootNumber.valL F H (x : H))) := by
      intro x
      change EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) (rec.recMap H x)) = _
      rw [rec.degree_rec H x, h_relVal_H (x : H)]
    have hφ_mul : ∀ x y : Hˣ,
        φ (rec.recMap H (x * y)) = φ (rec.recMap H x) * φ (rec.recMap H y) := by
      intro x y
      let δ : EllipticRootNumber.relWeil F H :=
        (rec.recMap H (x * y))⁻¹ * (rec.recMap H x * rec.recMap H y)
      have hδ_M : (δ : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
        rec.mul_rec H M h_HM h_ab x y
      have hδ_deg1 : degH δ = 1 := by
        dsimp only [δ]
        rw [map_mul, map_inv, map_mul, h_degH_rec (x * y), h_degH_rec x, h_degH_rec y,
          h_valL_H_mul x y, ← ofAdd_neg, ← ofAdd_add, ← ofAdd_add]
        have h0 : - -(2 * (EllipticRootNumber.valL F H (x : H) + EllipticRootNumber.valL F H (y : H))) +
            (-(2 * EllipticRootNumber.valL F H (x : H)) + -(2 * EllipticRootNumber.valL F H (y : H))) = 0 := by
          omega
        rw [h0, ofAdd_zero]
      have hδ_deg : Multiplicative.toAdd (degH δ) = 0 := by
        rw [hδ_deg1, toAdd_one]
      have hδ_φ := hφ_fix δ hδ_M
      change φ δ = (-EllipticRootNumber.qUnit F) ^ (Multiplicative.toAdd (degH δ) / 2) at hδ_φ
      rw [hδ_deg] at hδ_φ
      norm_num at hδ_φ
      dsimp only [δ] at hδ_φ
      rw [map_mul, map_inv, map_mul] at hδ_φ
      exact inv_mul_eq_one.mp hδ_φ
    let φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ :=
      { toFun := fun x => φ (rec.recMap H x)
        map_one' := by
          have h1 := hφ_mul 1 1
          rw [mul_one] at h1
          calc φ (rec.recMap H 1)
              = (φ (rec.recMap H 1))⁻¹ * (φ (rec.recMap H 1) * φ (rec.recMap H 1)) := by group
            _ = (φ (rec.recMap H 1))⁻¹ * φ (rec.recMap H 1) := by rw [← h1]
            _ = 1 := inv_mul_cancel _
        map_mul' := hφ_mul }
    have hφ'_rec : ∀ x : Hˣ, φ' x = φ (rec.recMap H x) := fun _ => rfl
    obtain ⟨π, hπ_val, hπ_norm⟩ := h_unif_norm
    let π_H : Hˣ := ι π
    have hπ_H_val : EllipticRootNumber.valL F H (π_H : H) = 1 := by
      change EllipticRootNumber.valL F H (IntermediateField.inclusion h (π : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1
      rw [h_valL_inc, hπ_val]
    have hφ'_π : φ' π_H = (-EllipticRootNumber.qUnit F)⁻¹ := by
      have h_M : (rec.recMap H π_H : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
        (rec.ker_rec H M h_HM h_ab π_H).mpr hπ_norm
      have h_deg : Multiplicative.toAdd (degH (rec.recMap H π_H)) = -2 := by
        rw [h_degH_rec π_H, hπ_H_val, toAdd_ofAdd]
        ring
      have h_fix := hφ_fix (rec.recMap H π_H) h_M
      change φ (rec.recMap H π_H) =
        (-EllipticRootNumber.qUnit F) ^ (Multiplicative.toAdd (degH (rec.recMap H π_H)) / 2) at h_fix
      rw [hφ'_rec, h_fix, h_deg]
      have h_div : (-2 : ℤ) / 2 = -1 := by decide
      rw [h_div, zpow_neg_one]
    have h_pow : ∀ v ∈ EllipticRootNumber.unitGroup F H 0,
        φ' v ^ (12 / Nat.gcd n 12) = 1 := by
      intro v hv
      rw [hφ'_rec]
      apply hφ_pow (rec.recMap H v)
      change degH (rec.recMap H v) = 1
      rw [h_degH_rec v, (h_unit0 v).mp hv, mul_zero, neg_zero, ofAdd_zero]
    have h_triv₁ : ∀ u₁ ∈ EllipticRootNumber.unitGroup F H 1, φ' u₁ = 1 := by
      intro u₁ hu₁
      have h_M : (rec.recMap H u₁ : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
        (rec.ker_rec H M h_HM h_ab u₁).mpr (h_u1_norm u₁ hu₁)
      have h_deg : Multiplicative.toAdd (degH (rec.recMap H u₁)) = 0 := by
        rw [h_degH_rec u₁, h_unit1_val0 u₁ hu₁, mul_zero, neg_zero, toAdd_ofAdd]
      have h_fix := hφ_fix (rec.recMap H u₁) h_M
      change φ (rec.recMap H u₁) =
        (-EllipticRootNumber.qUnit F) ^ (Multiplicative.toAdd (degH (rec.recMap H u₁)) / 2) at h_fix
      rw [hφ'_rec, h_fix, h_deg]
      norm_num
    obtain ⟨w_in, hw_in_deg, hw_in_ord⟩ := hφ_ord
    obtain ⟨x₀, hx₀_M⟩ := rec.surj_rec H M h_HM h_ab w_in
    let m_x₀ : ℤ := EllipticRootNumber.valL F H (x₀ : H)
    let v₀ : Hˣ := x₀ * π_H ^ (-m_x₀)
    have hv₀_val : EllipticRootNumber.valL F H (v₀ : H) = 0 := by
      rw [h_valL_H_mul x₀ (π_H ^ (-m_x₀)), h_valL_H_zpow π_H (-m_x₀), hπ_H_val]
      change m_x₀ + -m_x₀ * 1 = 0
      omega
    have hv₀_mem0 : v₀ ∈ EllipticRootNumber.unitGroup F H 0 := (h_unit0 v₀).mpr hv₀_val
    have hφ'_v₀ : φ' v₀ = φ w_in := by
      let δ₀ : EllipticRootNumber.relWeil F H := (rec.recMap H x₀)⁻¹ * w_in
      have hδ₀_deg : Multiplicative.toAdd (degH δ₀) = 2 * m_x₀ := by
        dsimp only [δ₀]
        have hw_deg : degH w_in = 1 := hw_in_deg
        rw [map_mul, map_inv, h_degH_rec x₀, hw_deg, mul_one, toAdd_inv, toAdd_ofAdd, neg_neg]
      have hδ₀_φ := hφ_fix δ₀ hx₀_M
      change φ δ₀ = (-EllipticRootNumber.qUnit F) ^ (Multiplicative.toAdd (degH δ₀) / 2) at hδ₀_φ
      have h_div : (2 * m_x₀) / 2 = m_x₀ := by omega
      rw [hδ₀_deg, h_div] at hδ₀_φ
      dsimp only [δ₀] at hδ₀_φ
      rw [map_mul, map_inv, ← hφ'_rec x₀] at hδ₀_φ
      have h_w_in : φ w_in = φ' x₀ * (-EllipticRootNumber.qUnit F) ^ m_x₀ := by
        calc φ w_in = φ' x₀ * ((φ' x₀)⁻¹ * φ w_in) := by group
          _ = φ' x₀ * (-EllipticRootNumber.qUnit F) ^ m_x₀ := by rw [hδ₀_φ]
      dsimp only [v₀]
      rw [map_mul, map_zpow, hφ'_π, inv_zpow', neg_neg, ← h_w_in]
    have h_ord : ∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 →
        ∃ v ∈ EllipticRootNumber.unitGroup F H 0, φ' v ^ k ≠ 1 := by
      intro k hk hlt
      refine ⟨v₀, hv₀_mem0, ?_⟩
      rw [hφ'_v₀]
      exact hw_in_ord k hk hlt
    have he_gt1 : 1 < 12 / Nat.gcd n 12 := by
      interval_cases n <;> decide
    have hv₀_ne1 : φ' v₀ ≠ 1 := by
      have h1 := hw_in_ord 1 (one_dvd _) he_gt1
      rwa [pow_one, ← hφ'_v₀] at h1
    have h_cond : EllipticRootNumber.condExp F H φ' = 1 := by
      unfold EllipticRootNumber.condExp
      apply IsLeast.csInf_eq
      refine ⟨h_triv₁, ?_⟩
      intro a ha
      by_contra hlt
      have ha0 : a = 0 := by omega
      rw [ha0] at ha
      exact hv₀_ne1 (ha v₀ hv₀_mem0)
    
    let d_F : F := e_bot (d : (⊥ : IntermediateField F (AlgebraicClosure F)))
    have hd_F_ne : d_F ≠ 0 := (map_ne_zero e_bot).mpr (Units.ne_zero d)
    have hd_F_val : ValuativeRel.valuation F d_F = 1 :=
      (h_addVal_zero_iff d_F hd_F_ne).mp (by rw [← h_valL]; exact hd_val)
    have hd_sub_ne : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
        (d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2 ≠ 0 := by
      intro a hsub
      have hda : (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = a ^ 2 := sub_eq_zero.mp hsub
      have hu_a : (u : H) ^ 2 = (IntermediateField.inclusion h a) ^ 2 := by
        rw [hu_sq, hda, map_pow]
      have h_zero_one : (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
        rcases sq_eq_sq_iff_eq_or_eq_neg.mp hu_a with hu_eq | hu_eq
        · have hp : ((0 : (⊥ : IntermediateField F (AlgebraicClosure F))),
              (1 : (⊥ : IntermediateField F (AlgebraicClosure F)))) = (a, 0) :=
            (h_coord (u : H)).unique (by simp) (by rw [hu_eq]; simp)
          exact (Prod.ext_iff.mp hp).2.symm
        · have hp : ((0 : (⊥ : IntermediateField F (AlgebraicClosure F))),
              (1 : (⊥ : IntermediateField F (AlgebraicClosure F)))) = (-a, 0) :=
            (h_coord (u : H)).unique (by simp) (by rw [hu_eq, map_neg]; simp)
          exact (Prod.ext_iff.mp hp).2.symm
      exact zero_ne_one h_zero_one
    have hd_nonsq_val : ∀ y : F, ValuativeRel.valuation F y ≤ 1 →
        ValuativeRel.valuation F (d_F - y ^ 2) = 1 := by
      intro y hy
      let a : (⊥ : IntermediateField F (AlgebraicClosure F)) := e_bot.symm y
      have ha_val : 0 ≤ EllipticRootNumber.valL F ⊥ a := by
        rw [h_valL, e_bot.apply_symm_apply, h_addVal_nonneg]
        exact hy
      have h_val0 := hd_nonsq a ha_val
      have h_ne : e_bot ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) ≠ 0 :=
        (map_ne_zero e_bot).mpr (hd_sub_ne a)
      rw [h_valL, h_addVal_zero_iff _ h_ne, map_sub, map_pow, e_bot.apply_symm_apply] at h_val0
      exact h_val0
    let A := (ValuativeRel.valuation F).valuationSubring
    let kF := IsLocalRing.ResidueField ↥A
    haveI : Finite kF := inferInstanceAs (Finite 𝓀[F])
    let d_A : ↥A := ⟨d_F, le_of_eq hd_F_val⟩
    let d_bar : kF := IsLocalRing.residue ↥A d_A
    have h_nonsq_bar : ∀ r : kF, r ^ 2 ≠ d_bar + 0 * r := by
      intro r hr
      rw [zero_mul, add_zero] at hr
      obtain ⟨y_A, rfl⟩ := IsLocalRing.residue_surjective (R := ↥A) r
      have h_res0 : IsLocalRing.residue ↥A (d_A - y_A ^ 2) = 0 := by
        rw [map_sub, map_pow]
        change d_bar - (IsLocalRing.residue ↥A y_A) ^ 2 = 0
        rw [hr, sub_self]
      rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff] at h_res0
      change ValuativeRel.valuation F (d_F - (y_A : F) ^ 2) < 1 at h_res0
      rw [hd_nonsq_val (y_A : F) y_A.2] at h_res0
      exact lt_irrefl 1 h_res0
    haveI : Fact (∀ r : kF, r ^ 2 ≠ d_bar + 0 * r) := ⟨h_nonsq_bar⟩
    let E₂ := QuadraticAlgebra kF d_bar 0
    haveI : Finite E₂ := Finite.of_equiv (kF × kF) (QuadraticAlgebra.equivProd d_bar 0).symm
    have hq_gt1 : 1 < EllipticRootNumber.q F := by
      unfold EllipticRootNumber.q
      exact Finite.one_lt_card
    obtain ⟨g_F, hg_F⟩ := IsCyclic.exists_monoid_generator (α := kFˣ)
    have h_ord_gF : orderOf g_F = EllipticRootNumber.q F - 1 := by
      rw [orderOf_eq_card_of_forall_mem_powers hg_F, Nat.card_units]
      rfl
    obtain ⟨g, hg⟩ := IsCyclic.exists_monoid_generator (α := E₂ˣ)
    have h_card_E2 : Nat.card E₂ = EllipticRootNumber.q F * EllipticRootNumber.q F := by
      rw [Nat.card_congr (QuadraticAlgebra.equivProd d_bar 0), Nat.card_prod]
      rfl
    have h_ord_g : orderOf g = (EllipticRootNumber.q F - 1) * (EllipticRootNumber.q F + 1) := by
      rw [orderOf_eq_card_of_forall_mem_powers hg, Nat.card_units, h_card_E2]
      have h_le1 : 1 ≤ EllipticRootNumber.q F := by omega
      have h_le2 : 1 ≤ EllipticRootNumber.q F * EllipticRootNumber.q F := by nlinarith
      zify [h_le1, h_le2]
      ring
    let C_E2 : kF →+* E₂ :=
      { toFun := fun r => ⟨r, 0⟩
        map_one' := rfl
        map_mul' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_
          · change x * y = x * y + d_bar * 0 * 0
            ring
          · change (0 : kF) = x * 0 + 0 * y + 0 * 0 * 0
            ring
        map_zero' := rfl
        map_add' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_
          · rfl
          · change (0 : kF) = 0 + 0
            ring }
    let C_E2_u : kFˣ →* E₂ˣ := Units.map C_E2.toMonoidHom
    let R_A := QuadraticAlgebra ↥A d_A 0
    let Ψ : R_A →+* H :=
      { toFun := fun z =>
          IntermediateField.inclusion h (e_bot.symm (z.re : F)) +
            IntermediateField.inclusion h (e_bot.symm (z.im : F)) * (u : H)
        map_one' := by
          change IntermediateField.inclusion h (e_bot.symm (1 : F)) +
            IntermediateField.inclusion h (e_bot.symm (0 : F)) * (u : H) = 1
          simp
        map_mul' := fun x y => by
          have h_re : ((x * y).re : F) = (x.re : F) * (y.re : F) + d_F * (x.im : F) * (y.im : F) := by
            change ((x.re * y.re + d_A * x.im * y.im : ↥A) : F) = _
            simp [d_A]
          have h_im : ((x * y).im : F) = (x.re : F) * (y.im : F) + (x.im : F) * (y.re : F) := by
            change ((x.re * y.im + x.im * y.re + 0 * x.im * y.im : ↥A) : F) = _
            simp
          have hd_eq : IntermediateField.inclusion h (e_bot.symm d_F) = (u : H) ^ 2 := by
            rw [hu_sq]
            congr 1
            exact e_bot.symm_apply_apply _
          change IntermediateField.inclusion h (e_bot.symm ((x * y).re : F)) +
            IntermediateField.inclusion h (e_bot.symm ((x * y).im : F)) * (u : H) =
            (IntermediateField.inclusion h (e_bot.symm (x.re : F)) +
              IntermediateField.inclusion h (e_bot.symm (x.im : F)) * (u : H)) *
            (IntermediateField.inclusion h (e_bot.symm (y.re : F)) +
              IntermediateField.inclusion h (e_bot.symm (y.im : F)) * (u : H))
          rw [h_re, h_im]
          simp only [map_add, map_mul, hd_eq]
          ring
        map_zero' := by
          change IntermediateField.inclusion h (e_bot.symm (0 : F)) +
            IntermediateField.inclusion h (e_bot.symm (0 : F)) * (u : H) = 0
          simp
        map_add' := fun x y => by
          change IntermediateField.inclusion h (e_bot.symm ((x.re : F) + (y.re : F))) +
            IntermediateField.inclusion h (e_bot.symm ((x.im : F) + (y.im : F))) * (u : H) = _
          simp only [map_add]
          ring }
    let red : R_A →+* E₂ :=
      { toFun := fun z => ⟨IsLocalRing.residue ↥A z.re, IsLocalRing.residue ↥A z.im⟩
        map_one' := by
          refine QuadraticAlgebra.ext ?_ ?_
          · exact map_one (IsLocalRing.residue ↥A)
          · exact map_zero (IsLocalRing.residue ↥A)
        map_mul' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_
          · change IsLocalRing.residue ↥A (x.re * y.re + d_A * x.im * y.im) =
              IsLocalRing.residue ↥A x.re * IsLocalRing.residue ↥A y.re +
                IsLocalRing.residue ↥A d_A * IsLocalRing.residue ↥A x.im * IsLocalRing.residue ↥A y.im
            simp
          · change IsLocalRing.residue ↥A (x.re * y.im + x.im * y.re + 0 * x.im * y.im) =
              IsLocalRing.residue ↥A x.re * IsLocalRing.residue ↥A y.im +
                IsLocalRing.residue ↥A x.im * IsLocalRing.residue ↥A y.re +
                0 * IsLocalRing.residue ↥A x.im * IsLocalRing.residue ↥A y.im
            simp
        map_zero' := by
          refine QuadraticAlgebra.ext ?_ ?_ <;> exact map_zero (IsLocalRing.residue ↥A)
        map_add' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_ <;> exact map_add (IsLocalRing.residue ↥A) _ _ }
    let Ψ_u : R_Aˣ →* Hˣ := Units.map Ψ.toMonoidHom
    let red_u : R_Aˣ →* E₂ˣ := Units.map red.toMonoidHom
    have h_mk_unit : ∀ z : R_A, red z ≠ 0 → ∃ w : R_Aˣ, (w : R_A) = z := by
      intro z hz
      have h_norm_res : IsLocalRing.residue ↥A (z.re ^ 2 - d_A * z.im ^ 2) ≠ 0 := by
        intro h0
        rw [map_sub, map_pow, map_mul, map_pow, sub_eq_zero] at h0
        by_cases him : IsLocalRing.residue ↥A z.im = 0
        · rw [him] at h0
          ring_nf at h0
          have hre : IsLocalRing.residue ↥A z.re = 0 := pow_eq_zero h0
          apply hz
          refine QuadraticAlgebra.ext ?_ ?_
          · exact hre
          · exact him
        · have h_sq : (IsLocalRing.residue ↥A z.re / IsLocalRing.residue ↥A z.im) ^ 2 =
              d_bar + 0 * (IsLocalRing.residue ↥A z.re / IsLocalRing.residue ↥A z.im) := by
            rw [zero_mul, add_zero, div_pow, h0]
            exact mul_div_cancel_right₀ d_bar (pow_ne_zero 2 him)
          exact h_nonsq_bar _ h_sq
      obtain ⟨u_N, hu_N⟩ := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp h_norm_res
      let inv_N : ↥A := ↑(u_N⁻¹)
      have h_inv_N : inv_N * (z.re ^ 2 - d_A * z.im ^ 2) = 1 := by
        rw [← hu_N]
        change ↑(u_N⁻¹) * (u_N : ↥A) = 1
        rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
      let z' : R_A := ⟨inv_N * z.re, -(inv_N * z.im)⟩
      refine ⟨⟨z, z', ?_, ?_⟩, rfl⟩
      · refine QuadraticAlgebra.ext ?_ ?_
        · change z.re * (inv_N * z.re) + d_A * z.im * -(inv_N * z.im) = 1
          calc z.re * (inv_N * z.re) + d_A * z.im * -(inv_N * z.im)
              = inv_N * (z.re ^ 2 - d_A * z.im ^ 2) := by ring
            _ = 1 := h_inv_N
        · change z.re * -(inv_N * z.im) + z.im * (inv_N * z.re) + 0 * z.im * -(inv_N * z.im) = 0
          ring
      · refine QuadraticAlgebra.ext ?_ ?_
        · change (inv_N * z.re) * z.re + d_A * -(inv_N * z.im) * z.im = 1
          calc (inv_N * z.re) * z.re + d_A * -(inv_N * z.im) * z.im
              = inv_N * (z.re ^ 2 - d_A * z.im ^ 2) := by ring
            _ = 1 := h_inv_N
        · change (inv_N * z.re) * z.im + -(inv_N * z.im) * z.re + 0 * -(inv_N * z.im) * z.im = 0
          ring
    have h_ker_red : ∀ w : R_Aˣ, red_u w = 1 → Ψ_u w ∈ EllipticRootNumber.unitGroup F H 1 := by
      intro w hw
      have hw_val : red (w : R_A) = 1 := congrArg Units.val hw
      have h_re_res : IsLocalRing.residue ↥A ((w : R_A).re - 1) = 0 := by
        rw [map_sub, map_one]
        have : IsLocalRing.residue ↥A (w : R_A).re = (1 : E₂).re :=
          congrArg QuadraticAlgebra.re hw_val
        rw [this]
        exact sub_self 1
      have h_im_res : IsLocalRing.residue ↥A (w : R_A).im = 0 :=
        congrArg QuadraticAlgebra.im hw_val
      rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff] at h_re_res h_im_res
      apply h_mem₁ (Ψ_u w) (e_bot.symm (((w : R_A).re : ↥A) : F)) (e_bot.symm (((w : R_A).im : ↥A) : F)) rfl
      · rw [e_bot.apply_symm_apply]
        exact h_re_res
      · rw [e_bot.apply_symm_apply]
        exact h_im_res
    obtain ⟨x_g, hx_g⟩ := IsLocalRing.residue_surjective (R := ↥A) (g : E₂).re
    obtain ⟨y_g, hy_g⟩ := IsLocalRing.residue_surjective (R := ↥A) (g : E₂).im
    let z_g : R_A := ⟨x_g, y_g⟩
    have hz_g_red : red z_g = (g : E₂) := by
      refine QuadraticAlgebra.ext ?_ ?_
      · exact hx_g
      · exact hy_g
    obtain ⟨w_g, hw_g⟩ := h_mk_unit z_g (by rw [hz_g_red]; exact Units.ne_zero g)
    have hw_g_red : red_u w_g = g := by
      apply Units.ext
      change red (w_g : R_A) = (g : E₂)
      rw [hw_g, hz_g_red]
    let v_g : Hˣ := Ψ_u w_g
    have hv_g₀ : v_g ∈ EllipticRootNumber.unitGroup F H 0 := by
      unfold EllipticRootNumber.unitGroup
      apply Subgroup.subset_closure
      rw [Set.mem_setOf_eq, if_pos rfl]
      have hv_g_eq : (v_g : H) =
          IntermediateField.inclusion h (e_bot.symm (x_g : F)) +
            IntermediateField.inclusion h (e_bot.symm (y_g : F)) * (u : H) := by
        change Ψ (w_g : R_A) = _
        rw [hw_g]
        rfl
      have h_not_both_lt : ¬ (ValuativeRel.valuation F (x_g : F) < 1 ∧
          ValuativeRel.valuation F (y_g : F) < 1) := by
        rintro ⟨hx_lt, hy_lt⟩
        have hx_res : IsLocalRing.residue ↥A x_g = 0 := by
          rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff]
          exact hx_lt
        have hy_res : IsLocalRing.residue ↥A y_g = 0 := by
          rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff]
          exact hy_lt
        apply Units.ne_zero g
        rw [← hz_g_red]
        refine QuadraticAlgebra.ext ?_ ?_
        · exact hx_res
        · exact hy_res
      have h_val0 := (h_coord₀ (e_bot.symm (x_g : F)) (e_bot.symm (y_g : F))).mpr
        ⟨by rw [e_bot.apply_symm_apply]; exact x_g.2,
         by rw [e_bot.apply_symm_apply]; exact y_g.2,
         by rw [e_bot.apply_symm_apply, e_bot.apply_symm_apply]; exact h_not_both_lt⟩
      rw [← hv_g_eq] at h_val0
      exact h_val0.2
    let ζ : (EllipticRootNumber.Ω F)ˣ := φ' v_g
    have hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1 := h_pow v_g hv_g₀
    have hdvd_e : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F + 1) := by
      have hq_div12 : EllipticRootNumber.q F =
          12 * (EllipticRootNumber.q F / 12) + EllipticRootNumber.q F % 12 :=
        (Nat.div_add_mod (EllipticRootNumber.q F) 12).symm
      have hr : EllipticRootNumber.q F % 12 = 1 ∨ EllipticRootNumber.q F % 12 = 5 ∨
          EllipticRootNumber.q F % 12 = 7 ∨ EllipticRootNumber.q F % 12 = 11 := by
        have : EllipticRootNumber.q F % 12 < 12 := Nat.mod_lt _ (by omega)
        rw [hq_div12] at hq2 hq3
        omega
      rcases hr with hr | hr | hr | hr <;>
        (rw [hq_div12, hr] at hdi ⊢;
         interval_cases n <;>
           (norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdi ⊢; omega))
    have hζ_q1 : ζ ^ (EllipticRootNumber.q F + 1) = 1 := by
      obtain ⟨c, hc⟩ := hdvd_e
      rw [hc, pow_mul, hζ_pow, one_pow]
    have h_triv_bot0 : ∀ y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (y : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 →
        φ' (ι y) = 1 := by
      intro y hy_val0
      have hy_F_ne : e_bot (y : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
        (map_ne_zero e_bot).mpr (Units.ne_zero y)
      have hy_F_val : ValuativeRel.valuation F (e_bot (y : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 :=
        (h_addVal_zero_iff _ hy_F_ne).mp (by rw [← h_valL]; exact hy_val0)
      let x_y : ↥A := ⟨e_bot (y : (⊥ : IntermediateField F (AlgebraicClosure F))), le_of_eq hy_F_val⟩
      let r_y : kF := IsLocalRing.residue ↥A x_y
      have hr_y_ne : r_y ≠ 0 := by
        intro h0
        rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff] at h0
        change ValuativeRel.valuation F (e_bot (y : (⊥ : IntermediateField F (AlgebraicClosure F)))) < 1 at h0
        exact ne_of_lt h0 hy_F_val
      let r_u : kFˣ := Units.mk0 r_y hr_y_ne
      obtain ⟨j, hj⟩ := hg_F r_u
      change g_F ^ j = r_u at hj
      have hr_u_pow : r_u ^ (EllipticRootNumber.q F - 1) = 1 := by
        rw [← hj, ← pow_mul, mul_comm j, ← h_ord_gF, pow_mul, pow_orderOf_eq_one, one_pow]
      let z_y : R_A := ⟨x_y, 0⟩
      have hz_y_red : red z_y = (C_E2_u r_u : E₂) := by
        refine QuadraticAlgebra.ext ?_ ?_
        · rfl
        · exact map_zero (IsLocalRing.residue ↥A)
      obtain ⟨w_y, hw_y⟩ := h_mk_unit z_y (by rw [hz_y_red]; exact Units.ne_zero (C_E2_u r_u))
      have hw_y_red : red_u w_y = C_E2_u r_u := by
        apply Units.ext
        change red (w_y : R_A) = (C_E2_u r_u : E₂)
        rw [hw_y, hz_y_red]
      have hΨ_wy : Ψ_u w_y = ι y := by
        apply Units.ext
        change Ψ (w_y : R_A) = IntermediateField.inclusion h (y : (⊥ : IntermediateField F (AlgebraicClosure F)))
        rw [hw_y]
        change IntermediateField.inclusion h (e_bot.symm (e_bot (y : (⊥ : IntermediateField F (AlgebraicClosure F))))) +
          IntermediateField.inclusion h (e_bot.symm (0 : F)) * (u : H) = _
        rw [e_bot.symm_apply_apply]
        simp
      obtain ⟨k, hk⟩ := hg (red_u w_y)
      change g ^ k = red_u w_y at hk
      have hg_k_pow : g ^ ((EllipticRootNumber.q F - 1) * k) = 1 := by
        rw [mul_comm, pow_mul, hk, hw_y_red, ← map_pow, hr_u_pow, map_one]
      have hdvd_k : (EllipticRootNumber.q F + 1) ∣ k := by
        have hdvd_prod : (EllipticRootNumber.q F - 1) * (EllipticRootNumber.q F + 1) ∣
            (EllipticRootNumber.q F - 1) * k := by
          rw [← h_ord_g, orderOf_dvd_iff_pow_eq_one]
          exact hg_k_pow
        exact (Nat.mul_dvd_mul_iff_left (by omega : 0 < EllipticRootNumber.q F - 1)).mp hdvd_prod
      have h_red1 : red_u (w_y * (w_g ^ k)⁻¹) = 1 := by
        rw [map_mul, map_inv, map_pow, hw_g_red, ← hk, mul_inv_cancel]
      have h_mem1 : ι y * (v_g ^ k)⁻¹ ∈ EllipticRootNumber.unitGroup F H 1 := by
        have := h_ker_red (w_y * (w_g ^ k)⁻¹) h_red1
        rwa [map_mul, map_inv, map_pow, hΨ_wy] at this
      have h_one := h_triv₁ (ι y * (v_g ^ k)⁻¹) h_mem1
      rw [map_mul, map_inv, map_pow, mul_inv_eq_one] at h_one
      obtain ⟨c, rfl⟩ := hdvd_k
      rw [h_one, pow_mul, hζ_q1, one_pow]
    have hφ'_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        φ' (ι x) =
          (-EllipticRootNumber.qUnit F) ^
            (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) := by
      intro x
      set m := EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))
      let y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := x * π ^ (-m)
      have hy_val0 : EllipticRootNumber.valL F ⊥ (y : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        rw [h_valL_bot_mul x (π ^ (-m)), h_valL_bot_zpow π (-m), hπ_val]
        change m + -m * 1 = 0
        omega
      have hx_eq : x = y * π ^ m := by
        dsimp only [y]
        group
      conv_lhs => rw [hx_eq]
      rw [map_mul, map_mul, h_triv_bot0 y hy_val0, one_mul, map_zpow, map_zpow,
        show ι π = π_H from rfl, hφ'_π, inv_zpow']
    exact ⟨φ', hφ'_rec, hφ'_bot, h_cond, h_pow, h_ord⟩
  )

theorem ellAdicRep_dihedral_induced_tame (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hdi : ¬ ((12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)))
    (rec : EllipticRootNumber.LocalReciprocity F) :
    ∃ (H : IntermediateField F (AlgebraicClosure F))
      (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
      (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
      (φ : EllipticRootNumber.relWeil F H →* (EllipticRootNumber.Ω F)ˣ)
      (φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ)
      (f : EllipticRootNumber.indSpace
        ((EllipticRootNumber.relWeil F H).subgroupOf (EllipticRootNumber.relWeil F ⊥))
        ((EllipticRootNumber.charRep F H φ).comp
          (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom)
          →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E),
      FiniteDimensional F H ∧
      Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F)) (IntermediateField.extendScalars h) ∧
      H ≤ EllipticRootNumber.unramifiedClosure F ∧
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
          2 ∣ Multiplicative.toAdd
            (EllipticRootNumber.weilDegreeHom F
              (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w))) ∧
      (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))) ∧
      EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      (∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
        0 ≤ EllipticRootNumber.valL F ⊥ a →
          EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0) ∧
      (∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
        y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H)) ∧
      (∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
        (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
          0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
        ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
          1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
          (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b))) ∧
      (∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a) ∧
      (∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.traceLM F h (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 2 * a) ∧
      EllipticRootNumber.IsWeilRep F H (EllipticRootNumber.charRep F H φ) ∧
      EllipticRootNumber.IsWeilRep F ⊥
        ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) ∧
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        f ∘ₗ EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H φ) w =
          ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w ∘ₗ f) ∧
      Function.Bijective f ∧
      (∀ x : Hˣ, φ' x = φ (rec.recMap H x)) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        φ' (Units.map (IntermediateField.inclusion h).toMonoidHom x) =
          (-EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) ∧
      EllipticRootNumber.condExp F H φ' = 1 ∧
      (∀ v ∈ EllipticRootNumber.unitGroup F H 0, φ' v ^ (12 / Nat.gcd n 12) = 1) ∧
      (∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 →
        ∃ v ∈ EllipticRootNumber.unitGroup F H 0, φ' v ^ k ≠ 1) :=
by
  classical
  obtain ⟨H, h, u, d, hH_fin, hH_sep, hH_unr, hH_weil, hu_sq, hd_val, hd_nonsq,
    h_coord, h_valL_coord, h_valL_inc, h_trace_coord, h_relVal_H⟩ :=
    unramified_quadratic_extension_spec F hq2
  haveI : FiniteDimensional F H := hH_fin
  have hW_E := isWeilRep_of_isPotentiallyGood F E hj
  obtain ⟨M, h_HM, φ, w₀, v₁, hM_fin, h_ab, hW_φ, hw₀, hv₁, h_basis,
    h_unif_norm, h_u1_norm, hφ_fix, hφ_pow, hφ_ord⟩ :=
    ellAdicRep_dihedral_kummer_eigenbasis F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hn23
      hΔ hc₄ hj hq2 hq3 hdi H h u d hH_sep hH_unr hH_weil hu_sq hd_val hd_nonsq
      h_coord h_valL_coord h_valL_inc h_relVal_H
  haveI : FiniteDimensional F M := hM_fin
  obtain ⟨φ', hφ'_rec, hφ'_bot, h_cond, h_pow, h_ord⟩ :=
    dihedral_reciprocity_char_spec F n hn0 hn12 hn23 hq2 hq3 hdi H h u d
      hu_sq hd_val hd_nonsq h_coord h_valL_coord h_valL_inc h_relVal_H
      M h_HM h_ab φ h_unif_norm h_u1_norm hφ_fix hφ_pow hφ_ord rec
  let σ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
  let deg : EllipticRootNumber.relWeil F ⊥ → ℤ := fun w =>
    Multiplicative.toAdd (EllipticRootNumber.weilDegreeHom F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w))
  have hdeg_mul : ∀ x y : EllipticRootNumber.relWeil F ⊥, deg (x * y) = deg x + deg y := by
    intro x y
    dsimp [deg]
    rw [map_mul, map_mul, toAdd_mul]
  have hw₀_deg : ¬ (2 ∣ deg w₀) := by
    rwa [← hH_weil w₀]
  have h_one_mem : ((1 : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup :=
    H.fixingSubgroup.one_mem
  have h_inv_mem : ∀ g : EllipticRootNumber.relWeil F ⊥,
      ((g⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
        (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup := by
    intro g
    exact Subgroup.inv_mem_iff H.fixingSubgroup
  have h_mul_left_mem : ∀ (k g : EllipticRootNumber.relWeil F ⊥),
      (k : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup →
        (((k * g : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
          (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) := by
    intro k g hk
    exact Subgroup.mul_mem_cancel_left H.fixingSubgroup hk
  have h_mul_w0_iff : ∀ g : EllipticRootNumber.relWeil F ⊥,
      (((g * w₀ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
        ¬ ((g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup)) := by
    intro g
    rw [hH_weil (g * w₀), hH_weil g]
    change 2 ∣ deg (g * w₀) ↔ ¬ (2 ∣ deg g)
    rw [hdeg_mul]
    omega
  have h_not_mem_mul_w0 : ∀ g : EllipticRootNumber.relWeil F ⊥,
      ¬ ((g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) →
        ((g * w₀ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup := by
    intro g hg
    exact (h_mul_w0_iff g).mpr hg
  have hw₀_inv_not_mem : ¬ (((w₀⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) := by
    rwa [h_inv_mem]
  let toWH : ∀ (g : EllipticRootNumber.relWeil F ⊥),
      (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup → EllipticRootNumber.relWeil F H :=
    fun g hg => ⟨g.1, g.2.1, hg⟩
  have h_toWH_inc : ∀ (g : EllipticRootNumber.relWeil F ⊥)
      (hg : (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup),
      Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) (toWH g hg) = g := by
    intro g hg
    rfl
  let K := (EllipticRootNumber.relWeil F H).subgroupOf (EllipticRootNumber.relWeil F ⊥)
  let ρ := (EllipticRootNumber.charRep F H φ).comp
    (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom
  have h_ind_eq : ∀ (α : EllipticRootNumber.indSpace K ρ)
      (w : EllipticRootNumber.relWeil F H) (g : EllipticRootNumber.relWeil F ⊥),
      (α.1 (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w * g)).down =
        (φ w : EllipticRootNumber.Ω F) * (α.1 g).down := by
    intro α w g
    let k : K := ⟨Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w, w.2⟩
    have hk := α.2 k g
    have h_eq : (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h)) k = w := rfl
    have hk' := congrArg ULift.down hk
    simpa [ρ, EllipticRootNumber.charRep, h_eq] using hk'
  have h_ind_mem : ∀ (α : EllipticRootNumber.indSpace K ρ)
      (g : EllipticRootNumber.relWeil F ⊥)
      (hg : (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup),
      (α.1 g).down = (φ (toWH g hg) : EllipticRootNumber.Ω F) * (α.1 1).down := by
    intro α g hg
    have h1 := h_ind_eq α (toWH g hg) 1
    rwa [h_toWH_inc g hg, mul_one] at h1
  have h_ind_not_mem : ∀ (α : EllipticRootNumber.indSpace K ρ)
      (g : EllipticRootNumber.relWeil F ⊥)
      (hg : ¬ ((g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup)),
      (α.1 g).down =
        (φ (toWH (g * w₀) (h_not_mem_mul_w0 g hg)) : EllipticRootNumber.Ω F) * (α.1 w₀⁻¹).down := by
    intro α g hg
    have h1 := h_ind_eq α (toWH (g * w₀) (h_not_mem_mul_w0 g hg)) w₀⁻¹
    rwa [h_toWH_inc (g * w₀) (h_not_mem_mul_w0 g hg), mul_inv_cancel_right] at h1
  let f : EllipticRootNumber.indSpace K ρ →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E :=
    { toFun := fun α => (α.1 1).down • v₁ + (α.1 w₀⁻¹).down • σ w₀ v₁
      map_add' := fun α β => by
        change ((α.1 1).down + (β.1 1).down) • v₁ +
            ((α.1 w₀⁻¹).down + (β.1 w₀⁻¹).down) • σ w₀ v₁ =
          ((α.1 1).down • v₁ + (α.1 w₀⁻¹).down • σ w₀ v₁) +
            ((β.1 1).down • v₁ + (β.1 w₀⁻¹).down • σ w₀ v₁)
        rw [add_smul, add_smul]
        abel
      map_smul' := fun c α => by
        change (c * (α.1 1).down) • v₁ + (c * (α.1 w₀⁻¹).down) • σ w₀ v₁ =
          c • ((α.1 1).down • v₁ + (α.1 w₀⁻¹).down • σ w₀ v₁)
        rw [smul_add, mul_smul, mul_smul] }
  have hf_equiv : ∀ w : EllipticRootNumber.relWeil F ⊥,
      f ∘ₗ EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H φ) w = σ w ∘ₗ f := by
    intro w
    apply LinearMap.ext
    intro α
    let T : EllipticRootNumber.relWeil F ⊥ → EllipticRootNumber.VBar F E :=
      fun g => σ g ((α.1 g⁻¹).down • v₁)
    have hT_mem : ∀ (g : EllipticRootNumber.relWeil F ⊥)
        (hg : (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup),
        T g = (α.1 1).down • v₁ := by
      intro g hg
      dsimp [T]
      have hg_inv : ((g⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup :=
        (h_inv_mem g).mpr hg
      rw [h_ind_mem α g⁻¹ hg_inv, map_smul]
      have hσg : σ g v₁ = (φ (toWH g hg) : EllipticRootNumber.Ω F) • v₁ := hv₁ (toWH g hg)
      have h_inv_eq : toWH g⁻¹ hg_inv = (toWH g hg)⁻¹ := rfl
      rw [hσg, h_inv_eq, map_inv, smul_smul, mul_comm _ (α.1 1).down, mul_assoc,
        ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
    have hT_not_mem : ∀ (g : EllipticRootNumber.relWeil F ⊥)
        (hg : ¬ ((g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup)),
        T g = (α.1 w₀⁻¹).down • σ w₀ v₁ := by
      intro g hg
      dsimp [T]
      have hg_inv : ¬ (((g⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) := by
        rwa [h_inv_mem]
      rw [h_ind_not_mem α g⁻¹ hg_inv, map_smul]
      let k := toWH (g⁻¹ * w₀) (h_not_mem_mul_w0 g⁻¹ hg_inv)
      have hk_inc : Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) k⁻¹ = w₀⁻¹ * g := by
        ext
        simp [k, toWH, mul_inv_rev]
      have hg_eq : g = w₀ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) k⁻¹ := by
        rw [hk_inc, mul_inv_cancel_left]
      have hσg : σ g v₁ = (φ k⁻¹ : EllipticRootNumber.Ω F) • σ w₀ v₁ := by
        conv_lhs => rw [hg_eq]
        rw [map_mul, Module.End.mul_apply, hv₁ k⁻¹, map_smul]
      rw [hσg, smul_smul, mul_comm _ (α.1 w₀⁻¹).down, mul_assoc,
        ← Units.val_mul, ← map_mul, mul_inv_cancel, map_one, Units.val_one, mul_one]
    change (α.1 (1 * w)).down • v₁ + (α.1 (w₀⁻¹ * w)).down • σ w₀ v₁ =
      σ w ((α.1 1).down • v₁ + (α.1 w₀⁻¹).down • σ w₀ v₁)
    have h_lhs : (α.1 (1 * w)).down • v₁ + (α.1 (w₀⁻¹ * w)).down • σ w₀ v₁ =
        σ w (T w⁻¹ + T (w⁻¹ * w₀)) := by
      dsimp [T]
      rw [map_add, ← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one,
        Module.End.one_apply, inv_inv, one_mul,
        ← Module.End.mul_apply, ← map_mul, mul_inv_cancel_left,
        mul_inv_rev, inv_inv, map_smul]
    rw [h_lhs]
    congr 1
    by_cases hw_inv : ((w⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup
    · have hw_w0 : ¬ ((((w⁻¹ * w₀ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup)) := by
        rwa [h_mul_w0_iff w⁻¹, not_not]
      rw [hT_mem w⁻¹ hw_inv, hT_not_mem (w⁻¹ * w₀) hw_w0]
    · have hw_w0 : ((w⁻¹ * w₀ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup :=
        h_not_mem_mul_w0 w⁻¹ hw_inv
      rw [hT_not_mem w⁻¹ hw_inv, hT_mem (w⁻¹ * w₀) hw_w0, add_comm]
  have hf_bij : Function.Bijective f := by
    refine ⟨?_, ?_⟩
    · intro α β hαβ
      obtain ⟨p, hp, hp_uniq⟩ := h_basis (f α)
      have h1 : ((α.1 1).down, (α.1 w₀⁻¹).down) = p :=
        hp_uniq ((α.1 1).down, (α.1 w₀⁻¹).down) rfl
      have h2 : ((β.1 1).down, (β.1 w₀⁻¹).down) = p :=
        hp_uniq ((β.1 1).down, (β.1 w₀⁻¹).down) hαβ
      have h_eq_pair : ((α.1 1).down, (α.1 w₀⁻¹).down) = ((β.1 1).down, (β.1 w₀⁻¹).down) :=
        h1.trans h2.symm
      have hc1 : (α.1 1).down = (β.1 1).down := Prod.ext_iff.mp h_eq_pair |>.1
      have hc2 : (α.1 w₀⁻¹).down = (β.1 w₀⁻¹).down := Prod.ext_iff.mp h_eq_pair |>.2
      apply Subtype.ext
      funext g
      apply ULift.ext
      by_cases hg : (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup
      · rw [h_ind_mem α g hg, h_ind_mem β g hg, hc1]
      · rw [h_ind_not_mem α g hg, h_ind_not_mem β g hg, hc2]
    · intro v
      obtain ⟨⟨c₁, c₂⟩, hv, _⟩ := h_basis v
      dsimp only at hv
      let α_fun : EllipticRootNumber.relWeil F ⊥ → ULift.{u} (EllipticRootNumber.Ω F) := fun g =>
        if hg : (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup then
          ULift.up ((φ (toWH g hg) : EllipticRootNumber.Ω F) * c₁)
        else
          ULift.up ((φ (toWH (g * w₀) (h_not_mem_mul_w0 g hg)) : EllipticRootNumber.Ω F) * c₂)
      have hα_mem : α_fun ∈ EllipticRootNumber.indSpace K ρ := by
        intro k g
        have hk_mem : ((k.1 : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup := k.2.2
        let k' : EllipticRootNumber.relWeil F H := ⟨(k.1 : EllipticRootNumber.AbsGal F), k.2⟩
        have hk'_eq : (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h)) k = k' := rfl
        apply ULift.ext
        change (α_fun (k.1 * g)).down = (φ k' : EllipticRootNumber.Ω F) * (α_fun g).down
        dsimp only [α_fun]
        by_cases hg : (g : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup
        · have hkg : ((k.1 * g : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup :=
            (h_mul_left_mem k.1 g hk_mem).mpr hg
          rw [dif_pos hkg, dif_pos hg]
          dsimp only
          have h_mul_toWH : toWH (k.1 * g) hkg = k' * toWH g hg := rfl
          rw [h_mul_toWH, map_mul, Units.val_mul, mul_assoc]
        · have hkg : ¬ (((k.1 * g : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) := by
            rwa [h_mul_left_mem k.1 g hk_mem]
          rw [dif_neg hkg, dif_neg hg]
          dsimp only
          have h_mul_toWH :
              toWH (k.1 * g * w₀) (h_not_mem_mul_w0 (k.1 * g) hkg) =
                k' * toWH (g * w₀) (h_not_mem_mul_w0 g hg) := by
            apply Subtype.ext
            exact mul_assoc (k.1 : EllipticRootNumber.AbsGal F)
              (g : EllipticRootNumber.AbsGal F) (w₀ : EllipticRootNumber.AbsGal F)
          rw [h_mul_toWH, map_mul, Units.val_mul, mul_assoc]
      refine ⟨⟨α_fun, hα_mem⟩, ?_⟩
      change (α_fun 1).down • v₁ + (α_fun w₀⁻¹).down • σ w₀ v₁ = v
      have hα1 : (α_fun 1).down = c₁ := by
        dsimp only [α_fun]
        rw [dif_pos h_one_mem]
        dsimp only
        have h1_eq : toWH 1 h_one_mem = 1 := rfl
        rw [h1_eq, map_one, Units.val_one, one_mul]
      have hαw0 : (α_fun w₀⁻¹).down = c₂ := by
        dsimp only [α_fun]
        rw [dif_neg hw₀_inv_not_mem]
        dsimp only
        have hw0_eq : toWH (w₀⁻¹ * w₀) (h_not_mem_mul_w0 w₀⁻¹ hw₀_inv_not_mem) = 1 := by
          apply Subtype.ext
          exact inv_mul_cancel (w₀ : EllipticRootNumber.AbsGal F)
        rw [hw0_eq, map_one, Units.val_one, one_mul]
      rw [hα1, hαw0, hv]
  refine ⟨H, h, u, d, φ, φ', f, hH_fin, hH_sep, hH_unr, hH_weil, hu_sq, hd_val, hd_nonsq,
    h_coord, h_valL_coord, h_valL_inc, h_trace_coord, hW_φ, hW_E, hf_equiv, hf_bij,
    hφ'_rec, hφ'_bot, h_cond, h_pow, h_ord⟩

theorem eps_ind_unramified_quadratic_eq_tateEps (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ_adm : EllipticRootNumber.IsAdmissibleChar F ⊥ ψ)
    (hψ_cond : EllipticRootNumber.condExpChar F ⊥ ψ = 0)
    (hψ_triv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1)
    (hψ_nontriv : ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (rec : EllipticRootNumber.LocalReciprocity F)
    (lc : EllipticRootNumber.LocalConstants F rec)
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) [FiniteDimensional F H]
    (hH_sep : Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F)) (IntermediateField.extendScalars h))
    (hH_unr : H ≤ EllipticRootNumber.unramifiedClosure F)
    (hH_weil : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
        2 ∣ Multiplicative.toAdd
          (EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w)))
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)))
    (h_valL_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a)
    (h_trace_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.traceLM F h (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 2 * a)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (φ : EllipticRootNumber.relWeil F H →* (EllipticRootNumber.Ω F)ˣ)
    (φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ)
    (f : EllipticRootNumber.indSpace
      ((EllipticRootNumber.relWeil F H).subgroupOf (EllipticRootNumber.relWeil F ⊥))
      ((EllipticRootNumber.charRep F H φ).comp
        (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom)
        →ₗ[EllipticRootNumber.Ω F] V)
    (hW_φ : EllipticRootNumber.IsWeilRep F H (EllipticRootNumber.charRep F H φ))
    (hW_σ : EllipticRootNumber.IsWeilRep F ⊥ σ)
    (hf_equiv : ∀ w : EllipticRootNumber.relWeil F ⊥,
      f ∘ₗ EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H φ) w = σ w ∘ₗ f)
    (hf_bij : Function.Bijective f)
    (hφ'_rec : ∀ x : Hˣ, φ' x = φ (rec.recMap H x)) :
    (lc.eps ⊥ σ ψ : EllipticRootNumber.Ω F) =
      EllipticRootNumber.tateEps F H φ' (EllipticRootNumber.traceChar F h ψ) :=
by
  classical
  open ValuativeRel in
  (
    let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    haveI : FiniteDimensional F (⊥ : IntermediateField F (AlgebraicClosure F)) := inferInstance
    have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
        z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
      rintro _ hz m rfl
      exact WithZero.unzero_coe hz
    obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      rw [hπ_val, iso.apply_symm_apply]
    have hπ0 : π ≠ 0 := by
      intro h0
      have : iso (ValuativeRel.valuation F π) = 0 := by rw [h0, map_zero, map_zero]
      rw [hπ_iso] at this
      exact WithZero.exp_ne_zero this
    have hπ_addVal : EllipticRootNumber.addVal F π = 1 := by
      unfold EllipticRootNumber.addVal
      rw [dif_neg hπ0, h_unzero _ _ (-1) hπ_iso]
      rfl
    have h_addVal_one : EllipticRootNumber.addVal F 1 = 0 := by
      have h1_ne : (1 : F) ≠ 0 := one_ne_zero
      have h1_iso : iso (ValuativeRel.valuation F 1) = WithZero.exp (0 : ℤ) := by
        rw [Valuation.map_one, map_one, WithZero.exp_zero]
      unfold EllipticRootNumber.addVal
      rw [dif_neg h1_ne, h_unzero _ _ 0 h1_iso]
      rfl
    have h_addVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 →
        EllipticRootNumber.addVal F (a * b) =
          EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      unfold EllipticRootNumber.addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have h_ne : ∀ x : F, x ≠ 0 → iso (ValuativeRel.valuation F x) ≠ 0 :=
        fun x hx => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hx)
      have h_unz : WithZero.unzero (h_ne (a * b) hab) =
          WithZero.unzero (h_ne a ha) * WithZero.unzero (h_ne b hb) := by
        apply WithZero.coe_inj.mp
        rw [WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero, WithZero.coe_unzero,
          ← map_mul, ← map_mul]
      rw [h_unz, toAdd_mul]
      omega
    have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.relVal
      have h_norm : Algebra.norm F x = e_bot x := by
        rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
        rfl
      rw [h_norm]
    have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
      unfold EllipticRootNumber.resDeg
      apply IsLeast.csInf_eq
      refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
      · intro h0
        apply hπ0
        have := congrArg e_bot h0
        simpa using this
      · rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
        omega
      · rintro k ⟨hk, _⟩
        exact hk
    have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.valL
      rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
    
    have h_val2 : ValuativeRel.valuation F (2 : F) = 1 := by
      haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
      obtain ⟨k, hp_prime, hcard_eq⟩ := FiniteField.card 𝓀[F] (ringChar 𝓀[F])
      have h2_res_ne : (2 : 𝓀[F]) ≠ 0 := by
        intro h2_zero
        have hdvd2 : ringChar 𝓀[F] ∣ 2 := by
          simpa using (CharP.cast_eq_zero_iff 𝓀[F] (ringChar 𝓀[F]) 2).mp h2_zero
        have hp_eq : ringChar 𝓀[F] = 2 := by
          rcases (Nat.dvd_prime Nat.prime_two).mp hdvd2 with h1 | h2
          · exact absurd h1 hp_prime.ne_one
          · exact h2
        apply hq2
        unfold EllipticRootNumber.q
        rw [Nat.card_eq_fintype_card, hcard_eq, hp_eq]
        exact dvd_pow_self 2 k.ne_zero
      have h2_not_max : (2 : ↥𝒪[F]) ∉ IsLocalRing.maximalIdeal ↥𝒪[F] := by
        rw [← IsLocalRing.residue_eq_zero_iff, map_ofNat]
        exact h2_res_ne
      have h2_not_lt : ¬ (ValuativeRel.valuation F (2 : F) < 1) := by
        intro hlt
        exact h2_not_max ((Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F)).mpr hlt)
      have h2_le : ValuativeRel.valuation F (2 : F) ≤ 1 := by
        have : (2 : F) = 1 + 1 := one_add_one_eq_two.symm
        rw [this]
        exact le_trans (Valuation.map_add _ 1 1) (max_le (by simp) (by simp))
      exact le_antisymm h2_le (not_lt.mp h2_not_lt)
    have h2_F_ne : (2 : F) ≠ 0 := by
      intro h0
      have : ValuativeRel.valuation F (2 : F) = 0 := by rw [h0, Valuation.map_zero]
      rw [h_val2] at this
      exact one_ne_zero this
    have h2_bot_ne : (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 := by
      intro h0
      apply h2_F_ne
      rw [← map_ofNat e_bot 2, h0, map_zero]
    have h_addVal_two : EllipticRootNumber.addVal F (2 : F) = 0 := by
      have h2_iso : iso (ValuativeRel.valuation F 2) = WithZero.exp (0 : ℤ) := by
        rw [h_val2, map_one, WithZero.exp_zero]
      unfold EllipticRootNumber.addVal
      rw [dif_neg h2_F_ne, h_unzero _ _ 0 h2_iso]
      rfl
    have h_valL_two_mul : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ (2 * x) = EllipticRootNumber.valL F ⊥ x := by
      intro x
      by_cases hx : x = 0
      · rw [hx, mul_zero]
      · rw [h_valL, h_valL, map_mul, map_ofNat,
          h_addVal_mul 2 (e_bot x) h2_F_ne ((map_ne_zero e_bot).mpr hx),
          h_addVal_two, zero_add]
    have hψH_triv : ∀ y : H, 0 ≤ EllipticRootNumber.valL F H y →
        EllipticRootNumber.traceChar F h ψ y = 1 := by
      intro y hy
      obtain ⟨⟨a, b⟩, rfl⟩ := (h_coord y).exists
      have ha : 0 ≤ EllipticRootNumber.valL F ⊥ a := ((h_valL_coord a b).1.mp hy).1
      rw [← h_valL_two_mul a] at ha
      change ψ (EllipticRootNumber.traceLM F h (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) = 1
      rw [h_trace_coord a b]
      exact hψ_triv (2 * a) ha
    obtain ⟨x₀, hx₀_val, hx₀_ne⟩ := hψ_nontriv
    let y₀ : H := IntermediateField.inclusion h (x₀ / 2)
    have hy₀_val : EllipticRootNumber.valL F H y₀ = -1 := by
      change EllipticRootNumber.valL F H (IntermediateField.inclusion h (x₀ / 2)) = -1
      rw [h_valL_inc, ← h_valL_two_mul (x₀ / 2), mul_div_cancel₀ x₀ h2_bot_ne, hx₀_val]
    have hy₀_ne : EllipticRootNumber.traceChar F h ψ y₀ ≠ 1 := by
      have hy₀_eq : y₀ = IntermediateField.inclusion h (x₀ / 2) +
          IntermediateField.inclusion h 0 * (u : H) := by
        simp [y₀]
      change ψ (EllipticRootNumber.traceLM F h y₀) ≠ 1
      rw [hy₀_eq, h_trace_coord (x₀ / 2) 0, mul_div_cancel₀ x₀ h2_bot_ne]
      exact hx₀_ne
    have hψH_adm : EllipticRootNumber.IsAdmissibleChar F H (EllipticRootNumber.traceChar F h ψ) := by
      refine ⟨?_, 0, hψH_triv⟩
      intro h_eq
      apply hy₀_ne
      rw [h_eq, AddChar.one_apply]
    have hψH_cond : EllipticRootNumber.condExpChar F H (EllipticRootNumber.traceChar F h ψ) = 0 := by
      unfold EllipticRootNumber.condExpChar
      apply IsGreatest.csSup_eq
      refine ⟨?_, ?_⟩
      · intro y hy
        rw [neg_zero] at hy
        exact hψH_triv y hy
      · intro d hd
        by_contra h_gt
        have hd_le : -d ≤ EllipticRootNumber.valL F H y₀ := by
          rw [hy₀_val]
          omega
        exact hy₀_ne (hd y₀ hd_le)
    
    have h_tateEps_one : ∀ (L : IntermediateField F (AlgebraicClosure F))
        (ψ_L : AddChar L (EllipticRootNumber.Ω F)),
        EllipticRootNumber.condExpChar F L ψ_L = 0 →
        ∀ (χ' : Lˣ →* (EllipticRootNumber.Ω F)ˣ),
          (∀ x : Lˣ, EllipticRootNumber.valL F L (x : L) = 0 → χ' x = 1) →
          EllipticRootNumber.tateEps F L χ' ψ_L = 1 := by
      intro L ψ_L hψL_cond χ' hχ'_triv
      have h_cond0 : EllipticRootNumber.condExp F L χ' = 0 := by
        unfold EllipticRootNumber.condExp
        apply Nat.sInf_eq_zero.mpr
        left
        change ∀ u ∈ EllipticRootNumber.unitGroup F L 0, χ' u = 1
        have h_le : EllipticRootNumber.unitGroup F L 0 ≤ χ'.ker := by
          unfold EllipticRootNumber.unitGroup
          rw [Subgroup.closure_le]
          intro v hv
          rw [Set.mem_setOf_eq, if_pos rfl] at hv
          exact MonoidHom.mem_ker.mpr (hχ'_triv v hv)
        intro v hv
        exact MonoidHom.mem_ker.mp (h_le hv)
      have h_valL_one : EllipticRootNumber.valL F L ((1 : Lˣ) : L) = 0 := by
        unfold EllipticRootNumber.valL EllipticRootNumber.relVal
        rw [Units.val_one, map_one, h_addVal_one, Int.zero_ediv]
      have h_ex_c : ∃ c : Lˣ, EllipticRootNumber.valL F L (c : L) =
          (EllipticRootNumber.condExp F L χ' : ℤ) + EllipticRootNumber.condExpChar F L ψ_L := by
        refine ⟨1, ?_⟩
        rw [h_valL_one, h_cond0, hψL_cond]
        rfl
      have h_tateElt_val : EllipticRootNumber.valL F L (EllipticRootNumber.tateElt F L χ' ψ_L : L) = 0 := by
        have h_spec := Classical.epsilon_spec h_ex_c
        change EllipticRootNumber.valL F L (EllipticRootNumber.tateElt F L χ' ψ_L : L) = _ at h_spec
        rw [h_spec, h_cond0, hψL_cond]
        rfl
      unfold EllipticRootNumber.tateEps
      rw [hψL_cond, zpow_zero, one_mul, if_pos h_cond0,
        hχ'_triv (EllipticRootNumber.tateElt F L χ' ψ_L) h_tateElt_val, Units.val_one]
    
    let σ_ind := EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H φ)
    let e_f := LinearEquiv.ofBijective f hf_bij
    have hW_indφ : EllipticRootNumber.IsWeilRep F ⊥ σ_ind := by
      refine ⟨?_, ?_⟩
      · haveI := hW_σ.1
        exact e_f.symm.finiteDimensional
      · obtain ⟨U, hU, hU_triv⟩ := hW_σ.2
        refine ⟨U, hU, fun w hwU hwI => ?_⟩
        apply LinearMap.ext
        intro x
        apply hf_bij.1
        have hfx := LinearMap.congr_fun (hf_equiv w) x
        simp only [LinearMap.comp_apply] at hfx
        rw [hfx, hU_triv w hwU hwI, Module.End.one_apply, Module.End.one_apply]
    let σ₀ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) PUnit.{u + 1} := 1
    have hσ₀ : EllipticRootNumber.IsWeilRep F ⊥ σ₀ :=
      ⟨inferInstance, ⟨Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩⟩
    have h_eps₀_mul : lc.eps ⊥ σ₀ ψ = lc.eps ⊥ σ₀ ψ * lc.eps ⊥ σ₀ ψ := by
      apply lc.eps_exact ⊥ ψ hψ_adm σ₀ σ₀ σ₀ hσ₀ hσ₀ hσ₀ 0 0
      · intro _; exact Subsingleton.elim _ _
      · intro _; exact Subsingleton.elim _ _
      · intro x y _; exact Subsingleton.elim x y
      · intro y; exact ⟨0, Subsingleton.elim _ _⟩
      · exact Subsingleton.elim _ _
    have h_eps₀ : lc.eps ⊥ σ₀ ψ = 1 := by simpa using h_eps₀_mul.symm
    have h_eps_indφ : lc.eps ⊥ σ_ind ψ = lc.eps ⊥ σ ψ := by
      have h_ex := lc.eps_exact ⊥ ψ hψ_adm σ₀ σ_ind σ hσ₀ hW_indφ hW_σ 0 f
        (fun _ => by ext x; simp) hf_equiv
        (fun x y _ => Subsingleton.elim x y) hf_bij.2
        (by rw [LinearMap.range_zero, LinearMap.ker_eq_bot.mpr hf_bij.1])
      rw [h_eps₀, one_mul] at h_ex
      exact h_ex
    
    let G := EllipticRootNumber.relWeil F ⊥
    let K := (EllipticRootNumber.relWeil F H).subgroupOf G
    let degHom : G →* Multiplicative ℤ :=
      (EllipticRootNumber.weilDegreeHom F).comp
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥))
    have hK_mem : ∀ w : G, w ∈ K ↔ 2 ∣ Multiplicative.toAdd (degHom w) := by
      intro w
      have hw1 : (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.weilGroup F := w.2.1
      change (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.weilGroup F ∧
        (w : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔ _
      rw [and_iff_right hw1]
      exact hH_weil w
    let η : G →* (EllipticRootNumber.Ω F)ˣ :=
      (zpowersHom (EllipticRootNumber.Ω F)ˣ (-1 : (EllipticRootNumber.Ω F)ˣ)).comp degHom
    have h_neg_one_zpow_even : ∀ m : ℤ, 2 ∣ m → (-1 : (EllipticRootNumber.Ω F)ˣ) ^ m = 1 := by
      rintro _ ⟨k, rfl⟩
      rw [zpow_mul, zpow_two, neg_mul_neg, one_mul, one_zpow]
    have h_neg_one_zpow_odd : ∀ m : ℤ, ¬ (2 ∣ m) → (-1 : (EllipticRootNumber.Ω F)ˣ) ^ m = -1 := by
      intro m hm
      have hm_eq : m = 2 * (m / 2) + 1 := by omega
      rw [hm_eq, zpow_add, h_neg_one_zpow_even (2 * (m / 2)) ⟨m / 2, rfl⟩, one_mul, zpow_one]
    have hη_of_mem : ∀ w : G, w ∈ K → η w = 1 := by
      intro w hw
      exact h_neg_one_zpow_even (Multiplicative.toAdd (degHom w)) ((hK_mem w).mp hw)
    have hη_of_not_mem : ∀ w : G, w ∉ K → η w = -1 := by
      intro w hw
      exact h_neg_one_zpow_odd (Multiplicative.toAdd (degHom w)) (mt (hK_mem w).mpr hw)
    let η' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ :=
      { toFun := fun x => (-1 : (EllipticRootNumber.Ω F)ˣ) ^
          (-EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))
        map_one' := by
          rw [Units.val_one, h_relVal, map_one, h_addVal_one, neg_zero, zpow_zero]
        map_mul' := fun x y => by
          have hx0 : e_bot (x : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
            (map_ne_zero e_bot).mpr (Units.ne_zero x)
          have hy0 : e_bot (y : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
            (map_ne_zero e_bot).mpr (Units.ne_zero y)
          rw [Units.val_mul, h_relVal, h_relVal, h_relVal, map_mul,
            h_addVal_mul _ _ hx0 hy0, neg_add, zpow_add] }
    have hη'_rec : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        η' x = η (rec.recMap ⊥ x) := by
      intro x
      change (-1 : (EllipticRootNumber.Ω F)ˣ) ^
          (-EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) =
        (-1 : (EllipticRootNumber.Ω F)ˣ) ^ Multiplicative.toAdd (degHom (rec.recMap ⊥ x))
      congr 1
      have hdeg := rec.degree_rec ⊥ x
      change degHom (rec.recMap ⊥ x) =
        Multiplicative.ofAdd (-EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) at hdeg
      rw [hdeg, toAdd_ofAdd]
    have hη'_triv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 → η' x = 1 := by
      intro x hx
      rw [h_valL, ← h_relVal] at hx
      change (-1 : (EllipticRootNumber.Ω F)ˣ) ^
        (-EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1
      rw [hx, neg_zero, zpow_zero]
    let π_bot : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ :=
      Units.mk0 (e_bot.symm π) (by
        intro h0
        apply hπ0
        have := congrArg e_bot h0
        simpa using this)
    let w₀ : G := rec.recMap ⊥ π_bot
    have hdeg_w₀ : Multiplicative.toAdd (degHom w₀) = -1 := by
      have hdeg := rec.degree_rec ⊥ π_bot
      change degHom w₀ =
        Multiplicative.ofAdd (-EllipticRootNumber.relVal F ⊥ (π_bot : (⊥ : IntermediateField F (AlgebraicClosure F)))) at hdeg
      rw [hdeg, toAdd_ofAdd, h_relVal, Units.val_mk0, e_bot.apply_symm_apply, hπ_addVal]
    have hw₀_not_K : w₀ ∉ K := by
      rw [hK_mem, hdeg_w₀]
      omega
    have hdeg_mul : ∀ g₁ g₂ : G,
        Multiplicative.toAdd (degHom (g₁ * g₂)) =
          Multiplicative.toAdd (degHom g₁) + Multiplicative.toAdd (degHom g₂) := by
      intro g₁ g₂
      rw [map_mul, toAdd_mul]
    have hdeg_inv : ∀ g : G,
        Multiplicative.toAdd (degHom g⁻¹) = -Multiplicative.toAdd (degHom g) := by
      intro g
      rw [map_inv, toAdd_inv]
    have h_not_K_mul_w₀_inv : ∀ g : G, g ∉ K → g * w₀⁻¹ ∈ K := by
      intro g hg
      rw [hK_mem] at hg ⊢
      rw [hdeg_mul, hdeg_inv, hdeg_w₀]
      omega
    have h_w₀_mul_mem_iff : ∀ g : G, w₀ * g ∈ K ↔ g ∉ K := by
      intro g
      rw [hK_mem, hK_mem, hdeg_mul, hdeg_w₀]
      omega
    let ρ₀ := (EllipticRootNumber.charRep F H 1).comp
      (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom
    let W := EllipticRootNumber.indSpace K ρ₀
    have hρ₀_apply : ∀ (k : K) (v : ULift.{u} (EllipticRootNumber.Ω F)), ρ₀ k v = v := by
      intro k v
      change EllipticRootNumber.charRep F H 1 _ v = v
      unfold EllipticRootNumber.charRep
      simp
    have hW_val : ∀ (α : W) (g : G), α.1 g = if g ∈ K then α.1 1 else α.1 w₀ := by
      intro α g
      by_cases hg : g ∈ K
      · rw [if_pos hg]
        have h1 := α.2 ⟨g, hg⟩ 1
        rw [mul_one, hρ₀_apply] at h1
        exact h1
      · rw [if_neg hg]
        have hk : g * w₀⁻¹ ∈ K := h_not_K_mul_w₀_inv g hg
        have h2 := α.2 ⟨g * w₀⁻¹, hk⟩ w₀
        rw [inv_mul_cancel_right, hρ₀_apply] at h2
        exact h2
    have h_mk_W : ∀ c₀ c₁ : ULift.{u} (EllipticRootNumber.Ω F),
        (fun g : G => if g ∈ K then c₀ else c₁) ∈ W := by
      intro c₀ c₁ k g
      rw [hρ₀_apply]
      dsimp only
      have h_iff : (k : G) * g ∈ K ↔ g ∈ K :=
        ⟨fun hkg => by simpa using K.mul_mem (K.inv_mem k.2) hkg, fun hg => K.mul_mem k.2 hg⟩
      by_cases hg : g ∈ K
      · rw [if_pos (h_iff.mpr hg), if_pos hg]
      · rw [if_neg (mt h_iff.mp hg), if_neg hg]
    let e_W : W ≃ₗ[EllipticRootNumber.Ω F]
        ULift.{u} (EllipticRootNumber.Ω F) × ULift.{u} (EllipticRootNumber.Ω F) :=
      { toFun := fun α => (α.1 1, α.1 w₀)
        invFun := fun p => ⟨fun g => if g ∈ K then p.1 else p.2, h_mk_W p.1 p.2⟩
        left_inv := fun α => Subtype.ext (funext fun g => (hW_val α g).symm)
        right_inv := fun p => Prod.ext (if_pos K.one_mem) (if_neg hw₀_not_K)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    haveI : FiniteDimensional (EllipticRootNumber.Ω F) W := e_W.symm.finiteDimensional
    have h_inertia_K : ∀ w : G, (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → w ∈ K := by
      intro w hw
      have hw_H : (w : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup :=
        IntermediateField.fixingSubgroup_le hH_unr hw
      exact ⟨w.2.1, hw_H⟩
    have hW_η : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ η) := by
      refine ⟨inferInstance, ⟨Set.univ, Filter.univ_mem, fun w _ hwI => ?_⟩⟩
      apply LinearMap.ext
      intro v
      change (η w : EllipticRootNumber.Ω F) • v = v
      rw [hη_of_mem w (h_inertia_K w hwI), Units.val_one, one_smul]
    have hW_ind1 : EllipticRootNumber.IsWeilRep F ⊥
        (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H 1)) := by
      refine ⟨inferInstance, ⟨Set.univ, Filter.univ_mem, fun w _ hwI => ?_⟩⟩
      have hwK : w ∈ K := h_inertia_K w hwI
      apply LinearMap.ext
      intro α
      apply Subtype.ext
      funext g
      change α.1 (g * w) = α.1 g
      rw [hW_val α (g * w), hW_val α g]
      have h_iff : g * w ∈ K ↔ g ∈ K :=
        ⟨fun hgw => by simpa using K.mul_mem hgw (K.inv_mem hwK), fun hg => K.mul_mem hg hwK⟩
      by_cases hg : g ∈ K
      · rw [if_pos (h_iff.mpr hg), if_pos hg]
      · rw [if_neg (mt h_iff.mp hg), if_neg hg]
    let f₀ : ULift.{u} (EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F] W :=
      { toFun := fun c => ⟨fun _ => c, fun k _ => (hρ₀_apply k c).symm⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    let g₀ : W →ₗ[EllipticRootNumber.Ω F] ULift.{u} (EllipticRootNumber.Ω F) :=
      { toFun := fun α => α.1 1 - α.1 w₀
        map_add' := fun α₁ α₂ => (sub_add_sub_comm (α₁.1 1) (α₁.1 w₀) (α₂.1 1) (α₂.1 w₀)).symm
        map_smul' := fun c α => (smul_sub c (α.1 1) (α.1 w₀)).symm }
    have hf₀_eq : ∀ w : G,
        f₀ ∘ₗ EllipticRootNumber.charRep F ⊥ 1 w =
          EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H 1) w ∘ₗ f₀ := by
      intro w
      apply LinearMap.ext
      intro c
      apply Subtype.ext
      funext g
      exact one_smul (EllipticRootNumber.Ω F) c
    have hg₀_eq : ∀ w : G,
        g₀ ∘ₗ EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H 1) w =
          EllipticRootNumber.charRep F ⊥ η w ∘ₗ g₀ := by
      intro w
      apply LinearMap.ext
      intro α
      change α.1 (1 * w) - α.1 (w₀ * w) = (η w : EllipticRootNumber.Ω F) • (α.1 1 - α.1 w₀)
      rw [one_mul, hW_val α w, hW_val α (w₀ * w)]
      by_cases hw : w ∈ K
      · have hw₀w : w₀ * w ∉ K := mt (h_w₀_mul_mem_iff w).mp (not_not.mpr hw)
        rw [if_pos hw, if_neg hw₀w, hη_of_mem w hw, Units.val_one, one_smul]
      · have hw₀w : w₀ * w ∈ K := (h_w₀_mul_mem_iff w).mpr hw
        rw [if_neg hw, if_pos hw₀w, hη_of_not_mem w hw, Units.val_neg, Units.val_one,
          neg_one_smul, neg_sub]
    have hf₀_inj : Function.Injective f₀ := by
      intro c₁ c₂ hc
      exact congrFun (congrArg Subtype.val hc) 1
    have hg₀_surj : Function.Surjective g₀ := by
      intro c
      refine ⟨⟨fun g => if g ∈ K then c else 0, h_mk_W c 0⟩, ?_⟩
      change (if (1 : G) ∈ K then c else 0) - (if w₀ ∈ K then c else 0) = c
      rw [if_pos K.one_mem, if_neg hw₀_not_K, sub_zero]
    have h_exact₀ : LinearMap.range f₀ = LinearMap.ker g₀ := by
      ext α
      rw [LinearMap.mem_range, LinearMap.mem_ker]
      constructor
      · rintro ⟨c, rfl⟩
        exact sub_self c
      · intro hα
        have h_eq : α.1 1 = α.1 w₀ := sub_eq_zero.mp hα
        refine ⟨α.1 1, Subtype.ext (funext fun g => ?_)⟩
        rw [hW_val α g, h_eq, ite_self]
        rfl
    
    have hW_1H : EllipticRootNumber.IsWeilRep F H (EllipticRootNumber.charRep F H 1) :=
      ⟨inferInstance, ⟨Set.univ, Filter.univ_mem, fun _ _ _ => by
        unfold EllipticRootNumber.charRep; ext; simp⟩⟩
    have hW_1bot : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ 1) :=
      ⟨inferInstance, ⟨Set.univ, Filter.univ_mem, fun _ _ _ => by
        unfold EllipticRootNumber.charRep; ext; simp⟩⟩
    have h_eps_1H : lc.eps H (EllipticRootNumber.charRep F H 1) (EllipticRootNumber.traceChar F h ψ) = 1 := by
      apply Units.ext
      rw [lc.eps_char H (EllipticRootNumber.traceChar F h ψ) hψH_adm 1 hW_1H 1 (fun _ => rfl),
        Units.val_one]
      exact h_tateEps_one H (EllipticRootNumber.traceChar F h ψ) hψH_cond 1 (fun _ _ => rfl)
    have h_eps_1bot : lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ 1) ψ = 1 := by
      apply Units.ext
      rw [lc.eps_char ⊥ ψ hψ_adm 1 hW_1bot 1 (fun _ => rfl), Units.val_one]
      exact h_tateEps_one ⊥ ψ hψ_cond 1 (fun _ _ => rfl)
    have h_eps_η : lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ η) ψ = 1 := by
      apply Units.ext
      rw [lc.eps_char ⊥ ψ hψ_adm η hW_η η' hη'_rec, Units.val_one]
      exact h_tateEps_one ⊥ ψ hψ_cond η' hη'_triv
    have h_eps_ind1 : lc.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H 1)) ψ = 1 := by
      rw [lc.eps_exact ⊥ ψ hψ_adm (EllipticRootNumber.charRep F ⊥ 1)
            (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F H 1))
            (EllipticRootNumber.charRep F ⊥ η)
            hW_1bot hW_ind1 hW_η f₀ g₀ hf₀_eq hg₀_eq hf₀_inj hg₀_surj h_exact₀,
        h_eps_1bot, h_eps_η, mul_one]
    have h_ind_eq := lc.eps_ind ⊥ H h hH_sep ψ hψ_adm
      (EllipticRootNumber.charRep F H φ) (EllipticRootNumber.charRep F H 1) hW_φ hW_1H rfl
    rw [h_eps_indφ, h_eps_1H, h_eps_ind1, mul_one, one_mul] at h_ind_eq
    rw [h_ind_eq, lc.eps_char H (EllipticRootNumber.traceChar F h ψ) hψH_adm φ hW_φ φ' hφ'_rec]
  )

theorem unramified_quadratic_valL_add_and_unitGroup_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hd_nonsq : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b))) :
    (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x ↔
        ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x) ≤ 1) ∧
    (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (x = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ x) ↔
        ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x) < 1) ∧
    (∀ x y : H, x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F H (x * y) =
        EllipticRootNumber.valL F H x + EllipticRootNumber.valL F H y) ∧
    (∀ v : Hˣ,
      EllipticRootNumber.valL F H ((v⁻¹ : Hˣ) : H) =
        -EllipticRootNumber.valL F H (v : H)) ∧
    (∀ v : Hˣ,
      v ∈ EllipticRootNumber.unitGroup F H 0 ↔
        EllipticRootNumber.valL F H (v : H) = 0) ∧
    (∀ v : Hˣ,
      v ∈ EllipticRootNumber.unitGroup F H 1 ↔
        ((v : H) = 1 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1))) ∧
    EllipticRootNumber.unitGroup F H 1 ≤ EllipticRootNumber.unitGroup F H 0 :=
by
  open ValuativeRel in
  (
    let B : IntermediateField F (AlgebraicClosure F) := ⊥
    let e_bot : B ≃ₐ[F] F := IntermediateField.botEquiv F (AlgebraicClosure F)
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
        z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
      rintro _ hz m rfl
      exact WithZero.unzero_coe hz
    have h_addVal_of_iso : ∀ (y : F) (m : ℤ),
        iso (ValuativeRel.valuation F y) = WithZero.exp m →
        y ≠ 0 ∧ EllipticRootNumber.addVal F y = -m := by
      intro y m hy_iso
      have h_exp_ne : WithZero.exp m ≠ 0 := WithZero.exp_ne_zero
      have h_iso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := by rw [hy_iso]; exact h_exp_ne
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := fun h0 => h_iso_ne (by rw [h0, map_zero])
      have hy : y ≠ 0 := (Valuation.ne_zero_iff _).mp hv_ne
      refine ⟨hy, ?_⟩
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy, h_unzero _ _ m hy_iso]
      rfl
    obtain ⟨π, hπ_val_raw⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      rw [hπ_val_raw, iso.apply_symm_apply]
    have hπ_ne : π ≠ 0 := (h_addVal_of_iso π (-1) hπ_iso).1
    have hπ_val : EllipticRootNumber.addVal F π = 1 := by
      have h1 := (h_addVal_of_iso π (-1) hπ_iso).2
      omega
    have h_addVal_one : EllipticRootNumber.addVal F 1 = 0 := by
      have h1 : iso (ValuativeRel.valuation F 1) = WithZero.exp (0 : ℤ) := by
        rw [Valuation.map_one, map_one, WithZero.exp_zero]
      have h2 := (h_addVal_of_iso 1 0 h1).2
      omega
    have h_addVal_mul : ∀ x y : F, x ≠ 0 → y ≠ 0 →
        EllipticRootNumber.addVal F (x * y) =
          EllipticRootNumber.addVal F x + EllipticRootNumber.addVal F y := by
      intro x y hx hy
      have hv_x : ValuativeRel.valuation F x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
      have hiso_x : iso (ValuativeRel.valuation F x) ≠ 0 := (map_ne_zero _).mpr hv_x
      set ux := WithZero.unzero hiso_x
      have hux : iso (ValuativeRel.valuation F x) = WithZero.exp (Multiplicative.toAdd ux) := by
        rw [← WithZero.coe_unzero hiso_x]; rfl
      have hv_y : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_y : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_y
      set uy := WithZero.unzero hiso_y
      have huy : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd uy) := by
        rw [← WithZero.coe_unzero hiso_y]; rfl
      have hxy_iso : iso (ValuativeRel.valuation F (x * y)) =
          WithZero.exp (Multiplicative.toAdd ux + Multiplicative.toAdd uy) := by
        rw [Valuation.map_mul, map_mul, hux, huy, ← WithZero.exp_add]
      rw [(h_addVal_of_iso (x * y) _ hxy_iso).2,
        (h_addVal_of_iso x _ hux).2, (h_addVal_of_iso y _ huy).2]
      omega
    have h_addVal_eq : ∀ x y : F,
        ValuativeRel.valuation F x = ValuativeRel.valuation F y →
        EllipticRootNumber.addVal F x = EllipticRootNumber.addVal F y := by
      intro x y hxy
      by_cases hx : x = 0
      · subst hx
        have hy0 : ValuativeRel.valuation F y = 0 := by rw [← hxy, Valuation.map_zero]
        have hy : y = 0 := (Valuation.zero_iff _).mp hy0
        rw [hy]
      · have hv_x : ValuativeRel.valuation F x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
        have hiso_x : iso (ValuativeRel.valuation F x) ≠ 0 := (map_ne_zero _).mpr hv_x
        set ux := WithZero.unzero hiso_x
        have hux : iso (ValuativeRel.valuation F x) = WithZero.exp (Multiplicative.toAdd ux) := by
          rw [← WithZero.coe_unzero hiso_x]; rfl
        have huy : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd ux) := by
          rw [← hxy, hux]
        rw [(h_addVal_of_iso x _ hux).2, (h_addVal_of_iso y _ huy).2]
    have h_addVal_sq : ∀ x : F,
        EllipticRootNumber.addVal F (x ^ 2) = 2 * EllipticRootNumber.addVal F x := by
      intro x
      by_cases hx : x = 0
      · subst hx
        unfold EllipticRootNumber.addVal
        have h02 : (0 : F) ^ 2 = 0 := by ring
        rw [h02, dif_pos rfl]
        omega
      · rw [sq, h_addVal_mul x x hx hx]
        omega
    have h_addVal_zero_iff : ∀ y : F, y ≠ 0 →
        (EllipticRootNumber.addVal F y = 0 ↔ ValuativeRel.valuation F y = 1) := by
      intro y hy
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]; rfl
      have h_val_one : ValuativeRel.valuation F y = 1 ↔ Multiplicative.toAdd z = 0 := by
        rw [← EmbeddingLike.apply_eq_iff_eq iso, hz_eq, map_one, ← WithZero.exp_zero,
          WithZero.exp_injective.eq_iff]
      rw [h_val_one]
      omega
    have h_addVal_nonneg : ∀ y : F,
        0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
      intro y
      by_cases hy : y = 0
      · subst hy
        unfold EllipticRootNumber.addVal
        rw [dif_pos rfl, Valuation.map_zero]
        exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
      · unfold EllipticRootNumber.addVal
        rw [dif_neg hy]
        have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
        have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
        set z := WithZero.unzero hiso_ne
        have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
          rw [← WithZero.coe_unzero hiso_ne]; rfl
        rw [← map_le_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
        omega
    have h_addVal_pos : ∀ y : F,
        (y = 0 ∨ 1 ≤ EllipticRootNumber.addVal F y) ↔ ValuativeRel.valuation F y < 1 := by
      intro y
      by_cases hy : y = 0
      · subst hy
        rw [Valuation.map_zero]
        exact ⟨fun _ => zero_lt_one, fun _ => Or.inl rfl⟩
      · rw [or_iff_right hy]
        unfold EllipticRootNumber.addVal
        rw [dif_neg hy]
        have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
        have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
        set z := WithZero.unzero hiso_ne
        have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
          rw [← WithZero.coe_unzero hiso_ne]; rfl
        rw [← map_lt_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
        omega
    have h_relVal_bot : ∀ x : B,
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.relVal
      have h_norm_bot : Algebra.norm F x = e_bot x := by
        rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
        rfl
      rw [h_norm_bot]
    have h_resDeg_bot : EllipticRootNumber.resDeg F ⊥ = 1 := by
      unfold EllipticRootNumber.resDeg
      apply IsLeast.csInf_eq
      refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
      · intro h0
        apply hπ_ne
        have := congrArg e_bot h0
        simpa using this
      · rw [h_relVal_bot, e_bot.apply_symm_apply, hπ_val]
        omega
      · rintro k ⟨hk, _⟩
        exact hk
    have h_valL_bot : ∀ x : B,
        EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.valL
      rw [h_relVal_bot, h_resDeg_bot, Nat.cast_one, Int.ediv_one]
    have h_bot_le : ∀ x : B,
        0 ≤ EllipticRootNumber.valL F ⊥ x ↔
          ValuativeRel.valuation F (e_bot x) ≤ 1 := by
      intro x
      rw [h_valL_bot, h_addVal_nonneg]
    have h_bot_lt : ∀ x : B,
        (x = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ x) ↔
          ValuativeRel.valuation F (e_bot x) < 1 := by
      intro x
      rw [h_valL_bot, ← h_addVal_pos (e_bot x), map_eq_zero]

    
    have hd_sub_ne : ∀ a : B, (d : B) - a ^ 2 ≠ 0 := by
      intro a h0
      have hd_eq : (d : B) = a ^ 2 := sub_eq_zero.mp h0
      have hu_sq_a : (u : H) ^ 2 = (IntermediateField.inclusion h a) ^ 2 := by
        rw [hu_sq, hd_eq, map_pow]
      have hu_coord1 : (u : H) =
          IntermediateField.inclusion h 0 + IntermediateField.inclusion h 1 * (u : H) := by
        simp
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp hu_sq_a with hu_eq | hu_eq
      · have hu_coord2 : (u : H) =
            IntermediateField.inclusion h a + IntermediateField.inclusion h 0 * (u : H) := by
          rw [hu_eq]; simp
        have hp : ((0 : B), (1 : B)) = (a, (0 : B)) :=
          (h_coord (u : H)).unique hu_coord1 hu_coord2
        exact zero_ne_one (Prod.ext_iff.mp hp).2.symm
      · have hu_coord2 : (u : H) =
            IntermediateField.inclusion h (-a) + IntermediateField.inclusion h 0 * (u : H) := by
          rw [hu_eq, map_neg]; simp
        have hp : ((0 : B), (1 : B)) = (-a, (0 : B)) :=
          (h_coord (u : H)).unique hu_coord1 hu_coord2
        exact zero_ne_one (Prod.ext_iff.mp hp).2.symm

    let d_F : F := e_bot (d : B)
    have hd_F_ne : d_F ≠ 0 := (map_ne_zero e_bot).mpr (Units.ne_zero d)
    have hd_F_val : ValuativeRel.valuation F d_F = 1 := by
      rw [← h_addVal_zero_iff d_F hd_F_ne, ← h_valL_bot (d : B)]
      exact hd_val
    have hd_nonsq_val : ∀ y : F, ValuativeRel.valuation F y ≤ 1 →
        ValuativeRel.valuation F (d_F - y ^ 2) = 1 := by
      intro y hy
      let a : B := e_bot.symm y
      have ha_val : 0 ≤ EllipticRootNumber.valL F ⊥ a := by
        rw [h_bot_le, e_bot.apply_symm_apply]
        exact hy
      have hd_a := hd_nonsq a ha_val
      have h_sub_eq : e_bot ((d : B) - a ^ 2) = d_F - y ^ 2 := by
        rw [map_sub, map_pow, e_bot.apply_symm_apply]
      have h_sub_ne : d_F - y ^ 2 ≠ 0 := by
        rw [← h_sub_eq]
        exact (map_ne_zero e_bot).mpr (hd_sub_ne a)
      rw [← h_addVal_zero_iff (d_F - y ^ 2) h_sub_ne, ← h_sub_eq, ← h_valL_bot]
      exact hd_a

    have h_inc_eq : ∀ a : B, IntermediateField.inclusion h a = algebraMap F H (e_bot a) := by
      intro a
      have ha : algebraMap F B (e_bot a) = a := by
        rw [← IntermediateField.botEquiv_symm]
        exact e_bot.symm_apply_apply a
      apply Subtype.ext
      change (a : AlgebraicClosure F) = algebraMap F (AlgebraicClosure F) (e_bot a)
      have ha_val := congrArg (Subtype.val : B → AlgebraicClosure F) ha
      exact ha_val.symm
    have h_smul_eq : ∀ a b : B,
        IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) =
          (e_bot a) • (1 : H) + (e_bot b) • (u : H) := by
      intro a b
      rw [h_inc_eq a, h_inc_eq b, Algebra.smul_def, mul_one, Algebra.smul_def]
    let coord : H → B × B := fun y => Classical.choose (h_coord y).exists
    have h_coord_spec : ∀ y : H,
        y = IntermediateField.inclusion h (coord y).1 +
          IntermediateField.inclusion h (coord y).2 * (u : H) :=
      fun y => Classical.choose_spec (h_coord y).exists
    let e_symm : (Fin 2 → F) ≃ₗ[F] H :=
      { toFun := fun f => f 0 • (1 : H) + f 1 • (u : H)
        map_add' := fun f g => by simp only [Pi.add_apply, add_smul]; abel
        map_smul' := fun c f => by
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, smul_add, mul_smul]
        invFun := fun y i => if i = 0 then e_bot (coord y).1 else e_bot (coord y).2
        left_inv := fun f => by
          have hf_eq : f 0 • (1 : H) + f 1 • (u : H) =
              IntermediateField.inclusion h (e_bot.symm (f 0)) +
                IntermediateField.inclusion h (e_bot.symm (f 1)) * (u : H) := by
            rw [h_smul_eq, e_bot.apply_symm_apply, e_bot.apply_symm_apply]
          have hp : coord (f 0 • (1 : H) + f 1 • (u : H)) =
              (e_bot.symm (f 0), e_bot.symm (f 1)) :=
            (h_coord (f 0 • (1 : H) + f 1 • (u : H))).unique (h_coord_spec _) hf_eq
          funext i
          refine Fin.cases ?_ ?_ i
          · dsimp only
            rw [if_pos rfl, hp, e_bot.apply_symm_apply]
          · intro j
            rw [Fin.eq_zero j]
            have h1 : Fin.succ (0 : Fin 1) = (1 : Fin 2) := rfl
            dsimp only
            rw [h1, if_neg (by decide : (1 : Fin 2) ≠ 0), hp, e_bot.apply_symm_apply]
        right_inv := fun y => by
          dsimp only
          rw [if_pos rfl, if_neg (by decide : (1 : Fin 2) ≠ 0), ← h_smul_eq]
          exact (h_coord_spec y).symm }
    let b₂ : Module.Basis (Fin 2) F H := Module.Basis.ofEquivFun e_symm.symm
    have hb₂0 : b₂ 0 = 1 := by
      have h0 := congrFun (Module.Basis.coe_ofEquivFun e_symm.symm) 0
      dsimp [b₂, e_symm] at h0 ⊢
      rw [h0, Pi.single_eq_same, Pi.single_eq_of_ne (by decide : (1 : Fin 2) ≠ 0),
        one_smul, zero_smul, add_zero]
    have hb₂1 : b₂ 1 = (u : H) := by
      have h1 := congrFun (Module.Basis.coe_ofEquivFun e_symm.symm) 1
      dsimp [b₂, e_symm] at h1 ⊢
      rw [h1, Pi.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1), Pi.single_eq_same,
        zero_smul, one_smul, zero_add]
    have h_lin_comb : ∀ a b : B,
        IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) =
          (e_bot a) • b₂ 0 + (e_bot b) • b₂ 1 := by
      intro a b
      rw [hb₂0, hb₂1, h_smul_eq]
    have h_repr0 : ∀ c₀ c₁ : F, b₂.repr (c₀ • b₂ 0 + c₁ • b₂ 1) 0 = c₀ := by
      intro c₀ c₁
      rw [LinearEquiv.map_add, LinearEquiv.map_smul, LinearEquiv.map_smul,
        Finsupp.coe_add, Finsupp.coe_smul, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply,
        Pi.smul_apply, smul_eq_mul, smul_eq_mul, Module.Basis.repr_self, Module.Basis.repr_self,
        Finsupp.single_eq_same, Finsupp.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1)]
      ring
    have h_repr1 : ∀ c₀ c₁ : F, b₂.repr (c₀ • b₂ 0 + c₁ • b₂ 1) 1 = c₁ := by
      intro c₀ c₁
      rw [LinearEquiv.map_add, LinearEquiv.map_smul, LinearEquiv.map_smul,
        Finsupp.coe_add, Finsupp.coe_smul, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply,
        Pi.smul_apply, smul_eq_mul, smul_eq_mul, Module.Basis.repr_self, Module.Basis.repr_self,
        Finsupp.single_eq_of_ne (by decide : (1 : Fin 2) ≠ 0), Finsupp.single_eq_same]
      ring
    have hu_H_sq : (u : H) ^ 2 = algebraMap F H d_F := by
      rw [hu_sq, h_inc_eq (d : B)]
    have h_mul_b0 : ∀ c₀ c₁ : F,
        (c₀ • b₂ 0 + c₁ • b₂ 1) * b₂ 0 = c₀ • b₂ 0 + c₁ • b₂ 1 := by
      intro c₀ c₁
      rw [hb₂0, mul_one]
    have h_mul_b1 : ∀ c₀ c₁ : F,
        (c₀ • b₂ 0 + c₁ • b₂ 1) * b₂ 1 = (c₁ * d_F) • b₂ 0 + c₀ • b₂ 1 := by
      intro c₀ c₁
      rw [hb₂0, hb₂1, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
        map_mul]
      calc (algebraMap F H c₀ * 1 + algebraMap F H c₁ * (u : H)) * (u : H)
          = algebraMap F H c₁ * (u : H) ^ 2 + algebraMap F H c₀ * (u : H) := by ring
        _ = (algebraMap F H c₁ * algebraMap F H d_F) * 1 + algebraMap F H c₀ * (u : H) := by
            rw [hu_H_sq, mul_one]
    have h_norm : ∀ a b : B,
        Algebra.norm F (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) =
          (e_bot a) ^ 2 - d_F * (e_bot b) ^ 2 := by
      intro a b
      rw [h_lin_comb a b, Algebra.norm_eq_matrix_det b₂, Matrix.det_fin_two,
        Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul,
        Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul,
        h_mul_b0, h_mul_b1, h_repr0, h_repr1, h_repr0, h_repr1]
      ring
    have h_norm_val_max : ∀ x y : F,
        ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) =
          max (ValuativeRel.valuation F x) (ValuativeRel.valuation F y) ^ 2 := by
      intro x y
      have hv_x2 : ValuativeRel.valuation F (x ^ 2) = ValuativeRel.valuation F x ^ 2 :=
        map_pow _ x 2
      have hv_dy2 : ValuativeRel.valuation F (d_F * y ^ 2) = ValuativeRel.valuation F y ^ 2 := by
        rw [map_mul, map_pow, hd_F_val, one_mul]
      rcases lt_trichotomy (ValuativeRel.valuation F x) (ValuativeRel.valuation F y) with hlt | heq | hgt
      · have hlt2 : ValuativeRel.valuation F (x ^ 2) < ValuativeRel.valuation F (d_F * y ^ 2) := by
          rw [hv_x2, hv_dy2, sq, sq]
          exact mul_lt_mul' (le_of_lt hlt) hlt zero_le' (zero_le'.trans_lt hlt)
        rw [Valuation.map_sub_eq_of_lt_right _ hlt2, hv_dy2, max_eq_right (le_of_lt hlt)]
      · by_cases hy : y = 0
        · subst hy
          have hx0 : ValuativeRel.valuation F x = 0 := by rw [heq, Valuation.map_zero]
          have hx : x = 0 := (Valuation.zero_iff _).mp hx0
          subst hx
          simp
        · have hv_y_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
          have hxy_le : ValuativeRel.valuation F (x / y) ≤ 1 := by
            rw [map_div₀, heq, div_self hv_y_ne]
          have hd_xy : ValuativeRel.valuation F (d_F - (x / y) ^ 2) = 1 :=
            hd_nonsq_val (x / y) hxy_le
          have h_alg : x ^ 2 - d_F * y ^ 2 = -(y ^ 2 * (d_F - (x / y) ^ 2)) := by
            field_simp [hy]
            ring
          rw [h_alg, Valuation.map_neg, map_mul, map_pow, hd_xy, mul_one, heq, max_self]
      · have hgt2 : ValuativeRel.valuation F (d_F * y ^ 2) < ValuativeRel.valuation F (x ^ 2) := by
          rw [hv_x2, hv_dy2, sq, sq]
          exact mul_lt_mul' (le_of_lt hgt) hgt zero_le' (zero_le'.trans_lt hgt)
        rw [Valuation.map_sub_eq_of_lt_left _ hgt2, hv_x2, max_eq_left (le_of_lt hgt)]
    have h_norm_val_choice : ∀ x y : F,
        ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) = ValuativeRel.valuation F (x ^ 2) ∨
        ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) = ValuativeRel.valuation F (y ^ 2) := by
      intro x y
      rw [h_norm_val_max, map_pow, map_pow]
      rcases max_choice (ValuativeRel.valuation F x) (ValuativeRel.valuation F y) with hmax | hmax
      · left; rw [hmax]
      · right; rw [hmax]
    have h_relVal_choice : ∀ a b : B,
        EllipticRootNumber.relVal F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) =
          2 * EllipticRootNumber.valL F ⊥ a ∨
        EllipticRootNumber.relVal F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) =
          2 * EllipticRootNumber.valL F ⊥ b := by
      intro a b
      unfold EllipticRootNumber.relVal
      rw [h_norm a b]
      rcases h_norm_val_choice (e_bot a) (e_bot b) with h1 | h2
      · left
        rw [h_addVal_eq _ _ h1, h_addVal_sq, ← h_valL_bot]
      · right
        rw [h_addVal_eq _ _ h2, h_addVal_sq, ← h_valL_bot]
    have h_relVal_even : ∀ y : H, ∃ m : ℤ, EllipticRootNumber.relVal F H y = 2 * m := by
      intro y
      obtain ⟨⟨a, b⟩, hy⟩ := (h_coord y).exists
      rw [hy]
      rcases h_relVal_choice a b with h1 | h2
      · exact ⟨EllipticRootNumber.valL F ⊥ a, h1⟩
      · exact ⟨EllipticRootNumber.valL F ⊥ b, h2⟩
    have h_relVal_inc : ∀ a : B,
        EllipticRootNumber.relVal F H (IntermediateField.inclusion h a) =
          2 * EllipticRootNumber.valL F ⊥ a := by
      intro a
      have h_inc_0 : IntermediateField.inclusion h a =
          IntermediateField.inclusion h a + IntermediateField.inclusion h 0 * (u : H) := by
        simp
      rw [h_inc_0]
      unfold EllipticRootNumber.relVal
      rw [h_norm a 0, map_zero, sq (0 : F), mul_zero, mul_zero, sub_zero, h_addVal_sq, ← h_valL_bot]
    have h_resDeg_H : EllipticRootNumber.resDeg F H = 2 := by
      unfold EllipticRootNumber.resDeg
      apply IsLeast.csInf_eq
      let a_π : B := algebraMap F B π
      let y_π : H := IntermediateField.inclusion h a_π
      have hy_π_ne : y_π ≠ 0 := by
        dsimp [y_π, a_π]
        exact (map_ne_zero _).mpr ((map_ne_zero _).mpr hπ_ne)
      have hy_π_relVal : EllipticRootNumber.relVal F H y_π = (2 : ℕ) := by
        dsimp [y_π, a_π]
        rw [h_relVal_inc, h_valL_bot, IntermediateField.botEquiv_def, hπ_val]
        omega
      refine ⟨⟨by decide, y_π, hy_π_ne, hy_π_relVal⟩, ?_⟩
      rintro k ⟨hk_pos, y, _, hy_rel⟩
      obtain ⟨m, hm⟩ := h_relVal_even y
      omega
    have h_relVal_H : ∀ y : H,
        EllipticRootNumber.relVal F H y = 2 * EllipticRootNumber.valL F H y := by
      intro y
      obtain ⟨m, hm⟩ := h_relVal_even y
      unfold EllipticRootNumber.valL
      rw [hm, h_resDeg_H, Nat.cast_ofNat, Int.mul_ediv_cancel_left _ (by decide : (2 : ℤ) ≠ 0)]

    
    have h_norm_ne : ∀ x : H, x ≠ 0 → Algebra.norm F x ≠ 0 := by
      intro x hx
      let ux : Hˣ := Units.mk0 x hx
      exact Units.ne_zero (Units.map (Algebra.norm F) ux)
    have h_valL_mul : ∀ x y : H, x ≠ 0 → y ≠ 0 →
        EllipticRootNumber.valL F H (x * y) =
          EllipticRootNumber.valL F H x + EllipticRootNumber.valL F H y := by
      intro x y hx hy
      have h_rel : EllipticRootNumber.relVal F H (x * y) =
          EllipticRootNumber.relVal F H x + EllipticRootNumber.relVal F H y := by
        unfold EllipticRootNumber.relVal
        rw [map_mul, h_addVal_mul _ _ (h_norm_ne x hx) (h_norm_ne y hy)]
      have h1 := h_relVal_H (x * y)
      have h2 := h_relVal_H x
      have h3 := h_relVal_H y
      omega
    have h_valL_one : EllipticRootNumber.valL F H 1 = 0 := by
      have h_rel1 : EllipticRootNumber.relVal F H 1 = 0 := by
        unfold EllipticRootNumber.relVal
        rw [map_one, h_addVal_one]
      have h1 := h_relVal_H 1
      omega
    have h_valL_inv : ∀ v : Hˣ,
        EllipticRootNumber.valL F H ((v⁻¹ : Hˣ) : H) =
          -EllipticRootNumber.valL F H (v : H) := by
      intro v
      have h_mul := h_valL_mul (v : H) ((v⁻¹ : Hˣ) : H) (Units.ne_zero v) (Units.ne_zero v⁻¹)
      have h_prod : (v : H) * ((v⁻¹ : Hˣ) : H) = 1 := Units.mul_inv v
      rw [h_prod, h_valL_one] at h_mul
      omega
    let vH_hom : Hˣ →* Multiplicative ℤ :=
      { toFun := fun v => Multiplicative.ofAdd (EllipticRootNumber.valL F H (v : H))
        map_one' := by
          change Multiplicative.ofAdd (EllipticRootNumber.valL F H (1 : H)) = 1
          rw [h_valL_one, ofAdd_zero]
        map_mul' := fun x y => by
          change Multiplicative.ofAdd (EllipticRootNumber.valL F H ((x : H) * (y : H))) = _
          rw [h_valL_mul (x : H) (y : H) (Units.ne_zero x) (Units.ne_zero y), ofAdd_add] }
    have h_set_u0 : {v : Hˣ |
        if (0 : ℕ) = 0 then EllipticRootNumber.valL F H (v : H) = 0
        else ((v : H) = 1 ∨ ((0 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F H ((v : H) - 1))} =
        (vH_hom.ker : Set Hˣ) := by
      ext v
      rw [Set.mem_setOf_eq, if_pos rfl, SetLike.mem_coe, MonoidHom.mem_ker]
      rfl
    have h_unit0 : ∀ v : Hˣ,
        v ∈ EllipticRootNumber.unitGroup F H 0 ↔
          EllipticRootNumber.valL F H (v : H) = 0 := by
      intro v
      unfold EllipticRootNumber.unitGroup
      rw [h_set_u0, Subgroup.closure_eq, MonoidHom.mem_ker]
      rfl

    let P₁ : H → Prop := fun y => y = 0 ∨ 1 ≤ EllipticRootNumber.valL F H y
    have hP₁_coord : ∀ a b : B,
        P₁ (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
          ValuativeRel.valuation F (e_bot a) < 1 ∧ ValuativeRel.valuation F (e_bot b) < 1 := by
      intro a b
      change (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔ _
      rw [(h_valL_coord a b).2, h_bot_lt a, h_bot_lt b]
    have hP₁_zero : P₁ 0 := Or.inl rfl
    have hP₁_add : ∀ y₁ y₂ : H, P₁ y₁ → P₁ y₂ → P₁ (y₁ + y₂) := by
      intro y₁ y₂ hy₁ hy₂
      obtain ⟨⟨a₁, b₁⟩, h₁⟩ := (h_coord y₁).exists
      obtain ⟨⟨a₂, b₂'⟩, h₂⟩ := (h_coord y₂).exists
      rw [h₁, hP₁_coord] at hy₁
      rw [h₂, hP₁_coord] at hy₂
      have h_sum : y₁ + y₂ =
          IntermediateField.inclusion h (a₁ + a₂) +
            IntermediateField.inclusion h (b₁ + b₂') * (u : H) := by
        rw [h₁, h₂, map_add, map_add]
        ring
      rw [h_sum, hP₁_coord]
      refine ⟨?_, ?_⟩
      · rw [map_add]
        exact (Valuation.map_add _ _ _).trans_lt (max_lt hy₁.1 hy₂.1)
      · rw [map_add]
        exact (Valuation.map_add _ _ _).trans_lt (max_lt hy₁.2 hy₂.2)
    have hP₁_neg : ∀ y : H, P₁ y → P₁ (-y) := by
      intro y hy
      obtain ⟨⟨a, b⟩, h_y⟩ := (h_coord y).exists
      rw [h_y, hP₁_coord] at hy
      have h_neg : -y =
          IntermediateField.inclusion h (-a) +
            IntermediateField.inclusion h (-b) * (u : H) := by
        rw [h_y, map_neg, map_neg]
        ring
      rw [h_neg, hP₁_coord, map_neg e_bot, map_neg e_bot, Valuation.map_neg, Valuation.map_neg]
      exact hy
    have hP₁_mul_unit : ∀ (w : Hˣ) (y : H),
        EllipticRootNumber.valL F H (w : H) = 0 → P₁ y → P₁ ((w : H) * y) := by
      intro w y hw hy
      rcases eq_or_ne y 0 with rfl | hy_ne
      · rw [mul_zero]
        exact hP₁_zero
      · rcases hy with rfl | hy1
        · contradiction
        · right
          rw [h_valL_mul (w : H) y (Units.ne_zero w) hy_ne, hw, zero_add]
          exact hy1
    have hP₁_val0 : ∀ v : Hˣ,
        P₁ ((v : H) - 1) → EllipticRootNumber.valL F H (v : H) = 0 := by
      intro v hv
      obtain ⟨⟨a, b⟩, hab⟩ := (h_coord ((v : H) - 1)).exists
      rw [hab, hP₁_coord] at hv
      have hv_eq : (v : H) =
          IntermediateField.inclusion h (a + 1) +
            IntermediateField.inclusion h b * (u : H) := by
        calc (v : H) = ((v : H) - 1) + 1 := (sub_add_cancel (v : H) 1).symm
          _ = IntermediateField.inclusion h (a + 1) +
                IntermediateField.inclusion h b * (u : H) := by
              rw [hab, map_add, map_one]
              ring
      have ha1_val : ValuativeRel.valuation F (e_bot (a + 1)) = 1 := by
        rw [map_add, map_one]
        have hlt : ValuativeRel.valuation F (e_bot a) < ValuativeRel.valuation F 1 := by
          rw [Valuation.map_one]
          exact hv.1
        rw [Valuation.map_add_eq_of_lt_right _ hlt, Valuation.map_one]
      have hv_ge0 : 0 ≤ EllipticRootNumber.valL F H (v : H) := by
        rw [hv_eq, (h_valL_coord (a + 1) b).1, h_bot_le, h_bot_le, ha1_val]
        exact ⟨le_rfl, le_of_lt hv.2⟩
      have hv_not_P₁ : ¬ P₁ (v : H) := by
        rw [hv_eq, hP₁_coord, ha1_val]
        rintro ⟨hlt, _⟩
        exact lt_irrefl 1 hlt
      have hv_ne0 : (v : H) ≠ 0 := Units.ne_zero v
      have hv_lt1 : ¬ (1 ≤ EllipticRootNumber.valL F H (v : H)) := fun h1 => hv_not_P₁ (Or.inr h1)
      omega
    let U₁_sub : Subgroup Hˣ :=
      { carrier := {v : Hˣ | P₁ ((v : H) - 1)}
        one_mem' := by
          change P₁ (((1 : Hˣ) : H) - 1)
          rw [Units.val_one, sub_self]
          exact hP₁_zero
        mul_mem' := fun {v₁ v₂} hv₁ hv₂ => by
          change P₁ (((v₁ * v₂ : Hˣ) : H) - 1)
          have h_id : ((v₁ * v₂ : Hˣ) : H) - 1 =
              (v₁ : H) * ((v₂ : H) - 1) + ((v₁ : H) - 1) := by
            push_cast
            ring
          rw [h_id]
          exact hP₁_add _ _ (hP₁_mul_unit v₁ _ (hP₁_val0 v₁ hv₁) hv₂) hv₁
        inv_mem' := fun {v} hv => by
          change P₁ (((v⁻¹ : Hˣ) : H) - 1)
          have hv_inv_val0 : EllipticRootNumber.valL F H ((v⁻¹ : Hˣ) : H) = 0 := by
            rw [h_valL_inv v, hP₁_val0 v hv, neg_zero]
          have h_id : ((v⁻¹ : Hˣ) : H) - 1 = ((v⁻¹ : Hˣ) : H) * -((v : H) - 1) := by
            calc ((v⁻¹ : Hˣ) : H) - 1 = ((v⁻¹ : Hˣ) : H) - ((v⁻¹ : Hˣ) : H) * (v : H) := by
                  rw [Units.inv_mul]
              _ = ((v⁻¹ : Hˣ) : H) * -((v : H) - 1) := by ring
          rw [h_id]
          exact hP₁_mul_unit v⁻¹ _ hv_inv_val0 (hP₁_neg _ hv) }
    have h_set_u1 : {v : Hˣ |
        if (1 : ℕ) = 0 then EllipticRootNumber.valL F H (v : H) = 0
        else ((v : H) = 1 ∨ ((1 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F H ((v : H) - 1))} =
        (U₁_sub : Set Hˣ) := by
      ext v
      rw [Set.mem_setOf_eq, if_neg Nat.one_ne_zero, Nat.cast_one, SetLike.mem_coe]
      change ((v : H) = 1 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1)) ↔
        ((v : H) - 1 = 0 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1))
      rw [sub_eq_zero]
    have h_unit1 : ∀ v : Hˣ,
        v ∈ EllipticRootNumber.unitGroup F H 1 ↔
          ((v : H) = 1 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1)) := by
      intro v
      unfold EllipticRootNumber.unitGroup
      rw [h_set_u1, Subgroup.closure_eq]
      change ((v : H) - 1 = 0 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1)) ↔ _
      rw [sub_eq_zero]
    have h_unit1_le_0 : EllipticRootNumber.unitGroup F H 1 ≤ EllipticRootNumber.unitGroup F H 0 := by
      intro v hv
      rw [h_unit0]
      rw [h_unit1] at hv
      apply hP₁_val0 v
      change (v : H) - 1 = 0 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1)
      rwa [sub_eq_zero]

    exact ⟨h_bot_le, h_bot_lt, h_valL_mul, h_valL_inv, h_unit0, h_unit1, h_unit1_le_0⟩
  )

theorem tateEps_unramified_quadratic_eq_neg_inv_q_mul_finsum (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ_triv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1)
    (hψ_nontriv : ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)))
    (h_valL_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a)
    (h_trace_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.traceLM F h (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 2 * a)
    (h_bot_le : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x ↔
        ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x) ≤ 1)
    (h_bot_lt : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (x = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ x) ↔
        ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x) < 1)
    (h_valL_mul : ∀ x y : H, x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F H (x * y) =
        EllipticRootNumber.valL F H x + EllipticRootNumber.valL F H y)
    (h_valL_inv : ∀ v : Hˣ,
      EllipticRootNumber.valL F H ((v⁻¹ : Hˣ) : H) =
        -EllipticRootNumber.valL F H (v : H))
    (h_unit0 : ∀ v : Hˣ,
      v ∈ EllipticRootNumber.unitGroup F H 0 ↔
        EllipticRootNumber.valL F H (v : H) = 0)
    (h_unit1 : ∀ v : Hˣ,
      v ∈ EllipticRootNumber.unitGroup F H 1 ↔
        ((v : H) = 1 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1)))
    (h_unit1_le_0 : EllipticRootNumber.unitGroup F H 1 ≤ EllipticRootNumber.unitGroup F H 0)
    (φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ)
    (h_cond : EllipticRootNumber.condExp F H φ' = 1)
    (hφ'_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      φ' (Units.map (IntermediateField.inclusion h).toMonoidHom x) =
        (-EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) :
    ∃ c_bot : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (c_bot : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
      ψ (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F)))) ≠ 1 ∧
      EllipticRootNumber.tateEps F H φ' (EllipticRootNumber.traceChar F h ψ) =
        -(EllipticRootNumber.q F : EllipticRootNumber.Ω F)⁻¹ *
          ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
            (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
            ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
              EllipticRootNumber.traceChar F h ψ
                ((((Units.map (IntermediateField.inclusion h).toMonoidHom c_bot)⁻¹ *
                  EllipticRootNumber.cosetRep q : Hˣ) : H))) :=
by
  classical
  let A := (ValuativeRel.valuation F).valuationSubring
  let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
  have hp_info : (EllipticRootNumber.p F).Prime ∧ EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
    letI : Fintype kF := Fintype.ofFinite kF
    obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
    refine ⟨hp_prime, ?_⟩
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hcard_eq]
    exact dvd_pow_self (ringChar kF) k_card.ne_zero
  obtain ⟨hp_prime, hp_dvd_q⟩ := hp_info
  have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
    rintro h_eq; rw [h_eq] at hp_dvd_q; exact hq2 hp_dvd_q
  have h_ndvd2 : ¬ (EllipticRootNumber.p F ∣ 2) := by
    intro hdvd
    rw [Nat.dvd_prime Nat.prime_two] at hdvd
    rcases hdvd with h1 | h2
    · exact hp_prime.ne_one h1
    · exact hp_ne2 h2
  have h2_kF : (2 : kF) ≠ 0 := by
    haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
    exact (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) 2).not.mpr h_ndvd2
  have h_val2_le : ValuativeRel.valuation F (2 : F) ≤ 1 := (2 : ↥A).2
  have h_val2_not_lt : ¬ (ValuativeRel.valuation F (2 : F) < 1) := by
    intro hlt
    have h_mem : (2 : ↥A) ∈ IsLocalRing.maximalIdeal ↥A :=
      (Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F)).mpr hlt
    have h_res : IsLocalRing.residue ↥A (2 : ↥A) = 0 :=
      (IsLocalRing.residue_eq_zero_iff (2 : ↥A)).mpr h_mem
    rw [map_ofNat] at h_res
    exact h2_kF h_res
  let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
  have he_bot_two : e_bot (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) = (2 : F) :=
    map_ofNat e_bot 2
  have h_valL_two_nonneg : 0 ≤ EllipticRootNumber.valL F ⊥ (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    rw [h_bot_le]
    change ValuativeRel.valuation F (e_bot 2) ≤ 1
    rwa [he_bot_two]
  have h_two_not_lt : ¬ ((2 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∨
      1 ≤ EllipticRootNumber.valL F ⊥ (2 : (⊥ : IntermediateField F (AlgebraicClosure F)))) := by
    rw [h_bot_lt]
    change ¬ (ValuativeRel.valuation F (e_bot 2) < 1)
    rwa [he_bot_two]
  have h2_bot_ne : (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
    fun h0 => h_two_not_lt (Or.inl h0)
  have h_valL_two_not_ge1 : ¬ (1 ≤ EllipticRootNumber.valL F ⊥ (2 : (⊥ : IntermediateField F (AlgebraicClosure F)))) :=
    fun h1 => h_two_not_lt (Or.inr h1)
  have h_valL_two : EllipticRootNumber.valL F ⊥ (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    omega
  let ι := IntermediateField.inclusion h
  have hι_two_ne : ι (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
    (map_ne_zero ι).mpr h2_bot_ne
  have h_valL_two_mul : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ (2 * x) = EllipticRootNumber.valL F ⊥ x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, mul_zero]
    · have hι_x_ne : ι x ≠ 0 := (map_ne_zero ι).mpr hx
      rw [← h_valL_inc (2 * x), map_mul, h_valL_mul (ι 2) (ι x) hι_two_ne hι_x_ne,
        h_valL_inc 2, h_valL_inc x, h_valL_two, zero_add]

  let ψ_H : AddChar H (EllipticRootNumber.Ω F) := EllipticRootNumber.traceChar F h ψ
  have hψH_triv : ∀ y : H, 0 ≤ EllipticRootNumber.valL F H y → ψ_H y = 1 := by
    intro y hy
    obtain ⟨⟨a, b⟩, hy_eq⟩ := (h_coord y).exists
    dsimp only at hy_eq
    rw [hy_eq] at hy ⊢
    have ha : 0 ≤ EllipticRootNumber.valL F ⊥ a := ((h_valL_coord a b).1.mp hy).1
    have h2a : 0 ≤ EllipticRootNumber.valL F ⊥ (2 * a) := by rwa [h_valL_two_mul]
    change ψ (EllipticRootNumber.traceLM F h (ι a + ι b * (u : H))) = 1
    rw [h_trace_coord a b]
    exact hψ_triv (2 * a) h2a
  obtain ⟨x₀, hx₀_val, hx₀_ne⟩ := hψ_nontriv
  have hx₀_ne0 : x₀ ≠ 0 := by
    intro h0
    apply hx₀_ne
    rw [h0, AddChar.map_zero_eq_one]
  let y₀ : H := ι (x₀ / 2)
  have h_two_div_x₀ : 2 * (x₀ / 2) = x₀ := mul_div_cancel₀ x₀ h2_bot_ne
  have hy₀_val : EllipticRootNumber.valL F H y₀ = -1 := by
    change EllipticRootNumber.valL F H (ι (x₀ / 2)) = -1
    rw [h_valL_inc (x₀ / 2), ← h_valL_two_mul (x₀ / 2), h_two_div_x₀, hx₀_val]
  have hy₀_ne : ψ_H y₀ ≠ 1 := by
    have hy₀_coord : y₀ = ι (x₀ / 2) + ι 0 * (u : H) := by
      change ι (x₀ / 2) = ι (x₀ / 2) + ι 0 * (u : H)
      rw [map_zero, zero_mul, add_zero]
    change ψ (EllipticRootNumber.traceLM F h y₀) ≠ 1
    rw [hy₀_coord, h_trace_coord (x₀ / 2) 0, h_two_div_x₀]
    exact hx₀_ne
  have hψH_cond : EllipticRootNumber.condExpChar F H ψ_H = 0 := by
    unfold EllipticRootNumber.condExpChar
    apply IsGreatest.csSup_eq
    refine ⟨?_, ?_⟩
    · intro y hy
      rw [neg_zero] at hy
      exact hψH_triv y hy
    · intro d hd
      by_contra h_gt
      have hd_pos : 0 < d := lt_of_not_ge h_gt
      have hy₀_ge : -d ≤ EllipticRootNumber.valL F H y₀ := by
        rw [hy₀_val]
        omega
      exact hy₀_ne (hd y₀ hy₀_ge)
  let u_x₀ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := Units.mk0 x₀ hx₀_ne0
  let c_bot : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := u_x₀⁻¹
  have hc_bot_inv_coe :
      ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀ := by
    change ((u_x₀⁻¹⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
      (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀
    rw [inv_inv]
    rfl
  have hψ_c : ψ (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
      (⊥ : IntermediateField F (AlgebraicClosure F)))) ≠ 1 := by
    rw [hc_bot_inv_coe]
    exact hx₀_ne
  let π_H : Hˣ := Units.map ι.toMonoidHom c_bot
  have hπ_inv_val : EllipticRootNumber.valL F H ((π_H⁻¹ : Hˣ) : H) = -1 := by
    have h_coe : ((π_H⁻¹ : Hˣ) : H) = ι x₀ := by
      rw [← map_inv (Units.map ι.toMonoidHom) c_bot, ← hc_bot_inv_coe]
      rfl
    rw [h_coe, h_valL_inc x₀, hx₀_val]
  have hπ_val : EllipticRootNumber.valL F H (π_H : H) = 1 := by
    have h_inv := h_valL_inv π_H⁻¹
    rw [inv_inv, hπ_inv_val] at h_inv
    omega
  have hc_bot_val : EllipticRootNumber.valL F ⊥ (c_bot : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
    rw [← h_valL_inc (c_bot : (⊥ : IntermediateField F (AlgebraicClosure F)))]
    exact hπ_val

  have h_ex_c : ∃ c' : Hˣ, EllipticRootNumber.valL F H (c' : H) = 1 := ⟨π_H, hπ_val⟩
  let c : Hˣ := EllipticRootNumber.tateElt F H φ' ψ_H
  have hc_val : EllipticRootNumber.valL F H (c : H) = 1 := by
    have hc_def : c = Classical.epsilon (fun c' : Hˣ => EllipticRootNumber.valL F H (c' : H) = 1) := by
      change EllipticRootNumber.tateElt F H φ' ψ_H = _
      unfold EllipticRootNumber.tateElt
      rw [h_cond, hψH_cond, Nat.cast_one, add_zero]
    rw [hc_def]
    exact Classical.epsilon_spec h_ex_c
  have h_tateEps_unfold :
      EllipticRootNumber.tateEps F H φ' ψ_H =
        ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
          (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
          ((φ' (c⁻¹ * EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
            ψ_H (((c⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H))) := by
    change EllipticRootNumber.tateEps F H φ' ψ_H =
      ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
        (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
        ((φ' ((EllipticRootNumber.tateElt F H φ' ψ_H)⁻¹ * EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
          ψ_H ((((EllipticRootNumber.tateElt F H φ' ψ_H)⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H)))
    unfold EllipticRootNumber.tateEps
    rw [hψH_cond, zpow_zero, one_mul]
    have h_cond' := h_cond
    generalize EllipticRootNumber.condExp F H φ' = a at h_cond' ⊢
    subst h_cond'
    rw [if_neg Nat.one_ne_zero]

  let S₁ : Set ℕ := {a : ℕ | ∀ u ∈ EllipticRootNumber.unitGroup F H a, φ' u = 1}
  have hS₁_ne : S₁.Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro h_emp
    have h0 : sInf S₁ = 0 := by rw [h_emp, Nat.sInf_empty]
    change EllipticRootNumber.condExp F H φ' = 0 at h0
    omega
  have h_triv₁ : ∀ u ∈ EllipticRootNumber.unitGroup F H 1, φ' u = 1 := by
    have h1_mem : 1 ∈ S₁ := by
      rw [← h_cond]
      exact Nat.sInf_mem hS₁_ne
    exact h1_mem
  let w₀ : Hˣ := c * π_H⁻¹
  have hw₀_val : EllipticRootNumber.valL F H (w₀ : H) = 0 := by
    change EllipticRootNumber.valL F H ((c : H) * ((π_H⁻¹ : Hˣ) : H)) = 0
    rw [h_valL_mul (c : H) ((π_H⁻¹ : Hˣ) : H) (Units.ne_zero _) (Units.ne_zero _),
      hc_val, hπ_inv_val]
    omega
  have hw₀_mem0 : w₀ ∈ EllipticRootNumber.unitGroup F H 0 := (h_unit0 w₀).mpr hw₀_val
  haveI : (EllipticRootNumber.unitGroup F H 1).Normal :=
    Subgroup.normal_of_comm (EllipticRootNumber.unitGroup F H 1)
  let U₀ : Set (Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) :=
    {q | EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0}
  let q₀ : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1 := QuotientGroup.mk w₀
  let T (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) :
      Hˣ ⧸ EllipticRootNumber.unitGroup F H 1 := q₀ * q
  have h_T_rel : ∀ q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1,
      (w₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q) ∈
        EllipticRootNumber.unitGroup F H 1 := by
    intro q
    apply QuotientGroup.eq.mp
    unfold EllipticRootNumber.cosetRep
    rw [QuotientGroup.mk_mul, QuotientGroup.out_eq', QuotientGroup.out_eq']
  have h_T_mem : ∀ q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1, T q ∈ U₀ ↔ q ∈ U₀ := by
    intro q
    change EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep (T q) : Hˣ) : H) = 0 ↔
      EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0
    rw [← h_unit0, ← h_unit0]
    have hu₁ : (w₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q) ∈
        EllipticRootNumber.unitGroup F H 0 := h_unit1_le_0 (h_T_rel q)
    constructor
    · intro hTq
      have h_eq : EllipticRootNumber.cosetRep q =
          w₀⁻¹ * EllipticRootNumber.cosetRep (T q) *
            ((w₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q))⁻¹ := by
        group
      rw [h_eq]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hw₀_mem0) hTq)
        (Subgroup.inv_mem _ hu₁)
    · intro hq
      have h_eq : EllipticRootNumber.cosetRep (T q) =
          w₀ * EllipticRootNumber.cosetRep q *
            ((w₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q)) := by
        group
      rw [h_eq]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hw₀_mem0 hq) hu₁
  have hT_bij : Set.BijOn T U₀ U₀ := by
    refine ⟨fun q hq => (h_T_mem q).mpr hq, ?_, ?_⟩
    · intro q₁ _ q₂ _ h_eq
      exact mul_left_cancel h_eq
    · intro q hq
      let q' := q₀⁻¹ * q
      have hTq' : T q' = q := mul_inv_cancel_left q₀ q
      refine ⟨q', (h_T_mem q').mp (by rwa [hTq']), hTq'⟩
  have h_summand_eq : ∀ q ∈ U₀,
      ((φ' (c⁻¹ * EllipticRootNumber.cosetRep (T q)) : EllipticRootNumber.Ω F)⁻¹ *
        ψ_H (((c⁻¹ * EllipticRootNumber.cosetRep (T q) : Hˣ) : H))) =
      (φ' π_H : EllipticRootNumber.Ω F) *
        ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
          ψ_H (((π_H⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H))) := by
    intro q hq
    let v : Hˣ := EllipticRootNumber.cosetRep q
    have hv_val : EllipticRootNumber.valL F H (v : H) = 0 := hq
    let v' : Hˣ := EllipticRootNumber.cosetRep (T q)
    let u₁ : Hˣ := (w₀ * v)⁻¹ * v'
    have hu₁ : u₁ ∈ EllipticRootNumber.unitGroup F H 1 := h_T_rel q
    have h_cv'_eq : c⁻¹ * v' = π_H⁻¹ * v * u₁ := by
      dsimp [u₁, v, v', w₀]
      group
    have h_phi_eq : (φ' (c⁻¹ * v') : EllipticRootNumber.Ω F)⁻¹ =
        (φ' π_H : EllipticRootNumber.Ω F) * (φ' v : EllipticRootNumber.Ω F)⁻¹ := by
      rw [h_cv'_eq, map_mul, map_mul, h_triv₁ u₁ hu₁, mul_one, map_inv,
        Units.val_mul, Units.val_inv_eq_inv_val, mul_inv_rev, inv_inv, mul_comm]
    have h_psi_eq : ψ_H (((c⁻¹ * v' : Hˣ) : H)) = ψ_H (((π_H⁻¹ * v : Hˣ) : H)) := by
      rw [h_cv'_eq]
      rcases (h_unit1 u₁).mp hu₁ with hu₁_one | hu₁_ge1
      · have h_u₁_eq : u₁ = 1 := Units.ext hu₁_one
        rw [h_u₁_eq, mul_one]
      · by_cases h_sub0 : (u₁ : H) - 1 = 0
        · have hu₁_one : (u₁ : H) = 1 := sub_eq_zero.mp h_sub0
          have h_u₁_eq : u₁ = 1 := Units.ext hu₁_one
          rw [h_u₁_eq, mul_one]
        · let z₂ : H := ((π_H⁻¹ * v : Hˣ) : H)
          have hz₂_ne : z₂ ≠ 0 := Units.ne_zero _
          have hz₂_val : EllipticRootNumber.valL F H z₂ = -1 := by
            change EllipticRootNumber.valL F H (((π_H⁻¹ : Hˣ) : H) * (v : H)) = -1
            rw [h_valL_mul ((π_H⁻¹ : Hˣ) : H) (v : H) (Units.ne_zero _) (Units.ne_zero _),
              hπ_inv_val, hv_val]
            omega
          have h_diff_val : 0 ≤ EllipticRootNumber.valL F H (z₂ * ((u₁ : H) - 1)) := by
            rw [h_valL_mul z₂ ((u₁ : H) - 1) hz₂_ne h_sub0, hz₂_val]
            omega
          have h_expand : ((π_H⁻¹ * v * u₁ : Hˣ) : H) = z₂ * ((u₁ : H) - 1) + z₂ := by
            change z₂ * (u₁ : H) = z₂ * ((u₁ : H) - 1) + z₂
            ring
          rw [h_expand, AddChar.map_add_eq_mul, hψH_triv _ h_diff_val, one_mul]
    change ((φ' (c⁻¹ * v') : EllipticRootNumber.Ω F)⁻¹ * ψ_H (((c⁻¹ * v' : Hˣ) : H))) =
      (φ' π_H : EllipticRootNumber.Ω F) * ((φ' v : EllipticRootNumber.Ω F)⁻¹ * ψ_H (((π_H⁻¹ * v : Hˣ) : H)))
    rw [h_phi_eq, h_psi_eq, mul_assoc]
  have h_finsum_shift :
      (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
        (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
        ((φ' (c⁻¹ * EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
          ψ_H (((c⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H)))) =
      (φ' π_H : EllipticRootNumber.Ω F) *
        ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
          (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
          ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
            ψ_H (((π_H⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H))) := by
    let g (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) : EllipticRootNumber.Ω F :=
      (φ' (c⁻¹ * EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
        ψ_H (((c⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H))
    have h_bij_eq :
        (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) (_ : q ∈ U₀), g (T q)) =
          ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) (_ : q ∈ U₀), g q :=
      finsum_mem_eq_of_bijOn T hT_bij (fun _ _ => rfl)
    change (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) (_ : q ∈ U₀), g q) = _
    rw [← h_bij_eq, mul_finsum]
    refine finsum_congr fun q => ?_
    by_cases hq : q ∈ U₀
    · have hq0 : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0 := hq
      simp only [hq, hq0, finsum_true]
      exact h_summand_eq q hq
    · have hq0 : ¬ (EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0) := hq
      simp only [hq, hq0, finsum_false, mul_zero]
  have hφ'_π_H : (φ' π_H : EllipticRootNumber.Ω F) = -(EllipticRootNumber.q F : EllipticRootNumber.Ω F)⁻¹ := by
    have h_bot := hφ'_bot c_bot
    rw [hc_bot_val, zpow_neg_one] at h_bot
    change (φ' (Units.map ι.toMonoidHom c_bot) : EllipticRootNumber.Ω F) = _
    rw [h_bot, Units.val_inv_eq_inv_val, Units.val_neg, ← neg_inv]
    rfl
  refine ⟨c_bot, hc_bot_val, hψ_c, ?_⟩
  change EllipticRootNumber.tateEps F H φ' ψ_H =
    -(EllipticRootNumber.q F : EllipticRootNumber.Ω F)⁻¹ *
      ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
        (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
        ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
          ψ_H (((π_H⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H)))
  rw [h_tateEps_unfold, h_finsum_shift, hφ'_π_H]

theorem unramified_quadratic_coset_finsum_descent_to_residue_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ_triv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1)
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)))
    (h_valL_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a)
    (h_trace_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.traceLM F h (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 2 * a)
    (h_bot_le : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x ↔
        ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x) ≤ 1)
    (h_bot_lt : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (x = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ x) ↔
        ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x) < 1)
    (h_valL_mul : ∀ x y : H, x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F H (x * y) =
        EllipticRootNumber.valL F H x + EllipticRootNumber.valL F H y)
    (h_valL_inv : ∀ v : Hˣ,
      EllipticRootNumber.valL F H ((v⁻¹ : Hˣ) : H) =
        -EllipticRootNumber.valL F H (v : H))
    (h_unit0 : ∀ v : Hˣ,
      v ∈ EllipticRootNumber.unitGroup F H 0 ↔
        EllipticRootNumber.valL F H (v : H) = 0)
    (h_unit1 : ∀ v : Hˣ,
      v ∈ EllipticRootNumber.unitGroup F H 1 ↔
        ((v : H) = 1 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1)))
    (h_unit1_le_0 : EllipticRootNumber.unitGroup F H 1 ≤ EllipticRootNumber.unitGroup F H 0)
    (φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ)
    (h_cond : EllipticRootNumber.condExp F H φ' = 1)
    (hφ'_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      φ' (Units.map (IntermediateField.inclusion h).toMonoidHom x) =
        (-EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))))
    (c_bot : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hc_bot : EllipticRootNumber.valL F ⊥ (c_bot : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1)
    (hψ_c : ψ (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
      (⊥ : IntermediateField F (AlgebraicClosure F)))) ≠ 1) :
    ∃ (Φ : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer ×
        IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer → EllipticRootNumber.Ω F)
      (ψ₀ : AddChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) (EllipticRootNumber.Ω F)),
      (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
        (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
        ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
          EllipticRootNumber.traceChar F h ψ
            ((((Units.map (IntermediateField.inclusion h).toMonoidHom c_bot)⁻¹ *
              EllipticRootNumber.cosetRep q : Hˣ) : H)))) =
        (∑ᶠ p : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer ×
          IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer, Φ p * ψ₀ p.1) ∧
      Φ (0, 0) = 0 ∧
      Φ (0, 1) = (φ' u : EllipticRootNumber.Ω F)⁻¹ ∧
      (∀ (c : (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)ˣ)
        (a b : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer),
        Φ ((c : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) * a,
          (c : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) * b) = Φ (a, b)) ∧
      (∑ᶠ p : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer ×
        IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer, Φ p) = 0 ∧
      ψ₀ ≠ 1 :=
by
  classical
  let A := (ValuativeRel.valuation F).integer
  let k_F := IsLocalRing.ResidueField ↥A
  let resA : ↥A →+* k_F := IsLocalRing.residue ↥A
  have h_resA_surj : Function.Surjective resA := IsLocalRing.residue_surjective
  let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
  let ι := IntermediateField.inclusion h

  have h_valL_bot_mul : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)),
      x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F ⊥ (x * y) =
        EllipticRootNumber.valL F ⊥ x + EllipticRootNumber.valL F ⊥ y := by
    intro x y hx hy
    rw [← h_valL_inc (x * y), map_mul,
      h_valL_mul (ι x) (ι y) ((map_ne_zero ι).mpr hx) ((map_ne_zero ι).mpr hy),
      h_valL_inc, h_valL_inc]

  have hc_inv_val : EllipticRootNumber.valL F ⊥
      ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = -1 := by
    let c_H : Hˣ := Units.map ι.toMonoidHom c_bot
    have h1 : ι ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = ((c_H⁻¹ : Hˣ) : H) := by
      rw [← map_inv (Units.map ι.toMonoidHom) c_bot]
      rfl
    rw [← h_valL_inc, h1, h_valL_inv c_H]
    change -EllipticRootNumber.valL F H (ι (c_bot : (⊥ : IntermediateField F (AlgebraicClosure F)))) = -1
    rw [h_valL_inc, hc_bot]

  
  obtain ⟨coord, h_coord_spec, h_coord_eq⟩ :
      ∃ coord : H → (⊥ : IntermediateField F (AlgebraicClosure F)) ×
        (⊥ : IntermediateField F (AlgebraicClosure F)),
        (∀ y : H, y = ι (coord y).1 + ι (coord y).2 * (u : H)) ∧
        (∀ (y : H) (a b : (⊥ : IntermediateField F (AlgebraicClosure F))),
          y = ι a + ι b * (u : H) → coord y = (a, b)) :=
    ⟨fun y => Classical.choose (h_coord y).exists,
      fun y => Classical.choose_spec (h_coord y).exists,
      fun y a b hy => (h_coord y).unique (Classical.choose_spec (h_coord y).exists) hy⟩

  obtain ⟨toResF, h_toResF_coe⟩ :
      ∃ toResF : F → k_F, ∀ r : ↥A, toResF (r : F) = resA r :=
    ⟨fun x => if hx : x ∈ A then resA ⟨x, hx⟩ else 0, fun r => dif_pos r.2⟩

  obtain ⟨resCoord, h_resCoord_def⟩ :
      ∃ resCoord : Hˣ → k_F × k_F,
        ∀ v : Hˣ, resCoord v = (toResF (e_bot (coord (v : H)).1), toResF (e_bot (coord (v : H)).2)) :=
    ⟨fun v => (toResF (e_bot (coord (v : H)).1), toResF (e_bot (coord (v : H)).2)), fun _ => rfl⟩

  have h_bot_mem_A : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a ↔ e_bot a ∈ A := by
    intro a
    exact h_bot_le a

  have h_bot_res_zero : ∀ r : ↥A,
      (e_bot.symm (r : F) = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ (e_bot.symm (r : F))) ↔
        resA r = 0 := by
    intro r
    rw [h_bot_lt, e_bot.apply_symm_apply,
      ← Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F),
      ← IsLocalRing.residue_eq_zero_iff]
    rfl

  have h_resCoord_of_int : ∀ (v : Hˣ) (r s : ↥A),
      (v : H) = ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H) →
      resCoord v = (resA r, resA s) := by
    intro v r s hv
    have hc := h_coord_eq (v : H) (e_bot.symm (r : F)) (e_bot.symm (s : F)) hv
    rw [h_resCoord_def, hc, e_bot.apply_symm_apply, e_bot.apply_symm_apply, h_toResF_coe, h_toResF_coe]

  have h_int_coord_val0 : ∀ (r s : ↥A), (resA r, resA s) ≠ (0, 0) →
      ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H) ≠ 0 ∧
      EllipticRootNumber.valL F H (ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H)) = 0 := by
    intro r s hrs
    have h_ge0 : 0 ≤ EllipticRootNumber.valL F H
        (ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H)) := by
      rw [(h_valL_coord _ _).1, h_bot_mem_A, h_bot_mem_A, e_bot.apply_symm_apply, e_bot.apply_symm_apply]
      exact ⟨r.2, s.2⟩
    have h_not_ge1 : ¬ (ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H))) := by
      rw [(h_valL_coord _ _).2, h_bot_res_zero r, h_bot_res_zero s]
      rintro ⟨hr0, hs0⟩
      exact hrs (Prod.ext hr0 hs0)
    push_neg at h_not_ge1
    exact ⟨h_not_ge1.1, by omega⟩

  have h_unit0_int_coords : ∀ v ∈ EllipticRootNumber.unitGroup F H 0,
      ∃ r s : ↥A,
        coord (v : H) = (e_bot.symm (r : F), e_bot.symm (s : F)) ∧
        (v : H) = ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H) ∧
        resCoord v = (resA r, resA s) := by
    intro v hv
    have hv0 : EllipticRootNumber.valL F H (v : H) = 0 := (h_unit0 v).mp hv
    have h_ge0 : 0 ≤ EllipticRootNumber.valL F H (ι (coord (v : H)).1 + ι (coord (v : H)).2 * (u : H)) := by
      rw [← h_coord_spec (v : H), hv0]
    rw [(h_valL_coord _ _).1, h_bot_mem_A, h_bot_mem_A] at h_ge0
    let r : ↥A := ⟨e_bot (coord (v : H)).1, h_ge0.1⟩
    let s : ↥A := ⟨e_bot (coord (v : H)).2, h_ge0.2⟩
    have hc : coord (v : H) = (e_bot.symm (r : F), e_bot.symm (s : F)) := by
      apply Prod.ext <;> exact (e_bot.symm_apply_apply _).symm
    have hv_eq : (v : H) = ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H) := by
      have := h_coord_spec (v : H)
      rwa [hc] at this
    exact ⟨r, s, hc, hv_eq, h_resCoord_of_int v r s hv_eq⟩

  have hu_coord_eq : (u : H) = ι (e_bot.symm ((0 : ↥A) : F)) + ι (e_bot.symm ((1 : ↥A) : F)) * (u : H) := by
    change (u : H) = ι (e_bot.symm 0) + ι (e_bot.symm 1) * (u : H)
    rw [map_zero, map_one, map_zero, map_one, zero_add, one_mul]

  have hu_mem0 : u ∈ EllipticRootNumber.unitGroup F H 0 := by
    rw [h_unit0, hu_coord_eq]
    refine (h_int_coord_val0 0 1 ?_).2
    intro h01
    have h10 : (1 : k_F) = 0 := by
      have := congrArg Prod.snd h01
      rwa [map_one] at this
    exact one_ne_zero h10

  have h_res_u : resCoord u = (0, 1) := by
    rw [h_resCoord_of_int u 0 1 hu_coord_eq, map_zero, map_one]

  have h_res_ne_zero : ∀ v ∈ EllipticRootNumber.unitGroup F H 0, resCoord v ≠ (0, 0) := by
    intro v hv h0
    obtain ⟨r, s, _, hv_eq, h_res⟩ := h_unit0_int_coords v hv
    rw [h_res] at h0
    have hr0 : resA r = 0 := congrArg Prod.fst h0
    have hs0 : resA s = 0 := congrArg Prod.snd h0
    have h_ge1 : (v : H) = 0 ∨ 1 ≤ EllipticRootNumber.valL F H (v : H) := by
      rw [hv_eq, (h_valL_coord _ _).2, h_bot_res_zero r, h_bot_res_zero s]
      exact ⟨hr0, hs0⟩
    rcases h_ge1 with hv0 | hv1
    · exact Units.ne_zero v hv0
    · have hv_val0 : EllipticRootNumber.valL F H (v : H) = 0 := (h_unit0 v).mp hv
      omega

  have h_res_surj : ∀ p : k_F × k_F, p ≠ (0, 0) →
      ∃ v ∈ EllipticRootNumber.unitGroup F H 0, resCoord v = p := by
    intro p hp
    obtain ⟨r, hr⟩ := h_resA_surj p.1
    obtain ⟨s, hs⟩ := h_resA_surj p.2
    have hrs_eq : (resA r, resA s) = p := Prod.ext hr hs
    have hrs_ne : (resA r, resA s) ≠ (0, 0) := by rwa [hrs_eq]
    obtain ⟨hy_ne, hy_val⟩ := h_int_coord_val0 r s hrs_ne
    let v : Hˣ := Units.mk0 (ι (e_bot.symm (r : F)) + ι (e_bot.symm (s : F)) * (u : H)) hy_ne
    have hv_mem0 : v ∈ EllipticRootNumber.unitGroup F H 0 := (h_unit0 v).mpr hy_val
    refine ⟨v, hv_mem0, ?_⟩
    rw [h_resCoord_of_int v r s rfl, hrs_eq]

  have h_res_eq_iff : ∀ v₁ ∈ EllipticRootNumber.unitGroup F H 0,
      ∀ v₂ ∈ EllipticRootNumber.unitGroup F H 0,
        v₁⁻¹ * v₂ ∈ EllipticRootNumber.unitGroup F H 1 ↔ resCoord v₁ = resCoord v₂ := by
    intro v₁ hv₁ v₂ hv₂
    obtain ⟨r₁, s₁, _, hv₁_eq, h_res₁⟩ := h_unit0_int_coords v₁ hv₁
    obtain ⟨r₂, s₂, _, hv₂_eq, h_res₂⟩ := h_unit0_int_coords v₂ hv₂
    have hv₁_inv_val : EllipticRootNumber.valL F H ((v₁⁻¹ : Hˣ) : H) = 0 := by
      rw [h_valL_inv v₁, (h_unit0 v₁).mp hv₁, neg_zero]
    have h_u1_diff : v₁⁻¹ * v₂ ∈ EllipticRootNumber.unitGroup F H 1 ↔
        ((v₂ : H) - (v₁ : H) = 0 ∨ 1 ≤ EllipticRootNumber.valL F H ((v₂ : H) - (v₁ : H))) := by
      rw [h_unit1 (v₁⁻¹ * v₂)]
      by_cases h_eq : (v₂ : H) = (v₁ : H)
      · have hv_eq' : v₂ = v₁ := Units.ext h_eq
        subst hv_eq'
        rw [inv_mul_cancel, Units.val_one, sub_self, sub_self]
        exact ⟨fun _ => Or.inl rfl, fun _ => Or.inl rfl⟩
      · have h_sub_ne : (v₂ : H) - (v₁ : H) ≠ 0 := sub_ne_zero.mpr h_eq
        have h_mul_ne1 : ((v₁⁻¹ * v₂ : Hˣ) : H) ≠ 1 := by
          intro h1
          have : v₁⁻¹ * v₂ = 1 := Units.ext h1
          exact h_eq (congrArg Units.val (inv_mul_eq_one.mp this)).symm
        have h_inv_mul_v1 : ((v₁⁻¹ : Hˣ) : H) * (v₁ : H) = 1 := by
          rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
        have h_factor : ((v₁⁻¹ * v₂ : Hˣ) : H) - 1 = ((v₁⁻¹ : Hˣ) : H) * ((v₂ : H) - (v₁ : H)) := by
          rw [Units.val_mul, ← h_inv_mul_v1]
          ring
        rw [or_iff_right h_mul_ne1, or_iff_right h_sub_ne, h_factor,
          h_valL_mul ((v₁⁻¹ : Hˣ) : H) ((v₂ : H) - (v₁ : H)) (Units.ne_zero _) h_sub_ne,
          hv₁_inv_val, zero_add]
    have h_diff_coord : (v₂ : H) - (v₁ : H) =
        ι (e_bot.symm (((r₂ - r₁ : ↥A) : F))) + ι (e_bot.symm (((s₂ - s₁ : ↥A) : F))) * (u : H) := by
      change (v₂ : H) - (v₁ : H) =
        ι (e_bot.symm ((r₂ : F) - (r₁ : F))) + ι (e_bot.symm ((s₂ : F) - (s₁ : F))) * (u : H)
      rw [hv₁_eq, hv₂_eq, map_sub, map_sub, map_sub, map_sub]
      ring
    rw [h_u1_diff, h_diff_coord, (h_valL_coord _ _).2,
      h_bot_res_zero (r₂ - r₁), h_bot_res_zero (s₂ - s₁),
      map_sub, map_sub, sub_eq_zero, sub_eq_zero, h_res₁, h_res₂, Prod.ext_iff]
    exact ⟨fun ⟨h1, h2⟩ => ⟨h1.symm, h2.symm⟩, fun ⟨h1, h2⟩ => ⟨h1.symm, h2.symm⟩⟩

  let U₀ : Set (Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) :=
    {q | EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0}
  let S : Set (k_F × k_F) := {p | p ≠ (0, 0)}

  have h_bij : Set.BijOn (fun q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1 =>
      resCoord (EllipticRootNumber.cosetRep q)) U₀ S := by
    refine ⟨?_, ?_, ?_⟩
    · intro q hq
      exact h_res_ne_zero (EllipticRootNumber.cosetRep q) ((h_unit0 _).mpr hq)
    · intro q₁ hq₁ q₂ hq₂ h_eq
      have h₁ : EllipticRootNumber.cosetRep q₁ ∈ EllipticRootNumber.unitGroup F H 0 :=
        (h_unit0 _).mpr hq₁
      have h₂ : EllipticRootNumber.cosetRep q₂ ∈ EllipticRootNumber.unitGroup F H 0 :=
        (h_unit0 _).mpr hq₂
      have h_rel : (EllipticRootNumber.cosetRep q₁)⁻¹ * EllipticRootNumber.cosetRep q₂ ∈
          EllipticRootNumber.unitGroup F H 1 :=
        (h_res_eq_iff _ h₁ _ h₂).mpr h_eq
      have h_mk : (QuotientGroup.mk (EllipticRootNumber.cosetRep q₁) :
          Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) =
          QuotientGroup.mk (EllipticRootNumber.cosetRep q₂) :=
        QuotientGroup.eq.mpr h_rel
      unfold EllipticRootNumber.cosetRep at h_mk
      rwa [QuotientGroup.out_eq', QuotientGroup.out_eq'] at h_mk
    · intro p hp
      obtain ⟨v, hv₀, rfl⟩ := h_res_surj p hp
      let q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1 := QuotientGroup.mk v
      have h_rel : (EllipticRootNumber.cosetRep q)⁻¹ * v ∈ EllipticRootNumber.unitGroup F H 1 := by
        apply QuotientGroup.eq.mp
        unfold EllipticRootNumber.cosetRep
        exact QuotientGroup.out_eq' q
      have h_rel₀ : (EllipticRootNumber.cosetRep q)⁻¹ * v ∈ EllipticRootNumber.unitGroup F H 0 :=
        h_unit1_le_0 h_rel
      have hq_mem₀ : EllipticRootNumber.cosetRep q ∈ EllipticRootNumber.unitGroup F H 0 := by
        have h_prod : EllipticRootNumber.cosetRep q =
            v * ((EllipticRootNumber.cosetRep q)⁻¹ * v)⁻¹ := by
          rw [mul_inv_rev, inv_inv, mul_inv_cancel_left]
        rw [h_prod]
        exact Subgroup.mul_mem _ hv₀ (Subgroup.inv_mem _ h_rel₀)
      refine ⟨q, (h_unit0 _).mp hq_mem₀, ?_⟩
      exact (h_res_eq_iff _ hq_mem₀ _ hv₀).mp h_rel

  have h_scale : ∀ c : k_Fˣ,
      ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
        ∀ v ∈ EllipticRootNumber.unitGroup F H 0,
          Units.map ι.toMonoidHom x * v ∈ EllipticRootNumber.unitGroup F H 0 ∧
          resCoord (Units.map ι.toMonoidHom x * v) =
            ((c : k_F) * (resCoord v).1, (c : k_F) * (resCoord v).2) := by
    intro c
    obtain ⟨r_c, hr_c_res⟩ := h_resA_surj (c : k_F)
    have hrc_res_ne : resA r_c ≠ 0 := by
      rw [hr_c_res]
      exact Units.ne_zero c
    have hrc_not_or : ¬ (e_bot.symm (r_c : F) = 0 ∨
        1 ≤ EllipticRootNumber.valL F ⊥ (e_bot.symm (r_c : F))) := by
      rw [h_bot_res_zero r_c]
      exact hrc_res_ne
    push_neg at hrc_not_or
    have hrc_ge0 : 0 ≤ EllipticRootNumber.valL F ⊥ (e_bot.symm (r_c : F)) := by
      rw [h_bot_mem_A, e_bot.apply_symm_apply]
      exact r_c.2
    let x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ :=
      Units.mk0 (e_bot.symm (r_c : F)) hrc_not_or.1
    have hx_val0 : EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
      change EllipticRootNumber.valL F ⊥ (e_bot.symm (r_c : F)) = 0
      omega
    refine ⟨x, hx_val0, ?_⟩
    intro v hv
    obtain ⟨r, s, _, hv_eq, h_res⟩ := h_unit0_int_coords v hv
    let x_H : Hˣ := Units.map ι.toMonoidHom x
    have hx_H_val : EllipticRootNumber.valL F H (x_H : H) = 0 := by
      change EllipticRootNumber.valL F H (ι (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 0
      rw [h_valL_inc, hx_val0]
    have hxv_mem0 : x_H * v ∈ EllipticRootNumber.unitGroup F H 0 := by
      rw [h_unit0, Units.val_mul, h_valL_mul (x_H : H) (v : H) (Units.ne_zero _) (Units.ne_zero _),
        hx_H_val, (h_unit0 v).mp hv, add_zero]
    have hxv_coord : ((x_H * v : Hˣ) : H) =
        ι (e_bot.symm (((r_c * r : ↥A) : F))) + ι (e_bot.symm (((r_c * s : ↥A) : F))) * (u : H) := by
      change ι (e_bot.symm (r_c : F)) * (v : H) =
        ι (e_bot.symm ((r_c : F) * (r : F))) + ι (e_bot.symm ((r_c : F) * (s : F))) * (u : H)
      rw [hv_eq, map_mul, map_mul, map_mul, map_mul]
      ring
    refine ⟨hxv_mem0, ?_⟩
    rw [h_resCoord_of_int (x_H * v) (r_c * r) (r_c * s) hxv_coord,
      map_mul, map_mul, hr_c_res, h_res]

  
  obtain ⟨ψ_tilde, h_ψ_tilde_def⟩ :
      ∃ ψ_tilde : ↥A → EllipticRootNumber.Ω F,
        ∀ r : ↥A, ψ_tilde r =
          ψ (2 * (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (r : F))) :=
    ⟨fun r => ψ (2 * (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
      (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (r : F))), fun _ => rfl⟩

  have h_ψ_tilde_zero : ψ_tilde 0 = 1 := by
    rw [h_ψ_tilde_def]
    change ψ (2 * (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
      (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm 0)) = 1
    rw [map_zero, mul_zero, mul_zero, AddChar.map_zero_eq_one]
  have h_ψ_tilde_add : ∀ r₁ r₂ : ↥A, ψ_tilde (r₁ + r₂) = ψ_tilde r₁ * ψ_tilde r₂ := by
    intro r₁ r₂
    rw [h_ψ_tilde_def, h_ψ_tilde_def, h_ψ_tilde_def]
    change ψ (2 * (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm ((r₁ : F) + (r₂ : F)))) = _
    rw [map_add, mul_add, mul_add, AddChar.map_add_eq_mul]
  have h_ψ_tilde_max : ∀ r : ↥A, r ∈ IsLocalRing.maximalIdeal ↥A → ψ_tilde r = 1 := by
    intro r hr
    rw [h_ψ_tilde_def]
    have hr_res0 : resA r = 0 := (IsLocalRing.residue_eq_zero_iff r).mpr hr
    have hr_or := (h_bot_res_zero r).mpr hr_res0
    by_cases hr0 : e_bot.symm (r : F) = 0
    · rw [hr0, mul_zero, mul_zero, AddChar.map_zero_eq_one]
    · have hr1 : 1 ≤ EllipticRootNumber.valL F ⊥ (e_bot.symm (r : F)) :=
        (or_iff_right hr0).mp hr_or
      by_cases h20 : (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
      · rw [h20, zero_mul, AddChar.map_zero_eq_one]
      · have h2_ge0 : 0 ≤ EllipticRootNumber.valL F ⊥ 2 := by
          rw [h_bot_le, map_ofNat]
          exact (2 : ↥A).2
        have hc_inv_ne : ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 := Units.ne_zero _
        have h_prod_ne : ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (r : F) ≠ 0 :=
          mul_ne_zero hc_inv_ne hr0
        apply hψ_triv
        rw [h_valL_bot_mul 2 _ h20 h_prod_ne, h_valL_bot_mul _ _ hc_inv_ne hr0, hc_inv_val]
        omega

  obtain ⟨ψ₀_fun, h_ψ₀_fun_def⟩ :
      ∃ ψ₀_fun : k_F → EllipticRootNumber.Ω F,
        ∀ b : k_F, ψ₀_fun b = ψ_tilde (Classical.choose (h_resA_surj b)) :=
    ⟨fun b => ψ_tilde (Classical.choose (h_resA_surj b)), fun _ => rfl⟩

  have h_ψ₀_apply : ∀ r : ↥A, ψ₀_fun (resA r) = ψ_tilde r := by
    intro r
    rw [h_ψ₀_fun_def]
    set r' := Classical.choose (h_resA_surj (resA r))
    have hr' : resA r' = resA r := Classical.choose_spec (h_resA_surj (resA r))
    have h_max : r' - r ∈ IsLocalRing.maximalIdeal ↥A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      change resA (r' - r) = 0
      rw [map_sub, hr', sub_self]
    have h_eq : r' = (r' - r) + r := by ring
    rw [h_eq, h_ψ_tilde_add, h_ψ_tilde_max (r' - r) h_max, one_mul]

  obtain ⟨ψ₀, h_ψ₀_coe⟩ :
      ∃ ψ₀ : AddChar k_F (EllipticRootNumber.Ω F), ∀ b : k_F, ψ₀ b = ψ₀_fun b := by
    refine ⟨{ toFun := ψ₀_fun
              map_zero_eq_one' := ?_
              map_add_eq_mul' := ?_ }, fun _ => rfl⟩
    · have := h_ψ₀_apply 0
      rwa [map_zero, h_ψ_tilde_zero] at this
    · intro b₁ b₂
      obtain ⟨r₁, rfl⟩ := h_resA_surj b₁
      obtain ⟨r₂, rfl⟩ := h_resA_surj b₂
      rw [← map_add, h_ψ₀_apply, h_ψ₀_apply, h_ψ₀_apply, h_ψ_tilde_add]

  have hψ₀_ne : ψ₀ ≠ 1 := by
    letI : Fintype k_F := Fintype.ofFinite k_F
    obtain ⟨⟨k_card, hk_pos⟩, hp_prime, hcard_eq⟩ := FiniteField.card k_F (ringChar k_F)
    have hp_dvd_q : EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
      unfold EllipticRootNumber.q EllipticRootNumber.p
      rw [Nat.card_eq_fintype_card, hcard_eq]
      exact dvd_pow_self (ringChar k_F) hk_pos.ne'
    have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
      rintro h; rw [h] at hp_dvd_q; exact hq2 hp_dvd_q
    have h_ndvd2 : ¬ (EllipticRootNumber.p F ∣ 2) := by
      intro hdvd
      rw [Nat.dvd_prime Nat.prime_two] at hdvd
      rcases hdvd with h1 | h2
      · exact hp_prime.ne_one h1
      · exact hp_ne2 h2
    have h2_kF : (2 : k_F) ≠ 0 := by
      haveI : CharP k_F (EllipticRootNumber.p F) := ringChar.charP k_F
      exact (CharP.cast_eq_zero_iff k_F (EllipticRootNumber.p F) 2).not.mpr h_ndvd2
    have h2_bot_ne : (2 : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 := by
      intro h20
      have h2F : (2 : F) = 0 := by
        have := congrArg e_bot h20
        rwa [map_ofNat, map_zero] at this
      have h2A : (2 : ↥A) = 0 := Subtype.ext h2F
      have h2_res : resA (2 : ↥A) = 0 := by rw [h2A, map_zero]
      rw [map_ofNat] at h2_res
      exact h2_kF h2_res
    have h2_not_max : (2 : ↥A) ∉ IsLocalRing.maximalIdeal ↥A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      change resA (2 : ↥A) ≠ 0
      rw [map_ofNat]
      exact h2_kF
    have h2_val1 : ValuativeRel.valuation F (2 : F) = 1 := by
      apply le_antisymm (2 : ↥A).2
      rw [← not_lt]
      intro hlt
      exact h2_not_max ((Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F)).mpr hlt)
    have h2_inv_mem : (2 : F)⁻¹ ∈ A := by
      change ValuativeRel.valuation F (2 : F)⁻¹ ≤ 1
      rw [map_inv₀, h2_val1, inv_one]
    let r₀ : ↥A := ⟨(2 : F)⁻¹, h2_inv_mem⟩
    intro h1
    apply hψ_c
    have h_eval := congrArg (fun φ : AddChar k_F (EllipticRootNumber.Ω F) => φ (resA r₀)) h1
    change ψ₀ (resA r₀) = 1 at h_eval
    rw [h_ψ₀_coe, h_ψ₀_apply r₀, h_ψ_tilde_def] at h_eval
    have h_cancel : 2 * (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (r₀ : F)) =
        ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) := by
      change 2 * (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (2 : F)⁻¹) = _
      rw [map_inv₀, map_ofNat]
      calc 2 * (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) *
            (2 : (⊥ : IntermediateField F (AlgebraicClosure F)))⁻¹)
        _ = (2 * (2 : (⊥ : IntermediateField F (AlgebraicClosure F)))⁻¹) *
            ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
              (⊥ : IntermediateField F (AlgebraicClosure F))) := by ring
        _ = ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) := by
            rw [mul_inv_cancel₀ h2_bot_ne, one_mul]
    rwa [h_cancel] at h_eval

  
  let S_cond : Set ℕ := {a : ℕ | ∀ v ∈ EllipticRootNumber.unitGroup F H a, φ' v = 1}
  have hS_cond_ne : S_cond.Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro h_emp
    have h0 : sInf S_cond = 0 := by rw [h_emp, Nat.sInf_empty]
    change EllipticRootNumber.condExp F H φ' = 0 at h0
    omega
  have h_triv₁ : ∀ v ∈ EllipticRootNumber.unitGroup F H 1, φ' v = 1 := by
    have h1_mem : 1 ∈ S_cond := by
      rw [← h_cond]
      exact Nat.sInf_mem hS_cond_ne
    exact h1_mem
  have h_nontriv₀ : ∃ v₀ ∈ EllipticRootNumber.unitGroup F H 0, φ' v₀ ≠ 1 := by
    by_contra h_all
    push_neg at h_all
    have h0_mem : 0 ∈ S_cond := h_all
    have h_le : sInf S_cond ≤ 0 := Nat.sInf_le h0_mem
    change EllipticRootNumber.condExp F H φ' ≤ 0 at h_le
    omega

  obtain ⟨Φ, hΦ_def⟩ :
      ∃ Φ : k_F × k_F → EllipticRootNumber.Ω F,
        ∀ p : k_F × k_F, Φ p =
          if hp : p = (0, 0) then 0
          else (φ' (Classical.choose (h_res_surj p hp)) : EllipticRootNumber.Ω F)⁻¹ :=
    ⟨fun p => if hp : p = (0, 0) then 0
      else (φ' (Classical.choose (h_res_surj p hp)) : EllipticRootNumber.Ω F)⁻¹, fun _ => rfl⟩

  have hΦ_zero : Φ (0, 0) = 0 := by
    rw [hΦ_def, dif_pos rfl]

  have hΦ_apply : ∀ v ∈ EllipticRootNumber.unitGroup F H 0,
      Φ (resCoord v) = (φ' v : EllipticRootNumber.Ω F)⁻¹ := by
    intro v hv
    have hp : resCoord v ≠ (0, 0) := h_res_ne_zero v hv
    rw [hΦ_def, dif_neg hp]
    set v' := Classical.choose (h_res_surj (resCoord v) hp)
    obtain ⟨hv'₀, hv'_res⟩ := Classical.choose_spec (h_res_surj (resCoord v) hp)
    have h_rel : v⁻¹ * v' ∈ EllipticRootNumber.unitGroup F H 1 :=
      (h_res_eq_iff v hv v' hv'₀).mpr hv'_res.symm
    have h1 := h_triv₁ (v⁻¹ * v') h_rel
    rw [map_mul, map_inv, inv_mul_eq_one] at h1
    rw [← h1]

  have hΦ_01 : Φ (0, 1) = (φ' u : EllipticRootNumber.Ω F)⁻¹ := by
    rw [← h_res_u, hΦ_apply u hu_mem0]

  have hΦ_scale : ∀ (c : k_Fˣ) (a b : k_F),
      Φ ((c : k_F) * a, (c : k_F) * b) = Φ (a, b) := by
    intro c a b
    by_cases hab : (a, b) = (0, 0)
    · have ha : a = 0 := congrArg Prod.fst hab
      have hb : b = 0 := congrArg Prod.snd hab
      rw [ha, hb, mul_zero]
    · obtain ⟨v, hv₀, hv_res⟩ := h_res_surj (a, b) hab
      obtain ⟨x, hx_val0, hx_scale⟩ := h_scale c
      obtain ⟨hxv₀, hxv_res⟩ := hx_scale v hv₀
      let x_H : Hˣ := Units.map ι.toMonoidHom x
      have hφ'_x : φ' x_H = 1 := by
        change φ' (Units.map (IntermediateField.inclusion h).toMonoidHom x) = 1
        rw [hφ'_bot x, hx_val0, neg_zero, zpow_zero]
      have h_pair : ((c : k_F) * a, (c : k_F) * b) = resCoord (x_H * v) := by
        rw [hxv_res, hv_res]
      rw [h_pair, ← hv_res, hΦ_apply (x_H * v) hxv₀, hΦ_apply v hv₀,
        map_mul, hφ'_x, one_mul]

  have h_finsum_transfer : ∀ g : k_F × k_F → EllipticRootNumber.Ω F,
      (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
        (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
        ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
          g (resCoord (EllipticRootNumber.cosetRep q)))) =
        ∑ᶠ p : k_F × k_F, Φ p * g p := by
    intro g
    change (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) (_ : q ∈ U₀), _) = _
    rw [finsum_mem_eq_of_bijOn (g := fun p : k_F × k_F => Φ p * g p)
      (fun q => resCoord (EllipticRootNumber.cosetRep q)) h_bij
      (fun q hq => by
        dsimp only
        rw [hΦ_apply (EllipticRootNumber.cosetRep q) ((h_unit0 _).mpr hq)])]
    refine finsum_congr fun p => ?_
    rw [finsum_eq_if]
    by_cases hp : p ∈ S
    · rw [if_pos hp]
    · have hp0 : p = (0, 0) := not_ne_iff.mp hp
      rw [if_neg hp, hp0, hΦ_zero, zero_mul]

  have hΦ_sum : (∑ᶠ p : k_F × k_F, Φ p) = 0 := by
    have h_tr1 := (h_finsum_transfer (fun _ => 1)).symm
    have h_mul1 : (∑ᶠ p : k_F × k_F, Φ p * 1) = ∑ᶠ p : k_F × k_F, Φ p :=
      finsum_congr fun p => mul_one (Φ p)
    have h_lhs1 :
        (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
          (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
          ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ * 1)) =
        ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) (_ : q ∈ U₀),
          (φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ :=
      finsum_congr fun q => finsum_congr fun _ => mul_one _
    rw [← h_mul1, h_tr1, h_lhs1]
    obtain ⟨v₀, hv₀, hφ'_ne⟩ := h_nontriv₀
    haveI : (EllipticRootNumber.unitGroup F H 1).Normal := Subgroup.normal_of_comm _
    have h_mk_cosetRep : ∀ q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1,
        (QuotientGroup.mk (EllipticRootNumber.cosetRep q) :
          Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) = q :=
      fun q => QuotientGroup.out_eq' q
    let q₀ : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1 := QuotientGroup.mk v₀
    let T (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) :
        Hˣ ⧸ EllipticRootNumber.unitGroup F H 1 := q₀ * q
    have h_T_rel : ∀ q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1,
        (v₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q) ∈
          EllipticRootNumber.unitGroup F H 1 := by
      intro q
      apply QuotientGroup.eq.mp
      rw [QuotientGroup.mk_mul, h_mk_cosetRep, h_mk_cosetRep]
    have h_T_mem : ∀ q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1, T q ∈ U₀ ↔ q ∈ U₀ := by
      intro q
      change EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep (T q) : Hˣ) : H) = 0 ↔
        EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0
      rw [← h_unit0, ← h_unit0]
      have hu₁ : (v₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q) ∈
          EllipticRootNumber.unitGroup F H 0 := h_unit1_le_0 (h_T_rel q)
      constructor
      · intro hTq
        have h_eq : EllipticRootNumber.cosetRep q =
            v₀⁻¹ * EllipticRootNumber.cosetRep (T q) *
              ((v₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q))⁻¹ := by
          group
        rw [h_eq]
        exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hv₀) hTq)
          (Subgroup.inv_mem _ hu₁)
      · intro hq
        have h_eq : EllipticRootNumber.cosetRep (T q) =
            v₀ * EllipticRootNumber.cosetRep q *
              ((v₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q)) := by
          group
        rw [h_eq]
        exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hv₀ hq) hu₁
    have h_T_bij : Set.BijOn T U₀ U₀ := by
      refine ⟨fun q hq => (h_T_mem q).mpr hq, ?_, ?_⟩
      · intro q₁ _ q₂ _ h_eq
        exact mul_left_cancel h_eq
      · intro q hq
        let q' := q₀⁻¹ * q
        have hTq' : T q' = q := mul_inv_cancel_left q₀ q
        refine ⟨q', (h_T_mem q').mp (by rwa [hTq']), hTq'⟩
    have h_T_eval : ∀ q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1,
        (φ' (EllipticRootNumber.cosetRep (T q)) : EllipticRootNumber.Ω F)⁻¹ =
          (φ' v₀ : EllipticRootNumber.Ω F)⁻¹ *
            (φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ := by
      intro q
      have h_eq : EllipticRootNumber.cosetRep (T q) =
          v₀ * EllipticRootNumber.cosetRep q *
            ((v₀ * EllipticRootNumber.cosetRep q)⁻¹ * EllipticRootNumber.cosetRep (T q)) := by
        group
      have h_phi : φ' (EllipticRootNumber.cosetRep (T q)) =
          φ' v₀ * φ' (EllipticRootNumber.cosetRep q) := by
        conv_lhs => rw [h_eq]
        rw [map_mul, map_mul, h_triv₁ _ (h_T_rel q), mul_one]
      rw [h_phi, Units.val_mul, mul_inv_rev, mul_comm]
    set S_U₀ := ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) (_ : q ∈ U₀),
      (φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹
    have h_shift : S_U₀ = (φ' v₀ : EllipticRootNumber.Ω F)⁻¹ * S_U₀ := by
      symm
      rw [mul_finsum]
      have h_in : (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1),
          (φ' v₀ : EllipticRootNumber.Ω F)⁻¹ *
            ∑ᶠ (_ : q ∈ U₀), (φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹) =
          ∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1) (_ : q ∈ U₀),
            (φ' (EllipticRootNumber.cosetRep (T q)) : EllipticRootNumber.Ω F)⁻¹ := by
        refine finsum_congr fun q => ?_
        rw [finsum_eq_if, finsum_eq_if]
        by_cases hq : q ∈ U₀
        · rw [if_pos hq, if_pos hq, h_T_eval q]
        · rw [if_neg hq, if_neg hq, mul_zero]
      rw [h_in]
      exact finsum_mem_eq_of_bijOn T h_T_bij (fun _ _ => rfl)
    have h_sub : ((φ' v₀ : EllipticRootNumber.Ω F)⁻¹ - 1) * S_U₀ = 0 := by
      rw [sub_mul, one_mul, ← h_shift, sub_self]
    have h_inv_ne1 : (φ' v₀ : EllipticRootNumber.Ω F)⁻¹ - 1 ≠ 0 := by
      rw [sub_ne_zero, inv_ne_one]
      intro h1
      exact hφ'_ne (Units.ext h1)
    rcases mul_eq_zero.mp h_sub with h1 | h2
    · exact absurd h1 h_inv_ne1
    · exact h2

  have h_sum_eq :
      (∑ᶠ (q : Hˣ ⧸ EllipticRootNumber.unitGroup F H 1)
        (_ : EllipticRootNumber.valL F H ((EllipticRootNumber.cosetRep q : Hˣ) : H) = 0),
        ((φ' (EllipticRootNumber.cosetRep q) : EllipticRootNumber.Ω F)⁻¹ *
          EllipticRootNumber.traceChar F h ψ
            ((((Units.map (IntermediateField.inclusion h).toMonoidHom c_bot)⁻¹ *
              EllipticRootNumber.cosetRep q : Hˣ) : H)))) =
        ∑ᶠ p : k_F × k_F, Φ p * ψ₀ p.1 := by
    rw [← h_finsum_transfer (fun p => ψ₀ p.1)]
    refine finsum_congr fun q => finsum_congr fun hq => ?_
    congr 1
    obtain ⟨r, s, _, hv_eq, h_res⟩ :=
      h_unit0_int_coords (EllipticRootNumber.cosetRep q) ((h_unit0 _).mpr hq)
    have h_res1 : (resCoord (EllipticRootNumber.cosetRep q)).1 = resA r := by
      rw [h_res]
    rw [h_res1, h_ψ₀_coe, h_ψ₀_apply r, h_ψ_tilde_def]
    change ψ (EllipticRootNumber.traceLM F h
        ((((Units.map ι.toMonoidHom c_bot)⁻¹ * EllipticRootNumber.cosetRep q : Hˣ) : H))) = _
    congr 1
    have h_mul_coord : (((Units.map ι.toMonoidHom c_bot)⁻¹ *
        EllipticRootNumber.cosetRep q : Hˣ) : H) =
        ι (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (r : F)) +
          ι (((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (s : F)) * (u : H) := by
      have hc_inv_coe : (((Units.map ι.toMonoidHom c_bot)⁻¹ : Hˣ) : H) =
          ι ((c_bot⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) := by
        rw [← map_inv (Units.map ι.toMonoidHom) c_bot]
        rfl
      rw [Units.val_mul, hc_inv_coe, hv_eq, map_mul, map_mul]
      ring
    rw [h_mul_coord, h_trace_coord]

  exact ⟨Φ, ψ₀, h_sum_eq, hΦ_zero, hΦ_01, hΦ_scale, hΦ_sum, hψ₀_ne⟩

theorem residue_prod_scale_invariant_gaussSum_eq_q_mul (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (Φ : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer ×
      IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer → EllipticRootNumber.Ω F)
    (ψ₀ : AddChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) (EllipticRootNumber.Ω F))
    (hΦ_zero : Φ (0, 0) = 0)
    (hΦ_scale : ∀ (c : (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)ˣ)
      (a b : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer),
      Φ ((c : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) * a,
        (c : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) * b) = Φ (a, b))
    (hΦ_sum : (∑ᶠ p : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer ×
      IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer, Φ p) = 0)
    (hψ₀_ne : ψ₀ ≠ 1) :
    (∑ᶠ p : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer ×
      IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer, Φ p * ψ₀ p.1) =
      (EllipticRootNumber.q F : EllipticRootNumber.Ω F) * Φ (0, 1) :=
by
  classical
  let k_F := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
  letI : Fintype k_F := Fintype.ofFinite k_F
  have hq_card : EllipticRootNumber.q F = Fintype.card k_F := by
    unfold EllipticRootNumber.q
    exact Nat.card_eq_fintype_card
  have hq_gt_one : 1 < Fintype.card k_F := Fintype.one_lt_card
  let U : Finset k_F := Finset.univ \ {0}
  have hU_mem : ∀ x : k_F, x ∈ U ↔ x ≠ 0 := by
    intro x
    simp [U]
  have hU_card : U.card = Fintype.card k_F - 1 := by
    change (Finset.univ \ ({0} : Finset k_F)).card = Fintype.card k_F - 1
    rw [Finset.card_sdiff_of_subset (Finset.subset_univ _), Finset.card_univ, Finset.card_singleton]
  have h_inner_zero : (∑ b : k_F, Φ (0, b)) = ((Fintype.card k_F - 1 : ℕ) : EllipticRootNumber.Ω F) * Φ (0, 1) := by
    rw [Finset.sum_eq_add_sum_diff_singleton (Finset.mem_univ (0 : k_F)), hΦ_zero, zero_add]
    have h_eq : ∀ b ∈ U, Φ (0, b) = Φ (0, 1) := by
      intro b hb
      have hb0 : b ≠ 0 := (hU_mem b).mp hb
      let c : k_Fˣ := Units.mk0 b hb0
      have hc : (c : k_F) = b := Units.val_mk0 hb0
      calc Φ (0, b) = Φ ((c : k_F) * 0, (c : k_F) * 1) := by rw [mul_zero, mul_one, hc]
        _ = Φ (0, 1) := hΦ_scale c 0 1
    rw [Finset.sum_congr rfl h_eq, Finset.sum_const, nsmul_eq_mul, hU_card]
  let S₁ : EllipticRootNumber.Ω F := ∑ t : k_F, Φ (1, t)
  have h_inner_ne_zero : ∀ a : k_F, a ≠ 0 → (∑ b : k_F, Φ (a, b)) = S₁ := by
    intro a ha
    symm
    let c : k_Fˣ := Units.mk0 a ha
    have hc : (c : k_F) = a := Units.val_mk0 ha
    refine Fintype.sum_equiv (Equiv.mulLeft₀ a ha) (fun t => Φ (1, t)) (fun b => Φ (a, b)) ?_
    intro t
    calc Φ (1, t) = Φ ((c : k_F) * 1, (c : k_F) * t) := (hΦ_scale c 1 t).symm
      _ = Φ (a, a * t) := by rw [hc, mul_one]
      _ = Φ (a, Equiv.mulLeft₀ a ha t) := rfl
  have hΦ_sum' : (∑ a : k_F, ∑ b : k_F, Φ (a, b)) = 0 := by
    have h1 := hΦ_sum
    rw [finsum_eq_sum_of_fintype, Fintype.sum_prod_type] at h1
    exact h1
  have h_S1 : S₁ = -Φ (0, 1) := by
    have h_split := hΦ_sum'
    rw [Finset.sum_eq_add_sum_diff_singleton (Finset.mem_univ (0 : k_F)), h_inner_zero] at h_split
    have h_U_sum : (∑ a ∈ U, ∑ b : k_F, Φ (a, b)) = ((Fintype.card k_F - 1 : ℕ) : EllipticRootNumber.Ω F) * S₁ := by
      have h_eq : ∀ a ∈ U, (∑ b : k_F, Φ (a, b)) = S₁ :=
        fun a ha => h_inner_ne_zero a ((hU_mem a).mp ha)
      rw [Finset.sum_congr rfl h_eq, Finset.sum_const, nsmul_eq_mul, hU_card]
    rw [h_U_sum, ← mul_add] at h_split
    have h_card_ne : ((Fintype.card k_F - 1 : ℕ) : EllipticRootNumber.Ω F) ≠ 0 := by
      rw [Nat.cast_ne_zero]
      omega
    have h_add_zero : Φ (0, 1) + S₁ = 0 := by
      rcases mul_eq_zero.mp h_split with h_c | h_s
      · exact absurd h_c h_card_ne
      · exact h_s
    exact eq_neg_of_add_eq_zero_right h_add_zero
  have h_ψ₀U : (∑ a ∈ U, ψ₀ a) = -1 := by
    have h_sum_ψ₀ : (∑ a : k_F, ψ₀ a) = 0 := AddChar.sum_eq_zero_of_ne_one hψ₀_ne
    rw [Finset.sum_eq_add_sum_diff_singleton (Finset.mem_univ (0 : k_F)), AddChar.map_zero_eq_one] at h_sum_ψ₀
    exact eq_neg_of_add_eq_zero_right h_sum_ψ₀
  rw [finsum_eq_sum_of_fintype, Fintype.sum_prod_type]
  rw [Finset.sum_eq_add_sum_diff_singleton (Finset.mem_univ (0 : k_F))]
  have h_term0 : (∑ b : k_F, Φ (0, b) * ψ₀ 0) = ((Fintype.card k_F - 1 : ℕ) : EllipticRootNumber.Ω F) * Φ (0, 1) := by
    simp only [AddChar.map_zero_eq_one, mul_one]
    exact h_inner_zero
  have h_termU : (∑ a ∈ U, ∑ b : k_F, Φ (a, b) * ψ₀ a) = Φ (0, 1) := by
    have h_eq : ∀ a ∈ U, (∑ b : k_F, Φ (a, b) * ψ₀ a) = S₁ * ψ₀ a := by
      intro a ha
      rw [← Finset.sum_mul, h_inner_ne_zero a ((hU_mem a).mp ha)]
    rw [Finset.sum_congr rfl h_eq, ← Finset.mul_sum, h_S1, h_ψ₀U, neg_mul_neg, mul_one]
  rw [h_term0, h_termU, hq_card]
  have h_card_add : (Fintype.card k_F - 1) + 1 = Fintype.card k_F := Nat.sub_add_cancel (le_of_lt hq_gt_one)
  conv_rhs => rw [← h_card_add, Nat.cast_add, Nat.cast_one, add_mul, one_mul]

theorem tateEps_unramified_quadratic_tame_eq_neg_inv (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ_cond : EllipticRootNumber.condExpChar F ⊥ ψ = 0)
    (hψ_triv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1)
    (hψ_nontriv : ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hd_nonsq : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)))
    (h_valL_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a)
    (h_trace_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.traceLM F h (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 2 * a)
    (φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ)
    (h_cond : EllipticRootNumber.condExp F H φ' = 1)
    (hφ'_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      φ' (Units.map (IntermediateField.inclusion h).toMonoidHom x) =
        (-EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) :
    EllipticRootNumber.tateEps F H φ' (EllipticRootNumber.traceChar F h ψ) =
      -((φ' u : EllipticRootNumber.Ω F)⁻¹) :=
by
  obtain ⟨h_bot_le, h_bot_lt, h_valL_mul, h_valL_inv, h_unit0, h_unit1, h_unit1_le_0⟩ :=
    unramified_quadratic_valL_add_and_unitGroup_spec F H h u d hu_sq hd_val hd_nonsq
      h_coord h_valL_coord
  obtain ⟨c_bot, hc_bot, hψ_c, h_eps_eq⟩ :=
    tateEps_unramified_quadratic_eq_neg_inv_q_mul_finsum F hq2 ψ hψ_triv hψ_nontriv
      H h u h_coord h_valL_coord h_valL_inc h_trace_coord
      h_bot_le h_bot_lt h_valL_mul h_valL_inv h_unit0 h_unit1 h_unit1_le_0
      φ' h_cond hφ'_bot
  obtain ⟨Φ, ψ₀, h_sum_eq, hΦ_zero, hΦ_01, hΦ_scale, hΦ_sum, hψ₀_ne⟩ :=
    unramified_quadratic_coset_finsum_descent_to_residue_prod F hq2 ψ hψ_triv
      H h u h_coord h_valL_coord h_valL_inc h_trace_coord
      h_bot_le h_bot_lt h_valL_mul h_valL_inv h_unit0 h_unit1 h_unit1_le_0
      φ' h_cond hφ'_bot c_bot hc_bot hψ_c
  have h_gs := residue_prod_scale_invariant_gaussSum_eq_q_mul F Φ ψ₀ hΦ_zero hΦ_scale hΦ_sum hψ₀_ne
  have hq_ne : (EllipticRootNumber.q F : EllipticRootNumber.Ω F) ≠ 0 :=
    Nat.cast_ne_zero.mpr (EllipticRootNumber.q_pos F).ne'
  rw [h_eps_eq, h_sum_eq, h_gs, hΦ_01]
  rw [← mul_assoc, neg_mul, inv_mul_cancel₀ hq_ne, neg_one_mul]

theorem tame_quadratic_unit_char_eval_u (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hdi : ¬ ((12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)))
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hd_nonsq : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)))
    (φ' : Hˣ →* (EllipticRootNumber.Ω F)ˣ)
    (h_cond : EllipticRootNumber.condExp F H φ' = 1)
    (hφ'_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      φ' (Units.map (IntermediateField.inclusion h).toMonoidHom x) =
        (-EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))))
    (h_pow : ∀ v ∈ EllipticRootNumber.unitGroup F H 0, φ' v ^ (12 / Nat.gcd n 12) = 1)
    (h_ord : ∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 →
      ∃ v ∈ EllipticRootNumber.unitGroup F H 0, φ' v ^ k ≠ 1) :
    -((φ' u : EllipticRootNumber.Ω F)⁻¹) =
      (((-((-1 : ℤˣ) ^ ((EllipticRootNumber.q F + 1) / (12 / Nat.gcd n 12))) : ℤˣ) : ℤ) : EllipticRootNumber.Ω F) :=
by
  open ValuativeRel in
  (
    let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
        z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
      rintro _ hz m rfl
      exact WithZero.unzero_coe hz
    obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      rw [hπ_val, iso.apply_symm_apply]
    have hπ0 : π ≠ 0 := by
      intro h0
      have : iso (ValuativeRel.valuation F π) = 0 := by rw [h0, map_zero, map_zero]
      rw [hπ_iso] at this
      exact WithZero.exp_ne_zero this
    have hπ_addVal : EllipticRootNumber.addVal F π = 1 := by
      unfold EllipticRootNumber.addVal
      rw [dif_neg hπ0, h_unzero _ _ (-1) hπ_iso]
      rfl
    have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.relVal
      have h_norm : Algebra.norm F x = e_bot x := by
        rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
        rfl
      rw [h_norm]
    have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
      unfold EllipticRootNumber.resDeg
      apply IsLeast.csInf_eq
      refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
      · intro h0
        apply hπ0
        have := congrArg e_bot h0
        simpa using this
      · rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
        omega
      · rintro k ⟨hk, _⟩
        exact hk
    have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.valL
      rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
    have h_addVal_zero_iff : ∀ y : F, y ≠ 0 →
        (EllipticRootNumber.addVal F y = 0 ↔ ValuativeRel.valuation F y = 1) := by
      intro y hy
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      have h_val_one : ValuativeRel.valuation F y = 1 ↔ Multiplicative.toAdd z = 0 := by
        rw [← EmbeddingLike.apply_eq_iff_eq iso, hz_eq, map_one, ← WithZero.exp_zero,
          WithZero.exp_injective.eq_iff]
      rw [h_val_one]
      omega
    have h_addVal_nonneg : ∀ y : F,
        0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
      intro y
      by_cases hy : y = 0
      · subst hy
        unfold EllipticRootNumber.addVal
        rw [dif_pos rfl, Valuation.map_zero]
        exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
      · unfold EllipticRootNumber.addVal
        rw [dif_neg hy]
        have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
        have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
        set z := WithZero.unzero hiso_ne
        have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
          rw [← WithZero.coe_unzero hiso_ne]
          rfl
        rw [← map_le_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
        omega
    have h_addVal_pos : ∀ y : F,
        (y = 0 ∨ 1 ≤ EllipticRootNumber.addVal F y) ↔ ValuativeRel.valuation F y < 1 := by
      intro y
      by_cases hy : y = 0
      · subst hy
        rw [Valuation.map_zero]
        exact ⟨fun _ => zero_lt_one, fun _ => Or.inl rfl⟩
      · rw [or_iff_right hy]
        unfold EllipticRootNumber.addVal
        rw [dif_neg hy]
        have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
        have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
        set z := WithZero.unzero hiso_ne
        have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
          rw [← WithZero.coe_unzero hiso_ne]
          rfl
        rw [← map_lt_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
        omega
    have h_coord₀ : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
        (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) ≠ 0 ∧
          EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 0) ↔
        (ValuativeRel.valuation F (e_bot a) ≤ 1 ∧
          ValuativeRel.valuation F (e_bot b) ≤ 1 ∧
          ¬ (ValuativeRel.valuation F (e_bot a) < 1 ∧ ValuativeRel.valuation F (e_bot b) < 1)) := by
      intro a b
      set w := IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)
      have hw_iff : (w ≠ 0 ∧ EllipticRootNumber.valL F H w = 0) ↔
          (0 ≤ EllipticRootNumber.valL F H w ∧ ¬ (w = 0 ∨ 1 ≤ EllipticRootNumber.valL F H w)) := by
        constructor
        · rintro ⟨hne, h0⟩
          refine ⟨by omega, ?_⟩
          rintro (hw0 | h1)
          · exact hne hw0
          · omega
        · rintro ⟨h0, hnot⟩
          push_neg at hnot
          exact ⟨hnot.1, by omega⟩
      rw [hw_iff, (h_valL_coord a b).1, (h_valL_coord a b).2,
        h_valL a, h_valL b, h_addVal_nonneg, h_addVal_nonneg,
        ← map_eq_zero e_bot, ← map_eq_zero e_bot, h_addVal_pos, h_addVal_pos, and_assoc]
    have h_mem₁ : ∀ (v : Hˣ) (a b : (⊥ : IntermediateField F (AlgebraicClosure F))),
        (v : H) = IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) →
        ValuativeRel.valuation F (e_bot a - 1) < 1 →
        ValuativeRel.valuation F (e_bot b) < 1 →
        v ∈ EllipticRootNumber.unitGroup F H 1 := by
      intro v a b hv_eq ha_lt hb_lt
      unfold EllipticRootNumber.unitGroup
      apply Subgroup.subset_closure
      rw [Set.mem_setOf_eq, if_neg Nat.one_ne_zero]
      have hv_sub : (v : H) - 1 =
          IntermediateField.inclusion h (a - 1) + IntermediateField.inclusion h b * (u : H) := by
        rw [hv_eq, map_sub, map_one]
        ring
      have h_or : (v : H) - 1 = 0 ∨ 1 ≤ EllipticRootNumber.valL F H ((v : H) - 1) := by
        rw [hv_sub, (h_valL_coord (a - 1) b).2, h_valL (a - 1), h_valL b,
          ← map_eq_zero e_bot, ← map_eq_zero e_bot, h_addVal_pos, h_addVal_pos,
          map_sub, map_one]
        exact ⟨ha_lt, hb_lt⟩
      rcases h_or with h0 | h1
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr (by exact_mod_cast h1)
    let d_F : F := e_bot (d : (⊥ : IntermediateField F (AlgebraicClosure F)))
    have hd_F_ne : d_F ≠ 0 := (map_ne_zero e_bot).mpr (Units.ne_zero d)
    have hd_F_val : ValuativeRel.valuation F d_F = 1 :=
      (h_addVal_zero_iff d_F hd_F_ne).mp (by rw [← h_valL]; exact hd_val)
    have hd_sub_ne : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
        (d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2 ≠ 0 := by
      intro a hsub
      have hda : (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = a ^ 2 := sub_eq_zero.mp hsub
      have hu_a : (u : H) ^ 2 = (IntermediateField.inclusion h a) ^ 2 := by
        rw [hu_sq, hda, map_pow]
      have h_zero_one : (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
        rcases sq_eq_sq_iff_eq_or_eq_neg.mp hu_a with hu_eq | hu_eq
        · have hp : ((0 : (⊥ : IntermediateField F (AlgebraicClosure F))),
              (1 : (⊥ : IntermediateField F (AlgebraicClosure F)))) = (a, 0) :=
            (h_coord (u : H)).unique (by simp) (by rw [hu_eq]; simp)
          exact (Prod.ext_iff.mp hp).2.symm
        · have hp : ((0 : (⊥ : IntermediateField F (AlgebraicClosure F))),
              (1 : (⊥ : IntermediateField F (AlgebraicClosure F)))) = (-a, 0) :=
            (h_coord (u : H)).unique (by simp) (by rw [hu_eq, map_neg]; simp)
          exact (Prod.ext_iff.mp hp).2.symm
      exact zero_ne_one h_zero_one
    have hd_nonsq_val : ∀ y : F, ValuativeRel.valuation F y ≤ 1 →
        ValuativeRel.valuation F (d_F - y ^ 2) = 1 := by
      intro y hy
      let a : (⊥ : IntermediateField F (AlgebraicClosure F)) := e_bot.symm y
      have ha_val : 0 ≤ EllipticRootNumber.valL F ⊥ a := by
        rw [h_valL, e_bot.apply_symm_apply, h_addVal_nonneg]
        exact hy
      have h_val0 := hd_nonsq a ha_val
      have h_ne : e_bot ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) ≠ 0 :=
        (map_ne_zero e_bot).mpr (hd_sub_ne a)
      rw [h_valL, h_addVal_zero_iff _ h_ne, map_sub, map_pow, e_bot.apply_symm_apply] at h_val0
      exact h_val0
    let A := (ValuativeRel.valuation F).valuationSubring
    let kF := IsLocalRing.ResidueField ↥A
    haveI : Finite kF := inferInstanceAs (Finite 𝓀[F])
    let d_A : ↥A := ⟨d_F, le_of_eq hd_F_val⟩
    let d_bar : kF := IsLocalRing.residue ↥A d_A
    have h_nonsq_bar : ∀ r : kF, r ^ 2 ≠ d_bar + 0 * r := by
      intro r hr
      rw [zero_mul, add_zero] at hr
      obtain ⟨y_A, rfl⟩ := IsLocalRing.residue_surjective (R := ↥A) r
      have h_res0 : IsLocalRing.residue ↥A (d_A - y_A ^ 2) = 0 := by
        rw [map_sub, map_pow]
        change d_bar - (IsLocalRing.residue ↥A y_A) ^ 2 = 0
        rw [hr, sub_self]
      rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff] at h_res0
      change ValuativeRel.valuation F (d_F - (y_A : F) ^ 2) < 1 at h_res0
      rw [hd_nonsq_val (y_A : F) y_A.2] at h_res0
