      mul_comm d⁻¹ b, ← mul_assoc a b d⁻¹, mul_assoc (a * b) d⁻¹ c⁻¹,
      mul_comm d⁻¹ c⁻¹, ← mul_assoc (a * b) c⁻¹ d⁻¹]
  have h_comm3 : ∀ {M : Type u} [CommGroup M] (a b c : M),
      (b * a⁻¹) * (c * b⁻¹) = c * a⁻¹ := by
    intro M _ a b c
    rw [mul_comm c b⁻¹, ← mul_assoc (b * a⁻¹) b⁻¹ c, mul_comm b a⁻¹,
      mul_inv_cancel_right, mul_comm]
  have h_comm4 : ∀ {M : Type u} [CommGroup M] (a b c d : M),
      (a * b) * (c * d) = (a * c) * (b * d) := by
    intro M _ a b c d
    rw [mul_assoc a b, ← mul_assoc b c d, mul_comm b c, mul_assoc c b d, ← mul_assoc a c]
  have h_comm5 : ∀ {M : Type u} [CommGroup M] (a b c : M),
      a * (b * c) = b * (a * c) := by
    intro M _ a b c
    rw [← mul_assoc a b c, mul_comm a b, mul_assoc b a c]
  have h_comm6 : ∀ {M : Type u} [CommGroup M] (A B : M),
      A * (A * B⁻¹)⁻¹ = B := by
    intro M _ A B
    rw [mul_inv_rev, inv_inv, mul_comm B A⁻¹, mul_inv_cancel_left]
  let spanHom : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField →*
      FractionalIdeal
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField :=
    { toFun := FractionalIdeal.spanSingleton
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
