        exact h_re_res
      · rw [e_bot.apply_symm_apply]
        exact h_im_res
    obtain ⟨x_g, hx_g⟩ := IsLocalRing.residue_surjective (R := ↥A) (g : E₂).re
    obtain ⟨y_g, hy_g⟩ := IsLocalRing.residue_surjective (R := ↥A) (g : E₂).im
    let z_g : R_A := ⟨x_g, y_g⟩
    have hz_g_red : red z_g = (g : E₂) := by
