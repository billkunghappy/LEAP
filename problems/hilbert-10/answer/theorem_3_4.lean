      have h0 : sInf S = 0 := by rw [h_emp, Nat.sInf_empty]
      change EllipticRootNumber.condExp F H φ' = 0 at h0
      omega
    have h_triv₁ : ∀ v ∈ EllipticRootNumber.unitGroup F H 1, φ' v = 1 := by
      change 1 ∈ S
