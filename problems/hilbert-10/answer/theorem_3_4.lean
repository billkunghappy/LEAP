    let u_bar : E₂ˣ := Units.mk0 u_bar₀ hu_bar₀_ne
    have hu_bar_sq : u_bar₀ ^ 2 = C_E2 d_bar := by
      rw [sq]
      refine QuadraticAlgebra.ext ?_ ?_
