      map_mul' := hχ₂_mul }
  have hχ'₁_rec : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      χ'₁ x = χ₁ (rec.recMap ⊥ x) := fun _ => rfl
  have hχ'₂_rec : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      χ'₂ x = χ₂ (rec.recMap ⊥ x) := fun _ => rfl
  have h_prod : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      χ'₁ x * χ'₂ x =
        (EllipticRootNumber.qUnit F) ^
          (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) := by
    intro x
    rw [hχ'₁_rec, hχ'₂_rec, hχ_prod]
    unfold EllipticRootNumber.relNorm EllipticRootNumber.weilNormHom
    simp only [MonoidHom.comp_apply, rec.degree_rec ⊥ x, h_relVal, zpowersHom_apply, toAdd_ofAdd]
  
  have h_rec_in_of_val0 : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 →
      (rec.recMap ⊥ u : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F := by
    intro u hu0
    apply h_deg_in
    rw [rec.degree_rec ⊥ u, h_relVal, hu0, neg_zero, ofAdd_zero]
  have h_pow : ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ'₁ u ^ e = 1 := by
    intro u hu
    rw [hχ'₁_rec]
    exact hχ_pow (rec.recMap ⊥ u) (h_rec_in_of_val0 u ((h_unit0 u).mp hu))
  have h_triv_U1 : ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 1, χ'₁ u = 1 ∧ χ'₂ u = 1 := by
    intro u hu
    obtain ⟨hu_val0, hu_norm⟩ := hU₁ u hu
    have hu_in : (rec.recMap ⊥ u : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F :=
      h_rec_in_of_val0 u hu_val0
    have hu_M : (rec.recMap ⊥ u : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
      (rec.ker_rec ⊥ M bot_le hM_ab u).mpr hu_norm
    rw [hχ'₁_rec, hχ'₂_rec]
    exact hχ_triv (rec.recMap ⊥ u) hu_in hu_M
  have h_rec_one_M : (rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup := by
    have h11 := rec.mul_rec ⊥ M bot_le hM_ab 1 1
    rw [mul_one] at h11
    have heq : (((rec.recMap ⊥ 1)⁻¹ * (rec.recMap ⊥ 1 * rec.recMap ⊥ 1) :
        EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) =
      (rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F) := by
      change (rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F)⁻¹ *
        ((rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F) *
          (rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F)) =
        (rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F)
      group
    rwa [heq] at h11
  let K_M : Subgroup (⊥ : IntermediateField F (AlgebraicClosure F))ˣ :=
    { carrier := {y | (rec.recMap ⊥ y : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup}
      one_mem' := h_rec_one_M
      mul_mem' := fun {a b} ha hb => by
        have hab := rec.mul_rec ⊥ M bot_le hM_ab a b
        have h_prod_ab := M.fixingSubgroup.mul_mem
          (M.fixingSubgroup.mul_mem ha hb) (M.fixingSubgroup.inv_mem hab)
        have heq : ((rec.recMap ⊥ a : EllipticRootNumber.AbsGal F) *
            (rec.recMap ⊥ b : EllipticRootNumber.AbsGal F)) *
          ((((rec.recMap ⊥ (a * b))⁻¹ * (rec.recMap ⊥ a * rec.recMap ⊥ b) :
            EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F))⁻¹ =
          (rec.recMap ⊥ (a * b) : EllipticRootNumber.AbsGal F) := by
          change ((rec.recMap ⊥ a : EllipticRootNumber.AbsGal F) *
              (rec.recMap ⊥ b : EllipticRootNumber.AbsGal F)) *
            ((rec.recMap ⊥ (a * b) : EllipticRootNumber.AbsGal F)⁻¹ *
              ((rec.recMap ⊥ a : EllipticRootNumber.AbsGal F) *
                (rec.recMap ⊥ b : EllipticRootNumber.AbsGal F)))⁻¹ =
            (rec.recMap ⊥ (a * b) : EllipticRootNumber.AbsGal F)
          group
        rwa [heq] at h_prod_ab
      inv_mem' := fun {a} ha => by
        have hab := rec.mul_rec ⊥ M bot_le hM_ab a a⁻¹
        rw [mul_inv_cancel] at hab
        have h_inv_a := M.fixingSubgroup.mul_mem (M.fixingSubgroup.inv_mem ha)
          (M.fixingSubgroup.mul_mem h_rec_one_M hab)
        have heq : (rec.recMap ⊥ a : EllipticRootNumber.AbsGal F)⁻¹ *
            ((rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F) *
              (((rec.recMap ⊥ 1)⁻¹ * (rec.recMap ⊥ a * rec.recMap ⊥ a⁻¹) :
                EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F)) =
          (rec.recMap ⊥ a⁻¹ : EllipticRootNumber.AbsGal F) := by
          change (rec.recMap ⊥ a : EllipticRootNumber.AbsGal F)⁻¹ *
              ((rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F) *
                ((rec.recMap ⊥ 1 : EllipticRootNumber.AbsGal F)⁻¹ *
                  ((rec.recMap ⊥ a : EllipticRootNumber.AbsGal F) *
                    (rec.recMap ⊥ a⁻¹ : EllipticRootNumber.AbsGal F)))) =
            (rec.recMap ⊥ a⁻¹ : EllipticRootNumber.AbsGal F)
          group
        rwa [heq] at h_inv_a }
  obtain ⟨π_M, hπ_M_val, hπ_M_norm⟩ := hπ_M
  have hπ_M_mem : π_M ∈ K_M := (rec.ker_rec ⊥ M bot_le hM_ab π_M).mpr hπ_M_norm
  have h_ord : ∀ d : ℕ, d ∣ e → d < e →
      ∃ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ'₁ u ^ d ≠ 1 := by
    intro d hd hlt
    obtain ⟨w, hw_in, hw_ne⟩ := hχ_ord d hd hlt
    obtain ⟨x, hx_M⟩ := rec.surj_rec ⊥ M bot_le hM_ab w
    let k : ℤ := EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))
    let u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := x * π_M ^ (-k)
    have hu_val0 : EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
      rw [h_valL_mul x (π_M ^ (-k)), h_valL_zpow π_M (-k), hπ_M_val]
      change k + -k * 1 = 0
      omega
    have hu_unit0 : u ∈ EllipticRootNumber.unitGroup F ⊥ 0 := (h_unit0 u).mpr hu_val0
    have hu_in : (rec.recMap ⊥ u : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F :=
      h_rec_in_of_val0 u hu_val0
    have h_diff_in : (((rec.recMap ⊥ u)⁻¹ * w : EllipticRootNumber.relWeil F ⊥) :
        EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F :=
      (EllipticRootNumber.inertia F).mul_mem ((EllipticRootNumber.inertia F).inv_mem hu_in) hw_in
    have hπ_zpow_M : (rec.recMap ⊥ (π_M ^ (-k)) : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
      K_M.zpow_mem hπ_M_mem (-k)
    have h_mul_u := rec.mul_rec ⊥ M bot_le hM_ab x (π_M ^ (-k))
    have h_diff_M : (((rec.recMap ⊥ u)⁻¹ * w : EllipticRootNumber.relWeil F ⊥) :
        EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup := by
      have h_comb := M.fixingSubgroup.mul_mem
        (M.fixingSubgroup.mul_mem h_mul_u (M.fixingSubgroup.inv_mem hπ_zpow_M)) hx_M
      have heq : ((((rec.recMap ⊥ u)⁻¹ * (rec.recMap ⊥ x * rec.recMap ⊥ (π_M ^ (-k))) :
            EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) *
          (rec.recMap ⊥ (π_M ^ (-k)) : EllipticRootNumber.AbsGal F)⁻¹) *
        (((rec.recMap ⊥ x)⁻¹ * w : EllipticRootNumber.relWeil F ⊥) :
          EllipticRootNumber.AbsGal F) =
        (((rec.recMap ⊥ u)⁻¹ * w : EllipticRootNumber.relWeil F ⊥) :
          EllipticRootNumber.AbsGal F) := by
        change (((rec.recMap ⊥ u : EllipticRootNumber.AbsGal F)⁻¹ *
              ((rec.recMap ⊥ x : EllipticRootNumber.AbsGal F) *
                (rec.recMap ⊥ (π_M ^ (-k)) : EllipticRootNumber.AbsGal F))) *
            (rec.recMap ⊥ (π_M ^ (-k)) : EllipticRootNumber.AbsGal F)⁻¹) *
          ((rec.recMap ⊥ x : EllipticRootNumber.AbsGal F)⁻¹ * (w : EllipticRootNumber.AbsGal F)) =
          (rec.recMap ⊥ u : EllipticRootNumber.AbsGal F)⁻¹ * (w : EllipticRootNumber.AbsGal F)
        group
      rwa [heq] at h_comb
    have hχ₁_diff := (hχ_triv ((rec.recMap ⊥ u)⁻¹ * w) h_diff_in h_diff_M).1
    rw [map_mul, map_inv] at hχ₁_diff
    have hχ'₁_eq_w : χ'₁ u = χ₁ w := by
      rw [hχ'₁_rec]
      exact inv_mul_eq_one.mp hχ₁_diff
    refine ⟨u, hu_unit0, ?_⟩
    rw [hχ'₁_eq_w]
    exact hw_ne
  obtain ⟨u₀, hu₀_unit0, hu₀_ne1⟩ := h_ord 1 (one_dvd e) (by omega)
  rw [pow_one] at hu₀_ne1
  have hu₀_ne2 : χ'₂ u₀ ≠ 1 := by
    intro h2
    have hp := h_prod u₀
    rw [(h_unit0 u₀).mp hu₀_unit0, neg_zero, zpow_zero, h2, mul_one] at hp
    exact hu₀_ne1 hp
  have h_cond₁ : EllipticRootNumber.condExp F ⊥ χ'₁ = 1 := by
    unfold EllipticRootNumber.condExp
    apply IsLeast.csInf_eq
    refine ⟨fun u hu => (h_triv_U1 u hu).1, ?_⟩
    intro a ha
    by_contra hlt
    have ha0 : a = 0 := by omega
    rw [ha0] at ha
    exact hu₀_ne1 (ha u₀ hu₀_unit0)
  have h_cond₂ : EllipticRootNumber.condExp F ⊥ χ'₂ = 1 := by
    unfold EllipticRootNumber.condExp
    apply IsLeast.csInf_eq
    refine ⟨fun u hu => (h_triv_U1 u hu).2, ?_⟩
    intro a ha
    by_contra hlt
    have ha0 : a = 0 := by omega
    rw [ha0] at ha
    exact hu₀_ne2 (ha u₀ hu₀_unit0)
  exact ⟨χ'₁, χ'₂, hW₁, hW₂, hχ'₁_rec, hχ'₂_rec, h_prod, h_cond₁, h_cond₂, h_pow, h_ord⟩

theorem ellAdicRep_abelian_short_exact_tame (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1))
    (rec : EllipticRootNumber.LocalReciprocity F) :
    ∃ (χ₁ χ₂ : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
      (χ'₁ χ'₂ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ)
      (f : ULift.{u} (EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E)
      (g : EllipticRootNumber.VBar F E →ₗ[EllipticRootNumber.Ω F] ULift.{u} (EllipticRootNumber.Ω F)),
      EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ₁) ∧
      EllipticRootNumber.IsWeilRep F ⊥
        ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) ∧
      EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ₂) ∧
      (∀ w, f ∘ₗ EllipticRootNumber.charRep F ⊥ χ₁ w =
        ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w ∘ₗ f) ∧
      (∀ w, g ∘ₗ ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w =
        EllipticRootNumber.charRep F ⊥ χ₂ w ∘ₗ g) ∧
      Function.Injective f ∧
      Function.Surjective g ∧
      LinearMap.range f = LinearMap.ker g ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ, χ'₁ x = χ₁ (rec.recMap ⊥ x)) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ, χ'₂ x = χ₂ (rec.recMap ⊥ x)) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        χ'₁ x * χ'₂ x =
          (EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) ∧
      EllipticRootNumber.condExp F ⊥ χ'₁ = 1 ∧
      EllipticRootNumber.condExp F ⊥ χ'₂ = 1 ∧
      (∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ'₁ u ^ (12 / Nat.gcd n 12) = 1) ∧
      (∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 →
        ∃ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ'₁ u ^ d ≠ 1) :=
by
  have he : 2 ≤ 12 / Nat.gcd n 12 := by
    interval_cases n <;> decide
  obtain ⟨π, ϖ, M, τ₀, ζ, hπ_ne, hπ_val, hϖ_ne, hϖ_pow, _hϖ_mem, hM_fin, hM_ab, hM_fix,
    hτ₀_in, hζ_pow, hζ_ord, hτ₀_ϖ, hπ_M, hU₁⟩ :=
    exists_tame_kummer_extension F n hn0 hn12 hn23 hq2 hq3 hab
  haveI : FiniteDimensional F M := hM_fin
  obtain ⟨hV_dim, hσ_triv_ϖ, hσ_det, hσ_pow, hτ₀_ord⟩ :=
    ellAdicRep_kummer_inertia_and_det_spec F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hn23 hΔ hc₄ hj
      hq2 hq3 hab π ϖ τ₀ ζ hπ_ne hπ_val hϖ_ne hϖ_pow hτ₀_in hζ_pow hζ_ord hτ₀_ϖ
  have hσ_triv : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
      ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w = 1 :=
    fun w hwI hwM => hσ_triv_ϖ w hwI ((hM_fix (w : EllipticRootNumber.AbsGal F)).mp hwM)
  have hW : EllipticRootNumber.IsWeilRep F ⊥
      ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) :=
    ⟨FiniteDimensional.of_finrank_pos (by omega),
      ⟨(M.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)),
        (IntermediateField.fixingSubgroup_isOpen M).mem_nhds M.fixingSubgroup.one_mem,
        fun w hwU hwI => hσ_triv w hwI hwU⟩⟩
  obtain ⟨χ₁, χ₂, f, g, hf_eq, hg_eq, hf_inj, hg_surj, hfg_exact,
    hχ_triv, hχ_prod, hχ_pow, hχ_ord⟩ :=
    commuting_two_dim_rep_short_exact_of_abelian_inertia F M hM_ab (12 / Nat.gcd n 12)
      ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
      hV_dim hσ_triv hσ_det hσ_pow τ₀ hτ₀_in hτ₀_ord
  obtain ⟨χ'₁, χ'₂, hW₁, hW₂, hχ'₁_rec, hχ'₂_rec, h_prod, h_cond₁, h_cond₂, h_pow, h_ord⟩ :=
    rec_char_tame_short_exact_spec F M hM_ab (12 / Nat.gcd n 12) he hπ_M hU₁
      χ₁ χ₂ hχ_triv hχ_prod hχ_pow hχ_ord rec
  exact ⟨χ₁, χ₂, χ'₁, χ'₂, f, g, hW₁, hW, hW₂, hf_eq, hg_eq, hf_inj, hg_surj, hfg_exact,
    hχ'₁_rec, hχ'₂_rec, h_prod, h_cond₁, h_cond₂, h_pow, h_ord⟩

theorem tateEps_mul_complementary_tame (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ_cond : EllipticRootNumber.condExpChar F ⊥ ψ = 0)
    (hψ_triv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1)
    (hψ_nontriv : ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (χ'₁ χ'₂ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ)
    (h_cond₁ : EllipticRootNumber.condExp F ⊥ χ'₁ = 1)
    (h_cond₂ : EllipticRootNumber.condExp F ⊥ χ'₂ = 1)
    (h_prod : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      χ'₁ x * χ'₂ x =
        (EllipticRootNumber.qUnit F) ^ (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) :
    EllipticRootNumber.tateEps F ⊥ χ'₁ ψ * EllipticRootNumber.tateEps F ⊥ χ'₂ ψ =
      (χ'₁ (-1) : EllipticRootNumber.Ω F) :=
by
  open ValuativeRel in
  (
    classical
    let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
    let u_bot : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ≃* Fˣ :=
      Units.mapEquiv e_bot.toMulEquiv
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
        z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
      rintro _ hz m rfl
      exact WithZero.unzero_coe hz
    obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      rw [hπ_val, iso.apply_symm_apply]
    have hπ0 : π ≠ 0 := by
      intro h0
      have : iso (ValuativeRel.valuation F π) = 0 := by rw [h0, map_zero, map_zero]
      rw [hπ_iso] at this
      exact WithZero.exp_ne_zero this
    have hπ_addVal : EllipticRootNumber.addVal F π = 1 := by
      unfold EllipticRootNumber.addVal
      rw [dif_neg hπ0, h_unzero _ _ (-1) hπ_iso]
      rfl
    have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.relVal
      have h_norm : Algebra.norm F x = e_bot x := by
        rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
        rfl
      rw [h_norm]
    have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
      unfold EllipticRootNumber.resDeg
      apply IsLeast.csInf_eq
      refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
      · intro h0
        apply hπ0
        have := congrArg e_bot h0
        simpa using this
      · rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
        omega
      · rintro k ⟨hk, _⟩
        exact hk
    have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.valL
      rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
    have h_addVal_exp : ∀ y : F, y ≠ 0 →
        iso (ValuativeRel.valuation F y) = WithZero.exp (-EllipticRootNumber.addVal F y) := by
      intro y hy
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy, neg_neg]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      exact (WithZero.coe_unzero hiso_ne).symm
    have h_addVal_of_exp : ∀ (y : F) (m : ℤ),
        iso (ValuativeRel.valuation F y) = WithZero.exp (-m) →
        EllipticRootNumber.addVal F y = m := by
      intro y m hm
      have hy : y ≠ 0 := by
        intro h0
        rw [h0, map_zero, map_zero] at hm
        exact WithZero.exp_ne_zero hm.symm
      rw [h_addVal_exp y hy] at hm
      have := WithZero.exp_injective hm
      omega
    have h_valL_inv : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥
          ((u⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) =
          -EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
      intro u
      rw [h_valL, h_valL]
      have hy : e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
        (map_ne_zero e_bot).mpr (Units.ne_zero u)
      apply h_addVal_of_exp
      have h_inv_coe : e_bot ((u⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) =
          (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))))⁻¹ := by
        rw [Units.val_inv_eq_inv_val, map_inv₀]
      rw [h_inv_coe, map_inv₀, map_inv₀, h_addVal_exp _ hy, ← WithZero.exp_neg, neg_neg]
    have h_valL_mul : ∀ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
        (y : (⊥ : IntermediateField F (AlgebraicClosure F))),
        y ≠ 0 →
        EllipticRootNumber.valL F ⊥ ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) * y) =
          EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) +
            EllipticRootNumber.valL F ⊥ y := by
      intro u y hy
      rw [h_valL, h_valL, h_valL, map_mul]
      have hu : e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
        (map_ne_zero e_bot).mpr (Units.ne_zero u)
      have hy' : e_bot y ≠ 0 := (map_ne_zero e_bot).mpr hy
      apply h_addVal_of_exp
      rw [map_mul, map_mul, h_addVal_exp _ hu, h_addVal_exp _ hy', ← WithZero.exp_add, neg_add]
    have h_addVal_zero : ∀ y : F, y ≠ 0 →
        (EllipticRootNumber.addVal F y = 0 ↔ ValuativeRel.valuation F y = 1) := by
      intro y hy
      rw [← EmbeddingLike.apply_eq_iff_eq iso, h_addVal_exp y hy, map_one, ← WithZero.exp_zero,
        WithZero.exp_injective.eq_iff]
      omega
    have h_addVal_pos : ∀ y : F, y ≠ 0 →
        ((1 : ℤ) ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y < 1) := by
      intro y hy
      rw [← map_lt_map_iff iso, h_addVal_exp y hy, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
      omega
    have h_valL_nonneg : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        0 ≤ EllipticRootNumber.valL F ⊥ x ↔ ValuativeRel.valuation F (e_bot x) ≤ 1 := by
      intro x
      rw [h_valL]
      by_cases hx : x = 0
      · subst hx
        rw [map_zero, map_zero]
        unfold EllipticRootNumber.addVal
        rw [dif_pos rfl]
        exact ⟨fun _ => zero_le_one, fun _ => le_rfl⟩
      · have hy : e_bot x ≠ 0 := (map_ne_zero e_bot).mpr hx
        rw [← map_le_map_iff iso, h_addVal_exp _ hy, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
        omega
    have h_valL_pos : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        (x = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ x) ↔ ValuativeRel.valuation F (e_bot x) < 1 := by
      intro x
      by_cases hx : x = 0
      · subst hx
        rw [map_zero, map_zero]
        exact ⟨fun _ => zero_lt_one, fun _ => Or.inl rfl⟩
      · have hy : e_bot x ≠ 0 := (map_ne_zero e_bot).mpr hx
        rw [or_iff_right hx, h_valL, h_addVal_pos _ hy]
    let A := (ValuativeRel.valuation F).valuationSubring
    let H₀ : Subgroup (⊥ : IntermediateField F (AlgebraicClosure F))ˣ :=
      A.unitGroup.comap u_bot.toMonoidHom
    have h_H₀_mem : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        u ∈ H₀ ↔ ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 := by
      intro u
      change u_bot u ∈ A.unitGroup ↔ _
      rw [Valuation.mem_unitGroup_iff]
      rfl
    have h_set_eq₀ : {u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ |
        if (0 : ℕ) = 0 then EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
        else ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∨
          ((0 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F ⊥ ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1))} =
        (H₀ : Set (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) := by
      ext u
      rw [Set.mem_setOf_eq, SetLike.mem_coe, if_pos rfl, h_H₀_mem, h_valL]
      exact h_addVal_zero (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))))
        ((map_ne_zero e_bot).mpr (Units.ne_zero u))
    have h_mem₀ : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        u ∈ EllipticRootNumber.unitGroup F ⊥ 0 ↔
          ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 := by
      intro u
      unfold EllipticRootNumber.unitGroup
      rw [h_set_eq₀, Subgroup.closure_eq]
      exact h_H₀_mem u
    have h_unit0 : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        u ∈ EllipticRootNumber.unitGroup F ⊥ 0 ↔
          EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
      intro u
      rw [h_mem₀, h_valL, h_addVal_zero _ ((map_ne_zero e_bot).mpr (Units.ne_zero u))]
    let π_red : ↥A.unitGroup →* 𝓀[F]ˣ := A.unitGroupToResidueFieldUnits
    have h_ker_iff : ∀ x : ↥A.unitGroup,
        π_red x = 1 ↔ ValuativeRel.valuation F (((x : Fˣ) : F) - 1) < 1 := by
      intro x
      have h_coe : ((π_red x : 𝓀[F]ˣ) : 𝓀[F]) =
          IsLocalRing.residue ↥A (A.unitGroupMulEquiv x : ↥A) :=
        ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A x
      have h_sub : ((((A.unitGroupMulEquiv x : ↥A) - 1 : ↥A) : F)) = ((x : Fˣ) : F) - 1 := by
        change ((A.unitGroupMulEquiv x : ↥A) : F) - 1 = ((x : Fˣ) : F) - 1
        rw [ValuationSubring.coe_unitGroupMulEquiv_apply A x]
      rw [Units.ext_iff, Units.val_one, h_coe, ← sub_eq_zero, ← map_one (IsLocalRing.residue ↥A),
        ← map_sub (IsLocalRing.residue ↥A), IsLocalRing.residue_eq_zero_iff,
        Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F), h_sub]
    let H₁ : Subgroup (⊥ : IntermediateField F (AlgebraicClosure F))ˣ :=
      ((π_red.ker).map A.unitGroup.subtype).comap u_bot.toMonoidHom
    have h_H₁_mem : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        u ∈ H₁ ↔ ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) < 1 := by
      intro u
      change u_bot u ∈ (π_red.ker).map A.unitGroup.subtype ↔ _
      rw [Subgroup.mem_map]
      constructor
      · rintro ⟨x, hx, h_eq⟩
        have hlt := (h_ker_iff x).mp hx
        have h_coe : ((x : Fˣ) : F) = e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
          change ((A.unitGroup.subtype x : Fˣ) : F) = _
          rw [h_eq]
          rfl
        rwa [h_coe] at hlt
      · intro hlt
        have h_val1 : ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 := by
          have h_add : e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) =
              (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) + 1 := by ring
          have hlt' : ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) <
              ValuativeRel.valuation F 1 := by rwa [Valuation.map_one]
          rw [h_add, Valuation.map_add_eq_of_lt_right _ hlt', Valuation.map_one]
        have huA : u_bot u ∈ A.unitGroup := by
          rw [Valuation.mem_unitGroup_iff]
          exact h_val1
        refine ⟨⟨u_bot u, huA⟩, ?_, rfl⟩
        rw [MonoidHom.mem_ker, h_ker_iff]
        exact hlt
    have h_set_eq₁ : {u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ |
        if (1 : ℕ) = 0 then EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
        else ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∨
          ((1 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F ⊥ ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1))} =
        (H₁ : Set (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) := by
      ext u
      rw [Set.mem_setOf_eq, SetLike.mem_coe, if_neg Nat.one_ne_zero, Nat.cast_one, h_H₁_mem]
      have h_sub_zero : (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ↔
          (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1 = 0 := sub_eq_zero.symm
      have h_ebot_sub : e_bot ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) =
          e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1 := by
        rw [map_sub, map_one]
      rw [h_sub_zero, h_valL_pos ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1), h_ebot_sub]
    have h_unit1 : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        u ∈ EllipticRootNumber.unitGroup F ⊥ 1 ↔
          ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) < 1 := by
      intro u
      unfold EllipticRootNumber.unitGroup
      rw [h_set_eq₁, Subgroup.closure_eq]
      exact h_H₁_mem u

    
    obtain ⟨x₀, hx₀_val, hx₀_ne⟩ := hψ_nontriv
    have hx₀_ne0 : x₀ ≠ 0 := by
      intro h0
      apply hx₀_ne
      rw [h0, AddChar.map_zero_eq_one]
    let c₀ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := (Units.mk0 x₀ hx₀_ne0)⁻¹
    have hc₀_val : EllipticRootNumber.valL F ⊥ (c₀ : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
      rw [h_valL_inv (Units.mk0 x₀ hx₀_ne0)]
      change -EllipticRootNumber.valL F ⊥ x₀ = 1
      omega
    have h_ex_c : ∃ c : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 :=
      ⟨c₀, hc₀_val⟩
    let c := EllipticRootNumber.tateElt F ⊥ χ'₁ ψ
    have hc_eq : EllipticRootNumber.tateElt F ⊥ χ'₂ ψ = c := by
      change EllipticRootNumber.tateElt F ⊥ χ'₂ ψ = EllipticRootNumber.tateElt F ⊥ χ'₁ ψ
      unfold EllipticRootNumber.tateElt
      rw [h_cond₁, h_cond₂]
    have hc_val : EllipticRootNumber.valL F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
      have hc_def : c = Classical.epsilon (fun c' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ =>
          EllipticRootNumber.valL F ⊥ (c' : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1) := by
        change EllipticRootNumber.tateElt F ⊥ χ'₁ ψ = _
        unfold EllipticRootNumber.tateElt
        rw [h_cond₁, hψ_cond, Nat.cast_one, add_zero]
      rw [hc_def]
      exact Classical.epsilon_spec h_ex_c
    have h_tateEps_unfold : ∀ (χ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ),
        EllipticRootNumber.condExp F ⊥ χ = 1 →
        EllipticRootNumber.tateEps F ⊥ χ ψ =
          ∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
            (_ : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0),
            ((χ ((EllipticRootNumber.tateElt F ⊥ χ ψ)⁻¹ * EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F)⁻¹ *
              ψ ((((EllipticRootNumber.tateElt F ⊥ χ ψ)⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))))) := by
      intro χ h_cond
      unfold EllipticRootNumber.tateEps
      rw [hψ_cond, zpow_zero, one_mul]
      generalize EllipticRootNumber.condExp F ⊥ χ = a at h_cond ⊢
      subst h_cond
      rw [if_neg Nat.one_ne_zero]
    have h_factor_c : ∀ (χ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ)
        (c' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ),
        (∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
          (_ : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0),
          ((χ (c'⁻¹ * EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F)⁻¹ *
            ψ (((c'⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F)))))) =
        (χ c' : EllipticRootNumber.Ω F) *
          ∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
            (_ : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0),
            ((χ (EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F)⁻¹ *
              ψ (((c'⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))))) := by
      intro χ c'
      rw [mul_finsum]
      refine finsum_congr fun u => ?_
      by_cases hu : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
      · simp [hu, map_mul, map_inv]
        ring
      · simp [hu]
    have h_eps₁ : EllipticRootNumber.tateEps F ⊥ χ'₁ ψ =
        (χ'₁ c : EllipticRootNumber.Ω F) *
          ∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
            (_ : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0),
            ((χ'₁ (EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F)⁻¹ *
              ψ (((c⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))))) := by
      rw [h_tateEps_unfold χ'₁ h_cond₁]
      exact h_factor_c χ'₁ c
    have h_eps₂ : EllipticRootNumber.tateEps F ⊥ χ'₂ ψ =
        (χ'₂ c : EllipticRootNumber.Ω F) *
          ∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
            (_ : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0),
            ((χ'₁ (EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F) *
              ψ (((c⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))))) := by
      rw [h_tateEps_unfold χ'₂ h_cond₂, hc_eq, h_factor_c χ'₂ c]
      congr 1
      refine finsum_congr fun u => finsum_congr fun hu0 => ?_
      congr 1
      have hp := h_prod (EllipticRootNumber.cosetRep u)
      rw [hu0, neg_zero, zpow_zero] at hp
      have hp_val : (χ'₁ (EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F) *
          (χ'₂ (EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F) = 1 := by
        rw [← Units.val_mul, hp, Units.val_one]
      exact inv_eq_of_mul_eq_one_left hp_val
    have hc_prod : (χ'₁ c : EllipticRootNumber.Ω F) * (χ'₂ c : EllipticRootNumber.Ω F) =
        (EllipticRootNumber.q F : EllipticRootNumber.Ω F)⁻¹ := by
      have hp := h_prod c
      rw [hc_val, zpow_neg_one] at hp
      rw [← Units.val_mul, hp, Units.val_inv_eq_inv_val]
      rfl

    
    let toH₀ : EllipticRootNumber.unitGroup F ⊥ 0 →* ↥A.unitGroup :=
      { toFun := fun w => ⟨u_bot w.1,
          (Valuation.mem_unitGroup_iff F (ValuativeRel.valuation F) (u_bot w.1)).mpr
            ((h_mem₀ w.1).mp w.2)⟩
        map_one' := Subtype.ext (map_one u_bot)
        map_mul' := fun _ _ => Subtype.ext (map_mul u_bot _ _) }
    let red₀ : EllipticRootNumber.unitGroup F ⊥ 0 →* 𝓀[F]ˣ := π_red.comp toH₀
    have h_red₀_surj : Function.Surjective red₀ := by
      intro a
      obtain ⟨x, hx⟩ := ValuationSubring.surjective_unitGroupToResidueFieldUnits A a
      let u := u_bot.symm x.1
      have hu₀ : u ∈ EllipticRootNumber.unitGroup F ⊥ 0 := by
        rw [h_mem₀]
        change ValuativeRel.valuation F ((u_bot (u_bot.symm x.1) : Fˣ) : F) = 1
        rw [u_bot.apply_symm_apply]
        exact (Valuation.mem_unitGroup_iff F (ValuativeRel.valuation F) x.1).mp x.2
      refine ⟨⟨u, hu₀⟩, ?_⟩
      change π_red (toH₀ ⟨u, hu₀⟩) = a
      have h_toH₀ : toH₀ ⟨u, hu₀⟩ = x := Subtype.ext (u_bot.apply_symm_apply x.1)
      rw [h_toH₀]
      exact hx
    have h_red₀_ker : ∀ w : EllipticRootNumber.unitGroup F ⊥ 0,
        red₀ w = 1 ↔ w.1 ∈ EllipticRootNumber.unitGroup F ⊥ 1 := by
      intro w
      change π_red (toH₀ w) = 1 ↔ _
      rw [h_ker_iff (toH₀ w), h_unit1]
      rfl
    have h_unit1_le_0 : EllipticRootNumber.unitGroup F ⊥ 1 ≤ EllipticRootNumber.unitGroup F ⊥ 0 := by
      intro u hu₁
      rw [h_unit1] at hu₁
      rw [h_mem₀]
      have h_add : e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) =
          (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) + 1 := by ring
      have hu₁' : ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) <
          ValuativeRel.valuation F 1 := by rwa [Valuation.map_one]
      rw [h_add, Valuation.map_add_eq_of_lt_right _ hu₁', Valuation.map_one]

    let S₁ : Set ℕ := {a : ℕ | ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ a, χ'₁ u = 1}
    have hS₁_ne : S₁.Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro h_emp
      have h0 : sInf S₁ = 0 := by rw [h_emp, Nat.sInf_empty]
      change EllipticRootNumber.condExp F ⊥ χ'₁ = 0 at h0
      omega
    have h_triv₁ : ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 1, χ'₁ u = 1 := by
      have h1_mem : 1 ∈ S₁ := by
        rw [← h_cond₁]
        exact Nat.sInf_mem hS₁_ne
      exact h1_mem
    have h_nontriv₀ : ∃ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ'₁ u ≠ 1 := by
      by_contra h_all
      push_neg at h_all
      have h0_mem : 0 ∈ S₁ := h_all
      have h_le : sInf S₁ ≤ 0 := Nat.sInf_le h0_mem
      change EllipticRootNumber.condExp F ⊥ χ'₁ ≤ 0 at h_le
      omega
    let χ_res_fun (a : 𝓀[F]ˣ) : (EllipticRootNumber.Ω F)ˣ :=
      χ'₁ (Classical.choose (h_red₀_surj a)).1
    have h_χ_res_apply : ∀ w : EllipticRootNumber.unitGroup F ⊥ 0,
        χ_res_fun (red₀ w) = χ'₁ w.1 := by
      intro w
      set w' := Classical.choose (h_red₀_surj (red₀ w))
      have hw' : red₀ w' = red₀ w := Classical.choose_spec (h_red₀_surj (red₀ w))
      have h_ker_mul : w'.1 * (w.1)⁻¹ ∈ EllipticRootNumber.unitGroup F ⊥ 1 := by
        change ((w' * w⁻¹ : EllipticRootNumber.unitGroup F ⊥ 0) :
          (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) ∈ EllipticRootNumber.unitGroup F ⊥ 1
        rw [← h_red₀_ker (w' * w⁻¹), map_mul, map_inv, hw', mul_inv_cancel]
      have h1 := h_triv₁ (w'.1 * (w.1)⁻¹) h_ker_mul
      rw [map_mul, map_inv, mul_inv_eq_one] at h1
      exact h1
    let χ_res : 𝓀[F]ˣ →* (EllipticRootNumber.Ω F)ˣ :=
      { toFun := χ_res_fun
        map_one' := by
          have := h_χ_res_apply 1
          rwa [map_one, OneMemClass.coe_one, map_one] at this
        map_mul' := fun a b => by
          obtain ⟨w_a, rfl⟩ := h_red₀_surj a
          obtain ⟨w_b, rfl⟩ := h_red₀_surj b
          rw [← map_mul, h_χ_res_apply, h_χ_res_apply, h_χ_res_apply,
            Subgroup.coe_mul, map_mul] }
    have hχ_res_ne : χ_res ≠ 1 := by
      obtain ⟨u₀, hu₀, hne⟩ := h_nontriv₀
      intro h1
      apply hne
      have h_eval := congrArg (fun φ : 𝓀[F]ˣ →* (EllipticRootNumber.Ω F)ˣ => φ (red₀ ⟨u₀, hu₀⟩)) h1
      change χ_res_fun (red₀ ⟨u₀, hu₀⟩) = 1 at h_eval
      rwa [h_χ_res_apply ⟨u₀, hu₀⟩] at h_eval
    have hχ_res_neg1 : χ_res (-1) = χ'₁ (-1) := by
      have h_neg1_mem₀ : (-1 : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) ∈
          EllipticRootNumber.unitGroup F ⊥ 0 := by
        rw [h_mem₀, Units.val_neg, Units.val_one, map_neg, map_one, Valuation.map_neg, Valuation.map_one]
      let w_neg : EllipticRootNumber.unitGroup F ⊥ 0 := ⟨-1, h_neg1_mem₀⟩
      have h_red_neg : red₀ w_neg = -1 := by
        apply Units.ext
        have h_coe : ((π_red (toH₀ w_neg) : 𝓀[F]ˣ) : 𝓀[F]) =
            IsLocalRing.residue ↥A (A.unitGroupMulEquiv (toH₀ w_neg) : ↥A) :=
          ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A (toH₀ w_neg)
        have h_sub_neg : (A.unitGroupMulEquiv (toH₀ w_neg) : ↥A) = -1 := by
          ext
          rw [ValuationSubring.coe_unitGroupMulEquiv_apply A (toH₀ w_neg)]
          change (e_bot ((-1 : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) : F) = -1
          rw [Units.val_neg, Units.val_one, map_neg, map_one]
        change ((π_red (toH₀ w_neg) : 𝓀[F]ˣ) : 𝓀[F]) = ((-1 : 𝓀[F]ˣ) : 𝓀[F])
        rw [h_coe, h_sub_neg, map_neg, map_one, Units.val_neg, Units.val_one]
      rw [← h_red_neg]
      exact h_χ_res_apply w_neg

    let resA : ↥A →+* 𝓀[F] := IsLocalRing.residue ↥A
    have h_resA_surj : Function.Surjective resA := IsLocalRing.residue_surjective
    let ψ_tilde (r : ↥A) : EllipticRootNumber.Ω F :=
      ψ (((c⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) * e_bot.symm (r : F))
    have h_ψ_tilde_zero : ψ_tilde 0 = 1 := by
      dsimp [ψ_tilde]
      rw [map_zero, mul_zero, AddChar.map_zero_eq_one]
    have h_ψ_tilde_add : ∀ r₁ r₂ : ↥A, ψ_tilde (r₁ + r₂) = ψ_tilde r₁ * ψ_tilde r₂ := by
      intro r₁ r₂
      dsimp [ψ_tilde]
      rw [map_add, mul_add, AddChar.map_add_eq_mul]
    have h_ψ_tilde_max : ∀ r : ↥A, r ∈ IsLocalRing.maximalIdeal ↥A → ψ_tilde r = 1 := by
      intro r hr
      dsimp [ψ_tilde]
      have hlt : ValuativeRel.valuation F (r : F) < 1 :=
        (Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F)).mp hr
      have h_pos := (h_valL_pos (e_bot.symm (r : F))).mpr (by rwa [e_bot.apply_symm_apply])
      rcases h_pos with h0 | h1
      · rw [h0, mul_zero, AddChar.map_zero_eq_one]
      · have hy_ne : e_bot.symm (r : F) ≠ 0 := by
          intro h0
          rw [h0, h_valL, map_zero] at h1
          unfold EllipticRootNumber.addVal at h1
          rw [dif_pos rfl] at h1
          omega
        apply hψ_triv
        rw [h_valL_mul c⁻¹ (e_bot.symm (r : F)) hy_ne, h_valL_inv c, hc_val]
        omega
    let ψ_res_fun (b : 𝓀[F]) : EllipticRootNumber.Ω F :=
      ψ_tilde (Classical.choose (h_resA_surj b))
    have h_ψ_res_apply : ∀ r : ↥A, ψ_res_fun (resA r) = ψ_tilde r := by
      intro r
      set r' := Classical.choose (h_resA_surj (resA r))
      have hr' : resA r' = resA r := Classical.choose_spec (h_resA_surj (resA r))
      have h_max : r' - r ∈ IsLocalRing.maximalIdeal ↥A := by
        rw [← IsLocalRing.residue_eq_zero_iff]
        change resA (r' - r) = 0
        rw [map_sub, hr', sub_self]
      have h_eq : r' = (r' - r) + r := by ring
      change ψ_tilde r' = ψ_tilde r
      rw [h_eq, h_ψ_tilde_add, h_ψ_tilde_max (r' - r) h_max, one_mul]
    let ψ_res : AddChar 𝓀[F] (EllipticRootNumber.Ω F) :=
      { toFun := ψ_res_fun
        map_zero_eq_one' := by
          have := h_ψ_res_apply 0
          rwa [map_zero, h_ψ_tilde_zero] at this
        map_add_eq_mul' := fun b₁ b₂ => by
          obtain ⟨r₁, rfl⟩ := h_resA_surj b₁
          obtain ⟨r₂, rfl⟩ := h_resA_surj b₂
          rw [← map_add, h_ψ_res_apply, h_ψ_res_apply, h_ψ_res_apply, h_ψ_tilde_add] }
    have hψ_res_ne : ψ_res ≠ 1 := by
      let y₀ : (⊥ : IntermediateField F (AlgebraicClosure F)) :=
        (c : (⊥ : IntermediateField F (AlgebraicClosure F))) * x₀
      have hy₀_val : EllipticRootNumber.valL F ⊥ y₀ = 0 := by
        rw [h_valL_mul c x₀ hx₀_ne0, hc_val, hx₀_val]
        omega
      have hy₀_A : e_bot y₀ ∈ A := by
        rw [Valuation.mem_valuationSubring_iff, ← h_valL_nonneg, hy₀_val]
      let r₀ : ↥A := ⟨e_bot y₀, hy₀_A⟩
      intro h1
      apply hx₀_ne
      have h_eval := congrArg (fun φ : AddChar 𝓀[F] (EllipticRootNumber.Ω F) => φ (resA r₀)) h1
      change ψ_res_fun (resA r₀) = 1 at h_eval
      rw [h_ψ_res_apply r₀] at h_eval
      dsimp [ψ_tilde, r₀, y₀] at h_eval
      have h_cancel : ((c⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) *
          e_bot.symm (e_bot ((c : (⊥ : IntermediateField F (AlgebraicClosure F))) * x₀)) = x₀ := by
        rw [e_bot.symm_apply_apply, ← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
      rwa [h_cancel] at h_eval

    let U₀ : Set ((⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1) :=
      {u | EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0}
    let toRes (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1) : 𝓀[F]ˣ :=
      if h : EllipticRootNumber.cosetRep u ∈ EllipticRootNumber.unitGroup F ⊥ 0
      then red₀ ⟨EllipticRootNumber.cosetRep u, h⟩ else 1
    have h_bij : Set.BijOn toRes U₀ Set.univ := by
      refine ⟨Set.mapsTo_univ _ _, ?_, ?_⟩
      · intro u₁ hu₁ u₂ hu₂ h_eq
        have h₁ : EllipticRootNumber.cosetRep u₁ ∈ EllipticRootNumber.unitGroup F ⊥ 0 :=
          (h_unit0 _).mpr hu₁
        have h₂ : EllipticRootNumber.cosetRep u₂ ∈ EllipticRootNumber.unitGroup F ⊥ 0 :=
          (h_unit0 _).mpr hu₂
        dsimp [toRes] at h_eq
        rw [dif_pos h₁, dif_pos h₂] at h_eq
        have h_ker_inv : (EllipticRootNumber.cosetRep u₁)⁻¹ * EllipticRootNumber.cosetRep u₂ ∈
            EllipticRootNumber.unitGroup F ⊥ 1 := by
          change ((⟨EllipticRootNumber.cosetRep u₁, h₁⟩⁻¹ * ⟨EllipticRootNumber.cosetRep u₂, h₂⟩ :
            EllipticRootNumber.unitGroup F ⊥ 0) : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) ∈
            EllipticRootNumber.unitGroup F ⊥ 1
          rw [← h_red₀_ker (⟨EllipticRootNumber.cosetRep u₁, h₁⟩⁻¹ * ⟨EllipticRootNumber.cosetRep u₂, h₂⟩),
            map_mul, map_inv, h_eq, inv_mul_cancel]
        have h_mk_eq : (QuotientGroup.mk (EllipticRootNumber.cosetRep u₁) :
            (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1) =
            QuotientGroup.mk (EllipticRootNumber.cosetRep u₂) :=
          QuotientGroup.eq.mpr h_ker_inv
        unfold EllipticRootNumber.cosetRep at h_mk_eq
        rwa [QuotientGroup.out_eq', QuotientGroup.out_eq'] at h_mk_eq
      · intro a _
        obtain ⟨w, rfl⟩ := h_red₀_surj a
        let u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1 :=
          QuotientGroup.mk w.1
        have h_rel : (EllipticRootNumber.cosetRep u)⁻¹ * w.1 ∈ EllipticRootNumber.unitGroup F ⊥ 1 := by
          apply QuotientGroup.eq.mp
          unfold EllipticRootNumber.cosetRep
          exact QuotientGroup.out_eq' u
        have h_rel₀ : (EllipticRootNumber.cosetRep u)⁻¹ * w.1 ∈ EllipticRootNumber.unitGroup F ⊥ 0 :=
          h_unit1_le_0 h_rel
        have hu_mem₀ : EllipticRootNumber.cosetRep u ∈ EllipticRootNumber.unitGroup F ⊥ 0 := by
          have h_prod_w : EllipticRootNumber.cosetRep u =
              w.1 * ((EllipticRootNumber.cosetRep u)⁻¹ * w.1)⁻¹ := by group
          rw [h_prod_w]
          exact Subgroup.mul_mem _ w.2 (Subgroup.inv_mem _ h_rel₀)
        have hu_U₀ : u ∈ U₀ := (h_unit0 _).mp hu_mem₀
        refine ⟨u, hu_U₀, ?_⟩
        dsimp [toRes]
        rw [dif_pos hu_mem₀]
        have h_red_one : red₀ (⟨EllipticRootNumber.cosetRep u, hu_mem₀⟩⁻¹ * w) = 1 :=
          (h_red₀_ker _).mpr h_rel
        rw [map_mul, map_inv, inv_mul_eq_one] at h_red_one
        exact h_red_one
    have h_psi_term : ∀ u ∈ U₀,
        ψ (((c⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F)))) = ψ_res (toRes u : 𝓀[F]) := by
      intro u hu
      have hu₀ : EllipticRootNumber.cosetRep u ∈ EllipticRootNumber.unitGroup F ⊥ 0 :=
        (h_unit0 _).mpr hu
      dsimp [toRes]
      rw [dif_pos hu₀]
      let w : EllipticRootNumber.unitGroup F ⊥ 0 := ⟨EllipticRootNumber.cosetRep u, hu₀⟩
      have h_coe_red : ((red₀ w : 𝓀[F]ˣ) : 𝓀[F]) = resA (A.unitGroupMulEquiv (toH₀ w) : ↥A) :=
        ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A (toH₀ w)
      rw [h_coe_red]
      change _ = ψ_res_fun (resA (A.unitGroupMulEquiv (toH₀ w) : ↥A))
      rw [h_ψ_res_apply]
      dsimp [ψ_tilde]
      change ψ (((c⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) *
          ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F)))) =
        ψ (((c⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) *
          e_bot.symm (e_bot ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F)))))
      rw [e_bot.symm_apply_apply]
    have h_chi_term : ∀ u ∈ U₀,
        χ'₁ (EllipticRootNumber.cosetRep u) = χ_res (toRes u) := by
      intro u hu
      have hu₀ : EllipticRootNumber.cosetRep u ∈ EllipticRootNumber.unitGroup F ⊥ 0 :=
        (h_unit0 _).mpr hu
      dsimp [toRes]
      rw [dif_pos hu₀]
      exact (h_χ_res_apply ⟨EllipticRootNumber.cosetRep u, hu₀⟩).symm
    have hS₁_eq :
        (∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
          (_ : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0),
          ((χ'₁ (EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F)⁻¹ *
            ψ (((c⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F)))))) =
        ∑ᶠ (a : 𝓀[F]ˣ), ((χ_res a : EllipticRootNumber.Ω F)⁻¹ * ψ_res (a : 𝓀[F])) := by
      change (∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
          (_ : u ∈ U₀), _) = _
      rw [finsum_mem_eq_of_bijOn (g := fun a : 𝓀[F]ˣ => ((χ_res a : EllipticRootNumber.Ω F)⁻¹ * ψ_res (a : 𝓀[F])))
        toRes h_bij (fun u hu => by rw [h_chi_term u hu, h_psi_term u hu]),
        finsum_mem_univ]
    have hS₂_eq :
        (∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
          (_ : EllipticRootNumber.valL F ⊥ ((EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0),
          ((χ'₁ (EllipticRootNumber.cosetRep u) : EllipticRootNumber.Ω F) *
            ψ (((c⁻¹ * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) : (⊥ : IntermediateField F (AlgebraicClosure F)))))) =
        ∑ᶠ (a : 𝓀[F]ˣ), ((χ_res a : EllipticRootNumber.Ω F) * ψ_res (a : 𝓀[F])) := by
      change (∑ᶠ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸ EllipticRootNumber.unitGroup F ⊥ 1)
          (_ : u ∈ U₀), _) = _
      rw [finsum_mem_eq_of_bijOn (g := fun a : 𝓀[F]ˣ => ((χ_res a : EllipticRootNumber.Ω F) * ψ_res (a : 𝓀[F])))
        toRes h_bij (fun u hu => by rw [h_chi_term u hu, h_psi_term u hu]),
        finsum_mem_univ]

    
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    letI : Fintype 𝓀[F]ˣ := Fintype.ofFinite 𝓀[F]ˣ
    let χ_mul : MulChar 𝓀[F] (EllipticRootNumber.Ω F) := MulChar.ofUnitHom χ_res
    have hχ_mul : χ_mul ≠ 1 := by
      intro h1
      apply hχ_res_ne
      ext a
      have h_eval := congrArg (fun φ : MulChar 𝓀[F] (EllipticRootNumber.Ω F) => φ (a : 𝓀[F])) h1
      simpa [χ_mul, MulChar.ofUnitHom_coe] using h_eval
    have h_sum_units : ∀ φ : MulChar 𝓀[F] (EllipticRootNumber.Ω F),
        (∑ a : 𝓀[F]ˣ, φ (a : 𝓀[F]) * ψ_res (a : 𝓀[F])) = gaussSum φ ψ_res := by
      intro φ
      unfold gaussSum
      rw [← Finset.sum_subset (Finset.subset_univ (Finset.univ.image (Units.val : 𝓀[F]ˣ → 𝓀[F])))]
      · rw [Finset.sum_image (fun a _ b _ hab => Units.ext hab)]
      · intro x _ hx
        have hx0 : x = 0 := by
          by_contra hne
          exact hx (Finset.mem_image.mpr ⟨Units.mk0 x hne, Finset.mem_univ _, rfl⟩)
        rw [hx0, MulChar.map_zero, zero_mul]
    have h_gs1 : (∑ᶠ (a : 𝓀[F]ˣ), ((χ_res a : EllipticRootNumber.Ω F)⁻¹ * ψ_res (a : 𝓀[F]))) =
        gaussSum χ_mul⁻¹ ψ_res := by
      rw [finsum_eq_sum_of_fintype, ← h_sum_units χ_mul⁻¹]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [MulChar.inv_apply_eq_inv', MulChar.ofUnitHom_coe]
    have h_gs2 : (∑ᶠ (a : 𝓀[F]ˣ), ((χ_res a : EllipticRootNumber.Ω F) * ψ_res (a : 𝓀[F]))) =
        gaussSum χ_mul ψ_res := by
      rw [finsum_eq_sum_of_fintype, ← h_sum_units χ_mul]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [MulChar.ofUnitHom_coe]
    have hψ_prim : ψ_res.IsPrimitive := AddChar.IsPrimitive.of_ne_one hψ_res_ne
    have h_card := gaussSum_mul_gaussSum_eq_card (inv_ne_one.mpr hχ_mul) hψ_prim
    rw [inv_inv] at h_card
    have h_shift : ψ_res.mulShift ((-1 : 𝓀[F]ˣ) : 𝓀[F]) = ψ_res⁻¹ := by
      ext x
      rw [AddChar.mulShift_apply, Units.val_neg, Units.val_one, neg_one_mul, AddChar.inv_apply]
    have h_gs_shift := gaussSum_mulShift χ_mul ψ_res (-1 : 𝓀[F]ˣ)
    rw [h_shift, MulChar.ofUnitHom_coe] at h_gs_shift
    have h_q_eq : (Fintype.card 𝓀[F] : EllipticRootNumber.Ω F) =
        (EllipticRootNumber.q F : EllipticRootNumber.Ω F) := by
      unfold EllipticRootNumber.q
      rw [Nat.card_eq_fintype_card]
    have hq_ne : (EllipticRootNumber.q F : EllipticRootNumber.Ω F) ≠ 0 :=
      Nat.cast_ne_zero.mpr (EllipticRootNumber.q_pos F).ne'
    rw [h_eps₁, h_eps₂, hS₁_eq, hS₂_eq, h_gs1, h_gs2]
    calc ((χ'₁ c : EllipticRootNumber.Ω F) * gaussSum χ_mul⁻¹ ψ_res) *
          ((χ'₂ c : EllipticRootNumber.Ω F) * gaussSum χ_mul ψ_res)
      _ = ((χ'₁ c : EllipticRootNumber.Ω F) * (χ'₂ c : EllipticRootNumber.Ω F)) *
            (gaussSum χ_mul⁻¹ ψ_res * gaussSum χ_mul ψ_res) := by ring
      _ = (EllipticRootNumber.q F : EllipticRootNumber.Ω F)⁻¹ *
            (gaussSum χ_mul⁻¹ ψ_res * ((χ_res (-1) : EllipticRootNumber.Ω F) * gaussSum χ_mul ψ_res⁻¹)) := by
          rw [hc_prod, ← h_gs_shift]
      _ = (χ_res (-1) : EllipticRootNumber.Ω F) *
            ((EllipticRootNumber.q F : EllipticRootNumber.Ω F)⁻¹ *
              (gaussSum χ_mul⁻¹ ψ_res * gaussSum χ_mul ψ_res⁻¹)) := by ring
      _ = (χ'₁ (-1) : EllipticRootNumber.Ω F) *
            ((EllipticRootNumber.q F : EllipticRootNumber.Ω F)⁻¹ *
              (EllipticRootNumber.q F : EllipticRootNumber.Ω F)) := by
          rw [hχ_res_neg1, h_card, h_q_eq]
      _ = (χ'₁ (-1) : EllipticRootNumber.Ω F) := by
          rw [inv_mul_cancel₀ hq_ne, mul_one]
  )

theorem tame_unit_char_eval_neg_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1))
    (χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ)
    (h_cond : EllipticRootNumber.condExp F ⊥ χ' = 1)
    (h_pow : ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ' u ^ (12 / Nat.gcd n 12) = 1)
    (h_ord : ∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 →
      ∃ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ' u ^ d ≠ 1) :
    (χ' (-1) : EllipticRootNumber.Ω F) =
      (((-1 : ℤˣ) ^ ((EllipticRootNumber.q F - 1) / (12 / Nat.gcd n 12)) : ℤ) : EllipticRootNumber.Ω F) :=
by
  open ValuativeRel in
  (
    let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
    let u_bot : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ≃* Fˣ :=
      Units.mapEquiv e_bot.toMulEquiv
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
        z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
      rintro _ hz m rfl
      exact WithZero.unzero_coe hz
    obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      rw [hπ_val, iso.apply_symm_apply]
    have hπ0 : π ≠ 0 := by
      intro h0
      have : iso (ValuativeRel.valuation F π) = 0 := by rw [h0, map_zero, map_zero]
      rw [hπ_iso] at this
      exact WithZero.exp_ne_zero this
    have hπ_addVal : EllipticRootNumber.addVal F π = 1 := by
      unfold EllipticRootNumber.addVal
      rw [dif_neg hπ0, h_unzero _ _ (-1) hπ_iso]
      rfl
    have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.relVal
      have h_norm : Algebra.norm F x = e_bot x := by
        rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
        rfl
      rw [h_norm]
    have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
      unfold EllipticRootNumber.resDeg
      apply IsLeast.csInf_eq
      refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
      · intro h0
        apply hπ0
        have := congrArg e_bot h0
        simpa using this
      · rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
        omega
      · rintro k ⟨hk, _⟩
        exact hk
    have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.valL
      rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
    have h_addVal_zero : ∀ y : F, y ≠ 0 →
        (EllipticRootNumber.addVal F y = 0 ↔ ValuativeRel.valuation F y = 1) := by
      intro y hy
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      have h_val_one : ValuativeRel.valuation F y = 1 ↔ Multiplicative.toAdd z = 0 := by
        rw [← EmbeddingLike.apply_eq_iff_eq iso, hz_eq, map_one, ← WithZero.exp_zero,
          WithZero.exp_injective.eq_iff]
      rw [h_val_one]
      omega
    have h_addVal_pos : ∀ y : F, y ≠ 0 →
        ((1 : ℤ) ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y < 1) := by
      intro y hy
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_lt_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
      omega
    let A := (ValuativeRel.valuation F).valuationSubring
    let H₀ : Subgroup (⊥ : IntermediateField F (AlgebraicClosure F))ˣ :=
      A.unitGroup.comap u_bot.toMonoidHom
    have h_H₀_mem : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        u ∈ H₀ ↔ ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 := by
      intro u
      change u_bot u ∈ A.unitGroup ↔ _
      rw [Valuation.mem_unitGroup_iff]
      rfl
    have h_set_eq : {u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ |
        if (0 : ℕ) = 0 then EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
        else ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∨
          ((0 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F ⊥ ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1))} =
        (H₀ : Set (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) := by
      ext u
      rw [Set.mem_setOf_eq, SetLike.mem_coe, if_pos rfl, h_H₀_mem, h_valL]
      exact h_addVal_zero (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))))
        ((map_ne_zero e_bot).mpr (Units.ne_zero u))
    have h_mem₀ : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        u ∈ EllipticRootNumber.unitGroup F ⊥ 0 ↔
          ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 := by
      intro u
      unfold EllipticRootNumber.unitGroup
      rw [h_set_eq, Subgroup.closure_eq]
      exact h_H₀_mem u
    have h_mem₁ : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) < 1 →
          u ∈ EllipticRootNumber.unitGroup F ⊥ 1 := by
      intro u hlt
      unfold EllipticRootNumber.unitGroup
      apply Subgroup.subset_closure
      rw [Set.mem_setOf_eq, if_neg Nat.one_ne_zero]
      by_cases hu1 : (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1
      · exact Or.inl hu1
      · right
        rw [Nat.cast_one, h_valL]
        have hy_eq : e_bot ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) =
            e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1 := by
          rw [map_sub, map_one]
        have hy_ne : e_bot ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) ≠ 0 :=
          (map_ne_zero e_bot).mpr (sub_ne_zero.mpr hu1)
        rw [h_addVal_pos _ hy_ne, hy_eq]
        exact hlt
    let π_red : ↥A.unitGroup →* 𝓀[F]ˣ := A.unitGroupToResidueFieldUnits
    have h_ker : ∀ x : ↥A.unitGroup, π_red x = 1 →
        ValuativeRel.valuation F (((x : Fˣ) : F) - 1) < 1 := by
      intro x hx
      have h_val : ((π_red x : 𝓀[F]ˣ) : 𝓀[F]) = 1 := by rw [hx, Units.val_one]
      have h_coe : ((π_red x : 𝓀[F]ˣ) : 𝓀[F]) =
          IsLocalRing.residue ↥A (A.unitGroupMulEquiv x : ↥A) :=
        ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A x
      rw [h_coe] at h_val
      have h_res : IsLocalRing.residue ↥A ((A.unitGroupMulEquiv x : ↥A) - 1) = 0 := by
        rw [map_sub, map_one, h_val, sub_self]
      rw [IsLocalRing.residue_eq_zero_iff] at h_res
      have h_max := (Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F)).mp h_res
      have h_sub : ((((A.unitGroupMulEquiv x : ↥A) - 1 : ↥A) : F)) = ((x : Fˣ) : F) - 1 := by
        change ((A.unitGroupMulEquiv x : ↥A) : F) - 1 = ((x : Fˣ) : F) - 1
        rw [ValuationSubring.coe_unitGroupMulEquiv_apply A x]
      rwa [h_sub] at h_max
    obtain ⟨g, hg⟩ := IsCyclic.exists_monoid_generator (α := 𝓀[F]ˣ)
    have h_ord_g : orderOf g = EllipticRootNumber.q F - 1 := by
      rw [orderOf_eq_card_of_forall_mem_powers hg, Nat.card_units]
      rfl
    obtain ⟨x_g, hx_g⟩ := ValuationSubring.surjective_unitGroupToResidueFieldUnits A g
    change π_red x_g = g at hx_g
    let v_g : Fˣ := (x_g : Fˣ)
    have hv_g_val : ValuativeRel.valuation F (v_g : F) = 1 :=
      (Valuation.mem_unitGroup_iff F (ValuativeRel.valuation F) v_g).mp x_g.2
    have hv_g_gen : ∀ v : Fˣ, ValuativeRel.valuation F (v : F) = 1 →
        ∃ k : ℕ, ValuativeRel.valuation F (((v * (v_g ^ k)⁻¹ : Fˣ) : F) - 1) < 1 := by
      intro v hv
      let x : ↥A.unitGroup := ⟨v, (Valuation.mem_unitGroup_iff F (ValuativeRel.valuation F) v).mpr hv⟩
      obtain ⟨k, hk⟩ := hg (π_red x)
      change g ^ k = π_red x at hk
      refine ⟨k, ?_⟩
      have h_eq1 : π_red (x * (x_g ^ k)⁻¹) = 1 := by
        rw [map_mul, map_inv, map_pow, hx_g, ← hk, mul_inv_cancel]
      exact h_ker (x * (x_g ^ k)⁻¹) h_eq1
    have hv_g_neg : ValuativeRel.valuation F
        ((((-1 : Fˣ) * (v_g ^ ((EllipticRootNumber.q F - 1) / 2))⁻¹ : Fˣ) : F) - 1) < 1 := by
      have hq_gt1 : 1 < EllipticRootNumber.q F := by
        unfold EllipticRootNumber.q
        exact Finite.one_lt_card
      set m₀ := (EllipticRootNumber.q F - 1) / 2
      have hm₀_ne : m₀ ≠ 0 := by omega
      have hm₀_lt : m₀ < orderOf g := by rw [h_ord_g]; omega
      have hm₀_mul : m₀ * 2 = orderOf g := by rw [h_ord_g]; omega
      have hg_m₀_sq : (g ^ m₀) ^ 2 = 1 := by
        rw [← pow_mul, hm₀_mul, pow_orderOf_eq_one]
      have hg_m₀_ne : g ^ m₀ ≠ 1 := pow_ne_one_of_lt_orderOf hm₀_ne hm₀_lt
      have hg_m₀ : g ^ m₀ = -1 := by
        have h_sq_val : ((g ^ m₀ : 𝓀[F]ˣ) : 𝓀[F]) ^ 2 = 1 := by
          rw [← Units.val_pow_eq_pow_val, hg_m₀_sq, Units.val_one]
        rcases sq_eq_one_iff.mp h_sq_val with h1 | h_neg1
        · exfalso
          apply hg_m₀_ne
          exact Units.ext h1
        · exact Units.ext h_neg1
      have h_neg_mem : (-1 : Fˣ) ∈ A.unitGroup := by
        rw [Valuation.mem_unitGroup_iff, Units.val_neg, Units.val_one, Valuation.map_neg, Valuation.map_one]
      let x_neg : ↥A.unitGroup := ⟨-1, h_neg_mem⟩
      have hx_neg_red : π_red x_neg = -1 := by
        apply Units.ext
        have h_coe : ((π_red x_neg : 𝓀[F]ˣ) : 𝓀[F]) =
            IsLocalRing.residue ↥A (A.unitGroupMulEquiv x_neg : ↥A) :=
          ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A x_neg
        have h_sub_neg : (A.unitGroupMulEquiv x_neg : ↥A) = -1 := by
          ext
          rw [ValuationSubring.coe_unitGroupMulEquiv_apply A x_neg]
          rfl
        rw [h_coe, h_sub_neg, map_neg, map_one, Units.val_neg, Units.val_one]
      have h_eq1 : π_red (x_neg * (x_g ^ m₀)⁻¹) = 1 := by
        rw [map_mul, map_inv, map_pow, hx_g, hg_m₀, hx_neg_red, mul_inv_cancel]
      exact h_ker (x_neg * (x_g ^ m₀)⁻¹) h_eq1
    let S : Set ℕ := {a : ℕ | ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ a, χ' u = 1}
    have hS_ne : S.Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro h_emp
      have h0 : sInf S = 0 := by rw [h_emp, Nat.sInf_empty]
      change EllipticRootNumber.condExp F ⊥ χ' = 0 at h0
      omega
    have h1_mem : 1 ∈ S := by
      rw [← h_cond]
      exact Nat.sInf_mem hS_ne
    have h_triv₁ : ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 1, χ' u = 1 := h1_mem
    let u_g : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := u_bot.symm v_g
    have hu_g_coe : e_bot (u_g : (⊥ : IntermediateField F (AlgebraicClosure F))) = (v_g : F) := by
      change ((u_bot (u_bot.symm v_g) : Fˣ) : F) = (v_g : F)
      rw [u_bot.apply_symm_apply]
    have hu_g : u_g ∈ EllipticRootNumber.unitGroup F ⊥ 0 := by
      rw [h_mem₀, hu_g_coe]
      exact hv_g_val
    let ζ : (EllipticRootNumber.Ω F)ˣ := χ' u_g
    have h_char_pow : ∀ (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) (k : ℕ),
        ValuativeRel.valuation F (((u_bot u * (v_g ^ k)⁻¹ : Fˣ) : F) - 1) < 1 →
        χ' u = ζ ^ k := by
      intro u k hlt
      have h_coe_eq : e_bot (((u * (u_g ^ k)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F)))) =
          ((u_bot u * (v_g ^ k)⁻¹ : Fˣ) : F) := by
        change ((u_bot (u * (u_g ^ k)⁻¹) : Fˣ) : F) = _
        rw [map_mul, map_inv, map_pow, u_bot.apply_symm_apply]
      have hu_mem₁ : u * (u_g ^ k)⁻¹ ∈ EllipticRootNumber.unitGroup F ⊥ 1 := by
        apply h_mem₁
        rwa [h_coe_eq]
      have h_one := h_triv₁ (u * (u_g ^ k)⁻¹) hu_mem₁
      rw [map_mul, map_inv, map_pow, mul_inv_eq_one] at h_one
      exact h_one
    have h_neg_one : χ' (-1) = ζ ^ ((EllipticRootNumber.q F - 1) / 2) := by
      apply h_char_pow (-1) ((EllipticRootNumber.q F - 1) / 2)
      have h_ubot_neg : u_bot (-1) = -1 := by
        ext
        change e_bot ((-1 : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) = (-1 : F)
        rw [Units.val_neg, Units.val_one, map_neg, map_one]
      rwa [h_ubot_neg]
    have hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1 := h_pow u_g hu_g
    have hζ_ord : ∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 → ζ ^ d ≠ 1 := by
      intro d hd hlt h_eq1
      obtain ⟨u, hu₀, hu_ne⟩ := h_ord d hd hlt
      have huv : ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 :=
        (h_mem₀ u).mp hu₀
      obtain ⟨k, hk⟩ := hv_g_gen (u_bot u) huv
      have hχu : χ' u = ζ ^ k := h_char_pow u k hk
      apply hu_ne
      rw [hχu, ← pow_mul, mul_comm, pow_mul, h_eq1, one_pow]
    rw [h_neg_one]
    generalize EllipticRootNumber.q F = q' at hq2 hab ⊢
    have h_rhs : ∀ k : ℕ,
        (((-1 : ℤˣ) ^ k : ℤ) : EllipticRootNumber.Ω F) = (-1 : EllipticRootNumber.Ω F) ^ k := by
      intro k
      rw [Units.val_neg, Units.val_one, Int.cast_pow, Int.cast_neg, Int.cast_one]
    rw [h_rhs]
    have h_even_case : ∀ (m k : ℕ), ζ ^ (m * 2) = 1 → ζ ^ m ≠ 1 → (q' - 1) / 2 = m * k →
        ((ζ ^ ((q' - 1) / 2) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) =
          (-1 : EllipticRootNumber.Ω F) ^ k := by
      intro m k hm_sq hm_ne hq_eq
      have h_sq : ((ζ ^ m : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) ^ 2 = 1 := by
        rw [← Units.val_pow_eq_pow_val, ← pow_mul, hm_sq, Units.val_one]
      have h_val_neg : ((ζ ^ m : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) = -1 := by
        rcases sq_eq_one_iff.mp h_sq with h1 | h_neg1
        · exfalso
          apply hm_ne
          exact Units.ext h1
        · exact h_neg1
      rw [hq_eq, pow_mul, Units.val_pow_eq_pow_val, h_val_neg]
    have h_odd_case : ζ ^ 3 = 1 → 3 ∣ (q' - 1) →
        ((ζ ^ ((q' - 1) / 2) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) =
          (-1 : EllipticRootNumber.Ω F) ^ ((q' - 1) / 3) := by
      intro h3 hdvd3
      set r := (q' - 1) / 6
      have hq2_eq : (q' - 1) / 2 = 3 * r := by omega
      have hq3_eq : (q' - 1) / 3 = 2 * r := by omega
      rw [hq2_eq, pow_mul, h3, one_pow, Units.val_one, hq3_eq, pow_mul, neg_one_sq, one_pow]
    interval_cases n
    · omega
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab hζ_pow hζ_ord ⊢
      exact h_even_case 3 ((q' - 1) / 6) hζ_pow (hζ_ord 3 (by decide) (by decide)) (by omega)
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab hζ_pow hζ_ord ⊢
      exact h_even_case 2 ((q' - 1) / 4) hζ_pow (hζ_ord 2 (by decide) (by decide)) (by omega)
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab hζ_pow hζ_ord ⊢
      exact h_odd_case hζ_pow hab
    · omega
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab hζ_pow hζ_ord ⊢
      exact h_even_case 1 ((q' - 1) / 2) hζ_pow (hζ_ord 1 (by decide) (by decide)) (by omega)
    · omega
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab hζ_pow hζ_ord ⊢
      exact h_odd_case hζ_pow hab
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab hζ_pow hζ_ord ⊢
      exact h_even_case 2 ((q' - 1) / 4) hζ_pow (hζ_ord 2 (by decide) (by decide)) (by omega)
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab hζ_pow hζ_ord ⊢
      exact h_even_case 3 ((q' - 1) / 6) hζ_pow (hζ_ord 3 (by decide) (by decide)) (by omega)
    · omega
  )

theorem localEps_potentially_good_abelian (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1))
    (rec : EllipticRootNumber.LocalReciprocity F)
    (lc : EllipticRootNumber.LocalConstants F rec) :
    EllipticRootNumber.localEps F E lc =
      (((-1 : ℤˣ) ^ ((EllipticRootNumber.q F - 1) / (12 / Nat.gcd n 12)) : ℤ) : EllipticRootNumber.Ω F) :=
by
  unfold EllipticRootNumber.localEps EllipticRootNumber.epsWD
  have h_wd : EllipticRootNumber.wdRep F E =
      { V := EllipticRootNumber.VBar F E
        ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
        N := 0 } := if_pos hj
  rw [h_wd]
  have h_frob : EllipticRootNumber.frobDet F ⊥
      { V := EllipticRootNumber.VBar F E
        ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
        N := 0 } = 1 := by
    unfold EllipticRootNumber.frobDet
    dsimp only
    split_ifs with hI hK
    · have h_sub : Subsingleton
          (EllipticRootNumber.inertiaInvariants F ⊥
            { V := EllipticRootNumber.VBar F E
              ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
              N := 0 } ⧸
            (LinearMap.ker (0 : EllipticRootNumber.VBar F E →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E)).comap
              (EllipticRootNumber.inertiaInvariants F ⊥
                { V := EllipticRootNumber.VBar F E
                  ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
                  N := 0 }).subtype) := by
        rw [Submodule.Quotient.subsingleton_iff, LinearMap.ker_zero, Submodule.comap_top]
      exact LinearMap.det_eq_one_of_subsingleton _
    · rfl
    · rfl
  rw [h_frob, mul_one]
  change (lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
      (EllipticRootNumber.stdChar F) : EllipticRootNumber.Ω F) = _
  obtain ⟨hψ_adm, hψ_cond, hψ_triv, hψ_nontriv⟩ := stdChar_admissible_and_spec F
  obtain ⟨χ₁, χ₂, χ'₁, χ'₂, f, g, hW₁, hW, hW₂, hf_eq, hg_eq, hf_inj, hg_surj, hfg_exact,
    hχ'₁_rec, hχ'₂_rec, h_prod, h_cond₁, h_cond₂, h_pow, h_ord⟩ :=
    ellAdicRep_abelian_short_exact_tame F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hn23 hΔ hc₄ hj hq2 hq3 hab rec
  have h_exact := lc.eps_exact ⊥ (EllipticRootNumber.stdChar F) hψ_adm
    (EllipticRootNumber.charRep F ⊥ χ₁)
    ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
    (EllipticRootNumber.charRep F ⊥ χ₂)
    hW₁ hW hW₂ f g hf_eq hg_eq hf_inj hg_surj hfg_exact
  have h_exact_val :
      (lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
        (EllipticRootNumber.stdChar F) : EllipticRootNumber.Ω F) =
      (lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ χ₁) (EllipticRootNumber.stdChar F) : EllipticRootNumber.Ω F) *
        (lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ χ₂) (EllipticRootNumber.stdChar F) : EllipticRootNumber.Ω F) := by
    rw [h_exact, Units.val_mul]
  rw [h_exact_val,
    lc.eps_char ⊥ (EllipticRootNumber.stdChar F) hψ_adm χ₁ hW₁ χ'₁ hχ'₁_rec,
    lc.eps_char ⊥ (EllipticRootNumber.stdChar F) hψ_adm χ₂ hW₂ χ'₂ hχ'₂_rec,
    tateEps_mul_complementary_tame F (EllipticRootNumber.stdChar F) hψ_cond hψ_triv hψ_nontriv
      χ'₁ χ'₂ h_cond₁ h_cond₂ h_prod,
    tame_unit_char_eval_neg_one F n hn0 hn12 hn23 hq2 hq3 hab χ'₁ h_cond₁ h_pow h_ord]

theorem exists_teichmuller_nonsquare_unit_and_uniformizer (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F)) :
    (2 : F) ≠ 0 ∧
    ∃ (π d_F : F),
      π ≠ 0 ∧
      EllipticRootNumber.addVal F π = 1 ∧
      d_F ≠ 0 ∧
      ValuativeRel.valuation F d_F = 1 ∧
      d_F ^ ((EllipticRootNumber.q F - 1) / 2) = -1 ∧
      (∀ y : F, ValuativeRel.valuation F y ≤ 1 → ValuativeRel.valuation F (d_F - y ^ 2) = 1) ∧
      (∀ x : F, x ^ 2 ≠ d_F) :=
by
  classical
  
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ, OrderMonoidIso.apply_symm_apply]
  have hπ_ne : π ≠ 0 := by
    rintro rfl
    rw [Valuation.map_zero, map_zero] at hπ_iso
    exact WithZero.exp_ne_zero hπ_iso.symm
  have hπ_lt1 : ValuativeRel.valuation F π < 1 := by
    rw [← map_lt_map_iff iso, hπ_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have hπ_val : EllipticRootNumber.addVal F π = 1 := by
    unfold EllipticRootNumber.addVal
    rw [dif_neg hπ_ne]
    have h_unzero : WithZero.unzero (x := iso (ValuativeRel.valuation F π))
        (by rw [hπ_iso]; exact WithZero.exp_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      simp only [hπ_iso, WithZero.exp, WithZero.unzero_coe]
    rw [h_unzero, toAdd_ofAdd]
    norm_num

  let A := (ValuativeRel.valuation F).valuationSubring
  let I := IsLocalRing.maximalIdeal ↥A
  let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
  have hp_info : (EllipticRootNumber.p F).Prime ∧ EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
    letI : Fintype kF := Fintype.ofFinite kF
    obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
    refine ⟨hp_prime, ?_⟩
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hcard_eq]
    exact dvd_pow_self (ringChar kF) k_card.ne_zero
  obtain ⟨hp_prime, hp_dvd_q⟩ := hp_info
  have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
    rintro h; rw [h] at hp_dvd_q; exact hq2 hp_dvd_q
  have h_ndvd2 : ¬ (EllipticRootNumber.p F ∣ 2) := by
    intro hdvd
    rw [Nat.dvd_prime Nat.prime_two] at hdvd
    rcases hdvd with h1 | h2
    · exact hp_prime.ne_one h1
    · exact hp_ne2 h2
  have h2_kF : (2 : kF) ≠ 0 := by
    haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
    exact (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) 2).not.mpr h_ndvd2
  have h2_ne : (2 : F) ≠ 0 := by
    intro h20
    have h2A : (2 : ↥A) = 0 := Subtype.ext h20
    have h2_res : IsLocalRing.residue ↥A (2 : ↥A) = 0 := by rw [h2A, map_zero]
    rw [map_ofNat] at h2_res
    exact h2_kF h2_res

  have hq_gt1 : 1 < EllipticRootNumber.q F := Finite.one_lt_card
  set e := EllipticRootNumber.q F - 1
  have he_pos : 0 < e := by omega
  have he_ndvd : ¬ (EllipticRootNumber.p F ∣ e) := by
    intro hdvd_e
    have hq_eq : e + 1 = EllipticRootNumber.q F := Nat.sub_add_cancel (by omega)
    have hdvd1 : EllipticRootNumber.p F ∣ 1 := by
      rw [← hq_eq] at hp_dvd_q
      exact (Nat.dvd_add_right hdvd_e).mp hp_dvd_q
    exact hp_prime.ne_one (Nat.dvd_one.mp hdvd1)

  
  have h_hensel : ∀ a : F,
      ValuativeRel.valuation F a = 1 →
      ValuativeRel.valuation F (a ^ e - 1) < 1 →
      ∃ d_F : F, d_F ^ e = 1 ∧ ValuativeRel.valuation F (d_F - a) < 1 := by
    let π₀ : ↥A := ⟨π, le_of_lt hπ_lt1⟩
    have h_lt1_iff_le_π : ∀ y : F,
        ValuativeRel.valuation F y < 1 ↔
          ValuativeRel.valuation F y ≤ ValuativeRel.valuation F π := by
      intro y
      rw [← map_lt_map_iff iso, ← map_le_map_iff iso, hπ_iso, map_one]
      rcases hy : iso (ValuativeRel.valuation F y) with _ | m
      · change (0 : WithZero (Multiplicative ℤ)) < 1 ↔
          (0 : WithZero (Multiplicative ℤ)) ≤ WithZero.exp (-1 : ℤ)
        exact ⟨fun _ => zero_le', fun _ => WithZero.zero_lt_coe _⟩
      · change WithZero.exp (Multiplicative.toAdd m) < WithZero.exp (0 : ℤ) ↔
          WithZero.exp (Multiplicative.toAdd m) ≤ WithZero.exp (-1 : ℤ)
        rw [WithZero.exp_lt_exp, WithZero.exp_le_exp]
        omega
    have hI_span : I = Ideal.span {π₀} := by
      ext x
      rw [Valuation.mem_maximalIdeal_iff, Ideal.mem_span_singleton,
        Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F))]
      exact h_lt1_iff_le_π (x : F)
    have hIm_mem : ∀ (m : ℕ) (x : ↥A),
        x ∈ I ^ m ↔ ValuativeRel.valuation F (x : F) ≤ (ValuativeRel.valuation F π) ^ m := by
      intro m x
      rw [hI_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
        Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F)),
        map_pow, map_pow]
      rfl
    have h_pre : IsPrecomplete I ↥A := by
      refine IsPrecomplete.mk fun f hf => ?_
      let T : ℕ → Set ↥A := fun m => {x : ↥A | f m ≡ x [SMOD I ^ m • (⊤ : Submodule ↥A ↥A)]}
      have hT_anti : ∀ m : ℕ, T (m + 1) ⊆ T m := by
        intro m x hx
        have h_le : I ^ (m + 1) • (⊤ : Submodule ↥A ↥A) ≤ I ^ m • (⊤ : Submodule ↥A ↥A) := by
          rw [smul_eq_mul, Ideal.mul_top, smul_eq_mul, Ideal.mul_top]
          exact Ideal.pow_le_pow_right (Nat.le_succ m)
        exact (hf (Nat.le_succ m)).trans (hx.mono h_le)
      have hT_nonempty : ∀ m : ℕ, (T m).Nonempty := fun m => ⟨f m, SModEq.refl (f m)⟩
      have hT_closed : ∀ m : ℕ, IsClosed (T m) := by
        intro m
        have h_eq : T m = (fun x : ↥A => (f m : F) - (x : F)) ⁻¹'
            {y : F | ValuativeRel.valuation F y ≤ (ValuativeRel.valuation F π) ^ m} := by
          ext x
          simp only [T, Set.mem_setOf_eq, Set.mem_preimage]
          rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, hIm_mem m (f m - x), AddSubgroupClass.coe_sub]
        rw [h_eq]
        exact (IsValuativeTopology.isClosed_closedBall _).preimage
          (continuous_const.sub continuous_subtype_val)
      haveI : CompactSpace ↥A :=
        IsNonarchimedeanLocalField.instCompactSpaceSubtypeMemSubringIntegerValueGroupWithZeroValuation F
      obtain ⟨L, hL⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
        T hT_anti hT_nonempty (hT_closed 0).isCompact hT_closed
      exact ⟨L, fun m => Set.mem_iInter.mp hL m⟩
    haveI : IsDiscreteValuationRing ↥A :=
      IsNonarchimedeanLocalField.instIsDiscreteValuationRingSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    haveI : IsAdicComplete I ↥A :=
      { toIsPrecomplete := h_pre
        toIsHausdorff := IsDiscreteValuationRing.instIsHausdorffMaximalIdeal ↥A }
    haveI : HenselianRing ↥A I := IsAdicComplete.henselianRing ↥A I
    intro a ha h_diff
    let a₀ : ↥A := ⟨a, le_of_eq ha⟩
    let P : Polynomial ↥A := Polynomial.X ^ e - Polynomial.C (1 : ↥A)
    have hP_monic : P.Monic := Polynomial.monic_X_pow_sub_C (1 : ↥A) he_pos.ne'
    have hP_eval : P.eval a₀ ∈ I := by
      rw [Valuation.mem_maximalIdeal_iff]
      have h_coe : ((P.eval a₀ : ↥A) : F) = a ^ e - 1 := by
        simp only [P, a₀, Polynomial.eval_sub, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C, AddSubgroupClass.coe_sub, SubmonoidClass.coe_pow,
          OneMemClass.coe_one]
      rwa [h_coe]
    have hP_deriv : IsUnit ((Ideal.Quotient.mk I) (P.derivative.eval a₀)) := by
      have h_deriv_eq : P.derivative.eval a₀ = (e : ↥A) * a₀ ^ (e - 1) := by
        simp only [P, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
          Polynomial.derivative_C, sub_zero, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X]
      rw [h_deriv_eq]
      change IsUnit (IsLocalRing.residue ↥A ((e : ↥A) * a₀ ^ (e - 1)))
      rw [map_mul, map_natCast, map_pow]
      have he_res_ne : (e : kF) ≠ 0 := by
        haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
        exact (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) e).not.mpr he_ndvd
      have ha_res_ne : IsLocalRing.residue ↥A a₀ ≠ 0 := by
        rw [Ne, IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff]
        change ¬ (ValuativeRel.valuation F a < 1)
        rw [ha]
        exact lt_irrefl 1
      exact IsUnit.mk0 _ (mul_ne_zero he_res_ne (pow_ne_zero (e - 1) ha_res_ne))
    obtain ⟨z₀, hz₀_root, hz₀_mem⟩ := HenselianRing.is_henselian P hP_monic a₀ hP_eval hP_deriv
    refine ⟨(z₀ : F), ?_, ?_⟩
    · rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
        Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hz₀_root
      exact (SubmonoidClass.coe_pow z₀ e).symm.trans (congrArg Subtype.val hz₀_root)
    · rw [Valuation.mem_maximalIdeal_iff] at hz₀_mem
      exact hz₀_mem

  
  set k₀ := (EllipticRootNumber.q F - 1) / 2
  have hk₀_pos : 0 < k₀ := by omega
  have hk₀_lt : k₀ < e := by omega
  have hk₀_mul : 2 * k₀ = e := by omega

  obtain ⟨g, hg_gen⟩ := IsCyclic.exists_monoid_generator (α := kFˣ)
  have hg_ord : orderOf g = e := by
    rw [orderOf_eq_card_of_forall_mem_powers hg_gen, Nat.card_units]
    rfl
  have hg_pow_e : g ^ e = 1 := by
    rw [← hg_ord, pow_orderOf_eq_one]
  have hg_pow_k0 : g ^ k₀ ≠ 1 :=
    pow_ne_one_of_lt_orderOf hk₀_pos.ne' (by rwa [hg_ord])

  obtain ⟨x₀, hx₀⟩ := ValuationSubring.surjective_unitGroupToResidueFieldUnits A g
  let a : F := ((x₀ : Fˣ) : F)
  have ha_val : ValuativeRel.valuation F a = 1 :=
    (Valuation.mem_unitGroup_iff F (ValuativeRel.valuation F) (x₀ : Fˣ)).mp x₀.2
  have ha_pow_lt : ValuativeRel.valuation F (a ^ e - 1) < 1 := by
    have hx₀_pow : A.unitGroupToResidueFieldUnits (x₀ ^ e) = 1 := by
      rw [map_pow, hx₀, hg_pow_e]
    have hx' : IsLocalRing.residue ↥A (A.unitGroupMulEquiv (x₀ ^ e) : ↥A) = 1 := by
      have := congrArg Units.val hx₀_pow
      rwa [ValuationSubring.coe_unitGroupToResidueFieldUnits_apply] at this
    have h_mem : (A.unitGroupMulEquiv (x₀ ^ e) : ↥A) - 1 ∈ I := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_one, hx', sub_self]
    rw [Valuation.mem_maximalIdeal_iff] at h_mem
    rwa [AddSubgroupClass.coe_sub, OneMemClass.coe_one,
      ValuationSubring.coe_unitGroupMulEquiv_apply, SubmonoidClass.coe_pow,
      Units.val_pow_eq_pow_val] at h_mem

  obtain ⟨d_F, hd_pow_e, hd_close⟩ := h_hensel a ha_val ha_pow_lt
  have hd_ne : d_F ≠ 0 := by
    rintro rfl
    rw [zero_pow he_pos.ne'] at hd_pow_e
    exact zero_ne_one hd_pow_e
  have hd_int : ValuativeRel.valuation F d_F ≤ 1 := by
    have h_eq : d_F = (d_F - a) + a := (sub_add_cancel d_F a).symm
    rw [h_eq]
    exact (Valuation.map_add _ _ _).trans (max_le (le_of_lt hd_close) (le_of_eq ha_val))
  have hd_val : ValuativeRel.valuation F d_F = 1 := by
    rcases lt_or_eq_of_le hd_int with hlt | heq
    · have hpow_lt : (ValuativeRel.valuation F d_F) ^ e < 1 :=
        pow_lt_one₀ zero_le' hlt he_pos.ne'
      rw [← map_pow, hd_pow_e, Valuation.map_one] at hpow_lt
      exact absurd hpow_lt (lt_irrefl 1)
    · exact heq

  let d₀ : ↥A := ⟨d_F, hd_int⟩
  let a₀ : ↥A := A.unitGroupMulEquiv x₀
  have hd₀_res : IsLocalRing.residue ↥A d₀ = (g : kF) := by
    have h_diff_mem : d₀ - a₀ ∈ I := by
      rw [Valuation.mem_maximalIdeal_iff]
      change ValuativeRel.valuation F (d_F - (a₀ : F)) < 1
      rwa [ValuationSubring.coe_unitGroupMulEquiv_apply]
    have h_res_zero : IsLocalRing.residue ↥A (d₀ - a₀) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr h_diff_mem
    rw [map_sub, sub_eq_zero] at h_res_zero
    have ha₀_res : IsLocalRing.residue ↥A a₀ = (g : kF) := by
      rw [← hx₀]
      exact (ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A x₀).symm
    rw [h_res_zero, ha₀_res]

  have hd_pow_k0 : d_F ^ k₀ = -1 := by
    have h_sq : (d_F ^ k₀) ^ 2 = 1 := by
      rw [← pow_mul, mul_comm k₀ 2, hk₀_mul, hd_pow_e]
    rcases sq_eq_one_iff.mp h_sq with h1 | hm1
    · exfalso
      have hd₀_pow : d₀ ^ k₀ = 1 := Subtype.ext ((SubmonoidClass.coe_pow d₀ k₀).trans h1)
      have h_res_pow : (g : kF) ^ k₀ = 1 := by
        rw [← hd₀_res, ← map_pow (IsLocalRing.residue ↥A), hd₀_pow, map_one]
      have h_unit_pow : g ^ k₀ = 1 :=
        Units.ext ((Units.val_pow_eq_pow_val g k₀).trans h_res_pow)
      exact hg_pow_k0 h_unit_pow
    · exact hm1

  have hd_nonsq_val : ∀ y : F, ValuativeRel.valuation F y ≤ 1 →
      ValuativeRel.valuation F (d_F - y ^ 2) = 1 := by
    intro y hy
    have h_le : ValuativeRel.valuation F (d_F - y ^ 2) ≤ 1 := by
      refine (Valuation.map_sub _ d_F (y ^ 2)).trans (max_le (le_of_eq hd_val) ?_)
      rw [map_pow]
      exact pow_le_one₀ zero_le' hy
    rcases lt_or_eq_of_le h_le with hlt | heq
    · exfalso
      let y₀ : ↥A := ⟨y, hy⟩
      have h_mem : d₀ - y₀ ^ 2 ∈ I := by
        rw [Valuation.mem_maximalIdeal_iff]
        exact hlt
      have h_res_zero : IsLocalRing.residue ↥A (d₀ - y₀ ^ 2) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr h_mem
      rw [map_sub, map_pow, hd₀_res, sub_eq_zero] at h_res_zero
      set y_bar : kF := IsLocalRing.residue ↥A y₀
      have hy_bar_ne : y_bar ≠ 0 := by
        rintro h0
        rw [h0, sq, mul_zero] at h_res_zero
        exact Units.ne_zero g h_res_zero
      let u_y : kFˣ := Units.mk0 y_bar hy_bar_ne
      have hg_sq : g = u_y ^ 2 := by
        apply Units.ext
        rw [Units.val_pow_eq_pow_val]
        exact h_res_zero
      letI : Fintype kF := Fintype.ofFinite kF
      letI : Fintype kFˣ := Fintype.ofFinite kFˣ
      have hcard_units : Fintype.card kFˣ = e := by
        rw [← Nat.card_eq_fintype_card, Nat.card_units]
        rfl
      have hg_k0_eq1 : g ^ k₀ = 1 := by
        rw [hg_sq, ← pow_mul, hk₀_mul, ← hcard_units, pow_card_eq_one]
      exact hg_pow_k0 hg_k0_eq1
    · exact heq

  
  have hd_nonsq : ∀ x : F, x ^ 2 ≠ d_F := by
    intro x hx
    have hx_le : ValuativeRel.valuation F x ≤ 1 := by
      by_contra h_gt
      have hlt : 1 < ValuativeRel.valuation F x := lt_of_not_ge h_gt
      have hpow_gt : 1 < (ValuativeRel.valuation F x) ^ 2 :=
        one_lt_pow₀ hlt (by decide : 2 ≠ 0)
      rw [← map_pow, hx, hd_val] at hpow_gt
      exact lt_irrefl 1 hpow_gt
    have h1 := hd_nonsq_val x hx_le
    rw [hx, sub_self, Valuation.map_zero] at h1
    exact zero_ne_one h1

  exact ⟨h2_ne, π, d_F, hπ_ne, hπ_val, hd_ne, hd_val, hd_pow_k0, hd_nonsq_val, hd_nonsq⟩

theorem quadratic_adjoin_coord_trace_and_norm_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (h2 : (2 : F) ≠ 0) (d_F : F) (hd_ne : d_F ≠ 0)
    (hd_nonsq : ∀ x : F, x ^ 2 ≠ d_F)
    (u₀ : AlgebraicClosure F)
    (hu₀_sq : u₀ ^ 2 = algebraMap F (AlgebraicClosure F) d_F) :
    FiniteDimensional F (IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))) ∧
    Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
          IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)))) ∧
    (∀ y : IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)),
      ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) ×
        (⊥ : IntermediateField F (AlgebraicClosure F)),
        y = IntermediateField.inclusion
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
                IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))) p.1 +
            IntermediateField.inclusion
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
                IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))) p.2 *
              (⟨u₀, IntermediateField.mem_adjoin_simple_self F u₀⟩ :
                IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)))) ∧
    (∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.traceLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
          IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)))
        (IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
            IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))) a +
         IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
            IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))) b *
          (⟨u₀, IntermediateField.mem_adjoin_simple_self F u₀⟩ :
            IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)))) = 2 * a) ∧
    (∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      Algebra.norm F
        (IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
            IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))) a +
         IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
            IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))) b *
          (⟨u₀, IntermediateField.mem_adjoin_simple_self F u₀⟩ :
            IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)))) =
        (IntermediateField.botEquiv F (AlgebraicClosure F) a) ^ 2 -
          d_F * (IntermediateField.botEquiv F (AlgebraicClosure F) b) ^ 2) :=
by
  let B : IntermediateField F (AlgebraicClosure F) := ⊥
  let H : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))
  let h : B ≤ H := bot_le
  let u_H : H := ⟨u₀, IntermediateField.mem_adjoin_simple_self F u₀⟩
  let e_bot : B ≃ₐ[F] F := IntermediateField.botEquiv F (AlgebraicClosure F)
  let P : Polynomial F := Polynomial.X ^ 2 - Polynomial.C d_F
  have hP_monic : P.Monic := Polynomial.monic_X_pow_sub_C d_F (by decide : (2 : ℕ) ≠ 0)
  have hP_aeval : Polynomial.aeval u₀ P = 0 := by
    simp only [P, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hu₀_sq, sub_self]
  have hu₀_int : IsIntegral F u₀ := ⟨P, hP_monic, hP_aeval⟩
  have hH_fin : FiniteDimensional F H := IntermediateField.adjoin.finiteDimensional hu₀_int
  have hH_sep : Algebra.IsSeparable B (IntermediateField.extendScalars h) := by
    let d_bot : B := algebraMap F B d_F
    have h2_bot : ((2 : ℕ) : B) ≠ 0 := by
      have h2_eq : ((2 : ℕ) : B) = algebraMap F B (2 : F) := by
        rw [Nat.cast_ofNat, map_ofNat]
      rw [h2_eq]
      exact (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr h2
    have hd_bot : d_bot ≠ 0 :=
      (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr hd_ne
    have hP_bot_sep : (Polynomial.X ^ 2 - Polynomial.C d_bot).Separable :=
      Polynomial.separable_X_pow_sub_C d_bot h2_bot hd_bot
    have hP_bot_aeval : Polynomial.aeval u₀ (Polynomial.X ^ 2 - Polynomial.C d_bot) = 0 := by
      have h_alg : algebraMap B (AlgebraicClosure F) d_bot = algebraMap F (AlgebraicClosure F) d_F :=
        (IsScalarTower.algebraMap_apply F B (AlgebraicClosure F) d_F).symm
      simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, h_alg, hu₀_sq, sub_self]
    have hu₀_sep : IsSeparable B u₀ :=
      Polynomial.Separable.of_dvd hP_bot_sep (minpoly.dvd B u₀ hP_bot_aeval)
    change Algebra.IsSeparable B
      (IntermediateField.extendScalars (bot_le : B ≤ IntermediateField.adjoin F {u₀}))
    rw [IntermediateField.extendScalars_adjoin]
    exact (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable B (AlgebraicClosure F)).mpr hu₀_sep
  have hP_irr : Irreducible P := X_pow_sub_C_irreducible_of_prime Nat.prime_two hd_nonsq
  have h_mp : minpoly F u₀ = P := (minpoly.eq_of_irreducible_of_monic hP_irr hP_aeval hP_monic).symm
  let pb : PowerBasis F H := IntermediateField.adjoin.powerBasis hu₀_int
  have hdim : pb.dim = 2 := by
    rw [IntermediateField.adjoin.powerBasis_dim hu₀_int, h_mp]
    exact Polynomial.natDegree_X_pow_sub_C
  have hgen : pb.gen = u_H := IntermediateField.adjoin.powerBasis_gen hu₀_int
  let b₂ : Module.Basis (Fin 2) F H := pb.basis.reindex (finCongr hdim)
  have hb₂0 : b₂ 0 = 1 := by
    simp only [b₂, Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, finCongr_symm,
      finCongr_apply, Fin.val_cast, Fin.val_zero, pow_zero]
  have hb₂1 : b₂ 1 = u_H := by
    simp only [b₂, Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, finCongr_symm,
      finCongr_apply, Fin.val_cast, Fin.val_one, pow_one, hgen]
  have hu_H_sq : u_H ^ 2 = algebraMap F H d_F := by
    apply Subtype.ext
    exact hu₀_sq
  have h_inc_eq : ∀ a : B, IntermediateField.inclusion h a = algebraMap F H (e_bot a) := by
    intro a
    have ha : algebraMap F B (e_bot a) = a := by
      rw [← IntermediateField.botEquiv_symm]
      exact e_bot.symm_apply_apply a
    apply Subtype.ext
    change (a : AlgebraicClosure F) = algebraMap F (AlgebraicClosure F) (e_bot a)
    have ha_val := congrArg (Subtype.val : B → AlgebraicClosure F) ha
    exact ha_val.symm
  have h_lin_comb : ∀ a b : B,
      IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H =
        (e_bot a) • b₂ 0 + (e_bot b) • b₂ 1 := by
    intro a b
    rw [h_inc_eq a, h_inc_eq b, hb₂0, hb₂1, Algebra.smul_def, mul_one, Algebra.smul_def]
  have h_repr0 : ∀ c₀ c₁ : F, b₂.repr (c₀ • b₂ 0 + c₁ • b₂ 1) 0 = c₀ := by
    intro c₀ c₁
    rw [LinearEquiv.map_add, LinearEquiv.map_smul, LinearEquiv.map_smul,
      Finsupp.coe_add, Finsupp.coe_smul, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply,
      Pi.smul_apply, smul_eq_mul, smul_eq_mul, Module.Basis.repr_self, Module.Basis.repr_self,
      Finsupp.single_eq_same, Finsupp.single_eq_of_ne (by decide : (0 : Fin 2) ≠ 1)]
    ring
  have h_repr1 : ∀ c₀ c₁ : F, b₂.repr (c₀ • b₂ 0 + c₁ • b₂ 1) 1 = c₁ := by
    intro c₀ c₁
    rw [LinearEquiv.map_add, LinearEquiv.map_smul, LinearEquiv.map_smul,
      Finsupp.coe_add, Finsupp.coe_smul, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply,
      Pi.smul_apply, smul_eq_mul, smul_eq_mul, Module.Basis.repr_self, Module.Basis.repr_self,
      Finsupp.single_eq_of_ne (by decide : (1 : Fin 2) ≠ 0), Finsupp.single_eq_same]
    ring
  have h_coord : ∀ y : H, ∃! p : B × B,
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * u_H := by
    intro y
    refine ⟨(e_bot.symm (b₂.repr y 0), e_bot.symm (b₂.repr y 1)), ?_, ?_⟩
    · dsimp only
      rw [h_lin_comb, e_bot.apply_symm_apply, e_bot.apply_symm_apply]
      conv_lhs => rw [← b₂.sum_repr y, Fin.sum_univ_two]
    · rintro ⟨a, b⟩ hy
      dsimp only at hy ⊢
      rw [h_lin_comb a b] at hy
      have ha0 : b₂.repr y 0 = e_bot a := by rw [hy, h_repr0]
      have hb1 : b₂.repr y 1 = e_bot b := by rw [hy, h_repr1]
      ext <;> dsimp only
      · rw [ha0, e_bot.symm_apply_apply]
      · rw [hb1, e_bot.symm_apply_apply]
  have h_mul_b0 : ∀ c₀ c₁ : F,
      (c₀ • b₂ 0 + c₁ • b₂ 1) * b₂ 0 = c₀ • b₂ 0 + c₁ • b₂ 1 := by
    intro c₀ c₁
    rw [hb₂0, mul_one]
  have h_mul_b1 : ∀ c₀ c₁ : F,
      (c₀ • b₂ 0 + c₁ • b₂ 1) * b₂ 1 = (c₁ * d_F) • b₂ 0 + c₀ • b₂ 1 := by
    intro c₀ c₁
    rw [hb₂0, hb₂1, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
      map_mul]
    calc (algebraMap F H c₀ * 1 + algebraMap F H c₁ * u_H) * u_H
        = algebraMap F H c₁ * u_H ^ 2 + algebraMap F H c₀ * u_H := by ring
      _ = (algebraMap F H c₁ * algebraMap F H d_F) * 1 + algebraMap F H c₀ * u_H := by
          rw [hu_H_sq, mul_one]
  have h_tr_F : ∀ a b : B,
      Algebra.trace F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) =
        2 * e_bot a := by
    intro a b
    rw [h_lin_comb a b, Algebra.trace_eq_matrix_trace b₂, Matrix.trace_fin_two,
      Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul,
      h_mul_b0, h_mul_b1, h_repr0, h_repr1]
    ring
  have h_norm : ∀ a b : B,
      Algebra.norm F (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) =
        (e_bot a) ^ 2 - d_F * (e_bot b) ^ 2 := by
    intro a b
    rw [h_lin_comb a b, Algebra.norm_eq_matrix_det b₂, Matrix.det_fin_two,
      Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul,
      Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul,
      h_mul_b0, h_mul_b1, h_repr0, h_repr1, h_repr0, h_repr1]
    ring
  have h_trace_coord : ∀ a b : B,
      EllipticRootNumber.traceLM F h
        (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) = 2 * a := by
    intro a b
    let y : H := IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H
    let e₁ : B ≃+* F := e_bot.toRingEquiv
    let e₂ : (IntermediateField.extendScalars h) ≃+* H :=
      { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mpr z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }
    have h_comm : (algebraMap F H).comp (e₁ : B →+* F) =
        (e₂ : IntermediateField.extendScalars h →+* H).comp
          (algebraMap B (IntermediateField.extendScalars h)) := by
      ext x
      exact (congrArg Subtype.val (h_inc_eq x)).symm
    change Algebra.trace B (IntermediateField.extendScalars h)
        (EllipticRootNumber.toExtendScalars F h y) = 2 * a
    rw [Algebra.trace_eq_of_equiv_equiv e₁ e₂ h_comm (EllipticRootNumber.toExtendScalars F h y)]
    change e_bot.symm (Algebra.trace F H y) = 2 * a
    rw [h_tr_F a b, map_mul, map_ofNat, e_bot.symm_apply_apply]
  exact ⟨hH_fin, hH_sep, h_coord, h_trace_coord, h_norm⟩

theorem quadratic_adjoin_valL_and_resDeg_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (π d_F : F) (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hd_val : ValuativeRel.valuation F d_F = 1)
    (hd_nonsq_val : ∀ y : F, ValuativeRel.valuation F y ≤ 1 →
      ValuativeRel.valuation F (d_F - y ^ 2) = 1)
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u_H : H)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) ×
      (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * u_H)
    (h_norm : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      Algebra.norm F (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) =
        (IntermediateField.botEquiv F (AlgebraicClosure F) a) ^ 2 -
          d_F * (IntermediateField.botEquiv F (AlgebraicClosure F) b) ^ 2) :
    EllipticRootNumber.valL F ⊥ (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) d_F) = 0 ∧
    (∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥
          (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) d_F - a ^ 2) = 0) ∧
    (∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H)) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b))) ∧
    (∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a) ∧
    (∀ y : H, EllipticRootNumber.relVal F H y = 2 * EllipticRootNumber.valL F H y) :=
by
  open ValuativeRel in
  let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
  open ValuativeRel in
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
      z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
    rintro _ hz m rfl
    exact WithZero.unzero_coe hz
  have h_addVal_of_iso : ∀ (y : F) (m : ℤ),
      iso (ValuativeRel.valuation F y) = WithZero.exp m →
      y ≠ 0 ∧ EllipticRootNumber.addVal F y = -m := by
    intro y m hy_iso
    have h_exp_ne : WithZero.exp m ≠ 0 := WithZero.exp_ne_zero
    have h_iso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := by rw [hy_iso]; exact h_exp_ne
    have hv_ne : ValuativeRel.valuation F y ≠ 0 := fun h0 => h_iso_ne (by rw [h0, map_zero])
    have hy : y ≠ 0 := (Valuation.ne_zero_iff _).mp hv_ne
    refine ⟨hy, ?_⟩
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy, h_unzero _ _ m hy_iso]
    rfl
  have h_addVal_eq : ∀ x y : F,
      ValuativeRel.valuation F x = ValuativeRel.valuation F y →
      EllipticRootNumber.addVal F x = EllipticRootNumber.addVal F y := by
    intro x y hxy
    by_cases hx : x = 0
    · subst hx
      have hy0 : ValuativeRel.valuation F y = 0 := by rw [← hxy, Valuation.map_zero]
      have hy : y = 0 := (Valuation.zero_iff _).mp hy0
      rw [hy]
    · have hv_x : ValuativeRel.valuation F x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
      have hiso_x : iso (ValuativeRel.valuation F x) ≠ 0 := (map_ne_zero _).mpr hv_x
      set u := WithZero.unzero hiso_x
      have hu_x : iso (ValuativeRel.valuation F x) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← WithZero.coe_unzero hiso_x]
        rfl
      have hu_y : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← hxy, hu_x]
      rw [(h_addVal_of_iso x (Multiplicative.toAdd u) hu_x).2,
        (h_addVal_of_iso y (Multiplicative.toAdd u) hu_y).2]
  have h_addVal_sq : ∀ x : F,
      EllipticRootNumber.addVal F (x ^ 2) = 2 * EllipticRootNumber.addVal F x := by
    intro x
    by_cases hx : x = 0
    · subst hx
      unfold EllipticRootNumber.addVal
      have h02 : (0 : F) ^ 2 = 0 := by ring
      rw [h02, dif_pos rfl]
      omega
    · have hv_ne : ValuativeRel.valuation F x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
      have hiso_ne : iso (ValuativeRel.valuation F x) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set u := WithZero.unzero hiso_ne
      have hu_eq : iso (ValuativeRel.valuation F x) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      have hx_val : EllipticRootNumber.addVal F x = -Multiplicative.toAdd u :=
        (h_addVal_of_iso x (Multiplicative.toAdd u) hu_eq).2
      have hsq_iso : iso (ValuativeRel.valuation F (x ^ 2)) =
          WithZero.exp (Multiplicative.toAdd u + Multiplicative.toAdd u) := by
        rw [map_pow, map_pow, hu_eq, sq, ← WithZero.exp_add]
      have hsq_val : EllipticRootNumber.addVal F (x ^ 2) =
          -(Multiplicative.toAdd u + Multiplicative.toAdd u) :=
        (h_addVal_of_iso (x ^ 2) (Multiplicative.toAdd u + Multiplicative.toAdd u) hsq_iso).2
      rw [hsq_val, hx_val]
      omega
  have h_addVal_zero : ∀ x : F,
      ValuativeRel.valuation F x = 1 → EllipticRootNumber.addVal F x = 0 := by
    intro x hx1
    have hiso1 : iso (ValuativeRel.valuation F x) = WithZero.exp (0 : ℤ) := by
      rw [hx1, map_one, WithZero.exp_zero]
    have h0 := (h_addVal_of_iso x 0 hiso1).2
    omega
  have h_addVal_nonneg : ∀ y : F,
      0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl, Valuation.map_zero]
      exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
    · unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set u := WithZero.unzero hiso_ne
      have hu_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_le_map_iff iso, hu_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
      omega
  have h_addVal_pos : ∀ y : F,
      (y = 0 ∨ 1 ≤ EllipticRootNumber.addVal F y) ↔ ValuativeRel.valuation F y < 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      rw [Valuation.map_zero]
      exact ⟨fun _ => zero_lt_one, fun _ => Or.inl rfl⟩
    · rw [or_iff_right hy]
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set u := WithZero.unzero hiso_ne
      have hu_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_lt_map_iff iso, hu_eq, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
      omega
  have h_relVal_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have h_norm_bot : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [h_norm_bot]
  have h_resDeg_bot : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · intro h0
      apply hπ_ne
      have := congrArg e_bot h0
      simpa using this
    · rw [h_relVal_bot, e_bot.apply_symm_apply, hπ_val]
      omega
    · rintro k ⟨hk, _⟩
      exact hk
  have h_valL_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_relVal_bot, h_resDeg_bot, Nat.cast_one, Int.ediv_one]
  have h_norm_val_max : ∀ x y : F,
      ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) =
        max (ValuativeRel.valuation F x) (ValuativeRel.valuation F y) ^ 2 := by
    intro x y
    have hv_x2 : ValuativeRel.valuation F (x ^ 2) = ValuativeRel.valuation F x ^ 2 :=
      map_pow _ x 2
    have hv_dy2 : ValuativeRel.valuation F (d_F * y ^ 2) = ValuativeRel.valuation F y ^ 2 := by
      rw [map_mul, map_pow, hd_val, one_mul]
    rcases lt_trichotomy (ValuativeRel.valuation F x) (ValuativeRel.valuation F y) with hlt | heq | hgt
    · have hlt2 : ValuativeRel.valuation F (x ^ 2) < ValuativeRel.valuation F (d_F * y ^ 2) := by
        rw [hv_x2, hv_dy2, sq, sq]
        exact mul_lt_mul' (le_of_lt hlt) hlt zero_le' (zero_le'.trans_lt hlt)
      rw [Valuation.map_sub_eq_of_lt_right _ hlt2, hv_dy2, max_eq_right (le_of_lt hlt)]
    · by_cases hy : y = 0
      · subst hy
        have hx0 : ValuativeRel.valuation F x = 0 := by rw [heq, Valuation.map_zero]
        have hx : x = 0 := (Valuation.zero_iff _).mp hx0
        subst hx
        simp
      · have hv_y_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
        have hxy_le : ValuativeRel.valuation F (x / y) ≤ 1 := by
          rw [map_div₀, heq, div_self hv_y_ne]
        have hd_xy : ValuativeRel.valuation F (d_F - (x / y) ^ 2) = 1 :=
          hd_nonsq_val (x / y) hxy_le
        have h_alg : x ^ 2 - d_F * y ^ 2 = -(y ^ 2 * (d_F - (x / y) ^ 2)) := by
          field_simp [hy]
          ring
        rw [h_alg, Valuation.map_neg, map_mul, map_pow, hd_xy, mul_one, heq, max_self]
    · have hgt2 : ValuativeRel.valuation F (d_F * y ^ 2) < ValuativeRel.valuation F (x ^ 2) := by
        rw [hv_x2, hv_dy2, sq, sq]
        exact mul_lt_mul' (le_of_lt hgt) hgt zero_le' (zero_le'.trans_lt hgt)
      rw [Valuation.map_sub_eq_of_lt_left _ hgt2, hv_x2, max_eq_left (le_of_lt hgt)]
  have h_norm_val_choice : ∀ x y : F,
      ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) = ValuativeRel.valuation F (x ^ 2) ∨
      ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) = ValuativeRel.valuation F (y ^ 2) := by
    intro x y
    rw [h_norm_val_max, map_pow, map_pow]
    rcases max_choice (ValuativeRel.valuation F x) (ValuativeRel.valuation F y) with hmax | hmax
    · left; rw [hmax]
    · right; rw [hmax]
  open ValuativeRel in
  have h_sq_le_one : ∀ γ : ValueGroupWithZero F, γ ^ 2 ≤ 1 ↔ γ ≤ 1 := by
    intro γ
    refine ⟨fun hle => ?_, fun hle => pow_le_one₀ zero_le' hle⟩
    by_contra hnot
    have hgt : 1 < γ := not_le.mp hnot
    have hgt2 : 1 < γ ^ 2 := one_lt_pow₀ hgt (by decide : 2 ≠ 0)
    exact not_lt_of_ge hle hgt2
  open ValuativeRel in
  have h_sq_lt_one : ∀ γ : ValueGroupWithZero F, γ ^ 2 < 1 ↔ γ < 1 := by
    intro γ
    refine ⟨fun hlt => ?_, fun hlt => pow_lt_one₀ zero_le' hlt (by decide : 2 ≠ 0)⟩
    by_contra hnot
    have hge : 1 ≤ γ := not_lt.mp hnot
    have hge2 : 1 ≤ γ ^ 2 := by
      rw [sq]
      simpa using mul_le_mul' hge hge
    exact not_le_of_gt hlt hge2
  have h_norm_val_le : ∀ x y : F,
      ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) ≤ 1 ↔
      ValuativeRel.valuation F x ≤ 1 ∧ ValuativeRel.valuation F y ≤ 1 := by
    intro x y
    rw [h_norm_val_max, h_sq_le_one, max_le_iff]
  have h_norm_val_lt : ∀ x y : F,
      ValuativeRel.valuation F (x ^ 2 - d_F * y ^ 2) < 1 ↔
      ValuativeRel.valuation F x < 1 ∧ ValuativeRel.valuation F y < 1 := by
    intro x y
    rw [h_norm_val_max, h_sq_lt_one, max_lt_iff]
  have h_relVal_choice : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) =
        2 * EllipticRootNumber.valL F ⊥ a ∨
      EllipticRootNumber.relVal F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) =
        2 * EllipticRootNumber.valL F ⊥ b := by
    intro a b
    unfold EllipticRootNumber.relVal
    rw [h_norm a b]
    rcases h_norm_val_choice (e_bot a) (e_bot b) with h1 | h2
    · left
      rw [h_addVal_eq _ _ h1, h_addVal_sq, ← h_valL_bot]
    · right
      rw [h_addVal_eq _ _ h2, h_addVal_sq, ← h_valL_bot]
  have h_relVal_even : ∀ y : H, ∃ m : ℤ, EllipticRootNumber.relVal F H y = 2 * m := by
    intro y
    obtain ⟨⟨a, b⟩, hy⟩ := (h_coord y).exists
    rw [hy]
    rcases h_relVal_choice a b with h1 | h2
    · exact ⟨EllipticRootNumber.valL F ⊥ a, h1⟩
    · exact ⟨EllipticRootNumber.valL F ⊥ b, h2⟩
  have h_relVal_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F H (IntermediateField.inclusion h a) =
        2 * EllipticRootNumber.valL F ⊥ a := by
    intro a
    have h_inc_eq : IntermediateField.inclusion h a =
        IntermediateField.inclusion h a + IntermediateField.inclusion h 0 * u_H := by
      simp
    rw [h_inc_eq]
    unfold EllipticRootNumber.relVal
    rw [h_norm a 0, map_zero, sq (0 : F), mul_zero, mul_zero, sub_zero, h_addVal_sq, ← h_valL_bot]
  have h_resDeg_H : EllipticRootNumber.resDeg F H = 2 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    let a_π : (⊥ : IntermediateField F (AlgebraicClosure F)) := algebraMap F _ π
    let y_π : H := IntermediateField.inclusion h a_π
    have hy_π_ne : y_π ≠ 0 := by
      dsimp [y_π, a_π]
      exact (map_ne_zero _).mpr ((map_ne_zero _).mpr hπ_ne)
    have hy_π_relVal : EllipticRootNumber.relVal F H y_π = (2 : ℕ) := by
      dsimp [y_π, a_π]
      rw [h_relVal_inc, h_valL_bot, IntermediateField.botEquiv_def, hπ_val]
      omega
    refine ⟨⟨by decide, y_π, hy_π_ne, hy_π_relVal⟩, ?_⟩
    rintro k ⟨hk_pos, y, _, hy_rel⟩
    obtain ⟨m, hm⟩ := h_relVal_even y
    omega
  have h_valL_inc : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F H (IntermediateField.inclusion h a) =
        EllipticRootNumber.valL F ⊥ a := by
    intro a
    change EllipticRootNumber.relVal F H (IntermediateField.inclusion h a) /
        (EllipticRootNumber.resDeg F H : ℤ) =
      EllipticRootNumber.valL F ⊥ a
    rw [h_relVal_inc a, h_resDeg_H, Nat.cast_ofNat, Int.mul_ediv_cancel_left _ (by decide : (2 : ℤ) ≠ 0)]
  have h_relVal_H : ∀ y : H,
      EllipticRootNumber.relVal F H y = 2 * EllipticRootNumber.valL F H y := by
    intro y
    obtain ⟨m, hm⟩ := h_relVal_even y
    unfold EllipticRootNumber.valL
    rw [hm, h_resDeg_H, Nat.cast_ofNat, Int.mul_ediv_cancel_left _ (by decide : (2 : ℤ) ≠ 0)]
  have h_conj1 : EllipticRootNumber.valL F ⊥
      (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) d_F) = 0 := by
    rw [h_valL_bot, IntermediateField.botEquiv_def]
    exact h_addVal_zero d_F hd_val
  have h_conj2 : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥
          (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) d_F - a ^ 2) = 0 := by
    intro a ha
    rw [h_valL_bot, h_addVal_nonneg] at ha
    rw [h_valL_bot, map_sub, map_pow, IntermediateField.botEquiv_def]
    exact h_addVal_zero _ (hd_nonsq_val (e_bot a) ha)
  have h_conj3 : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H)) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b)) := by
    intro a b
    let y : H := IntermediateField.inclusion h a + IntermediateField.inclusion h b * u_H
    have hy_rel : EllipticRootNumber.relVal F H y = 2 * EllipticRootNumber.valL F H y := h_relVal_H y
    have hy_norm : EllipticRootNumber.relVal F H y =
        EllipticRootNumber.addVal F ((e_bot a) ^ 2 - d_F * (e_bot b) ^ 2) := by
      dsimp [y]
      unfold EllipticRootNumber.relVal
      rw [h_norm a b]
    refine ⟨?_, ?_⟩
    · have h_nonneg_iff : 0 ≤ EllipticRootNumber.valL F H y ↔ 0 ≤ EllipticRootNumber.relVal F H y := by
        omega
      change (0 ≤ EllipticRootNumber.valL F H y ↔ _)
      rw [h_nonneg_iff, hy_norm, h_addVal_nonneg, h_norm_val_le, ← h_addVal_nonneg, ← h_addVal_nonneg,
        ← h_valL_bot, ← h_valL_bot]
    · have hy_zero : y = 0 ↔ a = 0 ∧ b = 0 := by
        refine ⟨fun hy0 => ?_, ?_⟩
        · have hp : (a, b) = ((0 : (⊥ : IntermediateField F (AlgebraicClosure F))),
              (0 : (⊥ : IntermediateField F (AlgebraicClosure F)))) :=
            (h_coord 0).unique hy0.symm (by simp)
          exact Prod.ext_iff.mp hp
        · rintro ⟨rfl, rfl⟩
          dsimp [y]
          simp
      have hnorm_zero : (e_bot a) ^ 2 - d_F * (e_bot b) ^ 2 = 0 ↔ a = 0 ∧ b = 0 := by
        rw [← Valuation.zero_iff (ValuativeRel.valuation F), h_norm_val_max, sq_eq_zero_iff]
        have h_max_zero : max (ValuativeRel.valuation F (e_bot a)) (ValuativeRel.valuation F (e_bot b)) = 0 ↔
            ValuativeRel.valuation F (e_bot a) = 0 ∧ ValuativeRel.valuation F (e_bot b) = 0 := by
          refine ⟨fun h0 => ?_, fun ⟨ha0, hb0⟩ => by rw [ha0, hb0, max_self]⟩
          have hle : max (ValuativeRel.valuation F (e_bot a)) (ValuativeRel.valuation F (e_bot b)) ≤ 0 :=
            le_of_eq h0
          rw [max_le_iff] at hle
          exact ⟨le_antisymm hle.1 zero_le', le_antisymm hle.2 zero_le'⟩
        rw [h_max_zero, Valuation.zero_iff, Valuation.zero_iff, map_eq_zero, map_eq_zero]
      have h_pos_iff : 1 ≤ EllipticRootNumber.valL F H y ↔ 1 ≤ EllipticRootNumber.relVal F H y := by
        omega
      change (y = 0 ∨ 1 ≤ EllipticRootNumber.valL F H y ↔ _)
      rw [hy_zero, ← hnorm_zero, h_pos_iff, hy_norm, h_addVal_pos, h_norm_val_lt,
        ← h_addVal_pos, ← h_addVal_pos, map_eq_zero, map_eq_zero,
        ← h_valL_bot, ← h_valL_bot]
  exact ⟨h_conj1, h_conj2, h_conj3, h_valL_inc, h_relVal_H⟩

theorem quadratic_adjoin_unramified_and_weil_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (d_F : F) (hd_pow : d_F ^ ((EllipticRootNumber.q F - 1) / 2) = -1)
    (u₀ : AlgebraicClosure F)
    (hu₀_sq : u₀ ^ 2 = algebraMap F (AlgebraicClosure F) d_F) :
    IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)) ≤
      EllipticRootNumber.unramifiedClosure F ∧
    (∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈
        (IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))).fixingSubgroup ↔
        2 ∣ Multiplicative.toAdd
          (EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w))) :=
by
  open ValuativeRel in
  (
    have hp : (EllipticRootNumber.p F).Prime :=
      CharP.char_is_prime 𝓀[F] (EllipticRootNumber.p F)
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    obtain ⟨k_res, _, hk_res⟩ := FiniteField.card 𝓀[F] (EllipticRootNumber.p F)
    have hq_pow : EllipticRootNumber.q F = (EllipticRootNumber.p F) ^ (k_res : ℕ) := by
      unfold EllipticRootNumber.q
      rw [Nat.card_eq_fintype_card, hk_res]
    have hq_ge_two : 2 ≤ EllipticRootNumber.q F := by
      rw [hq_pow]
      exact Nat.one_lt_pow k_res.ne_zero hp.one_lt
    have hp_dvd_q : EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
      rw [hq_pow]
      exact dvd_pow_self _ k_res.ne_zero
    have hp_not_dvd_two : ¬ (EllipticRootNumber.p F ∣ 2) := by
      intro hdvd
      rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | hp2
      · exact hp.ne_one h1
      · exact hq2 (hp2 ▸ hp_dvd_q)
    have h2_res_ne : ((2 : ℕ) : 𝓀[F]) ≠ 0 := by
      unfold EllipticRootNumber.p at hp_not_dvd_two
      exact (CharP.cast_eq_zero_iff 𝓀[F] (ringChar 𝓀[F]) 2).not.mpr hp_not_dvd_two
    have h2_ne : (2 : AlgebraicClosure F) ≠ 0 := by
      intro h2_zero
      apply h2_res_ne
      have h2_F_zero : (2 : F) = 0 := by
        apply (algebraMap F (AlgebraicClosure F)).injective
        rw [map_ofNat, h2_zero, map_zero]
      have h2_int_zero : (2 : ↥𝒪[F]) = 0 := by
        ext
        exact h2_F_zero
      rw [Nat.cast_ofNat, ← map_ofNat (IsLocalRing.residue ↥𝒪[F]) 2, h2_int_zero, map_zero]
    set k₀ : ℕ := (EllipticRootNumber.q F - 1) / 2
    have hk₀_mul : 2 * k₀ = EllipticRootNumber.q F - 1 := by omega
    have hu₀_pow : u₀ ^ (EllipticRootNumber.q F - 1) = -1 := by
      rw [← hk₀_mul, pow_mul, hu₀_sq, ← map_pow, hd_pow, map_neg, map_one]
    have hu₀_pow_2e : u₀ ^ (2 * (EllipticRootNumber.q F - 1)) = 1 := by
      rw [mul_comm, pow_mul, hu₀_pow, neg_one_sq]
    have h2e_pos : 0 < 2 * (EllipticRootNumber.q F - 1) := by omega
    have hp_not_dvd_qm1 : ¬ (EllipticRootNumber.p F ∣ (EllipticRootNumber.q F - 1)) := by
      intro hdvd
      have h_add : (EllipticRootNumber.q F - 1) + 1 = EllipticRootNumber.q F := by omega
      have hdvd1 : EllipticRootNumber.p F ∣ 1 :=
        (Nat.dvd_add_right hdvd).mp (h_add.symm ▸ hp_dvd_q)
      exact hp.ne_one (Nat.dvd_one.mp hdvd1)
    have hp_not_dvd_2e : ¬ (EllipticRootNumber.p F ∣ (2 * (EllipticRootNumber.q F - 1))) := by
      intro hdvd
      rcases hp.dvd_mul.mp hdvd with h2 | hqm1
      · exact hp_not_dvd_two h2
      · exact hp_not_dvd_qm1 hqm1
    have hu₀_prim : EllipticRootNumber.IsPrimeToPRootOfUnity F u₀ :=
      ⟨2 * (EllipticRootNumber.q F - 1), h2e_pos, hp_not_dvd_2e, hu₀_pow_2e⟩
    have hH_unr : IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F)) ≤
        EllipticRootNumber.unramifiedClosure F := by
      unfold EllipticRootNumber.unramifiedClosure
      exact IntermediateField.adjoin_simple_le_iff.mpr
        (IntermediateField.subset_adjoin F {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} hu₀_prim)
    
    have h_coprime_q : ∀ (N m : ℕ), ¬ EllipticRootNumber.p F ∣ N →
        (EllipticRootNumber.q F ^ m).Coprime N := by
      intro N m hpN
      rw [hq_pow]
      exact ((hp.coprime_iff_not_dvd.mpr hpN).pow_left _).pow_left _
    have eq_of_pow_q_pow_eq : ∀ (z₁ z₂ : AlgebraicClosure F) (N m : ℕ),
        0 < N → ¬ EllipticRootNumber.p F ∣ N → z₁ ^ N = 1 → z₂ ^ N = 1 →
        z₁ ^ (EllipticRootNumber.q F ^ m) = z₂ ^ (EllipticRootNumber.q F ^ m) → z₁ = z₂ := by
      intro z₁ z₂ N m hN0 hpN hz₁ hz₂ heq
      have hz₁0 : z₁ ≠ 0 := fun h => by rw [h, zero_pow hN0.ne'] at hz₁; exact zero_ne_one hz₁
      have hz₂0 : z₂ ≠ 0 := fun h => by rw [h, zero_pow hN0.ne'] at hz₂; exact zero_ne_one hz₂
      let u₁ : (AlgebraicClosure F)ˣ := Units.mk0 z₁ hz₁0
      let u₂ : (AlgebraicClosure F)ˣ := Units.mk0 z₂ hz₂0
      let u : (AlgebraicClosure F)ˣ := u₁ * u₂⁻¹
      have huN : u ^ N = 1 := by
        have hu₁N : u₁ ^ N = 1 := by ext; exact hz₁
        have hu₂N : u₂ ^ N = 1 := by ext; exact hz₂
        rw [mul_pow, inv_pow, hu₁N, hu₂N, inv_one, mul_one]
      have huq : u ^ (EllipticRootNumber.q F ^ m) = 1 := by
        have hu₁_eq : u₁ ^ (EllipticRootNumber.q F ^ m) = u₂ ^ (EllipticRootNumber.q F ^ m) := by
          ext
          exact heq
        rw [mul_pow, inv_pow, hu₁_eq, mul_inv_cancel]
      have hdvd : orderOf u ∣ Nat.gcd (EllipticRootNumber.q F ^ m) N :=
        Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one huq) (orderOf_dvd_of_pow_eq_one huN)
      rw [(h_coprime_q N m hpN).gcd_eq_one] at hdvd
      have hu1 : u = 1 := orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_one hdvd)
      have hu_eq : u₁ = u₂ := mul_inv_eq_one.mp hu1
      exact congrArg Units.val hu_eq
    have h_root_gal : ∀ (τ : EllipticRootNumber.AbsGal F) (ζ : AlgebraicClosure F),
        EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        EllipticRootNumber.IsPrimeToPRootOfUnity F (τ ζ) := by
      rintro τ ζ ⟨N, hN0, hpN, hζN⟩
      exact ⟨N, hN0, hpN, by rw [← map_pow, hζN, map_one]⟩
    have h_frob_one : EllipticRootNumber.ActsAsFrobPow F 1 0 := by
      intro ζ _
      simp
    have h_frob_mul : ∀ (σ τ : EllipticRootNumber.AbsGal F) (m n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ m →
        EllipticRootNumber.ActsAsFrobPow F τ n →
        EllipticRootNumber.ActsAsFrobPow F (σ * τ) (m + n) := by
      intro σ τ m n hm hn ζ hζ
      rcases hζ with ⟨N, hN0, hpN, hζN⟩
      have hζ' : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ := ⟨N, hN0, hpN, hζN⟩
      have hz₁N : (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(m + n)).toNat)) ^ N = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζN, map_one, one_pow]
      have hz₂N : (ζ ^ (EllipticRootNumber.q F ^ (m + n).toNat)) ^ N = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, hζN, one_pow]
      apply eq_of_pow_q_pow_eq _ _ N ((-m).toNat + (-n).toNat) hN0 hpN hz₁N hz₂N
      calc (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(m + n)).toNat)) ^
            (EllipticRootNumber.q F ^ ((-m).toNat + (-n).toNat))
        _ = (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-(m + n)).toNat + ((-m).toNat + (-n).toNat))) := by
            rw [AlgEquiv.mul_apply, ← pow_mul, ← pow_add]
        _ = ((σ (τ ζ)) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + (-n).toNat)) := by
            rw [← pow_mul, ← pow_add]
            congr 2
            omega
        _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ m.toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + (-n).toNat)) := by
            rw [hm (τ ζ) (h_root_gal τ ζ hζ')]
        _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + m.toNat)) := by
            rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
            congr 2
            omega
        _ = (ζ ^ (EllipticRootNumber.q F ^ n.toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + m.toNat)) := by
            rw [hn ζ hζ']
        _ = (ζ ^ (EllipticRootNumber.q F ^ (m + n).toNat)) ^
            (EllipticRootNumber.q F ^ ((-m).toNat + (-n).toNat)) := by
            rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
            congr 2
            omega
    have h_frob_inv : ∀ (σ : EllipticRootNumber.AbsGal F) (m : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ m →
        EllipticRootNumber.ActsAsFrobPow F σ⁻¹ (-m) := by
      intro σ m hm ζ hζ
      have h1 := hm (σ⁻¹ ζ) (h_root_gal σ⁻¹ ζ hζ)
      have h2 : σ (σ⁻¹ ζ) = ζ := AlgEquiv.apply_symm_apply σ ζ
      rw [h2] at h1
      rw [neg_neg]
      exact h1.symm
    have h_weil_exists : ∀ v : EllipticRootNumber.weilGroup F,
        ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F (v : EllipticRootNumber.AbsGal F) n := by
      rintro ⟨σ, hσ⟩
      exact Subgroup.closure_induction
        (fun τ hτ => hτ)
        ⟨0, h_frob_one⟩
        (fun τ₁ τ₂ _ _ ⟨m, hm⟩ ⟨n, hn⟩ => ⟨m + n, h_frob_mul τ₁ τ₂ m n hm hn⟩)
        (fun τ _ ⟨m, hm⟩ => ⟨-m, h_frob_inv τ m hm⟩)
        hσ
    have h_frob_unique : ∀ (σ : EllipticRootNumber.AbsGal F) (m n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ m →
        EllipticRootNumber.ActsAsFrobPow F σ n → m = n := by
      intro σ m n hm hn
      have h_diff : EllipticRootNumber.ActsAsFrobPow F 1 (-m + n) := by
        have h1 := h_frob_mul σ⁻¹ σ (-m) n (h_frob_inv σ m hm) hn
        rwa [inv_mul_cancel] at h1
      set d : ℤ := -m + n
      set A : ℕ := (-d).toNat
      set B : ℕ := d.toNat
      obtain ⟨r, hr_ge, hr_prime⟩ := Nat.exists_infinite_primes
        (max (EllipticRootNumber.p F) (max (EllipticRootNumber.q F ^ A) (EllipticRootNumber.q F ^ B)) + 1)
      have h_max_lt_r :
          max (EllipticRootNumber.p F) (max (EllipticRootNumber.q F ^ A) (EllipticRootNumber.q F ^ B)) < r :=
        Nat.lt_of_succ_le hr_ge
      have hp_lt_r : EllipticRootNumber.p F < r :=
        lt_of_le_of_lt (le_max_left _ _) h_max_lt_r
      have hqA_lt_r : EllipticRootNumber.q F ^ A < r :=
        lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) h_max_lt_r
      have hqB_lt_r : EllipticRootNumber.q F ^ B < r :=
        lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) h_max_lt_r
      have hp_not_dvd_r : ¬ EllipticRootNumber.p F ∣ r := by
        intro hdvd
        rcases (Nat.dvd_prime hr_prime).mp hdvd with h1 | hr_eq
        · exact hp.ne_one h1
        · exact hp_lt_r.ne hr_eq
      have hr_F_ne : (r : F) ≠ 0 := by
        have hr_res_ne : (r : 𝓀[F]) ≠ 0 := by
          unfold EllipticRootNumber.p at hp_not_dvd_r
          exact (CharP.cast_eq_zero_iff 𝓀[F] (ringChar 𝓀[F]) r).not.mpr hp_not_dvd_r
        intro hr0
        apply hr_res_ne
        have hr_int0 : (r : ↥𝒪[F]) = 0 := by
          ext
          exact hr0
        rw [← map_natCast (IsLocalRing.residue ↥𝒪[F]) r, hr_int0, map_zero]
      letI : NeZero (r : F) := ⟨hr_F_ne⟩
      obtain ⟨ζ_r, hζ_r⟩ := (AlgebraicClosure.hasEnoughRootsOfUnity F r).prim
      have hζ_r_root : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ_r :=
        ⟨r, hr_prime.pos, hp_not_dvd_r, hζ_r.pow_eq_one⟩
      have h_pow_eq : ζ_r ^ (EllipticRootNumber.q F ^ A) = ζ_r ^ (EllipticRootNumber.q F ^ B) := by
        simpa [A, B] using h_diff ζ_r hζ_r_root
      have hq_pow_eq : EllipticRootNumber.q F ^ A = EllipticRootNumber.q F ^ B :=
        hζ_r.pow_inj hqA_lt_r hqB_lt_r h_pow_eq
      have hAB : A = B := Nat.pow_right_injective hq_ge_two hq_pow_eq
      change (-d).toNat = d.toNat at hAB
      omega
    have h_deg_eq : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.weilDegree F σ = n := by
      intro σ n hn
      unfold EllipticRootNumber.weilDegree
      have hex : ∃ m : ℤ, EllipticRootNumber.ActsAsFrobPow F σ m := ⟨n, hn⟩
      rw [dif_pos hex]
      exact h_frob_unique σ hex.choose n hex.choose_spec hn
    let f₀ : EllipticRootNumber.weilGroup F →* Multiplicative ℤ :=
      { toFun := fun v => Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v : EllipticRootNumber.AbsGal F))
        map_one' := by
          change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F 1) = 1
          rw [h_deg_eq 1 0 h_frob_one, ofAdd_zero]
        map_mul' := fun v₁ v₂ => by
          obtain ⟨m, hm⟩ := h_weil_exists v₁
          obtain ⟨n, hn⟩ := h_weil_exists v₂
          change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F
            ((v₁ : EllipticRootNumber.AbsGal F) * (v₂ : EllipticRootNumber.AbsGal F))) =
            Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v₁ : EllipticRootNumber.AbsGal F)) *
              Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v₂ : EllipticRootNumber.AbsGal F))
          rw [h_deg_eq _ m hm, h_deg_eq _ n hn,
            h_deg_eq _ (m + n) (h_frob_mul _ _ m n hm hn), ofAdd_add] }
    have h_exists_hom : ∃ f : EllipticRootNumber.weilGroup F →* Multiplicative ℤ,
        ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
          EllipticRootNumber.ActsAsFrobPow F σ n → f σ = Multiplicative.ofAdd n := by
      refine ⟨f₀, fun σ n hn => ?_⟩
      change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (σ : EllipticRootNumber.AbsGal F)) =
        Multiplicative.ofAdd n
      rw [h_deg_eq _ n hn]
    have h_hom_spec : ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n →
        EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n :=
      Classical.epsilon_spec h_exists_hom
    
    have hqm1_ne_zero : EllipticRootNumber.q F - 1 ≠ 0 := by omega
    have hu₀_ne : u₀ ≠ 0 := by
      intro hu0
      rw [hu0, zero_pow hqm1_ne_zero] at hu₀_pow
      exact (neg_ne_zero.mpr one_ne_zero) hu₀_pow.symm
    have h_neg_u₀_ne : -u₀ ≠ u₀ := by
      intro h_eq
      have h2u : (2 : AlgebraicClosure F) * u₀ = 0 := by
        have h_sum : -u₀ + u₀ = 0 := neg_add_cancel u₀
        rw [h_eq, ← two_mul] at h_sum
        exact h_sum
      exact mul_ne_zero h2_ne hu₀_ne h2u
    have hu₀_pow_q : u₀ ^ (EllipticRootNumber.q F) = -u₀ := by
      have hq_eq_add : EllipticRootNumber.q F = (EllipticRootNumber.q F - 1) + 1 := by omega
      conv_lhs => rw [hq_eq_add]
      rw [pow_add, pow_one, hu₀_pow, neg_one_mul]
    have h_neg_one_pow_q : (-1 : AlgebraicClosure F) ^ (EllipticRootNumber.q F) = -1 := by
      have hq_odd : EllipticRootNumber.q F = 2 * k₀ + 1 := by omega
      rw [hq_odd, pow_add, pow_mul, neg_one_sq, one_pow, pow_one, one_mul]
    have h_iter_pow : ∀ (z : AlgebraicClosure F), z ^ (EllipticRootNumber.q F) = -z →
        ∀ m : ℕ, z ^ (EllipticRootNumber.q F ^ m) = (-1 : AlgebraicClosure F) ^ m * z := by
      intro z hz m
      induction m with
      | zero => simp
      | succ m ihm =>
        rw [pow_succ, pow_mul]
        calc (z ^ (EllipticRootNumber.q F ^ m)) ^ (EllipticRootNumber.q F)
          _ = ((-1 : AlgebraicClosure F) ^ m * z) ^ (EllipticRootNumber.q F) := by rw [ihm]
          _ = ((-1 : AlgebraicClosure F) ^ (EllipticRootNumber.q F)) ^ m *
                z ^ (EllipticRootNumber.q F) := by
              rw [mul_pow, ← pow_mul, mul_comm m, pow_mul]
          _ = (-1 : AlgebraicClosure F) ^ m * (-z) := by rw [h_neg_one_pow_q, hz]
          _ = (-1 : AlgebraicClosure F) ^ (m + 1) * z := by
              rw [pow_succ, mul_assoc, neg_one_mul, mul_neg]
    have h_neg_one_pow_mod : ∀ M : ℕ,
        (-1 : AlgebraicClosure F) ^ M = (-1 : AlgebraicClosure F) ^ (M % 2) := by
      intro M
      conv_lhs => rw [← Nat.div_add_mod M 2]
      rw [pow_add, pow_mul, neg_one_sq, one_pow, one_mul]
    refine ⟨hH_unr, fun w => ?_⟩
    set v : EllipticRootNumber.weilGroup F :=
      Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w
    obtain ⟨n, hn_frob⟩ := h_weil_exists v
    have hn_deg : EllipticRootNumber.weilDegreeHom F v = Multiplicative.ofAdd n :=
      h_hom_spec v n hn_frob
    rw [hn_deg, toAdd_ofAdd]
    let σ : EllipticRootNumber.AbsGal F := (w : EllipticRootNumber.AbsGal F)
    change σ ∈ (IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))).fixingSubgroup ↔ 2 ∣ n
    have h_fix_iff :
        σ ∈ (IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))).fixingSubgroup ↔
          σ u₀ = u₀ := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hσ
        exact hσ u₀ (IntermediateField.mem_adjoin_simple_self F u₀)
      · intro h_fix x hx
        exact IntermediateField.adjoin_induction F
          (p := fun x _ => σ x = x)
          (fun y hy => by dsimp only; rw [Set.mem_singleton_iff.mp hy]; exact h_fix)
          (fun a => AlgEquiv.commutes σ a)
          (fun a b _ _ ha hb => by dsimp only at ha hb ⊢; rw [map_add, ha, hb])
          (fun a _ ha => by dsimp only at ha ⊢; rw [map_inv₀, ha])
          (fun a b _ _ ha hb => by dsimp only at ha hb ⊢; rw [map_mul, ha, hb])
          hx
    rw [h_fix_iff]
    have hσ_u₀_sq : (σ u₀) ^ 2 = u₀ ^ 2 := by
      rw [← map_pow, hu₀_sq, AlgEquiv.commutes]
    have hσ_u₀_cases : σ u₀ = u₀ ∨ σ u₀ = -u₀ := sq_eq_sq_iff_eq_or_eq_neg.mp hσ_u₀_sq
    have hσ_u₀_pow_q : (σ u₀) ^ (EllipticRootNumber.q F) = -(σ u₀) := by
      rcases hσ_u₀_cases with h_eq | h_neg
      · rw [h_eq, hu₀_pow_q]
      · calc (σ u₀) ^ (EllipticRootNumber.q F)
          _ = ((-1 : AlgebraicClosure F) * u₀) ^ (EllipticRootNumber.q F) := by
              rw [h_neg, neg_one_mul]
          _ = (-1 : AlgebraicClosure F) ^ (EllipticRootNumber.q F) * u₀ ^ (EllipticRootNumber.q F) :=
              mul_pow _ _ _
          _ = (-1 : AlgebraicClosure F) * (-u₀) := by
              rw [h_neg_one_pow_q, hu₀_pow_q]
          _ = -(σ u₀) := by
              rw [h_neg, neg_one_mul]
    have h_eval : (σ u₀) ^ (EllipticRootNumber.q F ^ (-n).toNat) =
        u₀ ^ (EllipticRootNumber.q F ^ n.toNat) :=
      hn_frob u₀ hu₀_prim
    rw [h_iter_pow (σ u₀) hσ_u₀_pow_q (-n).toNat, h_iter_pow u₀ hu₀_pow_q n.toNat] at h_eval
    have hσ_u₀_eq : σ u₀ = (-1 : AlgebraicClosure F) ^ ((-n).toNat + n.toNat) * u₀ := by
      calc σ u₀
        _ = ((-1 : AlgebraicClosure F) * (-1 : AlgebraicClosure F)) ^ (-n).toNat * σ u₀ := by
            rw [neg_one_mul, neg_neg, one_pow, one_mul]
        _ = (-1 : AlgebraicClosure F) ^ (-n).toNat *
              ((-1 : AlgebraicClosure F) ^ (-n).toNat * σ u₀) := by
            rw [mul_pow, mul_assoc]
        _ = (-1 : AlgebraicClosure F) ^ (-n).toNat *
              ((-1 : AlgebraicClosure F) ^ n.toNat * u₀) := by
            rw [h_eval]
        _ = (-1 : AlgebraicClosure F) ^ ((-n).toNat + n.toNat) * u₀ := by
            rw [← mul_assoc, ← pow_add]
    rw [h_neg_one_pow_mod ((-n).toNat + n.toNat)] at hσ_u₀_eq
    by_cases hn2 : 2 ∣ n
    · have h_mod0 : ((-n).toNat + n.toNat) % 2 = 0 := by omega
      rw [h_mod0, pow_zero, one_mul] at hσ_u₀_eq
      exact ⟨fun _ => hn2, fun _ => hσ_u₀_eq⟩
    · have h_mod1 : ((-n).toNat + n.toNat) % 2 = 1 := by omega
      rw [h_mod1, pow_one, neg_one_mul] at hσ_u₀_eq
      exact ⟨fun h_eq => False.elim (h_neg_u₀_ne (hσ_u₀_eq.symm.trans h_eq)),
        fun h_dvd => False.elim (hn2 h_dvd)⟩
  )

theorem unramified_quadratic_extension_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F)) :
    ∃ (H : IntermediateField F (AlgebraicClosure F))
      (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
      (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ),
      FiniteDimensional F H ∧
      Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F)) (IntermediateField.extendScalars h) ∧
      H ≤ EllipticRootNumber.unramifiedClosure F ∧
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
          2 ∣ Multiplicative.toAdd
            (EllipticRootNumber.weilDegreeHom F
              (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w))) ∧
      (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))) ∧
      EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      (∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
        0 ≤ EllipticRootNumber.valL F ⊥ a →
          EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0) ∧
      (∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
        y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H)) ∧
      (∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
        (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
          0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
        ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
          1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
          (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b))) ∧
      (∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F H (IntermediateField.inclusion h a) = EllipticRootNumber.valL F ⊥ a) ∧
      (∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.traceLM F h (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) = 2 * a) ∧
      (∀ y : H, EllipticRootNumber.relVal F H y = 2 * EllipticRootNumber.valL F H y) :=
by
  obtain ⟨h2_ne, π, d_F, hπ_ne, hπ_val, hd_F_ne, hd_F_val, hd_F_pow, hd_F_nonsq_val, hd_F_nonsq⟩ :=
    exists_teichmuller_nonsquare_unit_and_uniformizer F hq2
  obtain ⟨u₀, hu₀_sq⟩ :=
    IsAlgClosed.exists_pow_nat_eq (algebraMap F (AlgebraicClosure F) d_F) (by decide : 0 < 2)
  let B : IntermediateField F (AlgebraicClosure F) := ⊥
  let H : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.adjoin F ({u₀} : Set (AlgebraicClosure F))
  let h : B ≤ H := bot_le
  let u_H : H := ⟨u₀, IntermediateField.mem_adjoin_simple_self F u₀⟩
  have hd_bot_ne : (algebraMap F B d_F) ≠ 0 :=
    (map_ne_zero (algebraMap F B)).mpr hd_F_ne
  let d : Bˣ := Units.mk0 (algebraMap F B d_F) hd_bot_ne
  have hu_H_ne : u_H ≠ 0 := by
    intro hu0
    have h0 : (u_H : AlgebraicClosure F) = 0 := congrArg Subtype.val hu0
    have h1 : u₀ ^ 2 = 0 := by
      change (u_H : AlgebraicClosure F) ^ 2 = 0
      rw [h0, sq, mul_zero]
    rw [hu₀_sq] at h1
    exact hd_F_ne ((map_eq_zero (algebraMap F (AlgebraicClosure F))).mp h1)
  let u : Hˣ := Units.mk0 u_H hu_H_ne
  have hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : B) := by
    apply Subtype.ext
    exact hu₀_sq
  obtain ⟨hH_fin, hH_sep, h_coord, h_trace_coord, h_norm⟩ :=
    quadratic_adjoin_coord_trace_and_norm_spec F h2_ne d_F hd_F_ne hd_F_nonsq u₀ hu₀_sq
  obtain ⟨hd_val, hd_nonsq, h_valL_coord, h_valL_inc, h_relVal_H⟩ :=
    quadratic_adjoin_valL_and_resDeg_spec F π d_F hπ_ne hπ_val hd_F_val hd_F_nonsq_val
      H h u_H h_coord h_norm
  obtain ⟨hH_unr, hH_weil⟩ :=
    quadratic_adjoin_unramified_and_weil_spec F hq2 d_F hd_F_pow u₀ hu₀_sq
  exact ⟨H, h, u, d, hH_fin, hH_sep, hH_unr, hH_weil, hu_sq, hd_val, hd_nonsq,
    h_coord, h_valL_coord, h_valL_inc, h_trace_coord, h_relVal_H⟩

theorem dihedral_primitive_root_of_unity_in_quadratic_ext (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hdi : ¬ ((12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)))
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hd_nonsq : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H)) :
    ∃ (π : F) (ζ : AlgebraicClosure F),
      π ≠ 0 ∧
      EllipticRootNumber.addVal F π = 1 ∧
      ζ ∈ H ∧
      ζ ^ (12 / Nat.gcd n 12) = 1 ∧
      (∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 → ζ ^ k ≠ 1) ∧
      (∀ σ : EllipticRootNumber.AbsGal F,
        ¬ (σ ∈ H.fixingSubgroup) → σ ζ * ζ = 1) :=
by
  classical
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ, OrderMonoidIso.apply_symm_apply]
  have hπ_ne : π ≠ 0 := by
    rintro rfl
    rw [Valuation.map_zero, map_zero] at hπ_iso
    exact WithZero.exp_ne_zero hπ_iso.symm
  have hπ_lt1 : ValuativeRel.valuation F π < 1 := by
    rw [← map_lt_map_iff iso, hπ_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have hπ_val : EllipticRootNumber.addVal F π = 1 := by
    unfold EllipticRootNumber.addVal
    rw [dif_neg hπ_ne]
    have h_unzero : WithZero.unzero (x := iso (ValuativeRel.valuation F π))
        (by rw [hπ_iso]; exact WithZero.exp_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      simp only [hπ_iso, WithZero.exp, WithZero.unzero_coe]
    rw [h_unzero, toAdd_ofAdd]
    norm_num

  let A := (ValuativeRel.valuation F).valuationSubring
  let I := IsLocalRing.maximalIdeal ↥A
  let kF := IsLocalRing.ResidueField ↥A
  haveI : Finite kF :=
    inferInstanceAs (Finite (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer))
  have hp_info : (EllipticRootNumber.p F).Prime ∧ EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
    letI : Fintype kF := Fintype.ofFinite kF
    obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
    refine ⟨hp_prime, ?_⟩
    unfold EllipticRootNumber.q EllipticRootNumber.p
    change ringChar kF ∣ Nat.card kF
    rw [Nat.card_eq_fintype_card, hcard_eq]
    exact dvd_pow_self (ringChar kF) k_card.ne_zero
  obtain ⟨hp_prime, hp_dvd_q⟩ := hp_info
  have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
    rintro h; rw [h] at hp_dvd_q; exact hq2 hp_dvd_q
  have hp_ne3 : EllipticRootNumber.p F ≠ 3 := by
    rintro h; rw [h] at hp_dvd_q; exact hq3 hp_dvd_q
  have hp_ndvd2 : ¬ (EllipticRootNumber.p F ∣ 2) := by
    intro hdvd
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
    · exact hp_prime.ne_one h1
    · exact hp_ne2 h2
  have hp_ndvd3 : ¬ (EllipticRootNumber.p F ∣ 3) := by
    intro hdvd
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
    · exact hp_prime.ne_one h1
    · exact hp_ne3 h3
  haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
  have h2_kF : (2 : kF) ≠ 0 := by
    exact_mod_cast (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) 2).not.mpr hp_ndvd2
  have h3_kF : (3 : kF) ≠ 0 := by
    exact_mod_cast (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) 3).not.mpr hp_ndvd3
  have h2_F : (2 : F) ≠ 0 := by
    intro h0
    have h0_A : (2 : ↥A) = 0 := Subtype.ext h0
    have h0_kF : IsLocalRing.residue ↥A (2 : ↥A) = 0 := by rw [h0_A, map_zero]
    rw [map_ofNat] at h0_kF
    exact h2_kF h0_kF
  have h3_F : (3 : F) ≠ 0 := by
    intro h0
    have h0_A : (3 : ↥A) = 0 := Subtype.ext h0
    have h0_kF : IsLocalRing.residue ↥A (3 : ↥A) = 0 := by rw [h0_A, map_zero]
    rw [map_ofNat] at h0_kF
    exact h3_kF h0_kF

  have h_hensel_sq : ∀ (c a : F),
      ValuativeRel.valuation F c ≤ 1 →
      ValuativeRel.valuation F a = 1 →
      ValuativeRel.valuation F (a ^ 2 - c) < 1 →
      ∃ z : F, z ^ 2 = c := by
    let π₀ : ↥A := ⟨π, le_of_lt hπ_lt1⟩
    have h_lt1_iff_le_π : ∀ y : F,
        ValuativeRel.valuation F y < 1 ↔
          ValuativeRel.valuation F y ≤ ValuativeRel.valuation F π := by
      intro y
      rw [← map_lt_map_iff iso, ← map_le_map_iff iso, hπ_iso, map_one]
      rcases hy : iso (ValuativeRel.valuation F y) with _ | m
      · change (0 : WithZero (Multiplicative ℤ)) < 1 ↔
          (0 : WithZero (Multiplicative ℤ)) ≤ WithZero.exp (-1 : ℤ)
        exact ⟨fun _ => zero_le', fun _ => WithZero.zero_lt_coe _⟩
      · change WithZero.exp (Multiplicative.toAdd m) < WithZero.exp (0 : ℤ) ↔
          WithZero.exp (Multiplicative.toAdd m) ≤ WithZero.exp (-1 : ℤ)
        rw [WithZero.exp_lt_exp, WithZero.exp_le_exp]
        omega
    have hI_span : I = Ideal.span {π₀} := by
      ext x
      rw [Valuation.mem_maximalIdeal_iff, Ideal.mem_span_singleton,
        Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F))]
      exact h_lt1_iff_le_π (x : F)
    have hIm_mem : ∀ (m : ℕ) (x : ↥A),
        x ∈ I ^ m ↔ ValuativeRel.valuation F (x : F) ≤ (ValuativeRel.valuation F π) ^ m := by
      intro m x
      rw [hI_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
        Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F)),
        map_pow, map_pow]
      rfl
    have h_pre : IsPrecomplete I ↥A := by
      refine IsPrecomplete.mk fun f hf => ?_
      let T : ℕ → Set ↥A := fun m => {x : ↥A | f m ≡ x [SMOD I ^ m • (⊤ : Submodule ↥A ↥A)]}
      have hT_anti : ∀ m : ℕ, T (m + 1) ⊆ T m := by
        intro m x hx
        have h_le : I ^ (m + 1) • (⊤ : Submodule ↥A ↥A) ≤ I ^ m • (⊤ : Submodule ↥A ↥A) := by
          rw [smul_eq_mul, Ideal.mul_top, smul_eq_mul, Ideal.mul_top]
          exact Ideal.pow_le_pow_right (Nat.le_succ m)
        exact (hf (Nat.le_succ m)).trans (hx.mono h_le)
      have hT_nonempty : ∀ m : ℕ, (T m).Nonempty := fun m => ⟨f m, SModEq.refl (f m)⟩
      have hT_closed : ∀ m : ℕ, IsClosed (T m) := by
        intro m
        have h_eq : T m = (fun x : ↥A => (f m : F) - (x : F)) ⁻¹'
            {y : F | ValuativeRel.valuation F y ≤ (ValuativeRel.valuation F π) ^ m} := by
          ext x
          simp only [T, Set.mem_setOf_eq, Set.mem_preimage]
          rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, hIm_mem m (f m - x), AddSubgroupClass.coe_sub]
        rw [h_eq]
        exact (IsValuativeTopology.isClosed_closedBall _).preimage
          (continuous_const.sub continuous_subtype_val)
      haveI : CompactSpace ↥A :=
        IsNonarchimedeanLocalField.instCompactSpaceSubtypeMemSubringIntegerValueGroupWithZeroValuation F
      obtain ⟨L, hL⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
        T hT_anti hT_nonempty (hT_closed 0).isCompact hT_closed
      exact ⟨L, fun m => Set.mem_iInter.mp hL m⟩
    haveI : IsDiscreteValuationRing ↥A :=
      IsNonarchimedeanLocalField.instIsDiscreteValuationRingSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    haveI : IsAdicComplete I ↥A :=
      { toIsPrecomplete := h_pre
        toIsHausdorff := IsDiscreteValuationRing.instIsHausdorffMaximalIdeal ↥A }
    haveI : HenselianRing ↥A I := IsAdicComplete.henselianRing ↥A I
    intro c a hc ha h_diff
    let c₀ : ↥A := ⟨c, hc⟩
    let a₀ : ↥A := ⟨a, le_of_eq ha⟩
    let P : Polynomial ↥A := Polynomial.X ^ 2 - Polynomial.C c₀
    have hP_monic : P.Monic := Polynomial.monic_X_pow_sub_C c₀ (by decide : 2 ≠ 0)
    have hP_eval : P.eval a₀ ∈ I := by
      rw [Valuation.mem_maximalIdeal_iff]
      have h_coe : ((P.eval a₀ : ↥A) : F) = a ^ 2 - c := by
        simp only [P, a₀, c₀, Polynomial.eval_sub, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C, AddSubgroupClass.coe_sub, SubmonoidClass.coe_pow]
      rwa [h_coe]
    have hP_deriv : IsUnit ((Ideal.Quotient.mk I) (P.derivative.eval a₀)) := by
      have h_deriv_eq : P.derivative.eval a₀ = (2 : ↥A) * a₀ ^ (2 - 1) := by
        simp only [P, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
          Polynomial.derivative_C, sub_zero, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X, Nat.cast_ofNat]
      rw [h_deriv_eq]
      change IsUnit (IsLocalRing.residue ↥A ((2 : ↥A) * a₀ ^ (2 - 1)))
      rw [map_mul, map_ofNat, map_pow]
      have ha_res_ne : IsLocalRing.residue ↥A a₀ ≠ 0 := by
        rw [Ne, IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff]
        change ¬ (ValuativeRel.valuation F a < 1)
        rw [ha]
        exact lt_irrefl 1
      exact IsUnit.mk0 _ (mul_ne_zero h2_kF (pow_ne_zero (2 - 1) ha_res_ne))
    obtain ⟨z₀, hz₀_root, _⟩ := HenselianRing.is_henselian P hP_monic a₀ hP_eval hP_deriv
    refine ⟨(z₀ : F), ?_⟩
    rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hz₀_root
    exact (SubmonoidClass.coe_pow z₀ 2).symm.trans (congrArg Subtype.val hz₀_root)

  let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
  have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have h_norm : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [h_norm]
  have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · intro h0
      exact hπ_ne ((map_eq_zero_iff e_bot.symm e_bot.symm.injective).mp h0)
    · rw [h_relVal, AlgEquiv.apply_symm_apply, hπ_val, Nat.cast_one]
    · rintro k ⟨hk, _⟩
      exact hk
  have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
  have h_addVal_zero_iff : ∀ y : F, y ≠ 0 →
      (EllipticRootNumber.addVal F y = 0 ↔ ValuativeRel.valuation F y = 1) := by
    intro y hy
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy, ← map_eq_one_iff iso iso.injective]
    have hy_iso : iso (ValuativeRel.valuation F y) ≠ 0 :=
      (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hy)
    set m := WithZero.unzero hy_iso
    have hm_coe : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd m) := by
      rw [← WithZero.coe_unzero hy_iso]
      rfl
    rw [hm_coe, ← WithZero.exp_zero, WithZero.exp_inj]
    omega
  have h_addVal_nonneg : ∀ y : F,
      0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl, Valuation.map_zero]
      exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
    · unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_le_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
      omega

  let d_F : F := e_bot (d : (⊥ : IntermediateField F (AlgebraicClosure F)))
  have hd_F_ne : d_F ≠ 0 := (map_ne_zero e_bot).mpr (Units.ne_zero d)
  have hd_F_val : ValuativeRel.valuation F d_F = 1 :=
    (h_addVal_zero_iff d_F hd_F_ne).mp (by rw [← h_valL]; exact hd_val)
  have hd_sub_ne : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2 ≠ 0 := by
    intro a hsub
    have hda : (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = a ^ 2 := sub_eq_zero.mp hsub
    have hu_a : (u : H) ^ 2 = (IntermediateField.inclusion h a) ^ 2 := by
      rw [hu_sq, hda, map_pow]
    have h_zero_one : (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp hu_a with hu_eq | hu_eq
      · have hp : ((0 : (⊥ : IntermediateField F (AlgebraicClosure F))),
            (1 : (⊥ : IntermediateField F (AlgebraicClosure F)))) = (a, 0) :=
          (h_coord (u : H)).unique (by simp) (by rw [hu_eq]; simp)
        exact (Prod.ext_iff.mp hp).2.symm
      · have hp : ((0 : (⊥ : IntermediateField F (AlgebraicClosure F))),
            (1 : (⊥ : IntermediateField F (AlgebraicClosure F)))) = (-a, 0) :=
          (h_coord (u : H)).unique (by simp) (by rw [hu_eq, map_neg]; simp)
        exact (Prod.ext_iff.mp hp).2.symm
    exact zero_ne_one h_zero_one
  have hd_nonsq_val : ∀ y : F, ValuativeRel.valuation F y ≤ 1 →
      ValuativeRel.valuation F (d_F - y ^ 2) = 1 := by
    intro y hy
    let a : (⊥ : IntermediateField F (AlgebraicClosure F)) := e_bot.symm y
    have ha_val : 0 ≤ EllipticRootNumber.valL F ⊥ a := by
      rw [h_valL, e_bot.apply_symm_apply, h_addVal_nonneg]
      exact hy
    have h_val0 := hd_nonsq a ha_val
    have h_ne : e_bot ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) ≠ 0 :=
      (map_ne_zero e_bot).mpr (hd_sub_ne a)
    rw [h_valL, h_addVal_zero_iff _ h_ne, map_sub, map_pow, e_bot.apply_symm_apply] at h_val0
    exact h_val0

  let d_A : ↥A := ⟨d_F, le_of_eq hd_F_val⟩
  let d_bar : kF := IsLocalRing.residue ↥A d_A
  have hd_nonsq_bar : ∀ r : kF, r ^ 2 ≠ d_bar := by
    intro r hr
    obtain ⟨y_A, rfl⟩ := IsLocalRing.residue_surjective (R := ↥A) r
    have h_res0 : IsLocalRing.residue ↥A (d_A - y_A ^ 2) = 0 := by
      rw [map_sub, map_pow]
      change d_bar - (IsLocalRing.residue ↥A y_A) ^ 2 = 0
      rw [hr, sub_self]
    rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff] at h_res0
    change ValuativeRel.valuation F (d_F - (y_A : F) ^ 2) < 1 at h_res0
    rw [hd_nonsq_val (y_A : F) y_A.2] at h_res0
    exact lt_irrefl 1 h_res0
  have hd_bar_ne : d_bar ≠ 0 := by
    intro h0
    have := hd_nonsq_bar 0
    rw [h0, zero_pow (by decide : 2 ≠ 0)] at this
    exact this rfl
  let u_d : kFˣ := Units.mk0 d_bar hd_bar_ne
  obtain ⟨g, hg_gen⟩ := IsCyclic.exists_monoid_generator (α := kFˣ)
  have hq_gt1 : 1 < EllipticRootNumber.q F := Finite.one_lt_card
  have hg_ord : orderOf g = EllipticRootNumber.q F - 1 := by
    rw [orderOf_eq_card_of_forall_mem_powers hg_gen, Nat.card_units]
    rfl
  have h_solve : ∀ (α_F : F) (hα_val : ValuativeRel.valuation F α_F = 1),
      (∀ r : kF, r ^ 2 ≠ IsLocalRing.residue ↥A ⟨α_F, le_of_eq hα_val⟩) →
      ∃ c_F : F, c_F ^ 2 * d_F = α_F := by
    intro α_F hα_val hα_nonsq
    let α_A : ↥A := ⟨α_F, le_of_eq hα_val⟩
    let α_bar : kF := IsLocalRing.residue ↥A α_A
    have hα_bar_ne : α_bar ≠ 0 := by
      intro h0
      have := hα_nonsq 0
      change (0 : kF) ^ 2 ≠ α_bar at this
      rw [h0, zero_pow (by decide : 2 ≠ 0)] at this
      exact this rfl
    let u_α : kFˣ := Units.mk0 α_bar hα_bar_ne
    obtain ⟨k₁, hk₁⟩ := hg_gen u_α
    change g ^ k₁ = u_α at hk₁
    obtain ⟨k₂, hk₂⟩ := hg_gen u_d⁻¹
    change g ^ k₂ = u_d⁻¹ at hk₂
    have hk₁_odd : ¬ (2 ∣ k₁) := by
      rintro ⟨m, rfl⟩
      have h_sq : ((g ^ m : kFˣ) : kF) ^ 2 = α_bar := by
        rw [← Units.val_pow_eq_pow_val, ← pow_mul, mul_comm m 2, hk₁]
        rfl
      exact hα_nonsq _ h_sq
    have hk₂_odd : ¬ (2 ∣ k₂) := by
      rintro ⟨m, rfl⟩
      have h_inv_sq : ((g ^ m)⁻¹) ^ 2 = u_d := by
        rw [inv_pow, ← pow_mul, mul_comm m 2, hk₂, inv_inv]
      have h_sq : (((g ^ m)⁻¹ : kFˣ) : kF) ^ 2 = d_bar := by
        rw [← Units.val_pow_eq_pow_val, h_inv_sq]
        rfl
      exact hd_nonsq_bar _ h_sq
    set s := (k₁ + k₂) / 2
    have hs_mul : 2 * s = k₁ + k₂ := by omega
    have h_unit_eq : (g ^ s) ^ 2 * u_d = u_α := by
      rw [← pow_mul, mul_comm s 2, hs_mul, pow_add, hk₁, hk₂, inv_mul_cancel_right]
    have h_bar_eq : ((g ^ s : kFˣ) : kF) ^ 2 * d_bar = α_bar := by
      have := congrArg Units.val h_unit_eq
      rwa [Units.val_mul, Units.val_pow_eq_pow_val] at this
    obtain ⟨x₀, hx₀⟩ := ValuationSubring.surjective_unitGroupToResidueFieldUnits A (g ^ s)
    let a : F := ((x₀ : Fˣ) : F)
    let a₀ : ↥A := A.unitGroupMulEquiv x₀
    have ha_val : ValuativeRel.valuation F a = 1 :=
      (Valuation.mem_unitGroup_iff F (ValuativeRel.valuation F) (x₀ : Fˣ)).mp x₀.2
    have ha₀_res : IsLocalRing.residue ↥A a₀ = ((g ^ s : kFˣ) : kF) := by
      rw [← hx₀]
      exact (ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A x₀).symm
    let c : F := α_F * d_F⁻¹
    have hc_val : ValuativeRel.valuation F c = 1 := by
      dsimp [c]
      rw [map_mul, map_inv₀, hα_val, hd_F_val, inv_one, mul_one]
    let c₀ : ↥A := ⟨c, le_of_eq hc_val⟩
    have hc₀_mul : c₀ * d_A = α_A := by
      apply Subtype.ext
      change (α_F * d_F⁻¹) * d_F = α_F
      exact inv_mul_cancel_right₀ hd_F_ne α_F
    have hc₀_res_mul : IsLocalRing.residue ↥A c₀ * d_bar = α_bar := by
      change IsLocalRing.residue ↥A c₀ * IsLocalRing.residue ↥A d_A = IsLocalRing.residue ↥A α_A
      rw [← map_mul, hc₀_mul]
    have ha₀_res_sq : IsLocalRing.residue ↥A (a₀ ^ 2) = IsLocalRing.residue ↥A c₀ := by
      apply mul_right_cancel₀ hd_bar_ne
      rw [map_pow, ha₀_res, h_bar_eq, hc₀_res_mul]
    have h_diff_mem : a₀ ^ 2 - c₀ ∈ I := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ha₀_res_sq, sub_self]
    have h_diff_lt : ValuativeRel.valuation F (a ^ 2 - c) < 1 := by
      rw [Valuation.mem_maximalIdeal_iff] at h_diff_mem
      have h_coe : (((a₀ ^ 2 - c₀ : ↥A) : F)) = a ^ 2 - c := by
        rw [AddSubgroupClass.coe_sub, SubmonoidClass.coe_pow,
          ValuationSubring.coe_unitGroupMulEquiv_apply]
      rwa [h_coe] at h_diff_mem
    obtain ⟨c_F, hc_F⟩ := h_hensel_sq c a (le_of_eq hc_val) ha_val h_diff_lt
    refine ⟨c_F, ?_⟩
    rw [hc_F]
    exact inv_mul_cancel_right₀ hd_F_ne α_F

  have h_c4 : ¬ (4 ∣ (EllipticRootNumber.q F - 1)) → ∃ c_F : F, c_F ^ 2 * d_F = -1 := by
    intro h4
    have h_val_neg1 : ValuativeRel.valuation F (-1 : F) = 1 := by
      rw [Valuation.map_neg, Valuation.map_one]
    apply h_solve (-1) h_val_neg1
    intro r hr
    have hr' : r ^ 2 = -1 := by
      have h_res_neg1 : IsLocalRing.residue ↥A (⟨-1, le_of_eq h_val_neg1⟩ : ↥A) = -1 := by
        change IsLocalRing.residue ↥A (-1 : ↥A) = -1
        rw [map_neg, map_one]
      rwa [h_res_neg1] at hr
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [zero_pow (by decide : 2 ≠ 0)] at hr'
      exact one_ne_zero (neg_eq_zero.mp hr'.symm)
    let u_r : kFˣ := Units.mk0 r hr_ne
    have hur_sq : ((u_r ^ 2 : kFˣ) : kF) = -1 := by
      rw [Units.val_pow_eq_pow_val]
      exact hr'
    obtain ⟨t, ht⟩ := hg_gen u_r
    change g ^ t = u_r at ht
    set m₁ := (EllipticRootNumber.q F - 1) / 2
    have hm₁_mul : 2 * m₁ = EllipticRootNumber.q F - 1 := by omega
    have hm₁_odd : m₁ = 2 * (m₁ / 2) + 1 := by omega
    have hur_pow : u_r ^ (EllipticRootNumber.q F - 1) = 1 := by
      rw [← ht, ← pow_mul, mul_comm t, ← hg_ord, pow_mul, pow_orderOf_eq_one, one_pow]
    have hur_m1 : (u_r ^ 2) ^ m₁ = 1 := by
      rw [← pow_mul, hm₁_mul, hur_pow]
    have h_neg1_pow : (-1 : kF) ^ m₁ = 1 := by
      rw [← hur_sq, ← Units.val_pow_eq_pow_val, hur_m1, Units.val_one]
    have h_neg1_eq : (-1 : kF) ^ m₁ = -1 := by
      rw [hm₁_odd, pow_add, pow_mul, neg_one_sq, one_pow, one_mul, pow_one]
    have h_eq1 : (-1 : kF) = 1 := h_neg1_eq.symm.trans h_neg1_pow
    exact h2_kF (by linear_combination -h_eq1)

  have h_c36 : ¬ (3 ∣ (EllipticRootNumber.q F - 1)) → ∃ c_F : F, c_F ^ 2 * d_F = -3 := by
    intro h3
    have h_val_neg3 : ValuativeRel.valuation F (-3 : F) = 1 := by
      have h_le : ValuativeRel.valuation F (-3 : F) ≤ 1 := ((-3 : ↥A)).2
      rcases lt_or_eq_of_le h_le with h_lt | h_eq
      · exfalso
        have h_mem : (-3 : ↥A) ∈ I := (Valuation.mem_maximalIdeal_iff _ _).mpr h_lt
        have h_res0 : IsLocalRing.residue ↥A (-3 : ↥A) = 0 :=
          (IsLocalRing.residue_eq_zero_iff _).mpr h_mem
        rw [map_neg, map_ofNat, neg_eq_zero] at h_res0
        exact h3_kF h_res0
      · exact h_eq
    apply h_solve (-3) h_val_neg3
    intro r hr
    have hr' : r ^ 2 = -3 := by
      have h_res_neg3 : IsLocalRing.residue ↥A (⟨-3, le_of_eq h_val_neg3⟩ : ↥A) = -3 := by
        change IsLocalRing.residue ↥A (-3 : ↥A) = -3
        rw [map_neg, map_ofNat]
      rwa [h_res_neg3] at hr
    let w : kF := (r - 1) / 2
    have h2w : 2 * w + 1 = r := by
      dsimp [w]
      rw [mul_div_cancel₀ _ h2_kF, sub_add_cancel]
    have h4_cyc : (2 : kF) * 2 * (w ^ 2 + w + 1) = 0 := by
      linear_combination (2 * w + 1 + r) * h2w + hr'
    have hw_cyc : w ^ 2 + w + 1 = 0 :=
      (mul_eq_zero.mp h4_cyc).resolve_left (mul_ne_zero h2_kF h2_kF)
    have hw3 : w ^ 3 = 1 := by
      linear_combination (w - 1) * hw_cyc
    have hw_ne0 : w ≠ 0 := by
      intro hw0
      rw [hw0, zero_pow (by decide : 3 ≠ 0)] at hw3
      exact zero_ne_one hw3
    have hw_ne1 : w ≠ 1 := by
      intro hw1
      exact h3_kF (by linear_combination hw_cyc - (w + 2) * hw1)
    let u_w : kFˣ := Units.mk0 w hw_ne0
    have huw3 : u_w ^ 3 = 1 := Units.ext (by rw [Units.val_pow_eq_pow_val]; exact hw3)
    have huw_ne1 : u_w ≠ 1 := fun h1 => hw_ne1 (congrArg Units.val h1)
    have h_ord_dvd3 : orderOf u_w ∣ 3 := orderOf_dvd_of_pow_eq_one huw3
    have h_ord3 : orderOf u_w = 3 := by
      rcases (Nat.dvd_prime Nat.prime_three).mp h_ord_dvd3 with h1 | h3_eq
      · exact absurd (orderOf_eq_one_iff.mp h1) huw_ne1
      · exact h3_eq
    obtain ⟨t, ht⟩ := hg_gen u_w
    change g ^ t = u_w at ht
    have huw_pow_q1 : u_w ^ (EllipticRootNumber.q F - 1) = 1 := by
      rw [← ht, ← pow_mul, mul_comm t, ← hg_ord, pow_mul, pow_orderOf_eq_one, one_pow]
    have h3_dvd : 3 ∣ (EllipticRootNumber.q F - 1) := by
      rw [← h_ord3]
      exact orderOf_dvd_of_pow_eq_one huw_pow_q1
    exact h3 h3_dvd

  have h2_bar : (2 : AlgebraicClosure F) ≠ 0 := by
    have := (map_ne_zero_iff (algebraMap F (AlgebraicClosure F))
      (RingHom.injective (algebraMap F (AlgebraicClosure F)))).mpr h2_F
    rwa [map_ofNat] at this
  have h3_bar : (3 : AlgebraicClosure F) ≠ 0 := by
    have := (map_ne_zero_iff (algebraMap F (AlgebraicClosure F))
      (RingHom.injective (algebraMap F (AlgebraicClosure F)))).mpr h3_F
    rwa [map_ofNat] at this
  have h_coe_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (x : AlgebraicClosure F) = algebraMap F (AlgebraicClosure F) (e_bot x) := by
    intro x
    conv_lhs => rw [← e_bot.symm_apply_apply x]
    rfl
  let u₀ : AlgebraicClosure F := ((u : H) : AlgebraicClosure F)
  have hu₀_sq : u₀ ^ 2 = algebraMap F (AlgebraicClosure F) d_F := by
    have h_val := congrArg Subtype.val hu_sq
    change u₀ ^ 2 = ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) : AlgebraicClosure F) at h_val
    rwa [h_coe_bot] at h_val
  have hσ_u₀ : ∀ σ : EllipticRootNumber.AbsGal F,
      ¬ (σ ∈ H.fixingSubgroup) → σ u₀ = -u₀ := by
    intro σ hσ
    have h_sq : (σ u₀) ^ 2 = u₀ ^ 2 := by
      rw [← map_pow, hu₀_sq, AlgEquiv.commutes]
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp h_sq with h_fix | h_neg
    · exfalso
      apply hσ
      intro y
      obtain ⟨⟨a, b⟩, hy⟩ := (h_coord y).exists
      have hy_val : (y : AlgebraicClosure F) =
          algebraMap F (AlgebraicClosure F) (e_bot a) +
            algebraMap F (AlgebraicClosure F) (e_bot b) * u₀ := by
        have h_val := congrArg Subtype.val hy
        change (y : AlgebraicClosure F) =
          (a : AlgebraicClosure F) + (b : AlgebraicClosure F) * u₀ at h_val
        rwa [h_coe_bot a, h_coe_bot b] at h_val
      change σ (y : AlgebraicClosure F) = (y : AlgebraicClosure F)
      rw [hy_val, map_add, map_mul, AlgEquiv.commutes, AlgEquiv.commutes, h_fix]
    · exact h_neg

  have h2_mem_H : (2 : AlgebraicClosure F) ∈ H := by
    rw [show (2 : AlgebraicClosure F) = 1 + 1 by ring]
    exact H.add_mem H.one_mem H.one_mem
  have h_ext_zeta : ∀ (e : ℕ) (c_F : F),
      ((e = 4 ∧ c_F ^ 2 * d_F = -1) ∨ ((e = 3 ∨ e = 6) ∧ c_F ^ 2 * d_F = -3)) →
      ∃ ζ : AlgebraicClosure F,
        ζ ∈ H ∧
        ζ ^ e = 1 ∧
        (∀ k : ℕ, k ∣ e → k < e → ζ ^ k ≠ 1) ∧
        (∀ σ : EllipticRootNumber.AbsGal F,
          ¬ (σ ∈ H.fixingSubgroup) → σ ζ * ζ = 1) := by
    intro e c_F h_cases
    let v_H : H := IntermediateField.inclusion h (e_bot.symm c_F) * (u : H)
    let v : AlgebraicClosure F := (v_H : AlgebraicClosure F)
    have hv_mem : v ∈ H := v_H.2
    have hv_def : v = algebraMap F (AlgebraicClosure F) c_F * u₀ := rfl
    have hv_sq_gen : v ^ 2 = algebraMap F (AlgebraicClosure F) (c_F ^ 2 * d_F) := by
      rw [hv_def, mul_pow, hu₀_sq, ← map_pow, ← map_mul]
    have hσ_v : ∀ σ : EllipticRootNumber.AbsGal F,
        ¬ (σ ∈ H.fixingSubgroup) → σ v = -v := by
      intro σ hσ
      rw [hv_def, map_mul, AlgEquiv.commutes, hσ_u₀ σ hσ, mul_neg]
    rcases h_cases with ⟨rfl, hc_F⟩ | ⟨he36, hc_F⟩
    · have hv_sq : v ^ 2 = -1 := by
        rw [hv_sq_gen, hc_F, map_neg, map_one]
      refine ⟨v, hv_mem, ?_, ?_, ?_⟩
      · linear_combination (v ^ 2 - 1) * hv_sq
      · intro k hk_dvd hk_lt h_eq
        have hk_pos : 0 < k := Nat.pos_of_dvd_of_pos hk_dvd (by decide)
        have hk_cases : k = 1 ∨ k = 2 := by
          revert hk_dvd
          interval_cases k <;> decide
        rcases hk_cases with rfl | rfl
        · exact h2_bar (by linear_combination hv_sq - (v + 1) * h_eq)
        · exact h2_bar (by linear_combination hv_sq - h_eq)
      · intro σ hσ
        rw [hσ_v σ hσ]
        linear_combination -hv_sq
    · have hv_sq : v ^ 2 = -3 := by
        rw [hv_sq_gen, hc_F, map_neg, map_ofNat]
      rcases he36 with rfl | rfl
      · let ζ : AlgebraicClosure F := (-1 + v) / 2
        have hζ_mem : ζ ∈ H :=
          H.div_mem (H.add_mem (H.neg_mem H.one_mem) hv_mem) h2_mem_H
        have h2ζ : 2 * ζ = -1 + v := mul_div_cancel₀ _ h2_bar
        have h4_cyc : (2 : AlgebraicClosure F) * 2 * (ζ ^ 2 + ζ + 1) = 0 := by
          linear_combination (2 * ζ + 1 + v) * h2ζ + hv_sq
        have hζ_cyc : ζ ^ 2 + ζ + 1 = 0 :=
          (mul_eq_zero.mp h4_cyc).resolve_left (mul_ne_zero h2_bar h2_bar)
        refine ⟨ζ, hζ_mem, ?_, ?_, ?_⟩
        · linear_combination (ζ - 1) * hζ_cyc
        · intro k hk_dvd hk_lt h_eq
          have hk_pos : 0 < k := Nat.pos_of_dvd_of_pos hk_dvd (by decide)
          have hk1 : k = 1 := by
            revert hk_dvd
            interval_cases k <;> decide
          subst hk1
          exact h3_bar (by linear_combination hζ_cyc - (ζ + 2) * h_eq)
        · intro σ hσ
          have h2σζ : 2 * σ ζ = -1 - v := by
            have h_ap := congrArg σ h2ζ
            rw [map_mul, map_ofNat, map_add, map_neg, map_one, hσ_v σ hσ, ← sub_eq_add_neg] at h_ap
            exact h_ap
          have h4_inv : (2 : AlgebraicClosure F) * 2 * (σ ζ * ζ - 1) = 0 := by
            linear_combination (2 * σ ζ) * h2ζ + (-1 + v) * h2σζ - hv_sq
          exact sub_eq_zero.mp ((mul_eq_zero.mp h4_inv).resolve_left (mul_ne_zero h2_bar h2_bar))
      · let ζ : AlgebraicClosure F := (1 + v) / 2
        have hζ_mem : ζ ∈ H :=
          H.div_mem (H.add_mem H.one_mem hv_mem) h2_mem_H
        have h2ζ : 2 * ζ = 1 + v := mul_div_cancel₀ _ h2_bar
        have h4_cyc : (2 : AlgebraicClosure F) * 2 * (ζ ^ 2 - ζ + 1) = 0 := by
          linear_combination (2 * ζ - 1 + v) * h2ζ + hv_sq
        have hζ_cyc : ζ ^ 2 - ζ + 1 = 0 :=
          (mul_eq_zero.mp h4_cyc).resolve_left (mul_ne_zero h2_bar h2_bar)
        have hζ3 : ζ ^ 3 = -1 := by
          linear_combination (ζ + 1) * hζ_cyc
        refine ⟨ζ, hζ_mem, ?_, ?_, ?_⟩
        · linear_combination (ζ ^ 3 - 1) * hζ3
        · intro k hk_dvd hk_lt h_eq
          have hk_pos : 0 < k := Nat.pos_of_dvd_of_pos hk_dvd (by decide)
          have hk_cases : k = 1 ∨ k = 2 ∨ k = 3 := by
            revert hk_dvd
            interval_cases k <;> decide
          rcases hk_cases with rfl | rfl | rfl
          · exact h2_bar (by linear_combination hζ3 - (ζ ^ 2 + ζ + 1) * h_eq)
          · exact h3_bar (by linear_combination (ζ + 2) * hζ_cyc - (ζ + 1) * h_eq)
          · exact h2_bar (by linear_combination hζ3 - h_eq)
        · intro σ hσ
          have h2σζ : 2 * σ ζ = 1 - v := by
            have h_ap := congrArg σ h2ζ
            rw [map_mul, map_ofNat, map_add, map_one, hσ_v σ hσ, ← sub_eq_add_neg] at h_ap
            exact h_ap
          have h4_inv : (2 : AlgebraicClosure F) * 2 * (σ ζ * ζ - 1) = 0 := by
            linear_combination (2 * σ ζ) * h2ζ + (1 + v) * h2σζ - hv_sq
          exact sub_eq_zero.mp ((mul_eq_zero.mp h4_inv).resolve_left (mul_ne_zero h2_bar h2_bar))

  have h2_dvd_q_sub_one : 2 ∣ (EllipticRootNumber.q F - 1) := by omega
  have hn_ne_6 : n ≠ 6 := by
    rintro rfl
    exact hdi h2_dvd_q_sub_one
  set e : ℕ := 12 / Nat.gcd n 12
  have he : e = 3 ∨ e = 4 ∨ e = 6 := by
    change 12 / Nat.gcd n 12 = 3 ∨ 12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6
    revert hn23 hn_ne_6
    interval_cases n <;> decide

  rcases he with he3 | he4 | he6
  · have hndvd3 : ¬ (3 ∣ (EllipticRootNumber.q F - 1)) := by rwa [← he3]
    obtain ⟨c_F, hc_F⟩ := h_c36 hndvd3
    obtain ⟨ζ, hζ_mem, hζ_pow, hζ_ord, hζ_gal⟩ := h_ext_zeta e c_F (Or.inr ⟨Or.inl he3, hc_F⟩)
    exact ⟨π, ζ, hπ_ne, hπ_val, hζ_mem, hζ_pow, hζ_ord, hζ_gal⟩
  · have hndvd4 : ¬ (4 ∣ (EllipticRootNumber.q F - 1)) := by rwa [← he4]
    obtain ⟨c_F, hc_F⟩ := h_c4 hndvd4
    obtain ⟨ζ, hζ_mem, hζ_pow, hζ_ord, hζ_gal⟩ := h_ext_zeta e c_F (Or.inl ⟨he4, hc_F⟩)
    exact ⟨π, ζ, hπ_ne, hπ_val, hζ_mem, hζ_pow, hζ_ord, hζ_gal⟩
  · have hndvd3 : ¬ (3 ∣ (EllipticRootNumber.q F - 1)) := by
      intro h3
      apply hdi
      rw [he6]
      omega
    obtain ⟨c_F, hc_F⟩ := h_c36 hndvd3
    obtain ⟨ζ, hζ_mem, hζ_pow, hζ_ord, hζ_gal⟩ := h_ext_zeta e c_F (Or.inr ⟨Or.inr he6, hc_F⟩)
    exact ⟨π, ζ, hπ_ne, hπ_val, hζ_mem, hζ_pow, hζ_ord, hζ_gal⟩

theorem quadratic_unitGroup_one_pow_surjective (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b))) :
    ∀ u₁ ∈ EllipticRootNumber.unitGroup F H 1,
      ∃ z : H, z ^ (12 / Nat.gcd n 12) = (u₁ : H) :=
by
  classical
  
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ, OrderMonoidIso.apply_symm_apply]
  have hπ_ne : π ≠ 0 := by
    rintro rfl
    rw [Valuation.map_zero, map_zero] at hπ_iso
    exact WithZero.exp_ne_zero hπ_iso.symm
  have hπ_lt1 : ValuativeRel.valuation F π < 1 := by
    rw [← map_lt_map_iff iso, hπ_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have hπ_val : EllipticRootNumber.addVal F π = 1 := by
    unfold EllipticRootNumber.addVal
    rw [dif_neg hπ_ne]
    have h_unzero : WithZero.unzero (x := iso (ValuativeRel.valuation F π))
        (by rw [hπ_iso]; exact WithZero.exp_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      simp only [hπ_iso, WithZero.exp, WithZero.unzero_coe]
    rw [h_unzero, toAdd_ofAdd]
    norm_num

  have hp_info : (EllipticRootNumber.p F).Prime ∧ EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
    let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
    letI : Fintype kF := Fintype.ofFinite kF
    obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
    refine ⟨hp_prime, ?_⟩
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hcard_eq]
    exact dvd_pow_self (ringChar kF) k_card.ne_zero
  obtain ⟨hp_prime', hp_dvd_q⟩ := hp_info
  have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
    rintro h; rw [h] at hp_dvd_q; exact hq2 hp_dvd_q
  have hp_ne3 : EllipticRootNumber.p F ≠ 3 := by
    rintro h; rw [h] at hp_dvd_q; exact hq3 hp_dvd_q

  set e := 12 / Nat.gcd n 12
  have he_cases : e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 6 := by
    change 12 / Nat.gcd n 12 = 2 ∨ 12 / Nat.gcd n 12 = 3 ∨
      12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6
    interval_cases n <;> first | decide | omega
  have he_pos : 0 < e := by
    rcases he_cases with h | h | h | h <;> omega
  have he_ndvd : ¬ (EllipticRootNumber.p F ∣ e) := by
    intro hdvd
    rcases he_cases with h | h | h | h
    · rw [h, Nat.dvd_prime Nat.prime_two] at hdvd
      rcases hdvd with h1 | h2
      · exact hp_prime'.ne_one h1
      · exact hp_ne2 h2
    · rw [h, Nat.dvd_prime Nat.prime_three] at hdvd
      rcases hdvd with h1 | h3
      · exact hp_prime'.ne_one h1
      · exact hp_ne3 h3
    · have hdvd2 : EllipticRootNumber.p F ∣ 2 ^ 2 := by rwa [h] at hdvd
      have hdvd' := hp_prime'.dvd_of_dvd_pow hdvd2
      rw [Nat.dvd_prime Nat.prime_two] at hdvd'
      rcases hdvd' with h1 | h2
      · exact hp_prime'.ne_one h1
      · exact hp_ne2 h2
    · have hdvd6 : EllipticRootNumber.p F ∣ 2 * 3 := by rwa [h] at hdvd
      rcases hp_prime'.dvd_mul.mp hdvd6 with hdvd2 | hdvd3
      · rw [Nat.dvd_prime Nat.prime_two] at hdvd2
        rcases hdvd2 with h1 | h2
        · exact hp_prime'.ne_one h1
        · exact hp_ne2 h2
      · rw [Nat.dvd_prime Nat.prime_three] at hdvd3
        rcases hdvd3 with h1 | h3
        · exact hp_prime'.ne_one h1
        · exact hp_ne3 h3

  let A := (ValuativeRel.valuation F).valuationSubring
  let I := IsLocalRing.maximalIdeal ↥A
  let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
  have he_res_ne : (e : kF) ≠ 0 := by
    haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
    exact (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) e).not.mpr he_ndvd
  have he_unit_A : IsUnit (e : ↥A) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
    change IsLocalRing.residue ↥A (e : ↥A) ≠ 0
    rw [map_natCast]
    exact he_res_ne

  
  let π₀ : ↥A := ⟨π, le_of_lt hπ_lt1⟩
  have h_lt1_iff_le_π : ∀ y : F,
      ValuativeRel.valuation F y < 1 ↔
        ValuativeRel.valuation F y ≤ ValuativeRel.valuation F π := by
    intro y
    rw [← map_lt_map_iff iso, ← map_le_map_iff iso, hπ_iso, map_one]
    rcases hy : iso (ValuativeRel.valuation F y) with _ | m
    · change (0 : WithZero (Multiplicative ℤ)) < 1 ↔
        (0 : WithZero (Multiplicative ℤ)) ≤ WithZero.exp (-1 : ℤ)
      exact ⟨fun _ => zero_le', fun _ => WithZero.zero_lt_coe _⟩
    · change WithZero.exp (Multiplicative.toAdd m) < WithZero.exp (0 : ℤ) ↔
        WithZero.exp (Multiplicative.toAdd m) ≤ WithZero.exp (-1 : ℤ)
      rw [WithZero.exp_lt_exp, WithZero.exp_le_exp]
      omega
  have hI_span : I = Ideal.span {π₀} := by
    ext x
    rw [Valuation.mem_maximalIdeal_iff, Ideal.mem_span_singleton,
      Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F))]
    exact h_lt1_iff_le_π (x : F)
  have hIm_mem : ∀ (m : ℕ) (x : ↥A),
      x ∈ I ^ m ↔ ValuativeRel.valuation F (x : F) ≤ (ValuativeRel.valuation F π) ^ m := by
    intro m x
    rw [hI_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
      Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F)),
      map_pow, map_pow]
    rfl
  have h_pre_A : IsPrecomplete (Ideal.span {π₀}) ↥A := by
    rw [← hI_span]
    refine IsPrecomplete.mk fun f hf => ?_
    let T : ℕ → Set ↥A := fun m => {x : ↥A | f m ≡ x [SMOD I ^ m • (⊤ : Submodule ↥A ↥A)]}
    have hT_anti : ∀ m : ℕ, T (m + 1) ⊆ T m := by
      intro m x hx
      have h_le : I ^ (m + 1) • (⊤ : Submodule ↥A ↥A) ≤ I ^ m • (⊤ : Submodule ↥A ↥A) := by
        rw [smul_eq_mul, Ideal.mul_top, smul_eq_mul, Ideal.mul_top]
        exact Ideal.pow_le_pow_right (Nat.le_succ m)
      exact (hf (Nat.le_succ m)).trans (hx.mono h_le)
    have hT_nonempty : ∀ m : ℕ, (T m).Nonempty := fun m => ⟨f m, SModEq.refl (f m)⟩
    have hT_closed : ∀ m : ℕ, IsClosed (T m) := by
      intro m
      have h_eq : T m = (fun x : ↥A => (f m : F) - (x : F)) ⁻¹'
          {y : F | ValuativeRel.valuation F y ≤ (ValuativeRel.valuation F π) ^ m} := by
        ext x
        simp only [T, Set.mem_setOf_eq, Set.mem_preimage]
        rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, hIm_mem m (f m - x), AddSubgroupClass.coe_sub]
      rw [h_eq]
      exact (IsValuativeTopology.isClosed_closedBall _).preimage
        (continuous_const.sub continuous_subtype_val)
    haveI : CompactSpace ↥A :=
      IsNonarchimedeanLocalField.instCompactSpaceSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    obtain ⟨L, hL⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
      T hT_anti hT_nonempty (hT_closed 0).isCompact hT_closed
    exact ⟨L, fun m => Set.mem_iInter.mp hL m⟩
  haveI : IsDiscreteValuationRing ↥A :=
    IsNonarchimedeanLocalField.instIsDiscreteValuationRingSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  have h_haus_A : IsHausdorff (Ideal.span {π₀}) ↥A := by
    rw [← hI_span]
    exact IsDiscreteValuationRing.instIsHausdorffMaximalIdeal ↥A

  let e_bot : (⊥ : IntermediateField F (AlgebraicClosure F)) ≃ₐ[F] F :=
    IntermediateField.botEquiv F (AlgebraicClosure F)
  have h_relVal_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have hnorm : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [hnorm]
  have h_resDeg_bot : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨Nat.one_pos, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · exact (map_ne_zero e_bot.symm).mpr hπ_ne
    · rw [h_relVal_bot, AlgEquiv.apply_symm_apply, hπ_val, Nat.cast_one]
    · rintro k ⟨hk, _⟩
      exact hk
  have h_valL_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_resDeg_bot, Nat.cast_one, Int.ediv_one, h_relVal_bot]
  have h_addVal_nonneg : ∀ y : F,
      0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl, Valuation.map_zero]
      exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
    · unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_le_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
      omega
  have h_addVal_pos : ∀ y : F,
      (y = 0 ∨ 1 ≤ EllipticRootNumber.addVal F y) ↔ ValuativeRel.valuation F y < 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      rw [Valuation.map_zero]
      exact ⟨fun _ => zero_lt_one, fun _ => Or.inl rfl⟩
    · rw [or_iff_right hy]
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set z := WithZero.unzero hiso_ne
      have hz_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd z) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_lt_map_iff iso, hz_eq, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
      omega
  have h_bot_le : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ x ↔ ValuativeRel.valuation F (e_bot x) ≤ 1 := by
    intro x
    rw [h_valL_bot x, h_addVal_nonneg]
  have h_bot_lt : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (x = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ x) ↔ ValuativeRel.valuation F (e_bot x) < 1 := by
    intro x
    rw [h_valL_bot x, ← map_eq_zero e_bot, h_addVal_pos]

  
  have hd_le : ValuativeRel.valuation F (e_bot (d : (⊥ : IntermediateField F (AlgebraicClosure F)))) ≤ 1 :=
    (h_bot_le (d : (⊥ : IntermediateField F (AlgebraicClosure F)))).mp (by omega)
  let d_F : F := e_bot (d : (⊥ : IntermediateField F (AlgebraicClosure F)))
  let d_A : ↥A := ⟨d_F, hd_le⟩
  let R_A := QuadraticAlgebra ↥A d_A 0
  let π_R : R_A := ⟨π₀, 0⟩
  let J : Ideal R_A := Ideal.span {π_R}
  let I₀ : Ideal ↥A := Ideal.span {π₀}

  have h_πR_pow : ∀ m : ℕ, π_R ^ m = ⟨π₀ ^ m, 0⟩ := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero, pow_zero]
      rfl
    | succ m ih =>
      rw [pow_succ, ih, pow_succ]
      refine QuadraticAlgebra.ext ?_ ?_
      · change π₀ ^ m * π₀ + d_A * 0 * 0 = π₀ ^ m * π₀
        ring
      · change π₀ ^ m * 0 + 0 * π₀ + 0 * 0 * 0 = 0
        ring
  have h_πR_mul : ∀ (m : ℕ) (w : R_A),
      π_R ^ m * w = ⟨π₀ ^ m * w.re, π₀ ^ m * w.im⟩ := by
    intro m w
    rw [h_πR_pow m]
    refine QuadraticAlgebra.ext ?_ ?_
    · change π₀ ^ m * w.re + d_A * 0 * w.im = π₀ ^ m * w.re
      ring
    · change π₀ ^ m * w.im + 0 * w.re + 0 * 0 * w.im = π₀ ^ m * w.im
      ring
  have h_mem_Jm : ∀ (m : ℕ) (z : R_A),
      z ∈ J ^ m ↔ z.re ∈ I₀ ^ m ∧ z.im ∈ I₀ ^ m := by
    intro m z
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton,
      Ideal.span_singleton_pow, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
    constructor
    · rintro ⟨w, rfl⟩
      rw [h_πR_mul m w]
      exact ⟨⟨w.re, rfl⟩, ⟨w.im, rfl⟩⟩
    · rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
      refine ⟨⟨a, b⟩, ?_⟩
      rw [h_πR_mul m ⟨a, b⟩]
      exact QuadraticAlgebra.ext ha hb
  have h_smod_Jm : ∀ (m : ℕ) (x y : R_A),
      (x ≡ y [SMOD J ^ m • (⊤ : Submodule R_A R_A)]) ↔
        (x.re ≡ y.re [SMOD I₀ ^ m • (⊤ : Submodule ↥A ↥A)] ∧
         x.im ≡ y.im [SMOD I₀ ^ m • (⊤ : Submodule ↥A ↥A)]) := by
    intro m x y
    have hJ_top : J ^ m • (⊤ : Submodule R_A R_A) = J ^ m := Ideal.mul_top (J ^ m)
    have hI_top : I₀ ^ m • (⊤ : Submodule ↥A ↥A) = I₀ ^ m := Ideal.mul_top (I₀ ^ m)
    rw [SModEq.sub_mem, hJ_top, SModEq.sub_mem, SModEq.sub_mem, hI_top,
      h_mem_Jm m (x - y), QuadraticAlgebra.re_sub, QuadraticAlgebra.im_sub]
  haveI : IsHausdorff I₀ ↥A := h_haus_A
  have h_haus_RA : IsHausdorff J R_A := by
    refine IsHausdorff.mk fun x hx => ?_
    have h_re : ∀ m : ℕ, x.re ≡ 0 [SMOD I₀ ^ m • (⊤ : Submodule ↥A ↥A)] :=
      fun m => ((h_smod_Jm m x 0).mp (hx m)).1
    have h_im : ∀ m : ℕ, x.im ≡ 0 [SMOD I₀ ^ m • (⊤ : Submodule ↥A ↥A)] :=
      fun m => ((h_smod_Jm m x 0).mp (hx m)).2
    exact QuadraticAlgebra.ext
      (IsHausdorff.haus' x.re h_re)
      (IsHausdorff.haus' x.im h_im)
  have h_pre_RA : IsPrecomplete J R_A := by
    refine IsPrecomplete.mk fun f hf => ?_
    have hf_re : ∀ {m n : ℕ}, m ≤ n →
        (f m).re ≡ (f n).re [SMOD I₀ ^ m • (⊤ : Submodule ↥A ↥A)] :=
      fun hmn => ((h_smod_Jm _ (f _) (f _)).mp (hf hmn)).1
    have hf_im : ∀ {m n : ℕ}, m ≤ n →
        (f m).im ≡ (f n).im [SMOD I₀ ^ m • (⊤ : Submodule ↥A ↥A)] :=
      fun hmn => ((h_smod_Jm _ (f _) (f _)).mp (hf hmn)).2
    obtain ⟨L_re, hL_re⟩ := IsPrecomplete.prec h_pre_A hf_re
    obtain ⟨L_im, hL_im⟩ := IsPrecomplete.prec h_pre_A hf_im
    refine ⟨⟨L_re, L_im⟩, fun m => ?_⟩
    exact (h_smod_Jm m (f m) ⟨L_re, L_im⟩).mpr ⟨hL_re m, hL_im m⟩
  haveI : IsAdicComplete J R_A :=
    { toIsPrecomplete := h_pre_RA
      toIsHausdorff := h_haus_RA }
  haveI : HenselianRing R_A J := IsAdicComplete.henselianRing R_A J

  have h_quad_pow : ∀ x₀ y₀ : ↥A, x₀ ∈ I → y₀ ∈ I →
      ∃ z₀ : R_A, z₀ ^ e = ⟨1 + x₀, y₀⟩ := by
    intro x₀ y₀ hx₀ hy₀
    rw [hI_span] at hx₀ hy₀
    let w₀ : R_A := ⟨1 + x₀, y₀⟩
    let P : Polynomial R_A := Polynomial.X ^ e - Polynomial.C w₀
    have hP_monic : P.Monic := Polynomial.monic_X_pow_sub_C w₀ he_pos.ne'
    have hP_eval : P.eval (1 : R_A) ∈ J := by
      have h_eval_eq : P.eval (1 : R_A) = (⟨-x₀, -y₀⟩ : R_A) := by
        simp only [P, w₀, Polynomial.eval_sub, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C, one_pow]
        refine QuadraticAlgebra.ext ?_ ?_
        · change (1 : ↥A) - (1 + x₀) = -x₀
          ring
        · change (0 : ↥A) - y₀ = -y₀
          ring
      rw [h_eval_eq, ← pow_one J, h_mem_Jm 1 ⟨-x₀, -y₀⟩, pow_one]
      exact ⟨I₀.neg_mem hx₀, I₀.neg_mem hy₀⟩
    have hP_deriv : IsUnit ((Ideal.Quotient.mk J) (P.derivative.eval (1 : R_A))) := by
      have h_deriv_eq : P.derivative.eval (1 : R_A) = (e : R_A) := by
        dsimp [P]
        rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow,
          Polynomial.derivative_C, sub_zero, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X, one_pow, mul_one]
      rw [h_deriv_eq]
      have he_alg : algebraMap ↥A R_A (e : ↥A) = (e : R_A) := map_natCast (algebraMap ↥A R_A) e
      rw [← he_alg]
      exact (he_unit_A.map (algebraMap ↥A R_A)).map (Ideal.Quotient.mk J)
    obtain ⟨z₀, hz₀_root, _⟩ := HenselianRing.is_henselian P hP_monic (1 : R_A) hP_eval hP_deriv
    refine ⟨z₀, ?_⟩
    rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hz₀_root
    exact hz₀_root

  
  let Ψ : R_A →+* H :=
    { toFun := fun z =>
        IntermediateField.inclusion h (e_bot.symm (z.re : F)) +
          IntermediateField.inclusion h (e_bot.symm (z.im : F)) * (u : H)
      map_one' := by
        change IntermediateField.inclusion h (e_bot.symm (1 : F)) +
          IntermediateField.inclusion h (e_bot.symm (0 : F)) * (u : H) = 1
        simp
      map_mul' := fun x y => by
        have h_re : ((x * y).re : F) = (x.re : F) * (y.re : F) + d_F * (x.im : F) * (y.im : F) := by
          change ((x.re * y.re + d_A * x.im * y.im : ↥A) : F) = _
          simp [d_A]
        have h_im : ((x * y).im : F) = (x.re : F) * (y.im : F) + (x.im : F) * (y.re : F) := by
          change ((x.re * y.im + x.im * y.re + 0 * x.im * y.im : ↥A) : F) = _
          simp
        have hd_eq : IntermediateField.inclusion h (e_bot.symm d_F) = (u : H) ^ 2 := by
          rw [hu_sq]
          congr 1
          exact e_bot.symm_apply_apply _
        change IntermediateField.inclusion h (e_bot.symm ((x * y).re : F)) +
          IntermediateField.inclusion h (e_bot.symm ((x * y).im : F)) * (u : H) =
          (IntermediateField.inclusion h (e_bot.symm (x.re : F)) +
            IntermediateField.inclusion h (e_bot.symm (x.im : F)) * (u : H)) *
          (IntermediateField.inclusion h (e_bot.symm (y.re : F)) +
            IntermediateField.inclusion h (e_bot.symm (y.im : F)) * (u : H))
        rw [h_re, h_im]
        simp only [map_add, map_mul, hd_eq]
        ring
      map_zero' := by
        change IntermediateField.inclusion h (e_bot.symm (0 : F)) +
          IntermediateField.inclusion h (e_bot.symm (0 : F)) * (u : H) = 0
        simp
      map_add' := fun x y => by
        change IntermediateField.inclusion h (e_bot.symm ((x.re : F) + (y.re : F))) +
          IntermediateField.inclusion h (e_bot.symm ((x.im : F) + (y.im : F))) * (u : H) = _
        simp only [map_add]
        ring }

  let S_e : Subgroup Hˣ :=
    { carrier := {v : Hˣ | ∃ z : H, z ^ e = (v : H)}
      one_mem' := ⟨1, by rw [one_pow, Units.val_one]⟩
      mul_mem' := by
        rintro v₁ v₂ ⟨z₁, hz₁⟩ ⟨z₂, hz₂⟩
        exact ⟨z₁ * z₂, by rw [mul_pow, hz₁, hz₂, Units.val_mul]⟩
      inv_mem' := by
        rintro v ⟨z, hz⟩
        exact ⟨z⁻¹, by rw [inv_pow, hz, Units.val_inv_eq_inv_val]⟩ }

  have h_le : EllipticRootNumber.unitGroup F H 1 ≤ S_e := by
    unfold EllipticRootNumber.unitGroup
    rw [Subgroup.closure_le]
    intro v hv
    simp only [Set.mem_setOf_eq, Nat.one_ne_zero, ↓reduceIte, Nat.cast_one] at hv
    rcases hv with hv1 | hv_ge
    · exact ⟨1, by rw [one_pow, hv1]⟩
    · obtain ⟨⟨a, b⟩, hab⟩ := (h_coord ((v : H) - 1)).exists
      dsimp only at hab
      have h_or : IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
          1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) :=
        Or.inr (by rwa [← hab])
      rw [(h_valL_coord a b).2, h_bot_lt a, h_bot_lt b] at h_or
      obtain ⟨ha_lt, hb_lt⟩ := h_or
      let x₀ : ↥A := ⟨e_bot a, le_of_lt ha_lt⟩
      let y₀ : ↥A := ⟨e_bot b, le_of_lt hb_lt⟩
      have hx₀ : x₀ ∈ I := (Valuation.mem_maximalIdeal_iff _ _).mpr ha_lt
      have hy₀ : y₀ ∈ I := (Valuation.mem_maximalIdeal_iff _ _).mpr hb_lt
      obtain ⟨z₀, hz₀⟩ := h_quad_pow x₀ y₀ hx₀ hy₀
      refine ⟨Ψ z₀, ?_⟩
      rw [← map_pow, hz₀]
      change IntermediateField.inclusion h (e_bot.symm (1 + e_bot a)) +
        IntermediateField.inclusion h (e_bot.symm (e_bot b)) * (u : H) = (v : H)
      rw [map_add, map_one, e_bot.symm_apply_apply, e_bot.symm_apply_apply, map_add, map_one,
        add_assoc, ← hab, add_sub_cancel]

  intro u₁ hu₁
  exact h_le hu₁

theorem dihedral_kummer_irreducible_and_inertia_aut (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (H : IntermediateField F (AlgebraicClosure F))
    (hH_unr : H ≤ EllipticRootNumber.unramifiedClosure F)
    (π : F) (ϖ ζ : AlgebraicClosure F)
    (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hζ_mem : ζ ∈ H)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (h_no_root : ∀ k : ℕ, 2 ≤ k → ∀ η : AlgebraicClosure F,
      η ∈ EllipticRootNumber.unramifiedClosure F →
      η ^ k ≠ algebraMap F (AlgebraicClosure F) π) :
    Irreducible (Polynomial.X ^ (12 / Nat.gcd n 12) - Polynomial.C (algebraMap F H π)) ∧
    ∃ τ₀ : EllipticRootNumber.relWeil F H,
      (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ζ = ζ ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ϖ = ζ * ϖ :=
by
  open ValuativeRel IntermediateField in
  have he : 12 / Nat.gcd n 12 = 2 ∨ 12 / Nat.gcd n 12 = 3 ∨
      12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6 := by
    interval_cases n <;> first | decide | omega
  set e := 12 / Nat.gcd n 12
  have he_pos : 0 < e := by rcases he with h | h | h | h <;> omega
  obtain ⟨ι, hι_sq⟩ :=
    IsAlgClosed.exists_pow_nat_eq (-1 : AlgebraicClosure F) (by decide : 0 < 2)
  have hι_pow4 : ι ^ 4 = 1 := by
    linear_combination (ι ^ 2 - 1) * hι_sq
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  obtain ⟨r, hp_prime, hcard⟩ := FiniteField.card 𝓀[F] (ringChar 𝓀[F])
  have hp : (EllipticRootNumber.p F).Prime := hp_prime
  have hq_eq : EllipticRootNumber.q F = (EllipticRootNumber.p F) ^ (r : ℕ) := by
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hcard]
  have h_not_dvd : ¬ (EllipticRootNumber.p F ∣ 4) := by
    intro hdvd
    have hdvd2 : EllipticRootNumber.p F ∣ 2 :=
      hp.dvd_of_dvd_pow (by simpa using hdvd : EllipticRootNumber.p F ∣ 2 ^ 2)
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd2 with h1 | hp2
    · exact hp.ne_one h1
    · apply hq2
      rw [hq_eq, hp2]
      exact dvd_pow_self 2 r.ne_zero
  have hι_prim : EllipticRootNumber.IsPrimeToPRootOfUnity F ι :=
    ⟨4, by decide, h_not_dvd, hι_pow4⟩
  let U := EllipticRootNumber.unramifiedClosure F
  have hι_mem : ι ∈ U :=
    IntermediateField.subset_adjoin F {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} hι_prim
  let i : ↥U := ⟨ι, hι_mem⟩
  have hi : i ^ 2 = -1 := Subtype.ext hι_sq
  let a : ↥U := algebraMap F ↥U π
  have ha_coe : algebraMap ↥U (AlgebraicClosure F) a = algebraMap F (AlgebraicClosure F) π :=
    (IsScalarTower.algebraMap_apply F ↥U (AlgebraicClosure F) π).symm
  have hϖ_pow_U : ϖ ^ e = algebraMap ↥U (AlgebraicClosure F) a := by
    rw [ha_coe]
    exact hϖ_pow
  have h_no_sq : ∀ b : ↥U, b ^ 2 ≠ a := by
    intro b hb
    apply h_no_root 2 (by decide) b.1 b.2
    have hb' := congrArg (algebraMap ↥U (AlgebraicClosure F)) hb
    simpa [map_pow, ha_coe] using hb'
  have h_no_cube : ∀ b : ↥U, b ^ 3 ≠ a := by
    intro b hb
    apply h_no_root 3 (by decide) b.1 b.2
    have hb' := congrArg (algebraMap ↥U (AlgebraicClosure F)) hb
    simpa [map_pow, ha_coe] using hb'
  have h_irr_gen : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (e : ℕ),
      (e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 6) → ∀ (a i : K), i ^ 2 = -1 →
      ∀ (ϖ : L), ϖ ^ e = algebraMap K L a →
      (∀ b : K, b ^ 2 ≠ a) → (∀ b : K, b ^ 3 ≠ a) →
      Irreducible (Polynomial.X ^ e - Polynomial.C a) := by
    clear! F n
    intro K L _ _ _ e he a i hi ϖ hϖ_pow_U h_no_sq h_no_cube
    have hP2_irr : Irreducible (Polynomial.X ^ 2 - Polynomial.C a) :=
      X_pow_sub_C_irreducible_of_prime Nat.prime_two h_no_sq
    have hP3_irr : Irreducible (Polynomial.X ^ 3 - Polynomial.C a) :=
      X_pow_sub_C_irreducible_of_prime Nat.prime_three h_no_cube
    have hP2_monic : (Polynomial.X ^ 2 - Polynomial.C a).Monic :=
      Polynomial.monic_X_pow_sub_C a (by decide)
    have hP3_monic : (Polynomial.X ^ 3 - Polynomial.C a).Monic :=
      Polynomial.monic_X_pow_sub_C a (by decide)
    have h_deg_dvd : ∀ (α : L) (Pα : Polynomial K),
        α ∈ K⟮ϖ⟯ → Pα.Monic → Irreducible Pα → Polynomial.aeval α Pα = 0 →
        IsIntegral K ϖ → Pα.natDegree ∣ (minpoly K ϖ).natDegree := by
      intro α Pα hα_mem hPα_monic hPα_irr hα_aeval hϖ_int
      have hα_int : IsIntegral K α := ⟨Pα, hPα_monic, hα_aeval⟩
      have h_mp_α : minpoly K α = Pα :=
        (minpoly.eq_of_irreducible_of_monic hPα_irr hα_aeval hPα_monic).symm
      have h_le : K⟮α⟯ ≤ K⟮ϖ⟯ := IntermediateField.adjoin_simple_le_iff.mpr hα_mem
      let E := IntermediateField.extendScalars h_le
      have h_mul := Module.finrank_mul_finrank K ↥K⟮α⟯ ↥E
      have hE_eq : Module.finrank K ↥E = Module.finrank K ↥K⟮ϖ⟯ := rfl
      rw [hE_eq, IntermediateField.adjoin.finrank hα_int, IntermediateField.adjoin.finrank hϖ_int,
        h_mp_α] at h_mul
      exact ⟨Module.finrank ↥K⟮α⟯ ↥E, h_mul.symm⟩
    rcases he with rfl | rfl | rfl | rfl
    · exact hP2_irr
    · exact hP3_irr
    · have hP4_monic : (Polynomial.X ^ 4 - Polynomial.C a).Monic :=
        Polynomial.monic_X_pow_sub_C a (by decide)
      have hP4_deg : (Polynomial.X ^ 4 - Polynomial.C a).natDegree = 4 :=
        Polynomial.natDegree_X_pow_sub_C (n := 4) (r := a)
      have hP4_aeval : Polynomial.aeval ϖ (Polynomial.X ^ 4 - Polynomial.C a) = 0 := by
        simp [hϖ_pow_U]
      have hϖ_int : IsIntegral K ϖ := ⟨Polynomial.X ^ 4 - Polynomial.C a, hP4_monic, hP4_aeval⟩
      have h_dvd : minpoly K ϖ ∣ Polynomial.X ^ 4 - Polynomial.C a :=
        minpoly.dvd K ϖ hP4_aeval
      have hd_pos : 0 < (minpoly K ϖ).natDegree := minpoly.natDegree_pos hϖ_int
      have hd_le : (minpoly K ϖ).natDegree ≤ 4 := by
        simpa [hP4_deg] using Polynomial.natDegree_le_of_dvd h_dvd hP4_monic.ne_zero
      have h_w2_mem : ϖ ^ 2 ∈ K⟮ϖ⟯ :=
        pow_mem (IntermediateField.mem_adjoin_simple_self K ϖ) 2
      have h_w2_aeval : Polynomial.aeval (ϖ ^ 2) (Polynomial.X ^ 2 - Polynomial.C a) = 0 := by
        simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        rw [← pow_mul, hϖ_pow_U, sub_self]
      have h2_dvd : 2 ∣ (minpoly K ϖ).natDegree := by
        have := h_deg_dvd (ϖ ^ 2) (Polynomial.X ^ 2 - Polynomial.C a)
          h_w2_mem hP2_monic hP2_irr h_w2_aeval hϖ_int
        simpa [Polynomial.natDegree_X_pow_sub_C] using this
      have hd_cases : (minpoly K ϖ).natDegree = 2 ∨ (minpoly K ϖ).natDegree = 4 := by omega
      rcases hd_cases with hd2 | hd4
      · exfalso
        set f := minpoly K ϖ
        set c₀ := f.coeff 0
        set c₁ := f.coeff 1
        have hf_monic : f.Monic := minpoly.monic hϖ_int
        have hf_coeff2 : f.coeff 2 = 1 := by
          rw [← hd2, Polynomial.coeff_natDegree, hf_monic.leadingCoeff]
        have hf_sum : f = ∑ j ∈ Finset.range 3, Polynomial.C (f.coeff j) * Polynomial.X ^ j := by
          simpa [Polynomial.C_mul_X_pow_eq_monomial] using
            Polynomial.as_sum_range' f 3 (by omega : f.natDegree < 3)
        have h_aeval := minpoly.aeval K ϖ
        change Polynomial.aeval ϖ f = 0 at h_aeval
        rw [hf_sum] at h_aeval
        simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, zero_add,
          pow_zero, mul_one, pow_one, hf_coeff2, map_one, one_mul, map_add, map_mul, map_pow,
          Polynomial.aeval_C, Polynomial.aeval_X] at h_aeval
        set x₀ := algebraMap K L c₀
        set x₁ := algebraMap K L c₁
        set x_a := algebraMap K L a
        have h1 : x₀ + x₁ * ϖ + ϖ ^ 2 = 0 := h_aeval
        have h_rel_L : (x₁ ^ 2 - 2 * x₀) ^ 2 * x_a = (x₀ ^ 2 + x_a) ^ 2 := by
          linear_combination
            ((x₁ ^ 2 - 2 * x₀) * ϖ ^ 2 + (x₀ ^ 2 + x_a)) * (x₁ * ϖ - x₀ - ϖ ^ 2) * h1 +
            ((x₁ ^ 2 - 2 * x₀) * ϖ ^ 2 + (x₀ ^ 2 + x_a) - (x₁ ^ 2 - 2 * x₀) ^ 2) * hϖ_pow_U
        have h_rel_map :
            algebraMap K L ((c₁ ^ 2 - 2 * c₀) ^ 2 * a) = algebraMap K L ((c₀ ^ 2 + a) ^ 2) := by
          simpa [x₀, x₁, x_a, map_ofNat] using h_rel_L
        have h_rel : (c₁ ^ 2 - 2 * c₀) ^ 2 * a = (c₀ ^ 2 + a) ^ 2 :=
          (algebraMap K L).injective h_rel_map
        by_cases hs : c₁ ^ 2 - 2 * c₀ = 0
        · have hc0 : c₀ ^ 2 + a = 0 := by
            rw [hs, zero_pow (by decide), zero_mul] at h_rel
            exact eq_zero_of_pow_eq_zero h_rel.symm
          have h_sq : (i * c₀) ^ 2 = a := by
            linear_combination c₀ ^ 2 * hi - hc0
          exact h_no_sq (i * c₀) h_sq
        · have h_sq : ((c₀ ^ 2 + a) / (c₁ ^ 2 - 2 * c₀)) ^ 2 = a := by
            rw [div_pow, ← h_rel, mul_div_cancel_left₀ a (pow_ne_zero 2 hs)]
          exact h_no_sq ((c₀ ^ 2 + a) / (c₁ ^ 2 - 2 * c₀)) h_sq
      · have h_eq : Polynomial.X ^ 4 - Polynomial.C a = minpoly K ϖ :=
          Polynomial.eq_of_monic_of_dvd_of_natDegree_le
            (minpoly.monic hϖ_int) hP4_monic h_dvd (by omega)
        rw [h_eq]
        exact minpoly.irreducible hϖ_int
    · have hP6_monic : (Polynomial.X ^ 6 - Polynomial.C a).Monic :=
        Polynomial.monic_X_pow_sub_C a (by decide)
      have hP6_deg : (Polynomial.X ^ 6 - Polynomial.C a).natDegree = 6 :=
        Polynomial.natDegree_X_pow_sub_C (n := 6) (r := a)
      have hP6_aeval : Polynomial.aeval ϖ (Polynomial.X ^ 6 - Polynomial.C a) = 0 := by
        simp [hϖ_pow_U]
      have hϖ_int : IsIntegral K ϖ := ⟨Polynomial.X ^ 6 - Polynomial.C a, hP6_monic, hP6_aeval⟩
      have h_dvd : minpoly K ϖ ∣ Polynomial.X ^ 6 - Polynomial.C a :=
        minpoly.dvd K ϖ hP6_aeval
      have hd_pos : 0 < (minpoly K ϖ).natDegree := minpoly.natDegree_pos hϖ_int
      have hd_le : (minpoly K ϖ).natDegree ≤ 6 := by
        simpa [hP6_deg] using Polynomial.natDegree_le_of_dvd h_dvd hP6_monic.ne_zero
      have h2_dvd : 2 ∣ (minpoly K ϖ).natDegree := by
        have h_w3_mem : ϖ ^ 3 ∈ K⟮ϖ⟯ :=
          pow_mem (IntermediateField.mem_adjoin_simple_self K ϖ) 3
        have h_w3_aeval : Polynomial.aeval (ϖ ^ 3) (Polynomial.X ^ 2 - Polynomial.C a) = 0 := by
          simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
          rw [← pow_mul, hϖ_pow_U, sub_self]
        have := h_deg_dvd (ϖ ^ 3) (Polynomial.X ^ 2 - Polynomial.C a)
          h_w3_mem hP2_monic hP2_irr h_w3_aeval hϖ_int
        simpa [Polynomial.natDegree_X_pow_sub_C] using this
      have h3_dvd : 3 ∣ (minpoly K ϖ).natDegree := by
        have h_w2_mem : ϖ ^ 2 ∈ K⟮ϖ⟯ :=
          pow_mem (IntermediateField.mem_adjoin_simple_self K ϖ) 2
        have h_w2_aeval : Polynomial.aeval (ϖ ^ 2) (Polynomial.X ^ 3 - Polynomial.C a) = 0 := by
          simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
          rw [← pow_mul, hϖ_pow_U, sub_self]
        have := h_deg_dvd (ϖ ^ 2) (Polynomial.X ^ 3 - Polynomial.C a)
          h_w2_mem hP3_monic hP3_irr h_w2_aeval hϖ_int
        simpa [Polynomial.natDegree_X_pow_sub_C] using this
      have hd6 : (minpoly K ϖ).natDegree = 6 := by omega
      have h_eq : Polynomial.X ^ 6 - Polynomial.C a = minpoly K ϖ :=
        Polynomial.eq_of_monic_of_dvd_of_natDegree_le
          (minpoly.monic hϖ_int) hP6_monic h_dvd (by omega)
      rw [h_eq]
      exact minpoly.irreducible hϖ_int
  have h_irr_U : Irreducible (Polynomial.X ^ e - Polynomial.C a) :=
    h_irr_gen ↥U (AlgebraicClosure F) e he a i hi ϖ hϖ_pow_U h_no_sq h_no_cube
  have h_irr : Irreducible (Polynomial.X ^ e - Polynomial.C (algebraMap F H π)) := by
    apply Polynomial.Monic.irreducible_of_irreducible_map
      (IntermediateField.inclusion hH_unr).toRingHom
      (Polynomial.X ^ e - Polynomial.C (algebraMap F H π))
      (Polynomial.monic_X_pow_sub_C (algebraMap F H π) he_pos.ne')
    have h_comm : (IntermediateField.inclusion hH_unr).toRingHom (algebraMap F H π) = a :=
      (IntermediateField.inclusion hH_unr).commutes π
    simpa [h_comm] using h_irr_U
  let P_U : Polynomial ↥U := Polynomial.X ^ e - Polynomial.C a
  have hP_U_monic : P_U.Monic := Polynomial.monic_X_pow_sub_C a he_pos.ne'
  let ϖ' : AlgebraicClosure F := ζ * ϖ
  have h_aeval_ϖ : Polynomial.aeval ϖ P_U = 0 := by
    simp [P_U, hϖ_pow_U]
  have h_aeval_ϖ' : Polynomial.aeval ϖ' P_U = 0 := by
    simp only [P_U, ϖ', map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    rw [mul_pow, hζ_pow, one_mul, hϖ_pow_U, sub_self]
  have hϖ_int_U : IsIntegral ↥U ϖ := ⟨P_U, hP_U_monic, h_aeval_ϖ⟩
  have hϖ_alg_U : IsAlgebraic ↥U ϖ := hϖ_int_U.isAlgebraic
  have h_mp : minpoly ↥U ϖ = minpoly ↥U ϖ' := by
    have h1 := minpoly.eq_of_irreducible_of_monic h_irr_U h_aeval_ϖ hP_U_monic
    have h2 := minpoly.eq_of_irreducible_of_monic h_irr_U h_aeval_ϖ' hP_U_monic
    exact h1.symm.trans h2
  let φ₀ := minpoly.algEquiv hϖ_alg_U h_mp
  haveI : Normal ↥U (AlgebraicClosure F) :=
    Normal.tower_top_of_normal F ↥U (AlgebraicClosure F)
  let σ_U : AlgebraicClosure F ≃ₐ[↥U] AlgebraicClosure F :=
    φ₀.liftNormal (AlgebraicClosure F)
  have hσ_U_ϖ : σ_U ϖ = ϖ' := by
    have h_comm := AlgEquiv.liftNormal_commutes φ₀ (AlgebraicClosure F)
      (IntermediateField.AdjoinSimple.gen ↥U ϖ)
    have h_app : φ₀ (IntermediateField.AdjoinSimple.gen ↥U ϖ) =
        IntermediateField.AdjoinSimple.gen ↥U ϖ' :=
      minpoly.algEquiv_apply hϖ_alg_U h_mp
    rw [h_app] at h_comm
    exact h_comm
  let σ₀ : EllipticRootNumber.AbsGal F := σ_U.restrictScalars F
  have hσ₀_in : σ₀ ∈ EllipticRootNumber.inertia F := by
    intro u
    exact σ_U.commutes u
  have hσ₀_frob : EllipticRootNumber.ActsAsFrobPow F σ₀ 0 := by
    intro ξ hξ
    have hξ_mem : ξ ∈ U :=
      IntermediateField.subset_adjoin F {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} hξ
    have hfix : σ₀ ξ = ξ := hσ₀_in ⟨ξ, hξ_mem⟩
    simp [hfix]
  have hσ₀_weil : σ₀ ∈ EllipticRootNumber.weilGroup F :=
    Subgroup.subset_closure ⟨0, hσ₀_frob⟩
  have hσ₀_H : σ₀ ∈ H.fixingSubgroup :=
    IntermediateField.fixingSubgroup_le hH_unr hσ₀_in
  have hσ₀_ζ : σ₀ ζ = ζ := hσ₀_H ⟨ζ, hζ_mem⟩
  exact ⟨h_irr, ⟨σ₀, ⟨hσ₀_weil, hσ₀_H⟩⟩, hσ₀_in, hσ₀_ζ, hσ_U_ϖ⟩

theorem dihedral_kummer_extension_abelian_and_norm_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    [FiniteDimensional F H]
    (π : F) (ϖ ζ : AlgebraicClosure F)
    (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hϖ_ne : ϖ ≠ 0)
    (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hζ_mem : ζ ∈ H)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (hζ_ord : ∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 → ζ ^ k ≠ 1)
    (h_irr : Irreducible (Polynomial.X ^ (12 / Nat.gcd n 12) - Polynomial.C (algebraMap F H π))) :
    ∃ (M : IntermediateField F (AlgebraicClosure F)) (h_HM : H ≤ M),
      FiniteDimensional F M ∧
      EllipticRootNumber.IsAbelianExt F h_HM ∧
      (∀ σ : EllipticRootNumber.AbsGal F,
        σ ∈ H.fixingSubgroup → (σ ∈ M.fixingSubgroup ↔ σ ϖ = ϖ)) ∧
      (∀ σ : EllipticRootNumber.AbsGal F,
        ∃ j : ℕ, σ ϖ = ζ ^ j * ϖ) ∧
      (∃ π_M : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
        IntermediateField.inclusion h (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
          Set.range (EllipticRootNumber.normLM F h_HM)) ∧
      (∀ z : H,
        z ^ (12 / Nat.gcd n 12) ∈ Set.range (EllipticRootNumber.normLM F h_HM)) :=
by
  set e := 12 / Nat.gcd n 12
  have hn_cases : e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 6 := by
    change 12 / Nat.gcd n 12 = 2 ∨ 12 / Nat.gcd n 12 = 3 ∨
      12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6
    rcases hn23 with h2 | h3 <;> interval_cases n <;> first | decide | omega
  have he_pos : 0 < e := by
    rcases hn_cases with he | he | he | he <;> omega
  let M_H : IntermediateField H (AlgebraicClosure F) :=
    IntermediateField.adjoin H ({ϖ} : Set (AlgebraicClosure F))
  let M : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.restrictScalars F M_H
  have h_HM : H ≤ M := fun x hx => M_H.algebraMap_mem ⟨x, hx⟩
  let B : IntermediateField F (AlgebraicClosure F) := ⊥
  let π_H : H := algebraMap F H π
  
  have hP_monic : (Polynomial.X ^ e - Polynomial.C π_H).Monic :=
    Polynomial.monic_X_pow_sub_C π_H he_pos.ne'
  have hP_aeval : Polynomial.aeval ϖ (Polynomial.X ^ e - Polynomial.C π_H) = 0 := by
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    have : algebraMap H (AlgebraicClosure F) π_H = algebraMap F (AlgebraicClosure F) π :=
      (IsScalarTower.algebraMap_apply F H (AlgebraicClosure F) π).symm
    rw [this, hϖ_pow, sub_self]
  have hϖ_int : IsIntegral H ϖ := ⟨Polynomial.X ^ e - Polynomial.C π_H, hP_monic, hP_aeval⟩
  haveI : FiniteDimensional H M_H := IntermediateField.adjoin.finiteDimensional hϖ_int
  have hM_fin : FiniteDimensional F M := Module.Finite.trans H M_H
  
  have h_fix : ∀ σ : EllipticRootNumber.AbsGal F,
      σ ∈ H.fixingSubgroup → (σ ∈ M.fixingSubgroup ↔ σ ϖ = ϖ) := by
    intro σ hσ
    let Kσ : IntermediateField H (AlgebraicClosure F) :=
      { carrier := {x | σ x = x}
        mul_mem' := fun {a b} ha hb => by dsimp at *; rw [map_mul, ha, hb]
        one_mem' := map_one σ
        add_mem' := fun {a b} ha hb => by dsimp at *; rw [map_add, ha, hb]
        zero_mem' := map_zero σ
        inv_mem' := fun {a} ha => by dsimp at *; rw [map_inv₀, ha]
        algebraMap_mem' := fun a => hσ a }
    have h_le : M_H ≤ Kσ ↔ σ ϖ = ϖ := IntermediateField.adjoin_simple_le_iff
    rw [← h_le, IntermediateField.mem_fixingSubgroup_iff]
    rfl
  have h_cubic : ∀ (ω v : AlgebraicClosure F),
      ω ^ 3 = 1 → ω ≠ 1 → v ^ 3 = 1 → v = 1 ∨ v = ω ∨ v = ω ^ 2 := by
    intro ω v hω3 hω1 hv3
    have hω_cyc : ω ^ 2 + ω + 1 = 0 := by
      have h_fac : (ω - 1) * (ω ^ 2 + ω + 1) = 0 := by linear_combination hω3
      rcases mul_eq_zero.mp h_fac with h1 | h2
      · exact absurd (sub_eq_zero.mp h1) hω1
      · exact h2
    have hv_fac : (v - 1) * (v - ω) * (v - ω ^ 2) = 0 := by
      calc (v - 1) * (v - ω) * (v - ω ^ 2)
        _ = (v ^ 3 - 1) + (-v ^ 2 + ω * (v - 1) + 1) * (ω ^ 2 + ω + 1) := by ring
        _ = 0 := by rw [hv3, hω_cyc]; ring
    rcases mul_eq_zero.mp hv_fac with h12 | h3
    · rcases mul_eq_zero.mp h12 with h1 | h2
      · exact Or.inl (sub_eq_zero.mp h1)
      · exact Or.inr (Or.inl (sub_eq_zero.mp h2))
    · exact Or.inr (Or.inr (sub_eq_zero.mp h3))
  have h_scalar : ∀ σ : EllipticRootNumber.AbsGal F,
      ∃ j : ℕ, σ ϖ = ζ ^ j * ϖ := by
    intro σ
    let u := σ ϖ / ϖ
    have hu_mul : σ ϖ = u * ϖ := (div_mul_cancel₀ (σ ϖ) hϖ_ne).symm
    have hu_pow : u ^ e = 1 := by
      dsimp [u]
      rw [div_pow, ← map_pow, hϖ_pow, σ.commutes, ← hϖ_pow, div_self (pow_ne_zero _ hϖ_ne)]
    suffices h_u : ∃ j : ℕ, u = ζ ^ j by
      obtain ⟨j, hj⟩ := h_u
      exact ⟨j, by rw [hu_mul, hj]⟩
    rcases hn_cases with he | he | he | he
    · rw [he] at hu_pow hζ_pow hζ_ord
      have hζ1 : ζ ≠ 1 := by simpa using hζ_ord 1 (by decide) (by decide)
      have hζ_cyc : ζ + 1 = 0 := by
        have h_fac : (ζ - 1) * (ζ + 1) = 0 := by linear_combination hζ_pow
        rcases mul_eq_zero.mp h_fac with h1 | h2
        · exact absurd (sub_eq_zero.mp h1) hζ1
        · exact h2
      have hu_fac : (u - 1) * (u + 1) = 0 := by linear_combination hu_pow
      rcases mul_eq_zero.mp hu_fac with h1 | h2
      · exact ⟨0, by rw [pow_zero, sub_eq_zero.mp h1]⟩
      · refine ⟨1, ?_⟩
        linear_combination h2 - hζ_cyc
    · rw [he] at hu_pow hζ_pow hζ_ord
      rcases h_cubic ζ u hζ_pow (by simpa using hζ_ord 1 (by decide) (by decide)) hu_pow with
        h1 | h2 | h3
      · exact ⟨0, by rw [pow_zero, h1]⟩
      · exact ⟨1, by rw [pow_one, h2]⟩
      · exact ⟨2, h3⟩
    · rw [he] at hu_pow hζ_pow hζ_ord
      have hζ2_ne : ζ ^ 2 ≠ 1 := hζ_ord 2 (by decide) (by decide)
      have hζ2_cyc : ζ ^ 2 + 1 = 0 := by
        have h_fac : (ζ ^ 2 - 1) * (ζ ^ 2 + 1) = 0 := by linear_combination hζ_pow
        rcases mul_eq_zero.mp h_fac with h1 | h2
        · exact absurd (sub_eq_zero.mp h1) hζ2_ne
        · exact h2
      have hu_fac : (u - 1) * (u + 1) * (u - ζ) * (u + ζ) = 0 := by
        calc (u - 1) * (u + 1) * (u - ζ) * (u + ζ)
          _ = (u ^ 4 - 1) - (u ^ 2 - 1) * (ζ ^ 2 + 1) := by ring
          _ = 0 := by rw [hu_pow, hζ2_cyc]; ring
      rcases mul_eq_zero.mp hu_fac with h123 | h4
      · rcases mul_eq_zero.mp h123 with h12 | h3
        · rcases mul_eq_zero.mp h12 with h1 | h2
          · exact ⟨0, by rw [pow_zero, sub_eq_zero.mp h1]⟩
          · refine ⟨2, ?_⟩
            linear_combination h2 - hζ2_cyc
        · exact ⟨1, by rw [pow_one, sub_eq_zero.mp h3]⟩
      · refine ⟨3, ?_⟩
        linear_combination h4 - ζ * hζ2_cyc
    · rw [he] at hu_pow hζ_pow hζ_ord
      have hζ3_ne : ζ ^ 3 ≠ 1 := hζ_ord 3 (by decide) (by decide)
      have hζ3_cyc : ζ ^ 3 + 1 = 0 := by
        have h_fac : (ζ ^ 3 - 1) * (ζ ^ 3 + 1) = 0 := by linear_combination hζ_pow
        rcases mul_eq_zero.mp h_fac with h1 | h2
        · exact absurd (sub_eq_zero.mp h1) hζ3_ne
        · exact h2
      have hω3 : (ζ ^ 2) ^ 3 = 1 := by linear_combination hζ_pow
      have hω1 : ζ ^ 2 ≠ 1 := hζ_ord 2 (by decide) (by decide)
      have hu_split : (u ^ 3 - 1) * ((-u) ^ 3 - 1) = 0 := by linear_combination -hu_pow
      rcases mul_eq_zero.mp hu_split with h1 | h2
      · rcases h_cubic (ζ ^ 2) u hω3 hω1 (sub_eq_zero.mp h1) with hc | hc | hc
        · exact ⟨0, by rw [pow_zero, hc]⟩
        · exact ⟨2, hc⟩
        · refine ⟨4, ?_⟩
          linear_combination hc
      · rcases h_cubic (ζ ^ 2) (-u) hω3 hω1 (sub_eq_zero.mp h2) with hc | hc | hc
        · refine ⟨3, ?_⟩
          linear_combination -hc - hζ3_cyc
        · refine ⟨5, ?_⟩
          linear_combination -hc - ζ ^ 2 * hζ3_cyc
        · refine ⟨7, ?_⟩
          linear_combination -hc - ζ ^ 4 * hζ3_cyc
  have hγ_ζ : ∀ γ ∈ H.fixingSubgroup, γ ζ = ζ := fun γ hγ => hγ ⟨ζ, hζ_mem⟩
  have h_comm : ∀ σ ∈ H.fixingSubgroup, ∀ τ ∈ H.fixingSubgroup, σ (τ ϖ) = τ (σ ϖ) := by
    intro σ hσ τ hτ
    obtain ⟨jσ, hjσ⟩ := h_scalar σ
    obtain ⟨jτ, hjτ⟩ := h_scalar τ
    calc σ (τ ϖ)
      _ = σ (ζ ^ jτ * ϖ) := by rw [hjτ]
      _ = ζ ^ jτ * (ζ ^ jσ * ϖ) := by rw [map_mul, map_pow, hγ_ζ σ hσ, hjσ]
      _ = ζ ^ jσ * (ζ ^ jτ * ϖ) := by ring
      _ = τ (σ ϖ) := by rw [hjσ, map_mul, map_pow, hγ_ζ τ hτ, hjτ]
  
  have h2_of_ord2 : ∀ ω : AlgebraicClosure F, ω ^ 2 = 1 → ω ≠ 1 → (2 : AlgebraicClosure F) ≠ 0 := by
    intro ω hω2 hω1 h2
    have h_fac : (ω - 1) * (ω + 1) = 0 := by linear_combination hω2
    rcases mul_eq_zero.mp h_fac with h1 | h1
    · exact hω1 (sub_eq_zero.mp h1)
    · have : ω - 1 = 0 := by linear_combination h1 - h2
      exact hω1 (sub_eq_zero.mp this)
  have h3_of_ord3 : ∀ ω : AlgebraicClosure F, ω ^ 3 = 1 → ω ≠ 1 → (3 : AlgebraicClosure F) ≠ 0 := by
    intro ω hω3 hω1 h3
    have h_fac : (ω - 1) * (ω ^ 2 + ω + 1) = 0 := by linear_combination hω3
    rcases mul_eq_zero.mp h_fac with h1 | h1
    · exact hω1 (sub_eq_zero.mp h1)
    · have h_sq : (ω - 1) ^ 2 = 0 := by linear_combination h1 - ω * h3
      exact hω1 (sub_eq_zero.mp (eq_zero_of_pow_eq_zero h_sq))
  have he_ne_bar : (e : AlgebraicClosure F) ≠ 0 := by
    rcases hn_cases with he | he | he | he
    · rw [he] at hζ_pow hζ_ord ⊢
      exact_mod_cast h2_of_ord2 ζ hζ_pow (by simpa using hζ_ord 1 (by decide) (by decide))
    · rw [he] at hζ_pow hζ_ord ⊢
      exact_mod_cast h3_of_ord3 ζ hζ_pow (by simpa using hζ_ord 1 (by decide) (by decide))
    · rw [he] at hζ_pow hζ_ord ⊢
      have h2 := h2_of_ord2 (ζ ^ 2) (by linear_combination hζ_pow) (hζ_ord 2 (by decide) (by decide))
      have : ((4 : ℕ) : AlgebraicClosure F) = (2 : AlgebraicClosure F) * (2 : AlgebraicClosure F) := by norm_num
      rw [this]
      exact mul_ne_zero h2 h2
    · rw [he] at hζ_pow hζ_ord ⊢
      have h2 := h2_of_ord2 (ζ ^ 3) (by linear_combination hζ_pow) (hζ_ord 3 (by decide) (by decide))
      have h3 := h3_of_ord3 (ζ ^ 2) (by linear_combination hζ_pow) (hζ_ord 2 (by decide) (by decide))
      have : ((6 : ℕ) : AlgebraicClosure F) = (2 : AlgebraicClosure F) * (3 : AlgebraicClosure F) := by norm_num
      rw [this]
      exact mul_ne_zero h2 h3
  have he_ne_H : (e : H) ≠ 0 := by
    intro h0
    apply he_ne_bar
    have : (e : AlgebraicClosure F) = algebraMap H (AlgebraicClosure F) (e : H) :=
      (map_natCast (algebraMap H (AlgebraicClosure F)) e).symm
    rw [this, h0, map_zero]
  have hπ_H_ne : π_H ≠ 0 :=
    (map_ne_zero_iff (algebraMap F H) (RingHom.injective (algebraMap F H))).mpr hπ_ne
  have hP_sep : (Polynomial.X ^ e - Polynomial.C π_H).Separable :=
    Polynomial.separable_X_pow_sub_C π_H he_ne_H hπ_H_ne
  have hϖ_sep : IsSeparable H ϖ :=
    Polynomial.Separable.of_dvd hP_sep (minpoly.dvd H ϖ hP_aeval)
  have hM_sep : Algebra.IsSeparable H (IntermediateField.extendScalars h_HM) :=
    (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable H (AlgebraicClosure F)).mpr hϖ_sep
  have hM_ab : EllipticRootNumber.IsAbelianExt F h_HM := by
    refine ⟨?_, ?_, hM_sep⟩
    · intro σ hσ τ hτ
      have hτ_H : τ ∈ H.fixingSubgroup := IntermediateField.fixingSubgroup_le h_HM hτ
      have hσ_inv : σ⁻¹ ∈ H.fixingSubgroup := H.fixingSubgroup.inv_mem hσ
      have h_conj_H : σ * τ * σ⁻¹ ∈ H.fixingSubgroup :=
        H.fixingSubgroup.mul_mem (H.fixingSubgroup.mul_mem hσ hτ_H) hσ_inv
      rw [h_fix _ h_conj_H]
      have hτ_ϖ : τ ϖ = ϖ := (h_fix τ hτ_H).mp hτ
      change σ (τ (σ⁻¹ ϖ)) = ϖ
      rw [h_comm τ hτ_H σ⁻¹ hσ_inv, hτ_ϖ]
      change (σ * σ⁻¹) ϖ = ϖ
      rw [mul_inv_cancel, AlgEquiv.one_apply]
    · intro σ hσ τ hτ
      have hσ_inv : σ⁻¹ ∈ H.fixingSubgroup := H.fixingSubgroup.inv_mem hσ
      have hτ_inv : τ⁻¹ ∈ H.fixingSubgroup := H.fixingSubgroup.inv_mem hτ
      have h_comm_H : σ * τ * σ⁻¹ * τ⁻¹ ∈ H.fixingSubgroup :=
        H.fixingSubgroup.mul_mem
          (H.fixingSubgroup.mul_mem (H.fixingSubgroup.mul_mem hσ hτ) hσ_inv) hτ_inv
      rw [h_fix _ h_comm_H]
      change σ (τ (σ⁻¹ (τ⁻¹ ϖ))) = ϖ
      rw [h_comm σ⁻¹ hσ_inv τ⁻¹ hτ_inv]
      change σ ((τ * τ⁻¹) (σ⁻¹ ϖ)) = ϖ
      rw [mul_inv_cancel, AlgEquiv.one_apply]
      change (σ * σ⁻¹) ϖ = ϖ
      rw [mul_inv_cancel, AlgEquiv.one_apply]
  
  have h_normLM : ∀ y : M_H,
      EllipticRootNumber.normLM F h_HM y = Algebra.norm H y := fun _ => rfl
  have h_mp : minpoly H ϖ = Polynomial.X ^ e - Polynomial.C π_H :=
    (minpoly.eq_of_irreducible_of_monic h_irr hP_aeval hP_monic).symm
  let pb : PowerBasis H M_H := IntermediateField.adjoin.powerBasis hϖ_int
  have h_pb_dim : pb.dim = e := by
    rw [IntermediateField.adjoin.powerBasis_dim hϖ_int, h_mp,
      Polynomial.natDegree_X_pow_sub_C]
  have h_pb_mp : minpoly H pb.gen = Polynomial.X ^ e - Polynomial.C π_H := by
    rw [IntermediateField.adjoin.powerBasis_gen hϖ_int, IntermediateField.minpoly_gen H ϖ, h_mp]
  have h_norm_gen : Algebra.norm H pb.gen = (-1 : H) ^ e * (-π_H) := by
    rw [Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, h_pb_dim, h_pb_mp,
      Polynomial.coeff_sub, Polynomial.coeff_X_pow, if_neg he_pos.ne,
      Polynomial.coeff_C_zero, zero_sub]
  have h_norm_pow : ∀ z : H,
      z ^ e ∈ Set.range (EllipticRootNumber.normLM F h_HM) := by
    intro z
    refine ⟨algebraMap H M_H z, ?_⟩
    rw [h_normLM, Algebra.norm_algebraMap, PowerBasis.finrank pb, h_pb_dim]
  
  let π_F : F := (-1 : F) ^ e * (-π)
  have hπ_F_ne : π_F ≠ 0 :=
    mul_ne_zero (pow_ne_zero e (neg_ne_zero.mpr one_ne_zero)) (neg_ne_zero.mpr hπ_ne)
  have hπ_F_val_eq : ValuativeRel.valuation F π_F = ValuativeRel.valuation F π := by
    dsimp [π_F]
    rw [Valuation.map_mul, Valuation.map_pow, Valuation.map_neg, Valuation.map_one,
      one_pow, one_mul, Valuation.map_neg]
  have h_addVal_eq : ∀ a b : F, a ≠ 0 → b ≠ 0 →
      ValuativeRel.valuation F a = ValuativeRel.valuation F b →
      EllipticRootNumber.addVal F a = EllipticRootNumber.addVal F b := by
    intro a b ha hb hv
    unfold EllipticRootNumber.addVal
    rw [dif_neg ha, dif_neg hb]
    simp only [hv]
  have hπ_F_addVal : EllipticRootNumber.addVal F π_F = 1 := by
    rw [h_addVal_eq π_F π hπ_F_ne hπ_ne hπ_F_val_eq, hπ_val]
  have h_relVal : ∀ x : B,
      EllipticRootNumber.relVal F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    rw [← Algebra.norm_eq_of_algEquiv (IntermediateField.botEquiv F (AlgebraicClosure F)) x,
      Algebra.norm_self]
    rfl
  have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    have h1_mem : 1 ∈ {k : ℕ | 0 < k ∧ ∃ x : B, x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} := by
      refine ⟨zero_lt_one, algebraMap F B π,
        (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr hπ_ne, ?_⟩
      rw [h_relVal]
      have : IntermediateField.botEquiv F (AlgebraicClosure F) (algebraMap F B π) = π := by
        rw [← IntermediateField.botEquiv_symm]
        exact (IntermediateField.botEquiv F (AlgebraicClosure F)).apply_symm_apply π
      rw [this, hπ_val, Nat.cast_one]
    exact le_antisymm (Nat.sInf_le h1_mem) (le_csInf ⟨1, h1_mem⟩ (fun k hk => hk.1))
  let x_M : B := algebraMap F B π_F
  have hx_M_ne : x_M ≠ 0 :=
    (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr hπ_F_ne
  let π_M : Bˣ := Units.mk0 x_M hx_M_ne
  have hπ_M_val : EllipticRootNumber.valL F ⊥ (π_M : B) = 1 := by
    unfold EllipticRootNumber.valL
    rw [h_resDeg, Nat.cast_one, EuclideanDomain.div_one, Units.val_mk0, h_relVal]
    have : IntermediateField.botEquiv F (AlgebraicClosure F) x_M = π_F := by
      dsimp [x_M]
      rw [← IntermediateField.botEquiv_symm]
      exact (IntermediateField.botEquiv F (AlgebraicClosure F)).apply_symm_apply π_F
    rw [this, hπ_F_addVal]
  have hπ_M_range : IntermediateField.inclusion h (π_M : B) ∈
      Set.range (EllipticRootNumber.normLM F h_HM) := by
    refine ⟨pb.gen, ?_⟩
    rw [h_normLM, h_norm_gen]
    change (-1 : H) ^ e * (-π_H) = IntermediateField.inclusion h (algebraMap F B ((-1 : F) ^ e * (-π)))
    simp only [map_mul, map_pow, map_neg, map_one]
    rfl
  exact ⟨M, h_HM, hM_fin, hM_ab, h_fix, h_scalar, ⟨π_M, hπ_M_val, hπ_M_range⟩, h_norm_pow⟩

theorem weilDegreeHom_eq_one_iff_mem_inertia_and_exists_deg_neg_one (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    (∀ v : EllipticRootNumber.weilGroup F,
      EllipticRootNumber.weilDegreeHom F v = 1 ↔
        (v : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F) ∧
    (∃ w₀ : EllipticRootNumber.relWeil F ⊥,
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w₀) =
          Multiplicative.ofAdd (-1)) :=
by
  open ValuativeRel in
  (
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    obtain ⟨k_res, hp, hk⟩ := FiniteField.card 𝓀[F] (ringChar 𝓀[F])
    have hp_prime : (EllipticRootNumber.p F).Prime := hp
    have hq_pow : EllipticRootNumber.q F = (EllipticRootNumber.p F) ^ (k_res : ℕ) := by
      unfold EllipticRootNumber.q EllipticRootNumber.p
      rw [Nat.card_eq_fintype_card, hk]
    have hq_ge_two : 2 ≤ EllipticRootNumber.q F := by
      rw [hq_pow]
      exact Nat.one_lt_pow k_res.ne_zero hp_prime.one_lt
    have h_coprime_q : ∀ (N m : ℕ), ¬ EllipticRootNumber.p F ∣ N →
        (EllipticRootNumber.q F ^ m).Coprime N := by
      intro N m hpN
      rw [hq_pow]
      exact ((hp_prime.coprime_iff_not_dvd.mpr hpN).pow_left _).pow_left _
    have eq_of_pow_q_pow_eq : ∀ (z₁ z₂ : AlgebraicClosure F) (N m : ℕ),
        0 < N → ¬ EllipticRootNumber.p F ∣ N → z₁ ^ N = 1 → z₂ ^ N = 1 →
        z₁ ^ (EllipticRootNumber.q F ^ m) = z₂ ^ (EllipticRootNumber.q F ^ m) → z₁ = z₂ := by
      intro z₁ z₂ N m hN0 hpN hz₁ hz₂ heq
      have hz₁0 : z₁ ≠ 0 := fun h => by rw [h, zero_pow hN0.ne'] at hz₁; exact zero_ne_one hz₁
      have hz₂0 : z₂ ≠ 0 := fun h => by rw [h, zero_pow hN0.ne'] at hz₂; exact zero_ne_one hz₂
      let u₁ : (AlgebraicClosure F)ˣ := Units.mk0 z₁ hz₁0
      let u₂ : (AlgebraicClosure F)ˣ := Units.mk0 z₂ hz₂0
      let u : (AlgebraicClosure F)ˣ := u₁ * u₂⁻¹
      have huN : u ^ N = 1 := by
        have hu₁N : u₁ ^ N = 1 := by ext; exact hz₁
        have hu₂N : u₂ ^ N = 1 := by ext; exact hz₂
        rw [mul_pow, inv_pow, hu₁N, hu₂N, inv_one, mul_one]
      have huq : u ^ (EllipticRootNumber.q F ^ m) = 1 := by
        have hu₁_eq : u₁ ^ (EllipticRootNumber.q F ^ m) = u₂ ^ (EllipticRootNumber.q F ^ m) := by
          ext
          exact heq
        rw [mul_pow, inv_pow, hu₁_eq, mul_inv_cancel]
      have hdvd : orderOf u ∣ Nat.gcd (EllipticRootNumber.q F ^ m) N :=
        Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one huq) (orderOf_dvd_of_pow_eq_one huN)
      rw [(h_coprime_q N m hpN).gcd_eq_one] at hdvd
      have hu1 : u = 1 := orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_one hdvd)
      have hu_eq : u₁ = u₂ := mul_inv_eq_one.mp hu1
      exact congrArg Units.val hu_eq
    have h_root_gal : ∀ (τ : EllipticRootNumber.AbsGal F) (ζ : AlgebraicClosure F),
        EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        EllipticRootNumber.IsPrimeToPRootOfUnity F (τ ζ) := by
      rintro τ ζ ⟨N, hN0, hpN, hζN⟩
      exact ⟨N, hN0, hpN, by rw [← map_pow, hζN, map_one]⟩
    have h_frob_one : EllipticRootNumber.ActsAsFrobPow F 1 0 := by
      intro ζ _
      simp
    have h_frob_mul : ∀ (σ τ : EllipticRootNumber.AbsGal F) (m n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ m →
        EllipticRootNumber.ActsAsFrobPow F τ n →
        EllipticRootNumber.ActsAsFrobPow F (σ * τ) (m + n) := by
      intro σ τ m n hm hn ζ hζ
      rcases hζ with ⟨N, hN0, hpN, hζN⟩
      have hζ' : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ := ⟨N, hN0, hpN, hζN⟩
      have hz₁N : (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(m + n)).toNat)) ^ N = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζN, map_one, one_pow]
      have hz₂N : (ζ ^ (EllipticRootNumber.q F ^ (m + n).toNat)) ^ N = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, hζN, one_pow]
      apply eq_of_pow_q_pow_eq _ _ N ((-m).toNat + (-n).toNat) hN0 hpN hz₁N hz₂N
      calc (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(m + n)).toNat)) ^
            (EllipticRootNumber.q F ^ ((-m).toNat + (-n).toNat))
        _ = (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-(m + n)).toNat + ((-m).toNat + (-n).toNat))) := by
            rw [AlgEquiv.mul_apply, ← pow_mul, ← pow_add]
        _ = ((σ (τ ζ)) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + (-n).toNat)) := by
            rw [← pow_mul, ← pow_add]
            congr 2
            omega
        _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ m.toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + (-n).toNat)) := by
            rw [hm (τ ζ) (h_root_gal τ ζ hζ')]
        _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + m.toNat)) := by
            rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
            congr 2
            omega
        _ = (ζ ^ (EllipticRootNumber.q F ^ n.toNat)) ^
            (EllipticRootNumber.q F ^ ((-(m + n)).toNat + m.toNat)) := by
            rw [hn ζ hζ']
        _ = (ζ ^ (EllipticRootNumber.q F ^ (m + n).toNat)) ^
            (EllipticRootNumber.q F ^ ((-m).toNat + (-n).toNat)) := by
            rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
            congr 2
            omega
    have h_frob_inv : ∀ (σ : EllipticRootNumber.AbsGal F) (m : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ m →
        EllipticRootNumber.ActsAsFrobPow F σ⁻¹ (-m) := by
      intro σ m hm ζ hζ
      have h1 := hm (σ⁻¹ ζ) (h_root_gal σ⁻¹ ζ hζ)
      have h2 : σ (σ⁻¹ ζ) = ζ := AlgEquiv.apply_symm_apply σ ζ
      rw [h2] at h1
      rw [neg_neg]
      exact h1.symm
    have h_weil_exists : ∀ v : EllipticRootNumber.weilGroup F,
        ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F (v : EllipticRootNumber.AbsGal F) n := by
      rintro ⟨σ, hσ⟩
      exact Subgroup.closure_induction
        (fun τ hτ => hτ)
        ⟨0, h_frob_one⟩
        (fun τ₁ τ₂ _ _ ⟨m, hm⟩ ⟨n, hn⟩ => ⟨m + n, h_frob_mul τ₁ τ₂ m n hm hn⟩)
        (fun τ _ ⟨m, hm⟩ => ⟨-m, h_frob_inv τ m hm⟩)
        hσ
    have h_frob_unique : ∀ (σ : EllipticRootNumber.AbsGal F) (m n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ m →
        EllipticRootNumber.ActsAsFrobPow F σ n → m = n := by
      intro σ m n hm hn
      have h_diff : EllipticRootNumber.ActsAsFrobPow F 1 (-m + n) := by
        have h1 := h_frob_mul σ⁻¹ σ (-m) n (h_frob_inv σ m hm) hn
        rwa [inv_mul_cancel] at h1
      set d : ℤ := -m + n
      set A : ℕ := (-d).toNat
      set B : ℕ := d.toNat
      obtain ⟨r, hr_ge, hr_prime⟩ := Nat.exists_infinite_primes
        (max (EllipticRootNumber.p F) (max (EllipticRootNumber.q F ^ A) (EllipticRootNumber.q F ^ B)) + 1)
      have h_max_lt_r :
          max (EllipticRootNumber.p F) (max (EllipticRootNumber.q F ^ A) (EllipticRootNumber.q F ^ B)) < r :=
        Nat.lt_of_succ_le hr_ge
      have hp_lt_r : EllipticRootNumber.p F < r :=
        lt_of_le_of_lt (le_max_left _ _) h_max_lt_r
      have hqA_lt_r : EllipticRootNumber.q F ^ A < r :=
        lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) h_max_lt_r
      have hqB_lt_r : EllipticRootNumber.q F ^ B < r :=
        lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) h_max_lt_r
      have hp_not_dvd_r : ¬ EllipticRootNumber.p F ∣ r := by
        intro hdvd
        rcases (Nat.dvd_prime hr_prime).mp hdvd with h1 | hr_eq
        · exact hp_prime.ne_one h1
        · exact hp_lt_r.ne hr_eq
      have hr_F_ne : (r : F) ≠ 0 := by
        have hr_res_ne : (r : 𝓀[F]) ≠ 0 :=
          (CharP.cast_eq_zero_iff 𝓀[F] (ringChar 𝓀[F]) r).not.mpr hp_not_dvd_r
        intro hr0
        apply hr_res_ne
        have hr_int0 : (r : ↥𝒪[F]) = 0 := by
          ext
          exact hr0
        rw [← map_natCast (IsLocalRing.residue ↥𝒪[F]) r, hr_int0, map_zero]
      letI : NeZero (r : F) := ⟨hr_F_ne⟩
      obtain ⟨ζ_r, hζ_r⟩ := (AlgebraicClosure.hasEnoughRootsOfUnity F r).prim
      have hζ_r_root : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ_r :=
        ⟨r, hr_prime.pos, hp_not_dvd_r, hζ_r.pow_eq_one⟩
      have h_pow_eq : ζ_r ^ (EllipticRootNumber.q F ^ A) = ζ_r ^ (EllipticRootNumber.q F ^ B) := by
        simpa [A, B] using h_diff ζ_r hζ_r_root
      have hq_pow_eq : EllipticRootNumber.q F ^ A = EllipticRootNumber.q F ^ B :=
        hζ_r.pow_inj hqA_lt_r hqB_lt_r h_pow_eq
      have hAB : A = B := Nat.pow_right_injective hq_ge_two hq_pow_eq
      change (-d).toNat = d.toNat at hAB
      omega
    have h_deg_eq : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.weilDegree F σ = n := by
      intro σ n hn
      unfold EllipticRootNumber.weilDegree
      have hex : ∃ m : ℤ, EllipticRootNumber.ActsAsFrobPow F σ m := ⟨n, hn⟩
      rw [dif_pos hex]
      exact h_frob_unique σ hex.choose n hex.choose_spec hn
    let f₀ : EllipticRootNumber.weilGroup F →* Multiplicative ℤ :=
      { toFun := fun v => Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v : EllipticRootNumber.AbsGal F))
        map_one' := by
          change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F 1) = 1
          rw [h_deg_eq 1 0 h_frob_one, ofAdd_zero]
        map_mul' := fun v₁ v₂ => by
          obtain ⟨m, hm⟩ := h_weil_exists v₁
          obtain ⟨n, hn⟩ := h_weil_exists v₂
          change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F
            ((v₁ : EllipticRootNumber.AbsGal F) * (v₂ : EllipticRootNumber.AbsGal F))) =
            Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v₁ : EllipticRootNumber.AbsGal F)) *
              Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v₂ : EllipticRootNumber.AbsGal F))
          rw [h_deg_eq _ m hm, h_deg_eq _ n hn,
            h_deg_eq _ (m + n) (h_frob_mul _ _ m n hm hn), ofAdd_add] }
    have h_exists_hom : ∃ f : EllipticRootNumber.weilGroup F →* Multiplicative ℤ,
        ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
          EllipticRootNumber.ActsAsFrobPow F σ n → f σ = Multiplicative.ofAdd n := by
      refine ⟨f₀, fun σ n hn => ?_⟩
      change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (σ : EllipticRootNumber.AbsGal F)) =
        Multiplicative.ofAdd n
      rw [h_deg_eq _ n hn]
    have h_hom_spec : ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n →
        EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n :=
      Classical.epsilon_spec h_exists_hom
    have h_deg_in_weil : ∀ v : EllipticRootNumber.weilGroup F,
        EllipticRootNumber.weilDegreeHom F v = 1 ↔
          (v : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F := by
      intro v
      obtain ⟨n_v, hn_v⟩ := h_weil_exists v
      have h_deg_iff_frob0 : EllipticRootNumber.weilDegreeHom F v = 1 ↔
          EllipticRootNumber.ActsAsFrobPow F (v : EllipticRootNumber.AbsGal F) 0 := by
        rw [h_hom_spec v n_v hn_v, ← ofAdd_zero, Multiplicative.ofAdd.injective.eq_iff]
        exact ⟨fun h0 => h0 ▸ hn_v, fun h0 => h_frob_unique _ n_v 0 hn_v h0⟩
      rw [h_deg_iff_frob0]
      unfold EllipticRootNumber.ActsAsFrobPow EllipticRootNumber.inertia EllipticRootNumber.unramifiedClosure
      rw [IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hv x hx
        exact IntermediateField.adjoin_induction F
          (p := fun x _ => (v : EllipticRootNumber.AbsGal F) x = x)
          (fun ζ hζ => by simpa using hv ζ hζ)
          (fun a => AlgEquiv.commutes (v : EllipticRootNumber.AbsGal F) a)
          (fun a b _ _ ha hb => by dsimp only at ha hb ⊢; rw [map_add, ha, hb])
          (fun a _ ha => by dsimp only at ha ⊢; rw [map_inv₀, ha])
          (fun a b _ _ ha hb => by dsimp only at ha hb ⊢; rw [map_mul, ha, hb])
          hx
      · intro hv ζ hζ
        have hfix : (v : EllipticRootNumber.AbsGal F) ζ = ζ :=
          hv ζ (IntermediateField.subset_adjoin F {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} hζ)
        simpa using hfix
    let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
        z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
      rintro _ hz m rfl
      exact WithZero.unzero_coe hz
    have h_addVal_of_iso : ∀ (y : F) (m : ℤ),
        iso (ValuativeRel.valuation F y) = WithZero.exp m →
        y ≠ 0 ∧ EllipticRootNumber.addVal F y = -m := by
      intro y m hy_iso
      have h_exp_ne : WithZero.exp m ≠ 0 := WithZero.exp_ne_zero
      have h_iso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := by rw [hy_iso]; exact h_exp_ne
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := fun h0 => h_iso_ne (by rw [h0, map_zero])
      have hy : y ≠ 0 := (Valuation.ne_zero_iff _).mp hv_ne
      refine ⟨hy, ?_⟩
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy, h_unzero _ _ m hy_iso]
      rfl
    obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      rw [hπ_val, iso.apply_symm_apply]
    obtain ⟨hπ0, hπ_addVal⟩ := h_addVal_of_iso π (-1) hπ_iso
    have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
      intro x
      unfold EllipticRootNumber.relVal
      have h_norm : Algebra.norm F x = e_bot x := by
        rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
        rfl
      rw [h_norm]
    have hπ_bot_ne : e_bot.symm π ≠ 0 := (map_ne_zero e_bot.symm).mpr hπ0
    let π_bot : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := Units.mk0 (e_bot.symm π) hπ_bot_ne
    have h_relVal_π : EllipticRootNumber.relVal F ⊥
        (π_bot : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
      change EllipticRootNumber.relVal F ⊥ (e_bot.symm π) = 1
      rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
      rfl
    haveI : FiniteDimensional F (⊥ : IntermediateField F (AlgebraicClosure F)) :=
      Module.Finite.equiv e_bot.toLinearEquiv.symm
    let rec_F := Classical.choice (local_reciprocity F)
    let w₀ : EllipticRootNumber.relWeil F ⊥ := rec_F.recMap ⊥ π_bot
    have hw₀_deg : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w₀) =
          Multiplicative.ofAdd (-1) := by
      have hdeg := rec_F.degree_rec ⊥ π_bot
      rw [h_relVal_π] at hdeg
      exact hdeg
    exact ⟨h_deg_in_weil, w₀, hw₀_deg⟩
  )

theorem exists_dihedral_kummer_extension (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hdi : ¬ ((12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)))
    (H : IntermediateField F (AlgebraicClosure F))
    (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ H)
    (u : Hˣ) (d : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    [FiniteDimensional F H]
    (hH_unr : H ≤ EllipticRootNumber.unramifiedClosure F)
    (hH_weil : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup ↔
        2 ∣ Multiplicative.toAdd
          (EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w)))
    (hu_sq : (u : H) ^ 2 = IntermediateField.inclusion h (d : (⊥ : IntermediateField F (AlgebraicClosure F))))
    (hd_val : EllipticRootNumber.valL F ⊥ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hd_nonsq : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ EllipticRootNumber.valL F ⊥ a →
        EllipticRootNumber.valL F ⊥ ((d : (⊥ : IntermediateField F (AlgebraicClosure F))) - a ^ 2) = 0)
    (h_coord : ∀ y : H, ∃! p : (⊥ : IntermediateField F (AlgebraicClosure F)) × (⊥ : IntermediateField F (AlgebraicClosure F)),
      y = IntermediateField.inclusion h p.1 + IntermediateField.inclusion h p.2 * (u : H))
    (h_valL_coord : ∀ a b : (⊥ : IntermediateField F (AlgebraicClosure F)),
      (0 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H)) ↔
        0 ≤ EllipticRootNumber.valL F ⊥ a ∧ 0 ≤ EllipticRootNumber.valL F ⊥ b) ∧
      ((IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H) = 0 ∨
        1 ≤ EllipticRootNumber.valL F H (IntermediateField.inclusion h a + IntermediateField.inclusion h b * (u : H))) ↔
        (a = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ a) ∧ (b = 0 ∨ 1 ≤ EllipticRootNumber.valL F ⊥ b))) :
    ∃ (π : F) (ϖ ζ : AlgebraicClosure F)
      (M : IntermediateField F (AlgebraicClosure F))
      (h_HM : H ≤ M)
      (τ₀ : EllipticRootNumber.relWeil F H)
      (w₀ : EllipticRootNumber.relWeil F ⊥),
      π ≠ 0 ∧
      EllipticRootNumber.addVal F π = 1 ∧
      ϖ ≠ 0 ∧
      ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π ∧
      ζ ^ (12 / Nat.gcd n 12) = 1 ∧
      (∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 → ζ ^ k ≠ 1) ∧
      FiniteDimensional F M ∧
      EllipticRootNumber.IsAbelianExt F h_HM ∧
      (∀ w : EllipticRootNumber.relWeil F H,
        (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup ↔ (w : EllipticRootNumber.AbsGal F) ϖ = ϖ) ∧
      (∃ π_M : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
        IntermediateField.inclusion h (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
          Set.range (EllipticRootNumber.normLM F h_HM)) ∧
      (∀ u₁ ∈ EllipticRootNumber.unitGroup F H 1,
        (u₁ : H) ∈ Set.range (EllipticRootNumber.normLM F h_HM)) ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) τ₀) = 1 ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ζ = ζ ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ϖ = ζ * ϖ ∧
      ¬ ((w₀ : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) ∧
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w₀) =
          Multiplicative.ofAdd (-1) ∧
      ((w₀ ^ 2 : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup ∧
      (((w₀ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ *
          w₀⁻¹ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ :
          EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
       ((w₀ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ *
          w₀⁻¹ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ :
          EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ϖ = ϖ) ∧
      (∀ w : EllipticRootNumber.relWeil F H,
        ((Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w *
            Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ *
            (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w)⁻¹ *
            (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀)⁻¹ :
            EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
        ((Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w *
            Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀ *
            (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) w)⁻¹ *
            (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) τ₀)⁻¹ :
            EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ϖ = ϖ) ∧
      (∀ w : EllipticRootNumber.relWeil F H,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
        ((w ^ (12 / Nat.gcd n 12) : EllipticRootNumber.relWeil F H) : EllipticRootNumber.AbsGal F) ϖ = ϖ) :=
by
  set e : ℕ := 12 / Nat.gcd n 12
  have he_pos : 0 < e := by
    change 0 < 12 / Nat.gcd n 12
    interval_cases n <;> decide
  obtain ⟨π, ζ, hπ_ne, hπ_val, hζ_mem, hζ_pow, hζ_ord, hζ_gal⟩ :=
    dihedral_primitive_root_of_unity_in_quadratic_ext F n hn0 hn12 hn23 hq2 hq3 hdi H h u d
      hu_sq hd_val hd_nonsq h_coord
  obtain ⟨ϖ, hϖ_pow⟩ :=
    IsAlgClosed.exists_pow_nat_eq (algebraMap F (AlgebraicClosure F) π) he_pos
  have hϖ_ne : ϖ ≠ 0 := by
    rintro rfl
    rw [zero_pow he_pos.ne'] at hϖ_pow
    exact hπ_ne ((map_eq_zero_iff (algebraMap F (AlgebraicClosure F))
      (RingHom.injective (algebraMap F (AlgebraicClosure F)))).mp hϖ_pow.symm)
  obtain ⟨h_irr, τ₀, hτ₀_in, hτ₀_ζ, hτ₀_ϖ⟩ :=
    dihedral_kummer_irreducible_and_inertia_aut F n hn0 hn12 hn23 hq2 H hH_unr π ϖ ζ
      hϖ_pow hζ_mem hζ_pow (unramifiedClosure_no_root_of_uniformizer F π hπ_ne hπ_val)
  obtain ⟨M, h_HM, hM_fin, hM_ab, hM_fix, hϖ_scalar, h_unif_norm, h_norm_pow⟩ :=
    dihedral_kummer_extension_abelian_and_norm_spec F n hn0 hn12 hn23 H h π ϖ ζ
      hπ_ne hπ_val hϖ_ne hϖ_pow hζ_mem hζ_pow hζ_ord h_irr
  have hU₁_pow :=
    quadratic_unitGroup_one_pow_surjective F n hn0 hn12 hn23 hq2 hq3 H h u d
      hu_sq hd_val h_coord h_valL_coord
  have h_u1_norm : ∀ u₁ ∈ EllipticRootNumber.unitGroup F H 1,
      (u₁ : H) ∈ Set.range (EllipticRootNumber.normLM F h_HM) := by
    intro u₁ hu₁
    obtain ⟨z, hz⟩ := hU₁_pow u₁ hu₁
    rw [← hz]
    exact h_norm_pow z
  obtain ⟨h_deg_in, w₀, hw₀_deg⟩ :=
    weilDegreeHom_eq_one_iff_mem_inertia_and_exists_deg_neg_one F
  have hτ₀_deg : EllipticRootNumber.weilDegreeHom F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) τ₀) = 1 :=
    (h_deg_in (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) τ₀)).mpr hτ₀_in
  have hw₀_not_H : ¬ ((w₀ : EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) := by
    rw [hH_weil w₀, hw₀_deg, toAdd_ofAdd]
    omega
  have hw₀_sq_deg : EllipticRootNumber.weilDegreeHom F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) (w₀ ^ 2)) =
        Multiplicative.ofAdd (-2) := by
    rw [sq, map_mul, map_mul, hw₀_deg, ← ofAdd_add]
    rfl
  have hw₀_sq_H : ((w₀ ^ 2 : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
      H.fixingSubgroup := by
    rw [hH_weil (w₀ ^ 2), hw₀_sq_deg, toAdd_ofAdd]
    exact ⟨-1, rfl⟩
  have hw₀_sq_M : ((w₀ ^ 2 : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
      M.fixingSubgroup := by
    rw [hM_fix ((w₀ ^ 2 : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) hw₀_sq_H]
    obtain ⟨j, hj⟩ := hϖ_scalar (w₀ : EllipticRootNumber.AbsGal F)
    have h_gal_w0 : (w₀ : EllipticRootNumber.AbsGal F) ζ * ζ = 1 :=
      hζ_gal (w₀ : EllipticRootNumber.AbsGal F) hw₀_not_H
    change (w₀ : EllipticRootNumber.AbsGal F) ((w₀ : EllipticRootNumber.AbsGal F) ϖ) = ϖ
    rw [hj, map_mul, map_pow, hj, ← mul_assoc, ← mul_pow, h_gal_w0, one_pow, one_mul]
  let ι_H := Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h)
  let deg_bot : EllipticRootNumber.relWeil F ⊥ →* Multiplicative ℤ :=
    (EllipticRootNumber.weilDegreeHom F).comp
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥))
  have h_deg_τ₀ : deg_bot (ι_H τ₀) = 1 := hτ₀_deg
  have h_deg_τ₀_inv : deg_bot (ι_H τ₀)⁻¹ = 1 := by
    calc deg_bot (ι_H τ₀)⁻¹
      _ = 1 * deg_bot (ι_H τ₀)⁻¹ := (one_mul _).symm
      _ = deg_bot (ι_H τ₀) * deg_bot (ι_H τ₀)⁻¹ := by rw [h_deg_τ₀]
      _ = deg_bot (ι_H τ₀ * (ι_H τ₀)⁻¹) := (map_mul deg_bot _ _).symm
      _ = deg_bot 1 := by rw [mul_inv_cancel]
      _ = 1 := map_one deg_bot
  have hw₀_τ₀_in : (((w₀ * ι_H τ₀ * w₀⁻¹ * ι_H τ₀ :
      EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
        EllipticRootNumber.inertia F) := by
    apply (h_deg_in (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
      (w₀ * ι_H τ₀ * w₀⁻¹ * ι_H τ₀))).mp
    change deg_bot (w₀ * ι_H τ₀ * w₀⁻¹ * ι_H τ₀) = 1
    rw [map_mul, map_mul, map_mul, h_deg_τ₀, mul_one, mul_one, ← map_mul, mul_inv_cancel, map_one]
  have hw₀_τ₀_ϖ : ((w₀ * ι_H τ₀ * w₀⁻¹ * ι_H τ₀ :
      EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ϖ = ϖ := by
    have hw₀_inv_not_H : ¬ (((w₀⁻¹ : EllipticRootNumber.relWeil F ⊥) :
        EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup) := by
      intro h_inv
      exact hw₀_not_H (H.fixingSubgroup.inv_mem_iff.mp h_inv)
    have h_gal_inv : (w₀⁻¹ : EllipticRootNumber.AbsGal F) ζ * ζ = 1 :=
      hζ_gal (w₀⁻¹ : EllipticRootNumber.AbsGal F) hw₀_inv_not_H
    obtain ⟨k, hk⟩ := hϖ_scalar (w₀⁻¹ : EllipticRootNumber.AbsGal F)
    have hτ₀_w₀_inv_ϖ : (τ₀ : EllipticRootNumber.AbsGal F) ((w₀⁻¹ : EllipticRootNumber.AbsGal F) ϖ) =
        ζ * (w₀⁻¹ : EllipticRootNumber.AbsGal F) ϖ := by
      rw [hk, map_mul, map_pow, hτ₀_ζ, hτ₀_ϖ, ← mul_assoc, mul_comm (ζ ^ k) ζ, mul_assoc]
    have hτ₀_w₀_inv_ζ : (τ₀ : EllipticRootNumber.AbsGal F) ((w₀⁻¹ : EllipticRootNumber.AbsGal F) ζ) * ζ = 1 := by
      calc (τ₀ : EllipticRootNumber.AbsGal F) ((w₀⁻¹ : EllipticRootNumber.AbsGal F) ζ) * ζ
        _ = (τ₀ : EllipticRootNumber.AbsGal F) ((w₀⁻¹ : EllipticRootNumber.AbsGal F) ζ) *
              (τ₀ : EllipticRootNumber.AbsGal F) ζ := by rw [hτ₀_ζ]
        _ = (τ₀ : EllipticRootNumber.AbsGal F) ((w₀⁻¹ : EllipticRootNumber.AbsGal F) ζ * ζ) :=
              (map_mul (τ₀ : EllipticRootNumber.AbsGal F) _ _).symm
        _ = (τ₀ : EllipticRootNumber.AbsGal F) 1 := by rw [h_gal_inv]
        _ = 1 := map_one _
    change (w₀ : EllipticRootNumber.AbsGal F) ((τ₀ : EllipticRootNumber.AbsGal F)
      ((w₀⁻¹ : EllipticRootNumber.AbsGal F) ((τ₀ : EllipticRootNumber.AbsGal F) ϖ))) = ϖ
    rw [hτ₀_ϖ, map_mul, map_mul, hτ₀_w₀_inv_ϖ, ← mul_assoc, hτ₀_w₀_inv_ζ, one_mul]
    exact AlgEquiv.apply_symm_apply (w₀ : EllipticRootNumber.AbsGal F) ϖ
  have h_comm_τ₀ : ∀ w : EllipticRootNumber.relWeil F H,
      ((ι_H w * ι_H τ₀ * (ι_H w)⁻¹ * (ι_H τ₀)⁻¹ :
          EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
      ((ι_H w * ι_H τ₀ * (ι_H w)⁻¹ * (ι_H τ₀)⁻¹ :
          EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ϖ = ϖ := by
    intro w
    refine ⟨?_, ?_⟩
    · apply (h_deg_in (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
        (ι_H w * ι_H τ₀ * (ι_H w)⁻¹ * (ι_H τ₀)⁻¹))).mp
      change deg_bot (ι_H w * ι_H τ₀ * (ι_H w)⁻¹ * (ι_H τ₀)⁻¹) = 1
      rw [map_mul, map_mul, map_mul, h_deg_τ₀, h_deg_τ₀_inv, mul_one, mul_one,
        ← map_mul, mul_inv_cancel, map_one]
    · have h_comm_H : ((w * τ₀ * w⁻¹ * τ₀⁻¹ : EllipticRootNumber.relWeil F H) :
          EllipticRootNumber.AbsGal F) ∈ H.fixingSubgroup :=
        (w * τ₀ * w⁻¹ * τ₀⁻¹).2.2
      have h_comm_M : ((w * τ₀ * w⁻¹ * τ₀⁻¹ : EllipticRootNumber.relWeil F H) :
          EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
        hM_ab.2.1 (w : EllipticRootNumber.AbsGal F) w.2.2 (τ₀ : EllipticRootNumber.AbsGal F) τ₀.2.2
      exact (hM_fix _ h_comm_H).mp h_comm_M
  have h_deg_zero_in : ∀ w : EllipticRootNumber.relWeil F H,
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w) = 1 →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
      ((w ^ e : EllipticRootNumber.relWeil F H) : EllipticRootNumber.AbsGal F) ϖ = ϖ := by
    intro w hw_deg
    refine ⟨(h_deg_in (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F H) w)).mp hw_deg, ?_⟩
    obtain ⟨j, hj⟩ := hϖ_scalar (w : EllipticRootNumber.AbsGal F)
    have hw_ζ : (w : EllipticRootNumber.AbsGal F) ζ = ζ := w.2.2 ⟨ζ, hζ_mem⟩
    have hw_pow : ∀ m : ℕ, ((w ^ m : EllipticRootNumber.relWeil F H) :
        EllipticRootNumber.AbsGal F) ϖ = (ζ ^ j) ^ m * ϖ := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        rw [pow_succ', Subgroup.coe_mul, AlgEquiv.mul_apply, ih, map_mul, map_pow, map_pow,
          hw_ζ, hj, ← mul_assoc, ← pow_succ]
    rw [hw_pow e, ← pow_mul, mul_comm j e, pow_mul, hζ_pow, one_pow, one_mul]
  exact ⟨π, ϖ, ζ, M, h_HM, τ₀, w₀, hπ_ne, hπ_val, hϖ_ne, hϖ_pow, hζ_pow, hζ_ord,
    hM_fin, hM_ab, fun w => hM_fix (w : EllipticRootNumber.AbsGal F) w.2.2,
    h_unif_norm, h_u1_norm, hτ₀_in, hτ₀_deg, hτ₀_ζ, hτ₀_ϖ,
    hw₀_not_H, hw₀_deg, hw₀_sq_M, ⟨hw₀_τ₀_in, hw₀_τ₀_ϖ⟩, h_comm_τ₀, h_deg_zero_in⟩

theorem ellAdicRep_dihedral_generator_pow_ne_self (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (π : F) (ϖ ζ : AlgebraicClosure F)
    (τ₀ : EllipticRootNumber.relWeil F ⊥)
    (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hϖ_ne : ϖ ≠ 0) (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hτ₀_in : (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (hζ_ord : ∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 → ζ ^ k ≠ 1)
    (hτ₀_ζ : (τ₀ : EllipticRootNumber.AbsGal F) ζ = ζ)
    (hτ₀_ϖ : (τ₀ : EllipticRootNumber.AbsGal F) ϖ = ζ * ϖ)
    (k : ℕ) (hk_dvd : k ∣ (12 / Nat.gcd n 12)) (hk_lt : k < 12 / Nat.gcd n 12)
    (v : EllipticRootNumber.VBar F E) (hv : v ≠ 0) :
    ((((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) τ₀) ^ k) v ≠ v :=
by
  classical
  set σ : EllipticRootNumber.AbsGal F := (τ₀ : EllipticRootNumber.AbsGal F) ^ k
  have hσ_in : σ ∈ EllipticRootNumber.inertia F :=
    Subgroup.pow_mem (EllipticRootNumber.inertia F) hτ₀_in k
  have h_rep_pow :
      ((((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) τ₀) ^ k) =
        EllipticRootNumber.ellAdicRep F E σ := by
    rw [← map_pow]
    rfl
  rw [h_rep_pow]
  
  obtain ⟨v_val, hv_gal, hv_le, hv_lt, hv_eq, hv_minpoly, hv_ell⟩ :=
    exists_galois_invariant_valuation_extension F
  
  have h12m_id : 12 * (n / Nat.gcd n 12) = (12 / Nat.gcd n 12) * n := by
    clear! F k; interval_cases n <;> decide
  have he_dvd12_id : 12 = (12 / Nat.gcd n 12) * Nat.gcd n 12 := by
    clear! F k; interval_cases n <;> decide
  have hm_sq_id : (n / Nat.gcd n 12) * (n / Nat.gcd n 12) =
      1 + (12 / Nat.gcd n 12) * (((n / Nat.gcd n 12) * (n / Nat.gcd n 12) - 1) / (12 / Nat.gcd n 12)) := by
    clear! F k; revert hn23; interval_cases n <;> decide
  have he_dvd8_id : 3 ∣ n → 8 = (12 / Nat.gcd n 12) * (8 / (12 / Nat.gcd n 12)) := by
    clear! F k; interval_cases n <;> decide
  let K := AlgebraicClosure F
  let φ := algebraMap F K
  let W₁ : WeierstrassCurve K := E.baseChange K
  have h_s7 : ∃ (C : WeierstrassCurve.VariableChange K) (α β : K),
      (C • W₁).a₁ = 0 ∧
      (C • W₁).a₂ = 0 ∧
      (C • W₁).a₃ = 0 ∧
      v_val (C • W₁).a₄ ≤ 1 ∧
      v_val (C • W₁).a₆ ≤ 1 ∧
      v_val (C • W₁).Δ = 1 ∧
      v_val (2 : K) = 1 ∧
      v_val (3 : K) = 1 ∧
      EllipticRootNumber.ell F ≠ 2 ∧
      EllipticRootNumber.ell F ≠ 3 ∧
      α ^ 6 = 1 ∧
      β ^ 4 = 1 ∧
      (β = 1 → α ≠ 1 ∧ v_val (C • W₁).a₄ < 1) ∧
      (∀ x y : K,
        σ x = x →
        σ y = y →
        σ ((C.u⁻¹ : Kˣ) ^ 2 * (x - C.r)) - ((C.u⁻¹ : Kˣ) ^ 2 * (x - C.r)) =
          (1 - α) * σ ((C.u⁻¹ : Kˣ) ^ 2 * (x - C.r)) ∧
        σ ((C.u⁻¹ : Kˣ) ^ 3 * (y - C.s * (x - C.r) - C.t)) -
          ((C.u⁻¹ : Kˣ) ^ 3 * (y - C.s * (x - C.r) - C.t)) =
          (1 - β) * σ ((C.u⁻¹ : Kˣ) ^ 3 * (y - C.s * (x - C.r) - C.t))) := by
    have hp_info : (EllipticRootNumber.p F).Prime ∧ EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
      let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
      letI : Fintype kF := Fintype.ofFinite kF
      obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
      refine ⟨hp_prime, ?_⟩
      unfold EllipticRootNumber.q EllipticRootNumber.p
      rw [Nat.card_eq_fintype_card, hcard_eq]
      exact dvd_pow_self (ringChar kF) k_card.ne_zero
    obtain ⟨hp_prime, hp_dvd_q⟩ := hp_info
    have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
      intro h; rw [h] at hp_dvd_q; exact hq2 hp_dvd_q
    have hp_ne3 : EllipticRootNumber.p F ≠ 3 := by
      intro h; rw [h] at hp_dvd_q; exact hq3 hp_dvd_q
    have hp_ge2 : 2 ≤ EllipticRootNumber.p F := hp_prime.two_le
    have h_ell_ge : EllipticRootNumber.p F + 1 ≤ EllipticRootNumber.ell F :=
      (Nat.exists_infinite_primes (EllipticRootNumber.p F + 1)).choose_spec.1
    have hℓ2 : EllipticRootNumber.ell F ≠ 2 := by omega
    have hℓ3 : EllipticRootNumber.ell F ≠ 3 := by omega
    have hv_prime : ∀ l : ℕ, l.Prime → EllipticRootNumber.p F ≠ l →
        ValuativeRel.valuation F (l : F) = 1 := by
      intro l hl_prime hl_ne
      let A := (ValuativeRel.valuation F).valuationSubring
      let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
      have hl_le : ValuativeRel.valuation F (l : F) ≤ 1 := ((l : ↥A)).2
      have hl_not_lt : ¬ (ValuativeRel.valuation F (l : F) < 1) := by
        intro hl_lt
        have h_mem : (l : ↥A) ∈ IsLocalRing.maximalIdeal ↥A :=
          (Valuation.mem_maximalIdeal_iff _ _).mpr hl_lt
        have h_res : IsLocalRing.residue ↥A (l : ↥A) = 0 :=
          (IsLocalRing.residue_eq_zero_iff _).mpr h_mem
        rw [map_natCast] at h_res
        haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
        have hdvd : EllipticRootNumber.p F ∣ l :=
          (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) l).mp h_res
        rcases (Nat.dvd_prime hl_prime).mp hdvd with h1 | heq
        · exact hp_prime.ne_one h1
        · exact hl_ne heq
      exact le_antisymm hl_le (not_lt.mp hl_not_lt)
    have hvF2 : ValuativeRel.valuation F (2 : F) = 1 := hv_prime 2 Nat.prime_two hp_ne2
    have hvF3 : ValuativeRel.valuation F (3 : F) = 1 := hv_prime 3 Nat.prime_three hp_ne3
    have hv2 : v_val (2 : K) = 1 := by
      have : (2 : K) = φ (2 : F) := (map_ofNat φ 2).symm
      rw [this, hv_eq]; exact hvF2
    have hv3 : v_val (3 : K) = 1 := by
      have : (3 : K) = φ (3 : F) := (map_ofNat φ 3).symm
      rw [this, hv_eq]; exact hvF3
    have h2F_ne : (2 : F) ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at hvF2; exact zero_ne_one hvF2
    have h3F_ne : (3 : F) ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at hvF3; exact zero_ne_one hvF3
    have hΔ_ne : E.Δ ≠ 0 := by
      intro h0; rw [EllipticRootNumber.addVal, dif_pos h0] at hΔ; omega
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hΔ_nz : iso (ValuativeRel.valuation F E.Δ) ≠ 0 :=
      (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hΔ_ne)
    have hΔ_iso : iso (ValuativeRel.valuation F E.Δ) = WithZero.exp (-(n : ℤ)) := by
      unfold EllipticRootNumber.addVal at hΔ
      rw [dif_neg hΔ_ne] at hΔ
      have h1 : Multiplicative.toAdd (WithZero.unzero hΔ_nz) = -(n : ℤ) := by omega
      rw [← WithZero.coe_unzero hΔ_nz]
      change WithZero.exp (Multiplicative.toAdd (WithZero.unzero hΔ_nz)) = WithZero.exp (-(n : ℤ))
      rw [h1]
    have hπ_nz : iso (ValuativeRel.valuation F π) ≠ 0 :=
      (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hπ_ne)
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      unfold EllipticRootNumber.addVal at hπ_val
      rw [dif_neg hπ_ne] at hπ_val
      have h1 : Multiplicative.toAdd (WithZero.unzero hπ_nz) = -1 := by omega
      rw [← WithZero.coe_unzero hπ_nz]
      change WithZero.exp (Multiplicative.toAdd (WithZero.unzero hπ_nz)) = WithZero.exp (-1 : ℤ)
      rw [h1]
    have hπn_iso : iso (ValuativeRel.valuation F (π ^ n)) = WithZero.exp (-(n : ℤ)) := by
      rw [map_pow, map_pow, hπ_iso, ← WithZero.exp_nsmul]
      congr 1
      rw [nsmul_eq_mul]; ring
    have hΔ_eq_πn : ValuativeRel.valuation F E.Δ = ValuativeRel.valuation F (π ^ n) :=
      iso.injective (hΔ_iso.trans hπn_iso.symm)
    have hπn_ne : π ^ n ≠ 0 := pow_ne_zero n hπ_ne
    have hπn_val_ne : ValuativeRel.valuation F (π ^ n) ≠ 0 :=
      (Valuation.ne_zero_iff _).mpr hπn_ne
    have hΔ_div_val : ValuativeRel.valuation F (E.Δ / π ^ n) = 1 := by
      rw [map_div₀, hΔ_eq_πn, div_self hπn_val_ne]
    have hc4_div_val : ValuativeRel.valuation F (E.c₄ ^ 3 / π ^ n) ≤ 1 := by
      have h_eq : E.c₄ ^ 3 / π ^ n = (E.c₄ ^ 3 / E.Δ) * (E.Δ / π ^ n) :=
        (div_mul_div_cancel₀ hΔ_ne).symm
      rw [h_eq, map_mul, hΔ_div_val, mul_one]
      exact hj
    have hc4_div_lt : ¬ (3 ∣ n) → ValuativeRel.valuation F (E.c₄ ^ 3 / π ^ n) < 1 := by
      intro h3n
      by_cases hc4_0 : E.c₄ = 0
      · rw [hc4_0, zero_pow (by norm_num), zero_div, Valuation.map_zero]
        exact zero_lt_one
      · have hc4_nz : iso (ValuativeRel.valuation F E.c₄) ≠ 0 :=
          (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hc4_0)
        let m₄ : ℤ := Multiplicative.toAdd (WithZero.unzero hc4_nz)
        have hc4_iso : iso (ValuativeRel.valuation F E.c₄) = WithZero.exp m₄ := by
          rw [← WithZero.coe_unzero hc4_nz]; rfl
        have h_div_iso : iso (ValuativeRel.valuation F (E.c₄ ^ 3 / π ^ n)) =
            WithZero.exp (3 * m₄ + (n : ℤ)) := by
          rw [map_div₀, map_div₀, map_pow, map_pow, hc4_iso, hπn_iso,
            ← WithZero.exp_nsmul, ← WithZero.exp_sub]
          congr 1
          rw [nsmul_eq_mul]; ring
        have h_le0 : 3 * m₄ + (n : ℤ) ≤ 0 := by
          have h1 : iso (ValuativeRel.valuation F (E.c₄ ^ 3 / π ^ n)) ≤ WithZero.exp (0 : ℤ) := by
            rw [WithZero.exp_zero, ← map_one iso, map_le_map_iff iso]
            exact hc4_div_val
          rwa [h_div_iso, WithZero.exp_le_exp] at h1
        have h_lt0 : 3 * m₄ + (n : ℤ) < 0 := by omega
        rw [← map_lt_map_iff iso, h_div_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
        exact h_lt0
    have hvF1728 : ValuativeRel.valuation F (1728 : F) = 1 := by
      have : (1728 : F) = (2 : F) ^ 6 * (3 : F) ^ 3 := by norm_num
      rw [this, map_mul, map_pow, map_pow, hvF2, hvF3, one_pow, one_pow, mul_one]
    have hc6_div_val : ValuativeRel.valuation F (E.c₆ ^ 2 / π ^ n) ≤ 1 := by
      have h_rel : E.c₆ ^ 2 / π ^ n = E.c₄ ^ 3 / π ^ n - 1728 * (E.Δ / π ^ n) := by
        have hc := WeierstrassCurve.c_relation E
        rw [← mul_div_assoc, ← sub_div]
        congr 1; linear_combination hc
      rw [h_rel]
      refine (Valuation.map_sub _ _ _).trans (max_le hc4_div_val ?_)
      rw [map_mul, hvF1728, hΔ_div_val, mul_one]
    set e : ℕ := 12 / Nat.gcd n 12
    set m : ℕ := n / Nat.gcd n 12
    have h12m : 12 * m = e * n := h12m_id
    let u : K := ϖ ^ m
    have hu : u ≠ 0 := pow_ne_zero m hϖ_ne
    let s_F : F := -E.a₁ / 2
    let r_F : F := -E.b₂ / 12
    let t_F : F := -(E.a₃ + r_F * E.a₁) / 2
    let C : WeierstrassCurve.VariableChange K := ⟨Units.mk0 u hu, φ r_F, φ s_F, φ t_F⟩
    let W₂ : WeierstrassCurve K := C • W₁
    have hW₁_a₁ : W₁.a₁ = φ E.a₁ := WeierstrassCurve.map_a₁ E φ
    have hW₁_a₂ : W₁.a₂ = φ E.a₂ := WeierstrassCurve.map_a₂ E φ
    have hW₁_a₃ : W₁.a₃ = φ E.a₃ := WeierstrassCurve.map_a₃ E φ
    have hW₁_c₄ : W₁.c₄ = φ E.c₄ := WeierstrassCurve.map_c₄ E φ
    have hW₁_c₆ : W₁.c₆ = φ E.c₆ := WeierstrassCurve.map_c₆ E φ
    have hW₁_Δ : W₁.Δ = φ E.Δ := WeierstrassCurve.map_Δ E φ
    have h12F_ne : (12 : F) ≠ 0 := by
      have : (12 : F) = 2 * 2 * 3 := by norm_num
      rw [this]
      exact mul_ne_zero (mul_ne_zero h2F_ne h2F_ne) h3F_ne
    have h4F_ne : (4 : F) ≠ 0 := by
      have : (4 : F) = 2 * 2 := by norm_num
      rw [this]
      exact mul_ne_zero h2F_ne h2F_ne
    have h2s : 2 * s_F = -E.a₁ := mul_div_cancel₀ (-E.a₁) h2F_ne
    have h12r : 12 * r_F = -(E.a₁ ^ 2 + 4 * E.a₂) := mul_div_cancel₀ (-E.b₂) h12F_ne
    have h2t : 2 * t_F = -(E.a₃ + r_F * E.a₁) := mul_div_cancel₀ (-(E.a₃ + r_F * E.a₁)) h2F_ne
    have hW₂_a₁ : W₂.a₁ = 0 := by
      rw [WeierstrassCurve.variableChange_a₁ W₁ C, hW₁_a₁]
      change (C.u⁻¹ : Kˣ) * (φ E.a₁ + 2 * φ s_F) = 0
      have h_f : E.a₁ + 2 * s_F = 0 := by linear_combination h2s
      have h_map : φ E.a₁ + 2 * φ s_F = φ (E.a₁ + 2 * s_F) := by
        simp only [map_add, map_mul, map_ofNat]
      rw [h_map, h_f, map_zero, mul_zero]
    have hW₂_a₂ : W₂.a₂ = 0 := by
      rw [WeierstrassCurve.variableChange_a₂ W₁ C, hW₁_a₁, hW₁_a₂]
      change (C.u⁻¹ : Kˣ) ^ 2 * (φ E.a₂ - φ s_F * φ E.a₁ + 3 * φ r_F - φ s_F ^ 2) = 0
      have h_f4 : 4 * (E.a₂ - s_F * E.a₁ + 3 * r_F - s_F ^ 2) = 0 := by
        linear_combination h12r - (2 * s_F + E.a₁) * h2s
      have h_f : E.a₂ - s_F * E.a₁ + 3 * r_F - s_F ^ 2 = 0 :=
        (mul_eq_zero.mp h_f4).resolve_left h4F_ne
      have h_map : φ E.a₂ - φ s_F * φ E.a₁ + 3 * φ r_F - φ s_F ^ 2 =
          φ (E.a₂ - s_F * E.a₁ + 3 * r_F - s_F ^ 2) := by
        simp only [map_add, map_sub, map_mul, map_pow, map_ofNat]
      rw [h_map, h_f, map_zero, mul_zero]
    have hW₂_a₃ : W₂.a₃ = 0 := by
      rw [WeierstrassCurve.variableChange_a₃ W₁ C, hW₁_a₁, hW₁_a₃]
      change (C.u⁻¹ : Kˣ) ^ 3 * (φ E.a₃ + φ r_F * φ E.a₁ + 2 * φ t_F) = 0
      have h_f : E.a₃ + r_F * E.a₁ + 2 * t_F = 0 := by linear_combination h2t
      have h_map : φ E.a₃ + φ r_F * φ E.a₁ + 2 * φ t_F =
          φ (E.a₃ + r_F * E.a₁ + 2 * t_F) := by
        simp only [map_add, map_mul, map_ofNat]
      rw [h_map, h_f, map_zero, mul_zero]
    have hu12 : (C.u : K) ^ 12 = φ (π ^ n) := by
      change (ϖ ^ m) ^ 12 = φ (π ^ n)
      rw [← pow_mul, mul_comm m 12, h12m, pow_mul, hϖ_pow, map_pow]
    have hu_inv12 : ((C.u⁻¹ : Kˣ) : K) ^ 12 = (φ (π ^ n))⁻¹ := by
      rw [Units.val_inv_eq_inv_val, inv_pow, hu12]
    have hW₂_Δ : W₂.Δ = φ (E.Δ / π ^ n) := by
      rw [WeierstrassCurve.variableChange_Δ W₁ C, hu_inv12, hW₁_Δ, map_div₀, inv_mul_eq_div]
    have hv_W₂_Δ : v_val W₂.Δ = 1 := by
      rw [hW₂_Δ, hv_eq]; exact hΔ_div_val
    have hW₂_c₄_eq : W₂.c₄ = -48 * W₂.a₄ := by
      unfold WeierstrassCurve.c₄ WeierstrassCurve.b₂ WeierstrassCurve.b₄
      rw [hW₂_a₁, hW₂_a₂, hW₂_a₃]; ring
    have hW₂_c₄_pow : (-48 * W₂.a₄) ^ 3 = φ (E.c₄ ^ 3 / π ^ n) := by
      calc (-48 * W₂.a₄) ^ 3 = W₂.c₄ ^ 3 := by rw [← hW₂_c₄_eq]
        _ = ((C.u⁻¹ : Kˣ) ^ 4 * W₁.c₄) ^ 3 := by rw [WeierstrassCurve.variableChange_c₄ W₁ C]
        _ = ((C.u⁻¹ : Kˣ) : K) ^ 12 * W₁.c₄ ^ 3 := by ring
        _ = (φ (π ^ n))⁻¹ * φ (E.c₄ ^ 3) := by rw [hu_inv12, hW₁_c₄, ← map_pow]
        _ = φ (E.c₄ ^ 3 / π ^ n) := by rw [map_div₀, inv_mul_eq_div]
    have hv48 : v_val (-48 : K) = 1 := by
      have : (48 : K) = (2 : K) ^ 4 * 3 := by norm_num
      rw [Valuation.map_neg, this, map_mul, map_pow, hv2, hv3, one_pow, one_mul]
    have hv_a₄_pow : v_val W₂.a₄ ^ 3 = v_val (φ (E.c₄ ^ 3 / π ^ n)) := by
      calc v_val W₂.a₄ ^ 3 = (v_val (-48 : K) * v_val W₂.a₄) ^ 3 := by rw [hv48, one_mul]
        _ = v_val ((-48 * W₂.a₄) ^ 3) := by rw [← map_mul, ← map_pow]
        _ = v_val (φ (E.c₄ ^ 3 / π ^ n)) := by rw [hW₂_c₄_pow]
    have hv_W₂_a₄ : v_val W₂.a₄ ≤ 1 := by
      have h_pow_le : v_val W₂.a₄ ^ 3 ≤ 1 := by
        rw [hv_a₄_pow, hv_le]; exact hc4_div_val
      by_contra h_gt
      push_neg at h_gt
      exact not_lt_of_ge h_pow_le (one_lt_pow₀ h_gt (by norm_num))
    have hv_W₂_a₄_lt : ¬ (3 ∣ n) → v_val W₂.a₄ < 1 := by
      intro h3n
      have h_pow_lt : v_val W₂.a₄ ^ 3 < 1 := by
        rw [hv_a₄_pow, hv_lt]; exact hc4_div_lt h3n
      by_contra h_ge
      push_neg at h_ge
      exact not_lt_of_ge (one_le_pow₀ h_ge) h_pow_lt
    have hW₂_c₆_eq : W₂.c₆ = -864 * W₂.a₆ := by
      unfold WeierstrassCurve.c₆ WeierstrassCurve.b₂ WeierstrassCurve.b₄ WeierstrassCurve.b₆
      rw [hW₂_a₁, hW₂_a₂, hW₂_a₃]; ring
    have hW₂_c₆_pow : (-864 * W₂.a₆) ^ 2 = φ (E.c₆ ^ 2 / π ^ n) := by
      calc (-864 * W₂.a₆) ^ 2 = W₂.c₆ ^ 2 := by rw [← hW₂_c₆_eq]
        _ = ((C.u⁻¹ : Kˣ) ^ 6 * W₁.c₆) ^ 2 := by rw [WeierstrassCurve.variableChange_c₆ W₁ C]
        _ = ((C.u⁻¹ : Kˣ) : K) ^ 12 * W₁.c₆ ^ 2 := by ring
        _ = (φ (π ^ n))⁻¹ * φ (E.c₆ ^ 2) := by rw [hu_inv12, hW₁_c₆, ← map_pow]
        _ = φ (E.c₆ ^ 2 / π ^ n) := by rw [map_div₀, inv_mul_eq_div]
    have hv864 : v_val (-864 : K) = 1 := by
      have : (864 : K) = (2 : K) ^ 5 * (3 : K) ^ 3 := by norm_num
      rw [Valuation.map_neg, this, map_mul, map_pow, map_pow, hv2, hv3, one_pow, one_pow, mul_one]
    have hv_a₆_pow : v_val W₂.a₆ ^ 2 = v_val (φ (E.c₆ ^ 2 / π ^ n)) := by
      calc v_val W₂.a₆ ^ 2 = (v_val (-864 : K) * v_val W₂.a₆) ^ 2 := by rw [hv864, one_mul]
        _ = v_val ((-864 * W₂.a₆) ^ 2) := by rw [← map_mul, ← map_pow]
        _ = v_val (φ (E.c₆ ^ 2 / π ^ n)) := by rw [hW₂_c₆_pow]
    have hv_W₂_a₆ : v_val W₂.a₆ ≤ 1 := by
      have h_pow_le : v_val W₂.a₆ ^ 2 ≤ 1 := by
        rw [hv_a₆_pow, hv_le]; exact hc6_div_val
      by_contra h_gt
