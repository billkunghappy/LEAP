    ⟨Units.map spanHom, fun _ => rfl⟩
  obtain ⟨τ_u, hτ_u_val⟩ : ∃ τ_u : EllipticRootNumber.Pts F E →
      ((((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ →*
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ),
      ∀ S u, ((τ_u S u : (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ) :
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) =
        τ S (u : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) :=
    ⟨fun S => Units.map (τ S : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField →*
      ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField), fun _ _ => rfl⟩
  obtain ⟨σ_u, hσ_u_val⟩ : ∃ σ_u : EllipticRootNumber.AbsGal F →
