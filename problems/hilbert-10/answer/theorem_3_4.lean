      obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
      have hp_dvd_q : ringChar kF ∣ EllipticRootNumber.q F := by
        change ringChar kF ∣ Nat.card kF
        rw [Nat.card_eq_fintype_card, hcard_eq]
        exact dvd_pow_self (ringChar kF) k_card.ne_zero
      have h_ndvd2 : ¬ (ringChar kF ∣ 2) := by
        intro hdvd
        rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
        · exact hp_prime.ne_one h1
        · rw [h2] at hp_dvd_q
          exact hq2 hp_dvd_q
      haveI : CharP kF (ringChar kF) := ringChar.charP kF
      exact (CharP.cast_eq_zero_iff kF (ringChar kF) 2).not.mpr h_ndvd2
    obtain ⟨g, hg⟩ := IsCyclic.exists_monoid_generator (α := E₂ˣ)
    have h_card_E2 : Nat.card E₂ = EllipticRootNumber.q F * EllipticRootNumber.q F := by
      rw [Nat.card_congr (QuadraticAlgebra.equivProd d_bar 0), Nat.card_prod]
      rfl
    have h_ord_g : orderOf g = (EllipticRootNumber.q F - 1) * (EllipticRootNumber.q F + 1) := by
      rw [orderOf_eq_card_of_forall_mem_powers hg, Nat.card_units, h_card_E2]
      have h_le1 : 1 ≤ EllipticRootNumber.q F := by omega
      have h_le2 : 1 ≤ EllipticRootNumber.q F * EllipticRootNumber.q F := by nlinarith
      zify [h_le1, h_le2]
      ring
    let C_E2 : kF →+* E₂ :=
      { toFun := fun r => ⟨r, 0⟩
        map_one' := rfl
        map_mul' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_
          · change x * y = x * y + d_bar * 0 * 0
            ring
          · change (0 : kF) = x * 0 + 0 * y + 0 * 0 * 0
            ring
        map_zero' := rfl
        map_add' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_
          · rfl
          · change (0 : kF) = 0 + 0
            ring }
    let u_bar₀ : E₂ := ⟨0, 1⟩
    have hu_bar₀_ne : u_bar₀ ≠ 0 := by
      intro h0
      have : u_bar₀.im = (0 : E₂).im := congrArg QuadraticAlgebra.im h0
