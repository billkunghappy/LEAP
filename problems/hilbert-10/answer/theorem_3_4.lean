            algebraMap R L
              (WeierstrassCurve.Affine.CoordinateRing.YClass W
                (WeierstrassCurve.Affine.linePolynomial (σ x_A) (σ y_A) ℓ)) /
            algebraMap R L
              (WeierstrassCurve.Affine.CoordinateRing.XClass W (W.addX (σ x_A) (σ x_B) ℓ)) :=
          h_ℓ_step_some
            ((WeierstrassCurve.Affine.baseChange_nonsingular (W := E.toAffine) (f := f) x_A y_A f.injective).mpr h_A)
            ((WeierstrassCurve.Affine.baseChange_nonsingular (W := E.toAffine) (f := f) x_B y_B f.injective).mpr h_B)
        rw [h_lhs, h_rhs]
        by_cases hxy : x_A = x_B ∧ y_A = W.negY x_B y_B
        · have hxy_σ : σ x_A = σ x_B ∧ σ y_A = W.negY (σ x_B) (σ y_B) :=
            h_cond_iff.mpr hxy
          rw [if_pos hxy, if_pos hxy_σ]
          exact (hσ_step x_A 0 0).1
        · have hxy_σ : ¬(σ x_A = σ x_B ∧ σ y_A = W.negY (σ x_B) (σ y_B)) :=
            fun h => hxy (h_cond_iff.mp h)
          let ℓ := W.slope x_A x_B y_A y_B
          rw [if_neg hxy, if_neg hxy_σ,
            (hσ_step 0 0 0).2.2.1, (hσ_step x_A y_A ℓ).2.1,
            (hσ_step (W.addX x_A x_B ℓ) 0 0).1, h_slope_σ, ← h_addX_σ]
  · intro A B S
    obtain ⟨hτ_one, hτ_div⟩ := h_algEquiv_div (τ S)
    cases A with
    | zero =>
      change FractionalIdeal.spanSingleton (nonZeroDivisors R) (τ S 1) =
        ↑(I (0 - S) * I (B - S) * (I (0 + B - S))⁻¹ * (I (-S))⁻¹)
      have h_rhs : I (0 - S) * I (B - S) * (I (0 + B - S))⁻¹ * (I (-S))⁻¹ = 1 := by
        rw [zero_sub, zero_add]
        exact h_group_one (I (-S)) (I (B - S))
      rw [hτ_one, FractionalIdeal.spanSingleton_one, h_rhs, Units.val_one]
    | some h_A =>
      rename_i x_A y_A
      cases B with
      | zero =>
        change FractionalIdeal.spanSingleton (nonZeroDivisors R) (τ S 1) =
          ↑(I (WeierstrassCurve.Affine.Point.some h_A - S) * I (0 - S) *
            (I (WeierstrassCurve.Affine.Point.some h_A + 0 - S))⁻¹ * (I (-S))⁻¹)
        have h_rhs : I (WeierstrassCurve.Affine.Point.some h_A - S) * I (0 - S) *
            (I (WeierstrassCurve.Affine.Point.some h_A + 0 - S))⁻¹ * (I (-S))⁻¹ = 1 := by
          rw [zero_sub, add_zero,
            mul_comm (I (WeierstrassCurve.Affine.Point.some h_A - S)) (I (-S))]
          exact h_group_one (I (-S)) (I (WeierstrassCurve.Affine.Point.some h_A - S))
        rw [hτ_one, FractionalIdeal.spanSingleton_one, h_rhs, Units.val_one]
      | some h_B =>
        rename_i x_B y_B
        dsimp only [ℓ_step]
        by_cases hxy : x_A = x_B ∧ y_A = W.negY x_B y_B
        · rw [if_pos hxy, Units.val_mk0, h_vert_τ h_A S]
          have h_B_eq_nA : WeierstrassCurve.Affine.Point.some h_B =
              -WeierstrassCurve.Affine.Point.some h_A := by
            rcases hxy with ⟨hx, hy⟩
            subst hx
            have hy_B : y_B = W.negY x_A y_A := by rw [hy, W.negY_negY]
            subst hy_B
            exact (WeierstrassCurve.Affine.Point.neg_some h_A).symm
          have h_rhs : I (WeierstrassCurve.Affine.Point.some h_A - S) *
              I (-WeierstrassCurve.Affine.Point.some h_A - S) * (I (-S))⁻¹ * (I (-S))⁻¹ =
            I (WeierstrassCurve.Affine.Point.some h_A - S) *
              I (WeierstrassCurve.Affine.Point.some h_B - S) *
              (I (WeierstrassCurve.Affine.Point.some h_A +
                WeierstrassCurve.Affine.Point.some h_B - S))⁻¹ * (I (-S))⁻¹ := by
            rw [h_B_eq_nA, add_neg_cancel, zero_sub]
          rw [h_rhs]
        · rw [if_neg hxy, Units.val_mk0]
          let ℓ := W.slope x_A x_B y_A y_B
          let h_AB : W.Nonsingular (W.addX x_A x_B ℓ) (W.addY x_A x_B y_A ℓ) :=
            W.nonsingular_add h_A h_B hxy
          have h_AB_pt : WeierstrassCurve.Affine.Point.some h_A +
              WeierstrassCurve.Affine.Point.some h_B =
              WeierstrassCurve.Affine.Point.some h_AB :=
            WeierstrassCurve.Affine.Point.add_some hxy
          let num : L := algebraMap R L
            (WeierstrassCurve.Affine.CoordinateRing.YClass W
              (WeierstrassCurve.Affine.linePolynomial x_A y_A ℓ))
          let den : L := algebraMap R L
            (WeierstrassCurve.Affine.CoordinateRing.XClass W (W.addX x_A x_B ℓ))
          have h_mul_eq : τ S den * τ S (num / den) = τ S num :=
            hτ_div num den (hX_ne _)
          have h_den_span : FractionalIdeal.spanSingleton (nonZeroDivisors R) (τ S den) =
              ↑(I (WeierstrassCurve.Affine.Point.some h_A +
                  WeierstrassCurve.Affine.Point.some h_B - S) *
                I (-(WeierstrassCurve.Affine.Point.some h_A +
                  WeierstrassCurve.Affine.Point.some h_B) - S) *
                (I (-S))⁻¹ * (I (-S))⁻¹) := by
            have h0 := h_vert_τ h_AB S
            have h_rhs : I (WeierstrassCurve.Affine.Point.some h_AB - S) *
                I (-WeierstrassCurve.Affine.Point.some h_AB - S) * (I (-S))⁻¹ * (I (-S))⁻¹ =
              I (WeierstrassCurve.Affine.Point.some h_A +
                  WeierstrassCurve.Affine.Point.some h_B - S) *
                I (-(WeierstrassCurve.Affine.Point.some h_A +
                  WeierstrassCurve.Affine.Point.some h_B) - S) *
                (I (-S))⁻¹ * (I (-S))⁻¹ := by
              rw [h_AB_pt]
            exact h0.trans (congrArg Units.val h_rhs)
          exact h_group_div
            (FractionalIdeal.spanSingleton (nonZeroDivisors R))
            h_span_mul
            (τ S den) (τ S (num / den)) (τ S num)
            (I (WeierstrassCurve.Affine.Point.some h_A +
              WeierstrassCurve.Affine.Point.some h_B - S))
            (I (-(WeierstrassCurve.Affine.Point.some h_A +
              WeierstrassCurve.Affine.Point.some h_B) - S))
            (I (-S))
            (I (WeierstrassCurve.Affine.Point.some h_A - S))
            (I (WeierstrassCurve.Affine.Point.some h_B - S))
            h_mul_eq h_den_span (h_line_τ h_A h_B hxy S)

theorem weierstrass_functionField_translation_and_miller_step_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0) :
    ∃ (τ : EllipticRootNumber.Pts F E →
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃ₐ[AlgebraicClosure F]
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
      (σ_lift : EllipticRootNumber.AbsGal F →
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃+*
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
      (I : EllipticRootNumber.Pts F E →
        (FractionalIdeal
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ)
      (ℓ_step : EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E →
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ),
      τ 0 = AlgEquiv.refl ∧
      (∀ P Q : EllipticRootNumber.Pts F E, τ (P + Q) = (τ P).trans (τ Q)) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (c : AlgebraicClosure F),
        σ_lift σ (algebraMap (AlgebraicClosure F)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField c) =
        algebraMap (AlgebraicClosure F)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField (σ c)) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (S : EllipticRootNumber.Pts F E)
          (f : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField),
        σ_lift σ (τ S f) = τ (EllipticRootNumber.galHom F E σ S) (σ_lift σ f)) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (A B : EllipticRootNumber.Pts F E),
        σ_lift σ (ℓ_step A B : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) =
          (ℓ_step (EllipticRootNumber.galHom F E σ A)
            (EllipticRootNumber.galHom F E σ B) :
            ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)) ∧
      (∀ u v : (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ,
        FractionalIdeal.spanSingleton
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          (u : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) =
        FractionalIdeal.spanSingleton
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          (v : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) ↔
        ∃ c : (AlgebraicClosure F)ˣ,
          (u : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) =
            algebraMap (AlgebraicClosure F)
              ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
              (c : AlgebraicClosure F) *
            (v : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)) ∧
      I 0 = 1 ∧
      (∀ {x y : AlgebraicClosure F}
          (h : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x y),
        I (WeierstrassCurve.Affine.Point.some h) =
          WeierstrassCurve.Affine.CoordinateRing.XYIdeal' h) ∧
      (∀ P : EllipticRootNumber.Pts F E,
        Additive.ofMul (ClassGroup.mk (I P)) = WeierstrassCurve.Affine.Point.toClass P) ∧
      (∀ A B S : EllipticRootNumber.Pts F E,
        FractionalIdeal.spanSingleton
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          (τ S (ℓ_step A B : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)) =
          ↑(I (A - S) * I (B - S) * (I (A + B - S))⁻¹ * (I (-S))⁻¹)) ∧
      (∀ (P S : EllipticRootNumber.Pts F E)
          (a b : ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing),
        P ≠ 0 → P + S ≠ 0 → P ≠ S → P ≠ -S →
        algebraMap _ _ b ∉
          (I P : FractionalIdeal
            (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
            ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) →
        algebraMap _ _ b ∉
          (I (P + S) : FractionalIdeal
            (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
            ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) →
        τ S (algebraMap _ _ a) * algebraMap _ _ b =
          algebraMap _ _ a * τ S (algebraMap _ _ b) →
        algebraMap _ _ a ∈
          (I P : FractionalIdeal
            (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
            ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) →
        algebraMap _ _ a ∈
          (I (P + S) : FractionalIdeal
            (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
            ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)) :=
by
  let K := AlgebraicClosure F
  let W : WeierstrassCurve.Affine K := (E.baseChange K).toAffine
  let R := W.CoordinateRing
  let L := W.FunctionField
  let I : EllipticRootNumber.Pts F E → (FractionalIdeal (nonZeroDivisors R) L)ˣ :=
    fun P => match P with
      | WeierstrassCurve.Affine.Point.zero => 1
      | WeierstrassCurve.Affine.Point.some h =>
          WeierstrassCurve.Affine.CoordinateRing.XYIdeal' h
  have hI0 : I 0 = 1 := rfl
  have hI_some : ∀ {x y : K} (h : W.Nonsingular x y),
      I (WeierstrassCurve.Affine.Point.some h) =
        WeierstrassCurve.Affine.CoordinateRing.XYIdeal' h :=
    fun _ => rfl
  have hI_class : ∀ P : EllipticRootNumber.Pts F E,
      Additive.ofMul (ClassGroup.mk (I P)) = WeierstrassCurve.Affine.Point.toClass P := by
    intro P
    rw [WeierstrassCurve.Affine.Point.toClass_apply]
    cases P with
    | zero => simp [I]
    | some _ => rfl
  have h_span_eq : ∀ u v : Lˣ,
      FractionalIdeal.spanSingleton (nonZeroDivisors R) (u : L) =
        FractionalIdeal.spanSingleton (nonZeroDivisors R) (v : L) ↔
      ∃ c : Kˣ, (u : L) = algebraMap K L (c : K) * (v : L) := by
    intro u v
    haveI : Module.IsTorsionFree W.CoordinateRing W.FunctionField :=
      Module.IsTorsionFree.of_smul_eq_zero fun r m h => by
        rw [Algebra.smul_def, mul_eq_zero,
          map_eq_zero_iff _ (IsFractionRing.injective W.CoordinateRing W.FunctionField)] at h
        exact h
    rw [FractionalIdeal.spanSingleton_eq_spanSingleton]
    constructor
    · rintro ⟨z, hz⟩
      have hz' : algebraMap R L (z : R) * (u : L) = (v : L) := by
        simpa [Units.smul_def, Algebra.smul_def] using hz
      let w : Rˣ := z⁻¹
      have hw_mul : algebraMap R L (w : R) * algebraMap R L (z : R) = 1 := by
        rw [← map_mul, Units.inv_mul, map_one]
      have hu : (u : L) = algebraMap R L (w : R) * (v : L) := by
        calc (u : L) = 1 * (u : L) := (one_mul _).symm
          _ = (algebraMap R L (w : R) * algebraMap R L (z : R)) * (u : L) := by rw [hw_mul]
          _ = algebraMap R L (w : R) * (algebraMap R L (z : R) * (u : L)) := mul_assoc _ _ _
          _ = algebraMap R L (w : R) * (v : L) := by rw [hz']
      haveI : Module.Free (Polynomial K) W.CoordinateRing :=
        Module.Free.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
      haveI : Module.Finite (Polynomial K) W.CoordinateRing :=
        Module.Finite.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
      have hw_unit : IsUnit (Algebra.norm (Polynomial K) (w : R)) :=
        IsUnit.map (Algebra.norm (Polynomial K)) w.isUnit
      have h_deg0 : (Algebra.norm (Polynomial K) (w : R)).degree = 0 :=
        Polynomial.degree_eq_zero_of_isUnit hw_unit
      obtain ⟨p, q, hpq⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq (w : R)
      have h_deg : (Algebra.norm (Polynomial K) (w : R)).degree =
          max (2 • p.degree) (2 • q.degree + 3) := by
        rw [← hpq]
        exact WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W) p q
      rw [h_deg0] at h_deg
      have hq0 : q = 0 := by
        by_contra hq
        have hq_deg : q.degree = (q.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hq
        have h1 : 2 • q.degree + 3 ≤ 0 := by
          rw [h_deg]
          exact le_max_right _ _
        change 2 • q.degree + ((3 : ℕ) : WithBot ℕ) ≤ ((0 : ℕ) : WithBot ℕ) at h1
        rw [hq_deg, two_nsmul, ← Nat.cast_add, ← Nat.cast_add] at h1
        have h1' : q.natDegree + q.natDegree + 3 ≤ 0 := by exact_mod_cast h1
        omega
      subst hq0
      have h_bot : (2 • (0 : Polynomial K).degree + 3 : WithBot ℕ) = ⊥ := rfl
      rw [h_bot, max_bot_right] at h_deg
      have hp_ne : p ≠ 0 := by
        rintro rfl
        have h0 : ((2 • (0 : Polynomial K).degree : WithBot ℕ)) = ⊥ := rfl
        rw [h0] at h_deg
        exact WithBot.bot_ne_zero h_deg.symm
      have hp_deg_nat : p.degree = (p.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hp_ne
      have hp_deg0 : p.degree = 0 := by
        change ((0 : ℕ) : WithBot ℕ) = 2 • p.degree at h_deg
        rw [hp_deg_nat, two_nsmul, ← Nat.cast_add] at h_deg
        have hp_nd0 : 0 = p.natDegree + p.natDegree := by exact_mod_cast h_deg
        have hp_nd0' : p.natDegree = 0 := by omega
        rw [hp_deg_nat, hp_nd0', Nat.cast_zero]
      have hp_eq : p = Polynomial.C (p.coeff 0) := Polynomial.eq_C_of_degree_eq_zero hp_deg0
      have hc_ne : p.coeff 0 ≠ 0 := by
        intro hc0
        apply hp_ne
        rw [hp_eq, hc0, map_zero]
      let c : Kˣ := Units.mk0 (p.coeff 0) hc_ne
      refine ⟨c, ?_⟩
      have hw_eq : (w : R) = algebraMap K R (c : K) := by
        rw [← hpq, zero_smul, add_zero, hp_eq,
          IsScalarTower.algebraMap_apply K (Polynomial K) R (c : K),
          Polynomial.algebraMap_eq, Algebra.algebraMap_eq_smul_one]
        rfl
      rw [hu, hw_eq, IsScalarTower.algebraMap_apply K R L (c : K)]
    · rintro ⟨c, hc⟩
      let z : Rˣ := Units.map (algebraMap K R).toMonoidHom c⁻¹
      refine ⟨z, ?_⟩
      rw [Units.smul_def, Algebra.smul_def]
      have hz_eq : algebraMap R L (z : R) = algebraMap K L ((c⁻¹ : Kˣ) : K) := by
        change algebraMap R L (algebraMap K R ((c⁻¹ : Kˣ) : K)) = _
        rw [← IsScalarTower.algebraMap_apply K R L]
      rw [hz_eq, hc, ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
  obtain ⟨τ, σ_lift, hτ_zero, hτ_add, hσ_alg, hσ_XY, hσ_τ, hτ_some⟩ :=
    weierstrass_functionField_translation_and_galois_lift_spec F E hΔ
  obtain ⟨h_line_zero, h_vert_τ⟩ :=
    weierstrass_functionField_vertical_line_spanSingleton K W τ I hτ_zero hτ_some hI0 hI_some
  obtain ⟨ℓ_step, hσ_ℓ, h_span_τ_ℓ⟩ :=
    weierstrass_functionField_miller_step_and_galois_spec F E hΔ τ σ_lift I hτ_zero hσ_alg
      hσ_XY hτ_some hI0 hI_some h_line_zero h_vert_τ
  have hτ_eval :
      ∀ (P S : EllipticRootNumber.Pts F E) (a b : R),
        P ≠ 0 → P + S ≠ 0 → P ≠ S → P ≠ -S →
        algebraMap R L b ∉ (I P : FractionalIdeal (nonZeroDivisors R) L) →
        algebraMap R L b ∉ (I (P + S) : FractionalIdeal (nonZeroDivisors R) L) →
        τ S (algebraMap R L a) * algebraMap R L b =
          algebraMap R L a * τ S (algebraMap R L b) →
        algebraMap R L a ∈ (I P : FractionalIdeal (nonZeroDivisors R) L) →
        algebraMap R L a ∈ (I (P + S) : FractionalIdeal (nonZeroDivisors R) L) := by
    intro P S a b hP0 _hPS0 hPS hPnS hbP _hbPS h_eq haP
    let X_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)
    let Y_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X
    cases S with
    | zero =>
      change algebraMap R L a ∈ (I (P + 0) : FractionalIdeal (nonZeroDivisors R) L)
      rwa [add_zero]
    | some h_S =>
      rename_i x_S y_S
      cases P with
      | zero => exact absurd rfl hP0
      | some h_P =>
        rename_i x_P y_P
        have hx_ne : x_P ≠ x_S := by
          intro hx
          subst hx
          by_cases hy : y_P = W.negY x_P y_S
          · apply hPnS
            rw [WeierstrassCurve.Affine.Point.neg_some]
            congr 1
          · apply hPS
            have hy_eq : y_P = y_S := W.Y_eq_of_Y_ne h_P.1 h_S.1 rfl hy
            subst hy_eq
            rfl
        have hxy : ¬(x_P = x_S ∧ y_P = W.negY x_S y_S) := fun h => hx_ne h.1
        have h_PS_eq : WeierstrassCurve.Affine.Point.some h_P +
            WeierstrassCurve.Affine.Point.some h_S =
            WeierstrassCurve.Affine.Point.some (W.nonsingular_add h_P h_S hxy) :=
          WeierstrassCurve.Affine.Point.add_of_X_ne hx_ne
        let h_PS := W.nonsingular_add h_P h_S hxy
        let ℓ := W.slope x_P x_S y_P y_S
        let x_PS := W.addX x_P x_S ℓ
        let y_PS := W.addY x_P x_S y_P ℓ
        have hℓ_eq : ℓ * (x_P - x_S) = y_P - y_S := by
          change W.slope x_P x_S y_P y_S * (x_P - x_S) = y_P - y_S
          rw [W.slope_of_X_ne hx_ne, div_mul_cancel₀ _ (sub_ne_zero.mpr hx_ne)]
        let evalPt : ∀ {x y : K} (h : W.Nonsingular x y), R →ₐ[K] K := fun {x y} h =>
          (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv h.1).toAlgHom.comp
            (Ideal.Quotient.mkₐ K (WeierstrassCurve.Affine.CoordinateRing.XYIdeal W x (Polynomial.C y)))
        have h_mem_iff : ∀ {x y : K} (h : W.Nonsingular x y) (r : R),
            algebraMap R L r ∈
              (I (WeierstrassCurve.Affine.Point.some h) : FractionalIdeal (nonZeroDivisors R) L) ↔
              evalPt h r = 0 := by
          intro x y h r
          rw [hI_some h, WeierstrassCurve.Affine.CoordinateRing.XYIdeal'_eq h,
            FractionalIdeal.mem_coeIdeal]
          have h_inj := IsFractionRing.injective R L
          constructor
          · rintro ⟨r', hr', h_eq'⟩
            have hr_eq : r = r' := h_inj h_eq'.symm
            subst hr_eq
            change (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv h.1)
              (Ideal.Quotient.mk (WeierstrassCurve.Affine.CoordinateRing.XYIdeal W x (Polynomial.C y)) r) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr', map_zero]
          · intro h0
            change (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv h.1)
              (Ideal.Quotient.mk (WeierstrassCurve.Affine.CoordinateRing.XYIdeal W x (Polynomial.C y)) r) = 0 at h0
            have h0' :
                Ideal.Quotient.mk
                  (WeierstrassCurve.Affine.CoordinateRing.XYIdeal W x (Polynomial.C y)) r = 0 :=
              (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv h.1).injective
                (h0.trans (map_zero _).symm)
            exact ⟨r, Ideal.Quotient.eq_zero_iff_mem.mp h0', rfl⟩
        have h_eval_X : ∀ {x y : K} (h : W.Nonsingular x y), evalPt h X_R = x := by
          intro x y h
          have h_sub : X_R - algebraMap K R x ∈
              WeierstrassCurve.Affine.CoordinateRing.XYIdeal W x (Polynomial.C y) := by
            have h_xc : X_R - algebraMap K R x = WeierstrassCurve.Affine.CoordinateRing.XClass W x := by
              change WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X) -
                WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C x)) =
                WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.X - Polynomial.C x))
              rw [← map_sub, ← map_sub]
            rw [h_xc]
            exact Ideal.subset_span (Set.mem_insert _ _)
          have h0 : evalPt h (X_R - algebraMap K R x) = 0 := by
            change (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv h.1)
              (Ideal.Quotient.mk _ (X_R - algebraMap K R x)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr h_sub, map_zero]
          rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_eq_zero] at h0
          exact h0
        have h_eval_Y : ∀ {x y : K} (h : W.Nonsingular x y), evalPt h Y_R = y := by
          intro x y h
          have h_sub : Y_R - algebraMap K R y ∈
              WeierstrassCurve.Affine.CoordinateRing.XYIdeal W x (Polynomial.C y) := by
            have h_yc : Y_R - algebraMap K R y =
                WeierstrassCurve.Affine.CoordinateRing.YClass W (Polynomial.C y) := by
              change WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X -
                WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C y)) =
                WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.X - Polynomial.C (Polynomial.C y))
              rw [← map_sub]
            rw [h_yc]
            exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
          have h0 : evalPt h (Y_R - algebraMap K R y) = 0 := by
            change (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv h.1)
              (Ideal.Quotient.mk _ (Y_R - algebraMap K R y)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr h_sub, map_zero]
          rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_eq_zero] at h0
          exact h0
        let u_S : R := X_R - algebraMap K R x_S
        let v_S : R := Y_R - algebraMap K R y_S
        have hu_eval : evalPt h_P u_S = x_P - x_S := by
          simp only [u_S, map_sub, h_eval_X, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
        have hv_eval : evalPt h_P v_S = y_P - y_S := by
          simp only [v_S, map_sub, h_eval_Y, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
        have hu_ne_R : u_S ≠ 0 := by
          intro h0
          apply sub_ne_zero.mpr hx_ne
          rw [← hu_eval, h0, map_zero]
        have hu_ne_L : algebraMap R L u_S ≠ 0 :=
          (map_ne_zero_iff _ (IsFractionRing.injective R L)).mpr hu_ne_R
        obtain ⟨hτX, hτY⟩ := hτ_some h_S
        have h_alg_K : ∀ c : K, algebraMap R L (algebraMap K R c) = algebraMap K L c :=
          fun c => (IsScalarTower.algebraMap_apply K R L c).symm
        have hu_L : algebraMap R L u_S =
            algebraMap R L X_R - algebraMap K L x_S := by
          simp only [u_S, map_sub, h_alg_K]
        have hv_L : algebraMap R L v_S =
            algebraMap R L Y_R - algebraMap K L y_S := by
          simp only [v_S, map_sub, h_alg_K]
        let m : L :=
          (algebraMap R L Y_R - algebraMap K L y_S) /
            (algebraMap R L X_R - algebraMap K L x_S)
        have hm_mul : m * algebraMap R L u_S = algebraMap R L v_S := by
          change ((algebraMap R L Y_R - algebraMap K L y_S) /
              (algebraMap R L X_R - algebraMap K L x_S)) *
            algebraMap R L u_S = algebraMap R L v_S
          rw [← hu_L, ← hv_L]
          exact div_mul_cancel₀ _ hu_ne_L
        let x_tilde : R :=
          v_S ^ 2 + algebraMap K R W.a₁ * v_S * u_S -
            (algebraMap K R W.a₂ + X_R + algebraMap K R x_S) * u_S ^ 2
        have hx_tilde_L :
            (algebraMap R L u_S) ^ 2 *
              τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L X_R) =
              algebraMap R L x_tilde := by
          change (algebraMap R L u_S) ^ 2 *
              τ (WeierstrassCurve.Affine.Point.some h_S)
                (algebraMap W.CoordinateRing W.FunctionField
                  (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))) = _
          rw [hτX]
          change (algebraMap R L u_S) ^ 2 *
              (m ^ 2 + algebraMap K L W.a₁ * m -
                algebraMap K L W.a₂ - algebraMap R L X_R - algebraMap K L x_S) = _
          simp only [x_tilde, map_sub, map_add, map_mul, map_pow, h_alg_K]
          linear_combination
            (m * algebraMap R L u_S + algebraMap R L v_S +
              algebraMap K L W.a₁ * algebraMap R L u_S) * hm_mul
        have hx_tilde_eval : evalPt h_P x_tilde = (x_P - x_S) ^ 2 * evalPt h_PS X_R := by
          rw [h_eval_X h_PS]
          change evalPt h_P x_tilde = (x_P - x_S) ^ 2 * (ℓ ^ 2 + W.a₁ * ℓ - W.a₂ - x_P - x_S)
          simp only [x_tilde, map_sub, map_add, map_mul, map_pow, hu_eval, hv_eval, h_eval_X,
            AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
          linear_combination (y_P - y_S + ℓ * (x_P - x_S) + W.a₁ * (x_P - x_S)) * (-hℓ_eq)
        let y_tilde : R :=
          -v_S * (x_tilde - X_R * u_S ^ 2) - Y_R * u_S ^ 3 -
            algebraMap K R W.a₁ * u_S * x_tilde - algebraMap K R W.a₃ * u_S ^ 3
        have hy_tilde_L :
            (algebraMap R L u_S) ^ 3 *
              τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L Y_R) =
              algebraMap R L y_tilde := by
          change (algebraMap R L u_S) ^ 3 *
              τ (WeierstrassCurve.Affine.Point.some h_S)
                (algebraMap W.CoordinateRing W.FunctionField
                  (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)) = _
          rw [hτY]
          change (algebraMap R L u_S) ^ 3 *
              (-m *
                (τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L X_R) -
                  algebraMap R L X_R) -
                algebraMap R L Y_R -
                algebraMap K L W.a₁ *
                  τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L X_R) -
                algebraMap K L W.a₃) = _
          have h_sub_y : algebraMap R L y_tilde =
              -algebraMap R L v_S * (algebraMap R L x_tilde - algebraMap R L X_R * (algebraMap R L u_S) ^ 2) -
                algebraMap R L Y_R * (algebraMap R L u_S) ^ 3 -
                algebraMap K L W.a₁ * algebraMap R L u_S * algebraMap R L x_tilde -
                algebraMap K L W.a₃ * (algebraMap R L u_S) ^ 3 := by
            simp only [y_tilde, map_sub, map_neg, map_mul, map_pow, h_alg_K]
          rw [h_sub_y, ← hx_tilde_L]
          linear_combination
            -(algebraMap R L u_S) ^ 2 *
              (τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L X_R) -
                algebraMap R L X_R) * hm_mul
        have hy_tilde_eval : evalPt h_P y_tilde = (x_P - x_S) ^ 3 * evalPt h_PS Y_R := by
          rw [h_eval_Y h_PS]
          change evalPt h_P y_tilde =
            (x_P - x_S) ^ 3 * (-(ℓ * (x_PS - x_P) + y_P) - W.a₁ * x_PS - W.a₃)
          have hx_PS_eval : evalPt h_P x_tilde = (x_P - x_S) ^ 2 * x_PS := by
            rw [hx_tilde_eval, h_eval_X h_PS]
          simp only [y_tilde, map_sub, map_neg, map_mul, map_pow, hu_eval, hv_eval, h_eval_X,
            h_eval_Y, hx_PS_eval, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
          linear_combination (x_P - x_S) ^ 2 * (x_PS - x_P) * hℓ_eq
        let P_prop : R → Prop := fun r =>
          ∃ (k : ℕ) (r' : R),
            (algebraMap R L u_S) ^ k *
              τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r) =
              algebraMap R L r' ∧
            evalPt h_P r' = (x_P - x_S) ^ k * evalPt h_PS r
        have hP_const : ∀ c : K, P_prop (algebraMap K R c) := by
          intro c
          refine ⟨0, algebraMap K R c, ?_, ?_⟩
          · rw [pow_zero, one_mul, h_alg_K, AlgEquiv.commutes]
          · rw [pow_zero, one_mul, AlgHom.commutes, AlgHom.commutes]
        have hP_X : P_prop X_R := ⟨2, x_tilde, hx_tilde_L, hx_tilde_eval⟩
        have hP_Y : P_prop Y_R := ⟨3, y_tilde, hy_tilde_L, hy_tilde_eval⟩
        have hP_add : ∀ {r₁ r₂ : R}, P_prop r₁ → P_prop r₂ → P_prop (r₁ + r₂) := by
          rintro r₁ r₂ ⟨k₁, r₁', hL₁, he₁⟩ ⟨k₂, r₂', hL₂, he₂⟩
          refine ⟨k₁ + k₂, u_S ^ k₂ * r₁' + u_S ^ k₁ * r₂', ?_, ?_⟩
          · rw [map_add, map_add, mul_add, pow_add,
              show (algebraMap R L u_S) ^ k₁ * (algebraMap R L u_S) ^ k₂ *
                τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₁) =
                (algebraMap R L u_S) ^ k₂ *
                  ((algebraMap R L u_S) ^ k₁ *
                    τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₁)) by ring,
              show (algebraMap R L u_S) ^ k₁ * (algebraMap R L u_S) ^ k₂ *
                τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₂) =
                (algebraMap R L u_S) ^ k₁ *
                  ((algebraMap R L u_S) ^ k₂ *
                    τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₂)) by ring,
              hL₁, hL₂, map_add, map_mul, map_mul, map_pow, map_pow]
          · rw [map_add, map_mul, map_mul, map_pow, map_pow, hu_eval, he₁, he₂, map_add]
            ring
        have hP_mul : ∀ {r₁ r₂ : R}, P_prop r₁ → P_prop r₂ → P_prop (r₁ * r₂) := by
          rintro r₁ r₂ ⟨k₁, r₁', hL₁, he₁⟩ ⟨k₂, r₂', hL₂, he₂⟩
          refine ⟨k₁ + k₂, r₁' * r₂', ?_, ?_⟩
          · rw [map_mul, map_mul, pow_add,
              show (algebraMap R L u_S) ^ k₁ * (algebraMap R L u_S) ^ k₂ *
                (τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₁) *
                  τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₂)) =
                ((algebraMap R L u_S) ^ k₁ *
                  τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₁)) *
                  ((algebraMap R L u_S) ^ k₂ *
                    τ (WeierstrassCurve.Affine.Point.some h_S) (algebraMap R L r₂)) by ring,
              hL₁, hL₂, map_mul]
          · rw [map_mul, he₁, he₂, map_mul]
            ring
        have hP_X_pow : ∀ n : ℕ, P_prop (X_R ^ n) := by
          intro n
          induction n with
          | zero =>
            rw [pow_zero, ← map_one (algebraMap K R)]
            exact hP_const 1
          | succ n ih =>
            rw [pow_succ]
            exact hP_mul ih hP_X
        have hP_poly : ∀ p : Polynomial K, P_prop (p • (1 : R)) := by
          intro p
          rw [Algebra.smul_def, mul_one]
          induction p using Polynomial.induction_on' with
          | add p q hp hq =>
            rw [map_add]
            exact hP_add hp hq
          | monomial n c =>
            have h_mon : algebraMap (Polynomial K) R (Polynomial.monomial n c) =
                algebraMap K R c * X_R ^ n := by
              rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
                ← Polynomial.algebraMap_eq,
                ← IsScalarTower.algebraMap_apply K (Polynomial K) R c]
              rfl
            rw [h_mon]
            exact hP_mul (hP_const c) (hP_X_pow n)
        have hP_all : ∀ r : R, P_prop r := by
          intro r
          obtain ⟨p, q, hpq⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq r
          rw [← hpq]
          apply hP_add (hP_poly p)
          have hqY : q • Y_R = (q • (1 : R)) * Y_R := by
            rw [Algebra.smul_def, Algebra.smul_def, mul_one]
          rw [hqY]
          exact hP_mul (hP_poly q) hP_Y
        obtain ⟨ka, a', hLa, hea⟩ := hP_all a
        obtain ⟨kb, b', hLb, heb⟩ := hP_all b
        have h_mul_eq :
            algebraMap R L (u_S ^ kb * a' * b) = algebraMap R L (u_S ^ ka * a * b') := by
          rw [map_mul, map_mul, map_pow, map_mul, map_mul, map_pow, ← hLa, ← hLb]
          linear_combination (algebraMap R L u_S) ^ (ka + kb) * h_eq
        have h_R_eq : u_S ^ kb * a' * b = u_S ^ ka * a * b' :=
          IsFractionRing.injective R L h_mul_eq
        have h_eval_eq := congrArg (evalPt h_P) h_R_eq
        rw [map_mul, map_mul, map_pow, hu_eval, hea,
          map_mul, map_mul, map_pow, hu_eval, heb] at h_eval_eq
        have haP_0 : evalPt h_P a = 0 := (h_mem_iff h_P a).mp haP
        have hbP_ne : evalPt h_P b ≠ 0 := fun h0 => hbP ((h_mem_iff h_P b).mpr h0)
        rw [haP_0, mul_zero, zero_mul] at h_eval_eq
        have h_prod_zero : (x_P - x_S) ^ (ka + kb) * evalPt h_PS a * evalPt h_P b = 0 := by
          linear_combination h_eval_eq
        have h_u_pow_ne : (x_P - x_S) ^ (ka + kb) ≠ 0 :=
          pow_ne_zero (ka + kb) (sub_ne_zero.mpr hx_ne)
        rcases mul_eq_zero.mp h_prod_zero with h1 | h2
        · rcases mul_eq_zero.mp h1 with h1a | h1b
          · exact absurd h1a h_u_pow_ne
          · rw [h_PS_eq, h_mem_iff h_PS a]
            exact h1b
        · exact absurd h2 hbP_ne
  exact ⟨τ, σ_lift, I, ℓ_step, hτ_zero, hτ_add, hσ_alg, hσ_τ, hσ_ℓ, h_span_eq,
    hI0, hI_some, hI_class, h_span_τ_ℓ, hτ_eval⟩

theorem weierstrass_torsion_coset_invariant_divisor_zero (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F)
    (τ : EllipticRootNumber.Pts F E →
      (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃ₐ[AlgebraicClosure F]
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
    (I : EllipticRootNumber.Pts F E →
      (FractionalIdeal
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ)
    (hI0 : I 0 = 1)
    (hI_some : ∀ {x y : AlgebraicClosure F}
        (h : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x y),
      I (WeierstrassCurve.Affine.Point.some h) =
        WeierstrassCurve.Affine.CoordinateRing.XYIdeal' h)
    (hI_class : ∀ P : EllipticRootNumber.Pts F E,
      Additive.ofMul (ClassGroup.mk (I P)) = WeierstrassCurve.Affine.Point.toClass P)
    (hτ_eval : ∀ (P S : EllipticRootNumber.Pts F E)
        (a b : ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing),
      P ≠ 0 → P + S ≠ 0 → P ≠ S → P ≠ -S →
      algebraMap _ _ b ∉
        (I P : FractionalIdeal
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) →
      algebraMap _ _ b ∉
        (I (P + S) : FractionalIdeal
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) →
      τ S (algebraMap _ _ a) * algebraMap _ _ b =
        algebraMap _ _ a * τ S (algebraMap _ _ b) →
      algebraMap _ _ a ∈
        (I P : FractionalIdeal
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) →
      algebraMap _ _ a ∈
        (I (P + S) : FractionalIdeal
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
    (k : ℕ) [Fintype (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)))]
    (h_card_m : Fintype.card
      (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) =
      (EllipticRootNumber.ell F ^ (k + 1)) ^ 2)
    (T T' Q₁ : EllipticRootNumber.Pts F E)
    (g : (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ)
    (hT : (EllipticRootNumber.ell F ^ (k + 1)) • T = 0)
    (hT' : (EllipticRootNumber.ell F ^ (k + 1)) • T' = T)
    (hQ₁ : (EllipticRootNumber.ell F ^ (k + 1)) • Q₁ = T')
    (hg_span : FractionalIdeal.spanSingleton
      (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
      (g : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) =
      ↑(∏ R : EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)),
        I (T' + R.1) * (I R.1)⁻¹))
    (hg_inv : ∀ S : EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)),
      τ S.1 (g : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) =
        (g : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)) :
    T = 0 :=
by
  obtain rfl : ‹DecidableEq (AlgebraicClosure F)› =
      (fun a b => Classical.propDecidable (a = b)) :=
    Subsingleton.elim _ _
  have h_main :
      ∀ (K : Type u) [Field K] [DecidableEq K]
        (W : WeierstrassCurve.Affine K)
        (I : W.Point →
          (FractionalIdeal (nonZeroDivisors W.CoordinateRing) W.FunctionField)ˣ)
        (hI0 : I 0 = 1)
        (hI_some : ∀ {x y : K} (h : W.Nonsingular x y),
          I (WeierstrassCurve.Affine.Point.some h) =
            WeierstrassCurve.Affine.CoordinateRing.XYIdeal' h)
        (m : ℕ) (_hm_odd : Odd m)
        (M : AddSubgroup W.Point) [Fintype M]
        (_hM_tors : ∀ P : W.Point, P ∈ M ↔ m • P = 0)
        (_h_card_m : Fintype.card M = m ^ 2)
        (τ : W.Point → (W.FunctionField ≃ₐ[K] W.FunctionField))
        (_hI_class : ∀ P : W.Point,
          Additive.ofMul (ClassGroup.mk (I P)) = WeierstrassCurve.Affine.Point.toClass P)
        (_hτ_eval : ∀ (P S : W.Point) (a b : W.CoordinateRing),
          P ≠ 0 → P + S ≠ 0 → P ≠ S → P ≠ -S →
          algebraMap _ _ b ∉
            (I P : FractionalIdeal (nonZeroDivisors W.CoordinateRing) W.FunctionField) →
          algebraMap _ _ b ∉
            (I (P + S) : FractionalIdeal (nonZeroDivisors W.CoordinateRing) W.FunctionField) →
          τ S (algebraMap _ _ a) * algebraMap _ _ b =
            algebraMap _ _ a * τ S (algebraMap _ _ b) →
          algebraMap _ _ a ∈
            (I P : FractionalIdeal (nonZeroDivisors W.CoordinateRing) W.FunctionField) →
          algebraMap _ _ a ∈
            (I (P + S) : FractionalIdeal (nonZeroDivisors W.CoordinateRing) W.FunctionField))
        (T T' Q₁ : W.Point) (g : W.FunctionFieldˣ),
        m • T = 0 →
        m • T' = T →
        m • Q₁ = T' →
        FractionalIdeal.spanSingleton (nonZeroDivisors W.CoordinateRing) (g : W.FunctionField) =
          ↑(∏ R : M, I (T' + R.1) * (I R.1)⁻¹) →
        (∀ S : M, τ S.1 (g : W.FunctionField) = (g : W.FunctionField)) →
        T = 0 := by
    clear! F
    intro K _ _ W I hI0 hI_some
    haveI : Module.Free (Polynomial K) W.CoordinateRing :=
      Module.Free.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
    haveI : Module.Finite (Polynomial K) W.CoordinateRing :=
      Module.Finite.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
    have h_eval_mem :
