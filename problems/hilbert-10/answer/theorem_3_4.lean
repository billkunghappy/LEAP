      rw [show (EllipticRootNumber.q F - 1) * (2 * k_u) =
            k_u * (EllipticRootNumber.q F - 1) * 2 by ring,
          ← h_ord_g, orderOf_dvd_iff_pow_eq_one]
      exact hg_pow_sq1
    have hndvd_1 :
        ¬ ((EllipticRootNumber.q F - 1) * (EllipticRootNumber.q F + 1) ∣
