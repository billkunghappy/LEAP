          = (v x₁ * v x₂) ^ 3 := (pow_succ' _ 2).symm
        _ = v x₁ ^ 3 * v x₂ ^ 3 := mul_pow _ _ 3
        _ = v y₁ ^ 2 * v y₂ ^ 2 := by rw [← hy₁, ← hy₂]
        _ = (v y₁ * v y₂) ^ 2 := (mul_pow _ _ 2).symm
        _ ≤ (r * (v x₁ * v x₂) * v M) ^ 2 := pow_le_pow_left' hM 2
        _ = (r ^ 2 * v M ^ 2) * (v x₁ * v x₂) ^ 2 := by
            rw [mul_pow, mul_pow, mul_right_comm (r ^ 2)]
    have hx123_M2 : (v x₁ * v x₂) * v x₃ = v M ^ 2 := by
      have h_eq : x₁ * x₂ * x₃ = M ^ 2 + (W.a₃ * M - W.a₆) := by linear_combination he₃
      have h_rem : v (W.a₃ * M - W.a₆) < v (M ^ 2) := by
        rw [map_pow]
        apply v.map_sub_lt
        · rw [map_mul]
          exact (mul_le_of_le_one_left' ha₃).trans_lt hM_lt_sq
        · exact ha₆.trans_lt (hM_gt1.trans hM_lt_sq)
      have h_val := congrArg v h_eq
      rw [map_mul, map_mul, Valuation.map_add_eq_of_lt_left v h_rem, map_pow] at h_val
      exact h_val
    have hr2_x₃ : 1 ≤ r ^ 2 * v x₃ := by
      apply le_of_mul_le_mul_left _ hx12_pos
      calc (v x₁ * v x₂) * 1 = v x₁ * v x₂ := mul_one _
        _ ≤ r ^ 2 * v M ^ 2 := hx12_le_M2
        _ = r ^ 2 * ((v x₁ * v x₂) * v x₃) := by rw [← hx123_M2]
        _ = (v x₁ * v x₂) * (r ^ 2 * v x₃) := by rw [← mul_assoc, mul_comm (r ^ 2), mul_assoc]
    have hx₃_pos : 0 < v x₃ := by
      by_contra! hle
      have h0 : v x₃ = 0 := le_antisymm hle zero_le'
      rw [h0, mul_zero] at hr2_x₃
      exact not_lt_of_ge hr2_x₃ zero_lt_one
    have hx₃_gt1 : 1 < v x₃ :=
      hr2_x₃.trans_lt (mul_lt_of_lt_one_left hx₃_pos hr2_lt1)
    refine ⟨hx₃_gt1, ?_⟩
    intro hy₃
    have h_sq_inj : ∀ {a b : WithZero (Multiplicative ℤ)}, a ^ 2 = b ^ 2 → a = b := by
      intro a b hab
      rcases lt_trichotomy a b with hlt | rfl | hgt
      · exact False.elim (ne_of_lt (by rw [sq, sq]; exact mul_lt_mul' (le_of_lt hlt) hlt zero_le' (zero_le'.trans_lt hlt)) hab)
      · rfl
      · exact False.elim (ne_of_gt (by rw [sq, sq]; exact mul_lt_mul' (le_of_lt hgt) hgt zero_le' (zero_le'.trans_lt hgt)) hab)
    have hy123_M3 : v y₁ * v y₂ * v y₃ = v M ^ 3 := by
      apply h_sq_inj
      calc (v y₁ * v y₂ * v y₃) ^ 2
          = v y₁ ^ 2 * v y₂ ^ 2 * v y₃ ^ 2 := by rw [mul_pow, mul_pow]
        _ = v x₁ ^ 3 * v x₂ ^ 3 * v x₃ ^ 3 := by rw [hy₁, hy₂, hy₃]
        _ = (v x₁ * v x₂ * v x₃) ^ 3 := by rw [← mul_pow, ← mul_pow]
        _ = (v M ^ 2) ^ 3 := by rw [hx123_M2]
        _ = (v M ^ 3) ^ 2 := by rw [← pow_mul, mul_comm 2 3, pow_mul]
    have hy₁_ne : y₁ ≠ 0 := by intro h0; rw [h0, map_zero] at hy₁_pos; exact lt_irrefl 0 hy₁_pos
    have hy₂_ne : y₂ ≠ 0 := by intro h0; rw [h0, map_zero] at hy₂_pos; exact lt_irrefl 0 hy₂_pos
    have hy123_pos : 0 < v y₁ * v y₂ * v y₃ := by
      rw [hy123_M3]; exact pow_pos hM_pos 3
    have hy₃_ne : y₃ ≠ 0 := by
      intro h0; rw [h0, map_zero, mul_zero] at hy123_pos; exact lt_irrefl 0 hy123_pos
    have hy₁_M : y₁ = L_sl * x₁ + M := by dsimp only [M]; ring
    have hy₃_M : y₃ = -(L_sl * x₃ + M) - W.a₁ * x₃ - W.a₃ := by
      dsimp only [y₃, x₃, M]
      unfold WeierstrassCurve.Affine.addY WeierstrassCurve.Affine.negY WeierstrassCurve.Affine.negAddY
      ring
    have h_id4 : x₃ * y₁ * y₂ - x₁ * y₂ * y₃ - x₂ * y₁ * y₃ =
        (W.a₁ * x₃ + W.a₃) * (x₁ * y₂ + x₂ * y₁) - W.a₁ * (L_sl * M ^ 2) -
        W.a₂ * M ^ 2 + W.a₃ * (L_sl ^ 2 * M) + 2 * (W.a₄ * (L_sl * M)) - 3 * (W.a₆ * L_sl ^ 2) := by
      conv_lhs => rw [hy₃_M, hy₂_M, hy₁_M]
      rw [hy₂_M, hy₁_M]
      linear_combination M ^ 2 * he₁ + 2 * L_sl * M * he₂ + 3 * L_sl ^ 2 * he₃
    have h_add_le : ∀ {a b : L} {B : WithZero (Multiplicative ℤ)}, v a ≤ B → v b ≤ B → v (a + b) ≤ B :=
      fun ha hb => (v.map_add _ _).trans (max_le ha hb)
    have h_sub_le : ∀ {a b : L} {B : WithZero (Multiplicative ℤ)}, v a ≤ B → v b ≤ B → v (a - b) ≤ B :=
      fun ha hb => (v.map_sub _ _).trans (max_le ha hb)
    have h_coeff_le : ∀ {a c : L} {B : WithZero (Multiplicative ℤ)}, v a ≤ 1 → v c ≤ B → v (a * c) ≤ B :=
      fun ha hc => by rw [map_mul]; exact (mul_le_of_le_one_left' ha).trans hc
    have hv2_le1 : v (2 : L) ≤ 1 := by
      have h2 : (2 : L) = 1 + 1 := by norm_num
      rw [h2]; exact h_add_le (le_of_eq (map_one v)) (le_of_eq (map_one v))
    have hv3_le1 : v (3 : L) ≤ 1 := by
      have h3 : (3 : L) = 2 + 1 := by norm_num
      rw [h3]; exact h_add_le hv2_le1 (le_of_eq (map_one v))
    have hL2 : v L_sl ^ 2 ≤ r ^ 2 * v M ^ 2 := by
      calc v L_sl ^ 2 ≤ (r ^ 2 * v M) ^ 2 := pow_le_pow_left' hL 2
        _ = r ^ 2 * r ^ 2 * v M ^ 2 := by rw [mul_pow, sq (r ^ 2)]
        _ ≤ r ^ 2 * 1 * v M ^ 2 := mul_le_mul' (mul_le_mul' le_rfl hr2_le1) le_rfl
        _ = r ^ 2 * v M ^ 2 := by rw [mul_one]
    have ht1 : v ((W.a₁ * x₃ + W.a₃) * (x₁ * y₂ + x₂ * y₁)) ≤ r ^ 2 * v M ^ 3 := by
      rw [map_mul]
      have h1a : v (W.a₁ * x₃ + W.a₃) ≤ v x₃ :=
        h_add_le (h_coeff_le ha₁ le_rfl) (ha₃.trans (le_of_lt hx₃_gt1))
      have h1b : v (x₁ * y₂ + x₂ * y₁) ≤ r * (v y₁ * v y₂) := by
        apply h_add_le
        · rw [map_mul, ← mul_assoc]
          exact mul_le_mul' hx₁_le_ry₁ le_rfl
        · rw [map_mul, mul_comm (v x₂)]
          calc v y₁ * v x₂ ≤ v y₁ * (r * v y₂) := mul_le_mul' le_rfl hx₂_le_ry₂
            _ = r * (v y₁ * v y₂) := by rw [← mul_assoc, mul_comm (v y₁), mul_assoc]
      calc v (W.a₁ * x₃ + W.a₃) * v (x₁ * y₂ + x₂ * y₁)
          ≤ v x₃ * (r * (v y₁ * v y₂)) := mul_le_mul' h1a h1b
        _ ≤ v x₃ * (r * (r * (v x₁ * v x₂) * v M)) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl hM)
        _ = r ^ 2 * ((v x₁ * v x₂) * v x₃) * v M := by
            rw [sq]; simp only [mul_assoc, mul_left_comm, mul_comm]
        _ = r ^ 2 * v M ^ 2 * v M := by rw [hx123_M2]
        _ = r ^ 2 * v M ^ 3 := by rw [mul_assoc, ← pow_succ _ 2]
    have ht2 : v (W.a₁ * (L_sl * M ^ 2)) ≤ r ^ 2 * v M ^ 3 := by
      apply h_coeff_le ha₁
      rw [map_mul, map_pow]
      calc v L_sl * v M ^ 2 ≤ (r ^ 2 * v M) * v M ^ 2 := mul_le_mul' hL le_rfl
        _ = r ^ 2 * v M ^ 3 := by rw [mul_assoc, ← pow_succ' _ 2]
    have ht3 : v (W.a₂ * M ^ 2) ≤ r ^ 2 * v M ^ 3 := by
      apply h_coeff_le ha₂
      rw [map_pow]
      calc v M ^ 2 = 1 * v M ^ 2 := (one_mul _).symm
        _ ≤ (r ^ 2 * v M) * v M ^ 2 := mul_le_mul' hr2_M le_rfl
        _ = r ^ 2 * v M ^ 3 := by rw [mul_assoc, ← pow_succ' _ 2]
    have ht4 : v (W.a₃ * (L_sl ^ 2 * M)) ≤ r ^ 2 * v M ^ 3 := by
      apply h_coeff_le ha₃
      rw [map_mul, map_pow]
      calc v L_sl ^ 2 * v M ≤ (r ^ 2 * v M ^ 2) * v M := mul_le_mul' hL2 le_rfl
        _ = r ^ 2 * v M ^ 3 := by rw [mul_assoc, ← pow_succ _ 2]
    have ht5 : v (2 * (W.a₄ * (L_sl * M))) ≤ r ^ 2 * v M ^ 3 := by
      apply h_coeff_le hv2_le1 (h_coeff_le ha₄ _)
      rw [map_mul]
      calc v L_sl * v M ≤ (r ^ 2 * v M) * v M := mul_le_mul' hL le_rfl
        _ = r ^ 2 * v M ^ 2 := by rw [mul_assoc, ← sq]
        _ ≤ r ^ 2 * v M ^ 3 := by
            rw [pow_succ _ 2, ← mul_assoc]
            exact le_mul_of_one_le_right' hM_ge1
    have ht6 : v (3 * (W.a₆ * L_sl ^ 2)) ≤ r ^ 2 * v M ^ 3 := by
      apply h_coeff_le hv3_le1 (h_coeff_le ha₆ _)
      rw [map_pow]
      calc v L_sl ^ 2 ≤ r ^ 2 * v M ^ 2 := hL2
        _ ≤ r ^ 2 * v M ^ 3 := by
            rw [pow_succ _ 2, ← mul_assoc]
            exact le_mul_of_one_le_right' hM_ge1
    have h_num_bound : v (x₃ * y₁ * y₂ - x₁ * y₂ * y₃ - x₂ * y₁ * y₃) ≤ r ^ 2 * (v y₁ * v y₂ * v y₃) := by
      rw [hy123_M3, h_id4]
      exact h_sub_le (h_add_le (h_add_le (h_sub_le (h_sub_le ht1 ht2) ht3) ht4) ht5) ht6
    have h_frac : x₃ / y₃ - (x₁ / y₁ + x₂ / y₂) =
        (x₃ * y₁ * y₂ - x₁ * y₂ * y₃ - x₂ * y₁ * y₃) / (y₁ * y₂ * y₃) := by
      field_simp [hy₁_ne, hy₂_ne, hy₃_ne]
      ring
    rw [h_frac, map_div₀, map_mul, map_mul]
    exact (div_le_iff₀ hy123_pos).mpr h_num_bound
  let tParam : W.Point → L := fun P =>
    match P with
    | .zero => 0
    | .some (x := x') (y := y') _ => x' / y'
  let inW1 : W.Point → Prop := fun P =>
    match P with
    | .zero => True
    | .some (x := x') _ => 1 < v x'
  have h_add : ∀ (P₁ P₂ : W.Point), inW1 P₁ → inW1 P₂ →
      inW1 (P₁ + P₂) ∧
      v (tParam (P₁ + P₂) - (tParam P₁ + tParam P₂)) ≤
        max (v (tParam P₁)) (v (tParam P₂)) ^ 2 := by
    intro P₁ P₂ hP₁ hP₂
    rcases P₁ with _ | @⟨x₁, y₁, h₁⟩
    · change inW1 (0 + P₂) ∧ v (tParam (0 + P₂) - (0 + tParam P₂)) ≤ _
      rw [zero_add, zero_add, sub_self, map_zero]
      exact ⟨hP₂, zero_le'⟩
    · rcases P₂ with _ | @⟨x₂, y₂, h₂⟩
      · change inW1 (WeierstrassCurve.Affine.Point.some h₁ + 0) ∧
          v (tParam (WeierstrassCurve.Affine.Point.some h₁ + 0) -
            (tParam (WeierstrassCurve.Affine.Point.some h₁) + 0)) ≤ _
        rw [add_zero, add_zero, sub_self, map_zero]
        exact ⟨hP₁, zero_le'⟩
      · change 1 < v x₁ at hP₁
        change 1 < v x₂ at hP₂
        obtain ⟨hy₁, hr₁_pos, _, hr₁_mul, _, _⟩ := h_s1 h₁.1 hP₁
        obtain ⟨hy₂, hr₂_pos, _, hr₂_mul, _, _⟩ := h_s1 h₂.1 hP₂
        have hy₁_ne : y₁ ≠ 0 := by
          intro h0
          rw [h0, div_zero, map_zero] at hr₁_pos
          exact lt_irrefl 0 hr₁_pos
        have hy₂_ne : y₂ ≠ 0 := by
          intro h0
          rw [h0, div_zero, map_zero] at hr₂_pos
          exact lt_irrefl 0 hr₂_pos
        by_cases hxy : x₁ = x₂ ∧ y₁ = W.negY x₂ y₂
        · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2]
          refine ⟨trivial, ?_⟩
          change v (0 - (x₁ / y₁ + x₂ / y₂)) ≤ max (v (x₁ / y₁)) (v (x₂ / y₂)) ^ 2
          have hy_sum : y₁ + y₂ = -(W.a₁ * x₁ + W.a₃) := by
            have hneg : y₁ = -y₂ - W.a₁ * x₂ - W.a₃ := hxy.2
            rw [← hxy.1] at hneg
            linear_combination hneg
          have h_frac : (0 : L) - (x₁ / y₁ + x₂ / y₂) =
              (x₁ * (W.a₁ * x₁ + W.a₃)) / (y₁ * y₂) := by
            rw [← hxy.1]
            calc (0 : L) - (x₁ / y₁ + x₁ / y₂) = -(x₁ * (y₁ + y₂)) / (y₁ * y₂) := by
                  field_simp [hy₁_ne, hy₂_ne]
                  ring
              _ = (x₁ * (W.a₁ * x₁ + W.a₃)) / (y₁ * y₂) := by
                  rw [hy_sum]
                  ring
          rw [h_frac, map_div₀, map_mul, map_mul]
          have h_a13 : v (W.a₁ * x₁ + W.a₃) ≤ v x₂ := by
            rw [← hxy.1]
            have h1 : v (W.a₁ * x₁) ≤ v x₁ := by
              rw [map_mul]
              exact mul_le_of_le_one_left' ha₁
            have h2 : v W.a₃ ≤ v x₁ := ha₃.trans (le_of_lt hP₁)
            exact (v.map_add _ _).trans (max_le h1 h2)
          have h_num : v x₁ * v (W.a₁ * x₁ + W.a₃) ≤
              max (v (x₁ / y₁)) (v (x₂ / y₂)) ^ 2 * (v y₁ * v y₂) := by
            calc v x₁ * v (W.a₁ * x₁ + W.a₃)
                ≤ v x₁ * v x₂ := mul_le_mul' le_rfl h_a13
              _ = (v (x₁ / y₁) * v y₁) * (v (x₂ / y₂) * v y₂) := by rw [hr₁_mul, hr₂_mul]
              _ = (v (x₁ / y₁) * v (x₂ / y₂)) * (v y₁ * v y₂) := by
                  rw [mul_assoc, mul_left_comm (v y₁), ← mul_assoc]
              _ ≤ max (v (x₁ / y₁)) (v (x₂ / y₂)) ^ 2 * (v y₁ * v y₂) := by
                  rw [sq]
                  exact mul_le_mul' (mul_le_mul' (le_max_left _ _) (le_max_right _ _)) le_rfl
          have hy12_pos : 0 < v y₁ * v y₂ := by
            have hy1_pos : 0 < v y₁ := by
              by_contra! hle
              have h0 : v y₁ = 0 := le_antisymm hle zero_le'
              exact hy₁_ne ((Valuation.zero_iff v).mp h0)
            have hy2_pos : 0 < v y₂ := by
              by_contra! hle
              have h0 : v y₂ = 0 := le_antisymm hle zero_le'
              exact hy₂_ne ((Valuation.zero_iff v).mp h0)
            exact mul_pos hy1_pos hy2_pos
          exact (div_le_iff₀ hy12_pos).mpr h_num
        · rw [WeierstrassCurve.Affine.Point.add_some hxy]
          obtain ⟨hM, hL⟩ := h_s2 h₁.1 h₂.1 hxy hP₁ hy₁ hP₂ hy₂
          obtain ⟨hx₃, h_approx⟩ := h_s3 h₁.1 h₂.1 hxy hP₁ hy₁ hP₂ hy₂ hM hL
          obtain ⟨hy₃, _, _, _, _, _⟩ := h_s1 (W.nonsingular_add h₁ h₂ hxy).1 hx₃
          exact ⟨hx₃, h_approx hy₃⟩
  let P : W.Point := WeierstrassCurve.Affine.Point.some h
  let r₀ : WithZero (Multiplicative ℤ) := v (tParam P)
  obtain ⟨_, hr₀_pos, hr₀_lt, _, _, _⟩ := h_s1 h.1 hx
  have hr₀_sq_lt : r₀ ^ 2 < r₀ := by
    rw [sq]
    exact mul_lt_of_lt_one_left hr₀_pos hr₀_lt
  have hr₀_sq_le : r₀ ^ 2 ≤ r₀ := le_of_lt hr₀_sq_lt
  have h_nat_val : ∀ k : ℕ, v (k : L) ≤ 1 := by
    intro k
    induction k with
    | zero =>
      rw [Nat.cast_zero, map_zero]
      exact zero_le'
    | succ k ih =>
      rw [Nat.cast_succ]
      exact (v.map_add _ _).trans (max_le ih (le_of_eq (map_one v)))
  have h_ind : ∀ k : ℕ, inW1 (k • P) ∧ v (tParam (k • P)) ≤ r₀ ∧
      v (tParam (k • P) - (k : L) * tParam P) ≤ r₀ ^ 2 := by
    intro k
    induction k with
    | zero =>
      rw [zero_nsmul, Nat.cast_zero, zero_mul, sub_zero]
      change True ∧ v 0 ≤ r₀ ∧ v 0 ≤ r₀ ^ 2
      rw [map_zero]
      exact ⟨trivial, zero_le', zero_le'⟩
    | succ k ih =>
      rcases ih with ⟨ih_in, ih_le, ih_diff⟩
      rw [succ_nsmul]
      obtain ⟨h_in_next, h_add_next⟩ := h_add (k • P) P ih_in hx
      have h_max_sq : max (v (tParam (k • P))) (v (tParam P)) ^ 2 ≤ r₀ ^ 2 :=
        pow_le_pow_left' (max_le ih_le le_rfl) 2
      have h_step : v (tParam (k • P + P) - (tParam (k • P) + tParam P)) ≤ r₀ ^ 2 :=
        h_add_next.trans h_max_sq
      have h_diff_next : v (tParam (k • P + P) - ((k + 1 : ℕ) : L) * tParam P) ≤ r₀ ^ 2 := by
        have h_eq : tParam (k • P + P) - ((k + 1 : ℕ) : L) * tParam P =
            (tParam (k • P + P) - (tParam (k • P) + tParam P)) +
            (tParam (k • P) - (k : L) * tParam P) := by
          push_cast
          ring
        rw [h_eq]
        exact (v.map_add _ _).trans (max_le h_step ih_diff)
      have h_le_next : v (tParam (k • P + P)) ≤ r₀ := by
        have h_eq : tParam (k • P + P) =
            (tParam (k • P + P) - ((k + 1 : ℕ) : L) * tParam P) +
            ((k + 1 : ℕ) : L) * tParam P := by ring
        rw [h_eq]
        have h_term2 : v (((k + 1 : ℕ) : L) * tParam P) ≤ r₀ := by
          rw [map_mul]
          exact mul_le_of_le_one_left' (h_nat_val (k + 1))
        exact (v.map_add _ _).trans (max_le (h_diff_next.trans hr₀_sq_le) h_term2)
      exact ⟨h_in_next, h_le_next, h_diff_next⟩
  intro hm_zero
  have hm_diff := (h_ind m).2.2
  rw [hm_zero] at hm_diff
  change v (0 - (m : L) * tParam P) ≤ r₀ ^ 2 at hm_diff
  rw [zero_sub, Valuation.map_neg, map_mul, hm, one_mul] at hm_diff
  exact not_le_of_gt hr₀_sq_lt hm_diff

theorem finite_torsion_ell (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (E : WeierstrassCurve F) :
    Finite (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :=
by
  classical
  have h_ell_ne : (EllipticRootNumber.ell F : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have h0_F : (EllipticRootNumber.ell F : F) = 0 := by
      apply (algebraMap F (AlgebraicClosure F)).injective
      rw [map_natCast, map_zero]
      exact h0
    have h0_O : (EllipticRootNumber.ell F : (ValuativeRel.valuation F).integer) = 0 := by
      apply Subtype.ext
      exact h0_F
    have h0_k : (EllipticRootNumber.ell F :
        IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) = 0 := by
      have := congrArg (IsLocalRing.residue (ValuativeRel.valuation F).integer) h0_O
      rwa [map_natCast, map_zero] at this
    have h_dvd : EllipticRootNumber.p F ∣ EllipticRootNumber.ell F :=
      (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer)
        (EllipticRootNumber.ell F)).mp h0_k
    have h_lt : EllipticRootNumber.p F + 1 ≤ EllipticRootNumber.ell F :=
      (Nat.exists_infinite_primes (EllipticRootNumber.p F + 1)).choose_spec.1
    rcases (EllipticRootNumber.ell_prime F).out.eq_one_or_self_of_dvd _ h_dvd with hp1 | hpeq
    · have h1_k : ((1 : ℕ) : IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) = 0 :=
        (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) 1).mpr
          (hp1 ▸ dvd_rfl)
      rw [Nat.cast_one] at h1_k
      exact one_ne_zero h1_k
    · omega
  obtain ⟨v, h_gen, hv_le, hv_eq, hv_X⟩ :=
    exists_functionField_valuation_and_generic_nonsingular (AlgebraicClosure F)
      (E.baseChange (AlgebraicClosure F)).toAffine
  have hm_val : v (((EllipticRootNumber.ell F ^ (0 + 1) : ℕ) :
      (E.baseChange (AlgebraicClosure F)).toAffine.FunctionField)) = 1 := by
    rw [zero_add, pow_one, ← map_natCast (algebraMap (AlgebraicClosure F)
      (E.baseChange (AlgebraicClosure F)).toAffine.FunctionField)]
    exact hv_eq (EllipticRootNumber.ell F : AlgebraicClosure F) h_ell_ne
  have hm_ne : (EllipticRootNumber.ell F ^ (0 + 1)) • (WeierstrassCurve.Affine.Point.some h_gen :
      (((E.baseChange (AlgebraicClosure F)).toAffine.map
        (algebraMap (AlgebraicClosure F)
          (E.baseChange (AlgebraicClosure F)).toAffine.FunctionField)).toAffine).Point) ≠ 0 :=
    weierstrass_nsmul_ne_zero_of_valuation v
      (((E.baseChange (AlgebraicClosure F)).toAffine.map
        (algebraMap (AlgebraicClosure F)
          (E.baseChange (AlgebraicClosure F)).toAffine.FunctionField)).toAffine)
      (hv_le _) (hv_le _) (hv_le _) (hv_le _) (hv_le _) h_gen hv_X
      (EllipticRootNumber.ell F ^ (0 + 1)) hm_val
  exact torsion_finite_of_generic_nsmul_ne_zero (AlgebraicClosure F)
    (E.baseChange (AlgebraicClosure F)).toAffine h_gen
    (EllipticRootNumber.ell F ^ (0 + 1)) hm_ne

theorem module_finite_tateModule_of_finite_torsion (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (E : WeierstrassCurve F)
    [Finite (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)))] :
    Module.Finite ℤ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateModule F E) :=
by
  classical
  let ℓ := EllipticRootNumber.ell F
  let T := EllipticRootNumber.tateModule F E
  let M₀ := EllipticRootNumber.torsion F E (ℓ ^ (0 + 1))
  letI : Fintype M₀ := Fintype.ofFinite M₀
  have h_div : ∀ y : T, y.1 0 = 0 → ∃ z : T, y = (ℓ : ℤ_[ℓ]) • z := by
    intro y hy0
    have h_mem : ∀ n : ℕ,
        (y.1 (n + 1) : EllipticRootNumber.Pts F E) ∈
          EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) := by
      intro n
      rw [EllipticRootNumber.mem_torsion]
      induction n with
      | zero =>
        rw [Nat.zero_add, pow_one, y.2 0, hy0]
        rfl
      | succ k ih =>
        rw [pow_succ', mul_nsmul, y.2 (k + 1), ih]
    let z₀ : ∀ n : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) :=
      fun n => ⟨(y.1 (n + 1) : EllipticRootNumber.Pts F E), h_mem n⟩
    have hz : z₀ ∈ T := fun n => y.2 (n + 1)
    refine ⟨⟨z₀, hz⟩, ?_⟩
    apply Subtype.ext
    funext n
    apply Subtype.ext
    rw [Submodule.coe_smul, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion]
    have h_val : (PadicInt.toZModPow (n + 1) (ℓ : ℤ_[ℓ])).val = ℓ % ℓ ^ (n + 1) := by
      rw [map_natCast, ZMod.val_natCast]
    rw [h_val]
    change (y.1 n : EllipticRootNumber.Pts F E) =
      (ℓ % ℓ ^ (n + 1)) • (y.1 (n + 1) : EllipticRootNumber.Pts F E)
    rw [EllipticRootNumber.nsmul_eq_of_modEq F E (h_mem n) (Nat.mod_modEq ℓ (ℓ ^ (n + 1)))]
    exact (y.2 n).symm
  let b : M₀ → T := fun m =>
    if h : ∃ v : T, v.1 0 = m then Classical.choose h else 0
  have hb : ∀ w : T, (b (w.1 0)).1 0 = w.1 0 := by
    intro w
    have h : ∃ v : T, v.1 0 = w.1 0 := ⟨w, rfl⟩
    dsimp only [b]
    rw [dif_pos h]
    exact Classical.choose_spec h
  have h_step : ∀ w : T, ∃ w' : T, w = b (w.1 0) + (ℓ : ℤ_[ℓ]) • w' := by
    intro w
    have hw0 : (w - b (w.1 0)).1 0 = 0 := by
      rw [Submodule.coe_sub, Pi.sub_apply, hb w, sub_self]
    obtain ⟨w', hw'⟩ := h_div (w - b (w.1 0)) hw0
    exact ⟨w', sub_eq_iff_eq_add'.mp hw'⟩
  let next : T → T := fun w => Classical.choose (h_step w)
  have h_next : ∀ w : T, w = b (w.1 0) + (ℓ : ℤ_[ℓ]) • next w :=
    fun w => Classical.choose_spec (h_step w)
  apply Module.Finite.of_surjective (Fintype.linearCombination ℤ_[ℓ] b)
  intro x
  let z : ℕ → T := fun k => Nat.recOn k x (fun _ prev => next prev)
  have hz0 : z 0 = x := rfl
  have hzs : ∀ k : ℕ, z (k + 1) = next (z k) := fun _ => rfl
  have h_tel : ∀ N : ℕ,
      x = (∑ k ∈ Finset.range N, (ℓ : ℤ_[ℓ]) ^ k • b ((z k).1 0)) + (ℓ : ℤ_[ℓ]) ^ N • z N := by
    intro N
    induction N with
    | zero =>
      rw [Finset.sum_range_zero, pow_zero, one_smul, zero_add, hz0]
    | succ N ih =>
      rw [Finset.sum_range_succ, add_assoc]
      conv_lhs => rw [ih]
      congr 1
      conv_lhs => rw [h_next (z N)]
      rw [smul_add, ← hzs N, ← mul_smul, ← pow_succ]
  let δ : M₀ → ℕ → ℤ := fun m k => if (z k).1 0 = m then 1 else 0
  let f : M₀ → ℕ → ℤ := fun m N => ∑ k ∈ Finset.range N, δ m k * (ℓ : ℤ) ^ k
  have h_exp : ∀ N : ℕ,
      x = (∑ m : M₀, (f m N : ℤ_[ℓ]) • b m) + (ℓ : ℤ_[ℓ]) ^ N • z N := by
    intro N
    rw [h_tel N]
    congr 1
    have h_single : ∀ k : ℕ,
        (ℓ : ℤ_[ℓ]) ^ k • b ((z k).1 0) =
          ∑ m : M₀, ((δ m k * (ℓ : ℤ) ^ k : ℤ) : ℤ_[ℓ]) • b m := by
      intro k
      symm
      rw [Finset.sum_eq_single ((z k).1 0)]
      · dsimp only [δ]
        rw [if_pos rfl, one_mul, Int.cast_pow, Int.cast_natCast]
      · intro m _ hm
        dsimp only [δ]
        rw [if_neg (Ne.symm hm), zero_mul, Int.cast_zero, zero_smul]
      · intro h_abs
        exact False.elim (h_abs (Finset.mem_univ _))
    calc ∑ k ∈ Finset.range N, (ℓ : ℤ_[ℓ]) ^ k • b ((z k).1 0)
      _ = ∑ k ∈ Finset.range N, ∑ m : M₀, ((δ m k * (ℓ : ℤ) ^ k : ℤ) : ℤ_[ℓ]) • b m :=
        Finset.sum_congr rfl (fun k _ => h_single k)
      _ = ∑ m : M₀, ∑ k ∈ Finset.range N, ((δ m k * (ℓ : ℤ) ^ k : ℤ) : ℤ_[ℓ]) • b m :=
        Finset.sum_comm
      _ = ∑ m : M₀, (f m N : ℤ_[ℓ]) • b m := by
        refine Finset.sum_congr rfl (fun m _ => ?_)
        rw [← Finset.sum_smul, ← Int.cast_sum]
  have hf_dvd : ∀ (m : M₀) (i : ℕ), (ℓ : ℤ) ^ i ∣ f m (i + 1) - f m i := by
    intro m i
    dsimp only [f]
    rw [Finset.sum_range_succ, add_sub_cancel_left]
    exact ⟨δ m i, mul_comm _ _⟩
  let a : M₀ → ℤ_[ℓ] := fun m =>
    PadicInt.ofIntSeq (f m) (PadicInt.isCauSeq_padicNorm_of_pow_dvd_sub (f m) ℓ (hf_dvd m))
  have ha_mod : ∀ (m : M₀) (n : ℕ),
      PadicInt.toZModPow (n + 1) (a m) =
        PadicInt.toZModPow (n + 1) (f m (n + 1) : ℤ_[ℓ]) := by
    intro m n
    dsimp only [a]
    rw [PadicInt.toZModPow_ofIntSeq_of_pow_dvd_sub (f m) ℓ (hf_dvd m) (n + 1), map_intCast]
  have h_term : ∀ (m : M₀) (n : ℕ),
      (a m • b m).1 n = ((f m (n + 1) : ℤ_[ℓ]) • b m).1 n := by
    intro m n
    apply Subtype.ext
    rw [Submodule.coe_smul, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      Submodule.coe_smul, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion, ha_mod m n]
  have h_rem : ∀ n : ℕ, (((ℓ : ℤ_[ℓ]) ^ (n + 1) • z (n + 1)).1 n) = 0 := by
    intro n
    apply Subtype.ext
    rw [Submodule.coe_smul, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      AddSubgroup.coe_zero]
    have h_zero : PadicInt.toZModPow (n + 1) ((ℓ : ℤ_[ℓ]) ^ (n + 1)) = 0 := by
      rw [map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self]
    rw [h_zero, ZMod.val_zero, zero_nsmul]
  refine ⟨a, ?_⟩
  rw [Fintype.linearCombination_apply]
  apply Subtype.ext
  funext n
  have hx_n := congrArg (fun v : T => v.1 n) (h_exp (n + 1))
  dsimp only at hx_n
  rw [hx_n, Submodule.coe_add, Pi.add_apply, h_rem n, add_zero,
    Submodule.coe_sum, Finset.sum_apply, Submodule.coe_sum, Finset.sum_apply]
  exact Finset.sum_congr rfl (fun m _ => h_term m n)

theorem exists_finite_ext_torsion_fixed_of_delta_eq_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (hΔ : E.Δ = 0) :
    ∃ L : IntermediateField F (AlgebraicClosure F), FiniteDimensional F L ∧
      ∀ σ : EllipticRootNumber.AbsGal F,
        σ ∈ L.fixingSubgroup → σ ∈ EllipticRootNumber.inertia F →
        ∀ (n : ℕ) (P : EllipticRootNumber.Pts F E),
          P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) →
            EllipticRootNumber.galHom F E σ P = P :=
by
  classical
  have h_s1 : ∀ (K : Type u) [Field K] [IsAlgClosed K] (W : WeierstrassCurve K),
      W.Δ = 0 → ∃ (r s t : K),
        let C : WeierstrassCurve.VariableChange K := { u := 1, r := r, s := s, t := t }
        (C • W).a₂ = 0 ∧ (C • W).a₃ = 0 ∧ (C • W).a₄ = 0 ∧ (C • W).a₆ = 0 := by
    intro K _ _ W hWΔ
    let A20 : K → K := fun r => W.a₂ + 3 * r
    let A30 : K → K → K := fun r t => W.a₃ + r * W.a₁ + 2 * t
    let A40 : K → K → K := fun r t => W.a₄ - t * W.a₁ + 2 * r * W.a₂ + 3 * r ^ 2
    let A60 : K → K → K := fun r t =>
      W.a₆ + r * W.a₄ + r ^ 2 * W.a₂ + r ^ 3 - t * W.a₃ - t ^ 2 - r * t * W.a₁
    let B2 : K → K := fun r => W.b₂ + 12 * r
    have h_c4_shift : ∀ r t : K,
        W.c₄ = B2 r ^ 2 - 24 * (2 * A40 r t + W.a₁ * A30 r t) := by
      intro r t
      dsimp only [B2, A40, A30, WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
      ring
    have h_c6_shift : ∀ r t : K,
        W.c₆ = -B2 r ^ 3 + 36 * B2 r * (2 * A40 r t + W.a₁ * A30 r t) -
          216 * (A30 r t ^ 2 + 4 * A60 r t) := by
      intro r t
      dsimp only [B2, A40, A30, A60, WeierstrassCurve.c₆, WeierstrassCurve.b₂,
        WeierstrassCurve.b₄, WeierstrassCurve.b₆]
      ring
    have h_b4_shift : ∀ r t : K,
        2 * A40 r t + W.a₁ * A30 r t = W.b₄ + r * W.b₂ + 2 * (3 : K) * r ^ 2 := by
      intro r t
      dsimp only [A40, A30, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
      ring
    have h_b6_shift : ∀ r t : K,
        A30 r t ^ 2 + 4 * A60 r t = W.b₆ + 2 * r * W.b₄ + r ^ 2 * W.b₂ + 4 * r ^ 3 := by
      intro r t
      dsimp only [A30, A60, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆]
      ring
    have h_c4_c6_Δ : W.c₄ ^ 3 - W.c₆ ^ 2 = 1728 * W.Δ := by
      dsimp only [WeierstrassCurve.c₄, WeierstrassCurve.c₆, WeierstrassCurve.Δ,
        WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]
      ring
    have h_Delta_shift : ∀ r t : K, A30 r t = 0 → A40 r t = 0 →
        W.Δ = -A60 r t * (B2 r ^ 3 + 432 * A60 r t) := by
      intro r t h30 h40
      have h_id : W.Δ =
          -(W.a₁ ^ 2 + 4 * A20 r) ^ 2 *
            (W.a₁ ^ 2 * A60 r t + 4 * A20 r * A60 r t - W.a₁ * A30 r t * A40 r t +
              A20 r * A30 r t ^ 2 - A40 r t ^ 2) -
          8 * (2 * A40 r t + W.a₁ * A30 r t) ^ 3 -
          27 * (A30 r t ^ 2 + 4 * A60 r t) ^ 2 +
          9 * (W.a₁ ^ 2 + 4 * A20 r) * (2 * A40 r t + W.a₁ * A30 r t) *
            (A30 r t ^ 2 + 4 * A60 r t) := by
        dsimp only [A20, A30, A40, A60, WeierstrassCurve.Δ, WeierstrassCurve.b₂,
          WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]
        ring
      rw [h_id, h30, h40]
      dsimp only [B2, A20, WeierstrassCurve.b₂]
      ring
    have h_rt : ∃ r₀ t₀ : K, A30 r₀ t₀ = 0 ∧ A40 r₀ t₀ = 0 ∧ A60 r₀ t₀ = 0 := by
      by_cases h2 : (2 : K) = 0
      · by_cases ha₁ : W.a₁ = 0
        · have hb₂ : W.b₂ = 0 := by
            dsimp only [WeierstrassCurve.b₂]
            rw [ha₁]
            linear_combination 2 * W.a₂ * h2
          have hb₄ : W.b₄ = 0 := by
            dsimp only [WeierstrassCurve.b₄]
            rw [ha₁]
            linear_combination W.a₄ * h2
          have hb₆ : W.b₆ = W.a₃ ^ 2 := by
            dsimp only [WeierstrassCurve.b₆]
            linear_combination 2 * W.a₆ * h2
          have ha₃4 : W.a₃ ^ 4 = 0 := by
            have hD : W.Δ = -27 * W.a₃ ^ 4 := by
              dsimp only [WeierstrassCurve.Δ]
              rw [hb₂, hb₄, hb₆]
              ring
            rw [hWΔ] at hD
            linear_combination hD - 13 * W.a₃ ^ 4 * h2
          have ha₃ : W.a₃ = 0 := eq_zero_of_pow_eq_zero ha₃4
          obtain ⟨r₀, hr₀⟩ := IsAlgClosed.exists_pow_nat_eq W.a₄ (by norm_num : 0 < 2)
          obtain ⟨t₀, ht₀⟩ := IsAlgClosed.exists_pow_nat_eq
            (W.a₆ + r₀ * W.a₄ + r₀ ^ 2 * W.a₂ + r₀ ^ 3) (by norm_num : 0 < 2)
          have h30 : A30 r₀ t₀ = 0 := by
            dsimp only [A30]
            rw [ha₁, ha₃]
            linear_combination t₀ * h2
          have h40 : A40 r₀ t₀ = 0 := by
            dsimp only [A40]
            rw [← hr₀, ha₁]
            linear_combination (r₀ * W.a₂ + 2 * r₀ ^ 2) * h2
          have h60 : A60 r₀ t₀ = 0 := by
            dsimp only [A60]
            rw [ht₀, ha₁, ha₃]
            ring
          exact ⟨r₀, t₀, h30, h40, h60⟩
        · let r₀ : K := -W.a₃ / W.a₁
          let t₀ : K := (W.a₄ + 3 * r₀ ^ 2) / W.a₁
          have h30 : A30 r₀ t₀ = 0 := by
            dsimp only [A30, r₀]
            rw [div_mul_cancel₀ _ ha₁]
            linear_combination t₀ * h2
          have h40 : A40 r₀ t₀ = 0 := by
            dsimp only [A40, t₀]
            rw [div_mul_cancel₀ _ ha₁]
            linear_combination r₀ * W.a₂ * h2
          have h60 : A60 r₀ t₀ = 0 := by
            have hD := h_Delta_shift r₀ t₀ h30 h40
            rw [hWΔ] at hD
            have hB2 : B2 r₀ = W.a₁ ^ 2 := by
              dsimp only [B2, WeierstrassCurve.b₂]
              linear_combination (2 * W.a₂ + 6 * r₀) * h2
            have h432 : (432 : K) = 0 := by linear_combination 216 * h2
            rw [hB2, h432] at hD
            have ha1_6 : W.a₁ ^ 6 ≠ 0 := pow_ne_zero 6 ha₁
            have : A60 r₀ t₀ * W.a₁ ^ 6 = 0 := by linear_combination hD
            exact (mul_eq_zero.mp this).resolve_right ha1_6
          exact ⟨r₀, t₀, h30, h40, h60⟩
      · by_cases h3 : (3 : K) = 0
        · by_cases hb₂ : W.b₂ = 0
          · have hb₄ : W.b₄ = 0 := by
              have hD : W.Δ = -8 * W.b₄ ^ 3 - 9 * (3 : K) * W.b₆ ^ 2 := by
                dsimp only [WeierstrassCurve.Δ]
                rw [hb₂]
                ring
              rw [hWΔ, h3] at hD
              have h8 : (2 : K) ^ 3 * W.b₄ ^ 3 = 0 := by linear_combination hD
              have h23 : (2 : K) ^ 3 ≠ 0 := pow_ne_zero 3 h2
              exact eq_zero_of_pow_eq_zero ((mul_eq_zero.mp h8).resolve_left h23)
            have h4_ne : (4 : K) ≠ 0 := by
              have : (4 : K) = (2 : K) ^ 2 := by ring
              rw [this]
              exact pow_ne_zero 2 h2
            obtain ⟨r₀, hr₀⟩ := IsAlgClosed.exists_pow_nat_eq (-W.b₆ / 4) (by norm_num : 0 < 3)
            let t₀ : K := -(W.a₁ * r₀ + W.a₃) / 2
            have h30 : A30 r₀ t₀ = 0 := by
              dsimp only [A30, t₀]
              rw [mul_div_cancel₀ _ h2]
              ring
            have h40 : A40 r₀ t₀ = 0 := by
              have hb4s := h_b4_shift r₀ t₀
              rw [h30, hb₂, hb₄, h3] at hb4s
              have : (2 : K) * A40 r₀ t₀ = 0 := by linear_combination hb4s
              exact (mul_eq_zero.mp this).resolve_left h2
            have h60 : A60 r₀ t₀ = 0 := by
              have hb6s := h_b6_shift r₀ t₀
              rw [h30, hb₂, hb₄, hr₀] at hb6s
              have : (4 : K) * A60 r₀ t₀ = 0 := by
                have h4div : 4 * (-W.b₆ / 4) = -W.b₆ := mul_div_cancel₀ _ h4_ne
                linear_combination hb6s + h4div
              exact (mul_eq_zero.mp this).resolve_left h4_ne
            exact ⟨r₀, t₀, h30, h40, h60⟩
          · let r₀ : K := -W.b₄ / W.b₂
            let t₀ : K := -(W.a₁ * r₀ + W.a₃) / 2
            have h30 : A30 r₀ t₀ = 0 := by
              dsimp only [A30, t₀]
              rw [mul_div_cancel₀ _ h2]
              ring
            have h40 : A40 r₀ t₀ = 0 := by
              have hb4s := h_b4_shift r₀ t₀
              rw [h30, h3] at hb4s
              have hr0b2 : r₀ * W.b₂ = -W.b₄ := div_mul_cancel₀ (-W.b₄) hb₂
              have : (2 : K) * A40 r₀ t₀ = 0 := by linear_combination hb4s + hr0b2
              exact (mul_eq_zero.mp this).resolve_left h2
            have h60 : A60 r₀ t₀ = 0 := by
              have hD := h_Delta_shift r₀ t₀ h30 h40
              rw [hWΔ] at hD
              have hB2 : B2 r₀ = W.b₂ := by
                dsimp only [B2]
                linear_combination 4 * r₀ * h3
              have h432 : (432 : K) = 0 := by linear_combination 144 * h3
              rw [hB2, h432] at hD
              have hb2_3 : W.b₂ ^ 3 ≠ 0 := pow_ne_zero 3 hb₂
              have : A60 r₀ t₀ * W.b₂ ^ 3 = 0 := by linear_combination hD
              exact (mul_eq_zero.mp this).resolve_right hb2_3
            exact ⟨r₀, t₀, h30, h40, h60⟩
        · have h12 : (12 : K) ≠ 0 := by
            have : (12 : K) = (2 : K) ^ 2 * (3 : K) := by ring
            rw [this]
            exact mul_ne_zero (pow_ne_zero 2 h2) h3
          have h48 : (48 : K) ≠ 0 := by
            have : (48 : K) = (2 : K) ^ 4 * (3 : K) := by ring
            rw [this]
            exact mul_ne_zero (pow_ne_zero 4 h2) h3
          have h864 : (864 : K) ≠ 0 := by
            have : (864 : K) = (2 : K) ^ 5 * (3 : K) ^ 3 := by ring
            rw [this]
            exact mul_ne_zero (pow_ne_zero 5 h2) (pow_ne_zero 3 h3)
          by_cases hc₄ : W.c₄ = 0
          · let r₀ : K := -W.b₂ / 12
            let t₀ : K := -(W.a₁ * r₀ + W.a₃) / 2
            have h30 : A30 r₀ t₀ = 0 := by
              dsimp only [A30, t₀]
              rw [mul_div_cancel₀ _ h2]
              ring
            have hB2 : B2 r₀ = 0 := by
              dsimp only [B2, r₀]
              rw [mul_div_cancel₀ _ h12]
              ring
            have h40 : A40 r₀ t₀ = 0 := by
              have hc4s := h_c4_shift r₀ t₀
              rw [hc₄, hB2, h30] at hc4s
              have : (48 : K) * A40 r₀ t₀ = 0 := by linear_combination hc4s
              exact (mul_eq_zero.mp this).resolve_left h48
            have hc₆ : W.c₆ = 0 := by
              have hrel := h_c4_c6_Δ
              rw [hc₄, hWΔ] at hrel
              have : W.c₆ ^ 2 = 0 := by linear_combination -hrel
              exact eq_zero_of_pow_eq_zero this
            have h60 : A60 r₀ t₀ = 0 := by
              have hc6s := h_c6_shift r₀ t₀
              rw [hc₆, hB2, h30, h40] at hc6s
