    simpa only [sub_zero] using h
  have hD_g_tors : ∀ (P T' : EllipticRootNumber.Pts F E),
      (EllipticRootNumber.ell F ^ (k + 1)) • P = 0 →
      ((EllipticRootNumber.ell F ^ (k + 1)) ^ 2) • T' = 0 →
      D (τ_u P (g T')) = D (g T') := by
    intro P T' hP hT'
    rw [hD_g T' P hT', hD_g0 T' hT']
