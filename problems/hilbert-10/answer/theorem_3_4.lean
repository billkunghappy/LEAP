        change GenRep (k + 1) (0 + P_gen)
        rw [zero_add]
        obtain ⟨D₁, hD₁, ih_spec⟩ := ih
        have hιD₁ : ι D₁ ≠ 0 := (map_ne_zero_iff ι hι_inj).mpr hD₁
        refine ⟨X_R * D₁, Y_R * D₁, D₁, hD₁, ?_, ?_, ?_⟩
        · rw [map_mul, mul_div_cancel_right₀ _ hιD₁]
        · rw [map_mul, mul_div_cancel_right₀ _ hιD₁]
        · intro x y h hϕD₁
          have hx_eq : ϕ_h h (X_R * D₁) / ϕ_h h D₁ = x := by
            rw [map_mul, mul_div_cancel_right₀ _ hϕD₁, hϕ_X h]
          have hy_eq : ϕ_h h (Y_R * D₁) / ϕ_h h D₁ = y := by
            rw [map_mul, mul_div_cancel_right₀ _ hϕD₁, hϕ_Y h]
          have h' : W.Nonsingular (ϕ_h h (X_R * D₁) / ϕ_h h D₁) (ϕ_h h (Y_R * D₁) / ϕ_h h D₁) := by
            rwa [hx_eq, hy_eq]
          refine ⟨h', ?_⟩
          rw [succ_nsmul, ih_spec h hϕD₁, zero_add]
          congr 1
          · exact hx_eq.symm
          · exact hy_eq.symm
      · rw [hQ] at ih
        obtain ⟨A₁, B₁, D₁, hD₁, hX₁, hY₁, ih_spec⟩ := ih
        have hιD₁ : ι D₁ ≠ 0 := (map_ne_zero_iff ι hι_inj).mpr hD₁
        by_cases hXY : X₁ = ι X_R ∧
            Y₁ = ((W.map (algebraMap K W.FunctionField)).toAffine).negY (ι X_R) (ι Y_R)
        · have h_sum_zero : WeierstrassCurve.Affine.Point.some hQ₁ + P_gen = 0 :=
            WeierstrassCurve.Affine.Point.add_of_Y_eq hXY.1 hXY.2
          rw [h_sum_zero]
          refine ⟨D₁, hD₁, ?_⟩
          intro x y h hϕD₁
          obtain ⟨h₁, hkP⟩ := ih_spec h hϕD₁
          rw [succ_nsmul, hkP]
          have hx₂ : ϕ_h h X_R / ϕ_h h 1 = x := by rw [map_one, div_one, hϕ_X h]
          have hy₂ : ϕ_h h Y_R / ϕ_h h 1 = y := by rw [map_one, div_one, hϕ_Y h]
          have h₂ : W.Nonsingular (ϕ_h h X_R / ϕ_h h 1) (ϕ_h h Y_R / ϕ_h h 1) := by
            rwa [hx₂, hy₂]
          have h_pt₂ : WeierstrassCurve.Affine.Point.some h =
              WeierstrassCurve.Affine.Point.some h₂ := by
            congr 1
            · exact hx₂.symm
            · exact hy₂.symm
          rw [h_pt₂]
          exact h_s3 hXY.1 hXY.2
            A₁ B₁ D₁ X_R Y_R 1 hD₁ one_ne_zero hX₁ hY₁
            (by rw [map_one, div_one]) (by rw [map_one, div_one])
            (ϕ_h h) (hϕ_const h) hϕD₁ (by rw [map_one]; exact one_ne_zero) h₁ h₂
        · have h_sum_some : WeierstrassCurve.Affine.Point.some hQ₁ + P_gen =
              WeierstrassCurve.Affine.Point.some
                (WeierstrassCurve.Affine.nonsingular_add hQ₁ h_gen hXY) :=
            WeierstrassCurve.Affine.Point.add_some hXY
          rw [h_sum_some]
          obtain ⟨A₃, B₃, D₃, hD₃, hX₃, hY₃, h_spec₃⟩ :=
            h_s4 hQ₁ h_gen hXY
              A₁ B₁ D₁ X_R Y_R 1 hD₁ one_ne_zero hX₁ hY₁
              (by rw [map_one, div_one]) (by rw [map_one, div_one])
          have hιD₃ : ι D₃ ≠ 0 := (map_ne_zero_iff ι hι_inj).mpr hD₃
          have hιD₃D₁ : ι (D₃ * D₁) ≠ 0 := by
            rw [map_mul]
            exact mul_ne_zero hιD₃ hιD₁
          have hD₃D₁ : D₃ * D₁ ≠ 0 := fun h0 => hιD₃D₁ (by rw [h0, map_zero])
          refine ⟨A₃ * D₁, B₃ * D₁, D₃ * D₁, hD₃D₁, ?_, ?_, ?_⟩
          · rw [hX₃, map_mul, map_mul, mul_div_mul_right _ _ hιD₁]
          · rw [hY₃, map_mul, map_mul, mul_div_mul_right _ _ hιD₁]
          · intro x y h hϕDD
            have hϕD₃ : ϕ_h h D₃ ≠ 0 := fun h0 => hϕDD (by rw [map_mul, h0, zero_mul])
            have hϕD₁ : ϕ_h h D₁ ≠ 0 := fun h0 => hϕDD (by rw [map_mul, h0, mul_zero])
            obtain ⟨h₁, hkP⟩ := ih_spec h hϕD₁
            have hx₂ : ϕ_h h X_R / ϕ_h h 1 = x := by rw [map_one, div_one, hϕ_X h]
            have hy₂ : ϕ_h h Y_R / ϕ_h h 1 = y := by rw [map_one, div_one, hϕ_Y h]
            have h₂ : W.Nonsingular (ϕ_h h X_R / ϕ_h h 1) (ϕ_h h Y_R / ϕ_h h 1) := by
              rwa [hx₂, hy₂]
            obtain ⟨h₃, h_add₃⟩ := h_spec₃ (ϕ_h h) (hϕ_const h) hϕD₁
              (by rw [map_one]; exact one_ne_zero) hϕD₃ h₁ h₂
            have hx₃ : ϕ_h h (A₃ * D₁) / ϕ_h h (D₃ * D₁) = ϕ_h h A₃ / ϕ_h h D₃ := by
              rw [map_mul, map_mul, mul_div_mul_right _ _ hϕD₁]
            have hy₃ : ϕ_h h (B₃ * D₁) / ϕ_h h (D₃ * D₁) = ϕ_h h B₃ / ϕ_h h D₃ := by
              rw [map_mul, map_mul, mul_div_mul_right _ _ hϕD₁]
            have h₃' : W.Nonsingular (ϕ_h h (A₃ * D₁) / ϕ_h h (D₃ * D₁))
                (ϕ_h h (B₃ * D₁) / ϕ_h h (D₃ * D₁)) := by
              rwa [hx₃, hy₃]
            refine ⟨h₃', ?_⟩
            have h_pt₂ : WeierstrassCurve.Affine.Point.some h =
                WeierstrassCurve.Affine.Point.some h₂ := by
              congr 1
              · exact hx₂.symm
              · exact hy₂.symm
            rw [succ_nsmul, hkP, h_pt₂, h_add₃]
            congr 1
            · exact hx₃.symm
            · exact hy₃.symm
  have h_m := h_rep m
  rcases hQm : m • P_gen with _ | @⟨X_m, Y_m, hQ_m⟩
  · exact False.elim (hm hQm)
  · rw [hQm] at h_m
    obtain ⟨A_m, B_m, D_m, hDm, _, _, hm_spec⟩ := h_m
    obtain ⟨hP_ne, hP_eval⟩ := h_s2 D_m hDm
    apply h_s1 {P : W.Point | m • P = 0}
      (Algebra.norm (Polynomial K) D_m) hP_ne
    intro x y h h_mem
    apply hP_eval x (ϕ_h h) (hϕ_of h)
    by_contra hϕ_ne
    obtain ⟨h', hmP⟩ := hm_spec h hϕ_ne
    have h_zero : m • WeierstrassCurve.Affine.Point.some h = 0 := h_mem
    rw [hmP] at h_zero
    exact WeierstrassCurve.Affine.Point.some_ne_zero h' h_zero

theorem exists_functionField_valuation_and_generic_nonsingular (K : Type u) [Field K]
    (W : WeierstrassCurve.Affine K) :
    ∃ (v : Valuation W.FunctionField (WithZero (Multiplicative ℤ)))
      (h_gen : ((W.map (algebraMap K W.FunctionField)).toAffine).Nonsingular
        (algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)))
        (algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X))),
      (∀ c : K, v (algebraMap K W.FunctionField c) ≤ 1) ∧
      (∀ c : K, c ≠ 0 → v (algebraMap K W.FunctionField c) = 1) ∧
      1 < v (algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))) :=
by
  classical
  let R := W.CoordinateRing
  let L := W.FunctionField
  let X_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)
  let Y_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X
  haveI : Module.Free (Polynomial K) W.CoordinateRing :=
    Module.Free.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  haveI : Module.Finite (Polynomial K) W.CoordinateRing :=
    Module.Finite.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  have h_basis_eq_zero : ∀ p q : Polynomial K,
      p • (1 : R) + q • Y_R = 0 → p = 0 ∧ q = 0 := by
    intro p q h
    have h_deg := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W) p q
    rw [h, Algebra.norm_zero, Polynomial.degree_zero] at h_deg
    refine ⟨?_, ?_⟩
    · by_contra hp
      have hp_deg : p.degree = (p.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hp
      have h1 : 2 • p.degree ≤ ⊥ := by
        rw [h_deg]
        exact le_max_left _ _
      rw [hp_deg, two_nsmul, ← Nat.cast_add, le_bot_iff] at h1
      exact WithBot.natCast_ne_bot _ h1
    · by_contra hq
      have hq_deg : q.degree = (q.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hq
      have h1 : 2 • q.degree + 3 ≤ ⊥ := by
        rw [h_deg]
        exact le_max_right _ _
      change 2 • q.degree + ((3 : ℕ) : WithBot ℕ) ≤ ⊥ at h1
      rw [hq_deg, two_nsmul, ← Nat.cast_add, ← Nat.cast_add, le_bot_iff] at h1
      exact WithBot.natCast_ne_bot _ h1
  have h_smul_one : ∀ p : Polynomial K,
      p • (1 : R) = WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C p) := by
    intro p
    rw [WeierstrassCurve.Affine.CoordinateRing.smul, mul_one]
  have h_alg_K : ∀ c : K,
      algebraMap K R c = WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C c)) := by
    intro c
    rw [IsScalarTower.algebraMap_apply K (Polynomial K) W.CoordinateRing c,
      Polynomial.algebraMap_eq, Algebra.algebraMap_eq_smul_one, h_smul_one]
  have h_gen : ((W.map (algebraMap K L)).toAffine).Nonsingular
      (algebraMap R L X_R) (algebraMap R L Y_R) := by
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.equation_iff']
    simp only [WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₂,
      WeierstrassCurve.map_a₃, WeierstrassCurve.map_a₄, WeierstrassCurve.map_a₆,
      IsScalarTower.algebraMap_apply K R L]
    refine ⟨?_, ?_⟩
    · have h_sq := WeierstrassCurve.Affine.CoordinateRing.smul_basis_mul_Y (W' := W) 0 1
      simp only [zero_smul, one_smul, zero_add, one_mul, zero_sub, neg_smul, h_smul_one,
        WeierstrassCurve.Affine.CoordinateRing.smul] at h_sq
      simp only [h_alg_K, X_R, Y_R, map_add, map_sub, map_mul, map_pow, map_neg,
        map_zero, map_one] at h_sq
      have h_eq_R : Y_R ^ 2 + algebraMap K R W.a₁ * X_R * Y_R + algebraMap K R W.a₃ * Y_R -
          (X_R ^ 3 + algebraMap K R W.a₂ * X_R ^ 2 + algebraMap K R W.a₄ * X_R +
            algebraMap K R W.a₆) = 0 := by
        simp only [h_alg_K, X_R, Y_R, map_add, map_sub, map_mul, map_pow, map_neg,
          map_zero, map_one]
        linear_combination h_sq
      have h_eq_L := congrArg (algebraMap R L) h_eq_R
      simpa only [map_add, map_sub, map_mul, map_pow, map_zero] using h_eq_L
    · by_contra h_sing
      push_neg at h_sing
      rcases h_sing with ⟨hD₁_L, hD₂_L⟩
      have hD₁ : algebraMap K R W.a₁ * Y_R -
          (3 * X_R ^ 2 + 2 * algebraMap K R W.a₂ * X_R + algebraMap K R W.a₄) = 0 := by
        apply (IsFractionRing.injective R L)
        simpa only [map_add, map_sub, map_mul, map_pow, map_ofNat, map_zero] using hD₁_L
      have hD₂ : 2 * Y_R + algebraMap K R W.a₁ * X_R + algebraMap K R W.a₃ = 0 := by
        apply (IsFractionRing.injective R L)
        simpa only [map_add, map_mul, map_ofNat, map_zero] using hD₂_L
      have hD₁' : (-(3 * Polynomial.X ^ 2 + 2 * Polynomial.C W.a₂ * Polynomial.X + Polynomial.C W.a₄)) • (1 : R) +
          (Polynomial.C W.a₁) • Y_R = 0 := by
        rw [h_smul_one, WeierstrassCurve.Affine.CoordinateRing.smul]
        simp only [h_alg_K, X_R, Y_R, map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat] at hD₁ ⊢
        linear_combination hD₁
      have hD₂' : (Polynomial.C W.a₁ * Polynomial.X + Polynomial.C W.a₃) • (1 : R) +
          (Polynomial.C (2 : K)) • Y_R = 0 := by
        rw [h_smul_one, WeierstrassCurve.Affine.CoordinateRing.smul]
        simp only [h_alg_K, X_R, Y_R, map_add, map_mul, map_ofNat] at hD₂ ⊢
        linear_combination hD₂
      have hp₁ : -(3 * Polynomial.X ^ 2 + 2 * Polynomial.C W.a₂ * Polynomial.X + Polynomial.C W.a₄) = 0 :=
        (h_basis_eq_zero _ _ hD₁').1
      have hq₂ : Polynomial.C (2 : K) = 0 :=
        (h_basis_eq_zero _ _ hD₂').2
      have h2 : (2 : K) = 0 := Polynomial.C_eq_zero.mp hq₂
      have h3_coeff := congrArg (fun p : Polynomial K => p.coeff 2) hp₁
      simp [Polynomial.coeff_X_pow, Polynomial.coeff_C_mul, Polynomial.coeff_X,
        Polynomial.coeff_C] at h3_coeff
      have h1 : (1 : K) = 0 := by linear_combination h3_coeff - h2
      exact one_ne_zero h1
  let N : R →* Polynomial K := Algebra.norm (Polynomial K)
  have h_deg_add : ∀ f g : R, (N (f + g)).degree ≤ max (N f).degree (N g).degree := by
    intro f g
    obtain ⟨p₁, q₁, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq f
    obtain ⟨p₂, q₂, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq g
    have h_add : (p₁ • (1 : R) + q₁ • Y_R) + (p₂ • (1 : R) + q₂ • Y_R) =
        (p₁ + p₂) • (1 : R) + (q₁ + q₂) • Y_R := by
      rw [add_add_add_comm, ← add_smul, ← add_smul]
    rw [h_add]
    change ((Algebra.norm (Polynomial K)) ((p₁ + p₂) • (1 : R) + (q₁ + q₂) • Y_R)).degree ≤
      max (((Algebra.norm (Polynomial K)) (p₁ • (1 : R) + q₁ • Y_R)).degree)
        (((Algebra.norm (Polynomial K)) (p₂ • (1 : R) + q₂ • Y_R)).degree)
    rw [WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis,
      WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis,
      WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis]
    apply max_le
    · have hp := Polynomial.degree_add_le p₁ p₂
      rcases le_total p₁.degree p₂.degree with hp_le | hp_le
      · have hp' : (p₁ + p₂).degree ≤ p₂.degree := le_trans hp (max_le hp_le le_rfl)
        have hp2 : 2 • (p₁ + p₂).degree ≤ 2 • p₂.degree := nsmul_le_nsmul_right hp' 2
        exact le_trans hp2 (le_trans (le_max_left _ _) (le_max_right _ _))
      · have hp' : (p₁ + p₂).degree ≤ p₁.degree := le_trans hp (max_le le_rfl hp_le)
        have hp2 : 2 • (p₁ + p₂).degree ≤ 2 • p₁.degree := nsmul_le_nsmul_right hp' 2
        exact le_trans hp2 (le_trans (le_max_left _ _) (le_max_left _ _))
    · have hq := Polynomial.degree_add_le q₁ q₂
      rcases le_total q₁.degree q₂.degree with hq_le | hq_le
      · have hq' : (q₁ + q₂).degree ≤ q₂.degree := le_trans hq (max_le hq_le le_rfl)
        have hq2 : 2 • (q₁ + q₂).degree + 3 ≤ 2 • q₂.degree + 3 :=
          add_le_add_left (nsmul_le_nsmul_right hq' 2) 3
        exact le_trans hq2 (le_trans (le_max_right _ _) (le_max_right _ _))
      · have hq' : (q₁ + q₂).degree ≤ q₁.degree := le_trans hq (max_le le_rfl hq_le)
        have hq2 : 2 • (q₁ + q₂).degree + 3 ≤ 2 • q₁.degree + 3 :=
          add_le_add_left (nsmul_le_nsmul_right hq' 2) 3
        exact le_trans hq2 (le_trans (le_max_right _ _) (le_max_left _ _))
  let v_R : Valuation R (WithZero (Multiplicative ℤ)) :=
    { toFun := fun f => if f = 0 then 0 else WithZero.exp ((N f).natDegree : ℤ)
      map_zero' := if_pos rfl
      map_one' := by
        rw [if_neg one_ne_zero, map_one, Polynomial.natDegree_one, Nat.cast_zero, WithZero.exp_zero]
      map_mul' := by
        intro f g
        rcases eq_or_ne f 0 with rfl | hf
        · rw [zero_mul, if_pos rfl, zero_mul]
        · rcases eq_or_ne g 0 with rfl | hg
          · rw [mul_zero, if_pos rfl, mul_zero]
          · have hfg : f * g ≠ 0 := mul_ne_zero hf hg
            have hnf : N f ≠ 0 := Algebra.norm_eq_zero_iff.not.mpr hf
            have hng : N g ≠ 0 := Algebra.norm_eq_zero_iff.not.mpr hg
            rw [if_neg hfg, if_neg hf, if_neg hg, map_mul, Polynomial.natDegree_mul hnf hng,
              Nat.cast_add, WithZero.exp_add]
      map_add_le_max' := by
        intro f g
        rcases eq_or_ne (f + g) 0 with hfg | hfg
        · rw [if_pos hfg]
          exact zero_le'
        · rw [if_neg hfg]
          have hnfg : N (f + g) ≠ 0 := Algebra.norm_eq_zero_iff.not.mpr hfg
          rcases le_max_iff.mp (h_deg_add f g) with hle | hle
          · have hf : f ≠ 0 := by
              intro hf0
              have hle' : (N (f + g)).degree ≤ ⊥ := by
                simpa [hf0, N, Algebra.norm_zero, Polynomial.degree_zero] using hle
              exact hnfg (Polynomial.degree_eq_bot.mp (le_bot_iff.mp hle'))
            rw [if_neg hf]
            have h_nd : (N (f + g)).natDegree ≤ (N f).natDegree :=
              Polynomial.natDegree_le_natDegree hle
            exact le_trans (WithZero.exp_le_exp.mpr (Int.ofNat_le.mpr h_nd)) (le_max_left _ _)
          · have hg : g ≠ 0 := by
              intro hg0
              have hle' : (N (f + g)).degree ≤ ⊥ := by
                simpa [hg0, N, Algebra.norm_zero, Polynomial.degree_zero] using hle
              exact hnfg (Polynomial.degree_eq_bot.mp (le_bot_iff.mp hle'))
            rw [if_neg hg]
            have h_nd : (N (f + g)).natDegree ≤ (N g).natDegree :=
              Polynomial.natDegree_le_natDegree hle
            exact le_trans (WithZero.exp_le_exp.mpr (Int.ofNat_le.mpr h_nd)) (le_max_right _ _) }
  have hv_supp : v_R.supp = ⊥ := by
    ext f
    rw [Valuation.mem_supp_iff, Ideal.mem_bot]
    change (if f = 0 then 0 else WithZero.exp ((N f).natDegree : ℤ)) = 0 ↔ f = 0
    split_ifs with hf
    · simp [hf]
    · simp [hf, WithZero.exp_ne_zero]
  have hS : nonZeroDivisors R ≤ v_R.supp.primeCompl := by
    intro f hf hf_supp
    change f ∈ v_R.supp at hf_supp
    rw [hv_supp, Ideal.mem_bot] at hf_supp
    exact mem_nonZeroDivisors_iff_ne_zero.mp hf hf_supp
  let v : Valuation L (WithZero (Multiplicative ℤ)) := v_R.extendToLocalization hS L
  have hv_K : ∀ c : K, c ≠ 0 → v (algebraMap K L c) = 1 := by
    intro c hc
    rw [IsScalarTower.algebraMap_apply K R L c,
      Valuation.extendToLocalization_apply_map_apply]
    have hc_smul : algebraMap K R c = (Polynomial.C c) • (1 : R) + 0 • Y_R := by
      rw [zero_smul, add_zero, IsScalarTower.algebraMap_apply K (Polynomial K) R c,
        Polynomial.algebraMap_eq, Algebra.algebraMap_eq_smul_one]
    have h_norm_c0 : N (algebraMap K R c) = Polynomial.C c ^ 2 := by
      rw [hc_smul]
      have h_nb := WeierstrassCurve.Affine.CoordinateRing.norm_smul_basis (W' := W) (Polynomial.C c) 0
      simpa using h_nb
    have h_norm_c : N (algebraMap K R c) = Polynomial.C (c ^ 2) := by
      rw [h_norm_c0, ← Polynomial.C_pow]
    have hc_ne : algebraMap K R c ≠ 0 := by
      intro h0
      have h0' : N (algebraMap K R c) = 0 := by
        dsimp only [N, R]
        rw [h0, Algebra.norm_zero]
      rw [h_norm_c, Polynomial.C_eq_zero] at h0'
      exact pow_ne_zero 2 hc h0'
    change (if algebraMap K R c = 0 then 0 else WithZero.exp ((N (algebraMap K R c)).natDegree : ℤ)) = 1
    rw [if_neg hc_ne, h_norm_c, Polynomial.natDegree_C, Nat.cast_zero, WithZero.exp_zero]
  refine ⟨v, h_gen, ?_, hv_K, ?_⟩
  · intro c
    rcases eq_or_ne c 0 with rfl | hc
    · rw [map_zero, Valuation.map_zero]
      exact zero_le'
    · rw [hv_K c hc]
  · rw [Valuation.extendToLocalization_apply_map_apply]
    have hX_smul : X_R = (Polynomial.X : Polynomial K) • (1 : R) + (0 : Polynomial K) • Y_R := by
      rw [zero_smul, add_zero, h_smul_one]
    have h_norm_X : N X_R = (Polynomial.X : Polynomial K) ^ 2 := by
      rw [hX_smul]
      have h_nb := WeierstrassCurve.Affine.CoordinateRing.norm_smul_basis (W' := W) (Polynomial.X : Polynomial K) 0
      simpa using h_nb
    have hX_ne : X_R ≠ 0 := by
      intro h0
      have h0' : N X_R = 0 := by
        dsimp only [N, R]
        rw [h0, Algebra.norm_zero]
      rw [h_norm_X] at h0'
      exact pow_ne_zero 2 Polynomial.X_ne_zero h0'
    change 1 < (if X_R = 0 then 0 else WithZero.exp ((N X_R).natDegree : ℤ))
    rw [if_neg hX_ne, h_norm_X, Polynomial.natDegree_X_pow, ← WithZero.exp_zero,
      WithZero.exp_lt_exp]
    decide

theorem weierstrass_nsmul_ne_zero_of_valuation {L : Type u} [Field L] [DecidableEq L]
    (v : Valuation L (WithZero (Multiplicative ℤ)))
    (W : WeierstrassCurve.Affine L)
    (ha₁ : v W.a₁ ≤ 1) (ha₂ : v W.a₂ ≤ 1) (ha₃ : v W.a₃ ≤ 1)
    (ha₄ : v W.a₄ ≤ 1) (ha₆ : v W.a₆ ≤ 1)
    {x y : L} (h : W.Nonsingular x y) (hx : 1 < v x)
    (m : ℕ) (hm : v (m : L) = 1) :
    m • (WeierstrassCurve.Affine.Point.some h : W.Point) ≠ 0 :=
by
  have h_s1 : ∀ {x' y' : L}, W.Equation x' y' → 1 < v x' →
      v y' ^ 2 = v x' ^ 3 ∧ 0 < v (x' / y') ∧ v (x' / y') < 1 ∧
        v (x' / y') * v y' = v x' ∧ v (x' / y') ^ 2 * v x' = 1 ∧ v (x' / y') ^ 3 * v y' = 1 := by
    intro x y h_eq hx
    have hx0 : 0 < v x := zero_lt_one.trans hx
    have hx_ne : v x ≠ 0 := ne_of_gt hx0
    have hx2_gt : v x < v x ^ 2 := by
      rw [sq]
      exact lt_mul_of_one_lt_right hx0 hx
    have hx3_gt : v x ^ 2 < v x ^ 3 := by
      rw [pow_succ _ 2]
      exact lt_mul_of_one_lt_right (hx0.trans hx2_gt) hx
    have hx1_lt2 : 1 < v x ^ 2 := hx.trans hx2_gt
    have hx1_lt3 : 1 < v x ^ 3 := hx1_lt2.trans hx3_gt
    have hx_lt3 : v x < v x ^ 3 := hx2_gt.trans hx3_gt
    have heq : y ^ 2 + W.a₁ * x * y + W.a₃ * y = x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆ := by
      have h0 := (W.equation_iff' x y).mp h_eq
      linear_combination h0
    have h_rhs_rem : v (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) < v (x ^ 3) := by
      rw [map_pow]
      have h1 : v (W.a₂ * x ^ 2) < v x ^ 3 := by
        rw [map_mul, map_pow]
        exact (mul_le_of_le_one_left' ha₂).trans_lt hx3_gt
      have h2 : v (W.a₄ * x) < v x ^ 3 := by
        rw [map_mul]
        exact (mul_le_of_le_one_left' ha₄).trans_lt hx_lt3
      have h3 : v W.a₆ < v x ^ 3 := ha₆.trans_lt hx1_lt3
      exact (Valuation.map_add _ _ _).trans_lt (max_lt (Valuation.map_add_lt _ h1 h2) h3)
    have h_rhs : v (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) = v x ^ 3 := by
      have h_assoc : x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆ = x ^ 3 + (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) := by ring
      rw [h_assoc, Valuation.map_add_eq_of_lt_left v h_rhs_rem, map_pow]
    have h_lhs_val : v (y ^ 2 + W.a₁ * x * y + W.a₃ * y) = v x ^ 3 := by
      rw [heq, h_rhs]
    have hxy_lt : v x < v y := by
      by_contra! hle
      have hy2 : v (y ^ 2) < v x ^ 3 := by
        rw [map_pow]
        exact (pow_le_pow_left' hle 2).trans_lt hx3_gt
      have ha1xy : v (W.a₁ * x * y) < v x ^ 3 := by
        rw [map_mul, map_mul]
        have : v W.a₁ * v x * v y ≤ 1 * v x * v x :=
          mul_le_mul' (mul_le_mul' ha₁ le_rfl) hle
        rw [one_mul, ← sq] at this
        exact this.trans_lt hx3_gt
      have ha3y : v (W.a₃ * y) < v x ^ 3 := by
        rw [map_mul]
        exact (mul_le_mul' ha₃ hle).trans_lt (by rw [one_mul]; exact hx_lt3)
      have h_lt : v (y ^ 2 + W.a₁ * x * y + W.a₃ * y) < v x ^ 3 :=
        (Valuation.map_add _ _ _).trans_lt (max_lt (Valuation.map_add_lt _ hy2 ha1xy) ha3y)
      exact ne_of_lt h_lt h_lhs_val
    have hy0 : 0 < v y := hx0.trans hxy_lt
    have hy_ne : v y ≠ 0 := ne_of_gt hy0
    have hy1 : 1 < v y := hx.trans hxy_lt
    have h_lhs_rem : v (W.a₁ * x * y + W.a₃ * y) < v (y ^ 2) := by
      rw [map_pow, sq]
      have ha1xy : v (W.a₁ * x * y) < v y * v y := by
        rw [map_mul, map_mul]
        calc v W.a₁ * v x * v y ≤ 1 * v x * v y := mul_le_mul' (mul_le_mul' ha₁ le_rfl) le_rfl
          _ = v x * v y := by rw [one_mul]
          _ < v y * v y := mul_lt_mul_of_pos_right hxy_lt hy0
      have ha3y : v (W.a₃ * y) < v y * v y := by
        rw [map_mul]
        calc v W.a₃ * v y ≤ 1 * v y := mul_le_mul' ha₃ le_rfl
          _ < v y * v y := mul_lt_mul_of_pos_right hy1 hy0
      exact Valuation.map_add_lt _ ha1xy ha3y
    have hy2_eq : v y ^ 2 = v x ^ 3 := by
      have h_assoc : y ^ 2 + W.a₁ * x * y + W.a₃ * y = y ^ 2 + (W.a₁ * x * y + W.a₃ * y) := by ring
      rw [h_assoc, Valuation.map_add_eq_of_lt_left v h_lhs_rem, map_pow] at h_lhs_val
      exact h_lhs_val
    have hr_mul : v (x / y) * v y = v x := by
      rw [map_div₀, div_mul_cancel₀ _ hy_ne]
    have hr_pos : 0 < v (x / y) := by
      rw [map_div₀]
      exact div_pos hx0 hy0
    have hr_lt : v (x / y) < 1 := by
      rw [map_div₀, div_lt_one₀ hy0]
      exact hxy_lt
    have hr2_x : v (x / y) ^ 2 * v x = 1 := by
      apply mul_right_cancel₀ (pow_ne_zero 2 hy_ne)
      calc (v (x / y) ^ 2 * v x) * v y ^ 2
          = (v (x / y) * v y) ^ 2 * v x := by
            rw [mul_pow, mul_right_comm (v (x / y) ^ 2) (v x) (v y ^ 2)]
        _ = v x ^ 2 * v x := by rw [hr_mul]
        _ = v x ^ 3 := by rw [← pow_succ _ 2]
        _ = 1 * v y ^ 2 := by rw [← hy2_eq, one_mul]
    have hr3_y : v (x / y) ^ 3 * v y = 1 := by
      calc v (x / y) ^ 3 * v y = v (x / y) ^ 2 * (v (x / y) * v y) := by
            rw [pow_succ _ 2, mul_assoc]
        _ = v (x / y) ^ 2 * v x := by rw [hr_mul]
        _ = 1 := hr2_x
    exact ⟨hy2_eq, hr_pos, hr_lt, hr_mul, hr2_x, hr3_y⟩
  have h_s2 : ∀ {x₁ y₁ x₂ y₂ : L}, W.Equation x₁ y₁ → W.Equation x₂ y₂ →
      ¬ (x₁ = x₂ ∧ y₁ = W.negY x₂ y₂) →
      1 < v x₁ → v y₁ ^ 2 = v x₁ ^ 3 → 1 < v x₂ → v y₂ ^ 2 = v x₂ ^ 3 →
      v y₁ * v y₂ ≤ max (v (x₁ / y₁)) (v (x₂ / y₂)) * (v x₁ * v x₂) *
        v (y₁ - W.slope x₁ x₂ y₁ y₂ * x₁) ∧
      v (W.slope x₁ x₂ y₁ y₂) ≤ max (v (x₁ / y₁)) (v (x₂ / y₂)) ^ 2 *
        v (y₁ - W.slope x₁ x₂ y₁ y₂ * x₁) := by
    intro x₁ y₁ x₂ y₂ h₁ h₂ hxy hx₁ hy₁ hx₂ hy₂
    obtain ⟨_, hr₁_pos, hr₁_lt, hr₁_mul, hr₁_sq_x, _⟩ := h_s1 h₁ hx₁
    obtain ⟨_, hr₂_pos, hr₂_lt, hr₂_mul, hr₂_sq_x, _⟩ := h_s1 h₂ hx₂
    set L_sl := W.slope x₁ x₂ y₁ y₂
    set M := y₁ - L_sl * x₁
    set r₁ := v (x₁ / y₁)
    set r₂ := v (x₂ / y₂)
    set r := max r₁ r₂
    have hr₁_le : r₁ ≤ r := le_max_left _ _
    have hr₂_le : r₂ ≤ r := le_max_right _ _
    have hx₁_pos : 0 < v x₁ := zero_lt_one.trans hx₁
    have hx₂_pos : 0 < v x₂ := zero_lt_one.trans hx₂
    have hxy₁_lt : v x₁ < v y₁ := by
      rw [← hr₁_mul]
      have hy₁_pos : 0 < v y₁ := by
        by_contra! hle
        have h0 : v y₁ = 0 := le_antisymm hle zero_le'
        rw [h0, mul_zero] at hr₁_mul
        exact ne_of_gt hx₁_pos hr₁_mul.symm
      exact mul_lt_of_lt_one_left hy₁_pos hr₁_lt
    have hxy₂_lt : v x₂ < v y₂ := by
      rw [← hr₂_mul]
      have hy₂_pos : 0 < v y₂ := by
        by_contra! hle
        have h0 : v y₂ = 0 := le_antisymm hle zero_le'
        rw [h0, mul_zero] at hr₂_mul
        exact ne_of_gt hx₂_pos hr₂_mul.symm
      exact mul_lt_of_lt_one_left hy₂_pos hr₂_lt
    have hy₁_pos : 0 < v y₁ := hx₁_pos.trans hxy₁_lt
    have hy₂_pos : 0 < v y₂ := hx₂_pos.trans hxy₂_lt
    have hy₁_gt1 : 1 < v y₁ := hx₁.trans hxy₁_lt
    have hy₂_gt1 : 1 < v y₂ := hx₂.trans hxy₂_lt
    have hx₁_ge1 : 1 ≤ v x₁ := le_of_lt hx₁
    have hx₂_ge1 : 1 ≤ v x₂ := le_of_lt hx₂
    have hy₁_ge1 : 1 ≤ v y₁ := le_of_lt hy₁_gt1
    have hy₂_ge1 : 1 ≤ v y₂ := le_of_lt hy₂_gt1
    have hxy₁_le : v x₁ ≤ v y₁ := le_of_lt hxy₁_lt
    have hxy₂_le : v x₂ ≤ v y₂ := le_of_lt hxy₂_lt
    have hy₁_ne : y₁ ≠ 0 := by
      intro h0; rw [h0, map_zero] at hy₁_pos; exact lt_irrefl 0 hy₁_pos
    have hyx₁_sq : v y₁ < v x₁ ^ 2 := by
      apply lt_of_mul_lt_mul_left _ (le_of_lt hy₁_pos)
      calc v y₁ * v y₁ = v y₁ ^ 2 := (sq _).symm
        _ = v x₁ ^ 3 := hy₁
        _ = v x₁ * v x₁ ^ 2 := by rw [pow_succ' _ 2]
        _ < v y₁ * v x₁ ^ 2 := mul_lt_mul_of_pos_right hxy₁_lt (pow_pos hx₁_pos 2)
    have hyx₂_sq : v y₂ < v x₂ ^ 2 := by
      apply lt_of_mul_lt_mul_left _ (le_of_lt hy₂_pos)
      calc v y₂ * v y₂ = v y₂ ^ 2 := (sq _).symm
        _ = v x₂ ^ 3 := hy₂
        _ = v x₂ * v x₂ ^ 2 := by rw [pow_succ' _ 2]
        _ < v y₂ * v x₂ ^ 2 := mul_lt_mul_of_pos_right hxy₂_lt (pow_pos hx₂_pos 2)
    have hyx₁_sq_le : v y₁ ≤ v x₁ ^ 2 := le_of_lt hyx₁_sq
    have hyx₂_sq_le : v y₂ ≤ v x₂ ^ 2 := le_of_lt hyx₂_sq
    have hf₁ : y₁ ^ 2 + W.a₁ * x₁ * y₁ + W.a₃ * y₁ - (x₁ ^ 3 + W.a₂ * x₁ ^ 2 + W.a₄ * x₁ + W.a₆) = 0 :=
      (W.equation_iff' x₁ y₁).mp h₁
    have hf₂ : y₂ ^ 2 + W.a₁ * x₂ * y₂ + W.a₃ * y₂ - (x₂ ^ 3 + W.a₂ * x₂ ^ 2 + W.a₄ * x₂ + W.a₆) = 0 :=
      (W.equation_iff' x₂ y₂).mp h₂
    set U₀ : L := y₁ ^ 2 * y₂ ^ 2 + W.a₁ * x₁ * y₁ * y₂ ^ 2 - W.a₂ * x₁ ^ 2 * y₂ ^ 2 +
      (W.a₃ * y₁ - W.a₄ * x₁) * y₂ * (y₁ + y₂) - W.a₆ * (y₁ ^ 2 + y₁ * y₂ + y₂ ^ 2)
    set V₀ : L := x₁ ^ 2 * y₂ ^ 2 + x₁ * x₂ * y₁ * y₂ + y₁ ^ 2 * (x₂ ^ 2 + W.a₄) -
      W.a₁ * y₁ ^ 2 * y₂ + W.a₂ * y₁ * (x₁ * y₂ + x₂ * y₁)
    set W₀ : L := -x₁ ^ 2 * x₂ * y₂ - x₁ * x₂ ^ 2 * y₁ + W.a₁ * x₁ * y₁ * y₂ -
      W.a₂ * x₁ ^ 2 * y₂ - W.a₂ * x₁ * x₂ * y₁ + W.a₃ * y₁ * y₂ -
      W.a₄ * x₁ * y₁ - W.a₄ * x₁ * y₂ - W.a₆ * y₁ - W.a₆ * y₂
    have h_id1 : U₀ - V₀ * x₁ - y₁ * W₀ = 0 := by
      linear_combination y₂ ^ 2 * hf₁
    have h_id2 : U₀ * L_sl + V₀ * M = 0 := by
      by_cases hx_eq : x₁ = x₂
      · have hy_ne : y₁ ≠ W.negY x₂ y₂ := fun hy => hxy ⟨hx_eq, hy⟩
        have hy_eq : y₁ = y₂ := W.Y_eq_of_Y_ne h₁ h₂ hx_eq hy_ne
        have h_sl := W.slope_of_Y_ne hx_eq hy_ne
        have hy_ne1 : y₁ ≠ W.negY x₁ y₁ := by
          rwa [← hx_eq, ← hy_eq] at hy_ne
        have h_den_ne : y₁ - W.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy_ne1
        have h_negY : y₁ - W.negY x₁ y₁ = 2 * y₁ + W.a₁ * x₁ + W.a₃ := by
          unfold WeierstrassCurve.Affine.negY
          ring
        have h_den_L : (2 * y₁ + W.a₁ * x₁ + W.a₃) * L_sl =
            3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁ := by
          dsimp only [L_sl]
          rw [← h_negY, h_sl, mul_div_cancel₀ _ h_den_ne]
        have h_mul : (2 * y₁ + W.a₁ * x₁ + W.a₃) * (U₀ * L_sl + V₀ * M) = 0 := by
          dsimp only [U₀, V₀, M]
          rw [← hx_eq, ← hy_eq]
          linear_combination (y₁ ^ 4 + W.a₁ * x₁ * y₁ ^ 3 - W.a₂ * x₁ ^ 2 * y₁ ^ 2 +
            2 * W.a₃ * y₁ ^ 3 - 2 * W.a₄ * x₁ * y₁ ^ 2 - 3 * W.a₆ * y₁ ^ 2 -
            3 * x₁ ^ 3 * y₁ ^ 2 - W.a₄ * x₁ * y₁ ^ 2 + W.a₁ * x₁ * y₁ ^ 3 -
            2 * W.a₂ * x₁ ^ 2 * y₁ ^ 2) * h_den_L +
            3 * y₁ ^ 2 * (3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) * hf₁
        have h_den_ne' : 2 * y₁ + W.a₁ * x₁ + W.a₃ ≠ 0 := by
          rw [← h_negY]
          exact h_den_ne
        exact mul_left_cancel₀ h_den_ne' (h_mul.trans (mul_zero _).symm)
      · have h_ch : (x₁ - x₂) * L_sl = y₁ - y₂ := by
          dsimp only [L_sl]
          rw [W.slope_of_X_ne hx_eq, mul_div_cancel₀ _ (sub_ne_zero.mpr hx_eq)]
        have h_mul : (x₁ - x₂) * (U₀ * L_sl + V₀ * M) = 0 := by
          dsimp only [M]
          linear_combination (U₀ - V₀ * x₁) * h_ch - y₂ ^ 3 * hf₁ + y₁ ^ 3 * hf₂
        exact mul_left_cancel₀ (sub_ne_zero.mpr hx_eq) (h_mul.trans (mul_zero _).symm)
    have hWM : W₀ * M = U₀ := by
      apply mul_left_cancel₀ hy₁_ne
      dsimp only [M] at h_id2 ⊢
      linear_combination -M * h_id1 - x₁ * h_id2
    have hWL : W₀ * L_sl = -V₀ := by
      apply mul_left_cancel₀ hy₁_ne
      dsimp only [M] at h_id2
      linear_combination -L_sl * h_id1 + h_id2
    have h_add_le : ∀ {a b : L} {B : WithZero (Multiplicative ℤ)}, v a ≤ B → v b ≤ B → v (a + b) ≤ B :=
      fun ha hb => (v.map_add _ _).trans (max_le ha hb)
    have h_sub_le : ∀ {a b : L} {B : WithZero (Multiplicative ℤ)}, v a ≤ B → v b ≤ B → v (a - b) ≤ B :=
      fun ha hb => (v.map_sub _ _).trans (max_le ha hb)
    have h_add_lt : ∀ {a b : L} {B : WithZero (Multiplicative ℤ)}, v a < B → v b < B → v (a + b) < B :=
      fun ha hb => v.map_add_lt ha hb
    have h_sub_lt : ∀ {a b : L} {B : WithZero (Multiplicative ℤ)}, v a < B → v b < B → v (a - b) < B :=
      fun ha hb => v.map_sub_lt ha hb
    have h_coeff_le : ∀ {a c : L} {B : WithZero (Multiplicative ℤ)}, v a ≤ 1 → v c ≤ B → v (a * c) ≤ B :=
      fun ha hc => by rw [map_mul]; exact (mul_le_of_le_one_left' ha).trans hc
    have h_coeff_lt : ∀ {a c : L} {B : WithZero (Multiplicative ℤ)}, v a ≤ 1 → v c < B → v (a * c) < B :=
      fun ha hc => by rw [map_mul]; exact (mul_le_of_le_one_left' ha).trans_lt hc
    have hx₁_sq_lt_y₁_sq : v x₁ ^ 2 < v y₁ ^ 2 := by
      rw [hy₁, pow_succ _ 2]
      exact lt_mul_of_one_lt_right (pow_pos hx₁_pos 2) hx₁
    have hy₁_lt_sq : v y₁ < v y₁ ^ 2 := by
      rw [sq]; exact lt_mul_of_one_lt_right hy₁_pos hy₁_gt1
    have hy₂_lt_sq : v y₂ < v y₂ ^ 2 := by
      rw [sq]; exact lt_mul_of_one_lt_right hy₂_pos hy₂_gt1
    have hU₀ : v U₀ = v y₁ ^ 2 * v y₂ ^ 2 := by
      set U_rem : L := W.a₁ * (x₁ * y₁ * y₂ ^ 2) - W.a₂ * (x₁ ^ 2 * y₂ ^ 2) +
        (W.a₃ * y₁ - W.a₄ * x₁) * (y₂ * y₁ + y₂ ^ 2) - W.a₆ * (y₁ ^ 2 + y₁ * y₂ + y₂ ^ 2)
      have hU_split : U₀ = y₁ ^ 2 * y₂ ^ 2 + U_rem := by dsimp only [U₀, U_rem]; ring
      have h_head : v (y₁ ^ 2 * y₂ ^ 2) = v y₁ ^ 2 * v y₂ ^ 2 := by rw [map_mul, map_pow, map_pow]
      have h_rem : v U_rem < v (y₁ ^ 2 * y₂ ^ 2) := by
        rw [h_head]
        have ht1 : v (W.a₁ * (x₁ * y₁ * y₂ ^ 2)) < v y₁ ^ 2 * v y₂ ^ 2 := by
          apply h_coeff_lt ha₁
          rw [map_mul, map_mul, map_pow, sq (v y₁)]
          exact mul_lt_mul_of_pos_right (mul_lt_mul_of_pos_right hxy₁_lt hy₁_pos) (pow_pos hy₂_pos 2)
        have ht2 : v (W.a₂ * (x₁ ^ 2 * y₂ ^ 2)) < v y₁ ^ 2 * v y₂ ^ 2 := by
          apply h_coeff_lt ha₂
          rw [map_mul, map_pow, map_pow]
          exact mul_lt_mul_of_pos_right hx₁_sq_lt_y₁_sq (pow_pos hy₂_pos 2)
        have ht3 : v ((W.a₃ * y₁ - W.a₄ * x₁) * (y₂ * y₁ + y₂ ^ 2)) < v y₁ ^ 2 * v y₂ ^ 2 := by
          rw [map_mul]
          have h3a : v (W.a₃ * y₁ - W.a₄ * x₁) ≤ v y₁ :=
            h_sub_le (h_coeff_le ha₃ le_rfl) (h_coeff_le ha₄ hxy₁_le)
          have h3b : v (y₂ * y₁ + y₂ ^ 2) < v y₁ * v y₂ ^ 2 := by
            apply h_add_lt
            · rw [map_mul, mul_comm (v y₂)]
              exact mul_lt_mul_of_pos_left hy₂_lt_sq hy₁_pos
            · rw [map_pow]
              exact lt_mul_of_one_lt_left (pow_pos hy₂_pos 2) hy₁_gt1
          calc v (W.a₃ * y₁ - W.a₄ * x₁) * v (y₂ * y₁ + y₂ ^ 2)
              ≤ v y₁ * v (y₂ * y₁ + y₂ ^ 2) := mul_le_mul' h3a le_rfl
            _ < v y₁ * (v y₁ * v y₂ ^ 2) := mul_lt_mul_of_pos_left h3b hy₁_pos
            _ = v y₁ ^ 2 * v y₂ ^ 2 := by rw [← mul_assoc, ← sq]
        have ht4 : v (W.a₆ * (y₁ ^ 2 + y₁ * y₂ + y₂ ^ 2)) < v y₁ ^ 2 * v y₂ ^ 2 := by
          apply h_coeff_lt ha₆
          apply h_add_lt (h_add_lt _ _)
          · rw [map_pow]
            exact lt_mul_of_one_lt_left (pow_pos hy₂_pos 2) (one_lt_pow' hy₁_gt1 two_ne_zero)
          · rw [map_pow]
