      exact not_lt_of_ge h_pow_le (one_lt_pow₀ h_gt (by norm_num))
    let α : K := ζ ^ (2 * k * m)
    let β : K := ζ ^ (3 * k * m)
    have he_dvd12 : 12 = e * Nat.gcd n 12 := he_dvd12_id
    have hζ12 : ζ ^ 12 = 1 := by
      rw [he_dvd12, pow_mul, hζ_pow, one_pow]
    have hα_pow : α ^ 6 = 1 := by
      dsimp [α]
      rw [← pow_mul]
      have : 2 * k * m * 6 = 12 * (k * m) := by ring
      rw [this, pow_mul, hζ12, one_pow]
    have hβ_pow : β ^ 4 = 1 := by
      dsimp [β]
      rw [← pow_mul]
      have : 3 * k * m * 4 = 12 * (k * m) := by ring
      rw [this, pow_mul, hζ12, one_pow]
    have hm_sq : m * m = 1 + e * ((m * m - 1) / e) := hm_sq_id
    have hζ_km_m : (ζ ^ (k * m)) ^ m = ζ ^ k := by
      calc (ζ ^ (k * m)) ^ m = ζ ^ (k * (m * m)) := by rw [← pow_mul, mul_assoc]
        _ = ζ ^ (k * (1 + e * ((m * m - 1) / e))) := by rw [← hm_sq]
        _ = ζ ^ (k + e * (k * ((m * m - 1) / e))) := by congr 1; ring
        _ = ζ ^ k * (ζ ^ e) ^ (k * ((m * m - 1) / e)) := by rw [pow_add, pow_mul]
        _ = ζ ^ k := by rw [hζ_pow, one_pow, mul_one]
    have hζ_k_ne : ζ ^ k ≠ 1 := hζ_ord k hk_dvd hk_lt
    have hζ_km_ne : ζ ^ (k * m) ≠ 1 := by
      intro h1
      apply hζ_k_ne
      rw [← hζ_km_m, h1, one_pow]
    have h_nontriv : β = 1 → α ≠ 1 ∧ v_val W₂.a₄ < 1 := by
      intro hβ1
      have hζ3 : ζ ^ (3 * k * m) = 1 := hβ1
      refine ⟨?_, ?_⟩
      · intro hα1
        have hζ2 : ζ ^ (2 * k * m) = 1 := hα1
        apply hζ_km_ne
        calc ζ ^ (k * m) = ζ ^ (k * m) * 1 := (mul_one _).symm
