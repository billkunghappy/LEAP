      have hΨ_wv : Ψ_u w_v = v := by
        apply Units.ext
        change Ψ (w_v : R_A) = (v : H)
        rw [hw_v, hv_ab]
        change IntermediateField.inclusion h (e_bot.symm (e_bot a)) +
          IntermediateField.inclusion h (e_bot.symm (e_bot b)) * (u : H) = _
        rw [e_bot.symm_apply_apply, e_bot.symm_apply_apply]
      obtain ⟨m, hm⟩ := hg (red_u w_v)
      change g ^ m = red_u w_v at hm
      have h_red1 : red_u (w_v * (w_g ^ m)⁻¹) = 1 := by
        rw [map_mul, map_inv, map_pow, hw_g_red, ← hm, mul_inv_cancel]
      have h_mem_u1 : v * (v_g ^ m)⁻¹ ∈ EllipticRootNumber.unitGroup F H 1 := by
        have := h_ker_red (w_v * (w_g ^ m)⁻¹) h_red1
        rwa [map_mul, map_inv, map_pow, hΨ_wv] at this
      have h_one := h_triv₁ (v * (v_g ^ m)⁻¹) h_mem_u1
      rw [map_mul, map_inv, map_pow, mul_inv_eq_one] at h_one
      exact ⟨m, h_one⟩
    let z_u : R_A := ⟨0, 1⟩
    have hz_u_red : red z_u = u_bar₀ := by
      refine QuadraticAlgebra.ext ?_ ?_
      · exact map_zero (IsLocalRing.residue ↥A)
      · exact map_one (IsLocalRing.residue ↥A)
    obtain ⟨w_u, hw_u⟩ := h_mk_unit z_u (by rw [hz_u_red]; exact hu_bar₀_ne)
    have hw_u_red : red_u w_u = u_bar := by
      apply Units.ext
      change red (w_u : R_A) = u_bar₀
      rw [hw_u, hz_u_red]
    have hΨ_wu : Ψ_u w_u = u := by
      apply Units.ext
      change Ψ (w_u : R_A) = (u : H)
      rw [hw_u]
      change IntermediateField.inclusion h (e_bot.symm (0 : F)) +
        IntermediateField.inclusion h (e_bot.symm (1 : F)) * (u : H) = (u : H)
      simp
    have h_red_u_eq1 : red_u (w_u * (w_g ^ k_u)⁻¹) = 1 := by
      rw [map_mul, map_inv, map_pow, hw_u_red, hw_g_red, hk_u, mul_inv_cancel]
    have hu_mem1 : u * (v_g ^ k_u)⁻¹ ∈ EllipticRootNumber.unitGroup F H 1 := by
      have := h_ker_red (w_u * (w_g ^ k_u)⁻¹) h_red_u_eq1
      rwa [map_mul, map_inv, map_pow, hΨ_wu] at this
    have hφ'_u : φ' u = ζ ^ k_u := by
      have h_one := h_triv₁ (u * (v_g ^ k_u)⁻¹) hu_mem1
      rw [map_mul, map_inv, map_pow, mul_inv_eq_one] at h_one
      exact h_one
    have hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1 := h_pow v_g hv_g₀
    have hζ_ord : ∀ k : ℕ, k ∣ (12 / Nat.gcd n 12) → k < 12 / Nat.gcd n 12 → ζ ^ k ≠ 1 := by
      intro k hk hlt h_eq1
      obtain ⟨v, hv₀, hv_ne⟩ := h_ord k hk hlt
      apply hv_ne
      refine Subgroup.closure_induction (p := fun x _ => φ' x ^ k = 1) ?_ ?_ ?_ ?_ hv₀
      · intro x hx
        rw [Set.mem_setOf_eq, if_pos rfl] at hx
        obtain ⟨m, hm⟩ := h_gen_pow x hx
        rw [hm, ← pow_mul, mul_comm, pow_mul, h_eq1, one_pow]
      · dsimp only
        rw [map_one, one_pow]
      · intro x y _ _ ihx ihy
        dsimp only at ihx ihy ⊢
        rw [map_mul, mul_pow, ihx, ihy, mul_one]
      · intro x _ ihx
        dsimp only at ihx ⊢
        rw [map_inv, inv_pow, ihx, inv_one]
    have hdvd_e : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F + 1) := by
      have hq_div12 : EllipticRootNumber.q F =
          12 * (EllipticRootNumber.q F / 12) + EllipticRootNumber.q F % 12 :=
        (Nat.div_add_mod (EllipticRootNumber.q F) 12).symm
      have hr : EllipticRootNumber.q F % 12 = 1 ∨ EllipticRootNumber.q F % 12 = 5 ∨
          EllipticRootNumber.q F % 12 = 7 ∨ EllipticRootNumber.q F % 12 = 11 := by
        have : EllipticRootNumber.q F % 12 < 12 := Nat.mod_lt _ (by omega)
        rw [hq_div12] at hq2 hq3
        omega
      rcases hr with hr | hr | hr | hr <;>
        (rw [hq_div12, hr] at hdi ⊢;
         interval_cases n <;>
           (norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdi ⊢; omega))
    have hζ_q1 : ζ ^ (EllipticRootNumber.q F + 1) = 1 := by
      obtain ⟨c, hc⟩ := hdvd_e
      rw [hc, pow_mul, hζ_pow, one_pow]
    have hφ'_u_half : φ' u = ζ ^ ((EllipticRootNumber.q F + 1) / 2) := by
      rw [hφ'_u, hk_u_eq, pow_add, mul_comm s, pow_mul, hζ_q1, one_pow, mul_one]
    have hζ_half_inv : (ζ ^ ((EllipticRootNumber.q F + 1) / 2))⁻¹ =
        ζ ^ ((EllipticRootNumber.q F + 1) / 2) := by
      apply inv_eq_of_mul_eq_one_right
      rw [← sq, ← pow_mul, mul_comm _ 2, ← hq1_mul, hζ_q1]
    have h_lhs : -((φ' u : EllipticRootNumber.Ω F)⁻¹) =
        -((ζ ^ ((EllipticRootNumber.q F + 1) / 2) : (EllipticRootNumber.Ω F)ˣ) :
          EllipticRootNumber.Ω F) := by
      rw [hφ'_u_half, ← Units.val_inv_eq_inv_val, hζ_half_inv]
    rw [h_lhs]
    generalize EllipticRootNumber.q F = q' at hq2 hq3 hdi hdvd_e ⊢
    have h_rhs : ∀ k : ℕ,
        (((-((-1 : ℤˣ) ^ k) : ℤˣ) : ℤ) : EllipticRootNumber.Ω F) =
          -((-1 : EllipticRootNumber.Ω F) ^ k) := by
      intro k
      rw [Units.val_neg, Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one,
        Int.cast_neg, Int.cast_pow, Int.cast_neg, Int.cast_one]
    rw [h_rhs]
    congr 1
    have h_even_case : ∀ (m k : ℕ), ζ ^ (m * 2) = 1 → ζ ^ m ≠ 1 → (q' + 1) / 2 = m * k →
        ((ζ ^ ((q' + 1) / 2) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) =
          (-1 : EllipticRootNumber.Ω F) ^ k := by
      intro m k hm_sq hm_ne hq_eq
      have h_sq : ((ζ ^ m : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) ^ 2 = 1 := by
        rw [← Units.val_pow_eq_pow_val, ← pow_mul, hm_sq, Units.val_one]
      have h_val_neg : ((ζ ^ m : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) = -1 := by
        rcases sq_eq_one_iff.mp h_sq with h1 | h_neg1
        · exfalso
          apply hm_ne
          exact Units.ext h1
        · exact h_neg1
      rw [hq_eq, pow_mul, Units.val_pow_eq_pow_val, h_val_neg]
    have h_odd_case : ζ ^ 3 = 1 → 3 ∣ (q' + 1) →
        ((ζ ^ ((q' + 1) / 2) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) =
          (-1 : EllipticRootNumber.Ω F) ^ ((q' + 1) / 3) := by
      intro h3 hdvd3
      set r := (q' + 1) / 6
      have hq2_eq : (q' + 1) / 2 = 3 * r := by omega
      have hq3_eq : (q' + 1) / 3 = 2 * r := by omega
      rw [hq2_eq, pow_mul, h3, one_pow, Units.val_one, hq3_eq, pow_mul, neg_one_sq, one_pow]
    interval_cases n
    · omega
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdvd_e hζ_pow hζ_ord ⊢
      exact h_even_case 3 ((q' + 1) / 6) hζ_pow (hζ_ord 3 (by decide) (by decide)) (by omega)
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdvd_e hζ_pow hζ_ord ⊢
      exact h_even_case 2 ((q' + 1) / 4) hζ_pow (hζ_ord 2 (by decide) (by decide)) (by omega)
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdvd_e hζ_pow hζ_ord ⊢
      exact h_odd_case hζ_pow hdvd_e
    · omega
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdi ⊢
      omega
    · omega
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdvd_e hζ_pow hζ_ord ⊢
      exact h_odd_case hζ_pow hdvd_e
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdvd_e hζ_pow hζ_ord ⊢
      exact h_even_case 2 ((q' + 1) / 4) hζ_pow (hζ_ord 2 (by decide) (by decide)) (by omega)
    · norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdvd_e hζ_pow hζ_ord ⊢
      exact h_even_case 3 ((q' + 1) / 6) hζ_pow (hζ_ord 3 (by decide) (by decide)) (by omega)
    · omega
  )

theorem localEps_potentially_good_dihedral (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hdi : ¬ ((12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)))
    (rec : EllipticRootNumber.LocalReciprocity F)
    (lc : EllipticRootNumber.LocalConstants F rec) :
    EllipticRootNumber.localEps F E lc =
      (((-((-1 : ℤˣ) ^ ((EllipticRootNumber.q F + 1) / (12 / Nat.gcd n 12))) : ℤˣ) : ℤ) : EllipticRootNumber.Ω F) :=
by
  unfold EllipticRootNumber.localEps EllipticRootNumber.epsWD
  have h_wd : EllipticRootNumber.wdRep F E =
      { V := EllipticRootNumber.VBar F E
        ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
        N := 0 } := if_pos hj
  rw [h_wd]
  have h_frob : EllipticRootNumber.frobDet F ⊥
      { V := EllipticRootNumber.VBar F E
        ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
        N := 0 } = 1 := by
    unfold EllipticRootNumber.frobDet
    dsimp only
    split_ifs with hI hK
    · have h_sub : Subsingleton
          (EllipticRootNumber.inertiaInvariants F ⊥
            { V := EllipticRootNumber.VBar F E
              ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
              N := 0 } ⧸
            (LinearMap.ker (0 : EllipticRootNumber.VBar F E →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E)).comap
              (EllipticRootNumber.inertiaInvariants F ⊥
                { V := EllipticRootNumber.VBar F E
                  ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
                  N := 0 }).subtype) := by
        rw [Submodule.Quotient.subsingleton_iff, LinearMap.ker_zero, Submodule.comap_top]
      exact LinearMap.det_eq_one_of_subsingleton _
    · rfl
    · rfl
  rw [h_frob, mul_one]
  change (lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
      (EllipticRootNumber.stdChar F) : EllipticRootNumber.Ω F) = _
  obtain ⟨hψ_adm, hψ_cond, hψ_triv, hψ_nontriv⟩ := stdChar_admissible_and_spec F
  obtain ⟨H, h, u, d, φ, φ', f, hH_fin, hH_sep, hH_unr, hH_weil, hu_sq, hd_val, hd_nonsq,
    h_coord, h_valL_coord, h_valL_inc, h_trace_coord, hW_φ, hW_E, hf_equiv, hf_bij,
    hφ'_rec, hφ'_bot, h_cond, h_pow, h_ord⟩ :=
    ellAdicRep_dihedral_induced_tame F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hn23 hΔ hc₄ hj hq2 hq3 hdi rec
  haveI : FiniteDimensional F H := hH_fin
  rw [eps_ind_unramified_quadratic_eq_tateEps F hq2 (EllipticRootNumber.stdChar F)
        hψ_adm hψ_cond hψ_triv hψ_nontriv rec lc H h u hH_sep hH_unr hH_weil
        h_coord h_valL_coord h_valL_inc h_trace_coord
        ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
        φ φ' f hW_φ hW_E hf_equiv hf_bij hφ'_rec,
    tateEps_unramified_quadratic_tame_eq_neg_inv F hq2 (EllipticRootNumber.stdChar F)
        hψ_cond hψ_triv hψ_nontriv H h u d hu_sq hd_val hd_nonsq
        h_coord h_valL_coord h_valL_inc h_trace_coord φ' h_cond hφ'_bot,
    tame_quadratic_unit_char_eval_u F n hn0 hn12 hn23 hq2 hq3 hdi H h u d hu_sq hd_val hd_nonsq
        h_coord h_valL_coord φ' h_cond hφ'_bot h_pow h_ord]

theorem localEps_additive_potentially_good (K : Type u) [Field K] [NumberField K]
    (E : WeierstrassCurve K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (n : ℕ)
    (ha₁ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₁ ≤ 1)
    (ha₂ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₂ ≤ 1)
    (ha₃ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₃ ≤ 1)
    (ha₄ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₄ ≤ 1)
    (ha₆ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12)
    (hΔ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.Δ = WithZero.exp (-(n : ℤ)))
    (hc₄ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.c₄ < 1)
    (hj : IsDedekindDomain.HeightOneSpectrum.valuation K v (E.c₄ ^ 3 / E.Δ) ≤ 1)
    (h2 : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    (h3 : (3 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    [ValuativeRel (v.adicCompletion K)] [TopologicalSpace (v.adicCompletion K)]
    [IsNonarchimedeanLocalField (v.adicCompletion K)]
    (rec : EllipticRootNumber.LocalReciprocity (v.adicCompletion K))
    (lc : EllipticRootNumber.LocalConstants (v.adicCompletion K) rec) :
    @ite _ (EllipticRootNumber.localEps (v.adicCompletion K) (E.baseChange (v.adicCompletion K)) lc = -1)
      (Classical.propDecidable _) (-1 : ℤˣ) 1
      = (-1 : ℤˣ) ^ (n * Ideal.absNorm v.asIdeal / 12) :=
by
  
  let val := IsDedekindDomain.HeightOneSpectrum.valuation K v
  have h2_val : val 2 = 1 := by
    have h2' : (2 : K) = algebraMap (NumberField.RingOfIntegers K) K (2 : NumberField.RingOfIntegers K) :=
      (map_ofNat _ 2).symm
    rw [h2', IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff]
    exact h2
  have h3_val : val 3 = 1 := by
    have h3' : (3 : K) = algebraMap (NumberField.RingOfIntegers K) K (3 : NumberField.RingOfIntegers K) :=
      (map_ofNat _ 3).symm
    rw [h3', IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff]
    exact h3
  have h1728_val : val 1728 = 1 := by
    have h1728 : (1728 : K) = 2 ^ 6 * 3 ^ 3 := by norm_num
    rw [h1728, map_mul, map_pow, map_pow, h2_val, h3_val]
    simp
  have h1728Δ : val (1728 * E.Δ) = WithZero.exp (-(n : ℤ)) := by
    rw [map_mul, h1728_val, one_mul, hΔ]
  have hΔ_ne : val E.Δ ≠ 0 := by
    rw [hΔ]
    exact WithZero.exp_ne_zero
  have hc4_le : val (E.c₄ ^ 3) ≤ WithZero.exp (-(n : ℤ)) := by
    rw [map_div₀] at hj
    have := (div_le_one₀ (bot_lt_iff_ne_bot.mpr hΔ_ne)).mp hj
    rwa [hΔ] at this
  have hn23 : 2 ∣ n ∨ 3 ∣ n := by
    rcases lt_or_eq_of_le hc4_le with hlt | heq
    · left
      have hc6_sq : E.c₆ ^ 2 = E.c₄ ^ 3 - 1728 * E.Δ := by
        rw [WeierstrassCurve.c_relation E]
        ring
      have hval_c6 : val (E.c₆ ^ 2) = WithZero.exp (-(n : ℤ)) := by
        rw [hc6_sq, Valuation.map_sub_eq_of_lt_right val (by rwa [h1728Δ]), h1728Δ]
      rw [sq, map_mul] at hval_c6
      rcases hvc6 : val E.c₆ with _ | m
      · rw [hvc6] at hval_c6
        change (0 : WithZero (Multiplicative ℤ)) * 0 = WithZero.exp (-(n : ℤ)) at hval_c6
        rw [mul_zero] at hval_c6
        exact absurd hval_c6.symm WithZero.exp_ne_zero
      · rw [hvc6] at hval_c6
        change WithZero.exp (Multiplicative.toAdd m) * WithZero.exp (Multiplicative.toAdd m) =
          WithZero.exp (-(n : ℤ)) at hval_c6
        rw [← WithZero.exp_add] at hval_c6
        have hm := WithZero.exp_injective hval_c6
        refine ⟨(-Multiplicative.toAdd m).toNat, ?_⟩
        omega
    · right
      rw [pow_three, map_mul, map_mul] at heq
      rcases hvc4 : val E.c₄ with _ | m
      · rw [hvc4] at heq
        change (0 : WithZero (Multiplicative ℤ)) * (0 * 0) = WithZero.exp (-(n : ℤ)) at heq
        rw [mul_zero] at heq
        exact absurd heq.symm WithZero.exp_ne_zero
      · rw [hvc4] at heq
        change WithZero.exp (Multiplicative.toAdd m) *
          (WithZero.exp (Multiplicative.toAdd m) * WithZero.exp (Multiplicative.toAdd m)) =
          WithZero.exp (-(n : ℤ)) at heq
        rw [← WithZero.exp_add, ← WithZero.exp_add] at heq
        have hm := WithZero.exp_injective heq
        refine ⟨(-Multiplicative.toAdd m).toNat, ?_⟩
        omega
  haveI : v.asIdeal.IsMaximal := v.isPrime.isMaximal v.ne_bot
  letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
  haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
    Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  letI : Fintype (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Fintype.ofFinite _
  have hq_card : Ideal.absNorm v.asIdeal = Fintype.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
  obtain ⟨k, hp_prime, hcard_eq⟩ :=
    FiniteField.card (NumberField.RingOfIntegers K ⧸ v.asIdeal)
      (ringChar (NumberField.RingOfIntegers K ⧸ v.asIdeal))
  have h_not_dvd : ∀ p : ℕ, p.Prime → (p : NumberField.RingOfIntegers K) ∉ v.asIdeal →
      ¬ (p ∣ Ideal.absNorm v.asIdeal) := by
    intro p hp hp_mem hdvd
    rw [hq_card, hcard_eq] at hdvd
    have hp_dvd : p ∣ ringChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      hp.dvd_of_dvd_pow hdvd
    have hp_eq : p = ringChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) := by
      rcases (Nat.dvd_prime hp_prime).mp hp_dvd with rfl | h
      · exact absurd rfl hp.ne_one
      · exact h
    have hp_zero : (Ideal.Quotient.mk v.asIdeal) (p : NumberField.RingOfIntegers K) = 0 := by
      rw [map_natCast, hp_eq, ringChar.Nat.cast_ringChar]
    exact hp_mem (Ideal.Quotient.eq_zero_iff_mem.mp hp_zero)
  have hq2 : ¬ (2 ∣ Ideal.absNorm v.asIdeal) := h_not_dvd 2 Nat.prime_two (by simpa using h2)
  have hq3 : ¬ (3 ∣ Ideal.absNorm v.asIdeal) := h_not_dvd 3 Nat.prime_three (by simpa using h3)
  
  have h_pow_iff : ∀ a b : ℕ, (-1 : ℤˣ) ^ a = (-1 : ℤˣ) ^ b ↔ a % 2 = b % 2 := by
    clear! K
    intro a b
    have hmod : ∀ m : ℕ, (-1 : ℤˣ) ^ m = (-1 : ℤˣ) ^ (m % 2) := by
      intro m
      conv_lhs => rw [← Nat.mod_add_div m 2]
      rw [pow_add, pow_mul, sq]
      simp
    rw [hmod a, hmod b]
    have ha : a % 2 = 0 ∨ a % 2 = 1 := Nat.mod_two_eq_zero_or_one a
    have hb : b % 2 = 0 ∨ b % 2 = 1 := Nat.mod_two_eq_zero_or_one b
    rcases ha with ha | ha <;> rcases hb with hb | hb <;> rw [ha, hb] <;> decide
  have h_sign :
      ((12 / Nat.gcd n 12) ∣ (Ideal.absNorm v.asIdeal - 1) →
        (-1 : ℤˣ) ^ ((Ideal.absNorm v.asIdeal - 1) / (12 / Nat.gcd n 12)) =
          (-1 : ℤˣ) ^ (n * Ideal.absNorm v.asIdeal / 12)) ∧
      (¬ ((12 / Nat.gcd n 12) ∣ (Ideal.absNorm v.asIdeal - 1)) →
        -((-1 : ℤˣ) ^ ((Ideal.absNorm v.asIdeal + 1) / (12 / Nat.gcd n 12))) =
          (-1 : ℤˣ) ^ (n * Ideal.absNorm v.asIdeal / 12)) := by
    generalize Ideal.absNorm v.asIdeal = q' at hq2 hq3 ⊢
    clear! K
    have h_neg : ∀ a : ℕ, -((-1 : ℤˣ) ^ a) = (-1 : ℤˣ) ^ (a + 1) := by
      intro a
      rw [pow_succ, mul_neg, mul_one]
    have hq_div12 : q' = 12 * (q' / 12) + q' % 12 := (Nat.div_add_mod q' 12).symm
    have hr : q' % 12 = 1 ∨ q' % 12 = 5 ∨ q' % 12 = 7 ∨ q' % 12 = 11 := by
      have : q' % 12 < 12 := Nat.mod_lt q' (by omega)
      rw [hq_div12] at hq2 hq3
      omega
    refine ⟨?_, ?_⟩
    · intro hab
      rw [h_pow_iff]
      rcases hr with hr | hr | hr | hr <;>
        (rw [hq_div12, hr] at hab ⊢;
         interval_cases n <;>
           (norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hab ⊢; omega))
    · intro hdi
      rw [h_neg, h_pow_iff]
      rcases hr with hr | hr | hr | hr <;>
        (rw [hq_div12, hr] at hdi ⊢;
         interval_cases n <;>
           (norm_num only [Nat.reduceGcd, Nat.reduceDiv] at hdi ⊢; omega))
  
  obtain ⟨hq_eq, ha₁', ha₂', ha₃', ha₄', ha₆', hc₄', hj', hΔ'⟩ :=
    adicCompletion_valuation_and_q_eq K E v n ha₁ ha₂ ha₃ ha₄ ha₆ hΔ hc₄ hj
  have hq2' : ¬ (2 ∣ EllipticRootNumber.q (v.adicCompletion K)) := by rwa [hq_eq]
  have hq3' : ¬ (3 ∣ EllipticRootNumber.q (v.adicCompletion K)) := by rwa [hq_eq]
  have h_ite : ∀ (x : EllipticRootNumber.Ω (v.adicCompletion K)) (u : ℤˣ),
      x = ((u : ℤ) : EllipticRootNumber.Ω (v.adicCompletion K)) →
      @ite _ (x = -1) (Classical.propDecidable _) (-1 : ℤˣ) 1 = u := by
    intro x u hx
    rcases Int.units_eq_one_or u with rfl | rfl
    · rw [hx, Units.val_one, Int.cast_one]
      exact if_neg (by norm_num)
    · rw [hx, Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one]
      exact if_pos rfl
  apply h_ite
  by_cases hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q (v.adicCompletion K) - 1)
  · rw [localEps_potentially_good_abelian (v.adicCompletion K) (E.baseChange (v.adicCompletion K))
        n ha₁' ha₂' ha₃' ha₄' ha₆' hn0 hn12 hn23 hΔ' hc₄' hj' hq2' hq3' hab rec lc,
      hq_eq, ← Units.val_pow_eq_pow_val, h_sign.1 (by rwa [← hq_eq])]
  · rw [localEps_potentially_good_dihedral (v.adicCompletion K) (E.baseChange (v.adicCompletion K))
        n ha₁' ha₂' ha₃' ha₄' ha₆' hn0 hn12 hn23 hΔ' hc₄' hj' hq2' hq3' hab rec lc,
      hq_eq, h_sign.2 (by rwa [← hq_eq])]

theorem theorem_3_4 (K : Type u) [Field K] [NumberField K] :
    (∀ (E : WeierstrassCurve K)
         (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₁ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₂ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₃ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₄ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₆ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.Δ = 1 →
       rootNumber (E.baseChange (v.adicCompletion K)) = 1) ∧
    (∀ (E : WeierstrassCurve K)
         (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
         (n : ℕ),
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₁ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₂ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₃ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₄ ≤ 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₆ ≤ 1 →
       0 < n → n < 12 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.Δ = WithZero.exp (-(n : ℤ)) →
       IsDedekindDomain.HeightOneSpectrum.valuation K v E.c₄ < 1 →
       IsDedekindDomain.HeightOneSpectrum.valuation K v (E.c₄ ^ 3 / E.Δ) ≤ 1 →
       (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
       (3 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
       rootNumber (E.baseChange (v.adicCompletion K))
         = (-1 : ℤˣ) ^ (n * Ideal.absNorm v.asIdeal / 12)) ∧
    (∀ (E : WeierstrassCurve K) (w : NumberField.InfinitePlace K),
       E.Δ ≠ 0 → rootNumber (E.baseChange w.Completion) = -1) :=
by
  classical
  have h_rn : ∀ {F : Type u} [Field F] (E' : WeierstrassCurve F),
      rootNumber E' = rootNumberRaw E' := by
    intro F _ E'
    unfold rootNumber rootNumberCl
    set q := Quotient.mk (MulAction.orbitRel (WeierstrassCurve.VariableChange F)
      (WeierstrassCurve F)) E'
    obtain ⟨C, hC⟩ : q.out ∈ MulAction.orbit (WeierstrassCurve.VariableChange F) E' :=
      Quotient.exact (Quotient.out_eq q)
    rw [← hC]
    exact rootNumberRaw_variableChange F C E'
  have h_not_arch : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      ¬ (Nonempty (v.adicCompletion K ≃+* ℝ) ∨ Nonempty (v.adicCompletion K ≃+* ℂ)) := by
    intro v
    have h_sq : Nonempty (v.adicCompletion K ≃+* ℝ) ∨ Nonempty (v.adicCompletion K ≃+* ℂ) →
        ∀ x : v.adicCompletion K, IsSquare x ∨ IsSquare (-x) := by
      intro h x
      rcases h with h | h
      · obtain ⟨e⟩ := h
        rcases le_total 0 (e x) with h0 | h0
        · left
          refine ⟨e.symm (Real.sqrt (e x)), ?_⟩
          rw [← map_mul, Real.mul_self_sqrt h0, RingEquiv.symm_apply_apply]
        · right
          have h' : 0 ≤ e (-x) := by rw [map_neg]; linarith
          refine ⟨e.symm (Real.sqrt (e (-x))), ?_⟩
          rw [← map_mul, Real.mul_self_sqrt h', RingEquiv.symm_apply_apply]
      · obtain ⟨e⟩ := h
        left
        obtain ⟨w, hw⟩ := IsAlgClosed.exists_pow_nat_eq (e x) (by norm_num : 0 < 2)
        refine ⟨e.symm w, ?_⟩
        rw [← map_mul, ← sq, hw, RingEquiv.symm_apply_apply]
    intro h_arch
    obtain ⟨π₀, hπ₀⟩ := v.valuation_exists_uniformizer K
    let π : v.adicCompletion K := (π₀ : v.adicCompletion K)
    have hπ_val : Valued.v π = WithZero.exp (-1 : ℤ) := by
      rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation', hπ₀]
    have h_not_sq : ∀ x : v.adicCompletion K, Valued.v x = WithZero.exp (-1 : ℤ) → ¬ IsSquare x := by
      rintro x hx ⟨y, rfl⟩
      rw [map_mul] at hx
      rcases hvy : Valued.v y with _ | m
      · rw [hvy] at hx
        change (0 : WithZero (Multiplicative ℤ)) * 0 = WithZero.exp (-1 : ℤ) at hx
        rw [mul_zero] at hx
        exact WithZero.exp_ne_zero hx.symm
      · rw [hvy] at hx
        change WithZero.exp (Multiplicative.toAdd m) * WithZero.exp (Multiplicative.toAdd m) =
            WithZero.exp (-1 : ℤ) at hx
        rw [← WithZero.exp_add] at hx
        have hm : Multiplicative.toAdd m + Multiplicative.toAdd m = -1 :=
          WithZero.exp_injective hx
        omega
    rcases h_sq h_arch π with h1 | h2
    · exact h_not_sq π hπ_val h1
    · apply h_not_sq (-π) _ h2
      rw [Valuation.map_neg, hπ_val]
  refine ⟨?_, ?_, ?_⟩
  · intro E v ha₁ ha₂ ha₃ ha₄ ha₆ hΔ
    rw [h_rn]
    unfold rootNumberRaw
    rw [if_neg (h_not_arch v), dif_pos (adicCompletion_localFieldStructure K v)]
    let s := Classical.choice (adicCompletion_localFieldStructure K v)
    letI : ValuativeRel (v.adicCompletion K) := s.rel
    letI : TopologicalSpace (v.adicCompletion K) := s.top
    haveI : IsNonarchimedeanLocalField (v.adicCompletion K) := s.isLocalField
    have h_hlc : EllipticRootNumber.HasLocalConstants (v.adicCompletion K) :=
      ⟨Classical.choice (local_reciprocity (v.adicCompletion K)),
        langlands_deligne (v.adicCompletion K) _⟩
    change EllipticRootNumber.rootNumberNonarch (v.adicCompletion K) (E.baseChange (v.adicCompletion K)) = 1
    rw [EllipticRootNumber.rootNumberNonarch_of_hasLocalConstants _ _ h_hlc]
    rw [localEps_good_reduction K E v ha₁ ha₂ ha₃ ha₄ ha₆ hΔ]
    exact if_neg (by norm_num)
  · intro E v n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hΔ hc₄ hj h2 h3
    rw [h_rn]
    unfold rootNumberRaw
    rw [if_neg (h_not_arch v), dif_pos (adicCompletion_localFieldStructure K v)]
    let s := Classical.choice (adicCompletion_localFieldStructure K v)
    letI : ValuativeRel (v.adicCompletion K) := s.rel
    letI : TopologicalSpace (v.adicCompletion K) := s.top
    haveI : IsNonarchimedeanLocalField (v.adicCompletion K) := s.isLocalField
    have h_hlc : EllipticRootNumber.HasLocalConstants (v.adicCompletion K) :=
      ⟨Classical.choice (local_reciprocity (v.adicCompletion K)),
        langlands_deligne (v.adicCompletion K) _⟩
    change EllipticRootNumber.rootNumberNonarch (v.adicCompletion K) (E.baseChange (v.adicCompletion K)) = _
    rw [EllipticRootNumber.rootNumberNonarch_of_hasLocalConstants _ _ h_hlc]
    exact localEps_additive_potentially_good K E v n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hΔ hc₄ hj h2 h3 _ _
  · intro E w _hΔ
    unfold rootNumber rootNumberCl
    apply rootNumberRaw_of_archimedean
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · exact Or.inl ⟨NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw⟩
    · exact Or.inr ⟨NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hw⟩
