import Mathlib
import Hilbert10Defs
import local_reciprocity
import langlands_deligne
set_option maxHeartbeats 4000000

/-! ### Statement (originally `theorem_3_4.lean`) -/

/--
**Theorem 3.4 (Root number facts).** Let `K` be a number field.
(i) If `E` has good reduction at a finite place `v`, then `w(E/K_v) = +1`.
(ii) If `E` has additive, potentially good reduction at `v` with residue characteristic
`≥ 5`, then `w(E/K_v) = (-1)^⌊v(Δ) |k| / 12⌋`.
(iii) At an archimedean place `w`, `w(E/K_w) = -1`.
-/

theorem isAdmissibleChar_stdChar (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    EllipticRootNumber.IsAdmissibleChar F ⊥ (EllipticRootNumber.stdChar F) :=
by
  let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
      z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
    rintro _ hz m rfl
    exact WithZero.unzero_coe hz
  have h_addVal_of_iso : ∀ (y : F) (m : ℤ),
      iso (ValuativeRel.valuation F y) = WithZero.exp m →
      y ≠ 0 ∧ EllipticRootNumber.addVal F y = -m := by
    intro y m hy_iso
    have h_exp_ne : WithZero.exp m ≠ 0 := WithZero.exp_ne_zero
    have h_iso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := by rw [hy_iso]; exact h_exp_ne
    have hv_ne : ValuativeRel.valuation F y ≠ 0 := fun h0 => h_iso_ne (by rw [h0, map_zero])
    have hy : y ≠ 0 := (Valuation.ne_zero_iff _).mp hv_ne
    refine ⟨hy, ?_⟩
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy, h_unzero _ _ m hy_iso]
    rfl
  obtain ⟨π, hπ_val⟩ :=
    ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ_val, iso.apply_symm_apply]
  obtain ⟨hπ0, hπ_addVal⟩ := h_addVal_of_iso π (-1) hπ_iso
  have hπ1 : ValuativeRel.valuation F π < 1 := by
    rw [← map_lt_map_iff iso, hπ_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have h_exp_inv : (WithZero.exp (-1 : ℤ))⁻¹ = WithZero.exp (1 : ℤ) := by
    apply inv_eq_of_mul_eq_one_right
    rw [← WithZero.exp_add]
    rfl
  have hπ_inv_iso : iso (ValuativeRel.valuation F π⁻¹) = WithZero.exp (1 : ℤ) := by
    rw [map_inv₀, map_inv₀, hπ_iso, h_exp_inv]
  have hπ_inv_addVal : EllipticRootNumber.addVal F π⁻¹ = -1 :=
    (h_addVal_of_iso π⁻¹ 1 hπ_inv_iso).2
  have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have h_norm : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [h_norm]
  have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · intro h0
      apply hπ0
      have := congrArg e_bot h0
      simpa using this
    · rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
      omega
    · rintro k ⟨hk, _⟩
      exact hk
  have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
  have h_addVal_nonneg : ∀ y : F,
      0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl, Valuation.map_zero]
      exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
    · unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set u := WithZero.unzero hiso_ne
      have hu_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_le_map_iff iso, hu_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
      omega
  letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℕ :=
    DivisibleBy.mk
      (fun a n =>
        if hn : n = 0 then 0
        else
          let h_ex := IsAlgClosed.exists_pow_nat_eq
            ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
            (Nat.pos_of_ne_zero hn)
          let z := Classical.choose h_ex
          have hz_pow : z ^ n =
              ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) :=
            Classical.choose_spec h_ex
          have hz_ne : z ≠ 0 := by
            intro hz0
            rw [hz0, zero_pow hn] at hz_pow
            exact Units.ne_zero (Additive.toMul a) hz_pow.symm
          Additive.ofMul (Units.mk0 z hz_ne))
      (fun a => dif_pos rfl)
      (fun {n} a hn => by
        dsimp only
        rw [dif_neg hn, ← ofMul_pow, ← ofMul_toMul a]
        congr 1
        apply Units.ext
        simp only [Units.val_pow_eq_pow_val, Units.val_mk0]
        exact Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq
          ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
          (Nat.pos_of_ne_zero hn)))
  letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℤ :=
    AddGroup.divisibleByIntOfDivisibleByNat (Additive (EllipticRootNumber.Ω F)ˣ)
  have hBaer : Module.Baer ℤ (Additive (EllipticRootNumber.Ω F)ˣ) :=
    Module.Baer.of_divisible (Additive (EllipticRootNumber.Ω F)ˣ)
  let O_F := (ValuativeRel.valuation F).integer
  let k_F := IsLocalRing.ResidueField ↥O_F
  have hp : (EllipticRootNumber.p F).Prime :=
    CharP.char_is_prime k_F (EllipticRootNumber.p F)
  haveI : Fact (EllipticRootNumber.p F).Prime := ⟨hp⟩
  haveI : Fact (ringChar k_F).Prime := ⟨hp⟩
  obtain ⟨ζ, hζ_root⟩ := IsAlgClosed.exists_root
    (Polynomial.cyclotomic (EllipticRootNumber.p F) (EllipticRootNumber.Ω F))
    (ne_of_gt (Polynomial.degree_cyclotomic_pos
      (EllipticRootNumber.p F) (EllipticRootNumber.Ω F) hp.pos))
  have hζ : IsPrimitiveRoot ζ (EllipticRootNumber.p F) :=
    (Polynomial.isRoot_cyclotomic_iff_charZero hp.pos).mp hζ_root
  let ζ_u : (EllipticRootNumber.Ω F)ˣ := Units.mk0 ζ (hζ.ne_zero hp.ne_zero)
  let q₀ : Additive (EllipticRootNumber.Ω F)ˣ := Additive.ofMul ζ_u
  have hζ_ne_one : ζ ≠ 1 := hζ.ne_one hp.one_lt
  have hq₀_pow : (EllipticRootNumber.p F : ℤ) • q₀ = 0 := by
    rw [natCast_zsmul, ← ofMul_pow]
    change Additive.ofMul (ζ_u ^ EllipticRootNumber.p F) = Additive.ofMul 1
    congr 1
    ext
    simp [ζ_u, hζ.pow_eq_one]
  let g₀ : ZMod (EllipticRootNumber.p F) →+ Additive (EllipticRootNumber.Ω F)ˣ :=
    ZMod.lift (EllipticRootNumber.p F) ⟨zmultiplesHom _ q₀, by
      rw [zmultiplesHom_apply]
      exact hq₀_pow⟩
  have hg₀_one : g₀ 1 = q₀ := by
    rw [← Int.cast_one, ZMod.lift_coe, zmultiplesHom_apply, one_zsmul]
  let f₀ : ZMod (EllipticRootNumber.p F) →+ k_F :=
    (ZMod.castHom dvd_rfl k_F).toAddMonoidHom
  have hf₀_inj : Function.Injective f₀ :=
    RingHom.injective (ZMod.castHom dvd_rfl k_F)
  obtain ⟨ψ_res, hψ_res⟩ :=
    Module.Baer.extension_property_addMonoidHom hBaer f₀ hf₀_inj g₀
  have hψ_res_one : ψ_res 1 = q₀ := by
    have h1 : f₀ 1 = 1 := map_one (ZMod.castHom dvd_rfl k_F)
    rw [← h1, ← AddMonoidHom.comp_apply, hψ_res, hg₀_one]
  let M₁ : AddSubgroup F :=
    (ValuativeRel.valuation F).valuationSubring.toSubring.toAddSubgroup.comap
      (AddMonoidHom.mulLeft π)
  let r₁ : M₁ →+ k_F :=
    { toFun := fun m => IsLocalRing.residue ↥O_F ⟨π * m.1, m.2⟩
      map_zero' := by
        have h0 : (⟨π * (0 : M₁).1, (0 : M₁).2⟩ : ↥O_F) = 0 := by
          ext
          exact mul_zero π
        change IsLocalRing.residue ↥O_F ⟨π * (0 : M₁).1, (0 : M₁).2⟩ = 0
        rw [h0, map_zero]
      map_add' := fun a b => by
        have h_add : (⟨π * (a + b).1, (a + b).2⟩ : ↥O_F) =
            ⟨π * a.1, a.2⟩ + ⟨π * b.1, b.2⟩ := by
          ext
          exact mul_add π a.1 b.1
        change IsLocalRing.residue ↥O_F ⟨π * (a + b).1, (a + b).2⟩ = _
        rw [h_add, map_add] }
  obtain ⟨ψ_tilde, hψ_tilde⟩ :=
    Module.Baer.extension_property_addMonoidHom hBaer M₁.subtype M₁.subtype_injective (ψ_res.comp r₁)
  let ψ_F : AddChar F (EllipticRootNumber.Ω F) :=
    { toFun := fun y =>
        ((Additive.toMul (ψ_tilde y) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
      map_zero_eq_one' := by
        rw [map_zero, toMul_zero, Units.val_one]
      map_add_eq_mul' := fun a b => by
        rw [map_add, toMul_add, Units.val_mul] }
  have hψ_F_triv : ∀ y : F, ValuativeRel.valuation F y ≤ 1 → ψ_F y = 1 := by
    intro y hy
    have hπy_lt : ValuativeRel.valuation F (π * y) < 1 := by
      rw [map_mul]
      calc ValuativeRel.valuation F π * ValuativeRel.valuation F y
          ≤ ValuativeRel.valuation F π * 1 := mul_le_mul_of_nonneg_left hy zero_le'
        _ = ValuativeRel.valuation F π := mul_one _
        _ < 1 := hπ1
    have hy_M₁ : y ∈ M₁ := le_of_lt hπy_lt
    have hr₁_zero : r₁ ⟨y, hy_M₁⟩ = 0 := by
      change IsLocalRing.residue ↥O_F ⟨π * y, hy_M₁⟩ = 0
      rw [IsLocalRing.residue_eq_zero_iff]
      exact (Valuation.mem_maximalIdeal_iff _ _).mpr hπy_lt
    have h_tilde : ψ_tilde y = 0 := by
      change ψ_tilde (M₁.subtype ⟨y, hy_M₁⟩) = 0
      rw [← AddMonoidHom.comp_apply, hψ_tilde, AddMonoidHom.comp_apply, hr₁_zero, map_zero]
    change ((Additive.toMul (ψ_tilde y) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) = 1
    rw [h_tilde, toMul_zero, Units.val_one]
  have hψ_F_inv : ψ_F π⁻¹ ≠ 1 := by
    have hπ_inv_M₁ : π⁻¹ ∈ M₁ := by
      change ValuativeRel.valuation F (π * π⁻¹) ≤ 1
      rw [mul_inv_cancel₀ hπ0, Valuation.map_one]
    have hr₁_one : r₁ ⟨π⁻¹, hπ_inv_M₁⟩ = 1 := by
      have h_one : (⟨π * π⁻¹, hπ_inv_M₁⟩ : ↥O_F) = 1 := by
        ext
        exact mul_inv_cancel₀ hπ0
      change IsLocalRing.residue ↥O_F ⟨π * π⁻¹, hπ_inv_M₁⟩ = 1
      rw [h_one, map_one]
    have h_tilde : ψ_tilde π⁻¹ = q₀ := by
      change ψ_tilde (M₁.subtype ⟨π⁻¹, hπ_inv_M₁⟩) = q₀
      rw [← AddMonoidHom.comp_apply, hψ_tilde, AddMonoidHom.comp_apply, hr₁_one, hψ_res_one]
    change ((Additive.toMul (ψ_tilde π⁻¹) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) ≠ 1
    rw [h_tilde]
    exact hζ_ne_one
  let ψ_bot : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F) :=
    ψ_F.compAddMonoidHom e_bot.toAddMonoidHom
  have h_exists_std : ∃ ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F),
      (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1 := by
    refine ⟨ψ_bot, ?_, e_bot.symm π⁻¹, ?_, ?_⟩
    · intro x hx
      rw [h_valL, h_addVal_nonneg] at hx
      rw [AddChar.compAddMonoidHom_apply]
      exact hψ_F_triv (e_bot x) hx
    · rw [h_valL, e_bot.apply_symm_apply, hπ_inv_addVal]
    · rw [AddChar.compAddMonoidHom_apply]
      change ψ_F (e_bot (e_bot.symm π⁻¹)) ≠ 1
      rw [e_bot.apply_symm_apply]
      exact hψ_F_inv
  obtain ⟨hψ₀_triv, hψ₀_nontriv⟩ := Classical.epsilon_spec h_exists_std
  change (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → EllipticRootNumber.stdChar F x = 1) at hψ₀_triv
  change (∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ EllipticRootNumber.stdChar F x ≠ 1) at hψ₀_nontriv
  obtain ⟨x₀, _, hx₀_ne⟩ := hψ₀_nontriv
  refine ⟨?_, 0, hψ₀_triv⟩
  intro h_eq
  apply hx₀_ne
  rw [h_eq, AddChar.one_apply]

theorem torsion_finite_of_generic_nsmul_ne_zero (K : Type u) [Field K] [DecidableEq K]
    (W : WeierstrassCurve.Affine K) [DecidableEq W.FunctionField]
    (h_gen : ((W.map (algebraMap K W.FunctionField)).toAffine).Nonsingular
      (algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)))
      (algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)))
    (m : ℕ)
    (hm : m • (WeierstrassCurve.Affine.Point.some h_gen :
      ((W.map (algebraMap K W.FunctionField)).toAffine).Point) ≠ 0) :
    Finite {P : W.Point | m • P = 0} :=
by
  have h_s1 : ∀ (S : Set W.Point) (P : Polynomial K), P ≠ 0 →
      (∀ {x y : K} (h : W.Nonsingular x y),
        WeierstrassCurve.Affine.Point.some h ∈ S → P.eval x = 0) →
      Finite S := by
    intro S P hP hS
    classical
    let Q : K → Polynomial K := fun x =>
      Polynomial.X ^ 2 + Polynomial.C (W.a₁ * x + W.a₃) * Polynomial.X -
        Polynomial.C (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)
    have hQ_ne : ∀ x : K, Q x ≠ 0 := by
      intro x h0
      have hc : (Q x).coeff 2 = 1 := by
        dsimp only [Q]
        rw [Polynomial.coeff_sub, Polynomial.coeff_add, Polynomial.coeff_X_pow, if_pos rfl,
          Polynomial.coeff_C_mul, Polynomial.coeff_X, if_neg (by decide : 1 ≠ 2), mul_zero,
          add_zero, Polynomial.coeff_C, if_neg (by decide : 2 ≠ 0), sub_zero]
      rw [h0, Polynomial.coeff_zero] at hc
      exact zero_ne_one hc
    have hQ_root : ∀ {x y : K}, W.Nonsingular x y → y ∈ (Q x).roots.toFinset := by
      intro x y h
      rw [Multiset.mem_toFinset, Polynomial.mem_roots (hQ_ne x), Polynomial.IsRoot.def]
      have heq := (WeierstrassCurve.Affine.equation_iff' x y).mp h.1
      dsimp only [Q]
      simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_pow,
        Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
      linear_combination heq
    have hP_root : ∀ {x y : K} (h : W.Nonsingular x y),
        WeierstrassCurve.Affine.Point.some h ∈ S → x ∈ P.roots.toFinset := by
      intro x y h hs
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP, Polynomial.IsRoot.def]
      exact hS h hs
    let f : S → Option (Σ x : P.roots.toFinset, (Q x.1).roots.toFinset) := fun q =>
      match hq : q.1 with
      | 0 => none
      | @WeierstrassCurve.Affine.Point.some _ _ _ x y h =>
        some ⟨⟨x, hP_root h (hq ▸ q.2)⟩, ⟨y, hQ_root h⟩⟩
    have hf_inj : Function.Injective f := by
      intro q₁ q₂ hfeq
      rcases q₁ with ⟨p₁, hp₁⟩
      rcases q₂ with ⟨p₂, hp₂⟩
      cases p₁ with
      | zero =>
        cases p₂ with
        | zero => rfl
        | some h₂ =>
          dsimp [f] at hfeq
          nomatch hfeq
      | some h₁ =>
        cases p₂ with
        | zero =>
          dsimp [f] at hfeq
          nomatch hfeq
        | some h₂ =>
          dsimp [f] at hfeq
          injection hfeq with hsig
          have hx : _ = _ := congrArg (fun s => s.1.1) hsig
          dsimp at hx
          subst hx
          have hy : _ = _ := eq_of_heq (Sigma.ext_iff.mp hsig).2
          have hy' : _ = _ := congrArg Subtype.val hy
          dsimp at hy'
          subst hy'
          rfl
    exact Finite.of_injective f hf_inj
  have h_s2 : ∀ (D : W.CoordinateRing), D ≠ 0 →
      Algebra.norm (Polynomial K) D ≠ 0 ∧
        ∀ (x : K) (ϕ : W.CoordinateRing →+* K),
          (∀ p : Polynomial K, ϕ (AdjoinRoot.of W.polynomial p) = p.eval x) →
          ϕ D = 0 → (Algebra.norm (Polynomial K) D).eval x = 0 := by
    intro D hD
    obtain ⟨p, q, hpq⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq D
    refine ⟨?_, ?_⟩
    · intro hN
      have hdeg := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W) p q
      rw [hpq, hN, Polynomial.degree_zero] at hdeg
      have hp0 : p = 0 := by
        by_contra hp
        have h1 : 2 • p.degree ≤ (⊥ : WithBot ℕ) :=
          le_trans (le_max_left _ _) (le_of_eq hdeg.symm)
        rw [Polynomial.degree_eq_natDegree hp] at h1
        exact WithBot.coe_ne_bot (le_bot_iff.mp h1)
      have hq0 : q = 0 := by
        by_contra hq
        have h2 : 2 • q.degree + 3 ≤ (⊥ : WithBot ℕ) :=
          le_trans (le_max_right _ _) (le_of_eq hdeg.symm)
        rw [Polynomial.degree_eq_natDegree hq] at h2
        exact WithBot.coe_ne_bot (le_bot_iff.mp h2)
      apply hD
      rw [← hpq, hp0, hq0, zero_smul, zero_smul, add_zero]
    · intro x ϕ hϕ hϕD
      have hcoe := WeierstrassCurve.Affine.CoordinateRing.coe_norm_smul_basis (W' := W) p q
      rw [hpq] at hcoe
      have hmk : WeierstrassCurve.Affine.CoordinateRing.mk W
          (Polynomial.C p + Polynomial.C q * Polynomial.X) = D := by
        rw [← hpq, map_add, map_mul, WeierstrassCurve.Affine.CoordinateRing.smul,
          WeierstrassCurve.Affine.CoordinateRing.smul, mul_one]
      rw [map_mul, hmk] at hcoe
      have h_ap := congrArg ϕ hcoe
      rw [hϕ, map_mul, hϕD, zero_mul] at h_ap
      exact h_ap
  have h_s3 : ∀ {X₁ Y₁ X₂ Y₂ : W.FunctionField},
      X₁ = X₂ →
      Y₁ = ((W.map (algebraMap K W.FunctionField)).toAffine).negY X₂ Y₂ →
      ∀ (A₁ B₁ D₁ A₂ B₂ D₂ : W.CoordinateRing), D₁ ≠ 0 → D₂ ≠ 0 →
      X₁ = algebraMap W.CoordinateRing W.FunctionField A₁ /
        algebraMap W.CoordinateRing W.FunctionField D₁ →
      Y₁ = algebraMap W.CoordinateRing W.FunctionField B₁ /
        algebraMap W.CoordinateRing W.FunctionField D₁ →
      X₂ = algebraMap W.CoordinateRing W.FunctionField A₂ /
        algebraMap W.CoordinateRing W.FunctionField D₂ →
      Y₂ = algebraMap W.CoordinateRing W.FunctionField B₂ /
        algebraMap W.CoordinateRing W.FunctionField D₂ →
      ∀ (ϕ : W.CoordinateRing →+* K),
      (∀ c : K, ϕ (algebraMap K W.CoordinateRing c) = c) →
      ϕ D₁ ≠ 0 → ϕ D₂ ≠ 0 →
      ∀ (h₁ : W.Nonsingular (ϕ A₁ / ϕ D₁) (ϕ B₁ / ϕ D₁))
        (h₂ : W.Nonsingular (ϕ A₂ / ϕ D₂) (ϕ B₂ / ϕ D₂)),
        WeierstrassCurve.Affine.Point.some h₁ + WeierstrassCurve.Affine.Point.some h₂ = 0 := by
    intro X₁ Y₁ X₂ Y₂ hX hY A₁ B₁ D₁ A₂ B₂ D₂ hD₁ hD₂ hX₁ hY₁ hX₂ hY₂ ϕ hϕ hϕD₁ hϕD₂ h₁ h₂
    set ι := algebraMap W.CoordinateRing W.FunctionField
    have hι_inj : Function.Injective ι :=
