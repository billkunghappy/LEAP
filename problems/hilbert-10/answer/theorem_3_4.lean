            _ = 1 := h_inv_N
        · change z.re * -(inv_N * z.im) + z.im * (inv_N * z.re) + 0 * z.im * -(inv_N * z.im) = 0
          ring
      · refine QuadraticAlgebra.ext ?_ ?_
        · change (inv_N * z.re) * z.re + d_A * -(inv_N * z.im) * z.im = 1
          calc (inv_N * z.re) * z.re + d_A * -(inv_N * z.im) * z.im
              = inv_N * (z.re ^ 2 - d_A * z.im ^ 2) := by ring
            _ = 1 := h_inv_N
        · change (inv_N * z.re) * z.im + -(inv_N * z.im) * z.re + 0 * -(inv_N * z.im) * z.im = 0
          ring
    have h_ker_red : ∀ w : R_Aˣ, red_u w = 1 → Ψ_u w ∈ EllipticRootNumber.unitGroup F H 1 := by
      intro w hw
      have hw_val : red (w : R_A) = 1 := congrArg Units.val hw
      have h_re_res : IsLocalRing.residue ↥A ((w : R_A).re - 1) = 0 := by
        rw [map_sub, map_one]
        have : IsLocalRing.residue ↥A (w : R_A).re = (1 : E₂).re :=
          congrArg QuadraticAlgebra.re hw_val
        rw [this]
        exact sub_self 1
