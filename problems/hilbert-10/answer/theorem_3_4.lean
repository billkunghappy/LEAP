      map_mul' := fun x y => (FractionalIdeal.spanSingleton_mul_spanSingleton x y).symm }
  obtain ⟨D, hD_val⟩ : ∃ D : (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ →*
      (FractionalIdeal
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ,
      ∀ u, (D u : FractionalIdeal
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
