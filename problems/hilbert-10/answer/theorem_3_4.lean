    Module.Flat.lTensor_preserves_injective_linearMap fQ hfQ_inj
  have hfQ_add : fQ + LinearMap.id = LinearMap.baseChange ℚ_[ℓ] (EllipticRootNumber.tateRep F E σ) := by
    have h_id : (LinearMap.id : EllipticRootNumber.VQ F E →ₗ[ℚ_[ℓ]] EllipticRootNumber.VQ F E) =
        LinearMap.baseChange ℚ_[ℓ] (LinearMap.id : T →ₗ[ℤ_[ℓ]] T) :=
      (LinearMap.baseChange_id (R := ℤ_[ℓ]) (A := ℚ_[ℓ]) (M := T)).symm
    have h_add : LinearMap.baseChange ℚ_[ℓ] f₀ + LinearMap.baseChange ℚ_[ℓ] (LinearMap.id : T →ₗ[ℤ_[ℓ]] T) =
        LinearMap.baseChange ℚ_[ℓ] (f₀ + LinearMap.id) :=
      ((LinearMap.baseChangeHom ℤ_[ℓ] ℚ_[ℓ] T T).map_add f₀ LinearMap.id).symm
    have h_cancel : f₀ + LinearMap.id = EllipticRootNumber.tateRep F E σ :=
      sub_add_cancel (EllipticRootNumber.tateRep F E σ) LinearMap.id
    exact (congrArg (fQ + ·) h_id).trans (h_add.trans (congrArg (LinearMap.baseChange ℚ_[ℓ]) h_cancel))
  have hfBar_add : fBar + LinearMap.id = EllipticRootNumber.ellAdicRep F E σ := by
    have h_id : (LinearMap.id : EllipticRootNumber.VBar F E →ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E) =
        LinearMap.baseChange (EllipticRootNumber.Ω F)
          (LinearMap.id : EllipticRootNumber.VQ F E →ₗ[ℚ_[ℓ]] EllipticRootNumber.VQ F E) :=
      (LinearMap.baseChange_id (R := ℚ_[ℓ]) (A := EllipticRootNumber.Ω F) (M := EllipticRootNumber.VQ F E)).symm
    have h_add : LinearMap.baseChange (EllipticRootNumber.Ω F) fQ +
          LinearMap.baseChange (EllipticRootNumber.Ω F)
            (LinearMap.id : EllipticRootNumber.VQ F E →ₗ[ℚ_[ℓ]] EllipticRootNumber.VQ F E) =
        LinearMap.baseChange (EllipticRootNumber.Ω F) (fQ + LinearMap.id) :=
      ((LinearMap.baseChangeHom ℚ_[ℓ] (EllipticRootNumber.Ω F)
        (EllipticRootNumber.VQ F E) (EllipticRootNumber.VQ F E)).map_add fQ LinearMap.id).symm
    exact (congrArg (fBar + ·) h_id).trans
      (h_add.trans (congrArg (LinearMap.baseChange (EllipticRootNumber.Ω F)) hfQ_add))
  have hfBar_v : fBar v = 0 := by
    have h1 : fBar v + v = v :=
      ((LinearMap.add_apply fBar LinearMap.id v).symm.trans (LinearMap.congr_fun hfBar_add v)).trans h_eq
    calc fBar v = (fBar v + v) - v := (add_sub_cancel_right (fBar v) v).symm
      _ = v - v := by rw [h1]
      _ = 0 := sub_self v
  exact hv (hfBar_inj (hfBar_v.trans (map_zero fBar).symm))

theorem ellAdicRep_kummer_inertia_and_det_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1))
    (π : F) (ϖ : AlgebraicClosure F)
    (τ₀ : EllipticRootNumber.relWeil F ⊥) (ζ : F)
    (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hϖ_ne : ϖ ≠ 0) (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hτ₀_in : (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (hζ_ord : ∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 → ζ ^ d ≠ 1)
    (hτ₀_ϖ : (τ₀ : EllipticRootNumber.AbsGal F) ϖ = algebraMap F (AlgebraicClosure F) ζ * ϖ) :
    Module.finrank (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) = 2 ∧
    (∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (w : EllipticRootNumber.AbsGal F) ϖ = ϖ →
      ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w = 1) ∧
    (∀ w : EllipticRootNumber.relWeil F ⊥,
      LinearMap.det (((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w) =
        (EllipticRootNumber.relNorm F ⊥ w : EllipticRootNumber.Ω F)) ∧
    (∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w) ^
        (12 / Nat.gcd n 12) = 1) ∧
    (∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 →
      ∀ v : EllipticRootNumber.VBar F E, v ≠ 0 →
        ((((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) τ₀) ^ d) v ≠ v) :=
by
  have hΔ_ne : E.Δ ≠ 0 := by
    intro h0
    rw [EllipticRootNumber.addVal, dif_pos h0] at hΔ
    omega
  set e : ℕ := 12 / Nat.gcd n 12
  have he_pos : 0 < e := by
    change 0 < 12 / Nat.gcd n 12
    interval_cases n <;> decide
  haveI : NeZero e := ⟨he_pos.ne'⟩
  have hζ_prim : IsPrimitiveRoot ζ e := by
    rw [IsPrimitiveRoot.iff_orderOf]
    have hdvd : orderOf ζ ∣ e := orderOf_dvd_of_pow_eq_one hζ_pow
    have hle : orderOf ζ ≤ e := Nat.le_of_dvd he_pos hdvd
    rcases lt_or_eq_of_le hle with hlt | heq
    · exact absurd (pow_orderOf_eq_one ζ) (hζ_ord (orderOf ζ) hdvd hlt)
    · exact heq
  have hζK_prim : IsPrimitiveRoot (algebraMap F (AlgebraicClosure F) ζ) e :=
    hζ_prim.map_of_injective (algebraMap F (AlgebraicClosure F)).injective
  have h_absGal_pow : ∀ σ : EllipticRootNumber.AbsGal F, (σ ^ e) ϖ = ϖ := by
    intro σ
    have h_div_pow : (σ ϖ / ϖ) ^ e = 1 := by
      rw [div_pow, ← map_pow, hϖ_pow, AlgEquiv.commutes, ← hϖ_pow,
        div_self (pow_ne_zero e hϖ_ne)]
    obtain ⟨j, _hj_lt, hj_eq⟩ := hζK_prim.eq_pow_of_pow_eq_one h_div_pow
    have hσ_ϖ : σ ϖ = algebraMap F (AlgebraicClosure F) (ζ ^ j) * ϖ := by
      rw [map_pow, hj_eq, div_mul_cancel₀ _ hϖ_ne]
    have h_iter : ∀ k : ℕ, (σ ^ k) ϖ = algebraMap F (AlgebraicClosure F) ((ζ ^ j) ^ k) * ϖ := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ', AlgEquiv.mul_apply, ih, map_mul, AlgEquiv.commutes, hσ_ϖ,
          ← mul_assoc, ← map_mul, ← pow_succ]
    rw [h_iter e, ← pow_mul, mul_comm j e, pow_mul, hζ_pow, one_pow, map_one, one_mul]
  have h_triv : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (w : EllipticRootNumber.AbsGal F) ϖ = ϖ →
      ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w = 1 :=
    fun w hw_in hw_fix =>
      ellAdicRep_inertia_eq_one_of_kummer_fix F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hΔ hj
        hq2 hq3 π ϖ hπ_ne hπ_val hϖ_ne hϖ_pow w hw_in hw_fix
  refine ⟨vBar_finrank_eq_two_of_delta_ne_zero F E hΔ_ne, h_triv, ?_, ?_, ?_⟩
  · intro w
    exact ellAdicRep_kummer_det_eq_relNorm F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hn23
      hΔ hc₄ hj hq2 hq3 hab π ϖ τ₀ ζ hπ_ne hπ_val hϖ_ne hϖ_pow hτ₀_in hζ_pow hζ_ord hτ₀_ϖ w
  · intro w hw_in
    rw [← map_pow]
    apply h_triv (w ^ e)
    · rw [Subgroup.coe_pow]
      exact Subgroup.pow_mem (EllipticRootNumber.inertia F) hw_in e
    · rw [Subgroup.coe_pow]
      exact h_absGal_pow (w : EllipticRootNumber.AbsGal F)
  · intro d hd_dvd hd_lt v hv
    exact ellAdicRep_kummer_generator_pow_ne_self F E n ha₁ ha₂ ha₃ ha₄ ha₆ hn0 hn12 hn23
      hΔ hc₄ hj hq2 hq3 hab π ϖ τ₀ ζ hπ_ne hπ_val hϖ_ne hϖ_pow hτ₀_in hζ_pow hζ_ord hτ₀_ϖ
      d hd_dvd hd_lt v hv

theorem commuting_two_dim_rep_short_exact_of_abelian_inertia (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F))
    (hM_ab : EllipticRootNumber.IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
    (e : ℕ) {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hV_dim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (hρ_triv : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup → ρ w = 1)
    (hρ_det : ∀ w : EllipticRootNumber.relWeil F ⊥,
      LinearMap.det (ρ w) = (EllipticRootNumber.relNorm F ⊥ w : EllipticRootNumber.Ω F))
    (hρ_pow : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → (ρ w) ^ e = 1)
    (τ₀ : EllipticRootNumber.relWeil F ⊥)
    (hτ₀_in : (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F)
    (hτ₀_ord : ∀ d : ℕ, d ∣ e → d < e → ∀ v : V, v ≠ 0 → (ρ τ₀ ^ d) v ≠ v) :
    ∃ (χ₁ χ₂ : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
      (f : ULift.{u} (EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F] V)
      (g : V →ₗ[EllipticRootNumber.Ω F] ULift.{u} (EllipticRootNumber.Ω F)),
      (∀ w, f ∘ₗ EllipticRootNumber.charRep F ⊥ χ₁ w = ρ w ∘ₗ f) ∧
      (∀ w, g ∘ₗ ρ w = EllipticRootNumber.charRep F ⊥ χ₂ w ∘ₗ g) ∧
      Function.Injective f ∧
      Function.Surjective g ∧
      LinearMap.range f = LinearMap.ker g ∧
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
        (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
        χ₁ w = 1 ∧ χ₂ w = 1) ∧
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        χ₁ w * χ₂ w = EllipticRootNumber.relNorm F ⊥ w) ∧
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
        χ₁ w ^ e = 1) ∧
      (∀ d : ℕ, d ∣ e → d < e →
        ∃ w : EllipticRootNumber.relWeil F ⊥,
          (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧ χ₁ w ^ d ≠ 1) :=
by
  have h_comm : ∀ (w₁ w₂ : EllipticRootNumber.relWeil F ⊥) (v : V),
      ρ w₁ (ρ w₂ v) = ρ w₂ (ρ w₁ v) := by
    intro w₁ w₂ v
    have h_root_comm : ∀ (σ₁ σ₂ : EllipticRootNumber.AbsGal F) (n : ℕ) (hn : 0 < n)
        (ζ : AlgebraicClosure F), ζ ^ n = 1 → σ₁ (σ₂ ζ) = σ₂ (σ₁ ζ) := by
      intro σ₁ σ₂ n hn ζ hζ
      haveI : NeZero n := ⟨hn.ne'⟩
      obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := rootsOfUnity n (AlgebraicClosure F))
      let z₀ : AlgebraicClosure F := ((g : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)
      have hz₀_pow : z₀ ^ n = 1 := by
        have h1 : (g : (AlgebraicClosure F)ˣ) ^ n = 1 := (mem_rootsOfUnity n _).mp g.2
        simpa only [z₀, Units.val_pow_eq_pow_val, Units.val_one] using congrArg Units.val h1
      have h_mem : ∀ ξ : AlgebraicClosure F, ξ ^ n = 1 → ∃ k : ℤ, ξ = z₀ ^ k := by
        intro ξ hξ
        have hξ_ne : ξ ≠ 0 := by
          rintro rfl
          rw [zero_pow hn.ne'] at hξ
          exact zero_ne_one hξ
        let u : (AlgebraicClosure F)ˣ := Units.mk0 ξ hξ_ne
        have hu : u ∈ rootsOfUnity n (AlgebraicClosure F) := by
          rw [mem_rootsOfUnity]
          ext
          exact hξ
        obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg ⟨u, hu⟩)
        refine ⟨k, ?_⟩
        have hk' : (((g ^ k : rootsOfUnity n (AlgebraicClosure F)) : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) = (u : AlgebraicClosure F) :=
          congrArg (fun x : rootsOfUnity n (AlgebraicClosure F) => ((x : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)) hk
        simpa only [Subgroup.coe_zpow, Units.val_zpow_eq_zpow_val, Units.val_mk0, z₀] using hk'.symm
      obtain ⟨a₁, ha₁⟩ := h_mem (σ₁ z₀) (by rw [← map_pow, hz₀_pow, map_one])
      obtain ⟨a₂, ha₂⟩ := h_mem (σ₂ z₀) (by rw [← map_pow, hz₀_pow, map_one])
      obtain ⟨k, rfl⟩ := h_mem ζ hζ
      calc σ₁ (σ₂ (z₀ ^ k)) = σ₁ ((σ₂ z₀) ^ k) := by rw [map_zpow₀]
        _ = σ₁ ((z₀ ^ a₂) ^ k) := by rw [ha₂]
        _ = ((σ₁ z₀) ^ a₂) ^ k := by rw [map_zpow₀, map_zpow₀]
        _ = ((z₀ ^ a₁) ^ a₂) ^ k := by rw [ha₁]
        _ = ((z₀ ^ a₂) ^ a₁) ^ k := by rw [← zpow_mul z₀ a₁ a₂, mul_comm a₁ a₂, zpow_mul z₀ a₂ a₁]
        _ = ((σ₂ z₀) ^ a₁) ^ k := by rw [← ha₂]
        _ = σ₂ ((z₀ ^ a₁) ^ k) := by rw [← map_zpow₀, ← map_zpow₀]
        _ = σ₂ ((σ₁ z₀) ^ k) := by rw [ha₁]
        _ = σ₂ (σ₁ (z₀ ^ k)) := by rw [← map_zpow₀]
    let c : EllipticRootNumber.relWeil F ⊥ := w₁ * w₂ * w₁⁻¹ * w₂⁻¹
    let τ : EllipticRootNumber.AbsGal F := (c : EllipticRootNumber.AbsGal F)
    have hc_in : τ ∈ EllipticRootNumber.inertia F := by
      change τ ∈ (EllipticRootNumber.unramifiedClosure F).fixingSubgroup
      rw [IntermediateField.mem_fixingSubgroup_iff]
      let K_fix : IntermediateField F (AlgebraicClosure F) :=
        { carrier := {x | τ x = x}
          algebraMap_mem' := fun r => τ.commutes r
          add_mem' := fun {x y} ha hb => by change τ (x + y) = x + y; rw [map_add, ha, hb]
          zero_mem' := map_zero τ
          mul_mem' := fun {x y} ha hb => by change τ (x * y) = x * y; rw [map_mul, ha, hb]
          one_mem' := map_one τ
          inv_mem' := fun {x} ha => by change τ x⁻¹ = x⁻¹; rw [map_inv₀, ha] }
      have h_le : EllipticRootNumber.unramifiedClosure F ≤ K_fix := by
        unfold EllipticRootNumber.unramifiedClosure
        rw [IntermediateField.adjoin_le_iff]
        intro ζ ⟨n, hn, _, hζn⟩
        change ((w₁ : EllipticRootNumber.AbsGal F) * (w₂ : EllipticRootNumber.AbsGal F) *
          (w₁ : EllipticRootNumber.AbsGal F)⁻¹ * (w₂ : EllipticRootNumber.AbsGal F)⁻¹) ζ = ζ
        simp only [AlgEquiv.mul_apply]
        let ζ' := (w₁ : EllipticRootNumber.AbsGal F)⁻¹ ((w₂ : EllipticRootNumber.AbsGal F)⁻¹ ζ)
        have hζ' : ζ' ^ n = 1 := by
          dsimp only [ζ']
          rw [← map_pow, ← map_pow, hζn, map_one, map_one]
        calc (w₁ : EllipticRootNumber.AbsGal F) ((w₂ : EllipticRootNumber.AbsGal F) ζ')
            = (w₂ : EllipticRootNumber.AbsGal F) ((w₁ : EllipticRootNumber.AbsGal F) ζ') :=
              h_root_comm _ _ n hn ζ' hζ'
          _ = ζ := by simp [ζ']
      intro x hx
      exact h_le hx
    have hc_M : τ ∈ M.fixingSubgroup := by
      change (w₁ : EllipticRootNumber.AbsGal F) * (w₂ : EllipticRootNumber.AbsGal F) *
        (w₁ : EllipticRootNumber.AbsGal F)⁻¹ * (w₂ : EllipticRootNumber.AbsGal F)⁻¹ ∈ M.fixingSubgroup
      exact hM_ab.2.1 _ w₁.2.2 _ w₂.2.2
    have hρc : ρ c = 1 := hρ_triv c hc_in hc_M
    have h_eq : w₁ * w₂ = c * (w₂ * w₁) := by
      dsimp only [c]
      group
    have h_act : ρ (w₁ * w₂) = ρ (w₂ * w₁) := by
      rw [h_eq, map_mul, hρc, one_mul]
    simpa only [map_mul, Module.End.mul_apply] using LinearMap.congr_fun h_act v
  let K := EllipticRootNumber.Ω F
  have h_ut : ∃ B : Module.Basis (Fin 2) K V,
      ∀ w : EllipticRootNumber.relWeil F ⊥, B.repr (ρ w (B 0)) 1 = 0 := by
    have h_pos : 0 < Module.finrank K V := by
      change 0 < Module.finrank (EllipticRootNumber.Ω F) V
      omega
    haveI : FiniteDimensional K V := FiniteDimensional.of_finrank_pos h_pos
    haveI : Nontrivial V := Module.nontrivial_of_finrank_pos h_pos
    by_cases h_all : ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v : V, ∃ c : K, ρ w v = c • v
    · let B : Module.Basis (Fin 2) K V := Module.finBasisOfFinrankEq K V hV_dim
      refine ⟨B, fun w => ?_⟩
      obtain ⟨c, hc⟩ := h_all w (B 0)
      rw [hc, LinearEquiv.map_smul, Finsupp.smul_apply, Module.Basis.repr_self,
        Finsupp.single_apply, if_neg (by decide), smul_eq_mul, mul_zero]
    · push_neg at h_all
      obtain ⟨w₀, u₀, hu₀⟩ := h_all
      obtain ⟨c₀, hc₀⟩ := Module.End.exists_eigenvalue (ρ w₀)
      obtain ⟨v₁, hv₁⟩ := hc₀.exists_hasEigenvector
      rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff] at hv₁
      rcases hv₁ with ⟨hv₁_eq, hv₁_ne⟩
      have hu₀_ne : u₀ ≠ 0 := by
        rintro rfl
        exact hu₀ 0 (by simp)
      have h_li : LinearIndependent K ![v₁, u₀] := by
        rw [linearIndependent_fin2]
        refine ⟨hu₀_ne, fun a ha => ?_⟩
        change a • u₀ = v₁ at ha
        have ha_ne : a ≠ 0 := by
          rintro rfl
          rw [zero_smul] at ha
          exact hv₁_ne ha.symm
        have h1 : a • (ρ w₀ u₀) = a • (c₀ • u₀) := by
          calc a • (ρ w₀ u₀) = ρ w₀ (a • u₀) := (LinearMap.map_smul (ρ w₀) a u₀).symm
            _ = ρ w₀ v₁ := by rw [ha]
            _ = c₀ • v₁ := hv₁_eq
            _ = c₀ • (a • u₀) := by rw [← ha]
            _ = a • (c₀ • u₀) := smul_comm c₀ a u₀
        have h2 := congrArg (a⁻¹ • ·) h1
        dsimp only at h2
        rw [inv_smul_smul₀ ha_ne, inv_smul_smul₀ ha_ne] at h2
        exact hu₀ c₀ h2
      let B : Module.Basis (Fin 2) K V :=
        basisOfLinearIndependentOfCardEqFinrank h_li (by rw [Fintype.card_fin, hV_dim])
      have hB0 : B 0 = v₁ := by
        rw [coe_basisOfLinearIndependentOfCardEqFinrank]
        rfl
      have hB1 : B 1 = u₀ := by
        rw [coe_basisOfLinearIndependentOfCardEqFinrank]
        rfl
      refine ⟨B, fun w => ?_⟩
      set a : K := B.repr (ρ w (B 0)) 0
      set b : K := B.repr (ρ w (B 0)) 1
      have h_exp : ρ w v₁ = a • v₁ + b • u₀ := by
        have h := (B.sum_repr (ρ w (B 0))).symm
        rw [Fin.sum_univ_two] at h
        simpa only [hB0, hB1, a, b] using h
      have h_lhs : ρ w₀ (ρ w v₁) = (c₀ * a) • v₁ + (c₀ * b) • u₀ := by
        rw [h_comm w₀ w v₁, hv₁_eq, LinearMap.map_smul, h_exp, smul_add, smul_smul, smul_smul]
      have h_rhs : ρ w₀ (ρ w v₁) = (c₀ * a) • v₁ + b • (ρ w₀ u₀) := by
        rw [h_exp, map_add, LinearMap.map_smul, LinearMap.map_smul, hv₁_eq, smul_smul, mul_comm a c₀]
      have h_eq : b • (ρ w₀ u₀) = (c₀ * b) • u₀ :=
        add_left_cancel (h_rhs.symm.trans h_lhs)
      by_contra hb
      have h_u₀ : ρ w₀ u₀ = c₀ • u₀ := by
        have h2 := congrArg (b⁻¹ • ·) h_eq
        dsimp only at h2
        rw [inv_smul_smul₀ hb, smul_smul, mul_comm c₀ b, inv_mul_cancel_left₀ hb] at h2
        exact h2
      exact hu₀ c₀ h_u₀
  obtain ⟨B, hB⟩ := h_ut
  let A : EllipticRootNumber.relWeil F ⊥ → Matrix (Fin 2) (Fin 2) K :=
    fun w => LinearMap.toMatrix B B (ρ w)
  have hA_apply : ∀ w i j, A w i j = B.repr (ρ w (B j)) i :=
    fun w i j => LinearMap.toMatrix_apply B B (ρ w) i j
  have hA10 : ∀ w, A w 1 0 = 0 := by
    intro w
    rw [hA_apply, hB w]
  have hA_one : A 1 = 1 := by
    dsimp only [A]
    rw [map_one, Module.End.one_eq_id, LinearMap.toMatrix_id]
  have hA_mul : ∀ w₁ w₂, A (w₁ * w₂) = A w₁ * A w₂ := by
    intro w₁ w₂
    dsimp only [A]
    rw [map_mul, Module.End.mul_eq_comp, LinearMap.toMatrix_comp B B B (ρ w₁) (ρ w₂)]
  have hA00_one : A 1 0 0 = 1 := by rw [hA_one, Matrix.one_apply_eq]
  have hA11_one : A 1 1 1 = 1 := by rw [hA_one, Matrix.one_apply_eq]
  have hA00_mul : ∀ w₁ w₂, A (w₁ * w₂) 0 0 = A w₁ 0 0 * A w₂ 0 0 := by
    intro w₁ w₂
    rw [hA_mul, Matrix.mul_apply, Fin.sum_univ_two, hA10 w₂, mul_zero, add_zero]
  have hA11_mul : ∀ w₁ w₂, A (w₁ * w₂) 1 1 = A w₁ 1 1 * A w₂ 1 1 := by
    intro w₁ w₂
    rw [hA_mul, Matrix.mul_apply, Fin.sum_univ_two, hA10 w₁, zero_mul, zero_add]
  have hA_det : ∀ w, A w 0 0 * A w 1 1 = (EllipticRootNumber.relNorm F ⊥ w : K) := by
    intro w
    have h1 : (A w).det = (EllipticRootNumber.relNorm F ⊥ w : K) := by
      dsimp only [A]
      rw [LinearMap.det_toMatrix B (ρ w), hρ_det w]
    rw [Matrix.det_fin_two, hA10 w, mul_zero, sub_zero] at h1
    exact h1
  have hA00_ne : ∀ w, A w 0 0 ≠ 0 := by
    intro w h0
    have h1 := hA_det w
    rw [h0, zero_mul] at h1
    exact (Units.ne_zero (EllipticRootNumber.relNorm F ⊥ w)) h1.symm
  have hA11_ne : ∀ w, A w 1 1 ≠ 0 := by
    intro w h0
    have h1 := hA_det w
    rw [h0, mul_zero] at h1
    exact (Units.ne_zero (EllipticRootNumber.relNorm F ⊥ w)) h1.symm
  let χ₁ : EllipticRootNumber.relWeil F ⊥ →* Kˣ :=
    { toFun := fun w => Units.mk0 (A w 0 0) (hA00_ne w)
      map_one' := by ext; exact hA00_one
      map_mul' := fun w₁ w₂ => by ext; exact hA00_mul w₁ w₂ }
  let χ₂ : EllipticRootNumber.relWeil F ⊥ →* Kˣ :=
    { toFun := fun w => Units.mk0 (A w 1 1) (hA11_ne w)
      map_one' := by ext; exact hA11_one
      map_mul' := fun w₁ w₂ => by ext; exact hA11_mul w₁ w₂ }
  have hρ_B0 : ∀ w, ρ w (B 0) = (χ₁ w : K) • B 0 := by
    intro w
    have h := (B.sum_repr (ρ w (B 0))).symm
    rw [Fin.sum_univ_two, hB w, zero_smul, add_zero] at h
    change ρ w (B 0) = A w 0 0 • B 0
    rw [hA_apply]
    exact h
  have hρ_repr1 : ∀ w (x : V), B.repr (ρ w x) 1 = (χ₂ w : K) * B.repr x 1 := by
    intro w x
    conv_lhs => rw [← B.sum_repr x, Fin.sum_univ_two]
    rw [map_add, LinearMap.map_smul, LinearMap.map_smul, hρ_B0 w,
      map_add, LinearEquiv.map_smul, LinearEquiv.map_smul, LinearEquiv.map_smul,
      Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply, Finsupp.smul_apply,
      Module.Basis.repr_self, Finsupp.single_apply, if_neg (by decide),
      smul_zero, smul_zero, zero_add, smul_eq_mul, mul_comm]
    change B.repr (ρ w (B 1)) 1 * B.repr x 1 = A w 1 1 * B.repr x 1
    rw [hA_apply]
  let f : ULift.{u} K →ₗ[K] V :=
    (LinearMap.toSpanSingleton K V (B 0)).comp (ULift.moduleEquiv : ULift.{u} K ≃ₗ[K] K).toLinearMap
  let g : V →ₗ[K] ULift.{u} K :=
    (ULift.moduleEquiv : ULift.{u} K ≃ₗ[K] K).symm.toLinearMap.comp (B.coord 1)
  have hf_apply : ∀ c : ULift.{u} K, f c = c.down • B 0 := fun _ => rfl
  have hg_apply : ∀ x : V, g x = ULift.up (B.repr x 1) := fun _ => rfl
  refine ⟨χ₁, χ₂, f, g, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro w
    ext c
    simp only [LinearMap.comp_apply, hf_apply, EllipticRootNumber.charRep,
      Representation.ofMulAction_apply, LinearMap.smul_apply, LinearMap.id_apply]
    change ((χ₁ w : K) • c).down • B 0 = ρ w (c.down • B 0)
    rw [LinearMap.map_smul, hρ_B0 w, smul_smul, mul_comm]
    rfl
  · intro w
    ext x
    change B.repr (ρ w x) 1 = (χ₂ w : K) * B.repr x 1
    exact hρ_repr1 w x
  · intro c₁ c₂ hc
    rw [hf_apply, hf_apply] at hc
    have h1 := congrArg (fun v => B.repr v 0) hc
    simp only [LinearEquiv.map_smul, Finsupp.smul_apply, Module.Basis.repr_self,
      Finsupp.single_apply, if_true, smul_eq_mul, mul_one] at h1
    exact ULift.ext _ _ h1
  · intro c
    refine ⟨c.down • B 1, ?_⟩
    apply ULift.ext
    change B.repr (c.down • B 1) 1 = c.down
    rw [LinearEquiv.map_smul, Finsupp.smul_apply, Module.Basis.repr_self,
      Finsupp.single_apply, if_pos rfl, smul_eq_mul, mul_one]
  · ext x
    rw [LinearMap.mem_range, LinearMap.mem_ker]
    constructor
    · rintro ⟨c, rfl⟩
      apply ULift.ext
      change B.repr (c.down • B 0) 1 = 0
      rw [LinearEquiv.map_smul, Finsupp.smul_apply,
        Module.Basis.repr_self, Finsupp.single_apply, if_neg (by decide),
        smul_eq_mul, mul_zero]
    · intro hx
      have hx1 : B.repr x 1 = 0 := congrArg ULift.down hx
      refine ⟨ULift.up (B.repr x 0), ?_⟩
      rw [hf_apply]
      conv_rhs => rw [← B.sum_repr x, Fin.sum_univ_two, hx1, zero_smul, add_zero]
  · intro w hwI hwM
    have hρ1 : ρ w = 1 := hρ_triv w hwI hwM
    have hAw : A w = 1 := by
      dsimp only [A]
      rw [hρ1, Module.End.one_eq_id, LinearMap.toMatrix_id]
    constructor
    · ext; change A w 0 0 = 1; rw [hAw, Matrix.one_apply_eq]
    · ext; change A w 1 1 = 1; rw [hAw, Matrix.one_apply_eq]
  · intro w
    ext
    exact hA_det w
  · intro w hwI
    have h_pow_B0 : ∀ k : ℕ, ((ρ w ^ k) (B 0)) = ((χ₁ w ^ k : Kˣ) : K) • B 0 := by
      intro k
      rw [← map_pow, hρ_B0 (w ^ k), map_pow]
    have h1 := h_pow_B0 e
    rw [hρ_pow w hwI, Module.End.one_apply] at h1
    have h2 := congrArg (fun v => B.repr v 0) h1
    simp only [LinearEquiv.map_smul, Finsupp.smul_apply, Module.Basis.repr_self,
      Finsupp.single_apply, if_true, smul_eq_mul, mul_one] at h2
    ext
    exact h2.symm
  · intro d hd hde
    refine ⟨τ₀, hτ₀_in, ?_⟩
    intro h_eq
    have h_pow_B0 : (ρ τ₀ ^ d) (B 0) = ((χ₁ τ₀ ^ d : Kˣ) : K) • B 0 := by
      rw [← map_pow, hρ_B0 (τ₀ ^ d), map_pow]
    rw [h_eq, Units.val_one, one_smul] at h_pow_B0
    exact hτ₀_ord d hd hde (B 0) (B.ne_zero 0) h_pow_B0

theorem rec_char_tame_short_exact_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hM_ab : EllipticRootNumber.IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
    (e : ℕ) (he : 2 ≤ e)
    (hπ_M : ∃ π_M : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
      (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
        Set.range (EllipticRootNumber.normLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)))
    (hU₁ : ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 1,
      EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      (u : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
        Set.range (EllipticRootNumber.normLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)))
    (χ₁ χ₂ : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
    (hχ_triv : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
      χ₁ w = 1 ∧ χ₂ w = 1)
    (hχ_prod : ∀ w : EllipticRootNumber.relWeil F ⊥,
      χ₁ w * χ₂ w = EllipticRootNumber.relNorm F ⊥ w)
    (hχ_pow : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
      χ₁ w ^ e = 1)
    (hχ_ord : ∀ d : ℕ, d ∣ e → d < e →
      ∃ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧ χ₁ w ^ d ≠ 1)
    (rec : EllipticRootNumber.LocalReciprocity F) :
    ∃ (χ'₁ χ'₂ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ),
      EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ₁) ∧
      EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ₂) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ, χ'₁ x = χ₁ (rec.recMap ⊥ x)) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ, χ'₂ x = χ₂ (rec.recMap ⊥ x)) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        χ'₁ x * χ'₂ x =
          (EllipticRootNumber.qUnit F) ^
            (-EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) ∧
      EllipticRootNumber.condExp F ⊥ χ'₁ = 1 ∧
      EllipticRootNumber.condExp F ⊥ χ'₂ = 1 ∧
      (∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ'₁ u ^ e = 1) ∧
      (∀ d : ℕ, d ∣ e → d < e →
        ∃ u ∈ EllipticRootNumber.unitGroup F ⊥ 0, χ'₁ u ^ d ≠ 1) :=
by
  open ValuativeRel in
  
  let e_bot : (⊥ : IntermediateField F (AlgebraicClosure F)) ≃ₐ[F] F :=
    IntermediateField.botEquiv F (AlgebraicClosure F)
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have h_ne_val : ∀ x : F, x ≠ 0 → iso (ValuativeRel.valuation F x) ≠ 0 := by
    intro x hx
    exact (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hx)
  have h_addVal_eq : ∀ (x : F) (m : ℤ),
      iso (ValuativeRel.valuation F x) = WithZero.exp m →
      EllipticRootNumber.addVal F x = -m := by
    intro x m hxm
    have hx : x ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero, map_zero] at hxm
      exact WithZero.exp_ne_zero hxm.symm
    unfold EllipticRootNumber.addVal
    rw [dif_neg hx]
    have hunz : WithZero.unzero (h_ne_val x hx) = Multiplicative.ofAdd m := by
      apply WithZero.coe_inj.mp
      rw [WithZero.coe_unzero, hxm]
      rfl
    rw [hunz, toAdd_ofAdd]
  have h_addVal_one : EllipticRootNumber.addVal F 1 = 0 := by
    have h1 : iso (ValuativeRel.valuation F 1) = WithZero.exp (0 : ℤ) := by
      rw [Valuation.map_one, map_one, WithZero.exp_zero]
    simpa using h_addVal_eq 1 0 h1
  have h_addVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 →
      EllipticRootNumber.addVal F (a * b) =
        EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    unfold EllipticRootNumber.addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz_mul : WithZero.unzero (h_ne_val (a * b) hab) =
        WithZero.unzero (h_ne_val a ha) * WithZero.unzero (h_ne_val b hb) := by
      apply WithZero.coe_inj.mp
      rw [WithZero.coe_unzero, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
        Valuation.map_mul, map_mul]
    rw [hunz_mul, toAdd_mul]
    omega
  obtain ⟨π, hπ_val_raw⟩ :=
    ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ_val_raw, OrderMonoidIso.apply_symm_apply]
  have hπ_ne : π ≠ 0 := by
    intro h0
    rw [h0, Valuation.map_zero, map_zero] at hπ_iso
    exact WithZero.exp_ne_zero hπ_iso.symm
  have hπ_addVal : EllipticRootNumber.addVal F π = 1 := by
    simpa using h_addVal_eq π (-1) hπ_iso
  have h_relVal_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have hnorm : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [hnorm]
  have h_resDeg_bot : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨by omega, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · exact (map_ne_zero e_bot.symm).mpr hπ_ne
    · rw [h_relVal_bot, AlgEquiv.apply_symm_apply, hπ_addVal]
      rfl
    · rintro k ⟨hk, _⟩
      exact hk
  have h_valL_bot : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_resDeg_bot, Nat.cast_one, EuclideanDomain.div_one, h_relVal_bot]
  have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.valL F ⊥ x := by
    intro x
    rw [h_relVal_bot, h_valL_bot]
  let v_hom : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* Multiplicative ℤ :=
    { toFun := fun x => Multiplicative.ofAdd (EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))
      map_one' := by
        rw [Units.val_one, h_valL_bot, map_one, h_addVal_one, ofAdd_zero]
      map_mul' := fun x y => by
        have hx : e_bot (x : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
          (map_ne_zero e_bot).mpr (Units.ne_zero x)
        have hy : e_bot (y : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
          (map_ne_zero e_bot).mpr (Units.ne_zero y)
        rw [Units.val_mul, h_valL_bot, h_valL_bot, h_valL_bot, map_mul,
          h_addVal_mul _ _ hx hy, ofAdd_add] }
  have h_valL_mul : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥
        ((x * y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) =
        EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) +
          EllipticRootNumber.valL F ⊥ (y : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    intro x y
    have h := congrArg Multiplicative.toAdd (v_hom.map_mul x y)
    simpa [v_hom, toAdd_mul] using h
  have h_valL_zpow : ∀ (x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) (m : ℤ),
      EllipticRootNumber.valL F ⊥
        ((x ^ m : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) =
        m * EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    intro x m
    have h := congrArg Multiplicative.toAdd (map_zpow v_hom x m)
    simpa [v_hom, toAdd_zpow] using h
  have h_unit0 : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      u ∈ EllipticRootNumber.unitGroup F ⊥ 0 ↔
        EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    have h_eq : EllipticRootNumber.unitGroup F ⊥ 0 = v_hom.ker := by
      unfold EllipticRootNumber.unitGroup
      have hset : {u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ |
          if (0 : ℕ) = 0 then
            EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
          else
            ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∨
              ((0 : ℕ) : ℤ) ≤
                EllipticRootNumber.valL F ⊥
                  ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1))} =
          (v_hom.ker : Set (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) := by
        ext u
        simp [v_hom, MonoidHom.mem_ker]
      rw [hset, Subgroup.closure_eq]
    intro u
    rw [h_eq, MonoidHom.mem_ker]
    simp [v_hom]
  
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  obtain ⟨r_char, hp_prime, hcard_eq⟩ := FiniteField.card 𝓀[F] (ringChar 𝓀[F])
  have hp_prime' : (EllipticRootNumber.p F).Prime := hp_prime
  have hq_eq : EllipticRootNumber.q F = (EllipticRootNumber.p F) ^ (r_char : ℕ) := by
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hcard_eq]
  have hq_gt1 : 1 < EllipticRootNumber.q F := by
    unfold EllipticRootNumber.q
    exact Finite.one_lt_card
  have h_qpow_inj : ∀ (ζ₁ ζ₂ : AlgebraicClosure F) (k c : ℕ),
      0 < k → ¬ (EllipticRootNumber.p F ∣ k) →
      ζ₁ ^ k = 1 → ζ₂ ^ k = 1 →
      ζ₁ ^ (EllipticRootNumber.q F ^ c) = ζ₂ ^ (EllipticRootNumber.q F ^ c) →
      ζ₁ = ζ₂ := by
    intro ζ₁ ζ₂ k c hk hpk hζ₁ hζ₂ hq_pow
    have h_cop_p : Nat.Coprime (EllipticRootNumber.p F) k :=
      hp_prime'.coprime_iff_not_dvd.mpr hpk
    have h_cop : Nat.Coprime (EllipticRootNumber.q F ^ c) k := by
      rw [hq_eq]
      exact (h_cop_p.pow_left (r_char : ℕ)).pow_left c
    have h₁_ne : ζ₁ ≠ 0 := by
      intro h0
      rw [h0, zero_pow hk.ne'] at hζ₁
      exact zero_ne_one hζ₁
    have h₂_ne : ζ₂ ≠ 0 := by
      intro h0
      rw [h0, zero_pow hk.ne'] at hζ₂
      exact zero_ne_one hζ₂
    let u₁ : (AlgebraicClosure F)ˣ := Units.mk0 ζ₁ h₁_ne
    let u₂ : (AlgebraicClosure F)ˣ := Units.mk0 ζ₂ h₂_ne
    let u : (AlgebraicClosure F)ˣ := u₁ * u₂⁻¹
    have hu_k : u ^ k = 1 := by
      ext
      simp [u, u₁, u₂, mul_pow, inv_pow, hζ₁, hζ₂]
    have hu_q : u ^ (EllipticRootNumber.q F ^ c) = 1 := by
      ext
      simp [u, u₁, u₂, mul_pow, inv_pow, hq_pow]
      exact mul_inv_cancel₀ (pow_ne_zero _ h₂_ne)
    have h_ord_dvd : orderOf u ∣ 1 := by
      rw [← h_cop.gcd_eq_one]
