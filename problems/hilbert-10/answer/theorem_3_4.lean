    haveI : Fact (∀ r : kF, r ^ 2 ≠ d_bar + 0 * r) := ⟨h_nonsq_bar⟩
    let E₂ := QuadraticAlgebra kF d_bar 0
    haveI : Finite E₂ := Finite.of_equiv (kF × kF) (QuadraticAlgebra.equivProd d_bar 0).symm
    have hq_gt1 : 1 < EllipticRootNumber.q F := by
      unfold EllipticRootNumber.q
      exact Finite.one_lt_card
    set m₀ := (EllipticRootNumber.q F - 1) / 2
    have hm₀_pos : 0 < m₀ := by omega
    have hm₀_mul : 2 * m₀ = EllipticRootNumber.q F - 1 := by omega
    have hd_bar_ne : d_bar ≠ 0 := by
      intro h0
      have := h_nonsq_bar 0
      rw [h0] at this
      simp at this
    obtain ⟨g_F, hg_F⟩ := IsCyclic.exists_monoid_generator (α := kFˣ)
    have h_ord_gF : orderOf g_F = EllipticRootNumber.q F - 1 := by
      rw [orderOf_eq_card_of_forall_mem_powers hg_F, Nat.card_units]
      rfl
    let u_d : kFˣ := Units.mk0 d_bar hd_bar_ne
    obtain ⟨t, ht⟩ := hg_F u_d
    change g_F ^ t = u_d at ht
    have ht_odd : ¬ (2 ∣ t) := by
      rintro ⟨c, rfl⟩
      have h_sq : (((g_F ^ c : kFˣ) : kF)) ^ 2 = d_bar + 0 * (((g_F ^ c : kFˣ) : kF)) := by
        rw [zero_mul, add_zero, ← Units.val_pow_eq_pow_val, ← pow_mul, mul_comm c 2, ht]
        rfl
      exact h_nonsq_bar _ h_sq
    have hud_sq : (u_d ^ m₀) ^ 2 = 1 := by
      rw [← ht, ← pow_mul, ← pow_mul, show t * (m₀ * 2) = (2 * m₀) * t by ring,
        hm₀_mul, ← h_ord_gF, pow_mul, pow_orderOf_eq_one, one_pow]
    have hud_ne1 : u_d ^ m₀ ≠ 1 := by
      intro h1
      rw [← ht, ← pow_mul, ← orderOf_dvd_iff_pow_eq_one, h_ord_gF, ← hm₀_mul,
        mul_comm 2 m₀, mul_comm t m₀] at h1
      exact ht_odd ((Nat.mul_dvd_mul_iff_left hm₀_pos).mp h1)
    have hd_pow_m₀ : d_bar ^ m₀ = -1 := by
      have h_sq_val : ((u_d ^ m₀ : kFˣ) : kF) ^ 2 = 1 := by
        rw [← Units.val_pow_eq_pow_val, hud_sq, Units.val_one]
      rcases sq_eq_one_iff.mp h_sq_val with h1 | hm1
      · exfalso
