  classical
  have h_comm1 : ∀ {M : Type u} [CommGroup M] (X a b c d : M),
      X * a * b⁻¹ * (b * c * d⁻¹ * a⁻¹) = X * (c * a⁻¹) * a * d⁻¹ := by
    intro M _ X a b c d
    rw [mul_assoc b c d⁻¹, mul_assoc b (c * d⁻¹) a⁻¹, mul_assoc (X * a) b⁻¹,
      inv_mul_cancel_left, mul_comm (c * d⁻¹) a⁻¹, ← mul_assoc (X * a) a⁻¹,
      mul_inv_cancel_right, ← mul_assoc X c a⁻¹, inv_mul_cancel_right, mul_assoc]
