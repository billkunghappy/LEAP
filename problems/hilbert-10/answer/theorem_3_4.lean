    have hdvd_q1_2 : (EllipticRootNumber.q F + 1) ∣ 2 * k_u :=
      (Nat.mul_dvd_mul_iff_left (by omega : 0 < EllipticRootNumber.q F - 1)).mp hdvd_2
    have hndvd_q1_1 : ¬ ((EllipticRootNumber.q F + 1) ∣ k_u) :=
      fun h => hndvd_1 (Nat.mul_dvd_mul_left (EllipticRootNumber.q F - 1) h)
    set q1_half := (EllipticRootNumber.q F + 1) / 2
    have hq1_mul : EllipticRootNumber.q F + 1 = 2 * q1_half := by omega
    have hdvd_half : q1_half ∣ k_u := by
      rw [hq1_mul] at hdvd_q1_2
      exact (Nat.mul_dvd_mul_iff_left (by decide : 0 < 2)).mp hdvd_q1_2
    obtain ⟨t_u, ht_u⟩ := hdvd_half
    have ht_u_odd : t_u = 2 * (t_u / 2) + 1 := by
      have : ¬ (2 ∣ t_u) := by
        rintro ⟨s, rfl⟩
        apply hndvd_q1_1
        refine ⟨s, ?_⟩
        rw [ht_u, hq1_mul]
        ring
      omega
    set s := t_u / 2
    have hk_u_eq : k_u = q1_half + s * (EllipticRootNumber.q F + 1) := by
      conv_lhs => rw [ht_u, ht_u_odd]
      rw [hq1_mul]
      ring
    let R_A := QuadraticAlgebra ↥A d_A 0
    let Ψ : R_A →+* H :=
      { toFun := fun z =>
          IntermediateField.inclusion h (e_bot.symm (z.re : F)) +
            IntermediateField.inclusion h (e_bot.symm (z.im : F)) * (u : H)
        map_one' := by
          change IntermediateField.inclusion h (e_bot.symm (1 : F)) +
            IntermediateField.inclusion h (e_bot.symm (0 : F)) * (u : H) = 1
          simp
        map_mul' := fun x y => by
          have h_re : ((x * y).re : F) = (x.re : F) * (y.re : F) + d_F * (x.im : F) * (y.im : F) := by
            change ((x.re * y.re + d_A * x.im * y.im : ↥A) : F) = _
            simp [d_A]
          have h_im : ((x * y).im : F) = (x.re : F) * (y.im : F) + (x.im : F) * (y.re : F) := by
            change ((x.re * y.im + x.im * y.re + 0 * x.im * y.im : ↥A) : F) = _
            simp
          have hd_eq : IntermediateField.inclusion h (e_bot.symm d_F) = (u : H) ^ 2 := by
            rw [hu_sq]
            congr 1
            exact e_bot.symm_apply_apply _
          change IntermediateField.inclusion h (e_bot.symm ((x * y).re : F)) +
            IntermediateField.inclusion h (e_bot.symm ((x * y).im : F)) * (u : H) =
            (IntermediateField.inclusion h (e_bot.symm (x.re : F)) +
              IntermediateField.inclusion h (e_bot.symm (x.im : F)) * (u : H)) *
            (IntermediateField.inclusion h (e_bot.symm (y.re : F)) +
              IntermediateField.inclusion h (e_bot.symm (y.im : F)) * (u : H))
          rw [h_re, h_im]
          simp only [map_add, map_mul, hd_eq]
          ring
        map_zero' := by
          change IntermediateField.inclusion h (e_bot.symm (0 : F)) +
            IntermediateField.inclusion h (e_bot.symm (0 : F)) * (u : H) = 0
          simp
        map_add' := fun x y => by
          change IntermediateField.inclusion h (e_bot.symm ((x.re : F) + (y.re : F))) +
            IntermediateField.inclusion h (e_bot.symm ((x.im : F) + (y.im : F))) * (u : H) = _
          simp only [map_add]
          ring }
    let red : R_A →+* E₂ :=
      { toFun := fun z => ⟨IsLocalRing.residue ↥A z.re, IsLocalRing.residue ↥A z.im⟩
        map_one' := by
          refine QuadraticAlgebra.ext ?_ ?_
          · exact map_one (IsLocalRing.residue ↥A)
          · exact map_zero (IsLocalRing.residue ↥A)
        map_mul' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_
          · change IsLocalRing.residue ↥A (x.re * y.re + d_A * x.im * y.im) =
              IsLocalRing.residue ↥A x.re * IsLocalRing.residue ↥A y.re +
                IsLocalRing.residue ↥A d_A * IsLocalRing.residue ↥A x.im * IsLocalRing.residue ↥A y.im
            simp
          · change IsLocalRing.residue ↥A (x.re * y.im + x.im * y.re + 0 * x.im * y.im) =
              IsLocalRing.residue ↥A x.re * IsLocalRing.residue ↥A y.im +
                IsLocalRing.residue ↥A x.im * IsLocalRing.residue ↥A y.re +
                0 * IsLocalRing.residue ↥A x.im * IsLocalRing.residue ↥A y.im
            simp
        map_zero' := by
          refine QuadraticAlgebra.ext ?_ ?_ <;> exact map_zero (IsLocalRing.residue ↥A)
        map_add' := fun x y => by
          refine QuadraticAlgebra.ext ?_ ?_ <;> exact map_add (IsLocalRing.residue ↥A) _ _ }
    let Ψ_u : R_Aˣ →* Hˣ := Units.map Ψ.toMonoidHom
    let red_u : R_Aˣ →* E₂ˣ := Units.map red.toMonoidHom
    have h_mk_unit : ∀ z : R_A, red z ≠ 0 → ∃ w : R_Aˣ, (w : R_A) = z := by
      intro z hz
      have h_norm_res : IsLocalRing.residue ↥A (z.re ^ 2 - d_A * z.im ^ 2) ≠ 0 := by
        intro h0
        rw [map_sub, map_pow, map_mul, map_pow, sub_eq_zero] at h0
        by_cases him : IsLocalRing.residue ↥A z.im = 0
        · rw [him] at h0
          ring_nf at h0
          have hre : IsLocalRing.residue ↥A z.re = 0 := pow_eq_zero h0
          apply hz
          refine QuadraticAlgebra.ext ?_ ?_
          · exact hre
          · exact him
        · have h_sq : (IsLocalRing.residue ↥A z.re / IsLocalRing.residue ↥A z.im) ^ 2 =
