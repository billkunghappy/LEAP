         by rw [e_bot.apply_symm_apply]; exact y_g.2,
         by rw [e_bot.apply_symm_apply, e_bot.apply_symm_apply]; exact h_not_both_lt⟩
      rw [← hv_g_eq] at h_val0
      exact h_val0.2
    let S : Set ℕ := {a : ℕ | ∀ v ∈ EllipticRootNumber.unitGroup F H a, φ' v = 1}
    have hS_ne : S.Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
