      exact congrArg Units.val (hD_g0 T' (hm2_of_m (hT'_fn Q) hQ))
    refine h_nondeg Q T' Q₁ (g T') hQ (hT'_fn Q) hQ₁ h_span fun S => ?_
    have hS1 : e_m S.1 Q = 1 := h_triv S.1 S.2
    rw [he_m_eq S.1 Q S.2 hQ] at hS1
    have hc1 : c_m S.1 Q S.2 hQ = 1 := Units.ext hS1
    have h_u : τ_u S.1 (g T') = g T' := by
      rw [hc_m_fn S.1 Q S.2 hQ, hc1, map_one, one_mul]
    have h_val := congrArg Units.val h_u
    rwa [hτ_u_val] at h_val
  exact ⟨e_m, he_pow, he_add_left, he_add_right, he_self, he_gal, he_inj⟩

theorem tateRep_det_cyclotomic_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0)
    (σ : EllipticRootNumber.AbsGal F) (k : ℕ) (ζ : AlgebraicClosure F)
    (hζ : ζ ^ (EllipticRootNumber.ell F ^ (k + 1)) = 1) :
    σ ζ = ζ ^ (PadicInt.toZModPow (k + 1) (LinearMap.det (EllipticRootNumber.tateRep F E σ))).val :=
by
  classical
  let K := AlgebraicClosure F
  let W : WeierstrassCurve.Affine K := (E.baseChange K).toAffine
  set ℓ : ℕ := EllipticRootNumber.ell F
  set m : ℕ := ℓ ^ (k + 1)
  have hΔ_W : W.Δ ≠ 0 := by
    change (E.map (algebraMap F K)).Δ ≠ 0
    rw [WeierstrassCurve.map_Δ]
    exact (map_ne_zero_iff _ (algebraMap F K).injective).mpr hΔ
  have hℓ_pos : 1 ≤ ℓ := Nat.Prime.one_le (EllipticRootNumber.ell_prime F).out
  have hm_pos : 1 ≤ m := Nat.one_le_pow (k + 1) ℓ hℓ_pos
  have hm_ne_zero : m ≠ 0 := by omega
  haveI : NeZero m := ⟨hm_ne_zero⟩
  have hℓ_ne : (ℓ : K) ≠ 0 := by
    intro h0
    have h0_F : (ℓ : F) = 0 := by
      apply (algebraMap F K).injective
      rw [map_natCast, map_zero]
      exact h0
    have h0_O : (ℓ : (ValuativeRel.valuation F).integer) = 0 :=
      Subtype.ext h0_F
    have h0_k : (ℓ : IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) = 0 := by
      have := congrArg (IsLocalRing.residue (ValuativeRel.valuation F).integer) h0_O
      rwa [map_natCast, map_zero] at this
    have h_dvd : EllipticRootNumber.p F ∣ ℓ :=
      (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) ℓ).mp h0_k
    have h_lt : EllipticRootNumber.p F + 1 ≤ ℓ :=
      (Nat.exists_infinite_primes (EllipticRootNumber.p F + 1)).choose_spec.1
    rcases (EllipticRootNumber.ell_prime F).out.eq_one_or_self_of_dvd _ h_dvd with hp1 | hpeq
    · have h1_k : ((1 : ℕ) : IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) = 0 :=
        (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) 1).mpr
          (hp1 ▸ dvd_rfl)
      rw [Nat.cast_one] at h1_k
      exact one_ne_zero h1_k
    · omega
  have hm_ne : (m : K) ≠ 0 := by
    change ((ℓ ^ (k + 1) : ℕ) : K) ≠ 0
    rw [Nat.cast_pow]
    exact pow_ne_zero (k + 1) hℓ_ne
  obtain ⟨A, D, hA1, hD1, hA2, hD2, h_deg, h_rec⟩ :=
    weierstrass_exists_division_ratfunc_polynomials K W hΔ_W
  have h_eval :=
    weierstrass_nsmul_eval_of_polynomial_recurrence K W A D hA1 hD1 hA2 hD2 h_rec
  obtain ⟨h_surj_ell, h_card_ell0⟩ :=
    weierstrass_nsmul_surjective_and_torsion_card_of_eval K W hΔ_W A D hD2 h_deg h_eval
      ℓ hℓ_pos hℓ_ne
  have h_card_ell :
      Nat.card (EllipticRootNumber.torsion F E (ℓ ^ (0 + 1))) = ℓ ^ 2 := by
    rw [zero_add, pow_one]
    exact h_card_ell0
  obtain ⟨h_surj_m, h_card_m0⟩ :=
    weierstrass_nsmul_surjective_and_torsion_card_of_eval K W hΔ_W A D hD2 h_deg h_eval
      m hm_pos hm_ne
  have h_card_m : Nat.card (EllipticRootNumber.torsion F E m) = m ^ 2 := h_card_m0
  have h_card_m_ne : Nat.card (EllipticRootNumber.torsion F E m) ≠ 0 := by
    rw [h_card_m]
    exact pow_ne_zero 2 hm_ne_zero
  haveI : Finite (EllipticRootNumber.torsion F E m) :=
    Nat.finite_of_card_ne_zero h_card_m_ne
  letI : Fintype (EllipticRootNumber.torsion F E m) := Fintype.ofFinite _
  have h_fintype_card_m : Fintype.card (EllipticRootNumber.torsion F E m) = m ^ 2 := by
    rw [← Nat.card_eq_fintype_card, h_card_m]
  obtain ⟨P₀, P₁, a₀₀, a₀₁, a₁₀, a₁₁, hP₀, hP₁, h_gen, hP₁_ord, hσP₀, hσP₁, h_det⟩ :=
    tateRep_level_basis_and_det_matrix_spec F E h_surj_ell h_card_ell σ k
  obtain ⟨τ, σ_lift, I, ℓ_step, hτ_zero, hτ_add, hσ_alg, hσ_τ, hσ_ℓ, h_span_eq,
    hI0, hI_some, hI_class, h_span_τ_ℓ, hτ_eval⟩ :=
    weierstrass_functionField_translation_and_miller_step_spec F E hΔ
  have h_nondeg :=
    weierstrass_torsion_coset_invariant_divisor_zero F E τ I hI0 hI_some hI_class hτ_eval
      k h_fintype_card_m
  obtain ⟨e_m, he_pow, he_add_left, he_add_right, he_self, he_gal, he_inj⟩ :=
    weierstrass_weilPairing_of_miller_step_and_card_spec F E τ σ_lift I ℓ_step hτ_zero hτ_add
      hσ_alg hσ_τ hσ_ℓ h_span_eq hI0 h_span_τ_ℓ k h_fintype_card_m h_surj_m h_nondeg
  have h0_tors : m • (0 : EllipticRootNumber.Pts F E) = 0 := nsmul_zero m
  have he_ne_zero : ∀ P Q : EllipticRootNumber.Pts F E,
      m • P = 0 → m • Q = 0 → e_m P Q ≠ 0 := by
    intro P Q hP hQ h0
    have h1 := he_pow P Q hP hQ
    rw [h0, zero_pow hm_ne_zero] at h1
    exact zero_ne_one h1
  have he_zero_left : ∀ Q : EllipticRootNumber.Pts F E, m • Q = 0 → e_m 0 Q = 1 := by
    intro Q hQ
    have h_sq : e_m 0 Q * e_m 0 Q = e_m 0 Q * 1 := by
      rw [← he_add_left 0 0 Q h0_tors h0_tors hQ, add_zero, mul_one]
    exact mul_left_cancel₀ (he_ne_zero 0 Q h0_tors hQ) h_sq
  have he_zero_right : ∀ P : EllipticRootNumber.Pts F E, m • P = 0 → e_m P 0 = 1 := by
    intro P hP
    have h_sq : e_m P 0 * e_m P 0 = e_m P 0 * 1 := by
      rw [← he_add_right P 0 0 hP h0_tors h0_tors, add_zero, mul_one]
    exact mul_left_cancel₀ (he_ne_zero P 0 hP h0_tors) h_sq
  have h_nsmul_tors : ∀ (r : ℕ) {P : EllipticRootNumber.Pts F E},
      m • P = 0 → m • (r • P) = 0 := by
    intro r P hP
    rw [← mul_nsmul, mul_comm, mul_nsmul, hP, nsmul_zero]
  have he_nsmul_left : ∀ (r : ℕ) (P Q : EllipticRootNumber.Pts F E),
      m • P = 0 → m • Q = 0 → e_m (r • P) Q = (e_m P Q) ^ r := by
    intro r P Q hP hQ
    induction r with
    | zero =>
      rw [zero_nsmul, pow_zero]
      exact he_zero_left Q hQ
    | succ r ih =>
      rw [succ_nsmul, he_add_left (r • P) P Q (h_nsmul_tors r hP) hP hQ, ih, pow_succ]
  have he_nsmul_right : ∀ (r : ℕ) (P Q : EllipticRootNumber.Pts F E),
      m • P = 0 → m • Q = 0 → e_m P (r • Q) = (e_m P Q) ^ r := by
    intro r P Q hP hQ
    induction r with
    | zero =>
      rw [zero_nsmul, pow_zero]
      exact he_zero_right P hP
    | succ r ih =>
      rw [succ_nsmul, he_add_right P (r • Q) Q hP (h_nsmul_tors r hQ) hQ, ih, pow_succ]
  set ζ₀ : K := e_m P₀ P₁
  have hζ₀_pow : ζ₀ ^ m = 1 := he_pow P₀ P₁ hP₀ hP₁
  have hP01_tors : m • (P₀ + P₁) = 0 := by
    rw [nsmul_add, hP₀, hP₁, add_zero]
  have hζ₀_inv : ζ₀ * e_m P₁ P₀ = 1 := by
    have h1 := he_self (P₀ + P₁) hP01_tors
    rw [he_add_left P₀ P₁ (P₀ + P₁) hP₀ hP₁ hP01_tors,
      he_add_right P₀ P₀ P₁ hP₀ hP₀ hP₁,
      he_add_right P₁ P₀ P₁ hP₁ hP₀ hP₁,
      he_self P₀ hP₀, he_self P₁ hP₁, one_mul, mul_one] at h1
    exact h1
  have hζ₀_inv' : e_m P₁ P₀ * ζ₀ = 1 := by
    rw [mul_comm, hζ₀_inv]
  have hζ₀_prim : IsPrimitiveRoot ζ₀ m := by
    rw [IsPrimitiveRoot.iff_def]
    refine ⟨hζ₀_pow, ?_⟩
    intro d hd
    apply hP₁_ord d
    apply he_inj (d • P₁) (h_nsmul_tors d hP₁)
    intro P hP
    obtain ⟨c₀, c₁, rfl⟩ := h_gen P hP
    rw [he_add_left (c₀ • P₀) (c₁ • P₁) (d • P₁)
        (h_nsmul_tors c₀ hP₀) (h_nsmul_tors c₁ hP₁) (h_nsmul_tors d hP₁),
      he_nsmul_left c₀ P₀ (d • P₁) hP₀ (h_nsmul_tors d hP₁),
      he_nsmul_left c₁ P₁ (d • P₁) hP₁ (h_nsmul_tors d hP₁),
      he_nsmul_right d P₀ P₁ hP₀ hP₁,
      he_nsmul_right d P₁ P₁ hP₁ hP₁,
      he_self P₁ hP₁, hd, one_pow, one_pow, one_pow, mul_one]
  have hσ_ζ₀_expand : σ ζ₀ = ζ₀ ^ (a₀₀ * a₁₁) * (e_m P₁ P₀) ^ (a₁₀ * a₀₁) := by
    have h1 := (he_gal σ P₀ P₁ hP₀ hP₁).symm
    rw [hσP₀, hσP₁] at h1
    have hR : m • (a₀₁ • P₀ + a₁₁ • P₁) = 0 := by
      rw [nsmul_add, h_nsmul_tors a₀₁ hP₀, h_nsmul_tors a₁₁ hP₁, add_zero]
    rw [he_add_left (a₀₀ • P₀) (a₁₀ • P₁) (a₀₁ • P₀ + a₁₁ • P₁)
        (h_nsmul_tors a₀₀ hP₀) (h_nsmul_tors a₁₀ hP₁) hR,
      he_add_right (a₀₀ • P₀) (a₀₁ • P₀) (a₁₁ • P₁)
        (h_nsmul_tors a₀₀ hP₀) (h_nsmul_tors a₀₁ hP₀) (h_nsmul_tors a₁₁ hP₁),
      he_add_right (a₁₀ • P₁) (a₀₁ • P₀) (a₁₁ • P₁)
        (h_nsmul_tors a₁₀ hP₁) (h_nsmul_tors a₀₁ hP₀) (h_nsmul_tors a₁₁ hP₁),
      he_nsmul_left a₀₀ P₀ (a₀₁ • P₀) hP₀ (h_nsmul_tors a₀₁ hP₀),
      he_nsmul_right a₀₁ P₀ P₀ hP₀ hP₀,
      he_nsmul_left a₀₀ P₀ (a₁₁ • P₁) hP₀ (h_nsmul_tors a₁₁ hP₁),
      he_nsmul_right a₁₁ P₀ P₁ hP₀ hP₁,
      he_nsmul_left a₁₀ P₁ (a₀₁ • P₀) hP₁ (h_nsmul_tors a₀₁ hP₀),
      he_nsmul_right a₀₁ P₁ P₀ hP₁ hP₀,
      he_nsmul_left a₁₀ P₁ (a₁₁ • P₁) hP₁ (h_nsmul_tors a₁₁ hP₁),
      he_nsmul_right a₁₁ P₁ P₁ hP₁ hP₁,
      he_self P₀ hP₀, he_self P₁ hP₁,
      one_pow, one_pow, one_pow, one_pow, one_mul, mul_one,
      ← pow_mul, ← pow_mul, mul_comm a₁₁ a₀₀, mul_comm a₀₁ a₁₀] at h1
    exact h1
  set det_zmod : ZMod m :=
    PadicInt.toZModPow (k + 1) (LinearMap.det (EllipticRootNumber.tateRep F E σ))
  have hζ₀_mod : ∀ n : ℕ, ζ₀ ^ n = ζ₀ ^ (n : ZMod m).val := by
    intro n
    rw [ZMod.val_natCast]
    conv_lhs => rw [← Nat.mod_add_div n m]
    rw [pow_add, pow_mul, hζ₀_pow, one_pow, mul_one]
  have h_det_add :
      ((det_zmod.val + a₀₁ * a₁₀ : ℕ) : ZMod m) = ((a₀₀ * a₁₁ : ℕ) : ZMod m) := by
    rw [Nat.cast_add, Nat.cast_mul, Nat.cast_mul, ZMod.natCast_zmod_val, h_det, sub_add_cancel]
  have hζ₀_det_eq : ζ₀ ^ det_zmod.val * ζ₀ ^ (a₀₁ * a₁₀) = ζ₀ ^ (a₀₀ * a₁₁) := by
    rw [← pow_add, hζ₀_mod (det_zmod.val + a₀₁ * a₁₀), hζ₀_mod (a₀₀ * a₁₁), h_det_add]
  have hσ_ζ₀_mul : σ ζ₀ * ζ₀ ^ (a₀₁ * a₁₀) = ζ₀ ^ (a₀₀ * a₁₁) := by
    rw [hσ_ζ₀_expand, mul_assoc, mul_comm a₁₀ a₀₁, ← mul_pow, hζ₀_inv', one_pow, mul_one]
  have hζ₀_ne_zero : ζ₀ ≠ 0 := he_ne_zero P₀ P₁ hP₀ hP₁
  have hσ_ζ₀ : σ ζ₀ = ζ₀ ^ det_zmod.val :=
    mul_right_cancel₀ (pow_ne_zero (a₀₁ * a₁₀) hζ₀_ne_zero) (hσ_ζ₀_mul.trans hζ₀_det_eq.symm)
  obtain ⟨r, _hr_lt, hr_eq⟩ := hζ₀_prim.eq_pow_of_pow_eq_one hζ
  rw [← hr_eq, map_pow, hσ_ζ₀, ← pow_mul, mul_comm det_zmod.val r, pow_mul]

theorem tateRep_det_eq_q_pow_of_actsAsFrobPow_nat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (σ : EllipticRootNumber.AbsGal F) (m : ℕ)
    (h_cyc : ∀ (k : ℕ) (ζ : AlgebraicClosure F),
      ζ ^ (EllipticRootNumber.ell F ^ (k + 1)) = 1 →
      σ ζ = ζ ^ (PadicInt.toZModPow (k + 1) (LinearMap.det (EllipticRootNumber.tateRep F E σ))).val)
    (h_frob : EllipticRootNumber.ActsAsFrobPow F σ (m : ℤ)) :
    LinearMap.det (EllipticRootNumber.tateRep F E σ) =
      ((EllipticRootNumber.q F ^ m : ℕ) : ℤ_[EllipticRootNumber.ell F]) :=
by
  let ℓ := EllipticRootNumber.ell F
  haveI : Fact ℓ.Prime := EllipticRootNumber.ell_prime F
  letI : Fintype (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) :=
    Fintype.ofFinite (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
  obtain ⟨_, hp, _⟩ :=
    FiniteField.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      (ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer))
  have hp_prime : (EllipticRootNumber.p F).Prime := hp
  apply PadicInt.ext_of_toZModPow.mp
  intro n
  cases n with
  | zero =>
    haveI : Subsingleton (ZMod (ℓ ^ 0)) := by
      change Subsingleton (ZMod 1)
      infer_instance
    exact Subsingleton.elim _ _
  | succ k =>
    set N := ℓ ^ (k + 1)
    have hN_pos : 0 < N := pow_pos (EllipticRootNumber.ell_prime F).out.pos (k + 1)
    have hpN : ¬ (EllipticRootNumber.p F ∣ N) := by
      intro hdvd
      have h_dvd_ell : EllipticRootNumber.p F ∣ ℓ := hp_prime.dvd_of_dvd_pow hdvd
      rcases (Nat.dvd_prime (EllipticRootNumber.ell_prime F).out).mp h_dvd_ell with h1 | heq
      · exact hp_prime.ne_one h1
      · exact EllipticRootNumber.ell_ne_p F heq.symm
    have hN_F_ne : ((N : ℕ) : F) ≠ 0 := by
      intro h0
      have h0_O : ((N : ℕ) : ↥(ValuativeRel.valuation F).integer) = 0 := by
        apply Subtype.ext
        exact h0
      have h0_k : ((N : ℕ) : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) = 0 := by
        have h_res := congrArg (IsLocalRing.residue ↥(ValuativeRel.valuation F).integer) h0_O
        simpa using h_res
      exact hpN ((CharP.cast_eq_zero_iff
        (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
        (ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)) N).mp h0_k)
    letI : NeZero N := ⟨hN_pos.ne'⟩
    letI : NeZero ((N : ℕ) : F) := ⟨hN_F_ne⟩
    obtain ⟨ζ, hζ_prim⟩ := (AlgebraicClosure.hasEnoughRootsOfUnity F N).prim
    have hζ_pow : ζ ^ N = 1 := hζ_prim.pow_eq_one
    have hζ_root : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ :=
      ⟨N, hN_pos, hpN, hζ_pow⟩
    have h_frob_ζ := h_frob ζ hζ_root
    have h_neg_toNat : (-(m : ℤ)).toNat = 0 := by omega
    have h_pos_toNat : (m : ℤ).toNat = m := Int.toNat_natCast m
    rw [h_neg_toNat, pow_zero, pow_one, h_pos_toNat] at h_frob_ζ
    have h_cyc_ζ := h_cyc k ζ hζ_pow
    have h_eq_pow :
        ζ ^ (PadicInt.toZModPow (k + 1) (LinearMap.det (EllipticRootNumber.tateRep F E σ))).val =
          ζ ^ (PadicInt.toZModPow (k + 1) ((EllipticRootNumber.q F ^ m : ℕ) : ℤ_[ℓ])).val := by
      rw [← h_cyc_ζ, h_frob_ζ, map_natCast, ZMod.val_natCast]
      conv_lhs => rw [← Nat.mod_add_div (EllipticRootNumber.q F ^ m) N]
      rw [pow_add, pow_mul, hζ_pow, one_pow, mul_one]
    have h_val_eq :
        (PadicInt.toZModPow (k + 1) (LinearMap.det (EllipticRootNumber.tateRep F E σ))).val =
          (PadicInt.toZModPow (k + 1) ((EllipticRootNumber.q F ^ m : ℕ) : ℤ_[ℓ])).val :=
      hζ_prim.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) h_eq_pow
    exact ZMod.val_injective N h_val_eq

theorem ellAdicRep_kummer_det_eq_relNorm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1))
    (π : F) (ϖ : AlgebraicClosure F)
    (τ₀ : EllipticRootNumber.relWeil F ⊥) (ζ : F)
    (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hϖ_ne : ϖ ≠ 0) (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hτ₀_in : (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (hζ_ord : ∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 → ζ ^ d ≠ 1)
    (hτ₀_ϖ : (τ₀ : EllipticRootNumber.AbsGal F) ϖ = algebraMap F (AlgebraicClosure F) ζ * ϖ)
    (w : EllipticRootNumber.relWeil F ⊥) :
    LinearMap.det (((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w) =
      (EllipticRootNumber.relNorm F ⊥ w : EllipticRootNumber.Ω F) :=
by
  have hΔ_ne : E.Δ ≠ 0 := by
    intro h0
    rw [EllipticRootNumber.addVal, dif_pos h0] at hΔ
    omega
  have h_det_nat : ∀ (σ : EllipticRootNumber.AbsGal F) (m : ℕ),
      EllipticRootNumber.ActsAsFrobPow F σ (m : ℤ) →
      LinearMap.det (EllipticRootNumber.ellAdicRep F E σ) =
        (EllipticRootNumber.q F : EllipticRootNumber.Ω F) ^ m := by
    intro σ m h_frob
    rw [ellAdicRep_det_eq_algebraMap_tateRep_det F E σ,
      tateRep_det_eq_q_pow_of_actsAsFrobPow_nat F E σ m
        (tateRep_det_cyclotomic_spec F E hΔ_ne σ) h_frob,
      map_natCast, map_natCast, Nat.cast_pow]
  obtain ⟨d, hd_frob, hd_norm⟩ := relNorm_eq_q_zpow_of_actsAsFrobPow F w
  rw [hd_norm]
  change LinearMap.det (EllipticRootNumber.ellAdicRep F E (w : EllipticRootNumber.AbsGal F)) =
    (EllipticRootNumber.q F : EllipticRootNumber.Ω F) ^ d
  cases d with
  | ofNat m =>
    rw [Int.ofNat_eq_coe, zpow_natCast]
    exact h_det_nat (w : EllipticRootNumber.AbsGal F) m hd_frob
  | negSucc k =>
    set σ := (w : EllipticRootNumber.AbsGal F)
    have h_frob_inv : EllipticRootNumber.ActsAsFrobPow F σ⁻¹ ((k + 1 : ℕ) : ℤ) := by
      intro ζ' hζ'
      rcases hζ' with ⟨N, hN0, hpN, hζ'N⟩
      have h_inv_root : EllipticRootNumber.IsPrimeToPRootOfUnity F (σ⁻¹ ζ') :=
        ⟨N, hN0, hpN, by rw [← map_pow, hζ'N, map_one]⟩
      have h1 := hd_frob (σ⁻¹ ζ') h_inv_root
      have h2 : σ (σ⁻¹ ζ') = ζ' := AlgEquiv.apply_symm_apply σ ζ'
      rw [h2] at h1
      have h_neg1 : (-Int.negSucc k).toNat = k + 1 := rfl
      have h_pos1 : (Int.negSucc k).toNat = 0 := rfl
      have h_neg2 : (-((k + 1 : ℕ) : ℤ)).toNat = 0 := by omega
      have h_pos2 : ((k + 1 : ℕ) : ℤ).toNat = k + 1 := Int.toNat_natCast (k + 1)
      rw [h_neg1, h_pos1] at h1
      rw [h_neg2, h_pos2]
      exact h1.symm
    have h_det_inv : LinearMap.det (EllipticRootNumber.ellAdicRep F E σ⁻¹) =
        (EllipticRootNumber.q F : EllipticRootNumber.Ω F) ^ (k + 1) :=
      h_det_nat σ⁻¹ (k + 1) h_frob_inv
    have h_comp :
        EllipticRootNumber.ellAdicRep F E σ ∘ₗ EllipticRootNumber.ellAdicRep F E σ⁻¹ =
          LinearMap.id := by
      rw [← Module.End.mul_eq_comp, ← map_mul, mul_inv_cancel, map_one, Module.End.one_eq_id]
    have h_det_mul :
        LinearMap.det (EllipticRootNumber.ellAdicRep F E σ) *
          LinearMap.det (EllipticRootNumber.ellAdicRep F E σ⁻¹) = 1 := by
      rw [← LinearMap.det_comp, h_comp, LinearMap.det_id]
    rw [h_det_inv] at h_det_mul
    rw [zpow_negSucc]
    exact eq_inv_of_mul_eq_one_left h_det_mul

theorem ellAdicRep_inertia_eq_one_of_kummer_fix (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (π : F) (ϖ : AlgebraicClosure F)
    (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hϖ_ne : ϖ ≠ 0) (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (w : EllipticRootNumber.relWeil F ⊥)
    (hw_in : (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F)
    (hw_fix : (w : EllipticRootNumber.AbsGal F) ϖ = ϖ) :
    ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w = 1 :=
by
  classical
  obtain ⟨v, hv_gal, hv_le, hv_lt, hv_eq, hv_minpoly, hv_ell⟩ :=
    exists_galois_invariant_valuation_extension F
  let K := AlgebraicClosure F
  let φ := algebraMap F K
  let W₁ : WeierstrassCurve K := E.baseChange K
  
  have h_s4 : ∃ C : WeierstrassCurve.VariableChange K,
      v (C • W₁).a₁ ≤ 1 ∧ v (C • W₁).a₂ ≤ 1 ∧ v (C • W₁).a₃ ≤ 1 ∧
      v (C • W₁).a₄ ≤ 1 ∧ v (C • W₁).a₆ ≤ 1 ∧ v (C • W₁).Δ = 1 ∧
      (w : EllipticRootNumber.AbsGal F) (C.u : K) = (C.u : K) ∧
      (w : EllipticRootNumber.AbsGal F) C.r = C.r ∧
      (w : EllipticRootNumber.AbsGal F) C.s = C.s ∧
      (w : EllipticRootNumber.AbsGal F) C.t = C.t := by
    let A := (ValuativeRel.valuation F).valuationSubring
    let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
    have hp_info : (EllipticRootNumber.p F).Prime ∧ EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
      letI : Fintype kF := Fintype.ofFinite kF
      obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
      refine ⟨hp_prime, ?_⟩
      unfold EllipticRootNumber.q EllipticRootNumber.p
      rw [Nat.card_eq_fintype_card, hcard_eq]
      exact dvd_pow_self (ringChar kF) k_card.ne_zero
    obtain ⟨hp_prime', hp_dvd_q⟩ := hp_info
    have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
      rintro h; rw [h] at hp_dvd_q; exact hq2 hp_dvd_q
    have hp_ne3 : EllipticRootNumber.p F ≠ 3 := by
      rintro h; rw [h] at hp_dvd_q; exact hq3 hp_dvd_q
    have hvalF_prime : ∀ l : ℕ, l.Prime → EllipticRootNumber.p F ≠ l →
        ValuativeRel.valuation F (l : F) = 1 := by
      intro l hl_prime hp_ne_l
      have hl_le : ValuativeRel.valuation F (l : F) ≤ 1 := (l : ↥A).2
      apply le_antisymm hl_le
      by_contra! h_lt
      have hl_mem : (l : ↥A) ∈ IsLocalRing.maximalIdeal ↥A :=
        (Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F)).mpr h_lt
      have hl_res : IsLocalRing.residue ↥A (l : ↥A) = 0 :=
        (IsLocalRing.residue_eq_zero_iff (l : ↥A)).mpr hl_mem
      rw [map_natCast] at hl_res
      haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
      have hdvd : EllipticRootNumber.p F ∣ l :=
        (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) l).mp hl_res
      rcases (Nat.dvd_prime hl_prime).mp hdvd with h1 | heq
      · exact hp_prime'.ne_one h1
      · exact hp_ne_l heq
    have hvalF_2 : ValuativeRel.valuation F (2 : F) = 1 :=
      by exact_mod_cast hvalF_prime 2 Nat.prime_two hp_ne2
    have hvalF_3 : ValuativeRel.valuation F (3 : F) = 1 :=
      by exact_mod_cast hvalF_prime 3 Nat.prime_three hp_ne3
    have h2F_ne : (2 : F) ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at hvalF_2; exact zero_ne_one hvalF_2
    have h3F_ne : (3 : F) ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at hvalF_3; exact zero_ne_one hvalF_3
    have h12F_ne : (12 : F) ≠ 0 := by
      have : (12 : F) = 2 * 2 * 3 := by norm_num
      rw [this]
      exact mul_ne_zero (mul_ne_zero h2F_ne h2F_ne) h3F_ne
    have hv2 : v (2 : K) = 1 := by
      have : (2 : K) = φ 2 := (map_ofNat φ 2).symm
      rw [this, hv_eq]
      exact hvalF_2
    have hv3 : v (3 : K) = 1 := by
      have : (3 : K) = φ 3 := (map_ofNat φ 3).symm
      rw [this, hv_eq]
      exact hvalF_3
    have hv48 : v (-48 : K) = 1 := by
      have : (-48 : K) = -((2 : K) ^ 4 * 3) := by norm_num
      rw [this, Valuation.map_neg, map_mul, map_pow, hv2, hv3, one_pow, one_mul]
    have hv864 : v (-864 : K) = 1 := by
      have : (-864 : K) = -((2 : K) ^ 5 * (3 : K) ^ 3) := by norm_num
      rw [this, Valuation.map_neg, map_mul, map_pow, map_pow, hv2, hv3, one_pow, one_pow, one_mul]
    have hΔ_ne : E.Δ ≠ 0 := by
      intro h0
      rw [EllipticRootNumber.addVal, dif_pos h0] at hΔ
      omega
    let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hπ_nz : iso (ValuativeRel.valuation F π) ≠ 0 :=
      (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hπ_ne)
    have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
      unfold EllipticRootNumber.addVal at hπ_val
      rw [dif_neg hπ_ne] at hπ_val
      have h1 : Multiplicative.toAdd (WithZero.unzero hπ_nz) = -1 := by omega
      rw [← WithZero.coe_unzero hπ_nz]
      change WithZero.exp (Multiplicative.toAdd (WithZero.unzero hπ_nz)) = WithZero.exp (-1 : ℤ)
      rw [h1]
    have hΔ_nz : iso (ValuativeRel.valuation F E.Δ) ≠ 0 :=
      (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hΔ_ne)
    have hΔ_iso : iso (ValuativeRel.valuation F E.Δ) = WithZero.exp (-(n : ℤ)) := by
      unfold EllipticRootNumber.addVal at hΔ
      rw [dif_neg hΔ_ne] at hΔ
      have h1 : Multiplicative.toAdd (WithZero.unzero hΔ_nz) = -(n : ℤ) := by omega
      rw [← WithZero.coe_unzero hΔ_nz]
      change WithZero.exp (Multiplicative.toAdd (WithZero.unzero hΔ_nz)) = WithZero.exp (-(n : ℤ))
      rw [h1]
    have hπn_iso : iso (ValuativeRel.valuation F (π ^ n)) = WithZero.exp (-(n : ℤ)) := by
      rw [map_pow, map_pow, hπ_iso, ← WithZero.exp_nsmul]
      simp
    have hΔ_eq_πn : ValuativeRel.valuation F E.Δ = ValuativeRel.valuation F (π ^ n) :=
      iso.injective (hΔ_iso.trans hπn_iso.symm)
    have hπn_ne : π ^ n ≠ 0 := pow_ne_zero n hπ_ne
    have hval_πn_ne : ValuativeRel.valuation F (π ^ n) ≠ 0 :=
      (Valuation.ne_zero_iff _).mpr hπn_ne
    have hval_Δ_div : ValuativeRel.valuation F (E.Δ / π ^ n) = 1 := by
      rw [map_div₀, hΔ_eq_πn, div_self hval_πn_ne]
    have hval_c4_div : ValuativeRel.valuation F (E.c₄ ^ 3 / π ^ n) ≤ 1 := by
      have h_id : E.c₄ ^ 3 / π ^ n = (E.c₄ ^ 3 / E.Δ) * (E.Δ / π ^ n) :=
        (div_mul_div_cancel₀ hΔ_ne).symm
      rw [h_id, map_mul, hval_Δ_div, mul_one]
      exact hj
    have hval_1728 : ValuativeRel.valuation F (1728 : F) ≤ 1 := by
      exact_mod_cast (1728 : ↥A).2
    have hval_c6_div : ValuativeRel.valuation F (E.c₆ ^ 2 / π ^ n) ≤ 1 := by
      have h_id : E.c₆ ^ 2 / π ^ n = E.c₄ ^ 3 / π ^ n - 1728 * (E.Δ / π ^ n) := by
        rw [← mul_div_assoc, ← sub_div]
        congr 1
        linear_combination WeierstrassCurve.c_relation E
      rw [h_id]
      refine le_trans (Valuation.map_sub _ _ _) (max_le hval_c4_div ?_)
      rw [map_mul, hval_Δ_div, mul_one]
      exact hval_1728
    set e_exp : ℕ := 12 / Nat.gcd n 12
    set m_exp : ℕ := n / Nat.gcd n 12
    have h12m : m_exp * 12 = e_exp * n := by
      change (n / Nat.gcd n 12) * 12 = (12 / Nat.gcd n 12) * n
      interval_cases n <;> decide
    let u₀ : K := ϖ ^ m_exp
    have hu₀ : u₀ ≠ 0 := pow_ne_zero m_exp hϖ_ne
    let s_F : F := -E.a₁ / 2
    let r_F : F := -E.b₂ / 12
    let t_F : F := -(E.a₃ + r_F * E.a₁) / 2
    let C : WeierstrassCurve.VariableChange K := ⟨Units.mk0 u₀ hu₀, φ r_F, φ s_F, φ t_F⟩
    let W₂ : WeierstrassCurve K := C • W₁
    have hu₀_12 : u₀ ^ 12 = φ (π ^ n) := by
      change (ϖ ^ m_exp) ^ 12 = φ (π ^ n)
      rw [← pow_mul, h12m, pow_mul, hϖ_pow, ← map_pow]
    have hu_inv_12 : ((C.u⁻¹ : Kˣ) : K) ^ 12 = φ ((π ^ n)⁻¹) := by
      rw [Units.val_inv_eq_inv_val]
      change u₀⁻¹ ^ 12 = φ ((π ^ n)⁻¹)
      rw [inv_pow, hu₀_12, map_inv₀]
    have ha₁_F : E.a₁ + 2 * s_F = 0 := by
      dsimp [s_F]
      rw [mul_div_cancel₀ _ h2F_ne]
      ring
    have ha₂_F : E.a₂ - s_F * E.a₁ + 3 * r_F - s_F ^ 2 = 0 := by
      dsimp [s_F, r_F, WeierstrassCurve.b₂]
      field_simp
      ring
    have ha₃_F : E.a₃ + r_F * E.a₁ + 2 * t_F = 0 := by
      dsimp [t_F]
      rw [mul_div_cancel₀ _ h2F_ne]
      ring
    have hW₁_a₁ : W₁.a₁ = φ E.a₁ := WeierstrassCurve.map_a₁ E φ
    have hW₁_a₂ : W₁.a₂ = φ E.a₂ := WeierstrassCurve.map_a₂ E φ
    have hW₁_a₃ : W₁.a₃ = φ E.a₃ := WeierstrassCurve.map_a₃ E φ
    have hW₁_c₄ : W₁.c₄ = φ E.c₄ := WeierstrassCurve.map_c₄ E φ
    have hW₁_c₆ : W₁.c₆ = φ E.c₆ := WeierstrassCurve.map_c₆ E φ
    have hW₁_Δ : W₁.Δ = φ E.Δ := WeierstrassCurve.map_Δ E φ
    have hW₂_a₁ : W₂.a₁ = 0 := by
      rw [WeierstrassCurve.variableChange_a₁ W₁ C, hW₁_a₁]
      change ((C.u⁻¹ : Kˣ) : K) * (φ E.a₁ + 2 * φ s_F) = 0
      rw [← map_ofNat φ 2, ← map_mul, ← map_add, ha₁_F, map_zero, mul_zero]
    have hW₂_a₂ : W₂.a₂ = 0 := by
      rw [WeierstrassCurve.variableChange_a₂ W₁ C, hW₁_a₁, hW₁_a₂]
      change ((C.u⁻¹ : Kˣ) : K) ^ 2 * (φ E.a₂ - φ s_F * φ E.a₁ + 3 * φ r_F - φ s_F ^ 2) = 0
      rw [← map_ofNat φ 3, ← map_mul, ← map_mul, ← map_pow, ← map_sub, ← map_add, ← map_sub,
        ha₂_F, map_zero, mul_zero]
    have hW₂_a₃ : W₂.a₃ = 0 := by
      rw [WeierstrassCurve.variableChange_a₃ W₁ C, hW₁_a₁, hW₁_a₃]
      change ((C.u⁻¹ : Kˣ) : K) ^ 3 * (φ E.a₃ + φ r_F * φ E.a₁ + 2 * φ t_F) = 0
      rw [← map_ofNat φ 2, ← map_mul, ← map_mul, ← map_add, ← map_add, ha₃_F, map_zero, mul_zero]
    have hW₂_c₄_short : W₂.c₄ = -48 * W₂.a₄ := by
      unfold WeierstrassCurve.c₄ WeierstrassCurve.b₂ WeierstrassCurve.b₄
      rw [hW₂_a₁, hW₂_a₂, hW₂_a₃]
      ring
    have hW₂_c₆_short : W₂.c₆ = -864 * W₂.a₆ := by
      unfold WeierstrassCurve.c₆ WeierstrassCurve.b₂ WeierstrassCurve.b₄ WeierstrassCurve.b₆
      rw [hW₂_a₁, hW₂_a₂, hW₂_a₃]
      ring
    have hW₂_c₄_pow : (-48 * W₂.a₄) ^ 3 = φ (E.c₄ ^ 3 / π ^ n) := by
      rw [← hW₂_c₄_short, WeierstrassCurve.variableChange_c₄ W₁ C, hW₁_c₄, mul_pow,
        ← pow_mul, hu_inv_12, ← map_pow, ← map_mul, inv_mul_eq_div]
    have hW₂_c₆_pow : (-864 * W₂.a₆) ^ 2 = φ (E.c₆ ^ 2 / π ^ n) := by
      rw [← hW₂_c₆_short, WeierstrassCurve.variableChange_c₆ W₁ C, hW₁_c₆, mul_pow,
        ← pow_mul, hu_inv_12, ← map_pow, ← map_mul, inv_mul_eq_div]
    have hW₂_Δ_eq : W₂.Δ = φ (E.Δ / π ^ n) := by
      rw [WeierstrassCurve.variableChange_Δ W₁ C, hW₁_Δ, hu_inv_12, ← map_mul, inv_mul_eq_div]
    have hva₄_pow : v W₂.a₄ ^ 3 ≤ 1 := by
      have h1 : v ((-48 * W₂.a₄) ^ 3) ≤ 1 := by
        rw [hW₂_c₄_pow]
        exact (hv_le _).mpr hval_c4_div
      rwa [map_pow, map_mul, hv48, one_mul] at h1
    have hva₄ : v W₂.a₄ ≤ 1 := by
      by_contra h_gt
      push_neg at h_gt
      exact not_lt_of_ge hva₄_pow (one_lt_pow₀ h_gt (by norm_num))
    have hva₆_pow : v W₂.a₆ ^ 2 ≤ 1 := by
      have h1 : v ((-864 * W₂.a₆) ^ 2) ≤ 1 := by
        rw [hW₂_c₆_pow]
        exact (hv_le _).mpr hval_c6_div
      rwa [map_pow, map_mul, hv864, one_mul] at h1
    have hva₆ : v W₂.a₆ ≤ 1 := by
      by_contra h_gt
      push_neg at h_gt
      exact not_lt_of_ge hva₆_pow (one_lt_pow₀ h_gt (by norm_num))
    have hvΔ : v W₂.Δ = 1 := by
      rw [hW₂_Δ_eq]
      exact (hv_eq _).mpr hval_Δ_div
    refine ⟨C, by rw [hW₂_a₁, map_zero]; exact zero_le _,
      by rw [hW₂_a₂, map_zero]; exact zero_le _,
      by rw [hW₂_a₃, map_zero]; exact zero_le _,
      hva₄, hva₆, hvΔ, ?_, AlgEquiv.commutes (w : EllipticRootNumber.AbsGal F) r_F,
      AlgEquiv.commutes (w : EllipticRootNumber.AbsGal F) s_F,
      AlgEquiv.commutes (w : EllipticRootNumber.AbsGal F) t_F⟩
    change (w : EllipticRootNumber.AbsGal F) (ϖ ^ m_exp) = ϖ ^ m_exp
    rw [map_pow, hw_fix]
  obtain ⟨C, hva₁, hva₂, hva₃, hva₄, hva₆, hvΔ, hσu, hσr, hσs, hσt⟩ := h_s4
  
  let W₁' : WeierstrassCurve.Affine K := W₁.toAffine
  let W₂' : WeierstrassCurve.Affine K := (C • W₁).toAffine
  let u : K := C.u
  let u_inv : K := (C.u⁻¹ : Kˣ)
  let r : K := C.r
  let s : K := C.s
  let t : K := C.t
  have huu : u * u_inv = 1 := Units.mul_inv C.u
  have huu' : u_inv * u = 1 := Units.inv_mul C.u
  have hu_inv : u_inv ≠ 0 := Units.ne_zero C.u⁻¹
  have ha₁_C : W₂'.a₁ = u_inv * (W₁'.a₁ + 2 * s) := WeierstrassCurve.variableChange_a₁ W₁ C
  have ha₂_C : W₂'.a₂ = u_inv ^ 2 * (W₁'.a₂ - s * W₁'.a₁ + 3 * r - s ^ 2) :=
    WeierstrassCurve.variableChange_a₂ W₁ C
  have ha₃_C : W₂'.a₃ = u_inv ^ 3 * (W₁'.a₃ + r * W₁'.a₁ + 2 * t) :=
    WeierstrassCurve.variableChange_a₃ W₁ C
  have ha₄_C : W₂'.a₄ = u_inv ^ 4 *
      (W₁'.a₄ - s * W₁'.a₃ + 2 * r * W₁'.a₂ - (t + r * s) * W₁'.a₁ + 3 * r ^ 2 - 2 * s * t) :=
    WeierstrassCurve.variableChange_a₄ W₁ C
  have ha₆_C : W₂'.a₆ = u_inv ^ 6 *
      (W₁'.a₆ + r * W₁'.a₄ + r ^ 2 * W₁'.a₂ + r ^ 3 - t * W₁'.a₃ - t ^ 2 - r * t * W₁'.a₁) :=
    WeierstrassCurve.variableChange_a₆ W₁ C
  let X : K → K := fun x => u_inv ^ 2 * (x - r)
  let Y : K → K → K := fun x y => u_inv ^ 3 * (y - s * (x - r) - t)
  let X' : K → K := fun x' => u ^ 2 * x' + r
  let Y' : K → K → K := fun x' y' => u ^ 3 * y' + u ^ 2 * s * x' + t
  have hXX' : ∀ x, X' (X x) = x := fun x => by
    dsimp only [X, X']
    calc u ^ 2 * (u_inv ^ 2 * (x - r)) + r
      _ = (u * u_inv) ^ 2 * (x - r) + r := by ring
      _ = 1 ^ 2 * (x - r) + r := by rw [huu]
      _ = x := by ring
  have hX'X : ∀ x', X (X' x') = x' := fun x' => by
    dsimp only [X, X']
    calc u_inv ^ 2 * ((u ^ 2 * x' + r) - r)
      _ = (u_inv * u) ^ 2 * x' := by ring
      _ = 1 ^ 2 * x' := by rw [huu']
      _ = x' := by ring
  have hYY' : ∀ x y, Y' (X x) (Y x y) = y := fun x y => by
    dsimp only [X, Y, Y']
    calc u ^ 3 * (u_inv ^ 3 * (y - s * (x - r) - t)) +
          u ^ 2 * s * (u_inv ^ 2 * (x - r)) + t
      _ = (u * u_inv) ^ 3 * (y - s * (x - r) - t) +
          (u * u_inv) ^ 2 * s * (x - r) + t := by ring
      _ = 1 ^ 3 * (y - s * (x - r) - t) +
          1 ^ 2 * s * (x - r) + t := by rw [huu]
      _ = y := by ring
  have hY'Y : ∀ x' y', Y (X' x') (Y' x' y') = y' := fun x' y' => by
    dsimp only [X, Y, X', Y']
    calc u_inv ^ 3 * ((u ^ 3 * y' + u ^ 2 * s * x' + t) -
          s * ((u ^ 2 * x' + r) - r) - t)
      _ = (u_inv * u) ^ 3 * y' := by ring
      _ = 1 ^ 3 * y' := by rw [huu']
      _ = y' := by ring
  have h_eq_poly : ∀ x y,
      (Y x y) ^ 2 + W₂'.a₁ * (X x) * (Y x y) + W₂'.a₃ * (Y x y) -
        ((X x) ^ 3 + W₂'.a₂ * (X x) ^ 2 + W₂'.a₄ * (X x) + W₂'.a₆) =
      u_inv ^ 6 * (y ^ 2 + W₁'.a₁ * x * y + W₁'.a₃ * y -
        (x ^ 3 + W₁'.a₂ * x ^ 2 + W₁'.a₄ * x + W₁'.a₆)) := fun x y => by
    dsimp only [X, Y]
    rw [ha₁_C, ha₂_C, ha₃_C, ha₄_C, ha₆_C]
    ring
  have h_dx_poly : ∀ x y,
      W₂'.a₁ * (Y x y) - (3 * (X x) ^ 2 + 2 * W₂'.a₂ * (X x) + W₂'.a₄) =
      u_inv ^ 4 * ((W₁'.a₁ * y - (3 * x ^ 2 + 2 * W₁'.a₂ * x + W₁'.a₄)) +
        s * (2 * y + W₁'.a₁ * x + W₁'.a₃)) := fun x y => by
    dsimp only [X, Y]
    rw [ha₁_C, ha₂_C, ha₄_C]
    ring
  have h_dy_poly : ∀ x y,
      2 * (Y x y) + W₂'.a₁ * (X x) + W₂'.a₃ =
      u_inv ^ 3 * (2 * y + W₁'.a₁ * x + W₁'.a₃) := fun x y => by
    dsimp only [X, Y]
    rw [ha₁_C, ha₃_C]
    ring
  have h_nonsing : ∀ x y, W₁'.Nonsingular x y ↔ W₂'.Nonsingular (X x) (Y x y) := by
    intro x y
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.nonsingular_iff',
      WeierstrassCurve.Affine.equation_iff', WeierstrassCurve.Affine.equation_iff',
      h_eq_poly, h_dx_poly, h_dy_poly]
    have hu6 : u_inv ^ 6 ≠ 0 := pow_ne_zero 6 hu_inv
    have hu4 : u_inv ^ 4 ≠ 0 := pow_ne_zero 4 hu_inv
    have hu3 : u_inv ^ 3 ≠ 0 := pow_ne_zero 3 hu_inv
    rw [mul_eq_zero_iff_left hu6, mul_ne_zero_iff_left hu4, mul_ne_zero_iff_left hu3]
    constructor
    · rintro ⟨heq, hdx | hdy⟩
      · refine ⟨heq, ?_⟩
        by_cases hdy' : 2 * y + W₁'.a₁ * x + W₁'.a₃ = 0
        · left
          rw [hdy', mul_zero, add_zero]
          exact hdx
        · right; exact hdy'
      · exact ⟨heq, Or.inr hdy⟩
    · rintro ⟨heq, hdx | hdy⟩
      · refine ⟨heq, ?_⟩
        by_cases hdy' : 2 * y + W₁'.a₁ * x + W₁'.a₃ = 0
        · left
          intro hdx'
          apply hdx
          rw [hdx', hdy', mul_zero, add_zero]
        · right; exact hdy'
      · exact ⟨heq, Or.inr hdy⟩
  have h_nonsing' : ∀ x' y', W₂'.Nonsingular x' y' → W₁'.Nonsingular (X' x') (Y' x' y') := by
    intro x' y' h'
    rw [h_nonsing (X' x') (Y' x' y'), hX'X, hY'Y]
    exact h'
  let toFun : W₁'.Point → W₂'.Point
    | 0 => 0
    | WeierstrassCurve.Affine.Point.some h =>
        WeierstrassCurve.Affine.Point.some ((h_nonsing _ _).mp h)
  let invFun : W₂'.Point → W₁'.Point
    | 0 => 0
    | WeierstrassCurve.Affine.Point.some h' =>
        WeierstrassCurve.Affine.Point.some (h_nonsing' _ _ h')
  have h_left_inv : Function.LeftInverse invFun toFun := by
    rintro (_ | @⟨x, y, h⟩)
    · rfl
    · dsimp only [toFun, invFun]
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨hXX' x, hYY' x y⟩
  have h_right_inv : Function.RightInverse invFun toFun := by
    rintro (_ | @⟨x', y', h'⟩)
    · rfl
    · dsimp only [toFun, invFun]
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨hX'X x', hY'Y x' y'⟩
  have h_negY : ∀ x y, W₂'.negY (X x) (Y x y) = Y x (W₁'.negY x y) := fun x y => by
    dsimp only [WeierstrassCurve.Affine.negY, X, Y]
    rw [ha₁_C, ha₃_C]
    ring
  have h_X_inj : ∀ x₁ x₂, X x₁ = X x₂ ↔ x₁ = x₂ := fun x₁ x₂ => by
    constructor
    · intro h
      have := congrArg X' h
      rwa [hXX', hXX'] at this
    · rintro rfl; rfl
  have h_Y_inj : ∀ x y₁ y₂, Y x y₁ = Y x y₂ ↔ y₁ = y₂ := fun x y₁ y₂ => by
    constructor
    · intro h
      have := congrArg (Y' (X x)) h
      rwa [hYY', hYY'] at this
    · rintro rfl; rfl
  have h_addX : ∀ x₁ x₂ L,
      W₂'.addX (X x₁) (X x₂) (u_inv * (L - s)) = X (W₁'.addX x₁ x₂ L) := fun x₁ x₂ L => by
    dsimp only [WeierstrassCurve.Affine.addX, X]
    rw [ha₁_C, ha₂_C]
    ring
  have h_addY : ∀ x₁ x₂ y₁ L,
      W₂'.addY (X x₁) (X x₂) (Y x₁ y₁) (u_inv * (L - s)) =
        Y (W₁'.addX x₁ x₂ L) (W₁'.addY x₁ x₂ y₁ L) := fun x₁ x₂ y₁ L => by
    dsimp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
      WeierstrassCurve.Affine.negY, WeierstrassCurve.Affine.addX, X, Y]
    rw [ha₁_C, ha₂_C, ha₃_C]
    ring
  have h_div_helper : ∀ (a c : K) (hc : c ≠ 0),
      u_inv ^ 2 * (u_inv * (a - s * c)) / (u_inv ^ 2 * c) = u_inv * (a / c - s) := by
    intro a c hc
    have hu2 : u_inv ^ 2 ≠ 0 := pow_ne_zero 2 hu_inv
    rw [mul_div_mul_left _ _ hu2, div_sub' hc, ← mul_div_assoc]
    congr 1; ring
  have h_div_helper3 : ∀ (a c : K) (hc : c ≠ 0),
      u_inv ^ 3 * (u_inv * (a - s * c)) / (u_inv ^ 3 * c) = u_inv * (a / c - s) := by
    intro a c hc
    have hu3 : u_inv ^ 3 ≠ 0 := pow_ne_zero 3 hu_inv
    rw [mul_div_mul_left _ _ hu3, div_sub' hc, ← mul_div_assoc]
    congr 1; ring
  have h_slope_X_ne : ∀ {x₁ x₂ y₁ y₂ : K} (hx : x₁ ≠ x₂),
      W₂'.slope (X x₁) (X x₂) (Y x₁ y₁) (Y x₂ y₂) =
        u_inv * (W₁'.slope x₁ x₂ y₁ y₂ - s) := by
    intro x₁ x₂ y₁ y₂ hx
    have hx' : X x₁ ≠ X x₂ := mt (h_X_inj x₁ x₂).mp hx
    rw [WeierstrassCurve.Affine.slope_of_X_ne hx', WeierstrassCurve.Affine.slope_of_X_ne hx]
    have hsub : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx
    have hnum : Y x₁ y₁ - Y x₂ y₂ = u_inv ^ 2 * (u_inv * ((y₁ - y₂) - s * (x₁ - x₂))) := by
      dsimp only [Y]; ring
    have hden : X x₁ - X x₂ = u_inv ^ 2 * (x₁ - x₂) := by
      dsimp only [X]; ring
    rw [hnum, hden]
    exact h_div_helper (y₁ - y₂) (x₁ - x₂) hsub
  have h_slope_Y_ne : ∀ {x₁ x₂ y₁ y₂ : K} (hx : x₁ = x₂) (hy : y₁ ≠ W₁'.negY x₂ y₂)
      (hy₁ : y₁ ≠ W₁'.negY x₁ y₁),
      W₂'.slope (X x₁) (X x₂) (Y x₁ y₁) (Y x₂ y₂) =
        u_inv * (W₁'.slope x₁ x₂ y₁ y₂ - s) := by
    intro x₁ x₂ y₁ y₂ hx hy hy₁
    have hx' : X x₁ = X x₂ := congrArg X hx
    have hy' : Y x₁ y₁ ≠ W₂'.negY (X x₂) (Y x₂ y₂) := by
      rw [h_negY, ← hx]
      intro h
      apply hy
      rw [← hx]
      exact (h_Y_inj x₁ y₁ (W₁'.negY x₁ y₂)).mp h
    rw [WeierstrassCurve.Affine.slope_of_Y_ne hx' hy', WeierstrassCurve.Affine.slope_of_Y_ne hx hy]
    have hden_eq : y₁ - W₁'.negY x₁ y₁ = 2 * y₁ + W₁'.a₁ * x₁ + W₁'.a₃ := by
      dsimp only [WeierstrassCurve.Affine.negY]; ring
    have hden_ne : y₁ - W₁'.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy₁
    have hnum : 3 * (X x₁) ^ 2 + 2 * W₂'.a₂ * (X x₁) + W₂'.a₄ - W₂'.a₁ * (Y x₁ y₁) =
        u_inv ^ 3 * (u_inv * ((3 * x₁ ^ 2 + 2 * W₁'.a₂ * x₁ + W₁'.a₄ - W₁'.a₁ * y₁) -
          s * (y₁ - W₁'.negY x₁ y₁))) := by
      have := h_dx_poly x₁ y₁
      rw [← hden_eq] at this
      linear_combination -this
    have hden : Y x₁ y₁ - W₂'.negY (X x₁) (Y x₁ y₁) = u_inv ^ 3 * (y₁ - W₁'.negY x₁ y₁) := by
      rw [h_negY]
      dsimp only [Y]; ring
    rw [hnum, hden]
    exact h_div_helper3 _ _ hden_ne
  have h_map_add : ∀ P Q : W₁'.Point, toFun (P + Q) = toFun P + toFun Q := by
    rintro (_ | @⟨x₁, y₁, h₁⟩) (_ | @⟨x₂, y₂, h₂⟩)
    · change toFun (0 + 0) = toFun 0 + toFun 0
      rw [add_zero, add_zero]
    · change toFun (0 + WeierstrassCurve.Affine.Point.some h₂) =
        0 + toFun (WeierstrassCurve.Affine.Point.some h₂)
      rw [zero_add, zero_add]
    · change toFun (WeierstrassCurve.Affine.Point.some h₁ + 0) =
        toFun (WeierstrassCurve.Affine.Point.some h₁) + 0
      rw [add_zero, add_zero]
    · dsimp only [toFun]
      by_cases hx : x₁ = x₂
      · by_cases hy : y₁ = W₁'.negY x₂ y₂
        · have hx' : X x₁ = X x₂ := congrArg X hx
          have hy' : Y x₁ y₁ = W₂'.negY (X x₂) (Y x₂ y₂) := by
            rw [h_negY, hy, hx]
          rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hx hy,
            WeierstrassCurve.Affine.Point.add_of_Y_eq hx' hy']
        · have hx' : X x₁ = X x₂ := congrArg X hx
          have hy' : Y x₁ y₁ ≠ W₂'.negY (X x₂) (Y x₂ y₂) := by
            rw [h_negY, ← hx]
            intro h
            apply hy
            rw [← hx]
            exact (h_Y_inj x₁ y₁ (W₁'.negY x₁ y₂)).mp h
          have hy_eq : y₁ = y₂ := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂.1 hx hy
          have hy₁ : y₁ ≠ W₁'.negY x₁ y₁ := by
            rw [← hx, ← hy_eq] at hy
            exact hy
          rw [WeierstrassCurve.Affine.Point.add_of_Y_ne hy,
            WeierstrassCurve.Affine.Point.add_of_Y_ne hy']
          dsimp only [toFun]
          rw [WeierstrassCurve.Affine.Point.some.injEq]
          rw [h_slope_Y_ne hx hy hy₁]
          exact ⟨(h_addX x₁ x₂ _).symm, (h_addY x₁ x₂ y₁ _).symm⟩
      · have hx' : X x₁ ≠ X x₂ := mt (h_X_inj x₁ x₂).mp hx
        rw [WeierstrassCurve.Affine.Point.add_of_X_ne hx,
          WeierstrassCurve.Affine.Point.add_of_X_ne hx']
        dsimp only [toFun]
        rw [WeierstrassCurve.Affine.Point.some.injEq]
        rw [h_slope_X_ne hx]
        exact ⟨(h_addX x₁ x₂ _).symm, (h_addY x₁ x₂ y₁ _).symm⟩
  let e_pt : W₁'.Point ≃+ W₂'.Point :=
    { toFun := toFun
      invFun := invFun
      left_inv := h_left_inv
      right_inv := h_right_inv
      map_add' := h_map_add }
  
  let σ : EllipticRootNumber.AbsGal F := (w : EllipticRootNumber.AbsGal F)
  have hσr' : σ r = r := hσr
  have hσs' : σ s = s := hσs
  have hσt' : σ t = t := hσt
  have hσu_inv : σ u_inv = u_inv := by
    have h1 : u * σ u_inv = 1 := by
      calc u * σ u_inv = σ u * σ u_inv := by rw [show σ u = u from hσu]
        _ = σ (u * u_inv) := (map_mul σ u u_inv).symm
        _ = 1 := by rw [huu, map_one]
    calc σ u_inv = (u_inv * u) * σ u_inv := by rw [huu', one_mul]
      _ = u_inv * (u * σ u_inv) := by ring
      _ = u_inv := by rw [h1, mul_one]
  have h_pts : ∀ (k : ℕ) (P : EllipticRootNumber.Pts F E),
      P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)) →
      EllipticRootNumber.galHom F E σ P = P := by
    intro k P hP
    let m : ℕ := EllipticRootNumber.ell F ^ (k + 1)
    have hm : v (m : K) = 1 := by
      change v ((EllipticRootNumber.ell F ^ (k + 1) : ℕ) : K) = 1
      rw [Nat.cast_pow, map_pow, hv_ell, one_pow]
    have hP_m : m • P = 0 := (EllipticRootNumber.mem_torsion F E).mp hP
    have hP' : EllipticRootNumber.galHom F E σ P ∈ EllipticRootNumber.torsion F E m :=
      EllipticRootNumber.galHom_mem_torsion F E σ hP
    have hP'_m : m • EllipticRootNumber.galHom F E σ P = 0 :=
      (EllipticRootNumber.mem_torsion F E).mp hP'
    rcases P with _ | @⟨x, y, h⟩
    · rfl
    · let h_σ : W₁'.Nonsingular (σ x) (σ y) :=
        (WeierstrassCurve.Affine.baseChange_nonsingular x y
          (σ : K →ₐ[F] K).injective).mpr h
      have h_gal_eq : EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h) =
          WeierstrassCurve.Affine.Point.some h_σ :=
        WeierstrassCurve.Affine.Point.map_some (W' := E) (σ : K →ₐ[F] K) h
      let h₁ : W₂'.Nonsingular (X (σ x)) (Y (σ x) (σ y)) := (h_nonsing (σ x) (σ y)).mp h_σ
      let h₂ : W₂'.Nonsingular (X x) (Y x y) := (h_nonsing x y).mp h
      have he₁ : e_pt (EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h)) =
          WeierstrassCurve.Affine.Point.some h₁ := by
        rw [h_gal_eq]; rfl
      have he₂ : e_pt (WeierstrassCurve.Affine.Point.some h) =
          WeierstrassCurve.Affine.Point.some h₂ := rfl
      have hQ₁_m : m • (WeierstrassCurve.Affine.Point.some h₁ : W₂'.Point) = 0 := by
        rw [← he₁, ← map_nsmul, hP'_m, map_zero]
      have hQ₂_m : m • (WeierstrassCurve.Affine.Point.some h₂ : W₂'.Point) = 0 := by
        rw [← he₂, ← map_nsmul, hP_m, map_zero]
      obtain ⟨hx₁, hy₁⟩ :=
        weierstrass_formal_group_torsion_trivial K v W₂'
          hva₁ hva₂ hva₃ hva₄ hva₆ m hm h₁ hQ₁_m
      obtain ⟨hx₂, hy₂⟩ :=
        weierstrass_formal_group_torsion_trivial K v W₂'
          hva₁ hva₂ hva₃ hva₄ hva₆ m hm h₂ hQ₂_m
      have hX_σ : X (σ x) = σ (X x) := by
        dsimp only [X]
        simp only [map_mul, map_pow, map_sub, hσu_inv, hσr']
      have hY_σ : Y (σ x) (σ y) = σ (Y x y) := by
        dsimp only [Y]
        simp only [map_mul, map_pow, map_sub, hσu_inv, hσr', hσs', hσt']
      have hxx : v (X (σ x) - X x) < 1 := by
        rw [hX_σ]
        exact inertia_sub_self_lt_one_of_valuation_le_one F v hv_gal hv_le hv_lt hv_minpoly
          (X x) hx₂ σ hw_in
      have hyy : v (Y (σ x) (σ y) - Y x y) < 1 := by
        rw [hY_σ]
        exact inertia_sub_self_lt_one_of_valuation_le_one F v hv_gal hv_le hv_lt hv_minpoly
          (Y x y) hy₂ σ hw_in
      by_contra h_ne
      have hQ_ne : (WeierstrassCurve.Affine.Point.some h₁ : W₂'.Point) ≠
          WeierstrassCurve.Affine.Point.some h₂ := by
        rw [← he₁, ← he₂]
        exact e_pt.injective.ne h_ne
      rcases hQ_eq : (WeierstrassCurve.Affine.Point.some h₁ : W₂'.Point) -
          WeierstrassCurve.Affine.Point.some h₂ with _ | @⟨x₃, y₃, h₃⟩
      · exact hQ_ne (sub_eq_zero.mp hQ_eq)
      · have hQ₃_m : m • (WeierstrassCurve.Affine.Point.some h₃ : W₂'.Point) = 0 := by
          rw [← hQ_eq, nsmul_sub, hQ₁_m, hQ₂_m, sub_zero]
        obtain ⟨hx₃_le, _⟩ :=
          weierstrass_formal_group_torsion_trivial K v W₂'
            hva₁ hva₂ hva₃ hva₄ hva₆ m hm h₃ hQ₃_m
        have hx₃_gt : 1 < v x₃ :=
          weierstrass_sub_coord_gt_one_of_residue_eq K v W₂'
            hva₁ hva₂ hva₃ hva₄ hva₆ hvΔ h₁ h₂ h₃ hx₁ hy₁ hx₂ hy₂ hxx hyy hQ_eq
        exact not_lt_of_ge hx₃_le hx₃_gt
  have htate : EllipticRootNumber.tateRep F E σ = 1 := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext k
    apply Subtype.ext
    exact h_pts k (x.1 k).1 (x.1 k).2
  change LinearMap.baseChange (EllipticRootNumber.Ω F)
    (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F]
      (EllipticRootNumber.tateRep F E σ)) = 1
  rw [htate, Module.End.one_eq_id, LinearMap.baseChange_id, LinearMap.baseChange_id]
  rfl

theorem ellAdicRep_kummer_generator_pow_ne_self (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (n : ℕ)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hΔ : EllipticRootNumber.addVal F E.Δ = (n : ℤ))
    (hc₄ : ValuativeRel.valuation F E.c₄ < 1)
    (hj : EllipticRootNumber.IsPotentiallyGood F E)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1))
    (π : F) (ϖ : AlgebraicClosure F)
    (τ₀ : EllipticRootNumber.relWeil F ⊥) (ζ : F)
    (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hϖ_ne : ϖ ≠ 0) (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hτ₀_in : (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (hζ_ord : ∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 → ζ ^ d ≠ 1)
    (hτ₀_ϖ : (τ₀ : EllipticRootNumber.AbsGal F) ϖ = algebraMap F (AlgebraicClosure F) ζ * ϖ)
    (d : ℕ) (hd_dvd : d ∣ (12 / Nat.gcd n 12)) (hd_lt : d < 12 / Nat.gcd n 12)
    (v : EllipticRootNumber.VBar F E) (hv : v ≠ 0) :
    ((((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) τ₀) ^ d) v ≠ v :=
by
  classical
  set σ : EllipticRootNumber.AbsGal F := (τ₀ : EllipticRootNumber.AbsGal F) ^ d
  have hσ_in : σ ∈ EllipticRootNumber.inertia F :=
    Subgroup.pow_mem (EllipticRootNumber.inertia F) hτ₀_in d
  have h_rep_pow :
      ((((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) τ₀) ^ d) =
        EllipticRootNumber.ellAdicRep F E σ := by
    rw [← map_pow]
    rfl
  rw [h_rep_pow]
  
