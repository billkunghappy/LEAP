  have hD_eq : ∀ u v, D u = D v ↔ ∃ c : (AlgebraicClosure F)ˣ, u = ι_u c * v := by
    intro u v
    rw [Units.ext_iff, hD_val, hD_val, h_span_eq u v]
    refine exists_congr fun c => ?_
    rw [Units.ext_iff, Units.val_mul, hι_u_val]
  have hD_ℓ : ∀ A B S : EllipticRootNumber.Pts F E,
      D (τ_u S (ℓ_step A B)) = I (A - S) * I (B - S) * (I (A + B - S))⁻¹ * (I (-S))⁻¹ := by
    intro A B S
    apply Units.ext
    rw [hD_val, hτ_u_val]
