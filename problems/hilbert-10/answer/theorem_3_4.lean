      have ht2x : t ^ 2 * x' = 1 + W₂.a₁ * t := by
        calc t ^ 2 * x' = t ^ 2 * (t * y') := by rw [hxt]
          _ = t ^ 3 * y' := by ring
          _ = 1 + W₂.a₁ * t := ht3y
      exact ⟨hx', hy', ht, h1at, ht2x, ht3y⟩
    have h_add_xy : ∀ {x₁ x₂ y₁ L t₁ t₂ : K},
        t₁ ^ 2 * x₁ = 1 + W₂.a₁ * t₁ → t₁ ^ 3 * y₁ = 1 + W₂.a₁ * t₁ →
        t₂ ^ 2 * x₂ = 1 + W₂.a₁ * t₂ →
        L * t₁ * t₂ * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) =
          t₁ ^ 2 + t₁ * t₂ + t₂ ^ 2 + W₂.a₁ * t₁ * t₂ * (t₁ + t₂) →
        t₁ ^ 3 * t₂ ^ 3 * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) ^ 2 *
          (W₂.addX x₁ x₂ L - (t₁ + t₂ + W₂.a₁ * t₁ * t₂) * W₂.addY x₁ x₂ y₁ L) = 0 := by
      intro x₁ x₂ y₁ L t₁ t₂ ht2x₁ ht3y₁ ht2x₂ hL_t
      set S := t₁ + t₂ + W₂.a₁ * t₁ * t₂
      have h_id : t₁ ^ 3 * t₂ ^ 3 * S ^ 2 * (W₂.addX x₁ x₂ L - S * W₂.addY x₁ x₂ y₁ L) =
          ((L * t₁ * t₂ * S) ^ 2 + W₂.a₁ * t₁ * t₂ * S * (L * t₁ * t₂ * S) -
            t₂ ^ 2 * S ^ 2 * (t₁ ^ 2 * x₁) - t₁ ^ 2 * S ^ 2 * (t₂ ^ 2 * x₂)) *
            (t₁ * t₂ + (L * t₁ * t₂ * S) + W₂.a₁ * t₁ * t₂ * S) -
          t₂ ^ 2 * S ^ 2 * (t₁ ^ 2 * x₁) * (L * t₁ * t₂ * S) +
          t₂ ^ 3 * S ^ 3 * (t₁ ^ 3 * y₁) := by
        dsimp only [WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.addY,
          WeierstrassCurve.Affine.negAddY, WeierstrassCurve.Affine.negY]
        rw [ha₂, ha₃]
        ring
      rw [h_id, hL_t, ht2x₁, ht3y₁, ht2x₂]
      dsimp only [S]
      ring
    let τ : W₂.Point → K
      | 0 => 0
      | @WeierstrassCurve.Affine.Point.some _ _ _ x' y' _ => x' / y'
    have hτ_add : ∀ P₁ P₂ : W₂.Point, τ (P₁ + P₂) = τ P₁ + τ P₂ + W₂.a₁ * τ P₁ * τ P₂ := by
      rintro (_ | @⟨x₁, y₁, h₁⟩) (_ | @⟨x₂, y₂, h₂⟩)
      · change τ (0 + 0) = τ 0 + τ 0 + W₂.a₁ * τ 0 * τ 0
        rw [add_zero]
        dsimp only [τ]
        ring
      · change τ (0 + WeierstrassCurve.Affine.Point.some h₂) =
          τ 0 + τ (WeierstrassCurve.Affine.Point.some h₂) +
            W₂.a₁ * τ 0 * τ (WeierstrassCurve.Affine.Point.some h₂)
        rw [zero_add]
        dsimp only [τ]
        ring
      · change τ (WeierstrassCurve.Affine.Point.some h₁ + 0) =
          τ (WeierstrassCurve.Affine.Point.some h₁) + τ 0 +
            W₂.a₁ * τ (WeierstrassCurve.Affine.Point.some h₁) * τ 0
        rw [add_zero]
        dsimp only [τ]
        ring
      · obtain ⟨hx₁, hy₁, ht₁, h1at₁, ht2x₁, ht3y₁⟩ := h_coords h₁
        obtain ⟨hx₂, hy₂, ht₂, h1at₂, ht2x₂, ht3y₂⟩ := h_coords h₂
        set t₁ := x₁ / y₁
        set t₂ := x₂ / y₂
        by_cases hx : x₁ = x₂
        · by_cases hy : y₁ = W₂.negY x₂ y₂
          · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hx hy]
            dsimp only [τ, WeierstrassCurve.Affine.negY] at hy ⊢
            rw [ha₃] at hy
            have hxt₁ : x₁ = t₁ * y₁ := (div_mul_cancel₀ x₁ hy₁).symm
            have hxt₂ : x₂ = t₂ * y₂ := (div_mul_cancel₀ x₂ hy₂).symm
            have hprod : y₁ * y₂ * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) = 0 := by
              calc y₁ * y₂ * (t₁ + t₂ + W₂.a₁ * t₁ * t₂)
                _ = y₁ * (t₂ * y₂) + y₂ * (t₁ * y₁) + W₂.a₁ * (t₁ * y₁) * (t₂ * y₂) := by ring
                _ = y₁ * x₂ + y₂ * x₁ + W₂.a₁ * x₁ * x₂ := by rw [← hxt₁, ← hxt₂]
                _ = x₂ * (y₁ - (-y₂ - W₂.a₁ * x₂ - 0)) := by rw [hx]; ring
                _ = 0 := by rw [hy, sub_self, mul_zero]
            have hy12 : y₁ * y₂ ≠ 0 := mul_ne_zero hy₁ hy₂
            exact ((mul_eq_zero.mp hprod).resolve_left hy12).symm
          · have hy_eq : y₁ = y₂ := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂.1 hx hy
            have ht_eq : t₁ = t₂ := by dsimp only [t₁, t₂]; rw [hx, hy_eq]
            have hy₁' : y₁ ≠ W₂.negY x₁ y₁ := by rwa [← hx, ← hy_eq] at hy
            rw [WeierstrassCurve.Affine.Point.add_of_Y_ne hy]
            have h₃ := WeierstrassCurve.Affine.nonsingular_add h₁ h₂ (fun hxy => hy hxy.2)
            have hy₃_ne : W₂.addY x₁ x₂ y₁ (W₂.slope x₁ x₂ y₁ y₂) ≠ 0 := (h_coords h₃).2.1
            change W₂.addX x₁ x₂ (W₂.slope x₁ x₂ y₁ y₂) / W₂.addY x₁ x₂ y₁ (W₂.slope x₁ x₂ y₁ y₂) =
              t₁ + t₂ + W₂.a₁ * t₁ * t₂
            rw [div_eq_iff hy₃_ne, ← sub_eq_zero]
            set L := W₂.slope x₁ x₂ y₁ y₂
            have hden_ne : y₁ - W₂.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy₁'
            have hL_def : L = (3 * x₁ ^ 2 + 2 * W₂.a₂ * x₁ + W₂.a₄ - W₂.a₁ * y₁) / (y₁ - W₂.negY x₁ y₁) :=
              WeierstrassCurve.Affine.slope_of_Y_ne hx hy
            have hL_mul : L * (y₁ - W₂.negY x₁ y₁) = 3 * x₁ ^ 2 + 2 * W₂.a₂ * x₁ + W₂.a₄ - W₂.a₁ * y₁ := by
              rw [hL_def, div_mul_cancel₀ _ hden_ne]
            have hL_id : (1 + W₂.a₁ * t₁) * (L * t₁ * (2 + W₂.a₁ * t₁) - (3 + 2 * W₂.a₁ * t₁)) = 0 := by
              have h_step : t₁ ^ 4 * (L * (y₁ - W₂.negY x₁ y₁) -
                    (3 * x₁ ^ 2 + 2 * W₂.a₂ * x₁ + W₂.a₄ - W₂.a₁ * y₁)) =
                  L * t₁ * (2 * (t₁ ^ 3 * y₁) + W₂.a₁ * t₁ * (t₁ ^ 2 * x₁)) -
                    (3 * (t₁ ^ 2 * x₁) ^ 2 - W₂.a₁ * t₁ * (t₁ ^ 3 * y₁)) := by
                dsimp only [WeierstrassCurve.Affine.negY]
                rw [ha₂, ha₃, ha₄]
                ring
              rw [hL_mul, sub_self, mul_zero, ht2x₁, ht3y₁] at h_step
              linear_combination -h_step
            have hL_t1 : L * t₁ * (2 + W₂.a₁ * t₁) = 3 + 2 * W₂.a₁ * t₁ :=
              sub_eq_zero.mp ((mul_eq_zero.mp hL_id).resolve_left h1at₁)
            have hL_t : L * t₁ * t₂ * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) =
                t₁ ^ 2 + t₁ * t₂ + t₂ ^ 2 + W₂.a₁ * t₁ * t₂ * (t₁ + t₂) := by
              rw [← ht_eq]
              linear_combination t₁ ^ 2 * hL_t1
            have hS_ne : t₁ + t₂ + W₂.a₁ * t₁ * t₂ ≠ 0 := by
              rw [← ht_eq]
              have hden_id : t₁ ^ 4 * (y₁ - W₂.negY x₁ y₁) =
                  (1 + W₂.a₁ * t₁) * (t₁ + t₁ + W₂.a₁ * t₁ * t₁) := by
                calc t₁ ^ 4 * (y₁ - W₂.negY x₁ y₁)
                  _ = t₁ * (2 * (t₁ ^ 3 * y₁) + W₂.a₁ * t₁ * (t₁ ^ 2 * x₁)) := by
                    dsimp only [WeierstrassCurve.Affine.negY]
                    rw [ha₃]
                    ring
                  _ = t₁ * (2 * (1 + W₂.a₁ * t₁) + W₂.a₁ * t₁ * (1 + W₂.a₁ * t₁)) := by rw [ht2x₁, ht3y₁]
                  _ = (1 + W₂.a₁ * t₁) * (t₁ + t₁ + W₂.a₁ * t₁ * t₁) := by ring
              intro hS0
              apply mul_ne_zero (pow_ne_zero 4 ht₁) hden_ne
              rw [hden_id, hS0, mul_zero]
            have h_zero := h_add_xy ht2x₁ ht3y₁ ht2x₂ hL_t
            have h_coeff_ne : t₁ ^ 3 * t₂ ^ 3 * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) ^ 2 ≠ 0 :=
              mul_ne_zero (mul_ne_zero (pow_ne_zero 3 ht₁) (pow_ne_zero 3 ht₂)) (pow_ne_zero 2 hS_ne)
            exact (mul_eq_zero.mp h_zero).resolve_left h_coeff_ne
        · rw [WeierstrassCurve.Affine.Point.add_of_X_ne hx]
          have h₃ := WeierstrassCurve.Affine.nonsingular_add h₁ h₂ (fun hxy => hx hxy.1)
          have hy₃_ne : W₂.addY x₁ x₂ y₁ (W₂.slope x₁ x₂ y₁ y₂) ≠ 0 := (h_coords h₃).2.1
          change W₂.addX x₁ x₂ (W₂.slope x₁ x₂ y₁ y₂) / W₂.addY x₁ x₂ y₁ (W₂.slope x₁ x₂ y₁ y₂) =
            t₁ + t₂ + W₂.a₁ * t₁ * t₂
          rw [div_eq_iff hy₃_ne, ← sub_eq_zero]
          set L := W₂.slope x₁ x₂ y₁ y₂
          have hden_ne : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx
          have hL_def : L = (y₁ - y₂) / (x₁ - x₂) := WeierstrassCurve.Affine.slope_of_X_ne hx
          have hL_mul : L * (x₁ - x₂) = y₁ - y₂ := by rw [hL_def, div_mul_cancel₀ _ hden_ne]
          have hx_fac : t₁ ^ 2 * t₂ ^ 2 * (x₁ - x₂) = -(t₁ - t₂) * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) := by
            calc t₁ ^ 2 * t₂ ^ 2 * (x₁ - x₂)
              _ = t₂ ^ 2 * (t₁ ^ 2 * x₁) - t₁ ^ 2 * (t₂ ^ 2 * x₂) := by ring
              _ = t₂ ^ 2 * (1 + W₂.a₁ * t₁) - t₁ ^ 2 * (1 + W₂.a₁ * t₂) := by rw [ht2x₁, ht2x₂]
              _ = -(t₁ - t₂) * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) := by ring
          have h_prod_ne : -(t₁ - t₂) * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) ≠ 0 := by
            rw [← hx_fac]
            exact mul_ne_zero (mul_ne_zero (pow_ne_zero 2 ht₁) (pow_ne_zero 2 ht₂)) hden_ne
          have h_t12_ne : -(t₁ - t₂) ≠ 0 := left_ne_zero_of_mul h_prod_ne
          have hS_ne : t₁ + t₂ + W₂.a₁ * t₁ * t₂ ≠ 0 := right_ne_zero_of_mul h_prod_ne
          have hL_id : -(t₁ - t₂) * (L * t₁ * t₂ * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) -
              (t₁ ^ 2 + t₁ * t₂ + t₂ ^ 2 + W₂.a₁ * t₁ * t₂ * (t₁ + t₂))) = 0 := by
            have h_step : t₁ ^ 3 * t₂ ^ 3 * (L * (x₁ - x₂) - (y₁ - y₂)) =
                L * t₁ * t₂ * (t₂ ^ 2 * (t₁ ^ 2 * x₁) - t₁ ^ 2 * (t₂ ^ 2 * x₂)) -
                  (t₂ ^ 3 * (t₁ ^ 3 * y₁) - t₁ ^ 3 * (t₂ ^ 3 * y₂)) := by ring
            rw [hL_mul, sub_self, mul_zero, ht2x₁, ht2x₂, ht3y₁, ht3y₂] at h_step
            linear_combination -h_step
          have hL_t : L * t₁ * t₂ * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) =
              t₁ ^ 2 + t₁ * t₂ + t₂ ^ 2 + W₂.a₁ * t₁ * t₂ * (t₁ + t₂) :=
            sub_eq_zero.mp ((mul_eq_zero.mp hL_id).resolve_left h_t12_ne)
          have h_zero := h_add_xy ht2x₁ ht3y₁ ht2x₂ hL_t
          have h_coeff_ne : t₁ ^ 3 * t₂ ^ 3 * (t₁ + t₂ + W₂.a₁ * t₁ * t₂) ^ 2 ≠ 0 :=
            mul_ne_zero (mul_ne_zero (pow_ne_zero 3 ht₁) (pow_ne_zero 3 ht₂)) (pow_ne_zero 2 hS_ne)
          exact (mul_eq_zero.mp h_zero).resolve_left h_coeff_ne
    have hτ_nsmul_zero : W₂.a₁ = 0 → ∀ (k : ℕ) (Q : W₂.Point), τ (k • Q) = (k : K) * τ Q := by
      intro ha₁0 k Q
      induction k with
      | zero =>
        rw [zero_nsmul, Nat.cast_zero, zero_mul]
      | succ k ih =>
        rw [succ_nsmul, hτ_add, ih, ha₁0, Nat.cast_add, Nat.cast_one]
        ring
    have hτ_nsmul_mul : ∀ (k : ℕ) (Q : W₂.Point),
        1 + W₂.a₁ * τ (k • Q) = (1 + W₂.a₁ * τ Q) ^ k := by
      intro k Q
      induction k with
      | zero =>
        rw [zero_nsmul, pow_zero]
        dsimp only [τ]
        ring
      | succ k ih =>
        rw [succ_nsmul, hτ_add, pow_succ, ← ih]
        ring
    obtain ⟨hx0, hy0, ht0, h1at0, ht2x, ht3y⟩ := h_coords h
    set P₀ : W₂.Point := WeierstrassCurve.Affine.Point.some h
    have ha₁_ne : W₂.a₁ ≠ 0 := by
      intro ha₁0
      have hm0 := hτ_nsmul_zero ha₁0 m P₀
      rw [hP'] at hm0
      change (0 : K) = (m : K) * (x / y) at hm0
      exact (mul_eq_zero.mp hm0.symm).elim hm ht0
    let ζ : K := 1 + W₂.a₁ * (x / y)
    have hζ_pow : ζ ^ m = 1 := by
      have hm1 := (hτ_nsmul_mul m P₀).symm
      rw [hP'] at hm1
      change ζ ^ m = 1 + W₂.a₁ * 0 at hm1
      linear_combination hm1
    have hζ_sub : ζ - 1 = W₂.a₁ * (x / y) := by
      dsimp only [ζ]; ring
    have hζ_ne : ζ - 1 ≠ 0 := by
      rw [hζ_sub]
      exact mul_ne_zero ha₁_ne ht0
    refine ⟨ζ, hζ_pow, hζ_ne, ?_, ?_⟩
    · rw [eq_div_iff (pow_ne_zero 2 hζ_ne), hζ_sub]
      calc x * (W₂.a₁ * (x / y)) ^ 2 = W₂.a₁ ^ 2 * ((x / y) ^ 2 * x) := by ring
        _ = W₂.a₁ ^ 2 * ζ := by rw [ht2x]
    · rw [eq_div_iff (pow_ne_zero 3 hζ_ne), hζ_sub]
      calc y * (W₂.a₁ * (x / y)) ^ 3 = W₂.a₁ ^ 3 * ((x / y) ^ 3 * y) := by ring
        _ = W₂.a₁ ^ 3 * ζ := by rw [ht3y]
  let K := AlgebraicClosure F
  let W : WeierstrassCurve K := E.baseChange K
  have hWΔ : W.Δ = 0 := by
    change (E.map (algebraMap F K)).Δ = 0
    rw [WeierstrassCurve.map_Δ, hΔ, map_zero]
  obtain ⟨r₀, s₀, t₀, ha₂, ha₃, ha₄, ha₆⟩ := h_s1 K W hWΔ
  let C₀ : WeierstrassCurve.VariableChange K := { u := 1, r := r₀, s := s₀, t := t₀ }
  let W₁ : WeierstrassCurve.Affine K := W.toAffine
  let W₂ : WeierstrassCurve.Affine K := (C₀ • W).toAffine
  let S : Set K := {r₀, s₀, t₀}
  let L : IntermediateField F K := IntermediateField.adjoin F S
  have hS_fin : S.Finite := ((Set.finite_singleton t₀).insert s₀).insert r₀
  haveI : Finite S := hS_fin.to_subtype
  have hL_fin : FiniteDimensional F L :=
    IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  refine ⟨L, hL_fin, ?_⟩
  intro σ hσL hσI n P hP
  have hr₀_mem : r₀ ∈ L := IntermediateField.subset_adjoin F S (by simp [S])
  have hs₀_mem : s₀ ∈ L := IntermediateField.subset_adjoin F S (by simp [S])
  have ht₀_mem : t₀ ∈ L := IntermediateField.subset_adjoin F S (by simp [S])
  have hσr₀ : σ r₀ = r₀ := hσL ⟨r₀, hr₀_mem⟩
  have hσs₀ : σ s₀ = s₀ := hσL ⟨s₀, hs₀_mem⟩
  have hσt₀ : σ t₀ = t₀ := hσL ⟨t₀, ht₀_mem⟩
  have hσa₁ : σ W₂.a₁ = W₂.a₁ := by
    have ha₁_c : W₂.a₁ = algebraMap F K E.a₁ + 2 * s₀ := by
      change (C₀ • W).a₁ = W.a₁ + 2 * s₀
      rw [WeierstrassCurve.variableChange_a₁]
      dsimp only [C₀]
      rw [inv_one, Units.val_one, one_mul]
    rw [ha₁_c, map_add, map_mul, map_ofNat, AlgEquiv.commutes σ E.a₁, hσs₀]
  obtain ⟨e, he_some⟩ := h_s3 K W r₀ s₀ t₀
  set m := EllipticRootNumber.ell F ^ (n + 1)
  let OF := (ValuativeRel.valuation F).valuationSubring
  let kF := IsLocalRing.ResidueField OF
  have hm_pos : 0 < m := pow_pos (EllipticRootNumber.ell_prime F).out.pos (n + 1)
  have hp_ndvd : ¬ EllipticRootNumber.p F ∣ m := by
    intro hdvd
    haveI : CharP kF (EllipticRootNumber.p F) := ringChar.of_eq rfl
    rcases CharP.char_is_prime_or_zero kF (EllipticRootNumber.p F) with hp | hp0
    · have hdvd_ell : EllipticRootNumber.p F ∣ EllipticRootNumber.ell F :=
        hp.dvd_of_dvd_pow hdvd
      have heq_p : EllipticRootNumber.p F = EllipticRootNumber.ell F :=
        ((Nat.Prime.dvd_iff_eq (EllipticRootNumber.ell_prime F).out hp.ne_one).mp hdvd_ell).symm
      exact EllipticRootNumber.ell_ne_p F heq_p.symm
    · rw [hp0, zero_dvd_iff] at hdvd
      exact hm_pos.ne' hdvd
  have hm_ne : (m : K) ≠ 0 := by
    intro hm0
    have hmF : (m : F) = 0 := by
      apply (algebraMap F K).injective
      rw [map_natCast, hm0, map_zero]
    have hmO : (m : OF) = 0 := by
      apply Subtype.ext
      exact hmF
    have hmk : (m : kF) = 0 := by
      rw [← map_natCast (IsLocalRing.residue OF) m, hmO, map_zero]
    exact hp_ndvd ((ringChar.spec kF m).mp hmk)
  rcases P with _ | @⟨x, y, h⟩
  · exact map_zero (EllipticRootNumber.galHom F E σ)
  · obtain ⟨h', heP⟩ := he_some h
    have hmP : m • (WeierstrassCurve.Affine.Point.some h : W₁.Point) = 0 :=
      (EllipticRootNumber.mem_torsion F E).mp hP
    have hmP' : m • (WeierstrassCurve.Affine.Point.some h' : W₂.Point) = 0 := by
      rw [← heP, ← map_nsmul, hmP, map_zero]
    obtain ⟨ζ, hζ_pow, hζ_ne, hx'_eq, hy'_eq⟩ := h_s2 K W₂ ha₂ ha₃ ha₄ ha₆ m hm_ne h' hmP'
    have hζ_p : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ := ⟨m, hm_pos, hp_ndvd, hζ_pow⟩
    have hζ_mem : ζ ∈ EllipticRootNumber.unramifiedClosure F :=
      IntermediateField.subset_adjoin F {z | EllipticRootNumber.IsPrimeToPRootOfUnity F z} hζ_p
    have hσζ : σ ζ = ζ := hσI ⟨ζ, hζ_mem⟩
    have hσX : σ (x - r₀) = x - r₀ := by
      rw [hx'_eq]
      simp only [map_div₀, map_mul, map_pow, map_sub, map_one, hσa₁, hσζ]
    have hσY : σ (y - s₀ * (x - r₀) - t₀) = y - s₀ * (x - r₀) - t₀ := by
      rw [hy'_eq]
      simp only [map_div₀, map_mul, map_pow, map_sub, map_one, hσa₁, hσζ]
    have hσx : σ x = x := by
      have hx_id : x = (x - r₀) + r₀ := by ring
      conv_lhs => rw [hx_id]
      rw [map_add, hσX, hσr₀, ← hx_id]
    have hσy : σ y = y := by
      have hy_id : y = (y - s₀ * (x - r₀) - t₀) + s₀ * (x - r₀) + t₀ := by ring
      conv_lhs => rw [hy_id]
      rw [map_add, map_add, map_mul, hσY, hσs₀, hσX, hσt₀, ← hy_id]
    change WeierstrassCurve.Affine.Point.map (W' := E) (σ : K →ₐ[F] K)
        (WeierstrassCurve.Affine.Point.some h) =
      WeierstrassCurve.Affine.Point.some h
    rw [WeierstrassCurve.Affine.Point.map_some, WeierstrassCurve.Affine.Point.some.injEq]
    exact ⟨hσx, hσy⟩

theorem exists_galois_invariant_valuation_extension (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    ∃ v : Valuation (AlgebraicClosure F) NNReal,
      (∀ (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F), v (σ z) = v z) ∧
      (∀ c : F, v (algebraMap F (AlgebraicClosure F) c) ≤ 1 ↔ ValuativeRel.valuation F c ≤ 1) ∧
      (∀ c : F, v (algebraMap F (AlgebraicClosure F) c) < 1 ↔ ValuativeRel.valuation F c < 1) ∧
      (∀ c : F, v (algebraMap F (AlgebraicClosure F) c) = 1 ↔ ValuativeRel.valuation F c = 1) ∧
      (∀ z : AlgebraicClosure F, v z ≤ 1 →
        ∀ n : ℕ, ValuativeRel.valuation F ((minpoly F z).coeff n) ≤ 1) ∧
      v (EllipticRootNumber.ell F : AlgebraicClosure F) = 1 :=
by
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  letI : Valued F (ValuativeRel.ValueGroupWithZero F) :=
    IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
  haveI : (Valued.v : Valuation F (ValuativeRel.ValueGroupWithZero F)).RankOne :=
    Valuation.RankOne.ofRankLeOneStruct (Classical.choice ValuativeRel.IsRankLeOne.nonempty)
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F :=
    IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
      (Valued.isNonarchimedean_norm F (ValuativeRel.ValueGroupWithZero F))
  haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
  letI : NormedField (AlgebraicClosure F) := spectralNorm.normedField F (AlgebraicClosure F)
  haveI : IsUltrametricDist (AlgebraicClosure F) :=
    IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
      (isNonarchimedean_spectralNorm (K := F) (L := AlgebraicClosure F))
  let v : Valuation (AlgebraicClosure F) NNReal := NormedField.valuation
  have hv_coe : ∀ z : AlgebraicClosure F, (v z : ℝ) = spectralNorm F (AlgebraicClosure F) z := by
    intro z
    rfl
  have hv_gal : ∀ (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F), v (σ z) = v z := by
    intro σ z
    rw [← NNReal.coe_inj, hv_coe, hv_coe]
    unfold spectralNorm
    rw [minpoly.algEquiv_eq σ z]
  have hv_le : ∀ c : F, v (algebraMap F (AlgebraicClosure F) c) ≤ 1 ↔ ValuativeRel.valuation F c ≤ 1 := by
    intro c
    rw [← NNReal.coe_le_coe, NNReal.coe_one, hv_coe, spectralNorm_extends,
      Valued.toNormedField.norm_le_one_iff]
    rfl
  have hv_lt : ∀ c : F, v (algebraMap F (AlgebraicClosure F) c) < 1 ↔ ValuativeRel.valuation F c < 1 := by
    intro c
    rw [← NNReal.coe_lt_coe, NNReal.coe_one, hv_coe, spectralNorm_extends,
      Valued.toNormedField.norm_lt_one_iff]
    rfl
  have hv_eq : ∀ c : F, v (algebraMap F (AlgebraicClosure F) c) = 1 ↔ ValuativeRel.valuation F c = 1 := by
    intro c
    have h1 : v (algebraMap F (AlgebraicClosure F) c) = 1 ↔
        v (algebraMap F (AlgebraicClosure F) c) ≤ 1 ∧ ¬ v (algebraMap F (AlgebraicClosure F) c) < 1 := by
      rw [le_antisymm_iff, not_lt]
    have h2 : ValuativeRel.valuation F c = 1 ↔
        ValuativeRel.valuation F c ≤ 1 ∧ ¬ ValuativeRel.valuation F c < 1 := by
      rw [le_antisymm_iff, not_lt]
    rw [h1, h2, hv_le, hv_lt]
  have hv_minpoly : ∀ z : AlgebraicClosure F, v z ≤ 1 →
      ∀ n : ℕ, ValuativeRel.valuation F ((minpoly F z).coeff n) ≤ 1 := by
    intro z hz n
    have hz' : spectralValue (minpoly F z) ≤ 1 := by
      change (v z : ℝ) ≤ (1 : NNReal)
      exact NNReal.coe_le_coe.mpr hz
    have h_monic : (minpoly F z).Monic := minpoly.monic (Algebra.IsIntegral.isIntegral z)
    have h_coeff : ‖(minpoly F z).coeff n‖ ≤ 1 := (spectralValue_le_one_iff h_monic).mp hz' n
    exact Valued.toNormedField.norm_le_one_iff.mp h_coeff
  have hv_ell : v (EllipticRootNumber.ell F : AlgebraicClosure F) = 1 := by
    rw [← map_natCast (algebraMap F (AlgebraicClosure F)) (EllipticRootNumber.ell F), hv_eq]
    have h_le : ValuativeRel.valuation F (EllipticRootNumber.ell F : F) ≤ 1 := by
      rw [← Valuation.mem_valuationSubring_iff]
      exact natCast_mem (ValuativeRel.valuation F).valuationSubring (EllipticRootNumber.ell F)
    have h_not_lt : ¬ ValuativeRel.valuation F (EllipticRootNumber.ell F : F) < 1 := by
      intro h_lt
      have h_mem : (EllipticRootNumber.ell F : (ValuativeRel.valuation F).valuationSubring) ∈
          IsLocalRing.maximalIdeal (ValuativeRel.valuation F).valuationSubring :=
        (Valuation.mem_maximalIdeal_iff _ _).mpr h_lt
      have h_res : IsLocalRing.residue (ValuativeRel.valuation F).valuationSubring
          (EllipticRootNumber.ell F : (ValuativeRel.valuation F).valuationSubring) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr h_mem
      rw [map_natCast] at h_res
      have h_dvd : EllipticRootNumber.p F ∣ EllipticRootNumber.ell F :=
        (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer)
          (EllipticRootNumber.ell F)).mp h_res
      have hp : (EllipticRootNumber.p F).Prime :=
        CharP.char_is_prime (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer)
          (EllipticRootNumber.p F)
      have h_eq : EllipticRootNumber.p F = EllipticRootNumber.ell F :=
        ((Nat.Prime.dvd_iff_eq (EllipticRootNumber.ell_prime F).out hp.ne_one).mp h_dvd).symm
      exact EllipticRootNumber.ell_ne_p F h_eq.symm
    exact le_antisymm h_le (not_lt.mp h_not_lt)
  exact ⟨v, hv_gal, hv_le, hv_lt, hv_eq, hv_minpoly, hv_ell⟩

theorem inertia_sub_self_lt_one_of_valuation_le_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (v : Valuation (AlgebraicClosure F) NNReal)
    (hv_gal : ∀ (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F), v (σ z) = v z)
    (hv_le : ∀ c : F, v (algebraMap F (AlgebraicClosure F) c) ≤ 1 ↔ ValuativeRel.valuation F c ≤ 1)
    (hv_lt : ∀ c : F, v (algebraMap F (AlgebraicClosure F) c) < 1 ↔ ValuativeRel.valuation F c < 1)
    (hv_minpoly : ∀ z : AlgebraicClosure F, v z ≤ 1 →
      ∀ n : ℕ, ValuativeRel.valuation F ((minpoly F z).coeff n) ≤ 1)
    (z : AlgebraicClosure F) (hz : v z ≤ 1)
    (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.inertia F) :
    v (σ z - z) < 1 :=
by
  classical
  open scoped ValuativeRel in
  by_cases hz_lt : v z < 1
  · calc v (σ z - z)
      _ ≤ max (v (σ z)) (v z) := Valuation.map_sub v (σ z) z
      _ = max (v z) (v z) := by rw [hv_gal σ z]
      _ = v z := max_self (v z)
      _ < 1 := hz_lt
  · have h_res_order : ∀ (L : Type u) [Field L] [Algebra 𝓀[F] L] (zbar : L),
        IsIntegral 𝓀[F] zbar → zbar ≠ 0 →
        ∃ m : ℕ, 0 < m ∧ ¬ EllipticRootNumber.p F ∣ m ∧ zbar ^ m = 1 := by
      intro L _ _ zbar hzbar_int hzbar_ne
      let E₀ : IntermediateField 𝓀[F] L := IntermediateField.adjoin 𝓀[F] {zbar}
      haveI : FiniteDimensional 𝓀[F] ↥E₀ :=
        IntermediateField.adjoin.finiteDimensional hzbar_int
      haveI : Finite ↥E₀ := Module.finite_of_finite 𝓀[F]
      letI : Fintype ↥E₀ := Fintype.ofFinite ↥E₀
      let p : ℕ := EllipticRootNumber.p F
      haveI : CharP 𝓀[F] p := ringChar.charP 𝓀[F]
      haveI : CharP ↥E₀ p :=
        (RingHom.charP_iff_charP (algebraMap 𝓀[F] ↥E₀) p).mp (inferInstance : CharP 𝓀[F] p)
      obtain ⟨r, hp, hcard⟩ := FiniteField.card ↥E₀ p
      let m : ℕ := Fintype.card ↥E₀ - 1
      have hcard_gt : 1 < Fintype.card ↥E₀ := by
        rw [hcard]
        exact one_lt_pow₀ hp.one_lt r.ne_zero
      have hm_pos : 0 < m := by omega
      have hm_add : m + 1 = p ^ (r : ℕ) := by omega
      have hm_ndvd : ¬ p ∣ m := by
        intro hdvd
        have hdvd_pow : p ∣ p ^ (r : ℕ) := dvd_pow_self p r.ne_zero
        rw [← hm_add] at hdvd_pow
        have hdvd1 : p ∣ 1 := (Nat.dvd_add_right hdvd).mp hdvd_pow
        exact hp.not_dvd_one hdvd1
      let w : ↥E₀ := ⟨zbar, IntermediateField.mem_adjoin_simple_self 𝓀[F] zbar⟩
      have hw_ne : w ≠ 0 := by
        intro hw0
        exact hzbar_ne (congrArg Subtype.val hw0)
      have hw_pow : w ^ m = 1 := FiniteField.pow_card_sub_one_eq_one w hw_ne
      exact ⟨m, hm_pos, hm_ndvd, congrArg Subtype.val hw_pow⟩
    let ι : ↥𝒪[F] →+* ↥v.valuationSubring :=
      { toFun := fun c => ⟨algebraMap F (AlgebraicClosure F) c.1,
          (Valuation.mem_valuationSubring_iff v _).mpr
            ((hv_le c.1).mpr ((Valuation.mem_valuationSubring_iff (ValuativeRel.valuation F) c.1).mp c.2))⟩
        map_one' := Subtype.ext (map_one _)
        map_mul' := fun x y => Subtype.ext (map_mul _ x.1 y.1)
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun x y => Subtype.ext (map_add _ x.1 y.1) }
    haveI : IsLocalHom ι := IsLocalHom.mk fun a hu => by
      by_contra hnu
      have ha_max : a ∈ IsLocalRing.maximalIdeal ↥𝒪[F] :=
        (IsLocalRing.mem_maximalIdeal a).mpr hnu
      have ha_lt : ValuativeRel.valuation F a.1 < 1 :=
        (Valuation.mem_maximalIdeal_iff F (ValuativeRel.valuation F)).mp ha_max
      have hιa_lt : v (ι a).1 < 1 := (hv_lt a.1).mpr ha_lt
      have hιa_max : ι a ∈ IsLocalRing.maximalIdeal ↥v.valuationSubring :=
        (Valuation.mem_maximalIdeal_iff (AlgebraicClosure F) v).mpr hιa_lt
      exact (IsLocalRing.mem_maximalIdeal (ι a)).mp hιa_max hu
    let φ : 𝓀[F] →+* IsLocalRing.ResidueField ↥v.valuationSubring :=
      IsLocalRing.ResidueField.map ι
    letI : Algebra 𝓀[F] (IsLocalRing.ResidueField ↥v.valuationSubring) := φ.toAlgebra
    let z₀ : ↥v.valuationSubring := ⟨z, (Valuation.mem_valuationSubring_iff v z).mpr hz⟩
    let zbar : IsLocalRing.ResidueField ↥v.valuationSubring :=
      IsLocalRing.residue ↥v.valuationSubring z₀
    have hzbar_int : IsIntegral 𝓀[F] zbar := by
      let P : Polynomial F := minpoly F z
      have hP_monic : P.Monic := minpoly.monic (Algebra.IsIntegral.isIntegral z)
      have hP_lifts : P ∈ Polynomial.lifts (algebraMap ↥𝒪[F] F) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact ⟨⟨P.coeff n, (Valuation.mem_valuationSubring_iff (ValuativeRel.valuation F) _).mpr
          (hv_minpoly z hz n)⟩, rfl⟩
      obtain ⟨P₀, hP₀_map, _, hP₀_monic⟩ :=
        Polynomial.lifts_and_degree_eq_and_monic hP_lifts hP_monic
      have hP₀_eval : Polynomial.eval₂ ι z₀ P₀ = 0 := by
        apply Subtype.ext
        change (v.valuationSubring.subtype (Polynomial.eval₂ ι z₀ P₀) : AlgebraicClosure F) = 0
        rw [Polynomial.hom_eval₂ P₀ ι v.valuationSubring.subtype z₀]
        have hcomp : v.valuationSubring.subtype.comp ι =
            (algebraMap F (AlgebraicClosure F)).comp (algebraMap ↥𝒪[F] F) := by
          ext c
          rfl
        rw [hcomp, ← Polynomial.eval₂_map, hP₀_map]
        exact minpoly.aeval F z
      let Q₀ : Polynomial 𝓀[F] := Polynomial.map (IsLocalRing.residue ↥𝒪[F]) P₀
      refine ⟨Q₀, hP₀_monic.map (IsLocalRing.residue ↥𝒪[F]), ?_⟩
      change Polynomial.eval₂ φ zbar (Polynomial.map (IsLocalRing.residue ↥𝒪[F]) P₀) = 0
      rw [Polynomial.eval₂_map]
      have hφ_comp : φ.comp (IsLocalRing.residue ↥𝒪[F]) =
          (IsLocalRing.residue ↥v.valuationSubring).comp ι :=
        RingHom.ext (IsLocalRing.ResidueField.map_residue ι)
      rw [hφ_comp, ← Polynomial.hom_eval₂ P₀ ι (IsLocalRing.residue ↥v.valuationSubring) z₀,
        hP₀_eval, map_zero]
    have hzbar_ne : zbar ≠ 0 := by
      intro hzbar0
      have hz₀_max : z₀ ∈ IsLocalRing.maximalIdeal ↥v.valuationSubring :=
        (IsLocalRing.residue_eq_zero_iff z₀).mp hzbar0
      exact hz_lt ((Valuation.mem_maximalIdeal_iff (AlgebraicClosure F) v).mp hz₀_max)
    obtain ⟨m, hm_pos, hm_ndvd, hzbar_pow⟩ :=
      h_res_order (IsLocalRing.ResidueField ↥v.valuationSubring) zbar hzbar_int hzbar_ne
    have hres_sub : IsLocalRing.residue ↥v.valuationSubring (z₀ ^ m - 1) = 0 := by
      rw [map_sub, map_pow, map_one, hzbar_pow, sub_self]
    have hz_pow_lt : v (z ^ m - 1) < 1 := by
      have hmax : z₀ ^ m - 1 ∈ IsLocalRing.maximalIdeal ↥v.valuationSubring :=
        (IsLocalRing.residue_eq_zero_iff (z₀ ^ m - 1)).mp hres_sub
      exact (Valuation.mem_maximalIdeal_iff (AlgebraicClosure F) v).mp hmax
    let R : Polynomial (AlgebraicClosure F) := Polynomial.X ^ m - Polynomial.C 1
    have hR_monic : R.Monic := Polynomial.monic_X_pow_sub_C (1 : AlgebraicClosure F) (ne_of_gt hm_pos)
    have hR_ne : R ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hm_pos (1 : AlgebraicClosure F)
    have hR_prod : R = (Multiset.map (fun ζ => Polynomial.X - Polynomial.C ζ) R.roots).prod :=
      Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits R) hR_monic
    have hR_eval : z ^ m - 1 = (Multiset.map (fun ζ => z - ζ) R.roots).prod := by
      have h1 := congrArg (Polynomial.eval z) hR_prod
      simp only [R, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C, Polynomial.eval_multiset_prod, Multiset.map_map,
        Function.comp_apply] at h1
      exact h1
    have hv_prod : v (z ^ m - 1) = (Multiset.map (fun ζ => v (z - ζ)) R.roots).prod := by
      rw [hR_eval, map_multiset_prod, Multiset.map_map]
      rfl
    have hex_root : ∃ ζ ∈ R.roots, v (z - ζ) < 1 := by
      by_contra! hall
      have hge1 : (1 : NNReal) ≤ (Multiset.map (fun ζ => v (z - ζ)) R.roots).prod := by
        apply Multiset.one_le_prod
        intro a ha
        obtain ⟨ζ, hζ, rfl⟩ := Multiset.mem_map.mp ha
        exact hall ζ hζ
      rw [← hv_prod] at hge1
      exact not_lt_of_ge hge1 hz_pow_lt
    obtain ⟨ζ, hζ_mem, hζ_lt⟩ := hex_root
    have hζ_pow : ζ ^ m = 1 := by
      have hroot : Polynomial.eval ζ R = 0 := (Polynomial.mem_roots hR_ne).mp hζ_mem
      simp only [R, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at hroot
      exact sub_eq_zero.mp hroot
    have hζ_p : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ :=
      ⟨m, hm_pos, hm_ndvd, hζ_pow⟩
    have hζ_unr : ζ ∈ EllipticRootNumber.unramifiedClosure F :=
      IntermediateField.subset_adjoin F {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} hζ_p
    have hσζ : σ ζ = ζ :=
      (IntermediateField.mem_fixingSubgroup_iff (EllipticRootNumber.unramifiedClosure F) σ).mp
        hσ ζ hζ_unr
    have hsub_eq : σ z - z = σ (z - ζ) - (z - ζ) := by
      rw [map_sub, hσζ, sub_sub_sub_cancel_right]
    calc v (σ z - z)
      _ = v (σ (z - ζ) - (z - ζ)) := by rw [hsub_eq]
      _ ≤ max (v (σ (z - ζ))) (v (z - ζ)) := Valuation.map_sub v (σ (z - ζ)) (z - ζ)
      _ = max (v (z - ζ)) (v (z - ζ)) := by rw [hv_gal σ (z - ζ)]
      _ = v (z - ζ) := max_self (v (z - ζ))
      _ < 1 := hζ_lt

theorem weierstrass_formal_group_coord_dichotomy (K : Type u) [Field K]
    (v : Valuation K NNReal) (W : WeierstrassCurve.Affine K)
    (ha₁ : v W.a₁ ≤ 1) (ha₂ : v W.a₂ ≤ 1) (ha₃ : v W.a₃ ≤ 1)
    (ha₄ : v W.a₄ ≤ 1) (ha₆ : v W.a₆ ≤ 1)
    {x y : K} (h : W.Equation x y) :
    (v x ≤ 1 → v y ≤ 1) ∧
    (1 < v x →
      v y ^ 2 = v x ^ 3 ∧
      v x < v y ∧
      x ≠ 0 ∧
      y ≠ 0 ∧
      0 < v (-x / y) ∧
      v (-x / y) < 1 ∧
      v (-1 / y) = v (-x / y) ^ 3 ∧
      v (-x / W.negY x y + -x / y) ≤ v (-x / y) ^ 2) :=
by
  have heq : y ^ 2 + W.a₁ * x * y + W.a₃ * y = x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆ :=
    (W.equation_iff x y).mp h
  refine ⟨?_, ?_⟩
  · intro hx
    by_contra hy_not_le
    have hy : 1 < v y := not_le.mp hy_not_le
    have hy_pos : 0 < v y := zero_lt_one.trans hy
    have h_rhs : v (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) ≤ 1 := by
      have h1 : v (x ^ 3) ≤ 1 := by
        rw [v.map_pow]
        exact pow_le_one' hx 3
      have h2 : v (W.a₂ * x ^ 2) ≤ 1 := by
        rw [v.map_mul, v.map_pow]
        exact mul_le_one' ha₂ (pow_le_one' hx 2)
      have h3 : v (W.a₄ * x) ≤ 1 := by
        rw [v.map_mul]
        exact mul_le_one' ha₄ hx
      have h12 : v (x ^ 3 + W.a₂ * x ^ 2) ≤ 1 :=
        le_trans (v.map_add _ _) (max_le h1 h2)
      have h123 : v (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x) ≤ 1 :=
        le_trans (v.map_add _ _) (max_le h12 h3)
      exact le_trans (v.map_add _ _) (max_le h123 ha₆)
    have h_tail : v (W.a₁ * x * y + W.a₃ * y) ≤ v y := by
      have ht1 : v (W.a₁ * x * y) ≤ v y := by
        rw [v.map_mul, v.map_mul]
        calc v W.a₁ * v x * v y ≤ 1 * v y := mul_le_mul' (mul_le_one' ha₁ hx) le_rfl
          _ = v y := one_mul _
      have ht2 : v (W.a₃ * y) ≤ v y := by
        rw [v.map_mul]
        calc v W.a₃ * v y ≤ 1 * v y := mul_le_mul' ha₃ le_rfl
          _ = v y := one_mul _
      exact le_trans (v.map_add _ _) (max_le ht1 ht2)
    have hy_lt_sq : v y < v (y ^ 2) := by
      rw [v.map_pow, sq]
      calc v y = 1 * v y := (one_mul _).symm
        _ < v y * v y := mul_lt_mul_of_pos_right hy hy_pos
    have h_lhs_eq : v (y ^ 2 + W.a₁ * x * y + W.a₃ * y) = v (y ^ 2) := by
      have h_grp : y ^ 2 + W.a₁ * x * y + W.a₃ * y = y ^ 2 + (W.a₁ * x * y + W.a₃ * y) := by ring
      rw [h_grp]
      exact v.map_add_eq_of_lt_left (lt_of_le_of_lt h_tail hy_lt_sq)
    have h_gt : 1 < v (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) := by
      rw [← heq, h_lhs_eq]
      exact hy.trans hy_lt_sq
    exact not_lt_of_ge h_rhs h_gt
  · intro hx
    have hx_pos : 0 < v x := zero_lt_one.trans hx
    have hx_ge_one : 1 ≤ v x := le_of_lt hx
    have hx_lt_sq : v x < v x ^ 2 := by
      rw [sq]
      calc v x = 1 * v x := (one_mul _).symm
        _ < v x * v x := mul_lt_mul_of_pos_right hx hx_pos
    have hx_le_sq : v x ≤ v x ^ 2 := le_of_lt hx_lt_sq
    have hx_one_le_sq : 1 ≤ v x ^ 2 := hx_ge_one.trans hx_le_sq
    have hx_sq_pos : 0 < v x ^ 2 := hx_pos.trans hx_lt_sq
    have hx_sq_lt_cube : v x ^ 2 < v x ^ 3 := by
      have h_pow3 : v x ^ 3 = v x * v x ^ 2 := by ring
      rw [h_pow3]
      calc v x ^ 2 = 1 * v x ^ 2 := (one_mul _).symm
        _ < v x * v x ^ 2 := mul_lt_mul_of_pos_right hx hx_sq_pos
    have h_rhs_eq : v (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) = v x ^ 3 := by
      have h_grp : x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆ =
          x ^ 3 + (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) := by ring
      have ht1 : v (W.a₂ * x ^ 2) ≤ v x ^ 2 := by
        rw [v.map_mul, v.map_pow]
        calc v W.a₂ * v x ^ 2 ≤ 1 * v x ^ 2 := mul_le_mul' ha₂ le_rfl
          _ = v x ^ 2 := one_mul _
      have ht2 : v (W.a₄ * x) ≤ v x ^ 2 := by
        rw [v.map_mul]
        calc v W.a₄ * v x ≤ 1 * v x := mul_le_mul' ha₄ le_rfl
          _ = v x := one_mul _
          _ ≤ v x ^ 2 := hx_le_sq
      have ht3 : v W.a₆ ≤ v x ^ 2 := ha₆.trans hx_one_le_sq
      have ht12 : v (W.a₂ * x ^ 2 + W.a₄ * x) ≤ v x ^ 2 :=
        le_trans (v.map_add _ _) (max_le ht1 ht2)
      have h_tail : v (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) ≤ v x ^ 2 :=
        le_trans (v.map_add _ _) (max_le ht12 ht3)
      have h_lt : v (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) < v (x ^ 3) := by
        rw [v.map_pow]
        exact lt_of_le_of_lt h_tail hx_sq_lt_cube
      rw [h_grp, v.map_add_eq_of_lt_left h_lt, v.map_pow]
    have hxy : v x < v y := by
      by_contra hy_not_lt
      have hyx : v y ≤ v x := not_lt.mp hy_not_lt
      have hl1 : v (y ^ 2) ≤ v x ^ 2 := by
        rw [v.map_pow]
        exact pow_le_pow_left' hyx 2
      have hl2 : v (W.a₁ * x * y) ≤ v x ^ 2 := by
        rw [v.map_mul, v.map_mul, sq]
        calc v W.a₁ * v x * v y ≤ (1 * v x) * v x := mul_le_mul' (mul_le_mul' ha₁ le_rfl) hyx
          _ = v x * v x := by rw [one_mul]
      have hl3 : v (W.a₃ * y) ≤ v x ^ 2 := by
        rw [v.map_mul]
        calc v W.a₃ * v y ≤ 1 * v x := mul_le_mul' ha₃ hyx
          _ = v x := one_mul _
          _ ≤ v x ^ 2 := hx_le_sq
      have hl12 : v (y ^ 2 + W.a₁ * x * y) ≤ v x ^ 2 :=
        le_trans (v.map_add _ _) (max_le hl1 hl2)
      have h_lhs_le : v (y ^ 2 + W.a₁ * x * y + W.a₃ * y) ≤ v x ^ 2 :=
        le_trans (v.map_add _ _) (max_le hl12 hl3)
      rw [heq, h_rhs_eq] at h_lhs_le
      exact not_lt_of_ge h_lhs_le hx_sq_lt_cube
    have hy_pos : 0 < v y := hx_pos.trans hxy
    have hy_sq : v y ^ 2 = v x ^ 3 := by
      have h_grp : y ^ 2 + W.a₁ * x * y + W.a₃ * y = y ^ 2 + (W.a₁ * x * y + W.a₃ * y) := by ring
      have ht1 : v (W.a₁ * x * y) ≤ v x * v y := by
        rw [v.map_mul, v.map_mul]
        calc v W.a₁ * v x * v y ≤ (1 * v x) * v y := mul_le_mul' (mul_le_mul' ha₁ le_rfl) le_rfl
          _ = v x * v y := by rw [one_mul]
      have ht2 : v (W.a₃ * y) ≤ v x * v y := by
        rw [v.map_mul]
        exact mul_le_mul' (ha₃.trans hx_ge_one) le_rfl
      have h_tail : v (W.a₁ * x * y + W.a₃ * y) ≤ v x * v y :=
        le_trans (v.map_add _ _) (max_le ht1 ht2)
      have h_lt : v (W.a₁ * x * y + W.a₃ * y) < v (y ^ 2) := by
        rw [v.map_pow, sq]
        exact lt_of_le_of_lt h_tail (mul_lt_mul_of_pos_right hxy hy_pos)
      have h_lhs_eq : v (y ^ 2 + W.a₁ * x * y + W.a₃ * y) = v y ^ 2 := by
        rw [h_grp, v.map_add_eq_of_lt_left h_lt, v.map_pow]
      rw [← h_lhs_eq, heq, h_rhs_eq]
    have hx_ne : x ≠ 0 := (v.pos_iff).mp hx_pos
    have hy_ne : y ≠ 0 := (v.pos_iff).mp hy_pos
    have hvy_ne : v y ≠ 0 := ne_of_gt hy_pos
    have ht_val : v (-x / y) = v x / v y := by
      rw [v.map_div, v.map_neg]
    have ht_pos : 0 < v (-x / y) := by
      rw [ht_val]
      exact div_pos hx_pos hy_pos
    have ht_lt : v (-x / y) < 1 := by
      rw [ht_val, div_lt_one hy_pos]
      exact hxy
    have hw : v (-1 / y) = v (-x / y) ^ 3 := by
      rw [v.map_div, v.map_neg, v.map_one, ht_val, div_pow, ← hy_sq]
      have hvy2_ne : v y ^ 2 ≠ 0 := pow_ne_zero 2 hvy_ne
      have h_den : v y ^ 3 = v y ^ 2 * v y := by ring
      rw [h_den]
      calc 1 / v y = (v y ^ 2 * 1) / (v y ^ 2 * v y) :=
            (mul_div_mul_left 1 (v y) hvy2_ne).symm
        _ = v y ^ 2 / (v y ^ 2 * v y) := by rw [mul_one]
    have h_negY_val : v (W.negY x y) = v y := by
      change v (-y - W.a₁ * x - W.a₃) = v y
      have h_grp : -y - W.a₁ * x - W.a₃ = -y + (-(W.a₁ * x + W.a₃)) := by ring
      have h_lin : v (W.a₁ * x + W.a₃) ≤ v x := by
        have hl1 : v (W.a₁ * x) ≤ v x := by
          rw [v.map_mul]
          calc v W.a₁ * v x ≤ 1 * v x := mul_le_mul' ha₁ le_rfl
            _ = v x := one_mul _
        have hl2 : v W.a₃ ≤ v x := ha₃.trans hx_ge_one
        exact le_trans (v.map_add _ _) (max_le hl1 hl2)
      have h_lt : v (-(W.a₁ * x + W.a₃)) < v (-y) := by
        rw [v.map_neg, v.map_neg]
        exact lt_of_le_of_lt h_lin hxy
      rw [h_grp, v.map_add_eq_of_lt_left h_lt, v.map_neg]
    have h_negY_pos : 0 < v (W.negY x y) := by
      rw [h_negY_val]
      exact hy_pos
    have h_negY_ne : W.negY x y ≠ 0 := (v.pos_iff).mp h_negY_pos
    have h_neg_bound : v (-x / W.negY x y + -x / y) ≤ v (-x / y) ^ 2 := by
      have h_frac : -x / W.negY x y + -x / y = x * (W.a₁ * x + W.a₃) / (W.negY x y * y) := by
        have h_poly : -x * y + W.negY x y * -x = x * (W.a₁ * x + W.a₃) := by
          change -x * y + (-y - W.a₁ * x - W.a₃) * -x = x * (W.a₁ * x + W.a₃)
          ring
        rw [div_add_div _ _ h_negY_ne hy_ne, h_poly]
      have h_lin : v (W.a₁ * x + W.a₃) ≤ v x := by
        have hl1 : v (W.a₁ * x) ≤ v x := by
          rw [v.map_mul]
          calc v W.a₁ * v x ≤ 1 * v x := mul_le_mul' ha₁ le_rfl
            _ = v x := one_mul _
        have hl2 : v W.a₃ ≤ v x := ha₃.trans hx_ge_one
        exact le_trans (v.map_add _ _) (max_le hl1 hl2)
      rw [h_frac, v.map_div, v.map_mul, v.map_mul, h_negY_val, ht_val, div_pow, ← sq (v y)]
      have h_num_le : v x * v (W.a₁ * x + W.a₃) ≤ v x ^ 2 := by
        rw [sq]
        exact mul_le_mul' le_rfl h_lin
      exact div_le_div_of_nonneg_right h_num_le (zero_le _)
    exact ⟨hy_sq, hxy, hx_ne, hy_ne, ht_pos, ht_lt, hw, h_neg_bound⟩

theorem weierstrass_collinearity_vieta_identities (K : Type u) [Field K] [DecidableEq K]
    (W : WeierstrassCurve.Affine K)
    {x₁ y₁ x₂ y₂ : K} (h₁ : W.Equation x₁ y₁) (h₂ : W.Equation x₂ y₂)
    (hxy : ¬ (x₁ = x₂ ∧ y₁ = W.negY x₂ y₂)) :
    let L := W.slope x₁ x₂ y₁ y₂
    let M := y₁ - L * x₁
    let x₃ := W.addX x₁ x₂ L
    let y₃' := W.negAddY x₁ x₂ y₁ L
    x₁ * x₂ * x₃ = M ^ 2 + W.a₃ * M - W.a₆ ∧
    y₁ * y₂ * y₃' = M ^ 3 - W.a₂ * L * M ^ 2 + W.a₄ * L ^ 2 * M - W.a₆ * L ^ 3 ∧
    x₁ * y₂ * y₃' + y₁ * x₂ * y₃' + y₁ * y₂ * x₃ =
      -W.a₁ * L * M ^ 2 - W.a₂ * M ^ 2 + W.a₃ * L ^ 2 * M + 2 * W.a₄ * L * M - 3 * W.a₆ * L ^ 2 :=
by
  dsimp only [WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.negAddY]
  let L := W.slope x₁ x₂ y₁ y₂
  let M := y₁ - L * x₁
  let x₃ := L ^ 2 + W.a₁ * L - W.a₂ - x₁ - x₂
  let y₃' := L * (x₃ - x₁) + y₁
  have hE₁ : y₁ ^ 2 + W.a₁ * x₁ * y₁ + W.a₃ * y₁ = x₁ ^ 3 + W.a₂ * x₁ ^ 2 + W.a₄ * x₁ + W.a₆ :=
    (W.equation_iff x₁ y₁).mp h₁
  have hE₂ : y₂ ^ 2 + W.a₁ * x₂ * y₂ + W.a₃ * y₂ = x₂ ^ 3 + W.a₂ * x₂ ^ 2 + W.a₄ * x₂ + W.a₆ :=
    (W.equation_iff x₂ y₂).mp h₂
  have h_main : y₂ = L * x₂ + M ∧
      (x₁ * x₂ + x₁ * x₃ + x₂ * x₃) + (2 * L * M + W.a₁ * M + W.a₃ * L - W.a₄) = 0 := by
    by_cases hx : x₁ = x₂
    · have hy : y₁ ≠ W.negY x₂ y₂ := fun h => hxy ⟨hx, h⟩
      have hy_eq : y₁ = y₂ := W.Y_eq_of_Y_ne h₁ h₂ hx hy
      have hy₂_line : y₂ = L * x₂ + M := by
        linear_combination L * hx - hy_eq
      have hy' : y₁ ≠ W.negY x₁ y₁ := by
        rwa [← hx, ← hy_eq] at hy
      have h_denom : y₁ - W.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy'
      have hL_eq : L = (3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) / (y₁ - W.negY x₁ y₁) :=
        W.slope_of_Y_ne hx hy
      have h_tan : L * (y₁ - (-y₁ - W.a₁ * x₁ - W.a₃)) =
          3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁ := by
        change L * (y₁ - W.negY x₁ y₁) = _
        rw [hL_eq, div_mul_cancel₀ _ h_denom]
      have he₂ : (x₁ * x₂ + x₁ * x₃ + x₂ * x₃) + (2 * L * M + W.a₁ * M + W.a₃ * L - W.a₄) = 0 := by
        linear_combination h_tan + (-L ^ 2 - W.a₁ * L + W.a₂ + 2 * x₁ + x₂) * hx
      exact ⟨hy₂_line, he₂⟩
    · have h_denom : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx
      have hL_eq : L = (y₁ - y₂) / (x₁ - x₂) := W.slope_of_X_ne hx
      have h_chord : L * (x₁ - x₂) = y₁ - y₂ := by
        rw [hL_eq, div_mul_cancel₀ _ h_denom]
      have hy₂_line : y₂ = L * x₂ + M := by
        linear_combination h_chord
      have h_fac : (x₁ - x₂) * ((x₁ * x₂ + x₁ * x₃ + x₂ * x₃) +
          (2 * L * M + W.a₁ * M + W.a₃ * L - W.a₄)) = 0 := by
        linear_combination hE₁ - hE₂ +
          (L * (-x₁ + x₂) + W.a₁ * x₂ + W.a₃ + y₁ + y₂) * h_chord
      have he₂ : (x₁ * x₂ + x₁ * x₃ + x₂ * x₃) + (2 * L * M + W.a₁ * M + W.a₃ * L - W.a₄) = 0 :=
        (mul_eq_zero.mp h_fac).resolve_left h_denom
      exact ⟨hy₂_line, he₂⟩
  obtain ⟨hy₂_line, he₂⟩ := h_main
  have he₃ : x₁ * x₂ * x₃ - (M ^ 2 + W.a₃ * M - W.a₆) = 0 := by
    linear_combination x₁ * he₂ - hE₁
  refine ⟨?_, ?_, ?_⟩
  · linear_combination he₃
  · linear_combination (y₁ * y₃') * hy₂_line + L ^ 3 * he₃ + L ^ 2 * M * he₂
  · linear_combination (x₁ * y₃' + y₁ * x₃) * hy₂_line + 3 * L ^ 2 * he₃ + 2 * L * M * he₂

theorem weierstrass_formal_group_slope_intercept_bounds (K : Type u) [Field K] [DecidableEq K]
    (v : Valuation K NNReal) (W : WeierstrassCurve.Affine K)
    (ha₁ : v W.a₁ ≤ 1) (ha₂ : v W.a₂ ≤ 1) (ha₃ : v W.a₃ ≤ 1)
    (ha₄ : v W.a₄ ≤ 1) (ha₆ : v W.a₆ ≤ 1)
    {x₁ y₁ x₂ y₂ : K} (h₁ : W.Equation x₁ y₁) (h₂ : W.Equation x₂ y₂)
    (hx₁ : 1 < v x₁) (hy₁ : v y₁ ^ 2 = v x₁ ^ 3) (hxy₁ : v x₁ < v y₁)
    (hy₁_ne : y₁ ≠ 0) (ht₁_lt : v (-x₁ / y₁) < 1) (hw₁ : v (-1 / y₁) = v (-x₁ / y₁) ^ 3)
    (hy₂_ne : y₂ ≠ 0) (ht₂_lt : v (-x₂ / y₂) < 1) (hw₂ : v (-1 / y₂) = v (-x₂ / y₂) ^ 3)
    (hxy : ¬ (x₁ = x₂ ∧ y₁ = W.negY x₂ y₂)) :
    let L := W.slope x₁ x₂ y₁ y₂
    let M := y₁ - L * x₁
    let τ := max (v (-x₁ / y₁)) (v (-x₂ / y₂))
    0 < v M ∧ v L ≤ τ ^ 2 * v M ∧ 1 ≤ τ ^ 3 * v M :=
by
  intro L M τ
  have hE₁ : y₁ ^ 2 + W.a₁ * x₁ * y₁ + W.a₃ * y₁ = x₁ ^ 3 + W.a₂ * x₁ ^ 2 + W.a₄ * x₁ + W.a₆ :=
    (W.equation_iff x₁ y₁).mp h₁
  have hE₂ : y₂ ^ 2 + W.a₁ * x₂ * y₂ + W.a₃ * y₂ = x₂ ^ 3 + W.a₂ * x₂ ^ 2 + W.a₄ * x₂ + W.a₆ :=
    (W.equation_iff x₂ y₂).mp h₂
  let t₁ : K := -x₁ / y₁
  let w₁ : K := -1 / y₁
  let t₂ : K := -x₂ / y₂
  let w₂ : K := -1 / y₂
  have hxw₁ : x₁ * w₁ - t₁ = 0 := by dsimp [t₁, w₁]; ring
  have hyw₁ : y₁ * w₁ + 1 = 0 := by
    dsimp [w₁]
    rw [mul_div_cancel₀ (-1) hy₁_ne]
    ring
  have hxw₂ : x₂ * w₂ - t₂ = 0 := by dsimp [t₂, w₂]; ring
  have hyw₂ : y₂ * w₂ + 1 = 0 := by
    dsimp [w₂]
    rw [mul_div_cancel₀ (-1) hy₂_ne]
    ring
  let A_w : K := 1 - W.a₁ * t₁ - W.a₂ * t₁ ^ 2 - W.a₃ * (w₁ + w₂) -
    W.a₄ * t₁ * (w₁ + w₂) - W.a₆ * (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2)
  let B_t : K := t₁ ^ 2 + t₁ * t₂ + t₂ ^ 2 + W.a₁ * w₂ + W.a₂ * (t₁ + t₂) * w₂ + W.a₄ * w₂ ^ 2
  have h_LAW : L * A_w = -M * B_t := by
    by_cases hx : x₁ = x₂
    · have hy : y₁ ≠ W.negY x₂ y₂ := fun h => hxy ⟨hx, h⟩
      have hy_eq : y₁ = y₂ := W.Y_eq_of_Y_ne h₁ h₂ hx hy
      have ht_eq : t₂ = t₁ := by dsimp [t₁, t₂]; rw [hx, hy_eq]
      have hw_eq : w₂ = w₁ := by dsimp [w₁, w₂]; rw [hy_eq]
      let D : K := y₁ - (-y₁ - W.a₁ * x₁ - W.a₃)
      let N_L : K := 3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁
      have hy' : y₁ ≠ W.negY x₁ y₁ := by rwa [← hx, ← hy_eq] at hy
      have hD_ne : D ≠ 0 := sub_ne_zero.mpr hy'
      have hL_eq : L = N_L / D := W.slope_of_Y_ne hx hy
      have hLD : L * D - N_L = 0 := by
        rw [hL_eq, div_mul_cancel₀ _ hD_ne, sub_self]
      have hB_tan : B_t - (L * D) * w₁ ^ 2 = 0 := by
        dsimp [B_t, D, N_L] at hLD ⊢
        rw [ht_eq, hw_eq]
        linear_combination -w₁ ^ 2 * hLD + (-3 * (x₁ * w₁ + t₁) - 2 * W.a₂ * w₁) * hxw₁ +
          (W.a₁ * w₁) * hyw₁
      have hA_tan : A_w + (M * D) * w₁ ^ 2 = 0 := by
        dsimp [A_w, M, D, N_L] at hLD ⊢
        rw [hw_eq]
        linear_combination -x₁ * w₁ ^ 2 * hLD + 3 * w₁ ^ 2 * hE₁ +
          (W.a₂ * (x₁ * w₁ + t₁) + 2 * W.a₄ * w₁ - W.a₁ * y₁ * w₁) * hxw₁ +
          (-(y₁ * w₁ - 1) - W.a₁ * t₁ - 2 * W.a₃ * w₁) * hyw₁
      linear_combination L * hA_tan + M * hB_tan
    · have hw_eq₁ : w₁ - (t₁ ^ 3 + W.a₁ * t₁ * w₁ + W.a₂ * t₁ ^ 2 * w₁ + W.a₃ * w₁ ^ 2 +
          W.a₄ * t₁ * w₁ ^ 2 + W.a₆ * w₁ ^ 3) = 0 := by
        linear_combination w₁ ^ 3 * hE₁ +
          ((x₁ ^ 2 * w₁ ^ 2 + x₁ * w₁ * t₁ + t₁ ^ 2) + W.a₂ * w₁ * (x₁ * w₁ + t₁) +
            W.a₄ * w₁ ^ 2 - W.a₁ * w₁ * (y₁ * w₁)) * hxw₁ +
          (-w₁ * (y₁ * w₁ - 1) - W.a₁ * t₁ * w₁ - W.a₃ * w₁ ^ 2) * hyw₁
      have hw_eq₂ : w₂ - (t₂ ^ 3 + W.a₁ * t₂ * w₂ + W.a₂ * t₂ ^ 2 * w₂ + W.a₃ * w₂ ^ 2 +
          W.a₄ * t₂ * w₂ ^ 2 + W.a₆ * w₂ ^ 3) = 0 := by
        linear_combination w₂ ^ 3 * hE₂ +
          ((x₂ ^ 2 * w₂ ^ 2 + x₂ * w₂ * t₂ + t₂ ^ 2) + W.a₂ * w₂ * (x₂ * w₂ + t₂) +
            W.a₄ * w₂ ^ 2 - W.a₁ * w₂ * (y₂ * w₂)) * hxw₂ +
          (-w₂ * (y₂ * w₂ - 1) - W.a₁ * t₂ * w₂ - W.a₃ * w₂ ^ 2) * hyw₂
      have hw_diff : (w₁ - w₂) * A_w - (t₁ - t₂) * B_t = 0 := by
        dsimp [A_w, B_t]
        linear_combination hw_eq₁ - hw_eq₂
      have hx_sub_ne : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx
      have hL_eq : L = (y₁ - y₂) / (x₁ - x₂) := W.slope_of_X_ne hx
      have hL : L * (x₁ - x₂) - (y₁ - y₂) = 0 := by
        rw [hL_eq, div_mul_cancel₀ _ hx_sub_ne, sub_self]
      have hL_w : L * ((x₁ - x₂) * w₁ * w₂) - (w₁ - w₂) = 0 := by
        linear_combination w₁ * w₂ * hL + w₂ * hyw₁ - w₁ * hyw₂
      have hM_t : M * ((x₁ - x₂) * w₁ * w₂) + (t₁ - t₂) = 0 := by
        dsimp [M]
        linear_combination -x₁ * w₁ * w₂ * hL - hxw₁ + x₁ * w₁ * hyw₂ + hxw₂ - x₂ * w₂ * hyw₁
      have h_fac : (L * A_w + M * B_t) * ((x₁ - x₂) * w₁ * w₂) = 0 := by
        linear_combination A_w * hL_w + B_t * hM_t + hw_diff
      have hw₁_ne : w₁ ≠ 0 := div_ne_zero (by norm_num) hy₁_ne
      have hw₂_ne : w₂ ≠ 0 := div_ne_zero (by norm_num) hy₂_ne
      have h_prod_ne : (x₁ - x₂) * w₁ * w₂ ≠ 0 :=
        mul_ne_zero (mul_ne_zero hx_sub_ne hw₁_ne) hw₂_ne
      have h_sum_zero : L * A_w + M * B_t = 0 :=
        (mul_eq_zero.mp h_fac).resolve_right h_prod_ne
      linear_combination h_sum_zero
  have ht₁_lt' : v t₁ < 1 := ht₁_lt
  have ht₂_lt' : v t₂ < 1 := ht₂_lt
  have hw₁' : v w₁ = v t₁ ^ 3 := hw₁
  have hw₂' : v w₂ = v t₂ ^ 3 := hw₂
  have ht₁_τ : v t₁ ≤ τ := le_max_left (v t₁) (v t₂)
  have ht₂_τ : v t₂ ≤ τ := le_max_right (v t₁) (v t₂)
  have hτ_lt : τ < 1 := max_lt ht₁_lt' ht₂_lt'
  have hτ_le : τ ≤ 1 := le_of_lt hτ_lt
  have ht₁_le : v t₁ ≤ 1 := le_of_lt ht₁_lt'
  have ht₂_le : v t₂ ≤ 1 := le_of_lt ht₂_lt'
  have hw₁_lt : v w₁ < 1 := by
    rw [hw₁']
    exact pow_lt_one' ht₁_lt' (by norm_num)
  have hw₂_lt : v w₂ < 1 := by
    rw [hw₂']
    exact pow_lt_one' ht₂_lt' (by norm_num)
  have hw₁_le : v w₁ ≤ 1 := le_of_lt hw₁_lt
  have hw₂_le : v w₂ ≤ 1 := le_of_lt hw₂_lt
  have hw₁_τ3 : v w₁ ≤ τ ^ 3 := by
    rw [hw₁']
    exact pow_le_pow_left' ht₁_τ 3
  have hw₂_τ3 : v w₂ ≤ τ ^ 3 := by
    rw [hw₂']
    exact pow_le_pow_left' ht₂_τ 3
  have hτ3_le_τ2 : τ ^ 3 ≤ τ ^ 2 := by
    calc τ ^ 3 = τ ^ 2 * τ := by ring
      _ ≤ τ ^ 2 * 1 := mul_le_mul' le_rfl hτ_le
      _ = τ ^ 2 := mul_one _
  have hw₂_τ2 : v w₂ ≤ τ ^ 2 := le_trans hw₂_τ3 hτ3_le_τ2
  have hvA : v A_w = 1 := by
    have hA1 : v (W.a₁ * t₁) < 1 := by
      calc v (W.a₁ * t₁) = v W.a₁ * v t₁ := v.map_mul _ _
        _ ≤ 1 * v t₁ := mul_le_mul' ha₁ le_rfl
        _ = v t₁ := one_mul _
        _ < 1 := ht₁_lt'
    have hA2 : v (W.a₂ * t₁ ^ 2) < 1 := by
      calc v (W.a₂ * t₁ ^ 2) = v W.a₂ * v t₁ ^ 2 := by rw [v.map_mul, v.map_pow]
        _ ≤ 1 * v t₁ ^ 2 := mul_le_mul' ha₂ le_rfl
        _ = v t₁ ^ 2 := one_mul _
        _ < 1 := pow_lt_one' ht₁_lt' (by norm_num)
    have hw12_lt : v (w₁ + w₂) < 1 :=
      lt_of_le_of_lt (v.map_add _ _) (max_lt hw₁_lt hw₂_lt)
    have hA3 : v (W.a₃ * (w₁ + w₂)) < 1 := by
      calc v (W.a₃ * (w₁ + w₂)) = v W.a₃ * v (w₁ + w₂) := v.map_mul _ _
        _ ≤ 1 * v (w₁ + w₂) := mul_le_mul' ha₃ le_rfl
        _ = v (w₁ + w₂) := one_mul _
        _ < 1 := hw12_lt
    have hA4 : v (W.a₄ * t₁ * (w₁ + w₂)) < 1 := by
      calc v (W.a₄ * t₁ * (w₁ + w₂)) = (v W.a₄ * v t₁) * v (w₁ + w₂) := by
            rw [v.map_mul, v.map_mul]
        _ ≤ (1 * 1) * v (w₁ + w₂) := mul_le_mul' (mul_le_mul' ha₄ ht₁_le) le_rfl
        _ = v (w₁ + w₂) := by ring
        _ < 1 := hw12_lt
    have hw1_sq_lt : v (w₁ ^ 2) < 1 := by
      rw [v.map_pow]
      exact pow_lt_one' hw₁_lt (by norm_num)
    have hw12_mul_lt : v (w₁ * w₂) < 1 := by
      rw [v.map_mul]
      calc v w₁ * v w₂ ≤ 1 * v w₂ := mul_le_mul' hw₁_le le_rfl
        _ = v w₂ := one_mul _
        _ < 1 := hw₂_lt
    have hw2_sq_lt : v (w₂ ^ 2) < 1 := by
      rw [v.map_pow]
      exact pow_lt_one' hw₂_lt (by norm_num)
    have hw_quad_lt : v (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2) < 1 :=
      lt_of_le_of_lt (v.map_add _ _)
        (max_lt (lt_of_le_of_lt (v.map_add _ _) (max_lt hw1_sq_lt hw12_mul_lt)) hw2_sq_lt)
    have hA6 : v (W.a₆ * (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2)) < 1 := by
      calc v (W.a₆ * (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2)) =
            v W.a₆ * v (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2) := v.map_mul _ _
        _ ≤ 1 * v (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2) := mul_le_mul' ha₆ le_rfl
        _ = v (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2) := one_mul _
        _ < 1 := hw_quad_lt
    let tail_A : K := -(W.a₁ * t₁ + W.a₂ * t₁ ^ 2 + W.a₃ * (w₁ + w₂) +
      W.a₄ * t₁ * (w₁ + w₂) + W.a₆ * (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2))
    have hA_split : A_w = 1 + tail_A := by dsimp [A_w, tail_A]; ring
    have h_tail_lt : v tail_A < v (1 : K) := by
      rw [v.map_one]
      dsimp [tail_A]
      rw [v.map_neg]
      refine lt_of_le_of_lt (v.map_add _ _) (max_lt ?_ hA6)
      refine lt_of_le_of_lt (v.map_add _ _) (max_lt ?_ hA4)
      refine lt_of_le_of_lt (v.map_add _ _) (max_lt ?_ hA3)
      exact lt_of_le_of_lt (v.map_add _ _) (max_lt hA1 hA2)
    rw [hA_split, v.map_add_eq_of_lt_left h_tail_lt, v.map_one]
  have hvB : v B_t ≤ τ ^ 2 := by
    have hB1 : v (t₁ ^ 2) ≤ τ ^ 2 := by
      rw [v.map_pow]
      exact pow_le_pow_left' ht₁_τ 2
    have hB2 : v (t₁ * t₂) ≤ τ ^ 2 := by
      calc v (t₁ * t₂) = v t₁ * v t₂ := v.map_mul _ _
        _ ≤ τ * τ := mul_le_mul' ht₁_τ ht₂_τ
        _ = τ ^ 2 := (sq τ).symm
    have hB3 : v (t₂ ^ 2) ≤ τ ^ 2 := by
      rw [v.map_pow]
      exact pow_le_pow_left' ht₂_τ 2
    have hB4 : v (W.a₁ * w₂) ≤ τ ^ 2 := by
      calc v (W.a₁ * w₂) = v W.a₁ * v w₂ := v.map_mul _ _
        _ ≤ 1 * τ ^ 2 := mul_le_mul' ha₁ hw₂_τ2
        _ = τ ^ 2 := one_mul _
    have ht12_le : v (t₁ + t₂) ≤ 1 :=
      le_trans (v.map_add _ _) (max_le ht₁_le ht₂_le)
    have hB5 : v (W.a₂ * (t₁ + t₂) * w₂) ≤ τ ^ 2 := by
      calc v (W.a₂ * (t₁ + t₂) * w₂) = (v W.a₂ * v (t₁ + t₂)) * v w₂ := by
            rw [v.map_mul, v.map_mul]
        _ ≤ (1 * 1) * τ ^ 2 := mul_le_mul' (mul_le_mul' ha₂ ht12_le) hw₂_τ2
        _ = τ ^ 2 := by ring
    have hB6 : v (W.a₄ * w₂ ^ 2) ≤ τ ^ 2 := by
      calc v (W.a₄ * w₂ ^ 2) = v W.a₄ * (v w₂ * v w₂) := by
            rw [v.map_mul, v.map_pow, sq]
        _ ≤ 1 * (1 * τ ^ 2) := mul_le_mul' ha₄ (mul_le_mul' hw₂_le hw₂_τ2)
        _ = τ ^ 2 := by ring
    dsimp [B_t]
    refine le_trans (v.map_add _ _) (max_le ?_ hB6)
    refine le_trans (v.map_add _ _) (max_le ?_ hB5)
    refine le_trans (v.map_add _ _) (max_le ?_ hB4)
    refine le_trans (v.map_add _ _) (max_le ?_ hB3)
    exact le_trans (v.map_add _ _) (max_le hB1 hB2)
  have hL_le : v L ≤ τ ^ 2 * v M := by
    have h_val_eq : v (L * A_w) = v (-M * B_t) := congr_arg v h_LAW
    rw [v.map_mul, hvA, mul_one, v.map_mul, v.map_neg] at h_val_eq
    calc v L = v M * v B_t := h_val_eq
      _ ≤ v M * τ ^ 2 := mul_le_mul' le_rfl hvB
      _ = τ ^ 2 * v M := mul_comm _ _
  have h_one : -L * t₁ - M * w₁ = 1 := by
    dsimp [M]
    linear_combination L * hxw₁ - hyw₁
  have hM_ge : 1 ≤ τ ^ 3 * v M := by
    have h_val_one : v (-L * t₁ - M * w₁) = 1 := by
      rw [h_one, v.map_one]
    have h_split_one : -L * t₁ - M * w₁ = (-L * t₁) + (-M * w₁) := by ring
    rw [h_split_one] at h_val_one
    have h_tri : 1 ≤ max (v (-L * t₁)) (v (-M * w₁)) := by
      rw [← h_val_one]
      exact v.map_add _ _
    rw [v.map_mul, v.map_neg, v.map_mul, v.map_neg] at h_tri
    have h_term1 : v L * v t₁ ≤ τ ^ 3 * v M := by
      calc v L * v t₁ ≤ (τ ^ 2 * v M) * τ := mul_le_mul' hL_le ht₁_τ
        _ = τ ^ 3 * v M := by ring
    have h_term2 : v M * v w₁ ≤ τ ^ 3 * v M := by
      calc v M * v w₁ ≤ v M * τ ^ 3 := mul_le_mul' le_rfl hw₁_τ3
        _ = τ ^ 3 * v M := mul_comm _ _
    exact le_trans h_tri (max_le h_term1 h_term2)
  have hM_pos : 0 < v M := by
    apply pos_iff_ne_zero.mpr
    intro h0
    rw [h0, mul_zero] at hM_ge
    exact not_le_of_gt zero_lt_one hM_ge
  exact ⟨hM_pos, hL_le, hM_ge⟩

theorem weierstrass_formal_group_add_param_approx (K : Type u) [Field K]
    (v : Valuation K NNReal) (W : WeierstrassCurve.Affine K)
    (ha₁ : v W.a₁ ≤ 1) (ha₂ : v W.a₂ ≤ 1) (ha₃ : v W.a₃ ≤ 1)
    (ha₄ : v W.a₄ ≤ 1) (ha₆ : v W.a₆ ≤ 1)
    {x₁ y₁ x₂ y₂ L M x₃ y₃' : K}
    (hy₁ : v y₁ ^ 2 = v x₁ ^ 3) (hx₁_ne : x₁ ≠ 0) (hy₁_ne : y₁ ≠ 0) (ht₁_lt : v (-x₁ / y₁) < 1)
    (hy₂ : v y₂ ^ 2 = v x₂ ^ 3) (hx₂_ne : x₂ ≠ 0) (hy₂_ne : y₂ ≠ 0) (ht₂_lt : v (-x₂ / y₂) < 1)
    (he₃ : x₁ * x₂ * x₃ = M ^ 2 + W.a₃ * M - W.a₆)
    (hT₃ : y₁ * y₂ * y₃' = M ^ 3 - W.a₂ * L * M ^ 2 + W.a₄ * L ^ 2 * M - W.a₆ * L ^ 3)
    (hT₂ : x₁ * y₂ * y₃' + y₁ * x₂ * y₃' + y₁ * y₂ * x₃ =
      -W.a₁ * L * M ^ 2 - W.a₂ * M ^ 2 + W.a₃ * L ^ 2 * M + 2 * W.a₄ * L * M - 3 * W.a₆ * L ^ 2)
    (hM_pos : 0 < v M)
    (hL_le : v L ≤ max (v (-x₁ / y₁)) (v (-x₂ / y₂)) ^ 2 * v M)
    (hM_ge : 1 ≤ max (v (-x₁ / y₁)) (v (-x₂ / y₂)) ^ 3 * v M) :
    1 < v x₃ ∧
      v (-x₃ / W.negY x₃ y₃' - (-x₁ / y₁ + -x₂ / y₂)) ≤
        max (v (-x₁ / y₁)) (v (-x₂ / y₂)) ^ 2 :=
by
  set τ : NNReal := max (v (-x₁ / y₁)) (v (-x₂ / y₂))
  have hτ_lt : τ < 1 := max_lt ht₁_lt ht₂_lt
  have hτ_le : τ ≤ 1 := le_of_lt hτ_lt
  have hτ2_le_τ : τ ^ 2 ≤ τ := by
    calc τ ^ 2 = τ * τ := sq τ
      _ ≤ 1 * τ := mul_le_mul' hτ_le le_rfl
      _ = τ := one_mul τ
  have hτ2_lt_one : τ ^ 2 < 1 := lt_of_le_of_lt hτ2_le_τ hτ_lt
  have hτ3_le_τ2 : τ ^ 3 ≤ τ ^ 2 := by
    calc τ ^ 3 = τ ^ 2 * τ := by ring
      _ ≤ τ ^ 2 * 1 := mul_le_mul' le_rfl hτ_le
      _ = τ ^ 2 := mul_one _
  have hτ3_lt_one : τ ^ 3 < 1 := lt_of_le_of_lt hτ3_le_τ2 hτ2_lt_one
  have hL_lt_M : v L < v M := by
    calc v L ≤ τ ^ 2 * v M := hL_le
      _ < 1 * v M := mul_lt_mul_of_pos_right hτ2_lt_one hM_pos
      _ = v M := one_mul _
  have hL_le_M : v L ≤ v M := le_of_lt hL_lt_M
  have hM_ge2 : 1 ≤ τ ^ 2 * v M := le_trans hM_ge (mul_le_mul' hτ3_le_τ2 le_rfl)
  have hM_gt_one : 1 < v M := by
    calc (1 : NNReal) ≤ τ ^ 3 * v M := hM_ge
      _ < 1 * v M := mul_lt_mul_of_pos_right hτ3_lt_one hM_pos
      _ = v M := one_mul _
  have hM_ge_one : 1 ≤ v M := le_of_lt hM_gt_one
  have h2_le : v (2 : K) ≤ 1 := by
    have h2 : (2 : K) = 1 + 1 := by ring
    rw [h2]
    exact le_trans (v.map_add 1 1) (max_le (le_of_eq v.map_one) (le_of_eq v.map_one))
  have h3_le : v (3 : K) ≤ 1 := by
    have h3 : (3 : K) = 2 + 1 := by ring
    rw [h3]
    exact le_trans (v.map_add 2 1) (max_le h2_le (le_of_eq v.map_one))
  have he₃' : x₁ * x₂ * x₃ = M ^ 2 + (W.a₃ * M - W.a₆) := by linear_combination he₃
  have he₃_tail : v (W.a₃ * M - W.a₆) < v (M ^ 2) := by
    have h_le : v (W.a₃ * M - W.a₆) ≤ v M := by
      refine le_trans (v.map_sub _ _) (max_le ?_ (le_trans ha₆ hM_ge_one))
      rw [v.map_mul]
      calc v W.a₃ * v M ≤ 1 * v M := mul_le_mul' ha₃ le_rfl
        _ = v M := one_mul _
    refine lt_of_le_of_lt h_le ?_
    rw [v.map_pow, sq]
    calc v M = 1 * v M := (one_mul _).symm
      _ < v M * v M := mul_lt_mul_of_pos_right hM_gt_one hM_pos
  have h_vx123 : v x₁ * v x₂ * v x₃ = v M ^ 2 := by
    have h := congr_arg v he₃'
    rw [v.map_mul, v.map_mul, v.map_add_eq_of_lt_left he₃_tail, v.map_pow] at h
    exact h
  have hx₃_pos : 0 < v x₃ := by
    by_contra hx₃_le
    have hx₃_zero : v x₃ = 0 := nonpos_iff_eq_zero.mp (not_lt.mp hx₃_le)
    have h0 : v M ^ 2 = 0 := by rw [← h_vx123, hx₃_zero, mul_zero]
    exact ne_of_gt (pow_pos hM_pos 2) h0
  have hT₃' : y₁ * y₂ * y₃' = M ^ 3 + (-W.a₂ * L * M ^ 2 + W.a₄ * L ^ 2 * M - W.a₆ * L ^ 3) := by
    linear_combination hT₃
  have hT₃_tail : v (-W.a₂ * L * M ^ 2 + W.a₄ * L ^ 2 * M - W.a₆ * L ^ 3) < v (M ^ 3) := by
    have h1 : v (-W.a₂ * L * M ^ 2) ≤ v L * v M ^ 2 := by
      rw [v.map_mul, v.map_mul, v.map_neg, v.map_pow]
      calc v W.a₂ * v L * v M ^ 2 ≤ 1 * v L * v M ^ 2 :=
            mul_le_mul' (mul_le_mul' ha₂ le_rfl) le_rfl
        _ = v L * v M ^ 2 := by ring
    have h2 : v (W.a₄ * L ^ 2 * M) ≤ v L * v M ^ 2 := by
      rw [v.map_mul, v.map_mul, v.map_pow, sq, sq]
      calc v W.a₄ * (v L * v L) * v M ≤ 1 * (v L * v M) * v M :=
            mul_le_mul' (mul_le_mul' ha₄ (mul_le_mul' le_rfl hL_le_M)) le_rfl
        _ = v L * (v M * v M) := by ring
    have h3 : v (W.a₆ * L ^ 3) ≤ v L * v M ^ 2 := by
      have hL3 : v (L ^ 3) = v L * v L ^ 2 := by rw [v.map_pow]; ring
      rw [v.map_mul, hL3]
      calc v W.a₆ * (v L * v L ^ 2) ≤ 1 * (v L * v M ^ 2) :=
            mul_le_mul' ha₆ (mul_le_mul' le_rfl (pow_le_pow_left' hL_le_M 2))
        _ = v L * v M ^ 2 := one_mul _
    have h_le : v (-W.a₂ * L * M ^ 2 + W.a₄ * L ^ 2 * M - W.a₆ * L ^ 3) ≤ v L * v M ^ 2 :=
      le_trans (v.map_sub _ _) (max_le (le_trans (v.map_add _ _) (max_le h1 h2)) h3)
    refine lt_of_le_of_lt h_le ?_
    have hM3 : v (M ^ 3) = v M * v M ^ 2 := by rw [v.map_pow]; ring
    rw [hM3]
    exact mul_lt_mul_of_pos_right hL_lt_M (pow_pos hM_pos 2)
  have h_vy123 : v y₁ * v y₂ * v y₃' = v M ^ 3 := by
    have h := congr_arg v hT₃'
    rw [v.map_mul, v.map_mul, v.map_add_eq_of_lt_left hT₃_tail, v.map_pow] at h
    exact h
  have hy₃'_pos : 0 < v y₃' := by
    by_contra hy₃'_le
    have hy₃'_zero : v y₃' = 0 := nonpos_iff_eq_zero.mp (not_lt.mp hy₃'_le)
    have h0 : v M ^ 3 = 0 := by rw [← h_vy123, hy₃'_zero, mul_zero]
    exact ne_of_gt (pow_pos hM_pos 3) h0
  have hy₃'_ne : y₃' ≠ 0 := (v.pos_iff).mp hy₃'_pos
  have hy₃'_sq : v y₃' ^ 2 = v x₃ ^ 3 := by
    have h_eq : (v x₁ ^ 3 * v x₂ ^ 3) * v y₃' ^ 2 = (v x₁ ^ 3 * v x₂ ^ 3) * v x₃ ^ 3 := by
      calc (v x₁ ^ 3 * v x₂ ^ 3) * v y₃' ^ 2
        _ = v y₁ ^ 2 * v y₂ ^ 2 * v y₃' ^ 2 := by rw [← hy₁, ← hy₂]
        _ = (v y₁ * v y₂ * v y₃') ^ 2 := by ring
        _ = (v M ^ 3) ^ 2 := by rw [h_vy123]
        _ = (v M ^ 2) ^ 3 := by ring
        _ = (v x₁ * v x₂ * v x₃) ^ 3 := by rw [← h_vx123]
        _ = (v x₁ ^ 3 * v x₂ ^ 3) * v x₃ ^ 3 := by ring
    have hx12_ne : v x₁ ^ 3 * v x₂ ^ 3 ≠ 0 :=
      mul_ne_zero (pow_ne_zero 3 ((v.ne_zero_iff).mpr hx₁_ne))
        (pow_ne_zero 3 ((v.ne_zero_iff).mpr hx₂_ne))
    exact mul_left_cancel₀ hx12_ne h_eq
  let N₂ : K := x₁ * y₂ * y₃' + y₁ * x₂ * y₃' + y₁ * y₂ * x₃
  have hN₂_le : v N₂ ≤ τ ^ 2 * v M ^ 3 := by
    have ht1 : v (-W.a₁ * L * M ^ 2) ≤ τ ^ 2 * v M ^ 3 := by
      rw [v.map_mul, v.map_mul, v.map_neg, v.map_pow]
      calc v W.a₁ * v L * v M ^ 2 ≤ 1 * (τ ^ 2 * v M) * v M ^ 2 :=
            mul_le_mul' (mul_le_mul' ha₁ hL_le) le_rfl
        _ = τ ^ 2 * v M ^ 3 := by ring
    have ht2 : v (W.a₂ * M ^ 2) ≤ τ ^ 2 * v M ^ 3 := by
      rw [v.map_mul, v.map_pow]
      calc v W.a₂ * v M ^ 2 = v W.a₂ * 1 * v M ^ 2 := by ring
        _ ≤ 1 * (τ ^ 2 * v M) * v M ^ 2 :=
            mul_le_mul' (mul_le_mul' ha₂ hM_ge2) le_rfl
        _ = τ ^ 2 * v M ^ 3 := by ring
    have ht3 : v (W.a₃ * L ^ 2 * M) ≤ τ ^ 2 * v M ^ 3 := by
      rw [v.map_mul, v.map_mul, v.map_pow, sq]
      calc v W.a₃ * (v L * v L) * v M ≤ 1 * (τ ^ 2 * v M * v M) * v M :=
            mul_le_mul' (mul_le_mul' ha₃ (mul_le_mul' hL_le hL_le_M)) le_rfl
        _ = τ ^ 2 * v M ^ 3 := by ring
    have ht4 : v (2 * W.a₄ * L * M) ≤ τ ^ 2 * v M ^ 3 := by
      rw [v.map_mul, v.map_mul, v.map_mul]
      calc v (2 : K) * v W.a₄ * v L * v M = v (2 : K) * v W.a₄ * v L * (1 * v M) := by ring
        _ ≤ 1 * 1 * (τ ^ 2 * v M) * (v M * v M) :=
            mul_le_mul' (mul_le_mul' (mul_le_mul' h2_le ha₄) hL_le)
              (mul_le_mul' hM_ge_one le_rfl)
        _ = τ ^ 2 * v M ^ 3 := by ring
    have ht5 : v (3 * W.a₆ * L ^ 2) ≤ τ ^ 2 * v M ^ 3 := by
      rw [v.map_mul, v.map_mul, v.map_pow, sq]
      calc v (3 : K) * v W.a₆ * (v L * v L) = v (3 : K) * v W.a₆ * (v L * v L) * 1 := by ring
        _ ≤ 1 * 1 * (τ ^ 2 * v M * v M) * v M :=
            mul_le_mul' (mul_le_mul' (mul_le_mul' h3_le ha₆) (mul_le_mul' hL_le hL_le_M)) hM_ge_one
        _ = τ ^ 2 * v M ^ 3 := by ring
    change v (x₁ * y₂ * y₃' + y₁ * x₂ * y₃' + y₁ * y₂ * x₃) ≤ _
    rw [hT₂]
    refine le_trans (v.map_sub _ _) (max_le ?_ ht5)
    refine le_trans (v.map_add _ _) (max_le ?_ ht4)
    refine le_trans (v.map_add _ _) (max_le ?_ ht3)
    exact le_trans (v.map_sub _ _) (max_le ht1 ht2)
  have h_id1 : x₃ / y₃' - (-x₁ / y₁ + -x₂ / y₂) = N₂ / (y₁ * y₂ * y₃') := by
    change x₃ / y₃' - (-x₁ / y₁ + -x₂ / y₂) =
      (x₁ * y₂ * y₃' + y₁ * x₂ * y₃' + y₁ * y₂ * x₃) / (y₁ * y₂ * y₃')
    field_simp [hy₁_ne, hy₂_ne, hy₃'_ne]
    ring
  have h_err1 : v (x₃ / y₃' - (-x₁ / y₁ + -x₂ / y₂)) ≤ τ ^ 2 := by
    rw [h_id1, v.map_div, v.map_mul, v.map_mul, h_vy123]
    exact (div_le_iff₀ (pow_pos hM_pos 3)).mpr hN₂_le
  have h_t3'_le : v (x₃ / y₃') ≤ τ := by
    have h_split : x₃ / y₃' =
        (x₃ / y₃' - (-x₁ / y₁ + -x₂ / y₂)) + (-x₁ / y₁ + -x₂ / y₂) := by ring
    rw [h_split]
    refine le_trans (v.map_add _ _) (max_le (le_trans h_err1 hτ2_le_τ) ?_)
    exact v.map_add (-x₁ / y₁) (-x₂ / y₂)
  have hx₃_le_τy₃' : v x₃ ≤ τ * v y₃' := by
    rw [v.map_div] at h_t3'_le
    exact (div_le_iff₀ hy₃'_pos).mp h_t3'_le
  have hx₃_lt_y₃' : v x₃ < v y₃' := by
    calc v x₃ ≤ τ * v y₃' := hx₃_le_τy₃'
      _ < 1 * v y₃' := mul_lt_mul_of_pos_right hτ_lt hy₃'_pos
      _ = v y₃' := one_mul _
  have hx₃_gt_one : 1 < v x₃ := by
    have h_sq_lt : v x₃ ^ 2 * 1 < v x₃ ^ 2 * v x₃ := by
      calc v x₃ ^ 2 * 1 = v x₃ ^ 2 := mul_one _
        _ < v y₃' ^ 2 := pow_lt_pow_left₀ hx₃_lt_y₃' (zero_le _) (by decide : 2 ≠ 0)
        _ = v x₃ ^ 3 := hy₃'_sq
        _ = v x₃ ^ 2 * v x₃ := by ring
    exact lt_of_mul_lt_mul_left' h_sq_lt
  have hx₃_ge_one : 1 ≤ v x₃ := le_of_lt hx₃_gt_one
  have h_a13_le : v (W.a₁ * x₃ + W.a₃) ≤ v x₃ := by
    refine le_trans (v.map_add _ _) (max_le ?_ (le_trans ha₃ hx₃_ge_one))
    rw [v.map_mul]
    calc v W.a₁ * v x₃ ≤ 1 * v x₃ := mul_le_mul' ha₁ le_rfl
      _ = v x₃ := one_mul _
  have h_vnegY : v (W.negY x₃ y₃') = v y₃' := by
    have h_negY_eq : W.negY x₃ y₃' = -y₃' + -(W.a₁ * x₃ + W.a₃) := by
      unfold WeierstrassCurve.Affine.negY
      ring
    have h_tail_lt : v (-(W.a₁ * x₃ + W.a₃)) < v (-y₃') := by
      rw [v.map_neg, v.map_neg]
      exact lt_of_le_of_lt h_a13_le hx₃_lt_y₃'
    rw [h_negY_eq, v.map_add_eq_of_lt_left h_tail_lt, v.map_neg]
  have hnegY_ne : W.negY x₃ y₃' ≠ 0 := by
    apply (v.pos_iff).mp
    rw [h_vnegY]
    exact hy₃'_pos
  have h_id2 : -x₃ / W.negY x₃ y₃' - x₃ / y₃' =
      x₃ * (W.a₁ * x₃ + W.a₃) / (W.negY x₃ y₃' * y₃') := by
    field_simp [hnegY_ne, hy₃'_ne]
    unfold WeierstrassCurve.Affine.negY
    ring
  have h_err2 : v (-x₃ / W.negY x₃ y₃' - x₃ / y₃') ≤ τ ^ 2 := by
    rw [h_id2, v.map_div, v.map_mul, v.map_mul, h_vnegY, ← sq]
    refine (div_le_iff₀ (pow_pos hy₃'_pos 2)).mpr ?_
    calc v x₃ * v (W.a₁ * x₃ + W.a₃)
      _ ≤ (τ * v y₃') * (τ * v y₃') :=
          mul_le_mul' hx₃_le_τy₃' (le_trans h_a13_le hx₃_le_τy₃')
      _ = τ ^ 2 * v y₃' ^ 2 := by ring
  refine ⟨hx₃_gt_one, ?_⟩
  have h_decomp : -x₃ / W.negY x₃ y₃' - (-x₁ / y₁ + -x₂ / y₂) =
      (-x₃ / W.negY x₃ y₃' - x₃ / y₃') + (x₃ / y₃' - (-x₁ / y₁ + -x₂ / y₂)) := by ring
  rw [h_decomp]
  exact le_trans (v.map_add _ _) (max_le h_err2 h_err1)

theorem weierstrass_formal_group_torsion_trivial (K : Type u) [Field K] [DecidableEq K]
    (v : Valuation K NNReal) (W : WeierstrassCurve.Affine K)
    (ha₁ : v W.a₁ ≤ 1) (ha₂ : v W.a₂ ≤ 1) (ha₃ : v W.a₃ ≤ 1)
    (ha₄ : v W.a₄ ≤ 1) (ha₆ : v W.a₆ ≤ 1)
    (m : ℕ) (hm : v (m : K) = 1)
    {x y : K} (h : W.Nonsingular x y)
    (hP : m • (WeierstrassCurve.Affine.Point.some h : W.Point) = 0) :
    v x ≤ 1 ∧ v y ≤ 1 :=
by
  let inE₁ : W.Point → Prop
    | 0 => True
    | WeierstrassCurve.Affine.Point.some (x := x') _ => 1 < v x'
  let tParam : W.Point → K
    | 0 => 0
    | WeierstrassCurve.Affine.Point.some (x := x') (y := y') _ => -x' / y'
  have h_add : ∀ (P₁ P₂ : W.Point), inE₁ P₁ → inE₁ P₂ →
      inE₁ (P₁ + P₂) ∧
        v (tParam (P₁ + P₂) - (tParam P₁ + tParam P₂)) ≤
          max (v (tParam P₁)) (v (tParam P₂)) ^ 2 := by
    intro P₁ P₂ hP₁ hP₂
    rcases P₁ with _ | @⟨x₁, y₁, h₁⟩
    · change inE₁ ((0 : W.Point) + P₂) ∧
        v (tParam ((0 : W.Point) + P₂) - (0 + tParam P₂)) ≤ _
      rw [zero_add, zero_add, sub_self, Valuation.map_zero]
      exact ⟨hP₂, zero_le _⟩
    · rcases P₂ with _ | @⟨x₂, y₂, h₂⟩
      · change inE₁ (WeierstrassCurve.Affine.Point.some h₁ + (0 : W.Point)) ∧
          v (tParam (WeierstrassCurve.Affine.Point.some h₁ + (0 : W.Point)) -
            (tParam (WeierstrassCurve.Affine.Point.some h₁) + 0)) ≤ _
        rw [add_zero, add_zero, sub_self, Valuation.map_zero]
        exact ⟨hP₁, zero_le _⟩
      · change 1 < v x₁ at hP₁
        change 1 < v x₂ at hP₂
        obtain ⟨hy₁, hxy₁, hx₁_ne, hy₁_ne, ht₁_pos, ht₁_lt, hw₁, hneg₁⟩ :=
          (weierstrass_formal_group_coord_dichotomy K v W ha₁ ha₂ ha₃ ha₄ ha₆ h₁.1).2 hP₁
        obtain ⟨hy₂, hxy₂, hx₂_ne, hy₂_ne, ht₂_pos, ht₂_lt, hw₂, hneg₂⟩ :=
          (weierstrass_formal_group_coord_dichotomy K v W ha₁ ha₂ ha₃ ha₄ ha₆ h₂.1).2 hP₂
        by_cases hxy : x₁ = x₂ ∧ y₁ = W.negY x₂ y₂
        · have h_sum : (WeierstrassCurve.Affine.Point.some h₁ : W.Point) +
              WeierstrassCurve.Affine.Point.some h₂ = 0 :=
            WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2
          rw [h_sum]
          refine ⟨trivial, ?_⟩
          change v (0 - (-x₁ / y₁ + -x₂ / y₂)) ≤
            max (v (-x₁ / y₁)) (v (-x₂ / y₂)) ^ 2
          rw [zero_sub, Valuation.map_neg, hxy.1, hxy.2]
          exact le_trans hneg₂ (pow_le_pow_left' (le_max_right _ _) 2)
        · have h_sum : (WeierstrassCurve.Affine.Point.some h₁ : W.Point) +
              WeierstrassCurve.Affine.Point.some h₂ =
              WeierstrassCurve.Affine.Point.some (W.nonsingular_add h₁ h₂ hxy) := by
            by_cases hx : x₁ = x₂
            · have hy : y₁ ≠ W.negY x₂ y₂ := fun hy => hxy ⟨hx, hy⟩
              exact WeierstrassCurve.Affine.Point.add_of_Y_ne hy
            · exact WeierstrassCurve.Affine.Point.add_of_X_ne hx
          rw [h_sum]
          obtain ⟨he₃, hT₃, hT₂⟩ :=
            weierstrass_collinearity_vieta_identities K W h₁.1 h₂.1 hxy
          obtain ⟨hM_pos, hL_le, hM_ge⟩ :=
            weierstrass_formal_group_slope_intercept_bounds K v W ha₁ ha₂ ha₃ ha₄ ha₆
              h₁.1 h₂.1 hP₁ hy₁ hxy₁ hy₁_ne ht₁_lt hw₁ hy₂_ne ht₂_lt hw₂ hxy
          exact weierstrass_formal_group_add_param_approx K v W ha₁ ha₂ ha₃ ha₄ ha₆
            hy₁ hx₁_ne hy₁_ne ht₁_lt hy₂ hx₂_ne hy₂_ne ht₂_lt
            he₃ hT₃ hT₂ hM_pos hL_le hM_ge
  have h_nat_le : ∀ k : ℕ, v (k : K) ≤ 1 := by
    intro k
    induction k with
    | zero =>
      rw [Nat.cast_zero, Valuation.map_zero]
      exact zero_le _
    | succ k ih =>
      rw [Nat.cast_add, Nat.cast_one]
      exact le_trans (v.map_add _ _) (max_le ih (le_of_eq v.map_one))
  have hx_le : v x ≤ 1 := by
    by_contra hx_gt
    have hx : 1 < v x := not_le.mp hx_gt
    obtain ⟨_, _, _, _, ht_pos, ht_lt, _, _⟩ :=
      (weierstrass_formal_group_coord_dichotomy K v W ha₁ ha₂ ha₃ ha₄ ha₆ h.1).2 hx
    set P : W.Point := WeierstrassCurve.Affine.Point.some h
    have hP_in : inE₁ P := hx
    have ht_le : v (tParam P) ≤ 1 := le_of_lt ht_lt
    have ht_sq_le : v (tParam P) ^ 2 ≤ v (tParam P) := by
      calc v (tParam P) ^ 2 = v (tParam P) * v (tParam P) := sq _
        _ ≤ 1 * v (tParam P) := mul_le_mul' ht_le le_rfl
        _ = v (tParam P) := one_mul _
    have h_nsmul : ∀ k : ℕ,
        inE₁ (k • P) ∧ v (tParam (k • P) - (k : K) * tParam P) ≤ v (tParam P) ^ 2 := by
      intro k
      induction k with
      | zero =>
        rw [zero_nsmul, Nat.cast_zero, zero_mul]
        refine ⟨trivial, ?_⟩
        change v (0 - 0) ≤ _
        rw [sub_self, Valuation.map_zero]
        exact zero_le _
      | succ k ih =>
        rw [succ_nsmul]
        have h_tk_le : v (tParam (k • P)) ≤ v (tParam P) := by
          have h_split : tParam (k • P) =
              (tParam (k • P) - (k : K) * tParam P) + (k : K) * tParam P := by ring
          rw [h_split]
          refine le_trans (v.map_add _ _) (max_le (le_trans ih.2 ht_sq_le) ?_)
          rw [v.map_mul]
          calc v (k : K) * v (tParam P) ≤ 1 * v (tParam P) := mul_le_mul' (h_nat_le k) le_rfl
            _ = v (tParam P) := one_mul _
        have h_max : max (v (tParam (k • P))) (v (tParam P)) ≤ v (tParam P) :=
          max_le h_tk_le le_rfl
        obtain ⟨h_in_next, h_err_next⟩ := h_add (k • P) P ih.1 hP_in
        refine ⟨h_in_next, ?_⟩
        have h_err_next' :
            v (tParam (k • P + P) - (tParam (k • P) + tParam P)) ≤ v (tParam P) ^ 2 :=
          le_trans h_err_next (pow_le_pow_left' h_max 2)
        have h_decomp : tParam (k • P + P) - ((k + 1 : ℕ) : K) * tParam P =
            (tParam (k • P + P) - (tParam (k • P) + tParam P)) +
              (tParam (k • P) - (k : K) * tParam P) := by
          push_cast
          ring
        rw [h_decomp]
        exact le_trans (v.map_add _ _) (max_le h_err_next' ih.2)
    have h_m := (h_nsmul m).2
    rw [hP] at h_m
    change v (0 - (m : K) * (-x / y)) ≤ v (-x / y) ^ 2 at h_m
    rw [zero_sub, Valuation.map_neg, Valuation.map_mul, hm, one_mul] at h_m
    have ht_sq_lt : v (-x / y) ^ 2 < v (-x / y) := by
      rw [sq]
      calc v (-x / y) * v (-x / y) < 1 * v (-x / y) :=
            mul_lt_mul_of_pos_right ht_lt ht_pos
        _ = v (-x / y) := one_mul _
    exact not_lt_of_ge h_m ht_sq_lt
  exact ⟨hx_le, (weierstrass_formal_group_coord_dichotomy K v W ha₁ ha₂ ha₃ ha₄ ha₆ h.1).1 hx_le⟩

theorem weierstrass_sub_coord_gt_one_of_residue_eq (K : Type u) [Field K] [DecidableEq K]
    (v : Valuation K NNReal) (W : WeierstrassCurve.Affine K)
    (ha₁ : v W.a₁ ≤ 1) (ha₂ : v W.a₂ ≤ 1) (ha₃ : v W.a₃ ≤ 1)
    (ha₄ : v W.a₄ ≤ 1) (ha₆ : v W.a₆ ≤ 1) (hΔ : v W.Δ = 1)
    {x₁ y₁ x₂ y₂ x₃ y₃ : K}
    (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂) (h₃ : W.Nonsingular x₃ y₃)
    (hx₁ : v x₁ ≤ 1) (hy₁ : v y₁ ≤ 1) (hx₂ : v x₂ ≤ 1) (hy₂ : v y₂ ≤ 1)
    (hxx : v (x₁ - x₂) < 1) (hyy : v (y₁ - y₂) < 1)
    (h_sub : (WeierstrassCurve.Affine.Point.some h₁ : W.Point) -
      WeierstrassCurve.Affine.Point.some h₂ = WeierstrassCurve.Affine.Point.some h₃) :
    1 < v x₃ :=
by
  let A₁ : ↥v.valuationSubring := ⟨W.a₁, ha₁⟩
  let A₂ : ↥v.valuationSubring := ⟨W.a₂, ha₂⟩
  let A₃ : ↥v.valuationSubring := ⟨W.a₃, ha₃⟩
  let A₄ : ↥v.valuationSubring := ⟨W.a₄, ha₄⟩
  let X₁ : ↥v.valuationSubring := ⟨x₁, hx₁⟩
  let Y₁ : ↥v.valuationSubring := ⟨y₁, hy₁⟩
  let X₂ : ↥v.valuationSubring := ⟨x₂, hx₂⟩
  let DY : ↥v.valuationSubring := 2 * Y₁ + A₁ * X₁ + A₃
  let DX : ↥v.valuationSubring := 3 * X₁ ^ 2 + 2 * A₂ * X₁ + A₄ - A₁ * Y₁
  let A₂' : ↥v.valuationSubring := A₂ + 3 * X₁
  let B₂' : ↥v.valuationSubring := A₁ ^ 2 + 4 * A₂'
  let B₄' : ↥v.valuationSubring := 2 * DX + A₁ * DY
  let PY : ↥v.valuationSubring :=
    -B₂' ^ 2 * A₂' * DY - 8 * B₄' ^ 2 * A₁ - 27 * DY ^ 3 + 9 * B₂' * B₄' * DY
  let PX : ↥v.valuationSubring := B₂' ^ 2 * (A₁ * DY + DX) - 16 * B₄' ^ 2
  let D_y : K := (DY : K)
  let D_x : K := (DX : K)
  let P_y : K := (PY : K)
  let P_x : K := (PX : K)
  have hD_y_eq : D_y = 2 * y₁ + W.a₁ * x₁ + W.a₃ := by
    push_cast [D_y, DY, A₁, A₃, X₁, Y₁]
    rfl
  have hD_x_eq : D_x = 3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁ := by
    push_cast [D_x, DX, A₁, A₂, A₄, X₁, Y₁]
    rfl
  have hD_y : v D_y ≤ 1 := DY.2
  have hD_x : v D_x ≤ 1 := DX.2
  have hP_y : v P_y ≤ 1 := PY.2
  have hP_x : v P_x ≤ 1 := PX.2
  have h_eq1 : y₁ ^ 2 + W.a₁ * x₁ * y₁ + W.a₃ * y₁ = x₁ ^ 3 + W.a₂ * x₁ ^ 2 + W.a₄ * x₁ + W.a₆ :=
    (W.equation_iff x₁ y₁).mp h₁.1
  have ha₆_eq : W.a₆ = y₁ ^ 2 + W.a₁ * x₁ * y₁ + W.a₃ * y₁ - x₁ ^ 3 - W.a₂ * x₁ ^ 2 - W.a₄ * x₁ := by
    linear_combination -h_eq1
  have h_Δ_id : W.Δ = D_y * P_y + D_x * P_x := by
    have hP_y_eq : P_y = -(W.a₁ ^ 2 + 4 * (W.a₂ + 3 * x₁)) ^ 2 * (W.a₂ + 3 * x₁) * D_y
        - 8 * (2 * D_x + W.a₁ * D_y) ^ 2 * W.a₁ - 27 * D_y ^ 3
        + 9 * (W.a₁ ^ 2 + 4 * (W.a₂ + 3 * x₁)) * (2 * D_x + W.a₁ * D_y) * D_y := by
      push_cast [P_y, PY, B₂', B₄', A₂', D_y, D_x, A₁, A₂, X₁]
      rfl
    have hP_x_eq : P_x = (W.a₁ ^ 2 + 4 * (W.a₂ + 3 * x₁)) ^ 2 * (W.a₁ * D_y + D_x)
        - 16 * (2 * D_x + W.a₁ * D_y) ^ 2 := by
      push_cast [P_x, PX, B₂', B₄', A₂', D_y, D_x, A₁, A₂, X₁]
      rfl
    change WeierstrassCurve.Δ W = D_y * P_y + D_x * P_x
    unfold WeierstrassCurve.Δ WeierstrassCurve.b₂ WeierstrassCurve.b₄ WeierstrassCurve.b₆ WeierstrassCurve.b₈
    rw [ha₆_eq, hP_y_eq, hP_x_eq, hD_y_eq, hD_x_eq]
    ring
  have h_unit : v D_y = 1 ∨ v D_x = 1 := by
    by_contra! h_not
    have hDy_lt : v D_y < 1 := lt_of_le_of_ne hD_y h_not.1
    have hDx_lt : v D_x < 1 := lt_of_le_of_ne hD_x h_not.2
    have h1 : v (D_y * P_y) < 1 := by
      rw [v.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' hP_y) hDy_lt
    have h2 : v (D_x * P_x) < 1 := by
      rw [v.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' hP_x) hDx_lt
    have h3 : v W.Δ < 1 := by
      rw [h_Δ_id]
      exact lt_of_le_of_lt (v.map_add _ _) (max_lt h1 h2)
    rw [hΔ] at h3
    exact lt_irrefl (1 : NNReal) h3
  set y₂' : K := W.negY x₂ y₂
  have h₂' : W.Nonsingular x₂ y₂' := (W.nonsingular_neg x₂ y₂).mpr h₂
  have h_add : (WeierstrassCurve.Affine.Point.some h₁ : W.Point) +
      WeierstrassCurve.Affine.Point.some h₂' = WeierstrassCurve.Affine.Point.some h₃ := by
    rw [← WeierstrassCurve.Affine.Point.neg_some h₂, ← sub_eq_add_neg]
    exact h_sub
  have hxy : ¬ (x₁ = x₂ ∧ y₁ = W.negY x₂ y₂') := by
    rintro ⟨hx_eq, hy_eq⟩
    have h0 : (WeierstrassCurve.Affine.Point.some h₁ : W.Point) +
        WeierstrassCurve.Affine.Point.some h₂' = 0 :=
      WeierstrassCurve.Affine.Point.add_of_Y_eq hx_eq hy_eq
    rw [h0] at h_add
    exact WeierstrassCurve.Affine.Point.some_ne_zero h₃ h_add.symm
  rw [WeierstrassCurve.Affine.Point.add_some hxy] at h_add
  have hx₃_eq : W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂') = x₃ := by
    rw [WeierstrassCurve.Affine.Point.some.injEq] at h_add
    exact h_add.1
  set L : K := W.slope x₁ x₂ y₁ y₂'
  have hL_gt_one : ∀ δ : K, v (L * δ) = 1 → v δ < 1 → 1 < v L := by
    intro δ hLδ hδ
    by_contra! hL_le
    have h_lt : v (L * δ) < 1 := by
      rw [v.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' hL_le) hδ
    rw [hLδ] at h_lt
    exact lt_irrefl (1 : NNReal) h_lt
  have hDy_case : v D_y = 1 → 1 < v L := by
    intro hvDy
    have hy_id : y₁ - y₂' = D_y + ((y₂ - y₁) + W.a₁ * (x₂ - x₁)) := by
      change y₁ - W.negY x₂ y₂ = D_y + ((y₂ - y₁) + W.a₁ * (x₂ - x₁))
      unfold WeierstrassCurve.Affine.negY
      rw [hD_y_eq]
      ring
    have hy21 : v (y₂ - y₁) < 1 := by
      rw [Valuation.map_sub_swap]
      exact hyy
    have hx21 : v (x₂ - x₁) < 1 := by
      rw [Valuation.map_sub_swap]
      exact hxx
    have ha1x : v (W.a₁ * (x₂ - x₁)) < 1 := by
      rw [v.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' ha₁) hx21
    have h_rem_lt : v ((y₂ - y₁) + W.a₁ * (x₂ - x₁)) < v D_y := by
      rw [hvDy]
      exact lt_of_le_of_lt (v.map_add _ _) (max_lt hy21 ha1x)
    have hy_val : v (y₁ - y₂') = 1 := by
      rw [hy_id, Valuation.map_add_eq_of_lt_left v h_rem_lt, hvDy]
    have hx_ne : x₁ ≠ x₂ := by
      intro hx_eq
      have hy_ne : y₁ ≠ W.negY x₂ y₂' := fun hy_eq => hxy ⟨hx_eq, hy_eq⟩
      have hy_eq' : y₁ = y₂' := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂'.1 hx_eq hy_ne
      rw [hy_eq', sub_self, Valuation.map_zero] at hy_val
      exact zero_ne_one hy_val
    have hL_eq : L = (y₁ - y₂') / (x₁ - x₂) :=
      WeierstrassCurve.Affine.slope_of_X_ne hx_ne
    have hL_mul : L * (x₁ - x₂) = y₁ - y₂' := by
      rw [hL_eq, div_mul_cancel₀ _ (sub_ne_zero.mpr hx_ne)]
    apply hL_gt_one (x₁ - x₂) _ hxx
    rw [hL_mul, hy_val]
  have hL : 1 < v L := by
    by_cases hvDy : v D_y = 1
    · exact hDy_case hvDy
    · have hvDx : v D_x = 1 := h_unit.resolve_left hvDy
      have hvDy_lt : v D_y < 1 := lt_of_le_of_ne hD_y hvDy
      by_cases hx_eq : x₁ = x₂
      · have hy_ne : y₁ ≠ W.negY x₂ y₂' := fun hy_eq => hxy ⟨hx_eq, hy_eq⟩
        have hy_eq' : y₁ = y₂' := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂'.1 hx_eq hy_ne
        have hL_eq : L = (3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) / (y₁ - W.negY x₁ y₁) :=
          WeierstrassCurve.Affine.slope_of_Y_ne hx_eq hy_ne
        have hDy_denom : y₁ - W.negY x₁ y₁ = D_y := by
          unfold WeierstrassCurve.Affine.negY
          rw [hD_y_eq]
          ring
        have hDy_ne : D_y ≠ 0 := by
          rw [← hDy_denom]
          apply sub_ne_zero.mpr
          rwa [← hx_eq, ← hy_eq'] at hy_ne
        have hL_mul : L * D_y = D_x := by
          rw [hL_eq, ← hD_x_eq, hDy_denom, div_mul_cancel₀ _ hDy_ne]
        apply hL_gt_one D_y _ hvDy_lt
        rw [hL_mul, hvDx]
      · have h_eq2 : y₂ ^ 2 + W.a₁ * x₂ * y₂ + W.a₃ * y₂ = x₂ ^ 3 + W.a₂ * x₂ ^ 2 + W.a₄ * x₂ + W.a₆ :=
          (W.equation_iff x₂ y₂).mp h₂.1
        let CX : ↥v.valuationSubring := X₂ + 2 * X₁ + A₂
        let C_x : K := (CX : K)
        have hCx_eq : C_x = x₂ + 2 * x₁ + W.a₂ := by
          push_cast [C_x, CX, X₁, X₂, A₂]
          rfl
        have hCx_le : v C_x ≤ 1 := CX.2
        have h_chord : (y₁ - y₂) * (y₁ - y₂') = (x₁ - x₂) * (D_x + (x₂ - x₁) * C_x) := by
          change (y₁ - y₂) * (y₁ - W.negY x₂ y₂) = (x₁ - x₂) * (D_x + (x₂ - x₁) * C_x)
          unfold WeierstrassCurve.Affine.negY
          rw [hD_x_eq, hCx_eq]
          linear_combination h_eq1 - h_eq2
        have hL_eq : L = (y₁ - y₂') / (x₁ - x₂) :=
          WeierstrassCurve.Affine.slope_of_X_ne hx_eq
        have hy_sub_eq : y₁ - y₂' = L * (x₁ - x₂) := by
          rw [hL_eq, div_mul_cancel₀ _ (sub_ne_zero.mpr hx_eq)]
        have hL_mul : L * (y₁ - y₂) = D_x + (x₂ - x₁) * C_x := by
          apply mul_right_cancel₀ (sub_ne_zero.mpr hx_eq)
          calc L * (y₁ - y₂) * (x₁ - x₂)
            _ = (y₁ - y₂) * (L * (x₁ - x₂)) := by ring
            _ = (y₁ - y₂) * (y₁ - y₂') := by rw [← hy_sub_eq]
            _ = (x₁ - x₂) * (D_x + (x₂ - x₁) * C_x) := h_chord
            _ = (D_x + (x₂ - x₁) * C_x) * (x₁ - x₂) := by ring
        have hx21 : v (x₂ - x₁) < 1 := by
          rw [Valuation.map_sub_swap]
          exact hxx
        have h_rem_lt : v ((x₂ - x₁) * C_x) < v D_x := by
          rw [hvDx, v.map_mul]
          exact lt_of_le_of_lt (mul_le_of_le_one_right' hCx_le) hx21
        apply hL_gt_one (y₁ - y₂) _ hyy
        rw [hL_mul, Valuation.map_add_eq_of_lt_left v h_rem_lt, hvDx]
  let C0 : ↥v.valuationSubring := -A₂ - X₁ - X₂
  let C_0 : K := (C0 : K)
  have hC0_eq : C_0 = -W.a₂ - x₁ - x₂ := by
    push_cast [C_0, C0, A₂, X₁, X₂]
    rfl
  have hC0_le : v C_0 ≤ 1 := C0.2
  have hx3_id : x₃ = L ^ 2 + (W.a₁ * L + C_0) := by
    have h_addX : W.addX x₁ x₂ L = x₃ := hx₃_eq
    rw [← h_addX]
    unfold WeierstrassCurve.Affine.addX
    rw [hC0_eq]
    ring
  have hL_pos : 0 < v L := zero_lt_one.trans hL
  have hL_lt_sq : v L < v (L ^ 2) := by
    rw [sq, v.map_mul]
    exact lt_mul_of_one_lt_left hL_pos hL
  have ha1L_lt : v (W.a₁ * L) < v (L ^ 2) := by
    rw [v.map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_left' ha₁) hL_lt_sq
  have hC0_lt : v C_0 < v (L ^ 2) :=
    lt_of_le_of_lt hC0_le (hL.trans hL_lt_sq)
  have h_rem_lt : v (W.a₁ * L + C_0) < v (L ^ 2) :=
    lt_of_le_of_lt (v.map_add _ _) (max_lt ha1L_lt hC0_lt)
  rw [hx3_id, Valuation.map_add_eq_of_lt_left v h_rem_lt]
  exact hL.trans hL_lt_sq

theorem exists_finite_ext_torsion_fixed_of_isPotentiallyGood (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0)
    (hE : EllipticRootNumber.IsPotentiallyGood F E) :
    ∃ L : IntermediateField F (AlgebraicClosure F), FiniteDimensional F L ∧
      ∀ σ : EllipticRootNumber.AbsGal F,
        σ ∈ L.fixingSubgroup → σ ∈ EllipticRootNumber.inertia F →
        ∀ (n : ℕ) (P : EllipticRootNumber.Pts F E),
          P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) →
            EllipticRootNumber.galHom F E σ P = P :=
by
  classical
  obtain ⟨v, hv_gal, hv_le, hv_lt, _hv_eq, hv_minpoly, hv_ell⟩ :=
    exists_galois_invariant_valuation_extension F
  let K := AlgebraicClosure F
  let W₁ : WeierstrassCurve K := E.baseChange K
  have hΔ₁ : W₁.Δ ≠ 0 := by
    change (E.map (algebraMap F K)).Δ ≠ 0
    rw [WeierstrassCurve.map_Δ]
    exact (map_ne_zero (algebraMap F K)).mpr hΔ
  have hj₁ : v (W₁.c₄ ^ 3 / W₁.Δ) ≤ 1 := by
    change v ((E.map (algebraMap F K)).c₄ ^ 3 / (E.map (algebraMap F K)).Δ) ≤ 1
    rw [WeierstrassCurve.map_c₄, WeierstrassCurve.map_Δ, ← map_pow, ← map_div₀]
    exact (hv_le (E.c₄ ^ 3 / E.Δ)).mpr hE
  
  have h_s5 : ∃ C : WeierstrassCurve.VariableChange K,
      v (C • W₁).a₁ ≤ 1 ∧ v (C • W₁).a₂ ≤ 1 ∧ v (C • W₁).a₃ ≤ 1 ∧
      v (C • W₁).a₄ ≤ 1 ∧ v (C • W₁).a₆ ≤ 1 ∧ v (C • W₁).Δ = 1 := by
    have hv_nat : ∀ n : ℕ, v (n : K) ≤ 1 := by
      intro n
      induction n with
      | zero => simp
      | succ k ih =>
        rw [Nat.cast_succ]
        exact le_trans (v.map_add _ _) (max_le ih (by rw [map_one]))
    have h3_le : v (3 : K) ≤ 1 := by exact_mod_cast hv_nat 3
    have h2_le : v (2 : K) ≤ 1 := by exact_mod_cast hv_nat 2
    have h32 : v (3 : K) = 1 ∨ v (2 : K) = 1 := by
      have h1 : (1 : NNReal) ≤ max (v (3 : K)) (v (2 : K)) := by
        calc (1 : NNReal) = v 1 := v.map_one.symm
          _ = v ((3 : K) - 2) := by norm_num
          _ ≤ max (v (3 : K)) (v (2 : K)) := v.map_sub _ _
      rcases le_max_iff.mp h1 with h3 | h2
      · exact Or.inl (le_antisymm h3_le h3)
      · exact Or.inr (le_antisymm h2_le h2)
    set j : K := W₁.c₄ ^ 3 / W₁.Δ
    suffices h_model : ∃ E' : WeierstrassCurve K,
        v E'.a₁ ≤ 1 ∧ v E'.a₂ ≤ 1 ∧ v E'.a₃ ≤ 1 ∧
        v E'.a₄ ≤ 1 ∧ v E'.a₆ ≤ 1 ∧ v E'.Δ = 1 ∧ E'.c₄ ^ 3 / E'.Δ = j by
      obtain ⟨E', ha₁, ha₂, ha₃, ha₄, ha₆, hΔ', hj'⟩ := h_model
      have hΔ'_ne : E'.Δ ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hΔ'
        exact zero_ne_one hΔ'
      haveI : W₁.IsElliptic := ⟨IsUnit.mk0 W₁.Δ hΔ₁⟩
      haveI : E'.IsElliptic := ⟨IsUnit.mk0 E'.Δ hΔ'_ne⟩
      have hj_eq : W₁.j = E'.j := by
        rw [WeierstrassCurve.j, WeierstrassCurve.j, Units.val_inv_eq_inv_val,
          Units.val_inv_eq_inv_val, WeierstrassCurve.coe_Δ', WeierstrassCurve.coe_Δ',
          inv_mul_eq_div, inv_mul_eq_div, hj']
      obtain ⟨C, hC⟩ := WeierstrassCurve.exists_variableChange_of_j_eq W₁ E' hj_eq
      refine ⟨C, ?_⟩
      rw [hC]
      exact ⟨ha₁, ha₂, ha₃, ha₄, ha₆, hΔ'⟩
    rcases h32 with h3 | h2
    · let P₁ : Polynomial K :=
        Polynomial.X ^ 4 + Polynomial.C 36 * Polynomial.X ^ 3 +
          Polynomial.C 270 * Polynomial.X ^ 2 + Polynomial.C (756 - j) * Polynomial.X +
          Polynomial.C 729
      have hdeg₁ : P₁.degree = 4 := by dsimp [P₁]; compute_degree!
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root P₁ (by rw [hdeg₁]; decide)
      have hz_eq : z ^ 4 + 36 * z ^ 3 + 270 * z ^ 2 + (756 - j) * z + 729 = 0 := by
        simpa [P₁, Polynomial.IsRoot] using hz
      have hv36 : v (36 : K) ≤ 1 := by exact_mod_cast hv_nat 36
      have hv270 : v (270 : K) ≤ 1 := by exact_mod_cast hv_nat 270
      have hv756 : v (756 : K) ≤ 1 := by exact_mod_cast hv_nat 756
      have hv729 : v (729 : K) = 1 := by
        have : (729 : K) = (3 : K) ^ 6 := by norm_num
        rw [this, map_pow, h3, one_pow]
      have hv756j : v (756 - j) ≤ 1 := le_trans (v.map_sub _ _) (max_le hv756 hj₁)
      have hz_le : v z ≤ 1 := by
        by_contra h_gt
        push_neg at h_gt
        have hz1 : (1 : NNReal) ≤ v z := le_of_lt h_gt
        have hz2 : v z ≤ v z ^ 2 := by simpa using pow_le_pow_right₀ hz1 (by norm_num : 1 ≤ 2)
        have hz3 : v z ^ 2 ≤ v z ^ 3 := pow_le_pow_right₀ hz1 (by norm_num : 2 ≤ 3)
        have hz4_eq : z ^ 4 = -(36 * z ^ 3 + 270 * z ^ 2 + (756 - j) * z + 729) := by
          linear_combination hz_eq
        have hv_z4 : v z ^ 4 ≤ v z ^ 3 := by
          calc v z ^ 4 = v (z ^ 4) := (map_pow v z 4).symm
            _ = v (36 * z ^ 3 + 270 * z ^ 2 + (756 - j) * z + 729) := by
                rw [hz4_eq, Valuation.map_neg]
            _ ≤ max (v (36 * z ^ 3 + 270 * z ^ 2 + (756 - j) * z)) (v (729 : K)) :=
                v.map_add _ _
            _ ≤ max (max (v (36 * z ^ 3 + 270 * z ^ 2)) (v ((756 - j) * z))) 1 :=
                max_le_max (v.map_add _ _) (le_of_eq hv729)
            _ ≤ max (max (max (v (36 * z ^ 3)) (v (270 * z ^ 2))) (v ((756 - j) * z))) 1 :=
                max_le_max (max_le_max (v.map_add _ _) le_rfl) le_rfl
            _ ≤ v z ^ 3 := by
                refine max_le (max_le (max_le ?_ ?_) ?_) (le_trans hz1 (le_trans hz2 hz3))
                · rw [map_mul, map_pow]; exact mul_le_of_le_one_left (zero_le _) hv36
                · rw [map_mul, map_pow]
                  exact le_trans (mul_le_of_le_one_left (zero_le _) hv270) hz3
                · rw [map_mul]
                  exact le_trans (mul_le_of_le_one_left (zero_le _) hv756j) (le_trans hz2 hz3)
        have hv_z4_gt : v z ^ 3 < v z ^ 4 := by
          rw [pow_succ]
          exact lt_mul_of_one_lt_right (pow_pos (lt_of_lt_of_le zero_lt_one hz1) 3) h_gt
        exact not_lt_of_ge hv_z4 hv_z4_gt
      have hz_ge : 1 ≤ v z := by
        have h729_eq : (729 : K) = -z * (z ^ 3 + 36 * z ^ 2 + 270 * z + (756 - j)) := by
          linear_combination hz_eq
        have hv_fac : v (z ^ 3 + 36 * z ^ 2 + 270 * z + (756 - j)) ≤ 1 := by
          refine le_trans (v.map_add _ _) (max_le ?_ hv756j)
          refine le_trans (v.map_add _ _) (max_le ?_ ?_)
          · refine le_trans (v.map_add _ _) (max_le ?_ ?_)
            · rw [map_pow]; exact pow_le_one₀ (zero_le _) hz_le
            · rw [map_mul, map_pow]
              exact mul_le_one₀ hv36 (zero_le _) (pow_le_one₀ (zero_le _) hz_le)
          · rw [map_mul]; exact mul_le_one₀ hv270 (zero_le _) hz_le
        calc (1 : NNReal) = v (729 : K) := hv729.symm
          _ = v (-z * (z ^ 3 + 36 * z ^ 2 + 270 * z + (756 - j))) := by rw [h729_eq]
          _ = v z * v (z ^ 3 + 36 * z ^ 2 + 270 * z + (756 - j)) := by
              rw [map_mul, Valuation.map_neg]
          _ ≤ v z * 1 := mul_le_mul_of_nonneg_left hv_fac (zero_le _)
          _ = v z := mul_one _
      have hvz : v z = 1 := le_antisymm hz_le hz_ge
      have hz_ne : z ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hvz
        exact zero_ne_one hvz
      obtain ⟨a₁, ha₁_pow⟩ := IsAlgClosed.exists_pow_nat_eq (z + 27) (by norm_num : 0 < 3)
      have hv27 : v (27 : K) ≤ 1 := by exact_mod_cast hv_nat 27
      have hva₁_pow : v a₁ ^ 3 ≤ 1 := by
        rw [← map_pow, ha₁_pow]
        exact le_trans (v.map_add _ _) (max_le hz_le hv27)
      have hva₁ : v a₁ ≤ 1 := by
        by_contra h_gt
        push_neg at h_gt
        have : 1 < v a₁ ^ 3 := one_lt_pow₀ h_gt (by norm_num)
        exact not_lt_of_ge hva₁_pow this
      let E' : WeierstrassCurve K := ⟨a₁, 0, 1, 0, 0⟩
      have hE'_Δ : E'.Δ = z := by
        dsimp [E', WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
          WeierstrassCurve.b₆, WeierstrassCurve.b₈]
        linear_combination ha₁_pow
      have hc4 : E'.c₄ = a₁ * (z + 3) := by
        dsimp [E', WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
        linear_combination a₁ * ha₁_pow
      have hE'_c4 : E'.c₄ ^ 3 = j * z := by
        rw [hc4, mul_pow, ha₁_pow]
        linear_combination hz_eq
      refine ⟨E', hva₁, by simp [E'], by simp [E'], by simp [E'], by simp [E'],
        by rw [hE'_Δ, hvz], ?_⟩
      rw [hE'_c4, hE'_Δ, mul_div_cancel_right₀ j hz_ne]
    · have hv256 : v (256 : K) = 1 := by
        have : (256 : K) = (2 : K) ^ 8 := by norm_num
        rw [this, map_pow, h2, one_pow]
      have h256_ne : (256 : K) ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hv256
        exact zero_ne_one hv256
      have hv_j256 : v (j / 256) ≤ 1 := by
        rw [map_div₀, hv256, div_one]
        exact hj₁
      let P₂ : Polynomial K :=
        Polynomial.X ^ 3 + Polynomial.C 3 * Polynomial.X ^ 2 +
          Polynomial.C (3 - j / 256) * Polynomial.X + Polynomial.C 1
      have hdeg₂ : P₂.degree = 3 := by dsimp [P₂]; compute_degree!
      obtain ⟨u, hu⟩ := IsAlgClosed.exists_root P₂ (by rw [hdeg₂]; decide)
      have hu_eq : u ^ 3 + 3 * u ^ 2 + (3 - j / 256) * u + 1 = 0 := by
        simpa [P₂, Polynomial.IsRoot] using hu
      have hv3j : v (3 - j / 256) ≤ 1 := le_trans (v.map_sub _ _) (max_le h3_le hv_j256)
      have hu_le : v u ≤ 1 := by
        by_contra h_gt
        push_neg at h_gt
        have hu1 : (1 : NNReal) ≤ v u := le_of_lt h_gt
        have hu2 : v u ≤ v u ^ 2 := by simpa using pow_le_pow_right₀ hu1 (by norm_num : 1 ≤ 2)
        have hu3_eq : u ^ 3 = -(3 * u ^ 2 + (3 - j / 256) * u + 1) := by
          linear_combination hu_eq
        have hv_u3 : v u ^ 3 ≤ v u ^ 2 := by
          calc v u ^ 3 = v (u ^ 3) := (map_pow v u 3).symm
            _ = v (3 * u ^ 2 + (3 - j / 256) * u + 1) := by rw [hu3_eq, Valuation.map_neg]
            _ ≤ max (v (3 * u ^ 2 + (3 - j / 256) * u)) (v (1 : K)) := v.map_add _ _
            _ ≤ max (max (v (3 * u ^ 2)) (v ((3 - j / 256) * u))) 1 :=
                max_le_max (v.map_add _ _) (le_of_eq v.map_one)
            _ ≤ v u ^ 2 := by
                refine max_le (max_le ?_ ?_) (le_trans hu1 hu2)
                · rw [map_mul, map_pow]; exact mul_le_of_le_one_left (zero_le _) h3_le
                · rw [map_mul]; exact le_trans (mul_le_of_le_one_left (zero_le _) hv3j) hu2
        have hv_u3_gt : v u ^ 2 < v u ^ 3 := by
          rw [pow_succ]
          exact lt_mul_of_one_lt_right (pow_pos (lt_of_lt_of_le zero_lt_one hu1) 2) h_gt
        exact not_lt_of_ge hv_u3 hv_u3_gt
      have hu_ge : 1 ≤ v u := by
        have h1_eq : (1 : K) = -u * (u ^ 2 + 3 * u + (3 - j / 256)) := by
          linear_combination hu_eq
        have hv_fac : v (u ^ 2 + 3 * u + (3 - j / 256)) ≤ 1 := by
          refine le_trans (v.map_add _ _) (max_le ?_ hv3j)
          refine le_trans (v.map_add _ _) (max_le ?_ ?_)
          · rw [map_pow]; exact pow_le_one₀ (zero_le _) hu_le
          · rw [map_mul]; exact mul_le_one₀ h3_le (zero_le _) hu_le
        calc (1 : NNReal) = v (1 : K) := v.map_one.symm
          _ = v (-u * (u ^ 2 + 3 * u + (3 - j / 256))) := by rw [h1_eq]
          _ = v u * v (u ^ 2 + 3 * u + (3 - j / 256)) := by rw [map_mul, Valuation.map_neg]
          _ ≤ v u * 1 := mul_le_mul_of_nonneg_left hv_fac (zero_le _)
          _ = v u := mul_one _
      have hvu : v u = 1 := le_antisymm hu_le hu_ge
      obtain ⟨a₂, ha₂_pow⟩ := IsAlgClosed.exists_pow_nat_eq (u + 4) (by norm_num : 0 < 2)
      have hv4 : v (4 : K) ≤ 1 := by exact_mod_cast hv_nat 4
      have hva₂_pow : v a₂ ^ 2 ≤ 1 := by
        rw [← map_pow, ha₂_pow]
        exact le_trans (v.map_add _ _) (max_le hu_le hv4)
      have hva₂ : v a₂ ≤ 1 := by
        by_contra h_gt
        push_neg at h_gt
        have : 1 < v a₂ ^ 2 := one_lt_pow₀ h_gt (by norm_num)
        exact not_lt_of_ge hva₂_pow this
      let E' : WeierstrassCurve K := ⟨0, a₂, 0, 1, 0⟩
      have hE'_Δ : E'.Δ = 16 * u := by
        dsimp [E', WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
          WeierstrassCurve.b₆, WeierstrassCurve.b₈]
        linear_combination 16 * ha₂_pow
      have hvE'_Δ : v E'.Δ = 1 := by
        have h16 : (16 : K) = (2 : K) ^ 4 := by norm_num
        rw [hE'_Δ, map_mul, h16, map_pow, h2, one_pow, one_mul, hvu]
      have hE'_Δ_ne : E'.Δ ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hvE'_Δ
        exact zero_ne_one hvE'_Δ
      have hc4 : E'.c₄ = 16 * (u + 1) := by
        dsimp [E', WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
        linear_combination 16 * ha₂_pow
      have h256_mul : (256 : K) * (j / 256) = j := mul_div_cancel₀ j h256_ne
      have hE'_c4 : E'.c₄ ^ 3 = j * E'.Δ := by
        rw [hc4, hE'_Δ]
        linear_combination 4096 * hu_eq + 16 * u * h256_mul
      refine ⟨E', by simp [E'], hva₂, by simp [E'], by simp [E'], by simp [E'], hvE'_Δ, ?_⟩
      rw [hE'_c4, mul_div_cancel_right₀ j hE'_Δ_ne]
  obtain ⟨C, hva₁, hva₂, hva₃, hva₄, hva₆, hvΔ⟩ := h_s5
  
  let W₁' : WeierstrassCurve.Affine K := W₁.toAffine
  let W₂' : WeierstrassCurve.Affine K := (C • W₁).toAffine
  let u : K := C.u
  let u_inv : K := (C.u⁻¹ : Kˣ)
  let r : K := C.r
  let s : K := C.s
  let t : K := C.t
  have huu : u * u_inv = 1 := Units.mul_inv C.u
  have huu' : u_inv * u = 1 := Units.inv_mul C.u
  have hu_inv : u_inv ≠ 0 := Units.ne_zero C.u⁻¹
  have ha₁ : W₂'.a₁ = u_inv * (W₁'.a₁ + 2 * s) := WeierstrassCurve.variableChange_a₁ W₁ C
  have ha₂ : W₂'.a₂ = u_inv ^ 2 * (W₁'.a₂ - s * W₁'.a₁ + 3 * r - s ^ 2) :=
    WeierstrassCurve.variableChange_a₂ W₁ C
  have ha₃ : W₂'.a₃ = u_inv ^ 3 * (W₁'.a₃ + r * W₁'.a₁ + 2 * t) :=
    WeierstrassCurve.variableChange_a₃ W₁ C
  have ha₄ : W₂'.a₄ = u_inv ^ 4 *
      (W₁'.a₄ - s * W₁'.a₃ + 2 * r * W₁'.a₂ - (t + r * s) * W₁'.a₁ + 3 * r ^ 2 - 2 * s * t) :=
    WeierstrassCurve.variableChange_a₄ W₁ C
  have ha₆ : W₂'.a₆ = u_inv ^ 6 *
      (W₁'.a₆ + r * W₁'.a₄ + r ^ 2 * W₁'.a₂ + r ^ 3 - t * W₁'.a₃ - t ^ 2 - r * t * W₁'.a₁) :=
    WeierstrassCurve.variableChange_a₆ W₁ C
  let X : K → K := fun x => u_inv ^ 2 * (x - r)
  let Y : K → K → K := fun x y => u_inv ^ 3 * (y - s * (x - r) - t)
  let X' : K → K := fun x' => u ^ 2 * x' + r
  let Y' : K → K → K := fun x' y' => u ^ 3 * y' + u ^ 2 * s * x' + t
  have hXX' : ∀ x, X' (X x) = x := fun x => by
    dsimp only [X, X']
    calc u ^ 2 * (u_inv ^ 2 * (x - r)) + r
      _ = (u * u_inv) ^ 2 * (x - r) + r := by ring
      _ = 1 ^ 2 * (x - r) + r := by rw [huu]
      _ = x := by ring
  have hX'X : ∀ x', X (X' x') = x' := fun x' => by
    dsimp only [X, X']
    calc u_inv ^ 2 * ((u ^ 2 * x' + r) - r)
      _ = (u_inv * u) ^ 2 * x' := by ring
      _ = 1 ^ 2 * x' := by rw [huu']
      _ = x' := by ring
  have hYY' : ∀ x y, Y' (X x) (Y x y) = y := fun x y => by
    dsimp only [X, Y, Y']
    calc u ^ 3 * (u_inv ^ 3 * (y - s * (x - r) - t)) +
          u ^ 2 * s * (u_inv ^ 2 * (x - r)) + t
      _ = (u * u_inv) ^ 3 * (y - s * (x - r) - t) +
          (u * u_inv) ^ 2 * s * (x - r) + t := by ring
      _ = 1 ^ 3 * (y - s * (x - r) - t) +
          1 ^ 2 * s * (x - r) + t := by rw [huu]
      _ = y := by ring
  have hY'Y : ∀ x' y', Y (X' x') (Y' x' y') = y' := fun x' y' => by
    dsimp only [X, Y, X', Y']
    calc u_inv ^ 3 * ((u ^ 3 * y' + u ^ 2 * s * x' + t) -
          s * ((u ^ 2 * x' + r) - r) - t)
      _ = (u_inv * u) ^ 3 * y' := by ring
      _ = 1 ^ 3 * y' := by rw [huu']
      _ = y' := by ring
  have h_eq_poly : ∀ x y,
      (Y x y) ^ 2 + W₂'.a₁ * (X x) * (Y x y) + W₂'.a₃ * (Y x y) -
        ((X x) ^ 3 + W₂'.a₂ * (X x) ^ 2 + W₂'.a₄ * (X x) + W₂'.a₆) =
      u_inv ^ 6 * (y ^ 2 + W₁'.a₁ * x * y + W₁'.a₃ * y -
        (x ^ 3 + W₁'.a₂ * x ^ 2 + W₁'.a₄ * x + W₁'.a₆)) := fun x y => by
    dsimp only [X, Y]
    rw [ha₁, ha₂, ha₃, ha₄, ha₆]
    ring
  have h_dx_poly : ∀ x y,
      W₂'.a₁ * (Y x y) - (3 * (X x) ^ 2 + 2 * W₂'.a₂ * (X x) + W₂'.a₄) =
      u_inv ^ 4 * ((W₁'.a₁ * y - (3 * x ^ 2 + 2 * W₁'.a₂ * x + W₁'.a₄)) +
        s * (2 * y + W₁'.a₁ * x + W₁'.a₃)) := fun x y => by
    dsimp only [X, Y]
    rw [ha₁, ha₂, ha₄]
    ring
  have h_dy_poly : ∀ x y,
      2 * (Y x y) + W₂'.a₁ * (X x) + W₂'.a₃ =
      u_inv ^ 3 * (2 * y + W₁'.a₁ * x + W₁'.a₃) := fun x y => by
    dsimp only [X, Y]
    rw [ha₁, ha₃]
    ring
  have h_nonsing : ∀ x y, W₁'.Nonsingular x y ↔ W₂'.Nonsingular (X x) (Y x y) := by
    intro x y
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.nonsingular_iff',
      WeierstrassCurve.Affine.equation_iff', WeierstrassCurve.Affine.equation_iff',
      h_eq_poly, h_dx_poly, h_dy_poly]
    have hu6 : u_inv ^ 6 ≠ 0 := pow_ne_zero 6 hu_inv
    have hu4 : u_inv ^ 4 ≠ 0 := pow_ne_zero 4 hu_inv
    have hu3 : u_inv ^ 3 ≠ 0 := pow_ne_zero 3 hu_inv
    rw [mul_eq_zero_iff_left hu6, mul_ne_zero_iff_left hu4, mul_ne_zero_iff_left hu3]
    constructor
    · rintro ⟨heq, hdx | hdy⟩
      · refine ⟨heq, ?_⟩
        by_cases hdy' : 2 * y + W₁'.a₁ * x + W₁'.a₃ = 0
        · left
          rw [hdy', mul_zero, add_zero]
          exact hdx
        · right; exact hdy'
      · exact ⟨heq, Or.inr hdy⟩
    · rintro ⟨heq, hdx | hdy⟩
      · refine ⟨heq, ?_⟩
        by_cases hdy' : 2 * y + W₁'.a₁ * x + W₁'.a₃ = 0
        · left
          intro hdx'
          apply hdx
          rw [hdx', hdy', mul_zero, add_zero]
        · right; exact hdy'
      · exact ⟨heq, Or.inr hdy⟩
  have h_nonsing' : ∀ x' y', W₂'.Nonsingular x' y' → W₁'.Nonsingular (X' x') (Y' x' y') := by
    intro x' y' h'
    rw [h_nonsing (X' x') (Y' x' y'), hX'X, hY'Y]
    exact h'
  let toFun : W₁'.Point → W₂'.Point
    | 0 => 0
    | WeierstrassCurve.Affine.Point.some h =>
        WeierstrassCurve.Affine.Point.some ((h_nonsing _ _).mp h)
  let invFun : W₂'.Point → W₁'.Point
    | 0 => 0
    | WeierstrassCurve.Affine.Point.some h' =>
        WeierstrassCurve.Affine.Point.some (h_nonsing' _ _ h')
  have h_left_inv : Function.LeftInverse invFun toFun := by
    rintro (_ | @⟨x, y, h⟩)
    · rfl
    · dsimp only [toFun, invFun]
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨hXX' x, hYY' x y⟩
  have h_right_inv : Function.RightInverse invFun toFun := by
    rintro (_ | @⟨x', y', h'⟩)
    · rfl
    · dsimp only [toFun, invFun]
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨hX'X x', hY'Y x' y'⟩
  have h_negY : ∀ x y, W₂'.negY (X x) (Y x y) = Y x (W₁'.negY x y) := fun x y => by
    dsimp only [WeierstrassCurve.Affine.negY, X, Y]
    rw [ha₁, ha₃]
    ring
  have h_X_inj : ∀ x₁ x₂, X x₁ = X x₂ ↔ x₁ = x₂ := fun x₁ x₂ => by
    constructor
    · intro h
      have := congrArg X' h
      rwa [hXX', hXX'] at this
    · rintro rfl; rfl
  have h_Y_inj : ∀ x y₁ y₂, Y x y₁ = Y x y₂ ↔ y₁ = y₂ := fun x y₁ y₂ => by
    constructor
    · intro h
      have := congrArg (Y' (X x)) h
      rwa [hYY', hYY'] at this
    · rintro rfl; rfl
  have h_addX : ∀ x₁ x₂ L,
      W₂'.addX (X x₁) (X x₂) (u_inv * (L - s)) = X (W₁'.addX x₁ x₂ L) := fun x₁ x₂ L => by
    dsimp only [WeierstrassCurve.Affine.addX, X]
    rw [ha₁, ha₂]
    ring
  have h_addY : ∀ x₁ x₂ y₁ L,
      W₂'.addY (X x₁) (X x₂) (Y x₁ y₁) (u_inv * (L - s)) =
        Y (W₁'.addX x₁ x₂ L) (W₁'.addY x₁ x₂ y₁ L) := fun x₁ x₂ y₁ L => by
    dsimp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
      WeierstrassCurve.Affine.negY, WeierstrassCurve.Affine.addX, X, Y]
    rw [ha₁, ha₂, ha₃]
    ring
  have h_div_helper : ∀ (a c : K) (hc : c ≠ 0),
      u_inv ^ 2 * (u_inv * (a - s * c)) / (u_inv ^ 2 * c) = u_inv * (a / c - s) := by
    intro a c hc
    have hu2 : u_inv ^ 2 ≠ 0 := pow_ne_zero 2 hu_inv
    rw [mul_div_mul_left _ _ hu2, div_sub' hc, ← mul_div_assoc]
    congr 1; ring
  have h_div_helper3 : ∀ (a c : K) (hc : c ≠ 0),
      u_inv ^ 3 * (u_inv * (a - s * c)) / (u_inv ^ 3 * c) = u_inv * (a / c - s) := by
    intro a c hc
    have hu3 : u_inv ^ 3 ≠ 0 := pow_ne_zero 3 hu_inv
    rw [mul_div_mul_left _ _ hu3, div_sub' hc, ← mul_div_assoc]
    congr 1; ring
  have h_slope_X_ne : ∀ {x₁ x₂ y₁ y₂ : K} (hx : x₁ ≠ x₂),
      W₂'.slope (X x₁) (X x₂) (Y x₁ y₁) (Y x₂ y₂) =
        u_inv * (W₁'.slope x₁ x₂ y₁ y₂ - s) := by
    intro x₁ x₂ y₁ y₂ hx
    have hx' : X x₁ ≠ X x₂ := mt (h_X_inj x₁ x₂).mp hx
    rw [WeierstrassCurve.Affine.slope_of_X_ne hx', WeierstrassCurve.Affine.slope_of_X_ne hx]
    have hsub : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx
    have hnum : Y x₁ y₁ - Y x₂ y₂ = u_inv ^ 2 * (u_inv * ((y₁ - y₂) - s * (x₁ - x₂))) := by
      dsimp only [Y]; ring
    have hden : X x₁ - X x₂ = u_inv ^ 2 * (x₁ - x₂) := by
      dsimp only [X]; ring
    rw [hnum, hden]
    exact h_div_helper (y₁ - y₂) (x₁ - x₂) hsub
  have h_slope_Y_ne : ∀ {x₁ x₂ y₁ y₂ : K} (hx : x₁ = x₂) (hy : y₁ ≠ W₁'.negY x₂ y₂)
      (hy₁ : y₁ ≠ W₁'.negY x₁ y₁),
      W₂'.slope (X x₁) (X x₂) (Y x₁ y₁) (Y x₂ y₂) =
        u_inv * (W₁'.slope x₁ x₂ y₁ y₂ - s) := by
    intro x₁ x₂ y₁ y₂ hx hy hy₁
    have hx' : X x₁ = X x₂ := congrArg X hx
    have hy' : Y x₁ y₁ ≠ W₂'.negY (X x₂) (Y x₂ y₂) := by
      rw [h_negY, ← hx]
      intro h
      apply hy
      rw [← hx]
      exact (h_Y_inj x₁ y₁ (W₁'.negY x₁ y₂)).mp h
    rw [WeierstrassCurve.Affine.slope_of_Y_ne hx' hy', WeierstrassCurve.Affine.slope_of_Y_ne hx hy]
    have hden_eq : y₁ - W₁'.negY x₁ y₁ = 2 * y₁ + W₁'.a₁ * x₁ + W₁'.a₃ := by
      dsimp only [WeierstrassCurve.Affine.negY]; ring
    have hden_ne : y₁ - W₁'.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy₁
    have hnum : 3 * (X x₁) ^ 2 + 2 * W₂'.a₂ * (X x₁) + W₂'.a₄ - W₂'.a₁ * (Y x₁ y₁) =
        u_inv ^ 3 * (u_inv * ((3 * x₁ ^ 2 + 2 * W₁'.a₂ * x₁ + W₁'.a₄ - W₁'.a₁ * y₁) -
          s * (y₁ - W₁'.negY x₁ y₁))) := by
      have := h_dx_poly x₁ y₁
      rw [← hden_eq] at this
      linear_combination -this
    have hden : Y x₁ y₁ - W₂'.negY (X x₁) (Y x₁ y₁) = u_inv ^ 3 * (y₁ - W₁'.negY x₁ y₁) := by
      rw [h_negY]
      dsimp only [Y]; ring
    rw [hnum, hden]
    exact h_div_helper3 _ _ hden_ne
  have h_map_add : ∀ P Q : W₁'.Point, toFun (P + Q) = toFun P + toFun Q := by
    rintro (_ | @⟨x₁, y₁, h₁⟩) (_ | @⟨x₂, y₂, h₂⟩)
    · change toFun (0 + 0) = toFun 0 + toFun 0
      rw [add_zero, add_zero]
    · change toFun (0 + WeierstrassCurve.Affine.Point.some h₂) =
        0 + toFun (WeierstrassCurve.Affine.Point.some h₂)
      rw [zero_add, zero_add]
    · change toFun (WeierstrassCurve.Affine.Point.some h₁ + 0) =
        toFun (WeierstrassCurve.Affine.Point.some h₁) + 0
      rw [add_zero, add_zero]
    · dsimp only [toFun]
      by_cases hx : x₁ = x₂
      · by_cases hy : y₁ = W₁'.negY x₂ y₂
        · have hx' : X x₁ = X x₂ := congrArg X hx
          have hy' : Y x₁ y₁ = W₂'.negY (X x₂) (Y x₂ y₂) := by
            rw [h_negY, hy, hx]
          rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hx hy,
            WeierstrassCurve.Affine.Point.add_of_Y_eq hx' hy']
        · have hx' : X x₁ = X x₂ := congrArg X hx
          have hy' : Y x₁ y₁ ≠ W₂'.negY (X x₂) (Y x₂ y₂) := by
            rw [h_negY, ← hx]
            intro h
            apply hy
            rw [← hx]
            exact (h_Y_inj x₁ y₁ (W₁'.negY x₁ y₂)).mp h
          have hy_eq : y₁ = y₂ := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂.1 hx hy
          have hy₁ : y₁ ≠ W₁'.negY x₁ y₁ := by
            rw [← hx, ← hy_eq] at hy
            exact hy
          rw [WeierstrassCurve.Affine.Point.add_of_Y_ne hy,
            WeierstrassCurve.Affine.Point.add_of_Y_ne hy']
          dsimp only [toFun]
          rw [WeierstrassCurve.Affine.Point.some.injEq]
          rw [h_slope_Y_ne hx hy hy₁]
          exact ⟨(h_addX x₁ x₂ _).symm, (h_addY x₁ x₂ y₁ _).symm⟩
      · have hx' : X x₁ ≠ X x₂ := mt (h_X_inj x₁ x₂).mp hx
        rw [WeierstrassCurve.Affine.Point.add_of_X_ne hx,
          WeierstrassCurve.Affine.Point.add_of_X_ne hx']
        dsimp only [toFun]
        rw [WeierstrassCurve.Affine.Point.some.injEq]
        rw [h_slope_X_ne hx]
        exact ⟨(h_addX x₁ x₂ _).symm, (h_addY x₁ x₂ y₁ _).symm⟩
  let e : W₁'.Point ≃+ W₂'.Point :=
    { toFun := toFun
      invFun := invFun
      left_inv := h_left_inv
      right_inv := h_right_inv
      map_add' := h_map_add }
  
  let S : Set K := {u, r, s, t}
  have hS_fin : S.Finite := (((Set.finite_singleton t).insert s).insert r).insert u
  haveI : Finite S := hS_fin.to_subtype
  let L : IntermediateField F K := IntermediateField.adjoin F S
  have hL_fin : FiniteDimensional F L :=
    IntermediateField.finiteDimensional_adjoin fun z _ => Algebra.IsIntegral.isIntegral z
  refine ⟨L, hL_fin, ?_⟩
  intro σ hσL hσI n P hP
  have hσ_fix : ∀ z ∈ S, σ z = z := fun z hz =>
    (IntermediateField.mem_fixingSubgroup_iff L σ).mp hσL z (IntermediateField.subset_adjoin F S hz)
  have hσu : σ u = u := hσ_fix u (by simp [S])
  have hσr : σ r = r := hσ_fix r (by simp [S])
  have hσs : σ s = s := hσ_fix s (by simp [S])
  have hσt : σ t = t := hσ_fix t (by simp [S])
  have hσu_inv : σ u_inv = u_inv := by
    have h1 : u * σ u_inv = 1 := by
      calc u * σ u_inv = σ u * σ u_inv := by rw [hσu]
        _ = σ (u * u_inv) := (map_mul σ u u_inv).symm
        _ = 1 := by rw [huu, map_one]
    calc σ u_inv = (u_inv * u) * σ u_inv := by rw [huu', one_mul]
      _ = u_inv * (u * σ u_inv) := by ring
      _ = u_inv := by rw [h1, mul_one]
  let m : ℕ := EllipticRootNumber.ell F ^ (n + 1)
  have hm : v (m : K) = 1 := by
    change v ((EllipticRootNumber.ell F ^ (n + 1) : ℕ) : K) = 1
    rw [Nat.cast_pow, map_pow, hv_ell, one_pow]
  have hP_m : m • P = 0 := (EllipticRootNumber.mem_torsion F E).mp hP
  have hP' : EllipticRootNumber.galHom F E σ P ∈ EllipticRootNumber.torsion F E m :=
    EllipticRootNumber.galHom_mem_torsion F E σ hP
  have hP'_m : m • EllipticRootNumber.galHom F E σ P = 0 :=
    (EllipticRootNumber.mem_torsion F E).mp hP'
  rcases P with _ | @⟨x, y, h⟩
  · rfl
  · let h_σ : W₁'.Nonsingular (σ x) (σ y) :=
      (WeierstrassCurve.Affine.baseChange_nonsingular x y
        (σ : K →ₐ[F] K).injective).mpr h
    have h_gal_eq : EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h) =
        WeierstrassCurve.Affine.Point.some h_σ :=
      WeierstrassCurve.Affine.Point.map_some (W' := E) (σ : K →ₐ[F] K) h
    let h₁ : W₂'.Nonsingular (X (σ x)) (Y (σ x) (σ y)) := (h_nonsing (σ x) (σ y)).mp h_σ
    let h₂ : W₂'.Nonsingular (X x) (Y x y) := (h_nonsing x y).mp h
    have he₁ : e (EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h)) =
        WeierstrassCurve.Affine.Point.some h₁ := by
      rw [h_gal_eq]; rfl
    have he₂ : e (WeierstrassCurve.Affine.Point.some h) =
        WeierstrassCurve.Affine.Point.some h₂ := rfl
    have hQ₁_m : m • (WeierstrassCurve.Affine.Point.some h₁ : W₂'.Point) = 0 := by
      rw [← he₁, ← map_nsmul, hP'_m, map_zero]
    have hQ₂_m : m • (WeierstrassCurve.Affine.Point.some h₂ : W₂'.Point) = 0 := by
      rw [← he₂, ← map_nsmul, hP_m, map_zero]
    obtain ⟨hx₁, hy₁⟩ :=
      weierstrass_formal_group_torsion_trivial K v W₂'
        hva₁ hva₂ hva₃ hva₄ hva₆ m hm h₁ hQ₁_m
    obtain ⟨hx₂, hy₂⟩ :=
      weierstrass_formal_group_torsion_trivial K v W₂'
        hva₁ hva₂ hva₃ hva₄ hva₆ m hm h₂ hQ₂_m
    have hX_σ : X (σ x) = σ (X x) := by
      dsimp only [X]
      simp only [map_mul, map_pow, map_sub, hσu_inv, hσr]
    have hY_σ : Y (σ x) (σ y) = σ (Y x y) := by
      dsimp only [Y]
      simp only [map_mul, map_pow, map_sub, hσu_inv, hσr, hσs, hσt]
    have hxx : v (X (σ x) - X x) < 1 := by
      rw [hX_σ]
      exact inertia_sub_self_lt_one_of_valuation_le_one F v hv_gal hv_le hv_lt hv_minpoly
        (X x) hx₂ σ hσI
    have hyy : v (Y (σ x) (σ y) - Y x y) < 1 := by
      rw [hY_σ]
      exact inertia_sub_self_lt_one_of_valuation_le_one F v hv_gal hv_le hv_lt hv_minpoly
        (Y x y) hy₂ σ hσI
    by_contra h_ne
    have hQ_ne : (WeierstrassCurve.Affine.Point.some h₁ : W₂'.Point) ≠
        WeierstrassCurve.Affine.Point.some h₂ := by
      rw [← he₁, ← he₂]
      exact e.injective.ne h_ne
    rcases hQ_eq : (WeierstrassCurve.Affine.Point.some h₁ : W₂'.Point) -
        WeierstrassCurve.Affine.Point.some h₂ with _ | @⟨x₃, y₃, h₃⟩
    · exact hQ_ne (sub_eq_zero.mp hQ_eq)
    · have hQ₃_m : m • (WeierstrassCurve.Affine.Point.some h₃ : W₂'.Point) = 0 := by
        rw [← hQ_eq, nsmul_sub, hQ₁_m, hQ₂_m, sub_zero]
      obtain ⟨hx₃_le, _⟩ :=
        weierstrass_formal_group_torsion_trivial K v W₂'
          hva₁ hva₂ hva₃ hva₄ hva₆ m hm h₃ hQ₃_m
      have hx₃_gt : 1 < v x₃ :=
        weierstrass_sub_coord_gt_one_of_residue_eq K v W₂'
          hva₁ hva₂ hva₃ hva₄ hva₆ hvΔ h₁ h₂ h₃ hx₁ hy₁ hx₂ hy₂ hxx hyy hQ_eq
      exact not_lt_of_ge hx₃_le hx₃_gt

theorem isWeilRep_of_isPotentiallyGood (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (hE : EllipticRootNumber.IsPotentiallyGood F E) :
    EllipticRootNumber.IsWeilRep F ⊥
      ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) :=
by
  haveI : Finite (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :=
    finite_torsion_ell F E
  haveI : Module.Finite ℤ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateModule F E) :=
    module_finite_tateModule_of_finite_torsion F E
  haveI : Module.Finite ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.VQ F E) :=
    Module.Finite.base_change ℤ_[EllipticRootNumber.ell F] ℚ_[EllipticRootNumber.ell F]
      (EllipticRootNumber.tateModule F E)
  have h_fd : FiniteDimensional (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) :=
    Module.Finite.base_change ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.Ω F)
      (EllipticRootNumber.VQ F E)
  refine ⟨h_fd, ?_⟩
  have h_ext : ∃ L : IntermediateField F (AlgebraicClosure F), FiniteDimensional F L ∧
      ∀ σ : EllipticRootNumber.AbsGal F,
        σ ∈ L.fixingSubgroup → σ ∈ EllipticRootNumber.inertia F →
        ∀ (n : ℕ) (P : EllipticRootNumber.Pts F E),
          P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) →
            EllipticRootNumber.galHom F E σ P = P := by
    by_cases hΔ : E.Δ = 0
    · exact exists_finite_ext_torsion_fixed_of_delta_eq_zero F E hΔ
    · exact exists_finite_ext_torsion_fixed_of_isPotentiallyGood F E hΔ hE
  obtain ⟨L, hL_fin, hL_fixed⟩ := h_ext
  haveI : FiniteDimensional F L := hL_fin
  refine ⟨(L.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)),
    IsOpen.mem_nhds L.fixingSubgroup_isOpen L.fixingSubgroup.one_mem, ?_⟩
  intro w hwU hwI
  have htate : EllipticRootNumber.tateRep F E (w : EllipticRootNumber.AbsGal F) = 1 := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext n
    apply Subtype.ext
    exact hL_fixed (w : EllipticRootNumber.AbsGal F) hwU hwI n (x.1 n).1 (x.1 n).2
  change LinearMap.baseChange (EllipticRootNumber.Ω F)
    (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F]
      (EllipticRootNumber.tateRep F E (w : EllipticRootNumber.AbsGal F))) = 1
  rw [htate, Module.End.one_eq_id, LinearMap.baseChange_id, LinearMap.baseChange_id]
  rfl

theorem rootNumberRaw_variableChange (F : Type u) [Field F]
    (C : WeierstrassCurve.VariableChange F) (E : WeierstrassCurve F) :
    rootNumberRaw (C • E) = rootNumberRaw E :=
by
  classical
  have h_pts_equiv :
      ∃ (e : EllipticRootNumber.Pts F E ≃+ EllipticRootNumber.Pts F (C • E)),
        ∀ σ : EllipticRootNumber.AbsGal F, ∀ P : EllipticRootNumber.Pts F E,
          e (EllipticRootNumber.galHom F E σ P) =
            EllipticRootNumber.galHom F (C • E) σ (e P) := by
    let K := AlgebraicClosure F
    let φ : F →+* K := algebraMap F K
    let W₁ : WeierstrassCurve.Affine K := (E.baseChange K).toAffine
    let W₂ : WeierstrassCurve.Affine K := ((C • E).baseChange K).toAffine
    let u : K := φ C.u
    let u_inv : K := φ (C.u⁻¹ : Fˣ)
    let r : K := φ C.r
    let s : K := φ C.s
    let t : K := φ C.t
    have huu : u * u_inv = 1 := by
      dsimp only [u, u_inv]
      rw [← map_mul, Units.mul_inv, map_one]
    have huu' : u_inv * u = 1 := by
      rw [mul_comm, huu]
    have hu_inv : u_inv ≠ 0 := by
      intro h
      have : (1 : K) = 0 := by rw [← huu', h, zero_mul]
      exact one_ne_zero this
    have ha₁ : W₂.a₁ = u_inv * (W₁.a₁ + 2 * s) := by
      change φ (C • E).a₁ = u_inv * (φ E.a₁ + 2 * s)
      rw [WeierstrassCurve.variableChange_a₁]
      simp only [u_inv, s, map_mul, map_add, map_ofNat]
    have ha₂ : W₂.a₂ = u_inv ^ 2 * (W₁.a₂ - s * W₁.a₁ + 3 * r - s ^ 2) := by
      change φ (C • E).a₂ = u_inv ^ 2 * (φ E.a₂ - s * φ E.a₁ + 3 * r - s ^ 2)
      rw [WeierstrassCurve.variableChange_a₂]
      simp only [u_inv, r, s, map_mul, map_add, map_sub, map_pow, map_ofNat]
    have ha₃ : W₂.a₃ = u_inv ^ 3 * (W₁.a₃ + r * W₁.a₁ + 2 * t) := by
      change φ (C • E).a₃ = u_inv ^ 3 * (φ E.a₃ + r * φ E.a₁ + 2 * t)
      rw [WeierstrassCurve.variableChange_a₃]
      simp only [u_inv, r, t, map_mul, map_add, map_pow, map_ofNat]
    have ha₄ : W₂.a₄ = u_inv ^ 4 *
        (W₁.a₄ - s * W₁.a₃ + 2 * r * W₁.a₂ - (t + r * s) * W₁.a₁ + 3 * r ^ 2 - 2 * s * t) := by
      change φ (C • E).a₄ = u_inv ^ 4 *
        (φ E.a₄ - s * φ E.a₃ + 2 * r * φ E.a₂ - (t + r * s) * φ E.a₁ + 3 * r ^ 2 - 2 * s * t)
      rw [WeierstrassCurve.variableChange_a₄]
      simp only [u_inv, r, s, t, map_mul, map_add, map_sub, map_pow, map_ofNat]
    have ha₆ : W₂.a₆ = u_inv ^ 6 *
        (W₁.a₆ + r * W₁.a₄ + r ^ 2 * W₁.a₂ + r ^ 3 - t * W₁.a₃ - t ^ 2 - r * t * W₁.a₁) := by
      change φ (C • E).a₆ = u_inv ^ 6 *
        (φ E.a₆ + r * φ E.a₄ + r ^ 2 * φ E.a₂ + r ^ 3 - t * φ E.a₃ - t ^ 2 - r * t * φ E.a₁)
      rw [WeierstrassCurve.variableChange_a₆]
      simp only [u_inv, r, t, map_mul, map_add, map_sub, map_pow]
    let X : K → K := fun x => u_inv ^ 2 * (x - r)
    let Y : K → K → K := fun x y => u_inv ^ 3 * (y - s * (x - r) - t)
    let X' : K → K := fun x' => u ^ 2 * x' + r
    let Y' : K → K → K := fun x' y' => u ^ 3 * y' + u ^ 2 * s * x' + t
    have hXX' : ∀ x, X' (X x) = x := fun x => by
      dsimp only [X, X']
      calc u ^ 2 * (u_inv ^ 2 * (x - r)) + r
        _ = (u * u_inv) ^ 2 * (x - r) + r := by ring
        _ = 1 ^ 2 * (x - r) + r := by rw [huu]
        _ = x := by ring
    have hX'X : ∀ x', X (X' x') = x' := fun x' => by
      dsimp only [X, X']
      calc u_inv ^ 2 * ((u ^ 2 * x' + r) - r)
        _ = (u_inv * u) ^ 2 * x' := by ring
        _ = 1 ^ 2 * x' := by rw [huu']
        _ = x' := by ring
    have hYY' : ∀ x y, Y' (X x) (Y x y) = y := fun x y => by
      dsimp only [X, Y, Y']
      calc u ^ 3 * (u_inv ^ 3 * (y - s * (x - r) - t)) +
            u ^ 2 * s * (u_inv ^ 2 * (x - r)) + t
        _ = (u * u_inv) ^ 3 * (y - s * (x - r) - t) +
            (u * u_inv) ^ 2 * s * (x - r) + t := by ring
        _ = 1 ^ 3 * (y - s * (x - r) - t) +
            1 ^ 2 * s * (x - r) + t := by rw [huu]
        _ = y := by ring
    have hY'Y : ∀ x' y', Y (X' x') (Y' x' y') = y' := fun x' y' => by
      dsimp only [X, Y, X', Y']
      calc u_inv ^ 3 * ((u ^ 3 * y' + u ^ 2 * s * x' + t) -
            s * ((u ^ 2 * x' + r) - r) - t)
        _ = (u_inv * u) ^ 3 * y' := by ring
        _ = 1 ^ 3 * y' := by rw [huu']
        _ = y' := by ring
    have h_eq_poly : ∀ x y,
        (Y x y) ^ 2 + W₂.a₁ * (X x) * (Y x y) + W₂.a₃ * (Y x y) -
          ((X x) ^ 3 + W₂.a₂ * (X x) ^ 2 + W₂.a₄ * (X x) + W₂.a₆) =
        u_inv ^ 6 * (y ^ 2 + W₁.a₁ * x * y + W₁.a₃ * y -
          (x ^ 3 + W₁.a₂ * x ^ 2 + W₁.a₄ * x + W₁.a₆)) := fun x y => by
      dsimp only [X, Y]
      rw [ha₁, ha₂, ha₃, ha₄, ha₆]
      ring
    have h_dx_poly : ∀ x y,
        W₂.a₁ * (Y x y) - (3 * (X x) ^ 2 + 2 * W₂.a₂ * (X x) + W₂.a₄) =
        u_inv ^ 4 * ((W₁.a₁ * y - (3 * x ^ 2 + 2 * W₁.a₂ * x + W₁.a₄)) +
          s * (2 * y + W₁.a₁ * x + W₁.a₃)) := fun x y => by
      dsimp only [X, Y]
      rw [ha₁, ha₂, ha₄]
      ring
    have h_dy_poly : ∀ x y,
        2 * (Y x y) + W₂.a₁ * (X x) + W₂.a₃ =
        u_inv ^ 3 * (2 * y + W₁.a₁ * x + W₁.a₃) := fun x y => by
      dsimp only [X, Y]
      rw [ha₁, ha₃]
      ring
    have h_nonsing : ∀ x y, W₁.Nonsingular x y ↔ W₂.Nonsingular (X x) (Y x y) := by
      intro x y
      rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.nonsingular_iff',
        WeierstrassCurve.Affine.equation_iff', WeierstrassCurve.Affine.equation_iff',
        h_eq_poly, h_dx_poly, h_dy_poly]
      have hu6 : u_inv ^ 6 ≠ 0 := pow_ne_zero 6 hu_inv
      have hu4 : u_inv ^ 4 ≠ 0 := pow_ne_zero 4 hu_inv
      have hu3 : u_inv ^ 3 ≠ 0 := pow_ne_zero 3 hu_inv
      rw [mul_eq_zero_iff_left hu6, mul_ne_zero_iff_left hu4, mul_ne_zero_iff_left hu3]
      constructor
      · rintro ⟨heq, hdx | hdy⟩
        · refine ⟨heq, ?_⟩
          by_cases hdy' : 2 * y + W₁.a₁ * x + W₁.a₃ = 0
          · left
            rw [hdy', mul_zero, add_zero]
            exact hdx
          · right; exact hdy'
        · exact ⟨heq, Or.inr hdy⟩
      · rintro ⟨heq, hdx | hdy⟩
        · refine ⟨heq, ?_⟩
          by_cases hdy' : 2 * y + W₁.a₁ * x + W₁.a₃ = 0
          · left
            intro hdx'
            apply hdx
            rw [hdx', hdy', mul_zero, add_zero]
          · right; exact hdy'
        · exact ⟨heq, Or.inr hdy⟩
    have h_nonsing' : ∀ x' y', W₂.Nonsingular x' y' → W₁.Nonsingular (X' x') (Y' x' y') := by
      intro x' y' h'
      rw [h_nonsing (X' x') (Y' x' y'), hX'X, hY'Y]
      exact h'
    let toFun : W₁.Point → W₂.Point
      | 0 => 0
      | WeierstrassCurve.Affine.Point.some h =>
          WeierstrassCurve.Affine.Point.some ((h_nonsing _ _).mp h)
    let invFun : W₂.Point → W₁.Point
      | 0 => 0
      | WeierstrassCurve.Affine.Point.some h' =>
          WeierstrassCurve.Affine.Point.some (h_nonsing' _ _ h')
    have h_left_inv : Function.LeftInverse invFun toFun := by
      rintro (_ | @⟨x, y, h⟩)
      · rfl
      · dsimp only [toFun, invFun]
        rw [WeierstrassCurve.Affine.Point.some.injEq]
        exact ⟨hXX' x, hYY' x y⟩
    have h_right_inv : Function.RightInverse invFun toFun := by
      rintro (_ | @⟨x', y', h'⟩)
      · rfl
      · dsimp only [toFun, invFun]
        rw [WeierstrassCurve.Affine.Point.some.injEq]
        exact ⟨hX'X x', hY'Y x' y'⟩
    have h_negY : ∀ x y, W₂.negY (X x) (Y x y) = Y x (W₁.negY x y) := fun x y => by
      dsimp only [WeierstrassCurve.Affine.negY, X, Y]
      rw [ha₁, ha₃]
      ring
    have h_X_inj : ∀ x₁ x₂, X x₁ = X x₂ ↔ x₁ = x₂ := fun x₁ x₂ => by
      constructor
      · intro h
        have := congrArg X' h
        rwa [hXX', hXX'] at this
      · rintro rfl; rfl
    have h_Y_inj : ∀ x y₁ y₂, Y x y₁ = Y x y₂ ↔ y₁ = y₂ := fun x y₁ y₂ => by
      constructor
      · intro h
        have := congrArg (Y' (X x)) h
        rwa [hYY', hYY'] at this
      · rintro rfl; rfl
    have h_addX : ∀ x₁ x₂ L,
        W₂.addX (X x₁) (X x₂) (u_inv * (L - s)) = X (W₁.addX x₁ x₂ L) := fun x₁ x₂ L => by
      dsimp only [WeierstrassCurve.Affine.addX, X]
      rw [ha₁, ha₂]
      ring
    have h_addY : ∀ x₁ x₂ y₁ L,
        W₂.addY (X x₁) (X x₂) (Y x₁ y₁) (u_inv * (L - s)) =
          Y (W₁.addX x₁ x₂ L) (W₁.addY x₁ x₂ y₁ L) := fun x₁ x₂ y₁ L => by
      dsimp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
        WeierstrassCurve.Affine.negY, WeierstrassCurve.Affine.addX, X, Y]
      rw [ha₁, ha₂, ha₃]
      ring
    have h_div_helper : ∀ (a c : K) (hc : c ≠ 0),
        u_inv ^ 2 * (u_inv * (a - s * c)) / (u_inv ^ 2 * c) = u_inv * (a / c - s) := by
      intro a c hc
      have hu2 : u_inv ^ 2 ≠ 0 := pow_ne_zero 2 hu_inv
      rw [mul_div_mul_left _ _ hu2, div_sub' hc, ← mul_div_assoc]
      congr 1; ring
    have h_div_helper3 : ∀ (a c : K) (hc : c ≠ 0),
        u_inv ^ 3 * (u_inv * (a - s * c)) / (u_inv ^ 3 * c) = u_inv * (a / c - s) := by
      intro a c hc
      have hu3 : u_inv ^ 3 ≠ 0 := pow_ne_zero 3 hu_inv
      rw [mul_div_mul_left _ _ hu3, div_sub' hc, ← mul_div_assoc]
      congr 1; ring
    have h_slope_X_ne : ∀ {x₁ x₂ y₁ y₂ : K} (hx : x₁ ≠ x₂),
        W₂.slope (X x₁) (X x₂) (Y x₁ y₁) (Y x₂ y₂) =
          u_inv * (W₁.slope x₁ x₂ y₁ y₂ - s) := by
      intro x₁ x₂ y₁ y₂ hx
      have hx' : X x₁ ≠ X x₂ := mt (h_X_inj x₁ x₂).mp hx
      rw [WeierstrassCurve.Affine.slope_of_X_ne hx', WeierstrassCurve.Affine.slope_of_X_ne hx]
      have hsub : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx
      have hnum : Y x₁ y₁ - Y x₂ y₂ = u_inv ^ 2 * (u_inv * ((y₁ - y₂) - s * (x₁ - x₂))) := by
        dsimp only [Y]; ring
      have hden : X x₁ - X x₂ = u_inv ^ 2 * (x₁ - x₂) := by
        dsimp only [X]; ring
      rw [hnum, hden]
      exact h_div_helper (y₁ - y₂) (x₁ - x₂) hsub
    have h_slope_Y_ne : ∀ {x₁ x₂ y₁ y₂ : K} (hx : x₁ = x₂) (hy : y₁ ≠ W₁.negY x₂ y₂)
        (hy₁ : y₁ ≠ W₁.negY x₁ y₁),
        W₂.slope (X x₁) (X x₂) (Y x₁ y₁) (Y x₂ y₂) =
          u_inv * (W₁.slope x₁ x₂ y₁ y₂ - s) := by
      intro x₁ x₂ y₁ y₂ hx hy hy₁
      have hx' : X x₁ = X x₂ := congrArg X hx
      have hy' : Y x₁ y₁ ≠ W₂.negY (X x₂) (Y x₂ y₂) := by
        rw [h_negY, ← hx]
        intro h
        apply hy
        rw [← hx]
        exact (h_Y_inj x₁ y₁ (W₁.negY x₁ y₂)).mp h
      rw [WeierstrassCurve.Affine.slope_of_Y_ne hx' hy', WeierstrassCurve.Affine.slope_of_Y_ne hx hy]
      have hden_eq : y₁ - W₁.negY x₁ y₁ = 2 * y₁ + W₁.a₁ * x₁ + W₁.a₃ := by
        dsimp only [WeierstrassCurve.Affine.negY]; ring
      have hden_ne : y₁ - W₁.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy₁
      have hnum : 3 * (X x₁) ^ 2 + 2 * W₂.a₂ * (X x₁) + W₂.a₄ - W₂.a₁ * (Y x₁ y₁) =
          u_inv ^ 3 * (u_inv * ((3 * x₁ ^ 2 + 2 * W₁.a₂ * x₁ + W₁.a₄ - W₁.a₁ * y₁) -
            s * (y₁ - W₁.negY x₁ y₁))) := by
        have := h_dx_poly x₁ y₁
        rw [← hden_eq] at this
        linear_combination -this
      have hden : Y x₁ y₁ - W₂.negY (X x₁) (Y x₁ y₁) = u_inv ^ 3 * (y₁ - W₁.negY x₁ y₁) := by
        rw [h_negY]
        dsimp only [Y]; ring
      rw [hnum, hden]
      exact h_div_helper3 _ _ hden_ne
    have h_map_add : ∀ P Q : W₁.Point, toFun (P + Q) = toFun P + toFun Q := by
      rintro (_ | @⟨x₁, y₁, h₁⟩) (_ | @⟨x₂, y₂, h₂⟩)
      · change toFun (0 + 0) = toFun 0 + toFun 0
        rw [add_zero, add_zero]
      · change toFun (0 + WeierstrassCurve.Affine.Point.some h₂) =
          0 + toFun (WeierstrassCurve.Affine.Point.some h₂)
        rw [zero_add, zero_add]
      · change toFun (WeierstrassCurve.Affine.Point.some h₁ + 0) =
          toFun (WeierstrassCurve.Affine.Point.some h₁) + 0
        rw [add_zero, add_zero]
      · dsimp only [toFun]
        by_cases hx : x₁ = x₂
        · by_cases hy : y₁ = W₁.negY x₂ y₂
          · have hx' : X x₁ = X x₂ := congrArg X hx
            have hy' : Y x₁ y₁ = W₂.negY (X x₂) (Y x₂ y₂) := by
              rw [h_negY, hy, hx]
            rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hx hy,
              WeierstrassCurve.Affine.Point.add_of_Y_eq hx' hy']
          · have hx' : X x₁ = X x₂ := congrArg X hx
            have hy' : Y x₁ y₁ ≠ W₂.negY (X x₂) (Y x₂ y₂) := by
              rw [h_negY, ← hx]
              intro h
              apply hy
              rw [← hx]
              exact (h_Y_inj x₁ y₁ (W₁.negY x₁ y₂)).mp h
            have hy_eq : y₁ = y₂ := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂.1 hx hy
            have hy₁ : y₁ ≠ W₁.negY x₁ y₁ := by
              rw [← hx, ← hy_eq] at hy
              exact hy
            rw [WeierstrassCurve.Affine.Point.add_of_Y_ne hy,
              WeierstrassCurve.Affine.Point.add_of_Y_ne hy']
            dsimp only [toFun]
            rw [WeierstrassCurve.Affine.Point.some.injEq]
            rw [h_slope_Y_ne hx hy hy₁]
            exact ⟨(h_addX x₁ x₂ _).symm, (h_addY x₁ x₂ y₁ _).symm⟩
        · have hx' : X x₁ ≠ X x₂ := mt (h_X_inj x₁ x₂).mp hx
          rw [WeierstrassCurve.Affine.Point.add_of_X_ne hx,
            WeierstrassCurve.Affine.Point.add_of_X_ne hx']
          dsimp only [toFun]
          rw [WeierstrassCurve.Affine.Point.some.injEq]
          rw [h_slope_X_ne hx]
          exact ⟨(h_addX x₁ x₂ _).symm, (h_addY x₁ x₂ y₁ _).symm⟩
    refine ⟨{ toFun := toFun, invFun := invFun, left_inv := h_left_inv,
              right_inv := h_right_inv, map_add' := h_map_add }, ?_⟩
    intro σ P
    rcases P with _ | @⟨x, y, h⟩
    · rfl
    · change toFun (WeierstrassCurve.Affine.Point.map (W' := E) (σ : K →ₐ[F] K)
          (WeierstrassCurve.Affine.Point.some h)) =
        WeierstrassCurve.Affine.Point.map (W' := C • E) (σ : K →ₐ[F] K)
          (toFun (WeierstrassCurve.Affine.Point.some h))
      rw [WeierstrassCurve.Affine.Point.map_some]
      dsimp only [toFun]
      rw [WeierstrassCurve.Affine.Point.map_some]
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      have hσu : σ u_inv = u_inv := AlgEquiv.commutes σ (C.u⁻¹ : Fˣ)
      have hσr : σ r = r := AlgEquiv.commutes σ C.r
      have hσs : σ s = s := AlgEquiv.commutes σ C.s
      have hσt : σ t = t := AlgEquiv.commutes σ C.t
      dsimp only [X, Y]
      refine ⟨?_, ?_⟩
      · simp only [AlgHom.coe_coe, map_mul, map_pow, map_sub]
        rw [hσu, hσr]
      · simp only [AlgHom.coe_coe, map_mul, map_pow, map_sub]
        rw [hσu, hσr, hσs, hσt]
  unfold rootNumberRaw
  by_cases h_arch : Nonempty (F ≃+* ℝ) ∨ Nonempty (F ≃+* ℂ)
  · rw [if_pos h_arch, if_pos h_arch]
  · rw [if_neg h_arch, if_neg h_arch]
    by_cases h_lf : Nonempty (EllipticRootNumber.LocalFieldStructure F)
    · rw [dif_pos h_lf, dif_pos h_lf]
      let s := Classical.choice h_lf
      letI : ValuativeRel F := s.rel
      letI : TopologicalSpace F := s.top
      haveI : IsNonarchimedeanLocalField F := s.isLocalField
      change EllipticRootNumber.rootNumberNonarch F (C • E) =
        EllipticRootNumber.rootNumberNonarch F E
      unfold EllipticRootNumber.rootNumberNonarch
      · let lc := EllipticRootNumber.localConstants F
        suffices h_eps : EllipticRootNumber.localEps F (C • E) lc =
            EllipticRootNumber.localEps F E lc by
          rw [h_eps]
        have h_pg : EllipticRootNumber.IsPotentiallyGood F (C • E) ↔
            EllipticRootNumber.IsPotentiallyGood F E := by
          unfold EllipticRootNumber.IsPotentiallyGood
          rw [WeierstrassCurve.variableChange_c₄, WeierstrassCurve.variableChange_Δ,
            mul_pow, ← pow_mul]
          have hu : ((C.u⁻¹ : Fˣ) : F) ^ (4 * 3) ≠ 0 := pow_ne_zero _ (Units.ne_zero _)
          rw [mul_div_mul_left (E.c₄ ^ 3) E.Δ hu]
        have h_frob_zero : ∀ (σ' : EllipticRootNumber.WDRep F ⊥),
            σ'.N = 0 → EllipticRootNumber.frobDet F ⊥ σ' = 1 := by
          intro σ' hN
          dsimp only [EllipticRootNumber.frobDet]
          split_ifs with hI hK
          · have hK_top : (LinearMap.ker σ'.N).comap
                (EllipticRootNumber.inertiaInvariants F ⊥ σ').subtype = ⊤ := by
              rw [hN, LinearMap.ker_zero, Submodule.comap_top]
            haveI : Subsingleton (↥(EllipticRootNumber.inertiaInvariants F ⊥ σ') ⧸
                (LinearMap.ker σ'.N).comap
                  (EllipticRootNumber.inertiaInvariants F ⊥ σ').subtype) :=
              Submodule.Quotient.subsingleton_iff.mpr hK_top
            exact LinearMap.det_eq_one_of_subsingleton _
          · rfl
          · rfl
        by_cases hE : EllipticRootNumber.IsPotentiallyGood F E
        · have hCE : EllipticRootNumber.IsPotentiallyGood F (C • E) := h_pg.mpr hE
          unfold EllipticRootNumber.localEps EllipticRootNumber.epsWD
          have hN_CE : (EllipticRootNumber.wdRep F (C • E)).N = 0 := by
            unfold EllipticRootNumber.wdRep
            rw [if_pos hCE]
          have hN_E : (EllipticRootNumber.wdRep F E).N = 0 := by
            unfold EllipticRootNumber.wdRep
            rw [if_pos hE]
          rw [h_frob_zero _ hN_CE, h_frob_zero _ hN_E, mul_one, mul_one]
          obtain ⟨e, he⟩ := h_pts_equiv
          have h_mem₁ : ∀ (n : ℕ)
              (P : EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))),
              e P.1 ∈ EllipticRootNumber.torsion F (C • E) (EllipticRootNumber.ell F ^ (n + 1)) := by
            intro n P
            rw [EllipticRootNumber.mem_torsion, ← map_nsmul,
              (EllipticRootNumber.mem_torsion F E).mp P.2, map_zero]
          have h_mem₂ : ∀ (n : ℕ)
              (Q : EllipticRootNumber.torsion F (C • E) (EllipticRootNumber.ell F ^ (n + 1))),
              e.symm Q.1 ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) := by
            intro n Q
            rw [EllipticRootNumber.mem_torsion, ← map_nsmul,
              (EllipticRootNumber.mem_torsion F (C • E)).mp Q.2, map_zero]
          let e_tors : ∀ n : ℕ,
              EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) ≃ₗ[ℤ_[EllipticRootNumber.ell F]]
                EllipticRootNumber.torsion F (C • E) (EllipticRootNumber.ell F ^ (n + 1)) := fun n =>
            { toFun := fun P => ⟨e P.1, h_mem₁ n P⟩
              invFun := fun Q => ⟨e.symm Q.1, h_mem₂ n Q⟩
              left_inv := fun P => Subtype.ext (e.symm_apply_apply P.1)
              right_inv := fun Q => Subtype.ext (e.apply_symm_apply Q.1)
              map_add' := fun P₁ P₂ => Subtype.ext (map_add e P₁.1 P₂.1)
              map_smul' := fun a P => Subtype.ext (by
                change e ((a • P : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) =
                  ((a • (⟨e P.1, h_mem₁ n P⟩ : EllipticRootNumber.torsion F (C • E) _) :
                    EllipticRootNumber.torsion F (C • E) _) : EllipticRootNumber.Pts F (C • E))
                rw [EllipticRootNumber.padic_smul_torsion,
                  EllipticRootNumber.padic_smul_torsion, map_nsmul]) }
          let e_pi := LinearEquiv.piCongrRight e_tors
          have h_tate₁ : ∀ x ∈ EllipticRootNumber.tateModule F E,
              e_pi x ∈ EllipticRootNumber.tateModule F (C • E) := by
            intro x hx n
            change EllipticRootNumber.ell F • e (x (n + 1)).1 = e (x n).1
            rw [← map_nsmul, hx n]
          have h_tate₂ : ∀ y ∈ EllipticRootNumber.tateModule F (C • E),
              e_pi.symm y ∈ EllipticRootNumber.tateModule F E := by
            intro y hy n
            change EllipticRootNumber.ell F • e.symm (y (n + 1)).1 = e.symm (y n).1
            rw [← map_nsmul, hy n]
          let e_tate : EllipticRootNumber.tateModule F E ≃ₗ[ℤ_[EllipticRootNumber.ell F]]
              EllipticRootNumber.tateModule F (C • E) :=
            { toFun := fun x => ⟨e_pi x.1, h_tate₁ x.1 x.2⟩
              invFun := fun y => ⟨e_pi.symm y.1, h_tate₂ y.1 y.2⟩
              left_inv := fun x => Subtype.ext (e_pi.symm_apply_apply x.1)
              right_inv := fun y => Subtype.ext (e_pi.apply_symm_apply y.1)
              map_add' := fun x₁ x₂ => Subtype.ext (map_add e_pi x₁.1 x₂.1)
              map_smul' := fun a x => Subtype.ext (map_smul e_pi a x.1) }
          have he_tate : ∀ σ : EllipticRootNumber.AbsGal F,
              e_tate.toLinearMap ∘ₗ EllipticRootNumber.tateRep F E σ =
                EllipticRootNumber.tateRep F (C • E) σ ∘ₗ e_tate.toLinearMap := by
            intro σ
            apply LinearMap.ext
            intro x
            apply Subtype.ext
            funext n
            apply Subtype.ext
            exact he σ (x.1 n).1
          let e_vq : EllipticRootNumber.VQ F E ≃ₗ[ℚ_[EllipticRootNumber.ell F]]
              EllipticRootNumber.VQ F (C • E) :=
            LinearEquiv.baseChange ℤ_[EllipticRootNumber.ell F] ℚ_[EllipticRootNumber.ell F] _ _ e_tate
          let f_vbar : EllipticRootNumber.VBar F E ≃ₗ[EllipticRootNumber.Ω F]
              EllipticRootNumber.VBar F (C • E) :=
            LinearEquiv.baseChange ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.Ω F) _ _ e_vq
          have hf_vbar : ∀ w : EllipticRootNumber.relWeil F ⊥,
              f_vbar.toLinearMap ∘ₗ
                  ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype w) =
                ((EllipticRootNumber.ellAdicRep F (C • E)).comp (EllipticRootNumber.relWeil F ⊥).subtype w) ∘ₗ
                  f_vbar.toLinearMap := by
            intro w
            change LinearMap.baseChange (EllipticRootNumber.Ω F)
                  (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F] e_tate.toLinearMap) ∘ₗ
                LinearMap.baseChange (EllipticRootNumber.Ω F)
                  (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateRep F E w.1)) =
              LinearMap.baseChange (EllipticRootNumber.Ω F)
                  (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateRep F (C • E) w.1)) ∘ₗ
                LinearMap.baseChange (EllipticRootNumber.Ω F)
                  (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F] e_tate.toLinearMap)
            rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp, he_tate w.1,
              LinearMap.baseChange_comp, LinearMap.baseChange_comp]
          have h_adm : EllipticRootNumber.IsAdmissibleChar F ⊥ (EllipticRootNumber.stdChar F) :=
            isAdmissibleChar_stdChar F
          have h_weil₁ : EllipticRootNumber.IsWeilRep F ⊥
              ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) :=
            isWeilRep_of_isPotentiallyGood F E hE
          set σ₁ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
          set σ₂ := (EllipticRootNumber.ellAdicRep F (C • E)).comp (EllipticRootNumber.relWeil F ⊥).subtype
          have h_weil₂ : EllipticRootNumber.IsWeilRep F ⊥ σ₂ := by
            refine ⟨?_, ?_⟩
            · haveI : FiniteDimensional (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) := h_weil₁.1
              exact f_vbar.finiteDimensional
            · obtain ⟨U, hU, hU_triv⟩ := h_weil₁.2
              refine ⟨U, hU, fun w hwU hwI => ?_⟩
              apply LinearMap.ext
              intro v
              obtain ⟨x, rfl⟩ := f_vbar.surjective v
              have hw₁ : σ₁ w = 1 := hU_triv w hwU hwI
              have hfx := LinearMap.congr_fun (hf_vbar w) x
              simp only [LinearMap.comp_apply, LinearEquiv.coe_coe] at hfx
              rw [← hfx, hw₁, Module.End.one_apply, Module.End.one_apply]
          let σ₀ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) PUnit.{u + 1} := 1
          have hσ₀ : EllipticRootNumber.IsWeilRep F ⊥ σ₀ := by
            refine ⟨inferInstance, ⟨Set.univ, Filter.univ_mem, fun _ _ _ => rfl⟩⟩
          haveI : FiniteDimensional F (⊥ : IntermediateField F (AlgebraicClosure F)) := inferInstance
          have h_eps₀_mul : lc.eps ⊥ σ₀ (EllipticRootNumber.stdChar F) =
              lc.eps ⊥ σ₀ (EllipticRootNumber.stdChar F) *
                lc.eps ⊥ σ₀ (EllipticRootNumber.stdChar F) := by
            apply lc.eps_exact ⊥ (EllipticRootNumber.stdChar F) h_adm σ₀ σ₀ σ₀ hσ₀ hσ₀ hσ₀ 0 0
            · intro _; exact Subsingleton.elim _ _
            · intro _; exact Subsingleton.elim _ _
            · intro x y _; exact Subsingleton.elim x y
            · intro y; exact ⟨0, Subsingleton.elim _ _⟩
            · exact Subsingleton.elim _ _
          have h_eps₀ : lc.eps ⊥ σ₀ (EllipticRootNumber.stdChar F) = 1 := by
            simpa using h_eps₀_mul.symm
          have h_eps₁₂ : lc.eps ⊥ σ₁ (EllipticRootNumber.stdChar F) =
              lc.eps ⊥ σ₀ (EllipticRootNumber.stdChar F) *
                lc.eps ⊥ σ₂ (EllipticRootNumber.stdChar F) := by
            apply lc.eps_exact ⊥ (EllipticRootNumber.stdChar F) h_adm σ₀ σ₁ σ₂
              hσ₀ h_weil₁ h_weil₂ 0 f_vbar.toLinearMap
            · intro _; ext x; simp
            · exact hf_vbar
            · intro x y _; exact Subsingleton.elim x y
            · exact f_vbar.surjective
            · rw [LinearMap.range_zero, LinearMap.ker_eq_bot.mpr f_vbar.injective]
          rw [h_eps₀, one_mul] at h_eps₁₂
          unfold EllipticRootNumber.wdRep
          rw [if_pos hCE, if_pos hE]
          exact congrArg Units.val h_eps₁₂.symm
        · have hCE : ¬ EllipticRootNumber.IsPotentiallyGood F (C • E) := mt h_pg.mp hE
          have h_quadSign : ∀ (σ : EllipticRootNumber.AbsGal F),
              EllipticRootNumber.quadSign F (C • E) σ = EllipticRootNumber.quadSign F E σ := by
            intro σ
            unfold EllipticRootNumber.quadSign
            set s₁ := EllipticRootNumber.sqrtNegC₆ F E
            set s₂ := EllipticRootNumber.sqrtNegC₆ F (C • E)
            set u₃ : AlgebraicClosure F := algebraMap F (AlgebraicClosure F) (((C.u⁻¹ : Fˣ) : F) ^ 3)
            have hu₃ : u₃ ≠ 0 := by
              simp only [u₃, ne_eq, map_eq_zero]
              exact pow_ne_zero 3 (Units.ne_zero C.u⁻¹)
            have hs₂_sq : s₂ ^ 2 = (u₃ * s₁) ^ 2 := by
              rw [EllipticRootNumber.sqrtNegC₆_sq, mul_pow, EllipticRootNumber.sqrtNegC₆_sq,
                WeierstrassCurve.variableChange_c₆]
              simp only [u₃, map_neg, map_mul, map_pow]
              ring
            have hσu₃ : σ u₃ = u₃ := AlgEquiv.commutes σ (((C.u⁻¹ : Fˣ) : F) ^ 3)
            have h_iff : σ s₂ = s₂ ↔ σ s₁ = s₁ := by
              rcases sq_eq_sq_iff_eq_or_eq_neg.mp hs₂_sq with hs₂ | hs₂
              · rw [hs₂, map_mul, hσu₃, mul_right_inj' hu₃]
              · rw [hs₂, map_neg, map_mul, hσu₃, neg_inj, mul_right_inj' hu₃]
            by_cases h : σ s₁ = s₁
            · rw [if_pos (h_iff.mpr h), if_pos h]
            · rw [if_neg (mt h_iff.mp h), if_neg h]
          have h_qc : EllipticRootNumber.quadChar F (C • E) = EllipticRootNumber.quadChar F E :=
            MonoidHom.ext h_quadSign
          have h_wd : EllipticRootNumber.wdRep F (C • E) = EllipticRootNumber.wdRep F E := by
            unfold EllipticRootNumber.wdRep EllipticRootNumber.quadCharΩ
            rw [if_neg hCE, if_neg hE, h_qc]
          unfold EllipticRootNumber.localEps
          rw [h_wd]
    · rw [dif_neg h_lf, dif_neg h_lf]

theorem adicCompletion_localFieldStructure (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    Nonempty (EllipticRootNumber.LocalFieldStructure (v.adicCompletion K)) :=
by
  let F := v.adicCompletion K
  let rel : ValuativeRel F :=
    ValuativeRel.ofValuation (Valued.v : Valuation F (WithZero (Multiplicative ℤ)))
  letI : ValuativeRel F := rel
  haveI : (Valued.v : Valuation F (WithZero (Multiplicative ℤ))).Compatible :=
    Valuation.Compatible.ofValuation Valued.v
  haveI : @ValuativeRel.IsNontrivial F _ rel :=
    (ValuativeRel.isNontrivial_iff_isNontrivial
      (Valued.v : Valuation F (WithZero (Multiplicative ℤ)))).mpr inferInstance
  haveI : @IsValuativeTopology F _ rel inferInstance := by
    have h_equiv : (ValuativeRel.valuation F).IsEquiv
        (Valued.v : Valuation F (WithZero (Multiplicative ℤ))) :=
      ValuativeRel.isEquiv (ValuativeRel.valuation F)
        (Valued.v : Valuation F (WithZero (Multiplicative ℤ)))
    have h_lt : ∀ x y : F,
        ValuativeRel.valuation F x < ValuativeRel.valuation F y ↔ Valued.v x < Valued.v y :=
      fun x y => Valuation.isEquiv_iff_val_lt_val.mp h_equiv
    apply IsValuativeTopology.of_zero
    intro s
    rw [Valued.mem_nhds_zero]
    constructor
    · rintro ⟨δ, hδ⟩
      obtain ⟨y, hy⟩ := v.valuedAdicCompletion_surjective K (δ : WithZero (Multiplicative ℤ))
      have hy0 : y ≠ 0 := by
        rintro rfl
        rw [Valuation.map_zero] at hy
        exact Units.ne_zero δ hy.symm
      have hvy0 : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy0
      refine ⟨Units.mk0 (ValuativeRel.valuation F y) hvy0, fun z hz => hδ ?_⟩
      simp only [Set.mem_setOf_eq, Units.val_mk0] at hz ⊢
      rwa [← hy, ← h_lt]
    · rintro ⟨γ, hγ⟩
      obtain ⟨y, hy⟩ := ValuativeRel.valuation_surjective (γ : ValuativeRel.ValueGroupWithZero F)
      have hy0 : y ≠ 0 := by
        rintro rfl
        rw [Valuation.map_zero] at hy
        exact Units.ne_zero γ hy.symm
      have hvy0 : (Valued.v : Valuation F (WithZero (Multiplicative ℤ))) y ≠ 0 :=
        (Valuation.ne_zero_iff _).mpr hy0
      refine ⟨Units.mk0 (Valued.v y) hvy0, fun z hz => hγ ?_⟩
      simp only [Set.mem_setOf_eq, Units.val_mk0] at hz ⊢
      rwa [← hy, h_lt]
  have h_dvr : IsDiscreteValuationRing ↥(Valued.integer F) :=
    instIsDiscreteValuationRingSubtypeAdicCompletionMemValuationSubringAdicCompletionIntegers
      (NumberField.RingOfIntegers K) K v
  have h_fin : Finite (Valued.ResidueField F) := by
    let R := NumberField.RingOfIntegers K
    let 𝒪v := v.adicCompletionIntegers K
    change Finite (IsLocalRing.ResidueField ↥𝒪v)
    let φ : R →+* IsLocalRing.ResidueField ↥𝒪v :=
      (IsLocalRing.residue ↥𝒪v).comp (algebraMap R ↥𝒪v)
    have hφ_ker : ∀ r ∈ v.asIdeal, φ r = 0 := by
      intro r hr
      change IsLocalRing.residue ↥𝒪v (algebraMap R ↥𝒪v r) = 0
      rw [IsLocalRing.residue_eq_zero_iff]
      apply (Valuation.mem_maximalIdeal_iff F Valued.v).mpr
      change Valued.v ((algebraMap R K r : K) : F) < 1
      rw [v.valuedAdicCompletion_eq_valuation', v.valuation_of_algebraMap]
      exact (v.intValuation_lt_one_iff_mem r).mpr hr
    refine Finite.of_surjective (Ideal.Quotient.lift v.asIdeal φ hφ_ker) ?_
    intro xbar
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective xbar
    have h_nhds : {y : F | Valued.v (y - (x : F)) <
        ((1 : (WithZero (Multiplicative ℤ))ˣ) : WithZero (Multiplicative ℤ))} ∈ nhds (x : F) :=
      Valued.mem_nhds.mpr ⟨1, fun _ hy => hy⟩
    obtain ⟨k₀, hk_lt⟩ := UniformSpace.Completion.denseRange_coe.mem_nhds h_nhds
    let k : K := k₀
    change Valued.v ((k : F) - (x : F)) < 1 at hk_lt
    have hk_le : v.valuation K k ≤ 1 := by
      rw [← v.valuedAdicCompletion_eq_valuation']
      have h1 : (k : F) = ((k : F) - (x : F)) + (x : F) := (sub_add_cancel (k : F) (x : F)).symm
      rw [h1]
      exact le_trans (Valuation.map_add _ _ _) (max_le (le_of_lt hk_lt) x.2)
    obtain ⟨a, ha_int, i, _, ha_notMem⟩ :=
      Ideal.exist_integer_multiples_notMem (J := v.asIdeal) v.isMaximal.ne_top
        (Finset.univ : Finset (Fin 2)) (![1, k] : Fin 2 → K) (Finset.mem_univ 0) (by simp)
    obtain ⟨b, hb⟩ := ha_int 0 (Finset.mem_univ 0)
    obtain ⟨c, hc⟩ := ha_int 1 (Finset.mem_univ 1)
    simp only [Matrix.cons_val_zero, mul_one] at hb
    simp only [Matrix.cons_val_one, Matrix.cons_val_zero] at hc
    have hb_notMem : b ∉ v.asIdeal := by
      intro hb_mem
      have hc_mem : c ∈ v.asIdeal := by
        rw [← v.intValuation_lt_one_iff_mem, ← v.valuation_of_algebraMap (K := K)]
        change v.valuation K (algebraMap R K c) < 1
        rw [hc, ← hb, Valuation.map_mul, v.valuation_of_algebraMap]
        exact lt_of_le_of_lt (mul_le_of_le_one_right' hk_le)
          ((v.intValuation_lt_one_iff_mem b).mpr hb_mem)
      fin_cases i
      · simp only [Fin.zero_eta, Matrix.cons_val_zero, mul_one] at ha_notMem
        exact ha_notMem ((FractionalIdeal.mem_coeIdeal _).mpr ⟨b, hb_mem, hb⟩)
      · simp only [Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero] at ha_notMem
        exact ha_notMem ((FractionalIdeal.mem_coeIdeal _).mpr ⟨c, hc_mem, hc⟩)
    have hb_val : v.valuation K (algebraMap R K b) = 1 := by
      rw [v.valuation_of_algebraMap]
      exact le_antisymm (v.intValuation_le_one b)
        (not_lt.mp (mt (v.intValuation_lt_one_iff_mem b).mp hb_notMem))
    haveI : v.asIdeal.IsMaximal := v.isMaximal
    letI : Field (R ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    have hbbar : Ideal.Quotient.mk v.asIdeal b ≠ 0 :=
      mt Ideal.Quotient.eq_zero_iff_mem.mp hb_notMem
    obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk v.asIdeal b)⁻¹
    have hbd_mem : b * d - 1 ∈ v.asIdeal := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hd, mul_inv_cancel₀ hbbar, map_one,
        sub_self]
    have hbd_val : v.valuation K (algebraMap R K (b * d - 1)) < 1 := by
      rw [v.valuation_of_algebraMap]
      exact (v.intValuation_lt_one_iff_mem (b * d - 1)).mpr hbd_mem
    have h_id : algebraMap R K b * (algebraMap R K (c * d) - k) =
        algebraMap R K c * algebraMap R K (b * d - 1) := by
      push_cast
      calc (algebraMap R K b) * (algebraMap R K c * algebraMap R K d - k)
          = algebraMap R K c * (algebraMap R K b * algebraMap R K d) - (algebraMap R K b * k) := by ring
        _ = algebraMap R K c * (algebraMap R K b * algebraMap R K d - 1) := by
          rw [hb, ← hc]
          ring
    have hrk_val : v.valuation K (algebraMap R K (c * d) - k) < 1 := by
      have h_eq := congrArg (v.valuation K) h_id
      rw [Valuation.map_mul, Valuation.map_mul, hb_val, one_mul, v.valuation_of_algebraMap] at h_eq
      rw [h_eq]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' (v.intValuation_le_one c)) hbd_val
    refine ⟨Ideal.Quotient.mk v.asIdeal (c * d), ?_⟩
    rw [Ideal.Quotient.lift_mk]
    change IsLocalRing.residue ↥𝒪v (algebraMap R ↥𝒪v (c * d)) = IsLocalRing.residue ↥𝒪v x
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    apply (Valuation.mem_maximalIdeal_iff F Valued.v).mpr
    change Valued.v (((algebraMap R K (c * d) : K) : F) - (x : F)) < 1
    have h_split : ((algebraMap R K (c * d) : K) : F) - (x : F) =
        (((algebraMap R K (c * d) - k : K) : F)) + ((k : F) - (x : F)) := by
      rw [UniformSpace.Completion.coe_sub]
      ring
    rw [h_split]
    refine lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt ?_ hk_lt)
    rwa [v.valuedAdicCompletion_eq_valuation']
  haveI : ProperSpace F :=
    Valued.integer.properSpace_iff_completeSpace_and_isDiscreteValuationRing_integer_and_finite_residueField.mpr
      ⟨inferInstance, h_dvr, h_fin⟩
  haveI : LocallyCompactSpace F := inferInstance
  exact ⟨{
    rel := rel
    top := inferInstance
    isLocalField := @IsNonarchimedeanLocalField.mk F _ rel inferInstance _ _ _
  }⟩

theorem adicCompletion_valuation_le_one_of_valued_le_one (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    [ValuativeRel (v.adicCompletion K)] [TopologicalSpace (v.adicCompletion K)]
    [IsNonarchimedeanLocalField (v.adicCompletion K)]
    (z : v.adicCompletion K) (hz : Valued.v z ≤ 1) :
    ValuativeRel.valuation (v.adicCompletion K) z ≤ 1 :=
by
  have probe_hensel : ∀ (F : Type u) [Field F]
      [Valued F (WithZero (Multiplicative ℤ))] [CompleteSpace F]
      [IsDiscreteValuationRing ↥(Valued.integer F)]
      (x : F) (hx : Valued.v x < 1)
      (r : ℕ) (hr_pos : 0 < r) (hr_val : Valued.v (r : F) = 1),
      ∃ y : F, y ^ r = 1 + x := by
    clear! K
    intro F _ _ _ _ x hx r hr_pos hr_val
    haveI : IsClosed (Valued.integer F : Set F) := Valued.isClosed_integer F
    haveI : CompleteSpace ↥(Valued.integer F) := IsClosed.completeSpace_coe
    let m_v := IsLocalRing.maximalIdeal ↥(Valued.integer F)
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible ↥(Valued.integer F)
    have hϖ_pow : ∀ n : ℕ, (↑(m_v ^ n) : Set ↥(Valued.integer F)) =
        {y : ↥(Valued.integer F) | Valued.v (y : F) ≤ Valued.v (ϖ : F) ^ n} :=
      Irreducible.maximalIdeal_pow_eq_setOf_le_v_coe_pow Valued.v hϖ
    have hϖ_ne : (ϖ : F) ≠ 0 := fun h => hϖ.ne_zero (Subtype.ext h)
    have hϖ_v_ne : Valued.v (ϖ : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr hϖ_ne
    have hϖ_mem : ϖ ∈ m_v := (IsLocalRing.mem_maximalIdeal ϖ).mpr hϖ.not_isUnit
    have hϖ_lt_one : Valued.v (ϖ : F) < 1 := (Valuation.mem_maximalIdeal_iff _ _).mp hϖ_mem
    obtain ⟨c, hc⟩ := Option.ne_none_iff_exists'.mp hϖ_v_ne
    have hϖ_exp : Valued.v (ϖ : F) = WithZero.exp (Multiplicative.toAdd c) := hc
    have hc_lt : Multiplicative.toAdd c < 0 := by
      rw [hϖ_exp, ← WithZero.exp_zero, WithZero.exp_lt_exp] at hϖ_lt_one
      exact hϖ_lt_one
    have hϖ_le_neg1 : Valued.v (ϖ : F) ≤ WithZero.exp (-1 : ℤ) := by
      rw [hϖ_exp, WithZero.exp_le_exp]
      omega
    have h_adic : IsAdic m_v := by
      rw [isAdic_iff]
      refine ⟨?_, ?_⟩
      · intro n
        rw [hϖ_pow n]
        exact (Valued.isOpen_closedBall F (pow_ne_zero n hϖ_v_ne)).preimage continuous_subtype_val
      · intro s hs
        rw [nhds_induced, Filter.mem_comap] at hs
        obtain ⟨t, ht_nhds, ht_sub⟩ := hs
        change t ∈ nhds (0 : F) at ht_nhds
        rw [Valued.mem_nhds_zero] at ht_nhds
        obtain ⟨γ, hγ⟩ := ht_nhds
        obtain ⟨d, hd⟩ := Option.ne_none_iff_exists'.mp (Units.ne_zero γ)
        have hγ_exp : (γ : WithZero (Multiplicative ℤ)) = WithZero.exp (Multiplicative.toAdd d) := hd
        let n : ℕ := (-Multiplicative.toAdd d).toNat + 1
        refine ⟨n, ?_⟩
        intro y hy
        apply ht_sub
        apply hγ
        rw [hϖ_pow n] at hy
        simp only [Set.mem_setOf_eq] at hy ⊢
        have h1 : Valued.v (y : F) ≤ WithZero.exp (-(n : ℤ)) := by
          calc Valued.v (y : F) ≤ Valued.v (ϖ : F) ^ n := hy
            _ ≤ (WithZero.exp (-1 : ℤ)) ^ n := pow_le_pow_left' hϖ_le_neg1 n
            _ = WithZero.exp (-(n : ℤ)) := by
              rw [← WithZero.exp_nsmul]
              simp
        refine lt_of_le_of_lt h1 ?_
        rw [hγ_exp, WithZero.exp_lt_exp]
        omega
    haveI : IsUniformAddGroup ↥(Valued.integer F) :=
      AddSubgroup.isUniformAddGroup (Valued.integer F).toAddSubgroup
    haveI : IsAdicComplete m_v ↥(Valued.integer F) :=
      (IsAdic.isAdicComplete_iff h_adic).mpr ⟨inferInstance, inferInstance⟩
    haveI : HenselianRing ↥(Valued.integer F) m_v :=
      IsAdicComplete.henselianRing ↥(Valued.integer F) m_v
    let x₀ : ↥(Valued.integer F) := ⟨x, le_of_lt hx⟩
    let u₀ : ↥(Valued.integer F) := 1 + x₀
    let f : Polynomial ↥(Valued.integer F) := Polynomial.X ^ r - Polynomial.C u₀
    have hf_monic : f.Monic := Polynomial.monic_X_pow_sub_C u₀ (by omega)
    have hf_eval_eq : Polynomial.eval 1 f = -x₀ := by
      simp only [f, u₀, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, one_pow,
        Polynomial.eval_C]
      ring
    have hf_eval : Polynomial.eval 1 f ∈ m_v := by
      rw [hf_eval_eq, neg_mem_iff]
      exact (Valuation.mem_maximalIdeal_iff _ _).mpr hx
    have hf_deriv_eq : Polynomial.eval 1 (Polynomial.derivative f) = (r : ↥(Valued.integer F)) := by
      simp [f, Polynomial.derivative_X_pow]
    have hf_deriv : IsUnit (Ideal.Quotient.mk m_v (Polynomial.eval 1 (Polynomial.derivative f))) := by
      rw [hf_deriv_eq]
      apply IsUnit.map
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hr_mem
      have hr_lt : Valued.v (((r : ↥(Valued.integer F)) : F)) < 1 :=
        (Valuation.mem_maximalIdeal_iff _ _).mp hr_mem
      rw [Subring.coe_natCast, hr_val] at hr_lt
      exact lt_irrefl 1 hr_lt
    obtain ⟨y₀, hy₀_root, _⟩ := HenselianRing.is_henselian f hf_monic 1 hf_eval hf_deriv
    refine ⟨(y₀ : F), ?_⟩
    rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C, sub_eq_zero] at hy₀_root
    have hy₀_val := congrArg ((Valued.integer F).subtype : ↥(Valued.integer F) →+* F) hy₀_root
    simp only [u₀, x₀, map_pow, map_add, map_one] at hy₀_val
    exact hy₀_val
  let F := v.adicCompletion K
  let e := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  let v₁ : Valuation F (WithZero (Multiplicative ℤ)) := Valued.v
  let v₂ : F →*₀ WithZero (Multiplicative ℤ) :=
    e.toMonoidWithZeroHom.comp (ValuativeRel.valuation F).toMonoidWithZeroHom
  by_contra h_not_le
  have hz₂_gt : 1 < v₂ z := by
    change 1 < e (ValuativeRel.valuation F z)
    rw [← map_one e, map_lt_map_iff]
    exact lt_of_not_ge h_not_le
  have hz₂_ne : v₂ z ≠ 0 := ne_of_gt (lt_trans zero_lt_one hz₂_gt)
  obtain ⟨a₀, ha₀⟩ := Option.ne_none_iff_exists'.mp hz₂_ne
  let a := Multiplicative.toAdd a₀
  have hz₂ : v₂ z = WithZero.exp a := ha₀
  have ha_pos : 1 ≤ a := by
    rw [hz₂, ← WithZero.exp_zero, WithZero.exp_lt_exp] at hz₂_gt
    omega
  obtain ⟨π₀, hπ₀⟩ := v.valuation_exists_uniformizer K
  let π : F := (π₀ : F)
  have hπ₁ : v₁ π = WithZero.exp (-1 : ℤ) := by
    change Valued.v (π₀ : F) = _
    rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation', hπ₀]
  have hπ_ne : π ≠ 0 := by
    intro hπ0
    rw [hπ0, map_zero] at hπ₁
    exact WithZero.exp_ne_zero hπ₁.symm
  have hv₂_π_ne : v₂ π ≠ 0 := by
    change e (ValuativeRel.valuation F π) ≠ 0
    rw [map_ne_zero, Valuation.ne_zero_iff]
    exact hπ_ne
  obtain ⟨b₀, hb₀⟩ := Option.ne_none_iff_exists'.mp hv₂_π_ne
  let b := Multiplicative.toAdd b₀
  have hπ₂ : v₂ π = WithZero.exp b := hb₀
  let k : ℕ := (-b).toNat + 2
  let x : F := π * z ^ k
  have hx₁ : v₁ x < 1 := by
    calc v₁ (π * z ^ k) = v₁ π * v₁ z ^ k := by rw [map_mul, map_pow]
      _ ≤ WithZero.exp (-1 : ℤ) * 1 ^ k := by
        rw [hπ₁]
        exact mul_le_mul_right (pow_le_pow_left' hz k) _
      _ = WithZero.exp (-1 : ℤ) := by rw [one_pow, mul_one]
      _ < 1 := by rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; omega
  have hx₂ : v₂ x = WithZero.exp (b + k • a) := by
    change v₂ (π * z ^ k) = _
    rw [map_mul, map_pow, hπ₂, hz₂, ← WithZero.exp_nsmul, ← WithZero.exp_add]
  have hm_ge : 2 ≤ b + k • a := by
    simp only [nsmul_eq_mul]
    have hk_ge : -b + 2 ≤ (k : ℤ) := by omega
    nlinarith
  let m : ℕ := (b + k • a).toNat
  have hm_eq : (m : ℤ) = b + k • a := Int.toNat_of_nonneg (by omega)
  have hm_pos : 0 < m := by omega
  haveI : v.asIdeal.IsMaximal := v.isPrime.isMaximal v.ne_bot
  letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
  let p_char := ringChar (NumberField.RingOfIntegers K ⧸ v.asIdeal)
  obtain ⟨r, hr_ge, hr_prime⟩ := Nat.exists_infinite_primes (max p_char m + 1)
  have hr_gt_p : p_char < r := by omega
  have hr_gt_m : m < r := by omega
  have hr_notMem : (r : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
    intro hr_mem
    have hr_zero : (Ideal.Quotient.mk v.asIdeal (r : NumberField.RingOfIntegers K)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hr_mem
    rw [map_natCast] at hr_zero
    have hdvd : p_char ∣ r := (ringChar.spec (NumberField.RingOfIntegers K ⧸ v.asIdeal) r).mp hr_zero
    rcases hr_prime.eq_one_or_self_of_dvd p_char hdvd with hp1 | hpr
    · have h10 : ((1 : ℕ) : NumberField.RingOfIntegers K ⧸ v.asIdeal) = 0 := by
        rw [← hp1]
        exact ringChar.Nat.cast_ringChar
      rw [Nat.cast_one] at h10
      exact one_ne_zero h10
    · omega
  have hr_val : Valued.v (r : F) = 1 := by
    rw [← map_natCast (algebraMap (NumberField.RingOfIntegers K) F) r]
    change Valued.v ((algebraMap (NumberField.RingOfIntegers K) K (r : NumberField.RingOfIntegers K) : F)) = 1
    rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation',
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff]
    exact hr_notMem
  have h_dvr : IsDiscreteValuationRing ↥(Valued.integer F) :=
    instIsDiscreteValuationRingSubtypeAdicCompletionMemValuationSubringAdicCompletionIntegers
      (NumberField.RingOfIntegers K) K v
  obtain ⟨y, hy⟩ := @probe_hensel F _ _ _ h_dvr x hx₁ r hr_prime.pos hr_val
  have hx_gt_one : ValuativeRel.valuation F 1 < ValuativeRel.valuation F x := by
    rw [← map_lt_map_iff e]
    change v₂ 1 < v₂ x
    rw [map_one, hx₂, ← hm_eq, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have hv₂_1x : v₂ (1 + x) = WithZero.exp (m : ℤ) := by
    change e (ValuativeRel.valuation F (1 + x)) = _
    rw [Valuation.map_add_eq_of_lt_right (ValuativeRel.valuation F) hx_gt_one]
    change v₂ x = _
    rw [hx₂, hm_eq]
  have hv₂_yr : v₂ y ^ r = WithZero.exp (m : ℤ) := by
    rw [← map_pow, hy, hv₂_1x]
  have hv₂y_ne : v₂ y ≠ 0 := by
    rintro h0
    rw [h0, zero_pow hr_prime.ne_zero] at hv₂_yr
    exact WithZero.exp_ne_zero hv₂_yr.symm
  obtain ⟨d₀, hd₀⟩ := Option.ne_none_iff_exists'.mp hv₂y_ne
  let d := Multiplicative.toAdd d₀
  have hv₂y : v₂ y = WithZero.exp d := hd₀
  rw [hv₂y, ← WithZero.exp_nsmul] at hv₂_yr
  have hrd : r • d = (m : ℤ) := WithZero.exp_injective hv₂_yr
  simp only [nsmul_eq_mul] at hrd
  have hd_nonneg : 0 ≤ d := by
    have : (0 : ℤ) < r := by exact_mod_cast hr_prime.pos
    nlinarith
  have hd_eq : (d.toNat : ℤ) = d := Int.toNat_of_nonneg hd_nonneg
  rw [← hd_eq] at hrd
  have hdvd_m : r ∣ m := ⟨d.toNat, by exact_mod_cast hrd.symm⟩
  have hr_le_m : r ≤ m := Nat.le_of_dvd hm_pos hdvd_m
  omega

theorem vBar_finiteDimensional (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (E : WeierstrassCurve F)
    (hΔ : ValuativeRel.valuation F E.Δ = 1) :
    FiniteDimensional (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) :=
by
  classical
  let K := AlgebraicClosure F
  let W := (E.baseChange K).toAffine
  let ℓ := EllipticRootNumber.ell F
  haveI : Fact ℓ.Prime := EllipticRootNumber.ell_prime F
  have h_ell_ne : (ℓ : K) ≠ 0 := by
    intro h0
    have h0_F : (ℓ : F) = 0 := by
      apply (algebraMap F K).injective
      rw [map_natCast, map_zero]
      exact h0
    have h0_O : (ℓ : (ValuativeRel.valuation F).valuationSubring) = 0 := by
      apply Subtype.ext
      exact h0_F
    have h0_k : (ℓ : IsLocalRing.ResidueField (ValuativeRel.valuation F).valuationSubring) = 0 := by
      have h_res := congrArg (IsLocalRing.residue (ValuativeRel.valuation F).valuationSubring) h0_O
      simpa using h_res
    have h_dvd : EllipticRootNumber.p F ∣ ℓ :=
      (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).valuationSubring) ℓ).mp h0_k
    rcases (EllipticRootNumber.ell_prime F).out.eq_one_or_self_of_dvd (EllipticRootNumber.p F) h_dvd with hp1 | hp_eq
    · have h1 : ((1 : ℕ) : IsLocalRing.ResidueField (ValuativeRel.valuation F).valuationSubring) = 0 :=
        (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).valuationSubring) 1).mpr
          (by change EllipticRootNumber.p F ∣ 1; rw [hp1])
      rw [Nat.cast_one] at h1
      exact one_ne_zero h1
    · exact EllipticRootNumber.ell_ne_p F hp_eq.symm
  obtain ⟨v, h_gen, hv_le, hv_eq, hv_X⟩ :=
    exists_functionField_valuation_and_generic_nonsingular K W
  have hm_val : v ((ℓ ^ 1 : ℕ) : W.FunctionField) = 1 := by
    rw [pow_one, ← map_natCast (algebraMap K W.FunctionField)]
    exact hv_eq (ℓ : K) h_ell_ne
  have hm_ne : (ℓ ^ 1) • (WeierstrassCurve.Affine.Point.some h_gen :
      ((W.map (algebraMap K W.FunctionField)).toAffine).Point) ≠ 0 :=
    weierstrass_nsmul_ne_zero_of_valuation v ((W.map (algebraMap K W.FunctionField)).toAffine)
      (hv_le W.a₁) (hv_le W.a₂) (hv_le W.a₃) (hv_le W.a₄) (hv_le W.a₆) h_gen hv_X (ℓ ^ 1) hm_val
  have h_fin : Finite (EllipticRootNumber.torsion F E (ℓ ^ 1)) :=
    torsion_finite_of_generic_nsmul_ne_zero K W h_gen (ℓ ^ 1) hm_ne
  let M := EllipticRootNumber.tateModule F E
  let T₀ := EllipticRootNumber.torsion F E (ℓ ^ 1)
  haveI : Fintype T₀ := Fintype.ofFinite T₀
  have h_div : ∀ x : M, x.1 0 = 0 → ∃ y : M, (ℓ : ℤ_[ℓ]) • y = x := by
    intro x hx0
    have h_tors : ∀ n : ℕ, (ℓ ^ (n + 1)) • ((x.1 (n + 1) : EllipticRootNumber.torsion F E _) :
        EllipticRootNumber.Pts F E) = 0 := by
      intro n
      induction n with
      | zero =>
        rw [zero_add, pow_one]
        change EllipticRootNumber.ell F • ((x.1 1 : EllipticRootNumber.torsion F E _) :
          EllipticRootNumber.Pts F E) = 0
        rw [x.2 0, hx0, AddSubgroup.coe_zero]
      | succ n ih =>
        have hpow : ℓ ^ (n + 1 + 1) = ℓ * ℓ ^ (n + 1) := by ring
        rw [hpow, mul_nsmul]
        change (ℓ ^ (n + 1)) • (EllipticRootNumber.ell F •
          ((x.1 (n + 1 + 1) : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E)) = 0
        rw [x.2 (n + 1), ih]
    let y_fun : ∀ n : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) :=
      fun n => ⟨(x.1 (n + 1) : EllipticRootNumber.Pts F E), h_tors n⟩
    have hy_mem : y_fun ∈ M := by
      intro n
      exact x.2 (n + 1)
    refine ⟨⟨y_fun, hy_mem⟩, ?_⟩
    apply Subtype.ext
    funext n
    apply Subtype.ext
    change (((ℓ : ℤ_[ℓ]) • y_fun n : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) =
      (x.1 n : EllipticRootNumber.Pts F E)
    rw [EllipticRootNumber.padic_smul_torsion]
    have h_to : PadicInt.toZModPow (n + 1) (ℓ : ℤ_[ℓ]) = (ℓ : ZMod (ℓ ^ (n + 1))) := by
      simp
    rw [h_to, ZMod.val_natCast]
    have h_eq : (ℓ % (ℓ ^ (n + 1))) • ((x.1 (n + 1) : EllipticRootNumber.torsion F E _) :
        EllipticRootNumber.Pts F E) =
        EllipticRootNumber.ell F • ((x.1 (n + 1) : EllipticRootNumber.torsion F E _) :
          EllipticRootNumber.Pts F E) := by
      apply EllipticRootNumber.nsmul_eq_of_modEq F E (h_tors n)
      exact Nat.mod_modEq ℓ (ℓ ^ (n + 1))
    rw [h_eq, x.2 n]
  let e : T₀ → M := fun t => if h : ∃ z : M, z.1 0 = t then h.choose else 0
  have he_spec : ∀ x : M, (e (x.1 0)).1 0 = x.1 0 := by
    intro x
    have h : ∃ z : M, z.1 0 = x.1 0 := ⟨x, rfl⟩
    dsimp only [e]
    rw [dif_pos h]
    exact h.choose_spec
  have h_step : ∀ z : M, ∃ w : M, z = e (z.1 0) + (ℓ : ℤ_[ℓ]) • w := by
    intro z
    have h0 : (z - e (z.1 0)).1 0 = 0 := by
      change z.1 0 - (e (z.1 0)).1 0 = 0
      rw [he_spec z, sub_self]
    obtain ⟨w, hw⟩ := h_div (z - e (z.1 0)) h0
    refine ⟨w, ?_⟩
    rw [hw, add_sub_cancel]
  choose next_z h_next_z using h_step
  let φ : (T₀ → ℤ_[ℓ]) →ₗ[ℤ_[ℓ]] M :=
    { toFun := fun c => ∑ t : T₀, c t • e t
      map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
      map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
  have h_surj : Function.Surjective φ := by
    intro x
    let z : ℕ → M := fun k => Nat.recOn k x (fun _ zk => next_z zk)
    have hz_step : ∀ k : ℕ, z k = e ((z k).1 0) + (ℓ : ℤ_[ℓ]) • z (k + 1) :=
      fun k => h_next_z (z k)
    have hz_sum : ∀ m : ℕ, x = (∑ k ∈ Finset.range m, (ℓ : ℤ_[ℓ]) ^ k • e ((z k).1 0)) +
        (ℓ : ℤ_[ℓ]) ^ m • z m := by
      intro m
      induction m with
      | zero =>
        simp [z]
      | succ m ih =>
        rw [Finset.sum_range_succ, pow_succ, mul_smul, add_assoc, ← smul_add, ← hz_step m, ← ih]
    let d : T₀ → ℕ → ℕ := fun t k => if (z k).1 0 = t then 1 else 0
    let s : T₀ → ℕ → ℕ := fun t m => ∑ k ∈ Finset.range m, d t k * ℓ ^ k
    have hs_compat : ∀ (t : T₀) (m₁ m₂ : ℕ) (h : m₁ ≤ m₂),
        (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m₁))) (s t m₂ : ZMod (ℓ ^ m₂)) =
          (s t m₁ : ZMod (ℓ ^ m₁)) := by
      intro t m₁ m₂ h
      rw [map_natCast]
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
      dsimp only [s]
      rw [Finset.sum_range_add, Nat.cast_add]
      have h_tail : ((∑ i ∈ Finset.range k, d t (m₁ + i) * ℓ ^ (m₁ + i) : ℕ) : ZMod (ℓ ^ m₁)) = 0 := by
        rw [Nat.cast_sum]
        apply Finset.sum_eq_zero
        intro i _
        have h_term : d t (m₁ + i) * ℓ ^ (m₁ + i) = (ℓ ^ m₁) * (d t (m₁ + i) * ℓ ^ i) := by
          rw [pow_add]
          ring
        rw [h_term, Nat.cast_mul, ZMod.natCast_self, zero_mul]
      rw [h_tail, add_zero]
    let f : T₀ → ∀ k : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ k) :=
      fun t k => Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ k))) (s t k : ZMod (ℓ ^ k))
    have hf_compat : ∀ (t : T₀) (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (f t k₂) = f t k₁ := by
      intro t k₁ k₂ hk
      apply Polynomial.ringHom_ext'
      · ext r
        simp [f]
      · simp [f, hs_compat t k₁ k₂ hk]
    let c : T₀ → ℤ_[ℓ] := fun t => PadicInt.lift (hf_compat t) Polynomial.X
    have hc_spec : ∀ (t : T₀) (n : ℕ),
        PadicInt.toZModPow (n + 1) (c t) = (s t (n + 1) : ZMod (ℓ ^ (n + 1))) := by
      intro t n
      change ((PadicInt.toZModPow (n + 1)).comp (PadicInt.lift (hf_compat t))) Polynomial.X = _
      rw [PadicInt.lift_spec (hf_compat t) (n + 1)]
      simp [f]
    refine ⟨c, ?_⟩
    change (∑ t : T₀, c t • e t) = x
    apply Subtype.ext
    funext n
    apply Subtype.ext
    let projPts : M →+ EllipticRootNumber.Pts F E :=
      { toFun := fun u => ((u.1 n : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E)
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    change projPts (∑ t : T₀, c t • e t) = projPts x
    rw [hz_sum (n + 1), map_add]
    have h_rem_zero : projPts ((ℓ : ℤ_[ℓ]) ^ (n + 1) • z (n + 1)) = 0 := by
      change ((((ℓ : ℤ_[ℓ]) ^ (n + 1)) • (z (n + 1)).1 n : EllipticRootNumber.torsion F E _) :
        EllipticRootNumber.Pts F E) = 0
      rw [EllipticRootNumber.padic_smul_torsion]
      have h_zmod : PadicInt.toZModPow (n + 1) ((ℓ : ℤ_[ℓ]) ^ (n + 1)) = 0 := by
        rw [map_pow]
        have h1 : PadicInt.toZModPow (n + 1) (ℓ : ℤ_[ℓ]) = (ℓ : ZMod (ℓ ^ (n + 1))) := by simp
        rw [h1, ← Nat.cast_pow, ZMod.natCast_self]
      rw [h_zmod, ZMod.val_zero, zero_nsmul]
    rw [h_rem_zero, add_zero, map_sum, map_sum]
    have h_ct : ∀ t : T₀, projPts (c t • e t) =
        ∑ k ∈ Finset.range (n + 1), projPts (((d t k * ℓ ^ k : ℕ) : ℤ_[ℓ]) • e t) := by
      intro t
      have h_s : (((s t (n + 1) : ℕ) : ℤ_[ℓ]) • e t) =
          ∑ k ∈ Finset.range (n + 1), ((d t k * ℓ ^ k : ℕ) : ℤ_[ℓ]) • e t := by
        dsimp only [s]
        rw [Nat.cast_sum, Finset.sum_smul]
      rw [← map_sum, ← h_s]
      change ((c t • (e t).1 n : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) =
        ((((s t (n + 1) : ℕ) : ℤ_[ℓ]) • (e t).1 n : EllipticRootNumber.torsion F E _) :
          EllipticRootNumber.Pts F E)
      rw [EllipticRootNumber.padic_smul_torsion, EllipticRootNumber.padic_smul_torsion, hc_spec t n]
      have h_to : PadicInt.toZModPow (n + 1) (s t (n + 1) : ℤ_[ℓ]) =
          (s t (n + 1) : ZMod (ℓ ^ (n + 1))) := by simp
      rw [h_to]
    simp_rw [h_ct]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro k _
    rw [Finset.sum_eq_single ((z k).1 0)]
    · dsimp only [d]
      rw [if_pos rfl, one_mul, Nat.cast_pow]
    · intro t _ ht
      dsimp only [d]
      rw [if_neg (Ne.symm ht), zero_mul, Nat.cast_zero, zero_smul, map_zero]
    · intro h_abs
      exact False.elim (h_abs (Finset.mem_univ _))
  haveI : Module.Finite ℤ_[ℓ] M := Module.Finite.of_surjective φ h_surj
  infer_instance

theorem ellAdicRep_inertia_trivial_of_good_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (E : WeierstrassCurve F)
    (ha₁ : ValuativeRel.valuation F E.a₁ ≤ 1)
    (ha₂ : ValuativeRel.valuation F E.a₂ ≤ 1)
    (ha₃ : ValuativeRel.valuation F E.a₃ ≤ 1)
    (ha₄ : ValuativeRel.valuation F E.a₄ ≤ 1)
    (ha₆ : ValuativeRel.valuation F E.a₆ ≤ 1)
    (hΔ : ValuativeRel.valuation F E.Δ = 1)
    (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.inertia F) :
    EllipticRootNumber.ellAdicRep F E σ = 1 :=
by
  classical
  obtain ⟨v, hv_gal, hv_le, hv_lt, hv_eq, hv_minpoly, hv_ell⟩ :=
    exists_galois_invariant_valuation_extension F
  let W : WeierstrassCurve.Affine (AlgebraicClosure F) :=
    (E.baseChange (AlgebraicClosure F)).toAffine
  have ha₁' : v W.a₁ ≤ 1 := by
    change v (E.map (algebraMap F (AlgebraicClosure F))).a₁ ≤ 1
    rw [WeierstrassCurve.map_a₁]
    exact (hv_le E.a₁).mpr ha₁
  have ha₂' : v W.a₂ ≤ 1 := by
    change v (E.map (algebraMap F (AlgebraicClosure F))).a₂ ≤ 1
    rw [WeierstrassCurve.map_a₂]
    exact (hv_le E.a₂).mpr ha₂
  have ha₃' : v W.a₃ ≤ 1 := by
    change v (E.map (algebraMap F (AlgebraicClosure F))).a₃ ≤ 1
    rw [WeierstrassCurve.map_a₃]
    exact (hv_le E.a₃).mpr ha₃
  have ha₄' : v W.a₄ ≤ 1 := by
    change v (E.map (algebraMap F (AlgebraicClosure F))).a₄ ≤ 1
    rw [WeierstrassCurve.map_a₄]
    exact (hv_le E.a₄).mpr ha₄
  have ha₆' : v W.a₆ ≤ 1 := by
    change v (E.map (algebraMap F (AlgebraicClosure F))).a₆ ≤ 1
    rw [WeierstrassCurve.map_a₆]
    exact (hv_le E.a₆).mpr ha₆
  have hΔ' : v W.Δ = 1 := by
    change v (E.map (algebraMap F (AlgebraicClosure F))).Δ = 1
    rw [WeierstrassCurve.map_Δ]
    exact (hv_eq E.Δ).mpr hΔ
  have h_pts : ∀ (n : ℕ) (P : EllipticRootNumber.Pts F E),
      P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) →
      EllipticRootNumber.galHom F E σ P = P := by
    intro n P hP
    let m : ℕ := EllipticRootNumber.ell F ^ (n + 1)
    have hm : v (m : AlgebraicClosure F) = 1 := by
      change v ((EllipticRootNumber.ell F ^ (n + 1) : ℕ) : AlgebraicClosure F) = 1
      rw [Nat.cast_pow, map_pow, hv_ell, one_pow]
    have hP_m : m • P = 0 := (EllipticRootNumber.mem_torsion F E).mp hP
    have hP' : EllipticRootNumber.galHom F E σ P ∈ EllipticRootNumber.torsion F E m :=
      EllipticRootNumber.galHom_mem_torsion F E σ hP
    have hP'_m : m • EllipticRootNumber.galHom F E σ P = 0 :=
      (EllipticRootNumber.mem_torsion F E).mp hP'
    rcases P with _ | @⟨x₁, y₁, h₁⟩
    · rfl
    · let h₂ : W.Nonsingular (σ x₁) (σ y₁) :=
        (WeierstrassCurve.Affine.baseChange_nonsingular x₁ y₁
          (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).injective).mpr h₁
      have h_gal_eq : EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h₁) =
          WeierstrassCurve.Affine.Point.some h₂ :=
        WeierstrassCurve.Affine.Point.map_some (W' := E)
          (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) h₁
      rw [h_gal_eq] at hP' hP'_m ⊢
      obtain ⟨hx₁, hy₁⟩ :=
        weierstrass_formal_group_torsion_trivial (AlgebraicClosure F) v W
          ha₁' ha₂' ha₃' ha₄' ha₆' m hm h₁ hP_m
      obtain ⟨hx₂, hy₂⟩ :=
        weierstrass_formal_group_torsion_trivial (AlgebraicClosure F) v W
          ha₁' ha₂' ha₃' ha₄' ha₆' m hm h₂ hP'_m
      have hxx : v (σ x₁ - x₁) < 1 :=
        inertia_sub_self_lt_one_of_valuation_le_one F v hv_gal hv_le hv_lt hv_minpoly x₁ hx₁ σ hσ
      have hyy : v (σ y₁ - y₁) < 1 :=
        inertia_sub_self_lt_one_of_valuation_le_one F v hv_gal hv_le hv_lt hv_minpoly y₁ hy₁ σ hσ
      by_contra h_ne
      have hQ_mem : (WeierstrassCurve.Affine.Point.some h₂ : W.Point) -
          WeierstrassCurve.Affine.Point.some h₁ ∈ EllipticRootNumber.torsion F E m :=
        AddSubgroup.sub_mem _ hP' hP
      rcases hQ_eq : (WeierstrassCurve.Affine.Point.some h₂ : W.Point) -
          WeierstrassCurve.Affine.Point.some h₁ with _ | @⟨x₃, y₃, h₃⟩
      · exact h_ne (sub_eq_zero.mp hQ_eq)
      · rw [hQ_eq] at hQ_mem
        have hQ_m : m • (WeierstrassCurve.Affine.Point.some h₃ : W.Point) = 0 :=
          (EllipticRootNumber.mem_torsion F E).mp hQ_mem
        obtain ⟨hx₃_le, _⟩ :=
          weierstrass_formal_group_torsion_trivial (AlgebraicClosure F) v W
            ha₁' ha₂' ha₃' ha₄' ha₆' m hm h₃ hQ_m
        have hx₃_gt : 1 < v x₃ :=
          weierstrass_sub_coord_gt_one_of_residue_eq (AlgebraicClosure F) v W
            ha₁' ha₂' ha₃' ha₄' ha₆' hΔ' h₂ h₁ h₃ hx₂ hy₂ hx₁ hy₁ hxx hyy hQ_eq
        exact not_lt_of_ge hx₃_le hx₃_gt
  have htate : EllipticRootNumber.tateRep F E σ = 1 := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext n
    apply Subtype.ext
    exact h_pts n (x.1 n).1 (x.1 n).2
  change LinearMap.baseChange (EllipticRootNumber.Ω F)
    (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F]
      (EllipticRootNumber.tateRep F E σ)) = 1
  rw [htate, Module.End.one_eq_id, LinearMap.baseChange_id, LinearMap.baseChange_id]
  rfl

theorem eps_eq_one_of_inertia_trivial (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (rec : EllipticRootNumber.LocalReciprocity F)
    (lc : EllipticRootNumber.LocalConstants F rec)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    [FiniteDimensional (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hρ : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → ρ w = 1) :
    lc.eps ⊥ ρ (EllipticRootNumber.stdChar F) = 1 :=
by
  open ValuativeRel in
  let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
  open ValuativeRel in
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
      z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
    rintro _ hz m rfl
    exact WithZero.unzero_coe hz
  have h_addVal_of_iso : ∀ (y : F) (m : ℤ),
      iso (ValuativeRel.valuation F y) = WithZero.exp m →
      y ≠ 0 ∧ EllipticRootNumber.addVal F y = -m := by
    intro y m hy_iso
    have h_exp_ne : WithZero.exp m ≠ 0 := WithZero.exp_ne_zero
    have h_iso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := by rw [hy_iso]; exact h_exp_ne
    have hv_ne : ValuativeRel.valuation F y ≠ 0 := fun h0 => h_iso_ne (by rw [h0, map_zero])
    have hy : y ≠ 0 := (Valuation.ne_zero_iff _).mp hv_ne
    refine ⟨hy, ?_⟩
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy, h_unzero _ _ m hy_iso]
    rfl
  obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ_val, iso.apply_symm_apply]
  obtain ⟨hπ0, hπ_addVal⟩ := h_addVal_of_iso π (-1) hπ_iso
  have hπ1 : ValuativeRel.valuation F π < 1 := by
    rw [← map_lt_map_iff iso, hπ_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have h_exp_inv : (WithZero.exp (-1 : ℤ))⁻¹ = WithZero.exp (1 : ℤ) := by
    apply inv_eq_of_mul_eq_one_right
    rw [← WithZero.exp_add]
    rfl
  have hπ_inv_iso : iso (ValuativeRel.valuation F π⁻¹) = WithZero.exp (1 : ℤ) := by
    rw [map_inv₀, map_inv₀, hπ_iso, h_exp_inv]
  have hπ_inv_addVal : EllipticRootNumber.addVal F π⁻¹ = -1 :=
    (h_addVal_of_iso π⁻¹ 1 hπ_inv_iso).2
  have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have h_norm : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [h_norm]
  have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · intro h0
      apply hπ0
      have := congrArg e_bot h0
      simpa using this
    · rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
      omega
    · rintro k ⟨hk, _⟩
      exact hk
  have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
  have h_valL_eq_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.relVal F ⊥ x := by
    intro x
    rw [h_valL, h_relVal]
  have h_addVal_nonneg : ∀ y : F,
      0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl, Valuation.map_zero]
      exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
    · unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set u := WithZero.unzero hiso_ne
      have hu_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_le_map_iff iso, hu_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
      omega
  letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℕ :=
    DivisibleBy.mk
      (fun a n =>
        if hn : n = 0 then 0
        else
          let h_ex := IsAlgClosed.exists_pow_nat_eq
            ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
            (Nat.pos_of_ne_zero hn)
          let z := Classical.choose h_ex
          have hz_pow : z ^ n = ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) :=
            Classical.choose_spec h_ex
          have hz_ne : z ≠ 0 := by
            intro hz0
            rw [hz0, zero_pow hn] at hz_pow
            exact Units.ne_zero (Additive.toMul a) hz_pow.symm
          Additive.ofMul (Units.mk0 z hz_ne))
      (fun a => dif_pos rfl)
      (fun {n} a hn => by
        dsimp only
        rw [dif_neg hn, ← ofMul_pow, ← ofMul_toMul a]
        congr 1
        apply Units.ext
        simp only [Units.val_pow_eq_pow_val, Units.val_mk0]
        exact Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq
          ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
          (Nat.pos_of_ne_zero hn)))
  letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℤ :=
    AddGroup.divisibleByIntOfDivisibleByNat (Additive (EllipticRootNumber.Ω F)ˣ)
  have hBaer : Module.Baer ℤ (Additive (EllipticRootNumber.Ω F)ˣ) :=
    Module.Baer.of_divisible (Additive (EllipticRootNumber.Ω F)ˣ)
  open ValuativeRel in
  have hp : (EllipticRootNumber.p F).Prime :=
    CharP.char_is_prime 𝓀[F] (EllipticRootNumber.p F)
  haveI : Fact (EllipticRootNumber.p F).Prime := ⟨hp⟩
  open ValuativeRel in
  haveI : Fact (ringChar 𝓀[F]).Prime := ⟨hp⟩
  obtain ⟨ζ, hζ_root⟩ := IsAlgClosed.exists_root
    (Polynomial.cyclotomic (EllipticRootNumber.p F) (EllipticRootNumber.Ω F))
    (ne_of_gt (Polynomial.degree_cyclotomic_pos (EllipticRootNumber.p F) (EllipticRootNumber.Ω F) hp.pos))
  have hζ : IsPrimitiveRoot ζ (EllipticRootNumber.p F) :=
    (Polynomial.isRoot_cyclotomic_iff_charZero hp.pos).mp hζ_root
  let ζ_u : (EllipticRootNumber.Ω F)ˣ := Units.mk0 ζ (hζ.ne_zero hp.ne_zero)
  let q₀ : Additive (EllipticRootNumber.Ω F)ˣ := Additive.ofMul ζ_u
  have hζ_ne_one : ζ ≠ 1 := hζ.ne_one hp.one_lt
  have hq₀_pow : (EllipticRootNumber.p F : ℤ) • q₀ = 0 := by
    rw [natCast_zsmul, ← ofMul_pow]
    change Additive.ofMul (ζ_u ^ EllipticRootNumber.p F) = Additive.ofMul 1
    congr 1
    ext
    simp [ζ_u, hζ.pow_eq_one]
  let g₀ : ZMod (EllipticRootNumber.p F) →+ Additive (EllipticRootNumber.Ω F)ˣ :=
    ZMod.lift (EllipticRootNumber.p F) ⟨zmultiplesHom _ q₀, by
      rw [zmultiplesHom_apply]
      exact hq₀_pow⟩
  have hg₀_one : g₀ 1 = q₀ := by
    rw [← Int.cast_one, ZMod.lift_coe, zmultiplesHom_apply, one_zsmul]
  open ValuativeRel in
  let f₀_char : ZMod (EllipticRootNumber.p F) →+ 𝓀[F] :=
    (ZMod.castHom dvd_rfl 𝓀[F]).toAddMonoidHom
  open ValuativeRel in
  have hf₀_inj : Function.Injective f₀_char :=
    RingHom.injective (ZMod.castHom dvd_rfl 𝓀[F])
  obtain ⟨ψ_res, hψ_res⟩ :=
    Module.Baer.extension_property_addMonoidHom hBaer f₀_char hf₀_inj g₀
  have hψ_res_one : ψ_res 1 = q₀ := by
    open ValuativeRel in
    have h1 : f₀_char 1 = 1 := map_one (ZMod.castHom dvd_rfl 𝓀[F])
    rw [← h1, ← AddMonoidHom.comp_apply, hψ_res, hg₀_one]
  let M₁ : AddSubgroup F :=
    (ValuativeRel.valuation F).valuationSubring.toSubring.toAddSubgroup.comap
      (AddMonoidHom.mulLeft π)
  open ValuativeRel in
  let r₁ : M₁ →+ 𝓀[F] :=
    { toFun := fun m => IsLocalRing.residue ↥𝒪[F] ⟨π * m.1, m.2⟩
      map_zero' := by
        have h0 : (⟨π * (0 : M₁).1, (0 : M₁).2⟩ : ↥𝒪[F]) = 0 := by
          ext
          exact mul_zero π
        change IsLocalRing.residue ↥𝒪[F] ⟨π * (0 : M₁).1, (0 : M₁).2⟩ = 0
        rw [h0, map_zero]
      map_add' := fun a b => by
        have h_add : (⟨π * (a + b).1, (a + b).2⟩ : ↥𝒪[F]) =
            ⟨π * a.1, a.2⟩ + ⟨π * b.1, b.2⟩ := by
          ext
          exact mul_add π a.1 b.1
        change IsLocalRing.residue ↥𝒪[F] ⟨π * (a + b).1, (a + b).2⟩ = _
        rw [h_add, map_add] }
  obtain ⟨ψ_tilde, hψ_tilde⟩ :=
    Module.Baer.extension_property_addMonoidHom hBaer M₁.subtype M₁.subtype_injective (ψ_res.comp r₁)
  let ψ_F : AddChar F (EllipticRootNumber.Ω F) :=
    { toFun := fun y => ((Additive.toMul (ψ_tilde y) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
      map_zero_eq_one' := by
        rw [map_zero, toMul_zero, Units.val_one]
      map_add_eq_mul' := fun a b => by
        rw [map_add, toMul_add, Units.val_mul] }
