    Module.Finite.equiv e_bot.toLinearEquiv.symm
  have h_eps_char_one : ∀ u : (EllipticRootNumber.Ω F)ˣ,
      lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ ((zpowersHom (EllipticRootNumber.Ω F)ˣ u).comp d))
        (EllipticRootNumber.stdChar F) = 1 := by
    intro u
    let χ_u := (zpowersHom (EllipticRootNumber.Ω F)ˣ u).comp d
    haveI : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) :=
      Module.Finite.equiv
        (ULift.moduleEquiv : ULift.{u} (EllipticRootNumber.Ω F) ≃ₗ[EllipticRootNumber.Ω F]
          EllipticRootNumber.Ω F).symm
    have hWχ : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ_u) := by
      refine ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ hw => ?_⟩
      have hd1 : d w = 1 := (h_deg_in w).mpr hw
      have hχ1 : χ_u w = 1 := by
        change zpowersHom (EllipticRootNumber.Ω F)ˣ u (d w) = 1
        rw [hd1, map_one]
      change (χ_u w : EllipticRootNumber.Ω F) • LinearMap.id = 1
      rw [hχ1, Units.val_one, one_smul]
      rfl
    let χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ :=
      { toFun := fun x =>
          u ^ (-EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))
        map_one' := by
          rw [Units.val_one, h_relVal_one, neg_zero, zpow_zero]
        map_mul' := fun x y => by
          rw [h_relVal_mul x y, neg_add, zpow_add] }
    have hχ'_rec : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        χ' x = χ_u (rec.recMap ⊥ x) := by
      intro x
      change u ^ (-EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) =
        zpowersHom (EllipticRootNumber.Ω F)ˣ u (d (rec.recMap ⊥ x))
      have hdeg := rec.degree_rec ⊥ x
      change d (rec.recMap ⊥ x) =
        Multiplicative.ofAdd (-EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) at hdeg
      rw [hdeg, zpowersHom_apply, toAdd_ofAdd]
    have h_cond_χ' : EllipticRootNumber.condExp F ⊥ χ' = 0 := by
      unfold EllipticRootNumber.condExp
      apply Nat.sInf_eq_zero.mpr
      left
      intro v hv
      exact Subgroup.closure_induction
        (fun w hw => by
          simp only [Set.mem_setOf_eq, ↓reduceIte, h_valL_eq_relVal] at hw
          change u ^ (-EllipticRootNumber.relVal F ⊥ (w : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1
          rw [hw, neg_zero, zpow_zero])
        (map_one χ')
        (fun w₁ w₂ _ _ hw₁ hw₂ => by rw [map_mul, hw₁, hw₂, mul_one])
        (fun w _ hw => by rw [map_inv, hw, inv_one])
        hv
    have h_exists_c : ∃ c : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) =
          (EllipticRootNumber.condExp F ⊥ χ' : ℤ) +
            EllipticRootNumber.condExpChar F ⊥ (EllipticRootNumber.stdChar F) := by
      refine ⟨1, ?_⟩
      rw [Units.val_one, h_valL_eq_relVal, h_relVal_one, h_cond_χ', hψ_cond]
      rfl
    have hc_spec : EllipticRootNumber.valL F ⊥
        (EllipticRootNumber.tateElt F ⊥ χ' (EllipticRootNumber.stdChar F) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) =
        (EllipticRootNumber.condExp F ⊥ χ' : ℤ) +
          EllipticRootNumber.condExpChar F ⊥ (EllipticRootNumber.stdChar F) :=
      Classical.epsilon_spec h_exists_c
    rw [h_valL_eq_relVal, h_cond_χ', hψ_cond, Nat.cast_zero, add_zero] at hc_spec
    have hχ'_c : χ' (EllipticRootNumber.tateElt F ⊥ χ' (EllipticRootNumber.stdChar F)) = 1 := by
      change u ^ (-EllipticRootNumber.relVal F ⊥
        (EllipticRootNumber.tateElt F ⊥ χ' (EllipticRootNumber.stdChar F) :
          (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1
      rw [hc_spec, neg_zero, zpow_zero]
    have h_tate : EllipticRootNumber.tateEps F ⊥ χ' (EllipticRootNumber.stdChar F) = 1 := by
      unfold EllipticRootNumber.tateEps
      rw [hψ_cond, if_pos h_cond_χ', zpow_zero, one_mul, hχ'_c, Units.val_one]
    have h_eps_val := lc.eps_char ⊥ (EllipticRootNumber.stdChar F) hψ_adm χ_u hWχ χ' hχ'_rec
    rw [h_tate] at h_eps_val
    exact Units.ext h_eps_val
  
  have hu₀_ne : e_bot.symm π⁻¹ ≠ 0 := by
    intro h0
    apply inv_ne_zero hπ0
    have := congrArg e_bot h0
    simpa using this
  let u₀ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ := Units.mk0 (e_bot.symm π⁻¹) hu₀_ne
  have h_relVal_u₀ : EllipticRootNumber.relVal F ⊥
      (u₀ : (⊥ : IntermediateField F (AlgebraicClosure F))) = -1 := by
    change EllipticRootNumber.relVal F ⊥ (e_bot.symm π⁻¹) = -1
    rw [h_relVal, e_bot.apply_symm_apply, hπ_inv_addVal]
  let w₁ : EllipticRootNumber.relWeil F ⊥ := rec.recMap ⊥ u₀
  have hd_w₁ : d w₁ = Multiplicative.ofAdd 1 := by
    have hdeg := rec.degree_rec ⊥ u₀
    change d w₁ =
      Multiplicative.ofAdd (-EllipticRootNumber.relVal F ⊥ (u₀ : (⊥ : IntermediateField F (AlgebraicClosure F)))) at hdeg
    rw [h_relVal_u₀, neg_neg] at hdeg
    exact hdeg
  have h_weil_of_in : ∀ {M : Type u} [AddCommGroup M] [Module (EllipticRootNumber.Ω F) M]
      [FiniteDimensional (EllipticRootNumber.Ω F) M]
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) M),
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σ w = 1) →
      EllipticRootNumber.IsWeilRep F ⊥ σ := by
    intro M _ _ _ σ hσ
    exact ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ hw => hσ w hw⟩
  have h_ind : ∀ (n : ℕ) {W_sp : Type u} [AddCommGroup W_sp] [Module (EllipticRootNumber.Ω F) W_sp]
      [FiniteDimensional (EllipticRootNumber.Ω F) W_sp]
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) W_sp),
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σ w = 1) →
      Module.finrank (EllipticRootNumber.Ω F) W_sp = n →
      lc.eps ⊥ σ (EllipticRootNumber.stdChar F) = 1 := by
    intro n
    induction n with
    | zero =>
      intro W_sp _ _ _ σ hσ hrank
      haveI : Subsingleton W_sp := Module.finrank_zero_iff.mp hrank
      have hWσ : EllipticRootNumber.IsWeilRep F ⊥ σ := h_weil_of_in σ hσ
      have h_ex := lc.eps_exact ⊥ (EllipticRootNumber.stdChar F) hψ_adm σ σ σ hWσ hWσ hWσ 0 0
        (fun _ => Subsingleton.elim _ _)
        (fun _ => Subsingleton.elim _ _)
        (fun _ _ _ => Subsingleton.elim _ _)
        (fun y => ⟨0, Subsingleton.elim _ _⟩)
        (Subsingleton.elim _ _)
      calc lc.eps ⊥ σ (EllipticRootNumber.stdChar F)
        _ = (lc.eps ⊥ σ (EllipticRootNumber.stdChar F))⁻¹ *
              (lc.eps ⊥ σ (EllipticRootNumber.stdChar F) *
                lc.eps ⊥ σ (EllipticRootNumber.stdChar F)) := by group
        _ = (lc.eps ⊥ σ (EllipticRootNumber.stdChar F))⁻¹ *
              lc.eps ⊥ σ (EllipticRootNumber.stdChar F) := by rw [← h_ex]
        _ = 1 := inv_mul_cancel _
    | succ n ih =>
      intro W_sp _ _ _ σ hσ hrank
      have hW_pos : 0 < Module.finrank (EllipticRootNumber.Ω F) W_sp := by omega
      haveI : Nontrivial W_sp := Module.nontrivial_of_finrank_pos hW_pos
      obtain ⟨μ, hμ_eig⟩ := Module.End.exists_eigenvalue (σ w₁)
      obtain ⟨v₀, hv₀⟩ := hμ_eig.exists_hasEigenvector
      have hv₀_eq : σ w₁ v₀ = μ • v₀ := hv₀.apply_eq_smul
      have hv₀_ne : v₀ ≠ 0 := hv₀.2
      have hμ_ne : μ ≠ 0 := by
        intro h0
        apply hv₀_ne
        have h1 : σ w₁ v₀ = 0 := by rw [hv₀_eq, h0, zero_smul]
        calc v₀ = (σ (w₁⁻¹ * w₁)) v₀ := by rw [inv_mul_cancel, map_one, Module.End.one_apply]
          _ = σ w₁⁻¹ (σ w₁ v₀) := by rw [map_mul, Module.End.mul_apply]
          _ = 0 := by rw [h1, map_zero]
      let u : (EllipticRootNumber.Ω F)ˣ := Units.mk0 μ hμ_ne
      have h_pow_nat : ∀ k : ℕ, σ (w₁ ^ k) v₀ = ((u ^ k : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v₀ := by
        intro k
        induction k with
        | zero => simp
        | succ k ihk =>
          rw [pow_succ', map_mul, Module.End.mul_apply, ihk, map_smul, hv₀_eq, smul_smul,
            pow_succ', Units.val_mul]
          change (↑(u ^ k) * (u : EllipticRootNumber.Ω F)) • v₀ =
            ((u : EllipticRootNumber.Ω F) * ↑(u ^ k)) • v₀
          rw [mul_comm]
      have h_pow_int : ∀ m : ℤ, σ (w₁ ^ m) v₀ = ((u ^ m : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v₀ := by
        intro m
        cases m with
        | ofNat k => exact h_pow_nat k
        | negSucc k =>
          change σ ((w₁ ^ (k + 1))⁻¹) v₀ =
            (((u ^ (k + 1))⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v₀
          have h1 : σ (w₁ ^ (k + 1))
              ((((u ^ (k + 1))⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v₀) = v₀ := by
            rw [map_smul, h_pow_nat (k + 1), smul_smul, ← Units.val_mul, inv_mul_cancel,
              Units.val_one, one_smul]
          calc σ ((w₁ ^ (k + 1))⁻¹) v₀
            _ = σ ((w₁ ^ (k + 1))⁻¹) (σ (w₁ ^ (k + 1))
                  ((((u ^ (k + 1))⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v₀)) := by
                rw [h1]
            _ = (σ ((w₁ ^ (k + 1))⁻¹ * w₁ ^ (k + 1)))
                  ((((u ^ (k + 1))⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v₀) := by
                rw [map_mul, Module.End.mul_apply]
            _ = (((u ^ (k + 1))⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v₀ := by
                rw [inv_mul_cancel, map_one, Module.End.one_apply]
      let χ_u := (zpowersHom (EllipticRootNumber.Ω F)ˣ u).comp d
      have hσ_v₀ : ∀ w : EllipticRootNumber.relWeil F ⊥,
          σ w v₀ = (χ_u w : EllipticRootNumber.Ω F) • v₀ := by
        intro w
        set m := Multiplicative.toAdd (d w)
        have h_in_m : ((w₁ ^ (-m) * w : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
            EllipticRootNumber.inertia F := by
          rw [← h_deg_in]
          rw [map_mul, map_zpow, hd_w₁, ← ofAdd_zsmul, smul_eq_mul, mul_one,
            ofAdd_neg, ofAdd_toAdd, inv_mul_cancel]
        have hσ_m : σ (w₁ ^ (-m) * w) = 1 := hσ _ h_in_m
        have hw_decomp : w = w₁ ^ m * (w₁ ^ (-m) * w) := by group
        calc σ w v₀
          _ = σ (w₁ ^ m * (w₁ ^ (-m) * w)) v₀ := by rw [← hw_decomp]
          _ = σ (w₁ ^ m) (σ (w₁ ^ (-m) * w) v₀) := by rw [map_mul, Module.End.mul_apply]
          _ = σ (w₁ ^ m) v₀ := by rw [hσ_m, Module.End.one_apply]
          _ = (χ_u w : EllipticRootNumber.Ω F) • v₀ := h_pow_int m
      let f : ULift.{u} (EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F] W_sp :=
        { toFun := fun c => c.down • v₀
          map_add' := fun a b => add_smul a.down b.down v₀
          map_smul' := fun r a => mul_smul r a.down v₀ }
      have hf_inj : Function.Injective f := by
        intro a b hab
        ext
        have h_sub : (a.down - b.down) • v₀ = 0 := by
          rw [sub_smul]
          exact sub_eq_zero.mpr hab
        rcases smul_eq_zero.mp h_sub with h0 | h0
        · exact sub_eq_zero.mp h0
        · exact False.elim (hv₀_ne h0)
      have hf_eq : ∀ w : EllipticRootNumber.relWeil F ⊥,
          f ∘ₗ EllipticRootNumber.charRep F ⊥ χ_u w = σ w ∘ₗ f := by
        intro w
        ext ⟨c⟩
        change ((χ_u w : EllipticRootNumber.Ω F) * c) • v₀ = σ w (c • v₀)
        rw [map_smul, hσ_v₀ w, smul_smul, mul_comm]
      let W : Submodule (EllipticRootNumber.Ω F) W_sp := LinearMap.range f
      let g : W_sp →ₗ[EllipticRootNumber.Ω F] (W_sp ⧸ W) := W.mkQ
      have hg_surj : Function.Surjective g := Submodule.mkQ_surjective W
      have hfg_exact : LinearMap.range f = LinearMap.ker g := (Submodule.ker_mkQ W).symm
      have hW_inv : ∀ w : EllipticRootNumber.relWeil F ⊥, W ≤ W.comap (σ w) := by
        rintro w _ ⟨c, rfl⟩
        change σ w (f c) ∈ LinearMap.range f
        have h1 : σ w (f c) = f (EllipticRootNumber.charRep F ⊥ χ_u w c) := by
          simpa using (LinearMap.ext_iff.mp (hf_eq w) c).symm
        rw [h1]
        exact ⟨_, rfl⟩
      let σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (W_sp ⧸ W) :=
        { toFun := fun w => Submodule.mapQ W W (σ w) (hW_inv w)
          map_one' := by
            ext x
            simp [hσ 1 (Subgroup.one_mem _)]
          map_mul' := fun w_a w_b => by
            ext x
            simp }
      have hg_eq : ∀ w : EllipticRootNumber.relWeil F ⊥, g ∘ₗ σ w = σ₂ w ∘ₗ g := by
        intro w
        ext y
        rfl
      have hσ₂_in : ∀ w : EllipticRootNumber.relWeil F ⊥,
          (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σ₂ w = 1 := by
        intro w hw
        ext x
        change Submodule.Quotient.mk (σ w x) = Submodule.Quotient.mk x
        rw [hσ w hw, Module.End.one_apply]
      have hW_finrank : Module.finrank (EllipticRootNumber.Ω F) W = 1 := by
        change Module.finrank (EllipticRootNumber.Ω F) (LinearMap.range f) = 1
        rw [LinearMap.finrank_range_of_inj hf_inj,
          (ULift.moduleEquiv : ULift.{u} (EllipticRootNumber.Ω F) ≃ₗ[EllipticRootNumber.Ω F]
            EllipticRootNumber.Ω F).finrank_eq,
          Module.finrank_self]
      have hQ_finrank : Module.finrank (EllipticRootNumber.Ω F) (W_sp ⧸ W) = n := by
        have h_sum := Submodule.finrank_quotient_add_finrank W
        rw [hW_finrank, hrank] at h_sum
        omega
      haveI : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) :=
        Module.Finite.equiv
          (ULift.moduleEquiv : ULift.{u} (EllipticRootNumber.Ω F) ≃ₗ[EllipticRootNumber.Ω F]
            EllipticRootNumber.Ω F).symm
      have hW₁ : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ_u) := by
        refine h_weil_of_in _ (fun w hw => ?_)
        have hd1 : d w = 1 := (h_deg_in w).mpr hw
        have hχ1 : χ_u w = 1 := by
          change zpowersHom (EllipticRootNumber.Ω F)ˣ u (d w) = 1
          rw [hd1, map_one]
        change (χ_u w : EllipticRootNumber.Ω F) • LinearMap.id = 1
        rw [hχ1, Units.val_one, one_smul]
        rfl
      have hWσ : EllipticRootNumber.IsWeilRep F ⊥ σ := h_weil_of_in σ hσ
      have hW₂ : EllipticRootNumber.IsWeilRep F ⊥ σ₂ := h_weil_of_in σ₂ hσ₂_in
      rw [lc.eps_exact ⊥ (EllipticRootNumber.stdChar F) hψ_adm
            (EllipticRootNumber.charRep F ⊥ χ_u) σ σ₂ hW₁ hWσ hW₂
            f g hf_eq hg_eq hf_inj hg_surj hfg_exact,
          h_eps_char_one u, ih σ₂ hσ₂_in hQ_finrank, mul_one]
  exact h_ind (Module.finrank (EllipticRootNumber.Ω F) V) ρ hρ rfl

theorem localEps_good_reduction (K : Type u) [Field K] [NumberField K]
    (E : WeierstrassCurve K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (ha₁ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₁ ≤ 1)
    (ha₂ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₂ ≤ 1)
    (ha₃ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₃ ≤ 1)
    (ha₄ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₄ ≤ 1)
    (ha₆ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₆ ≤ 1)
    (hΔ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.Δ = 1)
    [ValuativeRel (v.adicCompletion K)] [TopologicalSpace (v.adicCompletion K)]
    [IsNonarchimedeanLocalField (v.adicCompletion K)]
    (rec : EllipticRootNumber.LocalReciprocity (v.adicCompletion K))
    (lc : EllipticRootNumber.LocalConstants (v.adicCompletion K) rec) :
    EllipticRootNumber.localEps (v.adicCompletion K) (E.baseChange (v.adicCompletion K)) lc = 1 :=
by
  have h_local : ∀ (F' : Type u) [Field F'] [ValuativeRel F'] [TopologicalSpace F']
      [IsNonarchimedeanLocalField F'] (E' : WeierstrassCurve F')
      (rec' : EllipticRootNumber.LocalReciprocity F')
      (lc' : EllipticRootNumber.LocalConstants F' rec'),
      ValuativeRel.valuation F' E'.a₁ ≤ 1 →
      ValuativeRel.valuation F' E'.a₂ ≤ 1 →
      ValuativeRel.valuation F' E'.a₃ ≤ 1 →
      ValuativeRel.valuation F' E'.a₄ ≤ 1 →
      ValuativeRel.valuation F' E'.a₆ ≤ 1 →
      ValuativeRel.valuation F' E'.Δ = 1 →
      EllipticRootNumber.localEps F' E' lc' = 1 := by
    intro F' _ _ _ _ E' rec' lc' ha₁' ha₂' ha₃' ha₄' ha₆' hΔ'
    have hc₄ : ValuativeRel.valuation F' (E'.c₄ ^ 3) ≤ 1 := by
      rw [← Valuation.mem_valuationSubring_iff] at ha₁' ha₂' ha₃' ha₄' ⊢
      have hb₂ : E'.b₂ ∈ (ValuativeRel.valuation F').valuationSubring := by
        unfold WeierstrassCurve.b₂
        exact Subring.add_mem _ (Subring.pow_mem _ ha₁' 2)
          (Subring.mul_mem _ (natCast_mem _ 4) ha₂')
      have hb₄ : E'.b₄ ∈ (ValuativeRel.valuation F').valuationSubring := by
        unfold WeierstrassCurve.b₄
        exact Subring.add_mem _ (Subring.mul_mem _ (natCast_mem _ 2) ha₄')
          (Subring.mul_mem _ ha₁' ha₃')
      have hc₄_mem : E'.c₄ ∈ (ValuativeRel.valuation F').valuationSubring := by
        unfold WeierstrassCurve.c₄
        exact Subring.sub_mem _ (Subring.pow_mem _ hb₂ 2)
          (Subring.mul_mem _ (natCast_mem _ 24) hb₄)
      exact Subring.pow_mem _ hc₄_mem 3
    have h_pg : EllipticRootNumber.IsPotentiallyGood F' E' := by
      unfold EllipticRootNumber.IsPotentiallyGood
      rw [map_div₀, hΔ', div_one]
      exact hc₄
    have h_frob_zero : ∀ (σ' : EllipticRootNumber.WDRep F' ⊥), σ'.N = 0 →
        EllipticRootNumber.frobDet F' ⊥ σ' = 1 := by
      intro σ' hN
      unfold EllipticRootNumber.frobDet
      dsimp only
      split_ifs with hI hK
      · have hK_top : (LinearMap.ker σ'.N).comap
            (EllipticRootNumber.inertiaInvariants F' ⊥ σ').subtype = ⊤ := by
          rw [hN, LinearMap.ker_zero, Submodule.comap_top]
        haveI : Subsingleton (EllipticRootNumber.inertiaInvariants F' ⊥ σ' ⧸
            (LinearMap.ker σ'.N).comap (EllipticRootNumber.inertiaInvariants F' ⊥ σ').subtype) :=
          Submodule.Quotient.subsingleton_iff.mpr hK_top
        exact LinearMap.det_eq_one_of_subsingleton _
      · rfl
      · rfl
    haveI : FiniteDimensional (EllipticRootNumber.Ω F') (EllipticRootNumber.VBar F' E') :=
      vBar_finiteDimensional F' E' hΔ'
    have h_in : ∀ w : EllipticRootNumber.relWeil F' ⊥,
        (w : EllipticRootNumber.AbsGal F') ∈ EllipticRootNumber.inertia F' →
        ((EllipticRootNumber.ellAdicRep F' E').comp (EllipticRootNumber.relWeil F' ⊥).subtype) w = 1 := by
      intro w hw
      exact ellAdicRep_inertia_trivial_of_good_reduction F' E' ha₁' ha₂' ha₃' ha₄' ha₆' hΔ'
        (w : EllipticRootNumber.AbsGal F') hw
    have h_eps : lc'.eps ⊥
        ((EllipticRootNumber.ellAdicRep F' E').comp (EllipticRootNumber.relWeil F' ⊥).subtype)
        (EllipticRootNumber.stdChar F') = 1 :=
      eps_eq_one_of_inertia_trivial F' rec' lc' _ h_in
    unfold EllipticRootNumber.localEps EllipticRootNumber.epsWD EllipticRootNumber.wdRep
    rw [if_pos h_pg, h_frob_zero _ rfl, mul_one]
    dsimp only
    rw [h_eps, Units.val_one]
  have h_transfer : ∀ x : K, IsDedekindDomain.HeightOneSpectrum.valuation K v x ≤ 1 →
      ValuativeRel.valuation (v.adicCompletion K) (algebraMap K (v.adicCompletion K) x) ≤ 1 := by
    intro x hx
    apply adicCompletion_valuation_le_one_of_valued_le_one K v
    change Valued.v (x : v.adicCompletion K) ≤ 1
    rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x]
    exact hx
  apply h_local (v.adicCompletion K) (E.baseChange (v.adicCompletion K)) rec lc
  · change ValuativeRel.valuation (v.adicCompletion K) (E.map (algebraMap K (v.adicCompletion K))).a₁ ≤ 1
    rw [WeierstrassCurve.map_a₁]
    exact h_transfer E.a₁ ha₁
  · change ValuativeRel.valuation (v.adicCompletion K) (E.map (algebraMap K (v.adicCompletion K))).a₂ ≤ 1
    rw [WeierstrassCurve.map_a₂]
    exact h_transfer E.a₂ ha₂
  · change ValuativeRel.valuation (v.adicCompletion K) (E.map (algebraMap K (v.adicCompletion K))).a₃ ≤ 1
    rw [WeierstrassCurve.map_a₃]
    exact h_transfer E.a₃ ha₃
  · change ValuativeRel.valuation (v.adicCompletion K) (E.map (algebraMap K (v.adicCompletion K))).a₄ ≤ 1
    rw [WeierstrassCurve.map_a₄]
    exact h_transfer E.a₄ ha₄
  · change ValuativeRel.valuation (v.adicCompletion K) (E.map (algebraMap K (v.adicCompletion K))).a₆ ≤ 1
    rw [WeierstrassCurve.map_a₆]
    exact h_transfer E.a₆ ha₆
  · change ValuativeRel.valuation (v.adicCompletion K) (E.map (algebraMap K (v.adicCompletion K))).Δ = 1
    rw [WeierstrassCurve.map_Δ]
    have h1 : ValuativeRel.valuation (v.adicCompletion K)
        (algebraMap K (v.adicCompletion K) E.Δ) ≤ 1 := h_transfer E.Δ (le_of_eq hΔ)
    have h2 : ValuativeRel.valuation (v.adicCompletion K)
        (algebraMap K (v.adicCompletion K) E.Δ⁻¹) ≤ 1 := by
      apply h_transfer
      rw [map_inv₀, hΔ, inv_one]
    have hΔ_ne : E.Δ ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hΔ
      exact zero_ne_one hΔ
    apply le_antisymm h1
    calc (1 : ValuativeRel.ValueGroupWithZero (v.adicCompletion K))
      _ = ValuativeRel.valuation (v.adicCompletion K)
            (algebraMap K (v.adicCompletion K) (E.Δ * E.Δ⁻¹)) := by
          rw [mul_inv_cancel₀ hΔ_ne, map_one, Valuation.map_one]
      _ = ValuativeRel.valuation (v.adicCompletion K) (algebraMap K (v.adicCompletion K) E.Δ) *
            ValuativeRel.valuation (v.adicCompletion K) (algebraMap K (v.adicCompletion K) E.Δ⁻¹) := by
          rw [map_mul, Valuation.map_mul]
      _ ≤ ValuativeRel.valuation (v.adicCompletion K) (algebraMap K (v.adicCompletion K) E.Δ) * 1 :=
          mul_le_mul' le_rfl h2
      _ = ValuativeRel.valuation (v.adicCompletion K) (algebraMap K (v.adicCompletion K) E.Δ) :=
          mul_one _

theorem adicCompletion_valuation_and_q_eq (K : Type u) [Field K] [NumberField K]
    (E : WeierstrassCurve K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (n : ℕ)
    (ha₁ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₁ ≤ 1)
    (ha₂ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₂ ≤ 1)
    (ha₃ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₃ ≤ 1)
    (ha₄ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₄ ≤ 1)
    (ha₆ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.a₆ ≤ 1)
    (hΔ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.Δ = WithZero.exp (-(n : ℤ)))
    (hc₄ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.c₄ < 1)
    (hj : IsDedekindDomain.HeightOneSpectrum.valuation K v (E.c₄ ^ 3 / E.Δ) ≤ 1)
    [ValuativeRel (v.adicCompletion K)] [TopologicalSpace (v.adicCompletion K)]
    [IsNonarchimedeanLocalField (v.adicCompletion K)] :
    EllipticRootNumber.q (v.adicCompletion K) = Ideal.absNorm v.asIdeal ∧
    ValuativeRel.valuation (v.adicCompletion K) (E.baseChange (v.adicCompletion K)).a₁ ≤ 1 ∧
    ValuativeRel.valuation (v.adicCompletion K) (E.baseChange (v.adicCompletion K)).a₂ ≤ 1 ∧
    ValuativeRel.valuation (v.adicCompletion K) (E.baseChange (v.adicCompletion K)).a₃ ≤ 1 ∧
    ValuativeRel.valuation (v.adicCompletion K) (E.baseChange (v.adicCompletion K)).a₄ ≤ 1 ∧
    ValuativeRel.valuation (v.adicCompletion K) (E.baseChange (v.adicCompletion K)).a₆ ≤ 1 ∧
    ValuativeRel.valuation (v.adicCompletion K) (E.baseChange (v.adicCompletion K)).c₄ < 1 ∧
    EllipticRootNumber.IsPotentiallyGood (v.adicCompletion K) (E.baseChange (v.adicCompletion K)) ∧
    EllipticRootNumber.addVal (v.adicCompletion K) (E.baseChange (v.adicCompletion K)).Δ = (n : ℤ) :=
by
  have probe_s2 : ∀ (K : Type u) [Field K] [NumberField K]
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      [ValuativeRel (v.adicCompletion K)] [TopologicalSpace (v.adicCompletion K)]
      [IsNonarchimedeanLocalField (v.adicCompletion K)]
      (h_le : ∀ z : v.adicCompletion K, Valued.v z ≤ 1 →
        ValuativeRel.valuation (v.adicCompletion K) z ≤ 1)
      (x : v.adicCompletion K),
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt (v.adicCompletion K)
        (ValuativeRel.valuation (v.adicCompletion K) x) = Valued.v x := by
    clear! K
    intro K _ _ v _ _ _ h_le x
    let F := v.adicCompletion K
    let e := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    let v₁ : Valuation F (WithZero (Multiplicative ℤ)) := Valued.v
    let v₂ : F →*₀ WithZero (Multiplicative ℤ) :=
      e.toMonoidWithZeroHom.comp (ValuativeRel.valuation F).toMonoidWithZeroHom
    have hv₂_le_one : ∀ z : F, v₁ z ≤ 1 → v₂ z ≤ 1 := by
      intro z hz
      change e (ValuativeRel.valuation F z) ≤ 1
      rw [← map_one e, OrderIsoClass.map_le_map_iff]
      exact h_le z hz
    have hv₂_eq_one : ∀ u : F, v₁ u = 1 → v₂ u = 1 := by
      intro u hu
      have hu_ne : u ≠ 0 := by
        rintro rfl
        rw [map_zero] at hu
        exact zero_ne_one hu
      have h1 : v₂ u ≤ 1 := hv₂_le_one u (le_of_eq hu)
      have h2 : v₂ u⁻¹ ≤ 1 := hv₂_le_one u⁻¹ (by rw [map_inv₀, hu, inv_one])
      rw [map_inv₀] at h2
      have hv₂_ne : v₂ u ≠ 0 := by
        change e (ValuativeRel.valuation F u) ≠ 0
        rw [map_ne_zero, Valuation.ne_zero_iff]
        exact hu_ne
      have h3 : 1 ≤ v₂ u := by
        have := mul_le_mul_right h2 (v₂ u)
        rwa [mul_inv_cancel₀ hv₂_ne, mul_one] at this
      exact le_antisymm h1 h3
    obtain ⟨π₀, hπ₀⟩ := v.valuation_exists_uniformizer K
    let π : F := (π₀ : F)
    have hπ₁ : v₁ π = WithZero.exp (-1 : ℤ) := by
      change Valued.v (π₀ : F) = _
      rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation', hπ₀]
    have hπ_ne : π ≠ 0 := by
      intro hπ0
      rw [hπ0, map_zero] at hπ₁
      exact WithZero.exp_ne_zero hπ₁.symm
    have hv₂_π_ne : v₂ π ≠ 0 := by
      change e (ValuativeRel.valuation F π) ≠ 0
      rw [map_ne_zero, Valuation.ne_zero_iff]
      exact hπ_ne
    rcases hv₂π : v₂ π with _ | a
    · exact absurd hv₂π hv₂_π_ne
    · change v₂ π = WithZero.exp (Multiplicative.toAdd a) at hv₂π
      have ha_le : Multiplicative.toAdd a ≤ 0 := by
        have hle : v₂ π ≤ 1 := hv₂_le_one π (by rw [hπ₁]; exact WithZero.exp_le_exp.mpr (by omega))
        rw [hv₂π, ← WithZero.exp_zero, WithZero.exp_le_exp] at hle
        exact hle
      obtain ⟨γ, hγ⟩ := e.toEquiv.surjective (WithZero.exp (-1 : ℤ))
      obtain ⟨ϖ, hϖ⟩ := ValuativeRel.valuation_surjective (K := F) γ
      have hv₂ϖ : v₂ ϖ = WithZero.exp (-1 : ℤ) := by
        change e (ValuativeRel.valuation F ϖ) = _
        rw [hϖ]
        exact hγ
      have hϖ_ne : ϖ ≠ 0 := by
        rintro rfl
        rw [map_zero] at hv₂ϖ
        exact WithZero.exp_ne_zero hv₂ϖ.symm
      have hv₁ϖ_ne : v₁ ϖ ≠ 0 := (Valuation.ne_zero_iff v₁).mpr hϖ_ne
      rcases hv₁ϖ : v₁ ϖ with _ | b
      · exact absurd hv₁ϖ hv₁ϖ_ne
      · change v₁ ϖ = WithZero.exp (Multiplicative.toAdd b) at hv₁ϖ
        let k := Multiplicative.toAdd b
        have hu₁ : v₁ (ϖ * π ^ k) = 1 := by
          rw [map_mul, map_zpow₀, hv₁ϖ, hπ₁, ← WithZero.exp_zsmul, ← WithZero.exp_add]
          have : k + k • (-1 : ℤ) = 0 := by simp
          rw [this, WithZero.exp_zero]
        have hu₂ := hv₂_eq_one (ϖ * π ^ k) hu₁
        rw [map_mul, map_zpow₀, hv₂ϖ, hv₂π, ← WithZero.exp_zsmul, ← WithZero.exp_add, ← WithZero.exp_zero] at hu₂
        have hka : -1 + k • Multiplicative.toAdd a = 0 := WithZero.exp_injective hu₂
        simp only [zsmul_eq_mul] at hka
        have h_unit : IsUnit (Multiplicative.toAdd a) :=
          isUnit_of_dvd_one ⟨k, by linear_combination -hka⟩
        have ha_eq : Multiplicative.toAdd a = -1 := by
          rcases Int.isUnit_iff.mp h_unit with h1 | h1 <;> omega
        have hπ₂ : v₂ π = WithZero.exp (-1 : ℤ) := by rw [hv₂π, ha_eq]
        by_cases hx : x = 0
        · subst hx
          change e (ValuativeRel.valuation F 0) = v₁ 0
          rw [map_zero, map_zero, map_zero]
        · have hv₁x_ne : v₁ x ≠ 0 := (Valuation.ne_zero_iff v₁).mpr hx
          obtain ⟨c, hc⟩ := Option.ne_none_iff_exists'.mp hv₁x_ne
          have hv₁x : v₁ x = WithZero.exp (Multiplicative.toAdd c) := hc
          let m := Multiplicative.toAdd c
          have hux₁ : v₁ (x * π ^ m) = 1 := by
            rw [map_mul, map_zpow₀, hv₁x, hπ₁, ← WithZero.exp_zsmul, ← WithZero.exp_add]
            have : m + m • (-1 : ℤ) = 0 := by simp
            rw [this, WithZero.exp_zero]
          have hux₂ := hv₂_eq_one (x * π ^ m) hux₁
          have hx₂ : v₂ x = (v₂ (π ^ m))⁻¹ := by
            rw [map_mul] at hux₂
            exact eq_inv_of_mul_eq_one_left hux₂
          rw [map_zpow₀, hπ₂, ← WithZero.exp_zsmul, ← WithZero.exp_neg] at hx₂
          have : -(m • (-1 : ℤ)) = m := by simp
          rw [this, ← hv₁x] at hx₂
          exact hx₂
  have probe_s3 : ∀ (K : Type u) [Field K] [NumberField K]
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      Nat.card (IsLocalRing.ResidueField ↥(v.adicCompletionIntegers K)) = Ideal.absNorm v.asIdeal := by
    clear! K
    intro K _ _ v
    let R := NumberField.RingOfIntegers K
    let F := v.adicCompletion K
    let O_v := v.adicCompletionIntegers K
    let φ : R →+* IsLocalRing.ResidueField ↥O_v :=
      (IsLocalRing.residue ↥O_v).comp (algebraMap R ↥O_v)
    have h_ker : ∀ r ∈ v.asIdeal, φ r = 0 := by
      intro r hr
      change IsLocalRing.residue ↥O_v (algebraMap R ↥O_v r) = 0
      rw [IsLocalRing.residue_eq_zero_iff]
      refine (Valuation.mem_maximalIdeal_iff _ _).mpr ?_
      change Valued.v ((algebraMap R K r : F)) < 1
      rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation',
        IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
      exact (v.intValuation_lt_one_iff_mem r).mpr hr
    let φ_bar : R ⧸ v.asIdeal →+* IsLocalRing.ResidueField ↥O_v :=
      Ideal.Quotient.lift v.asIdeal φ h_ker
    haveI : v.asIdeal.IsMaximal := v.isPrime.isMaximal v.ne_bot
    letI : Field (R ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    have hinj : Function.Injective φ_bar := φ_bar.injective
    have hsurj : Function.Surjective φ_bar := by
      intro y_bar
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y_bar
      have h_nhds : {z : F | Valued.v (z - (x : F)) < ((1 : (WithZero (Multiplicative ℤ))ˣ) : WithZero (Multiplicative ℤ))} ∈ nhds (x : F) :=
        Valued.mem_nhds.mpr ⟨1, fun z hz => hz⟩
      obtain ⟨k₀, hk⟩ := UniformSpace.Completion.denseRange_coe.mem_nhds h_nhds
      let k : K := k₀
      change Valued.v ((k : F) - (x : F)) < 1 at hk
      have hk_val : v.valuation K k ≤ 1 := by
        rw [← IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
        have h_eq : (k : F) = ((k : F) - (x : F)) + (x : F) := by ring
        rw [h_eq]
        exact le_trans (Valuation.map_add _ _ _) (max_le (le_of_lt hk) x.2)
      have h_mem0 : (0 : Fin 2) ∈ (Finset.univ : Finset (Fin 2)) := Finset.mem_univ 0
      have h_ne0 : (![1, k] : Fin 2 → K) 0 ≠ 0 := by simp
      obtain ⟨a, ha_int, ha_notMem⟩ :=
        Ideal.exist_integer_multiples_notMem (J := v.asIdeal) v.isMaximal.ne_top
          (Finset.univ : Finset (Fin 2)) (![1, k] : Fin 2 → K) h_mem0 h_ne0
      obtain ⟨b, hb⟩ := ha_int 0 (Finset.mem_univ 0)
      obtain ⟨c, hc⟩ := ha_int 1 (Finset.mem_univ 1)
      have hb' : algebraMap R K b = a := by simpa using hb
      have hc' : algebraMap R K c = a * k := by simpa using hc
      have hbc : algebraMap R K c = algebraMap R K b * k := by rw [hc', hb']
      have hb_notMem : b ∉ v.asIdeal := by
        intro hb_mem
        obtain ⟨i, _, hi⟩ := ha_notMem
        fin_cases i
        · apply hi
          rw [FractionalIdeal.mem_coeIdeal]
          exact ⟨b, hb_mem, hb⟩
        · apply hi
          rw [FractionalIdeal.mem_coeIdeal]
          refine ⟨c, ?_, hc⟩
          rw [← v.intValuation_lt_one_iff_mem, ← v.valuation_of_algebraMap (K := K)]
          change v.valuation K (algebraMap R K c) < 1
          rw [hbc, map_mul, v.valuation_of_algebraMap]
          have hb_lt : v.intValuation b < 1 := (v.intValuation_lt_one_iff_mem b).mpr hb_mem
          calc v.intValuation b * v.valuation K k
            _ ≤ v.intValuation b * 1 := mul_le_mul_right hk_val _
            _ = v.intValuation b := mul_one _
            _ < 1 := hb_lt
      have hb_val : v.intValuation b = 1 :=
        (IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff).mpr hb_notMem
      have hb_bar_ne : Ideal.Quotient.mk v.asIdeal b ≠ 0 :=
        mt Ideal.Quotient.eq_zero_iff_mem.mp hb_notMem
      obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk v.asIdeal b)⁻¹
      have hbd_mem : b * d - 1 ∈ v.asIdeal := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one, hd,
          mul_inv_cancel₀ hb_bar_ne, sub_self]
      have hbd_val : v.intValuation (b * d - 1) < 1 :=
        (v.intValuation_lt_one_iff_mem _).mpr hbd_mem
      let r : R := c * d
      have h_ident : algebraMap R K b * (algebraMap R K r - k) =
          algebraMap R K c * algebraMap R K (b * d - 1) := by
        change algebraMap R K b * (algebraMap R K (c * d) - k) = _
        rw [map_mul, map_sub, map_mul, map_one, hbc]
        ring
      have hrk_val : v.valuation K (algebraMap R K r - k) < 1 := by
        have h1 : v.valuation K (algebraMap R K b * (algebraMap R K r - k)) =
            v.valuation K (algebraMap R K r - k) := by
          rw [map_mul, v.valuation_of_algebraMap, hb_val, one_mul]
        rw [← h1, h_ident, map_mul, v.valuation_of_algebraMap, v.valuation_of_algebraMap]
        have hc_le : v.intValuation c ≤ 1 := v.intValuation_le_one c
        calc v.intValuation c * v.intValuation (b * d - 1)
          _ ≤ 1 * v.intValuation (b * d - 1) := mul_le_mul_left hc_le _
          _ = v.intValuation (b * d - 1) := one_mul _
          _ < 1 := hbd_val
      have hrk_F : Valued.v ((algebraMap R K r : F) - (k : F)) < 1 := by
        rw [← UniformSpace.Completion.coe_sub,
          IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
        exact hrk_val
      have hrx_F : Valued.v ((algebraMap R ↥O_v r : F) - (x : F)) < 1 := by
        change Valued.v ((algebraMap R K r : F) - (x : F)) < 1
        have h_eq : (algebraMap R K r : F) - (x : F) =
            ((algebraMap R K r : F) - (k : F)) + ((k : F) - (x : F)) := by ring
        rw [h_eq]
        exact Valuation.map_add_lt _ hrk_F hk
      refine ⟨Ideal.Quotient.mk v.asIdeal r, ?_⟩
      change IsLocalRing.residue ↥O_v (algebraMap R ↥O_v r) = IsLocalRing.residue ↥O_v x
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact (Valuation.mem_maximalIdeal_iff _ _).mpr hrx_F
    let e_res := RingEquiv.ofBijective φ_bar ⟨hinj, hsurj⟩
    rw [← Nat.card_congr e_res.toEquiv, Ideal.absNorm_apply, Submodule.cardQuot_apply]
  have probe_hensel : ∀ (F : Type u) [Field F]
      [Valued F (WithZero (Multiplicative ℤ))] [CompleteSpace F]
      [IsDiscreteValuationRing ↥(Valued.integer F)]
      (x : F) (hx : Valued.v x < 1)
      (r : ℕ) (hr_pos : 0 < r) (hr_val : Valued.v (r : F) = 1),
      ∃ y : F, y ^ r = 1 + x := by
    clear! K
    intro F _ _ _ _ x hx r hr_pos hr_val
    haveI : IsClosed (Valued.integer F : Set F) := Valued.isClosed_integer F
    haveI : CompleteSpace ↥(Valued.integer F) := IsClosed.completeSpace_coe
    let m_v := IsLocalRing.maximalIdeal ↥(Valued.integer F)
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible ↥(Valued.integer F)
    have hϖ_pow : ∀ n : ℕ, (↑(m_v ^ n) : Set ↥(Valued.integer F)) =
        {y : ↥(Valued.integer F) | Valued.v (y : F) ≤ Valued.v (ϖ : F) ^ n} :=
      Irreducible.maximalIdeal_pow_eq_setOf_le_v_coe_pow Valued.v hϖ
    have hϖ_ne : (ϖ : F) ≠ 0 := fun h => hϖ.ne_zero (Subtype.ext h)
    have hϖ_v_ne : Valued.v (ϖ : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr hϖ_ne
    have hϖ_mem : ϖ ∈ m_v := (IsLocalRing.mem_maximalIdeal ϖ).mpr hϖ.not_isUnit
    have hϖ_lt_one : Valued.v (ϖ : F) < 1 := (Valuation.mem_maximalIdeal_iff _ _).mp hϖ_mem
    obtain ⟨c, hc⟩ := Option.ne_none_iff_exists'.mp hϖ_v_ne
    have hϖ_exp : Valued.v (ϖ : F) = WithZero.exp (Multiplicative.toAdd c) := hc
    have hc_lt : Multiplicative.toAdd c < 0 := by
      rw [hϖ_exp, ← WithZero.exp_zero, WithZero.exp_lt_exp] at hϖ_lt_one
      exact hϖ_lt_one
    have hϖ_le_neg1 : Valued.v (ϖ : F) ≤ WithZero.exp (-1 : ℤ) := by
      rw [hϖ_exp, WithZero.exp_le_exp]
      omega
    have h_adic : IsAdic m_v := by
      rw [isAdic_iff]
      refine ⟨?_, ?_⟩
      · intro n
        rw [hϖ_pow n]
        exact (Valued.isOpen_closedBall F (pow_ne_zero n hϖ_v_ne)).preimage continuous_subtype_val
      · intro s hs
        rw [nhds_induced, Filter.mem_comap] at hs
        obtain ⟨t, ht_nhds, ht_sub⟩ := hs
        change t ∈ nhds (0 : F) at ht_nhds
        rw [Valued.mem_nhds_zero] at ht_nhds
        obtain ⟨γ, hγ⟩ := ht_nhds
        obtain ⟨d, hd⟩ := Option.ne_none_iff_exists'.mp (Units.ne_zero γ)
        have hγ_exp : (γ : WithZero (Multiplicative ℤ)) = WithZero.exp (Multiplicative.toAdd d) := hd
        let n : ℕ := (-Multiplicative.toAdd d).toNat + 1
        refine ⟨n, ?_⟩
        intro y hy
        apply ht_sub
        apply hγ
        rw [hϖ_pow n] at hy
        simp only [Set.mem_setOf_eq] at hy ⊢
        have h1 : Valued.v (y : F) ≤ WithZero.exp (-(n : ℤ)) := by
          calc Valued.v (y : F) ≤ Valued.v (ϖ : F) ^ n := hy
            _ ≤ (WithZero.exp (-1 : ℤ)) ^ n := pow_le_pow_left' hϖ_le_neg1 n
            _ = WithZero.exp (-(n : ℤ)) := by
              rw [← WithZero.exp_nsmul]
              simp
        refine lt_of_le_of_lt h1 ?_
        rw [hγ_exp, WithZero.exp_lt_exp]
        omega
    haveI : IsUniformAddGroup ↥(Valued.integer F) :=
      AddSubgroup.isUniformAddGroup (Valued.integer F).toAddSubgroup
    haveI : IsAdicComplete m_v ↥(Valued.integer F) :=
      (IsAdic.isAdicComplete_iff h_adic).mpr ⟨inferInstance, inferInstance⟩
    haveI : HenselianRing ↥(Valued.integer F) m_v :=
      IsAdicComplete.henselianRing ↥(Valued.integer F) m_v
    let x₀ : ↥(Valued.integer F) := ⟨x, le_of_lt hx⟩
    let u₀ : ↥(Valued.integer F) := 1 + x₀
    let f : Polynomial ↥(Valued.integer F) := Polynomial.X ^ r - Polynomial.C u₀
    have hf_monic : f.Monic := Polynomial.monic_X_pow_sub_C u₀ (by omega)
    have hf_eval_eq : Polynomial.eval 1 f = -x₀ := by
      simp only [f, u₀, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, one_pow,
        Polynomial.eval_C]
      ring
    have hf_eval : Polynomial.eval 1 f ∈ m_v := by
      rw [hf_eval_eq, neg_mem_iff]
      exact (Valuation.mem_maximalIdeal_iff _ _).mpr hx
    have hf_deriv_eq : Polynomial.eval 1 (Polynomial.derivative f) = (r : ↥(Valued.integer F)) := by
      simp [f, Polynomial.derivative_X_pow]
    have hf_deriv : IsUnit (Ideal.Quotient.mk m_v (Polynomial.eval 1 (Polynomial.derivative f))) := by
      rw [hf_deriv_eq]
      apply IsUnit.map
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hr_mem
      have hr_lt : Valued.v (((r : ↥(Valued.integer F)) : F)) < 1 :=
        (Valuation.mem_maximalIdeal_iff _ _).mp hr_mem
      rw [Subring.coe_natCast, hr_val] at hr_lt
      exact lt_irrefl 1 hr_lt
    obtain ⟨y₀, hy₀_root, _⟩ := HenselianRing.is_henselian f hf_monic 1 hf_eval hf_deriv
    refine ⟨(y₀ : F), ?_⟩
    rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C, sub_eq_zero] at hy₀_root
    have hy₀_val := congrArg ((Valued.integer F).subtype : ↥(Valued.integer F) →+* F) hy₀_root
    simp only [u₀, x₀, map_pow, map_add, map_one] at hy₀_val
    exact hy₀_val
  have probe_s1 : ∀ (z : v.adicCompletion K) (hz : Valued.v z ≤ 1),
      ValuativeRel.valuation (v.adicCompletion K) z ≤ 1 := by
    clear! E n
    intro z hz
    let F := v.adicCompletion K
    let e := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    let v₁ : Valuation F (WithZero (Multiplicative ℤ)) := Valued.v
    let v₂ : F →*₀ WithZero (Multiplicative ℤ) :=
      e.toMonoidWithZeroHom.comp (ValuativeRel.valuation F).toMonoidWithZeroHom
    by_contra h_not_le
    have hz₂_gt : 1 < v₂ z := by
      change 1 < e (ValuativeRel.valuation F z)
      rw [← map_one e, map_lt_map_iff]
      exact lt_of_not_ge h_not_le
    have hz₂_ne : v₂ z ≠ 0 := ne_of_gt (lt_trans zero_lt_one hz₂_gt)
    obtain ⟨a₀, ha₀⟩ := Option.ne_none_iff_exists'.mp hz₂_ne
    let a := Multiplicative.toAdd a₀
    have hz₂ : v₂ z = WithZero.exp a := ha₀
    have ha_pos : 1 ≤ a := by
      rw [hz₂, ← WithZero.exp_zero, WithZero.exp_lt_exp] at hz₂_gt
      omega
    obtain ⟨π₀, hπ₀⟩ := v.valuation_exists_uniformizer K
    let π : F := (π₀ : F)
    have hπ₁ : v₁ π = WithZero.exp (-1 : ℤ) := by
      change Valued.v (π₀ : F) = _
      rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation', hπ₀]
    have hπ_ne : π ≠ 0 := by
      intro hπ0
      rw [hπ0, map_zero] at hπ₁
      exact WithZero.exp_ne_zero hπ₁.symm
    have hv₂_π_ne : v₂ π ≠ 0 := by
      change e (ValuativeRel.valuation F π) ≠ 0
      rw [map_ne_zero, Valuation.ne_zero_iff]
      exact hπ_ne
    obtain ⟨b₀, hb₀⟩ := Option.ne_none_iff_exists'.mp hv₂_π_ne
    let b := Multiplicative.toAdd b₀
    have hπ₂ : v₂ π = WithZero.exp b := hb₀
    let k : ℕ := (-b).toNat + 2
    let x : F := π * z ^ k
    have hx₁ : v₁ x < 1 := by
      calc v₁ (π * z ^ k) = v₁ π * v₁ z ^ k := by rw [map_mul, map_pow]
        _ ≤ WithZero.exp (-1 : ℤ) * 1 ^ k := by
          rw [hπ₁]
          exact mul_le_mul_right (pow_le_pow_left' hz k) _
        _ = WithZero.exp (-1 : ℤ) := by rw [one_pow, mul_one]
        _ < 1 := by rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; omega
    have hx₂ : v₂ x = WithZero.exp (b + k • a) := by
      change v₂ (π * z ^ k) = _
      rw [map_mul, map_pow, hπ₂, hz₂, ← WithZero.exp_nsmul, ← WithZero.exp_add]
    have hm_ge : 2 ≤ b + k • a := by
      simp only [nsmul_eq_mul]
      have hk_ge : -b + 2 ≤ (k : ℤ) := by omega
      nlinarith
    let m : ℕ := (b + k • a).toNat
    have hm_eq : (m : ℤ) = b + k • a := Int.toNat_of_nonneg (by omega)
    have hm_pos : 0 < m := by omega
    haveI : v.asIdeal.IsMaximal := v.isPrime.isMaximal v.ne_bot
    letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    let p_char := ringChar (NumberField.RingOfIntegers K ⧸ v.asIdeal)
    obtain ⟨r, hr_ge, hr_prime⟩ := Nat.exists_infinite_primes (max p_char m + 1)
    have hr_gt_p : p_char < r := by omega
    have hr_gt_m : m < r := by omega
    have hr_notMem : (r : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
      intro hr_mem
      have hr_zero : (Ideal.Quotient.mk v.asIdeal (r : NumberField.RingOfIntegers K)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hr_mem
      rw [map_natCast] at hr_zero
      have hdvd : p_char ∣ r := (ringChar.spec (NumberField.RingOfIntegers K ⧸ v.asIdeal) r).mp hr_zero
      rcases hr_prime.eq_one_or_self_of_dvd p_char hdvd with hp1 | hpr
      · have h10 : ((1 : ℕ) : NumberField.RingOfIntegers K ⧸ v.asIdeal) = 0 := by
          rw [← hp1]
          exact ringChar.Nat.cast_ringChar
        rw [Nat.cast_one] at h10
        exact one_ne_zero h10
      · omega
    have hr_val : Valued.v (r : F) = 1 := by
      rw [← map_natCast (algebraMap (NumberField.RingOfIntegers K) F) r]
      change Valued.v ((algebraMap (NumberField.RingOfIntegers K) K (r : NumberField.RingOfIntegers K) : F)) = 1
      rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation',
        IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
        IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff]
      exact hr_notMem
    have h_dvr : IsDiscreteValuationRing ↥(Valued.integer F) :=
      instIsDiscreteValuationRingSubtypeAdicCompletionMemValuationSubringAdicCompletionIntegers
        (NumberField.RingOfIntegers K) K v
    obtain ⟨y, hy⟩ := @probe_hensel F _ _ _ h_dvr x hx₁ r hr_prime.pos hr_val
    have hx_gt_one : ValuativeRel.valuation F 1 < ValuativeRel.valuation F x := by
      rw [← map_lt_map_iff e]
      change v₂ 1 < v₂ x
      rw [map_one, hx₂, ← hm_eq, ← WithZero.exp_zero, WithZero.exp_lt_exp]
      omega
    have hv₂_1x : v₂ (1 + x) = WithZero.exp (m : ℤ) := by
      change e (ValuativeRel.valuation F (1 + x)) = _
      rw [Valuation.map_add_eq_of_lt_right (ValuativeRel.valuation F) hx_gt_one]
      change v₂ x = _
      rw [hx₂, hm_eq]
    have hv₂_yr : v₂ y ^ r = WithZero.exp (m : ℤ) := by
      rw [← map_pow, hy, hv₂_1x]
    have hv₂y_ne : v₂ y ≠ 0 := by
      rintro h0
      rw [h0, zero_pow hr_prime.ne_zero] at hv₂_yr
      exact WithZero.exp_ne_zero hv₂_yr.symm
    obtain ⟨d₀, hd₀⟩ := Option.ne_none_iff_exists'.mp hv₂y_ne
    let d := Multiplicative.toAdd d₀
    have hv₂y : v₂ y = WithZero.exp d := hd₀
    rw [hv₂y, ← WithZero.exp_nsmul] at hv₂_yr
    have hrd : r • d = (m : ℤ) := WithZero.exp_injective hv₂_yr
    simp only [nsmul_eq_mul] at hrd
    have hd_nonneg : 0 ≤ d := by
      have : (0 : ℤ) < r := by exact_mod_cast hr_prime.pos
      nlinarith
    have hd_eq : (d.toNat : ℤ) = d := Int.toNat_of_nonneg hd_nonneg
    rw [← hd_eq] at hrd
    have hdvd_m : r ∣ m := ⟨d.toNat, by exact_mod_cast hrd.symm⟩
    have hr_le_m : r ≤ m := Nat.le_of_dvd hm_pos hdvd_m
    omega
  let F := v.adicCompletion K
  let e := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hv_eq : ∀ x : F, e (ValuativeRel.valuation F x) = Valued.v x :=
    probe_s2 K v probe_s1
  have hv_le_one : ∀ x : F, ValuativeRel.valuation F x ≤ 1 ↔ Valued.v x ≤ 1 := by
    intro x
    rw [← OrderIsoClass.map_le_map_iff e, hv_eq, map_one]
  have hv_lt_one : ∀ x : F, ValuativeRel.valuation F x < 1 ↔ Valued.v x < 1 := by
    intro x
    rw [← map_lt_map_iff e, hv_eq, map_one]
  let e_int : ↥(ValuativeRel.valuation F).integer ≃+* ↥(v.adicCompletionIntegers K) :=
    { toFun := fun x => ⟨x.1, (hv_le_one x.1).mp x.2⟩
      invFun := fun x => ⟨x.1, (hv_le_one x.1).mpr x.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }
  have hq_eq : EllipticRootNumber.q F = Ideal.absNorm v.asIdeal := by
    unfold EllipticRootNumber.q
    have h_card : Nat.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) =
        Nat.card (IsLocalRing.ResidueField ↥(v.adicCompletionIntegers K)) :=
      Nat.card_congr (IsLocalRing.ResidueField.mapEquiv e_int).toEquiv
    rw [h_card, probe_s3 K v]
  have h_alg_val : ∀ k : K, Valued.v (algebraMap K F k) = v.valuation K k :=
    fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v k
  have h_bc : E.baseChange F = E.map (algebraMap K F) := rfl
  refine ⟨hq_eq, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hv_le_one, h_bc, WeierstrassCurve.map_a₁, h_alg_val]
    exact ha₁
  · rw [hv_le_one, h_bc, WeierstrassCurve.map_a₂, h_alg_val]
    exact ha₂
  · rw [hv_le_one, h_bc, WeierstrassCurve.map_a₃, h_alg_val]
    exact ha₃
  · rw [hv_le_one, h_bc, WeierstrassCurve.map_a₄, h_alg_val]
    exact ha₄
  · rw [hv_le_one, h_bc, WeierstrassCurve.map_a₆, h_alg_val]
    exact ha₆
  · rw [hv_lt_one, h_bc, WeierstrassCurve.map_c₄, h_alg_val]
    exact hc₄
  · unfold EllipticRootNumber.IsPotentiallyGood
    rw [hv_le_one, h_bc, WeierstrassCurve.map_c₄, WeierstrassCurve.map_Δ, ← map_pow, ← map_div₀,
      h_alg_val]
    exact hj
  · have he_Δ : e (ValuativeRel.valuation F (E.baseChange F).Δ) = WithZero.exp (-(n : ℤ)) := by
      rw [hv_eq, h_bc, WeierstrassCurve.map_Δ, h_alg_val, hΔ]
    have hΔ_ne_zero : (E.baseChange F).Δ ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at he_Δ
      exact WithZero.exp_ne_zero he_Δ.symm
    unfold EllipticRootNumber.addVal
    rw [dif_neg hΔ_ne_zero]
    have h_unz : ∀ {w : WithZero (Multiplicative ℤ)} (hw : w ≠ 0) {m : ℤ}
        (hm : w = WithZero.exp m), WithZero.unzero hw = Multiplicative.ofAdd m := by
      rintro _ hw m rfl
      exact WithZero.unzero_coe hw
    rw [h_unz _ he_Δ, toAdd_ofAdd, neg_neg]

theorem stdChar_admissible_and_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    EllipticRootNumber.IsAdmissibleChar F ⊥ (EllipticRootNumber.stdChar F) ∧
      EllipticRootNumber.condExpChar F ⊥ (EllipticRootNumber.stdChar F) = 0 ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        0 ≤ EllipticRootNumber.valL F ⊥ x → EllipticRootNumber.stdChar F x = 1) ∧
      (∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x = -1 ∧ EllipticRootNumber.stdChar F x ≠ 1) :=
by
  open ValuativeRel in
  let e_bot := IntermediateField.botEquiv F (AlgebraicClosure F)
  open ValuativeRel in
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have h_unzero : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0) (m : ℤ),
      z = WithZero.exp m → WithZero.unzero hz = Multiplicative.ofAdd m := by
    rintro _ hz m rfl
    exact WithZero.unzero_coe hz
  have h_addVal_of_iso : ∀ (y : F) (m : ℤ),
      iso (ValuativeRel.valuation F y) = WithZero.exp m →
      y ≠ 0 ∧ EllipticRootNumber.addVal F y = -m := by
    intro y m hy_iso
    have h_exp_ne : WithZero.exp m ≠ 0 := WithZero.exp_ne_zero
    have h_iso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := by rw [hy_iso]; exact h_exp_ne
    have hv_ne : ValuativeRel.valuation F y ≠ 0 := fun h0 => h_iso_ne (by rw [h0, map_zero])
    have hy : y ≠ 0 := (Valuation.ne_zero_iff _).mp hv_ne
    refine ⟨hy, ?_⟩
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy, h_unzero _ _ m hy_iso]
    rfl
  obtain ⟨π, hπ_val⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ_val, iso.apply_symm_apply]
  obtain ⟨hπ0, hπ_addVal⟩ := h_addVal_of_iso π (-1) hπ_iso
  have hπ1 : ValuativeRel.valuation F π < 1 := by
    rw [← map_lt_map_iff iso, hπ_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have h_exp_inv : (WithZero.exp (-1 : ℤ))⁻¹ = WithZero.exp (1 : ℤ) := by
    apply inv_eq_of_mul_eq_one_right
    rw [← WithZero.exp_add]
    rfl
  have hπ_inv_iso : iso (ValuativeRel.valuation F π⁻¹) = WithZero.exp (1 : ℤ) := by
    rw [map_inv₀, map_inv₀, hπ_iso, h_exp_inv]
  have hπ_inv_addVal : EllipticRootNumber.addVal F π⁻¹ = -1 :=
    (h_addVal_of_iso π⁻¹ 1 hπ_inv_iso).2
  have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have h_norm : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [h_norm]
  have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨Nat.zero_lt_one, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · intro h0
      apply hπ0
      have := congrArg e_bot h0
      simpa using this
    · rw [h_relVal, e_bot.apply_symm_apply, hπ_addVal]
      omega
    · rintro k ⟨hk, _⟩
      exact hk
  have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_relVal, h_resDeg, Nat.cast_one, Int.ediv_one]
  have h_addVal_nonneg : ∀ y : F,
      0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl, Valuation.map_zero]
      exact ⟨fun _ => zero_le', fun _ => le_rfl⟩
    · unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      have hv_ne : ValuativeRel.valuation F y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have hiso_ne : iso (ValuativeRel.valuation F y) ≠ 0 := (map_ne_zero _).mpr hv_ne
      set u := WithZero.unzero hiso_ne
      have hu_eq : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd u) := by
        rw [← WithZero.coe_unzero hiso_ne]
        rfl
      rw [← map_le_map_iff iso, hu_eq, map_one, ← WithZero.exp_zero, WithZero.exp_le_exp]
      omega
  letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℕ :=
    DivisibleBy.mk
      (fun a n =>
        if hn : n = 0 then 0
        else
          let h_ex := IsAlgClosed.exists_pow_nat_eq
            ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
            (Nat.pos_of_ne_zero hn)
          let z := Classical.choose h_ex
          have hz_pow : z ^ n = ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) :=
            Classical.choose_spec h_ex
          have hz_ne : z ≠ 0 := by
            intro hz0
            rw [hz0, zero_pow hn] at hz_pow
            exact Units.ne_zero (Additive.toMul a) hz_pow.symm
          Additive.ofMul (Units.mk0 z hz_ne))
      (fun a => dif_pos rfl)
      (fun {n} a hn => by
        dsimp only
        rw [dif_neg hn, ← ofMul_pow, ← ofMul_toMul a]
        congr 1
        apply Units.ext
        simp only [Units.val_pow_eq_pow_val, Units.val_mk0]
        exact Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq
          ((Additive.toMul a : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
          (Nat.pos_of_ne_zero hn)))
  letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℤ :=
    AddGroup.divisibleByIntOfDivisibleByNat (Additive (EllipticRootNumber.Ω F)ˣ)
  have hBaer : Module.Baer ℤ (Additive (EllipticRootNumber.Ω F)ˣ) :=
    Module.Baer.of_divisible (Additive (EllipticRootNumber.Ω F)ˣ)
  open ValuativeRel in
  have hp : (EllipticRootNumber.p F).Prime :=
    CharP.char_is_prime 𝓀[F] (EllipticRootNumber.p F)
  haveI : Fact (EllipticRootNumber.p F).Prime := ⟨hp⟩
  open ValuativeRel in
  haveI : Fact (ringChar 𝓀[F]).Prime := ⟨hp⟩
  obtain ⟨ζ, hζ_root⟩ := IsAlgClosed.exists_root
    (Polynomial.cyclotomic (EllipticRootNumber.p F) (EllipticRootNumber.Ω F))
    (ne_of_gt (Polynomial.degree_cyclotomic_pos (EllipticRootNumber.p F) (EllipticRootNumber.Ω F) hp.pos))
  have hζ : IsPrimitiveRoot ζ (EllipticRootNumber.p F) :=
    (Polynomial.isRoot_cyclotomic_iff_charZero hp.pos).mp hζ_root
  let ζ_u : (EllipticRootNumber.Ω F)ˣ := Units.mk0 ζ (hζ.ne_zero hp.ne_zero)
  let q₀ : Additive (EllipticRootNumber.Ω F)ˣ := Additive.ofMul ζ_u
  have hζ_ne_one : ζ ≠ 1 := hζ.ne_one hp.one_lt
  have hq₀_pow : (EllipticRootNumber.p F : ℤ) • q₀ = 0 := by
    rw [natCast_zsmul, ← ofMul_pow]
    change Additive.ofMul (ζ_u ^ EllipticRootNumber.p F) = Additive.ofMul 1
    congr 1
    ext
    simp [ζ_u, hζ.pow_eq_one]
  let g₀ : ZMod (EllipticRootNumber.p F) →+ Additive (EllipticRootNumber.Ω F)ˣ :=
    ZMod.lift (EllipticRootNumber.p F) ⟨zmultiplesHom _ q₀, by
      rw [zmultiplesHom_apply]
      exact hq₀_pow⟩
  have hg₀_one : g₀ 1 = q₀ := by
    rw [← Int.cast_one, ZMod.lift_coe, zmultiplesHom_apply, one_zsmul]
  open ValuativeRel in
  let f₀ : ZMod (EllipticRootNumber.p F) →+ 𝓀[F] :=
    (ZMod.castHom dvd_rfl 𝓀[F]).toAddMonoidHom
  open ValuativeRel in
  have hf₀_inj : Function.Injective f₀ :=
    RingHom.injective (ZMod.castHom dvd_rfl 𝓀[F])
  obtain ⟨ψ_res, hψ_res⟩ :=
    Module.Baer.extension_property_addMonoidHom hBaer f₀ hf₀_inj g₀
  have hψ_res_one : ψ_res 1 = q₀ := by
    open ValuativeRel in
    have h1 : f₀ 1 = 1 := map_one (ZMod.castHom dvd_rfl 𝓀[F])
    rw [← h1, ← AddMonoidHom.comp_apply, hψ_res, hg₀_one]
  let M₁ : AddSubgroup F :=
    (ValuativeRel.valuation F).valuationSubring.toSubring.toAddSubgroup.comap
      (AddMonoidHom.mulLeft π)
  open ValuativeRel in
  let r₁ : M₁ →+ 𝓀[F] :=
    { toFun := fun m => IsLocalRing.residue ↥𝒪[F] ⟨π * m.1, m.2⟩
      map_zero' := by
        have h0 : (⟨π * (0 : M₁).1, (0 : M₁).2⟩ : ↥𝒪[F]) = 0 := by
          ext
          exact mul_zero π
        change IsLocalRing.residue ↥𝒪[F] ⟨π * (0 : M₁).1, (0 : M₁).2⟩ = 0
        rw [h0, map_zero]
      map_add' := fun a b => by
        have h_add : (⟨π * (a + b).1, (a + b).2⟩ : ↥𝒪[F]) =
            ⟨π * a.1, a.2⟩ + ⟨π * b.1, b.2⟩ := by
          ext
          exact mul_add π a.1 b.1
        change IsLocalRing.residue ↥𝒪[F] ⟨π * (a + b).1, (a + b).2⟩ = _
        rw [h_add, map_add] }
  obtain ⟨ψ_tilde, hψ_tilde⟩ :=
    Module.Baer.extension_property_addMonoidHom hBaer M₁.subtype M₁.subtype_injective (ψ_res.comp r₁)
  let ψ_F : AddChar F (EllipticRootNumber.Ω F) :=
    { toFun := fun y => ((Additive.toMul (ψ_tilde y) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)
      map_zero_eq_one' := by
        rw [map_zero, toMul_zero, Units.val_one]
      map_add_eq_mul' := fun a b => by
        rw [map_add, toMul_add, Units.val_mul] }
  have hψ_F_triv : ∀ y : F, ValuativeRel.valuation F y ≤ 1 → ψ_F y = 1 := by
    intro y hy
    have hπy_lt : ValuativeRel.valuation F (π * y) < 1 := by
      rw [map_mul]
      calc ValuativeRel.valuation F π * ValuativeRel.valuation F y
          ≤ ValuativeRel.valuation F π * 1 := mul_le_mul_of_nonneg_left hy zero_le'
        _ = ValuativeRel.valuation F π := mul_one _
        _ < 1 := hπ1
    have hy_M₁ : y ∈ M₁ := le_of_lt hπy_lt
    have hr₁_zero : r₁ ⟨y, hy_M₁⟩ = 0 := by
      open ValuativeRel in
      change IsLocalRing.residue ↥𝒪[F] ⟨π * y, hy_M₁⟩ = 0
      rw [IsLocalRing.residue_eq_zero_iff]
      exact (Valuation.mem_maximalIdeal_iff _ _).mpr hπy_lt
    have h_tilde : ψ_tilde y = 0 := by
      change ψ_tilde (M₁.subtype ⟨y, hy_M₁⟩) = 0
      rw [← AddMonoidHom.comp_apply, hψ_tilde, AddMonoidHom.comp_apply, hr₁_zero, map_zero]
    change ((Additive.toMul (ψ_tilde y) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) = 1
    rw [h_tilde, toMul_zero, Units.val_one]
  have hψ_F_inv : ψ_F π⁻¹ ≠ 1 := by
    have hπ_inv_M₁ : π⁻¹ ∈ M₁ := by
      change ValuativeRel.valuation F (π * π⁻¹) ≤ 1
      rw [mul_inv_cancel₀ hπ0, Valuation.map_one]
    have hr₁_one : r₁ ⟨π⁻¹, hπ_inv_M₁⟩ = 1 := by
      open ValuativeRel in
      have h_one : (⟨π * π⁻¹, hπ_inv_M₁⟩ : ↥𝒪[F]) = 1 := by
        ext
        exact mul_inv_cancel₀ hπ0
      open ValuativeRel in
      change IsLocalRing.residue ↥𝒪[F] ⟨π * π⁻¹, hπ_inv_M₁⟩ = 1
      rw [h_one, map_one]
    have h_tilde : ψ_tilde π⁻¹ = q₀ := by
      change ψ_tilde (M₁.subtype ⟨π⁻¹, hπ_inv_M₁⟩) = q₀
      rw [← AddMonoidHom.comp_apply, hψ_tilde, AddMonoidHom.comp_apply, hr₁_one, hψ_res_one]
    change ((Additive.toMul (ψ_tilde π⁻¹) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) ≠ 1
    rw [h_tilde]
    exact hζ_ne_one
  let ψ_bot : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F) :=
    ψ_F.compAddMonoidHom e_bot.toAddMonoidHom
  have h_exists_std : ∃ ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F),
      (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1 := by
    refine ⟨ψ_bot, ?_, e_bot.symm π⁻¹, ?_, ?_⟩
    · intro x hx
      rw [h_valL, h_addVal_nonneg] at hx
      rw [AddChar.compAddMonoidHom_apply]
      exact hψ_F_triv (e_bot x) hx
    · rw [h_valL, e_bot.apply_symm_apply, hπ_inv_addVal]
    · rw [AddChar.compAddMonoidHom_apply]
      change ψ_F (e_bot (e_bot.symm π⁻¹)) ≠ 1
      rw [e_bot.apply_symm_apply]
      exact hψ_F_inv
  obtain ⟨hψ₀_triv, hψ₀_nontriv⟩ := Classical.epsilon_spec h_exists_std
  change (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → EllipticRootNumber.stdChar F x = 1) at hψ₀_triv
  change (∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ EllipticRootNumber.stdChar F x ≠ 1) at hψ₀_nontriv
  obtain ⟨x₀, hx₀_val, hx₀_ne⟩ := hψ₀_nontriv
  have h_adm : EllipticRootNumber.IsAdmissibleChar F ⊥ (EllipticRootNumber.stdChar F) := by
    refine ⟨?_, 0, hψ₀_triv⟩
    intro h_eq
    apply hx₀_ne
    rw [h_eq, AddChar.one_apply]
  have h_cond : EllipticRootNumber.condExpChar F ⊥ (EllipticRootNumber.stdChar F) = 0 := by
    unfold EllipticRootNumber.condExpChar
    apply IsGreatest.csSup_eq
    refine ⟨?_, ?_⟩
    · intro x hx
      rw [neg_zero] at hx
      exact hψ₀_triv x hx
    · intro d hd
      by_contra h_gt
      have hd_le : -d ≤ EllipticRootNumber.valL F ⊥ x₀ := by
        rw [hx₀_val]
        omega
      exact hx₀_ne (hd x₀ hd_le)
  exact ⟨h_adm, h_cond, hψ₀_triv, ⟨x₀, hx₀_val, hx₀_ne⟩⟩

theorem local_field_hensel_and_primitive_root_of_unity (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)) :
    ∃ (π ζ : F),
      π ≠ 0 ∧
      EllipticRootNumber.addVal F π = 1 ∧
      ζ ^ (12 / Nat.gcd n 12) = 1 ∧
      (∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 → ζ ^ d ≠ 1) ∧
      (∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 1,
        EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
        ∃ z : (⊥ : IntermediateField F (AlgebraicClosure F)),
          z ^ (12 / Nat.gcd n 12) = (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) :=
by
  classical
  
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective (K := F) (iso.symm (WithZero.exp (-1 : ℤ)))
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    rw [hπ, OrderMonoidIso.apply_symm_apply]
  have hπ_ne : π ≠ 0 := by
    rintro rfl
    rw [Valuation.map_zero, map_zero] at hπ_iso
    exact WithZero.exp_ne_zero hπ_iso.symm
  have hπ_lt1 : ValuativeRel.valuation F π < 1 := by
    rw [← map_lt_map_iff iso, hπ_iso, map_one, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  have hπ_val : EllipticRootNumber.addVal F π = 1 := by
    unfold EllipticRootNumber.addVal
    rw [dif_neg hπ_ne]
    have h_unzero : WithZero.unzero (x := iso (ValuativeRel.valuation F π))
        (by rw [hπ_iso]; exact WithZero.exp_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      simp only [hπ_iso, WithZero.exp, WithZero.unzero_coe]
    rw [h_unzero, toAdd_ofAdd]
    norm_num

  have hp_info : (EllipticRootNumber.p F).Prime ∧ EllipticRootNumber.p F ∣ EllipticRootNumber.q F := by
    let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
    letI : Fintype kF := Fintype.ofFinite kF
    obtain ⟨k_card, hp_prime, hcard_eq⟩ := FiniteField.card kF (ringChar kF)
    refine ⟨hp_prime, ?_⟩
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hcard_eq]
    exact dvd_pow_self (ringChar kF) k_card.ne_zero
  obtain ⟨hp_prime', hp_dvd_q⟩ := hp_info
  have hp_ne2 : EllipticRootNumber.p F ≠ 2 := by
    rintro h; rw [h] at hp_dvd_q; exact hq2 hp_dvd_q
  have hp_ne3 : EllipticRootNumber.p F ≠ 3 := by
    rintro h; rw [h] at hp_dvd_q; exact hq3 hp_dvd_q

  set e := 12 / Nat.gcd n 12
  have he_cases : e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 6 := by
    change 12 / Nat.gcd n 12 = 2 ∨ 12 / Nat.gcd n 12 = 3 ∨
      12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6
    interval_cases n <;> first | decide | omega
  have he_pos : 0 < e := by
    rcases he_cases with h | h | h | h <;> omega
  have he_ndvd : ¬ (EllipticRootNumber.p F ∣ e) := by
    intro hdvd
    rcases he_cases with h | h | h | h
    · rw [h, Nat.dvd_prime Nat.prime_two] at hdvd
      rcases hdvd with h1 | h2
      · exact hp_prime'.ne_one h1
      · exact hp_ne2 h2
    · rw [h, Nat.dvd_prime Nat.prime_three] at hdvd
      rcases hdvd with h1 | h3
      · exact hp_prime'.ne_one h1
      · exact hp_ne3 h3
    · have hdvd2 : EllipticRootNumber.p F ∣ 2 ^ 2 := by rwa [h] at hdvd
      have hdvd' := hp_prime'.dvd_of_dvd_pow hdvd2
      rw [Nat.dvd_prime Nat.prime_two] at hdvd'
      rcases hdvd' with h1 | h2
      · exact hp_prime'.ne_one h1
      · exact hp_ne2 h2
    · have hdvd6 : EllipticRootNumber.p F ∣ 2 * 3 := by rwa [h] at hdvd
      rcases hp_prime'.dvd_mul.mp hdvd6 with hdvd2 | hdvd3
      · rw [Nat.dvd_prime Nat.prime_two] at hdvd2
        rcases hdvd2 with h1 | h2
        · exact hp_prime'.ne_one h1
        · exact hp_ne2 h2
      · rw [Nat.dvd_prime Nat.prime_three] at hdvd3
        rcases hdvd3 with h1 | h3
        · exact hp_prime'.ne_one h1
        · exact hp_ne3 h3

  
  let A := (ValuativeRel.valuation F).valuationSubring
  let I := IsLocalRing.maximalIdeal ↥A
  let kF := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer
  have h_hensel_all : ∀ (c a : F),
      ValuativeRel.valuation F c ≤ 1 →
      ValuativeRel.valuation F a = 1 →
      ValuativeRel.valuation F (a ^ e - c) < 1 →
      ∃ z : F, z ^ e = c ∧ ValuativeRel.valuation F (z - a) < 1 := by
    let π₀ : ↥A := ⟨π, le_of_lt hπ_lt1⟩
    have h_lt1_iff_le_π : ∀ y : F,
        ValuativeRel.valuation F y < 1 ↔
          ValuativeRel.valuation F y ≤ ValuativeRel.valuation F π := by
      intro y
      rw [← map_lt_map_iff iso, ← map_le_map_iff iso, hπ_iso, map_one]
      rcases hy : iso (ValuativeRel.valuation F y) with _ | m
      · change (0 : WithZero (Multiplicative ℤ)) < 1 ↔
          (0 : WithZero (Multiplicative ℤ)) ≤ WithZero.exp (-1 : ℤ)
        exact ⟨fun _ => zero_le', fun _ => WithZero.zero_lt_coe _⟩
      · change WithZero.exp (Multiplicative.toAdd m) < WithZero.exp (0 : ℤ) ↔
          WithZero.exp (Multiplicative.toAdd m) ≤ WithZero.exp (-1 : ℤ)
        rw [WithZero.exp_lt_exp, WithZero.exp_le_exp]
        omega
    have hI_span : I = Ideal.span {π₀} := by
      ext x
      rw [Valuation.mem_maximalIdeal_iff, Ideal.mem_span_singleton,
        Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F))]
      exact h_lt1_iff_le_π (x : F)
    have hIm_mem : ∀ (m : ℕ) (x : ↥A),
        x ∈ I ^ m ↔ ValuativeRel.valuation F (x : F) ≤ (ValuativeRel.valuation F π) ^ m := by
      intro m x
      rw [hI_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
        Valuation.Integers.dvd_iff_le (Valuation.integer.integers (ValuativeRel.valuation F)),
        map_pow, map_pow]
      rfl
    have h_pre : IsPrecomplete I ↥A := by
      refine IsPrecomplete.mk fun f hf => ?_
      let T : ℕ → Set ↥A := fun m => {x : ↥A | f m ≡ x [SMOD I ^ m • (⊤ : Submodule ↥A ↥A)]}
      have hT_anti : ∀ m : ℕ, T (m + 1) ⊆ T m := by
        intro m x hx
        have h_le : I ^ (m + 1) • (⊤ : Submodule ↥A ↥A) ≤ I ^ m • (⊤ : Submodule ↥A ↥A) := by
          rw [smul_eq_mul, Ideal.mul_top, smul_eq_mul, Ideal.mul_top]
          exact Ideal.pow_le_pow_right (Nat.le_succ m)
        exact (hf (Nat.le_succ m)).trans (hx.mono h_le)
      have hT_nonempty : ∀ m : ℕ, (T m).Nonempty := fun m => ⟨f m, SModEq.refl (f m)⟩
      have hT_closed : ∀ m : ℕ, IsClosed (T m) := by
        intro m
        have h_eq : T m = (fun x : ↥A => (f m : F) - (x : F)) ⁻¹'
            {y : F | ValuativeRel.valuation F y ≤ (ValuativeRel.valuation F π) ^ m} := by
          ext x
          simp only [T, Set.mem_setOf_eq, Set.mem_preimage]
          rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, hIm_mem m (f m - x), AddSubgroupClass.coe_sub]
        rw [h_eq]
        exact (IsValuativeTopology.isClosed_closedBall _).preimage
          (continuous_const.sub continuous_subtype_val)
      haveI : CompactSpace ↥A :=
        IsNonarchimedeanLocalField.instCompactSpaceSubtypeMemSubringIntegerValueGroupWithZeroValuation F
      obtain ⟨L, hL⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
        T hT_anti hT_nonempty (hT_closed 0).isCompact hT_closed
      exact ⟨L, fun m => Set.mem_iInter.mp hL m⟩
    haveI : IsDiscreteValuationRing ↥A :=
      IsNonarchimedeanLocalField.instIsDiscreteValuationRingSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    haveI : IsAdicComplete I ↥A :=
      { toIsPrecomplete := h_pre
        toIsHausdorff := IsDiscreteValuationRing.instIsHausdorffMaximalIdeal ↥A }
    haveI : HenselianRing ↥A I := IsAdicComplete.henselianRing ↥A I
    intro c a hc ha h_diff
    let c₀ : ↥A := ⟨c, hc⟩
    let a₀ : ↥A := ⟨a, le_of_eq ha⟩
    let P : Polynomial ↥A := Polynomial.X ^ e - Polynomial.C c₀
    have hP_monic : P.Monic := Polynomial.monic_X_pow_sub_C c₀ he_pos.ne'
    have hP_eval : P.eval a₀ ∈ I := by
      rw [Valuation.mem_maximalIdeal_iff]
      have h_coe : ((P.eval a₀ : ↥A) : F) = a ^ e - c := by
        simp only [P, a₀, c₀, Polynomial.eval_sub, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C, AddSubgroupClass.coe_sub, SubmonoidClass.coe_pow]
      rwa [h_coe]
    have hP_deriv : IsUnit ((Ideal.Quotient.mk I) (P.derivative.eval a₀)) := by
      have h_deriv_eq : P.derivative.eval a₀ = (e : ↥A) * a₀ ^ (e - 1) := by
        simp only [P, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
          Polynomial.derivative_C, sub_zero, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X]
      rw [h_deriv_eq]
      change IsUnit (IsLocalRing.residue ↥A ((e : ↥A) * a₀ ^ (e - 1)))
      rw [map_mul, map_natCast, map_pow]
      have he_res_ne : (e : kF) ≠ 0 := by
        haveI : CharP kF (EllipticRootNumber.p F) := ringChar.charP kF
        exact (CharP.cast_eq_zero_iff kF (EllipticRootNumber.p F) e).not.mpr he_ndvd
      have ha_res_ne : IsLocalRing.residue ↥A a₀ ≠ 0 := by
        rw [Ne, IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff]
        change ¬ (ValuativeRel.valuation F a < 1)
        rw [ha]
        exact lt_irrefl 1
      exact IsUnit.mk0 _ (mul_ne_zero he_res_ne (pow_ne_zero (e - 1) ha_res_ne))
    obtain ⟨z₀, hz₀_root, hz₀_mem⟩ := HenselianRing.is_henselian P hP_monic a₀ hP_eval hP_deriv
    refine ⟨(z₀ : F), ?_, ?_⟩
    · rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
        Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hz₀_root
      exact (SubmonoidClass.coe_pow z₀ e).symm.trans (congrArg Subtype.val hz₀_root)
    · rw [Valuation.mem_maximalIdeal_iff] at hz₀_mem
      exact hz₀_mem

  
  have h_ker : ∀ x : ↥A.unitGroup, A.unitGroupToResidueFieldUnits x = 1 →
      ValuativeRel.valuation F (((x : Fˣ) : F) - 1) < 1 := by
    intro x hx
    have hx' : IsLocalRing.residue ↥A (A.unitGroupMulEquiv x : ↥A) = 1 := by
      have := congrArg Units.val hx
      rwa [ValuationSubring.coe_unitGroupToResidueFieldUnits_apply] at this
    have h_mem : (A.unitGroupMulEquiv x : ↥A) - 1 ∈ I := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_one, hx', sub_self]
    rw [Valuation.mem_maximalIdeal_iff] at h_mem
    rwa [AddSubgroupClass.coe_sub, OneMemClass.coe_one,
      ValuationSubring.coe_unitGroupMulEquiv_apply] at h_mem

  obtain ⟨g, hg_gen⟩ := IsCyclic.exists_monoid_generator (α := kFˣ)
  have hq_gt1 : 1 < EllipticRootNumber.q F := Finite.one_lt_card
  have hg_ord : orderOf g = EllipticRootNumber.q F - 1 := by
    rw [orderOf_eq_card_of_forall_mem_powers hg_gen, Nat.card_units]
    rfl
  set k := (EllipticRootNumber.q F - 1) / e
  have hk_mul : k * e = EllipticRootNumber.q F - 1 := Nat.div_mul_cancel hab
  have hk_pos : 0 < k := Nat.div_pos (Nat.le_of_dvd (by omega) hab) he_pos
  let ζ_bar : kFˣ := g ^ k
  have hζ_bar_pow : ζ_bar ^ e = 1 := by
    dsimp [ζ_bar]
    rw [← pow_mul, hk_mul, ← hg_ord, pow_orderOf_eq_one]
  obtain ⟨x₀, hx₀⟩ := ValuationSubring.surjective_unitGroupToResidueFieldUnits A ζ_bar
  let a : F := ((x₀ : Fˣ) : F)
  have ha_val : ValuativeRel.valuation F a = 1 :=
    (Valuation.mem_unitGroup_iff F (ValuativeRel.valuation F) (x₀ : Fˣ)).mp x₀.2
  have ha_pow_lt : ValuativeRel.valuation F (a ^ e - 1) < 1 := by
    have hx₀_pow : A.unitGroupToResidueFieldUnits (x₀ ^ e) = 1 := by
      rw [map_pow, hx₀, hζ_bar_pow]
    have h1 := h_ker (x₀ ^ e) hx₀_pow
    rwa [SubmonoidClass.coe_pow, Units.val_pow_eq_pow_val] at h1
  obtain ⟨ζ, hζ_pow, hζ_close⟩ := h_hensel_all 1 a (by rw [Valuation.map_one]) ha_val ha_pow_lt

  have hζ_int : ValuativeRel.valuation F ζ ≤ 1 := by
    have h_eq : ζ = (ζ - a) + a := (sub_add_cancel ζ a).symm
    rw [h_eq]
    exact (Valuation.map_add _ _ _).trans (max_le (le_of_lt hζ_close) (le_of_eq ha_val))
  let ζ₀ : ↥A := ⟨ζ, hζ_int⟩
  let a₀ : ↥A := A.unitGroupMulEquiv x₀
  have hζ₀_res : IsLocalRing.residue ↥A ζ₀ = (ζ_bar : kF) := by
    have h_diff_mem : ζ₀ - a₀ ∈ I := by
      rw [Valuation.mem_maximalIdeal_iff]
      change ValuativeRel.valuation F (ζ - (a₀ : F)) < 1
      rwa [ValuationSubring.coe_unitGroupMulEquiv_apply]
    have h_res_zero : IsLocalRing.residue ↥A (ζ₀ - a₀) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr h_diff_mem
    rw [map_sub, sub_eq_zero] at h_res_zero
    have ha₀_res : IsLocalRing.residue ↥A a₀ = (ζ_bar : kF) := by
      rw [← hx₀]
      exact (ValuationSubring.coe_unitGroupToResidueFieldUnits_apply A x₀).symm
    rw [h_res_zero, ha₀_res]
  have hζ_ord : ∀ d : ℕ, d ∣ e → d < e → ζ ^ d ≠ 1 := by
    intro d hd hlt h_eq1
    have hd_pos : 0 < d := Nat.pos_of_dvd_of_pos hd he_pos
    have hζ₀_pow : ζ₀ ^ d = 1 := Subtype.ext ((SubmonoidClass.coe_pow ζ₀ d).trans h_eq1)
    have h_res_pow : (ζ_bar : kF) ^ d = 1 := by
      rw [← hζ₀_res, ← map_pow (IsLocalRing.residue ↥A), hζ₀_pow, map_one]
    have h_unit_pow : ζ_bar ^ d = 1 := Units.ext ((Units.val_pow_eq_pow_val ζ_bar d).trans h_res_pow)
    have hg_kd : g ^ (k * d) = 1 := by
      rwa [pow_mul]
    have hkd_lt : k * d < orderOf g := by
      rw [hg_ord, ← hk_mul]
      exact Nat.mul_lt_mul_of_pos_left hlt hk_pos
    have hkd_ne : k * d ≠ 0 := (Nat.mul_pos hk_pos hd_pos).ne'
    exact pow_ne_one_of_lt_orderOf hkd_ne hkd_lt hg_kd

  
  let e_bot : (⊥ : IntermediateField F (AlgebraicClosure F)) ≃ₐ[F] F :=
    IntermediateField.botEquiv F (AlgebraicClosure F)
  have h_relVal : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.relVal
    have h_norm : Algebra.norm F x = e_bot x := by
      rw [← Algebra.norm_eq_of_algEquiv e_bot x, Algebra.norm_self]
      rfl
    rw [h_norm]
  have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    apply IsLeast.csInf_eq
    refine ⟨⟨Nat.one_pos, e_bot.symm π, ?_, ?_⟩, ?_⟩
    · intro h0
      exact hπ_ne ((map_eq_zero_iff e_bot.symm e_bot.symm.injective).mp h0)
    · rw [h_relVal, AlgEquiv.apply_symm_apply, hπ_val, Nat.cast_one]
    · rintro k ⟨hk_pos, _⟩
      exact hk_pos
  have h_valL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (e_bot x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [h_relVal, h_resDeg, Nat.cast_one, EuclideanDomain.div_one]

  have h_addVal_zero : ∀ y : F, y ≠ 0 →
      (EllipticRootNumber.addVal F y = 0 ↔ ValuativeRel.valuation F y = 1) := by
    intro y hy
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy, ← map_eq_one_iff iso iso.injective]
    have hy_iso : iso (ValuativeRel.valuation F y) ≠ 0 :=
      (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hy)
    set m := WithZero.unzero hy_iso
    have hm_coe : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd m) := by
      rw [← WithZero.coe_unzero hy_iso]
      rfl
    rw [hm_coe, ← WithZero.exp_zero, WithZero.exp_inj]
    omega

  have h_addVal_pos : ∀ y : F, y ≠ 0 →
      (1 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y < 1) := by
    intro y hy
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy, ← map_lt_map_iff iso, map_one]
    have hy_iso : iso (ValuativeRel.valuation F y) ≠ 0 :=
      (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hy)
    set m := WithZero.unzero hy_iso
    have hm_coe : iso (ValuativeRel.valuation F y) = WithZero.exp (Multiplicative.toAdd m) := by
      rw [← WithZero.coe_unzero hy_iso]
      rfl
    rw [hm_coe, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega

  let H₁ : Subgroup (⊥ : IntermediateField F (AlgebraicClosure F))ˣ :=
    { carrier := {u | ValuativeRel.valuation F (e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 ∧
        ∃ z : (⊥ : IntermediateField F (AlgebraicClosure F)),
          z ^ e = (u : (⊥ : IntermediateField F (AlgebraicClosure F)))}
      one_mem' := by
        refine ⟨?_, 1, one_pow e⟩
        rw [Units.val_one, map_one, Valuation.map_one]
      mul_mem' := by
        rintro u₁ u₂ ⟨hv₁, z₁, hz₁⟩ ⟨hv₂, z₂, hz₂⟩
        refine ⟨?_, z₁ * z₂, ?_⟩
        · rw [Units.val_mul, map_mul, map_mul, hv₁, hv₂, mul_one]
        · rw [mul_pow, hz₁, hz₂, Units.val_mul]
      inv_mem' := by
        rintro u ⟨hv, z, hz⟩
        refine ⟨?_, z⁻¹, ?_⟩
        · rw [Units.val_inv_eq_inv_val, map_inv₀, map_inv₀, hv, inv_one]
        · rw [inv_pow, hz, Units.val_inv_eq_inv_val] }

  have h_le_H₁ : EllipticRootNumber.unitGroup F ⊥ 1 ≤ H₁ := by
    unfold EllipticRootNumber.unitGroup
    rw [Subgroup.closure_le]
    intro v hv
    simp only [Set.mem_setOf_eq, Nat.one_ne_zero, ↓reduceIte, Nat.cast_one] at hv
    rcases hv with hv1 | hv_ge
    · have hv_eq : v = 1 := Units.ext hv1
      rw [hv_eq]
      exact H₁.one_mem
    · by_cases hv1 : (v : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1
      · have hv_eq : v = 1 := Units.ext hv1
        rw [hv_eq]
        exact H₁.one_mem
      · have h_sub_ne : e_bot (v : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1 ≠ 0 := by
          rw [← map_one e_bot, ← map_sub]
          intro h0
          apply hv1
          exact sub_eq_zero.mp ((map_eq_zero_iff e_bot e_bot.injective).mp h0)
        rw [h_valL, map_sub, map_one, h_addVal_pos _ h_sub_ne] at hv_ge
        have hv_val : ValuativeRel.valuation F (e_bot (v : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 1 := by
          have h_add : e_bot (v : (⊥ : IntermediateField F (AlgebraicClosure F))) =
              (e_bot (v : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) + 1 :=
            (sub_add_cancel _ 1).symm
          rw [h_add, Valuation.map_add_eq_of_lt_right _ (by rwa [Valuation.map_one]), Valuation.map_one]
        have h_diff1 : ValuativeRel.valuation F
            ((1 : F) ^ e - e_bot (v : (⊥ : IntermediateField F (AlgebraicClosure F)))) < 1 := by
          rw [one_pow, Valuation.map_sub_swap]
          exact hv_ge
        obtain ⟨z_F, hz_F, _⟩ := h_hensel_all
          (e_bot (v : (⊥ : IntermediateField F (AlgebraicClosure F)))) 1
          (le_of_eq hv_val) (Valuation.map_one _) h_diff1
        refine ⟨hv_val, e_bot.symm z_F, ?_⟩
        rw [← map_pow, hz_F, AlgEquiv.symm_apply_apply]

  refine ⟨π, ζ, hπ_ne, hπ_val, hζ_pow, hζ_ord, ?_⟩
  intro u hu
  obtain ⟨hu_val, z, hz⟩ := h_le_H₁ hu
  refine ⟨?_, z, hz⟩
  have hu_ne : e_bot (u : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 := by
    rw [map_ne_zero_iff e_bot e_bot.injective]
    exact Units.ne_zero u
  rw [h_valL, (h_addVal_zero _ hu_ne).mpr hu_val]

theorem unramifiedClosure_no_root_of_uniformizer (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (π : F) (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (k : ℕ) (hk : 2 ≤ k) (η : AlgebraicClosure F)
    (hη_mem : η ∈ EllipticRootNumber.unramifiedClosure F) :
    η ^ k ≠ algebraMap F (AlgebraicClosure F) π :=
by
  intro h_eq
  have hη_ne : η ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega : k ≠ 0)] at h_eq
    exact hπ_ne ((map_eq_zero_iff (algebraMap F (AlgebraicClosure F))
      (RingHom.injective (algebraMap F (AlgebraicClosure F)))).mp h_eq.symm)
  obtain ⟨T, hT_sub, hη_T⟩ := IntermediateField.exists_finset_of_mem_adjoin hη_mem
  have hT_prop : ∀ x : T, EllipticRootNumber.IsPrimeToPRootOfUnity F x.1 :=
    fun x => hT_sub x.2
  choose n hn_pos hn_ndvd hn_pow using hT_prop
  let N : ℕ := ∏ x ∈ T.attach, n x
  have hN_pos : 0 < N := Finset.prod_pos (fun x _ => hn_pos x)
  haveI : NeZero N := ⟨hN_pos.ne'⟩
  have hp_prime : (EllipticRootNumber.p F).Prime :=
    CharP.char_is_prime (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      (EllipticRootNumber.p F)
  have hpN : ¬ (EllipticRootNumber.p F ∣ N) :=
    Prime.not_dvd_finset_prod (Nat.prime_iff.mp hp_prime) (fun x _ => hn_ndvd x)
  haveI : IsCyclic (rootsOfUnity N (AlgebraicClosure F)) :=
    rootsOfUnity.isCyclic (AlgebraicClosure F) N
  obtain ⟨gN, hgN⟩ := IsCyclic.exists_monoid_generator (α := rootsOfUnity N (AlgebraicClosure F))
  let ζ : AlgebraicClosure F := ((gN : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)
  have hζ_pow : ζ ^ N = 1 := by
    have h1 : (gN : (AlgebraicClosure F)ˣ) ^ N = 1 := (mem_rootsOfUnity N _).mp gN.2
    rw [← Units.val_pow_eq_pow_val, h1, Units.val_one]
  have h_sub : (T : Set (AlgebraicClosure F)) ⊆
      (IntermediateField.adjoin F ({ζ} : Set (AlgebraicClosure F)) : Set (AlgebraicClosure F)) := by
    intro y hy
    let x : T := ⟨y, hy⟩
    have hdvd : n x ∣ N := Finset.dvd_prod_of_mem n (Finset.mem_attach T x)
    obtain ⟨m, hm⟩ := hdvd
    have hyN : y ^ N = 1 := by
      rw [hm, pow_mul, hn_pow x, one_pow]
    have hy_ne : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hN_pos.ne'] at hyN
      exact zero_ne_one hyN
    let uy : (AlgebraicClosure F)ˣ := Units.mk0 y hy_ne
    have huy : uy ∈ rootsOfUnity N (AlgebraicClosure F) := by
      rw [mem_rootsOfUnity]
      ext
      exact hyN
    have h_mem_pow : (⟨uy, huy⟩ : rootsOfUnity N (AlgebraicClosure F)) ∈ Submonoid.powers gN :=
      hgN ⟨uy, huy⟩
    rw [Submonoid.mem_powers_iff] at h_mem_pow
    obtain ⟨r, hr⟩ := h_mem_pow
    have hy_eq : y = ζ ^ r := by
      have hr1 : (gN : (AlgebraicClosure F)ˣ) ^ r = uy := congrArg Subtype.val hr
      have hr2 := congrArg Units.val hr1
      rw [Units.val_pow_eq_pow_val] at hr2
      exact hr2.symm
    rw [hy_eq]
    exact pow_mem (IntermediateField.mem_adjoin_simple_self F ζ) r
  have hη_adj : η ∈ IntermediateField.adjoin F ({ζ} : Set (AlgebraicClosure F)) :=
    (IntermediateField.adjoin_le_iff.mpr h_sub) hη_T
  have hζ_int_A : IsIntegral ↥(ValuativeRel.valuation F).integer ζ :=
    ⟨Polynomial.X ^ N - 1,
      by simpa using Polynomial.monic_X_pow_sub_C (1 : ↥(ValuativeRel.valuation F).integer) hN_pos.ne',
      by simp [hζ_pow]⟩
  have hζ_int_F : IsIntegral F ζ :=
    ⟨Polynomial.X ^ N - 1, by simpa using Polynomial.monic_X_pow_sub_C (1 : F) hN_pos.ne',
      by simp [hζ_pow]⟩
  let P₀ : Polynomial ↥(ValuativeRel.valuation F).integer :=
    minpoly ↥(ValuativeRel.valuation F).integer ζ
  let P : Polynomial F := minpoly F ζ
  have hP₀_monic : P₀.Monic := minpoly.monic hζ_int_A
  have hP₀_deg : 1 ≤ P₀.natDegree := minpoly.natDegree_pos hζ_int_A
  have hP₀_dvd_aeval : ∀ R : Polynomial ↥(ValuativeRel.valuation F).integer,
      Polynomial.aeval ζ R = 0 → P₀ ∣ R :=
    fun R hR => minpoly.isIntegrallyClosed_dvd hζ_int_A hR
  have hP₀_dvd_XN : P₀ ∣ Polynomial.X ^ N - 1 :=
    hP₀_dvd_aeval (Polynomial.X ^ N - 1) (by simp [hζ_pow])
  have hP_eq : P = P₀.map (algebraMap ↥(ValuativeRel.valuation F).integer F) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' F hζ_int_A
  have hP_deg : P.natDegree = P₀.natDegree := by
    rw [hP_eq, hP₀_monic.natDegree_map]
  let pb := IntermediateField.adjoin.powerBasis hζ_int_F
  have hpb_dim : pb.dim = P₀.natDegree := by
    rw [IntermediateField.adjoin.powerBasis_dim hζ_int_F, hP_deg]
  have hpb_pos : 0 < pb.dim := by omega
  haveI : Nonempty (Fin pb.dim) := Fin.pos_iff_nonempty.mp hpb_pos
  let η₀ : IntermediateField.adjoin F ({ζ} : Set (AlgebraicClosure F)) := ⟨η, hη_adj⟩
  let f : Fin pb.dim → F := pb.basis.repr η₀
  have hη_sum : η = ∑ i : Fin pb.dim, algebraMap F (AlgebraicClosure F) (f i) * ζ ^ (i : ℕ) := by
    have h1 := congrArg Subtype.val (pb.basis.sum_repr η₀).symm
    rw [AddSubmonoidClass.coe_finset_sum] at h1
    refine h1.trans (Finset.sum_congr rfl fun i _ => ?_)
    rw [PowerBasis.basis_eq_pow, IntermediateField.adjoin.powerBasis_gen hζ_int_F, Algebra.smul_def]
    rfl
  obtain ⟨j₀, _, hj₀_max⟩ :=
    Finset.exists_max_image Finset.univ (fun i : Fin pb.dim => ValuativeRel.valuation F (f i))
      Finset.univ_nonempty
  let c : F := f j₀
  have hc_ne : c ≠ 0 := by
    intro hc0
    apply hη_ne
    rw [hη_sum]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hfi_le : ValuativeRel.valuation F (f i) ≤ ValuativeRel.valuation F c :=
      hj₀_max i (Finset.mem_univ i)
    rw [hc0, Valuation.map_zero, le_zero_iff, Valuation.zero_iff] at hfi_le
    rw [hfi_le, map_zero, zero_mul]
  let a : Fin pb.dim → ↥(ValuativeRel.valuation F).integer := fun i =>
    ⟨c⁻¹ * f i, by
      change ValuativeRel.valuation F (c⁻¹ * f i) ≤ 1
      rw [map_mul, map_inv₀]
      exact inv_mul_le_one_of_le₀ (hj₀_max i (Finset.mem_univ i)) zero_le'⟩
  have ha_j₀ : a j₀ = 1 := by
    ext
    exact inv_mul_cancel₀ hc_ne
  let Q : Polynomial ↥(ValuativeRel.valuation F).integer :=
    ∑ i : Fin pb.dim, Polynomial.monomial (i : ℕ) (a i)
  let i₀ : ℕ := (j₀ : ℕ)
  have hQ_coeff : Q.coeff i₀ = 1 := by
    rw [Polynomial.finset_sum_coeff]
    have h_ite : ∑ i : Fin pb.dim, (Polynomial.monomial (i : ℕ) (a i)).coeff (j₀ : ℕ) =
        ∑ i : Fin pb.dim, if i = j₀ then a i else 0 := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Polynomial.coeff_monomial]
      simp [Fin.ext_iff]
    rw [h_ite, Finset.sum_ite_eq' Finset.univ j₀ (fun i => a i), if_pos (Finset.mem_univ j₀), ha_j₀]
  have hQ_deg : Q.natDegree < P₀.natDegree := by
    suffices h_le : Q.natDegree ≤ P₀.natDegree - 1 by omega
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro m hm
    rw [Polynomial.finset_sum_coeff]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [Polynomial.coeff_monomial, if_neg]
    have hi : (i : ℕ) < pb.dim := i.2
    omega
  have hQ_aeval : Polynomial.aeval ζ Q = algebraMap F (AlgebraicClosure F) c⁻¹ * η := by
    rw [map_sum, hη_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Polynomial.aeval_monomial, ← mul_assoc, ← map_mul]
    rfl
  have hb_ne : c⁻¹ ^ k * π ≠ 0 := mul_ne_zero (pow_ne_zero k (inv_ne_zero hc_ne)) hπ_ne
  let iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hπ_nz : iso (ValuativeRel.valuation F π) ≠ 0 :=
    (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hπ_ne)
  have hπ_iso : iso (ValuativeRel.valuation F π) = WithZero.exp (-1 : ℤ) := by
    unfold EllipticRootNumber.addVal at hπ_val
    rw [dif_neg hπ_ne] at hπ_val
    have h1 : Multiplicative.toAdd (WithZero.unzero hπ_nz) = -1 := by omega
    rw [← WithZero.coe_unzero hπ_nz]
    change WithZero.exp (Multiplicative.toAdd (WithZero.unzero hπ_nz)) = WithZero.exp (-1 : ℤ)
    rw [h1]
  have hc_nz : iso (ValuativeRel.valuation F c) ≠ 0 :=
    (map_ne_zero iso).mpr ((Valuation.ne_zero_iff _).mpr hc_ne)
  let m : ℤ := Multiplicative.toAdd (WithZero.unzero hc_nz)
  have hc_iso : iso (ValuativeRel.valuation F c) = WithZero.exp m := by
    rw [← WithZero.coe_unzero hc_nz]
    rfl
  have hb_iso : iso (ValuativeRel.valuation F (c⁻¹ ^ k * π)) = WithZero.exp (-(k : ℤ) * m - 1) := by
    rw [map_mul, map_pow, map_inv₀, map_mul, map_pow, map_inv₀, hc_iso, hπ_iso,
      ← WithZero.exp_neg, ← WithZero.exp_nsmul, ← WithZero.exp_add]
    congr 1
    push_cast
    ring
  have h_ne_zero : -(k : ℤ) * m - 1 ≠ 0 := by
    rcases le_or_gt m 0 with hm | hm
    · rcases eq_or_lt_of_le hm with hm0 | hm'
      · rw [hm0]; omega
      · nlinarith
    · nlinarith
  have hb_dich : ValuativeRel.valuation F (c⁻¹ ^ k * π) < 1 ∨
      ValuativeRel.valuation F (c⁻¹ ^ k * π)⁻¹ < 1 := by
    rcases lt_or_gt_of_ne h_ne_zero with hlt | hgt
    · left
      rw [← map_lt_map_iff iso, hb_iso, map_one]
      exact WithZero.exp_lt_exp.mpr hlt
    · right
      have hbinv_iso : iso (ValuativeRel.valuation F (c⁻¹ ^ k * π)⁻¹) = WithZero.exp ((k : ℤ) * m + 1) := by
        rw [map_inv₀, map_inv₀, hb_iso, ← WithZero.exp_neg]
        congr 1
        ring
      rw [← map_lt_map_iff iso, hbinv_iso, map_one]
      exact WithZero.exp_lt_exp.mpr (by linarith)
  let res := IsLocalRing.residue ↥(ValuativeRel.valuation F).integer
  let P₀_bar : Polynomial (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) :=
    P₀.map res
  let Q_bar : Polynomial (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) :=
    Q.map res
  have hP₀_bar_deg : P₀_bar.natDegree = P₀.natDegree := hP₀_monic.natDegree_map res
  have hP₀_bar_dvd : P₀_bar ∣
      Polynomial.X ^ N - Polynomial.C (1 : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) := by
    have h := Polynomial.map_dvd res hP₀_dvd_XN
    simpa using h
  have hXN_sep :
      (Polynomial.X ^ N -
        Polynomial.C (1 : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)).Separable :=
    Polynomial.separable_X_pow_sub_C' (EllipticRootNumber.p F) N
      (1 : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) hpN one_ne_zero
  have hP₀_sqfree : Squarefree P₀_bar :=
    Squarefree.squarefree_of_dvd hP₀_bar_dvd hXN_sep.squarefree
  have hQk_aeval : Polynomial.aeval ζ (Q ^ k) =
      algebraMap F (AlgebraicClosure F) (c⁻¹ ^ k * π) := by
    rw [map_pow, hQ_aeval, mul_pow, h_eq, map_mul, map_pow]
  have h_mem_max : ∀ (x : ↥(ValuativeRel.valuation F).integer),
      ValuativeRel.valuation F (x : F) < 1 →
      x ∈ IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer := by
    intro x hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨u, rfl⟩
    have hu_inv : ValuativeRel.valuation F ((↑u⁻¹ : ↥(ValuativeRel.valuation F).integer) : F) ≤ 1 :=
      (↑u⁻¹ : ↥(ValuativeRel.valuation F).integer).2
    have h_mul : ValuativeRel.valuation F ((u : ↥(ValuativeRel.valuation F).integer) : F) *
        ValuativeRel.valuation F ((↑u⁻¹ : ↥(ValuativeRel.valuation F).integer) : F) = 1 := by
      rw [← map_mul]
      change ValuativeRel.valuation F (((u * u⁻¹ : (↥(ValuativeRel.valuation F).integer)ˣ) :
        ↥(ValuativeRel.valuation F).integer) : F) = 1
      rw [mul_inv_cancel, Units.val_one, Subring.coe_one, map_one]
    have h_lt : ValuativeRel.valuation F ((u : ↥(ValuativeRel.valuation F).integer) : F) *
        ValuativeRel.valuation F ((↑u⁻¹ : ↥(ValuativeRel.valuation F).integer) : F) < 1 :=
      calc ValuativeRel.valuation F ((u : ↥(ValuativeRel.valuation F).integer) : F) *
            ValuativeRel.valuation F ((↑u⁻¹ : ↥(ValuativeRel.valuation F).integer) : F)
        _ ≤ ValuativeRel.valuation F ((u : ↥(ValuativeRel.valuation F).integer) : F) * 1 :=
          mul_le_mul_left' hu_inv _
        _ = ValuativeRel.valuation F ((u : ↥(ValuativeRel.valuation F).integer) : F) := mul_one _
        _ < 1 := hx
    exact h_lt.ne h_mul
  rcases hb_dich with hb | hb'
  · let b₀ : ↥(ValuativeRel.valuation F).integer := ⟨c⁻¹ ^ k * π, le_of_lt hb⟩
    have hb₀_mem : b₀ ∈ IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer :=
      h_mem_max b₀ hb
    have hb₀_res : res b₀ = 0 := (IsLocalRing.residue_eq_zero_iff b₀).mpr hb₀_mem
    have h_dvd : P₀ ∣ Q ^ k - Polynomial.C b₀ := by
      apply hP₀_dvd_aeval
      rw [map_sub, hQk_aeval, Polynomial.aeval_C]
      exact sub_self _
    have h1_bar : P₀_bar ∣ Q_bar ^ k := by
      have h := Polynomial.map_dvd res h_dvd
      simpa [P₀_bar, Q_bar, hb₀_res] using h
    have hdvd_Q : P₀_bar ∣ Q_bar :=
      (Squarefree.dvd_pow_iff_dvd hP₀_sqfree (by omega : k ≠ 0)).mp h1_bar
    have hQ_bar_ne : Q_bar ≠ 0 := by
      intro hQ0
      have hc : Q_bar.coeff i₀ = 0 := by rw [hQ0, Polynomial.coeff_zero]
      rw [Polynomial.coeff_map, hQ_coeff, map_one] at hc
      exact one_ne_zero hc
    have hdeg1 : P₀_bar.natDegree ≤ Q_bar.natDegree :=
      Polynomial.natDegree_le_of_dvd hdvd_Q hQ_bar_ne
    have hdeg2 : Q_bar.natDegree ≤ Q.natDegree := Polynomial.natDegree_map_le
    omega
  · let b'₀ : ↥(ValuativeRel.valuation F).integer := ⟨(c⁻¹ ^ k * π)⁻¹, le_of_lt hb'⟩
    have hb'₀_mem : b'₀ ∈ IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer :=
      h_mem_max b'₀ hb'
    have hb'₀_res : res b'₀ = 0 := (IsLocalRing.residue_eq_zero_iff b'₀).mpr hb'₀_mem
    have h_dvd : P₀ ∣ Polynomial.C b'₀ * Q ^ k - 1 := by
      apply hP₀_dvd_aeval
      rw [map_sub, map_mul, Polynomial.aeval_C, hQk_aeval, map_one]
      have h_cancel : algebraMap ↥(ValuativeRel.valuation F).integer (AlgebraicClosure F) b'₀ *
          algebraMap F (AlgebraicClosure F) (c⁻¹ ^ k * π) = 1 := by
        change algebraMap F (AlgebraicClosure F) (c⁻¹ ^ k * π)⁻¹ *
          algebraMap F (AlgebraicClosure F) (c⁻¹ ^ k * π) = 1
        rw [← map_mul, inv_mul_cancel₀ hb_ne, map_one]
      rw [h_cancel, sub_self]
    have h2_bar : P₀_bar ∣ -1 := by
      have h := Polynomial.map_dvd res h_dvd
      simpa [P₀_bar, Q_bar, hb'₀_res] using h
    have hdeg : P₀_bar.natDegree ≤
        (-1 : Polynomial (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)).natDegree :=
      Polynomial.natDegree_le_of_dvd h2_bar (neg_ne_zero.mpr one_ne_zero)
    have hdeg_neg_one :
        (-1 : Polynomial (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)).natDegree = 0 := by
      simp
    omega

theorem kummer_extension_irreducible_and_inertia_aut (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (π ζ : F) (ϖ : AlgebraicClosure F)
    (hπ_ne : π ≠ 0)
    (hϖ_ne : ϖ ≠ 0)
    (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (h_no_root : ∀ k : ℕ, 2 ≤ k → ∀ η : AlgebraicClosure F,
      η ∈ EllipticRootNumber.unramifiedClosure F →
      η ^ k ≠ algebraMap F (AlgebraicClosure F) π) :
    Irreducible (Polynomial.X ^ (12 / Nat.gcd n 12) - Polynomial.C π) ∧
    ∃ τ₀ : EllipticRootNumber.relWeil F ⊥,
      (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ϖ = algebraMap F (AlgebraicClosure F) ζ * ϖ :=
by
  open ValuativeRel IntermediateField in
  have he : 12 / Nat.gcd n 12 = 2 ∨ 12 / Nat.gcd n 12 = 3 ∨
      12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6 := by
    interval_cases n <;> first | decide | omega
  set e := 12 / Nat.gcd n 12
  have he_pos : 0 < e := by rcases he with h | h | h | h <;> omega
  obtain ⟨ι, hι_sq⟩ :=
    IsAlgClosed.exists_pow_nat_eq (-1 : AlgebraicClosure F) (by decide : 0 < 2)
  have hι_pow4 : ι ^ 4 = 1 := by
    linear_combination (ι ^ 2 - 1) * hι_sq
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  obtain ⟨r, hp_prime, hcard⟩ := FiniteField.card 𝓀[F] (ringChar 𝓀[F])
  have hp : (EllipticRootNumber.p F).Prime := hp_prime
  have hq_eq : EllipticRootNumber.q F = (EllipticRootNumber.p F) ^ (r : ℕ) := by
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hcard]
  have h_not_dvd : ¬ (EllipticRootNumber.p F ∣ 4) := by
    intro hdvd
    have hdvd2 : EllipticRootNumber.p F ∣ 2 :=
      hp.dvd_of_dvd_pow (by simpa using hdvd : EllipticRootNumber.p F ∣ 2 ^ 2)
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd2 with h1 | hp2
    · exact hp.ne_one h1
    · apply hq2
      rw [hq_eq, hp2]
      exact dvd_pow_self 2 r.ne_zero
  have hι_prim : EllipticRootNumber.IsPrimeToPRootOfUnity F ι :=
    ⟨4, by decide, h_not_dvd, hι_pow4⟩
  let U := EllipticRootNumber.unramifiedClosure F
  have hι_mem : ι ∈ U :=
    IntermediateField.subset_adjoin F {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} hι_prim
  let i : ↥U := ⟨ι, hι_mem⟩
  have hi : i ^ 2 = -1 := Subtype.ext hι_sq
  let a : ↥U := algebraMap F ↥U π
  have ha_coe : algebraMap ↥U (AlgebraicClosure F) a = algebraMap F (AlgebraicClosure F) π :=
    (IsScalarTower.algebraMap_apply F ↥U (AlgebraicClosure F) π).symm
  have hϖ_pow_U : ϖ ^ e = algebraMap ↥U (AlgebraicClosure F) a := by
    rw [ha_coe]
    exact hϖ_pow
  have h_no_sq : ∀ b : ↥U, b ^ 2 ≠ a := by
    intro b hb
    apply h_no_root 2 (by decide) b.1 b.2
    have hb' := congrArg (algebraMap ↥U (AlgebraicClosure F)) hb
    simpa [map_pow, ha_coe] using hb'
  have h_no_cube : ∀ b : ↥U, b ^ 3 ≠ a := by
    intro b hb
    apply h_no_root 3 (by decide) b.1 b.2
    have hb' := congrArg (algebraMap ↥U (AlgebraicClosure F)) hb
    simpa [map_pow, ha_coe] using hb'
  have h_irr_gen : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (e : ℕ),
      (e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 6) → ∀ (a i : K), i ^ 2 = -1 →
      ∀ (ϖ : L), ϖ ^ e = algebraMap K L a →
      (∀ b : K, b ^ 2 ≠ a) → (∀ b : K, b ^ 3 ≠ a) →
      Irreducible (Polynomial.X ^ e - Polynomial.C a) := by
    clear! F n
    intro K L _ _ _ e he a i hi ϖ hϖ_pow_U h_no_sq h_no_cube
    have hP2_irr : Irreducible (Polynomial.X ^ 2 - Polynomial.C a) :=
      X_pow_sub_C_irreducible_of_prime Nat.prime_two h_no_sq
    have hP3_irr : Irreducible (Polynomial.X ^ 3 - Polynomial.C a) :=
      X_pow_sub_C_irreducible_of_prime Nat.prime_three h_no_cube
    have hP2_monic : (Polynomial.X ^ 2 - Polynomial.C a).Monic :=
      Polynomial.monic_X_pow_sub_C a (by decide)
    have hP3_monic : (Polynomial.X ^ 3 - Polynomial.C a).Monic :=
      Polynomial.monic_X_pow_sub_C a (by decide)
    have h_deg_dvd : ∀ (α : L) (Pα : Polynomial K),
        α ∈ K⟮ϖ⟯ → Pα.Monic → Irreducible Pα → Polynomial.aeval α Pα = 0 →
        IsIntegral K ϖ → Pα.natDegree ∣ (minpoly K ϖ).natDegree := by
      intro α Pα hα_mem hPα_monic hPα_irr hα_aeval hϖ_int
      have hα_int : IsIntegral K α := ⟨Pα, hPα_monic, hα_aeval⟩
      have h_mp_α : minpoly K α = Pα :=
        (minpoly.eq_of_irreducible_of_monic hPα_irr hα_aeval hPα_monic).symm
      have h_le : K⟮α⟯ ≤ K⟮ϖ⟯ := IntermediateField.adjoin_simple_le_iff.mpr hα_mem
      let E := IntermediateField.extendScalars h_le
      have h_mul := Module.finrank_mul_finrank K ↥K⟮α⟯ ↥E
      have hE_eq : Module.finrank K ↥E = Module.finrank K ↥K⟮ϖ⟯ := rfl
      rw [hE_eq, IntermediateField.adjoin.finrank hα_int, IntermediateField.adjoin.finrank hϖ_int,
        h_mp_α] at h_mul
      exact ⟨Module.finrank ↥K⟮α⟯ ↥E, h_mul.symm⟩
    rcases he with rfl | rfl | rfl | rfl
    · exact hP2_irr
    · exact hP3_irr
    · have hP4_monic : (Polynomial.X ^ 4 - Polynomial.C a).Monic :=
        Polynomial.monic_X_pow_sub_C a (by decide)
      have hP4_deg : (Polynomial.X ^ 4 - Polynomial.C a).natDegree = 4 :=
        Polynomial.natDegree_X_pow_sub_C (n := 4) (r := a)
      have hP4_aeval : Polynomial.aeval ϖ (Polynomial.X ^ 4 - Polynomial.C a) = 0 := by
        simp [hϖ_pow_U]
      have hϖ_int : IsIntegral K ϖ := ⟨Polynomial.X ^ 4 - Polynomial.C a, hP4_monic, hP4_aeval⟩
      have h_dvd : minpoly K ϖ ∣ Polynomial.X ^ 4 - Polynomial.C a :=
        minpoly.dvd K ϖ hP4_aeval
      have hd_pos : 0 < (minpoly K ϖ).natDegree := minpoly.natDegree_pos hϖ_int
      have hd_le : (minpoly K ϖ).natDegree ≤ 4 := by
        simpa [hP4_deg] using Polynomial.natDegree_le_of_dvd h_dvd hP4_monic.ne_zero
      have h_w2_mem : ϖ ^ 2 ∈ K⟮ϖ⟯ :=
        pow_mem (IntermediateField.mem_adjoin_simple_self K ϖ) 2
      have h_w2_aeval : Polynomial.aeval (ϖ ^ 2) (Polynomial.X ^ 2 - Polynomial.C a) = 0 := by
        simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        rw [← pow_mul, hϖ_pow_U, sub_self]
      have h2_dvd : 2 ∣ (minpoly K ϖ).natDegree := by
        have := h_deg_dvd (ϖ ^ 2) (Polynomial.X ^ 2 - Polynomial.C a)
          h_w2_mem hP2_monic hP2_irr h_w2_aeval hϖ_int
        simpa [Polynomial.natDegree_X_pow_sub_C] using this
      have hd_cases : (minpoly K ϖ).natDegree = 2 ∨ (minpoly K ϖ).natDegree = 4 := by omega
      rcases hd_cases with hd2 | hd4
      · exfalso
        set f := minpoly K ϖ
        set c₀ := f.coeff 0
        set c₁ := f.coeff 1
        have hf_monic : f.Monic := minpoly.monic hϖ_int
        have hf_coeff2 : f.coeff 2 = 1 := by
          rw [← hd2, Polynomial.coeff_natDegree, hf_monic.leadingCoeff]
        have hf_sum : f = ∑ j ∈ Finset.range 3, Polynomial.C (f.coeff j) * Polynomial.X ^ j := by
          simpa [Polynomial.C_mul_X_pow_eq_monomial] using
            Polynomial.as_sum_range' f 3 (by omega : f.natDegree < 3)
        have h_aeval := minpoly.aeval K ϖ
        change Polynomial.aeval ϖ f = 0 at h_aeval
        rw [hf_sum] at h_aeval
        simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, zero_add,
          pow_zero, mul_one, pow_one, hf_coeff2, map_one, one_mul, map_add, map_mul, map_pow,
          Polynomial.aeval_C, Polynomial.aeval_X] at h_aeval
        set x₀ := algebraMap K L c₀
        set x₁ := algebraMap K L c₁
        set x_a := algebraMap K L a
        have h1 : x₀ + x₁ * ϖ + ϖ ^ 2 = 0 := h_aeval
        have h_rel_L : (x₁ ^ 2 - 2 * x₀) ^ 2 * x_a = (x₀ ^ 2 + x_a) ^ 2 := by
          linear_combination
            ((x₁ ^ 2 - 2 * x₀) * ϖ ^ 2 + (x₀ ^ 2 + x_a)) * (x₁ * ϖ - x₀ - ϖ ^ 2) * h1 +
            ((x₁ ^ 2 - 2 * x₀) * ϖ ^ 2 + (x₀ ^ 2 + x_a) - (x₁ ^ 2 - 2 * x₀) ^ 2) * hϖ_pow_U
        have h_rel_map :
            algebraMap K L ((c₁ ^ 2 - 2 * c₀) ^ 2 * a) = algebraMap K L ((c₀ ^ 2 + a) ^ 2) := by
          simpa [x₀, x₁, x_a, map_ofNat] using h_rel_L
        have h_rel : (c₁ ^ 2 - 2 * c₀) ^ 2 * a = (c₀ ^ 2 + a) ^ 2 :=
          (algebraMap K L).injective h_rel_map
        by_cases hs : c₁ ^ 2 - 2 * c₀ = 0
        · have hc0 : c₀ ^ 2 + a = 0 := by
            rw [hs, zero_pow (by decide), zero_mul] at h_rel
            exact eq_zero_of_pow_eq_zero h_rel.symm
          have h_sq : (i * c₀) ^ 2 = a := by
            linear_combination c₀ ^ 2 * hi - hc0
          exact h_no_sq (i * c₀) h_sq
        · have h_sq : ((c₀ ^ 2 + a) / (c₁ ^ 2 - 2 * c₀)) ^ 2 = a := by
            rw [div_pow, ← h_rel, mul_div_cancel_left₀ a (pow_ne_zero 2 hs)]
          exact h_no_sq ((c₀ ^ 2 + a) / (c₁ ^ 2 - 2 * c₀)) h_sq
      · have h_eq : Polynomial.X ^ 4 - Polynomial.C a = minpoly K ϖ :=
          Polynomial.eq_of_monic_of_dvd_of_natDegree_le
            (minpoly.monic hϖ_int) hP4_monic h_dvd (by omega)
        rw [h_eq]
        exact minpoly.irreducible hϖ_int
    · have hP6_monic : (Polynomial.X ^ 6 - Polynomial.C a).Monic :=
        Polynomial.monic_X_pow_sub_C a (by decide)
      have hP6_deg : (Polynomial.X ^ 6 - Polynomial.C a).natDegree = 6 :=
        Polynomial.natDegree_X_pow_sub_C (n := 6) (r := a)
      have hP6_aeval : Polynomial.aeval ϖ (Polynomial.X ^ 6 - Polynomial.C a) = 0 := by
        simp [hϖ_pow_U]
      have hϖ_int : IsIntegral K ϖ := ⟨Polynomial.X ^ 6 - Polynomial.C a, hP6_monic, hP6_aeval⟩
      have h_dvd : minpoly K ϖ ∣ Polynomial.X ^ 6 - Polynomial.C a :=
        minpoly.dvd K ϖ hP6_aeval
      have hd_pos : 0 < (minpoly K ϖ).natDegree := minpoly.natDegree_pos hϖ_int
      have hd_le : (minpoly K ϖ).natDegree ≤ 6 := by
        simpa [hP6_deg] using Polynomial.natDegree_le_of_dvd h_dvd hP6_monic.ne_zero
      have h2_dvd : 2 ∣ (minpoly K ϖ).natDegree := by
        have h_w3_mem : ϖ ^ 3 ∈ K⟮ϖ⟯ :=
          pow_mem (IntermediateField.mem_adjoin_simple_self K ϖ) 3
        have h_w3_aeval : Polynomial.aeval (ϖ ^ 3) (Polynomial.X ^ 2 - Polynomial.C a) = 0 := by
          simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
          rw [← pow_mul, hϖ_pow_U, sub_self]
        have := h_deg_dvd (ϖ ^ 3) (Polynomial.X ^ 2 - Polynomial.C a)
          h_w3_mem hP2_monic hP2_irr h_w3_aeval hϖ_int
        simpa [Polynomial.natDegree_X_pow_sub_C] using this
      have h3_dvd : 3 ∣ (minpoly K ϖ).natDegree := by
        have h_w2_mem : ϖ ^ 2 ∈ K⟮ϖ⟯ :=
          pow_mem (IntermediateField.mem_adjoin_simple_self K ϖ) 2
        have h_w2_aeval : Polynomial.aeval (ϖ ^ 2) (Polynomial.X ^ 3 - Polynomial.C a) = 0 := by
          simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
          rw [← pow_mul, hϖ_pow_U, sub_self]
        have := h_deg_dvd (ϖ ^ 2) (Polynomial.X ^ 3 - Polynomial.C a)
          h_w2_mem hP3_monic hP3_irr h_w2_aeval hϖ_int
        simpa [Polynomial.natDegree_X_pow_sub_C] using this
      have hd6 : (minpoly K ϖ).natDegree = 6 := by omega
      have h_eq : Polynomial.X ^ 6 - Polynomial.C a = minpoly K ϖ :=
        Polynomial.eq_of_monic_of_dvd_of_natDegree_le
          (minpoly.monic hϖ_int) hP6_monic h_dvd (by omega)
      rw [h_eq]
      exact minpoly.irreducible hϖ_int
  have h_irr_U : Irreducible (Polynomial.X ^ e - Polynomial.C a) :=
    h_irr_gen ↥U (AlgebraicClosure F) e he a i hi ϖ hϖ_pow_U h_no_sq h_no_cube
  have h_irr : Irreducible (Polynomial.X ^ e - Polynomial.C π) := by
    apply Polynomial.Monic.irreducible_of_irreducible_map (algebraMap F ↥U)
      (Polynomial.X ^ e - Polynomial.C π) (Polynomial.monic_X_pow_sub_C π he_pos.ne')
    simpa [a] using h_irr_U
  let P_U : Polynomial ↥U := Polynomial.X ^ e - Polynomial.C a
  have hP_U_monic : P_U.Monic := Polynomial.monic_X_pow_sub_C a he_pos.ne'
  let ϖ' : AlgebraicClosure F := algebraMap F (AlgebraicClosure F) ζ * ϖ
  have h_aeval_ϖ : Polynomial.aeval ϖ P_U = 0 := by
    simp [P_U, hϖ_pow_U]
  have h_aeval_ϖ' : Polynomial.aeval ϖ' P_U = 0 := by
    simp only [P_U, ϖ', map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    rw [mul_pow, ← map_pow, hζ_pow, map_one, one_mul, hϖ_pow_U, sub_self]
  have hϖ_int_U : IsIntegral ↥U ϖ := ⟨P_U, hP_U_monic, h_aeval_ϖ⟩
  have hϖ_alg_U : IsAlgebraic ↥U ϖ := hϖ_int_U.isAlgebraic
  have h_mp : minpoly ↥U ϖ = minpoly ↥U ϖ' := by
    have h1 := minpoly.eq_of_irreducible_of_monic h_irr_U h_aeval_ϖ hP_U_monic
    have h2 := minpoly.eq_of_irreducible_of_monic h_irr_U h_aeval_ϖ' hP_U_monic
    exact h1.symm.trans h2
  let φ₀ := minpoly.algEquiv hϖ_alg_U h_mp
  haveI : Normal ↥U (AlgebraicClosure F) :=
    Normal.tower_top_of_normal F ↥U (AlgebraicClosure F)
  let σ_U : AlgebraicClosure F ≃ₐ[↥U] AlgebraicClosure F :=
    φ₀.liftNormal (AlgebraicClosure F)
  have hσ_U_ϖ : σ_U ϖ = ϖ' := by
    have h_comm := AlgEquiv.liftNormal_commutes φ₀ (AlgebraicClosure F)
      (IntermediateField.AdjoinSimple.gen ↥U ϖ)
    have h_app : φ₀ (IntermediateField.AdjoinSimple.gen ↥U ϖ) =
        IntermediateField.AdjoinSimple.gen ↥U ϖ' :=
      minpoly.algEquiv_apply hϖ_alg_U h_mp
    rw [h_app] at h_comm
    exact h_comm
  let σ₀ : EllipticRootNumber.AbsGal F := σ_U.restrictScalars F
  have hσ₀_in : σ₀ ∈ EllipticRootNumber.inertia F := by
    intro u
    exact σ_U.commutes u
  have hσ₀_frob : EllipticRootNumber.ActsAsFrobPow F σ₀ 0 := by
    intro ξ hξ
    have hξ_mem : ξ ∈ U :=
      IntermediateField.subset_adjoin F {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} hξ
    have hfix : σ₀ ξ = ξ := hσ₀_in ⟨ξ, hξ_mem⟩
    simp [hfix]
  have hσ₀_weil : σ₀ ∈ EllipticRootNumber.weilGroup F :=
    Subgroup.subset_closure ⟨0, hσ₀_frob⟩
  have hσ₀_bot : σ₀ ∈ (⊥ : IntermediateField F (AlgebraicClosure F)).fixingSubgroup := by
    intro x
    obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp x.2
    change σ₀ x.1 = x.1
    rw [← hc]
    exact σ₀.commutes c
  exact ⟨h_irr, ⟨σ₀, ⟨hσ₀_weil, hσ₀_bot⟩⟩, hσ₀_in, hσ_U_ϖ⟩

theorem kummer_extension_abelian_and_norm_spec (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (π ζ : F) (ϖ : AlgebraicClosure F)
    (hπ_ne : π ≠ 0) (hπ_val : EllipticRootNumber.addVal F π = 1)
    (hϖ_ne : ϖ ≠ 0)
    (hϖ_pow : ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π)
    (hζ_pow : ζ ^ (12 / Nat.gcd n 12) = 1)
    (hζ_ord : ∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 → ζ ^ d ≠ 1)
    (h_irr : Irreducible (Polynomial.X ^ (12 / Nat.gcd n 12) - Polynomial.C π)) :
    ∃ (M : IntermediateField F (AlgebraicClosure F)),
      ϖ ∈ M ∧
      FiniteDimensional F M ∧
      EllipticRootNumber.IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ∧
      (∀ σ : EllipticRootNumber.AbsGal F, σ ∈ M.fixingSubgroup ↔ σ ϖ = ϖ) ∧
      (∃ π_M : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
        (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
          Set.range (EllipticRootNumber.normLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))) ∧
      (∀ z : (⊥ : IntermediateField F (AlgebraicClosure F)),
        z ^ (12 / Nat.gcd n 12) ∈
          Set.range (EllipticRootNumber.normLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))) :=
by
  set e := 12 / Nat.gcd n 12
  have hn_cases : e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 6 := by
    change 12 / Nat.gcd n 12 = 2 ∨ 12 / Nat.gcd n 12 = 3 ∨
      12 / Nat.gcd n 12 = 4 ∨ 12 / Nat.gcd n 12 = 6
    rcases hn23 with h2 | h3 <;> interval_cases n <;> first | decide | omega
  have he_pos : 0 < e := by
    rcases hn_cases with he | he | he | he <;> omega
  let M : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.adjoin F ({ϖ} : Set (AlgebraicClosure F))
  let B : IntermediateField F (AlgebraicClosure F) := ⊥
  have hϖ_mem : ϖ ∈ M := IntermediateField.mem_adjoin_simple_self F ϖ
  
  have hP_monic : (Polynomial.X ^ e - Polynomial.C π).Monic :=
    Polynomial.monic_X_pow_sub_C π he_pos.ne'
  have hP_aeval : Polynomial.aeval ϖ (Polynomial.X ^ e - Polynomial.C π) = 0 := by
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hϖ_pow, sub_self]
  have hϖ_int : IsIntegral F ϖ := ⟨Polynomial.X ^ e - Polynomial.C π, hP_monic, hP_aeval⟩
  have hM_fin : FiniteDimensional F M := IntermediateField.adjoin.finiteDimensional hϖ_int
  
  have h_fix : ∀ σ : EllipticRootNumber.AbsGal F, σ ∈ M.fixingSubgroup ↔ σ ϖ = ϖ := by
    intro σ
    let Kσ : IntermediateField F (AlgebraicClosure F) :=
      { carrier := {x | σ x = x}
        mul_mem' := fun {a b} ha hb => by dsimp at *; rw [map_mul, ha, hb]
        one_mem' := map_one σ
        add_mem' := fun {a b} ha hb => by dsimp at *; rw [map_add, ha, hb]
        zero_mem' := map_zero σ
        inv_mem' := fun {a} ha => by dsimp at *; rw [map_inv₀, ha]
        algebraMap_mem' := σ.commutes }
    have h_le : M ≤ Kσ ↔ σ ϖ = ϖ := IntermediateField.adjoin_simple_le_iff
    rw [← h_le, IntermediateField.mem_fixingSubgroup_iff]
    rfl
  have h_cubic : ∀ (ω : F) (v : AlgebraicClosure F),
      ω ^ 3 = 1 → ω ≠ 1 → v ^ 3 = 1 → ∃ c : F, v = algebraMap F (AlgebraicClosure F) c := by
    intro ω v hω3 hω1 hv3
    have hω_cyc : ω ^ 2 + ω + 1 = 0 := by
      have h_fac : (ω - 1) * (ω ^ 2 + ω + 1) = 0 := by linear_combination hω3
      rcases mul_eq_zero.mp h_fac with h1 | h2
      · exact absurd (sub_eq_zero.mp h1) hω1
      · exact h2
    let ωbar := algebraMap F (AlgebraicClosure F) ω
    have hωbar_cyc : ωbar ^ 2 + ωbar + 1 = 0 := by
      have := congr_arg (algebraMap F (AlgebraicClosure F)) hω_cyc
      simpa [ωbar, map_add, map_pow, map_one, map_zero] using this
    have hv_fac : (v - 1) * (v - ωbar) * (v - ωbar ^ 2) = 0 := by
      calc (v - 1) * (v - ωbar) * (v - ωbar ^ 2)
        _ = (v ^ 3 - 1) + (-v ^ 2 + ωbar * (v - 1) + 1) * (ωbar ^ 2 + ωbar + 1) := by ring
        _ = 0 := by rw [hv3, hωbar_cyc]; ring
    rcases mul_eq_zero.mp hv_fac with h12 | h3
    · rcases mul_eq_zero.mp h12 with h1 | h2
      · exact ⟨1, by rw [map_one, sub_eq_zero.mp h1]⟩
      · exact ⟨ω, sub_eq_zero.mp h2⟩
    · exact ⟨ω ^ 2, by rw [map_pow]; exact sub_eq_zero.mp h3⟩
  have h_scalar : ∀ σ : EllipticRootNumber.AbsGal F,
      ∃ c : F, σ ϖ = algebraMap F (AlgebraicClosure F) c * ϖ := by
    intro σ
    let u := σ ϖ / ϖ
    have hu_mul : σ ϖ = u * ϖ := (div_mul_cancel₀ (σ ϖ) hϖ_ne).symm
    have hu_pow : u ^ e = 1 := by
      dsimp [u]
      rw [div_pow, ← map_pow, hϖ_pow, σ.commutes, ← hϖ_pow, div_self (pow_ne_zero _ hϖ_ne)]
    suffices h_u : ∃ c : F, u = algebraMap F (AlgebraicClosure F) c by
      obtain ⟨c, hc⟩ := h_u
      exact ⟨c, by rw [hu_mul, hc]⟩
    rcases hn_cases with he | he | he | he
    · rw [he] at hu_pow
      have h_fac : (u - 1) * (u + 1) = 0 := by linear_combination hu_pow
      rcases mul_eq_zero.mp h_fac with h1 | h2
      · exact ⟨1, by rw [map_one, sub_eq_zero.mp h1]⟩
      · exact ⟨-1, by rw [map_neg, map_one, add_eq_zero_iff_eq_neg.mp h2]⟩
    · rw [he] at hu_pow hζ_pow hζ_ord
      exact h_cubic ζ u hζ_pow (by simpa using hζ_ord 1 (by decide) (by decide)) hu_pow
    · rw [he] at hu_pow hζ_pow hζ_ord
      have hζ2_ne : ζ ^ 2 ≠ 1 := hζ_ord 2 (by decide) (by decide)
      have hζ2_cyc : ζ ^ 2 + 1 = 0 := by
        have h_fac : (ζ ^ 2 - 1) * (ζ ^ 2 + 1) = 0 := by linear_combination hζ_pow
        rcases mul_eq_zero.mp h_fac with h1 | h2
        · exact absurd (sub_eq_zero.mp h1) hζ2_ne
        · exact h2
      let ζbar := algebraMap F (AlgebraicClosure F) ζ
      have hζbar2 : ζbar ^ 2 + 1 = 0 := by
        have := congr_arg (algebraMap F (AlgebraicClosure F)) hζ2_cyc
        simpa [ζbar, map_add, map_pow, map_one, map_zero] using this
      have hu_fac : (u - 1) * (u + 1) * (u - ζbar) * (u + ζbar) = 0 := by
        calc (u - 1) * (u + 1) * (u - ζbar) * (u + ζbar)
          _ = (u ^ 4 - 1) - (u ^ 2 - 1) * (ζbar ^ 2 + 1) := by ring
          _ = 0 := by rw [hu_pow, hζbar2]; ring
      rcases mul_eq_zero.mp hu_fac with h123 | h4
      · rcases mul_eq_zero.mp h123 with h12 | h3
        · rcases mul_eq_zero.mp h12 with h1 | h2
          · exact ⟨1, by rw [map_one, sub_eq_zero.mp h1]⟩
          · exact ⟨-1, by rw [map_neg, map_one, add_eq_zero_iff_eq_neg.mp h2]⟩
        · exact ⟨ζ, sub_eq_zero.mp h3⟩
      · exact ⟨-ζ, by rw [map_neg, add_eq_zero_iff_eq_neg.mp h4]⟩
    · rw [he] at hu_pow hζ_pow hζ_ord
      have hω3 : (ζ ^ 2) ^ 3 = 1 := by linear_combination hζ_pow
      have hω1 : ζ ^ 2 ≠ 1 := hζ_ord 2 (by decide) (by decide)
      have hu_split : (u ^ 3 - 1) * ((-u) ^ 3 - 1) = 0 := by linear_combination -hu_pow
      rcases mul_eq_zero.mp hu_split with h1 | h2
      · exact h_cubic (ζ ^ 2) u hω3 hω1 (sub_eq_zero.mp h1)
      · obtain ⟨c, hc⟩ := h_cubic (ζ ^ 2) (-u) hω3 hω1 (sub_eq_zero.mp h2)
        exact ⟨-c, by rw [map_neg, ← hc, neg_neg]⟩
  have h_comm : ∀ σ τ : EllipticRootNumber.AbsGal F, σ (τ ϖ) = τ (σ ϖ) := by
    intro σ τ
    obtain ⟨cσ, hcσ⟩ := h_scalar σ
    obtain ⟨cτ, hcτ⟩ := h_scalar τ
    calc σ (τ ϖ)
      _ = σ (algebraMap F (AlgebraicClosure F) cτ * ϖ) := by rw [hcτ]
      _ = algebraMap F (AlgebraicClosure F) cτ * (algebraMap F (AlgebraicClosure F) cσ * ϖ) := by
        rw [map_mul, σ.commutes, hcσ]
      _ = algebraMap F (AlgebraicClosure F) cσ * (algebraMap F (AlgebraicClosure F) cτ * ϖ) := by
        ring
      _ = τ (σ ϖ) := by rw [hcσ, map_mul, τ.commutes, hcτ]
  
  have h2_of_ord2 : ∀ ω : F, ω ^ 2 = 1 → ω ≠ 1 → (2 : F) ≠ 0 := by
    intro ω hω2 hω1 h2
    have h_fac : (ω - 1) * (ω + 1) = 0 := by linear_combination hω2
    rcases mul_eq_zero.mp h_fac with h1 | h1
    · exact hω1 (sub_eq_zero.mp h1)
    · have : ω - 1 = 0 := by linear_combination h1 - h2
      exact hω1 (sub_eq_zero.mp this)
  have h3_of_ord3 : ∀ ω : F, ω ^ 3 = 1 → ω ≠ 1 → (3 : F) ≠ 0 := by
    intro ω hω3 hω1 h3
    have h_fac : (ω - 1) * (ω ^ 2 + ω + 1) = 0 := by linear_combination hω3
    rcases mul_eq_zero.mp h_fac with h1 | h1
    · exact hω1 (sub_eq_zero.mp h1)
    · have h_sq : (ω - 1) ^ 2 = 0 := by linear_combination h1 - ω * h3
      exact hω1 (sub_eq_zero.mp (eq_zero_of_pow_eq_zero h_sq))
  have he_ne_F : (e : F) ≠ 0 := by
    rcases hn_cases with he | he | he | he
    · rw [he] at hζ_pow hζ_ord ⊢
      exact_mod_cast h2_of_ord2 ζ hζ_pow (by simpa using hζ_ord 1 (by decide) (by decide))
    · rw [he] at hζ_pow hζ_ord ⊢
      exact_mod_cast h3_of_ord3 ζ hζ_pow (by simpa using hζ_ord 1 (by decide) (by decide))
    · rw [he] at hζ_pow hζ_ord ⊢
      have h2 := h2_of_ord2 (ζ ^ 2) (by linear_combination hζ_pow) (hζ_ord 2 (by decide) (by decide))
      have : ((4 : ℕ) : F) = (2 : F) * (2 : F) := by norm_num
      rw [this]
      exact mul_ne_zero h2 h2
    · rw [he] at hζ_pow hζ_ord ⊢
      have h2 := h2_of_ord2 (ζ ^ 3) (by linear_combination hζ_pow) (hζ_ord 3 (by decide) (by decide))
      have h3 := h3_of_ord3 (ζ ^ 2) (by linear_combination hζ_pow) (hζ_ord 2 (by decide) (by decide))
      have : ((6 : ℕ) : F) = (2 : F) * (3 : F) := by norm_num
      rw [this]
      exact mul_ne_zero h2 h3
  let π_bot : B := algebraMap F B π
  have he_ne_B : (e : B) ≠ 0 := by
    have : (e : B) = algebraMap F B (e : F) := (map_natCast (algebraMap F B) e).symm
    rw [this]
    exact (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr he_ne_F
  have hπ_bot_ne : π_bot ≠ 0 :=
    (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr hπ_ne
  have hP_bot_sep : (Polynomial.X ^ e - Polynomial.C π_bot).Separable :=
    Polynomial.separable_X_pow_sub_C π_bot he_ne_B hπ_bot_ne
  have hP_bot_aeval : Polynomial.aeval ϖ (Polynomial.X ^ e - Polynomial.C π_bot) = 0 := by
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    have : algebraMap B (AlgebraicClosure F) π_bot = algebraMap F (AlgebraicClosure F) π :=
      (IsScalarTower.algebraMap_apply F B (AlgebraicClosure F) π).symm
    rw [this, hϖ_pow, sub_self]
  have hϖ_sep : IsSeparable B ϖ :=
    Polynomial.Separable.of_dvd hP_bot_sep (minpoly.dvd B ϖ hP_bot_aeval)
  have hM_sep : Algebra.IsSeparable B (IntermediateField.extendScalars (bot_le : B ≤ M)) := by
    rw [IntermediateField.extendScalars_adjoin]
    exact (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable B (AlgebraicClosure F)).mpr hϖ_sep
  have hM_ab : EllipticRootNumber.IsAbelianExt F (bot_le : B ≤ M) := by
    refine ⟨?_, ?_, hM_sep⟩
    · intro σ _ τ hτ
      rw [h_fix] at hτ ⊢
      change σ (τ (σ⁻¹ ϖ)) = ϖ
      rw [h_comm τ σ⁻¹, hτ]
      change (σ * σ⁻¹) ϖ = ϖ
      rw [mul_inv_cancel, AlgEquiv.one_apply]
    · intro σ _ τ _
      rw [h_fix]
      change σ (τ (σ⁻¹ (τ⁻¹ ϖ))) = ϖ
      rw [h_comm σ⁻¹ τ⁻¹]
      change σ ((τ * τ⁻¹) (σ⁻¹ ϖ)) = ϖ
      rw [mul_inv_cancel, AlgEquiv.one_apply]
      change (σ * σ⁻¹) ϖ = ϖ
      rw [mul_inv_cancel, AlgEquiv.one_apply]
  
  let e₁ : B ≃+* F := (IntermediateField.botEquiv F (AlgebraicClosure F)).toRingEquiv
  let e₂ : (IntermediateField.extendScalars (bot_le : B ≤ M)) ≃+* M :=
    { toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars (bot_le : B ≤ M)).mp y.2⟩
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars (bot_le : B ≤ M)).mpr y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }
  have h_comm_norm : (algebraMap F M).comp (e₁ : B →+* F) =
      (e₂ : IntermediateField.extendScalars (bot_le : B ≤ M) →+* M).comp
        (algebraMap B (IntermediateField.extendScalars (bot_le : B ≤ M))) := by
    ext x
    have hx : (IntermediateField.botEquiv F (AlgebraicClosure F)).symm (e₁ x) = x :=
      (IntermediateField.botEquiv F (AlgebraicClosure F)).symm_apply_apply x
    rw [IntermediateField.botEquiv_symm] at hx
    exact congr_arg (Subtype.val : B → AlgebraicClosure F) hx
  have h_normLM : ∀ y : M,
      EllipticRootNumber.normLM F (bot_le : B ≤ M) y = algebraMap F B (Algebra.norm F y) := by
    intro y
    change Algebra.norm B (EllipticRootNumber.toExtendScalars F (bot_le : B ≤ M) y) = _
    have h_eq := Algebra.norm_eq_of_equiv_equiv e₁ e₂ h_comm_norm
      (EllipticRootNumber.toExtendScalars F (bot_le : B ≤ M) y)
    rw [h_eq]
    rfl
  have h_mp : minpoly F ϖ = Polynomial.X ^ e - Polynomial.C π :=
    (minpoly.eq_of_irreducible_of_monic h_irr hP_aeval hP_monic).symm
  let pb : PowerBasis F M := IntermediateField.adjoin.powerBasis hϖ_int
  have h_pb_dim : pb.dim = e := by
    rw [IntermediateField.adjoin.powerBasis_dim hϖ_int, h_mp,
      Polynomial.natDegree_X_pow_sub_C]
  have h_pb_mp : minpoly F pb.gen = Polynomial.X ^ e - Polynomial.C π := by
    rw [IntermediateField.adjoin.powerBasis_gen hϖ_int, IntermediateField.minpoly_gen F ϖ, h_mp]
  have h_norm_gen : Algebra.norm F pb.gen = (-1 : F) ^ e * (-π) := by
    rw [Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, h_pb_dim, h_pb_mp,
      Polynomial.coeff_sub, Polynomial.coeff_X_pow, if_neg he_pos.ne,
      Polynomial.coeff_C_zero, zero_sub]
  have h_norm_pow : ∀ z : B,
      z ^ e ∈ Set.range (EllipticRootNumber.normLM F (bot_le : B ≤ M)) := by
    intro z
    let a : F := IntermediateField.botEquiv F (AlgebraicClosure F) z
    have ha : algebraMap F B a = z := by
      rw [← IntermediateField.botEquiv_symm]
      exact (IntermediateField.botEquiv F (AlgebraicClosure F)).symm_apply_apply z
    refine ⟨algebraMap F M a, ?_⟩
    rw [h_normLM, Algebra.norm_algebraMap, PowerBasis.finrank pb, h_pb_dim, map_pow, ha]
  
  let π_F : F := (-1 : F) ^ e * (-π)
  have hπ_F_ne : π_F ≠ 0 :=
    mul_ne_zero (pow_ne_zero e (neg_ne_zero.mpr one_ne_zero)) (neg_ne_zero.mpr hπ_ne)
  have hπ_F_val_eq : ValuativeRel.valuation F π_F = ValuativeRel.valuation F π := by
    dsimp [π_F]
    rw [Valuation.map_mul, Valuation.map_pow, Valuation.map_neg, Valuation.map_one,
      one_pow, one_mul, Valuation.map_neg]
  have h_addVal_eq : ∀ a b : F, a ≠ 0 → b ≠ 0 →
      ValuativeRel.valuation F a = ValuativeRel.valuation F b →
      EllipticRootNumber.addVal F a = EllipticRootNumber.addVal F b := by
    intro a b ha hb hv
    unfold EllipticRootNumber.addVal
    rw [dif_neg ha, dif_neg hb]
    simp only [hv]
  have hπ_F_addVal : EllipticRootNumber.addVal F π_F = 1 := by
    rw [h_addVal_eq π_F π hπ_F_ne hπ_ne hπ_F_val_eq, hπ_val]
  have h_relVal : ∀ x : B,
      EllipticRootNumber.relVal F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    rw [← Algebra.norm_eq_of_algEquiv (IntermediateField.botEquiv F (AlgebraicClosure F)) x,
      Algebra.norm_self]
    rfl
  have h_resDeg : EllipticRootNumber.resDeg F ⊥ = 1 := by
    unfold EllipticRootNumber.resDeg
    have h1_mem : 1 ∈ {k : ℕ | 0 < k ∧ ∃ x : B, x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} := by
      refine ⟨zero_lt_one, algebraMap F B π,
        (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr hπ_ne, ?_⟩
      rw [h_relVal]
      have : IntermediateField.botEquiv F (AlgebraicClosure F) (algebraMap F B π) = π := by
        rw [← IntermediateField.botEquiv_symm]
        exact (IntermediateField.botEquiv F (AlgebraicClosure F)).apply_symm_apply π
      rw [this, hπ_val, Nat.cast_one]
    exact le_antisymm (Nat.sInf_le h1_mem) (le_csInf ⟨1, h1_mem⟩ (fun k hk => hk.1))
  let x_M : B := algebraMap F B π_F
  have hx_M_ne : x_M ≠ 0 :=
    (map_ne_zero_iff (algebraMap F B) (RingHom.injective (algebraMap F B))).mpr hπ_F_ne
  let π_M : Bˣ := Units.mk0 x_M hx_M_ne
  have hπ_M_val : EllipticRootNumber.valL F ⊥ (π_M : B) = 1 := by
    unfold EllipticRootNumber.valL
    rw [h_resDeg, Nat.cast_one, EuclideanDomain.div_one, Units.val_mk0, h_relVal]
    have : IntermediateField.botEquiv F (AlgebraicClosure F) x_M = π_F := by
      dsimp [x_M]
      rw [← IntermediateField.botEquiv_symm]
      exact (IntermediateField.botEquiv F (AlgebraicClosure F)).apply_symm_apply π_F
    rw [this, hπ_F_addVal]
  have hπ_M_range : (π_M : B) ∈ Set.range (EllipticRootNumber.normLM F (bot_le : B ≤ M)) := by
    refine ⟨pb.gen, ?_⟩
    rw [h_normLM, h_norm_gen]
    rfl
  exact ⟨M, hϖ_mem, hM_fin, hM_ab, h_fix, ⟨π_M, hπ_M_val, hπ_M_range⟩, h_norm_pow⟩

theorem exists_tame_kummer_extension (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (n : ℕ) (hn0 : 0 < n) (hn12 : n < 12) (hn23 : 2 ∣ n ∨ 3 ∣ n)
    (hq2 : ¬ (2 ∣ EllipticRootNumber.q F))
    (hq3 : ¬ (3 ∣ EllipticRootNumber.q F))
    (hab : (12 / Nat.gcd n 12) ∣ (EllipticRootNumber.q F - 1)) :
    ∃ (π : F) (ϖ : AlgebraicClosure F) (M : IntermediateField F (AlgebraicClosure F))
      (τ₀ : EllipticRootNumber.relWeil F ⊥) (ζ : F),
      π ≠ 0 ∧
      EllipticRootNumber.addVal F π = 1 ∧
      ϖ ≠ 0 ∧
      ϖ ^ (12 / Nat.gcd n 12) = algebraMap F (AlgebraicClosure F) π ∧
      ϖ ∈ M ∧
      FiniteDimensional F M ∧
      EllipticRootNumber.IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ∧
      (∀ σ : EllipticRootNumber.AbsGal F, σ ∈ M.fixingSubgroup ↔ σ ϖ = ϖ) ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F ∧
      ζ ^ (12 / Nat.gcd n 12) = 1 ∧
      (∀ d : ℕ, d ∣ (12 / Nat.gcd n 12) → d < 12 / Nat.gcd n 12 → ζ ^ d ≠ 1) ∧
      (τ₀ : EllipticRootNumber.AbsGal F) ϖ = algebraMap F (AlgebraicClosure F) ζ * ϖ ∧
      (∃ π_M : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.valL F ⊥ (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∧
        (π_M : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
          Set.range (EllipticRootNumber.normLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))) ∧
      (∀ u ∈ EllipticRootNumber.unitGroup F ⊥ 1,
        EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
        (u : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈
          Set.range (EllipticRootNumber.normLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))) :=
by
  have he_pos : 0 < 12 / Nat.gcd n 12 := by
    interval_cases n <;> decide
  obtain ⟨π, ζ, hπ_ne, hπ_val, hζ_pow, hζ_ord, hU₁_pow⟩ :=
    local_field_hensel_and_primitive_root_of_unity F n hn0 hn12 hn23 hq2 hq3 hab
  obtain ⟨ϖ, hϖ_pow⟩ :=
    IsAlgClosed.exists_pow_nat_eq (algebraMap F (AlgebraicClosure F) π) he_pos
  have hϖ_ne : ϖ ≠ 0 := by
    rintro rfl
    rw [zero_pow he_pos.ne'] at hϖ_pow
    exact hπ_ne ((map_eq_zero_iff (algebraMap F (AlgebraicClosure F))
      (RingHom.injective (algebraMap F (AlgebraicClosure F)))).mp hϖ_pow.symm)
  obtain ⟨h_irr, τ₀, hτ₀_in, hτ₀_ϖ⟩ :=
    kummer_extension_irreducible_and_inertia_aut F n hn0 hn12 hn23 hq2 hq3 π ζ ϖ
      hπ_ne hϖ_ne hϖ_pow hζ_pow (unramifiedClosure_no_root_of_uniformizer F π hπ_ne hπ_val)
  obtain ⟨M, hϖ_mem, hM_fin, hM_ab, hM_fix, hπ_M, h_norm_pow⟩ :=
    kummer_extension_abelian_and_norm_spec F n hn0 hn12 hn23 hq2 hq3 π ζ ϖ
      hπ_ne hπ_val hϖ_ne hϖ_pow hζ_pow hζ_ord h_irr
  refine ⟨π, ϖ, M, τ₀, ζ, hπ_ne, hπ_val, hϖ_ne, hϖ_pow, hϖ_mem, hM_fin, hM_ab, hM_fix,
    hτ₀_in, hζ_pow, hζ_ord, hτ₀_ϖ, hπ_M, ?_⟩
  intro u hu
  obtain ⟨hu_val, z, hz_pow⟩ := hU₁_pow u hu
  refine ⟨hu_val, ?_⟩
  rw [← hz_pow]
  exact h_norm_pow z

theorem vBar_finrank_eq_two_of_nsmul_surjective_and_torsion_card (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F)
    (h_surj : ∀ Q : EllipticRootNumber.Pts F E,
      ∃ P : EllipticRootNumber.Pts F E, EllipticRootNumber.ell F • P = Q)
    (h_card : Nat.card (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) =
      EllipticRootNumber.ell F ^ 2) :
    Module.finrank (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) = 2 :=
by
  obtain rfl : ‹DecidableEq (AlgebraicClosure F)› =
      (fun a b => Classical.propDecidable (a = b)) :=
    Subsingleton.elim _ _
  classical
  set ℓ := EllipticRootNumber.ell F
  set T := EllipticRootNumber.tateModule F E
  set M₀ := EllipticRootNumber.torsion F E (ℓ ^ (0 + 1))
  haveI : Fact ℓ.Prime := EllipticRootNumber.ell_prime F
  have hℓ_ne : ℓ ≠ 0 := (EllipticRootNumber.ell_prime F).out.ne_zero
  
  have h_div : ∀ y : T, y.1 0 = 0 → ∃ z : T, y = (ℓ : ℤ_[ℓ]) • z := by
    intro y hy0
    have h_mem : ∀ n : ℕ, (y.1 (n + 1) : EllipticRootNumber.Pts F E) ∈
        EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) := by
      intro n
      rw [EllipticRootNumber.mem_torsion]
      induction n with
      | zero =>
        rw [Nat.zero_add, pow_one, y.2 0, hy0]
        rfl
      | succ k ih =>
        rw [pow_succ', mul_nsmul, y.2 (k + 1), ih]
    let z₀ : ∀ n : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) :=
      fun n => ⟨(y.1 (n + 1) : EllipticRootNumber.Pts F E), h_mem n⟩
    have hz : z₀ ∈ T := fun n => y.2 (n + 1)
    refine ⟨⟨z₀, hz⟩, ?_⟩
    apply Subtype.ext
    funext n
    apply Subtype.ext
    rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      map_natCast, ZMod.val_natCast]
    have h_mod := EllipticRootNumber.nsmul_eq_of_modEq F E
      ((EllipticRootNumber.mem_torsion F E).mp (h_mem n))
      (Nat.mod_modEq ℓ (ℓ ^ (n + 1)))
    change (y.1 n : EllipticRootNumber.Pts F E) =
      (ℓ % ℓ ^ (n + 1)) • (y.1 (n + 1) : EllipticRootNumber.Pts F E)
    rw [h_mod, y.2 n]
  
  have h_card_ne : Nat.card M₀ ≠ 0 := by
    rw [h_card]
    exact pow_ne_zero 2 hℓ_ne
  haveI : Finite M₀ := Nat.finite_of_card_ne_zero h_card_ne
  letI : Fintype M₀ := Fintype.ofFinite M₀
  let b : M₀ → T := fun m =>
    if h : ∃ v : T, v.1 0 = m then Classical.choose h else 0
  have hb : ∀ w : T, (b (w.1 0)).1 0 = w.1 0 := by
    intro w
    have hex : ∃ v : T, v.1 0 = w.1 0 := ⟨w, rfl⟩
    dsimp [b]
    rw [dif_pos hex]
    exact Classical.choose_spec hex
  have h_step : ∀ w : T, ∃ w' : T, w = b (w.1 0) + (ℓ : ℤ_[ℓ]) • w' := by
    intro w
    have h0 : (w - b (w.1 0)).1 0 = 0 := by
      change w.1 0 - (b (w.1 0)).1 0 = 0
      rw [hb w, sub_self]
    obtain ⟨w', hw'⟩ := h_div (w - b (w.1 0)) h0
    exact ⟨w', sub_eq_iff_eq_add'.mp hw'⟩
  let next : T → T := fun w => Classical.choose (h_step w)
  have h_next : ∀ w : T, w = b (w.1 0) + (ℓ : ℤ_[ℓ]) • next w :=
    fun w => Classical.choose_spec (h_step w)
  have h_fin_gen : Function.Surjective (Fintype.linearCombination ℤ_[ℓ] b) := by
    intro x
    let z : ℕ → T := fun k => Nat.rec x (fun _ w => next w) k
    have hz0 : z 0 = x := rfl
    have hzs : ∀ k : ℕ, z (k + 1) = next (z k) := fun _ => rfl
    have h_tel : ∀ N : ℕ,
        x = ∑ k ∈ Finset.range N, ((ℓ : ℤ_[ℓ]) ^ k) • b ((z k).1 0) +
          ((ℓ : ℤ_[ℓ]) ^ N) • z N := by
      intro N
      induction N with
      | zero =>
        simp [hz0]
      | succ N ih =>
        rw [Finset.sum_range_succ, add_assoc]
        conv_lhs => rw [ih]
        congr 1
        rw [hzs N, pow_succ, mul_smul, ← smul_add, ← h_next (z N)]
    let δ : M₀ → ℕ → ℤ := fun m k => if (z k).1 0 = m then 1 else 0
    let f : M₀ → ℕ → ℤ := fun m N => ∑ k ∈ Finset.range N, δ m k * (ℓ : ℤ) ^ k
    have h_exp : ∀ N : ℕ,
        x = ∑ m : M₀, (f m N : ℤ_[ℓ]) • b m + ((ℓ : ℤ_[ℓ]) ^ N) • z N := by
      intro N
      rw [h_tel N]
      congr 1
      have h_term : ∀ k : ℕ,
          ((ℓ : ℤ_[ℓ]) ^ k) • b ((z k).1 0) =
            ∑ m : M₀, ((δ m k * (ℓ : ℤ) ^ k : ℤ) : ℤ_[ℓ]) • b m := by
        intro k
        symm
        rw [Finset.sum_eq_single ((z k).1 0)]
        · dsimp [δ]
          rw [if_pos rfl, one_mul, Int.cast_pow, Int.cast_natCast]
        · intro m _ hm
          dsimp [δ]
          rw [if_neg hm.symm, zero_mul, Int.cast_zero, zero_smul]
        · intro h_abs
          exact absurd (Finset.mem_univ _) h_abs
      simp_rw [h_term]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro m _
      dsimp [f]
      rw [Int.cast_sum, Finset.sum_smul]
    have hf_dvd : ∀ (m : M₀) (i : ℕ), (ℓ : ℤ) ^ i ∣ f m (i + 1) - f m i := by
      intro m i
      dsimp [f]
      rw [Finset.sum_range_succ, add_sub_cancel_left]
      exact ⟨δ m i, mul_comm _ _⟩
    let a : M₀ → ℤ_[ℓ] := fun m =>
      PadicInt.ofIntSeq (f m) (PadicInt.isCauSeq_padicNorm_of_pow_dvd_sub (f m) ℓ (hf_dvd m))
    refine ⟨a, ?_⟩
    rw [Fintype.linearCombination_apply]
    apply Subtype.ext
    funext n
    have hx_n : x.1 n = (∑ m : M₀, ((f m (n + 1) : ℤ_[ℓ]) • b m).1 n) +
        (((ℓ : ℤ_[ℓ]) ^ (n + 1)) • z (n + 1)).1 n := by
      conv_lhs => rw [h_exp (n + 1)]
      rw [Submodule.coe_add, Pi.add_apply, Submodule.coe_sum, Finset.sum_apply]
    rw [Submodule.coe_sum, Finset.sum_apply, hx_n]
    have h_rem_zero : (((ℓ : ℤ_[ℓ]) ^ (n + 1)) • z (n + 1)).1 n = 0 := by
      apply Subtype.ext
      rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion]
      have h_zmod : PadicInt.toZModPow (n + 1) ((ℓ : ℤ_[ℓ]) ^ (n + 1)) = 0 := by
        rw [← Nat.cast_pow, map_natCast, ZMod.natCast_self]
      rw [h_zmod, ZMod.val_zero, zero_nsmul]
      rfl
    rw [h_rem_zero, add_zero]
    apply Finset.sum_congr rfl
    intro m _
    apply Subtype.ext
    rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion]
    have h_zmod : PadicInt.toZModPow (n + 1) (a m) =
        PadicInt.toZModPow (n + 1) (f m (n + 1) : ℤ_[ℓ]) := by
      dsimp [a]
      rw [PadicInt.toZModPow_ofIntSeq_of_pow_dvd_sub (f m) ℓ (hf_dvd m) (n + 1), map_intCast]
    rw [h_zmod]
  haveI : Module.Finite ℤ_[ℓ] T := Module.Finite.of_surjective _ h_fin_gen
  
  have h_ell_inj : ∀ z : T, (ℓ : ℤ_[ℓ]) • z = 0 → z = 0 := by
    intro z hz
    apply Subtype.ext
    funext n
    apply Subtype.ext
    have h_n1 : (((ℓ : ℤ_[ℓ]) • z).1 (n + 1) : EllipticRootNumber.Pts F E) = 0 := by
      rw [hz]
      rfl
    rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      map_natCast, ZMod.val_natCast] at h_n1
    have h_mod := EllipticRootNumber.nsmul_eq_of_modEq F E
      ((EllipticRootNumber.mem_torsion F E).mp (z.1 (n + 1)).2)
      (Nat.mod_modEq ℓ (ℓ ^ (n + 2)))
    rw [h_mod, z.2 n] at h_n1
    exact h_n1
  have h_pow_inj : ∀ (k : ℕ) (z : T), ((ℓ : ℤ_[ℓ]) ^ k) • z = 0 → z = 0 := by
    intro k
    induction k with
    | zero =>
      intro z hz
      rwa [pow_zero, one_smul] at hz
    | succ k ih =>
      intro z hz
      rw [pow_succ', mul_smul] at hz
      exact ih z (h_ell_inj _ hz)
  haveI : NoZeroSMulDivisors ℤ_[ℓ] T := ⟨by
    intro a z haz
    by_cases ha : a = 0
    · exact Or.inl ha
    · right
      let u := PadicInt.unitCoeff ha
      have hu := PadicInt.unitCoeff_spec ha
      have h_pow : ((ℓ : ℤ_[ℓ]) ^ a.valuation) • z = 0 := by
        calc ((ℓ : ℤ_[ℓ]) ^ a.valuation) • z
            = (1 : ℤ_[ℓ]) • (((ℓ : ℤ_[ℓ]) ^ a.valuation) • z) := (one_smul _ _).symm
          _ = ((↑u⁻¹ * ↑u : ℤ_[ℓ])) • (((ℓ : ℤ_[ℓ]) ^ a.valuation) • z) := by
              rw [Units.inv_mul]
          _ = (↑u⁻¹ : ℤ_[ℓ]) • ((↑u * (ℓ : ℤ_[ℓ]) ^ a.valuation) • z) := by
              rw [mul_smul, mul_smul]
          _ = (↑u⁻¹ : ℤ_[ℓ]) • (a • z) := by rw [← hu]
          _ = 0 := by rw [haz, smul_zero]
      exact h_pow_inj a.valuation z h_pow⟩
  haveI : Module.IsTorsionFree ℤ_[ℓ] T := instIsTorsionFreeOfIsDomainOfNoZeroSMulDivisors
  haveI : Module.Free ℤ_[ℓ] T := Module.free_of_finite_type_torsion_free'
  rw [Module.finrank_baseChange, Module.finrank_baseChange]
  
  have h_pi0_surj : ∀ m₀ : M₀, ∃ x : T, x.1 0 = m₀ := by
    intro m₀
    let step : ∀ n : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) →
        EllipticRootNumber.torsion F E (ℓ ^ (n + 2)) := fun n P =>
      let Q' := Classical.choose (h_surj P.1)
      have hQ' : ℓ • Q' = P.1 :=
        Classical.choose_spec (h_surj P.1)
      ⟨Q', by
        rw [EllipticRootNumber.mem_torsion, pow_succ', mul_nsmul, hQ']
        exact (EllipticRootNumber.mem_torsion F E).mp P.2⟩
    let P : ∀ n : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) :=
      fun n => Nat.rec m₀ step n
    have hP : P ∈ T := by
      intro n
      exact Classical.choose_spec (h_surj (P n).1)
    exact ⟨⟨P, hP⟩, rfl⟩
  set r := Module.finrank ℤ_[ℓ] T
  let B : Module.Basis (Fin r) ℤ_[ℓ] T := Module.finBasis ℤ_[ℓ] T
  haveI : NeZero (ℓ ^ (0 + 1)) := ⟨pow_ne_zero (0 + 1) hℓ_ne⟩
  let ι : (Fin r → ZMod (ℓ ^ (0 + 1))) → T :=
    fun c => B.equivFun.symm (fun i => ((c i).val : ℤ_[ℓ]))
  let Φ : (Fin r → ZMod (ℓ ^ (0 + 1))) → M₀ := fun c => (ι c).1 0
  have hΦ_bij : Function.Bijective Φ := by
    refine ⟨?_, ?_⟩
    · intro c₁ c₂ hΦ
      have h0 : (ι c₁ - ι c₂).1 0 = 0 := by
        change Φ c₁ - Φ c₂ = 0
        rw [hΦ, sub_self]
      obtain ⟨z, hz⟩ := h_div (ι c₁ - ι c₂) h0
      funext i
      have h_eq := congrArg B.equivFun hz
      rw [map_sub, map_smul, B.equivFun.apply_symm_apply, B.equivFun.apply_symm_apply] at h_eq
      have hi := congrFun h_eq i
      rw [Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at hi
      have h_mod := congrArg (PadicInt.toZModPow (0 + 1)) hi
      rw [map_sub, map_natCast, map_natCast, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val,
        map_mul, map_natCast] at h_mod
      have hℓ_zero : (ℓ : ZMod (ℓ ^ (0 + 1))) = 0 :=
        (congrArg (Nat.cast : ℕ → ZMod (ℓ ^ (0 + 1)))
          (by rw [Nat.zero_add, pow_one] : ℓ = ℓ ^ (0 + 1))).trans
          (ZMod.natCast_self (ℓ ^ (0 + 1)))
      rw [hℓ_zero, zero_mul] at h_mod
      exact sub_eq_zero.mp h_mod
    · intro m₀
      obtain ⟨x, hx⟩ := h_pi0_surj m₀
      let c : Fin r → ZMod (ℓ ^ (0 + 1)) :=
        fun i => PadicInt.toZModPow (0 + 1) (B.equivFun x i)
      refine ⟨c, ?_⟩
      rw [← hx]
      dsimp [Φ, ι]
      have hx_eq : x = B.equivFun.symm (B.equivFun x) :=
        (B.equivFun.symm_apply_apply x).symm
      conv_rhs => rw [hx_eq]
      rw [B.equivFun_symm_apply, B.equivFun_symm_apply,
        Submodule.coe_sum, Finset.sum_apply, Submodule.coe_sum, Finset.sum_apply]
      apply Finset.sum_congr rfl
      intro i _
      apply Subtype.ext
      rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
        Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
        map_natCast, ZMod.natCast_zmod_val]
  have h_card_eq := Nat.card_eq_of_bijective Φ hΦ_bij
  rw [Nat.card_fun, Nat.card_zmod, Nat.card_fin, Nat.zero_add, pow_one, h_card] at h_card_eq
  exact Nat.pow_right_injective (EllipticRootNumber.ell_prime F).out.two_le h_card_eq

theorem weierstrass_phi2_monic_deg_and_coprime_psi2Sq (K : Type u) [Field K]
    [IsAlgClosed K] [DecidableEq K] (W : WeierstrassCurve.Affine K) (hΔ : W.Δ ≠ 0) :
    let A₂ : Polynomial K := Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
      2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈
    let D₂ : Polynomial K := 4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆
    A₂.Monic ∧
    A₂.natDegree = 4 ∧
    IsCoprime A₂ D₂ ∧
    D₂.natDegree ≤ 3 ∧
    D₂.coeff 3 = (2 : K) ^ 2 :=
by
  intro A₂ D₂
  have h_deg_X4 : (Polynomial.X ^ 4 : Polynomial K).natDegree = 4 :=
    Polynomial.natDegree_X_pow 4
  have h_deg_b4X2 : (Polynomial.C W.b₄ * Polynomial.X ^ 2).natDegree ≤ 2 :=
    Polynomial.natDegree_C_mul_X_pow_le W.b₄ 2
  have h_deg_2b6X : (2 * Polynomial.C W.b₆ * Polynomial.X).natDegree ≤ 1 := by
    have h2 : (2 : Polynomial K) * Polynomial.C W.b₆ * Polynomial.X =
        Polynomial.C (2 * W.b₆) * Polynomial.X := by
      rw [← Polynomial.C_ofNat, ← Polynomial.C_mul]
    rw [h2]
    exact le_trans (Polynomial.natDegree_C_mul_le (2 * W.b₆) Polynomial.X)
      (by rw [Polynomial.natDegree_X])
  have h_deg_b8 : (Polynomial.C W.b₈).natDegree = 0 :=
    Polynomial.natDegree_C W.b₈
  have hA2_le : A₂.natDegree ≤ 4 := by
    have h1 := Polynomial.natDegree_sub_le
      (Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
        2 * Polynomial.C W.b₆ * Polynomial.X)
      (Polynomial.C W.b₈)
    have h2 := Polynomial.natDegree_sub_le
      (Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2)
      (2 * Polynomial.C W.b₆ * Polynomial.X)
    have h3 := Polynomial.natDegree_sub_le
      (Polynomial.X ^ 4 : Polynomial K)
      (Polynomial.C W.b₄ * Polynomial.X ^ 2)
    change ((Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
      2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈).natDegree) ≤ 4
    omega
  have h_deg_4X3 : (4 * Polynomial.X ^ 3 : Polynomial K).natDegree ≤ 3 := by
    have h4 : (4 : Polynomial K) * Polynomial.X ^ 3 =
        Polynomial.C (4 : K) * Polynomial.X ^ 3 := by
      rw [← Polynomial.C_ofNat]
    rw [h4]
    exact Polynomial.natDegree_C_mul_X_pow_le (4 : K) 3
  have h_deg_b2X2 : (Polynomial.C W.b₂ * Polynomial.X ^ 2).natDegree ≤ 2 :=
    Polynomial.natDegree_C_mul_X_pow_le W.b₂ 2
  have h_deg_2b4X : (2 * Polynomial.C W.b₄ * Polynomial.X).natDegree ≤ 1 := by
    have h2 : (2 : Polynomial K) * Polynomial.C W.b₄ * Polynomial.X =
        Polynomial.C (2 * W.b₄) * Polynomial.X := by
      rw [← Polynomial.C_ofNat, ← Polynomial.C_mul]
    rw [h2]
    exact le_trans (Polynomial.natDegree_C_mul_le (2 * W.b₄) Polynomial.X)
      (by rw [Polynomial.natDegree_X])
  have h_deg_b6 : (Polynomial.C W.b₆).natDegree = 0 :=
    Polynomial.natDegree_C W.b₆
  have hD2_le : D₂.natDegree ≤ 3 := by
    have h1 := Polynomial.natDegree_add_le
      (4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
        2 * Polynomial.C W.b₄ * Polynomial.X)
      (Polynomial.C W.b₆)
    have h2 := Polynomial.natDegree_add_le
      (4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2)
      (2 * Polynomial.C W.b₄ * Polynomial.X)
    have h3 := Polynomial.natDegree_add_le
      (4 * Polynomial.X ^ 3 : Polynomial K)
      (Polynomial.C W.b₂ * Polynomial.X ^ 2)
    change ((4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆).natDegree) ≤ 3
    omega
  have hA2_c4 : A₂.coeff 4 = 1 := by
    change (Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
      2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈).coeff 4 = 1
    simp only [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C_mul,
      Polynomial.coeff_C]
    norm_num
  have hD2_c3 : D₂.coeff 3 = (2 : K) ^ 2 := by
    change (4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆).coeff 3 = (2 : K) ^ 2
    simp only [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.coeff_C_mul,
      Polynomial.coeff_ofNat_mul, Polynomial.coeff_C]
    norm_num
  have hA2_ge : 4 ≤ A₂.natDegree := by
    apply Polynomial.le_natDegree_of_ne_zero
    rw [hA2_c4]
    exact one_ne_zero
  have hA2_deg : A₂.natDegree = 4 := le_antisymm hA2_le hA2_ge
  have hA2_monic : A₂.Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hA2_deg, hA2_c4]
  have hb : 4 * Polynomial.C W.b₈ =
      Polynomial.C W.b₂ * Polynomial.C W.b₆ - Polynomial.C W.b₄ ^ 2 := by
    have h := congrArg Polynomial.C (WeierstrassCurve.b_relation W)
    simpa only [map_mul, map_sub, map_pow, map_ofNat] using h
  have hΔ_C : Polynomial.C W.Δ =
      -Polynomial.C W.b₂ ^ 2 * Polynomial.C W.b₈ - 8 * Polynomial.C W.b₄ ^ 3 -
        27 * Polynomial.C W.b₆ ^ 2 +
        9 * Polynomial.C W.b₂ * Polynomial.C W.b₄ * Polynomial.C W.b₆ := by
    change Polynomial.C (-W.b₂ ^ 2 * W.b₈ - 8 * W.b₄ ^ 3 - 27 * W.b₆ ^ 2 +
      9 * W.b₂ * W.b₄ * W.b₆) = _
    simp only [map_add, map_sub, map_mul, map_neg, map_pow, map_ofNat]
  let U : Polynomial K :=
    -48 * Polynomial.X ^ 2 - 8 * Polynomial.C W.b₂ * Polynomial.X +
      (Polynomial.C W.b₂ ^ 2 - 32 * Polynomial.C W.b₄)
  let V : Polynomial K :=
    12 * Polynomial.X ^ 3 - Polynomial.C W.b₂ * Polynomial.X ^ 2 -
      10 * Polynomial.C W.b₄ * Polynomial.X +
      (Polynomial.C W.b₂ * Polynomial.C W.b₄ - 27 * Polynomial.C W.b₆)
  have h_res : U * A₂ + V * D₂ = Polynomial.C W.Δ := by
    change U * (Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
      2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈) +
      V * (4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆) = Polynomial.C W.Δ
    dsimp only [U, V]
    rw [hΔ_C]
    linear_combination (12 * Polynomial.X ^ 2 + 2 * Polynomial.C W.b₂ * Polynomial.X +
      8 * Polynomial.C W.b₄) * hb
  have h_inv : Polynomial.C (W.Δ)⁻¹ * Polynomial.C W.Δ = 1 := by
    rw [← Polynomial.C_mul, inv_mul_cancel₀ hΔ, Polynomial.C_1]
  have h_cop : IsCoprime A₂ D₂ := by
    refine ⟨Polynomial.C (W.Δ)⁻¹ * U, Polynomial.C (W.Δ)⁻¹ * V, ?_⟩
    linear_combination Polynomial.C (W.Δ)⁻¹ * h_res + h_inv
  exact ⟨hA2_monic, hA2_deg, h_cop, hD2_le, hD2_c3⟩

theorem weierstrass_functionField_injective_and_generic_duplication (K : Type u) [Field K]
    [DecidableEq K] (W : WeierstrassCurve.Affine K) [DecidableEq W.FunctionField]
    (hD2_ne : (4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆ : Polynomial K) ≠ 0) :
    let ι : Polynomial K →+* W.FunctionField := algebraMap (Polynomial K) W.FunctionField
    let W_L : WeierstrassCurve.Affine W.FunctionField :=
      (W.map (algebraMap K W.FunctionField)).toAffine
    let A₂ : Polynomial K := Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
      2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈
    let D₂ : Polynomial K := 4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆
    Function.Injective ι ∧
    ∃ P_gen : W_L.Point,
      (∃ (y₁ : W.FunctionField) (h₁ : W_L.Nonsingular (ι Polynomial.X / ι 1) y₁),
        (1 : ℕ) • P_gen = WeierstrassCurve.Affine.Point.some h₁) ∧
      (∃ (y₂ : W.FunctionField) (h₂ : W_L.Nonsingular (ι A₂ / ι D₂) y₂),
        (2 : ℕ) • P_gen = WeierstrassCurve.Affine.Point.some h₂) :=
by
  intro ι W_L A₂ D₂
  let R := W.CoordinateRing
  let L := W.FunctionField
  let X_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)
  let Y_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X
  haveI : Module.Free (Polynomial K) W.CoordinateRing :=
    Module.Free.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  haveI : Module.Finite (Polynomial K) W.CoordinateRing :=
    Module.Finite.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  have h_basis_eq_zero : ∀ p q : Polynomial K,
      p • (1 : R) + q • Y_R = 0 → p = 0 ∧ q = 0 := by
    intro p q h
    have h_deg := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W) p q
    rw [h, Algebra.norm_zero, Polynomial.degree_zero] at h_deg
    refine ⟨?_, ?_⟩
    · by_contra hp
      have hp_deg : p.degree = (p.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hp
      have h1 : 2 • p.degree ≤ ⊥ := by
        rw [h_deg]
        exact le_max_left _ _
      rw [hp_deg, two_nsmul, ← Nat.cast_add, le_bot_iff] at h1
      exact WithBot.natCast_ne_bot _ h1
    · by_contra hq
      have hq_deg : q.degree = (q.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hq
      have h1 : 2 • q.degree + 3 ≤ ⊥ := by
        rw [h_deg]
        exact le_max_right _ _
      change 2 • q.degree + ((3 : ℕ) : WithBot ℕ) ≤ ⊥ at h1
      rw [hq_deg, two_nsmul, ← Nat.cast_add, ← Nat.cast_add, le_bot_iff] at h1
      exact WithBot.natCast_ne_bot _ h1
  have h_smul_one : ∀ p : Polynomial K,
      p • (1 : R) = WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C p) := by
    intro p
    rw [WeierstrassCurve.Affine.CoordinateRing.smul, mul_one]
  have h_alg_K : ∀ c : K,
      algebraMap K R c = WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C c)) := by
    intro c
    rw [IsScalarTower.algebraMap_apply K (Polynomial K) W.CoordinateRing c,
      Polynomial.algebraMap_eq, Algebra.algebraMap_eq_smul_one, h_smul_one]
  have h_inj : Function.Injective ι := by
    intro p q hpq
    have h_sub : ι (p - q) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact hpq
    have h_R : algebraMap (Polynomial K) R (p - q) = 0 := by
      apply (IsFractionRing.injective R L)
      rw [← IsScalarTower.algebraMap_apply (Polynomial K) R L (p - q), map_zero]
      exact h_sub
    have h_smul : (p - q) • (1 : R) + (0 : Polynomial K) • Y_R = 0 := by
      rw [zero_smul, add_zero, ← Algebra.algebraMap_eq_smul_one]
      exact h_R
    exact sub_eq_zero.mp (h_basis_eq_zero (p - q) 0 h_smul).1
  have h_gen : W_L.Nonsingular (algebraMap R L X_R) (algebraMap R L Y_R) := by
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.equation_iff']
    simp only [W_L, WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₂,
      WeierstrassCurve.map_a₃, WeierstrassCurve.map_a₄, WeierstrassCurve.map_a₆,
      IsScalarTower.algebraMap_apply K R L]
    refine ⟨?_, ?_⟩
    · have h_sq := WeierstrassCurve.Affine.CoordinateRing.smul_basis_mul_Y (W' := W) 0 1
      simp only [zero_smul, one_smul, zero_add, one_mul, zero_sub, neg_smul, h_smul_one,
        WeierstrassCurve.Affine.CoordinateRing.smul] at h_sq
      simp only [h_alg_K, X_R, Y_R, map_add, map_sub, map_mul, map_pow, map_neg,
        map_zero, map_one] at h_sq
      have h_eq_R : Y_R ^ 2 + algebraMap K R W.a₁ * X_R * Y_R + algebraMap K R W.a₃ * Y_R -
          (X_R ^ 3 + algebraMap K R W.a₂ * X_R ^ 2 + algebraMap K R W.a₄ * X_R +
            algebraMap K R W.a₆) = 0 := by
        simp only [h_alg_K, X_R, Y_R, map_add, map_sub, map_mul, map_pow, map_neg,
          map_zero, map_one]
        linear_combination h_sq
      have h_eq_L := congrArg (algebraMap R L) h_eq_R
      simpa only [map_add, map_sub, map_mul, map_pow, map_zero] using h_eq_L
    · by_contra h_sing
      push_neg at h_sing
      rcases h_sing with ⟨hD₁_L, hD₂_L⟩
      have hD₁ : algebraMap K R W.a₁ * Y_R -
          (3 * X_R ^ 2 + 2 * algebraMap K R W.a₂ * X_R + algebraMap K R W.a₄) = 0 := by
        apply (IsFractionRing.injective R L)
        simpa only [map_add, map_sub, map_mul, map_pow, map_ofNat, map_zero] using hD₁_L
      have hD₂ : 2 * Y_R + algebraMap K R W.a₁ * X_R + algebraMap K R W.a₃ = 0 := by
        apply (IsFractionRing.injective R L)
        simpa only [map_add, map_mul, map_ofNat, map_zero] using hD₂_L
      have hD₁' : (-(3 * Polynomial.X ^ 2 + 2 * Polynomial.C W.a₂ * Polynomial.X + Polynomial.C W.a₄)) • (1 : R) +
          (Polynomial.C W.a₁) • Y_R = 0 := by
        rw [h_smul_one, WeierstrassCurve.Affine.CoordinateRing.smul]
        simp only [h_alg_K, X_R, Y_R, map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat] at hD₁ ⊢
        linear_combination hD₁
      have hD₂' : (Polynomial.C W.a₁ * Polynomial.X + Polynomial.C W.a₃) • (1 : R) +
          (Polynomial.C (2 : K)) • Y_R = 0 := by
        rw [h_smul_one, WeierstrassCurve.Affine.CoordinateRing.smul]
        simp only [h_alg_K, X_R, Y_R, map_add, map_mul, map_ofNat] at hD₂ ⊢
        linear_combination hD₂
      have hp₁ : -(3 * Polynomial.X ^ 2 + 2 * Polynomial.C W.a₂ * Polynomial.X + Polynomial.C W.a₄) = 0 :=
        (h_basis_eq_zero _ _ hD₁').1
      have hq₂ : Polynomial.C (2 : K) = 0 :=
        (h_basis_eq_zero _ _ hD₂').2
      have h2 : (2 : K) = 0 := Polynomial.C_eq_zero.mp hq₂
      have h3_coeff := congrArg (fun p : Polynomial K => p.coeff 2) hp₁
      simp [Polynomial.coeff_X_pow, Polynomial.coeff_C_mul, Polynomial.coeff_X,
        Polynomial.coeff_C] at h3_coeff
      have h1 : (1 : K) = 0 := by linear_combination h3_coeff - h2
      exact one_ne_zero h1
  let X_gen : L := ι Polynomial.X
  let Y_gen : L := algebraMap R L Y_R
  let x₀ : L := ι Polynomial.X / ι 1
  have hX_R_eq : algebraMap R L X_R = X_gen := by
    have h1 : X_R = algebraMap (Polynomial K) R Polynomial.X := by
      rw [Algebra.algebraMap_eq_smul_one, h_smul_one]
    rw [h1, ← IsScalarTower.algebraMap_apply (Polynomial K) R L Polynomial.X]
  have hx₀ : x₀ = X_gen := by
    change ι Polynomial.X / ι 1 = X_gen
    rw [map_one, div_one]
  have h₁ : W_L.Nonsingular x₀ Y_gen := by
    rw [hx₀, ← hX_R_eq]
    exact h_gen
  let P_gen : W_L.Point := WeierstrassCurve.Affine.Point.some h₁
  have hf₀ : Y_gen ^ 2 + W_L.a₁ * X_gen * Y_gen + W_L.a₃ * Y_gen -
      (X_gen ^ 3 + W_L.a₂ * X_gen ^ 2 + W_L.a₄ * X_gen + W_L.a₆) = 0 := by
    have heq := (W_L.equation_iff' x₀ Y_gen).mp h₁.1
    rwa [hx₀] at heq
  have h_alg_C : ∀ c : K, ι (Polynomial.C c) = algebraMap K L c := by
    intro c
    rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply K (Polynomial K) L c]
  have hD₂_L : ι D₂ = 4 * X_gen ^ 3 + W_L.b₂ * X_gen ^ 2 + 2 * W_L.b₄ * X_gen + W_L.b₆ := by
    change ι (4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆) = _
    simp only [map_add, map_mul, map_pow, map_ofNat, h_alg_C]
    change _ = 4 * X_gen ^ 3 + (W.map (algebraMap K L)).b₂ * X_gen ^ 2 +
      2 * (W.map (algebraMap K L)).b₄ * X_gen + (W.map (algebraMap K L)).b₆
    rw [WeierstrassCurve.map_b₂, WeierstrassCurve.map_b₄, WeierstrassCurve.map_b₆]
  have hA₂_L : ι A₂ = X_gen ^ 4 - W_L.b₄ * X_gen ^ 2 - 2 * W_L.b₆ * X_gen - W_L.b₈ := by
    change ι (Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
      2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈) = _
    simp only [map_sub, map_mul, map_pow, map_ofNat, h_alg_C]
    change _ = X_gen ^ 4 - (W.map (algebraMap K L)).b₄ * X_gen ^ 2 -
      2 * (W.map (algebraMap K L)).b₆ * X_gen - (W.map (algebraMap K L)).b₈
    rw [WeierstrassCurve.map_b₄, WeierstrassCurve.map_b₆, WeierstrassCurve.map_b₈]
  have hb₂ : W_L.b₂ = W_L.a₁ ^ 2 + 4 * W_L.a₂ := rfl
  have hb₄ : W_L.b₄ = 2 * W_L.a₄ + W_L.a₁ * W_L.a₃ := rfl
  have hb₆ : W_L.b₆ = W_L.a₃ ^ 2 + 4 * W_L.a₆ := rfl
  have hb₈ : W_L.b₈ = W_L.a₁ ^ 2 * W_L.a₆ + 4 * W_L.a₂ * W_L.a₆ - W_L.a₁ * W_L.a₃ * W_L.a₄ +
      W_L.a₂ * W_L.a₃ ^ 2 - W_L.a₄ ^ 2 := rfl
  let dy : L := 2 * Y_gen + W_L.a₁ * X_gen + W_L.a₃
  let dx : L := 3 * X_gen ^ 2 + 2 * W_L.a₂ * X_gen + W_L.a₄ - W_L.a₁ * Y_gen
  have h_dy_sq : dy ^ 2 = ι D₂ := by
    rw [hD₂_L, hb₂, hb₄, hb₆]
    dsimp only [dy]
    linear_combination 4 * hf₀
  have hD₂_L_ne : ι D₂ ≠ 0 := (map_ne_zero_iff ι h_inj).mpr hD2_ne
  have h_dy_ne : dy ≠ 0 := by
    intro h0
    apply hD₂_L_ne
    rw [← h_dy_sq, h0, sq, mul_zero]
  have h_negY_sub : Y_gen - W_L.negY x₀ Y_gen = dy := by
    rw [hx₀, WeierstrassCurve.Affine.negY]
    dsimp only [dy]
    ring
  have hy_ne : Y_gen ≠ W_L.negY x₀ Y_gen := by
    intro h_eq
    apply h_dy_ne
    rw [← h_negY_sub, sub_eq_zero.mpr h_eq]
  have h_slope : W_L.slope x₀ x₀ Y_gen Y_gen = dx / dy := by
    rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hy_ne, h_negY_sub, hx₀]
  have h_num : dx ^ 2 + W_L.a₁ * dx * dy - (W_L.a₂ + 2 * X_gen) * dy ^ 2 = ι A₂ := by
    rw [hA₂_L, hb₄, hb₆, hb₈]
    dsimp only [dx, dy]
    linear_combination -(W_L.a₁ ^ 2 + 4 * W_L.a₂ + 8 * X_gen) * hf₀
  have h_addX_mul : W_L.addX x₀ x₀ (W_L.slope x₀ x₀ Y_gen Y_gen) * dy ^ 2 = ι A₂ := by
    rw [WeierstrassCurve.Affine.addX, h_slope, hx₀, ← h_num]
    have h_clear : ((dx / dy) ^ 2 + W_L.a₁ * (dx / dy) - W_L.a₂ - X_gen - X_gen) * dy ^ 2 =
        (dx / dy * dy) ^ 2 + W_L.a₁ * (dx / dy * dy) * dy - (W_L.a₂ + 2 * X_gen) * dy ^ 2 := by
      ring
    rw [h_clear, div_mul_cancel₀ _ h_dy_ne]
  have h_addX : W_L.addX x₀ x₀ (W_L.slope x₀ x₀ Y_gen Y_gen) = ι A₂ / ι D₂ := by
    rw [eq_div_iff hD₂_L_ne, ← h_dy_sq]
    exact h_addX_mul
  have h_ns2 : W_L.Nonsingular (W_L.addX x₀ x₀ (W_L.slope x₀ x₀ Y_gen Y_gen))
      (W_L.addY x₀ x₀ Y_gen (W_L.slope x₀ x₀ Y_gen Y_gen)) :=
    W_L.nonsingular_add h₁ h₁ (fun h => hy_ne h.2)
  have h₂ : W_L.Nonsingular (ι A₂ / ι D₂)
      (W_L.addY x₀ x₀ Y_gen (W_L.slope x₀ x₀ Y_gen Y_gen)) := by
    rwa [← h_addX]
  have h_pt_eq : ∀ {x x' y : L} (hx : x = x') (h : W_L.Nonsingular x y) (h' : W_L.Nonsingular x' y),
      (WeierstrassCurve.Affine.Point.some h : W_L.Point) = WeierstrassCurve.Affine.Point.some h' := by
    rintro x x' y rfl h h'
    rfl
  refine ⟨h_inj, P_gen, ⟨Y_gen, h₁, one_nsmul P_gen⟩,
    ⟨W_L.addY x₀ x₀ Y_gen (W_L.slope x₀ x₀ Y_gen Y_gen), h₂, ?_⟩⟩
  rw [two_nsmul]
  change WeierstrassCurve.Affine.Point.some h₁ + WeierstrassCurve.Affine.Point.some h₁ = _
  rw [WeierstrassCurve.Affine.Point.add_self_of_Y_ne hy_ne]
  exact h_pt_eq h_addX _ h₂

theorem weierstrass_functionField_chord_step (K : Type u) [Field K] [DecidableEq K]
    (W : WeierstrassCurve.Affine K) [DecidableEq W.FunctionField]
    (h_inj : Function.Injective (algebraMap (Polynomial K) W.FunctionField))
    (P_gen : ((W.map (algebraMap K W.FunctionField)).toAffine).Point)
    {y₁ y_prev y_curr : W.FunctionField}
    {A_prev D_prev A_curr D_curr : Polynomial K}
    (hD_prev : D_prev ≠ 0) (hD_curr : D_curr ≠ 0)
    (h_diff : A_curr - Polynomial.X * D_curr ≠ 0)
    (h₁ : ((W.map (algebraMap K W.FunctionField)).toAffine).Nonsingular
      (algebraMap (Polynomial K) W.FunctionField Polynomial.X /
        algebraMap (Polynomial K) W.FunctionField 1) y₁)
    (hP1 : (1 : ℕ) • P_gen = WeierstrassCurve.Affine.Point.some h₁)
    (k : ℕ)
    (h_prev : ((W.map (algebraMap K W.FunctionField)).toAffine).Nonsingular
      (algebraMap (Polynomial K) W.FunctionField A_prev /
        algebraMap (Polynomial K) W.FunctionField D_prev) y_prev)
    (hP_prev : k • P_gen = WeierstrassCurve.Affine.Point.some h_prev)
    (h_curr : ((W.map (algebraMap K W.FunctionField)).toAffine).Nonsingular
      (algebraMap (Polynomial K) W.FunctionField A_curr /
        algebraMap (Polynomial K) W.FunctionField D_curr) y_curr)
    (hP_curr : (k + 1) • P_gen = WeierstrassCurve.Affine.Point.some h_curr) :
    let Q₀ : Polynomial K := (A_curr - Polynomial.X * D_curr) ^ 2
    let Q₁ : Polynomial K :=
      2 * Polynomial.X * A_curr * (Polynomial.X * D_curr + A_curr) +
        Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr +
        Polynomial.C W.b₄ * (Polynomial.X * D_curr + A_curr) * D_curr +
        Polynomial.C W.b₆ * D_curr ^ 2
    let Q₂ : Polynomial K :=
      Polynomial.X ^ 2 * A_curr ^ 2 -
        Polynomial.C W.b₄ * Polynomial.X * A_curr * D_curr -
        Polynomial.C W.b₆ * (Polynomial.X * D_curr + A_curr) * D_curr -
        Polynomial.C W.b₈ * D_curr ^ 2
    Q₀ * A_prev ^ 2 - Q₁ * A_prev * D_prev + Q₂ * D_prev ^ 2 = 0 ∧
    ∀ A_next D_next : Polynomial K,
      D_next * D_prev = Q₀ →
      A_next * D_prev + D_next * A_prev = Q₁ →
      ∃ (y_next : W.FunctionField)
        (h_next : ((W.map (algebraMap K W.FunctionField)).toAffine).Nonsingular
          (algebraMap (Polynomial K) W.FunctionField A_next /
            algebraMap (Polynomial K) W.FunctionField D_next) y_next),
        (k + 2) • P_gen = WeierstrassCurve.Affine.Point.some h_next :=
by
  intro Q₀ Q₁ Q₂
  let L := W.FunctionField
  let ι : Polynomial K →+* L := algebraMap (Polynomial K) W.FunctionField
  let W_L : WeierstrassCurve.Affine L := (W.map (algebraMap K L)).toAffine
  let x₁ : L := ι A_curr / ι D_curr
  let x₂ : L := ι Polynomial.X / ι 1
  let x_m0 : L := ι A_prev / ι D_prev
  have hC : ∀ c : K, ι (Polynomial.C c) = algebraMap K L c := by
    intro c
    rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply K (Polynomial K) L c]
  have hb₂ : W_L.b₂ = ι (Polynomial.C W.b₂) := by
    change (W.map (algebraMap K L)).b₂ = _
    rw [WeierstrassCurve.map_b₂, hC]
  have hb₄ : W_L.b₄ = ι (Polynomial.C W.b₄) := by
    change (W.map (algebraMap K L)).b₄ = _
    rw [WeierstrassCurve.map_b₄, hC]
  have hb₆ : W_L.b₆ = ι (Polynomial.C W.b₆) := by
    change (W.map (algebraMap K L)).b₆ = _
    rw [WeierstrassCurve.map_b₆, hC]
  have hb₈ : W_L.b₈ = ι (Polynomial.C W.b₈) := by
    change (W.map (algebraMap K L)).b₈ = _
    rw [WeierstrassCurve.map_b₈, hC]
  have hD_prev_L : ι D_prev ≠ 0 := (map_ne_zero_iff ι h_inj).mpr hD_prev
  have hD_curr_L : ι D_curr ≠ 0 := (map_ne_zero_iff ι h_inj).mpr hD_curr
  have h_diff_L : ι (A_curr - Polynomial.X * D_curr) ≠ 0 := (map_ne_zero_iff ι h_inj).mpr h_diff
  have hx₂ : x₂ = ι Polynomial.X := by
    change ι Polynomial.X / ι 1 = ι Polynomial.X
    rw [map_one, div_one]
  have hx₁_mul : x₁ * ι D_curr = ι A_curr := div_mul_cancel₀ (ι A_curr) hD_curr_L
  have hxm0_mul : x_m0 * ι D_prev = ι A_prev := div_mul_cancel₀ (ι A_prev) hD_prev_L
  have hx12_mul : (x₁ - x₂) * ι D_curr = ι (A_curr - Polynomial.X * D_curr) := by
    rw [sub_mul, hx₁_mul, hx₂, map_sub, map_mul]
  have hx12_ne : x₁ - x₂ ≠ 0 :=
    left_ne_zero_of_mul (hx12_mul ▸ h_diff_L)
  have hx : x₁ ≠ x₂ := sub_ne_zero.mp hx12_ne
  let L_p : L := W_L.slope x₁ x₂ y_curr y₁
  let x_p : L := W_L.addX x₁ x₂ L_p
  let L_m : L := W_L.slope x₁ x₂ y_curr (W_L.negY x₂ y₁)
  let x_m : L := W_L.addX x₁ x₂ L_m
  have h_kp2_some : (k + 2) • P_gen = WeierstrassCurve.Affine.Point.some
      (W_L.nonsingular_add h_curr h₁ (fun hxy => hx hxy.1)) := by
    have hk2 : (k + 2) • P_gen = (k + 1) • P_gen + (1 : ℕ) • P_gen := add_nsmul P_gen (k + 1) 1
    rw [hk2, hP_curr, hP1]
    exact WeierstrassCurve.Affine.Point.add_of_X_ne hx
  have h_km_some : WeierstrassCurve.Affine.Point.some
      (W_L.nonsingular_add h_curr ((W_L.nonsingular_neg x₂ y₁).mpr h₁) (fun hxy => hx hxy.1)) =
      WeierstrassCurve.Affine.Point.some h_prev := by
    have hk_sub : (k + 1) • P_gen - (1 : ℕ) • P_gen = k • P_gen := by
      rw [add_nsmul P_gen k 1, add_sub_cancel_right]
    rw [hP_curr, hP1, hP_prev, sub_eq_add_neg, WeierstrassCurve.Affine.Point.neg_some h₁,
      WeierstrassCurve.Affine.Point.add_of_X_ne hx] at hk_sub
    exact hk_sub
  have hxm_eq : x_m = x_m0 := by
    rw [WeierstrassCurve.Affine.Point.some.injEq] at h_km_some
    exact h_km_some.1
  have hE₁ : y_curr ^ 2 + W_L.a₁ * x₁ * y_curr + W_L.a₃ * y_curr -
      (x₁ ^ 3 + W_L.a₂ * x₁ ^ 2 + W_L.a₄ * x₁ + W_L.a₆) = 0 :=
    (W_L.equation_iff' x₁ y_curr).mp h_curr.1
  have hE₂ : y₁ ^ 2 + W_L.a₁ * x₂ * y₁ + W_L.a₃ * y₁ -
      (x₂ ^ 3 + W_L.a₂ * x₂ ^ 2 + W_L.a₄ * x₂ + W_L.a₆) = 0 :=
    (W_L.equation_iff' x₂ y₁).mp h₁.1
  have h_Lp : L_p * (x₁ - x₂) - (y_curr - y₁) = 0 := by
    have hL : L_p = (y_curr - y₁) / (x₁ - x₂) := W_L.slope_of_X_ne hx
    rw [hL, div_mul_cancel₀ _ hx12_ne, sub_self]
  have h_Lm : L_m * (x₁ - x₂) - (y_curr - W_L.negY x₂ y₁) = 0 := by
    have hL : L_m = (y_curr - W_L.negY x₂ y₁) / (x₁ - x₂) := W_L.slope_of_X_ne hx
    rw [hL, div_mul_cancel₀ _ hx12_ne, sub_self]
  let N_p : L := x₁ ^ 2 * x₂ + x₁ * x₂ ^ 2 + 2 * W_L.a₂ * x₁ * x₂ + W_L.a₄ * (x₁ + x₂) +
    2 * W_L.a₆ - 2 * y_curr * y₁ - W_L.a₁ * (x₁ * y₁ + x₂ * y_curr) - W_L.a₃ * (y_curr + y₁)
  let N_m : L := x₁ ^ 2 * x₂ + x₁ * x₂ ^ 2 + (W_L.a₁ ^ 2 + 2 * W_L.a₂) * x₁ * x₂ +
    (W_L.a₁ * W_L.a₃ + W_L.a₄) * (x₁ + x₂) + W_L.a₃ ^ 2 + 2 * W_L.a₆ +
    2 * y_curr * y₁ + W_L.a₁ * (x₁ * y₁ + x₂ * y_curr) + W_L.a₃ * (y_curr + y₁)
  have hx_p_num : x_p * (x₁ - x₂) ^ 2 = N_p := by
    dsimp only [x_p, N_p, WeierstrassCurve.Affine.addX]
    linear_combination
      (L_p * (x₁ - x₂) + (y_curr - y₁) + W_L.a₁ * (x₁ - x₂)) * h_Lp + hE₁ + hE₂
  have hx_m_num : x_m * (x₁ - x₂) ^ 2 = N_m := by
    dsimp only [x_m, N_m, WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.negY] at h_Lm ⊢
    linear_combination
      (L_m * (x₁ - x₂) + (y_curr - (-y₁ - W_L.a₁ * x₂ - W_L.a₃)) + W_L.a₁ * (x₁ - x₂)) * h_Lm +
        hE₁ + hE₂
  have h_chord_sum : (x₁ - x₂) ^ 2 * (x_p + x_m) =
      2 * x₂ * x₁ * (x₂ + x₁) + W_L.b₂ * x₂ * x₁ + W_L.b₄ * (x₂ + x₁) + W_L.b₆ := by
    dsimp only [N_p, N_m, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆] at hx_p_num hx_m_num ⊢
    linear_combination hx_p_num + hx_m_num
  have h_prod_N : N_p * N_m =
      (x₁ - x₂) ^ 2 * (x₂ ^ 2 * x₁ ^ 2 - W_L.b₄ * x₂ * x₁ - W_L.b₆ * (x₂ + x₁) - W_L.b₈) := by
    dsimp only [N_p, N_m, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
      WeierstrassCurve.b₈]
    linear_combination
      -(2 * y₁ + W_L.a₁ * x₂ + W_L.a₃) ^ 2 * hE₁ -
      (4 * x₁ ^ 3 + (W_L.a₁ ^ 2 + 4 * W_L.a₂) * x₁ ^ 2 +
        2 * (W_L.a₁ * W_L.a₃ + 2 * W_L.a₄) * x₁ + (W_L.a₃ ^ 2 + 4 * W_L.a₆)) * hE₂
  have h_chord_prod : (x₁ - x₂) ^ 2 * (x_p * x_m) =
      x₂ ^ 2 * x₁ ^ 2 - W_L.b₄ * x₂ * x₁ - W_L.b₆ * (x₂ + x₁) - W_L.b₈ := by
    apply mul_left_cancel₀ (pow_ne_zero 2 hx12_ne)
    calc (x₁ - x₂) ^ 2 * ((x₁ - x₂) ^ 2 * (x_p * x_m))
        = (x_p * (x₁ - x₂) ^ 2) * (x_m * (x₁ - x₂) ^ 2) := by ring
      _ = N_p * N_m := by rw [hx_p_num, hx_m_num]
      _ = (x₁ - x₂) ^ 2 * (x₂ ^ 2 * x₁ ^ 2 - W_L.b₄ * x₂ * x₁ - W_L.b₆ * (x₂ + x₁) - W_L.b₈) := h_prod_N
  have hQ₀_L : ι Q₀ = (x₁ - x₂) ^ 2 * ι D_curr ^ 2 := by
    change ι ((A_curr - Polynomial.X * D_curr) ^ 2) = _
    rw [map_pow, ← hx12_mul, mul_pow]
  have hQ₁_L : ι Q₁ = 2 * x₂ * (x₁ * ι D_curr) * (x₂ * ι D_curr + x₁ * ι D_curr) +
      W_L.b₂ * x₂ * (x₁ * ι D_curr) * ι D_curr +
      W_L.b₄ * (x₂ * ι D_curr + x₁ * ι D_curr) * ι D_curr +
      W_L.b₆ * ι D_curr ^ 2 := by
    change ι (2 * Polynomial.X * A_curr * (Polynomial.X * D_curr + A_curr) +
        Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr +
        Polynomial.C W.b₄ * (Polynomial.X * D_curr + A_curr) * D_curr +
        Polynomial.C W.b₆ * D_curr ^ 2) = _
    simp only [map_add, map_mul, map_pow, map_ofNat, ← hb₂, ← hb₄, ← hb₆, ← hx₂, ← hx₁_mul]
  have hQ₂_L : ι Q₂ = x₂ ^ 2 * (x₁ * ι D_curr) ^ 2 -
      W_L.b₄ * x₂ * (x₁ * ι D_curr) * ι D_curr -
      W_L.b₆ * (x₂ * ι D_curr + x₁ * ι D_curr) * ι D_curr -
      W_L.b₈ * ι D_curr ^ 2 := by
    change ι (Polynomial.X ^ 2 * A_curr ^ 2 -
        Polynomial.C W.b₄ * Polynomial.X * A_curr * D_curr -
        Polynomial.C W.b₆ * (Polynomial.X * D_curr + A_curr) * D_curr -
        Polynomial.C W.b₈ * D_curr ^ 2) = _
    simp only [map_add, map_sub, map_mul, map_pow, ← hb₄, ← hb₆, ← hb₈, ← hx₂, ← hx₁_mul]
  have h_sum : ι Q₀ * (x_p + x_m0) = ι Q₁ := by
    rw [hQ₀_L, hQ₁_L, ← hxm_eq]
    linear_combination (ι D_curr) ^ 2 * h_chord_sum
  have h_prod : ι Q₀ * x_p * x_m0 = ι Q₂ := by
    rw [hQ₀_L, hQ₂_L, ← hxm_eq]
    linear_combination (ι D_curr) ^ 2 * h_chord_prod
  refine ⟨?_, ?_⟩
  · have h_quad_L : ι (Q₀ * A_prev ^ 2 - Q₁ * A_prev * D_prev + Q₂ * D_prev ^ 2) = 0 := by
      simp only [map_add, map_sub, map_mul, map_pow]
      linear_combination
        ι D_prev * ι A_prev * h_sum -
        ι D_prev ^ 2 * h_prod -
        ι Q₀ * (ι A_prev - x_p * ι D_prev) * hxm0_mul
    rw [← map_zero ι] at h_quad_L
    exact h_inj h_quad_L
  · intro A_next D_next hD_rel hAD_rel
    have hD_L : ι D_next * ι D_prev = ι Q₀ := by
      simpa only [map_mul] using congr_arg ι hD_rel
    have hAD_L : ι A_next * ι D_prev + ι D_next * ι A_prev = ι Q₁ := by
      simpa only [map_add, map_mul] using congr_arg ι hAD_rel
    have hQ₀_ne : ι Q₀ ≠ 0 := by
      change ι ((A_curr - Polynomial.X * D_curr) ^ 2) ≠ 0
      rw [map_pow]
      exact pow_ne_zero 2 h_diff_L
    have hD_next_L : ι D_next ≠ 0 := left_ne_zero_of_mul (hD_L.symm ▸ hQ₀_ne)
    have h_xp_prod : ι D_prev * (x_p * ι D_next - ι A_next) = 0 := by
      linear_combination h_sum + (x_p + x_m0) * hD_L - ι D_next * hxm0_mul - hAD_L
    have h_xp_sub : x_p * ι D_next - ι A_next = 0 :=
      (mul_eq_zero.mp h_xp_prod).resolve_left hD_prev_L
    have hx_p_eq : x_p = ι A_next / ι D_next :=
      (eq_div_iff hD_next_L).mpr (sub_eq_zero.mp h_xp_sub)
    have h_cast_some : ∀ {x_a x_b y_a : L} (hx_ab : x_a = x_b) (ha : W_L.Nonsingular x_a y_a),
        ∃ hb : W_L.Nonsingular x_b y_a,
          (WeierstrassCurve.Affine.Point.some ha : W_L.Point) =
            WeierstrassCurve.Affine.Point.some hb := by
      rintro x_a x_b y_a rfl ha
      exact ⟨ha, rfl⟩
    obtain ⟨h_next, h_next_eq⟩ :=
      h_cast_some hx_p_eq (W_L.nonsingular_add h_curr h₁ (fun hxy => hx hxy.1))
    exact ⟨W_L.addY x₁ x₂ y_curr L_p, h_next, h_kp2_some.trans h_next_eq⟩

theorem weierstrass_division_polynomial_step_of_quad_rel (K : Type u) [Field K]
    (W : WeierstrassCurve.Affine K)
    (h_cop2 : IsCoprime
      (Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
        2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈)
      (4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
        2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆))
    (k : ℕ) (hk : 2 ≤ k)
    (A_prev D_prev A_curr D_curr : Polynomial K)
    (hA_prev_monic : A_prev.Monic)
    (hA_prev_deg : A_prev.natDegree = (k - 1) ^ 2)
    (h_cop_prev : IsCoprime A_prev D_prev)
    (hD_prev_deg : D_prev.natDegree ≤ (k - 1) ^ 2 - 1)
    (hD_prev_coeff : D_prev.coeff ((k - 1) ^ 2 - 1) = ((k - 1 : ℕ) : K) ^ 2)
    (hA_curr_monic : A_curr.Monic)
    (hA_curr_deg : A_curr.natDegree = k ^ 2)
    (h_cop_curr : IsCoprime A_curr D_curr)
    (hD_curr_deg : D_curr.natDegree ≤ k ^ 2 - 1)
    (hD_curr_coeff : D_curr.coeff (k ^ 2 - 1) = (k : K) ^ 2)
    (h_quad :
      let Q₀ : Polynomial K := (A_curr - Polynomial.X * D_curr) ^ 2
      let Q₁ : Polynomial K :=
        2 * Polynomial.X * A_curr * (Polynomial.X * D_curr + A_curr) +
          Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr +
          Polynomial.C W.b₄ * (Polynomial.X * D_curr + A_curr) * D_curr +
          Polynomial.C W.b₆ * D_curr ^ 2
      let Q₂ : Polynomial K :=
        Polynomial.X ^ 2 * A_curr ^ 2 -
          Polynomial.C W.b₄ * Polynomial.X * A_curr * D_curr -
          Polynomial.C W.b₆ * (Polynomial.X * D_curr + A_curr) * D_curr -
          Polynomial.C W.b₈ * D_curr ^ 2
      Q₀ * A_prev ^ 2 - Q₁ * A_prev * D_prev + Q₂ * D_prev ^ 2 = 0) :
    ∃ A_next D_next : Polynomial K,
      D_next * D_prev = (A_curr - Polynomial.X * D_curr) ^ 2 ∧
      A_next * D_prev + D_next * A_prev =
        2 * Polynomial.X * A_curr * (Polynomial.X * D_curr + A_curr) +
          Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr +
          Polynomial.C W.b₄ * (Polynomial.X * D_curr + A_curr) * D_curr +
          Polynomial.C W.b₆ * D_curr ^ 2 ∧
      A_next.Monic ∧
      A_next.natDegree = (k + 1) ^ 2 ∧
      IsCoprime A_next D_next ∧
      D_next.natDegree ≤ (k + 1) ^ 2 - 1 ∧
      D_next.coeff ((k + 1) ^ 2 - 1) = ((k + 1 : ℕ) : K) ^ 2 :=
by
  set S : Polynomial K := Polynomial.X * D_curr + A_curr
  set Q₀ : Polynomial K := (A_curr - Polynomial.X * D_curr) ^ 2
  set Q₁ : Polynomial K :=
    2 * Polynomial.X * A_curr * S +
      Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr +
      Polynomial.C W.b₄ * S * D_curr +
      Polynomial.C W.b₆ * D_curr ^ 2
  set Q₂ : Polynomial K :=
    Polynomial.X ^ 2 * A_curr ^ 2 -
      Polynomial.C W.b₄ * Polynomial.X * A_curr * D_curr -
      Polynomial.C W.b₆ * S * D_curr -
      Polynomial.C W.b₈ * D_curr ^ 2
  change Q₀ * A_prev ^ 2 - Q₁ * A_prev * D_prev + Q₂ * D_prev ^ 2 = 0 at h_quad
  obtain ⟨A_next, D_next, hD_rel, hA_rel, hAD_rel⟩ :
      ∃ A_next D_next : Polynomial K,
        D_next * D_prev = Q₀ ∧
        A_next * A_prev = Q₂ ∧
        A_next * D_prev + D_next * A_prev = Q₁ := by
    rcases h_cop_prev with ⟨u, v, huv⟩
    clear_value Q₀ Q₁ Q₂ S
    refine ⟨(u ^ 2 * A_prev + 2 * u * v * D_prev) * Q₂ + v ^ 2 * (Q₁ * D_prev - Q₀ * A_prev),
      (2 * u * v * A_prev + v ^ 2 * D_prev) * Q₀ + u ^ 2 * (Q₁ * A_prev - Q₂ * D_prev),
      ?_, ?_, ?_⟩
    · linear_combination -u ^ 2 * h_quad + Q₀ * (u * A_prev + v * D_prev + 1) * huv
    · linear_combination -v ^ 2 * h_quad + Q₂ * (u * A_prev + v * D_prev + 1) * huv
    · linear_combination 2 * u * v * h_quad + Q₁ * (u * A_prev + v * D_prev + 1) * huv
  have h_cop_next : IsCoprime A_next D_next := by
    obtain ⟨U₀, U₁, U₂, h_bez_Q⟩ :
        ∃ U₀ U₁ U₂ : Polynomial K, U₀ * Q₀ + U₁ * Q₁ + U₂ * Q₂ = 1 := by
      rcases h_cop_curr with ⟨u_c, v_c, huv_c⟩
      have h_cop_diff : IsCoprime (A_curr - Polynomial.X * D_curr) D_curr :=
        ⟨u_c, v_c + u_c * Polynomial.X, by linear_combination huv_c⟩
      rcases h_cop_diff.pow (m := 2) (n := 4) with ⟨s, t, h_st⟩
      change s * Q₀ + t * D_curr ^ 4 = 1 at h_st
      rcases h_cop2 with ⟨p₂, p₁, hp12⟩
      set A₂ : Polynomial K :=
        Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
          2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈
      set D₂ : Polynomial K :=
        4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
          2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆
      change p₂ * A₂ + p₁ * D₂ = 1 at hp12
      set R₁ : Polynomial K :=
        2 * Polynomial.X * (A_curr + 2 * Polynomial.X * D_curr) +
          Polynomial.C W.b₂ * Polynomial.X * D_curr + Polynomial.C W.b₄ * D_curr
      set R₂ : Polynomial K :=
        Polynomial.X ^ 2 * (A_curr + Polynomial.X * D_curr) -
          Polynomial.C W.b₄ * Polynomial.X * D_curr - Polynomial.C W.b₆ * D_curr
      have hQ1_decomp : Q₁ = D₂ * D_curr ^ 2 + (A_curr - Polynomial.X * D_curr) * R₁ := by
        dsimp only [Q₁, S, D₂, R₁]
        ring
      have hQ2_decomp : Q₂ = A₂ * D_curr ^ 2 + (A_curr - Polynomial.X * D_curr) * R₂ := by
        dsimp only [Q₂, S, A₂, R₂]
        ring
      have hQ0_def : Q₀ = (A_curr - Polynomial.X * D_curr) ^ 2 := rfl
      clear_value Q₀ Q₁ Q₂ S A₂ D₂ R₁ R₂
      let R : Polynomial K := p₁ * R₁ + p₂ * R₂
      let M : Polynomial K := D_curr ^ 2 - (A_curr - Polynomial.X * D_curr) * R
      refine ⟨s + t * R ^ 2, t * M * p₁, t * M * p₂, ?_⟩
      linear_combination h_st + t * M * D_curr ^ 2 * hp12 +
        t * R ^ 2 * hQ0_def + t * M * p₁ * hQ1_decomp + t * M * p₂ * hQ2_decomp
    clear_value Q₀ Q₁ Q₂ S
    exact ⟨U₁ * D_prev + U₂ * A_prev, U₀ * D_prev + U₁ * A_prev, by
      linear_combination h_bez_Q + U₀ * hD_rel + U₁ * hAD_rel + U₂ * hA_rel⟩
  have h_deg_mul_le : ∀ {P Q : Polynomial K} {M N : ℕ},
      P.natDegree ≤ M → Q.natDegree ≤ N → (P * Q).natDegree ≤ M + N :=
    fun hP hQ => Polynomial.natDegree_mul_le.trans (Nat.add_le_add hP hQ)
  have h_coeff_mul_top : ∀ {P Q : Polynomial K} {M N : ℕ},
      P.natDegree ≤ M → Q.natDegree ≤ N →
      (P * Q).coeff (M + N) = P.coeff M * Q.coeff N := by
    intro P Q M N hP hQ
    rw [Polynomial.coeff_mul, Finset.sum_eq_single (M, N)]
    · rintro ⟨b1, b2⟩ hb hne
      rw [Finset.mem_antidiagonal] at hb
      dsimp only at hb ⊢
      by_cases h1 : M < b1
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega : P.natDegree < b1), zero_mul]
      · have h2 : N < b2 := by
          have hne' : b1 = M → b2 ≠ N := fun h1' h2' => hne (Prod.ext h1' h2')
          omega
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega : Q.natDegree < b2), mul_zero]
    · intro h_not_mem
      exfalso
      apply h_not_mem
      rw [Finset.mem_antidiagonal]
  have h_deg_add_le : ∀ {P Q : Polynomial K} {M : ℕ},
      P.natDegree ≤ M → Q.natDegree ≤ M → (P + Q).natDegree ≤ M :=
    fun {P Q _} hP hQ => (Polynomial.natDegree_add_le P Q).trans (max_le hP hQ)
  have h_deg_sub_le : ∀ {P Q : Polynomial K} {M : ℕ},
      P.natDegree ≤ M → Q.natDegree ≤ M → (P - Q).natDegree ≤ M :=
    fun {P Q _} hP hQ => (Polynomial.natDegree_sub_le P Q).trans (max_le hP hQ)
  have h_deg_C_mul_le : ∀ (c : K) {P : Polynomial K} {M : ℕ},
      P.natDegree ≤ M → (Polynomial.C c * P).natDegree ≤ M :=
    fun c {P _} hP => (Polynomial.natDegree_C_mul_le c P).trans hP
  have h_coeff_sub_of_lt : ∀ {P Q : Polynomial K} {M : ℕ},
      Q.natDegree < M → (P - Q).coeff M = P.coeff M := by
    intro P Q M hQ
    rw [Polynomial.coeff_sub, Polynomial.coeff_eq_zero_of_natDegree_lt hQ, sub_zero]
  have h_coeff_add_of_lt : ∀ {P Q : Polynomial K} {M : ℕ},
      Q.natDegree < M → (P + Q).coeff M = P.coeff M := by
    intro P Q M hQ
    rw [Polynomial.coeff_add, Polynomial.coeff_eq_zero_of_natDegree_lt hQ, add_zero]
  have hd_sum : (k + 1) ^ 2 + (k - 1) ^ 2 = 2 * k ^ 2 + 2 := by
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, k = m + 2 := ⟨k - 2, by omega⟩
    have : m + 2 - 1 = m + 1 := rfl
    rw [this]
    ring
  have hd_ge4 : 4 ≤ k ^ 2 := by nlinarith
  have hd_prev_ge1 : 1 ≤ (k - 1) ^ 2 := by
    have : 1 ≤ k - 1 := by omega
    nlinarith
  have hd_next_ge9 : 9 ≤ (k + 1) ^ 2 := by nlinarith
  generalize hd_eq : k ^ 2 = d at hA_curr_deg hD_curr_deg hD_curr_coeff hd_ge4 hd_sum
  generalize hdp_eq : (k - 1) ^ 2 = d_prev at hA_prev_deg hD_prev_deg hD_prev_coeff hd_prev_ge1 hd_sum
  generalize hdn_eq : (k + 1) ^ 2 = d_next at hd_sum hd_next_ge9 ⊢
  have hX_deg : (Polynomial.X : Polynomial K).natDegree ≤ 1 := by rw [Polynomial.natDegree_X]
  have hX_coeff : (Polynomial.X : Polynomial K).coeff 1 = 1 := Polynomial.coeff_X_one
  have hX2_deg : (Polynomial.X ^ 2 : Polynomial K).natDegree ≤ 2 := by
    rw [Polynomial.natDegree_X_pow]
  have hX2_coeff : (Polynomial.X ^ 2 : Polynomial K).coeff 2 = 1 := by
    rw [Polynomial.coeff_X_pow, if_pos rfl]
  have hAc_deg_le : A_curr.natDegree ≤ d := le_of_eq hA_curr_deg
  have hAc_coeff : A_curr.coeff d = 1 := by
    rw [← hA_curr_deg]
    exact hA_curr_monic.coeff_natDegree
  have hAc2_deg : (A_curr ^ 2).natDegree ≤ 2 * d := by
    rw [sq, two_mul]
    exact h_deg_mul_le hAc_deg_le hAc_deg_le
  have hAc2_coeff : (A_curr ^ 2).coeff (2 * d) = 1 := by
    rw [sq, two_mul, h_coeff_mul_top hAc_deg_le hAc_deg_le, hAc_coeff, mul_one]
  have hT20_deg : (Polynomial.X ^ 2 * A_curr ^ 2).natDegree ≤ 2 * d + 2 := by
    have := h_deg_mul_le hX2_deg hAc2_deg
    omega
  have hT20_coeff : (Polynomial.X ^ 2 * A_curr ^ 2).coeff (2 * d + 2) = 1 := by
    have h_eq : 2 * d + 2 = 2 + 2 * d := by omega
    rw [h_eq, h_coeff_mul_top hX2_deg hAc2_deg, hX2_coeff, hAc2_coeff, mul_one]
  have hXD_deg : (Polynomial.X * D_curr).natDegree ≤ d := by
    have := h_deg_mul_le hX_deg hD_curr_deg
    omega
  have hXD_coeff : (Polynomial.X * D_curr).coeff d = (k : K) ^ 2 := by
    have h_eq : d = 1 + (d - 1) := by omega
    rw [h_eq, h_coeff_mul_top hX_deg hD_curr_deg, hX_coeff, one_mul]
    exact hD_curr_coeff
  have hS_deg : S.natDegree ≤ d := h_deg_add_le hXD_deg hAc_deg_le
  have hS_coeff : S.coeff d = (k : K) ^ 2 + 1 := by
    change (Polynomial.X * D_curr + A_curr).coeff d = (k : K) ^ 2 + 1
    rw [Polynomial.coeff_add, hXD_coeff, hAc_coeff]
  have hXAc_deg : (Polynomial.X * A_curr).natDegree ≤ 1 + d := h_deg_mul_le hX_deg hAc_deg_le
  have hXAc_coeff : (Polynomial.X * A_curr).coeff (1 + d) = 1 := by
    rw [h_coeff_mul_top hX_deg hAc_deg_le, hX_coeff, hAc_coeff, mul_one]
  have hXAcD_deg : (Polynomial.X * A_curr * D_curr).natDegree ≤ 2 * d := by
    have := h_deg_mul_le hXAc_deg hD_curr_deg
    omega
  have hSD_deg : (S * D_curr).natDegree ≤ 2 * d - 1 := by
    have := h_deg_mul_le hS_deg hD_curr_deg
    omega
  have hD2_deg : (D_curr ^ 2).natDegree ≤ 2 * d - 2 := by
    rw [sq]
    have := h_deg_mul_le hD_curr_deg hD_curr_deg
    omega
  have hT21_deg : (Polynomial.C W.b₄ * Polynomial.X * A_curr * D_curr).natDegree ≤ 2 * d := by
    have h_eq : Polynomial.C W.b₄ * Polynomial.X * A_curr * D_curr =
        Polynomial.C W.b₄ * (Polynomial.X * A_curr * D_curr) := by ring
    rw [h_eq]
    exact h_deg_C_mul_le W.b₄ hXAcD_deg
  have hT22_deg : (Polynomial.C W.b₆ * S * D_curr).natDegree ≤ 2 * d - 1 := by
    have h_eq : Polynomial.C W.b₆ * S * D_curr = Polynomial.C W.b₆ * (S * D_curr) := by ring
    rw [h_eq]
    exact h_deg_C_mul_le W.b₆ hSD_deg
  have hT23_deg : (Polynomial.C W.b₈ * D_curr ^ 2).natDegree ≤ 2 * d - 2 :=
    h_deg_C_mul_le W.b₈ hD2_deg
  have hQ2_deg_le : Q₂.natDegree ≤ 2 * d + 2 := by
    apply h_deg_sub_le
    · apply h_deg_sub_le
      · exact h_deg_sub_le hT20_deg (by omega)
      · omega
    · omega
  have hQ2_coeff : Q₂.coeff (2 * d + 2) = 1 := by
    change (Polynomial.X ^ 2 * A_curr ^ 2 -
      Polynomial.C W.b₄ * Polynomial.X * A_curr * D_curr -
      Polynomial.C W.b₆ * S * D_curr -
      Polynomial.C W.b₈ * D_curr ^ 2).coeff (2 * d + 2) = 1
    rw [h_coeff_sub_of_lt (by omega), h_coeff_sub_of_lt (by omega),
      h_coeff_sub_of_lt (by omega), hT20_coeff]
  have hQ2_deg : Q₂.natDegree = 2 * d + 2 := by
    apply le_antisymm hQ2_deg_le
    apply Polynomial.le_natDegree_of_ne_zero
    rw [hQ2_coeff]
    exact one_ne_zero
  have hQ2_monic : Q₂.Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hQ2_deg, hQ2_coeff]
  have hA_next_monic : A_next.Monic :=
    Polynomial.Monic.of_mul_monic_right hA_prev_monic (hA_rel.symm ▸ hQ2_monic)
  have hA_next_deg : A_next.natDegree = d_next := by
    have h_mul_deg : (A_next * A_prev).natDegree = A_next.natDegree + A_prev.natDegree :=
      Polynomial.Monic.natDegree_mul hA_next_monic hA_prev_monic
    rw [hA_rel, hQ2_deg, hA_prev_deg] at h_mul_deg
    omega
  have hXAcS_deg : (Polynomial.X * A_curr * S).natDegree ≤ 2 * d + 1 := by
    have := h_deg_mul_le hXAc_deg hS_deg
    omega
  have hXAcS_coeff : (Polynomial.X * A_curr * S).coeff (2 * d + 1) = (k : K) ^ 2 + 1 := by
    have h_eq : 2 * d + 1 = (1 + d) + d := by omega
    rw [h_eq, h_coeff_mul_top hXAc_deg hS_deg, hXAc_coeff, hS_coeff, one_mul]
  have hT10_eq : 2 * Polynomial.X * A_curr * S = Polynomial.C 2 * (Polynomial.X * A_curr * S) := by
    rw [Polynomial.C_ofNat]
    ring
  have hT10_deg : (2 * Polynomial.X * A_curr * S).natDegree ≤ 2 * d + 1 := by
    rw [hT10_eq]
    exact h_deg_C_mul_le 2 hXAcS_deg
  have hT10_coeff : (2 * Polynomial.X * A_curr * S).coeff (2 * d + 1) = 2 * ((k : K) ^ 2 + 1) := by
    rw [hT10_eq, Polynomial.coeff_C_mul, hXAcS_coeff]
  have hT11_deg : (Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr).natDegree ≤ 2 * d := by
    have h_eq : Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr =
        Polynomial.C W.b₂ * (Polynomial.X * A_curr * D_curr) := by ring
    rw [h_eq]
    exact h_deg_C_mul_le W.b₂ hXAcD_deg
  have hT12_deg : (Polynomial.C W.b₄ * S * D_curr).natDegree ≤ 2 * d - 1 := by
    have h_eq : Polynomial.C W.b₄ * S * D_curr = Polynomial.C W.b₄ * (S * D_curr) := by ring
    rw [h_eq]
    exact h_deg_C_mul_le W.b₄ hSD_deg
  have hT13_deg : (Polynomial.C W.b₆ * D_curr ^ 2).natDegree ≤ 2 * d - 2 :=
    h_deg_C_mul_le W.b₆ hD2_deg
  have hQ1_deg_le : Q₁.natDegree ≤ 2 * d + 1 := by
    apply h_deg_add_le
    · apply h_deg_add_le
      · exact h_deg_add_le hT10_deg (by omega)
      · omega
    · omega
  have hQ1_coeff : Q₁.coeff (2 * d + 1) = 2 * ((k : K) ^ 2 + 1) := by
    change (2 * Polynomial.X * A_curr * S +
      Polynomial.C W.b₂ * Polynomial.X * A_curr * D_curr +
      Polynomial.C W.b₄ * S * D_curr +
      Polynomial.C W.b₆ * D_curr ^ 2).coeff (2 * d + 1) = 2 * ((k : K) ^ 2 + 1)
    rw [h_coeff_add_of_lt (by omega), h_coeff_add_of_lt (by omega),
      h_coeff_add_of_lt (by omega), hT10_coeff]
  have hAn_deg_le : A_next.natDegree ≤ d_next := le_of_eq hA_next_deg
  have hAn_coeff : A_next.coeff d_next = 1 := by
    rw [← hA_next_deg]
    exact hA_next_monic.coeff_natDegree
  have hAp_deg_le : A_prev.natDegree ≤ d_prev := le_of_eq hA_prev_deg
  have hAp_coeff : A_prev.coeff d_prev = 1 := by
    rw [← hA_prev_deg]
    exact hA_prev_monic.coeff_natDegree
  have hAnDp_deg : (A_next * D_prev).natDegree ≤ 2 * d + 1 := by
    have := h_deg_mul_le hAn_deg_le hD_prev_deg
    omega
  have hAnDp_coeff : (A_next * D_prev).coeff (2 * d + 1) = ((k - 1 : ℕ) : K) ^ 2 := by
    have h_eq : 2 * d + 1 = d_next + (d_prev - 1) := by omega
    rw [h_eq, h_coeff_mul_top hAn_deg_le hD_prev_deg, hAn_coeff, one_mul]
    exact hD_prev_coeff
  have hDnAp_eq : D_next * A_prev = Q₁ - A_next * D_prev :=
    eq_sub_of_add_eq' hAD_rel
  have hDnAp_deg : (D_next * A_prev).natDegree ≤ 2 * d + 1 := by
    rw [hDnAp_eq]
    exact h_deg_sub_le hQ1_deg_le hAnDp_deg
  have hD_next_deg : D_next.natDegree ≤ d_next - 1 := by
    by_cases hDn0 : D_next = 0
    · rw [hDn0, Polynomial.natDegree_zero]
      omega
    · have h_mul := Polynomial.natDegree_mul hDn0 hA_prev_monic.ne_zero
      rw [hA_prev_deg] at h_mul
      omega
  have hDnAp_coeff : (D_next * A_prev).coeff (2 * d + 1) = D_next.coeff (d_next - 1) := by
    have h_eq : 2 * d + 1 = (d_next - 1) + d_prev := by omega
    rw [h_eq, h_coeff_mul_top hD_next_deg hAp_deg_le, hAp_coeff, mul_one]
  have hD_next_coeff : D_next.coeff (d_next - 1) = ((k + 1 : ℕ) : K) ^ 2 := by
    have h_c : (A_next * D_prev + D_next * A_prev).coeff (2 * d + 1) = Q₁.coeff (2 * d + 1) :=
      congrArg (fun P : Polynomial K => P.coeff (2 * d + 1)) hAD_rel
    rw [Polynomial.coeff_add, hAnDp_coeff, hDnAp_coeff, hQ1_coeff] at h_c
    rw [Nat.cast_sub (by omega : 1 ≤ k), Nat.cast_one] at h_c
    rw [Nat.cast_add, Nat.cast_one]
    linear_combination h_c
  exact ⟨A_next, D_next, hD_rel, hAD_rel, hA_next_monic, hA_next_deg, h_cop_next,
    hD_next_deg, hD_next_coeff⟩

theorem weierstrass_exists_division_ratfunc_polynomials (K : Type u) [Field K]
    [IsAlgClosed K] [DecidableEq K] (W : WeierstrassCurve.Affine K) (hΔ : W.Δ ≠ 0) :
    ∃ A D : ℕ → Polynomial K,
      A 1 = Polynomial.X ∧
      D 1 = 1 ∧
      A 2 = Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
        2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈ ∧
      D 2 = 4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
        2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆ ∧
      (∀ k : ℕ, 1 ≤ k →
        (A k).Monic ∧
        (A k).natDegree = k ^ 2 ∧
        IsCoprime (A k) (D k) ∧
        (D k).natDegree ≤ k ^ 2 - 1 ∧
        (D k).coeff (k ^ 2 - 1) = (k : K) ^ 2) ∧
      (∀ k : ℕ, 2 ≤ k →
        D (k + 1) * D (k - 1) = (A k - Polynomial.X * D k) ^ 2 ∧
        A (k + 1) * D (k - 1) + D (k + 1) * A (k - 1) =
          2 * Polynomial.X * A k * (Polynomial.X * D k + A k) +
            Polynomial.C W.b₂ * Polynomial.X * A k * D k +
            Polynomial.C W.b₄ * (Polynomial.X * D k + A k) * D k +
            Polynomial.C W.b₆ * D k ^ 2) :=
by
  classical
  let A₂ : Polynomial K := Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
    2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈
  let D₂ : Polynomial K := 4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
    2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆
  let ι : Polynomial K →+* W.FunctionField := algebraMap (Polynomial K) W.FunctionField
  let W_L : WeierstrassCurve.Affine W.FunctionField :=
    (W.map (algebraMap K W.FunctionField)).toAffine
  obtain ⟨hA2_monic, hA2_deg, h_cop2, hD2_deg, hD2_coeff⟩ :=
    weierstrass_phi2_monic_deg_and_coprime_psi2Sq K W hΔ
  have h_ne_zero_of_coprime : ∀ {A D : Polynomial K},
      1 ≤ A.natDegree → IsCoprime A D → D ≠ 0 := by
    intro A D hdeg hcop hD0
    rw [hD0, isCoprime_zero_right] at hcop
    have h0 := Polynomial.natDegree_eq_zero_of_isUnit hcop
    omega
  have h_diff_ne_zero_of_coprime : ∀ {A D : Polynomial K},
      2 ≤ A.natDegree → IsCoprime A D → A - Polynomial.X * D ≠ 0 := by
    intro A D hdeg hcop hdiff
    have hA_eq : A = Polynomial.X * D := sub_eq_zero.mp hdiff
    rcases hcop with ⟨u, v, huv⟩
    have hD_unit : IsUnit D := isUnit_of_mul_eq_one_right (u * Polynomial.X + v)
      (by linear_combination huv - u * hA_eq)
    have hD_deg : D.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hD_unit
    have hA_le : A.natDegree ≤ 1 := by
      rw [hA_eq]
      calc (Polynomial.X * D).natDegree ≤ Polynomial.X.natDegree + D.natDegree :=
            Polynomial.natDegree_mul_le
        _ = 1 + 0 := by rw [Polynomial.natDegree_X, hD_deg]
        _ = 1 := by omega
    omega
  have hD2_ne : D₂ ≠ 0 := h_ne_zero_of_coprime (by omega) h_cop2
  obtain ⟨h_inj, P_gen, ⟨y₁, h₁, hP1⟩, ⟨y₂, h₂, hP2⟩⟩ :=
    weierstrass_functionField_injective_and_generic_duplication K W hD2_ne
  let Inv (k : ℕ) (P : Polynomial K × Polynomial K) : Prop :=
    P.1.Monic ∧
    P.1.natDegree = k ^ 2 ∧
    IsCoprime P.1 P.2 ∧
    P.2.natDegree ≤ k ^ 2 - 1 ∧
    P.2.coeff (k ^ 2 - 1) = (k : K) ^ 2 ∧
    ∃ (y_k : W.FunctionField) (h_k : W_L.Nonsingular (ι P.1 / ι P.2) y_k),
      k • P_gen = WeierstrassCurve.Affine.Point.some h_k
  let StepSpec (k : ℕ) (prev curr next : Polynomial K × Polynomial K) : Prop :=
    next.2 * prev.2 = (curr.1 - Polynomial.X * curr.2) ^ 2 ∧
    next.1 * prev.2 + next.2 * prev.1 =
      2 * Polynomial.X * curr.1 * (Polynomial.X * curr.2 + curr.1) +
        Polynomial.C W.b₂ * Polynomial.X * curr.1 * curr.2 +
        Polynomial.C W.b₄ * (Polynomial.X * curr.2 + curr.1) * curr.2 +
        Polynomial.C W.b₆ * curr.2 ^ 2 ∧
    next.1.Monic ∧
    next.1.natDegree = (k + 1) ^ 2 ∧
    IsCoprime next.1 next.2 ∧
    next.2.natDegree ≤ (k + 1) ^ 2 - 1 ∧
    next.2.coeff ((k + 1) ^ 2 - 1) = ((k + 1 : ℕ) : K) ^ 2
  let nextAD (k : ℕ) (prev curr : Polynomial K × Polynomial K) : Polynomial K × Polynomial K :=
    Classical.epsilon fun next => StepSpec k prev curr next
  let pairAD : ℕ → (Polynomial K × Polynomial K) × (Polynomial K × Polynomial K) :=
    Nat.rec ((Polynomial.X, 1), (A₂, D₂))
      (fun m p => (p.2, nextAD (m + 2) p.1 p.2))
  have h_step : ∀ (m : ℕ) (prev curr : Polynomial K × Polynomial K),
      Inv (m + 1) prev → Inv (m + 2) curr →
      StepSpec (m + 2) prev curr (nextAD (m + 2) prev curr) ∧
      Inv (m + 3) (nextAD (m + 2) prev curr) := by
    intro m prev curr h_inv_prev h_inv_curr
    rcases h_inv_prev with ⟨hA_prev_monic, hA_prev_deg, h_cop_prev, hD_prev_deg, hD_prev_coeff,
      y_prev, h_prev, hP_prev⟩
    rcases h_inv_curr with ⟨hA_curr_monic, hA_curr_deg, h_cop_curr, hD_curr_deg, hD_curr_coeff,
      y_curr, h_curr, hP_curr⟩
    have hm1_sq : 1 ≤ (m + 1) ^ 2 := by rw [sq]; nlinarith
    have hm2_sq : 2 ≤ (m + 2) ^ 2 := by rw [sq]; nlinarith
    have hD_prev_ne : prev.2 ≠ 0 := h_ne_zero_of_coprime (by omega) h_cop_prev
    have hD_curr_ne : curr.2 ≠ 0 := h_ne_zero_of_coprime (by omega) h_cop_curr
    have h_diff_ne : curr.1 - Polynomial.X * curr.2 ≠ 0 :=
      h_diff_ne_zero_of_coprime (by omega) h_cop_curr
    obtain ⟨h_quad, h_coord_next⟩ :=
      weierstrass_functionField_chord_step K W h_inj P_gen hD_prev_ne hD_curr_ne h_diff_ne
        h₁ hP1 (m + 1) h_prev hP_prev h_curr hP_curr
    obtain ⟨A_next, D_next, h_step_ex⟩ :=
      weierstrass_division_polynomial_step_of_quad_rel K W h_cop2 (m + 2) (by omega)
        prev.1 prev.2 curr.1 curr.2
        hA_prev_monic hA_prev_deg h_cop_prev hD_prev_deg hD_prev_coeff
        hA_curr_monic hA_curr_deg h_cop_curr hD_curr_deg hD_curr_coeff h_quad
    have h_ex : ∃ next : Polynomial K × Polynomial K, StepSpec (m + 2) prev curr next :=
      ⟨(A_next, D_next), h_step_ex⟩
    have h_eps : StepSpec (m + 2) prev curr (nextAD (m + 2) prev curr) :=
      Classical.epsilon_spec h_ex
    rcases h_eps with ⟨hD_rec, hAD_rec, hAn_monic, hAn_deg, h_cop_n, hDn_deg, hDn_coeff⟩
    obtain ⟨y_next, h_next, hP_next⟩ :=
      h_coord_next (nextAD (m + 2) prev curr).1 (nextAD (m + 2) prev curr).2 hD_rec hAD_rec
    refine ⟨⟨hD_rec, hAD_rec, hAn_monic, hAn_deg, h_cop_n, hDn_deg, hDn_coeff⟩, ?_⟩
    exact ⟨hAn_monic, hAn_deg, h_cop_n, hDn_deg, hDn_coeff, y_next, h_next, hP_next⟩
  have h_inv1 : Inv 1 (Polynomial.X, 1) := by
    refine ⟨Polynomial.monic_X, ?_, isCoprime_one_right, ?_, ?_, y₁, h₁, hP1⟩
    · rw [Polynomial.natDegree_X]
      rfl
    · simp
    · simp
  have h_inv2 : Inv 2 (A₂, D₂) :=
    ⟨hA2_monic, hA2_deg, h_cop2, hD2_deg, hD2_coeff, y₂, h₂, hP2⟩
  have h_pair_inv : ∀ m : ℕ, Inv (m + 1) (pairAD m).1 ∧ Inv (m + 2) (pairAD m).2 := by
    intro m
    induction m with
    | zero => exact ⟨h_inv1, h_inv2⟩
    | succ m ih =>
      exact ⟨ih.2, (h_step m (pairAD m).1 (pairAD m).2 ih.1 ih.2).2⟩
  let P_seq : ℕ → Polynomial K × Polynomial K :=
    fun k => if k ≤ 1 then (Polynomial.X, 1) else (pairAD (k - 2)).2
  have hP_seq_succ1 : ∀ m : ℕ, P_seq (m + 1) = (pairAD m).1 := by
    intro m
    cases m <;> rfl
  have hP_seq_succ2 : ∀ m : ℕ, P_seq (m + 2) = (pairAD m).2 := fun _ => rfl
  refine ⟨fun k => (P_seq k).1, fun k => (P_seq k).2, rfl, rfl, rfl, rfl, ?_, ?_⟩
  · intro k hk
    dsimp only
    have hk_eq : k = (k - 1) + 1 := by omega
    rw [hk_eq, hP_seq_succ1 (k - 1)]
    rcases (h_pair_inv (k - 1)).1 with ⟨h1, h2, h3, h4, h5, _⟩
    exact ⟨h1, h2, h3, h4, h5⟩
  · intro k hk
    dsimp only
    set m : ℕ := k - 2
    have hk_eq : k = m + 2 := by omega
    have hk1 : m + 2 - 1 = m + 1 := rfl
    have hk3 : m + 2 + 1 = (m + 1) + 2 := rfl
    rw [hk_eq, hk1, hk3, hP_seq_succ1 m, hP_seq_succ2 m, hP_seq_succ2 (m + 1)]
    have h_st := (h_step m (pairAD m).1 (pairAD m).2 (h_pair_inv m).1 (h_pair_inv m).2).1
    exact ⟨h_st.1, h_st.2.1⟩

theorem weierstrass_nsmul_eval_of_polynomial_recurrence (K : Type u) [Field K] [DecidableEq K]
    (W : WeierstrassCurve.Affine K) (A D : ℕ → Polynomial K)
    (hA1 : A 1 = Polynomial.X) (hD1 : D 1 = 1)
    (hA2 : A 2 = Polynomial.X ^ 4 - Polynomial.C W.b₄ * Polynomial.X ^ 2 -
      2 * Polynomial.C W.b₆ * Polynomial.X - Polynomial.C W.b₈)
    (hD2 : D 2 = 4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆)
    (h_rec : ∀ k : ℕ, 2 ≤ k →
      D (k + 1) * D (k - 1) = (A k - Polynomial.X * D k) ^ 2 ∧
      A (k + 1) * D (k - 1) + D (k + 1) * A (k - 1) =
        2 * Polynomial.X * A k * (Polynomial.X * D k + A k) +
          Polynomial.C W.b₂ * Polynomial.X * A k * D k +
          Polynomial.C W.b₄ * (Polynomial.X * D k + A k) * D k +
          Polynomial.C W.b₆ * D k ^ 2)
    (n : ℕ) (hn : 1 ≤ n) {x y : K} (h : W.Nonsingular x y) :
    ((∀ j : ℕ, 1 ≤ j → j ≤ n → j • (WeierstrassCurve.Affine.Point.some h : W.Point) ≠ 0) →
      (D n).eval x ≠ 0 ∧
      ∃ (y_n : K) (h_n : W.Nonsingular ((A n).eval x / (D n).eval x) y_n),
        n • (WeierstrassCurve.Affine.Point.some h : W.Point) =
          WeierstrassCurve.Affine.Point.some h_n) ∧
    ((∀ j : ℕ, 1 ≤ j → j ≤ n → (D j).eval x ≠ 0) →
      ∀ j : ℕ, 1 ≤ j → j ≤ n → j • (WeierstrassCurve.Affine.Point.some h : W.Point) ≠ 0) :=
by
  let P : W.Point := WeierstrassCurve.Affine.Point.some h
  have h_some_ne_zero : ∀ {x' y' : K} (h' : W.Nonsingular x' y'),
      (WeierstrassCurve.Affine.Point.some h' : W.Point) ≠ 0 := by
    intro x' y' h' h0
    rw [WeierstrassCurve.Affine.Point.zero_def] at h0
    nomatch h0
  have h_cast_some : ∀ {x₁ x₂ y₁ : K} (hx : x₁ = x₂) (h₁ : W.Nonsingular x₁ y₁),
      ∃ h₂ : W.Nonsingular x₂ y₁,
        (WeierstrassCurve.Affine.Point.some h₁ : W.Point) =
          WeierstrassCurve.Affine.Point.some h₂ := by
    rintro x₁ x₂ y₁ rfl h₁
    exact ⟨h₁, rfl⟩
  have h_add_eq_zero_iff : ∀ {x₁ y₁ x₂ y₂ : K}
      (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂),
      (WeierstrassCurve.Affine.Point.some h₁ : W.Point) +
        WeierstrassCurve.Affine.Point.some h₂ = 0 ↔
      x₁ = x₂ ∧ y₁ = W.negY x₂ y₂ := by
    intro x₁ y₁ x₂ y₂ h₁ h₂
    constructor
    · intro h_add
      by_contra hxy
      rw [WeierstrassCurve.Affine.Point.add_some hxy] at h_add
      exact h_some_ne_zero _ h_add
    · rintro ⟨hx, hy⟩
      exact WeierstrassCurve.Affine.Point.add_of_Y_eq hx hy
  have h_sub_eq_zero_iff : ∀ {x₁ y₁ x₂ y₂ : K}
      (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂),
      (WeierstrassCurve.Affine.Point.some h₁ : W.Point) -
        WeierstrassCurve.Affine.Point.some h₂ = 0 ↔
      x₁ = x₂ ∧ y₁ = y₂ := by
    intro x₁ y₁ x₂ y₂ h₁ h₂
    rw [sub_eq_add_neg, WeierstrassCurve.Affine.Point.neg_some h₂,
      h_add_eq_zero_iff, W.negY_negY]
  have h_x_ne_of_add_ne_zero_of_sub_ne_zero : ∀ {x₁ y₁ x₂ y₂ : K}
      (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂),
      (WeierstrassCurve.Affine.Point.some h₁ : W.Point) +
        WeierstrassCurve.Affine.Point.some h₂ ≠ 0 →
      (WeierstrassCurve.Affine.Point.some h₁ : W.Point) -
        WeierstrassCurve.Affine.Point.some h₂ ≠ 0 →
      x₁ ≠ x₂ := by
    intro x₁ y₁ x₂ y₂ h₁ h₂ h_add_ne h_sub_ne hx
    rcases W.Y_eq_of_X_eq h₁.1 h₂.1 hx with hy | hy
    · exact h_sub_ne ((h_sub_eq_zero_iff h₁ h₂).mpr ⟨hx, hy⟩)
    · exact h_add_ne ((h_add_eq_zero_iff h₁ h₂).mpr ⟨hx, hy⟩)
  have hE : y ^ 2 + W.a₁ * x * y + W.a₃ * y - (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) = 0 :=
    (W.equation_iff' x y).mp h.1
  have hA1_eval : (A 1).eval x = x := by rw [hA1, Polynomial.eval_X]
  have hD1_eval : (D 1).eval x = 1 := by rw [hD1, Polynomial.eval_one]
  have hA2_eval : (A 2).eval x = x ^ 4 - W.b₄ * x ^ 2 - 2 * W.b₆ * x - W.b₈ := by
    rw [hA2]
    simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_ofNat]
  have hD2_eval : (D 2).eval x = 4 * x ^ 3 + W.b₂ * x ^ 2 + 2 * W.b₄ * x + W.b₆ := by
    rw [hD2]
    simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_ofNat]
  have hD2_sq : (D 2).eval x = (y - W.negY x y) ^ 2 := by
    rw [hD2_eval]
    dsimp only [WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
      WeierstrassCurve.Affine.negY]
    linear_combination -4 * hE
  have h_two_nsmul_eq_zero_iff : 2 • P = 0 ↔ (D 2).eval x = 0 := by
    rw [two_nsmul, h_add_eq_zero_iff h h, hD2_sq, sq_eq_zero_iff, sub_eq_zero]
    exact ⟨fun hxy => hxy.2, fun hy => ⟨rfl, hy⟩⟩
  have h_dup_eval : 2 • P ≠ 0 →
      (D 2).eval x ≠ 0 ∧
      ∃ (y_2 : K) (h_2 : W.Nonsingular ((A 2).eval x / (D 2).eval x) y_2),
        2 • P = WeierstrassCurve.Affine.Point.some h_2 := by
    intro h2_ne
    have hD2_ne : (D 2).eval x ≠ 0 := mt h_two_nsmul_eq_zero_iff.mpr h2_ne
    have hy : y ≠ W.negY x y := by
      intro hy_eq
      apply h2_ne
      rw [two_nsmul]
      exact WeierstrassCurve.Affine.Point.add_of_Y_eq rfl hy_eq
    let L := W.slope x x y y
    have h_tan : L * (y - W.negY x y) - (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) = 0 := by
      have hL : L = (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) / (y - W.negY x y) :=
        W.slope_of_Y_ne rfl hy
      rw [hL, div_mul_cancel₀ _ (sub_ne_zero.mpr hy), sub_self]
    have h_addX_mul : W.addX x x L * (D 2).eval x = (A 2).eval x := by
      rw [hD2_sq, hA2_eval]
      dsimp only [WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈,
        WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.negY] at h_tan ⊢
      linear_combination
        (L * (y - (-y - W.a₁ * x - W.a₃)) + (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) +
          W.a₁ * (y - (-y - W.a₁ * x - W.a₃))) * h_tan +
        (-W.a₁ ^ 2 - 4 * W.a₂ - 8 * x) * hE
    have hx2_eq : W.addX x x L = (A 2).eval x / (D 2).eval x :=
      (eq_div_iff hD2_ne).mpr h_addX_mul
    have h2P_eq : 2 • P = WeierstrassCurve.Affine.Point.some
        (W.nonsingular_add h h (fun hxy => hy hxy.2)) := by
      rw [two_nsmul]
      exact WeierstrassCurve.Affine.Point.add_of_Y_ne hy
    obtain ⟨h_2, h_2_eq⟩ := h_cast_some hx2_eq (W.nonsingular_add h h (fun hxy => hy hxy.2))
    exact ⟨hD2_ne, W.addY x x y L, h_2, h2P_eq.trans h_2_eq⟩
  have h_chord_sum : ∀ {x₁ y₁ x₂ y₂ : K} (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂)
      (hx : x₁ ≠ x₂),
      let L_p := W.slope x₁ x₂ y₁ y₂
      let L_m := W.slope x₁ x₂ y₁ (W.negY x₂ y₂)
      let x_p := W.addX x₁ x₂ L_p
      let x_m := W.addX x₁ x₂ L_m
      (x₁ - x₂) ^ 2 * (x_p + x_m) =
        2 * x₂ * x₁ * (x₂ + x₁) + W.b₂ * x₂ * x₁ + W.b₄ * (x₂ + x₁) + W.b₆ := by
    intro x₁ y₁ x₂ y₂ h₁ h₂ hx L_p L_m x_p x_m
    have hE₁ : y₁ ^ 2 + W.a₁ * x₁ * y₁ + W.a₃ * y₁ -
        (x₁ ^ 3 + W.a₂ * x₁ ^ 2 + W.a₄ * x₁ + W.a₆) = 0 :=
      (W.equation_iff' x₁ y₁).mp h₁.1
    have hE₂ : y₂ ^ 2 + W.a₁ * x₂ * y₂ + W.a₃ * y₂ -
        (x₂ ^ 3 + W.a₂ * x₂ ^ 2 + W.a₄ * x₂ + W.a₆) = 0 :=
      (W.equation_iff' x₂ y₂).mp h₂.1
    have h_Lp : L_p * (x₁ - x₂) - (y₁ - y₂) = 0 := by
      have hL : L_p = (y₁ - y₂) / (x₁ - x₂) := W.slope_of_X_ne hx
      rw [hL, div_mul_cancel₀ _ (sub_ne_zero.mpr hx), sub_self]
    have h_Lm : L_m * (x₁ - x₂) - (y₁ - W.negY x₂ y₂) = 0 := by
      have hL : L_m = (y₁ - W.negY x₂ y₂) / (x₁ - x₂) := W.slope_of_X_ne hx
      rw [hL, div_mul_cancel₀ _ (sub_ne_zero.mpr hx), sub_self]
    dsimp only [x_p, x_m, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
      WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.negY] at h_Lp h_Lm ⊢
    linear_combination
      (L_p * (x₁ - x₂) + (y₁ - y₂) + W.a₁ * (x₁ - x₂)) * h_Lp +
      (L_m * (x₁ - x₂) + (y₁ - (-y₂ - W.a₁ * x₂ - W.a₃)) + W.a₁ * (x₁ - x₂)) * h_Lm +
      2 * hE₁ + 2 * hE₂
  have h_rec_eval : ∀ k : ℕ, 2 ≤ k →
      (D (k + 1)).eval x * (D (k - 1)).eval x = ((A k).eval x - x * (D k).eval x) ^ 2 ∧
      (A (k + 1)).eval x * (D (k - 1)).eval x + (D (k + 1)).eval x * (A (k - 1)).eval x =
        2 * x * (A k).eval x * (x * (D k).eval x + (A k).eval x) +
          W.b₂ * x * (A k).eval x * (D k).eval x +
          W.b₄ * (x * (D k).eval x + (A k).eval x) * (D k).eval x +
          W.b₆ * (D k).eval x ^ 2 := by
    intro k hk
    obtain ⟨hr1, hr2⟩ := h_rec k hk
    have hr1' := congr_arg (Polynomial.eval x) hr1
    have hr2' := congr_arg (Polynomial.eval x) hr2
    simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_ofNat] at hr1' hr2'
    exact ⟨hr1', hr2'⟩
  have h_fwd : ∀ m : ℕ, 1 ≤ m →
      (∀ j : ℕ, 1 ≤ j → j ≤ m → j • P ≠ 0) →
      (D m).eval x ≠ 0 ∧
      ∃ (y_m : K) (h_m : W.Nonsingular ((A m).eval x / (D m).eval x) y_m),
        m • P = WeierstrassCurve.Affine.Point.some h_m := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro hm h_nz
    rcases eq_or_lt_of_le hm with rfl | hm2
    · refine ⟨by rw [hD1_eval]; exact one_ne_zero, ?_⟩
      have hx1 : x = (A 1).eval x / (D 1).eval x := by rw [hA1_eval, hD1_eval, div_one]
      obtain ⟨h_1, h_1_eq⟩ := h_cast_some hx1 h
      refine ⟨y, h_1, ?_⟩
      rw [one_nsmul]
      exact h_1_eq
    · rcases eq_or_lt_of_le ( show 2 ≤ m by omega ) with rfl | hm3
      · exact h_dup_eval (h_nz 2 (by omega) le_rfl)
      · set k := m - 1
        have hk : 2 ≤ k := by omega
        have hm_eq : m = k + 1 := by omega
        obtain ⟨hDk, y_k, h_k, hkP⟩ :=
          ih k (by omega) (by omega) (fun j hj1 hjk => h_nz j hj1 (by omega))
        obtain ⟨hDkm1, y_km1, h_km1, hkm1P⟩ :=
          ih (k - 1) (by omega) (by omega) (fun j hj1 hjkm1 => h_nz j hj1 (by omega))
        let x_k := (A k).eval x / (D k).eval x
        let x_km1 := (A (k - 1)).eval x / (D (k - 1)).eval x
        have h_kp1_add : k • P + P = (k + 1) • P := (succ_nsmul P k).symm
        have h_km1_sub : k • P - P = (k - 1) • P := by
          conv_lhs => rw [show k = (k - 1) + 1 by omega, succ_nsmul, add_sub_cancel_right]
        have h_add_ne : (WeierstrassCurve.Affine.Point.some h_k : W.Point) +
            WeierstrassCurve.Affine.Point.some h ≠ 0 := by
          rw [← hkP, h_kp1_add, ← hm_eq]
          exact h_nz m hm le_rfl
        have h_sub_ne : (WeierstrassCurve.Affine.Point.some h_k : W.Point) -
            WeierstrassCurve.Affine.Point.some h ≠ 0 := by
          rw [← hkP, h_km1_sub]
          exact h_nz (k - 1) (by omega) (by omega)
        have hxk_ne : x_k ≠ x :=
          h_x_ne_of_add_ne_zero_of_sub_ne_zero h_k h h_add_ne h_sub_ne
        have hAk : x_k * (D k).eval x = (A k).eval x := div_mul_cancel₀ _ hDk
        have hAkm1 : x_km1 * (D (k - 1)).eval x = (A (k - 1)).eval x := div_mul_cancel₀ _ hDkm1
        obtain ⟨h_rec1_eval, h_rec2_eval⟩ := h_rec_eval k hk
        have h_diff_ne : (A k).eval x - x * (D k).eval x ≠ 0 := by
          rw [← hAk, ← sub_mul]
          exact mul_ne_zero (sub_ne_zero.mpr hxk_ne) hDk
        have hDkp1 : (D (k + 1)).eval x ≠ 0 := by
          have h_prod_ne : (D (k + 1)).eval x * (D (k - 1)).eval x ≠ 0 := by
            rw [h_rec1_eval]
            exact pow_ne_zero 2 h_diff_ne
          exact left_ne_zero_of_mul h_prod_ne
        let L_p := W.slope x_k x y_k y
        let L_m := W.slope x_k x y_k (W.negY x y)
        let x_p := W.addX x_k x L_p
        let x_m := W.addX x_k x L_m
        have h_kp1_some : (k + 1) • P = WeierstrassCurve.Affine.Point.some
            (W.nonsingular_add h_k h (fun hxy => hxk_ne hxy.1)) := by
          rw [← h_kp1_add, hkP]
          exact WeierstrassCurve.Affine.Point.add_of_X_ne hxk_ne
        have h_km1_some : (k - 1) • P = WeierstrassCurve.Affine.Point.some
            (W.nonsingular_add h_k ((W.nonsingular_neg x y).mpr h) (fun hxy => hxk_ne hxy.1)) := by
          rw [← h_km1_sub, hkP, sub_eq_add_neg, WeierstrassCurve.Affine.Point.neg_some h]
          exact WeierstrassCurve.Affine.Point.add_of_X_ne hxk_ne
        have hxm_eq : x_m = x_km1 := by
          have h_eq := h_km1_some.symm.trans hkm1P
          rw [WeierstrassCurve.Affine.Point.some.injEq] at h_eq
          exact h_eq.1
        have h_chord : (x_k - x) ^ 2 * (x_p + x_km1) =
            2 * x * x_k * (x + x_k) + W.b₂ * x * x_k + W.b₄ * (x + x_k) + W.b₆ := by
          rw [← hxm_eq]
          exact h_chord_sum h_k h hxk_ne
        rw [← hAk] at h_rec1_eval
        rw [← hAk, ← hAkm1] at h_rec2_eval
        have h_prod_eq : (D (k - 1)).eval x * (x_p * (D (k + 1)).eval x - (A (k + 1)).eval x) = 0 := by
          linear_combination
            (x_p + x_km1) * h_rec1_eval - h_rec2_eval + (D k).eval x ^ 2 * h_chord
        have hxp_mul : x_p * (D (k + 1)).eval x = (A (k + 1)).eval x :=
          sub_eq_zero.mp ((mul_eq_zero.mp h_prod_eq).resolve_left hDkm1)
        have hxp_eq : x_p = (A (k + 1)).eval x / (D (k + 1)).eval x :=
          (eq_div_iff hDkp1).mpr hxp_mul
        rw [hm_eq]
        obtain ⟨h_kp1, h_kp1_eq⟩ :=
          h_cast_some hxp_eq (W.nonsingular_add h_k h (fun hxy => hxk_ne hxy.1))
        exact ⟨hDkp1, W.addY x_k x y_k L_p, h_kp1, h_kp1_some.trans h_kp1_eq⟩
  have h_conv : (∀ j : ℕ, 1 ≤ j → j ≤ n → (D j).eval x ≠ 0) →
      ∀ j : ℕ, 1 ≤ j → j ≤ n → j • P ≠ 0 := by
    intro hD_nz j
    induction' j using Nat.strong_induction_on with j ih
    intro hj1 hjn
    rcases eq_or_lt_of_le hj1 with rfl | hj2
    · rw [one_nsmul]
      exact h_some_ne_zero h
    · rcases eq_or_lt_of_le (show 2 ≤ j by omega) with rfl | hj3
      · exact mt h_two_nsmul_eq_zero_iff.mp (hD_nz 2 (by omega) hjn)
      · set k := j - 1
        have hk : 2 ≤ k := by omega
        have hj_eq : j = k + 1 := by omega
        obtain ⟨hDk, y_k, h_k, hkP⟩ :=
          h_fwd k (by omega) (fun i hi1 hik => ih i (by omega) hi1 (by omega))
        intro hj_zero
        have h_add_zero : (WeierstrassCurve.Affine.Point.some h_k : W.Point) +
            WeierstrassCurve.Affine.Point.some h = 0 := by
          rw [← hkP, (succ_nsmul P k).symm, ← hj_eq]
          exact hj_zero
        have hx_eq : (A k).eval x / (D k).eval x = x :=
          ((h_add_eq_zero_iff h_k h).mp h_add_zero).1
        have hAk_eq : (A k).eval x - x * (D k).eval x = 0 := by
          rw [← div_mul_cancel₀ ((A k).eval x) hDk, hx_eq, sub_self]
        have h_rec1_eval := (h_rec_eval k hk).1
        rw [hAk_eq, sq, mul_zero] at h_rec1_eval
        exact mul_ne_zero (hD_nz (k + 1) (by omega) (by omega))
          (hD_nz (k - 1) (by omega) (by omega)) h_rec1_eval
  exact ⟨h_fwd n hn, h_conv⟩

theorem weierstrass_nsmul_surjective_and_torsion_card_of_eval (K : Type u) [Field K]
    [IsAlgClosed K] [DecidableEq K] (W : WeierstrassCurve.Affine K) (hΔ : W.Δ ≠ 0)
    (A D : ℕ → Polynomial K)
    (hD2 : D 2 = 4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2 +
      2 * Polynomial.C W.b₄ * Polynomial.X + Polynomial.C W.b₆)
    (h_deg : ∀ k : ℕ, 1 ≤ k →
      (A k).Monic ∧
      (A k).natDegree = k ^ 2 ∧
      IsCoprime (A k) (D k) ∧
      (D k).natDegree ≤ k ^ 2 - 1 ∧
      (D k).coeff (k ^ 2 - 1) = (k : K) ^ 2)
    (h_eval : ∀ (n : ℕ), 1 ≤ n → ∀ {x y : K} (h : W.Nonsingular x y),
      ((∀ j : ℕ, 1 ≤ j → j ≤ n → j • (WeierstrassCurve.Affine.Point.some h : W.Point) ≠ 0) →
        (D n).eval x ≠ 0 ∧
        ∃ (y_n : K) (h_n : W.Nonsingular ((A n).eval x / (D n).eval x) y_n),
          n • (WeierstrassCurve.Affine.Point.some h : W.Point) =
            WeierstrassCurve.Affine.Point.some h_n) ∧
      ((∀ j : ℕ, 1 ≤ j → j ≤ n → (D j).eval x ≠ 0) →
        ∀ j : ℕ, 1 ≤ j → j ≤ n → j • (WeierstrassCurve.Affine.Point.some h : W.Point) ≠ 0))
    (m : ℕ) (hm : 1 ≤ m) (hm_K : (m : K) ≠ 0) :
    (∀ Q : W.Point, ∃ P : W.Point, m • P = Q) ∧
    Nat.card {P : W.Point | m • P = 0} = m ^ 2 :=
by
  classical
  
  haveI : W.IsElliptic := ⟨IsUnit.mk0 W.Δ hΔ⟩
  have h_exists : ∀ x : K, ∃ y : K, W.Nonsingular x y := by
    intro x
    let P_Y : Polynomial K :=
      Polynomial.X ^ 2 + Polynomial.C (W.a₁ * x + W.a₃) * Polynomial.X -
        Polynomial.C (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)
    have h_deg_PY : P_Y.degree ≠ 0 := by
      have hd : P_Y.degree = 2 := by
        dsimp [P_Y]
        rw [Polynomial.degree_sub_eq_left_of_degree_lt]
        · rw [Polynomial.degree_add_eq_left_of_degree_lt]
          · exact Polynomial.degree_X_pow 2
          · exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le _)
              (by rw [Polynomial.degree_X_pow]; exact WithBot.coe_lt_coe.mpr (by omega))
        · rw [Polynomial.degree_add_eq_left_of_degree_lt]
          · exact lt_of_le_of_lt Polynomial.degree_C_le
              (by rw [Polynomial.degree_X_pow]; exact WithBot.coe_lt_coe.mpr (by omega))
          · exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le _)
              (by rw [Polynomial.degree_X_pow]; exact WithBot.coe_lt_coe.mpr (by omega))
      rw [hd]
      decide
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_root P_Y h_deg_PY
    refine ⟨y, (WeierstrassCurve.Affine.equation_iff_nonsingular).mp ?_⟩
    rw [W.equation_iff']
    have hy' : P_Y.eval y = 0 := hy
    dsimp [P_Y] at hy'
    simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_pow,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X] at hy'
    linear_combination hy'
  have h_dich : ∀ {x y₁ y₂ : K} (h₁ : W.Nonsingular x y₁) (h₂ : W.Nonsingular x y₂),
      (WeierstrassCurve.Affine.Point.some h₁ : W.Point) =
        WeierstrassCurve.Affine.Point.some h₂ ∨
      (WeierstrassCurve.Affine.Point.some h₁ : W.Point) =
        -WeierstrassCurve.Affine.Point.some h₂ := by
    intro x y₁ y₂ h₁ h₂
    by_cases hy : y₁ = W.negY x y₂
    · right
      rw [WeierstrassCurve.Affine.Point.neg_some h₂,
        WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨rfl, hy⟩
    · left
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨rfl, WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂.1 rfl hy⟩
  have h_ne_neg : ∀ {x y : K} (h : W.Nonsingular x y), (D 2).eval x ≠ 0 →
      (WeierstrassCurve.Affine.Point.some h : W.Point) ≠
        -WeierstrassCurve.Affine.Point.some h := by
    intro x y h hD2_x h_eq
    rw [WeierstrassCurve.Affine.Point.neg_some h,
      WeierstrassCurve.Affine.Point.some.injEq] at h_eq
    have hy_eq : y = -y - W.a₁ * x - W.a₃ := h_eq.2
    have h_curve : y ^ 2 + W.a₁ * x * y + W.a₃ * y -
        (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) = 0 :=
      (W.equation_iff' x y).mp h.1
    apply hD2_x
    rw [hD2]
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_ofNat,
      WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆]
    linear_combination -4 * h_curve + (2 * y + W.a₁ * x + W.a₃) * hy_eq
  
  have hD_ne : ∀ k : ℕ, 1 ≤ k → D k ≠ 0 := by
    intro k hk hD0
    have h_deg_k := h_deg k hk
    have h_cop_k : IsCoprime (A k) 0 := hD0 ▸ h_deg_k.2.2.1
    have h_unit : IsUnit (A k) := isCoprime_zero_right.mp h_cop_k
    have h_pos : 0 < (A k).natDegree := by
      rw [h_deg_k.2.1]
      nlinarith
    exact Polynomial.not_isUnit_of_natDegree_pos (A k) h_pos h_unit
  let d : ℕ := m ^ 2
  have hd : 1 ≤ d := by dsimp [d]; nlinarith
  have hA_monic : (A m).Monic := (h_deg m hm).1
  have hA_deg : (A m).natDegree = d := (h_deg m hm).2.1
  have h_cop : IsCoprime (A m) (D m) := (h_deg m hm).2.2.1
  have hD_deg : (D m).natDegree ≤ d - 1 := (h_deg m hm).2.2.2.1
  have hD_top : (D m).coeff (d - 1) ≠ 0 := by
    change (D m).coeff (m ^ 2 - 1) ≠ 0
    rw [(h_deg m hm).2.2.2.2]
    exact pow_ne_zero 2 hm_K
  let B_z : Finset K :=
    (D 2).roots.toFinset ∪ (Finset.Icc 1 m).biUnion (fun j => (D j).roots.toFinset)
  have h_coeff_mul : ∀ {P Q : Polynomial K} {M N : ℕ},
      P.natDegree ≤ M → Q.natDegree ≤ N →
      (P * Q).coeff (M + N) = P.coeff M * Q.coeff N := by
    intro P Q M N hP hQ
    rw [Polynomial.coeff_mul, Finset.sum_eq_single (M, N)]
    · intro b hb hne
      rw [Finset.mem_antidiagonal] at hb
      by_cases h1 : M < b.1
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hP h1), zero_mul]
      · have h2 : N < b.2 := by
          have : b.1 ≠ M ∨ b.2 ≠ N :=
            not_and_or.mp (fun h_and => hne (Prod.ext h_and.1 h_and.2))
          omega
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hQ h2), mul_zero]
    · intro h_not
      exfalso
      exact h_not (Finset.mem_antidiagonal.mpr rfl)
  let W_AD : Polynomial K := (A m).derivative * (D m) - (A m) * (D m).derivative
  have hA_coeff_d : (A m).coeff d = 1 := by
    rw [← hA_deg]
    exact hA_monic.leadingCoeff
  have hW_coeff : W_AD.coeff (2 * d - 2) = (D m).coeff (d - 1) := by
    dsimp [W_AD]
    rw [Polynomial.coeff_sub]
    have h1 : ((A m).derivative * (D m)).coeff (2 * d - 2) = (d : K) * (D m).coeff (d - 1) := by
      have h_sum : 2 * d - 2 = (d - 1) + (d - 1) := by omega
      rw [h_sum, h_coeff_mul (hA_deg ▸ Polynomial.natDegree_derivative_le (A m)) hD_deg]
      rw [Polynomial.coeff_derivative]
      have hd1 : d - 1 + 1 = d := by omega
      have hd_cast : ((d - 1 : ℕ) + 1 : K) = (d : K) := by
        have h_k : (((d - 1) + 1 : ℕ) : K) = (d : K) := congrArg Nat.cast hd1
        push_cast at h_k
        exact h_k
      rw [hd1, hA_coeff_d, one_mul, hd_cast]
    have h2 : ((A m) * (D m).derivative).coeff (2 * d - 2) = (D m).coeff (d - 1) * ((d : K) - 1) := by
      rcases eq_or_ne d 1 with hd_eq1 | hd_ne
      · have hD_deg0 : (D m).natDegree ≤ 0 := by omega
        have hD_zero : D m = Polynomial.C ((D m).coeff 0) :=
          Polynomial.eq_C_of_natDegree_le_zero hD_deg0
        have hD_der : (D m).derivative = 0 := by
          rw [hD_zero, Polynomial.derivative_C]
        rw [hD_der, mul_zero, Polynomial.coeff_zero, hd_eq1, Nat.cast_one, sub_self, mul_zero]
      · have h_sum : 2 * d - 2 = d + (d - 2) := by omega
        have hD_der_deg : (D m).derivative.natDegree ≤ d - 2 :=
          le_trans (Polynomial.natDegree_derivative_le (D m)) (by omega)
        rw [h_sum, h_coeff_mul (le_of_eq hA_deg) hD_der_deg, hA_coeff_d, one_mul,
          Polynomial.coeff_derivative]
        have hd2 : d - 2 + 1 = d - 1 := by omega
        rw [hd2]
        have hd_cast : ((d - 2 : ℕ) + 1 : K) = (d : K) - 1 := by
          have h_nat : (d - 2) + 1 + 1 = d := by omega
          have h_k : (((d - 2) + 1 + 1 : ℕ) : K) = (d : K) := congrArg Nat.cast h_nat
          push_cast at h_k
          linear_combination h_k
        rw [hd_cast]
    rw [h1, h2]
    ring
  have hW_ne : W_AD ≠ 0 := by
    intro h0
    apply hD_top
    rw [← hW_coeff, h0, Polynomial.coeff_zero]
  let S_bad : Finset K :=
    (W_AD.roots.toFinset ∪ B_z).image (fun z => (A m).eval z / (D m).eval z)
  have hS_bad : ∀ x' : K, x' ∉ S_bad →
      ((A m - Polynomial.C x' * D m).roots.toFinset).card = d ∧
      (∀ z : K, z ∈ (A m - Polynomial.C x' * D m).roots.toFinset ↔
        ((D m).eval z ≠ 0 ∧ (A m).eval z / (D m).eval z = x')) ∧
      (∀ z ∈ (A m - Polynomial.C x' * D m).roots.toFinset, z ∉ B_z) := by
    intro x' hx'
    let H : Polynomial K := A m - Polynomial.C x' * D m
    have hCD_lt : (Polynomial.C x' * D m).natDegree < (A m).natDegree := by
      calc (Polynomial.C x' * D m).natDegree ≤ (D m).natDegree := Polynomial.natDegree_C_mul_le x' (D m)
        _ ≤ d - 1 := hD_deg
        _ < d := by omega
        _ = (A m).natDegree := hA_deg.symm
    have hH_monic : H.Monic := hA_monic.sub_of_left (Polynomial.degree_lt_degree hCD_lt)
    have hH_deg : H.natDegree = d := by
      dsimp [H]
      rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt hCD_lt, hA_deg]
    have hH_ne : H ≠ 0 := hH_monic.ne_zero
    have h_root_iff : ∀ z : K, z ∈ H.roots.toFinset ↔ ((D m).eval z ≠ 0 ∧ (A m).eval z / (D m).eval z = x') := by
      intro z
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hH_ne, Polynomial.IsRoot.def]
      dsimp [H]
      simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C]
      constructor
      · intro hz
        have hDz : (D m).eval z ≠ 0 := by
          intro hD0
          rw [hD0, mul_zero, sub_zero] at hz
          rcases h_cop with ⟨u, v, huv⟩
          have h1 := congrArg (Polynomial.eval z) huv
          simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_one,
            hz, hD0, mul_zero, add_zero] at h1
          exact zero_ne_one h1
        refine ⟨hDz, ?_⟩
        rw [div_eq_iff hDz]
        linear_combination hz
      · rintro ⟨hDz, hx'_eq⟩
        rw [div_eq_iff hDz] at hx'_eq
        linear_combination hx'_eq
    have h_not_W_Bz : ∀ z ∈ H.roots.toFinset, z ∉ W_AD.roots.toFinset ∪ B_z := by
      intro z hz h_in
      apply hx'
      rw [← ((h_root_iff z).mp hz).2]
      exact Finset.mem_image_of_mem (fun w => (A m).eval w / (D m).eval w) h_in
    have h_not_Bz : ∀ z ∈ H.roots.toFinset, z ∉ B_z :=
      fun z hz h_in => h_not_W_Bz z hz (Finset.mem_union_right _ h_in)
    have h_id : D m * H.derivative - (D m).derivative * H = W_AD := by
      dsimp [H, W_AD]
      simp only [Polynomial.derivative_sub, Polynomial.derivative_mul,
        Polynomial.derivative_C, zero_mul, zero_add]
      ring
    have h_sep : IsCoprime H H.derivative := by
      rw [← EuclideanDomain.gcd_isUnit_iff]
      by_contra h_not_unit
      let g := EuclideanDomain.gcd H H.derivative
      have hg_dvd_H : g ∣ H := EuclideanDomain.gcd_dvd_left H H.derivative
      have hg_dvd_H' : g ∣ H.derivative := EuclideanDomain.gcd_dvd_right H H.derivative
      have hg_deg : g.degree ≠ 0 :=
        mt Polynomial.isUnit_iff_degree_eq_zero.mpr h_not_unit
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root g hg_deg
      have hHz : H.eval z = 0 :=
        Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero hg_dvd_H hz
      have hH'z : H.derivative.eval z = 0 :=
        Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero hg_dvd_H' hz
      have hWz : W_AD.eval z = 0 := by
        have := congrArg (Polynomial.eval z) h_id
        simp only [Polynomial.eval_sub, Polynomial.eval_mul, hHz, hH'z,
          mul_zero, sub_zero] at this
        exact this.symm
      have hz_H : z ∈ H.roots.toFinset := by
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hH_ne]
        exact hHz
      have hz_W : z ∈ W_AD.roots.toFinset := by
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hW_ne]
        exact hWz
      exact h_not_W_Bz z hz_H (Finset.mem_union_left _ hz_W)
    have h_card : H.roots.toFinset.card = d := by
      rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots h_sep),
        ← Polynomial.Splits.natDegree_eq_card_roots (IsAlgClosed.splits H), hH_deg]
    exact ⟨h_card, h_root_iff, h_not_Bz⟩
  
  let y_lift (x : K) : K := (h_exists x).choose
  let h_lift (x : K) : W.Nonsingular x (y_lift x) := (h_exists x).choose_spec
  let P_lift (x : K) : W.Point := WeierstrassCurve.Affine.Point.some (h_lift x)
  have h_gen : ∀ x' : K, x' ∉ S_bad →
      ∃ (P : W.Point) (y' : K) (h' : W.Nonsingular x' y'),
        m • P = WeierstrassCurve.Affine.Point.some h' := by
    intro x' hx'
    obtain ⟨h_card, h_iff, h_not_Bz⟩ := hS_bad x' hx'
    have h_nonempty : (A m - Polynomial.C x' * D m).roots.toFinset.Nonempty :=
      Finset.card_pos.mp (by rw [h_card]; omega)
    obtain ⟨z, hz⟩ := h_nonempty
    have hz_not_Bz : z ∉ B_z := h_not_Bz z hz
    have hz_Dj : ∀ j : ℕ, 1 ≤ j → j ≤ m → (D j).eval z ≠ 0 := by
      intro j hj1 hjm hDj0
      apply hz_not_Bz
      apply Finset.mem_union_right
      rw [Finset.mem_biUnion]
      refine ⟨j, Finset.mem_Icc.mpr ⟨hj1, hjm⟩, ?_⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_roots (hD_ne j hj1)]
      exact hDj0
    have h_nz := (h_eval m hm (h_lift z)).2 hz_Dj
    obtain ⟨_, y_m, h_m, hm_eq⟩ := (h_eval m hm (h_lift z)).1 h_nz
    have hx'_eq : (A m).eval z / (D m).eval z = x' := ((h_iff z).mp hz).2
    have h_m' : W.Nonsingular x' y_m := hx'_eq ▸ h_m
    refine ⟨P_lift z, y_m, h_m', hm_eq.trans ?_⟩
    rw [WeierstrassCurve.Affine.Point.some.injEq]
    exact ⟨hx'_eq, rfl⟩
  have h_surj : ∀ Q : W.Point, ∃ P : W.Point, m • P = Q := by
    have h_im_of_notMem : ∀ {x y : K} (h : W.Nonsingular x y), x ∉ S_bad →
        ∃ P : W.Point, m • P = WeierstrassCurve.Affine.Point.some h := by
      intro x y h hx
      obtain ⟨P, y', h', hP⟩ := h_gen x hx
      rcases h_dich h h' with heq | heq
      · exact ⟨P, hP.trans heq.symm⟩
      · refine ⟨-P, ?_⟩
        rw [smul_neg, hP, heq]
    let F_bad : Finset W.Point :=
      S_bad.image P_lift ∪ S_bad.image (fun x => -P_lift x)
    have h_im_of_not_bad : ∀ R : W.Point, R ∉ F_bad → ∃ P : W.Point, m • P = R := by
      intro R hR
      cases R with
      | zero => exact ⟨0, nsmul_zero m⟩
      | @some x_R y_R h_R =>
        apply h_im_of_notMem h_R
        intro hx_R
        apply hR
        rcases h_dich h_R (h_lift x_R) with heq | heq
        · rw [heq]
          exact Finset.mem_union_left _ (Finset.mem_image_of_mem P_lift hx_R)
        · rw [heq]
          exact Finset.mem_union_right _ (Finset.mem_image_of_mem (fun x => -P_lift x) hx_R)
    intro Q
    let F_Q : Finset W.Point := F_bad ∪ F_bad.image (fun R => Q - R)
    let coordX : W.Point → K := fun P =>
      match P with
      | 0 => 0
      | @WeierstrassCurve.Affine.Point.some _ _ _ x _ _ => x
    obtain ⟨x₀, hx₀⟩ := Infinite.exists_notMem_finset (F_Q.image coordX)
    have hP₀_not_FQ : P_lift x₀ ∉ F_Q := by
      intro h_in
      apply hx₀
      have h_cx : coordX (P_lift x₀) = x₀ := rfl
      rw [← h_cx]
      exact Finset.mem_image_of_mem coordX h_in
    have hP₀_not_bad : P_lift x₀ ∉ F_bad :=
      fun h_in => hP₀_not_FQ (Finset.mem_union_left _ h_in)
    have hQ_sub_not_bad : Q - P_lift x₀ ∉ F_bad := by
      intro h_in
      apply hP₀_not_FQ
      apply Finset.mem_union_right
      have h_eq : Q - (Q - P_lift x₀) = P_lift x₀ := sub_sub_cancel Q (P_lift x₀)
      rw [← h_eq]
      exact Finset.mem_image_of_mem (fun R => Q - R) h_in
    obtain ⟨P₁, hP₁⟩ := h_im_of_not_bad (P_lift x₀) hP₀_not_bad
    obtain ⟨P₂, hP₂⟩ := h_im_of_not_bad (Q - P_lift x₀) hQ_sub_not_bad
    refine ⟨P₁ + P₂, ?_⟩
    rw [nsmul_add, hP₁, hP₂, add_sub_cancel]
  
  let S_crit : Finset K :=
    S_bad ∪ (D 2).roots.toFinset ∪ (Finset.Icc 1 (m ^ 2)).biUnion (fun k => (D k).roots.toFinset)
  obtain ⟨x_Q, hx_Q⟩ := Infinite.exists_notMem_finset S_crit
  have hxQ_not_bad : x_Q ∉ S_bad :=
    fun h => hx_Q (Finset.mem_union_left _ (Finset.mem_union_left _ h))
  have hxQ_D2 : (D 2).eval x_Q ≠ 0 := by
    intro h0
    apply hx_Q
    apply Finset.mem_union_left
    apply Finset.mem_union_right
    rw [Multiset.mem_toFinset, Polynomial.mem_roots (hD_ne 2 (by omega))]
    exact h0
  have hxQ_Dm2 : ∀ k : ℕ, 1 ≤ k → k ≤ m ^ 2 → (D k).eval x_Q ≠ 0 := by
    intro k hk1 hkm2 h0
    apply hx_Q
    apply Finset.mem_union_right
    rw [Finset.mem_biUnion]
    refine ⟨k, Finset.mem_Icc.mpr ⟨hk1, hkm2⟩, ?_⟩
    rw [Multiset.mem_toFinset, Polynomial.mem_roots (hD_ne k hk1)]
    exact h0
  let R_Q : Finset K := (A m - Polynomial.C x_Q * D m).roots.toFinset
  obtain ⟨hR_card, hR_iff, hR_not_Bz⟩ := hS_bad x_Q hxQ_not_bad
  have hR_D2 : ∀ z ∈ R_Q, (D 2).eval z ≠ 0 := by
    intro z hz h0
    apply hR_not_Bz z hz
    apply Finset.mem_union_left
    rw [Multiset.mem_toFinset, Polynomial.mem_roots (hD_ne 2 (by omega))]
    exact h0
  have hR_Dj : ∀ z ∈ R_Q, ∀ j : ℕ, 1 ≤ j → j ≤ m → (D j).eval z ≠ 0 := by
    intro z hz j hj1 hjm h0
    apply hR_not_Bz z hz
    apply Finset.mem_union_right
    rw [Finset.mem_biUnion]
    refine ⟨j, Finset.mem_Icc.mpr ⟨hj1, hjm⟩, ?_⟩
    rw [Multiset.mem_toFinset, Polynomial.mem_roots (hD_ne j hj1)]
    exact h0
  let Q : W.Point := P_lift x_Q
  have hQ_ne_neg : Q ≠ -Q := h_ne_neg (h_lift x_Q) hxQ_D2
  have hQ_nsmul : ∀ k : ℕ, 1 ≤ k → k ≤ m ^ 2 → k • Q ≠ 0 :=
    (h_eval (m ^ 2) hd (h_lift x_Q)).2 hxQ_Dm2
  let F_Q : Set W.Point := {P : W.Point | m • P = Q ∨ m • P = -Q}
  have h_z_FQ : ∀ z ∈ R_Q, P_lift z ∈ F_Q ∧ -P_lift z ∈ F_Q ∧ P_lift z ≠ -P_lift z := by
    intro z hz
    have h_ne : P_lift z ≠ -P_lift z := h_ne_neg (h_lift z) (hR_D2 z hz)
    have h_nz : ∀ j : ℕ, 1 ≤ j → j ≤ m → j • P_lift z ≠ 0 :=
      (h_eval m hm (h_lift z)).2 (hR_Dj z hz)
    obtain ⟨_, y_m, h_m, hm_eq⟩ := (h_eval m hm (h_lift z)).1 h_nz
    have hx_eq : (A m).eval z / (D m).eval z = x_Q := ((hR_iff z).mp hz).2
    have h_m' : W.Nonsingular x_Q y_m := hx_eq ▸ h_m
    have h_pt : (WeierstrassCurve.Affine.Point.some h_m : W.Point) =
        WeierstrassCurve.Affine.Point.some h_m' := by
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨hx_eq, rfl⟩
    have hm_Q : m • P_lift z = Q ∨ m • P_lift z = -Q := by
      rw [hm_eq, h_pt]
      exact h_dich h_m' (h_lift x_Q)
    refine ⟨hm_Q, ?_, h_ne⟩
    change m • (-P_lift z) = Q ∨ m • (-P_lift z) = -Q
    rw [smul_neg]
    rcases hm_Q with h1 | h1
    · right; rw [h1]
    · left; rw [h1, neg_neg]
  have h_FQ_z : ∀ P ∈ F_Q, ∃ z ∈ R_Q, P = P_lift z ∨ P = -P_lift z := by
    intro P hP
    have h_nz : ∀ j : ℕ, 1 ≤ j → j ≤ m → j • P ≠ 0 := by
      intro j hj1 hjm hj0
      have hjm_0 : (j * m) • P = 0 := by
        rw [mul_comm, mul_nsmul', hj0, nsmul_zero]
      rcases hP with hPQ | hPQ
      · have : (j * m) • P = j • Q := by
          rw [mul_nsmul', hPQ]
        rw [hjm_0] at this
        exact hQ_nsmul j hj1 (by nlinarith) this.symm
      · have : (j * m) • P = -(j • Q) := by
          rw [mul_nsmul', hPQ, smul_neg]
        rw [hjm_0, eq_comm, neg_eq_zero] at this
        exact hQ_nsmul j hj1 (by nlinarith) this
    cases P with
    | zero =>
      exfalso
      exact h_nz 1 le_rfl hm (nsmul_zero 1)
    | @some z y h_P =>
      obtain ⟨hDm_ne, y_m, h_m, hm_eq⟩ := (h_eval m hm h_P).1 h_nz
      have hx_eq : (A m).eval z / (D m).eval z = x_Q := by
        rcases hP with hPQ | hPQ
        · rw [hm_eq, WeierstrassCurve.Affine.Point.some.injEq] at hPQ
          exact hPQ.1
        · rw [hm_eq, WeierstrassCurve.Affine.Point.neg_some (h_lift x_Q),
            WeierstrassCurve.Affine.Point.some.injEq] at hPQ
          exact hPQ.1
      have hz : z ∈ R_Q := (hR_iff z).mpr ⟨hDm_ne, hx_eq⟩
      exact ⟨z, hz, h_dich h_P (h_lift z)⟩
  let α : R_Q ⊕ R_Q → F_Q := fun s =>
    match s with
    | Sum.inl z => ⟨P_lift z.1, (h_z_FQ z.1 z.2).1⟩
    | Sum.inr z => ⟨-P_lift z.1, (h_z_FQ z.1 z.2).2.1⟩
  have hP_x : ∀ z₁ z₂ : K,
      (P_lift z₁ = P_lift z₂ → z₁ = z₂) ∧
      (-P_lift z₁ = -P_lift z₂ → z₁ = z₂) ∧
      (P_lift z₁ = -P_lift z₂ → z₁ = z₂) := by
    intro z₁ z₂
    refine ⟨?_, ?_, ?_⟩
    · intro h
      exact (WeierstrassCurve.Affine.Point.some.inj h).1
    · intro h
      have h' := neg_inj.mp h
      exact (WeierstrassCurve.Affine.Point.some.inj h').1
    · intro h
      rw [WeierstrassCurve.Affine.Point.neg_some (h_lift z₂),
        WeierstrassCurve.Affine.Point.some.injEq] at h
      exact h.1
  have hα_bij : Function.Bijective α := by
    constructor
    · rintro (⟨z₁, hz₁⟩ | ⟨z₁, hz₁⟩) (⟨z₂, hz₂⟩ | ⟨z₂, hz₂⟩) h_eq
      · have h_val : P_lift z₁ = P_lift z₂ := congrArg Subtype.val h_eq
        have hz : z₁ = z₂ := (hP_x z₁ z₂).1 h_val
        subst hz; rfl
      · have h_val : P_lift z₁ = -P_lift z₂ := congrArg Subtype.val h_eq
        have hz : z₁ = z₂ := (hP_x z₁ z₂).2.2 h_val
        subst hz
        exfalso
        exact (h_z_FQ z₁ hz₁).2.2 h_val
      · have h_val : -P_lift z₁ = P_lift z₂ := congrArg Subtype.val h_eq
        have hz : z₂ = z₁ := (hP_x z₂ z₁).2.2 h_val.symm
        subst hz
        exfalso
        exact (h_z_FQ z₂ hz₂).2.2 h_val.symm
      · have h_val : -P_lift z₁ = -P_lift z₂ := congrArg Subtype.val h_eq
        have hz : z₁ = z₂ := (hP_x z₁ z₂).2.1 h_val
        subst hz; rfl
    · rintro ⟨P, hP⟩
      obtain ⟨z, hz, h_or⟩ := h_FQ_z P hP
      rcases h_or with h1 | h1
      · exact ⟨Sum.inl ⟨z, hz⟩, Subtype.ext h1.symm⟩
      · exact ⟨Sum.inr ⟨z, hz⟩, Subtype.ext h1.symm⟩
  have hFQ_card : Nat.card F_Q = m ^ 2 + m ^ 2 := by
    rw [← Nat.card_eq_of_bijective α hα_bij, Nat.card_sum,
      Nat.card_eq_fintype_card, Fintype.card_coe, hR_card]
  have hR_nonempty : R_Q.Nonempty := Finset.card_pos.mp (by rw [hR_card]; omega)
  obtain ⟨z₀, hz₀⟩ := hR_nonempty
  have hP₀_ex : ∃ P₀ : W.Point, m • P₀ = Q := by
    rcases (h_z_FQ z₀ hz₀).1 with h1 | h1
    · exact ⟨P_lift z₀, h1⟩
    · refine ⟨-P_lift z₀, ?_⟩
      rw [smul_neg, h1, neg_neg]
  obtain ⟨P₀, hP₀⟩ := hP₀_ex
  let K_m : Set W.Point := {P : W.Point | m • P = 0}
  let β : K_m ⊕ K_m → F_Q := fun s =>
    match s with
    | Sum.inl T => ⟨P₀ + T.1, Or.inl (by rw [nsmul_add, hP₀, T.2, add_zero])⟩
    | Sum.inr T => ⟨-P₀ + T.1, Or.inr (by rw [nsmul_add, smul_neg, hP₀, T.2, add_zero])⟩
  have hβ_bij : Function.Bijective β := by
    constructor
    · rintro (⟨T₁, hT₁⟩ | ⟨T₁, hT₁⟩) (⟨T₂, hT₂⟩ | ⟨T₂, hT₂⟩) h_eq
      · have h_val : P₀ + T₁ = P₀ + T₂ := congrArg Subtype.val h_eq
        exact congrArg Sum.inl (Subtype.ext (add_left_cancel h_val))
      · have h_val : P₀ + T₁ = -P₀ + T₂ := congrArg Subtype.val h_eq
        exfalso
        have hm_eq : m • (P₀ + T₁) = m • (-P₀ + T₂) := congrArg (fun P => m • P) h_val
        have hT₁' : m • T₁ = 0 := hT₁
        have hT₂' : m • T₂ = 0 := hT₂
        rw [nsmul_add, nsmul_add, smul_neg, hP₀, hT₁', hT₂', add_zero, add_zero] at hm_eq
        exact hQ_ne_neg hm_eq
      · have h_val : -P₀ + T₁ = P₀ + T₂ := congrArg Subtype.val h_eq
        exfalso
        have hm_eq : m • (-P₀ + T₁) = m • (P₀ + T₂) := congrArg (fun P => m • P) h_val
        have hT₁' : m • T₁ = 0 := hT₁
        have hT₂' : m • T₂ = 0 := hT₂
        rw [nsmul_add, nsmul_add, smul_neg, hP₀, hT₁', hT₂', add_zero, add_zero] at hm_eq
        exact hQ_ne_neg hm_eq.symm
      · have h_val : -P₀ + T₁ = -P₀ + T₂ := congrArg Subtype.val h_eq
        exact congrArg Sum.inr (Subtype.ext (add_left_cancel h_val))
    · rintro ⟨P, hP⟩
      rcases hP with hPQ | hPQ
      · have hT : P - P₀ ∈ K_m := by
          change m • (P - P₀) = 0
          rw [nsmul_sub, hPQ, hP₀, sub_self]
        exact ⟨Sum.inl ⟨P - P₀, hT⟩, Subtype.ext (add_sub_cancel P₀ P)⟩
      · have hT : P + P₀ ∈ K_m := by
          change m • (P + P₀) = 0
          rw [nsmul_add, hPQ, hP₀, neg_add_cancel]
        refine ⟨Sum.inr ⟨P + P₀, hT⟩, Subtype.ext ?_⟩
        dsimp [β]
        rw [add_comm P P₀, neg_add_cancel_left]
  haveI : Finite F_Q := Finite.of_surjective α hα_bij.2
  haveI : Finite (K_m ⊕ K_m) := Finite.of_injective β hβ_bij.1
  haveI : Finite K_m := Finite.of_injective (Sum.inl : K_m → K_m ⊕ K_m) Sum.inl_injective
  have hKm_sum : Nat.card K_m + Nat.card K_m = m ^ 2 + m ^ 2 := by
    rw [← Nat.card_sum, Nat.card_eq_of_bijective β hβ_bij, hFQ_card]
  have h_card_Km : Nat.card K_m = m ^ 2 := by omega
  exact ⟨h_surj, h_card_Km⟩

theorem vBar_finrank_eq_two_of_delta_ne_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0) :
    Module.finrank (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) = 2 :=
by
  classical
  let K := AlgebraicClosure F
  let W : WeierstrassCurve.Affine K := (E.baseChange K).toAffine
  have hΔ_W : W.Δ ≠ 0 := by
    change (E.map (algebraMap F K)).Δ ≠ 0
    rw [WeierstrassCurve.map_Δ]
    exact (map_ne_zero_iff _ (algebraMap F K).injective).mpr hΔ
  have h_ell_pos : 1 ≤ EllipticRootNumber.ell F :=
    Nat.Prime.one_le (EllipticRootNumber.ell_prime F).out
  have h_ell_ne : (EllipticRootNumber.ell F : K) ≠ 0 := by
    intro h0
    have h0_F : (EllipticRootNumber.ell F : F) = 0 := by
      apply (algebraMap F K).injective
      rw [map_natCast, map_zero]
      exact h0
    have h0_O : (EllipticRootNumber.ell F : (ValuativeRel.valuation F).integer) = 0 := by
      apply Subtype.ext
      exact h0_F
    have h0_k : (EllipticRootNumber.ell F :
        IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) = 0 := by
      have := congrArg (IsLocalRing.residue (ValuativeRel.valuation F).integer) h0_O
      rwa [map_natCast, map_zero] at this
    have h_dvd : EllipticRootNumber.p F ∣ EllipticRootNumber.ell F :=
      (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer)
        (EllipticRootNumber.ell F)).mp h0_k
    have h_lt : EllipticRootNumber.p F + 1 ≤ EllipticRootNumber.ell F :=
      (Nat.exists_infinite_primes (EllipticRootNumber.p F + 1)).choose_spec.1
    rcases (EllipticRootNumber.ell_prime F).out.eq_one_or_self_of_dvd _ h_dvd with hp1 | hpeq
    · have h1_k : ((1 : ℕ) : IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) = 0 :=
        (ringChar.spec (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) 1).mpr
          (hp1 ▸ dvd_rfl)
      rw [Nat.cast_one] at h1_k
      exact one_ne_zero h1_k
    · omega
  obtain ⟨A, D, hA1, hD1, hA2, hD2, h_deg, h_rec⟩ :=
    weierstrass_exists_division_ratfunc_polynomials K W hΔ_W
  have h_eval :=
    weierstrass_nsmul_eval_of_polynomial_recurrence K W A D hA1 hD1 hA2 hD2 h_rec
  obtain ⟨h_surj, h_card⟩ :=
    weierstrass_nsmul_surjective_and_torsion_card_of_eval K W hΔ_W A D hD2 h_deg h_eval
      (EllipticRootNumber.ell F) h_ell_pos h_ell_ne
  have h_card' :
      Nat.card (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) =
        EllipticRootNumber.ell F ^ 2 := by
    rw [zero_add, pow_one]
    exact h_card
  exact vBar_finrank_eq_two_of_nsmul_surjective_and_torsion_card F E h_surj h_card'

theorem relNorm_eq_q_zpow_of_actsAsFrobPow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (w : EllipticRootNumber.relWeil F ⊥) :
    ∃ d : ℤ,
      EllipticRootNumber.ActsAsFrobPow F (w : EllipticRootNumber.AbsGal F) d ∧
      (EllipticRootNumber.relNorm F ⊥ w : EllipticRootNumber.Ω F) =
        (EllipticRootNumber.q F : EllipticRootNumber.Ω F) ^ d :=
by
  letI : Fintype (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) :=
    Fintype.ofFinite (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
  obtain ⟨k_res, hp, hk⟩ :=
    FiniteField.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      (ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer))
  have hp_prime : (EllipticRootNumber.p F).Prime := hp
  have hq_pow : EllipticRootNumber.q F = (EllipticRootNumber.p F) ^ (k_res : ℕ) := by
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hk]
  have hq_ge_two : 2 ≤ EllipticRootNumber.q F := by
    rw [hq_pow]
    exact Nat.one_lt_pow k_res.ne_zero hp_prime.one_lt
  have h_coprime_q : ∀ (N m : ℕ), ¬ EllipticRootNumber.p F ∣ N →
      (EllipticRootNumber.q F ^ m).Coprime N := by
    intro N m hpN
    rw [hq_pow]
    exact ((hp_prime.coprime_iff_not_dvd.mpr hpN).pow_left _).pow_left _
  have eq_of_pow_q_pow_eq : ∀ (z₁ z₂ : AlgebraicClosure F) (N m : ℕ),
      0 < N → ¬ EllipticRootNumber.p F ∣ N → z₁ ^ N = 1 → z₂ ^ N = 1 →
      z₁ ^ (EllipticRootNumber.q F ^ m) = z₂ ^ (EllipticRootNumber.q F ^ m) → z₁ = z₂ := by
    intro z₁ z₂ N m hN0 hpN hz₁ hz₂ heq
    have hz₁0 : z₁ ≠ 0 := fun h => by rw [h, zero_pow hN0.ne'] at hz₁; exact zero_ne_one hz₁
    have hz₂0 : z₂ ≠ 0 := fun h => by rw [h, zero_pow hN0.ne'] at hz₂; exact zero_ne_one hz₂
    let u₁ : (AlgebraicClosure F)ˣ := Units.mk0 z₁ hz₁0
    let u₂ : (AlgebraicClosure F)ˣ := Units.mk0 z₂ hz₂0
    let u : (AlgebraicClosure F)ˣ := u₁ * u₂⁻¹
    have huN : u ^ N = 1 := by
      have hu₁N : u₁ ^ N = 1 := by ext; exact hz₁
      have hu₂N : u₂ ^ N = 1 := by ext; exact hz₂
      rw [mul_pow, inv_pow, hu₁N, hu₂N, inv_one, mul_one]
    have huq : u ^ (EllipticRootNumber.q F ^ m) = 1 := by
      have hu₁_eq : u₁ ^ (EllipticRootNumber.q F ^ m) = u₂ ^ (EllipticRootNumber.q F ^ m) := by
        ext
        exact heq
      rw [mul_pow, inv_pow, hu₁_eq, mul_inv_cancel]
    have hdvd : orderOf u ∣ Nat.gcd (EllipticRootNumber.q F ^ m) N :=
      Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one huq) (orderOf_dvd_of_pow_eq_one huN)
    rw [(h_coprime_q N m hpN).gcd_eq_one] at hdvd
    have hu1 : u = 1 := orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_one hdvd)
    have hu_eq : u₁ = u₂ := mul_inv_eq_one.mp hu1
    exact congrArg Units.val hu_eq
  have h_root_gal : ∀ (τ : EllipticRootNumber.AbsGal F) (ζ : AlgebraicClosure F),
      EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
      EllipticRootNumber.IsPrimeToPRootOfUnity F (τ ζ) := by
    rintro τ ζ ⟨N, hN0, hpN, hζN⟩
    exact ⟨N, hN0, hpN, by rw [← map_pow, hζN, map_one]⟩
  have h_frob_one : EllipticRootNumber.ActsAsFrobPow F 1 0 := by
    intro ζ _
    simp
  have h_frob_mul : ∀ (σ τ : EllipticRootNumber.AbsGal F) (m n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ m →
      EllipticRootNumber.ActsAsFrobPow F τ n →
      EllipticRootNumber.ActsAsFrobPow F (σ * τ) (m + n) := by
    intro σ τ m n hm hn ζ hζ
    rcases hζ with ⟨N, hN0, hpN, hζN⟩
    have hζ' : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ := ⟨N, hN0, hpN, hζN⟩
    have hz₁N : (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(m + n)).toNat)) ^ N = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζN, map_one, one_pow]
    have hz₂N : (ζ ^ (EllipticRootNumber.q F ^ (m + n).toNat)) ^ N = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, hζN, one_pow]
    apply eq_of_pow_q_pow_eq _ _ N ((-m).toNat + (-n).toNat) hN0 hpN hz₁N hz₂N
    calc (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(m + n)).toNat)) ^
          (EllipticRootNumber.q F ^ ((-m).toNat + (-n).toNat))
      _ = (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-(m + n)).toNat + ((-m).toNat + (-n).toNat))) := by
          rw [AlgEquiv.mul_apply, ← pow_mul, ← pow_add]
      _ = ((σ (τ ζ)) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
          (EllipticRootNumber.q F ^ ((-(m + n)).toNat + (-n).toNat)) := by
          rw [← pow_mul, ← pow_add]
          congr 2
          omega
      _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ m.toNat)) ^
          (EllipticRootNumber.q F ^ ((-(m + n)).toNat + (-n).toNat)) := by
          rw [hm (τ ζ) (h_root_gal τ ζ hζ')]
      _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
          (EllipticRootNumber.q F ^ ((-(m + n)).toNat + m.toNat)) := by
          rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
          congr 2
          omega
      _ = (ζ ^ (EllipticRootNumber.q F ^ n.toNat)) ^
          (EllipticRootNumber.q F ^ ((-(m + n)).toNat + m.toNat)) := by
          rw [hn ζ hζ']
      _ = (ζ ^ (EllipticRootNumber.q F ^ (m + n).toNat)) ^
          (EllipticRootNumber.q F ^ ((-m).toNat + (-n).toNat)) := by
          rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
          congr 2
          omega
  have h_frob_inv : ∀ (σ : EllipticRootNumber.AbsGal F) (m : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ m →
      EllipticRootNumber.ActsAsFrobPow F σ⁻¹ (-m) := by
    intro σ m hm ζ hζ
    have h1 := hm (σ⁻¹ ζ) (h_root_gal σ⁻¹ ζ hζ)
    have h2 : σ (σ⁻¹ ζ) = ζ := AlgEquiv.apply_symm_apply σ ζ
    rw [h2] at h1
    rw [neg_neg]
    exact h1.symm
  have h_weil_exists : ∀ v : EllipticRootNumber.weilGroup F,
      ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F (v : EllipticRootNumber.AbsGal F) n := by
    rintro ⟨σ, hσ⟩
    exact Subgroup.closure_induction
      (fun τ hτ => hτ)
      ⟨0, h_frob_one⟩
      (fun τ₁ τ₂ _ _ ⟨m, hm⟩ ⟨n, hn⟩ => ⟨m + n, h_frob_mul τ₁ τ₂ m n hm hn⟩)
      (fun τ _ ⟨m, hm⟩ => ⟨-m, h_frob_inv τ m hm⟩)
      hσ
  have h_frob_unique : ∀ (σ : EllipticRootNumber.AbsGal F) (m n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ m →
      EllipticRootNumber.ActsAsFrobPow F σ n → m = n := by
    intro σ m n hm hn
    have h_diff : EllipticRootNumber.ActsAsFrobPow F 1 (-m + n) := by
      have h1 := h_frob_mul σ⁻¹ σ (-m) n (h_frob_inv σ m hm) hn
      rwa [inv_mul_cancel] at h1
    set d : ℤ := -m + n
    set A : ℕ := (-d).toNat
    set B : ℕ := d.toNat
    obtain ⟨r, hr_ge, hr_prime⟩ := Nat.exists_infinite_primes
      (max (EllipticRootNumber.p F) (max (EllipticRootNumber.q F ^ A) (EllipticRootNumber.q F ^ B)) + 1)
    have h_max_lt_r :
        max (EllipticRootNumber.p F) (max (EllipticRootNumber.q F ^ A) (EllipticRootNumber.q F ^ B)) < r :=
      Nat.lt_of_succ_le hr_ge
    have hp_lt_r : EllipticRootNumber.p F < r :=
      lt_of_le_of_lt (le_max_left _ _) h_max_lt_r
    have hqA_lt_r : EllipticRootNumber.q F ^ A < r :=
      lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) h_max_lt_r
    have hqB_lt_r : EllipticRootNumber.q F ^ B < r :=
      lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) h_max_lt_r
    have hp_not_dvd_r : ¬ EllipticRootNumber.p F ∣ r := by
      intro hdvd
      rcases (Nat.dvd_prime hr_prime).mp hdvd with h1 | hr_eq
      · exact hp_prime.ne_one h1
      · exact hp_lt_r.ne hr_eq
    have hr_F_ne : (r : F) ≠ 0 := by
      have hr_res_ne : (r : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) ≠ 0 :=
        (CharP.cast_eq_zero_iff (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
          (ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)) r).not.mpr hp_not_dvd_r
      intro hr0
      apply hr_res_ne
      have hr_int0 : (r : ↥(ValuativeRel.valuation F).integer) = 0 := by
        ext
        exact hr0
      rw [← map_natCast (IsLocalRing.residue ↥(ValuativeRel.valuation F).integer) r, hr_int0, map_zero]
    letI : NeZero (r : F) := ⟨hr_F_ne⟩
    obtain ⟨ζ_r, hζ_r⟩ := (AlgebraicClosure.hasEnoughRootsOfUnity F r).prim
    have hζ_r_root : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ_r :=
      ⟨r, hr_prime.pos, hp_not_dvd_r, hζ_r.pow_eq_one⟩
    have h_pow_eq : ζ_r ^ (EllipticRootNumber.q F ^ A) = ζ_r ^ (EllipticRootNumber.q F ^ B) := by
      simpa [A, B] using h_diff ζ_r hζ_r_root
    have hq_pow_eq : EllipticRootNumber.q F ^ A = EllipticRootNumber.q F ^ B :=
      hζ_r.pow_inj hqA_lt_r hqB_lt_r h_pow_eq
    have hAB : A = B := Nat.pow_right_injective hq_ge_two hq_pow_eq
    change (-d).toNat = d.toNat at hAB
    omega
  have h_deg_eq : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.weilDegree F σ = n := by
    intro σ n hn
    unfold EllipticRootNumber.weilDegree
    have hex : ∃ m : ℤ, EllipticRootNumber.ActsAsFrobPow F σ m := ⟨n, hn⟩
    rw [dif_pos hex]
    exact h_frob_unique σ hex.choose n hex.choose_spec hn
  let f₀ : EllipticRootNumber.weilGroup F →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v : EllipticRootNumber.AbsGal F))
      map_one' := by
        change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F 1) = 1
        rw [h_deg_eq 1 0 h_frob_one, ofAdd_zero]
      map_mul' := fun v₁ v₂ => by
        obtain ⟨m, hm⟩ := h_weil_exists v₁
        obtain ⟨n, hn⟩ := h_weil_exists v₂
        change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F
          ((v₁ : EllipticRootNumber.AbsGal F) * (v₂ : EllipticRootNumber.AbsGal F))) =
          Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v₁ : EllipticRootNumber.AbsGal F)) *
            Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (v₂ : EllipticRootNumber.AbsGal F))
        rw [h_deg_eq _ m hm, h_deg_eq _ n hn,
          h_deg_eq _ (m + n) (h_frob_mul _ _ m n hm hn), ofAdd_add] }
  have h_exists_hom : ∃ f : EllipticRootNumber.weilGroup F →* Multiplicative ℤ,
      ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n → f σ = Multiplicative.ofAdd n := by
    refine ⟨f₀, fun σ n hn => ?_⟩
    change Multiplicative.ofAdd (EllipticRootNumber.weilDegree F (σ : EllipticRootNumber.AbsGal F)) =
      Multiplicative.ofAdd n
    rw [h_deg_eq _ n hn]
  have h_hom_spec : ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n →
      EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n :=
    Classical.epsilon_spec h_exists_hom
  let v : EllipticRootNumber.weilGroup F :=
    Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w
  obtain ⟨d, hd⟩ := h_weil_exists v
  refine ⟨d, hd, ?_⟩
  unfold EllipticRootNumber.relNorm EllipticRootNumber.weilNormHom EllipticRootNumber.qUnit
  rw [MonoidHom.comp_apply, MonoidHom.comp_apply, h_hom_spec v d hd, zpowersHom_apply,
    toAdd_ofAdd, Units.val_zpow_eq_zpow_val, Units.val_mk0]

theorem ellAdicRep_det_eq_algebraMap_tateRep_det (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : WeierstrassCurve F) (σ : EllipticRootNumber.AbsGal F) :
    LinearMap.det (EllipticRootNumber.ellAdicRep F E σ) =
      algebraMap ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.Ω F)
        (algebraMap ℤ_[EllipticRootNumber.ell F] ℚ_[EllipticRootNumber.ell F]
          (LinearMap.det (EllipticRootNumber.tateRep F E σ))) :=
by
  classical
  let ℓ := EllipticRootNumber.ell F
  haveI : Fact ℓ.Prime := EllipticRootNumber.ell_prime F
  let M := EllipticRootNumber.tateModule F E
  have h_ell_inj : ∀ x : M, (ℓ : ℤ_[ℓ]) • x = 0 → x = 0 := by
    intro x hx
    apply Subtype.ext
    funext k
    apply Subtype.ext
    have hk := congrArg (fun v : M => ((v.1 (k + 1) : EllipticRootNumber.torsion F E _) :
      EllipticRootNumber.Pts F E)) hx
    dsimp only at hk
    rw [Submodule.coe_smul, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      Submodule.coe_zero, Pi.zero_apply, AddSubgroup.coe_zero] at hk
    have h_val : (PadicInt.toZModPow (k + 2) (ℓ : ℤ_[ℓ])).val = ℓ % (ℓ ^ (k + 2)) := by
      rw [map_natCast, ZMod.val_natCast]
    rw [h_val, EllipticRootNumber.nsmul_eq_of_modEq F E
      ((EllipticRootNumber.mem_torsion F E).mp (x.1 (k + 1)).2)
      (Nat.mod_modEq ℓ (ℓ ^ (k + 2))), x.2 k] at hk
    exact hk
  have h_pow_inj : ∀ (r : ℕ) (x : M), ((ℓ : ℤ_[ℓ]) ^ r) • x = 0 → x = 0 := by
    intro r
    induction r with
    | zero =>
      intro x hx
      rw [pow_zero, one_smul] at hx
      exact hx
    | succ r ih =>
      intro x hx
      rw [pow_succ', mul_smul] at hx
      exact ih x (h_ell_inj _ hx)
  haveI : Module.IsTorsionFree ℤ_[ℓ] M := by
    apply Module.IsTorsionFree.of_smul_eq_zero
    intro a x hax
    by_cases ha : a = 0
    · exact Or.inl ha
    · right
      have h_unit := PadicInt.unitCoeff_spec ha
      set u := PadicInt.unitCoeff ha
      set r := a.valuation
      have h_u_smul : ((u⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) • (a • x) = 0 := by
        rw [hax, smul_zero]
      rw [h_unit, smul_smul, ← mul_assoc, Units.inv_mul, one_mul] at h_u_smul
      exact h_pow_inj r x h_u_smul
  haveI : Finite (EllipticRootNumber.torsion F E (ℓ ^ (0 + 1))) := finite_torsion_ell F E
  haveI : Module.Finite ℤ_[ℓ] M := module_finite_tateModule_of_finite_torsion F E
  haveI : Module.Free ℤ_[ℓ] M := Module.free_of_finite_type_torsion_free'
  change LinearMap.det
    (LinearMap.baseChange (EllipticRootNumber.Ω F)
      (LinearMap.baseChange ℚ_[ℓ] (EllipticRootNumber.tateRep F E σ))) = _
  rw [LinearMap.det_baseChange, LinearMap.det_baseChange]

theorem tateRep_level_basis_and_det_matrix_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F)
    (h_surj : ∀ Q : EllipticRootNumber.Pts F E,
      ∃ P : EllipticRootNumber.Pts F E, EllipticRootNumber.ell F • P = Q)
    (h_card : Nat.card (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) =
      EllipticRootNumber.ell F ^ 2)
    (σ : EllipticRootNumber.AbsGal F) (k : ℕ) :
    ∃ (P₀ P₁ : EllipticRootNumber.Pts F E) (a₀₀ a₀₁ a₁₀ a₁₁ : ℕ),
      (EllipticRootNumber.ell F ^ (k + 1)) • P₀ = 0 ∧
      (EllipticRootNumber.ell F ^ (k + 1)) • P₁ = 0 ∧
      (∀ Q : EllipticRootNumber.Pts F E,
        (EllipticRootNumber.ell F ^ (k + 1)) • Q = 0 →
        ∃ c₀ c₁ : ℕ, Q = c₀ • P₀ + c₁ • P₁) ∧
      (∀ d : ℕ, d • P₁ = 0 → (EllipticRootNumber.ell F ^ (k + 1)) ∣ d) ∧
      EllipticRootNumber.galHom F E σ P₀ = a₀₀ • P₀ + a₁₀ • P₁ ∧
      EllipticRootNumber.galHom F E σ P₁ = a₀₁ • P₀ + a₁₁ • P₁ ∧
      PadicInt.toZModPow (k + 1) (LinearMap.det (EllipticRootNumber.tateRep F E σ)) =
        (a₀₀ : ZMod (EllipticRootNumber.ell F ^ (k + 1))) *
          (a₁₁ : ZMod (EllipticRootNumber.ell F ^ (k + 1))) -
        (a₀₁ : ZMod (EllipticRootNumber.ell F ^ (k + 1))) *
          (a₁₀ : ZMod (EllipticRootNumber.ell F ^ (k + 1))) :=
by
  obtain rfl : ‹DecidableEq (AlgebraicClosure F)› =
      (fun a b => Classical.propDecidable (a = b)) :=
    Subsingleton.elim _ _
  classical
  set ℓ := EllipticRootNumber.ell F
  set T := EllipticRootNumber.tateModule F E
  set M₀ := EllipticRootNumber.torsion F E (ℓ ^ (0 + 1))
  set m := ℓ ^ (k + 1)
  haveI : Fact ℓ.Prime := EllipticRootNumber.ell_prime F
  have hℓ_ne : ℓ ≠ 0 := (EllipticRootNumber.ell_prime F).out.ne_zero
  have hm_ne : m ≠ 0 := pow_ne_zero (k + 1) hℓ_ne
  haveI : NeZero m := ⟨hm_ne⟩
  
  have h_pt_eq : ∀ (y : T) (m₁ m₂ : ℕ), m₁ = m₂ →
      (y.1 m₁ : EllipticRootNumber.Pts F E) = (y.1 m₂ : EllipticRootNumber.Pts F E) := by
    intro y m₁ m₂ h
    subst h
    rfl
  have h_compat : ∀ (y : T) (b a : ℕ),
      (ℓ ^ b) • (y.1 (a + b) : EllipticRootNumber.Pts F E) =
        (y.1 a : EllipticRootNumber.Pts F E) := by
    intro y b
    induction b with
    | zero =>
      intro a
      change 1 • (y.1 a : EllipticRootNumber.Pts F E) = (y.1 a : EllipticRootNumber.Pts F E)
      exact one_nsmul _
    | succ b ih =>
      intro a
      change (ℓ ^ (b + 1)) • (y.1 ((a + b) + 1) : EllipticRootNumber.Pts F E) =
        (y.1 a : EllipticRootNumber.Pts F E)
      rw [pow_succ', mul_nsmul, y.2 (a + b), ih a]
  have h_div_pow : ∀ (j : ℕ) (y : T), (y.1 j : EllipticRootNumber.Pts F E) = 0 →
      ∃ z : T, y = ((ℓ ^ (j + 1) : ℕ) : ℤ_[ℓ]) • z := by
    intro j y hyj
    have h_mem : ∀ n : ℕ, (y.1 (n + (j + 1)) : EllipticRootNumber.Pts F E) ∈
        EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) := by
      intro n
      rw [EllipticRootNumber.mem_torsion,
        h_pt_eq y (n + (j + 1)) (j + (n + 1)) (by omega),
        h_compat y (n + 1) j, hyj]
    let z₀ : ∀ n : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) :=
      fun n => ⟨(y.1 (n + (j + 1)) : EllipticRootNumber.Pts F E), h_mem n⟩
    have hz : z₀ ∈ T := by
      intro n
      change ℓ • (y.1 ((n + 1) + (j + 1)) : EllipticRootNumber.Pts F E) =
        (y.1 (n + (j + 1)) : EllipticRootNumber.Pts F E)
      rw [h_pt_eq y ((n + 1) + (j + 1)) ((n + (j + 1)) + 1) (by omega)]
      exact y.2 (n + (j + 1))
    refine ⟨⟨z₀, hz⟩, ?_⟩
    apply Subtype.ext
    funext n
    apply Subtype.ext
    rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      map_natCast, ZMod.val_natCast]
    have h_mod := EllipticRootNumber.nsmul_eq_of_modEq F E
      ((EllipticRootNumber.mem_torsion F E).mp (h_mem n))
      (Nat.mod_modEq (ℓ ^ (j + 1)) (ℓ ^ (n + 1)))
    change (y.1 n : EllipticRootNumber.Pts F E) =
      (ℓ ^ (j + 1) % ℓ ^ (n + 1)) • (y.1 (n + (j + 1)) : EllipticRootNumber.Pts F E)
    rw [h_mod, h_compat y (j + 1) n]
  have h_div : ∀ y : T, y.1 0 = 0 → ∃ z : T, y = (ℓ : ℤ_[ℓ]) • z := by
    intro y hy0
    have hy0' : (y.1 0 : EllipticRootNumber.Pts F E) = 0 := by rw [hy0]; rfl
    obtain ⟨z, hz⟩ := h_div_pow 0 y hy0'
    rw [Nat.zero_add, pow_one] at hz
    exact ⟨z, hz⟩
  
  have h_card_ne : Nat.card M₀ ≠ 0 := by
    rw [h_card]
    exact pow_ne_zero 2 hℓ_ne
  haveI : Finite M₀ := Nat.finite_of_card_ne_zero h_card_ne
  letI : Fintype M₀ := Fintype.ofFinite M₀
  let b : M₀ → T := fun m₀ =>
    if h : ∃ v : T, v.1 0 = m₀ then Classical.choose h else 0
  have hb : ∀ w : T, (b (w.1 0)).1 0 = w.1 0 := by
    intro w
    have hex : ∃ v : T, v.1 0 = w.1 0 := ⟨w, rfl⟩
    dsimp [b]
    rw [dif_pos hex]
    exact Classical.choose_spec hex
  have h_step : ∀ w : T, ∃ w' : T, w = b (w.1 0) + (ℓ : ℤ_[ℓ]) • w' := by
    intro w
    have h0 : (w - b (w.1 0)).1 0 = 0 := by
      change w.1 0 - (b (w.1 0)).1 0 = 0
      rw [hb w, sub_self]
    obtain ⟨w', hw'⟩ := h_div (w - b (w.1 0)) h0
    exact ⟨w', sub_eq_iff_eq_add'.mp hw'⟩
  let next : T → T := fun w => Classical.choose (h_step w)
  have h_next : ∀ w : T, w = b (w.1 0) + (ℓ : ℤ_[ℓ]) • next w :=
    fun w => Classical.choose_spec (h_step w)
  have h_fin_gen : Function.Surjective (Fintype.linearCombination ℤ_[ℓ] b) := by
    intro x
    let z : ℕ → T := fun i => Nat.rec x (fun _ w => next w) i
    have hz0 : z 0 = x := rfl
    have hzs : ∀ i : ℕ, z (i + 1) = next (z i) := fun _ => rfl
    have h_tel : ∀ N : ℕ,
        x = ∑ i ∈ Finset.range N, ((ℓ : ℤ_[ℓ]) ^ i) • b ((z i).1 0) +
          ((ℓ : ℤ_[ℓ]) ^ N) • z N := by
      intro N
      induction N with
      | zero =>
        simp [hz0]
      | succ N ih =>
        rw [Finset.sum_range_succ, add_assoc]
        conv_lhs => rw [ih]
        congr 1
        rw [hzs N, pow_succ, mul_smul, ← smul_add, ← h_next (z N)]
    let δ : M₀ → ℕ → ℤ := fun m₀ i => if (z i).1 0 = m₀ then 1 else 0
    let f : M₀ → ℕ → ℤ := fun m₀ N => ∑ i ∈ Finset.range N, δ m₀ i * (ℓ : ℤ) ^ i
    have h_exp : ∀ N : ℕ,
        x = ∑ m₀ : M₀, (f m₀ N : ℤ_[ℓ]) • b m₀ + ((ℓ : ℤ_[ℓ]) ^ N) • z N := by
      intro N
      rw [h_tel N]
      congr 1
      have h_term : ∀ i : ℕ,
          ((ℓ : ℤ_[ℓ]) ^ i) • b ((z i).1 0) =
            ∑ m₀ : M₀, ((δ m₀ i * (ℓ : ℤ) ^ i : ℤ) : ℤ_[ℓ]) • b m₀ := by
        intro i
        symm
        rw [Finset.sum_eq_single ((z i).1 0)]
        · dsimp [δ]
          rw [if_pos rfl, one_mul, Int.cast_pow, Int.cast_natCast]
        · intro m₀ _ hm₀
          dsimp [δ]
          rw [if_neg hm₀.symm, zero_mul, Int.cast_zero, zero_smul]
        · intro h_abs
          exact absurd (Finset.mem_univ _) h_abs
      simp_rw [h_term]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro m₀ _
      dsimp [f]
      rw [Int.cast_sum, Finset.sum_smul]
    have hf_dvd : ∀ (m₀ : M₀) (i : ℕ), (ℓ : ℤ) ^ i ∣ f m₀ (i + 1) - f m₀ i := by
      intro m₀ i
      dsimp [f]
      rw [Finset.sum_range_succ, add_sub_cancel_left]
      exact ⟨δ m₀ i, mul_comm _ _⟩
    let a : M₀ → ℤ_[ℓ] := fun m₀ =>
      PadicInt.ofIntSeq (f m₀) (PadicInt.isCauSeq_padicNorm_of_pow_dvd_sub (f m₀) ℓ (hf_dvd m₀))
    refine ⟨a, ?_⟩
    rw [Fintype.linearCombination_apply]
    apply Subtype.ext
    funext n
    have hx_n : x.1 n = (∑ m₀ : M₀, ((f m₀ (n + 1) : ℤ_[ℓ]) • b m₀).1 n) +
        (((ℓ : ℤ_[ℓ]) ^ (n + 1)) • z (n + 1)).1 n := by
      conv_lhs => rw [h_exp (n + 1)]
      rw [Submodule.coe_add, Pi.add_apply, Submodule.coe_sum, Finset.sum_apply]
    rw [Submodule.coe_sum, Finset.sum_apply, hx_n]
    have h_rem_zero : (((ℓ : ℤ_[ℓ]) ^ (n + 1)) • z (n + 1)).1 n = 0 := by
      apply Subtype.ext
      rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion]
      have h_zmod : PadicInt.toZModPow (n + 1) ((ℓ : ℤ_[ℓ]) ^ (n + 1)) = 0 := by
        rw [← Nat.cast_pow, map_natCast, ZMod.natCast_self]
      rw [h_zmod, ZMod.val_zero, zero_nsmul]
      rfl
    rw [h_rem_zero, add_zero]
    apply Finset.sum_congr rfl
    intro m₀ _
    apply Subtype.ext
    rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion]
    have h_zmod : PadicInt.toZModPow (n + 1) (a m₀) =
        PadicInt.toZModPow (n + 1) (f m₀ (n + 1) : ℤ_[ℓ]) := by
      dsimp [a]
      rw [PadicInt.toZModPow_ofIntSeq_of_pow_dvd_sub (f m₀) ℓ (hf_dvd m₀) (n + 1), map_intCast]
    rw [h_zmod]
  haveI : Module.Finite ℤ_[ℓ] T := Module.Finite.of_surjective _ h_fin_gen
  
  have h_ell_inj : ∀ z : T, (ℓ : ℤ_[ℓ]) • z = 0 → z = 0 := by
    intro z hz
    apply Subtype.ext
    funext n
    apply Subtype.ext
    have h_n1 : (((ℓ : ℤ_[ℓ]) • z).1 (n + 1) : EllipticRootNumber.Pts F E) = 0 := by
      rw [hz]
      rfl
    rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      map_natCast, ZMod.val_natCast] at h_n1
    have h_mod := EllipticRootNumber.nsmul_eq_of_modEq F E
      ((EllipticRootNumber.mem_torsion F E).mp (z.1 (n + 1)).2)
      (Nat.mod_modEq ℓ (ℓ ^ (n + 2)))
    rw [h_mod, z.2 n] at h_n1
    exact h_n1
  have h_pow_inj : ∀ (r : ℕ) (z : T), ((ℓ : ℤ_[ℓ]) ^ r) • z = 0 → z = 0 := by
    intro r
    induction r with
    | zero =>
      intro z hz
      rwa [pow_zero, one_smul] at hz
    | succ r ih =>
      intro z hz
      rw [pow_succ', mul_smul] at hz
      exact ih z (h_ell_inj _ hz)
  haveI : NoZeroSMulDivisors ℤ_[ℓ] T := ⟨by
    intro a z haz
    by_cases ha : a = 0
    · exact Or.inl ha
    · right
      let u := PadicInt.unitCoeff ha
      have hu := PadicInt.unitCoeff_spec ha
      have h_pow : ((ℓ : ℤ_[ℓ]) ^ a.valuation) • z = 0 := by
        calc ((ℓ : ℤ_[ℓ]) ^ a.valuation) • z
            = (1 : ℤ_[ℓ]) • (((ℓ : ℤ_[ℓ]) ^ a.valuation) • z) := (one_smul _ _).symm
          _ = ((↑u⁻¹ * ↑u : ℤ_[ℓ])) • (((ℓ : ℤ_[ℓ]) ^ a.valuation) • z) := by
              rw [Units.inv_mul]
          _ = (↑u⁻¹ : ℤ_[ℓ]) • ((↑u * (ℓ : ℤ_[ℓ]) ^ a.valuation) • z) := by
              rw [mul_smul, mul_smul]
          _ = (↑u⁻¹ : ℤ_[ℓ]) • (a • z) := by rw [← hu]
          _ = 0 := by rw [haz, smul_zero]
      exact h_pow_inj a.valuation z h_pow⟩
  haveI : Module.IsTorsionFree ℤ_[ℓ] T := instIsTorsionFreeOfIsDomainOfNoZeroSMulDivisors
  haveI : Module.Free ℤ_[ℓ] T := Module.free_of_finite_type_torsion_free'
  
  have h_surj_level : ∀ (j : ℕ) (Q : EllipticRootNumber.Pts F E),
      (ℓ ^ (j + 1)) • Q = 0 →
      ∃ u : T, (u.1 j : EllipticRootNumber.Pts F E) = Q := by
    intro j Q hQ
    let R : ℕ → EllipticRootNumber.Pts F E :=
      fun n => Nat.rec Q (fun _ P => Classical.choose (h_surj P)) n
    have hR0 : R 0 = Q := rfl
    have hR_step : ∀ n : ℕ, ℓ • R (n + 1) = R n :=
      fun n => Classical.choose_spec (h_surj (R n))
    have hR_pow : ∀ n : ℕ, (ℓ ^ n) • R n = Q := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, one_nsmul, hR0]
      | succ n ih =>
        rw [pow_succ', mul_nsmul, hR_step n, ih]
    have hu_mem : ∀ n : ℕ, (ℓ ^ j) • R n ∈ EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) := by
      intro n
      rw [EllipticRootNumber.mem_torsion, ← mul_nsmul, ← pow_add,
        show j + (n + 1) = n + (j + 1) by omega, pow_add, mul_nsmul, hR_pow n, hQ]
    let u₀ : ∀ n : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) :=
      fun n => ⟨(ℓ ^ j) • R n, hu_mem n⟩
    have hu : u₀ ∈ T := by
      intro n
      change ℓ • ((ℓ ^ j) • R (n + 1)) = (ℓ ^ j) • R n
      rw [← mul_nsmul, mul_comm (ℓ ^ j) ℓ, mul_nsmul, hR_step n]
    exact ⟨⟨u₀, hu⟩, hR_pow j⟩
  
  have h_rank : Module.finrank ℤ_[ℓ] T = 2 := by
    have h_pi0_surj : ∀ m₀ : M₀, ∃ x : T, x.1 0 = m₀ := by
      intro m₀
      obtain ⟨x, hx⟩ := h_surj_level 0 m₀.1 ((EllipticRootNumber.mem_torsion F E).mp m₀.2)
      exact ⟨x, Subtype.ext hx⟩
    set r := Module.finrank ℤ_[ℓ] T
    let B₀ : Module.Basis (Fin r) ℤ_[ℓ] T := Module.finBasis ℤ_[ℓ] T
    haveI : NeZero (ℓ ^ (0 + 1)) := ⟨pow_ne_zero (0 + 1) hℓ_ne⟩
    let ι : (Fin r → ZMod (ℓ ^ (0 + 1))) → T :=
      fun c => B₀.equivFun.symm (fun i => ((c i).val : ℤ_[ℓ]))
    let Φ : (Fin r → ZMod (ℓ ^ (0 + 1))) → M₀ := fun c => (ι c).1 0
    have hΦ_bij : Function.Bijective Φ := by
      refine ⟨?_, ?_⟩
      · intro c₁ c₂ hΦ
        have h0 : (ι c₁ - ι c₂).1 0 = 0 := by
          change Φ c₁ - Φ c₂ = 0
          rw [hΦ, sub_self]
        obtain ⟨z, hz⟩ := h_div (ι c₁ - ι c₂) h0
        funext i
        have h_eq := congrArg B₀.equivFun hz
        rw [map_sub, map_smul, B₀.equivFun.apply_symm_apply, B₀.equivFun.apply_symm_apply] at h_eq
        have hi := congrFun h_eq i
        rw [Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at hi
        have h_mod := congrArg (PadicInt.toZModPow (0 + 1)) hi
        rw [map_sub, map_natCast, map_natCast, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val,
          map_mul, map_natCast] at h_mod
        have hℓ_zero : (ℓ : ZMod (ℓ ^ (0 + 1))) = 0 :=
          (congrArg (Nat.cast : ℕ → ZMod (ℓ ^ (0 + 1)))
            (by rw [Nat.zero_add, pow_one] : ℓ = ℓ ^ (0 + 1))).trans
            (ZMod.natCast_self (ℓ ^ (0 + 1)))
        rw [hℓ_zero, zero_mul] at h_mod
        exact sub_eq_zero.mp h_mod
      · intro m₀
        obtain ⟨x, hx⟩ := h_pi0_surj m₀
        let c : Fin r → ZMod (ℓ ^ (0 + 1)) :=
          fun i => PadicInt.toZModPow (0 + 1) (B₀.equivFun x i)
        refine ⟨c, ?_⟩
        rw [← hx]
        dsimp [Φ, ι]
        have hx_eq : x = B₀.equivFun.symm (B₀.equivFun x) :=
          (B₀.equivFun.symm_apply_apply x).symm
        conv_rhs => rw [hx_eq]
        rw [B₀.equivFun_symm_apply, B₀.equivFun_symm_apply,
          Submodule.coe_sum, Finset.sum_apply, Submodule.coe_sum, Finset.sum_apply]
        apply Finset.sum_congr rfl
        intro i _
        apply Subtype.ext
        rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
          Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
          map_natCast, ZMod.natCast_zmod_val]
    have h_card_eq := Nat.card_eq_of_bijective Φ hΦ_bij
    rw [Nat.card_fun, Nat.card_zmod, Nat.card_fin, Nat.zero_add, pow_one, h_card] at h_card_eq
    exact Nat.pow_right_injective (EllipticRootNumber.ell_prime F).out.two_le h_card_eq
  let B : Module.Basis (Fin 2) ℤ_[ℓ] T := Module.finBasisOfFinrankEq ℤ_[ℓ] T h_rank
  let P₀ : EllipticRootNumber.Pts F E := (B 0).1 k
  let P₁ : EllipticRootNumber.Pts F E := (B 1).1 k
  have hP₀ : m • P₀ = 0 := (EllipticRootNumber.mem_torsion F E).mp ((B 0).1 k).2
  have hP₁ : m • P₁ = 0 := (EllipticRootNumber.mem_torsion F E).mp ((B 1).1 k).2
  
  have h_eval_k : ∀ u : T,
      (u.1 k : EllipticRootNumber.Pts F E) =
        (PadicInt.toZModPow (k + 1) (B.repr u 0)).val • P₀ +
        (PadicInt.toZModPow (k + 1) (B.repr u 1)).val • P₁ := by
    intro u
    conv_lhs => rw [← B.sum_repr u, Fin.sum_univ_two]
    rw [Submodule.coe_add, Pi.add_apply, AddSubgroup.coe_add,
      Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
      Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion]
  have h_gen : ∀ Q : EllipticRootNumber.Pts F E,
      m • Q = 0 → ∃ c₀ c₁ : ℕ, Q = c₀ • P₀ + c₁ • P₁ := by
    intro Q hQ
    obtain ⟨u, hu⟩ := h_surj_level k Q hQ
    refine ⟨(PadicInt.toZModPow (k + 1) (B.repr u 0)).val,
      (PadicInt.toZModPow (k + 1) (B.repr u 1)).val, ?_⟩
    rw [← hu, h_eval_k u]
  
  have hP₁_ord : ∀ d : ℕ, d • P₁ = 0 → m ∣ d := by
    intro d hd
    let y : T := (d : ℤ_[ℓ]) • B 1
    have hyk : (y.1 k : EllipticRootNumber.Pts F E) = 0 := by
      change (((d : ℤ_[ℓ]) • B 1).1 k : EllipticRootNumber.Pts F E) = 0
      rw [Submodule.coe_smul_of_tower, Pi.smul_apply, EllipticRootNumber.padic_smul_torsion,
        map_natCast, ZMod.val_natCast]
      have h_mod := EllipticRootNumber.nsmul_eq_of_modEq F E hP₁ (Nat.mod_modEq d m)
      change (d % m) • P₁ = 0
      rw [h_mod, hd]
    obtain ⟨z, hz⟩ := h_div_pow k y hyk
    have h_repr : B.repr ((d : ℤ_[ℓ]) • B 1) 1 = B.repr (((m : ℕ) : ℤ_[ℓ]) • z) 1 :=
      congrArg (fun v : T => B.repr v 1) hz
    rw [LinearEquiv.map_smul, LinearEquiv.map_smul, Finsupp.smul_apply, Finsupp.smul_apply,
      B.repr_self, Finsupp.single_eq_same, smul_eq_mul, mul_one, smul_eq_mul] at h_repr
    have h_zmod := congrArg (PadicInt.toZModPow (k + 1)) h_repr
    rw [map_natCast, map_mul, map_natCast, ZMod.natCast_self m, zero_mul] at h_zmod
    exact (ZMod.natCast_eq_zero_iff d m).mp h_zmod
  
  let M : Matrix (Fin 2) (Fin 2) ℤ_[ℓ] :=
    LinearMap.toMatrix B B (EllipticRootNumber.tateRep F E σ)
  let a₀₀ : ℕ := (PadicInt.toZModPow (k + 1) (M 0 0)).val
  let a₀₁ : ℕ := (PadicInt.toZModPow (k + 1) (M 0 1)).val
  let a₁₀ : ℕ := (PadicInt.toZModPow (k + 1) (M 1 0)).val
  let a₁₁ : ℕ := (PadicInt.toZModPow (k + 1) (M 1 1)).val
  have hσP₀ : EllipticRootNumber.galHom F E σ P₀ = a₀₀ • P₀ + a₁₀ • P₁ := by
    have h0 := h_eval_k (EllipticRootNumber.tateRep F E σ (B 0))
    rw [← LinearMap.toMatrix_apply B B (EllipticRootNumber.tateRep F E σ) 0 0,
      ← LinearMap.toMatrix_apply B B (EllipticRootNumber.tateRep F E σ) 1 0] at h0
    exact h0
  have hσP₁ : EllipticRootNumber.galHom F E σ P₁ = a₀₁ • P₀ + a₁₁ • P₁ := by
    have h1 := h_eval_k (EllipticRootNumber.tateRep F E σ (B 1))
    rw [← LinearMap.toMatrix_apply B B (EllipticRootNumber.tateRep F E σ) 0 1,
      ← LinearMap.toMatrix_apply B B (EllipticRootNumber.tateRep F E σ) 1 1] at h1
    exact h1
  have h_det :
      PadicInt.toZModPow (k + 1) (LinearMap.det (EllipticRootNumber.tateRep F E σ)) =
        (a₀₀ : ZMod m) * (a₁₁ : ZMod m) - (a₀₁ : ZMod m) * (a₁₀ : ZMod m) := by
    rw [← LinearMap.det_toMatrix B (EllipticRootNumber.tateRep F E σ)]
    change PadicInt.toZModPow (k + 1) M.det = _
    rw [Matrix.det_fin_two M, map_sub, map_mul, map_mul]
    dsimp [a₀₀, a₀₁, a₁₀, a₁₁]
    rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val,
      ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
  exact ⟨P₀, P₁, a₀₀, a₀₁, a₁₀, a₁₁, hP₀, hP₁, h_gen, hP₁_ord, hσP₀, hσP₁, h_det⟩

theorem weierstrass_functionField_generic_point_and_chord_ne_const (K : Type u) [Field K]
    (W : WeierstrassCurve.Affine K) :
    let X_gen := algebraMap W.CoordinateRing W.FunctionField
      (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))
    let Y_gen := algebraMap W.CoordinateRing W.FunctionField
      (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)
    ((W.baseChange W.FunctionField).toAffine).Nonsingular X_gen Y_gen ∧
    (∀ c : K, X_gen ≠ algebraMap K W.FunctionField c) ∧
    (∀ {x_S y_S : K} (h_S : W.Nonsingular x_S y_S) (c : K),
      let m := (Y_gen - algebraMap K W.FunctionField y_S) /
        (X_gen - algebraMap K W.FunctionField x_S)
      m ^ 2 + algebraMap K W.FunctionField W.a₁ * m -
        algebraMap K W.FunctionField W.a₂ - X_gen -
        algebraMap K W.FunctionField x_S ≠
      algebraMap K W.FunctionField c) :=
by
  have h_alg_identities :
      ∀ {A : Type u} [CommRing A] (f : K →+* A) (X Y : A),
        ((1 * (X ^ 3 + f W.a₂ * X ^ 2 + f W.a₄ * X + f W.a₆)) +
          (0 - 1 * (f W.a₁ * X + f W.a₃)) * Y = Y * Y →
          Y ^ 2 + f W.a₁ * X * Y + f W.a₃ * Y =
            X ^ 3 + f W.a₂ * X ^ 2 + f W.a₄ * X + f W.a₆) ∧
        (-2 * Y - f W.a₁ * X - f W.a₃ = 0 →
          (f W.a₁ * X + f W.a₃) + f 2 * Y = 0) ∧
        (f W.a₁ * Y - (3 * X ^ 2 + 2 * f W.a₂ * X + f W.a₄) = 0 →
          (f (-3) * X ^ 2 + f (-2 * W.a₂) * X + f (-W.a₄)) + f W.a₁ * Y = 0) ∧
        (∀ (x_S y_S c m : A),
          m ^ 2 + f W.a₁ * m - f W.a₂ - X - x_S = c →
          m * (X - x_S) = Y - y_S →
          (Y - y_S) ^ 2 + f W.a₁ * (Y - y_S) * (X - x_S) -
            (f W.a₂ + X + x_S + c) * (X - x_S) ^ 2 = 0) ∧
        (∀ (x_S y_S c dx dy : K),
          dx = 3 * x_S ^ 2 + 2 * W.a₂ * x_S + W.a₄ - W.a₁ * y_S →
          dy = 2 * y_S + W.a₁ * x_S + W.a₃ →
          (Y - f y_S) ^ 2 + f W.a₁ * (Y - f y_S) * (X - f x_S) -
            (f W.a₂ + X + f x_S + f c) * (X - f x_S) ^ 2 = 0 →
          Y ^ 2 + f W.a₁ * X * Y + f W.a₃ * Y =
            X ^ 3 + f W.a₂ * X ^ 2 + f W.a₄ * X + f W.a₆ →
          y_S ^ 2 + W.a₁ * x_S * y_S + W.a₃ * y_S =
            x_S ^ 3 + W.a₂ * x_S ^ 2 + W.a₄ * x_S + W.a₆ →
          (f (x_S - c) * X ^ 2 +
            f (-2 * (x_S - c) * x_S + dx) * X +
            f ((x_S - c) * x_S ^ 2 - dx * x_S + dy * y_S)) +
            f (-dy) * Y = 0) := by
    intro A _ f X Y
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro h
      linear_combination -h
    · intro h
      rw [map_ofNat]
      linear_combination -h
    · intro h
      simp only [map_neg, map_mul, map_ofNat]
      linear_combination h
    · intro x_S y_S c m h1 h2
      linear_combination (X - x_S) ^ 2 * h1 - (m * (X - x_S) + (Y - y_S) + f W.a₁ * (X - x_S)) * h2
    · intro x_S y_S c dx dy hdx hdy h1 h2 h3
      have h3' := congrArg f h3
      subst hdx hdy
      simp only [map_add, map_sub, map_neg, map_mul, map_pow, map_ofNat] at h3' ⊢
      linear_combination h1 - h2 + h3'
  let R := W.CoordinateRing
  let L := W.FunctionField
  let X_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)
  let Y_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X
  let X_gen : L := algebraMap R L X_R
  let Y_gen : L := algebraMap R L Y_R
  haveI : Module.Free (Polynomial K) W.CoordinateRing :=
    Module.Free.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  haveI : Module.Finite (Polynomial K) W.CoordinateRing :=
    Module.Finite.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  have h_basis_eq_zero : ∀ p q : Polynomial K, p • (1 : R) + q • Y_R = 0 → p = 0 ∧ q = 0 := by
    intro p q hpq
    have h_deg := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W) p q
    rw [hpq, Algebra.norm_zero, Polynomial.degree_zero] at h_deg
    refine ⟨?_, ?_⟩
    · by_contra hp
      have hp_deg : p.degree = (p.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hp
      have h1 : 2 • p.degree ≤ ⊥ := by rw [h_deg]; exact le_max_left _ _
      rw [hp_deg, two_nsmul, ← Nat.cast_add, le_bot_iff] at h1
      exact WithBot.natCast_ne_bot _ h1
    · by_contra hq
      have hq_deg : q.degree = (q.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hq
      have h1 : 2 • q.degree + 3 ≤ ⊥ := by rw [h_deg]; exact le_max_right _ _
      change 2 • q.degree + ((3 : ℕ) : WithBot ℕ) ≤ ⊥ at h1
      rw [hq_deg, two_nsmul, ← Nat.cast_add, ← Nat.cast_add, le_bot_iff] at h1
      exact WithBot.natCast_ne_bot _ h1
  have h_alg_C : ∀ c : K, algebraMap (Polynomial K) R (Polynomial.C c) = algebraMap K R c := by
    intro c
    rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply K (Polynomial K) R c]
  have h_alg_X : algebraMap (Polynomial K) R Polynomial.X = X_R := rfl
  have h_alg_KL : ∀ c : K, algebraMap R L (algebraMap K R c) = algebraMap K L c :=
    fun c => (IsScalarTower.algebraMap_apply K R L c).symm
  have h_smul_quad :
      ∀ (a b d e : K),
        (Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b * Polynomial.X + Polynomial.C d : Polynomial K) • (1 : R) +
          (Polynomial.C e : Polynomial K) • Y_R =
        (algebraMap K R a * X_R ^ 2 + algebraMap K R b * X_R + algebraMap K R d) +
          algebraMap K R e * Y_R := by
    intro a b d e
    rw [Algebra.smul_def, mul_one, Algebra.smul_def,
      map_add, map_add, map_mul, map_mul, map_pow,
      h_alg_C a, h_alg_C b, h_alg_C d, h_alg_C e, h_alg_X]
  have h_smul_lin :
      ∀ (b d e : K),
        (Polynomial.C b * Polynomial.X + Polynomial.C d : Polynomial K) • (1 : R) +
          (Polynomial.C e : Polynomial K) • Y_R =
        (algebraMap K R b * X_R + algebraMap K R d) +
          algebraMap K R e * Y_R := by
    intro b d e
    rw [Algebra.smul_def, mul_one, Algebra.smul_def,
      map_add, map_mul, h_alg_C b, h_alg_C d, h_alg_C e, h_alg_X]
  have h_ER :
      Y_R ^ 2 + algebraMap K R W.a₁ * X_R * Y_R + algebraMap K R W.a₃ * Y_R =
        X_R ^ 3 + algebraMap K R W.a₂ * X_R ^ 2 + algebraMap K R W.a₄ * X_R +
          algebraMap K R W.a₆ := by
    have h_mul := (WeierstrassCurve.Affine.CoordinateRing.smul_basis_mul_Y (W' := W) (0 : Polynomial K) (1 : Polynomial K)).symm
    rw [zero_smul, one_smul, zero_add] at h_mul
    rw [Algebra.smul_def, mul_one, Algebra.smul_def,
      map_mul, map_one, map_add, map_add, map_add, map_pow, map_mul, map_pow, map_mul,
      map_sub, map_zero, map_mul, map_one, map_add, map_mul,
      h_alg_C W.a₂, h_alg_C W.a₄, h_alg_C W.a₆, h_alg_C W.a₁, h_alg_C W.a₃, h_alg_X] at h_mul
    exact (h_alg_identities (algebraMap K R) X_R Y_R).1 h_mul
  have hX_ne : ∀ c : K, X_gen ≠ algebraMap K L c := by
    intro c hc
    have h_sub : algebraMap R L (X_R - algebraMap K R c) = 0 := by
      rw [map_sub, h_alg_KL]
      exact sub_eq_zero.mpr hc
    have h_R : X_R - algebraMap K R c = 0 :=
      (map_eq_zero_iff _ (IsFractionRing.injective R L)).mp h_sub
    have h_smul : (Polynomial.X - Polynomial.C c : Polynomial K) • (1 : R) + (0 : Polynomial K) • Y_R = 0 := by
      rw [zero_smul, add_zero, Algebra.smul_def, mul_one, map_sub, h_alg_X, h_alg_C]
      exact h_R
    have h_p0 := (h_basis_eq_zero (Polynomial.X - Polynomial.C c) (0 : Polynomial K) h_smul).1
    exact Polynomial.X_sub_C_ne_zero c h_p0
  refine ⟨?_, hX_ne, ?_⟩
  · change ((W.map (algebraMap K L)).toAffine).Nonsingular X_gen Y_gen
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.equation_iff]
    rw [WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₂, WeierstrassCurve.map_a₃,
      WeierstrassCurve.map_a₄, WeierstrassCurve.map_a₆]
    refine ⟨?_, ?_⟩
    · have h_EL := congrArg (algebraMap R L) h_ER
      rw [map_add, map_add, map_mul, map_mul, map_pow, map_mul,
        map_add, map_add, map_add, map_pow, map_mul, map_pow, map_mul,
        h_alg_KL, h_alg_KL, h_alg_KL, h_alg_KL, h_alg_KL] at h_EL
      exact h_EL
    · by_contra h_sing
      push_neg at h_sing
      rcases h_sing with ⟨h_dx, h_dy⟩
      have h_dy' : -2 * Y_gen - algebraMap K L W.a₁ * X_gen - algebraMap K L W.a₃ = 0 := by
        linear_combination -h_dy
      have h_dy_L :
          algebraMap R L
            ((Polynomial.C W.a₁ * Polynomial.X + Polynomial.C W.a₃ : Polynomial K) • (1 : R) +
              (Polynomial.C (2 : K) : Polynomial K) • Y_R) = 0 := by
        rw [h_smul_lin, map_add, map_add, map_mul, map_mul,
          h_alg_KL, h_alg_KL, h_alg_KL]
        exact (h_alg_identities (algebraMap K L) X_gen Y_gen).2.1 h_dy'
      have h_dy_R := (map_eq_zero_iff _ (IsFractionRing.injective R L)).mp h_dy_L
      have h_2_zero : (2 : K) = 0 :=
        Polynomial.C_eq_zero.mp
          (h_basis_eq_zero (Polynomial.C W.a₁ * Polynomial.X + Polynomial.C W.a₃) (Polynomial.C (2 : K)) h_dy_R).2
      have h_dx_L :
          algebraMap R L
            ((Polynomial.C (-3 : K) * Polynomial.X ^ 2 +
              Polynomial.C (-2 * W.a₂) * Polynomial.X +
              Polynomial.C (-W.a₄) : Polynomial K) • (1 : R) +
              (Polynomial.C W.a₁ : Polynomial K) • Y_R) = 0 := by
        rw [h_smul_quad, map_add, map_add, map_add,
          map_mul (algebraMap R L), map_pow, map_mul (algebraMap R L), map_mul (algebraMap R L),
          h_alg_KL, h_alg_KL, h_alg_KL, h_alg_KL]
        exact (h_alg_identities (algebraMap K L) X_gen Y_gen).2.2.1 h_dx
      have h_dx_R := (map_eq_zero_iff _ (IsFractionRing.injective R L)).mp h_dx_L
      have h_p_dx :=
        (h_basis_eq_zero
          (Polynomial.C (-3 : K) * Polynomial.X ^ 2 + Polynomial.C (-2 * W.a₂) * Polynomial.X + Polynomial.C (-W.a₄))
          (Polynomial.C W.a₁) h_dx_R).1
      have h_coeff2 := congrArg (fun p : Polynomial K => p.coeff 2) h_p_dx
      simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul,
        Polynomial.coeff_X_pow, Polynomial.coeff_X, Polynomial.coeff_C,
        Polynomial.coeff_zero] at h_coeff2
      norm_num at h_coeff2
      have h_1_zero : (1 : K) = 0 := by linear_combination h_coeff2 - h_2_zero
      exact one_ne_zero h_1_zero
  · intro x_S y_S h_S c m h_chord
    have hu_ne : X_gen - algebraMap K L x_S ≠ 0 := sub_ne_zero.mpr (hX_ne x_S)
    have hm_mul : m * (X_gen - algebraMap K L x_S) = Y_gen - algebraMap K L y_S :=
      div_mul_cancel₀ _ hu_ne
    have h_chord_L :
        algebraMap R L
          ((Y_R - algebraMap K R y_S) ^ 2 +
            algebraMap K R W.a₁ * (Y_R - algebraMap K R y_S) * (X_R - algebraMap K R x_S) -
            (algebraMap K R W.a₂ + X_R + algebraMap K R x_S + algebraMap K R c) *
              (X_R - algebraMap K R x_S) ^ 2) = 0 := by
      rw [map_sub, map_add, map_pow, map_sub, map_mul, map_mul, map_sub, map_sub,
        map_mul, map_add, map_add, map_add, map_pow, map_sub,
        h_alg_KL, h_alg_KL, h_alg_KL, h_alg_KL, h_alg_KL]
      exact (h_alg_identities (algebraMap K L) X_gen Y_gen).2.2.2.1
        (algebraMap K L x_S) (algebraMap K L y_S) (algebraMap K L c) m h_chord hm_mul
    have h_chord_R :=
      (map_eq_zero_iff _ (IsFractionRing.injective R L)).mp h_chord_L
    have h_ES_K :
        y_S ^ 2 + W.a₁ * x_S * y_S + W.a₃ * y_S =
          x_S ^ 3 + W.a₂ * x_S ^ 2 + W.a₄ * x_S + W.a₆ :=
      (WeierstrassCurve.Affine.equation_iff x_S y_S).mp h_S.1
    let dx : K := 3 * x_S ^ 2 + 2 * W.a₂ * x_S + W.a₄ - W.a₁ * y_S
    let dy : K := 2 * y_S + W.a₁ * x_S + W.a₃
    let p_S : Polynomial K :=
      Polynomial.C (x_S - c) * Polynomial.X ^ 2 +
        Polynomial.C (-2 * (x_S - c) * x_S + dx) * Polynomial.X +
        Polynomial.C ((x_S - c) * x_S ^ 2 - dx * x_S + dy * y_S)
    let q_S : Polynomial K := Polynomial.C (-dy)
    have h_pq_zero : p_S • (1 : R) + q_S • Y_R = 0 := by
      dsimp only [p_S, q_S]
      rw [h_smul_quad]
      exact (h_alg_identities (algebraMap K R) X_R Y_R).2.2.2.2
        x_S y_S c dx dy rfl rfl h_chord_R h_ER h_ES_K
    obtain ⟨hp_S, hq_S⟩ := h_basis_eq_zero p_S q_S h_pq_zero
    have h_dy_zero : 2 * y_S + W.a₁ * x_S + W.a₃ = 0 :=
      neg_eq_zero.mp (Polynomial.C_eq_zero.mp hq_S)
    have hc2 := congrArg (fun p : Polynomial K => p.coeff 2) hp_S
    simp only [p_S, Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
      Polynomial.coeff_X, Polynomial.coeff_C, Polynomial.coeff_zero] at hc2
    norm_num at hc2
    have hc1 := congrArg (fun p : Polynomial K => p.coeff 1) hp_S
    simp only [p_S, Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
      Polynomial.coeff_X, Polynomial.coeff_C, Polynomial.coeff_zero] at hc1
    norm_num at hc1
    have h_dx_zero : W.a₁ * y_S - (3 * x_S ^ 2 + 2 * W.a₂ * x_S + W.a₄) = 0 := by
      dsimp only [dx] at hc1
      linear_combination -hc1 - 2 * x_S * hc2
    rcases ((WeierstrassCurve.Affine.nonsingular_iff' x_S y_S).mp h_S).2 with h1 | h2
    · exact h1 h_dx_zero
    · exact h2 h_dy_zero

theorem weierstrass_functionField_translation_equiv_spec (K : Type u) [Field K]
    [IsAlgClosed K] [DecidableEq K] (W : WeierstrassCurve.Affine K)
    (h_gen : ((W.baseChange W.FunctionField).toAffine).Nonsingular
      (algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)))
      (algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)))
    (hX_ne : ∀ c : K,
      algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)) ≠
      algebraMap K W.FunctionField c)
    (h_chord_ne : ∀ {x_S y_S : K} (h_S : W.Nonsingular x_S y_S) (c : K),
      let X_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))
      let Y_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)
      let m := (Y_gen - algebraMap K W.FunctionField y_S) /
        (X_gen - algebraMap K W.FunctionField x_S)
      m ^ 2 + algebraMap K W.FunctionField W.a₁ * m -
        algebraMap K W.FunctionField W.a₂ - X_gen -
        algebraMap K W.FunctionField x_S ≠
      algebraMap K W.FunctionField c) :
    ∃ (τ : W.Point → (W.FunctionField ≃ₐ[K] W.FunctionField)),
      τ 0 = AlgEquiv.refl ∧
      (∀ P Q : W.Point, τ (P + Q) = (τ P).trans (τ Q)) ∧
      (∀ {x_S y_S : K} (h_S : W.Nonsingular x_S y_S),
        let X_gen := algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))
        let Y_gen := algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)
        let m := (Y_gen - algebraMap K W.FunctionField y_S) /
          (X_gen - algebraMap K W.FunctionField x_S)
        τ (WeierstrassCurve.Affine.Point.some h_S) X_gen =
          m ^ 2 + algebraMap K W.FunctionField W.a₁ * m -
            algebraMap K W.FunctionField W.a₂ - X_gen -
            algebraMap K W.FunctionField x_S ∧
        τ (WeierstrassCurve.Affine.Point.some h_S) Y_gen =
          -m * (τ (WeierstrassCurve.Affine.Point.some h_S) X_gen - X_gen) - Y_gen -
            algebraMap K W.FunctionField W.a₁ *
              τ (WeierstrassCurve.Affine.Point.some h_S) X_gen -
            algebraMap K W.FunctionField W.a₃) :=
by
  classical
  have h_norm_identity :
      ∀ {A : Type u} [CommRing A] (f : K →+* A) (x y p_bar q_bar : A),
        p_bar + q_bar * y = 0 →
        y ^ 2 + f W.a₁ * x * y + f W.a₃ * y -
          (x ^ 3 + f W.a₂ * x ^ 2 + f W.a₄ * x + f W.a₆) = 0 →
        p_bar ^ 2 - p_bar * q_bar * (f W.a₁ * x + f W.a₃) -
          q_bar ^ 2 * (x ^ 3 + f W.a₂ * x ^ 2 + f W.a₄ * x + f W.a₆) = 0 := by
    intro A _ f x y p_bar q_bar h1 h2
    linear_combination (p_bar - q_bar * (y + f W.a₁ * x + f W.a₃)) * h1 + q_bar ^ 2 * h2
  let R := W.CoordinateRing
  let L := W.FunctionField
  let W_L : WeierstrassCurve.Affine L := (W.baseChange L).toAffine
  let X_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)
  let Y_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X
  let X_gen : L := algebraMap R L X_R
  let Y_gen : L := algebraMap R L Y_R
  haveI : Module.Free (Polynomial K) W.CoordinateRing :=
    Module.Free.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  haveI : Module.Finite (Polynomial K) W.CoordinateRing :=
    Module.Finite.of_basis (WeierstrassCurve.Affine.CoordinateRing.basis W)
  have h_algHom_ext : ∀ {f g : L →ₐ[K] L},
      f X_gen = g X_gen → f Y_gen = g Y_gen → f = g := by
    intro f g hX hY
    apply IsLocalization.algHom_ext (nonZeroDivisors R)
    apply AdjoinRoot.algHom_ext'
    · apply Polynomial.algHom_ext
      exact hX
    · exact hY
  obtain ⟨evalHom, heval_X, heval_Y⟩ :
      ∃ evalHom : ∀ (x y : L), W_L.Equation x y → (∀ c : K, x ≠ algebraMap K L c) → (L →ₐ[K] L),
        (∀ (x y : L) (h_eq : W_L.Equation x y) (hx_ne : ∀ c : K, x ≠ algebraMap K L c),
          evalHom x y h_eq hx_ne X_gen = x) ∧
        (∀ (x y : L) (h_eq : W_L.Equation x y) (hx_ne : ∀ c : K, x ≠ algebraMap K L c),
          evalHom x y h_eq hx_ne Y_gen = y) := by
    have h_ex : ∀ (x y : L), W_L.Equation x y → (∀ c : K, x ≠ algebraMap K L c) →
        ∃ φ : L →ₐ[K] L, φ X_gen = x ∧ φ Y_gen = y := by
      intro x y h_eq hx_ne
      have h_aeval_ne_zero :
          ∀ (n : ℕ) (P : Polynomial K), P.natDegree = n → P ≠ 0 → Polynomial.aeval x P ≠ 0 := by
        intro n
        induction n with
        | zero =>
          intro P hP_deg hP_ne
          have hP_eq : P = Polynomial.C (P.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hP_deg
          have hc_ne : P.coeff 0 ≠ 0 := by
            intro h0
            apply hP_ne
            rw [hP_eq, h0, map_zero]
          rw [hP_eq, Polynomial.aeval_C]
          exact (map_ne_zero_iff (algebraMap K L) (algebraMap K L).injective).mpr hc_ne
        | succ n ih =>
          intro P hP_deg hP_ne
          have hP_deg' : P.degree ≠ 0 := by
            rw [Polynomial.degree_eq_natDegree hP_ne, hP_deg]
            exact Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n)
          obtain ⟨c, hc⟩ := IsAlgClosed.exists_root P hP_deg'
          obtain ⟨Q, hPQ⟩ := Polynomial.dvd_iff_isRoot.mpr hc
          have hQ_ne : Q ≠ 0 := by
            rintro rfl
            rw [mul_zero] at hPQ
            exact hP_ne hPQ
          have hQ_deg : Q.natDegree = n := by
            have h1 := congrArg Polynomial.natDegree hPQ
            rw [hP_deg, Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero c) hQ_ne,
              Polynomial.natDegree_X_sub_C] at h1
            omega
          rw [hPQ, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
          exact mul_ne_zero (sub_ne_zero.mpr (hx_ne c)) (ih Q hQ_deg hQ_ne)
      have h_eval₂ :
          Polynomial.eval₂ (↑(Polynomial.aeval x : Polynomial K →ₐ[K] L)) y W.polynomial = 0 := by
        have h_coe :
            (↑(Polynomial.aeval x : Polynomial K →ₐ[K] L) : Polynomial K →+* L) =
              Polynomial.eval₂RingHom (algebraMap K L) x := rfl
        rw [h_coe, Polynomial.eval₂_eval₂RingHom_apply, ← WeierstrassCurve.Affine.map_polynomial]
        exact h_eq
      obtain ⟨φ_R, hφ_smul_one, hφ_X, hφ_Y⟩ :
          ∃ φ_R : R →ₐ[K] L,
            (∀ p : Polynomial K, φ_R (p • (1 : R)) = Polynomial.aeval x p) ∧
            φ_R X_R = x ∧
            φ_R Y_R = y := by
        let φ_R : R →ₐ[K] L := AdjoinRoot.liftAlgHom W.polynomial (Polynomial.aeval x) y h_eval₂
        have h_smul : ∀ p : Polynomial K, φ_R (p • (1 : R)) = Polynomial.aeval x p := by
          intro p
          have hp : p • (1 : R) = AdjoinRoot.of W.polynomial p := by
            rw [Algebra.smul_def, mul_one]
            rfl
          rw [hp]
          exact AdjoinRoot.liftAlgHom_of W.polynomial (Polynomial.aeval x) y h_eval₂ p
        refine ⟨φ_R, h_smul, ?_, ?_⟩
        · have hX_eq : X_R = (Polynomial.X : Polynomial K) • (1 : R) := by
            rw [Algebra.smul_def, mul_one]
            rfl
          rw [hX_eq, h_smul, Polynomial.aeval_X]
        · exact AdjoinRoot.liftAlgHom_root W.polynomial (Polynomial.aeval x) y h_eval₂
      have h_inj : Function.Injective φ_R := by
        rw [injective_iff_map_eq_zero]
        intro r hr
        obtain ⟨p, q, hpq⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq r
        rw [← hpq] at hr ⊢
        have hqY : q • Y_R = (q • (1 : R)) * Y_R := by
          rw [Algebra.smul_def, Algebra.smul_def, mul_one]
        have h_phi : Polynomial.aeval x p + Polynomial.aeval x q * y = 0 := by
          rw [hqY, map_add, map_mul, hφ_smul_one p, hφ_smul_one q, hφ_Y] at hr
          exact hr
        have h_eq_L :
            y ^ 2 + algebraMap K L W.a₁ * x * y + algebraMap K L W.a₃ * y -
              (x ^ 3 + algebraMap K L W.a₂ * x ^ 2 + algebraMap K L W.a₄ * x +
                algebraMap K L W.a₆) = 0 := by
          have h1 := (WeierstrassCurve.Affine.equation_iff' x y).mp h_eq
          change y ^ 2 + (W.map (algebraMap K L)).toAffine.a₁ * x * y +
              (W.map (algebraMap K L)).toAffine.a₃ * y -
            (x ^ 3 + (W.map (algebraMap K L)).toAffine.a₂ * x ^ 2 +
              (W.map (algebraMap K L)).toAffine.a₄ * x +
              (W.map (algebraMap K L)).toAffine.a₆) = 0 at h1
          rwa [WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₂, WeierstrassCurve.map_a₃,
            WeierstrassCurve.map_a₄, WeierstrassCurve.map_a₆] at h1
        let N_r : Polynomial K := Algebra.norm (Polynomial K) (p • (1 : R) + q • Y_R)
        have h_aeval_Nr : Polynomial.aeval x N_r = 0 := by
          dsimp only [N_r]
          rw [WeierstrassCurve.Affine.CoordinateRing.norm_smul_basis (W' := W) p q]
          simp only [map_sub, map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
          exact h_norm_identity (algebraMap K L) x y
            (Polynomial.aeval x p) (Polynomial.aeval x q) h_phi h_eq_L
        have hNr_zero : N_r = 0 := by
          by_contra hNr_ne
          exact h_aeval_ne_zero N_r.natDegree N_r rfl hNr_ne h_aeval_Nr
        have h_deg := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W) p q
        change N_r.degree = _ at h_deg
        rw [hNr_zero, Polynomial.degree_zero] at h_deg
        have hp0 : p = 0 := by
          by_contra hp
          have hp_deg : p.degree = (p.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hp
          have h1 : 2 • p.degree ≤ ⊥ := by rw [h_deg]; exact le_max_left _ _
          rw [hp_deg, two_nsmul, ← Nat.cast_add, le_bot_iff] at h1
          exact WithBot.natCast_ne_bot _ h1
        have hq0 : q = 0 := by
          by_contra hq
          have hq_deg : q.degree = (q.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hq
          have h1 : 2 • q.degree + 3 ≤ ⊥ := by rw [h_deg]; exact le_max_right _ _
          change 2 • q.degree + ((3 : ℕ) : WithBot ℕ) ≤ ⊥ at h1
          rw [hq_deg, two_nsmul, ← Nat.cast_add, ← Nat.cast_add, le_bot_iff] at h1
          exact WithBot.natCast_ne_bot _ h1
        rw [hp0, hq0, zero_smul, zero_smul, add_zero]
      let φ : L →ₐ[K] L := IsFractionRing.liftAlgHom h_inj
      refine ⟨φ, ?_, ?_⟩
      · change (IsFractionRing.liftAlgHom h_inj) (algebraMap R L X_R) = x
        rw [IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
        exact hφ_X
      · change (IsFractionRing.liftAlgHom h_inj) (algebraMap R L Y_R) = y
        rw [IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
        exact hφ_Y
    refine ⟨fun x y h_eq hx_ne => (h_ex x y h_eq hx_ne).choose,
      fun x y h_eq hx_ne => (h_ex x y h_eq hx_ne).choose_spec.1,
      fun x y h_eq hx_ne => (h_ex x y h_eq hx_ne).choose_spec.2⟩
  let P_gen : W_L.Point := WeierstrassCurve.Affine.Point.some h_gen
  let ι_pt : W.Point →+ W_L.Point :=
    WeierstrassCurve.Affine.Point.map (W' := W) (Algebra.ofId K L)
  have h_add_coords :
      ∀ {x_S y_S : K} (h_S : W.Nonsingular x_S y_S),
        let m := (Y_gen - algebraMap K L y_S) / (X_gen - algebraMap K L x_S)
        let x_tau := m ^ 2 + algebraMap K L W.a₁ * m -
          algebraMap K L W.a₂ - X_gen - algebraMap K L x_S
        let y_tau := -m * (x_tau - X_gen) - Y_gen -
          algebraMap K L W.a₁ * x_tau - algebraMap K L W.a₃
        ∃ (h_Q : W_L.Nonsingular x_tau y_tau),
          P_gen + ι_pt (WeierstrassCurve.Affine.Point.some h_S) =
            WeierstrassCurve.Affine.Point.some h_Q := by
    intro x_S y_S h_S m x_tau y_tau
    have h_S' : (W.baseChange K).toAffine.Nonsingular x_S y_S := h_S
    have h_map_S :=
      WeierstrassCurve.Affine.Point.map_some (W' := W) (Algebra.ofId K L) h_S'
    have hx_ne : X_gen ≠ (Algebra.ofId K L) x_S := hX_ne x_S
    have hxy :
        ¬(X_gen = (Algebra.ofId K L) x_S ∧
          Y_gen = W_L.negY ((Algebra.ofId K L) x_S) ((Algebra.ofId K L) y_S)) :=
      fun h => hx_ne h.1
    have h_add_eq :
        P_gen + ι_pt (WeierstrassCurve.Affine.Point.some h_S) =
          WeierstrassCurve.Affine.Point.some
            (W_L.nonsingular_add h_gen
              ((W.baseChange_nonsingular x_S y_S (Algebra.ofId K L).injective).mpr h_S') hxy) := by
      change P_gen + WeierstrassCurve.Affine.Point.map (W' := W) (Algebra.ofId K L)
          (WeierstrassCurve.Affine.Point.some h_S') = _
      rw [h_map_S]
      exact WeierstrassCurve.Affine.Point.add_of_X_ne hx_ne
    have h_slope :
        W_L.slope X_gen ((Algebra.ofId K L) x_S) Y_gen ((Algebra.ofId K L) y_S) = m :=
      W_L.slope_of_X_ne hx_ne
    have hx_eq :
        W_L.addX X_gen ((Algebra.ofId K L) x_S)
          (W_L.slope X_gen ((Algebra.ofId K L) x_S) Y_gen ((Algebra.ofId K L) y_S)) = x_tau := by
      rw [h_slope]
      change m ^ 2 + (W.map (algebraMap K L)).toAffine.a₁ * m -
        (W.map (algebraMap K L)).toAffine.a₂ - X_gen - algebraMap K L x_S = x_tau
      rw [WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₂]
    have hy_eq :
        W_L.addY X_gen ((Algebra.ofId K L) x_S) Y_gen
          (W_L.slope X_gen ((Algebra.ofId K L) x_S) Y_gen ((Algebra.ofId K L) y_S)) = y_tau := by
      have h_addY :
          W_L.addY X_gen ((Algebra.ofId K L) x_S) Y_gen
            (W_L.slope X_gen ((Algebra.ofId K L) x_S) Y_gen ((Algebra.ofId K L) y_S)) =
          W_L.negY x_tau
            (W_L.slope X_gen ((Algebra.ofId K L) x_S) Y_gen ((Algebra.ofId K L) y_S) *
              (x_tau - X_gen) + Y_gen) := by
        unfold WeierstrassCurve.Affine.addY WeierstrassCurve.Affine.negAddY
        rw [hx_eq]
      rw [h_addY, h_slope]
      change -(m * (x_tau - X_gen) + Y_gen) -
        (W.map (algebraMap K L)).toAffine.a₁ * x_tau -
        (W.map (algebraMap K L)).toAffine.a₃ =
        -m * (x_tau - X_gen) - Y_gen - algebraMap K L W.a₁ * x_tau - algebraMap K L W.a₃
      rw [WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₃]
      ring
    have h_Q : W_L.Nonsingular x_tau y_tau := by
      rw [← hx_eq, ← hy_eq]
      exact W_L.nonsingular_add h_gen
        ((W.baseChange_nonsingular x_S y_S (Algebra.ofId K L).injective).mpr h_S') hxy
    refine ⟨h_Q, ?_⟩
    change P_gen + ι_pt (WeierstrassCurve.Affine.Point.some h_S) =
      WeierstrassCurve.Affine.Point.some h_Q
    rw [h_add_eq, WeierstrassCurve.Affine.Point.some.injEq]
    exact ⟨hx_eq, hy_eq⟩
  have h_map_ι :
      ∀ (f : L →ₐ[K] L) (S : W.Point),
        WeierstrassCurve.Affine.Point.map (W' := W) f (ι_pt S) = ι_pt S := by
    intro f S
    change (WeierstrassCurve.Affine.Point.map (W' := W) f)
      ((WeierstrassCurve.Affine.Point.map (W' := W) (Algebra.ofId K L))
        (S : (W.baseChange K).toAffine.Point)) =
      (WeierstrassCurve.Affine.Point.map (W' := W) (Algebra.ofId K L))
        (S : (W.baseChange K).toAffine.Point)
    rw [WeierstrassCurve.Affine.Point.map_map (W' := W) (Algebra.ofId K L) f]
    have h_comp : f.comp (Algebra.ofId K L) = Algebra.ofId K L := by
      ext
    rw [h_comp]
  obtain ⟨τ₀, hτ₀_zero, hτ₀_Pgen, hτ₀_some⟩ :
      ∃ τ₀ : W.Point → (L →ₐ[K] L),
        τ₀ 0 = AlgHom.id K L ∧
        (∀ S : W.Point,
          WeierstrassCurve.Affine.Point.map (W' := W) (τ₀ S) P_gen = P_gen + ι_pt S) ∧
        (∀ {x_S y_S : K} (h_S : W.Nonsingular x_S y_S),
          let m := (Y_gen - algebraMap K L y_S) / (X_gen - algebraMap K L x_S)
          τ₀ (WeierstrassCurve.Affine.Point.some h_S) X_gen =
            m ^ 2 + algebraMap K L W.a₁ * m -
              algebraMap K L W.a₂ - X_gen - algebraMap K L x_S ∧
          τ₀ (WeierstrassCurve.Affine.Point.some h_S) Y_gen =
            -m * (τ₀ (WeierstrassCurve.Affine.Point.some h_S) X_gen - X_gen) - Y_gen -
              algebraMap K L W.a₁ *
                τ₀ (WeierstrassCurve.Affine.Point.some h_S) X_gen -
              algebraMap K L W.a₃) := by
    let τ₀ : W.Point → (L →ₐ[K] L) := fun S =>
      match S with
      | WeierstrassCurve.Affine.Point.zero => AlgHom.id K L
      | @WeierstrassCurve.Affine.Point.some _ _ _ x_S y_S h_S =>
          let m := (Y_gen - algebraMap K L y_S) / (X_gen - algebraMap K L x_S)
          let x_tau := m ^ 2 + algebraMap K L W.a₁ * m -
            algebraMap K L W.a₂ - X_gen - algebraMap K L x_S
          let y_tau := -m * (x_tau - X_gen) - Y_gen -
            algebraMap K L W.a₁ * x_tau - algebraMap K L W.a₃
          evalHom x_tau y_tau (h_add_coords h_S).choose.1 (h_chord_ne h_S)
    have h_some :
        ∀ {x_S y_S : K} (h_S : W.Nonsingular x_S y_S),
          let m := (Y_gen - algebraMap K L y_S) / (X_gen - algebraMap K L x_S)
          τ₀ (WeierstrassCurve.Affine.Point.some h_S) X_gen =
            m ^ 2 + algebraMap K L W.a₁ * m -
              algebraMap K L W.a₂ - X_gen - algebraMap K L x_S ∧
          τ₀ (WeierstrassCurve.Affine.Point.some h_S) Y_gen =
            -m * (τ₀ (WeierstrassCurve.Affine.Point.some h_S) X_gen - X_gen) - Y_gen -
              algebraMap K L W.a₁ *
                τ₀ (WeierstrassCurve.Affine.Point.some h_S) X_gen -
              algebraMap K L W.a₃ := by
      intro x_S y_S h_S m
      let x_tau := m ^ 2 + algebraMap K L W.a₁ * m -
        algebraMap K L W.a₂ - X_gen - algebraMap K L x_S
      let y_tau := -m * (x_tau - X_gen) - Y_gen -
        algebraMap K L W.a₁ * x_tau - algebraMap K L W.a₃
      have hX_tau : τ₀ (WeierstrassCurve.Affine.Point.some h_S) X_gen = x_tau :=
        heval_X x_tau y_tau (h_add_coords h_S).choose.1 (h_chord_ne h_S)
      have hY_tau : τ₀ (WeierstrassCurve.Affine.Point.some h_S) Y_gen = y_tau :=
        heval_Y x_tau y_tau (h_add_coords h_S).choose.1 (h_chord_ne h_S)
      refine ⟨hX_tau, ?_⟩
      rw [hX_tau, hY_tau]
    refine ⟨τ₀, rfl, ?_, h_some⟩
    intro S
    cases S with
    | zero =>
      change WeierstrassCurve.Affine.Point.map (W' := W) (Algebra.ofId L L) P_gen =
        P_gen + ι_pt 0
      rw [WeierstrassCurve.Affine.Point.map_id (W' := W), map_zero, add_zero]
    | some h_S =>
      change WeierstrassCurve.Affine.Point.map (W' := W)
        (τ₀ (WeierstrassCurve.Affine.Point.some h_S))
        (WeierstrassCurve.Affine.Point.some h_gen) =
        P_gen + ι_pt (WeierstrassCurve.Affine.Point.some h_S)
      rw [WeierstrassCurve.Affine.Point.map_some (W' := W),
        (h_add_coords h_S).choose_spec, WeierstrassCurve.Affine.Point.some.injEq]
      obtain ⟨hX_tau, hY_tau⟩ := h_some h_S
      refine ⟨hX_tau, ?_⟩
      rw [hY_tau, hX_tau]
  have hτ₀_comp : ∀ P Q : W.Point, (τ₀ Q).comp (τ₀ P) = τ₀ (P + Q) := by
    intro P Q
    have h_pt :
        WeierstrassCurve.Affine.Point.map (W' := W) ((τ₀ Q).comp (τ₀ P)) P_gen =
          WeierstrassCurve.Affine.Point.map (W' := W) (τ₀ (P + Q)) P_gen := by
      rw [← WeierstrassCurve.Affine.Point.map_map (W' := W), hτ₀_Pgen P, map_add, hτ₀_Pgen Q,
        h_map_ι (τ₀ Q) P, add_assoc, add_comm (ι_pt Q) (ι_pt P), ← map_add, ← hτ₀_Pgen (P + Q)]
    dsimp only [P_gen] at h_pt
    rw [WeierstrassCurve.Affine.Point.map_some (W' := W),
      WeierstrassCurve.Affine.Point.map_some (W' := W),
      WeierstrassCurve.Affine.Point.some.injEq] at h_pt
    exact h_algHom_ext h_pt.1 h_pt.2
  let τ : W.Point → (L ≃ₐ[K] L) := fun S =>
    AlgEquiv.ofAlgHom (τ₀ S) (τ₀ (-S))
      (by rw [hτ₀_comp, neg_add_cancel, hτ₀_zero])
      (by rw [hτ₀_comp, add_neg_cancel, hτ₀_zero])
  refine ⟨τ, ?_, ?_, ?_⟩
  · ext f
    change τ₀ 0 f = f
    rw [hτ₀_zero]
    rfl
  · intro P Q
    ext f
    change τ₀ (P + Q) f = τ₀ Q (τ₀ P f)
    rw [← hτ₀_comp]
    rfl
  · intro x_S y_S h_S
    exact hτ₀_some h_S

theorem weierstrass_functionField_galois_lift_and_comm_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F)
    (τ : EllipticRootNumber.Pts F E →
      (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃ₐ[AlgebraicClosure F]
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
    (hτ_zero : τ 0 = AlgEquiv.refl)
    (hτ_some : ∀ {x_S y_S : AlgebraicClosure F}
        (h_S : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x_S y_S),
      let W := (E.baseChange (AlgebraicClosure F)).toAffine
      let X_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))
      let Y_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)
      let m := (Y_gen - algebraMap (AlgebraicClosure F) W.FunctionField y_S) /
        (X_gen - algebraMap (AlgebraicClosure F) W.FunctionField x_S)
      τ (WeierstrassCurve.Affine.Point.some h_S) X_gen =
        m ^ 2 + algebraMap (AlgebraicClosure F) W.FunctionField W.a₁ * m -
          algebraMap (AlgebraicClosure F) W.FunctionField W.a₂ - X_gen -
          algebraMap (AlgebraicClosure F) W.FunctionField x_S ∧
      τ (WeierstrassCurve.Affine.Point.some h_S) Y_gen =
        -m * (τ (WeierstrassCurve.Affine.Point.some h_S) X_gen - X_gen) - Y_gen -
          algebraMap (AlgebraicClosure F) W.FunctionField W.a₁ *
            τ (WeierstrassCurve.Affine.Point.some h_S) X_gen -
          algebraMap (AlgebraicClosure F) W.FunctionField W.a₃) :
    ∃ (σ_lift : EllipticRootNumber.AbsGal F →
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃+*
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)),
      (∀ (σ : EllipticRootNumber.AbsGal F) (c : AlgebraicClosure F),
        σ_lift σ (algebraMap (AlgebraicClosure F)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField c) =
        algebraMap (AlgebraicClosure F)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField (σ c)) ∧
      (∀ σ : EllipticRootNumber.AbsGal F,
        σ_lift σ (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine (Polynomial.C Polynomial.X))) =
        algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine (Polynomial.C Polynomial.X)) ∧
        σ_lift σ (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine Polynomial.X)) =
        algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine Polynomial.X)) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (S : EllipticRootNumber.Pts F E)
          (f : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField),
        σ_lift σ (τ S f) = τ (EllipticRootNumber.galHom F E σ S) (σ_lift σ f)) :=
by
  let K := AlgebraicClosure F
  let W : WeierstrassCurve.Affine K := (E.baseChange K).toAffine
  let R := W.CoordinateRing
  let L := W.FunctionField
  letI : CommRing R := inferInstance
  letI instFieldL : Field L := inferInstance
  letI : CommRing L := instFieldL.toCommRing
  letI : Algebra K R := inferInstance
  letI : Algebra R L := inferInstance
  letI : Algebra K L := inferInstance
  haveI : IsScalarTower K R L := inferInstance
  haveI : IsFractionRing R L := inferInstance
  let X_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)
  let Y_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X
  let X_gen : L := algebraMap R L X_R
  let Y_gen : L := algebraMap R L Y_R
  have h_a₁ : ∀ σ : EllipticRootNumber.AbsGal F, σ W.a₁ = W.a₁ := by
    intro σ
    change σ (E.map (algebraMap F K)).a₁ = (E.map (algebraMap F K)).a₁
    rw [WeierstrassCurve.map_a₁]
    exact σ.commutes E.a₁
  have h_a₂ : ∀ σ : EllipticRootNumber.AbsGal F, σ W.a₂ = W.a₂ := by
    intro σ
    change σ (E.map (algebraMap F K)).a₂ = (E.map (algebraMap F K)).a₂
    rw [WeierstrassCurve.map_a₂]
    exact σ.commutes E.a₂
  have h_a₃ : ∀ σ : EllipticRootNumber.AbsGal F, σ W.a₃ = W.a₃ := by
    intro σ
    change σ (E.map (algebraMap F K)).a₃ = (E.map (algebraMap F K)).a₃
    rw [WeierstrassCurve.map_a₃]
    exact σ.commutes E.a₃
  have h_alg_K_R : ∀ c : K, algebraMap K R c = AdjoinRoot.of W.polynomial (Polynomial.C c) := by
    intro c
    rw [IsScalarTower.algebraMap_apply K (Polynomial K) R c, Polynomial.algebraMap_eq,
      AdjoinRoot.algebraMap_eq W.polynomial]
  have hX_R_eq : X_R = AdjoinRoot.of W.polynomial Polynomial.X :=
    AdjoinRoot.mk_C Polynomial.X
  have hY_R_eq : Y_R = AdjoinRoot.root W.polynomial :=
    AdjoinRoot.mk_X
  have h_R_ext : ∀ {S : Type u} [CommRing S] (φ₁ φ₂ : R →+* S),
      (∀ c : K, φ₁ (algebraMap K R c) = φ₂ (algebraMap K R c)) →
      φ₁ X_R = φ₂ X_R →
      φ₁ Y_R = φ₂ Y_R →
      φ₁ = φ₂ := by
    intro S _ φ₁ φ₂ h_c h_X h_Y
    apply AdjoinRoot.ringHom_ext
    · apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, ← h_alg_K_R c]
        exact h_c c
      · simp only [RingHom.comp_apply, ← hX_R_eq]
        exact h_X
    · rw [← hY_R_eq]
      exact h_Y
  obtain ⟨σ_R₀, hσ_R₀_alg, hσ_R₀_X, hσ_R₀_Y⟩ :
      ∃ σ_R₀ : EllipticRootNumber.AbsGal F → (R →+* R),
        (∀ (σ : EllipticRootNumber.AbsGal F) (c : K),
          σ_R₀ σ (algebraMap K R c) = algebraMap K R (σ c)) ∧
        (∀ σ : EllipticRootNumber.AbsGal F, σ_R₀ σ X_R = X_R) ∧
        (∀ σ : EllipticRootNumber.AbsGal F, σ_R₀ σ Y_R = Y_R) := by
    have h_comp_σ : ∀ σ : EllipticRootNumber.AbsGal F,
        σ.toRingHom.comp (algebraMap F K) = algebraMap F K :=
      fun σ => RingHom.ext fun c => σ.commutes c
    have h_map_W : ∀ σ : EllipticRootNumber.AbsGal F,
        WeierstrassCurve.map W σ.toRingHom = W := by
      intro σ
      change (E.map (algebraMap F K)).map σ.toRingHom = E.map (algebraMap F K)
      rw [WeierstrassCurve.map_map, h_comp_σ σ]
    have h_poly_σ : ∀ σ : EllipticRootNumber.AbsGal F,
        Polynomial.map (Polynomial.mapRingHom σ.toRingHom) W.polynomial = W.polynomial := by
      intro σ
      rw [← WeierstrassCurve.Affine.map_polynomial σ.toRingHom, h_map_W σ]
    have h_eval_σ : ∀ σ : EllipticRootNumber.AbsGal F,
        Polynomial.eval₂
          ((AdjoinRoot.of W.polynomial).comp (Polynomial.mapRingHom σ.toRingHom))
          (AdjoinRoot.root W.polynomial) W.polynomial = 0 := by
      intro σ
      rw [← Polynomial.eval₂_map, h_poly_σ σ, AdjoinRoot.eval₂_root W.polynomial]
    refine ⟨fun σ =>
      AdjoinRoot.lift ((AdjoinRoot.of W.polynomial).comp (Polynomial.mapRingHom σ.toRingHom))
        (AdjoinRoot.root W.polynomial) (h_eval_σ σ), ?_, ?_, ?_⟩
    · intro σ c
      rw [h_alg_K_R c, h_alg_K_R (σ c), AdjoinRoot.lift_of,
        RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
      rfl
    · intro σ
      rw [hX_R_eq, AdjoinRoot.lift_of,
        RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
    · intro σ
      rw [hY_R_eq]
      exact AdjoinRoot.lift_root (h_eval_σ σ)
  obtain ⟨σ_lift, hσ_alg, hσ_X, hσ_Y⟩ :
      ∃ σ_lift : EllipticRootNumber.AbsGal F → (L ≃+* L),
        (∀ (σ : EllipticRootNumber.AbsGal F) (c : K),
          σ_lift σ (algebraMap K L c) = algebraMap K L (σ c)) ∧
        (∀ σ : EllipticRootNumber.AbsGal F, σ_lift σ X_gen = X_gen) ∧
        (∀ σ : EllipticRootNumber.AbsGal F, σ_lift σ Y_gen = Y_gen) := by
    have h_σ_inv : ∀ σ : EllipticRootNumber.AbsGal F,
        (σ_R₀ σ).comp (σ_R₀ σ⁻¹) = RingHom.id R := by
      intro σ
      apply h_R_ext
      · intro c
        have h_cancel : σ (σ⁻¹ c) = c := by
          rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
        simp only [RingHom.comp_apply, RingHom.id_apply, hσ_R₀_alg, h_cancel]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hσ_R₀_X]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hσ_R₀_Y]
    have h_inv_σ : ∀ σ : EllipticRootNumber.AbsGal F,
        (σ_R₀ σ⁻¹).comp (σ_R₀ σ) = RingHom.id R := by
      intro σ
      apply h_R_ext
      · intro c
        have h_cancel : σ⁻¹ (σ c) = c := by
          rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
        simp only [RingHom.comp_apply, RingHom.id_apply, hσ_R₀_alg, h_cancel]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hσ_R₀_X]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hσ_R₀_Y]
    let σ_R : EllipticRootNumber.AbsGal F → (R ≃+* R) := fun σ =>
      RingEquiv.ofRingHom (σ_R₀ σ) (σ_R₀ σ⁻¹) (h_σ_inv σ) (h_inv_σ σ)
    have hσ_R_apply : ∀ (σ : EllipticRootNumber.AbsGal F) (r : R),
        σ_R σ r = σ_R₀ σ r := fun _ _ => rfl
    have hσ_lift_algebraMap : ∀ (σ : EllipticRootNumber.AbsGal F) (r : R),
        IsFractionRing.ringEquivOfRingEquiv (σ_R σ) (algebraMap R L r) =
          algebraMap R L (σ_R₀ σ r) := by
      intro σ r
      exact (IsFractionRing.ringEquivOfRingEquiv_algebraMap (σ_R σ) r).trans
        (congrArg (algebraMap R L) (hσ_R_apply σ r))
    refine ⟨fun σ => IsFractionRing.ringEquivOfRingEquiv (σ_R σ), ?_, ?_, ?_⟩
    · intro σ c
      rw [IsScalarTower.algebraMap_apply K R L c, IsScalarTower.algebraMap_apply K R L (σ c),
        hσ_lift_algebraMap, hσ_R₀_alg]
    · intro σ
      exact (hσ_lift_algebraMap σ X_R).trans (congrArg (algebraMap R L) (hσ_R₀_X σ))
    · intro σ
      exact (hσ_lift_algebraMap σ Y_R).trans (congrArg (algebraMap R L) (hσ_R₀_Y σ))
  have h_L_ext : ∀ (Φ₁ Φ₂ : L →+* L),
      (∀ c : K, Φ₁ (algebraMap K L c) = Φ₂ (algebraMap K L c)) →
      Φ₁ X_gen = Φ₂ X_gen →
      Φ₁ Y_gen = Φ₂ Y_gen →
      Φ₁ = Φ₂ := by
    intro Φ₁ Φ₂ h_c h_X h_Y
    apply IsLocalization.ringHom_ext (nonZeroDivisors R)
    apply h_R_ext
    · intro c
      simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply K R L c]
      exact h_c c
    · exact h_X
    · exact h_Y
  have hσ_τ : ∀ (σ : EllipticRootNumber.AbsGal F) (S : EllipticRootNumber.Pts F E) (f : L),
      σ_lift σ (τ S f) = τ (EllipticRootNumber.galHom F E σ S) (σ_lift σ f) := by
    intro σ S f
    obtain ⟨Φ₁, hΦ₁_apply⟩ : ∃ Φ₁ : L →+* L, ∀ x : L, Φ₁ x = σ_lift σ (τ S x) :=
      ⟨(σ_lift σ : L →+* L).comp (τ S : L →+* L), fun x => by
        rw [RingHom.comp_apply, RingHom.coe_coe, RingHom.coe_coe]⟩
    obtain ⟨Φ₂, hΦ₂_apply⟩ :
        ∃ Φ₂ : L →+* L, ∀ x : L, Φ₂ x = τ (EllipticRootNumber.galHom F E σ S) (σ_lift σ x) :=
      ⟨(τ (EllipticRootNumber.galHom F E σ S) : L →+* L).comp (σ_lift σ : L →+* L), fun x => by
        rw [RingHom.comp_apply, RingHom.coe_coe, RingHom.coe_coe]⟩
    have h_XY : Φ₁ X_gen = Φ₂ X_gen ∧ Φ₁ Y_gen = Φ₂ Y_gen := by
      rw [hΦ₁_apply, hΦ₂_apply, hΦ₁_apply, hΦ₂_apply, hσ_X σ, hσ_Y σ]
      cases S with
      | zero =>
        have h_zero_eq : (WeierstrassCurve.Affine.Point.zero : EllipticRootNumber.Pts F E) = 0 := rfl
        rw [h_zero_eq, map_zero (EllipticRootNumber.galHom F E σ), hτ_zero,
          AlgEquiv.coe_refl, id_eq, id_eq]
        exact ⟨hσ_X σ, hσ_Y σ⟩
      | some h_S =>
        rename_i x_S y_S
        have h_σS : W.Nonsingular (σ x_S) (σ y_S) :=
          (WeierstrassCurve.Affine.baseChange_nonsingular (W := E.toAffine)
            (f := (σ : K →ₐ[F] K)) x_S y_S σ.injective).mpr h_S
        have h_map_some :
            EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h_S) =
              WeierstrassCurve.Affine.Point.some h_σS := rfl
        rw [h_map_some]
        have hσ_add : ∀ a b : L, σ_lift σ (a + b) = σ_lift σ a + σ_lift σ b :=
          (σ_lift σ).map_add'
        have hσ_mul : ∀ a b : L, σ_lift σ (a * b) = σ_lift σ a * σ_lift σ b :=
          (σ_lift σ).map_mul'
        have hσ_zero : σ_lift σ 0 = 0 := by
          have h := hσ_add 0 0
          rwa [add_zero, left_eq_add] at h
        have hσ_one : σ_lift σ 1 = 1 := by
          have h := hσ_alg σ 1
          have h1 : algebraMap K L 1 = 1 := RingHom.map_one _
          have hσ1 : σ 1 = 1 := map_one σ
          rwa [hσ1, h1] at h
        have hσ_neg : ∀ a : L, σ_lift σ (-a) = -σ_lift σ a := fun a =>
          eq_neg_of_add_eq_zero_left (by rw [← hσ_add, neg_add_cancel, hσ_zero])
        have hσ_sub : ∀ a b : L, σ_lift σ (a - b) = σ_lift σ a - σ_lift σ b := fun a b => by
          rw [sub_eq_add_neg, hσ_add, hσ_neg, ← sub_eq_add_neg]
        have hσ_sq : ∀ a : L, σ_lift σ (a ^ 2) = (σ_lift σ a) ^ 2 := fun a => by
          rw [sq, sq, hσ_mul]
        have hσ_div : ∀ a b : L, σ_lift σ (a / b) = σ_lift σ a / σ_lift σ b := by
          intro a b
          rcases eq_or_ne b 0 with rfl | hb
          · rw [div_zero, hσ_zero, div_zero]
          · have h_mul_inv : σ_lift σ b⁻¹ * σ_lift σ b = 1 := by
              rw [← hσ_mul, inv_mul_cancel₀ hb, hσ_one]
            have hb' : σ_lift σ b ≠ 0 := right_ne_zero_of_mul_eq_one h_mul_inv
            rw [eq_div_iff hb', ← hσ_mul, div_mul_cancel₀ a hb]
        have hX_comm :
            σ_lift σ (τ (WeierstrassCurve.Affine.Point.some h_S) X_gen) =
              τ (WeierstrassCurve.Affine.Point.some h_σS) X_gen := by
          rw [(hτ_some h_S).1, (hτ_some h_σS).1]
          simp only [hσ_sub, hσ_add, hσ_mul, hσ_sq, hσ_div]
          rw [hσ_Y σ, hσ_X σ, hσ_alg σ y_S, hσ_alg σ x_S,
            hσ_alg σ W.a₁, hσ_alg σ W.a₂, h_a₁ σ, h_a₂ σ]
        have hY_comm :
            σ_lift σ (τ (WeierstrassCurve.Affine.Point.some h_S) Y_gen) =
              τ (WeierstrassCurve.Affine.Point.some h_σS) Y_gen := by
          rw [(hτ_some h_S).2, (hτ_some h_σS).2]
          simp only [hσ_sub, hσ_neg, hσ_mul, hσ_div]
          rw [hX_comm, hσ_Y σ, hσ_X σ, hσ_alg σ y_S, hσ_alg σ x_S,
            hσ_alg σ W.a₁, hσ_alg σ W.a₃, h_a₁ σ, h_a₃ σ]
        exact ⟨hX_comm, hY_comm⟩
    have h_eq : Φ₁ = Φ₂ := by
      apply h_L_ext
      · intro c
        rw [hΦ₁_apply, hΦ₂_apply, AlgEquiv.commutes (τ S) c, hσ_alg σ c,
          AlgEquiv.commutes (τ (EllipticRootNumber.galHom F E σ S)) (σ c)]
      · exact h_XY.1
      · exact h_XY.2
    exact (hΦ₁_apply f).symm.trans ((RingHom.congr_fun h_eq f).trans (hΦ₂_apply f))
  exact ⟨σ_lift, hσ_alg, fun σ => ⟨hσ_X σ, hσ_Y σ⟩, hσ_τ⟩

theorem weierstrass_functionField_translation_and_galois_lift_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0) :
    ∃ (τ : EllipticRootNumber.Pts F E →
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃ₐ[AlgebraicClosure F]
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
      (σ_lift : EllipticRootNumber.AbsGal F →
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃+*
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)),
      τ 0 = AlgEquiv.refl ∧
      (∀ P Q : EllipticRootNumber.Pts F E, τ (P + Q) = (τ P).trans (τ Q)) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (c : AlgebraicClosure F),
        σ_lift σ (algebraMap (AlgebraicClosure F)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField c) =
        algebraMap (AlgebraicClosure F)
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField (σ c)) ∧
      (∀ σ : EllipticRootNumber.AbsGal F,
        σ_lift σ (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine (Polynomial.C Polynomial.X))) =
        algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine (Polynomial.C Polynomial.X)) ∧
        σ_lift σ (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine Polynomial.X)) =
        algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk
            (E.baseChange (AlgebraicClosure F)).toAffine Polynomial.X)) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (S : EllipticRootNumber.Pts F E)
          (f : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField),
        σ_lift σ (τ S f) = τ (EllipticRootNumber.galHom F E σ S) (σ_lift σ f)) ∧
      (∀ {x_S y_S : AlgebraicClosure F}
          (h_S : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x_S y_S),
        let W := (E.baseChange (AlgebraicClosure F)).toAffine
        let X_gen := algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))
        let Y_gen := algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)
        let m := (Y_gen - algebraMap (AlgebraicClosure F) W.FunctionField y_S) /
          (X_gen - algebraMap (AlgebraicClosure F) W.FunctionField x_S)
        τ (WeierstrassCurve.Affine.Point.some h_S) X_gen =
          m ^ 2 + algebraMap (AlgebraicClosure F) W.FunctionField W.a₁ * m -
            algebraMap (AlgebraicClosure F) W.FunctionField W.a₂ - X_gen -
            algebraMap (AlgebraicClosure F) W.FunctionField x_S ∧
        τ (WeierstrassCurve.Affine.Point.some h_S) Y_gen =
          -m * (τ (WeierstrassCurve.Affine.Point.some h_S) X_gen - X_gen) - Y_gen -
            algebraMap (AlgebraicClosure F) W.FunctionField W.a₁ *
              τ (WeierstrassCurve.Affine.Point.some h_S) X_gen -
            algebraMap (AlgebraicClosure F) W.FunctionField W.a₃) :=
by
  let K := AlgebraicClosure F
  let W : WeierstrassCurve.Affine K := (E.baseChange K).toAffine
  obtain ⟨h_gen, hX_ne, h_chord_ne⟩ :=
    weierstrass_functionField_generic_point_and_chord_ne_const K W
  obtain ⟨τ, hτ_zero, hτ_add, hτ_some⟩ :=
    weierstrass_functionField_translation_equiv_spec K W h_gen hX_ne h_chord_ne
  obtain ⟨σ_lift, hσ_alg, hσ_XY, hσ_τ⟩ :=
    weierstrass_functionField_galois_lift_and_comm_spec F E τ hτ_zero hτ_some
  exact ⟨τ, σ_lift, hτ_zero, hτ_add, hσ_alg, hσ_XY, hσ_τ, hτ_some⟩

theorem weierstrass_functionField_vertical_line_spanSingleton (K : Type u) [Field K]
    [DecidableEq K] (W : WeierstrassCurve.Affine K)
    (τ : W.Point → (W.FunctionField ≃ₐ[K] W.FunctionField))
    (I : W.Point → (FractionalIdeal (nonZeroDivisors W.CoordinateRing) W.FunctionField)ˣ)
    (hτ_zero : τ 0 = AlgEquiv.refl)
    (hτ_some : ∀ {x_S y_S : K} (h_S : W.Nonsingular x_S y_S),
      let X_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))
      let Y_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)
      let m := (Y_gen - algebraMap K W.FunctionField y_S) /
        (X_gen - algebraMap K W.FunctionField x_S)
      τ (WeierstrassCurve.Affine.Point.some h_S) X_gen =
        m ^ 2 + algebraMap K W.FunctionField W.a₁ * m -
          algebraMap K W.FunctionField W.a₂ - X_gen -
          algebraMap K W.FunctionField x_S ∧
      τ (WeierstrassCurve.Affine.Point.some h_S) Y_gen =
        -m * (τ (WeierstrassCurve.Affine.Point.some h_S) X_gen - X_gen) - Y_gen -
          algebraMap K W.FunctionField W.a₁ *
            τ (WeierstrassCurve.Affine.Point.some h_S) X_gen -
          algebraMap K W.FunctionField W.a₃)
    (hI0 : I 0 = 1)
    (hI_some : ∀ {x y : K} (h : W.Nonsingular x y),
      I (WeierstrassCurve.Affine.Point.some h) =
        WeierstrassCurve.Affine.CoordinateRing.XYIdeal' h) :
    (∀ {x₁ y₁ x₂ y₂ : K} (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂),
      ¬(x₁ = x₂ ∧ y₁ = W.negY x₂ y₂) →
      FractionalIdeal.spanSingleton (nonZeroDivisors W.CoordinateRing)
        (algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.YClass W
            (WeierstrassCurve.Affine.linePolynomial x₁ y₁ (W.slope x₁ x₂ y₁ y₂)))) =
        ↑(I (WeierstrassCurve.Affine.Point.some h₁) *
          I (WeierstrassCurve.Affine.Point.some h₂) *
          I (-(WeierstrassCurve.Affine.Point.some h₁ +
            WeierstrassCurve.Affine.Point.some h₂)))) ∧
    (∀ {x_P y_P : K} (h_P : W.Nonsingular x_P y_P) (S : W.Point),
      FractionalIdeal.spanSingleton (nonZeroDivisors W.CoordinateRing)
        (τ S (algebraMap W.CoordinateRing W.FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.XClass W x_P))) =
        ↑(I (WeierstrassCurve.Affine.Point.some h_P - S) *
          I (-WeierstrassCurve.Affine.Point.some h_P - S) *
          (I (-S))⁻¹ * (I (-S))⁻¹)) :=
by
  let R := W.CoordinateRing
  let L := W.FunctionField
  have h_unit_solve : ∀ (u v w : (FractionalIdeal (nonZeroDivisors R) L)ˣ)
      (J : FractionalIdeal (nonZeroDivisors R) L),
      ↑u * J = ↑v → v = u * w → J = ↑w := by
    intro u v w J hJ hvw
    have h1 := congrArg
      (((u⁻¹ : (FractionalIdeal (nonZeroDivisors R) L)ˣ) :
        FractionalIdeal (nonZeroDivisors R) L) * ·) hJ
    dsimp only at h1
    rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul,
      hvw, Units.val_mul, ← mul_assoc, ← Units.val_mul, inv_mul_cancel,
      Units.val_one, one_mul] at h1
    exact h1
  have h_XIdeal : ∀ {x y : K} (h : W.Nonsingular x y),
      (↑(WeierstrassCurve.Affine.CoordinateRing.XIdeal W x) :
        FractionalIdeal (nonZeroDivisors R) L) =
      ↑(I (WeierstrassCurve.Affine.Point.some h) *
        I (-WeierstrassCurve.Affine.Point.some h)) := by
    intro x y h
    rw [WeierstrassCurve.Affine.Point.neg_some h, hI_some h,
      hI_some ((WeierstrassCurve.Affine.nonsingular_neg x y).mpr h),
      Units.val_mul,
      WeierstrassCurve.Affine.CoordinateRing.XYIdeal'_eq,
      WeierstrassCurve.Affine.CoordinateRing.XYIdeal'_eq,
      mul_comm, ← FractionalIdeal.coeIdeal_mul,
      WeierstrassCurve.Affine.CoordinateRing.XYIdeal_neg_mul h]
  have h_vert_zero : ∀ {x y : K} (h : W.Nonsingular x y),
      FractionalIdeal.spanSingleton (nonZeroDivisors R)
        (algebraMap R L (WeierstrassCurve.Affine.CoordinateRing.XClass W x)) =
      ↑(I (WeierstrassCurve.Affine.Point.some h) *
        I (-WeierstrassCurve.Affine.Point.some h)) := by
    intro x y h
    rw [← FractionalIdeal.coeIdeal_span_singleton,
      ← WeierstrassCurve.Affine.CoordinateRing.XIdeal, h_XIdeal h]
  have h_line_zero : ∀ {x₁ y₁ x₂ y₂ : K} (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂),
      ¬(x₁ = x₂ ∧ y₁ = W.negY x₂ y₂) →
      FractionalIdeal.spanSingleton (nonZeroDivisors R)
        (algebraMap R L
          (WeierstrassCurve.Affine.CoordinateRing.YClass W
            (WeierstrassCurve.Affine.linePolynomial x₁ y₁ (W.slope x₁ x₂ y₁ y₂)))) =
        ↑(I (WeierstrassCurve.Affine.Point.some h₁) *
          I (WeierstrassCurve.Affine.Point.some h₂) *
          I (-(WeierstrassCurve.Affine.Point.some h₁ +
            WeierstrassCurve.Affine.Point.some h₂))) := by
    intro x₁ y₁ x₂ y₂ h₁ h₂ hxy
    let h₃ := W.nonsingular_add h₁ h₂ hxy
    have h_add : WeierstrassCurve.Affine.Point.some h₁ + WeierstrassCurve.Affine.Point.some h₂ =
        WeierstrassCurve.Affine.Point.some h₃ :=
      WeierstrassCurve.Affine.Point.add_some hxy
    have h_mul := congrArg
      (fun J : Ideal R => (J : FractionalIdeal (nonZeroDivisors R) L))
      (WeierstrassCurve.Affine.CoordinateRing.XYIdeal_mul_XYIdeal h₁.1 h₂.1 hxy)
    dsimp only at h_mul
    rw [FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_mul,
      FractionalIdeal.coeIdeal_mul, h_XIdeal h₃,
      ← WeierstrassCurve.Affine.CoordinateRing.XYIdeal'_eq h₁,
      ← WeierstrassCurve.Affine.CoordinateRing.XYIdeal'_eq h₂,
      ← WeierstrassCurve.Affine.CoordinateRing.XYIdeal'_eq h₃,
      ← hI_some h₁, ← hI_some h₂, ← hI_some h₃,
      WeierstrassCurve.Affine.CoordinateRing.YIdeal,
      FractionalIdeal.coeIdeal_span_singleton,
      ← Units.val_mul, ← Units.val_mul,
      mul_comm (FractionalIdeal.spanSingleton _ _)] at h_mul
    rw [h_add]
    exact h_unit_solve _ _ _ _ h_mul.symm (by ac_rfl)
  let X_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X)
  let Y_R : R := WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X
  let X_gen : L := algebraMap R L X_R
  let Y_gen : L := algebraMap R L Y_R
  have h_alg_K : ∀ c : K, algebraMap R L (algebraMap K R c) = algebraMap K L c :=
    fun c => (IsScalarTower.algebraMap_apply K R L c).symm
  have h_XClass : ∀ x : K,
      algebraMap R L (WeierstrassCurve.Affine.CoordinateRing.XClass W x) =
        X_gen - algebraMap K L x := by
    intro x
    have h_eq : WeierstrassCurve.Affine.CoordinateRing.XClass W x =
        X_R - algebraMap K R x := by
      change WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.X - Polynomial.C x)) =
        WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X) -
          WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C x))
      rw [map_sub, map_sub]
    rw [h_eq, map_sub, h_alg_K]
  have h_YClass_line : ∀ x y ℓ : K,
      algebraMap R L
        (WeierstrassCurve.Affine.CoordinateRing.YClass W
          (WeierstrassCurve.Affine.linePolynomial x y ℓ)) =
        Y_gen - (algebraMap K L ℓ * (X_gen - algebraMap K L x) + algebraMap K L y) := by
    intro x y ℓ
    have h_eq : WeierstrassCurve.Affine.CoordinateRing.YClass W
          (WeierstrassCurve.Affine.linePolynomial x y ℓ) =
        Y_R - (algebraMap K R ℓ * (X_R - algebraMap K R x) + algebraMap K R y) := by
      change WeierstrassCurve.Affine.CoordinateRing.mk W
          (Polynomial.X - Polynomial.C (Polynomial.C ℓ * (Polynomial.X - Polynomial.C x) + Polynomial.C y)) =
        WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X -
          (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C ℓ)) *
            (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X) -
              WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C x))) +
            WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C (Polynomial.C y)))
      simp only [map_sub, map_add, map_mul]
    rw [h_eq, map_sub, map_add, map_mul, map_sub, h_alg_K, h_alg_K, h_alg_K]
  have h_span_const_mul : ∀ {c : K}, c ≠ 0 → ∀ z : L,
      FractionalIdeal.spanSingleton (nonZeroDivisors R) (algebraMap K L c * z) =
        FractionalIdeal.spanSingleton (nonZeroDivisors R) z := by
    intro c hc z
    rw [← FractionalIdeal.spanSingleton_mul_spanSingleton, ← h_alg_K c,
      ← FractionalIdeal.coeIdeal_span_singleton]
    have h_unit : IsUnit (algebraMap K R c) := (Units.mk0 c hc).isUnit.map (algebraMap K R)
    rw [Ideal.span_singleton_eq_top.mpr h_unit, FractionalIdeal.coeIdeal_top, one_mul]
  have hE_G : Y_gen ^ 2 + algebraMap K L W.a₁ * X_gen * Y_gen + algebraMap K L W.a₃ * Y_gen -
      (X_gen ^ 3 + algebraMap K L W.a₂ * X_gen ^ 2 +
        algebraMap K L W.a₄ * X_gen + algebraMap K L W.a₆) = 0 := by
    have h_smul := WeierstrassCurve.Affine.CoordinateRing.smul_basis_mul_Y (W' := W) 0 1
    simp only [zero_smul, one_smul, zero_add, one_mul, zero_sub, neg_smul,
      WeierstrassCurve.Affine.CoordinateRing.smul, map_add, map_mul, map_pow,
      mul_one] at h_smul
    have h_L := congrArg (algebraMap R L) h_smul
    change algebraMap R L (Y_R * Y_R) =
      algebraMap R L
        ((X_R ^ 3 + algebraMap K R W.a₂ * X_R ^ 2 +
          algebraMap K R W.a₄ * X_R + algebraMap K R W.a₆) +
        -((algebraMap K R W.a₁ * X_R + algebraMap K R W.a₃) * Y_R)) at h_L
    simp only [map_add, map_neg, map_mul, map_pow, h_alg_K] at h_L
    linear_combination h_L
  have hE_pt : ∀ {x y : K}, W.Nonsingular x y →
      (algebraMap K L y) ^ 2 + algebraMap K L W.a₁ * algebraMap K L x * algebraMap K L y +
        algebraMap K L W.a₃ * algebraMap K L y -
      ((algebraMap K L x) ^ 3 + algebraMap K L W.a₂ * (algebraMap K L x) ^ 2 +
        algebraMap K L W.a₄ * algebraMap K L x + algebraMap K L W.a₆) = 0 := by
    intro x y h
    have h_eq := congrArg (algebraMap K L) ((W.equation_iff x y).mp h.1)
    simp only [map_add, map_mul, map_pow] at h_eq
    linear_combination h_eq
  refine ⟨h_line_zero, ?_⟩
  intro x_P y_P h_P S
  cases S with
  | zero =>
    change FractionalIdeal.spanSingleton (nonZeroDivisors R)
        (τ 0 (algebraMap R L (WeierstrassCurve.Affine.CoordinateRing.XClass W x_P))) =
      ↑(I (WeierstrassCurve.Affine.Point.some h_P - 0) *
        I (-WeierstrassCurve.Affine.Point.some h_P - 0) *
        (I (-0))⁻¹ * (I (-0))⁻¹)
    rw [hτ_zero, AlgEquiv.coe_refl, id_eq, sub_zero, sub_zero, neg_zero, hI0, inv_one,
      mul_one, mul_one, h_vert_zero h_P]
  | some h_S =>
    rename_i x_S y_S
    have hX_S_ne : X_gen - algebraMap K L x_S ≠ 0 := by
      rw [← h_XClass x_S]
      exact (map_ne_zero_iff _ (IsFractionRing.injective R L)).mpr
        (WeierstrassCurve.Affine.CoordinateRing.XClass_ne_zero x_S)
    let m : L := (Y_gen - algebraMap K L y_S) / (X_gen - algebraMap K L x_S)
    have hm : m * (X_gen - algebraMap K L x_S) - (Y_gen - algebraMap K L y_S) = 0 := by
      rw [div_mul_cancel₀ _ hX_S_ne, sub_self]
    have hτX : τ (WeierstrassCurve.Affine.Point.some h_S)
        (algebraMap R L (WeierstrassCurve.Affine.CoordinateRing.XClass W x_P)) =
        m ^ 2 + algebraMap K L W.a₁ * m - algebraMap K L W.a₂ -
          X_gen - algebraMap K L x_S - algebraMap K L x_P := by
      rw [h_XClass x_P, map_sub, AlgEquiv.commutes, (hτ_some h_S).1]
    have hE_S := hE_pt h_S
    have hE_P := hE_pt h_P
    by_cases hx : x_P = x_S
    · subst hx
      have h_I_prod :
          I (WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S) *
            I (-WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S) =
          I (-(WeierstrassCurve.Affine.Point.some h_S + WeierstrassCurve.Affine.Point.some h_S)) := by
        by_cases hy : y_P = W.negY x_P y_S
        · have hP_eq : WeierstrassCurve.Affine.Point.some h_P =
              -WeierstrassCurve.Affine.Point.some h_S := by
            rw [WeierstrassCurve.Affine.Point.neg_some h_S]
            congr 1
          rw [hP_eq, neg_neg, sub_self, hI0, mul_one]
          congr 1
          abel
        · have hy_eq : y_P = y_S := W.Y_eq_of_Y_ne h_P.1 h_S.1 rfl hy
          subst hy_eq
          have hP_eq : WeierstrassCurve.Affine.Point.some h_P =
              WeierstrassCurve.Affine.Point.some h_S := rfl
          rw [hP_eq, sub_self, hI0, one_mul]
          congr 1
          abel
      let dx_S : K := 3 * x_P ^ 2 + 2 * W.a₂ * x_P + W.a₄ - W.a₁ * y_S
      let dy_S : K := 2 * y_S + W.a₁ * x_P + W.a₃
      have h_poly_coinc :
          (X_gen - algebraMap K L x_P) * (X_gen - algebraMap K L x_P) *
            τ (WeierstrassCurve.Affine.Point.some h_S)
              (algebraMap R L (WeierstrassCurve.Affine.CoordinateRing.XClass W x_P)) =
          algebraMap K L dx_S * (X_gen - algebraMap K L x_P) -
            algebraMap K L dy_S * (Y_gen - algebraMap K L y_S) := by
        rw [hτX]
        simp only [dx_S, dy_S, map_sub, map_add, map_mul, map_pow, map_ofNat]
        linear_combination
          (m * (X_gen - algebraMap K L x_P) + (Y_gen - algebraMap K L y_S) +
            algebraMap K L W.a₁ * (X_gen - algebraMap K L x_P)) * hm +
          hE_G - hE_S
      have h_dy_eq : dy_S = y_S - W.negY x_P y_S := by
        change 2 * y_S + W.a₁ * x_P + W.a₃ = y_S - (-y_S - W.a₁ * x_P - W.a₃)
        ring
      by_cases hy_S : y_S = W.negY x_P y_S
      · have hdy0 : dy_S = 0 := by rw [h_dy_eq, sub_eq_zero.mpr hy_S]
        have hdx_ne : dx_S ≠ 0 := by
          have h_ns := (WeierstrassCurve.Affine.nonsingular_iff' x_P y_S).mp h_S
          rcases h_ns.2 with h1 | h2
          · intro h0
            apply h1
            linear_combination -h0
          · exact absurd hdy0 h2
        have h2S_zero : WeierstrassCurve.Affine.Point.some h_S +
            WeierstrassCurve.Affine.Point.some h_S = 0 :=
          WeierstrassCurve.Affine.Point.add_of_Y_eq rfl hy_S
        have h_negS : -WeierstrassCurve.Affine.Point.some h_S =
            WeierstrassCurve.Affine.Point.some h_S := by
          rw [WeierstrassCurve.Affine.Point.neg_some h_S]
          congr 1
          exact hy_S.symm
        rw [hdy0, map_zero, zero_mul, sub_zero, ← h_XClass x_P] at h_poly_coinc
        have h_span := congrArg (FractionalIdeal.spanSingleton (nonZeroDivisors R)) h_poly_coinc
        rw [← FractionalIdeal.spanSingleton_mul_spanSingleton,
          ← FractionalIdeal.spanSingleton_mul_spanSingleton,
          h_span_const_mul hdx_ne, h_vert_zero h_S, h_negS,
          ← Units.val_mul] at h_span
        rw [h_I_prod, h2S_zero, neg_zero, hI0, h_negS]
        refine h_unit_solve _ _ _ _ h_span ?_
        calc I (WeierstrassCurve.Affine.Point.some h_S) *
              I (WeierstrassCurve.Affine.Point.some h_S)
          _ = I (WeierstrassCurve.Affine.Point.some h_S) *
              I (WeierstrassCurve.Affine.Point.some h_S) * 1 *
              (I (WeierstrassCurve.Affine.Point.some h_S) *
                (I (WeierstrassCurve.Affine.Point.some h_S))⁻¹) *
              (I (WeierstrassCurve.Affine.Point.some h_S) *
                (I (WeierstrassCurve.Affine.Point.some h_S))⁻¹) := by
            rw [mul_inv_cancel, mul_one, mul_one, mul_one]
          _ = _ := by ac_rfl
      · have hdy_ne : dy_S ≠ 0 := by rw [h_dy_eq]; exact sub_ne_zero.mpr hy_S
        have h_ndy_ne : -dy_S ≠ 0 := neg_ne_zero.mpr hdy_ne
        have hxy_S : ¬(x_P = x_P ∧ y_S = W.negY x_P y_S) := fun h => hy_S h.2
        let ℓ_SS := W.slope x_P x_P y_S y_S
        have hℓ_SS_K : ℓ_SS * dy_S = dx_S := by
          change W.slope x_P x_P y_S y_S * dy_S = dx_S
          rw [W.slope_of_Y_ne rfl hy_S, h_dy_eq, div_mul_cancel₀ _ (sub_ne_zero.mpr hy_S)]
        have hℓ_SS : algebraMap K L ℓ_SS * algebraMap K L dy_S - algebraMap K L dx_S = 0 := by
          have := congrArg (algebraMap K L) hℓ_SS_K
          simp only [map_mul] at this
          linear_combination this
        have h_rhs_eq :
            algebraMap K L dx_S * (X_gen - algebraMap K L x_P) -
              algebraMap K L dy_S * (Y_gen - algebraMap K L y_S) =
            algebraMap K L (-dy_S) *
              algebraMap R L
                (WeierstrassCurve.Affine.CoordinateRing.YClass W
                  (WeierstrassCurve.Affine.linePolynomial x_P y_S ℓ_SS)) := by
          rw [h_YClass_line, map_neg]
          linear_combination -(X_gen - algebraMap K L x_P) * hℓ_SS
        rw [h_rhs_eq, ← h_XClass x_P] at h_poly_coinc
        have h_span := congrArg (FractionalIdeal.spanSingleton (nonZeroDivisors R)) h_poly_coinc
        rw [← FractionalIdeal.spanSingleton_mul_spanSingleton,
          ← FractionalIdeal.spanSingleton_mul_spanSingleton,
          h_span_const_mul h_ndy_ne, h_vert_zero h_S, h_line_zero h_S h_S hxy_S,
          ← Units.val_mul] at h_span
        rw [h_I_prod]
        refine h_unit_solve _ _ _ _ h_span ?_
        calc I (WeierstrassCurve.Affine.Point.some h_S) *
              I (WeierstrassCurve.Affine.Point.some h_S) *
              I (-(WeierstrassCurve.Affine.Point.some h_S +
                WeierstrassCurve.Affine.Point.some h_S))
          _ = I (WeierstrassCurve.Affine.Point.some h_S) *
              I (WeierstrassCurve.Affine.Point.some h_S) *
              I (-(WeierstrassCurve.Affine.Point.some h_S +
                WeierstrassCurve.Affine.Point.some h_S)) *
              (I (-WeierstrassCurve.Affine.Point.some h_S) *
                (I (-WeierstrassCurve.Affine.Point.some h_S))⁻¹) *
              (I (-WeierstrassCurve.Affine.Point.some h_S) *
                (I (-WeierstrassCurve.Affine.Point.some h_S))⁻¹) := by
            rw [mul_inv_cancel, mul_one, mul_one]
          _ = _ := by ac_rfl
    · have hx_sub_ne : x_P - x_S ≠ 0 := sub_ne_zero.mpr hx
      have hx_sq_ne : -(x_P - x_S) ^ 2 ≠ 0 := neg_ne_zero.mpr (pow_ne_zero 2 hx_sub_ne)
      let h_nP : W.Nonsingular x_P (W.negY x_P y_P) :=
        (WeierstrassCurve.Affine.nonsingular_neg x_P y_P).mpr h_P
      have h_nP_pt : -WeierstrassCurve.Affine.Point.some h_P =
          WeierstrassCurve.Affine.Point.some h_nP :=
        WeierstrassCurve.Affine.Point.neg_some h_P
      have hxy₁ : ¬(x_P = x_S ∧ W.negY x_P y_P = W.negY x_S y_S) := fun h => hx h.1
      have hxy₂ : ¬(x_P = x_S ∧ y_P = W.negY x_S y_S) := fun h => hx h.1
      let ℓ₁ := W.slope x_P x_S (W.negY x_P y_P) y_S
      let ℓ₂ := W.slope x_P x_S y_P y_S
      have hℓ₁_K : ℓ₁ * (x_P - x_S) = W.negY x_P y_P - y_S := by
        change W.slope x_P x_S (W.negY x_P y_P) y_S * (x_P - x_S) = W.negY x_P y_P - y_S
        rw [W.slope_of_X_ne hx, div_mul_cancel₀ _ hx_sub_ne]
      have hℓ₂_K : ℓ₂ * (x_P - x_S) = y_P - y_S := by
        change W.slope x_P x_S y_P y_S * (x_P - x_S) = y_P - y_S
        rw [W.slope_of_X_ne hx, div_mul_cancel₀ _ hx_sub_ne]
      have hℓ₁ : algebraMap K L ℓ₁ * (algebraMap K L x_P - algebraMap K L x_S) -
          (algebraMap K L (W.negY x_P y_P) - algebraMap K L y_S) = 0 := by
        have := congrArg (algebraMap K L) hℓ₁_K
        simp only [map_mul, map_sub] at this
        linear_combination this
      have hℓ₂ : algebraMap K L ℓ₂ * (algebraMap K L x_P - algebraMap K L x_S) -
          (algebraMap K L y_P - algebraMap K L y_S) = 0 := by
        have := congrArg (algebraMap K L) hℓ₂_K
        simp only [map_mul, map_sub] at this
        linear_combination this
      let L_nP_S : L := algebraMap R L
        (WeierstrassCurve.Affine.CoordinateRing.YClass W
          (WeierstrassCurve.Affine.linePolynomial x_P (W.negY x_P y_P) ℓ₁))
      let L_P_S : L := algebraMap R L
        (WeierstrassCurve.Affine.CoordinateRing.YClass W
          (WeierstrassCurve.Affine.linePolynomial x_P y_P ℓ₂))
      let Ltilde₁ : L :=
        (algebraMap K L x_P - algebraMap K L x_S) * (Y_gen - algebraMap K L y_S) -
          (algebraMap K L (W.negY x_P y_P) - algebraMap K L y_S) * (X_gen - algebraMap K L x_S)
      let Ltilde₂ : L :=
        (algebraMap K L x_P - algebraMap K L x_S) * (Y_gen - algebraMap K L y_S) -
          (algebraMap K L y_P - algebraMap K L y_S) * (X_gen - algebraMap K L x_S)
      have hLtilde₁ : Ltilde₁ = (algebraMap K L x_P - algebraMap K L x_S) * L_nP_S := by
        dsimp only [Ltilde₁, L_nP_S]
        rw [h_YClass_line]
        linear_combination (X_gen - algebraMap K L x_P) * hℓ₁
      have hLtilde₂ : Ltilde₂ = (algebraMap K L x_P - algebraMap K L x_S) * L_P_S := by
        dsimp only [Ltilde₂, L_P_S]
        rw [h_YClass_line]
        linear_combination (X_gen - algebraMap K L x_P) * hℓ₂
      have h_negY_L : algebraMap K L (W.negY x_P y_P) =
          -algebraMap K L y_P - algebraMap K L W.a₁ * algebraMap K L x_P - algebraMap K L W.a₃ := by
        change algebraMap K L (-y_P - W.a₁ * x_P - W.a₃) = _
        simp only [map_sub, map_neg, map_mul]
      have h_poly_chord :
          algebraMap K L (x_P - x_S) *
            ((X_gen - algebraMap K L x_S) * (X_gen - algebraMap K L x_S) *
              (X_gen - algebraMap K L x_P) *
              τ (WeierstrassCurve.Affine.Point.some h_S)
                (algebraMap R L (WeierstrassCurve.Affine.CoordinateRing.XClass W x_P))) =
          algebraMap K L (-(x_P - x_S) ^ 2) * (L_nP_S * L_P_S) := by
        have h_main :
            (algebraMap K L x_P - algebraMap K L x_S) *
              (X_gen - algebraMap K L x_S) ^ 2 *
              (X_gen - algebraMap K L x_P) *
              τ (WeierstrassCurve.Affine.Point.some h_S)
                (algebraMap R L (WeierstrassCurve.Affine.CoordinateRing.XClass W x_P)) =
            -Ltilde₁ * Ltilde₂ := by
          rw [hτX]
          dsimp only [Ltilde₁, Ltilde₂]
          rw [h_negY_L]
          linear_combination
            (algebraMap K L x_P - algebraMap K L x_S) * (X_gen - algebraMap K L x_P) *
              (m * (X_gen - algebraMap K L x_S) + (Y_gen - algebraMap K L y_S) +
                algebraMap K L W.a₁ * (X_gen - algebraMap K L x_S)) * hm +
            (algebraMap K L x_P - algebraMap K L x_S) * (X_gen - algebraMap K L x_S) * hE_G +
            (X_gen - algebraMap K L x_S) * (X_gen - algebraMap K L x_P) * hE_S -
            (X_gen - algebraMap K L x_S) ^ 2 * hE_P
        rw [hLtilde₁, hLtilde₂] at h_main
        simp only [map_neg, map_pow, map_sub]
        linear_combination h_main
      rw [← h_XClass x_S, ← h_XClass x_P] at h_poly_chord
      have h_span := congrArg (FractionalIdeal.spanSingleton (nonZeroDivisors R)) h_poly_chord
      rw [h_span_const_mul hx_sub_ne, h_span_const_mul hx_sq_ne,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton,
        h_vert_zero h_S, h_vert_zero h_P,
        h_line_zero h_nP h_S hxy₁, h_line_zero h_P h_S hxy₂,
        ← h_nP_pt,
        show -(-WeierstrassCurve.Affine.Point.some h_P + WeierstrassCurve.Affine.Point.some h_S) =
          WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S by abel,
        show -(WeierstrassCurve.Affine.Point.some h_P + WeierstrassCurve.Affine.Point.some h_S) =
          -WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S by abel,
        ← Units.val_mul, ← Units.val_mul, ← Units.val_mul] at h_span
      refine h_unit_solve _ _ _ _ h_span ?_
      calc I (-WeierstrassCurve.Affine.Point.some h_P) *
            I (WeierstrassCurve.Affine.Point.some h_S) *
            I (WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S) *
            (I (WeierstrassCurve.Affine.Point.some h_P) *
              I (WeierstrassCurve.Affine.Point.some h_S) *
              I (-WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S))
        _ = I (-WeierstrassCurve.Affine.Point.some h_P) *
            I (WeierstrassCurve.Affine.Point.some h_S) *
            I (WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S) *
            (I (WeierstrassCurve.Affine.Point.some h_P) *
              I (WeierstrassCurve.Affine.Point.some h_S) *
              I (-WeierstrassCurve.Affine.Point.some h_P - WeierstrassCurve.Affine.Point.some h_S)) *
            (I (-WeierstrassCurve.Affine.Point.some h_S) *
              (I (-WeierstrassCurve.Affine.Point.some h_S))⁻¹) *
            (I (-WeierstrassCurve.Affine.Point.some h_S) *
              (I (-WeierstrassCurve.Affine.Point.some h_S))⁻¹) := by
          rw [mul_inv_cancel, mul_one, mul_one]
        _ = _ := by ac_rfl

theorem weierstrass_functionField_miller_step_and_galois_spec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0)
    (τ : EllipticRootNumber.Pts F E →
      (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃ₐ[AlgebraicClosure F]
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
    (σ_lift : EllipticRootNumber.AbsGal F →
      (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField ≃+*
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField))
    (I : EllipticRootNumber.Pts F E →
      (FractionalIdeal
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ)
    (hτ_zero : τ 0 = AlgEquiv.refl)
    (hσ_alg : ∀ (σ : EllipticRootNumber.AbsGal F) (c : AlgebraicClosure F),
      σ_lift σ (algebraMap (AlgebraicClosure F)
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField c) =
      algebraMap (AlgebraicClosure F)
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField (σ c))
    (hσ_XY : ∀ σ : EllipticRootNumber.AbsGal F,
      σ_lift σ (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk
          (E.baseChange (AlgebraicClosure F)).toAffine (Polynomial.C Polynomial.X))) =
      algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk
          (E.baseChange (AlgebraicClosure F)).toAffine (Polynomial.C Polynomial.X)) ∧
      σ_lift σ (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk
          (E.baseChange (AlgebraicClosure F)).toAffine Polynomial.X)) =
      algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
        ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk
          (E.baseChange (AlgebraicClosure F)).toAffine Polynomial.X))
    (hτ_some : ∀ {x_S y_S : AlgebraicClosure F}
        (h_S : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x_S y_S),
      let W := (E.baseChange (AlgebraicClosure F)).toAffine
      let X_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W (Polynomial.C Polynomial.X))
      let Y_gen := algebraMap W.CoordinateRing W.FunctionField
        (WeierstrassCurve.Affine.CoordinateRing.mk W Polynomial.X)
      let m := (Y_gen - algebraMap (AlgebraicClosure F) W.FunctionField y_S) /
        (X_gen - algebraMap (AlgebraicClosure F) W.FunctionField x_S)
      τ (WeierstrassCurve.Affine.Point.some h_S) X_gen =
        m ^ 2 + algebraMap (AlgebraicClosure F) W.FunctionField W.a₁ * m -
          algebraMap (AlgebraicClosure F) W.FunctionField W.a₂ - X_gen -
          algebraMap (AlgebraicClosure F) W.FunctionField x_S ∧
      τ (WeierstrassCurve.Affine.Point.some h_S) Y_gen =
        -m * (τ (WeierstrassCurve.Affine.Point.some h_S) X_gen - X_gen) - Y_gen -
          algebraMap (AlgebraicClosure F) W.FunctionField W.a₁ *
            τ (WeierstrassCurve.Affine.Point.some h_S) X_gen -
          algebraMap (AlgebraicClosure F) W.FunctionField W.a₃)
    (hI0 : I 0 = 1)
    (hI_some : ∀ {x y : AlgebraicClosure F}
        (h : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x y),
      I (WeierstrassCurve.Affine.Point.some h) =
        WeierstrassCurve.Affine.CoordinateRing.XYIdeal' h)
    (h_line_zero : ∀ {x₁ y₁ x₂ y₂ : AlgebraicClosure F}
        (h₁ : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x₁ y₁)
        (h₂ : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x₂ y₂),
      ¬(x₁ = x₂ ∧ y₁ = ((E.baseChange (AlgebraicClosure F)).toAffine).negY x₂ y₂) →
      FractionalIdeal.spanSingleton
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
        (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.YClass
            (E.baseChange (AlgebraicClosure F)).toAffine
            (WeierstrassCurve.Affine.linePolynomial x₁ y₁
              (((E.baseChange (AlgebraicClosure F)).toAffine).slope x₁ x₂ y₁ y₂)))) =
        ↑(I (WeierstrassCurve.Affine.Point.some h₁) *
          I (WeierstrassCurve.Affine.Point.some h₂) *
          I (-(WeierstrassCurve.Affine.Point.some h₁ +
            WeierstrassCurve.Affine.Point.some h₂))))
    (h_vert_τ : ∀ {x_P y_P : AlgebraicClosure F}
        (h_P : ((E.baseChange (AlgebraicClosure F)).toAffine).Nonsingular x_P y_P)
        (S : EllipticRootNumber.Pts F E),
      FractionalIdeal.spanSingleton
        (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
        (τ S (algebraMap ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing
          ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField
          (WeierstrassCurve.Affine.CoordinateRing.XClass
            (E.baseChange (AlgebraicClosure F)).toAffine x_P))) =
        ↑(I (WeierstrassCurve.Affine.Point.some h_P - S) *
          I (-WeierstrassCurve.Affine.Point.some h_P - S) *
          (I (-S))⁻¹ * (I (-S))⁻¹)) :
    ∃ ℓ_step : EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E →
        (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ,
      (∀ (σ : EllipticRootNumber.AbsGal F) (A B : EllipticRootNumber.Pts F E),
        σ_lift σ (ℓ_step A B : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField) =
          (ℓ_step (EllipticRootNumber.galHom F E σ A)
            (EllipticRootNumber.galHom F E σ B) :
            ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)) ∧
      (∀ A B S : EllipticRootNumber.Pts F E,
        FractionalIdeal.spanSingleton
          (nonZeroDivisors ((E.baseChange (AlgebraicClosure F)).toAffine).CoordinateRing)
          (τ S (ℓ_step A B : ((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)) =
          ↑(I (A - S) * I (B - S) * (I (A + B - S))⁻¹ * (I (-S))⁻¹)) :=
by
  clear hΔ hI_some
  have h_mk_line : ∀ {K₀ P₀ Q₀ R₀ L₀ : Type u}
      [CommRing K₀] [CommRing P₀] [CommRing Q₀] [CommRing R₀] [CommRing L₀]
      (C_K : K₀ →+* P₀) (C_P : P₀ →+* Q₀) (mk : Q₀ →+* R₀) (ι : R₀ →+* L₀) (ι_K : K₀ →+* L₀)
      (X_P : P₀) (Y_Q : Q₀) (X_gen Y_gen : L₀),
      X_gen = ι (mk (C_P X_P)) →
      Y_gen = ι (mk Y_Q) →
      (∀ c : K₀, ι (mk (C_P (C_K c))) = ι_K c) →
      (∀ x : K₀, ι (mk (C_P (X_P - C_K x))) = X_gen - ι_K x) ∧
      (∀ x y ℓ : K₀,
        ι (mk (Y_Q - C_P (C_K ℓ * (X_P - C_K x) + C_K y))) =
          Y_gen - (ι_K ℓ * (X_gen - ι_K x) + ι_K y)) := by
    clear! F
    intro K₀ P₀ Q₀ R₀ L₀ _ _ _ _ _ C_K C_P mk ι ι_K X_P Y_Q X_gen Y_gen hX hY h_alg
    refine ⟨fun x => ?_, fun x y ℓ => ?_⟩
    · simp only [map_sub, hX, h_alg]
    · simp only [map_sub, map_add, map_mul, hX, hY, h_alg]
  have h_equiv_line : ∀ {L₀ : Type u} [Field L₀] (e : L₀ ≃+* L₀)
      (X Y x x' y y' ℓ ℓ' u u' v v' : L₀),
      e X = X → e Y = Y →
      e x = x' → e y = y' → e ℓ = ℓ' →
      u = X - x → u' = X - x' →
      v = Y - (ℓ * (X - x) + y) → v' = Y - (ℓ' * (X - x') + y') →
      e u = u' ∧ e v = v' ∧ (∀ a b : L₀, e (a / b) = e a / e b) ∧ e 1 = 1 := by
    clear! F
    intro L₀ _ e X Y x x' y y' ℓ ℓ' u u' v v' hX hY hx hy hℓ hu hu' hv hv'
    refine ⟨?_, ?_, fun a b => map_div₀ e a b, map_one e⟩
    · rw [hu, hu', map_sub, hX, hx]
    · rw [hv, hv', map_sub, map_add, map_mul, map_sub, hX, hY, hx, hy, hℓ]
  have h_algEquiv_div : ∀ {K₀ L₀ : Type u} [CommRing K₀] [Field L₀] [Algebra K₀ L₀]
      (e : L₀ ≃ₐ[K₀] L₀),
      e 1 = 1 ∧ (∀ num den : L₀, den ≠ 0 → e den * e (num / den) = e num) := by
    clear! F
    intro K₀ L₀ _ _ _ e
    refine ⟨map_one e, fun num den hden => ?_⟩
    rw [← map_mul, mul_div_cancel₀ _ hden]
  have h_unit_solve : ∀ {M₀ : Type u} [CommSemiring M₀]
      (u v w : M₀ˣ) (J : M₀), ↑u * J = ↑v → v = u * w → J = ↑w := by
    clear! F
    intro M₀ _ u v w J hJ hvw
    have h1 := congrArg (((u⁻¹ : M₀ˣ) : M₀) * ·) hJ
    dsimp only at h1
    rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul,
      hvw, Units.val_mul, ← mul_assoc, ← Units.val_mul, inv_mul_cancel,
      Units.val_one, one_mul] at h1
    exact h1
  have h_group_div : ∀ {L₀ M₀ : Type u} [CommRing L₀] [CommSemiring M₀]
      (span : L₀ → M₀),
      (∀ x y : L₀, span (x * y) = span x * span y) →
      ∀ (den q num : L₀) (IABS ICS InS IAS IBS : M₀ˣ),
        den * q = num →
        span den = ↑(IABS * ICS * InS⁻¹ * InS⁻¹) →
        span num = ↑(IAS * IBS * ICS * InS⁻¹ * InS⁻¹ * InS⁻¹) →
        span q = ↑(IAS * IBS * IABS⁻¹ * InS⁻¹) := by
    clear! F
    intro L₀ M₀ _ _ span h_smul den q num IABS ICS InS IAS IBS h_eq hden hnum
    have h_sp := congrArg span h_eq
    rw [h_smul, hden, hnum] at h_sp
    refine h_unit_solve _ _ _ _ h_sp ?_
    calc IAS * IBS * ICS * InS⁻¹ * InS⁻¹ * InS⁻¹
      _ = IAS * IBS * ICS * InS⁻¹ * InS⁻¹ * InS⁻¹ * (IABS * IABS⁻¹) := by
        rw [mul_inv_cancel, mul_one]
      _ = (IABS * ICS * InS⁻¹ * InS⁻¹) * (IAS * IBS * IABS⁻¹ * InS⁻¹) := by
        ac_rfl
  have h_group_one : ∀ {G₀ : Type u} [CommGroup G₀] (a b : G₀),
      a * b * b⁻¹ * a⁻¹ = 1 := by
    clear! F
    intro G₀ _ a b
    calc a * b * b⁻¹ * a⁻¹
      _ = (a * a⁻¹) * (b * b⁻¹) := by ac_rfl
      _ = 1 := by rw [mul_inv_cancel, mul_inv_cancel, mul_one]
  have h_tilde_coinc : ∀ {K₀ L₀ M₀ : Type u} [CommRing K₀] [CommRing L₀] [CommSemiring M₀]
      (ι_K : K₀ →+* L₀) (span : L₀ → M₀) (X Y u_P : L₀) (x_P y_P y_nP : K₀) (IP InP I0 : M₀ˣ),
      (∀ z : L₀, span (ι_K (-(y_nP - y_P)) * z) = span z) →
      u_P = X - ι_K x_P →
      span u_P = ↑(IP * InP) →
      I0 = 1 →
      span (ι_K (x_P - x_P) * (Y - ι_K y_P) - ι_K (y_nP - y_P) * (X - ι_K x_P)) =
        ↑(InP * IP * I0) := by
    clear! F
    intro K₀ L₀ M₀ _ _ _ ι_K span X Y u_P x_P y_P y_nP IP InP I0 h_c hu h_sp hI0
    have h_eq :
        ι_K (x_P - x_P) * (Y - ι_K y_P) - ι_K (y_nP - y_P) * (X - ι_K x_P) =
          ι_K (-(y_nP - y_P)) * u_P := by
      rw [sub_self, map_zero, map_neg, hu]
      ring
    rw [h_eq, h_c, h_sp, hI0, mul_one]
    exact congrArg Units.val (mul_comm _ _)
  have h_tilde_chord : ∀ {K₀ L₀ M₀ : Type u} [CommRing K₀] [CommRing L₀] [CommSemiring M₀]
      (ι_K : K₀ →+* L₀) (span : L₀ → M₀) (X Y v : L₀) (x_P x_S y_nP y_S ℓ : K₀)
      (InP IS IPS : M₀ˣ),
      (∀ z : L₀, span (ι_K (x_P - x_S) * z) = span z) →
      ℓ * (x_P - x_S) = y_nP - y_S →
      v = Y - (ι_K ℓ * (X - ι_K x_P) + ι_K y_nP) →
      span v = ↑(InP * IS * IPS) →
      span (ι_K (x_P - x_S) * (Y - ι_K y_S) - ι_K (y_nP - y_S) * (X - ι_K x_S)) =
        ↑(InP * IS * IPS) := by
    clear! F
    intro K₀ L₀ M₀ _ _ _ ι_K span X Y v x_P x_S y_nP y_S ℓ InP IS IPS h_c hℓ_K hv h_sp
    have hℓ : ι_K ℓ * (ι_K x_P - ι_K x_S) = ι_K y_nP - ι_K y_S := by
      have := congrArg ι_K hℓ_K
      simpa only [map_mul, map_sub] using this
    have h_eq :
        ι_K (x_P - x_S) * (Y - ι_K y_S) - ι_K (y_nP - y_S) * (X - ι_K x_S) =
          ι_K (x_P - x_S) * v := by
      rw [map_sub, map_sub, hv]
      linear_combination (X - ι_K x_P) * hℓ
    rw [h_eq, h_c, h_sp]
  have h_poly_K : ∀ {K₀ : Type u} [Field K₀] [DecidableEq K₀] (W₀ : WeierstrassCurve.Affine K₀)
      {x_A y_A x_B y_B x_S y_S : K₀}
      (h_A : W₀.Nonsingular x_A y_A) (h_B : W₀.Nonsingular x_B y_B)
      (h_S : W₀.Nonsingular x_S y_S) (hxy : ¬(x_A = x_B ∧ y_A = W₀.negY x_B y_B))
      (ℓ x_C Lbar_S : K₀),
      ℓ = W₀.slope x_A x_B y_A y_B →
      x_C = W₀.addX x_A x_B ℓ →
      Lbar_S = W₀.negY x_S y_S - (ℓ * (x_S - x_A) + y_A) →
      y_B = ℓ * (x_B - x_A) + y_A ∧
      (x_A * x_B + x_A * x_C + x_B * x_C) +
        (2 * ℓ * (y_A - ℓ * x_A) + W₀.a₁ * (y_A - ℓ * x_A) + W₀.a₃ * ℓ - W₀.a₄) = 0 ∧
      x_A * x_B * x_C - ((y_A - ℓ * x_A) ^ 2 + W₀.a₃ * (y_A - ℓ * x_A) - W₀.a₆) = 0 ∧
      (x_S - x_A) * (x_S - x_B) * (x_S - x_C) +
        (y_S - (ℓ * (x_S - x_A) + y_A)) * Lbar_S = 0 := by
    clear! F
    intro K₀ _ _ W₀ x_A y_A x_B y_B x_S y_S h_A h_B h_S hxy ℓ x_C Lbar_S hℓ hx_C hLbar_S
    have hEA : y_A ^ 2 + W₀.a₁ * x_A * y_A + W₀.a₃ * y_A -
        (x_A ^ 3 + W₀.a₂ * x_A ^ 2 + W₀.a₄ * x_A + W₀.a₆) = 0 := by
      linear_combination (W₀.equation_iff x_A y_A).mp h_A.1
    have hEB : y_B ^ 2 + W₀.a₁ * x_B * y_B + W₀.a₃ * y_B -
        (x_B ^ 3 + W₀.a₂ * x_B ^ 2 + W₀.a₄ * x_B + W₀.a₆) = 0 := by
      linear_combination (W₀.equation_iff x_B y_B).mp h_B.1
    have hES : y_S ^ 2 + W₀.a₁ * x_S * y_S + W₀.a₃ * y_S -
        (x_S ^ 3 + W₀.a₂ * x_S ^ 2 + W₀.a₄ * x_S + W₀.a₆) = 0 := by
      linear_combination (W₀.equation_iff x_S y_S).mp h_S.1
    have hx_C' : x_C = ℓ ^ 2 + W₀.a₁ * ℓ - W₀.a₂ - x_A - x_B := hx_C
    have hLbar_S' : Lbar_S = (-y_S - W₀.a₁ * x_S - W₀.a₃) - (ℓ * (x_S - x_A) + y_A) := hLbar_S
    have h_line_e₂ :
        y_B = ℓ * (x_B - x_A) + y_A ∧
        (x_A * x_B + x_A * x_C + x_B * x_C) +
          (2 * ℓ * (y_A - ℓ * x_A) + W₀.a₁ * (y_A - ℓ * x_A) + W₀.a₃ * ℓ - W₀.a₄) = 0 := by
      by_cases hx : x_A = x_B
      · have hy : y_A ≠ W₀.negY x_B y_B := fun h => hxy ⟨hx, h⟩
        have hy_eq : y_A = y_B := W₀.Y_eq_of_Y_ne h_A.1 h_B.1 hx hy
        have hy_A : y_A ≠ W₀.negY x_A y_A := by
          rwa [← hx, ← hy_eq] at hy
        have h_tan : ℓ * (y_A - (-y_A - W₀.a₁ * x_A - W₀.a₃)) =
            3 * x_A ^ 2 + 2 * W₀.a₂ * x_A + W₀.a₄ - W₀.a₁ * y_A := by
          change ℓ * (y_A - W₀.negY x_A y_A) = _
          rw [hℓ, W₀.slope_of_Y_ne hx hy, div_mul_cancel₀ _ (sub_ne_zero.mpr hy_A)]
        refine ⟨by rw [← hx, ← hy_eq]; ring, ?_⟩
        rw [← hx] at hx_C' ⊢
        linear_combination h_tan + 2 * x_A * hx_C'
      · have h_chord : ℓ * (x_A - x_B) = y_A - y_B := by
          rw [hℓ, W₀.slope_of_X_ne hx, div_mul_cancel₀ _ (sub_ne_zero.mpr hx)]
        refine ⟨by linear_combination h_chord, ?_⟩
        apply mul_left_cancel₀ (sub_ne_zero.mpr hx)
        rw [mul_zero]
        linear_combination
          hEA - hEB + (x_A - x_B) * (x_A + x_B) * hx_C' +
            (ℓ * (-x_A + x_B) + W₀.a₁ * x_B + W₀.a₃ + y_A + y_B) * h_chord
    have he₂ := h_line_e₂.2
    have he₃ : x_A * x_B * x_C - ((y_A - ℓ * x_A) ^ 2 + W₀.a₃ * (y_A - ℓ * x_A) - W₀.a₆) = 0 := by
      linear_combination x_A * he₂ - hEA - x_A ^ 2 * hx_C'
    have h_cubic_S :
        (x_S - x_A) * (x_S - x_B) * (x_S - x_C) +
          (y_S - (ℓ * (x_S - x_A) + y_A)) * Lbar_S = 0 := by
      rw [hLbar_S']
      linear_combination -hES + x_S * he₂ - he₃ - x_S ^ 2 * hx_C'
    exact ⟨h_line_e₂.1, he₂, he₃, h_cubic_S⟩
  have h_poly_L_raw : ∀ {L₀ : Type u} [CommRing L₀]
      (a₁ a₂ a₃ a₄ a₆ x_A y_A x_B y_B x_C y_C x_S y_S ℓ X_gen Y_gen m τX τY : L₀)
      (hx_C : x_C = ℓ ^ 2 + a₁ * ℓ - a₂ - x_A - x_B)
      (hy_C : y_C = ℓ * (x_C - x_A) + y_A)
      (hy_B : y_B = ℓ * (x_B - x_A) + y_A)
      (he₂ : (x_A * x_B + x_A * x_C + x_B * x_C) +
        (2 * ℓ * (y_A - ℓ * x_A) + a₁ * (y_A - ℓ * x_A) + a₃ * ℓ - a₄) = 0)
      (he₃ : x_A * x_B * x_C - ((y_A - ℓ * x_A) ^ 2 + a₃ * (y_A - ℓ * x_A) - a₆) = 0)
      (hEG : Y_gen ^ 2 + a₁ * X_gen * Y_gen + a₃ * Y_gen -
        (X_gen ^ 3 + a₂ * X_gen ^ 2 + a₄ * X_gen + a₆) = 0)
      (hES : y_S ^ 2 + a₁ * x_S * y_S + a₃ * y_S -
        (x_S ^ 3 + a₂ * x_S ^ 2 + a₄ * x_S + a₆) = 0)
      (hm : m * (X_gen - x_S) - (Y_gen - y_S) = 0)
      (hτX : τX = m ^ 2 + a₁ * m - a₂ - X_gen - x_S)
      (hτY : τY = -m * (τX - X_gen) - Y_gen - a₁ * τX - a₃)
      (Lbar_S u_S u_A u_B u_C L_AB τu_S τL_AB tilde_L_A tilde_L_B tilde_L_C : L₀),
      Lbar_S = (-y_S - a₁ * x_S - a₃) - (ℓ * (x_S - x_A) + y_A) →
      u_S = X_gen - x_S →
      u_A = X_gen - x_A →
      u_B = X_gen - x_B →
      u_C = X_gen - x_C →
      L_AB = Y_gen - (ℓ * (X_gen - x_A) + y_A) →
      τu_S = τX - x_S →
      τL_AB = τY - (ℓ * (τX - x_A) + y_A) →
      tilde_L_A = (x_A - x_S) * (Y_gen - y_S) - ((-y_A - a₁ * x_A - a₃) - y_S) * (X_gen - x_S) →
      tilde_L_B = (x_B - x_S) * (Y_gen - y_S) - ((-y_B - a₁ * x_B - a₃) - y_S) * (X_gen - x_S) →
      tilde_L_C = (x_C - x_S) * (Y_gen - y_S) - ((-y_C - a₁ * x_C - a₃) - y_S) * (X_gen - x_S) →
      (u_S * L_AB * τL_AB = (-1 : L₀) * (u_A * (u_B * (u_C * τu_S))) + L_AB * (X_gen - τX) * Lbar_S) ∧
      (Lbar_S * (u_S * u_S * u_S * u_A * u_B * u_C * τL_AB) = L_AB * tilde_L_A * tilde_L_B * tilde_L_C) := by
    clear! F
    intro L₀ _ a₁ a₂ a₃ a₄ a₆ x_A y_A x_B y_B x_C y_C x_S y_S ℓ X_gen Y_gen m τX τY
      hx_C hy_C hy_B he₂ he₃ hEG hES hm hτX hτY
      Lbar_S u_S u_A u_B u_C L_AB τu_S τL_AB tilde_L_A tilde_L_B tilde_L_C
      hLbar_S hu_S hu_A hu_B hu_C hL_AB hτu_S hτL_AB htilde_A htilde_B htilde_C
    have h_homog_vieta : ∀ (X₁ U₀ : L₀),
        (X₁ - x_A * U₀) * (X₁ - x_B * U₀) * (X₁ - x_C * U₀) =
          (X₁ ^ 3 + a₂ * X₁ ^ 2 * U₀ + a₄ * X₁ * U₀ ^ 2 + a₆ * U₀ ^ 3) -
            ((ℓ * X₁ + (y_A - ℓ * x_A) * U₀) ^ 2 * U₀ +
              a₁ * X₁ * (ℓ * X₁ + (y_A - ℓ * x_A) * U₀) * U₀ +
              a₃ * (ℓ * X₁ + (y_A - ℓ * x_A) * U₀) * U₀ ^ 2) := by
      intro X₁ U₀
      linear_combination -X₁ ^ 2 * U₀ * hx_C + X₁ * U₀ ^ 2 * he₂ - U₀ ^ 3 * he₃
    have h_master_core : ∀ (v_S U : L₀),
        Lbar_S * (U - Lbar_S) *
          (-U * ((3 * x_S ^ 2 + 2 * a₂ * x_S + a₄ - a₁ * y_S) * u_S -
            (2 * y_S + a₁ * x_S + a₃) * v_S) + Lbar_S * u_S ^ 3) +
        (((x_S * U + Lbar_S * u_S) ^ 3 + a₂ * (x_S * U + Lbar_S * u_S) ^ 2 * U +
            a₄ * (x_S * U + Lbar_S * u_S) * U ^ 2 + a₆ * U ^ 3) -
          (((-y_S - a₁ * x_S - a₃) * U - Lbar_S * (v_S + a₁ * u_S)) ^ 2 * U +
            a₁ * (x_S * U + Lbar_S * u_S) *
              ((-y_S - a₁ * x_S - a₃) * U - Lbar_S * (v_S + a₁ * u_S)) * U +
            a₃ * ((-y_S - a₁ * x_S - a₃) * U - Lbar_S * (v_S + a₁ * u_S)) * U ^ 2)) =
        -Lbar_S ^ 2 * U *
          ((y_S + v_S) ^ 2 + a₁ * (x_S + u_S) * (y_S + v_S) + a₃ * (y_S + v_S) -
            ((x_S + u_S) ^ 3 + a₂ * (x_S + u_S) ^ 2 + a₄ * (x_S + u_S) + a₆)) +
        (Lbar_S ^ 2 * U - U ^ 3) *
          (y_S ^ 2 + a₁ * x_S * y_S + a₃ * y_S -
            (x_S ^ 3 + a₂ * x_S ^ 2 + a₄ * x_S + a₆)) := by
      intro v_S U
      ring
    have h_step : ∀ (v_S U L_neg VS X₁ Y_H : L₀),
        v_S = Y_gen - y_S →
        U = v_S + (a₁ + ℓ) * u_S →
        L_neg = U - Lbar_S →
        VS = (3 * x_S ^ 2 + 2 * a₂ * x_S + a₄ - a₁ * y_S) * u_S -
          (2 * y_S + a₁ * x_S + a₃) * v_S →
        X₁ = x_S * U + Lbar_S * u_S →
        Y_H = (-y_S - a₁ * x_S - a₃) * U - Lbar_S * (v_S + a₁ * u_S) →
        (u_S * L_AB * τL_AB = (-1 : L₀) * (u_A * (u_B * (u_C * τu_S))) + L_AB * (X_gen - τX) * Lbar_S) ∧
        (Lbar_S * (u_S * u_S * u_S * u_A * u_B * u_C * τL_AB) = L_AB * tilde_L_A * tilde_L_B * tilde_L_C) := by
      intro v_S U L_neg VS X₁ Y_H hv_S hU hL_neg hVS hX₁ hY_H
      have h_prod_X : u_A * u_B * u_C - L_AB * L_neg = 0 := by
        rw [hu_A, hu_B, hu_C, hL_AB, hL_neg, hU, hv_S, hu_S, hLbar_S]
        linear_combination -hEG + X_gen * he₂ - he₃ - X_gen ^ 2 * hx_C
      have h_caseB_lin : u_S * τL_AB + L_neg * τu_S - (X_gen - τX) * Lbar_S = 0 := by
        rw [hu_S, hτL_AB, hL_neg, hU, hv_S, hLbar_S, hτu_S, hτY, hu_S]
        linear_combination (X_gen - τX) * hm
      have h_tauX : u_S ^ 2 * τu_S - VS = 0 := by
        rw [hu_S, hτu_S, hVS, hv_S, hu_S, hτX]
        linear_combination hEG - hES + (m * (X_gen - x_S) + (Y_gen - y_S) + a₁ * (X_gen - x_S)) * hm
      have h_tauL : u_S ^ 3 * τL_AB - (-U * VS + Lbar_S * u_S ^ 3) = 0 := by
        linear_combination
          -U * h_tauX + u_S ^ 2 * h_caseB_lin - u_S ^ 2 * τu_S * hL_neg -
            u_S ^ 2 * Lbar_S * hu_S + u_S ^ 2 * Lbar_S * hτu_S
      have h_YH_eq : ℓ * X₁ + (y_A - ℓ * x_A) * U = Y_H := by
        rw [hX₁, hY_H, hU, hLbar_S]
        ring
      have h_tilde_A' : tilde_L_A = -(X₁ - x_A * U) := by
        rw [htilde_A, hX₁, hU, hv_S, hLbar_S, hu_S]
        ring
      have h_tilde_B' : tilde_L_B = -(X₁ - x_B * U) := by
        rw [htilde_B, hX₁, hU, hv_S, hLbar_S, hu_S]
        linear_combination (X_gen - x_S) * hy_B
      have h_tilde_C' : tilde_L_C = -(X₁ - x_C * U) := by
        rw [htilde_C, hX₁, hU, hv_S, hLbar_S, hu_S]
        linear_combination (X_gen - x_S) * hy_C
      have h_tilde_prod : tilde_L_A * tilde_L_B * tilde_L_C =
          -((X₁ ^ 3 + a₂ * X₁ ^ 2 * U + a₄ * X₁ * U ^ 2 + a₆ * U ^ 3) -
            (Y_H ^ 2 * U + a₁ * X₁ * Y_H * U + a₃ * Y_H * U ^ 2)) := by
        rw [h_tilde_A', h_tilde_B', h_tilde_C',
          show -(X₁ - x_A * U) * -(X₁ - x_B * U) * -(X₁ - x_C * U) =
            -((X₁ - x_A * U) * (X₁ - x_B * U) * (X₁ - x_C * U)) by ring,
          h_homog_vieta X₁ U, h_YH_eq]
      have h_EG_shift : (y_S + v_S) ^ 2 + a₁ * (x_S + u_S) * (y_S + v_S) + a₃ * (y_S + v_S) -
          ((x_S + u_S) ^ 3 + a₂ * (x_S + u_S) ^ 2 + a₄ * (x_S + u_S) + a₆) = 0 := by
        rw [hv_S, hu_S, add_sub_cancel, add_sub_cancel]
        exact hEG
      have h_master : Lbar_S * L_neg * (-U * VS + Lbar_S * u_S ^ 3) -
          tilde_L_A * tilde_L_B * tilde_L_C = 0 := by
        rw [h_tilde_prod, sub_neg_eq_add, hL_neg, hVS, hX₁, hY_H, h_master_core v_S U,
          h_EG_shift, hES, mul_zero, mul_zero, add_zero]
      refine ⟨?_, ?_⟩
      · linear_combination L_AB * h_caseB_lin + τu_S * h_prod_X
      · linear_combination
          L_AB * h_master + Lbar_S * L_AB * L_neg * h_tauL + Lbar_S * u_S ^ 3 * τL_AB * h_prod_X
    exact h_step _ _ _ _ _ _ rfl rfl rfl rfl rfl rfl
  have h_poly_L_map : ∀ {K₀ L₀ : Type u} [CommRing K₀] [Field L₀] [Algebra K₀ L₀]
      (e : L₀ ≃ₐ[K₀] L₀)
      (a₁ a₂ a₃ a₄ a₆ x_A y_A x_B y_B x_C y_C x_S y_S ℓ Lbar_S : K₀)
