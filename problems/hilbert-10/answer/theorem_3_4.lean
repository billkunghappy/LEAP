      · exact hy_g
    obtain ⟨w_g, hw_g⟩ := h_mk_unit z_g (by rw [hz_g_red]; exact Units.ne_zero g)
    have hw_g_red : red_u w_g = g := by
      apply Units.ext
      change red (w_g : R_A) = (g : E₂)
      rw [hw_g, hz_g_red]
    let v_g : Hˣ := Ψ_u w_g
    have hv_g₀ : v_g ∈ EllipticRootNumber.unitGroup F H 0 := by
      unfold EllipticRootNumber.unitGroup
      apply Subgroup.subset_closure
      rw [Set.mem_setOf_eq, if_pos rfl]
      have hv_g_eq : (v_g : H) =
          IntermediateField.inclusion h (e_bot.symm (x_g : F)) +
            IntermediateField.inclusion h (e_bot.symm (y_g : F)) * (u : H) := by
        change Ψ (w_g : R_A) = _
        rw [hw_g]
        rfl
      have h_not_both_lt : ¬ (ValuativeRel.valuation F (x_g : F) < 1 ∧
