  obtain ⟨f_miller, hf_miller_def⟩ : ∃ f_miller : ℕ → EllipticRootNumber.Pts F E →
      (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ,
      ∀ r A, f_miller r A = ∏ j ∈ Finset.range r, ℓ_step (j • A) A :=
    ⟨fun r A => ∏ j ∈ Finset.range r, ℓ_step (j • A) A, fun _ _ => rfl⟩
  have hD_f_miller : ∀ (r : ℕ) (A S : EllipticRootNumber.Pts F E),
      D (τ_u S (f_miller r A)) =
        (I (A - S) * (I (-S))⁻¹) ^ r * I (-S) * (I (r • A - S))⁻¹ := by
    intro r A S
    induction r with
    | zero =>
      rw [hf_miller_def, Finset.prod_range_zero, map_one, map_one, pow_zero, one_mul,
        zero_nsmul, zero_sub, mul_inv_cancel]
    | succ r ih =>
      have h_prod : f_miller (r + 1) A = f_miller r A * ℓ_step (r • A) A := by
        rw [hf_miller_def, hf_miller_def]
        exact Finset.prod_range_succ (fun j => ℓ_step (j • A) A) r
      rw [h_prod, map_mul, map_mul, ih, hD_ℓ (r • A) A S, pow_succ, succ_nsmul]
