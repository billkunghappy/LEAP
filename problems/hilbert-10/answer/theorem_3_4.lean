        have hy_res : IsLocalRing.residue ↥A y_g = 0 := by
          rw [IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff]
          exact hy_lt
        apply Units.ne_zero g
        rw [← hz_g_red]
        refine QuadraticAlgebra.ext ?_ ?_
        · exact hx_res
        · exact hy_res
      have h_val0 := (h_coord₀ (e_bot.symm (x_g : F)) (e_bot.symm (y_g : F))).mpr
