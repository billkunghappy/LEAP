            rw [zero_mul, add_zero, div_pow, h0]
            exact mul_div_cancel_right₀ d_bar (pow_ne_zero 2 him)
          exact h_nonsq_bar _ h_sq
      obtain ⟨u_N, hu_N⟩ := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp h_norm_res
      let inv_N : ↥A := ↑(u_N⁻¹)
      have h_inv_N : inv_N * (z.re ^ 2 - d_A * z.im ^ 2) = 1 := by
        rw [← hu_N]
        change ↑(u_N⁻¹) * (u_N : ↥A) = 1
        rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
      let z' : R_A := ⟨inv_N * z.re, -(inv_N * z.im)⟩
      refine ⟨⟨z, z', ?_, ?_⟩, rfl⟩
      · refine QuadraticAlgebra.ext ?_ ?_
        · change z.re * (inv_N * z.re) + d_A * z.im * -(inv_N * z.im) = 1
          calc z.re * (inv_N * z.re) + d_A * z.im * -(inv_N * z.im)
