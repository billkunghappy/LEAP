    exact h_comm6 _ _
  have hD_g0 : ∀ T' : EllipticRootNumber.Pts F E,
      ((EllipticRootNumber.ell F ^ (k + 1)) ^ 2) • T' = 0 →
      D (g T') =
        ∏ R : EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)),
          (I (T' + R.1) * (I R.1)⁻¹) := by
    intro T' hT'
