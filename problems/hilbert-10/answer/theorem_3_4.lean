      D (τ_u S (f_miller r A)) = (I (A - S) * (I (-S))⁻¹) ^ r := by
    intro r A S hr
    rw [hD_f_miller r A S, hr, zero_sub, mul_assoc, mul_inv_cancel, mul_one]
  obtain ⟨g, hg_def⟩ : ∃ g : EllipticRootNumber.Pts F E →
      (((E.baseChange (AlgebraicClosure F)).toAffine).FunctionField)ˣ,
      ∀ T', g T' = f_miller ((EllipticRootNumber.ell F ^ (k + 1)) ^ 2) T' *
        (∏ R : EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)),
          ℓ_step T' R.1)⁻¹ :=
    ⟨fun T' => f_miller ((EllipticRootNumber.ell F ^ (k + 1)) ^ 2) T' *
      (∏ R : EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)),
        ℓ_step T' R.1)⁻¹, fun _ => rfl⟩
