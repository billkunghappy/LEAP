          _ = ζ ^ (k * m + (e * (8 / e)) * k * m) := by
              rw [← pow_mul, ← pow_add]; congr 1; ring
          _ = ζ ^ (k * m + 8 * k * m) := by rw [← he_dvd8]
          _ = (ζ ^ (3 * k * m)) ^ 3 := by rw [← pow_mul]; congr 1; ring
          _ = 1 := by rw [hζ3, one_pow]
    have h_iter : ∀ j : ℕ, ((τ₀ : EllipticRootNumber.AbsGal F) ^ j) ϖ = ζ ^ j * ϖ := by
      intro j
      induction j with
      | zero => simp
      | succ j ih =>
        rw [pow_succ', AlgEquiv.mul_apply, ih, map_mul, map_pow, hτ₀_ζ, hτ₀_ϖ,
          ← mul_assoc, ← pow_succ]
    have hσ_ϖ : σ ϖ = ζ ^ k * ϖ := h_iter k
    have hσ_u : σ (C.u : K) = ζ ^ (k * m) * (C.u : K) := by
      change σ (ϖ ^ m) = ζ ^ (k * m) * ϖ ^ m
      rw [map_pow, hσ_ϖ, mul_pow, ← pow_mul]
    have hu_inv_rel : ζ ^ (k * m) * σ (C.u⁻¹ : Kˣ) = (C.u⁻¹ : Kˣ) := by
      have h_mul1 : (C.u : K) * (C.u⁻¹ : Kˣ) = 1 := Units.mul_inv C.u
      have h_σ1 : ζ ^ (k * m) * (C.u : K) * σ (C.u⁻¹ : Kˣ) = 1 := by
        calc ζ ^ (k * m) * (C.u : K) * σ (C.u⁻¹ : Kˣ)
          _ = σ (C.u : K) * σ (C.u⁻¹ : Kˣ) := by rw [hσ_u]
          _ = σ ((C.u : K) * (C.u⁻¹ : Kˣ)) := (map_mul σ _ _).symm
          _ = 1 := by rw [h_mul1, map_one]
      calc ζ ^ (k * m) * σ (C.u⁻¹ : Kˣ)
        _ = ζ ^ (k * m) * σ (C.u⁻¹ : Kˣ) * ((C.u : K) * (C.u⁻¹ : Kˣ)) := by
            rw [h_mul1, mul_one]
        _ = (ζ ^ (k * m) * (C.u : K) * σ (C.u⁻¹ : Kˣ)) * (C.u⁻¹ : Kˣ) := by ring
        _ = (C.u⁻¹ : Kˣ) := by rw [h_σ1, one_mul]
    have hu_inv2 : α * (σ (C.u⁻¹ : Kˣ)) ^ 2 = ((C.u⁻¹ : Kˣ) : K) ^ 2 := by
      have hα_eq : α = (ζ ^ (k * m)) ^ 2 := by
        dsimp [α]; rw [← pow_mul]; congr 1; ring
      calc α * (σ (C.u⁻¹ : Kˣ)) ^ 2
        _ = (ζ ^ (k * m) * σ (C.u⁻¹ : Kˣ)) ^ 2 := by rw [hα_eq, ← mul_pow]
        _ = ((C.u⁻¹ : Kˣ) : K) ^ 2 := by rw [hu_inv_rel]
    have hu_inv3 : β * (σ (C.u⁻¹ : Kˣ)) ^ 3 = ((C.u⁻¹ : Kˣ) : K) ^ 3 := by
      have hβ_eq : β = (ζ ^ (k * m)) ^ 3 := by
        dsimp [β]; rw [← pow_mul]; congr 1; ring
      calc β * (σ (C.u⁻¹ : Kˣ)) ^ 3
        _ = (ζ ^ (k * m) * σ (C.u⁻¹ : Kˣ)) ^ 3 := by rw [hβ_eq, ← mul_pow]
        _ = ((C.u⁻¹ : Kˣ) : K) ^ 3 := by rw [hu_inv_rel]
    have hσ_r : σ C.r = C.r := AlgEquiv.commutes σ r_F
    have hσ_s : σ C.s = C.s := AlgEquiv.commutes σ s_F
    have hσ_t : σ C.t = C.t := AlgEquiv.commutes σ t_F
    refine ⟨C, α, β, hW₂_a₁, hW₂_a₂, hW₂_a₃, hv_W₂_a₄, hv_W₂_a₆, hv_W₂_Δ,
      hv2, hv3, hℓ2, hℓ3, hα_pow, hβ_pow, h_nontriv, ?_⟩
    intro x y hx hy
    constructor
    · have hσ_x' : σ ((C.u⁻¹ : Kˣ) ^ 2 * (x - C.r)) =
          (σ (C.u⁻¹ : Kˣ)) ^ 2 * (x - C.r) := by
        rw [map_mul, map_pow, map_sub, hx, hσ_r]
      calc σ ((C.u⁻¹ : Kˣ) ^ 2 * (x - C.r)) - ((C.u⁻¹ : Kˣ) ^ 2 * (x - C.r))
        _ = (σ (C.u⁻¹ : Kˣ)) ^ 2 * (x - C.r) - (α * (σ (C.u⁻¹ : Kˣ)) ^ 2) * (x - C.r) := by
            rw [hσ_x', ← hu_inv2]
        _ = (1 - α) * ((σ (C.u⁻¹ : Kˣ)) ^ 2 * (x - C.r)) := by ring
        _ = (1 - α) * σ ((C.u⁻¹ : Kˣ) ^ 2 * (x - C.r)) := by rw [hσ_x']
    · have hσ_y' : σ ((C.u⁻¹ : Kˣ) ^ 3 * (y - C.s * (x - C.r) - C.t)) =
          (σ (C.u⁻¹ : Kˣ)) ^ 3 * (y - C.s * (x - C.r) - C.t) := by
        rw [map_mul, map_pow, map_sub, map_sub, map_mul, map_sub, hx, hy, hσ_r, hσ_s, hσ_t]
      calc σ ((C.u⁻¹ : Kˣ) ^ 3 * (y - C.s * (x - C.r) - C.t)) -
            ((C.u⁻¹ : Kˣ) ^ 3 * (y - C.s * (x - C.r) - C.t))
        _ = (σ (C.u⁻¹ : Kˣ)) ^ 3 * (y - C.s * (x - C.r) - C.t) -
              (β * (σ (C.u⁻¹ : Kˣ)) ^ 3) * (y - C.s * (x - C.r) - C.t) := by
            rw [hσ_y', ← hu_inv3]
        _ = (1 - β) * ((σ (C.u⁻¹ : Kˣ)) ^ 3 * (y - C.s * (x - C.r) - C.t)) := by ring
        _ = (1 - β) * σ ((C.u⁻¹ : Kˣ) ^ 3 * (y - C.s * (x - C.r) - C.t)) := by rw [hσ_y']
  obtain ⟨C, α, β, hW₂_a₁, hW₂_a₂, hW₂_a₃, hv_W₂_a₄, hv_W₂_a₆, hv_W₂_Δ,
    hv2, hv3, hℓ2, hℓ3, hα_pow, hβ_pow, h_nontriv, h_coord⟩ := h_s7
  
  let W₁' : WeierstrassCurve.Affine K := W₁.toAffine
  let W₂' : WeierstrassCurve.Affine K := (C • W₁).toAffine
  let u : K := C.u
  let u_inv : K := (C.u⁻¹ : Kˣ)
  let r : K := C.r
  let s : K := C.s
  let t : K := C.t
  have huu : u * u_inv = 1 := Units.mul_inv C.u
  have huu' : u_inv * u = 1 := Units.inv_mul C.u
  have hu_inv : u_inv ≠ 0 := Units.ne_zero C.u⁻¹
  have ha₁_C : W₂'.a₁ = u_inv * (W₁'.a₁ + 2 * s) := WeierstrassCurve.variableChange_a₁ W₁ C
  have ha₂_C : W₂'.a₂ = u_inv ^ 2 * (W₁'.a₂ - s * W₁'.a₁ + 3 * r - s ^ 2) :=
    WeierstrassCurve.variableChange_a₂ W₁ C
  have ha₃_C : W₂'.a₃ = u_inv ^ 3 * (W₁'.a₃ + r * W₁'.a₁ + 2 * t) :=
    WeierstrassCurve.variableChange_a₃ W₁ C
  have ha₄_C : W₂'.a₄ = u_inv ^ 4 *
      (W₁'.a₄ - s * W₁'.a₃ + 2 * r * W₁'.a₂ - (t + r * s) * W₁'.a₁ + 3 * r ^ 2 - 2 * s * t) :=
    WeierstrassCurve.variableChange_a₄ W₁ C
  have ha₆_C : W₂'.a₆ = u_inv ^ 6 *
      (W₁'.a₆ + r * W₁'.a₄ + r ^ 2 * W₁'.a₂ + r ^ 3 - t * W₁'.a₃ - t ^ 2 - r * t * W₁'.a₁) :=
    WeierstrassCurve.variableChange_a₆ W₁ C
  let X : K → K := fun x => u_inv ^ 2 * (x - r)
  let Y : K → K → K := fun x y => u_inv ^ 3 * (y - s * (x - r) - t)
  let X' : K → K := fun x' => u ^ 2 * x' + r
  let Y' : K → K → K := fun x' y' => u ^ 3 * y' + u ^ 2 * s * x' + t
  have hXX' : ∀ x, X' (X x) = x := fun x => by
    dsimp only [X, X']
    calc u ^ 2 * (u_inv ^ 2 * (x - r)) + r
      _ = (u * u_inv) ^ 2 * (x - r) + r := by ring
      _ = 1 ^ 2 * (x - r) + r := by rw [huu]
      _ = x := by ring
  have hX'X : ∀ x', X (X' x') = x' := fun x' => by
    dsimp only [X, X']
    calc u_inv ^ 2 * ((u ^ 2 * x' + r) - r)
      _ = (u_inv * u) ^ 2 * x' := by ring
      _ = 1 ^ 2 * x' := by rw [huu']
      _ = x' := by ring
  have hYY' : ∀ x y, Y' (X x) (Y x y) = y := fun x y => by
    dsimp only [X, Y, Y']
    calc u ^ 3 * (u_inv ^ 3 * (y - s * (x - r) - t)) +
          u ^ 2 * s * (u_inv ^ 2 * (x - r)) + t
      _ = (u * u_inv) ^ 3 * (y - s * (x - r) - t) +
          (u * u_inv) ^ 2 * s * (x - r) + t := by ring
      _ = 1 ^ 3 * (y - s * (x - r) - t) +
          1 ^ 2 * s * (x - r) + t := by rw [huu]
      _ = y := by ring
  have hY'Y : ∀ x' y', Y (X' x') (Y' x' y') = y' := fun x' y' => by
    dsimp only [X, Y, X', Y']
    calc u_inv ^ 3 * ((u ^ 3 * y' + u ^ 2 * s * x' + t) -
          s * ((u ^ 2 * x' + r) - r) - t)
      _ = (u_inv * u) ^ 3 * y' := by ring
      _ = 1 ^ 3 * y' := by rw [huu']
      _ = y' := by ring
  have h_eq_poly : ∀ x y,
      (Y x y) ^ 2 + W₂'.a₁ * (X x) * (Y x y) + W₂'.a₃ * (Y x y) -
        ((X x) ^ 3 + W₂'.a₂ * (X x) ^ 2 + W₂'.a₄ * (X x) + W₂'.a₆) =
      u_inv ^ 6 * (y ^ 2 + W₁'.a₁ * x * y + W₁'.a₃ * y -
