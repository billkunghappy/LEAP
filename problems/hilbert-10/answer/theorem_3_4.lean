        ring
      · change (0 : kF) * 1 + 1 * 0 + 0 * 1 * 1 = 0
        ring
    have hu_bar_pow : u_bar₀ ^ (EllipticRootNumber.q F - 1) = -1 := by
      rw [← hm₀_mul, pow_mul, hu_bar_sq, ← map_pow, hd_pow_m₀, map_neg, map_one]
    have hu_unit_pow : u_bar ^ (EllipticRootNumber.q F - 1) = -1 := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one]
      exact hu_bar_pow
    obtain ⟨k_u, hk_u⟩ := hg u_bar
    change g ^ k_u = u_bar at hk_u
    have hg_pow_neg1 : g ^ (k_u * (EllipticRootNumber.q F - 1)) = -1 := by
      rw [pow_mul, hk_u, hu_unit_pow]
    have hg_pow_sq1 : g ^ (k_u * (EllipticRootNumber.q F - 1) * 2) = 1 := by
      rw [pow_mul, hg_pow_neg1, neg_one_sq]
    have hg_pow_ne1 : g ^ (k_u * (EllipticRootNumber.q F - 1)) ≠ 1 := by
      rw [hg_pow_neg1]
      intro h1
      have h_val : ((-1 : E₂ˣ) : E₂) = 1 := congrArg Units.val h1
      have h_re : (-1 : kF) = 1 := congrArg QuadraticAlgebra.re h_val
      have h2_0 : (2 : kF) = 0 := by linear_combination -h_re
      exact h2_ne_kF h2_0
    have hdvd_2 :
        (EllipticRootNumber.q F - 1) * (EllipticRootNumber.q F + 1) ∣
