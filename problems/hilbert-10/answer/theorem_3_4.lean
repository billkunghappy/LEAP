    (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)))
    (fun _ => Iff.rfl) h_card_m τ hI_class hτ_eval T T' Q₁ g hT hT' hQ₁ hg_span hg_inv

theorem weierstrass_weilPairing_of_miller_step_and_card_spec (F : Type u) [Field F]
