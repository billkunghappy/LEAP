      have hmv : (0 : ℝ) ≤ (v.mult : ℝ) := (hmult0 v).le
      have hstep : |t v * (v.mult : ℝ) * (Real.log (v (y : K)) - (Real.log N + c v))|
          = ((v.mult : ℝ) * |t v|)
              * |Real.log (v (y : K)) - (Real.log N + c v)| := by
        rw [abs_mul, abs_mul, abs_of_nonneg hmv]; ring
      rw [hstep]
      exact mul_le_mul_of_nonneg_left (hC2 v) (mul_nonneg hmv (abs_nonneg (t v)))
    obtain ⟨θ₂, hθ₂def⟩ : ∃ θ₂ : ℝ,
        θ₂ = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          ((l p : ℤ) : ℝ) * ((NumberField.mixedEmbedding K (y : K)).2 p).arg := ⟨_, rfl⟩
    have hargbd : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        |((NumberField.mixedEmbedding K (y : K)).2 p).arg| ≤ 4 * R / Q := by
      intro p
      have h4P : 4 * R ≤ P (p : NumberField.InfinitePlace K) :=
        le_trans hQ4 (hPQ (p : NumberField.InfinitePlace K))
      have hφ : |(0 : ℝ)| ≤ Real.pi / 4 := by
        rw [abs_zero]
        linarith [Real.pi_gt_three]
      have hz : ‖(NumberField.mixedEmbedding K (y : K)).2 p
          - ((P (p : NumberField.InfinitePlace K) : ℝ) : ℂ)
            * Complex.exp (((0 : ℝ) : ℂ) * Complex.I)‖ ≤ R := by
        simpa using hycp' p
      have harg := hargest (P (p : NumberField.InfinitePlace K)) R 0
        ((NumberField.mixedEmbedding K (y : K)).2 p)
        (hP0 (p : NumberField.InfinitePlace K)) hR0.le h4P hφ hz
      rw [sub_zero] at harg
      refine harg.trans ?_
      exact div_le_div_of_nonneg_left (by linarith) hQ0 (hPQ (p : NumberField.InfinitePlace K))
    have hθ₂bd : |θ₂| ≤ D * (4 * R / Q) := by
      rw [hθ₂def]
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      rw [hDdef, Finset.sum_mul]
      refine Finset.sum_le_sum (fun p _ => ?_)
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_left (hargbd p) (abs_nonneg _)
    have hnum : 2 * C * R + 4 * D * R ≤ Q / 2 := by linarith [hf2, hCR, hR0]
    have hquot : (2 * C * R + 4 * D * R) / Q ≤ 1 / 2 := by
      rw [div_le_iff₀ hQ0]
      linarith
    have hsum : C * (2 * R / Q) + D * (4 * R / Q) = (2 * C * R + 4 * D * R) / Q := by
      field_simp <;> ring
    have hθtot : |θ₁ + θ₂ - 1| ≤ 1 / 2 := by
      calc |θ₁ + θ₂ - 1| = |(θ₁ - 1) + θ₂| := by
            rw [show θ₁ + θ₂ - 1 = (θ₁ - 1) + θ₂ from by ring]
        _ ≤ |θ₁ - 1| + |θ₂| := abs_add_le _ _
        _ ≤ C * (2 * R / Q) + D * (4 * R / Q) := add_le_add hθ₁bd hθ₂bd
        _ ≤ 1 / 2 := by rw [hsum]; exact hquot
    rw [abs_le] at hθtot
    have heq := heval y hy1 hpos
    rw [hval, ← hθ₁def, ← hθ₂def] at heq
    have him := congrArg Complex.im heq
    rw [Complex.one_im, Complex.exp_ofReal_mul_I_im] at him
    have hsinpos : 0 < Real.sin (θ₁ + θ₂) := by
      refine Real.sin_pos_of_pos_of_lt_pi ?_ ?_
      · linarith [hθtot.1]
      · linarith [hθtot.2, Real.pi_gt_three]
    linarith [him, hsinpos]
  subst ht
  
  have hl : l = 0 := by
    by_contra hl
    obtain ⟨p₀, hp₀⟩ := Function.ne_iff.mp hl
    have hlp₀ : l p₀ ≠ 0 := by simpa using hp₀
    obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = ((l p₀ : ℤ) : ℝ) := ⟨_, rfl⟩
    have hL0 : L ≠ 0 := by rw [hLdef]; exact Int.cast_ne_zero.mpr hlp₀
    have hn1 : (1 : ℝ) ≤ |L| := by
      rw [hLdef, ← Int.cast_abs]
      exact_mod_cast Int.one_le_abs hlp₀
    obtain ⟨D, hDdef⟩ : ∃ D : ℝ,
        D = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |((l p : ℤ) : ℝ)| :=
      ⟨_, rfl⟩
    have hnD : |L| ≤ D := by
      rw [hLdef, hDdef]
      exact Finset.single_le_sum (fun i _ => abs_nonneg ((l i : ℤ) : ℝ)) (Finset.mem_univ p₀)
    have hD1 : (1 : ℝ) ≤ D := le_trans hn1 hnD
    obtain ⟨φ, hφdef⟩ : ∃ φ : ℝ, φ = 1 / (4 * L) := ⟨_, rfl⟩
    have hT1 : L * φ = 1 / 4 := by
      rw [hφdef]
      field_simp
    have hT2 : |φ| ≤ 1 / 4 := by
      rw [hφdef, abs_div, abs_one, abs_mul]
      have h4 : |(4 : ℝ)| = 4 := abs_of_pos (by norm_num)
      rw [h4]
      exact one_div_le_one_div_of_le (by norm_num) (by linarith)
    obtain ⟨ph, hphdef⟩ : ∃ ph : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ,
        ph = fun p => if p = p₀ then φ else 0 := ⟨_, rfl⟩
    have hphp₀ : ph p₀ = φ := by rw [hphdef]; simp
    have hphne : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        p ≠ p₀ → ph p = 0 := by
      intro p hp
      rw [hphdef]
      simp [hp]
    have hT3 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        |ph p| ≤ Real.pi / 4 := by
      intro p
      by_cases hp : p = p₀
      · rw [hp, hphp₀]
        have hpi := Real.pi_gt_three
        linarith
      · rw [hphne p hp, abs_zero]
        have hpi := Real.pi_gt_three
        linarith
    obtain ⟨N, hNdef⟩ : ∃ N : ℝ, N = 200 * D * R := ⟨_, rfl⟩
    have hN0 : 0 < N := by
      rw [hNdef]
      exact mul_pos (by linarith : (0 : ℝ) < 200 * D) hR0
    have h4RN : 4 * R ≤ N := by
      have hprod : (0 : ℝ) ≤ (200 * D - 4) * R := mul_nonneg (by linarith) hR0.le
      have hexp : (200 * D - 4) * R = 200 * D * R - 4 * R := by ring
      rw [hexp] at hprod
      rw [hNdef]
      linarith
    have hT7 : D * (4 * R / N) = 1 / 50 := by
      rw [← mul_div_assoc, div_eq_div_iff (ne_of_gt hN0) (by norm_num : (50 : ℝ) ≠ 0)]
      rw [hNdef]
      ring
    obtain ⟨y, hy1, hA1, hA2⟩ := hcov
      ((fun _ => N, fun p => (N : ℂ) * Complex.exp (((ph p : ℝ) : ℂ) * Complex.I)))
    have hA1' : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        |(NumberField.mixedEmbedding K (y : K)).1 w - N| ≤ R := hA1
    have hA2' : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        ‖(NumberField.mixedEmbedding K (y : K)).2 p
            - (N : ℂ) * Complex.exp (((ph p : ℝ) : ℂ) * Complex.I)‖ ≤ R := hA2
    have hpos : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        0 < (NumberField.mixedEmbedding K (y : K)).1 w := by
      intro w
      have hw := hA1' w
      rw [abs_le] at hw
      linarith [hw.1, hw.2]
    have hmk : Ideal.Quotient.mk q y = 1 := by
      have hqe := Ideal.Quotient.eq.mpr hy1
      rwa [map_one] at hqe
    have hxu : IsUnit (Ideal.Quotient.mk q y) := by rw [hmk]; exact isUnit_one
    obtain ⟨θ, hθdef⟩ : ∃ θ : ℝ,
        θ = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          ((l p : ℤ) : ℝ) * ((NumberField.mixedEmbedding K (y : K)).2 p).arg := ⟨_, rfl⟩
    have h5 := heval y hy1 hpos
    simp only [Pi.zero_apply, zero_mul, Finset.sum_const_zero, zero_add] at h5
    have hE : Complex.exp (((θ : ℝ) : ℂ) * Complex.I) = 1 := by
      rw [hθdef, ← h5]
      exact h1 y hxu
    have hT12 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        |((NumberField.mixedEmbedding K (y : K)).2 p).arg - ph p| ≤ 4 * R / N := by
      intro p
      exact hargest N R (ph p)
        ((NumberField.mixedEmbedding K (y : K)).2 p) hN0 hR0.le h4RN (hT3 p) (hA2' p)
    have hΦ : (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        ((l p : ℤ) : ℝ) * ph p) = 1 / 4 := by
      have hsingle := Finset.sum_eq_single_of_mem
        (s := (Finset.univ : Finset {w : NumberField.InfinitePlace K // w.IsComplex}))
        (f := fun p => ((l p : ℤ) : ℝ) * ph p) p₀ (Finset.mem_univ p₀)
        (by intro b _ hb; simp [hphne b hb])
      rw [hsingle]
      show ((l p₀ : ℤ) : ℝ) * ph p₀ = 1 / 4
      rw [hphp₀, ← hLdef]
      exact hT1
    have hdev : |θ - 1 / 4| ≤ 1 / 50 := by
      have hrw : θ - (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            ((l p : ℤ) : ℝ) * ph p)
          = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ((l p : ℤ) : ℝ) *
                (((NumberField.mixedEmbedding K (y : K)).2 p).arg - ph p) := by
        rw [hθdef, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun p _ => by ring)
      rw [← hΦ, hrw]
      calc |∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ((l p : ℤ) : ℝ) *
                (((NumberField.mixedEmbedding K (y : K)).2 p).arg - ph p)|
          ≤ ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              |((l p : ℤ) : ℝ) *
                (((NumberField.mixedEmbedding K (y : K)).2 p).arg - ph p)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              |((l p : ℤ) : ℝ)| *
                |((NumberField.mixedEmbedding K (y : K)).2 p).arg - ph p| :=
            Finset.sum_congr rfl (fun p _ => abs_mul _ _)
        _ ≤ ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              |((l p : ℤ) : ℝ)| * (4 * R / N) :=
            Finset.sum_le_sum (fun p _ =>
              mul_le_mul_of_nonneg_left (hT12 p) (abs_nonneg _))
        _ = (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              |((l p : ℤ) : ℝ)|) * (4 * R / N) := by rw [← Finset.sum_mul]
        _ = D * (4 * R / N) := by rw [← hDdef]
        _ = 1 / 50 := hT7
    rw [abs_le] at hdev
    have hθ0 : 0 < θ := by linarith [hdev.1]
    have hθpi : θ < Real.pi := by
      have hpi := Real.pi_gt_three
      linarith [hdev.2]
    have hsin0 : Real.sin θ = 0 := by
      have him := congrArg Complex.im hE
      rwa [Complex.exp_ofReal_mul_I_im, Complex.one_im] at him
    have hsinpos : 0 < Real.sin θ := Real.sin_pos_of_pos_of_lt_pi hθ0 hθpi
    linarith
  subst hl
  
  have he : η = (fun _ => false) := by
    funext w₀
    show η w₀ = false
    by_contra hcon
    have hη : η w₀ = true := by
      rcases Bool.eq_false_or_eq_true (η w₀) with h | h
      · exact h
      · exact absurd h hcon
    obtain ⟨y, hy1, hA, hB⟩ :=
      hcov (⟨fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
          if w = w₀ then -(R + 1) else (R + 1), fun _ => 0⟩ :
        NumberField.mixedEmbedding.mixedSpace K)
    have key : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        |(NumberField.mixedEmbedding K (y : K)).1 w
          - (if w = w₀ then -(R + 1) else (R + 1))| ≤ R := hA
    have hneg : (NumberField.mixedEmbedding K (y : K)).1 w₀ < 0 := by
      have h := key w₀
      rw [if_pos rfl, abs_le] at h
      linarith [h.2]
    have hpos : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, w ≠ w₀ →
        0 < (NumberField.mixedEmbedding K (y : K)).1 w := by
      intro w hw
      have h := key w
      rw [if_neg hw, abs_le] at h
      linarith [h.1]
    have hmk : Ideal.Quotient.mk q y = 1 := by
      have h : Ideal.Quotient.mk q y = Ideal.Quotient.mk q 1 := Ideal.Quotient.eq.mpr hy1
      rwa [map_one] at h
    have hx : IsUnit (Ideal.Quotient.mk q y) := by
      rw [hmk]; exact isUnit_one
    have hu : hx.unit = 1 := by
      apply Units.ext
      rw [IsUnit.unit_spec, hmk, Units.val_one]
    have hsgn0 : Real.sign ((NumberField.mixedEmbedding K (y : K)).1 w₀) = -1 :=
      Real.sign_of_neg hneg
    have hrest : ∀ b ∈ (Finset.univ : Finset {w : NumberField.InfinitePlace K // w.IsReal}),
        b ≠ w₀ →
        (if η b then
            ((Real.sign ((NumberField.mixedEmbedding K (y : K)).1 b) : ℝ) : ℂ)
          else 1) = 1 := by
      intro b _ hb
      have hsb : Real.sign ((NumberField.mixedEmbedding K (y : K)).1 b) = 1 :=
        Real.sign_of_pos (hpos b hb)
      rw [hsb]
      simp
    have hmain : kaiHeckeTwist K q 0 0 ξ η y = -1 := by
      rw [kaiHeckeTwist, dif_pos hx, hu,
        Finset.prod_eq_single_of_mem w₀ (Finset.mem_univ w₀) hrest, hsgn0]
      simp [hη]
    rw [h1 y hx] at hmain
    norm_num at hmain
  subst he
  
  refine ⟨rfl, rfl, rfl, ?_⟩
  refine MonoidHom.ext (fun u => ?_)
  obtain ⟨y, hy⟩ :=
    Ideal.Quotient.mk_surjective (u : NumberField.RingOfIntegers K ⧸ q)
  have hx : IsUnit (Ideal.Quotient.mk q y) := by
    rw [hy]
    exact u.isUnit
  have hu : hx.unit = u := Units.ext (by rw [IsUnit.unit_spec]; exact hy)
  have hcomp :
      kaiHeckeTwist K q 0 0 ξ (fun _ => false) y = ((ξ hx.unit : Circle) : ℂ) := by
    rw [kaiHeckeTwist, dif_pos hx]
    simp
  have hval := h1 y hx
  rw [hcomp, hu] at hval
  rw [MonoidHom.one_apply]
  exact Circle.coe_injective (by rw [Circle.coe_one]; exact hval)

theorem kai_lp_fs_zero_freq (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (cP : ℝ) (hcP : 0 < cP) (x : ℝ) (hx : 3 ≤ x) (δ : ℝ) (hδ : 0 < δ)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (𝔮D : Ideal (NumberField.RingOfIntegers K))
    (ψ : NumberField.RingOfIntegers K → ℤ) (β ε : ℝ)
    (hεβ : ε = 0 ∨ (1 / 2 ≤ β ∧ β < 1))
    (HYP : ∀ (t : NumberField.InfinitePlace K → ℝ)
          (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
          (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
          (∀ v : (NumberField.RingOfIntegers K)ˣ,
            kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1) →
          ‖(∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
              kaiHeckeTwist K q t l ξ η (kaiGen (P : Ideal (NumberField.RingOfIntegers K)))
                * ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ))
            - ((((@ite ℝ (∀ y : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q y) →
                      kaiHeckeTwist K q t l ξ η y = 1) (Classical.propDecidable _) (1 : ℝ) 0) * x
                  - (@ite ℝ (ψ ≠ 0 ∧ t = 0 ∧ l = 0 ∧
                        ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
                          IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
                          kaiHeckeTwist K q t l ξ η y = ((ψ y : ℤ) : ℂ))
                      (Classical.propDecidable _) (1 : ℝ) 0) * (x ^ β / β))
                / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)‖
            ≤ cP * x * Real.log x ^ 2 * Real.log (1 + kaiInfSize K t l) *
                Real.exp (-(Real.log x) /
                  (cP * (Real.sqrt (Real.log x) + Real.log (1 + kaiInfSize K t l)))))
    (hex0 : ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
          ∀ v : (NumberField.RingOfIntegers K)ˣ,
            kaiHeckeTwist K q 0 0 ξ η (v : NumberField.RingOfIntegers K) = 1)
    (hex1 : ∀ (ξ ξ' : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ' η' y = ((ψ y : ℤ) : ℂ)) →
          ξ = ξ' ∧ η = η')
    (α : NumberField.RingOfIntegers K) (hα0 : α ≠ 0) (hα : IsUnit (Ideal.Quotient.mk q α))
    (hex2 : ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
          kaiHeckeTwist K q 0 0 ξ η α = ((ε : ℝ) : ℂ))
    (hex3 : ε ≠ 0 → ∃ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (Ξ : Finset (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle))
    (hΞ1 : (1 : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) ∈ Ξ)
    (hΞcard : Ξ.card = Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ))
    (hΞall : ∀ ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle, ξ ∈ Ξ)
    (cT : Fin (NumberField.Units.rank K) → ℤ → ℂ)
    (cS : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ → ℂ)
    (g : Fin (NumberField.Units.rank K) → ℝ)
    (th : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hbdT : ∀ j m, ‖cT j m‖ ≤ kaiLPCoefBd δ m) (hbdS : ∀ p l, ‖cS p l‖ ≤ kaiLPCoefBd δ l)
    (hzT : ∀ j, ‖cT j 0 - ((g j : ℝ) : ℂ)‖ ≤ δ) (hzS : ∀ p, ‖cS p 0 - ((th p : ℝ) : ℂ)‖ ≤ δ)
    (hg : ∀ j, 0 ≤ g j ∧ g j ≤ 1) (hth : ∀ p, 0 ≤ th p ∧ th p ≤ 1) :
    ‖kaiLPFreqSum K q H e α
        (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w)) cT cS Ξ
        (0 : (Fin (NumberField.Units.rank K) → ℤ) ×
          ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)) x
      - (((∏ j, g j) * (∏ p, th p) * (x - ε * (x ^ β / β))
            / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)‖
      ≤ ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ)
            * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
          * ((5 / 4 : ℝ) ^ (NumberField.Units.rank K
                + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex})
            * (cP * x * Real.log x ^ 2 * Real.log 2
                * Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x) + Real.log 2)))))
        + 3 * ((NumberField.Units.rank K
                + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex} : ℕ) : ℝ)
            * (5 / 4 : ℝ) ^ (NumberField.Units.rank K
                + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}) * δ * x :=
by
  classical
