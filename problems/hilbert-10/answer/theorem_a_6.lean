    intro P
    have h0 : Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact P.2.2
    have h1 : Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K)) ≠ 1 := by
      rw [Ne, Ideal.absNorm_eq_one_iff]; exact P.2.1.ne_top
    have h2 : 2 ≤ Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K)) := by omega
    exact_mod_cast h2
  have partA : ∀ y : {P : Ideal (NumberField.RingOfIntegers K) // P.IsPrime ∧ P ≠ ⊥} → ℝ,
      (∀ i, 2 ≤ y i) →
      Summable (fun i : {P : Ideal (NumberField.RingOfIntegers K) // P.IsPrime ∧ P ≠ ⊥} =>
        Real.log (y i) * (y i) ^ (-σ)) →
      Summable (fun z : {P : Ideal (NumberField.RingOfIntegers K) // P.IsPrime ∧ P ≠ ⊥} × ℕ =>
        Real.log (y z.1) * ((y z.1) ^ (z.2 + 1)) ^ (-σ)) ∧
        (∑' z : {P : Ideal (NumberField.RingOfIntegers K) // P.IsPrime ∧ P ≠ ⊥} × ℕ,
            Real.log (y z.1) * ((y z.1) ^ (z.2 + 1)) ^ (-σ))
          ≤ 2 * (∑' i : {P : Ideal (NumberField.RingOfIntegers K) // P.IsPrime ∧ P ≠ ⊥},
