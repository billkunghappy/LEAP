    have hnpos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by
      exact_mod_cast (Module.finrank_pos : 0 < Module.finrank ℚ K)
    have hn : (Module.finrank ℚ K : ℝ) ≠ 0 := ne_of_gt hnpos
