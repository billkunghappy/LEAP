        haveI hlo : P.LiesOver (Ideal.span {(p : ℤ)}) := ⟨h4⟩
        have h5 : P ∈ (Ideal.span {(p : ℤ)}).primesOver (NumberField.RingOfIntegers K) := by
          rw [Ideal.primesOver.eq_def, Set.mem_setOf_eq]
          exact ⟨hP, hlo⟩
        rw [← coe_primesOverFinset hne (NumberField.RingOfIntegers K)] at h5
        exact Finset.mem_coe.mp h5
    choose! rchar rdeg hrc using sA
    have hfib : ∀ m : ℕ, ∃ t : Finset (Ideal (NumberField.RingOfIntegers K)),
        t.card ≤ Module.finrank ℚ K ∧
        ∀ P : Ideal (NumberField.RingOfIntegers K),
          (P.IsPrime ∧ P ≠ ⊥) → rchar P = m → P ∈ t := by
      intro m
      by_cases hm : Nat.Prime m
      · obtain ⟨t, htc, hmem⟩ := sB m hm
        refine ⟨t, htc, ?_⟩
        intro P hS hrm
        refine hmem P hS.1 hS.2 ?_
        rw [← hrm]
        exact (hrc P hS.1 hS.2).2.2.2
      · refine ⟨∅, by simp, ?_⟩
        intro P hS hrm
        have hpr := (hrc P hS.1 hS.2).1
        rw [hrm] at hpr
        exact absurd hpr hm
    obtain ⟨col, hcol⟩ :
        ∃ c : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K),
          ∀ a b : Ideal (NumberField.RingOfIntegers K),
            (a.IsPrime ∧ a ≠ ⊥) → (b.IsPrime ∧ b ≠ ⊥) →
            rchar a = rchar b → c a = c b → a = b := by
      choose t htcard htmem using hfib
      have key : ∀ m : ℕ,
          ∃ e : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K),
            ∀ a b : Ideal (NumberField.RingOfIntegers K),
              a ∈ t m → b ∈ t m → e a = e b → a = b := by
        intro m
        refine ⟨fun a => if h : a ∈ t m then Fin.castLE (htcard m) ((t m).equivFin ⟨a, h⟩)
