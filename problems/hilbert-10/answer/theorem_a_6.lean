theorem kai_typeII_l2_transfer (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ A₂ : ℝ, 1 ≤ A₂ ∧
      ∀ (R G : ℝ) (X : ℕ) (𝔟 : Ideal (NumberField.RingOfIntegers K))
        (β : Ideal (NumberField.RingOfIntegers K) → ℝ),
        1 ≤ R → 0 ≤ G → 1 ≤ X → 𝔟 ≠ ⊥ → β ⊥ = 0 →
        (∀ Y : ℕ, 1 ≤ Y → Y ≤ X →
          ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset,
            (β I) ^ 2 ≤ G * (Y : ℝ)) →
        ∑ y ∈ omegaBox ω R,
            (∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
              @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (β J) 0) ^ 2
          ≤ A₂ * (1 + Real.log R) ^ Module.finrank ℚ K * G * ((omegaBox ω R).card : ℝ) :=
by
  classical
  obtain ⟨A₁, hA₁, hcard⟩ := kai_associates_card_bound K
  have hC1 : 1 < C := hω.1
  have hC0 : 0 < C := by linarith
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  obtain ⟨K₀, hK₀⟩ : ∃ K₀ : ℝ,
      K₀ = 1 + (Module.finrank ℚ K : ℝ) + (Module.finrank ℚ K : ℝ) * Real.log C := ⟨_, rfl⟩
  refine ⟨max 1 (A₁ * C ^ Module.finrank ℚ K * K₀ ^ Module.finrank ℚ K), le_max_left _ _, ?_⟩
  intro R G X 𝔟 β hR hG hX h𝔟 hβ hL2
  have h𝔟0 : 𝔟 ≠ 0 := h𝔟
  have hR0 : 0 < R := by linarith
  have hCR : 1 ≤ C * R := one_le_mul_of_one_le_of_one_le hC1.le hR
  have hY1 : 1 ≤ (C * R) ^ Module.finrank ℚ K := one_le_pow₀ hCR
  have hCRle : C * R ≤ (C * R) ^ Module.finrank ℚ K := le_self_pow₀ hCR (by omega)
  obtain ⟨Af, hAf⟩ : ∃ Af : ℝ,
      Af = A₁ * (1 + Real.log ((C * R) ^ Module.finrank ℚ K)) ^ Module.finrank ℚ K :=
    ⟨_, rfl⟩
  have hlogY : 0 ≤ Real.log ((C * R) ^ Module.finrank ℚ K) := Real.log_nonneg hY1
  have hAf0 : 0 ≤ Af := by rw [hAf]; positivity
  obtain ⟨Y₀, hY₀⟩ : ∃ Y₀ : ℕ, Y₀ = ⌊(C * R) ^ Module.finrank ℚ K⌋₊ := ⟨_, rfl⟩
  have hY₀1 : 1 ≤ Y₀ := by rw [hY₀]; exact Nat.one_le_floor_iff _ |>.2 hY1
  have hY₀le : (Y₀ : ℝ) ≤ (C * R) ^ Module.finrank ℚ K := by
    rw [hY₀]; exact Nat.floor_le (by positivity)
  
  have hpt : ∀ y : NumberField.RingOfIntegers K,
      (∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (β J) 0) ^ 2
        = ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) ((β J) ^ 2) 0 := by
    intro y
    by_cases hex : ∃ J₀ ∈ (Ideal.finite_setOf_absNorm_le
        (S := NumberField.RingOfIntegers K) X).toFinset, J₀ * 𝔟 = Ideal.span {y}
    · obtain ⟨J₀, hJ₀F, hJ₀⟩ := hex
      have huniq : ∀ J ∈ (Ideal.finite_setOf_absNorm_le
          (S := NumberField.RingOfIntegers K) X).toFinset, J ≠ J₀ →
          ¬ (J * 𝔟 = Ideal.span {y}) := by
        intro J _ hne hJ
        exact hne (mul_right_cancel₀ h𝔟0 (hJ.trans hJ₀.symm))
      rw [Finset.sum_eq_single_of_mem J₀ hJ₀F (fun J hJ hne => if_neg (huniq J hJ hne)),
        Finset.sum_eq_single_of_mem J₀ hJ₀F (fun J hJ hne => if_neg (huniq J hJ hne)),
        if_pos hJ₀, if_pos hJ₀]
    · push_neg at hex
      rw [Finset.sum_eq_zero (fun J hJ => if_neg (hex J hJ)),
        Finset.sum_eq_zero (fun J hJ => if_neg (hex J hJ))]
      ring
  
  have hswap : ∑ y ∈ omegaBox ω R,
      (∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (β J) 0) ^ 2
        = ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
            (β J) ^ 2 * ((@Finset.filter (NumberField.RingOfIntegers K)
              (fun y => J * 𝔟 = Ideal.span {y}) (fun _ => Classical.propDecidable _)
              (omegaBox ω R)).card : ℝ) := by
    rw [Finset.sum_congr rfl (fun y _ => hpt y), Finset.sum_comm]
    refine Finset.sum_congr rfl (fun J _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm]
  
  have hfib : ∀ J : Ideal (NumberField.RingOfIntegers K), J ≠ ⊥ →
      ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun y => J * 𝔟 = Ideal.span {y}) (fun _ => Classical.propDecidable _)
          (omegaBox ω R)).card : ℝ) ≤ Af := by
    intro J hJ
    rw [hAf]
    apply hcard _ hY1
    · intro y hy y' hy'
      rw [Finset.mem_filter] at hy hy'
      exact hy.2.symm.trans hy'.2
    · intro y hy w
      rw [Finset.mem_filter] at hy
      have hy0 : y ≠ 0 := by
        rintro rfl
        rw [Ideal.span_singleton_eq_bot.2 rfl, Ideal.mul_eq_bot] at hy
        rcases hy.2 with h | h
        · exact hJ h
        · exact h𝔟 h
      obtain ⟨h1, -, h3⟩ := kai_omegaBox_place_bounds K C ω hω R hR y hy.1
      exact ⟨h3 hy0 w, (h1 w).trans hCRle⟩
  
  have hnorm : ∀ (J : Ideal (NumberField.RingOfIntegers K)) (y : NumberField.RingOfIntegers K),
      y ∈ omegaBox ω R → J * 𝔟 = Ideal.span {y} → Ideal.absNorm J ≤ Y₀ := by
    intro J y hy hJy
    have h := congrArg Ideal.absNorm hJy
    rw [map_mul, Ideal.absNorm_span_singleton] at h
    have h𝔟n : Ideal.absNorm 𝔟 ≠ 0 := fun h' => h𝔟 (Ideal.absNorm_eq_zero_iff.1 h')
    have hle : Ideal.absNorm J ≤ (Algebra.norm ℤ y).natAbs := by
      rw [← h]; exact Nat.le_mul_of_pos_right _ (Nat.pos_of_ne_zero h𝔟n)
    obtain ⟨-, h2, -⟩ := kai_omegaBox_place_bounds K C ω hω R hR y hy
    rw [hY₀]
    apply Nat.le_floor
    calc ((Ideal.absNorm J : ℕ) : ℝ) ≤ (((Algebra.norm ℤ y).natAbs : ℕ) : ℝ) := by
          exact_mod_cast hle
      _ ≤ _ := h2
  
  have hterm : ∀ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
      (β J) ^ 2 * ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun y => J * 𝔟 = Ideal.span {y}) (fun _ => Classical.propDecidable _)
          (omegaBox ω R)).card : ℝ)
        ≤ Af * (if Ideal.absNorm J ≤ Y₀ then (β J) ^ 2 else 0) := by
    intro J _
    have hrhs : 0 ≤ Af * (if Ideal.absNorm J ≤ Y₀ then (β J) ^ 2 else 0) := by
      apply mul_nonneg hAf0
      split_ifs
      · exact sq_nonneg _
      · exact le_refl 0
    by_cases hc : (@Finset.filter (NumberField.RingOfIntegers K)
          (fun y => J * 𝔟 = Ideal.span {y}) (fun _ => Classical.propDecidable _)
          (omegaBox ω R)).card = 0
    · rw [hc, Nat.cast_zero, mul_zero]; exact hrhs
    by_cases hJ : J = ⊥
    · subst hJ
      rw [hβ]
      simpa using hrhs
    obtain ⟨y, hy⟩ := Finset.card_ne_zero.1 hc
    rw [Finset.mem_filter] at hy
    rw [if_pos (hnorm J y hy.1 hy.2)]
    calc (β J) ^ 2 * ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun y => J * 𝔟 = Ideal.span {y}) (fun _ => Classical.propDecidable _)
          (omegaBox ω R)).card : ℝ)
        ≤ (β J) ^ 2 * Af := mul_le_mul_of_nonneg_left (hfib J hJ) (sq_nonneg _)
      _ = Af * (β J) ^ 2 := mul_comm _ _
  
  obtain ⟨Ym, hYm⟩ : ∃ Ym : ℕ, Ym = min X Y₀ := ⟨_, rfl⟩
  have hYm1 : 1 ≤ Ym := by rw [hYm]; exact le_min hX hY₀1
  have hYmX : Ym ≤ X := by rw [hYm]; exact min_le_left _ _
  have hYmY : Ym ≤ Y₀ := by rw [hYm]; exact min_le_right _ _
  have hrestrict : ∑ J ∈ (Ideal.finite_setOf_absNorm_le
        (S := NumberField.RingOfIntegers K) X).toFinset,
        (if Ideal.absNorm J ≤ Y₀ then (β J) ^ 2 else 0)
      ≤ ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Ym).toFinset,
        (β J) ^ 2 := by
    rw [← Finset.sum_filter]
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro J hJ
      rw [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq] at hJ
      rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq, hYm]
      exact le_min hJ.1 hJ.2
    · intro J _ _; exact sq_nonneg _
  have hL2' := hL2 Ym hYm1 hYmX
  have hGY : G * (Ym : ℝ) ≤ G * (C * R) ^ Module.finrank ℚ K := by
    apply mul_le_mul_of_nonneg_left _ hG
    exact le_trans (by exact_mod_cast hYmY) hY₀le
  have hmain : ∑ y ∈ omegaBox ω R,
      (∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (β J) 0) ^ 2
        ≤ Af * (G * (C * R) ^ Module.finrank ℚ K) := by
    rw [hswap]
    calc _ ≤ ∑ J ∈ (Ideal.finite_setOf_absNorm_le
            (S := NumberField.RingOfIntegers K) X).toFinset,
            Af * (if Ideal.absNorm J ≤ Y₀ then (β J) ^ 2 else 0) := Finset.sum_le_sum hterm
      _ = Af * ∑ J ∈ (Ideal.finite_setOf_absNorm_le
            (S := NumberField.RingOfIntegers K) X).toFinset,
            (if Ideal.absNorm J ≤ Y₀ then (β J) ^ 2 else 0) := by rw [Finset.mul_sum]
      _ ≤ Af * (G * (C * R) ^ Module.finrank ℚ K) :=
          mul_le_mul_of_nonneg_left (hrestrict.trans (hL2'.trans hGY)) hAf0
  
  have hcardB : ((omegaBox ω R).card : ℝ)
      = (((2 * ⌊R⌋₊ + 1 : ℕ) : ℝ)) ^ Module.finrank ℚ K := by
    unfold omegaBox intBox
    rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective, Pi.card_Icc,
      Finset.prod_const, Finset.card_univ, Fintype.card_fin, Int.card_Icc]
    have : ((⌊R⌋₊ : ℤ) + 1 - -(⌊R⌋₊ : ℤ)).toNat = 2 * ⌊R⌋₊ + 1 := by omega
    rw [this]
    push_cast
    ring
  rw [hcardB]
  refine hmain.trans ?_
  have ha : 0 < Real.log C := Real.log_pos hC1
  have hb : 0 ≤ Real.log R := Real.log_nonneg hR
  have hlogeq : Real.log ((C * R) ^ Module.finrank ℚ K)
      = (Module.finrank ℚ K : ℝ) * (Real.log C + Real.log R) := by
    rw [Real.log_pow, Real.log_mul hC0.ne' hR0.ne']
  have hnR : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.cast_nonneg _
  have hlin : 1 + Real.log ((C * R) ^ Module.finrank ℚ K) ≤ K₀ * (1 + Real.log R) := by
    rw [hlogeq, hK₀]
    have : 0 ≤ (Module.finrank ℚ K : ℝ) * Real.log C * Real.log R :=
      mul_nonneg (mul_nonneg hnR ha.le) hb
    nlinarith
  have hpow1 : (1 + Real.log ((C * R) ^ Module.finrank ℚ K)) ^ Module.finrank ℚ K
      ≤ K₀ ^ Module.finrank ℚ K * (1 + Real.log R) ^ Module.finrank ℚ K := by
    rw [← mul_pow]; exact pow_le_pow_left₀ (by linarith) hlin _
  have hRF : R ≤ (((2 * ⌊R⌋₊ + 1 : ℕ) : ℝ)) := by
    have := Nat.lt_floor_add_one R
    push_cast
    have h0 : (0 : ℝ) ≤ (⌊R⌋₊ : ℝ) := Nat.cast_nonneg _
    linarith
  have hpow2 : (C * R) ^ Module.finrank ℚ K
      ≤ C ^ Module.finrank ℚ K * (((2 * ⌊R⌋₊ + 1 : ℕ) : ℝ)) ^ Module.finrank ℚ K := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity) (mul_le_mul_of_nonneg_left hRF hC0.le) _
  have hK₀0 : 0 ≤ K₀ := by rw [hK₀]; have := mul_nonneg hnR ha.le; linarith
  have hlR0 : 0 ≤ 1 + Real.log R := by linarith
  have hFl0 : (0 : ℝ) ≤ (((2 * ⌊R⌋₊ + 1 : ℕ) : ℝ)) := Nat.cast_nonneg _
  have hCRn0 : 0 ≤ (C * R) ^ Module.finrank ℚ K := pow_nonneg (mul_nonneg hC0.le hR0.le) _
  rw [hAf]
  calc A₁ * (1 + Real.log ((C * R) ^ Module.finrank ℚ K)) ^ Module.finrank ℚ K
        * (G * (C * R) ^ Module.finrank ℚ K)
      ≤ A₁ * (K₀ ^ Module.finrank ℚ K * (1 + Real.log R) ^ Module.finrank ℚ K)
        * (G * (C ^ Module.finrank ℚ K
          * (((2 * ⌊R⌋₊ + 1 : ℕ) : ℝ)) ^ Module.finrank ℚ K)) := by
        apply mul_le_mul (mul_le_mul_of_nonneg_left hpow1 hA₁)
          (mul_le_mul_of_nonneg_left hpow2 hG) (mul_nonneg hG hCRn0)
          (mul_nonneg hA₁ (mul_nonneg (pow_nonneg hK₀0 _) (pow_nonneg hlR0 _)))
    _ = (A₁ * C ^ Module.finrank ℚ K * K₀ ^ Module.finrank ℚ K)
        * ((1 + Real.log R) ^ Module.finrank ℚ K * G
          * (((2 * ⌊R⌋₊ + 1 : ℕ) : ℝ)) ^ Module.finrank ℚ K) := by ring
    _ ≤ max 1 (A₁ * C ^ Module.finrank ℚ K * K₀ ^ Module.finrank ℚ K)
        * ((1 + Real.log R) ^ Module.finrank ℚ K * G
          * (((2 * ⌊R⌋₊ + 1 : ℕ) : ℝ)) ^ Module.finrank ℚ K) := by
        apply mul_le_mul_of_nonneg_right (le_max_right _ _)
        exact mul_nonneg (mul_nonneg (pow_nonneg hlR0 _) hG) (pow_nonneg hFl0 _)
    _ = _ := by ring

theorem kai_typeII_element_conversion (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M R : ℝ) (X m : ℕ) (hm : 1 ≤ m) (𝔞 𝔟 : Ideal (NumberField.RingOfIntegers K))
    (h𝔞𝔟 : 𝔞 * 𝔟 = Ideal.span {((m : ℕ) : NumberField.RingOfIntegers K)})
    (α β : Ideal (NumberField.RingOfIntegers K) → ℝ) (W : Finset (NumberField.RingOfIntegers K))
    (hα0 : α ⊥ = 0) (hβ0 : β ⊥ = 0)
    (hW : ∀ w ∈ W, ∃ I : Ideal (NumberField.RingOfIntegers K), Ideal.span {w} = I * 𝔞)
    (hαW : ∀ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
      α I ≠ 0 → ∃ w ∈ W, Ideal.span {w} = I * 𝔞)
    (hR : ∀ (y w : NumberField.RingOfIntegers K), w ∈ W →
      ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊) → y ∈ omegaBox ω R)
    (p₀ : ℝ) (p₁ : Fin (Module.finrank ℚ K) → ℝ)
    (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ) :
    ((∀ I, |α I| ≤ 1) → ∀ w : NumberField.RingOfIntegers K,
        |∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          @ite ℝ (I * 𝔞 = Ideal.span {w}) (Classical.propDecidable _)
            (α I / ((@Finset.filter (NumberField.RingOfIntegers K)
               (fun w' => Ideal.span {w'} = I * 𝔞) (fun _ => Classical.propDecidable _) W).card : ℝ)) 0|
          ≤ 1) ∧
    ∑ x ∈ omegaBox ω M,
        ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
            ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (α I * β J) 0 : ℝ) : ℂ)
              * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))
      = ∑ y ∈ omegaBox ω R, ∑ w ∈ W,
          (((∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
              @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (β J) 0 : ℝ)) : ℂ) *
          (((∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
              @ite ℝ (I * 𝔞 = Ideal.span {w}) (Classical.propDecidable _)
                (α I / ((@Finset.filter (NumberField.RingOfIntegers K)
                   (fun w' => Ideal.span {w'} = I * 𝔞) (fun _ => Classical.propDecidable _) W).card : ℝ))
                0 : ℝ)) : ℂ) *
          (@ite ℂ (ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊))
            (Classical.propDecidable _)
            (giE (kaiQuadPoly p₀ (fun l => p₁ l / m) (fun l l' => p₂ l l' / (m : ℝ) ^ 2)
              (ω.equivFun (y * w)))) 0) :=
by
  classical
  obtain ⟨G, hG⟩ : ∃ G : Finset (Ideal (NumberField.RingOfIntegers K)),
      G = (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset :=
    ⟨_, rfl⟩
  rw [← hG] at hαW ⊢
  
  have hμ0 : ((m : ℕ) : NumberField.RingOfIntegers K) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hμ0' : Ideal.span {((m : ℕ) : NumberField.RingOfIntegers K)} ≠ 0 := by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hμ0
  have h𝔞 : 𝔞 ≠ ⊥ := by
    intro h
    apply hμ0'
    rw [← h𝔞𝔟, h, ← Ideal.zero_eq_bot, zero_mul]
  have h𝔞0 : 𝔞 ≠ 0 := by rw [Ne, Ideal.zero_eq_bot]; exact h𝔞
  
  have f1 : ∀ (M' : ℝ) (x : NumberField.RingOfIntegers K),
      x ∈ omegaBox ω M' ↔ ω.equivFun x ∈ intBox (Module.finrank ℚ K) ⌊M'⌋₊ := by
    intro M' x
    unfold omegaBox
    rw [Finset.mem_image]
    constructor
    · rintro ⟨v, hv, rfl⟩
      simp only [LinearEquiv.apply_symm_apply]
      exact hv
    · intro h
      exact ⟨ω.equivFun x, h, by simp only [LinearEquiv.symm_apply_apply]⟩
  have f2 : ∀ x : NumberField.RingOfIntegers K,
      ω.equivFun ((m : NumberField.RingOfIntegers K) * x) = m • ω.equivFun x := by
    intro x
    rw [← nsmul_eq_mul, map_nsmul]
  have f3 : ∀ (k : ℕ) (u : Fin (Module.finrank ℚ K) → ℤ),
      m • u ∈ intBox (Module.finrank ℚ K) (m * k) ↔ u ∈ intBox (Module.finrank ℚ K) k := by
    intro k u
    have hm' : (0 : ℤ) < (m : ℤ) := by exact_mod_cast hm
    simp only [intBox, Finset.mem_Icc, Pi.le_def, Pi.smul_apply, nsmul_eq_mul, Nat.cast_mul,
      Pi.mul_apply, Pi.natCast_apply]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨fun i => by nlinarith [h1 i, hm'], fun i => by nlinarith [h2 i, hm']⟩
    · rintro ⟨h1, h2⟩
      exact ⟨fun i => by nlinarith [h1 i, hm'], fun i => by nlinarith [h2 i, hm']⟩
  have hm0 : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have f4 : ∀ u : Fin (Module.finrank ℚ K) → ℤ,
      kaiQuadPoly p₀ (fun l => p₁ l / m) (fun l l' => p₂ l l' / (m : ℝ) ^ 2) (m • u)
        = kaiQuadPoly p₀ p₁ p₂ u := by
    intro u
    have hc : ∀ l, (((m • u) l : ℤ) : ℝ) = (m : ℝ) * (u l : ℝ) := by
      intro l
      simp only [Pi.smul_apply, nsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
    unfold kaiQuadPoly
    simp only [hc]
    congr 1
    · congr 1
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [show p₁ l / (m : ℝ) * ((m : ℝ) * (u l : ℝ)) = p₁ l * (u l : ℝ) * ((m : ℝ) * (m : ℝ)⁻¹)
        by ring, mul_inv_cancel₀ hm0, mul_one]
    · refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun l' _ => ?_))
      rw [show p₂ l l' / (m : ℝ) ^ 2 * ((m : ℝ) * (u l : ℝ)) * ((m : ℝ) * (u l' : ℝ))
          = p₂ l l' * (u l : ℝ) * (u l' : ℝ) * ((m : ℝ) * (m : ℝ)⁻¹) ^ 2 by ring,
        mul_inv_cancel₀ hm0, one_pow, mul_one]
  
  have fib : ∀ (I J : Ideal (NumberField.RingOfIntegers K)) (w : NumberField.RingOfIntegers K),
      w ≠ 0 → Ideal.span {w} = I * 𝔞 →
      (∀ y : NumberField.RingOfIntegers K,
        ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊) → y ∈ omegaBox ω R) →
      ∑ x ∈ omegaBox ω M, @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _)
          (giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))) 0
        = ∑ y ∈ omegaBox ω R, @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _)
            (@ite ℂ (ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊))
              (Classical.propDecidable _)
              (giE (kaiQuadPoly p₀ (fun l => p₁ l / m) (fun l l' => p₂ l l' / (m : ℝ) ^ 2)
                (ω.equivFun (y * w)))) 0) 0 := by
    intro I J w hw0 hwI hRw
    have hw0' : Ideal.span {w} ≠ 0 := by
      rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hw0
    have fwd : ∀ x : NumberField.RingOfIntegers K, I * J = Ideal.span {x} →
        ∃ y, y * w = (m : NumberField.RingOfIntegers K) * x ∧ J * 𝔟 = Ideal.span {y} := by
      intro x hIJ
      have key : Ideal.span {w} * (J * 𝔟)
          = Ideal.span {(m : NumberField.RingOfIntegers K) * x} := by
        rw [hwI, mul_mul_mul_comm, hIJ, h𝔞𝔟, Ideal.span_singleton_mul_span_singleton, mul_comm x]
      have hmem : (m : NumberField.RingOfIntegers K) * x ∈ Ideal.span {w} := by
        have h1 : (m : NumberField.RingOfIntegers K) * x ∈ Ideal.span {w} * (J * 𝔟) := by
          rw [key]; exact Ideal.mem_span_singleton_self _
        exact Ideal.mul_le_right h1
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hmem
      refine ⟨y, hy, ?_⟩
      have h2 : Ideal.span {w} * Ideal.span {y} = Ideal.span {w} * (J * 𝔟) := by
        rw [key, Ideal.span_singleton_mul_span_singleton, mul_comm w y, hy]
      exact (mul_left_cancel₀ hw0' h2).symm
    have bwd : ∀ y : NumberField.RingOfIntegers K, J * 𝔟 = Ideal.span {y} →
        ∃ x, y * w = (m : NumberField.RingOfIntegers K) * x ∧ I * J = Ideal.span {x} := by
      intro y hJ
      have key : Ideal.span {(m : NumberField.RingOfIntegers K)} * (I * J)
          = Ideal.span {y * w} := by
        rw [← h𝔞𝔟, ← Ideal.span_singleton_mul_span_singleton, ← hJ, hwI]
        ring
      have hmem : y * w ∈ Ideal.span {(m : NumberField.RingOfIntegers K)} := by
        have h1 : y * w ∈ Ideal.span {(m : NumberField.RingOfIntegers K)} * (I * J) := by
          rw [key]; exact Ideal.mem_span_singleton_self _
        exact Ideal.mul_le_right h1
      obtain ⟨x, hx⟩ := Ideal.mem_span_singleton'.mp hmem
      refine ⟨x, by rw [← hx, mul_comm], ?_⟩
      have h2 : Ideal.span {(m : NumberField.RingOfIntegers K)} * Ideal.span {x}
          = Ideal.span {(m : NumberField.RingOfIntegers K)} * (I * J) := by
        rw [key, Ideal.span_singleton_mul_span_singleton,
          mul_comm (m : NumberField.RingOfIntegers K) x, hx]
      exact (mul_left_cancel₀ hμ0' h2).symm
    have condL : ∀ x : NumberField.RingOfIntegers K,
        @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _)
          (giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))) 0 ≠ 0 → I * J = Ideal.span {x} := by
      intro x hne
      by_contra h
      exact hne (if_neg h)
    refine Finset.sum_bij_ne_zero (fun x _ hne => (fwd x (condL x hne)).choose) ?_ ?_ ?_ ?_
    · intro x hx hne
      show (fwd x (condL x hne)).choose ∈ omegaBox ω R
      obtain ⟨e1, _⟩ := (fwd x (condL x hne)).choose_spec
      apply hRw
      rw [e1, f2, f3]
      exact (f1 M x).mp hx
    · intro x₁ _ h₁ x₂ _ h₂ heq
      have heq' : (fwd x₁ (condL x₁ h₁)).choose = (fwd x₂ (condL x₂ h₂)).choose := heq
      have e1 := (fwd x₁ (condL x₁ h₁)).choose_spec.1
      have e2 := (fwd x₂ (condL x₂ h₂)).choose_spec.1
      apply mul_left_cancel₀ hμ0
      rw [← e1, ← e2, heq']
    · intro y _ hne
      have hJ : J * 𝔟 = Ideal.span {y} := by
        by_contra h
        exact hne (if_neg h)
      have hbox : ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊) := by
        by_contra h
        apply hne
        rw [if_pos hJ, if_neg h]
      obtain ⟨x, hx1, hx2⟩ := bwd y hJ
      have hxbox : ω.equivFun x ∈ intBox (Module.finrank ℚ K) ⌊M⌋₊ :=
        (f3 _ _).mp (by rw [← f2, ← hx1]; exact hbox)
      have hval : giE (kaiQuadPoly p₀ (fun l => p₁ l / m) (fun l l' => p₂ l l' / (m : ℝ) ^ 2)
            (ω.equivFun (y * w))) = giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)) := by
        rw [hx1, f2, f4]
      have hne' : @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _)
          (giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))) 0 ≠ 0 := by
        rw [if_pos hx2, ← hval]
        intro h0
        apply hne
        rw [if_pos hJ, if_pos hbox]
        exact h0
      refine ⟨x, (f1 M x).mpr hxbox, hne', ?_⟩
      show (fwd x (condL x hne')).choose = y
      exact mul_right_cancel₀ hw0 ((fwd x (condL x hne')).choose_spec.1.trans hx1.symm)
    · intro x hx hne
      dsimp only
      obtain ⟨e1, e2⟩ := (fwd x (condL x hne)).choose_spec
      have hbox : ω.equivFun ((fwd x (condL x hne)).choose * w)
          ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊) := by
        rw [e1, f2, f3]; exact (f1 M x).mp hx
      rw [if_pos (condL x hne), if_pos e2, if_pos hbox, e1, f2, f4]
  
  have main : ∀ (B Y : Finset (NumberField.RingOfIntegers K))
      (E : NumberField.RingOfIntegers K → ℂ)
      (T : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℂ)
      (c : Ideal (NumberField.RingOfIntegers K) → NumberField.RingOfIntegers K → ℝ),
      (∀ I ∈ G, ∑ w ∈ W, c I w = α I) →
      (∀ w ∈ W, ∀ I ∈ G, ∀ J ∈ G, c I w ≠ 0 →
        ∑ x ∈ B, @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _) (E x) 0
          = ∑ y ∈ Y, @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0) →
      ∑ x ∈ B, ∑ I ∈ G, ∑ J ∈ G,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (α I * β J) 0 : ℝ) : ℂ)
            * E x
        = ∑ y ∈ Y, ∑ w ∈ W,
          (((∑ J ∈ G, @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (β J) 0 : ℝ))
            : ℂ) * (((∑ I ∈ G, c I w : ℝ)) : ℂ) * T y w := by
    intro B Y E T c hpu hfib
    have s1 : ∑ x ∈ B, ∑ I ∈ G, ∑ J ∈ G,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (α I * β J) 0 : ℝ) : ℂ)
            * E x
        = ∑ x ∈ B, ∑ I ∈ G, ∑ J ∈ G, ∑ w ∈ W, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _) (E x) 0 := by
      refine Finset.sum_congr rfl (fun x _ => Finset.sum_congr rfl (fun I hI =>
        Finset.sum_congr rfl (fun J _ => ?_)))
      by_cases h : I * J = Ideal.span {x}
      · simp only [if_pos h]
        rw [← Finset.sum_mul, ← Complex.ofReal_sum, ← Finset.sum_mul, hpu I hI]
      · simp only [if_neg h, Complex.ofReal_zero, zero_mul, mul_zero, Finset.sum_const_zero]
    have s2 : ∑ x ∈ B, ∑ I ∈ G, ∑ J ∈ G, ∑ w ∈ W, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _) (E x) 0
        = ∑ I ∈ G, ∑ J ∈ G, ∑ w ∈ W, ∑ x ∈ B, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _) (E x) 0 := by
      refine Finset.sum_comm.trans (Finset.sum_congr rfl (fun I _ => ?_))
      refine Finset.sum_comm.trans (Finset.sum_congr rfl (fun J _ => ?_))
      exact Finset.sum_comm
    have s3 : ∑ I ∈ G, ∑ J ∈ G, ∑ w ∈ W, ∑ x ∈ B, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _) (E x) 0
        = ∑ I ∈ G, ∑ J ∈ G, ∑ w ∈ W, ∑ y ∈ Y, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0 := by
      refine Finset.sum_congr rfl (fun I hI => Finset.sum_congr rfl (fun J hJ =>
        Finset.sum_congr rfl (fun w hw => ?_)))
      rw [← Finset.mul_sum, ← Finset.mul_sum]
      by_cases hc : c I w = 0
      · simp only [hc, zero_mul, Complex.ofReal_zero]
      · rw [hfib w hw I hI J hJ hc]
    have s4 : ∑ I ∈ G, ∑ J ∈ G, ∑ w ∈ W, ∑ y ∈ Y, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0
        = ∑ y ∈ Y, ∑ w ∈ W, ∑ I ∈ G, ∑ J ∈ G, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0 := by
      symm
      calc ∑ y ∈ Y, ∑ w ∈ W, ∑ I ∈ G, ∑ J ∈ G, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0
          = ∑ w ∈ W, ∑ y ∈ Y, ∑ I ∈ G, ∑ J ∈ G, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0 :=
            Finset.sum_comm
        _ = ∑ w ∈ W, ∑ I ∈ G, ∑ J ∈ G, ∑ y ∈ Y, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0 := by
            refine Finset.sum_congr rfl (fun w _ => ?_)
            refine Finset.sum_comm.trans (Finset.sum_congr rfl (fun I _ => ?_))
            exact Finset.sum_comm
        _ = ∑ I ∈ G, ∑ J ∈ G, ∑ w ∈ W, ∑ y ∈ Y, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0 := by
            refine Finset.sum_comm.trans (Finset.sum_congr rfl (fun I _ => ?_))
            exact Finset.sum_comm
    have s5 : ∑ y ∈ Y, ∑ w ∈ W, ∑ I ∈ G, ∑ J ∈ G, ((c I w * β J : ℝ) : ℂ) *
            @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (T y w) 0
        = ∑ y ∈ Y, ∑ w ∈ W,
          (((∑ J ∈ G, @ite ℝ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _) (β J) 0 : ℝ))
            : ℂ) * (((∑ I ∈ G, c I w : ℝ)) : ℂ) * T y w := by
      refine Finset.sum_congr rfl (fun y _ => Finset.sum_congr rfl (fun w _ => ?_))
      simp only [Complex.ofReal_sum, Finset.sum_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun I _ => Finset.sum_congr rfl (fun J _ => ?_))
      by_cases h : J * 𝔟 = Ideal.span {y}
      · simp only [if_pos h, Complex.ofReal_mul]
        ring
      · simp only [if_neg h, Complex.ofReal_zero, zero_mul, mul_zero]
    exact s1.trans (s2.trans (s3.trans (s4.trans s5)))
  
  have hdiv : ∀ (a : ℝ) (k : ℕ), |a| ≤ 1 → |a / (k : ℝ)| ≤ 1 := by
    intro a k ha
    rcases Nat.eq_zero_or_pos k with h | h
    · rw [h, Nat.cast_zero, div_zero, abs_zero]; exact zero_le_one
    · have h1 : (1 : ℝ) ≤ k := by exact_mod_cast h
      rw [abs_div, Nat.abs_cast]
      exact (div_le_self (abs_nonneg a) h1).trans ha
  have hcancel : ∀ (a : ℝ) (k : ℕ), (a ≠ 0 → 0 < k) → (k : ℝ) * (a / k) = a := by
    intro a k h
    by_cases ha : a = 0
    · rw [ha, zero_div, mul_zero]
    · have hk : (k : ℝ) ≠ 0 := by exact_mod_cast (h ha).ne'
      field_simp
  refine ⟨fun hα1 w => ?_, ?_⟩
  · 
    by_cases hex : ∃ I₀ ∈ G, I₀ * 𝔞 = Ideal.span {w}
    · obtain ⟨I₀, hI₀, h0⟩ := hex
      rw [Finset.sum_eq_single_of_mem I₀ hI₀, if_pos h0]
      · exact hdiv _ _ (hα1 I₀)
      · intro I _ hne
        exact if_neg (fun h => hne (mul_right_cancel₀ h𝔞0 (h.trans h0.symm)))
    · rw [Finset.sum_eq_zero, abs_zero]
      · exact zero_le_one
      · intro I hI
        exact if_neg (fun h => hex ⟨I, hI, h⟩)
  · 
    have hpu : ∀ I ∈ G, ∑ w ∈ W, @ite ℝ (I * 𝔞 = Ideal.span {w}) (Classical.propDecidable _)
        (α I / ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun w' => Ideal.span {w'} = I * 𝔞) (fun _ => Classical.propDecidable _) W).card : ℝ)) 0
        = α I := by
      intro I hI
      have e : ∀ w ∈ W, @ite ℝ (I * 𝔞 = Ideal.span {w}) (Classical.propDecidable _)
          (α I / ((@Finset.filter (NumberField.RingOfIntegers K)
            (fun w' => Ideal.span {w'} = I * 𝔞) (fun _ => Classical.propDecidable _) W).card
              : ℝ)) 0
          = @ite ℝ (Ideal.span {w} = I * 𝔞) (Classical.propDecidable _)
          (α I / ((@Finset.filter (NumberField.RingOfIntegers K)
            (fun w' => Ideal.span {w'} = I * 𝔞) (fun _ => Classical.propDecidable _) W).card
              : ℝ)) 0 := by
        intro w _
        by_cases h : I * 𝔞 = Ideal.span {w}
        · rw [if_pos h, if_pos h.symm]
        · rw [if_neg h, if_neg (fun h' => h h'.symm)]
      rw [Finset.sum_congr rfl e, ← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
      apply hcancel
      intro hα
      obtain ⟨w₀, hw₀, hw₀'⟩ := hαW I hI hα
      exact Finset.card_pos.mpr ⟨w₀, Finset.mem_filter.mpr ⟨hw₀, hw₀'⟩⟩
    have hfib' : ∀ w ∈ W, ∀ I ∈ G, ∀ J ∈ G,
        @ite ℝ (I * 𝔞 = Ideal.span {w}) (Classical.propDecidable _)
          (α I / ((@Finset.filter (NumberField.RingOfIntegers K)
            (fun w' => Ideal.span {w'} = I * 𝔞) (fun _ => Classical.propDecidable _) W).card
              : ℝ)) 0 ≠ 0 →
        ∑ x ∈ omegaBox ω M, @ite ℂ (I * J = Ideal.span {x}) (Classical.propDecidable _)
          (giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))) 0
        = ∑ y ∈ omegaBox ω R, @ite ℂ (J * 𝔟 = Ideal.span {y}) (Classical.propDecidable _)
            (@ite ℂ (ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊))
              (Classical.propDecidable _)
              (giE (kaiQuadPoly p₀ (fun l => p₁ l / m) (fun l l' => p₂ l l' / (m : ℝ) ^ 2)
                (ω.equivFun (y * w)))) 0) 0 := by
      intro w hw I _ J _ hc
      have h1 : I * 𝔞 = Ideal.span {w} := by
        by_contra h
        exact hc (if_neg h)
      have hαI : α I ≠ 0 := by
        intro h
        apply hc
        rw [if_pos h1, h, zero_div]
      have hI0 : I ≠ ⊥ := by
        rintro rfl
        exact hαI hα0
      have hw0 : w ≠ 0 := by
        rintro rfl
        have h2 : I * 𝔞 = ⊥ := by rw [h1, Ideal.span_singleton_eq_bot]
        rcases Ideal.mul_eq_bot.mp h2 with h | h
        · exact hI0 h
        · exact h𝔞 h
      exact fib I J w hw0 h1.symm (fun y hy => hR y w hw hy)
    exact main (omegaBox ω M) (omegaBox ω R)
      (fun x => giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)))
      (fun y w => @ite ℂ (ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * ⌊M⌋₊))
              (Classical.propDecidable _)
              (giE (kaiQuadPoly p₀ (fun l => p₁ l / m) (fun l l' => p₂ l l' / (m : ℝ) ^ 2)
                (ω.equivFun (y * w)))) 0)
      (fun I w => @ite ℝ (I * 𝔞 = Ideal.span {w}) (Classical.propDecidable _)
          (α I / ((@Finset.filter (NumberField.RingOfIntegers K)
            (fun w' => Ideal.span {w'} = I * 𝔞) (fun _ => Classical.propDecidable _) W).card
              : ℝ)) 0)
      hpu hfib'

theorem kai_omegaBox_quotient_bound (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (cb s : ℝ) (hcb : 1 ≤ cb) (hs : 0 < s) (m N : ℕ)
    (y w : NumberField.RingOfIntegers K)
    (hw : ∀ v : NumberField.InfinitePlace K, s ≤ cb * v ((w : NumberField.RingOfIntegers K) : K))
    (hyw : ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * N)) :
    y ∈ omegaBox ω (C ^ 2 * cb * m * N / s) :=
by
  have hC0 : 0 < C := by linarith [hω.1]
  have hcb0 : 0 < cb := by linarith
  have hmN : (0 : ℝ) ≤ (m : ℝ) * N := by positivity
  
  have h1 : basisSupNorm ω (y * w) ≤ (m : ℝ) * N := by
    unfold basisSupNorm
    apply Real.iSup_le _ hmN
    intro j
    unfold intBox at hyw
    rw [Finset.mem_Icc] at hyw
    have hl := hyw.1 j
    have hu := hyw.2 j
    simp only [Module.Basis.equivFun_apply] at hl hu
    have hl' := (Int.cast_le (R := ℝ)).mpr hl
    have hu' := (Int.cast_le (R := ℝ)).mpr hu
    push_cast at hl' hu'
    exact abs_le.mpr ⟨hl', hu'⟩
  
  have h2 : ∀ v : NumberField.InfinitePlace K,
      v (algebraMap (NumberField.RingOfIntegers K) K (y * w)) ≤ C * ((m : ℝ) * N) := by
    intro v
    have hle : v (algebraMap (NumberField.RingOfIntegers K) K (y * w))
        ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K (y * w)) := by
      unfold canNorm
      exact le_ciSup (f := fun v' : NumberField.InfinitePlace K =>
        v' (algebraMap (NumberField.RingOfIntegers K) K (y * w))) (Finite.bddAbove_range _) v
    exact hle.trans ((hω.2 (y * w)).2.trans (mul_le_mul_of_nonneg_left h1 hC0.le))
  
  have h4 : ∀ v : NumberField.InfinitePlace K,
      v (algebraMap (NumberField.RingOfIntegers K) K y) ≤ C * cb * m * N / s := by
    intro v
    have h3 : v (algebraMap (NumberField.RingOfIntegers K) K (y * w))
        = v (algebraMap (NumberField.RingOfIntegers K) K y)
          * v ((w : NumberField.RingOfIntegers K) : K) := by
      rw [map_mul (algebraMap (NumberField.RingOfIntegers K) K) y w, map_mul]
    have hvy : 0 ≤ v (algebraMap (NumberField.RingOfIntegers K) K y) := apply_nonneg v _
    rw [le_div_iff₀ hs]
    have e1 := mul_le_mul_of_nonneg_left (hw v) hvy
    have e2 := mul_le_mul_of_nonneg_left (h2 v) hcb0.le
    rw [h3] at e2
    nlinarith
  
  have h5 : canNorm K (algebraMap (NumberField.RingOfIntegers K) K y) ≤ C * cb * m * N / s := by
    unfold canNorm
    exact ciSup_le h4
  
  have h6 : basisSupNorm ω y ≤ C ^ 2 * cb * m * N / s := by
    have h := (hω.2 y).1
    rw [inv_mul_le_iff₀ hC0] at h
    calc basisSupNorm ω y ≤ C * canNorm K (algebraMap (NumberField.RingOfIntegers K) K y) := h
      _ ≤ C * (C * cb * m * N / s) := mul_le_mul_of_nonneg_left h5 hC0.le
      _ = C ^ 2 * cb * m * N / s := by ring
  
  have hk : ∀ j, |ω.repr y j| ≤ ((⌊C ^ 2 * cb * m * N / s⌋₊ : ℕ) : ℤ) := by
    intro j
    have hj : |(ω.repr y j : ℝ)| ≤ C ^ 2 * cb * m * N / s :=
      (le_ciSup (f := fun j => |(ω.repr y j : ℝ)|) (Finite.bddAbove_range _) j).trans h6
    have hcast : (((ω.repr y j).natAbs : ℕ) : ℝ) = |(ω.repr y j : ℝ)| := by
      rw [Nat.cast_natAbs, Int.cast_abs]
    have hn : (ω.repr y j).natAbs ≤ ⌊C ^ 2 * cb * m * N / s⌋₊ :=
      Nat.le_floor (by rw [hcast]; exact hj)
    rw [Int.abs_eq_natAbs]
    exact_mod_cast hn
  
  have hmem : ω.equivFun y ∈ intBox (Module.finrank ℚ K) ⌊C ^ 2 * cb * m * N / s⌋₊ := by
    unfold intBox
    rw [Finset.mem_Icc]
    refine ⟨Pi.le_def.mpr fun j => ?_, Pi.le_def.mpr fun j => ?_⟩
    · simp only [Module.Basis.equivFun_apply]
      exact (abs_le.mp (hk j)).1
    · simp only [Module.Basis.equivFun_apply]
      exact (abs_le.mp (hk j)).2
  unfold omegaBox
  rw [@Finset.mem_image _ _ (fun a b => Classical.propDecidable (a = b))]
  exact ⟨ω.equivFun y, hmem, ω.equivFun.symm_apply_apply y⟩

theorem kai_typeII_label_pigeonhole (K : Type u) [Field K] [NumberField K] {ι : Type*}
    (Λ : Finset ι) (hΛ : Λ.Nonempty) (χ : Ideal (NumberField.RingOfIntegers K) → ι)
    (B : Finset (NumberField.RingOfIntegers K)) (X : ℕ)
    (a b : Ideal (NumberField.RingOfIntegers K) → ℝ) (f : NumberField.RingOfIntegers K → ℂ) (t : ℝ)
    (hχ : ∀ x ∈ B, ∀ I J : Ideal (NumberField.RingOfIntegers K),
      I * J = Ideal.span {x} → a I * b J ≠ 0 → χ I ∈ Λ)
    (ht : t ≤ ‖∑ x ∈ B,
        ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
            ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (a I * b J) 0 : ℝ) : ℂ)
              * f x‖) :
    ∃ l₀ ∈ Λ, t / (Λ.card : ℝ) ≤ ‖∑ x ∈ B,
        ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
            ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                ((@ite ℝ (χ I = l₀) (Classical.propDecidable _) (a I) 0) * b J) 0 : ℝ) : ℂ)
              * f x‖ :=
by
  set F := (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset
    with hF
  have hdecomp : ∀ x ∈ B, ∀ I J : Ideal (NumberField.RingOfIntegers K),
      ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (a I * b J) 0 : ℝ) : ℂ)
          * f x
        = ∑ l ∈ Λ, ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                ((@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J) 0 : ℝ) : ℂ)
              * f x := by
    intro x hx I J
    by_cases hIJ : I * J = Ideal.span {x}
    · rw [if_pos hIJ]
      have hterm : ∀ l, (@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
          ((@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J) 0)
            = (@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J :=
        fun l => if_pos hIJ
      simp only [hterm]
      by_cases hmem : χ I ∈ Λ
      · rw [Finset.sum_eq_single_of_mem (χ I) hmem]
        · rw [if_pos rfl]
        · intro l _ hl
          rw [if_neg (Ne.symm hl), zero_mul, Complex.ofReal_zero, zero_mul]
      · have h0 : a I * b J = 0 := by
          by_contra h
          exact hmem (hχ x hx I J hIJ h)
        rw [h0, Complex.ofReal_zero, zero_mul]
        symm
        apply Finset.sum_eq_zero
        intro l hl
        have hne : χ I ≠ l := fun h => hmem (h ▸ hl)
        rw [if_neg hne, zero_mul, Complex.ofReal_zero, zero_mul]
    · rw [if_neg hIJ, Complex.ofReal_zero, zero_mul]
      symm
      apply Finset.sum_eq_zero
      intro l _
      rw [if_neg hIJ, Complex.ofReal_zero, zero_mul]
  have hS : (∑ x ∈ B, ∑ I ∈ F, ∑ J ∈ F,
      ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (a I * b J) 0 : ℝ) : ℂ)
          * f x)
      = ∑ l ∈ Λ, ∑ x ∈ B, ∑ I ∈ F, ∑ J ∈ F,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                ((@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J) 0 : ℝ) : ℂ)
              * f x := by
    calc (∑ x ∈ B, ∑ I ∈ F, ∑ J ∈ F,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (a I * b J) 0 : ℝ) : ℂ)
            * f x)
        = ∑ x ∈ B, ∑ I ∈ F, ∑ J ∈ F, ∑ l ∈ Λ,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                ((@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J) 0 : ℝ) : ℂ)
              * f x :=
          Finset.sum_congr rfl (fun x hx => Finset.sum_congr rfl
            (fun I _ => Finset.sum_congr rfl (fun J _ => hdecomp x hx I J)))
      _ = ∑ x ∈ B, ∑ I ∈ F, ∑ l ∈ Λ, ∑ J ∈ F,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                ((@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J) 0 : ℝ) : ℂ)
              * f x :=
          Finset.sum_congr rfl (fun x _ => Finset.sum_congr rfl (fun I _ => Finset.sum_comm))
      _ = ∑ x ∈ B, ∑ l ∈ Λ, ∑ I ∈ F, ∑ J ∈ F,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                ((@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J) 0 : ℝ) : ℂ)
              * f x :=
          Finset.sum_congr rfl (fun x _ => Finset.sum_comm)
      _ = _ := Finset.sum_comm
  have hcard : (Λ.card : ℝ) ≠ 0 := by
    have := Finset.card_pos.mpr hΛ
    exact_mod_cast this.ne'
  have hle : ∑ _l ∈ Λ, t / (Λ.card : ℝ) ≤ ∑ l ∈ Λ, ‖∑ x ∈ B, ∑ I ∈ F, ∑ J ∈ F,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                ((@ite ℝ (χ I = l) (Classical.propDecidable _) (a I) 0) * b J) 0 : ℝ) : ℂ)
              * f x‖ := by
    rw [Finset.sum_const, nsmul_eq_mul, mul_div_cancel₀ _ hcard]
    refine ht.trans ?_
    rw [hS]
    exact norm_sum_le _ _
  exact Finset.exists_le_of_sum_le hΛ hle

theorem kai_typeII_constants (n Ab : ℕ) (κ C mmax : ℝ) (hn : 1 ≤ n) (hAb : 1 ≤ Ab)
    (hκ : 1 ≤ κ) (hC : 1 ≤ C) (hm : 1 ≤ mmax) :
    ∃ (CII : ℝ) (AII : ℕ), 1 ≤ CII ∧ 1 ≤ AII ∧
      ∀ (ℓ G θ m : ℝ), 1 ≤ ℓ → 1 ≤ G → 0 < θ → θ ≤ 1 → 1 ≤ m → m ≤ mmax →
        (κ * m * ℓ ^ (n + 1) * G / θ) ^ Ab ≤ (CII * G * ℓ / θ) ^ AII ∧
        2 * ((κ * m * ℓ ^ (n + 1) * G / θ) ^ Ab) ^ n ≤ (CII * G * ℓ / θ) ^ AII ∧
        (2 * C) ^ n * m * ((κ * m * ℓ ^ (n + 1) * G / θ) ^ Ab) ^ n ≤ (CII * G * ℓ / θ) ^ AII :=
by
  have hC2 : (1:ℝ) ≤ 2 * C := by linarith
  have h2Cn : (1:ℝ) ≤ (2 * C) ^ n := one_le_pow₀ hC2
  have hK₀ : (1:ℝ) ≤ κ * mmax := one_le_mul_of_one_le_of_one_le hκ hm
  have hD : (1:ℝ) ≤ (2 * C) ^ n * mmax := one_le_mul_of_one_le_of_one_le h2Cn hm
  have hn0 : n ≠ 0 := by omega
  have hAIIpos : 0 < n * (n + 1) * Ab := by positivity
  have hAII : 1 ≤ n * (n + 1) * Ab := hAIIpos
  have hAII0 : n * (n + 1) * Ab ≠ 0 := by omega
  refine ⟨(2 * C) ^ n * mmax ^ 2 * κ, n * (n + 1) * Ab, ?_, hAII, ?_⟩
  · have e : (2 * C) ^ n * mmax ^ 2 * κ = ((2 * C) ^ n * mmax) * (κ * mmax) := by ring
    rw [e]; exact one_le_mul_of_one_le_of_one_le hD hK₀
  intro ℓ G θ m hℓ hG hθ hθ1 hm1 hmM
  obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = G * ℓ / θ := ⟨_, rfl⟩
  have hℓ0 : (0:ℝ) ≤ ℓ := by linarith
  have hGℓ : ℓ ≤ G * ℓ := le_mul_of_one_le_left hℓ0 hG
  have hGℓθ : G * ℓ ≤ G * ℓ / θ := by
    rw [le_div_iff₀ hθ]
    exact mul_le_of_le_one_right (by positivity) hθ1
  have hℓZ : ℓ ≤ Z := by rw [hZ]; linarith
  have hZ1 : 1 ≤ Z := by linarith
  have hZ0 : 0 ≤ Z := by linarith
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = κ * m * ℓ ^ (n + 1) * G / θ := ⟨_, rfl⟩
  have hbid : b = (κ * m) * ℓ ^ n * Z := by rw [hb, hZ]; ring
  have hκm : 1 ≤ κ * m := one_le_mul_of_one_le_of_one_le hκ hm1
  have hℓn : 1 ≤ ℓ ^ n := one_le_pow₀ hℓ
  have hb1 : 1 ≤ b := by
    rw [hbid]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hκm hℓn) hZ1
  have hb0 : 0 ≤ b := by linarith
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = κ * mmax * Z := ⟨_, rfl⟩
  have hW1 : 1 ≤ W := by rw [hW]; exact one_le_mul_of_one_le_of_one_le hK₀ hZ1
  have hW0 : 0 ≤ W := by linarith
  have hbW : b ≤ W ^ (n + 1) := by
    have h1 : κ * m ≤ κ * mmax := mul_le_mul_of_nonneg_left hmM (by linarith)
    have h2 : ℓ ^ n ≤ Z ^ n := pow_le_pow_left₀ hℓ0 hℓZ n
    have h3 : κ * mmax ≤ (κ * mmax) ^ (n + 1) := le_self_pow₀ hK₀ (by omega)
    calc b = (κ * m) * ℓ ^ n * Z := hbid
      _ ≤ (κ * mmax) * Z ^ n * Z := by
          apply mul_le_mul_of_nonneg_right _ hZ0
          exact mul_le_mul h1 h2 (by positivity) (by linarith)
      _ = (κ * mmax) * Z ^ (n + 1) := by ring
      _ ≤ (κ * mmax) ^ (n + 1) * Z ^ (n + 1) :=
          mul_le_mul_of_nonneg_right h3 (by positivity)
      _ = W ^ (n + 1) := by rw [hW]; ring
  obtain ⟨t, ht⟩ : ∃ t : ℝ, t = b ^ Ab := ⟨_, rfl⟩
  have ht1 : 1 ≤ t := by rw [ht]; exact one_le_pow₀ hb1
  have ht0 : 0 ≤ t := by linarith
  have htn0 : 0 ≤ t ^ n := by positivity
  have htW : t ^ n ≤ W ^ (n * (n + 1) * Ab) := by
    have h1 : t ≤ (W ^ (n + 1)) ^ Ab := by rw [ht]; exact pow_le_pow_left₀ hb0 hbW Ab
    have h2 : t ^ n ≤ ((W ^ (n + 1)) ^ Ab) ^ n := pow_le_pow_left₀ ht0 h1 n
    have h3 : ((W ^ (n + 1)) ^ Ab) ^ n = W ^ (n * (n + 1) * Ab) := by
      rw [← pow_mul, ← pow_mul]; congr 1; ring
    linarith
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = (2 * C) ^ n * mmax := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by rw [hDdef]; exact hD
  have hRHS : (2 * C) ^ n * mmax ^ 2 * κ * G * ℓ / θ = D * W := by
    rw [hDdef, hW, hZ]; ring
  rw [← hb, ← ht, hRHS]
  have hK3 : (2 * C) ^ n * m * t ^ n ≤ (D * W) ^ (n * (n + 1) * Ab) := by
    have h1 : (2 * C) ^ n * m * t ^ n ≤ D * t ^ n := by
      rw [hDdef]
      apply mul_le_mul_of_nonneg_right _ htn0
      exact mul_le_mul_of_nonneg_left hmM (by positivity)
    have h2 : D * t ^ n ≤ D * W ^ (n * (n + 1) * Ab) :=
      mul_le_mul_of_nonneg_left htW (by linarith)
    have h3 : D * W ^ (n * (n + 1) * Ab) ≤ D ^ (n * (n + 1) * Ab) * W ^ (n * (n + 1) * Ab) :=
      mul_le_mul_of_nonneg_right (le_self_pow₀ hD1 hAII0) (by positivity)
    have h4 : (D * W) ^ (n * (n + 1) * Ab) = D ^ (n * (n + 1) * Ab) * W ^ (n * (n + 1) * Ab) :=
      mul_pow D W _
    linarith
  have hK2 : 2 * t ^ n ≤ (D * W) ^ (n * (n + 1) * Ab) := by
    have h1 : 2 ≤ (2 * C) ^ n * m := by
      have a1 : 2 * C ≤ (2 * C) ^ n := le_self_pow₀ hC2 hn0
      have a2 : (2 * C) ^ n ≤ (2 * C) ^ n * m := le_mul_of_one_le_right (by positivity) hm1
      linarith
    have := mul_le_mul_of_nonneg_right h1 htn0
    linarith
  have hK1 : t ≤ (D * W) ^ (n * (n + 1) * Ab) := by
    have : t ≤ t ^ n := le_self_pow₀ ht1 hn0
    linarith
  exact ⟨hK1, hK2, hK3⟩

theorem kai_quad_typeII_inverse (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ (CII : ℝ) (AII : ℕ), 1 ≤ CII ∧ 1 ≤ AII ∧
      ∀ (M θ G : ℝ) (U V X : ℕ) (a b : Ideal (NumberField.RingOfIntegers K) → ℝ),
        3 ≤ M → 0 < θ → θ ≤ 1 → 1 ≤ G → 1 ≤ X →
        (∀ I, |a I| ≤ 1) → (∀ I, Ideal.absNorm I ≤ V → a I = 0) →
        (∀ I, Ideal.absNorm I ≤ U → b I = 0) →
        (∀ Y : ℕ, 1 ≤ Y → Y ≤ X →
          ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset,
            (b I) ^ 2 ≤ G * (Y : ℝ)) →
        (CII * G * Real.log M / θ) ^ AII ≤ (U : ℝ) →
        (CII * G * Real.log M / θ) ^ AII ≤ (V : ℝ) →
      ∀ (p₀ : ℝ) (p₁ : Fin (Module.finrank ℚ K) → ℝ)
        (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
        θ * ((omegaBox ω M).card : ℝ) ≤
          ‖∑ x ∈ omegaBox ω M,
              ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
                ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
                  ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
                      (a I * b J) 0 : ℝ) : ℂ)
                    * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ →
        ∃ q : ℕ, (q : ℝ) ≤ (CII * G * Real.log M / θ) ^ AII ∧
          KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q
            ((CII * G * Real.log M / θ) ^ AII) (kaiQuadPoly p₀ p₁ p₂) :=
by
  classical
  have hC1 : 1 < C := hω.1
  have hC0 : 0 < C := by linarith
  have hn0 : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hn0' : Module.finrank ℚ K ≠ 0 := hn0.ne'
  obtain ⟨ι, hιne, hιprop, hιcov⟩ := kai_ideal_class_reps K
  obtain ⟨cb, hcb, hgen⟩ := kai_typeII_generator_set K
  have hcb0 : 0 < cb := by linarith
  obtain ⟨Cb, Ab, hCb, hAb, hbil⟩ := kai_quad_bilinear_inverse K C ω hω cb hcb
  obtain ⟨A₂, hA₂, hl2⟩ := kai_typeII_l2_transfer K C ω hω
  obtain ⟨𝔞₀, h𝔞₀⟩ := hιne
  obtain ⟨mmax, hmmax⟩ : ∃ r : ℝ, r = ∑ 𝔞 ∈ ι, (Ideal.absNorm 𝔞 : ℝ) := ⟨_, rfl⟩
  have hm_le : ∀ 𝔞 ∈ ι, (Ideal.absNorm 𝔞 : ℝ) ≤ mmax := fun 𝔞 h𝔞 => by
    rw [hmmax]
    exact Finset.single_le_sum (f := fun 𝔞 => (Ideal.absNorm 𝔞 : ℝ))
      (fun i _ => Nat.cast_nonneg _) h𝔞
  have hmmax1 : 1 ≤ mmax := by
    have h1 : (1 : ℝ) ≤ (Ideal.absNorm 𝔞₀ : ℝ) := by exact_mod_cast (hιprop 𝔞₀ h𝔞₀).2.1
    exact h1.trans (hm_le 𝔞₀ h𝔞₀)
  have hmmax0 : 0 < mmax := by linarith
  have hC2 : 1 ≤ C ^ 2 := one_le_pow₀ hC1.le
  have hCcb : 1 ≤ C ^ 2 * cb := one_le_mul_of_one_le_of_one_le hC2 hcb
  obtain ⟨lam1, hlam1⟩ : ∃ r : ℝ, r = Real.log (C ^ 2 * cb * mmax) := ⟨_, rfl⟩
  have hlam1_0 : 0 ≤ lam1 := by
    rw [hlam1]; exact Real.log_nonneg (one_le_mul_of_one_le_of_one_le hCcb hmmax1)
  have hlogC : 0 < Real.log C := Real.log_pos hC1
  obtain ⟨κ₂, hκ₂⟩ : ∃ r : ℝ, r = 1 + 2 * (Module.finrank ℚ K : ℝ) * (1 + Real.log C) :=
    ⟨_, rfl⟩
  have hκ₂1 : 1 ≤ κ₂ := by
    rw [hκ₂]
    have : 0 ≤ 2 * (Module.finrank ℚ K : ℝ) * (1 + Real.log C) := by positivity
    linarith
  have hιcard : (1 : ℝ) ≤ (ι.card : ℝ) := by
    exact_mod_cast Finset.card_pos.2 ⟨𝔞₀, h𝔞₀⟩
  have h2lam : 1 ≤ (2 + lam1) ^ Module.finrank ℚ K := one_le_pow₀ (by linarith)
  obtain ⟨κ, hκ⟩ : ∃ r : ℝ,
      r = Cb * A₂ * (2 + lam1) ^ Module.finrank ℚ K * κ₂ * (ι.card : ℝ) := ⟨_, rfl⟩
  have hκ1 : 1 ≤ κ := by
    rw [hκ]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
      (one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hCb hA₂) h2lam) hκ₂1)
      hιcard
  obtain ⟨CII, AII, hCII, hAII, hconst⟩ :=
    kai_typeII_constants (Module.finrank ℚ K) Ab κ C mmax hn0 hAb hκ1 hC1.le hmmax1
  refine ⟨CII, AII, hCII, hAII, ?_⟩
  intro M θ G U V X a b hM hθ hθ1 hG hX ha1 haV hbU hbL2 hΨU hΨV p₀ p₁ p₂ hS
  
  have hMpos : 0 < M := by linarith
  obtain ⟨ℓ, hℓ⟩ : ∃ r : ℝ, r = Real.log M := ⟨_, rfl⟩
  rw [← hℓ] at hΨU hΨV ⊢
  have hℓ1 : 1 ≤ ℓ := by
    rw [hℓ, Real.le_log_iff_exp_le hMpos]; have := Real.exp_one_lt_d9; linarith
  have hℓ0 : 0 < ℓ := by linarith
  have hN3 : 3 ≤ ⌊M⌋₊ := Nat.le_floor (by exact_mod_cast hM)
  have hN1 : 1 ≤ ⌊M⌋₊ := by omega
  have hNM : (⌊M⌋₊ : ℝ) ≤ M := Nat.floor_le hMpos.le
  have hM2N : M ≤ 2 * (⌊M⌋₊ : ℝ) := by
    have h1 := Nat.lt_floor_add_one M
    have h2 : (1 : ℝ) ≤ (⌊M⌋₊ : ℝ) := by exact_mod_cast hN1
    linarith
  have hcardB := kai_omegaBox_card ω M
  obtain ⟨Ψ, hΨ⟩ : ∃ r : ℝ, r = (CII * G * ℓ / θ) ^ AII := ⟨_, rfl⟩
  rw [← hΨ] at hΨU hΨV ⊢
  have hΨ1 : 1 ≤ Ψ := by
    rw [hΨ]; apply one_le_pow₀
    rw [one_le_div hθ]
    have : 1 ≤ CII * G * ℓ :=
      one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hCII hG) hℓ1
    linarith
  have hU1 : (1 : ℝ) ≤ U := hΨ1.trans hΨU
  have ha_bot : a ⊥ = 0 := haV ⊥ (by rw [Ideal.absNorm_bot]; exact Nat.zero_le _)
  have hb_bot : b ⊥ = 0 := hbU ⊥ (by rw [Ideal.absNorm_bot]; exact Nat.zero_le _)
  
  have hmono : ∀ (q : ℕ) (T T' : ℝ), T ≤ T' →
      KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q T (kaiQuadPoly p₀ p₁ p₂) →
      KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q T' (kaiQuadPoly p₀ p₁ p₂) := by
    rintro q T T' hTT' ⟨hq1, γ, b', a', η, θ', hη, hθ', hP⟩
    exact ⟨hq1, γ, b', a', η, θ',
      fun l => (hη l).trans (div_le_div_of_nonneg_right hTT' (by positivity)),
      fun l l' => (hθ' l l').trans (div_le_div_of_nonneg_right hTT' (by positivity)), hP⟩
  
  obtain ⟨cls, hcls⟩ : ∃ cls : Ideal (NumberField.RingOfIntegers K) →
      Ideal (NumberField.RingOfIntegers K),
      ∀ I, I ≠ ⊥ → cls I ∈ ι ∧ Submodule.IsPrincipal (I * cls I) := by
    refine ⟨fun I => if hI : ∃ 𝔞 ∈ ι, Submodule.IsPrincipal (I * 𝔞)
      then Classical.choose hI else 𝔞₀, fun I hI => ?_⟩
    have hex := hιcov I hI
    simp only [dif_pos hex]
    exact Classical.choose_spec hex
  obtain ⟨χ, hχ⟩ : ∃ χ : Ideal (NumberField.RingOfIntegers K) →
      ℕ × Ideal (NumberField.RingOfIntegers K),
      ∀ I, χ I = (Nat.log 2 (Ideal.absNorm I), cls I) := ⟨_, fun _ => rfl⟩
  obtain ⟨K₀, hK₀⟩ : ∃ k : ℕ, k = Nat.log 2 ⌊(C * M) ^ Module.finrank ℚ K⌋₊ := ⟨_, rfl⟩
  obtain ⟨Λ, hΛ⟩ : ∃ L : Finset (ℕ × Ideal (NumberField.RingOfIntegers K)),
      L = Finset.range (K₀ + 1) ×ˢ ι := ⟨_, rfl⟩
  have hΛne : Λ.Nonempty :=
    ⟨(0, 𝔞₀), by rw [hΛ, Finset.mem_product]; exact ⟨by simp, h𝔞₀⟩⟩
  have hΛcard : (Λ.card : ℝ) = ((K₀ : ℝ) + 1) * (ι.card : ℝ) := by
    rw [hΛ, Finset.card_product, Finset.card_range]; push_cast; ring
  have hCM1 : 1 ≤ C * M := by nlinarith
  have hCMn1 : 1 ≤ (C * M) ^ Module.finrank ℚ K := one_le_pow₀ hCM1
  have hnorm_le : ∀ x ∈ omegaBox ω M, ∀ I J : Ideal (NumberField.RingOfIntegers K),
      I * J = Ideal.span {x} →
