theorem gi_bohr_card_two_mul_le (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (r : ℝ) (hr : 0 < r) :
    (giBohr P S (2 * r)).card ≤ 4 ^ S.card * (giBohr P S r).card :=
by
  classical
  have hPpos : (0 : ℝ) < P := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne P)
  have mem_iff : ∀ (ρ : ℝ) (x : ZMod P),
      x ∈ giBohr P S ρ ↔ ∀ ξ ∈ S, giCircNorm P (ξ * x) < ρ := by
    intro ρ x
    unfold giBohr
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  
  have ht01 : ∀ k : ZMod P, 0 ≤ (k.val : ℝ) / P ∧ (k.val : ℝ) / P < 1 := by
    intro k
    refine ⟨div_nonneg (Nat.cast_nonneg _) hPpos.le, ?_⟩
    rw [div_lt_one hPpos]
    exact_mod_cast ZMod.val_lt k
  
  have hgen : ∀ (z : ZMod P) (n : ℤ), giCircNorm P z ≤ |(z.val : ℝ) / P - n| := by
    intro z n
    obtain ⟨h0, h1⟩ := ht01 z
    unfold giCircNorm
    by_cases hn : n ≤ 0
    · have hn' : (n : ℝ) ≤ 0 := by exact_mod_cast hn
      calc min ((z.val : ℝ) / P) (1 - (z.val : ℝ) / P) ≤ (z.val : ℝ) / P := min_le_left _ _
        _ ≤ (z.val : ℝ) / P - n := by linarith
        _ ≤ |(z.val : ℝ) / P - n| := le_abs_self _
    · have hn1 : (1 : ℤ) ≤ n := by omega
      have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn1
      calc min ((z.val : ℝ) / P) (1 - (z.val : ℝ) / P) ≤ 1 - (z.val : ℝ) / P := min_le_right _ _
        _ ≤ -((z.val : ℝ) / P - n) := by linarith
        _ ≤ |(z.val : ℝ) / P - n| := neg_le_abs _
  
  obtain ⟨sg, hsg1, hsg2⟩ : ∃ sg : ZMod P → ℝ, (∀ k, giCircNorm P k = |sg k|) ∧
      (∀ k, ∃ m : ℤ, sg k = (k.val : ℝ) / P - m) := by
    refine ⟨fun k => (k.val : ℝ) / P - ((if (k.val : ℝ) / P ≤ 1 / 2 then 0 else 1 : ℤ) : ℝ),
      ?_, fun k => ⟨_, rfl⟩⟩
    intro k
    obtain ⟨h0, h1⟩ := ht01 k
    unfold giCircNorm
    beta_reduce
    split_ifs with h
    · rw [min_eq_left (by linarith), Int.cast_zero, sub_zero, abs_of_nonneg h0]
    · push_neg at h
      rw [min_eq_right (by linarith), Int.cast_one, abs_of_neg (by linarith)]
      ring
  
  have hvsub : ∀ a b : ZMod P, ∃ e : ℤ,
      ((a - b).val : ℝ) / P = (a.val : ℝ) / P - (b.val : ℝ) / P + e := by
    intro a b
    have hz : ((((a - b).val : ℤ) - (a.val : ℤ) + (b.val : ℤ) : ℤ) : ZMod P) = 0 := by
      push_cast
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      ring
    obtain ⟨e, he⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ P).1 hz
    refine ⟨e, ?_⟩
    have he' : ((a - b).val : ℝ) = (a.val : ℝ) - (b.val : ℝ) + (P : ℝ) * e := by
      have : (((a - b).val : ℤ) : ℝ) - ((a.val : ℤ) : ℝ) + ((b.val : ℤ) : ℝ)
