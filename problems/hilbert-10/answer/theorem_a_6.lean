theorem kai_hecke_logderiv_bound_gen (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hL : KaiZFLandauExpProp) (hcont : KaiZFZetaContProp K)
    (hser : KaiZFSeriesBasicsProp K) (hgen : KaiZFGenCharProp K) :
    ∀ B : ℝ, 0 < B → B ≤ 1 → ∃ C : ℝ, 0 < C ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (t : NumberField.InfinitePlace K → ℝ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q t l ξ η lam →
        (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
        ∀ (E : ℕ) (G : ℂ → ℂ), E ≤ 1 → (E = 1 ↔ KaiHeckePrincipal K q lam) →
          Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) →
          ∀ (m : ℕ) (β₀ : ℝ), m ≤ 1 → 0 ≤ β₀ → β₀ < 1 →
            (m = 1 → G (β₀ : ℂ) = 0 ∧ deriv G (β₀ : ℂ) ≠ 0) →
            (∀ s : ℂ, s.re ≤ 2 →
                1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
                  * (2 + |s.im|)) ≤ s.re →
                G s = 0 → m = 1 ∧ s = (β₀ : ℂ)) →
            ∀ s : ℂ, s.re ≤ 2 →
              1 - B / (4 * Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
                * (2 + |s.im|))) ≤ s.re →
              ‖deriv G s / G s - (m : ℂ) / (s - (β₀ : ℂ))‖
                ≤ C * Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
                  * (2 + |s.im|)) :=
by
  
  have hshiftA : ∀ (Z : Finset ℂ) (mult : ℂ → ℕ) (s s₁ : ℂ) (d e h W κ₁ κ₂ : ℝ),
      0 < d → 0 < e → 0 ≤ W → 0 ≤ κ₁ → 0 ≤ κ₂ →
      ‖s - s₁‖ ≤ h → h ≤ κ₁ * d → h ≤ κ₂ * e →
      (∀ ρ ∈ Z, d ≤ (s₁ - ρ).re) → (∀ ρ ∈ Z, e ≤ ‖s - ρ‖) →
      ‖∑ ρ ∈ Z, (mult ρ : ℂ) / (s₁ - ρ)‖ ≤ W →
      ‖∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ)‖ ≤ W * (1 + κ₁ * (1 + κ₂)) := by
    clear hL hcont hser hgen
    intro Z mult s s₁ d e h W κ₁ κ₂ hd he hW hκ₁ hκ₂ hss hhd hhe hre hsep hcen
    obtain ⟨δ, hδ_def⟩ : ∃ δ : ℝ, δ = ‖s₁ - s‖ := ⟨_, rfl⟩
    have hδh : δ ≤ h := by rw [hδ_def, norm_sub_rev]; exact hss
    have hδ0 : 0 ≤ δ := by rw [hδ_def]; exact norm_nonneg _
    obtain ⟨k, hk_def⟩ : ∃ k : ℝ, k = 1 + κ₂ := ⟨_, rfl⟩
    have hk0 : 0 ≤ k := by rw [hk_def]; linarith
    have hb_norm : ∀ ρ ∈ Z, d ≤ ‖s₁ - ρ‖ :=
      fun ρ hρ => (hre ρ hρ).trans (Complex.re_le_norm _)
    have hdiff : ∀ ρ : ℂ, s₁ - ρ = (s - ρ) + (s₁ - s) := by intro ρ; ring
    have hratio : ∀ ρ ∈ Z, ‖s₁ - ρ‖ ≤ k * ‖s - ρ‖ := by
      intro ρ hρ
      have htri : ‖s₁ - ρ‖ ≤ ‖s - ρ‖ + δ := by
        rw [hdiff ρ, hδ_def]; exact norm_add_le _ _
      have ha := hsep ρ hρ
      have h0 := hδh.trans hhe
      have h1 : κ₂ * e ≤ κ₂ * ‖s - ρ‖ := mul_le_mul_of_nonneg_left ha hκ₂
      have h2 : k * ‖s - ρ‖ = ‖s - ρ‖ + κ₂ * ‖s - ρ‖ := by rw [hk_def]; ring
      linarith
    have hS : d * ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2 ≤ W := by
      have hterm : ∀ ρ ∈ Z, d * ((mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2)
          ≤ ((mult ρ : ℂ) / (s₁ - ρ)).re := by
        intro ρ hρ
        have hbpos : 0 < ‖s₁ - ρ‖ := lt_of_lt_of_le hd (hb_norm ρ hρ)
        rw [Complex.div_re, Complex.natCast_re, Complex.natCast_im, zero_mul, zero_div, add_zero,
          Complex.normSq_eq_norm_sq]
        rw [mul_div_assoc', div_le_div_iff_of_pos_right (by positivity)]
        have := hre ρ hρ
        have hm : (0 : ℝ) ≤ (mult ρ : ℝ) := Nat.cast_nonneg _
        nlinarith
      calc d * ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2
          = ∑ ρ ∈ Z, d * ((mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2) := Finset.mul_sum _ _ _
        _ ≤ ∑ ρ ∈ Z, ((mult ρ : ℂ) / (s₁ - ρ)).re := Finset.sum_le_sum hterm
        _ = (∑ ρ ∈ Z, (mult ρ : ℂ) / (s₁ - ρ)).re := (Complex.re_sum _ _).symm
        _ ≤ ‖∑ ρ ∈ Z, (mult ρ : ℂ) / (s₁ - ρ)‖ := Complex.re_le_norm _
        _ ≤ W := hcen
    have hid : ∀ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ)
        = (mult ρ : ℂ) / (s₁ - ρ) + (s₁ - s) * ((mult ρ : ℂ) / ((s - ρ) * (s₁ - ρ))) := by
      intro ρ hρ
      have ha : s - ρ ≠ 0 := by
        intro h0; have := hsep ρ hρ; rw [h0, norm_zero] at this; linarith
      have hb : s₁ - ρ ≠ 0 := by
        intro h0; have := hb_norm ρ hρ; rw [h0, norm_zero] at this; linarith
      rw [mul_div_assoc', div_add_div _ _ hb (mul_ne_zero ha hb), div_eq_div_iff ha
        (mul_ne_zero hb (mul_ne_zero ha hb))]
      ring
    have hterm2 : ∀ ρ ∈ Z, ‖(mult ρ : ℂ) / ((s - ρ) * (s₁ - ρ))‖
        ≤ k * ((mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2) := by
      intro ρ hρ
      have hbpos : 0 < ‖s₁ - ρ‖ := lt_of_lt_of_le hd (hb_norm ρ hρ)
      have hapos : 0 < ‖s - ρ‖ := lt_of_lt_of_le he (hsep ρ hρ)
      have hr := hratio ρ hρ
      have hm : (0 : ℝ) ≤ (mult ρ : ℝ) := Nat.cast_nonneg _
      rw [norm_div, norm_mul, Complex.norm_natCast, mul_div_assoc',
        div_le_div_iff₀ (by positivity) (by positivity)]
      have := mul_nonneg (mul_nonneg hm hbpos.le) (sub_nonneg.2 hr)
      nlinarith
    rw [Finset.sum_congr rfl hid, Finset.sum_add_distrib, ← Finset.mul_sum]
    have hsum2 : ‖∑ ρ ∈ Z, (mult ρ : ℂ) / ((s - ρ) * (s₁ - ρ))‖
        ≤ k * ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2 := by
      rw [Finset.mul_sum]
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum hterm2)
    have hS0 : 0 ≤ ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2 :=
      Finset.sum_nonneg (fun ρ _ => by positivity)
    refine (norm_add_le _ _).trans ?_
    rw [norm_mul, ← hδ_def]
    have h1 : δ * ‖∑ ρ ∈ Z, (mult ρ : ℂ) / ((s - ρ) * (s₁ - ρ))‖
        ≤ (κ₁ * d) * (k * ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2) :=
      mul_le_mul (hδh.trans hhd) hsum2 (norm_nonneg _) (mul_nonneg hκ₁ hd.le)
    have h2 : (κ₁ * d) * (k * ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2) ≤ κ₁ * k * W := by
      have e1 : (κ₁ * d) * (k * ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2)
          = κ₁ * k * (d * ∑ ρ ∈ Z, (mult ρ : ℝ) / ‖s₁ - ρ‖ ^ 2) := by ring
      rw [e1]; exact mul_le_mul_of_nonneg_left hS (mul_nonneg hκ₁ hk0)
    have h3 : W * (1 + κ₁ * (1 + κ₂)) = W + κ₁ * k * W := by rw [hk_def]; ring
    rw [h3]
    linarith
  
  have hland : ∃ CL : ℝ, 0 < CL ∧
      ∀ (n : ℕ) (A L : ℝ) (G : ℂ → ℂ) (s₁ : ℂ),
        1 ≤ A → 1 ≤ L → Differentiable ℂ G →
        (∀ z ∈ Metric.closedBall s₁ 1, ∃ X : ℝ, 0 ≤ X ∧ X ≤ 3 / 2 * Real.exp L ∧
            ‖G z‖ ≤ A * X ^ A) →
        G s₁ ≠ 0 →
        1 ≤ ‖G s₁‖ * (1 + 8 * L) ^ (n + 1) →
        ∃ (Z : Finset ℂ) (mult : ℂ → ℕ),
          (∀ ρ ∈ Z, ρ ∈ Metric.closedBall s₁ (1 / 2) ∧ G ρ = 0 ∧ 1 ≤ mult ρ) ∧
          (∀ ρ : ℂ, ρ ∈ Metric.closedBall s₁ (1 / 2) → G ρ = 0 → ρ ∈ Z) ∧
          (∀ ρ ∈ Z, deriv G ρ ≠ 0 → mult ρ = 1) ∧
          (∀ s ∈ Metric.closedBall s₁ (1 / 4), G s ≠ 0 →
            ‖deriv G s / G s - ∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ)‖
              ≤ CL * (2 * A + (n : ℝ) + 1 + Real.log A + ((n : ℝ) + 1) * Real.log 16) * L) := by
    clear hshiftA hcont hser hgen
    obtain ⟨CL, hCL, hLan⟩ := hL
    refine ⟨CL, hCL, ?_⟩
    intro n A L G s₁ hA hL1 hG hgrowth hG1 hlow
    obtain ⟨A₂, hA₂_def⟩ : ∃ A₂ : ℝ,
        A₂ = 2 * A + (n : ℝ) + 1 + Real.log A + ((n : ℝ) + 1) * Real.log 16 := ⟨_, rfl⟩
    have hlogA : 0 ≤ Real.log A := Real.log_nonneg hA
    have hlog16 : 0 ≤ Real.log 16 := Real.log_nonneg (by norm_num)
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hn16 : 0 ≤ ((n : ℝ) + 1) * Real.log 16 := mul_nonneg (by linarith) hlog16
    have hA₂3 : 3 ≤ A₂ := by rw [hA₂_def]; linarith
    have hM3 : 3 ≤ Real.exp (A₂ * L) := by
      have := Real.add_one_le_exp (A₂ * L)
      nlinarith
    have hV : 0 < ‖G s₁‖ := norm_pos_iff.2 hG1
    have hup : ∀ z ∈ Metric.closedBall s₁ 1,
        ‖G z‖ ≤ Real.exp ((Real.log A + 2 * A) * L) := by
      intro z hz
      obtain ⟨X, hX0, hXle, hGz⟩ := hgrowth z hz
      have h1 : X ^ A ≤ (3 / 2 * Real.exp L) ^ A := Real.rpow_le_rpow hX0 hXle (by linarith)
      have h2 : (3 / 2 * Real.exp L) ^ A = Real.exp (A * (Real.log (3 / 2) + L)) := by
        rw [Real.rpow_def_of_pos (by positivity), Real.log_mul (by norm_num) (Real.exp_pos L).ne',
          Real.log_exp, mul_comm]
      have h3 : Real.log (3 / 2) ≤ L := by
        have := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 3 / 2)
        linarith
      have h4 : A = Real.exp (Real.log A) := (Real.exp_log (by linarith)).symm
      have h5 : A * Real.log (3 / 2) ≤ A * L := mul_le_mul_of_nonneg_left h3 (by linarith)
      have h6 : Real.log A * 1 ≤ Real.log A * L := mul_le_mul_of_nonneg_left hL1 hlogA
      have h7 : A * L ≥ 0 := by positivity
      calc ‖G z‖ ≤ A * X ^ A := hGz
        _ ≤ A * Real.exp (A * (Real.log (3 / 2) + L)) := by
            rw [← h2]; exact mul_le_mul_of_nonneg_left h1 (by linarith)
        _ = Real.exp (Real.log A + A * (Real.log (3 / 2) + L)) := by
            rw [Real.exp_add, ← h4]
        _ ≤ Real.exp ((Real.log A + 2 * A) * L) := by
            apply Real.exp_le_exp.2
            nlinarith
    have hfac : (1 + 8 * L) ^ (n + 1)
        ≤ Real.exp (((n : ℝ) + 1) * Real.log 16 * L + ((n : ℝ) + 1) * L) := by
      have h1 : 1 + 8 * L ≤ 16 * Real.exp L := by
        have := Real.add_one_le_exp L
        linarith
      have h2 : (1 + 8 * L) ^ (n + 1) ≤ (16 * Real.exp L) ^ (n + 1) :=
        pow_le_pow_left₀ (by linarith) h1 _
      have h3 : (16 * Real.exp L) ^ (n + 1)
          = Real.exp (((n : ℝ) + 1) * Real.log 16 + ((n : ℝ) + 1) * L) := by
        rw [mul_pow, ← Real.exp_nat_mul, Real.exp_add]
        congr 1
        · rw [show ((n : ℝ) + 1) * Real.log 16 = ((n + 1 : ℕ) : ℝ) * Real.log 16 by push_cast; ring,
