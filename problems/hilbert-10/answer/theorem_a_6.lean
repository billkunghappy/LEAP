          (Metric.closedBall (0 : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ) R) := by
      rw [closedBall_prod_same]
      rfl
    have hreal : MeasureTheory.volume
          (Metric.closedBall (0 : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) R)
        = ENNReal.ofReal (2 * R) ^ NumberField.InfinitePlace.nrRealPlaces K := by
      rw [closedBall_pi _ hR, MeasureTheory.volume_pi_pi]
      simp only [Real.volume_closedBall, Finset.prod_const, Finset.card_univ]
