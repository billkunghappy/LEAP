theorem kai_vbr_autocorr_large (ν : ℕ) (L : ℕ) (hL : 1 ≤ L) (δ Q : ℝ) (hδ : 0 < δ) (hQ : 0 < Q)
    (φ : (Fin ν → ℤ) → ℂ) (hφ : ∀ z, ‖φ z‖ ≤ Q) (z₀ : Fin ν → ℤ)
    (hbig : δ * (L : ℝ) ^ ν ≤ ‖∑ z ∈ Finset.Icc z₀ (z₀ + fun _ => ((L : ℤ) - 1)), φ z‖) :
    ∃ E₀ : Finset (Fin ν → ℤ),
      (∀ h ∈ E₀, ∀ l, |h l| < (L : ℤ)) ∧
      δ ^ 2 / (2 ^ (ν + 1) * Q ^ 2) * (2 * (L : ℝ)) ^ ν ≤ (E₀.card : ℝ) ∧
      ∀ h ∈ E₀, δ ^ 2 / 2 ^ (ν + 1) * (L : ℝ) ^ ν ≤
        ‖∑ w ∈ Finset.Icc (z₀ + fun l => max 0 (-h l)) (z₀ + fun l => (L : ℤ) - 1 - max 0 (h l)),
          φ (w + h) * (starRingEnd ℂ) (φ w)‖ :=
by
  classical
  obtain ⟨B, hB⟩ : ∃ B : Finset (Fin ν → ℤ), B = Finset.Icc z₀ (z₀ + fun _ => ((L : ℤ) - 1)) :=
    ⟨_, rfl⟩
  obtain ⟨H, hH⟩ : ∃ H : Finset (Fin ν → ℤ),
      H = Finset.Icc (fun _ : Fin ν => -((L : ℤ) - 1)) (fun _ => (L : ℤ) - 1) := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : (Fin ν → ℤ) → Finset (Fin ν → ℤ),
      W = fun h => Finset.Icc (z₀ + fun l => max 0 (-h l))
        (z₀ + fun l => (L : ℤ) - 1 - max 0 (h l)) := ⟨_, rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : (Fin ν → ℤ) → ℂ,
      R = fun h => ∑ w ∈ W h, φ (w + h) * (starRingEnd ℂ) (φ w) := ⟨_, rfl⟩
  rw [← hB] at hbig
  have memB : ∀ x, x ∈ B ↔ ∀ l, z₀ l ≤ x l ∧ x l ≤ z₀ l + ((L : ℤ) - 1) := by
    intro x
    simp only [hB, Finset.mem_Icc, Pi.le_def, Pi.add_apply]
    exact ⟨fun h l => ⟨h.1 l, h.2 l⟩, fun h => ⟨fun l => (h l).1, fun l => (h l).2⟩⟩
  have memH : ∀ x, x ∈ H ↔ ∀ l, -((L : ℤ) - 1) ≤ x l ∧ x l ≤ (L : ℤ) - 1 := by
    intro x
    simp only [hH, Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h l => ⟨h.1 l, h.2 l⟩, fun h => ⟨fun l => (h l).1, fun l => (h l).2⟩⟩
  have memW : ∀ h x, x ∈ W h ↔
      ∀ l, z₀ l + max 0 (-h l) ≤ x l ∧ x l ≤ z₀ l + ((L : ℤ) - 1 - max 0 (h l)) := by
    intro h x
    simp only [hW, Finset.mem_Icc, Pi.le_def, Pi.add_apply]
    exact ⟨fun h l => ⟨h.1 l, h.2 l⟩, fun h => ⟨fun l => (h l).1, fun l => (h l).2⟩⟩
  have M1 : ∀ z ∈ B, ∀ w ∈ B, z - w ∈ H := by
    intro z hz w hw
    rw [memB] at hz hw
    rw [memH]
    intro l
    have a := hz l
    have b := hw l
    simp only [Pi.sub_apply]
    constructor <;> omega
  have M2 : ∀ h w, (w ∈ B ∧ w + h ∈ B) ↔ w ∈ W h := by
    intro h w
    rw [memB, memB, memW]
    constructor
    · rintro ⟨h1, h2⟩ l
      have a := h1 l
      have b := h2 l
      simp only [Pi.add_apply] at b
      rcases le_total 0 (h l) with hh | hh
      · rw [max_eq_left (by omega : -h l ≤ 0), max_eq_right hh]
        constructor <;> omega
      · rw [max_eq_right (by omega : 0 ≤ -h l), max_eq_left hh]
        constructor <;> omega
    · intro h1
      refine ⟨fun l => ?_, fun l => ?_⟩
      · have a := h1 l
        rcases le_total 0 (h l) with hh | hh
        · rw [max_eq_left (by omega : -h l ≤ 0), max_eq_right hh] at a
          constructor <;> omega
        · rw [max_eq_right (by omega : 0 ≤ -h l), max_eq_left hh] at a
          constructor <;> omega
      · have a := h1 l
        simp only [Pi.add_apply]
        rcases le_total 0 (h l) with hh | hh
        · rw [max_eq_left (by omega : -h l ≤ 0), max_eq_right hh] at a
          constructor <;> omega
        · rw [max_eq_right (by omega : 0 ≤ -h l), max_eq_left hh] at a
          constructor <;> omega
  
  have iden : (∑ z ∈ B, φ z) * (starRingEnd ℂ) (∑ z ∈ B, φ z) = ∑ h ∈ H, R h := by
    rw [map_sum, Finset.sum_mul_sum, Finset.sum_comm]
    have inner : ∀ w ∈ B, ∑ z ∈ B, φ z * (starRingEnd ℂ) (φ w)
        = ∑ h ∈ H, if w + h ∈ B then φ (w + h) * (starRingEnd ℂ) (φ w) else 0 := by
      intro w hw
      rw [← Finset.sum_filter]
      apply Finset.sum_nbij' (fun z => z - w) (fun h => w + h)
      · intro z hz
        rw [Finset.mem_filter]
        refine ⟨M1 z hz w hw, ?_⟩
        simpa using hz
      · intro h hh
        rw [Finset.mem_filter] at hh
        exact hh.2
      · intro z _
        simp
      · intro h _
        simp
      · intro z _
        simp
    rw [Finset.sum_congr rfl inner, Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro h _
    rw [← Finset.sum_filter, hR]
    apply Finset.sum_congr _ (fun _ _ => rfl)
    ext w
    rw [Finset.mem_filter, M2]
  
  obtain ⟨Sφ, hSφ⟩ : ∃ Sφ : ℂ, Sφ = ∑ z ∈ B, φ z := ⟨_, rfl⟩
  rw [← hSφ] at iden hbig
  have hsq : ‖Sφ‖ ^ 2 ≤ ∑ h ∈ H, ‖R h‖ := by
    have e1 : ((‖Sφ‖ ^ 2 : ℝ) : ℂ) = ∑ h ∈ H, R h := by
      rw [← iden, Complex.mul_conj, Complex.normSq_eq_norm_sq]
    have e2 : ‖Sφ‖ ^ 2 = ‖∑ h ∈ H, R h‖ := by
      rw [← e1, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [e2]
    exact norm_sum_le _ _
  have hS : (δ * (L : ℝ) ^ ν) ^ 2 ≤ ‖Sφ‖ ^ 2 :=
    pow_le_pow_left₀ (by positivity) hbig 2
  
  have cardW : ∀ h, ((W h).card : ℝ) ≤ (L : ℝ) ^ ν := by
    intro h
    have : (W h).card ≤ L ^ ν := by
      rw [hW]
      simp only
      rw [Pi.card_Icc]
      calc ∏ l, (Finset.Icc ((z₀ + fun l => max 0 (-h l)) l)
              ((z₀ + fun l => (L : ℤ) - 1 - max 0 (h l)) l)).card
          ≤ L ^ (Finset.univ : Finset (Fin ν)).card := by
            apply Finset.prod_le_pow_card
            intro l _
            rw [Int.card_Icc]
            simp only [Pi.add_apply]
            have h1 := le_max_left 0 (h l)
            have h2 := le_max_left 0 (-h l)
            omega
        _ = L ^ ν := by rw [Finset.card_univ, Fintype.card_fin]
    exact_mod_cast this
  have cardH : (H.card : ℝ) ≤ (2 * (L : ℝ)) ^ ν := by
    have : H.card ≤ (2 * L) ^ ν := by
      rw [hH, Pi.card_Icc]
      calc ∏ l : Fin ν, (Finset.Icc (-((L : ℤ) - 1)) ((L : ℤ) - 1)).card
          ≤ (2 * L) ^ (Finset.univ : Finset (Fin ν)).card := by
            apply Finset.prod_le_pow_card
            intro l _
            rw [Int.card_Icc]
            omega
        _ = (2 * L) ^ ν := by rw [Finset.card_univ, Fintype.card_fin]
    exact_mod_cast this
  
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = Q ^ 2 * (L : ℝ) ^ ν := ⟨_, rfl⟩
  have hRM : ∀ h, ‖R h‖ ≤ M := by
    intro h
    rw [hR]
    simp only
    calc ‖∑ w ∈ W h, φ (w + h) * (starRingEnd ℂ) (φ w)‖
        ≤ ∑ w ∈ W h, ‖φ (w + h) * (starRingEnd ℂ) (φ w)‖ := norm_sum_le _ _
      _ ≤ (W h).card • (Q * Q) := by
          apply Finset.sum_le_card_nsmul
          intro w _
          rw [norm_mul, Complex.norm_conj]
          exact mul_le_mul (hφ _) (hφ _) (norm_nonneg _) hQ.le
      _ = ((W h).card : ℝ) * Q ^ 2 := by rw [nsmul_eq_mul, sq]
      _ ≤ (L : ℝ) ^ ν * Q ^ 2 := mul_le_mul_of_nonneg_right (cardW h) (by positivity)
      _ = M := by rw [hM]; ring
  
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = δ ^ 2 / 2 ^ (ν + 1) * (L : ℝ) ^ ν := ⟨_, rfl⟩
  have hT0 : 0 ≤ T := by rw [hT]; positivity
  have hHT : (H.card : ℝ) * T ≤ (δ * (L : ℝ) ^ ν) ^ 2 / 2 := by
    calc (H.card : ℝ) * T ≤ (2 * (L : ℝ)) ^ ν * T := mul_le_mul_of_nonneg_right cardH hT0
      _ = (δ * (L : ℝ) ^ ν) ^ 2 / 2 := by
          rw [hT, mul_pow, pow_succ]
          field_simp
          ring
  set E := H.filter (fun h => T ≤ ‖R h‖) with hE
  have hsplit := Finset.sum_filter_add_sum_filter_not H (fun h => T ≤ ‖R h‖) (fun h => ‖R h‖)
  have hE1 : ∑ h ∈ E, ‖R h‖ ≤ (E.card : ℝ) * M := by
    have := Finset.sum_le_card_nsmul E (fun h => ‖R h‖) M (fun h _ => hRM h)
    rwa [nsmul_eq_mul] at this
  have hE2 : ∑ h ∈ H.filter (fun h => ¬ T ≤ ‖R h‖), ‖R h‖ ≤ (H.card : ℝ) * T := by
    have := Finset.sum_le_card_nsmul (H.filter (fun h => ¬ T ≤ ‖R h‖)) (fun h => ‖R h‖) T
      (fun h hh => by
        rw [Finset.mem_filter] at hh
        exact le_of_lt (not_le.1 hh.2))
    rw [nsmul_eq_mul] at this
    refine this.trans (mul_le_mul_of_nonneg_right ?_ hT0)
    exact_mod_cast Finset.card_filter_le _ _
  have hmain : (δ * (L : ℝ) ^ ν) ^ 2 / 2 ≤ (E.card : ℝ) * M := by
    linarith
  refine ⟨E, ?_, ?_, ?_⟩
  · intro h hh l
    rw [hE, Finset.mem_filter, memH] at hh
    have a := hh.1 l
    rw [abs_lt]
    constructor <;> omega
  · have hMpos : 0 < M := by rw [hM]; positivity
    have hX : δ ^ 2 / (2 ^ (ν + 1) * Q ^ 2) * (2 * (L : ℝ)) ^ ν * M
        = (δ * (L : ℝ) ^ ν) ^ 2 / 2 := by
      rw [hM, mul_pow, pow_succ]
      field_simp
      ring
    rw [← hX] at hmain
    exact le_of_mul_le_mul_right hmain hMpos
  · intro h hh
    rw [hE, Finset.mem_filter] at hh
    have := hh.2
    rw [hT, hR, hW] at this
    exact this

theorem kai_vbr_fejer_approx (a : ℕ) (G : (Fin a → ℝ) → ℂ) (B₀ Λ τ : ℝ) (K : ℕ)
    (hΛ : 0 ≤ Λ) (hτ : 0 < τ)
    (hper : ∀ (x : Fin a → ℝ) (γ : Fin a → ℤ), G (fun i => x i + (γ i : ℝ)) = G x)
    (hbd : ∀ x, ‖G x‖ ≤ B₀)
    (hlip : ∀ x y : Fin a → ℝ, (∀ i, |x i - y i| ≤ 1 / 2) →
      ‖G x - G y‖ ≤ Λ * ∑ i, |x i - y i|)
    (hK : ((a : ℝ) * Λ / τ) ^ 2 ≤ (K : ℝ) + 1) :
    ∃ c : (Fin a → ℤ) → ℂ, (∀ m, ‖c m‖ ≤ B₀) ∧
      ∀ x : Fin a → ℝ, ‖G x - ∑ m ∈ Finset.Icc (fun _ => -(K : ℤ)) (fun _ => (K : ℤ)),
          c m * giE (∑ i, (m i : ℝ) * x i)‖ ≤ τ :=
by
  classical
  
  
  
  have gAdd : ∀ u v : ℝ, giE (u + v) = giE u * giE v := by
    intro u v
    unfold giE
    rw [← Complex.exp_add]; congr 1; push_cast; ring
  have gInt : ∀ n : ℤ, giE (n : ℝ) = 1 := by
    intro n
    unfold giE
    rw [show 2 * (Real.pi : ℂ) * Complex.I * ((n : ℝ) : ℂ) = n * (2 * Real.pi * Complex.I) by
      push_cast; ring]
    exact Complex.exp_int_mul_two_pi_mul_I n
  have gNorm : ∀ u : ℝ, ‖giE u‖ = 1 := by
    intro u
    unfold giE
    rw [show 2 * (Real.pi : ℂ) * Complex.I * (u : ℂ) = ((2 * Real.pi * u : ℝ) : ℂ) * Complex.I by
      push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  have gNat : ∀ (k : ℕ) (u : ℝ), giE ((k : ℝ) * u) = giE u ^ k := by
    intro k u
    unfold giE
    rw [← Complex.exp_nat_mul]; congr 1; push_cast; ring
  have gConj : ∀ u : ℝ, (starRingEnd ℂ) (giE u) = giE (-u) := by
    intro u
    unfold giE
    rw [← Complex.exp_conj]; congr 1
    rw [map_mul, map_mul, map_mul, Complex.conj_ofReal, Complex.conj_ofReal, Complex.conj_I,
      map_ofNat]
    push_cast; ring
  have gZero : giE 0 = 1 := by
    unfold giE; simp
  have gSum : ∀ (n : ℕ) (u : Fin n → ℝ), giE (∑ i, u i) = ∏ i, giE (u i) := by
    intro n u
    unfold giE
    rw [← Complex.exp_sum]; congr 1
    push_cast
    rw [Finset.mul_sum]
  
  
  
  have root_sum : ∀ (N : ℕ) (d : ℤ), d ≠ 0 → |d| < (N : ℤ) →
      ∑ j ∈ Finset.range N, giE ((d : ℝ) * (j : ℝ) / (N : ℝ)) = 0 := by
    intro N d hd0 hdN
    have hN : (N : ℝ) ≠ 0 := by
      have : (0 : ℤ) < N := lt_of_le_of_lt (abs_nonneg d) hdN
      exact_mod_cast this.ne'
    set ζ := giE ((d : ℝ) / N) with hζ
    have hj : ∀ j : ℕ, giE ((d : ℝ) * (j : ℝ) / (N : ℝ)) = ζ ^ j := by
      intro j
      rw [hζ, ← gNat]; congr 1; ring
    simp_rw [hj]
    have hζN : ζ ^ N = 1 := by
      rw [hζ, ← gNat, show (N : ℝ) * ((d : ℝ) / N) = (d : ℝ) by field_simp]
      exact gInt d
    have hζ1 : ζ ≠ 1 := by
      intro h
      rw [hζ] at h
      unfold giE at h
      rw [Complex.exp_eq_one_iff] at h
      obtain ⟨n, hn⟩ := h
      have h2 : (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 := by
        simp [Real.pi_ne_zero, Complex.I_ne_zero]
      have h3 : (((d : ℝ) / N : ℝ) : ℂ) = (n : ℂ) := by
        have : 2 * (Real.pi : ℂ) * Complex.I * (((d : ℝ) / N : ℝ) : ℂ)
            = 2 * (Real.pi : ℂ) * Complex.I * (n : ℂ) := by rw [hn]; ring
        exact mul_left_cancel₀ h2 this
