theorem kv_torus_family_pack (K : Type u) [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ)
    {R ι : Type} [Fintype R] [Fintype ι] (G : R → (ι → ℝ) → ℂ)
    (Ψ₀ : R → ι → ℝ) (Ψ₁ : R → Fin ν → ι → ℝ) (Ψ₂ : R → Fin ν → Fin ν → ι → ℝ)
    (φ : (Fin ν → ℤ) → ℂ) (Q KG Dt Ξ : ℝ) (hQ : 1 ≤ Q)
    (hcard : (Fintype.card ι : ℝ) ≤ Dt)
    (hb : ∀ ρ p, ‖G ρ p‖ ≤ Q)
    (hper : ∀ ρ p (γ : ι → ℤ), G ρ (fun i => p i + (γ i : ℝ)) = G ρ p)
    (hlip : ∀ ρ p p', ‖G ρ p - G ρ p'‖ ≤ KG * ∑ i, |p i - p' i|)
    (hQΞ : Q ≤ Ξ) (hKG : KG ≤ Ξ) (hR : 2 * (Fintype.card R : ℝ) ≤ Ξ)
    (hrep : ∀ z ∈ intBox ν ⌊M⌋₊, φ z = ∑ ρ, G ρ (fun i => Ψ₀ ρ i + ∑ l, (z l : ℝ) * Ψ₁ ρ l i
        + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * Ψ₂ ρ l l' i)) :
    ∃ (k : ℕ) (c : Fin k → ℂ) (ψ : Fin k → (Fin ν → ℤ) → ℝ),
      (k : ℝ) ≤ Ξ ∧ (∀ j, ‖c j‖ ≤ Ξ) ∧ (∀ j, IsTorusQuadSeq ν Dt Ξ (ψ j)) ∧
      ∀ (ε : ℝ), 0 < ε → ∀ (h : NumberField.RingOfIntegers K → ℝ) (T : ℝ), 0 ≤ T →
        (∀ x ∈ omegaBox ω M, |h x| ≤ T) →
        ‖∑ x ∈ omegaBox ω M, ((h x : ℝ) : ℂ) * φ (ω.equivFun x)
          - ∑ j, c j * ((∑ x ∈ omegaBox ω M, h x * ψ j (ω.equivFun x) : ℝ) : ℂ)‖
          ≤ ε * T * ((omegaBox ω M).card : ℝ) :=
by
  classical
  have hQ0 : (0 : ℝ) < Q := by linarith
  have hΞ0 : (0 : ℝ) ≤ Ξ := by linarith
  have hQc : (Q : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hQ0.ne'
  let e := Fintype.equivFin (R × Bool)
  let Ψ : R → (Fin ν → ℤ) → ι → ℝ := fun ρ z i => Ψ₀ ρ i + ∑ l, (z l : ℝ) * Ψ₁ ρ l i
        + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * Ψ₂ ρ l l' i
  let up : R × Bool → ℂ := fun p => if p.2 then 1 else -Complex.I
  let cp : R × Bool → ℂ := fun p => if p.2 then (Q : ℂ) else (Q : ℂ) * Complex.I
  let gpart : R × Bool → (ι → ℝ) → ℝ := fun p v => (up p * G p.1 v).re / Q
  let c : Fin (Fintype.card (R × Bool)) → ℂ := fun j => cp (e.symm j)
  let ψ : Fin (Fintype.card (R × Bool)) → (Fin ν → ℤ) → ℝ :=
    fun j z => gpart (e.symm j) (Ψ (e.symm j).1 z)
  have hup : ∀ p, ‖up p‖ = 1 := by
    intro p
    simp only [up]
    split_ifs
    · simp
    · simp
  have key : ∀ w : ℂ, (Q : ℂ) * (((1 * w).re / Q : ℝ) : ℂ)
      + (Q : ℂ) * Complex.I * (((-Complex.I * w).re / Q : ℝ) : ℂ) = w := by
    intro w
    apply Complex.ext
    · simp
      field_simp
    · simp
      field_simp
  have hsum : ∀ z, ∑ j, c j * ((ψ j z : ℝ) : ℂ) = ∑ ρ, G ρ (Ψ ρ z) := by
    intro z
    let F : R × Bool → ℂ := fun p => cp p * ((gpart p (Ψ p.1 z) : ℝ) : ℂ)
    calc ∑ j, c j * ((ψ j z : ℝ) : ℂ) = ∑ j, F (e.symm j) := rfl
      _ = ∑ p, F p := Equiv.sum_comp e.symm F
      _ = ∑ ρ, ∑ b, F (ρ, b) := Fintype.sum_prod_type _
      _ = ∑ ρ, G ρ (Ψ ρ z) := by
        refine Finset.sum_congr rfl (fun ρ _ => ?_)
        rw [Fintype.sum_bool]
        simp only [F, cp, gpart, up, ↓reduceIte, Bool.false_eq_true]
        exact key _
  refine ⟨Fintype.card (R × Bool), c, ψ, ?_, ?_, ?_, ?_⟩
  · rw [Fintype.card_prod, Fintype.card_bool]; push_cast; linarith
  · intro j
    simp only [c, cp]
    split_ifs
    · rw [Complex.norm_real, Real.norm_of_nonneg hQ0.le]; exact hQΞ
    · rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_of_nonneg hQ0.le]
      exact hQΞ
  · intro j
    show IsTorusQuadSeq ν Dt Ξ (fun z => gpart (e.symm j) (Ψ (e.symm j).1 z))
    generalize e.symm j = p
    obtain ⟨ρ, bb⟩ := p
    have h1 : ∀ v, |gpart (ρ, bb) v| ≤ 1 := by
      intro v
      simp only [gpart]
      rw [abs_div, abs_of_pos hQ0, div_le_one hQ0]
      calc |(up (ρ, bb) * G ρ v).re| ≤ ‖up (ρ, bb) * G ρ v‖ := Complex.abs_re_le_norm _
        _ = ‖G ρ v‖ := by rw [norm_mul, hup, one_mul]
        _ ≤ Q := hb ρ v
    have h2 : ∀ v (γ : ι → ℤ), gpart (ρ, bb) (fun i => v i + (γ i : ℝ)) = gpart (ρ, bb) v := by
      intro v γ
      simp only [gpart]
      rw [hper]
    have h3 : ∀ v v', |gpart (ρ, bb) v - gpart (ρ, bb) v'| ≤ Ξ * ∑ i, |v i - v' i| := by
      intro v v'
      have hS : 0 ≤ ∑ i, |v i - v' i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
      simp only [gpart]
      rw [← sub_div, ← Complex.sub_re, ← mul_sub, abs_div, abs_of_pos hQ0, div_le_iff₀ hQ0]
      calc |(up (ρ, bb) * (G ρ v - G ρ v')).re| ≤ ‖up (ρ, bb) * (G ρ v - G ρ v')‖ :=
            Complex.abs_re_le_norm _
        _ = ‖G ρ v - G ρ v'‖ := by rw [norm_mul, hup, one_mul]
        _ ≤ KG * ∑ i, |v i - v' i| := hlip ρ v v'
        _ ≤ Ξ * ∑ i, |v i - v' i| := mul_le_mul_of_nonneg_right hKG hS
        _ ≤ (Ξ * ∑ i, |v i - v' i|) * Q := le_mul_of_one_le_right (mul_nonneg hΞ0 hS) hQ
    let eι := Fintype.equivFin ι
    refine ⟨Fintype.card ι, fun k => Ψ₀ ρ (eι.symm k), fun l k => Ψ₁ ρ l (eι.symm k),
      fun l l' k => Ψ₂ ρ l l' (eι.symm k), fun u => gpart (ρ, bb) (fun i => u (eι i)),
      hcard, ?_, ?_, ?_, ?_⟩
    · intro u; exact h1 _
    · intro u γ; exact h2 (fun i => u (eι i)) (fun i => γ (eι i))
    · intro u v
      have := h3 (fun i => u (eι i)) (fun i => v (eι i))
      rwa [Equiv.sum_comp eι (fun k => |u k - v k|)] at this
    · intro z
      simp only [Ψ, Equiv.symm_apply_apply]
  · intro ε hε h T hT _
    have hmem : ∀ x ∈ omegaBox ω M, ω.equivFun x ∈ intBox ν ⌊M⌋₊ := by
      intro x hx
      unfold omegaBox at hx
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
      rw [LinearEquiv.apply_symm_apply]
      exact hv
    have hid : ∀ x ∈ omegaBox ω M,
        φ (ω.equivFun x) = ∑ j, c j * ((ψ j (ω.equivFun x) : ℝ) : ℂ) := by
      intro x hx
      rw [hsum, hrep _ (hmem x hx)]
    have heq : ∑ j, c j * ((∑ x ∈ omegaBox ω M, h x * ψ j (ω.equivFun x) : ℝ) : ℂ)
        = ∑ x ∈ omegaBox ω M, ((h x : ℝ) : ℂ) * φ (ω.equivFun x) := by
      have hR : ∑ x ∈ omegaBox ω M, ((h x : ℝ) : ℂ) * φ (ω.equivFun x)
          = ∑ x ∈ omegaBox ω M, ((h x : ℝ) : ℂ)
              * ∑ j, c j * ((ψ j (ω.equivFun x) : ℝ) : ℂ) :=
        Finset.sum_congr rfl (fun x hx => by rw [hid x hx])
      rw [hR]
      simp only [Complex.ofReal_sum, Complex.ofReal_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun x _ => Finset.sum_congr rfl (fun j _ => by ring))
    rw [heq, sub_self, norm_zero]
    positivity

theorem kai_v_structured_approx (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ A : ℕ, 1 ≤ A ∧
      ∀ (D Q X ε M : ℝ), 1 ≤ D → 2 ≤ Q → 2 ≤ X → 0 < ε → ε ≤ 1 → 1 ≤ M →
      ∀ φ : (Fin (Module.finrank ℚ K) → ℤ) → ℂ,
        IsNil2VertStructSeq (Module.finrank ℚ K) D Q M X φ →
        ∃ (k : ℕ) (c : Fin k → ℂ) (ψ : Fin k → (Fin (Module.finrank ℚ K) → ℤ) → ℝ),
          (k : ℝ) ≤ Real.exp ((D + Real.log Q + Real.log X + Real.log (1 / ε)) ^ A) ∧
          (∀ j, ‖c j‖ ≤ Real.exp ((D + Real.log Q + Real.log X + Real.log (1 / ε)) ^ A)) ∧
          (∀ j, IsTorusQuadSeq (Module.finrank ℚ K) (D + 2 * (Module.finrank ℚ K : ℝ) + 2)
            (Real.exp ((D + Real.log Q + Real.log X + Real.log (1 / ε)) ^ A)) (ψ j)) ∧
          ∀ (h : NumberField.RingOfIntegers K → ℝ) (T : ℝ), 0 ≤ T →
            (∀ x ∈ omegaBox ω M, |h x| ≤ T) →
            ‖∑ x ∈ omegaBox ω M, ((h x : ℝ) : ℂ) * φ (ω.equivFun x)
              - ∑ j, c j * ((∑ x ∈ omegaBox ω M, h x * ψ j (ω.equivFun x) : ℝ) : ℂ)‖
              ≤ ε * T * ((omegaBox ω M).card : ℝ) :=
by
  classical
  obtain ⟨A, hA1, hAbd⟩ := kv_const_absorb (Module.finrank ℚ K)
  refine ⟨A, hA1, ?_⟩
  intro D Q X ε M hD hQ hX hε hε1 hM φ hφs
  obtain ⟨a, b, Bc, ξ, p₀, p₁, r₀, r₁, r₂, F, r, kc, hdata, hφ, hkc, hiso, hsm⟩ := hφs
  obtain ⟨hab, hBc, hξ, -, hFb, hΓ, hvert, hlip⟩ := hdata
  have hX1 : (1 : ℝ) ≤ X := by linarith
  have hX0 : (0 : ℝ) ≤ X := by linarith
  have hQ0 : (0 : ℝ) ≤ Q := by linarith
  have hQ1 : (1 : ℝ) ≤ Q := by linarith
  have hM0 : (0 : ℝ) < M := by linarith
  have hMne : M ≠ 0 := hM0.ne'
  have ha0 : (0 : ℝ) ≤ (a : ℝ) := Nat.cast_nonneg a
  have hb0 : (0 : ℝ) ≤ (b : ℝ) := Nat.cast_nonneg b
  have hab' : (a : ℝ) + (b : ℝ) ≤ D := by exact_mod_cast hab
  have haD : (a : ℝ) ≤ D := by linarith
  have hbD : (b : ℝ) ≤ D := by linarith
  have hν0 : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.cast_nonneg _
  have hpi : 0 < Real.pi := Real.pi_pos
  
  obtain ⟨B₀, hB₀⟩ : ∃ B₀ : ℝ, B₀ = (((a : ℝ) + 1) * X) ^ (4 * a) := ⟨_, rfl⟩
  obtain ⟨W₀, hW₀⟩ : ∃ W₀ : ℝ, W₀ = 8 * B₀ * X := ⟨_, rfl⟩
  obtain ⟨Mμ, hMμ⟩ : ∃ Mμ : ℝ, Mμ = 2 * B₀ * X := ⟨_, rfl⟩
  obtain ⟨Rx, hRx⟩ : ∃ Rx : ℝ, Rx = 1 + (Module.finrank ℚ K : ℝ) * W₀ := ⟨_, rfl⟩
  obtain ⟨Bβ, hBβ⟩ : ∃ Bβ : ℝ, Bβ = D * Q ^ 2 := ⟨_, rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = Rx + 2 * (a : ℝ) * Mμ := ⟨_, rfl⟩
  obtain ⟨Lf, hLf⟩ : ∃ Lf : ℝ, Lf = Q * (2 + 2 * Real.pi * Bβ * a * (R + 1)) := ⟨_, rfl⟩
  obtain ⟨LH, hLH⟩ : ∃ LH : ℝ, LH = (8 + (a : ℝ) + a + Rx + Mμ + Bβ + Q + Lf) ^ 9 :=
    ⟨_, rfl⟩
  obtain ⟨KG, hKG⟩ : ∃ KG : ℝ,
      KG = 2 * Real.pi * Q + LH * (1 + (a : ℝ) * W₀) + Q * (2 * B₀) := ⟨_, rfl⟩
  obtain ⟨hQΞ, hBΞ, hKGΞ⟩ := hAbd a D Q X ε B₀ W₀ Mμ Rx Bβ R Lf LH KG hD hQ hX hε hε1 haD
    hB₀ hW₀ hMμ hRx hBβ hR hLf hLH hKG
  have hB₀1 : 1 ≤ B₀ := by
    rw [hB₀]; exact one_le_pow₀ (one_le_mul_of_one_le_of_one_le (by linarith) hX1)
  have hB₀0 : 0 ≤ B₀ := by linarith
  have hW₀0 : 0 ≤ W₀ := by rw [hW₀]; exact mul_nonneg (mul_nonneg (by norm_num) hB₀0) hX0
  have hMμ0 : 0 ≤ Mμ := by rw [hMμ]; exact mul_nonneg (mul_nonneg (by norm_num) hB₀0) hX0
  have hRx0 : 0 ≤ Rx := by rw [hRx]; exact add_nonneg zero_le_one (mul_nonneg hν0 hW₀0)
  have hBβ0 : 0 ≤ Bβ := by rw [hBβ]; exact mul_nonneg (by linarith) (sq_nonneg Q)
  have hR0 : 0 ≤ R := by
    rw [hR]; exact add_nonneg hRx0 (mul_nonneg (mul_nonneg (by norm_num) ha0) hMμ0)
  have hLf0 : 0 ≤ Lf := by
    rw [hLf]
    have : 0 ≤ 2 * Real.pi * Bβ * a * (R + 1) :=
      mul_nonneg (mul_nonneg (mul_nonneg (by positivity) hBβ0) ha0) (by linarith)
    exact mul_nonneg hQ0 (by linarith)
  have hLH0 : 0 ≤ LH := by
    rw [hLH]; apply pow_nonneg; linarith
  
  obtain ⟨Δ, C, hΔ1, hΔB, hCB, hKCK⟩ := kv_int_matrix_pseudoinverse r a kc X hX1 hkc
  rw [← hB₀] at hΔB hCB
  obtain ⟨n, σ, μ, hσ, hμ, hsplit, hsym⟩ := kv_horizontal_split (Module.finrank ℚ K) a b r kc C
    Δ hΔ1 hKCK B₀ X M hX1 hM hΔB hCB hkc p₁ hsm Bc ξ hiso
  
  obtain ⟨hfac, hqpF⟩ := kv_nil2_vert_factor Bc ξ F hΓ hvert
  
  obtain ⟨H, hH⟩ : ∃ H : (Fin a → ℝ) → (Fin a → ℝ) → ℂ, ∀ (x : Fin a → ℝ) (t : Fin a → ℝ),
      H x t = Complex.exp (2 * Real.pi * Complex.I *
        (((∑ i, ∑ i', ((∑ k, ξ k * Bc i i' k : ℤ) : ℝ) * x i * (∑ j, t j * (μ j i' : ℝ)))
          + (∑ i, ∑ i', ((∑ k, ξ k * Bc i i' k : ℤ) : ℝ) * (∑ j, t j * (μ j i : ℝ))
              * (∑ j, t j * (μ j i' : ℝ))) / 2
          - (∑ j, t j * (∑ i, ∑ i', ((∑ k, ξ k * Bc i i' k : ℤ) : ℝ) * (μ j i : ℝ)
              * (μ j i' : ℝ))) / 2 : ℝ) : ℂ))
        * F ((fun i => x i + ∑ j, t j * (μ j i : ℝ)), fun _ => 0) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨hHper, hunf, hHbd⟩ := kv_isotropic_periodization a a
    (fun i i' => ∑ k, ξ k * Bc i i' k) (fun u₁ => F (u₁, fun _ => 0)) μ H
    (fun u γ => hqpF u γ) hsym hH
  have hHbd' : ∀ x t, ‖H x t‖ ≤ Q := hHbd Q (fun u => hFb _)
  
  have hBm : ∀ i j, |((∑ k, ξ k * Bc i j k : ℤ) : ℝ)| ≤ Bβ := by
    intro i j
    rw [hBβ]
    push_cast
    calc |∑ k, (ξ k : ℝ) * (Bc i j k : ℝ)| ≤ ∑ k, |(ξ k : ℝ) * (Bc i j k : ℝ)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _k : Fin b, Q * Q := by
          apply Finset.sum_le_sum; intro k _
          rw [abs_mul]; exact mul_le_mul (hξ k) (hBc i j k) (abs_nonneg _) hQ0
      _ = (b : ℝ) * (Q * Q) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ ≤ D * Q ^ 2 := by rw [sq]; exact mul_le_mul_of_nonneg_right hbD (mul_nonneg hQ0 hQ0)
  have hcube : ∀ u v : Fin a → ℝ, (∀ i, -1 ≤ u i ∧ u i ≤ 2) → (∀ i, -1 ≤ v i ∧ v i ≤ 2) →
      ‖F (u, fun _ => 0) - F (v, fun _ => 0)‖ ≤ Q * ∑ i, |u i - v i| := by
    intro u v hu hv
    have h := hlip (u, fun _ => 0) (v, fun _ => 0) hu (fun _ => by norm_num) hv
      (fun _ => by norm_num)
    refine le_trans h (le_of_eq ?_)
    simp
  
  have hflip := kv_quasiperiodic_local_lipschitz a (fun i j => ((∑ k, ξ k * Bc i j k : ℤ) : ℝ))
    (fun u₁ => F (u₁, fun _ => 0)) Q Bβ R hQ0 hBβ0 hR0 hBm (fun u => hFb _)
    (fun u γ => hqpF u γ) hcube
  rw [← hLf] at hflip
  have hHlip := kv_periodization_lipschitz a a (fun i i' => ((∑ k, ξ k * Bc i i' k : ℤ) : ℝ))
    (fun u₁ => F (u₁, fun _ => 0)) (fun j i => (μ j i : ℝ)) H Q Bβ Mμ Rx Lf hQ0 hBβ0 hMμ0 hRx0
    hLf0 hBm (fun j i => by rw [hMμ]; exact hμ j i) (fun u => hFb _)
    (fun u v hu => hflip u v (fun i => by rw [hR]; exact hu i)) hH hHper
  rw [← hLH] at hHlip
  
  have hcls := fun ρ : Fin (Module.finrank ℚ K) → Fin Δ =>
    kv_class_phase_identity (Module.finrank ℚ K) a b Δ hΔ1 (fun i i' => ∑ k, ξ k * Bc i i' k) μ
      (fun u₁ => F (u₁, fun _ => 0)) H hunf p₀ p₁ n σ hsplit (fun k => (ξ k : ℝ)) r₀ r₁ r₂
      (fun l => ((ρ l : ℕ) : ℤ))
  choose s₀ s₁ s₂ c' hc' hid using hcls
  have hid' : ∀ (ρ : Fin (Module.finrank ℚ K) → Fin Δ) (z : Fin (Module.finrank ℚ K) → ℤ),
      (∀ l, (Δ : ℤ) ∣ z l - ((ρ l : ℕ) : ℤ)) →
      φ z = Complex.exp (2 * Real.pi * Complex.I * ((s₀ ρ + ∑ l, s₁ ρ l * (z l : ℝ)
          + ∑ l, ∑ l', s₂ ρ l l' * (z l : ℝ) * (z l' : ℝ) : ℝ) : ℂ))
        * H (fun i => c' ρ i + ∑ l, (z l : ℝ) * σ l i)
            (fun j => ∑ l, (z l : ℝ) * ((p₁ l j - (n l j : ℝ) / Δ - σ l j) / Δ)) := by
    intro ρ z hz
    have h1 := hid ρ z hz
    rw [hφ z]
    refine (hfac ((fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i),
      (fun k => r₀ k + ∑ l, (z l : ℝ) * r₁ l k
        + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * r₂ l l' k))).trans ?_
    exact h1
  
  have hNM : (⌊M⌋₊ : ℝ) ≤ M := Nat.floor_le hM0.le
  have hσ' : ∀ l i, (4 * (⌊M⌋₊ : ℝ) + 4) * |σ l i| ≤ W₀ := by
    intro l i
    have h2 : (4 * (⌊M⌋₊ : ℝ) + 4) ≤ 8 * M := by linarith
    calc (4 * (⌊M⌋₊ : ℝ) + 4) * |σ l i| ≤ 8 * M * (B₀ * X / M) :=
          mul_le_mul h2 (hσ l i) (abs_nonneg _) (by linarith)
      _ = W₀ := by rw [hW₀]; field_simp
  obtain ⟨G, Ψ₀, Ψ₁, Ψ₂, hGb, hGper, hGlip, hGrep⟩ := kv_residue_torus_family
    (Module.finrank ℚ K) a a Δ ⌊M⌋₊ hΔ1 H σ
    (fun l j => (p₁ l j - (n l j : ℝ) / Δ - σ l j) / Δ) Q LH Rx W₀ B₀ hQ0 hLH0 hW₀0 hΔB hσ'
    (by rw [hRx]) hHbd' hHper hHlip φ s₀ s₁ s₂ c' hc' hid'
  rw [← hKG] at hGlip
  
  have hcardι : (Fintype.card (Unit ⊕ (Fin a ⊕ (Fin (Module.finrank ℚ K) ⊕
      Fin (Module.finrank ℚ K)))) : ℝ) ≤ D + 2 * (Module.finrank ℚ K : ℝ) + 2 := by
    simp only [Fintype.card_sum, Fintype.card_unit, Fintype.card_fin]
    push_cast
    linarith
  have hRcard : 2 * (Fintype.card (Fin (Module.finrank ℚ K) → Fin Δ) : ℝ)
      ≤ Real.exp ((D + Real.log Q + Real.log X + Real.log (1 / ε)) ^ A) := by
    have hc : Fintype.card (Fin (Module.finrank ℚ K) → Fin Δ) = Δ ^ Module.finrank ℚ K := by
      simp
    rw [hc]
    push_cast
    have : (Δ : ℝ) ^ Module.finrank ℚ K ≤ B₀ ^ Module.finrank ℚ K :=
      pow_le_pow_left₀ (Nat.cast_nonneg _) hΔB _
    linarith
  obtain ⟨kk, c, ψ, hk, hc, hψ, happrox⟩ := kv_torus_family_pack K ω M G Ψ₀ Ψ₁ Ψ₂ φ Q KG
    (D + 2 * (Module.finrank ℚ K : ℝ) + 2)
    (Real.exp ((D + Real.log Q + Real.log X + Real.log (1 / ε)) ^ A))
    hQ1 hcardι hGb hGper hGlip hQΞ hKGΞ hRcard hGrep
  exact ⟨kk, c, ψ, hk, hc, hψ, fun h T hT hh => happrox ε hε h T hT hh⟩

theorem kai_ideal_box_count (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M : ℝ) (𝔡 : Ideal (NumberField.RingOfIntegers K)) (h𝔡 : 𝔡 ≠ ⊥) :
    Ideal.absNorm 𝔡 * (@Finset.filter (NumberField.RingOfIntegers K) (fun x => x ∈ 𝔡)
        (fun _ => Classical.propDecidable _) (omegaBox ω M)).card
      ≤ (2 * ⌊M⌋₊ + Ideal.absNorm 𝔡) ^ Module.finrank ℚ K :=
by
  classical
  obtain ⟨D, hD⟩ : ∃ D : ℕ, D = Ideal.absNorm 𝔡 := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : ℕ, F = ⌊M⌋₊ := ⟨_, rfl⟩
  rw [← hD, ← hF]
  have hD0 : D ≠ 0 := by
    rw [hD]; intro h; exact h𝔡 (Ideal.absNorm_eq_zero_iff.1 h)
  have hDpos : (0 : ℤ) < (D : ℤ) := by exact_mod_cast Nat.pos_of_ne_zero hD0
  have hDmem : ((D : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔡 := by
    rw [hD]; exact Ideal.absNorm_mem 𝔡
  
  have hred : ∀ y : NumberField.RingOfIntegers K, ∃ z : Fin (Module.finrank ℚ K) → ℤ,
      (∀ j, 0 ≤ z j ∧ z j < (D : ℤ)) ∧ y - ω.equivFun.symm z ∈ 𝔡 := by
    intro y
    obtain ⟨v, hv⟩ : ∃ v, v = ω.equivFun y := ⟨_, rfl⟩
    refine ⟨fun j => v j % (D : ℤ),
      fun j => ⟨Int.emod_nonneg _ hDpos.ne', Int.emod_lt_of_pos _ hDpos⟩, ?_⟩
    have hvz : v - (fun j => v j % (D : ℤ)) = (D : ℤ) • (fun j => v j / (D : ℤ)) := by
      funext j
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      have := Int.emod_add_mul_ediv (v j) (D : ℤ)
      linarith
    have hy : y = ω.equivFun.symm v := by rw [hv]; exact (ω.equivFun.symm_apply_apply y).symm
    rw [hy, ← map_sub, hvz, map_zsmul, zsmul_eq_mul, Int.cast_natCast]
    exact Ideal.mul_mem_right _ _ hDmem
  
  let T : Finset (NumberField.RingOfIntegers K) :=
    (Finset.Icc (fun _ : Fin (Module.finrank ℚ K) => (0 : ℤ)) (fun _ => (D : ℤ) - 1)).image
      (fun z => ω.equivFun.symm z)
  let U : Finset (NumberField.RingOfIntegers K) :=
    (Finset.Icc (fun _ : Fin (Module.finrank ℚ K) => -(F : ℤ))
      (fun _ => (F : ℤ) + (D : ℤ) - 1)).image (fun z => ω.equivFun.symm z)
  set S := (@Finset.filter (NumberField.RingOfIntegers K) (fun x => x ∈ 𝔡)
        (fun _ => Classical.propDecidable _) (omegaBox ω M)) with hSdef
  have hS : ∀ x ∈ S, x ∈ 𝔡 := fun x hx => (Finset.mem_filter.1 hx).2
  have hσ : ∀ c : NumberField.RingOfIntegers K ⧸ 𝔡, ∃ t ∈ T, Ideal.Quotient.mk 𝔡 t = c := by
    intro c
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective c
    obtain ⟨z, hz, hyz⟩ := hred y
    refine ⟨ω.equivFun.symm z, Finset.mem_image_of_mem _ ?_, (Ideal.Quotient.eq.2 hyz).symm⟩
    rw [Finset.mem_Icc]
    refine ⟨fun j => (hz j).1, fun j => ?_⟩
    have := (hz j).2
    show z j ≤ (D : ℤ) - 1
    omega
  choose σ hσT hσmk using hσ
  have hU : ∀ x ∈ S, ∀ t ∈ T, x + t ∈ U := by
    intro x hx t ht
    have hx' := (Finset.mem_filter.1 hx).1
    simp only [omegaBox, intBox, Finset.mem_image] at hx'
    obtain ⟨v, hv, rfl⟩ := hx'
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 ht
    rw [Finset.mem_Icc] at hv hz
    rw [← hF] at hv
    rw [← map_add]
    refine Finset.mem_image_of_mem _ ?_
    rw [Finset.mem_Icc]
    refine ⟨fun j => ?_, fun j => ?_⟩
    · have h1 := hv.1 j
      have h2 := hz.1 j
      simp only [Pi.add_apply] at h1 h2 ⊢
      omega
    · have h1 := hv.2 j
      have h2 := hz.2 j
      simp only [Pi.add_apply] at h1 h2 ⊢
      omega
  let Φ : ↥S × (NumberField.RingOfIntegers K ⧸ 𝔡) → ↥U :=
    fun p => ⟨p.1.1 + σ p.2, hU p.1.1 p.1.2 (σ p.2) (hσT p.2)⟩
  have hkey : ∀ (x : ↥S) (c : NumberField.RingOfIntegers K ⧸ 𝔡),
      Ideal.Quotient.mk 𝔡 (x.1 + σ c) = c := by
    intro x c
    rw [map_add, hσmk, Ideal.Quotient.eq_zero_iff_mem.2 (hS x.1 x.2), zero_add]
  have hΦ : Function.Injective Φ := by
    rintro ⟨x, c⟩ ⟨x', c'⟩ h
    have h1 : x.1 + σ c = x'.1 + σ c' := congrArg Subtype.val h
    have hc : c = c' := by
      rw [← hkey x c, ← hkey x' c', h1]
    subst hc
    have hx : x.1 = x'.1 := add_right_cancel h1
    exact Prod.ext (Subtype.ext hx) rfl
  have hcard := Nat.card_le_card_of_injective Φ hΦ
  rw [Nat.card_prod, Nat.card_eq_finsetCard, Nat.card_eq_finsetCard] at hcard
  have hQ : Nat.card (NumberField.RingOfIntegers K ⧸ 𝔡) = D := by
    rw [hD, Ideal.absNorm_apply, Submodule.cardQuot_apply]
  have hUcard : U.card = (2 * F + D) ^ Module.finrank ℚ K := by
    show ((Finset.Icc (fun _ : Fin (Module.finrank ℚ K) => -(F : ℤ))
      (fun _ => (F : ℤ) + (D : ℤ) - 1)).image (fun z => ω.equivFun.symm z)).card = _
    rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective, Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  rw [hQ, hUcard] at hcard
  rw [mul_comm]
  exact hcard

theorem finset_esymm_mul_factorial_le {α : Type*} (P : Finset α) (a : α → ℝ)
    (ha : ∀ v ∈ P, 0 ≤ a v) (k : ℕ) :
    (k.factorial : ℝ) * ∑ S ∈ P.powersetCard k, ∏ v ∈ S, a v ≤ (∑ v ∈ P, a v) ^ k :=
by
  classical
  
  have bern : ∀ (A b : ℝ), 0 ≤ A → 0 ≤ b → ∀ n : ℕ,
      A ^ (n + 1) + ((n : ℝ) + 1) * A ^ n * b ≤ (A + b) ^ (n + 1) := by
    intro A b hA hb n
    induction n with
    | zero => simp
    | succ n ih =>
      have hAb : 0 ≤ A + b := add_nonneg hA hb
      have h1 := mul_le_mul_of_nonneg_left ih hAb
      have h2 : 0 ≤ ((n : ℝ) + 1) * A ^ n * b ^ 2 := by positivity
      have e1 : (A + b) ^ (n + 1 + 1) = (A + b) * (A + b) ^ (n + 1) := by ring
      have e2 : (A + b) * (A ^ (n + 1) + ((n : ℝ) + 1) * A ^ n * b)
          = A ^ (n + 1 + 1) + (((n + 1 : ℕ) : ℝ) + 1) * A ^ (n + 1) * b
            + ((n : ℝ) + 1) * A ^ n * b ^ 2 := by push_cast; ring
      rw [e1]
      linarith
  
  have pascal : ∀ (s : Finset α) (x : α), x ∉ s → ∀ n : ℕ,
      ∑ S ∈ (insert x s).powersetCard (n + 1), ∏ v ∈ S, a v
        = ∑ S ∈ s.powersetCard (n + 1), ∏ v ∈ S, a v
          + a x * ∑ S ∈ s.powersetCard n, ∏ v ∈ S, a v := by
    intro s x hx n
    rw [Finset.powersetCard_succ_insert hx n, Finset.sum_union]
    · congr 1
      rw [Finset.sum_image, Finset.mul_sum]
      · refine Finset.sum_congr rfl (fun U hU => ?_)
        have hxU : x ∉ U := fun h => hx ((Finset.mem_powersetCard.1 hU).1 h)
        rw [Finset.prod_insert hxU]
      · intro U hU U' hU' heq
        have hxU : x ∉ U := fun h => hx ((Finset.mem_powersetCard.1 (Finset.mem_coe.1 hU)).1 h)
        have hxU' : x ∉ U' :=
          fun h => hx ((Finset.mem_powersetCard.1 (Finset.mem_coe.1 hU')).1 h)
        have := congrArg (fun T => Finset.erase T x) heq
        simpa [Finset.erase_insert hxU, Finset.erase_insert hxU'] using this
    · rw [Finset.disjoint_left]
      intro T hT hT'
      obtain ⟨U, -, rfl⟩ := Finset.mem_image.1 hT'
      exact hx ((Finset.mem_powersetCard.1 hT).1 (Finset.mem_insert_self x U))
  
  have main : ∀ s : Finset α, (∀ v ∈ s, 0 ≤ a v) → ∀ k : ℕ,
      (k.factorial : ℝ) * ∑ S ∈ s.powersetCard k, ∏ v ∈ S, a v ≤ (∑ v ∈ s, a v) ^ k := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro _ k
      cases k with
      | zero => simp
      | succ j =>
        rw [Finset.powersetCard_eq_empty.2 (by simp)]
        simp
    | insert x s hx ih =>
      intro h k
      have hs : ∀ v ∈ s, 0 ≤ a v := fun v hv => h v (Finset.mem_insert_of_mem hv)
      have hx0 : 0 ≤ a x := h x (Finset.mem_insert_self x s)
      have hA : 0 ≤ ∑ v ∈ s, a v := Finset.sum_nonneg hs
      cases k with
      | zero => simp
      | succ j =>
        rw [pascal s x hx j, Finset.sum_insert hx]
        have I1 := ih hs (j + 1)
        have I2 := ih hs j
        have hb := bern (∑ v ∈ s, a v) (a x) hA hx0 j
        have hf : ((j + 1).factorial : ℝ) = ((j : ℝ) + 1) * (j.factorial : ℝ) := by
          rw [Nat.factorial_succ]; push_cast; ring
        have I2' := mul_le_mul_of_nonneg_left I2
          (mul_nonneg (by positivity : (0 : ℝ) ≤ (j : ℝ) + 1) hx0)
        have e : ((j + 1).factorial : ℝ) * (∑ S ∈ s.powersetCard (j + 1), ∏ v ∈ S, a v
            + a x * ∑ S ∈ s.powersetCard j, ∏ v ∈ S, a v)
            = ((j + 1).factorial : ℝ) * ∑ S ∈ s.powersetCard (j + 1), ∏ v ∈ S, a v
              + (((j : ℝ) + 1) * a x) *
                ((j.factorial : ℝ) * ∑ S ∈ s.powersetCard j, ∏ v ∈ S, a v) := by
          rw [hf]; ring
        rw [e, add_comm (a x)]
        nlinarith
  exact main P ha k

theorem kai_primorial_prime_ideals (K : Type u) [Field K] [NumberField K] (m : ℕ) :
    ∃ Ps : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (∀ v, v ∈ Ps ↔ ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal) ∧
      (∀ v ∈ Ps, 2 ≤ Ideal.absNorm v.asIdeal ∧
        Ideal.absNorm v.asIdeal ≤ m ^ Module.finrank ℚ K) ∧
      ∑ v ∈ Ps, (1 : ℝ) / (Ideal.absNorm v.asIdeal : ℝ)
        ≤ (Module.finrank ℚ K : ℝ) * (1 + Real.log m) :=
by
  classical
  
  have hA : ∀ p : ℕ, Ideal.absNorm
      (Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)}) = p ^ Module.finrank ℚ K := by
    intro p
    rw [Ideal.absNorm_span_singleton]
    have hcast : ((p : ℕ) : NumberField.RingOfIntegers K)
        = algebraMap ℤ (NumberField.RingOfIntegers K) (p : ℤ) := by simp
    rw [hcast, Algebra.norm_algebraMap_of_basis (NumberField.RingOfIntegers.basis K),
      ← Module.finrank_eq_card_basis (NumberField.RingOfIntegers.basis K),
      NumberField.RingOfIntegers.rank]
    simp [Int.natAbs_pow]
  
  have hs2 : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (p : ℕ),
      p.Prime → ((p : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal →
      ∃ f : ℕ, 1 ≤ f ∧ f ≤ Module.finrank ℚ K ∧ Ideal.absNorm v.asIdeal = p ^ f := by
    intro v p hp hpv
    have hle : Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)} ≤ v.asIdeal :=
      (Ideal.span_singleton_le_iff_mem _).2 hpv
    have hdvd := Ideal.absNorm_dvd_absNorm_of_le hle
    rw [hA p] at hdvd
    obtain ⟨f, hf, hfeq⟩ := (Nat.dvd_prime_pow hp).1 hdvd
    refine ⟨f, ?_, hf, hfeq⟩
    rcases Nat.eq_zero_or_pos f with h0 | h0
    · exfalso
      rw [h0, pow_zero, Ideal.absNorm_eq_one_iff] at hfeq
      exact v.isPrime.ne_top hfeq
    · exact h0
  
  have hs3 : ∀ (p : ℕ), p.Prime →
      ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))),
      (∀ v ∈ S, ((p : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal) →
      (∀ v ∈ S, p ≤ Ideal.absNorm v.asIdeal) → S.card ≤ Module.finrank ℚ K := by
    intro p hp S hS hN
    have hinj : Function.Injective
        (fun v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) => v.asIdeal) :=
      fun a b h => IsDedekindDomain.HeightOneSpectrum.ext h
    have hprod : (∏ I ∈ S.image (fun v => v.asIdeal), I)
        ∣ Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)} := by
      apply Finset.prod_primes_dvd
      · intro I hI
        obtain ⟨v, -, rfl⟩ := Finset.mem_image.1 hI
        exact v.prime
      · intro I hI
        obtain ⟨v, hv, rfl⟩ := Finset.mem_image.1 hI
        rw [Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
        exact hS v hv
    rw [Finset.prod_image (fun a _ b _ h => hinj h)] at hprod
    have h2 := map_dvd Ideal.absNorm hprod
    rw [map_prod, hA p] at h2
    have h3 : ∏ v ∈ S, Ideal.absNorm v.asIdeal ≤ p ^ Module.finrank ℚ K :=
      Nat.le_of_dvd (pow_pos hp.pos _) h2
    have h4 : p ^ S.card ≤ ∏ v ∈ S, Ideal.absNorm v.asIdeal :=
      Finset.pow_card_le_prod S _ p hN
    exact (Nat.pow_le_pow_iff_right hp.one_lt).1 (h4.trans h3)
  
  have hs4 : ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 : ℝ) / (p : ℝ)
      ≤ 1 + Real.log m := by
    have hsub : (Finset.range (m + 1)).filter Nat.Prime ⊆ Finset.Icc 1 m := by
      intro p hp
      rw [Finset.mem_filter, Finset.mem_range] at hp
      rw [Finset.mem_Icc]
      exact ⟨hp.2.one_lt.le, by omega⟩
    calc _ ≤ ∑ i ∈ Finset.Icc 1 m, (1 : ℝ) / (i : ℝ) :=
          Finset.sum_le_sum_of_subset_of_nonneg hsub (fun i _ _ => by positivity)
      _ = ((harmonic m : ℚ) : ℝ) := by
          rw [harmonic_eq_sum_Icc]; push_cast; simp [one_div]
      _ ≤ 1 + Real.log m := harmonic_le_one_add_log m
  
  have hW0 : ((primorial m : ℕ) : NumberField.RingOfIntegers K) ≠ 0 :=
    Nat.cast_ne_zero.2 (primorial_pos m).ne'
  have hspan : Ideal.span {((primorial m : ℕ) : NumberField.RingOfIntegers K)} ≠ 0 := by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hW0
  have hfin := Ideal.finite_factors hspan
  have hmem : ∀ v, v ∈ hfin.toFinset ↔
      ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
    intro v
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq, Ideal.dvd_iff_le,
      Ideal.span_singleton_le_iff_mem]
  
  have hex : ∀ v ∈ hfin.toFinset, ∃ p : ℕ, p.Prime ∧ p ≤ m ∧
      ((p : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
    intro v hv
    rw [hmem] at hv
    rw [primorial, Nat.cast_prod] at hv
    haveI := v.isPrime
    obtain ⟨p, hp, hpv⟩ := (Ideal.IsPrime.prod_mem_iff).1 hv
    rw [Finset.mem_filter, Finset.mem_range] at hp
    exact ⟨p, hp.2, by omega, hpv⟩
  have hge : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (p : ℕ),
      p.Prime → ((p : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal →
      p ≤ Ideal.absNorm v.asIdeal := by
    intro v p hp hpv
    obtain ⟨f, hf1, -, hfeq⟩ := hs2 v p hp hpv
    rw [hfeq]; exact Nat.le_self_pow (by omega) p
  refine ⟨hfin.toFinset, hmem, ?_, ?_⟩
  · 
    intro v hv
    obtain ⟨p, hp, hpm, hpv⟩ := hex v hv
    obtain ⟨f, hf1, hfn, hfeq⟩ := hs2 v p hp hpv
    refine ⟨hp.two_le.trans (hge v p hp hpv), ?_⟩
    rw [hfeq]
    calc p ^ f ≤ p ^ Module.finrank ℚ K := Nat.pow_le_pow_right hp.pos hfn
      _ ≤ m ^ Module.finrank ℚ K := Nat.pow_le_pow_left hpm _
  · 
    let g : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ := fun v =>
      if h : ∃ p : ℕ, p.Prime ∧ p ≤ m ∧ ((p : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal
      then Classical.choose h else 0
    have hg : ∀ v ∈ hfin.toFinset, (g v).Prime ∧ g v ≤ m ∧
        ((g v : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
      intro v hv
      have h := hex v hv
      simp only [g, dif_pos h]
      exact Classical.choose_spec h
    have hmaps : ∀ v ∈ hfin.toFinset, g v ∈ (Finset.range (m + 1)).filter Nat.Prime := by
      intro v hv
      obtain ⟨h1, h2, -⟩ := hg v hv
      rw [Finset.mem_filter, Finset.mem_range]; exact ⟨by omega, h1⟩
    rw [← Finset.sum_fiberwise_of_maps_to hmaps]
    calc ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime,
          ∑ v ∈ hfin.toFinset.filter (fun v => g v = p), (1 : ℝ) / (Ideal.absNorm v.asIdeal : ℝ)
        ≤ ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime,
            (Module.finrank ℚ K : ℝ) * (1 / (p : ℝ)) := by
          apply Finset.sum_le_sum
          intro p hp
          rw [Finset.mem_filter] at hp
          have hp' := hp.2
          have hppos : (0 : ℝ) < p := by exact_mod_cast hp'.pos
          have hfib : ∀ v ∈ hfin.toFinset.filter (fun v => g v = p),
              ((p : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
            intro v hv
            rw [Finset.mem_filter] at hv
            have := (hg v hv.1).2.2
            rw [hv.2] at this
            exact this
          have hcard := hs3 p hp' (hfin.toFinset.filter (fun v => g v = p)) hfib
            (fun v hv => hge v p hp' (hfib v hv))
          calc ∑ v ∈ hfin.toFinset.filter (fun v => g v = p),
                (1 : ℝ) / (Ideal.absNorm v.asIdeal : ℝ)
              ≤ ∑ v ∈ hfin.toFinset.filter (fun v => g v = p), (1 : ℝ) / (p : ℝ) := by
                apply Finset.sum_le_sum
                intro v hv
                apply one_div_le_one_div_of_le hppos
                exact_mod_cast hge v p hp' (hfib v hv)
            _ = ((hfin.toFinset.filter (fun v => g v = p)).card : ℝ) * (1 / (p : ℝ)) := by
                rw [Finset.sum_const, nsmul_eq_mul]
            _ ≤ (Module.finrank ℚ K : ℝ) * (1 / (p : ℝ)) :=
                mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) (by positivity)
      _ = (Module.finrank ℚ K : ℝ) *
            ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 : ℝ) / (p : ℝ) := by
          rw [Finset.mul_sum]
      _ ≤ (Module.finrank ℚ K : ℝ) * (1 + Real.log m) :=
          mul_le_mul_of_nonneg_left hs4 (Nat.cast_nonneg _)

theorem kai_height_one_finset_prod (K : Type u) [Field K] [NumberField K]
    (S T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
    (∀ x : NumberField.RingOfIntegers K,
        x ∈ (∏ v ∈ S, v.asIdeal) ↔ ∀ v ∈ S, x ∈ v.asIdeal) ∧
    (∏ v ∈ S, v.asIdeal) ≠ ⊥ ∧
    Ideal.absNorm (∏ v ∈ S, v.asIdeal) = ∏ v ∈ S, Ideal.absNorm v.asIdeal ∧
    ((∏ v ∈ S, v.asIdeal) = ∏ v ∈ T, v.asIdeal → S = T) :=
by
  classical
  
  have key : ∀ (U : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∈ U ↔ (∏ w ∈ U, w.asIdeal) ≤ v.asIdeal := by
    intro U v
    rw [Ideal.IsPrime.prod_le v.isPrime]
    constructor
    · intro hv
      exact ⟨v, hv, le_rfl⟩
    · rintro ⟨w, hw, hle⟩
      have heq : w.asIdeal = v.asIdeal :=
        Ideal.IsMaximal.eq_of_le w.isMaximal v.isPrime.ne_top hle
      have : w = v := IsDedekindDomain.HeightOneSpectrum.ext heq
      rw [← this]
      exact hw
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro x
    induction S using Finset.induction_on with
    | empty => simp
    | insert v₀ S' hv₀ ih =>
      rw [Finset.prod_insert hv₀]
      have hcop : IsCoprime v₀.asIdeal (∏ v ∈ S', v.asIdeal) := by
        apply IsCoprime.prod_right
        intro v hv
        have hne : v₀.asIdeal ≠ v.asIdeal := by
          intro h
          have : v₀ = v := IsDedekindDomain.HeightOneSpectrum.ext h
          exact hv₀ (this ▸ hv)
        haveI := v₀.isMaximal
        haveI := v.isMaximal
        exact Ideal.isCoprime_of_isMaximal hne
      rw [← Ideal.inf_eq_mul_of_isCoprime hcop, Ideal.mem_inf, ih, Finset.forall_mem_insert]
  · rw [← Ideal.zero_eq_bot]
    exact Finset.prod_ne_zero_iff.mpr (fun v _ => by rw [Ideal.zero_eq_bot]; exact v.ne_bot)
  · exact map_prod Ideal.absNorm _ S
  · intro h
    ext v
    rw [key S v, key T v, h]

theorem kai_brun_sieve_identity (K : Type u) [Field K] [NumberField K]
    (Ps : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) (r : ℕ) :
    ∃ (I : Finset (Ideal (NumberField.RingOfIntegers K)))
      (A : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ 𝔡 ∈ I, ∃ S ⊆ Ps, S.card ≤ r ∧ 𝔡 = ∏ v ∈ S, v.asIdeal) ∧
      (∀ 𝔡, ‖A 𝔡‖ ≤ 1) ∧
      ∀ x : NumberField.RingOfIntegers K,
        ‖@ite ℂ (∀ v ∈ Ps, x ∉ v.asIdeal) (Classical.propDecidable _) 1 0
            - ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0‖
          ≤ ((@Finset.filter (Finset (IsDedekindDomain.HeightOneSpectrum
                (NumberField.RingOfIntegers K)))
              (fun S => x ∈ ∏ v ∈ S, v.asIdeal) (fun _ => Classical.propDecidable _)
              (Ps.powersetCard (r + 1))).card : ℝ) :=
by
  classical
  
  have hmem : ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (x : NumberField.RingOfIntegers K),
      x ∈ (∏ v ∈ S, v.asIdeal) ↔ ∀ v ∈ S, x ∈ v.asIdeal := by
    intro S x
    induction S using Finset.induction_on with
    | empty => simp
    | insert v₀ S' hv₀ ih =>
      rw [Finset.prod_insert hv₀]
      have hcop : IsCoprime v₀.asIdeal (∏ v ∈ S', v.asIdeal) := by
        apply IsCoprime.prod_right
        intro v hv
        have hne : v₀.asIdeal ≠ v.asIdeal := by
          intro h
          have : v₀ = v := IsDedekindDomain.HeightOneSpectrum.ext h
          exact hv₀ (this ▸ hv)
        haveI := v₀.isMaximal
        haveI := v.isMaximal
        exact Ideal.isCoprime_of_isMaximal hne
      rw [← Ideal.inf_eq_mul_of_isCoprime hcop, Ideal.mem_inf, ih, Finset.forall_mem_insert]
  
  have key : ∀ (U : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∈ U ↔ (∏ w ∈ U, w.asIdeal) ≤ v.asIdeal := by
    intro U v
    rw [Ideal.IsPrime.prod_le v.isPrime]
    constructor
    · intro hv
      exact ⟨v, hv, le_rfl⟩
    · rintro ⟨w, hw, hle⟩
      have heq : w.asIdeal = v.asIdeal :=
        Ideal.IsMaximal.eq_of_le w.isMaximal v.isPrime.ne_top hle
      have : w = v := IsDedekindDomain.HeightOneSpectrum.ext heq
      rw [← this]
      exact hw
  have hinj : ∀ (S T : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K))),
      (∏ v ∈ S, v.asIdeal) = ∏ v ∈ T, v.asIdeal → S = T := by
    intro S T h
    ext v
    rw [key S v, key T v, h]
  
  have hZ : ∀ n : ℕ, ∑ m ∈ Finset.range (n + 1),
      n.choose m • (if m ≤ r then (-1 : ℤ) ^ m else 0)
        = ∑ j ∈ Finset.range (r + 1), (-1 : ℤ) ^ j * (n.choose j : ℤ) := by
    intro n
    have h1 : ∑ m ∈ Finset.range (n + 1), n.choose m • (if m ≤ r then (-1 : ℤ) ^ m else 0)
        = ∑ m ∈ Finset.range (n + r + 1),
            if m ≤ r then (-1 : ℤ) ^ m * (n.choose m : ℤ) else 0 := by
      have hsub : Finset.range (n + 1) ⊆ Finset.range (n + r + 1) := by
        intro m hm
        simp only [Finset.mem_range] at hm ⊢
        omega
      rw [Finset.sum_subset hsub]
      · refine Finset.sum_congr rfl (fun m _ => ?_)
        split_ifs
        · rw [nsmul_eq_mul, mul_comm]
        · simp
      · intro m _ hm
        rw [Finset.mem_range, not_lt] at hm
        simp [Nat.choose_eq_zero_of_lt (by omega : n < m)]
    have h2 : ∑ j ∈ Finset.range (r + 1), (-1 : ℤ) ^ j * (n.choose j : ℤ)
        = ∑ m ∈ Finset.range (n + r + 1),
            if m ≤ r then (-1 : ℤ) ^ m * (n.choose m : ℤ) else 0 := by
      rw [← Finset.sum_filter]
      congr 1
      ext m
      simp only [Finset.mem_filter, Finset.mem_range]
      omega
    rw [h1, h2]
  have brun : ∀ P : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      ‖(if P.card = 0 then (1 : ℂ) else 0)
          - ∑ S ∈ P.powerset.filter (fun S => S.card ≤ r), (-1 : ℂ) ^ S.card‖
        ≤ ((P.powersetCard (r + 1)).card : ℝ) := by
    intro P
    have hσ : ((∑ S ∈ P.powerset.filter (fun S => S.card ≤ r), (-1 : ℤ) ^ S.card : ℤ) : ℂ)
        = ∑ S ∈ P.powerset.filter (fun S => S.card ≤ r), (-1 : ℂ) ^ S.card := by
      push_cast; rfl
    have hσZ : ∑ S ∈ P.powerset.filter (fun S => S.card ≤ r), (-1 : ℤ) ^ S.card
        = ∑ j ∈ Finset.range (r + 1), (-1 : ℤ) ^ j * (P.card.choose j : ℤ) := by
      rw [Finset.sum_filter, ← hZ]
      exact Finset.sum_powerset_apply_card (fun m => if m ≤ r then (-1 : ℤ) ^ m else 0)
    rcases Nat.eq_zero_or_pos P.card with h0 | hpos
    · have hP : P = ∅ := Finset.card_eq_zero.1 h0
      subst hP
      simp [Finset.filter_singleton]
    · obtain ⟨N', hN'⟩ : ∃ N', P.card = N' + 1 := ⟨P.card - 1, by omega⟩
      rw [if_neg (by omega), ← hσ, hσZ, hN', Int.alternating_sum_range_choose_eq_choose,
        zero_sub, norm_neg, Complex.norm_intCast]
      push_cast
      rw [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul, Nat.abs_cast,
        Finset.card_powersetCard, hN', Nat.choose_succ_succ']
      push_cast
      linarith [(Nat.cast_nonneg (N'.choose (r + 1)) : (0 : ℝ) ≤ (N'.choose (r + 1) : ℝ))]
  
  obtain ⟨F, hF⟩ : ∃ F : Finset (Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K))), F = Ps.powerset.filter (fun S => S.card ≤ r) :=
    ⟨_, rfl⟩
  have hFmem : ∀ S, S ∈ F ↔ S ⊆ Ps ∧ S.card ≤ r := by
    intro S; rw [hF, Finset.mem_filter, Finset.mem_powerset]
  obtain ⟨A, hA⟩ : ∃ A : Ideal (NumberField.RingOfIntegers K) → ℂ, ∀ 𝔡, A 𝔡 =
      ∑ S ∈ F.filter (fun S => (∏ v ∈ S, v.asIdeal) = 𝔡), (-1 : ℂ) ^ S.card :=
    ⟨_, fun _ => rfl⟩
  have hAval : ∀ T ∈ F, A (∏ v ∈ T, v.asIdeal) = (-1 : ℂ) ^ T.card := by
    intro T hT
    have hfT : F.filter (fun S => (∏ v ∈ S, v.asIdeal) = ∏ v ∈ T, v.asIdeal) = {T} := by
      ext S
      simp only [Finset.mem_filter, Finset.mem_singleton]
      constructor
      · rintro ⟨_, h⟩; exact hinj S T h
      · rintro rfl; exact ⟨hT, rfl⟩
    rw [hA, hfT, Finset.sum_singleton]
  refine ⟨F.image (fun S => ∏ v ∈ S, v.asIdeal), A, ?_, ?_, ?_⟩
  · intro 𝔡 h𝔡
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.1 h𝔡
    obtain ⟨h1, h2⟩ := (hFmem S).1 hS
    exact ⟨S, h1, h2, rfl⟩
  · intro 𝔡
    rw [hA]
    refine (norm_sum_le _ _).trans ?_
    simp only [norm_pow, norm_neg, norm_one, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one]
    have hle : (F.filter (fun S => (∏ v ∈ S, v.asIdeal) = 𝔡)).card ≤ 1 := by
      refine Finset.card_le_one.2 (fun a ha b hb => ?_)
      have ha' : (∏ v ∈ a, v.asIdeal) = 𝔡 := (Finset.mem_filter.1 ha).2
      have hb' : (∏ v ∈ b, v.asIdeal) = 𝔡 := (Finset.mem_filter.1 hb).2
      exact hinj a b (ha'.trans hb'.symm)
    exact_mod_cast hle
  · intro x
    obtain ⟨Px, hPx⟩ : ∃ Px : Finset (IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K)), Px = Ps.filter (fun v => x ∈ v.asIdeal) := ⟨_, rfl⟩
    have hPxPs : Px ⊆ Ps := by rw [hPx]; exact Finset.filter_subset _ _
    have hK1 : ∀ S ⊆ Ps, (x ∈ (∏ v ∈ S, v.asIdeal) ↔ S ⊆ Px) := by
      intro S hS
      rw [hmem S x, hPx]
      constructor
      · intro h v hv
        exact Finset.mem_filter.2 ⟨hS hv, h v hv⟩
      · intro h v hv
        exact (Finset.mem_filter.1 (h hv)).2
    have hsum : ∑ 𝔡 ∈ F.image (fun S => ∏ v ∈ S, v.asIdeal),
        A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0
          = ∑ S ∈ Px.powerset.filter (fun S => S.card ≤ r), (-1 : ℂ) ^ S.card := by
      rw [Finset.sum_image (fun S _ T _ h => hinj S T h)]
      have hfil : Px.powerset.filter (fun S => S.card ≤ r) = F.filter (fun S => S ⊆ Px) := by
        ext S
        simp only [Finset.mem_filter, Finset.mem_powerset, hFmem]
        constructor
        · rintro ⟨h1, h2⟩; exact ⟨⟨h1.trans hPxPs, h2⟩, h1⟩
        · rintro ⟨⟨_, h2⟩, h3⟩; exact ⟨h3, h2⟩
      rw [hfil, Finset.sum_filter]
      refine Finset.sum_congr rfl (fun S hS => ?_)
      rw [hAval S hS]
      have hSPs := ((hFmem S).1 hS).1
      by_cases h : S ⊆ Px
      · rw [if_pos ((hK1 S hSPs).2 h), if_pos h, mul_one]
      · rw [if_neg (fun h' => h ((hK1 S hSPs).1 h')), if_neg h, mul_zero]
    have hind : @ite ℂ (∀ v ∈ Ps, x ∉ v.asIdeal) (Classical.propDecidable _) 1 0
        = if Px.card = 0 then 1 else 0 := by
      have hiff : (∀ v ∈ Ps, x ∉ v.asIdeal) ↔ Px.card = 0 := by
        rw [Finset.card_eq_zero, hPx, Finset.filter_eq_empty_iff]
      by_cases h : ∀ v ∈ Ps, x ∉ v.asIdeal
      · rw [if_pos h, if_pos (hiff.1 h)]
      · rw [if_neg h, if_neg (fun h' => h (hiff.2 h'))]
    have hRHS : (@Finset.filter (Finset (IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers K)))
        (fun S => x ∈ ∏ v ∈ S, v.asIdeal) (fun _ => Classical.propDecidable _)
        (Ps.powersetCard (r + 1))) = Px.powersetCard (r + 1) := by
      ext S
      simp only [Finset.mem_filter, Finset.mem_powersetCard]
      constructor
      · rintro ⟨⟨h1, h2⟩, h3⟩; exact ⟨(hK1 S h1).1 h3, h2⟩
      · rintro ⟨h1, h2⟩; exact ⟨⟨h1.trans hPxPs, h2⟩, (hK1 S (h1.trans hPxPs)).2 h1⟩
    rw [hsum, hind, hRHS]
    exact brun Px

theorem kai_brun_thresholds (n : ℕ) :
    ∃ L₀ : ℝ, 1 ≤ L₀ ∧ ∀ ℓ : ℝ, L₀ ≤ ℓ →
      Real.exp 2 * (n : ℝ) * (1 + ℓ ^ ((1:ℝ)/3)) ≤ Real.sqrt ℓ ∧
      ℓ ^ ((1:ℝ)/3) * (Real.sqrt ℓ + 2) ≤ ℓ / 4 ∧
      (n : ℝ) * ℓ ^ ((1:ℝ)/3) * (Real.sqrt ℓ + 3) + Real.log n ≤ ℓ :=
by
  have hE : 0 ≤ Real.exp 2 := (Real.exp_pos 2).le
  have hN : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
  have hEN : 0 ≤ Real.exp 2 * (n : ℝ) := mul_nonneg hE hN
  obtain ⟨S, hS_def⟩ : ∃ S : ℝ, S = 12 + 2 * Real.exp 2 * (n : ℝ) + 5 * (n : ℝ) := ⟨_, rfl⟩
  have hS12 : 12 ≤ S := by rw [hS_def]; nlinarith
  have hSE : 2 * (Real.exp 2 * (n : ℝ)) ≤ S := by rw [hS_def]; nlinarith
  have hSN : 5 * (n : ℝ) ≤ S := by rw [hS_def]; nlinarith
  have hS0 : 0 ≤ S := by linarith
  refine ⟨S ^ 6, one_le_pow₀ (by linarith), ?_⟩
  intro ℓ hℓ
  have hS6 : 1 ≤ S ^ 6 := one_le_pow₀ (by linarith)
  have hℓ0 : 0 ≤ ℓ := by linarith
  obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = ℓ ^ ((1:ℝ)/6) := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := by rw [hs_def]; exact Real.rpow_nonneg hℓ0 _
  have hpow : ∀ k : ℕ, ℓ ^ ((1:ℝ)/6 * (k : ℝ)) = s ^ k := by
    intro k
    rw [Real.rpow_mul hℓ0, Real.rpow_natCast, hs_def]
  have h3 : ℓ ^ ((1:ℝ)/3) = s ^ 2 := by
    rw [← hpow 2]; norm_num
  have h2 : Real.sqrt ℓ = s ^ 3 := by
    rw [Real.sqrt_eq_rpow, ← hpow 3]; norm_num
  have h6 : ℓ = s ^ 6 := by
    rw [← hpow 6]; norm_num
  rw [h3, h2]
  have hSs : S ≤ s := by
    apply le_of_pow_le_pow_left₀ (by norm_num : (6:ℕ) ≠ 0) hs0
    rw [← h6]; exact hℓ
  have hs1 : 1 ≤ s := by linarith
  have hs2 : 1 ≤ s ^ 2 := one_le_pow₀ hs1
  have hs5 : 1 ≤ s ^ 5 := one_le_pow₀ hs1
  have hs25 : s ^ 2 ≤ s ^ 5 := pow_le_pow_right₀ hs1 (by norm_num)
  have hlog : Real.log (n : ℝ) ≤ (n : ℝ) := Real.log_le_self hN
  refine ⟨?_, ?_, ?_⟩
  · have a1 : Real.exp 2 * (n : ℝ) * (1 + s ^ 2) ≤ Real.exp 2 * (n : ℝ) * (2 * s ^ 2) :=
      mul_le_mul_of_nonneg_left (by linarith) hEN
    have a2 : (2 * (Real.exp 2 * (n : ℝ))) * s ^ 2 ≤ s * s ^ 2 :=
      mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    have e1 : s ^ 3 = s * s ^ 2 := by ring
    have e2 : Real.exp 2 * (n : ℝ) * (2 * s ^ 2) = (2 * (Real.exp 2 * (n : ℝ))) * s ^ 2 := by
      ring
    linarith
  · have a1 : 12 * s ^ 5 ≤ s * s ^ 5 := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    have e1 : s ^ 2 * (s ^ 3 + 2) = s ^ 5 + 2 * s ^ 2 := by ring
    have e2 : s * s ^ 5 = s ^ 6 := by ring
    rw [h6, e1]
    linarith
  · have a1 : (n : ℝ) * s ^ 2 ≤ (n : ℝ) * s ^ 5 := mul_le_mul_of_nonneg_left hs25 hN
    have a2 : (n : ℝ) ≤ (n : ℝ) * s ^ 5 := le_mul_of_one_le_right hN hs5
    have a3 : (5 * (n : ℝ)) * s ^ 5 ≤ s * s ^ 5 :=
      mul_le_mul_of_nonneg_right (hSN.trans hSs) (by positivity)
    have e1 : (n : ℝ) * s ^ 2 * (s ^ 3 + 3) = (n : ℝ) * s ^ 5 + 3 * ((n : ℝ) * s ^ 2) := by ring
    have e2 : s * s ^ 5 = s ^ 6 := by ring
    rw [h6, e1]
    linarith

theorem kai_brun_factorial_tail (H : ℝ) (k : ℕ) (hH : 0 ≤ H)
    (hk : Real.exp 2 * H ≤ (k : ℝ)) :
    H ^ k / (k.factorial : ℝ) ≤ Real.exp (-(k : ℝ)) :=
by
  have hfac : (k : ℝ) ^ k / (k.factorial : ℝ) ≤ Real.exp (k : ℝ) :=
    Real.pow_div_factorial_le_exp _ (Nat.cast_nonneg k) k
  have hfpos : (0 : ℝ) < (k.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos k
  have hE : 0 < Real.exp (-2 : ℝ) := Real.exp_pos _
  have hH' : H ≤ (k : ℝ) * Real.exp (-2 : ℝ) := by
    have h1 : Real.exp (-2 : ℝ) * Real.exp 2 = 1 := by
      rw [← Real.exp_add]; norm_num
    calc H = Real.exp (-2 : ℝ) * (Real.exp 2 * H) := by
          rw [← mul_assoc, h1, one_mul]
      _ ≤ Real.exp (-2 : ℝ) * (k : ℝ) := mul_le_mul_of_nonneg_left hk hE.le
      _ = (k : ℝ) * Real.exp (-2 : ℝ) := mul_comm _ _
  have hpow : H ^ k ≤ ((k : ℝ) * Real.exp (-2 : ℝ)) ^ k := pow_le_pow_left₀ hH hH' k
  have hexp : Real.exp (k : ℝ) * Real.exp (-2 : ℝ) ^ k = Real.exp (-(k : ℝ)) := by
    rw [← Real.exp_nat_mul, ← Real.exp_add]; congr 1; ring
  calc H ^ k / (k.factorial : ℝ)
      ≤ ((k : ℝ) * Real.exp (-2 : ℝ)) ^ k / (k.factorial : ℝ) :=
        div_le_div_of_nonneg_right hpow hfpos.le
    _ = ((k : ℝ) ^ k / (k.factorial : ℝ)) * Real.exp (-2 : ℝ) ^ k := by
        rw [mul_pow]; ring
    _ ≤ Real.exp (k : ℝ) * Real.exp (-2 : ℝ) ^ k :=
        mul_le_mul_of_nonneg_right hfac (pow_nonneg hE.le k)
    _ = Real.exp (-(k : ℝ)) := hexp

theorem kai_brun_coprime_decomp (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ M₀ : ℝ, 3 ≤ M₀ ∧ ∀ (M : ℝ) (m : ℕ), M₀ ≤ M →
      (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
      ∃ (I : Finset (Ideal (NumberField.RingOfIntegers K)))
        (A : Ideal (NumberField.RingOfIntegers K) → ℂ),
        (∀ 𝔡 ∈ I, 𝔡 ≠ ⊥ ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ M ^ ((Module.finrank ℚ K : ℝ) / 4)) ∧
        (∀ 𝔡, ‖A 𝔡‖ ≤ 1) ∧
        ∑ x ∈ omegaBox ω M,
            ‖@ite ℂ (CoprimeToNat (primorial m) x) (Classical.propDecidable _) 1 0
              - ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0‖
          ≤ ((omegaBox ω M).card : ℝ) * Real.exp (-Real.sqrt (Real.log M)) :=
by
  classical
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hnR : (1:ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn1
  have hnpos : (0:ℝ) < (Module.finrank ℚ K : ℝ) := by linarith
  
  obtain ⟨L₀, hL₀1, hthr⟩ := kai_brun_thresholds (Module.finrank ℚ K)
  refine ⟨max 3 (Real.exp L₀), le_max_left _ _, ?_⟩
  intro M m hM hm
  have hM3 : (3:ℝ) ≤ M := le_trans (le_max_left _ _) hM
  have hMpos : (0:ℝ) < M := by linarith
  obtain ⟨ℓ, hℓ_def⟩ : ∃ ℓ : ℝ, ℓ = Real.log M := ⟨_, rfl⟩
  have hL₀ℓ : L₀ ≤ ℓ := by
    rw [hℓ_def, Real.le_log_iff_exp_le hMpos]; exact le_trans (le_max_right _ _) hM
  have hℓ1 : 1 ≤ ℓ := le_trans hL₀1 hL₀ℓ
  have hℓ0 : 0 ≤ ℓ := by linarith
  obtain ⟨hS1, hS2, hS3⟩ := hthr ℓ hL₀ℓ
  rw [← hℓ_def] at hm ⊢
  obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = ℓ ^ ((1:ℝ)/3) := ⟨_, rfl⟩
  rw [← ht_def] at hm hS1 hS2 hS3
  have ht0 : 0 ≤ t := by rw [ht_def]; exact Real.rpow_nonneg hℓ0 _
  have hexpℓ : Real.exp ℓ = M := by rw [hℓ_def]; exact Real.exp_log hMpos
  have hF1 : Real.log (m : ℝ) ≤ t := by
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · rw [h0, Nat.cast_zero, Real.log_zero]; exact ht0
    · have hmpos : (0:ℝ) < m := by exact_mod_cast hpos
      calc Real.log (m : ℝ) ≤ Real.log (Real.exp t) := Real.log_le_log hmpos (by linarith)
        _ = t := Real.log_exp t
  obtain ⟨E, hE_def⟩ : ∃ E : ℝ, E = Real.exp ((Module.finrank ℚ K : ℝ) * t) := ⟨_, rfl⟩
  have hF2 : (m : ℝ) ^ Module.finrank ℚ K ≤ E := by
    rw [hE_def, Real.exp_nat_mul]
    exact pow_le_pow_left₀ (Nat.cast_nonneg _) (by linarith) _
  have hE1 : 1 ≤ E := by rw [hE_def]; exact Real.one_le_exp (mul_nonneg hnpos.le ht0)
  obtain ⟨r, hr_def⟩ : ∃ r : ℕ, r = ⌊Real.sqrt ℓ⌋₊ + 2 := ⟨_, rfl⟩
  have hsq0 : 0 ≤ Real.sqrt ℓ := Real.sqrt_nonneg ℓ
  have hrR : (r : ℝ) = (⌊Real.sqrt ℓ⌋₊ : ℝ) + 2 := by rw [hr_def]; push_cast; ring
  have hr1 : Real.sqrt ℓ + 1 < (r : ℝ) := by
    have := Nat.lt_floor_add_one (Real.sqrt ℓ); rw [hrR]; linarith
  have hr2 : (r : ℝ) ≤ Real.sqrt ℓ + 2 := by
    have := Nat.floor_le hsq0; rw [hrR]; linarith
  
  obtain ⟨Ps, hP1, hP2, hP3⟩ := kai_primorial_prime_ideals K m
  obtain ⟨I, A, hI1, hI2, hI3⟩ := kai_brun_sieve_identity K Ps r
  have hnormS : ∀ S ⊆ Ps, (Ideal.absNorm (∏ v ∈ S, v.asIdeal) : ℝ) ≤ E ^ S.card := by
    intro S hS
    obtain ⟨-, -, hN, -⟩ := kai_height_one_finset_prod K S S
    rw [hN, Nat.cast_prod, ← Finset.prod_const]
    apply Finset.prod_le_prod (fun _ _ => Nat.cast_nonneg _)
    intro v hv
    have h := (hP2 v (hS hv)).2
    have h' : (Ideal.absNorm v.asIdeal : ℝ) ≤ (m : ℝ) ^ Module.finrank ℚ K := by exact_mod_cast h
    exact h'.trans hF2
  refine ⟨I, A, ?_, hI2, ?_⟩
  · intro 𝔡 h𝔡
    obtain ⟨S, hSP, hSr, rfl⟩ := hI1 𝔡 h𝔡
    obtain ⟨-, hne, -, -⟩ := kai_height_one_finset_prod K S S
    refine ⟨hne, ?_⟩
    calc (Ideal.absNorm (∏ v ∈ S, v.asIdeal) : ℝ) ≤ E ^ S.card := hnormS S hSP
      _ ≤ E ^ r := pow_le_pow_right₀ hE1 hSr
      _ = Real.exp ((r:ℝ) * ((Module.finrank ℚ K : ℝ) * t)) := by
          rw [hE_def, ← Real.exp_nat_mul]
      _ ≤ Real.exp (ℓ * ((Module.finrank ℚ K : ℝ) / 4)) := by
          apply Real.exp_le_exp.2
          have h1 : (r:ℝ) * ((Module.finrank ℚ K : ℝ) * t)
              ≤ (Real.sqrt ℓ + 2) * ((Module.finrank ℚ K : ℝ) * t) :=
            mul_le_mul_of_nonneg_right hr2 (mul_nonneg hnpos.le ht0)
          have h2 : (Module.finrank ℚ K : ℝ) * (t * (Real.sqrt ℓ + 2))
              ≤ (Module.finrank ℚ K : ℝ) * (ℓ / 4) :=
            mul_le_mul_of_nonneg_left hS2 hnpos.le
          linarith
      _ = M ^ ((Module.finrank ℚ K : ℝ) / 4) := by
          rw [Real.rpow_def_of_pos hMpos, ← hℓ_def]
  · 
    obtain ⟨F, hF_def⟩ : ∃ F : ℕ, F = ⌊M⌋₊ := ⟨_, rfl⟩
    have hBcard : (omegaBox ω M).card = (2 * F + 1) ^ Module.finrank ℚ K := by
      unfold omegaBox intBox
      rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective, Pi.card_Icc]
      simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      congr 1
      rw [hF_def]; omega
    obtain ⟨Lb, hLb⟩ : ∃ Lb : ℝ, Lb = 2 * (F : ℝ) + 1 := ⟨_, rfl⟩
    have hBcardR : ((omegaBox ω M).card : ℝ) = Lb ^ Module.finrank ℚ K := by
      rw [hBcard, hLb]; push_cast; ring
    have hMLb : M ≤ Lb := by
      have h := Nat.lt_floor_add_one M
      rw [← hF_def] at h
      rw [hLb]; linarith
    have hLbpos : 0 < Lb := by linarith
    
    have hpt : ∀ x : NumberField.RingOfIntegers K,
        ‖@ite ℂ (CoprimeToNat (primorial m) x) (Classical.propDecidable _) 1 0
          - ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0‖
        ≤ (((Ps.powersetCard (r + 1)).filter
            (fun S => x ∈ ∏ v ∈ S, v.asIdeal)).card : ℝ) := by
      intro x
      have hiff : CoprimeToNat (primorial m) x ↔ ∀ v ∈ Ps, x ∉ v.asIdeal := by
        unfold CoprimeToNat
        constructor
        · intro h v hv; exact h v ((hP1 v).1 hv)
        · intro h v hv; exact h v ((hP1 v).2 hv)
      have heq : @ite ℂ (CoprimeToNat (primorial m) x) (Classical.propDecidable _) 1 0
          = @ite ℂ (∀ v ∈ Ps, x ∉ v.asIdeal) (Classical.propDecidable _) 1 0 := by
        by_cases hc : CoprimeToNat (primorial m) x
        · rw [if_pos hc, if_pos (hiff.1 hc)]
        · rw [if_neg hc, if_neg (fun h' => hc (hiff.2 h'))]
      rw [heq]
      convert hI3 x using 4
    have hsum1 := Finset.sum_le_sum (fun x (_ : x ∈ omegaBox ω M) => hpt x)
    have hexch : ∑ x ∈ omegaBox ω M, ((((Ps.powersetCard (r + 1)).filter
            (fun S => x ∈ ∏ v ∈ S, v.asIdeal)).card : ℕ) : ℝ)
        = ∑ S ∈ Ps.powersetCard (r + 1), ((((omegaBox ω M).filter
            (fun x => x ∈ ∏ v ∈ S, v.asIdeal)).card : ℕ) : ℝ) := by
      have hnat : ∑ x ∈ omegaBox ω M, ((Ps.powersetCard (r + 1)).filter
            (fun S => x ∈ ∏ v ∈ S, v.asIdeal)).card
          = ∑ S ∈ Ps.powersetCard (r + 1), ((omegaBox ω M).filter
            (fun x => x ∈ ∏ v ∈ S, v.asIdeal)).card := by
        simp only [Finset.card_filter]
        exact Finset.sum_comm
      exact_mod_cast hnat
    
    have hperS : ∀ S ∈ Ps.powersetCard (r + 1), ((((omegaBox ω M).filter
          (fun x => x ∈ ∏ v ∈ S, v.asIdeal)).card : ℕ) : ℝ)
        ≤ Real.exp 1 * Lb ^ Module.finrank ℚ K
            * ∏ v ∈ S, (1 / (Ideal.absNorm v.asIdeal : ℝ)) := by
      intro S hS
      rw [Finset.mem_powersetCard] at hS
      obtain ⟨hSP, hScard⟩ := hS
      obtain ⟨-, hne, hN, -⟩ := kai_height_one_finset_prod K S S
      have hcount := kai_ideal_box_count K ω M (∏ v ∈ S, v.asIdeal) hne
      obtain ⟨NS, hNS_def⟩ : ∃ NS : ℕ, NS = Ideal.absNorm (∏ v ∈ S, v.asIdeal) := ⟨_, rfl⟩
      have hNS0 : NS ≠ 0 := by
        rw [hNS_def]; exact fun h => hne (Ideal.absNorm_eq_zero_iff.1 h)
      have hNSpos : (0:ℝ) < NS := by exact_mod_cast Nat.pos_of_ne_zero hNS0
      have hNSsize : (Module.finrank ℚ K : ℝ) * NS ≤ Lb := by
        have h1 : (NS : ℝ) ≤ E ^ (r + 1) := by rw [hNS_def, ← hScard]; exact hnormS S hSP
        have h2 : E ^ (r + 1) ≤ M / (Module.finrank ℚ K : ℝ) := by
          rw [hE_def, ← Real.exp_nat_mul]
          calc Real.exp (((r + 1 : ℕ) : ℝ) * ((Module.finrank ℚ K : ℝ) * t))
              ≤ Real.exp (ℓ - Real.log (Module.finrank ℚ K : ℝ)) := by
                apply Real.exp_le_exp.2
                push_cast
                have h3 : ((r:ℝ) + 1) * ((Module.finrank ℚ K : ℝ) * t)
                    ≤ (Real.sqrt ℓ + 3) * ((Module.finrank ℚ K : ℝ) * t) :=
                  mul_le_mul_of_nonneg_right (by linarith) (mul_nonneg hnpos.le ht0)
                linarith
            _ = M / (Module.finrank ℚ K : ℝ) := by
                rw [Real.exp_sub, hexpℓ, Real.exp_log hnpos]
        have h4 := mul_le_mul_of_nonneg_left h1 hnpos.le
        rw [le_div_iff₀ hnpos] at h2
        linarith
      have hcountR : (NS : ℝ) * ((((omegaBox ω M).filter
          (fun x => x ∈ ∏ v ∈ S, v.asIdeal)).card : ℕ) : ℝ)
          ≤ (2 * (F:ℝ) + NS) ^ Module.finrank ℚ K := by
        rw [← hNS_def, ← hF_def] at hcount
        exact_mod_cast hcount
      have hpow : (2 * (F:ℝ) + NS) ^ Module.finrank ℚ K
          ≤ Real.exp 1 * Lb ^ Module.finrank ℚ K := by
        have h1 : 2 * (F:ℝ) + NS ≤ Lb * Real.exp (1 / (Module.finrank ℚ K : ℝ)) := by
          have h2 : (NS:ℝ) / Lb ≤ 1 / (Module.finrank ℚ K : ℝ) := by
            rw [div_le_div_iff₀ hLbpos hnpos]; linarith
          have h3 : (NS:ℝ) / Lb + 1 ≤ Real.exp (1 / (Module.finrank ℚ K : ℝ)) :=
            (Real.add_one_le_exp _).trans (Real.exp_le_exp.2 h2)
          have h4 : Lb * ((NS:ℝ) / Lb + 1) = Lb + NS := by
            field_simp
            ring
          have h5 := mul_le_mul_of_nonneg_left h3 hLbpos.le
          linarith
        calc (2 * (F:ℝ) + NS) ^ Module.finrank ℚ K
            ≤ (Lb * Real.exp (1 / (Module.finrank ℚ K : ℝ))) ^ Module.finrank ℚ K :=
              pow_le_pow_left₀ (by positivity) h1 _
          _ = Lb ^ Module.finrank ℚ K
                * Real.exp ((Module.finrank ℚ K : ℝ) * (1 / (Module.finrank ℚ K : ℝ))) := by
              rw [mul_pow, Real.exp_nat_mul]
          _ = Real.exp 1 * Lb ^ Module.finrank ℚ K := by
              rw [mul_one_div_cancel hnpos.ne']; ring
      have hprod : (1:ℝ) / NS = ∏ v ∈ S, (1 / (Ideal.absNorm v.asIdeal : ℝ)) := by
        rw [hNS_def, hN, Nat.cast_prod]
        simp only [one_div]
        rw [Finset.prod_inv_distrib]
      rw [← hprod, mul_one_div, le_div_iff₀ hNSpos]
      linarith
    
    obtain ⟨H, hH_def⟩ : ∃ H : ℝ, H = ∑ v ∈ Ps, (1:ℝ) / (Ideal.absNorm v.asIdeal : ℝ) :=
      ⟨_, rfl⟩
    have hH0 : 0 ≤ H := by
      rw [hH_def]; exact Finset.sum_nonneg (fun v _ => by positivity)
    have hesymm := finset_esymm_mul_factorial_le Ps
      (fun v => (1:ℝ) / (Ideal.absNorm v.asIdeal : ℝ)) (fun v _ => by positivity) (r + 1)
    beta_reduce at hesymm
    rw [← hH_def] at hesymm
    have hHk : Real.exp 2 * H ≤ ((r + 1 : ℕ) : ℝ) := by
      have h1 : H ≤ (Module.finrank ℚ K : ℝ) * (1 + t) := by
        rw [hH_def]
        refine hP3.trans ?_
        exact mul_le_mul_of_nonneg_left (by linarith) hnpos.le
      have h2 : Real.exp 2 * H ≤ Real.exp 2 * ((Module.finrank ℚ K : ℝ) * (1 + t)) :=
        mul_le_mul_of_nonneg_left h1 (Real.exp_pos 2).le
      push_cast
      linarith
    have htail := kai_brun_factorial_tail H (r + 1) hH0 hHk
    have hfacpos : (0:ℝ) < ((r + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
    have hesum : ∑ S ∈ Ps.powersetCard (r + 1), ∏ v ∈ S, (1 / (Ideal.absNorm v.asIdeal : ℝ))
        ≤ Real.exp (-((r + 1 : ℕ) : ℝ)) := by
      have h : ∑ S ∈ Ps.powersetCard (r + 1), ∏ v ∈ S, (1 / (Ideal.absNorm v.asIdeal : ℝ))
          ≤ H ^ (r + 1) / ((r + 1).factorial : ℝ) := by
        rw [le_div_iff₀ hfacpos]; linarith
      exact h.trans htail
    have hLbn : 0 ≤ Lb ^ Module.finrank ℚ K := pow_nonneg hLbpos.le _
    refine le_trans hsum1 ?_
    rw [hexch, hBcardR]
    refine le_trans (Finset.sum_le_sum hperS) ?_
    rw [← Finset.mul_sum]
    have hexp_eq : Real.exp (-(r:ℝ)) = Real.exp 1 * Real.exp (-((r + 1 : ℕ) : ℝ)) := by
      rw [← Real.exp_add]; push_cast; ring_nf
    calc Real.exp 1 * Lb ^ Module.finrank ℚ K
          * ∑ S ∈ Ps.powersetCard (r + 1), ∏ v ∈ S, (1 / (Ideal.absNorm v.asIdeal : ℝ))
        ≤ Real.exp 1 * Lb ^ Module.finrank ℚ K * Real.exp (-((r + 1 : ℕ) : ℝ)) :=
          mul_le_mul_of_nonneg_left hesum (mul_nonneg (Real.exp_pos 1).le hLbn)
      _ = Lb ^ Module.finrank ℚ K * Real.exp (-(r:ℝ)) := by rw [hexp_eq]; ring
      _ ≤ Lb ^ Module.finrank ℚ K * Real.exp (-Real.sqrt ℓ) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 (by linarith)) hLbn

theorem kai_typeI_weighted_transfer {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ)
    (Φ χ : NumberField.RingOfIntegers K → ℂ)
    (I : Finset (Ideal (NumberField.RingOfIntegers K)))
    (A : Ideal (NumberField.RingOfIntegers K) → ℂ) (τ : ℝ) (Nmax : ℕ) (w : ℕ → ℝ) (Vw : ℝ)
    (hN : ∀ x ∈ omegaBox ω M, (Algebra.norm ℤ x).natAbs ≤ Nmax)
    (hτ : ∀ Y : ℝ, ‖kaiTypeIForm ω M Φ χ I A Y‖ ≤ τ)
    (hw : |w Nmax| + ∑ t ∈ Finset.range Nmax, |w t - w (t + 1)| ≤ Vw) :
    ‖∑ x ∈ omegaBox ω M, ((w (Algebra.norm ℤ x).natAbs : ℝ) : ℂ) * χ x * Φ x *
        ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0‖ ≤ Vw * τ :=
by
  classical
  
  have htel : ∀ N k : ℕ, k ≤ N →
      w k = w N + ∑ t ∈ Finset.range N, (w t - w (t + 1)) * (if k ≤ t then (1 : ℝ) else 0) := by
    intro N
    induction N with
    | zero =>
      intro k hk
      have hk0 : k = 0 := Nat.le_zero.mp hk
      subst hk0
      simp
    | succ N ih =>
      intro k hk
      rw [Finset.sum_range_succ]
      rcases Nat.lt_or_ge N k with h | h
      · have hk' : k = N + 1 := by omega
        subst hk'
        have hz : ∑ t ∈ Finset.range N,
            (w t - w (t + 1)) * (if N + 1 ≤ t then (1 : ℝ) else 0) = 0 := by
          apply Finset.sum_eq_zero
          intro t ht
          rw [Finset.mem_range] at ht
          rw [if_neg (by omega), mul_zero]
        rw [hz, if_neg (by omega)]
        ring
      · have := ih k h
        rw [if_pos h, mul_one]
        linarith
  
  have abel : ∀ (n : NumberField.RingOfIntegers K → ℕ) (g : NumberField.RingOfIntegers K → ℂ)
      (F : ℝ → ℂ),
      (∀ x ∈ omegaBox ω M, n x ≤ Nmax) →
      (∀ Y : ℝ, F Y = ∑ x ∈ omegaBox ω M, if (n x : ℝ) ≤ Y then g x else 0) →
      (∀ Y : ℝ, ‖F Y‖ ≤ τ) →
      ‖∑ x ∈ omegaBox ω M, ((w (n x) : ℝ) : ℂ) * g x‖ ≤ Vw * τ := by
    intro n g F hn hF hFτ
    have hτ0 : 0 ≤ τ := (norm_nonneg _).trans (hFτ 0)
    have key : ∀ x ∈ omegaBox ω M, ((w (n x) : ℝ) : ℂ) * g x
        = ((w Nmax : ℝ) : ℂ) * (if (n x : ℝ) ≤ (Nmax : ℝ) then g x else 0)
          + ∑ t ∈ Finset.range Nmax,
              ((w t - w (t + 1) : ℝ) : ℂ) * (if (n x : ℝ) ≤ (t : ℝ) then g x else 0) := by
      intro x hx
      have hk := hn x hx
      have hk' : ((n x : ℕ) : ℝ) ≤ (Nmax : ℝ) := by exact_mod_cast hk
      have e' : ((w (n x) : ℝ) : ℂ) = ((w Nmax : ℝ) : ℂ) + ∑ t ∈ Finset.range Nmax,
          ((w t - w (t + 1) : ℝ) : ℂ) * (if n x ≤ t then (1 : ℂ) else 0) := by
        rw [htel Nmax (n x) hk, Complex.ofReal_add, Complex.ofReal_sum]
        congr 1
        refine Finset.sum_congr rfl (fun t _ => ?_)
        split_ifs <;> simp
      rw [e', add_mul, Finset.sum_mul, if_pos hk']
      congr 1
      refine Finset.sum_congr rfl (fun t _ => ?_)
      by_cases h : n x ≤ t
      · have h' : ((n x : ℕ) : ℝ) ≤ (t : ℝ) := by exact_mod_cast h
        rw [if_pos h, if_pos h']
        ring
      · have h' : ¬ ((n x : ℕ) : ℝ) ≤ (t : ℝ) := by exact_mod_cast h
        rw [if_neg h, if_neg h']
        ring
    have hS : ∑ x ∈ omegaBox ω M, ((w (n x) : ℝ) : ℂ) * g x
        = ((w Nmax : ℝ) : ℂ) * F Nmax
          + ∑ t ∈ Finset.range Nmax, ((w t - w (t + 1) : ℝ) : ℂ) * F t := by
      rw [Finset.sum_congr rfl key, Finset.sum_add_distrib]
      congr 1
      · rw [hF, Finset.mul_sum]
      · rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun t _ => ?_)
        rw [hF, Finset.mul_sum]
    rw [hS]
    calc ‖((w Nmax : ℝ) : ℂ) * F Nmax
          + ∑ t ∈ Finset.range Nmax, ((w t - w (t + 1) : ℝ) : ℂ) * F t‖
        ≤ ‖((w Nmax : ℝ) : ℂ) * F Nmax‖
          + ‖∑ t ∈ Finset.range Nmax, ((w t - w (t + 1) : ℝ) : ℂ) * F t‖ := norm_add_le _ _
      _ ≤ |w Nmax| * τ + ∑ t ∈ Finset.range Nmax, |w t - w (t + 1)| * τ := by
          apply add_le_add
          · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
            exact mul_le_mul_of_nonneg_left (hFτ _) (abs_nonneg _)
          · refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun t _ => ?_))
            rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
            exact mul_le_mul_of_nonneg_left (hFτ _) (abs_nonneg _)
      _ = (|w Nmax| + ∑ t ∈ Finset.range Nmax, |w t - w (t + 1)|) * τ := by
          rw [add_mul, Finset.sum_mul]
      _ ≤ Vw * τ := mul_le_mul_of_nonneg_right hw hτ0
  
  have hF : ∀ Y : ℝ, kaiTypeIForm ω M Φ χ I A Y = ∑ x ∈ omegaBox ω M,
      if (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) ≤ Y then
        χ x * Φ x * ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0
      else 0 := by
    intro Y
    unfold kaiTypeIForm
    simp_rw [Finset.sum_filter, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    by_cases hc : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) ≤ Y
    · rw [if_pos hc]
      refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
      by_cases hx : x ∈ 𝔡
      · rw [if_pos ⟨hx, hc⟩, if_pos hx]
        ring
      · rw [if_neg (fun h => hx h.1), if_neg hx]
        ring
    · rw [if_neg hc]
      exact Finset.sum_eq_zero (fun 𝔡 _ => by rw [if_neg (fun h => hc h.2), mul_zero])
  have hmain := abel (fun x => (Algebra.norm ℤ x).natAbs)
    (fun x => χ x * Φ x * ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0)
    (fun Y => kaiTypeIForm ω M Φ χ I A Y) hN hF hτ
  have heq : ∑ x ∈ omegaBox ω M, ((w (Algebra.norm ℤ x).natAbs : ℝ) : ℂ) * χ x * Φ x *
        ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0
      = ∑ x ∈ omegaBox ω M, ((w (Algebra.norm ℤ x).natAbs : ℝ) : ℂ) *
        (χ x * Φ x * ∑ 𝔡 ∈ I, A 𝔡 * @ite ℂ (x ∈ 𝔡) (Classical.propDecidable _) 1 0) :=
    Finset.sum_congr rfl (fun x _ => by ring)
  rw [heq]
  exact hmain

theorem kai_ideal_moebius_exists (K : Type u) [Field K] [NumberField K] :
    ∃ μ : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ 𝔡, |μ 𝔡| ≤ 1) ∧
      ∀ (𝔪 : Ideal (NumberField.RingOfIntegers K)), 𝔪 ≠ ⊥ →
        ∀ (D : Finset (Ideal (NumberField.RingOfIntegers K))),
          (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔪 ≤ 𝔡 → 𝔡 ∈ D) →
          ∑ 𝔡 ∈ D, @ite ℝ (𝔪 ≤ 𝔡) (Classical.propDecidable _) (μ 𝔡) 0
            = @ite ℝ (𝔪 = ⊤) (Classical.propDecidable _) 1 0 :=
by
  classical
  
  have hle_mem : ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K))) (v : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)), v ∈ S → (∏ w ∈ S, w.asIdeal) ≤ v.asIdeal := by
    intro S v hv
    exact (Ideal.IsPrime.prod_le v.isPrime).2 ⟨v, hv, le_rfl⟩
  
  have hsubset : ∀ S T : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)),
      (∏ v ∈ S, v.asIdeal) = (∏ v ∈ T, v.asIdeal) → S ⊆ T := by
    intro S T h v hv
    have hT : (∏ w ∈ T, w.asIdeal) ≤ v.asIdeal := by rw [← h]; exact hle_mem S v hv
    obtain ⟨w, hw, hwv⟩ := (Ideal.IsPrime.prod_le v.isPrime).1 hT
    have hwv' : w = v :=
      IsDedekindDomain.HeightOneSpectrum.ext (w.isMaximal.eq_of_le v.isPrime.ne_top hwv)
    rw [← hwv']; exact hw
  have hinjAll : ∀ S T : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)),
      (∏ v ∈ S, v.asIdeal) = (∏ v ∈ T, v.asIdeal) → S = T :=
    fun S T h => Finset.Subset.antisymm (hsubset S T h) (hsubset T S h.symm)
  obtain ⟨μ, hbd, hval, hsupp⟩ : ∃ μ : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ 𝔡, |μ 𝔡| ≤ 1) ∧
      (∀ S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        μ (∏ v ∈ S, v.asIdeal) = (-1 : ℝ) ^ S.card) ∧
      (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), μ 𝔡 ≠ 0 →
        ∃ S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
          𝔡 = ∏ v ∈ S, v.asIdeal) := by
    refine ⟨fun 𝔡 => if h : ∃ S : Finset (IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K)), 𝔡 = ∏ v ∈ S, v.asIdeal
        then (-1 : ℝ) ^ h.choose.card else 0, ?_, ?_, ?_⟩
    · intro 𝔡
      dsimp only
      split_ifs with h
      · rw [abs_pow, abs_neg, abs_one, one_pow]
      · rw [abs_zero]; exact zero_le_one
    · intro S
      have h : ∃ T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
          (∏ v ∈ S, v.asIdeal) = ∏ v ∈ T, v.asIdeal := ⟨S, rfl⟩
      dsimp only
      rw [dif_pos h]
      have hc := hinjAll h.choose S h.choose_spec.symm
      rw [hc]
    · intro 𝔡 hne
      by_contra h
      apply hne
      dsimp only
      rw [dif_neg h]
  refine ⟨μ, hbd, ?_⟩
  intro 𝔪 h𝔪 D hD
  have h0 : 𝔪 ≠ 0 := by rwa [Ideal.zero_eq_bot]
  obtain ⟨P, hP⟩ : ∃ P : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)), ∀ v, v ∈ P ↔ 𝔪 ≤ v.asIdeal := by
    refine ⟨(Ideal.finite_factors h0).toFinset, fun v => ?_⟩
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq, Ideal.dvd_iff_le]
  have hcrit : ∀ S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      𝔪 ≤ ∏ v ∈ S, v.asIdeal ↔ S ⊆ P := by
    intro S
    constructor
    · intro hle v hv
      exact (hP v).2 (hle.trans (hle_mem S v hv))
    · intro hsub
      apply Ideal.le_of_dvd
      apply Finset.prod_dvd_of_coprime
      · intro v _ w _ hvw
        rw [Function.onFun, Ideal.isCoprime_iff_sup_eq]
        exact v.isMaximal.coprime_of_ne w.isMaximal
          (fun h => hvw (IsDedekindDomain.HeightOneSpectrum.ext h))
      · intro v hv
        exact Ideal.dvd_iff_le.2 ((hP v).1 (hsub hv))
  have hinj : Set.InjOn (fun S : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)) => ∏ v ∈ S, v.asIdeal) ↑P.powerset := by
    intro S _ T _ hST
    exact hinjAll S T hST
  have hsub : P.powerset.image (fun S : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)) => ∏ v ∈ S, v.asIdeal) ⊆ D := by
    intro 𝔡 h𝔡
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.1 h𝔡
    exact hD _ ((hcrit S).2 (Finset.mem_powerset.1 hS))
  have hsum : ∑ 𝔡 ∈ D, @ite ℝ (𝔪 ≤ 𝔡) (Classical.propDecidable _) (μ 𝔡) 0
      = ∑ S ∈ P.powerset, (-1 : ℝ) ^ S.card := by
    rw [← Finset.sum_subset hsub, Finset.sum_image hinj]
    · apply Finset.sum_congr rfl
      intro S hS
      rw [if_pos ((hcrit S).2 (Finset.mem_powerset.1 hS)), hval]
    · intro 𝔡 _ hnot
      by_cases hle : 𝔪 ≤ 𝔡
      · rw [if_pos hle]
        by_contra hne
        obtain ⟨S, rfl⟩ := hsupp 𝔡 hne
        exact hnot (Finset.mem_image.2 ⟨S, Finset.mem_powerset.2 ((hcrit S).1 hle), rfl⟩)
      · rw [if_neg hle]
  rw [hsum]
  by_cases htop : 𝔪 = ⊤
  · have hPe : P = ∅ := by
      apply Finset.eq_empty_of_forall_notMem
      intro v hv
      rw [hP, htop, top_le_iff] at hv
      exact v.isPrime.ne_top hv
    rw [if_pos htop, hPe, Finset.powerset_empty, Finset.sum_singleton, Finset.card_empty,
      pow_zero]
  · obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal 𝔪 htop
    have hMbot : M ≠ ⊥ := by
      rintro rfl
      exact h𝔪 (le_bot_iff.1 hle)
    have hv : (⟨M, hM.isPrime, hMbot⟩ : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K)) ∈ P := (hP _).2 hle
    have hne : P.Nonempty := ⟨_, hv⟩
    rw [if_neg htop]
    have h := Finset.sum_powerset_neg_one_pow_card_of_nonempty hne
    have hcast : ((∑ S ∈ P.powerset, (-1 : ℤ) ^ S.card : ℤ) : ℝ)
        = ∑ S ∈ P.powerset, (-1 : ℝ) ^ S.card := by
      push_cast; rfl
    rw [← hcast, h, Int.cast_zero]

theorem kai_ideal_vonMangoldt_spec (K : Type u) [Field K] [NumberField K] :
    ∃ Λ : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ x : NumberField.RingOfIntegers K, Λ (Ideal.span {x}) = vonMangoldtO x) ∧
      (∀ 𝔢, 0 ≤ Λ 𝔢) ∧
      Λ ⊤ = 0 ∧
      (∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (k : ℕ),
        0 < k → Λ (v.asIdeal ^ k) = Real.log (Ideal.absNorm v.asIdeal : ℝ)) ∧
      (∀ 𝔢 : Ideal (NumberField.RingOfIntegers K),
        (∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (k : ℕ),
          0 < k → 𝔢 ≠ v.asIdeal ^ k) → Λ 𝔢 = 0) :=
by
  classical
  refine ⟨fun 𝔢 => if h : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ m : ℕ, 0 < m ∧ 𝔢 = p.asIdeal ^ m then Real.log (Ideal.absNorm h.choose.asIdeal : ℝ)
      else 0, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    unfold vonMangoldtO
    dsimp only
  · intro 𝔢
    dsimp only
    split_ifs
    · exact Real.log_natCast_nonneg _
    · exact le_refl 0
  · dsimp only
    rw [dif_neg]
    rintro ⟨p, m, hm, h⟩
    have hle : p.asIdeal ^ m ≤ p.asIdeal := Ideal.pow_le_self hm.ne'
    rw [← h, top_le_iff] at hle
    exact p.isPrime.ne_top hle
  · intro v k hk
    have hP : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 0 < m ∧ v.asIdeal ^ k = p.asIdeal ^ m := ⟨v, k, hk, rfl⟩
    dsimp only
    rw [dif_pos hP]
    obtain ⟨m, hm, hw⟩ := hP.choose_spec
    haveI : hP.choose.asIdeal.IsPrime := hP.choose.isPrime
    haveI : v.asIdeal.IsPrime := v.isPrime
    have h1 : v.asIdeal ≤ hP.choose.asIdeal :=
      Ideal.IsPrime.le_of_pow_le (hw.le.trans (Ideal.pow_le_self hm.ne'))
    have h2 : hP.choose.asIdeal ≤ v.asIdeal :=
      Ideal.IsPrime.le_of_pow_le (hw.symm.le.trans (Ideal.pow_le_self hk.ne'))
    rw [le_antisymm h2 h1]
  · intro 𝔢 hne
    dsimp only
    rw [dif_neg]
    rintro ⟨p, m, hm, h⟩
    exact hne p m hm h

theorem kai_ideal_vonMangoldt_peel (K : Type u) [Field K] [NumberField K]
    (Λ : Ideal (NumberField.RingOfIntegers K) → ℝ)
    (hΛ1 : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (k : ℕ),
      0 < k → Λ (v.asIdeal ^ k) = Real.log (Ideal.absNorm v.asIdeal : ℝ))
    (hΛ2 : ∀ 𝔢 : Ideal (NumberField.RingOfIntegers K),
      (∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (k : ℕ),
        0 < k → 𝔢 ≠ v.asIdeal ^ k) → Λ 𝔢 = 0)
    (𝔪 : Ideal (NumberField.RingOfIntegers K)) (h𝔪 : 𝔪 ≠ ⊥)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (D : Finset (Ideal (NumberField.RingOfIntegers K)))
    (hD : ∀ 𝔢 : Ideal (NumberField.RingOfIntegers K), v.asIdeal * 𝔪 ≤ 𝔢 → 𝔢 ∈ D) :
    ∑ 𝔢 ∈ D, @ite ℝ (v.asIdeal * 𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
      = ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
        + Real.log (Ideal.absNorm v.asIdeal : ℝ) :=
by
  classical
  have hPne : v.asIdeal ≠ ⊥ := v.ne_bot
  
  have hex : ∃ n : ℕ, ¬ 𝔪 ≤ v.asIdeal ^ n := by
    have hn0 : Ideal.absNorm 𝔪 ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact h𝔪
    have hq0 : Ideal.absNorm v.asIdeal ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hPne
    have hq1 : Ideal.absNorm v.asIdeal ≠ 1 := by
      rw [Ne, Ideal.absNorm_eq_one_iff]; exact v.isPrime.ne_top
    refine ⟨Ideal.absNorm 𝔪, fun h => ?_⟩
    have hdvd := Ideal.absNorm_dvd_absNorm_of_le h
    rw [map_pow] at hdvd
    have hle := Nat.le_of_dvd (Nat.pos_of_ne_zero hn0) hdvd
    have h2 : 2 ^ Ideal.absNorm 𝔪 ≤ Ideal.absNorm v.asIdeal ^ Ideal.absNorm 𝔪 :=
      Nat.pow_le_pow_left (by omega) _
    have h3 : Ideal.absNorm 𝔪 < 2 ^ Ideal.absNorm 𝔪 := Nat.lt_two_pow_self
    omega
  obtain ⟨k, hk⟩ : ∃ k, k = Nat.find hex := ⟨_, rfl⟩
  have hK1 : ¬ 𝔪 ≤ v.asIdeal ^ k := by rw [hk]; exact Nat.find_spec hex
  have hK2 : ∀ j < k, 𝔪 ≤ v.asIdeal ^ j := by
    intro j hj
    rw [hk] at hj
    exact not_not.mp (Nat.find_min hex hj)
  have hK3 : 0 < k := by
    rcases Nat.eq_zero_or_pos k with h | h
    · exfalso; apply hK1; rw [h, pow_zero, Ideal.one_eq_top]; exact le_top
    · exact h
  have hcancel : ∀ n : ℕ, v.asIdeal * 𝔪 ≤ v.asIdeal ^ (n + 1) → 𝔪 ≤ v.asIdeal ^ n := by
    intro n h
    rw [pow_succ', ← Ideal.dvd_iff_le] at h
    rw [← Ideal.dvd_iff_le]
    exact (mul_dvd_mul_iff_left (by rw [Ideal.zero_eq_bot]; exact hPne)).mp h
  have hK4 : v.asIdeal * 𝔪 ≤ v.asIdeal ^ k := by
    obtain ⟨k', hk'⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    rw [hk', pow_succ']
    exact Ideal.mul_mono_right (hK2 k' (by omega))
  have hK5 : ∀ j, v.asIdeal * 𝔪 ≤ v.asIdeal ^ j → ¬ 𝔪 ≤ v.asIdeal ^ j → j = k := by
    intro j h1 h2
    have hkj : k ≤ j := by rw [hk]; exact Nat.find_min' hex h2
    by_contra hne
    obtain ⟨j', hj'⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
    rw [hj'] at h1
    have h3 := hcancel j' h1
    exact hK1 (h3.trans (Ideal.pow_le_pow_right (by omega)))
  have hcop : ∀ w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      w ≠ v → ∀ j : ℕ, v.asIdeal * 𝔪 ≤ w.asIdeal ^ j → 𝔪 ≤ w.asIdeal ^ j := by
    intro w hwv j h
    have hne : w.asIdeal ≠ v.asIdeal := fun h' => hwv (IsDedekindDomain.HeightOneSpectrum.ext h')
    haveI := w.isMaximal
    haveI := v.isMaximal
    have hc : IsCoprime (w.asIdeal ^ j) v.asIdeal := (Ideal.isCoprime_of_isMaximal hne).pow_left
    rw [← Ideal.dvd_iff_le] at h ⊢
    exact hc.dvd_of_dvd_mul_left h
  have hpt : ∀ 𝔢 : Ideal (NumberField.RingOfIntegers K),
      @ite ℝ (v.asIdeal * 𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
        = @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
          + (if 𝔢 = v.asIdeal ^ k then Real.log (Ideal.absNorm v.asIdeal : ℝ) else 0) := by
    intro 𝔢
    by_cases hA : 𝔪 ≤ 𝔢
    · have hB : v.asIdeal * 𝔪 ≤ 𝔢 := Ideal.mul_le_left.trans hA
      have hC : 𝔢 ≠ v.asIdeal ^ k := by
        intro h; apply hK1; rw [← h]; exact hA
      rw [if_pos hB, if_pos hA, if_neg hC, add_zero]
    · by_cases hB : v.asIdeal * 𝔪 ≤ 𝔢
      · by_cases hC : 𝔢 = v.asIdeal ^ k
        · rw [if_pos hB, if_neg hA, if_pos hC, zero_add, hC, hΛ1 v k hK3]
        · rw [if_pos hB, if_neg hA, if_neg hC, add_zero]
          apply hΛ2
          intro w j hj he
          by_cases hwv : w = v
          · rw [hwv] at he
            rw [he] at hA hB
            have := hK5 j hB hA
            apply hC
            rw [he, this]
          · rw [he] at hA hB
            exact hA (hcop w hwv j hB)
      · have hC : 𝔢 ≠ v.asIdeal ^ k := by
          intro h; apply hB; rw [h]; exact hK4
        rw [if_neg hB, if_neg hA, if_neg hC, add_zero]
  rw [Finset.sum_congr rfl (fun 𝔢 _ => hpt 𝔢), Finset.sum_add_distrib, Finset.sum_ite_eq',
    if_pos (hD _ hK4)]

theorem kai_ideal_log_sum_of_peel (K : Type u) [Field K] [NumberField K]
    (Λ : Ideal (NumberField.RingOfIntegers K) → ℝ) (hT : Λ ⊤ = 0)
    (hpeel : ∀ (𝔪 : Ideal (NumberField.RingOfIntegers K)), 𝔪 ≠ ⊥ →
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (D : Finset (Ideal (NumberField.RingOfIntegers K))),
        (∀ 𝔢 : Ideal (NumberField.RingOfIntegers K), v.asIdeal * 𝔪 ≤ 𝔢 → 𝔢 ∈ D) →
        ∑ 𝔢 ∈ D, @ite ℝ (v.asIdeal * 𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
          = ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
            + Real.log (Ideal.absNorm v.asIdeal : ℝ)) :
    ∀ (𝔪 : Ideal (NumberField.RingOfIntegers K)), 𝔪 ≠ ⊥ →
      ∀ (D : Finset (Ideal (NumberField.RingOfIntegers K))),
        (∀ 𝔢 : Ideal (NumberField.RingOfIntegers K), 𝔪 ≤ 𝔢 → 𝔢 ∈ D) →
        ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
          = Real.log (Ideal.absNorm 𝔪 : ℝ) :=
by
  intro 𝔪₀
  refine UniqueFactorizationMonoid.induction_on_prime
    (P := fun 𝔪 : Ideal (NumberField.RingOfIntegers K) => 𝔪 ≠ ⊥ →
      ∀ (D : Finset (Ideal (NumberField.RingOfIntegers K))),
        (∀ 𝔢 : Ideal (NumberField.RingOfIntegers K), 𝔪 ≤ 𝔢 → 𝔢 ∈ D) →
        ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
          = Real.log (Ideal.absNorm 𝔪 : ℝ)) 𝔪₀ ?_ ?_ ?_
  · intro h
    exact absurd Ideal.zero_eq_bot h
  · intro x hx _ D hD
    rw [Ideal.isUnit_iff] at hx
    subst hx
    rw [Finset.sum_eq_single (⊤ : Ideal (NumberField.RingOfIntegers K))]
    · rw [if_pos le_rfl, hT, Ideal.absNorm_top, Nat.cast_one, Real.log_one]
    · intro b _ hb
      rw [if_neg]
      rw [top_le_iff]
      exact fun h => hb h
    · intro h
      exact absurd (hD ⊤ le_rfl) h
  · intro a p ha hp IH _ D hD
    have ha' : a ≠ ⊥ := by rw [← Ideal.zero_eq_bot]; exact ha
    have hp' : p ≠ ⊥ := by rw [← Ideal.zero_eq_bot]; exact hp.ne_zero
    have hpP : p.IsPrime := Ideal.isPrime_of_prime hp
    let v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) := ⟨p, hpP, hp'⟩
    have hDa : ∀ 𝔢 : Ideal (NumberField.RingOfIntegers K), a ≤ 𝔢 → 𝔢 ∈ D :=
      fun 𝔢 h𝔢 => hD 𝔢 (le_trans Ideal.mul_le_left h𝔢)
    have h1 := IH ha' D hDa
    have h2 : ∑ 𝔢 ∈ D, @ite ℝ (p * a ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
        = ∑ 𝔢 ∈ D, @ite ℝ (a ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
          + Real.log (Ideal.absNorm p : ℝ) := hpeel a ha' v D hD
    have hpn : (Ideal.absNorm p : ℝ) ≠ 0 :=
      Nat.cast_ne_zero.mpr (fun h => hp' (Ideal.absNorm_eq_zero_iff.mp h))
    have han : (Ideal.absNorm a : ℝ) ≠ 0 :=
      Nat.cast_ne_zero.mpr (fun h => ha' (Ideal.absNorm_eq_zero_iff.mp h))
    show ∑ 𝔢 ∈ D, @ite ℝ (p * a ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
      = Real.log (Ideal.absNorm (p * a) : ℝ)
    rw [h2, h1, map_mul, Nat.cast_mul, Real.log_mul hpn han]
    ring

theorem kai_ideal_moebius_collapse (K : Type u) [Field K] [NumberField K]
    (𝔫 : Ideal (NumberField.RingOfIntegers K)) (h𝔫 : 𝔫 ≠ ⊥)
    (D : Finset (Ideal (NumberField.RingOfIntegers K)))
    (hD : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≤ 𝔡 → 𝔡 ∈ D)
    (μ : Ideal (NumberField.RingOfIntegers K) → ℝ)
    (hμ : ∀ 𝔪 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≤ 𝔪 →
      ∑ 𝔡 ∈ D, @ite ℝ (𝔪 ≤ 𝔡) (Classical.propDecidable _) (μ 𝔡) 0
        = @ite ℝ (𝔪 = ⊤) (Classical.propDecidable _) 1 0)
    (f : Ideal (NumberField.RingOfIntegers K) → ℝ) :
    ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (𝔫 = 𝔡 * 𝔪) (Classical.propDecidable _)
        (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (f 𝔢) 0) 0
      = f 𝔫 :=
by
  
  have h1 : ∀ 𝔡 ∈ D, ∀ 𝔪 ∈ D,
      @ite ℝ (𝔫 = 𝔡 * 𝔪) (Classical.propDecidable _)
        (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (f 𝔢) 0) 0
      = ∑ 𝔢 ∈ D, f 𝔢 * (μ 𝔡 *
          @ite ℝ (𝔫 = 𝔡 * 𝔪 ∧ 𝔪 ≤ 𝔢) (Classical.propDecidable _) 1 0) := by
    intro 𝔡 _ 𝔪 _
    by_cases hP : 𝔫 = 𝔡 * 𝔪
    · rw [if_pos hP, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun 𝔢 _ => ?_)
      by_cases hR : 𝔪 ≤ 𝔢
      · rw [if_pos hR, if_pos ⟨hP, hR⟩]; ring
      · rw [if_neg hR, if_neg (fun h => hR h.2)]; ring
    · rw [if_neg hP]
      symm
      refine Finset.sum_eq_zero (fun 𝔢 _ => ?_)
      rw [if_neg (fun h => hP h.1)]; ring
  
  have h2 : ∀ 𝔡 𝔢 : Ideal (NumberField.RingOfIntegers K),
      ∑ 𝔪 ∈ D, @ite ℝ (𝔫 = 𝔡 * 𝔪 ∧ 𝔪 ≤ 𝔢) (Classical.propDecidable _) 1 0
        = @ite ℝ (𝔫 ≤ 𝔡 * 𝔢) (Classical.propDecidable _) 1 0 := by
    intro 𝔡 𝔢
    by_cases h : 𝔫 ≤ 𝔡 * 𝔢
    · rw [if_pos h]
      have h𝔡 : 𝔡 ≠ ⊥ := by
        rintro rfl
        rw [Ideal.bot_mul, le_bot_iff] at h
        exact h𝔫 h
      have h0 : 𝔡 ≠ 0 := by rwa [Ideal.zero_eq_bot]
      obtain ⟨𝔤, h𝔤⟩ := Ideal.dvd_iff_le.mpr h
      have hn : 𝔫 = 𝔡 * (𝔢 * 𝔤) := by rw [h𝔤, mul_assoc]
      have hm𝔢 : 𝔢 * 𝔤 ≤ 𝔢 := Ideal.mul_le_right
      have hnm : 𝔫 ≤ 𝔢 * 𝔤 := by
        calc 𝔫 = 𝔡 * (𝔢 * 𝔤) := hn
          _ ≤ 𝔢 * 𝔤 := Ideal.mul_le_left
      rw [Finset.sum_eq_single_of_mem (𝔢 * 𝔤) (hD _ hnm)]
      · rw [if_pos ⟨hn, hm𝔢⟩]
      · intro 𝔪 _ hne
        rw [if_neg]
        rintro ⟨hx, _⟩
        exact hne (mul_left_cancel₀ h0 (hx.symm.trans hn))
    · rw [if_neg h]
      refine Finset.sum_eq_zero (fun 𝔪 _ => ?_)
      rw [if_neg]
      rintro ⟨hx, hy⟩
      apply h
      rw [hx]
      exact Ideal.mul_mono_right hy
  
  have h3 : ∀ 𝔢 : Ideal (NumberField.RingOfIntegers K),
      ∑ 𝔡 ∈ D, μ 𝔡 * @ite ℝ (𝔫 ≤ 𝔡 * 𝔢) (Classical.propDecidable _) 1 0
        = @ite ℝ (𝔢 = 𝔫) (Classical.propDecidable _) 1 0 := by
    intro 𝔢
    by_cases h𝔢 : 𝔫 ≤ 𝔢
    · obtain ⟨𝔠, h𝔠⟩ := Ideal.dvd_iff_le.mpr h𝔢
      have he0 : 𝔢 ≠ 0 := by
        rintro rfl
        apply h𝔫
        rw [h𝔠, zero_mul, Ideal.zero_eq_bot]
      have hnc : 𝔫 ≤ 𝔠 := by
        calc 𝔫 = 𝔢 * 𝔠 := h𝔠
          _ ≤ 𝔠 := Ideal.mul_le_left
      have hiff : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≤ 𝔡 * 𝔢 ↔ 𝔠 ≤ 𝔡 := by
        intro 𝔡
        rw [← Ideal.dvd_iff_le, ← Ideal.dvd_iff_le, h𝔠, mul_comm 𝔡 𝔢]
        exact mul_dvd_mul_iff_left he0
      have hsum : ∑ 𝔡 ∈ D, μ 𝔡 * @ite ℝ (𝔫 ≤ 𝔡 * 𝔢) (Classical.propDecidable _) 1 0
          = ∑ 𝔡 ∈ D, @ite ℝ (𝔠 ≤ 𝔡) (Classical.propDecidable _) (μ 𝔡) 0 := by
        refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
        by_cases hd : 𝔠 ≤ 𝔡
        · rw [if_pos ((hiff 𝔡).mpr hd), if_pos hd, mul_one]
        · rw [if_neg (fun h => hd ((hiff 𝔡).mp h)), if_neg hd, mul_zero]
      rw [hsum, hμ 𝔠 hnc]
      by_cases hen : 𝔢 = 𝔫
      · rw [if_pos hen, if_pos]
        apply mul_left_cancel₀ he0
        rw [← h𝔠, Ideal.mul_top, hen]
      · rw [if_neg hen, if_neg]
        rintro rfl
        apply hen
        rw [h𝔠, Ideal.mul_top]
    · rw [if_neg (fun h => h𝔢 (le_of_eq h.symm))]
      refine Finset.sum_eq_zero (fun 𝔡 _ => ?_)
      rw [if_neg, mul_zero]
      intro h
      exact h𝔢 (h.trans Ideal.mul_le_left)
  
  have h4 : ∀ 𝔢 ∈ D, ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, f 𝔢 * (μ 𝔡 *
        @ite ℝ (𝔫 = 𝔡 * 𝔪 ∧ 𝔪 ≤ 𝔢) (Classical.propDecidable _) 1 0)
      = f 𝔢 * @ite ℝ (𝔢 = 𝔫) (Classical.propDecidable _) 1 0 := by
    intro 𝔢 _
    rw [← h3 𝔢, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
    rw [← h2 𝔡 𝔢]
    simp only [Finset.mul_sum]
  calc ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (𝔫 = 𝔡 * 𝔪) (Classical.propDecidable _)
        (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (f 𝔢) 0) 0
      = ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, ∑ 𝔢 ∈ D, f 𝔢 * (μ 𝔡 *
          @ite ℝ (𝔫 = 𝔡 * 𝔪 ∧ 𝔪 ≤ 𝔢) (Classical.propDecidable _) 1 0) :=
        Finset.sum_congr rfl (fun 𝔡 h𝔡 => Finset.sum_congr rfl (fun 𝔪 h𝔪 => h1 𝔡 h𝔡 𝔪 h𝔪))
    _ = ∑ 𝔡 ∈ D, ∑ 𝔢 ∈ D, ∑ 𝔪 ∈ D, f 𝔢 * (μ 𝔡 *
          @ite ℝ (𝔫 = 𝔡 * 𝔪 ∧ 𝔪 ≤ 𝔢) (Classical.propDecidable _) 1 0) :=
        Finset.sum_congr rfl (fun 𝔡 _ => Finset.sum_comm)
    _ = ∑ 𝔢 ∈ D, ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, f 𝔢 * (μ 𝔡 *
          @ite ℝ (𝔫 = 𝔡 * 𝔪 ∧ 𝔪 ≤ 𝔢) (Classical.propDecidable _) 1 0) :=
        Finset.sum_comm
    _ = ∑ 𝔢 ∈ D, f 𝔢 * @ite ℝ (𝔢 = 𝔫) (Classical.propDecidable _) 1 0 :=
        Finset.sum_congr rfl h4
    _ = f 𝔫 := by
        rw [Finset.sum_eq_single_of_mem 𝔫 (hD 𝔫 le_rfl)]
        · rw [if_pos rfl, mul_one]
        · intro 𝔢 _ hne
          rw [if_neg hne, mul_zero]

theorem kai_ideal_vaughan_split (K : Type u) [Field K] [NumberField K] (U V : ℝ)
    (𝔫 : Ideal (NumberField.RingOfIntegers K)) (h𝔫 : 𝔫 ≠ ⊥)
    (D : Finset (Ideal (NumberField.RingOfIntegers K)))
    (hD : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≤ 𝔡 → 𝔡 ∈ D)
    (μ Λ : Ideal (NumberField.RingOfIntegers K) → ℝ)
    (hΛ : ∀ 𝔪 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≤ 𝔪 →
      ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
        = Real.log (Ideal.absNorm 𝔪 : ℝ)) :
    ∑ 𝔡 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ 𝔫 ≤ 𝔡) (Classical.propDecidable _)
        (μ 𝔡 * (Real.log (Ideal.absNorm 𝔫 : ℝ) - Real.log (Ideal.absNorm 𝔡 : ℝ))) 0
    - ∑ 𝔣 ∈ D, @ite ℝ ((Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ 𝔫 ≤ 𝔣) (Classical.propDecidable _)
        (∑ 𝔡 ∈ D, ∑ 𝔢 ∈ D, @ite ℝ (𝔣 = 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
          (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0) 0
    = ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ 𝔫 = 𝔡 * 𝔪)
        (Classical.propDecidable _)
        (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ))
          (Classical.propDecidable _) (Λ 𝔢) 0) 0 :=
by
  classical
  
  have hA : ∑ 𝔣 ∈ D, @ite ℝ ((Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ 𝔫 ≤ 𝔣) (Classical.propDecidable _)
        (∑ 𝔡 ∈ D, ∑ 𝔢 ∈ D, @ite ℝ (𝔣 = 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
          (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0) 0
      = ∑ 𝔡 ∈ D, ∑ 𝔢 ∈ D, @ite ℝ (𝔫 ≤ 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
          (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0 := by
    have step1 : ∀ 𝔣 ∈ D, @ite ℝ ((Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ 𝔫 ≤ 𝔣)
        (Classical.propDecidable _)
        (∑ 𝔡 ∈ D, ∑ 𝔢 ∈ D, @ite ℝ (𝔣 = 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
          (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0) 0
        = ∑ 𝔡 ∈ D, ∑ 𝔢 ∈ D, @ite ℝ (𝔣 = 𝔡 * 𝔢 ∧ (𝔫 ≤ 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
          (Ideal.absNorm 𝔢 : ℝ) ≤ U)) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0 := by
      intro 𝔣 _
      by_cases hP : (Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ 𝔫 ≤ 𝔣
      · rw [if_pos hP]
        refine Finset.sum_congr rfl (fun 𝔡 _ => Finset.sum_congr rfl (fun 𝔢 _ => ?_))
        by_cases hq : 𝔣 = 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ (Ideal.absNorm 𝔢 : ℝ) ≤ U
        · have h2 : 𝔫 ≤ 𝔡 * 𝔢 := by rw [← hq.1]; exact hP.2
          rw [if_pos hq, if_pos ⟨hq.1, h2, hq.2⟩]
        · rw [if_neg hq, if_neg (fun h => hq ⟨h.1, h.2.2⟩)]
      · rw [if_neg hP]
        symm
        refine Finset.sum_eq_zero (fun 𝔡 _ => Finset.sum_eq_zero (fun 𝔢 _ => ?_))
        rw [if_neg]
        rintro ⟨h1, h2, h3, h4⟩
        apply hP
        refine ⟨?_, by rw [h1]; exact h2⟩
        rw [h1, map_mul, Nat.cast_mul]
        have h0 : (0:ℝ) ≤ Ideal.absNorm 𝔡 := Nat.cast_nonneg _
        have h0' : (0:ℝ) ≤ Ideal.absNorm 𝔢 := Nat.cast_nonneg _
        calc (Ideal.absNorm 𝔡 : ℝ) * Ideal.absNorm 𝔢 ≤ V * U :=
              mul_le_mul h3 h4 h0' (h0.trans h3)
          _ = U * V := mul_comm _ _
    rw [Finset.sum_congr rfl step1, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun 𝔢 _ => ?_)
    rw [Finset.sum_eq_single (𝔡 * 𝔢)]
    · by_cases hc : 𝔫 ≤ 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ (Ideal.absNorm 𝔢 : ℝ) ≤ U
      · rw [if_pos ⟨rfl, hc⟩, if_pos hc]
      · rw [if_neg (fun h => hc h.2), if_neg hc]
    · intro 𝔣 _ hne
      rw [if_neg (fun h => hne h.1)]
    · intro hnot
      rw [if_neg]
      rintro ⟨-, h2, -⟩
      exact hnot (hD _ h2)
  
  rw [hA, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
  by_cases hc : (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ 𝔫 ≤ 𝔡
  · rw [if_pos hc]
    obtain ⟨𝔠, h𝔠⟩ := Ideal.dvd_iff_le.mpr hc.2
    have h𝔡ne : 𝔡 ≠ ⊥ := by
      rintro rfl; exact h𝔫 (le_bot_iff.mp hc.2)
    have h𝔫𝔠 : 𝔫 ≤ 𝔠 := by rw [h𝔠]; exact Ideal.mul_le_left
    have h𝔠ne : 𝔠 ≠ ⊥ := by
      rintro rfl; exact h𝔫 (le_bot_iff.mp h𝔫𝔠)
    have h𝔡0 : 𝔡 ≠ 0 := by rwa [Ne, Ideal.zero_eq_bot]
    have hcanc : ∀ 𝔪, 𝔫 = 𝔡 * 𝔪 → 𝔪 = 𝔠 := fun 𝔪 h =>
      mul_left_cancel₀ h𝔡0 (h.symm.trans h𝔠)
    have hdiv : ∀ 𝔢, 𝔫 ≤ 𝔡 * 𝔢 ↔ 𝔠 ≤ 𝔢 := by
      intro 𝔢
      rw [h𝔠, ← Ideal.dvd_iff_le, ← Ideal.dvd_iff_le, mul_dvd_mul_iff_left h𝔡0]
    have hlog : Real.log (Ideal.absNorm 𝔫 : ℝ) - Real.log (Ideal.absNorm 𝔡 : ℝ)
        = Real.log (Ideal.absNorm 𝔠 : ℝ) := by
      have h1 : (Ideal.absNorm 𝔡 : ℝ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (fun h => h𝔡ne (Ideal.absNorm_eq_zero_iff.mp h))
      have h2 : (Ideal.absNorm 𝔠 : ℝ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (fun h => h𝔠ne (Ideal.absNorm_eq_zero_iff.mp h))
      rw [h𝔠, map_mul, Nat.cast_mul, Real.log_mul h1 h2]; ring
    have hsplit : Real.log (Ideal.absNorm 𝔠 : ℝ)
        = ∑ 𝔢 ∈ D, @ite ℝ (𝔠 ≤ 𝔢 ∧ (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _)
            (Λ 𝔢) 0
          + ∑ 𝔢 ∈ D, @ite ℝ (𝔠 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ)) (Classical.propDecidable _)
            (Λ 𝔢) 0 := by
      rw [← hΛ 𝔠 h𝔫𝔠, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun 𝔢 _ => ?_)
      by_cases h1 : 𝔠 ≤ 𝔢
      · by_cases h2 : (Ideal.absNorm 𝔢 : ℝ) ≤ U
        · rw [if_pos h1, if_pos ⟨h1, h2⟩, if_neg (fun h => absurd h.2 (not_lt.mpr h2)),
            add_zero]
        · rw [if_pos h1, if_neg (fun h => h2 h.2), if_pos ⟨h1, not_le.mp h2⟩, zero_add]
      · rw [if_neg h1, if_neg (fun h => h1 h.1), if_neg (fun h => h1 h.1), add_zero]
    have hS : ∑ 𝔢 ∈ D, @ite ℝ (𝔫 ≤ 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
          (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0
        = μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔠 ≤ 𝔢 ∧ (Ideal.absNorm 𝔢 : ℝ) ≤ U)
            (Classical.propDecidable _) (Λ 𝔢) 0 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun 𝔢 _ => ?_)
      by_cases h : 𝔠 ≤ 𝔢 ∧ (Ideal.absNorm 𝔢 : ℝ) ≤ U
      · rw [if_pos ⟨(hdiv 𝔢).mpr h.1, hc.1, h.2⟩, if_pos h]
      · rw [if_neg (fun h' => h ⟨(hdiv 𝔢).mp h'.1, h'.2.2⟩), if_neg h, mul_zero]
    have hR : ∑ 𝔪 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ 𝔫 = 𝔡 * 𝔪)
        (Classical.propDecidable _)
        (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ))
          (Classical.propDecidable _) (Λ 𝔢) 0) 0
        = μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔠 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ))
            (Classical.propDecidable _) (Λ 𝔢) 0 := by
      rw [Finset.sum_eq_single 𝔠]
      · rw [if_pos ⟨hc.1, h𝔠⟩]
      · intro 𝔪 _ hne
        rw [if_neg (fun h => hne (hcanc 𝔪 h.2))]
      · intro hnot; exact absurd (hD 𝔠 h𝔫𝔠) hnot
    rw [hS, hR, hlog, hsplit]; ring
  · rw [if_neg hc]
    have h1 : ∑ 𝔢 ∈ D, @ite ℝ (𝔫 ≤ 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
          (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0 = 0 :=
      Finset.sum_eq_zero (fun 𝔢 _ =>
        if_neg (fun h => hc ⟨h.2.1, h.1.trans Ideal.mul_le_right⟩))
    have h2 : ∑ 𝔪 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ 𝔫 = 𝔡 * 𝔪)
        (Classical.propDecidable _)
        (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ))
          (Classical.propDecidable _) (Λ 𝔢) 0) 0 = 0 := by
      refine Finset.sum_eq_zero (fun 𝔪 _ => if_neg ?_)
      intro h
      apply hc
      refine ⟨h.1, ?_⟩
      rw [h.2]; exact Ideal.mul_le_right
    rw [h1, h2]; ring

theorem kai_ideal_conv_coeff_bound (K : Type u) [Field K] [NumberField K] (U V : ℝ)
    (𝔣 : Ideal (NumberField.RingOfIntegers K)) (h𝔣 : 𝔣 ≠ ⊥)
    (F : Finset (Ideal (NumberField.RingOfIntegers K)))
    (hF : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔣 ≤ 𝔡 → 𝔡 ∈ F)
    (μ Λ : Ideal (NumberField.RingOfIntegers K) → ℝ)
    (hμ : ∀ 𝔡, |μ 𝔡| ≤ 1) (hΛ0 : ∀ 𝔢, 0 ≤ Λ 𝔢)
    (hΛ : ∑ 𝔢 ∈ F, @ite ℝ (𝔣 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
      = Real.log (Ideal.absNorm 𝔣 : ℝ)) :
    |∑ 𝔡 ∈ F, ∑ 𝔢 ∈ F, @ite ℝ (𝔣 = 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
        (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0|
      ≤ Real.log (Ideal.absNorm 𝔣 : ℝ) :=
by
  classical
  rw [Finset.sum_comm]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  rw [← hΛ]
  apply Finset.sum_le_sum
  intro 𝔢 _
  have hg0 : 0 ≤ @ite ℝ (𝔣 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0 := by
    split_ifs
    · exact hΛ0 𝔢
    · exact le_refl 0
  by_cases hex : ∃ 𝔡₀ ∈ F, (𝔣 = 𝔡₀ * 𝔢 ∧ (Ideal.absNorm 𝔡₀ : ℝ) ≤ V ∧
      (Ideal.absNorm 𝔢 : ℝ) ≤ U)
  · obtain ⟨𝔡₀, h𝔡₀F, hP⟩ := hex
    have he0 : 𝔢 ≠ 0 := by
      intro h
      apply h𝔣
      rw [hP.1, h, mul_zero]
      rfl
    rw [Finset.sum_eq_single_of_mem 𝔡₀ h𝔡₀F]
    · rw [if_pos hP]
      have hle : 𝔣 ≤ 𝔢 := by rw [hP.1]; exact Ideal.mul_le_left
      rw [if_pos hle, abs_mul, abs_of_nonneg (hΛ0 𝔢)]
      exact mul_le_of_le_one_left (hΛ0 𝔢) (hμ 𝔡₀)
    · intro 𝔡 _ hne
      rw [if_neg]
      intro hP'
      apply hne
      exact mul_right_cancel₀ he0 (hP'.1.symm.trans hP.1)
  · rw [Finset.sum_eq_zero]
    · simpa using hg0
    · intro 𝔡 h𝔡
      rw [if_neg]
      intro hP'
      exact hex ⟨𝔡, h𝔡, hP'⟩

theorem kai_ideal_vaughan_identity (K : Type u) [Field K] [NumberField K]
    (U V : ℝ) (hU : 1 ≤ U) (hV : 1 ≤ V) :
    ∃ (μ' a γ : Ideal (NumberField.RingOfIntegers K) → ℝ),
      (∀ 𝔡, |μ' 𝔡| ≤ 1) ∧
      (∀ 𝔣, 𝔣 ≠ ⊥ → |a 𝔣| ≤ Real.log (Ideal.absNorm 𝔣 : ℝ)) ∧
      (∀ 𝔪, 𝔪 ≠ ⊥ → 0 ≤ γ 𝔪 ∧ γ 𝔪 ≤ Real.log (Ideal.absNorm 𝔪 : ℝ)) ∧
      (∀ 𝔪, (Ideal.absNorm 𝔪 : ℝ) ≤ U → γ 𝔪 = 0) ∧
      ∀ (D : Finset (Ideal (NumberField.RingOfIntegers K))) (x : NumberField.RingOfIntegers K),
        x ≠ 0 → (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), Ideal.span {x} ≤ 𝔡 → 𝔡 ∈ D) →
        vonMangoldtO x =
          (if ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U then vonMangoldtO x else 0)
          + ∑ 𝔡 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ x ∈ 𝔡) (Classical.propDecidable _)
                (μ' 𝔡 * (Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
                  - Real.log (Ideal.absNorm 𝔡 : ℝ))) 0
          - ∑ 𝔣 ∈ D, @ite ℝ ((Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ x ∈ 𝔣) (Classical.propDecidable _)
                (a 𝔣) 0
          + ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (V < (Ideal.absNorm 𝔡 : ℝ) ∧ Ideal.span {x} = 𝔡 * 𝔪)
                (Classical.propDecidable _) (μ' 𝔡 * γ 𝔪) 0 :=
by
  obtain ⟨μ, hμbd, hμsum⟩ := kai_ideal_moebius_exists K
  obtain ⟨Λ, hV0, hΛnn, hΛT, hΛ1, hΛ2⟩ := kai_ideal_vonMangoldt_spec K
  have hlog := kai_ideal_log_sum_of_peel K Λ hΛT
    (fun 𝔪 h𝔪 v D hD => kai_ideal_vonMangoldt_peel K Λ hΛ1 hΛ2 𝔪 h𝔪 v D hD)
  
  have hiteNe : ∀ (c : Prop) {dc : Decidable c} (t : ℝ), @ite ℝ c dc t 0 ≠ 0 → c := by
    intro c dc t h
    by_contra hc
    exact h (if_neg hc)
  
  have hne : ∀ 𝔫 𝔪 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≠ ⊥ → 𝔫 ≤ 𝔪 → 𝔪 ≠ ⊥ := by
    intro 𝔫 𝔪 h𝔫 h h𝔪
    rw [h𝔪] at h
    exact h𝔫 (le_bot_iff.mp h)
  have hnormle : ∀ 𝔪 𝔢 : Ideal (NumberField.RingOfIntegers K), 𝔪 ≠ ⊥ → 𝔪 ≤ 𝔢 →
      Ideal.absNorm 𝔢 ≤ Ideal.absNorm 𝔪 := by
    intro 𝔪 𝔢 h𝔪 h
    exact Nat.le_of_dvd (Nat.pos_of_ne_zero (fun h0 => h𝔪 (Ideal.absNorm_eq_zero_iff.mp h0)))
      (Ideal.absNorm_dvd_absNorm_of_le h)
  
  have hfin : ∀ 𝔣 : Ideal (NumberField.RingOfIntegers K), 𝔣 ≠ ⊥ →
      ∃ F : Finset (Ideal (NumberField.RingOfIntegers K)), ∀ 𝔡, 𝔣 ≤ 𝔡 → 𝔡 ∈ F := by
    intro 𝔣 h𝔣
    refine ⟨(Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K)
      (Ideal.absNorm 𝔣)).toFinset, fun 𝔡 h => ?_⟩
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq]
    exact hnormle 𝔣 𝔡 h𝔣 h
  
  obtain ⟨a, ha⟩ : ∃ a : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ 𝔣, a 𝔣 =
      ∑ᶠ p : Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K),
        @ite ℝ (𝔣 = p.1 * p.2 ∧ (Ideal.absNorm p.1 : ℝ) ≤ V ∧ (Ideal.absNorm p.2 : ℝ) ≤ U)
          (Classical.propDecidable _) (μ p.1 * Λ p.2) 0 := ⟨_, fun _ => rfl⟩
  obtain ⟨γ, hγ⟩ : ∃ γ : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ 𝔪, γ 𝔪 =
      if (Ideal.absNorm 𝔪 : ℝ) ≤ U then 0 else
        ∑ᶠ 𝔢 : Ideal (NumberField.RingOfIntegers K),
          @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ)) (Classical.propDecidable _) (Λ 𝔢) 0 :=
    ⟨_, fun _ => rfl⟩
  
  have hconvA : ∀ (𝔣 : Ideal (NumberField.RingOfIntegers K))
      (E : Finset (Ideal (NumberField.RingOfIntegers K))), (∀ 𝔡, 𝔣 ≤ 𝔡 → 𝔡 ∈ E) →
      a 𝔣 = ∑ 𝔡 ∈ E, ∑ 𝔢 ∈ E, @ite ℝ (𝔣 = 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
        (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0 := by
    intro 𝔣 E hE
    have hsupp : Function.support (fun p : Ideal (NumberField.RingOfIntegers K) ×
        Ideal (NumberField.RingOfIntegers K) =>
        @ite ℝ (𝔣 = p.1 * p.2 ∧ (Ideal.absNorm p.1 : ℝ) ≤ V ∧ (Ideal.absNorm p.2 : ℝ) ≤ U)
          (Classical.propDecidable _) (μ p.1 * Λ p.2) 0) ⊆ ↑(E ×ˢ E) := by
      intro p hp
      rw [Function.mem_support] at hp
      have h1 : 𝔣 = p.1 * p.2 := (hiteNe _ _ hp).1
      have h2 : 𝔣 ≤ p.1 := by rw [h1]; exact Ideal.mul_le_right
      have h3 : 𝔣 ≤ p.2 := by rw [h1]; exact Ideal.mul_le_left
      exact Finset.mem_coe.mpr (Finset.mem_product.mpr ⟨hE _ h2, hE _ h3⟩)
    rw [ha 𝔣, finsum_eq_sum_of_support_subset _ hsupp, Finset.sum_product]
  
  have hconvG : ∀ (𝔪 : Ideal (NumberField.RingOfIntegers K))
      (E : Finset (Ideal (NumberField.RingOfIntegers K))), 𝔪 ≠ ⊥ → (∀ 𝔢, 𝔪 ≤ 𝔢 → 𝔢 ∈ E) →
      γ 𝔪 = ∑ 𝔢 ∈ E, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ)) (Classical.propDecidable _)
        (Λ 𝔢) 0 := by
    intro 𝔪 E h𝔪 hE
    rw [hγ 𝔪]
    by_cases hN : (Ideal.absNorm 𝔪 : ℝ) ≤ U
    · rw [if_pos hN]
      symm
      apply Finset.sum_eq_zero
      intro 𝔢 _
      rw [if_neg]
      rintro ⟨h1, h2⟩
      have : (Ideal.absNorm 𝔢 : ℝ) ≤ (Ideal.absNorm 𝔪 : ℝ) := by
        exact_mod_cast hnormle 𝔪 𝔢 h𝔪 h1
      linarith
    · rw [if_neg hN]
      apply finsum_eq_sum_of_support_subset
      intro 𝔢 h𝔢
      rw [Function.mem_support] at h𝔢
      have h1 : 𝔪 ≤ 𝔢 := (hiteNe _ _ h𝔢).1
      exact Finset.mem_coe.mpr (hE 𝔢 h1)
  refine ⟨μ, a, γ, hμbd, ?_, ?_, ?_, ?_⟩
  · 
    intro 𝔣 h𝔣
    obtain ⟨F, hF⟩ := hfin 𝔣 h𝔣
    rw [hconvA 𝔣 F hF]
    exact kai_ideal_conv_coeff_bound K U V 𝔣 h𝔣 F hF μ Λ hμbd hΛnn (hlog 𝔣 h𝔣 F hF)
  · 
    intro 𝔪 h𝔪
    by_cases hN : (Ideal.absNorm 𝔪 : ℝ) ≤ U
    · rw [hγ 𝔪, if_pos hN]
      exact ⟨le_refl 0, Real.log_natCast_nonneg _⟩
    · obtain ⟨F, hF⟩ := hfin 𝔪 h𝔪
      rw [hconvG 𝔪 F h𝔪 hF]
      constructor
      · apply Finset.sum_nonneg
        intro 𝔢 _
        split_ifs
        · exact hΛnn 𝔢
        · exact le_refl 0
      · rw [← hlog 𝔪 h𝔪 F hF]
        apply Finset.sum_le_sum
        intro 𝔢 _
        split_ifs <;> first | exact le_refl _ | exact hΛnn _ | (exfalso; tauto)
  · 
    intro 𝔪 hN
    rw [hγ 𝔪, if_pos hN]
  · 
    intro D x hx hD
    set 𝔫 := Ideal.span {x} with h𝔫_def
    have h𝔫 : 𝔫 ≠ ⊥ := fun h => hx (Ideal.span_singleton_eq_bot.mp h)
    have hmem : ∀ I : Ideal (NumberField.RingOfIntegers K), x ∈ I ↔ 𝔫 ≤ I :=
      fun I => (Ideal.span_singleton_le_iff_mem (I := I)).symm
    have hnorm : ((Algebra.norm ℤ x).natAbs : ℝ) = (Ideal.absNorm 𝔫 : ℝ) := by
      rw [h𝔫_def, Ideal.absNorm_span_singleton]
    have hΛx : vonMangoldtO x = Λ 𝔫 := (hV0 x).symm
    have hμ' : ∀ 𝔪 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≤ 𝔪 →
        ∑ 𝔡 ∈ D, @ite ℝ (𝔪 ≤ 𝔡) (Classical.propDecidable _) (μ 𝔡) 0
          = @ite ℝ (𝔪 = ⊤) (Classical.propDecidable _) 1 0 :=
      fun 𝔪 h => hμsum 𝔪 (hne 𝔫 𝔪 h𝔫 h) D (fun 𝔡 h' => hD 𝔡 (le_trans h h'))
    have hΛ' : ∀ 𝔪 : Ideal (NumberField.RingOfIntegers K), 𝔫 ≤ 𝔪 →
        ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _) (Λ 𝔢) 0
          = Real.log (Ideal.absNorm 𝔪 : ℝ) :=
      fun 𝔪 h => hlog 𝔪 (hne 𝔫 𝔪 h𝔫 h) D (fun 𝔢 h' => hD 𝔢 (le_trans h h'))
    
    have hT2 : ∑ 𝔡 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ x ∈ 𝔡) (Classical.propDecidable _)
          (μ 𝔡 * (Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
            - Real.log (Ideal.absNorm 𝔡 : ℝ))) 0
        = ∑ 𝔡 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ 𝔫 ≤ 𝔡) (Classical.propDecidable _)
            (μ 𝔡 * (Real.log (Ideal.absNorm 𝔫 : ℝ) - Real.log (Ideal.absNorm 𝔡 : ℝ))) 0 := by
      refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
      have hm := hmem 𝔡
      split_ifs <;> first | rfl | (exfalso; tauto) | (rw [hnorm])
    
    have hT3 : ∑ 𝔣 ∈ D, @ite ℝ ((Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ x ∈ 𝔣)
          (Classical.propDecidable _) (a 𝔣) 0
        = ∑ 𝔣 ∈ D, @ite ℝ ((Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ 𝔫 ≤ 𝔣) (Classical.propDecidable _)
            (∑ 𝔡 ∈ D, ∑ 𝔢 ∈ D, @ite ℝ (𝔣 = 𝔡 * 𝔢 ∧ (Ideal.absNorm 𝔡 : ℝ) ≤ V ∧
              (Ideal.absNorm 𝔢 : ℝ) ≤ U) (Classical.propDecidable _) (μ 𝔡 * Λ 𝔢) 0) 0 := by
      refine Finset.sum_congr rfl (fun 𝔣 _ => ?_)
      have hm := hmem 𝔣
      by_cases hf : 𝔫 ≤ 𝔣
      · have hca := hconvA 𝔣 D (fun 𝔡 h => hD 𝔡 (le_trans hf h))
        split_ifs <;> first | rfl | exact hca | (exfalso; tauto)
      · split_ifs <;> first | rfl | (exfalso; tauto)
    
    have hT4 : ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (V < (Ideal.absNorm 𝔡 : ℝ) ∧ 𝔫 = 𝔡 * 𝔪)
          (Classical.propDecidable _) (μ 𝔡 * γ 𝔪) 0
        = ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (V < (Ideal.absNorm 𝔡 : ℝ) ∧ 𝔫 = 𝔡 * 𝔪)
            (Classical.propDecidable _)
            (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ))
              (Classical.propDecidable _) (Λ 𝔢) 0) 0 := by
      refine Finset.sum_congr rfl (fun 𝔡 _ => Finset.sum_congr rfl (fun 𝔪 _ => ?_))
      by_cases hdm : 𝔫 = 𝔡 * 𝔪
      · have hle : 𝔫 ≤ 𝔪 := by rw [hdm]; exact Ideal.mul_le_left
        have hcg := hconvG 𝔪 D (hne 𝔫 𝔪 h𝔫 hle) (fun 𝔢 h => hD 𝔢 (le_trans hle h))
        split_ifs <;> first | rfl | (exfalso; tauto) | (rw [hcg])
      · split_ifs <;> first | rfl | (exfalso; tauto)
    
    have hs8 := kai_ideal_vaughan_split K U V 𝔫 h𝔫 D hD μ Λ hΛ'
    
    have hG : ∀ 𝔪 : Ideal (NumberField.RingOfIntegers K),
        ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ)) (Classical.propDecidable _) (Λ 𝔢) 0
          = ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _)
              (if U < (Ideal.absNorm 𝔢 : ℝ) then Λ 𝔢 else 0) 0 := by
      intro 𝔪
      refine Finset.sum_congr rfl (fun 𝔢 _ => ?_)
      split_ifs <;> first | rfl | (exfalso; tauto)
    have hX : ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ 𝔫 = 𝔡 * 𝔪)
            (Classical.propDecidable _)
            (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ))
              (Classical.propDecidable _) (Λ 𝔢) 0) 0
        + ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (V < (Ideal.absNorm 𝔡 : ℝ) ∧ 𝔫 = 𝔡 * 𝔪)
            (Classical.propDecidable _)
            (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢 ∧ U < (Ideal.absNorm 𝔢 : ℝ))
              (Classical.propDecidable _) (Λ 𝔢) 0) 0
        = ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (𝔫 = 𝔡 * 𝔪) (Classical.propDecidable _)
            (μ 𝔡 * ∑ 𝔢 ∈ D, @ite ℝ (𝔪 ≤ 𝔢) (Classical.propDecidable _)
              (if U < (Ideal.absNorm 𝔢 : ℝ) then Λ 𝔢 else 0) 0) 0 := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun 𝔪 _ => ?_)
      rw [← hG 𝔪]
      by_cases hdm : 𝔫 = 𝔡 * 𝔪
      · by_cases hN : (Ideal.absNorm 𝔡 : ℝ) ≤ V
        · have hN' : ¬ V < (Ideal.absNorm 𝔡 : ℝ) := not_lt.mpr hN
          split_ifs <;> first | (exfalso; tauto) | ring
        · have hN' : V < (Ideal.absNorm 𝔡 : ℝ) := not_le.mp hN
          split_ifs <;> first | (exfalso; tauto) | ring
      · split_ifs <;> first | (exfalso; tauto) | ring
    
    have hs7 := kai_ideal_moebius_collapse K 𝔫 h𝔫 D hD μ hμ'
      (fun 𝔢 => if U < (Ideal.absNorm 𝔢 : ℝ) then Λ 𝔢 else 0)
    
    have hT1 : (if ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U then vonMangoldtO x else 0)
        + (if U < (Ideal.absNorm 𝔫 : ℝ) then Λ 𝔫 else 0) = vonMangoldtO x := by
      rw [hnorm, hΛx]
      by_cases h1 : (Ideal.absNorm 𝔫 : ℝ) ≤ U
      · have h2 : ¬ U < (Ideal.absNorm 𝔫 : ℝ) := not_lt.mpr h1
        rw [if_pos h1, if_neg h2, add_zero]
      · have h2 : U < (Ideal.absNorm 𝔫 : ℝ) := not_le.mp h1
        rw [if_neg h1, if_pos h2, zero_add]
    rw [hT2, hT3, hT4]
    linarith [hs8, hX, hs7, hT1]

theorem kai_small_norm_count (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ K₂ : ℝ, 0 ≤ K₂ ∧ ∀ (M U : ℝ), 1 ≤ M → 1 ≤ U →
      ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => x ≠ 0 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U)
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
        ≤ K₂ * ((omegaBox ω M).card : ℝ) * U ^ ((1:ℝ) / Module.finrank ℚ K) / M :=
by
  classical
  
  have hplace : ∃ Cs : ℝ, 0 ≤ Cs ∧ ∀ (M t : ℝ), 0 ≤ M → 0 ≤ t →
      ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => ∃ w : NumberField.InfinitePlace K, w (x : K) ≤ t)
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
        ≤ Cs * (t + 1) * (2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1) := by
    have slab : ∀ (n : ℕ) (a : Fin n → ℝ) (l₀ : Fin n), a l₀ ≠ 0 → ∀ (N : ℕ) (t : ℝ), 0 ≤ t →
        (((intBox n N).filter (fun z : Fin n → ℤ => |∑ l, ((z l : ℤ) : ℝ) * a l| ≤ t)).card : ℝ)
          ≤ (2 * (2 / |a l₀|) + 1) * (t + 1) * (2 * (N : ℝ) + 1) ^ (n - 1) := by
      intro n a l₀ ha N t ht
      have hc : 0 < |a l₀| := abs_pos.mpr ha
      set c := |a l₀| with hc_def
      set S := (intBox n N).filter (fun z : Fin n → ℤ => |∑ l, ((z l : ℤ) : ℝ) * a l| ≤ t)
        with hS
      set K₀ : ℕ := ⌊2 * t / c⌋₊ with hK₀_def
      set π : (Fin n → ℤ) → ({l // l ≠ l₀} → ℤ) := fun z l => z l.1 with hπ
      have hdiff : ∀ z z' : Fin n → ℤ, π z = π z' →
          ∑ l, ((z l : ℤ) : ℝ) * a l - ∑ l, ((z' l : ℤ) : ℝ) * a l
            = (((z l₀ - z' l₀ : ℤ)) : ℝ) * a l₀ := by
        intro z z' h
        rw [← Finset.sum_sub_distrib, Finset.sum_eq_single l₀]
        · push_cast; ring
        · intro l _ hl
          have : z l = z' l := congrFun h ⟨l, hl⟩
          rw [this]; ring
        · intro h'; exact absurd (Finset.mem_univ l₀) h'
      have hext : ∀ z z' : Fin n → ℤ, π z = π z' → z l₀ = z' l₀ → z = z' := by
        intro z z' h h0
        funext l
        by_cases hl : l = l₀
        · subst hl; exact h0
        · exact congrFun h ⟨l, hl⟩
      have hint : ∀ d : ℤ, (d : ℝ) ≤ 2 * t / c → d ≤ (K₀ : ℤ) := by
        intro d hd
        rcases le_or_gt d 0 with h0 | h0
        · omega
        · have h1 : ((d.toNat : ℕ) : ℝ) ≤ 2 * t / c := by
            have : (((d.toNat : ℕ) : ℤ) : ℝ) = (d : ℝ) := by rw [Int.toNat_of_nonneg h0.le]
            rw [Int.cast_natCast] at this
            rw [this]; exact hd
          have h2 : d.toNat ≤ K₀ := Nat.le_floor h1
          omega
      have hfib : ∀ b ∈ S.image π, (S.filter (fun z => π z = b)).card ≤ 2 * K₀ + 1 := by
        intro b hb
        obtain ⟨zs, hzsS, hzsb⟩ := Finset.mem_image.mp hb
        have hmaps : ∀ z ∈ S.filter (fun z => π z = b),
            z l₀ ∈ Finset.Icc (zs l₀ - K₀) (zs l₀ + K₀) := by
          intro z hz
          rw [Finset.mem_filter] at hz
          obtain ⟨hzS, hzb⟩ := hz
          have hzS' := (Finset.mem_filter.mp hzS).2
          have hzsS' := (Finset.mem_filter.mp hzsS).2
          have hd := hdiff z zs (hzb.trans hzsb.symm)
          have h1 : |((z l₀ - zs l₀ : ℤ) : ℝ)| * c ≤ 2 * t := by
            rw [hc_def, ← abs_mul, ← hd]
            calc _ ≤ |∑ l, ((z l : ℤ) : ℝ) * a l| + |∑ l, ((zs l : ℤ) : ℝ) * a l| := abs_sub _ _
              _ ≤ 2 * t := by linarith
          have h2 : |((z l₀ - zs l₀ : ℤ) : ℝ)| ≤ 2 * t / c := by
            rw [le_div_iff₀ hc]; exact h1
          have h3 := hint (z l₀ - zs l₀) ((le_abs_self _).trans h2)
          have h4 := hint (-(z l₀ - zs l₀)) (by rw [Int.cast_neg]; exact (neg_le_abs _).trans h2)
          rw [Finset.mem_Icc]
          constructor <;> omega
        calc (S.filter (fun z => π z = b)).card
            ≤ (Finset.Icc (zs l₀ - K₀) (zs l₀ + K₀)).card := by
              apply Finset.card_le_card_of_injOn (fun z => z l₀)
                (fun z hz => Finset.mem_coe.mpr (hmaps z (Finset.mem_coe.mp hz)))
              intro z hz z' hz' heq
              have hz1 := (Finset.mem_filter.mp hz).2
              have hz2 := (Finset.mem_filter.mp hz').2
              exact hext z z' (hz1.trans hz2.symm) heq
          _ = 2 * K₀ + 1 := by
              rw [Int.card_Icc]; omega
      have himg : (S.image π).card ≤ (2 * N + 1) ^ (n - 1) := by
        calc (S.image π).card
            ≤ (Fintype.piFinset (fun _ : {l // l ≠ l₀} => Finset.Icc (-(N : ℤ)) N)).card := by
              apply Finset.card_le_card
              intro b hb
              obtain ⟨z, hzS, rfl⟩ := Finset.mem_image.mp hb
              have hz := (Finset.mem_filter.mp hzS).1
              unfold intBox at hz
              rw [Finset.mem_Icc] at hz
              rw [Fintype.mem_piFinset]
              intro l
              rw [Finset.mem_Icc]
              exact ⟨hz.1 l.1, hz.2 l.1⟩
          _ = (2 * N + 1) ^ (n - 1) := by
              rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Int.card_Icc]
              have hcard : Fintype.card {l // l ≠ l₀} = n - 1 := by
                rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq, Fintype.card_fin]
              rw [hcard]
              congr 1
              omega
      have hcard : S.card ≤ (2 * K₀ + 1) * (2 * N + 1) ^ (n - 1) :=
        (Finset.card_le_mul_card_image S _ hfib).trans (Nat.mul_le_mul_left _ himg)
      have hK₀ : (K₀ : ℝ) ≤ 2 * t / c := Nat.floor_le (by positivity)
      have hcardR : (S.card : ℝ) ≤ (2 * (K₀ : ℝ) + 1) * (2 * (N : ℝ) + 1) ^ (n - 1) := by
        exact_mod_cast hcard
      refine hcardR.trans (mul_le_mul_of_nonneg_right ?_ (by positivity))
      have hu : 0 ≤ 2 / c := by positivity
      have h2t : 2 * t / c = 2 / c * t := by ring
      rw [h2t] at hK₀
      nlinarith [mul_nonneg hu ht]
    have hlin : ∀ (w : NumberField.InfinitePlace K) (z : Fin (Module.finrank ℚ K) → ℤ),
        (w.embedding ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)).re
          = ∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re := by
      intro w z
      rw [Module.Basis.equivFun_symm_apply, NumberField.RingOfIntegers.coe_eq_algebraMap, map_sum,
        map_sum, Complex.re_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [map_zsmul, map_zsmul, zsmul_eq_mul, Complex.mul_re, Complex.intCast_re,
        Complex.intCast_im, zero_mul, sub_zero, NumberField.RingOfIntegers.coe_eq_algebraMap]
    have hbound : ∀ (w : NumberField.InfinitePlace K) (z : Fin (Module.finrank ℚ K) → ℤ),
        |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
          ≤ w ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) := by
      intro w z
      rw [← hlin, ← NumberField.InfinitePlace.norm_embedding_eq]
      exact Complex.abs_re_le_norm _
    have hnz : ∀ w : NumberField.InfinitePlace K, ∃ l₀ : Fin (Module.finrank ℚ K),
        (w.embedding ((ω l₀ : NumberField.RingOfIntegers K) : K)).re ≠ 0 := by
      intro w
      by_contra h
      push_neg at h
      have h1 := hlin w (ω.equivFun 1)
      rw [LinearEquiv.symm_apply_apply] at h1
      simp only [h, mul_zero, Finset.sum_const_zero] at h1
      simp at h1
    choose l₀ hl₀ using hnz
    refine ⟨∑ w : NumberField.InfinitePlace K,
        (2 * (2 / |(w.embedding ((ω (l₀ w) : NumberField.RingOfIntegers K) : K)).re|) + 1),
      Finset.sum_nonneg (fun w _ => by positivity), ?_⟩
    intro M t hM ht
    have hsub : (@Finset.filter (NumberField.RingOfIntegers K)
            (fun x => ∃ w : NumberField.InfinitePlace K, w (x : K) ≤ t)
            (fun _ => Classical.propDecidable _) (omegaBox ω M))
        ⊆ Finset.univ.biUnion (fun w : NumberField.InfinitePlace K =>
            ((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
              |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
                ≤ t)).image (fun v => ω.equivFun.symm v)) := by
      intro x hx
      rw [Finset.filter_congr_decidable, Finset.mem_filter] at hx
      obtain ⟨hxB, w, hw⟩ := hx
      unfold omegaBox at hxB
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hxB
      rw [Finset.mem_biUnion]
      exact ⟨w, Finset.mem_univ _, Finset.mem_image.mpr
        ⟨v, Finset.mem_filter.mpr ⟨hv, (hbound w v).trans hw⟩, rfl⟩⟩
    have hcard := (Finset.card_le_card hsub).trans Finset.card_biUnion_le
    have hcardR : ((@Finset.filter (NumberField.RingOfIntegers K)
            (fun x => ∃ w : NumberField.InfinitePlace K, w (x : K) ≤ t)
            (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
        ≤ ∑ w : NumberField.InfinitePlace K,
            (((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
              |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
                ≤ t)).card : ℝ) := by
      have h2 : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
          (((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
              |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
                ≤ t)).image (fun v => ω.equivFun.symm v)).card
          ≤ ((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
              |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
                ≤ t)).card := fun w _ => Finset.card_image_le
      have h3 := hcard.trans (Finset.sum_le_sum h2)
      exact_mod_cast h3
    refine hcardR.trans ?_
    rw [Finset.sum_mul, Finset.sum_mul]
    exact Finset.sum_le_sum (fun w _ => slab _ _ (l₀ w) (hl₀ w) ⌊M⌋₊ t ht)
  
  have hsmall : ∀ (x : NumberField.RingOfIntegers K) (U : ℝ), 0 ≤ U →
      ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U →
      ∃ w : NumberField.InfinitePlace K, w (x : K) ≤ U ^ ((1:ℝ) / Module.finrank ℚ K) := by
    intro x U hU hx
    obtain ⟨w₀, -, hw₀⟩ := Finset.exists_min_image Finset.univ
      (fun w : NumberField.InfinitePlace K => w (x : K)) Finset.univ_nonempty
    refine ⟨w₀, ?_⟩
    have ha0 : 0 ≤ w₀ (x : K) := apply_nonneg _ _
    have hn : Module.finrank ℚ K ≠ 0 := Module.finrank_pos.ne'
    have hprod : w₀ (x : K) ^ Module.finrank ℚ K ≤ ((Algebra.norm ℤ x).natAbs : ℝ) := by
      calc w₀ (x : K) ^ Module.finrank ℚ K
          = ∏ w : NumberField.InfinitePlace K, w₀ (x : K) ^ w.mult := by
            rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
        _ ≤ ∏ w : NumberField.InfinitePlace K, (w (x : K)) ^ w.mult := by
            apply Finset.prod_le_prod
            · intro w _; exact pow_nonneg ha0 _
            · intro w _; exact pow_le_pow_left₀ ha0 (hw₀ w (Finset.mem_univ _)) _
        _ = ((|Algebra.norm ℚ (x : K)| : ℚ) : ℝ) := NumberField.InfinitePlace.prod_eq_abs_norm _
        _ = ((Algebra.norm ℤ x).natAbs : ℝ) := by
            rw [← Algebra.coe_norm_int, Nat.cast_natAbs, Rat.cast_abs, Rat.cast_intCast,
              Int.cast_abs]
    calc w₀ (x : K) = (w₀ (x : K) ^ Module.finrank ℚ K) ^ ((Module.finrank ℚ K : ℝ)⁻¹) :=
          (Real.pow_rpow_inv_natCast ha0 hn).symm
      _ ≤ U ^ ((Module.finrank ℚ K : ℝ)⁻¹) :=
          Real.rpow_le_rpow (pow_nonneg ha0 _) (hprod.trans hx) (by positivity)
      _ = U ^ ((1:ℝ) / Module.finrank ℚ K) := by rw [one_div]
  
  have hcardB : ∀ M : ℝ,
      ((omegaBox ω M).card : ℝ) = (2 * (⌊M⌋₊ : ℝ) + 1) ^ Module.finrank ℚ K := by
    intro M
    unfold omegaBox
    rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective]
    unfold intBox
    rw [Pi.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin, Int.card_Icc]
    have h : ((⌊M⌋₊ : ℤ) + 1 - -(⌊M⌋₊ : ℤ)).toNat = 2 * ⌊M⌋₊ + 1 := by omega
    rw [h]
    push_cast
    ring
  
  obtain ⟨Cs, hCs, hCsb⟩ := hplace
  refine ⟨2 * Cs, by positivity, ?_⟩
  intro M U hM hU
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hR1 : 1 ≤ U ^ ((1:ℝ) / Module.finrank ℚ K) := Real.one_le_rpow hU (by positivity)
  have hfl := Nat.lt_floor_add_one M
  have hfl0 : (0:ℝ) ≤ (⌊M⌋₊ : ℝ) := Nat.cast_nonneg _
  have hML : M ≤ 2 * (⌊M⌋₊ : ℝ) + 1 := by linarith
  have hMpos : 0 < M := by linarith
  have hL0 : 0 ≤ 2 * (⌊M⌋₊ : ℝ) + 1 := by positivity
  have hsub : (@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => x ≠ 0 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U)
          (fun _ => Classical.propDecidable _) (omegaBox ω M))
      ⊆ (@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => ∃ w : NumberField.InfinitePlace K,
            w (x : K) ≤ U ^ ((1:ℝ) / Module.finrank ℚ K))
          (fun _ => Classical.propDecidable _) (omegaBox ω M)) := by
    intro x hx
    rw [Finset.filter_congr_decidable, Finset.mem_filter] at hx
    rw [Finset.filter_congr_decidable, Finset.mem_filter]
    exact ⟨hx.1, hsmall x U (by linarith) hx.2.2⟩
  have h1 : ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => x ≠ 0 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U)
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
      ≤ ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => ∃ w : NumberField.InfinitePlace K,
            w (x : K) ≤ U ^ ((1:ℝ) / Module.finrank ℚ K))
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ) := by
    exact_mod_cast Finset.card_le_card hsub
  have h2 := hCsb M (U ^ ((1:ℝ) / Module.finrank ℚ K)) hMpos.le (by linarith)
  have hLpow : (2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * M
      ≤ ((omegaBox ω M).card : ℝ) := by
    rw [hcardB M]
    calc (2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * M
        ≤ (2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * (2 * (⌊M⌋₊ : ℝ) + 1) :=
          mul_le_mul_of_nonneg_left hML (pow_nonneg hL0 _)
      _ = (2 * (⌊M⌋₊ : ℝ) + 1) ^ Module.finrank ℚ K := by
          rw [← pow_succ, Nat.sub_add_cancel hn1]
  rw [le_div_iff₀ hMpos]
  calc ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => x ≠ 0 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U)
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ) * M
      ≤ (Cs * (U ^ ((1:ℝ) / Module.finrank ℚ K) + 1)
          * (2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1)) * M :=
        mul_le_mul_of_nonneg_right (h1.trans h2) hMpos.le
    _ ≤ (Cs * (2 * U ^ ((1:ℝ) / Module.finrank ℚ K))
          * (2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1)) * M := by
        apply mul_le_mul_of_nonneg_right _ hMpos.le
        apply mul_le_mul_of_nonneg_right _ (pow_nonneg hL0 _)
        apply mul_le_mul_of_nonneg_left _ hCs
        linarith
    _ = 2 * Cs * U ^ ((1:ℝ) / Module.finrank ℚ K)
          * ((2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * M) := by ring
    _ ≤ 2 * Cs * U ^ ((1:ℝ) / Module.finrank ℚ K) * ((omegaBox ω M).card : ℝ) :=
        mul_le_mul_of_nonneg_left hLpow (by positivity)
    _ = 2 * Cs * ((omegaBox ω M).card : ℝ) * U ^ ((1:ℝ) / Module.finrank ℚ K) := by ring

theorem kai_ideal_count_bounds (K : Type u) [Field K] [NumberField K] :
    ∃ C₅ : ℝ, 1 ≤ C₅ ∧ ∀ (X : ℝ), 1 ≤ X →
      ∀ S : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ 𝔞 ∈ S, 𝔞 ≠ ⊥ ∧ (Ideal.absNorm 𝔞 : ℝ) ≤ X) →
        (S.card : ℝ) ≤ C₅ * X ∧
        ∑ 𝔞 ∈ S, 1 / (Ideal.absNorm 𝔞 : ℝ) ≤ C₅ * (1 + Real.log X) :=
by
  classical
  have memF : ∀ (n : ℕ) (I : Ideal (NumberField.RingOfIntegers K)),
      I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset ↔
        Ideal.absNorm I ≤ n := by
    intro n I
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  have normpos : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ ⊥ → 0 < Ideal.absNorm I := by
    intro I hI
    exact Nat.pos_of_ne_zero (fun h => hI (Ideal.absNorm_eq_zero_iff.mp h))
  
  obtain ⟨C₁, hC₁1, hC⟩ : ∃ C₁ : ℝ, 1 ≤ C₁ ∧ ∀ Y : ℕ, 1 ≤ Y →
      ((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset.card : ℝ)
        ≤ C₁ * (Y : ℝ) := by
    obtain ⟨ρ, ht⟩ : ∃ ρ : ℝ, Filter.Tendsto (fun s : ℝ =>
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm I : ℝ) ≤ s} : ℝ) / s)
        Filter.atTop (nhds ρ) := ⟨_, NumberField.Ideal.tendsto_norm_le_div_atTop K⟩
    obtain ⟨s₀, hs₀⟩ := Filter.eventually_atTop.mp (ht.eventually (gt_mem_nhds (lt_add_one ρ)))
    have hcard : ∀ n : ℕ,
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm I : ℝ) ≤ (n : ℝ)})
          = (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset.card := by
      intro n
      rw [← Nat.card_eq_card_finite_toFinset]
      exact Nat.card_congr (Equiv.subtypeEquivRight (fun I => by
        simp only [Set.mem_setOf_eq, Nat.cast_le]))
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M =
        ((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) ⌈s₀⌉₊).toFinset.card : ℝ) :=
      ⟨_, rfl⟩
    refine ⟨max (max (ρ + 1) M) 1, le_max_right _ _, ?_⟩
    intro Y hY
    have hYpos : (0 : ℝ) < Y := by exact_mod_cast hY
    have hY1 : (1 : ℝ) ≤ Y := by exact_mod_cast hY
    have hmax0 : 0 ≤ max (max (ρ + 1) M) 1 := le_trans zero_le_one (le_max_right _ _)
    by_cases hYs : s₀ ≤ (Y : ℝ)
    · have h1 : (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm I : ℝ) ≤ (Y : ℝ)} : ℝ) / Y < ρ + 1 := hs₀ Y hYs
      rw [hcard Y, div_lt_iff₀ hYpos] at h1
      have h2 : ρ + 1 ≤ max (max (ρ + 1) M) 1 := le_trans (le_max_left _ _) (le_max_left _ _)
      nlinarith
    · push_neg at hYs
      have hYn : Y ≤ ⌈s₀⌉₊ := by
        have := Nat.le_ceil s₀
        exact_mod_cast (le_of_lt (lt_of_lt_of_le hYs this))
      have hsub : (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset ⊆
          (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) ⌈s₀⌉₊).toFinset := by
        intro I hI
        rw [memF] at hI ⊢
        exact le_trans hI hYn
      have h1 : ((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset.card : ℝ)
          ≤ M := by
        rw [hM]; exact_mod_cast Finset.card_le_card hsub
      have h2 : M ≤ max (max (ρ + 1) M) 1 := le_trans (le_max_right _ _) (le_max_left _ _)
      nlinarith
  have hC0 : 0 ≤ C₁ := by linarith
  
  obtain ⟨P, memP⟩ : ∃ P : ℕ → Finset (Ideal (NumberField.RingOfIntegers K)),
      ∀ n I, I ∈ P n ↔ I ≠ ⊥ ∧ Ideal.absNorm I ≤ n :=
    ⟨fun n => (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset.filter
      (fun I => I ≠ ⊥), fun n I => by rw [Finset.mem_filter, memF]; exact And.comm⟩
  have hFP : ∀ n : ℕ, (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset
      = insert ⊥ (P n) := by
    intro n; ext I
    rw [Finset.mem_insert, memF, memP]
    constructor
    · intro h
      by_cases hI : I = ⊥
      · exact Or.inl hI
      · exact Or.inr ⟨hI, h⟩
    · rintro (h | h)
      · rw [h, Ideal.absNorm_bot]; exact Nat.zero_le _
      · exact h.2
  have botP : ∀ n, (⊥ : Ideal (NumberField.RingOfIntegers K)) ∉ P n :=
    fun n h => ((memP n ⊥).mp h).1 rfl
  have hP0 : P 0 = ∅ := by
    by_contra hne
    obtain ⟨I, hI⟩ := Finset.nonempty_iff_ne_empty.mpr hne
    obtain ⟨h1, h2⟩ := (memP 0 I).mp hI
    have := normpos I h1
    omega
  have hA : ∀ n : ℕ, ((P n).card : ℝ) ≤ C₁ * n := by
    intro n
    rcases Nat.eq_zero_or_pos n with h0 | hn
    · subst h0
      rw [hP0]; simp
    · have h1 := hC n hn
      rw [hFP, Finset.card_insert_of_notMem (botP n)] at h1
      push_cast at h1
      linarith
  
  have hS : ∀ n : ℕ, (∑ I ∈ P n, 1 / (Ideal.absNorm I : ℝ)) - ((P n).card : ℝ) / ((n : ℝ) + 1)
      ≤ C₁ * (((harmonic (n + 1) : ℚ) : ℝ) - 1) := by
    intro n
    induction n with
    | zero =>
      rw [hP0]; norm_num [harmonic]
    | succ n ih =>
      have hsplit := Finset.sum_filter_add_sum_filter_not (P (n + 1))
        (fun I => Ideal.absNorm I ≤ n) (fun I => 1 / (Ideal.absNorm I : ℝ))
      have hcsplit := Finset.card_filter_add_card_filter_not (s := P (n + 1))
        (fun I => Ideal.absNorm I ≤ n)
      beta_reduce at hsplit hcsplit
      have hlow : (P (n + 1)).filter (fun I => Ideal.absNorm I ≤ n) = P n := by
        ext I
        rw [Finset.mem_filter, memP, memP]
        constructor
        · rintro ⟨⟨h0, _⟩, h⟩; exact ⟨h0, h⟩
        · rintro ⟨h0, h⟩; exact ⟨⟨h0, by omega⟩, h⟩
      have hhigh : ∀ I ∈ (P (n + 1)).filter (fun I => ¬ Ideal.absNorm I ≤ n),
          1 / (Ideal.absNorm I : ℝ) = 1 / ((n : ℝ) + 1) := by
        intro I hI
        rw [Finset.mem_filter, memP] at hI
        have : Ideal.absNorm I = n + 1 := by omega
        rw [this]; push_cast; ring
      rw [hlow, Finset.sum_congr rfl hhigh, Finset.sum_const, nsmul_eq_mul] at hsplit
      rw [hlow] at hcsplit
      have hA' := hA (n + 1)
      rw [← hcsplit] at hA'
      push_cast at hA'
      rw [← hsplit, ← hcsplit, harmonic_succ]
      push_cast
      generalize (((P (n + 1)).filter (fun I => ¬ Ideal.absNorm I ≤ n)).card : ℝ) = e at *
      generalize ((P n).card : ℝ) = a at *
      generalize (∑ I ∈ P n, 1 / (Ideal.absNorm I : ℝ)) = s at *
      generalize (((harmonic (n + 1) : ℚ) : ℝ)) = H at *
      have hx : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      have key : e * (1 / ((n : ℝ) + 1)) + a / ((n : ℝ) + 1) - (a + e) / ((n : ℝ) + 1 + 1)
          ≤ C₁ * ((n : ℝ) + 1 + 1)⁻¹ := by
        have h1 : e * (1 / ((n : ℝ) + 1)) + a / ((n : ℝ) + 1) - (a + e) / ((n : ℝ) + 1 + 1)
            = (a + e) / (((n : ℝ) + 1) * ((n : ℝ) + 1 + 1)) := by
          field_simp
          ring
        rw [h1, div_le_iff₀ (by positivity)]
        have h2 : C₁ * ((n : ℝ) + 1 + 1)⁻¹ * (((n : ℝ) + 1) * ((n : ℝ) + 1 + 1))
            = C₁ * ((n : ℝ) + 1) := by
          field_simp
        rw [h2]; linarith
      linarith
  have hSb : ∀ Y : ℕ, 1 ≤ Y →
      ∑ I ∈ P Y, 1 / (Ideal.absNorm I : ℝ) ≤ 2 * C₁ * (1 + Real.log (Y : ℝ)) := by
    intro Y hY
    have h1 := hS Y
    have h2 := hA Y
    have hY1 : (1 : ℝ) ≤ Y := by exact_mod_cast hY
    have h3 : (((harmonic (Y + 1) : ℚ) : ℝ)) ≤ 1 + Real.log ((Y : ℝ) + 1) := by
      have := harmonic_le_one_add_log (Y + 1)
      exact_mod_cast this
    have h4 : ((P Y).card : ℝ) / ((Y : ℝ) + 1) ≤ C₁ := by
      rw [div_le_iff₀ (by positivity)]; nlinarith
    have h5 : Real.log ((Y : ℝ) + 1) ≤ Real.log (Y : ℝ) + 1 := by
      have h6 : Real.log ((Y : ℝ) + 1) ≤ Real.log (2 * (Y : ℝ)) :=
        Real.log_le_log (by positivity) (by linarith)
      rw [Real.log_mul (by norm_num) (by positivity)] at h6
      have := Real.log_two_lt_d9
      linarith
    have h6 : 0 ≤ Real.log (Y : ℝ) := Real.log_nonneg hY1
    have h7 : C₁ * (((harmonic (Y + 1) : ℚ) : ℝ)) ≤ C₁ * (1 + Real.log ((Y : ℝ) + 1)) :=
      mul_le_mul_of_nonneg_left h3 hC0
    have h8 : C₁ * Real.log ((Y : ℝ) + 1) ≤ C₁ * (Real.log (Y : ℝ) + 1) :=
      mul_le_mul_of_nonneg_left h5 hC0
    have h9 : 0 ≤ C₁ * Real.log (Y : ℝ) := mul_nonneg hC0 h6
    nlinarith
  
  refine ⟨2 * C₁, by linarith, ?_⟩
  intro X hX S hS'
  have hX0 : (0 : ℝ) ≤ X := by linarith
  have hn1 : 1 ≤ ⌊X⌋₊ := (Nat.one_le_floor_iff X).mpr hX
  have hnX : ((⌊X⌋₊ : ℕ) : ℝ) ≤ X := Nat.floor_le hX0
  have hnpos : (0 : ℝ) < ((⌊X⌋₊ : ℕ) : ℝ) := by exact_mod_cast hn1
  have hsub : S ⊆ P ⌊X⌋₊ := by
    intro I hI
    obtain ⟨h0, hle⟩ := hS' I hI
    rw [memP]
    exact ⟨h0, Nat.le_floor hle⟩
  constructor
  · have hc1 : (S.card : ℝ) ≤ ((P ⌊X⌋₊).card : ℝ) := by
      exact_mod_cast Finset.card_le_card hsub
    have hc2 := hA ⌊X⌋₊
    have hc3 : C₁ * ((⌊X⌋₊ : ℕ) : ℝ) ≤ C₁ * X := mul_le_mul_of_nonneg_left hnX hC0
    nlinarith
  · have hs1 : ∑ 𝔞 ∈ S, 1 / (Ideal.absNorm 𝔞 : ℝ) ≤ ∑ 𝔞 ∈ P ⌊X⌋₊, 1 / (Ideal.absNorm 𝔞 : ℝ) :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity)
    have hs2 := hSb ⌊X⌋₊ hn1
    have hlog : Real.log ((⌊X⌋₊ : ℕ) : ℝ) ≤ Real.log X := Real.log_le_log hnpos hnX
    have hs3 : 2 * C₁ * (1 + Real.log ((⌊X⌋₊ : ℕ) : ℝ)) ≤ 2 * C₁ * (1 + Real.log X) :=
      mul_le_mul_of_nonneg_left (by linarith) (by linarith)
    linarith

theorem kai_omegaBox_norm_le (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (M : ℝ) (hM : 1 ≤ M)
    (x : NumberField.RingOfIntegers K) (hx : x ∈ omegaBox ω M) :
    ((Algebra.norm ℤ x).natAbs : ℝ) ≤ (C * M) ^ Module.finrank ℚ K :=
by
  classical
  have hC : 1 < C := hω.1
  have hs3 : basisSupNorm ω x ≤ M := by
    simp only [omegaBox, Finset.mem_image] at hx
    obtain ⟨v, hv, rfl⟩ := hx
    unfold basisSupNorm
    refine Real.iSup_le (fun j => ?_) (by linarith)
    have hrepr : ω.repr (ω.equivFun.symm v) j = v j := by
      rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    rw [hrepr]
    unfold intBox at hv
    rw [Finset.mem_Icc] at hv
    have h1 : -(⌊M⌋₊ : ℤ) ≤ v j := hv.1 j
    have h2 : v j ≤ (⌊M⌋₊ : ℤ) := hv.2 j
    have habs : |v j| ≤ (⌊M⌋₊ : ℤ) := abs_le.mpr ⟨h1, h2⟩
    have h3 : |((v j : ℤ) : ℝ)| ≤ ((⌊M⌋₊ : ℕ) : ℝ) := by
      rw [← Int.cast_abs]; exact_mod_cast habs
    exact h3.trans (Nat.floor_le (by linarith))
  have hbs0 : 0 ≤ basisSupNorm ω x := Real.iSup_nonneg (fun j => abs_nonneg _)
  have hcan0 : 0 ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) :=
    Real.iSup_nonneg (fun w => apply_nonneg w _)
  have hs1 : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) ≤
      canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ Module.finrank ℚ K := by
    have hle : ∀ w : NumberField.InfinitePlace K,
        w (algebraMap (NumberField.RingOfIntegers K) K x)
          ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) := fun w =>
      le_ciSup (f := fun w : NumberField.InfinitePlace K =>
        w (algebraMap (NumberField.RingOfIntegers K) K x)) (Set.finite_range _).bddAbove w
    have h1 : ∏ w : NumberField.InfinitePlace K,
          w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult
        ≤ ∏ w : NumberField.InfinitePlace K,
          canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult :=
      Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w _) _)
        (fun w _ => pow_le_pow_left₀ (apply_nonneg w _) (hle w) _)
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
    have hcast : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) = ∏ w : NumberField.InfinitePlace K,
        w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs, Rat.cast_abs]
      congr 1
      have hn := Algebra.coe_norm_int x
      rw [show algebraMap (NumberField.RingOfIntegers K) K x = (x : K) from rfl, ← hn]
      simp
    rw [hcast]; exact h1
  calc (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ)
      ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ Module.finrank ℚ K := hs1
    _ ≤ (C * basisSupNorm ω x) ^ Module.finrank ℚ K :=
        pow_le_pow_left₀ hcan0 ((hω.2 x).2) _
    _ ≤ (C * M) ^ Module.finrank ℚ K :=
        pow_le_pow_left₀ (mul_nonneg (by linarith) hbs0)
          (mul_le_mul_of_nonneg_left hs3 (by linarith)) _

theorem kai_vaughan_transfer_abstract {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M U V : ℝ)
    (hU : 1 < U) (hV : 1 < V) (Nmax : ℕ) (hNmax : 1 ≤ Nmax)
    (D : Finset (Ideal (NumberField.RingOfIntegers K))) (hD : ∀ 𝔡 ∈ D, 𝔡 ≠ ⊥)
    (hN : ∀ x ∈ omegaBox ω M, (Algebra.norm ℤ x).natAbs ≤ Nmax)
    (μ' a γ : Ideal (NumberField.RingOfIntegers K) → ℝ)
    (hμ : ∀ 𝔡, |μ' 𝔡| ≤ 1)
    (ha : ∀ 𝔣, 𝔣 ≠ ⊥ → |a 𝔣| ≤ Real.log (Ideal.absNorm 𝔣 : ℝ))
    (hγ : ∀ 𝔪, (Ideal.absNorm 𝔪 : ℝ) ≤ U → γ 𝔪 = 0)
    (hid : ∀ x ∈ omegaBox ω M, x ≠ 0 →
        vonMangoldtO x =
          (if ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U then vonMangoldtO x else 0)
          + ∑ 𝔡 ∈ D, @ite ℝ ((Ideal.absNorm 𝔡 : ℝ) ≤ V ∧ x ∈ 𝔡) (Classical.propDecidable _)
                (μ' 𝔡 * (Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
                  - Real.log (Ideal.absNorm 𝔡 : ℝ))) 0
          - ∑ 𝔣 ∈ D, @ite ℝ ((Ideal.absNorm 𝔣 : ℝ) ≤ U * V ∧ x ∈ 𝔣) (Classical.propDecidable _)
                (a 𝔣) 0
          + ∑ 𝔡 ∈ D, ∑ 𝔪 ∈ D, @ite ℝ (V < (Ideal.absNorm 𝔡 : ℝ) ∧ Ideal.span {x} = 𝔡 * 𝔪)
                (Classical.propDecidable _) (μ' 𝔡 * γ 𝔪) 0)
    (Φ : NumberField.RingOfIntegers K → ℂ) (T : ℝ) (hT0 : 0 ≤ T)
    (hT : ∀ x ∈ omegaBox ω M, ‖Φ x‖ ≤ T)
    (Λmax : ℝ) (hΛ : ∀ x ∈ omegaBox ω M, |vonMangoldtO x| ≤ Λmax)
    (τ : ℝ) (hτ0 : 0 ≤ τ)
    (hI : ∀ (I : Finset (Ideal (NumberField.RingOfIntegers K)))
        (A : Ideal (NumberField.RingOfIntegers K) → ℂ) (Y : ℝ),
        I ⊆ D → (∀ 𝔡 ∈ I, (Ideal.absNorm 𝔡 : ℝ) ≤ U * V) → (∀ 𝔡, ‖A 𝔡‖ ≤ 1) →
        ‖kaiTypeIForm ω M Φ (fun _ => 1) I A Y‖ ≤ τ)
    (hII : ‖kaiTypeIIForm ω M Φ (D.filter (fun 𝔡 => V < (Ideal.absNorm 𝔡 : ℝ)))
        (D.filter (fun 𝔡 => U < (Ideal.absNorm 𝔡 : ℝ)))
        (fun 𝔡 => ((μ' 𝔡 : ℝ) : ℂ)) (fun 𝔡 => ((γ 𝔡 : ℝ) : ℂ))‖ ≤ τ) :
    ‖∑ x ∈ omegaBox ω M, ((vonMangoldtO x : ℝ) : ℂ) * Φ x‖
      ≤ (2 * Real.log Nmax + Real.log V + Real.log (U * V) + 1) * τ
        + T * Λmax * ((@Finset.filter (NumberField.RingOfIntegers K)
            (fun x => x ≠ 0 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ U)
            (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
        + T * Real.log V * ((D.filter (fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) ≤ V)).card : ℝ)
        + T * Real.log (U * V) * ((D.filter (fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) ≤ U * V)).card : ℝ) :=
by
  
  have hlogV : 0 < Real.log V := Real.log_pos hV
  have hUV1 : 1 < U * V := by nlinarith
  have hlogUV : 0 < Real.log (U * V) := Real.log_pos hUV1
  have hVUV : V ≤ U * V := by nlinarith
  have hN1 : ∀ 𝔡 ∈ D, (1 : ℝ) ≤ (Ideal.absNorm 𝔡 : ℝ) := by
    intro 𝔡 h𝔡
    have h0 : Ideal.absNorm 𝔡 ≠ 0 := fun h => hD 𝔡 h𝔡 (Ideal.absNorm_eq_zero_iff.1 h)
    exact_mod_cast Nat.one_le_iff_ne_zero.2 h0
  
  have hΛ0 : vonMangoldtO (0 : NumberField.RingOfIntegers K) = 0 := by
    unfold vonMangoldtO
    rw [dif_neg]
    rintro ⟨p, m, hm, h⟩
    rw [Ideal.span_singleton_eq_bot.2 rfl] at h
    have hp : p.asIdeal ≠ 0 := by rw [Ideal.zero_eq_bot]; exact p.ne_bot
    have hpm : p.asIdeal ^ m ≠ 0 := pow_ne_zero m hp
    rw [Ideal.zero_eq_bot] at hpm
    exact hpm h.symm
