      (by linarith only [hcle]) (by rw [hcre2])
      (hgrow2 s₀.im _ (by rw [hcim2, abs_mul]; norm_num)
        (by rw [hcre2]; linarith only [hcLpos s₀.im])
        (by rw [hcre2]; linarith only [hcL1 s₀.im]))
  have hs0 : (0:ℝ) ≤ ∑ ρ ∈ Z2, ((mlt2 ρ : ℂ)/((((1 + c / Lf s₀.im : ℝ) : ℂ)
      + 2 * ((s₀.im : ℝ) : ℂ) * Complex.I) - ρ)).re := Finset.sum_nonneg h2c
  have hre0 : (((0:ℕ):ℂ)/((((1 + c / Lf s₀.im : ℝ) : ℂ)
      + 2 * ((s₀.im : ℝ) : ℂ) * Complex.I) - 1)).re = 0 := by simp
