            + (((a + a) * ν + 1 : ℕ) : ℝ) * ((C₄ : ℝ)
                * ((C₄ : ℝ) + ((2 * (a + a) * a : ℕ) : ℝ) * (2 + t) + Real.log (1 / η)))
            + t) := by
