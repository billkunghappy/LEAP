            (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg))

def KaiTBUnitData (K : Type u) [Field K] [NumberField K]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ) : Prop :=
  (∀ j, KaiTBCongUnit K q (H j)) ∧
  (0 < wq ∧ wq ∣ (NumberField.Units.torsionOrder K : ℕ)) ∧
  (∃ ζ : (NumberField.RingOfIntegers K)ˣ, KaiTBCongUnit K q ζ ∧ orderOf ζ = wq ∧
      ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiTBCongUnit K q v →
        ∃! p : ZMod wq × (Fin (NumberField.Units.rank K) → ℤ),
          v = ζ ^ (p.1.val) * ∏ j, (H j) ^ (p.2 j)) ∧
  (∀ j, ∑ w : NumberField.InfinitePlace K, kaiTBUnitLog K (H j) w = 0) ∧
  (∀ j, ∀ w : NumberField.InfinitePlace K,
      |kaiTBUnitLog K (H j) w| ≤ B * (Ideal.absNorm q : ℝ)) ∧
  (∀ i j, ∑ w : NumberField.InfinitePlace K, kaiTBUnitLog K (H i) w * e j w
      = if i = j then 1 else 0) ∧
  (∀ j, ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * e j w = 0) ∧
  (∀ j w, |e j w| ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) ∧
  (NumberField.Units.regulator K ≤ Rq ∧
    Rq ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) ∧
  (∃ N : ℕ, 0 < N ∧
    (N : ℝ) * (wq : ℝ) * NumberField.Units.regulator K
      = ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq ∧
    ∃ reps : Fin N → (NumberField.RingOfIntegers K)ˣ,
      ∀ v : (NumberField.RingOfIntegers K)ˣ, ∃! i : Fin N,
        KaiTBCongUnit K q (v * (reps i)⁻¹))

def KaiTBMem (K : Type u) [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
