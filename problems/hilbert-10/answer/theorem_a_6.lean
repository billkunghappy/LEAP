              NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K)))) :
    Continuous (fun u : NumberField.InfinitePlace K → ℝ =>
      kaiHZIdealTheta K a ρ η l (fun w => Real.exp (u w))) :=
by
  classical
  have hGnn : ∀ (y : NumberField.InfinitePlace K → ℝ)
      (x : NumberField.mixedEmbedding.mixedSpace K), 0 ≤ kaiHZGaussian K y x := by
    intro y x
    simp only [kaiHZGaussian]
    exact Real.exp_nonneg _
  obtain ⟨f, hf⟩ : ∃ f : ↥a → (NumberField.InfinitePlace K → ℝ) → ℂ,
