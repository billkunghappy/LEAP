      ((Complex.continuous_ofReal.measurable.comp hhm).mul
        (hφmeas.comp hT)).aestronglyMeasurable
    have hφfin : ∫⁻ t : ℝ, ‖φ t‖ₑ ≠ ⊤ :=
      ne_of_lt (MeasureTheory.hasFiniteIntegral_iff_enorm.mp hφint.hasFiniteIntegral)
    have hf : Measurable (fun a => ENNReal.ofReal (hh a)) := ENNReal.measurable_ofReal.comp hhm
    have hgm : Measurable (fun a => ‖φ (T a)‖ₑ) := (hφmeas.comp hT).enorm
