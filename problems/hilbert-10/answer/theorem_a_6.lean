          rintro ⟨j', hj', -⟩
          rw [Finset.mem_Ico] at hj'
          omega
        rw [hempty]
        simp
      · by_cases hp : ∃ j' ∈ Finset.Ico lo hi, c * ((hi : ℝ) - (j' : ℝ)) < f hi - f j'
        · obtain ⟨q, hq, hql⟩ := hp
