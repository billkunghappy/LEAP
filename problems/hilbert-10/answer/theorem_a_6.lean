      calc 2 * q₀ * (1 + a * (2 * u ^ 3 / δ ^ 6)) * (D ^ 2 * δ ^ 6)
          = 2 * ((q₀ * D ^ 2) * ((1 + a * (2 * u ^ 3 / δ ^ 6)) * δ ^ 6)) := by ring
        _ ≤ 2 * (P * (1 + a * (2 * u ^ 3))) := by linarith
        _ ≤ 2 * C := by linarith
        _ ≤ 2 * (T * (D ^ 2 * δ ^ 7)) := by linarith
        _ = T * (2 * δ) * (D ^ 2 * δ ^ 6) := by ring

theorem kai_quad_weyl_inverse (ν : ℕ) :
    ∃ (Cw : ℝ) (Aw : ℕ), 1 ≤ Cw ∧ 1 ≤ Aw ∧
      ∀ (N : ℕ) (δ : ℝ), 1 ≤ N → 0 < δ → δ ≤ 1 →
      ∀ (Ω : Set (Fin ν → ℝ)), Convex ℝ Ω →
