      _ = s w := by rw [hccinv w, one_mul]
  have hsupp : ∀ x : NumberField.InfinitePlace K → ℝ,
      Function.support (fun s : NumberField.InfinitePlace K → ℝ =>
        (kaiMFDualCoeff K bf vv η (fun p => -l p)
            (fun w => w (((v' : NumberField.RingOfIntegers K) : K)) * s w) -
          E * kaiMFDualCoeff K bf vv η (fun p => -l p) s) *
          ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            x w * s w ^ 2)) : ℝ) : ℂ))
        ⊆ Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
            (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
            fun w : NumberField.InfinitePlace K => w ((ν : K))) := by
    intro x
    rw [Function.support_subset_iff']
    intro s hs
    rw [hoffB _ (hoffscale s hs), hoffB s hs, mul_zero, sub_zero, zero_mul]
  have hY : ∀ (x : NumberField.InfinitePlace K → ℝ) (t : NumberField.InfinitePlace K → ℝ),
      (∑ w : NumberField.InfinitePlace K, x w * (Real.pi * t w ^ 2))
        = Real.pi * ∑ w : NumberField.InfinitePlace K, x w * t w ^ 2 := by
    intro x t
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun w _ => by ring)
  have hnn : ∀ (t : ↥(Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K)))))
      (w : NumberField.InfinitePlace K),
      0 ≤ (t : NumberField.InfinitePlace K → ℝ) w := by
    intro t w
    obtain ⟨ν, hν⟩ := t.2
    have h3 : (t : NumberField.InfinitePlace K → ℝ) w = w ((ν : K)) := congrFun hν.symm w
    rw [h3]
    exact apply_nonneg w ((ν : K))
  have hainj : Function.Injective (fun t : ↥(Set.range (fun ν : {x : K // x ∈ (bf :
      FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
      fun w : NumberField.InfinitePlace K => w ((ν : K)))) =>
      fun w : NumberField.InfinitePlace K =>
        Real.pi * ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2) := by
    intro t1 t2 h
    refine Subtype.ext (funext (fun w => ?_))
    have h1 : Real.pi * ((t1 : NumberField.InfinitePlace K → ℝ) w) ^ 2
        = Real.pi * ((t2 : NumberField.InfinitePlace K → ℝ) w) ^ 2 := congrFun h w
    have h2 : ((t1 : NumberField.InfinitePlace K → ℝ) w) ^ 2
        = ((t2 : NumberField.InfinitePlace K → ℝ) w) ^ 2 :=
      mul_left_cancel₀ (ne_of_gt Real.pi_pos) h1
    calc (t1 : NumberField.InfinitePlace K → ℝ) w
        = Real.sqrt (((t1 : NumberField.InfinitePlace K → ℝ) w) ^ 2) :=
          (Real.sqrt_sq (hnn t1 w)).symm
      _ = Real.sqrt (((t2 : NumberField.InfinitePlace K → ℝ) w) ^ 2) := by rw [h2]
      _ = (t2 : NumberField.InfinitePlace K → ℝ) w := Real.sqrt_sq (hnn t2 w)
  have hlocfin : ∀ M : ℝ, {t : ↥(Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K)))) |
      ∑ w : NumberField.InfinitePlace K,
        Real.pi * ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2 ≤ M}.Finite := by
    intro M
    refine Set.Finite.subset (hlocfinS (M / Real.pi)) ?_
    intro t ht
    have h1 : Real.pi * ∑ w : NumberField.InfinitePlace K,
        ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2 ≤ M := by
      rw [Finset.mul_sum]
      exact ht
    show ∑ w : NumberField.InfinitePlace K,
      ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2 ≤ M / Real.pi
    rw [le_div_iff₀ Real.pi_pos, mul_comm]
    exact h1
  have hsum3 : ∀ x : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < x w) →
      Summable (fun t : ↥(Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
          fun w : NumberField.InfinitePlace K => w ((ν : K)))) =>
        ‖kaiMFDualCoeff K bf vv η (fun p => -l p)
            (fun w => w (((v' : NumberField.RingOfIntegers K) : K)) *
              (t : NumberField.InfinitePlace K → ℝ) w) -
          E * kaiMFDualCoeff K bf vv η (fun p => -l p)
            ((t : NumberField.InfinitePlace K → ℝ))‖ *
          Real.exp (-∑ w : NumberField.InfinitePlace K,
            x w * (Real.pi * ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2))) := by
    intro x hx
    have h1 : Summable (fun t : ↥(Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K)))) =>
        ‖kaiMFDualCoeff K bf vv η (fun p => -l p)
            (fun w => w (((v' : NumberField.RingOfIntegers K) : K)) *
              (t : NumberField.InfinitePlace K → ℝ) w) -
          E * kaiMFDualCoeff K bf vv η (fun p => -l p)
            ((t : NumberField.InfinitePlace K → ℝ))‖ *
          Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            x w * ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2))) :=
      (hV x hx).1.subtype _
    simpa only [hY] using h1
  have hzero3 : ∀ x : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < x w) →
      (∑' t : ↥(Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
          fun w : NumberField.InfinitePlace K => w ((ν : K)))),
        (kaiMFDualCoeff K bf vv η (fun p => -l p)
            (fun w => w (((v' : NumberField.RingOfIntegers K) : K)) *
              (t : NumberField.InfinitePlace K → ℝ) w) -
          E * kaiMFDualCoeff K bf vv η (fun p => -l p)
            ((t : NumberField.InfinitePlace K → ℝ))) *
          ((Real.exp (-∑ w : NumberField.InfinitePlace K,
            x w * (Real.pi * ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2)) : ℝ) : ℂ))
        = 0 := by
    intro x hx
    have h2 := tsum_subtype_eq_of_support_subset (hsupp x)
    simpa only [hY] using h2.trans (hV x hx).2
  have hkey := kai_mf_cone_gaussian_coeff_unique
    (fun t : ↥(Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K)))) =>
      fun w : NumberField.InfinitePlace K =>
        Real.pi * ((t : NumberField.InfinitePlace K → ℝ) w) ^ 2)
    (fun t w => mul_nonneg Real.pi_pos.le (sq_nonneg _)) hainj hlocfin
    (fun t : ↥(Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K)))) =>
      kaiMFDualCoeff K bf vv η (fun p => -l p)
          (fun w => w (((v' : NumberField.RingOfIntegers K) : K)) *
            (t : NumberField.InfinitePlace K → ℝ) w) -
        E * kaiMFDualCoeff K bf vv η (fun p => -l p)
          ((t : NumberField.InfinitePlace K → ℝ)))
    hsum3 hzero3
  have hon : ∀ s : NumberField.InfinitePlace K → ℝ,
      s ∈ Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K))) →
      kaiMFDualCoeff K bf vv η (fun p => -l p)
          (fun w => w (((v' : NumberField.RingOfIntegers K) : K)) * s w)
        = E * kaiMFDualCoeff K bf vv η (fun p => -l p) s :=
    fun s hs => sub_eq_zero.mp (hkey ⟨s, hs⟩)
  have hoffgoal : ∀ s : NumberField.InfinitePlace K → ℝ,
      s ∉ Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K))) →
      kaiMFDualCoeff K bf vv η (fun p => -l p)
          (fun w => w (((v' : NumberField.RingOfIntegers K) : K)) * s w)
        = E * kaiMFDualCoeff K bf vv η (fun p => -l p) s := by
    intro s hs
    rw [hoffB _ (hoffscale s hs), hoffB s hs, mul_zero]
  by_cases hσ : σ ∈ Set.range (fun ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        fun w : NumberField.InfinitePlace K => w ((ν : K)))
  · exact hon σ hσ
  · exact hoffgoal σ hσ

theorem kai_mf_cone_lattice_shape_integral_bound {J : Type*} [Fintype J]
    (Lat : AddSubgroup (J → ℝ)) (hcount : Countable ↥Lat)
    (F : Set (J → ℝ)) (hF : MeasurableSet F)
    (hfd : MeasureTheory.IsAddFundamentalDomain (↥Lat) F MeasureTheory.volume)
    (hunfold : ∀ f : (J → ℝ) → ℂ,
        (∑' γ : ↥Lat, ∫⁻ u in F, ‖f (u + (γ : J → ℝ))‖ₑ) = ∫⁻ u : J → ℝ, ‖f u‖ₑ ∧
          (MeasureTheory.Integrable f MeasureTheory.volume →
            Summable (fun γ : ↥Lat => ∫ u in F, f (u + (γ : J → ℝ))) ∧
            (∑' γ : ↥Lat, ∫ u in F, f (u + (γ : J → ℝ))) = ∫ u : J → ℝ, f u))
    {S : Type*} [Countable S] {T : Type*} [Countable T]
    (sg : S → J → ℝ) (hsg : ∀ x j, 0 < sg x j)
    (Bc : S → ℂ)
    (z : J → ℂ) (hz : ∀ j, 0 < (z j).re)
    (hEuler : ∀ aa : J → ℝ, (∀ i, 0 < aa i) →
        (∀ zz : J → ℂ, (∀ i, 0 < (zz i).re) →
            MeasureTheory.Integrable
                (fun u : J → ℝ => ∏ i, Complex.exp (zz i * ((u i : ℝ) : ℂ)
                    - ((aa i * Real.exp (u i) : ℝ) : ℂ))) MeasureTheory.volume ∧
              (∫ u : J → ℝ, ∏ i, Complex.exp (zz i * ((u i : ℝ) : ℂ)
                    - ((aa i * Real.exp (u i) : ℝ) : ℂ)))
                = ∏ i, (Complex.Gamma (zz i) * ((aa i : ℝ) : ℂ) ^ (-(zz i)))) ∧
        (∀ cc : J → ℝ, (∀ i, 0 < cc i) →
            MeasureTheory.Integrable
                (fun u : J → ℝ => ∏ i, Real.exp (cc i * u i - aa i * Real.exp (u i)))
                MeasureTheory.volume ∧
              (∫ u : J → ℝ, ∏ i, Real.exp (cc i * u i - aa i * Real.exp (u i)))
                = ∏ i, (Real.Gamma (cc i) * aa i ^ (-(cc i)))))
    (emb : T → S) (act : ↥Lat → S → S)
    (hact : ∀ (γ : ↥Lat) (x : S) (j : J),
        sg (act γ x) j = sg x j * Real.exp ((γ : J → ℝ) j / 2))
    (hBc : ∀ (γ : ↥Lat) (x : S),
        Bc (act γ x) = Complex.exp (∑ j, z j * (((γ : J → ℝ) j : ℝ) : ℂ)) * Bc x)
    (hbij : Function.Bijective (fun p : T × ↥Lat => act p.2 (emb p.1)))
    (hTsum : Summable (fun x : T => ‖Bc (emb x)‖ *
        ∏ j, (Real.pi * sg (emb x) j ^ 2) ^ (-(z j).re)))
    (Φ : (J → ℝ) → ℂ)
    (hΦ : ∀ u : J → ℝ, HasSum (fun x : S => Bc x *
        ∏ j, Complex.exp (z j * ((u j : ℝ) : ℂ)
          - ((Real.pi * sg x j ^ 2 * Real.exp (u j) : ℝ) : ℂ))) (Φ u)) :
    ‖∫ u in F, Φ u‖
      ≤ (∑' x : T, ‖Bc (emb x)‖ * ∏ j, (Real.pi * sg (emb x) j ^ 2) ^ (-(z j).re)) *
          ∏ j, ‖Complex.Gamma (z j)‖ :=
by
  classical
  haveI : Countable ↥Lat := hcount
  obtain ⟨HH, hHH⟩ : ∃ HH : T → (J → ℝ) → ℂ, HH = fun (y : T) (v : J → ℝ) =>
      Bc (emb y) * ∏ j, Complex.exp (z j * ((v j : ℝ) : ℂ)
        - ((Real.pi * sg (emb y) j ^ 2 * Real.exp (v j) : ℝ) : ℂ)) := ⟨_, rfl⟩
  obtain ⟨GG, hGG⟩ : ∃ GG : T → (J → ℝ) → ℝ, GG = fun (y : T) (v : J → ℝ) =>
      ‖Bc (emb y)‖ * ∏ j, Real.exp ((z j).re * v j
        - Real.pi * sg (emb y) j ^ 2 * Real.exp (v j)) := ⟨_, rfl⟩
  obtain ⟨CC, hCC⟩ : ∃ CC : T → ℝ, CC = fun y : T =>
      ‖Bc (emb y)‖ * ∏ j, (Real.Gamma ((z j).re)
        * (Real.pi * sg (emb y) j ^ 2) ^ (-(z j).re)) := ⟨_, rfl⟩
  obtain ⟨II, hII⟩ : ∃ II : T → ℂ, II = fun y : T =>
      Bc (emb y) * ∏ j, (Complex.Gamma (z j)
        * ((Real.pi * sg (emb y) j ^ 2 : ℝ) : ℂ) ^ (-(z j))) := ⟨_, rfl⟩
  have hApos : ∀ (y : T) (j : J), 0 < Real.pi * sg (emb y) j ^ 2 :=
    fun y j => mul_pos Real.pi_pos (pow_pos (hsg (emb y) j) 2)
  have hE1 : ∀ y : T, MeasureTheory.Integrable (HH y) MeasureTheory.volume ∧
      (∫ v : J → ℝ, HH y v) = II y := by
    intro y
    obtain ⟨hIC, hVC⟩ := (hEuler (fun j => Real.pi * sg (emb y) j ^ 2) (hApos y)).1 z hz
    have hIC' : MeasureTheory.Integrable
        (fun u : J → ℝ => ∏ j, Complex.exp (z j * ((u j : ℝ) : ℂ)
          - ((Real.pi * sg (emb y) j ^ 2 * Real.exp (u j) : ℝ) : ℂ)))
        MeasureTheory.volume := hIC
    have hVC' : (∫ u : J → ℝ, ∏ j, Complex.exp (z j * ((u j : ℝ) : ℂ)
          - ((Real.pi * sg (emb y) j ^ 2 * Real.exp (u j) : ℝ) : ℂ)))
        = ∏ j, (Complex.Gamma (z j)
            * ((Real.pi * sg (emb y) j ^ 2 : ℝ) : ℂ) ^ (-(z j))) := hVC
    refine ⟨?_, ?_⟩
    · simp only [hHH]
      exact hIC'.const_mul (Bc (emb y))
    · simp only [hHH, hII]
      rw [MeasureTheory.integral_const_mul, hVC']
  have hE2 : ∀ y : T, MeasureTheory.Integrable (GG y) MeasureTheory.volume ∧
      (∫ v : J → ℝ, GG y v) = CC y := by
    intro y
    obtain ⟨hIR, hVR⟩ := (hEuler (fun j => Real.pi * sg (emb y) j ^ 2) (hApos y)).2
      (fun j => (z j).re) hz
    have hIR' : MeasureTheory.Integrable
        (fun u : J → ℝ => ∏ j, Real.exp ((z j).re * u j
          - Real.pi * sg (emb y) j ^ 2 * Real.exp (u j))) MeasureTheory.volume := hIR
    have hVR' : (∫ u : J → ℝ, ∏ j, Real.exp ((z j).re * u j
          - Real.pi * sg (emb y) j ^ 2 * Real.exp (u j)))
        = ∏ j, (Real.Gamma ((z j).re)
            * (Real.pi * sg (emb y) j ^ 2) ^ (-(z j).re)) := hVR
    refine ⟨?_, ?_⟩
    · simp only [hGG]
      exact hIR'.const_mul ‖Bc (emb y)‖
    · simp only [hGG, hCC]
      rw [MeasureTheory.integral_const_mul, hVR']
  have hG0 : ∀ (y : T) (v : J → ℝ), 0 ≤ GG y v := by
    intro y v
    simp only [hGG]
    exact mul_nonneg (norm_nonneg _) (Finset.prod_nonneg fun j _ => (Real.exp_pos _).le)
  have hCC0 : ∀ y : T, 0 ≤ CC y := by
    intro y
    simp only [hCC]
    exact mul_nonneg (norm_nonneg _) (Finset.prod_nonneg fun j _ =>
      (mul_pos (Real.Gamma_pos_of_pos (hz j)) (Real.rpow_pos_of_pos (hApos y j) _)).le)
  have hCsum : Summable CC := by
    refine (hTsum.mul_left (∏ j, Real.Gamma ((z j).re))).congr (fun y => ?_)
    simp only [hCC, Finset.prod_mul_distrib]
    ring
  have hnorm : ∀ (y : T) (v : J → ℝ), ‖HH y v‖ = GG y v := by
    intro y v
    simp only [hHH, hGG, norm_mul, Complex.norm_prod, Complex.norm_exp, Complex.sub_re,
      Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  have hcont : ∀ y : T, Continuous (HH y) := by
    intro y
    simp only [hHH]
    exact continuous_const.mul (continuous_finset_prod Finset.univ (fun j _ =>
      Complex.continuous_exp.comp
        ((continuous_const.mul (Complex.continuous_ofReal.comp (continuous_apply j))).sub
          (Complex.continuous_ofReal.comp (continuous_const.mul
            (Real.continuous_exp.comp (continuous_apply j)))))))
  have hlint : ∀ y : T, (∫⁻ v : J → ℝ, ‖HH y v‖ₑ) = ENNReal.ofReal (CC y) := by
    intro y
    have h1 : (∫⁻ v : J → ℝ, ‖HH y v‖ₑ)
        = ∫⁻ v : J → ℝ, ENNReal.ofReal (GG y v) := by
      refine MeasureTheory.lintegral_congr (fun v => ?_)
      rw [← hnorm y v, ofReal_norm_eq_enorm]
    rw [h1, ← MeasureTheory.ofReal_integral_eq_lintegral_ofReal (hE2 y).1
      (Filter.Eventually.of_forall (hG0 y)), (hE2 y).2]
  have hfin : (∑' w : T × ↥Lat, ∫⁻ u in F, ‖HH w.1 (u + (w.2 : J → ℝ))‖ₑ) ≠ ⊤ := by
    have hp : (∑' w : T × ↥Lat, ∫⁻ u in F, ‖HH w.1 (u + (w.2 : J → ℝ))‖ₑ)
        = ∑' (y : T) (γ : ↥Lat), ∫⁻ u in F, ‖HH y (u + (γ : J → ℝ))‖ₑ :=
      ENNReal.tsum_prod'
    have hinner : ∀ y : T, (∑' γ : ↥Lat, ∫⁻ u in F, ‖HH y (u + (γ : J → ℝ))‖ₑ)
        = ENNReal.ofReal (CC y) := by
      intro y
      rw [(hunfold (HH y)).1, hlint y]
    rw [hp, tsum_congr hinner, ← ENNReal.ofReal_tsum_of_nonneg hCC0 hCsum]
    exact ENNReal.ofReal_ne_top
  have hreindex : ∀ (u : J → ℝ) (w : T × ↥Lat),
      HH w.1 (u + (w.2 : J → ℝ))
        = Bc (act w.2 (emb w.1)) * ∏ j, Complex.exp (z j * ((u j : ℝ) : ℂ)
            - ((Real.pi * sg (act w.2 (emb w.1)) j ^ 2 * Real.exp (u j) : ℝ) : ℂ)) := by
    intro u w
    have hshape : ∀ j : J, Real.pi * sg (act w.2 (emb w.1)) j ^ 2 * Real.exp (u j)
        = Real.pi * sg (emb w.1) j ^ 2 * Real.exp (u j + (w.2 : J → ℝ) j) := by
      intro j
      have hsq : (Real.exp ((w.2 : J → ℝ) j / 2)) ^ 2 = Real.exp ((w.2 : J → ℝ) j) := by
        rw [sq, ← Real.exp_add, add_halves]
      rw [hact w.2 (emb w.1) j, mul_pow, hsq, Real.exp_add]
      ring
    simp only [hHH, Pi.add_apply, hshape]
    rw [hBc w.2 (emb w.1), Complex.exp_sum,
      mul_comm (∏ j, Complex.exp (z j * (((w.2 : J → ℝ) j : ℝ) : ℂ))) (Bc (emb w.1)),
      mul_assoc, ← Finset.prod_mul_distrib]
    refine congrArg (fun t => Bc (emb w.1) * t) (Finset.prod_congr rfl (fun j _ => ?_))
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hΦ' : ∀ u : J → ℝ,
      HasSum (fun w : T × ↥Lat => HH w.1 (u + (w.2 : J → ℝ))) (Φ u) := by
    intro u
    have hrange : ∀ x : S, x ∉ Set.range (fun p : T × ↥Lat => act p.2 (emb p.1)) →
        Bc x * ∏ j, Complex.exp (z j * ((u j : ℝ) : ℂ)
          - ((Real.pi * sg x j ^ 2 * Real.exp (u j) : ℝ) : ℂ)) = 0 := by
      intro x hx
      exact absurd (hbij.2 x) hx
    have heq : (fun w : T × ↥Lat => HH w.1 (u + (w.2 : J → ℝ)))
        = (fun x : S => Bc x * ∏ j, Complex.exp (z j * ((u j : ℝ) : ℂ)
            - ((Real.pi * sg x j ^ 2 * Real.exp (u j) : ℝ) : ℂ)))
          ∘ (fun p : T × ↥Lat => act p.2 (emb p.1)) := by
      funext w
      exact hreindex u w
    rw [heq]
    exact (hbij.1.hasSum_iff hrange).mpr (hΦ u)
  have hcontT : ∀ w : T × ↥Lat,
      Continuous (fun u : J → ℝ => HH w.1 (u + (w.2 : J → ℝ))) :=
    fun w => (hcont w.1).comp (continuous_id.add continuous_const)
  have hmeas : ∀ w : T × ↥Lat, MeasureTheory.AEStronglyMeasurable
      (fun u : J → ℝ => HH w.1 (u + (w.2 : J → ℝ))) (MeasureTheory.volume.restrict F) :=
    fun w => (hcontT w).aestronglyMeasurable
  have hfunΦ : Φ = fun u : J → ℝ => ∑' w : T × ↥Lat, HH w.1 (u + (w.2 : J → ℝ)) := by
    funext u
    exact ((hΦ' u).tsum_eq).symm
  have hkey : (∫ u in F, Φ u)
      = ∑' w : T × ↥Lat, ∫ u in F, HH w.1 (u + (w.2 : J → ℝ)) := by
    calc (∫ u in F, Φ u)
        = ∫ u in F, ∑' w : T × ↥Lat, HH w.1 (u + (w.2 : J → ℝ)) := by rw [hfunΦ]
      _ = ∑' w : T × ↥Lat, ∫ u in F, HH w.1 (u + (w.2 : J → ℝ)) :=
          MeasureTheory.integral_tsum hmeas hfin
  have hsummable : Summable (fun w : T × ↥Lat => ∫ u in F, HH w.1 (u + (w.2 : J → ℝ))) := by
