        ((MeasureTheory.volume.restrict G).withDensity w) (Set.Icc 0 1)
          = ∫⁻ u in G ∩ Ω, w u := by
      rw [heval _ measurableSet_Icc]
      have hse : {u : ι → ℝ | (∑ j, m j * u j) ∈ Set.Icc (0 : ℝ) 1} = Ω := hΩpre.symm
      rw [hse]
    rw [hscal] at hHaar
    exact hHaar
  
  have main : ∀ hh : (ι → ℝ) → ℝ, Measurable hh → (∀ u, 0 ≤ hh u) →
      (∀ (u : ι → ℝ) (ρ : ℝ), hh (fun i => u i + ρ) = hh u) →
