    have hBon := kai_bonferroni_compare P T T SS Y
      (((Ideal.absNorm 𝔠 * primorial m : ℕ) : ℝ) ^ Module.finrank ℚ K) V (k - 1)
      hQpos hV0 hTP hTP
    rw [Nat.sub_add_cancel hk1] at hBon
    have hcWeq : Y.filter (fun y => T y = ∅) = @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧ CoprimeToNat (primorial m) (ω.equivFun.symm z))
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * primorial m)) := by
