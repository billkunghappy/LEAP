      have h2 : I ⊔ q₂ = ⊤ := top_unique (hIq.symm.le.trans (sup_le_sup_left hle₂ I))
      rw [norm_mul, hext₁.2.2.1 I hI h1, hext₂.2.2.1 I hI h2, mul_one]
    · intro I hIq
      show lam₁ I * lam₂ I = 0
      by_cases h1 : I ⊔ q₁ = ⊤
      · by_cases h2 : I ⊔ q₂ = ⊤
        · exact absurd (Ideal.isCoprime_iff_sup_eq.mp
            ((Ideal.isCoprime_iff_sup_eq.mpr h1).mul_right
              (Ideal.isCoprime_iff_sup_eq.mpr h2))) hIq
        · rw [hext₂.2.2.2.1 I h2, mul_zero]
      · rw [hext₁.2.2.2.1 I h1, zero_mul]
    · show lam₁ 0 * lam₂ 0 = 0
      rw [hext₁.2.2.2.2.1, zero_mul]
    · intro α hα
      show lam₁ (Ideal.span {α}) * lam₂ (Ideal.span {α}) = _
      rw [hext₁.2.2.2.2.2 α hα, hext₂.2.2.2.2.2 α hα]
      unfold kaiHeckeTwist
      by_cases hu : IsUnit (Ideal.Quotient.mk (q₁ * q₂) α)
      · have hu₁ : IsUnit (Ideal.Quotient.mk q₁ α) := by
          have := hu.map (Ideal.Quotient.factor hle₁)
          rwa [Ideal.Quotient.factor_mk] at this
        have hu₂ : IsUnit (Ideal.Quotient.mk q₂ α) := by
          have := hu.map (Ideal.Quotient.factor hle₂)
          rwa [Ideal.Quotient.factor_mk] at this
        rw [dif_pos hu, dif_pos hu₁, dif_pos hu₂]
        have e₁ : π₁ hu.unit = hu₁.unit :=
          Units.ext (by rw [hπ₁, IsUnit.unit_spec, IsUnit.unit_spec, Ideal.Quotient.factor_mk])
        have e₂ : π₂ hu.unit = hu₂.unit :=
          Units.ext (by rw [hπ₂, IsUnit.unit_spec, IsUnit.unit_spec, Ideal.Quotient.factor_mk])
        have hαK : (α : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hα
        have hsign : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
            ((if η₁ w then ((Real.sign ((NumberField.mixedEmbedding K ((α : K))).1 w) : ℝ) : ℂ)
                else 1) *
              (if η₂ w then ((Real.sign ((NumberField.mixedEmbedding K ((α : K))).1 w) : ℝ) : ℂ)
                else 1))
            = (if xor (η₁ w) (η₂ w) then
                ((Real.sign ((NumberField.mixedEmbedding K ((α : K))).1 w) : ℝ) : ℂ) else 1) := by
          intro w
          have hx : (NumberField.mixedEmbedding K ((α : K))).1 w ≠ 0 := by
            rw [NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
            exact (map_ne_zero _).mpr hαK
          rcases Real.sign_apply_eq_of_ne_zero _ hx with h | h <;> rw [h] <;>
            cases η₁ w <;> cases η₂ w <;> norm_num
        have hprod : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              (if η₁ w then ((Real.sign ((NumberField.mixedEmbedding K ((α : K))).1 w) : ℝ) : ℂ)
                else 1)) *
            (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              (if η₂ w then ((Real.sign ((NumberField.mixedEmbedding K ((α : K))).1 w) : ℝ) : ℂ)
                else 1))
            = ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              (if xor (η₁ w) (η₂ w) then
                ((Real.sign ((NumberField.mixedEmbedding K ((α : K))).1 w) : ℝ) : ℂ) else 1) := by
          rw [← Finset.prod_mul_distrib]
          exact Finset.prod_congr rfl (fun w _ => hsign w)
        rw [MonoidHom.mul_apply, MonoidHom.comp_apply, MonoidHom.comp_apply, e₁, e₂,
          Circle.coe_mul, ← hprod]
        simp only [Pi.zero_apply, Complex.ofReal_zero, zero_mul, Finset.sum_const_zero,
          mul_zero, Complex.exp_zero, Int.cast_zero, Finset.prod_const_one, mul_one]
        ring
      · rw [dif_neg hu]
        have hnu : ¬ IsUnit (Ideal.Quotient.mk q₁ α) ∨ ¬ IsUnit (Ideal.Quotient.mk q₂ α) := by
          by_contra hcon
          push_neg at hcon
          obtain ⟨y₁, hy₁⟩ := (hunit q₁ α).mp hcon.1
          obtain ⟨y₂, hy₂⟩ := (hunit q₂ α).mp hcon.2
          apply hu
          refine (hunit (q₁ * q₂) α).mpr ⟨y₁ + y₂ - α * y₁ * y₂, ?_⟩
          have he : α * (y₁ + y₂ - α * y₁ * y₂) - 1 = -((α * y₁ - 1) * (α * y₂ - 1)) := by ring
          rw [he]
          exact neg_mem (Ideal.mul_mem_mul hy₁ hy₂)
        rcases hnu with h | h
        · rw [dif_neg h, zero_mul]
        · rw [dif_neg h, mul_zero]
  have hprin : KaiHeckePrincipal K (q₁ * q₂) (fun I => lam₁ I * lam₂ I) := by
    by_contra hnp₃
    obtain ⟨ξ₃, η₃, hext₃⟩ := hextmul
    obtain ⟨E₃, G₃, hE₃le, hE₃iff, hG₃, -, hser₃, -⟩ :=
      hcont (q₁ * q₂) hq₁₂ 0 0 ξ₃ η₃ (fun I => lam₁ I * lam₂ I) hext₃ (by simp)
    have hE₃ : E₃ = 0 := by
      have : E₃ ≠ 1 := fun h => hnp₃ (hE₃iff.mp h)
      omega
    obtain ⟨m₃, β₀₃, -, -, hβ₀₃1, -, -, hD₃⟩ :=
      hZF (q₁ * q₂) hq₁₂ ξ₃ η₃ _ hext₃ E₃ G₃ hE₃le hE₃iff hG₃ hser₃
    have hR₃ : (-(deriv G₃ (σ : ℂ) / G₃ (σ : ℂ))).re ≤ 4 * C * L := by
      have h := hD₃ σ hσ1 hσ2
      have hN : (Ideal.absNorm (q₁ * q₂) : ℝ) ≤ Q ^ 2 := by
        rw [map_mul, Nat.cast_mul, sq]
        exact mul_le_mul hN₁ hN₂ (Nat.cast_nonneg _) hQpos.le
      have hx0 : (0 : ℝ) ≤ (Ideal.absNorm (q₁ * q₂) : ℝ) := Nat.cast_nonneg _
      have h4 := hlogk _ hx0 4 (by nlinarith)
      rw [Nat.cast_ofNat] at h4
      have hCl := mul_le_mul_of_nonneg_left h4 hC.le
      have hw : (m₃ : ℂ) / ((σ : ℂ) - (β₀₃ : ℂ)) = (((m₃ : ℝ) / (σ - β₀₃) : ℝ) : ℂ) := by
        push_cast
        ring
      have hwnn : 0 ≤ (m₃ : ℝ) / (σ - β₀₃) := div_nonneg (Nat.cast_nonneg _) (by linarith)
      rw [hw] at h
      have h1 := Complex.abs_re_le_norm
        (deriv G₃ (σ : ℂ) / G₃ (σ : ℂ) - (((m₃ : ℝ) / (σ - β₀₃) : ℝ) : ℂ))
      rw [Complex.sub_re, Complex.ofReal_re] at h1
      have h2 := (abs_le.mp (h1.trans h)).1
      rw [Complex.neg_re]
      linarith
    have hser₁ : ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam₁ s * (s - 1) ^ (0 : ℕ) = G₁ s := by
      intro s hs
      rw [pow_zero, mul_one]
      exact heq₁ s hs
    have hser₂ : ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam₂ s * (s - 1) ^ (0 : ℕ) = G₂ s := by
      intro s hs
      rw [pow_zero, mul_one]
      exact heq₂ s hs
    obtain ⟨-, hI₁⟩ := hLD q₁ hq₁ ξ₁ η₁ lam₁ hext₁ 0 G₁ hG₁ hser₁ σ hσ1
    obtain ⟨-, hI₂⟩ := hLD q₂ hq₂ ξ₂ η₂ lam₂ hext₂ 0 G₂ hG₂ hser₂ σ hσ1
    obtain ⟨-, hI₃⟩ := hLD (q₁ * q₂) hq₁₂ ξ₃ η₃ _ hext₃ E₃ G₃ hG₃ hser₃ σ hσ1
    have hI₃' : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ((Λ (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
          (lam₁ (I : Ideal (NumberField.RingOfIntegers K)) *
            lam₂ (I : Ideal (NumberField.RingOfIntegers K))) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (σ : ℂ)))
        = -(deriv G₃ (σ : ℂ) / G₃ (σ : ℂ)) + (E₃ : ℂ) / ((σ : ℂ) - 1) := hI₃
    have hpos := kai_pp lam₀ lam₁ lam₂ h0one
      (hbd q₁ ξ₁ η₁ lam₁ hext₁) (hbd q₂ ξ₂ η₂ lam₂ hext₂) hreal₁ hreal₂
    rw [hI₀, hI₁, hI₂, hI₃', hE₀, hE₃] at hpos
    have hre1 : (((1 : ℕ) : ℂ) / ((σ : ℂ) - 1)).re = κ * L := by
      have : ((1 : ℕ) : ℂ) / ((σ : ℂ) - 1) = ((1 / (σ - 1) : ℝ) : ℂ) := by
        push_cast
        ring
      rw [this, Complex.ofReal_re, hσm1]
    have hre0 : (((0 : ℕ) : ℂ) / ((σ : ℂ) - 1)).re = 0 := by simp
    simp only [Complex.add_re] at hpos
    rw [hre1, hre0] at hpos
    have i₁ := hinv β₁ hβ₁l hβ₁u
    have i₂ := hinv β₂ hβ₂l hβ₂u
    have hκL_eq : κ * L = 40 * (C * L) + L := by rw [hκ_def]; ring
    nlinarith
  
  refine ⟨hprin, ?_⟩
  have hz₂' : G₂ (β₁ : ℂ) = 0 :=
    kai_hecke_zero_transfer K q₁ q₂ hq₁ hq₂ ξ₁ η₁ lam₁ ξ₂ η₂ lam₂ hext₁ hext₂ hprin
      G₁ G₂ hG₁ hG₂ heq₁ heq₂ β₁ hβ₁pos hβ₁u hz₁
  exact huniq₂ β₁ hβ₁l hβ₁u hz₂'

theorem kai_hecke_descent (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q 𝔡 : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0) (hqd : q ≤ 𝔡)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hext : KaiHeckeExt K q 0 0 ξ η lam)
    (hreal : ∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I))
    (hper : ∀ x y : NumberField.RingOfIntegers K,
      IsCoprime (Ideal.span {x}) q → IsCoprime (Ideal.span {y}) q → x - y ∈ 𝔡 →
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) →
      lam (Ideal.span {x}) = lam (Ideal.span {y})) :
    ∃ (ξ' : ((NumberField.RingOfIntegers K ⧸ 𝔡)ˣ) →* Circle)
      (η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (lam' : Ideal (NumberField.RingOfIntegers K) → ℂ),
      KaiHeckeExt K 𝔡 0 0 ξ' η' lam' ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), lam' I = (starRingEnd ℂ) (lam' I)) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q = ⊤ → lam' I = lam I) :=
by
  classical
  have hq' : q ≠ ⊥ := hq
  
  have htw_gen : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K))
      (ξ₀ : ((NumberField.RingOfIntegers K ⧸ 𝔞)ˣ) →* Circle) (x : NumberField.RingOfIntegers K),
      (∀ u : (NumberField.RingOfIntegers K ⧸ 𝔞)ˣ,
          Ideal.Quotient.mk 𝔞 x = (u : NumberField.RingOfIntegers K ⧸ 𝔞) →
          kaiHeckeTwist K 𝔞 0 0 ξ₀ η x = (ξ₀ u : ℂ) *
            ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              if η w then ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
              else 1) ∧
      (Ideal.span {x} ⊔ 𝔞 = ⊤ →
          ∃ u : (NumberField.RingOfIntegers K ⧸ 𝔞)ˣ,
            Ideal.Quotient.mk 𝔞 x = (u : NumberField.RingOfIntegers K ⧸ 𝔞)) ∧
      (Ideal.span {x} ⊔ 𝔞 ≠ ⊤ → kaiHeckeTwist K 𝔞 0 0 ξ₀ η x = 0) := by
    intro 𝔞 ξ₀ x
    refine ⟨fun u hu => ?_, fun h => ?_, fun h => ?_⟩
    · have hx : IsUnit (Ideal.Quotient.mk 𝔞 x) := hu ▸ u.isUnit
      have hxu : hx.unit = u := Units.ext (by rw [IsUnit.unit_spec]; exact hu)
      unfold kaiHeckeTwist
      rw [dif_pos hx, hxu]
      simp
    · have h1 : (1 : NumberField.RingOfIntegers K) ∈ Ideal.span {x} ⊔ 𝔞 := by
        rw [h]; exact Submodule.mem_top
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      have hrx : Ideal.Quotient.mk 𝔞 x * Ideal.Quotient.mk 𝔞 r = 1 := by
        rw [← map_mul, ← map_one (Ideal.Quotient.mk 𝔞), Ideal.Quotient.eq]
        have : x * r - 1 = -b := by rw [← hab]; ring
        rw [this]; exact 𝔞.neg_mem hb
      have hxu : IsUnit (Ideal.Quotient.mk 𝔞 x) := isUnit_iff_exists_inv.mpr ⟨_, hrx⟩
      exact ⟨hxu.unit, hxu.unit_spec.symm⟩
    · unfold kaiHeckeTwist
      rw [dif_neg]
      intro hx
      apply h
      obtain ⟨v, hv⟩ := hx
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑v⁻¹ : NumberField.RingOfIntegers K ⧸ 𝔞)
      have hxy : Ideal.Quotient.mk 𝔞 (x * y) = Ideal.Quotient.mk 𝔞 1 := by
        rw [map_mul, hy, ← hv, map_one]; exact v.mul_inv
      rw [Ideal.Quotient.eq] at hxy
      rw [Ideal.eq_top_iff_one]
      have h1 : (1 : NumberField.RingOfIntegers K) = x * y - (x * y - 1) := by ring
      rw [h1]
      exact Submodule.sub_mem _
        (Submodule.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self x)))
        (Submodule.mem_sup_right hxy)
  
  have hsgn_mul : ∀ a b : ℝ, Real.sign (a * b) = Real.sign a * Real.sign b := by
    intro a b
    rcases lt_trichotomy a 0 with ha | rfl | ha
    · rcases lt_trichotomy b 0 with hb | rfl | hb
      · rw [Real.sign_of_neg ha, Real.sign_of_neg hb, Real.sign_of_pos (mul_pos_of_neg_of_neg ha hb)]
        norm_num
      · simp [Real.sign_zero]
      · rw [Real.sign_of_neg ha, Real.sign_of_pos hb, Real.sign_of_neg (mul_neg_of_neg_of_pos ha hb)]
        norm_num
    · simp [Real.sign_zero]
    · rcases lt_trichotomy b 0 with hb | rfl | hb
      · rw [Real.sign_of_pos ha, Real.sign_of_neg hb, Real.sign_of_neg (mul_neg_of_pos_of_neg ha hb)]
        norm_num
      · simp [Real.sign_zero]
      · rw [Real.sign_of_pos ha, Real.sign_of_pos hb, Real.sign_of_pos (mul_pos ha hb)]
        norm_num
  have hsgn_eq : ∀ a b : ℝ, 0 < a * b → Real.sign a = Real.sign b := by
    intro a b hab
    rcases lt_trichotomy a 0 with ha | rfl | ha
    · have hb : b < 0 := by
        by_contra hb; push_neg at hb; nlinarith
      rw [Real.sign_of_neg ha, Real.sign_of_neg hb]
    · simp at hab
    · have hb : 0 < b := by
        by_contra hb; push_neg at hb; nlinarith
      rw [Real.sign_of_pos ha, Real.sign_of_pos hb]
  have hemb : ∀ (x : NumberField.RingOfIntegers K) (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K ((x : K))).1 w =
        NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) :=
    fun x w => NumberField.mixedEmbedding.mixedEmbedding_apply_isReal K (x : K) w
  have hembne : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ (w : {w : NumberField.InfinitePlace K // w.IsReal}),
        (NumberField.mixedEmbedding K ((x : K))).1 w ≠ 0 := by
    intro x hx w
    rw [hemb]
    exact (map_ne_zero _).mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx)
  have hsignS : ∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 →
      ((∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if η w then ((Real.sign ((NumberField.mixedEmbedding K
            (((x * y : NumberField.RingOfIntegers K) : K))).1 w) : ℝ) : ℂ) else 1)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) else 1) *
          (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then ((Real.sign ((NumberField.mixedEmbedding K ((y : K))).1 w) : ℝ) : ℂ) else 1)) ∧
      ((∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) else 1) *
          (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) else 1)
        = 1) ∧
      ((∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
          0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
              NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) →
        (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) else 1)
          = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then ((Real.sign ((NumberField.mixedEmbedding K ((y : K))).1 w) : ℝ) : ℂ) else 1)) := by
    intro x y hx hy
    refine ⟨?_, ?_, ?_⟩
    · rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      have hm : (NumberField.mixedEmbedding K (((x * y : NumberField.RingOfIntegers K) : K))).1 w =
          (NumberField.mixedEmbedding K ((x : K))).1 w *
            (NumberField.mixedEmbedding K ((y : K))).1 w := by
        rw [hemb, hemb, hemb]; push_cast; exact map_mul _ _ _
      rw [hm, hsgn_mul]
      split_ifs <;> push_cast <;> ring
    · rw [← Finset.prod_mul_distrib]
      refine Finset.prod_eq_one (fun w _ => ?_)
      split_ifs
      · rcases Real.sign_apply_eq_of_ne_zero _ (hembne x hx w) with h | h <;> rw [h] <;> norm_num
      · ring
    · intro hs
      refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [hsgn_eq ((NumberField.mixedEmbedding K ((x : K))).1 w)
        ((NumberField.mixedEmbedding K ((y : K))).1 w)
        (by rw [hemb x w, hemb y w]; exact hs w.1 w.2)]
  
  have hC0 : ∀ A : Ideal (NumberField.RingOfIntegers K), A ≠ ⊥ →
      ∃ (g : NumberField.RingOfIntegers K) (A' : Ideal (NumberField.RingOfIntegers K)),
        g ≠ 0 ∧ A' ≠ ⊥ ∧ Ideal.span {g} = A * A' ∧ A' ⊔ q = ⊤ := by
    intro A hA
    have hdiv : ∀ g ∈ A, g ≠ 0 →
        ∃ A' : Ideal (NumberField.RingOfIntegers K), A' ≠ ⊥ ∧ Ideal.span {g} = A * A' := by
      intro g hg hg0
      obtain ⟨A', hA'⟩ := (Ideal.dvd_span_singleton).mpr hg
      refine ⟨A', ?_, hA'⟩
      rintro rfl
      rw [Ideal.mul_bot, Ideal.span_singleton_eq_bot] at hA'
      exact hg0 hA'
    have hqA0 : q * A ≠ 0 := by
      rw [Ne, Ideal.zero_eq_bot, Ideal.mul_eq_bot]; push_neg; exact ⟨hq', hA⟩
    obtain ⟨g₀, hg₀⟩ := IsDedekindDomain.exists_sup_span_eq (Ideal.mul_le_left : q * A ≤ A) hqA0
    by_cases hg0 : g₀ = 0
    · subst hg0
      rw [Ideal.span_singleton_eq_bot.mpr rfl, sup_bot_eq] at hg₀
      have hqtop : q = ⊤ := by
        have h1 : A * q = A * ⊤ := by rw [Ideal.mul_top, mul_comm]; exact hg₀
        exact mul_left_cancel₀ hA h1
      obtain ⟨g, hgA, hg0'⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hA
      obtain ⟨A', hA'0, hA'⟩ := hdiv g hgA hg0'
      exact ⟨g, A', hg0', hA'0, hA', by rw [hqtop, sup_top_eq]⟩
    · have hgA : g₀ ∈ A := by
        rw [← hg₀]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self g₀)
      obtain ⟨A', hA'0, hA'⟩ := hdiv g₀ hgA hg0
      refine ⟨g₀, A', hg0, hA'0, hA', ?_⟩
      have h1 : A * ⊤ = A * (q ⊔ A') := by
        rw [Ideal.mul_top, Ideal.mul_sup, ← hA', mul_comm A q]; exact hg₀.symm
      rw [sup_comm]; exact (mul_left_cancel₀ hA h1).symm
  
  
  have hN4 : ∀ y x : NumberField.RingOfIntegers K, x ≠ 0 →
