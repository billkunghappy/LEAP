    have h : 2 * (Real.pi : ℂ) * Complex.I * ((-θ : ℝ) : ℂ)
        = ((-(2 * Real.pi * θ) : ℝ) : ℂ) * Complex.I := by push_cast; ring
    rw [h, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg,
      Real.sin_neg]
    push_cast; ring
  have hgiE_int : ∀ (θ : ℝ) (m : ℤ), giE (θ + m) = giE θ := by
    intro θ m
