  rw [← hΔ_def] at hΔ13 ⊢
  obtain ⟨Δθ, hΔθ_def⟩ : ∃ Δθ : ℝ, Δθ = (NumberField.Units.rank K : ℝ) / (2 * (l : ℝ)) :=
