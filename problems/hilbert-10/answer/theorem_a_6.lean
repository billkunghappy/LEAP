      have hv : t ^ d = NormedSpace.exp (d * Real.log t) := by
        rw [Real.rpow_def_of_pos ht, mul_comm (Real.log t) d, Real.exp_eq_exp_ℝ]
      rw [hv]
      exact h
    have hexpC : ∀ w : ℂ,
        HasSum (fun m : ℕ => w ^ m / ((Nat.factorial m : ℕ) : ℂ)) (Complex.exp w) := by
      intro w
      have h := NormedSpace.expSeries_div_hasSum_exp w
