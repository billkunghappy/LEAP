  obtain ⟨u, hu⟩ := kai_v_si_cube_pigeonhole (Module.finrank ℚ K) s hs1 Ry
    (nil2Eval p₀' (fun j i => ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) r₀' r₁' r₂' F)
