def KaiZFGenCharProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∀ (q : Ideal (NumberField.RingOfIntegers K))
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
    q ≠ 0 → KaiHeckeExt K q t l ξ η lam →
    (∀ s : ℂ, 1 < s.re →
        Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          lam (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) ∧
    (∀ s : ℂ, 1 < s.re →
        1 ≤ ‖kaiHeckeSeries K lam s‖ * (1 + 1 / (s.re - 1)) ^ (Module.finrank ℚ K)) ∧
    (∀ s : ℂ, 1 < s.re →
        Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
            ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)))) ∧
    (∀ s : ℂ, 1 < s.re →
        DifferentiableAt ℂ (kaiHeckeSeries K lam) s ∧
        deriv (kaiHeckeSeries K lam) s / kaiHeckeSeries K lam s
          = - kaiZFHeckeLogSum K lam s) ∧
    ((∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
        ∀ s : ℂ, 1 < s.re →
          kaiHeckeSeries K lam ((starRingEnd ℂ) s) = (starRingEnd ℂ) (kaiHeckeSeries K lam s)) ∧
    KaiHeckeExt K q (fun w => 2 * t w) (fun p => 2 * l p) (ξ ^ 2) (fun _ => false)
      (fun I => lam I * lam I) ∧
    ((∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) ↔
        KaiHeckePrincipal K q (fun I => lam I * lam I)) ∧
    (∀ σ γ : ℝ, 1 < σ →
        0 ≤ 3 * (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) (σ : ℂ)).re
            + 4 * (kaiZFHeckeLogSum K lam ((σ : ℂ) + (γ : ℂ) * Complex.I)).re
            + (kaiZFHeckeLogSum K (fun I => lam I * lam I)
                ((σ : ℂ) + 2 * (γ : ℂ) * Complex.I)).re)

def KaiZFTrivInfProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
    ∀ (t : NumberField.InfinitePlace K → ℝ)
