    pow_ne_zero _ (by linarith : (0 : ℝ) < 5 * C ^ 2 * C_e).ne'
  have hcube : η ^ 2 / C₅ * (s : ℝ) ^ Module.finrank ℚ K ≤
      ‖∑ z ∈ Finset.Icc (fun j => (s : ℤ) * u j)
