    (hlaw : ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
        kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l y
          = κ * (((∏ w : NumberField.InfinitePlace K,
                y w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ) *
              kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => r w / y w))
    (s : ℂ) (hs : s.re = -(1 : ℝ) / 2) :
    MeasureTheory.IntegrableOn
        (fun u : NumberField.InfinitePlace K → ℝ =>
          (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w)) -
              kaiHZArchWeight K η (fun p => -l p) 0) *
            kaiMFConeWeight K (kaiMFConeZdual K t l η (1 - s)) u) F2
        MeasureTheory.volume :=
by
  classical
  
  have hgamR : ∀ (a : NumberField.InfinitePlace K → ℝ), (∀ i, 0 < a i) →
      ∀ c : NumberField.InfinitePlace K → ℝ, (∀ i, 0 < c i) →
        MeasureTheory.Integrable
            (fun u : NumberField.InfinitePlace K → ℝ =>
              ∏ i, Real.exp (c i * u i - a i * Real.exp (u i)))
            MeasureTheory.volume ∧
          (∫ u : NumberField.InfinitePlace K → ℝ,
              ∏ i, Real.exp (c i * u i - a i * Real.exp (u i)))
            = ∏ i, (Real.Gamma (c i) * a i ^ (-(c i))) := by
    clear * - hGam
    intro a ha c hc
    have key : ∀ b : ℝ, 0 < b → ∀ w : ℂ, 0 < w.re →
        MeasureTheory.Integrable
            (fun x : ℝ => Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)))
