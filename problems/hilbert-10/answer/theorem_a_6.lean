        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
          (-((3 : ℝ) / 2)))
      = ((FractionalIdeal.absNorm
          (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
            : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
