      · rw [hα0 I hI, abs_zero, zero_mul]; linarith only [hlogU0]
      · push_neg at hI
        have := mul_le_mul (hα1 I) (hlogabs _ _ hI) (abs_nonneg _) zero_le_one
        linarith only [this]
    obtain ⟨q, hq, hmaj⟩ := hS4 M (η / 4) (1 + Real.log (U : ℝ)) U α
      (fun I => -(α I * Real.log (Ideal.absNorm I : ℝ))) hM (by positivity)
      (by linarith only [hη1]) (by linarith only [hlogU0]) hU1 hα1 hγ p₀ p₁ p₂ hyp
    exact hfinish q _ hq hI1 hmaj
  by_cases hc2 : η / 4 * ((omegaBox ω M).card : ℝ) ≤ ‖S₂‖
  · have hyp : η / 4 * ((omegaBox ω M).card : ℝ) ≤
        ‖∑ x ∈ omegaBox ω M,
            ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K)
                (U * U)).toFinset,
              ((@ite ℝ (x ∈ I) (Classical.propDecidable _)
                  ((fun _ => (0:ℝ)) I * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) + β I) 0
                    : ℝ) : ℂ)
                * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ := by
      refine hc2.trans (le_of_eq ?_)
      rw [hS₂]; refine congrArg (fun z : ℂ => ‖z‖) ?_
      refine Finset.sum_congr rfl (fun x _ => ?_)
      simp only [hT₂_def]
      rw [Complex.ofReal_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun I _ => ?_)
      by_cases hxI : x ∈ I
      · rw [if_pos hxI, if_pos hxI]; simp only [zero_mul, zero_add]
      · rw [if_neg hxI, if_neg hxI]
    have hUU : 1 ≤ U * U := by simpa using Nat.mul_le_mul hU1 hU1
    obtain ⟨q, hq, hmaj⟩ := hS4 M (η / 4) (1 + Real.log ((U : ℝ) * U)) (U * U)
      (fun _ => 0) β hM (by positivity) (by linarith only [hη1])
      (by linarith only [hlogUU0]) hUU (fun _ => by simp)
      (fun I => (hβ I).trans (by linarith only)) p₀ p₁ p₂ hyp
    exact hfinish q _ hq hI2 hmaj
  have hc3 : η / 4 * ((omegaBox ω M).card : ℝ) ≤ ‖S₃‖ := by
    push_neg at hc1 hc2; linarith only [hmain, hS₀n, hSDn, hEfin, hc1, hc2]
  obtain ⟨a', ha'_def⟩ : ∃ a' : Ideal (NumberField.RingOfIntegers K) → ℝ, a' = fun I =>
      @ite ℝ (Ideal.absNorm I ≤ X) (Classical.propDecidable _) (a I / L) 0 := ⟨_, rfl⟩
  have ha'1 : ∀ I, |a' I| ≤ 1 := by
    intro I; simp only [ha'_def]
    split_ifs with h
    · obtain ⟨h0, h1⟩ := ha I
      have hlog : Real.log (Ideal.absNorm I : ℝ) ≤ Real.log (X : ℝ) :=
        (le_abs_self _).trans (hlogabs _ _ h)
      rw [abs_of_nonneg (div_nonneg h0 hLpos.le), div_le_one hLpos]
      linarith only [h1, hlog, hlogXL]
    · rw [abs_zero]; norm_num
  have ha'0 : ∀ I, Ideal.absNorm I ≤ U → a' I = 0 := by
    intro I hI; simp only [ha'_def]; rw [ha0 I hI, zero_div]; split_ifs <;> rfl
  have hL2 : ∀ Y : ℕ, 1 ≤ Y → Y ≤ X →
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset,
        (b I) ^ 2 ≤ G * (Y : ℝ) := by
    intro Y hY hYX
    have h1 := (hS3 Y hY).2
    have h2 := Finset.sum_le_sum (s := (Ideal.finite_setOf_absNorm_le
        (S := NumberField.RingOfIntegers K) Y).toFinset) (fun I _ => by
      have := pow_le_pow_left₀ (abs_nonneg _) (hbτ I) 2
      rwa [sq_abs] at this)
    have hY1R : (1:ℝ) ≤ Y := by exact_mod_cast hY
    have hlogY : Real.log (Y:ℝ) ≤ Real.log (X:ℝ) :=
      Real.log_le_log (by linarith only [hY1R]) (by exact_mod_cast hYX)
    have h3 : (1 + Real.log (Y:ℝ)) ^ 3 ≤ (1 + Real.log (X:ℝ)) ^ 3 :=
      pow_le_pow_left₀ (by linarith only [Real.log_nonneg hY1R]) (by linarith only [hlogY]) 3
    refine (h2.trans h1).trans ?_
    calc Cd * (Y:ℝ) * (1 + Real.log (Y:ℝ)) ^ 3 ≤ Cd * Y * (1 + Real.log (X:ℝ)) ^ 3 :=
          mul_le_mul_of_nonneg_left h3 (by positivity)
      _ = G * Y := by rw [hG_def]; ring
  have heq : S₃ = (L : ℂ) * ∑ x ∈ omegaBox ω M,
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
        ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
              (a' I * b J) 0 : ℝ) : ℂ)
            * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)) := by
    rw [hS₃, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    simp only [hT₃_def]
    rw [Complex.ofReal_sum, Finset.sum_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun I hI => ?_)
    rw [Complex.ofReal_sum, Finset.sum_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun J _ => ?_)
    have ha'I : a' I = a I / L := by simp only [ha'_def]; rw [if_pos (memF X I hI)]
    by_cases h : I * J = Ideal.span {x}
    · rw [if_pos h, if_pos h, ha'I]
      have e : a I * b J = L * (a I / L * b J) := by field_simp
      rw [e]; push_cast; ring
    · rw [if_neg h, if_neg h]; simp
  rw [heq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos] at hc3
  have hyp3 : θ * ((omegaBox ω M).card : ℝ) ≤ ‖∑ x ∈ omegaBox ω M,
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
        ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          ((@ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _)
              (a' I * b J) 0 : ℝ) : ℂ)
            * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ := by
    have e : θ * ((omegaBox ω M).card : ℝ) = (η / 4 * ((omegaBox ω M).card : ℝ)) / L := by
      rw [hθ_def]; ring
    rw [e, div_le_iff₀ hLpos]; linarith only [hc3]
  obtain ⟨q, hq, hmaj⟩ := hS5 M θ G U U X a' b hM hθpos hθ1 hG1 hX1 ha'1 ha'0 hb0 hL2
    (by rw [← hΨ₂_def]; exact hΨU) (by rw [← hΨ₂_def]; exact hΨU) p₀ p₁ p₂ hyp3
  rw [← hΨ₂_def] at hq hmaj
  exact hfinish q _ hq hII hmaj

theorem kai_prime_pair_small_gcd (Pp : Finset ℕ) (hPp : ∀ p ∈ Pp, p.Prime) (c H : ℝ)
    (hc : 0 ≤ c) (hH : ∏ p ∈ Pp, (1 + c / (p : ℝ)) ≤ H)
    (Gs : Finset (Finset ℕ)) (μ : ℝ) (hGs : Gs ⊆ Pp.powerset) (hμ : 0 < μ)
    (hμGs : μ ≤ ∑ T ∈ Gs, ∏ p ∈ T, c / (p : ℝ)) :
    ∃ T₁ ∈ Gs, ∃ T₂ ∈ Gs, ((Nat.gcd (∏ p ∈ T₁, p) (∏ p ∈ T₂, p) : ℕ) : ℝ)
      ≤ 4 * (Real.exp (3 * c ^ 2) * H ^ 2 / μ ^ 2) ^ 2 :=
by
  
  have gcd_eq : ∀ T₁ T₂ : Finset ℕ, (∀ p ∈ T₁, p.Prime) → (∀ p ∈ T₂, p.Prime) →
      Nat.gcd (∏ p ∈ T₁, p) (∏ p ∈ T₂, p) = ∏ p ∈ T₁ ∩ T₂, p := by
    intro T₁ T₂ h₁ h₂
    have e1 := Finset.prod_inter_mul_prod_diff T₁ T₂ (fun p => p)
    have e2 := Finset.prod_inter_mul_prod_diff T₂ T₁ (fun p => p)
    rw [Finset.inter_comm T₂ T₁] at e2
    rw [← e1, ← e2, Nat.gcd_mul_left]
    have hcop : Nat.Coprime (∏ p ∈ T₁ \ T₂, p) (∏ p ∈ T₂ \ T₁, p) := by
      apply Nat.Coprime.prod_left
      intro i hi
      apply Nat.Coprime.prod_right
      intro j hj
      rw [Finset.mem_sdiff] at hi hj
      exact (Nat.coprime_primes (h₁ i hi.1) (h₂ j hj.1)).mpr (fun h => hi.2 (h ▸ hj.1))
    rw [Nat.Coprime.gcd_eq_one hcop, mul_one]
  
  have ident : ∀ (S : Finset ℕ) (a s : ℕ → ℝ),
      ∑ T₁ ∈ S.powerset, ∑ T₂ ∈ S.powerset,
        (∏ p ∈ T₁, a p) * (∏ p ∈ T₂, a p) * ∏ p ∈ T₁ ∩ T₂, s p
        = ∏ p ∈ S, (1 + 2 * a p + a p ^ 2 * s p) := by
    intro S a s
    induction S using Finset.induction_on with
    | empty => simp
    | insert x S hx ih =>
      rw [Finset.prod_insert hx, ← ih, Finset.sum_powerset_insert hx]
      have hA : ∀ T₁ ∈ S.powerset, ∑ T₂ ∈ (insert x S).powerset,
          (∏ p ∈ T₁, a p) * (∏ p ∈ T₂, a p) * ∏ p ∈ T₁ ∩ T₂, s p
          = (1 + a x) * ∑ T₂ ∈ S.powerset,
            (∏ p ∈ T₁, a p) * (∏ p ∈ T₂, a p) * ∏ p ∈ T₁ ∩ T₂, s p := by
        intro T₁ hT₁
        have hx1 : x ∉ T₁ := fun h => hx (Finset.mem_powerset.mp hT₁ h)
        rw [Finset.sum_powerset_insert hx, add_mul, one_mul, Finset.mul_sum]
        congr 1
        apply Finset.sum_congr rfl
        intro T₂ hT₂
        have hx2 : x ∉ T₂ := fun h => hx (Finset.mem_powerset.mp hT₂ h)
        rw [Finset.prod_insert hx2, Finset.inter_insert_of_notMem hx1]
        ring
      have hB : ∀ T₁ ∈ S.powerset, ∑ T₂ ∈ (insert x S).powerset,
          (∏ p ∈ insert x T₁, a p) * (∏ p ∈ T₂, a p) * ∏ p ∈ insert x T₁ ∩ T₂, s p
          = (a x + a x ^ 2 * s x) * ∑ T₂ ∈ S.powerset,
            (∏ p ∈ T₁, a p) * (∏ p ∈ T₂, a p) * ∏ p ∈ T₁ ∩ T₂, s p := by
        intro T₁ hT₁
        have hx1 : x ∉ T₁ := fun h => hx (Finset.mem_powerset.mp hT₁ h)
        rw [Finset.sum_powerset_insert hx, add_mul, Finset.mul_sum, Finset.mul_sum]
        congr 1
        · apply Finset.sum_congr rfl
          intro T₂ hT₂
          have hx2 : x ∉ T₂ := fun h => hx (Finset.mem_powerset.mp hT₂ h)
          rw [Finset.prod_insert hx1, Finset.insert_inter_of_notMem hx2]
          ring
        · apply Finset.sum_congr rfl
          intro T₂ hT₂
          have hx2 : x ∉ T₂ := fun h => hx (Finset.mem_powerset.mp hT₂ h)
          have hx12 : x ∉ T₁ ∩ T₂ := fun h => hx1 (Finset.mem_inter.mp h).1
          rw [Finset.prod_insert hx1, Finset.prod_insert hx2,
            ← Finset.insert_inter_distrib, Finset.prod_insert hx12]
          ring
      rw [Finset.sum_congr rfl hA, Finset.sum_congr rfl hB, ← Finset.mul_sum, ← Finset.mul_sum]
      ring
  
  have prodle : ∀ (S : Finset ℕ) (a s : ℕ → ℝ), (∀ p ∈ S, 0 ≤ a p) → (∀ p ∈ S, 0 ≤ s p) →
      ∏ p ∈ S, (1 + 2 * a p + a p ^ 2 * s p)
        ≤ (∏ p ∈ S, (1 + a p)) ^ 2 * Real.exp (∑ p ∈ S, a p ^ 2 * s p) := by
    intro S a s ha hs
    rw [Real.exp_sum, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
    apply Finset.prod_le_prod
    · intro p hp
      have := ha p hp
      have := hs p hp
      positivity
    · intro p hp
      have hA := ha p hp
      have hB := hs p hp
      have hd : 0 ≤ a p ^ 2 + 2 * a p ^ 3 * s p + a p ^ 4 * s p := by positivity
      have e : (1 + a p) ^ 2 * (1 + a p ^ 2 * s p) - (1 + 2 * a p + a p ^ 2 * s p)
          = a p ^ 2 + 2 * a p ^ 3 * s p + a p ^ 4 * s p := by ring
      have h1 : 1 + 2 * a p + a p ^ 2 * s p ≤ (1 + a p) ^ 2 * (1 + a p ^ 2 * s p) := by
        linarith
      have h2 : 1 + a p ^ 2 * s p ≤ Real.exp (a p ^ 2 * s p) := by
        linarith [Real.add_one_le_exp (a p ^ 2 * s p)]
      exact h1.trans (mul_le_mul_of_nonneg_left h2 (sq_nonneg _))
  
  have term : ∀ n : ℕ, 2 ≤ n →
      Real.sqrt (n : ℝ) / (n : ℝ) ^ 2 ≤ 2 / Real.sqrt ((n : ℝ) - 1) - 2 / Real.sqrt (n : ℝ) := by
    intro n hn
    have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
    have hu : 0 < Real.sqrt ((n : ℝ) - 1) := Real.sqrt_pos.mpr (by linarith)
    have hv : 0 < Real.sqrt (n : ℝ) := Real.sqrt_pos.mpr (by linarith)
    have huv : Real.sqrt ((n : ℝ) - 1) ≤ Real.sqrt (n : ℝ) := Real.sqrt_le_sqrt (by linarith)
    have hu2 : Real.sqrt ((n : ℝ) - 1) ^ 2 = (n : ℝ) - 1 := Real.sq_sqrt (by linarith)
    have hv2 : Real.sqrt (n : ℝ) ^ 2 = (n : ℝ) := Real.sq_sqrt (by linarith)
    set u := Real.sqrt ((n : ℝ) - 1) with hu_def
    set v := Real.sqrt (n : ℝ) with hv_def
    rw [← hv2]
    have key : 2 / u - 2 / v - v / (v ^ 2) ^ 2 = (2 * v ^ 2 * (v - u) - u) / (u * v ^ 3) := by
      field_simp
    have hnum : 2 * v ^ 2 * (v - u) - u = (v - u) ^ 2 * (2 * v + u) + u * (v ^ 2 - u ^ 2 - 1) := by
      ring
    have h0 : v ^ 2 - u ^ 2 - 1 = 0 := by linarith
    rw [h0, mul_zero, add_zero] at hnum
    have hnn : 0 ≤ (2 * v ^ 2 * (v - u) - u) / (u * v ^ 3) := by
      rw [hnum]
      apply div_nonneg
      · apply mul_nonneg (sq_nonneg _); linarith
      · positivity
    linarith
  have tele : ∀ M : ℕ, 1 ≤ M →
      ∑ n ∈ Finset.Icc 2 M, Real.sqrt (n : ℝ) / (n : ℝ) ^ 2 ≤ 2 - 2 / Real.sqrt (M : ℝ) := by
    intro M hM
    induction M, hM using Nat.le_induction with
    | base => simp
    | succ M hM ih =>
      rw [Finset.sum_Icc_succ_top (by omega)]
      have h := term (M + 1) (by omega)
      have e : ((M + 1 : ℕ) : ℝ) - 1 = (M : ℝ) := by push_cast; ring
      rw [e] at h
      linarith
  have sumle : ∀ S : Finset ℕ, (∀ n ∈ S, 2 ≤ n) →
      ∑ n ∈ S, Real.sqrt (n : ℝ) / (n : ℝ) ^ 2 ≤ 2 := by
    intro S hS
    have hsub : S ⊆ Finset.Icc 2 (max 1 (S.sup id)) := by
      intro n hn
      rw [Finset.mem_Icc]
      exact ⟨hS n hn, le_trans (Finset.le_sup (f := id) hn) (le_max_right _ _)⟩
    have h1 := Finset.sum_le_sum_of_subset_of_nonneg hsub
      (f := fun n : ℕ => Real.sqrt (n : ℝ) / (n : ℝ) ^ 2)
      (fun n _ _ => div_nonneg (Real.sqrt_nonneg _) (sq_nonneg _))
    have h2 := tele (max 1 (S.sup id)) (le_max_left _ _)
    have h3 : 0 ≤ 2 / Real.sqrt ((max 1 (S.sup id) : ℕ) : ℝ) :=
      div_nonneg (by norm_num) (Real.sqrt_nonneg _)
    linarith
  
  have hpos : ∀ p ∈ Pp, (0 : ℝ) < p := fun p hp => by exact_mod_cast (hPp p hp).pos
  have hprod_pos : 0 < ∏ p ∈ Pp, (1 + c / (p : ℝ)) :=
    Finset.prod_pos (fun p hp => by have := hpos p hp; positivity)
  have hHpos : 0 < H := lt_of_lt_of_le hprod_pos hH
  have hw : ∀ T : Finset ℕ, 0 ≤ ∏ p ∈ T, c / (p : ℝ) :=
    fun T => Finset.prod_nonneg (fun p _ => div_nonneg hc (Nat.cast_nonneg p))
  have hσ : ∀ T₁ T₂ : Finset ℕ, 0 ≤ ∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ) :=
    fun _ _ => Finset.prod_nonneg (fun p _ => Real.sqrt_nonneg _)
  
  have hU : ∑ T₁ ∈ Pp.powerset, ∑ T₂ ∈ Pp.powerset,
      (∏ p ∈ T₁, c / (p : ℝ)) * (∏ p ∈ T₂, c / (p : ℝ)) * ∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ)
        ≤ H ^ 2 * Real.exp (2 * c ^ 2) := by
    have hid := ident Pp (fun p => c / (p : ℝ)) (fun p => Real.sqrt (p : ℝ))
    simp only at hid
    rw [hid]
    have hle := prodle Pp (fun p => c / (p : ℝ)) (fun p => Real.sqrt (p : ℝ))
      (fun p _ => div_nonneg hc (Nat.cast_nonneg p)) (fun p _ => Real.sqrt_nonneg _)
    simp only at hle
    refine hle.trans ?_
    have hexp : ∑ p ∈ Pp, (c / (p : ℝ)) ^ 2 * Real.sqrt (p : ℝ) ≤ 2 * c ^ 2 := by
      have e : ∑ p ∈ Pp, (c / (p : ℝ)) ^ 2 * Real.sqrt (p : ℝ)
          = c ^ 2 * ∑ p ∈ Pp, Real.sqrt (p : ℝ) / (p : ℝ) ^ 2 := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro p _
        rw [div_pow]
        ring
      rw [e]
      have := sumle Pp (fun p hp => (hPp p hp).two_le)
      nlinarith [sq_nonneg c]
    have h1 : (∏ p ∈ Pp, (1 + c / (p : ℝ))) ^ 2 ≤ H ^ 2 := pow_le_pow_left₀ hprod_pos.le hH 2
    exact mul_le_mul h1 (Real.exp_le_exp.mpr hexp) (Real.exp_pos _).le (sq_nonneg _)
  
  have hV : ∑ T₁ ∈ Gs, ∑ T₂ ∈ Gs,
      (∏ p ∈ T₁, c / (p : ℝ)) * (∏ p ∈ T₂, c / (p : ℝ)) * ∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ)
        ≤ ∑ T₁ ∈ Pp.powerset, ∑ T₂ ∈ Pp.powerset,
      (∏ p ∈ T₁, c / (p : ℝ)) * (∏ p ∈ T₂, c / (p : ℝ)) * ∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ) := by
    calc _ ≤ ∑ T₁ ∈ Gs, ∑ T₂ ∈ Pp.powerset,
          (∏ p ∈ T₁, c / (p : ℝ)) * (∏ p ∈ T₂, c / (p : ℝ)) * ∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ) :=
          Finset.sum_le_sum (fun T₁ _ => Finset.sum_le_sum_of_subset_of_nonneg hGs
            (fun T₂ _ _ => mul_nonneg (mul_nonneg (hw _) (hw _)) (hσ _ _)))
      _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg hGs
          (fun T₁ _ _ => Finset.sum_nonneg
            (fun T₂ _ => mul_nonneg (mul_nonneg (hw _) (hw _)) (hσ _ _)))
  
  by_contra hcon
  push_neg at hcon
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = 2 * (Real.exp (3 * c ^ 2) * H ^ 2 / μ ^ 2) := ⟨_, rfl⟩
  have hRpos : 0 < R := by rw [hR]; positivity
  have hG0 : 4 * (Real.exp (3 * c ^ 2) * H ^ 2 / μ ^ 2) ^ 2 = R ^ 2 := by rw [hR]; ring
  have hlt : ∀ T₁ ∈ Gs, ∀ T₂ ∈ Gs, R ≤ ∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ) := by
    intro T₁ h₁ T₂ h₂
    have hp1 : ∀ p ∈ T₁, p.Prime := fun p hp => hPp p (Finset.mem_powerset.mp (hGs h₁) hp)
    have hp2 : ∀ p ∈ T₂, p.Prime := fun p hp => hPp p (Finset.mem_powerset.mp (hGs h₂) hp)
    have h := hcon T₁ h₁ T₂ h₂
    rw [hG0, gcd_eq T₁ T₂ hp1 hp2, Nat.cast_prod] at h
    have hsq : (∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ)) ^ 2 = ∏ p ∈ T₁ ∩ T₂, (p : ℝ) := by
      rw [← Finset.prod_pow]
      apply Finset.prod_congr rfl
      intro p _
      exact Real.sq_sqrt (Nat.cast_nonneg _)
    rw [← hsq] at h
    exact (lt_of_pow_lt_pow_left₀ 2 (hσ _ _) h).le
  have hsum : R * (∑ T ∈ Gs, ∏ p ∈ T, c / (p : ℝ)) ^ 2 ≤ ∑ T₁ ∈ Gs, ∑ T₂ ∈ Gs,
      (∏ p ∈ T₁, c / (p : ℝ)) * (∏ p ∈ T₂, c / (p : ℝ)) * ∏ p ∈ T₁ ∩ T₂, Real.sqrt (p : ℝ) := by
    rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro T₁ h₁
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro T₂ h₂
    have := hlt T₁ h₁ T₂ h₂
    calc R * ((∏ p ∈ T₁, c / (p : ℝ)) * (∏ p ∈ T₂, c / (p : ℝ)))
        = (∏ p ∈ T₁, c / (p : ℝ)) * (∏ p ∈ T₂, c / (p : ℝ)) * R := by ring
