  have hmaps : ∀ z ∈ @Finset.filter (Fin ν → ℤ)
      (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ A z)
      (fun _ => Classical.propDecidable _) (intBox ν N),
      (fun j => z j % (L:ℤ)) ∈ @Finset.filter (Fin ν → ℤ) A
