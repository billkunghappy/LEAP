        rw [eq_top_iff, ← hγ]
        exact sup_le ((Ideal.span_singleton_le_iff_mem M).mpr hγ') hDM
      · have hM0 : M ≠ ⊥ := by
          intro h
          apply hq
          rw [Ideal.zero_eq_bot]
