              (∀ ρ ∈ Z, 0 ≤ ((mlt ρ : ℂ) / (z - ρ)).re) ∧
              ((∑ ρ ∈ Z, ((mlt ρ : ℂ) / (z - ρ)).re) + (kaiZFHeckeLogSum K mu z).re
