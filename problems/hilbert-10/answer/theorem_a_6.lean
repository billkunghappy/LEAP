  · intro I hI0 hIq
    obtain ⟨j, hj⟩ := hcov₀ I hI0 hIq
    have hj' := hERtrans q I (a₀ j) (a j) hj (haeq j)
    obtain ⟨k, hk⟩ := hσcov j
    have hIk := hERtrans q I (a j) (a (σ k)) hj' hk
    refine ⟨k, hIk, ?_⟩
    intro k' hk'
    exact hσuniq k' k (hERtrans q (a (σ k')) I (a (σ k)) (hERsymm q I (a (σ k')) hk') hIk)

theorem kai_mf_cong_unit_index (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∃ (hh : ℕ) (T : Set (NumberField.RingOfIntegers K)ˣ),
        0 < hh ∧ Nat.card T = hh ∧
        (∀ t ∈ T, ((t : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) - 1 ∈ q) ∧
        (∀ v : (NumberField.RingOfIntegers K)ˣ,
            ((v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1 ∈ q →
          ∃! p : {t // t ∈ T} ×
                 {u : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q u},
            v = (p.1 : (NumberField.RingOfIntegers K)ˣ) *
                  (p.2 : (NumberField.RingOfIntegers K)ˣ)) :=
by
  classical
  intro q _hq
  have hEone : ((1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1 ∈ q := by
    rw [Units.val_one, sub_self]
    exact Submodule.zero_mem q
  have hEmul : ∀ a b : (NumberField.RingOfIntegers K)ˣ,
      (a : NumberField.RingOfIntegers K) - 1 ∈ q →
      (b : NumberField.RingOfIntegers K) - 1 ∈ q →
      ((a * b : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1 ∈ q := by
    intro a b ha hb
    have key : ((a * b : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1
        = (a : NumberField.RingOfIntegers K) * ((b : NumberField.RingOfIntegers K) - 1)
          + ((a : NumberField.RingOfIntegers K) - 1) := by
      rw [Units.val_mul]; ring
    rw [key]
    exact Submodule.add_mem q (Ideal.mul_mem_left q _ hb) ha
  have hEinv : ∀ a : (NumberField.RingOfIntegers K)ˣ,
      (a : NumberField.RingOfIntegers K) - 1 ∈ q →
      ((a⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1 ∈ q := by
    intro a ha
    have hc : ((a⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
        * (a : NumberField.RingOfIntegers K) = 1 := a.inv_mul
    have key : ((a⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1
        = -(((a⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
            * ((a : NumberField.RingOfIntegers K) - 1)) := by
      rw [mul_sub, hc]; ring
    rw [key]
    exact Submodule.neg_mem q (Ideal.mul_mem_left q _ ha)
  have hne : ∀ (u : (NumberField.RingOfIntegers K)ˣ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K ((u : NumberField.RingOfIntegers K) : K)).1 w ≠ 0 := by
    intro u w
    have h1 : ((u : NumberField.RingOfIntegers K) : K) *
        (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1 := by
      have h0 := congrArg (fun z : NumberField.RingOfIntegers K => (z : K)) (Units.mul_inv u)
      simpa using h0
    have h2 := congrArg (NumberField.mixedEmbedding K) h1
    rw [map_mul, map_one] at h2
    have h3 := congrFun (congrArg Prod.fst h2) w
    simp only [Prod.fst_mul, Pi.mul_apply, Prod.fst_one, Pi.one_apply] at h3
    intro h0
    rw [h0, zero_mul] at h3
    exact zero_ne_one h3
  have hmulc : ∀ (a b : (NumberField.RingOfIntegers K)ˣ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K
          (((a * b : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).1 w
        = (NumberField.mixedEmbedding K ((a : NumberField.RingOfIntegers K) : K)).1 w *
          (NumberField.mixedEmbedding K ((b : NumberField.RingOfIntegers K) : K)).1 w := by
    intro a b w
    have h1 : (((a * b : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
        = ((a : NumberField.RingOfIntegers K) : K)
          * ((b : NumberField.RingOfIntegers K) : K) := by
      rw [Units.val_mul]; simp
    rw [h1, map_mul]
    simp
  obtain ⟨sgn, hsgn⟩ :
      ∃ s : (NumberField.RingOfIntegers K)ˣ →*
          ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ),
        ∀ (u : (NumberField.RingOfIntegers K)ˣ)
          (w : {w : NumberField.InfinitePlace K // w.IsReal}),
          s u w = 1 ↔ 0 < (NumberField.mixedEmbedding K
            ((u : NumberField.RingOfIntegers K) : K)).1 w := by
    refine ⟨MonoidHom.mk' (fun (u : (NumberField.RingOfIntegers K)ˣ)
        (w : {w : NumberField.InfinitePlace K // w.IsReal}) =>
      if 0 < (NumberField.mixedEmbedding K ((u : NumberField.RingOfIntegers K) : K)).1 w
      then (1 : ℤˣ) else -1) ?_, ?_⟩
    · intro a b
      funext w
      simp only [Pi.mul_apply, hmulc a b w]
      rcases lt_or_gt_of_ne (hne a w) with hx | hx <;>
        rcases lt_or_gt_of_ne (hne b w) with hy | hy
      · rw [if_pos (mul_pos_of_neg_of_neg hx hy), if_neg (not_lt.mpr hx.le),
          if_neg (not_lt.mpr hy.le)]
        decide
      · rw [if_neg (not_lt.mpr (mul_neg_of_neg_of_pos hx hy).le), if_neg (not_lt.mpr hx.le),
          if_pos hy]
        decide
      · rw [if_neg (not_lt.mpr (mul_neg_of_pos_of_neg hx hy).le), if_pos hx,
          if_neg (not_lt.mpr hy.le)]
        decide
      · rw [if_pos (mul_pos hx hy), if_pos hx, if_pos hy]
        decide
    · intro u w
      show (if 0 < (NumberField.mixedEmbedding K
          ((u : NumberField.RingOfIntegers K) : K)).1 w then (1 : ℤˣ) else -1) = 1 ↔
        0 < (NumberField.mixedEmbedding K ((u : NumberField.RingOfIntegers K) : K)).1 w
      by_cases h : 0 < (NumberField.mixedEmbedding K
          ((u : NumberField.RingOfIntegers K) : K)).1 w
      · rw [if_pos h]
        exact ⟨fun _ => h, fun _ => rfl⟩
      · rw [if_neg h]
        constructor
        · intro hcon
          exact absurd hcon (by decide)
        · intro hcon
          exact absurd hcon h
  have hchoice : ∀ n : {n : ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ) //
      ∃ g : (NumberField.RingOfIntegers K)ˣ,
        ((g : NumberField.RingOfIntegers K) - 1 ∈ q) ∧ sgn g = n},
      ∃ g : (NumberField.RingOfIntegers K)ˣ,
        ((g : NumberField.RingOfIntegers K) - 1 ∈ q) ∧
          sgn g = (n : ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ)) := fun n => n.2
  choose r hrE hrs using hchoice
  haveI : Nonempty {n : ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ) //
      ∃ g : (NumberField.RingOfIntegers K)ˣ,
        ((g : NumberField.RingOfIntegers K) - 1 ∈ q) ∧ sgn g = n} :=
    ⟨⟨1, ⟨1, hEone, map_one sgn⟩⟩⟩
  haveI : Finite ↥(Set.range r) := (Set.finite_range r).to_subtype
  haveI : Nonempty ↥(Set.range r) := (Set.range_nonempty r).to_subtype
  refine ⟨Nat.card ↥(Set.range r), Set.range r, Nat.card_pos, rfl, ?_, ?_⟩
  · rintro t ⟨n, rfl⟩
    exact hrE n
  · intro v hv
    obtain ⟨t, htT, htE, hts, htuniq⟩ : ∃ t : (NumberField.RingOfIntegers K)ˣ,
        t ∈ Set.range r ∧ ((t : NumberField.RingOfIntegers K) - 1 ∈ q) ∧ sgn t = sgn v ∧
        (∀ t' ∈ Set.range r, sgn t' = sgn v → t' = t) := by
      refine ⟨r ⟨sgn v, v, hv, rfl⟩, ⟨_, rfl⟩, hrE _, hrs _, ?_⟩
      rintro t' ⟨m, rfl⟩ hm
      have hmv : (m : ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ)) = sgn v := by
        rw [← hrs m]; exact hm
      exact congrArg r (Subtype.ext hmv)
    have huE : ((t⁻¹ * v : (NumberField.RingOfIntegers K)ˣ) :
        NumberField.RingOfIntegers K) - 1 ∈ q := hEmul _ _ (hEinv t htE) hv
    have hus : sgn (t⁻¹ * v) = 1 := by
      rw [map_mul, map_inv, hts, inv_mul_cancel]
    have hu : KaiMFCongUnit K q (t⁻¹ * v) := by
      refine ⟨huE, ?_⟩
      intro w
      have hw := congrFun hus w
      rw [Pi.one_apply] at hw
      exact (hsgn (t⁻¹ * v) w).mp hw
    refine ⟨(⟨t, htT⟩, ⟨t⁻¹ * v, hu⟩), (mul_inv_cancel_left t v).symm, ?_⟩
    rintro ⟨⟨t', ht'⟩, ⟨u', hu'⟩⟩ heq
    have heq' : v = t' * u' := heq
    have hu'1 : sgn u' = 1 := by
      funext w
      rw [Pi.one_apply]
      exact (hsgn u' w).mpr (hu'.2 w)
    have ht's : sgn t' = sgn v := by
      rw [heq', map_mul, hu'1, mul_one]
    have ht'eq : t' = t := htuniq t' ht' ht's
    have hu'eq : u' = t⁻¹ * v := by
      rw [heq', ht'eq, inv_mul_cancel_left]
    have h1 : (⟨t', ht'⟩ : {x // x ∈ Set.range r}) = ⟨t, htT⟩ := Subtype.ext ht'eq
    have h2 : (⟨u', hu'⟩ : {x : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q x})
        = ⟨t⁻¹ * v, hu⟩ := Subtype.ext hu'eq
    rw [h1, h2]

theorem kai_mf_cell_gen (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hidx : ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∃ (hh : ℕ) (T : Set (NumberField.RingOfIntegers K)ˣ),
        0 < hh ∧ Nat.card T = hh ∧
        (∀ t ∈ T, ((t : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) - 1 ∈ q) ∧
        (∀ v : (NumberField.RingOfIntegers K)ˣ,
            ((v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1 ∈ q →
          ∃! p : {t // t ∈ T} ×
                 {u : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q u},
            v = (p.1 : (NumberField.RingOfIntegers K)ˣ) *
                  (p.2 : (NumberField.RingOfIntegers K)ˣ))) :
