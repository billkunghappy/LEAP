        nil2Eval p₀' (fun j i => ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i)
          r₀' r₁' r₂' F z‖ := by
    refine le_trans ?_ hu
    rw [le_div_iff₀ (by linarith)]
    have hsn : (0 : ℝ) < (s : ℝ) ^ Module.finrank ℚ K := pow_pos hspos _
    have key : η ^ 2 / C₅ * (2 * (Ry.card : ℝ)) ≤ Λ := by
      calc η ^ 2 / C₅ * (2 * (Ry.card : ℝ))
          ≤ η ^ 2 / C₅ * (2 * ((5 * C ^ 2 * C_e) ^ Module.finrank ℚ K *
              M ^ Module.finrank ℚ K / νe ^ Module.finrank ℚ K)) :=
            mul_le_mul_of_nonneg_left (by linarith) hδpos.le
        _ = η ^ 2 * M ^ Module.finrank ℚ K /
              (2 ^ (Module.finrank ℚ K + 1) * C_e * νe ^ Module.finrank ℚ K) := by
            rw [hC₅]; field_simp; ring
        _ ≤ η ^ 2 * cB / (2 ^ (Module.finrank ℚ K + 1) * C_e * Nd) :=
            hcmp _ (mul_pos (by positivity) hCepos)
        _ = Λ := hΛ.symm
    calc η ^ 2 / C₅ * (s : ℝ) ^ Module.finrank ℚ K * (2 * (Ry.card : ℝ))
        = (η ^ 2 / C₅ * (2 * (Ry.card : ℝ))) * (s : ℝ) ^ Module.finrank ℚ K := by ring
      _ ≤ Λ * (s : ℝ) ^ Module.finrank ℚ K := mul_le_mul_of_nonneg_right key hsn.le
  
  obtain ⟨r, k, hkX, hkiso, hksm⟩ := hE D Q (η ^ 2 / C₅) s hD hQ hδpos hδ1 hs1 a b Bc ξ F hdata
    p₀' (fun j i => ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) r₀' r₁' r₂'
    (fun j => (s : ℤ) * u j) hcube
  rw [← hXE] at hkX hksm
  
  have hH := kai_v_si_smooth_transfer K ω e a r k p₁ XE s hXEpos.le hspos hksm
  have hfinal : ∀ y : NumberField.RingOfIntegers K,
      (Module.finrank ℚ K : ℝ) * basisSupNorm ω y * (XE / s) ≤
        X₇ * basisSupNorm ω y * R / M := by
    intro y
    have hy0 : 0 ≤ basisSupNorm ω y := Real.iSup_nonneg (fun j => abs_nonneg _)
    have hmain : (Module.finrank ℚ K : ℝ) * XE * M ≤ X₇ * R * s := by
      have h1 : 2 * (Module.finrank ℚ K : ℝ) * G * XE ≤ η ^ 3 * X₇ := by
        rw [hG]; linarith [hc3]
      have h2 : η ^ 3 * M ≤ 2 * G * (η * νe * s) := by
        have h3 : η ^ 3 * M = 2 * G * (η * νe * (s₀ / 2)) := by rw [hs₀]; field_simp
        rw [h3]
        apply mul_le_mul_of_nonneg_left _ (by linarith)
        apply mul_le_mul_of_nonneg_left _ (mul_nonneg hη0.le hνepos.le)
        linarith
      have h4 : (Module.finrank ℚ K : ℝ) * XE * M * (2 * G) ≤ X₇ * R * s * (2 * G) := by
        calc (Module.finrank ℚ K : ℝ) * XE * M * (2 * G)
            = (2 * (Module.finrank ℚ K : ℝ) * G * XE) * M := by ring
          _ ≤ (η ^ 3 * X₇) * M := mul_le_mul_of_nonneg_right h1 hMpos.le
          _ = X₇ * (η ^ 3 * M) := by ring
          _ ≤ X₇ * (2 * G * (η * νe * s)) := mul_le_mul_of_nonneg_left h2 hX₇pos.le
          _ = X₇ * (η * νe) * s * (2 * G) := by ring
