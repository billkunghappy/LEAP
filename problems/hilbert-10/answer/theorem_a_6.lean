            ∀ g : ClassGroup (NumberField.RingOfIntegers K), ψ j g = 1) ∧
        (∀ g : ClassGroup (NumberField.RingOfIntegers K), g ≠ 1 → ∑ j, ψ j g = 0) := by
    have h1 : Fintype.card (Additive (ClassGroup (NumberField.RingOfIntegers K)))
        = NumberField.classNumber K := by
      exact (Fintype.card_congr
        (Additive.ofMul (α := ClassGroup (NumberField.RingOfIntegers K)))).symm
    have hcard : Fintype.card
        (AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ)
          = NumberField.classNumber K := by
      rw [AddChar.card_eq]; exact h1
    let e : Fin (NumberField.classNumber K) ≃
        AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ :=
      (Fintype.equivFinOfCardEq hcard).symm
    let ψ : Fin (NumberField.classNumber K) →
        (ClassGroup (NumberField.RingOfIntegers K) →* ℂ) := fun j =>
      { toFun := fun g => (e j) (Additive.ofMul g)
        map_one' := by
          show (e j) (Additive.ofMul (1 : ClassGroup (NumberField.RingOfIntegers K))) = 1
          rw [ofMul_one]
          exact AddChar.map_zero_eq_one (e j)
        map_mul' := by
          intro x y
          show (e j) (Additive.ofMul (x * y))
              = (e j) (Additive.ofMul x) * (e j) (Additive.ofMul y)
          rw [ofMul_mul]
          exact AddChar.map_add_eq_mul (e j) _ _ }
    have hval : ∀ (j : Fin (NumberField.classNumber K))
        (g : ClassGroup (NumberField.RingOfIntegers K)),
        ψ j g = (e j) (Additive.ofMul g) := fun _ _ => rfl
    refine ⟨ψ, ?_, ?_, ?_, ?_⟩
    · intro j g
      rw [hval j g]
      exact AddChar.norm_apply (e j) (Additive.ofMul g)
    · intro j k h
      apply e.injective
      apply AddChar.ext
      intro a
      have hjk := DFunLike.congr_fun h (Additive.toMul a)
      rw [hval j (Additive.toMul a), hval k (Additive.toMul a), ofMul_toMul] at hjk
      exact hjk
    · refine ⟨e.symm 1, fun g => ?_⟩
      rw [hval (e.symm 1) g, Equiv.apply_symm_apply]
      exact AddChar.one_apply (Additive.ofMul g)
    · intro g hg
      have ha : Additive.ofMul g ≠ (0 : Additive (ClassGroup (NumberField.RingOfIntegers K))) := by
        intro h0
        apply hg
        have h2 : Additive.ofMul g
            = Additive.ofMul (1 : ClassGroup (NumberField.RingOfIntegers K)) := by
          rw [ofMul_one]; exact h0
        exact (Additive.ofMul (α := ClassGroup (NumberField.RingOfIntegers K))).injective h2
      calc ∑ j, ψ j g = ∑ j : Fin (NumberField.classNumber K), (e j) (Additive.ofMul g) :=
            Finset.sum_congr rfl (fun j _ => hval j g)
        _ = ∑ χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ,
              χ (Additive.ofMul g) :=
            Equiv.sum_comp e
              (fun χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ =>
                χ (Additive.ofMul g))
        _ = 0 := by
            rw [AddChar.sum_apply_eq_ite]
            exact if_neg ha
  obtain ⟨Λ, hΛ1, hΛ0⟩ :
      ∃ Λ : Fin (NumberField.classNumber K) →
          (Ideal (NumberField.RingOfIntegers K) → ℂ),
        (∀ (j : Fin (NumberField.classNumber K))
            (I : Ideal (NumberField.RingOfIntegers K))
            (hI : I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))),
            I ⊔ q = ⊤ →
            Λ j I = (Ψ (FractionalIdeal.mk0 K ⟨I, hI⟩) : ℂ)
              * ψ j (ClassGroup.mk0 ⟨I, hI⟩)) ∧
        (∀ (j : Fin (NumberField.classNumber K))
            (I : Ideal (NumberField.RingOfIntegers K)),
            ¬ (I ≠ 0 ∧ I ⊔ q = ⊤) → Λ j I = 0) := by
    refine ⟨fun j I => if h : I ≠ 0 ∧ I ⊔ q = ⊤ then
        (Ψ (FractionalIdeal.mk0 K ⟨I, mem_nonZeroDivisors_iff_ne_zero.mpr h.1⟩) : ℂ) *
          ψ j (ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_iff_ne_zero.mpr h.1⟩) else 0, ?_, ?_⟩
    · intro j I hI hc
      simp only [dif_pos (show I ≠ 0 ∧ I ⊔ q = ⊤ from
        ⟨mem_nonZeroDivisors_iff_ne_zero.mp hI, hc⟩)]
    · intro j I hI
      simp only [dif_neg hI]
  have hK2 : ∀ (j : Fin (NumberField.classNumber K)) (α : NumberField.RingOfIntegers K),
      α ≠ 0 → IsUnit (Ideal.Quotient.mk q α) →
      Λ j (Ideal.span {α}) = kaiHeckeTwist K q t l ξ η α := by
    intro j α hα hu
    have hne : Ideal.span {α} ≠ 0 := hspan_ne α hα
    have hm : Ideal.span {α} ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      mem_nonZeroDivisors_iff_ne_zero.mpr hne
    have hcop : Ideal.span {α} ⊔ q = ⊤ := (hs5 α).mp hu
    have hcl : ClassGroup.mk0 (⟨Ideal.span {α}, hm⟩ :
        ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) = 1 :=
      (ClassGroup.mk0_eq_one_iff hm).mpr ⟨⟨α, rfl⟩⟩
    rw [hΛ1 j _ hm hcop, hΨspan α hα hu hm, hcl, map_one, mul_one]
  refine ⟨Λ, ?_, ?_, ?_, ?_, ?_⟩
  · intro j
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · have h1m : (1 : Ideal (NumberField.RingOfIntegers K))
          ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) := one_mem _
      have h1c : (1 : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
        rw [Ideal.one_eq_top, top_sup_eq]
      have h1e : (⟨(1 : Ideal (NumberField.RingOfIntegers K)), h1m⟩ :
          ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) = 1 := rfl
      rw [hΛ1 j 1 h1m h1c, h1e]
      simp
    · intro I J
      by_cases hI0 : I = 0
      · subst hI0
        rw [zero_mul, hΛ0 j 0 (by simp), zero_mul]
      by_cases hJ0 : J = 0
      · subst hJ0
        rw [mul_zero, hΛ0 j 0 (by simp), mul_zero]
      by_cases hIc : I ⊔ q = ⊤
      · by_cases hJc : J ⊔ q = ⊤
        · have hIJ0 : I * J ≠ 0 := mul_ne_zero hI0 hJ0
          have hIJc : I * J ⊔ q = ⊤ := (hs6 I J).mpr ⟨hIc, hJc⟩
          have hIm : I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
            mem_nonZeroDivisors_iff_ne_zero.mpr hI0
          have hJm : J ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
            mem_nonZeroDivisors_iff_ne_zero.mpr hJ0
          have hIJm : I * J ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
            mem_nonZeroDivisors_iff_ne_zero.mpr hIJ0
          have hsub : (⟨I * J, hIJm⟩ :
              ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))))
              = ⟨I, hIm⟩ * ⟨J, hJm⟩ := rfl
          rw [hΛ1 j (I * J) hIJm hIJc, hΛ1 j I hIm hIc, hΛ1 j J hJm hJc, hsub]
          simp only [map_mul, Circle.coe_mul]
          ring
        · have hIJc : ¬ (I * J ⊔ q = ⊤) := fun h => hJc ((hs6 I J).mp h).2
          rw [hΛ0 j (I * J) (fun h => hIJc h.2), hΛ0 j J (fun h => hJc h.2), mul_zero]
      · have hIJc : ¬ (I * J ⊔ q = ⊤) := fun h => hIc ((hs6 I J).mp h).1
        rw [hΛ0 j (I * J) (fun h => hIJc h.2), hΛ0 j I (fun h => hIc h.2), zero_mul]
    · intro I hI0 hIc
      rw [hΛ1 j I (mem_nonZeroDivisors_iff_ne_zero.mpr hI0) hIc, norm_mul,
        Circle.norm_coe, hψnorm, one_mul]
    · intro I hIc
      exact hΛ0 j I (fun h => hIc h.2)
    · exact hΛ0 j 0 (by simp)
    · intro α hα
      by_cases hu : IsUnit (Ideal.Quotient.mk q α)
      · exact hK2 j α hα hu
      · rw [hχzero α hu]
        exact hΛ0 j _ (fun h => hu ((hs5 α).mpr h.2))
  · intro I hI0 hIp
    obtain ⟨hIgen, hgen0⟩ := hs7 I hI0 hIp
    by_cases hIc : I ⊔ q = ⊤
    · have hu : IsUnit (Ideal.Quotient.mk q (kaiGen I)) := by
        refine (hs5 _).mpr ?_
        rw [← hIgen]
        exact hIc
      have hstep : ∀ j : Fin (NumberField.classNumber K),
          Λ j I = kaiHeckeTwist K q t l ξ η (kaiGen I) := by
        intro j
        conv_lhs => rw [hIgen]
        exact hK2 j _ hgen0 hu
      rw [Finset.sum_congr rfl (fun j _ => hstep j), Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul]
    · have hu : ¬ IsUnit (Ideal.Quotient.mk q (kaiGen I)) := by
        intro h
        apply hIc
        rw [hIgen]
        exact (hs5 _).mp h
      have hstep : ∀ j : Fin (NumberField.classNumber K), Λ j I = 0 :=
        fun j => hΛ0 j I (fun h => hIc h.2)
      rw [Finset.sum_congr rfl (fun j _ => hstep j), Finset.sum_const, smul_zero,
        hχzero _ hu, mul_zero]
  · intro I hI0 hIp
    by_cases hIc : I ⊔ q = ⊤
    · have hIm : I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
        mem_nonZeroDivisors_iff_ne_zero.mpr hI0
      have hcl : ClassGroup.mk0 (⟨I, hIm⟩ :
          ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) ≠ 1 := by
        intro h
        exact hIp ((ClassGroup.mk0_eq_one_iff hIm).mp h)
      have hstep : ∀ j : Fin (NumberField.classNumber K),
          Λ j I = (Ψ (FractionalIdeal.mk0 K ⟨I, hIm⟩) : ℂ)
            * ψ j (ClassGroup.mk0 ⟨I, hIm⟩) := fun j => hΛ1 j I hIm hIc
      rw [Finset.sum_congr rfl (fun j _ => hstep j), ← Finset.mul_sum, hψorth _ hcl,
        mul_zero]
    · have hstep : ∀ j : Fin (NumberField.classNumber K), Λ j I = 0 :=
        fun j => hΛ0 j I (fun h => hIc h.2)
      rw [Finset.sum_congr rfl (fun j _ => hstep j), Finset.sum_const, smul_zero]
  · intro hAll
    have hA : ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
        IsUnit (Ideal.Quotient.mk q y) → kaiHeckeTwist K q t l ξ η y = 1 :=
      fun y _ hy => hAll y hy
    refine ⟨j₀, ?_, ?_⟩
    · intro I hI0 hIc
      rw [hΛ1 j₀ I (mem_nonZeroDivisors_iff_ne_zero.mpr hI0) hIc, hΨ1 hA, hψ0, one_mul]
    · intro k hk
      apply hψinj
      refine MonoidHom.ext (fun c => ?_)
      obtain ⟨Ic, hIccop, hIccl⟩ := hcoprime c
      have hI0 : (Ic : Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
        mem_nonZeroDivisors_iff_ne_zero.mp Ic.2
      have hval := hk (Ic : Ideal (NumberField.RingOfIntegers K)) hI0 hIccop
      have hcl : ClassGroup.mk0 (⟨(Ic : Ideal (NumberField.RingOfIntegers K)), Ic.2⟩ :
          ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) = c := hIccl
      rw [hΛ1 k _ Ic.2 hIccop, hΨ1 hA, one_mul, hcl] at hval
      rw [hval, hψ0 c]
  · intro hnAll j hprin
    have hnA : ¬ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
        IsUnit (Ideal.Quotient.mk q y) → kaiHeckeTwist K q t l ξ η y = 1 :=
      fun hA => hnAll (hunitzero hA)
    push_neg at hnA
    obtain ⟨y, hy0, hyu, hy1⟩ := hnA
    have hne : Ideal.span {y} ≠ 0 := hspan_ne y hy0
    have hc : Ideal.span {y} ⊔ q = ⊤ := (hs5 y).mp hyu
    have hval := hprin _ hne hc
    rw [hK2 j y hy0 hyu] at hval
    exact hy1 hval

theorem kai_hecke_gen_char_basics (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hser : KaiZFSeriesBasicsProp K) :
    KaiZFGenCharProp K :=
by
  classical
  unfold KaiZFSeriesBasicsProp at hser
  obtain ⟨DK, -, hz, -, -⟩ := hser
  have hzeta : ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)) :=
    fun σ hσ => (hz σ hσ).1
  have hzpow : ∀ σ : ℝ, 1 < σ →
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))
        ≤ (1 + 1 / (σ - 1)) ^ (Module.finrank ℚ K) := fun σ hσ => (hz σ hσ).2
  have hmu := kai_zf_ideal_moebius K
  have hconv := kai_zf_ideal_dirichlet_conv K
  have hlogdiv := kai_zf_log_norm_divisor_sum K
  
  have hfib : KaiZFFiberProp K := by
    intro I hI gg
    obtain ⟨Phi, hPhi⟩ :
        ∃ Phi : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                      {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
              (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
                (pr.2 : Ideal (NumberField.RingOfIntegers K)) = I} →
            {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I},
          Phi = fun pr => ⟨(pr.1.2 : Ideal (NumberField.RingOfIntegers K)),
            ⟨(pr.1.1 : Ideal (NumberField.RingOfIntegers K)),
              pr.2.symm.trans (mul_comm _ _)⟩⟩ := ⟨_, rfl⟩
    have hval : ∀ pr, ((Phi pr : Ideal (NumberField.RingOfIntegers K)))
        = (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) := by
      intro pr; rw [hPhi]
    have hinj' : Function.Injective Phi := by
      intro p q hpq
      have h2 : (p.1.2 : Ideal (NumberField.RingOfIntegers K))
          = (q.1.2 : Ideal (NumberField.RingOfIntegers K)) := by
        rw [← hval p, ← hval q, hpq]
      have hne : (p.1.2 : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := p.1.2.2
      have hpq2 : (p.1.1 : Ideal (NumberField.RingOfIntegers K)) *
            (p.1.2 : Ideal (NumberField.RingOfIntegers K))
          = (q.1.1 : Ideal (NumberField.RingOfIntegers K)) *
            (p.1.2 : Ideal (NumberField.RingOfIntegers K)) := by
        rw [p.2, h2, q.2]
      exact Subtype.ext
        (Prod.ext (Subtype.ext (mul_right_cancel₀ hne hpq2)) (Subtype.ext h2))
    have hsurj : Function.Surjective Phi := by
      rintro ⟨J, c, hc⟩
      have hJ0 : J ≠ 0 := by
        rintro rfl; rw [zero_mul] at hc; exact hI hc
      have hc0 : c ≠ 0 := by
        rintro rfl; rw [mul_zero] at hc; exact hI hc
      refine ⟨⟨(⟨c, hc0⟩, ⟨J, hJ0⟩), by rw [hc]; ring⟩, ?_⟩
      apply Subtype.ext
      rw [hval]
    have key := Equiv.tsum_eq (Equiv.ofBijective Phi ⟨hinj', hsurj⟩)
      (fun J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I} =>
        gg (J : Ideal (NumberField.RingOfIntegers K)))
    refine Eq.trans ?_ key
    exact tsum_congr (fun pr => congrArg gg (hval pr).symm)
  
  have hNnat : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      0 < Ideal.absNorm I := by
    intro I hI
    have hb : I ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hne : Ideal.absNorm I ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]
      exact hb
    omega
  have hNpos : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      (1 : ℝ) ≤ (Ideal.absNorm I : ℝ) := by
    intro I hI
    have h : (1 : ℕ) ≤ Ideal.absNorm I := hNnat I hI
    exact_mod_cast h
  have hvM0 : ∀ I : Ideal (NumberField.RingOfIntegers K),
      0 ≤ kaiZFVonMangoldt K I := by
    intro I
    simp only [kaiZFVonMangoldt]
    split_ifs with h
    · obtain ⟨k, hp, hb, hk, hIe⟩ := h.choose_spec
      have hP0 : h.choose ≠ 0 := fun hc => hb (hc.trans Submodule.zero_eq_bot)
      exact Real.log_nonneg (hNpos _ hP0)
    · exact le_rfl
  have hvMle : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      kaiZFVonMangoldt K I ≤ Real.log (Ideal.absNorm I) := by
    intro I hI
    simp only [kaiZFVonMangoldt]
    split_ifs with h
    · obtain ⟨k, hp, hb, hk, hIe⟩ := h.choose_spec
      have hP0 : h.choose ≠ 0 := fun hc => hb (hc.trans Submodule.zero_eq_bot)
      have hPn : 0 < Ideal.absNorm h.choose := hNnat _ hP0
      have hNe : Ideal.absNorm I = (Ideal.absNorm h.choose) ^ k := by
        have h2 : Ideal.absNorm I = Ideal.absNorm (h.choose ^ k) :=
          congrArg (fun J : Ideal (NumberField.RingOfIntegers K) => Ideal.absNorm J) hIe
        rw [h2]
        exact map_pow _ _ _
      have hle : (Ideal.absNorm h.choose : ℝ) ≤ (((Ideal.absNorm h.choose) ^ k : ℕ) : ℝ) := by
        exact_mod_cast Nat.le_self_pow (by omega) (Ideal.absNorm h.choose)
      rw [hNe]
      exact Real.log_le_log (by exact_mod_cast hPn) hle
    · exact Real.log_nonneg (hNpos I hI)
  have hlogrpow : ∀ y τ : ℝ, 1 ≤ y → 0 < τ → Real.log y ≤ y ^ τ / τ := by
    intro y τ hy hτ
    have hy0 : (0 : ℝ) < y := by linarith only [hy]
    have hstep : Real.log (y ^ τ) ≤ y ^ τ - 1 :=
      Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hy0 τ)
    rw [Real.log_rpow hy0] at hstep
    rw [le_div_iff₀ hτ]
    linarith only [hstep]
  
  have hnormdiv : ∀ (s c : ℂ) (I : Ideal (NumberField.RingOfIntegers K)), I ≠ 0 →
      ‖c / ((Ideal.absNorm I : ℂ) ^ s)‖
        = ‖c‖ * ((Ideal.absNorm I : ℝ)) ^ (-s.re) := by
    intro s c I hI
    rw [norm_div, Complex.norm_natCast_cpow_of_pos (hNnat I hI) s,
      Real.rpow_neg (Nat.cast_nonneg _), div_eq_mul_inv]
  have htermbd : ∀ (s : ℂ) (c : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖c I‖ ≤ 1) →
      ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ‖c (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)‖
          ≤ ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-s.re) := by
    intro s c hc I
    rw [hnormdiv s _ _ I.2]
    exact mul_le_of_le_one_left (Real.rpow_nonneg (Nat.cast_nonneg _) _) (hc _)
  have hsumnorm : ∀ s : ℂ, 1 < s.re → ∀ (c : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖c I‖ ≤ 1) →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ‖c (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)‖) := by
    intro s hs c hc
    exact Summable.of_nonneg_of_le (fun I => norm_nonneg _) (htermbd s c hc) (hzeta s.re hs)
  have hdivneg : ∀ (s c : ℂ) (I : Ideal (NumberField.RingOfIntegers K)),
      c / ((Ideal.absNorm I : ℂ) ^ s) = c * ((Ideal.absNorm I : ℂ) ^ (-s)) := by
    intro s c I
    rw [Complex.cpow_neg, div_eq_mul_inv]
  
  have hderivS : ∀ (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1) →
      ∀ s : ℂ, 1 < s.re →
      DifferentiableAt ℂ (kaiHeckeSeries K lam) s ∧
        deriv (kaiHeckeSeries K lam) s
          = - ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              lam (I : Ideal (NumberField.RingOfIntegers K)) *
                ((Real.log (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ) *
                ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) := by
    intro lam hbd s hs
    have key : ∀ m : ℕ, 0 < m → ∀ a z : ℂ,
        HasDerivAt (fun w : ℂ => a / ((m : ℂ) ^ w))
          (-(a * ((Real.log m : ℝ) : ℂ) * ((m : ℂ) ^ (-z)))) z := by
      intro m hm a z
      have hc : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have h1 : HasDerivAt (fun w : ℂ => -w) (-1) z := hasDerivAt_neg z
      have h2 := h1.const_cpow (Or.inl hc)
      have h3 := h2.const_mul a
      have hfun : (fun w : ℂ => a / ((m : ℂ) ^ w)) = (fun w : ℂ => a * ((m : ℂ) ^ (-w))) := by
        funext w
        rw [Complex.cpow_neg, div_eq_mul_inv]
      have hval : a * ((m : ℂ) ^ (-z) * Complex.log (m : ℂ) * (-1))
          = -(a * ((Real.log m : ℝ) : ℂ) * ((m : ℂ) ^ (-z))) := by
