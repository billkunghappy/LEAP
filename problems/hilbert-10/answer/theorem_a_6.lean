          have h2 : (if (0 : NumberField.RingOfIntegers K) ∈ B then n * (n + 3) * L else 0)
              ≤ n * (n + 3) * L := by
            split_ifs
            · exact le_refl _
            · exact hWnn
          have h3 := mul_le_mul_of_nonneg_left h2 (show 0 ≤ κ by linarith)
          linarith
  
  have hT : ∑ x ∈ B, ((f x * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) : ℝ) : ℂ)
        * giE (P (ω.equivFun x))
      = ((n * L : ℝ) : ℂ) * ∑ x ∈ B, ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))
        - ∑ w : NumberField.InfinitePlace K, ∑ k ∈ Finset.Icc 1 K₀,
            (((w.mult : ℝ) * δ : ℝ) : ℂ) *
              ∑ x ∈ B, ((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x))
        - ∑ x ∈ B, ((f x * ρ x : ℝ) : ℂ) * giE (P (ω.equivFun x)) := by
    have hmid : ∑ w : NumberField.InfinitePlace K, ∑ k ∈ Finset.Icc 1 K₀,
            (((w.mult : ℝ) * δ : ℝ) : ℂ) *
              ∑ x ∈ B, ((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x))
        = ∑ x ∈ B, ((a x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x)) := by
      simp only [Finset.mul_sum]
      calc _ = ∑ w : NumberField.InfinitePlace K, ∑ x ∈ B, ∑ k ∈ Finset.Icc 1 K₀,
              (((w.mult : ℝ) * δ : ℝ) : ℂ) *
                (((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x))) :=
            Finset.sum_congr rfl (fun w _ => Finset.sum_comm)
        _ = ∑ x ∈ B, ∑ w : NumberField.InfinitePlace K, ∑ k ∈ Finset.Icc 1 K₀,
              (((w.mult : ℝ) * δ : ℝ) : ℂ) *
                (((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x))) := Finset.sum_comm
        _ = _ := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            rw [ha x]
            push_cast
            simp only [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun w _ => Finset.sum_congr rfl (fun k _ => ?_))
            ring
    rw [hmid, Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [hρ x]
    push_cast
    ring
  have hTbd : ‖∑ x ∈ B, ((f x * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) : ℝ) : ℂ)
        * giE (P (ω.equivFun x))‖
      ≤ n * L * ‖∑ x ∈ B, ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖
        + ∑ w : NumberField.InfinitePlace K, ∑ k ∈ Finset.Icc 1 K₀,
            (w.mult : ℝ) * δ * ‖∑ x ∈ B, ((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖
        + ∑ x ∈ B, |f x| * |ρ x| := by
    rw [hT]
    refine (norm_sub_le _ _).trans (add_le_add ((norm_sub_le _ _).trans (add_le_add ?_ ?_)) ?_)
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg hn0 (by linarith))]
    · refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun w _ =>
        (norm_sum_le _ _).trans (Finset.sum_le_sum (fun k _ => ?_))))
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg (Nat.cast_nonneg _) hδpos.le)]
    · refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun x _ => ?_))
      rw [norm_mul, he, mul_one, Complex.norm_real, Real.norm_eq_abs, abs_mul]
  
  by_contra hcon
  push_neg at hcon
  obtain ⟨τ, hτ⟩ : ∃ τ, τ = θ * B.card / (CL * W₁) := ⟨_, rfl⟩
  have hτ0 : 0 ≤ τ := by rw [hτ]; exact div_nonneg hBpos.le hCLW.le
  have hSτ : ∀ Ω : Set (Fin (Module.finrank ℚ K) → ℝ), Convex ℝ Ω →
      ‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω)
          (fun _ => Classical.propDecidable _) B,
        ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖ ≤ τ := by
    intro Ω hΩ
    have h := hcon Ω hΩ
    rw [hτ, le_div_iff₀ hCLW]
    linarith
  have hfu : (@Finset.filter (NumberField.RingOfIntegers K)
      (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈
        (Set.univ : Set (Fin (Module.finrank ℚ K) → ℝ)))
      (fun _ => Classical.propDecidable _) B) = B := by
    ext x
    rw [@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _]
    exact ⟨fun h => h.1, fun h => ⟨h, Set.mem_univ _⟩⟩
  have hS0 : ‖∑ x ∈ B, ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖ ≤ τ := by
    have h := hSτ Set.univ convex_univ
    rwa [hfu] at h
  have hSfilt : ∀ w k, ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ωs w (s k))
          (fun _ => Classical.propDecidable _) B,
        ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))
      = ∑ x ∈ B, ((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x)) := by
    intro w k
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [hχ]
    by_cases h : w (x : K) ≤ s k
    · rw [if_pos ((hmemΩ w (s k) x).mpr h), if_pos h]; push_cast; ring
    · rw [if_neg (fun h' => h ((hmemΩ w (s k) x).mp h')), if_neg h]; push_cast; ring
  have hSwk : ∀ w k, ‖∑ x ∈ B, ((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖ ≤ τ := by
    intro w k
    rw [← hSfilt]
    exact hSτ _ (hconv w (s k))
  have hmidbd : ∑ w : NumberField.InfinitePlace K, ∑ k ∈ Finset.Icc 1 K₀,
      (w.mult : ℝ) * δ * ‖∑ x ∈ B, ((χ w k x * f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖
      ≤ n * ((K₀ : ℝ) * δ) * τ := by
    rw [← hcsum, Finset.sum_mul]
    refine Finset.sum_le_sum (fun w _ => ?_)
    rw [Finset.sum_mul]
    exact Finset.sum_le_sum (fun k _ => mul_le_mul_of_nonneg_left (hSwk w k)
      (mul_nonneg (Nat.cast_nonneg _) hδpos.le))
  have hWτ : n * (n + 3) * L * τ ≤ θ * B.card / 4 := by
    have hnn3 : 0 ≤ n * (n + 3) := mul_nonneg hn0 (by linarith)
    have h4W : 4 * (n * (n + 3) * L) ≤ CL * W₁ := by
      have h5 : L ≤ (1 + Real.log C) * W₁ :=
        hLc.trans (mul_le_mul_of_nonneg_left hW₁ℓ (by linarith))
      have h6 : n * (n + 3) * L ≤ n * (n + 3) * ((1 + Real.log C) * W₁) :=
        mul_le_mul_of_nonneg_left h5 hnn3
      rw [hCL]
      linarith
    rw [hτ, show n * (n + 3) * L * (θ * B.card / (CL * W₁))
        = (n * (n + 3) * L) * (θ * B.card) / (CL * W₁) by ring, div_le_iff₀ hCLW]
    have h7 := mul_le_mul_of_nonneg_left h4W hBpos.le
    linarith
  have hA : n * L * ‖∑ x ∈ B, ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖ ≤ n * L * τ :=
    mul_le_mul_of_nonneg_left hS0 (mul_nonneg hn0 (by linarith))
  have hWτ' := mul_le_mul_of_nonneg_right hW hτ0
  have hκW : κ * (n * (n + 3) * L) ≤ θ * B.card / 4 := by linarith
  linarith

theorem kai_weyl_differencing_bound (ν N : ℕ) (Ω : Set (Fin ν → ℝ))
    (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ) (hΩ : Convex ℝ Ω) :
    ∃ Ωh : (Fin ν → ℤ) → Set (Fin ν → ℝ), (∀ h, Convex ℝ (Ωh h)) ∧
      ‖∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω)
            (fun _ => Classical.propDecidable _) (intBox ν N),
          giE (kaiQuadPoly p₀ p₁ p₂ z)‖ ^ 2 ≤
        ∑ h ∈ intBox ν (2 * N),
          ‖∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ωh h)
                (fun _ => Classical.propDecidable _) (intBox ν N),
              giE (∑ l, (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) * ((z l : ℤ) : ℝ))‖ :=
by
  classical
  
  have hgadd : ∀ a b : ℝ, giE (a + b) = giE a * giE b := by
    intro a b
    unfold giE
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hgnorm : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t
    unfold giE
    rw [Complex.norm_exp]
    simp
  have hgconj : ∀ t : ℝ, (starRingEnd ℂ) (giE t) = giE (-t) := by
    intro t
    unfold giE
    rw [← Complex.exp_conj]
    congr 1
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
    push_cast
    ring
  
  have hpoly : ∀ z h : Fin ν → ℤ, kaiQuadPoly p₀ p₁ p₂ (z + h) - kaiQuadPoly p₀ p₁ p₂ z
      = kaiQuadPoly 0 p₁ p₂ h
        + ∑ l, (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) * ((z l : ℤ) : ℝ) := by
    intro z h
    have hc : ∑ l, ∑ l', p₂ l' l * ((h l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ)
        = ∑ l, ∑ l', p₂ l l' * ((h l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ) := Finset.sum_comm
    have hlin : ∑ l, (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) * ((z l : ℤ) : ℝ)
        = ∑ l, ∑ l', p₂ l l' * ((h l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ)
          + ∑ l, ∑ l', p₂ l' l * ((h l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [Finset.sum_mul, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun l' _ => ?_)
      ring
    rw [hlin, hc]
    unfold kaiQuadPoly
    simp only [Pi.add_apply, Int.cast_add]
    have e1 : ∑ l, p₁ l * (((z l : ℤ) : ℝ) + ((h l : ℤ) : ℝ))
        = ∑ l, p₁ l * ((z l : ℤ) : ℝ) + ∑ l, p₁ l * ((h l : ℤ) : ℝ) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun l _ => by ring)
    have e2 : ∑ l, ∑ l', p₂ l l' * (((z l : ℤ) : ℝ) + ((h l : ℤ) : ℝ))
          * (((z l' : ℤ) : ℝ) + ((h l' : ℤ) : ℝ))
        = ∑ l, ∑ l', p₂ l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)
          + ∑ l, ∑ l', p₂ l l' * ((h l : ℤ) : ℝ) * ((h l' : ℤ) : ℝ)
          + (∑ l, ∑ l', p₂ l l' * ((h l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ)
          + ∑ l, ∑ l', p₂ l l' * ((h l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)) := by
      simp only [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun l' _ => by ring))
    rw [e1, e2]
    ring
  
  have hbox : ∀ (M : ℕ) (z : Fin ν → ℤ), z ∈ intBox ν M ↔ ∀ j, -(M : ℤ) ≤ z j ∧ z j ≤ M := by
    intro M z
    unfold intBox
    rw [Finset.mem_Icc]
    constructor
    · rintro ⟨h1, h2⟩ j
      exact ⟨h1 j, h2 j⟩
    · intro h
      exact ⟨fun j => (h j).1, fun j => (h j).2⟩
  have hbox' : ∀ z h : Fin ν → ℤ, z + h ∈ intBox ν N ↔
      ∀ j, |((z j : ℤ) : ℝ) + ((h j : ℤ) : ℝ)| ≤ (N : ℝ) := by
    intro z h
    rw [hbox]
    refine forall_congr' (fun j => ?_)
    rw [abs_le, Pi.add_apply, ← Int.cast_add]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨by exact_mod_cast h1, by exact_mod_cast h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨by exact_mod_cast h1, by exact_mod_cast h2⟩
  
  obtain ⟨X, hX⟩ : ∃ X : Finset (Fin ν → ℤ),
      X = @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω)
            (fun _ => Classical.propDecidable _) (intBox ν N) := ⟨_, rfl⟩
  obtain ⟨Ωh, hΩh⟩ : ∃ Ωh : (Fin ν → ℤ) → Set (Fin ν → ℝ),
      Ωh = fun h => {x : Fin ν → ℝ | x ∈ Ω ∧ (fun j => x j + ((h j : ℤ) : ℝ)) ∈ Ω ∧
        ∀ j, |x j + ((h j : ℤ) : ℝ)| ≤ (N : ℝ)} := ⟨_, rfl⟩
  rw [← hX]
  refine ⟨Ωh, ?_, ?_⟩
  · 
    intro h
    rw [hΩh]
    intro x hx y hy a b ha hb hab
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    have e : ∀ j, (a • x + b • y) j + ((h j : ℤ) : ℝ)
        = a * (x j + ((h j : ℤ) : ℝ)) + b * (y j + ((h j : ℤ) : ℝ)) := by
      intro j
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      linear_combination (-((h j : ℤ) : ℝ)) * hab
    refine ⟨hΩ hx.1 hy.1 ha hb hab, ?_, ?_⟩
    · have hfun : (fun j => (a • x + b • y) j + ((h j : ℤ) : ℝ))
          = a • (fun j => x j + ((h j : ℤ) : ℝ)) + b • (fun j => y j + ((h j : ℤ) : ℝ)) := by
        funext j
        rw [e j]
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      rw [hfun]
      exact hΩ hx.2.1 hy.2.1 ha hb hab
    · intro j
      rw [e j]
      have h1 := hx.2.2 j
      have h2 := hy.2.2 j
      calc |a * (x j + ((h j : ℤ) : ℝ)) + b * (y j + ((h j : ℤ) : ℝ))|
          ≤ |a * (x j + ((h j : ℤ) : ℝ))| + |b * (y j + ((h j : ℤ) : ℝ))| := abs_add_le _ _
        _ = a * |x j + ((h j : ℤ) : ℝ)| + b * |y j + ((h j : ℤ) : ℝ)| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ ≤ a * (N : ℝ) + b * (N : ℝ) := by
            have := mul_le_mul_of_nonneg_left h1 ha
            have := mul_le_mul_of_nonneg_left h2 hb
            linarith
        _ = (N : ℝ) := by rw [← add_mul, hab, one_mul]
  · 
    have hXbox : X ⊆ intBox ν N := by rw [hX]; exact Finset.filter_subset _ _
    
    have hYeq : ∀ h : Fin ν → ℤ, X.filter (fun z => z + h ∈ X)
        = @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ωh h)
            (fun _ => Classical.propDecidable _) (intBox ν N) := by
      intro h
      ext z
      have e : (fun j => (((z + h) j : ℤ) : ℝ))
          = (fun j => ((z j : ℤ) : ℝ) + ((h j : ℤ) : ℝ)) := by
        funext j
        simp [Pi.add_apply]
      simp only [Finset.mem_filter, hX, hΩh, Set.mem_setOf_eq]
      rw [e, hbox' z h]
      tauto
    
    have hinner : ∀ h : Fin ν → ℤ,
        ∑ z ∈ X, (if z + h ∈ X then
            giE (kaiQuadPoly p₀ p₁ p₂ (z + h) - kaiQuadPoly p₀ p₁ p₂ z) else 0)
          = giE (kaiQuadPoly 0 p₁ p₂ h) *
            ∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ωh h)
                (fun _ => Classical.propDecidable _) (intBox ν N),
              giE (∑ l, (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) * ((z l : ℤ) : ℝ)) := by
      intro h
      rw [← Finset.sum_filter, hYeq h, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun z _ => ?_)
      rw [hpoly z h, hgadd]
    
    have hre : ∀ z ∈ X, ∀ F : (Fin ν → ℤ) → ℂ, ∑ w ∈ X, F w
        = ∑ h ∈ intBox ν (2 * N), (if z + h ∈ X then F (z + h) else 0) := by
      intro z hz F
      rw [← Finset.sum_filter]
      refine Finset.sum_nbij' (fun w => w - z) (fun h => z + h) ?_ ?_ ?_ ?_ ?_
      · intro w hw
        rw [Finset.mem_filter]
        refine ⟨?_, ?_⟩
        · have hw' := (hbox N w).1 (hXbox hw)
          have hz' := (hbox N z).1 (hXbox hz)
          rw [hbox]
          intro j
          have a := hw' j
          have b := hz' j
          simp only [Pi.sub_apply]
          push_cast
          constructor <;> omega
        · have : z + (w - z) = w := by abel
          rw [this]
          exact hw
      · intro h hh
        exact (Finset.mem_filter.1 hh).2
      · intro w _
        show z + (w - z) = w
        abel
      · intro h _
        show z + h - z = h
        abel
      · intro w _
        show F w = F (z + (w - z))
        congr 1
        abel
    have hA : ‖∑ z ∈ X, giE (kaiQuadPoly p₀ p₁ p₂ z)‖ ^ 2
        = ‖∑ z ∈ X, ∑ w ∈ X, giE (kaiQuadPoly p₀ p₁ p₂ w - kaiQuadPoly p₀ p₁ p₂ z)‖ := by
      have h1 : ‖∑ z ∈ X, giE (kaiQuadPoly p₀ p₁ p₂ z)‖ ^ 2
          = ‖(∑ z ∈ X, giE (kaiQuadPoly p₀ p₁ p₂ z))
              * (starRingEnd ℂ) (∑ z ∈ X, giE (kaiQuadPoly p₀ p₁ p₂ z))‖ := by
        rw [norm_mul, Complex.norm_conj, sq]
      rw [h1, map_sum, Finset.sum_mul]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      congr 1
      refine Finset.sum_congr rfl (fun z _ => Finset.sum_congr rfl (fun w _ => ?_))
      rw [hgconj, ← hgadd, sub_eq_add_neg]
    have hB : ∑ z ∈ X, ∑ w ∈ X, giE (kaiQuadPoly p₀ p₁ p₂ w - kaiQuadPoly p₀ p₁ p₂ z)
        = ∑ h ∈ intBox ν (2 * N), giE (kaiQuadPoly 0 p₁ p₂ h) *
            ∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ωh h)
                (fun _ => Classical.propDecidable _) (intBox ν N),
              giE (∑ l, (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) * ((z l : ℤ) : ℝ)) := by
      calc ∑ z ∈ X, ∑ w ∈ X, giE (kaiQuadPoly p₀ p₁ p₂ w - kaiQuadPoly p₀ p₁ p₂ z)
          = ∑ z ∈ X, ∑ h ∈ intBox ν (2 * N), (if z + h ∈ X then
              giE (kaiQuadPoly p₀ p₁ p₂ (z + h) - kaiQuadPoly p₀ p₁ p₂ z) else 0) :=
            Finset.sum_congr rfl (fun z hz =>
              hre z hz (fun w => giE (kaiQuadPoly p₀ p₁ p₂ w - kaiQuadPoly p₀ p₁ p₂ z)))
        _ = ∑ h ∈ intBox ν (2 * N), ∑ z ∈ X, (if z + h ∈ X then
              giE (kaiQuadPoly p₀ p₁ p₂ (z + h) - kaiQuadPoly p₀ p₁ p₂ z) else 0) :=
            Finset.sum_comm
        _ = _ := Finset.sum_congr rfl (fun h _ => hinner h)
    rw [hA, hB]
    refine (norm_sum_le _ _).trans (le_of_eq ?_)
    refine Finset.sum_congr rfl (fun h _ => ?_)
    rw [norm_mul, hgnorm, one_mul]

theorem kai_linear_sum_convex_bound (ν N : ℕ) (Ω : Set (Fin ν → ℝ)) (hΩ : Convex ℝ Ω)
    (lam : Fin ν → ℝ) (l : Fin ν) :
    ‖∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω)
          (fun _ => Classical.propDecidable _) (intBox ν N),
