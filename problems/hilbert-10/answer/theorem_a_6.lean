    exact (div_le_self (abs_nonneg _) hh1).trans hs4
  
  have hmn_split : ∀ ξ η, A₀ * c ξ η * mn ξ η
      = A₀ * ((x / (NumberField.classNumber K : ℝ) : ℝ) : ℂ) * (c ξ η * ((aP ξ η : ℝ) : ℂ))
        - A₀ * (((x ^ β / β) / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)
          * (c ξ η * ((aE ξ η : ℝ) : ℂ)) := by
    intro ξ η
    rw [hmn]
    push_cast
    ring
  have hmainsum : ∑ ξ ∈ Ξ, ∑ η, A₀ * c ξ η * mn ξ η = A₀ * Y := by
    simp only [hmn_split, Finset.sum_sub_distrib, ← Finset.mul_sum, hZ2, hZ3.1]
    rw [hY]
    push_cast
    ring
  have hM : (((∏ j, g j) * (∏ p, th p) * (x - ε * (x ^ β / β))
            / (NumberField.classNumber K : ℝ) : ℝ) : ℂ) = G₀ * Y := by
    rw [hG₀, hY]
    push_cast
    ring
  have hFS : kaiLPFreqSum K q H e α
        (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w)) cT cS Ξ
        (0 : (Fin (NumberField.Units.rank K) → ℤ) ×
          ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)) x
      = ∑ ξ ∈ Ξ, ∑ η, kaiLPFreqTerm K q H e α
        (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w)) cT cS 0 0 ξ η x := by
    simp only [kaiLPFreqSum, Prod.fst_zero, Prod.snd_zero]
  rw [hFS, hM]
  have hsplit : (∑ ξ ∈ Ξ, ∑ η, kaiLPFreqTerm K q H e α
        (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w)) cT cS 0 0 ξ η x)
        - G₀ * Y
      = (∑ ξ ∈ Ξ, ∑ η, (kaiLPFreqTerm K q H e α
        (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w)) cT cS 0 0 ξ η x
          - A₀ * c ξ η * mn ξ η)) + (A₀ - G₀) * Y := by
    simp only [Finset.sum_sub_distrib, hmainsum]
    ring
  rw [hsplit]
  refine (norm_add_le _ _).trans ?_
  have hbound1 : ‖∑ ξ ∈ Ξ, ∑ η, (kaiLPFreqTerm K q H e α
        (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w)) cT cS 0 0 ξ η x
          - A₀ * c ξ η * mn ξ η)‖
      ≤ ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ)
            * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
          * ((5 / 4 : ℝ) ^ (NumberField.Units.rank K
                + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}) * ρ₀) := by
    refine (norm_sum_le _ _).trans ?_
    refine (Finset.sum_le_sum (fun ξ _ => norm_sum_le _ _)).trans ?_
    refine (Finset.sum_le_sum (fun ξ _ => Finset.sum_le_sum (fun η _ => hpair ξ η))).trans ?_
    rw [Finset.sum_const, Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_bool,
      hΞcard, nsmul_eq_mul, nsmul_eq_mul]
    apply le_of_eq
    push_cast
    ring
  have hbound2 : ‖(A₀ - G₀) * Y‖
      ≤ 3 * ((NumberField.Units.rank K
                + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex} : ℕ) : ℝ)
            * (5 / 4 : ℝ) ^ (NumberField.Units.rank K
                + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}) * δ * x := by
    rw [norm_mul]
    refine (mul_le_mul hAG hYn (norm_nonneg _) (by positivity)).trans (le_of_eq ?_)
    ring
  rw [hρ₀] at hbound1
  exact add_le_add hbound1 hbound2

theorem kai_lp_freq_type_algebra (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e) :
    (∀ (m : Fin (NumberField.Units.rank K) → ℤ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * kaiLPFreqType K H e m l w = 0) ∧
    (kaiLPFreqType K H e 0 0 = 0) ∧
    (∀ m : Fin (NumberField.Units.rank K) → ℤ,
        kaiLPFreqType K H e m 0 = 0 → m = 0) ∧
    (∀ z : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q z) →
        kaiHeckeTwist K q 0 0 1 (fun _ => false) z = 1) ∧
    (∀ (m : Fin (NumberField.Units.rank K) → ℤ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
        (∑ w : NumberField.InfinitePlace K, |kaiLPFreqType K H e m l w|)
          ≤ 2 * Real.pi * (Fintype.card (NumberField.InfinitePlace K) : ℝ) * B
              * max 1 ((NumberField.Units.rank K : ℝ) / 2)
              * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
              * ((∑ j, |((m j : ℤ) : ℝ)|)
                  + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                      |((l p : ℤ) : ℝ)|)) :=
by
  classical
  have h6 : ∀ i j, ∑ w : NumberField.InfinitePlace K,
      kaiTBUnitLog K (H i) w * e j w = if i = j then 1 else 0 :=
    hdata.2.2.2.2.2.1
  have h7 : ∀ j, ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * e j w = 0 :=
    hdata.2.2.2.2.2.2.1
  have h8 : ∀ j w, |e j w| ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K :=
    hdata.2.2.2.2.2.2.2.1
  have h9 := hdata.2.2.2.2.2.2.2.2.1
  have hReg : (0 : ℝ) < NumberField.Units.regulator K :=
    NumberField.Units.regulator_pos K
  have hD : (0 : ℝ) ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K := by
    linarith [h9.1, h9.2]
  have h2pi : (0 : ℝ) ≤ 2 * Real.pi := by positivity
  have hpine : Real.pi ≠ 0 := Real.pi_ne_zero
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro m l
    obtain ⟨c, hcdef⟩ :
        ∃ c : Fin (NumberField.Units.rank K) → ℝ,
          ∀ j, c j = (m j : ℝ) - (2 * Real.pi)⁻¹ *
            ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
              ((NumberField.mixedEmbedding K
                  ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg :=
      ⟨_, fun _ => rfl⟩
    have hft : ∀ w : NumberField.InfinitePlace K,
        kaiLPFreqType K H e m l w = 2 * Real.pi * ∑ j, c j * e j w := by
      intro w
      simp only [kaiLPFreqType, hcdef]
    have expand : ∀ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (2 * Real.pi * ∑ j, c j * e j w)
          = ∑ j, (2 * Real.pi * c j) * ((w.mult : ℝ) * e j w) := by
      intro w
      rw [Finset.mul_sum, Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    calc (∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * kaiLPFreqType K H e m l w)
        = ∑ w : NumberField.InfinitePlace K,
            ∑ j, (2 * Real.pi * c j) * ((w.mult : ℝ) * e j w) :=
          Finset.sum_congr rfl fun w _ => by rw [hft w, expand w]
      _ = ∑ j, ∑ w : NumberField.InfinitePlace K,
            (2 * Real.pi * c j) * ((w.mult : ℝ) * e j w) := Finset.sum_comm
      _ = ∑ j, (2 * Real.pi * c j) *
            (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * e j w) :=
          Finset.sum_congr rfl fun j _ => by rw [Finset.mul_sum]
      _ = 0 := by simp [h7]
  · funext w
    simp [kaiLPFreqType]
  · intro m hm
    have hm' : ∀ w : NumberField.InfinitePlace K,
        (2 * Real.pi * ∑ j, ((m j : ℤ) : ℝ) * e j w) = 0 := by
      intro w
      have hw := congrFun hm w
      simpa [kaiLPFreqType] using hw
    funext i
    have expand : ∀ w : NumberField.InfinitePlace K,
        kaiTBUnitLog K (H i) w * (2 * Real.pi * ∑ j, ((m j : ℤ) : ℝ) * e j w)
          = ∑ j, (2 * Real.pi * ((m j : ℤ) : ℝ)) *
              (kaiTBUnitLog K (H i) w * e j w) := by
      intro w
      rw [Finset.mul_sum, Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    have key : (∑ j, (2 * Real.pi * ((m j : ℤ) : ℝ)) * (if i = j then (1 : ℝ) else 0))
        = 0 := by
      calc (∑ j, (2 * Real.pi * ((m j : ℤ) : ℝ)) * (if i = j then (1 : ℝ) else 0))
          = ∑ j, (2 * Real.pi * ((m j : ℤ) : ℝ)) *
              (∑ w : NumberField.InfinitePlace K, kaiTBUnitLog K (H i) w * e j w) :=
            Finset.sum_congr rfl fun j _ => by rw [h6 i j]
        _ = ∑ j, ∑ w : NumberField.InfinitePlace K,
              (2 * Real.pi * ((m j : ℤ) : ℝ)) * (kaiTBUnitLog K (H i) w * e j w) :=
            Finset.sum_congr rfl fun j _ => by rw [Finset.mul_sum]
        _ = ∑ w : NumberField.InfinitePlace K, ∑ j,
              (2 * Real.pi * ((m j : ℤ) : ℝ)) * (kaiTBUnitLog K (H i) w * e j w) :=
            Finset.sum_comm
        _ = ∑ w : NumberField.InfinitePlace K,
              kaiTBUnitLog K (H i) w * (2 * Real.pi * ∑ j, ((m j : ℤ) : ℝ) * e j w) :=
            Finset.sum_congr rfl fun w _ => (expand w).symm
        _ = 0 := by
            refine Finset.sum_eq_zero fun w _ => ?_
            rw [hm' w, mul_zero]
    have hite : ∀ j : Fin (NumberField.Units.rank K),
        (2 * Real.pi * ((m j : ℤ) : ℝ)) * (if i = j then (1 : ℝ) else 0)
          = if i = j then 2 * Real.pi * ((m j : ℤ) : ℝ) else 0 := by
      intro j
      split_ifs <;> ring
    rw [Finset.sum_congr rfl (fun j _ => hite j), Finset.sum_ite_eq] at key
    simp only [Finset.mem_univ, if_true] at key
    have hmi : ((m i : ℤ) : ℝ) = 0 := by
      rcases mul_eq_zero.mp key with h | h
      · exact absurd h (by positivity)
      · exact h
    have hmi' : m i = 0 := by exact_mod_cast hmi
    simpa using hmi'
  · intro z hz
    simp [kaiHeckeTwist, hz]
  · intro m l
    obtain ⟨SM, hSMdef⟩ : ∃ S : ℝ, S = ∑ j, |((m j : ℤ) : ℝ)| := ⟨_, rfl⟩
    obtain ⟨SL, hSLdef⟩ : ∃ S : ℝ,
        S = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |((l p : ℤ) : ℝ)| :=
      ⟨_, rfl⟩
    have hSM0 : (0 : ℝ) ≤ SM := by
      rw [hSMdef]; exact Finset.sum_nonneg fun _ _ => abs_nonneg _
    have hSL0 : (0 : ℝ) ≤ SL := by
      rw [hSLdef]; exact Finset.sum_nonneg fun _ _ => abs_nonneg _
    rw [← hSMdef, ← hSLdef]
    obtain ⟨c, hcdef⟩ :
        ∃ c : Fin (NumberField.Units.rank K) → ℝ,
          ∀ j, c j = (m j : ℝ) - (2 * Real.pi)⁻¹ *
            ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
              ((NumberField.mixedEmbedding K
                  ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg :=
      ⟨_, fun _ => rfl⟩
    have hft : ∀ w : NumberField.InfinitePlace K,
        kaiLPFreqType K H e m l w = 2 * Real.pi * ∑ j, c j * e j w := by
      intro w
      simp only [kaiLPFreqType, hcdef]
    have hinv0 : (0 : ℝ) ≤ (2 * Real.pi)⁻¹ := by positivity
    have hpi2 : (2 * Real.pi)⁻¹ * Real.pi = 1 / 2 := by
      rw [mul_inv, mul_assoc, inv_mul_cancel₀ hpine, mul_one]
      norm_num
    have hA : ∀ j, |c j| ≤ |((m j : ℤ) : ℝ)| + (1 / 2) * SL := by
      intro j
      have h2 : |∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
            ((NumberField.mixedEmbedding K
                ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg|
          ≤ Real.pi * SL := by
        rw [hSLdef, Finset.mul_sum]
        refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun p _ => ?_)
        rw [abs_mul, mul_comm Real.pi]
        exact mul_le_mul_of_nonneg_left (Complex.abs_arg_le_pi _) (abs_nonneg _)
      have hhalf : (2 * Real.pi)⁻¹ * (Real.pi * SL) = (1 / 2) * SL := by
        rw [← mul_assoc, hpi2]
      have h1 : |(2 * Real.pi)⁻¹ *
            ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
              ((NumberField.mixedEmbedding K
                  ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg|
          ≤ (1 / 2) * SL := by
        rw [abs_mul, abs_of_nonneg hinv0]
        exact le_trans (mul_le_mul_of_nonneg_left h2 hinv0) (le_of_eq hhalf)
      rw [hcdef j]
      refine le_trans (abs_sub _ _) ?_
      linarith [h1]
    have hstepB : (∑ j, |c j|)
        ≤ SM + ((NumberField.Units.rank K : ℝ) / 2) * SL := by
      rw [hSMdef]
      calc (∑ j, |c j|)
          ≤ ∑ j : Fin (NumberField.Units.rank K),
              (|((m j : ℤ) : ℝ)| + (1 / 2) * SL) :=
            Finset.sum_le_sum fun j _ => hA j
        _ = (∑ j, |((m j : ℤ) : ℝ)|)
              + (NumberField.Units.rank K : ℝ) * ((1 / 2) * SL) := by
            rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
              Fintype.card_fin, nsmul_eq_mul]
        _ = (∑ j, |((m j : ℤ) : ℝ)|)
              + ((NumberField.Units.rank K : ℝ) / 2) * SL := by ring
    have hstepC : SM + ((NumberField.Units.rank K : ℝ) / 2) * SL
        ≤ max 1 ((NumberField.Units.rank K : ℝ) / 2) * (SM + SL) := by
      have e1 : SM ≤ max 1 ((NumberField.Units.rank K : ℝ) / 2) * SM :=
        le_mul_of_one_le_left hSM0 (le_max_left _ _)
      have e2 : ((NumberField.Units.rank K : ℝ) / 2) * SL
          ≤ max 1 ((NumberField.Units.rank K : ℝ) / 2) * SL :=
        mul_le_mul_of_nonneg_right (le_max_right _ _) hSL0
      rw [mul_add]
      linarith
    have hDpt : ∀ w : NumberField.InfinitePlace K,
        |kaiLPFreqType K H e m l w|
          ≤ 2 * Real.pi * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K)
              * ∑ j, |c j| := by
      intro w
      rw [hft w, abs_mul, abs_of_nonneg h2pi]
      have h1 : |∑ j, c j * e j w|
          ≤ ∑ j, |c j| * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) := by
        refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun j _ => ?_)
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left (h8 j w) (abs_nonneg _)
      have hsm : (∑ j, |c j| * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K))
          = (∑ j, |c j|) * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) :=
        (Finset.sum_mul _ _ _).symm
      refine le_trans (mul_le_mul_of_nonneg_left h1 h2pi) (le_of_eq ?_)
      rw [hsm]
      ring
    have hconst0 : (0 : ℝ) ≤ 2 * Real.pi
        * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) :=
      mul_nonneg h2pi hD
    calc (∑ w : NumberField.InfinitePlace K, |kaiLPFreqType K H e m l w|)
        ≤ ∑ _w : NumberField.InfinitePlace K, 2 * Real.pi
            * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) * ∑ j, |c j| :=
          Finset.sum_le_sum fun w _ => hDpt w
      _ = (Fintype.card (NumberField.InfinitePlace K) : ℝ)
            * (2 * Real.pi * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K)
              * ∑ j, |c j|) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ ≤ (Fintype.card (NumberField.InfinitePlace K) : ℝ)
            * (2 * Real.pi * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K)
              * (max 1 ((NumberField.Units.rank K : ℝ) / 2) * (SM + SL))) := by
          refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
          exact mul_le_mul_of_nonneg_left (le_trans hstepB hstepC) hconst0
      _ = 2 * Real.pi * (Fintype.card (NumberField.InfinitePlace K) : ℝ) * B
            * max 1 ((NumberField.Units.rank K : ℝ) / 2)
            * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K * (SM + SL) := by ring

theorem kai_lp_tail_weight_profile_bound {ι₁ ι₂ : Type*} [Fintype ι₁] [Fintype ι₂]
    (c : ℝ) (hc : 0 < c) :
    ∃ C : ℝ, 0 < C ∧
      ∀ x δ F : ℝ, 3 ≤ x → 0 < δ → δ ≤ 1 / 4 → 1 ≤ F →
        Summable (fun ν : (ι₁ → ℤ) × (ι₂ → ℤ) =>
          (∏ k : ι₁, kaiLPCoefBd δ (ν.1 k)) * (∏ p : ι₂, kaiLPCoefBd δ (ν.2 p))
            * Real.log (1 + (1 + F * ((∑ k : ι₁, |((ν.1 k : ℤ) : ℝ)|)
                                    + ∑ p : ι₂, |((ν.2 p : ℤ) : ℝ)|)))
            * Real.exp (-(Real.log x) / (c * (Real.sqrt (Real.log x)
                + Real.log (1 + (1 + F * ((∑ k : ι₁, |((ν.1 k : ℤ) : ℝ)|)
                                        + ∑ p : ι₂, |((ν.2 p : ℤ) : ℝ)|))))))) ∧
        (∑' ν : (ι₁ → ℤ) × (ι₂ → ℤ),
          (∏ k : ι₁, kaiLPCoefBd δ (ν.1 k)) * (∏ p : ι₂, kaiLPCoefBd δ (ν.2 p))
            * Real.log (1 + (1 + F * ((∑ k : ι₁, |((ν.1 k : ℤ) : ℝ)|)
                                    + ∑ p : ι₂, |((ν.2 p : ℤ) : ℝ)|)))
            * Real.exp (-(Real.log x) / (c * (Real.sqrt (Real.log x)
                + Real.log (1 + (1 + F * ((∑ k : ι₁, |((ν.1 k : ℤ) : ℝ)|)
                                        + ∑ p : ι₂, |((ν.2 p : ℤ) : ℝ)|)))))))
          ≤ C * Real.log (1 + F)
              * Real.exp (-(Real.log x) /
                  (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
              / δ ^ (Fintype.card ι₁ + Fintype.card ι₂) :=
by
  classical
  have hdivmono : ∀ a b d : ℝ, 0 < d → a ≤ b → a / d ≤ b / d := by
    intro a b d hd hab
    rw [div_eq_mul_inv, div_eq_mul_inv]
    exact mul_le_mul_of_nonneg_right hab (le_of_lt (inv_pos.mpr hd))
  have h2n : (1 : ℝ) ≤ (2 : ℝ) ^ (Fintype.card ι₁ + Fintype.card ι₂) :=
    one_le_pow₀ (by norm_num)
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ,
      C = 2 * c + 6 * (2 : ℝ) ^ (Fintype.card ι₁ + Fintype.card ι₂) + 8 := ⟨_, rfl⟩
  have hC2 : 2 * c ≤ C := by rw [hCdef]; linarith
  have hC8 : (8 : ℝ) ≤ C := by rw [hCdef]; linarith
  have hC6 : 6 * (2 : ℝ) ^ (Fintype.card ι₁ + Fintype.card ι₂) ≤ C := by
    rw [hCdef]; linarith
  have hC0 : (0 : ℝ) < C := by linarith
  refine ⟨C, hC0, ?_⟩
  intro x δ F hx hδ hδ4 hF
  
  have hx1 : (1 : ℝ) < x := by linarith
  have hlogx : (0 : ℝ) < Real.log x := Real.log_pos hx1
  have hu0 : (0 : ℝ) < Real.sqrt (Real.log x) := Real.sqrt_pos.mpr hlogx
  have husq : Real.sqrt (Real.log x) ^ 2 = Real.log x := Real.sq_sqrt hlogx.le
  have hLam0 : (0 : ℝ) ≤ Real.log (1 + F) := Real.log_nonneg (by linarith)
  have hLamHalf : (1 : ℝ) / 2 ≤ Real.log (1 + F) := by
    have h2 : Real.log 2 ≤ Real.log (1 + F) :=
      Real.log_le_log (by norm_num) (by linarith)
    have h3 := Real.log_two_gt_d9
    linarith
  have hEpos : (0 : ℝ) < Real.exp (-(Real.log x) /
      (C * (Real.sqrt (Real.log x) + Real.log (1 + F)))) := Real.exp_pos _
  have hδn : (0 : ℝ) < δ ^ (Fintype.card ι₁ + Fintype.card ι₂) := pow_pos hδ _
  have hcoef0 : ∀ m : ℤ, (0 : ℝ) ≤ kaiLPCoefBd δ m := by
    intro m
    rw [kaiLPCoefBd]
    split_ifs with hm
