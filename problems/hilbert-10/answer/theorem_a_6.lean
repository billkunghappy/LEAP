  obtain ⟨U, hU_def⟩ : ∃ U : ℝ, U = u ^ (160 * C) := ⟨_, rfl⟩
  have hexp1 : Real.exp (((160 * C : ℕ) : ℝ) * (1 + Real.log (1 / η))) = U := by
    rw [Real.exp_nat_mul, ← hu_def, hU_def]
  have hexp2 : Real.exp (-(((160 * C : ℕ) : ℝ) * (1 + Real.log (1 / η)))) = U⁻¹ := by
