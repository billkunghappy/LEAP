    rw [Complex.div_re, Complex.natCast_re, Complex.natCast_im, zero_mul, zero_div, add_zero]
    exact div_nonneg (mul_nonneg (Nat.cast_nonneg _) hpos.le) (Complex.normSq_nonneg _)
  
  have hzmem : z ∈ Metric.closedBall z (1 / 4) := Metric.mem_closedBall_self (by norm_num)
  have hD := (h5 z hzmem hfz).trans hRle
  rw [hld] at hD
  have hre := Complex.re_le_norm
    (-(-kaiZFHeckeLogSum K mu z + (E : ℂ) / (z - 1) - ∑ ρ ∈ Z, (mlt ρ : ℂ) / (z - ρ)))
  rw [norm_neg] at hre
  simp only [Complex.neg_re, Complex.sub_re, Complex.add_re, Complex.re_sum] at hre
  have hc4' : (∑ ρ ∈ Z, ((mlt ρ : ℂ) / (z - ρ)).re) + (kaiZFHeckeLogSum K mu z).re
      ≤ ((E : ℂ) / (z - 1)).re + (CL * P + 1) * (1 + Real.log (1 / c)) * L := by
    linarith
  exact ⟨Z, mlt, h1, h2, hc3, hc4', fun s hs hfs => (h5 s hs hfs).trans hRle⟩

theorem kai_zfnp_constants (T : ℝ) (hT : 1 ≤ T) :
    ∃ c Γ B : ℝ, 0 < c ∧ c ≤ 1 / 2560 ∧
      1 ≤ T * (1 + Real.log (1 / c)) ∧
      c * (T * (1 + Real.log (1 / c))) ≤ 3 / 80 ∧
      0 < Γ ∧ Γ ≤ 1 / 16 ∧ 24 * (T * (1 + Real.log (1 / c))) * Γ ≤ 1 ∧
      10 * c ≤ Γ ^ 2 ∧ c ≤ 2 * Γ ∧
      0 < B ∧ B ≤ c / 8 ∧ B ≤ Γ / 10 :=
by
  obtain ⟨u, hu_def⟩ : ∃ u : ℝ, u = 400 * T := ⟨_, rfl⟩
  have hTu : T = u / 400 := by rw [hu_def]; ring
  subst hTu
  have hu : 400 ≤ u := by linarith
  have hupos : 0 < u := by linarith
  have hu2 : 160000 ≤ u ^ 2 := by nlinarith
  have hu4pos : 0 < u ^ 4 := pow_pos hupos 4
  have hu4 : u ^ 4 = u ^ 2 * u ^ 2 := by ring
  have hu4ge : 160000 * u ^ 2 ≤ u ^ 4 := by rw [hu4]; nlinarith
  have hlogc : Real.log (1 / (1 / u ^ 4)) = 4 * Real.log u := by
    rw [one_div_one_div, Real.log_pow]; norm_num
  have hlogu : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hupos
  have hlogu0 : 0 ≤ Real.log u := Real.log_nonneg (by linarith)
  have hGpos : 0 < 96 * u * (u / 400) :=
    mul_pos (mul_pos (by norm_num) hupos) (by linarith)
  refine ⟨1 / u ^ 4, 1 / (96 * u * (u / 400)), (1 / u ^ 4) / 8, ?_⟩
  rw [hlogc]
  have hL1 : 1 ≤ u / 400 * (1 + 4 * Real.log u) := by
    nlinarith [mul_nonneg (sub_nonneg.2 hT) hlogu0]
  have hL2 : u / 400 * (1 + 4 * Real.log u) ≤ 4 * u * (u / 400) := by
    have h : 1 + 4 * Real.log u ≤ 4 * u := by linarith
    have := mul_le_mul_of_nonneg_left h (by linarith : (0 : ℝ) ≤ u / 400)
    linarith
  refine ⟨div_pos one_pos hu4pos, ?_, hL1, ?_, div_pos one_pos hGpos, ?_, ?_, ?_, ?_,
    div_pos (div_pos one_pos hu4pos) (by norm_num), le_refl _, ?_⟩
  · rw [div_le_div_iff₀ hu4pos (by norm_num)]; nlinarith
  · rw [one_div_mul_eq_div, div_le_iff₀ hu4pos]; nlinarith
  · rw [div_le_div_iff₀ hGpos (by norm_num)]; nlinarith
  · rw [mul_one_div, div_le_one hGpos]; linarith
  · rw [div_pow, one_pow, mul_one_div, div_le_div_iff₀ hu4pos (pow_pos hGpos 2)]; nlinarith
  · rw [mul_one_div, div_le_div_iff₀ hu4pos hGpos]; nlinarith
  · rw [div_div, div_div, div_le_div_iff₀ (mul_pos hu4pos (by norm_num))
      (mul_pos hGpos (by norm_num))]
    nlinarith

theorem kai_zfnp_box_count (L₀ Γ A₃ B : ℝ) (Z : Finset ℂ) (mlt : ℂ → ℕ)
    (hL₀ : 1 < L₀) (hΓ0 : 0 < Γ) (hΓ16 : Γ ≤ 1 / 16) (hΓA : 24 * A₃ * Γ ≤ 1)
    (hB0 : 0 ≤ B) (hBΓ : B ≤ Γ / 10)
    (hnn : ∀ ρ ∈ Z, 0 ≤ ((mlt ρ : ℂ) / (((1 + 2 * Γ / L₀ : ℝ) : ℂ) - ρ)).re)
    (hcount : (∑ ρ ∈ Z, ((mlt ρ : ℂ) / (((1 + 2 * Γ / L₀ : ℝ) : ℂ) - ρ)).re)
        ≤ L₀ / (2 * Γ) + 2 * (A₃ * L₀)) :
    (∀ s : ℂ, s.re ≤ 1 → 1 - B / L₀ ≤ s.re → |s.im| ≤ Γ / L₀ →
        s ∈ Metric.closedBall (((1 + 2 * Γ / L₀ : ℝ) : ℂ)) (1 / 4)) ∧
    (∀ s₁ s₂ : ℂ, s₁ ∈ Z → s₂ ∈ Z → 1 ≤ mlt s₁ → 1 ≤ mlt s₂ →
        s₁.re ≤ 1 → 1 - B / L₀ ≤ s₁.re → |s₁.im| ≤ Γ / L₀ →
        s₂.re ≤ 1 → 1 - B / L₀ ≤ s₂.re → |s₂.im| ≤ Γ / L₀ →
        s₁ = s₂ ∧ mlt s₁ = 1) :=
by
  classical
  have hL0 : 0 < L₀ := by linarith
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = Γ / L₀ := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : ℝ, P = L₀ / Γ := ⟨_, rfl⟩
  have hδ0 : 0 < δ := by rw [hδ]; exact div_pos hΓ0 hL0
  have hP0 : 0 < P := by rw [hP]; exact div_pos hL0 hΓ0
  have hδΓ : δ ≤ Γ := by rw [hδ]; exact div_le_self hΓ0.le hL₀.le
  have hδP : δ * P = 1 := by
    rw [hδ, hP]; field_simp
  have hPΓ : P * Γ = L₀ := by rw [hP]; exact div_mul_cancel₀ L₀ hΓ0.ne'
  have hσ : (1 + 2 * Γ / L₀ : ℝ) = 1 + 2 * δ := by rw [hδ]; ring
  have hBL : B / L₀ ≤ δ / 10 := by
    have h := div_le_div_of_nonneg_right hBΓ hL0.le
    have he : Γ / 10 / L₀ = δ / 10 := by rw [hδ]; ring
    linarith
  
  have key : ∀ ρ : ℂ, ρ.re ≤ 1 → 1 - B / L₀ ≤ ρ.re → |ρ.im| ≤ Γ / L₀ →
      ∀ m : ℕ, (m : ℝ) * (5 / 13 * P)
        ≤ ((m : ℂ) / (((1 + 2 * Γ / L₀ : ℝ) : ℂ) - ρ)).re := by
    intro ρ h1 h2 h3 m
    rw [← hδ] at h3
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = 1 + 2 * δ - ρ.re := ⟨_, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : ℝ, y = ρ.im := ⟨_, rfl⟩
    have hre : ((m : ℂ) / (((1 + 2 * Γ / L₀ : ℝ) : ℂ) - ρ)).re
        = (m : ℝ) * (x / (x ^ 2 + y ^ 2)) := by
      rw [Complex.div_re, Complex.normSq_apply]
      simp only [Complex.natCast_re, Complex.natCast_im, Complex.sub_re, Complex.sub_im,
        Complex.ofReal_re, Complex.ofReal_im]
      rw [hσ, ← hx, ← hy]
      ring
    rw [hre]
    have hx1 : 2 * δ ≤ x := by rw [hx]; linarith
    have hx2 : x ≤ 21 / 10 * δ := by rw [hx]; linarith
    have hxpos : 0 < x := by linarith
    have hy1 := (abs_le.mp h3)
    rw [← hy] at hy1
    have hy2 : y ^ 2 ≤ δ ^ 2 := by nlinarith [hy1.1, hy1.2]
    have hxx : x * x ≤ 21 / 10 * δ * x := mul_le_mul_of_nonneg_right hx2 hxpos.le
    have hdd : δ * (2 * δ) ≤ δ * x := mul_le_mul_of_nonneg_left hx1 hδ0.le
    have hineq : 5 * (x ^ 2 + y ^ 2) ≤ 13 * δ * x := by nlinarith
    have hden : 0 < x ^ 2 + y ^ 2 := by positivity
    have hfrac : 5 / 13 * P ≤ x / (x ^ 2 + y ^ 2) := by
      rw [le_div_iff₀ hden]
      have h := mul_le_mul_of_nonneg_left hineq hP0.le
      have e1 : P * (13 * δ * x) = 13 * x := by
        calc P * (13 * δ * x) = 13 * x * (δ * P) := by ring
          _ = 13 * x := by rw [hδP, mul_one]
      nlinarith
    exact mul_le_mul_of_nonneg_left hfrac (Nat.cast_nonneg m)
  
  have hS : (∑ ρ ∈ Z, ((mlt ρ : ℂ) / (((1 + 2 * Γ / L₀ : ℝ) : ℂ) - ρ)).re)
      ≤ 7 / 12 * P := by
    have e1 : L₀ / (2 * Γ) = P / 2 := by
      rw [hP, div_div, mul_comm 2 Γ]
    have e2 : 2 * (A₃ * L₀) = P / 12 * (24 * A₃ * Γ) := by
      rw [← hPΓ]; ring
    have e3 : P / 12 * (24 * A₃ * Γ) ≤ P / 12 * 1 :=
      mul_le_mul_of_nonneg_left hΓA (by positivity)
    linarith
  refine ⟨?_, ?_⟩
  · 
    intro s h1 h2 h3
    rw [← hδ] at h3
    rw [Metric.mem_closedBall, Complex.dist_eq]
    refine (Complex.norm_le_abs_re_add_abs_im _).trans ?_
    simp only [Complex.sub_re, Complex.sub_im, Complex.ofReal_re, Complex.ofReal_im, sub_zero]
    rw [hσ]
    have hr : |s.re - (1 + 2 * δ)| ≤ 21 / 10 * δ := by
      rw [abs_le]; constructor <;> linarith
    linarith
  · intro s₁ s₂ hs₁ hs₂ hm₁ hm₂ a1 a2 a3 b1 b2 b3
    have k1 := key s₁ a1 a2 a3 (mlt s₁)
    have k2 := key s₂ b1 b2 b3 (mlt s₂)
    have hm₁' : (1 : ℝ) ≤ (mlt s₁ : ℝ) := by exact_mod_cast hm₁
    have hm₂' : (1 : ℝ) ≤ (mlt s₂ : ℝ) := by exact_mod_cast hm₂
    have hQ : 0 < 5 / 13 * P := by positivity
    have l1 : 5 / 13 * P ≤ (mlt s₁ : ℝ) * (5 / 13 * P) := by nlinarith
    have l2 : 5 / 13 * P ≤ (mlt s₂ : ℝ) * (5 / 13 * P) := by nlinarith
    have heq : s₁ = s₂ := by
      by_contra hne
      have hsub : ({s₁, s₂} : Finset ℂ) ⊆ Z := by
        intro z hz
        rw [Finset.mem_insert, Finset.mem_singleton] at hz
        rcases hz with rfl | rfl
        · exact hs₁
        · exact hs₂
      have hle := Finset.sum_le_sum_of_subset_of_nonneg hsub
        (f := fun ρ => ((mlt ρ : ℂ) / (((1 + 2 * Γ / L₀ : ℝ) : ℂ) - ρ)).re)
        (fun i hi _ => hnn i hi)
      rw [Finset.sum_pair hne] at hle
      linarith
    refine ⟨heq, ?_⟩
    by_contra hne
    have h2 : 2 ≤ mlt s₁ := by omega
    have h2' : (2 : ℝ) ≤ (mlt s₁ : ℝ) := by exact_mod_cast h2
    have l3 : 2 * (5 / 13 * P) ≤ (mlt s₁ : ℝ) * (5 / 13 * P) :=
      mul_le_mul_of_nonneg_right h2' hQ.le
    have hsingle := Finset.single_le_sum
      (f := fun ρ => ((mlt ρ : ℂ) / (((1 + 2 * Γ / L₀ : ℝ) : ℂ) - ρ)).re)
      (fun i hi => hnn i hi) hs₁
    simp only at hsingle
    linarith

theorem kai_zfnp_deriv_ne_zero (f : ℂ → ℂ) (c ρ₀ : ℂ) (r Cst : ℝ)
    (Z : Finset ℂ) (mult : ℂ → ℕ)
    (hf : Differentiable ℂ f) (hr : 0 < r) (hc : f c ≠ 0)
    (hρball : ρ₀ ∈ Metric.closedBall c (r / 4))
    (hρzero : f ρ₀ = 0)
    (hρZ : ρ₀ ∈ Z)
    (hmult : mult ρ₀ = 1)
    (hexp : ∀ s ∈ Metric.closedBall c (r / 4), f s ≠ 0 →
        ‖deriv f s / f s - ∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ)‖ ≤ Cst) :
    deriv f ρ₀ ≠ 0 :=
by
  classical
  have hA : AnalyticAt ℂ f ρ₀ := hf.analyticAt ρ₀
  have hne : ¬ ∀ᶠ z in nhds ρ₀, f z = 0 := by
    intro hev
    have hAU : AnalyticOnNhd ℂ f Set.univ := hf.differentiableOn.analyticOnNhd isOpen_univ
    have := hAU.eqOn_zero_of_preconnected_of_eventuallyEq_zero isPreconnected_univ
      (Set.mem_univ ρ₀) hev (Set.mem_univ c)
    exact hc this
  obtain ⟨n, g, hgA, hg0, hev⟩ := (hA.exists_eventuallyEq_pow_smul_nonzero_iff).mpr hne
  simp only [smul_eq_mul] at hev
  have hn0 : n ≠ 0 := by
    rintro rfl
    have h1 : f ρ₀ = (ρ₀ - ρ₀) ^ 0 * g ρ₀ := hev.self_of_nhds
    rw [pow_zero, one_mul] at h1
    rw [h1] at hρzero
    exact hg0 hρzero
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  
  have hderiv_ev : ∀ᶠ z in nhds ρ₀, g z ≠ 0 ∧
      deriv f z = ((k + 1 : ℕ) : ℂ) * (z - ρ₀) ^ k * g z + (z - ρ₀) ^ (k + 1) * deriv g z := by
    filter_upwards [hev.eventually_nhds, hgA.eventually_analyticAt,
      hgA.continuousAt.eventually_ne hg0] with z hz hgz hgz0
    refine ⟨hgz0, ?_⟩
    have hd := (((hasDerivAt_id' z).sub_const ρ₀).pow (k + 1)).mul
      hgz.differentiableAt.hasDerivAt
    rw [(hd.congr_of_eventuallyEq hz).deriv]
    simp only [Nat.add_sub_cancel, mul_one, Pi.pow_apply]
  have hcρ : c ≠ ρ₀ := by
    rintro rfl
    exact hc hρzero
  
  obtain ⟨γ, hγ⟩ : ∃ γ : ℝ → ℂ, γ = fun t : ℝ => ρ₀ + (t : ℂ) * (c - ρ₀) := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : Filter ℂ, F = Filter.map γ (nhdsWithin (0 : ℝ) (Set.Ioi 0)) :=
    ⟨_, rfl⟩
  haveI : F.NeBot := by rw [hF]; infer_instance
  have hFle : F ≤ nhds ρ₀ := by
    have hcont : Continuous γ := by rw [hγ]; fun_prop
    have h0 : Filter.Tendsto γ (nhds 0) (nhds ρ₀) := by
      have := hcont.tendsto 0
      have hγ0 : γ 0 = ρ₀ := by rw [hγ]; simp
      rwa [hγ0] at this
    rw [hF]
    exact (Filter.map_mono nhdsWithin_le_nhds).trans h0
  have hFball : ∀ᶠ z in F, z ∈ Metric.closedBall c (r / 4) ∧ z ≠ ρ₀ := by
    rw [hF, Filter.eventually_map]
    have hI : Set.Ioo (0 : ℝ) 1 ∈ nhdsWithin (0 : ℝ) (Set.Ioi 0) := Ioo_mem_nhdsGT (by norm_num)
    filter_upwards [hI] with t ht
    constructor
    · rw [Metric.mem_closedBall, Complex.dist_eq] at hρball ⊢
      have heq : γ t - c = ((1 - t : ℝ) : ℂ) * (ρ₀ - c) := by
