  have hmulim : ∀ z w : ℂ, z.im = 0 → w.im = 0 → (z * w).im = 0 := by
    intro z w hz hw; simp [Complex.mul_im, hz, hw]
  have him₁ : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → (lam₁ I).im = 0 := by
    intro I hI; rcases hval₁ I hI with h | h | h <;> rw [h] <;> simp
  have him₂ : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → (lam₂ I).im = 0 := by
    intro I hI; rcases hval₂ I hI with h | h | h <;> rw [h] <;> simp
  have hkey : ∀ M : Ideal (NumberField.RingOfIntegers K), M ≠ 0 → (S M).im = 0 := by
    intro M hM
    haveI : Fintype {p : Ideal (NumberField.RingOfIntegers K) ×
             Ideal (NumberField.RingOfIntegers K) ×
             Ideal (NumberField.RingOfIntegers K) ×
             Ideal (NumberField.RingOfIntegers K) //
           p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = M} := (hfin M hM).fintype
    rw [hS, tsum_fintype, Complex.im_sum]
    refine Finset.sum_eq_zero ?_
    rintro ⟨⟨a, b, c, d⟩, hp⟩ -
    show (lam₁ b * lam₂ c * (lam₁ d * lam₂ d)).im = 0
    obtain ⟨-, hb, hc, hd⟩ := hnz M a b c d hp hM
    exact hmulim _ _ (hmulim _ _ (him₁ b hb) (him₂ c hc))
      (hmulim _ _ (him₁ d hd) (him₂ d hd))
  have hreal : ∀ M : Ideal (NumberField.RingOfIntegers K), M ≠ 0 →
      (((S M).re : ℝ) : ℂ) = S M := by
    intro M hM
    refine Complex.ext ?_ ?_
    · simp
    · simp [hkey M hM]
  
  have hone0 : (1 : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := one_ne_zero
  have hvalone : S 1 = 1 := by
    have hb : ((1 : Ideal (NumberField.RingOfIntegers K)) *
        (1 : Ideal (NumberField.RingOfIntegers K)) *
        (1 : Ideal (NumberField.RingOfIntegers K)) *
        (1 : Ideal (NumberField.RingOfIntegers K)))
          = (1 : Ideal (NumberField.RingOfIntegers K)) := by
      simp
    have hall : ∀ q : {p : Ideal (NumberField.RingOfIntegers K) ×
             Ideal (NumberField.RingOfIntegers K) ×
             Ideal (NumberField.RingOfIntegers K) ×
             Ideal (NumberField.RingOfIntegers K) //
           p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = (1 : Ideal (NumberField.RingOfIntegers K))},
        q = ⟨(1, 1, 1, 1), hb⟩ := by
      rintro ⟨⟨a, b, c, d⟩, hq⟩
      obtain ⟨h1, h2, h3, h4⟩ := hdvd 1 a b c d hq
      have e1 : a = 1 := by
        have h := isUnit_of_dvd_one h1
        rw [Ideal.isUnit_iff] at h
        rw [h, Ideal.one_eq_top]
      have e2 : b = 1 := by
        have h := isUnit_of_dvd_one h2
        rw [Ideal.isUnit_iff] at h
        rw [h, Ideal.one_eq_top]
      have e3 : c = 1 := by
        have h := isUnit_of_dvd_one h3
        rw [Ideal.isUnit_iff] at h
        rw [h, Ideal.one_eq_top]
      have e4 : d = 1 := by
        have h := isUnit_of_dvd_one h4
        rw [Ideal.isUnit_iff] at h
        rw [h, Ideal.one_eq_top]
      subst e1; subst e2; subst e3; subst e4
      rfl
    rw [hS, tsum_eq_single ⟨(1, 1, 1, 1), hb⟩ (fun q hq => absurd (hall q) hq)]
    show lam₁ 1 * lam₂ 1 * (lam₁ 1 * lam₂ 1) = 1
    rw [hone₁, hone₂]; ring
  
  have hlocal : ∀ x y : ℤ, (x = 1 ∨ x = -1 ∨ x = 0) → (y = 1 ∨ y = -1 ∨ y = 0) →
      ∀ e : ℕ, 0 ≤ ∑ k ∈ Finset.range (e + 1),
        (∑ i ∈ Finset.range (k + 1), x ^ i) * y ^ (e - k) *
          (∑ i ∈ Finset.range (e - k + 1), x ^ i) := by
    intro x y hx hy e
    have hu1 : ∀ m : ℕ, ∑ i ∈ Finset.range (m + 1), (1 : ℤ) ^ i = (m : ℤ) + 1 := by
      intro m; simp
    have hu0 : ∀ m : ℕ, ∑ i ∈ Finset.range (m + 1), (0 : ℤ) ^ i = 1 := by
      intro m
      rw [Finset.sum_eq_single 0]
      · simp
      · intro b _ hb; exact zero_pow hb
      · intro h; exact absurd (Finset.mem_range.mpr (Nat.succ_pos m)) h
