      have := mul_le_mul_of_nonneg_left hL1 hn16
      linarith
    have hball : ∀ s ∈ Metric.closedBall s₁ 1, ‖G s‖ ≤ Real.exp (A₂ * L) * ‖G s₁‖ := by
      intro s hs
      have hU := hup s hs
      have hU0 : 0 ≤ ‖G s‖ := norm_nonneg _
      have hP0 : 0 ≤ (1 + 8 * L) ^ (n + 1) := by positivity
      have e : Real.exp (A₂ * L) = Real.exp ((Real.log A + 2 * A) * L)
          * Real.exp (((n : ℝ) + 1) * Real.log 16 * L + ((n : ℝ) + 1) * L) := by
        rw [← Real.exp_add, hA₂_def]; congr 1; ring
      calc ‖G s‖ ≤ ‖G s‖ * (‖G s₁‖ * (1 + 8 * L) ^ (n + 1)) := le_mul_of_one_le_right hU0 hlow
        _ = ‖G s₁‖ * (‖G s‖ * (1 + 8 * L) ^ (n + 1)) := by ring
        _ ≤ ‖G s₁‖ * (Real.exp ((Real.log A + 2 * A) * L)
              * Real.exp (((n : ℝ) + 1) * Real.log 16 * L + ((n : ℝ) + 1) * L)) := by
            apply mul_le_mul_of_nonneg_left _ hV.le
            exact mul_le_mul hU hfac hP0 (Real.exp_pos _).le
