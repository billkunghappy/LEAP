                    ((k : ℤ) + 1) * (-1 : ℤ) ^ (n - k) * (((n - k : ℕ) : ℤ) + 1))
                - (∑ k ∈ Finset.range (n + 1), ((k : ℤ) + 1) * (-1 : ℤ) ^ (n - k))
                + ((n : ℤ) + 2) := by
          intro n N hN
          subst hN
          rw [Finset.sum_range_succ]
          have h1 : ∀ k ∈ Finset.range (n + 1),
              ((k : ℤ) + 1) * (-1 : ℤ) ^ (n + 1 - k) * (((n + 1 - k : ℕ) : ℤ) + 1)
                = -(((k : ℤ) + 1) * (-1 : ℤ) ^ (n - k) * (((n - k : ℕ) : ℤ) + 1))
                  + -(((k : ℤ) + 1) * (-1 : ℤ) ^ (n - k)) := by
            intro k hk
            rw [Finset.mem_range] at hk
            have hs : n + 1 - k = (n - k) + 1 := by omega
            rw [hs, pow_succ]
            push_cast
            ring
