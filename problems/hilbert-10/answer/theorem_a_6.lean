    subst hEE
    have hGG : G s = G' s := by
      have heq : G =ᶠ[nhds (2 : ℂ)] G' := by
        have hopen : IsOpen {w : ℂ | 1 < w.re} :=
          isOpen_lt continuous_const Complex.continuous_re
        have h2 : (2 : ℂ) ∈ {w : ℂ | 1 < w.re} := by
          show (1 : ℝ) < (2 : ℂ).re; norm_num
        filter_upwards [hopen.mem_nhds h2] with w hw
        rw [← hGeq w hw, ← hG'eq w hw]
      exact (hG.differentiableOn.analyticOnNhd isOpen_univ).eqOn_of_preconnected_of_eventuallyEq
        (hG'.differentiableOn.analyticOnNhd isOpen_univ) isPreconnected_univ
        (Set.mem_univ 2) heq (Set.mem_univ s)
    have hb := hG'bd s hs1 hs2
    simp only [Pi.zero_apply, abs_zero, Int.cast_zero, Finset.sum_const_zero, add_zero] at hb
    rw [show (1 : ℝ) + 1 = 2 by norm_num] at hb
    rw [hGG]
    have hNq : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
      have h0 : Ideal.absNorm q ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hq
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr h0
    have hX : 1 ≤ (Ideal.absNorm q : ℝ) * 2 * (2 + |s.im|) := by
      have := abs_nonneg s.im
      nlinarith
    calc ‖G' s‖ ≤ A₀ * ((Ideal.absNorm q : ℝ) * 2 * (2 + |s.im|)) ^ A₀ := hb
      _ ≤ max A₀ 1 * ((Ideal.absNorm q : ℝ) * 2 * (2 + |s.im|)) ^ A₀ :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg (by linarith) _)
      _ ≤ max A₀ 1 * ((Ideal.absNorm q : ℝ) * 2 * (2 + |s.im|)) ^ (max A₀ 1) :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hX (le_max_left _ _))
            (le_trans zero_le_one (le_max_right _ _))
  
  obtain ⟨A, hA1, H2⟩ := hstrip
  obtain ⟨CL, hCL, H3⟩ := hland
  have hlogA : 0 ≤ Real.log A := Real.log_nonneg hA1
  have hn0 : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.cast_nonneg _
  obtain ⟨P₀, hP₀_def⟩ : ∃ P₀ : ℝ,
      P₀ = CL * (2 * A + Real.log A + 2 * (Module.finrank ℚ K : ℝ) + 2) := ⟨_, rfl⟩
  have hP₀ : 0 ≤ P₀ := by rw [hP₀_def]; exact mul_nonneg hCL.le (by linarith)
  refine ⟨P₀ + 1, by linarith, ?_⟩
  intro q hq ξ η lam hext E G hE hEiff hG hGeq
  have hzre : ∀ ρ : ℂ, G ρ = 0 → ρ.re ≤ 1 := by
    intro ρ hρ
    by_contra h
    push_neg at h
    exact (hhalf q hq ξ η lam hext E G hE hGeq ρ h).1 hρ
  refine ⟨hzre, ?_⟩
  intro c Λ z hc0 hc1 hΛ hzre' hlog
  have hδ0 : 0 < c / Λ := div_pos hc0 (by linarith)
  have hδ1 : c / Λ ≤ 1 := (div_le_one (by linarith)).2 (by linarith)
