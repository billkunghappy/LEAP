    have hpair : ∀ (a : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
        (b : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ),
        ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ‖((a, b) : NumberField.mixedEmbedding.mixedSpace K)‖ ≤ 1 := by
      intro a b h1 h2
      rw [Prod.norm_def]
      exact max_le h1 h2
    have hnorm : ∀ i, ‖f i‖ ≤ 1 := by
      intro i
      rcases i with w | (w | w)
      · rw [hfR]
        refine hpair _ _ ?_ ?_
        · refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr (fun v => ?_)
          rcases eq_or_ne v w with h | h
          · subst h; simp
          · simp [Pi.single_eq_of_ne h]
        · simp
      · rw [hfC]
        refine hpair _ _ ?_ ?_
        · simp
        · refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr (fun v => ?_)
          rcases eq_or_ne v w with h | h
          · subst h; simp
          · simp [Pi.single_eq_of_ne h]
      · rw [hfD]
        refine hpair _ _ ?_ ?_
        · simp
        · refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr (fun v => ?_)
          rcases eq_or_ne v w with h | h
          · subst h; simp [Complex.norm_I]
          · simp [Pi.single_eq_of_ne h]
    refine ⟨Finset.image f Finset.univ,
        (Fintype.card ({w : NumberField.InfinitePlace K // w.IsReal} ⊕
          ({w : NumberField.InfinitePlace K // w.IsComplex} ⊕
           {w : NumberField.InfinitePlace K // w.IsComplex})) : ℝ) + 1, ?_, ?_, ?_⟩
    · positivity
    · intro e he
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp he
      exact hnorm i
    · intro φ hφ
      have hkey : ∀ y : NumberField.mixedEmbedding.mixedSpace K,
          |φ y| ≤ (∑ i, |φ (f i)|) * ‖y‖ := by
        intro y
        have h0 : φ y = φ (∑ i, cc y i • f i) := by rw [← hspan y]
        have hy : φ y = ∑ i, cc y i * φ (f i) := by
          rw [h0, map_sum]
          simp [map_smul]
        rw [hy]
        calc |∑ i, cc y i * φ (f i)| ≤ ∑ i, |cc y i * φ (f i)| :=
              Finset.abs_sum_le_sum_abs _ _
          _ = ∑ i, |cc y i| * |φ (f i)| := by simp [abs_mul]
          _ ≤ ∑ i, ‖y‖ * |φ (f i)| :=
              Finset.sum_le_sum (fun i _ =>
                mul_le_mul_of_nonneg_right (hcoef y i) (abs_nonneg _))
          _ = ‖y‖ * ∑ i, |φ (f i)| := by rw [Finset.mul_sum]
          _ = (∑ i, |φ (f i)|) * ‖y‖ := by ring
      have hMne : (∑ i, |φ (f i)|) ≠ 0 := by
        intro h0
        refine hφ (ContinuousLinearMap.ext (fun y => ?_))
