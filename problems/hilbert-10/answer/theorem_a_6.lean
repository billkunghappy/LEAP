        ≤ |kaiMFConeAlpha K w * (1 - s.re)| + |kaiHZDeg K η l w / 2| := abs_add_le _ _
      _ ≤ 4 + kaiHZDeg K η l w / 2 := by
          rw [abs_of_nonneg
            (show (0 : ℝ) ≤ kaiHZDeg K η l w / 2 by linarith [hdeg0 w])]
          linarith
  have hXi1s : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
      ‖Xi1 (kaiMFConeZcan K t l η s)‖ ≤ CX := by
    intro s hs1 hs2
    refine le_trans (hXi1b (kaiMFConeZcan K t l η s)) ?_
    rw [hCX]
    refine mul_le_mul_of_nonneg_left ?_ hMXi0
    refine Real.exp_le_exp.mpr ?_
    have hS := hsum1 s hs1 hs2
    have hS0 : (0 : ℝ) ≤ ∑ w : NumberField.InfinitePlace K,
        |(kaiMFConeZcan K t l η s w).re| :=
      Finset.sum_nonneg (fun w _ => abs_nonneg _)
    nlinarith [mul_nonneg (sub_nonneg.mpr (le_abs_self c₂)) hS0,
      mul_nonneg (abs_nonneg c₂) (sub_nonneg.mpr hS)]
  have hXi2s : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
      ‖Xi2 (kaiMFConeZdual K t l η (1 - s))‖ ≤ CX := by
    intro s hs1 hs2
    refine le_trans (hXi2b (kaiMFConeZdual K t l η (1 - s))) ?_
    rw [hCX]
    refine mul_le_mul_of_nonneg_left ?_ hMXi0
    refine Real.exp_le_exp.mpr ?_
    have hS := hsum2 s hs1 hs2
    have hS0 : (0 : ℝ) ≤ ∑ w : NumberField.InfinitePlace K,
        |(kaiMFConeZdual K t l η (1 - s) w).re| :=
      Finset.sum_nonneg (fun w _ => abs_nonneg _)
    nlinarith [mul_nonneg (sub_nonneg.mpr (le_abs_self c₂)) hS0,
      mul_nonneg (abs_nonneg c₂) (sub_nonneg.mpr hS)]
  have hRrb : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 → ‖Rr s‖ ≤ CR := by
    intro s hs1 hs2
    rw [hRr s, Complex.norm_exp, hCR]
    refine Real.exp_le_exp.mpr ?_
    have key : ∀ w : NumberField.InfinitePlace K,
        (0 : ℝ) ≤ (kaiMFConeZdual K t l η (1 - s) w *
            ((Real.log (r w) : ℝ) : ℂ)).re
          + (3 + kaiHZDeg K η l w / 2) * |Real.log (r w)| := by
      intro w
      rw [hmulreal, hzdualre s w]
      have hsabs : |1 - s.re| ≤ 3 := by rw [abs_le]; constructor <;> linarith
      have ha : |kaiMFConeAlpha K w * (1 - s.re)| ≤ 3 := by
        rw [abs_mul, abs_of_nonneg (hal0 w)]
        nlinarith [abs_nonneg (1 - s.re),
          mul_nonneg (sub_nonneg.mpr (hal2 w)) (abs_nonneg (1 - s.re))]
      have hX : |kaiMFConeAlpha K w * (1 - s.re) + kaiHZDeg K η l w / 2|
          ≤ 3 + kaiHZDeg K η l w / 2 := by
        calc |kaiMFConeAlpha K w * (1 - s.re) + kaiHZDeg K η l w / 2|
            ≤ |kaiMFConeAlpha K w * (1 - s.re)| + |kaiHZDeg K η l w / 2| :=
              abs_add_le _ _
          _ ≤ 3 + kaiHZDeg K η l w / 2 := by
              rw [abs_of_nonneg
                (show (0 : ℝ) ≤ kaiHZDeg K η l w / 2 by linarith [hdeg0 w])]
              linarith
      have h1 : -((kaiMFConeAlpha K w * (1 - s.re) + kaiHZDeg K η l w / 2) *
            Real.log (r w))
          ≤ |(kaiMFConeAlpha K w * (1 - s.re) + kaiHZDeg K η l w / 2) *
            Real.log (r w)| := neg_le_abs _
      rw [abs_mul] at h1
      have h2 : |kaiMFConeAlpha K w * (1 - s.re) + kaiHZDeg K η l w / 2| *
            |Real.log (r w)|
          ≤ (3 + kaiHZDeg K η l w / 2) * |Real.log (r w)| :=
        mul_le_mul_of_nonneg_right hX (abs_nonneg _)
      linarith
    have hsum := Finset.sum_nonneg
      (fun w (_ : w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K))) => key w)
    rw [Finset.sum_add_distrib] at hsum
    rw [Complex.neg_re, Complex.re_sum]
    linarith
  obtain ⟨NN, hNN⟩ : ∃ n : ℕ, n = Fintype.card (NumberField.InfinitePlace K) + 1 +
      (Fintype.card (NumberField.InfinitePlace K) - 1) := ⟨_, rfl⟩
  obtain ⟨M1, hM1⟩ : ∃ x : ℝ, x = max 0 (5 * (Ct + ‖κ‖ * CR * Ct') * PB) := ⟨_, rfl⟩
  obtain ⟨M2, hM2⟩ : ∃ x : ℝ, x = max 0 (‖ee‖ * (‖κ‖ * CR * 2 * CTH * CX) * PB) :=
    ⟨_, rfl⟩
  obtain ⟨M3, hM3⟩ : ∃ x : ℝ, x = max 0 (‖ee‖ * (‖δ‖ * 5 * 2 * CTH * CX * CQ * CE * CAL *
      4 ^ (Fintype.card (NumberField.InfinitePlace K) - 1))) := ⟨_, rfl⟩
  have hM10 : (0 : ℝ) ≤ M1 := by rw [hM1]; exact le_max_left _ _
  have hM20 : (0 : ℝ) ≤ M2 := by rw [hM2]; exact le_max_left _ _
  have hM30 : (0 : ℝ) ≤ M3 := by rw [hM3]; exact le_max_left _ _
  have hmain : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
      ‖Gc s * ∏ w : NumberField.InfinitePlace K,
          Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w)‖
        ≤ (M1 + M2 + M3) * (1 + |s.im|) ^ NN := by
    intro s hs1 hs2
    have hta : (0 : ℝ) ≤ |s.im| := abs_nonneg _
    have h1ta : (1 : ℝ) ≤ 1 + |s.im| := by linarith
    have hsn : ‖s‖ ≤ 4 * (1 + |s.im|) := by
      have h := Complex.norm_le_abs_re_add_abs_im s
      have h2 : |s.re| ≤ 4 := abs_le.mpr ⟨by linarith, hs2⟩
      linarith
    have hs1n : ‖s - 1‖ ≤ 5 * (1 + |s.im|) := by
      have h := norm_sub_le s 1
      rw [norm_one] at h
      linarith
    have hfin : ∀ (c M : ℝ) (j : ℕ), c ≤ M → 0 ≤ M → j ≤ NN →
        c * (1 + |s.im|) ^ j ≤ M * (1 + |s.im|) ^ NN := by
      intro c M j hcM hM hj
      calc c * (1 + |s.im|) ^ j ≤ M * (1 + |s.im|) ^ j :=
            mul_le_mul_of_nonneg_right hcM (pow_nonneg (by linarith) _)
        _ ≤ M * (1 + |s.im|) ^ NN :=
            mul_le_mul_of_nonneg_left (pow_le_pow_right₀ h1ta hj) hM
    have hgam := hgamprod s hs1 hs2
    have hRrs := hRrb s hs1 hs2
    have hXi1s' := hXi1s s hs1 hs2
    have hXi2s' := hXi2s s hs1 hs2
    have hCEs := hCEb s hs1 hs2
    have hCTHa := hCTHs s hs1 hs2
    have hCTHb := hCTH1s s hs1 hs2
    rw [hGc s, sub_mul, add_mul]
    refine le_trans (htri _ _ _) ?_
    obtain ⟨PP, hPP⟩ : ∃ x : ℂ, x = ∏ w : NumberField.InfinitePlace K,
        Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w) :=
      ⟨_, rfl⟩
    rw [← hPP] at hgam ⊢
    have hPfPb : ‖Pf s * PP‖
        ≤ PB * (1 + |s.im|) ^ Fintype.card (NumberField.InfinitePlace K) := by
      rw [show Pf s * PP = (((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
              kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
            Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 *
              Real.log Real.pi : ℝ) : ℂ) * s)) *
            ((∏ w : NumberField.InfinitePlace K,
              (Complex.Gamma (kaiMFConeZcan K t l η s w))⁻¹) * PP) from by
        rw [hPf s]; ring]
      refine le_trans (hmul _ _ _ _ (hmul _ _ _ _ hCQb hCEs) hgam) ?_
      rw [hPB]
      exact le_of_eq (by ring)
    have hA : ‖(s - 1) * (Tl s + κ * Rr s * Tl' (1 - s)) * Pf s * PP‖
        ≤ M1 * (1 + |s.im|) ^ NN := by
      rw [show (s - 1) * (Tl s + κ * Rr s * Tl' (1 - s)) * Pf s * PP
          = ((s - 1) * (Tl s + κ * Rr s * Tl' (1 - s))) * (Pf s * PP) from by ring]
      have hTl : ‖Tl s‖ ≤ Ct := hTlb s (by linarith) (by linarith)
      have hre : (1 - s).re = 1 - s.re := by rw [Complex.sub_re, Complex.one_re]
      have hTl' : ‖Tl' (1 - s)‖ ≤ Ct' :=
        hTl'b (1 - s) (by rw [hre]; linarith) (by rw [hre]; linarith)
      have b1 : ‖Tl s + κ * Rr s * Tl' (1 - s)‖ ≤ Ct + ‖κ‖ * CR * Ct' :=
        hadd _ _ _ _ hTl (hmul _ _ _ _ (hmul _ _ _ _ le_rfl hRrs) hTl')
      have b2 := hmul _ _ _ _ hs1n b1
      have b3 := hmul _ _ _ _ b2 hPfPb
      refine le_trans b3 ?_
      rw [show 5 * (1 + |s.im|) * (Ct + ‖κ‖ * CR * Ct') *
            (PB * (1 + |s.im|) ^ Fintype.card (NumberField.InfinitePlace K))
          = 5 * (Ct + ‖κ‖ * CR * Ct') * PB *
            (1 + |s.im|) ^ (Fintype.card (NumberField.InfinitePlace K) + 1) from by ring]
      exact hfin _ M1 _ (by rw [hM1]; exact le_max_right _ _) hM10 (by omega)
    have hB : ‖ee * (κ * Rr s * 2 * Complex.exp ((1 - s) * (θ₀ : ℂ) / 2) *
          Xi2 (kaiMFConeZdual K t l η (1 - s)) * Pf s) * PP‖
        ≤ M2 * (1 + |s.im|) ^ NN := by
      rw [show ee * (κ * Rr s * 2 * Complex.exp ((1 - s) * (θ₀ : ℂ) / 2) *
            Xi2 (kaiMFConeZdual K t l η (1 - s)) * Pf s) * PP
          = ee * (κ * Rr s * 2 * Complex.exp ((1 - s) * (θ₀ : ℂ) / 2) *
            Xi2 (kaiMFConeZdual K t l η (1 - s)) * (Pf s * PP)) from by ring]
      have b1 := hmul _ _ _ _ (le_refl ‖κ‖) hRrs
      have b2 := hmul _ _ _ _ b1 (show ‖(2 : ℂ)‖ ≤ 2 by norm_num)
      have b3 := hmul _ _ _ _ b2 hCTHb
      have b4 := hmul _ _ _ _ b3 hXi2s'
      have b5 := hmul _ _ _ _ b4 hPfPb
      have b6 := hmul _ _ _ _ (le_refl ‖ee‖) b5
      refine le_trans b6 ?_
      rw [show ‖ee‖ * (‖κ‖ * CR * 2 * CTH * CX *
            (PB * (1 + |s.im|) ^ Fintype.card (NumberField.InfinitePlace K)))
          = ‖ee‖ * (‖κ‖ * CR * 2 * CTH * CX) * PB *
            (1 + |s.im|) ^ Fintype.card (NumberField.InfinitePlace K) from by ring]
      exact hfin _ M2 _ (by rw [hM2]; exact le_max_right _ _) hM20 (by omega)
    have hC : ‖ee * (δ * (s - 1) * 2 * Complex.exp (s * (θ₀ : ℂ) / 2) *
          Xi1 (kaiMFConeZcan K t l η s) *
          ((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
              kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
          Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 * Real.log Real.pi : ℝ) : ℂ) * s) *
          (∏ w : NumberField.InfinitePlace K, ((kaiMFConeAlpha K w : ℝ) : ℂ)) *
          s ^ (Fintype.card (NumberField.InfinitePlace K) - 1) *
          ∏ w : NumberField.InfinitePlace K,
            (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + 1))⁻¹) * PP‖
        ≤ M3 * (1 + |s.im|) ^ NN := by
      by_cases hee0 : ee = 0
      · rw [hee0, zero_mul, zero_mul, norm_zero]
        exact mul_nonneg hM30 (pow_nonneg (by linarith) _)
      · obtain ⟨hdz, htz⟩ := hee hee0
        have hbone : ∀ w : NumberField.InfinitePlace K,
            kaiMFConeBeta K t l η w = 1 := by
          intro w
          simp only [kaiMFConeBeta, hdz w, htz, Pi.zero_apply]
          norm_num
        have hcancel : (∏ w : NumberField.InfinitePlace K,
              (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + 1))⁻¹) * PP = 1 := by
          rw [hPP, ← Finset.prod_mul_distrib]
          refine Finset.prod_eq_one (fun w _ => ?_)
          have hne := hGne s hs1 w
          rw [hbone w] at hne
          rw [hbone w]
          exact inv_mul_cancel₀ hne
        rw [show ee * (δ * (s - 1) * 2 * Complex.exp (s * (θ₀ : ℂ) / 2) *
              Xi1 (kaiMFConeZcan K t l η s) *
              ((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
                  kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
              Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 *
                Real.log Real.pi : ℝ) : ℂ) * s) *
              (∏ w : NumberField.InfinitePlace K, ((kaiMFConeAlpha K w : ℝ) : ℂ)) *
              s ^ (Fintype.card (NumberField.InfinitePlace K) - 1) *
              ∏ w : NumberField.InfinitePlace K,
                (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + 1))⁻¹) * PP
            = ee * (δ * (s - 1) * 2 * Complex.exp (s * (θ₀ : ℂ) / 2) *
              Xi1 (kaiMFConeZcan K t l η s) *
              ((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
                  kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
              Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 *
                Real.log Real.pi : ℝ) : ℂ) * s) *
              (∏ w : NumberField.InfinitePlace K, ((kaiMFConeAlpha K w : ℝ) : ℂ)) *
              s ^ (Fintype.card (NumberField.InfinitePlace K) - 1) *
              ((∏ w : NumberField.InfinitePlace K,
                (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + 1))⁻¹) * PP))
          from by ring, hcancel, mul_one]
        have hspow : ‖s ^ (Fintype.card (NumberField.InfinitePlace K) - 1)‖
            ≤ (4 * (1 + |s.im|)) ^ (Fintype.card (NumberField.InfinitePlace K) - 1) := by
          rw [norm_pow]
          exact pow_le_pow_left₀ (norm_nonneg s) hsn _
        have c1 := hmul _ _ _ _ (le_refl ‖δ‖) hs1n
        have c2 := hmul _ _ _ _ c1 (show ‖(2 : ℂ)‖ ≤ 2 by norm_num)
        have c3 := hmul _ _ _ _ c2 hCTHa
        have c4 := hmul _ _ _ _ c3 hXi1s'
        have c5 := hmul _ _ _ _ c4 hCQb
        have c6 := hmul _ _ _ _ c5 hCEs
        have c7 := hmul _ _ _ _ c6 hCALb
        have c8 := hmul _ _ _ _ c7 hspow
        have c9 := hmul _ _ _ _ (le_refl ‖ee‖) c8
        refine le_trans c9 ?_
        rw [show ‖ee‖ * (‖δ‖ * (5 * (1 + |s.im|)) * 2 * CTH * CX * CQ * CE * CAL *
              (4 * (1 + |s.im|)) ^ (Fintype.card (NumberField.InfinitePlace K) - 1))
            = ‖ee‖ * (‖δ‖ * 5 * 2 * CTH * CX * CQ * CE * CAL *
              4 ^ (Fintype.card (NumberField.InfinitePlace K) - 1)) *
              (1 + |s.im|) ^ (Fintype.card (NumberField.InfinitePlace K) - 1 + 1) from by
          rw [mul_pow]; ring]
        exact hfin _ M3 _ (by rw [hM3]; exact le_max_right _ _) hM30 (by omega)
    linarith [hA, hB, hC]
  refine ⟨max (M1 + M2 + M3) ((NN : ℝ)) + 1, ?_, ?_⟩
  · have h2 := le_max_left (M1 + M2 + M3) ((NN : ℝ))
    linarith
  · intro s hs1 hs2
    have hta : (0 : ℝ) ≤ |s.im| := abs_nonneg _
    refine le_trans (hmain s hs1 hs2) ?_
    have hpow : (1 + |s.im|) ^ NN ≤ Real.exp ((NN : ℝ) * (1 + |s.im|)) := by
      have h1 : (1 : ℝ) + |s.im| ≤ Real.exp (1 + |s.im|) := by
        linarith [Real.add_one_le_exp (1 + |s.im|)]
      calc (1 + |s.im|) ^ NN ≤ Real.exp (1 + |s.im|) ^ NN :=
            pow_le_pow_left₀ (by linarith) h1 NN
        _ = Real.exp ((NN : ℝ) * (1 + |s.im|)) := (Real.exp_nat_mul (1 + |s.im|) NN).symm
    have hM0 : (0 : ℝ) ≤ M1 + M2 + M3 := by linarith
    have hCaM : M1 + M2 + M3 ≤ max (M1 + M2 + M3) ((NN : ℝ)) + 1 := by
      linarith [le_max_left (M1 + M2 + M3) ((NN : ℝ))]
    have hCaN : (NN : ℝ) ≤ max (M1 + M2 + M3) ((NN : ℝ)) + 1 := by
      linarith [le_max_right (M1 + M2 + M3) ((NN : ℝ))]
    have hCa0 : (0 : ℝ) ≤ max (M1 + M2 + M3) ((NN : ℝ)) + 1 := by linarith
    calc (M1 + M2 + M3) * (1 + |s.im|) ^ NN
        ≤ (M1 + M2 + M3) * Real.exp ((NN : ℝ) * (1 + |s.im|)) :=
          mul_le_mul_of_nonneg_left hpow hM0
      _ ≤ (max (M1 + M2 + M3) ((NN : ℝ)) + 1) *
            Real.exp ((max (M1 + M2 + M3) ((NN : ℝ)) + 1) * (1 + |s.im|)) := by
          refine mul_le_mul hCaM (Real.exp_le_exp.mpr ?_) (Real.exp_nonneg _) hCa0
          exact mul_le_mul_of_nonneg_right hCaN (by linarith)

theorem kai_mf_cone_edge_bound {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q b : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0) (hb : b ≠ 0)
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (htr : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0)
    (B A : ℝ) (hB : 1 ≤ B)
    (hA : A = max 1 ((3 / 2) * 2 ^ (NumberField.InfinitePlace.nrRealPlaces K) *
      B ^ (3 * (Module.finrank ℚ K : ℝ) / 4 + 5 / 2)
      + (Module.finrank ℚ K : ℝ) + (3 / 2) * B + 3))
    (Gc Lam' Rr Pf : ℂ → ℂ) (κ : ℂ) (wq : ℕ) (hwq : 0 < wq)
    (r : NumberField.InfinitePlace K → ℝ) (hr0 : ∀ w, 0 < r w)
    (hrB : ∀ w, 1 / B ≤ r w ∧ r w ≤ B)
    (hκ2 : ‖κ‖ * (∏ w : NumberField.InfinitePlace K,
        r w ^ (-(kaiHZDeg K η l w / 2))) ≤ B * (Ideal.absNorm (q * b) : ℝ) ^ B)
    (hPf : ∀ s : ℂ, Pf s =
      ((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
          kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
        Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 * Real.log Real.pi : ℝ) : ℂ) * s) *
        ∏ w : NumberField.InfinitePlace K,
          (Complex.Gamma (kaiMFConeZcan K t l η s w))⁻¹)
    (hRr : ∀ s : ℂ, Rr s = Complex.exp (-∑ w : NumberField.InfinitePlace K,
        kaiMFConeZdual K t l η (1 - s) w * ((Real.log (r w) : ℝ) : ℂ)))
    (hGc : ∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
        Gc s = (s - 1) * (κ * Rr s) * Lam' (1 - s) * Pf s)
    (hLam' : ∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
        ‖Lam' (1 - s)‖ ≤ (wq : ℝ) *
          Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) / 2) *
          ((Ideal.absNorm q : ℝ) *
            2 ^ (NumberField.InfinitePlace.nrRealPlaces K)) *
          (B * (Ideal.absNorm (q * b) : ℝ) ^ B) ^ ((3 : ℝ) / 2) *
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                (-((3 : ℝ) / 2))) *
          ∏ w : NumberField.InfinitePlace K,
            ‖Complex.Gamma (kaiMFConeZdual K t l η (1 - s) w)‖)
    (hGid : (∀ z : ℂ, (Complex.Gamma z)⁻¹ = z * (Complex.Gamma (z + 1))⁻¹) ∧
      (∀ (z : ℂ) (m : ℕ), 0 < z.re → Complex.Gamma (z + (m : ℂ))
          = (∏ j ∈ Finset.range m, (z + (j : ℂ))) * Complex.Gamma z) ∧
      (∀ z : ℂ, ‖Complex.Gamma ((starRingEnd ℂ) z)‖ = ‖Complex.Gamma z‖) ∧
      (∀ (z : ℂ) (m : ℕ), (1 : ℝ) / 2 ≤ z.re →
          ‖Complex.Gamma z * (Complex.Gamma (z + (m : ℂ)))⁻¹‖ ≤ 2 ^ m) ∧
      (∀ (z : ℂ) (m : ℕ), (Complex.Gamma z)⁻¹
          = (∏ j ∈ Finset.range m, (z + (j : ℂ))) * (Complex.Gamma (z + (m : ℂ)))⁻¹)) :
    ∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
      ‖Gc s‖ ≤ A * ((Ideal.absNorm q : ℝ) * (Ideal.absNorm b : ℝ) *
          (1 + kaiHZInfSize K t l) * (2 + |s.im|)) ^ A *
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
