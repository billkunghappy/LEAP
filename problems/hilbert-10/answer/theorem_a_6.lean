      exact mul_le_mul_of_nonneg_left h2 (le_of_lt hN0)
    have hρ4 : ∀ w : NumberField.InfinitePlace K, 4 * R' ≤ ρ w :=
      fun w => le_trans (le_of_lt hNa) (hρNa w)
    have hρ0 : ∀ w : NumberField.InfinitePlace K, 0 < ρ w :=
      fun w => lt_of_lt_of_le (by linarith) (hρ4 w)
    obtain ⟨x, hx1, hx0, hxpos, hxmod, hxarg⟩ := happrox ρ φ hρ4
    have hlogρ : ∀ w : NumberField.InfinitePlace K,
        Real.log (ρ w) = Real.log N + c w := by
      intro w
      simp only [hρdef]
      rw [Real.log_mul (ne_of_gt hN0) (ne_of_gt (Real.exp_pos (c w))), Real.log_exp]
    obtain ⟨Lw, hLwdef⟩ : ∃ Lw : NumberField.InfinitePlace K → ℝ,
