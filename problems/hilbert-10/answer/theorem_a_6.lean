        ‖kaiHZArchWeight K η l (ρ + NumberField.mixedEmbedding K
            ((μ : NumberField.RingOfIntegers K) : K))‖ *
          kaiHZGaussian K y (ρ + NumberField.mixedEmbedding K
            ((μ : NumberField.RingOfIntegers K) : K)))) :
    Measurable (fun u : NumberField.InfinitePlace K → ℝ =>
        (kaiHZIdealTheta K a ρ η l (fun w => Real.exp (u w)) - δ) *
          kaiMFConeWeight K g u) ∧
    ∃ e₀ : ℝ, 0 < e₀ ∧
      ∀ u : NumberField.InfinitePlace K → ℝ, θ ≤ kaiMFLogNorm K u →
        (∀ w : NumberField.InfinitePlace K,
            |u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)| ≤ c) →
