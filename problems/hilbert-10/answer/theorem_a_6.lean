            * (((Algebra.norm ℤ x).natAbs : ℝ) ^ (Dt.2.2 - 1)) : ℝ) : ℂ) * Φ x
          = ((ρ * q : ℝ) : ℂ) * (∑ x ∈ omegaBox ω M, ((w (Algebra.norm ℤ x).natAbs : ℝ) : ℂ)
              * ((Dt.2.1 x : ℤ) : ℂ) * Φ x * S x
            + ∑ x ∈ omegaBox ω M, e x * (((w (Algebra.norm ℤ x).natAbs : ℝ) : ℂ)
              * ((Dt.2.1 x : ℤ) : ℂ) * Φ x)) := by
        rw [← Finset.sum_add_distrib, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        have hwx : w (Algebra.norm ℤ x).natAbs
            = ((Algebra.norm ℤ x).natAbs : ℝ) ^ (Dt.2.2 - 1) := by rw [hw_def]
        have e1 : ((cramerModel K ρ (primorial m) x * ((Dt.2.1 x : ℤ) : ℝ)
            * (((Algebra.norm ℤ x).natAbs : ℝ) ^ (Dt.2.2 - 1)) : ℝ) : ℂ)
            = ((cramerModel K ρ (primorial m) x : ℝ) : ℂ) * ((Dt.2.1 x : ℤ) : ℂ)
              * ((((Algebra.norm ℤ x).natAbs : ℝ) ^ (Dt.2.2 - 1) : ℝ) : ℂ) := by
          push_cast; ring
        rw [hwx, e1, hcm x, hsplit x]
        ring
      rw [hsum, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hρq0]
      exact mul_le_mul_of_nonneg_left
        ((norm_add_le _ _).trans (add_le_add hC2' (herrΦ _ hg))) hρq0
  
  have hsq0 : 0 ≤ Real.sqrt ℓ := Real.sqrt_nonneg _
  have hsqsq : Real.sqrt ℓ * Real.sqrt ℓ = ℓ := Real.mul_self_sqrt hℓ0
  have hsq4 : 4 ≤ Real.sqrt ℓ := by
    have h := Real.sqrt_le_sqrt hℓ16
    rwa [show (16 : ℝ) = 4 ^ 2 by norm_num, Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 4)] at h
  have hsqℓ : Real.sqrt ℓ ≤ ℓ / 2 := by
    have := mul_le_mul_of_nonneg_right (show (2 : ℝ) ≤ Real.sqrt ℓ by linarith) hsq0
    linarith
  have hℓn : ℓ ≤ ℓ ^ Module.finrank ℚ K := le_self_pow₀ hℓ1 (by omega)
  have hℓn0 : 0 ≤ ℓ ^ Module.finrank ℚ K := pow_nonneg hℓ0 _
  have hF1 : ℓ * Real.exp (-(ℓ / 2)) ≤ ℓ ^ Module.finrank ℚ K * Real.exp (-Real.sqrt ℓ) :=
    mul_le_mul hℓn (Real.exp_le_exp.mpr (by linarith)) (Real.exp_pos _).le hℓn0
  have hF2 : ℓ ^ Module.finrank ℚ K * Real.exp (-Real.sqrt ℓ)
      ≤ G * Real.exp (-(Real.sqrt ℓ / K₀)) := by
    have hpf := Real.pow_div_factorial_le_exp (Real.sqrt ℓ / 2) (by positivity)
      (2 * Module.finrank ℚ K)
    have hpow : (Real.sqrt ℓ / 2) ^ (2 * Module.finrank ℚ K)
        = ℓ ^ Module.finrank ℚ K / (4 : ℝ) ^ Module.finrank ℚ K := by
      rw [pow_mul, div_pow, Real.sq_sqrt hℓ0, div_pow]; norm_num
    rw [hpow] at hpf
    have h4 : (0 : ℝ) < (4 : ℝ) ^ Module.finrank ℚ K := by positivity
    have hℓG : ℓ ^ Module.finrank ℚ K ≤ G * Real.exp (Real.sqrt ℓ / 2) := by
      rw [div_div, div_le_iff₀ (mul_pos h4 hfac0)] at hpf
      rw [hG_def]; linarith
    have hexpK : Real.exp (-(Real.sqrt ℓ / 2)) ≤ Real.exp (-(Real.sqrt ℓ / K₀)) := by
      apply Real.exp_le_exp.mpr
      have := div_le_div_of_nonneg_left hsq0 (by norm_num : (0 : ℝ) < 2) hK₀2
      linarith
    calc ℓ ^ Module.finrank ℚ K * Real.exp (-Real.sqrt ℓ)
        ≤ G * Real.exp (Real.sqrt ℓ / 2) * Real.exp (-Real.sqrt ℓ) :=
          mul_le_mul_of_nonneg_right hℓG (Real.exp_pos _).le
      _ = G * Real.exp (-(Real.sqrt ℓ / 2)) := by
          rw [mul_assoc, ← Real.exp_add]; congr 2; ring
      _ ≤ G * Real.exp (-(Real.sqrt ℓ / K₀)) := mul_le_mul_of_nonneg_left hexpK (by linarith)
  
  obtain ⟨Z, hZ_def⟩ : ∃ Z : ℝ, Z = T * Bc * Real.exp (-(Real.sqrt ℓ / K₀)) := ⟨_, rfl⟩
  have hTB0 : 0 ≤ T * Bc := mul_nonneg hT hB0
  have hZ0 : 0 ≤ Z := by rw [hZ_def]; exact mul_nonneg hTB0 (Real.exp_pos _).le
  have hXZ : X ≤ G * Z := by
    rw [hX_def, hZ_def]
    calc T * Bc * (ℓ * Real.exp (-(ℓ / 2))) ≤ T * Bc * (G * Real.exp (-(Real.sqrt ℓ / K₀))) :=
          mul_le_mul_of_nonneg_left (hF1.trans hF2) hTB0
      _ = G * (T * Bc * Real.exp (-(Real.sqrt ℓ / K₀))) := by ring
  obtain ⟨Wt, hWt_def⟩ : ∃ Wt : ℝ, Wt = T * (Bc * Real.exp (-Real.sqrt ℓ)) := ⟨_, rfl⟩
  have hWt0 : 0 ≤ Wt := by
    rw [hWt_def]; exact mul_nonneg hT (mul_nonneg hB0 (Real.exp_pos _).le)
  have hWZ : ℓ ^ Module.finrank ℚ K * Wt ≤ G * Z := by
    rw [hZ_def, hWt_def]
    calc ℓ ^ Module.finrank ℚ K * (T * (Bc * Real.exp (-Real.sqrt ℓ)))
        = T * Bc * (ℓ ^ Module.finrank ℚ K * Real.exp (-Real.sqrt ℓ)) := by ring
      _ ≤ T * Bc * (G * Real.exp (-(Real.sqrt ℓ / K₀))) := mul_le_mul_of_nonneg_left hF2 hTB0
      _ = G * (T * Bc * Real.exp (-(Real.sqrt ℓ / K₀))) := by ring
  rw [← hWt_def] at hPartB hPartC
  have hτn : ℓ * τ ≤ ℓ ^ Module.finrank ℚ K * τ := mul_le_mul_of_nonneg_right hℓn hτ
  have hKAX : KA * X ≤ KA * (G * Z) := mul_le_mul_of_nonneg_left hXZ hKA0
  have hQW : Q * (ℓ ^ Module.finrank ℚ K * Wt) ≤ Q * (G * Z) :=
    mul_le_mul_of_nonneg_left hWZ hQ0
  have hB' : ρ * q * (τ + Wt) ≤ Q * ℓ ^ Module.finrank ℚ K * (τ + Wt) :=
    mul_le_mul_of_nonneg_right hρq (by linarith)
  have hC' : ρ * q * (2 * τ + Wt) ≤ Q * ℓ ^ Module.finrank ℚ K * (2 * τ + Wt) :=
    mul_le_mul_of_nonneg_right hρq (by linarith)
  have hP0 : 0 ≤ ℓ ^ Module.finrank ℚ K * τ := mul_nonneg hℓn0 hτ
  have hK1 : (6 * (Module.finrank ℚ K : ℝ) + 3 * Q) * (ℓ ^ Module.finrank ℚ K * τ)
      ≤ K₀ * (ℓ ^ Module.finrank ℚ K * τ) :=
    mul_le_mul_of_nonneg_right (by rw [hK₀_def]; linarith) hP0
  have hK2 : (KA + 2 * Q) * G * Z ≤ K₀ * Z :=
    mul_le_mul_of_nonneg_right (by rw [hK₀_def]; linarith) hZ0
  have hQP : 0 ≤ Q * (ℓ ^ Module.finrank ℚ K * τ) := mul_nonneg hQ0 hP0
  have hQGZ : 0 ≤ Q * G * Z := mul_nonneg (mul_nonneg hQ0 (by linarith)) hZ0
  have hnℓτ : 6 * (Module.finrank ℚ K : ℝ) * ℓ * τ
      ≤ 6 * (Module.finrank ℚ K : ℝ) * (ℓ ^ Module.finrank ℚ K * τ) := by
    have := mul_le_mul_of_nonneg_left hτn (show (0 : ℝ) ≤ 6 * Module.finrank ℚ K by linarith)
    linarith
  have hsplitA : ∑ x ∈ omegaBox ω M,
      ((vonMangoldtO x - cramerModel K ρ (primorial m) x : ℝ) : ℂ) * Φ x
      = ∑ x ∈ omegaBox ω M, ((vonMangoldtO x : ℝ) : ℂ) * Φ x
        - ∑ x ∈ omegaBox ω M, ((cramerModel K ρ (primorial m) x : ℝ) : ℂ) * Φ x := by
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    push_cast; ring
  have hmainA : ‖∑ x ∈ omegaBox ω M,
      ((vonMangoldtO x - cramerModel K ρ (primorial m) x : ℝ) : ℂ) * Φ x‖
      ≤ 6 * (Module.finrank ℚ K : ℝ) * ℓ * τ + KA * X + ρ * q * (τ + Wt) := by
    rw [hsplitA]
    exact (norm_sub_le _ _).trans (add_le_add hPartA hPartB)
  rw [← hℓ, ← hBc_def]
  have hZ' : K₀ * T * Bc * Real.exp (-(Real.sqrt ℓ / K₀)) = K₀ * Z := by rw [hZ_def]; ring
  rw [hZ']
  refine ⟨?_, ?_⟩
  · refine hmainA.trans ?_
    linarith [hnℓτ, hKAX, hB', hQW, hK1, hK2, hQP, hQGZ]
  · intro hTw
    have hsplitB : ∑ x ∈ omegaBox ω M,
        ((vonMangoldtO x - siegelModel K ρ (primorial m) Dt.2.1 Dt.2.2 x : ℝ) : ℂ) * Φ x
        = ∑ x ∈ omegaBox ω M,
            ((vonMangoldtO x - cramerModel K ρ (primorial m) x : ℝ) : ℂ) * Φ x
          + ∑ x ∈ omegaBox ω M, ((cramerModel K ρ (primorial m) x * ((Dt.2.1 x : ℤ) : ℝ)
              * (((Algebra.norm ℤ x).natAbs : ℝ) ^ (Dt.2.2 - 1)) : ℝ) : ℂ) * Φ x := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      simp only [siegelModel]; push_cast; ring
    rw [hsplitB]
    have hCC := hPartC hTw
    have htot := (norm_add_le _ _).trans (add_le_add hmainA hCC)
    refine htot.trans ?_
    linarith [hnℓτ, hKAX, hB', hC', hQW, hK1, hK2, hQP, hQGZ]

theorem kai_v_si_short_element (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ C_e : ℝ, 1 ≤ C_e ∧ ∀ 𝔞 : Ideal (NumberField.RingOfIntegers K), 𝔞 ≠ ⊥ →
      ∃ e : NumberField.RingOfIntegers K, e ∈ 𝔞 ∧ e ≠ 0 ∧
        basisSupNorm ω e ≤ C_e * (Ideal.absNorm 𝔞 : ℝ) ^ ((1 : ℝ) / (Module.finrank ℚ K : ℝ)) ∧
        ((Algebra.norm ℤ e).natAbs : ℝ) ≤ C_e * (Ideal.absNorm 𝔞 : ℝ) ∧
        ∀ w : NumberField.InfinitePlace K,
          (Ideal.absNorm 𝔞 : ℝ) ^ ((1 : ℝ) / (Module.finrank ℚ K : ℝ)) ≤ C_e * w (e : K) :=
by
  classical
  have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hC : 1 < C := hω.1
  have hC0 : 0 ≤ C := by linarith
  
  have hs3 : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (e : NumberField.RingOfIntegers K),
      e ∈ 𝔞 → e ≠ 0 → (Ideal.absNorm 𝔞 : ℝ) ≤ ((Algebra.norm ℤ e).natAbs : ℝ) := by
    intro 𝔞 e he he0
    have hle : Ideal.span {e} ≤ 𝔞 := (Ideal.span_singleton_le_iff_mem _).2 he
    have hdvd := Ideal.absNorm_dvd_absNorm_of_le hle
    have hspan0 : Ideal.absNorm (Ideal.span {e}) ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff, Ideal.span_singleton_eq_bot]; exact he0
    rw [Ideal.absNorm_span_singleton] at hdvd hspan0
    exact_mod_cast Nat.le_of_dvd (Nat.pos_of_ne_zero hspan0) hdvd
  
  have hs2 : ∀ x : NumberField.RingOfIntegers K,
      (∀ w : NumberField.InfinitePlace K, w (x : K) ≤ C * basisSupNorm ω x) ∧
      ((Algebra.norm ℤ x).natAbs : ℝ) ≤ (C * basisSupNorm ω x) ^ Module.finrank ℚ K ∧
      ∀ w : NumberField.InfinitePlace K, ((Algebra.norm ℤ x).natAbs : ℝ)
        ≤ w (x : K) * (C * basisSupNorm ω x) ^ (Module.finrank ℚ K - 1) := by
    intro x
    have hbs0 : 0 ≤ basisSupNorm ω x := Real.iSup_nonneg (fun j => abs_nonneg _)
    have hU0 : 0 ≤ C * basisSupNorm ω x := mul_nonneg hC0 hbs0
    have hle : ∀ w : NumberField.InfinitePlace K, w (x : K) ≤ C * basisSupNorm ω x := by
      intro w
      have h1 : w (algebraMap (NumberField.RingOfIntegers K) K x)
          ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) :=
        le_ciSup (f := fun w : NumberField.InfinitePlace K =>
          w (algebraMap (NumberField.RingOfIntegers K) K x)) (Set.finite_range _).bddAbove w
      exact h1.trans (hω.2 x).2
    have hcast : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) = ∏ w : NumberField.InfinitePlace K,
        w (x : K) ^ w.mult := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs, Rat.cast_abs]
      congr 1
      have hn := Algebra.coe_norm_int x
      rw [← hn]
      simp
    refine ⟨hle, ?_, ?_⟩
    · rw [hcast]
      calc ∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult
          ≤ ∏ w : NumberField.InfinitePlace K, (C * basisSupNorm ω x) ^ w.mult :=
            Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w _) _)
              (fun w _ => pow_le_pow_left₀ (apply_nonneg w _) (hle w) _)
        _ = (C * basisSupNorm ω x) ^ Module.finrank ℚ K := by
            rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    · intro w₀
      rw [hcast, ← Finset.mul_prod_erase Finset.univ (fun w : NumberField.InfinitePlace K =>
        w (x : K) ^ w.mult) (Finset.mem_univ w₀)]
      have hsum : w₀.mult + ∑ w ∈ Finset.univ.erase w₀, w.mult = Module.finrank ℚ K := by
        rw [Finset.add_sum_erase _ _ (Finset.mem_univ w₀), NumberField.InfinitePlace.sum_mult_eq]
      have hm0 : 0 < w₀.mult := NumberField.InfinitePlace.mult_pos
      have hrest : ∏ w ∈ Finset.univ.erase w₀, w (x : K) ^ w.mult
          ≤ (C * basisSupNorm ω x) ^ (∑ w ∈ Finset.univ.erase w₀, w.mult) := by
        rw [← Finset.prod_pow_eq_pow_sum]
        exact Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w _) _)
          (fun w _ => pow_le_pow_left₀ (apply_nonneg w _) (hle w) _)
      have hv0 : 0 ≤ w₀ (x : K) := apply_nonneg _ _
      have hfirst : w₀ (x : K) ^ w₀.mult
          ≤ w₀ (x : K) * (C * basisSupNorm ω x) ^ (w₀.mult - 1) := by
        have hsp : w₀ (x : K) ^ w₀.mult = w₀ (x : K) * w₀ (x : K) ^ (w₀.mult - 1) := by
          rw [← pow_succ']; congr 1; omega
        rw [hsp]
        exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hv0 (hle w₀) _) hv0
      have hexp : (C * basisSupNorm ω x) ^ (Module.finrank ℚ K - 1)
          = (C * basisSupNorm ω x) ^ (w₀.mult - 1)
            * (C * basisSupNorm ω x) ^ (∑ w ∈ Finset.univ.erase w₀, w.mult) := by
        rw [← pow_add]; congr 1; omega
      rw [hexp]
      calc w₀ (x : K) ^ w₀.mult * ∏ w ∈ Finset.univ.erase w₀, w (x : K) ^ w.mult
          ≤ (w₀ (x : K) * (C * basisSupNorm ω x) ^ (w₀.mult - 1))
              * (C * basisSupNorm ω x) ^ (∑ w ∈ Finset.univ.erase w₀, w.mult) :=
            mul_le_mul hfirst hrest
              (Finset.prod_nonneg (fun w _ => pow_nonneg (apply_nonneg w _) _))
              (mul_nonneg hv0 (pow_nonneg hU0 _))
        _ = _ := by ring
  
  have hs1 : ∀ 𝔞 : Ideal (NumberField.RingOfIntegers K), 𝔞 ≠ ⊥ →
      ∃ e : NumberField.RingOfIntegers K, e ∈ 𝔞 ∧ e ≠ 0 ∧
        basisSupNorm ω e ≤ 2 * (Ideal.absNorm 𝔞 : ℝ) ^ ((1 : ℝ) / (Module.finrank ℚ K : ℝ)) := by
    intro 𝔞 h𝔞
    have hN0 : Ideal.absNorm 𝔞 ≠ 0 := by rwa [Ne, Ideal.absNorm_eq_zero_iff]
    have hN1 : (1 : ℝ) ≤ (Ideal.absNorm 𝔞 : ℝ) := by
      exact_mod_cast Nat.one_le_iff_ne_zero.2 hN0
    obtain ⟨α, hα⟩ : ∃ α : ℝ,
        α = (Ideal.absNorm 𝔞 : ℝ) ^ ((1 : ℝ) / (Module.finrank ℚ K : ℝ)) := ⟨_, rfl⟩
    rw [← hα]
    have hα1 : 1 ≤ α := by rw [hα]; exact Real.one_le_rpow hN1 (by positivity)
    have hαn : α ^ Module.finrank ℚ K = (Ideal.absNorm 𝔞 : ℝ) := by
      rw [hα, one_div, Real.rpow_inv_natCast_pow (by positivity) hn.ne']
    obtain ⟨t, ht⟩ : ∃ t : ℕ, t = ⌈α⌉₊ := ⟨_, rfl⟩
    have hαt : α ≤ t := by rw [ht]; exact Nat.le_ceil α
    have htα : (t : ℝ) < α + 1 := by rw [ht]; exact Nat.ceil_lt_add_one (by linarith)
    have hNt : Ideal.absNorm 𝔞 < (t + 1) ^ Module.finrank ℚ K := by
      have h1 : (Ideal.absNorm 𝔞 : ℝ) ≤ (t : ℝ) ^ Module.finrank ℚ K := by
        rw [← hαn]; exact pow_le_pow_left₀ (by linarith) hαt _
      have h2 : Ideal.absNorm 𝔞 ≤ t ^ Module.finrank ℚ K := by exact_mod_cast h1
      exact lt_of_le_of_lt h2 (Nat.pow_lt_pow_left (Nat.lt_succ_self t) hn.ne')
    haveI : Finite (NumberField.RingOfIntegers K ⧸ 𝔞) := Ideal.finiteQuotientOfFreeOfNeBot 𝔞 h𝔞
    have hcard : Nat.card (NumberField.RingOfIntegers K ⧸ 𝔞) = Ideal.absNorm 𝔞 := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    let f : (Fin (Module.finrank ℚ K) → Fin (t + 1)) → NumberField.RingOfIntegers K ⧸ 𝔞 :=
      fun c => Ideal.Quotient.mk 𝔞 (ω.equivFun.symm (fun j => ((c j : ℕ) : ℤ)))
    have hninj : ¬ Function.Injective f := by
      intro hinj
      have hle := Nat.card_le_card_of_injective f hinj
      rw [hcard, Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fin,
        Fintype.card_fin] at hle
      omega
    simp only [Function.Injective, not_forall] at hninj
    obtain ⟨c, c', hcc, hne⟩ := hninj
    refine ⟨ω.equivFun.symm (fun j => ((c j : ℕ) : ℤ) - ((c' j : ℕ) : ℤ)), ?_, ?_, ?_⟩
    · have hsub : ω.equivFun.symm (fun j => ((c j : ℕ) : ℤ) - ((c' j : ℕ) : ℤ)) =
          ω.equivFun.symm (fun j => ((c j : ℕ) : ℤ))
            - ω.equivFun.symm (fun j => ((c' j : ℕ) : ℤ)) := by
        rw [← map_sub]; rfl
      rw [hsub, ← Ideal.Quotient.eq]; exact hcc
    · intro h0
      apply hne
      have hv := (LinearEquiv.map_eq_zero_iff _).1 h0
      funext j
      have hj := congrFun hv j
      simp only [Pi.zero_apply] at hj
      exact Fin.ext (by omega)
    · unfold basisSupNorm
      refine Real.iSup_le (fun j => ?_) (by linarith)
      have hrepr : ω.repr (ω.equivFun.symm (fun j => ((c j : ℕ) : ℤ) - ((c' j : ℕ) : ℤ))) j
          = ((c j : ℕ) : ℤ) - ((c' j : ℕ) : ℤ) := by
        rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
      rw [hrepr]
      have h1 : (c j : ℕ) ≤ t := Nat.lt_succ_iff.mp (c j).isLt
      have h2 : (c' j : ℕ) ≤ t := Nat.lt_succ_iff.mp (c' j).isLt
      have habs : |((c j : ℕ) : ℤ) - ((c' j : ℕ) : ℤ)| ≤ (t : ℤ) := abs_le.2 ⟨by omega, by omega⟩
      have h3 : |((((c j : ℕ) : ℤ) - ((c' j : ℕ) : ℤ) : ℤ) : ℝ)| ≤ (t : ℝ) := by
        rw [← Int.cast_abs]; exact_mod_cast habs
      linarith
  
  have h2C : 1 ≤ 2 * C := by linarith
  refine ⟨(2 * C) ^ Module.finrank ℚ K, one_le_pow₀ h2C, ?_⟩
  intro 𝔞 h𝔞
  obtain ⟨e, he, he0, hB⟩ := hs1 𝔞 h𝔞
  have hN0 : Ideal.absNorm 𝔞 ≠ 0 := by rwa [Ne, Ideal.absNorm_eq_zero_iff]
  have hN1 : (1 : ℝ) ≤ (Ideal.absNorm 𝔞 : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.2 hN0
  obtain ⟨α, hα⟩ : ∃ α : ℝ,
      α = (Ideal.absNorm 𝔞 : ℝ) ^ ((1 : ℝ) / (Module.finrank ℚ K : ℝ)) := ⟨_, rfl⟩
  rw [← hα] at hB ⊢
  have hα1 : 1 ≤ α := by rw [hα]; exact Real.one_le_rpow hN1 (by positivity)
  have hαn : α ^ Module.finrank ℚ K = (Ideal.absNorm 𝔞 : ℝ) := by
    rw [hα, one_div, Real.rpow_inv_natCast_pow (by positivity) hn.ne']
  obtain ⟨_, hnorm, hplace⟩ := hs2 e
  have hNe := hs3 𝔞 e he he0
  have hbs0 : 0 ≤ basisSupNorm ω e := Real.iSup_nonneg (fun j => abs_nonneg _)
  have hU0 : 0 ≤ C * basisSupNorm ω e := mul_nonneg hC0 hbs0
  have hUle : C * basisSupNorm ω e ≤ 2 * C * α := by
    have := mul_le_mul_of_nonneg_left hB hC0
    linarith
  refine ⟨e, he, he0, ?_, ?_, ?_⟩
  · have h2 : 2 ≤ (2 * C) ^ Module.finrank ℚ K :=
      (by linarith : (2 : ℝ) ≤ 2 * C).trans (le_self_pow₀ h2C hn.ne')
    have := mul_le_mul_of_nonneg_right h2 (by linarith : (0 : ℝ) ≤ α)
    linarith
  · calc ((Algebra.norm ℤ e).natAbs : ℝ) ≤ (C * basisSupNorm ω e) ^ Module.finrank ℚ K := hnorm
      _ ≤ (2 * C * α) ^ Module.finrank ℚ K := pow_le_pow_left₀ hU0 hUle _
      _ = (2 * C) ^ Module.finrank ℚ K * (Ideal.absNorm 𝔞 : ℝ) := by rw [mul_pow, hαn]
  · intro w
    have hv0 : 0 ≤ w (e : K) := apply_nonneg _ _
    have hαpos : 0 < α ^ (Module.finrank ℚ K - 1) := pow_pos (by linarith) _
    have hsplit : α ^ Module.finrank ℚ K = α * α ^ (Module.finrank ℚ K - 1) := by
      rw [← pow_succ']; congr 1; omega
    have key : α * α ^ (Module.finrank ℚ K - 1)
        ≤ (w (e : K) * (2 * C) ^ (Module.finrank ℚ K - 1)) * α ^ (Module.finrank ℚ K - 1) := by
      calc α * α ^ (Module.finrank ℚ K - 1) = (Ideal.absNorm 𝔞 : ℝ) := by rw [← hsplit, hαn]
        _ ≤ ((Algebra.norm ℤ e).natAbs : ℝ) := hNe
        _ ≤ w (e : K) * (C * basisSupNorm ω e) ^ (Module.finrank ℚ K - 1) := hplace w
        _ ≤ w (e : K) * (2 * C * α) ^ (Module.finrank ℚ K - 1) :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hU0 hUle _) hv0
        _ = (w (e : K) * (2 * C) ^ (Module.finrank ℚ K - 1)) * α ^ (Module.finrank ℚ K - 1) := by
            rw [mul_pow]; ring
    have h1 : α ≤ w (e : K) * (2 * C) ^ (Module.finrank ℚ K - 1) :=
      le_of_mul_le_mul_right key hαpos
    have h2 : (2 * C) ^ (Module.finrank ℚ K - 1) ≤ (2 * C) ^ Module.finrank ℚ K :=
      pow_le_pow_right₀ h2C (Nat.sub_le _ _)
    have := mul_le_mul_of_nonneg_left h2 hv0
    linarith

theorem kai_v_si_coset_pigeonhole (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M Q Y : ℝ) (Φ χ : NumberField.RingOfIntegers K → ℂ)
    (𝔡 𝔮 : Ideal (NumberField.RingOfIntegers K)) (e : NumberField.RingOfIntegers K)
    (hQ : 0 ≤ Q) (he𝔡 : e ∈ 𝔡) (he𝔮 : e ∈ 𝔮) (he : e ≠ 0)
    (hΦ : ∀ x, ‖Φ x‖ ≤ Q) (hχ : ∀ x, ‖χ x‖ ≤ 1)
    (hχc : ∀ x₁ x₂ : NumberField.RingOfIntegers K, x₁ - x₂ ∈ 𝔮 →
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x₁ : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw (x₂ : K)) → χ x₁ = χ x₂) :
    ∃ (x₀ : NumberField.RingOfIntegers K) (o : KaiPattern K), x₀ ∈ omegaBox ω M ∧
      ‖kaiTypeIInner ω M Φ χ 𝔡 Y‖ - Q ≤
        2 ^ Module.finrank ℚ K * (((Algebra.norm ℤ e).natAbs : ℝ) / (Ideal.absNorm 𝔡 : ℝ)) *
          (‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
              (fun x => x - x₀ ∈ Ideal.span {e} ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y ∧
                kaiPatt o x)
              (fun _ => Classical.propDecidable _) (omegaBox ω M), Φ x‖ + Q) :=
by
  classical
  
  have hIle𝔡 : Ideal.span {e} ≤ 𝔡 := (Ideal.span_singleton_le_iff_mem 𝔡).mpr he𝔡
  have hIle𝔮 : Ideal.span {e} ≤ 𝔮 := (Ideal.span_singleton_le_iff_mem 𝔮).mpr he𝔮
  have h𝔡bot : 𝔡 ≠ ⊥ := by
    intro h
    rw [h] at he𝔡
    exact he ((Submodule.mem_bot _).mp he𝔡)
  have hd0 : (0 : ℝ) < (Ideal.absNorm 𝔡 : ℝ) := by
    have : Ideal.absNorm 𝔡 ≠ 0 := fun h => h𝔡bot (Ideal.absNorm_eq_zero_iff.mp h)
    exact_mod_cast Nat.pos_of_ne_zero this
  have hNe0 : (Algebra.norm ℤ e).natAbs ≠ 0 := by
    rw [← Ideal.absNorm_span_singleton]
    intro h
    exact he (Ideal.span_singleton_eq_bot.mp (Ideal.absNorm_eq_zero_iff.mp h))
  have hNeQ : Nat.card (NumberField.RingOfIntegers K ⧸ Ideal.span {e})
      = (Algebra.norm ℤ e).natAbs := by
    have h := Ideal.absNorm_apply (Ideal.span {e})
    rw [Submodule.cardQuot_apply, Ideal.absNorm_span_singleton] at h
    exact h.symm
  haveI hfin : Finite (NumberField.RingOfIntegers K ⧸ Ideal.span {e}) :=
    Nat.finite_of_card_ne_zero (by rw [hNeQ]; exact hNe0)
  let mk := Submodule.mkQ (Ideal.span {e} : Ideal (NumberField.RingOfIntegers K))
  have hD : Nat.card ↥(Submodule.map mk 𝔡) * Ideal.absNorm 𝔡 = (Algebra.norm ℤ e).natAbs := by
    have h := Submodule.card_quotient_mul_card_quotient 𝔡 (Ideal.span {e}) hIle𝔡
    have h1 := Ideal.absNorm_apply 𝔡
    rw [Submodule.cardQuot_apply] at h1
    rw [h1, ← hNeQ]
    exact h
  
  have hpc : (Finset.univ : Finset (KaiPattern K)).card ≤ 2 ^ Module.finrank ℚ K := by
    rw [Finset.card_univ]
    have h1 := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
    have h2 : Fintype.card (KaiPattern K)
        = 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} := by
      simp [KaiPattern]
    have h3 : Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
        = NumberField.InfinitePlace.nrRealPlaces K := Fintype.card_congr' rfl
    rw [h2, h3]
    exact Nat.pow_le_pow_right (by norm_num) (by omega)
  
  have h0B : (0 : NumberField.RingOfIntegers K) ∈ omegaBox ω M := by
    unfold omegaBox intBox
    rw [Finset.mem_image]
    refine ⟨0, ?_, by simp⟩
    rw [Finset.mem_Icc]
    refine ⟨fun i => ?_, fun i => ?_⟩ <;> simp
  
  obtain ⟨T, hT⟩ : ∃ T : Finset (NumberField.RingOfIntegers K),
      T = (omegaBox ω M).filter (fun x => x ∈ 𝔡 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y) :=
    ⟨_, rfl⟩
  have hS : kaiTypeIInner ω M Φ χ 𝔡 Y = ∑ x ∈ T, χ x * Φ x := by
    unfold kaiTypeIInner
    rw [hT]
  obtain ⟨T', hT'⟩ : ∃ T' : Finset (NumberField.RingOfIntegers K), T' = T.erase 0 := ⟨_, rfl⟩
  have hT'mem : ∀ x, x ∈ T' ↔ x ≠ 0 ∧ x ∈ omegaBox ω M ∧ x ∈ 𝔡 ∧
      ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y := by
    intro x
    rw [hT', hT, Finset.mem_erase, Finset.mem_filter]
  have hS0 : ‖kaiTypeIInner ω M Φ χ 𝔡 Y‖ ≤ Q + ‖∑ x ∈ T', χ x * Φ x‖ := by
    rw [hS, hT']
    by_cases h0 : (0 : NumberField.RingOfIntegers K) ∈ T
    · have hsplit : χ 0 * Φ 0 + ∑ x ∈ T.erase 0, χ x * Φ x = ∑ x ∈ T, χ x * Φ x :=
        Finset.add_sum_erase T (fun x => χ x * Φ x) h0
      rw [← hsplit]
      have h1 : ‖χ 0 * Φ 0‖ ≤ Q := by
        rw [norm_mul]
        calc ‖χ 0‖ * ‖Φ 0‖ ≤ 1 * Q := mul_le_mul (hχ 0) (hΦ 0) (norm_nonneg _) zero_le_one
          _ = Q := one_mul Q
      linarith [norm_add_le (χ 0 * Φ 0) (∑ x ∈ T.erase 0, χ x * Φ x)]
    · rw [Finset.erase_eq_of_notMem h0]
      linarith
  
  let pat : NumberField.RingOfIntegers K → KaiPattern K := fun x w =>
    decide (0 < NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K))
  let κ := fun x : NumberField.RingOfIntegers K => (mk x, pat x)
  have hconst : ∀ x₁ ∈ T', ∀ x₂ ∈ T', κ x₁ = κ x₂ → χ x₁ = χ x₂ := by
    intro x₁ h₁ x₂ h₂ hk
    have hx₁0 : x₁ ≠ 0 := ((hT'mem x₁).mp h₁).1
    have hx₂0 : x₂ ≠ 0 := ((hT'mem x₂).mp h₂).1
    have hk1 : mk x₁ = mk x₂ := congrArg Prod.fst hk
    have hk2 : pat x₁ = pat x₂ := congrArg Prod.snd hk
    have hsub : x₁ - x₂ ∈ Ideal.span {e} := by
      have h' := hk1
      simp only [mk, Submodule.mkQ_apply] at h'
      exact (Submodule.Quotient.eq _).mp h'
    apply hχc x₁ x₂ (hIle𝔮 hsub)
    intro w hw
    have hs := congrFun hk2 ⟨w, hw⟩
    simp only [pat, decide_eq_decide] at hs
    have ha : NumberField.InfinitePlace.embedding_of_isReal hw (x₁ : K) ≠ 0 :=
      (map_ne_zero _).mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx₁0)
    have hb : NumberField.InfinitePlace.embedding_of_isReal hw (x₂ : K) ≠ 0 :=
      (map_ne_zero _).mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx₂0)
    rcases lt_or_gt_of_ne ha with ha' | ha'
    · have hb' : NumberField.InfinitePlace.embedding_of_isReal hw (x₂ : K) < 0 := by
        rcases lt_or_gt_of_ne hb with h | h
        · exact h
        · exact absurd (hs.mpr h) (not_lt.mpr ha'.le)
      exact mul_pos_of_neg_of_neg ha' hb'
    · exact mul_pos ha' (hs.mp ha')
  by_cases hne : T'.Nonempty
  swap
  · 
    have hT'e : T' = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
    refine ⟨0, fun _ => true, h0B, ?_⟩
    rw [hT'e, Finset.sum_empty, norm_zero] at hS0
    refine le_trans (by linarith) (mul_nonneg (by positivity) (add_nonneg (norm_nonneg _) hQ))
  
  have hmaps : ∀ x ∈ T', κ x ∈ T'.image κ := fun x hx => Finset.mem_image_of_mem κ hx
  have hfib : ∑ j ∈ T'.image κ, ∑ x ∈ T'.filter (fun x => κ x = j), χ x * Φ x
      = ∑ x ∈ T', χ x * Φ x :=
    Finset.sum_fiberwise_of_maps_to hmaps (fun x => χ x * Φ x)
  obtain ⟨j₀, hj₀, hmax⟩ := Finset.exists_max_image (T'.image κ)
    (fun j => ‖∑ x ∈ T'.filter (fun x => κ x = j), Φ x‖) (hne.image κ)
  obtain ⟨x₀, hx₀T', hx₀j⟩ := Finset.mem_image.mp hj₀
  obtain ⟨hx₀0, hx₀B, hx₀𝔡, hx₀Y⟩ := (hT'mem x₀).mp hx₀T'
  have hinner : ∀ j ∈ T'.image κ, ‖∑ x ∈ T'.filter (fun x => κ x = j), χ x * Φ x‖
      ≤ ‖∑ x ∈ T'.filter (fun x => κ x = κ x₀), Φ x‖ := by
    intro j hj
    obtain ⟨r, hrT, hrj⟩ := Finset.mem_image.mp hj
    have heq : ∑ x ∈ T'.filter (fun x => κ x = j), χ x * Φ x
        = χ r * ∑ x ∈ T'.filter (fun x => κ x = j), Φ x := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro x hx
      rw [Finset.mem_filter] at hx
      rw [hconst x hx.1 r hrT (hx.2.trans hrj.symm)]
    rw [heq, norm_mul, hx₀j]
    calc ‖χ r‖ * ‖∑ x ∈ T'.filter (fun x => κ x = j), Φ x‖
        ≤ 1 * ‖∑ x ∈ T'.filter (fun x => κ x = j), Φ x‖ :=
          mul_le_mul_of_nonneg_right (hχ r) (norm_nonneg _)
      _ = ‖∑ x ∈ T'.filter (fun x => κ x = j), Φ x‖ := one_mul _
      _ ≤ ‖∑ x ∈ T'.filter (fun x => κ x = j₀), Φ x‖ := hmax j hj
  have hpig : ‖∑ x ∈ T', χ x * Φ x‖
      ≤ ((T'.image κ).card : ℝ) * ‖∑ x ∈ T'.filter (fun x => κ x = κ x₀), Φ x‖ := by
    rw [← hfib]
    refine (norm_sum_le _ _).trans ?_
    have h := Finset.sum_le_card_nsmul (T'.image κ)
      (fun j => ‖∑ x ∈ T'.filter (fun x => κ x = j), χ x * Φ x‖) _ hinner
    rw [nsmul_eq_mul] at h
    exact h
  
  have hk1 : (T'.image mk).card ≤ Nat.card ↥(Submodule.map mk 𝔡) := by
    have hsub : ((T'.image mk : Finset _) : Set _) ⊆
        SetLike.coe (Submodule.map mk 𝔡) := by
      intro z hz
      rw [Finset.coe_image] at hz
      obtain ⟨x, hx, rfl⟩ := hz
      exact Submodule.mem_map_of_mem ((hT'mem x).mp hx).2.2.1
    rw [← Nat.card_eq_finsetCard]
    exact Nat.card_mono (Set.toFinite _) hsub
  have hk : (T'.image κ).card ≤
      (T'.image mk).card * (Finset.univ : Finset (KaiPattern K)).card := by
    rw [← Finset.card_product]
    apply Finset.card_le_card
    intro z hz
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hz
    exact Finset.mem_product.mpr ⟨Finset.mem_image_of_mem _ hx, Finset.mem_univ _⟩
  have hkR : ((T'.image κ).card : ℝ)
      ≤ 2 ^ Module.finrank ℚ K * (((Algebra.norm ℤ e).natAbs : ℝ) / (Ideal.absNorm 𝔡 : ℝ)) := by
    have hcD : (Nat.card ↥(Submodule.map mk 𝔡) : ℝ)
        = ((Algebra.norm ℤ e).natAbs : ℝ) / (Ideal.absNorm 𝔡 : ℝ) := by
      rw [eq_div_iff hd0.ne', ← Nat.cast_mul, hD]
    have hnat : (T'.image κ).card ≤ Nat.card ↥(Submodule.map mk 𝔡) * 2 ^ Module.finrank ℚ K :=
      hk.trans (Nat.mul_le_mul hk1 hpc)
    have h := (Nat.cast_le (α := ℝ)).mpr hnat
    push_cast at h
    rw [hcD] at h
    linarith
  
  have hpatt : ∀ x, pat x = pat x₀ ↔ kaiPatt (pat x₀) x := by
    intro x
    unfold kaiPatt
    constructor
    · intro h w
      rw [← h]
      simp only [pat, decide_eq_true_iff]
    · intro h
      funext w
      have hw := h w
      simp only [pat, decide_eq_true_iff] at hw ⊢
      exact decide_eq_decide.mpr hw
  obtain ⟨P, hP⟩ : ∃ P : Finset (NumberField.RingOfIntegers K),
      P = @Finset.filter (NumberField.RingOfIntegers K)
              (fun x => x - x₀ ∈ Ideal.span {e} ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y ∧
                kaiPatt (pat x₀) x)
              (fun _ => Classical.propDecidable _) (omegaBox ω M) := ⟨_, rfl⟩
  have hfibre : T'.filter (fun x => κ x = κ x₀) = P.erase 0 := by
    ext x
    have hκ : κ x = κ x₀ ↔ x - x₀ ∈ Ideal.span {e} ∧ pat x = pat x₀ := by
      rw [Prod.ext_iff]
      apply and_congr _ Iff.rfl
      simp only [κ, mk, Submodule.mkQ_apply]
      exact Submodule.Quotient.eq _
    simp only [Finset.mem_filter, Finset.mem_erase, hP]
    rw [hT'mem, hκ, hpatt]
    constructor
    · rintro ⟨⟨hx0, hxB, hx𝔡, hxY⟩, hxe, hxp⟩
      exact ⟨hx0, hxB, hxe, hxY, hxp⟩
    · rintro ⟨hx0, hxB, hxe, hxY, hxp⟩
      refine ⟨⟨hx0, hxB, ?_, hxY⟩, hxe, hxp⟩
      have h' := 𝔡.add_mem (hIle𝔡 hxe) hx₀𝔡
      rwa [sub_add_cancel] at h'
  have hfibB : ‖∑ x ∈ P.erase 0, Φ x‖ ≤ ‖∑ x ∈ P, Φ x‖ + Q := by
    by_cases h0 : (0 : NumberField.RingOfIntegers K) ∈ P
    · have hsplit : Φ 0 + ∑ x ∈ P.erase 0, Φ x = ∑ x ∈ P, Φ x :=
        Finset.add_sum_erase P Φ h0
      have h2 : ∑ x ∈ P.erase 0, Φ x = ∑ x ∈ P, Φ x - Φ 0 := by
        rw [← hsplit]; ring
      rw [h2]
      linarith [norm_sub_le (∑ x ∈ P, Φ x) (Φ 0), hΦ 0]
    · rw [Finset.erase_eq_of_notMem h0]
      linarith
  refine ⟨x₀, pat x₀, hx₀B, ?_⟩
  rw [← hP]
  rw [hfibre] at hpig
  have hc0 : (0 : ℝ) ≤ 2 ^ Module.finrank ℚ K *
      (((Algebra.norm ℤ e).natAbs : ℝ) / (Ideal.absNorm 𝔡 : ℝ)) := by positivity
  have h3 := mul_le_mul hkR hfibB (norm_nonneg _) hc0
  linarith

theorem kai_v_si_reparam (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (x₀ e : NumberField.RingOfIntegers K) (he : e ≠ 0) {a b : ℕ}
    (p₀ : Fin a → ℝ) (p₁ : Fin (Module.finrank ℚ K) → Fin a → ℝ) (r₀ : Fin b → ℝ)
    (r₁ : Fin (Module.finrank ℚ K) → Fin b → ℝ)
    (r₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → Fin b → ℝ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) (P : Finset (NumberField.RingOfIntegers K))
    (hP : ∀ x ∈ P, x - x₀ ∈ Ideal.span {e}) :
    ∃ (Ry : Finset (Fin (Module.finrank ℚ K) → ℤ)) (p₀' : Fin a → ℝ) (r₀' : Fin b → ℝ)
      (r₁' : Fin (Module.finrank ℚ K) → Fin b → ℝ)
      (r₂' : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → Fin b → ℝ),
      (∀ y, y ∈ Ry ↔ x₀ + e * ω.equivFun.symm y ∈ P) ∧
      ∑ x ∈ P, nil2Eval p₀ p₁ r₀ r₁ r₂ F (ω.equivFun x) =
        ∑ y ∈ Ry, nil2Eval p₀' (fun j i => ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i)
          r₀' r₁' r₂' F y :=
by
  classical
  obtain ⟨Z, hZ⟩ : ∃ Z : Fin (Module.finrank ℚ K) → ℝ,
      Z = fun l => ((ω.equivFun x₀ l : ℤ) : ℝ) := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ,
      E = fun l j => ((ω.repr (e * ω j) l : ℤ) : ℝ) := ⟨_, rfl⟩
  have hE' : ∀ l j, ((ω.repr (e * ω j) l : ℤ) : ℝ) = E l j := by
    intro l j; rw [hE]
  
  have L1 : ∀ (c Y : Fin (Module.finrank ℚ K) → ℝ),
      ∑ l, (∑ j, E l j * Y j) * c l = ∑ j, Y j * ∑ l, E l j * c l := by
    intro c Y
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l _ => by ring))
  have L2 : ∀ (c Y : Fin (Module.finrank ℚ K) → ℝ),
      ∑ l, (Z l + ∑ j, E l j * Y j) * c l
        = ∑ l, Z l * c l + ∑ j, Y j * ∑ l, E l j * c l := by
    intro c Y
    rw [← L1 c Y, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun l _ => by ring)
  have L3 : ∀ (c Y : Fin (Module.finrank ℚ K) → ℝ)
      (B : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
      ∑ l, c l * ∑ j, Y j * B l j = ∑ j, Y j * ∑ l, c l * B l j := by
    intro c Y B
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l _ => by ring))
  
  have Q : ∀ (Y r₁k : Fin (Module.finrank ℚ K) → ℝ)
      (r₂k : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
      ∑ l, (Z l + ∑ j, E l j * Y j) * r₁k l
        + ∑ l, ∑ l', (Z l + ∑ j, E l j * Y j) * (Z l' + ∑ j, E l' j * Y j) * r₂k l l'
      = ∑ l, Z l * r₁k l + ∑ l, Z l * ∑ l', Z l' * r₂k l l'
        + ∑ j, Y j * (∑ l, E l j * r₁k l + ∑ l, Z l * ∑ l', E l' j * r₂k l l'
            + ∑ l, E l j * ∑ l', Z l' * r₂k l l')
        + ∑ j, ∑ j', Y j * Y j' * ∑ l, E l j * ∑ l', E l' j' * r₂k l l' := by
    intro Y r₁k r₂k
    have e1 := L2 r₁k Y
    have e2 : ∑ l, ∑ l', (Z l + ∑ j, E l j * Y j) * (Z l' + ∑ j, E l' j * Y j) * r₂k l l'
        = ∑ l, (Z l + ∑ j, E l j * Y j) * (∑ l', Z l' * r₂k l l'
            + ∑ j', Y j' * ∑ l', E l' j' * r₂k l l') := by
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [← L2 (fun l' => r₂k l l') Y, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun l' _ => by ring)
    have e3 := L2 (fun l => ∑ l', Z l' * r₂k l l'
            + ∑ j', Y j' * ∑ l', E l' j' * r₂k l l') Y
    have e4 : ∀ c : Fin (Module.finrank ℚ K) → ℝ,
        ∑ l, c l * (∑ l', Z l' * r₂k l l' + ∑ j', Y j' * ∑ l', E l' j' * r₂k l l')
          = ∑ l, c l * ∑ l', Z l' * r₂k l l'
            + ∑ j', Y j' * ∑ l, c l * ∑ l', E l' j' * r₂k l l' := by
      intro c
      rw [← L3 c Y (fun l j' => ∑ l', E l' j' * r₂k l l'), ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun l _ => by ring)
    have e5 : ∑ j, Y j * ∑ l, E l j * (∑ l', Z l' * r₂k l l'
            + ∑ j', Y j' * ∑ l', E l' j' * r₂k l l')
        = ∑ j, Y j * ∑ l, E l j * ∑ l', Z l' * r₂k l l'
          + ∑ j, ∑ j', Y j * Y j' * ∑ l, E l j * ∑ l', E l' j' * r₂k l l' := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [e4 (fun l => E l j), mul_add]
      congr 1
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j' _ => by ring)
    have e6 : ∑ j, Y j * (∑ l, E l j * r₁k l + ∑ l, Z l * ∑ l', E l' j * r₂k l l'
            + ∑ l, E l j * ∑ l', Z l' * r₂k l l')
        = ∑ j, Y j * ∑ l, E l j * r₁k l + ∑ j, Y j * ∑ l, Z l * ∑ l', E l' j * r₂k l l'
          + ∑ j, Y j * ∑ l, E l j * ∑ l', Z l' * r₂k l l' := by
      rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    have e7 := e4 Z
    rw [e2, e3, e7, e5, e6, e1]
    ring
  
  let g : (Fin (Module.finrank ℚ K) → ℤ) → NumberField.RingOfIntegers K :=
    fun y => x₀ + e * ω.equivFun.symm y
  have hg : Function.Injective g := by
    intro y y' h
    have h1 : e * ω.equivFun.symm y = e * ω.equivFun.symm y' := add_left_cancel h
    exact ω.equivFun.symm.injective (mul_left_cancel₀ he h1)
  have hcZ : ∀ (y : Fin (Module.finrank ℚ K) → ℤ) (l : Fin (Module.finrank ℚ K)),
      ω.equivFun (x₀ + e * ω.equivFun.symm y) l
        = ω.equivFun x₀ l + ∑ j, ω.repr (e * ω j) l * y j := by
    intro y l
    rw [Module.Basis.equivFun_symm_apply, Finset.mul_sum, map_add, Pi.add_apply]
    congr 1
    rw [map_sum, Finset.sum_apply]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [mul_smul_comm, map_zsmul, Pi.smul_apply, smul_eq_mul, Module.Basis.equivFun_apply,
      mul_comm]
  have hc : ∀ (y : Fin (Module.finrank ℚ K) → ℤ) (l : Fin (Module.finrank ℚ K)),
      ((ω.equivFun (g y) l : ℤ) : ℝ) = Z l + ∑ j, E l j * ((y j : ℤ) : ℝ) := by
    intro y l
    show ((ω.equivFun (x₀ + e * ω.equivFun.symm y) l : ℤ) : ℝ) = _
    rw [hcZ, hZ, hE]
    push_cast
    rfl
  have hvac : ∀ x ∈ P, x ∉ Set.range g → nil2Eval p₀ p₁ r₀ r₁ r₂ F (ω.equivFun x) = 0 := by
    intro x hx hxr
    exfalso
    apply hxr
    obtain ⟨c, hc'⟩ := Ideal.mem_span_singleton'.mp (hP x hx)
    refine ⟨ω.equivFun c, ?_⟩
    show x₀ + e * ω.equivFun.symm (ω.equivFun c) = x
    rw [LinearEquiv.symm_apply_apply, mul_comm, hc']
    abel
  refine ⟨P.preimage g hg.injOn,
    fun i => p₀ i + ∑ l, Z l * p₁ l i,
    fun k => r₀ k + ∑ l, Z l * r₁ l k + ∑ l, Z l * ∑ l', Z l' * r₂ l l' k,
    fun j k => ∑ l, E l j * r₁ l k + ∑ l, Z l * ∑ l', E l' j * r₂ l l' k
      + ∑ l, E l j * ∑ l', Z l' * r₂ l l' k,
    fun j j' k => ∑ l, E l j * ∑ l', E l' j' * r₂ l l' k,
    fun y => Finset.mem_preimage, ?_⟩
  rw [← Finset.sum_preimage g P hg.injOn _ hvac]
  refine Finset.sum_congr rfl (fun y _ => ?_)
  simp only [nil2Eval, hc, hE']
  congr 1
  refine Prod.ext ?_ ?_
  · funext i
    have h := L2 (fun l => p₁ l i) (fun j => ((y j : ℤ) : ℝ))
    simp only at h ⊢
    rw [h]
    ring
  · funext k
    have h := Q (fun j => ((y j : ℤ) : ℝ)) (fun l => r₁ l k) (fun l l' => r₂ l l' k)
    simp only at h ⊢
    linear_combination h

theorem kai_v_si_cube_pigeonhole (ν s : ℕ) (hs : 1 ≤ s) (R : Finset (Fin ν → ℤ))
    (h : (Fin ν → ℤ) → ℂ) (Q Λ : ℝ) (hQ : 0 ≤ Q) (hh : ∀ y, ‖h y‖ ≤ Q) (hΛ : 0 < Λ)
    (hR : Λ ≤ ‖∑ y ∈ R, h y‖)
    (hbad : ∀ U : Finset (Fin ν → ℤ),
      (∀ u ∈ U,
        (∃ y ∈ R, y ∈ Finset.Icc (fun j => (s : ℤ) * u j)
          ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1))) ∧
        (∃ y, y ∉ R ∧ y ∈ Finset.Icc (fun j => (s : ℤ) * u j)
          ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)))) →
      (U.card : ℝ) * Q * (s : ℝ) ^ ν ≤ Λ / 2) :
    ∃ u : Fin ν → ℤ, Λ * (s : ℝ) ^ ν / (2 * (R.card : ℝ)) ≤
      ‖∑ y ∈ Finset.Icc (fun j => (s : ℤ) * u j)
          ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)), h y‖ :=
by
  classical
  have hs0 : (0 : ℤ) < (s : ℤ) := by exact_mod_cast hs
  have hsR : (1 : ℝ) ≤ (s : ℝ) := by exact_mod_cast hs
  have hsν : (1 : ℝ) ≤ (s : ℝ) ^ ν := one_le_pow₀ hsR
  obtain ⟨cube, hcube⟩ : ∃ cube : (Fin ν → ℤ) → Finset (Fin ν → ℤ),
      cube = fun u => Finset.Icc (fun j => (s : ℤ) * u j)
        ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)) := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q : (Fin ν → ℤ) → (Fin ν → ℤ), q = fun y j => y j / (s : ℤ) :=
    ⟨_, rfl⟩
  
  have key : ∀ a b : ℤ, ((s : ℤ) * b ≤ a ∧ a ≤ (s : ℤ) * b + ((s : ℤ) - 1)) ↔ a / (s : ℤ) = b := by
    intro a b
    constructor
    · rintro ⟨h1, h2⟩
      exact ((Int.ediv_emod_unique (a := a) (r := a - (s : ℤ) * b) (q := b) hs0).2
        ⟨by ring, by linarith, by linarith⟩).1
    · rintro rfl
      have e1 := Int.emod_add_ediv a (s : ℤ)
      have e2 := Int.emod_nonneg a hs0.ne'
      have e3 := Int.emod_lt_of_pos a hs0
      constructor <;> linarith
  have hmem : ∀ u y : Fin ν → ℤ, y ∈ cube u ↔ q y = u := by
    intro u y
    rw [hcube, hq, Finset.mem_Icc, funext_iff]
    constructor
    · rintro ⟨h1, h2⟩ j
      exact (key (y j) (u j)).1 ⟨Pi.le_def.1 h1 j, Pi.le_def.1 h2 j⟩
    · intro hqy
      exact ⟨Pi.le_def.2 (fun j => ((key _ _).2 (hqy j)).1),
        Pi.le_def.2 (fun j => ((key _ _).2 (hqy j)).2)⟩
  have hcard : ∀ u, (cube u).card = s ^ ν := by
    intro u
    rw [hcube]
    dsimp only
    rw [Pi.card_Icc]
    have hj : ∀ j : Fin ν,
        (Finset.Icc ((s : ℤ) * u j) ((s : ℤ) * u j + ((s : ℤ) - 1))).card = s := by
      intro j
      rw [Int.card_Icc]
      rw [show (s : ℤ) * u j + ((s : ℤ) - 1) + 1 - (s : ℤ) * u j = (s : ℤ) by ring]
      exact Int.toNat_natCast s
    simp only [Pi.add_apply, hj, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  
  obtain ⟨T, hT⟩ : ∃ T : Finset (Fin ν → ℤ), T = R.image q := ⟨_, rfl⟩
  obtain ⟨I, hI⟩ : ∃ I : Finset (Fin ν → ℤ), I = T.filter (fun u => cube u ⊆ R) := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : Finset (Fin ν → ℤ), B = T.filter (fun u => ¬ cube u ⊆ R) := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : (Fin ν → ℤ) → ℂ,
      F = fun u => ∑ y ∈ R.filter (fun y => q y = u), h y := ⟨_, rfl⟩
  obtain ⟨S, hS⟩ : ∃ S : (Fin ν → ℤ) → ℂ, S = fun u => ∑ y ∈ cube u, h y := ⟨_, rfl⟩
  
  have hE1 : ∑ y ∈ R, h y = ∑ u ∈ T, F u := by
    rw [hF, hT]
    exact (Finset.sum_fiberwise_of_maps_to (fun y hy => Finset.mem_image_of_mem q hy) h).symm
  have hE2 : ∑ u ∈ T, F u = ∑ u ∈ I, F u + ∑ u ∈ B, F u := by
    rw [hI, hB]
    exact (Finset.sum_filter_add_sum_filter_not T _ F).symm
  have hIF : ∀ u ∈ I, F u = S u := by
    intro u hu
    rw [hI, Finset.mem_filter] at hu
    have hsub := hu.2
    rw [hF, hS]
    dsimp only
    congr 1
    ext y
    rw [Finset.mem_filter]
    constructor
    · rintro ⟨_, hqy⟩
      exact (hmem u y).2 hqy
    · intro hy
      exact ⟨hsub hy, (hmem u y).1 hy⟩
  have hE3 : ∑ u ∈ I, F u = ∑ u ∈ I, S u := Finset.sum_congr rfl hIF
  
  have hBF : ∀ u ∈ B, ‖F u‖ ≤ (s : ℝ) ^ ν * Q := by
    intro u _
    have hsub : R.filter (fun y => q y = u) ⊆ cube u := by
      intro y hy
      rw [Finset.mem_filter] at hy
      exact (hmem u y).2 hy.2
    have hc : ((R.filter (fun y => q y = u)).card : ℝ) ≤ (s : ℝ) ^ ν := by
      have := Finset.card_le_card hsub
      rw [hcard u] at this
      exact_mod_cast this
    rw [hF]
    dsimp only
    calc ‖∑ y ∈ R.filter (fun y => q y = u), h y‖
        ≤ ∑ y ∈ R.filter (fun y => q y = u), ‖h y‖ := norm_sum_le _ _
      _ ≤ (R.filter (fun y => q y = u)).card • Q :=
          Finset.sum_le_card_nsmul _ _ Q (fun y _ => hh y)
      _ = ((R.filter (fun y => q y = u)).card : ℝ) * Q := nsmul_eq_mul _ _
      _ ≤ (s : ℝ) ^ ν * Q := mul_le_mul_of_nonneg_right hc hQ
  have hBsum : ‖∑ u ∈ B, F u‖ ≤ (B.card : ℝ) * ((s : ℝ) ^ ν * Q) := by
    calc ‖∑ u ∈ B, F u‖ ≤ ∑ u ∈ B, ‖F u‖ := norm_sum_le _ _
      _ ≤ B.card • ((s : ℝ) ^ ν * Q) := Finset.sum_le_card_nsmul _ _ _ hBF
      _ = (B.card : ℝ) * ((s : ℝ) ^ ν * Q) := nsmul_eq_mul _ _
  have hbadB := hbad B (by
    intro u hu
    rw [hB, Finset.mem_filter] at hu
    obtain ⟨huT, hns⟩ := hu
    rw [hT, Finset.mem_image] at huT
    obtain ⟨y, hyR, hqy⟩ := huT
    obtain ⟨x, hx, hxR⟩ := Finset.not_subset.1 hns
    have hy' := (hmem u y).2 hqy
    rw [hcube] at hy' hx
    exact ⟨⟨y, hyR, hy'⟩, ⟨x, hxR, hx⟩⟩)
  have hBd : ‖∑ u ∈ B, F u‖ ≤ Λ / 2 := by
    have : (B.card : ℝ) * ((s : ℝ) ^ ν * Q) = (B.card : ℝ) * Q * (s : ℝ) ^ ν := by ring
    linarith
  
  have hInt : Λ / 2 ≤ ‖∑ u ∈ I, S u‖ := by
    have e : ∑ y ∈ R, h y = ∑ u ∈ I, S u + ∑ u ∈ B, F u := by rw [hE1, hE2, hE3]
    have := norm_add_le (∑ u ∈ I, S u) (∑ u ∈ B, F u)
    rw [← e] at this
    linarith
  have hIne : I.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hIe
    rw [hIe, Finset.sum_empty, norm_zero] at hInt
    linarith
  obtain ⟨u, huI, humax⟩ := Finset.exists_max_image I (fun u => ‖S u‖) hIne
  have hA : Λ / 2 ≤ (I.card : ℝ) * ‖S u‖ := by
    calc Λ / 2 ≤ ‖∑ u ∈ I, S u‖ := hInt
      _ ≤ ∑ u ∈ I, ‖S u‖ := norm_sum_le _ _
      _ ≤ I.card • ‖S u‖ := Finset.sum_le_card_nsmul _ _ _ humax
      _ = (I.card : ℝ) * ‖S u‖ := nsmul_eq_mul _ _
  
  have hCnat : I.card * s ^ ν ≤ R.card := by
    have hdisj : (I : Set (Fin ν → ℤ)).PairwiseDisjoint cube := by
      intro u₁ _ u₂ _ hne
      exact Finset.disjoint_left.2
        (fun y hy hy' => hne (((hmem u₁ y).1 hy).symm.trans ((hmem u₂ y).1 hy')))
    have hsub : I.biUnion cube ⊆ R := by
      refine Finset.biUnion_subset.2 (fun u hu => ?_)
      rw [hI, Finset.mem_filter] at hu
      exact hu.2
    calc I.card * s ^ ν = ∑ u ∈ I, (cube u).card := by
          rw [Finset.sum_congr rfl (fun u _ => hcard u), Finset.sum_const, smul_eq_mul]
      _ = (I.biUnion cube).card := (Finset.card_biUnion hdisj).symm
      _ ≤ R.card := Finset.card_le_card hsub
  have hC : (I.card : ℝ) * (s : ℝ) ^ ν ≤ (R.card : ℝ) := by exact_mod_cast hCnat
  have hI1 : (1 : ℝ) ≤ (I.card : ℝ) := by exact_mod_cast Finset.card_pos.2 hIne
  have hR1 : (1 : ℝ) ≤ (R.card : ℝ) := by nlinarith
  refine ⟨u, ?_⟩
  have hSu : ∑ y ∈ Finset.Icc (fun j => (s : ℤ) * u j)
      ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)), h y = S u := by
    rw [hS, hcube]
  rw [hSu, div_le_iff₀ (by linarith)]
  have hn := norm_nonneg (S u)
  have p1 := mul_le_mul_of_nonneg_right hA (by linarith : (0 : ℝ) ≤ (s : ℝ) ^ ν)
  have p2 := mul_le_mul_of_nonneg_left hC hn
  nlinarith

theorem kai_bc_omega_emb_bounds (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ κ : ℝ, 1 ≤ κ ∧
      (∀ (v : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ), (∀ j, |v j| ≤ B) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) ≤ κ * B) ∧
      (∀ (v : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ),
        (∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) ≤ B) →
        ∀ j, |v j| ≤ κ * B) :=
by
  classical
  have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
  
  set e : Fin (Module.finrank ℚ K) → NumberField.mixedEmbedding.mixedSpace K :=
    fun j => NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K) with he
  let φ : NumberField.RingOfIntegers K →+ NumberField.mixedEmbedding.mixedSpace K :=
    (NumberField.mixedEmbedding K).toAddMonoidHom.comp
      (algebraMap (NumberField.RingOfIntegers K) K).toAddMonoidHom
  have hφ : ∀ x, φ x = NumberField.mixedEmbedding K (x : K) := fun x => rfl
  have hz : ∀ x : NumberField.RingOfIntegers K,
      NumberField.mixedEmbedding K (x : K) = ∑ j, (ω.equivFun x j) • e j := by
    intro x
    rw [← hφ]
    conv_lhs => rw [← ω.sum_equivFun x]
    rw [map_sum]
    simp only [map_zsmul, hφ, e]
  have hspan : Submodule.span ℤ (Set.range e)
      = NumberField.mixedEmbedding.integerLattice K := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      exact ⟨ω j, rfl⟩
    · rintro y ⟨x, rfl⟩
      show φ x ∈ _
      rw [hφ, hz x]
      exact Submodule.sum_mem _
        (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
  have htop : ⊤ ≤ Submodule.span ℝ (Set.range e) := by
    rw [← (NumberField.mixedEmbedding.latticeBasis K).span_eq, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    have h1 : NumberField.mixedEmbedding.latticeBasis K i
        ∈ Submodule.span ℤ (Set.range e) := by
      rw [hspan, ← NumberField.mixedEmbedding.span_latticeBasis]
      exact Submodule.subset_span ⟨i, rfl⟩
    exact Submodule.span_le_restrictScalars ℤ ℝ _ h1
  have hcard : Fintype.card (Fin (Module.finrank ℚ K))
      = Module.finrank ℝ (NumberField.mixedEmbedding.mixedSpace K) := by
    rw [Fintype.card_fin, NumberField.mixedEmbedding.finrank]
  have hli : LinearIndependent ℝ e :=
    linearIndependent_of_top_le_span_of_card_eq_finrank htop hcard
  
  have hTsmul : ∀ (c : ℝ) (v : Fin (Module.finrank ℚ K) → ℝ),
      kaiOmegaEmb ω (c • v) = c • kaiOmegaEmb ω v := by
    intro c v
    unfold kaiOmegaEmb
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, mul_smul]
  have hTcont : Continuous (kaiOmegaEmb ω) := by
    unfold kaiOmegaEmb
    exact continuous_finset_sum _ (fun j _ => (continuous_apply j).smul continuous_const)
  have hTzero : ∀ v : Fin (Module.finrank ℚ K) → ℝ,
      (∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) = 0) → v = 0 := by
    intro v hv
    have h0 : kaiOmegaEmb ω v = 0 :=
      NumberField.mixedEmbedding.forall_normAtPlace_eq_zero_iff.mp hv
    have h1 : ∑ j, v j • e j = 0 := h0
    funext j
    exact Fintype.linearIndependent_iff.mp hli v h1 j
  
  have hw0 : ∀ (w : NumberField.InfinitePlace K) (j : Fin (Module.finrank ℚ K)),
      0 ≤ w ((ω j : NumberField.RingOfIntegers K) : K) := fun w j => by positivity
  obtain ⟨κ₁, hκ₁_def⟩ : ∃ κ₁ : ℝ, κ₁ = 1 + ∑ w' : NumberField.InfinitePlace K,
      ∑ j, w' ((ω j : NumberField.RingOfIntegers K) : K) := ⟨_, rfl⟩
  have hsum0 : 0 ≤ ∑ w' : NumberField.InfinitePlace K,
      ∑ j, w' ((ω j : NumberField.RingOfIntegers K) : K) :=
    Finset.sum_nonneg (fun w' _ => Finset.sum_nonneg (fun j _ => hw0 w' j))
  have hκ₁1 : 1 ≤ κ₁ := by rw [hκ₁_def]; linarith
  have hU : ∀ (v : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ), (∀ j, |v j| ≤ B) →
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) ≤ κ₁ * B := by
    intro v B hv w
    have hB : 0 ≤ B := (abs_nonneg _).trans (hv ⟨0, hn⟩)
    have hsw : ∑ j, w ((ω j : NumberField.RingOfIntegers K) : K) ≤ κ₁ := by
      have h1 : ∑ j, w ((ω j : NumberField.RingOfIntegers K) : K) ≤
          ∑ w' : NumberField.InfinitePlace K,
            ∑ j, w' ((ω j : NumberField.RingOfIntegers K) : K) :=
        Finset.single_le_sum (f := fun w' : NumberField.InfinitePlace K =>
            ∑ j, w' ((ω j : NumberField.RingOfIntegers K) : K))
          (fun w' _ => Finset.sum_nonneg (fun j _ => hw0 w' j)) (Finset.mem_univ w)
      rw [hκ₁_def]; linarith
    unfold kaiOmegaEmb
    calc NumberField.mixedEmbedding.normAtPlace w
          (∑ j, v j • NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K))
        ≤ ∑ j, NumberField.mixedEmbedding.normAtPlace w
            (v j • NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) :=
          Finset.le_sum_of_subadditive _ (map_zero _).le
            (NumberField.mixedEmbedding.normAtPlace_add_le w) _ _
      _ = ∑ j, |v j| * w ((ω j : NumberField.RingOfIntegers K) : K) := by
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [NumberField.mixedEmbedding.normAtPlace_smul,
            NumberField.mixedEmbedding.normAtPlace_apply]
      _ ≤ ∑ j, B * w ((ω j : NumberField.RingOfIntegers K) : K) :=
          Finset.sum_le_sum (fun j _ => mul_le_mul_of_nonneg_right (hv j) (hw0 w j))
      _ = B * ∑ j, w ((ω j : NumberField.RingOfIntegers K) : K) := by rw [Finset.mul_sum]
      _ ≤ B * κ₁ := mul_le_mul_of_nonneg_left hsw hB
      _ = κ₁ * B := mul_comm _ _
  
  let one : Fin (Module.finrank ℚ K) → ℝ := fun _ => 1
  have hone : ‖one‖ = 1 := by
    apply le_antisymm
    · exact (pi_norm_le_iff_of_nonneg zero_le_one).2 (fun j => by simp [one])
    · have h1 := norm_le_pi_norm one ⟨0, hn⟩
      simpa [one] using h1
  have hPne : Nonempty (NumberField.InfinitePlace K) := by
    by_contra hE
    rw [not_nonempty_iff] at hE
    have h1 := hTzero one (fun w => (hE.false w).elim)
    have h2 := congrFun h1 ⟨0, hn⟩
    simp [one] at h2
  obtain ⟨w₀⟩ := hPne
  let h : (Fin (Module.finrank ℚ K) → ℝ) → ℝ := fun u =>
    ∑ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω u)
  have hcont : Continuous h :=
    continuous_finset_sum _
      (fun w _ => (NumberField.mixedEmbedding.continuous_normAtPlace w).comp hTcont)
  have hS : IsCompact (Metric.sphere (0 : Fin (Module.finrank ℚ K) → ℝ) 1) :=
    isCompact_sphere 0 1
  have hSne : (Metric.sphere (0 : Fin (Module.finrank ℚ K) → ℝ) 1).Nonempty :=
    ⟨one, by rw [mem_sphere_zero_iff_norm]; exact hone⟩
  obtain ⟨u₀, hu₀S, hu₀min⟩ := hS.exists_isMinOn hSne hcont.continuousOn
  have hm0 : 0 < h u₀ := by
    have hnn : 0 ≤ h u₀ :=
      Finset.sum_nonneg (fun w _ => NumberField.mixedEmbedding.normAtPlace_nonneg w _)
    rcases hnn.lt_or_eq with hlt | heq
    · exact hlt
    · exfalso
      have hall := (Finset.sum_eq_zero_iff_of_nonneg
        (fun w _ => NumberField.mixedEmbedding.normAtPlace_nonneg w (kaiOmegaEmb ω u₀))).mp
          heq.symm
      have hz0 := hTzero u₀ (fun w => hall w (Finset.mem_univ w))
      rw [mem_sphere_zero_iff_norm, hz0, norm_zero] at hu₀S
      exact zero_ne_one hu₀S
  obtain ⟨c₂, hc₂_def⟩ : ∃ c₂ : ℝ,
      c₂ = ((Fintype.card (NumberField.InfinitePlace K) : ℝ) + 1) / h u₀ := ⟨_, rfl⟩
  have hc₂ : 0 < c₂ := by rw [hc₂_def]; positivity
  have hL : ∀ (v : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ),
      (∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) ≤ B) →
      0 ≤ B ∧ ∀ j, |v j| ≤ c₂ * B := by
    intro v B hv
    have hB : 0 ≤ B := (NumberField.mixedEmbedding.normAtPlace_nonneg w₀ _).trans (hv w₀)
    refine ⟨hB, fun j => ?_⟩
    have hhv : h v ≤ (Fintype.card (NumberField.InfinitePlace K) : ℝ) * B := by
      calc h v ≤ ∑ _w : NumberField.InfinitePlace K, B := Finset.sum_le_sum (fun w _ => hv w)
        _ = _ := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    have hvj : |v j| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm v j
    by_cases hv0 : v = 0
    · rw [hv0]
      simp only [Pi.zero_apply, abs_zero]
      positivity
    · have hr : 0 < ‖v‖ := norm_pos_iff.mpr hv0
      have huS : ‖v‖⁻¹ • v ∈ Metric.sphere (0 : Fin (Module.finrank ℚ K) → ℝ) 1 := by
        rw [mem_sphere_zero_iff_norm, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.2 hr),
          inv_mul_cancel₀ hr.ne']
      have hmin : h u₀ ≤ h (‖v‖⁻¹ • v) := isMinOn_iff.mp hu₀min _ huS
      have hhu : h (‖v‖⁻¹ • v) = ‖v‖⁻¹ * h v := by
        simp only [h, hTsmul, NumberField.mixedEmbedding.normAtPlace_smul,
          abs_of_pos (inv_pos.2 hr), Finset.mul_sum]
      rw [hhu] at hmin
      have h1 : h u₀ * ‖v‖ ≤ h v := by
        have h3 := mul_le_mul_of_nonneg_right hmin hr.le
        rwa [mul_comm (‖v‖⁻¹) _, mul_assoc, inv_mul_cancel₀ hr.ne', mul_one] at h3
      have h2 : ‖v‖ ≤ c₂ * B := by
        rw [hc₂_def, div_mul_eq_mul_div, le_div_iff₀ hm0]
        nlinarith
      linarith
  refine ⟨max κ₁ c₂, le_trans hκ₁1 (le_max_left _ _), ?_, ?_⟩
  · intro v B hv w
    have hB : 0 ≤ B := (abs_nonneg _).trans (hv ⟨0, hn⟩)
    exact (hU v B hv w).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) hB)
  · intro v B hv j
    obtain ⟨hB, hL'⟩ := hL v B hv
    exact (hL' j).trans (mul_le_mul_of_nonneg_right (le_max_right _ _) hB)

theorem kai_bc_mul_inverse (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∀ (κ : ℝ), 1 ≤ κ →
      (∀ (v : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ), (∀ j, |v j| ≤ B) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) ≤ κ * B) →
      (∀ (v : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ),
        (∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) ≤ B) →
        ∀ j, |v j| ≤ κ * B) →
      ∀ (e : NumberField.RingOfIntegers K) (ν : ℝ), 0 < ν →
        (∀ w : NumberField.InfinitePlace K, ν ≤ w (e : K)) →
        ∀ (y : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ),
          (∀ l, |∑ j, y j * ((ω.repr (e * ω j) l : ℤ) : ℝ)| ≤ B) →
          ∀ j, |y j| ≤ κ ^ 2 / ν * B :=
by
  intro κ _hκ hUB hLB e ν hν he y B hB j₀
  classical
  let φ : NumberField.RingOfIntegers K →+* NumberField.mixedEmbedding.mixedSpace K :=
    (NumberField.mixedEmbedding K).comp (algebraMap (NumberField.RingOfIntegers K) K)
  
  have s1 : ∀ j, ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) •
        NumberField.mixedEmbedding K ((ω l : NumberField.RingOfIntegers K) : K)
      = NumberField.mixedEmbedding K ((e : NumberField.RingOfIntegers K) : K) *
        NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K) := by
    intro j
    have h : φ (∑ l, ω.repr (e * ω j) l • ω l) = φ (e * ω j) := by rw [ω.sum_repr]
    rw [map_sum, map_mul φ] at h
    calc ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) •
          NumberField.mixedEmbedding K ((ω l : NumberField.RingOfIntegers K) : K)
        = ∑ l, φ (ω.repr (e * ω j) l • ω l) := by
          refine Finset.sum_congr rfl (fun l _ => ?_)
          rw [map_zsmul, Int.cast_smul_eq_zsmul]
          rfl
      _ = φ e * φ (ω j) := h
      _ = _ := rfl
  
  have s2 : kaiOmegaEmb ω (fun l => ∑ j, y j * ((ω.repr (e * ω j) l : ℤ) : ℝ))
      = NumberField.mixedEmbedding K ((e : NumberField.RingOfIntegers K) : K) *
        kaiOmegaEmb ω y := by
    unfold kaiOmegaEmb
    simp only [Finset.sum_smul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [mul_smul_comm, ← s1 j, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [smul_smul]
  
  have s4 : ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω y) ≤ κ * B / ν := by
    intro w
    have h1 := hUB (fun l => ∑ j, y j * ((ω.repr (e * ω j) l : ℤ) : ℝ)) B hB w
    rw [s2, map_mul, NumberField.mixedEmbedding.normAtPlace_apply] at h1
    have ht := NumberField.mixedEmbedding.normAtPlace_nonneg w (kaiOmegaEmb ω y)
    rw [le_div_iff₀ hν]
    have h2 := mul_le_mul_of_nonneg_right (he w) ht
    linarith
  
  have h5 := hLB y _ s4 j₀
  calc |y j₀| ≤ κ * (κ * B / ν) := h5
    _ = κ ^ 2 / ν * B := by ring

theorem kai_bc_hyperplane_cover : ∀ (n : ℕ) (a : Fin n → ℝ) (c M ρ : ℝ), a ≠ 0 → 0 < ρ → ρ ≤ M →
    ∃ Z : Finset (Fin n → ℝ), (Z.card : ℝ) ≤ (3 * (n : ℝ) * M / ρ) ^ (n - 1) ∧
      ∀ v : Fin n → ℝ, (∀ j, |v j| ≤ M) → ∑ j, a j * v j = c →
        ∃ z ∈ Z, ∀ j, |v j - z j| ≤ ρ :=
by
  classical
  intro n a c M ρ ha hρ hρM
  have hn : 1 ≤ n := by
    rcases Nat.eq_zero_or_pos n with h | h
    · subst h; exact absurd (Subsingleton.elim a 0) ha
    · exact h
  have hnR : (1:ℝ) ≤ n := by exact_mod_cast hn
  have hnpos : (0:ℝ) < n := by linarith
  have hM : 0 < M := lt_of_lt_of_le hρ hρM
  obtain ⟨j₀, -, hj₀⟩ := Finset.exists_max_image (Finset.univ : Finset (Fin n))
    (fun j => |a j|) ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
  have hmax : ∀ i, |a i| ≤ |a j₀| := fun i => hj₀ i (Finset.mem_univ _)
  have ha0 : a j₀ ≠ 0 := by
    obtain ⟨i, hi⟩ := Function.ne_iff.mp ha
    have : 0 < |a i| := abs_pos.mpr hi
    exact abs_pos.mp (lt_of_lt_of_le this (hmax i))
  have haj : 0 < |a j₀| := abs_pos.mpr ha0
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = ρ / n := ⟨_, rfl⟩
  have hδpos : 0 < δ := by rw [hδ]; exact div_pos hρ hnpos
  have hnδ : (n:ℝ) * δ = ρ := by rw [hδ]; field_simp
  have hδρ : δ ≤ ρ := by rw [hδ]; exact div_le_self hρ.le hnR
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = ⌊2 * M / δ⌋₊ := ⟨_, rfl⟩
  let S : Finset (Fin n → ℕ) := Fintype.piFinset
    (fun j : Fin n => if j = j₀ then ({0} : Finset ℕ) else Finset.range (N + 1))
  let w : (Fin n → ℕ) → Fin n → ℝ := fun k j => -M + (k j : ℝ) * δ
  let g : (Fin n → ℕ) → Fin n → ℝ := fun k j =>
    w k j + (if j = j₀ then (c - ∑ i, a i * w k i) / a j₀ else 0)
  refine ⟨S.image g, ?_, ?_⟩
  · have hS : S.card = (N + 1) ^ (n - 1) := by
      simp only [S, Fintype.card_piFinset]
      rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j₀)]
      rw [if_pos rfl, Finset.card_singleton, one_mul]
      rw [Finset.prod_congr rfl (fun j hj => by
        rw [if_neg (Finset.ne_of_mem_erase hj), Finset.card_range])]
      rw [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ,
        Fintype.card_fin]
    have h1 : ((S.image g).card : ℝ) ≤ ((N : ℝ) + 1) ^ (n - 1) := by
      have := Finset.card_image_le (s := S) (f := g)
      rw [hS] at this
      exact_mod_cast this
    have hNle : (N : ℝ) ≤ 2 * M / δ := by
      rw [hN]; exact Nat.floor_le (by positivity)
    have h2M : 2 * M / δ = 2 * n * M / ρ := by rw [hδ]; field_simp
    have hMρ : 1 ≤ M / ρ := (one_le_div hρ).mpr hρM
    have h3 : (N : ℝ) + 1 ≤ 3 * (n : ℝ) * M / ρ := by
      have e : 3 * (n : ℝ) * M / ρ = 2 * n * M / ρ + n * (M / ρ) := by ring
      rw [e]
      have : (1 : ℝ) ≤ n * (M / ρ) := by nlinarith
      linarith
    exact h1.trans (pow_le_pow_left₀ (by positivity) h3 _)
  · intro v hv hc
    have hfl : ∀ x : ℝ, |x| ≤ M → ⌊(x + M) / δ⌋₊ ≤ N ∧
        0 ≤ x - (-M + (⌊(x + M) / δ⌋₊ : ℝ) * δ) ∧
        x - (-M + (⌊(x + M) / δ⌋₊ : ℝ) * δ) < δ := by
      intro x hx
      obtain ⟨hx1, hx2⟩ := abs_le.mp hx
      have ht0 : 0 ≤ (x + M) / δ := div_nonneg (by linarith) hδpos.le
      refine ⟨?_, ?_, ?_⟩
      · rw [hN]
        exact Nat.floor_le_floor (div_le_div_of_nonneg_right (by linarith) hδpos.le)
      · have := Nat.floor_le ht0
        rw [le_div_iff₀ hδpos] at this
        linarith
      · have := Nat.lt_floor_add_one ((x + M) / δ)
        rw [div_lt_iff₀ hδpos] at this
        linarith
    let k : Fin n → ℕ := fun j => if j = j₀ then 0 else ⌊(v j + M) / δ⌋₊
    have hkS : k ∈ S := by
      rw [Fintype.mem_piFinset]
      intro j
      by_cases hj : j = j₀
      · simp [k, hj]
      · simp only [k, if_neg hj, Finset.mem_range]
        exact Nat.lt_succ_of_le (hfl (v j) (hv j)).1
    refine ⟨g k, Finset.mem_image_of_mem g hkS, ?_⟩
    have hfree : ∀ i, i ≠ j₀ → |v i - w k i| ≤ δ := by
      intro i hi
      have h := hfl (v i) (hv i)
      have e : w k i = -M + (⌊(v i + M) / δ⌋₊ : ℝ) * δ := by simp only [w, k, if_neg hi]
      rw [e, abs_of_nonneg h.2.1]
      exact h.2.2.le
    intro j
    by_cases hj : j = j₀
    · rw [hj]
      have e : g k j₀ = w k j₀ + (c - ∑ i, a i * w k i) / a j₀ := by
        simp only [g, if_true]
      rw [e]
      have hX : c - ∑ i, a i * w k i = a j₀ * (v j₀ - w k j₀)
          + ∑ i, a i * (if i = j₀ then 0 else (v i - w k i)) := by
        rw [← hc, ← Finset.sum_sub_distrib]
        have hpt : ∀ i, a i * v i - a i * w k i = (if i = j₀ then a i * (v i - w k i) else 0)
            + a i * (if i = j₀ then 0 else (v i - w k i)) := by
          intro i; split_ifs <;> ring
        rw [Finset.sum_congr rfl (fun i _ => hpt i), Finset.sum_add_distrib, Finset.sum_ite_eq',
          if_pos (Finset.mem_univ _)]
      have hXb : |∑ i, a i * (if i = j₀ then 0 else (v i - w k i))| ≤ (n : ℝ) * (|a j₀| * δ) := by
        calc |∑ i, a i * (if i = j₀ then 0 else (v i - w k i))|
            ≤ ∑ i, |a i * (if i = j₀ then 0 else (v i - w k i))| :=
              Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ _i : Fin n, |a j₀| * δ := Finset.sum_le_sum (fun i _ => by
              rw [abs_mul]
              apply mul_le_mul (hmax i) _ (abs_nonneg _) (abs_nonneg _)
              split_ifs with h
              · rw [abs_zero]; exact hδpos.le
              · exact hfree i h)
          _ = (n : ℝ) * (|a j₀| * δ) := by simp
      rw [hX, add_div, mul_div_cancel_left₀ _ ha0]
      have e2 : v j₀ - (w k j₀ + ((v j₀ - w k j₀)
          + (∑ i, a i * (if i = j₀ then 0 else (v i - w k i))) / a j₀))
          = -((∑ i, a i * (if i = j₀ then 0 else (v i - w k i))) / a j₀) := by ring
      rw [e2, abs_neg, abs_div, div_le_iff₀ haj, ← hnδ]
      nlinarith
    · have e : g k j = w k j := by simp only [g, if_neg hj, add_zero]
      rw [e]
      exact (hfree j hj).trans hδρ

theorem kai_nlc_log_grid {P : Type*} [Fintype P] [Nonempty P] (m : P → ℕ) (hm : ∀ p, 1 ≤ m p) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (R Y μ : ℝ), 3 ≤ R → 1 ≤ Y → 0 < μ → μ ≤ 1 →
      ∃ (I : Finset (P → ℕ)) (q : (P → ℝ) → P → ℕ),
        (I.card : ℝ) ≤ C * (Real.log R / μ) ^ (Fintype.card P - 1) ∧
        (∀ r : P → ℝ, (∀ p, 0 ≤ r p ∧ r p ≤ R) → ∏ p, r p ^ m p = Y → q r ∈ I) ∧
        (∀ r r' : P → ℝ, (∀ p, 0 ≤ r p ∧ r p ≤ R) → ∏ p, r p ^ m p = Y →
          (∀ p, 0 ≤ r' p ∧ r' p ≤ R) → ∏ p, r' p ^ m p = Y →
          q r = q r' → ∀ p, |r p - r' p| ≤ μ * R) :=
by
  classical
  
  have diag : ∀ (p₀ : P) (N : ℕ) (I : Finset (P → ℕ)), (∀ k ∈ I, ∀ p, k p ≤ N) →
      (∀ k ∈ I, ∀ k' ∈ I, ¬ ∀ p, k p < k' p) →
      I.card ≤ (2 * N + 1) ^ (Fintype.card P - 1) := by
    intro p₀ N I hI hdiag
    obtain ⟨T, hT_def⟩ : ∃ T : Finset (P → ℤ), T = Fintype.piFinset (fun p =>
        if p = p₀ then ({0} : Finset ℤ) else Finset.Icc (-(N : ℤ)) (N : ℤ)) := ⟨_, rfl⟩
    have hmaps : Set.MapsTo (fun (k : P → ℕ) (p : P) => (k p : ℤ) - (k p₀ : ℤ)) I T := by
      intro k hk
      rw [Finset.mem_coe] at hk
      rw [Finset.mem_coe, hT_def, Fintype.mem_piFinset]
      intro p
      dsimp only
      by_cases hp : p = p₀
      · subst hp
        rw [if_pos rfl, Finset.mem_singleton, sub_self]
      · rw [if_neg hp, Finset.mem_Icc]
        have h1 := hI k hk p
        have h2 := hI k hk p₀
        constructor <;> omega
    have hinj : Set.InjOn (fun (k : P → ℕ) (p : P) => (k p : ℤ) - (k p₀ : ℤ)) I := by
      intro k hk k' hk' hkk
      rw [Finset.mem_coe] at hk hk'
      have hp : ∀ p, (k p : ℤ) - k p₀ = (k' p : ℤ) - k' p₀ := fun p => congrFun hkk p
      rcases lt_trichotomy (k p₀) (k' p₀) with h | h | h
      · exfalso
        apply hdiag k hk k' hk'
        intro p
        have := hp p
        omega
      · funext p
        have := hp p
        omega
      · exfalso
        apply hdiag k' hk' k hk
        intro p
        have := hp p
        omega
    have hcard := Finset.card_le_card_of_injOn _ hmaps hinj
    have hT : T.card = (2 * N + 1) ^ (Fintype.card P - 1) := by
      rw [hT_def, Fintype.card_piFinset,
        ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ p₀),
        if_pos rfl, Finset.card_singleton, one_mul,
        Finset.prod_congr rfl (g := fun _ => 2 * N + 1)]
      · rw [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ]
      · intro p hp
        rw [if_neg (Finset.ne_of_mem_erase hp), Int.card_Icc]
        omega
    omega
  refine ⟨(3 : ℝ) ^ (Fintype.card P - 1), one_le_pow₀ (by norm_num), ?_⟩
  intro R Y μ hR hY hμ hμ1
  have hRpos : 0 < R := by linarith
  have hh : 0 < μ * R := mul_pos hμ hRpos
  
  have bucket : ∀ x y : ℝ, 0 ≤ x → 0 ≤ y →
      (⌊x / (μ * R)⌋₊ = ⌊y / (μ * R)⌋₊ → |x - y| ≤ μ * R) ∧
      (⌊x / (μ * R)⌋₊ < ⌊y / (μ * R)⌋₊ → x < y) := by
    intro x y hx hy
    have ha := div_nonneg hx hh.le
    have hb := div_nonneg hy hh.le
    have h1 := Nat.floor_le ha
    have h2 := Nat.lt_floor_add_one (x / (μ * R))
    have h3 := Nat.floor_le hb
    have h4 := Nat.lt_floor_add_one (y / (μ * R))
    constructor
    · intro heq
      rw [heq] at h1 h2
      have hab : |x / (μ * R) - y / (μ * R)| ≤ 1 := by
        rw [abs_le]; constructor <;> linarith
      have hxy : x - y = (x / (μ * R) - y / (μ * R)) * (μ * R) := by
        rw [sub_mul, div_mul_cancel₀ _ hh.ne', div_mul_cancel₀ _ hh.ne']
      rw [hxy, abs_mul, abs_of_pos hh]
      calc |x / (μ * R) - y / (μ * R)| * (μ * R) ≤ 1 * (μ * R) :=
            mul_le_mul_of_nonneg_right hab hh.le
        _ = μ * R := one_mul _
    · intro hlt
      have hlt' : (⌊x / (μ * R)⌋₊ : ℝ) + 1 ≤ ⌊y / (μ * R)⌋₊ := by exact_mod_cast hlt
      have : x / (μ * R) < y / (μ * R) := by linarith
      exact (div_lt_div_iff_of_pos_right hh).1 this
  
  have pmono : ∀ r r' : P → ℝ, (∀ p, 0 ≤ r p) → 0 < ∏ p, r p ^ m p → (∀ p, r p < r' p) →
      ∏ p, r p ^ m p < ∏ p, r' p ^ m p := by
    intro r r' hr hpos hlt
    have hm0 : ∀ p, m p ≠ 0 := fun p => by have := hm p; omega
    apply Finset.prod_lt_prod_of_nonempty
    · intro p _
      have hne : r p ≠ 0 := by
        intro h0
        have : ∏ p, r p ^ m p = 0 :=
          Finset.prod_eq_zero (Finset.mem_univ p) (by rw [h0, zero_pow (hm0 p)])
        linarith
      exact pow_pos (lt_of_le_of_ne (hr p) (Ne.symm hne)) _
    · intro p _
      exact pow_lt_pow_left₀ (hlt p) (hr p) (hm0 p)
    · exact Finset.univ_nonempty
  
  obtain ⟨N, hN_def⟩ : ∃ N : ℕ, N = ⌊1 / μ⌋₊ := ⟨_, rfl⟩
  obtain ⟨I, hI_def⟩ : ∃ I : Finset (P → ℕ),
      I = (Fintype.piFinset (fun _ : P => Finset.range (N + 1))).filter
        (fun k => ∃ r : P → ℝ, ((∀ p, 0 ≤ r p ∧ r p ≤ R) ∧ ∏ p, r p ^ m p = Y) ∧
          (fun p => ⌊r p / (μ * R)⌋₊) = k) := ⟨_, rfl⟩
  have hRdiv : R / (μ * R) = 1 / μ := by
    field_simp
  have hqN : ∀ r : P → ℝ, (∀ p, 0 ≤ r p ∧ r p ≤ R) → ∀ p, ⌊r p / (μ * R)⌋₊ ≤ N := by
    intro r hr p
    rw [hN_def]
    apply Nat.floor_mono
    rw [← hRdiv]
    exact div_le_div_of_nonneg_right (hr p).2 hh.le
  
  have hmem : ∀ r : P → ℝ, (∀ p, 0 ≤ r p ∧ r p ≤ R) → ∏ p, r p ^ m p = Y →
      (fun p => ⌊r p / (μ * R)⌋₊) ∈ I := by
    intro r hr hrY
    rw [hI_def, Finset.mem_filter, Fintype.mem_piFinset]
    exact ⟨fun p => Finset.mem_range.2 (Nat.lt_succ_of_le (hqN r hr p)), r, ⟨hr, hrY⟩, rfl⟩
  
  have hIb : ∀ k ∈ I, ∀ p, k p ≤ N := by
    intro k hk p
    rw [hI_def, Finset.mem_filter, Fintype.mem_piFinset] at hk
    exact Nat.lt_succ_iff.1 (Finset.mem_range.1 (hk.1 p))
  have hdiag : ∀ k ∈ I, ∀ k' ∈ I, ¬ ∀ p, k p < k' p := by
    intro k hk k' hk' hlt
    rw [hI_def, Finset.mem_filter] at hk hk'
    obtain ⟨_, r, ⟨hr, hrY⟩, rfl⟩ := hk
    obtain ⟨_, r', ⟨hr', hr'Y⟩, rfl⟩ := hk'
    have hlt2 := pmono r r' (fun p => (hr p).1) (by rw [hrY]; linarith)
      (fun p => (bucket _ _ (hr p).1 (hr' p).1).2 (hlt p))
    rw [hrY, hr'Y] at hlt2
    exact lt_irrefl _ hlt2
  have hcardN := diag (Classical.arbitrary P) N I hIb hdiag
  
  have hlogR : 1 ≤ Real.log R := by
    rw [Real.le_log_iff_exp_le hRpos]
    have := Real.exp_one_lt_d9
    linarith
  have hNle : (N : ℝ) ≤ 1 / μ := by
    rw [hN_def]; exact Nat.floor_le (by positivity)
  have h1μ : 1 ≤ 1 / μ := one_le_one_div hμ hμ1
  have hdiv : 1 / μ ≤ Real.log R / μ := div_le_div_of_nonneg_right hlogR hμ.le
  have hbase : ((2 * N + 1 : ℕ) : ℝ) ≤ 3 * (Real.log R / μ) := by
    push_cast; linarith
  refine ⟨I, fun r p => ⌊r p / (μ * R)⌋₊, ?_, hmem, ?_⟩
  · calc (I.card : ℝ) ≤ (((2 * N + 1) ^ (Fintype.card P - 1) : ℕ) : ℝ) := by
          exact_mod_cast hcardN
      _ = ((2 * N + 1 : ℕ) : ℝ) ^ (Fintype.card P - 1) := by push_cast; ring
      _ ≤ (3 * (Real.log R / μ)) ^ (Fintype.card P - 1) :=
          pow_le_pow_left₀ (by positivity) hbase _
      _ = 3 ^ (Fintype.card P - 1) * (Real.log R / μ) ^ (Fintype.card P - 1) := mul_pow _ _ _
  · 
    intro r r' hr _ hr' _ hq p
    exact (bucket _ _ (hr p).1 (hr' p).1).1 (congrFun hq p)

theorem kai_nlc_angle_quantizer (K : Type u) [Field K] [NumberField K] (μ : ℝ) (hμ : 0 < μ)
    (hμ1 : μ ≤ 1) :
    ∃ (s : NumberField.mixedEmbedding.mixedSpace K → NumberField.InfinitePlace K → ℤ)
      (S : NumberField.InfinitePlace K → Finset ℤ),
      (∀ z w, s z w ∈ S w) ∧
      (∀ w, ((S w).card : ℝ) ≤ 9 * (1 / μ) ^ (w.mult - 1)) ∧
      ∀ (z z' : NumberField.mixedEmbedding.mixedSpace K) (w : NumberField.InfinitePlace K)
        (δ R : ℝ), s z w = s z' w →
        |NumberField.mixedEmbedding.normAtPlace w z
            - NumberField.mixedEmbedding.normAtPlace w z'| ≤ δ →
        NumberField.mixedEmbedding.normAtPlace w z' ≤ R →
        NumberField.mixedEmbedding.normAtPlace w (z - z') ≤ δ + μ * R :=
by
  classical
  
  have real_close : ∀ x x' : ℝ, (0 < x ↔ 0 < x') → |x - x'| ≤ |(|x| - |x'|)| := by
    intro x x' h
    by_cases hx : 0 < x
    · have hx' := h.mp hx
      rw [abs_of_pos hx, abs_of_pos hx']
    · have hx' : ¬ 0 < x' := fun h' => hx (h.mpr h')
      push_neg at hx hx'
      rw [abs_of_nonpos hx, abs_of_nonpos hx', neg_sub_neg, abs_sub_comm]
  
  have cplx_close : ∀ u u' : ℂ, ⌊Complex.arg u / μ⌋ = ⌊Complex.arg u' / μ⌋ →
      ‖u - u'‖ ≤ |‖u‖ - ‖u'‖| + μ * ‖u'‖ := by
    intro u u' h
    have h1 := Int.floor_le (Complex.arg u / μ)
    have h2 := Int.lt_floor_add_one (Complex.arg u / μ)
    have h3 := Int.floor_le (Complex.arg u' / μ)
    have h4 := Int.lt_floor_add_one (Complex.arg u' / μ)
    rw [h] at h1 h2
    have hgap : |Complex.arg u - Complex.arg u'| < μ := by
      have hlt : |Complex.arg u / μ - Complex.arg u' / μ| < 1 := by
        rw [abs_sub_lt_iff]; constructor <;> linarith
      rw [← sub_div, abs_div, abs_of_pos hμ, div_lt_one hμ] at hlt
      exact hlt
    have pu : (‖u‖ : ℂ) * Complex.exp (Complex.arg u * Complex.I) = u :=
      Complex.norm_mul_exp_arg_mul_I u
    have pu' : (‖u'‖ : ℂ) * Complex.exp (Complex.arg u' * Complex.I) = u' :=
      Complex.norm_mul_exp_arg_mul_I u'
    have he : ‖Complex.exp (Complex.arg u * Complex.I)‖ = 1 :=
      Complex.norm_exp_ofReal_mul_I _
    have he' : ‖Complex.exp (Complex.arg u' * Complex.I)‖ = 1 :=
      Complex.norm_exp_ofReal_mul_I _
    have hrot : Complex.exp (Complex.arg u * Complex.I)
        = Complex.exp (Complex.arg u' * Complex.I) *
          Complex.exp (Complex.I * ((Complex.arg u - Complex.arg u' : ℝ) : ℂ)) := by
      rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    have hee_le : ‖Complex.exp (Complex.arg u * Complex.I)
        - Complex.exp (Complex.arg u' * Complex.I)‖ ≤ μ := by
      have hfac : Complex.exp (Complex.arg u * Complex.I)
          - Complex.exp (Complex.arg u' * Complex.I)
          = Complex.exp (Complex.arg u' * Complex.I) *
            (Complex.exp (Complex.I * ((Complex.arg u - Complex.arg u' : ℝ) : ℂ)) - 1) := by
        rw [hrot]; ring
      rw [hfac, norm_mul, he', one_mul]
      have hb := Real.norm_exp_I_mul_ofReal_sub_one_le (x := Complex.arg u - Complex.arg u')
      rw [Real.norm_eq_abs] at hb
      linarith
    have decomp : u - u' = ((‖u‖ - ‖u'‖ : ℝ) : ℂ) * Complex.exp (Complex.arg u * Complex.I)
        + (‖u'‖ : ℂ) * (Complex.exp (Complex.arg u * Complex.I)
          - Complex.exp (Complex.arg u' * Complex.I)) := by
      calc u - u' = (‖u‖ : ℂ) * Complex.exp (Complex.arg u * Complex.I)
            - (‖u'‖ : ℂ) * Complex.exp (Complex.arg u' * Complex.I) := by rw [pu, pu']
        _ = _ := by push_cast; ring
    calc ‖u - u'‖
        = ‖((‖u‖ - ‖u'‖ : ℝ) : ℂ) * Complex.exp (Complex.arg u * Complex.I)
            + (‖u'‖ : ℂ) * (Complex.exp (Complex.arg u * Complex.I)
              - Complex.exp (Complex.arg u' * Complex.I))‖ := by rw [← decomp]
      _ ≤ ‖((‖u‖ - ‖u'‖ : ℝ) : ℂ) * Complex.exp (Complex.arg u * Complex.I)‖
            + ‖(‖u'‖ : ℂ) * (Complex.exp (Complex.arg u * Complex.I)
              - Complex.exp (Complex.arg u' * Complex.I))‖ := norm_add_le _ _
      _ = |‖u‖ - ‖u'‖| + ‖u'‖ * ‖Complex.exp (Complex.arg u * Complex.I)
              - Complex.exp (Complex.arg u' * Complex.I)‖ := by
          rw [norm_mul, norm_mul, he, mul_one, Complex.norm_real, Complex.norm_real, norm_norm,
            Real.norm_eq_abs]
      _ ≤ |‖u‖ - ‖u'‖| + ‖u'‖ * μ := by gcongr
      _ = |‖u‖ - ‖u'‖| + μ * ‖u'‖ := by ring
  
  have card_bd : ((Finset.Icc ⌊-Real.pi / μ⌋ ⌊Real.pi / μ⌋).card : ℝ) ≤ 9 / μ := by
    rw [Int.card_Icc]
    have hb := Int.floor_le (Real.pi / μ)
    have ha := Int.lt_floor_add_one (-Real.pi / μ)
    have hpi := Real.pi_pos
    have hpi2 := Real.pi_lt_d2
    have hab : ⌊-Real.pi / μ⌋ ≤ ⌊Real.pi / μ⌋ :=
      Int.floor_mono (div_le_div_of_nonneg_right (by linarith) hμ.le)
    have hnn : 0 ≤ ⌊Real.pi / μ⌋ + 1 - ⌊-Real.pi / μ⌋ := by omega
    rw [show (((⌊Real.pi / μ⌋ + 1 - ⌊-Real.pi / μ⌋).toNat : ℕ) : ℝ)
        = (((⌊Real.pi / μ⌋ + 1 - ⌊-Real.pi / μ⌋).toNat : ℤ) : ℝ) from
          (Int.cast_natCast _).symm, Int.toNat_of_nonneg hnn]
    push_cast
    rw [le_div_iff₀ hμ]
    have hb' := (le_div_iff₀ hμ).mp hb
    have ha' := (div_lt_iff₀ hμ).mp ha
    have e1 : ((⌊Real.pi / μ⌋ : ℝ) + 1 - (⌊-Real.pi / μ⌋ : ℝ)) * μ
        = (⌊Real.pi / μ⌋ : ℝ) * μ + μ - (⌊-Real.pi / μ⌋ : ℝ) * μ := by ring
    have e2 : ((⌊-Real.pi / μ⌋ : ℝ) + 1) * μ = (⌊-Real.pi / μ⌋ : ℝ) * μ + μ := by ring
    rw [e1]
    rw [e2] at ha'
    linarith
  refine ⟨fun z w => if h : w.IsReal then (if 0 < z.1 ⟨w, h⟩ then (1 : ℤ) else 0)
      else ⌊Complex.arg (z.2 ⟨w, NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h⟩) / μ⌋,
    fun w => if w.IsReal then ({0, 1} : Finset ℤ) else Finset.Icc ⌊-Real.pi / μ⌋ ⌊Real.pi / μ⌋,
    ?_, ?_, ?_⟩
  · intro z w
    by_cases h : w.IsReal
    · simp only [dif_pos h, if_pos h]
      split_ifs <;> simp
    · simp only [dif_neg h, if_neg h, Finset.mem_Icc]
      constructor
      · apply Int.floor_mono
        exact div_le_div_of_nonneg_right (Complex.neg_pi_lt_arg _).le hμ.le
      · apply Int.floor_mono
        exact div_le_div_of_nonneg_right (Complex.arg_le_pi _) hμ.le
  · intro w
    by_cases h : w.IsReal
    · have hm : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, h⟩
      simp only [if_pos h, hm]
      rw [Finset.card_pair (by norm_num)]
      norm_num
    · have hc := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h
      have hm : w.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w, hc⟩
      simp only [if_neg h, hm]
      calc ((Finset.Icc ⌊-Real.pi / μ⌋ ⌊Real.pi / μ⌋).card : ℝ) ≤ 9 / μ := card_bd
        _ = 9 * (1 / μ) ^ (2 - 1) := by norm_num [div_eq_mul_inv]
  · intro z z' w δ R hs hδ hR
    have hn0 := NumberField.mixedEmbedding.normAtPlace_nonneg w z'
    have hμR : 0 ≤ μ * R := mul_nonneg hμ.le (by linarith)
    by_cases h : w.IsReal
    · simp only [dif_pos h] at hs
      simp only [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal h, Prod.fst_sub,
        Pi.sub_apply, Real.norm_eq_abs] at hδ hR ⊢
      have hiff : 0 < z.1 ⟨w, h⟩ ↔ 0 < z'.1 ⟨w, h⟩ := by
        by_cases h1 : 0 < z.1 ⟨w, h⟩
        · by_cases h2 : 0 < z'.1 ⟨w, h⟩
          · exact iff_of_true h1 h2
          · rw [if_pos h1, if_neg h2] at hs; norm_num at hs
        · by_cases h2 : 0 < z'.1 ⟨w, h⟩
          · rw [if_neg h1, if_pos h2] at hs; norm_num at hs
          · exact iff_of_false h1 h2
      have hc := real_close _ _ hiff
      linarith
    · have hc := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h
      simp only [dif_neg h] at hs
      simp only [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hc, Prod.snd_sub,
        Pi.sub_apply] at hδ hR ⊢
      have hcl := cplx_close (z.2 ⟨w, hc⟩) (z'.2 ⟨w, hc⟩) hs
      have hmR := mul_le_mul_of_nonneg_left hR hμ.le
      linarith

theorem kai_bc_norm_level_cover (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C_G : ℝ, 1 ≤ C_G ∧ ∀ (M Y ρ : ℝ), 3 ≤ M → 1 ≤ Y → 0 < ρ → ρ ≤ M →
      ∃ Z : Finset (Fin (Module.finrank ℚ K) → ℝ),
        (Z.card : ℝ) ≤ C_G * (M * Real.log M / ρ) ^ (Module.finrank ℚ K - 1) ∧
        ∀ v : Fin (Module.finrank ℚ K) → ℝ, (∀ j, |v j| ≤ M) →
          NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v) = Y →
          ∃ z ∈ Z, ∀ j, |v j - z j| ≤ ρ :=
by
  classical
  obtain ⟨κ, hκ, hup, hlow⟩ := kai_bc_omega_emb_bounds K ω
  have hm : ∀ w : NumberField.InfinitePlace K, 1 ≤ w.mult := fun w => by
    have h := @NumberField.InfinitePlace.one_le_mult K _ w
    exact_mod_cast h
  obtain ⟨C_r, hC_r, hgrid⟩ :=
    kai_nlc_log_grid (fun w : NumberField.InfinitePlace K => w.mult) hm
  have hκ0 : 0 < κ := by linarith
  have hlogκ : 0 ≤ Real.log κ := Real.log_nonneg hκ
  have hκ2 : 1 ≤ κ ^ 2 := one_le_pow₀ hκ
  have hlog_ge : ∀ x : ℝ, 3 ≤ x → 1 ≤ Real.log x := by
    intro x hx
    rw [Real.le_log_iff_exp_le (by linarith)]
    have := Real.exp_one_lt_d9
    linarith
  refine ⟨9 ^ Fintype.card (NumberField.InfinitePlace K) * C_r *
      (4 * κ ^ 2 * (1 + Real.log κ)) ^ (Module.finrank ℚ K - 1), ?_, ?_⟩
  · have h1 : (1 : ℝ) ≤ 9 ^ Fintype.card (NumberField.InfinitePlace K) :=
      one_le_pow₀ (by norm_num)
    have h2 : (1 : ℝ) ≤ (4 * κ ^ 2 * (1 + Real.log κ)) ^ (Module.finrank ℚ K - 1) := by
      apply one_le_pow₀
      nlinarith
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h1 hC_r) h2
  intro M Y ρ hM hY hρ hρM
  have hM0 : 0 < M := by linarith
  obtain ⟨R, hR_def⟩ : ∃ R : ℝ, R = κ * M := ⟨_, rfl⟩
  have hR3 : 3 ≤ R := by rw [hR_def]; nlinarith
  have hden : 0 < 4 * κ ^ 2 * M := by positivity
  obtain ⟨μ, hμ_def⟩ : ∃ μ : ℝ, μ = ρ / (4 * κ ^ 2 * M) := ⟨_, rfl⟩
  have hμ0 : 0 < μ := by rw [hμ_def]; exact div_pos hρ hden
  have hμ1 : μ ≤ 1 := by
    rw [hμ_def, div_le_one hden]
    nlinarith
  have h2μR : μ * R + μ * R = ρ / (2 * κ) := by
    rw [hμ_def, hR_def]; field_simp; ring
  obtain ⟨I_r, q, hIcard, hmem, hclose⟩ := hgrid R Y μ hR3 hY hμ0 hμ1
  obtain ⟨s, S, hsS, hScard, hsclose⟩ := kai_nlc_angle_quantizer K μ hμ0 hμ1
  
  let T : (Fin (Module.finrank ℚ K) → ℝ) → NumberField.mixedEmbedding.mixedSpace K :=
    fun v => kaiOmegaEmb ω v
  let rv : NumberField.mixedEmbedding.mixedSpace K → NumberField.InfinitePlace K → ℝ :=
    fun z w => NumberField.mixedEmbedding.normAtPlace w z
  let ι : (Fin (Module.finrank ℚ K) → ℝ) →
      (NumberField.InfinitePlace K → ℕ) × (NumberField.InfinitePlace K → ℤ) :=
    fun v => (q (rv (T v)), s (T v))
  let I := I_r ×ˢ Fintype.piFinset S
  let good : (Fin (Module.finrank ℚ K) → ℝ) → Prop := fun v =>
    (∀ j, |v j| ≤ M) ∧ NumberField.mixedEmbedding.norm (T v) = Y
  
  have hadm : ∀ v, good v →
      (∀ w, 0 ≤ rv (T v) w ∧ rv (T v) w ≤ R) ∧ ∏ w, rv (T v) w ^ w.mult = Y := by
    intro v hv
    refine ⟨fun w => ⟨NumberField.mixedEmbedding.normAtPlace_nonneg w _, ?_⟩, ?_⟩
    · rw [hR_def]; exact hup v M hv.1 w
    · rw [← hv.2, NumberField.mixedEmbedding.norm_apply]
  
  have hcl : ∀ v v', good v → good v' → ι v = ι v' → ∀ w,
      NumberField.mixedEmbedding.normAtPlace w (T v - T v') ≤ μ * R + μ * R := by
    intro v v' hv hv' hvv' w
    have hq : q (rv (T v)) = q (rv (T v')) := congrArg Prod.fst hvv'
    have hs : s (T v) = s (T v') := congrArg Prod.snd hvv'
    obtain ⟨a1, a2⟩ := hadm v hv
    obtain ⟨b1, b2⟩ := hadm v' hv'
    have h1 := hclose _ _ a1 a2 b1 b2 hq w
    exact hsclose (T v) (T v') w (μ * R) R (congrFun hs w) h1 (b1 w).2
  
  have hlin : ∀ v v', T v - T v' = T (v - v') := by
    intro v v'
    simp only [T, kaiOmegaEmb, Pi.sub_apply, sub_smul, Finset.sum_sub_distrib]
  have hmemI : ∀ v, good v → ι v ∈ I := by
    intro v hv
    simp only [I, Finset.mem_product, Fintype.mem_piFinset]
    exact ⟨hmem _ (hadm v hv).1 (hadm v hv).2, fun w => hsS _ w⟩
  let pick : (NumberField.InfinitePlace K → ℕ) × (NumberField.InfinitePlace K → ℤ) →
      (Fin (Module.finrank ℚ K) → ℝ) := fun b =>
    if h : ∃ v, good v ∧ ι v = b then h.choose else 0
  refine ⟨I.image pick, ?_, ?_⟩
  · 
    have hcard1 : ((I.image pick).card : ℝ) ≤ (I.card : ℝ) := by
      exact_mod_cast Finset.card_image_le
    have hcardI : (I.card : ℝ) = (I_r.card : ℝ) * ∏ w, ((S w).card : ℝ) := by
      simp only [I, Finset.card_product, Fintype.card_piFinset]
      push_cast
      rfl
    obtain ⟨X, hX_def⟩ : ∃ X : ℝ, X = Real.log R / μ := ⟨_, rfl⟩
    rw [← hX_def] at hIcard
    have hlogR : 1 ≤ Real.log R := hlog_ge R hR3
    have hinvX : 1 / μ ≤ X := by
      rw [hX_def]; exact div_le_div_of_nonneg_right hlogR hμ0.le
    have hinv1 : 1 ≤ 1 / μ := by rw [le_div_iff₀ hμ0]; linarith
    have hX1 : 1 ≤ X := le_trans hinv1 hinvX
    have hX0 : 0 ≤ X := by linarith
    have hS' : ∀ w : NumberField.InfinitePlace K,
        ((S w).card : ℝ) ≤ 9 * X ^ (w.mult - 1) := fun w =>
      (hScard w).trans (mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (by positivity) hinvX _) (by norm_num))
    have hprod : ∏ w, ((S w).card : ℝ) ≤
        ∏ w : NumberField.InfinitePlace K, (9 * X ^ (w.mult - 1)) :=
      Finset.prod_le_prod (fun w _ => by positivity) (fun w _ => hS' w)
    have hprod_eq : ∏ w : NumberField.InfinitePlace K, (9 * X ^ (w.mult - 1)) =
        9 ^ Fintype.card (NumberField.InfinitePlace K) *
          X ^ (∑ w : NumberField.InfinitePlace K, (w.mult - 1)) := by
      rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
        Finset.prod_pow_eq_pow_sum]
    have hexp : (Fintype.card (NumberField.InfinitePlace K) - 1) +
        ∑ w : NumberField.InfinitePlace K, (w.mult - 1) = Module.finrank ℚ K - 1 := by
      have h1 : ∑ w : NumberField.InfinitePlace K, (w.mult - 1) +
          Fintype.card (NumberField.InfinitePlace K) = Module.finrank ℚ K := by
        rw [← NumberField.InfinitePlace.sum_mult_eq, ← Finset.card_univ,
          Finset.card_eq_sum_ones, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun w _ => Nat.sub_add_cancel (hm w))
      have h2 : 1 ≤ Fintype.card (NumberField.InfinitePlace K) := Fintype.card_pos
      omega
    have hIbound : (I.card : ℝ) ≤ 9 ^ Fintype.card (NumberField.InfinitePlace K) * C_r *
        X ^ (Module.finrank ℚ K - 1) := by
      rw [hcardI]
      calc (I_r.card : ℝ) * ∏ w, ((S w).card : ℝ)
          ≤ (C_r * X ^ (Fintype.card (NumberField.InfinitePlace K) - 1)) *
            (9 ^ Fintype.card (NumberField.InfinitePlace K) *
              X ^ (∑ w : NumberField.InfinitePlace K, (w.mult - 1))) := by
            rw [← hprod_eq]
            exact mul_le_mul hIcard hprod (Finset.prod_nonneg (fun _ _ => by positivity))
              (mul_nonneg (by linarith) (by positivity))
        _ = 9 ^ Fintype.card (NumberField.InfinitePlace K) * C_r *
            X ^ (Module.finrank ℚ K - 1) := by
            rw [← hexp, pow_add]; ring
    have hlogM : 1 ≤ Real.log M := hlog_ge M hM
    have hlogR_le : Real.log R ≤ (1 + Real.log κ) * Real.log M := by
      rw [hR_def, Real.log_mul hκ0.ne' hM0.ne']
      nlinarith
    have hXle : X ≤ 4 * κ ^ 2 * (1 + Real.log κ) * (M * Real.log M / ρ) := by
      rw [hX_def, hμ_def, div_div_eq_mul_div, div_le_iff₀ hρ]
      have e : 4 * κ ^ 2 * (1 + Real.log κ) * (M * Real.log M / ρ) * ρ
          = 4 * κ ^ 2 * M * ((1 + Real.log κ) * Real.log M) := by
        field_simp
      rw [e, mul_comm]
      exact mul_le_mul_of_nonneg_left hlogR_le hden.le
    have hpow : X ^ (Module.finrank ℚ K - 1) ≤
        (4 * κ ^ 2 * (1 + Real.log κ)) ^ (Module.finrank ℚ K - 1) *
          (M * Real.log M / ρ) ^ (Module.finrank ℚ K - 1) := by
      rw [← mul_pow]; exact pow_le_pow_left₀ hX0 hXle _
    have hc0 : 0 ≤ 9 ^ Fintype.card (NumberField.InfinitePlace K) * C_r :=
      mul_nonneg (by positivity) (by linarith)
    calc ((I.image pick).card : ℝ) ≤ I.card := hcard1
      _ ≤ 9 ^ Fintype.card (NumberField.InfinitePlace K) * C_r *
          X ^ (Module.finrank ℚ K - 1) := hIbound
      _ ≤ 9 ^ Fintype.card (NumberField.InfinitePlace K) * C_r *
          ((4 * κ ^ 2 * (1 + Real.log κ)) ^ (Module.finrank ℚ K - 1) *
            (M * Real.log M / ρ) ^ (Module.finrank ℚ K - 1)) :=
          mul_le_mul_of_nonneg_left hpow hc0
      _ = _ := by ring
  · 
    intro v hvM hvY
    have hv : good v := ⟨hvM, hvY⟩
    have hex : ∃ v', good v' ∧ ι v' = ι v := ⟨v, hv, rfl⟩
    refine ⟨pick (ι v), Finset.mem_image_of_mem _ (hmemI v hv), ?_⟩
    have hpick : pick (ι v) = hex.choose := dif_pos hex
    obtain ⟨hg', hι'⟩ := hex.choose_spec
    rw [hpick]
    intro j
    have hw : ∀ w, NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω (v - hex.choose))
        ≤ μ * R + μ * R := by
      intro w
      have h := hcl v _ hv hg' hι'.symm w
      rw [hlin] at h
      exact h
    have hj := hlow (v - hex.choose) (μ * R + μ * R) hw j
    simp only [Pi.sub_apply] at hj
    calc |v j - hex.choose j| ≤ κ * (μ * R + μ * R) := hj
      _ = ρ / 2 := by rw [h2μR]; field_simp
      _ ≤ ρ := by linarith

theorem kai_bc_segment_crossing (n : ℕ) {ι : Type*} [Fintype ι] (m Y : ℝ)
    (f : (Fin n → ℝ) → ℝ) (g : ι → (Fin n → ℝ) → ℝ) (b : ι → Bool)
    (hf : Continuous f) (hg : ∀ i, Continuous (g i)) (v₁ v₂ : Fin n → ℝ)
    (h₁ : (∀ l, |v₁ l| ≤ m) ∧ f v₁ ≤ Y ∧ ∀ i, (0 < g i v₁ ↔ b i = true))
    (h₂ : ¬ ((∀ l, |v₂ l| ≤ m) ∧ f v₂ ≤ Y ∧ ∀ i, (0 < g i v₂ ↔ b i = true))) :
    ∃ t : ℝ, 0 ≤ t ∧ t ≤ 1 ∧ (∀ l, |(v₁ + t • (v₂ - v₁)) l| ≤ m) ∧
      ((∃ l, |(v₁ + t • (v₂ - v₁)) l| = m) ∨ f (v₁ + t • (v₂ - v₁)) = Y ∨
        ∃ i, g i (v₁ + t • (v₂ - v₁)) = 0) :=
by
  classical
  by_contra hcon
  push_neg at hcon
  have hγ : Continuous fun t : ℝ => v₁ + t • (v₂ - v₁) := by fun_prop
  have hγl : ∀ l, Continuous fun t : ℝ => (v₁ + t • (v₂ - v₁)) l :=
    fun l => (continuous_apply l).comp hγ
  have hfγ : Continuous fun t : ℝ => f (v₁ + t • (v₂ - v₁)) := hf.comp hγ
  have hgγ : ∀ i, Continuous fun t : ℝ => g i (v₁ + t • (v₂ - v₁)) :=
    fun i => (hg i).comp hγ
  let σ : ι → ℝ := fun i => if b i = true then 1 else -1
  have hσ : ∀ i, σ i ≠ 0 := by
    intro i; simp only [σ]; split_ifs <;> norm_num
  let U : Set ℝ := {t | (∀ l, |(v₁ + t • (v₂ - v₁)) l| < m) ∧ f (v₁ + t • (v₂ - v₁)) < Y ∧
      ∀ i, 0 < σ i * g i (v₁ + t • (v₂ - v₁))}
  let C : Set ℝ := {t | (∀ l, |(v₁ + t • (v₂ - v₁)) l| ≤ m) ∧ f (v₁ + t • (v₂ - v₁)) ≤ Y ∧
      ∀ i, 0 ≤ σ i * g i (v₁ + t • (v₂ - v₁))}
  have hU : IsOpen U := by
    have e : U = (⋂ l, {t : ℝ | |(v₁ + t • (v₂ - v₁)) l| < m}) ∩
        ({t : ℝ | f (v₁ + t • (v₂ - v₁)) < Y} ∩
          ⋂ i, {t : ℝ | 0 < σ i * g i (v₁ + t • (v₂ - v₁))}) := by
      ext t; simp only [U, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
    rw [e]
    exact (isOpen_iInter_of_finite fun l => isOpen_lt (hγl l).abs continuous_const).inter
      ((isOpen_lt hfγ continuous_const).inter
        (isOpen_iInter_of_finite fun i =>
          isOpen_lt continuous_const (continuous_const.mul (hgγ i))))
  have hC : IsClosed C := by
    have e : C = (⋂ l, {t : ℝ | |(v₁ + t • (v₂ - v₁)) l| ≤ m}) ∩
        ({t : ℝ | f (v₁ + t • (v₂ - v₁)) ≤ Y} ∩
          ⋂ i, {t : ℝ | 0 ≤ σ i * g i (v₁ + t • (v₂ - v₁))}) := by
      ext t; simp only [C, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
    rw [e]
    exact (isClosed_iInter fun l => isClosed_le (hγl l).abs continuous_const).inter
      ((isClosed_le hfγ continuous_const).inter
        (isClosed_iInter fun i =>
          isClosed_le continuous_const (continuous_const.mul (hgγ i))))
  have key : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → t ∈ C → t ∈ U := by
    intro t h0 h1 htC
    simp only [C, U, Set.mem_setOf_eq] at htC ⊢
    obtain ⟨hb, hfY, hgi⟩ := htC
    obtain ⟨hne, hfne, hgne⟩ := hcon t h0 h1 hb
    refine ⟨fun l => lt_of_le_of_ne (hb l) (hne l), lt_of_le_of_ne hfY hfne, fun i => ?_⟩
    exact lt_of_le_of_ne (hgi i) (Ne.symm (mul_ne_zero (hσ i) (hgne i)))
  have UC : U ⊆ C := by
    intro t ht
    simp only [C, U, Set.mem_setOf_eq] at ht ⊢
    obtain ⟨ha, hb, hc⟩ := ht
    exact ⟨fun l => (ha l).le, hb.le, fun i => (hc i).le⟩
  have PU : ∀ v : Fin n → ℝ, (∀ i, 0 < σ i * g i v) → ∀ i, (0 < g i v ↔ b i = true) := by
    intro v h i
    have hi := h i
    rcases Bool.eq_false_or_eq_true (b i) with hbi | hbi
    · have hs : σ i = 1 := by simp [σ, hbi]
      rw [hs] at hi
      exact ⟨fun _ => hbi, fun _ => by linarith⟩
    · have hs : σ i = -1 := by simp [σ, hbi]
      rw [hs] at hi
      refine ⟨fun h' => ?_, fun h' => ?_⟩
      · exfalso; linarith
      · rw [hbi] at h'; exact absurd h' (by decide)
  have PC : ∀ v : Fin n → ℝ, (∀ i, (0 < g i v ↔ b i = true)) → ∀ i, 0 ≤ σ i * g i v := by
    intro v h i
    rcases Bool.eq_false_or_eq_true (b i) with hbi | hbi
    · have hs : σ i = 1 := by simp [σ, hbi]
      rw [hs]
      have := (h i).2 hbi
      linarith
    · have hs : σ i = -1 := by simp [σ, hbi]
      rw [hs]
      have hn : ¬ 0 < g i v := by
        intro h'
        have h2 := (h i).1 h'
        rw [hbi] at h2
        exact absurd h2 (by decide)
      push_neg at hn
      linarith
  have e0 : v₁ + (0 : ℝ) • (v₂ - v₁) = v₁ := by simp
  have e1 : v₁ + (1 : ℝ) • (v₂ - v₁) = v₂ := by simp
  have h0 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 ∩ U := by
    refine ⟨⟨le_rfl, zero_le_one⟩, key 0 le_rfl zero_le_one ?_⟩
    simp only [C, Set.mem_setOf_eq]
    rw [e0]
    exact ⟨h₁.1, h₁.2.1, PC v₁ h₁.2.2⟩
  have h1 : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 ∩ Cᶜ := by
    refine ⟨⟨zero_le_one, le_rfl⟩, fun hC1 => h₂ ?_⟩
    have hU1 := key 1 zero_le_one le_rfl hC1
    simp only [U, Set.mem_setOf_eq] at hU1
    rw [e1] at hU1
    obtain ⟨ha, hb, hc⟩ := hU1
    exact ⟨fun l => (ha l).le, hb.le, PU v₂ hc⟩
  have hcover : Set.Icc (0 : ℝ) 1 ⊆ U ∪ Cᶜ := by
    intro t ht
    by_cases htC : t ∈ C
    · exact Or.inl (key t ht.1 ht.2 htC)
    · exact Or.inr htC
  have hpc : IsPreconnected (Set.Icc (0 : ℝ) 1) := isPreconnected_Icc
  obtain ⟨t, -, htU, htC⟩ := hpc U Cᶜ hU hC.isOpen_compl hcover ⟨0, h0⟩ ⟨1, h1⟩
  exact htC (UC htU)

theorem kai_bc_dictionary (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∀ (M Y : ℝ) (o : KaiPattern K) (x₀ e : NumberField.RingOfIntegers K)
      (y : Fin (Module.finrank ℚ K) → ℤ) (v : Fin (Module.finrank ℚ K) → ℝ),
      (∀ l, v l = ((ω.repr x₀ l : ℤ) : ℝ) +
        ∑ j, ((y j : ℤ) : ℝ) * ((ω.repr (e * ω j) l : ℤ) : ℝ)) →
      (x₀ + e * ω.equivFun.symm y ∈ kaiCutoffSet ω M Y o ↔
        ((∀ l, |v l| ≤ ((⌊M⌋₊ : ℕ) : ℝ)) ∧
          NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v) ≤ Y ∧
          ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
            (0 < (kaiOmegaEmb ω v).1 w ↔ o w = true))) :=
by
  classical
  intro M Y o x₀ e y v hv
  
  have hemb : ∀ z : NumberField.RingOfIntegers K,
      kaiOmegaEmb ω (fun l => ((ω.repr z l : ℤ) : ℝ)) =
        NumberField.mixedEmbedding K (z : K) := by
    intro z
    let φ : NumberField.RingOfIntegers K →+* NumberField.mixedEmbedding.mixedSpace K :=
      (NumberField.mixedEmbedding K).comp (algebraMap (NumberField.RingOfIntegers K) K)
    have hφ : ∀ t : NumberField.RingOfIntegers K,
        φ t = NumberField.mixedEmbedding K (t : K) := fun t => rfl
    rw [← hφ]
    conv_rhs => rw [← ω.sum_repr z]
    rw [map_sum]
    unfold kaiOmegaEmb
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_zsmul, hφ, Int.cast_smul_eq_zsmul]
  
  have hnorm : ∀ z : NumberField.RingOfIntegers K,
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (z : K)) =
        ((Algebra.norm ℤ z).natAbs : ℝ) := by
    intro z
    rw [NumberField.mixedEmbedding.norm_eq_norm, ← Algebra.coe_norm_int, Nat.cast_natAbs]
    push_cast
    rfl
  
  have hbox : ∀ z : NumberField.RingOfIntegers K, z ∈ omegaBox ω M ↔
      ∀ l, |((ω.repr z l : ℤ) : ℝ)| ≤ ((⌊M⌋₊ : ℕ) : ℝ) := by
    intro z
    unfold omegaBox intBox
    rw [Finset.mem_image]
    constructor
    · rintro ⟨a, ha, rfl⟩ l
      rw [Finset.mem_Icc] at ha
      have hrep : ω.repr (ω.equivFun.symm a) l = a l := by
        rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
      have h1 : -((⌊M⌋₊ : ℕ) : ℤ) ≤ a l := ha.1 l
      have h2 : a l ≤ ((⌊M⌋₊ : ℕ) : ℤ) := ha.2 l
      rw [hrep, abs_le]
      exact ⟨by exact_mod_cast h1, by exact_mod_cast h2⟩
    · intro h
      refine ⟨ω.equivFun z, ?_, ω.equivFun.symm_apply_apply z⟩
      rw [Finset.mem_Icc]
      refine ⟨fun l => ?_, fun l => ?_⟩
      · have h1 := (abs_le.mp (h l)).1
        show -((⌊M⌋₊ : ℕ) : ℤ) ≤ ω.equivFun z l
        rw [Module.Basis.equivFun_apply]
        exact_mod_cast h1
      · have h2 := (abs_le.mp (h l)).2
        show ω.equivFun z l ≤ ((⌊M⌋₊ : ℕ) : ℤ)
        rw [Module.Basis.equivFun_apply]
        exact_mod_cast h2
  
  obtain ⟨x, hx_def⟩ : ∃ x, x = x₀ + e * ω.equivFun.symm y := ⟨_, rfl⟩
  have h1 : x = x₀ + ∑ j, y j • (e * ω j) := by
    rw [hx_def, Module.Basis.equivFun_symm_apply, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [mul_smul_comm]
  have hcoord : ∀ l, ((ω.repr x l : ℤ) : ℝ) = ((ω.repr x₀ l : ℤ) : ℝ) +
      ∑ j, ((y j : ℤ) : ℝ) * ((ω.repr (e * ω j) l : ℤ) : ℝ) := by
    intro l
    rw [h1]
    simp only [map_add, map_sum, map_zsmul, Finsupp.coe_add, Pi.add_apply,
      Finsupp.coe_finset_sum, Finset.sum_apply, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul,
      Int.cast_add, Int.cast_sum, Int.cast_mul]
  have hvx : v = fun l => ((ω.repr x l : ℤ) : ℝ) := by
    funext l; rw [hv l, hcoord l]
  rw [← hx_def, hvx, hemb x, hnorm x]
  simp only [NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
  show (x ∈ omegaBox ω M ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y ∧ kaiPatt o x) ↔ _
  exact and_congr (hbox x) Iff.rfl

theorem kai_bc_cube_count (n s : ℕ) (hs : 1 ≤ s) (U : Finset (Fin n → ℤ))
    (Z : Finset (Fin n → ℝ)) (Ψ : (Fin n → ℝ) → Fin n → ℝ) (lam ρ : ℝ)
    (hΨ : ∀ (y y' : Fin n → ℝ) (B : ℝ), (∀ l, |Ψ y l - Ψ y' l| ≤ B) →
      ∀ j, |y j - y' j| ≤ lam * B)
    (hρ : 2 * lam * ρ < (s : ℝ))
    (hU : ∀ u ∈ U, ∃ y : Fin n → ℝ,
      (∀ j, (s : ℝ) * ((u j : ℤ) : ℝ) ≤ y j ∧ y j ≤ (s : ℝ) * ((u j : ℤ) : ℝ) + ((s : ℝ) - 1)) ∧
      ∃ z ∈ Z, ∀ l, |Ψ y l - z l| ≤ ρ) :
    (U.card : ℝ) ≤ 3 ^ n * (Z.card : ℝ) :=
by
  classical
  have hU' : ∀ u ∈ U, ∃ y : Fin n → ℝ, ∃ z : Fin n → ℝ,
      (∀ j, (s : ℝ) * ((u j : ℤ) : ℝ) ≤ y j ∧ y j ≤ (s : ℝ) * ((u j : ℤ) : ℝ) + ((s : ℝ) - 1)) ∧
      z ∈ Z ∧ ∀ l, |Ψ y l - z l| ≤ ρ := by
    intro u hu
    obtain ⟨y, hy, z, hz, hz'⟩ := hU u hu
    exact ⟨y, z, hy, hz, hz'⟩
  choose! Y zf hYcube hzZ hzΨ using hU'
  have gap : ∀ (a b : ℤ) (y y' : ℝ), (s : ℝ) * ((a : ℤ) : ℝ) ≤ y →
      y' ≤ (s : ℝ) * ((b : ℤ) : ℝ) + ((s : ℝ) - 1) → y - y' < (s : ℝ) → a - b ≤ 1 := by
    intro a b y y' ha hb hyy
    by_contra hcon
    have h2 : (2 : ℤ) ≤ a - b := by omega
    have h2' : (2 : ℝ) ≤ (a : ℝ) - (b : ℝ) := by exact_mod_cast h2
    have hS : (0 : ℝ) ≤ (s : ℝ) := Nat.cast_nonneg s
    have hm := mul_le_mul_of_nonneg_left h2' hS
    nlinarith
  have adj : ∀ u ∈ U, ∀ u' ∈ U, zf u = zf u' → ∀ j, |u j - u' j| ≤ 1 := by
    intro u hu u' hu' hzz j
    have hcl : ∀ l, |Ψ (Y u) l - Ψ (Y u') l| ≤ 2 * ρ := by
      intro l
      have h1 := hzΨ u hu l
      have h2 := hzΨ u' hu' l
      rw [← hzz] at h2
      calc |Ψ (Y u) l - Ψ (Y u') l|
          ≤ |Ψ (Y u) l - zf u l| + |zf u l - Ψ (Y u') l| := abs_sub_le _ _ _
        _ = |Ψ (Y u) l - zf u l| + |Ψ (Y u') l - zf u l| := by rw [abs_sub_comm (zf u l)]
        _ ≤ 2 * ρ := by linarith
    have hY := hΨ (Y u) (Y u') (2 * ρ) hcl j
    have hlt : |Y u j - Y u' j| < (s : ℝ) := by
      have : lam * (2 * ρ) = 2 * lam * ρ := by ring
      linarith
    have hlt1 : Y u j - Y u' j < (s : ℝ) := lt_of_le_of_lt (le_abs_self _) hlt
    have hlt2 : Y u' j - Y u j < (s : ℝ) := by
      rw [abs_sub_comm] at hlt
      exact lt_of_le_of_lt (le_abs_self _) hlt
    have g1 := gap (u j) (u' j) (Y u j) (Y u' j) (hYcube u hu j).1 (hYcube u' hu' j).2 hlt1
    have g2 := gap (u' j) (u j) (Y u' j) (Y u j) (hYcube u' hu' j).1 (hYcube u hu j).2 hlt2
    rw [abs_le]
    constructor <;> linarith
  have diam : ∀ F : Finset (Fin n → ℤ), (∀ u ∈ F, ∀ u' ∈ F, ∀ j, |u j - u' j| ≤ 1) →
      F.card ≤ 3 ^ n := by
    intro F hF
    rcases F.eq_empty_or_nonempty with h | ⟨u₀, hu₀⟩
    · simp [h]
    · have hsub : F ⊆ Finset.Icc (u₀ - fun _ => 1) (u₀ + fun _ => 1) := by
        intro u hu
        rw [Finset.mem_Icc]
        constructor
        · intro j
          have := abs_le.mp (hF u hu u₀ hu₀ j)
          simp only [Pi.sub_apply]
          linarith
        · intro j
          have := abs_le.mp (hF u hu u₀ hu₀ j)
          simp only [Pi.add_apply]
          linarith
      calc F.card ≤ (Finset.Icc (u₀ - fun _ => 1) (u₀ + fun _ => 1)).card :=
            Finset.card_le_card hsub
        _ = 3 ^ n := by
          rw [Pi.card_Icc]
          simp only [Pi.sub_apply, Pi.add_apply, Int.card_Icc]
          have h3 : ∀ j : Fin n, (u₀ j + 1 + 1 - (u₀ j - 1)).toNat = 3 := by
            intro j
            have : u₀ j + 1 + 1 - (u₀ j - 1) = 3 := by ring
            rw [this]
            rfl
          simp only [h3, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  have hmain : U.card ≤ 3 ^ n * Z.card := by
    apply Finset.card_le_mul_card_image_of_maps_to hzZ
    intro b _
    apply diam
    intro u hu u' hu' j
    rw [Finset.mem_filter] at hu hu'
    exact adj u hu.1 u' hu'.1 (hu.2.trans hu'.2.symm) j
  exact_mod_cast hmain

theorem kai_bc_small_Y (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∀ (M Y : ℝ) (s : ℕ) (o : KaiPattern K) (x₀ e : NumberField.RingOfIntegers K),
      Y < 1 → e ≠ 0 → 1 ≤ s →
      ∀ U : Finset (Fin (Module.finrank ℚ K) → ℤ),
        (∀ u ∈ U, ∃ y₁ : Fin (Module.finrank ℚ K) → ℤ,
          y₁ ∈ Finset.Icc (fun j => (s : ℤ) * u j)
            ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)) ∧
          x₀ + e * ω.equivFun.symm y₁ ∈ kaiCutoffSet ω M Y o) →
        U.card ≤ 1 :=
by
  classical
  intro M Y s o x₀ e hY he hs U hU
  have hzero : ∀ y : Fin (Module.finrank ℚ K) → ℤ,
      x₀ + e * ω.equivFun.symm y ∈ kaiCutoffSet ω M Y o →
        x₀ + e * ω.equivFun.symm y = 0 := by
    intro y hy
    have hN : ((Algebra.norm ℤ (x₀ + e * ω.equivFun.symm y)).natAbs : ℝ) ≤ Y := by
      simp only [kaiCutoffSet, Set.mem_setOf_eq] at hy
      exact hy.2.1
    have h1 : ((Algebra.norm ℤ (x₀ + e * ω.equivFun.symm y)).natAbs : ℝ) < 1 :=
      lt_of_le_of_lt hN hY
    have h2 : (Algebra.norm ℤ (x₀ + e * ω.equivFun.symm y)).natAbs = 0 := by
      exact_mod_cast Nat.cast_lt_one.mp h1
    exact Algebra.norm_eq_zero_iff.mp (Int.natAbs_eq_zero.mp h2)
  have hinj : ∀ y y' : Fin (Module.finrank ℚ K) → ℤ,
      x₀ + e * ω.equivFun.symm y = 0 → x₀ + e * ω.equivFun.symm y' = 0 → y = y' := by
    intro y y' h h'
    have h3 : x₀ + e * ω.equivFun.symm y = x₀ + e * ω.equivFun.symm y' := by rw [h, h']
    have h4 := mul_left_cancel₀ he (add_left_cancel h3)
    exact ω.equivFun.symm.injective h4
  have hs' : (1 : ℤ) ≤ (s : ℤ) := by exact_mod_cast hs
  have hcube : ∀ u u' y : Fin (Module.finrank ℚ K) → ℤ,
      y ∈ Finset.Icc (fun j => (s : ℤ) * u j)
            ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)) →
      y ∈ Finset.Icc (fun j => (s : ℤ) * u' j)
            ((fun j => (s : ℤ) * u' j) + fun _ => ((s : ℤ) - 1)) → u = u' := by
    intro u u' y hy hy'
    rw [Finset.mem_Icc] at hy hy'
    funext j
    have a := hy.1 j
    have b := hy.2 j
    have a' := hy'.1 j
    have b' := hy'.2 j
    simp only [Pi.add_apply] at a b a' b'
    have k1 : u j ≤ u' j := by
      by_contra h
      push_neg at h
      nlinarith [mul_le_mul_of_nonneg_left (show u' j + 1 ≤ u j by omega)
        (show (0 : ℤ) ≤ s by positivity)]
    have k2 : u' j ≤ u j := by
      by_contra h
      push_neg at h
      nlinarith [mul_le_mul_of_nonneg_left (show u j + 1 ≤ u' j by omega)
        (show (0 : ℤ) ≤ s by positivity)]
    exact le_antisymm k1 k2
  rw [Finset.card_le_one]
  intro u hu u' hu'
  obtain ⟨y, hy, hm⟩ := hU u hu
  obtain ⟨y', hy', hm'⟩ := hU u' hu'
  have hyy : y = y' := hinj y y' (hzero y hm) (hzero y' hm')
  rw [← hyy] at hy'
  exact hcube u u' y hy hy'

theorem kai_v_si_boundary_cubes (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ C_B : ℝ, 1 ≤ C_B ∧
      ∀ (M Y ν : ℝ) (s : ℕ) (o : KaiPattern K) (x₀ e : NumberField.RingOfIntegers K),
        3 ≤ M → 0 < ν → 1 ≤ s → (s : ℝ) * ν ≤ M →
        (∀ w : NumberField.InfinitePlace K, ν ≤ w (e : K)) →
        ∀ U : Finset (Fin (Module.finrank ℚ K) → ℤ),
          (∀ u ∈ U, ∃ y₁ y₂ : Fin (Module.finrank ℚ K) → ℤ,
            y₁ ∈ Finset.Icc (fun j => (s : ℤ) * u j)
              ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)) ∧
            y₂ ∈ Finset.Icc (fun j => (s : ℤ) * u j)
              ((fun j => (s : ℤ) * u j) + fun _ => ((s : ℤ) - 1)) ∧
            x₀ + e * ω.equivFun.symm y₁ ∈ kaiCutoffSet ω M Y o ∧
            x₀ + e * ω.equivFun.symm y₂ ∉ kaiCutoffSet ω M Y o) →
          (U.card : ℝ) ≤
            C_B * (M * Real.log M / ((s : ℝ) * ν)) ^ (Module.finrank ℚ K - 1) :=
by
  classical
  obtain ⟨κ, hκ1, hup, hlow⟩ := kai_bc_omega_emb_bounds K ω
  obtain ⟨C_G, hCG1, hcover⟩ := kai_bc_norm_level_cover K ω
  have hκ0 : 0 < κ := by linarith
  have h4κ : (1 : ℝ) ≤ 4 * κ ^ 2 := by nlinarith
  obtain ⟨P, hP_def⟩ : ∃ P : ℕ, P = Fintype.card (NumberField.InfinitePlace K) := ⟨_, rfl⟩
  obtain ⟨D, hD_def⟩ : ∃ D : ℝ, D = C_G + (2 * (Module.finrank ℚ K : ℝ) + (P : ℝ)) *
      (3 * (Module.finrank ℚ K : ℝ)) ^ (Module.finrank ℚ K - 1) := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    have : 0 ≤ (2 * (Module.finrank ℚ K : ℝ) + (P : ℝ)) *
        (3 * (Module.finrank ℚ K : ℝ)) ^ (Module.finrank ℚ K - 1) := by positivity
    rw [hD_def]; linarith
  obtain ⟨C_B, hC_B⟩ : ∃ C_B : ℝ, C_B = 3 ^ Module.finrank ℚ K * D *
      (4 * κ ^ 2) ^ (Module.finrank ℚ K - 1) := ⟨_, rfl⟩
  have hCB1 : 1 ≤ C_B := by
    rw [hC_B]
    have h1 : (1 : ℝ) ≤ 3 ^ Module.finrank ℚ K := one_le_pow₀ (by norm_num)
    have h3 : (1 : ℝ) ≤ (4 * κ ^ 2) ^ (Module.finrank ℚ K - 1) := one_le_pow₀ h4κ
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h1 hD1) h3
  refine ⟨C_B, hCB1, ?_⟩
  intro M Y ν s o x₀ e hM hν hs hsν hνw U hU
  have hMpos : 0 < M := by linarith
  have hspos : (0 : ℝ) < s := by
    have : (1 : ℝ) ≤ s := by exact_mod_cast hs
    linarith
  have hsν0 : 0 < (s : ℝ) * ν := mul_pos hspos hν
  have hlogM : 1 ≤ Real.log M := by
    rw [Real.le_log_iff_exp_le hMpos]
    have := Real.exp_one_lt_d9
    linarith
  obtain ⟨X, hX_def⟩ : ∃ X : ℝ, X = M * Real.log M / ((s : ℝ) * ν) := ⟨_, rfl⟩
  rw [← hX_def]
  have hX1 : 1 ≤ X := by
    rw [hX_def, le_div_iff₀ hsν0, one_mul]
    nlinarith
  have hXn : 1 ≤ X ^ (Module.finrank ℚ K - 1) := one_le_pow₀ hX1
  have he0 : e ≠ 0 := by
    rintro rfl
    obtain ⟨w⟩ := (inferInstance : Nonempty (NumberField.InfinitePlace K))
    have h := hνw w
    simp at h
    linarith
  by_cases hY : Y < 1
  · have hU1 := kai_bc_small_Y K ω M Y s o x₀ e hY he0 hs U (fun u hu => by
      obtain ⟨y₁, y₂, hy₁, -, h₁, -⟩ := hU u hu
      exact ⟨y₁, hy₁, h₁⟩)
    have h1 : (U.card : ℝ) ≤ 1 := by exact_mod_cast hU1
    exact h1.trans (one_le_mul_of_one_le_of_one_le hCB1 hXn)
  push_neg at hY
  
  obtain ⟨ρ, hρ_def⟩ : ∃ ρ : ℝ, ρ = (s : ℝ) * ν / (4 * κ ^ 2) := ⟨_, rfl⟩
  have hρpos : 0 < ρ := by rw [hρ_def]; positivity
  have hρM : ρ ≤ M := by
    rw [hρ_def, div_le_iff₀ (by positivity)]
    nlinarith
  obtain ⟨m, hm_def⟩ : ∃ m : ℝ, m = ((⌊M⌋₊ : ℕ) : ℝ) := ⟨_, rfl⟩
  have hm0 : 0 ≤ m := by rw [hm_def]; exact Nat.cast_nonneg _
  have hmM : m ≤ M := by rw [hm_def]; exact Nat.floor_le hMpos.le
  
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : (Fin (Module.finrank ℚ K) → ℝ) → Fin (Module.finrank ℚ K) → ℝ,
      ∀ y l, Ψ y l = ((ω.repr x₀ l : ℤ) : ℝ) + ∑ j, y j * ((ω.repr (e * ω j) l : ℤ) : ℝ) :=
    ⟨fun y l => ((ω.repr x₀ l : ℤ) : ℝ) + ∑ j, y j * ((ω.repr (e * ω j) l : ℤ) : ℝ),
      fun _ _ => rfl⟩
  have hT : Continuous (fun v : Fin (Module.finrank ℚ K) → ℝ => kaiOmegaEmb ω v) := by
    unfold kaiOmegaEmb
    exact continuous_finset_sum _ (fun j _ => (continuous_apply j).smul continuous_const)
  
  have hwit : ∀ u ∈ U, ∃ y : Fin (Module.finrank ℚ K) → ℝ,
      (∀ j, (s : ℝ) * ((u j : ℤ) : ℝ) ≤ y j ∧ y j ≤ (s : ℝ) * ((u j : ℤ) : ℝ) + ((s : ℝ) - 1)) ∧
      (∀ l, |Ψ y l| ≤ m) ∧
      ((∃ l, |Ψ y l| = m) ∨ NumberField.mixedEmbedding.norm (kaiOmegaEmb ω (Ψ y)) = Y ∨
        ∃ w : {w : NumberField.InfinitePlace K // w.IsReal}, (kaiOmegaEmb ω (Ψ y)).1 w = 0) := by
    intro u hu
    obtain ⟨y₁, y₂, hy₁, hy₂, h₁, h₂⟩ := hU u hu
    set a : Fin (Module.finrank ℚ K) → ℝ := fun j => ((y₁ j : ℤ) : ℝ) with ha_def
    set b : Fin (Module.finrank ℚ K) → ℝ := fun j => ((y₂ j : ℤ) : ℝ) with hb_def
    have hd₁ := (kai_bc_dictionary K ω M Y o x₀ e y₁ (Ψ a) (fun l => hΨ _ l)).mp h₁
    have hd₂ : ¬ ((∀ l, |Ψ b l| ≤ ((⌊M⌋₊ : ℕ) : ℝ)) ∧
          NumberField.mixedEmbedding.norm (kaiOmegaEmb ω (Ψ b)) ≤ Y ∧
          ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
            (0 < (kaiOmegaEmb ω (Ψ b)).1 w ↔ o w = true)) :=
      fun h => h₂ ((kai_bc_dictionary K ω M Y o x₀ e y₂ (Ψ b) (fun l => hΨ _ l)).mpr h)
    obtain ⟨t, ht0, ht1, hbox, hcases⟩ := kai_bc_segment_crossing (Module.finrank ℚ K)
      (((⌊M⌋₊ : ℕ) : ℝ)) Y
      (fun v => NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v))
      (fun w v => (kaiOmegaEmb ω v).1 w) o
      ((NumberField.mixedEmbedding.continuous_norm K).comp hT)
      (fun w => (continuous_apply w).comp (continuous_fst.comp hT))
      (Ψ a) (Ψ b) hd₁ hd₂
    have hΨaff : Ψ (a + t • (b - a)) = Ψ a + t • (Ψ b - Ψ a) := by
      funext l
      simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul, hΨ]
      have e1 : ∑ j, (a j + t * (b j - a j)) * ((ω.repr (e * ω j) l : ℤ) : ℝ) =
          ∑ j, a j * ((ω.repr (e * ω j) l : ℤ) : ℝ) +
            t * (∑ j, b j * ((ω.repr (e * ω j) l : ℤ) : ℝ) -
              ∑ j, a j * ((ω.repr (e * ω j) l : ℤ) : ℝ)) := by
        rw [mul_sub, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib,
          ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [e1]; ring
    refine ⟨a + t • (b - a), ?_, ?_⟩
    · intro j
      rw [Finset.mem_Icc] at hy₁ hy₂
      have a1 : (s : ℤ) * u j ≤ y₁ j := hy₁.1 j
      have a2 : y₁ j ≤ (s : ℤ) * u j + ((s : ℤ) - 1) := hy₁.2 j
      have b1 : (s : ℤ) * u j ≤ y₂ j := hy₂.1 j
      have b2 : y₂ j ≤ (s : ℤ) * u j + ((s : ℤ) - 1) := hy₂.2 j
      have a1' : (s : ℝ) * ((u j : ℤ) : ℝ) ≤ a j := by
        have h := (Int.cast_le (R := ℝ)).mpr a1
        rw [ha_def]; push_cast at h ⊢; linarith
      have a2' : a j ≤ (s : ℝ) * ((u j : ℤ) : ℝ) + ((s : ℝ) - 1) := by
        have h := (Int.cast_le (R := ℝ)).mpr a2
        rw [ha_def]; push_cast at h ⊢; linarith
      have b1' : (s : ℝ) * ((u j : ℤ) : ℝ) ≤ b j := by
        have h := (Int.cast_le (R := ℝ)).mpr b1
        rw [hb_def]; push_cast at h ⊢; linarith
      have b2' : b j ≤ (s : ℝ) * ((u j : ℤ) : ℝ) + ((s : ℝ) - 1) := by
        have h := (Int.cast_le (R := ℝ)).mpr b2
        rw [hb_def]; push_cast at h ⊢; linarith
      simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
      constructor <;> nlinarith
    · rw [hΨaff]
      exact ⟨fun l => hm_def ▸ hbox l, by
        rcases hcases with ⟨l, hl⟩ | hN | ⟨w, hw⟩
        · exact Or.inl ⟨l, hm_def ▸ hl⟩
        · exact Or.inr (Or.inl hN)
        · exact Or.inr (Or.inr ⟨w, hw⟩)⟩
  
  have hbox_cov : ∀ (l : Fin (Module.finrank ℚ K)) (bb : Bool),
      ∃ Z : Finset (Fin (Module.finrank ℚ K) → ℝ),
        (Z.card : ℝ) ≤ (3 * (Module.finrank ℚ K : ℝ) * M / ρ) ^ (Module.finrank ℚ K - 1) ∧
        ∀ v : Fin (Module.finrank ℚ K) → ℝ, (∀ j, |v j| ≤ M) →
          v l = (if bb then m else -m) → ∃ z ∈ Z, ∀ j, |v j - z j| ≤ ρ := by
    intro l bb
    obtain ⟨Z, hZc, hZ⟩ := kai_bc_hyperplane_cover (Module.finrank ℚ K) (Pi.single l 1)
      (if bb then m else -m) M ρ (by
        intro h
        have := congr_fun h l
        simp at this) hρpos hρM
    refine ⟨Z, hZc, fun v hv hvl => hZ v hv ?_⟩
    rw [← hvl]
    simp [Pi.single_apply]
  
  have hsign_cov : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      ∃ Z : Finset (Fin (Module.finrank ℚ K) → ℝ),
        (Z.card : ℝ) ≤ (3 * (Module.finrank ℚ K : ℝ) * M / ρ) ^ (Module.finrank ℚ K - 1) ∧
        ∀ v : Fin (Module.finrank ℚ K) → ℝ, (∀ j, |v j| ≤ M) →
          (kaiOmegaEmb ω v).1 w = 0 → ∃ z ∈ Z, ∀ j, |v j - z j| ≤ ρ := by
    intro w
    have hlin : ∀ v : Fin (Module.finrank ℚ K) → ℝ, (kaiOmegaEmb ω v).1 w =
        ∑ j, (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)).1 w
          * v j := by
      intro v
      simp [kaiOmegaEmb, Prod.fst_sum, Finset.sum_apply, mul_comm]
    have hne : (fun j => (NumberField.mixedEmbedding K
        ((ω j : NumberField.RingOfIntegers K) : K)).1 w) ≠ 0 := by
      intro h0
      have hz : ∀ j, (NumberField.mixedEmbedding K
          ((ω j : NumberField.RingOfIntegers K) : K)).1 w = 0 := fun j => congr_fun h0 j
      have h1 : (NumberField.mixedEmbedding K
          ((1 : NumberField.RingOfIntegers K) : K)).1 w =
          ∑ j, ((ω.repr 1 j : ℤ) : ℝ) *
            (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)).1 w := by
        conv_lhs => rw [← ω.sum_repr (1 : NumberField.RingOfIntegers K)]
        simp [map_sum, Prod.fst_sum, Finset.sum_apply]
      simp [hz] at h1
    obtain ⟨Z, hZc, hZ⟩ := kai_bc_hyperplane_cover (Module.finrank ℚ K) _ 0 M ρ hne hρpos hρM
    exact ⟨Z, hZc, fun v hv h0 => hZ v hv (by rw [← hlin]; exact h0)⟩
  obtain ⟨ZH, hZHcard, hZH⟩ := hcover M Y ρ hM hY hρpos hρM
  choose ZB hZBc hZB using hbox_cov
  choose ZS hZSc hZS using hsign_cov
  obtain ⟨Z, hZ_def⟩ : ∃ Z : Finset (Fin (Module.finrank ℚ K) → ℝ),
      Z = ZH ∪ (Finset.univ.biUnion fun p : Fin (Module.finrank ℚ K) × Bool => ZB p.1 p.2) ∪
        (Finset.univ.biUnion fun w => ZS w) := ⟨_, rfl⟩
  
  have hlip : ∀ (y y' : Fin (Module.finrank ℚ K) → ℝ) (B : ℝ),
      (∀ l, |Ψ y l - Ψ y' l| ≤ B) → ∀ j, |y j - y' j| ≤ κ ^ 2 / ν * B := by
    intro y y' B hB
    have := kai_bc_mul_inverse K ω κ hκ1 hup hlow e ν hν hνw (y - y') B (fun l => by
      have h := hB l
      rw [hΨ, hΨ] at h
      have : ∑ j, (y - y') j * ((ω.repr (e * ω j) l : ℤ) : ℝ) =
          (((ω.repr x₀ l : ℤ) : ℝ) + ∑ j, y j * ((ω.repr (e * ω j) l : ℤ) : ℝ)) -
          (((ω.repr x₀ l : ℤ) : ℝ) + ∑ j, y' j * ((ω.repr (e * ω j) l : ℤ) : ℝ)) := by
        simp only [Pi.sub_apply, sub_mul, Finset.sum_sub_distrib]; ring
      rw [this]; exact h)
    intro j
    simpa using this j
  have h2lr : 2 * (κ ^ 2 / ν) * ρ < (s : ℝ) := by
    have : 2 * (κ ^ 2 / ν) * ρ = (s : ℝ) / 2 := by
      rw [hρ_def]; field_simp; ring
    rw [this]; linarith
  have hcnt := kai_bc_cube_count (Module.finrank ℚ K) s hs U Z Ψ (κ ^ 2 / ν) ρ hlip h2lr
    (fun u hu => by
      obtain ⟨y, hy, hbox, hcase⟩ := hwit u hu
      refine ⟨y, hy, ?_⟩
      have hbM : ∀ j, |Ψ y j| ≤ M := fun j => (hbox j).trans hmM
      rcases hcase with ⟨l, hl⟩ | hN | ⟨w, hw⟩
      · rcases (abs_eq hm0).mp hl with h | h
        · obtain ⟨z, hz, hzc⟩ := hZB l true (Ψ y) hbM (by simp [h])
          refine ⟨z, ?_, hzc⟩
          rw [hZ_def]
          exact Finset.mem_union.2 (Or.inl (Finset.mem_union.2 (Or.inr
            (Finset.mem_biUnion.2 ⟨(l, true), Finset.mem_univ _, hz⟩))))
        · obtain ⟨z, hz, hzc⟩ := hZB l false (Ψ y) hbM (by simp [h])
          refine ⟨z, ?_, hzc⟩
          rw [hZ_def]
          exact Finset.mem_union.2 (Or.inl (Finset.mem_union.2 (Or.inr
            (Finset.mem_biUnion.2 ⟨(l, false), Finset.mem_univ _, hz⟩))))
      · obtain ⟨z, hz, hzc⟩ := hZH (Ψ y) hbM hN
        refine ⟨z, ?_, hzc⟩
        rw [hZ_def]
        exact Finset.mem_union.2 (Or.inl (Finset.mem_union.2 (Or.inl hz)))
      · obtain ⟨z, hz, hzc⟩ := hZS w (Ψ y) hbM hw
        refine ⟨z, ?_, hzc⟩
        rw [hZ_def]
        exact Finset.mem_union.2 (Or.inr (Finset.mem_biUnion.2 ⟨w, Finset.mem_univ _, hz⟩)))
  
  obtain ⟨A, hA_def⟩ : ∃ A : ℝ, A = M * Real.log M / ρ := ⟨_, rfl⟩
  obtain ⟨H, hH_def⟩ : ∃ H : ℝ, H = 3 * (Module.finrank ℚ K : ℝ) * M / ρ := ⟨_, rfl⟩
  have hA_eq : A = 4 * κ ^ 2 * X := by
    rw [hA_def, hX_def, hρ_def]; field_simp
  have hH0 : 0 ≤ H := by rw [hH_def]; positivity
  have hHA : H ≤ 3 * (Module.finrank ℚ K : ℝ) * A := by
    rw [hH_def, hA_def, mul_div_assoc, mul_div_assoc]
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    rw [← mul_div_assoc M (Real.log M) ρ]
    apply div_le_div_of_nonneg_right _ hρpos.le
    nlinarith
  have hHn : H ^ (Module.finrank ℚ K - 1) ≤
      (3 * (Module.finrank ℚ K : ℝ)) ^ (Module.finrank ℚ K - 1) * A ^ (Module.finrank ℚ K - 1) := by
    rw [← mul_pow]; exact pow_le_pow_left₀ hH0 hHA _
  have hZnat : Z.card ≤ ZH.card + (∑ p : Fin (Module.finrank ℚ K) × Bool, (ZB p.1 p.2).card) +
      ∑ w, (ZS w).card := by
    rw [hZ_def]
    refine (Finset.card_union_le _ _).trans ?_
    exact add_le_add ((Finset.card_union_le _ _).trans (add_le_add le_rfl Finset.card_biUnion_le))
      Finset.card_biUnion_le
  have hZreal : (Z.card : ℝ) ≤ (ZH.card : ℝ) +
      (∑ p : Fin (Module.finrank ℚ K) × Bool, ((ZB p.1 p.2).card : ℝ)) +
      ∑ w, ((ZS w).card : ℝ) := by exact_mod_cast hZnat
  have hsumB : (∑ p : Fin (Module.finrank ℚ K) × Bool, ((ZB p.1 p.2).card : ℝ)) ≤
      (2 * (Module.finrank ℚ K : ℝ)) * H ^ (Module.finrank ℚ K - 1) := by
    calc (∑ p : Fin (Module.finrank ℚ K) × Bool, ((ZB p.1 p.2).card : ℝ))
        ≤ ∑ _p : Fin (Module.finrank ℚ K) × Bool, H ^ (Module.finrank ℚ K - 1) :=
          Finset.sum_le_sum (fun p _ => by rw [hH_def]; exact hZBc p.1 p.2)
      _ = (2 * (Module.finrank ℚ K : ℝ)) * H ^ (Module.finrank ℚ K - 1) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_prod, Fintype.card_fin,
            Fintype.card_bool, nsmul_eq_mul]
          push_cast; ring
  have hr₁ : (Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} : ℝ) ≤ (P : ℝ) := by
    rw [hP_def]; exact_mod_cast Fintype.card_subtype_le _
  have hsumS : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal}, ((ZS w).card : ℝ)) ≤
      (P : ℝ) * H ^ (Module.finrank ℚ K - 1) := by
    calc (∑ w : {w : NumberField.InfinitePlace K // w.IsReal}, ((ZS w).card : ℝ))
        ≤ ∑ _w : {w : NumberField.InfinitePlace K // w.IsReal}, H ^ (Module.finrank ℚ K - 1) :=
          Finset.sum_le_sum (fun w _ => by rw [hH_def]; exact hZSc w)
      _ = (Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} : ℝ) *
            H ^ (Module.finrank ℚ K - 1) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ ≤ (P : ℝ) * H ^ (Module.finrank ℚ K - 1) :=
          mul_le_mul_of_nonneg_right hr₁ (by positivity)
  have hZH' : (ZH.card : ℝ) ≤ C_G * A ^ (Module.finrank ℚ K - 1) := by
    rw [hA_def]; exact hZHcard
  have hZbound : (Z.card : ℝ) ≤ D * A ^ (Module.finrank ℚ K - 1) := by
    have hAn : 0 ≤ A ^ (Module.finrank ℚ K - 1) := by
      rw [hA_eq]; positivity
    have h2P : 0 ≤ 2 * (Module.finrank ℚ K : ℝ) + (P : ℝ) := by positivity
    calc (Z.card : ℝ) ≤ C_G * A ^ (Module.finrank ℚ K - 1) +
          (2 * (Module.finrank ℚ K : ℝ) + (P : ℝ)) * H ^ (Module.finrank ℚ K - 1) := by
          linarith
      _ ≤ C_G * A ^ (Module.finrank ℚ K - 1) +
          (2 * (Module.finrank ℚ K : ℝ) + (P : ℝ)) *
            ((3 * (Module.finrank ℚ K : ℝ)) ^ (Module.finrank ℚ K - 1) *
              A ^ (Module.finrank ℚ K - 1)) := by
          gcongr
      _ = D * A ^ (Module.finrank ℚ K - 1) := by rw [hD_def]; ring
  calc (U.card : ℝ) ≤ 3 ^ Module.finrank ℚ K * (Z.card : ℝ) := hcnt
    _ ≤ 3 ^ Module.finrank ℚ K * (D * A ^ (Module.finrank ℚ K - 1)) :=
        mul_le_mul_of_nonneg_left hZbound (by positivity)
    _ = C_B * X ^ (Module.finrank ℚ K - 1) := by
        rw [hC_B, hA_eq, mul_pow]; ring

theorem kai_v_si_region_size (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (M ν : ℝ) (x₀ e : NumberField.RingOfIntegers K)
    (Ry : Finset (Fin (Module.finrank ℚ K) → ℤ))
    (hM : 0 ≤ M) (hν : 0 < ν) (he : ∀ w : NumberField.InfinitePlace K, ν ≤ w (e : K))
    (hx₀ : x₀ ∈ omegaBox ω M)
    (hRy : ∀ y ∈ Ry, x₀ + e * ω.equivFun.symm y ∈ omegaBox ω M) :
    (Ry.card : ℝ) ≤ (4 * C ^ 2 * M / ν + 1) ^ Module.finrank ℚ K :=
by
  classical
  have hC : 1 < C := hω.1
  have hC0 : 0 < C := by linarith
  
  have hcoord : ∀ x ∈ omegaBox ω M, ∀ j, |((ω.repr x j : ℤ) : ℝ)| ≤ M := by
    intro x hx j
    unfold omegaBox at hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    have hrep : ω.repr (ω.equivFun.symm v) j = v j := by
      rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    rw [hrep]
    unfold intBox at hv
    simp only [Finset.mem_Icc, Pi.le_def] at hv
    have h1 : -((⌊M⌋₊ : ℕ) : ℤ) ≤ v j := hv.1 j
    have h2 : v j ≤ ((⌊M⌋₊ : ℕ) : ℤ) := hv.2 j
    have h1' : -((⌊M⌋₊ : ℕ) : ℝ) ≤ (v j : ℝ) := by exact_mod_cast h1
    have h2' : (v j : ℝ) ≤ ((⌊M⌋₊ : ℕ) : ℝ) := by exact_mod_cast h2
    have hf : ((⌊M⌋₊ : ℕ) : ℝ) ≤ M := Nat.floor_le hM
    rw [abs_le]; constructor <;> linarith
  have hbsn_le : ∀ (x : NumberField.RingOfIntegers K) (j : Fin (Module.finrank ℚ K)),
      |((ω.repr x j : ℤ) : ℝ)| ≤ basisSupNorm ω x := by
    intro x j
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr x j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  obtain ⟨T, hT_def⟩ : ∃ T : ℝ, T = 2 * C ^ 2 * M / ν := ⟨_, rfl⟩
  have hT0 : 0 ≤ T := by
    rw [hT_def]
    exact div_nonneg (mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg C)) hM) hν.le
  
  have hyT : ∀ y ∈ Ry, ∀ j, |((y j : ℤ) : ℝ)| ≤ T := by
    intro y hy j
    obtain ⟨Y, hY⟩ : ∃ Y, Y = ω.equivFun.symm y := ⟨_, rfl⟩
    have hrepY : ∀ j, ω.repr Y j = y j := by
      intro j
      rw [hY, ← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    have hg := hcoord _ (hRy y hy)
    rw [← hY] at hg
    have h0 := hcoord _ hx₀
    have heY : basisSupNorm ω (e * Y) ≤ 2 * M := by
      unfold basisSupNorm
      apply Real.iSup_le _ (by linarith)
      intro k
      have hsub : e * Y = (x₀ + e * Y) - x₀ := by ring
      rw [hsub, map_sub, Finsupp.sub_apply, Int.cast_sub]
      have ha := abs_le.mp (hg k)
      have hb := abs_le.mp (h0 k)
      rw [abs_le]; constructor <;> linarith [ha.1, ha.2, hb.1, hb.2]
    have hcanEY : canNorm K (algebraMap _ K (e * Y)) ≤ C * (2 * M) :=
      ((hω.2 (e * Y)).2).trans (mul_le_mul_of_nonneg_left heY hC0.le)
    have hwY : ∀ w : NumberField.InfinitePlace K,
        w (algebraMap _ K Y) ≤ C * (2 * M) / ν := by
      intro w
      have h1 : w (algebraMap _ K (e * Y)) ≤ canNorm K (algebraMap _ K (e * Y)) := by
        unfold canNorm
        exact le_ciSup (f := fun w : NumberField.InfinitePlace K => w (algebraMap _ K (e * Y)))
          (Set.finite_range _).bddAbove w
      rw [map_mul, map_mul] at h1
      have hcanEY' := hcanEY
      rw [map_mul] at hcanEY'
      have hwe : ν ≤ w (algebraMap _ K e) := by
        first
          | exact he w
          | (have := he w; rwa [NumberField.RingOfIntegers.coe_eq_algebraMap] at this)
      have hY0 : 0 ≤ w (algebraMap _ K Y) := apply_nonneg w _
      rw [le_div_iff₀ hν]
      nlinarith [mul_le_mul_of_nonneg_right hwe hY0]
    have hcanY : canNorm K (algebraMap _ K Y) ≤ C * (2 * M) / ν := by
      unfold canNorm
      exact Real.iSup_le hwY (div_nonneg (mul_nonneg hC0.le (by linarith)) hν.le)
    have hbY : basisSupNorm ω Y ≤ T := by
      have hl := (hω.2 Y).1
      have hCl : basisSupNorm ω Y ≤ C * canNorm K (algebraMap _ K Y) := by
        have := mul_le_mul_of_nonneg_left hl hC0.le
        rwa [← mul_assoc, mul_inv_cancel₀ hC0.ne', one_mul] at this
      calc basisSupNorm ω Y ≤ C * canNorm K (algebraMap _ K Y) := hCl
        _ ≤ C * (C * (2 * M) / ν) := mul_le_mul_of_nonneg_left hcanY hC0.le
        _ = T := by rw [hT_def]; ring
    have := hbsn_le Y j
    rw [hrepY j] at this
    exact this.trans hbY
  
  obtain ⟨m, hm_def⟩ : ∃ m : ℤ, m = ⌊T⌋ := ⟨_, rfl⟩
  have hm0 : 0 ≤ m := by rw [hm_def]; exact Int.floor_nonneg.mpr hT0
  have hsub : Ry ⊆ Finset.Icc (fun _ => -m) (fun _ => m) := by
    intro y hy
    simp only [Finset.mem_Icc, Pi.le_def]
    constructor
    · intro j
      have hl := (abs_le.mp (hyT y hy j)).1
      have : -(y j) ≤ m := by
        rw [hm_def]; apply Int.le_floor.mpr; push_cast; linarith
      linarith
    · intro j
      have hr := (abs_le.mp (hyT y hy j)).2
      rw [hm_def]; apply Int.le_floor.mpr; exact hr
  have hcard : Ry.card ≤
      (Finset.Icc (fun _ : Fin (Module.finrank ℚ K) => -m) (fun _ => m)).card :=
    Finset.card_le_card hsub
  simp only [Pi.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    Int.card_Icc] at hcard
  have hcast : (((m + 1 - -m).toNat : ℕ) : ℝ) = 2 * (m : ℝ) + 1 := by
    rw [show m + 1 - -m = 2 * m + 1 by ring, ← Int.cast_natCast,
      Int.toNat_of_nonneg (by omega)]
    push_cast <;> ring
  have hmT : (m : ℝ) ≤ T := by rw [hm_def]; exact Int.floor_le T
  have hm0' : (0 : ℝ) ≤ m := by exact_mod_cast hm0
  calc (Ry.card : ℝ) ≤ ((((m + 1 - -m).toNat) ^ Module.finrank ℚ K : ℕ) : ℝ) := by
        exact_mod_cast hcard
    _ = (2 * (m : ℝ) + 1) ^ Module.finrank ℚ K := by rw [Nat.cast_pow, hcast]
    _ ≤ (2 * T + 1) ^ Module.finrank ℚ K :=
        pow_le_pow_left₀ (by linarith) (by linarith) _
    _ = (4 * C ^ 2 * M / ν + 1) ^ Module.finrank ℚ K := by rw [hT_def]; ring

theorem kai_v_si_rows (a r : ℕ) (k : Fin r → Fin a → ℤ) :
    ∃ k' : Fin a → Fin a → ℤ, (∀ m, (∃ m₀, k' m = k m₀) ∨ k' m = 0) ∧
      ∀ v : Fin a → ℝ, (∀ m, ∑ i, ((k' m i : ℤ) : ℝ) * v i = 0) →
        ∀ m, ∑ i, ((k m i : ℤ) : ℝ) * v i = 0 :=
by
  classical
  let f : Fin r → (Fin a → ℝ) := fun m i => ((k m i : ℤ) : ℝ)
  obtain ⟨κ, g, hg_inj, hspan, hli⟩ := exists_linearIndependent' ℝ f
  haveI : Finite κ := Finite.of_injective g hg_inj
  letI : Fintype κ := Fintype.ofFinite κ
  have hcard : Fintype.card κ ≤ Fintype.card (Fin a) := by
    have h1 := hli.fintype_card_le_finrank
    rw [Module.finrank_fin_fun] at h1
    simpa using h1
  obtain ⟨ε⟩ := Function.Embedding.nonempty_of_card_le hcard
  let k' : Fin a → Fin a → ℤ := fun m =>
    if h : ∃ j : κ, ε j = m then k (g (Classical.choose h)) else 0
  have hkey : ∀ j : κ, k' (ε j) = k (g j) := by
    intro j
    have h : ∃ j' : κ, ε j' = ε j := ⟨j, rfl⟩
    have hc : Classical.choose h = j := ε.injective (Classical.choose_spec h)
    show (if h : ∃ j' : κ, ε j' = ε j then k (g (Classical.choose h)) else 0) = k (g j)
    rw [dif_pos h, hc]
  refine ⟨k', ?_, ?_⟩
  · intro m
    by_cases h : ∃ j : κ, ε j = m
    · left
      refine ⟨g (Classical.choose h), ?_⟩
      show (if h : ∃ j : κ, ε j = m then k (g (Classical.choose h)) else 0) = _
      rw [dif_pos h]
    · right
      show (if h : ∃ j : κ, ε j = m then k (g (Classical.choose h)) else 0) = 0
      rw [dif_neg h]
  · intro v hv m
    let ℓ : (Fin a → ℝ) →ₗ[ℝ] ℝ :=
      { toFun := fun x => ∑ i, x i * v i
        map_add' := by intro x y; simp [add_mul, Finset.sum_add_distrib]
        map_smul' := by intro c x; simp [Finset.mul_sum, mul_assoc] }
    have hsub : Set.range (f ∘ g) ⊆ (LinearMap.ker ℓ : Set (Fin a → ℝ)) := by
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker]
      have := hv (ε j)
      rw [hkey j] at this
      exact this
    have hle := Submodule.span_le.mpr hsub
    rw [hspan] at hle
    have hm : f m ∈ LinearMap.ker ℓ := hle (Submodule.subset_span ⟨m, rfl⟩)
    exact LinearMap.mem_ker.mp hm

theorem kai_v_si_smooth_transfer (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (e : NumberField.RingOfIntegers K) (a r : ℕ) (k : Fin r → Fin a → ℤ)
    (p₁ : Fin (Module.finrank ℚ K) → Fin a → ℝ) (X s : ℝ) (hX : 0 ≤ X) (hs : 0 < s)
    (hsm : Nil2Smooth (fun j i => ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) k X s) :
    ∀ (m : Fin r) (y : NumberField.RingOfIntegers K), ∃ z : ℤ,
      |∑ l, ((ω.repr (e * y) l : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) * p₁ l i - z| ≤
        (Module.finrank ℚ K : ℝ) * basisSupNorm ω y * (X / s) :=
by
  intro m y
  have hc0 : ∀ j, ∃ c : ℤ, |∑ i, ((k m i : ℤ) : ℝ) *
      (∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) - (c : ℝ)| ≤ X / s := fun j => hsm m j
  choose c hc using hc0
  have hrepr : ∀ l, ((ω.repr (e * y) l : ℤ) : ℝ)
      = ∑ j, ((ω.repr y j : ℤ) : ℝ) * ((ω.repr (e * ω j) l : ℤ) : ℝ) := by
    intro l
    have hy : y = ∑ j, ω.repr y j • ω j := (ω.sum_repr y).symm
    have h1 : e * y = ∑ j, ω.repr y j • (e * ω j) := by
      conv_lhs => rw [hy]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [mul_smul_comm]
    have h2 : (ω.repr (e * y) l : ℤ) = ∑ j, ω.repr y j * ω.repr (e * ω j) l := by
      rw [h1, map_sum, Finsupp.finset_sum_apply]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul]
    rw [h2, Int.cast_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Int.cast_mul]
  have hθ : ∑ l, ((ω.repr (e * y) l : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) * p₁ l i
      = ∑ j, ((ω.repr y j : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) *
          (∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) := by
    have hstep1 : ∑ l, ((ω.repr (e * y) l : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) * p₁ l i
        = ∑ l, ∑ j, ((ω.repr y j : ℤ) : ℝ) * (((ω.repr (e * ω j) l : ℤ) : ℝ) *
            ∑ i, ((k m i : ℤ) : ℝ) * p₁ l i) := by
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [hrepr l, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ring
    rw [hstep1, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← Finset.mul_sum]
    congr 1
    have hstep2 : ∀ l : Fin (Module.finrank ℚ K),
        ((ω.repr (e * ω j) l : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) * p₁ l i
          = ∑ i, ((k m i : ℤ) : ℝ) * (((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) := by
      intro l
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      ring
    have hstep3 : ∀ i : Fin a,
        ((k m i : ℤ) : ℝ) * ∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i
          = ∑ l, ((k m i : ℤ) : ℝ) * (((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) := by
      intro i
      rw [Finset.mul_sum]
    rw [Finset.sum_congr rfl (fun l _ => hstep2 l), Finset.sum_congr rfl (fun i _ => hstep3 i)]
    exact Finset.sum_comm
  have hB0 : 0 ≤ basisSupNorm ω y := by
    unfold basisSupNorm
    exact Real.iSup_nonneg (fun j => abs_nonneg _)
  have hyj : ∀ j, |((ω.repr y j : ℤ) : ℝ)| ≤ basisSupNorm ω y := by
    intro j
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr y j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  refine ⟨∑ j, ω.repr y j * c j, ?_⟩
  rw [hθ, Int.cast_sum]
  simp only [Int.cast_mul]
  rw [← Finset.sum_sub_distrib]
  calc |∑ j, (((ω.repr y j : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) *
          (∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) - ((ω.repr y j : ℤ) : ℝ) * (c j : ℝ))|
      ≤ ∑ j, |((ω.repr y j : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) *
          (∑ l, ((ω.repr (e * ω j) l : ℤ) : ℝ) * p₁ l i) - ((ω.repr y j : ℤ) : ℝ) * (c j : ℝ)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j : Fin (Module.finrank ℚ K), basisSupNorm ω y * (X / s) := by
        refine Finset.sum_le_sum (fun j _ => ?_)
        rw [← mul_sub, abs_mul]
        exact mul_le_mul (hyj j) (hc j) (abs_nonneg _) hB0
    _ = (Module.finrank ℚ K : ℝ) * basisSupNorm ω y * (X / s) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

theorem kai_v_si_calibration (A n : ℕ) (C₄ C₅ C_e : ℝ) (hn : 1 ≤ n) (hC₄ : 1 ≤ C₄)
    (hC₅ : 1 ≤ C₅) (hCe : 1 ≤ C_e) :
    ∃ M₇ : ℝ, 3 ≤ M₇ ∧ ∀ (M D Q η : ℝ), M₇ ≤ M → 1 ≤ D → 2 ≤ Q → 0 < η → η ≤ 1 →
      (D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ (A + 2) ≤ Real.log M →
      1 ≤ Real.log M ∧
      C_e / η ≤
        Real.exp ((D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ (A + 2)) ∧
      Real.exp ((D + Real.log Q + Real.log (1 / (η ^ 2 / C₅))) ^ A) ≤
        Real.exp ((D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ (A + 2)) ∧
      2 * (n : ℝ) * C₄ * Q * Real.exp ((D + Real.log Q + Real.log (1 / (η ^ 2 / C₅))) ^ A) *
          Real.log M ^ (n - 1) ≤
        η ^ 3 *
          Real.exp ((D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ (A + 2)) ∧
      2 ^ (n + 2) * C_e * Q ≤ η ^ 2 * M ^ ((n : ℝ) / 4) ∧
      2 * C₄ * Q * Real.log M ^ (n - 1) ≤ η ^ 3 * M ^ ((1 : ℝ) / 4) :=
by
  
  have hnR : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hn0 : (0 : ℝ) ≤ (n : ℝ) := by linarith
  have h2nC : (0 : ℝ) < 2 * (n : ℝ) * C₄ := by
    have : (0 : ℝ) < 2 * (n : ℝ) := by linarith
    exact mul_pos this (by linarith)
  have hc0 : 0 ≤ Real.log (2 * (n : ℝ) * C₄) := by
    apply Real.log_nonneg
    have h1 : (2 : ℝ) ≤ 2 * (n : ℝ) := by linarith
    have h2 : 2 * (n : ℝ) * 1 ≤ 2 * (n : ℝ) * C₄ := mul_le_mul_of_nonneg_left hC₄ (by linarith)
    linarith
  have h2C : (0 : ℝ) < 2 * C₄ := by linarith
  have hl2C : 0 ≤ Real.log (2 * C₄) := Real.log_nonneg (by linarith)
  have hlC5 : 0 ≤ Real.log C₅ := Real.log_nonneg hC₅
  have hlCe : 0 ≤ Real.log C_e := Real.log_nonneg hCe
  have hCepos : 0 < C_e := by linarith
  have h3A : (1 : ℝ) ≤ 3 ^ A := one_le_pow₀ (by norm_num)
  have hnsub : (((n - 1 : ℕ) : ℝ)) = (n : ℝ) - 1 := by
    rw [Nat.cast_sub hn]; norm_num
  
  have hexpQ : ∀ Q L : ℝ, 0 < Q → Real.log Q ≤ L → Q ≤ Real.exp L := fun Q L hQ h =>
    calc Q = Real.exp (Real.log Q) := (Real.exp_log hQ).symm
      _ ≤ Real.exp L := Real.exp_le_exp.mpr h
  have hstarG : ∀ η L : ℝ, 0 < η → Real.log (1 / η) ≤ L → 1 ≤ η * Real.exp L := by
    intro η L hη h
    have h1 := hexpQ (1 / η) L (by positivity) h
    rw [div_le_iff₀ hη] at h1
    linarith
  have hpowt : ∀ t L : ℝ, 0 < t → Real.log t ≤ L →
      t ^ (n - 1) ≤ Real.exp (((n : ℝ) - 1) * L) := by
    intro t L ht h
    calc t ^ (n - 1) ≤ Real.exp L ^ (n - 1) := pow_le_pow_left₀ ht.le (hexpQ t L ht h) _
      _ = Real.exp (((n : ℝ) - 1) * L) := by rw [← Real.exp_nat_mul, hnsub]
  have hexp3 : ∀ L : ℝ, Real.exp (3 * L) = Real.exp L ^ 3 := by
    intro L; rw [← Real.exp_nat_mul]; norm_num
  have hexp2 : ∀ L : ℝ, Real.exp (2 * L) = Real.exp L ^ 2 := by
    intro L; rw [← Real.exp_nat_mul]; norm_num
  
  have hexpPart : ∀ (Q η t L L' : ℝ), 0 < Q → 0 < η → 0 < t →
      Real.log Q ≤ L → Real.log (1 / η) ≤ L → Real.log t ≤ L →
      0 ≤ L' → L' ≤ 2 * L + Real.log C₅ →
      Real.log (2 * (n : ℝ) * C₄) + (n : ℝ) + 3 + (3 : ℝ) ^ A + Real.log C₅
        + Real.log C_e + 1 ≤ L →
      C_e / η ≤ Real.exp (L ^ (A + 2)) ∧
      Real.exp (L' ^ A) ≤ Real.exp (L ^ (A + 2)) ∧
      2 * (n : ℝ) * C₄ * Q * Real.exp (L' ^ A) * t ^ (n - 1) ≤
        η ^ 3 * Real.exp (L ^ (A + 2)) := by
    intro Q η t L L' hQ hη ht hLQ hLη hLt hL'0 hL'L hΛ
    have hL1 : 1 ≤ L := by linarith
    have hL0 : 0 ≤ L := by linarith
    have hQe := hexpQ Q L hQ hLQ
    have hηe := hexpQ (1 / η) L (by positivity) hLη
    have hstar := hstarG η L hη hLη
    have hpA1 : L ^ A ≤ L ^ (A + 1) := pow_le_pow_right₀ hL1 (by omega)
    have hLX : L ≤ L ^ (A + 1) := by
      simpa using pow_le_pow_right₀ hL1 (show 1 ≤ A + 1 by omega)
    have h1X : 1 ≤ L ^ (A + 1) := one_le_pow₀ hL1
    have hA2 : L ^ (A + 2) = L * L ^ (A + 1) := by ring
    have hL2 : L ^ 2 ≤ L ^ (A + 2) := pow_le_pow_right₀ hL1 (by omega)
    have hsq : L ^ 2 = L * L := by ring
    
    have hc2 : C_e / η ≤ Real.exp (L ^ (A + 2)) := by
      have k1 : L * (1 + Real.log C_e) ≤ L * L := mul_le_mul_of_nonneg_left (by linarith) hL0
      have k2 : Real.log C_e ≤ L * Real.log C_e := le_mul_of_one_le_left hlCe hL1
      have hexp : Real.log C_e + L ≤ L ^ (A + 2) := by linarith
      calc C_e / η = C_e * (1 / η) := by ring
        _ ≤ C_e * Real.exp L := mul_le_mul_of_nonneg_left hηe hCepos.le
        _ = Real.exp (Real.log C_e) * Real.exp L := by rw [Real.exp_log hCepos]
        _ = Real.exp (Real.log C_e + L) := (Real.exp_add _ _).symm
        _ ≤ _ := Real.exp_le_exp.mpr hexp
    
    have hL'3 : L' ≤ 3 * L := by linarith
    have hdag : L' ^ A ≤ 3 ^ A * L ^ A := by
      rw [← mul_pow]; exact pow_le_pow_left₀ hL'0 hL'3 A
    have h3AL : (3 : ℝ) ^ A ≤ L ^ 2 := by
      have hLL : L ≤ L ^ 2 := le_self_pow₀ hL1 (by norm_num)
      linarith
    have hc3e : L' ^ A ≤ L ^ (A + 2) :=
      calc L' ^ A ≤ 3 ^ A * L ^ A := hdag
        _ ≤ L ^ 2 * L ^ A := mul_le_mul_of_nonneg_right h3AL (pow_nonneg hL0 _)
        _ = L ^ (A + 2) := by ring
    refine ⟨hc2, Real.exp_le_exp.mpr hc3e, ?_⟩
    
    obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ℝ, c₀ = Real.log (2 * (n : ℝ) * C₄) := ⟨_, rfl⟩
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = c₀ + L + 3 ^ A * L ^ A + ((n : ℝ) - 1) * L := ⟨_, rfl⟩
    have hLHS : 2 * (n : ℝ) * C₄ * Q * Real.exp (L' ^ A) * t ^ (n - 1) ≤ Real.exp E := by
      have h1 : Real.exp (L' ^ A) ≤ Real.exp (3 ^ A * L ^ A) := Real.exp_le_exp.mpr hdag
      have h2 := hpowt t L ht hLt
      calc 2 * (n : ℝ) * C₄ * Q * Real.exp (L' ^ A) * t ^ (n - 1)
          ≤ 2 * (n : ℝ) * C₄ * Real.exp L * Real.exp (3 ^ A * L ^ A)
              * Real.exp (((n : ℝ) - 1) * L) := by
            apply mul_le_mul _ h2 (pow_nonneg ht.le _)
              (mul_nonneg (mul_nonneg h2nC.le (Real.exp_pos _).le) (Real.exp_pos _).le)
            apply mul_le_mul _ h1 (Real.exp_pos _).le (mul_nonneg h2nC.le (Real.exp_pos _).le)
            exact mul_le_mul_of_nonneg_left hQe h2nC.le
        _ = Real.exp c₀ * Real.exp L * Real.exp (3 ^ A * L ^ A)
              * Real.exp (((n : ℝ) - 1) * L) := by rw [hc₀, Real.exp_log h2nC]
        _ = Real.exp E := by rw [hE, Real.exp_add, Real.exp_add, Real.exp_add]
    have hEexp : 3 * L + E ≤ L ^ (A + 2) := by
      have hc0' : 0 ≤ c₀ := by rw [hc₀]; exact hc0
      have e1 : c₀ ≤ c₀ * L ^ (A + 1) := le_mul_of_one_le_right hc0' h1X
      have e2 : ((n : ℝ) + 3) * L ≤ ((n : ℝ) + 3) * L ^ (A + 1) :=
        mul_le_mul_of_nonneg_left hLX (by linarith)
      have e3 : (3 : ℝ) ^ A * L ^ A ≤ 3 ^ A * L ^ (A + 1) :=
        mul_le_mul_of_nonneg_left hpA1 (by positivity)
      have e4 : (c₀ + n + 3 + 3 ^ A) * L ^ (A + 1) ≤ L * L ^ (A + 1) :=
        mul_le_mul_of_nonneg_right (by rw [hc₀]; linarith) (by linarith)
      rw [hA2, hE]
      linarith
    calc 2 * (n : ℝ) * C₄ * Q * Real.exp (L' ^ A) * t ^ (n - 1) ≤ Real.exp E := hLHS
      _ ≤ (η * Real.exp L) ^ 3 * Real.exp E :=
          le_mul_of_one_le_left (Real.exp_pos _).le (one_le_pow₀ hstar)
      _ = η ^ 3 * Real.exp (3 * L + E) := by rw [Real.exp_add, hexp3]; ring
      _ ≤ η ^ 3 * Real.exp (L ^ (A + 2)) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hEexp) (pow_nonneg hη.le 3)
  
  have hrpowPart : ∀ (M Q η L : ℝ), 0 < M → 0 < Q → 0 < η →
      Real.log Q ≤ L → Real.log (1 / η) ≤ L → Real.log (Real.log M) ≤ L →
      0 ≤ L → L ^ 2 ≤ Real.log M →
      8 * ((n : ℝ) + 2 + Real.log C_e) + 64 * ((n : ℝ) + 3) ^ 2
        + 8 * Real.log (2 * C₄) ≤ Real.log M →
      2 ^ (n + 2) * C_e * Q ≤ η ^ 2 * M ^ ((n : ℝ) / 4) ∧
      2 * C₄ * Q * Real.log M ^ (n - 1) ≤ η ^ 3 * M ^ ((1 : ℝ) / 4) := by
    intro M Q η L hM hQ hη hLQ hLη hLt hL0 hL2 hT
    obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = Real.log M := ⟨_, rfl⟩
    rw [← ht_def] at hLt hL2 hT ⊢
    have hsq : 0 ≤ 64 * ((n : ℝ) + 3) ^ 2 := by positivity
    have ht1 : 8 * ((n : ℝ) + 2 + Real.log C_e) ≤ t := by linarith
    have ht2 : 64 * ((n : ℝ) + 3) ^ 2 ≤ t := by linarith
    have ht3 : 8 * Real.log (2 * C₄) ≤ t := by linarith
    have htpos : 0 < t := by linarith
    have hQe := hexpQ Q L hQ hLQ
    have hstar := hstarG η L hη hLη
    
    have hc8 : (0 : ℝ) ≤ 8 * ((n : ℝ) + 3) := by linarith
    have habs : 8 * ((n : ℝ) + 3) * L ≤ t := by
      rcases le_total L (8 * ((n : ℝ) + 3)) with h | h
      · have k := mul_le_mul_of_nonneg_left h hc8
        have k' : 8 * ((n : ℝ) + 3) * (8 * ((n : ℝ) + 3)) = 64 * ((n : ℝ) + 3) ^ 2 := by ring
        linarith
      · have k := mul_le_mul_of_nonneg_right h hL0
        have k' : L * L = L ^ 2 := by ring
        linarith
    have hnL : 0 ≤ (n : ℝ) * L := mul_nonneg hn0 hL0
    have hrp : ∀ x : ℝ, M ^ x = Real.exp (t * x) := by
      intro x; rw [ht_def]; exact Real.rpow_def_of_pos hM x
    constructor
    · 
      have h2e : (2 : ℝ) ≤ Real.exp 1 := by
        have := Real.add_one_le_exp (1 : ℝ); linarith
      have h2pow : (2 : ℝ) ^ (n + 2) ≤ Real.exp ((n : ℝ) + 2) := by
        calc (2 : ℝ) ^ (n + 2) ≤ Real.exp 1 ^ (n + 2) := pow_le_pow_left₀ (by norm_num) h2e _
          _ = Real.exp ((n : ℝ) + 2) := by rw [← Real.exp_nat_mul]; push_cast; ring_nf
      obtain ⟨E, hE⟩ : ∃ E : ℝ, E = (n : ℝ) + 2 + Real.log C_e + L := ⟨_, rfl⟩
      have hLHS : 2 ^ (n + 2) * C_e * Q ≤ Real.exp E := by
        calc 2 ^ (n + 2) * C_e * Q ≤ Real.exp ((n : ℝ) + 2) * C_e * Real.exp L := by
              apply mul_le_mul _ hQe hQ.le (mul_nonneg (Real.exp_pos _).le hCepos.le)
              exact mul_le_mul_of_nonneg_right h2pow hCepos.le
          _ = Real.exp ((n : ℝ) + 2) * Real.exp (Real.log C_e) * Real.exp L := by
              rw [Real.exp_log hCepos]
          _ = Real.exp E := by
              rw [hE, Real.exp_add ((n : ℝ) + 2 + Real.log C_e) L,
                Real.exp_add ((n : ℝ) + 2) (Real.log C_e)]
      have htn : t * 1 ≤ t * (n : ℝ) := mul_le_mul_of_nonneg_left hnR htpos.le
      have hEexp : 2 * L + E ≤ t * ((n : ℝ) / 4) := by
        rw [hE]; linarith
      calc 2 ^ (n + 2) * C_e * Q ≤ Real.exp E := hLHS
        _ ≤ (η * Real.exp L) ^ 2 * Real.exp E :=
            le_mul_of_one_le_left (Real.exp_pos _).le (one_le_pow₀ hstar)
        _ = η ^ 2 * Real.exp (2 * L + E) := by rw [Real.exp_add, hexp2]; ring
        _ ≤ η ^ 2 * M ^ ((n : ℝ) / 4) := by
            rw [hrp]
            exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hEexp) (pow_nonneg hη.le 2)
    · 
      have h2 := hpowt t L htpos hLt
      obtain ⟨E, hE⟩ : ∃ E : ℝ, E = Real.log (2 * C₄) + L + ((n : ℝ) - 1) * L := ⟨_, rfl⟩
      have hLHS : 2 * C₄ * Q * t ^ (n - 1) ≤ Real.exp E := by
        calc 2 * C₄ * Q * t ^ (n - 1)
            ≤ 2 * C₄ * Real.exp L * Real.exp (((n : ℝ) - 1) * L) := by
              apply mul_le_mul _ h2 (pow_nonneg htpos.le _)
                (mul_nonneg h2C.le (Real.exp_pos _).le)
              exact mul_le_mul_of_nonneg_left hQe h2C.le
          _ = Real.exp (Real.log (2 * C₄)) * Real.exp L * Real.exp (((n : ℝ) - 1) * L) := by
              rw [Real.exp_log h2C]
          _ = Real.exp E := by rw [hE, Real.exp_add, Real.exp_add]
      have hEexp : 3 * L + E ≤ t * ((1 : ℝ) / 4) := by
        rw [hE]; linarith
      calc 2 * C₄ * Q * t ^ (n - 1) ≤ Real.exp E := hLHS
        _ ≤ (η * Real.exp L) ^ 3 * Real.exp E :=
            le_mul_of_one_le_left (Real.exp_pos _).le (one_le_pow₀ hstar)
        _ = η ^ 3 * Real.exp (3 * L + E) := by rw [Real.exp_add, hexp3]; ring
        _ ≤ η ^ 3 * M ^ ((1 : ℝ) / 4) := by
            rw [hrp]
            exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hEexp) (pow_nonneg hη.le 3)
  
  obtain ⟨Λ₀, hΛ₀⟩ : ∃ x : ℝ, x = Real.log (2 * (n : ℝ) * C₄) + (n : ℝ) + 3 + (3 : ℝ) ^ A
      + Real.log C₅ + Real.log C_e + 1 := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ x : ℝ, x = 8 * ((n : ℝ) + 2 + Real.log C_e) + 64 * ((n : ℝ) + 3) ^ 2
      + 8 * Real.log (2 * C₄) := ⟨_, rfl⟩
  have hΛ0 : 0 ≤ Λ₀ := by rw [hΛ₀]; linarith
  refine ⟨3 + Real.exp (Real.exp Λ₀) + Real.exp T, ?_, ?_⟩
  · have := Real.exp_pos (Real.exp Λ₀); have := Real.exp_pos T; linarith
  intro M D Q η hM hD hQ hη0 hη1 hH
  have hE1 := Real.exp_pos (Real.exp Λ₀)
  have hE2 := Real.exp_pos T
  have hMpos : 0 < M := by linarith
  have hlogM1 : Real.exp Λ₀ ≤ Real.log M := by
    have h := Real.log_le_log (Real.exp_pos _) (show Real.exp (Real.exp Λ₀) ≤ M by linarith)
    rwa [Real.log_exp] at h
  have hc1 : 1 ≤ Real.log M := le_trans (Real.one_le_exp hΛ0) hlogM1
  have hlogpos : 0 < Real.log M := by linarith
  have hΛll : Λ₀ ≤ Real.log (Real.log M) := by
    have h := Real.log_le_log (Real.exp_pos _) hlogM1
    rwa [Real.log_exp] at h
  have hTM : T ≤ Real.log M := by
    have h := Real.log_le_log (Real.exp_pos _) (show Real.exp T ≤ M by linarith)
    rwa [Real.log_exp] at h
  
  have hQpos : 0 < Q := by linarith
  have ha : 0 ≤ Real.log Q := Real.log_nonneg (by linarith)
  have hb_eq : Real.log (1 / η) = -Real.log η := by rw [one_div, Real.log_inv]
  have hb : 0 ≤ Real.log (1 / η) := by
    rw [hb_eq]; have := Real.log_nonpos hη0.le hη1; linarith
  have hc : 0 ≤ Real.log (Real.log M) := Real.log_nonneg hc1
  have hL'eq : Real.log (1 / (η ^ 2 / C₅)) = Real.log C₅ + 2 * Real.log (1 / η) := by
    rw [one_div_div, Real.log_div (by linarith) (by positivity), Real.log_pow, hb_eq]
    push_cast; ring
  have hL1 : 1 ≤ D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M) := by linarith
  have hLQ : Real.log Q ≤ D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M) := by
    linarith
  have hLη : Real.log (1 / η) ≤ D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M) := by
    linarith
  have hLt : Real.log (Real.log M) ≤
      D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M) := by linarith
  have hL'0 : 0 ≤ D + Real.log Q + Real.log (1 / (η ^ 2 / C₅)) := by rw [hL'eq]; linarith
  have hL'L : D + Real.log Q + Real.log (1 / (η ^ 2 / C₅)) ≤
      2 * (D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) + Real.log C₅ := by
    rw [hL'eq]; linarith
  have hΛL : Real.log (2 * (n : ℝ) * C₄) + (n : ℝ) + 3 + (3 : ℝ) ^ A + Real.log C₅
      + Real.log C_e + 1 ≤ D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M) := by
    rw [← hΛ₀]; exact le_trans hΛll hLt
  obtain ⟨c2, c3, c4⟩ := hexpPart Q η (Real.log M) _ _ hQpos hη0 hlogpos hLQ hLη hLt
    hL'0 hL'L hΛL
  have hL2 : (D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ 2 ≤ Real.log M :=
    le_trans (pow_le_pow_right₀ hL1 (by omega)) hH
  obtain ⟨c5, c6⟩ := hrpowPart M Q η _ hMpos hQpos hη0 hLQ hLη hLt (by linarith) hL2
    (by rw [← hT]; exact hTM)
  exact ⟨hc1, c2, c3, c4, c5, c6⟩

theorem kai_v_typeI_single_ideal (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∀ A : ℕ, Nil2VertEquidist (Module.finrank ℚ K) A →
    ∃ (A₇ : ℕ) (M₇ : ℝ), 1 ≤ A₇ ∧ 3 ≤ M₇ ∧
      ∀ (M D Q η Y : ℝ), M₇ ≤ M → 1 ≤ D → 2 ≤ Q → 0 < η → η ≤ 1 →
        (D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ A₇ ≤ Real.log M →
      ∀ (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
        (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ), Nil2VertData D Q Bc ξ F →
      ∀ (p₀ : Fin a → ℝ) (p₁ : Fin (Module.finrank ℚ K) → Fin a → ℝ) (r₀ : Fin b → ℝ)
        (r₁ : Fin (Module.finrank ℚ K) → Fin b → ℝ)
        (r₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → Fin b → ℝ)
        (𝔮 : Ideal (NumberField.RingOfIntegers K)) (χ : NumberField.RingOfIntegers K → ℂ),
        𝔮 ≠ ⊥ → (Ideal.absNorm 𝔮 : ℝ) ≤ 1 / η → (∀ x, ‖χ x‖ ≤ 1) →
        (∀ x₁ x₂ : NumberField.RingOfIntegers K, x₁ - x₂ ∈ 𝔮 →
          (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
            0 < NumberField.InfinitePlace.embedding_of_isReal hw (x₁ : K) *
              NumberField.InfinitePlace.embedding_of_isReal hw (x₂ : K)) → χ x₁ = χ x₂) →
      ∀ (𝔡 : Ideal (NumberField.RingOfIntegers K)) (R : ℝ), 𝔡 ≠ ⊥ →
        (Ideal.absNorm 𝔡 : ℝ) ≤ M ^ ((3 * (Module.finrank ℚ K : ℝ)) / 4) →
        1 ≤ R → (Ideal.absNorm 𝔡 : ℝ) ≤ R ^ Module.finrank ℚ K →
        η * ((omegaBox ω M).card : ℝ) / (Ideal.absNorm 𝔡 : ℝ)
          ≤ ‖kaiTypeIInner ω M (fun x => nil2Eval p₀ p₁ r₀ r₁ r₂ F (ω.equivFun x)) χ 𝔡 Y‖ →
        ∃ e : NumberField.RingOfIntegers K, e ∈ 𝔡 ∧ e ≠ 0 ∧
          basisSupNorm ω e ≤
            Real.exp ((D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ A₇) * R ∧
          ∃ k : Fin a → Fin a → ℤ,
            (∀ m i, |((k m i : ℤ) : ℝ)| ≤
              Real.exp ((D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ A₇)) ∧
            Nil2Isotropic Bc ξ k ∧
            ∀ (m : Fin a) (y : NumberField.RingOfIntegers K), ∃ z : ℤ,
              |∑ l, ((ω.repr (e * y) l : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) * p₁ l i - z|
                ≤ Real.exp ((D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M)) ^ A₇)
                  * basisSupNorm ω y * R / M :=
by
  classical
  intro A hE
  obtain ⟨C_e, hCe1, hSE⟩ := kai_v_si_short_element K C ω hω
  obtain ⟨C_B, hCB1, hBC⟩ := kai_v_si_boundary_cubes K C ω hω
  have hC1 : 1 < C := hω.1
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hn0 : Module.finrank ℚ K ≠ 0 := by omega
  have hnR : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn1
  obtain ⟨C₄, hC₄⟩ : ∃ x : ℝ,
      x = 2 ^ (Module.finrank ℚ K + 2) * C_B * C_e ^ Module.finrank ℚ K := ⟨_, rfl⟩
  obtain ⟨C₅, hC₅⟩ : ∃ x : ℝ,
      x = 2 ^ (Module.finrank ℚ K + 2) * C_e * (5 * C ^ 2 * C_e) ^ Module.finrank ℚ K :=
    ⟨_, rfl⟩
  have h2pow : (1 : ℝ) ≤ 2 ^ (Module.finrank ℚ K + 2) := one_le_pow₀ (by norm_num)
  have hCepow : (1 : ℝ) ≤ C_e ^ Module.finrank ℚ K := one_le_pow₀ hCe1
  have hC2 : (1 : ℝ) ≤ C ^ 2 := one_le_pow₀ hC1.le
  have h5C : (1 : ℝ) ≤ 5 * C ^ 2 * C_e :=
    one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le (by norm_num) hC2) hCe1
  have hC₄1 : 1 ≤ C₄ := by
    rw [hC₄]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h2pow hCB1) hCepow
  have hC₅1 : 1 ≤ C₅ := by
    rw [hC₅]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h2pow hCe1)
      (one_le_pow₀ h5C)
  obtain ⟨M₇, hM₇3, hCAL⟩ :=
    kai_v_si_calibration A (Module.finrank ℚ K) C₄ C₅ C_e hn1 hC₄1 hC₅1 hCe1
  refine ⟨A + 2, M₇, by omega, hM₇3, ?_⟩
  intro M D Q η Y hM hD hQ hη0 hη1 hLM a b Bc ξ F hdata p₀ p₁ r₀ r₁ r₂ 𝔮 χ h𝔮 hN𝔮 hχ1 hχc
    𝔡 R h𝔡 hN𝔡M hR1 hN𝔡R hS
