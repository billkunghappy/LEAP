        refine hmem P hS.1 hS.2 ?_
        rw [← hrm]
        exact (hrc P hS.1 hS.2).2.2.2
      · refine ⟨∅, by simp, ?_⟩
        intro P hS hrm
        have hpr := (hrc P hS.1 hS.2).1
        rw [hrm] at hpr
        exact absurd hpr hm
    obtain ⟨col, hcol⟩ :
        ∃ c : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K),
          ∀ a b : Ideal (NumberField.RingOfIntegers K),
            (a.IsPrime ∧ a ≠ ⊥) → (b.IsPrime ∧ b ≠ ⊥) →
            rchar a = rchar b → c a = c b → a = b := by
