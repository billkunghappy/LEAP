    rw [Finset.sum_congr rfl hEq]
    have h1 : η ^ 22 ≤ η / 8 := by
      have e : η ^ 22 = η * η ^ 21 := by ring
      rw [e]
      have := mul_le_mul_of_nonneg_left hη21 hηpos.le
      linarith
    calc η ^ 22 * ((giBohr P S₃ ρ₅).card : ℝ) ≤ η / 8 * ((giBohr P S₃ ρ₅).card : ℝ) :=
          mul_le_mul_of_nonneg_right h1 (Nat.cast_nonneg _)
      _ ≤ _ := hmain

theorem zmod_phase_derivative_to_bohr_locquad (C_BR : ℕ) (hBR : GiSandersBR C_BR) :
    ∃ C₅ : ℕ, 1 ≤ C₅ ∧
      ∀ (P : ℕ) [NeZero P], P.Prime → 3 ≤ P →
      ∀ (g : ZMod P → ℝ) (Λ : ℝ) (H : Finset (ZMod P)) (ξ : ZMod P → ZMod P),
        (∀ x, |g x| ≤ 1) → 1 ≤ Λ →
        Real.exp (-Λ) * P ≤ ((giGraph P H ξ).card : ℝ) →
        ((giSumset98 P (giGraph P H ξ)).card : ℝ) ≤ Real.exp Λ * P →
        (∀ h ∈ H, Real.exp (-Λ) * P ≤
          ‖∑ x : ZMod P, ((g (x + h) * g x : ℝ) : ℂ) * giE (-(((ξ h * x).val : ℝ) / P))‖) →
        ∃ (S : Finset (ZMod P)) (ρ : ℝ) (y : ZMod P) (φ : ZMod P → ℝ),
          (S.card : ℝ) ≤ C₅ * Λ ^ C₅ ∧ Real.exp (-((C₅ : ℝ) * Λ ^ C₅)) ≤ ρ ∧ ρ ≤ 1 / 8 ∧
          GiRegularBohr P S ρ ∧
          GiLocQuadOn P ((giBohr P S ρ).image (fun x => y + x)) φ ∧
          Real.exp (-((C₅ : ℝ) * Λ ^ C₅)) * ((giBohr P S ρ).card : ℝ) ≤
            ‖∑ x ∈ giBohr P S ρ, ((g (y + x) : ℝ) : ℂ) * giE (-(φ (y + x)))‖ :=
by
  obtain ⟨A₂, E₂, hA₂, hE₂, hs12⟩ := gi_bohr_linearization C_BR hBR
  obtain ⟨A₃, E₃, hA₃, hE₃, hs13⟩ := gi_bohr_symmetry C_BR hBR
  have hpos : 0 < 22 * A₃ * A₂ ^ E₃ :=
    Nat.mul_pos (Nat.mul_pos (by norm_num) hA₃) (pow_pos hA₂ _)
  refine ⟨22 * A₃ * A₂ ^ E₃ + E₂ * E₃, by omega, ?_⟩
  intro P hPne hP hP3 g Λ H ξ hg hΛ h1 h2 h3
  obtain ⟨H'', hH''sub, hH''card, hFr⟩ :=
    gi_graph_freiman_refinement P hP Λ hΛ H ξ h1 h2
  have h3' : ∀ h ∈ H'', Real.exp (-Λ) * P ≤
      ‖∑ x : ZMod P, ((g (x + h) * g x : ℝ) : ℂ) * giE (-(((ξ h * x).val : ℝ) / P))‖ :=
    fun h hh => h3 h (hH''sub hh)
  obtain ⟨S₁, ρ₀, ρ₁, x₀, ξ₀, M, hS₁, hρ₀, hρ₀', hρ₁, hρ₁', hreg₁, hM0, hMfr, hcor⟩ :=
    hs12 P hP hP3 g Λ H'' ξ hg hΛ hH''card hFr h3'
  have hA₂R : (1 : ℝ) ≤ (A₂ : ℝ) := by exact_mod_cast hA₂
  have hA₃R : (1 : ℝ) ≤ (A₃ : ℝ) := by exact_mod_cast hA₃
  have hD₁1 : (1 : ℝ) ≤ (A₂ : ℝ) * Λ ^ E₂ :=
    one_le_mul_of_one_le_of_one_le hA₂R (one_le_pow₀ hΛ)
  obtain ⟨S₃, r₃, hS₃sub, hS₃, hr₃, hr₃', hsym⟩ :=
    hs13 P hP hP3 g ((A₂ : ℝ) * Λ ^ E₂) S₁ ρ₀ ρ₁ x₀ ξ₀ M hg hD₁1 hS₁ hρ₀ hρ₀' hρ₁ hρ₁'
      hreg₁ hM0 hMfr hcor
  have hD₁D₃ : (A₂ : ℝ) * Λ ^ E₂ ≤ (A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃ := by
    calc (A₂ : ℝ) * Λ ^ E₂ ≤ ((A₂ : ℝ) * Λ ^ E₂) ^ E₃ := le_self_pow₀ hD₁1 (by omega)
      _ ≤ (A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃ :=
          le_mul_of_one_le_left (by positivity) hA₃R
  have hD₃1 : (1 : ℝ) ≤ (A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃ := hD₁1.trans hD₁D₃
  have hexp : Real.exp (-((A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃))
      ≤ Real.exp (-((A₂ : ℝ) * Λ ^ E₂)) := Real.exp_le_exp.mpr (by linarith)
  have hcor' : Real.exp (-((A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃)) * P
      * ((giBohr P S₁ ρ₁).card : ℝ) ≤
        ∑ h ∈ giBohr P S₁ ρ₁, ‖∑ x : ZMod P, ((g (x + x₀ + h) * g x : ℝ) : ℂ) *
          giE (-((((ξ₀ + 2 * M h) * x).val : ℝ) / P))‖ :=
    le_trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hexp (Nat.cast_nonneg _)) (Nat.cast_nonneg _)) hcor
  have hsym' : ∀ x ∈ giBohr P S₃ r₃, ∀ z ∈ giBohr P S₃ r₃, ∀ t : ℝ, 0 < t →
      (∀ ξ ∈ S₃, giCircNorm P (ξ * x) ≤ t) →
      giCircNorm P (M x * z - M z * x)
        ≤ Real.exp ((A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃) * t := hsym
  obtain ⟨S, ρ, y, φ, hS, hρ, hρ', hreg, hlq, hcorr⟩ :=
    gi_bohr_quadratic_elimination P hP hP3 g ((A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃)
      S₁ ρ₀ ρ₁ x₀ ξ₀ M S₃ r₃ hg hD₃1 (hS₁.trans hD₁D₃) (hexp.trans hρ₀) hρ₀' hρ₁ hρ₁'
      hreg₁ hM0 hMfr hcor' hS₃sub hS₃ hr₃ hr₃' hsym'
  have hkey : 22 * ((A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃)
      ≤ ((22 * A₃ * A₂ ^ E₃ + E₂ * E₃ : ℕ) : ℝ) * Λ ^ (22 * A₃ * A₂ ^ E₃ + E₂ * E₃) := by
    have e1 : 22 * ((A₃ : ℝ) * ((A₂ : ℝ) * Λ ^ E₂) ^ E₃)
        = ((22 * A₃ * A₂ ^ E₃ : ℕ) : ℝ) * Λ ^ (E₂ * E₃) := by
      push_cast
      rw [mul_pow, ← pow_mul]
      ring
    rw [e1]
    apply mul_le_mul
    · exact_mod_cast Nat.le_add_right _ _
    · exact pow_le_pow_right₀ hΛ (Nat.le_add_left _ _)
    · positivity
    · positivity
  refine ⟨S, ρ, y, φ, hS.trans hkey, ?_, hρ', hreg, hlq, ?_⟩
  · exact (Real.exp_le_exp.mpr (by linarith)).trans hρ
  · exact le_trans (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr (by linarith))
      (Nat.cast_nonneg _)) hcorr

theorem giBohr_card_ge (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (r : ℝ) (hr : 0 < r)
    (hr1 : r ≤ 1) :
    (r / 2) ^ S.card * (P : ℝ) ≤ ((giBohr P S r).card : ℝ) :=
by
  classical
  have hP : 0 < P := NeZero.pos P
  have hPr : (0:ℝ) < P := by exact_mod_cast hP
  obtain ⟨m, hm_def⟩ : ∃ m : ℕ, m = ⌈1 / r⌉₊ := ⟨_, rfl⟩
  have hinv : 1 ≤ 1 / r := by rw [le_div_iff₀ hr]; linarith
  have hmle : 1 / r ≤ (m:ℝ) := by rw [hm_def]; exact Nat.le_ceil _
  have hm1 : (1:ℝ) ≤ m := le_trans hinv hmle
  have hmr0 : (0:ℝ) < m := by linarith
  have hm : 0 < m := by exact_mod_cast hmr0
  have hmr : 1 / (m:ℝ) ≤ r := by
    rw [div_le_iff₀ hmr0]
    rw [div_le_iff₀ hr] at hmle
    linarith
  have hmlt : (m:ℝ) < 1 / r + 1 := by rw [hm_def]; exact Nat.ceil_lt_add_one (by positivity)
  have hmr2 : (m:ℝ) * (r / 2) ≤ 1 := by
    have h1 : (m:ℝ) * r < 1 + r := by
      have := mul_lt_mul_of_pos_right hmlt hr
      rw [add_mul, one_div, inv_mul_cancel₀ hr.ne'] at this
      linarith
    nlinarith
  
  have hlt : ∀ D : ℕ, D * m < P → (D:ℝ) / P < r := by
    intro D hD
    have h : (D:ℝ) * m < P := by exact_mod_cast hD
    calc (D:ℝ) / P < 1 / m := by
          rw [div_lt_div_iff₀ hPr hmr0]; linarith
      _ ≤ r := hmr
  have key : ∀ a b : ZMod P, a.val * m / P = b.val * m / P → giCircNorm P (a - b) < r := by
    intro a b hab
    have hA := ZMod.val_lt a
    have hB := ZMod.val_lt b
    have h1 := Nat.div_mul_le_self (a.val * m) P
    have h2 := Nat.lt_div_mul_add (a := a.val * m) hP
    have h3 := Nat.div_mul_le_self (b.val * m) P
    have h4 := Nat.lt_div_mul_add (a := b.val * m) hP
    rw [hab] at h1 h2
    have hAB : a.val * m < b.val * m + P ∧ b.val * m < a.val * m + P := by
      generalize b.val * m / P * P = Q at *
      generalize a.val * m = A at *
      generalize b.val * m = B at *
      omega
    rcases le_or_gt b.val a.val with hba | hab'
    · have hv : (a - b).val = a.val - b.val := ZMod.val_sub hba
      have hD : (a.val - b.val) * m < P := by
        rw [Nat.sub_mul]; omega
      unfold giCircNorm
      refine lt_of_le_of_lt (min_le_left _ _) ?_
      rw [hv]; exact hlt _ hD
    · have hv : (b - a).val = b.val - a.val := ZMod.val_sub hab'.le
      have hne : b - a ≠ 0 := by
        intro h; rw [h, ZMod.val_zero] at hv; omega
      have hv2 : (a - b).val = P - (b.val - a.val) := by
        rw [← neg_sub, ZMod.neg_val, if_neg hne, hv]
      have hD : (b.val - a.val) * m < P := by rw [Nat.sub_mul]; omega
      unfold giCircNorm
      refine lt_of_le_of_lt (min_le_right _ _) ?_
      have hle : b.val - a.val ≤ P := by omega
      rw [hv2, Nat.cast_sub hle]
      have e : (1:ℝ) - ((P:ℝ) - ((b.val - a.val : ℕ) : ℝ)) / P
          = ((b.val - a.val : ℕ) : ℝ) / P := by
        field_simp; ring
      rw [e]; exact hlt _ hD
  
  let f : ZMod P → (↥S → Fin m) := fun x ξ =>
    ⟨(ξ.1 * x).val * m / P, by
      apply Nat.div_lt_of_lt_mul
      have := ZMod.val_lt (ξ.1 * x)
      nlinarith⟩
  have hmk : (0:ℝ) < (m:ℝ) ^ S.card := pow_pos hmr0 _
  have hcardβ : Fintype.card (↥S → Fin m) = m ^ S.card := by simp
  haveI : Nonempty (↥S → Fin m) := ⟨fun _ => ⟨0, hm⟩⟩
  obtain ⟨y, hy⟩ := Fintype.exists_le_card_fiber_of_nsmul_le_card f
    (b := (P:ℝ) / (m:ℝ) ^ S.card) (by
      rw [hcardβ, ZMod.card, nsmul_eq_mul]; push_cast
      rw [mul_div_cancel₀ _ hmk.ne'])
  set F := Finset.univ.filter (fun x => f x = y) with hF
  have hbpos : (0:ℝ) < (P:ℝ) / (m:ℝ) ^ S.card := div_pos hPr hmk
  have hFne : F.Nonempty := by
    rw [← Finset.card_pos]
    have : (0:ℝ) < (F.card : ℝ) := lt_of_lt_of_le hbpos hy
    exact_mod_cast this
  obtain ⟨x₀, hx₀⟩ := hFne
  have hfx₀ : f x₀ = y := by simpa [hF] using hx₀
  have hFB : F.card ≤ (giBohr P S r).card := by
    apply Finset.card_le_card_of_injOn (fun x => x - x₀)
    · intro x hx
      have hfx : f x = y := by simpa [hF] using hx
      rw [Finset.mem_coe]
      simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and]
      intro ξ hξ
      have hbin := congrArg Fin.val (congrFun (hfx.trans hfx₀.symm) ⟨ξ, hξ⟩)
      have := key (ξ * x) (ξ * x₀) hbin
      rwa [mul_sub]
    · intro x _ z _ hxz
      exact sub_left_inj.mp hxz
  have hFB' : (F.card : ℝ) ≤ ((giBohr P S r).card : ℝ) := by exact_mod_cast hFB
  have hfin : (r / 2) ^ S.card * (P : ℝ) ≤ (P:ℝ) / (m:ℝ) ^ S.card := by
    rw [le_div_iff₀ hmk]
    have h0 : 0 ≤ (m:ℝ) * (r / 2) := by positivity
    have hpow : ((m:ℝ) * (r / 2)) ^ S.card ≤ 1 := pow_le_one₀ h0 hmr2
    calc (r / 2) ^ S.card * (P:ℝ) * (m:ℝ) ^ S.card
        = ((m:ℝ) * (r / 2)) ^ S.card * P := by rw [mul_pow]; ring
      _ ≤ 1 * P := mul_le_mul_of_nonneg_right hpow hPr.le
      _ = P := one_mul _
  linarith

theorem giBohr_annulus_pigeonhole (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ρ₁ τ : ℝ) (J : ℕ)
    (hρ₁ : 0 < ρ₁) (hτ : 0 < τ) (hJ : 1 ≤ J)
    (hlow : (ρ₁ / 4) ^ S.card * (P : ℝ) ≤ ((giBohr P S (ρ₁ / 2)).card : ℝ))
    (hpow : (4 / ρ₁) ^ S.card ≤ (1 + τ) ^ J) :
    ∃ r₁ r₂ : ℝ, ρ₁ / 2 ≤ r₁ ∧ r₁ < r₂ ∧ r₂ < ρ₁ ∧ ρ₁ / (4 * (J : ℝ)) ≤ r₂ - r₁ ∧
      ((giBohr P S r₂).card : ℝ) ≤ (1 + τ) * ((giBohr P S r₁).card : ℝ) :=
by
  classical
  have hJpos : (0 : ℝ) < (J : ℝ) := by exact_mod_cast hJ
  obtain ⟨h, hh⟩ : ∃ h : ℝ, h = ρ₁ / (4 * (J : ℝ)) := ⟨_, rfl⟩
  have hhpos : 0 < h := by rw [hh]; positivity
  have hJh : (J : ℝ) * h = ρ₁ / 4 := by
    rw [hh]; field_simp
  obtain ⟨r, hr⟩ : ∃ r : ℕ → ℝ, ∀ i, r i = ρ₁ / 2 + (i : ℝ) * h := ⟨_, fun _ => rfl⟩
  have hub : ∀ s : ℝ, ((giBohr P S s).card : ℝ) ≤ (P : ℝ) := by
    intro s
    have h1 := Finset.card_le_univ (giBohr P S s)
    rw [ZMod.card] at h1
    exact_mod_cast h1
  by_contra hcon
  push_neg at hcon
  rw [← hh] at hcon
  have step : ∀ i : ℕ, i < J →
      (1 + τ) * ((giBohr P S (r i)).card : ℝ) < ((giBohr P S (r (i + 1))).card : ℝ) := by
    intro i hi
    have hi1 : ((i + 1 : ℕ) : ℝ) ≤ (J : ℝ) := by exact_mod_cast hi
    have hi0 : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    have hri : r i = ρ₁ / 2 + (i : ℝ) * h := hr i
    have hri1 : r (i + 1) = ρ₁ / 2 + (i : ℝ) * h + h := by
      rw [hr (i + 1)]; push_cast; ring
    have hle : ((i + 1 : ℕ) : ℝ) * h ≤ (J : ℝ) * h :=
      mul_le_mul_of_nonneg_right hi1 hhpos.le
    push_cast at hle
    have hih : 0 ≤ (i : ℝ) * h := mul_nonneg hi0 hhpos.le
    apply hcon
    · rw [hri]; linarith
    · rw [hri, hri1]; linarith
    · rw [hri1]; nlinarith
    · rw [hri, hri1]; linarith
  have tele : ∀ k : ℕ, k ≤ J →
      (1 + τ) ^ k * ((giBohr P S (r 0)).card : ℝ) ≤ ((giBohr P S (r k)).card : ℝ) := by
    intro k
    induction k with
    | zero => intro _; simp
    | succ k ih =>
      intro hk
      have ih' := ih (by omega)
      have hs := step k (by omega)
      have h1τ : (0 : ℝ) ≤ 1 + τ := by linarith
      calc (1 + τ) ^ (k + 1) * ((giBohr P S (r 0)).card : ℝ)
          = (1 + τ) * ((1 + τ) ^ k * ((giBohr P S (r 0)).card : ℝ)) := by ring
        _ ≤ (1 + τ) * ((giBohr P S (r k)).card : ℝ) := mul_le_mul_of_nonneg_left ih' h1τ
        _ ≤ ((giBohr P S (r (k + 1))).card : ℝ) := hs.le
  obtain ⟨m, hm⟩ : ∃ m : ℕ, m + 1 = J := ⟨J - 1, by omega⟩
  have h1τ : (0 : ℝ) ≤ 1 + τ := by linarith
  have hstrict : (1 + τ) ^ J * ((giBohr P S (r 0)).card : ℝ) < ((giBohr P S (r J)).card : ℝ) := by
    have ih' := tele m (by omega)
    have hs := step m (by omega)
    rw [hm] at hs
    calc (1 + τ) ^ J * ((giBohr P S (r 0)).card : ℝ)
        = (1 + τ) * ((1 + τ) ^ m * ((giBohr P S (r 0)).card : ℝ)) := by rw [← hm]; ring
      _ ≤ (1 + τ) * ((giBohr P S (r m)).card : ℝ) := mul_le_mul_of_nonneg_left ih' h1τ
      _ < ((giBohr P S (r J)).card : ℝ) := hs
  have hr0 : r 0 = ρ₁ / 2 := by rw [hr 0]; simp
  rw [hr0] at hstrict
  have hid : (4 / ρ₁) ^ S.card * ((ρ₁ / 4) ^ S.card * (P : ℝ)) = (P : ℝ) := by
    rw [← mul_assoc, ← mul_pow]
    have : 4 / ρ₁ * (ρ₁ / 4) = 1 := by field_simp
    rw [this, one_pow, one_mul]
  have hlowP : (P : ℝ) ≤ (1 + τ) ^ J * ((giBohr P S (ρ₁ / 2)).card : ℝ) := by
    rw [← hid]
    exact mul_le_mul hpow hlow (by positivity) (by positivity)
  have := hub (r J)
  linarith

theorem int_lattice_reduced_basis {ι : Type} [Fintype ι] (r : ℕ) (Γ : AddSubgroup (ι → ℝ))
    (hint : ∀ y ∈ Γ, ∀ i, ∃ m : ℤ, y i = (m : ℝ))
    (hr : Module.finrank ℝ (Submodule.span ℝ (Γ : Set (ι → ℝ))) ≤ r) :
    ∃ (k : ℕ) (w : Fin k → ι → ℝ), k ≤ r ∧ (∀ j, w j ∈ Γ) ∧ LinearIndependent ℝ w ∧
      (∀ y ∈ Γ, ∃ l : Fin k → ℤ, y = ∑ j, (l j : ℝ) • w j) ∧
      (∀ (t : Fin k → ℝ) (j : Fin k),
        |t j| * Real.sqrt (∑ i, (w j i) ^ 2)
          ≤ (2 ^ k * (k.factorial : ℝ)) * Real.sqrt (∑ i, (∑ j', t j' * w j' i) ^ 2)) :=
by
  classical
  
  have hE : ∀ v : ι → ℝ, ‖(WithLp.toLp 2 v : EuclideanSpace ℝ ι)‖ = Real.sqrt (∑ i, (v i) ^ 2) := by
    intro v
    rw [EuclideanSpace.norm_eq]
    simp [Real.norm_eq_abs, sq_abs]
  
  have hid0 : ∀ w y : ι → ℝ, ∑ i, ((∑ i', (w i') ^ 2) * y i - (∑ i', y i' * w i') * w i) ^ 2
      = (∑ i', (w i') ^ 2) * ((∑ i', (w i') ^ 2) * ∑ i, (y i) ^ 2 - (∑ i', y i' * w i') ^ 2) := by
    intro w y
    have key : ∀ i, ((∑ i', (w i') ^ 2) * y i - (∑ i', y i' * w i') * w i) ^ 2
        = (∑ i', (w i') ^ 2) ^ 2 * (y i) ^ 2
          - 2 * (∑ i', (w i') ^ 2) * (∑ i', y i' * w i') * (y i * w i)
          + (∑ i', y i' * w i') ^ 2 * (w i) ^ 2 := fun i => by ring
    rw [Finset.sum_congr rfl (fun i _ => key i), Finset.sum_add_distrib, Finset.sum_sub_distrib,
      ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
    ring
  
  have triv : ∀ (Γ₀ : AddSubgroup (ι → ℝ)) (r₀ : ℕ), (∀ y ∈ Γ₀, y = 0) →
      ∃ (k : ℕ) (w : Fin k → ι → ℝ), k ≤ r₀ ∧ (∀ j, w j ∈ Γ₀) ∧ LinearIndependent ℝ w ∧
      (∀ y ∈ Γ₀, ∃ l : Fin k → ℤ, y = ∑ j, (l j : ℝ) • w j) ∧
      (∀ (t : Fin k → ℝ) (j : Fin k),
        |t j| * Real.sqrt (∑ i, (w j i) ^ 2)
          ≤ (2 ^ k * (k.factorial : ℝ)) * Real.sqrt (∑ i, (∑ j', t j' * w j' i) ^ 2)) := by
    intro Γ₀ r₀ h0
    refine ⟨0, fun j => Fin.elim0 j, Nat.zero_le _, fun j => Fin.elim0 j,
      linearIndependent_empty_type, fun y hy => ⟨fun j => Fin.elim0 j, ?_⟩, fun t j => Fin.elim0 j⟩
    rw [h0 y hy]; simp
  induction r generalizing Γ with
  | zero =>
    apply triv
    intro y hy
    have h0 : Submodule.span ℝ (Γ : Set (ι → ℝ)) = ⊥ := Submodule.finrank_eq_zero.mp (by omega)
    have hy' : y ∈ Submodule.span ℝ (Γ : Set (ι → ℝ)) := Submodule.subset_span hy
    rw [h0] at hy'
    exact (Submodule.mem_bot ℝ).mp hy'
  | succ r' ih =>
    by_cases hne : ∃ y ∈ Γ, y ≠ 0
    swap
    · push_neg at hne; exact triv Γ _ hne
    
    have hnat : ∀ y ∈ Γ, ∃ N : ℕ, ∑ i, (y i) ^ 2 = (N : ℝ) := by
      intro y hy
      choose m hm using hint y hy
      refine ⟨∑ i, (m i).natAbs ^ 2, ?_⟩
      push_cast
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hm i]; simp [sq_abs]
    have hex : ∃ N : ℕ, ∃ y ∈ Γ, y ≠ 0 ∧ ∑ i, (y i) ^ 2 = (N : ℝ) := by
      obtain ⟨y, hy, hy0⟩ := hne
      obtain ⟨N, hN⟩ := hnat y hy
      exact ⟨N, y, hy, hy0, hN⟩
    obtain ⟨w₁, hw₁, hw₁0, hqw⟩ := Nat.find_spec hex
    have hmin : ∀ y ∈ Γ, y ≠ 0 → ((Nat.find hex : ℕ) : ℝ) ≤ ∑ i, (y i) ^ 2 := by
      intro y hy hy0
      obtain ⟨N, hN⟩ := hnat y hy
      rw [hN]; exact_mod_cast Nat.find_min' hex ⟨y, hy, hy0, hN⟩
    obtain ⟨q, hq_def⟩ : ∃ q : ℝ, q = ((Nat.find hex : ℕ) : ℝ) := ⟨_, rfl⟩
    rw [← hq_def] at hqw hmin
    have hq : 0 < q := by
      rcases (Finset.sum_nonneg (fun i _ => sq_nonneg (w₁ i)) :
          (0 : ℝ) ≤ ∑ i, (w₁ i) ^ 2).lt_or_eq with h | h
      · rwa [hqw] at h
      · exfalso; apply hw₁0; funext i
        have h' := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => sq_nonneg (w₁ i))).mp h.symm i
          (Finset.mem_univ i)
        simpa using h'
    
    let T : (ι → ℝ) →ₗ[ℝ] (ι → ℝ) :=
      { toFun := fun y i => q * y i - (∑ i', y i' * w₁ i') * w₁ i
        map_add' := by
          intro a b; funext i
          simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]; ring
        map_smul' := by
          intro c a; funext i
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc, ← Finset.mul_sum]
          ring }
    have hT : ∀ y, T y = fun i => q * y i - (∑ i', y i' * w₁ i') * w₁ i := fun y => rfl
    have hww : ∑ i', w₁ i' * w₁ i' = q := by
      rw [← hqw]; exact Finset.sum_congr rfl (fun i _ => (sq (w₁ i)).symm)
    have hTw : T w₁ = 0 := by
      rw [hT, hww]; funext i; simp only [Pi.zero_apply]; ring
    have hid : ∀ y, ∑ i, (T y i) ^ 2 = q * (q * ∑ i, (y i) ^ 2 - (∑ i', y i' * w₁ i') ^ 2) := by
      intro y; have h := hid0 w₁ y; rw [hqw] at h; rw [hT]; exact h
    have hTnorm : ∀ y, ∑ i, (T y i) ^ 2 ≤ q ^ 2 * ∑ i, (y i) ^ 2 := by
      intro y; rw [hid y]; nlinarith [mul_nonneg hq.le (sq_nonneg (∑ i', y i' * w₁ i'))]
    let Γ' : AddSubgroup (ι → ℝ) := Γ.map T.toAddMonoidHom
    have hΓ' : ∀ z, z ∈ Γ' ↔ ∃ y ∈ Γ, T y = z := by
      intro z; simp only [Γ', AddSubgroup.mem_map]; exact Iff.rfl
    have hint' : ∀ z ∈ Γ', ∀ i, ∃ m : ℤ, z i = (m : ℝ) := by
      intro z hz i
      obtain ⟨y, hy, rfl⟩ := (hΓ' z).1 hz
      choose my hmy using hint y hy
      choose mw hmw using hint w₁ hw₁
      refine ⟨(Nat.find hex : ℤ) * my i - (∑ i', my i' * mw i') * mw i, ?_⟩
      have hs : ∑ i', y i' * w₁ i' = ((∑ i', my i' * mw i' : ℤ) : ℝ) := by
        push_cast; exact Finset.sum_congr rfl (fun i' _ => by rw [hmy i', hmw i'])
      rw [hT]; simp only
      rw [hs, hmy i, hmw i, hq_def]; push_cast; ring
    
    have hr' : Module.finrank ℝ (Submodule.span ℝ (Γ' : Set (ι → ℝ))) ≤ r' := by
      have h1 : (Γ' : Set (ι → ℝ)) = T '' (Γ : Set (ι → ℝ)) := by
        ext z; simp only [SetLike.mem_coe, Set.mem_image]; exact hΓ' z
      have h2 : Submodule.span ℝ (Γ' : Set (ι → ℝ))
          = LinearMap.range (T.domRestrict (Submodule.span ℝ (Γ : Set (ι → ℝ)))) := by
        rw [h1, Submodule.span_image, LinearMap.range_domRestrict]
      have h3 := LinearMap.finrank_range_add_finrank_ker
        (T.domRestrict (Submodule.span ℝ (Γ : Set (ι → ℝ))))
      have h4 : 1 ≤ Module.finrank ℝ
          (LinearMap.ker (T.domRestrict (Submodule.span ℝ (Γ : Set (ι → ℝ))))) := by
        rw [Submodule.one_le_finrank_iff, Submodule.ne_bot_iff]
        refine ⟨⟨w₁, Submodule.subset_span hw₁⟩, ?_, ?_⟩
        · rw [LinearMap.mem_ker, LinearMap.domRestrict_apply]; exact hTw
        · intro h; apply hw₁0; exact congrArg Subtype.val h
      rw [h2]; omega
    
    obtain ⟨k', z, hk', hzΓ', hzli, hzgen, hzbd⟩ := ih Γ' hint' hr'
    
    have hz : ∀ j, ∃ y ∈ Γ, T y = z j := fun j => (hΓ' _).1 (hzΓ' j)
    choose y hyΓ hTy using hz
    obtain ⟨s, hs_def⟩ : ∃ s : Fin k' → ℤ,
        s = fun j => round ((∑ i', y j i' * w₁ i') / q) := ⟨_, rfl⟩
    obtain ⟨y', hy'_def⟩ : ∃ y' : Fin k' → ι → ℝ,
        y' = fun j => y j - ((s j : ℤ) : ℝ) • w₁ := ⟨_, rfl⟩
    have hsmulΓ : ∀ (m : ℤ) (v : ι → ℝ), v ∈ Γ → ((m : ℝ)) • v ∈ Γ := by
      intro m v hv; rw [Int.cast_smul_eq_zsmul]; exact AddSubgroup.zsmul_mem _ hv _
    have hy'Γ : ∀ j, y' j ∈ Γ := by
      intro j; rw [hy'_def]; exact sub_mem (hyΓ j) (hsmulΓ _ _ hw₁)
    have hTy' : ∀ j, T (y' j) = z j := by
      intro j; rw [hy'_def]; simp only
      rw [map_sub, map_smul, hTw, smul_zero, sub_zero, hTy j]
    have hp : ∀ j, |∑ i', y' j i' * w₁ i'| ≤ q / 2 := by
      intro j
      have hsj : s j = round ((∑ i', y j i' * w₁ i') / q) := by rw [hs_def]
      have e1 : ∑ i', y' j i' * w₁ i' = q * ((∑ i', y j i' * w₁ i') / q - (s j : ℝ)) := by
        rw [hy'_def]
        simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, sub_mul, Finset.sum_sub_distrib,
          mul_assoc, ← Finset.mul_sum, hww]
        field_simp
      rw [e1, abs_mul, abs_of_pos hq, hsj]
      calc q * |(∑ i', y j i' * w₁ i') / q - ((round ((∑ i', y j i' * w₁ i') / q) : ℤ) : ℝ)|
          ≤ q * (1 / 2) := mul_le_mul_of_nonneg_left (abs_sub_round _) hq.le
        _ = q / 2 := by ring
    have hy'0 : ∀ j, y' j ≠ 0 := by
      intro j h
      apply hzli.ne_zero j
      rw [← hTy' j, h, map_zero]
    have hNy' : ∀ j, q ≤ ∑ i, (y' j i) ^ 2 := fun j => hmin _ (hy'Γ j) (hy'0 j)
    have hzlow : ∀ j, q ^ 2 * ∑ i, (y' j i) ^ 2 ≤ 4 * ∑ i, (z j i) ^ 2 := by
      intro j
      have h1 := hid (y' j)
      rw [hTy' j] at h1
      have hp2 : (∑ i', y' j i' * w₁ i') ^ 2 ≤ (q / 2) ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) (hp j) 2
      rw [h1]
      nlinarith [mul_le_mul_of_nonneg_left hp2 hq.le,
        mul_le_mul_of_nonneg_left (hNy' j) (sq_nonneg q),
        mul_nonneg (sq_nonneg q) (le_trans hq.le (hNy' j))]
    
    have hli : LinearIndependent ℝ (Fin.cons w₁ y' : Fin (k' + 1) → ι → ℝ) := by
      rw [linearIndependent_fin_cons]
      constructor
      · apply LinearIndependent.of_comp T
        have : T ∘ y' = z := funext hTy'
        rw [this]; exact hzli
      · intro hmem
        rw [Submodule.mem_span_range_iff_exists_fun] at hmem
        obtain ⟨c, hc⟩ := hmem
        have h1 : ∑ j, c j • z j = 0 := by
          rw [← hTw, ← hc, map_sum]
          exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, hTy'])
        have h2 := Fintype.linearIndependent_iff.mp hzli c h1
        apply hw₁0
        rw [← hc]; simp [h2]
    have hgen : ∀ v ∈ Γ, ∃ l : Fin (k' + 1) → ℤ,
        v = ∑ j, (l j : ℝ) • (Fin.cons w₁ y' : Fin (k' + 1) → ι → ℝ) j := by
      intro v hv
      obtain ⟨l', hl'⟩ := hzgen (T v) ((hΓ' _).2 ⟨v, hv, rfl⟩)
      obtain ⟨v₂, hv₂_def⟩ : ∃ v₂ : ι → ℝ, v₂ = v - ∑ j, (l' j : ℝ) • y' j := ⟨_, rfl⟩
      have hv₂Γ : v₂ ∈ Γ := by
        rw [hv₂_def]
        exact sub_mem hv (AddSubgroup.sum_mem _ (fun j _ => hsmulΓ _ _ (hy'Γ j)))
      have hTv₂ : T v₂ = 0 := by
        rw [hv₂_def, map_sub, map_sum, hl', sub_eq_zero]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, hTy'])
      obtain ⟨τ, hτ⟩ : ∃ τ : ℝ, τ = (∑ i', v₂ i' * w₁ i') / q := ⟨_, rfl⟩
      have hv₂eq : v₂ = τ • w₁ := by
        funext i
        have := congrFun hTv₂ i
        rw [hT] at this
        simp only [Pi.zero_apply] at this
        rw [Pi.smul_apply, smul_eq_mul, hτ]
        field_simp
        linarith
      obtain ⟨s₀, hs₀⟩ : ∃ s₀ : ℤ, s₀ = round τ := ⟨_, rfl⟩
      have hv₃Γ : (τ - (s₀ : ℝ)) • w₁ ∈ Γ := by
        rw [sub_smul, ← hv₂eq]; exact sub_mem hv₂Γ (hsmulΓ _ _ hw₁)
      have hv₃ : (τ - (s₀ : ℝ)) • w₁ = 0 := by
        by_contra hne3
        have h1 := hmin _ hv₃Γ hne3
        have h2 : ∑ i, (((τ - (s₀ : ℝ)) • w₁) i) ^ 2 = (τ - (s₀ : ℝ)) ^ 2 * q := by
          rw [← hqw, Finset.mul_sum]
          exact Finset.sum_congr rfl (fun i _ => by rw [Pi.smul_apply, smul_eq_mul, mul_pow])
        have h3 : (τ - (s₀ : ℝ)) ^ 2 ≤ (1 / 2) ^ 2 := by
          rw [← sq_abs]
          exact pow_le_pow_left₀ (abs_nonneg _) (by rw [hs₀]; exact abs_sub_round τ) 2
        rw [h2] at h1
        nlinarith [mul_le_mul_of_nonneg_right h3 hq.le]
      refine ⟨(Fin.cons s₀ l' : Fin (k' + 1) → ℤ), ?_⟩
      rw [Fin.sum_univ_succ]
      simp only [Fin.cons_zero, Fin.cons_succ]
      have hv : v = v₂ + ∑ j, (l' j : ℝ) • y' j := by rw [hv₂_def]; abel
      have h4 : τ • w₁ = (s₀ : ℝ) • w₁ := by
        have := hv₃; rw [sub_smul, sub_eq_zero] at this; exact this
      rw [hv, hv₂eq, h4]
    
    set M' : ℝ := 2 ^ k' * (k'.factorial : ℝ) with hM'_def
    have hM'1 : 1 ≤ M' :=
      one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num))
        (by exact_mod_cast Nat.factorial_pos k')
    have hTn : ∀ v, Real.sqrt (∑ i, (T v i) ^ 2) ≤ q * Real.sqrt (∑ i, (v i) ^ 2) := by
      intro v
      calc Real.sqrt (∑ i, (T v i) ^ 2) ≤ Real.sqrt (q ^ 2 * ∑ i, (v i) ^ 2) :=
            Real.sqrt_le_sqrt (hTnorm v)
        _ = q * Real.sqrt (∑ i, (v i) ^ 2) := by
            rw [Real.sqrt_mul (sq_nonneg q), Real.sqrt_sq hq.le]
    have hyz : ∀ j, q * Real.sqrt (∑ i, (y' j i) ^ 2) ≤ 2 * Real.sqrt (∑ i, (z j i) ^ 2) := by
      intro j
      calc q * Real.sqrt (∑ i, (y' j i) ^ 2) = Real.sqrt (q ^ 2 * ∑ i, (y' j i) ^ 2) := by
            rw [Real.sqrt_mul (sq_nonneg q), Real.sqrt_sq hq.le]
        _ ≤ Real.sqrt (2 ^ 2 * ∑ i, (z j i) ^ 2) := Real.sqrt_le_sqrt (by linarith [hzlow j])
        _ = 2 * Real.sqrt (∑ i, (z j i) ^ 2) := by
            rw [Real.sqrt_mul (sq_nonneg 2), Real.sqrt_sq (by norm_num)]
    have hbound : ∀ (t : Fin (k' + 1) → ℝ) (j : Fin (k' + 1)),
        |t j| * Real.sqrt (∑ i, ((Fin.cons w₁ y' : Fin (k' + 1) → ι → ℝ) j i) ^ 2)
          ≤ (2 * ((k' : ℝ) + 1) * M') *
            Real.sqrt (∑ i, (∑ j', t j' * (Fin.cons w₁ y' : Fin (k' + 1) → ι → ℝ) j' i) ^ 2) := by
      intro t j
      obtain ⟨Y, hY_def⟩ : ∃ Y : ι → ℝ,
          Y = fun i => ∑ j', t j' * (Fin.cons w₁ y' : Fin (k' + 1) → ι → ℝ) j' i := ⟨_, rfl⟩
      have hYi : ∀ i, (∑ j', t j' * (Fin.cons w₁ y' : Fin (k' + 1) → ι → ℝ) j' i) = Y i := by
        intro i; rw [hY_def]
      have hYeq : Y = t 0 • w₁ + ∑ j, t j.succ • y' j := by
        funext i; rw [← hYi i]; simp [Fin.sum_univ_succ, Finset.sum_apply]
      have hTY : T Y = ∑ j, t j.succ • z j := by
        rw [hYeq, map_add, map_smul, hTw, smul_zero, zero_add, map_sum]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, hTy'])
      have hTYi : ∀ i, ∑ j', t j'.succ * z j' i = T Y i := by
        intro i; rw [hTY]; simp [Finset.sum_apply]
      have hYn := Real.sqrt_nonneg (∑ i, (Y i) ^ 2)
      have hsucc : ∀ j₀ : Fin k', |t j₀.succ| * Real.sqrt (∑ i, (y' j₀ i) ^ 2)
          ≤ 2 * M' * Real.sqrt (∑ i, (Y i) ^ 2) := by
        intro j₀
        have h1 := hzbd (fun j => t j.succ) j₀
        simp only [hTYi] at h1
        have hu := abs_nonneg (t j₀.succ)
        have h2 : q * (|t j₀.succ| * Real.sqrt (∑ i, (y' j₀ i) ^ 2))
            ≤ q * (2 * M' * Real.sqrt (∑ i, (Y i) ^ 2)) := by
          calc q * (|t j₀.succ| * Real.sqrt (∑ i, (y' j₀ i) ^ 2))
              = |t j₀.succ| * (q * Real.sqrt (∑ i, (y' j₀ i) ^ 2)) := by ring
            _ ≤ |t j₀.succ| * (2 * Real.sqrt (∑ i, (z j₀ i) ^ 2)) :=
                mul_le_mul_of_nonneg_left (hyz j₀) hu
            _ = 2 * (|t j₀.succ| * Real.sqrt (∑ i, (z j₀ i) ^ 2)) := by ring
            _ ≤ 2 * (M' * Real.sqrt (∑ i, (T Y i) ^ 2)) := by linarith
            _ ≤ 2 * (M' * (q * Real.sqrt (∑ i, (Y i) ^ 2))) := by
                have := mul_le_mul_of_nonneg_left (hTn Y) (by linarith : (0 : ℝ) ≤ M')
                linarith
            _ = q * (2 * M' * Real.sqrt (∑ i, (Y i) ^ 2)) := by ring
        exact le_of_mul_le_mul_left h2 hq
      have hzero : |t 0| * Real.sqrt (∑ i, (w₁ i) ^ 2)
          ≤ (1 + (k' : ℝ) * (2 * M')) * Real.sqrt (∑ i, (Y i) ^ 2) := by
        have e0 : t 0 • w₁ = Y - ∑ j, t j.succ • y' j := by rw [hYeq]; abel
        have e1 : (WithLp.toLp 2 (t 0 • w₁) : EuclideanSpace ℝ ι)
            = WithLp.toLp 2 Y - ∑ j, t j.succ • (WithLp.toLp 2 (y' j) : EuclideanSpace ℝ ι) := by
          rw [e0, WithLp.toLp_sub, WithLp.toLp_sum]
          simp [WithLp.toLp_smul]
        have key : |t 0| * ‖(WithLp.toLp 2 w₁ : EuclideanSpace ℝ ι)‖
            ≤ ‖(WithLp.toLp 2 Y : EuclideanSpace ℝ ι)‖
              + ∑ j, |t j.succ| * ‖(WithLp.toLp 2 (y' j) : EuclideanSpace ℝ ι)‖ := by
          calc |t 0| * ‖(WithLp.toLp 2 w₁ : EuclideanSpace ℝ ι)‖
              = ‖(WithLp.toLp 2 (t 0 • w₁) : EuclideanSpace ℝ ι)‖ := by
                rw [WithLp.toLp_smul, norm_smul, Real.norm_eq_abs]
            _ = ‖(WithLp.toLp 2 Y : EuclideanSpace ℝ ι)
                  - ∑ j, t j.succ • (WithLp.toLp 2 (y' j) : EuclideanSpace ℝ ι)‖ := by rw [e1]
            _ ≤ ‖(WithLp.toLp 2 Y : EuclideanSpace ℝ ι)‖
                  + ‖∑ j, t j.succ • (WithLp.toLp 2 (y' j) : EuclideanSpace ℝ ι)‖ :=
                norm_sub_le _ _
            _ ≤ ‖(WithLp.toLp 2 Y : EuclideanSpace ℝ ι)‖
                  + ∑ j, |t j.succ| * ‖(WithLp.toLp 2 (y' j) : EuclideanSpace ℝ ι)‖ := by
                refine (add_le_add_iff_left _).mpr ?_
                refine (norm_sum_le _ _).trans (le_of_eq ?_)
                refine Finset.sum_congr rfl (fun j _ => ?_)
                rw [norm_smul, Real.norm_eq_abs]
        simp only [hE] at key
        calc |t 0| * Real.sqrt (∑ i, (w₁ i) ^ 2)
            ≤ Real.sqrt (∑ i, (Y i) ^ 2) + ∑ j, |t j.succ| * Real.sqrt (∑ i, (y' j i) ^ 2) := key
          _ ≤ Real.sqrt (∑ i, (Y i) ^ 2) + ∑ j : Fin k', 2 * M' * Real.sqrt (∑ i, (Y i) ^ 2) :=
              (add_le_add_iff_left _).mpr (Finset.sum_le_sum (fun j _ => hsucc j))
          _ = (1 + (k' : ℝ) * (2 * M')) * Real.sqrt (∑ i, (Y i) ^ 2) := by
              rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
      have hk0 : (0 : ℝ) ≤ k' := Nat.cast_nonneg k'
      have hC1 : 2 * M' ≤ 2 * ((k' : ℝ) + 1) * M' := by nlinarith
      have hC0 : 1 + (k' : ℝ) * (2 * M') ≤ 2 * ((k' : ℝ) + 1) * M' := by nlinarith
      simp only [hYi]
      refine Fin.cases ?_ (fun j₀ => ?_) j
      · simp only [Fin.cons_zero]
        exact hzero.trans (mul_le_mul_of_nonneg_right hC0 hYn)
      · simp only [Fin.cons_succ]
        exact (hsucc j₀).trans (mul_le_mul_of_nonneg_right hC1 hYn)
    
    refine ⟨k' + 1, (Fin.cons w₁ y' : Fin (k' + 1) → ι → ℝ), by omega, ?_, hli, hgen, ?_⟩
    · intro j
      refine Fin.cases ?_ (fun j₀ => ?_) j
      · simpa using hw₁
      · simpa using hy'Γ j₀
    · have hC : (2 : ℝ) ^ (k' + 1) * ((k' + 1).factorial : ℝ) = 2 * ((k' : ℝ) + 1) * M' := by
        rw [hM'_def, Nat.factorial_succ]; push_cast; ring
      rw [hC]; exact hbound

theorem zmod_bohr_gap (P : ℕ) [NeZero P] (hP : P.Prime) (S : Finset (ZMod P)) (ρ₀ : ℝ)
    (h0 : 0 < ρ₀) (h1 : ρ₀ ≤ 1 / 4) (hS : ∃ ξ ∈ S, ξ ≠ 0) :
    ∃ (k : ℕ) (v : Fin k → ZMod P) (L : Fin k → ℕ) (u : Fin k → ZMod P → ℝ),
      (∀ i j, ∑ ξ ∈ S, u i ξ * giBrZ P (ξ * v j) = if i = j then 1 else 0) ∧
      (∀ l : Fin k → ℤ, (∀ i, |l i| < (L i : ℤ)) → ∀ ξ ∈ S,
        |∑ i, (l i : ℝ) * giBrZ P (ξ * v i)| < ρ₀) ∧
      (∀ x ∈ giBohr P S (ρ₀ / (4 * ((S.card : ℝ) + 1)) ^ (4 * (S.card + 1) ^ 2)),
        ∃ l : Fin k → ℤ, (∀ i, |l i| < (L i : ℤ)) ∧ x = ∑ i, (l i : ZMod P) * v i) :=
by
  classical
  obtain ⟨ξ₀, hξ₀S, hξ₀⟩ := hS
  haveI : Fact P.Prime := ⟨hP⟩
  have hP0 : (P : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne P
  have hPpos : (0 : ℝ) < P := by
    have := Nat.pos_of_ne_zero (NeZero.ne P); exact_mod_cast this
  
  have hconst : ∀ (n k : ℕ), 1 ≤ n → k ≤ n →
      2 * (n : ℝ) * n * (2 ^ k * (k.factorial : ℝ)) ≤ (4 * ((n : ℝ) + 1)) ^ (4 * (n + 1) ^ 2) := by
    intro n k hn hk
    have hB2 : 2 ≤ 4 * (n + 1) := by omega
    have hnB : n ≤ 4 * (n + 1) := by omega
    have h2k : 2 ^ k ≤ (4 * (n + 1)) ^ n :=
      (Nat.pow_le_pow_right (by norm_num) hk).trans (Nat.pow_le_pow_left hB2 n)
    have hkf : k.factorial ≤ (4 * (n + 1)) ^ n :=
      (Nat.factorial_le hk).trans ((Nat.factorial_le_pow n).trans (Nat.pow_le_pow_left hnB n))
    have hmain : 2 * n * n * (2 ^ k * k.factorial) ≤ (4 * (n + 1)) ^ (4 * (n + 1) ^ 2) := by
      calc 2 * n * n * (2 ^ k * k.factorial)
          ≤ (4 * (n + 1)) * (4 * (n + 1)) * (4 * (n + 1)) *
              ((4 * (n + 1)) ^ n * (4 * (n + 1)) ^ n) := by
            gcongr
        _ = (4 * (n + 1)) ^ (2 * n + 3) := by ring
        _ ≤ (4 * (n + 1)) ^ (4 * (n + 1) ^ 2) :=
            Nat.pow_le_pow_right (by omega) (by nlinarith)
    exact_mod_cast hmain
  
  have hdualex : ∀ (k : ℕ) (W : Fin k → S → ℝ), LinearIndependent ℝ W →
      ∃ u : Fin k → S → ℝ, ∀ i j, ∑ ξ, u i ξ * W j ξ = if i = j then 1 else 0 := by
    intro k W hW
    let b := Module.Basis.span hW
    have hg : ∀ i, ∃ g : (S → ℝ) →ₗ[ℝ] ℝ,
        g ∘ₗ (Submodule.span ℝ (Set.range W)).subtype = b.coord i :=
      fun i => LinearMap.exists_extend (b.coord i)
    choose g hg using hg
    refine ⟨fun i ξ => g i (fun ξ' => if ξ = ξ' then 1 else 0), fun i j => ?_⟩
    have h1 : g i (W j) = ∑ ξ, (fun ξ => g i (fun ξ' => if ξ = ξ' then 1 else 0)) ξ * W j ξ := by
      rw [LinearMap.pi_apply_eq_sum_univ (g i) (W j)]
      refine Finset.sum_congr rfl (fun ξ _ => ?_)
      rw [smul_eq_mul, mul_comm]
    have h2 : g i (W j) = b.coord i (b j) := by
      rw [← hg i]
      simp [b, Module.Basis.span_apply]
    rw [← h1, h2, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
    by_cases h : i = j
    · subst h; simp
    · rw [if_neg (Ne.symm h), if_neg h]
  
  obtain ⟨hA1, hA2, hA3⟩ : (∀ x ξ : ZMod P, ∃ m : ℤ,
        (P : ℝ) * giBrZ P (ξ * x) = (x.val : ℝ) * (ξ.val : ℝ) + (P : ℝ) * (m : ℝ)) ∧
      (∀ (a m : ℤ) (ξ : ZMod P), -(1 / 2 : ℝ) ≤ (a : ℝ) * (ξ.val : ℝ) / P + m →
        (a : ℝ) * (ξ.val : ℝ) / P + m < 1 / 2 →
        giBrZ P (ξ * (a : ZMod P)) = (a : ℝ) * (ξ.val : ℝ) / P + m) ∧
      (∀ (ξ₀ x : ZMod P) (b m : ℤ), ξ₀ ≠ 0 →
        (x.val : ℝ) * (ξ₀.val : ℝ) = (b : ℝ) * (ξ₀.val : ℝ) + (P : ℝ) * (m : ℝ) →
        x = (b : ZMod P)) := by
    refine ⟨?_, ?_, ?_⟩
    · intro x ξ
      obtain ⟨Q, hQ⟩ : ∃ Q : ℕ, Q = ξ.val * x.val / P := ⟨_, rfl⟩
      refine ⟨-((Q : ℤ) + round (((ξ * x).val : ℝ) / P)), ?_⟩
      have hv : (ξ * x).val = (ξ.val * x.val) % P := ZMod.val_mul ξ x
      have hd := Nat.mod_add_div (ξ.val * x.val) P
      rw [← hv, ← hQ] at hd
      have hd' : ((ξ * x).val : ℝ) + (P : ℝ) * (Q : ℝ)
          = (ξ.val : ℝ) * (x.val : ℝ) := by exact_mod_cast hd
      unfold giBrZ giBr
      push_cast
      field_simp
      linarith
    · intro a m ξ hlo hhi
      have hcast : ξ * (a : ZMod P) = (((ξ.val : ℤ) * a : ℤ) : ZMod P) := by
        push_cast; rw [ZMod.natCast_zmod_val]
      have hv : (((ξ * (a : ZMod P)).val : ℕ) : ℤ) = ((ξ.val : ℤ) * a) % P := by
        rw [hcast, ZMod.val_intCast]
      have hd := Int.emod_add_mul_ediv ((ξ.val : ℤ) * a) P
      rw [← hv] at hd
      set E := ((ξ.val : ℤ) * a) / P
      have hd' : (((ξ * (a : ZMod P)).val : ℕ) : ℝ) + (P : ℝ) * (E : ℝ)
          = (ξ.val : ℝ) * (a : ℝ) := by exact_mod_cast hd
      set t := (a : ℝ) * (ξ.val : ℝ) / P + m with ht
      have hval : ((ξ * (a : ZMod P)).val : ℝ) / P = t - ((m + E : ℤ) : ℝ) := by
        rw [ht]; push_cast; field_simp; linarith
      have hr0 : round t = 0 := round_eq_zero_iff.mpr ⟨hlo, hhi⟩
      unfold giBrZ giBr
      rw [hval, round_sub_intCast, hr0]
      push_cast; ring
    · intro ξ₀ x b m hξ₀ h
      have hz : ((x.val : ℤ) * (ξ₀.val : ℤ)) = b * (ξ₀.val : ℤ) + (P : ℤ) * m := by
        exact_mod_cast h
      have hz' := congrArg (fun z : ℤ => (z : ZMod P)) hz
      simp only [Int.cast_mul, Int.cast_add, Int.cast_natCast, ZMod.natCast_zmod_val,
        ZMod.natCast_self, zero_mul, add_zero] at hz'
      exact mul_right_cancel₀ hξ₀ hz'
  have hcirc : ∀ k : ZMod P, giCircNorm P k = |giBrZ P k| := by
    intro k
    have hk0 : (0 : ℝ) ≤ (k.val : ℝ) / P := by positivity
    have hk1 : (k.val : ℝ) / P < 1 := by
      rw [div_lt_one hPpos]; exact_mod_cast ZMod.val_lt k
    unfold giCircNorm giBrZ giBr
    by_cases h : (k.val : ℝ) / P < 1 / 2
    · have hr : round ((k.val : ℝ) / P) = 0 := round_eq_zero_iff.mpr ⟨by linarith, h⟩
      rw [hr, Int.cast_zero, sub_zero, abs_of_nonneg hk0, min_eq_left (by linarith)]
    · push_neg at h
      have hr : round ((k.val : ℝ) / P) = 1 := by
        rw [round_eq, Int.floor_eq_iff]; push_cast; constructor <;> linarith
      rw [hr, Int.cast_one, abs_of_nonpos (by linarith), min_eq_right (by linarith)]
      ring
  
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = S.card := ⟨_, rfl⟩
  rw [← hn]
  have hn1 : 1 ≤ n := by rw [hn]; exact Finset.card_pos.mpr ⟨ξ₀, hξ₀S⟩
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn1
  have hnpos : (0 : ℝ) < n := by linarith
  let Γ : AddSubgroup (S → ℝ) :=
    { carrier := {y | ∃ a : ℤ, ∃ m : S → ℤ, ∀ ξ : S,
          y ξ = (a : ℝ) * ((ξ.1).val : ℝ) + (P : ℝ) * (m ξ : ℝ)}
      zero_mem' := ⟨0, 0, fun ξ => by simp⟩
      add_mem' := by
        rintro y z ⟨a, m, hy⟩ ⟨a', m', hz⟩
        exact ⟨a + a', m + m', fun ξ => by
          simp only [Pi.add_apply, hy, hz]; push_cast; ring⟩
      neg_mem' := by
        rintro y ⟨a, m, hy⟩
        exact ⟨-a, -m, fun ξ => by simp only [Pi.neg_apply, hy]; push_cast; ring⟩ }
  have hmemΓ : ∀ y : S → ℝ, y ∈ Γ ↔ ∃ a : ℤ, ∃ m : S → ℤ, ∀ ξ : S,
      y ξ = (a : ℝ) * ((ξ.1).val : ℝ) + (P : ℝ) * (m ξ : ℝ) := fun y => Iff.rfl
  have hint : ∀ y ∈ Γ, ∀ i, ∃ m : ℤ, y i = (m : ℝ) := by
    intro y hy i
    obtain ⟨a, m, hy⟩ := (hmemΓ y).1 hy
    exact ⟨a * ((i.1).val : ℤ) + P * m i, by rw [hy i]; push_cast; ring⟩
  have hr : Module.finrank ℝ (Submodule.span ℝ (Γ : Set (S → ℝ))) ≤ n := by
    refine (Submodule.finrank_le _).trans ?_
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_coe, hn]
  
  obtain ⟨k₀, w, hk₀, hwΓ, hli, hgen, hbd⟩ := int_lattice_reduced_basis n Γ hint hr
  have hwΓ' : ∀ j, ∃ a : ℤ, ∃ m : S → ℤ, ∀ ξ : S,
      w j ξ = (a : ℝ) * ((ξ.1).val : ℝ) + (P : ℝ) * (m ξ : ℝ) :=
    fun j => (hmemΓ _).1 (hwΓ j)
  choose a mm hamm using hwΓ'
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = 2 ^ k₀ * (k₀.factorial : ℝ) := ⟨_, rfl⟩
  rw [← hM] at hbd
  have hMpos : 0 < M := by rw [hM]; positivity
  obtain ⟨N, hN⟩ : ∃ N : Fin k₀ → ℝ, ∀ j, N j = Real.sqrt (∑ i, (w j i) ^ 2) :=
    ⟨_, fun _ => rfl⟩
  have hNpos : ∀ j, 0 < N j := by
    intro j
    rw [hN j]
    apply Real.sqrt_pos.mpr
    by_contra hle
    push_neg at hle
    have h0' : ∑ i, (w j i) ^ 2 = 0 :=
      le_antisymm hle (Finset.sum_nonneg (fun i _ => sq_nonneg _))
    rw [Finset.sum_eq_zero_iff_of_nonneg (fun i _ => sq_nonneg _)] at h0'
    apply hli.ne_zero j
    funext i
    exact pow_eq_zero_iff two_ne_zero |>.mp (h0' i (Finset.mem_univ i))
  have hL4 : ∀ j ξ, |w j ξ| ≤ N j := by
    intro j ξ
    rw [hN j]
    apply Real.abs_le_sqrt
    exact Finset.single_le_sum (f := fun i => (w j i) ^ 2) (fun i _ => sq_nonneg _)
      (Finset.mem_univ ξ)
  obtain ⟨qq, hqq⟩ : ∃ qq : Fin k₀ → ℝ, ∀ j, qq j = (P : ℝ) * ρ₀ / (2 * n * N j) :=
    ⟨_, fun _ => rfl⟩
  have hqq_pos : ∀ j, 0 < qq j := fun j => by
    rw [hqq j]; have := hNpos j; positivity
  obtain ⟨Lb, hLb⟩ : ∃ Lb : Fin k₀ → ℕ, ∀ j, Lb j = ⌊qq j⌋₊ + 1 := ⟨_, fun _ => rfl⟩
  have hL1 : ∀ j, ((Lb j : ℝ) - 1) * N j ≤ (P : ℝ) * ρ₀ / (2 * n) := by
    intro j
    have hfl : ((⌊qq j⌋₊ : ℕ) : ℝ) ≤ qq j := Nat.floor_le (hqq_pos j).le
    have e1 : ((Lb j : ℝ) - 1) = (⌊qq j⌋₊ : ℝ) := by rw [hLb j]; push_cast; ring
    rw [e1]
    have hNj := hNpos j
    calc (⌊qq j⌋₊ : ℝ) * N j ≤ qq j * N j := mul_le_mul_of_nonneg_right hfl hNj.le
      _ = (P : ℝ) * ρ₀ / (2 * n) := by rw [hqq j]; field_simp
  have hL2 : ∀ j, 2 ≤ Lb j → 2 * n * N j ≤ (P : ℝ) * ρ₀ := by
    intro j hj
    have h1' : 1 ≤ ⌊qq j⌋₊ := by rw [hLb j] at hj; omega
    have h2' : (1 : ℝ) ≤ qq j := (Nat.one_le_floor_iff _).mp h1'
    rw [hqq j] at h2'
    have hNj := hNpos j
    exact (one_le_div (by positivity)).mp h2'
  have hL3 : ∀ j (l : ℤ), |(l : ℝ)| < qq j → |l| < (Lb j : ℤ) := by
    intro j l hl
    have e1 : ((l.natAbs : ℕ) : ℝ) = |(l : ℝ)| := by rw [Nat.cast_natAbs, Int.cast_abs]
    have h1' : l.natAbs ≤ ⌊qq j⌋₊ := Nat.le_floor (by rw [e1]; exact hl.le)
    rw [Int.abs_eq_natAbs, hLb j]
    exact_mod_cast Nat.lt_succ_of_le h1'
  
  obtain ⟨k, e, hkle⟩ : ∃ k : ℕ, ∃ e : Fin k ≃ {j : Fin k₀ // 2 ≤ Lb j}, k ≤ k₀ :=
    ⟨_, (Fintype.equivFin _).symm, by
      simpa using Fintype.card_subtype_le (fun j : Fin k₀ => 2 ≤ Lb j)⟩
  have hFbrZ : ∀ (g : {j : Fin k₀ // 2 ≤ Lb j}) (ξ : S),
      giBrZ P ((ξ : ZMod P) * ((a g.1 : ℤ) : ZMod P)) = w g.1 ξ / P := by
    intro g ξ
    have hb := hL2 g.1 g.2
    have hw := hL4 g.1 ξ
    have hNg := hNpos g.1
    have e1 : 2 * N g.1 ≤ 2 * n * N g.1 := by nlinarith
    have e2 : (P : ℝ) * ρ₀ ≤ P * (1 / 4) := mul_le_mul_of_nonneg_left h1 hPpos.le
    have hN8 : N g.1 ≤ P / 8 := by linarith
    have hwlo := (abs_le.mp hw).1
    have hwhi := (abs_le.mp hw).2
    have hexp : w g.1 ξ / P = (a g.1 : ℝ) * ((ξ : ZMod P).val : ℝ) / P + (mm g.1 ξ : ℝ) := by
      rw [hamm g.1 ξ]; field_simp
    rw [hexp]
    apply hA2
    · rw [← hexp, le_div_iff₀ hPpos]; linarith
    · rw [← hexp, div_lt_iff₀ hPpos]; linarith
  
  obtain ⟨u₀, hu₀⟩ := hdualex k (fun i => w (e i).1)
    (hli.comp (fun i => (e i).1) (Subtype.val_injective.comp e.injective))
  refine ⟨k, fun i => ((a (e i).1 : ℤ) : ZMod P), fun i => Lb (e i).1,
    fun i ξ => if h : ξ ∈ S then (P : ℝ) * u₀ i ⟨ξ, h⟩ else 0, ?_, ?_, ?_⟩
  · 
    intro i j
    rw [← Finset.sum_coe_sort S, ← hu₀ i j]
    refine Finset.sum_congr rfl (fun ξ _ => ?_)
    beta_reduce
    rw [dif_pos ξ.2, Subtype.coe_eta, hFbrZ (e j) ξ]
    field_simp
  · 
    intro l hl ξ hξ
    beta_reduce
    have hrw : ∑ i, (l i : ℝ) * giBrZ P (ξ * ((a (e i).1 : ℤ) : ZMod P))
        = ∑ i, (l i : ℝ) * (w (e i).1 ⟨ξ, hξ⟩ / P) := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← hFbrZ (e i) ⟨ξ, hξ⟩]
    rw [hrw]
    have hterm : ∀ i, |(l i : ℝ) * (w (e i).1 ⟨ξ, hξ⟩ / P)| ≤ ρ₀ / (2 * n) := by
      intro i
      have hli' : |l i| ≤ (Lb (e i).1 : ℤ) - 1 := Int.le_sub_one_of_lt (hl i)
      have hliR : |(l i : ℝ)| ≤ (Lb (e i).1 : ℝ) - 1 := by
        rw [← Int.cast_abs]; exact_mod_cast hli'
      rw [abs_mul, abs_div, abs_of_pos hPpos]
      calc |(l i : ℝ)| * (|w (e i).1 ⟨ξ, hξ⟩| / P)
          ≤ ((Lb (e i).1 : ℝ) - 1) * (N (e i).1 / P) :=
            mul_le_mul hliR (div_le_div_of_nonneg_right (hL4 _ _) hPpos.le) (by positivity)
              ((abs_nonneg _).trans hliR)
        _ = ((Lb (e i).1 : ℝ) - 1) * N (e i).1 / P := by ring
        _ ≤ ((P : ℝ) * ρ₀ / (2 * n)) / P := div_le_div_of_nonneg_right (hL1 _) hPpos.le
        _ = ρ₀ / (2 * n) := by field_simp
    have hkR : (k : ℝ) ≤ n := by exact_mod_cast hkle.trans hk₀
    have hnρ : (n : ℝ) * (ρ₀ / (2 * n)) = ρ₀ / 2 := by field_simp
    calc |∑ i, (l i : ℝ) * (w (e i).1 ⟨ξ, hξ⟩ / P)|
        ≤ ∑ i, |(l i : ℝ) * (w (e i).1 ⟨ξ, hξ⟩ / P)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin k, ρ₀ / (2 * n) := Finset.sum_le_sum (fun i _ => hterm i)
      _ = (k : ℝ) * (ρ₀ / (2 * n)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ ≤ (n : ℝ) * (ρ₀ / (2 * n)) := mul_le_mul_of_nonneg_right hkR (by positivity)
      _ < ρ₀ := by rw [hnρ]; linarith
  · 
    intro x hx
    obtain ⟨D, hD⟩ : ∃ D : ℝ, D = (4 * ((n : ℝ) + 1)) ^ (4 * (n + 1) ^ 2) := ⟨_, rfl⟩
    have hDpos : 0 < D := by rw [hD]; positivity
    obtain ⟨ρ₁, hρ₁⟩ : ∃ ρ₁ : ℝ, ρ₁ = ρ₀ / D := ⟨_, rfl⟩
    have hρ₁pos : 0 < ρ₁ := by rw [hρ₁]; positivity
    rw [← hD, ← hρ₁] at hx
    simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and] at hx
    choose m' hm' using fun ξ : S => hA1 x (ξ : ZMod P)
    obtain ⟨X, hX⟩ : ∃ X : S → ℝ, ∀ ξ, X ξ = (P : ℝ) * giBrZ P ((ξ : ZMod P) * x) :=
      ⟨_, fun _ => rfl⟩
    have hXΓ : X ∈ Γ :=
      (hmemΓ X).2 ⟨(x.val : ℤ), m', fun ξ => by rw [hX, hm' ξ]; push_cast; ring⟩
    have hXbd : ∀ ξ, |X ξ| < P * ρ₁ := by
      intro ξ
      rw [hX, abs_mul, abs_of_pos hPpos, ← hcirc]
      exact mul_lt_mul_of_pos_left (hx ξ ξ.2) hPpos
    have hXnorm : Real.sqrt (∑ i, (X i) ^ 2) < n * P * ρ₁ := by
      rw [Real.sqrt_lt' (by positivity)]
      calc ∑ i, (X i) ^ 2 < ∑ _i : S, ((P : ℝ) * ρ₁) ^ 2 :=
            Finset.sum_lt_sum_of_nonempty ⟨⟨ξ₀, hξ₀S⟩, Finset.mem_univ _⟩
              (fun i _ => by
                have h := abs_lt.mp (hXbd i)
                exact sq_lt_sq' h.1 h.2)
        _ = (n : ℝ) * ((P : ℝ) * ρ₁) ^ 2 := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_coe, nsmul_eq_mul, hn]
        _ ≤ (n : ℝ) ^ 2 * ((P : ℝ) * ρ₁) ^ 2 :=
            mul_le_mul_of_nonneg_right (by nlinarith) (sq_nonneg _)
        _ = (n * P * ρ₁) ^ 2 := by ring
    obtain ⟨l, hl⟩ := hgen X hXΓ
    have hXcoord : ∀ i, X i = ∑ j, (l j : ℝ) * w j i := by
      intro i
      rw [hl, Finset.sum_apply]
      simp only [Pi.smul_apply, smul_eq_mul]
    have hc := hconst n k₀ hn1 hk₀
    rw [← hM, ← hD] at hc
    have hkey : M * (n * P * ρ₁) ≤ P * ρ₀ / (2 * n) := by
      rw [le_div_iff₀ (by positivity)]
      have e1 : M * (n * P * ρ₁) * (2 * n) = (2 * n * n * M) * (P * ρ₀) / D := by
        rw [hρ₁]; field_simp
      rw [e1, div_le_iff₀ hDpos]
      have hPρ : 0 ≤ (P : ℝ) * ρ₀ := (mul_pos hPpos h0).le
      have := mul_le_mul_of_nonneg_right hc hPρ
      linarith
    have hlbd : ∀ j, |(l j : ℝ)| < qq j := by
      intro j
      have h := hbd (fun j => (l j : ℝ)) j
      have hsum : (∑ i, (∑ j', (l j' : ℝ) * w j' i) ^ 2) = ∑ i, (X i) ^ 2 := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [hXcoord i]
      rw [hsum, ← hN j] at h
      have hlt : |(l j : ℝ)| * N j < P * ρ₀ / (2 * n) :=
        calc |(l j : ℝ)| * N j ≤ M * Real.sqrt (∑ i, (X i) ^ 2) := h
          _ < M * (n * P * ρ₁) := mul_lt_mul_of_pos_left hXnorm hMpos
          _ ≤ P * ρ₀ / (2 * n) := hkey
      have hNj := hNpos j
      rw [hqq j, lt_div_iff₀ (by positivity)]
      have e2 : |(l j : ℝ)| * (2 * n * N j) = (|(l j : ℝ)| * N j) * (2 * n) := by ring
      rw [e2, ← lt_div_iff₀ (by positivity)]
      exact hlt
    have hlL : ∀ j, |l j| < (Lb j : ℤ) := fun j => hL3 j (l j) (hlbd j)
    have hbad : ∀ j, ¬ 2 ≤ Lb j → l j = 0 := by
      intro j hj
      have h1' : Lb j = 1 := by rw [hLb j] at hj ⊢; omega
      have h2' := hlL j
      rw [h1'] at h2'
      exact Int.abs_lt_one_iff.mp (by exact_mod_cast h2')
    refine ⟨fun i => l (e i).1, fun i => hlL (e i).1, ?_⟩
    have hX0 : X ⟨ξ₀, hξ₀S⟩ = ((∑ j, l j * a j : ℤ) : ℝ) * (ξ₀.val : ℝ)
        + P * ((∑ j, l j * mm j ⟨ξ₀, hξ₀S⟩ : ℤ) : ℝ) := by
      rw [hXcoord ⟨ξ₀, hξ₀S⟩]
      simp only [hamm]
      push_cast
      rw [Finset.sum_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ring
    have hX0' : X ⟨ξ₀, hξ₀S⟩ = (x.val : ℝ) * (ξ₀.val : ℝ) + P * (m' ⟨ξ₀, hξ₀S⟩ : ℝ) := by
      rw [hX, hm' ⟨ξ₀, hξ₀S⟩]
    have hxb := hA3 ξ₀ x (∑ j, l j * a j) (∑ j, l j * mm j ⟨ξ₀, hξ₀S⟩ - m' ⟨ξ₀, hξ₀S⟩) hξ₀
      (by push_cast; push_cast at hX0; linarith)
    rw [hxb]
    push_cast
    have hzero : ∀ j ∈ (Finset.univ : Finset (Fin k₀)),
        j ∉ Finset.univ.filter (fun j => 2 ≤ Lb j) →
        ((l j : ℤ) : ZMod P) * ((a j : ℤ) : ZMod P) = 0 := by
      intro j _ hj
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj
      rw [hbad j hj]; simp
    rw [Equiv.sum_comp e (fun g => ((l g.1 : ℤ) : ZMod P) * ((a g.1 : ℤ) : ZMod P)),
      ← Finset.sum_subset (Finset.subset_univ _) hzero]
    exact Finset.sum_subtype _ (fun j => by simp) _

theorem box_locquad_integer_quadratic (k : ℕ) (L : Fin k → ℕ) (f : (Fin k → ℤ) → ℝ)
    (hf : ∀ x h₁ h₂ h₃ : Fin k → ℤ,
      (∀ ε : Fin 3 → Fin 2, ∀ i, |cubeVertex x h₁ h₂ h₃ ε i| < (L i : ℤ)) →
      ∃ m : ℤ, ∑ ε : Fin 3 → Fin 2,
        (-1 : ℝ) ^ ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ)) * f (cubeVertex x h₁ h₂ h₃ ε) = m) :
    ∃ (A : Fin k → Fin k → ℝ) (η : Fin k → ℝ) (c : ℝ), ∀ l : Fin k → ℤ,
      (∀ i, |l i| < (L i : ℤ)) →
      ∃ m : ℤ, f l = ∑ i, ∑ j, A i j * (l i : ℝ) * (l j : ℝ) + ∑ i, η i * (l i : ℝ) + c + m :=
by
  
  
  
  have cubeq : ∀ (A : Fin k → Fin k → ℝ) (η : Fin k → ℝ) (c : ℝ) (x h₁ h₂ h₃ : Fin k → ℤ),
      ∑ ε : Fin 3 → Fin 2, (-1 : ℝ) ^ ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ)) *
        (∑ i, ∑ j, A i j * ((cubeVertex x h₁ h₂ h₃ ε i : ℤ) : ℝ)
            * ((cubeVertex x h₁ h₂ h₃ ε j : ℤ) : ℝ)
          + ∑ i, η i * ((cubeVertex x h₁ h₂ h₃ ε i : ℤ) : ℝ) + c) = 0 := by
    intro A η c x h₁ h₂ h₃
    have sum8 : ∀ Φ : (Fin 3 → Fin 2) → ℝ,
        ∑ ε, Φ ε = ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, Φ ![a, b, c] := by
      intro Φ
      rw [← (Fin.consEquiv (fun _ : Fin 3 => Fin 2)).sum_comp, Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← (Fin.consEquiv (fun _ : Fin 2 => Fin 2)).sum_comp, Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [← (Fin.consEquiv (fun _ : Fin 1 => Fin 2)).sum_comp, Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun c _ => ?_
      rw [Fintype.sum_unique]
      congr 1
    have hv : ∀ (ε : Fin 3 → Fin 2) (i : Fin k),
        ((cubeVertex x h₁ h₂ h₃ ε i : ℤ) : ℝ) = (x i : ℝ) + ((ε 0 : ℕ) : ℝ) * (h₁ i : ℝ)
          + ((ε 1 : ℕ) : ℝ) * (h₂ i : ℝ) + ((ε 2 : ℕ) : ℝ) * (h₃ i : ℝ) := by
      intro ε i
      simp [cubeVertex]
    have key : ∀ (s : (Fin 3 → Fin 2) → ℝ) (u : (Fin 3 → Fin 2) → Fin k → ℝ),
        ∑ ε, s ε = 0 → (∀ i, ∑ ε, s ε * u ε i = 0) →
        (∀ i j, ∑ ε, s ε * (u ε i * u ε j) = 0) →
        ∑ ε, s ε * (∑ i, ∑ j, A i j * u ε i * u ε j + ∑ i, η i * u ε i + c) = 0 := by
      intro s u h0 h1 h2
      have hpt : ∀ ε, s ε * (∑ i, ∑ j, A i j * u ε i * u ε j + ∑ i, η i * u ε i + c)
          = ∑ i, ∑ j, A i j * (s ε * (u ε i * u ε j)) + ∑ i, η i * (s ε * u ε i)
            + c * s ε := by
        intro ε
        rw [mul_add, mul_add, Finset.mul_sum, Finset.mul_sum]
        congr 1
        congr 1
        · refine Finset.sum_congr rfl fun i _ => ?_
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          ring
        · refine Finset.sum_congr rfl fun i _ => ?_
          ring
        · ring
      rw [Finset.sum_congr rfl (fun ε _ => hpt ε), Finset.sum_add_distrib, Finset.sum_add_distrib]
      have e2 : ∑ ε, ∑ i, ∑ j, A i j * (s ε * (u ε i * u ε j)) = 0 := by
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [← Finset.mul_sum, h2, mul_zero]
      have e1 : ∑ ε, ∑ i, η i * (s ε * u ε i) = 0 := by
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [← Finset.mul_sum, h1, mul_zero]
      have e0 : ∑ ε, c * s ε = 0 := by rw [← Finset.mul_sum, h0, mul_zero]
      rw [e2, e1, e0]; ring
    apply key (fun ε => (-1 : ℝ) ^ ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ)))
      (fun ε i => ((cubeVertex x h₁ h₂ h₃ ε i : ℤ) : ℝ))
    · rw [sum8]; simp [Fin.sum_univ_two]; norm_num
    · intro i; rw [sum8]; simp only [hv]; simp [Fin.sum_univ_two]; ring
    · intro i j; rw [sum8]; simp only [hv]; simp [Fin.sum_univ_two]; ring
  
  
  
  have shiftnf : ∀ (M : Fin k → Fin k → ℝ) (β : Fin k → ℝ) (c₀ : ℝ) (b : Fin k → ℝ)
      (y : Fin k → ℝ),
      c₀ + ∑ a, β a * (y a - b a) + ∑ a, ∑ a', M a a' * (y a - b a) * (y a' - b a')
        = ∑ i, ∑ j, M i j * y i * y j + ∑ i, (β i - ∑ a', (M i a' + M a' i) * b a') * y i
          + (c₀ - ∑ a, β a * b a + ∑ a, ∑ a', M a a' * b a * b a') := by
    intro M β c₀ b y
    have e1 : ∑ a, β a * (y a - b a) = ∑ a, β a * y a - ∑ a, β a * b a := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun a _ => by ring
    have e2 : ∑ a, ∑ a', M a a' * (y a - b a) * (y a' - b a')
        = ∑ a, ∑ a', M a a' * y a * y a' - ∑ a, ∑ a', M a a' * b a' * y a
          - ∑ a, ∑ a', M a a' * b a * y a' + ∑ a, ∑ a', M a a' * b a * b a' := by
      simp only [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun a' _ => ?_
      ring
    have e3 : ∑ a, ∑ a', M a a' * b a * y a' = ∑ a, ∑ a', M a' a * b a' * y a :=
      Finset.sum_comm
    have e4 : ∑ i, (β i - ∑ a', (M i a' + M a' i) * b a') * y i
        = ∑ a, β a * y a - ∑ a, ∑ a', M a a' * b a' * y a
          - ∑ a, ∑ a', M a' a * b a' * y a := by
      rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [sub_mul, Finset.sum_mul, sub_sub, ← Finset.sum_add_distrib]
      congr 1
      exact Finset.sum_congr rfl fun a' _ => by ring
    rw [e1, e2, e3, e4]
    ring
  
  
  
  have pick : ∀ m : Fin k → ℤ, (∀ a, 0 ≤ m a) → 1 ≤ ∑ a, m a →
      ∃ i, (∀ a, 0 ≤ m a - (Pi.single i (1 : ℤ) : Fin k → ℤ) a) ∧
        ∑ a, (m a - (Pi.single i (1 : ℤ) : Fin k → ℤ) a) = ∑ a, m a - 1 := by
    intro m hm hs
    obtain ⟨i, -, hi⟩ : ∃ i ∈ Finset.univ, (0 : ℤ) < m i := by
      apply Finset.exists_lt_of_sum_lt
      simp only [Finset.sum_const_zero]
      omega
    refine ⟨i, fun a => ?_, ?_⟩
    · by_cases h : a = i
      · subst h; simp; omega
      · simp [h, hm a]
    · simp [Finset.sum_sub_distrib]
  have seeds : ∀ n : Fin k → ℤ, (∀ a, 0 ≤ n a) → ∑ a, n a ≤ 2 →
      n = 0 ∨ (∃ i, n = Pi.single i 1) ∨ ∃ i j, n = Pi.single i 1 + Pi.single j 1 := by
    intro n hn hs
    have Z : ∀ m : Fin k → ℤ, (∀ a, 0 ≤ m a) → ∑ a, m a ≤ 0 → ∀ a, m a = 0 := by
      intro m hm hs
      have h0 : ∑ a, m a = 0 := le_antisymm hs (Finset.sum_nonneg fun a _ => hm a)
      intro a
      exact (Finset.sum_eq_zero_iff_of_nonneg (fun a _ => hm a)).mp h0 a (Finset.mem_univ a)
    by_cases h0 : ∑ a, n a ≤ 0
    · left; funext a; exact Z n hn h0 a
    obtain ⟨i, hi1, hi2⟩ := pick n hn (by omega)
    by_cases h1 : ∑ a, (n a - (Pi.single i (1 : ℤ) : Fin k → ℤ) a) ≤ 0
    · right; left
      refine ⟨i, funext fun a => ?_⟩
      have := Z _ hi1 h1 a
      simp only at this
      omega
    obtain ⟨j, hj1, hj2⟩ := pick _ hi1 (by omega)
    right; right
    refine ⟨i, j, funext fun a => ?_⟩
    have := Z _ hj1 (by omega) a
    simp only at this
    simp only [Pi.add_apply]
    omega
  
  
  
  have propag : ∀ G : (Fin k → ℤ) → ℝ,
      (∀ x h₁ h₂ h₃ : Fin k → ℤ,
        (∀ ε : Fin 3 → Fin 2, ∀ i, |cubeVertex x h₁ h₂ h₃ ε i| < (L i : ℤ)) →
        ∃ m : ℤ, ∑ ε : Fin 3 → Fin 2,
          (-1 : ℝ) ^ ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ)) * G (cubeVertex x h₁ h₂ h₃ ε) = m) →
      (∀ l : Fin k → ℤ, (∀ i, |l i| < (L i : ℤ)) →
        ∑ i, (l i - (1 - (L i : ℤ))) ≤ 2 → ∃ m : ℤ, G l = m) →
      ∀ l : Fin k → ℤ, (∀ i, |l i| < (L i : ℤ)) → ∃ m : ℤ, G l = m := by
    intro G hcube hseed
    have he : ∀ (i a : Fin k), 0 ≤ (Pi.single i (1 : ℤ) : Fin k → ℤ) a ∧
        (Pi.single i (1 : ℤ) : Fin k → ℤ) a ≤ 1 := by
      intro i a
      by_cases h : a = i
      · subst h; simp
      · simp [h]
    have hes : ∀ i : Fin k, ∑ a, (Pi.single i (1 : ℤ) : Fin k → ℤ) a = 1 := by
      intro i; simp
    have hne : ∀ ε : Fin 3 → Fin 2, ε ≠ (fun _ => 1) →
        (ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ) ≤ 2 := by decide
    have hint : ∀ (s : Finset (Fin 3 → Fin 2)) (g : (Fin 3 → Fin 2) → ℝ),
        (∀ ε ∈ s, ∃ z : ℤ, g ε = z) → ∃ z : ℤ, ∑ ε ∈ s, g ε = z := by
      intro s g hg
      exact Finset.sum_induction g (fun t => ∃ z : ℤ, t = z)
        (fun a b ⟨za, ha⟩ ⟨zb, hb⟩ => ⟨za + zb, by rw [ha, hb]; push_cast; ring⟩)
        ⟨0, by simp⟩ hg
    have claim : ∀ d : ℕ, ∀ l : Fin k → ℤ, (∀ i, |l i| < (L i : ℤ)) →
        ∑ i, (l i - (1 - (L i : ℤ))) = (d : ℤ) → ∃ m : ℤ, G l = m := by
      intro d
      induction d using Nat.strong_induction_on with
      | _ d ih =>
      intro l hl hD
      by_cases hd : d ≤ 2
      · exact hseed l hl (by rw [hD]; exact_mod_cast hd)
      push_neg at hd
      have hl' : ∀ a, 1 - (L a : ℤ) ≤ l a ∧ l a ≤ (L a : ℤ) - 1 := by
        intro a; have := abs_lt.mp (hl a); omega
      obtain ⟨i₁, h1a, h1s⟩ := pick (fun a => l a - (1 - (L a : ℤ)))
        (fun a => by have := hl' a; show 0 ≤ l a - (1 - (L a : ℤ)); omega) (by rw [hD]; omega)
      obtain ⟨i₂, h2a, h2s⟩ := pick _ h1a (by rw [h1s, hD]; omega)
      obtain ⟨i₃, h3a, h3s⟩ := pick _ h2a (by rw [h2s, h1s, hD]; omega)
      set e₁ : Fin k → ℤ := Pi.single i₁ 1 with he₁
      set e₂ : Fin k → ℤ := Pi.single i₂ 1 with he₂
      set e₃ : Fin k → ℤ := Pi.single i₃ 1 with he₃
      set p : Fin k → ℤ := fun a => l a - e₁ a - e₂ a - e₃ a with hp
      have hv : ∀ (ε : Fin 3 → Fin 2) (a : Fin k), cubeVertex p e₁ e₂ e₃ ε a
          = l a - e₁ a - e₂ a - e₃ a + ((ε 0 : ℕ) : ℤ) * e₁ a + ((ε 1 : ℕ) : ℤ) * e₂ a
            + ((ε 2 : ℕ) : ℤ) * e₃ a := by
        intro ε a
        simp [cubeVertex, hp]
      have hεb : ∀ (ε : Fin 3 → Fin 2) (r : Fin 3),
          ((ε r : ℕ) : ℤ) = 0 ∨ ((ε r : ℕ) : ℤ) = 1 := by
        intro ε r
        have := (ε r).isLt
        omega
      have hprod : ∀ (t e : ℤ), (t = 0 ∨ t = 1) → 0 ≤ e → 0 ≤ t * e ∧ t * e ≤ e := by
        rintro t e (rfl | rfl) he0 <;> simp [he0]
      have hb1 : ∀ a, 0 ≤ e₁ a ∧ e₁ a ≤ 1 := he i₁
      have hb2 : ∀ a, 0 ≤ e₂ a ∧ e₂ a ≤ 1 := he i₂
      have hb3 : ∀ a, 0 ≤ e₃ a ∧ e₃ a ≤ 1 := he i₃
      have hs1 : ∑ a, e₁ a = 1 := hes i₁
      have hs2 : ∑ a, e₂ a = 1 := hes i₂
      have hs3 : ∑ a, e₃ a = 1 := hes i₃
      have hbox : ∀ (ε : Fin 3 → Fin 2) (a : Fin k),
          |cubeVertex p e₁ e₂ e₃ ε a| < (L a : ℤ) := by
        intro ε a
        rw [hv, abs_lt]
        have h1 := hprod _ _ (hεb ε 0) (hb1 a).1
        have h2 := hprod _ _ (hεb ε 1) (hb2 a).1
        have h3 := hprod _ _ (hεb ε 2) (hb3 a).1
        have h4 := h3a a
        have h5 := hl' a
        constructor <;> omega
      have hheight : ∀ ε : Fin 3 → Fin 2,
          ∑ a, (cubeVertex p e₁ e₂ e₃ ε a - (1 - (L a : ℤ)))
            = (d : ℤ) - 3 + ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ) : ℕ) := by
        intro ε
        have h := h3s
        rw [h2s, h1s, hD] at h
        have e : ∀ a, cubeVertex p e₁ e₂ e₃ ε a - (1 - (L a : ℤ))
            = (l a - (1 - (L a : ℤ)) - e₁ a - e₂ a - e₃ a) + ((ε 0 : ℕ) : ℤ) * e₁ a
              + ((ε 1 : ℕ) : ℤ) * e₂ a + ((ε 2 : ℕ) : ℤ) * e₃ a := by
          intro a; rw [hv]; ring
        rw [Finset.sum_congr rfl (fun a _ => e a)]
        simp only [Finset.sum_add_distrib, ← Finset.mul_sum, hs1, hs2, hs3]
        rw [h]
        push_cast
        ring
      obtain ⟨m, hm⟩ := hcube p e₁ e₂ e₃ hbox
      have htop : cubeVertex p e₁ e₂ e₃ (fun _ => 1) = l := by
        funext a; rw [hv]; simp; ring
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (fun _ => (1 : Fin 2))), htop] at hm
      obtain ⟨r, hr⟩ := hint (Finset.univ.erase (fun _ => (1 : Fin 2)))
        (fun ε => (-1 : ℝ) ^ ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ)) * G (cubeVertex p e₁ e₂ e₃ ε))
        (by
          intro ε hε
          have hε' := hne ε (Finset.ne_of_mem_erase hε)
          obtain ⟨z, hz⟩ := ih (d - 3 + ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ))) (by omega)
            (cubeVertex p e₁ e₂ e₃ ε) (hbox ε) (by rw [hheight ε]; push_cast; omega)
          exact ⟨(-1) ^ ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ)) * z, by
            beta_reduce; rw [hz]; push_cast; ring⟩)
      rw [hr] at hm
      refine ⟨r - m, ?_⟩
      simp at hm
      push_cast
      linarith
    intro l hl
    have h0 : 0 ≤ ∑ i, (l i - (1 - (L i : ℤ))) :=
      Finset.sum_nonneg fun a _ => by have := abs_lt.mp (hl a); omega
    exact claim (∑ i, (l i - (1 - (L i : ℤ)))).toNat l hl (Int.toNat_of_nonneg h0).symm
  
  
  
  have interp : ∀ (b : Fin k → ℤ) (F : (Fin k → ℤ) → ℝ),
