          exact ⟨Real.rpow_nonneg (by linarith) _,
            Real.rpow_le_one_of_one_le_of_nonpos h1' (by linarith)⟩
      have hprod : |((D M m).2.1 x : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ ((D M m).2.2 - 1)|
          ≤ 1 := by
        rw [abs_mul, abs_of_nonneg ht.1]
        calc _ ≤ 1 * 1 := mul_le_mul hψx ht.2 ht.1 zero_le_one
          _ = 1 := one_mul 1
      have hfac : |1 - ((D M m).2.1 x : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ ((D M m).2.2 - 1)|
          ≤ 2 := by
        have := abs_le.mp hprod
        rw [abs_le]
        constructor <;> linarith
      show |cramerModel K ρ (primorial m) x * (1 - ((D M m).2.1 x : ℝ)
          * (((Algebra.norm ℤ x).natAbs : ℝ) ^ ((D M m).2.2 - 1)))| ≤ _
      rw [abs_mul, abs_of_nonneg (hF4 x).1]
      calc _ ≤ cramerModel K ρ (primorial m) x * 2 :=
            mul_le_mul_of_nonneg_left hfac (hF4 x).1
        _ = 2 * cramerModel K ρ (primorial m) x := mul_comm _ _
        _ ≤ _ := hbd2 x
  · 
    by_cases hψ : (D M m).2.1 = 0
    · have hfun : (fun x => siegelModel K ρ (primorial m) (D M m).2.1 (D M m).2.2 x
