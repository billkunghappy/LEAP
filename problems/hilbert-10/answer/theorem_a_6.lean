        · rw [if_neg hY, if_neg (fun h : x ∈ kaiCutoffSet ω M Y ox => hY h.2.1)]
      · intro o _ hne
        unfold kaiCutoffPiece
        rw [if_neg (fun h : x ∈ kaiCutoffSet ω M Y o => hne ((hox o).mp h.2.2))]
      · intro h
        exact absurd (Finset.mem_univ _) h
    obtain ⟨cnt, hcnt⟩ : ∃ cnt : ℝ, cnt = (((Finset.range L).filter
          (fun j : ℕ => ((Algebra.norm ℤ x).natAbs : ℝ)
            ≤ (((j : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1)))).card : ℝ) := ⟨_, rfl⟩
    have hgx : g x = (1 / (L:ℝ)) * (cnt * (cramerModel K ρ (primorial m) x * (ψ x : ℝ))) := by
      rw [hcnt]
      simp only [hg_def, hI_def]
      congr 1
