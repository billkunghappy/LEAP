    have hnorm : Real.log |(((Algebra.norm ℚ) y : ℚ) : ℝ)|
        = ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v y) := by
      have hne : ∀ v ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
          (v y) ^ (v.mult) ≠ 0 := by
        intro v _
        exact pow_ne_zero _ (ne_of_gt (NumberField.InfinitePlace.pos_iff.mpr hy))
      have h1 : Real.log (∏ v : NumberField.InfinitePlace K, (v y) ^ (v.mult))
          = ∑ v : NumberField.InfinitePlace K, Real.log ((v y) ^ (v.mult)) :=
        Real.log_prod hne
      rw [NumberField.InfinitePlace.prod_eq_abs_norm y, Rat.cast_abs] at h1
      rw [h1]
      exact Finset.sum_congr rfl (fun v _ => Real.log_pow _ _)
    have hkey : ∀ (a : ℝ) (c : Fin (NumberField.Units.rank K) → ℝ)
        (U : NumberField.InfinitePlace K → ℝ),
        (∀ v : NumberField.InfinitePlace K,
          U v = a * (v.mult : ℝ) + ∑ j, c j * kaiTBUnitLog K (H j) v) →
        a * (Module.finrank ℚ K : ℝ) = (∑ v : NumberField.InfinitePlace K, U v) ∧
          ∀ i, c i = ∑ v : NumberField.InfinitePlace K, e i v * U v := by
      intro a c U hu
      constructor
      · have h1 : (∑ v : NumberField.InfinitePlace K, U v)
