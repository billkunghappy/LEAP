        _ ≤ X₇ * R := le_mul_of_one_le_left hR0 hX₇
    have hε0 : 0 ≤ X₇ * R / M := div_nonneg hXR0.le hMpos.le
    have hε200 : X₇ * R / M ≤ ηS ^ 2 / 200 := by
      have hA : 200 * X₇ * (v ^ c₁) ^ 2 ≤ Ξ := by
        have h256 : (200 : ℝ) ≤ v ^ 8 := by have := h2v 8; norm_num at this; linarith
        calc 200 * X₇ * (v ^ c₁) ^ 2 ≤ v ^ 8 * v * (v ^ c₁) ^ 2 :=
              mul_le_mul_of_nonneg_right (mul_le_mul h256 hXv hX₇0.le (hvp0 _))
                (pow_nonneg hvc0.le 2)
          _ = v ^ E2 := by rw [hE2]; ring
          _ ≤ Ξ := hpowv _ (by omega)
      rw [div_le_div_iff₀ hMpos (by norm_num), hηS_def, inv_pow, ← div_eq_inv_mul,
        le_div_iff₀ (pow_pos hvc0 2)]
      calc X₇ * R * 200 * (v ^ c₁) ^ 2 = R * (200 * X₇ * (v ^ c₁) ^ 2) := by ring
        _ ≤ R * Ξ := mul_le_mul_of_nonneg_left hA hR0
        _ ≤ M := hRΞ
    have hnear : ∀ m : Fin a, ∀ b ∈ S, ∀ i : Fin (Module.finrank ℚ K), ∃ z : ℤ,
        |∑ l, ((ω.repr (b * ω i) l : ℤ) : ℝ) * ∑ i', ((k₀ m i' : ℤ) : ℝ) * p₁ l i' - z|
          ≤ X₇ * R / M := by
      intro m b hb i
      rw [hS_def] at hb
      obtain ⟨𝔡, h𝔡, rfl⟩ := Finset.mem_image.mp hb
      obtain ⟨z, hz⟩ := (hG 𝔡 (hG'G h𝔡)).2.2.2.2.2.2 m (ω i)
      rw [hG'k 𝔡 h𝔡] at hz
      refine ⟨z, hz.trans ?_⟩
      apply div_le_div_of_nonneg_right _ hMpos.le
      have h1 := mul_le_mul_of_nonneg_left (hbsn1 i) hXR0.le
      linarith
    have hvm : ∀ m : Fin a, ∃ q : ℕ, 1 ≤ q ∧
        (q : ℝ) ≤ (2 / ηS) ^ (Module.finrank ℚ K ^ 2) ∧
        ∀ l : Fin (Module.finrank ℚ K), ∃ z : ℤ,
          |(q : ℝ) * (∑ i, ((k₀ m i : ℤ) : ℝ) * p₁ l i) - z| ≤
            C₆ * (2 / ηS) ^ (Module.finrank ℚ K ^ 2 + Module.finrank ℚ K)
              * (4 * (X₇ * R / M) / (ηS ^ 2 * (X₇ * R))) := fun m =>
      hvin (fun l => ∑ i, ((k₀ m i : ℤ) : ℝ) * p₁ l i) S (X₇ * R) ηS (X₇ * R / M) hηS0 hηS1
        h6 hε0 hε200 hSbound hdens (hnear m)
    choose q hq1 hqle hqz using hvm
    
    have h2η : 2 / ηS ≤ v ^ (c₁ + 1) := by
      rw [hηS_def, div_inv_eq_mul, pow_succ, mul_comm]
      exact mul_le_mul_of_nonneg_left hv2 hvc0.le
    have h2η0 : 0 ≤ 2 / ηS := div_nonneg (by norm_num) hηS0.le
    have hqv : ∀ m, (q m : ℝ) ≤ v ^ ((c₁ + 1) * Module.finrank ℚ K ^ 2) := by
      intro m
      rw [pow_mul]
      exact (hqle m).trans (pow_le_pow_left₀ h2η0 h2η _)
    have hRHS : C₆ * (2 / ηS) ^ (Module.finrank ℚ K ^ 2 + Module.finrank ℚ K)
        * (4 * (X₇ * R / M) / (ηS ^ 2 * (X₇ * R))) ≤ Ξ / M := by
      have hX₇ne := hX₇0.ne'
      have hRne : R ≠ 0 := by linarith
      have hMne := hMpos.ne'
      have hvcne := hvc0.ne'
      have e1 : 4 * (X₇ * R / M) / (ηS ^ 2 * (X₇ * R)) = 4 * (v ^ c₁) ^ 2 / M := by
        rw [hηS_def]; field_simp
      rw [e1, ← mul_div_assoc]
      apply div_le_div_of_nonneg_right _ hMpos.le
      have h4 : (4 : ℝ) ≤ v ^ 2 := by have := h2v 2; norm_num at this; linarith
      calc C₆ * (2 / ηS) ^ (Module.finrank ℚ K ^ 2 + Module.finrank ℚ K) * (4 * (v ^ c₁) ^ 2)
          ≤ v ^ c₆ * (v ^ (c₁ + 1)) ^ (Module.finrank ℚ K ^ 2 + Module.finrank ℚ K)
              * (v ^ 2 * (v ^ c₁) ^ 2) :=
            mul_le_mul (mul_le_mul hC₆v (pow_le_pow_left₀ h2η0 h2η _)
                (pow_nonneg h2η0 _) (hvp0 _))
              (mul_le_mul_of_nonneg_right h4 (pow_nonneg hvc0.le 2))
              (mul_nonneg (by norm_num) (pow_nonneg hvc0.le 2))
              (mul_nonneg (hvp0 _) (pow_nonneg (hvp0 _) _))
        _ = v ^ E3 := by
            rw [hE3, ← pow_mul, ← pow_mul, pow_add, pow_add, pow_add]
            ac_rfl
        _ ≤ Ξ := hpowv _ (by omega)
    refine ⟨fun m i => (q m : ℤ) * k₀ m i, ?_, hiso k₀ q hq1 hk₀iso, ?_⟩
    · intro m i
      show |((((q m : ℕ) : ℤ) * k₀ m i : ℤ) : ℝ)| ≤ Ξ
      rw [show ((((q m : ℕ) : ℤ) * k₀ m i : ℤ) : ℝ) = ((q m : ℕ) : ℝ) * ((k₀ m i : ℤ) : ℝ) by
          push_cast; ring, abs_mul, Nat.abs_cast]
      calc ((q m : ℕ) : ℝ) * |((k₀ m i : ℤ) : ℝ)|
