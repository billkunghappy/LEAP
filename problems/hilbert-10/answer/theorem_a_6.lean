  obtain ⟨col, rchar, rdeg, hcol1, hcol2⟩ := hcolour
  
  have hspan : ∀ m : ℕ,
      Ideal.absNorm (Ideal.span {((m : ℕ) : NumberField.RingOfIntegers K)})
        = m ^ (Module.finrank ℚ K) := by
    intro m
    have hcast : ((m : ℕ) : NumberField.RingOfIntegers K)
        = algebraMap ℤ (NumberField.RingOfIntegers K) ((m : ℕ) : ℤ) :=
