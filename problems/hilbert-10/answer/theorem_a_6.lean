      intro m; exact neg_one_geom_sum
    have hunn : ∀ m : ℕ, 0 ≤ ∑ i ∈ Finset.range (m + 1), x ^ i := by
      intro m
      rcases hx with rfl | rfl | rfl
      · rw [hu1]; positivity
      · rw [hum]; split <;> norm_num
      · rw [hu0]; norm_num
