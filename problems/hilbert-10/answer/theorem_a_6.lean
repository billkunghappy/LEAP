  have hsum2 : ∀ x y : Fin b → ℝ, ∑ k, (ζ k : ℝ) * (x k + y k) =
      ∑ k, (ζ k : ℝ) * x k + ∑ k, (ζ k : ℝ) * y k := by
    intro x y
    simp only [mul_add, Finset.sum_add_distrib]
  refine ⟨a, b, Bc, ζ, p₀, p₁, r₀, r₁, r₂, F', hab, fun i j k => (hBc i j k).trans hQX, hζX,
    hζ0, fun u => (hF'1 u).trans hX1, ?_, ?_, ?_, ?_⟩
  · 
    intro u γ₁ γ₂
    have hpt : ∀ t : Fin b → ℝ,
        F ((nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).1,
          fun k => (nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).2 k + t k)
        = F (u.1, fun k => u.2 k + t k) := by
      intro t
      have e1 : ((nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).1,
          fun k => (nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).2 k + t k)
