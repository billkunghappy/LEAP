theorem gi_bohr_linearization (C_BR : ℕ) (hBR : GiSandersBR C_BR) :
    ∃ A E : ℕ, 1 ≤ A ∧ 1 ≤ E ∧
      ∀ (P : ℕ) [NeZero P], P.Prime → 3 ≤ P →
      ∀ (g : ZMod P → ℝ) (Λ : ℝ) (H'' : Finset (ZMod P)) (ξ : ZMod P → ZMod P),
        (∀ x, |g x| ≤ 1) → 1 ≤ Λ →
        Real.exp (-(13 * Λ)) * P / 64 ≤ (H''.card : ℝ) →
        (∀ a b : Fin 8 → ZMod P, (∀ i, a i ∈ H'') → (∀ i, b i ∈ H'') →
          ∑ i, a i = ∑ i, b i → ∑ i, ξ (a i) = ∑ i, ξ (b i)) →
        (∀ h ∈ H'', Real.exp (-Λ) * P ≤
          ‖∑ x : ZMod P, ((g (x + h) * g x : ℝ) : ℂ) * giE (-(((ξ h * x).val : ℝ) / P))‖) →
        ∃ (S₁ : Finset (ZMod P)) (ρ₀ ρ₁ : ℝ) (x₀ ξ₀ : ZMod P) (M : ZMod P → ZMod P),
          (S₁.card : ℝ) ≤ A * Λ ^ E ∧ Real.exp (-(A * Λ ^ E)) ≤ ρ₀ ∧ ρ₀ ≤ 1 / 4 ∧
          ρ₀ / 8 ≤ ρ₁ ∧ ρ₁ ≤ ρ₀ / 4 ∧ GiRegularBohr P S₁ ρ₁ ∧ M 0 = 0 ∧
          (∀ a ∈ giBohr P S₁ ρ₀, ∀ b ∈ giBohr P S₁ ρ₀, ∀ a' ∈ giBohr P S₁ ρ₀,
            ∀ b' ∈ giBohr P S₁ ρ₀, a + b = a' + b' → M a + M b = M a' + M b') ∧
          Real.exp (-(A * Λ ^ E)) * P * ((giBohr P S₁ ρ₁).card : ℝ) ≤
            ∑ h ∈ giBohr P S₁ ρ₁, ‖∑ x : ZMod P, ((g (x + x₀ + h) * g x : ℝ) : ℂ) *
              giE (-((((ξ₀ + 2 * M h) * x).val : ℝ) / P))‖ :=
