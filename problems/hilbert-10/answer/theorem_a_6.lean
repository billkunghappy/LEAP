theorem kai_v_bracket_elimination (a ν s t : ℕ) (ω : Fin a → Fin a → ℤ) (W Y σ : ℝ)
    (hW : 0 ≤ W) (hY : 1 ≤ Y) (hσ : 0 ≤ σ) (hω : ∀ i j, |(ω i j : ℝ)| ≤ W)
    (q : Fin ν → Fin a → ℝ) (S : Fin ν → Fin ν → ℝ)
    (w : Fin s → Fin a ⊕ Fin ν → ℤ) (η : Fin t → Fin a ⊕ Fin ν → ℤ)
    (hst : s + t = a + ν)
    (hw : LinearIndependent ℝ (fun i k => (w i k : ℝ)))
    (hη : LinearIndependent ℝ (fun i k => (η i k : ℝ)))
    (horth : ∀ i i', ∑ k, w i k * η i' k = 0)
    (hwY : ∀ i k, |(w i k : ℝ)| ≤ Y) (hηY : ∀ i k, |(η i k : ℝ)| ≤ Y)
    (hηα : ∀ i' l',
      |(∑ k, (η i' k : ℝ) * Sum.elim (fun j => q l' j) (fun l => S l l') k)
        - round (∑ k, (η i' k : ℝ) * Sum.elim (fun j => q l' j) (fun l => S l l') k)| ≤ σ)
