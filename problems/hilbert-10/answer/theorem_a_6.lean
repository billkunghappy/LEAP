theorem kai_cube_scale_numerics (M : ℝ) (hM : 3 ≤ M) :
    1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/2) / 2) ∧
    Real.exp (Real.log M ^ ((1:ℝ)/2)) = Real.exp (Real.log M ^ ((1:ℝ)/2) / 2) ^ 2 ∧
    Real.exp (Real.log M ^ ((1:ℝ)/2)) ≤ M ∧
    Real.exp (-(Real.log M ^ ((1:ℝ)/2)) / 2) = (Real.exp (Real.log M ^ ((1:ℝ)/2) / 2))⁻¹ ∧
    M ^ ((1:ℝ)/4) = M * M ^ (-(3:ℝ)/4) ∧
    M ^ ((1:ℝ)/4) ≤ 2 * M / Real.exp (Real.log M ^ ((1:ℝ)/2)) ∧
    M / Real.exp (Real.log M ^ ((1:ℝ)/2))
      < ((⌊M / Real.exp (Real.log M ^ ((1:ℝ)/2))⌋₊ + 1 : ℕ) : ℝ) ∧
    ((⌊M / Real.exp (Real.log M ^ ((1:ℝ)/2))⌋₊ + 1 : ℕ) : ℝ)
      ≤ 2 * M / Real.exp (Real.log M ^ ((1:ℝ)/2)) ∧
    ((⌊M / Real.exp (Real.log M ^ ((1:ℝ)/2))⌋₊ : ℕ) : ℝ) ≤ M / Real.exp (Real.log M ^ ((1:ℝ)/2)) :=
by
  have hMpos : 0 < M := by linarith
  have hℓ1 : 1 < Real.log M := by
    rw [Real.lt_log_iff_exp_lt hMpos]
    have := Real.exp_one_lt_d9
    linarith
  have h5 : M ^ ((1:ℝ)/4) = M * M ^ (-(3:ℝ)/4) := by
    rw [show (1:ℝ)/4 = 1 + (-(3:ℝ))/4 by norm_num, Real.rpow_add hMpos, Real.rpow_one]
  have hP : M ^ (-(3:ℝ)/4) = Real.exp (Real.log M * (-(3:ℝ)/4)) := Real.rpow_def_of_pos hMpos _
  have hexpM : Real.exp (Real.log M) = M := Real.exp_log hMpos
  obtain ⟨u, hu⟩ : ∃ u, u = Real.log M ^ ((1:ℝ)/2) := ⟨_, rfl⟩
  have hu1 : 1 ≤ u := by rw [hu]; exact Real.one_le_rpow hℓ1.le (by norm_num)
  have huℓ : u ≤ Real.log M := by
    have := Real.rpow_le_rpow_of_exponent_le hℓ1.le (show (1:ℝ)/2 ≤ 1 by norm_num)
    rw [Real.rpow_one] at this
    rw [hu]; exact this
  have husq : u ^ 2 = Real.log M := by
    rw [hu, ← Real.sqrt_eq_rpow]; exact Real.sq_sqrt (by linarith)
  rw [← hu]
  rw [hP] at h5 ⊢
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, ℓ = Real.log M := ⟨_, rfl⟩
  rw [← hℓ] at h5 hℓ1 huℓ husq hexpM ⊢
  have hY : 0 < Real.exp u := Real.exp_pos u
  have h3 : Real.exp u ≤ M := by
    rw [← hexpM]; exact Real.exp_le_exp.mpr huℓ
  have hkey : Real.exp u * Real.exp (ℓ * (-(3:ℝ)/4)) ≤ 2 := by
    rw [← Real.exp_add]
    have hlog2 := Real.log_two_gt_d9
    have hle : u + ℓ * (-(3:ℝ)/4) ≤ Real.log 2 := by
      nlinarith [sq_nonneg (u - 2/3), husq]
    calc Real.exp (u + ℓ * (-(3:ℝ)/4)) ≤ Real.exp (Real.log 2) := Real.exp_le_exp.mpr hle
      _ = 2 := Real.exp_log (by norm_num)
  have hr1 : 1 ≤ M / Real.exp u := (one_le_div hY).mpr h3
  have hfl : ((⌊M / Real.exp u⌋₊ : ℕ) : ℝ) ≤ M / Real.exp u := Nat.floor_le (by linarith)
  have h2r : 2 * M / Real.exp u = 2 * (M / Real.exp u) := mul_div_assoc _ _ _
  refine ⟨?_, ?_, h3, ?_, h5, ?_, ?_, ?_, hfl⟩
  · exact Real.one_le_exp (by linarith)
  · rw [sq, ← Real.exp_add, add_halves]
  · rw [neg_div, Real.exp_neg]
  · rw [le_div_iff₀ hY, h5]
    have := mul_le_mul_of_nonneg_left hkey hMpos.le
    linarith
  · push_cast
    exact Nat.lt_floor_add_one _
  · rw [h2r]
    push_cast
    linarith

theorem kai_place_coord_lipschitz (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ A : ℝ, 1 ≤ A ∧
      (∀ (v : NumberField.InfinitePlace K) (z z' : Fin (Module.finrank ℚ K) → ℤ),
        |v ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)
          - v ((ω.equivFun.symm z' : NumberField.RingOfIntegers K) : K)|
          ≤ A * ∑ j, |((z j : ℤ) : ℝ) - ((z' j : ℤ) : ℝ)|) ∧
      (∀ (v : NumberField.InfinitePlace K) (hv : v.IsReal)
          (z z' : Fin (Module.finrank ℚ K) → ℤ),
        A * ∑ j, |((z j : ℤ) : ℝ) - ((z' j : ℤ) : ℝ)|
          < v ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) →
        0 < NumberField.InfinitePlace.embedding_of_isReal hv
              ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) *
            NumberField.InfinitePlace.embedding_of_isReal hv
              ((ω.equivFun.symm z' : NumberField.RingOfIntegers K) : K)) :=
by
  classical
  have hnn : ∀ (w : NumberField.InfinitePlace K) (x : K), 0 ≤ w x := fun w x => by
    rw [← NumberField.InfinitePlace.norm_embedding_eq]; exact norm_nonneg _
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ w : NumberField.InfinitePlace K,
      ∑ j, w ((ω j : NumberField.RingOfIntegers K) : K) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by
    rw [hS]; exact Finset.sum_nonneg fun w _ => Finset.sum_nonneg fun j _ => hnn w _
  have hle : ∀ (w : NumberField.InfinitePlace K) j,
      w ((ω j : NumberField.RingOfIntegers K) : K) ≤ 1 + S := by
    intro w j
    have h1 : w ((ω j : NumberField.RingOfIntegers K) : K)
        ≤ ∑ j', w ((ω j' : NumberField.RingOfIntegers K) : K) :=
      Finset.single_le_sum (f := fun j' => w ((ω j' : NumberField.RingOfIntegers K) : K))
        (fun j' _ => hnn w _) (Finset.mem_univ j)
    have h2 : ∑ j', w ((ω j' : NumberField.RingOfIntegers K) : K) ≤ S := by
      rw [hS]
      exact Finset.single_le_sum
        (f := fun w' => ∑ j', w' ((ω j' : NumberField.RingOfIntegers K) : K))
        (fun w' _ => by
          show 0 ≤ ∑ j', w' ((ω j' : NumberField.RingOfIntegers K) : K)
          exact Finset.sum_nonneg fun j' _ => hnn w' _) (Finset.mem_univ w)
    linarith
  have hcoe : ∀ y : Fin (Module.finrank ℚ K) → ℤ,
      ((ω.equivFun.symm y : NumberField.RingOfIntegers K) : K)
        = ∑ j, ((y j : ℤ) : K) * ((ω j : NumberField.RingOfIntegers K) : K) := by
    intro y
    rw [Module.Basis.equivFun_symm_apply]
    simp [NumberField.RingOfIntegers.coe_eq_algebraMap, map_sum, zsmul_eq_mul]
  have K1 : ∀ (v : NumberField.InfinitePlace K) (y : Fin (Module.finrank ℚ K) → ℤ),
      v ((ω.equivFun.symm y : NumberField.RingOfIntegers K) : K)
        ≤ (1 + S) * ∑ j, |((y j : ℤ) : ℝ)| := by
    intro v y
    rw [hcoe, ← NumberField.InfinitePlace.norm_embedding_eq, map_sum]
    refine (norm_sum_le _ _).trans ?_
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun j _ => ?_
    rw [map_mul, norm_mul, map_intCast, Complex.norm_intCast,
      NumberField.InfinitePlace.norm_embedding_eq]
    have := hle v j
    have := abs_nonneg ((y j : ℤ) : ℝ)
    nlinarith
  have hdiff : ∀ z z' : Fin (Module.finrank ℚ K) → ℤ,
      ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)
        - ((ω.equivFun.symm z' : NumberField.RingOfIntegers K) : K)
        = ((ω.equivFun.symm (z - z') : NumberField.RingOfIntegers K) : K) := by
    intro z z'
    rw [map_sub]
    simp [NumberField.RingOfIntegers.coe_eq_algebraMap]
  have hD : ∀ (v : NumberField.InfinitePlace K) (z z' : Fin (Module.finrank ℚ K) → ℤ),
      v (((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)
        - ((ω.equivFun.symm z' : NumberField.RingOfIntegers K) : K))
        ≤ (1 + S) * ∑ j, |((z j : ℤ) : ℝ) - ((z' j : ℤ) : ℝ)| := by
    intro v z z'
    rw [hdiff]
    refine (K1 v (z - z')).trans (le_of_eq ?_)
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    simp [Pi.sub_apply, Int.cast_sub]
  refine ⟨1 + S, by linarith, ?_, ?_⟩
  · intro v z z'
    rw [← NumberField.InfinitePlace.norm_embedding_eq v,
      ← NumberField.InfinitePlace.norm_embedding_eq v]
    refine (abs_norm_sub_norm_le _ _).trans ?_
    rw [← map_sub, NumberField.InfinitePlace.norm_embedding_eq]
    exact hD v z z'
  · intro v hv z z' h
    have hp := NumberField.InfinitePlace.norm_embedding_of_isReal hv
      ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)
    have hpq := NumberField.InfinitePlace.norm_embedding_of_isReal hv
      (((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)
        - ((ω.equivFun.symm z' : NumberField.RingOfIntegers K) : K))
    rw [map_sub, Real.norm_eq_abs] at hpq
    rw [Real.norm_eq_abs] at hp
    have h1 := hD v z z'
    have hδ : 0 ≤ (1 + S) * ∑ j, |((z j : ℤ) : ℝ) - ((z' j : ℤ) : ℝ)| :=
      mul_nonneg (by linarith) (Finset.sum_nonneg fun _ _ => abs_nonneg _)
    generalize NumberField.InfinitePlace.embedding_of_isReal hv
      ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) = p at *
    generalize NumberField.InfinitePlace.embedding_of_isReal hv
      ((ω.equivFun.symm z' : NumberField.RingOfIntegers K) : K) = q at *
    have h2 : |p - q| < |p| := by linarith
    have h3 : (p - q) ^ 2 < p ^ 2 := sq_lt_sq.mpr h2
    nlinarith [sq_nonneg q]

theorem kai_norm_rpow_regularity (K : Type u) [Field K] [NumberField K] :
    ∀ (β τ lam : ℝ) (x x' : NumberField.RingOfIntegers K),
      (1/2 : ℝ) ≤ β → β < 1 → 0 < lam → 0 ≤ τ → 2 * τ ≤ lam →
      (∀ v : NumberField.InfinitePlace K, lam ≤ v (x : K)) →
      (∀ v : NumberField.InfinitePlace K, lam ≤ v (x' : K)) →
      (∀ v : NumberField.InfinitePlace K, |v (x : K) - v (x' : K)| ≤ τ) →
      |((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1)
          - ((Algebra.norm ℤ x').natAbs : ℝ) ^ (β - 1)|
        ≤ (Module.finrank ℚ K : ℝ) * 2 ^ (Module.finrank ℚ K) * τ / lam :=
by
  intro β τ lam x x' hβ1 hβ2 hlam hτ h2τ hx hx' hxx'
  
  have hprod : ∀ y : NumberField.RingOfIntegers K,
      ((Algebra.norm ℤ y).natAbs : ℝ)
        = ∏ w : NumberField.InfinitePlace K, w (y : K) ^ w.mult := by
    intro y
    rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs,
      ← Algebra.coe_norm_int, Rat.cast_abs, Rat.cast_intCast]
  
  have hP1 : ∀ y : NumberField.RingOfIntegers K,
      (∀ v : NumberField.InfinitePlace K, lam ≤ v (y : K)) →
      (1 : ℝ) ≤ ((Algebra.norm ℤ y).natAbs : ℝ) := by
    intro y hy
    have hpos : (0 : ℝ) < ((Algebra.norm ℤ y).natAbs : ℝ) := by
      rw [hprod y]
      exact Finset.prod_pos (fun w _ => pow_pos (by linarith [hy w]) _)
    have h0 : 0 < (Algebra.norm ℤ y).natAbs := by exact_mod_cast hpos
    exact Nat.one_le_cast.mpr h0
  
  have hrpow : ∀ (γ A A' : ℝ), γ ≤ 0 → 1 ≤ A → 1 ≤ A' → A ≤ A' →
      |A ^ γ - A' ^ γ| ≤ (-γ) * (Real.log A' - Real.log A) := by
    intro γ A A' hγ hA hA' hAA'
    have ha : 0 ≤ Real.log A := Real.log_nonneg hA
    have haa : Real.log A ≤ Real.log A' := Real.log_le_log (by linarith) hAA'
    rw [Real.rpow_def_of_pos (by linarith), Real.rpow_def_of_pos (by linarith)]
    have hsplit : Real.exp (Real.log A' * γ)
        = Real.exp (Real.log A * γ) * Real.exp (γ * (Real.log A' - Real.log A)) := by
      rw [← Real.exp_add]; ring_nf
    rw [hsplit]
    have hu : γ * (Real.log A' - Real.log A) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hγ (by linarith)
    have he1 : Real.exp (γ * (Real.log A' - Real.log A)) ≤ 1 := Real.exp_le_one_iff.mpr hu
    have he2 := Real.add_one_le_exp (γ * (Real.log A' - Real.log A))
    have hE0 : 0 < Real.exp (Real.log A * γ) := Real.exp_pos _
    have hE1 : Real.exp (Real.log A * γ) ≤ 1 :=
      Real.exp_le_one_iff.mpr (mul_nonpos_of_nonneg_of_nonpos ha hγ)
    have hD : Real.exp (Real.log A * γ)
          - Real.exp (Real.log A * γ) * Real.exp (γ * (Real.log A' - Real.log A))
        = Real.exp (Real.log A * γ) * (1 - Real.exp (γ * (Real.log A' - Real.log A))) := by
      ring
    rw [hD, abs_of_nonneg (mul_nonneg hE0.le (by linarith))]
    calc Real.exp (Real.log A * γ) * (1 - Real.exp (γ * (Real.log A' - Real.log A)))
        ≤ 1 * (1 - Real.exp (γ * (Real.log A' - Real.log A))) :=
          mul_le_mul_of_nonneg_right hE1 (by linarith)
      _ ≤ (-γ) * (Real.log A' - Real.log A) := by linarith
  have hrpow2 : ∀ (γ A A' : ℝ), γ ≤ 0 → 1 ≤ A → 1 ≤ A' →
      |A ^ γ - A' ^ γ| ≤ (-γ) * |Real.log A - Real.log A'| := by
    intro γ A A' hγ hA hA'
    rcases le_total A A' with h | h
    · have h1 := hrpow γ A A' hγ hA hA' h
      have h2 : Real.log A ≤ Real.log A' := Real.log_le_log (by linarith) h
      rw [abs_sub_comm (Real.log A),
        abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.log A' - Real.log A)]
      exact h1
    · have h1 := hrpow γ A' A hγ hA' hA h
      have h2 : Real.log A' ≤ Real.log A := Real.log_le_log (by linarith) h
      rw [abs_sub_comm (A ^ γ), abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.log A - Real.log A')]
      exact h1
  
  have hlog1 : ∀ p q : ℝ, lam ≤ p → lam ≤ q → |p - q| ≤ τ →
      Real.log p - Real.log q ≤ τ / lam := by
    intro p q hp hq hpq
    have hp0 : 0 < p := by linarith
    have hq0 : 0 < q := by linarith
    rw [← Real.log_div hp0.ne' hq0.ne']
    have h1 := Real.log_le_sub_one_of_pos (div_pos hp0 hq0)
    have h2 : p / q - 1 = (p - q) / q := by field_simp
    have h3 : (p - q) / q ≤ τ / q :=
      div_le_div_of_nonneg_right (le_trans (le_abs_self _) hpq) hq0.le
    have h4 : τ / q ≤ τ / lam := div_le_div_of_nonneg_left hτ hlam hq
    linarith
  
  have hlogP : ∀ y : NumberField.RingOfIntegers K,
      (∀ v : NumberField.InfinitePlace K, lam ≤ v (y : K)) →
      Real.log ((Algebra.norm ℤ y).natAbs : ℝ)
        = ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (w (y : K)) := by
    intro y hy
    rw [hprod y, Real.log_prod (fun w _ => pow_ne_zero _ (by linarith [hy w]))]
    exact Finset.sum_congr rfl (fun w _ => Real.log_pow _ _)
  have hdiff : |Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
      - Real.log ((Algebra.norm ℤ x').natAbs : ℝ)|
        ≤ (Module.finrank ℚ K : ℝ) * (τ / lam) := by
    rw [hlogP x hx, hlogP x' hx', ← Finset.sum_sub_distrib]
    calc |∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * Real.log (w (x : K))
            - (w.mult : ℝ) * Real.log (w (x' : K)))|
        ≤ ∑ w : NumberField.InfinitePlace K, |(w.mult : ℝ) * Real.log (w (x : K))
            - (w.mult : ℝ) * Real.log (w (x' : K))| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (τ / lam) := by
          apply Finset.sum_le_sum
          intro w _
          rw [← mul_sub, abs_mul, Nat.abs_cast]
          apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
          rw [abs_le]
          constructor
          · have := hlog1 (w (x' : K)) (w (x : K)) (hx' w) (hx w)
              (by rw [abs_sub_comm]; exact hxx' w)
            linarith
          · exact hlog1 _ _ (hx w) (hx' w) (hxx' w)
      _ = (Module.finrank ℚ K : ℝ) * (τ / lam) := by
          rw [← Finset.sum_mul, ← Nat.cast_sum, NumberField.InfinitePlace.sum_mult_eq]
  have hA := hP1 x hx
  have hA' := hP1 x' hx'
  have hmain := hrpow2 (β - 1) _ _ (by linarith) hA hA'
  have hn : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) * (τ / lam) := by positivity
  have h2n : (1 : ℝ) ≤ 2 ^ (Module.finrank ℚ K) := one_le_pow₀ (by norm_num)
  calc |((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1)
          - ((Algebra.norm ℤ x').natAbs : ℝ) ^ (β - 1)|
      ≤ (-(β - 1)) * |Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
          - Real.log ((Algebra.norm ℤ x').natAbs : ℝ)| := hmain
    _ ≤ 1 * ((Module.finrank ℚ K : ℝ) * (τ / lam)) :=
        mul_le_mul (by linarith) hdiff (abs_nonneg _) (by norm_num)
    _ ≤ 2 ^ (Module.finrank ℚ K) * ((Module.finrank ℚ K : ℝ) * (τ / lam)) :=
        mul_le_mul_of_nonneg_right h2n hn
    _ = (Module.finrank ℚ K : ℝ) * 2 ^ (Module.finrank ℚ K) * τ / lam := by ring

theorem kai_small_place_count (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (M' : ℕ) (lam : ℝ), 0 ≤ lam →
      ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ∃ v : NumberField.InfinitePlace K,
            v ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) < lam)
          (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) M')).card : ℝ)
        ≤ A * (2 * (M' : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * (lam + 1) :=
by
  classical
  
  have strip : ∀ (m : ℕ) (r : Fin m → ℝ) (j₀ : Fin m), r j₀ ≠ 0 → ∀ (M' : ℕ) (lam : ℝ),
      0 ≤ lam →
      ((@Finset.filter (Fin m → ℤ) (fun z => |∑ j, ((z j : ℤ) : ℝ) * r j| < lam)
          (fun _ => Classical.propDecidable _) (intBox m M')).card : ℝ)
        ≤ (2 * (M' : ℝ) + 1) ^ (m - 1) * (4 * lam / |r j₀| + 1) := by
    intro m r j₀ hr M' lam hlam
    have ha : 0 < |r j₀| := abs_pos.mpr hr
    set S := @Finset.filter (Fin m → ℤ) (fun z => |∑ j, ((z j : ℤ) : ℝ) * r j| < lam)
          (fun _ => Classical.propDecidable _) (intBox m M') with hS
    set Kf : ℕ := ⌊2 * lam / |r j₀|⌋₊ with hKf
    let ρ : (Fin m → ℤ) → ({j : Fin m // j ≠ j₀} → ℤ) := fun z j => z j.1
    let P : Finset ({j : Fin m // j ≠ j₀} → ℤ) :=
      Fintype.piFinset (fun _ => Finset.Icc (-(M' : ℤ)) (M' : ℤ))
    have hmaps : ∀ z ∈ S, ρ z ∈ P := by
      intro z hz
      rw [hS, Finset.mem_filter] at hz
      have hb := hz.1
      simp only [intBox, Finset.mem_Icc, Pi.le_def] at hb
      simp only [P, ρ, Fintype.mem_piFinset, Finset.mem_Icc]
      exact fun j => ⟨hb.1 j.1, hb.2 j.1⟩
    have hfib : ∀ y ∈ P, (S.filter (fun z => ρ z = y)).card ≤ 2 * Kf + 1 := by
      intro y _
      by_cases hne : (S.filter (fun z => ρ z = y)).Nonempty
      · obtain ⟨z₁, hz₁⟩ := hne
        rw [Finset.mem_filter] at hz₁
        have key : ∀ z ∈ S.filter (fun z => ρ z = y),
            z j₀ ∈ Finset.Icc (z₁ j₀ - (Kf : ℤ)) (z₁ j₀ + (Kf : ℤ)) := by
          intro z hz
          rw [Finset.mem_filter] at hz
          have hoff : ∀ j, j ≠ j₀ → z j = z₁ j := by
            intro j hj
            have h1 := congrFun hz.2 ⟨j, hj⟩
            have h2 := congrFun hz₁.2 ⟨j, hj⟩
            simp only [ρ] at h1 h2
            rw [h1, h2]
          have hdiff : ∑ j, ((z j : ℤ) : ℝ) * r j - ∑ j, ((z₁ j : ℤ) : ℝ) * r j
              = (((z j₀ - z₁ j₀ : ℤ)) : ℝ) * r j₀ := by
            rw [← Finset.sum_sub_distrib, Finset.sum_eq_single j₀]
            · push_cast; ring
            · intro j _ hj; rw [hoff j hj]; ring
            · intro h; exact absurd (Finset.mem_univ _) h
          have hzS : |∑ j, ((z j : ℤ) : ℝ) * r j| < lam := (Finset.mem_filter.mp hz.1).2
          have hz₁S : |∑ j, ((z₁ j : ℤ) : ℝ) * r j| < lam := (Finset.mem_filter.mp hz₁.1).2
          have hlt : |(((z j₀ - z₁ j₀ : ℤ)) : ℝ)| * |r j₀| < 2 * lam := by
            rw [← abs_mul, ← hdiff]
            have := abs_sub (∑ j, ((z j : ℤ) : ℝ) * r j) (∑ j, ((z₁ j : ℤ) : ℝ) * r j)
            linarith
          have hle : ((z j₀ - z₁ j₀).natAbs : ℝ) ≤ 2 * lam / |r j₀| := by
            rw [le_div_iff₀ ha]
            have e : ((z j₀ - z₁ j₀).natAbs : ℝ) = |(((z j₀ - z₁ j₀ : ℤ)) : ℝ)| := by
              rw [Nat.cast_natAbs, Int.cast_abs]
            rw [e]; linarith
          have hK : (z j₀ - z₁ j₀).natAbs ≤ Kf := Nat.le_floor hle
          have hK' : |z j₀ - z₁ j₀| ≤ (Kf : ℤ) := by
            rw [Int.abs_eq_natAbs]; exact_mod_cast hK
          rw [Finset.mem_Icc]
          have := abs_le.mp hK'
          constructor <;> linarith [this.1, this.2]
        have hinj : Set.InjOn (fun z : Fin m → ℤ => z j₀)
            (S.filter (fun z => ρ z = y) : Set (Fin m → ℤ)) := by
          intro z hz z' hz' heq
          simp only [Finset.coe_filter, Set.mem_setOf_eq] at hz hz'
          funext j
          by_cases hj : j = j₀
          · subst hj; exact heq
          · have h1 := congrFun hz.2 ⟨j, hj⟩
            have h2 := congrFun hz'.2 ⟨j, hj⟩
            simp only [ρ] at h1 h2
            rw [h1, h2]
        have hc := Finset.card_le_card_of_injOn (fun z : Fin m → ℤ => z j₀)
          (t := Finset.Icc (z₁ j₀ - (Kf : ℤ)) (z₁ j₀ + (Kf : ℤ)))
          (fun z hz => Finset.mem_coe.mpr (key z (Finset.mem_coe.mp hz))) hinj
        rw [Int.card_Icc] at hc
        have e : z₁ j₀ + (Kf : ℤ) + 1 - (z₁ j₀ - (Kf : ℤ)) = ((2 * Kf + 1 : ℕ) : ℤ) := by
          push_cast; ring
        rw [e, Int.toNat_natCast] at hc
        exact hc
      · rw [Finset.not_nonempty_iff_eq_empty.mp hne]; simp
    have hcard := Finset.card_le_mul_card_image_of_maps_to hmaps (2 * Kf + 1) hfib
    have hP : P.card = (2 * M' + 1) ^ (m - 1) := by
      simp only [P, Fintype.card_piFinset, Int.card_Icc, Finset.prod_const, Finset.card_univ]
      have e1 : (M' : ℤ) + 1 - -(M' : ℤ) = ((2 * M' + 1 : ℕ) : ℤ) := by push_cast; ring
      rw [e1, Int.toNat_natCast]
      congr 1
      rw [Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_subtype_eq]
    rw [hP] at hcard
    have hKfle : (Kf : ℝ) ≤ 2 * lam / |r j₀| := Nat.floor_le (div_nonneg (by linarith) ha.le)
    have hcardR : (S.card : ℝ) ≤ (2 * (Kf : ℝ) + 1) * (2 * (M' : ℝ) + 1) ^ (m - 1) := by
      exact_mod_cast hcard
    have hX0 : 0 ≤ (2 * (M' : ℝ) + 1) ^ (m - 1) := by positivity
    have h4 : 2 * (Kf : ℝ) + 1 ≤ 4 * lam / |r j₀| + 1 := by
      have e : 4 * lam / |r j₀| = 2 * (2 * lam / |r j₀|) := by ring
      rw [e]; linarith
    calc (S.card : ℝ) ≤ (2 * (Kf : ℝ) + 1) * (2 * (M' : ℝ) + 1) ^ (m - 1) := hcardR
      _ ≤ (4 * lam / |r j₀| + 1) * (2 * (M' : ℝ) + 1) ^ (m - 1) :=
          mul_le_mul_of_nonneg_right h4 hX0
      _ = (2 * (M' : ℝ) + 1) ^ (m - 1) * (4 * lam / |r j₀| + 1) := by ring
  
  have realform : ∀ v : NumberField.InfinitePlace K,
      ∃ (r : Fin (Module.finrank ℚ K) → ℝ) (j₀ : Fin (Module.finrank ℚ K)), r j₀ ≠ 0 ∧
        ∀ z : Fin (Module.finrank ℚ K) → ℤ,
          |∑ j, ((z j : ℤ) : ℝ) * r j|
            ≤ v ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) := by
    intro v
    let r : Fin (Module.finrank ℚ K) → ℝ :=
      fun j => (v.embedding ((ω j : NumberField.RingOfIntegers K) : K)).re
    have hid : ∀ z : Fin (Module.finrank ℚ K) → ℤ, ∑ j, ((z j : ℤ) : ℝ) * r j
        = (v.embedding ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)).re := by
      intro z
      rw [Module.Basis.equivFun_symm_apply]
      have hc : (((∑ j, z j • ω j : NumberField.RingOfIntegers K)) : K)
          = ∑ j, (z j : K) * ((ω j : NumberField.RingOfIntegers K) : K) := by
        push_cast [zsmul_eq_mul]
        rfl
      rw [hc, map_sum, Complex.re_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, map_intCast, Complex.mul_re, Complex.intCast_re, Complex.intCast_im]
      simp [r]
    obtain ⟨j₀, hj₀⟩ : ∃ j₀, r j₀ ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      have h1 := hid (ω.equivFun 1)
      rw [LinearEquiv.symm_apply_apply] at h1
      simp [hcon] at h1
    refine ⟨r, j₀, hj₀, fun z => ?_⟩
    rw [hid z]
    calc |(v.embedding ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)).re|
        ≤ ‖v.embedding ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)‖ :=
          Complex.abs_re_le_norm _
      _ = _ := NumberField.InfinitePlace.norm_embedding_eq v _
  
  choose r j₀ hr hle using realform
  have hsum0 : 0 ≤ ∑ v, (4 / |r v (j₀ v)| + 1) :=
    Finset.sum_nonneg (fun v _ => by positivity)
  refine ⟨1 + ∑ v, (4 / |r v (j₀ v)| + 1), by linarith, ?_⟩
  intro M' lam hlam
  let S : NumberField.InfinitePlace K → Finset (Fin (Module.finrank ℚ K) → ℤ) := fun v =>
    @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
      (fun z => |∑ j, ((z j : ℤ) : ℝ) * r v j| < lam)
      (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) M')
  have hsub : (@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ∃ v : NumberField.InfinitePlace K,
            v ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) < lam)
          (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) M'))
        ⊆ Finset.univ.biUnion S := by
    intro z hz
    replace hz := (@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hz
    obtain ⟨v, hv⟩ := hz.2
    rw [Finset.mem_biUnion]
    exact ⟨v, Finset.mem_univ _, Finset.mem_filter.mpr ⟨hz.1, lt_of_le_of_lt (hle v z) hv⟩⟩
  have h1 := (Finset.card_le_card hsub).trans (Finset.card_biUnion_le (s := Finset.univ) (t := S))
  have h3 : ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ∃ v : NumberField.InfinitePlace K,
            v ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) < lam)
          (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) M')).card : ℝ)
        ≤ ∑ v, ((S v).card : ℝ) := by
    rw [← Nat.cast_sum]; exact_mod_cast h1
  have hX0 : 0 ≤ (2 * (M' : ℝ) + 1) ^ (Module.finrank ℚ K - 1) := by positivity
  have h4 : ∀ v, ((S v).card : ℝ)
      ≤ (4 / |r v (j₀ v)| + 1) * ((2 * (M' : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * (lam + 1)) := by
    intro v
    have hs := strip (Module.finrank ℚ K) (r v) (j₀ v) (hr v) M' lam hlam
    have ha : 0 < |r v (j₀ v)| := abs_pos.mpr (hr v)
    have hineq : 4 * lam / |r v (j₀ v)| + 1 ≤ (4 / |r v (j₀ v)| + 1) * (lam + 1) := by
      have e : (4 / |r v (j₀ v)| + 1) * (lam + 1)
          = 4 * lam / |r v (j₀ v)| + 1 + (4 / |r v (j₀ v)| + lam) := by ring
      have : 0 ≤ 4 / |r v (j₀ v)| := by positivity
      linarith
    calc ((S v).card : ℝ)
        ≤ (2 * (M' : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * (4 * lam / |r v (j₀ v)| + 1) := hs
      _ ≤ (2 * (M' : ℝ) + 1) ^ (Module.finrank ℚ K - 1)
            * ((4 / |r v (j₀ v)| + 1) * (lam + 1)) := mul_le_mul_of_nonneg_left hineq hX0
      _ = _ := by ring
  have h5 := Finset.sum_le_sum (fun v (_ : v ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)))
    => h4 v)
  rw [← Finset.sum_mul] at h5
  have hQ : 0 ≤ (2 * (M' : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * (lam + 1) := by positivity
  calc _ ≤ _ := h3.trans h5
    _ ≤ (1 + ∑ v, (4 / |r v (j₀ v)| + 1))
          * ((2 * (M' : ℝ) + 1) ^ (Module.finrank ℚ K - 1) * (lam + 1)) := by nlinarith
    _ = _ := by ring

theorem kai_cube_piecewise_bound (n : ℕ) {κ : Type*} [DecidableEq κ]
    (M' s : ℕ) (hs : 1 ≤ s) (D : Finset (Fin n → ℤ)) (hD : D ⊆ intBox n M')
    (cls : (Fin n → ℤ) → κ) (h w : (Fin n → ℤ) → ℝ) (H ε E : ℝ)
    (Bad₁ Bad₂ : (Fin n → ℤ) → Prop) [DecidablePred Bad₂]
    (hH : 0 ≤ H) (hε : 0 ≤ ε) (hE : 0 ≤ E)
    (hh : ∀ z ∈ D, |h z| ≤ H) (hw : ∀ z ∈ D, |w z| ≤ 1)
    (hbad : ∀ z ∈ D, ∀ z' ∈ D, (fun j => z j / (s : ℤ)) = (fun j => z' j / (s : ℤ)) →
      Bad₁ z → Bad₂ z')
    (hreg : ∀ z ∈ D, ∀ z' ∈ D, (fun j => z j / (s : ℤ)) = (fun j => z' j / (s : ℤ)) →
      cls z = cls z' → ¬ Bad₁ z → ¬ Bad₁ z' → |w z - w z'| ≤ ε)
    (hpiece : ∀ (k z₀ : Fin n → ℤ), z₀ ∈ D →
      |∑ z ∈ @Finset.filter (Fin n → ℤ)
            (fun z => (fun j => z j / (s : ℤ)) = k ∧ cls z = cls z₀)
            (fun _ => Classical.propDecidable _) D, h z| ≤ E) :
    |∑ z ∈ D, w z * h z|
      ≤ (2 * (M' : ℝ) / (s : ℝ) + 2) ^ n * ((D.image cls).card : ℝ) * E
        + ε * H * (D.card : ℝ) + H * ((D.filter Bad₂).card : ℝ) :=
by
  have hsZ : (0 : ℤ) < (s : ℤ) := by exact_mod_cast hs
  have hsR : (0 : ℝ) < (s : ℝ) := by exact_mod_cast hs
  
  have hI : ((D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))).card : ℝ)
      ≤ (2 * (M' : ℝ) / (s : ℝ) + 2) ^ n := by
    obtain ⟨p, hp⟩ : ∃ p : ℤ, p = (-(M' : ℤ)) / (s : ℤ) := ⟨_, rfl⟩
    obtain ⟨q, hq⟩ : ∃ q : ℤ, q = (M' : ℤ) / (s : ℤ) := ⟨_, rfl⟩
    have hsub : D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ)) ⊆
        Fintype.piFinset (fun _ : Fin n => Finset.Icc p q) := by
      intro k hk
      rw [Finset.mem_image] at hk
      obtain ⟨z, hz, rfl⟩ := hk
      have hz' := hD hz
      unfold intBox at hz'
      rw [Finset.mem_Icc] at hz'
      rw [Fintype.mem_piFinset]
      intro j
      rw [Finset.mem_Icc, hp, hq]
      exact ⟨Int.ediv_le_ediv hsZ (hz'.1 j), Int.ediv_le_ediv hsZ (hz'.2 j)⟩
    have hcard := Finset.card_le_card hsub
    rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      Int.card_Icc] at hcard
    have hpq : p ≤ q := by rw [hp, hq]; exact Int.ediv_le_ediv hsZ (by omega)
    have h1 : q * (s : ℤ) ≤ (M' : ℤ) := by rw [hq]; exact Int.ediv_mul_le _ hsZ.ne'
    have h2 : -(M' : ℤ) < (p + 1) * (s : ℤ) := by rw [hp]; exact Int.lt_ediv_add_one_mul_self _ hsZ
    have h3 : (q - p - 1) * (s : ℤ) < 2 * (M' : ℤ) := by
      have e : (q - p - 1) * (s : ℤ) = q * (s : ℤ) - (p + 1) * (s : ℤ) := by ring
      rw [e]; linarith
    have h4 : ((q - p - 1 : ℤ) : ℝ) * (s : ℝ) < 2 * (M' : ℝ) := by exact_mod_cast h3
    have h5 : ((q - p - 1 : ℤ) : ℝ) < 2 * (M' : ℝ) / (s : ℝ) := by
      rw [lt_div_iff₀ hsR]; exact h4
    have hlen : ((q + 1 - p : ℤ) : ℝ) ≤ 2 * (M' : ℝ) / (s : ℝ) + 2 := by
      push_cast at h5 ⊢; linarith
    have hnn : (0 : ℤ) ≤ q + 1 - p := by omega
    calc ((D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))).card : ℝ)
        ≤ (((q + 1 - p).toNat ^ n : ℕ) : ℝ) := by exact_mod_cast hcard
      _ = ((q + 1 - p : ℤ) : ℝ) ^ n := by
          rw [Nat.cast_pow, ← Int.cast_natCast, Int.toNat_of_nonneg hnn]
      _ ≤ (2 * (M' : ℝ) / (s : ℝ) + 2) ^ n :=
          pow_le_pow_left₀ (by exact_mod_cast hnn) hlen n
  
  have piece : ∀ P : Finset (Fin n → ℤ), P ⊆ D →
      (∀ z ∈ P, ∀ z' ∈ P, Bad₁ z → Bad₂ z') →
      (∀ z ∈ P, ∀ z' ∈ P, ¬ Bad₁ z → ¬ Bad₁ z' → |w z - w z'| ≤ ε) →
      |∑ z ∈ P, h z| ≤ E →
      |∑ z ∈ P, w z * h z| ≤ E + ε * H * (P.card : ℝ) + H * ((P.filter Bad₂).card : ℝ) := by
    intro P hPD hb hr hsum
    have hR0 : 0 ≤ ε * H * (P.card : ℝ) := by positivity
    have hR1 : 0 ≤ H * ((P.filter Bad₂).card : ℝ) := by positivity
    by_cases hA : ∃ z₁ ∈ P, Bad₁ z₁
    · obtain ⟨z₁, hz₁, hb₁⟩ := hA
      have hfilt : P.filter Bad₂ = P :=
        Finset.filter_true_of_mem (fun z hz => hb z₁ hz₁ z hz hb₁)
      have hle : |∑ z ∈ P, w z * h z| ≤ H * (P.card : ℝ) := by
        calc |∑ z ∈ P, w z * h z| ≤ ∑ z ∈ P, |w z * h z| := Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ z ∈ P, H := by
              apply Finset.sum_le_sum
              intro z hz
              rw [abs_mul]
              calc |w z| * |h z| ≤ 1 * H :=
                    mul_le_mul (hw z (hPD hz)) (hh z (hPD hz)) (abs_nonneg _) zero_le_one
                _ = H := one_mul H
          _ = H * (P.card : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
      rw [hfilt]; linarith
    · push_neg at hA
      rcases P.eq_empty_or_nonempty with hP | ⟨z₀, hz₀⟩
      · have h0 : ∑ z ∈ P, w z * h z = 0 := by rw [hP, Finset.sum_empty]
        rw [h0, abs_zero]; linarith
      · have hid : ∑ z ∈ P, w z * h z
            = w z₀ * ∑ z ∈ P, h z + ∑ z ∈ P, (w z - w z₀) * h z := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl (fun z _ => by ring)
        have e1 : |w z₀ * ∑ z ∈ P, h z| ≤ E := by
          rw [abs_mul]
          calc |w z₀| * |∑ z ∈ P, h z| ≤ 1 * E :=
                mul_le_mul (hw z₀ (hPD hz₀)) hsum (abs_nonneg _) zero_le_one
            _ = E := one_mul E
        have e2 : |∑ z ∈ P, (w z - w z₀) * h z| ≤ ε * H * (P.card : ℝ) := by
          calc |∑ z ∈ P, (w z - w z₀) * h z| ≤ ∑ z ∈ P, |(w z - w z₀) * h z| :=
                Finset.abs_sum_le_sum_abs _ _
            _ ≤ ∑ z ∈ P, ε * H := by
                apply Finset.sum_le_sum
                intro z hz
                rw [abs_mul]
                exact mul_le_mul (hr z hz z₀ hz₀ (hA z hz) (hA z₀ hz₀)) (hh z (hPD hz))
                  (abs_nonneg _) hε
            _ = ε * H * (P.card : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
        rw [hid]
        have := abs_add_le (w z₀ * ∑ z ∈ P, h z) (∑ z ∈ P, (w z - w z₀) * h z)
        linarith
  
  obtain ⟨key, hkey⟩ : ∃ key : (Fin n → ℤ) → (Fin n → ℤ) × κ,
      key = fun z => ((fun j => z j / (s : ℤ)), cls z) := ⟨_, rfl⟩
  have hmaps : ∀ z ∈ D, key z ∈
      (D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls) := by
    intro z hz
    rw [hkey, Finset.mem_product]
    exact ⟨Finset.mem_image_of_mem _ hz, Finset.mem_image_of_mem _ hz⟩
  have hD_card := Finset.card_eq_sum_card_fiberwise hmaps
  have hB_card := Finset.card_eq_sum_card_fiberwise (s := D.filter Bad₂)
    (t := (D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls)) (f := key)
    (fun z hz => hmaps z (Finset.filter_subset _ _ hz))
  have hB_card' : (D.filter Bad₂).card
      = ∑ p ∈ (D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls),
          ((D.filter (fun z => key z = p)).filter Bad₂).card := by
    rw [hB_card]
    exact Finset.sum_congr rfl (fun p _ => by rw [Finset.filter_comm])
  
  have hper : ∀ p ∈ (D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls),
      |∑ z ∈ D.filter (fun z => key z = p), w z * h z|
        ≤ E + ε * H * ((D.filter (fun z => key z = p)).card : ℝ)
          + H * (((D.filter (fun z => key z = p)).filter Bad₂).card : ℝ) := by
    intro p _
    obtain ⟨k, c⟩ := p
    apply piece
    · exact Finset.filter_subset _ _
    · intro z hz z' hz' hb1
      rw [Finset.mem_filter] at hz hz'
      have e1 : key z = (k, c) := hz.2
      have e2 : key z' = (k, c) := hz'.2
      simp only [hkey, Prod.mk.injEq] at e1 e2
      exact hbad z hz.1 z' hz'.1 (e1.1.trans e2.1.symm) hb1
    · intro z hz z' hz' hn hn'
      rw [Finset.mem_filter] at hz hz'
      have e1 : key z = (k, c) := hz.2
      have e2 : key z' = (k, c) := hz'.2
      simp only [hkey, Prod.mk.injEq] at e1 e2
      exact hreg z hz.1 z' hz'.1 (e1.1.trans e2.1.symm) (e1.2.trans e2.2.symm) hn hn'
    · rcases (D.filter (fun z => key z = (k, c))).eq_empty_or_nonempty with hP | ⟨z₀, hz₀⟩
      · rw [hP, Finset.sum_empty, abs_zero]; exact hE
      · rw [Finset.mem_filter] at hz₀
        have e0 : key z₀ = (k, c) := hz₀.2
        simp only [hkey, Prod.mk.injEq] at e0
        have hset : D.filter (fun z => key z = (k, c))
            = @Finset.filter (Fin n → ℤ)
                (fun z => (fun j => z j / (s : ℤ)) = k ∧ cls z = cls z₀)
                (fun _ => Classical.propDecidable _) D := by
          ext z
          simp only [Finset.mem_filter, hkey, Prod.mk.injEq, e0.2]
        rw [hset]
        exact hpiece k z₀ hz₀.1
  
  calc |∑ z ∈ D, w z * h z|
      = |∑ p ∈ (D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls),
          ∑ z ∈ D.filter (fun z => key z = p), w z * h z| := by
        rw [Finset.sum_fiberwise_of_maps_to hmaps]
    _ ≤ ∑ p ∈ (D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls),
          |∑ z ∈ D.filter (fun z => key z = p), w z * h z| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ (D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls),
          (E + ε * H * ((D.filter (fun z => key z = p)).card : ℝ)
            + H * (((D.filter (fun z => key z = p)).filter Bad₂).card : ℝ)) :=
        Finset.sum_le_sum hper
    _ = (((D.image (fun z : Fin n → ℤ => fun j => z j / (s : ℤ))) ×ˢ (D.image cls)).card : ℝ)
          * E + ε * H * (D.card : ℝ) + H * ((D.filter Bad₂).card : ℝ) := by
        rw [hD_card, hB_card']
        push_cast
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul,
          Finset.mul_sum, Finset.mul_sum]
    _ ≤ (2 * (M' : ℝ) / (s : ℝ) + 2) ^ n * ((D.image cls).card : ℝ) * E
          + ε * H * (D.card : ℝ) + H * ((D.filter Bad₂).card : ℝ) := by
        rw [Finset.card_product, Nat.cast_mul]
        have h1 := mul_le_mul_of_nonneg_right hI (Nat.cast_nonneg (α := ℝ) (D.image cls).card)
        have h2 := mul_le_mul_of_nonneg_right h1 hE
        linarith

theorem kai_cube_piece_sieve_bound (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M : ℝ) (M' s : ℕ) (hs : 1 ≤ s) (hsM : ((s - 1 : ℕ) : ℝ) ≤ 2 * M + 2)
    (𝔮 𝔮D : Ideal (NumberField.RingOfIntegers K))
    (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)) (hΩm : MeasurableSet Ω) (hΩc : Convex ℝ Ω)
    (a : NumberField.RingOfIntegers K) (ha : IsCoprime (Ideal.span {a}) 𝔮)
    (h : NumberField.RingOfIntegers K → ℝ) (G η : ℝ) (hG : 0 ≤ G) (hη : 0 ≤ η)
    (hyp : ∀ (b : NumberField.RingOfIntegers K), IsCoprime (Ideal.span {b}) (𝔮 ⊓ 𝔮D) →
        ∀ (u : Fin (Module.finrank ℚ K) → ℤ) (L : ℕ), (L : ℝ) ≤ 2 * M + 2 →
        ∀ (R : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet R → Convex ℝ R →
          R ⊆ {x | ∀ j, (u j : ℝ) ≤ x j ∧ x j ≤ (u j : ℝ) + L} →
          |∑ z ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
                (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ ω.equivFun.symm z - b ∈ 𝔮 ⊓ 𝔮D)
                (fun _ => Classical.propDecidable _) (Finset.Icc u (u + fun _ => (L : ℤ))),
              h (ω.equivFun.symm z)|
            ≤ G * (M ^ ((1:ℝ)/4) * ((L : ℝ) + M ^ ((1:ℝ)/4)) ^ (Module.finrank ℚ K - 1)
                  + (MeasureTheory.volume R).toReal * η))
    (k z₀ : Fin (Module.finrank ℚ K) → ℤ)
    (hz₀ : z₀ ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
        (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ ω.equivFun.symm z - a ∈ 𝔮 ∧
          IsCoprime (Ideal.span {ω.equivFun.symm z}) 𝔮D)
        (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) M')) :
    |∑ z ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => (fun j => z j / (s : ℤ)) = k ∧
            Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) (ω.equivFun.symm z)
              = Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) (ω.equivFun.symm z₀))
          (fun _ => Classical.propDecidable _)
          (@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
            (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ ω.equivFun.symm z - a ∈ 𝔮 ∧
              IsCoprime (Ideal.span {ω.equivFun.symm z}) 𝔮D)
            (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) M')),
        h (ω.equivFun.symm z)|
      ≤ G * (M ^ ((1:ℝ)/4) * (((s - 1 : ℕ) : ℝ) + M ^ ((1:ℝ)/4)) ^ (Module.finrank ℚ K - 1)
            + ((s - 1 : ℕ) : ℝ) ^ (Module.finrank ℚ K) * η) :=
by
  have hmem : ∀ (p : (Fin (Module.finrank ℚ K) → ℤ) → Prop) (inst : DecidablePred p)
      (S : Finset (Fin (Module.finrank ℚ K) → ℤ)) (x : Fin (Module.finrank ℚ K) → ℤ),
      x ∈ @Finset.filter _ p inst S ↔ x ∈ S ∧ p x :=
    fun p inst S x => @Finset.mem_filter _ p inst S x
  obtain ⟨hz₀box, hz₀Ω, hz₀a, hz₀D⟩ := (hmem _ _ _ _).mp hz₀ |> fun h =>
    (⟨h.1, h.2.1, h.2.2.1, h.2.2.2⟩ : z₀ ∈ intBox (Module.finrank ℚ K) M' ∧
      (fun j => ((z₀ j : ℤ) : ℝ)) ∈ Ω ∧ ω.equivFun.symm z₀ - a ∈ 𝔮 ∧
      IsCoprime (Ideal.span {ω.equivFun.symm z₀}) 𝔮D)
  
  have hcop_sub : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (x y : NumberField.RingOfIntegers K),
      IsCoprime (Ideal.span {x}) I → y - x ∈ I → IsCoprime (Ideal.span {y}) I := by
    intro I x y hx hxy
    rw [Ideal.isCoprime_iff_sup_eq] at hx ⊢
    rw [eq_top_iff, ← hx]
    refine sup_le ?_ le_sup_right
    rw [Ideal.span_singleton_le_iff_mem]
    have h1 : y ∈ Ideal.span {y} ⊔ I := Ideal.mem_sup_left (Ideal.mem_span_singleton_self y)
    have h2 : y - x ∈ Ideal.span {y} ⊔ I := Ideal.mem_sup_right hxy
    have h3 := Ideal.sub_mem _ h1 h2
    rwa [sub_sub_cancel] at h3
  have hb𝔮 : IsCoprime (Ideal.span {ω.equivFun.symm z₀}) 𝔮 := hcop_sub 𝔮 a _ ha hz₀a
  have hb : IsCoprime (Ideal.span {ω.equivFun.symm z₀}) (𝔮 ⊓ 𝔮D) := by
    have h1 := IsCoprime.mul_right hb𝔮 hz₀D
    rw [Ideal.isCoprime_iff_sup_eq] at h1 ⊢
    rw [eq_top_iff, ← h1]
    exact sup_le_sup_left Ideal.mul_le_inf _
  
  have hs0 : (0:ℤ) < (s:ℤ) := by exact_mod_cast hs
  have hwin : ∀ x q : ℤ, x / (s:ℤ) = q ↔
      (s:ℤ) * q ≤ x ∧ x ≤ (s:ℤ) * q + ((s - 1 : ℕ) : ℤ) := by
    intro x q
    rw [Int.ediv_eq_iff_of_pos hs0]
    have e1 : ((s - 1 : ℕ) : ℤ) = (s:ℤ) - 1 := by omega
    rw [e1, mul_comm q]
    generalize (s:ℤ) * q = t
    constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> omega
  
  have hbox : ∀ z : Fin (Module.finrank ℚ K) → ℤ, z ∈ intBox (Module.finrank ℚ K) M' ↔
      ∀ j, -(M':ℤ) ≤ z j ∧ z j ≤ (M':ℤ) := by
    intro z
    simp [intBox, Pi.le_def, forall_and]
  
  let u : Fin (Module.finrank ℚ K) → ℤ := fun j => (s : ℤ) * k j
  let R : Set (Fin (Module.finrank ℚ K) → ℝ) :=
    Ω ∩ Set.Icc (fun _ => -(M' : ℝ)) (fun _ => (M' : ℝ)) ∩
      Set.Icc (fun j => ((u j : ℤ) : ℝ)) (fun j => ((u j : ℤ) : ℝ) + ((s - 1 : ℕ) : ℝ))
  have hRm : MeasurableSet R := (hΩm.inter measurableSet_Icc).inter measurableSet_Icc
  have hRc : Convex ℝ R := (hΩc.inter (convex_Icc _ _)).inter (convex_Icc _ _)
  have hRsub : R ⊆ {x | ∀ j, (u j : ℝ) ≤ x j ∧ x j ≤ (u j : ℝ) + ((s - 1 : ℕ) : ℝ)} := by
    intro x hx j
    exact ⟨hx.2.1 j, hx.2.2 j⟩
  have hvol : (MeasureTheory.volume R).toReal ≤ ((s - 1 : ℕ) : ℝ) ^ (Module.finrank ℚ K) := by
    have hle : (fun j => ((u j : ℤ) : ℝ)) ≤ (fun j => ((u j : ℤ) : ℝ) + ((s - 1 : ℕ) : ℝ)) :=
      fun j => le_add_of_nonneg_right (Nat.cast_nonneg _)
    calc (MeasureTheory.volume R).toReal
        ≤ (MeasureTheory.volume (Set.Icc (fun j => ((u j : ℤ) : ℝ))
            (fun j => ((u j : ℤ) : ℝ) + ((s - 1 : ℕ) : ℝ)))).toReal := by
          apply ENNReal.toReal_mono
          · rw [Real.volume_Icc_pi]
            exact ENNReal.prod_ne_top (fun _ _ => ENNReal.ofReal_ne_top)
          · exact MeasureTheory.measure_mono Set.inter_subset_right
      _ = ((s - 1 : ℕ) : ℝ) ^ (Module.finrank ℚ K) := by
          rw [Real.volume_Icc_pi_toReal hle]
          simp only [add_sub_cancel_left, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  have H := hyp (ω.equivFun.symm z₀) hb u (s - 1) hsM R hRm hRc hRsub
  refine le_trans (le_of_eq ?_) (H.trans ?_)
  · refine congrArg abs (Finset.sum_congr ?_ (fun _ _ => rfl))
    ext z
    rw [hmem, hmem, hmem, Finset.mem_Icc]
    constructor
    · rintro ⟨⟨hzbox, hzΩ, hza, hzD⟩, hzk, hzq⟩
      have hq : ω.equivFun.symm z - ω.equivFun.symm z₀ ∈ 𝔮 ⊓ 𝔮D := Ideal.Quotient.eq.mp hzq
      have hw : ∀ j, (s:ℤ) * k j ≤ z j ∧ z j ≤ (s:ℤ) * k j + ((s - 1 : ℕ) : ℤ) := fun j =>
        (hwin (z j) (k j)).mp (congrFun hzk j)
      have hb' := (hbox z).mp hzbox
      refine ⟨⟨fun j => (hw j).1, fun j => (hw j).2⟩, ⟨⟨hzΩ, fun j => ?_, fun j => ?_⟩,
        fun j => ?_, fun j => ?_⟩, hq⟩
      · show -(M':ℝ) ≤ ((z j : ℤ) : ℝ)
        exact_mod_cast (hb' j).1
      · show ((z j : ℤ) : ℝ) ≤ (M':ℝ)
        exact_mod_cast (hb' j).2
      · show (((s:ℤ) * k j : ℤ) : ℝ) ≤ ((z j : ℤ) : ℝ)
        exact_mod_cast (hw j).1
      · show ((z j : ℤ) : ℝ) ≤ (((s:ℤ) * k j : ℤ) : ℝ) + ((s - 1 : ℕ) : ℝ)
        have := (hw j).2
        exact_mod_cast this
    · rintro ⟨⟨hzu1, hzu2⟩, ⟨⟨hzΩ, hzM1, hzM2⟩, hzc1, hzc2⟩, hq⟩
      have hw : ∀ j, (s:ℤ) * k j ≤ z j ∧ z j ≤ (s:ℤ) * k j + ((s - 1 : ℕ) : ℤ) :=
        fun j => ⟨hzu1 j, hzu2 j⟩
      refine ⟨⟨?_, hzΩ, ?_, ?_⟩, ?_, Ideal.Quotient.eq.mpr hq⟩
      · refine (hbox z).mpr (fun j => ⟨?_, ?_⟩)
        · have h1 : -(M':ℝ) ≤ ((z j : ℤ) : ℝ) := hzM1 j
          exact_mod_cast h1
        · have h1 : ((z j : ℤ) : ℝ) ≤ (M':ℝ) := hzM2 j
          exact_mod_cast h1
      · have e : ω.equivFun.symm z - a
            = (ω.equivFun.symm z - ω.equivFun.symm z₀) + (ω.equivFun.symm z₀ - a) := by ring
        rw [e]
        exact Ideal.add_mem _ (Submodule.mem_inf.mp hq).1 hz₀a
      · exact hcop_sub 𝔮D _ _ hz₀D (Submodule.mem_inf.mp hq).2
      · funext j
        exact (hwin (z j) (k j)).mpr (hw j)
  · gcongr

theorem kai_siegel_cube_reduction (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C' : ℝ, 0 ≤ C' ∧
      ∀ (M : ℝ), 3 ≤ M →
      ∀ (𝔮 𝔮D : Ideal (NumberField.RingOfIntegers K)) (ψ : NumberField.RingOfIntegers K → ℤ)
        (β : ℝ), 𝔮 ≠ ⊥ → 𝔮D ≠ ⊥ → IsRealRayChar 𝔮D ψ → (1/2 : ℝ) ≤ β → β < 1 →
      ∀ (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet Ω → Convex ℝ Ω →
      ∀ (a : NumberField.RingOfIntegers K), IsCoprime (Ideal.span {a}) 𝔮 →
      ∀ (h : NumberField.RingOfIntegers K → ℝ) (G H η : ℝ), 0 ≤ G → 0 ≤ H → 0 ≤ η →
        (∀ x, |h x| ≤ H) →
        (∀ (b : NumberField.RingOfIntegers K), IsCoprime (Ideal.span {b}) (𝔮 ⊓ 𝔮D) →
          ∀ (u : Fin (Module.finrank ℚ K) → ℤ) (L : ℕ), (L : ℝ) ≤ 2 * M + 2 →
          ∀ (R : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet R → Convex ℝ R →
            R ⊆ {x | ∀ j, (u j : ℝ) ≤ x j ∧ x j ≤ (u j : ℝ) + L} →
            |∑ z ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
                  (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ ω.equivFun.symm z - b ∈ 𝔮 ⊓ 𝔮D)
                  (fun _ => Classical.propDecidable _) (Finset.Icc u (u + fun _ => (L : ℤ))),
                h (ω.equivFun.symm z)|
              ≤ G * (M ^ ((1:ℝ)/4) * ((L : ℝ) + M ^ ((1:ℝ)/4)) ^ (Module.finrank ℚ K - 1)
                    + (MeasureTheory.volume R).toReal * η)) →
        |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
              (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧ x - a ∈ 𝔮)
              (fun _ => Classical.propDecidable _) (omegaBox ω M),
            (ψ x : ℝ) * (((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1)) * h x|
          ≤ C' * ((omegaBox ω M).card : ℝ)
              * (G * (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ)
                    * (Real.exp (Real.log M ^ ((1:ℝ)/2)) * M ^ (-(3:ℝ)/4) + η)
