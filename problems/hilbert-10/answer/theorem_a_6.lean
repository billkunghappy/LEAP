  have coeff : ∀ (V : ℝ → ℝ) (w : ℤ → ℝ), (∀ d, 0 ≤ w d ∧ w d ≤ 1) →
      (∀ s, ((V s : ℝ) : ℂ)
        = ∑ d ∈ Finset.Icc (-(K : ℤ)) (K : ℤ), (w d : ℂ) * giE ((d : ℝ) * s)) →
      ∃ c : (Fin a → ℤ) → ℂ, (∀ m, ‖c m‖ ≤ B₀) ∧ ∀ x : Fin a → ℝ,
        ∑ j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)),
            G (fun i => (j i : ℝ) / ((K + 1 : ℕ) : ℝ)) *
              ((∏ i, V (x i - (j i : ℝ) / ((K + 1 : ℕ) : ℝ)) : ℝ) : ℂ) / ((K + 1 : ℕ) : ℂ) ^ a
          = ∑ m ∈ Finset.Icc (fun _ => -(K : ℤ)) (fun _ => (K : ℤ)),
              c m * giE (∑ i, (m i : ℝ) * x i) := by
    intro V w hw hV
    have hNpos : (0 : ℝ) < ((K + 1 : ℕ) : ℝ) := by positivity
    have hMpos : (0 : ℝ) < ((K + 1 : ℕ) : ℝ) ^ a := pow_pos hNpos a
    have hcard : ((Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1))).card : ℝ)
        = ((K + 1 : ℕ) : ℝ) ^ a := by
      rw [Fintype.card_piFinset]
      simp only [Finset.card_range, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      push_cast; ring
    have hIcc : Fintype.piFinset (fun _ : Fin a => Finset.Icc (-(K : ℤ)) (K : ℤ))
        = Finset.Icc (fun _ => -(K : ℤ)) (fun _ => (K : ℤ)) := by
      rw [Pi.Icc_eq]
    refine ⟨fun m => ((∏ i, w (m i) : ℝ) : ℂ) *
        ((∑ j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)),
          G (fun i => (j i : ℝ) / ((K + 1 : ℕ) : ℝ))
            * giE (-(∑ i, (m i : ℝ) * ((j i : ℝ) / ((K + 1 : ℕ) : ℝ)))))
          / ((K + 1 : ℕ) : ℂ) ^ a), ?_, ?_⟩
    · intro m
      have hw0 : 0 ≤ ∏ i, w (m i) := Finset.prod_nonneg (fun i _ => (hw _).1)
      have hw1 : ∏ i, w (m i) ≤ 1 :=
        Finset.prod_le_one (fun i _ => (hw _).1) (fun i _ => (hw _).2)
      have hS : ‖(∑ j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)),
          G (fun i => (j i : ℝ) / ((K + 1 : ℕ) : ℝ))
            * giE (-(∑ i, (m i : ℝ) * ((j i : ℝ) / ((K + 1 : ℕ) : ℝ)))))
          / ((K + 1 : ℕ) : ℂ) ^ a‖ ≤ B₀ := by
        rw [norm_div, norm_pow, Complex.norm_natCast, div_le_iff₀ hMpos]
        calc ‖∑ j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)),
              G (fun i => (j i : ℝ) / ((K + 1 : ℕ) : ℝ))
                * giE (-(∑ i, (m i : ℝ) * ((j i : ℝ) / ((K + 1 : ℕ) : ℝ))))‖
            ≤ ∑ j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)),
              ‖G (fun i => (j i : ℝ) / ((K + 1 : ℕ) : ℝ))
                * giE (-(∑ i, (m i : ℝ) * ((j i : ℝ) / ((K + 1 : ℕ) : ℝ))))‖ :=
              norm_sum_le _ _
          _ ≤ ∑ _j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)), B₀ := by
              apply Finset.sum_le_sum
              intro j _
              rw [norm_mul, gNorm, mul_one]
              exact hbd _
          _ = B₀ * ((K + 1 : ℕ) : ℝ) ^ a := by
              rw [Finset.sum_const, nsmul_eq_mul, hcard]; ring
      rw [norm_mul, Complex.norm_of_nonneg hw0]
      calc (∏ i, w (m i)) * ‖(∑ j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)),
          G (fun i => (j i : ℝ) / ((K + 1 : ℕ) : ℝ))
            * giE (-(∑ i, (m i : ℝ) * ((j i : ℝ) / ((K + 1 : ℕ) : ℝ)))))
          / ((K + 1 : ℕ) : ℂ) ^ a‖
          ≤ 1 * ‖(∑ j ∈ Fintype.piFinset (fun _ : Fin a => Finset.range (K + 1)),
          G (fun i => (j i : ℝ) / ((K + 1 : ℕ) : ℝ))
            * giE (-(∑ i, (m i : ℝ) * ((j i : ℝ) / ((K + 1 : ℕ) : ℝ)))))
          / ((K + 1 : ℕ) : ℂ) ^ a‖ := mul_le_mul_of_nonneg_right hw1 (norm_nonneg _)
        _ ≤ B₀ := by rw [one_mul]; exact hS
    · intro x
      have hprodV : ∀ j : Fin a → ℕ,
          ((∏ i, V (x i - (j i : ℝ) / ((K + 1 : ℕ) : ℝ)) : ℝ) : ℂ)
          = ∑ m ∈ Finset.Icc (fun _ => -(K : ℤ)) (fun _ => (K : ℤ)),
              ((∏ i, w (m i) : ℝ) : ℂ) * giE (∑ i, (m i : ℝ) * x i)
                * giE (-(∑ i, (m i : ℝ) * ((j i : ℝ) / ((K + 1 : ℕ) : ℝ)))) := by
        intro j
        rw [Complex.ofReal_prod]
        simp only [hV]
        rw [Finset.prod_univ_sum, hIcc]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        rw [Finset.prod_mul_distrib, ← gSum, Complex.ofReal_prod, mul_assoc, ← gAdd]
        congr 2
        rw [← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun i _ => by ring)
      simp only [hprodV]
      simp only [Finset.mul_sum, Finset.sum_div]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun j _ => by ring)
  
  
  
  obtain ⟨w, hw, hw0, hVexp⟩ := kernel
  obtain ⟨V, hVdef⟩ : ∃ V : ℝ → ℝ, V = fun s =>
      ‖∑ k ∈ Finset.range (K + 1), giE ((k : ℝ) * s)‖ ^ 2 / ((K + 1 : ℕ) : ℝ) := ⟨_, rfl⟩
  have hV : ∀ s, ((V s : ℝ) : ℂ)
      = ∑ d ∈ Finset.Icc (-(K : ℤ)) (K : ℤ), (w d : ℂ) * giE ((d : ℝ) * s) := by
    intro s; rw [hVdef]; exact hVexp s
  have hNpos : (0 : ℝ) < ((K + 1 : ℕ) : ℝ) := by positivity
  have hV0 : ∀ s, 0 ≤ V s := by
    intro s; rw [hVdef]; positivity
  have horth : ∀ d : ℤ, d ≠ 0 → |d| < ((K + 1 : ℕ) : ℤ) →
      ∑ j ∈ Finset.range (K + 1), giE ((d : ℝ) * (j : ℝ) / ((K + 1 : ℕ) : ℝ)) = 0 :=
    fun d h1 h2 => root_sum (K + 1) d h1 h2
  have havg := grid_avg V w hw0 hV horth
  have hm2 : ∀ s, (s - round s) ^ 2 * V s ≤ 1 / (4 * ((K + 1 : ℕ) : ℝ)) := by
    intro s
    have h4 := jordan s
    have h5 := dirichlet s
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = ‖∑ k ∈ Finset.range (K + 1), giE ((k : ℝ) * s)‖ :=
      ⟨_, rfl⟩
    rw [← hδ] at h5
    have hδ0 : 0 ≤ δ := by rw [hδ]; exact norm_nonneg _
    have hu0 : 0 ≤ |s - round s| := abs_nonneg _
    have h6 : 4 * |s - round s| * δ ≤ 2 := by
      have := mul_le_mul_of_nonneg_right h4 hδ0
      linarith [mul_comm δ ‖giE s - 1‖]
    have h7 : (|s - round s| * δ) ^ 2 ≤ 1 / 4 := by
      have h8 : |s - round s| * δ ≤ 1 / 2 := by linarith
      have h9 : 0 ≤ |s - round s| * δ := mul_nonneg hu0 hδ0
      nlinarith
    have hVs : V s = δ ^ 2 / ((K + 1 : ℕ) : ℝ) := by rw [hVdef, hδ]
    rw [hVs, ← sq_abs]
    calc |s - round s| ^ 2 * (δ ^ 2 / ((K + 1 : ℕ) : ℝ))
        = (|s - round s| * δ) ^ 2 / ((K + 1 : ℕ) : ℝ) := by ring
      _ ≤ (1 / 4) / ((K + 1 : ℕ) : ℝ) := div_le_div_of_nonneg_right h7 hNpos.le
      _ = 1 / (4 * ((K + 1 : ℕ) : ℝ)) := by field_simp
  have hmom := first_moment (K + 1) (by omega) V hV0 havg hm2
  obtain ⟨c, hc, hT⟩ := coeff V w hw hV
  refine ⟨c, hc, fun x => ?_⟩
  have h9 := tensor (K + 1) (by omega) V (1 / (2 * Real.sqrt ((K + 1 : ℕ) : ℝ))) hV0 havg hmom x
  rw [hT x] at h9
  refine h9.trans ?_
  have hs : 0 < Real.sqrt ((K + 1 : ℕ) : ℝ) := Real.sqrt_pos.mpr hNpos
  have hK' : ((a : ℝ) * Λ / τ) ^ 2 ≤ ((K + 1 : ℕ) : ℝ) := by push_cast; exact hK
  have hr : (a : ℝ) * Λ / τ ≤ Real.sqrt ((K + 1 : ℕ) : ℝ) :=
    (le_abs_self _).trans (Real.abs_le_sqrt hK')
  have hr' : (a : ℝ) * Λ ≤ Real.sqrt ((K + 1 : ℕ) : ℝ) * τ := by
    rwa [div_le_iff₀ hτ] at hr
  calc (a : ℝ) * Λ * (1 / (2 * Real.sqrt ((K + 1 : ℕ) : ℝ)))
      = ((a : ℝ) * Λ) / (2 * Real.sqrt ((K + 1 : ℕ) : ℝ)) := by ring
    _ ≤ (Real.sqrt ((K + 1 : ℕ) : ℝ) * τ) / (2 * Real.sqrt ((K + 1 : ℕ) : ℝ)) :=
        div_le_div_of_nonneg_right hr' (by positivity)
    _ = τ / 2 := by field_simp
    _ ≤ τ := by linarith

theorem kai_vbr_box_expsum (ν : ℕ) (L : ℕ) (hL : 1 ≤ L) (η : ℝ) (hη : 0 < η)
    (u v : Fin ν → ℤ) (hside : ∀ l, v l - u l < (L : ℤ)) (μ : Fin ν → ℝ)
    (hbig : η * (L : ℝ) ^ ν ≤ ‖∑ z ∈ Finset.Icc u v, giE (∑ l, μ l * (z l : ℝ))‖) :
    ∀ l, |μ l - round (μ l)| ≤ 1 / (2 * η * (L : ℝ)) :=
by
  classical
  have F1 : ∀ x : ℝ, ‖giE x‖ = 1 := by
    intro x
    unfold giE
    have : (2 * (Real.pi : ℂ) * Complex.I * (x : ℂ)) = ((2 * Real.pi * x : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [this, Complex.norm_exp_ofReal_mul_I]
  have F2 : ∀ x y : ℝ, giE (x + y) = giE x * giE y := by
    intro x y
    unfold giE
    rw [← Complex.exp_add]; congr 1; push_cast; ring
  have F3 : ∀ n : ℤ, giE (n : ℝ) = 1 := by
    intro n
    unfold giE
    have : (2 * (Real.pi : ℂ) * Complex.I * ((n : ℝ) : ℂ))
        = (n : ℂ) * (2 * Real.pi * Complex.I) := by
      push_cast; ring
    rw [this, Complex.exp_int_mul_two_pi_mul_I]
  have Fsum : ∀ x : Fin ν → ℝ, giE (∑ l, x l) = ∏ l, giE (x l) := by
    intro x
    unfold giE
    rw [Complex.ofReal_sum, Finset.mul_sum, Complex.exp_sum]
  
  have factor : ∑ z ∈ Finset.Icc u v, giE (∑ l, μ l * (z l : ℝ))
      = ∏ l, ∑ n ∈ Finset.Icc (u l) (v l), giE (μ l * (n : ℝ)) := by
    rw [Finset.prod_univ_sum, Pi.Icc_eq]
    exact Finset.sum_congr rfl (fun z _ => Fsum _)
  
  have jordan : ∀ t : ℝ, 4 * |t - round t| ≤ ‖giE t - 1‖ := by
    intro t
    have hs2 : |t - round t| ≤ 1 / 2 := abs_sub_round t
    have hts : giE t = giE (t - round t) := by
      have : t = (t - round t) + ((round t : ℤ) : ℝ) := by ring
      conv_lhs => rw [this]
      rw [F2, F3, mul_one]
    rw [hts]
    generalize t - round t = s at hs2 ⊢
    have hnorm : ‖giE s - 1‖ = 2 * |Real.sin (Real.pi * s)| := by
      unfold giE
      have : (2 * (Real.pi : ℂ) * Complex.I * (s : ℂ))
          = Complex.I * ((2 * Real.pi * s : ℝ) : ℂ) := by
        push_cast; ring
      rw [this, Complex.norm_exp_I_mul_ofReal_sub_one, Real.norm_eq_abs, abs_mul]
      have : 2 * Real.pi * s / 2 = Real.pi * s := by ring
      rw [this]; norm_num
    rw [hnorm]
    have hpi := Real.pi_pos
    have habs := abs_nonneg s
    have h1 : 2 / Real.pi * (Real.pi * |s|) ≤ Real.sin (Real.pi * |s|) :=
      Real.mul_le_sin (by positivity) (by nlinarith)
    have h2 : 2 / Real.pi * (Real.pi * |s|) = 2 * |s| := by field_simp
    have h3 : Real.sin (Real.pi * |s|) ≤ |Real.sin (Real.pi * s)| := by
      rcases le_or_gt 0 s with h | h
      · rw [abs_of_nonneg h]; exact le_abs_self _
      · rw [abs_of_neg h, mul_neg, Real.sin_neg]; exact neg_le_abs _
    linarith
  
  have geom : ∀ (m : ℝ) (a b : ℤ),
      ‖giE m - 1‖ * ‖∑ n ∈ Finset.Icc a b, giE (m * (n : ℝ))‖ ≤ 2 := by
    intro m a b
    rcases lt_or_ge b a with hab | hab
    · rw [Finset.Icc_eq_empty_of_lt hab]; simp
    · have key : ∀ b : ℤ, a ≤ b → (giE m - 1) * ∑ n ∈ Finset.Icc a b, giE (m * (n : ℝ))
          = giE (m * ((b : ℝ) + 1)) - giE (m * (a : ℝ)) := by
        intro b hb
        induction b, hb using Int.le_induction with
        | base =>
          rw [Finset.Icc_self, Finset.sum_singleton]
          rw [show m * ((a : ℝ) + 1) = m * a + m by ring, F2]; ring
        | succ k hk ih =>
          have hins : Finset.Icc a (k + 1) = insert (k + 1) (Finset.Icc a k) := by
            ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
          have hnot : k + 1 ∉ Finset.Icc a k := by simp
          rw [hins, Finset.sum_insert hnot, mul_add, ih]
          push_cast
          rw [show m * ((k : ℝ) + 1 + 1) = m * ((k : ℝ) + 1) + m by ring, F2]; ring
      rw [← norm_mul, key b hab]
      calc _ ≤ ‖giE (m * ((b : ℝ) + 1))‖ + ‖giE (m * (a : ℝ))‖ := norm_sub_le _ _
        _ = 2 := by rw [F1, F1]; norm_num
  
  have triv : ∀ k, ‖∑ n ∈ Finset.Icc (u k) (v k), giE (μ k * (n : ℝ))‖ ≤ L := by
    intro k
    refine (norm_sum_le _ _).trans ?_
    simp only [F1, Finset.sum_const, nsmul_eq_mul, mul_one, Int.card_Icc]
    have : (v k + 1 - u k).toNat ≤ L := by
      rw [Int.toNat_le]; have := hside k; omega
    exact_mod_cast this
  intro l
  have hLpos : (0 : ℝ) < L := by exact_mod_cast hL
  
  have hsel : ∀ σ : Fin ν → ℝ, (∀ k, 0 ≤ σ k) → (∀ k, σ k ≤ L) →
      η * (L : ℝ) ^ ν ≤ ∏ k, σ k → η * L ≤ σ l := by
    intro σ h0 hle hprod
    have hν : 0 < ν := Fin.pos l
    have hsplit : ∏ k, σ k = σ l * ∏ k ∈ Finset.univ.erase l, σ k :=
      (Finset.mul_prod_erase _ _ (Finset.mem_univ l)).symm
    have hrest : ∏ k ∈ Finset.univ.erase l, σ k ≤ (L : ℝ) ^ (ν - 1) := by
      calc _ ≤ ∏ k ∈ Finset.univ.erase l, (L : ℝ) :=
            Finset.prod_le_prod (fun k _ => h0 k) (fun k _ => hle k)
        _ = (L : ℝ) ^ (ν - 1) := by
            rw [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ l),
              Finset.card_univ, Fintype.card_fin]
    have hLp : (0 : ℝ) < (L : ℝ) ^ (ν - 1) := pow_pos hLpos _
    have hpowsplit : (L : ℝ) ^ ν = L * (L : ℝ) ^ (ν - 1) := by
      rw [← pow_succ']; congr 1; omega
    have h1 : η * (L : ℝ) ^ ν ≤ σ l * (L : ℝ) ^ (ν - 1) := by
      rw [hsplit] at hprod
      exact hprod.trans (mul_le_mul_of_nonneg_left hrest (h0 l))
    rw [hpowsplit] at h1
    have h2 : (η * L) * (L : ℝ) ^ (ν - 1) ≤ σ l * (L : ℝ) ^ (ν - 1) := by
      calc (η * L) * (L : ℝ) ^ (ν - 1) = η * (L * (L : ℝ) ^ (ν - 1)) := by ring
        _ ≤ _ := h1
    exact le_of_mul_le_mul_right h2 hLp
  have hσl : η * L ≤ ‖∑ n ∈ Finset.Icc (u l) (v l), giE (μ l * (n : ℝ))‖ := by
    refine hsel (fun k => ‖∑ n ∈ Finset.Icc (u k) (v k), giE (μ k * (n : ℝ))‖)
      (fun k => norm_nonneg _) triv ?_
    rw [factor, norm_prod] at hbig
    exact hbig
  
  have hj := jordan (μ l)
  have hg := geom (μ l) (u l) (v l)
  have hd : 0 ≤ |μ l - round (μ l)| := abs_nonneg _
  have h4 : 4 * |μ l - round (μ l)| * (η * L) ≤ 2 := by
    calc 4 * |μ l - round (μ l)| * (η * L)
        ≤ 4 * |μ l - round (μ l)| * ‖∑ n ∈ Finset.Icc (u l) (v l), giE (μ l * (n : ℝ))‖ :=
          mul_le_mul_of_nonneg_left hσl (by positivity)
      _ ≤ ‖giE (μ l) - 1‖ * ‖∑ n ∈ Finset.Icc (u l) (v l), giE (μ l * (n : ℝ))‖ :=
          mul_le_mul_of_nonneg_right hj (norm_nonneg _)
      _ ≤ 2 := hg
  rw [le_div_iff₀ (by positivity)]
  nlinarith

theorem kai_vbr_product_formula (ν : ℕ) (D Q : ℝ) (hD : 1 ≤ D) (hQ : 2 ≤ Q)
    (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) (hF : Nil2VertData D Q Bc ξ F)
    (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ) (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ)
    (r₂ : Fin ν → Fin ν → Fin b → ℝ)
    (h : Fin ν → ℤ) (θ : Fin a → ℝ) (g : Fin a → ℤ)
    (hθ : ∀ i, |θ i| ≤ 1 / 2)
    (hdec : ∀ i, ∑ l, (h l : ℝ) * p₁ l i = θ i + (g i : ℝ)) :
    ∃ (Ψ : (Fin a → ℝ) → ℂ) (c₀ : ℝ),
      (∀ (x : Fin a → ℝ) (γ : Fin a → ℤ), Ψ (fun i => x i + (γ i : ℝ)) = Ψ x) ∧
      (∀ x, ‖Ψ x‖ ≤ Q ^ 2) ∧
      (∀ x y : Fin a → ℝ, (∀ i, |x i - y i| ≤ 1 / 2) →
        ‖Ψ x - Ψ y‖ ≤ 4 * D ^ 2 * Q ^ 4 * ∑ i, |x i - y i|) ∧
      ∀ w : Fin ν → ℤ,
        nil2Eval p₀ p₁ r₀ r₁ r₂ F (w + h) * (starRingEnd ℂ) (nil2Eval p₀ p₁ r₀ r₁ r₂ F w)
          = giE (c₀ + ∑ l, (w l : ℝ) *
              (∑ l', (∑ t, (ξ t : ℝ) * (r₂ l l' t + r₂ l' l t)
                  - ∑ i, ∑ j, p₁ l i * (∑ t, (ξ t : ℝ) * (Bc i j t : ℝ)) * p₁ l' j) * (h l' : ℝ)
                + ∑ i, ∑ j, p₁ l i * ((∑ t, ξ t * (Bc i j t - Bc j i t) : ℤ) : ℝ) * θ j))
            * Ψ (fun i => p₀ i + ∑ l, (w l : ℝ) * p₁ l i) :=
by
  obtain ⟨h1, h2, h3, -, h5, h6, h7, h8⟩ := hF
  have hQ0 : (0 : ℝ) ≤ Q := by linarith
  
  have gadd : ∀ s t : ℝ, giE (s + t) = giE s * giE t := by
    intro s t; unfold giE; rw [← Complex.exp_add]; congr 1; push_cast; ring
  have gconj : ∀ s : ℝ, (starRingEnd ℂ) (giE s) = giE (-s) := by
    intro s; unfold giE; rw [← Complex.exp_conj]; congr 1
    simp only [map_mul, map_ofNat, Complex.conj_ofReal, Complex.conj_I]; push_cast; ring
  have gnorm : ∀ s : ℝ, ‖giE s‖ = 1 := by
    intro s
    have e : giE s = Complex.exp (((2 * Real.pi * s : ℝ) : ℂ) * Complex.I) := by
      unfold giE; congr 1; push_cast; ring
    rw [e, Complex.norm_exp_ofReal_mul_I]
  have ginv : ∀ s : ℝ, giE (-s) * giE s = 1 := by
    intro s; rw [← gadd, neg_add_cancel]; simp [giE]
  have glip : ∀ s t : ℝ, ‖giE s - giE t‖ ≤ 2 * Real.pi * |s - t| := by
    intro s t
    have e1 : giE s - giE t = giE t * (giE (s - t) - 1) := by
      rw [mul_sub, mul_one, ← gadd, show t + (s - t) = s by ring]
    rw [e1, norm_mul, gnorm, one_mul]
    have e2 : giE (s - t) = Complex.exp (Complex.I * ((2 * Real.pi * (s - t) : ℝ) : ℂ)) := by
      unfold giE; congr 1; push_cast; ring
    rw [e2]
    refine Real.norm_exp_I_mul_ofReal_sub_one_le.trans (le_of_eq ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity : (0:ℝ) < 2 * Real.pi)]
  
