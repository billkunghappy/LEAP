              (I : Ideal (NumberField.RingOfIntegers K))).re *
            (kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
              (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)))
        = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            (kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
              (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)) := by
      refine tsum_congr (fun I => ?_)
      rw [hpcq, if_pos ⟨I.2, by simp⟩, Complex.one_re, one_mul]
    rw [etop]
    refine gen
      (fun I => kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
        (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ))
      (fun I => (kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K))).re)
      _ (fun I => mul_nonneg (hvm0 _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)) ?_
      (Real.log_natCast_nonneg _) hR
    intro I
    dsimp only
    rw [hpcq]
    split_ifs <;> simp
  
  have hspansup : ∀ (q : Ideal (NumberField.RingOfIntegers K))
      (x : NumberField.RingOfIntegers K),
      Ideal.span {x} ⊔ q = ⊤ ↔ IsUnit (Ideal.Quotient.mk q x) := by
    intro q x
    constructor
    · intro h
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at h
      obtain ⟨y, hy, z, hz, hyz⟩ := h
      rw [Ideal.mem_span_singleton'] at hy
      obtain ⟨b, rfl⟩ := hy
      have h2 : b * x - 1 ∈ q := by
        have hz' : b * x - 1 = -z := by linear_combination hyz
        rw [hz']
        exact Submodule.neg_mem q hz
      have h3 : (Ideal.Quotient.mk q) (b * x) = (Ideal.Quotient.mk q) 1 :=
        Ideal.Quotient.eq.mpr h2
      rw [map_mul, map_one] at h3
      refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk q b, ?_⟩
      exact (mul_comm ((Ideal.Quotient.mk q) x) ((Ideal.Quotient.mk q) b)).trans h3
    · intro h
      obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp h
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective v
      have h3 : x * b - 1 ∈ q := by
        refine Ideal.Quotient.eq.mp ?_
        rw [map_mul, map_one]
        exact hv
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      refine ⟨x * b, Ideal.mem_span_singleton'.mpr ⟨b, mul_comm b x⟩,
        -(x * b - 1), Submodule.neg_mem q h3, by ring⟩
  have hmulsup : ∀ (q I J : Ideal (NumberField.RingOfIntegers K)),
      I * J ⊔ q = ⊤ ↔ (I ⊔ q = ⊤ ∧ J ⊔ q = ⊤) := by
    intro q I J
    constructor
    · intro h
      have hle2 : I * J ≤ J := Ideal.mul_le_left
      have hle1 : I * J ≤ I := by
        rw [mul_comm]
        exact Ideal.mul_le_left
      constructor
      · have hh := sup_le_sup_right hle1 q
        rw [h] at hh
        exact top_le_iff.mp hh
      · have hh := sup_le_sup_right hle2 q
        rw [h] at hh
        exact top_le_iff.mp hh
    · rintro ⟨hI, hJ⟩
      rw [← Ideal.isCoprime_iff_sup_eq] at hI hJ ⊢
      exact IsCoprime.mul_left hI hJ
  have htwsq : ∀ (q : Ideal (NumberField.RingOfIntegers K))
      (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
      (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (a : NumberField.RingOfIntegers K), a ≠ 0 →
      kaiHeckeTwist K q 0 0 (ξ ^ 2) (fun _ => false) a
        = kaiHeckeTwist K q 0 0 ξ η a * kaiHeckeTwist K q 0 0 ξ η a := by
    intro q ξ η a ha
    have key : ∀ A B C D A' B' C' D' : ℂ, A' = A * A → B' = 1 → B * B = 1 →
        C' = C * C → D' = D * D →
        A' * B' * C' * D' = A * B * C * D * (A * B * C * D) := by
      intro A B C D A' B' C' D' e1 e2 e3 e4 e5
      subst e1; subst e2; subst e4; subst e5
      calc A * A * 1 * (C * C) * (D * D)
          = A * A * (B * B) * (C * C) * (D * D) := by rw [e3]
        _ = A * B * C * D * (A * B * C * D) := by ring
    have hpt : ∀ (b : Bool) (s : ℂ), s * s = 1 →
        (if b then s else 1) * (if b then s else 1) = 1 := by
      intro b s hs
      cases b <;> simp [hs]
    by_cases hx : IsUnit (Ideal.Quotient.mk q a)
    · have hval : ∀ (ξ' : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          kaiHeckeTwist K q 0 0 ξ' η' a
            = (ξ' hx.unit : ℂ)
              * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                  if η' w then
                    ((Real.sign ((NumberField.mixedEmbedding K ((a : K))).1 w) : ℝ) : ℂ)
                  else 1)
              * Complex.exp (Complex.I *
                  (∑ w : NumberField.InfinitePlace K,
                    (((0 : NumberField.InfinitePlace K → ℝ) w : ℝ) : ℂ) * ((w.mult : ℝ) : ℂ) *
                      ((Real.log (w ((a : K))) : ℝ) : ℂ)))
              * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
                  Complex.exp (Complex.I *
                    (((0 : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) w : ℤ) : ℂ) *
                    ((((NumberField.mixedEmbedding K ((a : K))).2 w).arg : ℝ) : ℂ))) := by
        intro ξ' η'
        rw [kaiHeckeTwist, dif_pos hx]
      have hcoe : ((a : K)) ≠ 0 := by
        intro h
        first
          | exact ha (NumberField.RingOfIntegers.coe_eq_zero_iff.mp h)
          | exact ha (by exact_mod_cast h)
      have hsq : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          ((Real.sign ((NumberField.mixedEmbedding K ((a : K))).1 w) : ℝ) : ℂ)
            * ((Real.sign ((NumberField.mixedEmbedding K ((a : K))).1 w) : ℝ) : ℂ) = 1 := by
        intro w
        have h1 : NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K)
            (NumberField.mixedEmbedding K ((a : K)))
            = ‖(NumberField.mixedEmbedding K ((a : K))).1 w‖ :=
          NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.prop _
        have h2 : NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K)
            (NumberField.mixedEmbedding K ((a : K)))
            = (w : NumberField.InfinitePlace K) ((a : K)) :=
          NumberField.mixedEmbedding.normAtPlace_apply _ _
        have hposn : 0 < ‖(NumberField.mixedEmbedding K ((a : K))).1 w‖ := by
          rw [← h1, h2]
          first
            | exact NumberField.InfinitePlace.pos_iff.mpr hcoe
            | exact (NumberField.InfinitePlace.pos_iff _ _).mpr hcoe
            | simpa using hcoe
        have hne : (NumberField.mixedEmbedding K ((a : K))).1 w ≠ 0 := by
          intro h
          rw [h, norm_zero] at hposn
          exact lt_irrefl 0 hposn
        rcases lt_trichotomy ((NumberField.mixedEmbedding K ((a : K))).1 w) 0 with
          hlt | heq | hgt
        · rw [Real.sign_of_neg hlt]
          norm_num
        · exact absurd heq hne
        · rw [Real.sign_of_pos hgt]
          norm_num
      have hA : ((ξ ^ 2) hx.unit : ℂ) = (ξ hx.unit : ℂ) * (ξ hx.unit : ℂ) := by
        rw [pow_two, MonoidHom.mul_apply, Circle.coe_mul]
      have hB' : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if (false : Bool) then
              ((Real.sign ((NumberField.mixedEmbedding K ((a : K))).1 w) : ℝ) : ℂ)
            else 1) = 1 := by
        refine Finset.prod_eq_one (fun w _ => ?_)
        simp
      have hBB : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then
              ((Real.sign ((NumberField.mixedEmbedding K ((a : K))).1 w) : ℝ) : ℂ)
            else 1)
          * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then
              ((Real.sign ((NumberField.mixedEmbedding K ((a : K))).1 w) : ℝ) : ℂ)
            else 1) = 1 := by
        rw [← Finset.prod_mul_distrib]
        exact Finset.prod_eq_one (fun w _ => hpt (η w) _ (hsq w))
      have hC : Complex.exp (Complex.I *
            (∑ w : NumberField.InfinitePlace K,
              (((0 : NumberField.InfinitePlace K → ℝ) w : ℝ) : ℂ) * ((w.mult : ℝ) : ℂ) *
                ((Real.log (w ((a : K))) : ℝ) : ℂ)))
          = Complex.exp (Complex.I *
            (∑ w : NumberField.InfinitePlace K,
              (((0 : NumberField.InfinitePlace K → ℝ) w : ℝ) : ℂ) * ((w.mult : ℝ) : ℂ) *
                ((Real.log (w ((a : K))) : ℝ) : ℂ)))
            * Complex.exp (Complex.I *
            (∑ w : NumberField.InfinitePlace K,
              (((0 : NumberField.InfinitePlace K → ℝ) w : ℝ) : ℂ) * ((w.mult : ℝ) : ℂ) *
                ((Real.log (w ((a : K))) : ℝ) : ℂ))) := by
        simp
      have hD : (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
                  Complex.exp (Complex.I *
                    (((0 : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) w : ℤ) : ℂ) *
                    ((((NumberField.mixedEmbedding K ((a : K))).2 w).arg : ℝ) : ℂ)))
          = (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
                  Complex.exp (Complex.I *
                    (((0 : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) w : ℤ) : ℂ) *
                    ((((NumberField.mixedEmbedding K ((a : K))).2 w).arg : ℝ) : ℂ)))
            * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
                  Complex.exp (Complex.I *
                    (((0 : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) w : ℤ) : ℂ) *
                    ((((NumberField.mixedEmbedding K ((a : K))).2 w).arg : ℝ) : ℂ))) := by
        simp
      rw [hval (ξ ^ 2) (fun _ => false), hval ξ η]
      exact key _ _ _ _ _ _ _ _ hA hB' hBB hC hD
    · have hval0 : ∀ (ξ' : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          kaiHeckeTwist K q 0 0 ξ' η' a = 0 := by
        intro ξ' η'
        rw [kaiHeckeTwist, dif_neg hx]
      rw [hval0 (ξ ^ 2) (fun _ => false), hval0 ξ η, zero_mul]
  unfold KaiZFCharPositivityProp
  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro q hq
    have hchi1 : ∀ I : Ideal (NumberField.RingOfIntegers K),
        (I ≠ 0 ∧ I ⊔ q = ⊤) → kaiZFPrincipalChar K q I = 1 := by
      intro I h
      rw [hpcq]
      exact if_pos h
    have hchi0 : ∀ I : Ideal (NumberField.RingOfIntegers K),
        ¬(I ≠ 0 ∧ I ⊔ q = ⊤) → kaiZFPrincipalChar K q I = 0 := by
      intro I h
      rw [hpcq]
      exact if_neg h
    have hPmul : ∀ I J : Ideal (NumberField.RingOfIntegers K),
        (I * J ≠ 0 ∧ I * J ⊔ q = ⊤)
          ↔ ((I ≠ 0 ∧ I ⊔ q = ⊤) ∧ (J ≠ 0 ∧ J ⊔ q = ⊤)) := by
      intro I J
      constructor
      · rintro ⟨h1, h2⟩
        obtain ⟨hAI, hAJ⟩ := (hmulsup q I J).mp h2
        refine ⟨⟨?_, hAI⟩, ?_, hAJ⟩
        · rintro rfl
          exact h1 (zero_mul J)
        · rintro rfl
          exact h1 (mul_zero I)
      · rintro ⟨⟨h1, h2⟩, h3, h4⟩
        exact ⟨mul_ne_zero h1 h3, (hmulsup q I J).mpr ⟨h2, h4⟩⟩
    refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · exact hchi1 1 ⟨one_ne_zero, by rw [Ideal.one_eq_top, top_sup_eq]⟩
    · intro I J
      by_cases h : (I ≠ 0 ∧ I ⊔ q = ⊤) ∧ (J ≠ 0 ∧ J ⊔ q = ⊤)
      · rw [hchi1 _ ((hPmul I J).mpr h), hchi1 I h.1, hchi1 J h.2]
        norm_num
      · rw [hchi0 _ (fun hc => h ((hPmul I J).mp hc))]
        rcases not_and_or.mp h with h' | h'
        · rw [hchi0 I h']
          exact (zero_mul _).symm
        · rw [hchi0 J h']
          exact (mul_zero _).symm
    · intro I hI hs
      rw [hchi1 I ⟨hI, hs⟩]
      exact norm_one
    · intro I hs
      exact hchi0 I (fun hc => hs hc.2)
    · exact hchi0 0 (fun hc => hc.1 rfl)
    · intro a ha
      have hsp0 : Ideal.span {a} ≠ 0 := fun h =>
        ha (Ideal.span_singleton_eq_bot.mp (h.trans Submodule.zero_eq_bot))
      by_cases hx : IsUnit (Ideal.Quotient.mk q a)
      · rw [hchi1 _ ⟨hsp0, (hspansup q a).mpr hx⟩, kaiHeckeTwist, dif_pos hx]
        simp
      · rw [hchi0 _ (fun hc => hx ((hspansup q a).mp hc.2)), kaiHeckeTwist, dif_neg hx]
    · intro I hI hs
      exact hchi1 I ⟨hI, hs⟩
  · 
    intro q ξ η lam hq hext
    obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hext
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · show lam 1 * lam 1 = 1
      rw [h1]
      norm_num
    · intro I J
      show lam (I * J) * lam (I * J) = lam I * lam I * (lam J * lam J)
      rw [h2 I J]
      ring
    · intro I hI hs
      show ‖lam I * lam I‖ = 1
      rw [norm_mul, h3 I hI hs]
      norm_num
    · intro I hs
      show lam I * lam I = 0
      rw [h4 I hs]
      exact zero_mul _
    · show lam 0 * lam 0 = 0
      rw [h5]
      exact zero_mul _
    · intro a ha
      show lam (Ideal.span {a}) * lam (Ideal.span {a})
          = kaiHeckeTwist K q 0 0 (ξ ^ 2) (fun _ => false) a
      rw [h6 a ha]
      exact (htwsq q ξ η a ha).symm
  · 
    intro q ξ η lam hext
    obtain ⟨-, -, hnrm, hvan, hz, -⟩ := hext
    have hoff : ∀ I : Ideal (NumberField.RingOfIntegers K),
        ¬(I ≠ 0 ∧ I ⊔ q = ⊤) → lam I = 0 := by
      intro I hI
      by_cases h0 : I = 0
      · rw [h0]; exact hz
      · exact hvan I (fun hqI => hI ⟨h0, hqI⟩)
    have hfwd : (∀ I : Ideal (NumberField.RingOfIntegers K),
          lam I = (starRingEnd ℂ) (lam I)) →
        ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
          lam I * lam I = 1 := by
      intro hre I hI0 hIq
      have h := Complex.mul_conj' (lam I)
      rw [← hre I] at h
      rw [hnrm I hI0 hIq] at h
      simpa using h
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · intro hre I hI0 hIq
      show lam I * lam I = 1
      exact hfwd hre I hI0 hIq
    · intro hpr I
      by_cases hc : I ≠ 0 ∧ I ⊔ q = ⊤
      · have hsq : lam I * lam I = 1 := hpr I hc.1 hc.2
        rcases mul_self_eq_one_iff.mp hsq with h | h <;> rw [h] <;> simp
      · rw [hoff I hc]; simp
    · intro hre
      funext I
      show lam I * lam I = kaiZFPrincipalChar K q I
      rw [hpcq]
      by_cases hc : I ≠ 0 ∧ I ⊔ q = ⊤
      · rw [hfwd hre I hc.1 hc.2, if_pos hc]
      · rw [hoff I hc, if_neg hc, mul_zero]
  · 
    intro q ξ η lam hq hext
    have hn : ∀ I : Ideal (NumberField.RingOfIntegers K),
        ‖lam I‖ = ‖kaiZFPrincipalChar K q I‖ := by
      obtain ⟨-, -, h3, h4, h5, -⟩ := hext
      intro I
      by_cases hc : I ≠ 0 ∧ I ⊔ q = ⊤
      · rw [h3 I hc.1 hc.2, hpcq, if_pos hc, norm_one]
      · have h0 : lam I = 0 := by
          by_cases hI : I = 0
          · rw [hI]; exact h5
          · exact h4 I (fun h => hc ⟨hI, h⟩)
        rw [h0, hpcq, if_neg hc, norm_zero]
    exact ⟨fun σ γ _ => s4 q lam hn σ γ, fun σ _ => (s5 q lam hn σ).1,
      fun _ σ _ => (s5 q lam hn σ).2, fun σ hσ => s7 q σ (s6 q hq σ hσ).2⟩

theorem kai_landau_nonneg_dirichlet_halfplane {X : Type u} (a : X → ℝ) (nn : X → ℝ)
    (ha : ∀ x, 0 ≤ a x) (hn : ∀ x, 1 ≤ nn x)
    (hlog : ∀ (m : ℕ) (σ : ℝ), 1 < σ →
      Summable (fun x => a x * Real.log (nn x) ^ m * nn x ^ (-σ)))
    (Φ : ℂ → ℂ) (hΦ : DifferentiableOn ℂ Φ {s : ℂ | 0 < s.re})
    (hderiv : ∀ (m : ℕ) (s : ℂ), 1 < s.re →
      iteratedDeriv m Φ s
        = ∑' x, (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ m * (nn x : ℂ) ^ (-s))
    (τ : ℝ) (hτ0 : 0 < τ) (hτ1 : τ ≤ 1) :
    Summable (fun x => a x * nn x ^ (-τ)) :=
by
  classical
  have hnpos : ∀ x, 0 < nn x := fun x => lt_of_lt_of_le one_pos (hn x)
  obtain ⟨c, hc⟩ : ∃ c : ℕ → X → ℝ, ∀ m x, c m x =
      a x * ((2 - τ) * Real.log (nn x)) ^ m / (m.factorial : ℝ) * nn x ^ (-(2 : ℝ)) :=
    ⟨fun m x => a x * ((2 - τ) * Real.log (nn x)) ^ m / (m.factorial : ℝ) * nn x ^ (-(2 : ℝ)),
      fun _ _ => rfl⟩
  
  have hsub : Metric.ball (2 : ℂ) 2 ⊆ {s : ℂ | 0 < s.re} := by
    intro w hw
    rw [Metric.mem_ball, Complex.dist_eq] at hw
    have h1 : |(w - 2).re| ≤ ‖w - 2‖ := Complex.abs_re_le_norm _
    have h2 : w.re = 2 + (w - 2).re := by simp
    show 0 < w.re
    have h3 := neg_abs_le (w - 2).re
    linarith
  have hmem : (τ : ℂ) ∈ Metric.ball (2 : ℂ) 2 := by
    rw [Metric.mem_ball, Complex.dist_eq]
    have : (τ : ℂ) - 2 = ((τ - 2 : ℝ) : ℂ) := by push_cast; ring
    rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_nonpos (by linarith)]
    linarith
  
  have hT := Complex.hasSum_taylorSeries_on_ball (hΦ.mono hsub) hmem
  
  have hcoef : ∀ n : ℕ, (n.factorial : ℂ)⁻¹ • ((τ : ℂ) - 2) ^ n • iteratedDeriv n Φ 2
      = ((∑' x, c n x : ℝ) : ℂ) := by
    intro n
    rw [smul_eq_mul, smul_eq_mul, hderiv n 2 (by norm_num)]
    have hg : ∀ x, (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ n * (nn x : ℂ) ^ (-(2:ℂ))
        = ((a x * (-(Real.log (nn x))) ^ n * nn x ^ (-(2:ℝ)) : ℝ) : ℂ) := by
      intro x
      rw [Complex.ofReal_mul, Complex.ofReal_mul, Complex.ofReal_pow,
        Complex.ofReal_cpow (hnpos x).le]
      push_cast
      ring
    simp_rw [hg]
    rw [← Complex.ofReal_tsum]
    have hc' : ∀ x, c n x = ((n.factorial : ℝ)⁻¹ * (τ - 2) ^ n) *
        (a x * (-(Real.log (nn x))) ^ n * nn x ^ (-(2:ℝ))) := by
      intro x
      rw [hc n x, show (2 - τ) * Real.log (nn x) = (τ - 2) * (-(Real.log (nn x))) by ring,
        mul_pow]
      ring
    simp_rw [hc']
    rw [tsum_mul_left]
    push_cast
    ring
  have hT' : HasSum (fun n => ((∑' x, c n x : ℝ) : ℂ)) (Φ τ) :=
    hT.congr_fun (fun n => (hcoef n).symm)
  have hR : HasSum (fun n => ∑' x, c n x) (Φ τ).re := by
    have := Complex.hasSum_re hT'
    simpa only [Complex.ofReal_re] using this
  
  have hcnn : ∀ m x, 0 ≤ c m x := by
    intro m x
    rw [hc m x]
    have hL : 0 ≤ Real.log (nn x) := Real.log_nonneg (hn x)
    have h2t : 0 ≤ 2 - τ := by linarith
    exact mul_nonneg (div_nonneg (mul_nonneg (ha x) (pow_nonneg (mul_nonneg h2t hL) m))
      (Nat.cast_nonneg _)) (Real.rpow_nonneg (hnpos x).le _)
  have hrow : ∀ m, Summable (fun x => c m x) := by
    intro m
    have h := (hlog m 2 (by norm_num)).mul_left ((2 - τ) ^ m / (m.factorial : ℝ))
    refine h.congr (fun x => ?_)
    rw [hc m x, mul_pow]
    ring
  
  have hprod : Summable (fun p : ℕ × X => c p.1 p.2) :=
    (summable_prod_of_nonneg (fun p => hcnn p.1 p.2)).2 ⟨hrow, hR.summable⟩
  have hcol : Summable (fun x => ∑' m, c m x) := hprod.prod_symm.prod
  
  have hcolsum : ∀ x, ∑' m, c m x = a x * nn x ^ (-τ) := by
    intro x
    apply HasSum.tsum_eq
    have h1 := NormedSpace.expSeries_div_hasSum_exp ((2 - τ) * Real.log (nn x))
    rw [← Real.exp_eq_exp_ℝ] at h1
    have h2 := (h1.mul_left (a x)).mul_right (nn x ^ (-(2:ℝ)))
    have e1 : Real.exp ((2 - τ) * Real.log (nn x)) = nn x ^ (2 - τ) := by
      rw [Real.rpow_def_of_pos (hnpos x), mul_comm]
    have e2 : nn x ^ (2 - τ) * nn x ^ (-(2:ℝ)) = nn x ^ (-τ) := by
      rw [← Real.rpow_add (hnpos x)]
      ring_nf
    have hval : a x * Real.exp ((2 - τ) * Real.log (nn x)) * nn x ^ (-(2:ℝ))
        = a x * nn x ^ (-τ) := by
      rw [e1, mul_assoc, e2]
    rw [hval] at h2
    refine h2.congr_fun (fun m => ?_)
    rw [hc m x]
    ring
  exact hcol.congr hcolsum

theorem kai_dirichlet_series_iteratedDeriv {X : Type u} (a : X → ℝ) (nn : X → ℝ)
    (ha : ∀ x, 0 ≤ a x) (hn : ∀ x, 1 ≤ nn x)
    (hlog : ∀ (m : ℕ) (σ : ℝ), 1 < σ →
      Summable (fun x => a x * Real.log (nn x) ^ m * nn x ^ (-σ)))
    (Φ : ℂ → ℂ)
    (heq : ∀ s : ℂ, 1 < s.re →
      Φ s = ∑' x, (a x : ℂ) * (nn x : ℂ) ^ (-s))
    (m : ℕ) (s : ℂ) (hs : 1 < s.re) :
    iteratedDeriv m Φ s
      = ∑' x, (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ m * (nn x : ℂ) ^ (-s) :=
by
  have hpos : ∀ x : X, (0 : ℝ) < nn x := fun x => lt_of_lt_of_le zero_lt_one (hn x)
  have hLnn : ∀ x : X, (0 : ℝ) ≤ Real.log (nn x) := fun x => Real.log_nonneg (hn x)
  have hterm : ∀ (x : X) (k : ℕ) (z : ℂ),
      HasDerivAt
        (fun w : ℂ => (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-w))
        ((a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ (k + 1) * (nn x : ℂ) ^ (-z)) z := by
    intro x k z
    have htne : ((nn x : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt (hpos x))
    have hneg : HasDerivAt (fun w : ℂ => -w) (-1 : ℂ) z := (hasDerivAt_id z).neg
    have h1 : HasDerivAt (fun w : ℂ => (nn x : ℂ) ^ (-w))
        ((nn x : ℂ) ^ (-z) * Complex.log ((nn x : ℂ)) * (-1)) z :=
      HasDerivAt.const_cpow hneg (Or.inl htne)
    have hval : (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k *
        ((nn x : ℂ) ^ (-z) * Complex.log ((nn x : ℂ)) * (-1))
        = (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ (k + 1) * (nn x : ℂ) ^ (-z) := by
      rw [← Complex.ofReal_log (hpos x).le, pow_succ]
      ring
    exact (h1.const_mul ((a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k)).congr_deriv hval
  have hbd : ∀ (x : X) (k : ℕ) (c : ℝ) (w : ℂ), c ≤ w.re →
      ‖(a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-w)‖
        ≤ a x * Real.log (nn x) ^ k * nn x ^ (-c) := by
    intro x k c w hw
    have e1 : ‖(a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-w)‖
        = a x * Real.log (nn x) ^ k * nn x ^ (-w.re) := by
      rw [norm_mul, norm_mul, norm_pow, norm_neg, Complex.norm_real, Complex.norm_real,
        Complex.norm_cpow_eq_rpow_re_of_pos (hpos x), Complex.neg_re,
        Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (ha x), abs_of_nonneg (hLnn x)]
    rw [e1]
    have hmono : nn x ^ (-w.re) ≤ nn x ^ (-c) :=
      Real.rpow_le_rpow_of_exponent_le (hn x) (neg_le_neg hw)
    exact mul_le_mul_of_nonneg_left hmono (mul_nonneg (ha x) (pow_nonneg (hLnn x) k))
  have hV : IsOpen {w : ℂ | 1 < w.re} := isOpen_lt continuous_const Complex.continuous_re
  have key : ∀ (k : ℕ) (z : ℂ), 1 < z.re →
      iteratedDeriv k Φ z
        = ∑' x, (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-z) := by
    intro k
    induction k with
    | zero =>
      intro z hz
      rw [iteratedDeriv_zero, heq z hz]
      exact tsum_congr (fun x => by rw [pow_zero, mul_one])
    | succ k IH =>
      intro z hz
      have hzV : z ∈ {w : ℂ | 1 < w.re} := hz
      have hee : iteratedDeriv k Φ =ᶠ[nhds z]
          (fun w : ℂ =>
            ∑' x, (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-w)) :=
        Filter.eventuallyEq_of_mem (hV.mem_nhds hzV) (fun w hw => IH w hw)
      rw [iteratedDeriv_succ, hee.deriv_eq]
      obtain ⟨c, hc1, hcz⟩ : ∃ c : ℝ, 1 < c ∧ c < z.re :=
        ⟨(1 + z.re) / 2, by linarith, by linarith⟩
      have hU : IsOpen {w : ℂ | c < w.re} := isOpen_lt continuous_const Complex.continuous_re
      have hzU : z ∈ {w : ℂ | c < w.re} := hcz
      have hdiff : ∀ x : X, DifferentiableOn ℂ
          (fun w : ℂ => (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-w))
          {w : ℂ | c < w.re} := by
        intro x
        refine Differentiable.differentiableOn ?_
        intro w
        exact (hterm x k w).differentiableAt
      have hbnd : ∀ x : X, ∀ w ∈ {w : ℂ | c < w.re},
          ‖(a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-w)‖
            ≤ a x * Real.log (nn x) ^ k * nn x ^ (-c) := by
        intro x w hw
        simp only [Set.mem_setOf_eq] at hw
        exact hbd x k c w (le_of_lt hw)
      have hsum := Complex.hasSum_deriv_of_summable_norm
        (u := fun x : X => a x * Real.log (nn x) ^ k * nn x ^ (-c))
        (hlog k c hc1) hdiff hU hbnd hzU
      have hsum2 : HasSum
          (fun x : X => (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ (k + 1) * (nn x : ℂ) ^ (-z))
          (deriv (fun w : ℂ =>
            ∑' x, (a x : ℂ) * (-(Real.log (nn x)) : ℂ) ^ k * (nn x : ℂ) ^ (-w)) z) := by
        refine hsum.congr_fun ?_
        intro x
        exact ((hterm x k z).deriv).symm
      exact hsum2.tsum_eq.symm
  exact key m s hs

theorem kai_ideal_divisor_sum_nonneg (K : Type u) [Field K] [NumberField K]
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hmul : ∀ I J : Ideal (NumberField.RingOfIntegers K),
        lam (I * J) = lam I * lam J)
    (hone : lam 1 = 1)
    (hval : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        lam I = 1 ∨ lam I = -1 ∨ lam I = 0) :
    ∃ aa : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ I : Ideal (NumberField.RingOfIntegers K), 0 ≤ aa I) ∧
      (∀ J : Ideal (NumberField.RingOfIntegers K), J ≠ 0 → 1 ≤ aa (J * J)) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        ((aa I : ℂ) =
          ∑' J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I},
            lam (J : Ideal (NumberField.RingOfIntegers K)))) :=
by
  classical
  obtain ⟨S, hS⟩ : ∃ S : Ideal (NumberField.RingOfIntegers K) → ℂ,
      ∀ I : Ideal (NumberField.RingOfIntegers K),
        S I = ∑' J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I},
                lam (J : Ideal (NumberField.RingOfIntegers K)) := ⟨_, fun _ => rfl⟩
  have hfin : ∀ y : Ideal (NumberField.RingOfIntegers K), y ≠ 0 →
      Finite {D : Ideal (NumberField.RingOfIntegers K) // D ∣ y} :=
    fun y hy => Fintype.finite (UniqueFactorizationMonoid.fintypeSubtypeDvd y hy)
  have hbij : ∀ x y : Ideal (NumberField.RingOfIntegers K), IsRelPrime x y →
      ∃ e : ({A : Ideal (NumberField.RingOfIntegers K) // A ∣ x} ×
             {B : Ideal (NumberField.RingOfIntegers K) // B ∣ y}) ≃
            {D : Ideal (NumberField.RingOfIntegers K) // D ∣ x * y},
        ∀ p : {A : Ideal (NumberField.RingOfIntegers K) // A ∣ x} ×
              {B : Ideal (NumberField.RingOfIntegers K) // B ∣ y},
          ((e p : Ideal (NumberField.RingOfIntegers K)))
            = (p.1 : Ideal (NumberField.RingOfIntegers K)) *
              (p.2 : Ideal (NumberField.RingOfIntegers K)) := by
    intro x y hxy
    refine ⟨Equiv.ofBijective
      (fun p : {A : Ideal (NumberField.RingOfIntegers K) // A ∣ x} ×
               {B : Ideal (NumberField.RingOfIntegers K) // B ∣ y} =>
        (⟨(p.1 : Ideal (NumberField.RingOfIntegers K)) *
            (p.2 : Ideal (NumberField.RingOfIntegers K)), mul_dvd_mul p.1.2 p.2.2⟩ :
          {D : Ideal (NumberField.RingOfIntegers K) // D ∣ x * y})) ⟨?_, ?_⟩, fun p => rfl⟩
    · intro p q hEq
      obtain ⟨⟨A₁, h₁⟩, ⟨B₁, k₁⟩⟩ := p
      obtain ⟨⟨A₂, h₂⟩, ⟨B₂, k₂⟩⟩ := q
      have hE : A₁ * B₁ = A₂ * B₂ := congrArg Subtype.val hEq
      have hA : A₁ = A₂ := by
        have hr1 : IsRelPrime A₁ B₂ := (hxy.of_dvd_left h₁).of_dvd_right k₂
        have hr2 : IsRelPrime A₂ B₁ := (hxy.of_dvd_left h₂).of_dvd_right k₁
        have d1 : A₁ ∣ A₂ * B₂ := by rw [← hE]; exact dvd_mul_right A₁ B₁
        have d2 : A₂ ∣ A₁ * B₁ := by rw [hE]; exact dvd_mul_right A₂ B₂
        exact le_antisymm (Ideal.dvd_iff_le.mp (hr2.dvd_of_dvd_mul_right d2))
          (Ideal.dvd_iff_le.mp (hr1.dvd_of_dvd_mul_right d1))
      have hB : B₁ = B₂ := by
        have hr1 : IsRelPrime B₁ A₂ := (hxy.symm.of_dvd_left k₁).of_dvd_right h₂
        have hr2 : IsRelPrime B₂ A₁ := (hxy.symm.of_dvd_left k₂).of_dvd_right h₁
        have d1 : B₁ ∣ A₂ * B₂ := by rw [← hE]; exact dvd_mul_left B₁ A₁
        have d2 : B₂ ∣ A₁ * B₁ := by rw [hE]; exact dvd_mul_left B₂ A₂
        exact le_antisymm (Ideal.dvd_iff_le.mp (hr2.dvd_of_dvd_mul_left d2))
          (Ideal.dvd_iff_le.mp (hr1.dvd_of_dvd_mul_left d1))
      simp only [Prod.mk.injEq, Subtype.mk.injEq]
      exact ⟨hA, hB⟩
    · intro D'
      obtain ⟨D, hD⟩ := D'
      obtain ⟨a₁, a₂, ha₁, ha₂, hDeq⟩ := exists_dvd_and_dvd_of_dvd_mul hD
      exact ⟨(⟨a₁, ha₁⟩, ⟨a₂, ha₂⟩), Subtype.ext hDeq.symm⟩
  have hSmul : ∀ x y : Ideal (NumberField.RingOfIntegers K), x ≠ 0 → y ≠ 0 →
      IsRelPrime x y → S (x * y) = S x * S y := by
    intro x y hx hy hxy
    obtain ⟨e, he⟩ := hbij x y hxy
    haveI := hfin x hx
    haveI := hfin y hy
    have hgs : Summable (fun A : {A : Ideal (NumberField.RingOfIntegers K) // A ∣ x} =>
        ‖lam (A : Ideal (NumberField.RingOfIntegers K))‖) := Summable.of_finite
    have hhs : Summable (fun B : {B : Ideal (NumberField.RingOfIntegers K) // B ∣ y} =>
        ‖lam (B : Ideal (NumberField.RingOfIntegers K))‖) := Summable.of_finite
    simp only [hS]
    calc (∑' D : {D : Ideal (NumberField.RingOfIntegers K) // D ∣ x * y},
            lam (D : Ideal (NumberField.RingOfIntegers K)))
        = ∑' p : ({A : Ideal (NumberField.RingOfIntegers K) // A ∣ x} ×
                  {B : Ideal (NumberField.RingOfIntegers K) // B ∣ y}),
            lam ((e p : Ideal (NumberField.RingOfIntegers K))) :=
          (e.tsum_eq (fun D : {D : Ideal (NumberField.RingOfIntegers K) // D ∣ x * y} =>
            lam (D : Ideal (NumberField.RingOfIntegers K)))).symm
      _ = ∑' p : ({A : Ideal (NumberField.RingOfIntegers K) // A ∣ x} ×
                  {B : Ideal (NumberField.RingOfIntegers K) // B ∣ y}),
            lam (p.1 : Ideal (NumberField.RingOfIntegers K)) *
              lam (p.2 : Ideal (NumberField.RingOfIntegers K)) :=
          tsum_congr (fun p => by rw [he p, hmul])
      _ = (∑' A : {A : Ideal (NumberField.RingOfIntegers K) // A ∣ x},
              lam (A : Ideal (NumberField.RingOfIntegers K))) *
          (∑' B : {B : Ideal (NumberField.RingOfIntegers K) // B ∣ y},
              lam (B : Ideal (NumberField.RingOfIntegers K))) :=
          (tsum_mul_tsum_of_summable_norm hgs hhs).symm
  have hS1 : S 1 = 1 := by
    rw [hS]
    have hu : ∀ b : {J : Ideal (NumberField.RingOfIntegers K) //
        J ∣ (1 : Ideal (NumberField.RingOfIntegers K))}, b = ⟨1, dvd_rfl⟩ := by
      intro b
      apply Subtype.ext
      have h := isUnit_of_dvd_one b.2
      rw [Ideal.isUnit_iff] at h
      rw [h, Ideal.one_eq_top]
    rw [tsum_eq_single ⟨1, dvd_rfl⟩ (fun b' hb' => absurd (hu b') hb')]
    exact hone
  have hpow : ∀ (p : Ideal (NumberField.RingOfIntegers K)) (i : ℕ),
      lam (p ^ i) = (lam p) ^ i := by
    intro p i
    induction i with
    | zero => simpa using hone
    | succ j ih => rw [pow_succ, hmul, ih, pow_succ]
  have hbijpow : ∀ p : Ideal (NumberField.RingOfIntegers K), Prime p → ∀ n : ℕ,
      ∃ e : Fin (n + 1) ≃ {D : Ideal (NumberField.RingOfIntegers K) // D ∣ p ^ n},
        ∀ i : Fin (n + 1),
          ((e i : Ideal (NumberField.RingOfIntegers K))) = p ^ (i : ℕ) := by
    intro p hp n
    refine ⟨Equiv.ofBijective
      (fun i : Fin (n + 1) =>
        (⟨p ^ (i : ℕ), pow_dvd_pow p (Nat.lt_succ_iff.mp i.isLt)⟩ :
          {D : Ideal (NumberField.RingOfIntegers K) // D ∣ p ^ n})) ⟨?_, ?_⟩, fun i => rfl⟩
    · intro i j hij
      have h : p ^ (i : ℕ) = p ^ (j : ℕ) := congrArg Subtype.val hij
      exact Fin.ext (pow_injective_of_not_isUnit hp.not_unit hp.ne_zero h)
    · intro D'
      obtain ⟨D, hD⟩ := D'
      obtain ⟨i, hi, hass⟩ := (dvd_prime_pow hp n).mp hD
      have hDe : D = p ^ i :=
        le_antisymm (Ideal.dvd_iff_le.mp hass.symm.dvd) (Ideal.dvd_iff_le.mp hass.dvd)
      exact ⟨⟨i, Nat.lt_succ_of_le hi⟩, Subtype.ext hDe.symm⟩
  have hSpow : ∀ p : Ideal (NumberField.RingOfIntegers K), Prime p → ∀ n : ℕ,
      S (p ^ n) = ∑ k ∈ Finset.range (n + 1), (lam p) ^ k := by
    intro p hp n
    obtain ⟨e, he⟩ := hbijpow p hp n
    rw [hS]
    calc (∑' D : {D : Ideal (NumberField.RingOfIntegers K) // D ∣ p ^ n},
            lam (D : Ideal (NumberField.RingOfIntegers K)))
        = ∑' i : Fin (n + 1), lam ((e i : Ideal (NumberField.RingOfIntegers K))) :=
          (e.tsum_eq (fun D : {D : Ideal (NumberField.RingOfIntegers K) // D ∣ p ^ n} =>
            lam (D : Ideal (NumberField.RingOfIntegers K)))).symm
      _ = ∑' i : Fin (n + 1), (lam p) ^ (i : ℕ) := tsum_congr (fun i => by rw [he i, hpow])
      _ = ∑ i : Fin (n + 1), (lam p) ^ (i : ℕ) := tsum_fintype _
      _ = ∑ k ∈ Finset.range (n + 1), (lam p) ^ k :=
          Fin.sum_univ_eq_sum_range (fun k => (lam p) ^ k) (n + 1)
  have hgeom : ∀ x : ℂ, (x = 1 ∨ x = -1 ∨ x = 0) → ∀ n : ℕ,
      ∃ m : ℕ, (∑ k ∈ Finset.range (n + 1), x ^ k) = (m : ℂ) ∧ (Even n → 1 ≤ m) := by
    intro x hx n
    rcases hx with rfl | rfl | rfl
    · refine ⟨n + 1, ?_, fun _ => Nat.succ_le_succ (Nat.zero_le n)⟩
      simp
    · refine ⟨if Even n then 1 else 0, ?_, ?_⟩
      · rw [neg_one_geom_sum]
        by_cases h : Even n
        · rw [if_neg (by rw [Nat.even_add_one]; exact not_not_intro h), if_pos h]
          norm_num
        · rw [if_pos (by rw [Nat.even_add_one]; exact h), if_neg h]
          norm_num
      · intro h
        rw [if_pos h]
    · refine ⟨1, ?_, fun _ => le_refl 1⟩
      rw [Finset.sum_eq_single (0 : ℕ)]
      · norm_num
      · intro b _ hb
        exact zero_pow hb
      · intro h
        exact absurd (Finset.mem_range.mpr (Nat.succ_pos n)) h
  have hQ : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      (∃ n : ℕ, S I = (n : ℂ)) ∧ (∃ m : ℕ, S (I * I) = (m : ℂ) ∧ 1 ≤ m) := by
    intro I
    refine UniqueFactorizationMonoid.induction_on_coprime
      (P := fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0 →
        (∃ n : ℕ, S I = (n : ℂ)) ∧ (∃ m : ℕ, S (I * I) = (m : ℂ) ∧ 1 ≤ m))
      I ?_ ?_ ?_ ?_
    · intro h
      exact absurd rfl h
    · intro u hu _
      have hu1 : u = 1 := by
        rw [Ideal.isUnit_iff] at hu
        rw [hu, Ideal.one_eq_top]
      subst hu1
      exact ⟨⟨1, by rw [hS1]; norm_num⟩, ⟨1, by rw [mul_one, hS1]; norm_num, le_refl 1⟩⟩
    · intro p i hp _
      have hx : lam p = 1 ∨ lam p = -1 ∨ lam p = 0 := hval p hp.ne_zero
      constructor
      · obtain ⟨n₀, hn₀, -⟩ := hgeom (lam p) hx i
        exact ⟨n₀, by rw [hSpow p hp i, hn₀]⟩
      · obtain ⟨m₀, hm₀, hm₀'⟩ := hgeom (lam p) hx (i + i)
        refine ⟨m₀, ?_, hm₀' ⟨i, rfl⟩⟩
        rw [← pow_add, hSpow p hp (i + i), hm₀]
    · intro x y hxy Qx Qy hne
      have hx : x ≠ 0 := by
        intro h
        exact hne (by rw [h, zero_mul])
      have hy : y ≠ 0 := by
        intro h
        exact hne (by rw [h, mul_zero])
      obtain ⟨⟨n₁, hn₁⟩, ⟨m₁, hm₁, hm₁'⟩⟩ := Qx hx
      obtain ⟨⟨n₂, hn₂⟩, ⟨m₂, hm₂, hm₂'⟩⟩ := Qy hy
      constructor
      · refine ⟨n₁ * n₂, ?_⟩
        rw [hSmul x y hx hy hxy, hn₁, hn₂]
        push_cast
        ring
      · refine ⟨m₁ * m₂, ?_, by simpa using Nat.mul_le_mul hm₁' hm₂'⟩
        rw [mul_mul_mul_comm x y x y,
          hSmul (x * x) (y * y) (mul_ne_zero hx hx) (mul_ne_zero hy hy)
            ((hxy.mul_right hxy).mul_left (hxy.mul_right hxy)),
          hm₁, hm₂]
        push_cast
        ring
  obtain ⟨aa, haa⟩ : ∃ aa : Ideal (NumberField.RingOfIntegers K) → ℝ,
      ∀ I : Ideal (NumberField.RingOfIntegers K), aa I = |(S I).re| := ⟨_, fun _ => rfl⟩
  refine ⟨aa, ?_, ?_, ?_⟩
  · intro I
    rw [haa]
    exact abs_nonneg _
  · intro J hJ
    obtain ⟨-, ⟨m, hm, hm'⟩⟩ := hQ J hJ
    rw [haa, hm, Complex.natCast_re, abs_of_nonneg (Nat.cast_nonneg m)]
    exact_mod_cast hm'
  · intro I hI
    obtain ⟨⟨n, hn⟩, -⟩ := hQ I hI
    rw [← hS I, haa, hn, Complex.natCast_re, abs_of_nonneg (Nat.cast_nonneg n)]
    exact Complex.ofReal_natCast n

theorem kai_ld_zeta_summable (K : Type u) [Field K] [NumberField K] :
    ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)) :=
by
  classical
  have hfin : ∀ m : ℕ,
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ m}.Finite :=
    fun m => Ideal.finite_setOf_absNorm_le m
  have hfin' : ∀ m : ℕ,
      {I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m}.Finite :=
    fun m => (hfin m).subset (fun I hI => hI.2)
  have hone : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → 1 ≤ Ideal.absNorm I := by
    intro I hI
    rcases Nat.eq_zero_or_pos (Ideal.absNorm I) with h0 | h0
    · exact absurd (Ideal.absNorm_eq_zero_iff.mp h0) (by rwa [Submodule.zero_eq_bot] at hI)
    · exact h0
  obtain ⟨C, hC1, hCle⟩ : ∃ C : ℝ, 1 ≤ C ∧ ∀ m : ℕ,
      (({I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m}).ncard : ℝ)
        ≤ C * (m : ℝ) := by
    obtain ⟨L, htend⟩ : ∃ L : ℝ, Filter.Tendsto
        (fun s : ℝ => (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
          ((Ideal.absNorm I : ℕ) : ℝ) ≤ s} : ℝ) / s) Filter.atTop (nhds L) :=
      ⟨_, NumberField.Ideal.tendsto_norm_le_div_atTop K⟩
    obtain ⟨x₁, hx₁⟩ := Filter.eventually_atTop.mp
      (htend.eventually_lt_const (by linarith : L < L + 1))
    obtain ⟨x₀, hx₀1, hx₀⟩ : ∃ x₀ : ℝ, 1 ≤ x₀ ∧ ∀ x : ℝ, x₀ ≤ x →
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
          ((Ideal.absNorm I : ℕ) : ℝ) ≤ x} : ℝ) / x < L + 1 :=
      ⟨max x₁ 1, le_max_right _ _, fun x hx => hx₁ x (le_trans (le_max_left _ _) hx)⟩
    obtain ⟨m₀, hm₀⟩ : ∃ m₀ : ℕ, x₀ ≤ (m₀ : ℝ) := ⟨⌈x₀⌉₊, Nat.le_ceil x₀⟩
    set D : ℝ := (({I : Ideal (NumberField.RingOfIntegers K) |
        I ≠ 0 ∧ Ideal.absNorm I ≤ m₀}).ncard : ℝ) with hDdef
    have hD0 : (0:ℝ) ≤ D := Nat.cast_nonneg _
    refine ⟨max (L + 1) (max D 1), le_trans (le_max_right D 1) (le_max_right _ _), ?_⟩
    intro m
    have hCL : L + 1 ≤ max (L + 1) (max D 1) := le_max_left _ _
    have hCD : D ≤ max (L + 1) (max D 1) := le_trans (le_max_left D 1) (le_max_right _ _)
    have hC1' : (1:ℝ) ≤ max (L + 1) (max D 1) := le_trans (le_max_right D 1) (le_max_right _ _)
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      have hempty : {I : Ideal (NumberField.RingOfIntegers K) |
          I ≠ 0 ∧ Ideal.absNorm I ≤ 0} = ∅ := by
        ext I
        simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_and]
        intro hI0 hIn
        exact absurd (le_trans (hone I hI0) hIn) (by omega)
      rw [hempty, Set.ncard_empty]
      simp
    · have hm1 : (1:ℝ) ≤ (m:ℝ) := by exact_mod_cast hm
      by_cases hbig : x₀ ≤ (m:ℝ)
      · have hmpos : (0:ℝ) < (m:ℝ) := by linarith
        have hlt := hx₀ (m:ℝ) hbig
        have hFm : (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
            ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} : ℝ) < (L + 1) * (m:ℝ) :=
          (div_lt_iff₀ hmpos).mp hlt
        have hsub : {I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m}
            ⊆ {I : Ideal (NumberField.RingOfIntegers K) |
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} := by
          rintro I ⟨-, hIn⟩
          exact_mod_cast hIn
        have hUfin : {I : Ideal (NumberField.RingOfIntegers K) |
            ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)}.Finite := by
          refine (hfin m).subset ?_
          intro I hI
          exact_mod_cast hI
        have hcoe : (({I : Ideal (NumberField.RingOfIntegers K) |
            ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)}).ncard)
            = Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} := rfl
        have hnc : (({I : Ideal (NumberField.RingOfIntegers K) |
              I ≠ 0 ∧ Ideal.absNorm I ≤ m}).ncard : ℝ)
            ≤ (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} : ℝ) := by
          have h := Set.ncard_le_ncard hsub hUfin
          rw [hcoe] at h
          exact_mod_cast h
        have hfinal : (L + 1) * (m:ℝ) ≤ max (L + 1) (max D 1) * (m:ℝ) :=
          mul_le_mul_of_nonneg_right hCL (by linarith)
        linarith
      · push_neg at hbig
        have hmle : m ≤ m₀ := by
          have h : (m:ℝ) ≤ (m₀:ℝ) := le_trans hbig.le hm₀
          exact_mod_cast h
        have hsub : {I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m}
            ⊆ {I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m₀} := by
          rintro I ⟨h1, h2⟩
          exact ⟨h1, le_trans h2 hmle⟩
        have hnc : (({I : Ideal (NumberField.RingOfIntegers K) |
              I ≠ 0 ∧ Ideal.absNorm I ≤ m}).ncard : ℝ) ≤ D := by
          rw [hDdef]
          exact_mod_cast Set.ncard_le_ncard hsub (hfin' m₀)
        have hfinal : max (L + 1) (max D 1) * 1 ≤ max (L + 1) (max D 1) * (m:ℝ) :=
          mul_le_mul_of_nonneg_left hm1 (by linarith)
        rw [mul_one] at hfinal
        linarith
  have dyadic : ∀ (α : Type u) (g : α → ℕ) (Cc σ : ℝ), 1 < σ → 0 ≤ Cc →
      (∀ a : α, 1 ≤ g a) →
      (∀ n : ℕ, ∃ s : Finset α, (∀ a : α, g a ≤ n → a ∈ s) ∧ (s.card : ℝ) ≤ Cc * (n:ℝ)) →
      Summable (fun a : α => ((g a : ℝ)) ^ (-σ)) := by
    intro α g Cc σ hσ hCc0 hg1 hcnt
    have hρ0 : (0:ℝ) < (2:ℝ) ^ (-σ) := Real.rpow_pos_of_pos (by norm_num) _
    have hρhalf : (2:ℝ) ^ (-σ) < 1/2 := by
      have h2 : (2:ℝ) ^ (-σ) < (2:ℝ) ^ (-1 : ℝ) :=
        (Real.rpow_lt_rpow_left_iff (by norm_num : (1:ℝ) < 2)).mpr (by linarith)
      rw [Real.rpow_neg_one] at h2
      norm_num at h2
      linarith
    have hr0 : (0:ℝ) ≤ 2 * (2:ℝ) ^ (-σ) := by linarith
    have hr1 : 2 * (2:ℝ) ^ (-σ) < 1 := by linarith
    have hpow : ∀ k : ℕ, ((2:ℝ) ^ k) ^ (-σ) = ((2:ℝ) ^ (-σ)) ^ k := by
      intro k
      rw [← Real.rpow_natCast (2:ℝ) k, ← Real.rpow_natCast ((2:ℝ) ^ (-σ)) k,
        ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2), ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]
      ring_nf
    have hpt : ∀ a : α, ((g a : ℝ)) ^ (-σ) ≤ ((2:ℝ) ^ (-σ)) ^ (Nat.log 2 (g a)) := by
      intro a
      have hne : g a ≠ 0 := by have := hg1 a; omega
      have hle : (2:ℝ) ^ (Nat.log 2 (g a)) ≤ (g a : ℝ) := by
        exact_mod_cast Nat.pow_log_le_self 2 hne
      have hpos : (0:ℝ) < (2:ℝ) ^ (Nat.log 2 (g a)) := by positivity
      have h := Real.rpow_le_rpow_of_nonpos hpos hle (by linarith : -σ ≤ 0)
      rwa [hpow] at h
    refine summable_of_sum_le (c := 2 * Cc * (1 - 2 * (2:ℝ) ^ (-σ))⁻¹)
      (fun a => Real.rpow_nonneg (Nat.cast_nonneg _) _) ?_
    intro u
    have hsplit := Finset.sum_fiberwise_of_maps_to
      (s := u) (t := u.image (fun a => Nat.log 2 (g a)))
      (g := fun a : α => Nat.log 2 (g a))
      (fun a ha => Finset.mem_image_of_mem _ ha) (fun a : α => ((g a : ℝ)) ^ (-σ))
    rw [← hsplit]
    have hblock : ∀ k ∈ u.image (fun a : α => Nat.log 2 (g a)),
        (∑ a ∈ u.filter (fun a : α => Nat.log 2 (g a) = k), ((g a : ℝ)) ^ (-σ))
          ≤ 2 * Cc * (2 * (2:ℝ) ^ (-σ)) ^ k := by
      intro k _
      obtain ⟨s, hs1, hs2⟩ := hcnt (2 ^ (k + 1))
      have hsubF : u.filter (fun a : α => Nat.log 2 (g a) = k) ⊆ s := by
        intro a ha
        rw [Finset.mem_filter] at ha
        refine hs1 a ?_
        have hlt : g a < 2 ^ (Nat.log 2 (g a) + 1) := Nat.lt_pow_succ_log_self (by norm_num) _
        rw [ha.2] at hlt
        omega
      have hcard : ((u.filter (fun a : α => Nat.log 2 (g a) = k)).card : ℝ)
          ≤ Cc * (2:ℝ) ^ (k + 1) := by
        have h1 : ((u.filter (fun a : α => Nat.log 2 (g a) = k)).card : ℝ) ≤ (s.card : ℝ) := by
          exact_mod_cast Finset.card_le_card hsubF
        have h2 : (((2 ^ (k + 1) : ℕ)) : ℝ) = (2:ℝ) ^ (k + 1) := by push_cast; ring
        rw [h2] at hs2
        linarith
      have hsum1 : (∑ a ∈ u.filter (fun a : α => Nat.log 2 (g a) = k), ((g a : ℝ)) ^ (-σ))
          ≤ (u.filter (fun a : α => Nat.log 2 (g a) = k)).card • (((2:ℝ) ^ (-σ)) ^ k) := by
        refine Finset.sum_le_card_nsmul _ _ _ ?_
        intro a ha
        rw [Finset.mem_filter] at ha
        have h := hpt a
        rw [ha.2] at h
        exact h
      rw [nsmul_eq_mul] at hsum1
      refine hsum1.trans ?_
      have hρk : (0:ℝ) ≤ ((2:ℝ) ^ (-σ)) ^ k := pow_nonneg hρ0.le k
      calc ((u.filter (fun a : α => Nat.log 2 (g a) = k)).card : ℝ) * ((2:ℝ) ^ (-σ)) ^ k
          ≤ (Cc * (2:ℝ) ^ (k + 1)) * ((2:ℝ) ^ (-σ)) ^ k :=
            mul_le_mul_of_nonneg_right hcard hρk
        _ = 2 * Cc * (2 * (2:ℝ) ^ (-σ)) ^ k := by rw [mul_pow]; ring
    calc (∑ k ∈ u.image (fun a : α => Nat.log 2 (g a)),
            ∑ a ∈ u.filter (fun a : α => Nat.log 2 (g a) = k), ((g a : ℝ)) ^ (-σ))
        ≤ ∑ _k ∈ u.image (fun a : α => Nat.log 2 (g a)),
            2 * Cc * (2 * (2:ℝ) ^ (-σ)) ^ _k := Finset.sum_le_sum hblock
      _ = 2 * Cc * ∑ _k ∈ u.image (fun a : α => Nat.log 2 (g a)),
            (2 * (2:ℝ) ^ (-σ)) ^ _k := by rw [Finset.mul_sum]
      _ ≤ 2 * Cc * ∑' k : ℕ, (2 * (2:ℝ) ^ (-σ)) ^ k := by
            refine mul_le_mul_of_nonneg_left ?_ (by linarith)
            exact Summable.sum_le_tsum _ (fun k _ => pow_nonneg hr0 k)
              (summable_geometric_of_lt_one hr0 hr1)
      _ = 2 * Cc * (1 - 2 * (2:ℝ) ^ (-σ))⁻¹ := by rw [tsum_geometric_of_lt_one hr0 hr1]
  intro σ hσ
  refine dyadic {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}
    (fun a => Ideal.absNorm (a : Ideal (NumberField.RingOfIntegers K))) C σ hσ (by linarith)
    (fun a => hone _ a.2) ?_
  intro n
  refine ⟨Finset.subtype (fun I => I ≠ 0) ((hfin' n).toFinset), ?_, ?_⟩
  · intro a ha
    rw [Finset.mem_subtype, Set.Finite.mem_toFinset]
    exact ⟨a.2, ha⟩
  · have hle : (Finset.subtype (fun I => I ≠ 0) ((hfin' n).toFinset)).card
        ≤ ((hfin' n).toFinset).card := by
      refine Finset.card_le_card_of_injOn Subtype.val ?_ ?_
      · intro a ha
        simp only [Finset.mem_coe, Finset.mem_subtype] at ha ⊢
        exact ha
      · intro a _ b _ h
        exact Subtype.val_injective h
    have h2 : (((hfin' n).toFinset).card : ℝ)
        = (({I : Ideal (NumberField.RingOfIntegers K) |
          I ≠ 0 ∧ Ideal.absNorm I ≤ n}).ncard : ℝ) := by
      rw [Set.ncard_eq_toFinset_card _ (hfin' n)]
    have h3 := hCle n
    have h4 : ((Finset.subtype (fun I => I ≠ 0) ((hfin' n).toFinset)).card : ℝ)
        ≤ (((hfin' n).toFinset).card : ℝ) := by exact_mod_cast hle
    linarith

theorem kai_hecke_real_one_ne_zero_00 (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    KaiZFRealOneNeZeroProp K :=
by
  classical
  intro q hq ξ η lam hext hreal hnp Zeta hZetaDiff hZetaEq Zf hZfDiff hZfEq hZ0
  
  have hs3 : ∀ (a nn : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} → ℝ),
      (∀ x, 0 ≤ a x) → (∀ x, 1 ≤ nn x) → ∀ (m : ℕ) (σ σ' : ℝ), σ < σ' →
      Summable (fun x => a x * nn x ^ (-σ)) →
      Summable (fun x => a x * Real.log (nn x) ^ m * nn x ^ (-σ')) := by
    intro a nn ha hn m σ σ' hσσ' hs
    clear * - ha hn hσσ' hs
    have hN : ∀ x, (0 : ℝ) < nn x := fun x => lt_of_lt_of_le zero_lt_one (hn x)
    have hε : (0 : ℝ) < σ' - σ := sub_pos.mpr hσσ'
    have hm1 : (0 : ℝ) < (m : ℝ) + 1 := by positivity
    have hδ : (0 : ℝ) < (σ' - σ) / ((m : ℝ) + 1) := div_pos hε hm1
    have hC : (0 : ℝ) < (((m : ℝ) + 1) / (σ' - σ)) ^ m := pow_pos (div_pos hm1 hε) m
    have hδm : (σ' - σ) / ((m : ℝ) + 1) * (m : ℝ) ≤ σ' - σ := by
      rw [div_mul_eq_mul_div, div_le_iff₀ hm1]
      nlinarith [hε.le, Nat.cast_nonneg (α := ℝ) m]
    have key : ∀ x, Real.log (nn x) ^ m
        ≤ (((m : ℝ) + 1) / (σ' - σ)) ^ m * nn x ^ (σ' - σ) := by
      intro x
      have h1 : Real.log (nn x)
          ≤ nn x ^ ((σ' - σ) / ((m : ℝ) + 1)) / ((σ' - σ) / ((m : ℝ) + 1)) :=
        Real.log_le_rpow_div (hN x).le hδ
      have h2 : Real.log (nn x) ^ m
          ≤ (nn x ^ ((σ' - σ) / ((m : ℝ) + 1)) / ((σ' - σ) / ((m : ℝ) + 1))) ^ m :=
        pow_le_pow_left₀ (Real.log_nonneg (hn x)) h1 m
      have h3 : (nn x ^ ((σ' - σ) / ((m : ℝ) + 1)) / ((σ' - σ) / ((m : ℝ) + 1))) ^ m
          = (((m : ℝ) + 1) / (σ' - σ)) ^ m * (nn x ^ ((σ' - σ) / ((m : ℝ) + 1))) ^ m := by
        rw [div_eq_inv_mul, mul_pow, inv_div]
      have h4 : (nn x ^ ((σ' - σ) / ((m : ℝ) + 1))) ^ m
          = nn x ^ ((σ' - σ) / ((m : ℝ) + 1) * (m : ℝ)) :=
        (Real.rpow_mul_natCast (hN x).le ((σ' - σ) / ((m : ℝ) + 1)) m).symm
      have h5 : nn x ^ ((σ' - σ) / ((m : ℝ) + 1) * (m : ℝ)) ≤ nn x ^ (σ' - σ) :=
        Real.rpow_le_rpow_of_exponent_le (hn x) hδm
      calc Real.log (nn x) ^ m
          ≤ (nn x ^ ((σ' - σ) / ((m : ℝ) + 1)) / ((σ' - σ) / ((m : ℝ) + 1))) ^ m := h2
        _ = (((m : ℝ) + 1) / (σ' - σ)) ^ m * (nn x ^ ((σ' - σ) / ((m : ℝ) + 1))) ^ m := h3
        _ = (((m : ℝ) + 1) / (σ' - σ)) ^ m
              * nn x ^ ((σ' - σ) / ((m : ℝ) + 1) * (m : ℝ)) := by rw [h4]
        _ ≤ (((m : ℝ) + 1) / (σ' - σ)) ^ m * nn x ^ (σ' - σ) :=
            mul_le_mul_of_nonneg_left h5 hC.le
    have hexp : ∀ x, nn x ^ (σ' - σ) * nn x ^ (-σ') = nn x ^ (-σ) := by
      intro x
      rw [← Real.rpow_add (hN x)]
      congr 1
      ring
    have hnonneg : ∀ x, 0 ≤ a x * Real.log (nn x) ^ m * nn x ^ (-σ') := by
      intro x
      exact mul_nonneg (mul_nonneg (ha x) (pow_nonneg (Real.log_nonneg (hn x)) m))
        (Real.rpow_nonneg (hN x).le (-σ'))
    have hbound : ∀ x, a x * Real.log (nn x) ^ m * nn x ^ (-σ')
        ≤ (((m : ℝ) + 1) / (σ' - σ)) ^ m * (a x * nn x ^ (-σ)) := by
      intro x
      have h6 : Real.log (nn x) ^ m * nn x ^ (-σ')
          ≤ ((((m : ℝ) + 1) / (σ' - σ)) ^ m * nn x ^ (σ' - σ)) * nn x ^ (-σ') :=
        mul_le_mul_of_nonneg_right (key x) (Real.rpow_nonneg (hN x).le (-σ'))
      have h7 : a x * (Real.log (nn x) ^ m * nn x ^ (-σ'))
          ≤ a x * (((((m : ℝ) + 1) / (σ' - σ)) ^ m * nn x ^ (σ' - σ)) * nn x ^ (-σ')) :=
        mul_le_mul_of_nonneg_left h6 (ha x)
      calc a x * Real.log (nn x) ^ m * nn x ^ (-σ')
          = a x * (Real.log (nn x) ^ m * nn x ^ (-σ')) := by ring
        _ ≤ a x * (((((m : ℝ) + 1) / (σ' - σ)) ^ m * nn x ^ (σ' - σ)) * nn x ^ (-σ')) := h7
        _ = (((m : ℝ) + 1) / (σ' - σ)) ^ m * (a x * (nn x ^ (σ' - σ) * nn x ^ (-σ'))) := by
            ring
        _ = (((m : ℝ) + 1) / (σ' - σ)) ^ m * (a x * nn x ^ (-σ)) := by rw [hexp x]
    exact Summable.of_nonneg_of_le hnonneg hbound
      (hs.mul_left ((((m : ℝ) + 1) / (σ' - σ)) ^ m))
  
  have hs6 : ∀ m : ℕ, Ideal.absNorm (Ideal.span {((m : ℕ) : NumberField.RingOfIntegers K)})
      = m ^ (Module.finrank ℚ K) := by
    intro m
    clear * -
    have hcast : ((m : ℕ) : NumberField.RingOfIntegers K)
        = algebraMap ℤ (NumberField.RingOfIntegers K) ((m : ℕ) : ℤ) :=
      (map_natCast (algebraMap ℤ (NumberField.RingOfIntegers K)) m).symm
    have hN : Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K))
        = Module.finrank ℚ K :=
      (Module.finrank_eq_card_chooseBasisIndex ℤ (NumberField.RingOfIntegers K)).symm.trans
        (NumberField.RingOfIntegers.rank K)
    rw [Ideal.absNorm_span_singleton, hcast,
      Algebra.norm_algebraMap_of_basis (NumberField.RingOfIntegers.basis K),
      Int.natAbs_pow, Int.natAbs_natCast, hN]
  
  have hone : lam 1 = 1 := hext.1
  have hmul : ∀ I J : Ideal (NumberField.RingOfIntegers K),
      lam (I * J) = lam I * lam J := hext.2.1
  have hnorm1 : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
      ‖lam I‖ = 1 := hext.2.2.1
  have hram : ∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q ≠ ⊤ → lam I = 0 :=
    hext.2.2.2.1
  have hzero : lam 0 = 0 := hext.2.2.2.2.1
  have hval : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      lam I = 1 ∨ lam I = -1 ∨ lam I = 0 := by
    intro I hI
    by_cases hc : I ⊔ q = ⊤
    · have h1 : ‖lam I‖ = 1 := hnorm1 I hI hc
      have him : (lam I).im = 0 := Complex.conj_eq_iff_im.mp (hreal I).symm
      have h2 : ‖lam I‖ ^ 2 = Complex.normSq (lam I) := Complex.sq_norm (lam I)
      rw [h1, Complex.normSq_apply, him] at h2
      have hsq : (lam I).re * (lam I).re = 1 := by linarith [h2]
      rcases mul_self_eq_one_iff.mp hsq with h | h
      · left
        refine Complex.ext ?_ ?_
        · simpa using h
        · simpa using him
      · right; left
        refine Complex.ext ?_ ?_
        · simpa using h
        · simpa using him
    · right; right
      exact hram I hc
  have hbd : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1 := by
    intro I
    by_cases hI : I = 0
    · rw [hI, hzero]; simp
    · rcases hval I hI with h | h | h <;> rw [h] <;> simp
  
  have hUopen : IsOpen {s : ℂ | 0 < s.re} :=
    isOpen_lt continuous_const Complex.continuous_re
  have h1mem : (1 : ℂ) ∈ {s : ℂ | 0 < s.re} := by
    simp only [Set.mem_setOf_eq, Complex.one_re]
    norm_num
  have h1U : {s : ℂ | 0 < s.re} ∈ nhds (1 : ℂ) := hUopen.mem_nhds h1mem
  have hhdiff : DifferentiableOn ℂ (dslope Zf 1) {s : ℂ | 0 < s.re} :=
    (Complex.differentiableOn_dslope h1U).mpr hZfDiff
  have hfac : ∀ s : ℂ, Zf s = (s - 1) * dslope Zf 1 s := by
    intro s
    have h := sub_smul_dslope Zf 1 s
    rw [smul_eq_mul, hZ0, sub_zero] at h
    exact h.symm
  have hΦdiff : DifferentiableOn ℂ (fun s => Zeta s * dslope Zf 1 s)
      {s : ℂ | 0 < s.re} :=
    fun x hx => ((hZetaDiff x).differentiableWithinAt).mul (hhdiff x hx)
  have hΦeq : ∀ s : ℂ, 1 < s.re →
      Zeta s * dslope Zf 1 s
        = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)))
          * kaiHeckeSeries K lam s := by
    intro s hs
    rw [hZetaEq s hs, mul_assoc, ← hfac s, hZfEq s hs]
  
  obtain ⟨aa, haa0, haasq, haaconv⟩ := kai_ideal_divisor_sum_nonneg K lam hmul hone hval
  have hzeta := kai_ld_zeta_summable K
  
  obtain ⟨δ, hδdef⟩ : ∃ δ : Ideal (NumberField.RingOfIntegers K) → ℂ,
