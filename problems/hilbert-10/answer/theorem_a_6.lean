theorem bsg_sumset_count (G : Type) [AddCommGroup G] [DecidableEq G]
    (A A' B' D : Finset G) (p m : ℝ) (hp : 0 ≤ p) (hm : 0 ≤ m)
    (hrep : ∀ d ∈ D, m ≤ (((A ×ˢ A).filter (fun q => q.1 + q.2 = d)).card : ℝ))
    (hpath : ∀ a ∈ A', ∀ b ∈ B', p ≤
      (((A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D)).card : ℝ)) :
    (((A' ×ˢ B').image (fun q => q.1 + q.2)).card : ℝ) * p * m ^ 3 ≤ (A.card : ℝ) ^ 6 :=
by
  classical
  
  have hfib : ∀ a ∈ A', ∀ b ∈ B', p * m ^ 3 ≤
      ((((A ×ˢ A) ×ˢ ((A ×ˢ A) ×ˢ (A ×ˢ A))).filter
        (fun t : (G × G) × ((G × G) × (G × G)) =>
          (t.1.1 + t.1.2) - (t.2.1.1 + t.2.1.2) + (t.2.2.1 + t.2.2.2) = a + b)).card : ℝ) := by
    intro a ha b hb
    have hP := hpath a ha b hb
    let Box : G × G → Finset ((G × G) × ((G × G) × (G × G))) := fun q =>
      ((A ×ˢ A).filter (fun u => u.1 + u.2 = a + q.1)) ×ˢ
        (((A ×ˢ A).filter (fun u => u.1 + u.2 = q.2 + q.1)) ×ˢ
          ((A ×ˢ A).filter (fun u => u.1 + u.2 = q.2 + b)))
    have hsub : ((A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D)).biUnion Box
        ⊆ ((A ×ˢ A) ×ˢ ((A ×ˢ A) ×ˢ (A ×ˢ A))).filter
          (fun t : (G × G) × ((G × G) × (G × G)) =>
            (t.1.1 + t.1.2) - (t.2.1.1 + t.2.1.2) + (t.2.2.1 + t.2.2.2) = a + b) := by
      intro t ht
      rw [Finset.mem_biUnion] at ht
      obtain ⟨q, _, ht⟩ := ht
      simp only [Box, Finset.mem_product, Finset.mem_filter] at ht
      obtain ⟨⟨h1, e1⟩, ⟨h2, e2⟩, ⟨h3, e3⟩⟩ := ht
      rw [Finset.mem_filter]
      refine ⟨?_, ?_⟩
      · simp only [Finset.mem_product]
        exact ⟨h1, h2, h3⟩
      rw [e1, e2, e3]
      abel
    have hdisj : (↑((A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D)) :
        Set (G × G)).PairwiseDisjoint Box := by
      intro q _ q' _ hne
      rw [Function.onFun, Finset.disjoint_left]
      intro t ht ht'
      simp only [Box, Finset.mem_product, Finset.mem_filter] at ht ht'
      apply hne
      have e1 : a + q.1 = a + q'.1 := ht.1.2.symm.trans ht'.1.2
      have e3 : q.2 + b = q'.2 + b := ht.2.2.2.symm.trans ht'.2.2.2
      exact Prod.ext (add_left_cancel e1) (add_right_cancel e3)
    have hbox : ∀ q ∈ (A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D),
        m ^ 3 ≤ ((Box q).card : ℝ) := by
      intro q hq
      rw [Finset.mem_filter] at hq
      obtain ⟨_, hd1, hd2, hd3⟩ := hq
      have r1 := hrep _ hd1
      have r2 := hrep _ hd2
      have r3 := hrep _ hd3
      simp only [Box, Finset.card_product]
      push_cast
      have h23 := mul_le_mul r2 r3 hm (by positivity)
      have h123 := mul_le_mul r1 h23 (mul_nonneg hm hm) (by positivity)
      calc m ^ 3 = m * (m * m) := by ring
        _ ≤ _ := h123
    calc p * m ^ 3
        ≤ (((A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D)).card : ℝ)
            * m ^ 3 := mul_le_mul_of_nonneg_right hP (pow_nonneg hm 3)
      _ = ((A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D)).card • m ^ 3 :=
          (nsmul_eq_mul _ _).symm
      _ ≤ ∑ q ∈ (A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D),
            ((Box q).card : ℝ) := Finset.card_nsmul_le_sum _ _ _ hbox
      _ = ((((A ×ˢ A).filter
            (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D)).biUnion Box).card : ℝ) := by
          rw [Finset.card_biUnion hdisj]; push_cast; rfl
      _ ≤ _ := by exact_mod_cast Finset.card_le_card hsub
  have hsum : ∀ S : Finset G, (∑ s ∈ S, (((A ×ˢ A) ×ˢ ((A ×ˢ A) ×ˢ (A ×ˢ A))).filter
        (fun t : (G × G) × ((G × G) × (G × G)) =>
          (t.1.1 + t.1.2) - (t.2.1.1 + t.2.1.2) + (t.2.2.1 + t.2.2.2) = s)).card)
        ≤ A.card ^ 6 := by
    intro S
    rw [Finset.sum_card_fiberwise_eq_card_filter]
    calc _ ≤ ((A ×ˢ A) ×ˢ ((A ×ˢ A) ×ˢ (A ×ˢ A))).card := Finset.card_filter_le _ _
      _ = A.card ^ 6 := by simp only [Finset.card_product]; ring
  have hS' : ∀ s ∈ (A' ×ˢ B').image (fun q => q.1 + q.2), p * m ^ 3 ≤
      ((((A ×ˢ A) ×ˢ ((A ×ˢ A) ×ˢ (A ×ˢ A))).filter
        (fun t : (G × G) × ((G × G) × (G × G)) =>
          (t.1.1 + t.1.2) - (t.2.1.1 + t.2.1.2) + (t.2.2.1 + t.2.2.2) = s)).card : ℝ) := by
    intro s hs
    rw [Finset.mem_image] at hs
    obtain ⟨q, hq, rfl⟩ := hs
    rw [Finset.mem_product] at hq
    exact hfib q.1 hq.1 q.2 hq.2
  calc (((A' ×ˢ B').image (fun q => q.1 + q.2)).card : ℝ) * p * m ^ 3
      = ((A' ×ˢ B').image (fun q => q.1 + q.2)).card • (p * m ^ 3) := by
        rw [nsmul_eq_mul]; ring
    _ ≤ ∑ s ∈ (A' ×ˢ B').image (fun q => q.1 + q.2),
          ((((A ×ˢ A) ×ˢ ((A ×ˢ A) ×ˢ (A ×ˢ A))).filter
            (fun t : (G × G) × ((G × G) × (G × G)) =>
              (t.1.1 + t.1.2) - (t.2.1.1 + t.2.1.2) + (t.2.2.1 + t.2.2.2) = s)).card : ℝ) :=
        Finset.card_nsmul_le_sum _ _ _ hS'
    _ ≤ (A.card : ℝ) ^ 6 := by exact_mod_cast hsum ((A' ×ˢ B').image (fun q => q.1 + q.2))

theorem bsg_poly : ∃ C : ℕ, 1 ≤ C ∧
    ∀ (G : Type) [AddCommGroup G] [DecidableEq G] (A : Finset G) (K : ℝ),
      1 ≤ K → A.Nonempty → (A.card : ℝ) ^ 3 ≤ K * (A.addEnergy A : ℝ) →
      ∃ A' : Finset G, A' ⊆ A ∧ A'.Nonempty ∧
        (A.card : ℝ) ≤ (C : ℝ) * K ^ C * (A'.card : ℝ) ∧
        (((A' ×ˢ A').image (fun p => p.1 - p.2)).card : ℝ) ≤ (C : ℝ) * K ^ C * (A'.card : ℝ) :=
by
  obtain ⟨C, hC⟩ : ∃ C : ℕ, C = 2 ^ 46 := ⟨_, rfl⟩
  have hC1 : 1 ≤ C := by rw [hC]; norm_num
  have hC18 : 18 ≤ C := by rw [hC]; norm_num
  have hCR : (96 * 786432 ^ 2 : ℝ) ≤ (C : ℝ) := by rw [hC]; push_cast; norm_num
  have hC12 : (12 : ℝ) ≤ (C : ℝ) := le_trans (by norm_num) hCR
  refine ⟨C, hC1, ?_⟩
  intro G _ _ A K hK hA hE
  have hK0 : 0 < K := by linarith
  have hKne : K ≠ 0 := hK0.ne'
  have hn : (0 : ℝ) < (A.card : ℝ) := by exact_mod_cast hA.card_pos
  
  obtain ⟨D, hrep, hpairs⟩ := bsg_popular_sums G A K hK hE
  obtain ⟨E, hE_def⟩ : ∃ E : Finset (G × G), E = (A ×ˢ A).filter (fun q => q.1 + q.2 ∈ D) :=
    ⟨_, rfl⟩
  have hEfilt : (A ×ˢ A).filter (fun p => p ∈ E) = E := by
    ext p
    rw [hE_def]
    simp only [Finset.mem_filter]
    tauto
  obtain ⟨δ, hδ_def⟩ : ∃ δ : ℝ, δ = 1 / (2 * K) := ⟨_, rfl⟩
  have hδ0 : 0 < δ := by rw [hδ_def]; exact div_pos one_pos (by linarith)
  have hEdens : δ * (A.card : ℝ) * (A.card : ℝ)
      ≤ (((A ×ˢ A).filter (fun p => p ∈ E)).card : ℝ) := by
    rw [hEfilt]
    have e : δ * (A.card : ℝ) * (A.card : ℝ) = (A.card : ℝ) ^ 2 / (2 * K) := by
      rw [hδ_def]; field_simp
    rw [e, hE_def]
    exact hpairs
  
  obtain ⟨A', hA'sub, B', hB'sub, ha, hb, hpath⟩ :=
    bsg_paths_of_length_three A A E δ hδ0 hA hA hEdens
  have hpath' : ∀ a ∈ A', ∀ b ∈ B', δ ^ 5 * (A.card : ℝ) * (A.card : ℝ) / 3072 ≤
      (((A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D)).card : ℝ) := by
    intro a ha' b hb'
    have h := hpath a ha' b hb'
    have haA := hA'sub ha'
    have hbA := hB'sub hb'
    have heq : (A ×ˢ A).filter (fun q => (a, q.1) ∈ E ∧ (q.2, q.1) ∈ E ∧ (q.2, b) ∈ E)
        = (A ×ˢ A).filter (fun q => a + q.1 ∈ D ∧ q.2 + q.1 ∈ D ∧ q.2 + b ∈ D) := by
      apply Finset.filter_congr
      intro q hq
      rw [Finset.mem_product] at hq
      obtain ⟨hq1, hq2⟩ := hq
      rw [hE_def]
      simp only [Finset.mem_filter, Finset.mem_product]
      tauto
    rw [heq] at h
    exact h
  
  have hm0 : (0 : ℝ) ≤ (A.card : ℝ) / (2 * K) := div_nonneg hn.le (by linarith)
  have hp0 : (0 : ℝ) ≤ δ ^ 5 * (A.card : ℝ) * (A.card : ℝ) / 3072 :=
    div_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hδ0.le 5) hn.le) hn.le) (by norm_num)
  have hS := bsg_sumset_count G A A' B' D _ _ hp0 hm0 hrep hpath'
  obtain ⟨S, hS_def⟩ : ∃ S : ℝ, S = (((A' ×ˢ B').image (fun q => q.1 + q.2)).card : ℝ) :=
    ⟨_, rfl⟩
  rw [← hS_def] at hS
  have hS0 : 0 ≤ S := by rw [hS_def]; positivity
  
  have hn12 : (A.card : ℝ) ≤ 12 * K * (A'.card : ℝ) := by
    have e : 12 * K * (δ * (A.card : ℝ) / 6) = (A.card : ℝ) := by
      rw [hδ_def]; field_simp; ring
    calc (A.card : ℝ) = 12 * K * (δ * (A.card : ℝ) / 6) := e.symm
      _ ≤ 12 * K * (A'.card : ℝ) := mul_le_mul_of_nonneg_left ha (by linarith)
  have hn8 : (A.card : ℝ) ≤ 8 * K * (B'.card : ℝ) := by
    have e : 8 * K * (δ * (A.card : ℝ) / 4) = (A.card : ℝ) := by
      rw [hδ_def]; field_simp; ring
    calc (A.card : ℝ) = 8 * K * (δ * (A.card : ℝ) / 4) := e.symm
      _ ≤ 8 * K * (B'.card : ℝ) := mul_le_mul_of_nonneg_left hb (by linarith)
  have ha0 : (0 : ℝ) < (A'.card : ℝ) := by
    by_contra hcon
    push_neg at hcon
    have : 12 * K * (A'.card : ℝ) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by linarith) hcon
    linarith
