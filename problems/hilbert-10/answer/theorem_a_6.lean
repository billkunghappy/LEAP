          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ) : ℝ) : ℂ)
        = (aa (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) /
