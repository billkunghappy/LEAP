                obtain ⟨hm0', hβeq⟩ := hm1 hm1'
                have hβσ : β₀ ≤ σ₁ := by
                  rw [hβeq]
                  by_contra hcon
                  push_neg at hcon
                  exact he2 ⟨hm0', hcon.le⟩
                rw [hm1', Nat.cast_one, one_mul, Complex.norm_real, Real.norm_eq_abs]
