        intro n hn
        induction n, hn using Int.le_induction with
        | base => rw [Finset.Icc_self, Finset.sum_singleton, hstep]; ring
        | succ n hn ih =>
          have hI : Finset.Icc a (n + 1) = insert (n + 1) (Finset.Icc a n) := by
            ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
          have hnot : n + 1 ∉ Finset.Icc a n := by rw [Finset.mem_Icc]; omega
          rw [hI, Finset.sum_insert hnot, mul_add, ih, hstep (n + 1)]; ring
