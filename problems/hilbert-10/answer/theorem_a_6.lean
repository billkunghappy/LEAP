      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul] at hstep1
      have hmnn : (0:ℝ) ≤ |φ (f j)| := abs_nonneg _
      have hfinal : (∑ i, |φ (f i)|)
          ≤ ((Fintype.card ({w : NumberField.InfinitePlace K // w.IsReal} ⊕
              ({w : NumberField.InfinitePlace K // w.IsComplex} ⊕
               {w : NumberField.InfinitePlace K // w.IsComplex})) : ℝ) + 1) * |φ (f j)| := by
        nlinarith [hstep1, hmnn]
      calc |φ y| ≤ (∑ i, |φ (f i)|) * ‖y‖ := hkey y
        _ ≤ (((Fintype.card ({w : NumberField.InfinitePlace K // w.IsReal} ⊕
              ({w : NumberField.InfinitePlace K // w.IsComplex} ⊕
               {w : NumberField.InfinitePlace K // w.IsComplex})) : ℝ) + 1) * |φ (f j)|) * ‖y‖ :=
            mul_le_mul_of_nonneg_right hfinal (norm_nonneg y)
        _ = ((Fintype.card ({w : NumberField.InfinitePlace K // w.IsReal} ⊕
              ({w : NumberField.InfinitePlace K // w.IsComplex} ⊕
               {w : NumberField.InfinitePlace K // w.IsComplex})) : ℝ) + 1) * |φ (f j)| * ‖y‖ := by
            ring
  
  have hsepf : ∀ (C : Set (NumberField.mixedEmbedding.mixedSpace K)) (r : ℝ)
      (z : NumberField.mixedEmbedding.mixedSpace K),
      Convex ℝ C → IsOpen C →
      ((∃ x ∈ C, ‖z - x‖ ≤ r) ∧ ¬ (∀ y, ‖y - z‖ ≤ r → y ∈ C)) →
      ∃ φ : NumberField.mixedEmbedding.mixedSpace K →L[ℝ] ℝ, φ ≠ 0 ∧
        ∀ y : NumberField.mixedEmbedding.mixedSpace K, (∃ x ∈ C, ‖y - x‖ ≤ r) →
          φ y - φ z < 2 * ‖φ‖ * r := by
    intro C r z hC hCo hz
    obtain ⟨hzD, hznot⟩ := hz
    obtain ⟨x₀, hx₀C, hzx₀⟩ := hzD
    push_neg at hznot
    obtain ⟨p, hpz, hpC⟩ := hznot
    obtain ⟨φ, hsep⟩ := geometric_hahn_banach_open_point hC hCo hpC
    have hop : (0 : ℝ) ≤ ‖φ‖ := ContinuousLinearMap.opNorm_nonneg φ
    have key : ∀ v : NumberField.mixedEmbedding.mixedSpace K, ‖v‖ ≤ r → φ v ≤ ‖φ‖ * r := by
      intro v hv
      calc φ v ≤ |φ v| := le_abs_self _
        _ = ‖φ v‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖φ‖ * ‖v‖ := φ.le_opNorm v
        _ ≤ ‖φ‖ * r := mul_le_mul_of_nonneg_left hv hop
    refine ⟨φ, ?_, ?_⟩
    · intro hφ0
      have h := hsep x₀ hx₀C
      rw [hφ0] at h
      simp only [ContinuousLinearMap.zero_apply] at h
      exact lt_irrefl (0 : ℝ) h
    · intro y hy
      obtain ⟨x, hxC, hyx⟩ := hy
      have h1 : φ y - φ x ≤ ‖φ‖ * r := by
        rw [← map_sub]
        exact key _ hyx
      have h2 : φ x < φ p := hsep x hxC
      have h3 : φ p - φ z ≤ ‖φ‖ * r := by
        rw [← map_sub]
        exact key _ hpz
      have hring : 2 * ‖φ‖ * r = ‖φ‖ * r + ‖φ‖ * r := by ring
      linarith [h1, h2, h3, hring]
  
  have hlayer : ∀ (X lam : ℝ) (u : NumberField.mixedEmbedding.mixedSpace K)
      (D : Set (NumberField.mixedEmbedding.mixedSpace K)),
      0 < lam → lam ≤ X → ‖u‖ ≤ lam →
      Convex ℝ D → IsOpen D → (∀ z ∈ D, ‖z‖ ≤ 2 * X) →
      MeasureTheory.volume {y | y ∈ D ∧ y + u ∉ D}
        ≤ ENNReal.ofReal (2 * lam / X) *
            MeasureTheory.volume
              (Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) (3 * X)) := by
    intro X lam u D hlam hlamX hu hD hDo hDb
    have hX0 : (0:ℝ) < X := lt_of_lt_of_le hlam hlamX
    have hc0 : (0:ℝ) ≤ 2 * lam / X := div_nonneg (by linarith) hX0.le
    have ht1 : (1:ℝ) ≤ X / lam := (one_le_div hlam).mpr hlamX
    have hk0 : 0 < ⌊X / lam⌋₊ := Nat.floor_pos.mpr ht1
    have hkR1 : (1:ℝ) ≤ (⌊X / lam⌋₊ : ℝ) := by exact_mod_cast hk0
    have hkle : ((⌊X / lam⌋₊ : ℕ) : ℝ) ≤ X / lam := Nat.floor_le (by linarith)
    have hklam : ((⌊X / lam⌋₊ : ℕ) : ℝ) * lam ≤ X := by
      have h := mul_le_mul_of_nonneg_right hkle hlam.le
      rwa [div_mul_cancel₀ X (ne_of_gt hlam)] at h
    have hltf : X / lam < ((⌊X / lam⌋₊ : ℕ) : ℝ) + 1 := Nat.lt_floor_add_one _
    have hX2k : X < 2 * ((⌊X / lam⌋₊ : ℕ) : ℝ) * lam := by
      have h1 : X / lam < 2 * ((⌊X / lam⌋₊ : ℕ) : ℝ) := by linarith
      have h2 := (div_lt_iff₀ hlam).mp h1
      linarith
    have hck : (1:ℝ) ≤ 2 * lam / X * ((⌊X / lam⌋₊ : ℕ) : ℝ) := by
      rw [div_mul_eq_mul_div, le_div_iff₀ hX0]
      linarith
    set k : ℕ := ⌊X / lam⌋₊ with hkdef
    set F : Set (NumberField.mixedEmbedding.mixedSpace K) := {y | y ∈ D ∧ y + u ∉ D} with hFdef
    have hmemF : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        z ∈ F ↔ (z ∈ D ∧ z + u ∉ D) := by
      intro z; rw [hFdef]; exact Iff.rfl
    have hFmeas : MeasurableSet F := by
      have h1 : MeasurableSet D := hDo.measurableSet
      have h2 : MeasurableSet ((fun y => y + u) ⁻¹' D) :=
        (hDo.preimage (continuous_add_right u)).measurableSet
      have h3 : F = D ∩ ((fun y => y + u) ⁻¹' D)ᶜ := by
        rw [hFdef]; exact Set.ext (fun y => Iff.rfl)
      rw [h3]
      exact h1.inter h2.compl
    have hpersist : ∀ y : NumberField.mixedEmbedding.mixedSpace K, y ∈ D → y + u ∉ D →
        ∀ i : ℕ, 1 ≤ i → y + (i : ℝ) • u ∉ D := by
      intro y hy hyu i hi hmem
      have hi1 : (1:ℝ) ≤ (i:ℝ) := by exact_mod_cast hi
      have hipos : (0:ℝ) < (i:ℝ) := by linarith
      have hb0 : (0:ℝ) ≤ 1 / (i:ℝ) := div_nonneg zero_le_one hipos.le
      have hb1 : 1 / (i:ℝ) ≤ 1 := by rw [div_le_one hipos]; exact hi1
      have hcomb := hD hy hmem (by linarith : (0:ℝ) ≤ 1 - 1 / (i:ℝ)) hb0 (by ring)
      have hbi : (1 / (i:ℝ)) * (i:ℝ) = 1 := by field_simp
      have hsum1 : (1 - 1 / (i:ℝ)) + 1 / (i:ℝ) = 1 := by ring
      have heq : (1 - 1 / (i:ℝ)) • y + (1 / (i:ℝ)) • (y + (i : ℝ) • u) = y + u := by
        rw [smul_add, smul_smul, hbi, one_smul, ← add_assoc, ← add_smul, hsum1, one_smul]
      rw [heq] at hcomb
      exact hyu hcomb
    set T : ℕ → Set (NumberField.mixedEmbedding.mixedSpace K) :=
      fun i => (fun y => ((-(i:ℝ)) • u) + y) ⁻¹' F with hTdef
    have hmemT : ∀ (i : ℕ) (y : NumberField.mixedEmbedding.mixedSpace K),
        y ∈ T i ↔ (((-(i:ℝ)) • u) + y) ∈ F := by
      intro i y; rw [hTdef]; exact Iff.rfl
    have hdisj_lt : ∀ i j : ℕ, i < j → Disjoint (T i) (T j) := by
      intro i j hij
      rw [Set.disjoint_left]
      intro y hyi hyj
      rw [hmemT] at hyi hyj
      have hcast : ((j - i : ℕ) : ℝ) = (j:ℝ) - (i:ℝ) := Nat.cast_sub (le_of_lt hij)
      have hm : 1 ≤ j - i := by omega
      have hkey : ((-(j:ℝ)) • u + y) + ((j - i : ℕ) : ℝ) • u = (-(i:ℝ)) • u + y := by
        rw [hcast, sub_smul, neg_smul, neg_smul]
