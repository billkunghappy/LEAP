      ∃ Gen : Set (NumberField.RingOfIntegers K),
        (∀ μ ∈ Gen, μ ≠ 0 ∧ μ - ρ ∈ q * b) ∧
        (∀ μ : NumberField.RingOfIntegers K, μ ≠ 0 → μ - ρ ∈ q * b →
            ∃! p : {ν // ν ∈ Gen} ×
