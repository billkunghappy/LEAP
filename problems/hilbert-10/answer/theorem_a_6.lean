    ∃ ρ : ℝ, ε ≤ ρ ∧ ρ ≤ 2 * ε ∧ GiRegularBohr P S ρ :=
by
  classical
  
  
  
  have rising_sun_right_count : ∀ (f : ℕ → ℝ) (c : ℝ) (lo hi : ℕ), 0 ≤ c → lo ≤ hi →
      (∀ j, lo ≤ j → j < hi → f j ≤ f (j + 1)) →
      c * (((Finset.Icc lo hi).filter (fun j => ∃ j' ∈ Finset.Ioc j hi,
        c * ((j' : ℝ) - (j : ℝ)) < f j' - f j)).card : ℝ) ≤ f hi - f lo := by
    intro f c lo hi hc hlohi hmono
    have key : ∀ n : ℕ, ∀ lo : ℕ, hi - lo = n → lo ≤ hi →
        (∀ j, lo ≤ j → j < hi → f j ≤ f (j + 1)) →
        c * (((Finset.Icc lo hi).filter (fun j => ∃ j' ∈ Finset.Ioc j hi,
          c * ((j' : ℝ) - (j : ℝ)) < f j' - f j)).card : ℝ) ≤ f hi - f lo := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
      intro lo hn hlohi hmono
      rcases Nat.eq_or_lt_of_le hlohi with heq | hlt
      · subst heq
        have hempty : (Finset.Icc lo lo).filter (fun j => ∃ j' ∈ Finset.Ioc j lo,
            c * ((j' : ℝ) - (j : ℝ)) < f j' - f j) = ∅ := by
          rw [Finset.filter_eq_empty_iff]
          intro j hj
          rw [Finset.mem_Icc] at hj
          rintro ⟨j', hj', -⟩
          rw [Finset.mem_Ioc] at hj'
          omega
        rw [hempty]
        simp
      · by_cases hp : ∃ j' ∈ Finset.Ioc lo hi, c * ((j' : ℝ) - (lo : ℝ)) < f j' - f lo
        · obtain ⟨q, hq, hql⟩ := hp
          rw [Finset.mem_Ioc] at hq
          have hsub : (Finset.Icc lo hi).filter (fun j => ∃ j' ∈ Finset.Ioc j hi,
                c * ((j' : ℝ) - (j : ℝ)) < f j' - f j)
              ⊆ Finset.Ico lo q ∪ (Finset.Icc q hi).filter (fun j => ∃ j' ∈ Finset.Ioc j hi,
                c * ((j' : ℝ) - (j : ℝ)) < f j' - f j) := by
            intro j hj
            rw [Finset.mem_filter, Finset.mem_Icc] at hj
            rcases lt_or_ge j q with hjq | hjq
            · exact Finset.mem_union_left _ (Finset.mem_Ico.2 ⟨hj.1.1, hjq⟩)
            · exact Finset.mem_union_right _
                (Finset.mem_filter.2 ⟨Finset.mem_Icc.2 ⟨hjq, hj.1.2⟩, hj.2⟩)
          have hcard := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
          rw [Nat.card_Ico] at hcard
          have ihq := ih (hi - q) (by omega) q rfl hq.2
            (fun j h1 h2 => hmono j (by omega) h2)
          have hcR := (Nat.cast_le (α := ℝ)).2 hcard
          rw [Nat.cast_add, Nat.cast_sub (le_of_lt hq.1)] at hcR
          have := mul_le_mul_of_nonneg_left hcR hc
          nlinarith
        · have heq : (Finset.Icc lo hi).filter (fun j => ∃ j' ∈ Finset.Ioc j hi,
