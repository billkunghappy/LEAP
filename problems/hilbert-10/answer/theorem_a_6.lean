    (hεσ : ε ≤ σ / 32) (hσN : 32 ≤ σ ^ 2 * (4 * (N : ℝ) + 1))
    (hG : G ⊆ intBox ν (2 * N)) (hcard : σ * (4 * (N : ℝ) + 1) ^ ν ≤ (G.card : ℝ))
    (hgood : ∀ h ∈ G, ∀ l : Fin ν,
      |(∑ l', Sm l l' * ((h l' : ℤ) : ℝ)) - ((round (∑ l', Sm l l' * ((h l' : ℤ) : ℝ)) : ℤ) : ℝ)|
        ≤ ε) :
    ∃ q₀ : ℕ, 1 ≤ q₀ ∧ (q₀ : ℝ) ≤ (2 / σ) ^ (ν * ν) ∧
      ∀ l l' : Fin ν, |(q₀ : ℝ) * Sm l l' - ((round ((q₀ : ℝ) * Sm l l') : ℤ) : ℝ)|
        ≤ (q₀ : ℝ) * (8 * ε / (σ ^ 2 * (4 * (N : ℝ) + 1))) :=
by
  
  
  
  have hs1 : ∀ (M : ℕ) (l' : Fin ν), G ⊆ intBox ν M →
      σ * (2 * (M : ℝ) + 1) ^ ν ≤ (G.card : ℝ) →
      ∃ y : Fin ν → ℤ, σ * (2 * (M : ℝ) + 1) ≤
        (((Finset.Icc (-(M : ℤ)) M).filter (fun t => Function.update y l' t ∈ G)).card : ℝ) := by
    clear hgood hcard hG hσN hεσ hε hσ1 hσ hN
    intro M l' hG hcard
    obtain ⟨Y, hYdef⟩ : ∃ Y : Finset (Fin ν → ℤ), Y = Fintype.piFinset
        (fun k : Fin ν => if k = l' then ({0} : Finset ℤ) else Finset.Icc (-(M : ℤ)) M) :=
      ⟨_, rfl⟩
    have hfac : ∀ k : Fin ν,
        (((if k = l' then ({0} : Finset ℤ) else Finset.Icc (-(M : ℤ)) M).card : ℕ) : ℝ)
          = if k = l' then (1 : ℝ) else 2 * (M : ℝ) + 1 := by
      intro k
      split_ifs
      · simp
      · rw [Int.card_Icc]
        have : ((M : ℤ) + 1 - -(M : ℤ)).toNat = 2 * M + 1 := by omega
        rw [this]; push_cast; ring
    have hYcard : (Y.card : ℝ) * (2 * (M : ℝ) + 1) = (2 * (M : ℝ) + 1) ^ ν := by
      rw [hYdef, Fintype.card_piFinset, Nat.cast_prod]
      rw [Finset.prod_congr rfl (fun k _ => hfac k)]
      rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ l'), if_pos rfl, one_mul]
      have h2 : ∏ x ∈ Finset.univ.erase l', (if x = l' then (1 : ℝ) else 2 * (M : ℝ) + 1)
          = ∏ x ∈ Finset.univ.erase l', (2 * (M : ℝ) + 1) :=
        Finset.prod_congr rfl (fun x hx => if_neg (Finset.ne_of_mem_erase hx))
      rw [h2]
      have h3 : (2 * (M : ℝ) + 1) ^ ν = ∏ _x : Fin ν, (2 * (M : ℝ) + 1) := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      rw [h3, ← Finset.mul_prod_erase Finset.univ (fun _ => (2 * (M : ℝ) + 1))
        (Finset.mem_univ l')]
      ring
    have hmaps : ∀ h ∈ G, Function.update h l' 0 ∈ Y := by
      intro h hh
      have hb := hG hh
      simp only [intBox, Finset.mem_Icc] at hb
      rw [hYdef, Fintype.mem_piFinset]
      intro k
      by_cases hk : k = l'
      · subst hk; simp
      · rw [if_neg hk, Function.update_of_ne hk, Finset.mem_Icc]
