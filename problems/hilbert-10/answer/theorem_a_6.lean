                    (((α w : ℂ) * s + β w) * ((α w : ℂ) * s + β w + 1) *
                      ((α w : ℂ) * s + β w + 2))) ∧
          (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
              ‖H s‖ ≤ A₂ * ((Ideal.absNorm q : ℝ) * (1 + kaiHZInfSize K t l) *
                (2 + |s.im|)) ^ A₂) ∧
          (∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
              ‖G s‖ ≤ A₂ * ((Ideal.absNorm q : ℝ) * (1 + kaiHZInfSize K t l) *
                  (2 + |s.im|)) ^ A₂ *
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                  ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                    (-((3 : ℝ) / 2)))

