theorem kai_mf_cone_arch_weight_norm {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (x : K) :
    ‖kaiHZArchWeight K η l (NumberField.mixedEmbedding K x)‖
      = ∏ w : NumberField.InfinitePlace K, (w x) ^ (kaiHZDeg K η l w) :=
by
  classical
  have hAW : kaiHZArchWeight K η l (NumberField.mixedEmbedding K x)
      = (∏ v : {w : NumberField.InfinitePlace K // w.IsReal},
            if η v then (((NumberField.mixedEmbedding K x).1 v : ℝ) : ℂ) else 1) *
        ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            kaiHZCplxWeight (l p) ((NumberField.mixedEmbedding K x).2 p) := rfl
  have hCW : ∀ (m : ℤ) (z : ℂ), kaiHZCplxWeight m z
      = if 0 ≤ m then z ^ m.toNat else (starRingEnd ℂ) z ^ (-m).toNat := fun _ _ => rfl
  have hDeg : ∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w
      = if hw : w.IsReal then (if η ⟨w, hw⟩ then (1 : ℝ) else 0)
        else |((l ⟨w, w.isReal_or_isComplex.resolve_left hw⟩ : ℤ) : ℝ)| := fun _ => rfl
  have hbR : ∀ v : {w : NumberField.InfinitePlace K // w.IsReal},
      |(NumberField.mixedEmbedding K x).1 v| = (v : NumberField.InfinitePlace K) x := by
    intro v
    have h := (NumberField.mixedEmbedding.normAtPlace_apply_of_isReal v.prop
                (NumberField.mixedEmbedding K x)).symm.trans
              (NumberField.mixedEmbedding.normAtPlace_apply
                (v : NumberField.InfinitePlace K) x)
    rw [← Real.norm_eq_abs]
    exact h
  have hbC : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      ‖(NumberField.mixedEmbedding K x).2 p‖ = (p : NumberField.InfinitePlace K) x := by
    intro p
    exact (NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex p.prop
            (NumberField.mixedEmbedding K x)).symm.trans
          (NumberField.mixedEmbedding.normAtPlace_apply
            (p : NumberField.InfinitePlace K) x)
  have hreal : ∀ v : {w : NumberField.InfinitePlace K // w.IsReal},
      ‖(if η v then (((NumberField.mixedEmbedding K x).1 v : ℝ) : ℂ) else 1)‖
        = ((v : NumberField.InfinitePlace K) x)
            ^ (kaiHZDeg K η l (v : NumberField.InfinitePlace K)) := by
    intro v
    have hd : kaiHZDeg K η l (v : NumberField.InfinitePlace K)
        = if η v then (1 : ℝ) else 0 := by
      have h := hDeg (v : NumberField.InfinitePlace K)
      rw [dif_pos v.prop] at h
      exact h
    rw [hd]
    rcases Decidable.em (η v = true) with hb | hb
    · rw [if_pos hb, if_pos hb, Complex.norm_real, Real.norm_eq_abs, hbR v, Real.rpow_one]
    · rw [if_neg hb, if_neg hb, norm_one, Real.rpow_zero]
  have hcplx : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      ‖kaiHZCplxWeight (l p) ((NumberField.mixedEmbedding K x).2 p)‖
        = ((p : NumberField.InfinitePlace K) x)
            ^ (kaiHZDeg K η l (p : NumberField.InfinitePlace K)) := by
    intro p
    have hnr : ¬ (p : NumberField.InfinitePlace K).IsReal :=
      NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr p.prop
    have hd : kaiHZDeg K η l (p : NumberField.InfinitePlace K)
        = |((l p : ℤ) : ℝ)| := by
      have h := hDeg (p : NumberField.InfinitePlace K)
      rw [dif_neg hnr] at h
      exact h
    have hexp : (((l p).natAbs : ℕ) : ℝ) = |((l p : ℤ) : ℝ)| := by
      rw [Nat.cast_natAbs, Int.cast_abs]
    have hnorm : ‖kaiHZCplxWeight (l p) ((NumberField.mixedEmbedding K x).2 p)‖
        = ‖(NumberField.mixedEmbedding K x).2 p‖ ^ (l p).natAbs := by
      rcases Decidable.em (0 ≤ l p) with hl | hl
      · have ht : (l p).toNat = (l p).natAbs := by omega
        rw [hCW, if_pos hl, norm_pow, ht]
      · have ht : (-(l p)).toNat = (l p).natAbs := by omega
        rw [hCW, if_neg hl, norm_pow, Complex.norm_conj, ht]
    rw [hnorm, hbC p, hd, ← hexp, Real.rpow_natCast]
  have hsplit : ∀ g : NumberField.InfinitePlace K → ℝ,
      (∏ v : {w : NumberField.InfinitePlace K // w.IsReal},
          g (v : NumberField.InfinitePlace K)) *
        (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          g (p : NumberField.InfinitePlace K))
        = ∏ w : NumberField.InfinitePlace K, g w := by
    intro g
    have hRmem : ∀ w : NumberField.InfinitePlace K,
        w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsReal)
          ↔ w.IsReal := by
      intro w; simp
    have hCmem : ∀ w : NumberField.InfinitePlace K,
        w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => ¬ w.IsReal)
          ↔ w.IsComplex := by
      intro w
      simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]
    have e1 : (∏ w ∈ Finset.univ.filter
            (fun w : NumberField.InfinitePlace K => w.IsReal), g w)
        = ∏ v : {w : NumberField.InfinitePlace K // w.IsReal},
            g (v : NumberField.InfinitePlace K) :=
      Finset.prod_subtype _ hRmem g
    have e2 : (∏ w ∈ Finset.univ.filter
            (fun w : NumberField.InfinitePlace K => ¬ w.IsReal), g w)
        = ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            g (p : NumberField.InfinitePlace K) :=
      Finset.prod_subtype _ hCmem g
    rw [← e1, ← e2]
    exact Finset.prod_filter_mul_prod_filter_not Finset.univ
      (fun w : NumberField.InfinitePlace K => w.IsReal) g
  have hstep4 : ‖kaiHZArchWeight K η l (NumberField.mixedEmbedding K x)‖
      = (∏ v : {w : NumberField.InfinitePlace K // w.IsReal},
            ‖(if η v then (((NumberField.mixedEmbedding K x).1 v : ℝ) : ℂ) else 1)‖) *
        (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            ‖kaiHZCplxWeight (l p) ((NumberField.mixedEmbedding K x).2 p)‖) := by
    rw [hAW, norm_mul, norm_prod, norm_prod]
  have hP1 : (∏ v : {w : NumberField.InfinitePlace K // w.IsReal},
        ‖(if η v then (((NumberField.mixedEmbedding K x).1 v : ℝ) : ℂ) else 1)‖)
      = ∏ v : {w : NumberField.InfinitePlace K // w.IsReal},
          ((v : NumberField.InfinitePlace K) x)
            ^ (kaiHZDeg K η l (v : NumberField.InfinitePlace K)) :=
    Finset.prod_congr rfl (fun v _ => hreal v)
  have hP2 : (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        ‖kaiHZCplxWeight (l p) ((NumberField.mixedEmbedding K x).2 p)‖)
      = ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          ((p : NumberField.InfinitePlace K) x)
            ^ (kaiHZDeg K η l (p : NumberField.InfinitePlace K)) :=
    Finset.prod_congr rfl (fun p _ => hcplx p)
  rw [hstep4, hP1, hP2]
  exact hsplit (fun w : NumberField.InfinitePlace K => (w x) ^ (kaiHZDeg K η l w))

theorem kai_mf_cone_dual_shape_hasSum {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (bf : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (vv : NumberField.mixedEmbedding.mixedSpace K)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (hsumD : ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
        Summable (fun ν : {x : K // x ∈ (bf : FractionalIdeal
            (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
          ‖kaiHZArchWeight K η (fun p => -l p)
              (NumberField.mixedEmbedding K (ν : K))‖ *
            kaiHZGaussian K y (NumberField.mixedEmbedding K (ν : K))))
    (hfin : ∀ M : ℝ, {ν : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
        ∀ w : NumberField.InfinitePlace K, w ((ν : K)) ≤ M}.Finite)
    (z : NumberField.InfinitePlace K → ℂ)
    (u : NumberField.InfinitePlace K → ℝ) :
    HasSum (fun x : kaiMFDualShape K bf =>
        kaiMFDualCoeff K bf vv η (fun p => -l p)
            (x : NumberField.InfinitePlace K → ℝ) *
          ∏ w : NumberField.InfinitePlace K,
            Complex.exp (z w * ((u w : ℝ) : ℂ)
              - ((Real.pi * (x : NumberField.InfinitePlace K → ℝ) w ^ 2 *
                  Real.exp (u w) : ℝ) : ℂ)))
      ((kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w)) -
          kaiHZArchWeight K η (fun p => -l p) 0) * kaiMFConeWeight K z u) :=
by
  classical
  have hshape : ∀ (α : Type u) (sh : α → (NumberField.InfinitePlace K → ℝ)) (A : α → ℂ)
      (y : NumberField.InfinitePlace K → ℝ),
      Summable (fun a : α => ‖A a‖ *
          Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K, y w * sh a w ^ 2))) →
      HasSum (fun s : NumberField.InfinitePlace K → ℝ =>
          (∑' a : {a : α // sh a = s}, A (a : α)) *
            ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              y w * s w ^ 2)) : ℝ) : ℂ))
        (∑' a : α, A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh a w ^ 2)) : ℝ) : ℂ)) := by
    intro α sh A y hsum
    have hFnorm : ∀ a : α,
        ‖A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            y w * sh a w ^ 2)) : ℝ) : ℂ)‖
          = ‖A a‖ * Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              y w * sh a w ^ 2)) := by
      intro a
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    have hFsum : Summable (fun a : α =>
        ‖A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh a w ^ 2)) : ℝ) : ℂ)‖) := by
      simpa only [hFnorm] using hsum
    have hFs : Summable (fun a : α =>
        A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh a w ^ 2)) : ℝ) : ℂ)) := hFsum.of_norm
    have hF0 := ((Equiv.sigmaFiberEquiv sh).summable_iff).mpr hFs
    have hH0 := ((Equiv.sigmaFiberEquiv sh).hasSum_iff).mpr hFs.hasSum
    have hF : Summable (fun p : (Σ s : NumberField.InfinitePlace K → ℝ,
        {a : α // sh a = s}) =>
        A ((p.2 : α)) * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh ((p.2 : α)) w ^ 2)) : ℝ) : ℂ)) := hF0
    have hH : HasSum (fun p : (Σ s : NumberField.InfinitePlace K → ℝ,
        {a : α // sh a = s}) =>
        A ((p.2 : α)) * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh ((p.2 : α)) w ^ 2)) : ℝ) : ℂ))
        (∑' a : α, A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh a w ^ 2)) : ℝ) : ℂ)) := hH0
    have hfibeq : ∀ s : NumberField.InfinitePlace K → ℝ,
        (∑' a : {a : α // sh a = s},
            A ((a : α)) * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              y w * sh ((a : α)) w ^ 2)) : ℝ) : ℂ))
          = (∑' a : {a : α // sh a = s}, A (a : α)) *
              ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
                y w * s w ^ 2)) : ℝ) : ℂ) := by
      intro s
      rw [← tsum_mul_right]
      exact tsum_congr (fun a => by rw [a.2])
    have hsig := hH.sigma (fun s => (hF.sigma_factor s).hasSum)
    simpa only [hfibeq] using hsig
  have hGauss : ∀ (y : NumberField.InfinitePlace K → ℝ) (x : K),
      kaiHZGaussian K y (NumberField.mixedEmbedding K x)
        = Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K, y w * (w x) ^ 2)) := by
    intro y x
    simp only [kaiHZGaussian, NumberField.mixedEmbedding.normAtPlace_apply]
  have hchar : ∀ r : ℝ, ‖Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (r : ℂ))‖ = 1 := by
    intro r
    have h : 2 * (Real.pi : ℂ) * Complex.I * (r : ℂ)
        = ((2 * Real.pi * r : ℝ) : ℂ) * Complex.I := by push_cast; ring
    rw [h, Complex.norm_exp_ofReal_mul_I]
  have hAnorm : ∀ a : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)},
      ‖kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K ((a : K))) *
        Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
          ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((a : K))) vv : ℝ) : ℂ))‖
        = ‖kaiHZArchWeight K η (fun p => -l p)
            (NumberField.mixedEmbedding K ((a : K)))‖ := by
    intro a
    rw [norm_mul, hchar, mul_one]
  have htheta : ∀ y : NumberField.InfinitePlace K → ℝ,
      (∑' a : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)},
        (kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K ((a : K))) *
          Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
            ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((a : K))) vv : ℝ) : ℂ))) *
          ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            y w * (w ((a : K))) ^ 2)) : ℝ) : ℂ))
        = kaiHZIdealThetaChar K bf vv η (fun p => -l p) y := by
    intro y
    simp only [kaiHZIdealThetaChar]
    refine tsum_congr (fun a => ?_)
    rw [hGauss y ((a : K))]
    ring
  have hdual : ∀ s : NumberField.InfinitePlace K → ℝ,
      (∑' a : {a : {x : K // x ∈ (bf : FractionalIdeal
            (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} //
          (fun w : NumberField.InfinitePlace K => w ((a : K))) = s},
        kaiHZArchWeight K η (fun p => -l p)
            (NumberField.mixedEmbedding K ((a : K))) *
          Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
            ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((a : K))) vv : ℝ) : ℂ)))
        = kaiMFDualCoeff K bf vv η (fun p => -l p) s := by
    intro s
    simp only [kaiMFDualCoeff]
    exact (Equiv.subtypeSubtypeEquivSubtypeInter
      (fun x : K => x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K))
      (fun x : K => (fun w : NumberField.InfinitePlace K => w x) = s)).tsum_eq
      (fun ν : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
          (fun w : NumberField.InfinitePlace K => w x) = s} =>
        kaiHZArchWeight K η (fun p => -l p)
            (NumberField.mixedEmbedding K ((ν : K))) *
          Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
            ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((ν : K))) vv : ℝ) : ℂ)))
  have hEgen : ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
      HasSum (fun s : NumberField.InfinitePlace K → ℝ =>
          kaiMFDualCoeff K bf vv η (fun p => -l p) s *
            ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              y w * s w ^ 2)) : ℝ) : ℂ))
        (kaiHZIdealThetaChar K bf vv η (fun p => -l p) y) := by
    intro y hy
    have h0 : Summable (fun a : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        ‖kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K ((a : K))) *
          Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
            ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((a : K))) vv : ℝ) : ℂ))‖ *
          Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            y w * (w ((a : K))) ^ 2))) := by
      simpa only [hAnorm, hGauss] using hsumD y hy
    have h1 := hshape
      {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}
      (fun ν => fun w : NumberField.InfinitePlace K => w ((ν : K)))
      (fun a => kaiHZArchWeight K η (fun p => -l p)
          (NumberField.mixedEmbedding K ((a : K))) *
        Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
          ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((a : K))) vv : ℝ) : ℂ)))
      y h0
    simp only [hdual] at h1
    rw [← htheta y]
    exact h1
  have hE : HasSum (fun s : NumberField.InfinitePlace K → ℝ =>
      kaiMFDualCoeff K bf vv η (fun p => -l p) s *
        ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          Real.exp (u w) * s w ^ 2)) : ℝ) : ℂ))
      (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w))) :=
    hEgen (fun w => Real.exp (u w)) (fun w => Real.exp_pos (u w))
  have hpunct : ∀ (ι : Type u) (P : ι → Prop) (F : ι → ℂ) (a : ℂ) (i₀ : ι), ¬ P i₀ →
      (∀ i : ι, i ≠ i₀ → ¬ P i → F i = 0) → HasSum F a →
      HasSum (fun x : {i : ι // P i} => F (x : ι)) (a - F i₀) := by
    intro ι P F a i₀ hi₀ hsupp hF
    have hne : ∀ x : {i : ι // P i}, (x : ι) ∉ ({i₀} : Finset ι) := by
      intro x hmem
      have hx := Finset.mem_singleton.mp hmem
      exact hi₀ (hx ▸ x.2)
    have h1 : HasSum (fun x : {x : ι // x ∉ ({i₀} : Finset ι)} => F (x : ι)) (a - F i₀) := by
      refine (Finset.hasSum_compl_iff _).mpr ?_
      rw [Finset.sum_singleton F i₀, sub_add_cancel]
      exact hF
    have hginj : Function.Injective
        (fun x : {i : ι // P i} => (⟨(x : ι), hne x⟩ : {x : ι // x ∉ ({i₀} : Finset ι)})) := by
      intro x1 x2 hx
      have h : ((⟨(x1 : ι), hne x1⟩ : {x : ι // x ∉ ({i₀} : Finset ι)}) : ι)
          = ((⟨(x2 : ι), hne x2⟩ : {x : ι // x ∉ ({i₀} : Finset ι)}) : ι) :=
        congrArg Subtype.val hx
      exact Subtype.ext h
    have hoff : ∀ Y : {x : ι // x ∉ ({i₀} : Finset ι)},
        Y ∉ Set.range (fun x : {i : ι // P i} =>
          (⟨(x : ι), hne x⟩ : {x : ι // x ∉ ({i₀} : Finset ι)})) → F (Y : ι) = 0 := by
      intro Y hY
      refine hsupp (Y : ι) ?_ ?_
      · intro hYi
        exact Y.2 (by rw [hYi]; exact Finset.mem_singleton_self i₀)
      · intro hp
        exact hY ⟨⟨(Y : ι), hp⟩, Subtype.ext rfl⟩
    exact (Function.Injective.hasSum_iff hginj hoff).mpr h1
  have hoffB : ∀ s : NumberField.InfinitePlace K → ℝ, s ≠ 0 →
      ¬ (∃ x : K, x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧ x ≠ 0 ∧
        (fun w : NumberField.InfinitePlace K => w x) = s) →
      kaiMFDualCoeff K bf vv η (fun p => -l p) s = 0 := by
    intro s hs hno
    haveI hempty : IsEmpty {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
        (fun w : NumberField.InfinitePlace K => w x) = s} := by
      refine ⟨fun t => ?_⟩
      have hval : ((t : K)) ≠ 0 := by
        intro h0
        refine hs ?_
        rw [← t.2.2]
        funext w
        simp [h0]
      exact hno ⟨(t : K), t.2.1, hval, t.2.2⟩
    simp only [kaiMFDualCoeff]
    exact tsum_empty
  have hi0 : ¬ (∃ x : K, x ∈ (bf : FractionalIdeal
      (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧ x ≠ 0 ∧
    (fun w : NumberField.InfinitePlace K => w x)
      = (0 : NumberField.InfinitePlace K → ℝ)) := by
    rintro ⟨x, -, hx0, hsh⟩
    have hw : (Classical.arbitrary (NumberField.InfinitePlace K)) x = 0 := by
      have hc := congrFun hsh (Classical.arbitrary (NumberField.InfinitePlace K))
      simpa using hc
    have hpos : (0 : ℝ) < (Classical.arbitrary (NumberField.InfinitePlace K)) x :=
      NumberField.InfinitePlace.pos_iff.mpr hx0
    exact hpos.ne' hw
  have hmem0 : (0 : K) ∈ (bf : FractionalIdeal
      (nonZeroDivisors (NumberField.RingOfIntegers K)) K) := FractionalIdeal.zero_mem _
  have hsh0 : (fun w : NumberField.InfinitePlace K => w (0 : K))
      = (0 : NumberField.InfinitePlace K → ℝ) := by
    funext w
    simp
  have huniq : ∀ t : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
        (fun w : NumberField.InfinitePlace K => w x)
          = (0 : NumberField.InfinitePlace K → ℝ)},
      t = ⟨(0 : K), hmem0, hsh0⟩ := by
    intro t
    have hw : (Classical.arbitrary (NumberField.InfinitePlace K)) ((t : K)) = 0 := by
      have hc := congrFun t.2.2 (Classical.arbitrary (NumberField.InfinitePlace K))
      simpa using hc
    have hval : ((t : K)) = (0 : K) := by
      refine not_not.mp (fun hnz => ?_)
      have hpos : (0 : ℝ) < (Classical.arbitrary (NumberField.InfinitePlace K)) ((t : K)) :=
        NumberField.InfinitePlace.pos_iff.mpr hnz
      exact hpos.ne' hw
    exact Subtype.ext hval
  have hzero : kaiMFDualCoeff K bf vv η (fun p => -l p)
      (0 : NumberField.InfinitePlace K → ℝ) = kaiHZArchWeight K η (fun p => -l p) 0 := by
    have hme : NumberField.mixedEmbedding K ((0 : K)) = 0 := map_zero _
    have hinner : kaiHZMixedInner K (0 : NumberField.mixedEmbedding.mixedSpace K) vv = 0 := by
      simp [kaiHZMixedInner]
    have hsingle : ∀ t : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
        (fun w : NumberField.InfinitePlace K => w x)
          = (0 : NumberField.InfinitePlace K → ℝ)},
        t ≠ ⟨(0 : K), hmem0, hsh0⟩ →
        kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K ((t : K))) *
          Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
            ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((t : K))) vv : ℝ) : ℂ))
          = 0 :=
      fun t ht => absurd (huniq t) ht
    simp only [kaiMFDualCoeff]
    rw [tsum_eq_single _ hsingle]
    show kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K ((0 : K))) *
        Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
          ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((0 : K))) vv : ℝ) : ℂ))
      = kaiHZArchWeight K η (fun p => -l p) 0
    rw [hme, hinner]
    simp
  have hFzero : kaiMFDualCoeff K bf vv η (fun p => -l p)
        (0 : NumberField.InfinitePlace K → ℝ) *
      ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
        Real.exp (u w) * (0 : NumberField.InfinitePlace K → ℝ) w ^ 2)) : ℝ) : ℂ)
      = kaiHZArchWeight K η (fun p => -l p) 0 := by
    rw [hzero]
    simp
  have hprod : ∀ σ : NumberField.InfinitePlace K → ℝ,
      (∏ w : NumberField.InfinitePlace K,
          Complex.exp (z w * ((u w : ℝ) : ℂ)
            - ((Real.pi * σ w ^ 2 * Real.exp (u w) : ℝ) : ℂ)))
        = ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              Real.exp (u w) * σ w ^ 2)) : ℝ) : ℂ) * kaiMFConeWeight K z u := by
    intro σ
    have hR : (∑ w : NumberField.InfinitePlace K,
          ((Real.pi * σ w ^ 2 * Real.exp (u w) : ℝ) : ℂ))
        = ((Real.pi * ∑ w : NumberField.InfinitePlace K,
            Real.exp (u w) * σ w ^ 2 : ℝ) : ℂ) := by
      rw [← Complex.ofReal_sum]
      refine congrArg _ ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun w _ => by ring)
    have hCW : kaiMFConeWeight K z u
        = Complex.exp (∑ w : NumberField.InfinitePlace K, z w * ((u w : ℝ) : ℂ)) := by
      simp only [kaiMFConeWeight]
    rw [hCW]
    calc (∏ w : NumberField.InfinitePlace K,
          Complex.exp (z w * ((u w : ℝ) : ℂ)
            - ((Real.pi * σ w ^ 2 * Real.exp (u w) : ℝ) : ℂ)))
        = Complex.exp (∑ w : NumberField.InfinitePlace K, (z w * ((u w : ℝ) : ℂ)
            - ((Real.pi * σ w ^ 2 * Real.exp (u w) : ℝ) : ℂ))) :=
          (Complex.exp_sum Finset.univ _).symm
      _ = Complex.exp ((∑ w : NumberField.InfinitePlace K, z w * ((u w : ℝ) : ℂ))
            - ((Real.pi * ∑ w : NumberField.InfinitePlace K,
                Real.exp (u w) * σ w ^ 2 : ℝ) : ℂ)) := by
          rw [Finset.sum_sub_distrib, hR]
      _ = ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              Real.exp (u w) * σ w ^ 2)) : ℝ) : ℂ) *
            Complex.exp (∑ w : NumberField.InfinitePlace K, z w * ((u w : ℝ) : ℂ)) := by
          rw [Complex.ofReal_exp, Complex.ofReal_neg, ← Complex.exp_add]
          congr 1
          ring
  have hR2 : HasSum (fun x : kaiMFDualShape K bf =>
      kaiMFDualCoeff K bf vv η (fun p => -l p) (x : NumberField.InfinitePlace K → ℝ) *
        ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          Real.exp (u w) * (x : NumberField.InfinitePlace K → ℝ) w ^ 2)) : ℝ) : ℂ))
      (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w)) -
        kaiHZArchWeight K η (fun p => -l p) 0) := by
    rw [← hFzero]
    exact hpunct (NumberField.InfinitePlace K → ℝ)
      (fun σ : NumberField.InfinitePlace K → ℝ => ∃ x : K, x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧ x ≠ 0 ∧
        (fun w : NumberField.InfinitePlace K => w x) = σ)
      (fun σ : NumberField.InfinitePlace K → ℝ =>
        kaiMFDualCoeff K bf vv η (fun p => -l p) σ *
          ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            Real.exp (u w) * σ w ^ 2)) : ℝ) : ℂ))
      (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w)))
      (0 : NumberField.InfinitePlace K → ℝ)
      hi0
      (fun σ hσ hno => by
        show kaiMFDualCoeff K bf vv η (fun p => -l p) σ *
            ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              Real.exp (u w) * σ w ^ 2)) : ℝ) : ℂ) = 0
        rw [hoffB σ hσ hno, zero_mul])
      hE
  have hM := hR2.mul_right (kaiMFConeWeight K z u)
  refine hM.congr_fun (fun x => ?_)
  rw [hprod ((x : NumberField.InfinitePlace K → ℝ)), ← mul_assoc]

theorem kai_mf_cone_dual_orbit_select_bound {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K))
    (b : Ideal (NumberField.RingOfIntegers K))
    (B : ℝ)
    (bf : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (vv : NumberField.mixedEmbedding.mixedSpace K)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (wq : ℕ)
    (Lat : AddSubgroup (NumberField.InfinitePlace K → ℝ)) (hcount : Countable ↥Lat)
    (hUsh : ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v →
        kaiMFUnitShift K v ∈ Lat)
    (hfin : ∀ M : ℝ, {ν : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
        ∀ w : NumberField.InfinitePlace K, w ((ν : K)) ≤ M}.Finite)
    (hcSh : Countable (kaiMFDualShape K bf))
    (harch : ∀ x : K, ‖kaiHZArchWeight K η (fun p => -l p)
          (NumberField.mixedEmbedding K x)‖
        = ∏ w : NumberField.InfinitePlace K, (w x) ^ (kaiHZDeg K η l w))
    (z : NumberField.InfinitePlace K → ℂ) (hzpos : ∀ w, 0 < (z w).re)
    (hz2 : ∀ w : NumberField.InfinitePlace K,
        2 * (z w).re - kaiHZDeg K η l w = 3 / 2 * (w.mult : ℝ))
    (act : ↥Lat → kaiMFDualShape K bf → kaiMFDualShape K bf)
    (hact : ∀ (γ : ↥Lat) (x : kaiMFDualShape K bf) (w : NumberField.InfinitePlace K),
        ((act γ x : kaiMFDualShape K bf) : NumberField.InfinitePlace K → ℝ) w
          = (x : NumberField.InfinitePlace K → ℝ) w *
              Real.exp ((γ : NumberField.InfinitePlace K → ℝ) w / 2))
    (hRepSum : ∀ Rep : Set {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)},
        (∀ ν ∈ Rep, ((ν : {x : K // x ∈ (bf : FractionalIdeal
            (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) : K) ≠ 0) →
        (∀ ν ∈ Rep, ∀ μ ∈ Rep, ∀ v : (NumberField.RingOfIntegers K)ˣ,
            KaiMFCongUnit K q v →
            (∀ w : NumberField.InfinitePlace K,
                w ((μ : {x : K // x ∈ (bf : FractionalIdeal
                    (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) : K)
                  = w (((v : NumberField.RingOfIntegers K) : K)) *
                    w ((ν : {x : K // x ∈ (bf : FractionalIdeal
                      (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) : K)) →
            ∀ w : NumberField.InfinitePlace K,
              w ((μ : {x : K // x ∈ (bf : FractionalIdeal
                  (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) : K)
                = w ((ν : {x : K // x ∈ (bf : FractionalIdeal
                    (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) : K)) →
        Summable (fun ν : Rep =>
            (|(Algebra.norm ℚ) ((ν : {x : K // x ∈ (bf : FractionalIdeal
                (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) : K)| : ℝ) ^
              (-((3 : ℝ) / 2))) ∧
          (∑' ν : Rep,
              (|(Algebra.norm ℚ) ((ν : {x : K // x ∈ (bf : FractionalIdeal
                  (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) : K)| : ℝ) ^
                (-((3 : ℝ) / 2)))
            ≤ (wq : ℝ) * ((Ideal.absNorm q : ℝ) *
                2 ^ (NumberField.InfinitePlace.nrRealPlaces K)) *
                (B * (Ideal.absNorm (q * b) : ℝ) ^ B) ^ ((3 : ℝ) / 2) *
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                  ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                    (-((3 : ℝ) / 2))) :
    ∃ (T : Type u) (_ : Countable T) (emb : T → kaiMFDualShape K bf),
      Function.Bijective (fun p : T × ↥Lat => act p.2 (emb p.1)) ∧
      Summable (fun x : T =>
          ‖kaiMFDualCoeff K bf vv η (fun p => -l p)
              ((emb x : kaiMFDualShape K bf) : NumberField.InfinitePlace K → ℝ)‖ *
            ∏ w : NumberField.InfinitePlace K,
              (Real.pi * ((emb x : kaiMFDualShape K bf) :
                NumberField.InfinitePlace K → ℝ) w ^ 2) ^ (-(z w).re)) ∧
      (∑' x : T,
          ‖kaiMFDualCoeff K bf vv η (fun p => -l p)
              ((emb x : kaiMFDualShape K bf) : NumberField.InfinitePlace K → ℝ)‖ *
            ∏ w : NumberField.InfinitePlace K,
              (Real.pi * ((emb x : kaiMFDualShape K bf) :
                NumberField.InfinitePlace K → ℝ) w ^ 2) ^ (-(z w).re))
        ≤ Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) / 2) *
            ((wq : ℝ) * ((Ideal.absNorm q : ℝ) *
              2 ^ (NumberField.InfinitePlace.nrRealPlaces K)) *
              (B * (Ideal.absNorm (q * b) : ℝ) ^ B) ^ ((3 : ℝ) / 2) *
              ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                  (-((3 : ℝ) / 2))) :=
by
  classical
  have hpos : ∀ (x : kaiMFDualShape K bf) (w : NumberField.InfinitePlace K),
      0 < ((x : kaiMFDualShape K bf) : NumberField.InfinitePlace K → ℝ) w := by
    intro x w
    obtain ⟨y, hy, hy0, hyx⟩ := x.2
    have h1 : w y = ((x : kaiMFDualShape K bf) :
        NumberField.InfinitePlace K → ℝ) w := congrFun hyx w
    rw [← h1]
    exact NumberField.InfinitePlace.pos_iff.mpr hy0
  have hact0 : ∀ x : kaiMFDualShape K bf, act 0 x = x := by
    intro x
    refine Subtype.ext (funext fun w => ?_)
    rw [hact 0 x w]
    have hz0 : ((0 : ↥Lat) : NumberField.InfinitePlace K → ℝ) w = 0 := by simp
    rw [hz0]
    simp
  have hactA : ∀ (γ δ : ↥Lat) (x : kaiMFDualShape K bf),
      act (γ + δ) x = act γ (act δ x) := by
    intro γ δ x
    refine Subtype.ext (funext fun w => ?_)
    rw [hact (γ + δ) x w, hact γ (act δ x) w, hact δ x w]
    have hc : ((γ + δ : ↥Lat) : NumberField.InfinitePlace K → ℝ) w
        = (γ : NumberField.InfinitePlace K → ℝ) w
          + (δ : NumberField.InfinitePlace K → ℝ) w := by simp
    rw [hc, show ((γ : NumberField.InfinitePlace K → ℝ) w
          + (δ : NumberField.InfinitePlace K → ℝ) w) / 2
        = (δ : NumberField.InfinitePlace K → ℝ) w / 2
          + (γ : NumberField.InfinitePlace K → ℝ) w / 2 from by ring, Real.exp_add]
    ring
  have hfree : ∀ (γ : ↥Lat) (x : kaiMFDualShape K bf), act γ x = x → γ = 0 := by
    intro γ x hx
    have hw : ∀ w : NumberField.InfinitePlace K,
        (γ : NumberField.InfinitePlace K → ℝ) w = 0 := by
      intro w
      have h1 : ((act γ x : kaiMFDualShape K bf) :
            NumberField.InfinitePlace K → ℝ) w
          = ((x : kaiMFDualShape K bf) : NumberField.InfinitePlace K → ℝ) w := by
        rw [hx]
      rw [hact γ x w] at h1
      have hx0 := hpos x w
      have h2 : Real.exp ((γ : NumberField.InfinitePlace K → ℝ) w / 2) = 1 :=
        mul_left_cancel₀ (ne_of_gt hx0) (h1.trans (mul_one _).symm)
      have h3 : (γ : NumberField.InfinitePlace K → ℝ) w / 2 = 0 := by
        have hl := congrArg Real.log h2
        rwa [Real.log_exp, Real.log_one] at hl
      linarith
    apply Subtype.ext
    funext w
    rw [hw w]
    simp
  
  obtain ⟨rS, hrS⟩ : ∃ rS : Setoid (kaiMFDualShape K bf),
      ∀ a b : kaiMFDualShape K bf, rS a b ↔ ∃ g : ↥Lat, act g a = b := by
    refine ⟨{ r := fun a b => ∃ g : ↥Lat, act g a = b,
              iseqv := ⟨fun a => ⟨0, hact0 a⟩, ?_, ?_⟩ }, fun a b => Iff.rfl⟩
    · rintro a b ⟨g, rfl⟩
      exact ⟨-g, by rw [← hactA, neg_add_cancel, hact0]⟩
    · rintro a b c ⟨g, rfl⟩ ⟨g', rfl⟩
      exact ⟨g' + g, by rw [hactA]⟩
  obtain ⟨T, emb, hbij⟩ : ∃ (T : Type u) (emb : T → kaiMFDualShape K bf),
      Function.Bijective (fun p : T × ↥Lat => act p.2 (emb p.1)) := by
    refine ⟨Quotient rS, fun t => @Quotient.out (kaiMFDualShape K bf) rS t, ?_, ?_⟩
    · rintro ⟨x, g⟩ ⟨x', g'⟩ hEq
      have hE : act g (@Quotient.out (kaiMFDualShape K bf) rS x)
          = act g' (@Quotient.out (kaiMFDualShape K bf) rS x') := hEq
      have hx : x = x' := by
        have hs := @Quotient.sound (kaiMFDualShape K bf) rS
          (@Quotient.out (kaiMFDualShape K bf) rS x)
          (@Quotient.out (kaiMFDualShape K bf) rS x')
          ((hrS _ _).2 ⟨-g' + g, by rw [hactA, hE, ← hactA, neg_add_cancel, hact0]⟩)
        rwa [@Quotient.out_eq (kaiMFDualShape K bf) rS x,
          @Quotient.out_eq (kaiMFDualShape K bf) rS x'] at hs
      subst hx
      have h0 : -g' + g = 0 := by
        refine hfree _ (@Quotient.out (kaiMFDualShape K bf) rS x) ?_
        rw [hactA, hE, ← hactA, neg_add_cancel, hact0]
      have hg : g = g' := by
        have h1 : g' + (-g' + g) = g' + 0 := by rw [h0]
        rw [← add_assoc, add_neg_cancel, zero_add, add_zero] at h1
        exact h1
      subst hg
      rfl
    · intro s
      obtain ⟨g, hg⟩ : ∃ g : ↥Lat,
          act g (@Quotient.out (kaiMFDualShape K bf) rS
            (@Quotient.mk (kaiMFDualShape K bf) rS s)) = s :=
        (hrS _ _).1 (@Quotient.mk_out (kaiMFDualShape K bf) rS s)
      exact ⟨(@Quotient.mk (kaiMFDualShape K bf) rS s, g), hg⟩
  have hembinj : Function.Injective emb := by
    intro x x' hxx
    have h1 : (fun p : T × ↥Lat => act p.2 (emb p.1)) (x, 0)
        = (fun p : T × ↥Lat => act p.2 (emb p.1)) (x', 0) := by
      show act 0 (emb x) = act 0 (emb x')
      rw [hxx]
    exact congrArg Prod.fst (hbij.1 h1)
  haveI hcT : Countable T := by
    haveI := hcSh
    exact hembinj.countable
  have hident : ∀ σ : NumberField.InfinitePlace K → ℝ,
      (∀ w : NumberField.InfinitePlace K, 0 < σ w) →
      (∏ w : NumberField.InfinitePlace K, σ w ^ (kaiHZDeg K η l w)) *
        (∏ w : NumberField.InfinitePlace K, (Real.pi * σ w ^ 2) ^ (-(z w).re))
        = Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (z w).re)) *
          (∏ w : NumberField.InfinitePlace K, σ w ^ (w.mult)) ^ (-((3 : ℝ) / 2)) := by
    intro σ hσ
    have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
    have hP : ∀ w : NumberField.InfinitePlace K, (0 : ℝ) < Real.pi * σ w ^ 2 :=
      fun w => mul_pos hpi (pow_pos (hσ w) 2)
    have hprodpos : (0 : ℝ) < ∏ w : NumberField.InfinitePlace K, σ w ^ (w.mult) :=
      Finset.prod_pos (fun w _ => pow_pos (hσ w) _)
    have hlogprod : Real.log (∏ w : NumberField.InfinitePlace K, σ w ^ (w.mult))
        = ∑ w : NumberField.InfinitePlace K, Real.log (σ w) * (w.mult : ℝ) := by
      rw [Real.log_prod (fun w _ => ne_of_gt (pow_pos (hσ w) (w.mult)))]
      exact Finset.sum_congr rfl (fun w _ => by rw [Real.log_pow]; ring)
    have key : ∀ w : NumberField.InfinitePlace K,
        Real.log (σ w) * kaiHZDeg K η l w
            + Real.log (Real.pi * σ w ^ 2) * (-(z w).re)
          = Real.log Real.pi * (-(z w).re)
            + Real.log (σ w) * (w.mult : ℝ) * (-((3 : ℝ) / 2)) := by
      intro w
      rw [Real.log_mul (ne_of_gt hpi) (ne_of_gt (pow_pos (hσ w) 2)), Real.log_pow]
      have h1 : kaiHZDeg K η l w = 2 * (z w).re - 3 / 2 * (w.mult : ℝ) := by
        linarith [hz2 w]
      rw [h1]
      push_cast
      ring
    rw [Real.rpow_def_of_pos hpi, Real.rpow_def_of_pos hprodpos, hlogprod,
      Finset.prod_congr rfl (fun w (_ : w ∈ Finset.univ) =>
        Real.rpow_def_of_pos (hσ w) (kaiHZDeg K η l w)),
      Finset.prod_congr rfl (fun w (_ : w ∈ Finset.univ) =>
        Real.rpow_def_of_pos (hP w) (-(z w).re)),
      ← Real.exp_sum, ← Real.exp_sum, ← Real.exp_add, ← Real.exp_add]
    congr 1
    rw [← Finset.sum_add_distrib,
      Finset.sum_congr rfl (fun w (_ : w ∈ Finset.univ) => key w),
      Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul,
      Finset.sum_neg_distrib]
  have hkey : ∀ σ : NumberField.InfinitePlace K → ℝ,
      (∀ w : NumberField.InfinitePlace K, 0 < σ w) →
      ‖kaiMFDualCoeff K bf vv η (fun p => -l p) σ‖ *
          ∏ w : NumberField.InfinitePlace K, (Real.pi * σ w ^ 2) ^ (-(z w).re)
        ≤ Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (z w).re)) *
            ∑' y : {y : K // y ∈ (bf : FractionalIdeal
                (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
                (fun w : NumberField.InfinitePlace K => w y) = σ},
              (|(Algebra.norm ℚ) ((y : K))| : ℝ) ^ (-((3 : ℝ) / 2)) := by
    intro σ hσ
    have hmem : ∀ y : {y : K // y ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
          (fun w : NumberField.InfinitePlace K => w y) = σ},
        (⟨(y : K), y.2.1⟩ : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) ∈
          {ν : {x : K // x ∈ (bf : FractionalIdeal
            (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
            ∀ w : NumberField.InfinitePlace K,
              w ((ν : K)) ≤ ∑ w' : NumberField.InfinitePlace K, σ w'} := by
      intro y w
      have hy : w ((y : K)) = σ w := congrFun y.2.2 w
      show w ((y : K)) ≤ ∑ w' : NumberField.InfinitePlace K, σ w'
      rw [hy]
      exact Finset.single_le_sum (f := σ) (fun i _ => (hσ i).le) (Finset.mem_univ w)
    haveI hfinite : Finite {y : K // y ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
        (fun w : NumberField.InfinitePlace K => w y) = σ} := by
      haveI := (hfin (∑ w' : NumberField.InfinitePlace K, σ w')).to_subtype
      refine Finite.of_injective (fun y => (⟨⟨(y : K), y.2.1⟩, hmem y⟩ :
        ↥{ν : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
            ∀ w : NumberField.InfinitePlace K,
              w ((ν : K)) ≤ ∑ w' : NumberField.InfinitePlace K, σ w'})) ?_
      intro a c hac
      have h1 : (⟨(a : K), a.2.1⟩ : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)})
          = ⟨(c : K), c.2.1⟩ := congrArg Subtype.val hac
      have h2 : (a : K) = (c : K) :=
        congrArg (fun t : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} => (t : K)) h1
      exact Subtype.ext h2
    have hnormterm : ∀ ν : {y : K // y ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
          (fun w : NumberField.InfinitePlace K => w y) = σ},
        ‖kaiHZArchWeight K η (fun p => -l p)
              (NumberField.mixedEmbedding K ((ν : K))) *
            Complex.exp (2 * Real.pi * Complex.I *
              ((kaiHZMixedInner K
                (NumberField.mixedEmbedding K ((ν : K))) vv : ℝ) : ℂ))‖
          = ∏ w : NumberField.InfinitePlace K, (σ w) ^ (kaiHZDeg K η l w) := by
      intro ν
      rw [norm_mul, Complex.norm_exp]
      have hre : (2 * (Real.pi : ℂ) * Complex.I *
          ((kaiHZMixedInner K
            (NumberField.mixedEmbedding K ((ν : K))) vv : ℝ) : ℂ)).re = 0 := by
        simp [Complex.mul_re, Complex.mul_im]
      rw [hre, Real.exp_zero, mul_one, harch]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      have hw : w ((ν : K)) = σ w := congrFun ν.2.2 w
      rw [hw]
    have hsumN : Summable (fun ν : {y : K // y ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
        (fun w : NumberField.InfinitePlace K => w y) = σ} =>
        ‖kaiHZArchWeight K η (fun p => -l p)
            (NumberField.mixedEmbedding K ((ν : K))) *
          Complex.exp (2 * Real.pi * Complex.I *
            ((kaiHZMixedInner K
              (NumberField.mixedEmbedding K ((ν : K))) vv : ℝ) : ℂ))‖) :=
      Summable.of_finite
    have hstep1 : ‖kaiMFDualCoeff K bf vv η (fun p => -l p) σ‖
        ≤ ∑' _ν : {y : K // y ∈ (bf : FractionalIdeal
            (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
            (fun w : NumberField.InfinitePlace K => w y) = σ},
          ∏ w : NumberField.InfinitePlace K, (σ w) ^ (kaiHZDeg K η l w) := by
      have hdc : kaiMFDualCoeff K bf vv η (fun p => -l p) σ
          = ∑' ν : {y : K // y ∈ (bf : FractionalIdeal
              (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
              (fun w : NumberField.InfinitePlace K => w y) = σ},
            kaiHZArchWeight K η (fun p => -l p)
                (NumberField.mixedEmbedding K ((ν : K))) *
              Complex.exp (2 * Real.pi * Complex.I *
                ((kaiHZMixedInner K
                  (NumberField.mixedEmbedding K ((ν : K))) vv : ℝ) : ℂ)) := rfl
      rw [hdc]
      exact (norm_tsum_le_tsum_norm hsumN).trans (le_of_eq (tsum_congr hnormterm))
    have hP0 : (0 : ℝ) ≤ ∏ w : NumberField.InfinitePlace K,
        (Real.pi * σ w ^ 2) ^ (-(z w).re) :=
      Finset.prod_nonneg (fun w _ =>
        Real.rpow_nonneg (mul_nonneg Real.pi_pos.le (sq_nonneg _)) _)
    have hterm : ∀ ν : {y : K // y ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
          (fun w : NumberField.InfinitePlace K => w y) = σ},
        (∏ w : NumberField.InfinitePlace K, σ w ^ (kaiHZDeg K η l w)) *
            (∏ w : NumberField.InfinitePlace K, (Real.pi * σ w ^ 2) ^ (-(z w).re))
          = Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (z w).re)) *
            (|(Algebra.norm ℚ) ((ν : K))| : ℝ) ^ (-((3 : ℝ) / 2)) := by
      intro ν
      rw [hident σ hσ]
      congr 1
      have hpr : (∏ w : NumberField.InfinitePlace K, σ w ^ (w.mult))
          = ((|(Algebra.norm ℚ) ((ν : K))| : ℚ) : ℝ) := by
        rw [← NumberField.InfinitePlace.prod_eq_abs_norm ((ν : K))]
        refine Finset.prod_congr rfl (fun w _ => ?_)
        have hw : w ((ν : K)) = σ w := congrFun ν.2.2 w
        rw [hw]
      rw [hpr, Rat.cast_abs]
    refine (mul_le_mul_of_nonneg_right hstep1 hP0).trans (le_of_eq ?_)
    calc (∑' _ν : {y : K // y ∈ (bf : FractionalIdeal
              (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
              (fun w : NumberField.InfinitePlace K => w y) = σ},
            ∏ w : NumberField.InfinitePlace K, (σ w) ^ (kaiHZDeg K η l w)) *
          (∏ w : NumberField.InfinitePlace K, (Real.pi * σ w ^ 2) ^ (-(z w).re))
        = ∑' ν : {y : K // y ∈ (bf : FractionalIdeal
              (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
              (fun w : NumberField.InfinitePlace K => w y) = σ},
            ((∏ w : NumberField.InfinitePlace K, (σ w) ^ (kaiHZDeg K η l w)) *
              ∏ w : NumberField.InfinitePlace K,
                (Real.pi * σ w ^ 2) ^ (-(z w).re)) := tsum_mul_right.symm
      _ = ∑' ν : {y : K // y ∈ (bf : FractionalIdeal
              (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
              (fun w : NumberField.InfinitePlace K => w y) = σ},
            (Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (z w).re)) *
              (|(Algebra.norm ℚ) ((ν : K))| : ℝ) ^ (-((3 : ℝ) / 2))) :=
          tsum_congr hterm
      _ = Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (z w).re)) *
            ∑' ν : {y : K // y ∈ (bf : FractionalIdeal
              (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
              (fun w : NumberField.InfinitePlace K => w y) = σ},
