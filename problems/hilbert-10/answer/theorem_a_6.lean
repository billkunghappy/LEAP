      _ = C₃ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ c₃)) := by ring

theorem kv_int_matrix_pseudoinverse (r a : ℕ) (K : Fin r → Fin a → ℤ) (X : ℝ) (hX : 1 ≤ X)
    (hK : ∀ m i, |(K m i : ℝ)| ≤ X) :
    ∃ (Δ : ℕ) (C : Fin a → Fin r → ℤ), 1 ≤ Δ ∧
      (Δ : ℝ) ≤ (((a : ℝ) + 1) * X) ^ (4 * a) ∧
      (∀ i, ∑ m, |(C i m : ℝ)| ≤ (((a : ℝ) + 1) * X) ^ (4 * a)) ∧
      ∀ m j, ∑ m', ∑ i, K m i * C i m' * K m' j = (Δ : ℤ) * K m j :=
by
  classical
  
  have s1 : ∀ (k : ℕ) (f : Fin k → Fin r) (g : Fin k → Fin a) (m : Fin r) (j : Fin a),
      ((Matrix.of K).submatrix (Fin.cons m f : Fin (k + 1) → Fin r)
          (Fin.cons j g : Fin (k + 1) → Fin a)).det
        = K m j * ((Matrix.of K).submatrix f g).det
          - ∑ s : Fin k, ∑ t : Fin k,
              K m (g s) * ((Matrix.of K).submatrix f g).adjugate s t * K (f t) j := by
    intro k f g m j
    rcases k with _ | k
    · simp [Matrix.det_unique]
    · rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
      have h0 : ((Matrix.of K).submatrix (Fin.cons m f : Fin (k + 2) → Fin r)
          (Fin.cons j g : Fin (k + 2) → Fin a)).submatrix Fin.succ (Fin.succAbove 0)
          = (Matrix.of K).submatrix f g := by
        ext u v; simp [Fin.succAbove_zero]
      have hs : ∀ s : Fin (k + 1), (((Matrix.of K).submatrix
          (Fin.cons m f : Fin (k + 2) → Fin r)
          (Fin.cons j g : Fin (k + 2) → Fin a)).submatrix Fin.succ (s.succ).succAbove).det
          = ∑ t : Fin (k + 1), (-1) ^ (t : ℕ) * K (f t) j *
              (((Matrix.of K).submatrix f g).submatrix t.succAbove s.succAbove).det := by
        intro s
        rw [Matrix.det_succ_column_zero]
        refine Finset.sum_congr rfl fun t _ => ?_
        congr 2 <;> (try ext u v) <;> simp [Fin.succ_succAbove_succ]
      rw [h0, sub_eq_add_neg, ← Finset.sum_neg_distrib]
      simp only [hs, Matrix.adjugate_fin_succ_eq_det_submatrix]
      congr 1
      · simp
      · refine Finset.sum_congr rfl fun s _ => ?_
        rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun t _ => ?_
        simp only [Matrix.submatrix_apply, Matrix.of_apply, Fin.cons_zero, Fin.cons_succ,
          Fin.val_succ, pow_succ, pow_add]
        ring
  
  have s2 : ∃ (k : ℕ) (f : Fin k → Fin r) (g : Fin k → Fin a), k ≤ a ∧
      ((Matrix.of K).submatrix f g).det ≠ 0 ∧
      ∀ (m : Fin r) (j : Fin a),
        ((Matrix.of K).submatrix (Fin.cons m f : Fin (k + 1) → Fin r)
          (Fin.cons j g : Fin (k + 1) → Fin a)).det = 0 := by
    have hP0 : ∃ (f : Fin 0 → Fin r) (g : Fin 0 → Fin a),
        ((Matrix.of K).submatrix f g).det ≠ 0 := ⟨Fin.elim0, Fin.elim0, by simp⟩
    have hPa : ∀ n, (∃ (f : Fin n → Fin r) (g : Fin n → Fin a),
        ((Matrix.of K).submatrix f g).det ≠ 0) → n ≤ a := by
      rintro n ⟨f, g, hfg⟩
      by_contra h
      push_neg at h
      obtain ⟨x, y, hxy, hg⟩ := Fintype.exists_ne_map_eq_of_card_lt g (by simpa using h)
      exact hfg (Matrix.det_zero_of_column_eq hxy (fun l => by simp [hg]))
    obtain ⟨f, g, hfg⟩ := Nat.findGreatest_spec (P := fun n => ∃ (f : Fin n → Fin r)
      (g : Fin n → Fin a), ((Matrix.of K).submatrix f g).det ≠ 0) (zero_le a) hP0
    refine ⟨_, f, g, Nat.findGreatest_le a, hfg, fun m j => ?_⟩
    by_contra hne
    have hP1 : ∃ (f' : Fin (Nat.findGreatest (fun n => ∃ (f : Fin n → Fin r)
        (g : Fin n → Fin a), ((Matrix.of K).submatrix f g).det ≠ 0) a + 1) → Fin r)
        (g' : Fin _ → Fin a), ((Matrix.of K).submatrix f' g').det ≠ 0 := ⟨_, _, hne⟩
    exact Nat.findGreatest_is_greatest (Nat.lt_succ_self _) (hPa _ hP1) hP1
  
  have s3 : ∀ (k : ℕ) (N : Matrix (Fin k) (Fin k) ℤ), (∀ s t, |((N s t : ℤ) : ℝ)| ≤ X) →
      |((N.det : ℤ) : ℝ)| ≤ (k.factorial : ℝ) * X ^ k := by
    intro k N hN
    have h1 : ((N.det : ℤ) : ℝ) = (N.map (Int.cast : ℤ → ℝ)).det := Int.cast_det N
    rw [h1]
    have := Matrix.det_le (abv := AbsoluteValue.abs) (A := N.map (Int.cast : ℤ → ℝ)) (x := X)
      (fun i j => by simpa using hN i j)
    simpa [Fintype.card_fin, nsmul_eq_mul] using this
  obtain ⟨k, f, g, hka, hdet, hvan⟩ := s2
  obtain ⟨M, hM⟩ : ∃ M, M = (Matrix.of K).submatrix f g := ⟨_, rfl⟩
  rw [← hM] at hdet
  have hMb : ∀ s t, |((M s t : ℤ) : ℝ)| ≤ X := fun s t => by
    rw [hM]; exact hK (f s) (g t)
  have hDb := s3 k M hMb
  have hAb : ∀ s t, |((M.adjugate s t : ℤ) : ℝ)| ≤ (k.factorial : ℝ) * X ^ k := by
    intro s t
    rw [Matrix.adjugate_apply]
    apply s3
    intro u v
    rw [Matrix.updateRow_apply]
    split_ifs with h
    · rw [Pi.single_apply]
      split_ifs <;> simp <;> linarith
    · exact hMb u v
  
  have s4 : (k.factorial : ℝ) * X ^ k ≤ (((a : ℝ) + 1) * X) ^ (4 * a) ∧
      (k : ℝ) * ((k : ℝ) * ((k.factorial : ℝ) * X ^ k)) ≤ (((a : ℝ) + 1) * X) ^ (4 * a) := by
    have hf : k.factorial ≤ (a + 1) ^ k :=
      (Nat.factorial_le_pow k).trans (Nat.pow_le_pow_left (by omega) k)
    have hXk : X ^ k ≤ X ^ (4 * a) := pow_le_pow_right₀ hX (by omega)
    have hX0 : 0 ≤ X ^ k := by positivity
    rw [mul_pow]
    constructor
    · have h2 : (a + 1) ^ k ≤ (a + 1) ^ (4 * a) := Nat.pow_le_pow_right (by omega) (by omega)
      have h3 : (k.factorial : ℝ) ≤ ((a : ℝ) + 1) ^ (4 * a) := by exact_mod_cast hf.trans h2
      exact mul_le_mul h3 hXk hX0 (by positivity)
    · have h3 : ((k * k * k.factorial : ℕ) : ℝ) ≤ ((a : ℝ) + 1) ^ (4 * a) := by
        rcases Nat.eq_zero_or_pos k with h | h
        · subst h; simp only [zero_mul, Nat.cast_zero]; positivity
        · have h4 : k * k * k.factorial ≤ (a + 1) * (a + 1) * (a + 1) ^ k :=
            Nat.mul_le_mul (Nat.mul_le_mul (by omega) (by omega)) hf
          have h5 : (a + 1) * (a + 1) * (a + 1) ^ k ≤ (a + 1) ^ (4 * a) := by
            rw [← pow_two, ← pow_add]; exact Nat.pow_le_pow_right (by omega) (by omega)
          exact_mod_cast h4.trans h5
      push_cast at h3
      rw [← mul_assoc, ← mul_assoc]
      exact mul_le_mul h3 hXk hX0 (by positivity)
  obtain ⟨hB1, hB2⟩ := s4
  
  have hkey : ∀ m j, ∑ s, ∑ t, K m (g s) * M.adjugate s t * K (f t) j = M.det * K m j := by
    intro m j
    have h := s1 k f g m j
    rw [hvan m j, ← hM] at h
    linear_combination h
  refine ⟨M.det.natAbs,
    fun i m' => M.det.sign * ∑ s, ∑ t, if g s = i ∧ f t = m' then M.adjugate s t else 0,
    Int.natAbs_pos.mpr hdet, ?_, ?_, ?_⟩
  · rw [Nat.cast_natAbs, Int.cast_abs]; exact hDb.trans hB1
  · intro i
    dsimp only
    have hsg : |((M.det.sign : ℤ) : ℝ)| ≤ 1 := by
      rcases Int.sign_trichotomy M.det with h | h | h <;> simp [h]
    calc ∑ m', |((M.det.sign * ∑ s, ∑ t,
            (if g s = i ∧ f t = m' then M.adjugate s t else 0) : ℤ) : ℝ)|
        ≤ ∑ m', ∑ s, ∑ t,
            |(((if g s = i ∧ f t = m' then M.adjugate s t else 0 : ℤ)) : ℝ)| := by
          apply Finset.sum_le_sum; intro m' _
          rw [Int.cast_mul, abs_mul]
          calc |((M.det.sign : ℤ) : ℝ)| * |((∑ s, ∑ t,
                (if g s = i ∧ f t = m' then M.adjugate s t else 0) : ℤ) : ℝ)|
              ≤ 1 * |((∑ s, ∑ t,
                (if g s = i ∧ f t = m' then M.adjugate s t else 0) : ℤ) : ℝ)| :=
                mul_le_mul_of_nonneg_right hsg (abs_nonneg _)
            _ ≤ ∑ s, ∑ t,
                |(((if g s = i ∧ f t = m' then M.adjugate s t else 0 : ℤ)) : ℝ)| := by
                rw [one_mul, Int.cast_sum]
                refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun s _ => ?_)
                rw [Int.cast_sum]
                exact Finset.abs_sum_le_sum_abs _ _
      _ = ∑ s, ∑ t, ∑ m',
            |(((if g s = i ∧ f t = m' then M.adjugate s t else 0 : ℤ)) : ℝ)| := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [Finset.sum_comm]
      _ ≤ ∑ s, ∑ t, ∑ m', (if f t = m' then |((M.adjugate s t : ℤ) : ℝ)| else 0) := by
          refine Finset.sum_le_sum fun s _ => Finset.sum_le_sum fun t _ =>
            Finset.sum_le_sum fun m' _ => ?_
          by_cases h2 : f t = m'
          · rw [if_pos h2]; split_ifs <;> simp
          · rw [if_neg h2, if_neg (fun h => h2 h.2)]; simp
      _ = ∑ s, ∑ t, |((M.adjugate s t : ℤ) : ℝ)| := by simp
      _ ≤ ∑ _s : Fin k, ∑ _t : Fin k, (k.factorial : ℝ) * X ^ k :=
          Finset.sum_le_sum fun s _ => Finset.sum_le_sum fun t _ => hAb s t
      _ = (k : ℝ) * ((k : ℝ) * ((k.factorial : ℝ) * X ^ k)) := by
          simp [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ ≤ _ := hB2
  · intro m j
    dsimp only
    have swap4 : ∀ (F : Fin r → Fin a → Fin k → Fin k → ℤ),
        ∑ m', ∑ i, ∑ s, ∑ t, F m' i s t = ∑ s, ∑ t, ∑ m', ∑ i, F m' i s t := by
      intro F
      calc ∑ m', ∑ i, ∑ s, ∑ t, F m' i s t = ∑ m', ∑ s, ∑ i, ∑ t, F m' i s t :=
            Finset.sum_congr rfl fun m' _ => Finset.sum_comm
        _ = ∑ s, ∑ m', ∑ i, ∑ t, F m' i s t := Finset.sum_comm
        _ = ∑ s, ∑ m', ∑ t, ∑ i, F m' i s t :=
            Finset.sum_congr rfl fun s _ => Finset.sum_congr rfl fun m' _ => Finset.sum_comm
        _ = ∑ s, ∑ t, ∑ m', ∑ i, F m' i s t :=
            Finset.sum_congr rfl fun s _ => Finset.sum_comm
    calc ∑ m', ∑ i, K m i * (M.det.sign * ∑ s, ∑ t,
            (if g s = i ∧ f t = m' then M.adjugate s t else 0)) * K m' j
        = ∑ m', ∑ i, M.det.sign * ∑ s, ∑ t,
            (if g s = i ∧ f t = m' then K m (g s) * M.adjugate s t * K (f t) j else 0) := by
          refine Finset.sum_congr rfl fun m' _ => Finset.sum_congr rfl fun i _ => ?_
          simp only [Finset.mul_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun s _ => Finset.sum_congr rfl fun t _ => ?_
          split_ifs with h
          · rw [h.1, h.2]; ring
          · ring
      _ = M.det.sign * ∑ m', ∑ i, ∑ s, ∑ t,
            (if g s = i ∧ f t = m' then K m (g s) * M.adjugate s t * K (f t) j else 0) := by
          simp only [Finset.mul_sum]
      _ = M.det.sign * ∑ s, ∑ t, ∑ m', ∑ i,
            (if g s = i ∧ f t = m' then K m (g s) * M.adjugate s t * K (f t) j else 0) := by
          rw [swap4]
      _ = M.det.sign * ∑ s, ∑ t, K m (g s) * M.adjugate s t * K (f t) j := by
          congr 1
          refine Finset.sum_congr rfl fun s _ => Finset.sum_congr rfl fun t _ => ?_
          simp [ite_and]
      _ = M.det.sign * (M.det * K m j) := by rw [hkey]
      _ = ((M.det.natAbs : ℕ) : ℤ) * K m j := by rw [← Int.sign_mul_self]; ring

theorem kv_horizontal_split (ν a b r : ℕ) (K : Fin r → Fin a → ℤ) (C : Fin a → Fin r → ℤ)
    (Δ : ℕ) (hΔ : 1 ≤ Δ)
    (hKCK : ∀ m j, ∑ m', ∑ i, K m i * C i m' * K m' j = (Δ : ℤ) * K m j)
    (B X M : ℝ) (hX : 1 ≤ X) (hM : 1 ≤ M) (hΔB : (Δ : ℝ) ≤ B)
    (hC : ∀ i, ∑ m, |(C i m : ℝ)| ≤ B) (hK : ∀ m i, |(K m i : ℝ)| ≤ X)
    (p₁ : Fin ν → Fin a → ℝ) (hsmooth : Nil2Smooth p₁ K X M)
    (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ) (hiso : Nil2Isotropic Bc ξ K) :
    ∃ (n : Fin ν → Fin a → ℤ) (σ : Fin ν → Fin a → ℝ) (μ : Fin a → Fin a → ℤ),
      (∀ l i, |σ l i| ≤ B * X / M) ∧
      (∀ j i, |(μ j i : ℝ)| ≤ 2 * B * X) ∧
      (∀ l i, ∑ j, ((p₁ l j - (n l j : ℝ) / Δ - σ l j) / Δ) * (μ j i : ℝ)
          = p₁ l i - (n l i : ℝ) / Δ - σ l i) ∧
      (∀ j j', ∑ i, ∑ i', (∑ k, ξ k * Bc i i' k) * μ j i * μ j' i'
          = ∑ i, ∑ i', (∑ k, ξ k * Bc i i' k) * μ j' i * μ j i') :=
by
  classical
  have hΔpos : (0 : ℝ) < (Δ : ℝ) := by exact_mod_cast hΔ
  have hΔne : (Δ : ℝ) ≠ 0 := hΔpos.ne'
  have hΔ1 : (1 : ℝ) ≤ (Δ : ℝ) := by exact_mod_cast hΔ
  have hB0 : 0 ≤ B := by linarith
  have hX0 : 0 ≤ X := by linarith
  have hM0 : 0 < M := by linarith
  unfold Nil2Smooth at hsmooth
  unfold Nil2Isotropic at hiso
  choose e he using hsmooth
  
  obtain ⟨s, hs_def⟩ : ∃ s : Fin r → Fin ν → ℝ,
      ∀ m l, s m l = ∑ i, (K m i : ℝ) * p₁ l i - (e m l : ℝ) :=
    ⟨fun m l => ∑ i, (K m i : ℝ) * p₁ l i - (e m l : ℝ), fun _ _ => rfl⟩
  have hs : ∀ m l, |s m l| ≤ X / M := by
    intro m l; rw [hs_def]; exact he m l
  obtain ⟨n, hn⟩ : ∃ n : Fin ν → Fin a → ℤ, ∀ l i, n l i = ∑ m, C i m * e m l :=
    ⟨fun l i => ∑ m, C i m * e m l, fun _ _ => rfl⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : Fin ν → Fin a → ℝ,
      ∀ l i, σ l i = (∑ m, (C i m : ℝ) * s m l) / (Δ : ℝ) :=
    ⟨fun l i => (∑ m, (C i m : ℝ) * s m l) / (Δ : ℝ), fun _ _ => rfl⟩
  obtain ⟨μ, hμ⟩ : ∃ μ : Fin a → Fin a → ℤ,
      ∀ j i, μ j i = (if i = j then (Δ : ℤ) else 0) - ∑ m, C i m * K m j :=
    ⟨fun j i => (if i = j then (Δ : ℤ) else 0) - ∑ m, C i m * K m j, fun _ _ => rfl⟩
  
  have hkμ : ∀ j m, ∑ i, K m i * μ j i = 0 := by
    intro j m
    have h1 : ∑ i, K m i * μ j i
        = ∑ i, K m i * (if i = j then (Δ : ℤ) else 0)
          - ∑ m', ∑ i, K m i * C i m' * K m' j := by
      simp only [hμ, mul_sub, Finset.sum_sub_distrib]
      congr 1
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun m' _ => ?_)
      ring
    rw [h1, hKCK m j]
    simp only [mul_ite, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring
  have hkμR : ∀ j m, ∑ i, (K m i : ℝ) * (μ j i : ℝ) = 0 := by
    intro j m
    exact_mod_cast hkμ j m
  
  have hrec : ∀ v : Fin a → ℝ, (∀ m, ∑ j, (K m j : ℝ) * v j = 0) →
      ∀ i, ∑ j, v j / (Δ : ℝ) * (μ j i : ℝ) = v i := by
    intro v hv i
    have h2 : ∑ j, v j / (Δ : ℝ) * ∑ m, (C i m : ℝ) * (K m j : ℝ) = 0 := by
      calc ∑ j, v j / (Δ : ℝ) * ∑ m, (C i m : ℝ) * (K m j : ℝ)
          = ∑ j, ∑ m, (C i m : ℝ) / (Δ : ℝ) * ((K m j : ℝ) * v j) := by
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun m _ => ?_)
            ring
        _ = ∑ m, ∑ j, (C i m : ℝ) / (Δ : ℝ) * ((K m j : ℝ) * v j) := Finset.sum_comm
        _ = ∑ m, (C i m : ℝ) / (Δ : ℝ) * ∑ j, (K m j : ℝ) * v j := by
            refine Finset.sum_congr rfl (fun m _ => ?_)
            rw [Finset.mul_sum]
        _ = 0 := by simp [hv]
    have h3 : ∑ j, v j / (Δ : ℝ) * (μ j i : ℝ)
        = ∑ j, v j / (Δ : ℝ) * (if i = j then (Δ : ℝ) else 0)
          - ∑ j, v j / (Δ : ℝ) * ∑ m, (C i m : ℝ) * (K m j : ℝ) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hμ j i]
      push_cast
      ring
    rw [h3, h2, sub_zero]
    simp only [mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    exact div_mul_cancel₀ _ hΔne
  
  have hv : ∀ l m, ∑ j, (K m j : ℝ) * (p₁ l j - (n l j : ℝ) / Δ - σ l j) = 0 := by
    intro l m
    have hkey : ∀ j, p₁ l j - (n l j : ℝ) / Δ - σ l j
        = p₁ l j - (∑ m', (C j m' : ℝ) * ∑ i', (K m' i' : ℝ) * p₁ l i') / Δ := by
      intro j
      have hadd : (n l j : ℝ) + ∑ m', (C j m' : ℝ) * s m' l
          = ∑ m', (C j m' : ℝ) * ∑ i', (K m' i' : ℝ) * p₁ l i' := by
        rw [hn]
        push_cast
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun m' _ => ?_)
        rw [hs_def]
        ring
      rw [hσ, ← hadd, add_div]
      ring
    have hR : ∀ i', ∑ m', ∑ j, (K m j : ℝ) * (C j m' : ℝ) * (K m' i' : ℝ)
        = (Δ : ℝ) * (K m i' : ℝ) := by
      intro i'
      exact_mod_cast hKCK m i'
    have hT : ∑ j, (K m j : ℝ) * ∑ m', (C j m' : ℝ) * ∑ i', (K m' i' : ℝ) * p₁ l i'
        = (Δ : ℝ) * ∑ i', (K m i' : ℝ) * p₁ l i' := by
      calc ∑ j, (K m j : ℝ) * ∑ m', (C j m' : ℝ) * ∑ i', (K m' i' : ℝ) * p₁ l i'
          = ∑ j, ∑ m', ∑ i', (K m j : ℝ) * (C j m' : ℝ) * (K m' i' : ℝ) * p₁ l i' := by
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun m' _ => ?_)
            rw [Finset.mul_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i' _ => ?_)
            ring
        _ = ∑ m', ∑ j, ∑ i', (K m j : ℝ) * (C j m' : ℝ) * (K m' i' : ℝ) * p₁ l i' :=
            Finset.sum_comm
        _ = ∑ m', ∑ i', ∑ j, (K m j : ℝ) * (C j m' : ℝ) * (K m' i' : ℝ) * p₁ l i' := by
            refine Finset.sum_congr rfl (fun m' _ => ?_)
            exact Finset.sum_comm
        _ = ∑ i', ∑ m', ∑ j, (K m j : ℝ) * (C j m' : ℝ) * (K m' i' : ℝ) * p₁ l i' :=
            Finset.sum_comm
        _ = ∑ i', (∑ m', ∑ j, (K m j : ℝ) * (C j m' : ℝ) * (K m' i' : ℝ)) * p₁ l i' := by
            refine Finset.sum_congr rfl (fun i' _ => ?_)
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun m' _ => ?_)
            rw [Finset.sum_mul]
        _ = ∑ i', (Δ : ℝ) * (K m i' : ℝ) * p₁ l i' := by
            refine Finset.sum_congr rfl (fun i' _ => ?_)
            rw [hR i']
        _ = (Δ : ℝ) * ∑ i', (K m i' : ℝ) * p₁ l i' := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i' _ => ?_)
            ring
    calc ∑ j, (K m j : ℝ) * (p₁ l j - (n l j : ℝ) / Δ - σ l j)
        = ∑ j, (K m j : ℝ) * (p₁ l j
            - (∑ m', (C j m' : ℝ) * ∑ i', (K m' i' : ℝ) * p₁ l i') / Δ) := by
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [hkey j]
      _ = ∑ j, (K m j : ℝ) * p₁ l j
            - (∑ j, (K m j : ℝ) * ∑ m', (C j m' : ℝ) * ∑ i', (K m' i' : ℝ) * p₁ l i') / Δ := by
          rw [Finset.sum_div, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          ring
      _ = 0 := by
          rw [hT, mul_div_cancel_left₀ _ hΔne, sub_self]
  
  have hsumCK : ∀ i j, |∑ m, (C i m : ℝ) * (K m j : ℝ)| ≤ B * X := by
    intro i j
    calc |∑ m, (C i m : ℝ) * (K m j : ℝ)| ≤ ∑ m, |(C i m : ℝ) * (K m j : ℝ)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ = ∑ m, |(C i m : ℝ)| * |(K m j : ℝ)| := by simp only [abs_mul]
      _ ≤ ∑ m, |(C i m : ℝ)| * X :=
          Finset.sum_le_sum (fun m _ => mul_le_mul_of_nonneg_left (hK m j) (abs_nonneg _))
      _ = (∑ m, |(C i m : ℝ)|) * X := by rw [Finset.sum_mul]
      _ ≤ B * X := mul_le_mul_of_nonneg_right (hC i) hX0
  refine ⟨n, σ, μ, ?_, ?_, ?_, ?_⟩
  · 
    intro l i
    rw [hσ l i, abs_div, abs_of_pos hΔpos]
    have hS : |∑ m, (C i m : ℝ) * s m l| ≤ B * (X / M) := by
      calc |∑ m, (C i m : ℝ) * s m l| ≤ ∑ m, |(C i m : ℝ) * s m l| :=
            Finset.abs_sum_le_sum_abs _ _
        _ = ∑ m, |(C i m : ℝ)| * |s m l| := by simp only [abs_mul]
        _ ≤ ∑ m, |(C i m : ℝ)| * (X / M) :=
            Finset.sum_le_sum (fun m _ => mul_le_mul_of_nonneg_left (hs m l) (abs_nonneg _))
        _ = (∑ m, |(C i m : ℝ)|) * (X / M) := by rw [Finset.sum_mul]
        _ ≤ B * (X / M) := mul_le_mul_of_nonneg_right (hC i) (div_nonneg hX0 hM0.le)
    calc |∑ m, (C i m : ℝ) * s m l| / (Δ : ℝ) ≤ |∑ m, (C i m : ℝ) * s m l| :=
          div_le_self (abs_nonneg _) hΔ1
      _ ≤ B * (X / M) := hS
      _ = B * X / M := by ring
  · 
    intro j i
    rw [hμ j i]
    push_cast
    have hite : |(if i = j then (Δ : ℝ) else 0)| ≤ B := by
      split_ifs
      · rw [abs_of_nonneg (Nat.cast_nonneg _)]; exact hΔB
      · rw [abs_zero]; exact hB0
    have hBX : B ≤ B * X := le_mul_of_one_le_right hB0 hX
    calc |(if i = j then (Δ : ℝ) else 0) - ∑ m, (C i m : ℝ) * (K m j : ℝ)|
        ≤ |(if i = j then (Δ : ℝ) else 0)| + |∑ m, (C i m : ℝ) * (K m j : ℝ)| := abs_sub _ _
      _ ≤ B + B * X := add_le_add hite (hsumCK i j)
      _ ≤ 2 * B * X := by linarith
  · 
    intro l i
    exact hrec (fun j => p₁ l j - (n l j : ℝ) / Δ - σ l j) (hv l) i
  · 
    intro j j'
    have h0 := hiso (fun i => (μ j i : ℝ)) (fun i => (μ j' i : ℝ)) (hkμR j) (hkμR j')
    try simp only at h0
    apply Int.cast_injective (α := ℝ)
    push_cast
    have hswap : ∑ i, ∑ i', (∑ k, (ξ k : ℝ) * (Bc i i' k : ℝ)) * (μ j' i : ℝ) * (μ j i' : ℝ)
        = ∑ i, ∑ i', (∑ k, (ξ k : ℝ) * (Bc i' i k : ℝ)) * (μ j' i' : ℝ) * (μ j i : ℝ) :=
      Finset.sum_comm
    rw [hswap, ← sub_eq_zero, ← Finset.sum_sub_distrib]
    refine Eq.trans ?_ h0
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun i' _ => ?_)
    simp only [Finset.sum_mul, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    ring

theorem kv_nil2_vert_factor {a b : ℕ} (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ)
    (hΓ : ∀ u (γ₁ : Fin a → ℤ) (γ₂ : Fin b → ℤ),
      F (nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))) = F u)
    (hvert : ∀ u (t : Fin b → ℝ), F (u.1, fun k => u.2 k + t k)
      = Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ξ k : ℝ) * t k : ℝ) : ℂ)) * F u) :
    (∀ u : (Fin a → ℝ) × (Fin b → ℝ), F u =
      Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ξ k : ℝ) * u.2 k : ℝ) : ℂ))
        * F (u.1, fun _ => 0)) ∧
    (∀ (u₁ : Fin a → ℝ) (γ : Fin a → ℤ),
      F ((fun i => u₁ i + (γ i : ℝ)), fun _ => 0) =
        Complex.exp (2 * Real.pi * Complex.I *
          ((-(∑ i, ∑ j, ((∑ k, ξ k * Bc i j k : ℤ) : ℝ) * u₁ i * (γ j : ℝ)) : ℝ) : ℂ))
        * F (u₁, fun _ => 0)) :=
by
  have h1 : ∀ u : (Fin a → ℝ) × (Fin b → ℝ), F u =
      Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ξ k : ℝ) * u.2 k : ℝ) : ℂ))
        * F (u.1, fun _ => 0) := by
    intro u
    have h := hvert (u.1, fun _ => 0) u.2
    have hu : (((u.1, fun _ => (0 : ℝ)) : (Fin a → ℝ) × (Fin b → ℝ)).1,
        fun k => ((u.1, fun _ => (0 : ℝ)) : (Fin a → ℝ) × (Fin b → ℝ)).2 k + u.2 k) = u := by
      ext k <;> simp
    rw [hu] at h
    exact h
  refine ⟨h1, ?_⟩
  intro u₁ γ
  have hG := hΓ (u₁, fun _ => 0) γ (fun _ => 0)
  rw [h1 (nil2Mul Bc _ _)] at hG
  simp only [nil2Mul, Int.cast_zero, add_zero, zero_add] at hG
  have hβ : (∑ k, (ξ k : ℝ) * ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ j : ℝ))
      = ∑ i, ∑ j, ((∑ k, ξ k * Bc i j k : ℤ) : ℝ) * u₁ i * (γ j : ℝ) := by
    push_cast
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [hβ] at hG
  rw [← hG, ← mul_assoc, ← Complex.exp_add]
  have h0 : 2 * (Real.pi : ℂ) * Complex.I *
        ((-(∑ i, ∑ j, ((∑ k, ξ k * Bc i j k : ℤ) : ℝ) * u₁ i * (γ j : ℝ)) : ℝ) : ℂ)
      + 2 * (Real.pi : ℂ) * Complex.I *
        (((∑ i, ∑ j, ((∑ k, ξ k * Bc i j k : ℤ) : ℝ) * u₁ i * (γ j : ℝ)) : ℝ) : ℂ) = 0 := by
    rw [Complex.ofReal_neg]; ring
  rw [h0, Complex.exp_zero, one_mul]

theorem kv_quasiperiodic_local_lipschitz (a : ℕ) (Bm : Fin a → Fin a → ℝ)
    (f : (Fin a → ℝ) → ℂ) (Q B R : ℝ) (hQ : 0 ≤ Q) (hB : 0 ≤ B) (hR : 0 ≤ R)
    (hBm : ∀ i j, |Bm i j| ≤ B) (hf : ∀ u, ‖f u‖ ≤ Q)
    (hqp : ∀ (u : Fin a → ℝ) (γ : Fin a → ℤ), f (fun i => u i + (γ i : ℝ)) =
      Complex.exp (2 * Real.pi * Complex.I *
        ((-(∑ i, ∑ j, Bm i j * u i * (γ j : ℝ)) : ℝ) : ℂ)) * f u)
    (hlip : ∀ u v : Fin a → ℝ, (∀ i, -1 ≤ u i ∧ u i ≤ 2) → (∀ i, -1 ≤ v i ∧ v i ≤ 2) →
      ‖f u - f v‖ ≤ Q * ∑ i, |u i - v i|) :
    ∀ u v : Fin a → ℝ, (∀ i, |u i| ≤ R) →
      ‖f u - f v‖ ≤ Q * (2 + 2 * Real.pi * B * a * (R + 1)) * ∑ i, |u i - v i| :=
by
  intro u v hu
  obtain ⟨S, hS_def⟩ : ∃ S : ℝ, S = ∑ i, |u i - v i| := ⟨_, rfl⟩
  rw [← hS_def]
  have hS0 : 0 ≤ S := by rw [hS_def]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have h2pi : 0 ≤ 2 * Real.pi := by positivity
  have hBaR : 0 ≤ B * (a : ℝ) * (R + 1) :=
    mul_nonneg (mul_nonneg hB (Nat.cast_nonneg a)) (by linarith)
  have hP : 0 ≤ 2 * Real.pi * B * (a : ℝ) * (R + 1) :=
    mul_nonneg (mul_nonneg (mul_nonneg h2pi hB) (Nat.cast_nonneg _)) (by linarith)
  
  have hnorm1 : ∀ x : ℝ, ‖Complex.exp (2 * Real.pi * Complex.I * ((x : ℝ) : ℂ))‖ = 1 := by
    intro x
    have hx : 2 * Real.pi * Complex.I * ((x : ℝ) : ℂ) = ((2 * Real.pi * x : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [hx, Complex.norm_exp_ofReal_mul_I]
  have hlipE : ∀ x y : ℝ, ‖Complex.exp (2 * Real.pi * Complex.I * ((x : ℝ) : ℂ))
      - Complex.exp (2 * Real.pi * Complex.I * ((y : ℝ) : ℂ))‖ ≤ 2 * Real.pi * |x - y| := by
    intro x y
    have hsplit : Complex.exp (2 * Real.pi * Complex.I * ((x : ℝ) : ℂ))
        = Complex.exp (2 * Real.pi * Complex.I * ((y : ℝ) : ℂ))
          * Complex.exp (Complex.I * ((2 * Real.pi * (x - y) : ℝ) : ℂ)) := by
      rw [← Complex.exp_add]; congr 1; push_cast; ring
    rw [hsplit, show ∀ p q : ℂ, p * q - p = p * (q - 1) from fun p q => by ring, norm_mul,
      hnorm1, one_mul]
    refine Real.norm_exp_I_mul_ofReal_sub_one_le.trans (le_of_eq ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity : (0:ℝ) < 2 * Real.pi)]
  rcases le_or_gt 1 S with hS1 | hS1
  · 
    have h1 : ‖f u - f v‖ ≤ Q + Q := (norm_sub_le _ _).trans (add_le_add (hf u) (hf v))
    have h2 : Q * 2 ≤ Q * (2 + 2 * Real.pi * B * a * (R + 1)) :=
      mul_le_mul_of_nonneg_left (by linarith) hQ
    have h3 : Q * (2 + 2 * Real.pi * B * a * (R + 1)) * 1
        ≤ Q * (2 + 2 * Real.pi * B * a * (R + 1)) * S :=
      mul_le_mul_of_nonneg_left hS1 (mul_nonneg hQ (by linarith))
    linarith
  · 
    have hcoord : ∀ i, |u i - v i| < 1 := fun i =>
      lt_of_le_of_lt (by
        rw [hS_def]
        exact Finset.single_le_sum (f := fun i => |u i - v i|) (fun j _ => abs_nonneg _)
          (Finset.mem_univ i)) hS1
    obtain ⟨γ, hγ⟩ : ∃ γ : Fin a → ℤ, γ = fun j => ⌊u j⌋ := ⟨_, rfl⟩
    have hγi : ∀ j, γ j = ⌊u j⌋ := fun j => by rw [hγ]
    obtain ⟨u₀, hu₀⟩ : ∃ w : Fin a → ℝ, w = fun i => u i - (γ i : ℝ) := ⟨_, rfl⟩
    obtain ⟨v₀, hv₀⟩ : ∃ w : Fin a → ℝ, w = fun i => v i - (γ i : ℝ) := ⟨_, rfl⟩
    have hu₀i : ∀ i, u₀ i = u i - (γ i : ℝ) := fun i => by rw [hu₀]
    have hv₀i : ∀ i, v₀ i = v i - (γ i : ℝ) := fun i => by rw [hv₀]
    have hu₀c : ∀ i, -1 ≤ u₀ i ∧ u₀ i ≤ 2 := by
      intro i
      have h1 := Int.floor_le (u i)
      have h2 := Int.lt_floor_add_one (u i)
      rw [hu₀i, hγi]
      constructor <;> linarith
    have hv₀c : ∀ i, -1 ≤ v₀ i ∧ v₀ i ≤ 2 := by
      intro i
      have h1 := Int.floor_le (u i)
      have h2 := Int.lt_floor_add_one (u i)
      have h3 := abs_lt.mp (hcoord i)
      rw [hv₀i, hγi]
      constructor <;> linarith [h3.1, h3.2]
    have hγb : ∀ j, |(γ j : ℝ)| ≤ R + 1 := by
      intro j
      have h1 := Int.floor_le (u j)
      have h2 := Int.lt_floor_add_one (u j)
      have h3 := abs_le.mp (hu j)
      rw [hγi, abs_le]
      constructor <;> linarith [h3.1, h3.2]
    have hre_u : (fun i => u₀ i + (γ i : ℝ)) = u := by
      funext i; rw [hu₀i]; ring
    have hre_v : (fun i => v₀ i + (γ i : ℝ)) = v := by
      funext i; rw [hv₀i]; ring
    have hfu := hqp u₀ γ
    rw [hre_u] at hfu
    have hfv := hqp v₀ γ
    rw [hre_v] at hfv
    obtain ⟨Xu, hXu⟩ : ∃ X : ℝ, X = ∑ i, ∑ j, Bm i j * u₀ i * (γ j : ℝ) := ⟨_, rfl⟩
    obtain ⟨Xv, hXv⟩ : ∃ X : ℝ, X = ∑ i, ∑ j, Bm i j * v₀ i * (γ j : ℝ) := ⟨_, rfl⟩
    rw [← hXu] at hfu
    rw [← hXv] at hfv
    obtain ⟨Eu, hEu⟩ : ∃ E : ℂ, E = Complex.exp (2 * Real.pi * Complex.I * (((-Xu) : ℝ) : ℂ)) :=
      ⟨_, rfl⟩
    obtain ⟨Ev, hEv⟩ : ∃ E : ℂ, E = Complex.exp (2 * Real.pi * Complex.I * (((-Xv) : ℝ) : ℂ)) :=
      ⟨_, rfl⟩
    rw [← hEu] at hfu
    rw [← hEv] at hfv
    have hsub : f u - f v = Eu * (f u₀ - f v₀) + (Eu - Ev) * f v₀ := by
      rw [hfu, hfv]; ring
    have hEu1 : ‖Eu‖ = 1 := by rw [hEu]; exact hnorm1 _
    have hEdiff : ‖Eu - Ev‖ ≤ 2 * Real.pi * |Xu - Xv| := by
      rw [hEu, hEv]
      refine (hlipE _ _).trans (le_of_eq ?_)
      rw [neg_sub_neg, abs_sub_comm]
    have hdiff : Xu - Xv = ∑ i, ∑ j, Bm i j * (u i - v i) * (γ j : ℝ) := by
      rw [hXu, hXv, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hu₀i, hv₀i]
      ring
    have hXb : |Xu - Xv| ≤ B * a * (R + 1) * S := by
      rw [hdiff]
      calc |∑ i, ∑ j, Bm i j * (u i - v i) * (γ j : ℝ)|
          ≤ ∑ i, |∑ j, Bm i j * (u i - v i) * (γ j : ℝ)| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i, ∑ j, |Bm i j * (u i - v i) * (γ j : ℝ)| :=
            Finset.sum_le_sum (fun i _ => Finset.abs_sum_le_sum_abs _ _)
        _ ≤ ∑ i, ∑ _j : Fin a, B * |u i - v i| * (R + 1) := by
            apply Finset.sum_le_sum; intro i _; apply Finset.sum_le_sum; intro j _
            rw [abs_mul, abs_mul]
            exact mul_le_mul (mul_le_mul_of_nonneg_right (hBm i j) (abs_nonneg _)) (hγb j)
              (abs_nonneg _) (mul_nonneg hB (abs_nonneg _))
        _ = B * a * (R + 1) * S := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            rw [hS_def, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            ring
    have hL : ‖f u₀ - f v₀‖ ≤ Q * S := by
      refine (hlip u₀ v₀ hu₀c hv₀c).trans (le_of_eq ?_)
      rw [hS_def]
      congr 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hu₀i, hv₀i, sub_sub_sub_cancel_right]
    have hfv0 := hf v₀
    have hPB : 2 * Real.pi * |Xu - Xv| ≤ 2 * Real.pi * (B * a * (R + 1) * S) :=
      mul_le_mul_of_nonneg_left hXb h2pi
    have hnn : 0 ≤ 2 * Real.pi * (B * a * (R + 1) * S) :=
      mul_nonneg h2pi (mul_nonneg hBaR hS0)
    rw [hsub]
    calc ‖Eu * (f u₀ - f v₀) + (Eu - Ev) * f v₀‖
        ≤ ‖Eu * (f u₀ - f v₀)‖ + ‖(Eu - Ev) * f v₀‖ := norm_add_le _ _
      _ = ‖f u₀ - f v₀‖ + ‖Eu - Ev‖ * ‖f v₀‖ := by rw [norm_mul, norm_mul, hEu1, one_mul]
      _ ≤ Q * S + (2 * Real.pi * (B * a * (R + 1) * S)) * Q :=
          add_le_add hL (mul_le_mul (hEdiff.trans hPB) hfv0 (norm_nonneg _) hnn)
      _ ≤ Q * (2 + 2 * Real.pi * B * a * (R + 1)) * S := by
          have h := mul_nonneg hQ hS0
          have he : Q * (2 + 2 * Real.pi * B * a * (R + 1)) * S
              = Q * S + (2 * Real.pi * (B * a * (R + 1) * S)) * Q + Q * S := by ring
          linarith

theorem kv_isotropic_periodization (a d : ℕ) (Bm : Fin a → Fin a → ℤ)
    (f : (Fin a → ℝ) → ℂ) (μ : Fin d → Fin a → ℤ)
    (H : (Fin a → ℝ) → (Fin d → ℝ) → ℂ)
    (hqp : ∀ (u : Fin a → ℝ) (γ : Fin a → ℤ), f (fun i => u i + (γ i : ℝ)) =
      Complex.exp (2 * Real.pi * Complex.I *
        ((-(∑ i, ∑ i', (Bm i i' : ℝ) * u i * (γ i' : ℝ)) : ℝ) : ℂ)) * f u)
    (hsym : ∀ j j', ∑ i, ∑ i', Bm i i' * μ j i * μ j' i' = ∑ i, ∑ i', Bm i i' * μ j' i * μ j i')
    (hH : ∀ (x : Fin a → ℝ) (t : Fin d → ℝ), H x t =
      Complex.exp (2 * Real.pi * Complex.I *
        (((∑ i, ∑ i', (Bm i i' : ℝ) * x i * (∑ j, t j * (μ j i' : ℝ)))
          + (∑ i, ∑ i', (Bm i i' : ℝ) * (∑ j, t j * (μ j i : ℝ)) * (∑ j, t j * (μ j i' : ℝ))) / 2
          - (∑ j, t j * (∑ i, ∑ i', (Bm i i' : ℝ) * (μ j i : ℝ) * (μ j i' : ℝ))) / 2 : ℝ) : ℂ))
        * f (fun i => x i + ∑ j, t j * (μ j i : ℝ))) :
    (∀ (x : Fin a → ℝ) (t : Fin d → ℝ) (m : Fin d → ℤ),
        H x (fun j => t j + (m j : ℝ)) = H x t) ∧
    (∀ (y : Fin a → ℝ) (Γ : Fin a → ℤ) (t : Fin d → ℝ),
        f (fun i => y i + (∑ j, t j * (μ j i : ℝ)) + (Γ i : ℝ)) =
          Complex.exp (2 * Real.pi * Complex.I *
            ((-((∑ i, ∑ i', (Bm i i' : ℝ) * (y i + ∑ j, t j * (μ j i : ℝ)) * (Γ i' : ℝ))
              + (∑ i, ∑ i', (Bm i i' : ℝ) * y i * (∑ j, t j * (μ j i' : ℝ)))
              + (∑ i, ∑ i', (Bm i i' : ℝ) * (∑ j, t j * (μ j i : ℝ)) * (∑ j, t j * (μ j i' : ℝ))) / 2
              - (∑ j, t j * (∑ i, ∑ i', (Bm i i' : ℝ) * (μ j i : ℝ) * (μ j i' : ℝ))) / 2) : ℝ) : ℂ))
          * H y t) ∧
    (∀ Q : ℝ, (∀ u, ‖f u‖ ≤ Q) → ∀ x t, ‖H x t‖ ≤ Q) :=
by
  
  have alg : ∀ (x v m : Fin a → ℝ) (TC : ℝ),
      (∑ i, ∑ i', (Bm i i' : ℝ) * m i * v i' = ∑ i, ∑ i', (Bm i i' : ℝ) * v i * m i') →
      (∑ i, ∑ i', (Bm i i' : ℝ) * x i * (v i' + m i'))
        + (∑ i, ∑ i', (Bm i i' : ℝ) * (v i + m i) * (v i' + m i')) / 2
        - (TC + ∑ i, ∑ i', (Bm i i' : ℝ) * m i * m i') / 2
        + -(∑ i, ∑ i', (Bm i i' : ℝ) * (x i + v i) * m i')
      = (∑ i, ∑ i', (Bm i i' : ℝ) * x i * v i')
        + (∑ i, ∑ i', (Bm i i' : ℝ) * v i * v i') / 2 - TC / 2 := by
    intro x v m TC key
    simp only [mul_add, add_mul, Finset.sum_add_distrib]
    linear_combination (1 / 2 : ℝ) * key
  
  have swapL : ∀ (t : Fin d → ℝ) (g : Fin a → ℝ) (h : Fin d → Fin a → ℝ),
      ∑ i, ∑ i', (Bm i i' : ℝ) * g i * (∑ k, t k * h k i')
        = ∑ k, t k * ∑ i, ∑ i', (Bm i i' : ℝ) * g i * h k i' := by
    intro t g h
    simp only [Finset.mul_sum]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    conv_rhs => rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun i' _ => Finset.sum_congr rfl fun k _ => by ring
  have swapR : ∀ (t : Fin d → ℝ) (g : Fin a → ℝ) (h : Fin d → Fin a → ℝ),
      ∑ i, ∑ i', (Bm i i' : ℝ) * (∑ k, t k * h k i) * g i'
        = ∑ k, t k * ∑ i, ∑ i', (Bm i i' : ℝ) * h k i * g i' := by
    intro t g h
    simp only [Finset.mul_sum, Finset.sum_mul]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    conv_rhs => rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun i' _ => Finset.sum_congr rfl fun k _ => by ring
  
  have hunit : ∀ (j : Fin d) (x : Fin a → ℝ) (t : Fin d → ℝ),
      H x (fun k => t k + (if k = j then (1 : ℝ) else 0)) = H x t := by
    intro j x t
    have F1 : ∀ i, ∑ k, (t k + (if k = j then (1 : ℝ) else 0)) * (μ k i : ℝ)
        = (∑ k, t k * (μ k i : ℝ)) + (μ j i : ℝ) := by
      intro i
      simp only [add_mul, ite_mul, one_mul, zero_mul, Finset.sum_add_distrib,
        Finset.sum_ite_eq', Finset.mem_univ, if_true]
    have F2 : ∑ k, (t k + (if k = j then (1 : ℝ) else 0))
          * (∑ i, ∑ i', (Bm i i' : ℝ) * (μ k i : ℝ) * (μ k i' : ℝ))
        = (∑ k, t k * (∑ i, ∑ i', (Bm i i' : ℝ) * (μ k i : ℝ) * (μ k i' : ℝ)))
          + ∑ i, ∑ i', (Bm i i' : ℝ) * (μ j i : ℝ) * (μ j i' : ℝ) := by
      simp only [add_mul, ite_mul, one_mul, zero_mul, Finset.sum_add_distrib,
        Finset.sum_ite_eq', Finset.mem_univ, if_true]
    have key : ∑ i, ∑ i', (Bm i i' : ℝ) * (μ j i : ℝ) * (∑ k, t k * (μ k i' : ℝ))
        = ∑ i, ∑ i', (Bm i i' : ℝ) * (∑ k, t k * (μ k i : ℝ)) * (μ j i' : ℝ) := by
      rw [swapL t (fun i => (μ j i : ℝ)) (fun k i => (μ k i : ℝ)),
        swapR t (fun i => (μ j i : ℝ)) (fun k i => (μ k i : ℝ))]
      refine Finset.sum_congr rfl fun k _ => ?_
      have hs := congrArg (Int.cast : ℤ → ℝ) (hsym j k)
      push_cast at hs
      rw [hs]
    have harg : (fun i => x i + ∑ k, (t k + (if k = j then (1 : ℝ) else 0)) * (μ k i : ℝ))
        = fun i => (x i + ∑ k, t k * (μ k i : ℝ)) + ((μ j i : ℤ) : ℝ) := by
      funext i
      rw [F1 i]
      ring
    rw [hH x (fun k => t k + (if k = j then (1 : ℝ) else 0)), hH x t]
    rw [harg, hqp (fun i => x i + ∑ k, t k * (μ k i : ℝ)) (μ j), ← mul_assoc,
      ← Complex.exp_add, ← mul_add, ← Complex.ofReal_add]
    congr 4
    simp only [F1, F2]
    exact alg x (fun i => ∑ k, t k * (μ k i : ℝ)) (fun i => (μ j i : ℝ)) _ key
  
  have hcoord : ∀ (x : Fin a → ℝ) (j : Fin d) (n : ℤ) (t : Fin d → ℝ),
      H x (fun k => t k + (if k = j then ((n : ℤ) : ℝ) else 0)) = H x t := by
    intro x j n
    refine Int.induction_on n ?_ ?_ ?_
    · intro t
      simp
    · intro i ih t
      have e : (fun k => t k + (if k = j then (((i : ℤ) + 1 : ℤ) : ℝ) else 0))
          = fun k => (fun k => t k + (if k = j then ((i : ℤ) : ℝ) else 0)) k
              + (if k = j then (1 : ℝ) else 0) := by
        funext k
        by_cases hk : k = j <;> simp [hk] <;> ring
      rw [e, hunit j x (fun k => t k + (if k = j then ((i : ℤ) : ℝ) else 0)), ih t]
    · intro i ih t
      have e : (fun k => (fun k => t k + (if k = j then ((-(i : ℤ) - 1 : ℤ) : ℝ) else 0)) k
              + (if k = j then (1 : ℝ) else 0))
          = fun k => t k + (if k = j then ((-(i : ℤ) : ℤ) : ℝ) else 0) := by
        funext k
        by_cases hk : k = j <;> simp [hk] <;> ring
      rw [← hunit j x (fun k => t k + (if k = j then ((-(i : ℤ) - 1 : ℤ) : ℝ) else 0)), e,
        ih t]
  refine ⟨?_, ?_, ?_⟩
  · intro x t m
    have hS : ∀ (S : Finset (Fin d)) (t : Fin d → ℝ),
        H x (fun k => t k + (if k ∈ S then (m k : ℝ) else 0)) = H x t := by
      intro S
      induction S using Finset.induction_on with
      | empty => intro t; simp
      | insert j S hj ih =>
        intro t
        have e : (fun k => t k + (if k ∈ insert j S then (m k : ℝ) else 0))
            = fun k => (fun k => t k + (if k ∈ S then (m k : ℝ) else 0)) k
                + (if k = j then ((m j : ℤ) : ℝ) else 0) := by
          funext k
          by_cases hk : k = j
          · subst hk
            simp [hj]
          · simp [hk]
        rw [e, hcoord x j (m j) (fun k => t k + (if k ∈ S then (m k : ℝ) else 0)), ih t]
    have := hS Finset.univ t
    simpa using this
  · intro y Γ t
    rw [hqp (fun i => y i + ∑ j, t j * (μ j i : ℝ)) Γ, hH y t, ← mul_assoc, ← Complex.exp_add]
    congr 2
    push_cast
    ring
  · intro Q hQ x t
    have hn : ∀ r : ℝ, ‖Complex.exp (2 * Real.pi * Complex.I * (r : ℂ))‖ = 1 := by
      intro r
      rw [show (2 * (Real.pi : ℂ) * Complex.I * (r : ℂ)) = ((2 * Real.pi * r : ℝ) : ℂ) * Complex.I
        by push_cast; ring]
      exact Complex.norm_exp_ofReal_mul_I _
    rw [hH x t, norm_mul, hn, one_mul]
    exact hQ _

theorem kv_periodization_lipschitz (a d : ℕ) (Bm : Fin a → Fin a → ℝ)
    (f : (Fin a → ℝ) → ℂ) (μ : Fin d → Fin a → ℝ)
    (H : (Fin a → ℝ) → (Fin d → ℝ) → ℂ) (Q B Mμ Rx Lf : ℝ)
    (hQ : 0 ≤ Q) (hB : 0 ≤ B) (hMμ : 0 ≤ Mμ) (hRx : 0 ≤ Rx) (hLf : 0 ≤ Lf)
    (hBm : ∀ i i', |Bm i i'| ≤ B) (hμ : ∀ j i, |μ j i| ≤ Mμ) (hf : ∀ u, ‖f u‖ ≤ Q)
    (hflip : ∀ u v : Fin a → ℝ, (∀ i, |u i| ≤ Rx + 2 * (d : ℝ) * Mμ) →
      ‖f u - f v‖ ≤ Lf * ∑ i, |u i - v i|)
    (hH : ∀ x t, H x t = Complex.exp (2 * Real.pi * Complex.I *
        (((∑ i, ∑ i', Bm i i' * x i * (∑ j, t j * μ j i'))
          + (∑ i, ∑ i', Bm i i' * (∑ j, t j * μ j i) * (∑ j, t j * μ j i')) / 2
          - (∑ j, t j * (∑ i, ∑ i', Bm i i' * μ j i * μ j i')) / 2 : ℝ) : ℂ))
        * f (fun i => x i + ∑ j, t j * μ j i))
    (hper : ∀ x t (m : Fin d → ℤ), H x (fun j => t j + (m j : ℝ)) = H x t) :
    ∀ (x x' : Fin a → ℝ) (t t' : Fin d → ℝ), (∀ i, |x i| ≤ Rx) → (∀ i, |x' i| ≤ Rx) →
      ‖H x t - H x' t'‖ ≤ (8 + (a : ℝ) + d + Rx + Mμ + B + Q + Lf) ^ 9 *
        (∑ i, |x i - x' i| + ∑ j, |t j - t' j|) :=
by
  intro x x' t t' hx hx'
  
  have hn : ∀ φ : ℝ, ‖Complex.exp (2 * Real.pi * Complex.I * (φ : ℂ))‖ = 1 := by
    intro φ
    have e : 2 * Real.pi * Complex.I * (φ : ℂ) = Complex.I * ((2 * Real.pi * φ : ℝ) : ℂ) := by
      push_cast; ring
    rw [e]; exact Complex.norm_exp_I_mul_ofReal _
  
  have s1 : ∀ (θ θ' : ℝ) (g g' : ℂ), ‖g'‖ ≤ Q →
      ‖Complex.exp (2 * Real.pi * Complex.I * (θ : ℂ)) * g
        - Complex.exp (2 * Real.pi * Complex.I * (θ' : ℂ)) * g'‖
        ≤ 2 * Real.pi * Q * |θ - θ'| + ‖g - g'‖ := by
    intro θ θ' g g' hg'
    have hsplit : Complex.exp (2 * Real.pi * Complex.I * (θ : ℂ))
        = Complex.exp (2 * Real.pi * Complex.I * (θ' : ℂ))
          * Complex.exp (Complex.I * ((2 * Real.pi * (θ - θ') : ℝ) : ℂ)) := by
      rw [← Complex.exp_add]; congr 1; push_cast; ring
    have key : Complex.exp (2 * Real.pi * Complex.I * (θ : ℂ)) * g
        - Complex.exp (2 * Real.pi * Complex.I * (θ' : ℂ)) * g'
        = Complex.exp (2 * Real.pi * Complex.I * (θ : ℂ)) * (g - g')
          + Complex.exp (2 * Real.pi * Complex.I * (θ' : ℂ))
            * ((Complex.exp (Complex.I * ((2 * Real.pi * (θ - θ') : ℝ) : ℂ)) - 1) * g') := by
      rw [hsplit]; ring
    rw [key]
    have h1 := Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2 * Real.pi * (θ - θ'))
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity : (0:ℝ) < 2 * Real.pi)] at h1
    calc _ ≤ ‖Complex.exp (2 * Real.pi * Complex.I * (θ : ℂ)) * (g - g')‖
          + ‖Complex.exp (2 * Real.pi * Complex.I * (θ' : ℂ))
            * ((Complex.exp (Complex.I * ((2 * Real.pi * (θ - θ') : ℝ) : ℂ)) - 1) * g')‖ :=
          norm_add_le _ _
      _ = ‖g - g'‖ + ‖Complex.exp (Complex.I * ((2 * Real.pi * (θ - θ') : ℝ) : ℂ)) - 1‖
            * ‖g'‖ := by
          rw [norm_mul, norm_mul, norm_mul, hn, hn, one_mul, one_mul]
      _ ≤ ‖g - g'‖ + (2 * Real.pi * |θ - θ'|) * Q := by gcongr
      _ = 2 * Real.pi * Q * |θ - θ'| + ‖g - g'‖ := by ring
  have hHb : ∀ y τ, ‖H y τ‖ ≤ Q := by
    intro y τ; rw [hH, norm_mul, hn, one_mul]; exact hf _
  
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = 8 + (a : ℝ) + d + Rx + Mμ + B + Q + Lf := ⟨_, rfl⟩
  rw [← hS]
  obtain ⟨δx, hδx⟩ : ∃ δx : ℝ, δx = ∑ i, |x i - x' i| := ⟨_, rfl⟩
  obtain ⟨δt, hδt⟩ : ∃ δt : ℝ, δt = ∑ j, |t j - t' j| := ⟨_, rfl⟩
  rw [← hδx, ← hδt]
  have hδx0 : 0 ≤ δx := by rw [hδx]; exact Finset.sum_nonneg fun i _ => abs_nonneg _
  have hδt0 : 0 ≤ δt := by rw [hδt]; exact Finset.sum_nonneg fun j _ => abs_nonneg _
  
  have ha0 : (0:ℝ) ≤ a := Nat.cast_nonneg a
  have hd0 : (0:ℝ) ≤ d := Nat.cast_nonneg d
  have hS8 : 8 ≤ S := by rw [hS]; linarith
  have haS : (a:ℝ) ≤ S := by rw [hS]; linarith
  have hdS : (d:ℝ) ≤ S := by rw [hS]; linarith
  have hRxS : Rx ≤ S := by rw [hS]; linarith
  have hMμS : Mμ ≤ S := by rw [hS]; linarith
  have hBS : B ≤ S := by rw [hS]; linarith
  have hQS : Q ≤ S := by rw [hS]; linarith
  have hLfS : Lf ≤ S := by rw [hS]; linarith
  have hS0 : 0 ≤ S := by linarith
  have hS1 : 1 ≤ S := by linarith
  have hπ4 : Real.pi ≤ 4 := Real.pi_le_four
  have hS97 : 64 * S ^ 7 ≤ S ^ 9 := by
    have h : S ^ 9 = S ^ 2 * S ^ 7 := by ring
    have h2 : 64 ≤ S ^ 2 := by nlinarith
    rw [h]; exact mul_le_mul_of_nonneg_right h2 (by positivity)
  have hS17 : S ≤ S ^ 7 := by
    calc S = S ^ 1 := (pow_one S).symm
      _ ≤ S ^ 7 := pow_le_pow_right₀ hS1 (by norm_num)
  have hS37 : S ^ 3 ≤ S ^ 7 := pow_le_pow_right₀ hS1 (by norm_num)
  have hS57 : S ^ 5 ≤ S ^ 7 := pow_le_pow_right₀ hS1 (by norm_num)
  have hS67 : S ^ 6 ≤ S ^ 7 := pow_le_pow_right₀ hS1 (by norm_num)
  have h2Q : 2 * Q ≤ S ^ 9 := by linarith
  have hcx : 2 * Real.pi * Q * (2 * a * d * B * Mμ) + Lf ≤ S ^ 9 := by
    have h : 2 * Real.pi * Q * (2 * a * d * B * Mμ) ≤ 2 * 4 * S * (2 * S * S * S * S) := by
      gcongr
    have h' : 2 * 4 * S * (2 * S * S * S * S) = 16 * S ^ 5 := by ring
    linarith
  have hct : 2 * Real.pi * Q * (a ^ 2 * B * Rx * Mμ + 2 * a ^ 2 * d * B * Mμ ^ 2
      + a ^ 2 * B * Mμ ^ 2 / 2) + Lf * a * Mμ ≤ S ^ 9 := by
    have h : 2 * Real.pi * Q * (a ^ 2 * B * Rx * Mμ + 2 * a ^ 2 * d * B * Mμ ^ 2
        + a ^ 2 * B * Mμ ^ 2 / 2)
        ≤ 2 * 4 * S * (S ^ 2 * S * S * S + 2 * S ^ 2 * S * S * S ^ 2 + S ^ 2 * S * S ^ 2 / 2) := by
      gcongr
    have h2 : Lf * a * Mμ ≤ S * S * S := by gcongr
    have h' : 2 * 4 * S * (S ^ 2 * S * S * S + 2 * S ^ 2 * S * S * S ^ 2 + S ^ 2 * S * S ^ 2 / 2)
        = 8 * S ^ 6 + 16 * S ^ 7 + 4 * S ^ 6 := by ring
    have h2' : S * S * S = S ^ 3 := by ring
    linarith
  rcases le_or_gt 1 δt with hbig | hsmall
  · 
    calc ‖H x t - H x' t'‖ ≤ ‖H x t‖ + ‖H x' t'‖ := norm_sub_le _ _
      _ ≤ Q + Q := add_le_add (hHb _ _) (hHb _ _)
      _ ≤ S ^ 9 * (δx + δt) := by
          have h9 : 0 ≤ S ^ 9 := by positivity
          have := mul_le_mul_of_nonneg_left (show 1 ≤ δx + δt by linarith) h9
          linarith
  · 
    have htj : ∀ j, |t j - t' j| ≤ δt := by
      intro j; rw [hδt]
      exact Finset.single_le_sum (f := fun j => |t j - t' j|) (fun j _ => abs_nonneg _)
        (Finset.mem_univ j)
    obtain ⟨s, hs_def⟩ : ∃ s : Fin d → ℝ, ∀ j, s j = t j - (⌊t j⌋ : ℝ) := ⟨_, fun j => rfl⟩
    obtain ⟨s', hs'_def⟩ : ∃ s' : Fin d → ℝ, ∀ j, s' j = t' j - (⌊t j⌋ : ℝ) :=
      ⟨_, fun j => rfl⟩
    have hdiff : ∀ j, s j - s' j = t j - t' j := by intro j; rw [hs_def, hs'_def]; ring
    have hs : ∀ j, |s j| ≤ 2 := by
      intro j
      have h1 := Int.floor_le (t j); have h2 := Int.lt_floor_add_one (t j)
      rw [hs_def, abs_le]; constructor <;> linarith
    have hs' : ∀ j, |s' j| ≤ 2 := by
      intro j
      have h1 := Int.floor_le (t j); have h2 := Int.lt_floor_add_one (t j)
      have h3 := abs_le.mp (htj j)
      rw [hs'_def, abs_le]; constructor <;> linarith [h3.1, h3.2]
    have e1 : H x t = H x s := by
      rw [← hper x s (fun j => ⌊t j⌋)]; congr 1; funext j; simp only [hs_def]; ring
    have e2 : H x' t' = H x' s' := by
      rw [← hper x' s' (fun j => ⌊t j⌋)]; congr 1; funext j; simp only [hs'_def]; ring
    
    have dbl : ∀ (F G : Fin a → Fin a → ℝ), (∀ i i', |F i i'| ≤ G i i') →
        |∑ i, ∑ i', F i i'| ≤ ∑ i, ∑ i', G i i' := by
      intro F G h
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
      exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i' _ => h i i')
    have sumlem : ∀ (c e : ℝ) (w : Fin a → ℝ),
        ∑ i, ∑ _i' : Fin a, (c * w i + e) = a * c * (∑ i, w i) + a * a * e := by
      intro c e w
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      rw [← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.mul_sum]
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring
    have sumlem0 : ∀ e : ℝ, ∑ _i : Fin a, ∑ _i' : Fin a, e = a * a * e := by
      intro e
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring
    have hvb : ∀ (w : Fin d → ℝ), (∀ j, |w j| ≤ 2) → ∀ k, |∑ j, w j * μ j k| ≤ 2 * d * Mμ := by
      intro w hw k
      calc |∑ j, w j * μ j k| ≤ ∑ j, |w j * μ j k| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _j : Fin d, 2 * Mμ := Finset.sum_le_sum fun j _ => by
            rw [abs_mul]; exact mul_le_mul (hw j) (hμ j k) (abs_nonneg _) (by norm_num)
        _ = 2 * d * Mμ := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            ring
    have hvd : ∀ k, |(∑ j, s j * μ j k) - ∑ j, s' j * μ j k| ≤ Mμ * δt := by
      intro k
      rw [hδt, ← Finset.sum_sub_distrib, Finset.mul_sum]
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => ?_)
      rw [← sub_mul, abs_mul, hdiff j, mul_comm Mμ]
      exact mul_le_mul_of_nonneg_left (hμ j k) (abs_nonneg _)
    
    have hT1 : |(∑ i, ∑ i', Bm i i' * x i * (∑ j, s j * μ j i'))
        - (∑ i, ∑ i', Bm i i' * x' i * (∑ j, s' j * μ j i'))|
        ≤ 2 * a * d * B * Mμ * δx + a ^ 2 * B * Rx * Mμ * δt := by
      simp only [← Finset.sum_sub_distrib]
      refine (dbl _ (fun i _ => B * (2 * d * Mμ) * |x i - x' i| + B * Rx * (Mμ * δt))
        ?_).trans (le_of_eq ((sumlem _ _ (fun i => |x i - x' i|)).trans ?_))
      · intro i i'
        have e : Bm i i' * x i * (∑ j, s j * μ j i') - Bm i i' * x' i * (∑ j, s' j * μ j i')
            = Bm i i' * (x i - x' i) * (∑ j, s j * μ j i')
              + Bm i i' * x' i * ((∑ j, s j * μ j i') - ∑ j, s' j * μ j i') := by ring
        rw [e]
        refine (abs_add_le _ _).trans ?_
        simp only [abs_mul]
        have h1 := hBm i i'; have h2 := hvb s hs i'; have h3 := hx' i; have h4 := hvd i'
        have p1 : |Bm i i'| * |x i - x' i| * |∑ j, s j * μ j i'|
            ≤ B * (2 * d * Mμ) * |x i - x' i| := by
          calc _ = |Bm i i'| * |∑ j, s j * μ j i'| * |x i - x' i| := by ring
            _ ≤ B * (2 * d * Mμ) * |x i - x' i| := by gcongr
        have p2 : |Bm i i'| * |x' i| * |∑ j, s j * μ j i' - ∑ j, s' j * μ j i'|
            ≤ B * Rx * (Mμ * δt) := by gcongr
        linarith
      · rw [← hδx]; ring
    
    have hT2 : |(∑ i, ∑ i', Bm i i' * (∑ j, s j * μ j i) * (∑ j, s j * μ j i'))
        - (∑ i, ∑ i', Bm i i' * (∑ j, s' j * μ j i) * (∑ j, s' j * μ j i'))|
        ≤ 4 * a ^ 2 * d * B * Mμ ^ 2 * δt := by
      simp only [← Finset.sum_sub_distrib]
      refine (dbl _ (fun _ _ => B * (Mμ * δt) * (2 * d * Mμ) + B * (2 * d * Mμ) * (Mμ * δt))
        ?_).trans (le_of_eq ((sumlem0 _).trans ?_))
      · intro i i'
        have e : Bm i i' * (∑ j, s j * μ j i) * (∑ j, s j * μ j i')
              - Bm i i' * (∑ j, s' j * μ j i) * (∑ j, s' j * μ j i')
            = Bm i i' * ((∑ j, s j * μ j i) - ∑ j, s' j * μ j i) * (∑ j, s j * μ j i')
              + Bm i i' * (∑ j, s' j * μ j i)
                * ((∑ j, s j * μ j i') - ∑ j, s' j * μ j i') := by ring
        rw [e]
        refine (abs_add_le _ _).trans ?_
        simp only [abs_mul]
        have h1 := hBm i i'; have h2 := hvb s hs i'; have h3 := hvb s' hs' i
        have h4 := hvd i; have h5 := hvd i'
        have p1 : |Bm i i'| * |∑ j, s j * μ j i - ∑ j, s' j * μ j i| * |∑ j, s j * μ j i'|
            ≤ B * (Mμ * δt) * (2 * d * Mμ) := by gcongr
        have p2 : |Bm i i'| * |∑ j, s' j * μ j i| * |∑ j, s j * μ j i' - ∑ j, s' j * μ j i'|
            ≤ B * (2 * d * Mμ) * (Mμ * δt) := by gcongr
        linarith
      · ring
    
    have hc : ∀ j, |∑ i, ∑ i', Bm i i' * μ j i * μ j i'| ≤ (a:ℝ) * a * (B * Mμ * Mμ) := by
      intro j
      refine (dbl _ (fun _ _ => B * Mμ * Mμ) ?_).trans (le_of_eq (sumlem0 _))
      intro i i'
      simp only [abs_mul]
      have h1 := hBm i i'; have h2 := hμ j i; have h3 := hμ j i'
      gcongr
    have hT3 : |(∑ j, s j * (∑ i, ∑ i', Bm i i' * μ j i * μ j i'))
        - (∑ j, s' j * (∑ i, ∑ i', Bm i i' * μ j i * μ j i'))|
        ≤ (a:ℝ) ^ 2 * B * Mμ ^ 2 * δt := by
      rw [← Finset.sum_sub_distrib]
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc _ ≤ ∑ j, |t j - t' j| * ((a:ℝ) * a * (B * Mμ * Mμ)) := by
            refine Finset.sum_le_sum fun j _ => ?_
            rw [← sub_mul, abs_mul, hdiff j]
            exact mul_le_mul_of_nonneg_left (hc j) (abs_nonneg _)
        _ = (a:ℝ) ^ 2 * B * Mμ ^ 2 * δt := by rw [← Finset.sum_mul, ← hδt]; ring
    
    have hu : ∀ i, |x i + ∑ j, s j * μ j i| ≤ Rx + 2 * (d : ℝ) * Mμ := by
      intro i
      have h1 := hvb s hs i; have h2 := hx i
      calc |x i + ∑ j, s j * μ j i| ≤ |x i| + |∑ j, s j * μ j i| := abs_add_le _ _
        _ ≤ _ := by linarith
    have hsum : ∑ i, |(x i + ∑ j, s j * μ j i) - (x' i + ∑ j, s' j * μ j i)|
        ≤ δx + a * (Mμ * δt) := by
      calc _ ≤ ∑ i, (|x i - x' i| + Mμ * δt) := Finset.sum_le_sum fun i _ => by
            have e : (x i + ∑ j, s j * μ j i) - (x' i + ∑ j, s' j * μ j i)
                = (x i - x' i) + ((∑ j, s j * μ j i) - ∑ j, s' j * μ j i) := by ring
            rw [e]; exact (abs_add_le _ _).trans (add_le_add le_rfl (hvd i))
        _ = δx + a * (Mμ * δt) := by
            rw [Finset.sum_add_distrib, hδx]
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have hfl : ‖f (fun i => x i + ∑ j, s j * μ j i) - f (fun i => x' i + ∑ j, s' j * μ j i)‖
        ≤ Lf * (δx + a * (Mμ * δt)) :=
      (hflip _ _ hu).trans (mul_le_mul_of_nonneg_left hsum hLf)
    
    obtain ⟨a1, b1⟩ := abs_le.mp hT1
    obtain ⟨a2, b2⟩ := abs_le.mp hT2
    obtain ⟨a3, b3⟩ := abs_le.mp hT3
    have hP : 0 ≤ 2 * Real.pi * Q := by positivity
    rw [e1, e2, hH x s, hH x' s']
    refine (s1 _ _ _ _ (hf _)).trans ?_
    refine le_trans (add_le_add (mul_le_mul_of_nonneg_left
      ((abs_le (b := 2 * a * d * B * Mμ * δx + (a ^ 2 * B * Rx * Mμ + 2 * a ^ 2 * d * B * Mμ ^ 2
        + a ^ 2 * B * Mμ ^ 2 / 2) * δt)).mpr ⟨?_, ?_⟩) hP) hfl) ?_
    · linarith
    · linarith
    · have k1 := mul_le_mul_of_nonneg_right hcx hδx0
      have k2 := mul_le_mul_of_nonneg_right hct hδt0
      linarith

theorem kv_class_phase_identity (ν a b Δ : ℕ) (hΔ : 1 ≤ Δ) (Bm : Fin a → Fin a → ℤ)
    (μ : Fin a → Fin a → ℤ) (f : (Fin a → ℝ) → ℂ) (H : (Fin a → ℝ) → (Fin a → ℝ) → ℂ)
    (hunf : ∀ (y : Fin a → ℝ) (Γ : Fin a → ℤ) (t : Fin a → ℝ),
      f (fun i => y i + (∑ j, t j * (μ j i : ℝ)) + (Γ i : ℝ)) =
        Complex.exp (2 * Real.pi * Complex.I *
          ((-((∑ i, ∑ i', (Bm i i' : ℝ) * (y i + ∑ j, t j * (μ j i : ℝ)) * (Γ i' : ℝ))
            + (∑ i, ∑ i', (Bm i i' : ℝ) * y i * (∑ j, t j * (μ j i' : ℝ)))
            + (∑ i, ∑ i', (Bm i i' : ℝ) * (∑ j, t j * (μ j i : ℝ)) * (∑ j, t j * (μ j i' : ℝ))) / 2
            - (∑ j, t j * (∑ i, ∑ i', (Bm i i' : ℝ) * (μ j i : ℝ) * (μ j i' : ℝ))) / 2) : ℝ) : ℂ))
        * H y t)
    (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ) (n : Fin ν → Fin a → ℤ) (σ : Fin ν → Fin a → ℝ)
    (hsplit : ∀ l i, ∑ j, ((p₁ l j - (n l j : ℝ) / Δ - σ l j) / Δ) * (μ j i : ℝ)
        = p₁ l i - (n l i : ℝ) / Δ - σ l i)
    (ξ r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ)
    (z₀ : Fin ν → ℤ) :
    ∃ (s₀ : ℝ) (s₁ : Fin ν → ℝ) (s₂ : Fin ν → Fin ν → ℝ) (c' : Fin a → ℝ),
      (∀ i, |c' i| ≤ 1) ∧
      ∀ z : Fin ν → ℤ, (∀ l, (Δ : ℤ) ∣ z l - z₀ l) →
        Complex.exp (2 * Real.pi * Complex.I * ((∑ k, ξ k * (r₀ k + ∑ l, (z l : ℝ) * r₁ l k
            + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * r₂ l l' k) : ℝ) : ℂ))
          * f (fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i)
        = Complex.exp (2 * Real.pi * Complex.I * ((s₀ + ∑ l, s₁ l * (z l : ℝ)
            + ∑ l, ∑ l', s₂ l l' * (z l : ℝ) * (z l' : ℝ) : ℝ) : ℂ))
          * H (fun i => c' i + ∑ l, (z l : ℝ) * σ l i)
              (fun j => ∑ l, (z l : ℝ) * ((p₁ l j - (n l j : ℝ) / Δ - σ l j) / Δ)) :=
by
  
  obtain ⟨A, hA⟩ : ∃ A : ((Fin ν → ℝ) → ℝ) → Prop, ∀ g, A g ↔
      ∃ (a₀ : ℝ) (a₁ : Fin ν → ℝ), ∀ x, g x = a₀ + ∑ l, a₁ l * x l := ⟨_, fun _ => Iff.rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ((Fin ν → ℝ) → ℝ) → Prop, ∀ g, Q g ↔
      ∃ (s₀ : ℝ) (s₁ : Fin ν → ℝ) (s₂ : Fin ν → Fin ν → ℝ), ∀ x,
        g x = s₀ + ∑ l, s₁ l * x l + ∑ l, ∑ l', s₂ l l' * x l * x l' := ⟨_, fun _ => Iff.rfl⟩
  have A_const : ∀ c : ℝ, A (fun _ => c) := fun c => (hA _).2 ⟨c, 0, fun x => by simp⟩
  have A_coord : ∀ l₀ : Fin ν, A (fun x => x l₀) := fun l₀ =>
    (hA _).2 ⟨0, fun l => if l = l₀ then 1 else 0, fun x => by simp [ite_mul]⟩
  have A_add : ∀ g h, A g → A h → A (fun x => g x + h x) := by
    intro g h hg hh
    obtain ⟨a₀, a₁, ha⟩ := (hA g).1 hg
    obtain ⟨b₀, b₁, hb⟩ := (hA h).1 hh
    refine (hA _).2 ⟨a₀ + b₀, fun l => a₁ l + b₁ l, fun x => ?_⟩
    rw [ha x, hb x]
    simp only [add_mul, Finset.sum_add_distrib]
    ring
  have A_sub : ∀ g h, A g → A h → A (fun x => g x - h x) := by
    intro g h hg hh
    obtain ⟨a₀, a₁, ha⟩ := (hA g).1 hg
    obtain ⟨b₀, b₁, hb⟩ := (hA h).1 hh
    refine (hA _).2 ⟨a₀ - b₀, fun l => a₁ l - b₁ l, fun x => ?_⟩
    rw [ha x, hb x]
    simp only [sub_mul, Finset.sum_sub_distrib]
    ring
  have A_smul : ∀ (c : ℝ) g, A g → A (fun x => c * g x) := by
    intro c g hg
    obtain ⟨a₀, a₁, ha⟩ := (hA g).1 hg
    refine (hA _).2 ⟨c * a₀, fun l => c * a₁ l, fun x => ?_⟩
    rw [ha x, mul_add, Finset.mul_sum]
    congr 1
    exact Finset.sum_congr rfl (fun l _ => by ring)
  have A_mulc : ∀ g (c : ℝ), A g → A (fun x => g x * c) := by
    intro g c hg
    obtain ⟨a₀, a₁, ha⟩ := (hA g).1 hg
    refine (hA _).2 ⟨a₀ * c, fun l => a₁ l * c, fun x => ?_⟩
    rw [ha x, add_mul, Finset.sum_mul]
    congr 1
    exact Finset.sum_congr rfl (fun l _ => by ring)
  have A_divc : ∀ g (c : ℝ), A g → A (fun x => g x / c) := by
    intro g c hg
    obtain ⟨a₀, a₁, ha⟩ := (hA g).1 hg
    refine (hA _).2 ⟨a₀ / c, fun l => a₁ l / c, fun x => ?_⟩
    rw [ha x, add_div, Finset.sum_div]
    congr 1
    exact Finset.sum_congr rfl (fun l _ => by ring)
  have A_sum : ∀ (m : ℕ) (g : Fin m → (Fin ν → ℝ) → ℝ), (∀ i, A (g i)) →
      A (fun x => ∑ i, g i x) := by
    intro m g hg
    choose a₀ a₁ ha using fun i => (hA (g i)).1 (hg i)
    refine (hA _).2 ⟨∑ i, a₀ i, fun l => ∑ i, a₁ i l, fun x => ?_⟩
    rw [Finset.sum_congr rfl (fun i _ => ha i x), Finset.sum_add_distrib]
    congr 1
    simp only [Finset.sum_mul]
    exact Finset.sum_comm
  have A_lin : ∀ w : Fin ν → ℝ, A (fun x => ∑ l, x l * w l) := by
    intro w
    apply A_sum
    intro l
    exact A_mulc _ _ (A_coord l)
  have Q_congr : ∀ g h, Q g → (∀ x, h x = g x) → Q h := by
    intro g h hg e
    obtain ⟨s₀, s₁, s₂, hs⟩ := (hQ g).1 hg
    exact (hQ h).2 ⟨s₀, s₁, s₂, fun x => (e x).trans (hs x)⟩
  have Q_const : ∀ c : ℝ, Q (fun _ => c) := fun c => (hQ _).2 ⟨c, 0, 0, fun x => by simp⟩
  have Q_of_A : ∀ g, A g → Q g := by
    intro g hg
    obtain ⟨a₀, a₁, ha⟩ := (hA g).1 hg
    exact (hQ g).2 ⟨a₀, a₁, 0, fun x => by rw [ha x]; simp⟩
  have Q_add : ∀ g h, Q g → Q h → Q (fun x => g x + h x) := by
    intro g h hg hh
    obtain ⟨s₀, s₁, s₂, hs⟩ := (hQ g).1 hg
    obtain ⟨t₀, t₁, t₂, ht⟩ := (hQ h).1 hh
    refine (hQ _).2 ⟨s₀ + t₀, fun l => s₁ l + t₁ l, fun l l' => s₂ l l' + t₂ l l', fun x => ?_⟩
    rw [hs x, ht x]
    simp only [add_mul, Finset.sum_add_distrib]
    ring
  have Q_smul : ∀ (c : ℝ) g, Q g → Q (fun x => c * g x) := by
    intro c g hg
    obtain ⟨s₀, s₁, s₂, hs⟩ := (hQ g).1 hg
    refine (hQ _).2 ⟨c * s₀, fun l => c * s₁ l, fun l l' => c * s₂ l l', fun x => ?_⟩
    rw [hs x]
    have e1 : ∑ l, c * s₁ l * x l = c * ∑ l, s₁ l * x l := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun l _ => by ring)
    have e2 : ∑ l, ∑ l', c * s₂ l l' * x l * x l' = c * ∑ l, ∑ l', s₂ l l' * x l * x l' := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun l' _ => by ring)
    rw [e1, e2]
    ring
  have Q_sum : ∀ (m : ℕ) (g : Fin m → (Fin ν → ℝ) → ℝ), (∀ i, Q (g i)) →
      Q (fun x => ∑ i, g i x) := by
    intro m g hg
    choose s₀ s₁ s₂ hs using fun i => (hQ (g i)).1 (hg i)
    refine (hQ _).2 ⟨∑ i, s₀ i, fun l => ∑ i, s₁ i l, fun l l' => ∑ i, s₂ i l l', fun x => ?_⟩
    rw [Finset.sum_congr rfl (fun i _ => hs i x), Finset.sum_add_distrib, Finset.sum_add_distrib]
    have e1 : ∑ i, ∑ l, s₁ i l * x l = ∑ l, (∑ i, s₁ i l) * x l := by
      simp only [Finset.sum_mul]
      exact Finset.sum_comm
    have e2 : ∑ i, ∑ l, ∑ l', s₂ i l l' * x l * x l'
        = ∑ l, ∑ l', (∑ i, s₂ i l l') * x l * x l' := by
      simp only [Finset.sum_mul]
      refine Eq.trans Finset.sum_comm ?_
      exact Finset.sum_congr rfl (fun l _ => Finset.sum_comm)
    rw [e1, e2]
  have Q_mul : ∀ g h, A g → A h → Q (fun x => g x * h x) := by
    intro g h hg hh
    obtain ⟨a₀, a₁, ha⟩ := (hA g).1 hg
    obtain ⟨b₀, b₁, hb⟩ := (hA h).1 hh
    refine (hQ _).2 ⟨a₀ * b₀, fun l => a₀ * b₁ l + b₀ * a₁ l, fun l l' => a₁ l * b₁ l',
      fun x => ?_⟩
    rw [ha x, hb x]
    have e1 : ∑ l, (a₀ * b₁ l + b₀ * a₁ l) * x l
        = a₀ * ∑ l, b₁ l * x l + b₀ * ∑ l, a₁ l * x l := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun l _ => by ring)
    have e2 : ∑ l, ∑ l', a₁ l * b₁ l' * x l * x l'
        = (∑ l, a₁ l * x l) * (∑ l, b₁ l * x l) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun l' _ => by ring)
    rw [e1, e2]
    ring
  have Q_neg : ∀ g, Q g → Q (fun x => -g x) := fun g hg =>
    Q_congr _ _ (Q_smul (-1) g hg) (fun x => by ring)
  have Q_sub : ∀ g h, Q g → Q h → Q (fun x => g x - h x) := fun g h hg hh =>
    Q_congr _ _ (Q_add _ _ hg (Q_smul (-1) h hh)) (fun x => by ring)
  have Q_divc : ∀ g (c : ℝ), Q g → Q (fun x => g x / c) := fun g c hg =>
    Q_congr _ _ (Q_smul (1 / c) g hg) (fun x => by ring)
  have Q_mulc : ∀ g (c : ℝ), Q g → Q (fun x => g x * c) := fun g c hg =>
    Q_congr _ _ (Q_smul c g hg) (fun x => by ring)
  have hexp : ∀ (u v w : ℝ) (Hc : ℂ), u + v = w →
      Complex.exp (2 * Real.pi * Complex.I * (u : ℂ))
        * (Complex.exp (2 * Real.pi * Complex.I * (v : ℂ)) * Hc)
      = Complex.exp (2 * Real.pi * Complex.I * (w : ℂ)) * Hc := by
    intro u v w Hc huvw
    rw [← huvw, ← mul_assoc, ← Complex.exp_add, Complex.ofReal_add, mul_add]
  
  obtain ⟨τ, hτ⟩ : ∃ τ : Fin ν → Fin a → ℝ,
      ∀ l j, (p₁ l j - (n l j : ℝ) / Δ - σ l j) / Δ = τ l j := ⟨_, fun _ _ => rfl⟩
  simp only [hτ] at hsplit ⊢
  have hΔR : (Δ : ℝ) ≠ 0 := by
    have : (1 : ℝ) ≤ Δ := by exact_mod_cast hΔ
    linarith
  
  obtain ⟨c', Γ₀, hc', hcf⟩ : ∃ (c' : Fin a → ℝ) (Γ₀ : Fin a → ℤ), (∀ i, |c' i| ≤ 1) ∧
      ∀ i, c' i + (Γ₀ i : ℝ) = p₀ i + ∑ l, (z₀ l : ℝ) * (n l i : ℝ) / Δ := by
    refine ⟨fun i => Int.fract (p₀ i + ∑ l, (z₀ l : ℝ) * (n l i : ℝ) / Δ),
      fun i => ⌊p₀ i + ∑ l, (z₀ l : ℝ) * (n l i : ℝ) / Δ⌋, fun i => ?_,
      fun i => Int.fract_add_floor _⟩
    rw [abs_le]
    constructor
    · linarith [Int.fract_nonneg (p₀ i + ∑ l, (z₀ l : ℝ) * (n l i : ℝ) / Δ)]
    · linarith [Int.fract_lt_one (p₀ i + ∑ l, (z₀ l : ℝ) * (n l i : ℝ) / Δ)]
  
  have hAy : ∀ i, A (fun x => c' i + ∑ l, x l * σ l i) := by
    intro i
    exact A_add _ _ (A_const _) (A_lin (fun l => σ l i))
  have hAt : ∀ j, A (fun x => ∑ l, x l * τ l j) := fun j => A_lin (fun l => τ l j)
  have hAtμ : ∀ i, A (fun x => ∑ j, (∑ l, x l * τ l j) * (μ j i : ℝ)) := by
    intro i
    apply A_sum
    intro j
    exact A_mulc _ _ (hAt j)
  have hAΓ : ∀ i', A (fun x => (Γ₀ i' : ℝ) + ∑ l, (x l - (z₀ l : ℝ)) / Δ * (n l i' : ℝ)) := by
    intro i'
    apply A_add
    · exact A_const _
    · apply A_sum
      intro l
      exact A_mulc _ _ (A_divc _ _ (A_sub _ _ (A_coord l) (A_const _)))
  have hΞ : Q (fun x => ∑ k, ξ k * (r₀ k + ∑ l, x l * r₁ l k
      + ∑ l, ∑ l', x l * x l' * r₂ l l' k)) := by
    apply Q_sum
    intro k
    apply Q_smul
    apply Q_add
    apply Q_add
    · exact Q_const _
    · exact Q_of_A _ (A_lin _)
    · apply Q_sum
      intro l
      apply Q_sum
      intro l'
      apply Q_mulc
      exact Q_mul _ _ (A_coord l) (A_coord l')
  have hΦ : Q (fun x =>
      -((∑ i, ∑ i', (Bm i i' : ℝ) * ((c' i + ∑ l, x l * σ l i)
            + ∑ j, (∑ l, x l * τ l j) * (μ j i : ℝ))
          * ((Γ₀ i' : ℝ) + ∑ l, (x l - (z₀ l : ℝ)) / Δ * (n l i' : ℝ)))
        + (∑ i, ∑ i', (Bm i i' : ℝ) * (c' i + ∑ l, x l * σ l i)
          * (∑ j, (∑ l, x l * τ l j) * (μ j i' : ℝ)))
        + (∑ i, ∑ i', (Bm i i' : ℝ) * (∑ j, (∑ l, x l * τ l j) * (μ j i : ℝ))
          * (∑ j, (∑ l, x l * τ l j) * (μ j i' : ℝ))) / 2
        - (∑ j, (∑ l, x l * τ l j) * (∑ i, ∑ i', (Bm i i' : ℝ) * (μ j i : ℝ) * (μ j i' : ℝ))) / 2))
      := by
    apply Q_neg
    apply Q_sub
    apply Q_add
    apply Q_add
    · apply Q_sum
      intro i
      apply Q_sum
      intro i'
      apply Q_mul
      · exact A_smul _ _ (A_add _ _ (hAy i) (hAtμ i))
      · exact hAΓ i'
    · apply Q_sum
      intro i
      apply Q_sum
      intro i'
      apply Q_mul
      · exact A_smul _ _ (hAy i)
      · exact hAtμ i'
    · apply Q_divc
      apply Q_sum
      intro i
      apply Q_sum
      intro i'
      apply Q_mul
      · exact A_smul _ _ (hAtμ i)
      · exact hAtμ i'
    · apply Q_divc
      apply Q_of_A
      apply A_sum
      intro j
      exact A_mulc _ _ (hAt j)
  obtain ⟨s₀, s₁, s₂, hs⟩ := (hQ _).1 (Q_add _ _ hΞ hΦ)
  refine ⟨s₀, s₁, s₂, c', hc', ?_⟩
  intro z hz
  have hz' : ∀ l, ∃ m : ℤ, z l - z₀ l = (Δ : ℤ) * m := fun l => hz l
  choose m hm using hz'
  have hmR : ∀ l, (m l : ℝ) = ((z l : ℝ) - (z₀ l : ℝ)) / Δ := by
    intro l
    rw [eq_div_iff hΔR]
    have h := congrArg (fun q : ℤ => (q : ℝ)) (hm l)
    push_cast at h
    rw [h]
    ring
  obtain ⟨Γ, hΓdef⟩ : ∃ Γ : Fin a → ℤ, ∀ i, Γ i = Γ₀ i + ∑ l, m l * n l i :=
    ⟨_, fun _ => rfl⟩
  have hΓ : ∀ i, (Γ i : ℝ) = (Γ₀ i : ℝ) + ∑ l, ((z l : ℝ) - (z₀ l : ℝ)) / Δ * (n l i : ℝ) := by
    intro i
    rw [hΓdef i]
    push_cast
    congr 1
    exact Finset.sum_congr rfl (fun l _ => by rw [hmR l])
  have hswap : ∀ i, ∑ j, (∑ l, (z l : ℝ) * τ l j) * (μ j i : ℝ)
      = ∑ l, (z l : ℝ) * (p₁ l i - (n l i : ℝ) / Δ - σ l i) := by
    intro i
    simp only [Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [← hsplit l i, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  have harg : (fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i)
      = (fun i => (c' i + ∑ l, (z l : ℝ) * σ l i)
          + ∑ j, (∑ l, (z l : ℝ) * τ l j) * (μ j i : ℝ) + (Γ i : ℝ)) := by
    funext i
    rw [hswap i, hΓ i]
    have hv := hcf i
    have hsum : ∑ l, (z l : ℝ) * p₁ l i
        = ∑ l, (z₀ l : ℝ) * (n l i : ℝ) / Δ + ∑ l, (z l : ℝ) * σ l i
          + ∑ l, (z l : ℝ) * (p₁ l i - (n l i : ℝ) / Δ - σ l i)
          + ∑ l, ((z l : ℝ) - (z₀ l : ℝ)) / Δ * (n l i : ℝ) := by
      rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun l _ => by ring)
    linarith
  have hu := hunf (fun i => c' i + ∑ l, (z l : ℝ) * σ l i) Γ (fun j => ∑ l, (z l : ℝ) * τ l j)
  beta_reduce at hu
  rw [harg, hu]
  have h2 := hs (fun l => (z l : ℝ))
  beta_reduce at h2
  refine hexp _ _ _ _ ?_
  simp only [hΓ]
  linarith [h2]

theorem kv_residue_torus_family (ν a d Δ N : ℕ) (hΔ : 1 ≤ Δ)
    (H : (Fin a → ℝ) → (Fin d → ℝ) → ℂ) (σ : Fin ν → Fin a → ℝ) (τ : Fin ν → Fin d → ℝ)
    (Q LH Rx W₀ Bd : ℝ) (hQ : 0 ≤ Q) (hLH : 0 ≤ LH) (hW₀ : 0 ≤ W₀) (hΔB : (Δ : ℝ) ≤ Bd)
    (hσ : ∀ l i, (4 * (N : ℝ) + 4) * |σ l i| ≤ W₀) (hRx : 1 + (ν : ℝ) * W₀ ≤ Rx)
    (hHb : ∀ x t, ‖H x t‖ ≤ Q)
    (hHper : ∀ x t (m : Fin d → ℤ), H x (fun j => t j + (m j : ℝ)) = H x t)
    (hHlip : ∀ (x x' : Fin a → ℝ) (t t' : Fin d → ℝ), (∀ i, |x i| ≤ Rx) → (∀ i, |x' i| ≤ Rx) →
      ‖H x t - H x' t'‖ ≤ LH * (∑ i, |x i - x' i| + ∑ j, |t j - t' j|))
    (φ : (Fin ν → ℤ) → ℂ)
    (s₀ : (Fin ν → Fin Δ) → ℝ) (s₁ : (Fin ν → Fin Δ) → Fin ν → ℝ)
    (s₂ : (Fin ν → Fin Δ) → Fin ν → Fin ν → ℝ) (c' : (Fin ν → Fin Δ) → Fin a → ℝ)
    (hc' : ∀ ρ i, |c' ρ i| ≤ 1)
    (hid : ∀ (ρ : Fin ν → Fin Δ) (z : Fin ν → ℤ), (∀ l, (Δ : ℤ) ∣ z l - ((ρ l : ℕ) : ℤ)) →
      φ z = Complex.exp (2 * Real.pi * Complex.I * ((s₀ ρ + ∑ l, s₁ ρ l * (z l : ℝ)
          + ∑ l, ∑ l', s₂ ρ l l' * (z l : ℝ) * (z l' : ℝ) : ℝ) : ℂ))
        * H (fun i => c' ρ i + ∑ l, (z l : ℝ) * σ l i) (fun j => ∑ l, (z l : ℝ) * τ l j)) :
    ∃ (G : (Fin ν → Fin Δ) → (Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ) → ℂ)
      (Ψ₀ : (Fin ν → Fin Δ) → Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ)
      (Ψ₁ : (Fin ν → Fin Δ) → Fin ν → Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ)
      (Ψ₂ : (Fin ν → Fin Δ) → Fin ν → Fin ν → Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ),
      (∀ ρ p, ‖G ρ p‖ ≤ Q) ∧
      (∀ ρ p (γ : Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℤ),
        G ρ (fun i => p i + (γ i : ℝ)) = G ρ p) ∧
      (∀ ρ p p', ‖G ρ p - G ρ p'‖ ≤
        (2 * Real.pi * Q + LH * (1 + (a : ℝ) * W₀) + Q * (2 * Bd)) * ∑ i, |p i - p' i|) ∧
      ∀ z ∈ intBox ν N, φ z = ∑ ρ, G ρ (fun i => Ψ₀ ρ i + ∑ l, (z l : ℝ) * Ψ₁ ρ l i
        + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * Ψ₂ ρ l l' i) :=
by
  classical
  have hΔpos : (0 : ℝ) < Δ := by exact_mod_cast hΔ
  have hΔposZ : (0 : ℤ) < Δ := by exact_mod_cast hΔ
  obtain ⟨L, hL⟩ : ∃ L : ℝ, L = 4 * (N : ℝ) + 4 := ⟨_, rfl⟩
  have hLpos : 0 < L := by rw [hL]; positivity
  
  have hdr_per : ∀ (x : ℝ) (n : ℤ),
      x + n - ((round (x + n) : ℤ) : ℝ) = x - ((round x : ℤ) : ℝ) := by
    intro x n
    rw [round_add_intCast]; push_cast; ring
  have hdr_le : ∀ x : ℝ, |x - ((round x : ℤ) : ℝ)| ≤ 1 / 2 := fun x => abs_sub_round x
  have hdr_lip : ∀ x y : ℝ,
      abs (|x - ((round x : ℤ) : ℝ)| - |y - ((round y : ℤ) : ℝ)|) ≤ |x - y| := by
    intro x y
    have h1 : |x - ((round x : ℤ) : ℝ)| ≤ |x - ((round y : ℤ) : ℝ)| := round_le x (round y)
    have h2 : |y - ((round y : ℤ) : ℝ)| ≤ |y - ((round x : ℤ) : ℝ)| := round_le y (round x)
    have h3 : |x - ((round y : ℤ) : ℝ)| ≤ |x - y| + |y - ((round y : ℤ) : ℝ)| := by
      have := abs_add_le (x - y) (y - ((round y : ℤ) : ℝ))
      rwa [sub_add_sub_cancel] at this
    have h4 : |y - ((round x : ℤ) : ℝ)| ≤ |x - y| + |x - ((round x : ℤ) : ℝ)| := by
      have := abs_add_le (y - x) (x - ((round x : ℤ) : ℝ))
      rwa [sub_add_sub_cancel, abs_sub_comm y x] at this
    rw [abs_sub_le_iff]; constructor <;> linarith
  
  obtain ⟨T, hT⟩ : ∃ T : ℝ → ℝ,
      ∀ u, T u = 1 / 4 - |(u - 1 / 4) - ((round (u - 1 / 4) : ℤ) : ℝ)| := ⟨_, fun _ => rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : ℝ → ℝ,
      ∀ y, P y = max 0 (1 - 2 * (Δ : ℝ) * |y - ((round y : ℤ) : ℝ)|) := ⟨_, fun _ => rfl⟩
  have hTper : ∀ (u : ℝ) (n : ℤ), T (u + n) = T u := by
    intro u n
    rw [hT, hT, show u + (n : ℝ) - 1 / 4 = (u - 1 / 4) + n by ring, hdr_per]
  have hTb : ∀ u, |T u| ≤ 1 := by
    intro u
    rw [hT, abs_le]
    have h1 := hdr_le (u - 1 / 4)
    have h2 := abs_nonneg ((u - 1 / 4) - ((round (u - 1 / 4) : ℤ) : ℝ))
    constructor <;> linarith
  have hTlip : ∀ u u', |T u - T u'| ≤ |u - u'| := by
    intro u u'
    have h := hdr_lip (u - 1 / 4) (u' - 1 / 4)
    rw [show u - 1 / 4 - (u' - 1 / 4) = u - u' by ring] at h
    rw [hT, hT]
    rw [abs_le] at h ⊢
    constructor <;> linarith [h.1, h.2]
  have hTid : ∀ u, |u| ≤ 1 / 4 → T u = u := by
    intro u hu
    rw [abs_le] at hu
    have hr : round (u - 1 / 4) = 0 := by
      rw [round_eq_zero_iff, Set.mem_Ico]; constructor <;> linarith
    rw [hT, hr, Int.cast_zero, sub_zero, abs_of_nonpos (by linarith)]
    ring
  have hPper : ∀ (y : ℝ) (n : ℤ), P (y + n) = P y := by
    intro y n; rw [hP, hP, hdr_per]
  have hPb : ∀ y, 0 ≤ P y ∧ P y ≤ 1 := by
    intro y
    rw [hP]
    refine ⟨le_max_left _ _, max_le zero_le_one ?_⟩
    have : 0 ≤ 2 * (Δ : ℝ) * |y - ((round y : ℤ) : ℝ)| := by positivity
    linarith
  have hPlip : ∀ y y', |P y - P y'| ≤ (2 * (Δ : ℝ)) * |y - y'| := by
    intro y y'
    rw [hP, hP, max_comm 0, max_comm 0]
    refine (abs_max_sub_max_le_abs _ _ _).trans ?_
    rw [show 1 - 2 * (Δ : ℝ) * |y - ((round y : ℤ) : ℝ)|
          - (1 - 2 * (Δ : ℝ) * |y' - ((round y' : ℤ) : ℝ)|)
        = 2 * (Δ : ℝ) * (|y' - ((round y' : ℤ) : ℝ)| - |y - ((round y : ℤ) : ℝ)|) by ring,
      abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * Δ)]
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    exact (abs_sub_comm _ _).le.trans (hdr_lip y y')
  have hP1 : ∀ n : ℤ, P n = 1 := by
    intro n; rw [hP, round_intCast]; simp
  have hP0 : ∀ k : ℤ, ¬ ((Δ : ℤ) ∣ k) → P ((k : ℝ) / Δ) = 0 := by
    intro k hk
    rw [hP]
    apply max_eq_left
    have hne : k - round ((k : ℝ) / Δ) * Δ ≠ 0 := by
      intro h; apply hk; exact ⟨round ((k : ℝ) / Δ), by linarith⟩
    have h1 : (1 : ℝ) ≤ |((k - round ((k : ℝ) / Δ) * Δ : ℤ) : ℝ)| := by
      have := Int.one_le_abs hne
      exact_mod_cast this
    have h2 : (k : ℝ) / Δ - ((round ((k : ℝ) / Δ) : ℤ) : ℝ)
        = ((k - round ((k : ℝ) / Δ) * Δ : ℤ) : ℝ) / Δ := by
      rw [eq_div_iff hΔpos.ne']
      push_cast
      field_simp
    rw [h2, abs_div, abs_of_pos hΔpos]
    have h3 : 2 * (Δ : ℝ) * (|((k - round ((k : ℝ) / Δ) * Δ : ℤ) : ℝ)| / Δ)
        = 2 * |((k - round ((k : ℝ) / Δ) * Δ : ℤ) : ℝ)| := by field_simp
    linarith
  
  have hres : ∀ z : Fin ν → ℤ, ∃ ρ₀ : Fin ν → Fin Δ, (∀ l, (Δ : ℤ) ∣ z l - ((ρ₀ l : ℕ) : ℤ)) ∧
      ∀ ρ : Fin ν → Fin Δ, (∀ l, (Δ : ℤ) ∣ z l - ((ρ l : ℕ) : ℤ)) → ρ = ρ₀ := by
    intro z
    have hlt : ∀ l, (z l % Δ).toNat < Δ := by
      intro l
      have h0 := Int.emod_nonneg (z l) hΔposZ.ne'
      have h1 := Int.emod_lt_of_pos (z l) hΔposZ
      omega
    refine ⟨fun l => ⟨(z l % Δ).toNat, hlt l⟩, ?_, ?_⟩
    · intro l
      show (Δ : ℤ) ∣ z l - (((z l % Δ).toNat : ℕ) : ℤ)
      rw [Int.toNat_of_nonneg (Int.emod_nonneg _ hΔposZ.ne')]
      exact ⟨z l / Δ, by rw [Int.emod_def]; ring⟩
    · intro ρ hρ
      funext l
      apply Fin.ext
      show (ρ l : ℕ) = (z l % Δ).toNat
      obtain ⟨k, hk⟩ := hρ l
      have hr0 : (0 : ℤ) ≤ ((ρ l : ℕ) : ℤ) := Int.natCast_nonneg _
      have hr1 : ((ρ l : ℕ) : ℤ) < Δ := by exact_mod_cast (ρ l).isLt
      have hz : z l = ((ρ l : ℕ) : ℤ) + Δ * k := by linarith
      have : z l % Δ = ((ρ l : ℕ) : ℤ) := by
        rw [hz, Int.add_mul_emod_self_left, Int.emod_eq_of_lt hr0 hr1]
      rw [this, Int.toNat_natCast]
  
  have hprod : ∀ (s : Finset (Fin ν)) (f g : Fin ν → ℝ), (∀ l, 0 ≤ f l ∧ f l ≤ 1) →
      (∀ l, 0 ≤ g l ∧ g l ≤ 1) →
      |∏ l ∈ s, f l - ∏ l ∈ s, g l| ≤ ∑ l ∈ s, |f l - g l| := by
    intro s f g hf hg
    refine Finset.induction_on s ?_ ?_
    · simp
    · intro b s hb ih
      rw [Finset.prod_insert hb, Finset.prod_insert hb, Finset.sum_insert hb]
      have hF0 : 0 ≤ ∏ l ∈ s, f l := Finset.prod_nonneg (fun l _ => (hf l).1)
      have hF1 : ∏ l ∈ s, f l ≤ 1 :=
        Finset.prod_le_one (fun l _ => (hf l).1) (fun l _ => (hf l).2)
      have e : f b * ∏ l ∈ s, f l - g b * ∏ l ∈ s, g l
          = (f b - g b) * ∏ l ∈ s, f l + g b * (∏ l ∈ s, f l - ∏ l ∈ s, g l) := by ring
      rw [e]
      refine (abs_add_le _ _).trans ?_
      rw [abs_mul, abs_mul, abs_of_nonneg hF0, abs_of_nonneg (hg b).1]
      have h1 : |f b - g b| * ∏ l ∈ s, f l ≤ |f b - g b| :=
        mul_le_of_le_one_right (abs_nonneg _) hF1
      have h2 : g b * |∏ l ∈ s, f l - ∏ l ∈ s, g l| ≤ |∏ l ∈ s, f l - ∏ l ∈ s, g l| :=
        mul_le_of_le_one_left (abs_nonneg _) (hg b).2
      linarith
  
  have hE1 : ∀ s : ℝ, ‖Complex.exp (2 * Real.pi * Complex.I * ((s : ℝ) : ℂ))‖ = 1 := by
    intro s
    rw [show 2 * Real.pi * Complex.I * ((s : ℝ) : ℂ) = ((2 * Real.pi * s : ℝ) : ℂ) * Complex.I by
      push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  have hEper : ∀ (s : ℝ) (n : ℤ), Complex.exp (2 * Real.pi * Complex.I * (((s + n : ℝ)) : ℂ))
      = Complex.exp (2 * Real.pi * Complex.I * ((s : ℝ) : ℂ)) := by
    intro s n
    rw [show 2 * Real.pi * Complex.I * (((s + n : ℝ)) : ℂ)
        = 2 * Real.pi * Complex.I * ((s : ℝ) : ℂ) + (n : ℂ) * (2 * Real.pi * Complex.I) by
          push_cast; ring,
      Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
  have hEd : ∀ s s' : ℝ, ‖Complex.exp (2 * Real.pi * Complex.I * ((s : ℝ) : ℂ))
      - Complex.exp (2 * Real.pi * Complex.I * ((s' : ℝ) : ℂ))‖ ≤ 2 * Real.pi * |s - s'| := by
    intro s s'
    have e : Complex.exp (2 * Real.pi * Complex.I * ((s : ℝ) : ℂ))
        - Complex.exp (2 * Real.pi * Complex.I * ((s' : ℝ) : ℂ))
        = Complex.exp (2 * Real.pi * Complex.I * ((s' : ℝ) : ℂ))
          * (Complex.exp (Complex.I * ((2 * Real.pi * (s - s') : ℝ) : ℂ)) - 1) := by
      rw [mul_sub, ← Complex.exp_add, mul_one]
      congr 2
      push_cast; ring
    rw [e, norm_mul, hE1, one_mul]
    refine Real.norm_exp_I_mul_ofReal_sub_one_le.trans ?_
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos Real.two_pi_pos]
  
  have key : ∀ (E E' Hh Hh' : ℂ) (r r' : ℝ), ‖E‖ = 1 → ‖E'‖ = 1 → ‖Hh‖ ≤ Q → ‖Hh'‖ ≤ Q →
      0 ≤ r → r ≤ 1 →
      ‖E * Hh * (r : ℂ) - E' * Hh' * (r' : ℂ)‖ ≤ ‖E - E'‖ * Q + ‖Hh - Hh'‖ + Q * |r - r'| := by
    intro E E' Hh Hh' r r' hE hE' hH hH' h0 h1
    have e : E * Hh * (r : ℂ) - E' * Hh' * (r' : ℂ) = (E - E') * Hh * (r : ℂ)
        + E' * (Hh - Hh') * (r : ℂ) + E' * Hh' * ((r - r' : ℝ) : ℂ) := by push_cast; ring
    rw [e]
    have t1 := norm_add_le ((E - E') * Hh * (r : ℂ) + E' * (Hh - Hh') * (r : ℂ))
      (E' * Hh' * ((r - r' : ℝ) : ℂ))
    have t2 := norm_add_le ((E - E') * Hh * (r : ℂ)) (E' * (Hh - Hh') * (r : ℂ))
    have n1 : ‖(E - E') * Hh * (r : ℂ)‖ ≤ ‖E - E'‖ * Q := by
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0]
      calc ‖E - E'‖ * ‖Hh‖ * r ≤ ‖E - E'‖ * Q * 1 :=
            mul_le_mul (mul_le_mul_of_nonneg_left hH (norm_nonneg _)) h1 h0
              (mul_nonneg (norm_nonneg _) hQ)
