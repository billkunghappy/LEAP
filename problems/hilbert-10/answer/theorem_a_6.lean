      linarith
    calc ‖f u‖ * ‖kaiMFConeWeight K γ u‖
        ≤ (e⁻¹ * Real.exp (-(e * Real.exp (kaiMFLogNorm K u
              / (Module.finrank ℚ K : ℝ)))))
            * (Mγ * Real.exp (β * kaiMFLogNorm K u)) :=
          mul_le_mul hfb hWnorm (norm_nonneg _)
            (mul_nonneg (inv_nonneg.mpr he.le) (Real.exp_pos _).le)
      _ = Mγ * e⁻¹ * (Real.exp (-(e * Real.exp (kaiMFLogNorm K u
              / (Module.finrank ℚ K : ℝ))))
            * Real.exp (β * kaiMFLogNorm K u)) := by ring
      _ ≤ Mγ * e⁻¹ * (Real.exp C₀ * Real.exp (-(kaiMFLogNorm K u))) :=
          mul_le_mul_of_nonneg_left hexple
            (mul_nonneg hMγ0.le (inv_nonneg.mpr he.le))
      _ = C * Real.exp (-(kaiMFLogNorm K u)) := by rw [hC]; ring
  · 
    intro f θ h1 h2
    have h := kai_slab_split_at_level (ι := NumberField.InfinitePlace K)
      (fun w => ((w.mult : ℕ) : ℝ)) (Classical.arbitrary (NumberField.InfinitePlace K))
      (ne_of_gt (hmpos _)) G hGm θ f (by simpa only [hLsum] using h1)
      (by simpa only [hLsum] using h2)
    simpa only [hLsum] using h

theorem kai_mf_cone_theta_inversion_fe {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (a : Ideal (NumberField.RingOfIntegers K)) (ha : a ≠ 0)
    (ρ : NumberField.mixedEmbedding.mixedSpace K)
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (bf : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (vv : NumberField.mixedEmbedding.mixedSpace K) (κ : ℂ)
    (r : NumberField.InfinitePlace K → ℝ) (hr : ∀ w, 0 < r w)
    (hlaw : ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
        kaiHZIdealTheta K a ρ η l y
          = κ * (((∏ w : NumberField.InfinitePlace K,
                y w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ) *
              kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => r w / y w))
    (F : Set (NumberField.InfinitePlace K → ℝ)) (hF : MeasurableSet F)
    (E : Set ℝ) (hE : MeasurableSet E) (s : ℂ)
    (hint : MeasureTheory.IntegrableOn
        (fun u : NumberField.InfinitePlace K → ℝ =>
          kaiHZIdealTheta K a ρ η l (fun w => Real.exp (u w)) *
            kaiMFConeWeight K (kaiMFConeZcan K t l η s) u)
        (F ∩ {u | kaiMFLogNorm K u ∈ E}) MeasureTheory.volume) :
    (∫ u in F ∩ {u | kaiMFLogNorm K u ∈ E},
        kaiHZIdealTheta K a ρ η l (fun w => Real.exp (u w)) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s) u)
      = κ * Complex.exp (-∑ w : NumberField.InfinitePlace K,
              kaiMFConeZdual K t l η (1 - s) w * ((Real.log (r w) : ℝ) : ℂ)) *
          ∫ u in {u : NumberField.InfinitePlace K → ℝ |
                (fun w => Real.log (r w) - u w) ∈ F} ∩
              {u | (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (r w))
                    - kaiMFLogNorm K u ∈ E},
            kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w)) *
              kaiMFConeWeight K (kaiMFConeZdual K t l η (1 - s)) u :=
by
  classical
  have hmp : MeasureTheory.MeasurePreserving
      (fun (v : NumberField.InfinitePlace K → ℝ) (w : NumberField.InfinitePlace K) =>
        Real.log (r w) - v w)
      (MeasureTheory.volume) (MeasureTheory.volume) := by
    have h1 := (MeasureTheory.measurePreserving_add_left
        (MeasureTheory.volume : MeasureTheory.Measure (NumberField.InfinitePlace K → ℝ))
        (fun w : NumberField.InfinitePlace K => Real.log (r w))).comp
      (MeasureTheory.Measure.measurePreserving_neg
        (MeasureTheory.volume : MeasureTheory.Measure (NumberField.InfinitePlace K → ℝ)))
    have h2 : ((fun x : NumberField.InfinitePlace K → ℝ =>
          (fun w : NumberField.InfinitePlace K => Real.log (r w)) + x) ∘
          (Neg.neg : (NumberField.InfinitePlace K → ℝ) →
            (NumberField.InfinitePlace K → ℝ)))
        = fun (v : NumberField.InfinitePlace K → ℝ) (w : NumberField.InfinitePlace K) =>
            Real.log (r w) - v w := by
      funext v w
      simp [Function.comp_apply, sub_eq_add_neg]
    rwa [h2] at h1
  have hme : MeasurableEmbedding
      (fun (v : NumberField.InfinitePlace K → ℝ) (w : NumberField.InfinitePlace K) =>
        Real.log (r w) - v w) :=
    (MeasurableEquiv.subLeft
      (fun w : NumberField.InfinitePlace K => Real.log (r w))).measurableEmbedding
  have hLN : ∀ v : NumberField.InfinitePlace K → ℝ,
      kaiMFLogNorm K (fun w => Real.log (r w) - v w)
        = (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (r w))
            - kaiMFLogNorm K v := by
    intro v
    simp only [kaiMFLogNorm, mul_sub]
    rw [Finset.sum_sub_distrib]
  have hset : (fun (v : NumberField.InfinitePlace K → ℝ) (w : NumberField.InfinitePlace K) =>
        Real.log (r w) - v w) ⁻¹'
        (F ∩ {u : NumberField.InfinitePlace K → ℝ | kaiMFLogNorm K u ∈ E})
      = {u : NumberField.InfinitePlace K → ℝ |
            (fun w => Real.log (r w) - u w) ∈ F} ∩
          {u : NumberField.InfinitePlace K → ℝ |
            (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (r w))
              - kaiMFLogNorm K u ∈ E} := by
    ext v
    simp only [Set.mem_preimage, Set.mem_inter_iff, Set.mem_setOf_eq, hLN]
  have step1 : (∫ v in ({u : NumberField.InfinitePlace K → ℝ |
            (fun w => Real.log (r w) - u w) ∈ F} ∩
          {u : NumberField.InfinitePlace K → ℝ |
            (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (r w))
              - kaiMFLogNorm K u ∈ E}),
        kaiHZIdealTheta K a ρ η l (fun w => Real.exp (Real.log (r w) - v w)) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s)
            (fun w => Real.log (r w) - v w))
      = ∫ u in F ∩ {u : NumberField.InfinitePlace K → ℝ | kaiMFLogNorm K u ∈ E},
          kaiHZIdealTheta K a ρ η l (fun w => Real.exp (u w)) *
            kaiMFConeWeight K (kaiMFConeZcan K t l η s) u := by
    rw [← hset]
    exact hmp.setIntegral_preimage_emb hme
      (fun u : NumberField.InfinitePlace K → ℝ =>
        kaiHZIdealTheta K a ρ η l (fun w => Real.exp (u w)) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s) u)
      (F ∩ {u : NumberField.InfinitePlace K → ℝ | kaiMFLogNorm K u ∈ E})
  have step2 : ∀ v : NumberField.InfinitePlace K → ℝ,
      kaiHZIdealTheta K a ρ η l (fun w => Real.exp (Real.log (r w) - v w)) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s)
            (fun w => Real.log (r w) - v w)
        = (κ * Complex.exp (-∑ w : NumberField.InfinitePlace K,
              kaiMFConeZdual K t l η (1 - s) w * ((Real.log (r w) : ℝ) : ℂ))) *
            (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (v w)) *
              kaiMFConeWeight K (kaiMFConeZdual K t l η (1 - s)) v) := by
    intro v
    have hy : ∀ w : NumberField.InfinitePlace K,
        0 < Real.exp (Real.log (r w) - v w) := fun w => Real.exp_pos _
    have hdiv : (fun w : NumberField.InfinitePlace K =>
        r w / Real.exp (Real.log (r w) - v w)) = fun w => Real.exp (v w) := by
      funext w
      have h1 : r w ≠ 0 := ne_of_gt (hr w)
      have h2 : Real.exp (v w) ≠ 0 := Real.exp_ne_zero _
      rw [Real.exp_sub, Real.exp_log (hr w)]
      field_simp
    have hlw := hlaw (fun w => Real.exp (Real.log (r w) - v w)) hy
    rw [hdiv] at hlw
    have hprod : (∏ w : NumberField.InfinitePlace K,
          Real.exp (Real.log (r w) - v w) ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)))
        = Real.exp (∑ w : NumberField.InfinitePlace K,
            (Real.log (r w) - v w) * (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) := by
      rw [Real.exp_sum]
      exact Finset.prod_congr rfl (fun w _ => (Real.exp_mul _ _).symm)
    have hterm : ∀ w : NumberField.InfinitePlace K,
        ((((Real.log (r w) - v w) *
              (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)) : ℝ)) : ℂ)
            + kaiMFConeZcan K t l η s w * ((Real.log (r w) - v w : ℝ) : ℂ)
          = -(kaiMFConeZdual K t l η (1 - s) w * ((Real.log (r w) : ℝ) : ℂ))
            + kaiMFConeZdual K t l η (1 - s) w * ((v w : ℝ) : ℂ) := by
      intro w
      simp only [kaiMFConeZcan, kaiMFConeZdual, kaiMFConeAlpha]
      push_cast
      ring
    have hE2 : Complex.exp (∑ w : NumberField.InfinitePlace K,
            ((((Real.log (r w) - v w) *
                (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)) : ℝ)) : ℂ))
          * Complex.exp (∑ w : NumberField.InfinitePlace K,
              kaiMFConeZcan K t l η s w * ((Real.log (r w) - v w : ℝ) : ℂ))
        = Complex.exp (-∑ w : NumberField.InfinitePlace K,
              kaiMFConeZdual K t l η (1 - s) w * ((Real.log (r w) : ℝ) : ℂ))
          * Complex.exp (∑ w : NumberField.InfinitePlace K,
              kaiMFConeZdual K t l η (1 - s) w * ((v w : ℝ) : ℂ)) := by
      rw [← Complex.exp_add, ← Complex.exp_add]
      congr 1
      rw [← Finset.sum_neg_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun w _ => hterm w)
    rw [hlw, hprod, Complex.ofReal_exp, Complex.ofReal_sum]
    simp only [kaiMFConeWeight]
    linear_combination (κ * kaiHZIdealThetaChar K bf vv η (fun p => -l p)
      (fun w => Real.exp (v w))) * hE2
  rw [← step1]
  simp only [step2]
  rw [MeasureTheory.integral_const_mul]

theorem kai_mf_cone_dual_mellin_integrable {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hGam : KaiMFConeGammaProp) (hConv : KaiHZZetaConvProp K)
