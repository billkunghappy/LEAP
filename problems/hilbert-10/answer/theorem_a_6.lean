      simp only [hH_def]
      rw [Finset.sum_congr rfl
        (fun j _ => hsumo (((((j : ℕ) : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1))))]
      rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
