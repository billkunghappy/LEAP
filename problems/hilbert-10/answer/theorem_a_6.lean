  have hMlt : M < (⌊M⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one M
  obtain ⟨X, hXdef⟩ : ∃ X : ℝ, X = 2 * (⌊M⌋₊ : ℝ) + 1 := ⟨_, rfl⟩
