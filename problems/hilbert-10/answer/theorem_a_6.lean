        simp
      rw [hre0, Real.exp_zero, mul_one]; exact hF1 w
    have hI := MeasureTheory.norm_setIntegral_le_of_norm_le_const
      (by rw [hvol]; exact ENNReal.one_lt_top) hbd
    rw [MeasureTheory.measureReal_def, hvol, ENNReal.toReal_one, mul_one] at hI
    exact hI
  
  obtain ⟨S, hS⟩ : ∃ S : Finset (Fin b → ℕ),
      S = Fintype.piFinset (fun _ : Fin b => Finset.range R) := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : Finset (Fin b → ℤ),
      T = Fintype.piFinset (fun _ : Fin b => Finset.Icc (1 - (R : ℤ)) ((R : ℤ) - 1)) :=
    ⟨_, rfl⟩
  obtain ⟨δ, hδ⟩ : ∃ δ : (Fin b → ℕ) × (Fin b → ℕ) → (Fin b → ℤ),
