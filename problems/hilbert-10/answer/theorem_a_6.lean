  have hκ8 : κ ^ 8 ≤ T₀ ^ 8 := pow_le_pow_left₀ hκ0 hκT 8
  have hT8 : (T₀ / L) ^ 8 ≤ T₀ ^ 8 / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4) := by
    rw [div_pow]
    exact div_le_div_of_nonneg_left (pow_nonneg hT₀0 8) hQq hQL8
  have hT₀8 : T₀ ^ 8 = ρ ^ 8 * C_M ^ (8 * Module.finrank ℚ K) *
