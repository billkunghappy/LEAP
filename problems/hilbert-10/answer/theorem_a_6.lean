    have hX' : ∀ i', X i' = ∑ i, (η i' (Sum.inl i) : ℝ) * q l i
        + ∑ l'', (η i' (Sum.inr l'') : ℝ) * S l'' l := by
      intro i'; rw [hX]; simp only [Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]
    have hz : ∑ i', (c j i' : ℝ) * ∑ l'', (η i' (Sum.inr l'') : ℝ) * S l'' l = 0 := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero fun l'' _ => ?_
      have h := congrArg (Int.cast : ℤ → ℝ) (hcker j l'')
      push_cast at h
      calc ∑ i', (c j i' : ℝ) * ((η i' (Sum.inr l'') : ℝ) * S l'' l)
          = (∑ i', (η i' (Sum.inr l'') : ℝ) * (c j i' : ℝ)) * S l'' l := by
            rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun _ _ => by ring
        _ = 0 := by rw [h, zero_mul]
    have hid : ∑ i, ((∑ i', c j i' * η i' (Sum.inl i) : ℤ) : ℝ) * q l i
        = ∑ i', (c j i' : ℝ) * X i' := by
      simp_rw [hX', mul_add, Finset.sum_add_distrib]
      rw [hz, add_zero]
      push_cast
      simp_rw [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
    rw [hid]
    push_cast
    rw [← Finset.sum_sub_distrib]
    calc |∑ i', ((c j i' : ℝ) * X i' - (c j i' : ℝ) * ((round (X i') : ℤ) : ℝ))|
        ≤ ∑ i', |(c j i' : ℝ) * X i' - (c j i' : ℝ) * ((round (X i') : ℤ) : ℝ)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i' : Fin t, C₀ * σ := Finset.sum_le_sum fun i' _ => by
          rw [← mul_sub, abs_mul]
          exact mul_le_mul (hc j i') (hXα i') (abs_nonneg _) ((abs_nonneg _).trans (hc j i'))
      _ = (t : ℝ) * C₀ * σ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
  
  have bracket_elim_bound_arith (a ν t : ℕ) (W Y : ℝ) (hW : 0 ≤ W) (hY : 1 ≤ Y)
      (ht : t ≤ a + ν) :
      (t : ℝ) * (2 * (t : ℝ) * Y) ^ (4 * t) * Y
          ≤ (1 + W) * (2 * ((a + ν : ℕ) : ℝ) * Y) ^ (6 * (a + ν)) ∧
      (t : ℝ) * (2 * (t : ℝ) * Y) ^ (4 * t)
          ≤ (1 + W) * (2 * ((a + ν : ℕ) : ℝ) * Y) ^ (6 * (a + ν)) ∧
      (a : ℝ) * W * Y ≤ (1 + W) * (2 * ((a + ν : ℕ) : ℝ) * Y) ^ (6 * (a + ν)) ∧
      1 ≤ (1 + W) * (2 * ((a + ν : ℕ) : ℝ) * Y) ^ (6 * (a + ν)) := by
    obtain ⟨N, hN⟩ : ∃ N : ℕ, N = a + ν := ⟨_, rfl⟩
    rw [← hN]
    rw [← hN] at ht
    have haN : a ≤ N := by omega
    have hY0 : (0 : ℝ) ≤ Y := by linarith
    have hP1 : 1 ≤ (2 * (N : ℝ) * Y) ^ (6 * N) := by
      rcases Nat.eq_zero_or_pos N with h0 | hpos
      · rw [h0]; simp
      · have h1 : (1 : ℝ) ≤ N := by exact_mod_cast hpos
        exact one_le_pow₀ (by nlinarith)
    have hB : (2 * (N : ℝ) * Y) ^ (6 * N) ≤ (1 + W) * (2 * (N : ℝ) * Y) ^ (6 * N) :=
      le_mul_of_one_le_left (by linarith) (by linarith)
    have hi : (t : ℝ) * (2 * (t : ℝ) * Y) ^ (4 * t) * Y
        ≤ (1 + W) * (2 * (N : ℝ) * Y) ^ (6 * N) := by
      rcases Nat.eq_zero_or_pos t with h0 | hpos
      · rw [h0]; simp only [Nat.cast_zero, zero_mul]; linarith
      · have ht1 : (1 : ℝ) ≤ t := by exact_mod_cast hpos
        have htN : (t : ℝ) ≤ N := by exact_mod_cast ht
        have hX1 : 1 ≤ 2 * (t : ℝ) * Y := by nlinarith
        have hXN : 2 * (t : ℝ) * Y ≤ 2 * (N : ℝ) * Y := by nlinarith
        have hp0 : 0 ≤ (2 * (t : ℝ) * Y) ^ (4 * t) := by positivity
        calc (t : ℝ) * (2 * (t : ℝ) * Y) ^ (4 * t) * Y
            ≤ (2 * (t : ℝ) * Y) ^ (4 * t) * (2 * (t : ℝ) * Y) := by nlinarith
          _ = (2 * (t : ℝ) * Y) ^ (4 * t + 1) := by rw [pow_succ]
          _ ≤ (2 * (N : ℝ) * Y) ^ (4 * t + 1) := pow_le_pow_left₀ (by linarith) hXN _
          _ ≤ (2 * (N : ℝ) * Y) ^ (6 * N) := pow_le_pow_right₀ (by linarith) (by omega)
          _ ≤ _ := hB
    have hii : (t : ℝ) * (2 * (t : ℝ) * Y) ^ (4 * t)
        ≤ (1 + W) * (2 * (N : ℝ) * Y) ^ (6 * N) :=
      (le_mul_of_one_le_right (by positivity) hY).trans hi
    have hiii : (a : ℝ) * W * Y ≤ (1 + W) * (2 * (N : ℝ) * Y) ^ (6 * N) := by
      have haN' : (a : ℝ) ≤ N := by exact_mod_cast haN
      have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg N
      have h1 : (a : ℝ) * W * Y ≤ (1 + W) * (2 * (N : ℝ) * Y) := by
        nlinarith [mul_nonneg (mul_nonneg (sub_nonneg.2 haN') hW) hY0, mul_nonneg hN0 hY0,
          mul_nonneg (mul_nonneg hN0 hW) hY0]
      have h2 : 2 * (N : ℝ) * Y ≤ (2 * (N : ℝ) * Y) ^ (6 * N) := by
        rcases Nat.eq_zero_or_pos N with h0 | hpos
        · rw [h0]; simp
        · have h1 : (1 : ℝ) ≤ N := by exact_mod_cast hpos
          exact le_self_pow₀ (by nlinarith) (by omega)
      exact h1.trans (mul_le_mul_of_nonneg_left h2 (by linarith))
    exact ⟨hi, hii, hiii, hP1.trans hB⟩
  
  have bracket_isotropy (a ν s t J : ℕ) (ω : Fin a → Fin a → ℤ)
      (w : Fin s → Fin a ⊕ Fin ν → ℤ) (η : Fin t → Fin a ⊕ Fin ν → ℤ)
      (c : Fin J → Fin t → ℤ)
      (hcompl : ∀ u : Fin a ⊕ Fin ν → ℝ, (∀ i, ∑ k, (w i k : ℝ) * u k = 0) →
        ∃ b : Fin t → ℝ, ∀ k, u k = ∑ i', b i' * (η i' k : ℝ))
      (hcspan : ∀ x : Fin t → ℝ, (∀ l, ∑ i', (η i' (Sum.inr l) : ℝ) * x i' = 0) →
        ∃ μ : Fin J → ℝ, ∀ i', x i' = ∑ j, μ j * (c j i' : ℝ))
      (v v' : Fin a → ℝ)
      (hv : ∀ i, ∑ i₀, ((∑ j, ω i₀ j * w i (Sum.inl j) : ℤ) : ℝ) * v i₀ = 0)
      (hv' : ∀ j, ∑ i, ((∑ i', c j i' * η i' (Sum.inl i) : ℤ) : ℝ) * v' i = 0) :
      ∑ i, ∑ j, (ω i j : ℝ) * v i * v' j = 0 := by
    obtain ⟨u, hu_def⟩ : ∃ u : Fin a ⊕ Fin ν → ℝ,
        u = Sum.elim (fun j => ∑ i₀, v i₀ * (ω i₀ j : ℝ)) (fun _ => 0) := ⟨_, rfl⟩
    have hu : ∀ i, ∑ k, (w i k : ℝ) * u k = 0 := by
      intro i
      rw [Fintype.sum_sum_type, hu_def]
      simp only [Sum.elim_inl, Sum.elim_inr, mul_zero, Finset.sum_const_zero, add_zero]
      have h := hv i
      push_cast at h
      rw [← h]
      simp_rw [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
    obtain ⟨b, hb⟩ := hcompl u hu
    have hbk : ∀ l, ∑ i', (η i' (Sum.inr l) : ℝ) * b i' = 0 := by
      intro l
      have h := hb (Sum.inr l)
      rw [hu_def, Sum.elim_inr] at h
      calc ∑ i', (η i' (Sum.inr l) : ℝ) * b i' = ∑ i', b i' * (η i' (Sum.inr l) : ℝ) :=
            Finset.sum_congr rfl fun _ _ => mul_comm _ _
        _ = 0 := h.symm
    obtain ⟨μ, hμ⟩ := hcspan b hbk
    have hcol : ∀ j₁, ∑ i₀, v i₀ * (ω i₀ j₁ : ℝ)
        = ∑ j, μ j * ((∑ i', c j i' * η i' (Sum.inl j₁) : ℤ) : ℝ) := by
      intro j₁
      have h := hb (Sum.inl j₁)
      rw [hu_def, Sum.elim_inl] at h
      rw [h]
      simp_rw [hμ]
      push_cast
      simp_rw [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
    calc ∑ i, ∑ j, (ω i j : ℝ) * v i * v' j
        = ∑ j₁, v' j₁ * ∑ i₀, v i₀ * (ω i₀ j₁ : ℝ) := by
          simp_rw [Finset.mul_sum]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
      _ = ∑ j₁, v' j₁ * ∑ j, μ j * ((∑ i', c j i' * η i' (Sum.inl j₁) : ℤ) : ℝ) :=
          Finset.sum_congr rfl fun j₁ _ => by rw [hcol j₁]
      _ = ∑ j, μ j * ∑ j₁, ((∑ i', c j i' * η i' (Sum.inl j₁) : ℤ) : ℝ) * v' j₁ := by
          simp_rw [Finset.mul_sum]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
      _ = 0 := Finset.sum_eq_zero fun j _ => by rw [hv' j, mul_zero]
  
  have ht : t ≤ a + ν := by omega
  obtain ⟨hA1, hA2, hA3, hA4⟩ := bracket_elim_bound_arith a ν t W Y hW hY ht
  obtain ⟨J, c, hc1, hc2, hc3⟩ := int_orth_complement_spanning t ν Y hY
    (fun l i' => η i' (Sum.inr l)) (fun l i' => hηY i' (Sum.inr l))
  let kw : Fin s → Fin a → ℤ := fun i i₀ => ∑ j, ω i₀ j * w i (Sum.inl j)
  let kη : Fin J → Fin a → ℤ := fun j i => ∑ i', c j i' * η i' (Sum.inl i)
  refine ⟨s + J, Fin.append kw kη, ?_, ?_, ?_⟩
  · intro m i
    induction m using Fin.addCases with
    | left i₁ =>
      simp only [Fin.append_left]
      have hb : |((kw i₁ i : ℤ) : ℝ)| ≤ (a : ℝ) * W * Y := by
        simp only [kw]
        push_cast
        calc |∑ j, (ω i j : ℝ) * (w i₁ (Sum.inl j) : ℝ)|
            ≤ ∑ j, |(ω i j : ℝ) * (w i₁ (Sum.inl j) : ℝ)| := Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ _j : Fin a, W * Y := Finset.sum_le_sum fun j _ => by
                rw [abs_mul]; exact mul_le_mul (hω i j) (hwY i₁ _) (abs_nonneg _) hW
          _ = (a : ℝ) * W * Y := by
                rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
      linarith
    | right j =>
      simp only [Fin.append_right]
      have hb : |((kη j i : ℤ) : ℝ)| ≤ (t : ℝ) * (2 * (t : ℝ) * Y) ^ (4 * t) * Y := by
        simp only [kη]
        push_cast
        calc |∑ i', (c j i' : ℝ) * (η i' (Sum.inl i) : ℝ)|
            ≤ ∑ i', |(c j i' : ℝ) * (η i' (Sum.inl i) : ℝ)| := Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ _i' : Fin t, (2 * (t : ℝ) * Y) ^ (4 * t) * Y := Finset.sum_le_sum fun i' _ => by
                rw [abs_mul]
                exact mul_le_mul (hc1 j i') (hηY i' _) (abs_nonneg _)
                  ((abs_nonneg _).trans (hc1 j i'))
          _ = (t : ℝ) * (2 * (t : ℝ) * Y) ^ (4 * t) * Y := by
                rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
      linarith
  · intro v v' hv hv'
    have hst' : s + t = Fintype.card (Fin a ⊕ Fin ν) := by
      rw [Fintype.card_sum, Fintype.card_fin, Fintype.card_fin]; exact hst
    have hcompl : ∀ u : Fin a ⊕ Fin ν → ℝ, (∀ i, ∑ k, (w i k : ℝ) * u k = 0) →
        ∃ b : Fin t → ℝ, ∀ k, u k = ∑ i', b i' * (η i' k : ℝ) := fun u hu =>
      orth_complement_mem_span s t (fun i k => (w i k : ℝ)) (fun i k => (η i k : ℝ)) hst' hw hη
        (fun i i' => by
          have h := congrArg (Int.cast : ℤ → ℝ) (horth i i')
          push_cast at h
          exact h) u hu
    refine bracket_isotropy a ν s t J ω w η c hcompl hc3 v v' (fun i => ?_) (fun j => ?_)
    · have h := hv (Fin.castAdd J i)
      simp only [Fin.append_left] at h
      exact h
    · have h := hv' (Fin.natAdd s j)
      simp only [Fin.append_right] at h
      exact h
  · intro m l
    induction m using Fin.addCases with
    | left i =>
      refine ⟨-w i (Sum.inr l), ?_⟩
      simp only [Fin.append_left]
      have hid : ∑ i₀, ((kw i i₀ : ℤ) : ℝ) * q l i₀ - ((-w i (Sum.inr l) : ℤ) : ℝ)
          = ∑ k, (w i k : ℝ) * Sum.elim (fun j => ∑ i₀, q l i₀ * (ω i₀ j : ℝ))
              (fun l'' => if l'' = l then (1 : ℝ) else 0) k := by
        rw [Fintype.sum_sum_type]
        simp only [Sum.elim_inl, Sum.elim_inr, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_eq', Finset.mem_univ, if_true, kw]
        push_cast
        rw [sub_neg_eq_add]
        congr 1
        simp_rw [Finset.mul_sum, Finset.sum_mul]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
      rw [hid]
      exact (hwA i l).trans (le_mul_of_one_le_left hσ hA4)
    | right j =>
      obtain ⟨e, he⟩ := bracket_eta_smooth a ν t J σ ((2 * (t : ℝ) * Y) ^ (4 * t)) hσ q S η hηα
        c hc1 hc2 j l
      refine ⟨e, ?_⟩
      simp only [Fin.append_right]
      exact he.trans (mul_le_mul_of_nonneg_right hA2 hσ)

theorem kai_v_equidist_bounds (ν C₀ : ℕ) (hν : 1 ≤ ν) :
    ∃ A : ℕ, 1 ≤ A ∧ ∀ (D Q δ : ℝ) (a : ℕ), 1 ≤ D → 2 ≤ Q → 0 < δ → δ ≤ 1 → (a : ℝ) ≤ D →
      (1 + 2 * D * Q ^ 2) * (2 * ((a + ν : ℕ) : ℝ) *
          Real.exp ((2 + ((a + ν : ℕ) : ℝ) + (ν : ℝ) + Real.log (2 * D ^ 2 * Q ^ 2)
            + Real.log (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)))) ^ C₀))
            ^ (6 * (a + ν))
        * (Real.exp ((2 + ((a + ν : ℕ) : ℝ) + (ν : ℝ) + Real.log (2 * D ^ 2 * Q ^ 2)
            + Real.log (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)))) ^ C₀)
          * (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) + 1))
      ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ A) :=
by
  
  have hform : ∀ (D Q Z η : ℝ) (n : ℕ), 1 ≤ D → 2 ≤ Q → 0 ≤ Z → 0 < η → η ≤ 1 →
      (1 + 2 * D * Q ^ 2) * (2 * (n : ℝ) * Real.exp Z) ^ (6 * n)
          * (Real.exp Z * (1 / η + 1))
        ≤ Real.exp (5 * (D + Real.log Q) + 6 * (n : ℝ) * (2 * (n : ℝ) + Z) + Z + 1
            + Real.log (1 / η)) := by
    intro D Q Z η n hD hQ hZ hη hη1
    have hQpos : 0 < Q := by linarith
    have hlogQ : 0 ≤ Real.log Q := Real.log_nonneg (by linarith)
    have hn : (0:ℝ) ≤ n := Nat.cast_nonneg n
    have hiη : 1 ≤ 1 / η := by rw [le_div_iff₀ hη]; linarith
    have h1 : 1 + 2 * D * Q ^ 2 ≤ Real.exp (5 * (D + Real.log Q)) := by
      have hQ2 : Real.exp (2 * Real.log Q) = Q ^ 2 := by
        rw [show 2 * Real.log Q = Real.log Q + Real.log Q by ring, Real.exp_add,
          Real.exp_log hQpos]
        ring
      have h3 : (3:ℝ) ≤ Real.exp 2 := by have := Real.add_one_le_exp 2; linarith
      have hDe : D ≤ Real.exp D := by have := Real.add_one_le_exp D; linarith
      have hQ4 : 4 ≤ Q ^ 2 := by nlinarith
      have hDQ : 1 ≤ D * Q ^ 2 := by nlinarith
      have hm : 3 * D * Q ^ 2 ≤ Real.exp 2 * Real.exp D * Real.exp (2 * Real.log Q) := by
        rw [hQ2]
        have := mul_le_mul h3 hDe (by linarith) (Real.exp_pos 2).le
        exact mul_le_mul_of_nonneg_right this (by positivity)
      calc 1 + 2 * D * Q ^ 2 ≤ 3 * D * Q ^ 2 := by nlinarith
        _ ≤ Real.exp 2 * Real.exp D * Real.exp (2 * Real.log Q) := hm
        _ = Real.exp (2 + D + 2 * Real.log Q) := by rw [Real.exp_add, Real.exp_add]
        _ ≤ Real.exp (5 * (D + Real.log Q)) := Real.exp_le_exp.2 (by linarith)
    have h2 : (2 * (n : ℝ) * Real.exp Z) ^ (6 * n)
        ≤ Real.exp (6 * (n : ℝ) * (2 * (n : ℝ) + Z)) := by
      have hb : 2 * (n : ℝ) * Real.exp Z ≤ Real.exp (2 * n + Z) := by
        rw [Real.exp_add]
        have := Real.add_one_le_exp (2 * (n:ℝ))
        exact mul_le_mul_of_nonneg_right (by linarith) (Real.exp_pos Z).le
      calc (2 * (n : ℝ) * Real.exp Z) ^ (6 * n) ≤ Real.exp (2 * n + Z) ^ (6 * n) :=
            pow_le_pow_left₀ (by positivity) hb _
        _ = Real.exp (((6 * n : ℕ) : ℝ) * (2 * n + Z)) := (Real.exp_nat_mul _ _).symm
        _ = Real.exp (6 * (n : ℝ) * (2 * (n : ℝ) + Z)) := by push_cast; ring_nf
    have h3 : Real.exp Z * (1 / η + 1) ≤ Real.exp Z * Real.exp (1 + Real.log (1 / η)) := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_pos Z).le
      have h2e : (2:ℝ) ≤ Real.exp 1 := by have := Real.add_one_le_exp 1; linarith
      rw [Real.exp_add, Real.exp_log (by linarith)]
      nlinarith
    have hA0 : 0 ≤ 1 + 2 * D * Q ^ 2 := by nlinarith
    have hB0 : 0 ≤ (2 * (n : ℝ) * Real.exp Z) ^ (6 * n) := by positivity
    have hC0 : 0 ≤ Real.exp Z * (1 / η + 1) :=
      mul_nonneg (Real.exp_pos Z).le (by linarith)
    calc _ ≤ Real.exp (5 * (D + Real.log Q)) * Real.exp (6 * (n : ℝ) * (2 * (n : ℝ) + Z))
          * (Real.exp Z * Real.exp (1 + Real.log (1 / η))) :=
          mul_le_mul (mul_le_mul h1 h2 hB0 (Real.exp_pos _).le) h3 hC0 (by positivity)
      _ = _ := by
          rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
          congr 1
          ring
  
  have hlog : ∀ (a : ℕ) (D Q δ : ℝ), 1 ≤ D → 2 ≤ Q → 0 < δ → δ ≤ 1 → (a : ℝ) ≤ D →
      0 ≤ Real.log (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1))) ∧
      Real.log (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)))
        ≤ 32 * (3 * (ν : ℝ) + 15) * (D + Real.log Q + Real.log (1 / δ)) ^ 2 ∧
      0 ≤ Real.log (2 * D ^ 2 * Q ^ 2) ∧
      Real.log (2 * D ^ 2 * Q ^ 2) ≤ 5 * (D + Real.log Q + Real.log (1 / δ)) := by
    intro a D Q δ hD hQ hδ hδ1 ha
    have hQpos : 0 < Q := by linarith
    have hDpos : 0 < D := by linarith
    have hlogQ : 0 ≤ Real.log Q := Real.log_nonneg (by linarith)
    have hiδ : 1 ≤ 1 / δ := by rw [le_div_iff₀ hδ]; linarith
    have hiδpos : 0 < 1 / δ := by linarith
    have hlogδ : 0 ≤ Real.log (1 / δ) := Real.log_nonneg hiδ
    have hlogD : 0 ≤ Real.log D := Real.log_nonneg hD
    have hlogDle : Real.log D ≤ D - 1 := Real.log_le_sub_one_of_pos hDpos
    have h4 : (0:ℝ) < 4 ^ (ν + 4) := by positivity
    have hlog4 : Real.log 4 ≤ 3 := by
      have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 4 by norm_num); linarith
    have hlog4' : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
    have hlog2 : Real.log 2 ≤ 1 := by
      have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 2 by norm_num); linarith
    have hlog2' : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    have h4D : 0 < 4 ^ (ν + 4) * D := mul_pos h4 hDpos
    have hB : 0 < 4 ^ (ν + 4) * D * Q := mul_pos h4D hQpos
    have hL : Real.log (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)))
        = (16 * ((a:ℝ) + 1)) * (((ν:ℝ) + 4) * Real.log 4 + Real.log D + Real.log Q
            + Real.log (1 / δ)) := by
      have e : 1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1))
          = (4 ^ (ν + 4) * D * Q * (1 / δ)) ^ (16 * (a + 1)) := by
        rw [← one_div_pow, one_div_div, div_eq_mul_one_div]
      rw [e, Real.log_pow, Real.log_mul hB.ne' hiδpos.ne', Real.log_mul h4D.ne' hQpos.ne',
        Real.log_mul h4.ne' hDpos.ne', Real.log_pow]
      push_cast
      ring
    have hlM : Real.log (2 * D ^ 2 * Q ^ 2)
        = Real.log 2 + 2 * Real.log D + 2 * Real.log Q := by
      rw [Real.log_mul (mul_pos two_pos (pow_pos hDpos 2)).ne' (pow_pos hQpos 2).ne',
        Real.log_mul two_ne_zero (pow_pos hDpos 2).ne', Real.log_pow, Real.log_pow]
      push_cast
      ring
    obtain ⟨s, hs⟩ : ∃ s, s = D + Real.log Q + Real.log (1 / δ) := ⟨_, rfl⟩
    rw [← hs, hL, hlM]
    have hs1 : 1 ≤ s := by linarith
    have hM0 : 0 ≤ ((ν:ℝ) + 4) * Real.log 4 + Real.log D + Real.log Q + Real.log (1 / δ) := by
      have := mul_nonneg (by positivity : (0:ℝ) ≤ ν + 4) hlog4'
      linarith
    have hMle : ((ν:ℝ) + 4) * Real.log 4 + Real.log D + Real.log Q + Real.log (1 / δ)
        ≤ (3 * ν + 15) * s := by
      have h1 : ((ν:ℝ) + 4) * Real.log 4 ≤ ((ν:ℝ) + 4) * 3 :=
        mul_le_mul_of_nonneg_left hlog4 (by positivity)
      have h2 : ((ν:ℝ) + 4) * 3 ≤ ((ν:ℝ) + 4) * 3 * s :=
        le_mul_of_one_le_right (by positivity) hs1
      nlinarith
    have hk0 : (0:ℝ) ≤ 16 * ((a:ℝ) + 1) := by positivity
    have hkle : 16 * ((a:ℝ) + 1) ≤ 32 * s := by linarith
    refine ⟨mul_nonneg hk0 hM0, ?_, by linarith, by linarith⟩
    calc _ ≤ (32 * s) * ((3 * ν + 15) * s) := mul_le_mul hkle hMle hM0 (by linarith)
      _ = _ := by ring
  
  have habsorb : ∀ (K P : ℕ) (s : ℝ), 3 / 2 ≤ s → (K : ℝ) * s ^ P ≤ s ^ (P + 2 * K) := by
    intro K P s hs
    have h1 := one_add_mul_le_pow (show (-2:ℝ) ≤ 1 / 2 by norm_num) (2 * K)
    have h2 : ((1:ℝ) + 1 / 2) ^ (2 * K) ≤ s ^ (2 * K) :=
      pow_le_pow_left₀ (by norm_num) (by linarith) _
    have hc : ((2 * K : ℕ) : ℝ) = 2 * (K : ℝ) := by push_cast; ring
    rw [hc] at h1
    have h3 : (K : ℝ) ≤ s ^ (2 * K) := by linarith
    rw [pow_add]
    calc (K : ℝ) * s ^ P ≤ s ^ (2 * K) * s ^ P :=
          mul_le_mul_of_nonneg_right h3 (pow_nonneg (by linarith) _)
      _ = s ^ P * s ^ (2 * K) := mul_comm _ _
  
  obtain ⟨K, hK⟩ : ∃ K : ℕ, K = 6 + 12 * (1 + ν) ^ 2 + (7 + 6 * ν) * (98 * ν + 488) ^ C₀
      + 32 * (3 * ν + 15) := ⟨_, rfl⟩
  have hKr : (K : ℝ) = 6 + 12 * (1 + (ν:ℝ)) ^ 2 + (7 + 6 * (ν:ℝ)) * (98 * (ν:ℝ) + 488) ^ C₀
      + 32 * (3 * (ν:ℝ) + 15) := by rw [hK]; push_cast; ring
  
  have hT : ∀ (s X n lM L : ℝ), 3 / 2 ≤ s → 0 ≤ X → X ≤ s → 0 ≤ n → n ≤ (1 + ν) * s →
      0 ≤ lM → lM ≤ 5 * s → 0 ≤ L → L ≤ 32 * (3 * (ν : ℝ) + 15) * s ^ 2 →
      5 * X + 6 * n * (2 * n + (2 + n + (ν : ℝ) + lM + L) ^ C₀)
          + (2 + n + (ν : ℝ) + lM + L) ^ C₀ + 1 + L
        ≤ s ^ (2 * C₀ + 2 + 2 * K) := by
    intro s X n lM L hs hX0 hXs hn0 hns hlM0 hlMs hL0 hLs
    obtain ⟨E, hE⟩ : ∃ E, E = 2 + n + (ν : ℝ) + lM + L := ⟨_, rfl⟩
    rw [← hE]
    obtain ⟨Z, hZ⟩ : ∃ Z, Z = E ^ C₀ := ⟨_, rfl⟩
    rw [← hZ]
    have hs1 : 1 ≤ s := by linarith
    have hs0 : 0 ≤ s := by linarith
    have hν0 : (0:ℝ) ≤ ν := Nat.cast_nonneg ν
    have hss : s ≤ s ^ 2 := by nlinarith
    have h1s2 : 1 ≤ s ^ 2 := by nlinarith
    have hsP1 : s ≤ s ^ (2 * C₀ + 2) := by
      simpa using pow_le_pow_right₀ hs1 (show 1 ≤ 2 * C₀ + 2 by omega)
    have hsP2 : s ^ 2 ≤ s ^ (2 * C₀ + 2) := pow_le_pow_right₀ hs1 (by omega)
    have hsP0 : 1 ≤ s ^ (2 * C₀ + 2) := one_le_pow₀ hs1
    have hE0 : 0 ≤ E := by rw [hE]; linarith
    have hEle : E ≤ (98 * (ν:ℝ) + 488) * s ^ 2 := by
      have a1 : (1 + (ν:ℝ)) * s ≤ (1 + ν) * s ^ 2 := mul_le_mul_of_nonneg_left hss (by linarith)
      have a2 : (ν:ℝ) ≤ ν * s ^ 2 := le_mul_of_one_le_right hν0 h1s2
      have a3 : (ν:ℝ) * s ^ 2 ≥ 0 := by positivity
      rw [hE]
      nlinarith
    have hZ0 : 0 ≤ Z := by rw [hZ]; exact pow_nonneg hE0 _
    have hZle : Z ≤ (98 * (ν:ℝ) + 488) ^ C₀ * s ^ (2 * C₀) := by
      rw [hZ]
      calc E ^ C₀ ≤ ((98 * (ν:ℝ) + 488) * s ^ 2) ^ C₀ := pow_le_pow_left₀ hE0 hEle _
        _ = (98 * (ν:ℝ) + 488) ^ C₀ * s ^ (2 * C₀) := by rw [mul_pow, ← pow_mul, mul_comm 2]
    have hc0 : (0:ℝ) ≤ (98 * (ν:ℝ) + 488) ^ C₀ := by positivity
    
    have t1 : 5 * X ≤ 5 * s ^ (2 * C₀ + 2) := by linarith
    have t2 : n ^ 2 ≤ (1 + (ν:ℝ)) ^ 2 * s ^ (2 * C₀ + 2) := by
      calc n ^ 2 ≤ ((1 + ν) * s) ^ 2 := pow_le_pow_left₀ hn0 hns _
        _ = (1 + (ν:ℝ)) ^ 2 * s ^ 2 := by ring
        _ ≤ (1 + (ν:ℝ)) ^ 2 * s ^ (2 * C₀ + 2) :=
            mul_le_mul_of_nonneg_left hsP2 (by positivity)
    have h6n : 6 * n + 1 ≤ (7 + 6 * (ν:ℝ)) * s := by nlinarith
    have hsZ : s * s ^ (2 * C₀) ≤ s ^ (2 * C₀ + 2) := by
      rw [← pow_succ']; exact pow_le_pow_right₀ hs1 (by omega)
    have t3 : (6 * n + 1) * Z ≤ (7 + 6 * (ν:ℝ)) * (98 * (ν:ℝ) + 488) ^ C₀ * s ^ (2 * C₀ + 2) := by
      calc (6 * n + 1) * Z ≤ ((7 + 6 * (ν:ℝ)) * s) * ((98 * (ν:ℝ) + 488) ^ C₀ * s ^ (2 * C₀)) :=
            mul_le_mul h6n hZle hZ0 (by positivity)
        _ = (7 + 6 * (ν:ℝ)) * (98 * (ν:ℝ) + 488) ^ C₀ * (s * s ^ (2 * C₀)) := by ring
        _ ≤ (7 + 6 * (ν:ℝ)) * (98 * (ν:ℝ) + 488) ^ C₀ * s ^ (2 * C₀ + 2) :=
            mul_le_mul_of_nonneg_left hsZ (by positivity)
    have t5 : L ≤ 32 * (3 * (ν : ℝ) + 15) * s ^ (2 * C₀ + 2) :=
      hLs.trans (mul_le_mul_of_nonneg_left hsP2 (by positivity))
    have hKs : 5 * X + 6 * n * (2 * n + Z) + Z + 1 + L ≤ (K : ℝ) * s ^ (2 * C₀ + 2) := by
      rw [hKr]
      nlinarith
    exact hKs.trans (habsorb K (2 * C₀ + 2) s hs)
  refine ⟨2 * C₀ + 2 + 2 * K, by omega, ?_⟩
  intro D Q δ a hD hQ hδ hδ1 ha
  
  have hQpos : 0 < Q := by linarith
  have hDpos : 0 < D := by linarith
  have hlogQ2 : Real.log 2 ≤ Real.log Q := Real.log_le_log (by norm_num) hQ
  have hlog2 := Real.log_two_gt_d9
  have hlogQ : 0 ≤ Real.log Q := by linarith
  have hiδ : 1 ≤ 1 / δ := by rw [le_div_iff₀ hδ]; linarith
  have hlogδ : 0 ≤ Real.log (1 / δ) := Real.log_nonneg hiδ
  have hs : 3 / 2 ≤ D + Real.log Q + Real.log (1 / δ) := by norm_num at hlog2; linarith
  have hν0 : (0:ℝ) ≤ ν := Nat.cast_nonneg ν
  have hn0 : (0:ℝ) ≤ ((a + ν : ℕ) : ℝ) := Nat.cast_nonneg _
  have hns : ((a + ν : ℕ) : ℝ) ≤ (1 + ν) * (D + Real.log Q + Real.log (1 / δ)) := by
    push_cast
    have : (ν:ℝ) ≤ ν * (D + Real.log Q + Real.log (1 / δ)) :=
      le_mul_of_one_le_right hν0 (by linarith)
    nlinarith
  obtain ⟨hL0, hLs, hlM0, hlMs⟩ := hlog a D Q δ hD hQ hδ hδ1 ha
  
  have h4 : (1:ℝ) ≤ 4 ^ (ν + 4) := one_le_pow₀ (by norm_num)
  have hB1 : (1:ℝ) ≤ 4 ^ (ν + 4) * D * Q :=
    one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h4 hD) (by linarith)
  have hBpos : (0:ℝ) < 4 ^ (ν + 4) * D * Q := by linarith
  have hx0 : 0 < δ / (4 ^ (ν + 4) * D * Q) := div_pos hδ hBpos
  have hx1 : δ / (4 ^ (ν + 4) * D * Q) ≤ 1 := (div_le_one hBpos).2 (by linarith)
  have hη0 : 0 < (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) := pow_pos hx0 _
  have hη1 : (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) ≤ 1 := pow_le_one₀ hx0.le hx1
  have hZ0 : 0 ≤ (2 + ((a + ν : ℕ) : ℝ) + (ν : ℝ) + Real.log (2 * D ^ 2 * Q ^ 2)
      + Real.log (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)))) ^ C₀ :=
    pow_nonneg (by linarith) _
  refine le_trans (hform D Q ((2 + ((a + ν : ℕ) : ℝ) + (ν : ℝ) + Real.log (2 * D ^ 2 * Q ^ 2)
      + Real.log (1 / (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)))) ^ C₀)
      ((δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1))) (a + ν) hD hQ hZ0 hη0 hη1) ?_
  exact Real.exp_le_exp.2 (hT _ _ _ _ _ hs (by linarith) (by linarith) hn0 hns hlM0 hlMs hL0 hLs)

theorem kai_v_equidistribution : ∀ ν : ℕ, ∃ A : ℕ, 1 ≤ A ∧ Nil2VertEquidist ν A :=
by
  intro ν
  rcases Nat.eq_zero_or_pos ν with hν0 | hνpos
  · 
    subst hν0
    refine ⟨1, le_refl _, ?_⟩
    intro D Q δ L hD hQ hδ hδ1 hL a b Bc ξ F hF p₀ p₁ r₀ r₁ r₂ z₀ hbig
    refine ⟨a, fun m i => if m = i then 1 else 0, ?_, ?_, ?_⟩
    · intro m i
      have hX : 1 ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ 1) := by
        apply Real.one_le_exp
        have h1 : 0 ≤ Real.log Q := Real.log_nonneg (by linarith)
        have h2 : 0 ≤ Real.log (1 / δ) :=
          Real.log_nonneg (by rw [le_div_iff₀ hδ]; linarith)
        rw [pow_one]; linarith
      have h01 : |(((if m = i then 1 else 0 : ℤ)) : ℝ)| ≤ 1 := by
        split_ifs <;> simp
      exact h01.trans hX
    · intro v w hv _
      have hv0 : ∀ i, v i = 0 := by
        intro i
        have := hv i
        simpa using this
      simp [hv0]
    · intro m l; exact l.elim0
  · 
    obtain ⟨C₀, hC₀, hbr⟩ := kai_v_bracket_lemma
    obtain ⟨A, hA, hbd⟩ := kai_v_equidist_bounds ν C₀ hνpos
    refine ⟨A, hA, ?_⟩
    intro D Q δ L hD hQ hδ hδ1 hL a b Bc ξ F hF p₀ p₁ r₀ r₁ r₂ z₀ hbig
    obtain ⟨q, S, c, E, hq1, hqint, hEbox, hEcard, hrel⟩ :=
      kai_v_bracket_relation ν hνpos D Q δ L hD hQ hδ hδ1 hL a b Bc ξ F hF p₀ p₁ r₀ r₁ r₂ z₀
        hbig
    obtain ⟨ηs, hηs⟩ : ∃ ηs : ℝ, ηs = (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) :=
      ⟨_, rfl⟩
    rw [← hηs] at hEcard hrel
    have hbd' := hbd D Q δ a hD hQ hδ hδ1
    
    have hab : ((a + b : ℕ) : ℝ) ≤ D := hF.1
    have hBc : ∀ i j k, |(Bc i j k : ℝ)| ≤ Q := hF.2.1
    have hξ : ∀ k, |(ξ k : ℝ)| ≤ Q := hF.2.2.1
    have haD : (a : ℝ) ≤ D := by
      push_cast at hab; have : (0 : ℝ) ≤ b := Nat.cast_nonneg b; linarith
    have hbD : (b : ℝ) ≤ D := by
      push_cast at hab; have : (0 : ℝ) ≤ a := Nat.cast_nonneg a; linarith
    have hbd'' := hbd' haD
    rw [← hηs] at hbd''
    have hDpos : 0 < D := by linarith
    have hQpos : 0 < Q := by linarith
    have hLpos : (0 : ℝ) < (L : ℝ) := by exact_mod_cast hL
    have hηpos : 0 < ηs := by rw [hηs]; positivity
    have hη1 : ηs ≤ 1 := by
      rw [hηs]
      apply pow_le_one₀ (by positivity)
      rw [div_le_one (by positivity)]
      have h4 : (1 : ℝ) ≤ 4 ^ (ν + 4) := one_le_pow₀ (by norm_num)
      have : (1 : ℝ) ≤ 4 ^ (ν + 4) * D * Q := by
        have := mul_le_mul h4 hD zero_le_one (by positivity)
        nlinarith
      linarith
    have hωb : ∀ i j, |((∑ t, ξ t * (Bc i j t - Bc j i t) : ℤ) : ℝ)| ≤ 2 * D * Q ^ 2 := by
      intro i j
      push_cast
      calc |∑ t, (ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ))|
          ≤ ∑ t, |(ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ))| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _t : Fin b, Q * (2 * Q) := by
            apply Finset.sum_le_sum
            intro t _
            rw [abs_mul]
            have h1 := abs_le.mp (hBc i j t)
            have h2 := abs_le.mp (hBc j i t)
            have h3 : |(Bc i j t : ℝ) - (Bc j i t : ℝ)| ≤ 2 * Q :=
              abs_le.mpr ⟨by linarith, by linarith⟩
            exact mul_le_mul (hξ t) h3 (abs_nonneg _) hQpos.le
        _ = (b : ℝ) * (Q * (2 * Q)) := by simp
        _ ≤ 2 * D * Q ^ 2 := by nlinarith
    
    obtain ⟨α, hα⟩ : ∃ α : Fin ν → Fin a ⊕ Fin ν → ℝ,
        α = fun l' => Sum.elim (fun j => q l' j) (fun l => S l l') := ⟨_, rfl⟩
    obtain ⟨Af, hAf⟩ : ∃ Af : Fin ν → Fin a ⊕ Fin ν → ℝ,
        Af = fun l => Sum.elim
          (fun j => ∑ i₀, q l i₀ * ((∑ t, ξ t * (Bc i₀ j t - Bc j i₀ t) : ℤ) : ℝ))
          (fun l'' => if l'' = l then (1 : ℝ) else 0) := ⟨_, rfl⟩
    have hM : (1 : ℝ) ≤ 2 * D ^ 2 * Q ^ 2 := by
      have hD2 : (1 : ℝ) ≤ D ^ 2 := one_le_pow₀ hD
      have hQ2 : (4 : ℝ) ≤ Q ^ 2 := by nlinarith
      have := mul_le_mul hD2 hQ2 (by norm_num) (by positivity)
      linarith
    have hAbd : ∀ j k, |Af j k| ≤ 2 * D ^ 2 * Q ^ 2 := by
      intro l k
      rw [hAf]
      rcases k with j | l''
      · simp only [Sum.elim_inl]
        calc |∑ i₀, q l i₀ * ((∑ t, ξ t * (Bc i₀ j t - Bc j i₀ t) : ℤ) : ℝ)|
            ≤ ∑ i₀, |q l i₀ * ((∑ t, ξ t * (Bc i₀ j t - Bc j i₀ t) : ℤ) : ℝ)| :=
              Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ _i₀ : Fin a, 1 * (2 * D * Q ^ 2) := by
              apply Finset.sum_le_sum
              intro i₀ _
              rw [abs_mul]
              exact mul_le_mul (hq1 l i₀) (hωb i₀ j) (abs_nonneg _) zero_le_one
          _ = (a : ℝ) * (2 * D * Q ^ 2) := by simp
          _ ≤ 2 * D ^ 2 * Q ^ 2 := by
              have h0 : 0 ≤ 2 * D * Q ^ 2 := by positivity
              nlinarith [mul_le_mul_of_nonneg_right haD h0]
      · simp only [Sum.elim_inr]
        split_ifs
        · rw [abs_one]; exact hM
        · rw [abs_zero]; linarith
    have hεpos : 0 < 1 / (ηs * (L : ℝ)) := by positivity
    have hshift : ∀ (x y : ℝ) (n : ℤ), x = y - n → |x - round x| = |y - round y| := by
      intro x y n hx
      rw [hx, round_sub_intCast]
      push_cast
      congr 1; ring
    have hrel2 : ∀ h ∈ E, ∀ l : Fin ν,
        |(c l + ∑ k, Af l k * ((∑ l', (h l' : ℝ) * α l' k) - round (∑ l', (h l' : ℝ) * α l' k)))
          - round (c l + ∑ k, Af l k *
              ((∑ l', (h l' : ℝ) * α l' k) - round (∑ l', (h l' : ℝ) * α l' k)))|
          ≤ 1 / (ηs * (L : ℝ)) := by
      intro h hh l
      refine le_trans (le_of_eq (hshift _ _ (round (∑ l', (h l' : ℝ) * S l l')) ?_)) (hrel h hh l)
      rw [hα, hAf]
      simp only [Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, ite_mul, one_mul, zero_mul,
        Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true]
      have e1 : ∑ j : Fin a, (∑ i₀, q l i₀ * ((∑ t, ξ t * (Bc i₀ j t - Bc j i₀ t) : ℤ) : ℝ)) *
            ((∑ l', (h l' : ℝ) * q l' j) - round (∑ l', (h l' : ℝ) * q l' j))
          = ∑ i, ∑ j, q l i * ((∑ t, ξ t * (Bc i j t - Bc j i t) : ℤ) : ℝ) *
            ((∑ l', (h l' : ℝ) * q l' j) - round (∑ l', (h l' : ℝ) * q l' j)) := by
        simp_rw [Finset.sum_mul]
        exact Finset.sum_comm
      have e2 : ∑ l', (h l' : ℝ) * S l l' = ∑ l', S l l' * (h l' : ℝ) :=
        Finset.sum_congr rfl (fun _ _ => mul_comm _ _)
      rw [e1, e2]
      ring
    obtain ⟨s, t', w, η, hst, hw, hη, horth, hwY, hηY, hηα, hwA⟩ :=
      hbr (Fin a ⊕ Fin ν) ν (2 * D ^ 2 * Q ^ 2) ηs (1 / (ηs * (L : ℝ))) L hM hηpos hη1 hεpos hL
        α Af c hAbd E hEbox hEcard hrel2
    have hcard : ((Fintype.card (Fin a ⊕ Fin ν) : ℕ) : ℝ) = ((a + ν : ℕ) : ℝ) := by simp
    have hst' : s + t' = a + ν := by rw [hst]; simp
    obtain ⟨Y, hY_def⟩ : ∃ Y : ℝ, Y = Real.exp ((2 + ((a + ν : ℕ) : ℝ) + (ν : ℝ)
        + Real.log (2 * D ^ 2 * Q ^ 2) + Real.log (1 / ηs)) ^ C₀) := ⟨_, rfl⟩
    rw [hcard, ← hY_def] at hwY hηY hηα hwA
    rw [← hY_def] at hbd''
    have hY1 : 1 ≤ Y := by
      rw [hY_def]
      apply Real.one_le_exp
      apply pow_nonneg
      have h1 : 0 ≤ Real.log (2 * D ^ 2 * Q ^ 2) := Real.log_nonneg hM
      have h2 : 0 ≤ Real.log (1 / ηs) :=
        Real.log_nonneg (by rw [le_div_iff₀ hηpos]; linarith)
      have h3 : (0 : ℝ) ≤ ((a + ν : ℕ) : ℝ) := Nat.cast_nonneg _
      have h4 : (0 : ℝ) ≤ (ν : ℝ) := Nat.cast_nonneg _
      linarith
    have hσ0 : 0 ≤ Y * (1 / (ηs * (L : ℝ)) + 1 / (L : ℝ)) := by positivity
    have hW0 : (0 : ℝ) ≤ 2 * D * Q ^ 2 := by positivity
    have hηα' : ∀ i' l',
        |(∑ k, (η i' k : ℝ) * Sum.elim (fun j => q l' j) (fun l => S l l') k)
          - round (∑ k, (η i' k : ℝ) * Sum.elim (fun j => q l' j) (fun l => S l l') k)|
          ≤ Y * (1 / (ηs * (L : ℝ)) + 1 / (L : ℝ)) := by
      intro i' l'
      have := hηα i' l'
      rw [hα] at this
      exact this
    have hwA' : ∀ i l,
        |∑ k, (w i k : ℝ) * Sum.elim
            (fun j => ∑ i₀, q l i₀ * ((∑ t, ξ t * (Bc i₀ j t - Bc j i₀ t) : ℤ) : ℝ))
            (fun l'' => if l'' = l then (1 : ℝ) else 0) k|
          ≤ Y * (1 / (ηs * (L : ℝ)) + 1 / (L : ℝ)) := by
      intro i l
      have := hwA i l
      rw [hAf] at this
      exact this
    obtain ⟨r, k, hkb, hiso, hsm⟩ :=
