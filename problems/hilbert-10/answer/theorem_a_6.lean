    clear hgood hcard hG hσN hεσ hε hσ1 hN
    intro M x₀ α T hσM hT hcard hgood
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℕ, ℓ = ⌈2 / σ⌉₊ := ⟨_, rfl⟩
