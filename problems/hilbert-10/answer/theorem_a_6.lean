      have key : ∀ m : ℕ,
          ∃ e : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K),
            ∀ a b : Ideal (NumberField.RingOfIntegers K),
              a ∈ t m → b ∈ t m → e a = e b → a = b := by
        intro m
        refine ⟨fun a => if h : a ∈ t m then Fin.castLE (htcard m) ((t m).equivFin ⟨a, h⟩)
