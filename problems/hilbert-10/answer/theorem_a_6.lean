          (by linarith [hρ4 w]) (hxmod w)
      have h2 : 2 * R' / ρ w ≤ 2 * R' / (N * a) :=
        div_le_div_of_nonneg_left (by linarith) hNapos (hρNa w)
      have h3 : Lw w = Real.log (w (x : K)) - Real.log (ρ w) := by
        simp only [hLwdef]; rw [hlogρ w]
      rw [h3]; linarith
    obtain ⟨Ap, hApdef⟩ : ∃ Ap : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ,
        Ap = fun p => ((NumberField.mixedEmbedding K (x : K)).2 p).arg - φ p := ⟨_, rfl⟩
    have hApbd : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |Ap p| ≤ ep := by
      intro p
      have h1 : |((NumberField.mixedEmbedding K (x : K)).2 p).arg - φ p|
          ≤ 4 * R' / ρ (p : NumberField.InfinitePlace K) :=
        hargle (ρ (p : NumberField.InfinitePlace K)) R' (φ p)
          ((NumberField.mixedEmbedding K (x : K)).2 p) (hρ0 _) (le_of_lt hR'0)
          (hρ4 _) (hφbd p) (hxarg p)
      have h2 : 4 * R' / ρ (p : NumberField.InfinitePlace K) ≤ 4 * R' / (N * a) :=
        div_le_div_of_nonneg_left (by linarith) hNapos (hρNa _)
      simp only [hApdef]
      linarith
    obtain ⟨θ, hθdef⟩ : ∃ θ : ℝ,
        θ = (∑ w : NumberField.InfinitePlace K, t w * (w.mult : ℝ) * Real.log (w (x : K)))
          + (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              (l p : ℝ) * ((NumberField.mixedEmbedding K (x : K)).2 p).arg) := ⟨_, rfl⟩
    obtain ⟨E, hEdef⟩ : ∃ E : ℝ,
        E = (∑ w : NumberField.InfinitePlace K, t w * (w.mult : ℝ) * Lw w)
          + (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              (l p : ℝ) * Ap p) := ⟨_, rfl⟩
    have hsum1 : (∑ w : NumberField.InfinitePlace K,
          t w * (w.mult : ℝ) * Real.log (w (x : K)))
        = Real.log N * (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w)
          + ((∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * t w) * c w)
            + (∑ w : NumberField.InfinitePlace K, t w * (w.mult : ℝ) * Lw w)) := by
      have key : ∀ w : NumberField.InfinitePlace K,
          t w * (w.mult : ℝ) * Real.log (w (x : K))
            = Real.log N * ((w.mult : ℝ) * t w)
              + (((w.mult : ℝ) * t w) * c w + t w * (w.mult : ℝ) * Lw w) := by
        intro w
        have hL : Real.log (w (x : K)) = Real.log N + c w + Lw w := by
          simp only [hLwdef]; ring
        rw [hL]; ring
      rw [Finset.sum_congr rfl (fun w (_ : w ∈ Finset.univ) => key w),
        Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum]
    have hsum2 : (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (l p : ℝ) * ((NumberField.mixedEmbedding K (x : K)).2 p).arg)
        = (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ((l p : ℝ)) * φ p)
          + (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) * Ap p) := by
      have key : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (l p : ℝ) * ((NumberField.mixedEmbedding K (x : K)).2 p).arg
            = ((l p : ℝ)) * φ p + (l p : ℝ) * Ap p := by
        intro p
        have hA : ((NumberField.mixedEmbedding K (x : K)).2 p).arg = φ p + Ap p := by
          simp only [hApdef]; ring
        rw [hA]; ring
      rw [Finset.sum_congr rfl (fun p (_ : p ∈ Finset.univ) => key p),
        Finset.sum_add_distrib]
    have hθE : θ = Real.pi / 4 + E := by
      rw [hθdef, hsum1, hsum2, htr, hEdef]
      linarith [hid]
    have hEbd : |E| ≤ Real.pi / 8 := by
      have h1 : |∑ w : NumberField.InfinitePlace K, t w * (w.mult : ℝ) * Lw w| ≤ T * ep := by
        calc |∑ w : NumberField.InfinitePlace K, t w * (w.mult : ℝ) * Lw w|
            ≤ ∑ w : NumberField.InfinitePlace K, |t w * (w.mult : ℝ) * Lw w| :=
              Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * |t w|) * ep := by
              refine Finset.sum_le_sum fun w _ => ?_
              have he : |t w * (w.mult : ℝ) * Lw w| = ((w.mult : ℝ) * |t w|) * |Lw w| := by
                rw [abs_mul, abs_mul, abs_of_nonneg (hmult0 w)]; ring
              rw [he]
              exact mul_le_mul_of_nonneg_left (hLwbd w)
                (mul_nonneg (hmult0 w) (abs_nonneg _))
          _ = T * ep := by rw [hTdef, Finset.sum_mul]
      have h2 : |∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) * Ap p|
          ≤ D * ep := by
        calc |∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) * Ap p|
            ≤ ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ) * Ap p| :=
              Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)| * ep := by
              refine Finset.sum_le_sum fun p _ => ?_
              rw [abs_mul]
              exact mul_le_mul_of_nonneg_left (hApbd p) (abs_nonneg _)
          _ = D * ep := by rw [hDdef, Finset.sum_mul]
      have h3 : |E| ≤ T * ep + D * ep := by
        have h1' := abs_le.mp h1
        have h2' := abs_le.mp h2
        rw [hEdef, abs_le]
        constructor <;> linarith [h1'.1, h1'.2, h2'.1, h2'.2]
      have h4 : T * ep + D * ep ≤ Lam * ep := by
        have hTD : T + D ≤ Lam := by rw [hLamdef]; linarith
        nlinarith [hep0, hTD]
      have h5 : Lam * ep = Real.pi / 8 := by
        rw [hepdef]
        field_simp
      linarith
    have hEab := abs_le.mp hEbd
    have hθpos : 0 < θ := by rw [hθE]; linarith [hEab.1]
    have hθlt : θ < Real.pi := by rw [hθE]; linarith [hEab.2]
    have hsinpos : 0 < Real.sin θ := Real.sin_pos_of_pos_of_lt_pi hθpos hθlt
    have hsin0 : Real.sin θ = 0 := by
      have h6 := htwist x hx1 hxpos
      have hlamx := hH6 x hx0
      have hre := hreal (Ideal.span {x})
      have him : (lam (Ideal.span {x})).im = 0 := Complex.conj_eq_iff_im.mp hre.symm
      rw [hlamx, h6] at him
