  have hregroup : ∀ G : (Fin b → ℤ) → ℂ,
      (∑ m ∈ S, ∑ m' ∈ S, G (δ (m, m'))) = ∑ ζ ∈ T, ((fib ζ).card : ℂ) * G ζ := by
    intro G
    have e1 : (∑ m ∈ S, ∑ m' ∈ S, G (δ (m, m'))) = ∑ p ∈ S ×ˢ S, G (δ p) :=
      (Finset.sum_product S S (fun p => G (δ p))).symm
    have e2 : (∑ p ∈ S ×ˢ S, G (δ p))
        = ∑ ζ ∈ T, ∑ p ∈ (S ×ˢ S).filter (fun p => δ p = ζ), G (δ p) :=
      (Finset.sum_fiberwise_of_maps_to hmaps (fun p => G (δ p))).symm
    have e3 : ∀ ζ ∈ T, (∑ p ∈ (S ×ˢ S).filter (fun p => δ p = ζ), G (δ p))
        = ((fib ζ).card : ℂ) * G ζ := by
      intro ζ _
      have h : (∑ p ∈ (S ×ˢ S).filter (fun p => δ p = ζ), G (δ p))
          = ∑ p ∈ (S ×ˢ S).filter (fun p => δ p = ζ), G ζ :=
        Finset.sum_congr rfl (fun p hp => by rw [(Finset.mem_filter.mp hp).2])
      rw [h, Finset.sum_const, nsmul_eq_mul, hfibapp]
    rw [e1, e2]; exact Finset.sum_congr rfl e3
  have hScard : S.card = R ^ b := by
    rw [hS, Fintype.card_piFinset]; simp
  have hfibcard : ∀ ζ, (fib ζ).card ≤ R ^ b := by
    intro ζ
    rw [← hScard]
    apply Finset.card_le_card_of_injOn (fun p => p.1)
    · intro p hp
      have hp' := ((hmemfib ζ p).mp (Finset.mem_coe.mp hp)).1
      exact Finset.mem_coe.mpr (Finset.mem_product.mp hp').1
    · intro p hp q hq hpq
      have hp2 := ((hmemfib ζ p).mp (Finset.mem_coe.mp hp)).2
      have hq2 := ((hmemfib ζ q).mp (Finset.mem_coe.mp hq)).2
      have hpq' : p.1 = q.1 := hpq
      refine Prod.ext hpq' (funext fun k => ?_)
      have h1 := congrFun hp2 k
      have h2 := congrFun hq2 k
      have h3 := congrFun hpq' k
      rw [hδapp] at h1 h2
      omega
  have hTcard : T.card ≤ (2 * R) ^ b := by
    rw [hT, Fintype.card_piFinset]
    calc ∏ _k : Fin b, (Finset.Icc (1 - (R : ℤ)) ((R : ℤ) - 1)).card
        ≤ ∏ _k : Fin b, (2 * R) :=
          Finset.prod_le_prod' (fun k _ => by
            rw [Int.card_Icc]; apply Int.toNat_le.mpr; push_cast; omega)
      _ = (2 * R) ^ b := by simp
  
  obtain ⟨c, hc⟩ : ∃ c : (Fin b → ℤ) → ℂ, c = fun ζ =>
      ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F w : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ))) :=
    ⟨_, rfl⟩
  have hcapp : ∀ ζ, c ζ = ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F w : ℂ) *
      Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ))) := by
    intro ζ; rw [hc]
  have hcbd : ∀ ζ, ‖c ζ‖ ≤ 1 := by intro ζ; rw [hcapp]; exact hcn ζ
  obtain ⟨A, hA⟩ : ∃ A : (Fin b → ℤ) → ℂ,
      A = fun ζ => ((fib ζ).card : ℂ) / (R : ℂ) ^ b * c ζ := ⟨_, rfl⟩
  have hAapp : ∀ ζ, A ζ = ((fib ζ).card : ℂ) / (R : ℂ) ^ b * c ζ := by intro ζ; rw [hA]
  have hAbd : ∀ ζ, ‖A ζ‖ ≤ 1 := by
    intro ζ
    rw [hAapp, norm_mul, norm_div, norm_pow, Complex.norm_natCast, Complex.norm_natCast]
    have h1 : ((fib ζ).card : ℝ) / (R : ℝ) ^ b ≤ 1 := by
      rw [div_le_one (by positivity)]; exact_mod_cast hfibcard ζ
    exact mul_le_one₀ h1 (norm_nonneg _) (hcbd ζ)
  
  refine ⟨T.card, fun j => ((T.equivFin.symm j : T) : Fin b → ℤ),
    fun j => A ((T.equivFin.symm j : T) : Fin b → ℤ), ?_, ?_, ?_⟩
  · exact (Nat.cast_le.mpr hTcard).trans hcnt
  · intro j; exact hAbd _
  · intro u
    show |F u - (∑ j : Fin T.card, A ((T.equivFin.symm j : T) : Fin b → ℤ) *
      giE (∑ i, (((T.equivFin.symm j : T) : Fin b → ℤ) i : ℝ) * u i)).re| ≤ ε
    have hexp := box_kernel_integral_expand b R F hFc u
    obtain ⟨hK1, hK2⟩ := box_fejer_kernel_moments b R hR1 (torus_char_integral b)
      (fun f hf x => box_kernel_integral_expand b R f hf x) u
    have hcont : Continuous (fun w : Fin b → ℝ =>
        ∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R),
          Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (u k - w k) : ℝ) : ℂ))) :=
      continuous_finset_sum _ (fun m _ => Complex.continuous_exp.comp
        (continuous_const.mul (Complex.continuous_ofReal.comp
          (continuous_finset_sum _ (fun k _ =>
            continuous_const.mul (continuous_const.sub (continuous_apply k)))))))
    have happrox := box_fejer_approx b R hR1 Q hQ F (fun w n => hFper w n) hFlip u _
      hcont hK1 hK2
    have hsumeq : (∑ j : Fin T.card, A ((T.equivFin.symm j : T) : Fin b → ℤ) *
        giE (∑ i, (((T.equivFin.symm j : T) : Fin b → ℤ) i : ℝ) * u i))
        = ∑ ζ ∈ T, A ζ * giE (∑ i, (ζ i : ℝ) * u i) :=
      (Equiv.sum_comp T.equivFin.symm (fun i : T => A (i : Fin b → ℤ) *
        giE (∑ i_1, ((i : Fin b → ℤ) i_1 : ℝ) * u i_1))).trans
        (Finset.sum_coe_sort T (fun ζ => A ζ * giE (∑ i, (ζ i : ℝ) * u i)))
    have hexp' : ((∫ w in Set.Icc (0 : Fin b → ℝ) 1, F w *
        ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R),
          Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (u k - w k) : ℝ) : ℂ))‖ ^ 2
          : ℝ) : ℂ)
        = ∑ ζ ∈ T, ((fib ζ).card : ℂ) * (giE (∑ i, (ζ i : ℝ) * u i) * c ζ) := by
      rw [hexp, ← hS, ← hregroup]
      apply Finset.sum_congr rfl; intro m _
      apply Finset.sum_congr rfl; intro m' _
      simp only [hcapp, giE, hδapp, Int.cast_sub, Int.cast_natCast]
    have hRne : (R : ℂ) ≠ 0 := by exact_mod_cast (show R ≠ 0 by omega)
    have hre : (∑ ζ ∈ T, A ζ * giE (∑ i, (ζ i : ℝ) * u i)).re
        = (∫ w in Set.Icc (0 : Fin b → ℝ) 1, F w *
          ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R),
            Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (u k - w k) : ℝ) : ℂ))‖ ^ 2)
          / (R : ℝ) ^ b := by
      have h : (∑ ζ ∈ T, A ζ * giE (∑ i, (ζ i : ℝ) * u i))
          = (((∫ w in Set.Icc (0 : Fin b → ℝ) 1, F w *
          ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R),
            Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (u k - w k) : ℝ) : ℂ))‖ ^ 2)
          / (R : ℝ) ^ b : ℝ) : ℂ) := by
        rw [Complex.ofReal_div, hexp', Complex.ofReal_pow, Complex.ofReal_natCast, Finset.sum_div]
        apply Finset.sum_congr rfl; intro ζ _
        rw [hAapp]; ring
      rw [h, Complex.ofReal_re]
    rw [hsumeq, hre]
    exact happrox.trans herr

theorem kai_quad_phase_U3_converse {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K))
    (f : NumberField.RingOfIntegers K → ℝ) (M : ℝ) (hM : 0 ≤ M)
    (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ) :
    ‖∑ x ∈ omegaBox ω M, ((f x : ℝ) : ℂ) * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ ^ 8
      ≤ 2 ^ (4 * ν) * ((omegaBox ω M).card : ℝ) ^ 8 * gowersU3Pow ω f M :=
by
  classical
  
  have t_sq_expand : ∀ (B D : Finset (NumberField.RingOfIntegers K)),
      (∀ x ∈ B, ∀ y ∈ B, y - x ∈ D) → ∀ (g : NumberField.RingOfIntegers K → ℂ),
      (∀ x, x ∉ B → g x = 0) →
      (((‖∑ x ∈ B, g x‖ ^ 2 : ℝ)) : ℂ) =
        ∑ h ∈ D, ∑ x ∈ B, g (x + h) * starRingEnd ℂ (g x) := by
    intro B D hBD g hg
    have hshift : ∀ x ∈ B, ∑ h ∈ D, g (x + h) = ∑ y ∈ B, g y := by
      intro x hx
      rw [← Finset.sum_image (s := D) (g := fun h => x + h) (f := g)
        (fun a _ b _ hab => add_left_cancel hab)]
      symm
      apply Finset.sum_subset
      · intro y hy
        rw [Finset.mem_image]
        exact ⟨y - x, hBD x hx y hy, by abel⟩
      · intro y _ hy
        exact hg y hy
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_mul]
    have h2 : ∑ x ∈ B, (∑ h ∈ D, g (x + h)) * starRingEnd ℂ (g x)
        = ∑ x ∈ B, (∑ y ∈ B, g y) * starRingEnd ℂ (g x) :=
      Finset.sum_congr rfl (fun x hx => by rw [hshift x hx])
    rw [h2, ← Finset.mul_sum, ← map_sum, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  
  have t_cs_eighth : ∀ (B D : Finset (NumberField.RingOfIntegers K)),
      (∀ x ∈ B, ∀ y ∈ B, y - x ∈ D) → ∀ (g : NumberField.RingOfIntegers K → ℂ),
      (∀ x, x ∉ B → g x = 0) →
      ∃ W : ℝ, 0 ≤ W ∧ ‖∑ x ∈ B, g x‖ ^ 8 ≤ (D.card : ℝ) ^ 4 * W ∧
        (W : ℂ) = ∑ x ∈ B, ∑ h₁ ∈ D, ∑ h₂ ∈ D, ∑ h₃ ∈ D,
          g (x + h₁ + h₂ + h₃) * starRingEnd ℂ (g (x + h₂ + h₃))
            * starRingEnd ℂ (g (x + h₁ + h₃)) * g (x + h₃)
            * starRingEnd ℂ (g (x + h₁ + h₂)) * g (x + h₂) * g (x + h₁)
            * starRingEnd ℂ (g x) := by
    intro B D hBD g hg
    obtain ⟨g₁, hg₁⟩ : ∃ g₁ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℂ,
        g₁ = fun h₁ y => g (y + h₁) * starRingEnd ℂ (g y) := ⟨_, rfl⟩
    obtain ⟨g₂, hg₂⟩ : ∃ g₂ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
        NumberField.RingOfIntegers K → ℂ,
        g₂ = fun h₁ h₂ y => g₁ h₁ (y + h₂) * starRingEnd ℂ (g₁ h₁ y) := ⟨_, rfl⟩
    have hg₁v : ∀ h₁ y, y ∉ B → g₁ h₁ y = 0 := by
      intro h₁ y hy; rw [hg₁]; simp [hg y hy]
    have hg₂v : ∀ h₁ h₂ y, y ∉ B → g₂ h₁ h₂ y = 0 := by
      intro h₁ h₂ y hy; rw [hg₂]; simp [hg₁v h₁ y hy]
    obtain ⟨A, hA⟩ : ∃ A : NumberField.RingOfIntegers K → ℂ,
        A = fun h₁ => ∑ x ∈ B, g₁ h₁ x := ⟨_, rfl⟩
    obtain ⟨A₂, hA₂⟩ : ∃ A₂ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℂ,
        A₂ = fun h₁ h₂ => ∑ x ∈ B, g₂ h₁ h₂ x := ⟨_, rfl⟩
    obtain ⟨V, hV⟩ : ∃ V : ℝ, V = ∑ h₁ ∈ D, ‖A h₁‖ ^ 2 := ⟨_, rfl⟩
    obtain ⟨W, hW⟩ : ∃ W : ℝ, W = ∑ h₁ ∈ D, ∑ h₂ ∈ D, ‖A₂ h₁ h₂‖ ^ 2 := ⟨_, rfl⟩
    have hV0 : 0 ≤ V := by rw [hV]; positivity
    have hW0 : 0 ≤ W := by rw [hW]; positivity
    have ha : ((‖∑ x ∈ B, g x‖ ^ 2 : ℝ) : ℂ) = ∑ h₁ ∈ D, A h₁ := by
      rw [t_sq_expand B D hBD g hg, hA, hg₁]
    have ha' : ‖∑ x ∈ B, g x‖ ^ 2 = ‖∑ h₁ ∈ D, A h₁‖ := by
      rw [← ha, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    have hb : ‖∑ x ∈ B, g x‖ ^ 4 ≤ (D.card : ℝ) * V := by
      have e1 : ‖∑ x ∈ B, g x‖ ^ 4 = (‖∑ x ∈ B, g x‖ ^ 2) ^ 2 := by ring
      rw [e1, ha', hV]
      calc ‖∑ h₁ ∈ D, A h₁‖ ^ 2 ≤ (∑ h₁ ∈ D, ‖A h₁‖) ^ 2 :=
            pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2
        _ ≤ (D.card : ℝ) * ∑ h₁ ∈ D, ‖A h₁‖ ^ 2 := sq_sum_le_card_mul_sum_sq
    have hc : (V : ℂ) = ∑ h₁ ∈ D, ∑ h₂ ∈ D, A₂ h₁ h₂ := by
      rw [hV, Complex.ofReal_sum]
      refine Finset.sum_congr rfl (fun h₁ _ => ?_)
      rw [hA, t_sq_expand B D hBD (g₁ h₁) (hg₁v h₁), hA₂, hg₂]
    have hd : V ^ 2 ≤ (D.card : ℝ) ^ 2 * W := by
      have e1 : V = ‖∑ h₁ ∈ D, ∑ h₂ ∈ D, A₂ h₁ h₂‖ := by
        rw [← hc, Complex.norm_real, Real.norm_of_nonneg hV0]
      have e2 : V ≤ ∑ h₁ ∈ D, ∑ h₂ ∈ D, ‖A₂ h₁ h₂‖ := by
        rw [e1]
        exact (norm_sum_le _ _).trans (Finset.sum_le_sum (fun h₁ _ => norm_sum_le _ _))
      have e3 : V ^ 2 ≤ (∑ h₁ ∈ D, ∑ h₂ ∈ D, ‖A₂ h₁ h₂‖) ^ 2 := pow_le_pow_left₀ hV0 e2 2
      have e4 : (∑ h₁ ∈ D, ∑ h₂ ∈ D, ‖A₂ h₁ h₂‖) ^ 2
          ≤ (D.card : ℝ) * ∑ h₁ ∈ D, (∑ h₂ ∈ D, ‖A₂ h₁ h₂‖) ^ 2 := sq_sum_le_card_mul_sum_sq
      have e5 : ∑ h₁ ∈ D, (∑ h₂ ∈ D, ‖A₂ h₁ h₂‖) ^ 2
          ≤ ∑ h₁ ∈ D, (D.card : ℝ) * ∑ h₂ ∈ D, ‖A₂ h₁ h₂‖ ^ 2 :=
        Finset.sum_le_sum (fun h₁ _ => sq_sum_le_card_mul_sum_sq)
      rw [← Finset.mul_sum, ← hW] at e5
      have hDc : (0 : ℝ) ≤ D.card := Nat.cast_nonneg _
      calc V ^ 2 ≤ (D.card : ℝ) * ((D.card : ℝ) * W) :=
            e3.trans (e4.trans (mul_le_mul_of_nonneg_left e5 hDc))
        _ = (D.card : ℝ) ^ 2 * W := by ring
    have he : (W : ℂ) = ∑ h₁ ∈ D, ∑ h₂ ∈ D, ∑ h₃ ∈ D, ∑ x ∈ B,
        g₂ h₁ h₂ (x + h₃) * starRingEnd ℂ (g₂ h₁ h₂ x) := by
      rw [hW, Complex.ofReal_sum]
      refine Finset.sum_congr rfl (fun h₁ _ => ?_)
      rw [Complex.ofReal_sum]
      refine Finset.sum_congr rfl (fun h₂ _ => ?_)
      rw [hA₂, t_sq_expand B D hBD (g₂ h₁ h₂) (hg₂v h₁ h₂)]
    have hpt : ∀ x h₁ h₂ h₃ : NumberField.RingOfIntegers K,
        g₂ h₁ h₂ (x + h₃) * starRingEnd ℂ (g₂ h₁ h₂ x)
        = g (x + h₁ + h₂ + h₃) * starRingEnd ℂ (g (x + h₂ + h₃))
            * starRingEnd ℂ (g (x + h₁ + h₃)) * g (x + h₃)
            * starRingEnd ℂ (g (x + h₁ + h₂)) * g (x + h₂) * g (x + h₁)
            * starRingEnd ℂ (g x) := by
      intro x h₁ h₂ h₃
      rw [hg₂, hg₁]
      simp only [map_mul, Complex.conj_conj]
      rw [show x + h₃ + h₂ + h₁ = x + h₁ + h₂ + h₃ by abel,
        show x + h₃ + h₂ = x + h₂ + h₃ by abel,
        show x + h₃ + h₁ = x + h₁ + h₃ by abel,
        show x + h₂ + h₁ = x + h₁ + h₂ by abel]
      ring
    refine ⟨W, hW0, ?_, ?_⟩
    · calc ‖∑ x ∈ B, g x‖ ^ 8 = (‖∑ x ∈ B, g x‖ ^ 4) ^ 2 := by ring
        _ ≤ ((D.card : ℝ) * V) ^ 2 := pow_le_pow_left₀ (by positivity) hb 2
        _ = (D.card : ℝ) ^ 2 * V ^ 2 := by ring
        _ ≤ (D.card : ℝ) ^ 2 * ((D.card : ℝ) ^ 2 * W) :=
            mul_le_mul_of_nonneg_left hd (by positivity)
        _ = (D.card : ℝ) ^ 4 * W := by ring
    · rw [he]
      simp_rw [hpt]
      calc _ = ∑ h₁ ∈ D, ∑ h₂ ∈ D, ∑ x ∈ B, ∑ h₃ ∈ D,
            g (x + h₁ + h₂ + h₃) * starRingEnd ℂ (g (x + h₂ + h₃))
              * starRingEnd ℂ (g (x + h₁ + h₃)) * g (x + h₃)
              * starRingEnd ℂ (g (x + h₁ + h₂)) * g (x + h₂) * g (x + h₁)
              * starRingEnd ℂ (g x) :=
            Finset.sum_congr rfl (fun h₁ _ => Finset.sum_congr rfl (fun h₂ _ =>
              Finset.sum_comm))
        _ = ∑ h₁ ∈ D, ∑ x ∈ B, ∑ h₂ ∈ D, ∑ h₃ ∈ D,
            g (x + h₁ + h₂ + h₃) * starRingEnd ℂ (g (x + h₂ + h₃))
              * starRingEnd ℂ (g (x + h₁ + h₃)) * g (x + h₃)
              * starRingEnd ℂ (g (x + h₁ + h₂)) * g (x + h₂) * g (x + h₁)
              * starRingEnd ℂ (g x) :=
            Finset.sum_congr rfl (fun h₁ _ => Finset.sum_comm)
        _ = _ := Finset.sum_comm
  
  have t_third_diff : ∀ z w₁ w₂ w₃ : Fin ν → ℤ,
      kaiQuadPoly p₀ p₁ p₂ (z + w₁ + w₂ + w₃) - kaiQuadPoly p₀ p₁ p₂ (z + w₂ + w₃)
        - kaiQuadPoly p₀ p₁ p₂ (z + w₁ + w₃) + kaiQuadPoly p₀ p₁ p₂ (z + w₃)
        - kaiQuadPoly p₀ p₁ p₂ (z + w₁ + w₂) + kaiQuadPoly p₀ p₁ p₂ (z + w₂)
        + kaiQuadPoly p₀ p₁ p₂ (z + w₁) - kaiQuadPoly p₀ p₁ p₂ z = 0 := by
    intro z w₁ w₂ w₃
    simp only [kaiQuadPoly, Pi.add_apply, Int.cast_add]
    simp only [mul_add, add_mul, Finset.sum_add_distrib]
    ring
  
  have t_cube : ∀ F : (Fin 3 → Fin 2) → ℝ,
      ∏ ε : Fin 3 → Fin 2, F ε =
        F ![0, 0, 0] * F ![1, 0, 0] * F ![0, 1, 0] * F ![1, 1, 0]
          * F ![0, 0, 1] * F ![1, 0, 1] * F ![0, 1, 1] * F ![1, 1, 1] := by
    intro F
    let e : Fin 2 × Fin 2 × Fin 2 ≃ (Fin 3 → Fin 2) :=
      { toFun := fun p => ![p.1, p.2.1, p.2.2]
        invFun := fun ε => (ε 0, ε 1, ε 2)
        left_inv := fun p => by simp
        right_inv := fun ε => by funext i; fin_cases i <;> rfl }
    rw [← e.prod_comp]
    simp only [Fintype.prod_prod_type, Fin.prod_univ_two]
    simp only [e, Equiv.coe_fn_mk]
    simp only [mul_comm, mul_assoc, mul_left_comm]
  
  have t_giE : ∀ a b t : ℝ, giE a * giE b = giE (a + b) ∧
      starRingEnd ℂ (giE t) = giE (-t) ∧ giE 0 = 1 := by
    intro a b t
    refine ⟨?_, ?_, ?_⟩
    · unfold giE; rw [← Complex.exp_add]; congr 1; push_cast; ring
    · unfold giE; rw [← Complex.exp_conj]; congr 1
      simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
      push_cast; ring
    · simp [giE]
  
  have hbox : (∀ x ∈ omegaBox ω M, ∀ y ∈ omegaBox ω M, y - x ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ))) ∧
      omegaBox ω (2 * (⌊M⌋₊ : ℝ)) ⊆ omegaBox ω (2 * M) ∧
      ((omegaBox ω (2 * (⌊M⌋₊ : ℝ))).card : ℝ) ≤ 2 ^ ν * ((omegaBox ω M).card : ℝ) ∧
      (0 : ℝ) < ((omegaBox ω M).card : ℝ) := by
    have hmem : ∀ (R : ℝ) (x : NumberField.RingOfIntegers K),
        x ∈ omegaBox ω R ↔ ∀ k, -(⌊R⌋₊ : ℤ) ≤ ω.equivFun x k ∧ ω.equivFun x k ≤ ⌊R⌋₊ := by
      intro R x
      unfold omegaBox
      rw [Finset.mem_image]
      constructor
      · rintro ⟨v, hv, rfl⟩
        simp only [intBox, Finset.mem_Icc, Pi.le_def] at hv
        intro k
        simp only [LinearEquiv.apply_symm_apply]
        exact ⟨hv.1 k, hv.2 k⟩
      · intro h
        refine ⟨ω.equivFun x, ?_, ω.equivFun.symm_apply_apply x⟩
        simp only [intBox, Finset.mem_Icc, Pi.le_def]
        exact ⟨fun k => (h k).1, fun k => (h k).2⟩
    have hcard : ∀ R : ℝ, (omegaBox ω R).card = (2 * ⌊R⌋₊ + 1) ^ ν := by
      intro R
      unfold omegaBox
