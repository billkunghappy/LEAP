      rw [← hZ₀def]
      have hb1 : (Ideal.absNorm q : ℝ) * (Ideal.absNorm (b k) : ℝ) *
          (1 + kaiHZInfSize K t l) * (2 + |s.im|) ≤ P * X := by
        have hbP : (Ideal.absNorm (b k) : ℝ) ≤ P := by rw [hPdef]; exact (hbk k).2.2.2.2.2
        calc (Ideal.absNorm q : ℝ) * (Ideal.absNorm (b k) : ℝ) *
              (1 + kaiHZInfSize K t l) * (2 + |s.im|)
            = (Ideal.absNorm (b k) : ℝ) * X := by rw [hXdef]; ring
          _ ≤ P * X := mul_le_mul_of_nonneg_right hbP (by linarith)
      have h2 : ((Ideal.absNorm q : ℝ) * (Ideal.absNorm (b k) : ℝ) *
          (1 + kaiHZInfSize K t l) * (2 + |s.im|)) ^ A ≤ (P * X) ^ A := by
        refine Real.rpow_le_rpow ?_ hb1 hA0.le
        have hb0 : (0 : ℝ) ≤ (Ideal.absNorm (b k) : ℝ) := Nat.cast_nonneg _
        exact mul_nonneg (mul_nonneg (mul_nonneg (by linarith) hb0) (by linarith)) (by linarith)
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h2 hA0.le) hZ₀0
    have hnormHf : ‖Hf s‖ ≤ ∑ k : Fin M, ‖Gc k s‖ := by
      rw [hHfdef]
      simp only
      rw [norm_div, Complex.norm_natCast]
      have hpos : (0 : ℝ) < (hh : ℝ) := lt_of_lt_of_le one_pos hhR1
      have hnum : ‖∑ k : Fin M, (starRingEnd ℂ) (lam (b k)) *
          ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s‖ ≤ ∑ k : Fin M, ‖Gc k s‖ := by
        refine le_trans (norm_sum_le _ _) (Finset.sum_le_sum (fun k _ => ?_))
        rw [norm_mul, norm_mul, RCLike.norm_conj, hlamb k, one_mul, hnormcpow k s, hs]
        have hle1 : (Ideal.absNorm (b k) : ℝ) ^ (-(1:ℝ)/2) ≤ 1 :=
          Real.rpow_le_one_of_one_le_of_nonpos (hNB1 k) (by norm_num)
        exact mul_le_of_le_one_left (norm_nonneg _) hle1
      rw [div_le_iff₀ hpos]
      exact hnum.trans (le_mul_of_one_le_right
        (Finset.sum_nonneg (fun k _ => norm_nonneg (Gc k s))) hhR1)
    have hsumbd : (∑ k : Fin M, ‖Gc k s‖) ≤ (M : ℝ) * (A * (P * X) ^ A * Z₀) := by
      have h := Finset.sum_le_sum (fun k (_ : k ∈ Finset.univ) => hcellbd k)
      simpa [Finset.sum_const, Finset.card_univ, nsmul_eq_mul] using h
    have hAPX0 : (0 : ℝ) ≤ A * (P * X) ^ A * Z₀ := by
      have h : (0 : ℝ) ≤ (P * X) ^ A := Real.rpow_nonneg (mul_pos hP0 hX0).le _
      exact mul_nonneg (mul_nonneg hA0.le h) hZ₀0
    have hstep1 : (M : ℝ) * (A * (P * X) ^ A * Z₀) ≤ P * (A * (P * X) ^ A * Z₀) := by
      have hMP : (M : ℝ) ≤ P := by rw [hPdef]; exact hMle
      exact mul_le_mul_of_nonneg_right hMP hAPX0
    have hfinal : P * (A * (P * X) ^ A) ≤ A₃ * X ^ A₃ := by
      have h := kai_mf_edge_constant A Cq (Ideal.absNorm q : ℝ) X A₃ hA1 hCq1 hNQ1 hNqX hA₃big
      rw [← hPdef] at h
      exact h
    have hcollect : P * (A * (P * X) ^ A * Z₀) ≤ A₃ * X ^ A₃ * Z₀ := by
      have hrw : P * (A * (P * X) ^ A * Z₀) = (P * (A * (P * X) ^ A)) * Z₀ := by ring
      rw [hrw]
      exact mul_le_mul_of_nonneg_right hfinal hZ₀0
    linarith
  by_cases hP : KaiHeckePrincipal K q lam
  · refine ⟨1, Hf, kaiMFConeAlpha K, kaiMFConeBeta K t l η, Ca₁,
      le_refl 1, ⟨fun _ => hP, fun _ => rfl⟩, hHfdiff, ?_, halpha, hbeta, hCa₁0,
      hHfstrip, hHfedge⟩
    intro s hs; rw [hHfval s hs]; ring
  · have hHf1' : Hf 1 = 0 := hHf1 hP
    have hGamDiff : ∀ s : ℂ, 0 ≤ s.re →
        DifferentiableAt ℂ (fun z : ℂ => ∏ w : NumberField.InfinitePlace K,
          Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * z + kaiMFConeBeta K t l η w)) s := by
      intro s hs0
      refine DifferentiableAt.fun_finset_prod (fun w _ => ?_)
      have hin : DifferentiableAt ℂ
          (fun z : ℂ => (kaiMFConeAlpha K w : ℂ) * z + kaiMFConeBeta K t l η w) s :=
        (differentiableAt_id.const_mul _).add_const _
      have hre : 0 < ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w).re := by
        have hrw : ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w).re
