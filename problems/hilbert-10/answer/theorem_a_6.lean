  have hparA : ∑ ξ : ZMod P, ‖Ah ξ‖ ^ 2 = (P : ℝ) * A₁.card := by rw [hAh]; exact hpar A₁
  have hparL : ∑ ξ : ZMod P, ‖Lh ξ‖ ^ 2 = (P : ℝ) * L.card := by rw [hLh]; exact hpar L
