    ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
      if η w then ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) else 1
  have hS1 : ∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 → S (x * y) = S x * S y :=
    fun x y hx hy => (hsignS x y hx hy).1
  have hS2 : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → S x * S x = 1 :=
    fun x hx => (hsignS x x hx hx).2.1
  have hS3 : ∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 →
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) → S x = S y :=
    fun x y hx hy h => (hsignS x y hx hy).2.2 h
  have htwS : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K))
      (ξ₀ : ((NumberField.RingOfIntegers K ⧸ 𝔞)ˣ) →* Circle) (x : NumberField.RingOfIntegers K)
      (u : (NumberField.RingOfIntegers K ⧸ 𝔞)ˣ),
      Ideal.Quotient.mk 𝔞 x = (u : NumberField.RingOfIntegers K ⧸ 𝔞) →
      kaiHeckeTwist K 𝔞 0 0 ξ₀ η x = (ξ₀ u : ℂ) * S x :=
    fun 𝔞 ξ₀ x u h => (htw_gen 𝔞 ξ₀ x).1 u h
  have hS1' : S 1 = 1 := by
    have e := hS1 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at e
    exact e.trans (hS2 1 one_ne_zero)
  have hlamne : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → Ideal.span {x} ⊔ q = ⊤ →
      ‖lam (Ideal.span {x})‖ = 1 := fun x hx hxq =>
    hext.2.2.1 _ (by rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hx) hxq
  have hSnorm : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → ‖S x‖ = 1 := by
    intro x hx
    have e := congrArg norm (hS2 x hx)
    rw [norm_mul, norm_one] at e
    rcases mul_self_eq_one_iff.mp e with h | h
    · exact h
    · linarith [norm_nonneg (S x)]
  
  obtain ⟨ξ', hξ'⟩ : ∃ ξ' : ((NumberField.RingOfIntegers K ⧸ 𝔡)ˣ) →* Circle,
      ∀ (x : NumberField.RingOfIntegers K) (u : (NumberField.RingOfIntegers K ⧸ 𝔡)ˣ),
        x ≠ 0 → Ideal.span {x} ⊔ q = ⊤ →
        Ideal.Quotient.mk 𝔡 x = (u : NumberField.RingOfIntegers K ⧸ 𝔡) →
        (ξ' u : ℂ) = lam (Ideal.span {x}) * S x := by
    choose X hX0 hXmk hXq using hN5
    have hWD : ∀ (u : (NumberField.RingOfIntegers K ⧸ 𝔡)ˣ) (x : NumberField.RingOfIntegers K),
        x ≠ 0 → Ideal.span {x} ⊔ q = ⊤ →
        Ideal.Quotient.mk 𝔡 x = (u : NumberField.RingOfIntegers K ⧸ 𝔡) →
        lam (Ideal.span {X u}) * S (X u) = lam (Ideal.span {x}) * S x := by
      intro u x hx hxq hxu
      obtain ⟨z, hz0, hzX, hzsg⟩ := hN4 (X u) x hx
      obtain ⟨v, hv⟩ := (htw_gen q ξ (X u)).2.1 (hXq u)
      have hzv : Ideal.Quotient.mk q z = (v : NumberField.RingOfIntegers K ⧸ q) := by
        rw [← hv, Ideal.Quotient.eq]; exact hzX
      have hzq : Ideal.span {z} ⊔ q = ⊤ := cop_cong q z (X u) hzX (hXq u)
      have hlz : lam (Ideal.span {z}) = (ξ v : ℂ) * S z := by
        rw [hext.2.2.2.2.2 z hz0]; exact htwS q ξ z v hzv
      have hlX : lam (Ideal.span {X u}) = (ξ v : ℂ) * S (X u) := by
        rw [hext.2.2.2.2.2 _ (hX0 u)]; exact htwS q ξ (X u) v hv
      have hzx : z - x ∈ 𝔡 := by
        have h1 : X u - x ∈ 𝔡 := by rw [← Ideal.Quotient.eq, hXmk u, hxu]
        have e : z - x = (z - X u) + (X u - x) := by ring
        rw [e]; exact 𝔡.add_mem (hqd hzX) h1
      have hlzx : lam (Ideal.span {z}) = lam (Ideal.span {x}) :=
        hper z x (Ideal.isCoprime_iff_sup_eq.mpr hzq) (Ideal.isCoprime_iff_sup_eq.mpr hxq) hzx hzsg
      rw [← hlzx, ← hS3 z x hz0 hx hzsg, hlz, hlX]
      calc (ξ v : ℂ) * S (X u) * S (X u) = (ξ v : ℂ) * (S (X u) * S (X u)) := by ring
        _ = (ξ v : ℂ) * (S z * S z) := by rw [hS2 _ (hX0 u), hS2 _ hz0]
        _ = (ξ v : ℂ) * S z * S z := by ring
    have hmem : ∀ u : (NumberField.RingOfIntegers K ⧸ 𝔡)ˣ,
        lam (Ideal.span {X u}) * S (X u) ∈ Submonoid.unitSphere ℂ := by
      intro u
      show _ ∈ Metric.sphere (0 : ℂ) 1
      rw [mem_sphere_zero_iff_norm, norm_mul, hlamne _ (hX0 u) (hXq u), hSnorm _ (hX0 u), mul_one]
    have hone : lam (Ideal.span {X 1}) * S (X 1) = 1 := by
      rw [hWD 1 1 one_ne_zero (by rw [Ideal.span_singleton_one, top_sup_eq])
        (by rw [map_one, Units.val_one]), Ideal.span_singleton_one, ← Ideal.one_eq_top, hext.1,
        hS1', mul_one]
    have hmul : ∀ u v : (NumberField.RingOfIntegers K ⧸ 𝔡)ˣ,
        lam (Ideal.span {X (u * v)}) * S (X (u * v)) =
          (lam (Ideal.span {X u}) * S (X u)) * (lam (Ideal.span {X v}) * S (X v)) := by
      intro u v
      rw [hWD (u * v) (X u * X v) (mul_ne_zero (hX0 u) (hX0 v))
        (by rw [← Ideal.span_singleton_mul_span_singleton]; exact cop_mul _ _ _ (hXq u) (hXq v))
        (by rw [map_mul, hXmk, hXmk, Units.val_mul]),
        ← Ideal.span_singleton_mul_span_singleton, hext.2.1, hS1 _ _ (hX0 u) (hX0 v)]
      ring
    refine ⟨{ toFun := fun u => ⟨lam (Ideal.span {X u}) * S (X u), hmem u⟩,
              map_one' := ?_, map_mul' := ?_ }, ?_⟩
    · exact Subtype.ext hone
    · intro u v; exact Subtype.ext (hmul u v)
    · intro x u hx hxq hxu
      exact hWD u x hx hxq hxu
  
  obtain ⟨lam', hlam'⟩ : ∃ lam' : Ideal (NumberField.RingOfIntegers K) → ℂ, ∀ I,
      lam' I = if h : I ≠ ⊥ ∧ I ⊔ 𝔡 = ⊤ then lam (Classical.choose (hrepex I h.1 h.2)) else 0 :=
    ⟨_, fun I => rfl⟩
  have hzero' : ∀ I : Ideal (NumberField.RingOfIntegers K), ¬ (I ≠ ⊥ ∧ I ⊔ 𝔡 = ⊤) →
      lam' I = 0 := fun I h => by rw [hlam', dif_neg h]
  have hval' : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ ⊥ → I ⊔ 𝔡 = ⊤ →
      ∃ (J : Ideal (NumberField.RingOfIntegers K)) (γ δ : NumberField.RingOfIntegers K),
        (J ≠ ⊥ ∧ J ⊔ q = ⊤ ∧ γ ≠ 0 ∧ δ ≠ 0 ∧ Ideal.span {γ} ⊔ 𝔡 = ⊤ ∧ γ - δ ∈ 𝔡 ∧
          (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
            0 < NumberField.InfinitePlace.embedding_of_isReal hw (γ : K) *
                NumberField.InfinitePlace.embedding_of_isReal hw (δ : K)) ∧
          Ideal.span {γ} * I = Ideal.span {δ} * J) ∧ lam' I = lam J := by
    intro I hI hI𝔡
    obtain ⟨γ, δ, hR⟩ := Classical.choose_spec (hrepex I hI hI𝔡)
    exact ⟨_, γ, δ, hR, by rw [hlam', dif_pos ⟨hI, hI𝔡⟩]⟩
  have hrepWD : ∀ (I J : Ideal (NumberField.RingOfIntegers K)) (γ δ : NumberField.RingOfIntegers K),
      I ≠ ⊥ → I ⊔ 𝔡 = ⊤ →
      (J ≠ ⊥ ∧ J ⊔ q = ⊤ ∧ γ ≠ 0 ∧ δ ≠ 0 ∧ Ideal.span {γ} ⊔ 𝔡 = ⊤ ∧ γ - δ ∈ 𝔡 ∧
        (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
          0 < NumberField.InfinitePlace.embedding_of_isReal hw (γ : K) *
              NumberField.InfinitePlace.embedding_of_isReal hw (δ : K)) ∧
        Ideal.span {γ} * I = Ideal.span {δ} * J) →
      lam' I = lam J := by
    intro I J γ δ hI hI𝔡 hR
    obtain ⟨hJ, hJq, hγ, hδ, hγ𝔡, hγδ, hsg, heq⟩ := hR
    obtain ⟨JI, γI, δI, ⟨hJI, hJIq, hγI, hδI, hγI𝔡, hγδI, hsgI, heqI⟩, hv⟩ := hval' I hI hI𝔡
    rw [hv]
    have hδI𝔡 : Ideal.span {δI} ⊔ 𝔡 = ⊤ :=
      cop_cong 𝔡 δI γI (by rw [← neg_sub]; exact 𝔡.neg_mem hγδI) hγI𝔡
    refine (hwd J JI hJ hJI hJq hJIq (γI * δ) (γ * δI) (mul_ne_zero hγI hδ) (mul_ne_zero hγ hδI)
      ?_ ?_ ?_ ?_).symm
    · rw [← Ideal.span_singleton_mul_span_singleton]; exact cop_mul _ _ _ hγ𝔡 hδI𝔡
    · have e : γI * δ - γ * δI = γ * (γI - δI) - γI * (γ - δ) := by ring
      rw [e]; exact 𝔡.sub_mem (𝔡.mul_mem_left _ hγδI) (𝔡.mul_mem_left _ hγδ)
    · intro w hw
      rw [coe_mul', coe_mul', map_mul, map_mul]
      have h0 := mul_pos (hsgI w hw) (hsg w hw)
      ring_nf at h0 ⊢
      exact h0
    · rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton]
      calc Ideal.span {γI} * Ideal.span {δ} * J = Ideal.span {γI} * (Ideal.span {δ} * J) := by ring
        _ = Ideal.span {γI} * (Ideal.span {γ} * I) := by rw [← heq]
        _ = Ideal.span {γ} * (Ideal.span {γI} * I) := by ring
        _ = Ideal.span {γ} * (Ideal.span {δI} * JI) := by rw [heqI]
        _ = Ideal.span {γ} * Ideal.span {δI} * JI := by ring
  have hl1 : lam' 1 = 1 := by
    rw [Ideal.one_eq_top, hrepWD ⊤ ⊤ 1 1 top_ne_bot (top_sup_eq 𝔡)
      ⟨top_ne_bot, top_sup_eq q, one_ne_zero, one_ne_zero,
        by rw [Ideal.span_singleton_one, top_sup_eq], by rw [sub_self]; exact 𝔡.zero_mem,
        fun w hw => by simp, rfl⟩, ← Ideal.one_eq_top, hext.1]
  have hnot : ∀ A B : Ideal (NumberField.RingOfIntegers K), ¬ (B ≠ ⊥ ∧ B ⊔ 𝔡 = ⊤) →
      ¬ (A * B ≠ ⊥ ∧ A * B ⊔ 𝔡 = ⊤) := by
    intro A B hB hAB
    apply hB
    exact ⟨fun h => hAB.1 (by rw [h, Ideal.mul_bot]),
      top_unique (hAB.2.symm.le.trans (sup_le_sup_right Ideal.mul_le_left 𝔡))⟩
  have hl2 : ∀ I J : Ideal (NumberField.RingOfIntegers K), lam' (I * J) = lam' I * lam' J := by
    intro I I'
    by_cases hI : I ≠ ⊥ ∧ I ⊔ 𝔡 = ⊤
    · by_cases hI' : I' ≠ ⊥ ∧ I' ⊔ 𝔡 = ⊤
      · obtain ⟨J, γ, δ, ⟨hJ, hJq, hγ, hδ, hγ𝔡, hγδ, hsg, heq⟩, hv⟩ := hval' I hI.1 hI.2
        obtain ⟨J', γ', δ', ⟨hJ', hJ'q, hγ', hδ', hγ'𝔡, hγδ', hsg', heq'⟩, hv'⟩ :=
          hval' I' hI'.1 hI'.2
        rw [hv, hv', ← hext.2.1]
        refine hrepWD (I * I') (J * J') (γ * γ') (δ * δ') ?_ (cop_mul _ _ _ hI.2 hI'.2)
          ⟨?_, cop_mul _ _ _ hJq hJ'q, mul_ne_zero hγ hγ', mul_ne_zero hδ hδ', ?_, ?_, ?_, ?_⟩
        · rw [Ne, Ideal.mul_eq_bot, not_or]; exact ⟨hI.1, hI'.1⟩
        · rw [Ne, Ideal.mul_eq_bot, not_or]; exact ⟨hJ, hJ'⟩
        · rw [← Ideal.span_singleton_mul_span_singleton]; exact cop_mul _ _ _ hγ𝔡 hγ'𝔡
        · have e : γ * γ' - δ * δ' = γ * (γ' - δ') + δ' * (γ - δ) := by ring
          rw [e]; exact 𝔡.add_mem (𝔡.mul_mem_left _ hγδ') (𝔡.mul_mem_left _ hγδ)
        · intro w hw
          rw [coe_mul', coe_mul', map_mul, map_mul]
          have h0 := mul_pos (hsg w hw) (hsg' w hw)
          ring_nf at h0 ⊢
          exact h0
        · rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton]
          calc Ideal.span {γ} * Ideal.span {γ'} * (I * I')
              = (Ideal.span {γ} * I) * (Ideal.span {γ'} * I') := by ring
            _ = (Ideal.span {δ} * J) * (Ideal.span {δ'} * J') := by rw [heq, heq']
            _ = Ideal.span {δ} * Ideal.span {δ'} * (J * J') := by ring
      · rw [hzero' I' hI', mul_zero, hzero' _ (hnot I I' hI')]
    · rw [hzero' I hI, zero_mul, mul_comm I I', hzero' _ (hnot I' I hI)]
  have hl3 : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ 𝔡 = ⊤ → ‖lam' I‖ = 1 := by
    intro I hI hI𝔡
    obtain ⟨J, γ, δ, ⟨hJ, hJq, -⟩, hv⟩ := hval' I hI hI𝔡
    rw [hv]; exact hext.2.2.1 J hJ hJq
  have hl4 : ∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ 𝔡 ≠ ⊤ → lam' I = 0 :=
    fun I hI => hzero' I (fun h => hI h.2)
  have hl5 : lam' 0 = 0 := hzero' 0 (fun h => h.1 rfl)
  have hl6 : ∀ I : Ideal (NumberField.RingOfIntegers K), lam' I = (starRingEnd ℂ) (lam' I) := by
    intro I
    by_cases h : I ≠ ⊥ ∧ I ⊔ 𝔡 = ⊤
    · obtain ⟨J, γ, δ, -, hv⟩ := hval' I h.1 h.2
      rw [hv]; exact hreal J
    · rw [hzero' I h, map_zero]
  have hl7 : ∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q = ⊤ → lam' I = lam I := by
    intro I hIq
    by_cases hI0 : I = ⊥
    · subst hI0
      rw [hzero' ⊥ (fun h => h.1 rfl)]
      exact hext.2.2.2.2.1.symm
    · exact hrepWD I I 1 1 hI0 (cop_mono I hIq)
        ⟨hI0, hIq, one_ne_zero, one_ne_zero, by rw [Ideal.span_singleton_one, top_sup_eq],
          by rw [sub_self]; exact 𝔡.zero_mem, fun w hw => by simp, rfl⟩
  
  have cop_cancel : ∀ y z : NumberField.RingOfIntegers K, Ideal.span {y} ⊔ 𝔡 = ⊤ →
      y * z ∈ 𝔡 → z ∈ 𝔡 := by
    intro y z hy hyz
    have h2 : (1 : NumberField.RingOfIntegers K) ∈ Ideal.span {y} ⊔ 𝔡 := by
      rw [hy]; exact Submodule.mem_top
    obtain ⟨a, ha, d, hd, had⟩ := Submodule.mem_sup.mp h2
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have e : z = r * (y * z) + d * z := by linear_combination (-z) * had
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hyz) (Ideal.mul_mem_right _ _ hd)
  have h6 : ∀ α : NumberField.RingOfIntegers K, α ≠ 0 →
      lam' (Ideal.span {α}) = kaiHeckeTwist K 𝔡 0 0 ξ' η α := by
    intro α hα
    by_cases hα𝔡 : Ideal.span {α} ⊔ 𝔡 = ⊤
    swap
    · rw [hl4 _ hα𝔡]; exact ((htw_gen 𝔡 ξ' α).2.2 hα𝔡).symm
    have hαne : Ideal.span {α} ≠ ⊥ := by rw [Ne, Ideal.span_singleton_eq_bot]; exact hα
    obtain ⟨J, γ, δ, hJ, hJq, hγ, hδ, hγ𝔡, hγδ, hsg, heq⟩ := hrepex _ hαne hα𝔡
    rw [hrepWD _ J γ δ hαne hα𝔡 ⟨hJ, hJq, hγ, hδ, hγ𝔡, hγδ, hsg, heq⟩]
    obtain ⟨j, hjJ, hj0, hjq⟩ := goodj J hJ hJq
    have hdj : δ * j ∈ Ideal.span {γ * α} := by
      have h0 : δ * j ∈ Ideal.span {δ} * J :=
        Ideal.mul_mem_mul (Ideal.mem_span_singleton_self δ) hjJ
      rwa [← heq, Ideal.span_singleton_mul_span_singleton] at h0
    obtain ⟨x'', hx''⟩ := Ideal.mem_span_singleton'.mp hdj
    have hδne : Ideal.span {δ} ≠ ⊥ := by rw [Ne, Ideal.span_singleton_eq_bot]; exact hδ
    have hspan : Ideal.span {j} = Ideal.span {x''} * J := by
      apply mul_left_cancel₀ hδne
      calc Ideal.span {δ} * Ideal.span {j} = Ideal.span {δ * j} :=
            Ideal.span_singleton_mul_span_singleton δ j
        _ = Ideal.span {x''} * (Ideal.span {γ} * Ideal.span {α}) := by
            rw [← hx'', ← Ideal.span_singleton_mul_span_singleton,
              ← Ideal.span_singleton_mul_span_singleton]
        _ = Ideal.span {x''} * (Ideal.span {δ} * J) := by rw [heq]
        _ = Ideal.span {δ} * (Ideal.span {x''} * J) := by ring
    have hx''0 : x'' ≠ 0 := by
      rintro rfl
      rw [Ideal.span_singleton_eq_bot.mpr rfl, Ideal.bot_mul, Ideal.span_singleton_eq_bot] at hspan
      exact hj0 hspan
    have hx''q : Ideal.span {x''} ⊔ q = ⊤ := by
      have hle : Ideal.span {j} ≤ Ideal.span {x''} := by rw [hspan]; exact Ideal.mul_le_right
      exact top_unique (hjq.symm.le.trans (sup_le_sup_right hle q))
    have hlj : lam (Ideal.span {j}) = lam (Ideal.span {x''}) * lam J := by rw [hspan, hext.2.1]
    have hjα : j - α * x'' ∈ 𝔡 := by
      apply cop_cancel γ _ hγ𝔡
      have e : γ * (j - α * x'') = j * (γ - δ) := by linear_combination -hx''
      rw [e]; exact 𝔡.mul_mem_left _ hγδ
    obtain ⟨a, ha⟩ := (htw_gen 𝔡 ξ' α).2.1 hα𝔡
    obtain ⟨b, hb⟩ := (htw_gen 𝔡 ξ' x'').2.1 (cop_mono _ hx''q)
    have hjab : Ideal.Quotient.mk 𝔡 j =
        ((a * b : (NumberField.RingOfIntegers K ⧸ 𝔡)ˣ) : NumberField.RingOfIntegers K ⧸ 𝔡) := by
      rw [Units.val_mul, ← ha, ← hb, ← map_mul, Ideal.Quotient.eq]; exact hjα
    have hξj := hξ' j (a * b) hj0 hjq hjab
    have hξx := hξ' x'' b hx''0 hx''q hb
    have hSj : S j = S x'' * S α := by
      have e1 := congrArg S hx''
      rw [hS1 _ _ hx''0 (mul_ne_zero hγ hα), hS1 _ _ hγ hα, hS1 _ _ hδ hj0,
        hS3 γ δ hγ hδ hsg] at e1
      have hδ2 := hS2 δ hδ
      calc S j = (S δ * S δ) * S j := by rw [hδ2, one_mul]
        _ = S δ * (S δ * S j) := by ring
        _ = S δ * (S x'' * (S δ * S α)) := by rw [e1]
        _ = (S δ * S δ) * (S x'' * S α) := by ring
        _ = S x'' * S α := by rw [hδ2, one_mul]
    have hab : (ξ' (a * b) : ℂ) = (ξ' a : ℂ) * (ξ' b : ℂ) := by rw [map_mul, Circle.coe_mul]
    have hξa : (ξ' a : ℂ) = lam J * S α := by
      apply mul_right_cancel₀ (Circle.coe_ne_zero (ξ' b))
      rw [← hab, hξj, hξx, hlj, hSj]; ring
    rw [htwS 𝔡 ξ' α a ha, hξa, mul_assoc, hS2 α hα, mul_one]
  exact ⟨ξ', η, lam', ⟨hl1, hl2, hl3, hl4, hl5, h6⟩, hl6, hl7⟩

theorem kai_realRayChar_of_heckeExt (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ ⊤)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hext : KaiHeckeExt K q 0 0 ξ η lam)
    (hreal : ∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) :
    ∃ ψ : NumberField.RingOfIntegers K → ℤ,
      (∀ x, ψ x = 1 ∨ ψ x = -1 ∨ ψ x = 0) ∧
      (∀ x, ψ x = 0 ↔ ¬ IsCoprime (Ideal.span {x}) q) ∧
      (∀ x y, ψ (x * y) = ψ x * ψ y) ∧
      (∀ (u : (NumberField.RingOfIntegers K)ˣ) x,
        ψ ((u : NumberField.RingOfIntegers K) * x) = ψ x) ∧
      (∀ x y : NumberField.RingOfIntegers K, x - y ∈ q →
        (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
          0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
              NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) →
        ψ x = ψ y) ∧
      (∀ x : NumberField.RingOfIntegers K, x ≠ 0 → IsCoprime (Ideal.span {x}) q →
        lam (Ideal.span {x}) = ((ψ x : ℤ) : ℂ)) ∧
      ψ ≠ 0 :=
by
  classical
  obtain ⟨h1, hmul, hnorm, -, -, htwist⟩ := hext
  
  have htw : ∀ x y : NumberField.RingOfIntegers K, x - y ∈ q →
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) →
      kaiHeckeTwist K q 0 0 ξ η x = kaiHeckeTwist K q 0 0 ξ η y := by
    intro x y hxy hsg
    have hm : Ideal.Quotient.mk q x = Ideal.Quotient.mk q y := Ideal.Quotient.eq.mpr hxy
    have hsign : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        Real.sign ((NumberField.mixedEmbedding K (x : K)).1 w)
          = Real.sign ((NumberField.mixedEmbedding K (y : K)).1 w) := by
      intro w
      rw [NumberField.mixedEmbedding.mixedEmbedding_apply_isReal,
        NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
      rcases mul_pos_iff.mp (hsg w.1 w.2) with ⟨ha, hb⟩ | ⟨ha, hb⟩
      · rw [Real.sign_of_pos ha, Real.sign_of_pos hb]
      · rw [Real.sign_of_neg ha, Real.sign_of_neg hb]
    unfold kaiHeckeTwist
    by_cases hu : IsUnit (Ideal.Quotient.mk q x)
    · have hu' : IsUnit (Ideal.Quotient.mk q y) := hm ▸ hu
      rw [dif_pos hu, dif_pos hu']
      have hun : hu.unit = hu'.unit := Units.ext (by simp [hm])
      simp only [hun, hsign, Pi.zero_apply, Complex.ofReal_zero, zero_mul,
        Finset.sum_const_zero, mul_zero, Complex.exp_zero, Int.cast_zero, Finset.prod_const_one]
    · have hu' : ¬ IsUnit (Ideal.Quotient.mk q y) := hm ▸ hu
      rw [dif_neg hu, dif_neg hu']
  
  have hcop : ∀ a b : NumberField.RingOfIntegers K, a - b ∈ q →
      IsCoprime (Ideal.span {a}) q → IsCoprime (Ideal.span {b}) q := by
    intro a b hab ha
    rw [Ideal.isCoprime_iff_sup_eq] at ha ⊢
    apply top_unique
    rw [← ha]
    apply sup_le _ le_sup_right
    rw [Ideal.span_singleton_le_iff_mem]
    have hab' : a = b + (a - b) := by ring
    rw [hab']
    exact add_mem (Ideal.mem_sup_left (Ideal.mem_span_singleton_self b)) (Ideal.mem_sup_right hab)
  have hcopnz : ∀ x : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {x}) q → x ≠ 0 := by
    intro x hx h0
    rw [h0, Ideal.span_singleton_eq_bot.mpr rfl, Ideal.isCoprime_iff_sup_eq, bot_sup_eq] at hx
    exact hq hx
  obtain ⟨ψ, hψ⟩ : ∃ ψ : NumberField.RingOfIntegers K → ℤ, ∀ x, ψ x =
      if IsCoprime (Ideal.span {x}) q then
        (if lam (Ideal.span {x}) = 1 then (1 : ℤ) else -1) else 0 := ⟨_, fun _ => rfl⟩
  have hR : ∀ x : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {x}) q →
      lam (Ideal.span {x}) = ((ψ x : ℤ) : ℂ) := by
    intro x hx
    have hx0 := hcopnz x hx
    have hsp0 : Ideal.span {x} ≠ 0 := by
      rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hx0
    have hn := hnorm _ hsp0 (Ideal.isCoprime_iff_sup_eq.mp hx)
    have hre : (((lam (Ideal.span {x})).re : ℝ) : ℂ) = lam (Ideal.span {x}) :=
      Complex.conj_eq_iff_re.mp (hreal (Ideal.span {x})).symm
    have habs : |(lam (Ideal.span {x})).re| = 1 := by
      have := congrArg norm hre
      rw [Complex.norm_real, Real.norm_eq_abs, hn] at this
      exact this
    rcases (abs_eq zero_le_one).mp habs with h | h
    · have hl : lam (Ideal.span {x}) = 1 := by rw [← hre, h, Complex.ofReal_one]
      rw [hψ, if_pos hx, if_pos hl, hl]
      simp
    · have hl : lam (Ideal.span {x}) = -1 := by
        rw [← hre, h, Complex.ofReal_neg, Complex.ofReal_one]
      have hne : lam (Ideal.span {x}) ≠ 1 := by rw [hl]; norm_num
      rw [hψ, if_pos hx, if_neg hne, hl]
      simp
  refine ⟨ψ, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    rw [hψ]
    split_ifs <;> simp
  · intro x
    rw [hψ]
    split_ifs with hc hl <;> simp [hc]
  · intro x y
    have hsp : Ideal.span {x * y} = Ideal.span {x} * Ideal.span {y} :=
      (Ideal.span_singleton_mul_span_singleton x y).symm
    by_cases hx : IsCoprime (Ideal.span {x}) q
    · by_cases hy : IsCoprime (Ideal.span {y}) q
      · have hxy : IsCoprime (Ideal.span {x * y}) q := by rw [hsp]; exact hx.mul_left hy
        apply Int.cast_injective (α := ℂ)
        rw [Int.cast_mul, ← hR _ hxy, ← hR _ hx, ← hR _ hy, hsp, hmul]
      · have hxy : ¬ IsCoprime (Ideal.span {x * y}) q := by
          rw [hsp]; exact fun h => hy (IsCoprime.mul_left_iff.mp h).2
        rw [hψ (x * y), if_neg hxy, hψ y, if_neg hy, mul_zero]
    · have hxy : ¬ IsCoprime (Ideal.span {x * y}) q := by
        rw [hsp]; exact fun h => hx (IsCoprime.mul_left_iff.mp h).1
      rw [hψ (x * y), if_neg hxy, hψ x, if_neg hx, zero_mul]
  · intro u x
    rw [hψ, hψ x, Ideal.span_singleton_mul_left_unit u.isUnit x]
  · intro x y hxy hsg
    have hyx : y - x ∈ q := by rw [← neg_sub]; exact q.neg_mem hxy
    by_cases hx : IsCoprime (Ideal.span {x}) q
    · have hy := hcop x y hxy hx
      have heq : lam (Ideal.span {x}) = lam (Ideal.span {y}) := by
        rw [htwist x (hcopnz x hx), htwist y (hcopnz y hy)]
        exact htw x y hxy hsg
      rw [hψ x, hψ y, if_pos hx, if_pos hy, heq]
    · have hy : ¬ IsCoprime (Ideal.span {y}) q := fun h => hx (hcop y x hyx h)
      rw [hψ x, hψ y, if_neg hx, if_neg hy]
  · intro x _ hx
    exact hR x hx
  · intro h
    have h1' : ψ 1 = 0 := by rw [h]; rfl
    have hc1 : IsCoprime (Ideal.span {(1 : NumberField.RingOfIntegers K)}) q := by
      rw [Ideal.span_singleton_one, Ideal.isCoprime_iff_sup_eq, top_sup_eq]
    have hl1 : lam (Ideal.span {(1 : NumberField.RingOfIntegers K)}) = 1 := by
      rw [Ideal.span_singleton_one, ← Ideal.one_eq_top, h1]
    rw [hψ, if_pos hc1, if_pos hl1] at h1'
    exact one_ne_zero h1'

theorem kai_exceptional_datum (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ B₀ : ℝ, 0 < B₀ ∧ B₀ ≤ 1 / 2 ∧
    ∃ (𝔮F : ℝ → Ideal (NumberField.RingOfIntegers K))
      (ψF : ℝ → NumberField.RingOfIntegers K → ℤ) (βF : ℝ → ℝ)
      (lamF : ℝ → Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ Q : ℝ, 3 ≤ Q → IsLPExceptional K B₀ Q (𝔮F Q) (ψF Q) (βF Q) (lamF Q)) ∧
      (∀ A : ℕ, ∃ cA : ℝ, 0 < cA ∧ ∀ Q : ℝ, 3 ≤ Q → ψF Q ≠ 0 →
        cA * Real.log Q ^ A ≤ (Ideal.absNorm (𝔮F Q) : ℝ)) :=
by
  classical
  obtain ⟨A₀, -, hcont⟩ := kai_hecke_zeta_continuation K
  obtain ⟨B₁, hB₁, hsieg1⟩ := kai_hecke_siegel_00 K 1 one_pos
  obtain ⟨B_P, hB_P, hpage⟩ := kai_page_uniqueness K
  obtain ⟨B₀, hB₀def⟩ : ∃ B₀ : ℝ, B₀ = min (min B_P B₁) (1 / 2) := ⟨_, rfl⟩
  have hB₀pos : 0 < B₀ := by rw [hB₀def]; exact lt_min (lt_min hB_P hB₁) (by norm_num)
  have hB₀half : B₀ ≤ 1 / 2 := by rw [hB₀def]; exact min_le_right _ _
  have hB₀P : B₀ ≤ B_P := by rw [hB₀def]; exact (min_le_left _ _).trans (min_le_left _ _)
  have hB₀1 : B₀ ≤ B₁ := by rw [hB₀def]; exact (min_le_left _ _).trans (min_le_right _ _)
  have hzb : (0 : Ideal (NumberField.RingOfIntegers K)) = ⊥ := rfl
  
  have hlogQ : ∀ Q : ℝ, 3 ≤ Q → 1 < Real.log Q := by
    intro Q hQ
    rw [Real.lt_log_iff_exp_lt (by linarith)]
    have := Real.exp_one_lt_d9
    linarith
  
  have hcont0 : ∀ (q : Ideal (NumberField.RingOfIntegers K)), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam → ¬ KaiHeckePrincipal K q lam →
        ∃ G : ℂ → ℂ, Differentiable ℂ G ∧
          ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s := by
    intro q hq ξ η lam hext hnp
    obtain ⟨E, G, hE1, hEiff, hG, -, hser, -⟩ := hcont q hq 0 0 ξ η lam hext (by simp)
    have hE0 : E = 0 := by
      have : E ≠ 1 := fun h => hnp (hEiff.mp h)
      omega
    refine ⟨G, hG, fun s hs => ?_⟩
    have h := hser s hs
    rw [hE0, pow_zero, mul_one] at h
    exact h
  
  have hident : ∀ (lam : Ideal (NumberField.RingOfIntegers K) → ℂ) (G G' : ℂ → ℂ),
      Differentiable ℂ G → Differentiable ℂ G' →
      (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s) →
      (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G' s) → G = G' := by
    intro lam G G' hG hG' h h'
    have hU : IsOpen {s : ℂ | 1 < s.re} := isOpen_lt continuous_const Complex.continuous_re
    have h2 : (2 : ℂ) ∈ {s : ℂ | 1 < s.re} := by
      show (1 : ℝ) < (2 : ℂ).re
      norm_num
    have heq : G =ᶠ[nhds (2 : ℂ)] G' :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds h2) (fun s hs => (h s hs).symm.trans (h' s hs))
    exact AnalyticOnNhd.eq_of_eventuallyEq (hG.differentiableOn.analyticOnNhd isOpen_univ)
      (hG'.differentiableOn.analyticOnNhd isOpen_univ) heq
  have hsupmul : ∀ I a b : Ideal (NumberField.RingOfIntegers K),
      I ⊔ a = ⊤ → I ⊔ b = ⊤ → I ⊔ a * b = ⊤ := by
    intro I a b ha hb
    exact Ideal.isCoprime_iff_sup_eq.mp
      ((Ideal.isCoprime_iff_sup_eq.mpr ha).mul_right (Ideal.isCoprime_iff_sup_eq.mpr hb))
  
  have hMC : ∀ Q : ℝ, ∃ (𝔮 : Ideal (NumberField.RingOfIntegers K))
      (ψ : NumberField.RingOfIntegers K → ℤ) (β : ℝ)
      (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      3 ≤ Q → IsLPExceptional K B₀ Q 𝔮 ψ β lam := by
    intro Q
    by_cases hQ : 3 ≤ Q
    swap
    · exact ⟨⊤, 0, 1 / 2, fun _ => 0, fun h => absurd h hQ⟩
    have hL1 : 1 < Real.log Q := hlogQ Q hQ
    have hLpos : 0 < Real.log Q := by linarith
    have hB₀L : B₀ / Real.log Q < B₀ := div_lt_self hB₀pos hL1
    by_cases hex : ∃ n : ℕ, ∃ (q : Ideal (NumberField.RingOfIntegers K))
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ) (G : ℂ → ℂ) (β : ℝ),
        q ≠ 0 ∧ Ideal.absNorm q = n ∧ (n : ℝ) ≤ Q ∧ KaiHeckeExt K q 0 0 ξ η lam ∧
        (∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) ∧
        ¬ KaiHeckePrincipal K q lam ∧ Differentiable ℂ G ∧
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s) ∧
        1 - B₀ / Real.log Q ≤ β ∧ β < 1 ∧ G (β : ℂ) = 0
    swap
    · 
      refine ⟨⊤, 0, 1 / 2, fun _ => 0, fun _ => ⟨top_ne_bot, Or.inl rfl, ?_⟩⟩
      intro q hq hNq ξ' η' lam' hext' hreal' hnp' G' hG' heq' β' h1 h2 hz
      exact absurd ⟨_, q, ξ', η', lam', G', β', hq, rfl, hNq, hext', hreal', hnp', hG', heq',
        h1, h2, hz⟩ hex
    
    obtain ⟨q₀, ξ₀, η₀, lam₀, G₀, β₀, hq₀, hN₀, hn₀Q, hext₀, hreal₀, hnp₀, hG₀, heq₀, hβl, hβu,
      hz₀⟩ := Nat.find_spec hex
    have hNQ : (Ideal.absNorm q₀ : ℝ) ≤ Q := by rw [hN₀]; exact hn₀Q
    have hβ0 : 0 < β₀ := by
      have : B₀ / Real.log Q ≤ 1 / 2 := hB₀L.le.trans hB₀half
      linarith
    
    have hq₀top : q₀ ≠ ⊤ := by
      intro htop
      have hN1 : (Ideal.absNorm q₀ : ℝ) = 1 := by
        rw [htop, Ideal.absNorm_top]; norm_num
      refine hsieg1 q₀ hq₀ ξ₀ η₀ lam₀ hext₀ hnp₀ hreal₀ G₀ hG₀ heq₀ β₀ ?_ hβu hz₀
      rw [hN1, Real.one_rpow, mul_one]
      linarith
    
    obtain ⟨ψ₀, C1, C2, C3, C4, C5, Agr, hψ₀⟩ :=
      kai_realRayChar_of_heckeExt K q₀ hq₀top ξ₀ η₀ lam₀ hext₀ hreal₀
    
    have F3 : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q₀ = ⊤ →
        lam₀ I * lam₀ I = 1 := by
      intro I hI hIq
      have h1 : ‖lam₀ I‖ = 1 := hext₀.2.2.1 I hI hIq
      have h2 : lam₀ I * (starRingEnd ℂ) (lam₀ I) = ((Complex.normSq (lam₀ I) : ℝ) : ℂ) :=
        Complex.mul_conj _
      rw [← hreal₀ I, Complex.normSq_eq_norm_sq, h1] at h2
      simpa using h2
    have hcopnz : ∀ x : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {x}) q₀ → x ≠ 0 := by
      intro x hx h0
      rw [h0, Ideal.span_singleton_eq_bot.mpr rfl, Ideal.isCoprime_iff_sup_eq, bot_sup_eq] at hx
      exact hq₀top hx
    
    have prim : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), q₀ < 𝔡 →
        ∃ x y : NumberField.RingOfIntegers K,
          IsCoprime (Ideal.span {x}) q₀ ∧ IsCoprime (Ideal.span {y}) q₀ ∧ x - y ∈ 𝔡 ∧
          (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
            0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
                NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) ∧
          ψ₀ x ≠ ψ₀ y := by
      intro 𝔡 h𝔡
      by_contra hcon
      push_neg at hcon
      have hper : ∀ x y : NumberField.RingOfIntegers K,
          IsCoprime (Ideal.span {x}) q₀ → IsCoprime (Ideal.span {y}) q₀ → x - y ∈ 𝔡 →
          (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
            0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
                NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) →
          lam₀ (Ideal.span {x}) = lam₀ (Ideal.span {y}) := by
        intro x y hx hy hxy hsg
        rw [Agr x (hcopnz x hx) hx, Agr y (hcopnz y hy) hy, hcon x y hx hy hxy hsg]
      obtain ⟨ξ'', η'', lam'', hext'', hreal'', hagr''⟩ :=
        kai_hecke_descent K q₀ 𝔡 hq₀ h𝔡.le ξ₀ η₀ lam₀ hext₀ hreal₀ hper
      have h𝔡0 : 𝔡 ≠ 0 := by
        intro h
        rw [h, hzb] at h𝔡
        exact not_lt_bot h𝔡
      have hnp'' : ¬ KaiHeckePrincipal K 𝔡 lam'' := by
        intro hpr
        apply hnp₀
        intro I hI hIq
        have hI𝔡 : I ⊔ 𝔡 = ⊤ := top_unique (hIq.symm.le.trans (sup_le_sup_left h𝔡.le I))
        rw [← hagr'' I hIq]
        exact hpr I hI hI𝔡
      obtain ⟨G'', hG'', heq''⟩ := hcont0 𝔡 h𝔡0 ξ'' η'' lam'' hext'' hnp''
      have hprin : KaiHeckePrincipal K (q₀ * 𝔡) (fun I => lam₀ I * lam'' I) := by
        intro I hI hIq
        have hIq₀ : I ⊔ q₀ = ⊤ :=
          top_unique (hIq.symm.le.trans (sup_le_sup_left Ideal.mul_le_right I))
        show lam₀ I * lam'' I = 1
        rw [hagr'' I hIq₀]
        exact F3 I hI hIq₀
      have hz'' : G'' (β₀ : ℂ) = 0 :=
        kai_hecke_zero_transfer K q₀ 𝔡 hq₀ h𝔡0 ξ₀ η₀ lam₀ ξ'' η'' lam'' hext₀ hext'' hprin
          G₀ G'' hG₀ hG'' heq₀ heq'' β₀ hβ0 hβu hz₀
      obtain ⟨𝔠, h𝔠⟩ : 𝔡 ∣ q₀ := Ideal.dvd_iff_le.mpr h𝔡.le
      have h𝔠top : 𝔠 ≠ ⊤ := by
        intro h
        rw [h, Ideal.mul_top] at h𝔠
        exact h𝔡.ne h𝔠
      have h𝔠bot : 𝔠 ≠ ⊥ := by
        intro h
        rw [h, Ideal.mul_bot] at h𝔠
        exact hq₀ (h𝔠.trans hzb.symm)
      have hNmul : Ideal.absNorm q₀ = Ideal.absNorm 𝔡 * Ideal.absNorm 𝔠 := by
        rw [h𝔠, map_mul]
      have hc1 : Ideal.absNorm 𝔠 ≠ 1 := fun h => h𝔠top (Ideal.absNorm_eq_one_iff.mp h)
      have hc0 : Ideal.absNorm 𝔠 ≠ 0 := fun h => h𝔠bot (Ideal.absNorm_eq_zero_iff.mp h)
      have hd0 : Ideal.absNorm 𝔡 ≠ 0 :=
        fun h => h𝔡0 ((Ideal.absNorm_eq_zero_iff.mp h).trans hzb.symm)
      have hlt : Ideal.absNorm 𝔡 < Nat.find hex := by
        rw [← hN₀, hNmul]
        have h2 : 2 ≤ Ideal.absNorm 𝔠 := by omega
        have h1 : 1 ≤ Ideal.absNorm 𝔡 := Nat.one_le_iff_ne_zero.mpr hd0
        nlinarith
      have hdQ : ((Ideal.absNorm 𝔡 : ℕ) : ℝ) ≤ Q := by
        have : ((Ideal.absNorm 𝔡 : ℕ) : ℝ) ≤ ((Nat.find hex : ℕ) : ℝ) := by
          exact_mod_cast hlt.le
        linarith
      exact Nat.find_min hex hlt ⟨𝔡, ξ'', η'', lam'', G'', β₀, h𝔡0, rfl, hdQ, hext'', hreal'',
        hnp'', hG'', heq'', hβl, hβu, hz''⟩
    
    refine ⟨q₀, ψ₀, β₀, lam₀, fun _ => ⟨?_, Or.inr ⟨⟨C1, C2, C3, C4, C5, prim⟩, hNQ, hβl, hβu,
      ⟨ξ₀, η₀, hext₀⟩, hreal₀, hnp₀, Agr, ?_⟩, ?_⟩⟩
    · exact fun h => hq₀ (h.trans hzb.symm)
    · intro G hG heq
      rw [hident lam₀ G G₀ hG hG₀ heq heq₀]
      exact hz₀
    · intro q hq hNq ξ' η' lam' hext' hreal' hnp' G' hG' heq' β' h1 h2 hz
      have hBB : B₀ / Real.log Q ≤ B_P / Real.log Q := div_le_div_of_nonneg_right hB₀P hLpos.le
      have hw₀ : 1 - B_P / Real.log Q ≤ β₀ := by linarith
      have hw' : 1 - B_P / Real.log Q ≤ β' := by linarith
      obtain ⟨hprin, hββ⟩ := hpage Q hQ q₀ q ξ₀ η₀ lam₀ ξ' η' lam' G₀ G' β₀ β' hq₀ hq hNQ hNq
        hext₀ hext' hreal₀ hreal' hnp₀ hnp' hG₀ hG' heq₀ heq' hw₀ hβu hw' h2 hz₀ hz
      refine ⟨hψ₀, hββ.symm, ?_⟩
      intro I hI hIq hIq₀
      have h1' : lam₀ I * lam' I = 1 := hprin I hI (hsupmul I q₀ q hIq₀ hIq)
      have h2' : lam₀ I * lam₀ I = 1 := F3 I hI hIq₀
      have hne : lam₀ I ≠ 0 := by
        intro h
        rw [h, zero_mul] at h2'
        exact zero_ne_one h2'
      exact mul_left_cancel₀ hne (h1'.trans h2'.symm)
  choose 𝔮F ψF βF lamF hF using hMC
  refine ⟨B₀, hB₀pos, hB₀half, 𝔮F, ψF, βF, lamF, fun Q hQ => hF Q hQ, ?_⟩
  
  intro A
  rcases Nat.eq_zero_or_pos A with hA | hA
  · refine ⟨1, one_pos, fun Q hQ _ => ?_⟩
    have hq := (hF Q hQ).1
    have h0 : Ideal.absNorm (𝔮F Q) ≠ 0 := fun h => hq (Ideal.absNorm_eq_zero_iff.mp h)
    have h1 : (1 : ℝ) ≤ (Ideal.absNorm (𝔮F Q) : ℝ) := by
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr h0
    rw [hA, pow_zero, mul_one]
    exact h1
  · have hA0 : (A : ℝ) ≠ 0 := (Nat.cast_pos.mpr hA).ne'
    have hε : (0 : ℝ) < 1 / (A : ℝ) := one_div_pos.mpr (Nat.cast_pos.mpr hA)
    obtain ⟨Bε, hBε, hS⟩ := kai_hecke_siegel_00 K (1 / (A : ℝ)) hε
    refine ⟨(Bε / B₀) ^ A, pow_pos (div_pos hBε hB₀pos) A, fun Q hQ hψ => ?_⟩
    have hL1 : 1 < Real.log Q := hlogQ Q hQ
    have hLpos : 0 < Real.log Q := by linarith
    obtain ⟨hq, hor, -⟩ := hF Q hQ
    rcases hor with h0 | ⟨-, -, hβl, hβu, ⟨ξ, η, hext⟩, hreal, hnp, -, hGall⟩
    · exact absurd h0 hψ
    have hq0 : 𝔮F Q ≠ 0 := fun h => hq (h.trans hzb)
    obtain ⟨G, hG, heq⟩ := hcont0 (𝔮F Q) hq0 ξ η (lamF Q) hext hnp
    have hz := hGall G hG heq
    have h0 : Ideal.absNorm (𝔮F Q) ≠ 0 := fun h => hq (Ideal.absNorm_eq_zero_iff.mp h)
    have hn1 : (1 : ℝ) ≤ (Ideal.absNorm (𝔮F Q) : ℝ) := by
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr h0
    have hn0 : (0 : ℝ) < (Ideal.absNorm (𝔮F Q) : ℝ) := by linarith
    have hle : Bε * ((Ideal.absNorm (𝔮F Q) : ℝ) ^ (-(1 / (A : ℝ)))) ≤ 1 - βF Q := by
      by_contra hcon
      push_neg at hcon
      exact hS (𝔮F Q) hq0 ξ η (lamF Q) hext hnp hreal G hG heq (βF Q) (by linarith) hβu hz
    have hpos : 0 < (Ideal.absNorm (𝔮F Q) : ℝ) ^ (1 / (A : ℝ)) := Real.rpow_pos_of_pos hn0 _
    rw [Real.rpow_neg hn0.le] at hle
    have hkey : Bε * Real.log Q / B₀ ≤ (Ideal.absNorm (𝔮F Q) : ℝ) ^ (1 / (A : ℝ)) := by
      have h1 : Bε * ((Ideal.absNorm (𝔮F Q) : ℝ) ^ (1 / (A : ℝ)))⁻¹ ≤ B₀ / Real.log Q := by
        linarith
      rw [← div_eq_mul_inv, div_le_div_iff₀ hpos hLpos] at h1
      rw [div_le_iff₀ hB₀pos]
      linarith
    have hpow := pow_le_pow_left₀ (div_nonneg (mul_nonneg hBε.le hLpos.le) hB₀pos.le) hkey A
    rw [← Real.rpow_natCast ((Ideal.absNorm (𝔮F Q) : ℝ) ^ (1 / (A : ℝ))) A,
      ← Real.rpow_mul hn0.le, one_div_mul_cancel hA0, Real.rpow_one] at hpow
    calc (Bε / B₀) ^ A * Real.log Q ^ A = (Bε * Real.log Q / B₀) ^ A := by
          rw [← mul_pow, div_mul_eq_mul_div]
      _ ≤ (Ideal.absNorm (𝔮F Q) : ℝ) := hpow

theorem kai_hecke_extension (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (htr : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0)
    (hinv : ∀ v : (NumberField.RingOfIntegers K)ˣ,
        kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1) :
    ∃ Λ : Fin (NumberField.classNumber K) →
        (Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ j, KaiHeckeExt K q t l ξ η (Λ j)) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → Submodule.IsPrincipal I →
          ∑ j, Λ j I
            = (NumberField.classNumber K : ℂ) * kaiHeckeTwist K q t l ξ η (kaiGen I)) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → ¬ Submodule.IsPrincipal I →
          ∑ j, Λ j I = 0) ∧
      ((∀ y : NumberField.RingOfIntegers K,
            IsUnit (Ideal.Quotient.mk q y) → kaiHeckeTwist K q t l ξ η y = 1) →
          ∃! j, KaiHeckePrincipal K q (Λ j)) ∧
      ((¬ ∀ y : NumberField.RingOfIntegers K,
            IsUnit (Ideal.Quotient.mk q y) → kaiHeckeTwist K q t l ξ η y = 1) →
          ∀ j, ¬ KaiHeckePrincipal K q (Λ j)) :=
by
  classical
  
  have hs1 : kaiHeckeTwist K q t l ξ η 1 = 1 ∧
      (∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 →
          kaiHeckeTwist K q t l ξ η (x * y)
            = kaiHeckeTwist K q t l ξ η x * kaiHeckeTwist K q t l ξ η y) ∧
      (∀ x : NumberField.RingOfIntegers K, x ≠ 0 →
          IsUnit (Ideal.Quotient.mk q x) → ‖kaiHeckeTwist K q t l ξ η x‖ = 1) := by
    have hsign : ∀ a b : ℝ, Real.sign (a * b) = Real.sign a * Real.sign b := by
      intro a b
      rcases lt_trichotomy a 0 with ha | ha | ha
      · rcases lt_trichotomy b 0 with hb | hb | hb
        · rw [Real.sign_of_pos (mul_pos_of_neg_of_neg ha hb), Real.sign_of_neg ha,
            Real.sign_of_neg hb]; ring
        · subst hb; simp
        · rw [Real.sign_of_neg (mul_neg_of_neg_of_pos ha hb), Real.sign_of_neg ha,
            Real.sign_of_pos hb]; ring
      · subst ha; simp
      · rcases lt_trichotomy b 0 with hb | hb | hb
        · rw [Real.sign_of_neg (mul_neg_of_pos_of_neg ha hb), Real.sign_of_pos ha,
            Real.sign_of_neg hb]; ring
        · subst hb; simp
        · rw [Real.sign_of_pos (mul_pos ha hb), Real.sign_of_pos ha, Real.sign_of_pos hb]; ring
    have hsignnorm : ∀ a : ℝ, a ≠ 0 → ‖((Real.sign a : ℝ) : ℂ)‖ = 1 := by
      intro a ha
      rw [Complex.norm_real, Real.norm_eq_abs]
      rcases lt_or_gt_of_ne ha with h | h
      · rw [Real.sign_of_neg h]; norm_num
      · rw [Real.sign_of_pos h]; norm_num
    have hargmul : ∀ (n : ℤ) (u v : ℂ), u ≠ 0 → v ≠ 0 →
        Complex.exp (Complex.I * ((n : ℤ) : ℂ) * ((((u * v).arg) : ℝ) : ℂ))
          = Complex.exp (Complex.I * ((n : ℤ) : ℂ) * ((u.arg : ℝ) : ℂ))
            * Complex.exp (Complex.I * ((n : ℤ) : ℂ) * ((v.arg : ℝ) : ℂ)) := by
      intro n u v hu hv
      have h1 : (((u * v).arg : ℝ) : Real.Angle) = ((u.arg + v.arg : ℝ) : Real.Angle) := by
        rw [Real.Angle.coe_add]
        exact Complex.arg_mul_coe_angle hu hv
      obtain ⟨k, hk⟩ := Real.Angle.angle_eq_iff_two_pi_dvd_sub.mp h1
      have hk' : ((u * v).arg : ℝ) = u.arg + v.arg + 2 * Real.pi * (k : ℝ) := by linarith
      rw [hk']
      have hsplit : Complex.I * ((n : ℤ) : ℂ) *
            (((u.arg + v.arg + 2 * Real.pi * (k : ℝ) : ℝ)) : ℂ)
          = Complex.I * ((n : ℤ) : ℂ) * ((u.arg : ℝ) : ℂ)
            + Complex.I * ((n : ℤ) : ℂ) * ((v.arg : ℝ) : ℂ)
            + (((n * k : ℤ)) : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
        push_cast; ring
      rw [hsplit, Complex.exp_add, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
    have hexpnorm : ∀ (n : ℤ) (r : ℝ),
        ‖Complex.exp (Complex.I * ((n : ℤ) : ℂ) * ((r : ℝ) : ℂ))‖ = 1 := by
      intro n r
      have h : Complex.I * ((n : ℤ) : ℂ) * ((r : ℝ) : ℂ)
          = ((((n : ℝ) * r : ℝ)) : ℂ) * Complex.I := by push_cast; ring
      rw [h, Complex.norm_exp_ofReal_mul_I]
    have hcoeK : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → (x : K) ≠ 0 := by
      intro x hx; simpa using hx
    have hmulK : ∀ x y : NumberField.RingOfIntegers K,
        (((x * y : NumberField.RingOfIntegers K)) : K) = (x : K) * (y : K) := by
      intro x y; push_cast; ring
    have honeK : (((1 : NumberField.RingOfIntegers K)) : K) = 1 := by push_cast; ring
    have hre : ∀ (x y : NumberField.RingOfIntegers K)
        (w : {w : NumberField.InfinitePlace K // w.IsReal}),
        (NumberField.mixedEmbedding K (((x * y : NumberField.RingOfIntegers K)) : K)).1 w
          = (NumberField.mixedEmbedding K ((x : K))).1 w
            * (NumberField.mixedEmbedding K ((y : K))).1 w := by
      intro x y w
      rw [hmulK x y, map_mul (NumberField.mixedEmbedding K)]
      rfl
    have hcx : ∀ (x y : NumberField.RingOfIntegers K)
        (p : {w : NumberField.InfinitePlace K // w.IsComplex}),
        (NumberField.mixedEmbedding K (((x * y : NumberField.RingOfIntegers K)) : K)).2 p
          = (NumberField.mixedEmbedding K ((x : K))).2 p
            * (NumberField.mixedEmbedding K ((y : K))).2 p := by
      intro x y p
      rw [hmulK x y, map_mul (NumberField.mixedEmbedding K)]
      rfl
    have hpl : ∀ (x y : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
        w ((((x * y : NumberField.RingOfIntegers K)) : K)) = w ((x : K)) * w ((y : K)) := by
      intro x y w
      rw [hmulK x y]
      exact map_mul w _ _
    have hone1 : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (NumberField.mixedEmbedding K (((1 : NumberField.RingOfIntegers K)) : K)).1 w = 1 := by
      intro w
      rw [honeK, map_one (NumberField.mixedEmbedding K)]
      rfl
    have hone2 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        (NumberField.mixedEmbedding K (((1 : NumberField.RingOfIntegers K)) : K)).2 p = 1 := by
      intro p
      rw [honeK, map_one (NumberField.mixedEmbedding K)]
      rfl
    have hone3 : ∀ w : NumberField.InfinitePlace K,
        w ((((1 : NumberField.RingOfIntegers K)) : K)) = 1 := by
      intro w
      rw [honeK]
      exact map_one w
    have hrene : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
        ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (NumberField.mixedEmbedding K ((x : K))).1 w ≠ 0 := by
      intro x hx w
      exact (map_ne_zero (NumberField.InfinitePlace.embedding_of_isReal w.prop)).mpr (hcoeK x hx)
    have hcxne : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
        ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        (NumberField.mixedEmbedding K ((x : K))).2 p ≠ 0 := by
      intro x hx p
      exact (map_ne_zero (p : NumberField.InfinitePlace K).embedding).mpr (hcoeK x hx)
    have hplne : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
        ∀ w : NumberField.InfinitePlace K, w ((x : K)) ≠ 0 := by
      intro x hx w
      exact ne_of_gt (NumberField.InfinitePlace.pos_iff.mpr (hcoeK x hx))
    have hunfold : ∀ (z : NumberField.RingOfIntegers K) (hz : IsUnit (Ideal.Quotient.mk q z)),
        kaiHeckeTwist K q t l ξ η z
          = (ξ hz.unit : ℂ)
            * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                if η w then
                  ((Real.sign ((NumberField.mixedEmbedding K ((z : K))).1 w) : ℝ) : ℂ)
                else 1)
            * Complex.exp (Complex.I *
                (∑ w : NumberField.InfinitePlace K,
                  (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((z : K))) : ℝ) : ℂ)))
            * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
                Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                  ((((NumberField.mixedEmbedding K ((z : K))).2 w).arg : ℝ) : ℂ))) := by
      intro z hz
      simp only [kaiHeckeTwist, dif_pos hz]
    have hnotunit : ∀ (z : NumberField.RingOfIntegers K),
        ¬ IsUnit (Ideal.Quotient.mk q z) → kaiHeckeTwist K q t l ξ η z = 0 := by
      intro z hz
      simp only [kaiHeckeTwist, dif_neg hz]
    have hmuliff : ∀ x y : NumberField.RingOfIntegers K,
        IsUnit (Ideal.Quotient.mk q (x * y)) ↔
          (IsUnit (Ideal.Quotient.mk q x) ∧ IsUnit (Ideal.Quotient.mk q y)) := by
      intro x y; rw [map_mul, IsUnit.mul_iff]
    have hunitmul : ∀ (x y : NumberField.RingOfIntegers K)
        (hxy : IsUnit (Ideal.Quotient.mk q (x * y)))
        (hx : IsUnit (Ideal.Quotient.mk q x)) (hy : IsUnit (Ideal.Quotient.mk q y)),
        hxy.unit = hx.unit * hy.unit := by
      intro x y hxy hx hy
      apply Units.ext
      rw [IsUnit.unit_spec, Units.val_mul, IsUnit.unit_spec, IsUnit.unit_spec, map_mul]
    have h1u : IsUnit (Ideal.Quotient.mk q (1 : NumberField.RingOfIntegers K)) := by
      rw [map_one]; exact isUnit_one
    have hA : kaiHeckeTwist K q t l ξ η 1 = 1 := by
      rw [hunfold 1 h1u]
      have hU : (ξ h1u.unit : ℂ) = 1 := by
        have hu : h1u.unit = 1 := by
          apply Units.ext
          rw [IsUnit.unit_spec, Units.val_one, map_one]
        rw [hu, map_one, Circle.coe_one]
      have hS : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if η w then
            ((Real.sign ((NumberField.mixedEmbedding K
              (((1 : NumberField.RingOfIntegers K)) : K)).1 w) : ℝ) : ℂ)
          else 1) = 1 := by
        refine Finset.prod_eq_one (fun w _ => ?_)
        rw [hone1 w, Real.sign_one, Complex.ofReal_one, ite_self]
      have hL : Complex.exp (Complex.I *
          (∑ w : NumberField.InfinitePlace K,
            (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
              ((Real.log (w ((((1 : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ))) = 1 := by
        have hz : (∑ w : NumberField.InfinitePlace K,
            (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
              ((Real.log (w ((((1 : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ)) = 0 := by
          refine Finset.sum_eq_zero (fun w _ => ?_)
          rw [hone3 w, Real.log_one, Complex.ofReal_zero, mul_zero]
        rw [hz, mul_zero, Complex.exp_zero]
      have hAng : (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
            ((((NumberField.mixedEmbedding K
              (((1 : NumberField.RingOfIntegers K)) : K)).2 w).arg : ℝ) : ℂ))) = 1 := by
        refine Finset.prod_eq_one (fun p _ => ?_)
        rw [hone2 p, Complex.arg_one, Complex.ofReal_zero, mul_zero, Complex.exp_zero]
      rw [hU, hS, hL, hAng]
      ring
    have hB : ∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 →
        kaiHeckeTwist K q t l ξ η (x * y)
          = kaiHeckeTwist K q t l ξ η x * kaiHeckeTwist K q t l ξ η y := by
      intro x y hx0 hy0
      by_cases hxy : IsUnit (Ideal.Quotient.mk q (x * y))
      · obtain ⟨hx, hy⟩ := (hmuliff x y).mp hxy
        rw [hunfold (x * y) hxy, hunfold x hx, hunfold y hy]
        have e1 : (ξ hxy.unit : ℂ) = (ξ hx.unit : ℂ) * (ξ hy.unit : ℂ) := by
          rw [hunitmul x y hxy hx hy, map_mul, Circle.coe_mul]
        have e2 : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              if η w then
                ((Real.sign ((NumberField.mixedEmbedding K
                  (((x * y : NumberField.RingOfIntegers K)) : K)).1 w) : ℝ) : ℂ)
              else 1)
            = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                if η w then
                  ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
                else 1)
              * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                if η w then
                  ((Real.sign ((NumberField.mixedEmbedding K ((y : K))).1 w) : ℝ) : ℂ)
                else 1) := by
          rw [← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl (fun w _ => ?_)
          by_cases hw : η w = true
          · simp only [if_pos hw]
            rw [hre x y w, hsign, Complex.ofReal_mul]
          · simp only [if_neg hw, one_mul]
        have e3 : Complex.exp (Complex.I *
              (∑ w : NumberField.InfinitePlace K,
                (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
                  ((Real.log (w ((((x * y : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ)))
            = Complex.exp (Complex.I *
                (∑ w : NumberField.InfinitePlace K,
                  (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ)))
              * Complex.exp (Complex.I *
                (∑ w : NumberField.InfinitePlace K,
                  (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((y : K))) : ℝ) : ℂ))) := by
          have hsum : (∑ w : NumberField.InfinitePlace K,
                (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
                  ((Real.log (w ((((x * y : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ))
              = (∑ w : NumberField.InfinitePlace K,
                  (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ))
                + (∑ w : NumberField.InfinitePlace K,
                  (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((y : K))) : ℝ) : ℂ)) := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl (fun w _ => ?_)
            rw [hpl x y w, Real.log_mul (hplne x hx0 w) (hplne y hy0 w)]
            push_cast
            ring
          rw [hsum, mul_add, Complex.exp_add]
        have e4 : (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
              Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                ((((NumberField.mixedEmbedding K
                  (((x * y : NumberField.RingOfIntegers K)) : K)).2 w).arg : ℝ) : ℂ)))
            = (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
                Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                  ((((NumberField.mixedEmbedding K ((x : K))).2 w).arg : ℝ) : ℂ)))
              * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
                Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                  ((((NumberField.mixedEmbedding K ((y : K))).2 w).arg : ℝ) : ℂ))) := by
          rw [← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl (fun p _ => ?_)
          rw [hcx x y p]
          exact hargmul (l p) _ _ (hcxne x hx0 p) (hcxne y hy0 p)
        rw [e1, e2, e3, e4]
        ring
      · rw [hnotunit (x * y) hxy]
        by_cases hx : IsUnit (Ideal.Quotient.mk q x)
        · by_cases hy : IsUnit (Ideal.Quotient.mk q y)
          · exact absurd ((hmuliff x y).mpr ⟨hx, hy⟩) hxy
          · rw [hnotunit y hy, mul_zero]
        · rw [hnotunit x hx, zero_mul]
    have hC : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 →
        IsUnit (Ideal.Quotient.mk q x) → ‖kaiHeckeTwist K q t l ξ η x‖ = 1 := by
      intro x hx0 hx
      rw [hunfold x hx, norm_mul, norm_mul, norm_mul]
      have n1 : ‖(ξ hx.unit : ℂ)‖ = 1 := Circle.norm_coe _
      have n2 : ‖(∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if η w then
            ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
          else 1)‖ = 1 := by
        rw [norm_prod]
        refine Finset.prod_eq_one (fun w _ => ?_)
        by_cases hw : η w = true
        · rw [if_pos hw]
          exact hsignnorm _ (hrene x hx0 w)
        · rw [if_neg hw, norm_one]
      have n3 : ‖Complex.exp (Complex.I *
          (∑ w : NumberField.InfinitePlace K,
            (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ)))‖ = 1 := by
        have hs : (∑ w : NumberField.InfinitePlace K,
              (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ))
            = (((∑ w : NumberField.InfinitePlace K,
                t w * (w.mult : ℝ) * Real.log (w ((x : K))) : ℝ)) : ℂ) := by
          push_cast; ring
        rw [hs, mul_comm, Complex.norm_exp_ofReal_mul_I]
      have n4 : ‖(∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
