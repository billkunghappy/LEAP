  obtain ⟨C2, hC2⟩ : ∃ C2 : ℝ, C2 = 2 ^ Module.finrank ℚ K * Q ^ 2 / 2 * Jst := ⟨_, rfl⟩
  rw [← hC2] at hCE
  have hC20 : 0 ≤ C2 := by rw [hC2]; positivity
  have hsq : ‖S‖ ^ 2 ≤ (((omegaBox ω M).card : ℝ) * T * (ε + Real.sqrt C2 * t)) ^ 2 := by
    have hst := Real.sq_sqrt hC20
    have hA1 : Jst * (Q ^ 2 / 2) * ∑ y ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)), X y
        ≤ C2 * (((omegaBox ω M).card : ℝ) * T) ^ 2 * t ^ 2 := by
      calc _ ≤ Jst * (Q ^ 2 / 2) * (((omegaBox ω (2 * (⌊M⌋₊ : ℝ))).card : ℝ) *
              ((omegaBox ω M).card : ℝ) * (T * t) ^ 2) :=
            mul_le_mul_of_nonneg_left hXsum (by positivity)
        _ ≤ Jst * (Q ^ 2 / 2) * ((2 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ)) *
              ((omegaBox ω M).card : ℝ) * (T * t) ^ 2) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right
