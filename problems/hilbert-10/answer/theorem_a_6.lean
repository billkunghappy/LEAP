                x - a ∈ Ideal.span {((q : ℕ) : NumberField.RingOfIntegers K)})
              (fun _ => Classical.propDecidable _) (omegaBox ω M), f x| ≤ ε)
    (hBf : ∑ x ∈ omegaBox ω M, |f x| ≤ Bf) :
    ‖∑ x ∈ omegaBox ω M, ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖
      ≤ ((q : ℝ) * (H : ℝ)) ^ ν * ε + 24 * Real.pi * (ν : ℝ) ^ 2 * (T / (H : ℝ)) * Bf :=
