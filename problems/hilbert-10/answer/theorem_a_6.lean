            (-((3 : ℝ) / 2)) := tsum_mul_left
  
  have hsumbd : ∀ s : Finset ↥Rep,
      (∑ ν ∈ s, (|(Algebra.norm ℚ) (ν.1.1 : K)| : ℝ) ^ (-((3 : ℝ) / 2)))
        ≤ ((G.index * wq : ℕ) : ℝ) *
          (((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                (-((3 : ℝ) / 2))) := by
    intro s
    calc (∑ ν ∈ s, (|(Algebra.norm ℚ) (ν.1.1 : K)| : ℝ) ^ (-((3 : ℝ) / 2)))
        = ∑ ν ∈ s, (((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
            ((Ideal.absNorm ((J ν : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2))) :=
          Finset.sum_congr rfl (fun ν _ => hfg ν)
      _ = ∑ y ∈ s.image J, ({ν ∈ s | J ν = y}.card) •
            (((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
            ((Ideal.absNorm ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2))) :=
          Finset.sum_comp
            (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
              ((FractionalIdeal.absNorm
                (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                  : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                (-((3 : ℝ) / 2))) J
      _ ≤ ∑ y ∈ s.image J, ((G.index * wq : ℕ) : ℝ) *
            (((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
            ((Ideal.absNorm ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2))) := by
          refine Finset.sum_le_sum ?_
          intro y hy'
          obtain ⟨ν₀, hν₀s, hy⟩ := Finset.mem_image.mp hy'
          rw [nsmul_eq_mul]
          refine mul_le_mul_of_nonneg_right ?_ (hg0 y)
          have hsub : {ν ∈ s | J ν = y} ⊆ (hfib ν₀).1.toFinset := by
            intro x hx
            rw [Finset.mem_filter] at hx
            rw [Set.Finite.mem_toFinset]
            show J x = J ν₀
            rw [hx.2, ← hy]
          have hchain : ({ν ∈ s | J ν = y}).card ≤ G.index * wq := by
            refine le_trans (Finset.card_le_card hsub) ?_
            exact (((Nat.card_coe_set_eq ({ν : Rep | J ν = J ν₀})).trans
              (Set.ncard_eq_toFinset_card _ (hfib ν₀).1)).symm).trans_le (hfib ν₀).2
          exact_mod_cast hchain
      _ = ((G.index * wq : ℕ) : ℝ) * ∑ y ∈ s.image J,
            (((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
            ((Ideal.absNorm ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2))) :=
          (Finset.mul_sum _ _ _).symm
      _ ≤ ((G.index * wq : ℕ) : ℝ) *
            (((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                (-((3 : ℝ) / 2))) := by
          refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
          rw [← hgtsum]
          exact Summable.sum_le_tsum _ (fun i _ => hg0 i) hgsum
  
  have hnonneg : ∀ ν : Rep,
      (0 : ℝ) ≤ (|(Algebra.norm ℚ) (ν.1.1 : K)| : ℝ) ^ (-((3 : ℝ) / 2)) := by
    intro ν
    refine Real.rpow_nonneg ?_ _
    exact_mod_cast abs_nonneg ((Algebra.norm ℚ) (ν.1.1 : K))
  have hsummable : Summable (fun ν : Rep =>
      (|(Algebra.norm ℚ) (ν.1.1 : K)| : ℝ) ^ (-((3 : ℝ) / 2))) :=
    summable_of_sum_le hnonneg hsumbd
  refine ⟨hsummable, ?_⟩
  refine le_trans (hsummable.tsum_le_of_sum_le hsumbd) ?_
  have hmle : ((G.index * wq : ℕ) : ℝ) ≤ (wq : ℝ) * ((Ideal.absNorm q : ℝ) *
      2 ^ (NumberField.InfinitePlace.nrRealPlaces K)) := by
    have hw0 : (0 : ℝ) ≤ (wq : ℝ) := Nat.cast_nonneg _
    have h := mul_le_mul_of_nonneg_right hGle hw0
    push_cast
    linarith
  have hβP : ((FractionalIdeal.absNorm
        (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
          : ℚ) : ℝ) ^ (-((3 : ℝ) / 2))
      ≤ (B * (Ideal.absNorm (q * b) : ℝ) ^ B) ^ ((3 : ℝ) / 2) := by
    rw [Real.rpow_neg hβpos.le, inv_le_iff_one_le_mul₀ (Real.rpow_pos_of_pos hβpos _),
      ← Real.mul_rpow hP0.le hβpos.le]
    calc (1 : ℝ) = (1 : ℝ) ^ ((3 : ℝ) / 2) := (Real.one_rpow _).symm
      _ ≤ ((B * (Ideal.absNorm (q * b) : ℝ) ^ B) *
            ((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ)) ^ ((3 : ℝ) / 2) :=
          Real.rpow_le_rpow zero_le_one hPβ (by norm_num)
  have hr1 : (0 : ℝ) ≤ 2 ^ (NumberField.InfinitePlace.nrRealPlaces K) :=
    pow_nonneg (by norm_num) _
  calc ((G.index * wq : ℕ) : ℝ) *
        (((FractionalIdeal.absNorm
            (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
              : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
