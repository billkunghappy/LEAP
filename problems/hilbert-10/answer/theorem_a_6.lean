    have e2 : X / 2 * (2 * (q₀ : ℝ)) = (q₀ : ℝ) * X := by ring
    rw [e2]; exact h
  have hrep : ∀ z : Fin ν → ℤ, ∑ l, ∑ l', p₂ l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)
      = (∑ l, ∑ l', ((a l l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ))
          / ((2 * q₀ : ℕ) : ℝ)
