noncomputable def gowersU3Pow {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K))
    (f : NumberField.RingOfIntegers K → ℝ) (M : ℝ) : ℝ :=
  (∑ x ∈ omegaBox ω M, ∑ h₁ ∈ omegaBox ω (2 * M), ∑ h₂ ∈ omegaBox ω (2 * M),
      ∑ h₃ ∈ omegaBox ω (2 * M),
        ∏ ε : Fin 3 → Fin 2,
          (if cubeVertex x h₁ h₂ h₃ ε ∈ omegaBox ω M then f (cubeVertex x h₁ h₂ h₃ ε) else 0))
    / ((omegaBox ω M).card : ℝ) ^ 4

