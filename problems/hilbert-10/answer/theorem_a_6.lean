              lam₁ P ^ j * lam₂ P ^ (e - k - l) * (lam₁ P ^ l * lam₂ P ^ l) := by
      have hmaps : ∀ v ∈ (Finset.range (e + 1) ×ˢ Finset.range (e + 1) ×ˢ
