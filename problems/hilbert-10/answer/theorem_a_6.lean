          (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) :=
        one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h2 hh) hφ
      have hD : NumberField.Units.regulator K ≤ 2 ^ NumberField.InfinitePlace.nrRealPlaces K *
          (NumberField.classNumber K : ℝ) *
          (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
          NumberField.Units.regulator K := le_mul_of_one_le_left hR.le h1D
      have hRq0 : 0 ≤ Rq := le_trans hR.le hRq.1
      have hnum : 0 ≤ ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq :=
        mul_nonneg (Nat.cast_nonneg _) hRq0
      refine ⟨div_nonneg hnum (le_trans hR.le hD), ?_⟩
      calc ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
            (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
              (NumberField.classNumber K : ℝ) *
              (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
              NumberField.Units.regulator K)
          ≤ ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq / NumberField.Units.regulator K :=
            div_le_div_of_nonneg_left hnum hR hD
        _ ≤ ((NumberField.Units.torsionOrder K : ℕ) : ℝ)
              * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K)
              / NumberField.Units.regulator K :=
            div_le_div_of_nonneg_right
              (mul_le_mul_of_nonneg_left hRq.2 (Nat.cast_nonneg _)) hR.le
        _ = ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * B / NumberField.Units.regulator K
              * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K := by ring
  
  obtain ⟨l, hl⟩ : ∃ l : ℕ, l = ⌈Real.exp (Real.sqrt (Real.log X)
      / (4 * ((NumberField.Units.rank K : ℝ) + 1) * c₂))⌉₊ := ⟨_, rfl⟩
  obtain ⟨hl1, hΔ, hΔθ, hbud⟩ := hs5 X hX5 (Ideal.absNorm q : ℝ) hN1 hqN l hl
  
  have hW0 : 0 ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
      * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X :=
    mul_nonneg (mul_nonneg (mul_nonneg (by linarith) (pow_nonneg (by linarith) _))
      (sq_nonneg _)) (by linarith)
  have hP : 0 ≤ (2 * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
      * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X) + 5) ^ NumberField.Units.rank K :=
    pow_nonneg (by linarith) _
  have hD : 0 ≤ (NumberField.Units.rank K : ℝ) / (2 * (l : ℝ))
      + ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ)
          * (B * (Ideal.absNorm q : ℝ)) + 1) / (l : ℝ) := by
    have hl0 : (0 : ℝ) ≤ (l : ℝ) := Nat.cast_nonneg _
    have hnum : 0 ≤ (Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ)
        * (B * (Ideal.absNorm q : ℝ)) + 1 :=
      add_nonneg (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
        (mul_nonneg (by linarith) (by linarith))) zero_le_one
    exact add_nonneg (div_nonneg (Nat.cast_nonneg _) (by positivity)) (div_nonneg hnum hl0)
  
  have h1 := hs1 X hX1 q hq hqN H wq Rq e hdata α hα ε β hε hεβ hTB a b ρ σ θ₁ θ₂ hab hρσ
  have h2 := hs2 X hX3 q hq H wq Rq e hdata α hα ε β hε hεβ
    (X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)))
    (Real.exp (-Real.sqrt (Real.log X) / (2 * c₂))) hT3 hTX hE0 hE hTB
    a b ρ σ θ₁ θ₂ hab hρσ l hl1 hΔ hΔθ
  have h3 := hs3 X hX3 q hq H wq Rq e hdata ε β hε hεβ
    (X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X))) (by linarith)
    a b ρ σ hab3 hρσ3 l hl1 hΔ
  have h4 := hs4 X hX4 q hq hqN H wq Rq e hdata ε β hε hεβ a b ρ σ θ₁ θ₂ hab3 hρσ6
  
  exact key _ _ _ _ _ _ _ _ _ _ _ _ _ _ h1 h2 h3 h4 hbud hΘ0 hΘ1 hCq.1 hCq.2 hP hD hXn.le hs0

theorem kai_cell_power_integral (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hab : ∀ w, a w < b w ∧ (0 ≤ a w ∨ b w ≤ 0))
    (hρσ : ∀ w, 0 ≤ ρ w ∧ ρ w < σ w ∧ -Real.pi ≤ θ₁ w ∧ θ₁ w ≤ θ₂ w ∧ θ₂ w ≤ Real.pi)
    (γ : ℝ) (hγ : 0 < γ) :
    ∫ z in kaiCell K a b ρ σ θ₁ θ₂, (NumberField.mixedEmbedding.norm z) ^ (γ - 1)
      = (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (θ₂ p - θ₁ p)) *
        ∏ w : NumberField.InfinitePlace K,
          ((kaiTBCellHi K a b ρ σ w ^ (γ * (w.mult : ℝ))
              - kaiTBCellLo K a b ρ σ w ^ (γ * (w.mult : ℝ))) / (γ * (w.mult : ℝ))) :=
by
  classical
  
  have s1 : ∀ (a b γ : ℝ), a < b → 0 < γ →
      (0 ≤ a → ∫ x in Set.Ioc a b, |x| ^ (γ - 1) = (b ^ γ - a ^ γ) / γ) ∧
      (b ≤ 0 → ∫ x in Set.Ioc a b, |x| ^ (γ - 1) = ((-a) ^ γ - (-b) ^ γ) / γ) := by
    intro a b γ hab hγ
    have hr : (-1:ℝ) < γ - 1 := by linarith
    constructor
    · intro h
      rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioc (g := fun x => x ^ (γ - 1))
        (fun x hx => by simp only; rw [abs_of_nonneg (by linarith [hx.1])])]
      rw [← intervalIntegral.integral_of_le hab.le, integral_rpow (Or.inl hr), sub_add_cancel]
    · intro hb
      rw [← intervalIntegral.integral_of_le hab.le]
      have h2 := intervalIntegral.integral_comp_neg (a := a) (b := b) (fun y => |y| ^ (γ - 1))
      simp only [abs_neg] at h2
      rw [h2]
      rw [intervalIntegral.integral_congr (g := fun y => y ^ (γ - 1)) (fun y hy => ?_)]
      · rw [integral_rpow (Or.inl hr), sub_add_cancel]
      · rw [Set.uIcc_of_le (by linarith)] at hy
        simp only
        rw [abs_of_nonneg (by linarith [hy.1])]
  
  have s2 : ∀ (ρ σ θ₁ θ₂ γ : ℝ), 0 ≤ ρ → ρ < σ → -Real.pi ≤ θ₁ → θ₁ ≤ θ₂ → θ₂ ≤ Real.pi →
      0 < γ →
      ∫ c in {c : ℂ | ρ < ‖c‖ ∧ ‖c‖ ≤ σ ∧ θ₁ < c.arg ∧ c.arg ≤ θ₂}, (‖c‖ ^ 2) ^ (γ - 1)
        = (θ₂ - θ₁) * ((σ ^ (γ * 2) - ρ ^ (γ * 2)) / (γ * 2)) := by
    intro ρ σ θ₁ θ₂ γ hρ hρσ hθ₁ hθ hθ₂ hγ
    have hSmeas : MeasurableSet {c : ℂ | ρ < ‖c‖ ∧ ‖c‖ ≤ σ ∧ θ₁ < c.arg ∧ c.arg ≤ θ₂} := by
      have e : {c : ℂ | ρ < ‖c‖ ∧ ‖c‖ ≤ σ ∧ θ₁ < c.arg ∧ c.arg ≤ θ₂}
          = {c : ℂ | ρ < ‖c‖} ∩ ({c : ℂ | ‖c‖ ≤ σ} ∩
              ({c : ℂ | θ₁ < c.arg} ∩ {c : ℂ | c.arg ≤ θ₂})) := by
        ext c; simp only [Set.mem_setOf_eq, Set.mem_inter_iff]
      rw [e]
      exact (measurableSet_lt measurable_const measurable_norm).inter
        ((measurableSet_le measurable_norm measurable_const).inter
          ((measurableSet_lt measurable_const Complex.measurable_arg).inter
            (measurableSet_le Complex.measurable_arg measurable_const)))
    have hTmeas : MeasurableSet (Set.Ioc ρ σ ×ˢ Set.Ioc θ₁ θ₂) :=
      measurableSet_Ioc.prod measurableSet_Ioc
    have htgt : MeasurableSet polarCoord.target := by
      rw [polarCoord_target]; exact measurableSet_Ioi.prod measurableSet_Ioo
    rw [← MeasureTheory.integral_indicator hSmeas,
      ← Complex.integral_comp_polarCoord_symm]
    have hEq : Set.EqOn
        (fun p : ℝ × ℝ => p.1 •
          ({c : ℂ | ρ < ‖c‖ ∧ ‖c‖ ≤ σ ∧ θ₁ < c.arg ∧ c.arg ≤ θ₂}.indicator
            (fun c : ℂ => (‖c‖ ^ 2) ^ (γ - 1))) (Complex.polarCoord.symm p))
        (fun p : ℝ × ℝ =>
          (Set.Ioc ρ σ ×ˢ Set.Ioc θ₁ θ₂).indicator
            (fun q : ℝ × ℝ => q.1 * (q.1 ^ 2) ^ (γ - 1)) p)
        polarCoord.target := by
      intro p hp
      have hp' : p ∈ Complex.polarCoord.target := by
        rw [Complex.polarCoord_target]
        rw [polarCoord_target] at hp
        exact hp
      have hinv := Complex.polarCoord.right_inv hp'
      rw [Complex.polarCoord_apply] at hinv
      have h1 : ‖Complex.polarCoord.symm p‖ = p.1 := congrArg Prod.fst hinv
      have h2 : (Complex.polarCoord.symm p).arg = p.2 := congrArg Prod.snd hinv
      have hiff : (Complex.polarCoord.symm p ∈
          {c : ℂ | ρ < ‖c‖ ∧ ‖c‖ ≤ σ ∧ θ₁ < c.arg ∧ c.arg ≤ θ₂})
          ↔ p ∈ Set.Ioc ρ σ ×ˢ Set.Ioc θ₁ θ₂ := by
        simp only [Set.mem_setOf_eq, h1, h2, Set.mem_prod, Set.mem_Ioc]
        tauto
      by_cases hmem : p ∈ Set.Ioc ρ σ ×ˢ Set.Ioc θ₁ θ₂
      · simp only [Set.indicator_of_mem (hiff.mpr hmem), Set.indicator_of_mem hmem, h1,
          smul_eq_mul]
      · simp only [Set.indicator_of_notMem (fun h => hmem (hiff.mp h)),
          Set.indicator_of_notMem hmem, smul_eq_mul, mul_zero]
    rw [MeasureTheory.setIntegral_congr_fun htgt hEq,
      MeasureTheory.setIntegral_indicator hTmeas]
    have hsub : Set.Ioc ρ σ ⊆ Set.Ioi 0 := fun x hx => lt_of_le_of_lt hρ hx.1
    have hint : polarCoord.target ∩ (Set.Ioc ρ σ ×ˢ Set.Ioc θ₁ θ₂)
        = Set.Ioc ρ σ ×ˢ (Set.Ioo (-Real.pi) Real.pi ∩ Set.Ioc θ₁ θ₂) := by
      rw [polarCoord_target, Set.prod_inter_prod, Set.inter_eq_self_of_subset_right hsub]
    rw [hint, MeasureTheory.Measure.volume_eq_prod ℝ ℝ]
    have hP := MeasureTheory.setIntegral_prod_mul
      (μ := (MeasureTheory.volume : MeasureTheory.Measure ℝ))
      (ν := (MeasureTheory.volume : MeasureTheory.Measure ℝ))
      (fun r : ℝ => r * (r ^ 2) ^ (γ - 1)) (fun _ : ℝ => (1 : ℝ)) (Set.Ioc ρ σ)
      (Set.Ioo (-Real.pi) Real.pi ∩ Set.Ioc θ₁ θ₂)
    simp only [mul_one] at hP
    rw [hP]
    have hangular : MeasureTheory.volume (Set.Ioo (-Real.pi) Real.pi ∩ Set.Ioc θ₁ θ₂)
        = ENNReal.ofReal (θ₂ - θ₁) := by
      have hle : MeasureTheory.volume (Set.Ioo (-Real.pi) Real.pi ∩ Set.Ioc θ₁ θ₂)
          ≤ ENNReal.ofReal (θ₂ - θ₁) := by
        have := MeasureTheory.measure_mono
          (μ := (MeasureTheory.volume : MeasureTheory.Measure ℝ))
          (Set.inter_subset_right (s := Set.Ioo (-Real.pi) Real.pi) (t := Set.Ioc θ₁ θ₂))
        rwa [Real.volume_Ioc] at this
      have hge : ENNReal.ofReal (θ₂ - θ₁)
          ≤ MeasureTheory.volume (Set.Ioo (-Real.pi) Real.pi ∩ Set.Ioc θ₁ θ₂) := by
        have hsub2 : Set.Ioo θ₁ θ₂ ⊆ Set.Ioo (-Real.pi) Real.pi ∩ Set.Ioc θ₁ θ₂ := by
          intro x hx
          exact ⟨⟨lt_of_le_of_lt hθ₁ hx.1, lt_of_lt_of_le hx.2 hθ₂⟩, ⟨hx.1, le_of_lt hx.2⟩⟩
        have := MeasureTheory.measure_mono
          (μ := (MeasureTheory.volume : MeasureTheory.Measure ℝ)) hsub2
        rwa [Real.volume_Ioo] at this
      exact le_antisymm hle hge
    have hang : ∫ y in Set.Ioo (-Real.pi) Real.pi ∩ Set.Ioc θ₁ θ₂, (1 : ℝ)
        = θ₂ - θ₁ := by
      rw [MeasureTheory.setIntegral_const, smul_eq_mul, mul_one, MeasureTheory.measureReal_def,
        hangular, ENNReal.toReal_ofReal (by linarith)]
    have hrad : ∫ r in Set.Ioc ρ σ, r * (r ^ 2) ^ (γ - 1)
        = (σ ^ (γ * 2) - ρ ^ (γ * 2)) / (γ * 2) := by
      rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioc (g := fun r => r ^ (2 * γ - 1))
        (fun r hr => ?_)]
      · rw [← intervalIntegral.integral_of_le hρσ.le,
          integral_rpow (Or.inl (by linarith : (-1:ℝ) < 2 * γ - 1))]
        rw [show 2 * γ - 1 + 1 = γ * 2 by ring]
      · have hr0 : 0 < r := lt_of_le_of_lt hρ hr.1
        simp only
        rw [← Real.rpow_natCast, ← Real.rpow_mul hr0.le,
          show 2 * γ - 1 = ((2:ℕ):ℝ) * (γ - 1) + 1 by push_cast; ring,
          Real.rpow_add_one hr0.ne', mul_comm]
    rw [hang, hrad, mul_comm]
  
  have hsplitP : ∀ F : NumberField.InfinitePlace K → ℝ,
      (∏ v : NumberField.InfinitePlace K, F v)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              F (w : NumberField.InfinitePlace K))
          * ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              F (p : NumberField.InfinitePlace K) := by
    intro F
    rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
        (fun v : NumberField.InfinitePlace K => v.IsReal) F]
    congr 1
    · exact Finset.prod_subtype _ (fun v => by simp) F
    · exact Finset.prod_subtype _
        (fun v => by simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]) F
  
  have s3 : ∫ z in kaiCell K a b ρ σ θ₁ θ₂, (NumberField.mixedEmbedding.norm z) ^ (γ - 1)
      = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            ∫ x in Set.Ioc (a w) (b w), |x| ^ (γ - 1)) *
        ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            ∫ c in {c : ℂ | ρ p < ‖c‖ ∧ ‖c‖ ≤ σ p ∧ θ₁ p < c.arg ∧ c.arg ≤ θ₂ p},
              (‖c‖ ^ 2) ^ (γ - 1) := by
    have hnorm : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        NumberField.mixedEmbedding.norm z ^ (γ - 1)
          = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, |z.1 w| ^ (γ - 1)) *
            ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              (‖z.2 p‖ ^ 2) ^ (γ - 1) := by
      intro z
      rw [NumberField.mixedEmbedding.norm_apply, hsplitP]
      have hR : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K) z
            ^ (w : NumberField.InfinitePlace K).mult = |z.1 w| := by
        intro w
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2,
          NumberField.InfinitePlace.mult_isReal, pow_one, Real.norm_eq_abs]
      have hC : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          NumberField.mixedEmbedding.normAtPlace (p : NumberField.InfinitePlace K) z
            ^ (p : NumberField.InfinitePlace K).mult = ‖z.2 p‖ ^ 2 := by
        intro p
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex p.2,
          NumberField.InfinitePlace.mult_isComplex]
      rw [Finset.prod_congr rfl (fun w _ => hR w), Finset.prod_congr rfl (fun p _ => hC p),
        Real.mul_rpow (Finset.prod_nonneg fun _ _ => abs_nonneg _)
          (Finset.prod_nonneg fun _ _ => by positivity),
        ← Real.finset_prod_rpow _ _ (fun _ _ => abs_nonneg _),
        ← Real.finset_prod_rpow _ _ (fun _ _ => by positivity)]
    have hprod : kaiCell K a b ρ σ θ₁ θ₂
        = (Set.univ.pi fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
              Set.Ioc (a w) (b w))
          ×ˢ (Set.univ.pi fun p : {w : NumberField.InfinitePlace K // w.IsComplex} =>
              {c : ℂ | ρ p < ‖c‖ ∧ ‖c‖ ≤ σ p ∧ θ₁ p < c.arg ∧ c.arg ≤ θ₂ p}) := by
      ext z
      simp only [kaiCell, Set.mem_setOf_eq, Set.mem_prod, Set.mem_univ_pi, Set.mem_Ioc]
    simp_rw [hnorm]
    rw [hprod, MeasureTheory.Measure.volume_eq_prod
          ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
          ({w : NumberField.InfinitePlace K // w.IsComplex} → ℂ)]
    refine (MeasureTheory.setIntegral_prod_mul
        (fun u : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ => ∏ w, |u w| ^ (γ - 1))
        (fun v : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ =>
          ∏ p, (‖v p‖ ^ 2) ^ (γ - 1)) _ _).trans ?_
    congr 1
    · rw [MeasureTheory.volume_pi, MeasureTheory.Measure.restrict_pi_pi]
      exact MeasureTheory.integral_fintype_prod_eq_prod (fun w (t : ℝ) => |t| ^ (γ - 1))
    · rw [MeasureTheory.volume_pi, MeasureTheory.Measure.restrict_pi_pi]
      exact MeasureTheory.integral_fintype_prod_eq_prod
        (fun p (c : ℂ) => (‖c‖ ^ 2) ^ (γ - 1))
  
  rw [s3, hsplitP]
  have hR : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      ∫ x in Set.Ioc (a w) (b w), |x| ^ (γ - 1)
        = (kaiTBCellHi K a b ρ σ (w : NumberField.InfinitePlace K)
              ^ (γ * ((w : NumberField.InfinitePlace K).mult : ℝ))
            - kaiTBCellLo K a b ρ σ (w : NumberField.InfinitePlace K)
              ^ (γ * ((w : NumberField.InfinitePlace K).mult : ℝ)))
            / (γ * ((w : NumberField.InfinitePlace K).mult : ℝ)) := by
    intro w
    rw [NumberField.InfinitePlace.mult_isReal w, Nat.cast_one, mul_one]
    obtain ⟨hlt, hsgn⟩ := hab w
    by_cases h : 0 ≤ a w
    · have hHi : kaiTBCellHi K a b ρ σ (w : NumberField.InfinitePlace K) = b w := by
        simp [kaiTBCellHi, w.2, h]
      have hLo : kaiTBCellLo K a b ρ σ (w : NumberField.InfinitePlace K) = a w := by
        simp [kaiTBCellLo, w.2, h]
      rw [hHi, hLo]
      exact (s1 (a w) (b w) γ hlt hγ).1 h
    · have hHi : kaiTBCellHi K a b ρ σ (w : NumberField.InfinitePlace K) = -a w := by
        simp [kaiTBCellHi, w.2, h]
      have hLo : kaiTBCellLo K a b ρ σ (w : NumberField.InfinitePlace K) = -b w := by
        simp [kaiTBCellLo, w.2, h]
      rw [hHi, hLo]
      exact (s1 (a w) (b w) γ hlt hγ).2 (hsgn.resolve_left h)
  have hC : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      ∫ c in {c : ℂ | ρ p < ‖c‖ ∧ ‖c‖ ≤ σ p ∧ θ₁ p < c.arg ∧ c.arg ≤ θ₂ p},
          (‖c‖ ^ 2) ^ (γ - 1)
        = (θ₂ p - θ₁ p) *
          ((kaiTBCellHi K a b ρ σ (p : NumberField.InfinitePlace K)
              ^ (γ * ((p : NumberField.InfinitePlace K).mult : ℝ))
            - kaiTBCellLo K a b ρ σ (p : NumberField.InfinitePlace K)
              ^ (γ * ((p : NumberField.InfinitePlace K).mult : ℝ)))
            / (γ * ((p : NumberField.InfinitePlace K).mult : ℝ))) := by
    intro p
    have hp : ¬ (p : NumberField.InfinitePlace K).IsReal :=
      NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr p.2
    have hHi : kaiTBCellHi K a b ρ σ (p : NumberField.InfinitePlace K) = σ p := by
      simp [kaiTBCellHi, hp]
    have hLo : kaiTBCellLo K a b ρ σ (p : NumberField.InfinitePlace K) = ρ p := by
      simp [kaiTBCellLo, hp]
    rw [hHi, hLo, NumberField.InfinitePlace.mult_isComplex p, Nat.cast_ofNat]
    obtain ⟨h1, h2, h3, h4, h5⟩ := hρσ p
    exact s2 (ρ p) (σ p) (θ₁ p) (θ₂ p) γ h1 h2 h3 h4 h5 hγ
  rw [Finset.prod_congr rfl (fun w _ => hR w), Finset.prod_congr rfl (fun p _ => hC p),
    Finset.prod_mul_distrib]
  ring

theorem kai_shape_power_eval (K : Type u) [Field K] [NumberField K]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ) (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e)
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hab : ∀ w, a w < b w ∧ (0 ≤ a w ∨ b w ≤ 0)) (hρσ : ∀ w, 0 ≤ ρ w ∧ ρ w < σ w)
    (γ : ℝ) (hγ : 0 < γ) :
    Rq / 2 ^ NumberField.InfinitePlace.nrComplexPlaces K * (kaiTBShapePow K H a b ρ σ γ / γ)
      = ∏ w : NumberField.InfinitePlace K,
          ((kaiTBCellHi K a b ρ σ w ^ (γ * (w.mult : ℝ))
              - kaiTBCellLo K a b ρ σ w ^ (γ * (w.mult : ℝ))) / (γ * (w.mult : ℝ))) :=
by
  classical
  
  have hmult : ∀ w : NumberField.InfinitePlace K, 0 < w.mult :=
    fun w => NumberField.InfinitePlace.mult_pos
  have hmultR : ∀ w : NumberField.InfinitePlace K, ((w.mult : ℕ) : ℝ) ≠ 0 :=
    fun w => Nat.cast_ne_zero.mpr (hmult w).ne'
  have hmultpos : ∀ w : NumberField.InfinitePlace K, (0 : ℝ) < ((w.mult : ℕ) : ℝ) :=
    fun w => by exact_mod_cast hmult w
  have hsum_mult : ((Module.finrank ℚ K : ℕ) : ℝ)
      = ∑ w : NumberField.InfinitePlace K, ((w.mult : ℕ) : ℝ) := by
    exact_mod_cast (NumberField.InfinitePlace.sum_mult_eq).symm
  have hnpos : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hnR : ((Module.finrank ℚ K : ℕ) : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hnpos.ne'
  have hprodm : (0 : ℝ) < ∏ w : NumberField.InfinitePlace K, ((w.mult : ℕ) : ℝ) :=
    Finset.prod_pos fun w _ => hmultpos w
  have hpne : (∏ w : NumberField.InfinitePlace K, ((w.mult : ℕ) : ℝ)) ≠ 0 := hprodm.ne'
  have hlo : ∀ w : NumberField.InfinitePlace K,
      0 ≤ kaiTBCellLo K a b ρ σ w ∧ kaiTBCellLo K a b ρ σ w < kaiTBCellHi K a b ρ σ w := by
    intro w
    unfold kaiTBCellLo kaiTBCellHi
    split_ifs with hw hA
    · exact ⟨hA, (hab ⟨w, hw⟩).1⟩
    · have hlt := (hab ⟨w, hw⟩).1
