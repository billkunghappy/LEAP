    intro 𝔡 h
    have h1 : (Ideal.absNorm 𝔡 : ℝ) ≤ (Nmax : ℝ) := by exact_mod_cast ((hmemD 𝔡).1 h).1
    exact (Real.log_le_log (by linarith [hDN1 𝔡 h]) h1).trans hlogN
  have hclos : ∀ x ∈ omegaBox ω M, x ≠ 0 →
      ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), Ideal.span {x} ≤ 𝔡 → 𝔡 ∈ D := by
    intro x hx hx0 𝔡 h
    have hne : Ideal.span {x} ≠ ⊥ := by rwa [Ne, Ideal.span_singleton_eq_bot]
    have h1 := Ideal.absNorm_dvd_absNorm_of_le h
    rw [Ideal.absNorm_span_singleton] at h1
    have h2 : (Algebra.norm ℤ x).natAbs ≠ 0 := by
