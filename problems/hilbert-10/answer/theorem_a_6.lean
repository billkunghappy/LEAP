noncomputable def omegaBox {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) :
    Finset (NumberField.RingOfIntegers K) :=
  (intBox ν ⌊M⌋₊).image (fun v => ω.equivFun.symm v)


def cubeVertex {R : Type*} [AddCommMonoid R] (x h₁ h₂ h₃ : R) (ε : Fin 3 → Fin 2) : R :=
  x + ((ε 0 : ℕ)) • h₁ + ((ε 1 : ℕ)) • h₂ + ((ε 2 : ℕ)) • h₃

