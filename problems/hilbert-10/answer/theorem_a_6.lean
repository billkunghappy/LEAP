        MeasureTheory.Measure.map (fun u : ι → ℝ => ∑ j, m j * u j)
            ((MeasureTheory.volume.restrict G).withDensity w) A
          = ∫⁻ u in G ∩ {u : ι → ℝ | (∑ j, m j * u j) ∈ A}, w u := by
      intro A hA
