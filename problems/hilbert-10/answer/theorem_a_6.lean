      intro ξ _
      split_ifs <;> simp
    rw [Finset.prod_congr rfl hpt, Finset.prod_ite, Finset.prod_const, Finset.prod_const_one,
      mul_one, Finset.filter_mem_eq_inter, Finset.univ_inter]
  have hmaps : ∀ x ∈ giBohr P S (2 * r), J x ∈ T := by
    intro x hx
    rw [hT, Fintype.mem_piFinset]
    intro ξ
    by_cases hξ : ξ ∈ S
    · simp only [hJ, if_pos hξ, Finset.mem_Icc]
      exact hrange x hx ξ hξ
    · simp only [hJ, if_neg hξ, Finset.mem_singleton]
  
  have hfib : ∀ c ∈ T,
      ((giBohr P S (2 * r)).filter (fun x => J x = c)).card ≤ (giBohr P S r).card := by
    intro c _
    rcases Finset.eq_empty_or_nonempty ((giBohr P S (2 * r)).filter (fun x => J x = c))
      with hE | ⟨x₀, hx₀⟩
    · rw [hE]; exact Nat.zero_le _
    · obtain ⟨_, hxc⟩ := Finset.mem_filter.1 hx₀
      apply Finset.card_le_card_of_injOn (fun y => y - x₀)
      · intro y hy
        simp only [Finset.mem_coe, Finset.mem_filter] at hy
        obtain ⟨_, hyc⟩ := hy
        apply hsub
        intro ξ hξ
        have hfl : ⌊(sg (ξ * y) + 2 * r) / r⌋ = ⌊(sg (ξ * x₀) + 2 * r) / r⌋ := by
          have := congrFun (hyc.trans hxc.symm) ξ
          simpa only [hJ, if_pos hξ] using this
        have h := Int.abs_sub_lt_one_of_floor_eq_floor hfl
        have e : (sg (ξ * y) + 2 * r) / r - (sg (ξ * x₀) + 2 * r) / r
            = (sg (ξ * y) - sg (ξ * x₀)) / r := by ring
        rw [e, abs_div, abs_of_pos hr, div_lt_one hr] at h
        exact h
      · intro y₁ _ y₂ _ h
        simpa using h
  
  have hfin := Finset.card_le_mul_card_image_of_maps_to hmaps (giBohr P S r).card hfib
  rw [hTcard] at hfin
  rw [Nat.mul_comm (4 ^ S.card)]
  exact hfin

theorem nat_seq_exists_good_index (n M : ℕ) (hn : 1 ≤ n) (hM : 1 ≤ M) (f : ℕ → ℕ)
    (hf : Monotone f) (h0 : 1 ≤ f 0) (hgrow : f (4 * M) ≤ 4 ^ n * f 0)
    (hsmall : 4 * f (4 * M) ≤ M) :
    ∃ i : ℕ, M ≤ i ∧ i ≤ 3 * M ∧ f (i + 1) = f i ∧ f (i - 1) = f i ∧
      ∀ k : ℕ, 1 ≤ k → k ≤ M →
        (f (i + k) : ℝ) ≤ Real.exp (25 * n * k * Real.log 2 / (4 * M)) * f i ∧
        (f i : ℝ) ≤ Real.exp (25 * n * k * Real.log 2 / (4 * M)) * f (i - k) :=
by
  classical
  have rs_right : ∀ (g : ℕ → ℝ), Monotone g → ∀ (lam : ℝ), 0 < lam → ∀ (m : ℕ),
      ∀ d a : ℕ, m - a = d → a ≤ m → ∀ B : Finset ℕ,
      (∀ i ∈ B, a ≤ i ∧ i < m ∧ ∃ j : ℕ, i < j ∧ j ≤ m ∧ g i + lam * ((j : ℝ) - (i : ℝ)) < g j) →
      lam * (B.card : ℝ) ≤ g m - g a := by
    intro g hg lam hlam m d
    induction d using Nat.strong_induction_on with
    | _ d ih =>
    intro a hd ham B hB
    rcases Nat.eq_or_lt_of_le ham with h | h
    · subst h
      have hB0 : B = ∅ := Finset.eq_empty_of_forall_notMem (fun i hi => by have := hB i hi; omega)
      simp [hB0]
    · by_cases haB : a ∈ B
      · obtain ⟨-, -, j, haj, hjm, hw⟩ := hB a haB
        have hsplit := Finset.card_filter_add_card_filter_not (s := B) (p := fun i => i < j)
        have h1 : (B.filter (fun i => i < j)).card ≤ j - a := by
          have hsub : B.filter (fun i => i < j) ⊆ Finset.Ico a j := by
            intro i hi
            rw [Finset.mem_filter] at hi
            rw [Finset.mem_Ico]
            exact ⟨(hB i hi.1).1, hi.2⟩
          simpa using Finset.card_le_card hsub
        have h2 := ih (m - j) (by omega) j rfl hjm (B.filter (fun i => ¬ i < j)) (by
          intro i hi
          rw [Finset.mem_filter] at hi
          obtain ⟨_, h2, h3⟩ := hB i hi.1
          exact ⟨by omega, h2, h3⟩)
        have h1' : ((B.filter (fun i => i < j)).card : ℝ) ≤ (j : ℝ) - a := by
          have hc : (((j - a : ℕ)) : ℝ) = (j : ℝ) - a := by rw [Nat.cast_sub haj.le]
          rw [← hc]; exact_mod_cast h1
        have hcard : (B.card : ℝ) = ((B.filter (fun i => i < j)).card : ℝ)
            + ((B.filter (fun i => ¬ i < j)).card : ℝ) := by
          rw [← hsplit]; push_cast; ring
        rw [hcard, mul_add]
        nlinarith [mul_le_mul_of_nonneg_left h1' hlam.le]
      · have h2 := ih (m - (a + 1)) (by omega) (a + 1) rfl (by omega) B (by
          intro i hi
          obtain ⟨h1, h2, h3⟩ := hB i hi
          refine ⟨?_, h2, h3⟩
          rcases Nat.eq_or_lt_of_le h1 with h | h
          · subst h; exact absurd hi haB
          · omega)
        have := hg (Nat.le_succ a)
        linarith
  have rs_left : ∀ (g : ℕ → ℝ), Monotone g → ∀ (lam : ℝ), 0 < lam → ∀ (a : ℕ),
      ∀ d b : ℕ, b - a = d → a ≤ b → ∀ B : Finset ℕ,
      (∀ i ∈ B, a < i ∧ i ≤ b ∧ ∃ j : ℕ, a ≤ j ∧ j < i ∧ g j + lam * ((i : ℝ) - (j : ℝ)) < g i) →
      lam * (B.card : ℝ) ≤ g b - g a := by
    intro g hg lam hlam a d
    induction d using Nat.strong_induction_on with
    | _ d ih =>
    intro b hd hab B hB
    rcases Nat.eq_or_lt_of_le hab with h | h
    · subst h
      have hB0 : B = ∅ := Finset.eq_empty_of_forall_notMem (fun i hi => by have := hB i hi; omega)
      simp [hB0]
    · by_cases hbB : b ∈ B
      · obtain ⟨-, -, j, haj, hjb, hw⟩ := hB b hbB
        have hsplit := Finset.card_filter_add_card_filter_not (s := B) (p := fun i => j < i)
        have h1 : (B.filter (fun i => j < i)).card ≤ b - j := by
          have hsub : B.filter (fun i => j < i) ⊆ Finset.Ioc j b := by
            intro i hi
            rw [Finset.mem_filter] at hi
            rw [Finset.mem_Ioc]
            exact ⟨hi.2, (hB i hi.1).2.1⟩
          simpa using Finset.card_le_card hsub
        have h2 := ih (j - a) (by omega) j rfl haj (B.filter (fun i => ¬ j < i)) (by
          intro i hi
          rw [Finset.mem_filter] at hi
          obtain ⟨h1, _, h3⟩ := hB i hi.1
          exact ⟨h1, by omega, h3⟩)
        have h1' : ((B.filter (fun i => j < i)).card : ℝ) ≤ (b : ℝ) - j := by
          have hc : (((b - j : ℕ)) : ℝ) = (b : ℝ) - j := by rw [Nat.cast_sub hjb.le]
          rw [← hc]; exact_mod_cast h1
        have hcard : (B.card : ℝ) = ((B.filter (fun i => j < i)).card : ℝ)
            + ((B.filter (fun i => ¬ j < i)).card : ℝ) := by
          rw [← hsplit]; push_cast; ring
        rw [hcard, mul_add]
        nlinarith [mul_le_mul_of_nonneg_left h1' hlam.le]
      · have h2 := ih (b - 1 - a) (by omega) (b - 1) rfl (by omega) B (by
          intro i hi
          obtain ⟨h1, h2, h3⟩ := hB i hi
          refine ⟨h1, ?_, h3⟩
          rcases Nat.eq_or_lt_of_le h2 with h | h
          · subst h; exact absurd hi hbB
          · omega)
        have := hg (Nat.sub_le b 1)
        linarith
  
  have hfge : ∀ i, 1 ≤ f i := fun i => le_trans h0 (hf (Nat.zero_le i))
  have hfpos : ∀ i, (0 : ℝ) < f i := fun i => by
    have := hfge i
    exact_mod_cast (show 0 < f i by omega)
  obtain ⟨g, hg⟩ : ∃ g : ℕ → ℝ, ∀ i, g i = Real.log (f i : ℝ) :=
    ⟨fun i => Real.log (f i : ℝ), fun _ => rfl⟩
  obtain ⟨g', hg'⟩ : ∃ g' : ℕ → ℝ, ∀ i, g' i = (f i : ℝ) := ⟨fun i => (f i : ℝ), fun _ => rfl⟩
  have hgm : Monotone g := fun i j hij => by
    rw [hg, hg]; exact Real.log_le_log (hfpos i) (by exact_mod_cast hf hij)
  have hg'm : Monotone g' := fun i j hij => by
    rw [hg', hg']; exact_mod_cast hf hij
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hMpos : (0 : ℝ) < M := by exact_mod_cast hM
  have hnpos : (0 : ℝ) < n := by exact_mod_cast hn
  obtain ⟨lam, hlam_def⟩ : ∃ lam : ℝ, lam = 25 * n * Real.log 2 / (4 * M) := ⟨_, rfl⟩
  have hlam : 0 < lam := by rw [hlam_def]; positivity
  have hlam4M : lam * (4 * M) = 25 * (n * Real.log 2) := by
    rw [hlam_def]; field_simp
  have htot : g (4 * M) - g 0 ≤ 2 * (n * Real.log 2) := by
    have h1 : (f (4 * M) : ℝ) ≤ 4 ^ n * f 0 := by exact_mod_cast hgrow
    have h2 : Real.log (f (4 * M) : ℝ) ≤ Real.log (4 ^ n * f 0) := Real.log_le_log (hfpos _) h1
    rw [Real.log_mul (by positivity) (hfpos 0).ne', Real.log_pow] at h2
    have h4 : Real.log (4 : ℝ) = 2 * Real.log 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; push_cast; ring
    rw [hg, hg]
    rw [h4] at h2; linarith
  have htot' : g' (4 * M) - g' 0 ≤ (M : ℝ) / 4 - 1 := by
    have h1 : (4 * f (4 * M) : ℝ) ≤ M := by exact_mod_cast hsmall
    have h2 : (1 : ℝ) ≤ f 0 := by exact_mod_cast h0
    rw [hg', hg']; linarith
  
  set U : Finset ℕ := Finset.Icc M (3 * M) with hU
  set RB : Finset ℕ := U.filter
    (fun i => ∃ j : ℕ, i < j ∧ j ≤ 4 * M ∧ g i + lam * ((j : ℝ) - (i : ℝ)) < g j) with hRB
  set LB : Finset ℕ := U.filter
    (fun i => ∃ j : ℕ, 0 ≤ j ∧ j < i ∧ g j + lam * ((i : ℝ) - (j : ℝ)) < g i) with hLB
  set NR : Finset ℕ := U.filter (fun i => f i ≠ f (i + 1)) with hNR
  set NL : Finset ℕ := U.filter (fun i => f (i - 1) ≠ f i) with hNL
  have hc0 : 0 < n * Real.log 2 := by positivity
  have hRBc : 25 * (RB.card : ℝ) ≤ 8 * M := by
    have h := rs_right g hgm lam hlam (4 * M) _ 0 rfl (Nat.zero_le _) RB (by
      intro i hi
      rw [hRB, Finset.mem_filter, hU, Finset.mem_Icc] at hi
      exact ⟨Nat.zero_le _, by omega, hi.2⟩)
    have h5 := mul_le_mul_of_nonneg_left (h.trans htot) (by positivity : (0 : ℝ) ≤ 4 * M)
    have h3 : 25 * (n * Real.log 2) * (RB.card : ℝ) ≤ 8 * M * (n * Real.log 2) := by
      rw [← hlam4M]; linarith
    nlinarith
  have hLBc : 25 * (LB.card : ℝ) ≤ 8 * M := by
    have h := rs_left g hgm lam hlam 0 _ (4 * M) rfl (Nat.zero_le _) LB (by
      intro i hi
      rw [hLB, Finset.mem_filter, hU, Finset.mem_Icc] at hi
      exact ⟨by omega, by omega, hi.2⟩)
    have h5 := mul_le_mul_of_nonneg_left (h.trans htot) (by positivity : (0 : ℝ) ≤ 4 * M)
    have h3 : 25 * (n * Real.log 2) * (LB.card : ℝ) ≤ 8 * M * (n * Real.log 2) := by
      rw [← hlam4M]; linarith
    nlinarith
  have hNRc : (NR.card : ℝ) ≤ M / 2 - 2 := by
    have h := rs_right g' hg'm (1 / 2) (by norm_num) (4 * M) _ 0 rfl (Nat.zero_le _) NR (by
      intro i hi
      rw [hNR, Finset.mem_filter, hU, Finset.mem_Icc] at hi
      refine ⟨Nat.zero_le _, by omega, i + 1, by omega, by omega, ?_⟩
      have hle : f i ≤ f (i + 1) := hf (Nat.le_succ i)
      have hlt : f i + 1 ≤ f (i + 1) := by have := hi.2; omega
      have hlt' : (f i : ℝ) + 1 ≤ f (i + 1) := by exact_mod_cast hlt
      have hc : ((i + 1 : ℕ) : ℝ) - (i : ℝ) = 1 := by rw [Nat.cast_add, Nat.cast_one]; ring
      rw [hg', hg', hc]; linarith)
    linarith
  have hNLc : (NL.card : ℝ) ≤ M / 2 - 2 := by
    have h := rs_left g' hg'm (1 / 2) (by norm_num) 0 _ (4 * M) rfl (Nat.zero_le _) NL (by
      intro i hi
      rw [hNL, Finset.mem_filter, hU, Finset.mem_Icc] at hi
      refine ⟨by omega, by omega, i - 1, Nat.zero_le _, by omega, ?_⟩
      have hle : f (i - 1) ≤ f i := hf (Nat.sub_le i 1)
      have hlt : f (i - 1) + 1 ≤ f i := by have := hi.2; omega
      have hlt' : (f (i - 1) : ℝ) + 1 ≤ f i := by exact_mod_cast hlt
      have hc : (i : ℝ) - ((i - 1 : ℕ) : ℝ) = 1 := by
        rw [Nat.cast_sub (by omega : 1 ≤ i), Nat.cast_one]; ring
      rw [hg', hg', hc]; linarith)
    linarith
  have hUc : U.card = 2 * M + 1 := by
    rw [hU, Nat.card_Icc]; omega
  have hunion : ((RB ∪ LB ∪ NR ∪ NL).card : ℝ) < U.card := by
    have h1 : (RB ∪ LB ∪ NR ∪ NL).card ≤ RB.card + LB.card + NR.card + NL.card := by
      have a1 := Finset.card_union_le (RB ∪ LB ∪ NR) NL
      have a2 := Finset.card_union_le (RB ∪ LB) NR
      have a3 := Finset.card_union_le RB LB
      omega
    have h1' : ((RB ∪ LB ∪ NR ∪ NL).card : ℝ) ≤ RB.card + LB.card + NR.card + NL.card := by
      exact_mod_cast h1
    rw [hUc]; push_cast; linarith
  have hunion' : (RB ∪ LB ∪ NR ∪ NL).card < U.card := by exact_mod_cast hunion
  obtain ⟨i, hiU, hinot⟩ := Finset.exists_mem_notMem_of_card_lt_card hunion'
  simp only [Finset.mem_union, not_or] at hinot
  obtain ⟨⟨⟨hiRB, hiLB⟩, hiNR⟩, hiNL⟩ := hinot
  have hiU' := hiU
  rw [hU, Finset.mem_Icc] at hiU'
  obtain ⟨hMi, hi3M⟩ := hiU'
  refine ⟨i, hMi, hi3M, ?_, ?_, ?_⟩
  · by_contra hne
    exact hiNR (Finset.mem_filter.mpr ⟨hiU, Ne.symm hne⟩)
  · by_contra hne
    exact hiNL (Finset.mem_filter.mpr ⟨hiU, hne⟩)
  · intro k hk1 hkM
    have hexp : lam * k = 25 * n * k * Real.log 2 / (4 * M) := by rw [hlam_def]; ring
    constructor
    · have hnot : ¬ (g i + lam * (((i + k : ℕ) : ℝ) - (i : ℝ)) < g (i + k)) := fun h =>
        hiRB (Finset.mem_filter.mpr ⟨hiU, i + k, by omega, by omega, h⟩)
      push_neg at hnot
      have hc : ((i + k : ℕ) : ℝ) - (i : ℝ) = k := by rw [Nat.cast_add]; ring
      rw [hc, hg, hg] at hnot
      have hx := Real.exp_le_exp.mpr hnot
      rw [Real.exp_add, Real.exp_log (hfpos _), Real.exp_log (hfpos _), hexp] at hx
      linarith
    · have hnot : ¬ (g (i - k) + lam * ((i : ℝ) - ((i - k : ℕ) : ℝ)) < g i) := fun h =>
        hiLB (Finset.mem_filter.mpr ⟨hiU, i - k, Nat.zero_le _, by omega, h⟩)
      push_neg at hnot
      have hc : (i : ℝ) - ((i - k : ℕ) : ℝ) = k := by
        rw [Nat.cast_sub (by omega : k ≤ i)]; ring
      rw [hc, hg, hg] at hnot
      have hx := Real.exp_le_exp.mpr hnot
      rw [Real.exp_add, Real.exp_log (hfpos _), Real.exp_log (hfpos _), hexp] at hx
      linarith

theorem gi_regular_of_grid_good (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (hS : 1 ≤ S.card)
    (ρ η : ℝ) (M : ℕ) (hρ : 0 < ρ) (hη : 0 < η)
    (hM : (102 / 100 : ℝ) ≤ Real.exp (M * η))
    (hR : ∀ k : ℕ, 1 ≤ k → k ≤ M →
      ((giBohr P S (ρ * Real.exp (k * η))).card : ℝ)
        ≤ Real.exp (25 * S.card * k * η) * (giBohr P S ρ).card)
    (hL : ∀ k : ℕ, 1 ≤ k → k ≤ M →
      ((giBohr P S ρ).card : ℝ)
        ≤ Real.exp (25 * S.card * k * η) * (giBohr P S (ρ * Real.exp (-(k * η)))).card)
    (hFR : (giBohr P S (ρ * Real.exp η)).card = (giBohr P S ρ).card)
    (hFL : (giBohr P S (ρ * Real.exp (-η))).card = (giBohr P S ρ).card) :
    GiRegularBohr P S ρ :=
by
  classical
  obtain ⟨N, hN⟩ : ∃ N : ℝ → ℝ, N = fun r => ((giBohr P S r).card : ℝ) := ⟨_, rfl⟩
  have hmono : Monotone N := by
    intro r r' h
    rw [hN]
    simp only
    have hsub : giBohr P S r ⊆ giBohr P S r' := by
      intro x hx
      simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
      exact fun ξ hξ => lt_of_lt_of_le (hx ξ hξ) h
    exact_mod_cast Finset.card_le_card hsub
  have hN0 : 0 ≤ N ρ := by rw [hN]; positivity
  have hR' : ∀ k : ℕ, 1 ≤ k → k ≤ M →
      N (ρ * Real.exp (k * η)) ≤ Real.exp (25 * S.card * k * η) * N ρ := by
    intro k h1 h2; rw [hN]; exact hR k h1 h2
  have hL' : ∀ k : ℕ, 1 ≤ k → k ≤ M →
      N ρ ≤ Real.exp (25 * S.card * k * η) * N (ρ * Real.exp (-(k * η))) := by
    intro k h1 h2; rw [hN]; exact hL k h1 h2
  have hFR' : N (ρ * Real.exp η) = N ρ := by rw [hN]; simp only; exact_mod_cast hFR
  have hFL' : N (ρ * Real.exp (-η)) = N ρ := by rw [hN]; simp only; exact_mod_cast hFL
  have hn1 : (1 : ℝ) ≤ (S.card : ℝ) := by exact_mod_cast hS
  have hM1 : 1 ≤ M := by
    by_contra hcon
    have h0 : M = 0 := by omega
    rw [h0, Nat.cast_zero, zero_mul, Real.exp_zero] at hM
    norm_num at hM
  
  have hX2 : ∀ t : ℝ, 0 ≤ t → t ≤ 1 / 2 → Real.exp t ≤ 1 + 2 * t := by
    intro t ht0 ht1
    have h1 := Real.add_one_le_exp (-t)
    have e : Real.exp t * Real.exp (-t) = 1 := by rw [← Real.exp_add]; simp
    have h2 : Real.exp t * (1 - t) ≤ 1 := by
      have := mul_le_mul_of_nonneg_left (show -t + 1 ≤ Real.exp (-t) from h1)
        (Real.exp_pos t).le
      linarith
    nlinarith [Real.exp_pos t]
  
  have upper : ∀ κ : ℝ, 0 < κ → 100 * (S.card : ℝ) * κ ≤ 1 →
      N ((1 + κ) * ρ) ≤ (1 + 100 * (S.card : ℝ) * κ) * N ρ := by
    intro κ hκ hκn
    have hκ1 : κ ≤ 1 / 100 := by nlinarith
    have hQM : 1 ≤ M ∧ 1 + κ ≤ Real.exp (M * η) := ⟨hM1, by linarith⟩
    have hex : ∃ k : ℕ, 1 ≤ k ∧ 1 + κ ≤ Real.exp (k * η) := ⟨M, hQM⟩
    obtain ⟨K, hK1, hKe, hKM, hKmin⟩ : ∃ K : ℕ, 1 ≤ K ∧ 1 + κ ≤ Real.exp (K * η) ∧ K ≤ M ∧
        ∀ j : ℕ, j < K → 1 ≤ j → Real.exp (j * η) < 1 + κ := by
      refine ⟨Nat.find hex, (Nat.find_spec hex).1, (Nat.find_spec hex).2,
        Nat.find_min' hex hQM, ?_⟩
      intro j hj hj1
      have := Nat.find_min hex hj
      push_neg at this
      exact this hj1
    have hstep : N ((1 + κ) * ρ) ≤ N (ρ * Real.exp (K * η)) := by
      apply hmono
      rw [mul_comm]
      exact mul_le_mul_of_nonneg_left hKe hρ.le
    have hpos : 0 ≤ 100 * (S.card : ℝ) * κ * N ρ := by positivity
    rcases (show K = 1 ∨ 2 ≤ K by omega) with hK | hK
    · subst hK
      rw [Nat.cast_one, one_mul, hFR'] at hstep
      linarith
    · have hj := hKmin (K - 1) (by omega) (by omega)
      have hcast : ((K - 1 : ℕ) : ℝ) = (K : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega), Nat.cast_one]
      rw [hcast] at hj
      have hK2 : (2 : ℝ) ≤ (K : ℝ) := by exact_mod_cast hK
      have hlt : ((K : ℝ) - 1) * η < κ := by
        have := Real.add_one_le_exp κ
        rw [← Real.exp_lt_exp]
        linarith
      have hn0 : (0 : ℝ) ≤ (S.card : ℝ) := by linarith
      have ht : 25 * (S.card : ℝ) * K * η ≤ 50 * (S.card : ℝ) * κ := by
        have h1 : 25 * (S.card : ℝ) * K * η ≤ 25 * (S.card : ℝ) * (2 * ((K : ℝ) - 1)) * η := by
          apply mul_le_mul_of_nonneg_right _ hη.le
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          linarith
        have h2 : 50 * (S.card : ℝ) * (((K : ℝ) - 1) * η) ≤ 50 * (S.card : ℝ) * κ :=
          mul_le_mul_of_nonneg_left hlt.le (by positivity)
        nlinarith
      have ht0 : 0 ≤ 25 * (S.card : ℝ) * K * η := by positivity
      have hexp := hX2 _ ht0 (by linarith)
      have hRK := hR' K hK1 hKM
      have h3 : Real.exp (25 * (S.card : ℝ) * K * η) * N ρ
          ≤ (1 + 100 * (S.card : ℝ) * κ) * N ρ :=
        mul_le_mul_of_nonneg_right (by linarith) hN0
      linarith
  
  have lower : ∀ κ : ℝ, 0 < κ → 100 * (S.card : ℝ) * κ ≤ 1 →
      (1 - 100 * (S.card : ℝ) * κ) * N ρ ≤ N ((1 - κ) * ρ) := by
    intro κ hκ hκn
    have hκ1 : κ ≤ 1 / 100 := by nlinarith
    have h99 : (99 / 100 : ℝ) ≤ 1 - κ := by linarith
    have hQM : 1 ≤ M ∧ 1 ≤ Real.exp (M * η) * (1 - κ) := by
      refine ⟨hM1, ?_⟩
      have := mul_le_mul hM h99 (by norm_num) (Real.exp_pos _).le
      linarith
    have hex : ∃ k : ℕ, 1 ≤ k ∧ 1 ≤ Real.exp (k * η) * (1 - κ) := ⟨M, hQM⟩
    obtain ⟨K, hK1, hKe, hKM, hKmin⟩ : ∃ K : ℕ, 1 ≤ K ∧ 1 ≤ Real.exp (K * η) * (1 - κ) ∧
        K ≤ M ∧ ∀ j : ℕ, j < K → 1 ≤ j → Real.exp (j * η) * (1 - κ) < 1 := by
      refine ⟨Nat.find hex, (Nat.find_spec hex).1, (Nat.find_spec hex).2,
        Nat.find_min' hex hQM, ?_⟩
      intro j hj hj1
      have := Nat.find_min hex hj
      push_neg at this
      exact this hj1
    have hstep : N (ρ * Real.exp (-(K * η))) ≤ N ((1 - κ) * ρ) := by
      apply hmono
      have e : Real.exp (-(K * η)) * Real.exp (K * η) = 1 := by
        rw [← Real.exp_add]; simp
      have h1 : Real.exp (-(K * η)) ≤ 1 - κ := by
        have := mul_le_mul_of_nonneg_left hKe (Real.exp_pos (-(K * η))).le
        rw [mul_one, ← mul_assoc, e, one_mul] at this
        exact this
      rw [mul_comm]
      exact mul_le_mul_of_nonneg_right h1 hρ.le
    have hpos : 0 ≤ 100 * (S.card : ℝ) * κ * N ρ := by positivity
    rcases (show K = 1 ∨ 2 ≤ K by omega) with hK | hK
    · subst hK
      rw [Nat.cast_one, one_mul, hFL'] at hstep
      linarith
    · have hj := hKmin (K - 1) (by omega) (by omega)
      have hcast : ((K - 1 : ℕ) : ℝ) = (K : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega), Nat.cast_one]
      rw [hcast] at hj
      have hK2 : (2 : ℝ) ≤ (K : ℝ) := by exact_mod_cast hK
      have h2κ : 1 ≤ Real.exp (2 * κ) * (1 - κ) := by
        have h1 := Real.add_one_le_exp (2 * κ)
        have h2 : (2 * κ + 1) * (1 - κ) ≤ Real.exp (2 * κ) * (1 - κ) :=
          mul_le_mul_of_nonneg_right h1 (by linarith)
        nlinarith
      have hlt : ((K : ℝ) - 1) * η < 2 * κ := by
        rw [← Real.exp_lt_exp]
        exact lt_of_mul_lt_mul_right (hj.trans_le h2κ) (by linarith)
      have ht : 25 * (S.card : ℝ) * K * η ≤ 100 * (S.card : ℝ) * κ := by
        have h1 : 25 * (S.card : ℝ) * K * η ≤ 25 * (S.card : ℝ) * (2 * ((K : ℝ) - 1)) * η := by
          apply mul_le_mul_of_nonneg_right _ hη.le
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          linarith
        have h2 : 50 * (S.card : ℝ) * (((K : ℝ) - 1) * η) ≤ 50 * (S.card : ℝ) * (2 * κ) :=
          mul_le_mul_of_nonneg_left hlt.le (by positivity)
        nlinarith
      set t := 25 * (S.card : ℝ) * K * η with ht_def
      have hLK := hL' K hK1 hKM
      rw [← ht_def] at hLK
      have e : Real.exp (-t) * Real.exp t = 1 := by rw [← Real.exp_add]; simp
      have h4 : Real.exp (-t) * N ρ ≤ N (ρ * Real.exp (-(K * η))) := by
        have := mul_le_mul_of_nonneg_left hLK (Real.exp_pos (-t)).le
        rw [← mul_assoc, e, one_mul] at this
        exact this
      have h5 : -t + 1 ≤ Real.exp (-t) := Real.add_one_le_exp (-t)
      have h6 : (1 - 100 * (S.card : ℝ) * κ) * N ρ ≤ Real.exp (-t) * N ρ :=
        mul_le_mul_of_nonneg_right (by linarith) hN0
      linarith
  
  have key : ∀ κ : ℝ, 100 * (S.card : ℝ) * |κ| ≤ 1 →
      (1 - 100 * (S.card : ℝ) * |κ|) * N ρ ≤ N ((1 + κ) * ρ) ∧
      N ((1 + κ) * ρ) ≤ (1 + 100 * (S.card : ℝ) * |κ|) * N ρ := by
    intro κ hκ
    rcases lt_trichotomy κ 0 with hneg | hzero | hpos
    · rw [abs_of_neg hneg] at hκ ⊢
      have hle : (1 + κ) * ρ ≤ ρ := by nlinarith
      have hmle := hmono hle
      have hp : 0 ≤ 100 * (S.card : ℝ) * (-κ) * N ρ := by
        have : 0 ≤ -κ := by linarith
        positivity
      refine ⟨?_, by linarith⟩
      have := lower (-κ) (by linarith) hκ
      rw [sub_neg_eq_add] at this
      exact this
    · subst hzero
      simp
    · rw [abs_of_pos hpos] at hκ ⊢
      have hle : ρ ≤ (1 + κ) * ρ := by nlinarith
      have hmle := hmono hle
      have hp : 0 ≤ 100 * (S.card : ℝ) * κ * N ρ := by positivity
      exact ⟨by linarith, upper κ hpos hκ⟩
  intro κ hκ
  have := key κ hκ
  rw [hN] at this
  exact this

theorem gi_bohr_regular_exists (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ε : ℝ)
    (hε : 0 < ε) (hε' : ε ≤ 1 / 8) :
    ∃ ρ : ℝ, ε ≤ ρ ∧ ρ ≤ 2 * ε ∧ GiRegularBohr P S ρ :=
by
  classical
  
  have hmono : ∀ r r' : ℝ, r ≤ r' → giBohr P S r ⊆ giBohr P S r' := by
    intro r r' h x hx
    simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
    exact fun ξ hξ => lt_of_lt_of_le (hx ξ hξ) h
  
  have hzero : ∀ r : ℝ, 0 < r → (0 : ZMod P) ∈ giBohr P S r := by
    intro r hr
    simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and]
    intro ξ _
    have h0 : giCircNorm P (ξ * 0) = 0 := by simp [giCircNorm]
    rw [h0]; exact hr
  
  by_cases hS : S.card = 0
  · refine ⟨ε, le_refl _, by linarith, ?_⟩
    intro κ _
    have hS' : S = ∅ := Finset.card_eq_zero.mp hS
    have huniv : ∀ r, giBohr P S r = Finset.univ := by
      intro r; subst hS'; ext x; simp [giBohr]
    have h1 : giBohr P S ((1 + κ) * ε) = giBohr P S ε := by rw [huniv, huniv]
    rw [h1, hS]; simp
  
  have hn : 1 ≤ S.card := Nat.one_le_iff_ne_zero.mpr hS
  have hP : 1 ≤ P := Nat.one_le_iff_ne_zero.mpr (NeZero.ne P)
  obtain ⟨M, hM_def⟩ : ∃ M : ℕ, M = 4 * P := ⟨_, rfl⟩
  have hM1 : 1 ≤ M := by omega
  have hMpos : (0 : ℝ) < M := by exact_mod_cast hM1
  have hlog2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  obtain ⟨η, hη_def⟩ : ∃ η : ℝ, η = Real.log 2 / (4 * M) := ⟨_, rfl⟩
  have hη : 0 < η := by rw [hη_def]; positivity
  have h4Mη : (4 * (M : ℝ)) * η = Real.log 2 := by
    rw [hη_def]; field_simp
  have hMη : (M : ℝ) * η = Real.log 2 / 4 := by linarith
  obtain ⟨f, hf_def⟩ : ∃ f : ℕ → ℕ,
      ∀ i, f i = (giBohr P S (ε * Real.exp ((i : ℝ) * η))).card := ⟨_, fun _ => rfl⟩
  have hfmono : Monotone f := by
    intro i j hij
    rw [hf_def, hf_def]
    apply Finset.card_le_card
    apply hmono
    apply mul_le_mul_of_nonneg_left _ hε.le
    apply Real.exp_le_exp.mpr
    apply mul_le_mul_of_nonneg_right _ hη.le
    exact_mod_cast hij
  have hf0 : f 0 = (giBohr P S ε).card := by
    rw [hf_def]; simp only [Nat.cast_zero, zero_mul, Real.exp_zero, mul_one]
  have h0 : 1 ≤ f 0 := by
    rw [hf0]; exact Finset.card_pos.mpr ⟨0, hzero ε hε⟩
  have hrad4M : ε * Real.exp (((4 * M : ℕ) : ℝ) * η) = 2 * ε := by
    push_cast
    rw [h4Mη, Real.exp_log two_pos]; ring
  have hf4M : f (4 * M) = (giBohr P S (2 * ε)).card := by
    rw [hf_def, hrad4M]
  have hgrow : f (4 * M) ≤ 4 ^ S.card * f 0 := by
    rw [hf4M, hf0]; exact gi_bohr_card_two_mul_le P S ε hε
  have hsmall : 4 * f (4 * M) ≤ M := by
    have hle : f (4 * M) ≤ P := by
      rw [hf_def]
      exact (Finset.card_le_univ _).trans (by rw [ZMod.card])
    omega
  obtain ⟨i, hMi, hi3M, hFR, hFL, hslope⟩ :=
    nat_seq_exists_good_index S.card M hn hM1 f hfmono h0 hgrow hsmall
  obtain ⟨ρ, hρ_def⟩ : ∃ ρ : ℝ, ρ = ε * Real.exp ((i : ℝ) * η) := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρ_def]; positivity
  have hfi : f i = (giBohr P S ρ).card := by rw [hf_def, hρ_def]
  have hερ : ε ≤ ρ := by
    rw [hρ_def]
    exact le_mul_of_one_le_right hε.le (Real.one_le_exp (by positivity))
  have hρ2 : ρ ≤ 2 * ε := by
    rw [hρ_def]
    have hiM : (i : ℝ) ≤ 4 * (M : ℝ) := by
      have : i ≤ 4 * M := by omega
      exact_mod_cast this
    have h1 : Real.exp ((i : ℝ) * η) ≤ 2 := by
      calc Real.exp ((i : ℝ) * η) ≤ Real.exp ((4 * (M : ℝ)) * η) :=
            Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hiM hη.le)
        _ = 2 := by rw [h4Mη, Real.exp_log two_pos]
    have := mul_le_mul_of_nonneg_left h1 hε.le
    linarith
  have hexpo : ∀ k : ℕ, Real.exp (25 * (S.card : ℝ) * k * η)
      = Real.exp (25 * S.card * k * Real.log 2 / (4 * M)) := by
    intro k; rw [hη_def]; congr 1; ring
  refine ⟨ρ, hερ, hρ2, ?_⟩
  apply gi_regular_of_grid_good P S hn ρ η M hρ hη
  · 
    have h1 := Real.add_one_le_exp ((M : ℝ) * η)
    have h2 := Real.log_two_gt_d9
    rw [hMη] at h1 ⊢
    linarith
  · intro k hk1 hkM
    have e1 : ρ * Real.exp ((k : ℝ) * η) = ε * Real.exp (((i + k : ℕ) : ℝ) * η) := by
      rw [hρ_def]; push_cast; rw [add_mul, Real.exp_add]; ring
    rw [e1, ← hf_def (i + k), ← hfi, hexpo k]
    exact (hslope k hk1 hkM).1
  · intro k hk1 hkM
    have e2 : ρ * Real.exp (-((k : ℝ) * η)) = ε * Real.exp (((i - k : ℕ) : ℝ) * η) := by
      rw [hρ_def, Nat.cast_sub (by omega), sub_mul, Real.exp_sub, Real.exp_neg]
      ring
    rw [e2, ← hf_def (i - k), ← hfi, hexpo k]
    exact (hslope k hk1 hkM).2
  · have e3 : ρ * Real.exp η = ε * Real.exp (((i + 1 : ℕ) : ℝ) * η) := by
      rw [hρ_def]; push_cast; rw [add_mul, one_mul, Real.exp_add]; ring
    rw [e3, ← hf_def (i + 1), ← hfi]
    exact hFR
  · have e4 : ρ * Real.exp (-η) = ε * Real.exp (((i - 1 : ℕ) : ℝ) * η) := by
      rw [hρ_def, Nat.cast_sub (by omega), Nat.cast_one, sub_mul, one_mul, Real.exp_sub,
        Real.exp_neg]
      ring
    rw [e4, ← hf_def (i - 1), ← hfi]
    exact hFL

theorem gi_bohr_narrow_facts (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ρ ρ₁ : ℝ)
    (hρ : 0 < ρ) (hρ₁ : 0 < ρ₁) (hsmall : ρ₁ ≤ ρ / (100 * ((S.card : ℝ) + 1)))
    (hreg : GiRegularBohr P S ρ) :
    (∀ x ∈ giBohr P S ρ, ∀ y ∈ giBohr P S ρ₁,
       x + y ∈ giBohr P S (ρ + ρ₁) ∧ x - y ∈ giBohr P S (ρ + ρ₁)) ∧
    ((giBohr P S (ρ + ρ₁)).card : ℝ) ≤ 2 * (giBohr P S ρ).card ∧
    ∀ A ⊆ giBohr P S ρ, ∃ y : ZMod P,
      (A.card : ℝ) * (giBohr P S ρ₁).card
        ≤ 2 * (giBohr P S ρ).card * ((giBohr P S ρ₁).filter (fun b => y + b ∈ A)).card :=
by
  have real_fact : ∀ u w s : ℝ, 0 ≤ u → u < 1 → 0 ≤ w → w < 1 →
      (s = u + w ∨ s = u + w - 1) → min s (1 - s) ≤ min u (1 - u) + min w (1 - w) := by
    intro u w s hu0 hu1 hw0 hw1 hs
    rcases hs with hs | hs <;> subst hs <;>
    rcases min_choice u (1 - u) with h1 | h1 <;> rcases min_choice w (1 - w) with h2 | h2 <;>
    rw [h1, h2] <;>
    first
    | exact min_le_of_left_le (by linarith)
    | exact min_le_of_right_le (by linarith)
  have tri : ∀ x y : ZMod P, giCircNorm P (x + y) ≤ giCircNorm P x + giCircNorm P y := by
    intro x y
    have hP : (0 : ℝ) < P := by exact_mod_cast (NeZero.pos P)
    have hx := ZMod.val_lt x
    have hy := ZMod.val_lt y
    have hxy : (x + y).val = (x.val + y.val) % P := ZMod.val_add x y
    have key : ((x + y).val : ℝ) = (x.val : ℝ) + y.val ∨
        ((x + y).val : ℝ) = (x.val : ℝ) + y.val - P := by
      rw [hxy]
      by_cases hlt : x.val + y.val < P
      · left
        rw [Nat.mod_eq_of_lt hlt]
        push_cast
        ring
      · right
        push_neg at hlt
        have h1 : (x.val + y.val) % P = x.val + y.val - P := by
          rw [Nat.mod_eq_sub_mod hlt, Nat.mod_eq_of_lt (by omega)]
        rw [h1, Nat.cast_sub hlt]
        push_cast
        ring
    have hxP : (x.val : ℝ) < P := by exact_mod_cast hx
    have hyP : (y.val : ℝ) < P := by exact_mod_cast hy
    unfold giCircNorm
    apply real_fact
    · exact div_nonneg (Nat.cast_nonneg _) hP.le
    · exact (div_lt_one hP).mpr hxP
    · exact div_nonneg (Nat.cast_nonneg _) hP.le
    · exact (div_lt_one hP).mpr hyP
    · rcases key with hc | hc
      · left
        rw [hc, add_div]
      · right
        rw [hc, sub_div, add_div, div_self hP.ne']
  have hneg : ∀ a : ZMod P, giCircNorm P (-a) = giCircNorm P a := by
    intro a
    by_cases ha : a = 0
    · rw [ha, neg_zero]
    · have hP : (0 : ℝ) < P := by exact_mod_cast (NeZero.pos P)
      have hv : (-a).val = P - a.val := by rw [ZMod.neg_val, if_neg ha]
      have hlt : a.val < P := ZMod.val_lt a
      have hcast : (((-a).val : ℕ) : ℝ) = (P : ℝ) - (a.val : ℝ) := by
        rw [hv, Nat.cast_sub hlt.le]
      unfold giCircNorm
      rw [hcast, sub_div, div_self hP.ne', sub_sub_cancel, min_comm]
  have mem : ∀ (r : ℝ) (x : ZMod P),
      x ∈ giBohr P S r ↔ ∀ ξ ∈ S, giCircNorm P (ξ * x) < r := by
    intro r x
    simp [giBohr]
  have part1 : ∀ x ∈ giBohr P S ρ, ∀ y ∈ giBohr P S ρ₁,
      x + y ∈ giBohr P S (ρ + ρ₁) ∧ x - y ∈ giBohr P S (ρ + ρ₁) := by
    intro x hx y hy
    rw [mem] at hx hy
    constructor
    · rw [mem]
      intro ξ hξ
      rw [mul_add]
      exact lt_of_le_of_lt (tri _ _) (add_lt_add (hx ξ hξ) (hy ξ hξ))
    · rw [mem]
      intro ξ hξ
      rw [mul_sub, sub_eq_add_neg]
      have h := tri (ξ * x) (-(ξ * y))
      rw [hneg] at h
      exact lt_of_le_of_lt h (add_lt_add (hx ξ hξ) (hy ξ hξ))
  have part2 : ((giBohr P S (ρ + ρ₁)).card : ℝ) ≤ 2 * (giBohr P S ρ).card := by
    have hs0 : (0 : ℝ) ≤ (S.card : ℝ) := Nat.cast_nonneg _
    have hκpos : 0 < ρ₁ / ρ := div_pos hρ₁ hρ
    have h1 : ρ₁ * (100 * ((S.card : ℝ) + 1)) ≤ ρ := (le_div_iff₀ (by positivity)).mp hsmall
    have hκle : 100 * (S.card : ℝ) * (ρ₁ / ρ) ≤ 1 := by
      rw [← mul_div_assoc, div_le_one hρ]
      nlinarith
    have hrad : (1 + ρ₁ / ρ) * ρ = ρ + ρ₁ := by
      rw [add_mul, one_mul, div_mul_cancel₀ _ hρ.ne']
    have h := (hreg (ρ₁ / ρ) (by rw [abs_of_pos hκpos]; exact hκle)).2
    rw [hrad, abs_of_pos hκpos] at h
    have hB : (0 : ℝ) ≤ (giBohr P S ρ).card := Nat.cast_nonneg _
    calc ((giBohr P S (ρ + ρ₁)).card : ℝ)
        ≤ (1 + 100 * (S.card : ℝ) * (ρ₁ / ρ)) * (giBohr P S ρ).card := h
      _ ≤ 2 * (giBohr P S ρ).card := mul_le_mul_of_nonneg_right (by linarith) hB
  refine ⟨part1, part2, ?_⟩
  intro A hA
  have hT : ∀ a ∈ A, ∀ b ∈ giBohr P S ρ₁, a - b ∈ giBohr P S (ρ + ρ₁) :=
    fun a ha b hb => (part1 a (hA ha) b hb).2
  let f : ZMod P → ℕ := fun y => ((giBohr P S ρ₁).filter (fun b => y + b ∈ A)).card
  have hsum : ∑ y : ZMod P, f y = A.card * (giBohr P S ρ₁).card := by
    have hf : ∀ y, f y = ∑ b ∈ giBohr P S ρ₁, if y + b ∈ A then 1 else 0 := fun y => by
      simp only [f]
      rw [Finset.card_filter]
    rw [Finset.sum_congr rfl (fun y _ => hf y), Finset.sum_comm]
    have h2 : ∀ b : ZMod P, ∑ y : ZMod P, (if y + b ∈ A then 1 else 0) = A.card := by
      intro b
      rw [Fintype.sum_equiv (Equiv.addRight b) (fun y => if y + b ∈ A then 1 else 0)
        (fun z => if z ∈ A then 1 else 0) (fun y => rfl)]
      rw [Finset.sum_boole]
      simp
    rw [Finset.sum_congr rfl (fun b _ => h2 b), Finset.sum_const, smul_eq_mul, mul_comm]
  have hsupp : ∑ y : ZMod P, f y = ∑ y ∈ giBohr P S (ρ + ρ₁), f y := by
    symm
    apply Finset.sum_subset (Finset.subset_univ _)
    intro y _ hy
    simp only [f]
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro b hb hyb
    apply hy
    have h := hT (y + b) hyb b hb
    simpa using h
  have hTne : (giBohr P S (ρ + ρ₁)).Nonempty := by
    refine ⟨0, ?_⟩
    rw [mem]
    intro ξ _
    have h0 : giCircNorm P (ξ * 0) = 0 := by simp [giCircNorm]
    rw [h0]
    linarith
  obtain ⟨y, _, hy⟩ : ∃ y ∈ giBohr P S (ρ + ρ₁),
      A.card * (giBohr P S ρ₁).card ≤ (giBohr P S (ρ + ρ₁)).card * f y := by
    refine Finset.exists_le_of_sum_le (f := fun _ => A.card * (giBohr P S ρ₁).card)
      (g := fun y => (giBohr P S (ρ + ρ₁)).card * f y) hTne ?_
    show ∑ _y ∈ giBohr P S (ρ + ρ₁), A.card * (giBohr P S ρ₁).card
      ≤ ∑ y ∈ giBohr P S (ρ + ρ₁), (giBohr P S (ρ + ρ₁)).card * f y
    rw [Finset.sum_const, smul_eq_mul, ← Finset.mul_sum, ← hsupp, hsum]
  refine ⟨y, ?_⟩
  have hy' : (A.card : ℝ) * (giBohr P S ρ₁).card
      ≤ ((giBohr P S (ρ + ρ₁)).card : ℝ) * (f y : ℝ) := by exact_mod_cast hy
  have hf0 : (0 : ℝ) ≤ (f y : ℝ) := Nat.cast_nonneg _
  calc (A.card : ℝ) * (giBohr P S ρ₁).card
      ≤ ((giBohr P S (ρ + ρ₁)).card : ℝ) * (f y : ℝ) := hy'
    _ ≤ 2 * (giBohr P S ρ).card * (f y : ℝ) := mul_le_mul_of_nonneg_right part2 hf0

theorem gi_croot_sisask : ∃ C : ℕ, 1 ≤ C ∧
    ∀ (P : ℕ) [NeZero P] (M S₀ L : Finset (ZMod P)) (K ε : ℝ) (q : ℕ),
      M.Nonempty → S₀.Nonempty → 1 ≤ q → 0 < ε → ε ≤ 1 →
