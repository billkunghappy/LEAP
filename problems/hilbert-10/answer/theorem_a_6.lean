      G (I : Ideal (NumberField.RingOfIntegers K)))
        = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) :=
    tsum_congr (fun I => hG _)
  have hprod : (∏ P ∈ Pq, (1 - G P))
      = ∏ P ∈ Pq, (1 - ((Ideal.absNorm P : ℂ) ^ (-s))) :=
    Finset.prod_congr rfl (fun P _ => by rw [hG])
  rw [hchar, key Pq hprime, hDed, hprod]

theorem kai_hecke_centre_logsum_bounds_00 (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hL : KaiZFLandauExpProp) (hcont : KaiZFZetaContProp K) (hser : KaiZFSeriesBasicsProp K) :
    ∃ T : ℝ, 1 ≤ T ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam →
        ∀ (E : ℕ) (G : ℂ → ℂ), E ≤ 1 → (E = 1 ↔ KaiHeckePrincipal K q lam) →
          Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) →
          (∀ ρ : ℂ, G ρ = 0 → ρ.re ≤ 1) ∧
          ∀ (c Λ : ℝ) (z : ℂ), 0 < c → c ≤ 1 → 1 ≤ Λ →
            z.re = 1 + c / Λ →
            Real.log (3 + (Ideal.absNorm q : ℝ) * 2 * (3 + |z.im|)) ≤ 2 * Λ →
            (kaiZFHeckeLogSum K lam z).re
                ≤ (E : ℝ) * (1 / (z - 1)).re + T * (1 + Real.log (1 / c)) * Λ ∧
            (∀ s : ℂ, G s = 0 → s.im = z.im → z.re - 1 / 2 ≤ s.re →
              (kaiZFHeckeLogSum K lam z).re
                ≤ (E : ℝ) * (1 / (z - 1)).re - 1 / (z.re - s.re)
                  + T * (1 + Real.log (1 / c)) * Λ) :=
by
  classical
  
  have hland : ∃ CL : ℝ, 0 < CL ∧
      ∀ (n : ℕ) (A Λ c : ℝ) (G : ℂ → ℂ) (z : ℂ),
        1 ≤ A → 1 ≤ Λ → 0 < c → c ≤ 1 → Differentiable ℂ G →
        z.re = 1 + c / Λ →
        (∀ w ∈ Metric.closedBall z 1, ∃ X : ℝ, 0 ≤ X ∧ X ≤ Real.exp (2 * Λ) ∧
            ‖G w‖ ≤ A * X ^ A) →
        G z ≠ 0 →
        1 ≤ ‖G z‖ * (1 + 1 / (z.re - 1)) ^ (n + 1) →
        ∃ (Z : Finset ℂ) (mult : ℂ → ℕ),
          (∀ ρ ∈ Z, ρ ∈ Metric.closedBall z (1 / 2) ∧ G ρ = 0 ∧ 1 ≤ mult ρ) ∧
          (∀ ρ : ℂ, ρ ∈ Metric.closedBall z (1 / 2) → G ρ = 0 → ρ ∈ Z) ∧
          ‖deriv G z / G z - ∑ ρ ∈ Z, (mult ρ : ℂ) / (z - ρ)‖
            ≤ CL * (2 * A + Real.log A + ((n : ℝ) + 1) * (2 + Real.log (1 / c))) * Λ := by
    obtain ⟨CL, hCL, hLan⟩ := hL
    refine ⟨CL, hCL, ?_⟩
    intro n A Λ c G z hA hΛ hc0 hc1 hG hzre hgrowth hGz hlow
    obtain ⟨A₂, hA₂_def⟩ : ∃ A₂ : ℝ,
        A₂ = 2 * A + Real.log A + ((n : ℝ) + 1) * (2 + Real.log (1 / c)) := ⟨_, rfl⟩
    have hlogA : 0 ≤ Real.log A := Real.log_nonneg hA
    have hc1' : 1 ≤ 1 / c := by rw [le_div_iff₀ hc0]; linarith
    have hcinv : 0 < 1 / c := one_div_pos.2 hc0
    have hlogc : 0 ≤ Real.log (1 / c) := Real.log_nonneg hc1'
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hnc : 0 ≤ ((n : ℝ) + 1) * Real.log (1 / c) := mul_nonneg (by linarith) hlogc
    have hA₂4 : 4 ≤ A₂ := by
      have e : ((n : ℝ) + 1) * (2 + Real.log (1 / c))
          = 2 * ((n : ℝ) + 1) + ((n : ℝ) + 1) * Real.log (1 / c) := by ring
      rw [hA₂_def, e]; linarith
    have hM3 : 3 ≤ Real.exp (A₂ * Λ) := by
      have := Real.add_one_le_exp (A₂ * Λ)
      nlinarith
    have hV : 0 < ‖G z‖ := norm_pos_iff.2 hGz
    have hup : ∀ w ∈ Metric.closedBall z 1,
        ‖G w‖ ≤ Real.exp ((Real.log A + 2 * A) * Λ) := by
      intro w hw
      obtain ⟨X, hX0, hXle, hGw⟩ := hgrowth w hw
      have h1 : X ^ A ≤ (Real.exp (2 * Λ)) ^ A := Real.rpow_le_rpow hX0 hXle (by linarith)
      have h2 : (Real.exp (2 * Λ)) ^ A = Real.exp (A * (2 * Λ)) := by
        rw [← Real.exp_mul]; congr 1; ring
      have h4 : A = Real.exp (Real.log A) := (Real.exp_log (by linarith)).symm
      have h6 : Real.log A * 1 ≤ Real.log A * Λ := mul_le_mul_of_nonneg_left hΛ hlogA
      calc ‖G w‖ ≤ A * X ^ A := hGw
        _ ≤ A * Real.exp (A * (2 * Λ)) := by
            rw [← h2]; exact mul_le_mul_of_nonneg_left h1 (by linarith)
        _ = Real.exp (Real.log A + A * (2 * Λ)) := by
            rw [Real.exp_add, ← h4]
        _ ≤ Real.exp ((Real.log A + 2 * A) * Λ) := by
            apply Real.exp_le_exp.2
            nlinarith
    have hinv : 1 / (z.re - 1) = Λ / c := by
      rw [hzre, add_sub_cancel_left, one_div_div]
    have hΛc : 0 ≤ Λ / c := div_nonneg (by linarith) hc0.le
    have hbase : 1 + 1 / (z.re - 1) ≤ Real.exp ((2 + Real.log (1 / c)) * Λ) := by
      rw [hinv]
      have h1 : 1 + Λ / c ≤ (1 + Λ) * (1 / c) := by
        have e : (1 + Λ) * (1 / c) = 1 / c + Λ / c := by ring
        rw [e]; linarith
      have h2 : 1 + Λ ≤ Real.exp Λ := by
        have := Real.add_one_le_exp Λ; linarith
      have h3 : 1 / c ≤ Real.exp (Real.log (1 / c) * Λ) := by
        have h6 : Real.log (1 / c) * 1 ≤ Real.log (1 / c) * Λ :=
          mul_le_mul_of_nonneg_left hΛ hlogc
        calc 1 / c = Real.exp (Real.log (1 / c)) := (Real.exp_log hcinv).symm
          _ ≤ Real.exp (Real.log (1 / c) * Λ) := Real.exp_le_exp.2 (by linarith)
      calc 1 + Λ / c ≤ (1 + Λ) * (1 / c) := h1
        _ ≤ Real.exp Λ * Real.exp (Real.log (1 / c) * Λ) :=
            mul_le_mul h2 h3 hcinv.le (Real.exp_pos _).le
        _ = Real.exp (Λ + Real.log (1 / c) * Λ) := (Real.exp_add _ _).symm
        _ ≤ Real.exp ((2 + Real.log (1 / c)) * Λ) := Real.exp_le_exp.2 (by nlinarith)
    have hbase0 : 0 ≤ 1 + 1 / (z.re - 1) := by rw [hinv]; linarith
    have hfac : (1 + 1 / (z.re - 1)) ^ (n + 1)
        ≤ Real.exp (((n : ℝ) + 1) * ((2 + Real.log (1 / c)) * Λ)) := by
      calc (1 + 1 / (z.re - 1)) ^ (n + 1)
          ≤ (Real.exp ((2 + Real.log (1 / c)) * Λ)) ^ (n + 1) :=
            pow_le_pow_left₀ hbase0 hbase _
        _ = Real.exp (((n : ℝ) + 1) * ((2 + Real.log (1 / c)) * Λ)) := by
            rw [← Real.exp_nat_mul, Nat.cast_add, Nat.cast_one]
    have hball : ∀ w ∈ Metric.closedBall z 1, ‖G w‖ ≤ Real.exp (A₂ * Λ) * ‖G z‖ := by
      intro w hw
      have hU := hup w hw
      have hU0 : 0 ≤ ‖G w‖ := norm_nonneg _
      have hP0 : 0 ≤ (1 + 1 / (z.re - 1)) ^ (n + 1) := pow_nonneg hbase0 _
      have e : Real.exp (A₂ * Λ) = Real.exp ((Real.log A + 2 * A) * Λ)
          * Real.exp (((n : ℝ) + 1) * ((2 + Real.log (1 / c)) * Λ)) := by
        rw [← Real.exp_add, hA₂_def]; congr 1; ring
      calc ‖G w‖ ≤ ‖G w‖ * (‖G z‖ * (1 + 1 / (z.re - 1)) ^ (n + 1)) :=
            le_mul_of_one_le_right hU0 hlow
        _ = ‖G z‖ * (‖G w‖ * (1 + 1 / (z.re - 1)) ^ (n + 1)) := by ring
        _ ≤ ‖G z‖ * (Real.exp ((Real.log A + 2 * A) * Λ)
              * Real.exp (((n : ℝ) + 1) * ((2 + Real.log (1 / c)) * Λ))) := by
            apply mul_le_mul_of_nonneg_left _ hV.le
            exact mul_le_mul hU hfac hP0 (Real.exp_pos _).le
        _ = Real.exp (A₂ * Λ) * ‖G z‖ := by rw [e]; ring
    obtain ⟨Z, mult, h1, h2, -, -, h5⟩ :=
      hLan G z 1 (Real.exp (A₂ * Λ)) hG one_pos hM3 hGz hball
    refine ⟨Z, mult, h1, h2, ?_⟩
    have := h5 z (Metric.mem_closedBall_self (by norm_num)) hGz
    rw [Real.log_exp, div_one, hA₂_def] at this
    exact this.trans (le_of_eq (by ring))
  
  have hhalf : ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam →
        ∀ (E : ℕ) (G : ℂ → ℂ), E ≤ 1 →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) →
          ∀ z : ℂ, 1 < z.re →
            G z ≠ 0 ∧
            1 ≤ ‖G z‖ * (1 + 1 / (z.re - 1)) ^ (Module.finrank ℚ K + 1) ∧
            deriv G z / G z = - kaiZFHeckeLogSum K lam z + (E : ℂ) / (z - 1) := by
    obtain ⟨DK, -, -, -, hbas⟩ := hser
    intro q hq ξ η lam hext E G hE hGeq z hz
    obtain ⟨-, hlow, -, hderiv, -⟩ := hbas q ξ η lam hq hext
    have hlowz := hlow z hz
    have hLz0 : kaiHeckeSeries K lam z ≠ 0 := by
      intro h0; rw [h0, norm_zero, zero_mul] at hlowz; linarith
    have hnz1 : z.re - 1 ≤ ‖z - 1‖ := by
      have := Complex.re_le_norm (z - 1)
      simpa using this
    have hz1 : z - 1 ≠ 0 := by
      intro h0; rw [h0, norm_zero] at hnz1; linarith
    have hGz : G z = kaiHeckeSeries K lam z * (z - 1) ^ E := (hGeq z hz).symm
    refine ⟨?_, ?_, ?_⟩
    · rw [hGz]; exact mul_ne_zero hLz0 (pow_ne_zero _ hz1)
    · have hinv0 : 0 ≤ 1 / (z.re - 1) := by
        have : 0 < z.re - 1 := by linarith
        positivity
      have hfac : 1 ≤ ‖z - 1‖ ^ E * (1 + 1 / (z.re - 1)) := by
        rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hE with h | h
        · subst h; rw [pow_zero, one_mul]; linarith
        · subst h
          rw [pow_one]
          have hδ : z.re - 1 ≠ 0 := by linarith
          have e : (z.re - 1) * (1 + 1 / (z.re - 1)) = z.re - 1 + 1 := by
            field_simp
          calc (1 : ℝ) ≤ (z.re - 1) * (1 + 1 / (z.re - 1)) := by rw [e]; linarith
            _ ≤ ‖z - 1‖ * (1 + 1 / (z.re - 1)) :=
              mul_le_mul_of_nonneg_right hnz1 (by linarith)
      rw [hGz, norm_mul, norm_pow, pow_succ]
      calc (1 : ℝ) ≤ (‖kaiHeckeSeries K lam z‖ * (1 + 1 / (z.re - 1)) ^ Module.finrank ℚ K)
            * (‖z - 1‖ ^ E * (1 + 1 / (z.re - 1))) := one_le_mul_of_one_le_of_one_le hlowz hfac
        _ = ‖kaiHeckeSeries K lam z‖ * ‖z - 1‖ ^ E
            * ((1 + 1 / (z.re - 1)) ^ Module.finrank ℚ K * (1 + 1 / (z.re - 1))) := by ring
