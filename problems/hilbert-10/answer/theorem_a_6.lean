  obtain ⟨-, hT1, hbig⟩ := kai_qwi_param_bounds ν δ hδ hδ1
  set T : ℝ := ((5 * 2 ^ (2 * ν + 7) * (2 ^ (ν + 2)) ^ (ν * ν)
      * (1 + 7 * (2 * (ν : ℝ) + 1) * 2 ^ (3 * ν + 1))) / δ) ^ (4 * ν * ν + 14) with hTdef
  by_cases hNT : (N : ℝ) ^ 2 ≤ T
