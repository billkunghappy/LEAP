noncomputable def kaiHeckeTwist (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K))
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (x : NumberField.RingOfIntegers K) : ℂ :=
  if hx : IsUnit (Ideal.Quotient.mk q x) then
    (ξ hx.unit : ℂ)
      * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if η w then
            ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
          else 1)
      * Complex.exp (Complex.I *
          (∑ w : NumberField.InfinitePlace K,
            (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ)))
      * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
            ((((NumberField.mixedEmbedding K ((x : K))).2 w).arg : ℝ) : ℂ)))
  else 0


def KaiHeckeExt (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K))
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ) : Prop :=
  lam 1 = 1 ∧
  (∀ I J : Ideal (NumberField.RingOfIntegers K), lam (I * J) = lam I * lam J) ∧
  (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → ‖lam I‖ = 1) ∧
  (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q ≠ ⊤ → lam I = 0) ∧
  lam 0 = 0 ∧
  (∀ α : NumberField.RingOfIntegers K, α ≠ 0 →
      lam (Ideal.span {α}) = kaiHeckeTwist K q t l ξ η α)


def KaiHeckePrincipal (K : Type u) [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K))
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ) : Prop :=
  ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → lam I = 1


noncomputable def kaiHeckeSeries (K : Type u) [Field K] [NumberField K]
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ) (s : ℂ) : ℂ :=
  ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
    lam (I : Ideal (NumberField.RingOfIntegers K)) /
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)


def IsLPExceptional (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B₀ Q : ℝ) (𝔮 : Ideal (NumberField.RingOfIntegers K))
    (ψ : NumberField.RingOfIntegers K → ℤ) (β : ℝ)
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ) : Prop :=
  𝔮 ≠ ⊥ ∧
  (ψ = 0 ∨
    (IsRealRayChar 𝔮 ψ ∧ (Ideal.absNorm 𝔮 : ℝ) ≤ Q ∧ 1 - B₀ / Real.log Q ≤ β ∧ β < 1 ∧
      (∃ (ξ : ((NumberField.RingOfIntegers K ⧸ 𝔮)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          KaiHeckeExt K 𝔮 0 0 ξ η lam) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) ∧
      ¬ KaiHeckePrincipal K 𝔮 lam ∧
      (∀ x : NumberField.RingOfIntegers K, x ≠ 0 → IsCoprime (Ideal.span {x}) 𝔮 →
          lam (Ideal.span {x}) = ((ψ x : ℤ) : ℂ)) ∧
      (∀ G : ℂ → ℂ, Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s) → G (β : ℂ) = 0))) ∧
  (∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 → (Ideal.absNorm q : ℝ) ≤ Q →
    ∀ (ξ' : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
      (η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (lam' : Ideal (NumberField.RingOfIntegers K) → ℂ),
      KaiHeckeExt K q 0 0 ξ' η' lam' →
      (∀ I : Ideal (NumberField.RingOfIntegers K), lam' I = (starRingEnd ℂ) (lam' I)) →
      ¬ KaiHeckePrincipal K q lam' →
      ∀ G' : ℂ → ℂ, Differentiable ℂ G' →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam' s = G' s) →
        ∀ β' : ℝ, 1 - B₀ / Real.log Q ≤ β' → β' < 1 → G' (β' : ℂ) = 0 →
          ψ ≠ 0 ∧ β' = β ∧
            ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → I ⊔ 𝔮 = ⊤ →
              lam' I = lam I)

