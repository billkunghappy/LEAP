  rw [hsum]
  have hA : (∑ P ∈ hfin.toFinset, Real.log (Ideal.absNorm P))
      ≤ ∑ P ∈ hfin.toFinset,
          ((Module.finrank ℚ K : ℝ) * Real.log ((rchar P : ℕ) : ℝ)) := by
    refine Finset.sum_le_sum ?_
    intro P hP
    obtain ⟨hP1, hP2, hP3⟩ := hfin.mem_toFinset.mp hP
    obtain ⟨hp, hf1, hNP⟩ := hcol1 P hP1 hP2
    have hcast : ((Ideal.absNorm P : ℕ) : ℝ) = ((rchar P : ℕ) : ℝ) ^ (rdeg P) := by
