    calc _ ≤ Real.sqrt ((2 * ((giBohr P S₃ ρ₄).card : ℝ)) ^ 2) := Real.sqrt_le_sqrt h1
      _ = _ := Real.sqrt_sq (by positivity)
  have hmain : η / 8 * ((giBohr P S₃ ρ₅).card : ℝ) ≤ ‖∑ z ∈ giBohr P S₃ ρ₅,
      (((g (y + z) : ℝ) : ℂ) * giE (((M z * z - (ξ₀ + 2 * M h') * (y + z)).val : ℝ) / P)) *
        giE (-(((ζ * z).val : ℝ) / P))‖ := by
    have h1 : (η / 2 - η / 4) * ((giBohr P S₃ ρ₄).card : ℝ) * ((giBohr P S₃ ρ₅).card : ℝ) ≤
        Real.sqrt (((giBohr P S₃ ρ₄).card : ℝ) *
          (((giBohr P S₃ ρ₄ ×ˢ giBohr P S₃ ρ₅).image (fun p => p.1 + p.2)).card : ℝ)) *
        ‖∑ z ∈ giBohr P S₃ ρ₅,
          (((g (y + z) : ℝ) : ℂ) * giE (((M z * z - (ξ₀ + 2 * M h') * (y + z)).val : ℝ) / P)) *
            giE (-(((ζ * z).val : ℝ) / P))‖ := hW.trans hζ
    have h3 := mul_le_mul_of_nonneg_right hsqrt (norm_nonneg (∑ z ∈ giBohr P S₃ ρ₅,
      (((g (y + z) : ℝ) : ℂ) * giE (((M z * z - (ξ₀ + 2 * M h') * (y + z)).val : ℝ) / P)) *
        giE (-(((ζ * z).val : ℝ) / P))))
    have h4 : ((giBohr P S₃ ρ₄).card : ℝ) * (η / 8 * ((giBohr P S₃ ρ₅).card : ℝ)) ≤
        ((giBohr P S₃ ρ₄).card : ℝ) * ‖∑ z ∈ giBohr P S₃ ρ₅,
          (((g (y + z) : ℝ) : ℂ) * giE (((M z * z - (ξ₀ + 2 * M h') * (y + z)).val : ℝ) / P)) *
            giE (-(((ζ * z).val : ℝ) / P))‖ := by
      nlinarith
    exact le_of_mul_le_mul_left h4 hB₄pos
  
  refine ⟨S₃, ρ₅, y, fun z => ((((ξ₀ + 2 * M h') * y + ((ξ₀ + 2 * M h') + ζ) * (z - y)
      - M (z - y) * (z - y)).val : ℝ) / P), by linarith, by rw [hη22]; exact hR6,
      by linarith, hreg₅, ?_, ?_⟩
  · exact gi_quadratic_phase_locquad P (giBohr P S₁ ρ₀) (giBohr P S₃ ρ₅) M y
      ((ξ₀ + 2 * M h') * y) ((ξ₀ + 2 * M h') + ζ) h0B₀ hM0 hFr
      (fun u hu => hB₀ ρ₅ u hu (by linarith))
      (fun u hu v hv => by
        rw [sub_eq_add_neg]
        exact hB₀ (ρ₅ + ρ₅) _ (hBadd₃ ρ₅ ρ₅ u (-v) hu (hBneg₃ ρ₅ v hv)) (by linarith))
  · rw [hη22]
    show η ^ 22 * ((giBohr P S₃ ρ₅).card : ℝ) ≤ ‖∑ x ∈ giBohr P S₃ ρ₅,
      ((g (y + x) : ℝ) : ℂ) * giE (-((((ξ₀ + 2 * M h') * y + ((ξ₀ + 2 * M h') + ζ) * (y + x - y)
        - M (y + x - y) * (y + x - y)).val : ℝ) / P))‖
    have hEq : ∀ x ∈ giBohr P S₃ ρ₅,
