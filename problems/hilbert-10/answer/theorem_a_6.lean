      intro t ht
      rw [hTdef] at ht
      have hmem := (Finset.mem_filter.mp ht).2
      have h := hgood _ hmem l
      rwa [hline t] at h
    obtain ⟨d, hd1, hdσ, hdα⟩ := hs3 M
      (∑ k, Sm l k * ((y k : ℤ) : ℝ) - Sm l l' * ((y l' : ℤ) : ℝ)) (Sm l l') T
      hσM1 hT hy hgoodT
    exact ⟨d, hd1, hdσ, hs4 M d
      (∑ k, Sm l k * ((y k : ℤ) : ℝ) - Sm l l' * ((y l' : ℤ) : ℝ)) (Sm l l') T
      hσM' hd1 hdσ hdα hT hy hgoodT⟩
  choose d hd1 hdD hdρ using hentry
  
  have hρ0 : 0 ≤ 8 * ε / (σ ^ 2 * (2 * (M : ℝ) + 1)) := by positivity
  obtain ⟨q, hqdef⟩ : ∃ q : ℕ, q = ∏ p : Fin ν × Fin ν, d p.1 p.2 := ⟨_, rfl⟩
  have hqpos : 0 < q := by
    rw [hqdef]; exact Finset.prod_pos (fun p _ => hd1 p.1 p.2)
  refine ⟨q, hqpos, ?_, ?_⟩
  · rw [hqdef]
    push_cast
    calc (∏ p : Fin ν × Fin ν, (d p.1 p.2 : ℝ)) ≤ ∏ _p : Fin ν × Fin ν, (2 / σ) :=
          Finset.prod_le_prod (fun p _ => by positivity) (fun p _ => hdD p.1 p.2)
      _ = (2 / σ) ^ (ν * ν) := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_prod, Fintype.card_fin]
  · intro l l'
    rw [← hK]
    obtain ⟨c, hc⟩ : d l l' ∣ q := by
      rw [hqdef]
      exact Finset.dvd_prod_of_mem (fun p : Fin ν × Fin ν => d p.1 p.2) (Finset.mem_univ (l, l'))
    have hcle : c ≤ q := Nat.le_of_dvd hqpos ⟨d l l', by rw [hc, mul_comm]⟩
    have hcR : (c : ℝ) ≤ (q : ℝ) := by exact_mod_cast hcle
    have hqS : (q : ℝ) * Sm l l' = (c : ℝ) * ((d l l' : ℝ) * Sm l l') := by
      rw [hc]; push_cast; ring
    rw [hqS]
    have h1 := round_le ((c : ℝ) * ((d l l' : ℝ) * Sm l l'))
      ((c : ℤ) * round ((d l l' : ℝ) * Sm l l'))
    have h2 : |(c : ℝ) * ((d l l' : ℝ) * Sm l l')
        - (((c : ℤ) * round ((d l l' : ℝ) * Sm l l') : ℤ) : ℝ)|
        = (c : ℝ) * |(d l l' : ℝ) * Sm l l' - ((round ((d l l' : ℝ) * Sm l l') : ℤ) : ℝ)| := by
      rw [show (c : ℝ) * ((d l l' : ℝ) * Sm l l')
          - (((c : ℤ) * round ((d l l' : ℝ) * Sm l l') : ℤ) : ℝ)
          = (c : ℝ) * ((d l l' : ℝ) * Sm l l' - ((round ((d l l' : ℝ) * Sm l l') : ℤ) : ℝ)) by
            push_cast; ring]
      rw [abs_mul, Nat.abs_cast]
    calc _ ≤ _ := h1
      _ = _ := h2
      _ ≤ (c : ℝ) * (8 * ε / (σ ^ 2 * (2 * (M : ℝ) + 1))) :=
          mul_le_mul_of_nonneg_left (hdρ l l') (Nat.cast_nonneg c)
      _ ≤ (q : ℝ) * (8 * ε / (σ ^ 2 * (2 * (M : ℝ) + 1))) :=
          mul_le_mul_of_nonneg_right hcR hρ0

theorem kai_giE_facts : (∀ x y : ℝ, giE (x + y) = giE x * giE y) ∧
    (∀ m : ℤ, giE (m : ℝ) = 1) ∧
    (∀ x : ℝ, ‖giE x‖ = 1) ∧
    (∀ x : ℝ, ‖giE x - 1‖ ≤ 7 * |x|) ∧
    (∀ x : ℝ, 4 * |x - ((round x : ℤ) : ℝ)| ≤ ‖giE x - 1‖) :=
by
  have hsin : ∀ x : ℝ, 2 * |x - ((round x : ℤ) : ℝ)| ≤ |Real.sin (Real.pi * x)| := by
    intro x
    have hy2 : |x - ((round x : ℤ) : ℝ)| ≤ 1 / 2 := abs_sub_round x
    set n : ℤ := round x with hn
    set y : ℝ := x - (n : ℝ) with hy
    have hxy : Real.pi * x = Real.pi * y + (n : ℝ) * Real.pi := by rw [hy]; ring
    have hs : |Real.sin (Real.pi * x)| = |Real.sin (Real.pi * y)| := by
      rw [hxy, Real.sin_add_int_mul_pi, abs_mul, abs_neg_one_zpow, one_mul]
    rw [hs]
    have hpi := Real.pi_pos
    rcases le_or_gt 0 y with h | h
    · have h1 : 0 ≤ Real.pi * y := mul_nonneg hpi.le h
      have h2 : Real.pi * y ≤ Real.pi / 2 := by
        have : y ≤ 1 / 2 := (le_abs_self y).trans hy2
        nlinarith
      have h3 := Real.mul_le_sin h1 h2
      have h4 : 2 / Real.pi * (Real.pi * y) = 2 * y := by field_simp
      rw [abs_of_nonneg h]
      linarith [le_abs_self (Real.sin (Real.pi * y))]
    · have hu : 0 ≤ Real.pi * (-y) := mul_nonneg hpi.le (by linarith)
      have h2 : Real.pi * (-y) ≤ Real.pi / 2 := by
        have : -y ≤ 1 / 2 := (neg_le_abs y).trans hy2
        nlinarith
      have h3 := Real.mul_le_sin hu h2
      have h4 : 2 / Real.pi * (Real.pi * (-y)) = 2 * (-y) := by field_simp
      have h5 : Real.sin (Real.pi * (-y)) = - Real.sin (Real.pi * y) := by
        rw [mul_neg, Real.sin_neg]
      rw [abs_of_neg h]
      linarith [neg_abs_le (Real.sin (Real.pi * y)), neg_le_abs (Real.sin (Real.pi * y))]
  have hIt : ∀ x : ℝ, (2 * (Real.pi : ℂ) * Complex.I * (x : ℂ))
      = Complex.I * ((2 * Real.pi * x : ℝ) : ℂ) := by
    intro x; push_cast; ring
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro x y
    simp only [giE]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  · intro m
    simp only [giE]
    rw [show (2 * (Real.pi : ℂ) * Complex.I * (((m : ℝ)) : ℂ))
        = (m : ℂ) * (2 * Real.pi * Complex.I) by push_cast; ring]
    exact Complex.exp_int_mul_two_pi_mul_I m
  · intro x
    simp only [giE]
    rw [show (2 * (Real.pi : ℂ) * Complex.I * (x : ℂ))
        = ((2 * Real.pi * x : ℝ) : ℂ) * Complex.I by push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  · intro x
    simp only [giE]
    rw [hIt x]
    refine Real.norm_exp_I_mul_ofReal_sub_one_le.trans ?_
    have habs : |2 * Real.pi * x| = 2 * Real.pi * |x| := by
      rw [abs_mul, abs_of_pos Real.two_pi_pos]
    rw [Real.norm_eq_abs, habs]
    nlinarith [Real.pi_lt_d2, abs_nonneg x]
  · intro x
    simp only [giE]
    rw [hIt x, Complex.norm_exp_I_mul_ofReal_sub_one,
      show 2 * Real.pi * x / 2 = Real.pi * x by ring, Real.norm_eq_abs, abs_mul, abs_two]
    linarith [hsin x]

theorem kai_quad_shift_identity (ν N : ℕ) (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ)
    (q : ℕ) (a : Fin ν → Fin ν → ℤ) (θ : Fin ν → Fin ν → ℝ) (Θ : ℝ)
    (hN : 1 ≤ N) (hq : 1 ≤ q) (hΘ : 0 ≤ Θ)
    (hθ : ∀ l l', |θ l l'| ≤ Θ / (N : ℝ) ^ 2)
    (hrep : ∀ z : Fin ν → ℤ, ∑ l, ∑ l', p₂ l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)
        = (∑ l, ∑ l', ((a l l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)) / (q : ℝ)
          + ∑ l, ∑ l', θ l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ))
    (l : Fin ν) (j : ℕ) (z : Fin ν → ℤ) (hz : z ∈ intBox ν N) :
    ∃ (m : ℤ) (φ : ℝ),
      kaiQuadPoly p₀ p₁ p₂ (Function.update z l (z l + ((q * j : ℕ) : ℤ)))
        = kaiQuadPoly p₀ p₁ p₂ z + ((q * j : ℕ) : ℝ) * p₁ l + (m : ℝ) + φ ∧
      |φ| ≤ 2 * (ν : ℝ) * ((q * j : ℕ) : ℝ) * Θ / (N : ℝ)
        + ((q * j : ℕ) : ℝ) ^ 2 * Θ / (N : ℝ) ^ 2 :=
by
  classical
  obtain ⟨s, hs⟩ : ∃ s : ℕ, s = q * j := ⟨_, rfl⟩
  rw [← hs]
  have hshift : ∀ k, ((Function.update z l (z l + (s : ℤ)) k : ℤ) : ℝ)
      = ((z k : ℤ) : ℝ) + (if k = l then (s : ℝ) else 0) := by
    intro k
    rw [Function.update_apply]
    split_ifs with h
    · subst h; push_cast; ring
    · simp
  have hquad : ∀ c : Fin ν → Fin ν → ℝ,
      ∑ k, ∑ k', c k k' * ((Function.update z l (z l + (s : ℤ)) k : ℤ) : ℝ)
            * ((Function.update z l (z l + (s : ℤ)) k' : ℤ) : ℝ)
        = ∑ k, ∑ k', c k k' * ((z k : ℤ) : ℝ) * ((z k' : ℤ) : ℝ)
          + (s : ℝ) * ∑ k, (c l k + c k l) * ((z k : ℤ) : ℝ) + (s : ℝ) ^ 2 * c l l := by
    intro c
    simp only [hshift]
    have e : ∀ k k', c k k' * (((z k : ℤ) : ℝ) + (if k = l then (s : ℝ) else 0))
          * (((z k' : ℤ) : ℝ) + (if k' = l then (s : ℝ) else 0))
        = c k k' * ((z k : ℤ) : ℝ) * ((z k' : ℤ) : ℝ)
          + ((if k' = l then c k k' * ((z k : ℤ) : ℝ) * s else 0)
          + (if k = l then (c k k' * s * ((z k' : ℤ) : ℝ)
              + (if k' = l then c k k' * s * s else 0)) else 0)) := by
      intro k k'
      split_ifs <;> ring
    simp only [e, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, if_true,
      Finset.sum_ite_irrel, Finset.sum_const_zero]
    have h2 : (s : ℝ) * ∑ k, (c l k + c k l) * ((z k : ℤ) : ℝ)
        = ∑ k, c k l * ((z k : ℤ) : ℝ) * s + ∑ k, c l k * s * ((z k : ℤ) : ℝ) := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    rw [h2]
    ring
  have hlin : ∑ k, p₁ k * ((Function.update z l (z l + (s : ℤ)) k : ℤ) : ℝ)
      = ∑ k, p₁ k * ((z k : ℤ) : ℝ) + (s : ℝ) * p₁ l := by
    simp only [hshift, mul_add, mul_ite, mul_zero, Finset.sum_add_distrib, Finset.sum_ite_eq',
      Finset.mem_univ, if_true]
    ring
  have hq0 : (q : ℝ) ≠ 0 := by
    have : (0 : ℝ) < q := by exact_mod_cast hq
    exact this.ne'
  have hsR : (s : ℝ) = (q : ℝ) * (j : ℝ) := by rw [hs]; push_cast; ring
  
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
  have hzb : ∀ k, |((z k : ℤ) : ℝ)| ≤ N := by
    intro k
    simp only [intBox, Finset.mem_Icc] at hz
    have h1 : -(N : ℤ) ≤ z k := hz.1 k
    have h2 : z k ≤ (N : ℤ) := hz.2 k
    rw [abs_le]
    constructor
    · exact_mod_cast h1
    · exact_mod_cast h2
  have hterm : ∀ k, |(θ l k + θ k l) * ((z k : ℤ) : ℝ)| ≤ 2 * Θ / (N : ℝ) := by
    intro k
    rw [abs_mul]
    have h1 : |θ l k + θ k l| ≤ 2 * (Θ / (N : ℝ) ^ 2) :=
      (abs_add_le _ _).trans (by linarith [hθ l k, hθ k l])
    calc |θ l k + θ k l| * |((z k : ℤ) : ℝ)| ≤ 2 * (Θ / (N : ℝ) ^ 2) * N :=
          mul_le_mul h1 (hzb k) (abs_nonneg _) (by positivity)
      _ = 2 * Θ / (N : ℝ) := by field_simp
  have hsum : |∑ k, (θ l k + θ k l) * ((z k : ℤ) : ℝ)| ≤ (ν : ℝ) * (2 * Θ / (N : ℝ)) := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_sum (fun k _ => hterm k)).trans ?_
    simp [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  refine ⟨(j : ℤ) * ∑ k, (a l k + a k l) * z k + (q : ℤ) * (j : ℤ) ^ 2 * a l l,
    (s : ℝ) * ∑ k, (θ l k + θ k l) * ((z k : ℤ) : ℝ) + (s : ℝ) ^ 2 * θ l l, ?_, ?_⟩
  · have E1 := hrep (Function.update z l (z l + (s : ℤ)))
    have E2 := hrep z
    have E3 := hquad (fun k k' => ((a k k' : ℤ) : ℝ))
    have E4 := hquad θ
    simp only at E3
    have E6 : ((s : ℝ) * ∑ k, (((a l k : ℤ) : ℝ) + ((a k l : ℤ) : ℝ)) * ((z k : ℤ) : ℝ)
        + (s : ℝ) ^ 2 * ((a l l : ℤ) : ℝ)) / (q : ℝ)
        = (((j : ℤ) * ∑ k, (a l k + a k l) * z k + (q : ℤ) * (j : ℤ) ^ 2 * a l l : ℤ) : ℝ) := by
      rw [div_eq_iff hq0, hsR]
      push_cast
      ring
    unfold kaiQuadPoly
    linear_combination hlin + E1 - E2 + (1 / (q : ℝ)) * E3 + E4 + E6
  · have hs0 : (0 : ℝ) ≤ (s : ℝ) := Nat.cast_nonneg _
    calc |(s : ℝ) * ∑ k, (θ l k + θ k l) * ((z k : ℤ) : ℝ) + (s : ℝ) ^ 2 * θ l l|
        ≤ |(s : ℝ) * ∑ k, (θ l k + θ k l) * ((z k : ℤ) : ℝ)| + |(s : ℝ) ^ 2 * θ l l| :=
          abs_add_le _ _
      _ = (s : ℝ) * |∑ k, (θ l k + θ k l) * ((z k : ℤ) : ℝ)| + (s : ℝ) ^ 2 * |θ l l| := by
          rw [abs_mul, abs_mul, abs_of_nonneg hs0, abs_of_nonneg (pow_nonneg hs0 2)]
      _ ≤ (s : ℝ) * ((ν : ℝ) * (2 * Θ / (N : ℝ))) + (s : ℝ) ^ 2 * (Θ / (N : ℝ) ^ 2) :=
          add_le_add (mul_le_mul_of_nonneg_left hsum hs0)
            (mul_le_mul_of_nonneg_left (hθ l l) (pow_nonneg hs0 2))
      _ = 2 * (ν : ℝ) * (s : ℝ) * Θ / (N : ℝ) + (s : ℝ) ^ 2 * Θ / (N : ℝ) ^ 2 := by ring

theorem kai_convex_shift_comparison (ν N : ℕ) (l : Fin ν) (Ω : Set (Fin ν → ℝ))
    (hΩ : Convex ℝ Ω) (g : (Fin ν → ℤ) → ℂ) (hg : ∀ z, ‖g z‖ ≤ 1)
    (s : ℕ) (w : ℂ) (E : ℝ) (hE0 : 0 ≤ E)
    (hE : ∀ z ∈ intBox ν N, ‖g (Function.update z l (z l + (s : ℤ))) - w * g z‖ ≤ E) :
    ‖w - 1‖ * ‖∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω)
          (fun _ => Classical.propDecidable _) (intBox ν N), g z‖
      ≤ 2 * (s : ℝ) * (((2 * N + 1 : ℕ) : ℝ) ^ (ν - 1)) + (((2 * N + 1 : ℕ) : ℝ) ^ ν) * E :=
by
  classical
  obtain ⟨X, hX⟩ : ∃ X : Finset (Fin ν → ℤ), X = @Finset.filter (Fin ν → ℤ)
      (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω)
      (fun _ => Classical.propDecidable _) (intBox ν N) := ⟨_, rfl⟩
  rw [← hX]
  have hmemX : ∀ z, z ∈ X ↔ z ∈ intBox ν N ∧ (fun j => ((z j : ℤ) : ℝ)) ∈ Ω := by
    intro z; rw [hX]; exact Finset.mem_filter
  have hmemB : ∀ z : Fin ν → ℤ, z ∈ intBox ν N ↔ ∀ j, -(N : ℤ) ≤ z j ∧ z j ≤ N := by
    intro z
    simp only [intBox, Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h j => ⟨h.1 j, h.2 j⟩, fun h => ⟨fun j => (h j).1, fun j => (h j).2⟩⟩
  obtain ⟨τ, hτdef⟩ : ∃ τ : (Fin ν → ℤ) → (Fin ν → ℤ),
      ∀ z, τ z = Function.update z l (z l + (s : ℤ)) := ⟨_, fun _ => rfl⟩
  have hτl : ∀ z, τ z l = z l + (s : ℤ) := by
    intro z; rw [hτdef]; simp
  have hτj : ∀ z j, j ≠ l → τ z j = z j := by
    intro z j hj; rw [hτdef]; simp [hj]
  have hτinj : Function.Injective τ := by
    intro a b hab
    funext j
    by_cases hj : j = l
    · have := congrFun hab l
      rw [hτl, hτl] at this
      rw [hj]; linarith
    · have := congrFun hab j
      rwa [hτj a j hj, hτj b j hj] at this
  
  have hcardB : ((intBox ν N).card : ℝ) = (((2 * N + 1 : ℕ) : ℝ)) ^ ν := by
    have h1 : (intBox ν N).card = (2 * N + 1) ^ ν := by
      simp only [intBox]
      rw [Pi.card_Icc]
      have hpt : ∀ j : Fin ν, (Finset.Icc ((fun _ : Fin ν => -(N : ℤ)) j)
          ((fun _ : Fin ν => (N : ℤ)) j)).card = 2 * N + 1 := by
        intro j
        simp only [Int.card_Icc]
        omega
      rw [Finset.prod_congr rfl (fun j _ => hpt j), Finset.prod_const, Finset.card_univ,
        Fintype.card_fin]
    rw [h1]; push_cast; ring
  
  have hstep1 : ‖∑ z ∈ X, g (τ z) - w * ∑ z ∈ X, g z‖
      ≤ (((2 * N + 1 : ℕ) : ℝ)) ^ ν * E := by
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    calc ‖∑ z ∈ X, (g (τ z) - w * g z)‖ ≤ ∑ z ∈ X, ‖g (τ z) - w * g z‖ := norm_sum_le _ _
      _ ≤ ∑ z ∈ X, E := Finset.sum_le_sum (fun z hz => by
          rw [hτdef]; exact hE z ((hmemX z).1 hz).1)
      _ = (X.card : ℝ) * E := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ((intBox ν N).card : ℝ) * E := by
          apply mul_le_mul_of_nonneg_right _ hE0
          exact_mod_cast Finset.card_le_card (by rw [hX]; exact Finset.filter_subset _ _)
      _ = _ := by rw [hcardB]
  
  obtain ⟨Bad, hBad⟩ : ∃ Bad : Finset (Fin ν → ℤ), Bad = X.filter (fun z => τ z ∉ X) :=
    ⟨_, rfl⟩
  have hmemBad : ∀ z, z ∈ Bad ↔ z ∈ X ∧ τ z ∉ X := by
    intro z; rw [hBad, Finset.mem_filter]
  
  have hnorm : ∀ A : Finset (Fin ν → ℤ), ‖∑ y ∈ A, g y‖ ≤ (A.card : ℝ) := by
    intro A
    calc ‖∑ y ∈ A, g y‖ ≤ ∑ y ∈ A, ‖g y‖ := norm_sum_le _ _
      _ ≤ ∑ y ∈ A, (1 : ℝ) := Finset.sum_le_sum (fun y _ => hg y)
      _ = (A.card : ℝ) := by simp
  have hstep2 : ‖∑ z ∈ X, g (τ z) - ∑ z ∈ X, g z‖ ≤ 2 * (Bad.card : ℝ) := by
    obtain ⟨U, hU⟩ : ∃ U : Finset (Fin ν → ℤ), U = X.image τ := ⟨_, rfl⟩
    have h1 : ∑ z ∈ X, g (τ z) = ∑ y ∈ U, g y := by
      rw [hU, Finset.sum_image (fun a _ b _ h => hτinj h)]
    have h2 := Finset.sum_inter_add_sum_diff U X g
    have h3 := Finset.sum_inter_add_sum_diff X U g
    rw [Finset.inter_comm X U] at h3
    have h4 : ∑ y ∈ U, g y - ∑ z ∈ X, g z = ∑ y ∈ U \ X, g y - ∑ y ∈ X \ U, g y := by
      rw [← h2, ← h3]; ring
    have hUX : U \ X = Bad.image τ := by
      ext y
      simp only [hU, Finset.mem_sdiff, Finset.mem_image, hmemBad]
      constructor
      · rintro ⟨⟨z, hz, rfl⟩, hy⟩; exact ⟨z, ⟨hz, hy⟩, rfl⟩
      · rintro ⟨z, ⟨hz, hy⟩, rfl⟩; exact ⟨⟨z, hz, rfl⟩, hy⟩
    have hc1 : (U \ X).card = Bad.card := by
      rw [hUX]; exact Finset.card_image_of_injective _ hτinj
    have hc2 := Finset.card_sdiff_add_card_inter X U
    have hc3 := Finset.card_sdiff_add_card_inter U X
    have hc4 : U.card = X.card := by rw [hU]; exact Finset.card_image_of_injective _ hτinj
    rw [Finset.inter_comm U X] at hc3
    have hc5 : (X \ U).card = Bad.card := by omega
    rw [h1, h4]
    calc ‖∑ y ∈ U \ X, g y - ∑ y ∈ X \ U, g y‖
        ≤ ‖∑ y ∈ U \ X, g y‖ + ‖∑ y ∈ X \ U, g y‖ := norm_sub_le _ _
      _ ≤ ((U \ X).card : ℝ) + ((X \ U).card : ℝ) := add_le_add (hnorm _) (hnorm _)
      _ = 2 * (Bad.card : ℝ) := by rw [hc1, hc5]; ring
  
  have hgapline : ∀ z ∈ X, ∀ z' ∈ X, (∀ j, j ≠ l → z j = z' j) →
      z l + (s : ℤ) ≤ z' l → τ z ∈ X := by
    intro z hz z' hz' hoff hgap
    obtain ⟨hzB, hzΩ⟩ := (hmemX z).1 hz
    obtain ⟨hz'B, hz'Ω⟩ := (hmemX z').1 hz'
    rw [hmemX]
    constructor
    · rw [hmemB] at hzB hz'B ⊢
      intro j
      by_cases hj : j = l
      · rw [hj, hτl]
        have a1 := hzB l
        have a2 := hz'B l
        constructor <;> omega
      · rw [hτj z j hj]; exact hzB j
    · rcases Nat.eq_zero_or_pos s with hs | hs
      · have hτz : τ z = z := by
          funext j
          by_cases hj : j = l
          · rw [hj, hτl, hs]; simp
          · exact hτj z j hj
        rw [hτz]; exact hzΩ
      · have hdz : (0 : ℤ) < z' l - z l := by omega
        have hdpos : (0 : ℝ) < ((z' l : ℤ) : ℝ) - ((z l : ℤ) : ℝ) := by
          have : (0 : ℝ) < ((z' l - z l : ℤ) : ℝ) := by exact_mod_cast hdz
          push_cast at this; exact this
        have hsd : (s : ℝ) ≤ ((z' l : ℤ) : ℝ) - ((z l : ℤ) : ℝ) := by
          have h' : (s : ℤ) ≤ z' l - z l := by omega
          have : ((s : ℤ) : ℝ) ≤ ((z' l - z l : ℤ) : ℝ) := by exact_mod_cast h'
          push_cast at this; exact this
        have ht0 : (0 : ℝ) ≤ (s : ℝ) / (((z' l : ℤ) : ℝ) - ((z l : ℤ) : ℝ)) :=
          div_nonneg (Nat.cast_nonneg _) hdpos.le
        have ht1 : (s : ℝ) / (((z' l : ℤ) : ℝ) - ((z l : ℤ) : ℝ)) ≤ 1 :=
          (div_le_one hdpos).2 hsd
        have hconv := hΩ.add_smul_sub_mem hzΩ hz'Ω ⟨ht0, ht1⟩
        convert hconv using 1
        funext j
        simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
        by_cases hj : j = l
        · rw [hj, hτl, div_mul_cancel₀ _ hdpos.ne']
          push_cast; ring
        · rw [hτj z j hj, hoff j hj]; ring
  
  have hgap : ∀ z ∈ Bad, ∀ z' ∈ Bad, (∀ j, j ≠ l → z j = z' j) →
      |z l - z' l| < (s : ℤ) := by
    intro z hz z' hz' hoff
    obtain ⟨hzX, hzn⟩ := (hmemBad z).1 hz
    obtain ⟨hz'X, hz'n⟩ := (hmemBad z').1 hz'
    rw [abs_lt]
    constructor
    · by_contra hc
      exact hzn (hgapline z hzX z' hz'X hoff (by omega))
    · by_contra hc
      exact hz'n (hgapline z' hz'X z hzX (fun j hj => (hoff j hj).symm) (by omega))
  have hBadB : ∀ z ∈ Bad, z ∈ intBox ν N := fun z hz => ((hmemX z).1 ((hmemBad z).1 hz).1).1
  
  have hcount : (Bad.card : ℝ) ≤ (s : ℝ) * (((2 * N + 1 : ℕ) : ℝ)) ^ (ν - 1) := by
    rcases Nat.eq_zero_or_pos s with hs | hs
    · have hempty : Bad = ∅ := by
        apply Finset.eq_empty_of_forall_notMem
        intro z hz
        have := hgap z hz z hz (fun _ _ => rfl)
        simp [hs] at this
      rw [hempty, Finset.card_empty, Nat.cast_zero]; positivity
    · obtain ⟨D, hD⟩ : ∃ D : Finset (Fin ν → ℤ), D = Finset.Icc
          (Function.update (fun _ => -(N : ℤ)) l 0)
          (Function.update (fun _ => (N : ℤ)) l ((s : ℤ) - 1)) := ⟨_, rfl⟩
      have hmaps : ∀ z ∈ Bad, Function.update z l (z l % (s : ℤ)) ∈ D := by
        intro z hz
        have hzB := (hmemB z).1 (hBadB z hz)
        rw [hD, Finset.mem_Icc, Pi.le_def, Pi.le_def]
        constructor
        · intro j
          by_cases hj : j = l
          · rw [hj]; simp only [Function.update_self]
            exact Int.emod_nonneg _ (by omega)
          · simp only [Function.update_of_ne hj]; exact (hzB j).1
        · intro j
          by_cases hj : j = l
          · rw [hj]; simp only [Function.update_self]
            have := Int.emod_lt_of_pos (z l) (show (0 : ℤ) < s by omega)
            omega
          · simp only [Function.update_of_ne hj]; exact (hzB j).2
      have hinj : Set.InjOn (fun z : Fin ν → ℤ => Function.update z l (z l % (s : ℤ)))
          (↑Bad : Set (Fin ν → ℤ)) := by
        intro z hz z' hz' heq
        simp only at heq
        have hoff : ∀ j, j ≠ l → z j = z' j := by
          intro j hj
          have := congrFun heq j
          simpa [Function.update_of_ne hj] using this
        have hmod : z l % (s : ℤ) = z' l % (s : ℤ) := by
          have := congrFun heq l
          simpa using this
        have hdvd : (s : ℤ) ∣ z l - z' l :=
          Int.ModEq.dvd (show Int.ModEq (s : ℤ) (z' l) (z l) from hmod.symm)
        have h0 := Int.eq_zero_of_abs_lt_dvd hdvd (hgap z hz z' hz' hoff)
        funext j
        by_cases hj : j = l
        · rw [hj]; omega
        · exact hoff j hj
      have hle : Bad.card ≤ D.card :=
        Finset.card_le_card_of_injOn _ (fun z hz => hmaps z hz) hinj
      have hDcard : D.card = s * (2 * N + 1) ^ (ν - 1) := by
        rw [hD, Pi.card_Icc]
        have hpt : ∀ j, (Finset.Icc (Function.update (fun _ => -(N : ℤ)) l 0 j)
            (Function.update (fun _ => (N : ℤ)) l ((s : ℤ) - 1) j)).card
              = Function.update (fun _ => 2 * N + 1) l s j := by
          intro j
          by_cases hj : j = l
          · rw [hj]; simp only [Function.update_self, Int.card_Icc]; omega
          · simp only [Function.update_of_ne hj, Int.card_Icc]; omega
        rw [Finset.prod_congr rfl (fun j _ => hpt j),
          Finset.prod_update_of_mem (Finset.mem_univ l), Finset.prod_const]
        have hc : (Finset.univ \ {l} : Finset (Fin ν)).card = ν - 1 := by
          rw [Finset.sdiff_singleton_eq_erase, Finset.card_erase_of_mem (Finset.mem_univ l),
            Finset.card_univ, Fintype.card_fin]
        rw [hc]
      calc (Bad.card : ℝ) ≤ (D.card : ℝ) := by exact_mod_cast hle
        _ = _ := by rw [hDcard]; push_cast; ring
  
  have key : ‖w - 1‖ * ‖∑ z ∈ X, g z‖ = ‖w * ∑ z ∈ X, g z - ∑ z ∈ X, g z‖ := by
    rw [← norm_mul, sub_mul, one_mul]
  rw [key]
  have htri := norm_sub_le_norm_sub_add_norm_sub (w * ∑ z ∈ X, g z)
    (∑ z ∈ X, g (τ z)) (∑ z ∈ X, g z)
  rw [norm_sub_rev (w * ∑ z ∈ X, g z) (∑ z ∈ X, g (τ z))] at htri
  linarith [hstep1, hstep2, hcount]

theorem kai_small_multiples (α : ℝ) (J : ℕ) (hJ : 1 ≤ J)
    (h : ∀ j : ℕ, 1 ≤ j → j ≤ J →
      |(j : ℝ) * α - ((round ((j : ℝ) * α) : ℤ) : ℝ)| ≤ 1 / 5) :
    |α - ((round α : ℤ) : ℝ)| ≤ 1 / (5 * (J : ℝ)) :=
by
  obtain ⟨r, hr⟩ : ∃ r : ℤ, r = round α := ⟨_, rfl⟩
  rw [← hr]
  
  have gap : ∀ (x : ℝ) (m : ℤ), |x| ≤ 2 / 5 → |x - (m : ℝ)| ≤ 1 / 5 → |x| ≤ 1 / 5 := by
    intro x m hx hxm
    rcases lt_trichotomy m 0 with hm | hm | hm
    · have hm' : (m : ℝ) ≤ -1 := by exact_mod_cast (show m ≤ -1 by omega)
      rw [abs_le] at hx hxm
      exfalso
      linarith [hx.1, hxm.2]
    · subst hm
      simpa using hxm
    · have hm' : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
      rw [abs_le] at hx hxm
      exfalso
      linarith [hx.2, hxm.1]
  
  have s3 : ∀ j : ℕ, 1 ≤ j → j ≤ J →
      |(j : ℝ) * (α - (r : ℝ)) - (((round ((j : ℝ) * α) - (j : ℤ) * r : ℤ)) : ℝ)| ≤ 1 / 5 := by
    intro j h1 h2
    have e : (j : ℝ) * (α - (r : ℝ)) - (((round ((j : ℝ) * α) - (j : ℤ) * r : ℤ)) : ℝ)
        = (j : ℝ) * α - ((round ((j : ℝ) * α) : ℤ) : ℝ) := by
      push_cast; ring
    rw [e]
    exact h j h1 h2
  
  have s1 : |α - (r : ℝ)| ≤ 1 / 5 := by
    have h1 := h 1 le_rfl hJ
    rw [Nat.cast_one, one_mul, ← hr] at h1
    exact h1
  
  have s4 : ∀ k : ℕ, k ≤ J → (k : ℝ) * |α - (r : ℝ)| ≤ 1 / 5 := by
    intro k
    induction k with
    | zero => intro _; simp
    | succ k ih =>
      intro hk
      have ih' := ih (by omega)
      have hx : |((k + 1 : ℕ) : ℝ) * (α - (r : ℝ))| ≤ 2 / 5 := by
        rw [abs_mul, abs_of_nonneg (by positivity)]
        push_cast
        linarith
      have hg := gap _ _ hx (s3 (k + 1) (by omega) hk)
      rw [abs_mul, abs_of_nonneg (by positivity)] at hg
      exact hg
  
  have hJ1 : (1 : ℝ) ≤ (J : ℝ) := by exact_mod_cast hJ
  have hJpos : (0 : ℝ) < 5 * (J : ℝ) := by linarith
  rw [le_div_iff₀ hJpos]
  have hJt := s4 J le_rfl
  linarith

theorem kai_qwi_linear_coeff (ν N : ℕ) (δ : ℝ) (Ω : Set (Fin ν → ℝ))
    (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ)
    (q : ℕ) (a : Fin ν → Fin ν → ℤ) (θ : Fin ν → Fin ν → ℝ) (Θ : ℝ)
    (hN : 1 ≤ N) (hδ : 0 < δ) (hδ1 : δ ≤ 1) (hΩ : Convex ℝ Ω) (hq : 1 ≤ q) (hΘ : 0 ≤ Θ)
    (hθ : ∀ l l', |θ l l'| ≤ Θ / (N : ℝ) ^ 2)
    (hrep : ∀ z : Fin ν → ℤ, ∑ l, ∑ l', p₂ l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)
        = (∑ l, ∑ l', ((a l l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)) / (q : ℝ)
          + ∑ l, ∑ l', θ l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ))
    (hsize : 5 * (q : ℝ) * (1 + 7 * (2 * (ν : ℝ) + 1) * Θ) ≤ 4 * δ * (N : ℝ))
    (hS : δ * (((2 * N + 1 : ℕ) : ℝ) ^ ν) ≤
      ‖∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω)
            (fun _ => Classical.propDecidable _) (intBox ν N),
          giE (kaiQuadPoly p₀ p₁ p₂ z)‖) :
    ∀ l : Fin ν, |(q : ℝ) * p₁ l - ((round ((q : ℝ) * p₁ l) : ℤ) : ℝ)|
      ≤ (q : ℝ) * (1 + 7 * (2 * (ν : ℝ) + 1) * Θ) / (2 * δ * (N : ℝ)) :=
by
  intro l
  obtain ⟨hmul, hint, hnorm, hup, hlow⟩ := kai_giE_facts
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = 7 * (2 * (ν : ℝ) + 1) * Θ := ⟨_, rfl⟩
  obtain ⟨C₂, hC₂⟩ : ∃ C₂ : ℝ, C₂ = 1 + 7 * (2 * (ν : ℝ) + 1) * Θ := ⟨_, rfl⟩
  rw [← hC₂] at hsize ⊢
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = ((2 * N + 1 : ℕ) : ℝ) := ⟨_, rfl⟩
  rw [← hR] at hS
  have hK0 : 0 ≤ K := by rw [hK]; positivity
  have hC₂K : C₂ = 1 + K := by rw [hC₂, hK]
  have hC₂1 : 1 ≤ C₂ := by linarith
  have hC₂pos : 0 < C₂ := by linarith
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hqpos : (0 : ℝ) < q := by linarith
  have hRval : R = 2 * (N : ℝ) + 1 := by rw [hR]; push_cast; ring
  have hRpos : 0 < R := by rw [hRval]; linarith
  have hν : 0 < ν := Fin.pos l
  have hRν : R ^ ν = R ^ (ν - 1) * R := by rw [← pow_succ, Nat.sub_add_cancel hν]
  have hRν1pos : 0 < R ^ (ν - 1) := pow_pos hRpos _
  
  have hshift : ∀ j : ℕ, ((q * j : ℕ) : ℝ) ≤ N →
