theorem kai_hz_test_fourier : KaiHZTestFourierProp :=
by
  
  have hg0 : ∀ y : ℝ, 0 < y → ∀ ξ : ℝ,
      FourierTransform.fourier
          (fun x : ℝ => Complex.exp (((-(Real.pi * y * x ^ 2) : ℝ) : ℂ))) ξ
        = ((y ^ (-((1 : ℝ) / 2)) : ℝ) : ℂ) *
            Complex.exp (((-(Real.pi * ξ ^ 2 / y) : ℝ) : ℂ)) := by
    intro y hy ξ
    have hb : 0 < ((y : ℂ)).re := by simpa using hy
    have h := congrFun (fourier_gaussian_pi (b := (y : ℂ)) hb) ξ
    have he : (fun x : ℝ => Complex.exp (((-(Real.pi * y * x ^ 2) : ℝ) : ℂ)))
        = fun x : ℝ => Complex.exp (-(Real.pi : ℂ) * (y : ℂ) * (x : ℂ) ^ 2) := by
      funext x
      congr 1
      push_cast
      ring
    rw [he, h]
    have hhalf : ((1 : ℂ) / 2) = (((1 : ℝ) / 2 : ℝ) : ℂ) := by norm_num
    have h1 : (1 : ℂ) / (y : ℂ) ^ ((1 : ℂ) / 2) = ((y ^ (-((1 : ℝ) / 2)) : ℝ) : ℂ) := by
      rw [hhalf, ← Complex.ofReal_cpow hy.le, Real.rpow_neg hy.le, Complex.ofReal_inv,
        one_div]
    have h2 : -(Real.pi : ℂ) / (y : ℂ) * (ξ : ℂ) ^ 2
        = (((-(Real.pi * ξ ^ 2 / y)) : ℝ) : ℂ) := by
      push_cast
      field_simp
    rw [h1, h2]
  
  have hI : ∀ a : ℝ, 0 < a → ∀ m : ℕ,
      MeasureTheory.Integrable
        (fun v : ℂ => ‖v‖ ^ m * Real.exp (-(a * ‖v‖ ^ 2))) MeasureTheory.volume := by
    intro a ha m
    have hc : (0 : ℝ) < a / 2 := by linarith
    have hfac : (0 : ℝ) < (Nat.factorial m : ℝ) := by
      exact_mod_cast Nat.factorial_pos m
    have hinv : (0 : ℝ) ≤ (1 / (a / 2)) ^ m := pow_nonneg (by positivity) m
    have key : ∀ t : ℝ, 0 ≤ t →
        t ^ m ≤ (1 + (Nat.factorial m : ℝ) * (1 / (a / 2)) ^ m) * Real.exp (a / 2 * t ^ 2) := by
      intro t ht
      have hu : (0 : ℝ) ≤ a / 2 * t ^ 2 := mul_nonneg hc.le (sq_nonneg t)
      have hexp1 : (1 : ℝ) ≤ Real.exp (a / 2 * t ^ 2) := Real.one_le_exp hu
      have ha1 : (a / 2 * t ^ 2) ^ m / (Nat.factorial m : ℝ) ≤ Real.exp (a / 2 * t ^ 2) :=
        Real.pow_div_factorial_le_exp _ hu m
      have ha2 : (a / 2 * t ^ 2) ^ m ≤ Real.exp (a / 2 * t ^ 2) * (Nat.factorial m : ℝ) :=
        (div_le_iff₀ hfac).mp ha1
      have hb1 : t ^ (2 * m) = (1 / (a / 2)) ^ m * (a / 2 * t ^ 2) ^ m := by
        rw [← mul_pow, pow_mul]
        congr 1
        field_simp
      have hb2 : t ^ (2 * m)
          ≤ (Nat.factorial m : ℝ) * (1 / (a / 2)) ^ m * Real.exp (a / 2 * t ^ 2) := by
        rw [hb1]
        nlinarith [ha2, hinv]
      have hc1 : t ^ m ≤ 1 + t ^ (2 * m) := by
        by_cases h : t ≤ 1
        · have h1 : t ^ m ≤ 1 := pow_le_one₀ ht h
          have h2 : (0 : ℝ) ≤ t ^ (2 * m) := pow_nonneg ht _
          linarith
        · push_neg at h
          have h1 : (1 : ℝ) ≤ t := h.le
          have h2 : t ^ m ≤ t ^ (2 * m) := pow_le_pow_right₀ h1 (by omega)
          linarith
      have hB0 : (0 : ℝ) ≤ (Nat.factorial m : ℝ) * (1 / (a / 2)) ^ m := by positivity
      nlinarith [hexp1, hb2, hc1, hB0]
    have hgauss : MeasureTheory.Integrable
        (fun v : ℂ => Real.exp (-(a / 2 * ‖v‖ ^ 2))) MeasureTheory.volume := by
      have hbre : 0 < (((a / 2 : ℝ) : ℂ)).re := by simpa using hc
      have h := GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
        (b := ((a / 2 : ℝ) : ℂ)) (V := ℂ) hbre 0 0
      refine (h.norm).congr (Filter.Eventually.of_forall (fun v => ?_))
      have harg : (-((a / 2 : ℝ) : ℂ) * ((‖v‖ : ℝ) : ℂ) ^ 2
            + 0 * ((inner ℝ (0 : ℂ) v : ℝ) : ℂ))
          = ((-(a / 2 * ‖v‖ ^ 2) : ℝ) : ℂ) := by
        push_cast
        ring
      simp only [harg, Complex.norm_exp, Complex.ofReal_re]
    have hcont : Continuous (fun v : ℂ => ‖v‖ ^ m * Real.exp (-(a * ‖v‖ ^ 2))) := by
      fun_prop
    refine MeasureTheory.Integrable.mono'
      (hgauss.const_mul (1 + (Nat.factorial m : ℝ) * (1 / (a / 2)) ^ m))
      hcont.aestronglyMeasurable (Filter.Eventually.of_forall (fun v => ?_))
    have ht : (0 : ℝ) ≤ ‖v‖ := norm_nonneg v
    have h1 := key ‖v‖ ht
    have hpos : (0 : ℝ) ≤ ‖v‖ ^ m * Real.exp (-(a * ‖v‖ ^ 2)) :=
      mul_nonneg (pow_nonneg ht m) (Real.exp_nonneg _)
    rw [Real.norm_eq_abs, abs_of_nonneg hpos]
    have hsplit : Real.exp (a / 2 * ‖v‖ ^ 2) * Real.exp (-(a * ‖v‖ ^ 2))
        = Real.exp (-(a / 2 * ‖v‖ ^ 2)) := by
      rw [← Real.exp_add]
      congr 1
      ring
    calc ‖v‖ ^ m * Real.exp (-(a * ‖v‖ ^ 2))
        ≤ ((1 + (Nat.factorial m : ℝ) * (1 / (a / 2)) ^ m) * Real.exp (a / 2 * ‖v‖ ^ 2))
            * Real.exp (-(a * ‖v‖ ^ 2)) :=
          mul_le_mul_of_nonneg_right h1 (Real.exp_nonneg _)
      _ = (1 + (Nat.factorial m : ℝ) * (1 / (a / 2)) ^ m)
            * (Real.exp (a / 2 * ‖v‖ ^ 2) * Real.exp (-(a * ‖v‖ ^ 2))) := by ring
      _ = (1 + (Nat.factorial m : ℝ) * (1 / (a / 2)) ^ m)
            * Real.exp (-(a / 2 * ‖v‖ ^ 2)) := by rw [hsplit]
  
  have hlin : ∀ y : ℝ, 0 < y → ∀ ξ : ℝ,
      FourierTransform.fourier
          (fun x : ℝ => (x : ℂ) * Complex.exp (((-(Real.pi * y * x ^ 2) : ℝ) : ℂ))) ξ
        = -Complex.I * ((y ^ (-((3 : ℝ) / 2)) : ℝ) : ℂ) * (ξ : ℂ) *
            Complex.exp (((-(Real.pi * ξ ^ 2 / y) : ℝ) : ℂ)) := by
    intro y hy ξ
    have hbre : 0 < (((Real.pi * y : ℝ) : ℂ)).re := by
