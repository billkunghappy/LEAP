        rwa [one_mul] at hstep
      have hb2 : kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K))
          ≤ ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ / τ :=
        le_trans (hvMle _ I.2) (hlogrpow _ τ hI1 hτ0)
      have hkey : ‖lam (I : Ideal (NumberField.RingOfIntegers K))‖ *
          kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K))
          ≤ 1 / τ * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ := by
        have heq : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ / τ
            = 1 / τ * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ := by
          ring
        linarith only [ha, hb2, heq]
      have hfin := mul_le_mul_of_nonneg_right hkey hpow0.le
      linarith only [hfin]
    have hLne : ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s ≠ 0 := by
      intro s hs hzero
      have hb := hC2 s hs
      rw [hzero, norm_zero, zero_mul] at hb
      linarith only [hb]
    have hC4 : ∀ s : ℂ, 1 < s.re →
        DifferentiableAt ℂ (kaiHeckeSeries K lam) s ∧
        deriv (kaiHeckeSeries K lam) s / kaiHeckeSeries K lam s
          = - kaiZFHeckeLogSum K lam s := by
      intro s hs
      obtain ⟨hdiff, hderiv⟩ := hderivS lam hbd s hs
      refine ⟨hdiff, ?_⟩
      have hprod := hprodS lam hmul hbd s hs (hC3N s hs)
      have hL := hLne s hs
      have hcancel : kaiHeckeSeries K lam s * kaiZFHeckeLogSum K lam s /
          kaiHeckeSeries K lam s = kaiZFHeckeLogSum K lam s := by
        rw [mul_comm, mul_div_assoc, div_self hL, mul_one]
      rw [hderiv, ← hprod, neg_div, hcancel]
    have hC5 : (∀ I : Ideal (NumberField.RingOfIntegers K),
          lam I = (starRingEnd ℂ) (lam I)) →
        ∀ s : ℂ, 1 < s.re →
          kaiHeckeSeries K lam ((starRingEnd ℂ) s)
            = (starRingEnd ℂ) (kaiHeckeSeries K lam s) := by
      intro hreal s _
      simp only [kaiHeckeSeries]
      rw [Complex.conj_tsum]
      refine tsum_congr ?_
      intro I
      have harg : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ)).arg
          ≠ Real.pi := by
        rw [show ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℕ) : ℂ)
              = (((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℕ) : ℝ) : ℂ) by
            push_cast; ring,
          Complex.arg_ofReal_of_nonneg (Nat.cast_nonneg _)]
        exact ne_of_lt Real.pi_pos
      have hcpow : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^
            ((starRingEnd ℂ) s)
          = (starRingEnd ℂ)
              (((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^ s) := by
        rw [Complex.cpow_conj _ _ harg, Complex.conj_natCast]
      rw [map_div₀, ← hreal (I : Ideal (NumberField.RingOfIntegers K)), hcpow]
    exact ⟨hC1, hC2, fun s hs => (hC3N s hs).of_norm, hC4, hC5⟩

theorem kai_hecke_char_positivity_00 (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    KaiZFCharPositivityProp K :=
by
  classical
  have hpcq : ∀ (q J : Ideal (NumberField.RingOfIntegers K)),
      kaiZFPrincipalChar K q J = if J ≠ 0 ∧ J ⊔ q = ⊤ then 1 else 0 := fun q J => rfl
  have hvm0 : ∀ J : Ideal (NumberField.RingOfIntegers K), 0 ≤ kaiZFVonMangoldt K J := by
    intro J
    by_cases h : ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
        P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ J = P ^ k
    · rw [kaiZFVonMangoldt, dif_pos h]
      obtain ⟨k, hP, hPb, hk, hIk⟩ := h.choose_spec
      refine Real.log_nonneg ?_
      have hne : Ideal.absNorm h.choose ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]
        exact hPb
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
    · rw [kaiZFVonMangoldt, dif_neg h]
  have hcpow : ∀ (s : ℝ) (I : Ideal (NumberField.RingOfIntegers K)),
      ((Ideal.absNorm I : ℂ) ^ (-(s : ℂ)))
        = (((Ideal.absNorm I : ℝ) ^ (-s) : ℝ) : ℂ) := by
    intro s I
    have hx : (0 : ℝ) ≤ ((Ideal.absNorm I : ℕ) : ℝ) := Nat.cast_nonneg _
    rw [Complex.ofReal_cpow hx (-s), Complex.ofReal_natCast, Complex.ofReal_neg]
  have hsumG : ∀ (σ : ℝ) (mu : Ideal (NumberField.RingOfIntegers K) → ℂ),
      kaiZFHeckeLogSum K mu ((σ : ℂ))
        = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            mu (I : Ideal (NumberField.RingOfIntegers K)) *
              (((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
                  (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)) :
                ℝ) : ℂ) := by
    intro σ mu
    simp only [kaiZFHeckeLogSum]
    refine tsum_congr ?_
    intro I
    rw [hcpow σ, mul_assoc, ← Complex.ofReal_mul]
  
  have s4 : ∀ (q : Ideal (NumberField.RingOfIntegers K))
      (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ = ‖kaiZFPrincipalChar K q I‖) →
      ∀ σ γ : ℝ,
      0 ≤ 3 * (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) (σ : ℂ)).re
          + 4 * (kaiZFHeckeLogSum K lam ((σ : ℂ) + (γ : ℂ) * Complex.I)).re
          + (kaiZFHeckeLogSum K (fun I => lam I * lam I)
              ((σ : ℂ) + 2 * (γ : ℂ) * Complex.I)).re := by
    intro q lam hnorm σ γ
    have key : ∀ (c w : ℂ) (a : ℝ), 0 ≤ a → (c = 1 ∨ c = 0) → ‖w‖ = ‖c‖ →
        ‖w * ((a : ℝ) : ℂ)‖ = ‖c * ((a : ℝ) : ℂ)‖ ∧
        ‖w * w * ((a : ℝ) : ℂ)‖ = ‖c * ((a : ℝ) : ℂ)‖ ∧
        0 ≤ 3 * (c * ((a : ℝ) : ℂ)).re + 4 * (w * ((a : ℝ) : ℂ)).re
            + (w * w * ((a : ℝ) : ℂ)).re := by
      intro c w a ha hc hw
      have hre : ∀ u : ℂ, (u * ((a : ℝ) : ℂ)).re = u.re * a := by
        intro u
        simp [Complex.mul_re]
      rcases hc with hc | hc
      · subst hc
        have hw1 : ‖w‖ = 1 := by rw [hw, norm_one]
        have hsq : w.re * w.re + w.im * w.im = 1 := by
          have hh := Complex.sq_norm w
          rw [hw1, Complex.normSq_apply] at hh
          simpa using hh.symm
        refine ⟨?_, ?_, ?_⟩
        · rw [norm_mul, norm_mul, hw1, norm_one]
        · rw [norm_mul, norm_mul, norm_mul, hw1, norm_one]
          ring
        · rw [hre 1, hre w, hre (w * w), Complex.mul_re, Complex.one_re]
          have him : w.im * w.im = 1 - w.re * w.re := by linarith
          have hexp : 3 * (1 * a) + 4 * (w.re * a) + ((w.re * w.re - w.im * w.im) * a)
              = 2 * a * (w.re + 1) ^ 2 := by
            rw [him]; ring
          rw [hexp]
          exact mul_nonneg (by linarith) (sq_nonneg _)
      · subst hc
        have hw0 : w = 0 := by rw [← norm_eq_zero, hw, norm_zero]
        subst hw0
        refine ⟨by simp, by simp, by simp⟩
    have main : ∀ f g h : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} → ℂ,
        (∀ I, ‖g I‖ = ‖f I‖) → (∀ I, ‖h I‖ = ‖f I‖) →
        (∀ I, 0 ≤ 3 * (f I).re + 4 * (g I).re + (h I).re) →
        0 ≤ 3 * (∑' I, f I).re + 4 * (∑' I, g I).re + (∑' I, h I).re := by
      intro f g h hgf hhf hterm
      by_cases hf : Summable f
      · have hnf : Summable (fun I => ‖f I‖) := summable_norm_iff.mpr hf
        have hng : Summable (fun I => ‖g I‖) := hnf.congr (fun I => (hgf I).symm)
        have hnh : Summable (fun I => ‖h I‖) := hnf.congr (fun I => (hhf I).symm)
        have hgs : Summable g := summable_norm_iff.mp hng
        have hhs : Summable h := summable_norm_iff.mp hnh
        have r₁ := Complex.hasSum_re hf.hasSum
        have r₂ := Complex.hasSum_re hgs.hasSum
        have r₃ := Complex.hasSum_re hhs.hasSum
        have R := ((r₁.mul_left 3).add (r₂.mul_left 4)).add r₃
        rw [← R.tsum_eq]
        exact tsum_nonneg hterm
      · have hnf : ¬ Summable (fun I => ‖f I‖) := fun hcon => hf (summable_norm_iff.mp hcon)
        have hgs : ¬ Summable g := by
          intro hcon
          exact hnf ((summable_norm_iff.mpr hcon).congr (fun I => hgf I))
        have hhs : ¬ Summable h := by
          intro hcon
          exact hnf ((summable_norm_iff.mpr hcon).congr (fun I => hhf I))
        rw [tsum_eq_zero_of_not_summable hf, tsum_eq_zero_of_not_summable hgs,
          tsum_eq_zero_of_not_summable hhs]
        simp
    have hpack : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ∃ (c w : ℂ) (a : ℝ), 0 ≤ a ∧ (c = 1 ∨ c = 0) ∧ ‖w‖ = ‖c‖ ∧
          kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K)) *
              ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-(σ : ℂ)))
            = c * ((a : ℝ) : ℂ) ∧
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
              ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
                (-((σ : ℂ) + (γ : ℂ) * Complex.I)))
            = w * ((a : ℝ) : ℂ) ∧
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
              lam (I : Ideal (NumberField.RingOfIntegers K)) *
              ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
                (-((σ : ℂ) + 2 * (γ : ℂ) * Complex.I)))
            = w * w * ((a : ℝ) : ℂ) := by
      intro I
      have hPb : (I : Ideal (NumberField.RingOfIntegers K)) ≠ ⊥ := by
        have hI2 := I.2
        rwa [← Submodule.zero_eq_bot]
      have hN0 : 0 < Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) := by
        refine Nat.pos_of_ne_zero ?_
        rw [Ne, Ideal.absNorm_eq_zero_iff]
        exact hPb
      have hcne : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℕ) : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr hN0.ne'
      have hz1 : ‖((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
          (-(γ : ℂ) * Complex.I))‖ = 1 := by
        have hre0 : (-(γ : ℂ) * Complex.I).re = 0 := by simp [Complex.mul_re]
        rw [Complex.norm_natCast_cpow_of_pos hN0, hre0, Real.rpow_zero]
      have he₂ : -((σ : ℂ) + (γ : ℂ) * Complex.I) = -(σ : ℂ) + -(γ : ℂ) * Complex.I := by
        ring
      have he₃ : -((σ : ℂ) + 2 * (γ : ℂ) * Complex.I)
          = (-(σ : ℂ) + -(γ : ℂ) * Complex.I) + -(γ : ℂ) * Complex.I := by
        ring
      have hp₂ : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
            (-((σ : ℂ) + (γ : ℂ) * Complex.I)))
          = ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-(σ : ℂ)))
              * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
                (-(γ : ℂ) * Complex.I)) := by
        rw [he₂, Complex.cpow_add _ _ hcne]
      have hp₃ : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
            (-((σ : ℂ) + 2 * (γ : ℂ) * Complex.I)))
          = ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-(σ : ℂ)))
              * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
                (-(γ : ℂ) * Complex.I))
              * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
                (-(γ : ℂ) * Complex.I)) := by
        rw [he₃, Complex.cpow_add _ _ hcne, Complex.cpow_add _ _ hcne]
      refine ⟨kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K)),
        lam (I : Ideal (NumberField.RingOfIntegers K)) *
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^
            (-(γ : ℂ) * Complex.I)),
        kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)),
        ?_, ?_, ?_, ?_, ?_, ?_⟩
      · exact mul_nonneg (hvm0 _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)
      · by_cases hcond : (I : Ideal (NumberField.RingOfIntegers K)) ≠ 0 ∧
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
        · left
          rw [hpcq, if_pos hcond]
        · right
          rw [hpcq, if_neg hcond]
      · rw [norm_mul, hz1, mul_one]
        exact hnorm _
      · rw [hcpow, Complex.ofReal_mul]
        ring
      · rw [hp₂, hcpow, Complex.ofReal_mul]
        ring
      · rw [hp₃, hcpow, Complex.ofReal_mul]
        ring
    simp only [kaiZFHeckeLogSum]
    refine main _ _ _ ?_ ?_ ?_
    · intro I
      obtain ⟨c, w, a, ha, hc, hw, e1, e2, -⟩ := hpack I
      rw [e2, e1]
      exact (key c w a ha hc hw).1
    · intro I
      obtain ⟨c, w, a, ha, hc, hw, e1, -, e3⟩ := hpack I
      rw [e3, e1]
      exact (key c w a ha hc hw).2.1
    · intro I
      obtain ⟨c, w, a, ha, hc, hw, e1, e2, e3⟩ := hpack I
      rw [e1, e2, e3]
      exact (key c w a ha hc hw).2.2
  
  have s5 : ∀ (q : Ideal (NumberField.RingOfIntegers K))
      (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ = ‖kaiZFPrincipalChar K q I‖) →
      ∀ σ : ℝ,
      0 ≤ (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) ((σ : ℂ))).re ∧
        (kaiZFHeckeLogSum K lam ((σ : ℂ))).re
          ≤ (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) ((σ : ℂ))).re := by
    intro q lam hnorm σ
    have ha0 : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        0 ≤ kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ) :=
      fun I => mul_nonneg (hvm0 _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)
    have hmulre : ∀ (z : ℂ) (r : ℝ), (z * ((r : ℝ) : ℂ)).re = z.re * r := by
      intro z r
      simp [Complex.mul_re]
    have hmulnorm : ∀ (z : ℂ) (r : ℝ), 0 ≤ r → ‖z * ((r : ℝ) : ℂ)‖ = ‖z‖ * r := by
      intro z r hr
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hr]
    have hchi : ∀ I : Ideal (NumberField.RingOfIntegers K),
        (kaiZFPrincipalChar K q I).re = ‖kaiZFPrincipalChar K q I‖ ∧
          0 ≤ (kaiZFPrincipalChar K q I).re := by
      intro I
      rw [hpcq]
      by_cases h : I ≠ 0 ∧ I ⊔ q = ⊤
      · rw [if_pos h]; exact ⟨by simp, by simp⟩
      · rw [if_neg h]; exact ⟨by simp, by simp⟩
    have key : ∀ f g : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} → ℂ,
        (∀ I, ‖f I‖ = ‖g I‖) → (∀ I, (f I).re ≤ (g I).re) → (∀ I, 0 ≤ (g I).re) →
        0 ≤ (∑' I, g I).re ∧ (∑' I, f I).re ≤ (∑' I, g I).re := by
      intro f g hfg hle hg0
      by_cases hG : Summable g
      · have hF : Summable f := by
          have h1 : Summable (fun I => ‖g I‖) := summable_norm_iff.mpr hG
          have h2 : Summable (fun I => ‖f I‖) := h1.congr (fun I => (hfg I).symm)
          exact summable_norm_iff.mp h2
        have hRG := Complex.hasSum_re hG.hasSum
        have hRF := Complex.hasSum_re hF.hasSum
        constructor
        · rw [← hRG.tsum_eq]
          exact tsum_nonneg hg0
        · rw [← hRG.tsum_eq, ← hRF.tsum_eq]
          exact Summable.tsum_le_tsum hle hRF.summable hRG.summable
      · have hF : ¬ Summable f := by
          intro hF
          refine hG ?_
          have h1 : Summable (fun I => ‖f I‖) := summable_norm_iff.mpr hF
          have h2 : Summable (fun I => ‖g I‖) := h1.congr (fun I => hfg I)
          exact summable_norm_iff.mp h2
        rw [tsum_eq_zero_of_not_summable hG, tsum_eq_zero_of_not_summable hF]
        simp
    rw [hsumG σ (kaiZFPrincipalChar K q), hsumG σ lam]
    refine key
      (fun I => lam (I : Ideal (NumberField.RingOfIntegers K)) *
        (((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
            (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)) : ℝ) : ℂ))
      (fun I => kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K)) *
        (((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
            (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)) : ℝ) : ℂ))
      ?_ ?_ ?_
    · intro I
      rw [hmulnorm _ _ (ha0 I), hmulnorm _ _ (ha0 I),
        hnorm (I : Ideal (NumberField.RingOfIntegers K))]
    · intro I
      have h1 : (lam (I : Ideal (NumberField.RingOfIntegers K))).re
          ≤ (kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K))).re := by
        rw [(hchi (I : Ideal (NumberField.RingOfIntegers K))).1,
          ← hnorm (I : Ideal (NumberField.RingOfIntegers K))]
        exact Complex.re_le_norm _
      rw [hmulre, hmulre]
      exact mul_le_mul_of_nonneg_right h1 (ha0 I)
    · intro I
      rw [hmulre]
      exact mul_nonneg (hchi (I : Ideal (NumberField.RingOfIntegers K))).2 (ha0 I)
  
  have s6 : ∀ (q : Ideal (NumberField.RingOfIntegers K)), q ≠ 0 → ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          (1 - (kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K))).re) *
            (kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
              (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ))) ∧
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            (1 - (kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K))).re) *
              (kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
                (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)))
          ≤ Real.log (Ideal.absNorm q) := by
    intro q hq σ hσ
    have hσ1 : (1 : ℝ) ≤ σ := hσ.le
    have ramB : ∃ Pq : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ P ∈ Pq, P.IsPrime ∧ P ≠ ⊥) ∧
        (∀ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
            P.IsPrime → P ≠ ⊥ → 0 < k → P ^ k ⊔ q ≠ ⊤ → P ∈ Pq) ∧
        (∏ P ∈ Pq, Ideal.absNorm P) ≤ Ideal.absNorm q := by
      have hqb : q ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
      refine ⟨(UniqueFactorizationMonoid.normalizedFactors q).toFinset, ?_, ?_, ?_⟩
      · intro P hP
        rw [Multiset.mem_toFinset] at hP
        have hp : Prime P := UniqueFactorizationMonoid.prime_of_normalized_factor P hP
        refine ⟨Ideal.isPrime_of_prime hp, ?_⟩
        have h0 : P ≠ 0 := hp.ne_zero
        rwa [← Submodule.zero_eq_bot]
      · intro P k hP hPb hk hne
        have hsup : P ⊔ q ≠ ⊤ := by
          intro hc
          have hcop : IsCoprime P q := Ideal.isCoprime_iff_sup_eq.mpr hc
          have hcop2 : IsCoprime (P ^ k) q := hcop.pow_left
          exact hne (Ideal.isCoprime_iff_sup_eq.mp hcop2)
