      have e3 : Real.exp (u + 5 * (u * v)) ≤ Real.exp (7 * (u * v)) * η := by
        calc Real.exp (u + 5 * (u * v)) ≤ Real.exp (7 * (u * v) + -u) :=
              Real.exp_le_exp.mpr (by linarith)
          _ = Real.exp (7 * (u * v)) * Real.exp (-u) := Real.exp_add _ _
          _ ≤ Real.exp (7 * (u * v)) * η :=
              mul_le_mul_of_nonneg_left hη1 (Real.exp_pos _).le
      calc _ ≤ _ := e1
        _ = _ := e2
        _ ≤ G * ℓ ^ (2 * Module.finrank ℚ K) * (Real.exp (7 * (u * v)) * η) :=
            mul_le_mul_of_nonneg_left e3 hGl
        _ = G * ℓ ^ (2 * Module.finrank ℚ K) * Real.exp (7 * (u * v)) * η := by ring
    have hbase0 : 0 ≤ (C₀ * ℓ) ^ Module.finrank ℚ K * (Ideal.absNorm 𝔮 : ℝ)
        * ((m ^ k : ℕ) : ℝ) / (η / (2 * κb)) := by
      apply div_nonneg _ (div_pos hηpos (by linarith)).le
      exact mul_nonneg (mul_nonneg hHn (by positivity)) (by positivity)
    have hpow := pow_le_pow_left₀ hbase0 hbase A₁
    have e4 : (G * ℓ ^ (2 * Module.finrank ℚ K) * Real.exp (7 * (u * v))) ^ A₁
        = G ^ A₁ * ℓ ^ (2 * Module.finrank ℚ K * A₁) * Real.exp ((A₁ : ℝ) * (7 * (u * v))) := by
      rw [Real.exp_nat_mul, mul_pow, mul_pow, ← pow_mul]
    have e5 : ℓ ^ (2 * Module.finrank ℚ K * A₁) ≤ ℓ ^ a₀ :=
      pow_le_pow_right₀ hℓ1 (by rw [ha₀_def]; omega)
    have e6 : Real.exp ((A₁ : ℝ) * (7 * (u * v))) ≤ Real.exp ((a₀ : ℝ) * (u * v)) := by
      apply Real.exp_le_exp.mpr
      have h7n : 7 * A₁ ≤ a₀ := by rw [ha₀_def]; omega
      have h7 : (7 * A₁ : ℝ) ≤ (a₀ : ℝ) := by exact_mod_cast h7n
      have h := mul_le_mul_of_nonneg_right h7 huv0
      have e : (A₁ : ℝ) * (7 * (u * v)) = 7 * A₁ * (u * v) := by ring
      rw [e]
      exact h
    have hfin : Real.exp (ℓ - 1) ≤ (⌊M⌋₊ : ℝ) := by
      have h1 : Real.exp (ℓ - 1) = M / Real.exp 1 := by
        rw [Real.exp_sub, ← hℓ, Real.exp_log hMpos]
      have h2 : (2:ℝ) ≤ Real.exp 1 := by
        have := Real.add_one_le_exp (1:ℝ); linarith
      rw [h1, div_le_iff₀ (Real.exp_pos 1)]
      have h3 := mul_le_mul_of_nonneg_left h2 (by linarith : (0:ℝ) ≤ (⌊M⌋₊ : ℝ))
      linarith
    calc C₁ * ((C₀ * ℓ) ^ Module.finrank ℚ K * (Ideal.absNorm 𝔮 : ℝ) * ((m ^ k : ℕ) : ℝ)
          / (η / (2 * κb))) ^ A₁
        ≤ C₁ * (G * ℓ ^ (2 * Module.finrank ℚ K) * Real.exp (7 * (u * v))) ^ A₁ :=
          mul_le_mul_of_nonneg_left hpow (by linarith)
      _ = K₁ * ℓ ^ (2 * Module.finrank ℚ K * A₁) * Real.exp ((A₁ : ℝ) * (7 * (u * v))) := by
          rw [e4, hK₁_def]; ring
      _ ≤ K₁ * ℓ ^ a₀ * Real.exp ((a₀ : ℝ) * (u * v)) := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left e5 hK₁.le) e6 (Real.exp_pos _).le
          exact mul_nonneg hK₁.le (pow_nonneg (by linarith) _)
      _ ≤ Real.exp (ℓ - 1) := hT3
      _ ≤ _ := hfin
  
  obtain ⟨q, hq, hmaj⟩ := hTI ⌊M⌋₊ (Ideal.absNorm 𝔮) (m ^ k) k Pp Ω Cq F (η / (2 * κb))
    ((C₀ * ℓ) ^ Module.finrank ℚ K) p₀ p₁ p₂ (by omega) hQ1n hprime hΩc
    (div_pos hηpos (by linarith)) hη''1 (by rw [← hH₀_def]; exact hH) hCqper hFper hDT
    (fun T hT _ => (hs4 T hT).1)
    (fun T hT hTk => (hs4 T hT).2 ⌊M⌋₊ ((hDT T hT hTk).trans hD2))
    hC4 (by rw [hSt, hBc] at hmain; exact hmain)
  
  have hT : C₁ * ((C₀ * ℓ) ^ Module.finrank ℚ K * (Ideal.absNorm 𝔮 : ℝ) / (η / (2 * κb))) ^ A₁
      ≤ Real.exp (Cm * (1 + Real.log X) ^ 1) := by
    have hb1 : (C₀ * ℓ) ^ Module.finrank ℚ K * (Ideal.absNorm 𝔮 : ℝ) / (η / (2 * κb))
        = G * (ℓ ^ (2 * Module.finrank ℚ K) * ((Ideal.absNorm 𝔮 : ℝ) / η)) := by
      rw [div_div_eq_mul_div, hG_def, hκb_def]; ring
    have hQη : 1 ≤ (Ideal.absNorm 𝔮 : ℝ) / η := by
      rw [le_div_iff₀ hηpos]; linarith
    have hb2 : ℓ ^ (2 * Module.finrank ℚ K) * ((Ideal.absNorm 𝔮 : ℝ) / η)
        ≤ X ^ (2 * Module.finrank ℚ K) := by
      have hXe : X = ℓ * ((Ideal.absNorm 𝔮 : ℝ) / η) := by rw [hX_def]; ring
      rw [hXe, mul_pow]
      exact mul_le_mul_of_nonneg_left (le_self_pow₀ hQη (by omega))
        (pow_nonneg (by linarith) _)
    have hb0 : 0 ≤ ℓ ^ (2 * Module.finrank ℚ K) * ((Ideal.absNorm 𝔮 : ℝ) / η) :=
      mul_nonneg (pow_nonneg (by linarith) _) (div_nonneg (by positivity) hηpos.le)
    calc C₁ * ((C₀ * ℓ) ^ Module.finrank ℚ K * (Ideal.absNorm 𝔮 : ℝ) / (η / (2 * κb))) ^ A₁
        = C₁ * (G * (ℓ ^ (2 * Module.finrank ℚ K) * ((Ideal.absNorm 𝔮 : ℝ) / η))) ^ A₁ := by
          rw [hb1]
      _ ≤ C₁ * (G * X ^ (2 * Module.finrank ℚ K)) ^ A₁ := by
          apply mul_le_mul_of_nonneg_left _ (by linarith)
          exact pow_le_pow_left₀ (mul_nonneg hG.le hb0) (mul_le_mul_of_nonneg_left hb2 hG.le) A₁
      _ = K₁ * X ^ (2 * Module.finrank ℚ K * A₁) := by
          rw [hK₁_def, mul_pow, ← pow_mul]; ring
      _ = Real.exp (Real.log K₁ + ((2 * Module.finrank ℚ K * A₁ : ℕ) : ℝ) * Real.log X) := by
          rw [Real.exp_add, Real.exp_log hK₁, Real.exp_nat_mul, Real.exp_log hXpos]
      _ ≤ Real.exp (Cm * (1 + Real.log X) ^ 1) := by
          apply Real.exp_le_exp.mpr
          push_cast
          rw [pow_one]
          have h := mul_le_mul_of_nonneg_right hCmA hlogX
          have e : Cm * (1 + Real.log X) = Cm + Cm * Real.log X := by ring
          rw [e]
          linarith
  exact ⟨q, hq.trans hT, hmono q _ _ _ hT hmaj⟩

theorem kai_place_small_count (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ Cs : ℝ, 0 ≤ Cs ∧ ∀ (M t : ℝ), 0 ≤ M → 0 ≤ t →
      ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => ∃ w : NumberField.InfinitePlace K, w (x : K) ≤ t)
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
        ≤ Cs * (t + 1) * (2 * (⌊M⌋₊ : ℝ) + 1) ^ (Module.finrank ℚ K - 1) :=
by
  classical
  
  have slab : ∀ (n : ℕ) (a : Fin n → ℝ) (l₀ : Fin n), a l₀ ≠ 0 → ∀ (N : ℕ) (t : ℝ), 0 ≤ t →
      (((intBox n N).filter (fun z : Fin n → ℤ => |∑ l, ((z l : ℤ) : ℝ) * a l| ≤ t)).card : ℝ)
        ≤ (2 * (2 / |a l₀|) + 1) * (t + 1) * (2 * (N : ℝ) + 1) ^ (n - 1) := by
    intro n a l₀ ha N t ht
    have hc : 0 < |a l₀| := abs_pos.mpr ha
    set c := |a l₀| with hc_def
    set S := (intBox n N).filter (fun z : Fin n → ℤ => |∑ l, ((z l : ℤ) : ℝ) * a l| ≤ t)
      with hS
    set K₀ : ℕ := ⌊2 * t / c⌋₊ with hK₀_def
    set π : (Fin n → ℤ) → ({l // l ≠ l₀} → ℤ) := fun z l => z l.1 with hπ
    have hdiff : ∀ z z' : Fin n → ℤ, π z = π z' →
        ∑ l, ((z l : ℤ) : ℝ) * a l - ∑ l, ((z' l : ℤ) : ℝ) * a l
          = (((z l₀ - z' l₀ : ℤ)) : ℝ) * a l₀ := by
      intro z z' h
      rw [← Finset.sum_sub_distrib, Finset.sum_eq_single l₀]
      · push_cast; ring
      · intro l _ hl
        have : z l = z' l := congrFun h ⟨l, hl⟩
        rw [this]; ring
      · intro h'; exact absurd (Finset.mem_univ l₀) h'
    have hext : ∀ z z' : Fin n → ℤ, π z = π z' → z l₀ = z' l₀ → z = z' := by
      intro z z' h h0
      funext l
      by_cases hl : l = l₀
      · subst hl; exact h0
      · exact congrFun h ⟨l, hl⟩
    have hint : ∀ d : ℤ, (d : ℝ) ≤ 2 * t / c → d ≤ (K₀ : ℤ) := by
      intro d hd
      rcases le_or_gt d 0 with h0 | h0
      · omega
      · have h1 : ((d.toNat : ℕ) : ℝ) ≤ 2 * t / c := by
          have : (((d.toNat : ℕ) : ℤ) : ℝ) = (d : ℝ) := by rw [Int.toNat_of_nonneg h0.le]
          rw [Int.cast_natCast] at this
          rw [this]; exact hd
        have h2 : d.toNat ≤ K₀ := Nat.le_floor h1
        omega
    have hfib : ∀ b ∈ S.image π, (S.filter (fun z => π z = b)).card ≤ 2 * K₀ + 1 := by
      intro b hb
      obtain ⟨zs, hzsS, hzsb⟩ := Finset.mem_image.mp hb
      have hmaps : ∀ z ∈ S.filter (fun z => π z = b),
          z l₀ ∈ Finset.Icc (zs l₀ - K₀) (zs l₀ + K₀) := by
        intro z hz
        rw [Finset.mem_filter] at hz
        obtain ⟨hzS, hzb⟩ := hz
        have hzS' := (Finset.mem_filter.mp hzS).2
        have hzsS' := (Finset.mem_filter.mp hzsS).2
        have hd := hdiff z zs (hzb.trans hzsb.symm)
        have h1 : |((z l₀ - zs l₀ : ℤ) : ℝ)| * c ≤ 2 * t := by
          rw [hc_def, ← abs_mul, ← hd]
          calc _ ≤ |∑ l, ((z l : ℤ) : ℝ) * a l| + |∑ l, ((zs l : ℤ) : ℝ) * a l| := abs_sub _ _
            _ ≤ 2 * t := by linarith
        have h2 : |((z l₀ - zs l₀ : ℤ) : ℝ)| ≤ 2 * t / c := by
          rw [le_div_iff₀ hc]; exact h1
        have h3 := hint (z l₀ - zs l₀) ((le_abs_self _).trans h2)
        have h4 := hint (-(z l₀ - zs l₀)) (by rw [Int.cast_neg]; exact (neg_le_abs _).trans h2)
        rw [Finset.mem_Icc]
        constructor <;> omega
      calc (S.filter (fun z => π z = b)).card
          ≤ (Finset.Icc (zs l₀ - K₀) (zs l₀ + K₀)).card := by
            apply Finset.card_le_card_of_injOn (fun z => z l₀)
              (fun z hz => Finset.mem_coe.mpr (hmaps z (Finset.mem_coe.mp hz)))
            intro z hz z' hz' heq
            have hz1 := (Finset.mem_filter.mp hz).2
            have hz2 := (Finset.mem_filter.mp hz').2
            exact hext z z' (hz1.trans hz2.symm) heq
        _ = 2 * K₀ + 1 := by
            rw [Int.card_Icc]; omega
    have himg : (S.image π).card ≤ (2 * N + 1) ^ (n - 1) := by
      calc (S.image π).card
          ≤ (Fintype.piFinset (fun _ : {l // l ≠ l₀} => Finset.Icc (-(N : ℤ)) N)).card := by
            apply Finset.card_le_card
            intro b hb
            obtain ⟨z, hzS, rfl⟩ := Finset.mem_image.mp hb
            have hz := (Finset.mem_filter.mp hzS).1
            unfold intBox at hz
            rw [Finset.mem_Icc] at hz
            rw [Fintype.mem_piFinset]
            intro l
            rw [Finset.mem_Icc]
            exact ⟨hz.1 l.1, hz.2 l.1⟩
        _ = (2 * N + 1) ^ (n - 1) := by
            rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Int.card_Icc]
            have hcard : Fintype.card {l // l ≠ l₀} = n - 1 := by
              rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq, Fintype.card_fin]
            rw [hcard]
            congr 1
            omega
    have hcard : S.card ≤ (2 * K₀ + 1) * (2 * N + 1) ^ (n - 1) :=
      (Finset.card_le_mul_card_image S _ hfib).trans (Nat.mul_le_mul_left _ himg)
    have hK₀ : (K₀ : ℝ) ≤ 2 * t / c := Nat.floor_le (by positivity)
    have hcardR : (S.card : ℝ) ≤ (2 * (K₀ : ℝ) + 1) * (2 * (N : ℝ) + 1) ^ (n - 1) := by
      exact_mod_cast hcard
    refine hcardR.trans (mul_le_mul_of_nonneg_right ?_ (by positivity))
    have hu : 0 ≤ 2 / c := by positivity
    have h2t : 2 * t / c = 2 / c * t := by ring
    rw [h2t] at hK₀
    nlinarith [mul_nonneg hu ht]
  
  have hlin : ∀ (w : NumberField.InfinitePlace K) (z : Fin (Module.finrank ℚ K) → ℤ),
      (w.embedding ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K)).re
        = ∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re := by
    intro w z
    rw [Module.Basis.equivFun_symm_apply, NumberField.RingOfIntegers.coe_eq_algebraMap, map_sum,
      map_sum, Complex.re_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_zsmul, map_zsmul, zsmul_eq_mul, Complex.mul_re, Complex.intCast_re,
      Complex.intCast_im, zero_mul, sub_zero, NumberField.RingOfIntegers.coe_eq_algebraMap]
  have hbound : ∀ (w : NumberField.InfinitePlace K) (z : Fin (Module.finrank ℚ K) → ℤ),
      |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
        ≤ w ((ω.equivFun.symm z : NumberField.RingOfIntegers K) : K) := by
    intro w z
    rw [← hlin, ← NumberField.InfinitePlace.norm_embedding_eq]
    exact Complex.abs_re_le_norm _
  have hnz : ∀ w : NumberField.InfinitePlace K, ∃ l₀ : Fin (Module.finrank ℚ K),
      (w.embedding ((ω l₀ : NumberField.RingOfIntegers K) : K)).re ≠ 0 := by
    intro w
    by_contra h
    push_neg at h
    have h1 := hlin w (ω.equivFun 1)
    rw [LinearEquiv.symm_apply_apply] at h1
    simp only [h, mul_zero, Finset.sum_const_zero] at h1
    simp at h1
  choose l₀ hl₀ using hnz
  
  refine ⟨∑ w : NumberField.InfinitePlace K,
      (2 * (2 / |(w.embedding ((ω (l₀ w) : NumberField.RingOfIntegers K) : K)).re|) + 1),
    Finset.sum_nonneg (fun w _ => by positivity), ?_⟩
  intro M t hM ht
  have hsub : (@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => ∃ w : NumberField.InfinitePlace K, w (x : K) ≤ t)
          (fun _ => Classical.propDecidable _) (omegaBox ω M))
      ⊆ Finset.univ.biUnion (fun w : NumberField.InfinitePlace K =>
          ((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
            |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
              ≤ t)).image (fun v => ω.equivFun.symm v)) := by
    intro x hx
    rw [Finset.filter_congr_decidable, Finset.mem_filter] at hx
    obtain ⟨hxB, w, hw⟩ := hx
    unfold omegaBox at hxB
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hxB
    rw [Finset.mem_biUnion]
    exact ⟨w, Finset.mem_univ _, Finset.mem_image.mpr
      ⟨v, Finset.mem_filter.mpr ⟨hv, (hbound w v).trans hw⟩, rfl⟩⟩
  have hcard := (Finset.card_le_card hsub).trans Finset.card_biUnion_le
  have hcardR : ((@Finset.filter (NumberField.RingOfIntegers K)
          (fun x => ∃ w : NumberField.InfinitePlace K, w (x : K) ≤ t)
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
      ≤ ∑ w : NumberField.InfinitePlace K,
          (((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
            |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
              ≤ t)).card : ℝ) := by
    have h2 : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
        (((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
            |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
              ≤ t)).image (fun v => ω.equivFun.symm v)).card
        ≤ ((intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun z : Fin (Module.finrank ℚ K) → ℤ =>
            |∑ l, ((z l : ℤ) : ℝ) * (w.embedding ((ω l : NumberField.RingOfIntegers K) : K)).re|
              ≤ t)).card := fun w _ => Finset.card_image_le
    have h3 := hcard.trans (Finset.sum_le_sum h2)
    exact_mod_cast h3
  refine hcardR.trans ?_
  rw [Finset.sum_mul, Finset.sum_mul]
  exact Finset.sum_le_sum (fun w _ => slab _ _ (l₀ w) (hl₀ w) ⌊M⌋₊ t ht)

theorem kai_quad_major_of_sq_le (ν N : ℕ) (hN : 1 ≤ N) (T : ℝ) (hT : (N : ℝ) ^ 2 ≤ T)
    (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ) :
    KaiQuadMajor ν N 1 T (kaiQuadPoly p₀ p₁ p₂) :=
by
  have hn1 : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
  have hn : (0 : ℝ) < (N : ℝ) := by linarith
  have hn2 : (0 : ℝ) < (N : ℝ) ^ 2 := pow_pos hn 2
  have hA : (1 : ℝ) / 2 ≤ T / (((1 : ℕ) : ℝ) * (N : ℝ)) := by
    rw [Nat.cast_one, one_mul, le_div_iff₀ hn]
    nlinarith
  have hB : (1 : ℝ) / 2 ≤ T / (((1 : ℕ) : ℝ) * (N : ℝ) ^ 2) := by
    rw [Nat.cast_one, one_mul, le_div_iff₀ hn2]
    nlinarith
  unfold KaiQuadMajor
  refine ⟨le_refl 1, p₀, fun l => round (p₁ l), fun l l' => round (p₂ l l'),
    fun l => p₁ l - (round (p₁ l) : ℝ), fun l l' => p₂ l l' - (round (p₂ l l') : ℝ),
    fun l => (abs_sub_round (p₁ l)).trans hA,
    fun l l' => (abs_sub_round (p₂ l l')).trans hB, ?_⟩
  intro z
  have h1 : ∑ l, p₁ l * (z l : ℝ) = ∑ l, ((round (p₁ l) : ℤ) : ℝ) * (z l : ℝ)
      + ∑ l, (p₁ l - ((round (p₁ l) : ℤ) : ℝ)) * (z l : ℝ) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun l _ => by ring)
  have h2 : ∑ l, ∑ l', p₂ l l' * (z l : ℝ) * (z l' : ℝ)
      = ∑ l, ∑ l', ((round (p₂ l l') : ℤ) : ℝ) * (z l : ℝ) * (z l' : ℝ)
        + ∑ l, ∑ l', (p₂ l l' - ((round (p₂ l l') : ℤ) : ℝ)) * (z l : ℝ) * (z l' : ℝ) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun l' _ => by ring)
  simp only [kaiQuadPoly, Nat.cast_one, div_one]
  rw [h1, h2]
  ring

theorem kai_box_cell_partition (ν N H : ℕ) (hH : 1 ≤ H) (hHN : H ≤ N) :
    ∃ (cell : (Fin ν → ℤ) → (Fin ν → Fin H)) (Ω : (Fin ν → Fin H) → Set (Fin ν → ℝ)),
      (∀ j, MeasurableSet (Ω j)) ∧ (∀ j, Convex ℝ (Ω j)) ∧
      (∀ z ∈ intBox ν N, ∀ j, ((fun l => ((z l : ℤ) : ℝ)) ∈ Ω j ↔ cell z = j)) ∧
      (∀ z ∈ intBox ν N, ∀ z' ∈ intBox ν N, cell z = cell z' →
        ∀ l, |((z l : ℤ) : ℝ) - ((z' l : ℤ) : ℝ)| ≤ 4 * (N : ℝ) / (H : ℝ)) :=
by
  classical
  have hNpos : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hHpos : (0:ℝ) < H := by exact_mod_cast (show 0 < H by omega)
  obtain ⟨f, hf_def⟩ : ∃ f : ℝ → ℕ,
      f = fun t => min ⌊(t + (N:ℝ)) * (H:ℝ) / (2 * (N:ℝ))⌋₊ (H - 1) := ⟨_, rfl⟩
  have hflt : ∀ t, f t < H := by
    intro t
    rw [hf_def]
    exact lt_of_le_of_lt (min_le_right _ _) (by omega)
  have hmono : Monotone f := by
    intro a b hab
    rw [hf_def]
    apply min_le_min_right
    apply Nat.floor_mono
    apply div_le_div_of_nonneg_right _ (by positivity)
    exact mul_le_mul_of_nonneg_right (by linarith) hHpos.le
  have hfib : ∀ i : ℕ, (f ⁻¹' {i}).OrdConnected :=
    fun i => Set.ordConnected_singleton.preimage_mono hmono
  have hkey : ∀ t : ℝ, |t| ≤ (N:ℝ) →
      ((f t : ℝ) ≤ (t + N) * H / (2 * N) ∧ (t + N) * H / (2 * N) ≤ (f t : ℝ) + 1) := by
    intro t ht
    obtain ⟨h1, h2⟩ := abs_le.mp ht
    have hu0 : 0 ≤ (t + (N:ℝ)) * (H:ℝ) / (2 * (N:ℝ)) :=
      div_nonneg (mul_nonneg (by linarith) hHpos.le) (by positivity)
    have huH : (t + (N:ℝ)) * (H:ℝ) / (2 * (N:ℝ)) ≤ H := by
      rw [div_le_iff₀ (by positivity)]
      nlinarith
    have hft : f t = min ⌊(t + (N:ℝ)) * (H:ℝ) / (2 * (N:ℝ))⌋₊ (H - 1) := by rw [hf_def]
    rcases le_total ⌊(t + (N:ℝ)) * (H:ℝ) / (2 * (N:ℝ))⌋₊ (H - 1) with hle | hle
    · rw [hft, min_eq_left hle]
      exact ⟨Nat.floor_le hu0, (Nat.lt_floor_add_one _).le⟩
    · rw [hft, min_eq_right hle]
      have hc : ((H - 1 : ℕ) : ℝ) = (H:ℝ) - 1 := by rw [Nat.cast_sub hH]; simp
      refine ⟨(Nat.le_floor_iff hu0).mp hle, ?_⟩
      rw [hc]; linarith
  have hwidth : ∀ t t' : ℝ, |t| ≤ (N:ℝ) → |t'| ≤ (N:ℝ) → f t = f t' →
      |t - t'| ≤ 2 * N / H := by
    intro t t' ht ht' he
    obtain ⟨a1, a2⟩ := hkey t ht
    obtain ⟨b1, b2⟩ := hkey t' ht'
    rw [he] at a1 a2
    have hd : |(t + N) * H / (2 * N) - (t' + N) * H / (2 * N)| ≤ 1 := by
      rw [abs_le]; constructor <;> linarith
    have heq : (t + N) * H / (2 * N) - (t' + N) * H / (2 * N)
        = (t - t') * (H / (2 * N)) := by
      field_simp; ring
    rw [heq, abs_mul, abs_of_pos (by positivity : (0:ℝ) < H / (2 * N))] at hd
    rw [le_div_iff₀ hHpos]
    have h1 : |t - t'| * (H / (2 * N)) * (2 * N) ≤ 1 * (2 * N) :=
      mul_le_mul_of_nonneg_right hd (by positivity)
    have h2 : |t - t'| * (H / (2 * N)) * (2 * N) = |t - t'| * H := by field_simp
    linarith
  have hbox : ∀ z ∈ intBox ν N, ∀ l, |((z l : ℤ) : ℝ)| ≤ (N:ℝ) := by
    intro z hz l
    unfold intBox at hz
    rw [Finset.mem_Icc] at hz
    have e1 : -(N:ℤ) ≤ z l := hz.1 l
    have e2 : z l ≤ (N:ℤ) := hz.2 l
    have e1' : -(N:ℝ) ≤ ((z l : ℤ) : ℝ) := by exact_mod_cast e1
    have e2' : ((z l : ℤ) : ℝ) ≤ (N:ℝ) := by exact_mod_cast e2
    exact abs_le.mpr ⟨e1', e2'⟩
  refine ⟨fun z l => ⟨f ((z l : ℤ) : ℝ), hflt _⟩,
    fun j => Set.univ.pi (fun l => f ⁻¹' {((j l : Fin H) : ℕ)}), ?_, ?_, ?_, ?_⟩
  · intro j
    exact MeasurableSet.univ_pi (fun l => (hfib _).measurableSet)
  · intro j
    exact convex_pi (fun l _ => (hfib _).convex)
  · intro z _ j
    simp only [Set.mem_univ_pi, Set.mem_preimage, Set.mem_singleton_iff, funext_iff,
      Fin.ext_iff]
  · intro z hz z' hz' hc l
    have he : f ((z l : ℤ) : ℝ) = f ((z' l : ℤ) : ℝ) := congrArg Fin.val (congrFun hc l)
    have hw := hwidth _ _ (hbox z hz l) (hbox z' hz' l) he
    have h24 : 2 * (N:ℝ) / H ≤ 4 * N / H := by
      apply div_le_div_of_nonneg_right _ hHpos.le
      linarith
    exact hw.trans h24

theorem kai_twist_weight_local (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω)
    (x x' : NumberField.RingOfIntegers K) (δ s β : ℝ) (hδ : 0 < δ)
    (hβ1 : (1 / 2 : ℝ) ≤ β) (hβ2 : β ≤ 1)
    (hx : ∀ w : NumberField.InfinitePlace K, δ ≤ w (x : K))
    (hx' : ∀ w : NumberField.InfinitePlace K, δ ≤ w (x' : K))
    (hs : ∀ l, |((ω.equivFun x l : ℤ) : ℝ) - ((ω.equivFun x' l : ℤ) : ℝ)| ≤ s)
    (hCs : C * s < 2 * δ) :
    (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw (x' : K)) ∧
    |((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) - ((Algebra.norm ℤ x').natAbs : ℝ) ^ (β - 1)|
      ≤ (Module.finrank ℚ K : ℝ) * C * s / (2 * δ) :=
by
  classical
  have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hC1 : 1 < C := hω.1
  
  have hplace : ∀ w : NumberField.InfinitePlace K, w ((x : K) - (x' : K)) ≤ C * s := by
    intro w
    have h1 : w ((x : K) - (x' : K))
        ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K (x - x')) := by
      have hsub : algebraMap (NumberField.RingOfIntegers K) K (x - x') = (x : K) - (x' : K) :=
        map_sub _ _ _
      rw [hsub]
      unfold canNorm
      exact le_ciSup (f := fun v : NumberField.InfinitePlace K => v ((x : K) - (x' : K)))
        (Set.finite_range _).bddAbove w
    have h2 := (hω.2 (x - x')).2
    have h3 : basisSupNorm ω (x - x') ≤ s := by
      unfold basisSupNorm
      haveI : Nonempty (Fin (Module.finrank ℚ K)) := ⟨⟨0, hn⟩⟩
      apply ciSup_le
      intro j
      have := hs j
      simpa [Module.Basis.equivFun_apply, map_sub, Finsupp.sub_apply, Int.cast_sub] using this
    have h4 : C * basisSupNorm ω (x - x') ≤ C * s := mul_le_mul_of_nonneg_left h3 (by linarith)
    linarith
  
  have key : ∀ a b : ℝ, δ ≤ |a| → δ ≤ |b| → |a - b| < 2 * δ → 0 < a * b := by
    intro a b ha hb hab
    rcases le_or_gt 0 a with h1 | h1 <;> rcases le_or_gt 0 b with h2 | h2
    · rw [abs_of_nonneg h1] at ha; rw [abs_of_nonneg h2] at hb; nlinarith
    · rw [abs_of_nonneg h1] at ha; rw [abs_of_neg h2] at hb
      rw [abs_of_nonneg (by linarith)] at hab; linarith
    · rw [abs_of_neg h1] at ha; rw [abs_of_nonneg h2] at hb
      rw [abs_of_neg (by linarith)] at hab; linarith
    · rw [abs_of_neg h1] at ha; rw [abs_of_neg h2] at hb; nlinarith
  have hsign : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
        NumberField.InfinitePlace.embedding_of_isReal hw (x' : K) := by
    intro w hw
    have habs : ∀ y : K, |NumberField.InfinitePlace.embedding_of_isReal hw y| = w y := by
      intro y
      rw [← Real.norm_eq_abs]
      exact NumberField.InfinitePlace.norm_embedding_of_isReal hw y
    apply key
    · rw [habs]; exact hx w
    · rw [habs]; exact hx' w
    · rw [← map_sub, habs]; exact lt_of_le_of_lt (hplace w) hCs
  refine ⟨hsign, ?_⟩
  
  have hprod : ∀ y : NumberField.RingOfIntegers K,
      ((Algebra.norm ℤ y).natAbs : ℝ) = ∏ w : NumberField.InfinitePlace K, w (y : K) ^ w.mult := by
    intro y
    rw [NumberField.InfinitePlace.prod_eq_abs_norm, ← Algebra.coe_norm_int]
    rw [Nat.cast_natAbs]
    push_cast
    rfl
  
  have hlogA : ∀ y : NumberField.RingOfIntegers K, (∀ w : NumberField.InfinitePlace K, δ ≤ w (y : K)) →
      Real.log ((Algebra.norm ℤ y).natAbs : ℝ)
        = ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (w (y : K)) := by
    intro y hy
    rw [hprod y, Real.log_prod]
    · refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [Real.log_pow]
    · intro w _
      exact pow_ne_zero _ (by linarith [hy w])
  
  have hone : ∀ y : NumberField.RingOfIntegers K, (∀ w : NumberField.InfinitePlace K, δ ≤ w (y : K)) →
      (1 : ℝ) ≤ ((Algebra.norm ℤ y).natAbs : ℝ) := by
    intro y hy
    have hpos : (0 : ℝ) < ((Algebra.norm ℤ y).natAbs : ℝ) := by
      rw [hprod y]
      exact Finset.prod_pos (fun w _ => pow_pos (by linarith [hy w]) _)
    have hne : (Algebra.norm ℤ y).natAbs ≠ 0 := by
      intro h0; rw [h0, Nat.cast_zero] at hpos; exact lt_irrefl _ hpos
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
  
  have one_side : ∀ u v : ℝ, δ ≤ u → δ ≤ v → Real.log u - Real.log v ≤ |u - v| / δ := by
    intro u v hu hv
    have hu0 : 0 < u := by linarith
    have hv0 : 0 < v := by linarith
    rw [← Real.log_div hu0.ne' hv0.ne']
    have h1 := Real.log_le_sub_one_of_pos (div_pos hu0 hv0)
    have h2 : u / v - 1 = (u - v) / v := by field_simp
    have h3 : (u - v) / v ≤ |u - v| / v := div_le_div_of_nonneg_right (le_abs_self _) hv0.le
    have h4 : |u - v| / v ≤ |u - v| / δ := div_le_div_of_nonneg_left (abs_nonneg _) hδ hv
    linarith
  have hloglip : ∀ u v : ℝ, δ ≤ u → δ ≤ v → |u - v| ≤ C * s →
      |Real.log u - Real.log v| ≤ C * s / δ := by
    intro u v hu hv huv
    have e1 := one_side u v hu hv
    have e2 := one_side v u hv hu
    rw [abs_sub_comm v u] at e2
    have e3 : |u - v| / δ ≤ C * s / δ := div_le_div_of_nonneg_right huv hδ.le
    rw [abs_le]; constructor <;> linarith
  have hlogdiff : |Real.log ((Algebra.norm ℤ x).natAbs : ℝ) - Real.log ((Algebra.norm ℤ x').natAbs : ℝ)|
      ≤ (Module.finrank ℚ K : ℝ) * (C * s / δ) := by
    rw [hlogA x hx, hlogA x' hx', ← Finset.sum_sub_distrib]
    calc _ ≤ ∑ w : NumberField.InfinitePlace K,
          |(w.mult : ℝ) * Real.log (w (x : K)) - (w.mult : ℝ) * Real.log (w (x' : K))| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (C * s / δ) := by
          apply Finset.sum_le_sum
          intro w _
          rw [← mul_sub, abs_mul, Nat.abs_cast]
          apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
          apply hloglip _ _ (hx w) (hx' w)
          exact (AbsoluteValue.abs_abv_sub_le_abv_sub w.1 (x : K) (x' : K)).trans (hplace w)
      _ = (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)) * (C * s / δ) :=
          (Finset.sum_mul _ _ _).symm
      _ = (Module.finrank ℚ K : ℝ) * (C * s / δ) := by
          rw [← Nat.cast_sum, NumberField.InfinitePlace.sum_mult_eq]
  
  have hexp1 : ∀ u v : ℝ, u ≤ 0 → Real.exp u - Real.exp v ≤ |u - v| := by
    intro u v hu
    have e1 : Real.exp v = Real.exp u * Real.exp (v - u) := by rw [← Real.exp_add]; ring_nf
    have e2 := Real.add_one_le_exp (v - u)
    have e3 : 0 < Real.exp u := Real.exp_pos u
    have e4 : Real.exp u ≤ 1 := Real.exp_le_one_iff.mpr hu
    have e5 : Real.exp u * (v - u + 1) ≤ Real.exp v := by
      rw [e1]; exact mul_le_mul_of_nonneg_left e2 e3.le
    have e6 : Real.exp u * (u - v) ≤ |u - v| := by
      calc Real.exp u * (u - v) ≤ Real.exp u * |u - v| :=
            mul_le_mul_of_nonneg_left (le_abs_self _) e3.le
        _ ≤ 1 * |u - v| := mul_le_mul_of_nonneg_right e4 (abs_nonneg _)
        _ = |u - v| := one_mul _
    have e7 : Real.exp u * (v - u + 1) = Real.exp u - Real.exp u * (u - v) := by ring
    linarith
  
  have hA1 : 1 ≤ ((Algebra.norm ℤ x).natAbs : ℝ) := hone x hx
  have hB1 : 1 ≤ ((Algebra.norm ℤ x').natAbs : ℝ) := hone x' hx'
  generalize ((Algebra.norm ℤ x).natAbs : ℝ) = A at hA1 hlogdiff ⊢
  generalize ((Algebra.norm ℤ x').natAbs : ℝ) = B at hB1 hlogdiff ⊢
  have hu : Real.log A * (β - 1) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (Real.log_nonneg hA1) (by linarith)
  have hv : Real.log B * (β - 1) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (Real.log_nonneg hB1) (by linarith)
  rw [Real.rpow_def_of_pos (by linarith), Real.rpow_def_of_pos (by linarith)]
  have hE : |Real.exp (Real.log A * (β - 1)) - Real.exp (Real.log B * (β - 1))|
      ≤ |Real.log A * (β - 1) - Real.log B * (β - 1)| := by
    have f1 := hexp1 (Real.log A * (β - 1)) (Real.log B * (β - 1)) hu
    have f2 := hexp1 (Real.log B * (β - 1)) (Real.log A * (β - 1)) hv
    rw [abs_sub_comm (Real.log B * (β - 1))] at f2
    rw [abs_le]; constructor <;> linarith
  have hD : |Real.log A * (β - 1) - Real.log B * (β - 1)|
      = |Real.log A - Real.log B| * (1 - β) := by
    rw [← sub_mul, abs_mul, abs_of_nonpos (by linarith : β - 1 ≤ 0)]
    ring
  have hfin : |Real.log A - Real.log B| * (1 - β)
      ≤ (Module.finrank ℚ K : ℝ) * (C * s / δ) * (1 / 2) := by
    calc |Real.log A - Real.log B| * (1 - β) ≤ |Real.log A - Real.log B| * (1 / 2) :=
          mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg _)
      _ ≤ (Module.finrank ℚ K : ℝ) * (C * s / δ) * (1 / 2) :=
          mul_le_mul_of_nonneg_right hlogdiff (by norm_num)
  have heq : (Module.finrank ℚ K : ℝ) * (C * s / δ) * (1 / 2)
      = (Module.finrank ℚ K : ℝ) * C * s / (2 * δ) := by
    field_simp
    try ring
  rw [← heq]
  calc _ ≤ _ := hE
    _ = _ := hD
    _ ≤ _ := hfin

theorem kai_cell_class_pigeonhole {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) (H : ℕ) (hH : 1 ≤ H)
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (h𝔮 : 𝔮 ≠ ⊥)
    (Ω : (Fin ν → Fin H) → Set (Fin ν → ℝ)) (cell : (Fin ν → ℤ) → (Fin ν → Fin H))
    (hcell : ∀ x ∈ omegaBox ω M, ∀ j,
      ((fun l => ((ω.equivFun x l : ℤ) : ℝ)) ∈ Ω j ↔ cell (ω.equivFun x) = j))
    (Bad : Finset (NumberField.RingOfIntegers K))
    (hBad : ∀ x ∈ Bad, ∀ x' ∈ omegaBox ω M,
      cell (ω.equivFun x') = cell (ω.equivFun x) → x' ∈ Bad)
    (f u : NumberField.RingOfIntegers K → ℝ) (κ εu : ℝ) (hκ : 0 ≤ κ) (hεu : 0 ≤ εu)
    (hf : ∀ x ∈ omegaBox ω M, |f x| ≤ κ) (hu : ∀ x ∈ omegaBox ω M, |u x| ≤ 1)
    (hosc : ∀ x ∈ omegaBox ω M, ∀ x' ∈ omegaBox ω M, x ∉ Bad →
      cell (ω.equivFun x') = cell (ω.equivFun x) → x - x' ∈ 𝔮 → |u x - u x'| ≤ εu)
    (P : (Fin ν → ℤ) → ℝ) :
    ∃ (j : Fin ν → Fin H) (a : NumberField.RingOfIntegers K),
      ‖∑ x ∈ omegaBox ω M, ((f x * u x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖
        ≤ ((H : ℝ) ^ ν * (Ideal.absNorm 𝔮 : ℝ)) *
            ‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                  (fun x => (fun l => ((ω.equivFun x l : ℤ) : ℝ)) ∈ Ω j ∧ x - a ∈ 𝔮)
                  (fun _ => Classical.propDecidable _) (omegaBox ω M),
                ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖
          + κ * εu * ((omegaBox ω M).card : ℝ) + κ * (Bad.card : ℝ) :=
by
  classical
  set B := omegaBox ω M with hB
  have hg1 : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t
    unfold giE
    rw [Complex.norm_exp]
    simp
  
  have hN0 : Ideal.absNorm 𝔮 ≠ 0 := by
    rw [Ne, Ideal.absNorm_eq_zero_iff]; exact h𝔮
  have hcardQ : Nat.card (NumberField.RingOfIntegers K ⧸ 𝔮) = Ideal.absNorm 𝔮 := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  haveI hfinQ : Finite (NumberField.RingOfIntegers K ⧸ 𝔮) :=
    Nat.finite_of_card_ne_zero (by rw [hcardQ]; exact hN0)
  letI : Fintype (NumberField.RingOfIntegers K ⧸ 𝔮) := Fintype.ofFinite _
  obtain ⟨σ, hσ⟩ : ∃ σ : (NumberField.RingOfIntegers K ⧸ 𝔮) → NumberField.RingOfIntegers K,
      ∀ c, Ideal.Quotient.mk 𝔮 (σ c) = c :=
    ⟨Function.surjInv Ideal.Quotient.mk_surjective, Function.surjInv_eq _⟩
  obtain ⟨rep, hrep⟩ : ∃ rep : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K,
      ∀ x, rep x = σ (Ideal.Quotient.mk 𝔮 x) := ⟨fun x => σ (Ideal.Quotient.mk 𝔮 x), fun _ => rfl⟩
  obtain ⟨R, hR_def⟩ : ∃ R : Finset (NumberField.RingOfIntegers K), R = Finset.univ.image σ :=
    ⟨_, rfl⟩
  have hRcard : R.card ≤ Ideal.absNorm 𝔮 := by
    rw [hR_def, ← hcardQ, Nat.card_eq_fintype_card, ← Finset.card_univ]
    exact Finset.card_image_le
  have hrepR : ∀ x, rep x ∈ R := by
    intro x; rw [hR_def, hrep]; exact Finset.mem_image_of_mem σ (Finset.mem_univ _)
  have hrepsub : ∀ x, x - rep x ∈ 𝔮 := by
    intro x; rw [← Ideal.Quotient.eq, hrep]; exact (hσ _).symm
  have hrepiff : ∀ x a, a ∈ R → (rep x = a ↔ x - a ∈ 𝔮) := by
    intro x a ha
    rw [hR_def] at ha
    obtain ⟨c, -, rfl⟩ := Finset.mem_image.mp ha
    constructor
    · intro h; rw [← h]; exact hrepsub x
    · intro h
      rw [← Ideal.Quotient.eq, hσ] at h
      rw [hrep, h]
  
  haveI : Nonempty (Fin ν → Fin H) := ⟨fun _ => ⟨0, by omega⟩⟩
  obtain ⟨I, hI_def⟩ : ∃ I : Finset ((Fin ν → Fin H) × NumberField.RingOfIntegers K),
      I = (Finset.univ : Finset (Fin ν → Fin H)) ×ˢ R := ⟨_, rfl⟩
  obtain ⟨key, hkey_def⟩ : ∃ key : NumberField.RingOfIntegers K →
      (Fin ν → Fin H) × NumberField.RingOfIntegers K,
      key = fun x => (cell (ω.equivFun x), rep x) := ⟨_, rfl⟩
  have hkey : ∀ x ∈ B, key x ∈ I := by
    intro x _
    rw [hI_def, hkey_def, Finset.mem_product]
    exact ⟨Finset.mem_univ _, hrepR x⟩
  have hInon : I.Nonempty := by
    rw [hI_def]
    exact Finset.univ_nonempty.product ⟨rep 0, hrepR 0⟩
  have hIcard : (I.card : ℝ) ≤ (H : ℝ) ^ ν * (Ideal.absNorm 𝔮 : ℝ) := by
    rw [hI_def, Finset.card_product, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
      Fintype.card_fin]
    push_cast
    exact mul_le_mul_of_nonneg_left (by exact_mod_cast hRcard) (by positivity)
  
  obtain ⟨V, hV⟩ : ∃ V : NumberField.RingOfIntegers K → ℂ,
      ∀ x, V x = ((f x * u x : ℝ) : ℂ) * giE (P (ω.equivFun x)) := ⟨_, fun _ => rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : NumberField.RingOfIntegers K → ℂ,
      ∀ x, W x = ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x)) := ⟨_, fun _ => rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : NumberField.RingOfIntegers K → ℝ,
      ∀ x, E x = κ * εu + if x ∈ Bad then κ else 0 := ⟨_, fun _ => rfl⟩
  
  have hfib : ∀ i ∈ I, ‖∑ x ∈ B.filter (fun x => key x = i), V x‖
      ≤ ‖∑ x ∈ B.filter (fun x => key x = i), W x‖
        + ∑ x ∈ B.filter (fun x => key x = i), E x := by
    intro i _
    have hsubB : ∀ x ∈ B.filter (fun x => key x = i), x ∈ B :=
      fun x hx => (Finset.mem_filter.mp hx).1
    by_cases hex : ∃ x₀ ∈ B.filter (fun x => key x = i), x₀ ∉ Bad
    · obtain ⟨x₀, hx₀F, hx₀nb⟩ := hex
      have hx₀B := hsubB x₀ hx₀F
      have hid : ∑ x ∈ B.filter (fun x => key x = i), V x
          = (u x₀ : ℂ) * ∑ x ∈ B.filter (fun x => key x = i), W x
            + ∑ x ∈ B.filter (fun x => key x = i),
                ((f x * (u x - u x₀) : ℝ) : ℂ) * giE (P (ω.equivFun x)) := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        rw [hV, hW]; push_cast; ring
      rw [hid]
      refine (norm_add_le _ _).trans ?_
      have h1 : ‖(u x₀ : ℂ) * ∑ x ∈ B.filter (fun x => key x = i), W x‖
          ≤ ‖∑ x ∈ B.filter (fun x => key x = i), W x‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
        exact mul_le_of_le_one_left (norm_nonneg _) (hu x₀ hx₀B)
      have h2 : ‖∑ x ∈ B.filter (fun x => key x = i),
                ((f x * (u x - u x₀) : ℝ) : ℂ) * giE (P (ω.equivFun x))‖
          ≤ ∑ x ∈ B.filter (fun x => key x = i), E x := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun x hx => ?_))
        have hxB := hsubB x hx
        have hkx : key x = i := (Finset.mem_filter.mp hx).2
        have hkx₀ : key x₀ = i := (Finset.mem_filter.mp hx₀F).2
        rw [← hkx₀, hkey_def] at hkx
        simp only [Prod.mk.injEq] at hkx
        have hdiff : x₀ - x ∈ 𝔮 := by
          have hm := Ideal.sub_mem 𝔮 (hrepsub x₀) (hrepsub x)
          rw [hkx.2] at hm
          have e : x₀ - x = (x₀ - rep x₀) - (x - rep x₀) := by ring
          rw [e]; exact hm
        have hux : |u x - u x₀| ≤ εu := by
          rw [abs_sub_comm]; exact hosc x₀ hx₀B x hxB hx₀nb hkx.1 hdiff
        have hEx : κ * εu ≤ E x := by
          rw [hE]; split_ifs <;> linarith
        rw [norm_mul, hg1, mul_one, Complex.norm_real, Real.norm_eq_abs, abs_mul]
        calc |f x| * |u x - u x₀| ≤ κ * εu := mul_le_mul (hf x hxB) hux (abs_nonneg _) hκ
          _ ≤ E x := hEx
      linarith
    · push_neg at hex
      have h : ‖∑ x ∈ B.filter (fun x => key x = i), V x‖
          ≤ ∑ x ∈ B.filter (fun x => key x = i), E x := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun x hx => ?_))
        have hxB := hsubB x hx
        rw [hV, norm_mul, hg1, mul_one, Complex.norm_real, Real.norm_eq_abs, abs_mul, hE,
          if_pos (hex x hx)]
        have := mul_le_mul (hf x hxB) (hu x hxB) (abs_nonneg _) hκ
        nlinarith [mul_nonneg hκ hεu]
      linarith [norm_nonneg (∑ x ∈ B.filter (fun x => key x = i), W x)]
  
  obtain ⟨i₀, hi₀I, hi₀max⟩ := Finset.exists_max_image I
    (fun i => ‖∑ x ∈ B.filter (fun x => key x = i), W x‖) hInon
  have hmain : ‖∑ x ∈ B, V x‖
      ≤ (I.card : ℝ) * ‖∑ x ∈ B.filter (fun x => key x = i₀), W x‖ + ∑ x ∈ B, E x := by
    rw [← Finset.sum_fiberwise_of_maps_to hkey V, ← Finset.sum_fiberwise_of_maps_to hkey E]
    refine (norm_sum_le _ _).trans ?_
    have hcardle : ∑ i ∈ I, ‖∑ x ∈ B.filter (fun x => key x = i), W x‖
        ≤ (I.card : ℝ) * ‖∑ x ∈ B.filter (fun x => key x = i₀), W x‖ := by
      have := Finset.sum_le_card_nsmul I
        (fun i => ‖∑ x ∈ B.filter (fun x => key x = i), W x‖) _ hi₀max
      rwa [nsmul_eq_mul] at this
    calc ∑ i ∈ I, ‖∑ x ∈ B.filter (fun x => key x = i), V x‖
        ≤ ∑ i ∈ I, (‖∑ x ∈ B.filter (fun x => key x = i), W x‖
            + ∑ x ∈ B.filter (fun x => key x = i), E x) := Finset.sum_le_sum hfib
      _ = ∑ i ∈ I, ‖∑ x ∈ B.filter (fun x => key x = i), W x‖
            + ∑ i ∈ I, ∑ x ∈ B.filter (fun x => key x = i), E x := Finset.sum_add_distrib
      _ ≤ (I.card : ℝ) * ‖∑ x ∈ B.filter (fun x => key x = i₀), W x‖
            + ∑ i ∈ I, ∑ x ∈ B.filter (fun x => key x = i), E x := by linarith
  
  have hEsum : ∑ x ∈ B, E x ≤ κ * εu * (B.card : ℝ) + κ * (Bad.card : ℝ) := by
    simp only [hE]
    rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul, Finset.sum_ite_mem,
      Finset.sum_const, nsmul_eq_mul]
    have hc : ((B ∩ Bad).card : ℝ) ≤ Bad.card := by
      exact_mod_cast Finset.card_le_card Finset.inter_subset_right
    nlinarith
  
  refine ⟨i₀.1, i₀.2, ?_⟩
  have ha : i₀.2 ∈ R := by
    rw [hI_def] at hi₀I; exact (Finset.mem_product.mp hi₀I).2
  have hfilt : ∑ x ∈ B.filter (fun x => key x = i₀), W x
      = ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                  (fun x => (fun l => ((ω.equivFun x l : ℤ) : ℝ)) ∈ Ω i₀.1 ∧ x - i₀.2 ∈ 𝔮)
                  (fun _ => Classical.propDecidable _) B,
                ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x)) := by
    refine Finset.sum_congr ?_ (fun x _ => hW x)
    ext x
    constructor
    · intro hx
      obtain ⟨hxB, hk⟩ := Finset.mem_filter.mp hx
      rw [hkey_def, Prod.ext_iff] at hk
      exact (@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mpr
        ⟨hxB, (hcell x hxB _).mpr hk.1, (hrepiff x _ ha).mp hk.2⟩
    · intro hx
      obtain ⟨hxB, hΩ, hq⟩ :=
        (@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hx
      refine Finset.mem_filter.mpr ⟨hxB, ?_⟩
      rw [hkey_def, Prod.ext_iff]
      exact ⟨(hcell x hxB _).mp hΩ, (hrepiff x _ ha).mpr hq⟩
  have hLHS : ∑ x ∈ B, ((f x * u x : ℝ) : ℂ) * giE (P (ω.equivFun x)) = ∑ x ∈ B, V x :=
    Finset.sum_congr rfl (fun x _ => (hV x).symm)
  rw [hLHS, ← hfilt]
  have := mul_le_mul_of_nonneg_right hIcard
    (norm_nonneg (∑ x ∈ B.filter (fun x => key x = i₀), W x))
  linarith [hmain, hEsum]

theorem kai_siegel_twist_quad_minor_arc (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ (c₀ Cm : ℝ) (A : ℕ), 0 < c₀ ∧ 1 ≤ Cm ∧ 1 ≤ A ∧
      ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
        Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
        (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
      ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)) (ψ : NumberField.RingOfIntegers K → ℤ)
        (β : ℝ), 𝔮 ≠ ⊥ → IsRealRayChar 𝔮 ψ → (1 / 2 : ℝ) ≤ β → β < 1 →
        (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₀) →
      ∀ η : ℝ, Real.exp (-(Real.log M ^ c₀)) ≤ η → η ≤ 1 →
      ∀ (p₀ : ℝ) (p₁ : Fin (Module.finrank ℚ K) → ℝ)
        (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
        η * ((omegaBox ω M).card : ℝ) ≤
          ‖∑ x ∈ omegaBox ω M,
              ((cramerModel K ρ (primorial m) x * ((ψ x : ℤ) : ℝ)
                  * ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) : ℝ) : ℂ)
                * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ →
        ∃ q : ℕ, (q : ℝ) ≤ Real.exp (Cm * (1 + Real.log
              ((Ideal.absNorm 𝔮 : ℝ) * Real.log M / η)) ^ A) ∧
          KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q
            (Real.exp (Cm * (1 + Real.log ((Ideal.absNorm 𝔮 : ℝ) * Real.log M / η)) ^ A))
            (kaiQuadPoly p₀ p₁ p₂) :=
by
  classical
  
  obtain ⟨c₆, Cm₆, A₆, hc₆, hCm₆, hA₆, hS6⟩ := kai_cramer_quad_minor_arc K C ω hω ρ hρ
  obtain ⟨Cs, hCs, hS2⟩ := kai_place_small_count K ω
  obtain ⟨C_M, hC_M, hdens⟩ := kai_cramer_density_bound K
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  obtain ⟨nR, hnR⟩ : ∃ nR : ℝ, nR = (Module.finrank ℚ K : ℝ) := ⟨_, rfl⟩
  have hnR1 : 1 ≤ nR := by rw [hnR]; exact_mod_cast hn1
  have hnR0 : 0 ≤ nR := by linarith
  have hCMn : 0 ≤ C_M ^ Module.finrank ℚ K := pow_nonneg (by linarith) _
  obtain ⟨Kκ, hKκ⟩ : ∃ Kκ : ℝ, Kκ = ρ * C_M ^ Module.finrank ℚ K + 1 := ⟨_, rfl⟩
  have hKκ1 : 1 ≤ Kκ := by
    rw [hKκ]; have := mul_nonneg hρ.le hCMn; linarith
  have h8nC : 0 ≤ 8 * nR * C := by
    have := mul_nonneg hnR0 hCpos.le; linarith
  have h4Cs : 0 ≤ 4 * Cs * (2 + 4 * C) := by
    have := mul_nonneg hCs (by linarith : (0:ℝ) ≤ 2 + 4 * C); linarith
  obtain ⟨Kc, hKc⟩ : ∃ Kc : ℝ, Kc = 8 * nR * C + 4 * Cs * (2 + 4 * C) + 2 * C + 1 := ⟨_, rfl⟩
  have hKc1 : 1 ≤ Kc := by rw [hKc]; linarith
  have hKc2C : 2 * C + 1 ≤ Kc := by rw [hKc]; linarith
  have hKc8 : 8 * nR * C ≤ Kc := by rw [hKc]; linarith
  have hKc4 : 4 * Cs * (2 + 4 * C) ≤ Kc := by rw [hKc]; linarith
  obtain ⟨K₀, hK₀⟩ : ∃ K₀ : ℝ, K₀ = Kc * Kκ := ⟨_, rfl⟩
  have hK₀1 : 1 ≤ K₀ := by rw [hK₀]; exact one_le_mul_of_one_le_of_one_le hKc1 hKκ1
  have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hlogK₀ : 0 ≤ Real.log K₀ := Real.log_nonneg hK₀1
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = Real.log 2 + 2 * Real.log K₀ := ⟨_, rfl⟩
  have hG0 : 0 ≤ G := by rw [hG]; linarith
  obtain ⟨a₀, ha₀⟩ : ∃ a₀ : ℝ, a₀ = Real.log 2 + nR * G := ⟨_, rfl⟩
  have ha₀0 : 0 ≤ a₀ := by rw [ha₀]; have := mul_nonneg hnR0 hG0; linarith
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = nR * (2 * nR + 2) + 2 := ⟨_, rfl⟩
  have hnb : 0 ≤ nR * (2 * nR + 2) := mul_nonneg hnR0 (by linarith)
  have hb0 : 0 ≤ b := by rw [hb]; linarith
  have hc₀ : 0 < c₆ / 2 := by linarith
  obtain ⟨M₀, hM₀3, hM₀⟩ :=
    eventual_loglog_power_le (c₆ / 2) 1 (a₀ + 2 * b + 1) 1 hc₀ zero_le_one
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = 1 + a₀ + b := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by rw [hD]; linarith
  have hlogM₀ : 0 ≤ Real.log M₀ := Real.log_nonneg (by linarith)
  have hCD : 0 ≤ Cm₆ * D ^ A₆ := mul_nonneg (by linarith) (pow_nonneg (by linarith) _)
  refine ⟨c₆ / 2, Cm₆ * D ^ A₆ + 2 * G + 4 * nR + 4 + 2 * Real.log M₀ + 1, A₆, hc₀, ?_,
    hA₆, ?_⟩
  · linarith
  intro M m hM3 hm1 hm2 𝔮 ψ β h𝔮 hψ hβ1 hβ2 hN𝔮 η hη0 hη1 p₀ p₁ p₂ hbig
  have hS6M := hS6 M m hM3 hm1 hm2
  obtain ⟨Cm, hCm⟩ : ∃ Cm : ℝ,
      Cm = Cm₆ * D ^ A₆ + 2 * G + 4 * nR + 4 + 2 * Real.log M₀ + 1 := ⟨_, rfl⟩
  rw [← hCm]
  have hCm1 : 1 ≤ Cm := by rw [hCm]; linarith
  
  have hMpos : 0 < M := by linarith
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ, ℓ = Real.log M := ⟨_, rfl⟩
  rw [← hℓ] at hN𝔮 hη0 hm1 hm2 hS6M ⊢
  have hℓ1 : 1 < ℓ := by
    rw [hℓ, Real.lt_log_iff_exp_lt hMpos]
    have := Real.exp_one_lt_d9; linarith
  have hℓpos : 0 < ℓ := by linarith
  have hηpos : 0 < η := lt_of_lt_of_le (Real.exp_pos _) hη0
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = ⌊M⌋₊ := ⟨_, rfl⟩
  rw [← hN] at hS6M ⊢
  have hN3 : 3 ≤ N := by rw [hN]; exact Nat.le_floor (by exact_mod_cast hM3)
  have hNR3 : (3:ℝ) ≤ N := by exact_mod_cast hN3
  have hNM : (N:ℝ) ≤ M := by rw [hN]; exact Nat.floor_le hMpos.le
  have hNpos : (0:ℝ) < N := by linarith
  have hN𝔮1 : (1:ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) := by
    have h0 : Ideal.absNorm 𝔮 ≠ 0 := by
      intro h; exact h𝔮 (Ideal.absNorm_eq_zero_iff.mp h)
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr h0
  have hN𝔮pos : (0:ℝ) < (Ideal.absNorm 𝔮 : ℝ) := by linarith
  obtain ⟨y, hy⟩ : ∃ y : ℝ, y = ℓ ^ (c₆ / 2) := ⟨_, rfl⟩
  rw [← hy] at hN𝔮 hη0
  have hlogN𝔮 : Real.log (Ideal.absNorm 𝔮 : ℝ) ≤ y := by
    have := Real.log_le_log hN𝔮pos hN𝔮
    rwa [Real.log_exp] at this
  have hlogη : -y ≤ Real.log η := by
    have := Real.log_le_log (Real.exp_pos _) hη0
    rwa [Real.log_exp] at this
  obtain ⟨L, hL⟩ : ∃ L : ℝ, L = ℓ / η := ⟨_, rfl⟩
  have hLpos : 0 < L := by rw [hL]; exact div_pos hℓpos hηpos
  have hLη : L * η = ℓ := by rw [hL, div_mul_cancel₀ _ hηpos.ne']
  have hℓL : ℓ ≤ L := by
    have := mul_le_mul_of_nonneg_left hη1 hLpos.le
    linarith
  have hL1 : 1 ≤ L := by linarith
  have hlogL : Real.log L = Real.log ℓ - Real.log η := by
    rw [hL, Real.log_div hℓpos.ne' hηpos.ne']
  have hlogℓ0 : 0 ≤ Real.log ℓ := Real.log_nonneg hℓ1.le
  have hlogL0 : 0 ≤ Real.log L := Real.log_nonneg hL1
  have hlogN𝔮0 : 0 ≤ Real.log (Ideal.absNorm 𝔮 : ℝ) := Real.log_nonneg hN𝔮1
  obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = Real.log ((Ideal.absNorm 𝔮 : ℝ) * ℓ / η) := ⟨_, rfl⟩
  rw [← hZ]
  have hZeq : Z = Real.log (Ideal.absNorm 𝔮 : ℝ) + Real.log L := by
    rw [hZ, mul_div_assoc, ← hL, Real.log_mul hN𝔮pos.ne' hLpos.ne']
  have hZ0 : 0 ≤ Z := by linarith
  have hlogLZ : Real.log L ≤ Z := by linarith
  have hlogN𝔮Z : Real.log (Ideal.absNorm 𝔮 : ℝ) ≤ Z := by linarith
  obtain ⟨X, hX⟩ : ∃ X : ℝ, X = 1 + Z := ⟨_, rfl⟩
  rw [← hX]
  have hX1 : 1 ≤ X := by linarith
  have hXA : X ≤ X ^ A₆ := le_self_pow₀ hX1 (by omega)
  have hXA1 : 1 ≤ X ^ A₆ := one_le_pow₀ hX1
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ, Φ = Real.exp (Cm * X ^ A₆) := ⟨_, rfl⟩
  rw [← hΦ]
  
  have htriv : 2 * Real.log N ≤ Cm * X ^ A₆ → ∃ q : ℕ, (q : ℝ) ≤ Φ ∧
      KaiQuadMajor (Module.finrank ℚ K) N q Φ (kaiQuadPoly p₀ p₁ p₂) := by
    intro h
    have hN2 : (N : ℝ) ^ 2 ≤ Φ := by
      rw [hΦ]
      have he : (N : ℝ) ^ 2 = Real.exp (2 * Real.log N) := by
        rw [show (2:ℝ) * Real.log N = Real.log N + Real.log N by ring, Real.exp_add,
          Real.exp_log hNpos]
        ring
      rw [he]; exact Real.exp_le_exp.mpr h
    refine ⟨1, ?_, kai_quad_major_of_sq_le (Module.finrank ℚ K) N (by omega) Φ hN2 p₀ p₁ p₂⟩
    have : (1:ℝ) ≤ (N : ℝ) ^ 2 := one_le_pow₀ (by linarith)
    push_cast; linarith
  by_cases hMM₀ : M₀ ≤ M
  swap
  · apply htriv
    push_neg at hMM₀
    have h1 : Real.log N ≤ Real.log M₀ := Real.log_le_log hNpos (by linarith)
    have h2 : Cm ≤ Cm * X ^ A₆ := le_mul_of_one_le_right (by linarith) hXA1
    have h3 : 2 * Real.log M₀ ≤ Cm := by rw [hCm]; linarith
    linarith
  
  have hyM := hM₀ M hMM₀
  rw [← hℓ, ← hy, pow_one, one_mul] at hyM
  have hy1 : 1 ≤ y := by linarith
  have hyℓ : Real.log ℓ ≤ y := by linarith
  have hya : a₀ + 2 * b ≤ y := by linarith
  
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = Kκ * L ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hLn1 : 1 ≤ L ^ Module.finrank ℚ K := one_le_pow₀ hL1
  have hκ1 : 1 ≤ κ := by rw [hκ]; exact one_le_mul_of_one_le_of_one_le hKκ1 hLn1
  have hκ0 : 0 ≤ κ := by linarith
  have hΛ : ∀ x, 0 ≤ cramerModel K ρ (primorial m) x ∧
      cramerModel K ρ (primorial m) x ≤ κ := by
    intro x
    have hlogm : max 1 (Real.log m) ≤ ℓ := by
      refine max_le hℓ1.le ?_
      have hmpos : (0:ℝ) < m := lt_of_lt_of_le (Real.exp_pos _) hm1
      have h1 : Real.log m ≤ ℓ ^ ((1:ℝ)/3) := by
        have := Real.log_le_log hmpos (show (m:ℝ) ≤ Real.exp (ℓ ^ ((1:ℝ)/3)) by linarith)
        rwa [Real.log_exp] at this
      have h2 : ℓ ^ ((1:ℝ)/3) ≤ ℓ := by
        calc ℓ ^ ((1:ℝ)/3) ≤ ℓ ^ (1:ℝ) :=
              Real.rpow_le_rpow_of_exponent_le hℓ1.le (by norm_num)
          _ = ℓ := Real.rpow_one ℓ
      linarith
    have h0 : 0 ≤ (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ) := by
      positivity
    have hd := hdens m
    have hbound : ρ * ((primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ))
        ≤ κ := by
      calc ρ * ((primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ))
          ≤ ρ * (C_M * max 1 (Real.log m)) ^ Module.finrank ℚ K :=
            mul_le_mul_of_nonneg_left hd hρ.le
        _ ≤ ρ * (C_M * L) ^ Module.finrank ℚ K := by
            apply mul_le_mul_of_nonneg_left _ hρ.le
            apply pow_le_pow_left₀
              (mul_nonneg (by linarith) (le_trans zero_le_one (le_max_left _ _)))
            exact mul_le_mul_of_nonneg_left (hlogm.trans hℓL) (by linarith)
        _ = ρ * C_M ^ Module.finrank ℚ K * L ^ Module.finrank ℚ K := by rw [mul_pow]; ring
        _ ≤ κ := by
            rw [hκ, hKκ, add_mul, one_mul]
            linarith [pow_nonneg hLpos.le (Module.finrank ℚ K)]
    unfold cramerModel
    split_ifs
    · exact ⟨mul_nonneg hρ.le h0, hbound⟩
    · exact ⟨le_refl 0, hκ0⟩
  
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = K₀ * L ^ (Module.finrank ℚ K + 1) := ⟨_, rfl⟩
