    exact_mod_cast this
  
  have p_pigeon : ∀ (Γ : AddSubgroup (D → ℝ)) (Q : ℕ) (R : Finset (D → ℝ)), R.card ≤ Q →
      (∀ γ ∈ Γ, ∃ ρ ∈ R, ∃ m : D → ℤ, γ = ρ + fun x => (m x : ℝ)) →
      ∀ (d' : ℕ) (v : Fin d' → D → ℝ), LinearIndependent ℝ v → (∀ i, v i ∈ Γ) →
      ∀ (M : Fin d' → ℕ),
      ∃ W : Finset (D → ℤ),
        (∏ i, (2 * (M i : ℝ) + 1)) ≤ (Q : ℝ) * (W.card : ℝ) ∧
        ∀ ω ∈ W, ∃ ℓ : Fin d' → ℤ, (∀ i, |ℓ i| ≤ 2 * (M i : ℤ)) ∧
          ∀ x, (ω x : ℝ) = ∑ i, (ℓ i : ℝ) * v i x := by
    intro Γ Q R hRc hR d' v hv hvΓ M
    classical
    set Λ : Finset (Fin d' → ℤ) := Fintype.piFinset (fun i => Finset.Icc (-(M i : ℤ)) (M i))
      with hΛ
    have hΛcard' : Λ.card = ∏ i, (2 * M i + 1) := by
      rw [hΛ, Fintype.card_piFinset]
      refine Finset.prod_congr rfl fun i _ => ?_
      rw [Int.card_Icc]; omega
    have hΛcard : (Λ.card : ℝ) = ∏ i, (2 * (M i : ℝ) + 1) := by rw [hΛcard']; push_cast; ring
    have hΛpos : 0 < Λ.card := by rw [hΛcard']; exact Finset.prod_pos fun i _ => by omega
    have hp : ∀ ℓ : Fin d' → ℤ, (fun x => ∑ i, (ℓ i : ℝ) * v i x) ∈ Γ := by
      intro ℓ
      have : (fun x => ∑ i, (ℓ i : ℝ) * v i x) = ∑ i, (ℓ i) • v i := by
        funext x
        simp [Finset.sum_apply, zsmul_eq_mul]
      rw [this]
      exact AddSubgroup.sum_mem _ fun i _ => AddSubgroup.zsmul_mem _ (hvΓ i) _
    choose ρf hρR mf hmf using fun ℓ => hR _ (hp ℓ)
    have hRne : R.Nonempty := ⟨ρf 0, hρR 0⟩
    have hRpos : (0:ℝ) < R.card := by exact_mod_cast hRne.card_pos
    obtain ⟨ρ₀, hρ₀, hb⟩ := Finset.exists_le_card_fiber_of_nsmul_le_card_of_maps_to
      (s := Λ) (t := R) (f := ρf) (b := (Λ.card : ℝ) / R.card) (fun ℓ _ => hρR ℓ) hRne
      (by rw [nsmul_eq_mul]; field_simp; rfl)
    set F := Λ.filter (fun ℓ => ρf ℓ = ρ₀) with hF
    have hΛF : (Λ.card : ℝ) ≤ Q * F.card := by
      rw [div_le_iff₀ hRpos] at hb
      have h1 : (R.card : ℝ) ≤ Q := by exact_mod_cast hRc
      have h2 := mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg F.card : (0:ℝ) ≤ F.card)
      linarith
    have hFpos : 0 < F.card := by
      by_contra h
      have h0 : F.card = 0 := by omega
      have h0' : (F.card : ℝ) = 0 := by exact_mod_cast h0
      have : (0:ℝ) < Λ.card := by exact_mod_cast hΛpos
      rw [h0', mul_zero] at hΛF
      linarith
    obtain ⟨ℓ0, hℓ0⟩ := Finset.card_pos.1 hFpos
    let μ : (Fin d' → ℤ) → (D → ℤ) := fun ℓ => mf ℓ - mf ℓ0
    have hμ : ∀ ℓ ∈ F, ∀ x, (μ ℓ x : ℝ) = ∑ i, ((ℓ i - ℓ0 i : ℤ) : ℝ) * v i x := by
      intro ℓ hℓ x
      have h1 := congrFun (hmf ℓ) x
      have h2 := congrFun (hmf ℓ0) x
      have e1 : ρf ℓ = ρ₀ := (Finset.mem_filter.1 hℓ).2
      have e2 : ρf ℓ0 = ρ₀ := (Finset.mem_filter.1 hℓ0).2
      simp only [Pi.add_apply] at h1 h2
      rw [e1] at h1
      rw [e2] at h2
      simp only [μ, Pi.sub_apply]
      push_cast
      simp only [sub_mul, Finset.sum_sub_distrib]
      linarith
    have hinj : Set.InjOn μ F := by
      intro ℓ hℓ ℓ' hℓ' heq
      have hz : ∀ x, ∑ i, ((ℓ i - ℓ' i : ℤ) : ℝ) * v i x = 0 := by
        intro x
        have h1 := hμ ℓ hℓ x
        have h2 := hμ ℓ' hℓ' x
        have e : ∑ i, ((ℓ i - ℓ' i : ℤ) : ℝ) * v i x
            = ∑ i, ((ℓ i - ℓ0 i : ℤ) : ℝ) * v i x - ∑ i, ((ℓ' i - ℓ0 i : ℤ) : ℝ) * v i x := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          push_cast; ring
        rw [e, ← h1, ← h2]
        have heq' : μ ℓ = μ ℓ' := heq
        rw [heq', sub_self]
      have hg := Fintype.linearIndependent_iff.1 hv (fun i => ((ℓ i - ℓ' i : ℤ) : ℝ)) (by
        funext x
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
        exact hz x)
      funext i
      have h3 : ((ℓ i - ℓ' i : ℤ) : ℝ) = 0 := hg i
      have h4 : ℓ i - ℓ' i = 0 := by exact_mod_cast h3
      omega
    refine ⟨F.image μ, ?_, ?_⟩
    · rw [Finset.card_image_of_injOn hinj, ← hΛcard]; exact hΛF
    · intro ω hω
      obtain ⟨ℓ, hℓ, rfl⟩ := Finset.mem_image.1 hω
      refine ⟨fun i => ℓ i - ℓ0 i, fun i => ?_, hμ ℓ hℓ⟩
      have h1 := Fintype.mem_piFinset.1 (Finset.mem_filter.1 hℓ).1 i
      have h2 := Fintype.mem_piFinset.1 (Finset.mem_filter.1 hℓ0).1 i
      rw [Finset.mem_Icc] at h1 h2
      show |ℓ i - ℓ0 i| ≤ 2 * (M i : ℤ)
      rw [abs_le]; constructor <;> omega
  
  have p_rank : ∀ (N k : ℕ) (W : Finset (D → ℤ)), (∀ ω ∈ W, ∀ x, |(ω x : ℝ)| ≤ (N : ℝ)) →
      Module.finrank ℝ (Submodule.span ℝ
        ((fun ω : D → ℤ => fun x => (ω x : ℝ)) '' (W : Set (D → ℤ)))) ≤ k →
      W.card ≤ (2 * N + 1) ^ k := by
    intro N k W hW hk
    classical
    set U := Submodule.span ℝ ((fun ω : D → ℤ => fun x => (ω x : ℝ)) '' (W : Set (D → ℤ)))
      with hU
    let f : D → Module.Dual ℝ U := fun x => (LinearMap.proj x).comp U.subtype
    have hf : ∀ x (u : U), f x u = (u : D → ℝ) x := fun x u => rfl
    obtain ⟨ι, b, hb, hspan, hli⟩ := exists_linearIndependent' ℝ f
    haveI : Finite ι := Finite.of_injective b hb
    letI : Fintype ι := Fintype.ofFinite ι
    have hι : Fintype.card ι ≤ k := by
      have h1 := hli.fintype_card_le_finrank
      rw [Subspace.dual_finrank_eq] at h1
      exact h1.trans hk
    have hvan : ∀ u : U, (∀ c, (u : D → ℝ) (b c) = 0) → u = 0 := by
      intro u hu
      have hle : Submodule.span ℝ (Set.range (f ∘ b))
          ≤ LinearMap.ker (Module.Dual.eval ℝ U u) := by
        rw [Submodule.span_le]
        rintro _ ⟨c, rfl⟩
        simp only [SetLike.mem_coe, LinearMap.mem_ker, Module.Dual.eval_apply,
          Function.comp_apply]
        exact hu c
      rw [hspan] at hle
      apply Subtype.ext
      funext x
      have := hle (Submodule.subset_span (Set.mem_range_self x))
      simp only [LinearMap.mem_ker, Module.Dual.eval_apply] at this
      simpa [hf] using this
    let g : (D → ℤ) → (ι → ℤ) := fun ω c => ω (b c)
    have hmem : ∀ ω ∈ W, (fun x => (ω x : ℝ)) ∈ U := fun ω hω =>
      Submodule.subset_span ⟨ω, hω, rfl⟩
    have hinj : Set.InjOn g W := by
      intro ω hω ω' hω' heq
      have h0 := hvan ⟨_, U.sub_mem (hmem ω hω) (hmem ω' hω')⟩ (by
        intro c
        have := congrFun heq c
        simp only [g] at this
        simp [this])
      funext x
      have h5 : (ω x : ℝ) - (ω' x : ℝ) = 0 := by
        simpa using congrFun (congrArg Subtype.val h0) x
      exact_mod_cast sub_eq_zero.1 h5
    have hmaps : Set.MapsTo g W (Fintype.piFinset (fun _ : ι => Finset.Icc (-(N:ℤ)) N)) := by
      intro ω hω
      rw [Finset.mem_coe, Fintype.mem_piFinset]
      intro c
      have h := hW ω hω (b c)
      have h' : |ω (b c)| ≤ (N:ℤ) := by
        have : ((|ω (b c)| : ℤ) : ℝ) ≤ ((N:ℤ):ℝ) := by push_cast; exact h
        exact_mod_cast this
      rw [Finset.mem_Icc]
      exact abs_le.1 h'
    have h1 := Finset.card_le_card_of_injOn g hmaps hinj
    rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Int.card_Icc] at h1
    have : ((N:ℤ) + 1 - -(N:ℤ)).toNat = 2 * N + 1 := by omega
    rw [this] at h1
    exact h1.trans (Nat.pow_le_pow_right (by omega) hι)
  
  have p_extract : ∀ (d' : ℕ) (v : Fin d' → D → ℝ), LinearIndependent ℝ v →
      ∀ (W : Finset (D → ℤ)),
      (∀ ω ∈ W, (fun x => (ω x : ℝ)) ∈ Submodule.span ℝ (Set.range v)) →
      d' ≤ Module.finrank ℝ (Submodule.span ℝ
        ((fun ω : D → ℤ => fun x => (ω x : ℝ)) '' (W : Set (D → ℤ)))) →
      ∃ w : Fin d' → D → ℤ, (∀ i, w i ∈ W) ∧
        LinearIndependent ℝ (fun i x => (w i x : ℝ)) ∧
        (∀ u : D → ℝ, (∀ i, ∑ x, (w i x : ℝ) * u x = 0) → ∀ k, ∑ x, v k x * u x = 0) := by
    intro d' v hv W hWv hrank
    classical
    set U := Submodule.span ℝ ((fun ω : D → ℤ => fun x => (ω x : ℝ)) '' (W : Set (D → ℤ)))
      with hU
    set V := Submodule.span ℝ (Set.range v) with hV
    have hUV : U ≤ V := by
      rw [hU, Submodule.span_le]
      rintro _ ⟨ω, hω, rfl⟩
      exact hWv ω hω
    have hVr : Module.finrank ℝ V = d' := by rw [hV, finrank_span_eq_card hv, Fintype.card_fin]
    have hUr : Module.finrank ℝ U = d' :=
      le_antisymm (by have := Submodule.finrank_mono hUV; omega) hrank
    have hUeq : U = V := Submodule.eq_of_le_of_finrank_eq hUV (hUr.trans hVr.symm)
    let c : W → (D → ℝ) := fun ω x => ((ω.1 x : ℤ) : ℝ)
    have hrange : Set.range c
        = (fun ω : D → ℤ => fun x => (ω x : ℝ)) '' (W : Set (D → ℤ)) := by
      ext y; constructor
      · rintro ⟨ω, rfl⟩; exact ⟨ω.1, ω.2, rfl⟩
      · rintro ⟨ω, hω, rfl⟩; exact ⟨⟨ω, hω⟩, rfl⟩
    obtain ⟨ι, b, hb, hspan, hli⟩ := exists_linearIndependent' ℝ c
    haveI : Finite ι := Finite.of_injective b hb
    letI : Fintype ι := Fintype.ofFinite ι
    have hcardι : Fintype.card ι = d' := by
      have := finrank_span_eq_card hli
      rw [hspan, hrange, ← hU, hUr] at this
      exact this.symm
    let e : Fin d' ≃ ι := (Fintype.equivFinOfCardEq hcardι).symm
    refine ⟨fun i => (b (e i)).1, fun i => (b (e i)).2, ?_, ?_⟩
    · have : (fun i x => (((b (e i)).1 x : ℤ) : ℝ)) = (c ∘ b) ∘ e := rfl
      rw [this]
      exact hli.comp e e.injective
    · intro u hu k
      let S : Submodule ℝ (D → ℝ) :=
        { carrier := {y | ∑ x, y x * u x = 0}
          add_mem' := by
            intro y z hy hz
            simp only [Set.mem_setOf_eq, Pi.add_apply, add_mul, Finset.sum_add_distrib] at *
            rw [hy, hz, add_zero]
          zero_mem' := by simp
          smul_mem' := by
            intro t y hy
            simp only [Set.mem_setOf_eq, Pi.smul_apply, smul_eq_mul, mul_assoc] at *
            rw [← Finset.mul_sum, hy, mul_zero] }
      have hle : Submodule.span ℝ (Set.range (c ∘ b)) ≤ S := by
        rw [Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        have := hu (e.symm j)
        simp only [Equiv.apply_symm_apply] at this
        exact this
      rw [hspan, hrange, ← hU, hUeq] at hle
      exact hle (Submodule.subset_span (Set.mem_range_self k))
  
  classical
  set N : ℕ := ⌈(5 : ℝ) ^ d / τ⌉₊ with hNdef
  have hN : (5 : ℝ) ^ d / τ ≤ (N : ℝ) := Nat.le_ceil _
  have hdd : d' ≤ d := by
    have := hv.fintype_card_le_finrank
    rwa [Fintype.card_fin, Module.finrank_fintype_fun_eq_card, hd] at this
  have hQ : 1 ≤ Q := by
    obtain ⟨ρ, hρ, -⟩ := hR 0 Γ.zero_mem
    exact (Finset.card_pos.2 ⟨ρ, hρ⟩).trans_le hRc
  obtain ⟨W, hWc, hWℓ⟩ := p_pigeon Γ Q R hRc hR d' v hv hvΓ (fun i => N * L i)
  have hbounds : ∀ ω ∈ W, (∀ x, |(ω x : ℝ)| ≤ (N : ℝ)) ∧
      (∀ j, |∑ x, (ω x : ℝ) * a j x| ≤ 2 * (N : ℝ) * κ) ∧
      (fun x => (ω x : ℝ)) ∈ Submodule.span ℝ (Set.range v) := by
    intro ω hω
    obtain ⟨ℓ, hℓb, hℓe⟩ := hWℓ ω hω
    have ht : ∀ i, |(ℓ i : ℝ)| ≤ (2 * (N : ℝ)) * (L i : ℝ) := by
      intro i
      have h : |ℓ i| ≤ 2 * ((N * L i : ℕ) : ℤ) := hℓb i
      have h' : ((|ℓ i| : ℤ) : ℝ) ≤ ((2 * ((N * L i : ℕ) : ℤ) : ℤ) : ℝ) := by exact_mod_cast h
      push_cast at h'
      linarith
    obtain ⟨hE, hA⟩ := p_corner r d' a κ v L hP (2 * (N : ℝ)) (by positivity)
      (fun i => (ℓ i : ℝ)) ht
    refine ⟨fun x => ?_, fun j => ?_, ?_⟩
    · rw [hℓe x]
      have := hE x
      linarith
    · have e : ∑ x, (ω x : ℝ) * a j x = ∑ x, a j x * ∑ i, (ℓ i : ℝ) * v i x :=
        Finset.sum_congr rfl fun x _ => by rw [hℓe x, mul_comm]
      rw [e]
      exact hA j
    · have e : (fun x => (ω x : ℝ)) = ∑ i, (ℓ i : ℝ) • v i := by
        funext x
        rw [hℓe x]
        simp [Finset.sum_apply]
      rw [e]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self i))
  have hrank : d' ≤ Module.finrank ℝ (Submodule.span ℝ
      ((fun ω : D → ℤ => fun x => (ω x : ℝ)) '' (W : Set (D → ℤ)))) := by
    by_contra hlt
    push_neg at hlt
    have hk : Module.finrank ℝ (Submodule.span ℝ
        ((fun ω : D → ℤ => fun x => (ω x : ℝ)) '' (W : Set (D → ℤ)))) ≤ d' - 1 := by omega
    have h1 := p_rank N (d' - 1) W (fun ω hω => (hbounds ω hω).1) hk
    have hc : ∏ i, (2 * ((N : ℝ) * (L i : ℝ)) + 1) ≤ (Q : ℝ) * (W.card : ℝ) := by
      have := hWc
      push_cast at this
      exact this
    have h2 := p_arith d d' N Q W.card τ L hL hτ0 (by omega) hdd hN hQ hcard hc
    omega
  obtain ⟨w, hwW, hwli, hworth⟩ := p_extract d' v hv W
    (fun ω hω => (hbounds ω hω).2.2) hrank
  exact ⟨w, hwli, fun i x => (hbounds _ (hwW i)).1 x, fun i j => (hbounds _ (hwW i)).2.1 j,
    hworth⟩

theorem kai_vb_cramer_complement (D : Type) [Fintype D] [DecidableEq D] (d : ℕ)
    (hd : Fintype.card D = d) (L : ℝ) (hL : 1 ≤ L) (s : ℕ) (w : Fin s → D → ℤ)
    (hw : LinearIndependent ℝ (fun i x => (w i x : ℝ))) (hwb : ∀ i x, |(w i x : ℝ)| ≤ L) :
    ∃ u : Fin (d - s) → D → ℤ,
      LinearIndependent ℝ (fun l x => (u l x : ℝ)) ∧
      (∀ i l, ∑ x, w i x * u l x = 0) ∧
      (∀ l x, |(u l x : ℝ)| ≤ (Nat.factorial (d - 1) : ℝ) * L ^ (d - 1)) :=
by
  classical
  
  have hminor : ∃ φ : Fin s → D, Function.Injective φ ∧
      (Matrix.of fun i j : Fin s => w i (φ j)).det ≠ 0 := by
    let M : Matrix (Fin s) D ℝ := Matrix.of fun i x => (w i x : ℝ)
    have hrow : M.rank = s := by
      rw [Matrix.rank_eq_finrank_span_row]
      have : M.row = fun i x => (w i x : ℝ) := rfl
      rw [this, finrank_span_eq_card hw, Fintype.card_fin]
    have htop : Submodule.span ℝ (Set.range M.col) = ⊤ := by
      apply Submodule.eq_top_of_finrank_eq
      rw [← Matrix.rank_eq_finrank_span_cols, hrow, Module.finrank_fin_fun]
    obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' ℝ M.col
    haveI : Finite κ := Finite.of_injective a ha
    letI : Fintype κ := Fintype.ofFinite κ
    have hcard : Fintype.card κ = s := by
      have h1 := finrank_span_eq_card hli
      rw [hspan, htop, finrank_top, Module.finrank_fin_fun] at h1
      exact h1.symm
    let e := Fintype.equivFinOfCardEq hcard
    refine ⟨a ∘ e.symm, ha.comp e.symm.injective, ?_⟩
    have hB : LinearIndependent ℝ
        ((Matrix.of fun i j : Fin s => w i ((a ∘ e.symm) j)).map (fun x : ℤ => (x : ℝ))).col := by
      have h2 := hli.comp e.symm e.symm.injective
      have h3 : ((Matrix.of fun i j : Fin s => w i ((a ∘ e.symm) j)).map
          (fun x : ℤ => (x : ℝ))).col = (M.col ∘ a) ∘ e.symm := by
        ext j i
        rfl
      rw [h3]
      exact h2
    have hu := Matrix.linearIndependent_cols_iff_isUnit.mp hB
    rw [Matrix.isUnit_iff_isUnit_det] at hu
    have h0 := hu.ne_zero
    rw [← Int.cast_det] at h0
    exact_mod_cast h0
  obtain ⟨φ, hφ, hdet⟩ := hminor
  set A : Matrix (Fin s) (Fin s) ℤ := Matrix.of fun i j : Fin s => w i (φ j) with hA
  
  have hdetbd : ∀ N : Matrix (Fin s) (Fin s) ℤ, (∀ i j, ∃ x, N i j = w i x) →
      |(N.det : ℝ)| ≤ (Nat.factorial s : ℝ) * L ^ s := by
    intro N hN
    rw [Int.cast_det]
    have h := Matrix.det_le (A := N.map (fun x : ℤ => (x : ℝ))) (abv := AbsoluteValue.abs)
      (x := L) (fun i j => by
        obtain ⟨x, hx⟩ := hN i j
        simp only [Matrix.map_apply, AbsoluteValue.abs_apply, hx]
        exact hwb i x)
    simpa [Fintype.card_fin, nsmul_eq_mul] using h
  have hL0 : (0 : ℝ) ≤ (Nat.factorial s : ℝ) * L ^ s :=
    mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (by linarith) _)
  
  have hvec : ∀ k : D, (∀ j, φ j ≠ k) → ∃ u : D → ℤ,
      (∀ i, ∑ x, w i x * u x = 0) ∧
      u k = A.det ∧
      (∀ x, (∀ j, φ j ≠ x) → x ≠ k → u x = 0) ∧
      (∀ x, |(u x : ℝ)| ≤ (Nat.factorial s : ℝ) * L ^ s) := by
    intro k hk
    let b : Fin s → ℤ := fun i => w i k
    let c : Fin s → ℤ := A.cramer b
    refine ⟨fun x => (if x = k then A.det else 0) - ∑ j, c j * (if x = φ j then 1 else 0),
      ?_, ?_, ?_, ?_⟩
    · intro i
      have hmv : A.mulVec c = A.det • b := Matrix.mulVec_cramer A b
      have hi := congrFun hmv i
      simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul, hA,
        Matrix.of_apply] at hi
      have e1 : ∑ x, w i x * (if x = k then A.det else 0) = w i k * A.det := by
        simp [mul_ite, Finset.sum_ite_eq']
      have e2 : ∑ x, w i x * ∑ j, c j * (if x = φ j then 1 else 0)
          = ∑ j, w i (φ j) * c j := by
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp [mul_ite, Finset.sum_ite_eq', mul_comm]
      simp only [mul_sub, Finset.sum_sub_distrib]
      rw [e1, e2, hi]
      simp only [b]
      ring
    · have : ∀ j, ¬ (k = φ j) := fun j h => hk j h.symm
      simp [this]
    · intro x hx hxk
      have : ∀ j, ¬ (x = φ j) := fun j h => hx j h.symm
      simp [this, hxk]
    · intro x
      by_cases hxk : x = k
      · subst hxk
        have : ∀ j, ¬ (x = φ j) := fun j h => hk j h.symm
        simp only [this, if_true, if_false, mul_zero, Finset.sum_const_zero, sub_zero]
        exact hdetbd A (fun i j => ⟨φ j, rfl⟩)
      · by_cases hx : ∃ j₀, φ j₀ = x
        · obtain ⟨j₀, rfl⟩ := hx
          have hsum : ∑ j, c j * (if φ j₀ = φ j then (1 : ℤ) else 0) = c j₀ := by
            simp [hφ.eq_iff, mul_ite, Finset.sum_ite_eq]
          simp only [hxk, if_false, hsum, zero_sub, Int.cast_neg, abs_neg]
          have hc : c j₀ = (A.updateCol j₀ b).det := Matrix.cramer_apply A b j₀
          rw [hc]
          apply hdetbd
          intro i j
          rw [Matrix.updateCol_apply]
          split_ifs
          · exact ⟨k, rfl⟩
          · exact ⟨φ j, rfl⟩
        · push_neg at hx
          have : ∀ j, ¬ (x = φ j) := fun j h => hx j h.symm
          simp only [this, hxk, if_false, mul_zero, Finset.sum_const_zero, sub_zero,
            Int.cast_zero, abs_zero]
          exact hL0
  
  set J : Finset D := Finset.univ.image φ with hJdef
  have hJ : J.card = s := by
    rw [hJdef, Finset.card_image_of_injective _ hφ, Finset.card_univ, Fintype.card_fin]
  have hC : Fintype.card {x : D // x ∈ Jᶜ} = d - s := by
    rw [Fintype.card_coe, Finset.card_compl, hd, hJ]
  let e := Fintype.equivFinOfCardEq hC
  let κ : Fin (d - s) → D := fun l => ((e.symm l : {x : D // x ∈ Jᶜ}) : D)
  have hκinj : Function.Injective κ := Subtype.val_injective.comp e.symm.injective
  have hκfree : ∀ l j, φ j ≠ κ l := by
    intro l j h
    have hm := (e.symm l).2
    rw [Finset.mem_compl] at hm
    apply hm
    show κ l ∈ J
    rw [← h, hJdef]
    exact Finset.mem_image_of_mem φ (Finset.mem_univ j)
  choose u hu1 hu2 hu3 hu4 using fun l => hvec (κ l) (hκfree l)
  have hdiag : ∀ l l', u l (κ l') = if l = l' then A.det else 0 := by
    intro l l'
    split_ifs with h
    · subst h; exact hu2 l
    · exact hu3 l (κ l') (hκfree l') (fun h' => h (hκinj h').symm)
  refine ⟨u, ?_, fun i l => hu1 l i, ?_⟩
  · rw [Fintype.linearIndependent_iff]
    intro g hg l'
    have h := congrFun hg (κ l')
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, hdiag] at h
    simp only [apply_ite (Int.cast : ℤ → ℝ), Int.cast_zero, mul_ite, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, if_true] at h
    have hd0 : (A.det : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hdet
    exact (mul_eq_zero.mp h).resolve_right hd0
  · intro l x
    have hsd : s ≤ d - 1 := by
      have := l.isLt
      omega
    refine (hu4 l x).trans ?_
    exact mul_le_mul (by exact_mod_cast Nat.factorial_le hsd) (pow_le_pow_right₀ hL hsd)
      (pow_nonneg (by linarith) _) (Nat.cast_nonneg _)

theorem kai_vb_dual_scaling (D : Type) [Fintype D] [DecidableEq D] (d : ℕ)
    (hd : Fintype.card D = d)
    (Γ : AddSubgroup (D → ℝ)) (R : Finset (D → ℝ))
    (hR : ∀ γ ∈ Γ, ∃ ρ ∈ R, ∃ m : D → ℤ, γ = ρ + fun x => (m x : ℝ))
    (d' : ℕ) (v : Fin d' → D → ℝ) (L : Fin d' → ℕ)
    (hv : LinearIndependent ℝ v) (hvΓ : ∀ i, v i ∈ Γ)
    (hcube : ∀ ℓ : Fin d' → ℤ, (∀ i, |ℓ i| ≤ (L i : ℤ)) →
      ∀ x, |∑ i, (ℓ i : ℝ) * v i x| ≤ 1 / 2)
    (e : D → ℤ) (he : ∀ i, ∑ x, v i x * (e x : ℝ) = 0) :
    ∃ m : ℕ, 1 ≤ m ∧
      (m : ℝ) * ∏ i, (2 * (L i : ℝ) + 1) ≤ 3 ^ d * (R.card : ℝ) ∧
      ∀ γ ∈ Γ, ∃ z : ℤ, ∑ x, (((m : ℤ) * e x : ℤ) : ℝ) * γ x = z :=
by
  classical
  
  obtain ⟨f, hf⟩ : ∃ f : (D → ℝ) → ℝ, ∀ γ, f γ = ∑ x, (e x : ℝ) * γ x := ⟨_, fun _ => rfl⟩
  have hfadd : ∀ u w : D → ℝ, f (u + w) = f u + f w := by
    intro u w; simp only [hf, Pi.add_apply, mul_add, Finset.sum_add_distrib]
  have hfsub : ∀ u w : D → ℝ, f (u - w) = f u - f w := by
    intro u w; simp only [hf, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
  have hfint : ∀ n : D → ℤ, f (fun x => (n x : ℝ)) = ((∑ x, e x * n x : ℤ) : ℝ) := by
    intro n; rw [hf]; push_cast; rfl
  have hf0 : f 0 = 0 := by simp [hf]
  
  obtain ⟨A, hA⟩ : ∃ A : Finset ℝ, ∀ a : ℝ, a ∈ A ↔ ∃ γ ∈ Γ, Int.fract (f γ) = a := by
    refine ⟨(R.image (fun ρ => Int.fract (f ρ))).filter
      (fun a => ∃ γ ∈ Γ, Int.fract (f γ) = a), ?_⟩
    intro a
    simp only [Finset.mem_filter, Finset.mem_image]
    constructor
    · exact fun h => h.2
    · rintro ⟨γ, hγ, rfl⟩
      refine ⟨?_, γ, hγ, rfl⟩
      obtain ⟨ρ, hρ, n, rfl⟩ := hR γ hγ
      refine ⟨ρ, hρ, ?_⟩
      rw [Int.fract_eq_fract, hfadd, hfint]
      exact ⟨-(∑ x, e x * n x), by push_cast; ring⟩
  
  have hrange : ∀ a ∈ A, 0 ≤ a ∧ a < 1 := by
    intro a ha
    obtain ⟨γ', _, rfl⟩ := (hA a).1 ha
    exact ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
  have hlag : ∀ γ ∈ Γ, ∃ z : ℤ, (A.card : ℝ) * f γ = z := by
    intro γ hγ
    have hmaps : ∀ a ∈ A, Int.fract (a + f γ) ∈ A := by
      intro a ha
      obtain ⟨γ', hγ', rfl⟩ := (hA a).1 ha
      refine (hA _).2 ⟨γ' + γ, add_mem hγ' hγ, ?_⟩
      rw [Int.fract_eq_fract, hfadd]
      refine ⟨⌊f γ'⌋, ?_⟩
      have := Int.floor_add_fract (f γ')
      linarith
    have hinj : Set.InjOn (fun a => Int.fract (a + f γ)) A := by
      intro a ha a' ha' h
      obtain ⟨z, hz⟩ := Int.fract_eq_fract.1 h
      have h1 := hrange a ha
      have h2 := hrange a' ha'
      have hz1 : (z : ℝ) < 1 := by linarith
      have hz2 : (-1 : ℝ) < z := by linarith
      have hz1' : z < 1 := by exact_mod_cast hz1
      have hz2' : -1 < z := by exact_mod_cast hz2
      have hz0 : z = 0 := by omega
      rw [hz0] at hz
      simp only [Int.cast_zero] at hz
      linarith
    have himg : A.image (fun a => Int.fract (a + f γ)) = A := by
      apply Finset.eq_of_subset_of_card_le
      · intro b hb
        obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hb
        exact hmaps a ha
      · rw [Finset.card_image_of_injOn hinj]
    have hsum : ∑ a ∈ A, a = ∑ a ∈ A, Int.fract (a + f γ) := by
      conv_lhs => rw [← himg]
      rw [Finset.sum_image hinj]
    refine ⟨∑ a ∈ A, ⌊a + f γ⌋, ?_⟩
    push_cast
    have hfr : ∀ a ∈ A, Int.fract (a + f γ) = a + f γ - ⌊a + f γ⌋ := fun a _ => rfl
    rw [Finset.sum_congr rfl hfr, Finset.sum_sub_distrib, Finset.sum_add_distrib,
      Finset.sum_const, nsmul_eq_mul] at hsum
    linarith
  
  have hA0 : (0 : ℝ) ∈ A := (hA 0).2 ⟨0, Γ.zero_mem, by rw [hf0, Int.fract_zero]⟩
  refine ⟨A.card, Finset.card_pos.2 ⟨0, hA0⟩, ?_, ?_⟩
  swap
  · intro γ hγ
    obtain ⟨z, hz⟩ := hlag γ hγ
    refine ⟨z, ?_⟩
    rw [← hz, hf, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    push_cast
    ring
  
  obtain ⟨p, hp⟩ : ∃ p : (Fin d' → ℤ) → D → ℝ, ∀ ℓ x, p ℓ x = ∑ i, (ℓ i : ℝ) * v i x :=
    ⟨fun ℓ x => ∑ i, (ℓ i : ℝ) * v i x, fun _ _ => rfl⟩
  have hpΓ : ∀ ℓ, p ℓ ∈ Γ := by
    intro ℓ
    have : p ℓ = ∑ i, ℓ i • v i := by
      funext x
      rw [hp, Finset.sum_apply]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Pi.smul_apply, zsmul_eq_mul]
    rw [this]
    exact Γ.sum_mem (fun i _ => Γ.zsmul_mem (hvΓ i) (ℓ i))
  have hfp : ∀ ℓ, f (p ℓ) = 0 := by
    intro ℓ
    rw [hf]
    simp_rw [hp, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_eq_zero
    intro i _
    calc ∑ x, (e x : ℝ) * ((ℓ i : ℝ) * v i x) = (ℓ i : ℝ) * ∑ x, v i x * (e x : ℝ) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun x _ => ?_)
          ring
      _ = 0 := by rw [he i, mul_zero]
  have hw : ∀ a ∈ A, ∃ γ ∈ Γ, Int.fract (f γ) = a := fun a ha => (hA a).1 ha
  choose! g hgΓ hgf using hw
  obtain ⟨F, hF⟩ : ∃ F : ℝ × (Fin d' → ℤ) → D → ℝ, ∀ q, F q = g q.1 + p q.2 :=
    ⟨fun q => g q.1 + p q.2, fun _ => rfl⟩
  set Box := Fintype.piFinset (fun i : Fin d' => Finset.Icc (-(L i : ℤ)) (L i)) with hBox
  set I := A ×ˢ Box with hI
  have hmemI : ∀ q ∈ I, q.1 ∈ A ∧ ∀ i, |q.2 i| ≤ (L i : ℤ) := by
    intro q hq
    rw [hI, Finset.mem_product] at hq
    refine ⟨hq.1, fun i => ?_⟩
    have := (Fintype.mem_piFinset.1 hq.2) i
    rw [Finset.mem_Icc] at this
    exact abs_le.2 this
  have hfF : ∀ q, f (F q) = f (g q.1) := by
    intro q; rw [hF, hfadd, hfp, add_zero]
  have hK : ∀ q ∈ I, ∀ q' ∈ I, ∀ z : ℤ, f (F q) - f (F q') = z → q.1 = q'.1 := by
    intro q hq q' hq' z hz
    rw [hfF, hfF] at hz
    rw [← hgf q.1 (hmemI q hq).1, ← hgf q'.1 (hmemI q' hq').1]
    exact Int.fract_eq_fract.2 ⟨z, hz⟩
  have hdiff : ∀ q ∈ I, ∀ q' ∈ I, q.1 = q'.1 → F q - F q' = p q.2 - p q'.2 := by
    intro q _ q' _ h
    rw [hF, hF, h]
    abel
  
  have hcov : ∀ q ∈ I, ∃ ρ ∈ R, ∃ n : D → ℤ, F q = ρ + fun x => (n x : ℝ) := by
    intro q hq
    apply hR
    rw [hF]
    exact add_mem (hgΓ q.1 (hmemI q hq).1) (hpΓ q.2)
  have hsep : ∀ q ∈ I, ∀ q' ∈ I, ∀ n : D → ℤ, F q - F q' = (fun x => (n x : ℝ)) →
      ∀ x, |n x| ≤ 1 := by
    intro q hq q' hq' n hn x
    have h1 : q.1 = q'.1 := by
      refine hK q hq q' hq' (∑ x, e x * n x) ?_
      rw [← hfsub, hn, hfint]
    rw [hdiff q hq q' hq' h1] at hn
    have h2 := congrFun hn x
    simp only [Pi.sub_apply] at h2
    have h3 := hcube q.2 (hmemI q hq).2 x
    have h4 := hcube q'.2 (hmemI q' hq').2 x
    rw [← hp] at h3 h4
    have h5 : |(n x : ℝ)| ≤ 1 := by
      rw [← h2]
      rw [abs_le] at h3 h4 ⊢
      constructor <;> linarith
    exact_mod_cast h5
  have hinjF : Set.InjOn F I := by
    intro q hq q' hq' h
    have h1 : q.1 = q'.1 := by
      refine hK q hq q' hq' 0 ?_
      rw [h, sub_self, Int.cast_zero]
    have h2 : p q.2 = p q'.2 := by
      have := hdiff q hq q' hq' h1
      rw [h, sub_self] at this
      exact (sub_eq_zero.1 this.symm)
    have h0 : ∑ i, ((q.2 i : ℝ) - q'.2 i) • v i = 0 := by
      funext x
      have := congrFun h2 x
      rw [hp, hp] at this
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, sub_mul, Finset.sum_sub_distrib,
        Pi.zero_apply]
      linarith
    have h3 : q.2 = q'.2 := by
      funext i
      have := Fintype.linearIndependent_iff.1 hv _ h0 i
      exact_mod_cast sub_eq_zero.1 this
    exact Prod.ext h1 h3
  have hcount : I.card ≤ 3 ^ d * R.card := by
    choose! ρf hρf nf hnf using hcov
    apply Finset.card_le_mul_card_image_of_maps_to hρf
    intro b _
    rcases (I.filter (fun q => ρf q = b)).eq_empty_or_nonempty with h | ⟨q₀, hq₀⟩
    · rw [h, Finset.card_empty]; exact Nat.zero_le _
    · have hq₀' := Finset.mem_filter.1 hq₀
      have hcard : (Fintype.piFinset (fun _ : D => Finset.Icc (-1 : ℤ) 1)).card = 3 ^ d := by
        rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, hd, Int.card_Icc]
        rfl
      rw [← hcard]
      apply Finset.card_le_card_of_injOn (fun q => nf q - nf q₀)
      · intro q hq
        have hq' := Finset.mem_filter.1 hq
        rw [Finset.mem_coe, Fintype.mem_piFinset]
        intro x
        rw [Finset.mem_Icc, ← abs_le]
        refine hsep q hq'.1 q₀ hq₀'.1 _ ?_ x
        rw [hnf q hq'.1, hnf q₀ hq₀'.1, hq'.2, hq₀'.2]
        funext y
        simp only [Pi.sub_apply, Pi.add_apply, Int.cast_sub]
        ring
      · intro q hq q' hq' h
        have hq1 := Finset.mem_filter.1 hq
        have hq2 := Finset.mem_filter.1 hq'
        apply hinjF hq1.1 hq2.1
        have h' : nf q = nf q' := sub_left_injective h
        rw [hnf q hq1.1, hnf q' hq2.1, hq1.2, hq2.2, h']
  have hboxcard : (Box.card : ℝ) = ∏ i, (2 * (L i : ℝ) + 1) := by
    rw [hBox, Fintype.card_piFinset]
    push_cast
    refine Finset.prod_congr rfl (fun i _ => ?_)
    rw [Int.card_Icc]
    have : ((L i : ℤ) + 1 - -(L i : ℤ)) = ((2 * L i + 1 : ℕ) : ℤ) := by push_cast; ring
    rw [this, Int.toNat_natCast]
    push_cast
    ring
  have hIcard : I.card = A.card * Box.card := by rw [hI, Finset.card_product]
  rw [← hboxcard]
  have : ((I.card : ℕ) : ℝ) ≤ ((3 ^ d * R.card : ℕ) : ℝ) := by exact_mod_cast hcount
  rw [hIcard] at this
  push_cast at this
  exact this

theorem kai_vb_core_constants (d : ℕ) (hd : 1 ≤ d) (τ : ℝ) (hτ0 : 0 < τ) (hτ1 : τ ≤ 1) :
    2 * (⌈(5 : ℝ) ^ d / τ⌉₊ : ℝ) ≤ vbT d τ ∧
    (3 : ℝ) ^ d / τ * ((Nat.factorial (d - 1) : ℝ) * (⌈(5 : ℝ) ^ d / τ⌉₊ : ℝ) ^ (d - 1))
      ≤ vbT d τ :=
by
  obtain ⟨k, rfl⟩ : ∃ k, d = k + 1 := ⟨d - 1, by omega⟩
  have hk : k + 1 - 1 = k := by omega
  rw [hk]
  unfold vbT
  have hX0 : 0 < τ⁻¹ := inv_pos.mpr hτ0
  have hX1 : 1 ≤ τ⁻¹ := (one_le_inv₀ hτ0).mpr hτ1
  rw [div_eq_mul_inv, div_eq_mul_inv, div_eq_mul_inv]
  generalize τ⁻¹ = X at hX0 hX1 ⊢
  have hc1 : (1 : ℝ) ≤ (5 : ℝ) ^ (k + 1) := one_le_pow₀ (by norm_num)
  have hb1 : (1 : ℝ) ≤ (12 : ℝ) ^ (k + 1) := one_le_pow₀ (by norm_num)
  have hcb : (5 : ℝ) ^ (k + 1) ≤ (12 : ℝ) ^ (k + 1) :=
    pow_le_pow_left₀ (by norm_num) (by norm_num) _
  have h12b : (12 : ℝ) ≤ (12 : ℝ) ^ (k + 1) :=
    le_self_pow₀ (by norm_num) (Nat.succ_ne_zero k)
  have h6 : (3 : ℝ) ^ (k + 1) * 2 ^ k ≤ (12 : ℝ) ^ (k + 1) := by
    calc (3 : ℝ) ^ (k + 1) * 2 ^ k ≤ (3 : ℝ) ^ (k + 1) * 2 ^ (k + 1) :=
          mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (by norm_num) (Nat.le_succ k))
            (by positivity)
      _ = (6 : ℝ) ^ (k + 1) := by rw [← mul_pow]; norm_num
      _ ≤ (12 : ℝ) ^ (k + 1) := pow_le_pow_left₀ (by norm_num) (by norm_num) _
  generalize hcdef : (5 : ℝ) ^ (k + 1) = c at hc1 hcb ⊢
  generalize hbdef : (12 : ℝ) ^ (k + 1) = b at hb1 hcb h12b h6 ⊢
  have hbb3 : b ≤ b ^ 3 := le_self_pow₀ hb1 (by norm_num)
  have hcX1 : 1 ≤ c * X := one_le_mul_of_one_le_of_one_le hc1 hX1
  have hbX1 : 1 ≤ b * X := one_le_mul_of_one_le_of_one_le hb1 hX1
  have hNlt : (⌈c * X⌉₊ : ℝ) < c * X + 1 := Nat.ceil_lt_add_one (by linarith)
  generalize hNdef : ⌈c * X⌉₊ = N at hNlt ⊢
  have hNle : (N : ℝ) ≤ 2 * (c * X) := by linarith
  have hN0 : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg _
  have hfact1 : (1 : ℝ) ≤ (Nat.factorial (k + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_pos _
  have hfk : (Nat.factorial k : ℝ) ≤ (Nat.factorial (k + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_le (Nat.le_succ k)
  constructor
  · have h1 : 12 * (c * X) ≤ (b * X) * (b * X) := by
      have h12c : 12 * c ≤ b * b := mul_le_mul h12b hcb (by linarith) (by linarith)
      have hbXb : b ≤ b * X := le_mul_of_one_le_right (by linarith) hX1
      calc 12 * (c * X) = (12 * c) * X := by ring
        _ ≤ (b * b) * X := mul_le_mul_of_nonneg_right h12c hX0.le
        _ = b * (b * X) := by ring
        _ ≤ (b * X) * (b * X) := mul_le_mul_of_nonneg_right hbXb (by linarith)
    have h2 : (b * X) * (b * X) ≤ (b * X) ^ (k + 1 + 2) := by
      rw [← pow_two]; exact pow_le_pow_right₀ hbX1 (by omega)
    have h3 : (b * X) ^ (k + 1 + 2) ≤ (Nat.factorial (k + 1) : ℝ) * (b * X) ^ (k + 1 + 2) :=
      le_mul_of_one_le_left (by positivity) hfact1
    linarith
  · have hNk : (N : ℝ) ^ k ≤ (2 * (c * X)) ^ k := pow_le_pow_left₀ hN0 hNle k
    have hck : c ^ k ≤ b ^ k := pow_le_pow_left₀ (by linarith) hcb k
    have hNk' : (N : ℝ) ^ k ≤ 2 ^ k * b ^ k * X ^ k := by
      calc (N : ℝ) ^ k ≤ (2 * (c * X)) ^ k := hNk
        _ = 2 ^ k * c ^ k * X ^ k := by rw [mul_pow, mul_pow]; ring
        _ ≤ 2 ^ k * b ^ k * X ^ k := by
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          exact mul_le_mul_of_nonneg_left hck (by positivity)
    have hA : (Nat.factorial k : ℝ) * ((3 : ℝ) ^ (k + 1) * 2 ^ k)
        ≤ (Nat.factorial (k + 1) : ℝ) * b ^ 3 :=
      mul_le_mul hfk (h6.trans hbb3) (by positivity) (by positivity)
    have hB : (Nat.factorial k : ℝ) * ((3 : ℝ) ^ (k + 1) * 2 ^ k) * b ^ k
        ≤ (Nat.factorial (k + 1) : ℝ) * b ^ 3 * b ^ k :=
      mul_le_mul_of_nonneg_right hA (by positivity)
    have hC : (Nat.factorial k : ℝ) * ((3 : ℝ) ^ (k + 1) * 2 ^ k) * b ^ k * X ^ (k + 1)
        ≤ (Nat.factorial (k + 1) : ℝ) * b ^ 3 * b ^ k * X ^ (k + 1 + 2) :=
      mul_le_mul hB (pow_le_pow_right₀ hX1 (by omega)) (by positivity) (by positivity)
    calc (3 : ℝ) ^ (k + 1) * X * ((Nat.factorial k : ℝ) * (N : ℝ) ^ k)
        ≤ (3 : ℝ) ^ (k + 1) * X * ((Nat.factorial k : ℝ) * (2 ^ k * b ^ k * X ^ k)) := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          exact mul_le_mul_of_nonneg_left hNk' (by positivity)
      _ = (Nat.factorial k : ℝ) * ((3 : ℝ) ^ (k + 1) * 2 ^ k) * b ^ k * X ^ (k + 1) := by
          ring
      _ ≤ (Nat.factorial (k + 1) : ℝ) * b ^ 3 * b ^ k * X ^ (k + 1 + 2) := hC
      _ = (Nat.factorial (k + 1) : ℝ) * (b * X) ^ (k + 1 + 2) := by ring

theorem kai_vb_core_from_gap (D : Type) [Fintype D] [DecidableEq D] (d : ℕ)
    (hd : Fintype.card D = d)
    (Γ : AddSubgroup (D → ℝ)) (hZ : ∀ m : D → ℤ, (fun x => (m x : ℝ)) ∈ Γ)
    (Q : ℕ) (R : Finset (D → ℝ)) (hRc : R.card ≤ Q)
    (hR : ∀ γ ∈ Γ, ∃ ρ ∈ R, ∃ m : D → ℤ, γ = ρ + fun x => (m x : ℝ))
    (r : ℕ) (a : Fin r → D → ℝ) (κ : ℝ) (hκ : 0 ≤ κ) (τ : ℝ) (hτ0 : 0 < τ) (hτ1 : τ ≤ 1)
    (d' : ℕ) (v : Fin d' → D → ℝ) (L : Fin d' → ℕ)
    (hv : LinearIndependent ℝ v) (hvΓ : ∀ i, v i ∈ Γ) (hL : ∀ i, 1 ≤ L i)
    (hP : ∀ ℓ : Fin d' → ℤ, (∀ i, |ℓ i| ≤ (L i : ℤ)) →
      (∀ x, |∑ i, (ℓ i : ℝ) * v i x| ≤ 1 / 2) ∧
      ∀ j, |∑ x, a j x * ∑ i, (ℓ i : ℝ) * v i x| ≤ κ)
    (hcard : τ * (Q : ℝ) ≤ ∏ i, (2 * (L i : ℝ) + 1)) :
    ∃ (s t : ℕ) (w : Fin s → D → ℤ) (η : Fin t → D → ℤ),
      s + t = d ∧
      LinearIndependent ℝ (fun i x => (w i x : ℝ)) ∧
      LinearIndependent ℝ (fun i x => (η i x : ℝ)) ∧
      (∀ i i', ∑ x, w i x * η i' x = 0) ∧
      (∀ i x, |(w i x : ℝ)| ≤ vbT d τ) ∧
      (∀ i x, |(η i x : ℝ)| ≤ vbT d τ) ∧
      (∀ i j, |∑ x, (w i x : ℝ) * a j x| ≤ vbT d τ * κ) ∧
      (∀ i', ∀ γ ∈ Γ, ∃ z : ℤ, ∑ x, (η i' x : ℝ) * γ x = z) :=
by
  classical
  have hdd : d' ≤ d := by
    have h1 := hv.fintype_card_le_finrank
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_fin, hd] at h1
    exact h1
  have hN1 : (1 : ℝ) ≤ (⌈(5 : ℝ) ^ d / τ⌉₊ : ℝ) := by
    have h0 : 0 < (5 : ℝ) ^ d / τ := by positivity
    have h := Nat.ceil_pos.mpr h0
    exact_mod_cast h
  obtain ⟨w, hw_li, hw_b, hw_a, hw_orth⟩ :=
    kai_vb_integer_span_basis D d hd Γ Q R hRc hR r a κ hκ τ hτ0 d' v L hv hvΓ hL hP hcard
  obtain ⟨u, hu_li, hu_orth, hu_b⟩ :=
    kai_vb_cramer_complement D d hd (⌈(5 : ℝ) ^ d / τ⌉₊ : ℝ) hN1 d' w hw_li hw_b
  have hu_v : ∀ l k, ∑ x, v k x * (u l x : ℝ) = 0 := by
    intro l k
    apply hw_orth (fun x => (u l x : ℝ)) _ k
    intro i
    have h := congrArg (fun z : ℤ => (z : ℝ)) (hu_orth i l)
    push_cast at h
    exact h
  have hds : ∀ l : Fin (d - d'), ∃ m : ℕ, 1 ≤ m ∧
      (m : ℝ) * ∏ i, (2 * (L i : ℝ) + 1) ≤ 3 ^ d * (R.card : ℝ) ∧
      ∀ γ ∈ Γ, ∃ z : ℤ, ∑ x, (((m : ℤ) * u l x : ℤ) : ℝ) * γ x = z :=
    fun l => kai_vb_dual_scaling D d hd Γ R hR d' v L hv hvΓ (fun ℓ hℓ => (hP ℓ hℓ).1)
      (u l) (hu_v l)
  choose m hm1 hmP hmZ using hds
  have hPpos : 0 < ∏ i, (2 * (L i : ℝ) + 1) := Finset.prod_pos (fun i _ => by positivity)
  have hRQ : (R.card : ℝ) ≤ (Q : ℝ) := by exact_mod_cast hRc
  have hm_le : ∀ l, (m l : ℝ) ≤ 3 ^ d / τ := by
    intro l
    rw [le_div_iff₀ hτ0]
    have h3 : (0 : ℝ) ≤ 3 ^ d := by positivity
    have h2 : ((m l : ℝ) * τ) * ∏ i, (2 * (L i : ℝ) + 1) ≤ 3 ^ d * ∏ i, (2 * (L i : ℝ) + 1) := by
      calc ((m l : ℝ) * τ) * ∏ i, (2 * (L i : ℝ) + 1)
          = ((m l : ℝ) * ∏ i, (2 * (L i : ℝ) + 1)) * τ := by ring
        _ ≤ (3 ^ d * (R.card : ℝ)) * τ := mul_le_mul_of_nonneg_right (hmP l) hτ0.le
        _ ≤ (3 ^ d * (Q : ℝ)) * τ :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hRQ h3) hτ0.le
        _ = 3 ^ d * (τ * Q) := by ring
        _ ≤ 3 ^ d * ∏ i, (2 * (L i : ℝ) + 1) := mul_le_mul_of_nonneg_left hcard h3
    exact le_of_mul_le_mul_right h2 hPpos
  refine ⟨d', d - d', w, fun l x => (m l : ℤ) * u l x, by omega, hw_li, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have h := hu_li.units_smul (fun l => Units.mk0 (m l : ℝ)
      (Nat.cast_ne_zero.mpr (by have := hm1 l; omega)))
    convert h using 1
    funext l x
    simp [Units.smul_def]
  · intro i l
    have h : ∑ x, w i x * ((m l : ℤ) * u l x) = (m l : ℤ) * ∑ x, w i x * u l x := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun x _ => by ring)
    rw [h, hu_orth i l, mul_zero]
  · intro i x
    have hd1 : 1 ≤ d := by
      have := Fintype.card_pos_iff.mpr ⟨x⟩
      omega
    obtain ⟨hc1, -⟩ := kai_vb_core_constants d hd1 τ hτ0 hτ1
    linarith [hw_b i x]
  · intro l x
    have hd1 : 1 ≤ d := by
      have := Fintype.card_pos_iff.mpr ⟨x⟩
      omega
    obtain ⟨-, hc2⟩ := kai_vb_core_constants d hd1 τ hτ0 hτ1
    show |((((m l : ℤ) * u l x : ℤ)) : ℝ)| ≤ vbT d τ
    push_cast
    rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
    calc (m l : ℝ) * |(u l x : ℝ)|
        ≤ (3 ^ d / τ) * ((Nat.factorial (d - 1) : ℝ) * (⌈(5 : ℝ) ^ d / τ⌉₊ : ℝ) ^ (d - 1)) :=
          mul_le_mul (hm_le l) (hu_b l x) (abs_nonneg _) (by positivity)
      _ ≤ vbT d τ := hc2
  · intro i j
    have hd1 : 1 ≤ d := by
      have := i.pos
      omega
    obtain ⟨hc1, -⟩ := kai_vb_core_constants d hd1 τ hτ0 hτ1
    calc |∑ x, (w i x : ℝ) * a j x| ≤ 2 * (⌈(5 : ℝ) ^ d / τ⌉₊ : ℝ) * κ := hw_a i j
      _ ≤ vbT d τ * κ := mul_le_mul_of_nonneg_right hc1 hκ
  · intro l γ hγ
    exact hmZ l γ hγ

theorem kai_vb_indep_subfamily (ι : Type) [Fintype ι] [DecidableEq ι] (t'' : ℕ)
    (η' : Fin t'' → ι → ℤ) :
    ∃ (t : ℕ) (η : Fin t → ι → ℤ),
      t ≤ Fintype.card ι ∧
      LinearIndependent ℝ (fun j k => (η j k : ℝ)) ∧
      (∀ j, ∃ k, η j = η' k) ∧
      (∀ u : ι → ℤ, (∀ j, ∑ x, η j x * u x = 0) → ∀ k, ∑ x, η' k x * u x = 0) :=
by
  classical
  let v : Fin t'' → ι → ℝ := fun k x => (η' k x : ℝ)
  obtain ⟨κ, a, ha_inj, hspan, hli⟩ := exists_linearIndependent' ℝ v
  haveI : Finite κ := Finite.of_injective a ha_inj
  letI : Fintype κ := Fintype.ofFinite κ
  let e := Fintype.equivFin κ
  have hli' : LinearIndependent ℝ (fun j : Fin (Fintype.card κ) => v (a (e.symm j))) :=
    hli.comp e.symm e.symm.injective
  refine ⟨Fintype.card κ, fun j => η' (a (e.symm j)), ?_, hli', ?_, ?_⟩
  · have := hli'.fintype_card_le_finrank
    simpa [Module.finrank_fintype_fun_eq_card] using this
  · intro j; exact ⟨_, rfl⟩
  · intro u hu k
    let φ : (ι → ℝ) →ₗ[ℝ] ℝ := ∑ x, (u x : ℝ) • LinearMap.proj x
    have hφ : ∀ y, φ y = ∑ x, y x * (u x : ℝ) := by
      intro y
      simp [φ, LinearMap.sum_apply, mul_comm]
    have hgen : Set.range (v ∘ a) ⊆ LinearMap.ker φ := by
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, hφ]
      have h := hu (e i)
      simp only [Equiv.symm_apply_apply] at h
      have h2 : ((∑ x, η' (a i) x * u x : ℤ) : ℝ) = 0 := by rw [h]; simp
      push_cast at h2
      simpa [v] using h2
    have hle := Submodule.span_le.mpr hgen
    rw [hspan] at hle
    have hk : v k ∈ LinearMap.ker φ := hle (Submodule.subset_span ⟨k, rfl⟩)
    rw [LinearMap.mem_ker, hφ] at hk
    have h3 : ((∑ x, η' k x * u x : ℤ) : ℝ) = 0 := by
      push_cast
      simpa [v] using hk
    exact_mod_cast h3

theorem kai_vb_perp_in_span (D : Type) [Fintype D] [DecidableEq D] (s t : ℕ)
    (w : Fin s → D → ℤ) (η : Fin t → D → ℤ) (hst : s + t = Fintype.card D)
    (hw : LinearIndependent ℝ (fun i x => (w i x : ℝ)))
    (hη : LinearIndependent ℝ (fun i x => (η i x : ℝ)))
    (horth : ∀ i i', ∑ x, w i x * η i' x = 0)
    (y : D → ℝ) (hy : ∀ k, ∑ x, y x * (η k x : ℝ) = 0) :
    ∃ c : Fin s → ℝ, y = ∑ i, c i • (fun x => (w i x : ℝ)) :=
by
  classical
  let M : Matrix (Fin t) D ℝ := Matrix.of (fun k x => (η k x : ℝ))
  let L := M.mulVecLin
  have hker : ∀ v : D → ℝ, v ∈ LinearMap.ker L ↔ ∀ k, ∑ x, (η k x : ℝ) * v x = 0 := by
    intro v
    rw [LinearMap.mem_ker, Matrix.mulVecLin_apply, funext_iff]
    simp [M, Matrix.mulVec, dotProduct]
  have hy' : y ∈ LinearMap.ker L :=
    (hker y).2 (fun k => by simpa [mul_comm] using hy k)
  have hWle : Submodule.span ℝ (Set.range (fun i x => (w i x : ℝ))) ≤ LinearMap.ker L := by
    rw [Submodule.span_le, Set.range_subset_iff]
    intro i
    refine (hker _).2 (fun k => ?_)
    have h := congrArg (fun z : ℤ => (z : ℝ)) (horth i k)
    push_cast at h
    simpa [mul_comm] using h
  have hrank : Module.finrank ℝ (LinearMap.range L) = t := by
    have h1 : Module.finrank ℝ (LinearMap.range L) = M.rank := rfl
    rw [h1, Matrix.rank_eq_finrank_span_row]
    have h2 : M.row = (fun k x => (η k x : ℝ)) := rfl
    rw [h2, finrank_span_eq_card hη, Fintype.card_fin]
  have hkerdim : Module.finrank ℝ (LinearMap.ker L) = s := by
    have h := LinearMap.finrank_range_add_finrank_ker L
    rw [hrank, Module.finrank_fintype_fun_eq_card] at h
    omega
  have hWdim : Module.finrank ℝ (Submodule.span ℝ (Set.range (fun i x => (w i x : ℝ)))) = s := by
    rw [finrank_span_eq_card hw, Fintype.card_fin]
  have heq := Submodule.eq_of_le_of_finrank_eq hWle (hWdim.trans hkerdim.symm)
  rw [← heq] at hy'
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 hy'
  exact ⟨c, hc.symm⟩

theorem kai_vb_gram_cramer (D : Type) [Fintype D] [DecidableEq D] (d : ℕ)
    (hd : Fintype.card D = d) (s : ℕ) (w : Fin s → D → ℤ)
    (hw : LinearIndependent ℝ (fun i x => (w i x : ℝ)))
    (T : ℝ) (hT : 1 ≤ T) (hwb : ∀ i x, |(w i x : ℝ)| ≤ T) :
    ∃ g : ℤ, g ≠ 0 ∧
      |(g : ℝ)| ≤ (Nat.factorial (d + 1) : ℝ) * ((d : ℝ) + 1) ^ (d + 1) * T ^ (2 * d + 1) ∧
      ∀ (y : D → ℤ) (U : ℝ), 0 ≤ U → (∀ x, |(y x : ℝ)| ≤ U) →
        (∃ c : Fin s → ℝ, (fun x => (y x : ℝ)) = ∑ i, c i • (fun x => (w i x : ℝ))) →
        ∃ e : Fin s → ℤ, (∀ x, g * y x = ∑ i, e i * w i x) ∧
          ∀ i, |(e i : ℝ)| ≤
            (Nat.factorial (d + 1) : ℝ) * ((d : ℝ) + 1) ^ (d + 1) * T ^ (2 * d + 1) * U :=
by
  classical
  
  have hsd : s ≤ d := by
    have h := hw.fintype_card_le_finrank
    simpa [Module.finrank_fintype_fun_eq_card, hd] using h
  obtain ⟨G, hG⟩ : ∃ G : Matrix (Fin s) (Fin s) ℤ,
      G = Matrix.of (fun i i' : Fin s => ∑ x, w i x * w i' x) := ⟨_, rfl⟩
  have hGij : ∀ i i', G i i' = ∑ x, w i x * w i' x := by
    intro i i'; rw [hG, Matrix.of_apply]
  
  have hg0 : G.det ≠ 0 := by
    intro h0
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
    obtain ⟨z, hz⟩ : ∃ z : D → ℤ, z = fun x => ∑ i, w i x * v i := ⟨_, rfl⟩
    have hzx : ∀ x, z x = ∑ i, w i x * v i := fun x => by rw [hz]
    have hrow : ∀ i, ∑ x, w i x * z x = 0 := by
      intro i
      have h1 := congrFun hv i
      rw [Pi.zero_apply] at h1
      rw [← h1]
      calc ∑ x, w i x * z x = ∑ x, ∑ i', w i x * (w i' x * v i') := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            rw [hzx x, Finset.mul_sum]
        _ = ∑ i', ∑ x, w i x * (w i' x * v i') := Finset.sum_comm
        _ = (G.mulVec v) i := by
            simp only [Matrix.mulVec, dotProduct, hGij, Finset.sum_mul]
            refine Finset.sum_congr rfl (fun i' _ => Finset.sum_congr rfl (fun x _ => ?_))
            ring
    have hsq : ∑ x, z x * z x = 0 := by
      calc ∑ x, z x * z x = ∑ x, (∑ i, w i x * v i) * z x :=
            Finset.sum_congr rfl (fun x _ => congrArg (· * z x) (hzx x))
        _ = ∑ x, ∑ i, w i x * v i * z x := by simp only [Finset.sum_mul]
        _ = ∑ i, ∑ x, w i x * v i * z x := Finset.sum_comm
        _ = ∑ i, v i * ∑ x, w i x * z x := by
            simp only [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun x _ => ?_))
            ring
        _ = 0 := by simp [hrow]
    have hz0 : ∀ x, z x = 0 := by
      intro x
      have := (Finset.sum_eq_zero_iff_of_nonneg (fun x _ => mul_self_nonneg (z x))).mp hsq x
        (Finset.mem_univ x)
      exact mul_self_eq_zero.mp this
    have hcomb : ∑ i, (v i : ℝ) • (fun x => (w i x : ℝ)) = 0 := by
      funext x
      have h1 : ((z x : ℤ) : ℝ) = 0 := by rw [hz0 x]; simp
      rw [hzx x] at h1
      push_cast at h1
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
      rw [← h1]
      exact Finset.sum_congr rfl (fun i _ => by ring)
    have hvz := Fintype.linearIndependent_iff.mp hw _ hcomb
    apply hv0
    funext i
    exact_mod_cast hvz i
  
  have hd0 : (0 : ℝ) ≤ (d : ℝ) := Nat.cast_nonneg d
  have hP1 : (1 : ℝ) ≤ (d : ℝ) + 1 := by linarith
  have hT0 : (0 : ℝ) ≤ T := by linarith
  have hM1 : (1 : ℝ) ≤ ((d : ℝ) + 1) * T ^ 2 := by
    have h2 : (1 : ℝ) ≤ T ^ 2 := one_le_pow₀ hT
    nlinarith
  have hcardD : (Finset.univ : Finset D).card = d := by rw [Finset.card_univ, hd]
  
  have hGb : ∀ i i', |((G i i' : ℤ) : ℝ)| ≤ ((d : ℝ) + 1) * T ^ 2 := by
    intro i i'
    rw [hGij]; push_cast
    calc |∑ x, (w i x : ℝ) * (w i' x : ℝ)| ≤ ∑ x, |(w i x : ℝ) * (w i' x : ℝ)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ x : D, T * T := Finset.sum_le_sum (fun x _ => by
          rw [abs_mul]; exact mul_le_mul (hwb i x) (hwb i' x) (abs_nonneg _) hT0)
      _ = (d : ℝ) * T ^ 2 := by rw [Finset.sum_const, hcardD, nsmul_eq_mul]; ring
      _ ≤ ((d : ℝ) + 1) * T ^ 2 := by nlinarith [sq_nonneg T]
  
  have hdetle : ∀ B : Matrix (Fin s) (Fin s) ℝ, (∀ i j, |B i j| ≤ ((d : ℝ) + 1) * T ^ 2) →
      |B.det| ≤ (Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s := by
    intro B hB
    have := Matrix.det_le (abv := AbsoluteValue.abs) hB
    simpa [Fintype.card_fin, nsmul_eq_mul] using this
  obtain ⟨Gr, hGr⟩ : ∃ Gr : Matrix (Fin s) (Fin s) ℝ, Gr = G.map (Int.cast : ℤ → ℝ) :=
    ⟨_, rfl⟩
  have hGrij : ∀ i j, Gr i j = ((G i j : ℤ) : ℝ) := by intro i j; rw [hGr, Matrix.map_apply]
  have hdetG : ((G.det : ℤ) : ℝ) = Gr.det := by
    rw [hGr]; exact RingHom.map_det (Int.castRingHom ℝ) G
  have hadj : G.adjugate.map (Int.cast : ℤ → ℝ) = Gr.adjugate := by
    rw [hGr]; exact RingHom.map_adjugate (Int.castRingHom ℝ) G
  have hadjij : ∀ i j, ((G.adjugate i j : ℤ) : ℝ) = Gr.adjugate i j := by
    intro i j; rw [← hadj, Matrix.map_apply]
  have hgB : |((G.det : ℤ) : ℝ)| ≤ (Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s := by
    rw [hdetG]; exact hdetle Gr (fun i j => by rw [hGrij]; exact hGb i j)
  have hadjB : ∀ i j, |((G.adjugate i j : ℤ) : ℝ)| ≤
      (Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s := by
    intro i j
    rw [hadjij, Matrix.adjugate_apply]
    apply hdetle
    intro k l
    rw [Matrix.updateRow_apply]
    split_ifs with hk
    · rw [Pi.single_apply]
      split_ifs
      · simp; linarith
      · simp; linarith
    · rw [hGrij]; exact hGb k l
  
  have hBs0 : (0 : ℝ) ≤ (Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s := by positivity
  have hc1 : (Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s ≤
      (Nat.factorial (d + 1) : ℝ) * ((d : ℝ) + 1) ^ (d + 1) * T ^ (2 * d + 1) := by
    have hf : (Nat.factorial s : ℝ) ≤ (Nat.factorial (d + 1) : ℝ) := by
      exact_mod_cast Nat.factorial_le (by omega)
    have hP : ((d : ℝ) + 1) ^ s ≤ ((d : ℝ) + 1) ^ (d + 1) := pow_le_pow_right₀ hP1 (by omega)
    have hTT : T ^ (2 * s) ≤ T ^ (2 * d + 1) := pow_le_pow_right₀ hT (by omega)
    calc (Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s
        = (Nat.factorial s : ℝ) * ((d : ℝ) + 1) ^ s * T ^ (2 * s) := by
          rw [mul_pow, ← pow_mul]; ring
      _ ≤ (Nat.factorial (d + 1) : ℝ) * ((d : ℝ) + 1) ^ (d + 1) * T ^ (2 * d + 1) :=
          mul_le_mul (mul_le_mul hf hP (by positivity) (by positivity)) hTT (by positivity)
            (by positivity)
  have hc2 : ∀ U : ℝ, 0 ≤ U →
      (s : ℝ) * ((Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s) * (((d : ℝ) + 1) * T * U) ≤
        (Nat.factorial (d + 1) : ℝ) * ((d : ℝ) + 1) ^ (d + 1) * T ^ (2 * d + 1) * U := by
    intro U hU
    have hfn : s * Nat.factorial s ≤ Nat.factorial (d + 1) :=
      calc s * Nat.factorial s ≤ (s + 1) * Nat.factorial s := Nat.mul_le_mul_right _ (Nat.le_succ s)
        _ = Nat.factorial (s + 1) := (Nat.factorial_succ s).symm
        _ ≤ Nat.factorial (d + 1) := Nat.factorial_le (by omega)
    have hf2 : ((s * Nat.factorial s : ℕ) : ℝ) ≤ (Nat.factorial (d + 1) : ℝ) := by
      exact_mod_cast hfn
    have hP2 : ((d : ℝ) + 1) ^ (s + 1) ≤ ((d : ℝ) + 1) ^ (d + 1) :=
      pow_le_pow_right₀ hP1 (by omega)
    have hT2 : T ^ (2 * s + 1) ≤ T ^ (2 * d + 1) := pow_le_pow_right₀ hT (by omega)
    calc (s : ℝ) * ((Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s) * (((d : ℝ) + 1) * T * U)
        = ((s * Nat.factorial s : ℕ) : ℝ) * ((d : ℝ) + 1) ^ (s + 1) * T ^ (2 * s + 1) * U := by
          rw [mul_pow, ← pow_mul]; push_cast; ring
      _ ≤ (Nat.factorial (d + 1) : ℝ) * ((d : ℝ) + 1) ^ (d + 1) * T ^ (2 * d + 1) * U :=
          mul_le_mul_of_nonneg_right (mul_le_mul (mul_le_mul hf2 hP2 (by positivity)
            (by positivity)) hT2 (by positivity) (by positivity)) hU
  
  refine ⟨G.det, hg0, hgB.trans hc1, ?_⟩
  intro y U hU hy hcex
  obtain ⟨c, hc⟩ := hcex
  have hcx : ∀ z, (y z : ℝ) = ∑ i, c i * (w i z : ℝ) := by
    intro z
    have := congrFun hc z
    simpa [Finset.sum_apply] using this
  obtain ⟨b, hbdef⟩ : ∃ b : Fin s → ℤ, b = fun i' => ∑ x, w i' x * y x := ⟨_, rfl⟩
  obtain ⟨e, hedef⟩ : ∃ e : Fin s → ℤ, e = G.adjugate.mulVec b := ⟨_, rfl⟩
  have hb : ∀ i', ((b i' : ℤ) : ℝ) = (Gr.mulVec c) i' := by
    intro i'
    rw [hbdef]
    simp only [Matrix.mulVec, dotProduct, hGrij, hGij]
    push_cast
    simp only [hcx, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun x _ => ?_))
    ring
  have he : ∀ i, ((e i : ℤ) : ℝ) = ∑ i', ((G.adjugate i i' : ℤ) : ℝ) * ((b i' : ℤ) : ℝ) := by
    intro i
    rw [hedef]
    simp only [Matrix.mulVec, dotProduct]
    push_cast
    rfl
  have he2 : ∀ i, ((e i : ℤ) : ℝ) = ((G.det : ℤ) : ℝ) * c i := by
    intro i
    have h1 : ((e i : ℤ) : ℝ) = (Gr.adjugate.mulVec (Gr.mulVec c)) i := by
      rw [he i]
      simp only [Matrix.mulVec, dotProduct]
      refine Finset.sum_congr rfl (fun i' _ => ?_)
      rw [hadjij, hb i']
      rfl
    rw [h1, Matrix.mulVec_mulVec, Matrix.adjugate_mul, hdetG]
    simp [Matrix.smul_mulVec_assoc]
  refine ⟨e, ?_, ?_⟩
  · intro x
    have : ((G.det * y x : ℤ) : ℝ) = ((∑ i, e i * w i x : ℤ) : ℝ) := by
      rw [Int.cast_mul, Int.cast_sum]
      simp only [Int.cast_mul, he2, hcx x, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => by ring)
    exact Int.cast_injective this
  · intro i
    have hbB : ∀ i', |((b i' : ℤ) : ℝ)| ≤ ((d : ℝ) + 1) * T * U := by
      intro i'
      rw [hbdef]
      push_cast
      calc |∑ x, (w i' x : ℝ) * (y x : ℝ)| ≤ ∑ x, |(w i' x : ℝ) * (y x : ℝ)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ x : D, T * U := Finset.sum_le_sum (fun x _ => by
            rw [abs_mul]; exact mul_le_mul (hwb i' x) (hy x) (abs_nonneg _) hT0)
        _ = (d : ℝ) * T * U := by rw [Finset.sum_const, hcardD, nsmul_eq_mul]; ring
        _ ≤ ((d : ℝ) + 1) * T * U := by nlinarith [mul_nonneg hT0 hU]
    rw [he i]
    refine le_trans ?_ (hc2 U hU)
    calc |∑ i', ((G.adjugate i i' : ℤ) : ℝ) * ((b i' : ℤ) : ℝ)|
        ≤ ∑ i', |((G.adjugate i i' : ℤ) : ℝ) * ((b i' : ℤ) : ℝ)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i' : Fin s, ((Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s) *
            (((d : ℝ) + 1) * T * U) := Finset.sum_le_sum (fun i' _ => by
          rw [abs_mul]; exact mul_le_mul (hadjB i i') (hbB i') (abs_nonneg _) hBs0)
      _ = (s : ℝ) * ((Nat.factorial s : ℝ) * (((d : ℝ) + 1) * T ^ 2) ^ s) *
            (((d : ℝ) + 1) * T * U) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring

theorem kai_vb_augment_elimination (ι : Type) [Fintype ι] [DecidableEq ι] (r N : ℕ) (hN : 1 ≤ N)
    (T κ : ℝ) (hT : 1 ≤ T) (hκ : 0 ≤ κ)
    (α A : Fin r → ι → ℝ) (α'' A'' : Fin r → (ι ⊕ Fin r) → ℝ)
    (hα1 : ∀ i k, |α'' i (Sum.inl k) - α i k| ≤ 1 / (2 * (N : ℝ)))
    (hα2 : ∀ i i', α'' i (Sum.inr i') = if i' = i then 1 / (N : ℝ) else 0)
    (hA'' : ∀ j k, A'' j (Sum.inl k) = A j k)
    (s'' t'' : ℕ) (w'' : Fin s'' → (ι ⊕ Fin r) → ℤ) (η'' : Fin t'' → (ι ⊕ Fin r) → ℤ)
    (hst : s'' + t'' = Fintype.card ι + r)
    (hw : LinearIndependent ℝ (fun i x => (w'' i x : ℝ)))
    (hη : LinearIndependent ℝ (fun i x => (η'' i x : ℝ)))
    (horth : ∀ i i', ∑ x, w'' i x * η'' i' x = 0)
    (hwb : ∀ i x, |(w'' i x : ℝ)| ≤ T) (hηb : ∀ i x, |(η'' i x : ℝ)| ≤ T)
    (hwA : ∀ i j, |∑ x, (w'' i x : ℝ) * A'' j x| ≤ T * κ)
    (hηα : ∀ k i, ∃ z : ℤ, ∑ x, (η'' k x : ℝ) * α'' i x = z) :
    ∃ (s t : ℕ) (w : Fin s → ι → ℤ) (η : Fin t → ι → ℤ),
      s + t = Fintype.card ι ∧
      LinearIndependent ℝ (fun i k => (w i k : ℝ)) ∧
      LinearIndependent ℝ (fun i k => (η i k : ℝ)) ∧
      (∀ i i', ∑ k, w i k * η i' k = 0) ∧
      (∀ i k, |(w i k : ℝ)| ≤ vbY (Fintype.card ι + r) T) ∧
      (∀ i k, |(η i k : ℝ)| ≤ vbY (Fintype.card ι + r) T) ∧
      (∀ i' j, |(∑ k, (η i' k : ℝ) * α j k) - round (∑ k, (η i' k : ℝ) * α j k)|
          ≤ vbY (Fintype.card ι + r) T / (N : ℝ)) ∧
      (∀ i j, |∑ k, (w i k : ℝ) * A j k| ≤ vbY (Fintype.card ι + r) T * κ) :=
by
  classical
  obtain ⟨n, hn⟩ : ∃ n, n = Fintype.card ι := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d, d = Fintype.card ι + r := ⟨_, rfl⟩
  have hdn : d = n + r := by rw [hd, hn]
  rw [← hd, ← hn]
  rw [← hn] at hst
  have hT0 : (0 : ℝ) ≤ T := by linarith
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
  have hD : Fintype.card (ι ⊕ Fin r) = d := by rw [Fintype.card_sum, Fintype.card_fin, hd]
  obtain ⟨η', hη'⟩ : ∃ η' : Fin t'' → ι → ℤ, ∀ k a, η' k a = η'' k (Sum.inl a) :=
    ⟨fun k a => η'' k (Sum.inl a), fun _ _ => rfl⟩
  obtain ⟨t, η, htn, hηli, hηsub, htransfer⟩ := kai_vb_indep_subfamily ι t'' η'
  rw [← hn] at htn
  have hηT : ∀ i x, |(η i x : ℝ)| ≤ T := by
    intro i x
    obtain ⟨k, hk⟩ := hηsub i
    rw [hk, hη']
    exact hηb k _
  obtain ⟨u, hu_li, hu_orth, hu_b⟩ :=
    kai_vb_cramer_complement ι n hn.symm T hT t η hηli hηT
  obtain ⟨g, hg0, hgb, hrep⟩ := kai_vb_gram_cramer (ι ⊕ Fin r) d hD s'' w'' hw T hT hwb
  obtain ⟨Bd, hBd⟩ : ∃ Bd : ℝ,
      Bd = (Nat.factorial (d + 1) : ℝ) * ((d : ℝ) + 1) ^ (d + 1) * T ^ (2 * d + 1) := ⟨_, rfl⟩
  obtain ⟨U, hU⟩ : ∃ U : ℝ, U = (Nat.factorial (n - 1) : ℝ) * T ^ (n - 1) := ⟨_, rfl⟩
  rw [← hBd] at hgb hrep
  rw [← hU] at hu_b
  have hU0 : (0 : ℝ) ≤ U := by
    rw [hU]; exact mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hT0 _)
  have hd0 : (0 : ℝ) ≤ (d : ℝ) := Nat.cast_nonneg d
  have hBd0 : 0 ≤ Bd := by
    rw [hBd]
    have : (0 : ℝ) ≤ ((d : ℝ) + 1) ^ (d + 1) := by positivity
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) this) (pow_nonneg hT0 _)
  obtain ⟨y, hyl, hyr⟩ : ∃ y : Fin (n - t) → (ι ⊕ Fin r) → ℤ,
      (∀ l a, y l (Sum.inl a) = u l a) ∧ (∀ l b, y l (Sum.inr b) = 0) :=
    ⟨fun l => Sum.elim (u l) (fun _ => 0), fun _ _ => rfl, fun _ _ => rfl⟩
  have key : ∀ l, ∃ e : Fin s'' → ℤ, (∀ x, g * y l x = ∑ i, e i * w'' i x) ∧
      ∀ i, |(e i : ℝ)| ≤ Bd * U := by
    intro l
    have hperp : ∀ k, ∑ x, (y l x : ℝ) * (η'' k x : ℝ) = 0 := by
      intro k
      have h0 := htransfer (u l) (fun j => hu_orth j l) k
      rw [Fintype.sum_sum_type]
      simp only [hyl, hyr, Int.cast_zero, zero_mul, Finset.sum_const_zero, add_zero]
      have h2 : ∑ a, (u l a : ℝ) * (η'' k (Sum.inl a) : ℝ)
          = ((∑ x, η' k x * u l x : ℤ) : ℝ) := by
        push_cast
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [hη']
        ring
      rw [h2, h0]
      simp
    obtain ⟨c, hc⟩ := kai_vb_perp_in_span (ι ⊕ Fin r) s'' t'' w'' η''
      (by rw [hD, hdn]; exact hst) hw hη horth _ hperp
    refine hrep (y l) U hU0 ?_ ⟨c, hc⟩
    intro x
    cases x with
    | inl a => rw [hyl]; exact hu_b l a
    | inr b => rw [hyr]; simp only [Int.cast_zero, abs_zero]; exact hU0
  choose e he1 he2 using key
  have hg' : (g : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hg0
  have hnd : n ≤ d := by omega
  have hsd : s'' ≤ d := by omega
  have hFge : (1 : ℝ) ≤ (Nat.factorial (d + 1) : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have hPge : (d : ℝ) + 1 ≤ ((d : ℝ) + 1) ^ (d + 1) := le_self_pow₀ (by linarith) (by omega)
  have hYeq : vbY d T = Bd * ((Nat.factorial (d + 1) : ℝ) * T ^ d) := by
    rw [hBd]
    unfold vbY
    rw [show 3 * d + 1 = (2 * d + 1) + d by ring, pow_add]
    ring
  have hfac1 : (Nat.factorial (n - 1) : ℝ) ≤ (Nat.factorial (d + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_le (by omega)
  have hI1 : Bd * U ≤ vbY d T := by
    rw [hYeq, hU]
    exact mul_le_mul_of_nonneg_left (mul_le_mul hfac1 (pow_le_pow_right₀ hT (by omega))
      (pow_nonneg hT0 _) (Nat.cast_nonneg _)) hBd0
  have hI3 : ((d : ℝ) + 1) * T ≤ vbY d T := by
    unfold vbY
    have hP0 : (0 : ℝ) ≤ ((d : ℝ) + 1) ^ (d + 1) := by positivity
    calc ((d : ℝ) + 1) * T = 1 * ((d : ℝ) + 1) * T := by ring
      _ ≤ (Nat.factorial (d + 1) : ℝ) ^ 2 * ((d : ℝ) + 1) ^ (d + 1) * T ^ (3 * d + 1) :=
        mul_le_mul (mul_le_mul (one_le_pow₀ hFge) hPge (by linarith) (by positivity))
          (le_self_pow₀ hT (by omega)) hT0 (mul_nonneg (by positivity) hP0)
  have hTY : T ≤ vbY d T := le_trans (le_mul_of_one_le_left hT0 (by linarith)) hI3
  refine ⟨n - t, t, fun l a => g * u l a, η, Nat.sub_add_cancel htn, ?_, hηli, ?_, ?_, ?_, ?_, ?_⟩
  · 
    have := hu_li.units_smul (fun _ => Units.mk0 (g : ℝ) hg')
    convert this using 1
    ext l a
    simp [Units.smul_def]
  · 
    intro l i'
    show ∑ a, g * u l a * η i' a = 0
    have h0 := hu_orth i' l
    calc ∑ a, g * u l a * η i' a = g * ∑ a, η i' a * u l a := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun a _ => by ring)
      _ = 0 := by rw [h0, mul_zero]
  · 
    intro l a
    show |((g * u l a : ℤ) : ℝ)| ≤ vbY d T
    rw [Int.cast_mul, abs_mul]
    exact le_trans (mul_le_mul hgb (hu_b l a) (abs_nonneg _) hBd0) hI1
  · 
    intro i a
    exact (hηT i a).trans hTY
  · 
    intro i' j
    obtain ⟨k, hk⟩ := hηsub i'
    rw [hk]
    simp only [hη']
    obtain ⟨z, hz⟩ := hηα k j
    rw [Fintype.sum_sum_type] at hz
    have h2 : ∑ b, (η'' k (Sum.inr b) : ℝ) * α'' j (Sum.inr b)
        = (η'' k (Sum.inr j) : ℝ) * (1 / (N : ℝ)) := by
      simp only [hα2, mul_ite, mul_zero]
      rw [Finset.sum_ite_eq']
      simp
    rw [h2] at hz
    have hdiff : (∑ a, (η'' k (Sum.inl a) : ℝ) * α j a) - (z : ℝ)
        = ∑ a, (η'' k (Sum.inl a) : ℝ) * (α j a - α'' j (Sum.inl a))
          - (η'' k (Sum.inr j) : ℝ) * (1 / (N : ℝ)) := by
      rw [← hz]
      simp only [mul_sub, Finset.sum_sub_distrib]
      ring
    have hb1 : |∑ a, (η'' k (Sum.inl a) : ℝ) * (α j a - α'' j (Sum.inl a))|
        ≤ (n : ℝ) * (T * (1 / (2 * (N : ℝ)))) := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc ∑ a, |(η'' k (Sum.inl a) : ℝ) * (α j a - α'' j (Sum.inl a))|
          ≤ ∑ _a : ι, T * (1 / (2 * (N : ℝ))) := by
            refine Finset.sum_le_sum (fun a _ => ?_)
            rw [abs_mul]
            exact mul_le_mul (hηb k _) (by rw [abs_sub_comm]; exact hα1 j a) (abs_nonneg _) hT0
        _ = (n : ℝ) * (T * (1 / (2 * (N : ℝ)))) := by
            rw [Finset.sum_const, Finset.card_univ, ← hn, nsmul_eq_mul]
    have hb2 : |(η'' k (Sum.inr j) : ℝ) * (1 / (N : ℝ))| ≤ T * (1 / (N : ℝ)) := by
      rw [abs_mul, abs_of_pos (div_pos one_pos hNpos)]
      exact mul_le_mul_of_nonneg_right (hηb k _) (div_pos one_pos hNpos).le
    have hXz : |(∑ a, (η'' k (Sum.inl a) : ℝ) * α j a) - (z : ℝ)|
        ≤ (n : ℝ) * (T * (1 / (2 * (N : ℝ)))) + T * (1 / (N : ℝ)) := by
      rw [hdiff]
      exact (abs_sub _ _).trans (add_le_add hb1 hb2)
    refine (round_le _ z).trans (hXz.trans ?_)
    have heq : (n : ℝ) * (T * (1 / (2 * (N : ℝ)))) + T * (1 / (N : ℝ))
        = (((n : ℝ) + 2) * T / 2) / N := by
      field_simp
    rw [heq]
    apply div_le_div_of_nonneg_right _ hNpos.le
    have hnd' : (n : ℝ) ≤ d := by exact_mod_cast hnd
    nlinarith [mul_nonneg hT0 (sub_nonneg.2 hnd'), mul_nonneg hT0 hd0]
  · 
    intro l j
    show |∑ a, ((g * u l a : ℤ) : ℝ) * A j a| ≤ vbY d T * κ
    have hn1 : 1 ≤ n := by have := l.isLt; omega
    have hsum : ∑ a, ((g * u l a : ℤ) : ℝ) * A j a
        = ∑ i, (e l i : ℝ) * ∑ x, (w'' i x : ℝ) * A'' j x := by
      have h1 : ∑ a, ((g * u l a : ℤ) : ℝ) * A j a
          = ∑ x : ι ⊕ Fin r, ((g * y l x : ℤ) : ℝ) * A'' j x := by
        rw [Fintype.sum_sum_type]
        simp only [hyl, hyr, hA'', mul_zero, Int.cast_zero, zero_mul, Finset.sum_const_zero,
          add_zero]
      rw [h1]
      calc ∑ x : ι ⊕ Fin r, ((g * y l x : ℤ) : ℝ) * A'' j x
          = ∑ x : ι ⊕ Fin r, (∑ i, (e l i : ℝ) * (w'' i x : ℝ)) * A'' j x := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            rw [he1 l x]
            push_cast
            rfl
        _ = ∑ i, (e l i : ℝ) * ∑ x, (w'' i x : ℝ) * A'' j x := by
            simp_rw [Finset.sum_mul, Finset.mul_sum]
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun x _ => by ring))
    rw [hsum]
    have hS : ∀ i, |(e l i : ℝ) * ∑ x, (w'' i x : ℝ) * A'' j x| ≤ (Bd * U) * (T * κ) := by
      intro i
      rw [abs_mul]
      exact mul_le_mul (he2 l i) (hwA i j) (abs_nonneg _) (mul_nonneg hBd0 hU0)
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_sum (fun i _ => hS i)).trans ?_
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have hfac2 : (s'' : ℝ) * (Nat.factorial (n - 1) : ℝ) ≤ (Nat.factorial (d + 1) : ℝ) := by
      have : s'' * Nat.factorial (n - 1) ≤ Nat.factorial (d + 1) := by
        rw [Nat.factorial_succ]
        exact Nat.mul_le_mul (by omega) (Nat.factorial_le (by omega))
      exact_mod_cast this
    have hpow : T ^ (n - 1) * T ≤ T ^ d := by
      rw [← pow_succ, Nat.sub_add_cancel hn1]
      exact pow_le_pow_right₀ hT hnd
    have hI2 : (s'' : ℝ) * (Bd * U) * T ≤ vbY d T := by
      rw [hYeq, hU]
      calc (s'' : ℝ) * (Bd * ((Nat.factorial (n - 1) : ℝ) * T ^ (n - 1))) * T
          = Bd * (((s'' : ℝ) * (Nat.factorial (n - 1) : ℝ)) * (T ^ (n - 1) * T)) := by ring
        _ ≤ Bd * ((Nat.factorial (d + 1) : ℝ) * T ^ d) :=
            mul_le_mul_of_nonneg_left (mul_le_mul hfac2 hpow
              (mul_nonneg (pow_nonneg hT0 _) hT0) (Nat.cast_nonneg _)) hBd0
    calc (s'' : ℝ) * (Bd * U * (T * κ)) = ((s'' : ℝ) * (Bd * U) * T) * κ := by ring
      _ ≤ vbY d T * κ := mul_le_mul_of_nonneg_right hI2 hκ

theorem kai_vb_constants (n r : ℕ) (hr : 1 ≤ r) (M δ : ℝ) (hM : 1 ≤ M) (hδ : 0 < δ)
    (hδ1 : δ ≤ 1) :
    0 < vbTau n r M δ ∧ vbTau n r M δ ≤ 1 ∧ 1 ≤ vbT (n + r) (vbTau n r M δ) ∧
      2 * vbY (n + r) (vbT (n + r) (vbTau n r M δ))
        ≤ Real.exp ((2 + (n : ℝ) + (r : ℝ) + Real.log M + Real.log (1 / δ)) ^ 12) :=
by
  have mulexp : ∀ a b x y : ℝ, 0 ≤ a → 0 ≤ b → a ≤ Real.exp x → b ≤ Real.exp y →
      a * b ≤ Real.exp (x + y) := by
    intro a b x y _ hb hax hby
    rw [Real.exp_add]
    exact mul_le_mul hax hby hb (Real.exp_pos x).le
  have mono : ∀ a x y : ℝ, a ≤ Real.exp x → x ≤ y → a ≤ Real.exp y :=
    fun a x y h hxy => h.trans (Real.exp_le_exp.2 hxy)
  have powexp : ∀ (a b : ℝ) (k : ℕ), 0 ≤ a → a ≤ Real.exp b →
      a ^ k ≤ Real.exp ((k : ℝ) * b) := by
    intro a b k ha hab
    rw [Real.exp_nat_mul]
    exact pow_le_pow_left₀ ha hab k
  have addexp : ∀ x : ℝ, x + 1 ≤ Real.exp x := Real.add_one_le_exp
  have e1 : (2:ℝ) ≤ Real.exp 1 := by have := Real.exp_one_gt_d9; linarith
  have e2 : (6:ℝ) ≤ Real.exp 2 := by
    have h := Real.exp_one_gt_d9
    have : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
    rw [this]; nlinarith
  have e3 : (12:ℝ) ≤ Real.exp 3 := by
    have : Real.exp 3 = Real.exp 1 * Real.exp 2 := by rw [← Real.exp_add]; norm_num
    rw [this]; nlinarith
  
  obtain ⟨Lm, hLm⟩ : ∃ Lm, Lm = Real.log M := ⟨_, rfl⟩
