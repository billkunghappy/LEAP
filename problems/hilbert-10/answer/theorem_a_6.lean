theorem kai_mf_ideal_theta_sharp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hP : KaiHZPoissonProp) (hF : KaiHZTestFourierProp) : KaiMFIdealThetaSharpProp K :=
