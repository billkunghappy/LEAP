          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * t k : ℝ) : ℂ)))) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * u₂ k : ℝ) : ℂ))) := by
      rw [← MeasureTheory.integral_mul_const]
      have e1 : (∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F (u₁, w) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ))))
          = ∫ w in Set.Icc (0 : Fin b → ℝ) 1, g w := by rw [hg]
      rw [e1, ← h1]
      simp only [h2]
    rw [h3]
    exact hkey _ _ _ (hEE _)
  
  have hH : ∀ u₁ : Fin a → ℝ, ‖∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F (u₁, w) : ℂ) *
      Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ)))‖ ≤ 1 := by
    intro u₁
    apply hbox
    intro t
    beta_reduce
    rw [norm_mul, hEn', mul_one, Complex.norm_real, Real.norm_eq_abs]
