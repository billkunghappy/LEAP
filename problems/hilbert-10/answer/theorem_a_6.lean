                Ideal (NumberField.RingOfIntegers K)) :=
    ⟨{ toFun := fun x => ⟨x.1.1, x.1.2, (hdict x.1.1 x.1.2).mp x.2⟩
       invFun := fun J => ⟨⟨J.1, J.2.1⟩, (hdict J.1 J.2.1).mpr J.2.2⟩
       left_inv := fun x => Subtype.ext (Subtype.ext rfl)
       right_inv := fun J => Subtype.ext rfl }, fun c => rfl⟩
  have hchar : kaiHeckeSeries K (kaiZFPrincipalChar K q) s
      = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
            I ≠ 0 ∧ ∀ P ∈ Pq, ¬ (P ∣ I)},
          G (I : Ideal (NumberField.RingOfIntegers K)) := by
    rw [← hT, tsum_congr hval]
    refine Eq.trans ?_ (Equiv.tsum_eq eT
      (fun I : {I : Ideal (NumberField.RingOfIntegers K) //
