    rw [hT₀_def]; ring
  have hgbd' : gowersU3Pow ω g M ≤ 256 ^ Module.finrank ℚ K *
      (T₀ ^ 8 * (C₄ * (C₃ + 1)) / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4)) :=
    hgbd.trans (mul_le_mul_of_nonneg_left
      (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hκ8 hC₆) hQq.le) (by positivity))
  have hebd' : gowersU3Pow ω e M ≤ 27 ^ Module.finrank ℚ K *
      (T₀ ^ 8 / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4)) :=
    hebd.trans (mul_le_mul_of_nonneg_left hT8 (by positivity))
  calc gowersU3Pow ω (fun x => (-1) * g x + e x) M
      ≤ 128 * (gowersU3Pow ω (fun x => (-1) * g x) M + gowersU3Pow ω e M) := htri
    _ ≤ 128 * (256 ^ Module.finrank ℚ K *
          (T₀ ^ 8 * (C₄ * (C₃ + 1)) / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4)) +
        27 ^ Module.finrank ℚ K * (T₀ ^ 8 / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4))) := by
        rw [hneg]; linarith
    _ = 128 * ((256:ℝ) ^ Module.finrank ℚ K * (C₄ * (C₃ + 1)) + 27 ^ Module.finrank ℚ K)
          * (ρ ^ 8 * C_M ^ (8 * Module.finrank ℚ K)) * Real.log M ^ (8 * Module.finrank ℚ K)
          / (Ideal.absNorm 𝔮 : ℝ) ^ (1/4 : ℝ) := by
        rw [hT₀8]; ring

theorem eventual_loglog_power_le (c A K₁ : ℝ) (Cn : ℕ) (hc : 0 < c) (hA : 0 ≤ A) :
    ∃ M₀ : ℝ, 3 ≤ M₀ ∧ ∀ M : ℝ, M₀ ≤ M →
      (1 + A * Real.log (Real.log M)) ^ Cn + K₁ ≤ Real.log M ^ c :=
by
  obtain ⟨K, hK_def⟩ : ∃ K : ℝ, K = max K₁ 0 := ⟨_, rfl⟩
  have hK0 : 0 ≤ K := by rw [hK_def]; exact le_max_right _ _
  have hK1 : K₁ ≤ K := by rw [hK_def]; exact le_max_left _ _
  obtain ⟨Q, hQ_def⟩ : ∃ Q : ℝ, Q = (1 + A) ^ Cn + K := ⟨_, rfl⟩
  obtain ⟨F, hF_def⟩ : ∃ F : ℝ, F = ((Cn + 1).factorial : ℝ) := ⟨_, rfl⟩
  have hFpos : 0 < F := by rw [hF_def]; exact_mod_cast Nat.factorial_pos _
  have hPpos : 0 < c ^ (Cn + 1) := pow_pos hc _
  obtain ⟨V, hV_def⟩ : ∃ V : ℝ, V = F * Q / c ^ (Cn + 1) := ⟨_, rfl⟩
  obtain ⟨V₁, hV₁_def⟩ : ∃ V₁ : ℝ, V₁ = max 1 V := ⟨_, rfl⟩
  have hV₁1 : 1 ≤ V₁ := by rw [hV₁_def]; exact le_max_left _ _
  have hV₁V : V ≤ V₁ := by rw [hV₁_def]; exact le_max_right _ _
  refine ⟨Real.exp (Real.exp V₁), ?_, ?_⟩
  · have h1 := Real.add_one_le_exp (Real.exp V₁)
    have h2 := Real.add_one_le_exp V₁
    linarith
  intro M hM
  have hM0 : 0 < Real.exp (Real.exp V₁) := Real.exp_pos _
  have hu : Real.exp V₁ ≤ Real.log M := by
    have := Real.log_le_log hM0 hM
    rwa [Real.log_exp] at this
  have hupos : 0 < Real.log M := lt_of_lt_of_le (Real.exp_pos _) hu
  have hv : V₁ ≤ Real.log (Real.log M) := by
    have := Real.log_le_log (Real.exp_pos V₁) hu
    rwa [Real.log_exp] at this
  obtain ⟨v, hv_def⟩ : ∃ v : ℝ, v = Real.log (Real.log M) := ⟨_, rfl⟩
  rw [← hv_def] at hv ⊢
  have hv1 : 1 ≤ v := le_trans hV₁1 hv
  have hv0 : 0 ≤ v := by linarith
  have hVv : V ≤ v := le_trans hV₁V hv
  
  have hR : Real.log M ^ c = Real.exp (c * v) := by
    rw [Real.rpow_def_of_pos hupos, hv_def, mul_comm]
  rw [hR]
  
  have hvn1 : 1 ≤ v ^ Cn := one_le_pow₀ hv1
  have hbase0 : 0 ≤ 1 + A * v := by have := mul_nonneg hA hv0; linarith
  have hbase : 1 + A * v ≤ (1 + A) * v := by nlinarith
  have hpow : (1 + A * v) ^ Cn ≤ (1 + A) ^ Cn * v ^ Cn := by
    rw [← mul_pow]; exact pow_le_pow_left₀ hbase0 hbase Cn
  have hKv : K₁ ≤ K * v ^ Cn := by
    have := mul_le_mul_of_nonneg_left hvn1 hK0
    linarith
  have hs5 : (1 + A * v) ^ Cn + K₁ ≤ Q * v ^ Cn := by
    rw [hQ_def]; nlinarith
  
  have hFQ : F * Q ≤ c ^ (Cn + 1) * v := by
    have := hVv
    rw [hV_def, div_le_iff₀ hPpos] at this
    linarith
  have hs6 : Q * v ^ Cn ≤ (c * v) ^ (Cn + 1) / F := by
    rw [le_div_iff₀ hFpos]
    have h := mul_le_mul_of_nonneg_right hFQ (pow_nonneg hv0 Cn)
    have e1 : (c * v) ^ (Cn + 1) = c ^ (Cn + 1) * v * v ^ Cn := by
      rw [mul_pow, pow_succ v]; ring
    rw [e1]
    linarith [h]
  
  have hs4 : (c * v) ^ (Cn + 1) / F ≤ Real.exp (c * v) := by
    rw [hF_def]
    exact Real.pow_div_factorial_le_exp (c * v) (mul_nonneg hc.le hv0) (Cn + 1)
  linarith

theorem torus_char_integral (b : ℕ) (ζ : Fin b → ℤ) : ∫ w in Set.Icc (0 : Fin b → ℝ) 1, Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ)) = if ζ = 0 then (1 : ℂ) else 0 :=
by
  
  have h1 : ∀ n : ℤ, ∫ t in Set.Icc (0 : ℝ) 1,
      Complex.exp (2 * Real.pi * Complex.I * (((n : ℝ) * t : ℝ) : ℂ))
        = if n = 0 then (1 : ℂ) else 0 := by
    intro n
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one]
    by_cases hn : n = 0
    · subst hn
      simp
    · rw [if_neg hn]
      set c : ℂ := 2 * Real.pi * Complex.I * (n : ℂ) with hc_def
      have hc : c ≠ 0 := by
        refine mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero ?_) Complex.I_ne_zero) ?_
        · exact Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
        · exact Int.cast_ne_zero.mpr hn
      have heq : (fun t : ℝ => Complex.exp (2 * Real.pi * Complex.I * (((n : ℝ) * t : ℝ) : ℂ)))
          = fun t : ℝ => Complex.exp (c * (t : ℂ)) := by
        funext t
        rw [hc_def]
        push_cast
        ring_nf
      rw [heq, integral_exp_mul_complex hc]
      have e1 : Complex.exp (c * ((1 : ℝ) : ℂ)) = 1 := by
        rw [Complex.ofReal_one, mul_one, hc_def]
        have := Complex.exp_int_mul_two_pi_mul_I n
        rw [← this]
        congr 1
        ring
      rw [e1, Complex.ofReal_zero, mul_zero, Complex.exp_zero, sub_self, zero_div]
  
  have h2 : ∀ g : Fin b → ℝ → ℂ, ∫ w in Set.Icc (0 : Fin b → ℝ) 1, ∏ k, g k (w k)
      = ∏ k, ∫ t in Set.Icc (0 : ℝ) 1, g k t := by
    intro g
    have hset : Set.Icc (0 : Fin b → ℝ) 1 = Set.univ.pi (fun _ : Fin b => Set.Icc (0 : ℝ) 1) :=
      (Set.pi_univ_Icc (0 : Fin b → ℝ) 1).symm
    rw [hset, MeasureTheory.volume_pi, MeasureTheory.Measure.restrict_pi_pi]
    exact MeasureTheory.integral_fintype_prod_eq_prod (𝕜 := ℂ) g
  
  have h3 : ∀ w : Fin b → ℝ,
      Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ))
        = ∏ k, Complex.exp (2 * Real.pi * Complex.I * (((ζ k : ℝ) * w k : ℝ) : ℂ)) := by
    intro w
    rw [Complex.ofReal_sum, Finset.mul_sum, Complex.exp_sum]
  simp_rw [h3]
  rw [h2 (fun k t => Complex.exp (2 * Real.pi * Complex.I * (((ζ k : ℝ) * t : ℝ) : ℂ)))]
  simp_rw [h1]
  rw [Finset.prod_ite_zero, Finset.prod_const_one]
  by_cases hz : ζ = 0
  · rw [if_pos hz, if_pos]
    intro k _
    rw [hz]
    rfl
  · rw [if_neg hz, if_neg]
    intro h
    apply hz
    funext k
    exact h k (Finset.mem_univ k)

theorem periodic_box_integral_shift (b : ℕ) (g : (Fin b → ℝ) → ℂ) (hper : ∀ (w : Fin b → ℝ) (n : Fin b → ℤ), g (w + fun k => (n k : ℝ)) = g w) (c : Fin b → ℝ) : ∫ w in Set.Icc (0 : Fin b → ℝ) 1, g (w + c) = ∫ w in Set.Icc (0 : Fin b → ℝ) 1, g w :=
by
  classical
  haveI hcount : Countable ↥(Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin b)))).toAddSubgroup :=
    inferInstanceAs (Countable ↥(Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin b)))))
  have h₀ : MeasureTheory.IsAddFundamentalDomain
      ↥(Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin b)))).toAddSubgroup
      (Set.univ.pi fun _ : Fin b => Set.Ico (0:ℝ) 1) MeasureTheory.volume := by
    have := ZSpan.isAddFundamentalDomain' (Pi.basisFun ℝ (Fin b))
      (MeasureTheory.volume : MeasureTheory.Measure (Fin b → ℝ))
    rwa [ZSpan.fundamentalDomain_pi_basisFun] at this
  have h₁ : MeasureTheory.IsAddFundamentalDomain
      ↥(Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin b)))).toAddSubgroup
      ((fun x : Fin b → ℝ => x + -c) ⁻¹' (Set.univ.pi fun _ : Fin b => Set.Ico (0:ℝ) 1))
      MeasureTheory.volume :=
    h₀.preimage_of_equiv
      (MeasureTheory.measurePreserving_add_right MeasureTheory.volume (-c)).quasiMeasurePreserving
      Function.bijective_id (fun v x => add_assoc (v : Fin b → ℝ) x (-c))
  have hinv : ∀ (v : ↥(Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin b)))).toAddSubgroup)
      (x : Fin b → ℝ), g (v +ᵥ x) = g x := by
    intro v x
    have hv : (v : Fin b → ℝ) ∈ Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin b))) := v.2
    rw [Module.Basis.mem_span_iff_repr_mem] at hv
    have hex : ∀ i, ∃ m : ℤ, (m : ℝ) = (v : Fin b → ℝ) i := by
      intro i
      obtain ⟨m, hm⟩ := hv i
      refine ⟨m, ?_⟩
      rw [Pi.basisFun_repr] at hm
      simpa using hm
    choose n hn using hex
    have hvn : (v : Fin b → ℝ) = fun k => (n k : ℝ) := funext fun k => (hn k).symm
    show g ((v : Fin b → ℝ) + x) = g x
    rw [hvn, add_comm]
    exact hper x n
  have hae : (Set.univ.pi fun _ : Fin b => Set.Ico (0:ℝ) 1)
      =ᵐ[MeasureTheory.volume] Set.Icc (0 : Fin b → ℝ) 1 := by
    have := MeasureTheory.Measure.univ_pi_Ico_ae_eq_Icc
      (μ := fun _ : Fin b => (MeasureTheory.volume : MeasureTheory.Measure ℝ))
      (f := (0 : Fin b → ℝ)) (g := 1)
    simpa only [Pi.zero_apply, Pi.one_apply] using this
  have hpre : (fun w : Fin b → ℝ => w + c) ⁻¹'
      ((fun x : Fin b → ℝ => x + -c) ⁻¹' (Set.univ.pi fun _ : Fin b => Set.Ico (0:ℝ) 1))
      = Set.univ.pi fun _ : Fin b => Set.Ico (0:ℝ) 1 := by
    ext w
    simp [add_neg_cancel_right]
  have hcv := (MeasureTheory.measurePreserving_add_right MeasureTheory.volume c).setIntegral_preimage_emb
    (measurableEmbedding_addRight c) g
    ((fun x : Fin b → ℝ => x + -c) ⁻¹' (Set.univ.pi fun _ : Fin b => Set.Ico (0:ℝ) 1))
  rw [hpre] at hcv
  rw [← MeasureTheory.setIntegral_congr_set hae, ← MeasureTheory.setIntegral_congr_set hae]
  rw [hcv]
  exact h₁.setIntegral_eq h₀ hinv

theorem nil2_slice_props (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (Q : ℝ) (hQ : 2 ≤ Q) (F : (Fin a → ℝ) × (Fin b → ℝ) → ℝ) (hF1 : ∀ u, |F u| ≤ 1) (hinv : ∀ u (γ₁ : Fin a → ℤ) (γ₂ : Fin b → ℤ), F (nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))) = F u) (hlip : ∀ u v : (Fin a → ℝ) × (Fin b → ℝ), (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ k, -1 ≤ u.2 k ∧ u.2 k ≤ 2) → (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, -1 ≤ v.2 k ∧ v.2 k ≤ 2) → |F u - F v| ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|)) : (∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (n : Fin b → ℤ), F (u₁, w + fun k => (n k : ℝ)) = F (u₁, w)) ∧ (∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (γ₁ : Fin a → ℤ), F ((fun i => u₁ i + (γ₁ i : ℝ)), (fun k => w k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ))) = F (u₁, w)) ∧ (∀ u v : (Fin a → ℝ) × (Fin b → ℝ), (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, |u.2 k - v.2 k| ≤ 1) → |F u - F v| ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|)) ∧ (∀ (u₁ : Fin a → ℝ) (w w' : Fin b → ℝ), |F (u₁, w) - F (u₁, w')| ≤ Q * ∑ k, |w k - w' k|) :=
by
  have h1 : ∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (n : Fin b → ℤ),
      F (u₁, w + fun k => (n k : ℝ)) = F (u₁, w) := by
    intro u₁ w n
    have h := hinv (u₁, w) 0 n
    rw [← h]
    congr 1
    refine Prod.ext ?_ ?_
    · funext i; simp [nil2Mul]
    · funext k; simp [nil2Mul]
  have h2 : ∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (γ₁ : Fin a → ℤ),
      F ((fun i => u₁ i + (γ₁ i : ℝ)),
        (fun k => w k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ))) = F (u₁, w) := by
    intro u₁ w γ₁
    have h := hinv (u₁, w) γ₁ 0
    rw [← h]
    congr 1
    refine Prod.ext ?_ ?_
    · funext i; simp [nil2Mul]
    · funext k; simp [nil2Mul]
  have h3 : ∀ u v : (Fin a → ℝ) × (Fin b → ℝ), (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) →
      (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, |u.2 k - v.2 k| ≤ 1) →
      |F u - F v| ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|) := by
    rintro ⟨u₁, u₂⟩ ⟨v₁, v₂⟩ hu hv hd
    simp only at hu hv hd ⊢
    obtain ⟨n, hn⟩ : ∃ n : Fin b → ℤ, n = fun k => -⌊min (u₂ k) (v₂ k)⌋ := ⟨_, rfl⟩
    have hbd : ∀ k, (-1 ≤ u₂ k + (n k : ℝ) ∧ u₂ k + (n k : ℝ) ≤ 2) ∧
        (-1 ≤ v₂ k + (n k : ℝ) ∧ v₂ k + (n k : ℝ) ≤ 2) := by
      intro k
      have hfl := Int.floor_le (min (u₂ k) (v₂ k))
      have hlt := Int.lt_floor_add_one (min (u₂ k) (v₂ k))
      have hnk : (n k : ℝ) = -((⌊min (u₂ k) (v₂ k)⌋ : ℤ) : ℝ) := by
        rw [hn]; push_cast; rfl
      have hdk := abs_le.mp (hd k)
      rw [hnk]
      have hm1 := min_le_left (u₂ k) (v₂ k)
      have hm2 := min_le_right (u₂ k) (v₂ k)
      have hm3 : u₂ k ≤ min (u₂ k) (v₂ k) + 1 ∧ v₂ k ≤ min (u₂ k) (v₂ k) + 1 := by
        rcases le_total (u₂ k) (v₂ k) with h | h
        · rw [min_eq_left h]; constructor <;> linarith [hdk.1, hdk.2]
        · rw [min_eq_right h]; constructor <;> linarith [hdk.1, hdk.2]
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith [hm3.1, hm3.2]
    have hu' := h1 u₁ u₂ n
    have hv' := h1 v₁ v₂ n
    rw [← hu', ← hv']
    have key := hlip (u₁, u₂ + fun k => (n k : ℝ)) (v₁, v₂ + fun k => (n k : ℝ)) hu
      (fun k => (hbd k).1) hv (fun k => (hbd k).2)
    simpa only [Pi.add_apply, add_sub_add_right_eq_sub] using key
  have h4 : ∀ (u₁ : Fin a → ℝ) (w w' : Fin b → ℝ),
      |F (u₁, w) - F (u₁, w')| ≤ Q * ∑ k, |w k - w' k| := by
    intro u₁ w w'
    by_cases hbig : ∃ k, 1 < |w k - w' k|
    · obtain ⟨k₀, hk₀⟩ := hbig
      have hs : |w k₀ - w' k₀| ≤ ∑ k, |w k - w' k| :=
        Finset.single_le_sum (f := fun k => |w k - w' k|) (fun k _ => abs_nonneg _)
          (Finset.mem_univ k₀)
      have htri : |F (u₁, w) - F (u₁, w')| ≤ |F (u₁, w)| + |F (u₁, w')| := abs_sub _ _
      have hA := hF1 (u₁, w)
      have hB := hF1 (u₁, w')
      have hs1 : 1 < ∑ k, |w k - w' k| := lt_of_lt_of_le hk₀ hs
      have hQs : 2 * (∑ k, |w k - w' k|) ≤ Q * ∑ k, |w k - w' k| :=
        mul_le_mul_of_nonneg_right hQ (by linarith)
      linarith
    · push_neg at hbig
      obtain ⟨γ₁, hγ⟩ : ∃ γ₁ : Fin a → ℤ, γ₁ = fun i => -⌊u₁ i⌋ := ⟨_, rfl⟩
      have e1 := h2 u₁ w γ₁
      have e2 := h2 u₁ w' γ₁
      rw [← e1, ← e2]
      have hx : ∀ i, -1 ≤ u₁ i + (γ₁ i : ℝ) ∧ u₁ i + (γ₁ i : ℝ) ≤ 2 := by
        intro i
        have hfl := Int.floor_le (u₁ i)
        have hlt := Int.lt_floor_add_one (u₁ i)
        have hgi : (γ₁ i : ℝ) = -((⌊u₁ i⌋ : ℤ) : ℝ) := by rw [hγ]; push_cast; rfl
        rw [hgi]; constructor <;> linarith
      have key := h3
        ((fun i => u₁ i + (γ₁ i : ℝ)),
          (fun k => w k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ)))
        ((fun i => u₁ i + (γ₁ i : ℝ)),
          (fun k => w' k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ)))
        hx hx (fun k => by
          show |(w k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ)) -
            (w' k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ))| ≤ 1
          rw [add_sub_add_right_eq_sub]; exact hbig k)
      simpa only [sub_self, abs_zero, Finset.sum_const_zero, zero_add,
        add_sub_add_right_eq_sub] using key
  exact ⟨h1, h2, h3, h4⟩

theorem box_kernel_integral_expand (b R : ℕ) (f : (Fin b → ℝ) → ℝ) (hf : Continuous f) (x : Fin b → ℝ) : (((∫ w in Set.Icc (0 : Fin b → ℝ) 1, f w * ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (x k - w k) : ℝ) : ℂ))‖ ^ 2 : ℝ)) : ℂ) = ∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), ∑ m' ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), Complex.exp (2 * Real.pi * Complex.I * ((∑ k, ((m k : ℝ) - (m' k : ℝ)) * x k : ℝ) : ℂ)) * ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (f w : ℂ) * Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, ((m k : ℝ) - (m' k : ℝ)) * w k : ℝ) : ℂ))) :=
by
  classical
  have hconj : ∀ t : ℝ, (starRingEnd ℂ) (Complex.exp (2 * Real.pi * Complex.I * (t : ℂ)))
      = Complex.exp (-(2 * Real.pi * Complex.I * (t : ℂ))) := by
    intro t
    rw [← Complex.exp_conj]
    congr 1
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
    ring
  have hpt : ∀ w : Fin b → ℝ,
      (((f w * ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R),
          Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (x k - w k) : ℝ) : ℂ))‖ ^ 2
          : ℝ)) : ℂ)
