        · intro k
          by_cases hk : k = l
          · simp [hk, hhi, h0]
          · simp [hhi, Function.update_apply, hk, (h k hk).2]
    have hYcard : ((Finset.Icc lo hi).card : ℝ) = ((2 * N + 1 : ℕ) : ℝ) ^ (ν - 1) := by
      rw [Pi.card_Icc]
      have hfac : ∀ k, (Finset.Icc (lo k) (hi k)).card
