    ext a
    simp only [Finset.mem_filter, hP]
  have hE6 : ∀ S ⊆ U, |((Z₁.filter (fun z => S ⊆ Bz z)).card : ℝ)
      - V * ((kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d)|
      ≤ C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1) := by
    intro S hS
    have h := hcount (∏ p ∈ S, p) (hq1 S hS) (P S) (hper S hS) N Ω Z₁ hΩm hΩc hΩbox hZ₁
    rw [← hV] at h
    have e1 : Z₁.filter (fun z => S ⊆ Bz z) = Z₁.filter (P S) :=
      Finset.filter_congr (fun z _ => hsub S hS z)
    rw [e1, hy S, ← mul_div_assoc]
    exact h
  obtain ⟨hCC_eq, hLD_eq⟩ := hs6 c₀ c m N Ω Z₁ hZ₁ Bz hBmem
  have hbonfZ := hs4 Z₁ U Bz (fun z _ => hBU z) r
  rw [← hCC_eq] at hbonfZ
  have hbonfR := hs4 (resBox d (primorial m)) U Bz (fun z _ => hBU z) r
  have hWpos : (0 : ℝ) < ((primorial m : ℕ) : ℝ) ^ d := pow_pos (by exact_mod_cast hW1) d
  have hlift : ∀ S ⊆ U,
      (((resBox d (primorial m)).filter (fun z => S ⊆ Bz z)).card : ℝ)
          / ((primorial m : ℕ) : ℝ) ^ d
        = (kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d := by
    intro S hS
    have hqpos : (0 : ℝ) < ((∏ p ∈ S, p : ℕ) : ℝ) ^ d :=
      pow_pos (by exact_mod_cast hq1 S hS) d
    have e1 : (resBox d (primorial m)).filter (fun z => S ⊆ Bz z)
        = (resBox d (primorial m)).filter (P S) :=
      Finset.filter_congr (fun z _ => hsub S hS z)
    have h3 := hs3 (∏ p ∈ S, p) (primorial m) (hq1 S hS) hW1
      (hqW S hS) (P S) (hper S hS)
    rw [e1, hy S, div_eq_div_iff hWpos.ne' hqpos.ne']
    exact h3
  have hmemA : ∀ S ∈ U.powerset.filter (fun S => S.card ≤ r), S ⊆ U :=
    fun S hS => Finset.mem_powerset.1 (Finset.mem_filter.1 hS).1
  have hmemB : ∀ S ∈ U.powerset.filter (fun S => S.card = r + 1), S ⊆ U :=
    fun S hS => Finset.mem_powerset.1 (Finset.mem_filter.1 hS).1
  have hLD : |localDensity (primorial m) c₀ c
      - ∑ S ∈ U.powerset.filter (fun S => S.card ≤ r), (-1 : ℝ) ^ S.card *
          ((kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d)|
      ≤ ∑ S ∈ U.powerset.filter (fun S => S.card = r + 1),
          (kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d := by
    have eA : ∑ S ∈ U.powerset.filter (fun S => S.card ≤ r), (-1 : ℝ) ^ S.card *
          ((kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d)
        = (∑ S ∈ U.powerset.filter (fun S => S.card ≤ r), (-1 : ℝ) ^ S.card *
          (((resBox d (primorial m)).filter (fun z => S ⊆ Bz z)).card : ℝ))
            / ((primorial m : ℕ) : ℝ) ^ d := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro S hS
      rw [← hlift S (hmemA S hS), mul_div_assoc]
    have eB : ∑ S ∈ U.powerset.filter (fun S => S.card = r + 1),
          (kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d
        = (∑ S ∈ U.powerset.filter (fun S => S.card = r + 1),
          (((resBox d (primorial m)).filter (fun z => S ⊆ Bz z)).card : ℝ))
            / ((primorial m : ℕ) : ℝ) ^ d := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro S hS
      rw [← hlift S (hmemB S hS)]
    rw [hLD_eq, eA, eB, ← sub_div, abs_div, abs_of_pos hWpos]
    exact div_le_div_of_nonneg_right hbonfR hWpos.le
  have hε : ∀ S ∈ U.powerset.filter (fun S => S.card ≤ r), |(-1 : ℝ) ^ S.card| ≤ 1 := by
    intro S _
    rw [abs_pow, abs_neg, abs_one, one_pow]
  have hfin := hs5 (U.powerset.filter (fun S => S.card ≤ r))
    (U.powerset.filter (fun S => S.card = r + 1))
    (fun S => (-1 : ℝ) ^ S.card) (fun S => ((Z₁.filter (fun z => S ⊆ Bz z)).card : ℝ))
    (fun S => (kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d)
    (fun S => C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1))
    (coprimeCount (primorial m) c₀ c Ω N) (localDensity (primorial m) c₀ c) V hV0 hε
    hbonfZ hLD (fun S hS => hE6 S (hmemA S hS)) (fun S hS => hE6 S (hmemB S hS))
  have f1 : (U.powerset.filter (fun S => S.card ≤ r + 1)).filter (fun S => S.card ≤ r)
      = U.powerset.filter (fun S => S.card ≤ r) := by
    ext S
    simp only [Finset.mem_filter]
    exact ⟨fun ⟨⟨a, _⟩, b⟩ => ⟨a, b⟩, fun ⟨a, b⟩ => ⟨⟨a, by omega⟩, b⟩⟩
  have f2 : (U.powerset.filter (fun S => S.card ≤ r + 1)).filter (fun S => ¬ S.card ≤ r)
      = U.powerset.filter (fun S => S.card = r + 1) := by
    ext S
    simp only [Finset.mem_filter]
    exact ⟨fun ⟨⟨a, _⟩, c⟩ => ⟨a, by omega⟩, fun ⟨a, b⟩ => ⟨⟨a, by omega⟩, by omega⟩⟩
  have hsplit : ∑ S ∈ U.powerset.filter (fun S => S.card ≤ r + 1),
        C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1)
      = (∑ S ∈ U.powerset.filter (fun S => S.card ≤ r),
          C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1))
        + ∑ S ∈ U.powerset.filter (fun S => S.card = r + 1),
          C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1) := by
    rw [← Finset.sum_filter_add_sum_filter_not
      (U.powerset.filter (fun S => S.card ≤ r + 1)) (fun S => S.card ≤ r), f1, f2]
  rw [hsplit]
  exact hfin

theorem kai_local_bad_density_bound (K : Type u) [Field K] [NumberField K] (d : ℕ) (hd : 1 ≤ d)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) (m : ℕ) :
    (∀ z : Fin d → ℤ, ¬ ∀ i : Fin 4, CoprimeToNat (primorial m) (affEval (c₀ i) (c i) z)) ∨
    ∀ S ⊆ (Finset.range (m + 1)).filter Nat.Prime,
      kaiBadResidueCount S c₀ c ≤ ∏ p ∈ S, 4 * Module.finrank ℚ K * p ^ (d - 1) :=
by
  classical
  by_cases hex : ∃ z : Fin d → ℤ, ∀ i : Fin 4,
      CoprimeToNat (primorial m) (affEval (c₀ i) (c i) z)
  swap
  · exact Or.inl (fun z hz => hex ⟨z, hz⟩)
  obtain ⟨z, hz⟩ := hex
  right
  intro S hS
  have hSprime : ∀ p ∈ S, p.Prime := fun p hp => (Finset.mem_filter.1 (hS hp)).2
  
  have hmemBox : ∀ (W : ℕ) (a : Fin d → ℤ),
      a ∈ resBox d W ↔ ∀ k, 0 ≤ a k ∧ a k ≤ (W : ℤ) - 1 := by
    intro W a
    simp only [resBox, Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h k => ⟨h.1 k, h.2 k⟩, fun h => ⟨fun k => (h k).1, fun k => (h k).2⟩⟩
  
  have hdiff : ∀ (a₀ : NumberField.RingOfIntegers K) (b : Fin d → NumberField.RingOfIntegers K)
      (x y : Fin d → ℤ), affEval a₀ b x - affEval a₀ b y
        = ∑ k, ((x k - y k : ℤ) : NumberField.RingOfIntegers K) * b k := by
    intro a₀ b x y
    simp only [affEval, add_sub_add_left_eq_sub, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [← sub_smul, zsmul_eq_mul]
  
  have hG2 : ∀ p ∈ S, ∀ i : Fin 4, CoprimeToNat p (affEval (c₀ i) (c i) z) := by
    intro p hp i 𝔭 hp𝔭
    apply hz i 𝔭
    have hdvd : p ∣ primorial m := by
      unfold primorial
      exact Finset.dvd_prod_of_mem (fun q => q) (hS hp)
    obtain ⟨r, hr⟩ := hdvd
    rw [hr, Nat.cast_mul]
    exact 𝔭.asIdeal.mul_mem_right _ hp𝔭
  
  have hper : ∀ (p : ℕ) (i : Fin 4) (x y : Fin d → ℤ), (∀ k, (p : ℤ) ∣ x k - y k) →
      (CoprimeToNat p (affEval (c₀ i) (c i) x) ↔ CoprimeToNat p (affEval (c₀ i) (c i) y)) := by
    intro p i x y hxy
    have key : ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal →
        (affEval (c₀ i) (c i) x ∈ 𝔭.asIdeal ↔ affEval (c₀ i) (c i) y ∈ 𝔭.asIdeal) := by
      intro 𝔭 hp𝔭
      have hD : affEval (c₀ i) (c i) x - affEval (c₀ i) (c i) y ∈ 𝔭.asIdeal := by
        rw [hdiff]
        refine Ideal.sum_mem _ (fun k _ => ?_)
        obtain ⟨t, ht⟩ := hxy k
        rw [ht, Int.cast_mul, Int.cast_natCast, mul_assoc]
        exact 𝔭.asIdeal.mul_mem_right _ hp𝔭
      constructor
      · intro hx
        have := 𝔭.asIdeal.sub_mem hx hD
        rwa [sub_sub_cancel] at this
      · intro hy
        have := 𝔭.asIdeal.add_mem hD hy
        rwa [sub_add_cancel] at this
    unfold CoprimeToNat
    exact forall_congr' (fun 𝔭 => imp_congr_right (fun h => not_congr (key 𝔭 h)))
  
  have hs2 : ∀ (p : ℕ), p.Prime → ∀ (P : Ideal (NumberField.RingOfIntegers K)), P.IsPrime →
      ((p : ℕ) : NumberField.RingOfIntegers K) ∈ P →
      ∀ (a₀ : NumberField.RingOfIntegers K) (b : Fin d → NumberField.RingOfIntegers K),
      affEval a₀ b z ∉ P →
      ((resBox d p).filter (fun a => affEval a₀ b a ∈ P)).card ≤ p ^ (d - 1) := by
    intro p hp P hP hpP a₀ b hz₀
    by_cases hall : ∀ k, b k ∈ P
    · have hempty : (resBox d p).filter (fun a => affEval a₀ b a ∈ P) = ∅ := by
        apply Finset.filter_false_of_mem
        intro a _ ha
        apply hz₀
        have h1 : affEval a₀ b a - affEval a₀ b z ∈ P := by
          rw [hdiff]
          exact Ideal.sum_mem _ (fun k _ => P.mul_mem_left _ (hall k))
        have := P.sub_mem ha h1
        rwa [sub_sub_cancel] at this
      rw [hempty, Finset.card_empty]
      exact Nat.zero_le _
    · push_neg at hall
      obtain ⟨k₀, hk₀⟩ := hall
      have hint : ∀ t : ℤ, ((t : ℤ) : NumberField.RingOfIntegers K) ∈ P → (p : ℤ) ∣ t := by
        intro t ht
        by_contra hnd
        have hnd' : ¬ p ∣ t.natAbs := fun h => hnd (Int.natCast_dvd.2 h)
        have hc : Nat.Coprime p t.natAbs := (Nat.Prime.coprime_iff_not_dvd hp).2 hnd'
        have hcop : IsCoprime (p : ℤ) t := Int.isCoprime_iff_gcd_eq_one.2 hc
        obtain ⟨u', v', huv⟩ := hcop.intCast (R := NumberField.RingOfIntegers K)
        apply hP.ne_top
        rw [Ideal.eq_top_iff_one, ← huv]
        refine P.add_mem (P.mul_mem_left _ ?_) (P.mul_mem_left _ ht)
        rw [Int.cast_natCast]; exact hpP
      have hcard : (Fintype.piFinset (fun _ : {j : Fin d // j ≠ k₀} =>
          Finset.Icc (0 : ℤ) ((p : ℤ) - 1))).card = p ^ (d - 1) := by
        rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Int.card_Icc]
        simp
      rw [← hcard]
      apply Finset.card_le_card_of_injOn (fun a (j : {j : Fin d // j ≠ k₀}) => a j)
      · intro a ha
        rw [Finset.mem_coe, Finset.mem_filter, hmemBox] at ha
        rw [Finset.mem_coe, Fintype.mem_piFinset]
        intro j
        rw [Finset.mem_Icc]
        exact ha.1 j
      · intro a ha a' ha' hga
        rw [Finset.mem_coe, Finset.mem_filter, hmemBox] at ha ha'
        have hoff : ∀ j, j ≠ k₀ → a j = a' j := fun j hj => congrFun hga ⟨j, hj⟩
        have hsum : affEval a₀ b a - affEval a₀ b a'
            = ((a k₀ - a' k₀ : ℤ) : NumberField.RingOfIntegers K) * b k₀ := by
          rw [hdiff]
          refine Finset.sum_eq_single k₀ (fun j _ hj => ?_)
            (fun h => absurd (Finset.mem_univ k₀) h)
          rw [hoff j hj, sub_self, Int.cast_zero, zero_mul]
        have hmem : ((a k₀ - a' k₀ : ℤ) : NumberField.RingOfIntegers K) * b k₀ ∈ P := by
          rw [← hsum]; exact P.sub_mem ha.2 ha'.2
        have ht : ((a k₀ - a' k₀ : ℤ) : NumberField.RingOfIntegers K) ∈ P :=
          (hP.mem_or_mem hmem).resolve_right hk₀
        have hdvd := hint _ ht
        have habs : |a k₀ - a' k₀| < (p : ℤ) := by
          rw [abs_sub_lt_iff]
          constructor <;> linarith [(ha.1 k₀).1, (ha.1 k₀).2, (ha'.1 k₀).1, (ha'.1 k₀).2]
        have h0 := Int.eq_zero_of_abs_lt_dvd hdvd habs
        funext j
        by_cases hj : j = k₀
        · subst hj; linarith
        · exact hoff j hj
  
  have hs3 : ∀ p : ℕ, p.Prime → ∃ F : Finset (Ideal (NumberField.RingOfIntegers K)),
      F.card ≤ Module.finrank ℚ K ∧
      ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal → 𝔭.asIdeal ∈ F := by
    intro p hp
    haveI : Fact p.Prime := ⟨hp⟩
    have hne : Ideal.span {(p : ℤ)} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact_mod_cast hp.ne_zero
    refine ⟨primesOverFinset (Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers K),
      Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers K) ℚ K hne, ?_⟩
    intro 𝔭 hp𝔭
    have hle : Ideal.span {(p : ℤ)}
        ≤ Ideal.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) 𝔭.asIdeal := by
      rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      simpa using hp𝔭
    have hlies : Ideal.span {(p : ℤ)} = Ideal.under ℤ 𝔭.asIdeal :=
      (Int.ideal_span_isMaximal_of_prime p).eq_of_le
        (Ideal.comap_ne_top _ 𝔭.isPrime.ne_top) hle
    have hmem : 𝔭.asIdeal ∈ (Ideal.span {(p : ℤ)}).primesOver (NumberField.RingOfIntegers K) :=
      ⟨𝔭.isPrime, (Ideal.liesOver_iff _ _).2 hlies⟩
    first
    | exact (Ideal.mem_primesOverFinset_iff hne _).2 hmem
    | exact (mem_primesOverFinset_iff hne _).2 hmem
  
  have hBad : ∀ p ∈ S, ((resBox d p).filter (fun a =>
      ∃ i : Fin 4, ¬ CoprimeToNat p (affEval (c₀ i) (c i) a))).card
        ≤ 4 * Module.finrank ℚ K * p ^ (d - 1) := by
    intro p hpS
    have hp := hSprime p hpS
    obtain ⟨F, hFc, hF⟩ := hs3 p hp
    have hF'c : (F.filter (fun P => ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K), 𝔭.asIdeal = P ∧
          ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal)).card
        ≤ Module.finrank ℚ K := (Finset.card_filter_le _ _).trans hFc
    have hsub : (resBox d p).filter (fun a =>
        ∃ i : Fin 4, ¬ CoprimeToNat p (affEval (c₀ i) (c i) a))
        ⊆ (Finset.univ : Finset (Fin 4)).biUnion (fun i =>
          (F.filter (fun P => ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum
            (NumberField.RingOfIntegers K), 𝔭.asIdeal = P ∧
              ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal)).biUnion
            (fun P => (resBox d p).filter (fun a => affEval (c₀ i) (c i) a ∈ P))) := by
      intro a ha
      rw [Finset.mem_filter] at ha
      obtain ⟨i, hi⟩ := ha.2
      unfold CoprimeToNat at hi
      push_neg at hi
      obtain ⟨𝔭, hp𝔭, hψ⟩ := hi
      rw [Finset.mem_biUnion]
      refine ⟨i, Finset.mem_univ _, ?_⟩
      rw [Finset.mem_biUnion]
      exact ⟨𝔭.asIdeal, Finset.mem_filter.2 ⟨hF 𝔭 hp𝔭, 𝔭, rfl, hp𝔭⟩,
        Finset.mem_filter.2 ⟨ha.1, hψ⟩⟩
    have hpiece : ∀ i : Fin 4, ∀ P ∈ F.filter (fun P => ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K), 𝔭.asIdeal = P ∧
          ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal),
        ((resBox d p).filter (fun a => affEval (c₀ i) (c i) a ∈ P)).card ≤ p ^ (d - 1) := by
      intro i P hP
      obtain ⟨-, 𝔭, rfl, hp𝔭⟩ := Finset.mem_filter.1 hP
      exact hs2 p hp 𝔭.asIdeal 𝔭.isPrime hp𝔭 (c₀ i) (c i) (hG2 p hpS i 𝔭 hp𝔭)
    refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans ?_)
    refine (Finset.sum_le_sum (fun i _ => Finset.card_biUnion_le.trans
      (Finset.sum_le_sum (fun P hP => hpiece i P hP)))).trans ?_
    rw [Finset.sum_const, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul,
      smul_eq_mul]
    calc 4 * ((F.filter _).card * p ^ (d - 1))
        ≤ 4 * (Module.finrank ℚ K * p ^ (d - 1)) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hF'c)
      _ = 4 * Module.finrank ℚ K * p ^ (d - 1) := by ring
  
  unfold kaiBadResidueCount
  calc _ ≤ (S.pi (fun p => (resBox d p).filter (fun a =>
          ∃ i : Fin 4, ¬ CoprimeToNat p (affEval (c₀ i) (c i) a)))).card := by
        apply Finset.card_le_card_of_injOn (fun a p (_ : p ∈ S) k => a k % (p : ℤ))
        · intro a ha
          rw [Finset.mem_coe, Finset.mem_filter] at ha
          rw [Finset.mem_coe, Finset.mem_pi]
          intro p hp
          dsimp only
          have hp0 : (0 : ℤ) < p := by exact_mod_cast (hSprime p hp).pos
          rw [Finset.mem_filter, hmemBox]
          refine ⟨fun k => ⟨Int.emod_nonneg _ hp0.ne', ?_⟩, ?_⟩
          · have := Int.emod_lt_of_pos (a k) hp0
            omega
          · obtain ⟨i, hi⟩ := ha.2 p hp
            exact ⟨i, fun hc => hi ((hper p i (fun k => a k % (p : ℤ)) a
              (fun k => (Int.mod_modEq (a k) p).symm.dvd)).1 hc)⟩
        · intro a ha a' ha' heq
          rw [Finset.mem_coe, Finset.mem_filter, hmemBox] at ha ha'
          funext k
          have hdvd : ∀ p ∈ S, (p : ℤ) ∣ a' k - a k := by
            intro p hp
            have h1 : a k % (p : ℤ) = a' k % (p : ℤ) :=
              congrFun (congrFun (congrFun heq p) hp) k
            exact Int.ModEq.dvd h1
          have hcop : (S : Set ℕ).Pairwise
              (Function.onFun IsCoprime (fun p : ℕ => (p : ℤ))) := by
            intro p hp p' hp' hne
            exact Nat.isCoprime_iff_coprime.2
              ((Nat.coprime_primes (hSprime p hp) (hSprime p' hp')).2 hne)
          have hq := Finset.prod_dvd_of_coprime hcop hdvd
          rw [← Nat.cast_prod] at hq
          have habs : |a' k - a k| < ((∏ p ∈ S, p : ℕ) : ℤ) := by
            rw [abs_sub_lt_iff]
            constructor <;> linarith [(ha.1 k).1, (ha.1 k).2, (ha'.1 k).1, (ha'.1 k).2]
          have := Int.eq_zero_of_abs_lt_dvd hq habs
          linarith
    _ = ∏ p ∈ S, ((resBox d p).filter (fun a =>
          ∃ i : Fin 4, ¬ CoprimeToNat p (affEval (c₀ i) (c i) a))).card := Finset.card_pi _ _
    _ ≤ ∏ p ∈ S, 4 * Module.finrank ℚ K * p ^ (d - 1) :=
        Finset.prod_le_prod (fun _ _ => Nat.zero_le _) hBad

theorem kai_sieve_large_modulus (K : Type u) [Field K] [NumberField K] (d : ℕ) (hd : 1 ≤ d)
    (A : ℕ) :
    ∃ C_s : ℝ, 0 ≤ C_s ∧
      ∀ (c₀ : Fin 4 → NumberField.RingOfIntegers K)
        (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) (N m : ℕ) (Ω : Set (Fin d → ℝ)),
        3 ≤ N → (m : ℝ) ≤ Real.exp (Real.log (N : ℝ) ^ ((1:ℝ)/3)) →
        MeasurableSet Ω → Convex ℝ Ω → Ω ⊆ realBox d (N : ℝ) →
        |coprimeCount (primorial m) c₀ c Ω N
            - (MeasureTheory.volume Ω).toReal * localDensity (primorial m) c₀ c|
          ≤ C_s * (N : ℝ) ^ d / Real.log (N : ℝ) ^ A :=
by
  classical
  obtain ⟨C, hC0, hs1⟩ := kai_sieve_bonferroni_bound K d hd
  obtain ⟨n, hn_def⟩ : ∃ n : ℕ, n = Module.finrank ℚ K := ⟨_, rfl⟩
  have hn : 1 ≤ n := by rw [hn_def]; exact Module.finrank_pos
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  obtain ⟨κ, hκ_def⟩ : ∃ κ : ℝ, κ = 8 * Real.exp 1 * n + 3 * A := ⟨_, rfl⟩
  obtain ⟨κ₂, hκ₂_def⟩ : ∃ κ₂ : ℝ, κ₂ = ((d : ℝ) + 2) * (κ + 1) + 3 * A := ⟨_, rfl⟩
  have he0 : 0 < Real.exp 1 := Real.exp_pos 1
  have hκ0 : 0 ≤ κ := by rw [hκ_def]; positivity
  have hκ8 : 8 * Real.exp 1 ≤ κ := by
    rw [hκ_def]
    have h1 : 8 * Real.exp 1 * 1 ≤ 8 * Real.exp 1 * n := mul_le_mul_of_nonneg_left hn1 (by positivity)
    have h2 : (0 : ℝ) ≤ 3 * A := by positivity
    linarith
  have hκ₂0 : 0 < κ₂ := by rw [hκ₂_def]; positivity
  
  have rankin : ∀ (U : Finset ℕ) (x : ℕ → ℝ), (∀ p ∈ U, 0 ≤ x p) → ∀ μ : ℝ, 0 ≤ μ →
      ∑ S ∈ U.powerset, μ ^ S.card * ∏ p ∈ S, x p ≤ Real.exp (μ * ∑ p ∈ U, x p) := by
    intro U x hx μ hμ
    have h1 : ∀ S ∈ U.powerset, μ ^ S.card * ∏ p ∈ S, x p = ∏ p ∈ S, (μ * x p) := by
      intro S _
      rw [Finset.prod_mul_distrib, Finset.prod_const]
    rw [Finset.sum_congr rfl h1, ← Finset.prod_one_add, Finset.mul_sum, Real.exp_sum]
    apply Finset.prod_le_prod
    · intro p hp
      have := hx p hp
      positivity
    · intro p _
      rw [add_comm]
      exact Real.add_one_le_exp _
  
  have recip : ∀ m : ℕ, ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 : ℝ) / p
      ≤ 1 + Real.log (m : ℝ) := by
    intro m
    calc ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 : ℝ) / p
        ≤ ∑ k ∈ Finset.range (m + 1), (1 : ℝ) / k :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun k _ _ => by positivity)
      _ = (harmonic m : ℝ) := by
          rw [Finset.sum_range_succ', harmonic]
          push_cast
          simp
      _ ≤ 1 + Real.log (m : ℝ) := harmonic_le_one_add_log m
  have hC_s : 0 ≤ 3 ^ d * κ₂ ^ (3 * A) + Real.exp 1 * 3 ^ (d - 1) * C + 2 ^ (d + 1) := by
    positivity
  refine ⟨3 ^ d * κ₂ ^ (3 * A) + Real.exp 1 * 3 ^ (d - 1) * C + 2 ^ (d + 1), hC_s, ?_⟩
  intro c₀ c N m Ω hN hm hΩm hΩc hΩbox
  obtain ⟨V, hV_def⟩ : ∃ V : ℝ, V = (MeasureTheory.volume Ω).toReal := ⟨_, rfl⟩
  rw [← hV_def]
  obtain ⟨ℓ, hℓ_def⟩ : ∃ ℓ : ℝ, ℓ = Real.log (N : ℝ) := ⟨_, rfl⟩
  rw [← hℓ_def] at hm ⊢
  have hN3 : (3 : ℝ) ≤ N := by exact_mod_cast hN
  have hNpos : (0 : ℝ) < N := by linarith
  have hN1 : (1 : ℝ) ≤ N := by linarith
  have hℓ1 : 1 < ℓ := by
    rw [hℓ_def, Real.lt_log_iff_exp_lt hNpos]
    have := Real.exp_one_lt_d9
    linarith
  have hℓpos : 0 < ℓ := by linarith
  have hexpℓ : Real.exp ℓ = N := by rw [hℓ_def]; exact Real.exp_log hNpos
  obtain ⟨u, hu_def⟩ : ∃ u : ℝ, u = ℓ ^ ((1:ℝ)/3) := ⟨_, rfl⟩
  rw [← hu_def] at hm
  have hu1 : 1 ≤ u := by rw [hu_def]; exact Real.one_le_rpow hℓ1.le (by norm_num)
  have hupos : 0 < u := by linarith
  have hu3 : u ^ 3 = ℓ := by
    rw [hu_def, ← Real.rpow_natCast, ← Real.rpow_mul hℓpos.le]; norm_num
  have hue : u ≤ Real.exp u := by have := Real.add_one_le_exp u; linarith
  have hNd : 0 ≤ (N : ℝ) ^ d := by positivity
  have hℓA : 0 < ℓ ^ A := pow_pos hℓpos A
  have hℓAle : ℓ ^ A ≤ Real.exp (3 * A * u) := by
    calc ℓ ^ A = u ^ (3 * A) := by rw [← hu3, ← pow_mul]
      _ ≤ (Real.exp u) ^ (3 * A) := pow_le_pow_left₀ hupos.le hue _
      _ = Real.exp (((3 * A : ℕ) : ℝ) * u) := (Real.exp_nat_mul _ _).symm
      _ = Real.exp (3 * A * u) := by push_cast; ring_nf
  have hRHS : 0 ≤ (3 ^ d * κ₂ ^ (3 * A) + Real.exp 1 * 3 ^ (d - 1) * C + 2 ^ (d + 1))
      * (N : ℝ) ^ d / ℓ ^ A := by positivity
  
  have hbox : Ω ⊆ Set.Icc (fun _ : Fin d => -(N : ℝ)) (fun _ => (N : ℝ)) := by
    intro x hx
    have hx' := hΩbox hx
    simp only [realBox, Set.mem_setOf_eq] at hx'
    exact ⟨fun k => (abs_le.mp (hx' k)).1, fun k => (abs_le.mp (hx' k)).2⟩
  have hV0 : 0 ≤ V := by rw [hV_def]; exact ENNReal.toReal_nonneg
  have hV : V ≤ (2 * (N : ℝ)) ^ d := by
    have hle : (fun _ : Fin d => -(N : ℝ)) ≤ fun _ => (N : ℝ) := fun _ => by linarith
    calc V ≤ (MeasureTheory.volume
          (Set.Icc (fun _ : Fin d => -(N : ℝ)) (fun _ => (N : ℝ)))).toReal := by
          rw [hV_def]
          apply ENNReal.toReal_mono
          · rw [Real.volume_Icc_pi]
            exact ENNReal.prod_ne_top (fun _ _ => ENNReal.ofReal_ne_top)
          · exact MeasureTheory.measure_mono hbox
      _ = (2 * (N : ℝ)) ^ d := by
          rw [Real.volume_Icc_pi_toReal hle]
          simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          ring
  by_cases hsmall : u < κ₂
  · 
    have hcard : ((intBox d N).card : ℝ) = (2 * (N : ℝ) + 1) ^ d := by
      have h : (intBox d N).card = (2 * N + 1) ^ d := by
        unfold intBox
        rw [Pi.card_Icc]
        simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        congr 1
        omega
      rw [h]; push_cast; ring
    have hCC0 : 0 ≤ coprimeCount (primorial m) c₀ c Ω N := by
      unfold coprimeCount
      apply Finset.sum_nonneg
      intro z _
      split_ifs <;> norm_num
    have hCC1 : coprimeCount (primorial m) c₀ c Ω N ≤ (3 * (N : ℝ)) ^ d := by
      have h1 : coprimeCount (primorial m) c₀ c Ω N ≤ ((intBox d N).card : ℝ) := by
        unfold coprimeCount
        calc _ ≤ ∑ z ∈ intBox d N, (1 : ℝ) := by
              apply Finset.sum_le_sum
              intro z _
              split_ifs <;> norm_num
          _ = _ := by simp
      rw [hcard] at h1
      exact h1.trans (pow_le_pow_left₀ (by positivity) (by linarith) d)
    have hW1 : 1 ≤ primorial m := primorial_pos m
    have hWpos : (0 : ℝ) < (primorial m : ℝ) := by exact_mod_cast hW1
    have hresCard : (resBox d (primorial m)).card = (primorial m) ^ d := by
      unfold resBox
      rw [Pi.card_Icc]
      simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      congr 1
      omega
    have hLD0 : 0 ≤ localDensity (primorial m) c₀ c := by
      unfold localDensity; positivity
    have hLD1 : localDensity (primorial m) c₀ c ≤ 1 := by
      unfold localDensity
      rw [div_le_one (pow_pos hWpos d)]
      calc _ ≤ ((resBox d (primorial m)).card : ℝ) := by
            exact_mod_cast Finset.card_filter_le _ _
        _ = _ := by rw [hresCard]; push_cast; ring
    have hbound : |coprimeCount (primorial m) c₀ c Ω N - V * localDensity (primorial m) c₀ c|
        ≤ (3 * (N : ℝ)) ^ d := by
      have hVLD0 : 0 ≤ V * localDensity (primorial m) c₀ c := mul_nonneg hV0 hLD0
      have hVLD1 : V * localDensity (primorial m) c₀ c ≤ (3 * (N : ℝ)) ^ d := by
        calc V * localDensity (primorial m) c₀ c ≤ (2 * (N : ℝ)) ^ d * 1 :=
              mul_le_mul hV hLD1 hLD0 (by positivity)
          _ ≤ (3 * (N : ℝ)) ^ d := by
              rw [mul_one]; exact pow_le_pow_left₀ (by positivity) (by linarith) d
      rw [abs_le]; constructor <;> linarith
    have hℓκ : ℓ ^ A ≤ κ₂ ^ (3 * A) := by
      rw [← hu3, pow_mul]
      exact pow_le_pow_left₀ (by positivity) (pow_le_pow_left₀ hupos.le hsmall.le 3) A
    rw [le_div_iff₀ hℓA]
    have hrest : 0 ≤ (Real.exp 1 * 3 ^ (d - 1) * C + 2 ^ (d + 1)) * (N : ℝ) ^ d := by positivity
    calc |coprimeCount (primorial m) c₀ c Ω N - V * localDensity (primorial m) c₀ c| * ℓ ^ A
        ≤ (3 * (N : ℝ)) ^ d * κ₂ ^ (3 * A) := mul_le_mul hbound hℓκ hℓA.le (by positivity)
      _ = 3 ^ d * κ₂ ^ (3 * A) * (N : ℝ) ^ d := by rw [mul_pow]; ring
      _ ≤ (3 ^ d * κ₂ ^ (3 * A) + Real.exp 1 * 3 ^ (d - 1) * C + 2 ^ (d + 1)) * (N : ℝ) ^ d := by
          nlinarith
  · push_neg at hsmall
    rcases kai_local_bad_density_bound K d hd c₀ c m with hA | hloc
    · 
      have hCC : coprimeCount (primorial m) c₀ c Ω N = 0 := by
        unfold coprimeCount
        apply Finset.sum_eq_zero
        intro z _
        split_ifs with h1 h2
        · exact absurd h2 (hA z)
        · rfl
        · rfl
      have hLD : localDensity (primorial m) c₀ c = 0 := by
        unfold localDensity
        rw [Finset.card_eq_zero.mpr (Finset.filter_eq_empty_iff.mpr (fun z _ => hA z))]
        simp
      rw [hCC, hLD]
      simpa using hRHS
    · 
      obtain ⟨R, hR_def⟩ : ∃ R : ℕ, R = ⌈κ * u⌉₊ := ⟨_, rfl⟩
      have hκu : κ * u ≤ R := by rw [hR_def]; exact Nat.le_ceil _
      have hRlt : (R : ℝ) < κ * u + 1 := by
        rw [hR_def]; exact Nat.ceil_lt_add_one (by positivity)
      have hκu8 : 8 * Real.exp 1 ≤ κ * u := by
        have : κ * 1 ≤ κ * u := mul_le_mul_of_nonneg_left hu1 hκ0
        linarith
      have hR1 : 1 ≤ R := by
        have h : (0 : ℝ) < R := by linarith
        have h' : 0 < R := by exact_mod_cast h
        omega
      have hs := hs1 c₀ c m (R - 1) N Ω (by omega) hΩm hΩc hΩbox
      rw [← hV_def, Nat.sub_add_cancel hR1] at hs
      obtain ⟨U, hU_def⟩ : ∃ U : Finset ℕ, U = (Finset.range (m + 1)).filter Nat.Prime :=
        ⟨_, rfl⟩
      rw [← hU_def] at hs hloc
      have hrecip := recip m
      rw [← hU_def] at hrecip
      have hlogm : Real.log m ≤ u := by
        rcases Nat.eq_zero_or_pos m with h0 | hmpos
        · rw [h0, Nat.cast_zero, Real.log_zero]; linarith
        · calc Real.log m ≤ Real.log (Real.exp u) :=
                Real.log_le_log (by exact_mod_cast hmpos) hm
            _ = u := Real.log_exp u
      have hUprime : ∀ p ∈ U, p.Prime := by
        intro p hp; rw [hU_def, Finset.mem_filter] at hp; exact hp.2
      
      obtain ⟨M, hM_def⟩ : ∃ M : ℝ, M = max (m : ℝ) 1 := ⟨_, rfl⟩
      have hM1 : 1 ≤ M := by rw [hM_def]; exact le_max_right _ _
      have hmM : (m : ℝ) ≤ M := by rw [hM_def]; exact le_max_left _ _
      have hMexp : M ≤ Real.exp u := by
        rw [hM_def]; exact max_le hm (Real.one_le_exp hupos.le)
      obtain ⟨lam, hlam_def⟩ : ∃ lam : ℝ, lam = 2 * M ^ (d + 1) := ⟨_, rfl⟩
      have hlam1 : 1 ≤ lam := by
        rw [hlam_def]
        have : 1 ≤ M ^ (d + 1) := one_le_pow₀ hM1
        linarith
      have hlampos : 0 < lam := by linarith
      have hpM : ∀ p ∈ U, (p : ℝ) ≤ M := by
        intro p hp
        rw [hU_def, Finset.mem_filter, Finset.mem_range] at hp
        have : (p : ℝ) ≤ m := by exact_mod_cast (by omega : p ≤ m)
        exact this.trans hmM
      have hUcard : (U.card : ℝ) ≤ m + 1 := by
        have : U.card ≤ m + 1 := by
          rw [hU_def]; exact (Finset.card_filter_le _ _).trans (Finset.card_range _).le
        exact_mod_cast this
      
      have hlamexp : lam ≤ Real.exp (((d : ℝ) + 2) * u) := by
        have h2 : (2 : ℝ) ≤ Real.exp u := by have := Real.add_one_le_exp u; linarith
        calc lam = 2 * M ^ (d + 1) := hlam_def
          _ ≤ Real.exp u * (Real.exp u) ^ (d + 1) :=
              mul_le_mul h2 (pow_le_pow_left₀ (by linarith) hMexp _) (by positivity)
                (by positivity)
          _ = Real.exp (((d : ℝ) + 2) * u) := by
              rw [← Real.exp_nat_mul, ← Real.exp_add]; congr 1; push_cast; ring
      have hlamR : lam ^ R ≤ Real.exp (((d : ℝ) + 2) * (κ + 1) * u ^ 2) := by
        calc lam ^ R ≤ (Real.exp (((d : ℝ) + 2) * u)) ^ R := pow_le_pow_left₀ hlampos.le hlamexp R
          _ = Real.exp (R * (((d : ℝ) + 2) * u)) := (Real.exp_nat_mul _ R).symm
          _ ≤ _ := by
            apply Real.exp_le_exp.2
            have hku : (κ + 1) * u = κ * u + u := by ring
            have hR' : (R : ℝ) ≤ (κ + 1) * u := by linarith
            have hdu : 0 ≤ ((d : ℝ) + 2) * u := by positivity
            calc (R : ℝ) * (((d : ℝ) + 2) * u) ≤ ((κ + 1) * u) * (((d : ℝ) + 2) * u) :=
                  mul_le_mul_of_nonneg_right hR' hdu
              _ = _ := by ring
      have hℓAexp : ℓ ^ A ≤ Real.exp (3 * A * u ^ 2) := by
        refine hℓAle.trans (Real.exp_le_exp.2 ?_)
        have : u ≤ u ^ 2 := by nlinarith
        have hA0 : (0 : ℝ) ≤ 3 * A := by positivity
        nlinarith
      have hlamRℓ : lam ^ R * ℓ ^ A ≤ N := by
        calc lam ^ R * ℓ ^ A
            ≤ Real.exp (((d : ℝ) + 2) * (κ + 1) * u ^ 2) * Real.exp (3 * A * u ^ 2) :=
              mul_le_mul hlamR hℓAexp hℓA.le (Real.exp_pos _).le
          _ = Real.exp (κ₂ * u ^ 2) := by
              rw [← Real.exp_add, hκ₂_def]; congr 1; ring
          _ ≤ Real.exp (u ^ 3) := by
              apply Real.exp_le_exp.2
              have : κ₂ * u ^ 2 ≤ u * u ^ 2 :=
                mul_le_mul_of_nonneg_right hsmall (by positivity)
              nlinarith
          _ = N := by rw [hu3, hexpℓ]
      
      have hT1sum : ∑ S ∈ U.powerset.filter (fun S => S.card ≤ R), ((∏ p ∈ S, p : ℕ) : ℝ) ^ d
          ≤ Real.exp 1 * lam ^ R := by
        have hterm : ∀ S ∈ U.powerset.filter (fun S => S.card ≤ R),
            ((∏ p ∈ S, p : ℕ) : ℝ) ^ d
              ≤ lam ^ R * (1 ^ S.card * ∏ p ∈ S, ((p : ℝ) ^ d / lam)) := by
          intro S hS
          rw [Finset.mem_filter] at hS
          rw [one_pow, one_mul, Finset.prod_div_distrib, Finset.prod_const, Nat.cast_prod,
            ← Finset.prod_pow]
          have hP0 : 0 ≤ ∏ p ∈ S, ((p : ℝ)) ^ d := Finset.prod_nonneg (fun p _ => by positivity)
          rw [mul_div_assoc', le_div_iff₀ (pow_pos hlampos _), mul_comm]
          exact mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hlam1 hS.2) hP0
        have hx : ∀ p ∈ U, 0 ≤ (fun p : ℕ => (p : ℝ) ^ d / lam) p :=
