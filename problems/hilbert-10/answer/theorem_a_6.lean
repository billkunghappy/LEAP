      _ ≤ ENNReal.ofReal (2 * lam / X) *
            MeasureTheory.volume
              (Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) (3 * X)) :=
          mul_le_mul_left' hcount _
  
  have hballex : ∃ cB : ℝ, 0 < cB ∧
      ∀ R : ℝ, 0 ≤ R →
        MeasureTheory.volume
            (Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) R)
          ≤ ENNReal.ofReal (cB * R ^ (Module.finrank ℚ K)) := by
    have hcard1 : Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
        = NumberField.InfinitePlace.nrRealPlaces K :=
      congrArg (fun i : Fintype {w : NumberField.InfinitePlace K // w.IsReal} =>
          @Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} i)
        (Subsingleton.elim _ _)
    have hcard2 : Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}
        = NumberField.InfinitePlace.nrComplexPlaces K :=
      congrArg (fun i : Fintype {w : NumberField.InfinitePlace K // w.IsComplex} =>
          @Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex} i)
        (Subsingleton.elim _ _)
