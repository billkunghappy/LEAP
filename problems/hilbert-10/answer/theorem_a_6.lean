        have hmain : ∀ y : ℝ, 3 ≤ y → y ≤ x →
            ‖(∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ y},
                ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
                  lam (I : Ideal (NumberField.RingOfIntegers K)) *
                  ((Real.log (y / (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ))
                    : ℝ) : ℂ))
              - (E : ℂ) * (y : ℂ) + (m : ℂ) * (((y ^ β₀ / β₀ ^ 2 : ℝ)) : ℂ)‖ ≤ x * R := by
          intro y hy3 hyx
          by_cases he2 : m₀ = 1 ∧ σ₁ ≤ β₀₀
          · 
            have hinf : kaiInfSize K t l = 1 := (hcl1 he2.1).1
            have hσβ : σ₁ + ρ ≤ β₀₀ := by
              rw [abs_of_nonpos (by linarith [he2.2])] at hρσ
              linarith
            have hP : m₀ = 1 ∧ 1 - B / 4 / Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ β₀₀ := by
