  have hC₁0 : 0 ≤ 10 * c₂ + 8 * ((NumberField.InfinitePlace.nrComplexPlaces K : ℝ) + 2) + 16 := by
    linarith
  have hRHS0 : 0 ≤ (10 * c₂ + 8 * ((NumberField.InfinitePlace.nrComplexPlaces K : ℝ) + 2) + 16) *
