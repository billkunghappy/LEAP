        ‖Psi0 (ρ₀ + (μ : NumberField.RingOfIntegers K)) u‖) := by
    intro u
    refine (hsum (fun w => Real.exp (u w)) (fun w => Real.exp_pos _)).congr (fun μ => ?_)
    rw [hPsi0, hshift, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (hGnn _ _)]
  obtain ⟨Phi0, hPhi0⟩ :
      ∃ e : ↥(q * b) ≃ {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b},
        ∀ μ : ↥(q * b), ((e μ : NumberField.RingOfIntegers K))
            = ρ₀ + (μ : NumberField.RingOfIntegers K) :=
    ⟨{ toFun := fun μ => ⟨ρ₀ + (μ : NumberField.RingOfIntegers K), by simpa using μ.2⟩
       invFun := fun ν => ⟨(ν : NumberField.RingOfIntegers K) - ρ₀, ν.2⟩
       left_inv := fun μ => Subtype.ext (by simp)
       right_inv := fun ν => Subtype.ext (by simp) }, fun _ => rfl⟩
  have hsumX : ∀ u : NumberField.InfinitePlace K → ℝ,
      Summable (fun x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b} =>
        ‖Psi0 (x : NumberField.RingOfIntegers K) u‖) := by
    intro u
    rw [← Equiv.summable_iff Phi0]
    refine (hsumA u).congr (fun μ => ?_)
    simp only [Function.comp_apply]
    rw [hPhi0 μ]
  have hsumX' : ∀ u : NumberField.InfinitePlace K → ℝ,
      Summable (fun x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b} =>
        Psi0 (x : NumberField.RingOfIntegers K) u) := fun u => Summable.of_norm (hsumX u)
  have hThetaX : ∀ u : NumberField.InfinitePlace K → ℝ,
      kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
          (fun w => Real.exp (u w))
        = ∑' x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b},
            Psi0 (x : NumberField.RingOfIntegers K) u := by
    intro u
    rw [← Equiv.tsum_eq Phi0
      (fun x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b} =>
        Psi0 (x : NumberField.RingOfIntegers K) u)]
    simp only [kaiHZIdealTheta]
    exact tsum_congr (fun μ => by rw [hPsi0, hPhi0 μ, hshift])
  have hPsi0zero : ∀ u : NumberField.InfinitePlace K → ℝ,
      Psi0 0 u = kaiHZArchWeight K η l 0 := by
    intro u
    rw [hPsi0]
    have h0 : ((0 : NumberField.RingOfIntegers K) : K) = 0 := by push_cast; ring
    rw [h0, map_zero]
    simp only [kaiHZGaussian, map_zero]
    simp
  have hSinj : Function.Injective
      (fun ν : {ν : NumberField.RingOfIntegers K // ν ≠ 0 ∧ ν - ρ₀ ∈ q * b} =>
        (⟨(ν : NumberField.RingOfIntegers K), ν.2.2⟩ :
          {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b})) := by
    intro x y hxy
    have h : ((x : NumberField.RingOfIntegers K)) = ((y : NumberField.RingOfIntegers K)) :=
      congrArg (fun z : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b} =>
          (z : NumberField.RingOfIntegers K))
        (show (⟨(x : NumberField.RingOfIntegers K), x.2.2⟩ :
            {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b})
          = ⟨(y : NumberField.RingOfIntegers K), y.2.2⟩ from hxy)
    exact Subtype.ext h
  have hStsum : ∀ u : NumberField.InfinitePlace K → ℝ,
      (∑' ν : {ν : NumberField.RingOfIntegers K // ν ≠ 0 ∧ ν - ρ₀ ∈ q * b},
          Psi0 (ν : NumberField.RingOfIntegers K) u)
        = ∑' x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b},
            (if (x : NumberField.RingOfIntegers K) = 0 then 0
              else Psi0 (x : NumberField.RingOfIntegers K) u) := by
    intro u
    have hsupp : Function.support
        (fun x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b} =>
          (if (x : NumberField.RingOfIntegers K) = 0 then 0
            else Psi0 (x : NumberField.RingOfIntegers K) u))
        ⊆ Set.range (fun ν : {ν : NumberField.RingOfIntegers K // ν ≠ 0 ∧ ν - ρ₀ ∈ q * b} =>
          (⟨(ν : NumberField.RingOfIntegers K), ν.2.2⟩ :
            {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b})) := by
      intro x hx
      simp only [Function.mem_support, ne_eq, ite_eq_left_iff, not_forall] at hx
      obtain ⟨hx0, -⟩ := hx
      exact ⟨⟨(x : NumberField.RingOfIntegers K), hx0, x.2⟩, Subtype.ext rfl⟩
    rw [← hSinj.tsum_eq hsupp]
    exact tsum_congr (fun ν => (if_neg ν.2.1).symm)
  have hdelta : ∀ u : NumberField.InfinitePlace K → ℝ,
      (∑' x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b},
          Psi0 (x : NumberField.RingOfIntegers K) u)
        = δ + ∑' x : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b},
            (if (x : NumberField.RingOfIntegers K) = 0 then 0
              else Psi0 (x : NumberField.RingOfIntegers K) u) := by
    intro u
    by_cases hz0 : (-ρ₀) ∈ q * b
    · have hx₀mem : (0 : NumberField.RingOfIntegers K) - ρ₀ ∈ q * b := by
        simpa using hz0
      have hdel : δ = kaiHZArchWeight K η l 0 := by
        refine hδ1 ⟨-ρ₀, hz0⟩ ?_
        have h1 : ((-ρ₀ : NumberField.RingOfIntegers K) : K) = -((ρ₀ : K)) := by
          push_cast; ring
        rw [h1, map_neg]
        ring
      rw [(hsumX' u).tsum_eq_add_tsum_ite
        (⟨0, hx₀mem⟩ : {ν : NumberField.RingOfIntegers K // ν - ρ₀ ∈ q * b})]
      rw [hPsi0zero u, hdel]
      refine congrArg _ (tsum_congr (fun x => ?_))
      by_cases hx : (x : NumberField.RingOfIntegers K) = 0
      · rw [if_pos (Subtype.ext hx : x = ⟨0, hx₀mem⟩), if_pos hx]
      · rw [if_neg (fun h => hx (congrArg Subtype.val h)), if_neg hx]
    · have hdel : δ = 0 := by
        refine hδ2 (fun μ hμ => hz0 ?_)
        have h1 : NumberField.mixedEmbedding K ((ρ₀ : K))
            + NumberField.mixedEmbedding K
              ((μ : NumberField.RingOfIntegers K) : K)
            = NumberField.mixedEmbedding K
              (((ρ₀ + (μ : NumberField.RingOfIntegers K) :
                NumberField.RingOfIntegers K) : K)) := (hshift _).symm
        rw [h1] at hμ
        have h2 : ρ₀ + (μ : NumberField.RingOfIntegers K) = 0 := by
          have := NumberField.mixedEmbedding_injective K
            (by rw [hμ, map_zero] :
              NumberField.mixedEmbedding K
                (((ρ₀ + (μ : NumberField.RingOfIntegers K) :
                  NumberField.RingOfIntegers K) : K))
                = NumberField.mixedEmbedding K (0 : K))
          exact NumberField.RingOfIntegers.coe_eq_zero_iff.mp this
        have h3 : (-ρ₀ : NumberField.RingOfIntegers K)
            = (μ : NumberField.RingOfIntegers K) := by linear_combination -h2
        rw [h3]
        exact μ.2
      rw [hdel, zero_add]
      refine tsum_congr (fun x => ?_)
      rw [if_neg]
      intro hx
      exact hz0 (by
        have : (0 : NumberField.RingOfIntegers K) - ρ₀ ∈ q * b := hx ▸ x.2
        simpa using this)
  have hf : ∀ u : NumberField.InfinitePlace K → ℝ,
      (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
          (fun w => Real.exp (u w)) - δ) *
        kaiMFConeWeight K (kaiMFConeZcan K t l η s) u
        = ∑' x : {ν : NumberField.RingOfIntegers K // ν ≠ 0 ∧ ν - ρ₀ ∈ q * b},
            Psi (x : NumberField.RingOfIntegers K) u := by
    intro u
    rw [hThetaX u, hdelta u, add_sub_cancel_left, ← hStsum u, ← tsum_mul_right]
    exact tsum_congr (fun ν => (hPsiPsi0 _ u).symm)
  obtain ⟨hconj2, hval⟩ := kai_mf_cone_orbit_fubini Lat hcount F hfd pmap wq hwq hfibp eOrb
    (fun x => Psi (x : NumberField.RingOfIntegers K))
    (fun g => Psi (g : NumberField.RingOfIntegers K))
    (fun x => hPsicont _) hequiv hΦint hfin
    (fun u => (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
          (fun w => Real.exp (u w)) - δ) *
        kaiMFConeWeight K (kaiMFConeZcan K t l η s) u) hfcont hf
  
  refine ⟨hconj1, hconj2, ?_⟩
  have hval' : (∫ u in F, (kaiHZIdealTheta K (q * b)
        (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
          (fun w => Real.exp (u w)) - δ) *
        kaiMFConeWeight K (kaiMFConeZcan K t l η s) u)
      = (wq : ℂ) * ∑' g : {ν // ν ∈ Gen}, ∫ u : NumberField.InfinitePlace K → ℝ,
          Psi (g : NumberField.RingOfIntegers K) u := hval
  have hint : ∀ g : {ν // ν ∈ Gen},
      (∫ u : NumberField.InfinitePlace K → ℝ, Psi (g : NumberField.RingOfIntegers K) u)
        = ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) / 2) : ℝ) : ℂ) *
          (((Real.pi ^ (-(Module.finrank ℚ K : ℝ) / 2) : ℝ) : ℂ)) ^ s *
          (∏ w : NumberField.InfinitePlace K, Complex.Gamma (kaiMFConeZcan K t l η s w)) *
          (kaiHeckeTwist K q t l ξ η (g : NumberField.RingOfIntegers K) /
            ((Ideal.absNorm (Ideal.span {(g : NumberField.RingOfIntegers K)}) : ℂ) ^ s)) := by
    intro g
    simp only [hPsi]
    exact (hs7 g).2.1
  rw [hval', tsum_congr hint, tsum_mul_left]
  ring

theorem kai_mf_cone_gamma_identities : (∀ z : ℂ, (Complex.Gamma z)⁻¹ = z * (Complex.Gamma (z + 1))⁻¹) ∧
    (∀ (z : ℂ) (m : ℕ), 0 < z.re → Complex.Gamma (z + (m : ℂ))
        = (∏ j ∈ Finset.range m, (z + (j : ℂ))) * Complex.Gamma z) ∧
    (∀ z : ℂ, ‖Complex.Gamma ((starRingEnd ℂ) z)‖ = ‖Complex.Gamma z‖) ∧
    (∀ (z : ℂ) (m : ℕ), (1 : ℝ) / 2 ≤ z.re →
        ‖Complex.Gamma z * (Complex.Gamma (z + (m : ℂ)))⁻¹‖ ≤ 2 ^ m) ∧
    (∀ (z : ℂ) (m : ℕ), (Complex.Gamma z)⁻¹
        = (∏ j ∈ Finset.range m, (z + (j : ℂ))) * (Complex.Gamma (z + (m : ℂ)))⁻¹) :=
by
  have hA : ∀ z : ℂ, (Complex.Gamma z)⁻¹ = z * (Complex.Gamma (z + 1))⁻¹ :=
    fun z => Complex.one_div_Gamma_eq_self_mul_one_div_Gamma_add_one z
  have hcast : ∀ (z : ℂ) (m : ℕ), z + ((m + 1 : ℕ) : ℂ) = (z + (m : ℂ)) + 1 := by
    intro z m; push_cast; ring
  have hre : ∀ (z : ℂ) (m : ℕ), (z + (m : ℂ)).re = z.re + (m : ℝ) := by
    intro z m; simp
  refine ⟨hA, ?_, ?_, ?_, ?_⟩
  · intro z m hz
    induction m with
    | zero => simp
    | succ m ih =>
      have hw : z + (m : ℂ) ≠ 0 := by
        intro h
        have h1 := congrArg Complex.re h
        rw [hre] at h1
        simp at h1
        have : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
        linarith
      rw [hcast, Complex.Gamma_add_one _ hw, ih, Finset.prod_range_succ]
      ring
  · intro z
    rw [Complex.Gamma_conj, Complex.norm_conj]
  · intro z m hz
    induction m with
    | zero =>
      have hne : Complex.Gamma z ≠ 0 := Complex.Gamma_ne_zero_of_re_pos (by linarith)
      simp [hne]
    | succ m ih =>
      have hwre : (1 : ℝ) / 2 ≤ (z + (m : ℂ)).re := by
        rw [hre]
        have : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
        linarith
      have hwn : (1 : ℝ) / 2 ≤ ‖z + (m : ℂ)‖ := hwre.trans (Complex.re_le_norm _)
      have hw : z + (m : ℂ) ≠ 0 := by
        intro h
        rw [h, norm_zero] at hwn
        norm_num at hwn
      have hinv : ‖z + (m : ℂ)‖⁻¹ ≤ 2 := by
        have := inv_anti₀ (by norm_num : (0 : ℝ) < 1 / 2) hwn
        norm_num at this
        exact this
      rw [hcast, Complex.Gamma_add_one _ hw, mul_inv]
      have heq : Complex.Gamma z * ((z + (m : ℂ))⁻¹ * (Complex.Gamma (z + (m : ℂ)))⁻¹)
          = (Complex.Gamma z * (Complex.Gamma (z + (m : ℂ)))⁻¹) * (z + (m : ℂ))⁻¹ := by
        ring
      rw [heq, norm_mul, norm_inv, pow_succ]
      exact mul_le_mul ih hinv (inv_nonneg.2 (norm_nonneg _)) (by positivity)
  · intro z m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [ih, hA (z + (m : ℂ)), hcast, Finset.prod_range_succ]
      ring

theorem kai_slab_line_disintegration {ι : Type*} [Fintype ι] [Nonempty ι]
    (m : ι → ℝ) (hm : ∀ i, 0 < m i) (n : ℝ) (hmn : (∑ j, m j) = n)
    (G : Set (ι → ℝ)) (hGm : MeasurableSet G)
    (htr : ∀ (u : ι → ℝ) (ρ : ℝ), u ∈ G ↔ (fun i => u i + ρ) ∈ G)
    (c : ℝ) (hslab : ∀ u ∈ G, ∀ i, |u i - (∑ j, m j * u j) / n| ≤ c)
    (g : (ι → ℝ) → ℂ) (hgmeas : Measurable g)
    (Mg : ℝ) (hgb : ∀ u ∈ G, ‖g u‖ ≤ Mg)
    (hginv : ∀ (u : ι → ℝ) (ρ : ℝ), g (fun i => u i + ρ) = g u)
    (φ : ℝ → ℂ) (hφmeas : Measurable φ) (hφint : MeasureTheory.Integrable φ) :
    MeasureTheory.IntegrableOn
        (fun u => g u * φ (∑ j, m j * u j)) G MeasureTheory.volume ∧
      (∫ u in G, g u * φ (∑ j, m j * u j))
        = (∫ u in G ∩ {u : ι → ℝ |
              0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1}, g u) * ∫ t : ℝ, φ t :=
by
  classical
  have hn : 0 < n := by
    rw [← hmn]
    exact Finset.sum_pos (fun j _ => hm j) Finset.univ_nonempty
  have hnne : n ≠ 0 := ne_of_gt hn
  have hL : Measurable (fun u : ι → ℝ => ∑ j, m j * u j) := by fun_prop
  set Ω : Set (ι → ℝ) :=
    {u : ι → ℝ | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1} with hΩdef
  have hΩpre : Ω = (fun u : ι → ℝ => ∑ j, m j * u j) ⁻¹' (Set.Icc (0 : ℝ) 1) := by
    rw [hΩdef]; ext u; simp [Set.mem_Icc]
  have hΩm : MeasurableSet Ω := by rw [hΩpre]; exact hL measurableSet_Icc
  
  have s1 : ∀ R : ℝ,
      MeasureTheory.volume (G ∩ {u : ι → ℝ | |∑ j, m j * u j| ≤ R}) ≠ ⊤ := by
    intro R
    have hsub : G ∩ {u : ι → ℝ | |∑ j, m j * u j| ≤ R}
        ⊆ Set.univ.pi (fun _ : ι => Set.Icc (-(c + R / n)) (c + R / n)) := by
      rintro u ⟨huG, huR⟩
      simp only [Set.mem_univ_pi, Set.mem_Icc]
      intro i
      have h1 := hslab u huG i
      have h2 : |∑ j, m j * u j| ≤ R := huR
      have h3 : |(∑ j, m j * u j) / n| ≤ R / n := by
        rw [abs_div, abs_of_pos hn]
        gcongr
      have hkey : u i = (u i - (∑ j, m j * u j) / n) + (∑ j, m j * u j) / n := by ring
      have h4 : |u i| ≤ c + R / n := by
        calc |u i| = |(u i - (∑ j, m j * u j) / n) + (∑ j, m j * u j) / n| := by rw [← hkey]
          _ ≤ |u i - (∑ j, m j * u j) / n| + |(∑ j, m j * u j) / n| := abs_add_le _ _
          _ ≤ c + R / n := add_le_add h1 h3
      exact abs_le.mp h4
    refine ne_top_of_le_ne_top ?_ (MeasureTheory.measure_mono hsub)
    rw [MeasureTheory.volume_pi_pi]
    simp only [Real.volume_Icc]
    rw [Finset.prod_const, Finset.card_univ]
    exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
  have hGΩfin : MeasureTheory.volume (G ∩ Ω) ≠ ⊤ := by
    refine ne_top_of_le_ne_top (s1 1) (MeasureTheory.measure_mono ?_)
    rintro u ⟨huG, huΩ⟩
    rw [hΩdef] at huΩ
    obtain ⟨hu1, hu2⟩ := huΩ
    exact ⟨huG, by simpa [abs_le] using ⟨by linarith, hu2⟩⟩
  
  have s2 : ∀ (w : (ι → ℝ) → ENNReal), Measurable w →
      (∀ (u : ι → ℝ) (ρ : ℝ), w (fun i => u i + ρ) = w u) →
      ∀ (A : Set ℝ), MeasurableSet A → ∀ b : ℝ,
      ∫⁻ u in G ∩ {u : ι → ℝ | b + (∑ j, m j * u j) ∈ A}, w u
        = ∫⁻ u in G ∩ {u : ι → ℝ | (∑ j, m j * u j) ∈ A}, w u := by
    intro w hwmeas hwinv A hA b
    have hτ : MeasureTheory.MeasurePreserving
        (fun u : ι → ℝ => (fun i => u i + b / n))
        MeasureTheory.volume MeasureTheory.volume := by
      have h0 := MeasureTheory.measurePreserving_add_left
        (MeasureTheory.volume : MeasureTheory.Measure (ι → ℝ)) (fun _ : ι => b / n)
      have heq : (fun x : ι → ℝ => (fun _ : ι => b / n) + x)
          = (fun u : ι → ℝ => (fun i => u i + b / n)) := by
        funext u
        funext i
        simp [Pi.add_apply, add_comm]
      rwa [heq] at h0
    have hLsh : ∀ u : ι → ℝ, (∑ j, m j * (u j + b / n)) = (∑ j, m j * u j) + b := by
      intro u
      have h1 : ∀ j : ι, m j * (u j + b / n) = m j * u j + m j * (b / n) := fun j => by ring
      rw [Finset.sum_congr rfl (fun j _ => h1 j), Finset.sum_add_distrib, ← Finset.sum_mul, hmn]
      congr 1
      field_simp
    have hS : MeasurableSet (G ∩ {u : ι → ℝ | (∑ j, m j * u j) ∈ A}) := hGm.inter (hL hA)
    have hpre : (fun u : ι → ℝ => (fun i => u i + b / n)) ⁻¹'
          (G ∩ {u : ι → ℝ | (∑ j, m j * u j) ∈ A})
        = G ∩ {u : ι → ℝ | b + (∑ j, m j * u j) ∈ A} := by
      ext u
      simp only [Set.mem_preimage, Set.mem_inter_iff, Set.mem_setOf_eq]
      constructor
      · rintro ⟨h1, h2⟩
        refine ⟨(htr u (b / n)).mpr h1, ?_⟩
        rw [hLsh u] at h2
        rwa [add_comm]
      · rintro ⟨h1, h2⟩
        refine ⟨(htr u (b / n)).mp h1, ?_⟩
        rw [hLsh u]
        rwa [add_comm b] at h2
    have hcov := hτ.setLIntegral_comp_preimage hS hwmeas
    simp only [hwinv] at hcov
    rw [hpre] at hcov
    exact hcov
  
  have s3 : ∀ ν : MeasureTheory.Measure ℝ,
      (∀ (b : ℝ) (A : Set ℝ), MeasurableSet A →
        ν ((fun t : ℝ => b + t) ⁻¹' A) = ν A) →
      (∀ R : ℝ, ν (Set.Icc (-R) R) ≠ ⊤) →
      ν = (ν (Set.Icc 0 1)) • MeasureTheory.volume := by
    intro ν hinv hfin
    haveI hli : ν.IsAddLeftInvariant := by
      constructor
      intro b
      refine MeasureTheory.Measure.ext (fun A hA => ?_)
      rw [MeasureTheory.Measure.map_apply (measurable_const_add b) hA]
      exact hinv b A hA
    haveI hfc : MeasureTheory.IsFiniteMeasureOnCompacts ν := by
      constructor
      intro K hK
      obtain ⟨R, hR⟩ := (Metric.isBounded_iff_subset_closedBall (0 : ℝ)).mp hK.isBounded
      have hKI : K ⊆ Set.Icc (-R) R := by
        rw [Real.closedBall_eq_Icc] at hR
        simpa using hR
      exact lt_of_le_of_lt (MeasureTheory.measure_mono hKI)
        (lt_top_iff_ne_top.mpr (hfin R))
    haveI hreg : ν.Regular := inferInstance
    obtain ⟨κ, hκ⟩ : ∃ κ : NNReal, ν = κ • MeasureTheory.volume :=
      ⟨_, MeasureTheory.Measure.isAddLeftInvariant_eq_smul_of_regular ν MeasureTheory.volume⟩
    have hvol : MeasureTheory.volume (Set.Icc (0 : ℝ) 1) = 1 := by
      rw [Real.volume_Icc]; norm_num
    have hkap : ν (Set.Icc 0 1) = (κ : ENNReal) := by
      rw [hκ, MeasureTheory.Measure.smul_apply, hvol, ENNReal.smul_def, smul_eq_mul, mul_one]
    rw [hkap, hκ, ENNReal.smul_def]
  
  have s4 : ∀ (μ : MeasureTheory.Measure (ι → ℝ)) (T : (ι → ℝ) → ℝ), Measurable T →
      ∀ hh : (ι → ℝ) → ℝ, Measurable hh → (∀ a, 0 ≤ hh a) →
      ∀ κ : ENNReal, κ ≠ ⊤ →
      MeasureTheory.Measure.map T (μ.withDensity (fun a => ENNReal.ofReal (hh a)))
        = κ • MeasureTheory.volume →
      MeasureTheory.Integrable (fun a => ((hh a : ℝ) : ℂ) * φ (T a)) μ ∧
        (∫ a, ((hh a : ℝ) : ℂ) * φ (T a) ∂μ) = ((κ.toReal : ℝ) : ℂ) * ∫ t : ℝ, φ t := by
    intro μ T hT hh hhm hh0 κ hκ hmap
