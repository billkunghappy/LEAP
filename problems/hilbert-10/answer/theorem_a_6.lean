        exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero he hf.ne')
      · intro P hP hP0 hmemP
        haveI := hP
        have h1 : ((p : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
          rw [Ideal.under_def, Ideal.mem_comap]
          simpa using hmemP
        have h2 : Ideal.span {(p : ℤ)} ≤ Ideal.under ℤ P := by
          rw [Ideal.span_le, Set.singleton_subset_iff]
          exact h1
        have h3 : Ideal.under ℤ P ≠ ⊤ := by
          intro h
          have h1' : (1 : ℤ) ∈ Ideal.under ℤ P := by rw [h]; exact Submodule.mem_top
          rw [Ideal.under_def, Ideal.mem_comap, map_one] at h1'
