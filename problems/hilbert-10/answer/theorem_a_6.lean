          exact h1.mul h3
        refine MeasureTheory.Integrable.mono' hmaj
          (hcontOn.aestronglyMeasurable measurableSet_Ioc) ?_
        refine (MeasureTheory.ae_restrict_iff' measurableSet_Ioc).mpr
          (Filter.Eventually.of_forall (fun t ht => ?_))
        obtain ⟨ht0, ht1⟩ := ht
        have hp1 : (0:ℝ) < t ^ (s.re - 1) := Real.rpow_pos_of_pos ht0 _
