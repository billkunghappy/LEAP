      Nat.le_floor_iff hLs0]
    push_cast
    constructor
    · rintro ⟨_, h⟩; linarith
    · intro h
      refine ⟨?_, by linarith⟩
      have hj : (j : ℝ) < L := by linarith
      exact_mod_cast hj
  rw [hfilter, Finset.card_range]
  have hfl := Nat.floor_le hLs0
  have hlt := Nat.lt_floor_add_one ((L : ℝ) * s)
  have e : s - 1 / (L : ℝ) * (⌊(L : ℝ) * s⌋₊ : ℝ)
      = ((L : ℝ) * s - (⌊(L : ℝ) * s⌋₊ : ℝ)) / L := by
    field_simp
  rw [e]
  constructor
  · exact div_nonneg (by linarith) hLpos.le
  · exact div_le_div_of_nonneg_right (by linarith) hLpos.le

theorem kai_siegel_cramer_U3_bound (K : Type u) [Field K] [NumberField K] :
    ∃ cW : ℝ, 0 < cW ∧
      ∀ (ρ : ℝ), 0 ≤ ρ →
      ∀ (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ
            (NumberField.RingOfIntegers K)),
        IsNormLengthCompatible C ω →
        ∃ (CW : ℝ) (kW : ℕ), 0 ≤ CW ∧
          ∀ (M : ℝ) (m : ℕ)
            (Dt : Ideal (NumberField.RingOfIntegers K) ×
              (NumberField.RingOfIntegers K → ℤ) × ℝ),
            3 ≤ M →
            Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
            (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
            IsSiegelDatum m Dt → Dt.2.1 ≠ 0 →
            gowersU3Pow ω (fun x => siegelModel K ρ (primorial m) Dt.2.1 Dt.2.2 x
                - cramerModel K ρ (primorial m) x) M
              ≤ CW * Real.log M ^ kW / (Ideal.absNorm Dt.1 : ℝ) ^ cW :=
by
  classical
  obtain ⟨C_M, hC_M, hdens⟩ := kai_cramer_density_bound K
  obtain ⟨C₃, hC₃, hs3⟩ := kai_real_char_finite_U3_bound K
  refine ⟨1/4, by norm_num, ?_⟩
  intro ρ hρ C ω hω
  obtain ⟨C₄, hC₄, hs4⟩ := kai_cube_count_equidistribution K ω
  have hCM0 : (0:ℝ) ≤ C_M := by linarith
  have hC₆ : 0 ≤ C₄ * (C₃ + 1) := mul_nonneg hC₄ (by linarith)
  refine ⟨128 * ((256:ℝ) ^ Module.finrank ℚ K * (C₄ * (C₃ + 1)) + 27 ^ Module.finrank ℚ K)
      * (ρ ^ 8 * C_M ^ (8 * Module.finrank ℚ K)), 8 * Module.finrank ℚ K, by positivity, ?_⟩
  intro M m Dt hM hm1 hm2 hDt hψ
  obtain ⟨𝔮, ψ, β⟩ := Dt
  have hDt' := hDt
  dsimp only at hψ hDt ⊢
  obtain ⟨h𝔮, hcases⟩ := hDt
  rcases hcases with h0 | ⟨hR, hβ1, hβ2, hQm, hprime⟩
  · exact absurd h0 hψ
  dsimp only at h𝔮 hR hβ1 hβ2 hQm hprime
  
  have hMpos : (0:ℝ) < M := by linarith
  have hℓ1 : 1 < Real.log M := by
    rw [Real.lt_log_iff_exp_lt hMpos]
    have := Real.exp_one_lt_d9
    linarith
  have hℓ0 : 0 ≤ Real.log M := by linarith
  have hm0 : (0:ℝ) < m := lt_of_lt_of_le (Real.exp_pos _) hm1
  have hm1' : (1:ℝ) < m := by
    refine lt_of_lt_of_le ?_ hm1
    rw [← Real.exp_zero]
    exact Real.exp_lt_exp.mpr (Real.rpow_pos_of_pos (by linarith) _)
  have hm2nat : 2 ≤ m := by
    have : 1 < m := by exact_mod_cast hm1'
    omega
  have hlogm : Real.log m ≤ Real.log M := by
    have hA1 : Real.log m ≤ Real.log ((m : ℝ) + 1) := Real.log_le_log hm0 (by linarith)
    have hB1 : Real.log ((m : ℝ) + 1) ≤ Real.log M ^ ((1 : ℝ) / 3) := by
      calc Real.log ((m : ℝ) + 1) ≤ Real.log (Real.exp (Real.log M ^ ((1 : ℝ) / 3))) :=
            Real.log_le_log (by linarith) hm2
        _ = _ := Real.log_exp _
    have hC1 : Real.log M ^ ((1 : ℝ) / 3) ≤ Real.log M :=
      Real.rpow_le_self_of_one_le hℓ1.le (by norm_num)
    linarith
  have hmax : max 1 (Real.log m) ≤ Real.log M := max_le hℓ1.le hlogm
  
  obtain ⟨κ, hκ_def⟩ : ∃ κ : ℝ,
      κ = ρ * ((primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ)) :=
    ⟨_, rfl⟩
  obtain ⟨T₀, hT₀_def⟩ : ∃ T₀ : ℝ,
      T₀ = ρ * C_M ^ Module.finrank ℚ K * Real.log M ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hq0 : 0 ≤ (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ) := by
    positivity
  have hκ0 : 0 ≤ κ := by rw [hκ_def]; exact mul_nonneg hρ hq0
  have hκT : κ ≤ T₀ := by
    have hq : (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ)
        ≤ C_M ^ Module.finrank ℚ K * Real.log M ^ Module.finrank ℚ K := by
      calc _ ≤ (C_M * max 1 (Real.log m)) ^ Module.finrank ℚ K := hdens m
        _ ≤ (C_M * Real.log M) ^ Module.finrank ℚ K :=
            pow_le_pow_left₀ (mul_nonneg hCM0 (le_trans zero_le_one (le_max_left _ _)))
              (mul_le_mul_of_nonneg_left hmax hCM0) _
        _ = _ := mul_pow _ _ _
    rw [hκ_def, hT₀_def, mul_assoc]
    exact mul_le_mul_of_nonneg_left hq hρ
  have hT₀0 : 0 ≤ T₀ := le_trans hκ0 hκT
  have hc_bd : ∀ x, 0 ≤ cramerModel K ρ (primorial m) x ∧
