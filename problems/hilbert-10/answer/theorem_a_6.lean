theorem kai_dedekind_pole_disc_00 (K : Type u) [Field K] [NumberField K]
    (hsum : ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))) :
    ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 2 ∧
      ∀ Zf : ℂ → ℂ, Differentiable ℂ Zf →
        (∀ s : ℂ, 1 < s.re →
          Zf s = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s))) * (s - 1)) →
        ∀ s : ℂ, ‖s - 1‖ ≤ r → Zf s ≠ 0 :=
by
  classical
  
  have hregroup : ∀ (f : ℕ → ℂ), f 0 = 0 →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        f (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)))) →
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          f (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))))
        = ∑' n : ℕ,
            (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
              Ideal.absNorm I = n} : ℂ) * f n := by
    intro f hf0 hsumf
    set φ : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} → ℕ :=
      fun I => Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) with hφ
    have hsum' : Summable ((fun I => f (φ I)) ∘ (Equiv.sigmaFiberEquiv φ)) :=
      (Equiv.summable_iff (Equiv.sigmaFiberEquiv φ)).mpr hsumf
    have h1 : (∑' I, f (φ I)) = ∑' n : ℕ, ∑' c : {I // φ I = n}, f (φ (c : _)) := by
      rw [← Equiv.tsum_eq (Equiv.sigmaFiberEquiv φ) (fun I => f (φ I))]
      exact hsum'.tsum_sigma
    rw [h1]
    refine tsum_congr ?_
    intro n
    have hval : ∀ c : {I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // φ I = n},
        f (φ (c : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0})) = f n :=
      fun c => by rw [c.2]
    rw [tsum_congr hval, tsum_const, nsmul_eq_mul]
    rcases eq_or_ne n 0 with rfl | hn
    · rw [hf0, mul_zero, mul_zero]
    · have hcard : Nat.card {I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // φ I = n}
          = Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = n} := by
        refine Nat.card_congr ?_
        refine
          { toFun := fun c => ⟨((c : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)), c.2⟩
            invFun := fun d => ⟨⟨(d : Ideal (NumberField.RingOfIntegers K)), ?_⟩, d.2⟩
            left_inv := fun c => rfl
            right_inv := fun d => rfl }
        have hne : Ideal.absNorm (d : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
          rw [d.2]; exact hn
        intro h0
        apply hne
        rw [h0, Submodule.zero_eq_bot, Ideal.absNorm_bot]
      rw [hcard]
  by_cases hex : ∃ Zf : ℂ → ℂ, Differentiable ℂ Zf ∧
      ∀ s : ℂ, 1 < s.re →
        Zf s = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s))) * (s - 1)
  · obtain ⟨Zf₀, hZf₀d, hZf₀e⟩ := hex
    have hNpos : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        0 < Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) := by
      intro I
      rcases Nat.eq_zero_or_pos
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) with h | h
      · exact absurd ((Ideal.absNorm_eq_zero_iff.mp h).trans Submodule.zero_eq_bot.symm) I.2
      · exact h
    have hbridge : ∀ s : ℂ, 1 < s.re →
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)))
          = NumberField.dedekindZeta K s := by
      intro s hs
      have hs0 : s ≠ 0 := by
        intro h; rw [h, Complex.zero_re] at hs; linarith
      have hnegs : -s ≠ 0 := neg_ne_zero.mpr hs0
      have hf0 : ((0 : ℕ) : ℂ) ^ (-s) = 0 := by
        rw [Nat.cast_zero]
        exact Complex.zero_cpow hnegs
      have hnorm : (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
            ‖((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s))‖)
          = fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-s.re) := by
        funext I
        rw [Complex.norm_natCast_cpow_of_pos (hNpos I), Complex.neg_re]
      have hsumc : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s))) := by
        refine Summable.of_norm ?_
        rw [hnorm]
        exact hsum s.re hs
      have hcrux := hregroup (fun n : ℕ => ((n : ℂ) ^ (-s))) hf0 hsumc
      calc (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)))
          = ∑' n : ℕ, (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
              Ideal.absNorm I = n} : ℂ) * ((n : ℂ) ^ (-s)) := hcrux
        _ = ∑' n : ℕ, LSeries.term
              (fun m : ℕ => (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
                Ideal.absNorm I = m} : ℂ)) s n := by
              refine tsum_congr ?_
              intro n
              rcases eq_or_ne n 0 with rfl | hn
              · rw [LSeries.term_zero, Nat.cast_zero, Complex.zero_cpow hnegs, mul_zero]
              · rw [LSeries.term_of_ne_zero hn, Complex.cpow_neg, div_eq_mul_inv]
        _ = NumberField.dedekindZeta K s := rfl
    have heqf : (fun σ : ℝ =>
          ((σ : ℂ) - 1) * NumberField.dedekindZeta K (σ : ℂ))
        =ᶠ[nhdsWithin (1 : ℝ) (Set.Ioi 1)] (fun σ : ℝ => Zf₀ (σ : ℂ)) := by
      refine Filter.eventuallyEq_of_mem self_mem_nhdsWithin ?_
      intro σ hσ
      have hσre : 1 < ((σ : ℂ)).re := by
        rw [Complex.ofReal_re]; exact hσ
      show ((σ : ℂ) - 1) * NumberField.dedekindZeta K (σ : ℂ) = Zf₀ (σ : ℂ)
      rw [hZf₀e (σ : ℂ) hσre, hbridge (σ : ℂ) hσre]
      ring
    have hlim1 : Filter.Tendsto (fun σ : ℝ => Zf₀ (σ : ℂ))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1))
        (nhds ((NumberField.dedekindZeta_residue K : ℝ) : ℂ)) :=
      Filter.Tendsto.congr' heqf (NumberField.tendsto_sub_one_mul_dedekindZeta_nhdsGT K)
    have hcts : Continuous (fun σ : ℝ => Zf₀ (σ : ℂ)) :=
      hZf₀d.continuous.comp Complex.continuous_ofReal
    have hlim2 : Filter.Tendsto (fun σ : ℝ => Zf₀ (σ : ℂ))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds (Zf₀ 1)) := by
      refine tendsto_nhdsWithin_of_tendsto_nhds ?_
      have h := hcts.continuousAt (x := (1 : ℝ))
      simpa using h
    have hZ1 : Zf₀ 1 = ((NumberField.dedekindZeta_residue K : ℝ) : ℂ) :=
      tendsto_nhds_unique hlim2 hlim1
    have hZ1ne : Zf₀ 1 ≠ 0 := by
      rw [hZ1]
      exact Complex.ofReal_ne_zero.mpr (ne_of_gt (NumberField.dedekindZeta_residue_pos K))
    have hev : ∀ᶠ z : ℂ in nhds (1 : ℂ), Zf₀ z ≠ 0 :=
      (hZf₀d.continuous.continuousAt).eventually_ne hZ1ne
    obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.mp hev
    refine ⟨min (ε / 2) (1 / 2), lt_min (by linarith) (by norm_num),
      min_le_right _ _, ?_⟩
    intro Zf hd he s hsr
    have hU : IsOpen {w : ℂ | 1 < w.re} := isOpen_lt continuous_const Complex.continuous_re
    have h2mem : (2 : ℂ) ∈ {w : ℂ | 1 < w.re} := by norm_num
    have heq : Zf =ᶠ[nhds (2 : ℂ)] Zf₀ :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds h2mem)
        (fun w hw => by rw [he w hw, hZf₀e w hw])
    have ha : AnalyticOnNhd ℂ Zf Set.univ :=
      hd.differentiableOn.analyticOnNhd isOpen_univ
    have hb : AnalyticOnNhd ℂ Zf₀ Set.univ :=
      hZf₀d.differentiableOn.analyticOnNhd isOpen_univ
    have hZeq : Zf s = Zf₀ s :=
      ha.eqOn_of_preconnected_of_eventuallyEq hb isPreconnected_univ
        (Set.mem_univ (2 : ℂ)) heq (Set.mem_univ s)
    rw [hZeq]
    have hdist : dist s (1 : ℂ) < ε := by
      rw [Complex.dist_eq]
      have h1 : ‖s - 1‖ ≤ ε / 2 := le_trans hsr (min_le_left _ _)
      linarith
    exact hball hdist
  · refine ⟨1 / 2, by norm_num, le_refl _, ?_⟩
    intro Zf hd he s _
    exact absurd ⟨Zf, hd, he⟩ hex

theorem kai_principal_euler_split_00 (K : Type u) [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (hsum : ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))) :
    ∃ Pq : Finset (Ideal (NumberField.RingOfIntegers K)),
      (∀ P ∈ Pq, 2 ≤ Ideal.absNorm P) ∧
      ∀ s : ℂ, 1 < s.re →
        kaiHeckeSeries K (kaiZFPrincipalChar K q) s
          = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)))
            * ∏ P ∈ Pq, (1 - ((Ideal.absNorm P : ℂ) ^ (-s))) :=
by
  classical
  obtain ⟨Pq, hPqdef⟩ :
      ∃ X : Finset (Ideal (NumberField.RingOfIntegers K)),
        X = (UniqueFactorizationMonoid.normalizedFactors q).toFinset := ⟨_, rfl⟩
  have hmem : ∀ P : Ideal (NumberField.RingOfIntegers K),
      P ∈ Pq ↔ P ∈ UniqueFactorizationMonoid.normalizedFactors q := by
    intro P
    rw [hPqdef]
    exact Multiset.mem_toFinset
  have hprime : ∀ P ∈ Pq, Prime P := fun P hP =>
    UniqueFactorizationMonoid.prime_of_normalized_factor P ((hmem P).mp hP)
  have hnorm2 : ∀ P ∈ Pq, 2 ≤ Ideal.absNorm P := by
    intro P hP
    have hp := hprime P hP
    have h0 : Ideal.absNorm P ≠ 0 := by
      intro h
      exact hp.ne_zero ((Ideal.absNorm_eq_zero_iff.mp h).trans Submodule.zero_eq_bot.symm)
    have h1 : Ideal.absNorm P ≠ 1 := by
      intro h
      exact hp.not_unit (Ideal.isUnit_iff.mpr (Ideal.absNorm_eq_one_iff.mp h))
    omega
  have hdict : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      (I ⊔ q = ⊤ ↔ ∀ P ∈ Pq, ¬ (P ∣ I)) := by
    intro I _
    constructor
    · intro hcop P hP hdvd
      have hp := hprime P hP
      have hIP : I ≤ P := Ideal.dvd_iff_le.mp hdvd
      have hqP : q ≤ P :=
        Ideal.dvd_iff_le.mp
          (UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors ((hmem P).mp hP))
      have htop : (⊤ : Ideal (NumberField.RingOfIntegers K)) ≤ P := by
        rw [← hcop]; exact sup_le hIP hqP
      exact hp.not_unit (Ideal.isUnit_iff.mpr (top_le_iff.mp htop))
    · intro hav
      by_contra hne
      obtain ⟨M, hMmax, hMle⟩ := Ideal.exists_le_maximal (I ⊔ q) hne
      have hqM : q ≤ M := le_trans le_sup_right hMle
      have hIM : I ≤ M := le_trans le_sup_left hMle
      have hMbot : M ≠ ⊥ := by
        intro h
        rw [h, le_bot_iff] at hqM
        exact hq (hqM.trans Submodule.zero_eq_bot.symm)
      have hMprime : Prime M := Ideal.prime_of_isPrime hMbot hMmax.isPrime
      obtain ⟨P, hPmem, hass⟩ :=
        UniqueFactorizationMonoid.exists_mem_normalizedFactors_of_dvd hq
          hMprime.irreducible (Ideal.dvd_iff_le.mpr hqM)
      exact hav P ((hmem P).mpr hPmem) (hass.symm.dvd.trans (Ideal.dvd_iff_le.mpr hIM))
  refine ⟨Pq, hnorm2, ?_⟩
  intro s hs
  have hsumR := hsum s.re hs
  obtain ⟨G, hG⟩ : ∃ G : Ideal (NumberField.RingOfIntegers K) → ℂ,
      ∀ I : Ideal (NumberField.RingOfIntegers K),
        G I = ((Ideal.absNorm I : ℂ) ^ (-s)) := ⟨_, fun _ => rfl⟩
  have hNpos : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      0 < Ideal.absNorm I := by
    intro I hI
    rcases Nat.eq_zero_or_pos (Ideal.absNorm I) with h | h
    · exact absurd ((Ideal.absNorm_eq_zero_iff.mp h).trans Submodule.zero_eq_bot.symm) hI
    · exact h
  have hGnorm : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      ‖G I‖ = ((Ideal.absNorm I : ℝ)) ^ (-s.re) := by
    intro I hI
    rw [hG, Complex.norm_natCast_cpow_of_pos (hNpos I hI), Complex.neg_re]
  have hgJ : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      G (I : Ideal (NumberField.RingOfIntegers K))) := by
    refine Summable.of_norm ?_
    exact hsumR.congr
      (fun I => (hGnorm (I : Ideal (NumberField.RingOfIntegers K)) I.2).symm)
  have hGmul : ∀ A B : Ideal (NumberField.RingOfIntegers K), G (A * B) = G A * G B := by
    intro A B
    rw [hG, hG, hG, map_mul Ideal.absNorm, Nat.cast_mul,
      ← Complex.ofReal_natCast (Ideal.absNorm A), ← Complex.ofReal_natCast (Ideal.absNorm B)]
    exact Complex.mul_cpow_ofReal_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _) (-s)
  have key : ∀ S : Finset (Ideal (NumberField.RingOfIntegers K)), (∀ P ∈ S, Prime P) →
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
            I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)}, G (I : Ideal (NumberField.RingOfIntegers K)))
        = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              G (I : Ideal (NumberField.RingOfIntegers K)))
            * ∏ P ∈ S, (1 - G P) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      rw [Finset.prod_empty, mul_one]
      obtain ⟨e₀, he₀⟩ :
          ∃ e : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ (∅ : Finset (Ideal (NumberField.RingOfIntegers K))),
                  ¬ (P ∣ I)}
              ≃ {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ∀ c : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ (∅ : Finset (Ideal (NumberField.RingOfIntegers K))),
                  ¬ (P ∣ I)},
              ((e c : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
                Ideal (NumberField.RingOfIntegers K))
                = (c : Ideal (NumberField.RingOfIntegers K)) :=
        ⟨{ toFun := fun I => ⟨I.1, I.2.1⟩
           invFun := fun I => ⟨I.1, I.2, fun P hP => absurd hP (by simp)⟩
           left_inv := fun I => Subtype.ext rfl
           right_inv := fun I => Subtype.ext rfl }, fun c => rfl⟩
      refine Eq.trans ?_ (Equiv.tsum_eq e₀
        (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          G (I : Ideal (NumberField.RingOfIntegers K))))
      exact tsum_congr (fun c => by rw [he₀])
    | @insert P₀ S hP₀S ih =>
      intro hins
      have hP₀ : Prime P₀ := hins P₀ (Finset.mem_insert_self _ _)
      have hS : ∀ P ∈ S, Prime P := fun P hP => hins P (Finset.mem_insert_of_mem hP)
      have hPne : ∀ P ∈ S, ¬ (P ∣ P₀) := by
        intro P hP hdvd
        have hass : Associated P P₀ := (hS P hP).associated_of_dvd hP₀ hdvd
        have h1 : P₀ ≤ P := Ideal.dvd_iff_le.mp hdvd
        have h2 : P ≤ P₀ := Ideal.dvd_iff_le.mp hass.symm.dvd
        have hPP : P = P₀ := le_antisymm h2 h1
        rw [hPP] at hP
        exact hP₀S hP
      have hmulne : ∀ J : Ideal (NumberField.RingOfIntegers K), J ≠ 0 → P₀ * J ≠ 0 := by
        intro J hJ h
        rcases Ideal.mul_eq_bot.mp (h.trans Submodule.zero_eq_bot) with h1 | h1
        · exact hP₀.ne_zero (h1.trans Submodule.zero_eq_bot.symm)
        · exact hJ (h1.trans Submodule.zero_eq_bot.symm)
      have hdivS : ∀ J : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
          ∀ P ∈ S, ¬ (P ∣ P₀ * (J : Ideal (NumberField.RingOfIntegers K))) := by
        intro J P hP hdvd
        rcases (Prime.dvd_mul (hS P hP)).mp hdvd with h | h
        · exact hPne P hP h
        · exact J.2.2 P hP h
      have hinj : Function.Injective
          (fun J : {I : Ideal (NumberField.RingOfIntegers K) //
              I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} =>
            (⟨(J : Ideal (NumberField.RingOfIntegers K)), J.2.1⟩ :
              {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0})) := by
        intro a b hab
        exact Subtype.ext (congrArg
          (fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
            (z : Ideal (NumberField.RingOfIntegers K))) hab)
      have hA : Summable (fun J : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} =>
            G (J : Ideal (NumberField.RingOfIntegers K))) :=
        hgJ.comp_injective hinj
      have hU1 := hA.subtype {J : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
            ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}
      have hU2 := hA.subtype ({J : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
            ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ)
      have hsplit := Summable.tsum_add_tsum_compl hU1 hU2
      obtain ⟨e₁, he₁⟩ :
          ∃ e : {J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                J ∈ {J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                  ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}}
              ≃ {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ insert P₀ S, ¬ (P ∣ I)},
            ∀ c : {J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                J ∈ {J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                  ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}},
              ((e c : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ insert P₀ S, ¬ (P ∣ I)}) :
                Ideal (NumberField.RingOfIntegers K))
                = ((c.1 : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)}) :
                  Ideal (NumberField.RingOfIntegers K)) :=
        ⟨{ toFun := fun J => ⟨J.1.1, J.1.2.1,
             (Finset.forall_mem_insert _ _ _).mpr ⟨J.2, J.1.2.2⟩⟩
           invFun := fun I => ⟨⟨I.1, I.2.1, ((Finset.forall_mem_insert _ _ _).mp I.2.2).2⟩,
             ((Finset.forall_mem_insert _ _ _).mp I.2.2).1⟩
           left_inv := fun J => Subtype.ext (Subtype.ext rfl)
           right_inv := fun I => Subtype.ext rfl }, fun c => rfl⟩
      have hmemc : ∀ J : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
          (⟨P₀ * (J : Ideal (NumberField.RingOfIntegers K)), hmulne _ J.2.1, hdivS J⟩ :
            {I : Ideal (NumberField.RingOfIntegers K) //
              I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)})
            ∈ ({J : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
              ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ) := by
        intro J
        simpa using dvd_mul_right P₀ (J : Ideal (NumberField.RingOfIntegers K))
      have hbij : Function.Bijective
          (fun J : {I : Ideal (NumberField.RingOfIntegers K) //
              I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} =>
            (⟨⟨P₀ * (J : Ideal (NumberField.RingOfIntegers K)),
                hmulne _ J.2.1, hdivS J⟩, hmemc J⟩ :
              {J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                J ∈ ({J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                  ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ)})) := by
        constructor
        · intro a b hab
          have h1 : P₀ * (a : Ideal (NumberField.RingOfIntegers K))
              = P₀ * (b : Ideal (NumberField.RingOfIntegers K)) :=
            congrArg (fun z : {J : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
              J ∈ ({J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ)} =>
              (z.1 : Ideal (NumberField.RingOfIntegers K))) hab
          exact Subtype.ext (mul_left_cancel₀ hP₀.ne_zero h1)
        · rintro ⟨⟨I, hI0, hIS⟩, hIdvd⟩
          have hdvd : P₀ ∣ I := by
            simp only [Set.mem_compl_iff, Set.mem_setOf_eq, not_not] at hIdvd
            exact hIdvd
          obtain ⟨J, hJ⟩ := hdvd
          have hJ0 : J ≠ 0 := by
            intro h
            rw [h, mul_zero] at hJ
            exact hI0 hJ
          have hJS : ∀ P ∈ S, ¬ (P ∣ J) := by
            intro P hP hd
            apply hIS P hP
            rw [hJ]
            exact hd.mul_left P₀
          exact ⟨⟨J, hJ0, hJS⟩, Subtype.ext (Subtype.ext hJ.symm)⟩
      obtain ⟨e₂, he₂⟩ :
          ∃ e : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)}
              ≃ {J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                J ∈ ({J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                  ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ)},
            ∀ J : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
              (((e J).1 : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)}) :
                Ideal (NumberField.RingOfIntegers K))
                = P₀ * (J : Ideal (NumberField.RingOfIntegers K)) :=
        ⟨Equiv.ofBijective _ hbij, fun J => rfl⟩
      have star :
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ insert P₀ S, ¬ (P ∣ I)},
              G (I : Ideal (NumberField.RingOfIntegers K)))
            = (1 - G P₀) * ∑' J : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
                G (J : Ideal (NumberField.RingOfIntegers K)) := by
        have hEq1 :
            (∑' x : {J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                J ∈ {J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                  ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}},
                G (x.1 : Ideal (NumberField.RingOfIntegers K)))
              = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ insert P₀ S, ¬ (P ∣ I)},
                  G (I : Ideal (NumberField.RingOfIntegers K)) := by
          refine Eq.trans ?_ (Equiv.tsum_eq e₁
            (fun I : {I : Ideal (NumberField.RingOfIntegers K) //
                I ≠ 0 ∧ ∀ P ∈ insert P₀ S, ¬ (P ∣ I)} =>
              G (I : Ideal (NumberField.RingOfIntegers K))))
          exact tsum_congr (fun c => by rw [he₁])
        have hEq2 :
            (∑' x : {J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                J ∈ ({J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                  ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ)},
                G (x.1 : Ideal (NumberField.RingOfIntegers K)))
              = G P₀ * ∑' J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
                  G (J : Ideal (NumberField.RingOfIntegers K)) := by
          have h1 :
              (∑' J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
                  G (((e₂ J).1 : Ideal (NumberField.RingOfIntegers K))))
                = ∑' x : {J : {I : Ideal (NumberField.RingOfIntegers K) //
                      I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                    J ∈ ({J : {I : Ideal (NumberField.RingOfIntegers K) //
                        I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                      ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ)},
                    G (x.1 : Ideal (NumberField.RingOfIntegers K)) :=
            Equiv.tsum_eq e₂ (fun x : {J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} //
                J ∈ ({J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)} |
                  ¬ (P₀ ∣ (J : Ideal (NumberField.RingOfIntegers K)))}ᶜ)} =>
              G (x.1 : Ideal (NumberField.RingOfIntegers K)))
          have h2 :
              (∑' J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
                  G (((e₂ J).1 : Ideal (NumberField.RingOfIntegers K))))
                = ∑' J : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
                    G P₀ * G (J : Ideal (NumberField.RingOfIntegers K)) :=
            tsum_congr (fun J => by
              rw [he₂ J]
              exact hGmul P₀ (J : Ideal (NumberField.RingOfIntegers K)))
          rw [← h1, h2]
          exact tsum_mul_left
        have hcomb :
            (∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ insert P₀ S, ¬ (P ∣ I)},
                G (I : Ideal (NumberField.RingOfIntegers K)))
              + G P₀ * (∑' J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
                  G (J : Ideal (NumberField.RingOfIntegers K)))
              = ∑' J : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ ∀ P ∈ S, ¬ (P ∣ I)},
                  G (J : Ideal (NumberField.RingOfIntegers K)) := by
          rw [← hEq1, ← hEq2]
          exact hsplit
        linear_combination hcomb
      rw [star, ih hS, Finset.prod_insert hP₀S]
      ring
  have hsupp : Function.support
        (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
      ⊆ {I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} |
          (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤} := by
    intro I hI
    by_contra hcon
    apply hI
    have hzero : kaiZFPrincipalChar K q (I : Ideal (NumberField.RingOfIntegers K)) = 0 := by
      simp only [kaiZFPrincipalChar]
      rw [if_neg]
      rintro ⟨-, h2⟩
      exact hcon h2
    simp only [hzero, zero_div]
  have hT :
      (∑' x : {I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} |
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤},
          kaiZFPrincipalChar K q ((x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm ((x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
                Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
        = kaiHeckeSeries K (kaiZFPrincipalChar K q) s :=
    tsum_subtype_eq_of_support_subset hsupp
  have hval : ∀ x : {I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} |
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤},
      kaiZFPrincipalChar K q ((x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
          Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm ((x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)
        = G ((x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) := by
    intro x
    have hone : kaiZFPrincipalChar K q
        ((x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
          Ideal (NumberField.RingOfIntegers K)) = 1 := by
      simp only [kaiZFPrincipalChar]
      rw [if_pos ⟨(x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}).2, x.2⟩]
    rw [hone, hG, one_div, ← Complex.cpow_neg]
  obtain ⟨eT, heT⟩ :
      ∃ e : {I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} |
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤}
          ≃ {I : Ideal (NumberField.RingOfIntegers K) //
              I ≠ 0 ∧ ∀ P ∈ Pq, ¬ (P ∣ I)},
        ∀ c : {I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} |
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤},
