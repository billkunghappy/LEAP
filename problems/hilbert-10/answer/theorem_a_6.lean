      δ * (2 * (H : ℝ)) ^ r ≤ (E.card : ℝ) →
      (∀ h ∈ E, ∀ j,
        |(c j + ∑ k, A j k * ((∑ i, (h i : ℝ) * α i k) - round (∑ i, (h i : ℝ) * α i k)))
          - round (c j + ∑ k, A j k *
              ((∑ i, (h i : ℝ) * α i k) - round (∑ i, (h i : ℝ) * α i k)))| ≤ ε) →
    ∃ (s t : ℕ) (w : Fin s → ι → ℤ) (η : Fin t → ι → ℤ),
      s + t = Fintype.card ι ∧
      LinearIndependent ℝ (fun i k => (w i k : ℝ)) ∧
      LinearIndependent ℝ (fun i k => (η i k : ℝ)) ∧
      (∀ i i', ∑ k, w i k * η i' k = 0) ∧
      (∀ i k, |(w i k : ℝ)| ≤ Real.exp ((2 + (Fintype.card ι : ℝ) + (r : ℝ)
          + Real.log M + Real.log (1 / δ)) ^ C₀)) ∧
      (∀ i k, |(η i k : ℝ)| ≤ Real.exp ((2 + (Fintype.card ι : ℝ) + (r : ℝ)
          + Real.log M + Real.log (1 / δ)) ^ C₀)) ∧
      (∀ i' j, |(∑ k, (η i' k : ℝ) * α j k) - round (∑ k, (η i' k : ℝ) * α j k)|
          ≤ Real.exp ((2 + (Fintype.card ι : ℝ) + (r : ℝ) + Real.log M
              + Real.log (1 / δ)) ^ C₀) * (ε + 1 / (H : ℝ))) ∧
