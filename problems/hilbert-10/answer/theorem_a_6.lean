noncomputable def qSiegelModel (K : Type u) [Field K] [NumberField K] (ρ : ℝ)
    (𝔮 𝔮D : Ideal (NumberField.RingOfIntegers K))
    (ψ : NumberField.RingOfIntegers K → ℤ) (β : ℝ) (x : NumberField.RingOfIntegers K) : ℝ :=
  if IsCoprime (Ideal.span {x}) 𝔮 then
    ρ * ((Ideal.absNorm 𝔮 : ℝ) / (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔮)ˣ) : ℝ))
      - ρ * ((Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) /
          (Nat.card ((NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D))ˣ) : ℝ))
        * (ψ x : ℝ) * (((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1))
  else 0
abbrev KaiPattern (K : Type u) [Field K] [NumberField K] : Type u :=
  {w : NumberField.InfinitePlace K // w.IsReal} → Bool


def kaiPatt {K : Type u} [Field K] [NumberField K] (o : KaiPattern K)
    (x : NumberField.RingOfIntegers K) : Prop :=
  ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
    (0 < NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) ↔ o w = true)


def kaiCutoffSet {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M Y : ℝ) (o : KaiPattern K) :
    Set (NumberField.RingOfIntegers K) :=
  {x | x ∈ omegaBox ω M ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y ∧ kaiPatt o x}

open scoped Classical in

noncomputable def kaiCutoffPiece {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M ρ : ℝ) (W : ℕ)
    (ψ : NumberField.RingOfIntegers K → ℤ) (Y : ℝ) (o : KaiPattern K)
    (x : NumberField.RingOfIntegers K) : ℝ :=
  if x ∈ kaiCutoffSet ω M Y o then cramerModel K ρ W x * (ψ x : ℝ) else 0


def KaiLineProp {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K))
    (S : Set (NumberField.RingOfIntegers K)) (J : ℕ) : Prop :=
  ∀ (x : NumberField.RingOfIntegers K) (k : Fin ν), ∃ I : Finset (ℤ × ℤ), I.card ≤ J ∧
    ∀ t : ℤ, (x + t • ω k ∈ S ↔ ∃ p ∈ I, p.1 ≤ t ∧ t ≤ p.2)


noncomputable def kaiShift {K : Type u} [Field K] [NumberField K]
    (x : NumberField.RingOfIntegers K) : ℕ :=
  ⌈∑ w : NumberField.InfinitePlace K, w (x : K)⌉₊ + 1


noncomputable def kaiFplus {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (ψ : NumberField.RingOfIntegers K → ℤ)
    (x : NumberField.RingOfIntegers K) : ℤ :=
  ψ (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K))

open scoped Classical in

noncomputable def kaiGplus {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (ψ : NumberField.RingOfIntegers K → ℤ)
    (x : NumberField.RingOfIntegers K) : ℝ :=
  if CoprimeToNat (Ideal.absNorm 𝔮) x then (kaiFplus 𝔮 ψ x : ℝ) else 0

open scoped Classical in

noncomputable def kaiW2 (m Q : ℕ) : ℕ :=
  ∏ p ∈ (Finset.range (m + 1)).filter (fun p => p.Prime ∧ ¬ p ∣ Q), p

open scoped Classical in

noncomputable def kaiResSys {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (Q : ℕ) :
    Finset (NumberField.RingOfIntegers K) :=
  (resBox ν Q).image (fun v => ω.equivFun.symm v)


noncomputable def kaiResSum {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (Q : ℕ)
    (Φ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
      NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℝ) : ℝ :=
  ∑ a ∈ kaiResSys ω Q, ∑ h₁ ∈ kaiResSys ω Q, ∑ h₂ ∈ kaiResSys ω Q, ∑ h₃ ∈ kaiResSys ω Q,
    Φ a h₁ h₂ h₃

open scoped Classical in

noncomputable def kaiCubeSieveSum {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) (W₂ : ℕ)
    (S : Set (NumberField.RingOfIntegers K))
    (Φ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
      NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℝ) : ℝ :=
  ∑ x ∈ omegaBox ω M, ∑ h₁ ∈ omegaBox ω (2 * M), ∑ h₂ ∈ omegaBox ω (2 * M),
    ∑ h₃ ∈ omegaBox ω (2 * M),
      if ∀ ε : Fin 3 → Fin 2, cubeVertex x h₁ h₂ h₃ ε ∈ S ∧
          CoprimeToNat W₂ (cubeVertex x h₁ h₂ h₃ ε)
      then Φ x h₁ h₂ h₃ else 0


def KaiCharU3Bound {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K))
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (ψ : NumberField.RingOfIntegers K → ℤ)
    (C₃ : ℝ) : Prop :=
  |kaiResSum ω (Ideal.absNorm 𝔮)
      (fun a h₁ h₂ h₃ => ∏ ε : Fin 3 → Fin 2, kaiGplus 𝔮 ψ (cubeVertex a h₁ h₂ h₃ ε))
      / (Ideal.absNorm 𝔮 : ℝ) ^ (4 * ν)|
    ≤ C₃ / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4)


def KaiCubeEquidist {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) (m Q : ℕ)
    (S : Set (NumberField.RingOfIntegers K)) (C₄ : ℝ) : Prop :=
  ∃ T : ℝ, |T| ≤ C₄ * ((omegaBox ω M).card : ℝ) ^ 4 ∧
    ∀ Φ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
        NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℝ,
      (∀ x h₁ h₂ h₃, |Φ x h₁ h₂ h₃| ≤ 1) →
      (∀ x h₁ h₂ h₃ y₀ y₁ y₂ y₃ : NumberField.RingOfIntegers K,
        Φ (x + (Q : NumberField.RingOfIntegers K) * y₀)
          (h₁ + (Q : NumberField.RingOfIntegers K) * y₁)
          (h₂ + (Q : NumberField.RingOfIntegers K) * y₂)
          (h₃ + (Q : NumberField.RingOfIntegers K) * y₃) = Φ x h₁ h₂ h₃) →
      |kaiCubeSieveSum ω M (kaiW2 m Q) S Φ - T * kaiResSum ω Q Φ / (Q : ℝ) ^ (4 * ν)|
        ≤ C₄ * ((omegaBox ω M).card : ℝ) ^ 4 * Real.exp (-(Real.log M ^ ((1:ℝ)/3)))


def KaiCharLift {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (ψ : NumberField.RingOfIntegers K → ℤ)
    (o : KaiPattern K) : Prop :=
  (∀ x y : NumberField.RingOfIntegers K,
    kaiFplus 𝔮 ψ (x + (Ideal.absNorm 𝔮 : NumberField.RingOfIntegers K) * y) = kaiFplus 𝔮 ψ x) ∧
  (∀ x, kaiFplus 𝔮 ψ x = 1 ∨ kaiFplus 𝔮 ψ x = -1 ∨ kaiFplus 𝔮 ψ x = 0) ∧
  ∃ ζ : ℤ, (ζ = 1 ∨ ζ = -1) ∧
    ∀ v : NumberField.RingOfIntegers K, v ≠ 0 → kaiPatt o v → ψ v = ζ * kaiFplus 𝔮 ψ v
def IsTorusQuadSeq (ν : ℕ) (D Q : ℝ) (φ : (Fin ν → ℤ) → ℝ) : Prop :=
  ∃ (b : ℕ) (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ)
    (F : (Fin b → ℝ) → ℝ),
    (b : ℝ) ≤ D ∧ (∀ u, |F u| ≤ 1) ∧
    (∀ u (γ : Fin b → ℤ), F (fun k => u k + (γ k : ℝ)) = F u) ∧
    (∀ u v, |F u - F v| ≤ Q * ∑ k, |u k - v k|) ∧
    ∀ z : Fin ν → ℤ, φ z = F (fun k => r₀ k + ∑ l, (z l : ℝ) * r₁ l k
                                + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * r₂ l l' k)


def IsNil2VertSeq (ν : ℕ) (D Q : ℝ) (φ : (Fin ν → ℤ) → ℂ) : Prop :=
  ∃ (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ)
    (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ),
    ((a + b : ℕ) : ℝ) ≤ D ∧ (∀ i j k, |(Bc i j k : ℝ)| ≤ Q) ∧ (∀ k, |(ξ k : ℝ)| ≤ Q) ∧ ξ ≠ 0 ∧
    (∀ u, ‖F u‖ ≤ Q) ∧
    (∀ u (γ₁ : Fin a → ℤ) (γ₂ : Fin b → ℤ),
        F (nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))) = F u) ∧
    (∀ u (t : Fin b → ℝ), F (u.1, fun k => u.2 k + t k)
        = Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ξ k : ℝ) * t k : ℝ) : ℂ)) * F u) ∧
    (∀ u v : (Fin a → ℝ) × (Fin b → ℝ),
        (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ k, -1 ≤ u.2 k ∧ u.2 k ≤ 2) →
        (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, -1 ≤ v.2 k ∧ v.2 k ≤ 2) →
        ‖F u - F v‖ ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|)) ∧
    ∀ z : Fin ν → ℤ, φ z =
      F ((fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i),
         (fun k => r₀ k + ∑ l, (z l : ℝ) * r₁ l k
                    + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * r₂ l l' k))
noncomputable def giBr (t : ℝ) : ℝ := t - round t


noncomputable def giBrZ (P : ℕ) (k : ZMod P) : ℝ := giBr ((k.val : ℝ) / P)


noncomputable def giCut (r₁ r₂ s : ℝ) : ℝ := max 0 (min 1 ((r₂ - |s|) / (r₂ - r₁)))
noncomputable def finU3Avg {A : Type*} [AddCommGroup A] (f : A → ℝ) : ℝ :=
  (∑ᶠ p : A × A × A × A, ∏ ε : Fin 3 → Fin 2, f (cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε))
    / (Nat.card A : ℝ) ^ 4


def IsPrimRealCharMod {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (F : NumberField.RingOfIntegers K → ℤ) : Prop :=
  F 1 = 1 ∧
  (∀ x y, x - y ∈ 𝔮 → F x = F y) ∧
  (∀ x y, F (x * y) = F x * F y) ∧
  (∀ x, IsCoprime (Ideal.span {x}) 𝔮 → F x = 1 ∨ F x = -1) ∧
  (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔮 < 𝔡 →
    ∃ r, r - 1 ∈ 𝔡 ∧ IsCoprime (Ideal.span {r}) 𝔮 ∧ F r = -1)
noncomputable def kaiHZInfSize (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) : ℝ :=
  1 + (∑ w : NumberField.InfinitePlace K, |t w|)
    + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)|

def KaiHZPoissonProp : Prop :=
  ∀ (d : ℕ) (b c : Fin d → EuclideanSpace ℝ (Fin d)),
    (∀ i j, (inner ℝ (b i) (c j) : ℝ) = if i = j then (1 : ℝ) else 0) →
    ∀ (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (v : EuclideanSpace ℝ (Fin d)),
      (∑' m : Fin d → ℤ, f (v + ∑ i, (m i : ℝ) • b i))
        = ((|(Matrix.of fun i j => b i j).det| : ℝ) : ℂ)⁻¹ *
            ∑' m : Fin d → ℤ,
              FourierTransform.fourier (fun x => f x) (∑ i, (m i : ℝ) • c i) *
                Complex.exp (2 * Real.pi * Complex.I *
                  ((inner ℝ (∑ i, (m i : ℝ) • c i) v : ℝ) : ℂ))

def KaiHZGammaBoundProp : Prop :=
  (∀ x y : ℝ, 0 < x → ‖Complex.Gamma ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ Real.Gamma x) ∧
  (∀ x y : ℝ, 1 ≤ x →
      Real.Gamma x * Real.exp (-(y ^ 2)) ≤ ‖Complex.Gamma ((x : ℂ) + (y : ℂ) * Complex.I)‖)

noncomputable def kaiHZCplxWeight (l : ℤ) (z : ℂ) : ℂ :=
  if 0 ≤ l then z ^ l.toNat else (starRingEnd ℂ) z ^ (-l).toNat

def KaiHZTestFourierProp : Prop :=
  (∀ y : ℝ, 0 < y → ∀ ε : ℕ, ε ≤ 1 → ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ ξ : ℝ,
      FourierTransform.fourier
          (fun x : ℝ => (x : ℂ) ^ ε * Complex.exp (((-(Real.pi * y * x ^ 2) : ℝ) : ℂ))) ξ
        = c * ((y ^ (-((1 : ℝ) / 2 + (ε : ℝ))) : ℝ) : ℂ) * (ξ : ℂ) ^ ε *
            Complex.exp (((-(Real.pi * ξ ^ 2 / y) : ℝ) : ℂ))) ∧
  (∀ y : ℝ, 0 < y → ∀ l : ℤ, ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ w : ℂ,
      FourierTransform.fourier (fun z : ℂ => kaiHZCplxWeight l z *
          Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ))) w
        = c * ((y ^ (-(1 + |(l : ℝ)|)) : ℝ) : ℂ) * kaiHZCplxWeight l w *
            Complex.exp (((-(Real.pi * ‖w‖ ^ 2 / y) : ℝ) : ℂ)))

noncomputable def kaiHZArchWeight (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (x : NumberField.mixedEmbedding.mixedSpace K) : ℂ :=
  (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
      if η w then ((x.1 w : ℝ) : ℂ) else 1) *
    ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, kaiHZCplxWeight (l p) (x.2 p)

noncomputable def kaiHZGaussian (K : Type u) [Field K] [NumberField K]
    (y : NumberField.InfinitePlace K → ℝ)
    (x : NumberField.mixedEmbedding.mixedSpace K) : ℝ :=
  Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
    y w * NumberField.mixedEmbedding.normAtPlace w x ^ 2))

noncomputable def kaiHZMixedInner (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (x v : NumberField.mixedEmbedding.mixedSpace K) : ℝ :=
  (∑ w : {w : NumberField.InfinitePlace K // w.IsReal}, x.1 w * v.1 w) +
    ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (x.2 p * (starRingEnd ℂ) (v.2 p)).re

open scoped Classical in
noncomputable def kaiHZDeg (K : Type u) [Field K] [NumberField K]
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (w : NumberField.InfinitePlace K) : ℝ :=
  if hw : w.IsReal then (if η ⟨w, hw⟩ then 1 else 0)
  else |((l ⟨w, w.isReal_or_isComplex.resolve_left hw⟩ : ℤ) : ℝ)|

noncomputable def kaiHZIdealTheta (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (a : Ideal (NumberField.RingOfIntegers K))
    (ρ : NumberField.mixedEmbedding.mixedSpace K)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (y : NumberField.InfinitePlace K → ℝ) : ℂ :=
  ∑' μ : ↥a,
    kaiHZArchWeight K η l
        (ρ + NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K)) *
      ((kaiHZGaussian K y
        (ρ + NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ)

noncomputable def kaiHZIdealThetaChar (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (b : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (v : NumberField.mixedEmbedding.mixedSpace K)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (y : NumberField.InfinitePlace K → ℝ) : ℂ :=
  ∑' ν : {x : K // x ∈ (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)},
    kaiHZArchWeight K η l (NumberField.mixedEmbedding K (ν : K)) *
      ((kaiHZGaussian K y (NumberField.mixedEmbedding K (ν : K)) : ℝ) : ℂ) *
      Complex.exp (2 * Real.pi * Complex.I *
        ((kaiHZMixedInner K (NumberField.mixedEmbedding K (ν : K)) v : ℝ) : ℂ))

def KaiHZIdealThetaProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ B : ℝ, 1 ≤ B ∧
    ∀ a : Ideal (NumberField.RingOfIntegers K), a ≠ 0 →
      ∀ (ρ : NumberField.mixedEmbedding.mixedSpace K)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
        (∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
            Summable (fun μ : ↥a =>
              ‖kaiHZArchWeight K η l (ρ +
                  NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K))‖ *
                kaiHZGaussian K y (ρ +
                  NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K)))) ∧
        ∃ (b : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
          (v : NumberField.mixedEmbedding.mixedSpace K) (κ : ℂ)
          (r : NumberField.InfinitePlace K → ℝ),
          (∀ w, 0 < r w) ∧
          (∀ w, 1 / B ≤ r w ∧ r w ≤ B) ∧
          ((FractionalIdeal.absNorm
              (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℚ) : ℝ)
            ≤ B * (Ideal.absNorm a : ℝ) ^ B ∧
          (1 : ℝ) / (B * (Ideal.absNorm a : ℝ) ^ B)
            ≤ ((FractionalIdeal.absNorm
              (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℚ) : ℝ) ∧
          ‖κ‖ * (∏ w : NumberField.InfinitePlace K,
              r w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)))
            ≤ B * (Ideal.absNorm a : ℝ) ^ B ∧
          (∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
              Summable (fun ν : {x : K //
                  x ∈ (b : FractionalIdeal
                    (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
                ‖kaiHZArchWeight K η (fun p => -l p)
                    (NumberField.mixedEmbedding K (ν : K))‖ *
                  kaiHZGaussian K y (NumberField.mixedEmbedding K (ν : K)))) ∧
          (∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
              kaiHZIdealTheta K a ρ η l y
                = κ * (((∏ w : NumberField.InfinitePlace K,
                      y w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ) *
                    kaiHZIdealThetaChar K b v η (fun p => -l p) (fun w => r w / y w))

def KaiHZZetaConvProp (K : Type u) [Field K] [NumberField K] : Prop :=
  ∃ Z : ℝ, 0 < Z ∧
    (∀ σ : ℝ, 1 < σ →
        Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))) ∧
    (∀ σ : ℝ, (3 : ℝ) / 2 ≤ σ →
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)) ≤ Z)

def KaiHZClassCoprimeProp (K : Type u) [Field K] [NumberField K] : Prop :=
  ∀ q J : Ideal (NumberField.RingOfIntegers K), q ≠ 0 → J ≠ 0 →
    ∃ (J' : Ideal (NumberField.RingOfIntegers K)) (a b : NumberField.RingOfIntegers K),
      J' ≠ 0 ∧ J' ⊔ q = ⊤ ∧ a ≠ 0 ∧ b ≠ 0 ∧
        Ideal.span {a} * J = Ideal.span {b} * J'

def KaiHZHeckeFEProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ A₂ : ℝ, 1 ≤ A₂ ∧
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (t : NumberField.InfinitePlace K → ℝ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q t l ξ η lam →
        (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
        ∃ (E : ℕ) (G H : ℂ → ℂ) (α : NumberField.InfinitePlace K → ℝ)
          (β : NumberField.InfinitePlace K → ℂ),
          E ≤ 1 ∧ (E = 1 ↔ KaiHeckePrincipal K q lam) ∧
          Differentiable ℂ G ∧
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) ∧
          (∀ w : NumberField.InfinitePlace K, (1 : ℝ) / 2 ≤ α w ∧ α w ≤ 1) ∧
          (∀ w : NumberField.InfinitePlace K,
              0 ≤ (β w).re ∧ ‖β w‖ ≤ A₂ * (1 + kaiHZInfSize K t l)) ∧
          (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
              G s * (∏ w : NumberField.InfinitePlace K,
                  Complex.Gamma ((α w : ℂ) * s + β w + 3))
