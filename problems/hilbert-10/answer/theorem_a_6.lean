  have hX0 : 0 < X := by linarith
  have hIcard : ((intBox (Module.finrank ℚ K) ⌊M⌋₊).card : ℝ) = X ^ Module.finrank ℚ K := by
    have hc : (intBox (Module.finrank ℚ K) ⌊M⌋₊).card
        = (2 * ⌊M⌋₊ + 1) ^ Module.finrank ℚ K := by
