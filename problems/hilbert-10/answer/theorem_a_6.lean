    Finset.prod_pos (fun p hp => (Finset.mem_filter.mp hp).2.pos)
  have hprim : (∏ p ∈ (Finset.range (⌊x⌋₊ + 1)).filter Nat.Prime, p) ≤ 4 ^ ⌊x⌋₊ :=
    primorial_le_4_pow ⌊x⌋₊
  have hlogprod : (∑ p ∈ (Finset.range (⌊x⌋₊ + 1)).filter Nat.Prime, Real.log ((p : ℕ) : ℝ))
      = Real.log (((∏ p ∈ (Finset.range (⌊x⌋₊ + 1)).filter Nat.Prime, p : ℕ) : ℝ)) := by
    rw [Nat.cast_prod, Real.log_prod]
    intro p hp
    exact Nat.cast_ne_zero.mpr (Finset.mem_filter.mp hp).2.ne_zero
  have hlog4 : Real.log 4 ≤ 2 := by
    have h : Real.log 4 = 2 * Real.log 2 := by
