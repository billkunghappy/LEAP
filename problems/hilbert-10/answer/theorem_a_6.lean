theorem kai_torus_fourier_approx (b : ℕ) (F : (Fin b → ℝ) → ℝ) (Q ε : ℝ)
    (hQ : 0 ≤ Q) (hε : 0 < ε) (hε1 : ε ≤ 1)
    (hF1 : ∀ u, |F u| ≤ 1)
    (hFper : ∀ u (γ : Fin b → ℤ), F (fun k => u k + (γ k : ℝ)) = F u)
    (hFlip : ∀ u v, |F u - F v| ≤ Q * ∑ k, |u k - v k|) :
    ∃ (k : ℕ) (ξ : Fin k → Fin b → ℤ) (a : Fin k → ℂ),
      (k : ℝ) ≤ (20 * ((b : ℝ) + 1) ^ 2 * (Q + 1) ^ 2 / ε ^ 2) ^ b ∧
      (∀ j, ‖a j‖ ≤ 1) ∧
      ∀ u : Fin b → ℝ, |F u - (∑ j, a j * giE (∑ i, (ξ j i : ℝ) * u i)).re| ≤ ε :=
by
  classical
  
  obtain ⟨Y, hY⟩ : ∃ Y : ℝ, Y = ((b : ℝ) + 1) * (Q + 1) / ε := ⟨_, rfl⟩
  have hb0 : (0 : ℝ) ≤ b := Nat.cast_nonneg b
  have hBQ : (1 : ℝ) ≤ ((b : ℝ) + 1) * (Q + 1) := by nlinarith
  have hεY : ε * Y = ((b : ℝ) + 1) * (Q + 1) := by rw [hY]; field_simp
  have hY1 : 1 ≤ Y := by nlinarith
  have hY0 : 0 < Y := by linarith
  obtain ⟨X, hX⟩ : ∃ X : ℝ, X = Y ^ 2 := ⟨_, rfl⟩
  have hX1 : 1 ≤ X := by rw [hX]; nlinarith
  obtain ⟨R, hRdef⟩ : ∃ R : ℕ, R = ⌈X⌉₊ := ⟨_, rfl⟩
  have hR1 : 1 ≤ R := by rw [hRdef]; exact Nat.one_le_ceil_iff.mpr (by linarith)
  have hXR : X ≤ (R : ℝ) := by rw [hRdef]; exact Nat.le_ceil X
  have hRX : (R : ℝ) < X + 1 := by rw [hRdef]; exact Nat.ceil_lt_add_one (by linarith)
  have hRpos : (0 : ℝ) < R := by exact_mod_cast hR1
  have herr : Q * b / Real.sqrt R ≤ ε := by
    have hYs : Y ≤ Real.sqrt R := by
      calc Y = Real.sqrt (Y ^ 2) := (Real.sqrt_sq hY0.le).symm
        _ ≤ Real.sqrt R := Real.sqrt_le_sqrt (by rw [← hX]; exact hXR)
    calc Q * b / Real.sqrt R ≤ Q * b / Y :=
          div_le_div_of_nonneg_left (mul_nonneg hQ hb0) hY0 hYs
      _ ≤ ε := by
          rw [div_le_iff₀ hY0, hεY]; nlinarith
  have hcnt : (((2 * R) ^ b : ℕ) : ℝ) ≤ (20 * ((b : ℝ) + 1) ^ 2 * (Q + 1) ^ 2 / ε ^ 2) ^ b := by
    have h20 : 20 * ((b : ℝ) + 1) ^ 2 * (Q + 1) ^ 2 / ε ^ 2 = 20 * X := by
      rw [hX, hY, div_pow, mul_pow]; ring
    rw [h20]; push_cast
    exact pow_le_pow_left₀ (by positivity) (by linarith) b
  
  have hFc : Continuous F := by
    have hlip : LipschitzWith ⟨Q * b, mul_nonneg hQ hb0⟩ F := by
      apply LipschitzWith.of_dist_le_mul
      intro u v
      rw [Real.dist_eq, NNReal.coe_mk]
      calc |F u - F v| ≤ Q * ∑ k, |u k - v k| := hFlip u v
        _ ≤ Q * ∑ _k : Fin b, dist u v := by
          apply mul_le_mul_of_nonneg_left _ hQ
          apply Finset.sum_le_sum; intro k _
          rw [← Real.dist_eq]; exact dist_le_pi_dist u v k
        _ = Q * b * dist u v := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
    exact hlip.continuous
  
  have hcn : ∀ ζ : Fin b → ℤ, ‖∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F w : ℂ) *
      Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ)))‖ ≤ 1 := by
    intro ζ
