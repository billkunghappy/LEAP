      refine le_trans (Finset.sum_le_sum (fun k _ => hbd k)) ?_
      rw [← Finset.sum_mul]
      exact mul_le_mul_of_nonneg_right hCasumle (Real.exp_pos _).le
    have hpos : (0 : ℝ) < (hh : ℝ) := lt_of_lt_of_le one_pos hhR1
    rw [div_le_iff₀ hpos]
    exact hnum.trans (le_mul_of_one_le_right (mul_pos hCa₁0 (Real.exp_pos _)).le hhR1)
  have hHfedge : ∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
      ‖Hf s‖ ≤ A₃ * ((Ideal.absNorm q : ℝ) * (1 + kaiHZInfSize K t l) * (2 + |s.im|)) ^ A₃ *
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
            (-((3 : ℝ) / 2)) := by
    intro s hs
    obtain ⟨X, hXdef⟩ : ∃ X : ℝ,
