    have hexp1 : Real.exp (-Real.sqrt (Real.log T') / c₂') ≤ 1 := by
      rw [Real.exp_le_one_iff, neg_div]
      have : 0 ≤ Real.sqrt (Real.log T') / c₂' := div_nonneg (Real.sqrt_nonneg _) hc₂'.le
