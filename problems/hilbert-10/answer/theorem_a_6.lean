        have hc' : (A.card : ℝ) ≤ (((⌊D⌋ + 1).toNat : ℕ) : ℝ) := by exact_mod_cast hc
        rw [e2] at hc'
        linarith [Int.floor_le D]
    obtain ⟨n, hn⟩ : ∃ n : ℤ, n = round ((d : ℝ) * α) := ⟨_, rfl⟩
    rw [← hn] at hdα ⊢
    obtain ⟨β, hβ⟩ : ∃ β : ℝ, β = (d : ℝ) * α - (n : ℝ) := ⟨_, rfl⟩
    rw [← hβ] at hdα ⊢
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    have hdZ : (0 : ℤ) < (d : ℤ) := by exact_mod_cast hd
    have hK0 : (0 : ℝ) < 2 * (M : ℝ) + 1 := by positivity
    have hρ0 : 0 ≤ 8 * ε / (σ ^ 2 * (2 * (M : ℝ) + 1)) := by positivity
