noncomputable def kaiMFDualCoeff (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (bf : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (vv : NumberField.mixedEmbedding.mixedSpace K)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (σ : NumberField.InfinitePlace K → ℝ) : ℂ :=
  ∑' ν : {x : K // x ∈ (bf : FractionalIdeal
      (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ∧
      (fun w : NumberField.InfinitePlace K => w x) = σ},
    kaiHZArchWeight K η l (NumberField.mixedEmbedding K ((ν : K))) *
