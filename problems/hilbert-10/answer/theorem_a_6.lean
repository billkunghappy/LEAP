                       mul_nonneg (mul_nonneg (by linarith : (0 : ℝ) ≤ 12 * C₂) hΛ0.le)
                        (by linarith : (0 : ℝ) ≤ X - 1),
                       mul_nonneg hΛ0.le hXpos.le]
