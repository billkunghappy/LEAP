  obtain ⟨rr, hrrR, hrrC⟩ :
      ∃ rr : NumberField.InfinitePlace K → ℝ,
        (∀ w, w.IsReal → rr w = 1) ∧ (∀ w, ¬ w.IsReal → rr w = 4) :=
    ⟨fun w => if w.IsReal then 1 else 4, fun w hw => if_pos hw, fun w hw => if_neg hw⟩
  
  have hc2 : (starRingEnd ℂ) 2 = 2 := map_ofNat (starRingEnd ℂ) 2
  have hcw : ∀ (k : ℤ) (z : ℂ),
      kaiHZCplxWeight k (2 * (starRingEnd ℂ) z)
        = (2 : ℂ) ^ k.natAbs * kaiHZCplxWeight (-k) z := by
    intro k z
    rcases lt_trichotomy k 0 with hk | hk | hk
    · have h1 : ¬ ((0 : ℤ) ≤ k) := by omega
      have h2 : (0 : ℤ) ≤ -k := by omega
      have he : (-k).toNat = k.natAbs := by omega
      simp only [kaiHZCplxWeight, if_neg h1, if_pos h2]
      rw [map_mul, hc2, Complex.conj_conj, mul_pow, he]
    · subst hk
      simp [kaiHZCplxWeight]
    · have h1 : (0 : ℤ) ≤ k := by omega
      have h2 : ¬ ((0 : ℤ) ≤ -k) := by omega
      have he1 : k.toNat = k.natAbs := by omega
      have he2 : (-(-k)).toNat = k.natAbs := by omega
      simp only [kaiHZCplxWeight, if_pos h1, if_neg h2]
      rw [mul_pow, he1, he2]
  have hweightJ : ∀ x : NumberField.mixedEmbedding.mixedSpace K,
      kaiHZArchWeight K η l (kaiHZDualTwist K x)
        = TC * kaiHZArchWeight K η (fun p => -l p) x := by
    intro x
    have hJ1 : (kaiHZDualTwist K x).1 = x.1 := rfl
    have hJ2 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        (kaiHZDualTwist K x).2 p = 2 * (starRingEnd ℂ) (x.2 p) := fun _ => rfl
    have hprod : (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          kaiHZCplxWeight (l p) ((kaiHZDualTwist K x).2 p))
        = (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            (2 : ℂ) ^ ((l p).natAbs)) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            kaiHZCplxWeight (-(l p)) (x.2 p) := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun p _ => by rw [hJ2 p, hcw (l p) (x.2 p)]
    simp only [kaiHZArchWeight, hJ1]
    rw [hprod, hTCdef]
    ring
  have hnorm2J : ∀ (x : NumberField.mixedEmbedding.mixedSpace K)
      (w : NumberField.InfinitePlace K),
      NumberField.mixedEmbedding.normAtPlace w (kaiHZDualTwist K x) ^ 2
        = rr w * NumberField.mixedEmbedding.normAtPlace w x ^ 2 := by
    intro x w
    rcases w.isReal_or_isComplex with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw,
        NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw, hrrR w hw]
      have h1 : (kaiHZDualTwist K x).1 ⟨w, hw⟩ = x.1 ⟨w, hw⟩ := rfl
      rw [h1]; ring
    · have hnr : ¬ w.IsReal := by
        rw [NumberField.InfinitePlace.not_isReal_iff_isComplex]; exact hw
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw,
        NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw, hrrC w hnr]
      have h2 : (kaiHZDualTwist K x).2 ⟨w, hw⟩ = 2 * (starRingEnd ℂ) (x.2 ⟨w, hw⟩) := rfl
      have hn2 : ‖(2 : ℂ)‖ = 2 := by norm_num
      rw [h2, norm_mul, RCLike.norm_conj, hn2]
