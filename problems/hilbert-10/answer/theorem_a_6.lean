    have hmain := hline (fun z => giE (∑ k, lam k * ((z k : ℤ) : ℝ))) (1 / (2 * d)) hB
    calc _ ≤ ((2 * N + 1 : ℕ) : ℝ) ^ (ν - 1) * (1 / (2 * d)) * (2 * d) :=
          mul_le_mul_of_nonneg_right hmain (by positivity)
      _ = _ := by field_simp

theorem kai_qwi_good_differences (ν N : ℕ) (δ : ℝ) (Ω : Set (Fin ν → ℝ))
    (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ)
    (hN : 1 ≤ N) (hδ : 0 < δ) (hΩ : Convex ℝ Ω)
    (hS : δ * (((2 * N + 1 : ℕ) : ℝ) ^ ν) ≤
      ‖∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω)
            (fun _ => Classical.propDecidable _) (intBox ν N),
          giE (kaiQuadPoly p₀ p₁ p₂ z)‖) :
    δ ^ 2 * (((2 * N + 1 : ℕ) : ℝ) ^ ν) / 2 ≤
      ((@Finset.filter (Fin ν → ℤ)
          (fun h => ∀ l : Fin ν,
            |(∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ))
              - ((round (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) : ℤ) : ℝ)|
              ≤ 2 ^ ν / (δ ^ 2 * ((2 * N + 1 : ℕ) : ℝ)))
          (fun _ => Classical.propDecidable _) (intBox ν (2 * N))).card : ℝ) :=
by
  classical
  obtain ⟨Ωh, hconv, hW⟩ := kai_weyl_differencing_bound ν N Ω p₀ p₁ p₂ hΩ
  have hA := pow_le_pow_left₀ (mul_pos hδ (by positivity)).le hS 2
  have hsq := hA.trans hW
  clear hA hW hS
  obtain ⟨F, hF⟩ : ∃ F : (Fin ν → ℤ) → ℝ, F = fun h =>
      ‖∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ωh h)
            (fun _ => Classical.propDecidable _) (intBox ν N),
          giE (∑ l, (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) * ((z l : ℤ) : ℝ))‖ :=
    ⟨_, rfl⟩
  have hsum : (δ * (((2 * N + 1 : ℕ) : ℝ) ^ ν)) ^ 2 ≤ ∑ h ∈ intBox ν (2 * N), F h := by
    rw [hF]; exact hsq
  clear hsq
  obtain ⟨G, hG⟩ : ∃ G : Finset (Fin ν → ℤ), G = @Finset.filter (Fin ν → ℤ)
          (fun h => ∀ l : Fin ν,
            |(∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ))
              - ((round (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) : ℤ) : ℝ)|
              ≤ 2 ^ ν / (δ ^ 2 * ((2 * N + 1 : ℕ) : ℝ)))
          (fun _ => Classical.propDecidable _) (intBox ν (2 * N)) := ⟨_, rfl⟩
  rw [← hG]
  have hGB : G ⊆ intBox ν (2 * N) := by
    intro x hx
    rw [hG] at hx
    exact ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hx).1
  have hGmem : ∀ h ∈ intBox ν (2 * N), (∀ l : Fin ν,
            |(∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ))
              - ((round (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) : ℤ) : ℝ)|
              ≤ 2 ^ ν / (δ ^ 2 * ((2 * N + 1 : ℕ) : ℝ))) → h ∈ G := by
    intro h hh hall
    rw [hG]
    exact (@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mpr ⟨hh, hall⟩
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = ((2 * N + 1 : ℕ) : ℝ) := ⟨_, rfl⟩
  rw [← hR] at hsum hGmem ⊢
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hR3 : (3 : ℝ) ≤ R := by rw [hR]; push_cast; linarith
  have hRpos : 0 < R := by linarith
  have hRν : 0 < R ^ ν := pow_pos hRpos ν
  have hcard : ∀ M : ℕ, (intBox ν M).card = (2 * M + 1) ^ ν := by
    intro M
    unfold intBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  have hn : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t; unfold giE; rw [Complex.norm_exp]; simp
  
  have hFM : ∀ h, F h ≤ R ^ ν := by
    intro h
    simp only [hF]
    refine (norm_sum_le _ _).trans ?_
    simp only [hn, Finset.sum_const, nsmul_eq_mul, mul_one]
    calc _ ≤ ((intBox ν N).card : ℝ) := by
          exact_mod_cast Finset.card_le_card
            (@Finset.filter_subset _ _ (fun _ => Classical.propDecidable _) _)
      _ = R ^ ν := by rw [hcard, Nat.cast_pow, hR]
  
  have hFbad : ∀ h ∈ intBox ν (2 * N), h ∉ G → F h ≤ δ ^ 2 * R ^ ν / 2 ^ (ν + 1) := by
    intro h hhB hhG
    have hnot : ¬ ∀ l : Fin ν,
        |(∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ))
          - ((round (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) : ℤ) : ℝ)|
          ≤ 2 ^ ν / (δ ^ 2 * R) := fun hall => hhG (hGmem h hhB hall)
    push_neg at hnot
    obtain ⟨l, hl⟩ := hnot
    have hlin : F h * (2 * |(∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ))
          - ((round (∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) : ℤ) : ℝ)|)
          ≤ R ^ (ν - 1) := by
      rw [hF, hR]
      exact kai_linear_sum_convex_bound ν N (Ωh h) (hconv h)
        (fun l => ∑ l', (p₂ l l' + p₂ l' l) * ((h l' : ℤ) : ℝ)) l
    have hFnn : 0 ≤ F h := by rw [hF]; exact norm_nonneg _
    have hkey : δ ^ 2 * R ^ ν / 2 ^ (ν + 1) * (2 * (2 ^ ν / (δ ^ 2 * R))) = R ^ (ν - 1) := by
      have hν : 0 < ν := Fin.pos l
      obtain ⟨n, rfl⟩ : ∃ n, ν = n + 1 := ⟨ν - 1, by omega⟩
      rw [Nat.add_sub_cancel]
      field_simp
      ring
    refine le_of_mul_le_mul_right ?_ (by positivity : (0 : ℝ) < 2 * (2 ^ ν / (δ ^ 2 * R)))
    rw [hkey]
    have h2 := mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left hl.le (by norm_num : (0 : ℝ) ≤ 2)) hFnn
    exact h2.trans hlin
  
  have hsplit := Finset.sum_sdiff hGB (f := F)
  have h1 : ∑ h ∈ G, F h ≤ (G.card : ℝ) * R ^ ν := by
    have := Finset.sum_le_card_nsmul G F (R ^ ν) (fun h _ => hFM h)
    rwa [nsmul_eq_mul] at this
  have h2 : ∑ h ∈ intBox ν (2 * N) \ G, F h
      ≤ ((intBox ν (2 * N) \ G).card : ℝ) * (δ ^ 2 * R ^ ν / 2 ^ (ν + 1)) := by
    have := Finset.sum_le_card_nsmul (intBox ν (2 * N) \ G) F (δ ^ 2 * R ^ ν / 2 ^ (ν + 1))
      (fun h hh => by rw [Finset.mem_sdiff] at hh; exact hFbad h hh.1 hh.2)
    rwa [nsmul_eq_mul] at this
  have h3 : ((intBox ν (2 * N) \ G).card : ℝ) ≤ ((intBox ν (2 * N)).card : ℝ) := by
    exact_mod_cast Finset.card_le_card Finset.sdiff_subset
  have hκ : 0 ≤ δ ^ 2 * R ^ ν / 2 ^ (ν + 1) := by positivity
  have h4 : ((intBox ν (2 * N)).card : ℝ) ≤ 2 ^ ν * R ^ ν := by
    rw [hcard, Nat.cast_pow, ← mul_pow]
    apply pow_le_pow_left₀ (by positivity)
    rw [hR]; push_cast; linarith
  have h5 : 2 ^ ν * R ^ ν * (δ ^ 2 * R ^ ν / 2 ^ (ν + 1)) = (δ * R ^ ν) ^ 2 / 2 := by
    rw [pow_succ]; field_simp; ring
  have h6 : ((intBox ν (2 * N) \ G).card : ℝ) * (δ ^ 2 * R ^ ν / 2 ^ (ν + 1))
      ≤ 2 ^ ν * R ^ ν * (δ ^ 2 * R ^ ν / 2 ^ (ν + 1)) :=
    mul_le_mul_of_nonneg_right (h3.trans h4) hκ
  have hmain : (δ * R ^ ν) ^ 2 / 2 ≤ (G.card : ℝ) * R ^ ν := by linarith
  refine le_of_mul_le_mul_right ?_ hRν
  calc δ ^ 2 * R ^ ν / 2 * R ^ ν = (δ * R ^ ν) ^ 2 / 2 := by ring
