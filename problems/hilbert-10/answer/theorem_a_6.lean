        intro h; rw [h] at hs; norm_num at hs
      rw [pow_zero, mul_one, hGval s hne, hHfval s hs,
        mul_comm (s - 1) (kaiHeckeSeries K lam s), mul_div_assoc,
        div_self (sub_ne_zero.mpr hne), mul_one]
    · intro s hs
      have hsn : (1 : ℝ) ≤ ‖s - 1‖ := by
        have h1 : |(s - 1).re| ≤ ‖s - 1‖ := Complex.abs_re_le_norm _
        have h2 : (s - 1).re = s.re - 1 := by simp
        rw [h2, hs] at h1
        rw [show |(-(1:ℝ)/2 - 1)| = 3/2 by norm_num] at h1
