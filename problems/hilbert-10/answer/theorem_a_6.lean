        (mul_le_mul_of_nonneg_right hCqB (by linarith))
    nlinarith [hS.2, h3, h5]
  have hcube : ∀ k ∈ JJ, (∑' π : {π : NumberField.RingOfIntegers K // PP k π},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      ≤ (3 * (Kq * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) + c₂) * T := by
    intro k _
