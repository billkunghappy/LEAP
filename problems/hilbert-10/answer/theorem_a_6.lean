        have h2 : (((2 * (M : ℤ)) / (ℓ : ℤ) : ℤ) : ℝ) * (2 / σ)
            = (((2 * (M : ℤ)) / (ℓ : ℤ) : ℤ) : ℝ) * 2 / σ := by ring
        rw [h2, div_le_iff₀ hσ] at h1
        nlinarith
      have hz : (2 * (M : ℤ)) / (ℓ : ℤ) + 1 - 0 = (2 * (M : ℤ)) / (ℓ : ℤ) + 1 := by ring
      rw [hz]
      have hdZ : ((((2 * (M : ℤ)) / (ℓ : ℤ) + 1).toNat : ℕ) : ℤ)
