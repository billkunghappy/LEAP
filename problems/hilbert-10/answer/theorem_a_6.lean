            have h10 := kai_lp_logsum_pole K lam hext.1 hext.2.1 hlam E G hE1 hGd hEG
              x X Λ B y σ₁ β₀₀ M ρ (4 * CK * X) (C₂ * Λ)
              hx hXdef hX4 hsqXΛ hB0 hB1 hy3 hyx hσ12 hσ1 hgap' hσβ hβ01
              hM0 hρ0 hbr' hS0 (fun s h1 h2 h3 h4 => (hzR s h1 h2 h3 h4).2) hldR' hsum hsb
            rw [hm1', hβeq, Nat.cast_one, one_mul]
            exact hcmp _ h10
          · 
            have hnz : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 2 → |s.im| ≤ Real.exp (Real.sqrt X) →
                G s ≠ 0 := by
              intro s h1 h2 h3 h4
              obtain ⟨hm0, hs⟩ := hzR s h1 h2 h3 h4
              apply he2
              refine ⟨hm0, ?_⟩
              rw [hs, Complex.ofReal_re] at h1
              exact h1
            have h9 := kai_lp_logsum_main K lam hext.1 hext.2.1 hlam E G hE1 hGd hEG m₀ hm₀
              x X Λ B y σ₁ β₀₀ M ρ (4 * CK * X) (C₂ * Λ)
              hx hXdef hX4 hsqXΛ hB0 hB1 hy3 hyx hσ12 hσ1 hgap' hβ00 hβ01
              hM0 hρ0 hρσ hbr' hS0 hnz hldR hsum hsb
            have hextra : ‖(m : ℂ) * (((y ^ β₀ / β₀ ^ 2 : ℝ)) : ℂ)‖
