        · have hP : max Ep T = Ep := max_eq_left (by linarith)
          have hEmEp : Em < Ep := by linarith
          have hD := hF' (max Em T) Ep (by linarith) hB.le
          have hDeq : max (F (max Ep T) - F (max Em T)) 0 = F Ep - F (max Em T) := by
            rw [hP]; exact max_eq_left hD.1
          rcases le_or_gt (max (Em * u) T) (Ep * v) with hB1 | hB2
          · have hb'' : max (Ep * v) (max (Em * u) T) = Ep * v := max_eq_left hB1
            have h1 := hF' (Ep * v) Ep (by linarith) hEpvle
            have h2 := hF' (max Em T) (max (Em * u) T) (by linarith) haa''
            have haa : max (Em * u) T - max Em T ≤ Ep * u - Ep := by
              rcases le_total (Em * u) T with h3 | h3
              · rw [max_eq_right h3]; linarith
              · rw [max_eq_left h3]
                have := mul_nonneg (sub_nonneg.2 hEmEp.le) (sub_nonneg.2 hu1)
                nlinarith
            rw [hb'', hDeq, abs_le]
            constructor <;> nlinarith
          · have hb'' : max (Ep * v) (max (Em * u) T) = max (Em * u) T :=
              max_eq_right hB2.le
            have hk := mul_nonneg (sub_nonneg.2 hu1) (sub_nonneg.2 hB.le)
            have hgap : Ep - max Em T ≤ 7 / 2 * Δ * Xn := by nlinarith
            rw [hb'', hDeq, sub_self, zero_sub, abs_neg, abs_of_nonneg hD.1]
            linarith [hD.2]
      exact ⟨hb'X, hb''X, hGp.1, by linarith [hGp.2], s3, hGm.1, by linarith [hGm.2], s4⟩
  subst hx0p hx1p hx0m hx1m
  exact main (fun x => x - ε * (x ^ β / β)) (Real.exp Δ) (Real.exp (-(2 * Δ)))
    (Real.exp (3 * Δ)) hF hu1 hu32 hu' hv0 hv1 hv' hw1 hw3 hwv

theorem kai_lp_cube_piece_arith (Cnt A1p A0p A1m A0m M1p M0p M1m M0m F L Cq P Pp Pm Δ Δθ nc Xn Eb : ℝ)
    (hL : 0 ≤ L) (hCq : 0 ≤ Cq) (hP0 : 0 ≤ P) (hP1 : P ≤ 1) (hPp0 : 0 ≤ Pp) (hPp1 : Pp ≤ 1)
    (hΔ : 0 ≤ Δ) (hΔθ : 0 ≤ Δθ) (hnc : 0 ≤ nc) (hXn : 0 ≤ Xn) (hEb : 0 ≤ Eb)
    (hCnt : 0 ≤ Cnt) (hF0 : 0 ≤ F) (hF2 : F ≤ 2 * Xn)
    (hGp0 : 0 ≤ M1p - M0p) (hGp4 : M1p - M0p ≤ 4 * Xn) (hGpF : |M1p - M0p - F| ≤ 16 * Δ * Xn)
    (hout : Cnt ≤ A1p - A0p)
    (hb1p : |A1p - L * Pp * Cq * M1p| ≤ Eb) (hb0p : |A0p - L * Pp * Cq * M0p| ≤ Eb)
    (hPpP : |Pp - P| ≤ 2 * nc * Δθ)
    (hcase : (0 ≤ Pm ∧ Pm ≤ 1 ∧ |Pm - P| ≤ 2 * nc * Δθ ∧ A1m - A0m ≤ Cnt ∧
        |A1m - L * Pm * Cq * M1m| ≤ Eb ∧ |A0m - L * Pm * Cq * M0m| ≤ Eb ∧
        0 ≤ M1m - M0m ∧ M1m - M0m ≤ 4 * Xn ∧ |M1m - M0m - F| ≤ 16 * Δ * Xn)
      ∨ (P ≤ 2 * Δθ ∧ Pp ≤ 4 * Δθ)) :
    |Cnt - L * P * Cq * F| ≤ L * Cq * (8 * (nc + 2) * Δθ + 16 * Δ) * Xn + 2 * Eb :=
by
  have hc : 0 ≤ L * Cq := mul_nonneg hL hCq
  have hW : 0 ≤ 8 * nc * Δθ * Xn + 16 * Δ * Xn := by positivity
  have hcW : 0 ≤ L * Cq * (8 * nc * Δθ * Xn + 16 * Δ * Xn) := mul_nonneg hc hW
  have hextra : 0 ≤ L * Cq * (Δθ * Xn) := mul_nonneg hc (mul_nonneg hΔθ hXn)
  have hRHS : L * Cq * (8 * (nc + 2) * Δθ + 16 * Δ) * Xn + 2 * Eb
      = L * Cq * (8 * nc * Δθ * Xn + 16 * Δ * Xn) + 16 * (L * Cq * (Δθ * Xn)) + 2 * Eb := by
    ring
  have key : ∀ Q G : ℝ, |Q - P| ≤ 2 * nc * Δθ → 0 ≤ G → G ≤ 4 * Xn →
      |G - F| ≤ 16 * Δ * Xn → |Q * G - P * F| ≤ 8 * nc * Δθ * Xn + 16 * Δ * Xn := by
    intro Q G hQP hG0 hG4 hGF
    have e : Q * G - P * F = (Q - P) * G + P * (G - F) := by ring
    rw [e]
    have h1 : |(Q - P) * G| ≤ 2 * nc * Δθ * (4 * Xn) := by
      rw [abs_mul, abs_of_nonneg hG0]
      exact mul_le_mul hQP hG4 hG0 (le_trans (abs_nonneg _) hQP)
    have h2 : |P * (G - F)| ≤ 1 * (16 * Δ * Xn) := by
      rw [abs_mul, abs_of_nonneg hP0]
      exact mul_le_mul hP1 hGF (abs_nonneg _) zero_le_one
    calc |(Q - P) * G + P * (G - F)| ≤ |(Q - P) * G| + |P * (G - F)| := abs_add_le _ _
      _ ≤ 2 * nc * Δθ * (4 * Xn) + 1 * (16 * Δ * Xn) := add_le_add h1 h2
      _ = 8 * nc * Δθ * Xn + 16 * Δ * Xn := by ring
  
  have kp := (abs_le.mp (key Pp (M1p - M0p) hPpP hGp0 hGp4 hGpF)).2
  have mp : L * Cq * (Pp * (M1p - M0p) - P * F)
      ≤ L * Cq * (8 * nc * Δθ * Xn + 16 * Δ * Xn) := mul_le_mul_of_nonneg_left kp hc
  have idp : L * Cq * (Pp * (M1p - M0p) - P * F)
      = L * Pp * Cq * M1p - L * Pp * Cq * M0p - L * P * Cq * F := by ring
  obtain ⟨hb1p_l, hb1p_u⟩ := abs_le.mp hb1p
  obtain ⟨hb0p_l, hb0p_u⟩ := abs_le.mp hb0p
  have upper : Cnt - L * P * Cq * F
      ≤ L * Cq * (8 * (nc + 2) * Δθ + 16 * Δ) * Xn + 2 * Eb := by
    rw [hRHS]
    rw [idp] at mp
    linarith
  
  have lower : -(L * Cq * (8 * (nc + 2) * Δθ + 16 * Δ) * Xn + 2 * Eb)
      ≤ Cnt - L * P * Cq * F := by
    rw [hRHS]
    rcases hcase with ⟨_, _, hPmP, hin, hb1m, hb0m, hGm0, hGm4, hGmF⟩ | ⟨hP2, _⟩
    · have km := (abs_le.mp (key Pm (M1m - M0m) hPmP hGm0 hGm4 hGmF)).1
      have mm : L * Cq * (-(8 * nc * Δθ * Xn + 16 * Δ * Xn))
          ≤ L * Cq * (Pm * (M1m - M0m) - P * F) := mul_le_mul_of_nonneg_left km hc
      have idm : L * Cq * (Pm * (M1m - M0m) - P * F)
          = L * Pm * Cq * M1m - L * Pm * Cq * M0m - L * P * Cq * F := by ring
      have idn : L * Cq * (-(8 * nc * Δθ * Xn + 16 * Δ * Xn))
          = -(L * Cq * (8 * nc * Δθ * Xn + 16 * Δ * Xn)) := by ring
      rw [idm, idn] at mm
      obtain ⟨hb1m_l, hb1m_u⟩ := abs_le.mp hb1m
      obtain ⟨hb0m_l, hb0m_u⟩ := abs_le.mp hb0m
      linarith
    · have hPF : P * F ≤ 2 * Δθ * (2 * Xn) := mul_le_mul hP2 hF2 hF0 (by positivity)
      have hcPF : L * Cq * (P * F) ≤ L * Cq * (2 * Δθ * (2 * Xn)) :=
        mul_le_mul_of_nonneg_left hPF hc
      have id1 : L * Cq * (P * F) = L * P * Cq * F := by ring
      have id2 : L * Cq * (2 * Δθ * (2 * Xn)) = 4 * (L * Cq * (Δθ * Xn)) := by ring
      rw [id1, id2] at hcPF
      linarith
  exact abs_le.mpr ⟨lower, upper⟩

theorem kai_tb_env_bounds (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e) (X : ℝ)
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hab : ∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ (0 ≤ a w ∨ b w ≤ 0))
    (hρσ : ∀ p, 0 ≤ ρ p ∧ ρ p < σ p ∧ σ p ≤ X)
    (W : Fin (NumberField.Units.rank K) → ℝ) :
    0 ≤ kaiTBEminus K H a b ρ σ W ∧ 0 ≤ kaiTBEplus K H a b ρ σ W ∧
      kaiTBEplus K H a b ρ σ W ≤ X ^ (Module.finrank ℚ K) :=
by
  classical
  obtain ⟨-, -, -, hsum, -⟩ := hdata
  have hbd : ∀ w : NumberField.InfinitePlace K,
      0 ≤ kaiTBCellLo K a b ρ σ w ∧ 0 ≤ kaiTBCellHi K a b ρ σ w ∧
        kaiTBCellHi K a b ρ σ w ≤ X := by
    intro w
    by_cases h : w.IsReal
    · obtain ⟨hXa, hab', hbX, hor⟩ := hab ⟨w, h⟩
      by_cases h0 : 0 ≤ a ⟨w, h⟩
      · have e1 : kaiTBCellLo K a b ρ σ w = a ⟨w, h⟩ := by
          simp only [kaiTBCellLo, dif_pos h, if_pos h0]
        have e2 : kaiTBCellHi K a b ρ σ w = b ⟨w, h⟩ := by
          simp only [kaiTBCellHi, dif_pos h, if_pos h0]
        rw [e1, e2]
        exact ⟨h0, by linarith, hbX⟩
      · have e1 : kaiTBCellLo K a b ρ σ w = -b ⟨w, h⟩ := by
          simp only [kaiTBCellLo, dif_pos h, if_neg h0]
        have e2 : kaiTBCellHi K a b ρ σ w = -a ⟨w, h⟩ := by
          simp only [kaiTBCellHi, dif_pos h, if_neg h0]
        have hb : b ⟨w, h⟩ ≤ 0 := hor.resolve_left h0
        rw [e1, e2]
        exact ⟨by linarith, by linarith, by linarith⟩
    · obtain ⟨h0, hlt, hσX⟩ :=
        hρσ ⟨w, NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h⟩
      have e1 : kaiTBCellLo K a b ρ σ w
          = ρ ⟨w, NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h⟩ := by
        simp only [kaiTBCellLo, dif_neg h]
      have e2 : kaiTBCellHi K a b ρ σ w
          = σ ⟨w, NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h⟩ := by
        simp only [kaiTBCellHi, dif_neg h]
      rw [e1, e2]
      exact ⟨h0, by linarith, hσX⟩
  have hf : ∀ w : NumberField.InfinitePlace K,
      0 < Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w) :=
    fun w => Real.exp_pos _
  refine ⟨?_, ?_, ?_⟩
  · unfold kaiTBEminus
    exact Real.iSup_nonneg fun w => mul_nonneg (pow_nonneg (hbd w).1 _) (hf w).le
  · unfold kaiTBEplus
    exact Real.iInf_nonneg fun w => mul_nonneg (pow_nonneg (hbd w).2.1 _) (hf w).le
  · have hS : ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * kaiTBShapeLog K H W w = 0 := by
      have hw : ∀ w : NumberField.InfinitePlace K, (w.mult : ℝ) * kaiTBShapeLog K H W w
          = ∑ j, W j * kaiTBUnitLog K (H j) w := by
        intro w
        simp only [kaiTBShapeLog, kaiTBUnitLog, Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [Finset.sum_congr rfl fun w _ => hw w, Finset.sum_comm]
      have hz : ∀ j, ∑ w : NumberField.InfinitePlace K, W j * kaiTBUnitLog K (H j) w = 0 := by
        intro j
        rw [← Finset.mul_sum, hsum j, mul_zero]
      rw [Finset.sum_congr rfl fun j _ => hz j, Finset.sum_const_zero]
    obtain ⟨w₁, hw₁⟩ : ∃ w₁ : NumberField.InfinitePlace K, 0 ≤ kaiTBShapeLog K H W w₁ := by
      by_contra hne
      push_neg at hne
      have hlt : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * kaiTBShapeLog K H W w
          < ∑ w : NumberField.InfinitePlace K, (0 : ℝ) :=
        Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty fun w _ =>
          mul_neg_of_pos_of_neg (by exact_mod_cast w.mult_pos) (hne w)
      rw [Finset.sum_const_zero] at hlt
      linarith
    have hf1 : Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w₁) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      have : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.cast_nonneg _
      nlinarith
    unfold kaiTBEplus
    calc _ ≤ kaiTBCellHi K a b ρ σ w₁ ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w₁) :=
          ciInf_le (Finite.bddBelow_range _) w₁
      _ ≤ kaiTBCellHi K a b ρ σ w₁ ^ (Module.finrank ℚ K) :=
          mul_le_of_le_one_right (pow_nonneg (hbd w₁).2.1 _) hf1
      _ ≤ X ^ (Module.finrank ℚ K) := pow_le_pow_left₀ (hbd w₁).2.1 (hbd w₁).2.2 _

theorem kai_abs_prod_sub_prod_le_sum {ι : Type*} [Fintype ι] (f g : ι → ℝ)
    (hf : ∀ i, 0 ≤ f i ∧ f i ≤ 1) (hg : ∀ i, 0 ≤ g i ∧ g i ≤ 1) :
    |∏ i, f i - ∏ i, g i| ≤ ∑ i, |f i - g i| :=
by
  classical
  have key : ∀ s : Finset ι, |∏ i ∈ s, f i - ∏ i ∈ s, g i| ≤ ∑ i ∈ s, |f i - g i| := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert a t ha ih =>
      rw [Finset.prod_insert ha, Finset.prod_insert ha, Finset.sum_insert ha]
      have hQ0 : 0 ≤ ∏ i ∈ t, g i := Finset.prod_nonneg (fun i _ => (hg i).1)
      have hQ1 : ∏ i ∈ t, g i ≤ 1 := Finset.prod_le_one (fun i _ => (hg i).1) (fun i _ => (hg i).2)
      have heq : f a * ∏ i ∈ t, f i - g a * ∏ i ∈ t, g i
          = f a * (∏ i ∈ t, f i - ∏ i ∈ t, g i) + (f a - g a) * ∏ i ∈ t, g i := by ring
      rw [heq]
      have h1 : |f a * (∏ i ∈ t, f i - ∏ i ∈ t, g i)| ≤ |∏ i ∈ t, f i - ∏ i ∈ t, g i| := by
        rw [abs_mul, abs_of_nonneg (hf a).1]
        exact mul_le_of_le_one_left (abs_nonneg _) (hf a).2
      have h2 : |(f a - g a) * ∏ i ∈ t, g i| ≤ |f a - g a| := by
        rw [abs_mul, abs_of_nonneg hQ0]
        exact mul_le_of_le_one_right (abs_nonneg _) hQ1
      have h3 := abs_add_le (f a * (∏ i ∈ t, f i - ∏ i ∈ t, g i)) ((f a - g a) * ∏ i ∈ t, g i)
      linarith
  exact key Finset.univ

