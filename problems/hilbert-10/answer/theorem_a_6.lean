    have hGσ : G σ = (σ - (β : ℂ)) ^ n * g σ := by
      simpa [smul_eq_mul] using hGt.self_of_nhds
    have hder : HasDerivAt (fun w => (w - (β : ℂ)) ^ n * g w)
