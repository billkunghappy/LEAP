      have p1 := mul_le_mul_of_nonneg_left h1.2 ha
      have p2 := mul_le_mul_of_nonneg_left h2.2 hb
      have p3 := mul_le_mul_of_nonneg_left h1.1 ha
      have p4 := mul_le_mul_of_nonneg_left h2.1 hb
