    · exact mul_nonneg (pow_nonneg (Nat.cast_nonneg _) _) hη
  
  obtain ⟨D, hDdef⟩ : ∃ D : Finset (Fin (Module.finrank ℚ K) → ℤ),
      D = @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
        (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ ω.equivFun.symm z - a ∈ 𝔮 ∧
          IsCoprime (Ideal.span {ω.equivFun.symm z}) 𝔮D)
        (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) ⌊M⌋₊) := ⟨_, rfl⟩
  have hDsub : D ⊆ intBox (Module.finrank ℚ K) ⌊M⌋₊ := by
