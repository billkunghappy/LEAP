          rw [hd_def]; field_simp; ring
        have h5 : 1 / B * (B / (2 * L)) ≤ 1 / B * ‖(σ : ℂ) - ρ‖ :=
          mul_le_mul_of_nonneg_left ha hBinv.le
        have h6 : 1 / B * ‖(σ : ℂ) - ρ‖ ≤ k * ‖(σ : ℂ) - ρ‖ :=
