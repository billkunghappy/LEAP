        rw [mul_sub, Finset.mul_sum, Finset.mul_sum]
      rw [e2]
      have h4 : giCircNorm P (∑ i, s * ξ (a i) - ∑ i, s * ξ (b i)) < 1 / 8 :=
        s4 (64 * (s * ξ (a 0)).val / P) (fun i => s * ξ (a i)) (fun i => s * ξ (b i))
          (fun i => hcell s hs (a i) (ha i) (a 0) (ha 0))
          (fun i => hcell s hs (b i) (hb i) (a 0) (ha 0))
      linarith
    exact sub_eq_zero.mp (hsep _ hζ hall)

theorem gi_regular_bohr_exists (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ε : ℝ)
