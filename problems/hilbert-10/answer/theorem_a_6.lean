      mul_nonneg hKq (pow_nonneg (by linarith) _)
    rcases Nat.eq_zero_or_pos (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ)) with h0 | hpos
    · rw [h0, Nat.cast_zero, mul_zero, zero_mul, div_zero]
