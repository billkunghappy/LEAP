      intro t ht
      have := Finset.mem_Icc.mp (hT ht)
      rw [Finset.mem_Icc]
      constructor
      · exact Int.ediv_nonneg (by omega) hℓZ.le
      · exact Int.ediv_le_ediv hℓZ (by omega)
    have hcardB : (Finset.Icc (0 : ℤ) ((2 * (M : ℤ)) / (ℓ : ℤ))).card < T.card := by
      rw [Int.card_Icc]
      have hQ0 : 0 ≤ (2 * (M : ℤ)) / (ℓ : ℤ) := Int.ediv_nonneg (by positivity) hℓZ.le
      have hQl : (2 * (M : ℤ)) / (ℓ : ℤ) * (ℓ : ℤ) ≤ 2 * (M : ℤ) := Int.ediv_mul_le _ hℓZ.ne'
      have hQR : ((((2 * (M : ℤ)) / (ℓ : ℤ) : ℤ) : ℝ)) * (ℓ : ℝ) ≤ 2 * (M : ℝ) := by
        exact_mod_cast hQl
