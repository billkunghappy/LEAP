        f μ u = kaiHZArchWeight K η l (ρ +
            NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K)) *
          ((kaiHZGaussian K (fun w => Real.exp (u w)) (ρ +
              NumberField.mixedEmbedding K
                ((μ : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ) :=
    ⟨_, fun _ _ => rfl⟩
  have hΦ : (fun u : NumberField.InfinitePlace K → ℝ =>
        kaiHZIdealTheta K a ρ η l (fun w => Real.exp (u w)))
      = fun u : NumberField.InfinitePlace K → ℝ => ∑' μ : ↥a, f μ u := by
    funext u
    simp only [kaiHZIdealTheta]
    exact (tsum_congr (fun μ => hf μ u)).symm
  rw [hΦ]
  have hfcont : ∀ μ : ↥a, Continuous (f μ) := by
    intro μ
    have hrw : f μ = fun u : NumberField.InfinitePlace K → ℝ =>
