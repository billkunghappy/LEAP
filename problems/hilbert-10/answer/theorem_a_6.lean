        GiRegularBohr P S ρ →
        GiLocQuadOn P ((giBohr P S ρ).image (fun x => y + x)) φ →
        Real.exp (-Λ) * ((giBohr P S ρ).card : ℝ) ≤
          ‖∑ x ∈ giBohr P S ρ, ((g (y + x) : ℝ) : ℂ) * giE (-(φ (y + x)))‖ →
        ∃ ψ : (Fin 1 → ℤ) → ℝ,
          IsNil2Seq 1 ((C₆ : ℝ) * Λ ^ C₆) (Real.exp ((C₆ : ℝ) * Λ ^ C₆)) ψ ∧
          Real.exp (-((C₆ : ℝ) * Λ ^ C₆)) * P ≤
            |∑ t ∈ Finset.range P, g (t : ZMod P) * ψ (fun _ => (t : ℤ))| :=
