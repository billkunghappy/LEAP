  have hU : 0 ≤ X ^ Module.finrank ℚ K
      * (G * (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) * (Y * M ^ (-(3:ℝ)/4) + η)) :=
    mul_nonneg (pow_nonneg hX0.le _) (mul_nonneg (mul_nonneg hG hNq0)
      (add_nonneg (mul_nonneg hY0.le hP0.le) hη))
  have hV : 0 ≤ X ^ Module.finrank ℚ K * (H * T⁻¹) :=
    mul_nonneg (pow_nonneg hX0.le _) (mul_nonneg hH (inv_nonneg.mpr hT0.le))
  have hc1 : (0:ℝ) ≤ 12 ^ Module.finrank ℚ K := by positivity
  have hc2 : (0:ℝ) ≤ (Module.finrank ℚ K : ℝ) * 2 ^ Module.finrank ℚ K := by positivity
  have hc3 : 0 ≤ A₂ * (8 * A₁ * (Module.finrank ℚ K : ℝ) + 1) := mul_nonneg (by linarith) hA₁n
  have f1 := mul_nonneg hc1 hV
  have f2 := mul_nonneg hc2 hU
  have f3 := mul_nonneg hc3 hU
  have e : (12 ^ Module.finrank ℚ K + (Module.finrank ℚ K : ℝ) * 2 ^ Module.finrank ℚ K
        + A₂ * (8 * A₁ * (Module.finrank ℚ K : ℝ) + 1)) * X ^ Module.finrank ℚ K
        * (G * (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) * (Y * M ^ (-(3:ℝ)/4) + η) + H * T⁻¹)
      = 12 ^ Module.finrank ℚ K * (X ^ Module.finrank ℚ K
          * (G * (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) * (Y * M ^ (-(3:ℝ)/4) + η)))
        + (Module.finrank ℚ K : ℝ) * 2 ^ Module.finrank ℚ K
          * (X ^ Module.finrank ℚ K * (H * T⁻¹))
        + A₂ * (8 * A₁ * (Module.finrank ℚ K : ℝ) + 1) * (X ^ Module.finrank ℚ K * (H * T⁻¹))
        + (12 ^ Module.finrank ℚ K * (X ^ Module.finrank ℚ K * (H * T⁻¹))
          + (Module.finrank ℚ K : ℝ) * 2 ^ Module.finrank ℚ K * (X ^ Module.finrank ℚ K
            * (G * (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) * (Y * M ^ (-(3:ℝ)/4) + η)))
          + A₂ * (8 * A₁ * (Module.finrank ℚ K : ℝ) + 1) * (X ^ Module.finrank ℚ K
            * (G * (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) * (Y * M ^ (-(3:ℝ)/4) + η)))) := by ring
  rw [e]
  linarith [T1, T2, T3, f1, f2, f3]

theorem kai_qmodel_numerics (n : ℕ) (C_M c : ℝ) (hC : 1 ≤ C_M) (hc : 0 < c) :
    ∃ K₀ : ℝ, 0 ≤ K₀ ∧ ∀ M : ℝ, 3 ≤ M →
      (C_M * Real.log M ^ ((1:ℝ)/3)) ^ n * Real.exp (2 * Real.log M ^ ((1:ℝ)/3))
        * (Real.exp (Real.log M ^ ((1:ℝ)/2)) * M ^ (-(3:ℝ)/4)
            + Real.exp (-(c * Real.log M ^ ((2:ℝ)/3)))
            + Real.exp (-(Real.log M ^ ((1:ℝ)/2)) / 2))
        ≤ K₀ * Real.exp (-(Real.log M ^ ((1:ℝ)/200))) :=
by
  
  have core : ∀ (j : ℕ), 2 ≤ j → ∀ (b A s Q : ℝ), 0 < b → 1 ≤ s → Q ≤ A - b * s ^ j →
      s ^ (2 * n) * Real.exp Q ≤ (1 / b) ^ n * (n.factorial : ℝ) * Real.exp A := by
    intro j hj b A s Q hb hs hQ
    obtain ⟨x, hx_def⟩ : ∃ x : ℝ, x = b * s ^ j := ⟨_, rfl⟩
    have hsj : 0 < s ^ j := pow_pos (by linarith) j
    have hx : 0 ≤ x := by rw [hx_def]; positivity
    have h1 : s ^ (2 * n) ≤ s ^ (j * n) := pow_le_pow_right₀ hs (Nat.mul_le_mul_right n hj)
    have h2 : s ^ (j * n) = (1 / b) ^ n * x ^ n := by
      rw [pow_mul, ← mul_pow, hx_def]
      congr 1
      field_simp
    have h3 : x ^ n ≤ (n.factorial : ℝ) * Real.exp x := by
      have h := Real.pow_div_factorial_le_exp x hx n
      have hf : (0 : ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
      rw [div_le_iff₀ hf] at h
      linarith
    have h4 : Real.exp Q ≤ Real.exp A * Real.exp (-x) := by
      rw [← Real.exp_add]; exact Real.exp_le_exp.2 (by rw [hx_def]; linarith)
    have hxx : Real.exp x * Real.exp (-x) = 1 := by
      rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
    have hb' : 0 ≤ (1 / b) ^ n := by positivity
    calc s ^ (2 * n) * Real.exp Q
        ≤ ((1 / b) ^ n * x ^ n) * (Real.exp A * Real.exp (-x)) := by
          rw [← h2]; exact mul_le_mul h1 h4 (Real.exp_pos _).le (by positivity)
      _ ≤ ((1 / b) ^ n * ((n.factorial : ℝ) * Real.exp x)) * (Real.exp A * Real.exp (-x)) := by
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          exact mul_le_mul_of_nonneg_left h3 hb'
      _ = (1 / b) ^ n * (n.factorial : ℝ) * Real.exp A * (Real.exp x * Real.exp (-x)) := by ring
      _ = (1 / b) ^ n * (n.factorial : ℝ) * Real.exp A := by rw [hxx, mul_one]
  
  have pa : ∀ s : ℝ, 0 ≤ s → 3 * s ^ 2 + s ^ 3 - 3 / 4 * s ^ 6 ≤ 54 - 1 / 2 * s ^ 6 := by
    intro s hs
    rcases le_total s 3 with h | h
    · have e2 : s ^ 2 ≤ 9 := by nlinarith
      have e3 : s ^ 3 ≤ 27 := by
        have : s ^ 3 = s * s ^ 2 := by ring
        rw [this]; nlinarith [sq_nonneg s]
      have e6 : 0 ≤ s ^ 6 := by positivity
      linarith
    · have e2 : 9 ≤ s ^ 2 := by nlinarith
      have e3 : 27 ≤ s ^ 3 := by
        have : s ^ 3 = s * s ^ 2 := by ring
        rw [this]; nlinarith
      have e4 : 81 ≤ s ^ 4 := by
        have : s ^ 4 = s ^ 2 * s ^ 2 := by ring
        rw [this]; nlinarith
      have e6a : s ^ 6 = s ^ 3 * s ^ 3 := by ring
      have e6b : s ^ 6 = s ^ 4 * s ^ 2 := by ring
      have f1 : 27 * s ^ 3 ≤ s ^ 6 := by rw [e6a]; nlinarith
      have f2 : 81 * s ^ 2 ≤ s ^ 6 := by rw [e6b]; nlinarith
      linarith
  have pb : ∀ s : ℝ, 3 * s ^ 2 - c * s ^ 4 ≤ 9 / (2 * c) - c / 2 * s ^ 4 := by
    intro s
    have hsq : 0 ≤ (c * s ^ 2 - 3) ^ 2 / (2 * c) := div_nonneg (sq_nonneg _) (by positivity)
    have heq : 9 / (2 * c) - c / 2 * s ^ 4 - (3 * s ^ 2 - c * s ^ 4)
        = (c * s ^ 2 - 3) ^ 2 / (2 * c) := by
      field_simp
      ring
    linarith
  have pc : ∀ s : ℝ, 0 ≤ s → 3 * s ^ 2 - s ^ 3 / 2 ≤ 432 - 1 / 4 * s ^ 3 := by
    intro s hs
    rcases le_total s 12 with h | h
    · have e2 : s ^ 2 ≤ 144 := by nlinarith
      have e3 : 0 ≤ s ^ 3 := by positivity
      linarith
    · have e2 : 0 ≤ s ^ 2 := by positivity
      have f : 12 * s ^ 2 ≤ s ^ 3 := by
        have : s ^ 3 = s * s ^ 2 := by ring
        rw [this]; nlinarith
      linarith
  
  obtain ⟨K₀, hK₀_def⟩ : ∃ K₀ : ℝ, K₀ = C_M ^ n *
      ((1 / (1 / 2 : ℝ)) ^ n * (n.factorial : ℝ) * Real.exp 54
        + (1 / (c / 2)) ^ n * (n.factorial : ℝ) * Real.exp (9 / (2 * c))
        + (1 / (1 / 4 : ℝ)) ^ n * (n.factorial : ℝ) * Real.exp 432) := ⟨_, rfl⟩
  have hCM0 : 0 ≤ C_M := by linarith
  have hK₀ : 0 ≤ K₀ := by rw [hK₀_def]; positivity
  refine ⟨K₀, hK₀, ?_⟩
  intro M hM
  have hM0 : 0 < M := by linarith
  have hL1 : 1 < Real.log M := by
    rw [Real.lt_log_iff_exp_lt hM0]; have := Real.exp_one_lt_d9; linarith
  have hL0 : 0 ≤ Real.log M := by linarith
  obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = Real.log M ^ ((1:ℝ)/6) := ⟨_, rfl⟩
  have hs1 : 1 ≤ s := by rw [hs_def]; exact Real.one_le_rpow hL1.le (by norm_num)
  have hs0 : 0 ≤ s := by linarith
  have hpow : ∀ k : ℕ, Real.log M ^ ((1:ℝ)/6 * (k:ℝ)) = s ^ k := by
    intro k; rw [hs_def, Real.rpow_mul_natCast hL0]
  have h13 : Real.log M ^ ((1:ℝ)/3) = s ^ 2 := by rw [← hpow 2]; norm_num
  have h12 : Real.log M ^ ((1:ℝ)/2) = s ^ 3 := by rw [← hpow 3]; norm_num
  have h23 : Real.log M ^ ((2:ℝ)/3) = s ^ 4 := by rw [← hpow 4]; norm_num
  have h1 : Real.log M = s ^ 6 := by rw [← hpow 6]; norm_num
  have hM34 : M ^ (-(3:ℝ)/4) = Real.exp (-(3/4) * s ^ 6) := by
    rw [Real.rpow_def_of_pos hM0, ← h1]; congr 1; ring
  have h200 : Real.log M ^ ((1:ℝ)/200) ≤ s ^ 2 := by
    rw [← h13]; exact Real.rpow_le_rpow_of_exponent_le hL1.le (by norm_num)
  rw [h13, h12, h23, hM34]
  have e1 : Real.exp (2 * s ^ 2) * (Real.exp (s ^ 3) * Real.exp (-(3/4) * s ^ 6))
      = Real.exp (3 * s ^ 2 + s ^ 3 - 3 / 4 * s ^ 6) * Real.exp (-(s ^ 2)) := by
    simp only [← Real.exp_add]; congr 1; ring
  have e2 : Real.exp (2 * s ^ 2) * Real.exp (-(c * s ^ 4))
      = Real.exp (3 * s ^ 2 - c * s ^ 4) * Real.exp (-(s ^ 2)) := by
    simp only [← Real.exp_add]; congr 1; ring
  have e3 : Real.exp (2 * s ^ 2) * Real.exp (-(s ^ 3) / 2)
      = Real.exp (3 * s ^ 2 - s ^ 3 / 2) * Real.exp (-(s ^ 2)) := by
    simp only [← Real.exp_add]; congr 1; ring
  have B1 := core 6 (by norm_num) (1 / 2) 54 s _ (by norm_num) hs1 (pa s hs0)
  have B2 := core 4 (by norm_num) (c / 2) (9 / (2 * c)) s _ (by positivity) hs1 (pb s)
  have B3 := core 3 (by norm_num) (1 / 4) 432 s _ (by norm_num) hs1 (pc s hs0)
  have hCn : 0 ≤ C_M ^ n := pow_nonneg hCM0 n
  calc (C_M * s ^ 2) ^ n * Real.exp (2 * s ^ 2)
        * (Real.exp (s ^ 3) * Real.exp (-(3/4) * s ^ 6)
            + Real.exp (-(c * s ^ 4)) + Real.exp (-(s ^ 3) / 2))
      = C_M ^ n * s ^ (2 * n) *
          (Real.exp (2 * s ^ 2) * (Real.exp (s ^ 3) * Real.exp (-(3/4) * s ^ 6))
            + Real.exp (2 * s ^ 2) * Real.exp (-(c * s ^ 4))
            + Real.exp (2 * s ^ 2) * Real.exp (-(s ^ 3) / 2)) := by
        rw [mul_pow, pow_mul]; ring
    _ = C_M ^ n * (s ^ (2 * n) * Real.exp (3 * s ^ 2 + s ^ 3 - 3 / 4 * s ^ 6)
          + s ^ (2 * n) * Real.exp (3 * s ^ 2 - c * s ^ 4)
          + s ^ (2 * n) * Real.exp (3 * s ^ 2 - s ^ 3 / 2)) * Real.exp (-(s ^ 2)) := by
        rw [e1, e2, e3]; ring
    _ ≤ K₀ * Real.exp (-(s ^ 2)) := by
        rw [hK₀_def]
        apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
        apply mul_le_mul_of_nonneg_left _ hCn
        linarith
    _ ≤ K₀ * Real.exp (-(Real.log M ^ ((1:ℝ)/200))) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 (by linarith)) hK₀

theorem kai_cramer_density_bound (K : Type u) [Field K] [NumberField K] :
    ∃ C_M : ℝ, 1 ≤ C_M ∧ ∀ m : ℕ,
      (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ)
        ≤ (C_M * max 1 (Real.log m)) ^ Module.finrank ℚ K :=
by
  
  have hs1 : ∀ m : ℕ, phiK K (primorial m)
      = ∏ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), phiK K p := by
    intro m
    have hpair : ∀ a b : ℕ, a.Coprime b → phiK K (a * b) = phiK K a * phiK K b := by
      intro a b hab
      have hcop : IsCoprime (a : ℤ) (b : ℤ) := Nat.isCoprime_iff_coprime.mpr hab
      have hcop' : IsCoprime (a : NumberField.RingOfIntegers K)
          (b : NumberField.RingOfIntegers K) := by
        simpa using hcop.map (Int.castRingHom (NumberField.RingOfIntegers K))
      have hI : IsCoprime (Ideal.span {(a : NumberField.RingOfIntegers K)})
          (Ideal.span {(b : NumberField.RingOfIntegers K)}) :=
        (Ideal.isCoprime_span_singleton_iff _ _).mpr hcop'
      have heq : Ideal.span {((a * b : ℕ) : NumberField.RingOfIntegers K)}
          = Ideal.span {(a : NumberField.RingOfIntegers K)}
            * Ideal.span {(b : NumberField.RingOfIntegers K)} := by
        rw [Ideal.span_singleton_mul_span_singleton]; push_cast; rfl
      unfold phiK
      rw [heq, Nat.card_congr
          (Units.mapEquiv (Ideal.quotientMulEquivQuotientProd _ _ hI).toMulEquiv).toEquiv,
        Nat.card_congr MulEquiv.prodUnits.toEquiv, Nat.card_prod]
    have hone : phiK K 1 = 1 := by
      unfold phiK
      rw [Nat.cast_one, Ideal.span_singleton_one]
      have : Subsingleton
          (NumberField.RingOfIntegers K ⧸ (⊤ : Ideal (NumberField.RingOfIntegers K))) :=
        Ideal.Quotient.subsingleton_iff.mpr rfl
      have : Subsingleton
          (NumberField.RingOfIntegers K ⧸ (⊤ : Ideal (NumberField.RingOfIntegers K)))ˣ :=
        ⟨fun x y => Units.ext (Subsingleton.elim _ _)⟩
      exact Nat.card_eq_one_iff_unique.mpr ⟨inferInstance, ⟨1⟩⟩
    have gen : ∀ S : Finset ℕ, (∀ p ∈ S, p.Prime) →
        phiK K (∏ p ∈ S, p) = ∏ p ∈ S, phiK K p := by
      intro S
      refine Finset.induction_on S ?_ ?_
      · intro _; simp [hone]
      · intro q S hq ih hS
        rw [Finset.prod_insert hq, Finset.prod_insert hq]
        have hqp : q.Prime := hS q (Finset.mem_insert_self q S)
        have hcop : q.Coprime (∏ p ∈ S, p) := by
          apply Nat.Coprime.prod_right
          intro p hp
          have hpp : p.Prime := hS p (Finset.mem_insert_of_mem hp)
          rw [Nat.coprime_primes hqp hpp]
          intro h; exact hq (h ▸ hp)
        rw [hpair q _ hcop, ih (fun p hp => hS p (Finset.mem_insert_of_mem hp))]
    have := gen (Finset.filter Nat.Prime (Finset.range (m + 1)))
      (fun p hp => (Finset.mem_filter.1 hp).2)
    rw [← this]
    rfl
  
  have hs3 : ∀ t : ℕ, 1 ≤ t →
      ∑ p ∈ Finset.filter Nat.Prime (Finset.range (t + 1)), Real.log (p : ℝ) / (p : ℝ)
        ≤ Real.log (t : ℝ) + Real.log 4 := by
    intro m hm
    set P := Finset.filter Nat.Prime (Finset.range (m + 1)) with hP
    have hmem : ∀ p ∈ P, p.Prime ∧ p ≤ m := by
      intro p hp
      rw [hP, Finset.mem_filter, Finset.mem_range] at hp
      exact ⟨hp.2, by omega⟩
    have hfact0 : m.factorial ≠ 0 := Nat.factorial_ne_zero m
    have hleg : ∀ p ∈ P, m / p ≤ (m.factorial).factorization p := by
      intro p hp
      obtain ⟨hpp, hpm⟩ := hmem p hp
      rw [← hpp.pow_dvd_iff_le_factorization hfact0]
      rw [hpp.pow_dvd_factorial_iff (b := m + 1)]
      · have h1 : (1 : ℕ) ∈ Finset.Ico 1 (m + 1) := by simp; omega
        have := Finset.single_le_sum (f := fun i => m / p ^ i) (fun _ _ => Nat.zero_le _) h1
        simpa using this
      · have := Nat.log_le_self p m
        omega
    have hlogfact : Real.log (m.factorial : ℝ)
        = ∑ p ∈ P, ((m.factorial).factorization p : ℝ) * Real.log (p : ℝ) := by
      rw [Real.log_nat_eq_sum_factorization]
      apply Finsupp.sum_of_support_subset
      · intro p hp
        rw [Nat.support_factorization, Nat.mem_primeFactors] at hp
        obtain ⟨hpp, hdvd, -⟩ := hp
        rw [hP, Finset.mem_filter, Finset.mem_range]
        refine ⟨?_, hpp⟩
        have := (Nat.Prime.dvd_factorial hpp).1 hdvd
        omega
      · intro p _
        simp
    have hfloor : ∀ p ∈ P, (m : ℝ) / p - 1 ≤ ((m / p : ℕ) : ℝ) := by
      intro p hp
      obtain ⟨hpp, -⟩ := hmem p hp
      have hp0 : (0 : ℝ) < p := by exact_mod_cast hpp.pos
      have h1 := Nat.div_add_mod m p
      have h2 := Nat.mod_lt m hpp.pos
      have h1' : (p : ℝ) * ((m / p : ℕ) : ℝ) + ((m % p : ℕ) : ℝ) = m := by exact_mod_cast h1
      have h2' : ((m % p : ℕ) : ℝ) < p := by exact_mod_cast h2
      rw [div_sub_one hp0.ne', div_le_iff₀ hp0]
      nlinarith
    have hlogp : ∀ p ∈ P, 0 ≤ Real.log (p : ℝ) := fun p _ => Real.log_natCast_nonneg p
    have hA : ∑ p ∈ P, ((m : ℝ) / p - 1) * Real.log (p : ℝ) ≤ Real.log (m.factorial : ℝ) := by
      rw [hlogfact]
      apply Finset.sum_le_sum
      intro p hp
      apply mul_le_mul_of_nonneg_right _ (hlogp p hp)
      refine (hfloor p hp).trans ?_
      exact_mod_cast hleg p hp
    have hmpos : (0 : ℝ) < m := by exact_mod_cast hm
    have hB : Real.log (m.factorial : ℝ) ≤ m * Real.log (m : ℝ) := by
      rw [← Real.log_pow]
      apply Real.log_le_log (by exact_mod_cast Nat.factorial_pos m)
      exact_mod_cast Nat.factorial_le_pow m
    have hC : ∑ p ∈ P, Real.log (p : ℝ) ≤ m * Real.log 4 := by
      have hprod : ((primorial m : ℕ) : ℝ) = ∏ p ∈ P, (p : ℝ) := by
        rw [hP]; unfold primorial; push_cast; rfl
      rw [← Real.log_prod]
      · rw [← hprod, ← Real.log_pow]
        apply Real.log_le_log (by exact_mod_cast primorial_pos m)
        exact_mod_cast primorial_le_4_pow m
      · intro p hp
        exact_mod_cast (hmem p hp).1.ne_zero
    have hsplit : ∑ p ∈ P, ((m : ℝ) / p - 1) * Real.log (p : ℝ)
        = (m : ℝ) * ∑ p ∈ P, Real.log (p : ℝ) / (p : ℝ) - ∑ p ∈ P, Real.log (p : ℝ) := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro p _
      ring
    have hkey : (m : ℝ) * ∑ p ∈ P, Real.log (p : ℝ) / (p : ℝ)
        ≤ (m : ℝ) * (Real.log (m : ℝ) + Real.log 4) := by
      rw [mul_add]; linarith
    exact le_of_mul_le_mul_left hkey hmpos
  
  have hs4 : ∀ m : ℕ, ∑ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), (1 : ℝ) / (p : ℝ)
      ≤ Real.log (max 1 (Real.log (m : ℝ))) + 4 := by
    have hM := hs3
    set S : ℕ → ℝ := fun m =>
      ∑ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), (1 : ℝ) / (p : ℝ) with hS
    set A : ℕ → ℝ := fun m =>
      ∑ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), Real.log (p : ℝ) / (p : ℝ) with hA
    have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hc : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; push_cast; ring
    have hc2 : Real.log 4 * (1 / Real.log 2) = 2 := by rw [hc]; field_simp
    have hAk : ∀ k : ℕ, A (k + 2) ≤ Real.log ((k : ℝ) + 2) + Real.log 4 := by
      intro k
      have := hM (k + 2) (by omega)
      push_cast at this
      exact this
    have inv : ∀ k : ℕ, S (k + 2) - A (k + 2) / Real.log ((k : ℝ) + 2) ≤
        Real.log (Real.log ((k : ℝ) + 2)) - Real.log (Real.log 2)
          + Real.log 4 * (1 / Real.log 2 - 1 / Real.log ((k : ℝ) + 2)) := by
      intro k
      induction k with
      | zero =>
        have hP : Finset.filter Nat.Prime (Finset.range (0 + 2 + 1)) = {2} := by decide
        simp only [hS, hA, hP, Finset.sum_singleton]
        rw [show ((0 : ℕ) : ℝ) + 2 = 2 by norm_num, show ((2 : ℕ) : ℝ) = 2 by norm_num,
          show Real.log 2 / 2 / Real.log 2 = 1 / 2 by field_simp]
        simp
      | succ k ih =>
        obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, ℓ = Real.log ((k : ℝ) + 2) := ⟨_, rfl⟩
        obtain ⟨ℓ', hℓ'⟩ : ∃ ℓ', ℓ' = Real.log (((k + 1 : ℕ) : ℝ) + 2) := ⟨_, rfl⟩
        rw [← hℓ] at ih
        rw [← hℓ']
        have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
        have hℓpos : 0 < ℓ := by rw [hℓ]; exact Real.log_pos (by linarith)
        have hℓle : ℓ ≤ ℓ' := by
          rw [hℓ, hℓ']; exact Real.log_le_log (by positivity) (by push_cast; linarith)
        have hℓ'pos : 0 < ℓ' := lt_of_lt_of_le hℓpos hℓle
        have hid : S (k + 1 + 2) - A (k + 1 + 2) / ℓ' = S (k + 2) - A (k + 2) / ℓ' := by
          simp only [hS, hA]
          rw [show k + 1 + 2 + 1 = (k + 2 + 1) + 1 by ring, Finset.range_add_one,
            Finset.filter_insert]
          split_ifs with hp
          · rw [Finset.sum_insert (by simp), Finset.sum_insert (by simp)]
            have hq : ((k + 2 + 1 : ℕ) : ℝ) ≠ 0 := by positivity
            have heq : ℓ' = Real.log ((k + 2 + 1 : ℕ) : ℝ) := by
              rw [hℓ']; congr 1; push_cast; ring
            have h3 : Real.log ((k + 2 + 1 : ℕ) : ℝ) / ((k + 2 + 1 : ℕ) : ℝ) / ℓ'
                = 1 / ((k + 2 + 1 : ℕ) : ℝ) := by
              rw [← heq]; field_simp
            rw [add_div, h3]; ring
          · rfl
        have hAm := hAk k
        rw [← hℓ] at hAm
        have hD : 0 ≤ 1 / ℓ - 1 / ℓ' := by
          rw [sub_nonneg]; exact one_div_le_one_div_of_le hℓpos hℓle
        have hconc : ℓ * (1 / ℓ - 1 / ℓ') ≤ Real.log ℓ' - Real.log ℓ := by
          have h1 : ℓ * (1 / ℓ - 1 / ℓ') = 1 - ℓ / ℓ' := by field_simp
          have h2 := Real.log_le_sub_one_of_pos (div_pos hℓpos hℓ'pos)
          rw [Real.log_div hℓpos.ne' hℓ'pos.ne'] at h2
          linarith
        have hsplit : S (k + 2) - A (k + 2) / ℓ'
            = (S (k + 2) - A (k + 2) / ℓ) + A (k + 2) * (1 / ℓ - 1 / ℓ') := by
          field_simp; ring
        have hAD : A (k + 2) * (1 / ℓ - 1 / ℓ') ≤ (ℓ + Real.log 4) * (1 / ℓ - 1 / ℓ') :=
          mul_le_mul_of_nonneg_right hAm hD
        have hexp : (ℓ + Real.log 4) * (1 / ℓ - 1 / ℓ')
            = ℓ * (1 / ℓ - 1 / ℓ') + Real.log 4 * (1 / ℓ) - Real.log 4 * (1 / ℓ') := by ring
        have hexp2 : Real.log 4 * (1 / Real.log 2 - 1 / ℓ')
            = Real.log 4 * (1 / Real.log 2) - Real.log 4 * (1 / ℓ') := by ring
        have hexp3 : Real.log 4 * (1 / Real.log 2 - 1 / ℓ)
            = Real.log 4 * (1 / Real.log 2) - Real.log 4 * (1 / ℓ) := by ring
        rw [hid, hsplit, hexp2]
        rw [hexp3] at ih
        linarith
    intro m
    show S m ≤ _
    rcases Nat.lt_or_ge m 2 with h | h
    · have hS0 : S m = 0 := by
        interval_cases m
        · simp only [hS]
          rw [show Finset.filter Nat.Prime (Finset.range (0 + 1)) = ∅ by decide]; simp
        · simp only [hS]
          rw [show Finset.filter Nat.Prime (Finset.range (1 + 1)) = ∅ by decide]; simp
      rw [hS0]
      have := Real.log_nonneg (le_max_left 1 (Real.log (m : ℝ)))
      linarith
    · obtain ⟨k, rfl⟩ : ∃ k, m = k + 2 := ⟨m - 2, by omega⟩
      have hI := inv k
      obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, ℓ = Real.log ((k : ℝ) + 2) := ⟨_, rfl⟩
      rw [← hℓ] at hI
      have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
      have hℓpos : 0 < ℓ := by rw [hℓ]; exact Real.log_pos (by linarith)
      have hAm := hAk k
      rw [← hℓ] at hAm
      have hAl : A (k + 2) / ℓ ≤ 1 + Real.log 4 * (1 / ℓ) := by
        rw [div_le_iff₀ hℓpos]
        have : (1 + Real.log 4 * (1 / ℓ)) * ℓ = ℓ + Real.log 4 := by field_simp
        rw [this]; exact hAm
      have hexp3 : Real.log 4 * (1 / Real.log 2 - 1 / ℓ)
          = Real.log 4 * (1 / Real.log 2) - Real.log 4 * (1 / ℓ) := by ring
      rw [hexp3, hc2] at hI
      have hll2 : -1 ≤ Real.log (Real.log 2) := by
        have he := Real.exp_one_gt_d9
        have hem : Real.exp (-1) * Real.exp 1 = 1 := by rw [← Real.exp_add]; norm_num
        have hep := Real.exp_pos (-1)
        have hl2' := Real.log_two_gt_d9
        have hle : Real.exp (-1) ≤ Real.log 2 := by nlinarith
        have := Real.log_le_log hep hle
        rwa [Real.log_exp] at this
      have hmax : Real.log ℓ ≤ Real.log (max 1 ℓ) := Real.log_le_log hℓpos (le_max_right _ _)
      have hgoal : Real.log (max 1 (Real.log (((k + 2 : ℕ) : ℝ)))) = Real.log (max 1 ℓ) := by
        rw [hℓ]; push_cast; rfl
      rw [hgoal]
      linarith
  
  have hs5 : ∀ m : ℕ,
      ∑ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), (1 : ℝ) / (p : ℝ) ^ 2 ≤ 1 := by
    intro m
    have key : ∀ k : ℕ,
        ∑ p ∈ Finset.filter Nat.Prime (Finset.range (k + 2)), (1 : ℝ) / (p : ℝ) ^ 2
          ≤ 1 - 1 / ((k : ℝ) + 1) := by
      intro k
      induction k with
      | zero =>
        have : Finset.filter Nat.Prime (Finset.range (0 + 2)) = ∅ := by decide
        rw [this]; simp
      | succ k ih =>
        rw [show k + 1 + 2 = (k + 2) + 1 by ring, Finset.range_add_one, Finset.filter_insert]
        have hstep : (1 : ℝ) / ((k : ℝ) + 2) ^ 2
            ≤ 1 / ((k : ℝ) + 1) - 1 / ((k : ℝ) + 2) := by
          rw [div_sub_div _ _ (by positivity) (by positivity),
            div_le_div_iff₀ (by positivity) (by positivity)]
          nlinarith
        have e : ((k + 1 : ℕ) : ℝ) + 1 = (k : ℝ) + 2 := by push_cast; ring
        rw [e]
        split_ifs with hp
        · rw [Finset.sum_insert (by simp)]
          push_cast
          linarith
        · have : (0 : ℝ) ≤ 1 / ((k : ℝ) + 2) ^ 2 := by positivity
          linarith
    rcases Nat.lt_or_ge m 1 with h | h
    · obtain rfl : m = 0 := by omega
      rw [show Finset.filter Nat.Prime (Finset.range (0 + 1)) = ∅ by decide]
      simp
    · obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
      have := key k
      have : (0:ℝ) ≤ 1 / ((k : ℝ) + 1) := by positivity
      linarith
  
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = Module.finrank ℚ K := ⟨_, rfl⟩
  have hn1 : 1 ≤ n := by rw [hn]; exact Module.finrank_pos
  have hs2 : ∀ p : ℕ, p.Prime → (p : ℝ) ^ n / (phiK K p : ℝ) ≤
      (if p < 2 * n then ((2 * n : ℕ) : ℝ) ^ n else 1) *
        Real.exp ((n : ℝ) / p + 2 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2) := by
    intro p hp
    obtain ⟨-, h1, -, h3⟩ := kai_phiK_prime_bounds K p hp
    rw [← hn] at h3
    have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
    have hE : 1 ≤ Real.exp ((n : ℝ) / p + 2 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2) :=
      Real.one_le_exp (by positivity)
    have hphi : (1 : ℝ) ≤ (phiK K p : ℝ) := by exact_mod_cast h1
    split_ifs with hlt
    · calc (p : ℝ) ^ n / (phiK K p : ℝ) ≤ (p : ℝ) ^ n := div_le_self (by positivity) hphi
        _ ≤ ((2 * n : ℕ) : ℝ) ^ n := pow_le_pow_left₀ hp0.le (by exact_mod_cast hlt.le) n
        _ ≤ _ := le_mul_of_one_le_right (by positivity) hE
    · push_neg at hlt
      rw [one_mul]
      have h2n : (2 * (n : ℝ)) ≤ p := by exact_mod_cast hlt
      have hx0 : 0 ≤ (n : ℝ) / p := by positivity
      have hx : (n : ℝ) / p ≤ 1 / 2 := by rw [div_le_iff₀ hp0]; linarith
      have h1x : 0 < 1 - (n : ℝ) / p := by linarith
      have hpos : 0 < (p : ℝ) ^ n * (1 - (n : ℝ) / p) := mul_pos (pow_pos hp0 n) h1x
      have hreal : 1 / (1 - (n : ℝ) / p) ≤ Real.exp ((n : ℝ) / p + 2 * ((n : ℝ) / p) ^ 2) := by
        rw [div_le_iff₀ h1x]
        have := Real.add_one_le_exp ((n : ℝ) / p + 2 * ((n : ℝ) / p) ^ 2)
        nlinarith [sq_nonneg ((n : ℝ) / p),
          mul_nonneg (sq_nonneg ((n : ℝ) / p)) (show 0 ≤ 1 - 2 * ((n : ℝ) / p) by linarith)]
      calc (p : ℝ) ^ n / (phiK K p : ℝ) ≤ (p : ℝ) ^ n / ((p : ℝ) ^ n * (1 - (n : ℝ) / p)) :=
            div_le_div_of_nonneg_left (by positivity) hpos h3
        _ = 1 / (1 - (n : ℝ) / p) := by
            rw [div_mul_eq_div_div, div_self (pow_pos hp0 n).ne']
        _ ≤ Real.exp ((n : ℝ) / p + 2 * ((n : ℝ) / p) ^ 2) := hreal
        _ = Real.exp ((n : ℝ) / p + 2 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2) := by
            congr 1; rw [div_pow]; ring
  
  rw [← hn]
  have hX1 : (1 : ℝ) ≤ ((2 * n : ℕ) : ℝ) := by exact_mod_cast (show 1 ≤ 2 * n by omega)
  refine ⟨((2 * n : ℕ) : ℝ) ^ (2 * n) * Real.exp (4 + 2 * n),
    one_le_mul_of_one_le_of_one_le (one_le_pow₀ hX1) (Real.one_le_exp (by positivity)), ?_⟩
  intro m
  set P := Finset.filter Nat.Prime (Finset.range (m + 1)) with hP
  have hMpos : 0 < max 1 (Real.log m) := lt_of_lt_of_le one_pos (le_max_left _ _)
  have hprim : ((primorial m : ℕ) : ℝ) = ∏ p ∈ P, (p : ℝ) := by
    rw [hP]; unfold primorial; push_cast; rfl
  have hphi : ((phiK K (primorial m) : ℕ) : ℝ) = ∏ p ∈ P, (phiK K p : ℝ) := by
    rw [hs1 m]; push_cast; rfl
  rw [hprim, hphi, ← Finset.prod_pow, ← Finset.prod_div_distrib]
  have ha : ∏ p ∈ P, (if p < 2 * n then ((2 * n : ℕ) : ℝ) ^ n else 1)
      ≤ (((2 * n : ℕ) : ℝ) ^ n) ^ (2 * n) := by
    rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const_one, mul_one]
    apply pow_le_pow_right₀ (one_le_pow₀ hX1)
    calc (Finset.filter (fun p => p < 2 * n) P).card ≤ (Finset.range (2 * n)).card := by
          apply Finset.card_le_card
          intro p hp
          rw [Finset.mem_filter] at hp
          rw [Finset.mem_range]; exact hp.2
      _ = 2 * n := Finset.card_range _
  have he : ∑ p ∈ P, ((n : ℝ) / p + 2 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2)
      ≤ (n : ℝ) * (Real.log (max 1 (Real.log m)) + 4) + 2 * (n : ℝ) ^ 2 := by
    have hsum : ∑ p ∈ P, ((n : ℝ) / p + 2 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2)
        = (n : ℝ) * ∑ p ∈ P, (1 : ℝ) / (p : ℝ)
          + 2 * (n : ℝ) ^ 2 * ∑ p ∈ P, (1 : ℝ) / (p : ℝ) ^ 2 := by
      rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
      congr 1 <;> apply Finset.sum_congr rfl <;> intro p _ <;> ring
    rw [hsum]
    have h4 := hs4 m
    have h5 := hs5 m
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have t1 := mul_le_mul_of_nonneg_left h4 hn0
    have t2 := mul_le_mul_of_nonneg_left h5 (by positivity : (0 : ℝ) ≤ 2 * (n : ℝ) ^ 2)
    linarith
  have hfin : (((2 * n : ℕ) : ℝ) ^ n) ^ (2 * n)
      * Real.exp ((n : ℝ) * (Real.log (max 1 (Real.log m)) + 4) + 2 * (n : ℝ) ^ 2)
      = (((2 * n : ℕ) : ℝ) ^ (2 * n) * Real.exp (4 + 2 * n) * max 1 (Real.log m)) ^ n := by
    have e0 : (n : ℝ) * (Real.log (max 1 (Real.log m)) + 4) + 2 * (n : ℝ) ^ 2
        = (n : ℝ) * Real.log (max 1 (Real.log m)) + (n : ℝ) * (4 + 2 * n) := by ring
    rw [e0, Real.exp_add, Real.exp_nat_mul, Real.exp_nat_mul, Real.exp_log hMpos,
      mul_pow, mul_pow, ← pow_mul, ← pow_mul]
    ring
  calc ∏ p ∈ P, (p : ℝ) ^ n / (phiK K p : ℝ)
      ≤ ∏ p ∈ P, ((if p < 2 * n then ((2 * n : ℕ) : ℝ) ^ n else 1) *
          Real.exp ((n : ℝ) / p + 2 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2)) := by
        apply Finset.prod_le_prod
        · intro p _; positivity
        · intro p hp; exact hs2 p (Finset.mem_filter.1 hp).2
    _ = (∏ p ∈ P, (if p < 2 * n then ((2 * n : ℕ) : ℝ) ^ n else 1)) *
          Real.exp (∑ p ∈ P, ((n : ℝ) / p + 2 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2)) := by
        rw [Finset.prod_mul_distrib, Real.exp_sum]
    _ ≤ (((2 * n : ℕ) : ℝ) ^ n) ^ (2 * n)
          * Real.exp ((n : ℝ) * (Real.log (max 1 (Real.log m)) + 4) + 2 * (n : ℝ) ^ 2) := by
        apply mul_le_mul ha (Real.exp_le_exp.2 he) (Real.exp_pos _).le (by positivity)
    _ = _ := hfin

theorem kai_qmodel_sieve_comparison (K : Type u) [Field K] [NumberField K]
    (ρ : ℝ) (hρ : 0 ≤ ρ) :
    ∀ (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ
          (NumberField.RingOfIntegers K)),
      IsNormLengthCompatible C ω →
      ∃ c₂ C₂ : ℝ, 0 < c₂ ∧ 0 ≤ C₂ ∧
        ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
          Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
          (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
        ∀ (Dt : Ideal (NumberField.RingOfIntegers K) ×
            (NumberField.RingOfIntegers K → ℤ) × ℝ),
          IsSiegelDatum m Dt →
        ∀ (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet Ω → Convex ℝ Ω →
        ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
          (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₂) →
        ∀ a : NumberField.RingOfIntegers K,
          |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧ x - a ∈ 𝔮)
                (fun _ => Classical.propDecidable _) (omegaBox ω M),
              (siegelModel K ρ (primorial m) Dt.2.1 Dt.2.2 x
                - qSiegelModel K ρ 𝔮 Dt.1 Dt.2.1 Dt.2.2 x)|
            ≤ C₂ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ c₂)) :=
by
  classical
  intro C ω hω
  obtain ⟨Cs, c, hCs, hc, hS1⟩ := kai_coset_sieve_fundamental K ω
  obtain ⟨C', hC', hS2⟩ := kai_siegel_cube_reduction K ω
  obtain ⟨C_M, hC_M, hdens⟩ := kai_cramer_density_bound K
  obtain ⟨K₀, hK₀, hNum⟩ := kai_qmodel_numerics (Module.finrank ℚ K) C_M c hC_M hc
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hD0 : 0 ≤ 2 ^ (Module.finrank ℚ K - 1) * Cs + C' * (Cs + 2) :=
    add_nonneg (mul_nonneg (pow_nonneg (by norm_num) _) hCs) (mul_nonneg hC' (by linarith))
  have hC₂ : 0 ≤ ρ * (2 ^ (Module.finrank ℚ K - 1) * Cs + C' * (Cs + 2)) * K₀ :=
    mul_nonneg (mul_nonneg hρ hD0) hK₀
  refine ⟨(1:ℝ)/200, ρ * (2 ^ (Module.finrank ℚ K - 1) * Cs + C' * (Cs + 2)) * K₀,
    by norm_num, hC₂, ?_⟩
  intro M m hM h1 h2 Dt hDt Ω hΩm hΩc 𝔮 h𝔮 hN a
  
  have hMpos : (0:ℝ) < M := by linarith
  have hℓ1 : 1 ≤ Real.log M := by
    rw [Real.le_log_iff_exp_le hMpos]
    have := Real.exp_one_lt_d9
    linarith
  have hr200_100 : Real.log M ^ ((1:ℝ)/200) ≤ Real.log M ^ ((1:ℝ)/100) :=
    Real.rpow_le_rpow_of_exponent_le hℓ1 (by norm_num)
  have hr200_3 : Real.log M ^ ((1:ℝ)/200) ≤ Real.log M ^ ((1:ℝ)/3) :=
    Real.rpow_le_rpow_of_exponent_le hℓ1 (by norm_num)
  have hr3_1 : 1 ≤ Real.log M ^ ((1:ℝ)/3) := Real.one_le_rpow hℓ1 (by norm_num)
  have hmpos : (0:ℝ) < m := lt_of_lt_of_le (Real.exp_pos _) h1
  have hNm : (Ideal.absNorm 𝔮 : ℝ) ≤ m := hN.trans ((Real.exp_le_exp.2 hr200_100).trans h1)
  have hm1 : (m : ℝ) ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) := by linarith
  have hlogm : Real.log m ≤ Real.log M ^ ((1:ℝ)/3) := by
    have := Real.log_le_log hmpos hm1
    rwa [Real.log_exp] at this
  have hmax : max 1 (Real.log m) ≤ Real.log M ^ ((1:ℝ)/3) := max_le hr3_1 hlogm
  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ,
      κ = (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ) := ⟨_, rfl⟩
  have hκ0 : 0 ≤ κ := by rw [hκdef]; positivity
  have hκle : κ ≤ (C_M * Real.log M ^ ((1:ℝ)/3)) ^ Module.finrank ℚ K := by
    rw [hκdef]
    exact (hdens m).trans (pow_le_pow_left₀ (mul_nonneg (by linarith)
      (le_trans zero_le_one (le_max_left _ _))) (mul_le_mul_of_nonneg_left hmax (by linarith)) _)
  have hNq2 : (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (2 * Real.log M ^ ((1:ℝ)/3)) :=
    hN.trans (Real.exp_le_exp.2 (by linarith))
  
  have hprimes : ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
      (Ideal.absNorm 𝔮 : ℝ) ≤ (m : ℝ) →
      ∀ 𝔭 : Ideal (NumberField.RingOfIntegers K), 𝔭.IsPrime → 𝔮 ≤ 𝔭 →
        ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 := by
    intro 𝔮 h𝔮 hN 𝔭 h𝔭 hle
    have hdvd : Ideal.absNorm 𝔭 ∣ Ideal.absNorm 𝔮 := Ideal.absNorm_dvd_absNorm_of_le hle
    have hq0 : Ideal.absNorm 𝔮 ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact h𝔮
    have hkm : Ideal.absNorm 𝔭 ≤ m := by
      have h1 : Ideal.absNorm 𝔭 ≤ Ideal.absNorm 𝔮 :=
        Nat.le_of_dvd (Nat.pos_of_ne_zero hq0) hdvd
      have h2 : Ideal.absNorm 𝔮 ≤ m := by exact_mod_cast hN
      omega
    have hk1 : Ideal.absNorm 𝔭 ≠ 1 := by
      rw [Ne, Ideal.absNorm_eq_one_iff]; exact h𝔭.ne_top
    have hk0 : Ideal.absNorm 𝔭 ≠ 0 := by
      intro h0
      rw [h0] at hdvd
      exact hq0 (zero_dvd_iff.1 hdvd)
    have hkmem : ((Ideal.absNorm 𝔭 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 :=
      Ideal.absNorm_mem 𝔭
    have claim : ∀ j : ℕ, j ≠ 1 → ((j : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 → j ≠ 0 →
        ∃ p : ℕ, p.Prime ∧ p ≤ j ∧ ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 := by
      intro j
      induction j using Nat.strong_induction_on with
      | _ j ih =>
        intro hj1 hjmem hj0
        have hp := Nat.minFac_prime hj1
        obtain ⟨c, hc⟩ := Nat.minFac_dvd j
        have hmul : ((j.minFac : ℕ) : NumberField.RingOfIntegers K)
            * ((c : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 := by
          rw [← Nat.cast_mul, ← hc]; exact hjmem
        rcases h𝔭.mem_or_mem hmul with h | h
        · exact ⟨j.minFac, hp, Nat.minFac_le (Nat.pos_of_ne_zero hj0), h⟩
        · have hc0 : c ≠ 0 := by
            rintro rfl
            rw [mul_zero] at hc
            exact hj0 hc
          have hc1 : c ≠ 1 := by
            rintro rfl
            rw [Nat.cast_one] at h
            exact h𝔭.ne_top ((Ideal.eq_top_iff_one _).2 h)
          have hclt : c < j := by
            have h2 := hp.two_le
            have hcpos := Nat.pos_of_ne_zero hc0
            nlinarith
          obtain ⟨p, hp', hpc, hpmem⟩ := ih c hclt hc1 h hc0
          exact ⟨p, hp', hpc.trans hclt.le, hpmem⟩
    obtain ⟨p, hp, hpk, hpmem⟩ := claim _ hk1 hkmem hk0
    have hdv : p ∣ primorial m := by
      unfold primorial
      exact Finset.dvd_prod_of_mem _
        (Finset.mem_filter.2 ⟨Finset.mem_range.2 (by omega), hp⟩)
    obtain ⟨c, hc⟩ := hdv
