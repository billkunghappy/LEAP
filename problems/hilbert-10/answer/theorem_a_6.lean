          (fun x : ℝ => f ((c : ℝ) : ℂ) * (γ x - ((c : ℝ) : ℂ))⁻¹) MeasureTheory.volume p q :=
        (continuous_const.mul ((hγ.sub continuous_const).inv₀ hγc)).intervalIntegrable p q
      have hpt : ∀ x : ℝ, f (γ x) / (γ x - ((c : ℝ) : ℂ))
          = dslope f ((c : ℝ) : ℂ) (γ x) + f ((c : ℝ) : ℂ) * (γ x - ((c : ℝ) : ℂ))⁻¹ := by
        intro x
        have h0 := hγc x
        have hds : (γ x - ((c : ℝ) : ℂ)) * dslope f ((c : ℝ) : ℂ) (γ x)
            = f (γ x) - f ((c : ℝ) : ℂ) := by
          simpa [smul_eq_mul] using sub_smul_dslope f ((c : ℝ) : ℂ) (γ x)
        rw [div_eq_iff h0, add_mul, mul_assoc, inv_mul_cancel₀ h0, mul_one]
        linear_combination -hds
      rw [intervalIntegral.integral_congr (fun x _ => hpt x),
          intervalIntegral.integral_add hint1 hint2,
          intervalIntegral.integral_const_mul]
    have eBo : (∫ u : ℝ in a..b,
          f ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) /
            ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I - (c : ℂ)))
        = (∫ u : ℝ in a..b, dslope f ((c : ℝ) : ℂ) ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I))
          + f ((c : ℝ) : ℂ) *
              ∫ u : ℝ in a..b, ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I - (c : ℂ))⁻¹ :=
      edge (fun u : ℝ => (u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) a b (by fun_prop) hnzBo intBo
    have eTo : (∫ u : ℝ in a..b,
          f ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I) /
            ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I - (c : ℂ)))
        = (∫ u : ℝ in a..b, dslope f ((c : ℝ) : ℂ) ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I))
          + f ((c : ℝ) : ℂ) *
              ∫ u : ℝ in a..b, ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I - (c : ℂ))⁻¹ :=
      edge (fun u : ℝ => (u : ℂ) + ((T : ℝ) : ℂ) * Complex.I) a b (by fun_prop) hnzTo intTo
    have eRg : (∫ v : ℝ in (-T)..T,
          f ((b : ℂ) + (v : ℂ) * Complex.I) / ((b : ℂ) + (v : ℂ) * Complex.I - (c : ℂ)))
        = (∫ v : ℝ in (-T)..T, dslope f ((c : ℝ) : ℂ) ((b : ℂ) + (v : ℂ) * Complex.I))
          + f ((c : ℝ) : ℂ) * ∫ v : ℝ in (-T)..T, ((b : ℂ) + (v : ℂ) * Complex.I - (c : ℂ))⁻¹ :=
      edge (fun v : ℝ => (b : ℂ) + (v : ℂ) * Complex.I) (-T) T (by fun_prop) hnzRg intRg
    have eLe : (∫ v : ℝ in (-T)..T,
          f ((a : ℂ) + (v : ℂ) * Complex.I) / ((a : ℂ) + (v : ℂ) * Complex.I - (c : ℂ)))
        = (∫ v : ℝ in (-T)..T, dslope f ((c : ℝ) : ℂ) ((a : ℂ) + (v : ℂ) * Complex.I))
          + f ((c : ℝ) : ℂ) * ∫ v : ℝ in (-T)..T, ((a : ℂ) + (v : ℂ) * Complex.I - (c : ℂ))⁻¹ :=
      edge (fun v : ℝ => (a : ℂ) + (v : ℂ) * Complex.I) (-T) T (by fun_prop) hnzLe intLe
    have hPrg : (∫ v : ℝ in (-T)..T, ((b : ℂ) + (v : ℂ) * Complex.I - (c : ℂ))⁻¹)
        = 2 * ((Real.arctan (T / (b - c)) : ℝ) : ℂ) := by
      rw [← hA1 (b - c) T hbc0]
      apply intervalIntegral.integral_congr
      intro v _
      push_cast
      ring
    have hPle : (∫ v : ℝ in (-T)..T, ((a : ℂ) + (v : ℂ) * Complex.I - (c : ℂ))⁻¹)
        = 2 * ((Real.arctan (T / (a - c)) : ℝ) : ℂ) := by
      rw [← hA1 (a - c) T hac0]
      apply intervalIntegral.integral_congr
      intro v _
      push_cast
      ring
    have hPhor := hA2 a b c T hT0
    have key : Real.arctan ((b - c) / T) - Real.arctan ((a - c) / T)
        + Real.arctan (T / (b - c)) - Real.arctan (T / (a - c)) = Real.pi := by
      have e1 : (a - c) / T = -((c - a) / T) := by
        rw [show a - c = -(c - a) by ring, neg_div]
      have e2 : T / (a - c) = -(T / (c - a)) := by
        rw [show a - c = -(c - a) by ring, div_neg]
      have p1 : Real.arctan (T / (b - c)) = Real.pi / 2 - Real.arctan ((b - c) / T) := by
        rw [show T / (b - c) = ((b - c) / T)⁻¹ from (inv_div (b - c) T).symm]
        exact Real.arctan_inv_of_pos (div_pos hbc hT)
      have p2 : Real.arctan (T / (c - a)) = Real.pi / 2 - Real.arctan ((c - a) / T) := by
        rw [show T / (c - a) = ((c - a) / T)⁻¹ from (inv_div (c - a) T).symm]
        exact Real.arctan_inv_of_pos (div_pos hca hT)
      rw [e1, e2, Real.arctan_neg, Real.arctan_neg, p1, p2]
      ring
    have hpi : ((Real.arctan ((b - c) / T) - Real.arctan ((a - c) / T) : ℝ) : ℂ)
        + ((Real.arctan (T / (b - c)) : ℝ) : ℂ) - ((Real.arctan (T / (a - c)) : ℝ) : ℂ)
        = ((Real.pi : ℝ) : ℂ) := by
      rw [← key]
      push_cast
      ring
    rw [eBo, eTo, eRg, eLe, hPrg, hPle]
    linear_combination hCG + f ((c : ℝ) : ℂ) * hPhor
      + 2 * Complex.I * f ((c : ℝ) : ℂ) * hpi
  
  have hσβ' : σ₁ < β := by linarith
  have hβκ : β < κ := by linarith
  have hσ0 : 0 < σ₁ := by linarith
  have hT0 : 0 < T := by linarith
  have hy0 : 0 < y := by linarith
  have hy1 : 1 ≤ y := by linarith
  have hyne : (y : ℂ) ≠ 0 := by exact_mod_cast hy0.ne'
  
  have hfd : ∀ z : ℂ, σ₁ ≤ z.re → z.re ≤ κ → |z.im| ≤ T →
      DifferentiableAt ℂ (fun s : ℂ => (y : ℂ) ^ s / s ^ 2) z := by
    intro z hz _ _
    have hz0 : z ≠ 0 := Complex.ne_zero_of_re_pos (by linarith)
    exact (DifferentiableAt.const_cpow differentiableAt_id (Or.inl hyne)).div
      (differentiableAt_id.pow 2) (pow_ne_zero 2 hz0)
  have h := hrect (fun s : ℂ => (y : ℂ) ^ s / s ^ 2) σ₁ κ β T hσβ' hβκ hT0 hfd
  beta_reduce at h
  
  have hhor : ∀ t : ℝ, |t| = T → ‖∫ u : ℝ in σ₁..κ,
      (y : ℂ) ^ ((u : ℂ) + (t : ℂ) * Complex.I) / ((u : ℂ) + (t : ℂ) * Complex.I) ^ 2 /
        ((u : ℂ) + (t : ℂ) * Complex.I - (β : ℂ))‖ ≤ y ^ κ / (2 * T ^ 2) := by
    intro t ht
    have hσκ : σ₁ ≤ κ := by linarith
    have hyκ : 0 < y ^ κ := Real.rpow_pos_of_pos hy0 κ
    have hT3 : 0 < T ^ 3 := by positivity
    have key : ∀ u ∈ Set.uIoc σ₁ κ, ‖(y : ℂ) ^ ((u : ℂ) + (t : ℂ) * Complex.I) /
        ((u : ℂ) + (t : ℂ) * Complex.I) ^ 2 /
        ((u : ℂ) + (t : ℂ) * Complex.I - (β : ℂ))‖ ≤ y ^ κ / T ^ 3 := by
      intro u hu
      rw [Set.uIoc_of_le hσκ, Set.mem_Ioc] at hu
      have hsre : ((u : ℂ) + (t : ℂ) * Complex.I).re = u := by simp
      have hsim : ((u : ℂ) + (t : ℂ) * Complex.I).im = t := by simp
      have hTs : T ≤ ‖(u : ℂ) + (t : ℂ) * Complex.I‖ := by
        have h := Complex.abs_im_le_norm ((u : ℂ) + (t : ℂ) * Complex.I)
        rw [hsim, ht] at h; exact h
      have hTsb : T ≤ ‖(u : ℂ) + (t : ℂ) * Complex.I - (β : ℂ)‖ := by
        have h := Complex.abs_im_le_norm ((u : ℂ) + (t : ℂ) * Complex.I - (β : ℂ))
        rw [Complex.sub_im, hsim, Complex.ofReal_im, sub_zero, ht] at h; exact h
      have hXn : ‖(y : ℂ) ^ ((u : ℂ) + (t : ℂ) * Complex.I)‖ ≤ y ^ κ := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hy0, hsre]
        exact Real.rpow_le_rpow_of_exponent_le hy1 hu.2
      have hs2 : T ^ 2 ≤ ‖((u : ℂ) + (t : ℂ) * Complex.I) ^ 2‖ := by
        rw [norm_pow]; exact pow_le_pow_left₀ hT0.le hTs 2
      have hden : T ^ 3 ≤ ‖((u : ℂ) + (t : ℂ) * Complex.I) ^ 2‖ *
          ‖(u : ℂ) + (t : ℂ) * Complex.I - (β : ℂ)‖ := by
        have e : T ^ 3 = T ^ 2 * T := by ring
        rw [e]; exact mul_le_mul hs2 hTsb hT0.le (norm_nonneg _)
      rw [norm_div, norm_div, div_div]
      exact div_le_div₀ hyκ.le hXn hT3 hden
    refine le_trans (intervalIntegral.norm_integral_le_of_norm_le_const key) ?_
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ κ - σ₁)]
    have hw : κ - σ₁ ≤ 3 / 2 := by linarith
    have h1a : (κ - σ₁) * (2 * T ^ 2) ≤ 3 * T ^ 2 := by nlinarith [sq_nonneg T]
    have h1b : 3 * T ^ 2 ≤ T ^ 3 := by
      nlinarith [mul_le_mul_of_nonneg_left hT (sq_nonneg T)]
    rw [div_mul_eq_mul_div, div_le_div_iff₀ hT3 (by positivity)]
    calc y ^ κ * (κ - σ₁) * (2 * T ^ 2) = y ^ κ * ((κ - σ₁) * (2 * T ^ 2)) := by ring
      _ ≤ y ^ κ * T ^ 3 := mul_le_mul_of_nonneg_left (h1a.trans h1b) hyκ.le
  
  have hleft : ‖∫ v : ℝ in (-T)..T,
      (y : ℂ) ^ ((σ₁ : ℂ) + (v : ℂ) * Complex.I) / ((σ₁ : ℂ) + (v : ℂ) * Complex.I) ^ 2 /
        ((σ₁ : ℂ) + (v : ℂ) * Complex.I - (β : ℂ))‖ ≤ 4 * Real.pi * y ^ σ₁ / ρ := by
    have hyσ : 0 ≤ y ^ σ₁ := Real.rpow_nonneg hy0.le σ₁
    have hTT : -T ≤ T := by linarith
    have hpt : ∀ v : ℝ, ‖(y : ℂ) ^ ((σ₁ : ℂ) + (v : ℂ) * Complex.I) /
        ((σ₁ : ℂ) + (v : ℂ) * Complex.I) ^ 2 /
        ((σ₁ : ℂ) + (v : ℂ) * Complex.I - (β : ℂ))‖ ≤ (4 * y ^ σ₁ / ρ) * (1 / (1 + v ^ 2)) := by
      intro v
      have hsre : ((σ₁ : ℂ) + (v : ℂ) * Complex.I).re = σ₁ := by simp
      have hbre : ((σ₁ : ℂ) + (v : ℂ) * Complex.I - (β : ℂ)).re = σ₁ - β := by simp
      have hD0 : (0 : ℝ) ≤ σ₁ ^ 2 + v ^ 2 := by positivity
      have hnorm_s2 : ‖((σ₁ : ℂ) + (v : ℂ) * Complex.I) ^ 2‖ = σ₁ ^ 2 + v ^ 2 := by
        rw [norm_pow, Complex.norm_add_mul_I, Real.sq_sqrt hD0]
      have hcpow : ‖(y : ℂ) ^ ((σ₁ : ℂ) + (v : ℂ) * Complex.I)‖ = y ^ σ₁ := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hy0, hsre]
      have hKw : ρ ≤ ‖(σ₁ : ℂ) + (v : ℂ) * Complex.I - (β : ℂ)‖ := by
        have h := Complex.abs_re_le_norm ((σ₁ : ℂ) + (v : ℂ) * Complex.I - (β : ℂ))
        rw [hbre, abs_of_neg (by linarith : σ₁ - β < 0)] at h
        linarith
      have hD : (1 + v ^ 2) / 4 ≤ σ₁ ^ 2 + v ^ 2 := by
        nlinarith [sq_nonneg v, mul_le_mul hσ1 hσ1 (by norm_num) hσ0.le]
      rw [norm_div, norm_div, hcpow, hnorm_s2, div_div]
      have hpos : 0 < (1 + v ^ 2) / 4 * ρ := by positivity
      have hv1 : (1 + v ^ 2) ≠ 0 := by positivity
      calc y ^ σ₁ / ((σ₁ ^ 2 + v ^ 2) * ‖(σ₁ : ℂ) + (v : ℂ) * Complex.I - (β : ℂ)‖)
          ≤ y ^ σ₁ / ((1 + v ^ 2) / 4 * ρ) :=
            div_le_div_of_nonneg_left hyσ hpos (mul_le_mul hD hKw hρ.le hD0)
        _ = (4 * y ^ σ₁ / ρ) * (1 / (1 + v ^ 2)) := by
            field_simp
    have hgint : IntervalIntegrable (fun v : ℝ => (4 * y ^ σ₁ / ρ) * (1 / (1 + v ^ 2)))
        MeasureTheory.volume (-T) T := by
      apply Continuous.intervalIntegrable
      apply continuous_const.mul
      apply Continuous.div continuous_const (by fun_prop)
      intro v; positivity
    refine le_trans (intervalIntegral.norm_integral_le_of_norm_le hTT
      (Filter.Eventually.of_forall (fun v _ => hpt v)) hgint) ?_
    rw [intervalIntegral.integral_const_mul, integral_one_div_one_add_sq, Real.arctan_neg]
    have harc : Real.arctan T < Real.pi / 2 := Real.arctan_lt_pi_div_two T
    have hc : 0 ≤ 4 * y ^ σ₁ / ρ := by positivity
    calc 4 * y ^ σ₁ / ρ * (Real.arctan T - -Real.arctan T) ≤ 4 * y ^ σ₁ / ρ * Real.pi :=
          mul_le_mul_of_nonneg_left (by linarith) hc
      _ = 4 * Real.pi * y ^ σ₁ / ρ := by ring
  
  have hfin : ∀ (Bo To Ri Le r : ℂ),
      (Bo - To) + Complex.I * Ri - Complex.I * Le = 2 * (Real.pi : ℂ) * Complex.I * r →
      ‖Bo‖ ≤ y ^ κ / (2 * T ^ 2) → ‖To‖ ≤ y ^ κ / (2 * T ^ 2) →
      ‖Le‖ ≤ 4 * Real.pi * y ^ σ₁ / ρ →
      ‖(1 / (2 * (Real.pi : ℂ) * Complex.I)) * (Complex.I * Ri) - r‖
        ≤ 2 * y ^ σ₁ * (1 / ρ + 1 / (1 - σ₁) + 1) + y ^ κ / T ^ 2 := by
    intro Bo To Ri Le r hR hB hTo hL
    have hpi0 : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
    have hne : (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 :=
      mul_ne_zero (mul_ne_zero two_ne_zero hpi0) Complex.I_ne_zero
    have hIR : Complex.I * Ri = 2 * (Real.pi : ℂ) * Complex.I * r
        + (Complex.I * Le - Bo + To) := by linear_combination hR
    have heq : (1 / (2 * (Real.pi : ℂ) * Complex.I)) * (Complex.I * Ri) - r
        = (1 / (2 * (Real.pi : ℂ) * Complex.I)) * (Complex.I * Le - Bo + To) := by
      rw [hIR, mul_add, one_div, inv_mul_cancel_left₀ hne]
      ring
    have hn : ‖(1 / (2 * (Real.pi : ℂ) * Complex.I))‖ = 1 / (2 * Real.pi) := by
      rw [norm_div, norm_one, norm_mul, norm_mul, Complex.norm_I, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos Real.pi_pos]
      norm_num
    have hW : ‖Complex.I * Le - Bo + To‖ ≤ 4 * Real.pi * y ^ σ₁ / ρ + y ^ κ / T ^ 2 := by
      have h1 : ‖Complex.I * Le - Bo + To‖ ≤ ‖Complex.I * Le‖ + ‖Bo‖ + ‖To‖ := by
        have e1 := norm_add_le (Complex.I * Le - Bo) To
        have e2 := norm_sub_le (Complex.I * Le) Bo
        linarith
      rw [norm_mul, Complex.norm_I, one_mul] at h1
      have hT2 : T ^ 2 ≠ 0 := by positivity
      have h2 : y ^ κ / (2 * T ^ 2) + y ^ κ / (2 * T ^ 2) = y ^ κ / T ^ 2 := by
        field_simp
        ring
      linarith
    rw [heq, norm_mul, hn]
    have hpi : 0 < Real.pi := Real.pi_pos
    have hpi' : Real.pi ≠ 0 := Real.pi_ne_zero
    have hρ' : ρ ≠ 0 := hρ.ne'
    have hyσ : 0 ≤ y ^ σ₁ := Real.rpow_nonneg hy0.le σ₁
    have hyκ : 0 ≤ y ^ κ / T ^ 2 := by positivity
    have hα : 0 < 1 / (1 - σ₁) := by apply one_div_pos.mpr; linarith
    calc 1 / (2 * Real.pi) * ‖Complex.I * Le - Bo + To‖
        ≤ 1 / (2 * Real.pi) * (4 * Real.pi * y ^ σ₁ / ρ + y ^ κ / T ^ 2) :=
          mul_le_mul_of_nonneg_left hW (by positivity)
      _ = 2 * y ^ σ₁ * (1 / ρ) + (y ^ κ / T ^ 2) / (2 * Real.pi) := by
          field_simp
          ring
      _ ≤ 2 * y ^ σ₁ * (1 / ρ + 1 / (1 - σ₁) + 1) + y ^ κ / T ^ 2 := by
          have h1 : (y ^ κ / T ^ 2) / (2 * Real.pi) ≤ y ^ κ / T ^ 2 := by
            apply div_le_self hyκ; linarith [Real.pi_gt_three]
          have h2 : 2 * y ^ σ₁ * (1 / ρ) ≤ 2 * y ^ σ₁ * (1 / ρ + 1 / (1 - σ₁) + 1) := by
            apply mul_le_mul_of_nonneg_left _ (by positivity); linarith
          linarith
  
  have hint : (∫ τ in (-T)..T, Complex.I *
          (1 / ((κ : ℂ) + (τ : ℂ) * Complex.I - (β : ℂ))) *
          (y : ℂ) ^ ((κ : ℂ) + (τ : ℂ) * Complex.I) /
            ((κ : ℂ) + (τ : ℂ) * Complex.I) ^ 2)
      = Complex.I * ∫ v : ℝ in (-T)..T,
          (y : ℂ) ^ ((κ : ℂ) + (v : ℂ) * Complex.I) / ((κ : ℂ) + (v : ℂ) * Complex.I) ^ 2 /
            ((κ : ℂ) + (v : ℂ) * Complex.I - (β : ℂ)) := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro v _
    simp only [div_eq_mul_inv, one_mul]
    ring
  have hres : (y : ℂ) ^ (β : ℂ) / (β : ℂ) ^ 2 = (((y ^ β / β ^ 2 : ℝ)) : ℂ) := by
    rw [Complex.ofReal_div, Complex.ofReal_cpow hy0.le, Complex.ofReal_pow]
  rw [hint, ← hres]
  exact hfin _ _ _ _ _ h (hhor (-T) (by rw [abs_neg, abs_of_pos hT0]))
    (hhor T (abs_of_pos hT0)) hleft

theorem kai_lp_logsum_pole (K : Type u) [Field K] [NumberField K]
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (h1 : lam 1 = 1)
    (hmul : ∀ I J : Ideal (NumberField.RingOfIntegers K), lam (I * J) = lam I * lam J)
    (hbd : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1)
    (E : ℕ) (G : ℂ → ℂ) (hE : E ≤ 1) (hG : Differentiable ℂ G)
    (hEG : ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s)
    (x X Λ B y σ₁ β₀ M ρ S N : ℝ)
    (hx : 3 ≤ x) (hX : X = Real.log x) (hX4 : 4 ≤ X)
    (hΛ : Real.sqrt X ≤ Λ) (hB0 : 0 < B) (hB1 : B ≤ 1)
    (hy3 : 3 ≤ y) (hyx : y ≤ x)
    (hσ12 : 1 / 2 ≤ σ₁) (hσ1 : σ₁ < 1) (hσgap : B / (40 * Λ) ≤ 1 - σ₁)
    (hσβ : σ₁ + ρ ≤ β₀) (hβ1 : β₀ < 1)
    (hM : 0 < M) (hρ : 0 < ρ)
    (hN : M + 1 / ρ + 1 / (1 - σ₁) + 1 ≤ N) (hS0 : 0 ≤ S)
    (hzR : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 2 →
        |s.im| ≤ Real.exp (Real.sqrt X) → G s = 0 → s = (β₀ : ℂ))
    (hldR : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 2 →
        |s.im| ≤ Real.exp (Real.sqrt X) →
        ‖deriv G s / G s - 1 / (s - (β₀ : ℂ))‖ ≤ M)
    (hsum : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ‖((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K))‖ *
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-(1 + 1 / X))))
    (hSb : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ‖((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K))‖ *
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-(1 + 1 / X)))
        ≤ S) :
    ‖(∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ y},
        ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
          ((Real.log (y / (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) : ℝ) : ℂ))
      - (E : ℂ) * (y : ℂ) + (((y ^ β₀ / β₀ ^ 2 : ℝ)) : ℂ)‖
      ≤ (6 * S + 12 * N) * x * Real.exp (-(B * X) / (40 * Λ)) :=
by
  have hx0 : (0 : ℝ) < x := by linarith
  have hXpos : (0 : ℝ) < X := by linarith
