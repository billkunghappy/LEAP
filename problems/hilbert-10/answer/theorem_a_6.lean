  have hM14pos : 0 ≤ M ^ ((1:ℝ)/4) := Real.rpow_nonneg hMpos.le _
  obtain ⟨E, hEdef⟩ : ∃ E : ℝ, E = G * (M ^ ((1:ℝ)/4) * (((s - 1 : ℕ) : ℝ) + M ^ ((1:ℝ)/4))
      ^ (Module.finrank ℚ K - 1) + ((s - 1 : ℕ) : ℝ) ^ (Module.finrank ℚ K) * η) := ⟨_, rfl⟩
  have hE0 : 0 ≤ E := by
