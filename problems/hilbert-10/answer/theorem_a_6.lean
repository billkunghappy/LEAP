  have hreal : ∀ S Cq CqB T' c₂' ε' β' : ℝ, 0 ≤ Cq → Cq ≤ CqB → 1 ≤ T' → 0 < c₂' →
      |ε'| ≤ 1 → (ε' = 0 ∨ (1 / 2 ≤ β' ∧ β' < 1)) →
