  have s4 : ∀ 𝔪 : Ideal (NumberField.RingOfIntegers K), 𝔪 ≠ 0 →
      ∀ a γ : NumberField.RingOfIntegers K, γ ≠ 0 →
      ∃ δ ∈ 𝔪, ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
