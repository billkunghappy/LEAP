      rw [hea m]
      exact Finset.sum_congr rfl fun i _ => by rw [hβa i]
    simp only [Function.comp_apply]
    rw [hx]
  have hsum2 : ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
      Summable (fun z : {x : K //
          x ∈ (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
        ‖kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K (z : K))‖ *
          kaiHZGaussian K y (NumberField.mixedEmbedding K (z : K))) := by
    intro y hy
    have h5 := kai_hz_lattice_gauss_summable K η (fun p => -l p) y hy 0
      (Module.finrank ℚ K) (fun j => NumberField.mixedEmbedding K (ν j)) hνind
    rw [← eb.summable_iff]
    refine h5.congr fun m => ?_
    simp only [Function.comp_apply, zero_add]
    rw [heb m]
  obtain ⟨κ₀, hκ₀norm, hκ₀⟩ :=
    kai_hz_mixed_test_fourier_formula K hU (Module.finrank ℚ K) Φ hinner hmeas η l
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = |(Matrix.of fun i j => Φ (βa i) j).det| := ⟨_, rfl⟩
  have hDcov : D = (MeasureTheory.volume (ZSpan.fundamentalDomain βa)).toReal := by
    rw [hDdef]; exact hdet βa
  have hDc₀ : c₀ ≤ D := by rw [hDcov]; exact hcov
  have hD0 : (0 : ℝ) < D := lt_of_lt_of_le hc₀ hDc₀
  obtain ⟨TC, hTCdef⟩ : ∃ TC : ℂ, TC = ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      (2 : ℂ) ^ ((l p).natAbs) := ⟨_, rfl⟩
  obtain ⟨TR, hTRdef⟩ : ∃ TR : ℝ, TR = ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
