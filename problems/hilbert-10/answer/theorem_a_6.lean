  intro I hI0 hID
  by_cases hqtop : q = ⊤
  · exact htriv I hI0 (by rw [hqtop]; exact sup_top_eq I) hID
  have h𝔮D0 : 𝔮D ≠ 0 := by rw [Ne, Ideal.zero_eq_bot]; exact h𝔮D
  have h𝔪 : q * 𝔮D ≠ 0 := mul_ne_zero hq h𝔮D0
  have h𝔪q : q * 𝔮D ≤ q := Ideal.mul_le_right
  have h𝔪D : q * 𝔮D ≤ 𝔮D := Ideal.mul_le_left
  have hInz : I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    mem_nonZeroDivisors_iff_ne_zero.mpr hI0
  obtain ⟨J, hJ𝔪, hJc⟩ := s1 (q * 𝔮D) h𝔪 (ClassGroup.mk0 ⟨I, hInz⟩)⁻¹
  have hJq : (J : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ :=
    eq_top_mono (sup_le_sup_left h𝔪q _) hJ𝔪
  have hJD : (J : Ideal (NumberField.RingOfIntegers K)) ⊔ 𝔮D = ⊤ :=
    eq_top_mono (sup_le_sup_left h𝔪D _) hJ𝔪
  have hJ0 : (J : Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
    mem_nonZeroDivisors_iff_ne_zero.mp J.2
  have hlamJ : lamD J = 1 := htriv J hJ0 hJq hJD
  have hIJnz : I * (J : Ideal (NumberField.RingOfIntegers K)) ∈
      nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) := Submonoid.mul_mem _ hInz J.2
  have hcl : ClassGroup.mk0 (⟨I * (J : Ideal (NumberField.RingOfIntegers K)), hIJnz⟩ :
      ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) = 1 := by
    have hmul : (⟨I * (J : Ideal (NumberField.RingOfIntegers K)), hIJnz⟩ :
        ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) = ⟨I, hInz⟩ * J := rfl
    rw [hmul, map_mul, hJc, mul_inv_cancel]
  have hP : Submodule.IsPrincipal (I * (J : Ideal (NumberField.RingOfIntegers K))) :=
    (ClassGroup.mk0_eq_one_iff hIJnz).mp hcl
  set γ := Submodule.IsPrincipal.generator (I * (J : Ideal (NumberField.RingOfIntegers K)))
    with hγdef
  have hγ : Ideal.span {γ} = I * (J : Ideal (NumberField.RingOfIntegers K)) :=
    Ideal.span_singleton_generator _
  have hγ0 : γ ≠ 0 := by
    intro h
    rw [h, Ideal.span_singleton_eq_bot.mpr rfl] at hγ
    rcases Ideal.mul_eq_bot.mp hγ.symm with h1 | h1
    · exact hI0 (by rw [h1, Ideal.zero_eq_bot])
    · exact hJ0 (by rw [h1, Ideal.zero_eq_bot])
  have hγD : Ideal.span {γ} ⊔ 𝔮D = ⊤ := by
    rw [hγ]
    exact Ideal.isCoprime_iff_sup_eq.mp (IsCoprime.mul_left
      (Ideal.isCoprime_iff_sup_eq.mpr hID) (Ideal.isCoprime_iff_sup_eq.mpr hJD))
  have hIγ : lamD I = kaiHeckeTwist K 𝔮D 0 0 ξD ηD γ := by
    rw [← hD.2.2.2.2.2 γ hγ0, hγ, hD.2.1, hlamJ, mul_one]
  obtain ⟨γ'', hγ''D, hγ''q⟩ := s3 γ hγD
  obtain ⟨δ, hδ𝔪, hsgn⟩ := s4 (q * 𝔮D) h𝔪 γ'' γ hγ0
  have hδq : δ ∈ q := h𝔪q hδ𝔪
  have hδD : δ ∈ 𝔮D := h𝔪D hδ𝔪
  have hshift : ∀ (𝔟 : Ideal (NumberField.RingOfIntegers K)) (x y : NumberField.RingOfIntegers K),
      x - y ∈ 𝔟 → Ideal.span {y} ⊔ 𝔟 = ⊤ → Ideal.span {x} ⊔ 𝔟 = ⊤ := by
    intro 𝔟 x y hxy h
    rw [eq_top_iff, ← h]
    refine sup_le ?_ le_sup_right
    rw [Ideal.span_singleton_le_iff_mem]
    have hx : x ∈ Ideal.span {x} ⊔ 𝔟 := Ideal.mem_sup_left (Ideal.mem_span_singleton_self x)
    have hxy' : x - y ∈ Ideal.span {x} ⊔ 𝔟 := Ideal.mem_sup_right hxy
    have := Ideal.sub_mem _ hx hxy'
    rwa [sub_sub_cancel] at this
  have hγ'D : γ'' + δ - γ ∈ 𝔮D := by
    have he : γ'' + δ - γ = (γ'' - γ) + δ := by ring
    rw [he]
    exact Ideal.add_mem _ hγ''D hδD
  have hγ'q : Ideal.span {γ'' + δ} ⊔ q = ⊤ :=
    hshift q (γ'' + δ) γ'' (by rw [add_sub_cancel_left]; exact hδq) hγ''q
  have hγ'D' : Ideal.span {γ'' + δ} ⊔ 𝔮D = ⊤ := hshift 𝔮D (γ'' + δ) γ hγ'D hγD
  have hγ'0 : γ'' + δ ≠ 0 := by
    intro h
    rw [h, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq] at hγ'q
    exact hqtop hγ'q
  have hspan0 : Ideal.span {γ'' + δ} ≠ 0 := by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]
    exact hγ'0
  have hτ : kaiHeckeTwist K 𝔮D 0 0 ξD ηD (γ'' + δ) = kaiHeckeTwist K 𝔮D 0 0 ξD ηD γ :=
    s2 (γ'' + δ) γ hγ'D hsgn
  rw [hIγ, ← hτ, ← hD.2.2.2.2.2 (γ'' + δ) hγ'0]
  exact htriv _ hspan0 hγ'q hγ'D'

theorem kai_lp_exceptional_terms (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B₀ B : ℝ) (hB₀ : 0 < B₀) (hB₀h : B₀ ≤ 1 / 2) (hB : 0 < B)
    (x Q : ℝ) (hx : 3 ≤ x) (hQ : 3 ≤ Q) (hQx : Real.log Q ≤ Real.sqrt (Real.log x))
    (𝔮D : Ideal (NumberField.RingOfIntegers K))
    (ψD : NumberField.RingOfIntegers K → ℤ) (βD : ℝ)
    (lamD : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hLP : IsLPExceptional K B₀ Q 𝔮D ψD βD lamD)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (hNq : (Ideal.absNorm q : ℝ) ≤ Q)
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (Λ : Fin (NumberField.classNumber K) → (Ideal (NumberField.RingOfIntegers K) → ℂ))
    (hΛext : ∀ j, KaiHeckeExt K q t l ξ η (Λ j))
    (hΛpr : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → Submodule.IsPrincipal I →
      ∑ j, Λ j I = (NumberField.classNumber K : ℂ) * kaiHeckeTwist K q t l ξ η (kaiGen I))
    (hΛnp : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → ¬ Submodule.IsPrincipal I →
      ∑ j, Λ j I = 0)
    (m : Fin (NumberField.classNumber K) → ℕ) (β : Fin (NumberField.classNumber K) → ℝ)
    (hm : ∀ j, m j ≤ 1) (hβ : ∀ j, 1 / 2 ≤ β j ∧ β j < 1)
    (h1 : ∀ j, m j = 1 → t = 0 ∧ l = 0 ∧ ¬ KaiHeckePrincipal K q (Λ j) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), Λ j I = (starRingEnd ℂ) (Λ j I)) ∧
      1 - B / Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ β j ∧
      ∀ G : ℂ → ℂ, Differentiable ℂ G →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K (Λ j) s = G s) → G (β j : ℂ) = 0)
    (h2 : ∀ j, t = 0 → l = 0 → ¬ KaiHeckePrincipal K q (Λ j) →
      ∀ G : ℂ → ℂ, Differentiable ℂ G →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K (Λ j) s = G s) →
        ∀ β' : ℝ, 1 - B / Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ β' → β' < 1 →
          G (β' : ℂ) = 0 → m j = 1 ∧ β' = β j) :
    |∑ j, (m j : ℝ) * (x ^ β j / β j)
      - (@ite ℝ (ψD ≠ 0 ∧ t = 0 ∧ l = 0 ∧
            ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
              IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
              kaiHeckeTwist K q t l ξ η y = ((ψD y : ℤ) : ℂ))
          (Classical.propDecidable _) (1 : ℝ) 0) * (x ^ βD / βD)|
      ≤ 2 * ((NumberField.classNumber K : ℝ) + 1) * x
          * Real.exp (-(min B₀ (B / 3)) * Real.sqrt (Real.log x)) :=
by
  classical
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = min B₀ (B / 3) := ⟨_, rfl⟩
  rw [← ha_def]
  have hx0 : 0 < x := by linarith
  have hlog3 : 1 < Real.log 3 := by
    rw [Real.lt_log_iff_exp_lt (by norm_num)]
    have := Real.exp_one_lt_d9
    linarith
  have hlogQ : 1 < Real.log Q := lt_of_lt_of_le hlog3 (Real.log_le_log (by norm_num) hQ)
  have ha0 : 0 < a := by rw [ha_def]; exact lt_min hB₀ (by positivity)
  have haB₀ : a ≤ B₀ := by rw [ha_def]; exact min_le_left _ _
  have haB : a ≤ B / 3 := by rw [ha_def]; exact min_le_right _ _
  obtain ⟨ε, hε_def⟩ : ∃ ε : ℝ, ε = 2 * x * Real.exp (-a * Real.sqrt (Real.log x)) :=
    ⟨_, rfl⟩
  have hε0 : 0 ≤ ε := by rw [hε_def]; positivity
  have hRHS : 2 * ((NumberField.classNumber K : ℝ) + 1) * x
      * Real.exp (-a * Real.sqrt (Real.log x))
      = ((NumberField.classNumber K : ℝ) + 1) * ε := by rw [hε_def]; ring
  rw [hRHS]
  
  have s1 : ∀ (b c D : ℝ), 1 / 2 ≤ b → 0 < D → a * D ≤ c * Real.sqrt (Real.log x) →
      b ≤ 1 - c / D → x ^ b / b ≤ ε := by
    intro b c D hb hD haD hbc
    have hL : 0 < Real.log x := Real.log_pos (by linarith)
    have hsq0 : 0 ≤ Real.sqrt (Real.log x) := Real.sqrt_nonneg _
    have hsq : Real.sqrt (Real.log x) * Real.sqrt (Real.log x) = Real.log x :=
      Real.mul_self_sqrt hL.le
    have hb0 : 0 < b := by linarith
    have h1' : x ^ b ≤ x ^ (1 - c / D) := Real.rpow_le_rpow_of_exponent_le (by linarith) hbc
    have h2' : x ^ (1 - c / D) = Real.exp (Real.log x * (1 - c / D)) :=
      Real.rpow_def_of_pos hx0 _
    have h3 : a * Real.sqrt (Real.log x) ≤ c * Real.log x / D := by
      rw [le_div_iff₀ hD]
      have := mul_le_mul_of_nonneg_right haD hsq0
      calc a * Real.sqrt (Real.log x) * D = a * D * Real.sqrt (Real.log x) := by ring
        _ ≤ c * Real.sqrt (Real.log x) * Real.sqrt (Real.log x) := this
        _ = c * Real.log x := by rw [mul_assoc, hsq]
    have h4 : Real.log x * (1 - c / D) ≤ Real.log x + -a * Real.sqrt (Real.log x) := by
      have e : Real.log x * (1 - c / D) = Real.log x - c * Real.log x / D := by ring
      rw [e]; linarith
    have h5 : x ^ b ≤ x * Real.exp (-a * Real.sqrt (Real.log x)) := by
      calc x ^ b ≤ Real.exp (Real.log x * (1 - c / D)) := h2' ▸ h1'
        _ ≤ Real.exp (Real.log x + -a * Real.sqrt (Real.log x)) := Real.exp_le_exp.2 h4
        _ = x * Real.exp (-a * Real.sqrt (Real.log x)) := by
            rw [Real.exp_add, Real.exp_log hx0]
    have hxE : 0 ≤ x * Real.exp (-a * Real.sqrt (Real.log x)) := by positivity
    rw [div_le_iff₀ hb0, hε_def]
    nlinarith [mul_nonneg hxE (by linarith : (0 : ℝ) ≤ 2 * b - 1)]
  
  have s2 : Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ 3 * Real.sqrt (Real.log x) := by
    have hn0 : (0 : ℝ) ≤ Ideal.absNorm q := Nat.cast_nonneg _
    have hpos : 0 < 3 + 4 * (Ideal.absNorm q : ℝ) := by linarith
    have hle : 3 + 4 * (Ideal.absNorm q : ℝ) ≤ 5 * Q := by linarith
    have e1 : Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ Real.log (5 * Q) :=
      Real.log_le_log hpos hle
    have e2 : Real.log (5 * Q) = Real.log 5 + Real.log Q :=
      Real.log_mul (by norm_num) (by linarith)
    have e5 : Real.log 5 < 2 := by
      rw [Real.log_lt_iff_lt_exp (by norm_num)]
      have he := Real.exp_one_gt_d9
      have e : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
      rw [e]; nlinarith
    linarith
  
  have hT0 : ∀ j, 0 ≤ (m j : ℝ) * (x ^ β j / β j) := fun j =>
    mul_nonneg (Nat.cast_nonneg _)
      (div_nonneg (Real.rpow_nonneg hx0.le _) (by linarith [(hβ j).1]))
  have hh0 : (0 : ℝ) ≤ (NumberField.classNumber K : ℝ) := Nat.cast_nonneg _
  
  have s3i : ∀ X : ℝ, (∀ j, (m j : ℝ) * (x ^ β j / β j) ≤ ε) → 0 ≤ X → X ≤ ε →
      |∑ j, (m j : ℝ) * (x ^ β j / β j) - X|
        ≤ ((NumberField.classNumber K : ℝ) + 1) * ε := by
    intro X hT hX0 hXε
    have e0 : 0 ≤ ∑ j, (m j : ℝ) * (x ^ β j / β j) := Finset.sum_nonneg (fun j _ => hT0 j)
    have e1 : ∑ j, (m j : ℝ) * (x ^ β j / β j) ≤ (NumberField.classNumber K : ℝ) * ε := by
      have := Finset.sum_le_card_nsmul Finset.univ
        (fun j => (m j : ℝ) * (x ^ β j / β j)) ε (fun j _ => hT j)
      rw [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at this
      exact this
    have e2 := mul_nonneg hh0 hε0
    rw [abs_sub_le_iff]; constructor <;> nlinarith
  
  have s3ii : ∀ (X : ℝ) (j₀ : Fin (NumberField.classNumber K)),
      (m j₀ : ℝ) * (x ^ β j₀ / β j₀) = X →
      (∀ j, j ≠ j₀ → (m j : ℝ) * (x ^ β j / β j) ≤ ε) →
      |∑ j, (m j : ℝ) * (x ^ β j / β j) - X|
        ≤ ((NumberField.classNumber K : ℝ) + 1) * ε := by
    intro X j₀ hj₀ hT
    have esplit := Finset.add_sum_erase Finset.univ
      (fun j => (m j : ℝ) * (x ^ β j / β j)) (Finset.mem_univ j₀)
    have e0 : 0 ≤ ∑ j ∈ Finset.univ.erase j₀, (m j : ℝ) * (x ^ β j / β j) :=
      Finset.sum_nonneg (fun j _ => hT0 j)
    have e1 : ∑ j ∈ Finset.univ.erase j₀, (m j : ℝ) * (x ^ β j / β j)
        ≤ ((Finset.univ.erase j₀).card : ℝ) * ε := by
      have := Finset.sum_le_card_nsmul (Finset.univ.erase j₀)
        (fun j => (m j : ℝ) * (x ^ β j / β j)) ε
        (fun j hj => hT j (Finset.ne_of_mem_erase hj))
      rw [nsmul_eq_mul] at this
      exact this
    have hc : ((Finset.univ.erase j₀).card : ℝ) ≤ (NumberField.classNumber K : ℝ) := by
      have : (Finset.univ.erase j₀).card ≤ NumberField.classNumber K :=
        Finset.card_erase_le.trans (by simp)
      exact_mod_cast this
    have e3 := mul_le_mul_of_nonneg_right hc hε0
    have hdiff : ∑ j, (m j : ℝ) * (x ^ β j / β j) - X
        = ∑ j ∈ Finset.univ.erase j₀, (m j : ℝ) * (x ^ β j / β j) := by
      rw [← esplit]; dsimp only; rw [hj₀]; ring
    rw [hdiff, abs_of_nonneg e0]
    nlinarith
  
  have s4 : ∀ (q' : Ideal (NumberField.RingOfIntegers K)), q' ≠ 0 →
      ∀ (ξ' : ((NumberField.RingOfIntegers K ⧸ q')ˣ) →* Circle)
        (η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam' : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q' 0 0 ξ' η' lam' → ¬ KaiHeckePrincipal K q' lam' →
        ∃ G : ℂ → ℂ, Differentiable ℂ G ∧
          ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam' s = G s := by
    obtain ⟨A₀, -, hcont⟩ := kai_hecke_zeta_continuation K
    intro q' hq' ξ' η' lam' hext hnp
    obtain ⟨E, G, hE1, hEiff, hG, -, hser, -⟩ := hcont q' hq' 0 0 ξ' η' lam' hext (by simp)
    have hE0 : E = 0 := by
      have : E ≠ 1 := fun h => hnp (hEiff.mp h)
      omega
    refine ⟨G, hG, fun s hs => ?_⟩
    have := hser s hs
    rw [hE0, pow_zero, mul_one] at this
    exact this
  
  have S1 : ∀ j, ¬ (m j = 1 ∧ 1 - B₀ / Real.log Q ≤ β j) →
      (m j : ℝ) * (x ^ β j / β j) ≤ ε := by
    intro j hg
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp (hm j) with hm0 | hm1
    · rw [hm0, Nat.cast_zero, zero_mul]; exact hε0
    · rw [hm1, Nat.cast_one, one_mul]
      have hlt : β j < 1 - B₀ / Real.log Q := by
        by_contra hc
        exact hg ⟨hm1, not_lt.mp hc⟩
      apply s1 (β j) B₀ (Real.log Q) (hβ j).1 (by linarith) _ hlt.le
      calc a * Real.log Q ≤ B₀ * Real.log Q := mul_le_mul_of_nonneg_right haB₀ (by linarith)
        _ ≤ B₀ * Real.sqrt (Real.log x) := mul_le_mul_of_nonneg_left hQx hB₀.le
  
  have claimC : ∀ j, m j = 1 → 1 - B₀ / Real.log Q ≤ β j →
      (ψD ≠ 0 ∧ β j = βD ∧
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → I ⊔ 𝔮D = ⊤ →
          Λ j I = lamD I)) ∧
      (ψD ≠ 0 ∧ t = 0 ∧ l = 0 ∧
        ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
          IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
          kaiHeckeTwist K q t l ξ η y = ((ψD y : ℤ) : ℂ)) := by
    intro j hmj hbj
    obtain ⟨ht, hl, hnp, hreal, -, hzero⟩ := h1 j hmj
    have hext : KaiHeckeExt K q 0 0 ξ η (Λ j) := by
      have := hΛext j
      rw [ht, hl] at this
      exact this
    obtain ⟨G, hG, hEG⟩ := s4 q hq ξ η (Λ j) hext hnp
    have hGz := hzero G hG hEG
    have hC := hLP.2.2 q hq hNq ξ η (Λ j) hext hreal hnp G hG hEG (β j) hbj (hβ j).2 hGz
    refine ⟨hC, hC.1, ht, hl, ?_⟩
    intro y hy hcq hcD
    have hspan0 : Ideal.span {y} ≠ 0 := by
      rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hy
    rw [← (hΛext j).2.2.2.2.2 y hy,
      hC.2.2 _ hspan0 (Ideal.isCoprime_iff_sup_eq.mp hcq) (Ideal.isCoprime_iff_sup_eq.mp hcD)]
    obtain ⟨-, -, -, -, -, -, -, hψ, -⟩ := hLP.2.1.resolve_left hC.1
    exact hψ y hy hcD
  by_cases hexc : (ψD ≠ 0 ∧ t = 0 ∧ l = 0 ∧
      ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
        IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
        kaiHeckeTwist K q t l ξ η y = ((ψD y : ℤ) : ℂ))
  · rw [ite_cond_eq_true _ _ (eq_true hexc), one_mul]
    obtain ⟨hψ, ht, hl, hτ⟩ := hexc
    subst ht hl
    obtain ⟨-, -, hβDlo, hβD1, ⟨ξD, ηD, hD⟩, hDreal, hDnp, hDψ, hDzero⟩ :=
      hLP.2.1.resolve_left hψ
    have h𝔮D : 𝔮D ≠ ⊥ := hLP.1
    have h𝔮D0 : 𝔮D ≠ 0 := by rw [Ne, Ideal.zero_eq_bot]; exact h𝔮D
    have hβDhalf : 1 / 2 < βD := by
      have : B₀ / Real.log Q < 1 / 2 := by
        rw [div_lt_iff₀ (by linarith)]; nlinarith
      linarith
    have hβD0 : 0 < βD := by linarith
    have hX0 : 0 ≤ x ^ βD / βD := div_nonneg (Real.rpow_nonneg hx0.le _) hβD0.le
    by_cases hb1 : 1 - B / Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ βD
    · 
      have hmatch : ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
          IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
          kaiHeckeTwist K q 0 0 ξ η y = lamD (Ideal.span {y}) := by
        intro y hy hcq hcD
        rw [hτ y hy hcq hcD, hDψ y hy hcD]
      obtain ⟨j₀, hA₀, huniq⟩ := kai_class_char_match_unique K q hq ξ η Λ hΛext hΛpr hΛnp
        𝔮D h𝔮D ξD ηD lamD hD hDreal hmatch
      have hnp₀ : ¬ KaiHeckePrincipal K q (Λ j₀) := by
        intro hP
        apply hDnp
        apply kai_hecke_principal_of_trivial_off K 𝔮D q h𝔮D hq ξD ηD lamD hD
        intro I hI0 hIq hID
        rw [← hA₀ I hI0 hIq hID]
        exact hP I hI0 hIq
      obtain ⟨GD, hGD, heqD⟩ := s4 𝔮D h𝔮D0 ξD ηD lamD hD hDnp
      have hzD := hDzero GD hGD heqD
      obtain ⟨G₀, hG₀, heq₀⟩ := s4 q hq ξ η (Λ j₀) (hΛext j₀) hnp₀
      have hsq1 : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ 𝔮D = ⊤ →
          lamD I * lamD I = 1 := by
        intro I hI0 hID
        have hn := hD.2.2.1 I hI0 hID
        calc lamD I * lamD I = lamD I * (starRingEnd ℂ) (lamD I) := by rw [← hDreal I]
          _ = ((Complex.normSq (lamD I) : ℝ) : ℂ) := Complex.mul_conj _
          _ = 1 := by rw [Complex.normSq_eq_norm_sq, hn]; norm_num
      have hprin : KaiHeckePrincipal K (𝔮D * q) (fun I => lamD I * Λ j₀ I) := by
        intro I hI0 hI
        have hIq : I ⊔ q = ⊤ := eq_top_mono (sup_le_sup_left Ideal.mul_le_left I) hI
        have hID : I ⊔ 𝔮D = ⊤ := eq_top_mono (sup_le_sup_left Ideal.mul_le_right I) hI
        show lamD I * Λ j₀ I = 1
        rw [hA₀ I hI0 hIq hID]
        exact hsq1 I hI0 hID
      have hz₀ := kai_hecke_zero_transfer K 𝔮D q h𝔮D0 hq ξD ηD lamD ξ η (Λ j₀) hD
        (hΛext j₀) hprin GD G₀ hGD hG₀ heqD heq₀ βD hβD0 hβD1 hzD
      obtain ⟨hmj₀, hβj₀⟩ := h2 j₀ rfl rfl hnp₀ G₀ hG₀ heq₀ βD hb1 hβD1 hz₀
      apply s3ii (x ^ βD / βD) j₀
      · rw [hmj₀, Nat.cast_one, one_mul, ← hβj₀]
      · intro j hj
        by_cases hg : m j = 1 ∧ 1 - B₀ / Real.log Q ≤ β j
        · exact absurd (huniq j (claimC j hg.1 hg.2).1.2.2) hj
        · exact S1 j hg
    · 
      have hn0 : (0 : ℝ) ≤ Ideal.absNorm q := Nat.cast_nonneg _
      have hD3 : 0 < Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) := Real.log_pos (by linarith)
      have hXε : x ^ βD / βD ≤ ε := by
        apply s1 βD B _ hβDhalf.le hD3 _ (not_le.mp hb1).le
        calc a * Real.log (3 + 4 * (Ideal.absNorm q : ℝ))
            ≤ (B / 3) * (3 * Real.sqrt (Real.log x)) :=
              mul_le_mul haB s2 hD3.le (by positivity)
          _ = B * Real.sqrt (Real.log x) := by ring
      apply s3i _ _ hX0 hXε
      intro j
      by_cases hg : m j = 1 ∧ 1 - B₀ / Real.log Q ≤ β j
      · have hC := (claimC j hg.1 hg.2).1
        rw [hg.1, Nat.cast_one, one_mul, hC.2.1]
        exact hXε
      · exact S1 j hg
  · rw [ite_cond_eq_false _ _ (eq_false hexc), zero_mul]
    apply s3i 0 _ le_rfl hε0
    intro j
    by_cases hg : m j = 1 ∧ 1 - B₀ / Real.log Q ≤ β j
    · exact absurd (claimC j hg.1 hg.2).2 hexc
    · exact S1 j hg

theorem kai_lp_principal_prime_sum (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B₀ : ℝ) (hB₀ : 0 < B₀) (hB₀h : B₀ ≤ 1 / 2) :
    ∃ c : ℝ, 0 < c ∧
      ∀ x : ℝ, 3 ≤ x → ∀ Q : ℝ, 3 ≤ Q → Real.log Q ≤ Real.sqrt (Real.log x) →
      ∀ (𝔮D : Ideal (NumberField.RingOfIntegers K))
        (ψD : NumberField.RingOfIntegers K → ℤ) (βD : ℝ)
        (lamD : Ideal (NumberField.RingOfIntegers K) → ℂ),
        IsLPExceptional K B₀ Q 𝔮D ψD βD lamD →
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 → (Ideal.absNorm q : ℝ) ≤ Q →
      ∀ (t : NumberField.InfinitePlace K → ℝ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
        (∀ v : (NumberField.RingOfIntegers K)ˣ,
          kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1) →
        ‖(∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
            kaiHeckeTwist K q t l ξ η (kaiGen (P : Ideal (NumberField.RingOfIntegers K)))
              * ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ))
          - ((((@ite ℝ (∀ y : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q y) →
                    kaiHeckeTwist K q t l ξ η y = 1) (Classical.propDecidable _) (1 : ℝ) 0) * x
                - (@ite ℝ (ψD ≠ 0 ∧ t = 0 ∧ l = 0 ∧
                      ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
                        IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
                        kaiHeckeTwist K q t l ξ η y = ((ψD y : ℤ) : ℂ))
                    (Classical.propDecidable _) (1 : ℝ) 0) * (x ^ βD / βD))
              / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)‖
          ≤ c * x * Real.log x ^ 2 * Real.log (1 + kaiInfSize K t l) *
              Real.exp (-(Real.log x) /
                (c * (Real.sqrt (Real.log x) + Real.log (1 + kaiInfSize K t l)))) :=
by
  classical
  obtain ⟨B, C, hB0, hB1, hC, hzf⟩ := kai_hecke_zero_free_eff K
  obtain ⟨B', c₁, hB'0, hB'h, hc₁, hθ⟩ := kai_lp_theta_of_zero_free K B C hB0 hB1 hC hzf
  have hhN : 0 < NumberField.classNumber K := NumberField.classNumber_pos K
  have hh1 : (1 : ℝ) ≤ (NumberField.classNumber K : ℝ) := by exact_mod_cast hhN
  have hhpos : (0 : ℝ) < (NumberField.classNumber K : ℝ) := by linarith
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = min B₀ (B' / 3) := ⟨_, rfl⟩
  have ha : 0 < a := by rw [ha_def]; exact lt_min hB₀ (by linarith)
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = max (4 * c₁ + 3 * ((NumberField.classNumber K : ℝ) + 1))
      (max (2 * c₁) (1 / a)) := ⟨_, rfl⟩
  have hc1 : 4 * c₁ + 3 * ((NumberField.classNumber K : ℝ) + 1) ≤ c := by
    rw [hc_def]; exact le_max_left _ _
  have hc2 : 2 * c₁ ≤ c := by rw [hc_def]; exact (le_max_left _ _).trans (le_max_right _ _)
  have hc3 : 1 / a ≤ c := by rw [hc_def]; exact (le_max_right _ _).trans (le_max_right _ _)
  have hcpos : 0 < c := by linarith
  have hac : 1 ≤ a * c := by
    have h := mul_le_mul_of_nonneg_left hc3 ha.le
    rwa [mul_one_div_cancel ha.ne'] at h
  refine ⟨c, hcpos, ?_⟩
  intro x hx Q hQ hQx 𝔮D ψD βD lamD hLP q hq hNq t l ξ η htr hinv
  obtain ⟨Λ, hΛext, hΛpr, hΛnp, hΛone, hΛzero⟩ :=
    kai_hecke_extension K q hq t l ξ η htr hinv
  have hθj := fun j => hθ q hq t l ξ η (Λ j) (hΛext j) htr
  choose m β hm hβl hβu h1 h2 hbd using hθj
  have hD := kai_lp_exceptional_terms K B₀ B' hB₀ hB₀h hB'0 x Q hx hQ hQx 𝔮D ψD βD lamD hLP
    q hq hNq t l ξ η Λ hΛext hΛpr hΛnp m β hm (fun j => ⟨hβl j, hβu j⟩) h1 h2
  rw [← ha_def] at hD
  
  obtain ⟨θ, hθdef⟩ : ∃ θ : Fin (NumberField.classNumber K) → ℂ, θ = fun j =>
      ∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
          P.IsPrime ∧ P ≠ ⊥ ∧ (Ideal.absNorm P : ℝ) ≤ x},
        Λ j (P : Ideal (NumberField.RingOfIntegers K)) *
          ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ) :=
    ⟨_, rfl⟩
  
  have main : ∀ (SUM : ℂ) (I₁ e : ℝ),
      ((NumberField.classNumber K : ℝ) : ℂ) * SUM = ∑ j, θ j →
      (∑ j, @ite ℝ (KaiHeckePrincipal K q (Λ j)) (Classical.propDecidable _) (1 : ℝ) 0) = I₁ →
      |∑ j, (m j : ℝ) * (x ^ β j / β j) - e * (x ^ βD / βD)|
        ≤ 2 * ((NumberField.classNumber K : ℝ) + 1) * x
            * Real.exp (-a * Real.sqrt (Real.log x)) →
      ‖SUM - ((((I₁ * x - e * (x ^ βD / βD)) / (NumberField.classNumber K : ℝ) : ℝ)) : ℂ)‖
        ≤ c * x * Real.log x ^ 2 * Real.log (1 + kaiInfSize K t l) *
          Real.exp (-(Real.log x) /
            (c * (Real.sqrt (Real.log x) + Real.log (1 + kaiInfSize K t l)))) := by
    intro SUM I₁ e hid hE hDb
    obtain ⟨hR, hR_def⟩ : ∃ hR : ℝ, hR = (NumberField.classNumber K : ℝ) := ⟨_, rfl⟩
    obtain ⟨r, hr_def⟩ : ∃ r : Fin (NumberField.classNumber K) → ℝ, r = fun j =>
        @ite ℝ (KaiHeckePrincipal K q (Λ j)) (Classical.propDecidable _) (1 : ℝ) 0 * x
          - (m j : ℝ) * (x ^ β j / β j) := ⟨_, rfl⟩
    obtain ⟨L, hL_def⟩ : ∃ L : ℝ, L = Real.log x := ⟨_, rfl⟩
    obtain ⟨Φ, hΦ_def⟩ : ∃ Φ : ℝ, Φ = Real.log (1 + kaiInfSize K t l) := ⟨_, rfl⟩
    obtain ⟨u, hu_def⟩ : ∃ u : ℝ,
        u = Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)) := ⟨_, rfl⟩
    obtain ⟨ε₁, hε_def⟩ : ∃ ε₁ : ℝ,
        ε₁ = c₁ * x * L * u * Real.exp (-L / (c₁ * (Real.sqrt L + u))) := ⟨_, rfl⟩
    obtain ⟨D, hD_def⟩ : ∃ D : ℝ,
        D = ∑ j, (m j : ℝ) * (x ^ β j / β j) - e * (x ^ βD / βD) := ⟨_, rfl⟩
    obtain ⟨A, hA_def⟩ : ∃ A : ℝ, A = I₁ * x - e * (x ^ βD / βD) := ⟨_, rfl⟩
    have hbdj : ∀ j, ‖θ j - ((r j : ℝ) : ℂ)‖ ≤ ε₁ := by
      intro j
      rw [hθdef, hr_def, hε_def, hL_def, hu_def]
      exact hbd j x hx
    rw [← hR_def, ← hA_def, ← hL_def, ← hΦ_def]
    rw [← hD_def, ← hL_def, ← hR_def] at hDb
    rw [← hR_def] at hid
    have hRpos : 0 < hR := by rw [hR_def]; exact hhpos
    have hR1 : 1 ≤ hR := by rw [hR_def]; exact hh1
    
    have hsumE : ∑ j, r j = I₁ * x - ∑ j, (m j : ℝ) * (x ^ β j / β j) := by
      simp only [hr_def]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hE]
    have hreal : ∑ j, r j - A + D = 0 := by rw [hsumE, hA_def, hD_def]; ring
    have hne : (hR : ℂ) ≠ 0 := by exact_mod_cast hRpos.ne'
    have hAh : (((A / hR : ℝ)) : ℂ) * (hR : ℂ) = (A : ℂ) := by
      rw [← Complex.ofReal_mul, div_mul_cancel₀ A hRpos.ne']
    have hcplx : (∑ j, ((r j : ℝ) : ℂ)) - (A : ℂ) + (D : ℂ) = 0 := by
      have h := congrArg (fun z : ℝ => (z : ℂ)) hreal
      push_cast at h
      exact h
    have hsplit : SUM - (((A / hR : ℝ)) : ℂ)
        = ((∑ j, θ j - ∑ j, ((r j : ℝ) : ℂ)) - (D : ℂ)) / (hR : ℂ) := by
      rw [eq_div_iff hne]
      linear_combination hid - hAh + hcplx
    have hnorm : ‖SUM - (((A / hR : ℝ)) : ℂ)‖ ≤ ε₁ + |D| := by
      rw [hsplit, norm_div, Complex.norm_real, Real.norm_of_nonneg hRpos.le,
        div_le_iff₀ hRpos, ← Finset.sum_sub_distrib]
      have hs1 : ‖∑ j, (θ j - ((r j : ℝ) : ℂ))‖ ≤ hR * ε₁ := by
        refine (norm_sum_le _ _).trans ?_
        refine (Finset.sum_le_sum (fun j _ => hbdj j)).trans ?_
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, hR_def]
      have hs2 : ‖((D : ℝ) : ℂ)‖ = |D| := by rw [Complex.norm_real, Real.norm_eq_abs]
      have hs3 := norm_sub_le (∑ j, (θ j - ((r j : ℝ) : ℂ))) ((D : ℝ) : ℂ)
      have hs4 : |D| ≤ |D| * hR := le_mul_of_one_le_right (abs_nonneg D) hR1
      calc ‖∑ j, (θ j - ((r j : ℝ) : ℂ)) - ((D : ℝ) : ℂ)‖
          ≤ hR * ε₁ + |D| * hR := by rw [hs2] at hs3; linarith
        _ = (ε₁ + |D|) * hR := by ring
    refine hnorm.trans ?_
    
    have hx1 : (1 : ℝ) ≤ x := by linarith
    have hx0 : (0 : ℝ) ≤ x := by linarith
    have hL0 : 0 ≤ L := by rw [hL_def]; exact Real.log_nonneg hx1
    have hlog3 : 1 < Real.log 3 := by
      rw [Real.lt_log_iff_exp_lt (by norm_num)]
      have := Real.exp_one_lt_d9
      linarith
    have hsL1 : 1 ≤ Real.sqrt L := by
      have h3Q : Real.log 3 ≤ Real.log Q := Real.log_le_log (by norm_num) hQ
      rw [hL_def]; linarith
    have hLsq : Real.sqrt L * Real.sqrt L = L := Real.mul_self_sqrt hL0
    have hL1 : 1 ≤ L := by nlinarith
    have hinf1 : 1 ≤ kaiInfSize K t l := by
      unfold kaiInfSize
      have e1 := Finset.sum_nonneg (fun w (_ : w ∈ (Finset.univ : Finset _)) => abs_nonneg (t w))
      have e2 := Finset.sum_nonneg
        (fun p (_ : p ∈ (Finset.univ : Finset {w : NumberField.InfinitePlace K // w.IsComplex}))
          => abs_nonneg ((l p : ℤ) : ℝ))
      linarith
    have hlog2 := Real.log_two_gt_d9
    have hΦ2 : Real.log 2 ≤ Φ := by
      rw [hΦ_def]; exact Real.log_le_log (by norm_num) (by linarith)
    have hΦ0 : 0 ≤ Φ := by linarith
    have hNq0 : (0 : ℝ) ≤ (Ideal.absNorm q : ℝ) := Nat.cast_nonneg _
    have hprod0 : 0 ≤ (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l) :=
      mul_nonneg hNq0 (by linarith)
    have hu0 : 0 ≤ u := by
      rw [hu_def]; apply Real.log_nonneg; linarith
    have hu1 : u ≤ Real.log 2 + Real.sqrt L + Φ := by
      have hA1 : (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l) ≤ Q * (1 + kaiInfSize K t l) :=
        mul_le_mul_of_nonneg_right hNq (by linarith)
      have hA2 : 3 ≤ Q * (1 + kaiInfSize K t l) := by nlinarith
      have hle : 3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
          ≤ 2 * Q * (1 + kaiInfSize K t l) := by linarith
      have hpos3 : 0 < 3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l) := by linarith
      have e := Real.log_le_log hpos3 hle
      rw [Real.log_mul (show (2 : ℝ) * Q ≠ 0 by positivity)
          (show (1 : ℝ) + kaiInfSize K t l ≠ 0 by linarith),
        Real.log_mul (show (2 : ℝ) ≠ 0 by norm_num) (show Q ≠ 0 by linarith)] at e
      have hQL : Real.log Q ≤ Real.sqrt L := by rw [hL_def]; exact hQx
      rw [hu_def, hΦ_def]
      rw [hΦ_def] at hΦ2
      linarith
    have hu2 : Real.sqrt L + u ≤ 2 * (Real.sqrt L + Φ) := by linarith
    have hLΦ : Φ ≤ L * Φ := by nlinarith
    have hL2 : L ≤ 2 * (L * Φ) := by nlinarith
    have hsLL : Real.sqrt L ≤ L := by nlinarith
    have hu3 : u ≤ 4 * (L * Φ) := by linarith
    have hsLpos : 0 < Real.sqrt L := by linarith
    have hden1 : 0 < c₁ * (Real.sqrt L + u) := mul_pos hc₁ (by linarith)
    have hden2 : 0 < c * (Real.sqrt L + Φ) := mul_pos hcpos (by linarith)
    have hmono : ∀ A₁ A₂ : ℝ, 0 < A₁ → A₁ ≤ A₂ →
        Real.exp (-L / A₁) ≤ Real.exp (-L / A₂) := by
      intro A₁ A₂ hA₁ hA₁₂
      apply Real.exp_le_exp.2
      rw [neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hL0 hA₁ hA₁₂
    have hle12 : c₁ * (Real.sqrt L + u) ≤ c * (Real.sqrt L + Φ) := by
      have e1 := mul_le_mul_of_nonneg_left hu2 hc₁.le
      have e2 := mul_le_mul_of_nonneg_right hc2 (by linarith : (0 : ℝ) ≤ Real.sqrt L + Φ)
      nlinarith
    obtain ⟨X, hX_def⟩ : ∃ X : ℝ, X = x * L ^ 2 * Φ * Real.exp (-L / (c * (Real.sqrt L + Φ))) :=
      ⟨_, rfl⟩
    have hE0 := Real.exp_pos (-L / (c * (Real.sqrt L + Φ)))
    have hX0 : 0 ≤ X := by
      rw [hX_def]
      exact mul_nonneg (mul_nonneg (mul_nonneg hx0 (pow_nonneg hL0 2)) hΦ0) hE0.le
    have hε : ε₁ ≤ 4 * c₁ * X := by
      rw [hε_def, hX_def]
      have he := hmono _ _ hden1 hle12
      have hxL : 0 ≤ c₁ * x * L := mul_nonneg (mul_nonneg hc₁.le hx0) hL0
      have hLΦ0 : 0 ≤ 4 * (L * Φ) := by positivity
      calc c₁ * x * L * u * Real.exp (-L / (c₁ * (Real.sqrt L + u)))
          ≤ c₁ * x * L * (4 * (L * Φ)) * Real.exp (-L / (c * (Real.sqrt L + Φ))) :=
            mul_le_mul (mul_le_mul_of_nonneg_left hu3 hxL) he (Real.exp_pos _).le
              (mul_nonneg hxL hLΦ0)
        _ = 4 * c₁ * (x * L ^ 2 * Φ * Real.exp (-L / (c * (Real.sqrt L + Φ)))) := by ring
    have hexpD : Real.exp (-a * Real.sqrt L) ≤ Real.exp (-L / (c * (Real.sqrt L + Φ))) := by
      apply Real.exp_le_exp.2
      rw [neg_div, neg_mul, neg_le_neg_iff, div_le_iff₀ hden2]
      have e : a * Real.sqrt L * (c * (Real.sqrt L + Φ))
          = (a * c) * (Real.sqrt L * Real.sqrt L) + (a * c) * (Real.sqrt L * Φ) := by ring
      rw [e, hLsq]
      have e1 := mul_le_mul_of_nonneg_right hac hL0
      have e2 := mul_nonneg (by linarith : (0 : ℝ) ≤ a * c) (mul_nonneg hsLpos.le hΦ0)
      linarith
    have hL2Φ : (2 : ℝ) / 3 ≤ L ^ 2 * Φ := by
      have h1' : 1 ≤ L ^ 2 := one_le_pow₀ hL1
      nlinarith
    have hDb' : |D| ≤ 3 * (hR + 1) * X := by
      refine hDb.trans ?_
      have hE0' := Real.exp_pos (-a * Real.sqrt L)
      have hcoef : 2 * (hR + 1) ≤ 3 * (hR + 1) * (L ^ 2 * Φ) := by
        have := mul_le_mul_of_nonneg_left hL2Φ (by linarith : (0 : ℝ) ≤ hR + 1)
        linarith
      rw [hX_def]
      calc 2 * (hR + 1) * x * Real.exp (-a * Real.sqrt L)
          ≤ (3 * (hR + 1) * (L ^ 2 * Φ)) * x * Real.exp (-L / (c * (Real.sqrt L + Φ))) := by
            apply mul_le_mul (mul_le_mul_of_nonneg_right hcoef hx0) hexpD hE0'.le
            exact mul_nonneg (mul_nonneg (by linarith) (mul_nonneg (pow_nonneg hL0 2) hΦ0)) hx0
        _ = 3 * (hR + 1) * (x * L ^ 2 * Φ * Real.exp (-L / (c * (Real.sqrt L + Φ)))) := by ring
    have hc1' : 4 * c₁ + 3 * (hR + 1) ≤ c := by rw [hR_def]; exact hc1
    calc ε₁ + |D| ≤ 4 * c₁ * X + 3 * (hR + 1) * X := add_le_add hε hDb'
      _ = (4 * c₁ + 3 * (hR + 1)) * X := by ring
      _ ≤ c * X := mul_le_mul_of_nonneg_right hc1' hX0
      _ = c * x * L ^ 2 * Φ * Real.exp (-L / (c * (Real.sqrt L + Φ))) := by rw [hX_def]; ring
  refine main _ _ _ ?_ ?_ hD
  · 
    have hfin := Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) ⌊x⌋₊
    have hconv : ∀ (p : Ideal (NumberField.RingOfIntegers K) → Prop)
        (f : Ideal (NumberField.RingOfIntegers K) → ℂ),
        (∀ P, p P → (Ideal.absNorm P : ℝ) ≤ x) →
        (∑' P : {P // p P}, f P)
          = ∑ P ∈ hfin.toFinset, @ite ℂ (p P) (Classical.propDecidable _) (f P) 0 := by
      intro p f hp
      have e1 : (∑' P : {P // p P}, f P) = ∑' P, Set.indicator {P | p P} f P :=
        tsum_subtype {P | p P} f
      rw [e1, tsum_eq_sum (s := hfin.toFinset)]
      · refine Finset.sum_congr rfl (fun P _ => ?_)
        by_cases hpP : p P
        · rw [Set.indicator_of_mem (show P ∈ {P | p P} from hpP),
            ite_cond_eq_true _ _ (eq_true hpP)]
        · rw [Set.indicator_of_notMem (show P ∉ {P | p P} from hpP),
            ite_cond_eq_false _ _ (eq_false hpP)]
      · intro P hP
        have hpP : ¬ p P := by
          intro hpP
          apply hP
          rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq]
          exact Nat.le_floor (hp P hpP)
        exact Set.indicator_of_notMem (show P ∉ {P | p P} from hpP) f
    have hθeq : ∀ j, θ j = ∑ P ∈ hfin.toFinset,
        @ite ℂ (P.IsPrime ∧ P ≠ ⊥ ∧ (Ideal.absNorm P : ℝ) ≤ x) (Classical.propDecidable _)
          (Λ j P * ((Real.log (Ideal.absNorm P) : ℝ) : ℂ)) 0 := by
      intro j
      rw [hθdef]
      exact hconv (fun P => P.IsPrime ∧ P ≠ ⊥ ∧ (Ideal.absNorm P : ℝ) ≤ x)
        (fun P => Λ j P * ((Real.log (Ideal.absNorm P) : ℝ) : ℂ)) (fun P hP => hP.2.2)
    rw [hconv (fun P => P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x)
      (fun P => kaiHeckeTwist K q t l ξ η (kaiGen P) * ((Real.log (Ideal.absNorm P) : ℝ) : ℂ))
      (fun P hP => hP.2.2.2)]
    simp only [hθeq]
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun P _ => ?_)
    have hifT : ∀ (cnd : Prop) (_ : cnd) (z : ℂ),
        @ite ℂ cnd (Classical.propDecidable cnd) z 0 = z :=
      fun cnd hc z => ite_cond_eq_true _ _ (eq_true hc)
    have hifF : ∀ (cnd : Prop) (_ : ¬ cnd) (z : ℂ),
        @ite ℂ cnd (Classical.propDecidable cnd) z 0 = 0 :=
      fun cnd hc z => ite_cond_eq_false _ _ (eq_false hc)
    by_cases hp : P.IsPrime ∧ P ≠ ⊥ ∧ (Ideal.absNorm P : ℝ) ≤ x
    · have hP0 : P ≠ 0 := by rw [Ideal.zero_eq_bot]; exact hp.2.1
      simp only [hifT _ hp]
      rw [← Finset.sum_mul]
      by_cases hpr : Submodule.IsPrincipal P
      · rw [hifT _ ⟨hp.1, hp.2.1, hpr, hp.2.2⟩, hΛpr P hP0 hpr]
        push_cast
        ring
      · rw [hifF _ (fun h => hpr h.2.2.1), hΛnp P hP0 hpr]
        simp
    · rw [hifF _ (fun h => hp ⟨h.1, h.2.1, h.2.2.2⟩)]
      simp only [hifF _ hp, Finset.sum_const_zero, mul_zero]
  · 
    by_cases hI : ∀ y : NumberField.RingOfIntegers K,
        IsUnit (Ideal.Quotient.mk q y) → kaiHeckeTwist K q t l ξ η y = 1
    · rw [ite_cond_eq_true _ _ (eq_true hI)]
      obtain ⟨j₀, hj₀, huniq⟩ := hΛone hI
      rw [Finset.sum_eq_single j₀]
      · rw [ite_cond_eq_true _ _ (eq_true hj₀)]
      · intro j _ hj
        rw [ite_cond_eq_false _ _ (eq_false (fun hpj => hj (huniq j hpj)))]
      · intro hj; exact absurd (Finset.mem_univ j₀) hj
    · rw [ite_cond_eq_false _ _ (eq_false hI)]
      apply Finset.sum_eq_zero
      intro j _
      rw [ite_cond_eq_false _ _ (eq_false (hΛzero hI j))]

theorem kai_tb_cong_unit_subgroup (K : Type u) [Field K] [NumberField K] :
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∃ G : Subgroup (NumberField.RingOfIntegers K)ˣ,
        (∀ u : (NumberField.RingOfIntegers K)ˣ, u ∈ G ↔ KaiTBCongUnit K q u) ∧
        G.index ≠ 0 ∧
        (G.index : ℝ)
          ≤ 2 ^ NumberField.InfinitePlace.nrRealPlaces K * (Ideal.absNorm q : ℝ) :=
by
  classical
  have hsign : ∀ x y : ℝ, x ≠ 0 → y ≠ 0 →
      (if 0 < x * y then (1 : ℤˣ) else -1)
        = (if 0 < x then (1 : ℤˣ) else -1) * (if 0 < y then (1 : ℤˣ) else -1) := by
    intro x y hx hy
    rcases lt_or_gt_of_ne hx with hx | hx <;> rcases lt_or_gt_of_ne hy with hy | hy
    · rw [if_pos (mul_pos_of_neg_of_neg hx hy), if_neg (asymm hx), if_neg (asymm hy)]
      decide
    · rw [if_neg (asymm (mul_neg_of_neg_of_pos hx hy)), if_neg (asymm hx), if_pos hy]
      decide
    · rw [if_neg (asymm (mul_neg_of_pos_of_neg hx hy)), if_pos hx, if_neg (asymm hy)]
      decide
    · rw [if_pos (mul_pos hx hy), if_pos hx, if_pos hy]
      decide
  have hsigniff : ∀ x : ℝ, ((if 0 < x then (1 : ℤˣ) else -1) = 1) ↔ 0 < x := by
    intro x
    by_cases h : 0 < x
    · rw [if_pos h]; exact ⟨fun _ => h, fun _ => rfl⟩
    · rw [if_neg h]
      exact ⟨fun hc => absurd hc (by decide), fun hc => absurd hc h⟩
  have hmul : ∀ (u v : (NumberField.RingOfIntegers K)ˣ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K
          (((u * v : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) : K)).1 w
        = (NumberField.mixedEmbedding K ((u : NumberField.RingOfIntegers K) : K)).1 w
          * (NumberField.mixedEmbedding K ((v : NumberField.RingOfIntegers K) : K)).1 w := by
    intro u v w
    push_cast
    simp
  have hone : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (NumberField.mixedEmbedding K
          (((1 : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) : K)).1 w = 1 := by
    intro w
    push_cast
    simp
  have hne : ∀ (u : (NumberField.RingOfIntegers K)ˣ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K ((u : NumberField.RingOfIntegers K) : K)).1 w ≠ 0 := by
    intro u w
    have h := hmul u u⁻¹ w
    rw [mul_inv_cancel, hone w] at h
    exact left_ne_zero_of_mul_eq_one h.symm
  obtain ⟨σ, hσ⟩ : ∃ σ : (NumberField.RingOfIntegers K)ˣ →*
      ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ),
      ∀ u : (NumberField.RingOfIntegers K)ˣ, σ u = 1 ↔
        ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          0 < (NumberField.mixedEmbedding K ((u : NumberField.RingOfIntegers K) : K)).1 w := by
    refine ⟨MonoidHom.mk'
      (fun u : (NumberField.RingOfIntegers K)ˣ =>
        fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
          if 0 < (NumberField.mixedEmbedding K
              ((u : NumberField.RingOfIntegers K) : K)).1 w then (1 : ℤˣ) else -1)
      (fun u v => by
        funext w
        simp only [Pi.mul_apply, hmul u v w]
        exact hsign _ _ (hne u w) (hne v w)), ?_⟩
    intro u
    constructor
    · intro h w
      exact (hsigniff _).mp (congrFun h w)
    · intro h
      funext w
      exact (hsigniff _).mpr (h w)
  intro q hq
  have hψ : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      (Units.map (Ideal.Quotient.mk q).toMonoidHom) u = 1
        ↔ (u : NumberField.RingOfIntegers K) - 1 ∈ q := by
    intro u
    rw [← Units.val_inj]
    simp only [Units.coe_map, Units.val_one, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe]
    rw [show ((1 : NumberField.RingOfIntegers K ⧸ q)) = Ideal.Quotient.mk q 1 from
      (map_one _).symm, Ideal.Quotient.eq]
  obtain ⟨φ, hφ⟩ : ∃ φ : (NumberField.RingOfIntegers K)ˣ →*
      ((NumberField.RingOfIntegers K ⧸ q)ˣ ×
        ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ)),
      φ = (Units.map (Ideal.Quotient.mk q).toMonoidHom).prod σ := ⟨_, rfl⟩
  have hNq : Ideal.absNorm q ≠ 0 := by simpa [Ideal.absNorm_eq_zero_iff] using hq
  haveI hfinq : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    (Ideal.absNorm_ne_zero_iff q).mp hNq
  haveI hfinu : Finite ((NumberField.RingOfIntegers K ⧸ q)ˣ) :=
    Finite.of_injective _ (Units.val_injective (α := NumberField.RingOfIntegers K ⧸ q))
  haveI hfinT : Finite ((NumberField.RingOfIntegers K ⧸ q)ˣ ×
      ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ)) := inferInstance
  refine ⟨φ.ker, ?_, ?_, ?_⟩
  · intro u
    rw [MonoidHom.mem_ker, hφ, MonoidHom.prod_apply, Prod.mk_eq_one, hψ u, hσ u]
    exact Iff.rfl
  · rw [Subgroup.index_ker]
    haveI : Nonempty ↥φ.range := ⟨⟨1, φ.range.one_mem⟩⟩
    exact Nat.card_pos.ne'
  · have hcard2 : Nat.card ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ)
        = 2 ^ NumberField.InfinitePlace.nrRealPlaces K := by
      rw [Nat.card_fun]
      congr 1
      · rw [Nat.card_eq_fintype_card]; decide
      · simp [NumberField.InfinitePlace.nrRealPlaces, Nat.card_eq_fintype_card]
    have hcardu : Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) ≤ Ideal.absNorm q := by
      have h1 : Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ)
          ≤ Nat.card (NumberField.RingOfIntegers K ⧸ q) :=
        Nat.card_le_card_of_injective _
          (Units.val_injective (α := NumberField.RingOfIntegers K ⧸ q))
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
      exact h1
    have hchain : φ.ker.index
        ≤ 2 ^ NumberField.InfinitePlace.nrRealPlaces K * Ideal.absNorm q := by
      rw [Subgroup.index_ker]
      calc Nat.card ↥φ.range
          ≤ Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ ×
              ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ)) :=
            Subgroup.card_le_card_group φ.range
        _ = Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) *
              Nat.card ({w : NumberField.InfinitePlace K // w.IsReal} → ℤˣ) :=
            Nat.card_prod _ _
        _ = Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) *
              2 ^ NumberField.InfinitePlace.nrRealPlaces K := by rw [hcard2]
        _ ≤ Ideal.absNorm q * 2 ^ NumberField.InfinitePlace.nrRealPlaces K :=
            Nat.mul_le_mul_right _ hcardu
        _ = 2 ^ NumberField.InfinitePlace.nrRealPlaces K * Ideal.absNorm q := by
            rw [Nat.mul_comm]
    have hcast : ((φ.ker.index : ℕ) : ℝ)
        ≤ ((2 ^ NumberField.InfinitePlace.nrRealPlaces K * Ideal.absNorm q : ℕ) : ℝ) :=
      Nat.cast_le.mpr hchain
    push_cast at hcast
    exact hcast

theorem kai_tb_int_subgroup_bounded_basis : ∀ (r D : ℕ) (M : AddSubgroup (Fin r → ℤ)), 0 < D → M.index ≠ 0 → M.index ≤ D →
      ∃ A : Matrix (Fin r) (Fin r) ℤ,
        (∀ j i, (A j i).natAbs ≤ D) ∧
        (∀ j, (fun i => A j i) ∈ M) ∧
        A.det ≠ 0 ∧
        (∀ x ∈ M, ∃! c : Fin r → ℤ, ∀ i, x i = ∑ j, c j * A j i) :=
by
  classical
  have box : ∀ (r : ℕ) (A : Matrix (Fin r) (Fin r) ℤ),
      (∀ j i : Fin r, (i : ℕ) < (j : ℕ) → A j i = 0) →
      (∀ j : Fin r, 1 ≤ A j j) →
      ∀ y : Fin r → ℤ, ∃ c : Fin r → ℤ, ∀ i : Fin r,
        0 ≤ y i - ∑ j, c j * A j i ∧ y i - ∑ j, c j * A j i < A i i := by
    intro r
    induction r with
    | zero =>
      intro A _ _ y
      exact ⟨fun _ => 0, fun i => i.elim0⟩
    | succ m ih =>
      intro A hlow hdiag y
      have hd₀ : 0 < A 0 0 := lt_of_lt_of_le zero_lt_one (hdiag 0)
      obtain ⟨c', hc'⟩ := ih (Matrix.of fun j i : Fin m => A j.succ i.succ)
        (by
          intro j i hij
          show A j.succ i.succ = 0
          refine hlow j.succ i.succ ?_
          simp only [Fin.val_succ]
          omega)
        (by intro j; exact hdiag j.succ)
        (fun i => y i.succ - (y 0 / A 0 0) * A 0 i.succ)
      simp only [Matrix.of_apply] at hc'
      have hkey : ∀ i : Fin (m + 1),
          ∑ j : Fin (m + 1), (Fin.cons (y 0 / A 0 0) c' : Fin (m + 1) → ℤ) j * A j i
            = (y 0 / A 0 0) * A 0 i + ∑ j : Fin m, c' j * A j.succ i := by
        intro i
        rw [Fin.sum_univ_succ]
        simp
      refine ⟨Fin.cons (y 0 / A 0 0) c', fun i => ?_⟩
      rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i', rfl⟩
      · rw [hkey]
        have hz : ∀ j : Fin m, c' j * A j.succ 0 = 0 := by
          intro j
          rw [hlow j.succ 0 (by simp)]
          ring
        rw [Finset.sum_congr rfl (fun j (_ : j ∈ Finset.univ) => hz j),
          Finset.sum_const_zero, add_zero]
        have he : y 0 - y 0 / A 0 0 * A 0 0 = y 0 % A 0 0 := by
          rw [Int.emod_def]; ring
        constructor
        · have h1 : 0 ≤ y 0 % A 0 0 := Int.emod_nonneg _ (ne_of_gt hd₀)
          linarith [he]
        · have h2 : y 0 % A 0 0 < A 0 0 := Int.emod_lt_of_pos _ hd₀
          linarith [he]
      · rw [hkey]
        have h2 := hc' i'
        constructor
        · linarith [h2.1]
        · linarith [h2.2]
  have uniq : ∀ (r : ℕ) (A : Matrix (Fin r) (Fin r) ℤ),
      (∀ j i : Fin r, (i : ℕ) < (j : ℕ) → A j i = 0) →
      (∀ j : Fin r, A j j ≠ 0) →
      ∀ c c' : Fin r → ℤ, (∀ i : Fin r, ∑ j, c j * A j i = ∑ j, c' j * A j i) →
        c = c' := by
    intro r A hlow hdiag c c' h
    have key : ∀ N : ℕ, ∀ i : Fin r, (i : ℕ) < N → c i - c' i = 0 := by
      intro N
      induction N with
      | zero => intro i hi; omega
      | succ N ihN =>
        intro i hi
        rcases Nat.lt_or_ge (i : ℕ) N with h1 | h1
        · exact ihN i h1
        · have hiN : (i : ℕ) = N := by omega
          have hsum : ∑ j, (c j - c' j) * A j i = 0 := by
            have h2 : ∑ j, (c j - c' j) * A j i
                = (∑ j, c j * A j i) - ∑ j, c' j * A j i := by
              rw [← Finset.sum_sub_distrib]
              exact Finset.sum_congr rfl (fun j _ => by ring)
            rw [h2, h i, sub_self]
          have hsingle : ∑ j, (c j - c' j) * A j i = (c i - c' i) * A i i := by
            refine Finset.sum_eq_single i ?_ ?_
            · intro b _ hb
              rcases lt_trichotomy (b : ℕ) (i : ℕ) with hlt | heq | hgt
              · rw [ihN b (by omega)]; ring
              · exact absurd (Fin.ext heq) hb
              · rw [hlow b i hgt]; ring
            · intro hcon
              exact absurd (Finset.mem_univ i) hcon
          rw [hsingle] at hsum
          rcases mul_eq_zero.mp hsum with h2 | h2
          · exact h2
          · exact absurd h2 (hdiag i)
    funext i
    have := key r i i.isLt
    linarith
  have headgen : ∀ (m n : ℕ) (M : AddSubgroup (Fin (m + 1) → ℤ)), 0 < n →
      (∀ x : Fin (m + 1) → ℤ, n • x ∈ M) →
      ∃ (d : ℤ) (v : Fin (m + 1) → ℤ),
        1 ≤ d ∧ d ∣ (n : ℤ) ∧ v ∈ M ∧ v 0 = d ∧ ∀ x ∈ M, d ∣ x 0 := by
    intro m n M hn hM
    obtain ⟨S, hmemS⟩ : ∃ S : AddSubgroup ℤ, ∀ z : ℤ, z ∈ S ↔ ∃ x ∈ M, x 0 = z :=
      ⟨AddSubgroup.map (Pi.evalAddMonoidHom (fun _ : Fin (m + 1) => ℤ) 0) M,
        fun z => by simp [AddSubgroup.mem_map]⟩
    obtain ⟨a, ha⟩ := Int.subgroup_cyclic S
    have hdvd_of_mem : ∀ z ∈ S, a ∣ z := by
      intro z hz
      rw [ha, AddSubgroup.mem_closure_singleton] at hz
      obtain ⟨k, hk⟩ := hz
      exact ⟨k, by rw [← hk, zsmul_eq_mul, Int.cast_id]; ring⟩
    have hnS : (n : ℤ) ∈ S := by
      rw [hmemS]
      refine ⟨n • (Pi.single (0 : Fin (m + 1)) (1 : ℤ)), hM _, ?_⟩
      simp
    have hane : a ≠ 0 := by
      intro h0
      obtain ⟨k, hk⟩ := hdvd_of_mem _ hnS
      rw [h0, zero_mul] at hk
      omega
    have haS : a ∈ S := by
      rw [ha]
      exact AddSubgroup.subset_closure (Set.mem_singleton a)
    have habsS : |a| ∈ S := by
      rcases abs_choice a with h | h
      · rw [h]; exact haS
      · rw [h]; exact neg_mem haS
    obtain ⟨v, hvM, hv0⟩ := (hmemS _).mp habsS
    refine ⟨|a|, v, Int.one_le_abs hane, (abs_dvd a (n : ℤ)).mpr (hdvd_of_mem _ hnS),
      hvM, hv0, ?_⟩
    intro x hx
    exact (abs_dvd a (x 0)).mpr (hdvd_of_mem _ ((hmemS _).mpr ⟨x, hx, rfl⟩))
  have echelon : ∀ (r : ℕ) (n : ℕ) (M : AddSubgroup (Fin r → ℤ)), 0 < n →
      (∀ x : Fin r → ℤ, n • x ∈ M) →
      ∃ A : Matrix (Fin r) (Fin r) ℤ,
        (∀ j i : Fin r, (i : ℕ) < (j : ℕ) → A j i = 0) ∧
        (∀ j : Fin r, 1 ≤ A j j ∧ A j j ∣ (n : ℤ)) ∧
        (∀ j i : Fin r, (j : ℕ) < (i : ℕ) → 0 ≤ A j i ∧ A j i < A i i) ∧
        (∀ j : Fin r, (fun i => A j i) ∈ M) ∧
        (∀ x ∈ M, ∃ c : Fin r → ℤ, ∀ i, x i = ∑ j, c j * A j i) := by
    intro r
    induction r with
    | zero =>
      intro n M hn hM
      refine ⟨Matrix.of (fun _ _ => 0), fun j => j.elim0, fun j => j.elim0,
        fun j => j.elim0, fun j => j.elim0, ?_⟩
      intro x _
      exact ⟨fun _ => 0, fun i => i.elim0⟩
    | succ m ih =>
      intro n M hn hM
      obtain ⟨d, v, hd1, hdn, hvM, hv0, hhead⟩ := headgen m n M hn hM
      have hconsadd : ∀ y z : Fin m → ℤ,
          (Fin.cons (0 : ℤ) (y + z) : Fin (m + 1) → ℤ)
            = (Fin.cons (0 : ℤ) y : Fin (m + 1) → ℤ)
              + (Fin.cons (0 : ℤ) z : Fin (m + 1) → ℤ) := by
        intro y z
        funext i
        refine Fin.cases ?_ ?_ i <;> simp
      obtain ⟨M', hmemM'⟩ : ∃ M' : AddSubgroup (Fin m → ℤ),
          ∀ y : Fin m → ℤ, y ∈ M' ↔ (Fin.cons (0 : ℤ) y : Fin (m + 1) → ℤ) ∈ M :=
        ⟨AddSubgroup.comap
            (AddMonoidHom.mk'
              (fun y : Fin m → ℤ => (Fin.cons (0 : ℤ) y : Fin (m + 1) → ℤ)) hconsadd) M,
          fun y => Iff.rfl⟩
      have hM'n : ∀ y : Fin m → ℤ, n • y ∈ M' := by
        intro y
        rw [hmemM']
        have hc : (Fin.cons (0 : ℤ) (n • y) : Fin (m + 1) → ℤ)
            = n • (Fin.cons (0 : ℤ) y : Fin (m + 1) → ℤ) := by
          funext i
          refine Fin.cases ?_ ?_ i <;> simp
        rw [hc]
        exact hM _
      obtain ⟨B, hB1, hB2, hB3, hB4, hB5⟩ := ih n M' hn hM'n
      obtain ⟨cs, hcs⟩ := box m B hB1 (fun j => (hB2 j).1) (fun i => v i.succ)
      obtain ⟨row₀, hrowM, hrow0, hrowlt⟩ :
          ∃ row₀ : Fin (m + 1) → ℤ, row₀ ∈ M ∧ row₀ 0 = d ∧
            ∀ i : Fin m, 0 ≤ row₀ i.succ ∧ row₀ i.succ < B i i := by
        refine ⟨v - Fin.cons (0 : ℤ) (fun i => ∑ j, cs j * B j i), ?_, ?_, ?_⟩
        · refine AddSubgroup.sub_mem _ hvM ?_
          rw [← hmemM']
          have heq : (fun i => ∑ j : Fin m, cs j * B j i)
              = ∑ j : Fin m, cs j • (fun i => B j i) := by
            funext i
            simp
          rw [heq]
          exact AddSubgroup.sum_mem _ (fun j _ => AddSubgroup.zsmul_mem _ (hB4 j) _)
        · simp [hv0]
        · intro i
          simpa using hcs i
      obtain ⟨A, hA0, hAs0, hAss⟩ :
          ∃ A : Matrix (Fin (m + 1)) (Fin (m + 1)) ℤ,
            (∀ i, A 0 i = row₀ i) ∧ (∀ j : Fin m, A j.succ 0 = 0) ∧
            (∀ j i : Fin m, A j.succ i.succ = B j i) :=
        ⟨Matrix.of (Fin.cons row₀ (fun j : Fin m => Fin.cons (0 : ℤ) (B j))),
          by intro i; simp, by intro j; simp, by intro j i; simp⟩
      have hsum : ∀ (c₀ : ℤ) (c' : Fin m → ℤ) (i : Fin (m + 1)),
          ∑ j : Fin (m + 1), (Fin.cons c₀ c' : Fin (m + 1) → ℤ) j * A j i
            = c₀ * A 0 i + ∑ j : Fin m, c' j * A j.succ i := by
        intro c₀ c' i
        rw [Fin.sum_univ_succ]
        simp
      refine ⟨A, ?_, ?_, ?_, ?_, ?_⟩
      · intro j i hij
        rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
        · exact absurd hij (by simp)
        · rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i', rfl⟩
          · exact hAs0 j'
          · rw [hAss]
            refine hB1 j' i' ?_
            simp only [Fin.val_succ] at hij
            omega
      · intro j
        rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
        · rw [hA0, hrow0]
          exact ⟨hd1, hdn⟩
        · rw [hAss]
          exact hB2 j'
      · intro j i hji
        rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i', rfl⟩
        · exact absurd hji (by simp)
        · rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
          · rw [hA0, hAss]
            exact hrowlt i'
          · rw [hAss, hAss]
            refine hB3 j' i' ?_
            simp only [Fin.val_succ] at hji
            omega
      · intro j
        rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
        · have he : (fun i => A 0 i) = row₀ := funext hA0
          rw [he]
          exact hrowM
        · have he : (fun i => A j'.succ i) = Fin.cons (0 : ℤ) (fun i => B j' i) := by
            funext i
            rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i', rfl⟩
            · simpa using hAs0 j'
            · simpa using hAss j' i'
          rw [he]
          exact (hmemM' _).mp (hB4 j')
      · intro x hx
        obtain ⟨c₀, hc₀⟩ := hhead x hx
        have hxm : x - c₀ • row₀ ∈ M :=
          AddSubgroup.sub_mem _ hx (AddSubgroup.zsmul_mem _ hrowM _)
        have hx0 : (x - c₀ • row₀) 0 = 0 := by
          simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, hrow0, hc₀]
          ring
        have htail : Fin.tail (x - c₀ • row₀) ∈ M' := by
          rw [hmemM']
          have hcc : Fin.cons (0 : ℤ) (Fin.tail (x - c₀ • row₀)) = x - c₀ • row₀ := by
            rw [← hx0]
            exact Fin.cons_self_tail _
          rw [hcc]
          exact hxm
        obtain ⟨c', hc'⟩ := hB5 _ htail
        refine ⟨Fin.cons c₀ c', fun i => ?_⟩
        rw [hsum]
        rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i', rfl⟩
        · have hz : ∀ j : Fin m, c' j * A j.succ 0 = 0 := by
            intro j
            rw [hAs0]
            ring
          rw [Finset.sum_congr rfl (fun j (_ : j ∈ Finset.univ) => hz j),
            Finset.sum_const_zero, add_zero, hA0, hrow0, hc₀]
          ring
        · have hz : ∑ j : Fin m, c' j * A j.succ i'.succ
              = ∑ j : Fin m, c' j * B j i' :=
            Finset.sum_congr rfl (fun j _ => by rw [hAss])
          rw [hz, hA0]
          have h2 := hc' i'
          simp only [Fin.tail, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at h2
          linarith [h2]
  intro r D M hD hidx hle
  have hn : 0 < M.index := Nat.pos_of_ne_zero hidx
  have hM : ∀ x : Fin r → ℤ, M.index • x ∈ M := fun x => AddSubgroup.nsmul_index_mem M x
  obtain ⟨A, h1, h2, h3, h4, h5⟩ := echelon r M.index M hn hM
  have hnZ : (0 : ℤ) < (M.index : ℤ) := by exact_mod_cast hn
  have hdiagle : ∀ k : Fin r, (A k k).natAbs ≤ D := by
    intro k
    have hle1 : A k k ≤ (M.index : ℤ) := Int.le_of_dvd hnZ (h2 k).2
    have h0 : (0 : ℤ) ≤ A k k := le_trans zero_le_one (h2 k).1
    have hcast : ((A k k).natAbs : ℤ) ≤ (M.index : ℤ) := by
      rw [Int.natAbs_of_nonneg h0]
      exact hle1
    have : (A k k).natAbs ≤ M.index := by exact_mod_cast hcast
    omega
  refine ⟨A, ?_, h4, ?_, ?_⟩
  · intro j i
    rcases lt_trichotomy (i : ℕ) (j : ℕ) with hlt | heq | hgt
    · rw [h1 j i hlt]
      simp
    · have hij : i = j := Fin.ext heq
      subst hij
      exact hdiagle i
    · obtain ⟨hge, hlt2⟩ := h3 j i hgt
      have hnn := Int.natAbs_lt_natAbs_of_nonneg_of_lt hge hlt2
      have := hdiagle i
      omega
  · have hbt : A.BlockTriangular id := by
      intro i j hji
      exact h1 i j hji
    rw [Matrix.det_of_upperTriangular hbt, Finset.prod_ne_zero_iff]
    intro i _
    have := (h2 i).1
    omega
  · intro x hx
    obtain ⟨c, hc⟩ := h5 x hx
    refine ⟨c, hc, ?_⟩
    intro c' hc'
    refine uniq r A h1 (fun j => by have := (h2 j).1; omega) c' c ?_
    intro i
    rw [← hc' i, ← hc i]

theorem kai_tb_real_dual_basis_bound (r : ℕ) (ι : Type*) [Fintype ι] [DecidableEq ι]
    (hcard : Fintype.card ι = r + 1)
    (v : Fin r → ι → ℝ) (m : ι → ℝ) (P ρ nn : ℝ)
    (hP : 0 ≤ P) (hvP : ∀ j i, |v j i| ≤ P) (hmP : ∀ i, |m i| ≤ P)
    (hv0 : ∀ j, ∑ i, v j i = 0) (hm : ∑ i, m i = nn)
    (hnn : 0 < nn) (hρ : 0 < ρ)
    (i₀ : ι) (ee : {i : ι // i ≠ i₀} ≃ Fin r)
    (hdet : ρ ≤ |(Matrix.of fun a b : {i : ι // i ≠ i₀} => v (ee a) (b : ι)).det|) :
    ∃ e : Fin r → ι → ℝ,
      (∀ i j, ∑ k, v i k * e j k = if i = j then 1 else 0) ∧
      (∀ j, ∑ k, m k * e j k = 0) ∧
      (∀ j k, |e j k| ≤ (Nat.factorial r : ℝ) * P ^ r / (nn * ρ)) :=
by
  obtain ⟨φ, hφ0, hφs⟩ :
      ∃ φ : Fin (r + 1) ≃ ι, φ 0 = i₀ ∧
        ∀ j : Fin r, φ j.succ = ((ee.symm j : {i : ι // i ≠ i₀}) : ι) := by
    refine ⟨(finSuccEquiv r).trans
      ((Equiv.optionCongr ee.symm).trans (Equiv.optionSubtypeNe i₀)), ?_, ?_⟩
    · simp only [Equiv.trans_apply, finSuccEquiv_zero, Equiv.optionCongr_apply,
        Option.map_none, Equiv.optionSubtypeNe_none]
    · intro j
      simp only [Equiv.trans_apply, finSuccEquiv_succ, Equiv.optionCongr_apply,
        Option.map_some, Equiv.optionSubtypeNe_some]
  obtain ⟨M, hM0, hMs⟩ : ∃ M : Matrix (Fin (r + 1)) (Fin (r + 1)) ℝ,
      (∀ c, M 0 c = m (φ c)) ∧ (∀ (j : Fin r) (c), M j.succ c = v j (φ c)) := by
    refine ⟨Matrix.of (fun a c => (Fin.cons m v : Fin (r + 1) → ι → ℝ) a (φ c)), ?_, ?_⟩
    · intro c; simp
    · intro j c; simp
  have hMP : ∀ (a : Fin (r + 1)) (c : Fin (r + 1)), |M a c| ≤ P := by
    intro a
    induction a using Fin.cases with
    | zero => intro c; rw [hM0]; exact hmP _
    | succ j => intro c; rw [hMs]; exact hvP _ _
  have hrow0 : ∑ c, M 0 c = nn := by
    calc ∑ c, M 0 c = ∑ c : Fin (r + 1), m (φ c) :=
          Finset.sum_congr rfl (fun c _ => hM0 c)
      _ = ∑ i, m i := Equiv.sum_comp φ m
      _ = nn := hm
  have hrows : ∀ j : Fin r, ∑ c, M j.succ c = 0 := by
    intro j
    calc ∑ c, M j.succ c = ∑ c : Fin (r + 1), v j (φ c) :=
          Finset.sum_congr rfl (fun c _ => hMs j c)
      _ = ∑ i, v j i := Equiv.sum_comp φ (v j)
      _ = 0 := hv0 j
  have hdetfac : M.det = nn * (M.submatrix Fin.succ Fin.succ).det := by
    have hdetM' : (M.updateCol 0 (fun a => ∑ c, M a c)).det = M.det := by
      have h := Matrix.det_updateCol_sum M 0 (fun _ => (1 : ℝ))
      simpa only [one_smul] using h
    have hc0 : (M.updateCol 0 (fun a => ∑ c, M a c)) 0 0 = nn := by
      rw [Matrix.updateCol_self]; exact hrow0
    have hcs : ∀ j : Fin r, (M.updateCol 0 (fun a => ∑ c, M a c)) j.succ 0 = 0 := by
      intro j; rw [Matrix.updateCol_self]; exact hrows j
    have hsub : (M.updateCol 0 (fun a => ∑ c, M a c)).submatrix Fin.succ Fin.succ
        = M.submatrix Fin.succ Fin.succ := by
      ext a b
      simp only [Matrix.submatrix_apply]
      exact Matrix.updateCol_ne (Fin.succ_ne_zero b)
    rw [← hdetM', Matrix.det_succ_column_zero, Fin.sum_univ_succ]
    simp only [hcs, mul_zero, zero_mul, Finset.sum_const_zero, add_zero, hc0,
      Fin.val_zero, pow_zero, one_mul, Fin.succAbove_zero, hsub]
  have hminor : (M.submatrix Fin.succ Fin.succ).det
      = (Matrix.of fun a b : {i : ι // i ≠ i₀} => v (ee a) (b : ι)).det := by
    have h1 : M.submatrix Fin.succ Fin.succ
        = (Matrix.of fun a b : {i : ι // i ≠ i₀} => v (ee a) (b : ι)).submatrix
            ee.symm ee.symm := by
      ext a b
      rw [Matrix.submatrix_apply, Matrix.submatrix_apply, hMs a b.succ, hφs b,
        Matrix.of_apply, Equiv.apply_symm_apply]
    rw [h1, Matrix.det_submatrix_equiv_self]
  have hdetM : nn * ρ ≤ |M.det| := by
    rw [hdetfac, hminor, abs_mul, abs_of_pos hnn]
    exact mul_le_mul_of_nonneg_left hdet hnn.le
  have hQpos : (0 : ℝ) < nn * ρ := mul_pos hnn hρ
  have hdetpos : (0 : ℝ) < |M.det| := lt_of_lt_of_le hQpos hdetM
  have hunit : IsUnit M.det := isUnit_iff_ne_zero.mpr (abs_pos.mp hdetpos)
  have hkey : ∀ (w : ι → ℝ) (a : Fin (r + 1)), (∀ c, M a c = w (φ c)) →
      ∀ j : Fin r, ∑ k, w k * M⁻¹ (φ.symm k) j.succ
        = (if a = j.succ then (1 : ℝ) else 0) := by
    intro w a ha j
    have h1 : ∑ k, w k * M⁻¹ (φ.symm k) j.succ
        = ∑ c : Fin (r + 1), w (φ c) * M⁻¹ (φ.symm (φ c)) j.succ :=
      (Equiv.sum_comp φ (fun k => w k * M⁻¹ (φ.symm k) j.succ)).symm
    have h2 : ∀ c : Fin (r + 1),
        w (φ c) * M⁻¹ (φ.symm (φ c)) j.succ = M a c * M⁻¹ c j.succ := by
      intro c; rw [Equiv.symm_apply_apply, ha c]
    have h3 : ∑ c : Fin (r + 1), w (φ c) * M⁻¹ (φ.symm (φ c)) j.succ
        = ∑ c : Fin (r + 1), M a c * M⁻¹ c j.succ :=
      Finset.sum_congr rfl (fun c _ => h2 c)
    rw [h1, h3, ← Matrix.mul_apply, Matrix.mul_nonsing_inv M hunit, Matrix.one_apply]
  have hCnn : (0 : ℝ) ≤ (Nat.factorial r : ℝ) * P ^ r := by positivity
  have hinvbound : ∀ (c s : Fin (r + 1)),
      |M⁻¹ c s| ≤ (Nat.factorial r : ℝ) * P ^ r / (nn * ρ) := by
    intro c s
    have hAdet : |(M.submatrix s.succAbove c.succAbove).det|
        ≤ (Nat.factorial r : ℝ) * P ^ r := by
      have h := Matrix.det_le (A := M.submatrix s.succAbove c.succAbove)
        (abv := AbsoluteValue.abs) (x := P)
        (fun i j => by rw [AbsoluteValue.abs_apply, Matrix.submatrix_apply]; exact hMP _ _)
      simpa only [AbsoluteValue.abs_apply, Fintype.card_fin, nsmul_eq_mul] using h
    have hadj : M.adjugate c s = (-1 : ℝ) ^ ((s : ℕ) + (c : ℕ)) *
        (M.submatrix s.succAbove c.succAbove).det := by
      rw [Matrix.adjugate_apply, Matrix.det_succ_row _ s, Finset.sum_eq_single c]
      · rw [Matrix.updateRow_self, Pi.single_eq_same,
          Matrix.submatrix_updateRow_succAbove]
        ring
      · intro b _ hb
        rw [Matrix.updateRow_self, Pi.single_apply, if_neg hb]
        ring
      · intro h
        exact absurd (Finset.mem_univ c) h
    have hinv : M⁻¹ c s = (M.det)⁻¹ * M.adjugate c s := by
      rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]
    have hsign : |(-1 : ℝ) ^ ((s : ℕ) + (c : ℕ))| = 1 := by
      rw [abs_pow, abs_neg, abs_one, one_pow]
    rw [hinv, abs_mul, abs_inv, hadj, abs_mul, hsign, one_mul, inv_mul_eq_div,
      div_le_div_iff₀ hdetpos hQpos]
    calc |(M.submatrix s.succAbove c.succAbove).det| * (nn * ρ)
        ≤ ((Nat.factorial r : ℝ) * P ^ r) * (nn * ρ) :=
          mul_le_mul_of_nonneg_right hAdet hQpos.le
      _ ≤ ((Nat.factorial r : ℝ) * P ^ r) * |M.det| :=
          mul_le_mul_of_nonneg_left hdetM hCnn
  refine ⟨fun j i => M⁻¹ (φ.symm i) j.succ, ?_, ?_, ?_⟩
  · intro i j
    have h := hkey (v i) i.succ (hMs i) j
    simp only [Fin.succ_inj] at h
    exact h
  · intro j
    have h := hkey m 0 hM0 j
    rw [if_neg (Ne.symm (Fin.succ_ne_zero j))] at h
    exact h
  · intro j k
    exact hinvbound (φ.symm k) j.succ

theorem kai_tb_cong_unit_free_basis (K : Type u) [Field K] [NumberField K]
    (G : Subgroup (NumberField.RingOfIntegers K)ˣ) (hG0 : G.index ≠ 0)
    (hbas : ∀ (r D : ℕ) (M : AddSubgroup (Fin r → ℤ)), 0 < D → M.index ≠ 0 → M.index ≤ D →
      ∃ A : Matrix (Fin r) (Fin r) ℤ,
        (∀ j i, (A j i).natAbs ≤ D) ∧
        (∀ j, (fun i => A j i) ∈ M) ∧
        A.det ≠ 0 ∧
        (∀ x ∈ M, ∃! c : Fin r → ℤ, ∀ i, x i = ∑ j, c j * A j i)) :
    ∃ (ζ : (NumberField.RingOfIntegers K)ˣ) (wq : ℕ)
      (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
      (A : Matrix (Fin (NumberField.Units.rank K))
                  (Fin (NumberField.Units.rank K)) ℤ),
      (∀ j, H j ∈ G) ∧ ζ ∈ G ∧ orderOf ζ = wq ∧ 0 < wq ∧
      wq ∣ (NumberField.Units.torsionOrder K : ℕ) ∧
      (∀ v : (NumberField.RingOfIntegers K)ˣ, v ∈ G →
        ∃! p : ZMod wq × (Fin (NumberField.Units.rank K) → ℤ),
          v = ζ ^ (p.1.val) * ∏ j, (H j) ^ (p.2 j)) ∧
      Nat.card {u : (NumberField.RingOfIntegers K)ˣ //
        u ∈ NumberField.Units.torsion K ∧ u ∈ G} = wq ∧
      A.det ≠ 0 ∧
      (∀ j, ∃ z ∈ NumberField.Units.torsion K,
        H j = z * ∏ i, NumberField.Units.fundSystem K i ^ A j i) ∧
      (∀ j i, (A j i).natAbs ≤ G.index) :=
by
  classical
  have hex : ∀ x : (NumberField.RingOfIntegers K)ˣ,
      ∃ p : (↥(NumberField.Units.torsion K)) ×
              (Fin (NumberField.Units.rank K) → ℤ),
        (x = ↑p.1 * ∏ i, NumberField.Units.fundSystem K i ^ p.2 i) ∧
        ∀ p' : (↥(NumberField.Units.torsion K)) ×
                 (Fin (NumberField.Units.rank K) → ℤ),
          (x = ↑p'.1 * ∏ i, NumberField.Units.fundSystem K i ^ p'.2 i) → p' = p := by
    intro x
    obtain ⟨p, hp, hu⟩ := NumberField.Units.exist_unique_eq_mul_prod K x
    exact ⟨p, hp, hu⟩
  choose dec hdec hdecu using hex
  obtain ⟨φ, hφdef⟩ :
      ∃ f : (NumberField.RingOfIntegers K)ˣ →
              (Fin (NumberField.Units.rank K) → ℤ), ∀ x, f x = (dec x).2 :=
    ⟨_, fun _ => rfl⟩
  have hdec' : ∀ x : (NumberField.RingOfIntegers K)ˣ,
      x = ↑(dec x).1 * ∏ i, NumberField.Units.fundSystem K i ^ (φ x) i := by
    intro x; rw [hφdef]; exact hdec x
  have hdecu' : ∀ (x : (NumberField.RingOfIntegers K)ˣ)
      (z : ↥(NumberField.Units.torsion K))
      (a : Fin (NumberField.Units.rank K) → ℤ),
      x = ↑z * ∏ i, NumberField.Units.fundSystem K i ^ a i → φ x = a := by
    intro x z a h
    have h2 := hdecu x (z, a) h
    rw [hφdef]
    exact (congrArg Prod.snd h2).symm
  have hprodadd : ∀ a b : Fin (NumberField.Units.rank K) → ℤ,
      (∏ i, NumberField.Units.fundSystem K i ^ (a + b) i)
        = (∏ i, NumberField.Units.fundSystem K i ^ a i)
          * ∏ i, NumberField.Units.fundSystem K i ^ b i := by
    intro a b
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i _ => by rw [Pi.add_apply, zpow_add])
  have hprodzero :
      (∏ i, NumberField.Units.fundSystem K i
        ^ (0 : Fin (NumberField.Units.rank K) → ℤ) i) = 1 := by
    simp
  have hadd : ∀ x y : (NumberField.RingOfIntegers K)ˣ,
      φ (x * y) = φ x + φ y := by
    intro x y
    refine hdecu' (x * y) ((dec x).1 * (dec y).1) (φ x + φ y) ?_
    have hc : ((((dec x).1 * (dec y).1 : ↥(NumberField.Units.torsion K)) :
        (NumberField.RingOfIntegers K)ˣ)) = ↑(dec x).1 * ↑(dec y).1 := rfl
    rw [hc, hprodadd, mul_mul_mul_comm, ← hdec' x, ← hdec' y]
  have hker : ∀ x : (NumberField.RingOfIntegers K)ˣ,
      φ x = 0 ↔ x ∈ NumberField.Units.torsion K := by
    intro x
    constructor
    · intro h
      have h2 := hdec' x
      rw [h, hprodzero, mul_one] at h2
      rw [h2]
      exact (dec x).1.2
    · intro hx
      refine hdecu' x ⟨x, hx⟩ 0 ?_
      rw [hprodzero, mul_one]
  have hsurj0 : ∀ a : Fin (NumberField.Units.rank K) → ℤ,
      φ (∏ i, NumberField.Units.fundSystem K i ^ a i) = a := by
    intro a
    refine hdecu' _ 1 a ?_
    simp
  have hφone : φ 1 = 0 := (hker 1).mpr (Subgroup.one_mem _)
  have hφinv : ∀ x : (NumberField.RingOfIntegers K)ˣ, φ x⁻¹ = - φ x := by
    intro x
    have h : φ x + φ x⁻¹ = φ 1 := by rw [← hadd, mul_inv_cancel]
    rw [hφone] at h
    exact eq_neg_of_add_eq_zero_right h
  have hzpow : ∀ (x : (NumberField.RingOfIntegers K)ˣ) (k : ℤ),
      φ (x ^ k) = k • φ x := by
    intro x k
    induction k using Int.induction_on with
    | zero => simpa using hφone
    | succ n ih => rw [zpow_add_one, hadd, ih, add_smul, one_smul]
    | pred n ih =>
        rw [zpow_sub_one, hadd, hφinv, ih, sub_smul, one_smul, sub_eq_add_neg]
  have hzpownat : ∀ (x : (NumberField.RingOfIntegers K)ˣ) (m : ℕ),
      φ (x ^ m) = (m : ℤ) • φ x := by
    intro x m
    rw [← zpow_natCast x m, hzpow]
  have hprodgen : ∀ (s : Finset (Fin (NumberField.Units.rank K)))
      (f : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ),
      φ (∏ j ∈ s, f j) = ∑ j ∈ s, φ (f j) := by
    intro s f
    induction s using Finset.cons_induction with
    | empty => simpa using hφone
    | cons a s ha ih => rw [Finset.prod_cons, Finset.sum_cons, hadd, ih]
  obtain ⟨M, hMmem⟩ :
      ∃ M : AddSubgroup (Fin (NumberField.Units.rank K) → ℤ),
        ∀ a, a ∈ M ↔ ∃ u ∈ G, φ u = a := by
    refine ⟨{ carrier := {a | ∃ u ∈ G, φ u = a}
              zero_mem' := ⟨1, Subgroup.one_mem _, hφone⟩
              add_mem' := ?_
              neg_mem' := ?_ }, fun a => Iff.rfl⟩
    · rintro a b ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
      exact ⟨u * v, Subgroup.mul_mem _ hu hv, hadd u v⟩
    · rintro a ⟨u, hu, rfl⟩
      exact ⟨u⁻¹, Subgroup.inv_mem _ hu, hφinv u⟩
  haveI hfinq : Finite ((NumberField.RingOfIntegers K)ˣ ⧸ G) := by
    apply Nat.finite_of_card_ne_zero
    rw [← Subgroup.index_eq_card]
    exact hG0
  have hwd : ∀ a b : (NumberField.RingOfIntegers K)ˣ,
      (QuotientGroup.leftRel G) a b →
      (QuotientAddGroup.mk (φ a) :
        (Fin (NumberField.Units.rank K) → ℤ) ⧸ M) = QuotientAddGroup.mk (φ b) := by
    intro a b hab
    rw [QuotientGroup.leftRel_apply] at hab
    rw [QuotientAddGroup.eq]
    refine (hMmem _).mpr ⟨a⁻¹ * b, hab, ?_⟩
    rw [hadd, hφinv]
  obtain ⟨F, hFmk⟩ :
      ∃ F : ((NumberField.RingOfIntegers K)ˣ ⧸ G) →
              ((Fin (NumberField.Units.rank K) → ℤ) ⧸ M),
        ∀ u, F (QuotientGroup.mk u) = QuotientAddGroup.mk (φ u) :=
    ⟨fun x => Quotient.liftOn' x
        (fun u => (QuotientAddGroup.mk (φ u) :
          (Fin (NumberField.Units.rank K) → ℤ) ⧸ M)) hwd,
      fun _ => rfl⟩
  have hFsurj : Function.Surjective F := by
    intro y
    refine QuotientAddGroup.induction_on y ?_
    intro a
    exact ⟨QuotientGroup.mk (∏ i, NumberField.Units.fundSystem K i ^ a i),
      by rw [hFmk, hsurj0]⟩
  have hMle : M.index ≤ G.index := by
    have h := Nat.card_le_card_of_surjective F hFsurj
    rwa [← AddSubgroup.index_eq_card, ← Subgroup.index_eq_card] at h
  haveI hfinM : Finite ((Fin (NumberField.Units.rank K) → ℤ) ⧸ M) :=
    Finite.of_surjective F hFsurj
  have hM0 : M.index ≠ 0 := AddSubgroup.index_ne_zero_of_finite
  obtain ⟨A, hAbd, hArow, hAdet, hAuniq⟩ :=
    hbas (NumberField.Units.rank K) G.index M (Nat.pos_of_ne_zero hG0) hM0 hMle
  have hHex : ∀ j : Fin (NumberField.Units.rank K),
      ∃ u, u ∈ G ∧ φ u = (fun i => A j i) := by
    intro j
    obtain ⟨u, hu, hφu⟩ := (hMmem _).mp (hArow j)
    exact ⟨u, hu, hφu⟩
  choose H hHG hHφ using hHex
  haveI hSfin : Finite ↥(NumberField.Units.torsion K ⊓ G) :=
    Finite.of_injective _
      (Subgroup.inclusion_injective
        (inf_le_left : NumberField.Units.torsion K ⊓ G ≤
          NumberField.Units.torsion K))
  haveI hSub : IsCyclic ↥((NumberField.Units.torsion K ⊓ G).subgroupOf
      (NumberField.Units.torsion K)) :=
    Subgroup.isCyclic _
  haveI hScyc : IsCyclic ↥(NumberField.Units.torsion K ⊓ G) :=
    isCyclic_of_surjective
      (Subgroup.subgroupOfEquivOfLe
        (inf_le_left : NumberField.Units.torsion K ⊓ G ≤
          NumberField.Units.torsion K))
      (Subgroup.subgroupOfEquivOfLe
        (inf_le_left : NumberField.Units.torsion K ⊓ G ≤
          NumberField.Units.torsion K)).surjective
  haveI hSne : Nonempty ↥(NumberField.Units.torsion K ⊓ G) := ⟨1⟩
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator
    (α := ↥(NumberField.Units.torsion K ⊓ G))
  have hzpowtop :
      Subgroup.zpowers g = (⊤ : Subgroup ↥(NumberField.Units.torsion K ⊓ G)) :=
    (Subgroup.eq_top_iff' _).mpr hg
  have hord : orderOf ((g : (NumberField.RingOfIntegers K)ˣ))
      = Nat.card ↥(NumberField.Units.torsion K ⊓ G) := by
    rw [Subgroup.orderOf_coe, ← Nat.card_zpowers, hzpowtop]
    exact Nat.card_congr Subgroup.topEquiv.toEquiv
  have hwq0 : 0 < Nat.card ↥(NumberField.Units.torsion K ⊓ G) := Nat.card_pos
  have hζmem : (g : (NumberField.RingOfIntegers K)ˣ)
      ∈ NumberField.Units.torsion K ⊓ G := g.2
  have hζT : (g : (NumberField.RingOfIntegers K)ˣ) ∈ NumberField.Units.torsion K :=
    (Subgroup.mem_inf.mp hζmem).1
  have hζG : (g : (NumberField.RingOfIntegers K)ˣ) ∈ G :=
    (Subgroup.mem_inf.mp hζmem).2
  have hζφ : φ (g : (NumberField.RingOfIntegers K)ˣ) = 0 := (hker _).mpr hζT
  have hdvdT : Nat.card ↥(NumberField.Units.torsion K ⊓ G)
      ∣ Nat.card ↥(NumberField.Units.torsion K) := by
    have h1 : Nat.card ↥((NumberField.Units.torsion K ⊓ G).subgroupOf
        (NumberField.Units.torsion K)) ∣ Nat.card ↥(NumberField.Units.torsion K) :=
      Subgroup.card_subgroup_dvd_card _
    rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      (inf_le_left : NumberField.Units.torsion K ⊓ G ≤
        NumberField.Units.torsion K)).toEquiv] at h1
  have hdvd : Nat.card ↥(NumberField.Units.torsion K ⊓ G)
      ∣ (NumberField.Units.torsionOrder K : ℕ) := by
    have hTcard : Nat.card ↥(NumberField.Units.torsion K)
        = (NumberField.Units.torsionOrder K : ℕ) := Nat.card_eq_fintype_card
    rwa [hTcard] at hdvdT
  have hcount : Nat.card {u : (NumberField.RingOfIntegers K)ˣ //
      u ∈ NumberField.Units.torsion K ∧ u ∈ G}
      = Nat.card ↥(NumberField.Units.torsion K ⊓ G) :=
    (Nat.card_congr (Equiv.subtypeEquivRight (fun _ => Subgroup.mem_inf))).symm
  have hgen : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      u ∈ NumberField.Units.torsion K → u ∈ G →
      ∃ k : ℤ, u = (g : (NumberField.RingOfIntegers K)ˣ) ^ k := by
    intro u hu1 hu2
    have hmem : u ∈ NumberField.Units.torsion K ⊓ G :=
      Subgroup.mem_inf.mpr ⟨hu1, hu2⟩
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg ⟨u, hmem⟩)
    refine ⟨k, ?_⟩
    have h2 := congrArg (fun y : ↥(NumberField.Units.torsion K ⊓ G) =>
      (y : (NumberField.RingOfIntegers K)ˣ)) hk
    simpa using h2.symm
  have hkerG : ∀ u : (NumberField.RingOfIntegers K)ˣ, u ∈ G → φ u = 0 →
      ∃ k : ℤ, u = (g : (NumberField.RingOfIntegers K)ˣ) ^ k := by
    intro u hu h0
    exact hgen u ((hker u).mp h0) hu
  have hprodval : ∀ c : Fin (NumberField.Units.rank K) → ℤ,
      φ (∏ j, (H j) ^ (c j)) = fun i => ∑ j, c j * A j i := by
    intro c
    rw [hprodgen Finset.univ (fun j => H j ^ c j)]
    funext i
    rw [Finset.sum_apply]
    refine Finset.sum_congr rfl ?_
    intro j _
    rw [hzpow, Pi.smul_apply, hHφ j, smul_eq_mul]
  have huniq : ∀ u : (NumberField.RingOfIntegers K)ˣ, u ∈ G →
      ∃! c : Fin (NumberField.Units.rank K) → ℤ,
        ∀ i, φ u i = ∑ j, c j * A j i := by
    intro u hu
    exact hAuniq (φ u) ((hMmem _).mpr ⟨u, hu, rfl⟩)
  haveI hNZ : NeZero (Nat.card ↥(NumberField.Units.torsion K ⊓ G)) :=
    NeZero.of_pos hwq0
  have hmain : ∀ v : (NumberField.RingOfIntegers K)ˣ, v ∈ G →
      ∃! p : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)) ×
              (Fin (NumberField.Units.rank K) → ℤ),
        v = (g : (NumberField.RingOfIntegers K)ˣ) ^ (p.1.val)
          * ∏ j, (H j) ^ (p.2 j) := by
    intro v hv
    obtain ⟨c, hc, hcu⟩ := huniq v hv
    have hXG : (∏ j, (H j) ^ (c j)) ∈ G :=
      Subgroup.prod_mem _ (fun j _ => Subgroup.zpow_mem _ (hHG j) _)
    have htG : v * (∏ j, (H j) ^ (c j))⁻¹ ∈ G :=
      Subgroup.mul_mem _ hv (Subgroup.inv_mem _ hXG)
    have htφ : φ (v * (∏ j, (H j) ^ (c j))⁻¹) = 0 := by
      rw [hadd, hφinv, hprodval c]
      funext i
      simp [hc i]
    obtain ⟨k, hk⟩ := hkerG _ htG htφ
    have hcong : (g : (NumberField.RingOfIntegers K)ˣ)
        ^ (((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val)
        = (g : (NumberField.RingOfIntegers K)ˣ) ^ k := by
      rw [← zpow_natCast, zpow_eq_zpow_iff_modEq, hord, Int.modEq_iff_dvd]
      have hz :
          (((((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val : ℕ)) :
          ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))
          = (k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G))) := by
        rw [ZMod.natCast_val, ZMod.cast_id]
      have hzero : (((k -
          ((((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val : ℕ) : ℤ))
          : ℤ) : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G))) = 0 := by
        push_cast
        rw [hz]
        ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hzero
    refine ⟨((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G))), c), ?_, ?_⟩
    · show v = (g : (NumberField.RingOfIntegers K)ˣ)
        ^ (((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val)
        * ∏ j, (H j) ^ (c j)
      rw [hcong, ← hk, inv_mul_cancel_right]
    · rintro ⟨a', c'⟩ hp
      simp only at hp
      have hvec : φ v = fun i => ∑ j, c' j * A j i := by
        rw [hp, hadd, hzpownat, hζφ, smul_zero, zero_add, hprodval c']
      have hc'eq : c' = c := hcu c' (fun i => congrFun hvec i)
      subst hc'eq
      have hcancel : (g : (NumberField.RingOfIntegers K)ˣ) ^ (a'.val)
          = (g : (NumberField.RingOfIntegers K)ˣ)
            ^ (((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val) := by
        have h1 : (g : (NumberField.RingOfIntegers K)ˣ) ^ (a'.val)
            * ∏ j, (H j) ^ (c' j)
            = (g : (NumberField.RingOfIntegers K)ˣ)
              ^ (((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val)
              * ∏ j, (H j) ^ (c' j) := by
          rw [← hp, hcong, ← hk, inv_mul_cancel_right]
        exact mul_right_cancel h1
      have hmod :
          a'.val ≡ ((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val
          [MOD Nat.card ↥(NumberField.Units.torsion K ⊓ G)] := by
        have hm0 := pow_eq_pow_iff_modEq.mp hcancel
        rwa [hord] at hm0
      have hlt1 : a'.val < Nat.card ↥(NumberField.Units.torsion K ⊓ G) :=
        ZMod.val_lt _
      have hlt2 : ((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val
          < Nat.card ↥(NumberField.Units.torsion K ⊓ G) := ZMod.val_lt _
      have hvaleq :
          a'.val = ((k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G)))).val := by
        have hmm := hmod
        unfold Nat.ModEq at hmm
        rwa [Nat.mod_eq_of_lt hlt1, Nat.mod_eq_of_lt hlt2] at hmm
      have ha' : a' = (k : ZMod (Nat.card ↥(NumberField.Units.torsion K ⊓ G))) :=
        ZMod.val_injective _ hvaleq
      rw [ha']
  refine ⟨(g : (NumberField.RingOfIntegers K)ˣ),
    Nat.card ↥(NumberField.Units.torsion K ⊓ G), H, A,
    hHG, hζG, hord, hwq0, hdvd, hmain, hcount, hAdet, ?_, hAbd⟩
  intro j
  refine ⟨↑(dec (H j)).1, (dec (H j)).1.2, ?_⟩
  have h2 := hdec' (H j)
  rw [hHφ j] at h2
  exact h2

theorem kai_tb_unit_lattice (K : Type u) [Field K] [NumberField K] :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∃ (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ) (wq : ℕ) (Rq : ℝ)
        (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ),
        KaiTBUnitData K B q H wq Rq e :=
by
  classical
  have hR0 : 0 < NumberField.Units.regulator K := NumberField.Units.regulator_pos K
  have hn0 : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hnR : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn0
  have hpow0 : (0 : ℝ) < 2 ^ NumberField.InfinitePlace.nrRealPlaces K := by positivity
  have h2r1 : (1 : ℝ) ≤ 2 ^ NumberField.InfinitePlace.nrRealPlaces K :=
    one_le_pow₀ (by norm_num)
  obtain ⟨T, hTdef⟩ : ∃ T : ℝ, T = ∑ i : Fin (NumberField.Units.rank K),
      ∑ w : NumberField.InfinitePlace K,
        |kaiTBUnitLog K (NumberField.Units.fundSystem K i) w| := ⟨_, rfl⟩
  have hT0 : (0 : ℝ) ≤ T := by
    rw [hTdef]
    exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun w _ => abs_nonneg _
  obtain ⟨B₁, hB1def⟩ : ∃ B₁ : ℝ,
      B₁ = 2 ^ NumberField.InfinitePlace.nrRealPlaces K * (T + 1) := ⟨_, rfl⟩
  have hB1pos : 0 < B₁ := by
    rw [hB1def]; exact mul_pos hpow0 (by linarith)
  obtain ⟨P₀, hP0def⟩ : ∃ P₀ : ℝ, P₀ = B₁ + (Module.finrank ℚ K : ℝ) := ⟨_, rfl⟩
  obtain ⟨B₂, hB2def⟩ : ∃ B₂ : ℝ,
      B₂ = (Nat.factorial (NumberField.Units.rank K) : ℝ)
        * P₀ ^ NumberField.Units.rank K
        / ((Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K) := ⟨_, rfl⟩
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = max 1 (max B₁ (max B₂
      (2 ^ NumberField.InfinitePlace.nrRealPlaces K
        * NumberField.Units.regulator K))) := ⟨_, rfl⟩
  have hBge1 : (1 : ℝ) ≤ B := by rw [hBdef]; exact le_max_left _ _
  have hBnn : (0 : ℝ) ≤ B := le_trans zero_le_one hBge1
  have hB1le : B₁ ≤ B := by
    rw [hBdef]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hB2le : B₂ ≤ B := by
