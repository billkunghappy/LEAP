  set T := Fintype.piFinset (fun _ : Fin k => X) with hT
  have hTcard : (T.card : ℝ) = (X.card : ℝ) ^ k := by
    rw [hT, Fintype.card_piFinset]; simp
  have hD : (X.card : ℝ) ^ (2 * k) = (T.card : ℝ) * T.card := by
    rw [hTcard, ← pow_add, two_mul]
  have hDpos : 0 < (X.card : ℝ) ^ (2 * k) :=
    pow_pos (by exact_mod_cast Finset.card_pos.mpr hX) _
  have s3 : ∀ (H : (Fin k → ZMod P) → (Fin k → ZMod P) → ℝ) (c B : ℝ),
      (∀ v ∈ T, ∀ v' ∈ T, |c - H v v'| ≤ B) →
      |c - (∑ v ∈ T, ∑ v' ∈ T, H v v') / (X.card : ℝ) ^ (2 * k)| ≤ B := by
    intro H c B hH
    have hdiff : c - (∑ v ∈ T, ∑ v' ∈ T, H v v') / (X.card : ℝ) ^ (2 * k)
        = (∑ v ∈ T, ∑ v' ∈ T, (c - H v v')) / (X.card : ℝ) ^ (2 * k) := by
      rw [eq_div_iff hDpos.ne', sub_mul, div_mul_cancel₀ _ hDpos.ne']
      simp only [Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul]
      rw [hD]; ring
    rw [hdiff, abs_div, abs_of_pos hDpos, div_le_iff₀ hDpos]
    calc |∑ v ∈ T, ∑ v' ∈ T, (c - H v v')|
        ≤ ∑ v ∈ T, |∑ v' ∈ T, (c - H v v')| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ v ∈ T, ∑ v' ∈ T, |c - H v v'| :=
          Finset.sum_le_sum (fun v _ => Finset.abs_sum_le_sum_abs _ _)
      _ ≤ ∑ v ∈ T, ∑ v' ∈ T, B :=
          Finset.sum_le_sum (fun v hv => Finset.sum_le_sum (fun v' hv' => hH v hv v' hv'))
      _ = B * (X.card : ℝ) ^ (2 * k) := by
          simp only [Finset.sum_const, nsmul_eq_mul]; rw [hD]; ring
  
  have key : ∀ v ∈ T, ∀ v' ∈ T,
      |(∑ a ∈ A, F (a + u)) / A.card
        - (∑ a ∈ A, F (a + (u + ∑ i, (v i - v' i)))) / A.card|
        ≤ k * (E / A.card) ^ ((1 : ℝ) / (2 * q)) := by
    intro v hv v' hv'
    rw [hT, Fintype.mem_piFinset] at hv hv'
    have := s2 (fun s => (∑ a ∈ A, F (a + s)) / A.card) _ k (fun i => v i - v' i)
      (fun s i => s1 (v i) (hv i) (v' i) (hv' i) s) u
    rw [abs_sub_comm]
    exact this
  exact s3 (fun v v' => (∑ a ∈ A, F (a + (u + ∑ i, (v i - v' i)))) / A.card) _ _ key

theorem lc_riesz_lower {α β : Type*} (X : Finset α) (Δ : Finset β) (u : β → α → ℝ)
    (hu : ∀ δ ∈ Δ, ∀ x ∈ X, |u δ x| ≤ 1)
    (hsum : ∀ δ ∈ Δ, (X.card : ℝ) ≤ 2 * ∑ x ∈ X, u δ x) :
    (X.card : ℝ) * Real.exp ((Δ.card : ℝ) / 4)
      ≤ ∑ x ∈ X, ∏ δ ∈ Δ, (Real.cosh (1 / 2) + Real.sinh (1 / 2) * u δ x) :=
by
  classical
  have hprod : ∀ x ∈ X, Real.exp (∑ δ ∈ Δ, u δ x * (1 / 2))
      ≤ ∏ δ ∈ Δ, (Real.cosh (1 / 2) + Real.sinh (1 / 2) * u δ x) := by
    intro x hx
    rw [Real.exp_sum]
    apply Finset.prod_le_prod
    · intro δ _
      exact (Real.exp_pos _).le
    · intro δ hδ
      have h := Real.exp_mul_le_cosh_add_mul_sinh (hu δ hδ x hx) (1 / 2)
      rw [mul_comm (Real.sinh _)]
      exact h
  have hsumA : (X.card : ℝ) * ((Δ.card : ℝ) / 4) ≤ ∑ x ∈ X, ∑ δ ∈ Δ, u δ x * (1 / 2) := by
    rw [Finset.sum_comm]
    have hδ' : ∀ δ ∈ Δ, (X.card : ℝ) / 4 ≤ ∑ x ∈ X, u δ x * (1 / 2) := by
      intro δ hδ
      rw [← Finset.sum_mul]
      have := hsum δ hδ
      linarith
    calc (X.card : ℝ) * ((Δ.card : ℝ) / 4) = ∑ δ ∈ Δ, (X.card : ℝ) / 4 := by
          rw [Finset.sum_const, nsmul_eq_mul]; ring
      _ ≤ _ := Finset.sum_le_sum hδ'
  have htan : ∀ x ∈ X, Real.exp ((Δ.card : ℝ) / 4)
      * (1 + (∑ δ ∈ Δ, u δ x * (1 / 2)) - (Δ.card : ℝ) / 4)
      ≤ Real.exp (∑ δ ∈ Δ, u δ x * (1 / 2)) := by
    intro x _
    have h1 := Real.add_one_le_exp ((∑ δ ∈ Δ, u δ x * (1 / 2)) - (Δ.card : ℝ) / 4)
    have h2 : Real.exp (∑ δ ∈ Δ, u δ x * (1 / 2)) = Real.exp ((Δ.card : ℝ) / 4)
        * Real.exp ((∑ δ ∈ Δ, u δ x * (1 / 2)) - (Δ.card : ℝ) / 4) := by
      rw [← Real.exp_add]; congr 1; ring
    rw [h2]
    apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
    linarith
  have hE := Real.exp_pos ((Δ.card : ℝ) / 4)
  calc (X.card : ℝ) * Real.exp ((Δ.card : ℝ) / 4)
      ≤ ∑ x ∈ X, Real.exp ((Δ.card : ℝ) / 4)
          * (1 + (∑ δ ∈ Δ, u δ x * (1 / 2)) - (Δ.card : ℝ) / 4) := by
        rw [← Finset.mul_sum, Finset.sum_sub_distrib, Finset.sum_add_distrib,
          Finset.sum_const, Finset.sum_const, nsmul_eq_mul, nsmul_eq_mul]
        have := mul_le_mul_of_nonneg_left hsumA hE.le
        nlinarith
    _ ≤ ∑ x ∈ X, Real.exp (∑ δ ∈ Δ, u δ x * (1 / 2)) := Finset.sum_le_sum htan
    _ ≤ _ := Finset.sum_le_sum hprod

theorem lc_riesz_upper (P : ℕ) [NeZero P] (B Δ : Finset (ZMod P)) (c : ZMod P → ℂ) (a b κ : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hκ : 0 ≤ κ) (hc : ∀ δ ∈ Δ, ‖c δ‖ ≤ 1)
    (hdiss : ∀ ε : ZMod P → ℤ, (∀ δ, ε δ = -1 ∨ ε δ = 0 ∨ ε δ = 1) → (∀ δ, δ ∉ Δ → ε δ = 0) →
      (∃ δ ∈ Δ, ε δ ≠ 0) →
      ‖∑ x ∈ B, giE ((((∑ δ ∈ Δ, (ε δ : ZMod P) * δ) * x).val : ℝ) / P)‖ ≤ κ * B.card) :
    ∑ x ∈ B, ∏ δ ∈ Δ, (a + b * (c δ * giE (((δ * x).val : ℝ) / P)).re)
      ≤ (B.card : ℝ) * (a ^ Δ.card + (a + b) ^ Δ.card * κ) :=
by
  
  have hχ : ∀ j : ZMod P, giE ((j.val : ℝ) / P) = ZMod.stdAddChar j := by
    intro j
    rw [ZMod.stdAddChar_apply, ZMod.toCircle_apply]
    unfold giE
    congr 1
    push_cast
    ring
  simp only [hχ] at hdiss ⊢
  have hprod : ∀ (s : Finset (ZMod P)) (u : ZMod P → ZMod P),
      ∏ δ ∈ s, ZMod.stdAddChar (u δ) = ZMod.stdAddChar (∑ δ ∈ s, u δ) := by
    intro s u
    induction s using Finset.induction_on with
    | empty => simp
    | insert i s hi ih =>
      rw [Finset.prod_insert hi, Finset.sum_insert hi, ih, AddChar.map_add_eq_mul]
  
  obtain ⟨t, ht⟩ : ∃ t : ZMod P → Finset ℤ,
      ∀ δ, t δ = if δ ∈ Δ then ({-1, 0, 1} : Finset ℤ) else {0} := ⟨_, fun _ => rfl⟩
  
  have hexp : ∀ (R : Type) [CommSemiring R] (g : ZMod P → ℤ → R),
      ∏ δ ∈ Δ, (g δ (-1) + g δ 0 + g δ 1)
        = ∑ ε ∈ Fintype.piFinset t, ∏ δ ∈ Δ, g δ (ε δ) := by
    intro R _ g
    have h1 : ∀ δ, ∑ j ∈ t δ, (if δ ∈ Δ then g δ j else 1)
        = if δ ∈ Δ then g δ (-1) + g δ 0 + g δ 1 else 1 := by
      intro δ
      by_cases hδ : δ ∈ Δ
      · rw [ht, if_pos hδ, if_pos hδ]
        simp only [if_pos hδ]
        rw [Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_singleton]
        ring
      · rw [ht, if_neg hδ, if_neg hδ, Finset.sum_singleton, if_neg hδ]
    calc ∏ δ ∈ Δ, (g δ (-1) + g δ 0 + g δ 1)
        = ∏ δ, (if δ ∈ Δ then g δ (-1) + g δ 0 + g δ 1 else 1) := by
          rw [Finset.prod_ite_mem, Finset.univ_inter]
      _ = ∏ δ, ∑ j ∈ t δ, (if δ ∈ Δ then g δ j else 1) :=
          Finset.prod_congr rfl (fun δ _ => (h1 δ).symm)
      _ = ∑ ε ∈ Fintype.piFinset t, ∏ δ, (if δ ∈ Δ then g δ (ε δ) else 1) :=
          Finset.prod_univ_sum t _
      _ = ∑ ε ∈ Fintype.piFinset t, ∏ δ ∈ Δ, g δ (ε δ) := by
          refine Finset.sum_congr rfl (fun ε _ => ?_)
          rw [Finset.prod_ite_mem, Finset.univ_inter]
  
  obtain ⟨w, hw⟩ : ∃ w : ZMod P → ℤ → ℂ, ∀ δ j, w δ j = if j = 0 then (a : ℂ)
      else if j = 1 then (b : ℂ) / 2 * c δ else (b : ℂ) / 2 * (starRingEnd ℂ) (c δ) :=
    ⟨_, fun _ _ => rfl⟩
  
  have hfac : ∀ x δ : ZMod P,
      (((a + b * (c δ * ZMod.stdAddChar (δ * x)).re : ℝ)) : ℂ)
        = w δ (-1) * ZMod.stdAddChar (((-1 : ℤ) : ZMod P) * δ * x)
          + w δ 0 * ZMod.stdAddChar (((0 : ℤ) : ZMod P) * δ * x)
          + w δ 1 * ZMod.stdAddChar (((1 : ℤ) : ZMod P) * δ * x) := by
    intro x δ
    have h0 : w δ 0 = a := by rw [hw]; simp
    have h1 : w δ 1 = (b : ℂ) / 2 * c δ := by rw [hw]; simp
    have hm1 : w δ (-1) = (b : ℂ) / 2 * (starRingEnd ℂ) (c δ) := by
      rw [hw, if_neg (by norm_num), if_neg (by norm_num)]
    have e0 : ((0 : ℤ) : ZMod P) * δ * x = 0 := by simp
    have e1 : ((1 : ℤ) : ZMod P) * δ * x = δ * x := by simp
    have em1 : ((-1 : ℤ) : ZMod P) * δ * x = -(δ * x) := by push_cast; ring
    rw [h0, h1, hm1, e0, e1, em1, AddChar.map_zero_eq_one, AddChar.map_neg_eq_conj,
      Complex.ofReal_add, Complex.ofReal_mul, Complex.re_eq_add_conj, map_mul (starRingEnd ℂ)]
    ring
  
  have hZ : ((∑ x ∈ B, ∏ δ ∈ Δ, (a + b * (c δ * ZMod.stdAddChar (δ * x)).re) : ℝ) : ℂ)
      = ∑ ε ∈ Fintype.piFinset t, (∏ δ ∈ Δ, w δ (ε δ)) *
          ∑ x ∈ B, ZMod.stdAddChar ((∑ δ ∈ Δ, (ε δ : ZMod P) * δ) * x) := by
    rw [Complex.ofReal_sum]
    have hx : ∀ x ∈ B,
        (((∏ δ ∈ Δ, (a + b * (c δ * ZMod.stdAddChar (δ * x)).re) : ℝ)) : ℂ)
          = ∑ ε ∈ Fintype.piFinset t, (∏ δ ∈ Δ, w δ (ε δ)) *
              ZMod.stdAddChar ((∑ δ ∈ Δ, (ε δ : ZMod P) * δ) * x) := by
      intro x _
      rw [Complex.ofReal_prod, Finset.prod_congr rfl (fun δ _ => hfac x δ)]
      have hE := hexp ℂ (fun δ j => w δ j * ZMod.stdAddChar ((j : ZMod P) * δ * x))
      beta_reduce at hE
      rw [hE]
      refine Finset.sum_congr rfl (fun ε _ => ?_)
      rw [Finset.prod_mul_distrib, hprod, Finset.sum_mul]
    rw [Finset.sum_congr rfl hx, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ε _ => ?_)
    rw [Finset.mul_sum]
  
  have h0T : (0 : ZMod P → ℤ) ∈ Fintype.piFinset t := by
    rw [Fintype.mem_piFinset]
    intro δ
    rw [ht]
    split_ifs <;> simp
  have hW0 : (∏ δ ∈ Δ, w δ ((0 : ZMod P → ℤ) δ)) = (a : ℂ) ^ Δ.card := by
    rw [Finset.prod_congr rfl (fun δ _ => show w δ ((0 : ZMod P → ℤ) δ) = (a : ℂ) by
      rw [hw]; simp)]
    exact Finset.prod_const _
  have hF0 : (∑ x ∈ B, ZMod.stdAddChar
      ((∑ δ ∈ Δ, (((0 : ZMod P → ℤ) δ : ℤ) : ZMod P) * δ) * x)) = (B.card : ℂ) := by
    simp
  set W : (ZMod P → ℤ) → ℂ := fun ε => ∏ δ ∈ Δ, w δ (ε δ) with hW_def
  set F : (ZMod P → ℤ) → ℂ := fun ε =>
    ∑ x ∈ B, ZMod.stdAddChar ((∑ δ ∈ Δ, (ε δ : ZMod P) * δ) * x) with hF_def
  set T := Fintype.piFinset t with hT_def
  have hsplit := Finset.add_sum_erase T (fun ε => W ε * F ε) h0T
  have hW0' : W 0 = (a : ℂ) ^ Δ.card := hW0
  have hF0' : F 0 = (B.card : ℂ) := hF0
  set err := ∑ ε ∈ T.erase 0, W ε * F ε with herr
  have hLHS : ∑ x ∈ B, ∏ δ ∈ Δ, (a + b * (c δ * ZMod.stdAddChar (δ * x)).re)
      = a ^ Δ.card * B.card + err.re := by
    have h := congrArg Complex.re hZ
    rw [Complex.ofReal_re] at h
    rw [h]
    change (∑ ε ∈ T, W ε * F ε).re = _
    rw [← hsplit]
    simp only []
    rw [hW0', hF0', Complex.add_re]
    congr 1
    rw [← Complex.ofReal_pow, ← Complex.ofReal_natCast, ← Complex.ofReal_mul, Complex.ofReal_re]
  
  have hadm : ∀ ε ∈ T.erase 0, ‖F ε‖ ≤ κ * B.card := by
    intro ε hε
    rw [Finset.mem_erase] at hε
    obtain ⟨hne, hmem⟩ := hε
    rw [hT_def, Fintype.mem_piFinset] at hmem
    have hoff : ∀ δ, δ ∉ Δ → ε δ = 0 := by
      intro δ hδ
      have := hmem δ
      rw [ht, if_neg hδ] at this
      simpa using this
    have hv : ∀ δ, ε δ = -1 ∨ ε δ = 0 ∨ ε δ = 1 := by
      intro δ
      by_cases hδ : δ ∈ Δ
      · have := hmem δ
        rw [ht, if_pos hδ] at this
        simpa using this
      · exact Or.inr (Or.inl (hoff δ hδ))
    have hex : ∃ δ ∈ Δ, ε δ ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hne
      funext δ
      by_cases hδ : δ ∈ Δ
      · exact hcon δ hδ
      · exact hoff δ hδ
    exact hdiss ε hv hoff hex
  
  have hwn : ∀ ε : ZMod P → ℤ, ∀ δ ∈ Δ, ‖w δ (ε δ)‖ ≤ (if ε δ = 0 then a else b / 2) := by
    intro ε δ hδ
    have hcδ := hc δ hδ
    rw [hw]
    split_ifs with h0 h1
    · rw [Complex.norm_of_nonneg ha]
    · rw [norm_mul, norm_div, Complex.norm_of_nonneg hb]
      simp only [RCLike.norm_ofNat]
      exact mul_le_of_le_one_right (by positivity) hcδ
    · rw [norm_mul, norm_div, Complex.norm_of_nonneg hb, Complex.norm_conj]
      simp only [RCLike.norm_ofNat]
      exact mul_le_of_le_one_right (by positivity) hcδ
  have hm : ∑ ε ∈ T, ∏ δ ∈ Δ, (if ε δ = 0 then a else b / 2) = (a + b) ^ Δ.card := by
    have hE := hexp ℝ (fun _ j => if j = 0 then a else b / 2)
    beta_reduce at hE
    rw [← hE]
    have h3 : ((if (-1 : ℤ) = 0 then a else b / 2) + (if (0 : ℤ) = 0 then a else b / 2)
        + (if (1 : ℤ) = 0 then a else b / 2)) = a + b := by
      rw [if_neg (by norm_num), if_pos rfl, if_neg (by norm_num)]
      ring
    rw [Finset.prod_congr rfl (fun _ _ => h3), Finset.prod_const]
  have hWsum : ∑ ε ∈ T, ‖W ε‖ ≤ (a + b) ^ Δ.card := by
    rw [← hm]
    refine Finset.sum_le_sum (fun ε _ => ?_)
    simp only [hW_def]
    rw [norm_prod]
    exact Finset.prod_le_prod (fun δ _ => norm_nonneg _) (fun δ hδ => hwn ε δ hδ)
  
  have hκB : 0 ≤ κ * (B.card : ℝ) := mul_nonneg hκ (Nat.cast_nonneg _)
  have herrb : ‖err‖ ≤ κ * B.card * (a + b) ^ Δ.card := by
    calc ‖err‖ ≤ ∑ ε ∈ T.erase 0, ‖W ε * F ε‖ := norm_sum_le _ _
      _ = ∑ ε ∈ T.erase 0, ‖W ε‖ * ‖F ε‖ := by simp only [norm_mul]
      _ ≤ ∑ ε ∈ T.erase 0, ‖W ε‖ * (κ * B.card) :=
          Finset.sum_le_sum (fun ε hε => mul_le_mul_of_nonneg_left (hadm ε hε) (norm_nonneg _))
      _ = κ * B.card * ∑ ε ∈ T.erase 0, ‖W ε‖ := by rw [← Finset.sum_mul, mul_comm]
      _ ≤ κ * B.card * ∑ ε ∈ T, ‖W ε‖ := by
          apply mul_le_mul_of_nonneg_left _ hκB
          exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.erase_subset 0 T)
            (fun _ _ _ => norm_nonneg _)
      _ ≤ κ * B.card * (a + b) ^ Δ.card := mul_le_mul_of_nonneg_left hWsum hκB
  have hre : err.re ≤ ‖err‖ := Complex.re_le_norm err
  rw [hLHS]
  nlinarith [hre, herrb]

theorem lc_chang_card_bound (P : ℕ) [NeZero P] (B X Δ : Finset (ZMod P)) (κ : ℝ)
    (hXB : X ⊆ B) (hX : X.Nonempty) (hκ : 0 ≤ κ) (hκM : (2 : ℝ) ^ Δ.card * κ ≤ 1)
    (hspec : ∀ δ ∈ Δ, (X.card : ℝ) ≤ 2 * ‖∑ x ∈ X, giE (((δ * x).val : ℝ) / P)‖)
    (hdiss : ∀ ε : ZMod P → ℤ, (∀ δ, ε δ = -1 ∨ ε δ = 0 ∨ ε δ = 1) → (∀ δ, δ ∉ Δ → ε δ = 0) →
      (∃ δ ∈ Δ, ε δ ≠ 0) →
      ‖∑ x ∈ B, giE ((((∑ δ ∈ Δ, (ε δ : ZMod P) * δ) * x).val : ℝ) / P)‖ ≤ κ * B.card) :
    (X.card : ℝ) * Real.exp ((Δ.card : ℝ) / 8) ≤ 2 * B.card :=
by
  classical
  
  have hnormE : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t
    unfold giE
    rw [show (2 * (Real.pi : ℂ) * Complex.I * (t : ℂ)) = ((2 * Real.pi * t : ℝ) : ℂ) * Complex.I by
      push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  obtain ⟨c, hc_def⟩ : ∃ c : ZMod P → ℂ, c = fun δ =>
      (starRingEnd ℂ) (∑ x ∈ X, giE (((δ * x).val : ℝ) / P))
        / ((‖∑ x ∈ X, giE (((δ * x).val : ℝ) / P)‖ : ℝ) : ℂ) := ⟨_, rfl⟩
  have hcn : ∀ δ, ‖c δ‖ ≤ 1 := by
    intro δ
    rw [hc_def]
    simp only []
    rw [norm_div, Complex.norm_conj, Complex.norm_real, Real.norm_eq_abs, abs_norm]
    exact div_self_le_one _
  have hu1 : ∀ δ x, |(c δ * giE (((δ * x).val : ℝ) / P)).re| ≤ 1 := by
    intro δ x
    refine (Complex.abs_re_le_norm _).trans ?_
    rw [norm_mul, hnormE, mul_one]
    exact hcn δ
  have hcS : ∀ δ, c δ * (∑ x ∈ X, giE (((δ * x).val : ℝ) / P))
      = ((‖∑ x ∈ X, giE (((δ * x).val : ℝ) / P)‖ : ℝ) : ℂ) := by
    intro δ
    rw [hc_def]
    simp only []
    by_cases h0 : (∑ x ∈ X, giE (((δ * x).val : ℝ) / P)) = 0
    · rw [h0]; simp
    · have hn : ((‖∑ x ∈ X, giE (((δ * x).val : ℝ) / P)‖ : ℝ) : ℂ) ≠ 0 := by
        exact_mod_cast norm_ne_zero_iff.mpr h0
      rw [div_mul_eq_mul_div, Complex.conj_mul', div_eq_iff hn]
      ring
  have hsumu : ∀ δ, ∑ x ∈ X, (c δ * giE (((δ * x).val : ℝ) / P)).re
      = ‖∑ x ∈ X, giE (((δ * x).val : ℝ) / P)‖ := by
    intro δ
    rw [← Complex.re_sum, ← Finset.mul_sum, hcS, Complex.ofReal_re]
  have hsum' : ∀ δ ∈ Δ, (X.card : ℝ) ≤ 2 * ∑ x ∈ X, (c δ * giE (((δ * x).val : ℝ) / P)).re := by
    intro δ hδ
    rw [hsumu]
    exact hspec δ hδ
  
  have hb : 0 ≤ Real.sinh (1 / 2) := Real.sinh_nonneg_iff.mpr (by norm_num)
  have ha : 0 ≤ Real.cosh (1 / 2) := (Real.cosh_pos _).le
  
  have hlow := lc_riesz_lower X Δ (fun δ x => (c δ * giE (((δ * x).val : ℝ) / P)).re)
    (fun δ _ x _ => hu1 δ x) hsum'
  
  have hpos : ∀ x : ZMod P, 0 ≤ ∏ δ ∈ Δ,
      (Real.cosh (1 / 2) + Real.sinh (1 / 2) * (c δ * giE (((δ * x).val : ℝ) / P)).re) := by
    intro x
    apply Finset.prod_nonneg
    intro δ _
    have h1 : -1 ≤ (c δ * giE (((δ * x).val : ℝ) / P)).re := neg_le_of_abs_le (hu1 δ x)
    have h2 : Real.sinh (1 / 2) * (-1) ≤
        Real.sinh (1 / 2) * (c δ * giE (((δ * x).val : ℝ) / P)).re :=
      mul_le_mul_of_nonneg_left h1 hb
    have h3 : Real.cosh (1 / 2) - Real.sinh (1 / 2) = Real.exp (-(1 / 2)) := Real.cosh_sub_sinh _
    have h4 := Real.exp_pos (-(1 / 2 : ℝ))
    linarith
  have hmono : ∑ x ∈ X, ∏ δ ∈ Δ,
      (Real.cosh (1 / 2) + Real.sinh (1 / 2) * (c δ * giE (((δ * x).val : ℝ) / P)).re)
      ≤ ∑ x ∈ B, ∏ δ ∈ Δ,
      (Real.cosh (1 / 2) + Real.sinh (1 / 2) * (c δ * giE (((δ * x).val : ℝ) / P)).re) :=
    Finset.sum_le_sum_of_subset_of_nonneg hXB (fun x _ _ => hpos x)
  
  have hup := lc_riesz_upper P B Δ c (Real.cosh (1 / 2)) (Real.sinh (1 / 2)) κ ha hb hκ
    (fun δ _ => hcn δ) hdiss
  
  have hE : Real.cosh (1 / 2) ^ Δ.card ≤ Real.exp ((Δ.card : ℝ) / 8) := by
    have h1 : Real.cosh (1 / 2) ≤ Real.exp ((1 / 2 : ℝ) ^ 2 / 2) := Real.cosh_le_exp_half_sq _
    calc Real.cosh (1 / 2) ^ Δ.card ≤ Real.exp ((1 / 2 : ℝ) ^ 2 / 2) ^ Δ.card :=
          pow_le_pow_left₀ ha h1 _
      _ = Real.exp ((Δ.card : ℝ) / 8) := by
          rw [← Real.exp_nat_mul]; congr 1; ring
  have hab : Real.cosh (1 / 2) + Real.sinh (1 / 2) ≤ 2 := by
    rw [Real.cosh_add_sinh]
    have hl := Real.log_two_gt_d9
    calc Real.exp (1 / 2) ≤ Real.exp (Real.log 2) := Real.exp_le_exp.mpr (by linarith)
      _ = 2 := Real.exp_log (by norm_num)
  have hκ1 : (Real.cosh (1 / 2) + Real.sinh (1 / 2)) ^ Δ.card * κ ≤ 1 := by
    have h1 : (Real.cosh (1 / 2) + Real.sinh (1 / 2)) ^ Δ.card ≤ (2 : ℝ) ^ Δ.card :=
      pow_le_pow_left₀ (by linarith) hab _
    exact (mul_le_mul_of_nonneg_right h1 hκ).trans hκM
  have hE1 : 1 ≤ Real.exp ((Δ.card : ℝ) / 8) := Real.one_le_exp (by positivity)
  have hEpos : 0 < Real.exp ((Δ.card : ℝ) / 8) := Real.exp_pos _
  have hsq : Real.exp ((Δ.card : ℝ) / 4)
      = Real.exp ((Δ.card : ℝ) / 8) * Real.exp ((Δ.card : ℝ) / 8) := by
    rw [← Real.exp_add]; congr 1; ring
  have hB0 : (0 : ℝ) ≤ B.card := Nat.cast_nonneg _
  have hbr : Real.cosh (1 / 2) ^ Δ.card + (Real.cosh (1 / 2) + Real.sinh (1 / 2)) ^ Δ.card * κ
      ≤ 2 * Real.exp ((Δ.card : ℝ) / 8) := by linarith
  have hchain : (X.card : ℝ) * Real.exp ((Δ.card : ℝ) / 8) * Real.exp ((Δ.card : ℝ) / 8)
      ≤ (2 * B.card) * Real.exp ((Δ.card : ℝ) / 8) := by
    calc (X.card : ℝ) * Real.exp ((Δ.card : ℝ) / 8) * Real.exp ((Δ.card : ℝ) / 8)
        = (X.card : ℝ) * Real.exp ((Δ.card : ℝ) / 4) := by rw [hsq]; ring
      _ ≤ _ := hlow
      _ ≤ _ := hmono
      _ ≤ _ := hup
      _ ≤ (B.card : ℝ) * (2 * Real.exp ((Δ.card : ℝ) / 8)) := mul_le_mul_of_nonneg_left hbr hB0
      _ = (2 * B.card) * Real.exp ((Δ.card : ℝ) / 8) := by ring
  exact le_of_mul_le_mul_right hchain hEpos

theorem lc_bohr_spectrum_annihilation (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ρ ρ₀ κ : ℝ)
    (γ y : ZMod P) (hρ : 0 < ρ) (hρ₀ : 0 < ρ₀) (hsmall : 100 * (S.card : ℝ) * ρ₀ ≤ ρ)
    (hreg : GiRegularBohr P S ρ)
    (hκ : κ * ((giBohr P S ρ).card : ℝ) ≤ ‖∑ x ∈ giBohr P S ρ, giE (((γ * x).val : ℝ) / P)‖)
    (hy : y ∈ giBohr P S ρ₀) :
    κ * giCircNorm P (γ * y) ≤ 50 * (S.card : ℝ) * ρ₀ / ρ :=
by
  classical
  have hPpos : (0 : ℝ) < P := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne P)
  
  have hnorm : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t
    unfold giE
    have h : 2 * (Real.pi : ℂ) * Complex.I * (t : ℂ) = ((2 * Real.pi * t : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [h, Complex.norm_exp_ofReal_mul_I]
  have hE_add : ∀ s t : ℝ, giE (s + t) = giE s * giE t := by
    intro s t
    unfold giE
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hE_sub1 : ∀ s : ℝ, giE (s - 1) = giE s := by
    intro s
    unfold giE
    rw [show 2 * (Real.pi : ℂ) * Complex.I * ((s - 1 : ℝ) : ℂ)
        = 2 * (Real.pi : ℂ) * Complex.I * (s : ℂ) - 2 * Real.pi * Complex.I by push_cast; ring,
      Complex.exp_sub, Complex.exp_two_pi_mul_I, div_one]
  have hval : ∀ a b : ZMod P, ((a + b).val : ℝ) = a.val + b.val ∨
      ((a + b).val : ℝ) = a.val + b.val - P := by
    intro a b
    have ha := ZMod.val_lt a
    have hb := ZMod.val_lt b
    rw [ZMod.val_add]
    by_cases h : a.val + b.val < P
    · left; rw [Nat.mod_eq_of_lt h]; push_cast; ring
    · right
      push_neg at h
      rw [Nat.mod_eq_sub_mod h, Nat.mod_eq_of_lt (by omega), Nat.cast_sub h]
      push_cast; ring
  have hadd : ∀ a b : ZMod P, giE (((a + b).val : ℝ) / P)
      = giE ((a.val : ℝ) / P) * giE ((b.val : ℝ) / P) := by
    intro a b
    rcases hval a b with h | h
    · rw [h, add_div, hE_add]
    · rw [h, sub_div, add_div, div_self hPpos.ne', hE_sub1, hE_add]
  
  have hchord : ∀ a : ZMod P, 4 * giCircNorm P a ≤ ‖1 - giE ((a.val : ℝ) / P)‖ := by
    intro a
    obtain ⟨u, hu⟩ : ∃ u : ℝ, u = (a.val : ℝ) / P := ⟨_, rfl⟩
    have hu0 : 0 ≤ u := by rw [hu]; exact div_nonneg (Nat.cast_nonneg _) hPpos.le
    have hu1 : u ≤ 1 := by
      rw [hu, div_le_one hPpos]; exact_mod_cast (ZMod.val_lt a).le
    have hcn : giCircNorm P a = min u (1 - u) := by rw [hu]; rfl
    rw [hcn, ← hu]
    have heq : ‖1 - giE u‖ = |2 * Real.sin (Real.pi * u)| := by
      rw [norm_sub_rev]
      unfold giE
      have h : 2 * (Real.pi : ℂ) * Complex.I * (u : ℂ)
          = Complex.I * ((2 * Real.pi * u : ℝ) : ℂ) := by push_cast; ring
      rw [h, Complex.norm_exp_I_mul_ofReal_sub_one, Real.norm_eq_abs,
        show 2 * Real.pi * u / 2 = Real.pi * u by ring]
    rw [heq]
    have hpi := Real.pi_pos
    rcases le_or_gt u (1 / 2) with h | h
    · have hx0 : 0 ≤ Real.pi * u := mul_nonneg hpi.le hu0
      have hx1 : Real.pi * u ≤ Real.pi / 2 := by
        have := mul_le_mul_of_nonneg_left h hpi.le; linarith
      have hs := Real.mul_le_sin hx0 hx1
      have h2 : 2 / Real.pi * (Real.pi * u) = 2 * u := by field_simp
      rw [h2] at hs
      have h3 : 4 * u ≤ |2 * Real.sin (Real.pi * u)| := by
        rw [abs_of_nonneg (by linarith)]; linarith
      exact (mul_le_mul_of_nonneg_left (min_le_left _ _) (by norm_num)).trans h3
    · have hx0 : 0 ≤ Real.pi * (1 - u) := mul_nonneg hpi.le (by linarith)
      have hx1 : Real.pi * (1 - u) ≤ Real.pi / 2 := by
        have := mul_le_mul_of_nonneg_left (show 1 - u ≤ 1 / 2 by linarith) hpi.le; linarith
      have hs := Real.mul_le_sin hx0 hx1
      have h2 : 2 / Real.pi * (Real.pi * (1 - u)) = 2 * (1 - u) := by field_simp
      rw [h2] at hs
      have hsin : Real.sin (Real.pi * u) = Real.sin (Real.pi * (1 - u)) := by
        rw [show Real.pi * (1 - u) = Real.pi - Real.pi * u by ring, Real.sin_pi_sub]
      have h3 : 4 * (1 - u) ≤ |2 * Real.sin (Real.pi * u)| := by
        rw [hsin, abs_of_nonneg (by linarith)]; linarith
      exact (mul_le_mul_of_nonneg_left (min_le_right _ _) (by norm_num)).trans h3
  
  have hcn0 : giCircNorm P 0 = 0 := by
    simp only [giCircNorm, ZMod.val_zero, Nat.cast_zero, zero_div, sub_zero]
    exact min_eq_left zero_le_one
  have hcn_nn : ∀ a : ZMod P, 0 ≤ giCircNorm P a := by
    intro a
    have h1 : ((a.val : ℝ)) / P ≤ 1 := by
      rw [div_le_one hPpos]; exact_mod_cast (ZMod.val_lt a).le
    exact le_min (by positivity) (by linarith)
  have hkey : ∀ u v w : ℝ, 0 ≤ u → u ≤ 1 → 0 ≤ v → v ≤ 1 → (w = u + v ∨ w = u + v - 1) →
      min w (1 - w) ≤ min u (1 - u) + min v (1 - v) := by
    intro u v w hu0 hu1 hv0 hv1 hw
    rcases hw with rfl | rfl <;>
    rcases min_cases u (1 - u) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
    rcases min_cases v (1 - v) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
    rw [h1, h2] <;>
    first
    | exact (min_le_left _ _).trans (by linarith)
    | exact (min_le_right _ _).trans (by linarith)
  have htri : ∀ a b : ZMod P, giCircNorm P (a + b) ≤ giCircNorm P a + giCircNorm P b := by
    intro a b
    have ha := ZMod.val_lt a
    have hb := ZMod.val_lt b
    unfold giCircNorm
    apply hkey
    · positivity
    · rw [div_le_one hPpos]; exact_mod_cast ha.le
    · positivity
    · rw [div_le_one hPpos]; exact_mod_cast hb.le
    · rcases hval a b with h | h
      · left; rw [h, add_div]
      · right; rw [h, sub_div, add_div, div_self hPpos.ne']
  
  have hmem : ∀ (r : ℝ) (x : ZMod P), x ∈ giBohr P S r ↔ ∀ ξ ∈ S, giCircNorm P (ξ * x) < r := by
    intro r x
    simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and]
  have hrad : (1 + -(ρ₀ / ρ)) * ρ = ρ - ρ₀ := by
    rw [add_mul, one_mul, neg_mul, div_mul_cancel₀ _ hρ.ne']; ring
  have habs : |-(ρ₀ / ρ)| = ρ₀ / ρ := by rw [abs_neg, abs_of_pos (div_pos hρ₀ hρ)]
  have hle1 : 100 * (S.card : ℝ) * |-(ρ₀ / ρ)| ≤ 1 := by
    rw [habs, ← mul_div_assoc, div_le_one hρ]; exact hsmall
  have hregD := (hreg (-(ρ₀ / ρ)) hle1).1
  obtain ⟨B, hB⟩ : ∃ B : Finset (ZMod P), B = giBohr P S ρ := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D : Finset (ZMod P), D = giBohr P S ((1 + -(ρ₀ / ρ)) * ρ) := ⟨_, rfl⟩
  rw [habs, ← hD, ← hB] at hregD
  rw [← hB] at hκ
  have h0B : (0 : ZMod P) ∈ B := by
    rw [hB, hmem]
    intro ξ _
    rw [mul_zero, hcn0]; exact hρ
  have hBpos : (0 : ℝ) < (B.card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr ⟨0, h0B⟩
  rw [hmem] at hy
  have hDB : D ⊆ B := by
    intro x hx
    rw [hD, hmem, hrad] at hx
    rw [hB, hmem]
    intro ξ hξ
    have := hx ξ hξ
    linarith
  have hDy : ∀ x ∈ D, x + y ∈ B := by
    intro x hx
    rw [hD, hmem, hrad] at hx
    rw [hB, hmem]
    intro ξ hξ
    have h1 := hx ξ hξ
    have h2 := hy ξ hξ
    rw [mul_add]
    have := htri (ξ * x) (ξ * y)
    linarith
  
  obtain ⟨f, hf⟩ : ∃ f : ZMod P → ℂ, f = fun z => giE (((γ * z).val : ℝ) / P) := ⟨_, rfl⟩
  have hfn : ∀ z, ‖f z‖ = 1 := fun z => by rw [hf]; exact hnorm _
  obtain ⟨e, he⟩ : ∃ e : ℂ, e = giE (((γ * y).val : ℝ) / P) := ⟨_, rfl⟩
  have he1 : ‖e‖ = 1 := by rw [he]; exact hnorm _
  have hSig : ∑ x ∈ B, giE (((γ * x).val : ℝ) / P) = ∑ x ∈ B, f x := by simp only [hf]
  rw [hSig] at hκ
  have hfac : ∀ x, f x = f (x - y) * e := by
    intro x
    have h := hadd (γ * (x - y)) (γ * y)
    rw [show γ * (x - y) + γ * y = γ * x by ring] at h
    simp only [hf, he]
    exact h
  have hsum : ∑ x ∈ B, f x = (∑ x ∈ B, f (x - y)) * e := by
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl (fun x _ => hfac x)
  have hinj : Function.Injective (fun x : ZMod P => x - y) := sub_left_injective
  obtain ⟨T, hT⟩ : ∃ T : Finset (ZMod P), T = B.image (fun x => x - y) := ⟨_, rfl⟩
  have hTcard : T.card = B.card := by rw [hT]; exact Finset.card_image_of_injective _ hinj
  have hTsum : ∑ z ∈ T, f z = ∑ x ∈ B, f (x - y) := by
    rw [hT, Finset.sum_image (fun a _ b _ h => hinj h)]
  have hDT : D ⊆ T := by
    intro x hx
    rw [hT, Finset.mem_image]
    exact ⟨x + y, hDy x hx, by simp⟩
  have hsplitB := Finset.sum_sdiff hDB (f := f)
  have hsplitT := Finset.sum_sdiff hDT (f := f)
  have hdiff : ∑ x ∈ B, f x - ∑ x ∈ B, f (x - y)
      = ∑ x ∈ B \ D, f x - ∑ x ∈ T \ D, f x := by
    rw [← hTsum, ← hsplitB, ← hsplitT]; ring
  have hbound : ∀ U : Finset (ZMod P), ‖∑ x ∈ U, f x‖ ≤ U.card := by
    intro U
    refine (norm_sum_le _ _).trans ?_
    simp only [hfn, Finset.sum_const, nsmul_eq_mul, mul_one, le_refl]
  have hcardB : ((B \ D).card : ℝ) = B.card - D.card := by
    have h := Finset.card_sdiff_add_card_eq_card hDB
    have h' : ((B \ D).card : ℝ) + D.card = B.card := by exact_mod_cast h
    linarith
  have hcardT : ((T \ D).card : ℝ) = B.card - D.card := by
    have h := Finset.card_sdiff_add_card_eq_card hDT
    have h' : ((T \ D).card : ℝ) + D.card = T.card := by exact_mod_cast h
    rw [hTcard] at h'
    linarith
  have htrans : ‖∑ x ∈ B, f x - ∑ x ∈ B, f (x - y)‖ ≤ 2 * ((B.card : ℝ) - D.card) := by
    rw [hdiff]
    refine (norm_sub_le _ _).trans ?_
    have h1 := hbound (B \ D)
    have h2 := hbound (T \ D)
    rw [hcardB] at h1
    rw [hcardT] at h2
    linarith
  
  have hrel : ‖1 - e‖ * ‖∑ x ∈ B, f x‖ = ‖∑ x ∈ B, f x - ∑ x ∈ B, f (x - y)‖ := by
    rw [hsum, show (∑ x ∈ B, f (x - y)) * e - ∑ x ∈ B, f (x - y)
        = (∑ x ∈ B, f (x - y)) * (e - 1) by ring, norm_mul, norm_mul, he1, norm_sub_rev]
    ring
  have hc0 := hcn_nn (γ * y)
  have hch : 4 * giCircNorm P (γ * y) ≤ ‖1 - e‖ := by rw [he]; exact hchord (γ * y)
  have hA : 4 * giCircNorm P (γ * y) * (κ * B.card)
      ≤ 4 * giCircNorm P (γ * y) * ‖∑ x ∈ B, f x‖ :=
    mul_le_mul_of_nonneg_left hκ (by linarith)
  have hB' : 4 * giCircNorm P (γ * y) * ‖∑ x ∈ B, f x‖ ≤ ‖1 - e‖ * ‖∑ x ∈ B, f x‖ :=
    mul_le_mul_of_nonneg_right hch (norm_nonneg _)
  have hR : 50 * (S.card : ℝ) * ρ₀ / ρ = 50 * (S.card : ℝ) * (ρ₀ / ρ) := by ring
  rw [hR]
  have hfin : (κ * giCircNorm P (γ * y)) * (4 * B.card)
      ≤ (50 * (S.card : ℝ) * (ρ₀ / ρ)) * (4 * B.card) := by
    linarith
  have h4B : (0 : ℝ) < 4 * (B.card : ℝ) := by linarith
  exact le_of_mul_le_mul_right hfin h4B

theorem gi_local_chang : ∃ C : ℕ, 1 ≤ C ∧
    ∀ (P : ℕ) [NeZero P] (S X : Finset (ZMod P)) (ρ τ θ : ℝ),
      0 < ρ → ρ ≤ 1 / 4 → GiRegularBohr P S ρ → 0 < τ → τ ≤ 1 → 0 < θ → θ ≤ 1 →
      X ⊆ giBohr P S ρ → τ * ((giBohr P S ρ).card : ℝ) ≤ X.card →
      ∃ (Δ : Finset (ZMod P)) (ρ' : ℝ),
        (Δ.card : ℝ) ≤ C * (1 + Real.log (((S.card : ℝ) + 1) / (τ * θ))) ^ C ∧
        ρ * Real.exp (-(C * (1 + Real.log (((S.card : ℝ) + 1) / (τ * θ))) ^ C)) ≤ ρ' ∧
        ρ' ≤ ρ ∧
        ∀ ξ : ZMod P, (X.card : ℝ) ≤ 2 * ‖∑ x ∈ X, giE (((ξ * x).val : ℝ) / P)‖ →
          ∀ y ∈ giBohr P (S ∪ Δ) ρ', giCircNorm P (ξ * y) ≤ θ :=
by
  classical
  refine ⟨25, by norm_num, ?_⟩
  intro P _ S X ρ τ θ hρ hρ4 hreg hτ hτ1 hθ hθ1 hXB hXcard
  simp only [Nat.cast_ofNat]
  have hPpos : (0 : ℝ) < P := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne P)
  
  have hcn0 : giCircNorm P 0 = 0 := by
    simp only [giCircNorm, ZMod.val_zero, Nat.cast_zero, zero_div, sub_zero]
    exact min_eq_left zero_le_one
  have hcn_nn : ∀ a : ZMod P, 0 ≤ giCircNorm P a := by
    intro a
    have h1 : ((a.val : ℝ)) / P ≤ 1 := by
      rw [div_le_one hPpos]; exact_mod_cast (ZMod.val_lt a).le
    exact le_min (by positivity) (by linarith)
  have hcn_neg : ∀ a : ZMod P, giCircNorm P (-a) = giCircNorm P a := by
    intro a
    by_cases ha : a = 0
    · rw [ha, neg_zero]
    · unfold giCircNorm
      rw [ZMod.neg_val, if_neg ha, Nat.cast_sub (ZMod.val_lt a).le, sub_div, div_self hPpos.ne',
        sub_sub_cancel, min_comm]
  have hkey : ∀ u v w : ℝ, 0 ≤ u → u ≤ 1 → 0 ≤ v → v ≤ 1 → (w = u + v ∨ w = u + v - 1) →
      min w (1 - w) ≤ min u (1 - u) + min v (1 - v) := by
    intro u v w hu0 hu1 hv0 hv1 hw
    rcases hw with rfl | rfl <;>
    rcases min_cases u (1 - u) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
    rcases min_cases v (1 - v) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
    rw [h1, h2] <;>
    first
    | exact (min_le_left _ _).trans (by linarith)
    | exact (min_le_right _ _).trans (by linarith)
  have htri : ∀ a b : ZMod P, giCircNorm P (a + b) ≤ giCircNorm P a + giCircNorm P b := by
    intro a b
    have ha := ZMod.val_lt a
    have hb := ZMod.val_lt b
    have hval : ((a + b).val : ℝ) = a.val + b.val ∨ ((a + b).val : ℝ) = a.val + b.val - P := by
      rw [ZMod.val_add]
      by_cases h : a.val + b.val < P
      · left; rw [Nat.mod_eq_of_lt h]; push_cast; ring
      · right
        push_neg at h
        rw [Nat.mod_eq_sub_mod h, Nat.mod_eq_of_lt (by omega), Nat.cast_sub h]
        push_cast; ring
    unfold giCircNorm
    apply hkey
    · positivity
    · rw [div_le_one hPpos]; exact_mod_cast ha.le
    · positivity
    · rw [div_le_one hPpos]; exact_mod_cast hb.le
    · rcases hval with h | h
      · left; rw [h, add_div]
      · right; rw [h, sub_div, add_div, div_self hPpos.ne']
  have hsub : ∀ a b : ZMod P, giCircNorm P (a - b) ≤ giCircNorm P a + giCircNorm P b := by
    intro a b
    rw [sub_eq_add_neg]
    exact (htri a (-b)).trans (by rw [hcn_neg])
  
  have hspan : ∀ (Δ : Finset (ZMod P)) (ε : ZMod P → ℤ), (∀ δ, ε δ = -1 ∨ ε δ = 0 ∨ ε δ = 1) →
      ∀ y : ZMod P, giCircNorm P ((∑ δ ∈ Δ, (ε δ : ZMod P) * δ) * y)
        ≤ ∑ δ ∈ Δ, giCircNorm P (δ * y) := by
    intro Δ ε hε y
    refine Finset.induction_on Δ ?_ ?_
    · rw [Finset.sum_empty, Finset.sum_empty, zero_mul, hcn0]
    · intro a s ha ih
      rw [Finset.sum_insert ha, Finset.sum_insert ha, add_mul]
      refine (htri _ _).trans (add_le_add ?_ ih)
      rcases hε a with h | h | h
      · rw [h, Int.cast_neg, Int.cast_one, neg_one_mul, neg_mul, hcn_neg]
      · rw [h, Int.cast_zero, zero_mul, zero_mul, hcn0]; exact hcn_nn _
      · rw [h, Int.cast_one, one_mul]
  
  have h0B : (0 : ZMod P) ∈ giBohr P S ρ := by
    simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and]
    intro ξ _
    rw [mul_zero, hcn0]; exact hρ
  have hBpos : (0 : ℝ) < ((giBohr P S ρ).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr ⟨0, h0B⟩
  have hXpos : (0 : ℝ) < (X.card : ℝ) := lt_of_lt_of_le (mul_pos hτ hBpos) hXcard
  have hXne : X.Nonempty := Finset.card_pos.mp (by exact_mod_cast hXpos)
  
  obtain ⟨F, hF⟩ : ∃ F : ℕ, F = ⌊8 * Real.log (2 / τ)⌋₊ := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℕ, M = F + 1 := ⟨_, rfl⟩
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = (1 / 2 : ℝ) ^ M := ⟨_, rfl⟩
  have hκpos : 0 < κ := by rw [hκ]; positivity
  have hκ1 : κ ≤ 1 := by rw [hκ]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have h2κ : (2 : ℝ) ^ M * κ = 1 := by rw [hκ, ← mul_pow]; norm_num
  obtain ⟨Γ, hΓ⟩ : ∃ Γ : Finset (ZMod P), Γ = Finset.univ.filter
      (fun ξ : ZMod P => (X.card : ℝ) ≤ 2 * ‖∑ x ∈ X, giE (((ξ * x).val : ℝ) / P)‖) :=
    ⟨_, rfl⟩
  
  obtain ⟨D, hD⟩ : ∃ D : Finset (ZMod P) → Prop, ∀ Δ, D Δ ↔
      (∀ ε : ZMod P → ℤ, (∀ δ, ε δ = -1 ∨ ε δ = 0 ∨ ε δ = 1) → (∀ δ, δ ∉ Δ → ε δ = 0) →
        (∃ δ ∈ Δ, ε δ ≠ 0) →
        ‖∑ x ∈ giBohr P S ρ, giE ((((∑ δ ∈ Δ, (ε δ : ZMod P) * δ) * x).val : ℝ) / P)‖
          ≤ κ * (giBohr P S ρ).card) := ⟨_, fun _ => Iff.rfl⟩
  obtain ⟨Fam, hFam⟩ : ∃ Fam : Finset (Finset (ZMod P)),
      Fam = Γ.powerset.filter (fun Δ => Δ.card ≤ M ∧ D Δ) := ⟨_, rfl⟩
  have h0Fam : (∅ : Finset (ZMod P)) ∈ Fam := by
    rw [hFam, Finset.mem_filter]
    refine ⟨Finset.empty_mem_powerset Γ, by simp, ?_⟩
    rw [hD]
    intro ε _ _ hex
    obtain ⟨δ, hδ, _⟩ := hex
    exact absurd hδ (Finset.notMem_empty δ)
  obtain ⟨Δ, hΔFam, hΔmax⟩ := Finset.exists_max_image Fam Finset.card ⟨∅, h0Fam⟩
  have hΔmem := hΔFam
  rw [hFam, Finset.mem_filter, Finset.mem_powerset] at hΔmem
