    refine ⟨0, G, kaiMFConeAlpha K, kaiMFConeBeta K t l η, Ca,
      Nat.zero_le 1, ⟨fun h => absurd h (by norm_num), fun h => absurd h hP⟩,
      hGdiff, ?_, halpha, hbeta, hCa0', hGstrip, ?_⟩
