    have h3 : c₂' * T' * Real.exp (-Real.sqrt (Real.log T') / c₂') ≤ c₂' * T' := by
      have := mul_le_mul_of_nonneg_left hexp1 (mul_nonneg hc₂'.le (by linarith : (0:ℝ) ≤ T'))
      linarith
    have hG : T' - ε' * (T' ^ β' / β') ≤ 3 * T' := by
      rcases hεβ' with h0 | ⟨hβ1, hβ2⟩
      · rw [h0]; linarith
      · have hβpos : 0 < β' := by linarith
        have hTb0 : 0 ≤ T' ^ β' := Real.rpow_nonneg (by linarith) _
        have hTbT : T' ^ β' ≤ T' := by
