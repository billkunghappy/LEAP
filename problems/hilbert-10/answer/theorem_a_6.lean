theorem gi_almost_period_average (P : ℕ) [NeZero P] (F : ZMod P → ℝ) (A X : Finset (ZMod P))
    (q k : ℕ) (E : ℝ) (hA : A.Nonempty) (hX : X.Nonempty) (hq : 1 ≤ q) (hE : 0 ≤ E)
    (hCS : ∀ t₁ ∈ X, ∀ t₂ ∈ X, ∑ z : ZMod P, |F (z + (t₁ - t₂)) - F z| ^ (2 * q) ≤ E)
    (u : ZMod P) :
    |(∑ a ∈ A, F (a + u)) / A.card
      - (∑ v ∈ Fintype.piFinset (fun _ : Fin k => X), ∑ v' ∈ Fintype.piFinset (fun _ : Fin k => X),
          (∑ a ∈ A, F (a + (u + ∑ i, (v i - v' i)))) / A.card) / (X.card : ℝ) ^ (2 * k)|
      ≤ k * (E / A.card) ^ ((1 : ℝ) / (2 * q)) :=
by
  classical
  have hn : (0 : ℝ) < A.card := by exact_mod_cast Finset.card_pos.mpr hA
  
  have s1 : ∀ t₁ ∈ X, ∀ t₂ ∈ X, ∀ s : ZMod P,
      |(∑ a ∈ A, F (a + (s + (t₁ - t₂)))) / A.card - (∑ a ∈ A, F (a + s)) / A.card|
        ≤ (E / A.card) ^ ((1 : ℝ) / (2 * q)) := by
    intro t₁ ht₁ t₂ ht₂ s
    have ht := hCS t₁ ht₁ t₂ ht₂
    generalize t₁ - t₂ = t at ht ⊢
    have hlhs : (∑ a ∈ A, F (a + (s + t))) / A.card - (∑ a ∈ A, F (a + s)) / A.card
        = (∑ a ∈ A, (F (a + (s + t)) - F (a + s))) / A.card := by
      rw [← sub_div, ← Finset.sum_sub_distrib]
    rw [hlhs]
    generalize hx : (∑ a ∈ A, (F (a + (s + t)) - F (a + s))) / (A.card : ℝ) = x
    have hxm : x = ∑ a ∈ A, (1 / (A.card : ℝ)) * (F (a + (s + t)) - F (a + s)) := by
      rw [← hx, ← Finset.mul_sum]; ring
    have hw1 : ∑ a ∈ A, (fun _ => 1 / (A.card : ℝ)) a = 1 := by
      rw [Finset.sum_const, nsmul_eq_mul]; field_simp
    have hpm := Real.pow_arith_mean_le_arith_mean_pow_of_even A (fun _ => 1 / (A.card : ℝ))
      (fun a => F (a + (s + t)) - F (a + s)) (fun _ _ => by positivity) hw1 (even_two_mul q)
    simp only at hpm
    rw [← hxm, ← Finset.mul_sum] at hpm
    have hsum : ∑ a ∈ A, (F (a + (s + t)) - F (a + s)) ^ (2 * q) ≤ E := by
      calc ∑ a ∈ A, (F (a + (s + t)) - F (a + s)) ^ (2 * q)
          = ∑ a ∈ A, |F ((a + s) + t) - F (a + s)| ^ (2 * q) := by
            refine Finset.sum_congr rfl (fun a _ => ?_)
            rw [Even.pow_abs (even_two_mul q), add_assoc]
        _ ≤ ∑ a : ZMod P, |F ((a + s) + t) - F (a + s)| ^ (2 * q) :=
            Finset.sum_le_univ_sum_of_nonneg (fun a => by positivity)
        _ = ∑ z : ZMod P, |F (z + t) - F z| ^ (2 * q) :=
            Equiv.sum_comp (Equiv.addRight s) (fun z => |F (z + t) - F z| ^ (2 * q))
        _ ≤ E := ht
    have hxE : x ^ (2 * q) ≤ E / A.card := by
      calc x ^ (2 * q) ≤ 1 / (A.card : ℝ) * ∑ a ∈ A, (F (a + (s + t)) - F (a + s)) ^ (2 * q) := hpm
        _ ≤ 1 / (A.card : ℝ) * E := mul_le_mul_of_nonneg_left hsum (by positivity)
        _ = E / A.card := by ring
    have hm : (2 * q) ≠ 0 := by omega
    have habs : |x| = (|x| ^ (2 * q)) ^ (((2 * q : ℕ) : ℝ)⁻¹) :=
      (Real.pow_rpow_inv_natCast (abs_nonneg x) hm).symm
    rw [habs, Even.pow_abs (even_two_mul q)]
    have hexp : ((1 : ℝ) / (2 * q)) = (((2 * q : ℕ) : ℝ)⁻¹) := by push_cast; ring
    rw [hexp]
    exact Real.rpow_le_rpow (Even.pow_nonneg (even_two_mul q) x) hxE (by positivity)
  
  have s2 : ∀ (Φ : ZMod P → ℝ) (δ : ℝ) (m : ℕ) (w : Fin m → ZMod P),
      (∀ s i, |Φ (s + w i) - Φ s| ≤ δ) → ∀ u, |Φ (u + ∑ i, w i) - Φ u| ≤ m * δ := by
    intro Φ δ m
    induction m with
    | zero => intro w _ u; simp
    | succ m ih =>
      intro w h u
      rw [Fin.sum_univ_castSucc, ← add_assoc]
      have h1 := h (u + ∑ i : Fin m, w i.castSucc) (Fin.last m)
      have h2 := ih (fun i => w i.castSucc) (fun s i => h s i.castSucc) u
      have e : Φ (u + ∑ i : Fin m, w i.castSucc + w (Fin.last m)) - Φ u
          = (Φ (u + ∑ i : Fin m, w i.castSucc + w (Fin.last m))
              - Φ (u + ∑ i : Fin m, w i.castSucc))
            + (Φ (u + ∑ i : Fin m, w i.castSucc) - Φ u) := by ring
      rw [e]
      push_cast
