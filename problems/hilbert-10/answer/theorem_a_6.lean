theorem kai_hecke_zero_free_nonreal (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hL : KaiZFLandauExpProp) (hcont : KaiZFZetaContProp K)
    (hser : KaiZFSeriesBasicsProp K) (hpos : KaiZFCharPositivityProp K)
    (hgen : KaiZFGenCharProp K) :
    ∃ B : ℝ, 0 < B ∧ B ≤ 1 ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (t : NumberField.InfinitePlace K → ℝ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q t l ξ η lam →
        (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
        ¬ (∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
        ∀ G : ℂ → ℂ, Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s) →
          ∀ s : ℂ, s.re ≤ 2 →
            1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
              * (2 + |s.im|)) ≤ s.re →
            G s ≠ 0 :=
by
  classical
  obtain ⟨CL, hCL0, hLan⟩ := hL
  obtain ⟨A₀, hA₀0, hZC⟩ := hcont
  have hlog7pos : (0:ℝ) < Real.log 7 := Real.log_pos (by norm_num)
  have hlog7gt1 : (1:ℝ) < Real.log 7 := by
    have h := Real.exp_one_lt_d9
    have h2 : Real.log (Real.exp 1) < Real.log 7 :=
      Real.log_lt_log (Real.exp_pos 1) (by linarith)
    rwa [Real.log_exp] at h2
  obtain ⟨nK, hnK⟩ : ∃ m : ℕ, m = Module.finrank ℚ K := ⟨_, rfl⟩
  have hnK0 : (0:ℝ) ≤ (nK:ℝ) := Nat.cast_nonneg _
  obtain ⟨A₁, hA₁def⟩ : ∃ x : ℝ, x = A₀ + |Real.log A₀| + 1 := ⟨_, rfl⟩
  have hA₁1 : (1:ℝ) ≤ A₁ := by
    rw [hA₁def]; have := abs_nonneg (Real.log A₀); linarith
  obtain ⟨T, hTdef⟩ : ∃ x : ℝ,
      x = CL * (2*A₁ + (nK:ℝ) + 3 + ((nK:ℝ)+1)/Real.log 7) + 1 := ⟨_, rfl⟩
  have hT1 : (1:ℝ) ≤ T := by
    rw [hTdef]
    have h1 : (0:ℝ) ≤ ((nK:ℝ)+1)/Real.log 7 := by positivity
    nlinarith [hCL0]
  have hT0 : (0:ℝ) < T := by linarith
  have hinv1 : (0:ℝ) < 1/(80*T) := div_pos one_pos (by linarith)
  obtain ⟨c, hcdef⟩ : ∃ x : ℝ, x = min (1/2560) ((1/(80*T))^2) := ⟨_, rfl⟩
  have hc0 : (0:ℝ) < c := by
    rw [hcdef]; exact lt_min (by norm_num) (pow_pos hinv1 2)
  have hcne : c ≠ 0 := ne_of_gt hc0
  have hcle : c ≤ 1/2560 := by rw [hcdef]; exact min_le_left _ _
  have hcT1 : c ≤ (1/(80*T))^2 := by rw [hcdef]; exact min_le_right _ _
  have hc1 : c ≤ 1 := by linarith
  have hsc0 : (0:ℝ) < Real.sqrt c := Real.sqrt_pos.mpr hc0
  have hss : Real.sqrt c * Real.sqrt c = c := Real.mul_self_sqrt hc0.le
