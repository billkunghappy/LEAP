                  + ((n : ℤ) + 2) := by
          intro n N hN
          subst hN
          rw [Finset.sum_range_succ]
          have h1 : ∀ k ∈ Finset.range (n + 1),
              ((k : ℤ) + 1) * (-1 : ℤ) ^ (n + 1 - k)
                = -(((k : ℤ) + 1) * (-1 : ℤ) ^ (n - k)) := by
            intro k hk
            rw [Finset.mem_range] at hk
            have hs : n + 1 - k = (n - k) + 1 := by omega
            rw [hs, pow_succ]; ring
          rw [Finset.sum_congr rfl h1, Finset.sum_neg_distrib]
          have h2 : n + 1 - (n + 1) = 0 := by omega
          rw [h2]
          push_cast
          ring
        have hTrec : ∀ n N : ℕ, N = n + 1 →
            (∑ k ∈ Finset.range (N + 1),
                ((k : ℤ) + 1) * (-1 : ℤ) ^ (N - k) * (((N - k : ℕ) : ℤ) + 1))
