    obtain ⟨P, hPdef⟩ : ∃ P : ℝ, P = Cq * (Ideal.absNorm q : ℝ) ^ Cq := ⟨_, rfl⟩
    have hone : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) ^ Cq := by
      have h := Real.rpow_le_rpow (by norm_num) hNQ1 hCq0.le
      rwa [Real.one_rpow] at h
    have hP1 : (1 : ℝ) ≤ P := by rw [hPdef]; exact one_le_mul_of_one_le_of_one_le hCq1 hone
    have hP0 : (0 : ℝ) < P := by linarith
    have hcellbd : ∀ k : Fin M, ‖Gc k s‖ ≤ A * (P * X) ^ A * Z₀ := by
      intro k
