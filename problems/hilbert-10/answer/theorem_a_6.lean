      0 < δ ^ 2 / 2 ^ (ν + 1) ∧ δ ^ 2 / 2 ^ (ν + 1) ≤ 1 ∧
      0 ≤ 2 ^ ν / (δ ^ 2 * ((2 * N + 1 : ℕ) : ℝ)) ∧
      2 ^ ν / (δ ^ 2 * ((2 * N + 1 : ℕ) : ℝ)) ≤ (δ ^ 2 / 2 ^ (ν + 1)) / 32 ∧
      32 ≤ (δ ^ 2 / 2 ^ (ν + 1)) ^ 2 * (4 * (N : ℝ) + 1) ∧
      (δ ^ 2 / 2 ^ (ν + 1)) * (4 * (N : ℝ) + 1) ^ ν
        ≤ δ ^ 2 * (((2 * N + 1 : ℕ) : ℝ) ^ ν) / 2 ∧
      8 * (2 ^ ν / (δ ^ 2 * ((2 * N + 1 : ℕ) : ℝ)))
          / ((δ ^ 2 / 2 ^ (ν + 1)) ^ 2 * (4 * (N : ℝ) + 1)) / 2
        ≤ (2 ^ (3 * ν + 1) / δ ^ 6) / (N : ℝ) ^ 2 ∧
      ∀ q₀ : ℝ, 1 ≤ q₀ → q₀ ≤ (2 / (δ ^ 2 / 2 ^ (ν + 1))) ^ (ν * ν) →
        5 * (2 * q₀) * (1 + 7 * (2 * (ν : ℝ) + 1) * (2 ^ (3 * ν + 1) / δ ^ 6))
            ≤ 4 * δ * (N : ℝ) ∧
        2 * q₀ ≤ ((5 * 2 ^ (2 * ν + 7) * (2 ^ (ν + 2)) ^ (ν * ν)
          * (1 + 7 * (2 * (ν : ℝ) + 1) * 2 ^ (3 * ν + 1))) / δ) ^ (4 * ν * ν + 14) ∧
        2 * q₀ * (2 ^ (3 * ν + 1) / δ ^ 6) ≤ ((5 * 2 ^ (2 * ν + 7) * (2 ^ (ν + 2)) ^ (ν * ν)
          * (1 + 7 * (2 * (ν : ℝ) + 1) * 2 ^ (3 * ν + 1))) / δ) ^ (4 * ν * ν + 14) ∧
        2 * q₀ * (1 + 7 * (2 * (ν : ℝ) + 1) * (2 ^ (3 * ν + 1) / δ ^ 6)) / (2 * δ)
