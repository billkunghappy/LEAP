theorem kai_quad_typeI_flat (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ (CF : ℝ) (AF : ℕ), 1 ≤ CF ∧ 1 ≤ AF ∧
      ∀ (M θ : ℝ) (D : ℕ) (c : Ideal (NumberField.RingOfIntegers K) → ℝ)
        (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)),
        1 ≤ M → 0 < θ → θ ≤ 1 → 1 ≤ D → (∀ I, |c I| ≤ 1) → Convex ℝ Ω →
        CF * ((D : ℝ) / θ) ^ AF ≤ (⌊M⌋₊ : ℝ) →
      ∀ (p₀ : ℝ) (p₁ : Fin (Module.finrank ℚ K) → ℝ)
        (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
        θ * ((omegaBox ω M).card : ℝ) ≤
          ‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω)
                (fun _ => Classical.propDecidable _) (omegaBox ω M),
              ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
                ((@ite ℝ (x ∈ I) (Classical.propDecidable _) (c I) 0 : ℝ) : ℂ)
                  * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ →
        ∃ q : ℕ, (q : ℝ) ≤ CF * ((D : ℝ) / θ) ^ AF ∧
          KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q (CF * ((D : ℝ) / θ) ^ AF)
            (kaiQuadPoly p₀ p₁ p₂) :=
by
  obtain ⟨Cd, hCd1, hCd⟩ := kai_ideal_count_divisor_moment K
  obtain ⟨Cs, As, hCs1, hAs1, hPW⟩ := kai_quad_periodic_weyl (Module.finrank ℚ K)
  have hCdA : 1 ≤ (2 * Cd) ^ As := one_le_pow₀ (by linarith)
  refine ⟨2 * Cs * (2 * Cd) ^ As, 2 * As, by nlinarith, by omega, ?_⟩
  intro M θ D c Ω hM hθ hθ1 hD hc hΩ hthr p₀ p₁ p₂ hyp
  classical
  
  have hn1 : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hD1 : (1 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hD
  have hx₀ : 1 ≤ (D : ℝ) / θ := (one_le_div hθ).mpr (by linarith)
  have hx₀AF : (D : ℝ) / θ ≤ ((D : ℝ) / θ) ^ (2 * As) := le_self_pow₀ hx₀ (by omega)
  have hCF2 : 2 ≤ 2 * Cs * (2 * Cd) ^ As := by nlinarith
  have hNx : 2 * ((D : ℝ) / θ) ≤ (⌊M⌋₊ : ℝ) := by
    refine le_trans ?_ hthr
    have h0 : 0 ≤ ((D : ℝ) / θ) := by linarith
    nlinarith
  have hθN : 2 ≤ θ * (⌊M⌋₊ : ℝ) := by
    have h1 : θ * (2 * ((D : ℝ) / θ)) = 2 * D := by field_simp
    have h2 := mul_le_mul_of_nonneg_left hNx hθ.le
    linarith
  have hgiE : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t
    unfold giE
    rw [show (2 * (Real.pi : ℂ) * Complex.I * (t : ℂ)) = ((2 * Real.pi * t : ℝ) : ℂ) * Complex.I by
      push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  
  have hcardB : ((omegaBox ω M).card : ℝ)
      = (((2 * ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ Module.finrank ℚ K) := by
    have h1 : (omegaBox ω M).card = (intBox (Module.finrank ℚ K) ⌊M⌋₊).card := by
      unfold omegaBox
      exact Finset.card_image_of_injective _ ω.equivFun.symm.injective
    have h2 : (intBox (Module.finrank ℚ K) ⌊M⌋₊).card
        = (2 * ⌊M⌋₊ + 1) ^ Module.finrank ℚ K := by
      unfold intBox
      rw [Pi.card_Icc]
      simp only [Int.card_Icc]
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      congr 1
      omega
    rw [h1, h2]; push_cast; ring
  have hBN : (⌊M⌋₊ : ℝ) ≤ ((omegaBox ω M).card : ℝ) := by
    rw [hcardB]
    have h1 : (1 : ℝ) ≤ ((2 * ⌊M⌋₊ + 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : 1 ≤ 2 * ⌊M⌋₊ + 1)
    calc (⌊M⌋₊ : ℝ) ≤ ((2 * ⌊M⌋₊ + 1 : ℕ) : ℝ) := by
          push_cast; linarith [(Nat.cast_nonneg ⌊M⌋₊ : (0 : ℝ) ≤ _)]
      _ ≤ _ := le_self_pow₀ h1 (by omega)
  have hθB2 : 2 ≤ θ * ((omegaBox ω M).card : ℝ) :=
    hθN.trans (mul_le_mul_of_nonneg_left hBN hθ.le)
  
  obtain ⟨G, hG⟩ : ∃ G : Ideal (NumberField.RingOfIntegers K) → ℂ, ∀ I, G I =
      ∑ z ∈ intBox (Module.finrank ℚ K) ⌊M⌋₊,
        @ite ℂ ((fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ ω.equivFun.symm z ∈ I)
          (Classical.propDecidable _) (giE (kaiQuadPoly p₀ p₁ p₂ z)) 0 :=
    ⟨fun I => _, fun I => rfl⟩
  have hswap : (∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω)
                (fun _ => Classical.propDecidable _) (omegaBox ω M),
              ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
                ((@ite ℝ (x ∈ I) (Classical.propDecidable _) (c I) 0 : ℝ) : ℂ)
                  * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)))
      = ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
          ((c I : ℝ) : ℂ) * G I := by
    rw [Finset.sum_filter]
    unfold omegaBox
    rw [Finset.sum_image (fun a _ b _ h => ω.equivFun.symm.injective h)]
    simp only [LinearEquiv.apply_symm_apply, hG, Finset.mul_sum]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun z _ => ?_)
    by_cases h1 : (fun j => ((z j : ℤ) : ℝ)) ∈ Ω
    · rw [if_pos h1]
      refine Finset.sum_congr rfl (fun I _ => ?_)
      by_cases h2 : ω.equivFun.symm z ∈ I
      · rw [if_pos h2, if_pos ⟨h1, h2⟩]
      · rw [if_neg h2, if_neg (fun h => h2 h.2)]; simp
    · rw [if_neg h1]
      symm
      apply Finset.sum_eq_zero
      intro I _
      rw [if_neg (fun h => h1 h.1), mul_zero]
  rw [hswap] at hyp
  obtain ⟨F, hF⟩ : ∃ F : Finset (Ideal (NumberField.RingOfIntegers K)),
      F = (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset :=
    ⟨_, rfl⟩
  rw [← hF] at hyp
  have hle1 : ‖∑ I ∈ F, ((c I : ℝ) : ℂ) * G I‖ ≤ ∑ I ∈ F, ‖G I‖ := by
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun I _ => ?_))
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_of_le_one_left (norm_nonneg _) (hc I)
  have hbotF : (⊥ : Ideal (NumberField.RingOfIntegers K)) ∈ F := by
    rw [hF, Set.Finite.mem_toFinset]
    show Ideal.absNorm (⊥ : Ideal (NumberField.RingOfIntegers K)) ≤ D
    rw [Ideal.absNorm_bot]; exact Nat.zero_le _
  have hGbot : ‖G ⊥‖ ≤ 1 := by
    rw [hG]
    refine (norm_sum_le _ _).trans ((Finset.sum_le_sum
      (g := fun z => if z = 0 then (1 : ℝ) else 0) (fun z _ => ?_)).trans ?_)
    · by_cases hz : z = 0
      · simp only [if_pos hz]
        split_ifs
        · rw [hgiE]
        · simp
      · simp only [if_neg hz]
        rw [if_neg, norm_zero]
        rintro ⟨_, h2⟩
        rw [Ideal.mem_bot] at h2
        exact hz (ω.equivFun.symm.injective (by rw [h2, map_zero]))
    · rw [Finset.sum_ite_eq']
      split_ifs <;> norm_num
  have hsplitF : ∑ I ∈ F, ‖G I‖ = ‖G ⊥‖ + ∑ I ∈ F.erase ⊥, ‖G I‖ :=
    (Finset.add_sum_erase F _ hbotF).symm
  have hsumF' : θ * ((omegaBox ω M).card : ℝ) / 2 ≤ ∑ I ∈ F.erase ⊥, ‖G I‖ := by
    have := hyp.trans hle1
    rw [hsplitF] at this
    linarith
  have hne : (F.erase ⊥).Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro h
    rw [h, Finset.sum_empty] at hsumF'
    linarith
  have hcardF' : ((F.erase ⊥).card : ℝ) ≤ Cd * D := by
    have h1 : (F.erase ⊥).card ≤ F.card := Finset.card_erase_le
    have h2 := (hCd D hD).1
    rw [← hF] at h2
    exact (Nat.cast_le.mpr h1).trans h2
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = θ / (2 * Cd * D) := ⟨_, rfl⟩
  have hCdD : 0 < 2 * Cd * (D : ℝ) := by positivity
  have hδpos : 0 < δ := by rw [hδ]; exact div_pos hθ hCdD
  have hδ1 : δ ≤ 1 := by rw [hδ, div_le_one hCdD]; nlinarith
  have hconst : ∑ I ∈ F.erase ⊥, δ * ((omegaBox ω M).card : ℝ) ≤ ∑ I ∈ F.erase ⊥, ‖G I‖ := by
    rw [Finset.sum_const, nsmul_eq_mul]
    have hB0 : 0 ≤ δ * ((omegaBox ω M).card : ℝ) := mul_nonneg hδpos.le (Nat.cast_nonneg _)
    calc ((F.erase ⊥).card : ℝ) * (δ * ((omegaBox ω M).card : ℝ))
        ≤ (Cd * D) * (δ * ((omegaBox ω M).card : ℝ)) := mul_le_mul_of_nonneg_right hcardF' hB0
      _ = θ * ((omegaBox ω M).card : ℝ) / 2 := by rw [hδ]; field_simp
      _ ≤ _ := hsumF'
  obtain ⟨I, hIF', hI⟩ := Finset.exists_le_of_sum_le hne hconst
  have hIbot : I ≠ ⊥ := Finset.ne_of_mem_erase hIF'
  have hIF : I ∈ F := Finset.mem_of_mem_erase hIF'
  have hID : Ideal.absNorm I ≤ D := by
    rw [hF, Set.Finite.mem_toFinset] at hIF; exact hIF
  have hL1 : 1 ≤ Ideal.absNorm I :=
    Nat.one_le_iff_ne_zero.mpr (fun h => hIbot (Ideal.absNorm_eq_zero_iff.mp h))
  
  have hper : ∀ z w : Fin (Module.finrank ℚ K) → ℤ,
      (∀ l, z l ≡ w l [ZMOD ((Ideal.absNorm I : ℕ) : ℤ)]) →
      (ω.equivFun.symm z ∈ I ↔ ω.equivFun.symm w ∈ I) := by
    intro z w hzw
    obtain ⟨u, hu⟩ : ∃ u : Fin (Module.finrank ℚ K) → ℤ,
        w = z + ((Ideal.absNorm I : ℕ) : ℤ) • u := by
      refine ⟨fun l => (w l - z l) / ((Ideal.absNorm I : ℕ) : ℤ), ?_⟩
      funext l
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      rw [Int.mul_ediv_cancel' (hzw l).dvd]; ring
    have hmem : ((Ideal.absNorm I : ℕ) : ℤ) • ω.equivFun.symm u ∈ I := by
      rw [zsmul_eq_mul, Int.cast_natCast]
      exact Ideal.mul_mem_right _ I (Ideal.absNorm_mem I)
    rw [hu, map_add, map_zsmul, Ideal.add_mem_iff_left I hmem]
  
  have hbig : δ * (((2 * ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ Module.finrank ℚ K) ≤
      ‖∑ z ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
            (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ ω.equivFun.symm z ∈ I)
            (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) ⌊M⌋₊),
          giE (kaiQuadPoly p₀ p₁ p₂ z)‖ := by
    rw [Finset.sum_filter, ← hG, ← hcardB]
    exact hI
  
  have hLD : ((Ideal.absNorm I : ℕ) : ℝ) ≤ D := by exact_mod_cast hID
  have hL0 : (0 : ℝ) ≤ ((Ideal.absNorm I : ℕ) : ℝ) := Nat.cast_nonneg _
  have hLδ : ((Ideal.absNorm I : ℕ) : ℝ) / δ ≤ 2 * Cd * ((D : ℝ) / θ) ^ 2 := by
    have hθinv : 1 ≤ 1 / θ := by rw [le_div_iff₀ hθ]; linarith
    calc ((Ideal.absNorm I : ℕ) : ℝ) / δ
        = 2 * Cd * D * ((Ideal.absNorm I : ℕ) : ℝ) / θ := by rw [hδ]; field_simp
      _ ≤ 2 * Cd * D * D / θ := by gcongr
      _ ≤ 2 * Cd * D * D / θ * (1 / θ) := le_mul_of_one_le_right (by positivity) hθinv
      _ = 2 * Cd * ((D : ℝ) / θ) ^ 2 := by field_simp
  have hpowle : (((Ideal.absNorm I : ℕ) : ℝ) / δ) ^ As
      ≤ (2 * Cd) ^ As * ((D : ℝ) / θ) ^ (2 * As) := by
    calc (((Ideal.absNorm I : ℕ) : ℝ) / δ) ^ As ≤ (2 * Cd * ((D : ℝ) / θ) ^ 2) ^ As :=
          pow_le_pow_left₀ (div_nonneg hL0 hδpos.le) hLδ As
      _ = (2 * Cd) ^ As * ((D : ℝ) / θ) ^ (2 * As) := by rw [mul_pow, ← pow_mul]
  have hT0 : Cs * (((Ideal.absNorm I : ℕ) : ℝ) / δ) ^ As
      ≤ 2 * Cs * (2 * Cd) ^ As * ((D : ℝ) / θ) ^ (2 * As) := by
    have h0 : 0 ≤ Cs * ((2 * Cd) ^ As * ((D : ℝ) / θ) ^ (2 * As)) :=
      mul_nonneg (by linarith) (mul_nonneg (by linarith) (pow_nonneg (by linarith) _))
    calc Cs * (((Ideal.absNorm I : ℕ) : ℝ) / δ) ^ As
        ≤ Cs * ((2 * Cd) ^ As * ((D : ℝ) / θ) ^ (2 * As)) :=
          mul_le_mul_of_nonneg_left hpowle (by linarith)
      _ ≤ 2 * Cs * (2 * Cd) ^ As * ((D : ℝ) / θ) ^ (2 * As) := by nlinarith
  
  obtain ⟨q, hq, hmaj⟩ := hPW ⌊M⌋₊ (Ideal.absNorm I) δ hL1 hδpos hδ1 (hT0.trans hthr) Ω hΩ
    (fun z => ω.equivFun.symm z ∈ I) hper p₀ p₁ p₂ hbig
  refine ⟨q, hq.trans hT0, ?_⟩
  obtain ⟨hq1, γ', b, a, η', θ', h1, h2, h3⟩ := hmaj
  refine ⟨hq1, γ', b, a, η', θ', fun l => (h1 l).trans ?_, fun l l' => (h2 l l').trans ?_, h3⟩
  · exact div_le_div_of_nonneg_right hT0 (by positivity)
  · exact div_le_div_of_nonneg_right hT0 (by positivity)

theorem kai_quad_typeI_inverse (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ (CI : ℝ) (AI : ℕ), 1 ≤ CI ∧ 1 ≤ AI ∧
      ∀ (M θ Γ : ℝ) (D : ℕ) (α γ : Ideal (NumberField.RingOfIntegers K) → ℝ),
        3 ≤ M → 0 < θ → θ ≤ 1 → 1 ≤ Γ → 1 ≤ D →
        (∀ I, |α I| ≤ 1) → (∀ I, |γ I| ≤ Γ) →
      ∀ (p₀ : ℝ) (p₁ : Fin (Module.finrank ℚ K) → ℝ)
        (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
        θ * ((omegaBox ω M).card : ℝ) ≤
          ‖∑ x ∈ omegaBox ω M,
              ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
                ((@ite ℝ (x ∈ I) (Classical.propDecidable _)
                    (α I * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) + γ I) 0 : ℝ) : ℂ)
                  * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ →
        ∃ q : ℕ, (q : ℝ) ≤ (CI * D * Γ * Real.log M / θ) ^ AI ∧
          KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q
            ((CI * D * Γ * Real.log M / θ) ^ AI) (kaiQuadPoly p₀ p₁ p₂) :=
by
  obtain ⟨Cd, hCd1, hCd⟩ := kai_ideal_count_divisor_moment K
  obtain ⟨CL, AL, hCL, hAL, hLW⟩ := kai_log_weight_removal K C ω hω
  obtain ⟨CF, AF, hCF, hAF, hFL⟩ := kai_quad_typeI_flat K ω
  have hc4 : (4 : ℝ) ≤ 4 * CL * Cd := by nlinarith
  refine ⟨CF * (4 * CL * Cd), 2 * ((AL + 2) * AF), ?_, ?_, ?_⟩
  · nlinarith
  · have : 1 ≤ (AL + 2) * AF := Nat.one_le_iff_ne_zero.mpr (by positivity)
    omega
  intro M θ Γ D α γ hM hθ hθ1 hΓ hD hα hγ p₀ p₁ p₂ hhyp
  
  have hMpos : (0 : ℝ) < M := by linarith
  have hℓ1 : 1 ≤ Real.log M := by
    have h := (Real.lt_log_iff_exp_lt hMpos).2 (by have := Real.exp_one_lt_d9; linarith)
    linarith
  have hD1 : (1 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hD
  have hDθ1 : 1 ≤ (D : ℝ) / θ := (one_le_div hθ).mpr (by linarith)
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = (D : ℝ) * Γ * Real.log M / θ := ⟨_, rfl⟩
  have hW' : W = Γ * ((D : ℝ) / θ) * Real.log M := by rw [hW]; ring
  have hΓDθ : 1 ≤ Γ * ((D : ℝ) / θ) := one_le_mul_of_one_le_of_one_le hΓ hDθ1
  have hW1 : 1 ≤ W := by rw [hW']; exact one_le_mul_of_one_le_of_one_le hΓDθ hℓ1
  have hΓDθW : Γ * ((D : ℝ) / θ) ≤ W := by
    rw [hW']; exact le_mul_of_one_le_right (by linarith) hℓ1
  have hDθΓ : (D : ℝ) / θ ≤ Γ * ((D : ℝ) / θ) := le_mul_of_one_le_left (by linarith) hΓ
  have hDθW : (D : ℝ) / θ ≤ W := hDθΓ.trans hΓDθW
  have hDθℓW : (D : ℝ) / θ * Real.log M ≤ W := by
    rw [hW']; exact mul_le_mul_of_nonneg_right hDθΓ (by linarith)
  obtain ⟨V, hV⟩ : ∃ V : ℝ, V = 4 * CL * Cd * W := ⟨_, rfl⟩
  have hV1 : 1 ≤ V := by rw [hV]; nlinarith
  have hV0 : 0 ≤ V := by linarith
  have h2WV : 2 * W ≤ V := by rw [hV]; nlinarith
  have hCdWV : 2 * Cd * W ≤ V := by
    rw [hV]
    have h1 : 2 * Cd * W * 1 ≤ 2 * Cd * W * (2 * CL) :=
      mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    nlinarith
  have hCLV : CL ≤ V := by
    rw [hV]
    have h1 : CL * 1 ≤ CL * (4 * Cd * W) :=
      mul_le_mul_of_nonneg_left (by nlinarith) (by linarith)
    nlinarith
  obtain ⟨E, hE⟩ : ∃ E : ℕ, E = (AL + 2) * AF := ⟨_, rfl⟩
  have hEAF : AF ≤ E := by rw [hE]; nlinarith
  have hEAL : AL + 2 ≤ E := by rw [hE]; nlinarith
  obtain ⟨R₀, hR₀⟩ : ∃ R₀ : ℝ, R₀ = CF * V ^ E := ⟨_, rfl⟩
  have hVE1 : 1 ≤ V ^ E := one_le_pow₀ hV1
  have hR₀1 : 1 ≤ R₀ := by rw [hR₀]; exact one_le_mul_of_one_le_of_one_le hCF hVE1
  have hTeq : CF * (4 * CL * Cd) * (D : ℝ) * Γ * Real.log M / θ = CF * V := by
    rw [hV, hW]; ring
  rw [hTeq]
  have hR₀T : R₀ ^ 2 ≤ (CF * V) ^ (2 * ((AL + 2) * AF)) := by
    rw [← hE, hR₀, mul_pow, mul_pow, ← pow_mul, mul_comm E 2]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hCF (by omega)) (by positivity)
  have hR₀T' : R₀ ≤ (CF * V) ^ (2 * ((AL + 2) * AF)) :=
    (le_self_pow₀ hR₀1 (by norm_num)).trans hR₀T
  have hmono : ∀ (q : ℕ) (T T' : ℝ),
      KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q T (kaiQuadPoly p₀ p₁ p₂) → T ≤ T' →
      KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q T' (kaiQuadPoly p₀ p₁ p₂) := by
    intro q T T' h hT
    obtain ⟨hq, γ', b, a, η', θ', h1, h2, h3⟩ := h
    refine ⟨hq, γ', b, a, η', θ', fun l => (h1 l).trans ?_, fun l l' => (h2 l l').trans ?_, h3⟩
    · exact div_le_div_of_nonneg_right hT (by positivity)
    · exact div_le_div_of_nonneg_right hT (by positivity)
  have hN3 : 3 ≤ ⌊M⌋₊ := Nat.le_floor (by exact_mod_cast hM)
  have hNR3 : (3 : ℝ) ≤ (⌊M⌋₊ : ℝ) := by exact_mod_cast hN3
  
  by_cases hsmall : (⌊M⌋₊ : ℝ) < R₀
  · have hNsq : (⌊M⌋₊ : ℝ) ^ 2 ≤ (CF * V) ^ (2 * ((AL + 2) * AF)) :=
      (pow_le_pow_left₀ (by linarith) hsmall.le 2).trans hR₀T
    have hNN : (⌊M⌋₊ : ℝ) ≤ (⌊M⌋₊ : ℝ) ^ 2 := by
      rw [sq]; exact le_mul_of_one_le_left (by linarith) (by linarith)
    have hN2nn : (0 : ℝ) ≤ (⌊M⌋₊ : ℝ) ^ 2 := sq_nonneg _
    refine ⟨1, by rw [Nat.cast_one]; linarith, le_rfl, p₀, fun l => round (p₁ l),
      fun l l' => round (p₂ l l'), fun l => p₁ l - round (p₁ l),
      fun l l' => p₂ l l' - round (p₂ l l'), ?_, ?_, ?_⟩
    · intro l
      refine (abs_sub_round _).trans ?_
      rw [Nat.cast_one, one_mul, le_div_iff₀ (by linarith)]
      linarith
    · intro l l'
      refine (abs_sub_round _).trans ?_
      rw [Nat.cast_one, one_mul, le_div_iff₀ (by positivity)]
      linarith
    · intro z
      simp only [kaiQuadPoly, Nat.cast_one, div_one]
      have h1 : ∑ l, p₁ l * (z l : ℝ) = ∑ l, ((round (p₁ l) : ℤ) : ℝ) * (z l : ℝ)
          + ∑ l, (p₁ l - ((round (p₁ l) : ℤ) : ℝ)) * (z l : ℝ) := by
        rw [← Finset.sum_add_distrib]; exact Finset.sum_congr rfl (fun l _ => by ring)
      have h2 : ∑ l, ∑ l', p₂ l l' * (z l : ℝ) * (z l' : ℝ)
          = ∑ l, ∑ l', ((round (p₂ l l') : ℤ) : ℝ) * (z l : ℝ) * (z l' : ℝ)
          + ∑ l, ∑ l', (p₂ l l' - ((round (p₂ l l') : ℤ) : ℝ)) * (z l : ℝ) * (z l' : ℝ) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun l' _ => by ring)
      rw [h1, h2]; ring
  push_neg at hsmall
  
  have hΓ0 : (Γ : ℝ) ≠ 0 := by positivity
  obtain ⟨fα, hfα⟩ : ∃ f : NumberField.RingOfIntegers K → ℝ, f = fun x =>
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
        @ite ℝ (x ∈ I) (Classical.propDecidable _) (α I) 0 := ⟨_, rfl⟩
  obtain ⟨Sα, hSα⟩ : ∃ S : ℂ, S = ∑ x ∈ omegaBox ω M,
      ((fα x * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) : ℝ) : ℂ)
        * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)) := ⟨_, rfl⟩
  obtain ⟨Sγ, hSγ⟩ : ∃ S : ℂ, S = ∑ x ∈ omegaBox ω M,
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
        ((@ite ℝ (x ∈ I) (Classical.propDecidable _) (γ I / Γ) 0 : ℝ) : ℂ)
          * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)) := ⟨_, rfl⟩
  have hsplit : (∑ x ∈ omegaBox ω M,
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
        ((@ite ℝ (x ∈ I) (Classical.propDecidable _)
            (α I * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) + γ I) 0 : ℝ) : ℂ)
          * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))) = Sα + (Γ : ℂ) * Sγ := by
    rw [hSα, hSγ, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    simp only [hfα]
    rw [Finset.sum_mul, Complex.ofReal_sum, Finset.sum_mul, Finset.mul_sum,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun I _ => ?_)
    by_cases h : x ∈ I
    · rw [if_pos h, if_pos h, if_pos h]
      rw [show α I * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) + γ I
          = α I * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) + Γ * (γ I / Γ) by field_simp]
      push_cast; ring
    · rw [if_neg h, if_neg h, if_neg h]; simp
  have hnorm : θ * ((omegaBox ω M).card : ℝ) ≤ ‖Sα‖ + Γ * ‖Sγ‖ := by
    refine hhyp.trans ?_
    rw [hsplit]
    refine (norm_add_le _ _).trans ?_
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith)]
  by_cases hcA : θ / 2 * ((omegaBox ω M).card : ℝ) ≤ ‖Sα‖
  · 
    have hfαb : ∀ x ∈ omegaBox ω M, |fα x| ≤ Cd * (D : ℝ) := by
      intro x _
      simp only [hfα]
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      refine (Finset.sum_le_sum (g := fun _ => (1 : ℝ)) (fun I _ => ?_)).trans ?_
      · by_cases h : x ∈ I
        · rw [if_pos h]; exact hα I
        · rw [if_neg h, abs_zero]; exact zero_le_one
      · rw [Finset.sum_const, nsmul_eq_mul, mul_one]; exact (hCd D hD).1
    have hκ1 : 1 ≤ Cd * (D : ℝ) := one_le_mul_of_one_le_of_one_le hCd1 hD1
    have hu : Cd * (D : ℝ) * Real.log M / (θ / 2) = 2 * Cd * ((D : ℝ) / θ * Real.log M) := by
      field_simp
    have huV : Cd * (D : ℝ) * Real.log M / (θ / 2) ≤ V := by
      rw [hu]; refine le_trans ?_ hCdWV
      exact mul_le_mul_of_nonneg_left hDθℓW (by linarith)
    have hu1 : 1 ≤ Cd * (D : ℝ) * Real.log M / (θ / 2) := by
      rw [hu]
      have h1 := one_le_mul_of_one_le_of_one_le hDθ1 hℓ1
      nlinarith
    obtain ⟨Y, hY⟩ : ∃ Y : ℝ, Y = CL * (Cd * (D : ℝ) * Real.log M / (θ / 2)) ^ AL := ⟨_, rfl⟩
    have hY1 : 1 ≤ Y := by rw [hY]; exact one_le_mul_of_one_le_of_one_le hCL (one_le_pow₀ hu1)
    have hYV : Y ≤ V ^ (AL + 1) := by
      rw [hY, pow_succ']
      exact mul_le_mul hCLV (pow_le_pow_left₀ (by linarith) huV AL) (by positivity) hV0
    have hYR : Y ≤ R₀ := by
      rw [hR₀]; refine hYV.trans ((pow_le_pow_right₀ hV1 (show AL + 1 ≤ E by omega)).trans ?_)
      exact le_mul_of_one_le_left (by positivity) hCF
    have hthrA : CL * (Cd * (D : ℝ) * Real.log M / (θ / 2)) ^ AL ≤ (⌊M⌋₊ : ℝ) := by
      rw [← hY]; exact hYR.trans hsmall
    have hypA : θ / 2 * ((omegaBox ω M).card : ℝ) ≤ ‖∑ x ∈ omegaBox ω M,
        ((fα x * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) : ℝ) : ℂ)
          * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ := by rw [← hSα]; exact hcA
    obtain ⟨Ω, hΩc, hΩ⟩ := hLW M (θ / 2) (Cd * (D : ℝ)) fα (kaiQuadPoly p₀ p₁ p₂) hM
      (by linarith) (by linarith) hκ1 hfαb hthrA hypA
    rw [← hY] at hΩ
    have hSf : (∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω)
          (fun _ => Classical.propDecidable _) (omegaBox ω M),
        ((fα x : ℝ) : ℂ) * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)))
        = ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω)
          (fun _ => Classical.propDecidable _) (omegaBox ω M),
          ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
            ((@ite ℝ (x ∈ I) (Classical.propDecidable _) (α I) 0 : ℝ) : ℂ)
              * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x)) := by
      refine Finset.sum_congr rfl (fun x _ => ?_)
      simp only [hfα]
      rw [Complex.ofReal_sum, Finset.sum_mul]
    rw [hSf] at hΩ
    have hYpos : 0 < Y := by linarith
    have hθC : 0 < θ / (2 * Y) := by positivity
    have hθC1 : θ / (2 * Y) ≤ 1 := by rw [div_le_one (by positivity)]; linarith
    have hypC : θ / (2 * Y) * ((omegaBox ω M).card : ℝ) ≤
        ‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω)
          (fun _ => Classical.propDecidable _) (omegaBox ω M),
          ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
            ((@ite ℝ (x ∈ I) (Classical.propDecidable _) (α I) 0 : ℝ) : ℂ)
              * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ := by
      rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
      linarith
    have hDθC : (D : ℝ) / (θ / (2 * Y)) ≤ V ^ (AL + 2) := by
      have e : (D : ℝ) / (θ / (2 * Y)) = Y * (2 * ((D : ℝ) / θ)) := by
        field_simp
      rw [e, pow_succ]
      exact mul_le_mul hYV ((by linarith : 2 * ((D : ℝ) / θ) ≤ 2 * W).trans h2WV)
        (by positivity) (by positivity)
    have hbC : CF * ((D : ℝ) / (θ / (2 * Y))) ^ AF ≤ R₀ := by
      rw [hR₀]; refine mul_le_mul_of_nonneg_left ?_ (by linarith)
      calc ((D : ℝ) / (θ / (2 * Y))) ^ AF ≤ (V ^ (AL + 2)) ^ AF :=
            pow_le_pow_left₀ (by positivity) hDθC AF
        _ = V ^ E := by rw [← pow_mul, hE]
    obtain ⟨q, hq, hmaj⟩ := hFL M (θ / (2 * Y)) D α Ω (by linarith) hθC hθC1 hD hα hΩc
      (hbC.trans hsmall) p₀ p₁ p₂ hypC
    exact ⟨q, hq.trans (hbC.trans hR₀T'), hmono q _ _ hmaj (hbC.trans hR₀T')⟩
  · 
    push_neg at hcA
    have hθB : 0 < θ / (2 * Γ) := by positivity
    have hθB1 : θ / (2 * Γ) ≤ 1 := by rw [div_le_one (by positivity)]; linarith
    have hcB : ∀ I, |γ I / Γ| ≤ 1 := by
      intro I
      rw [abs_div, abs_of_pos (by linarith : (0 : ℝ) < Γ), div_le_one (by linarith)]
      exact hγ I
    have hDθB : (D : ℝ) / (θ / (2 * Γ)) ≤ V := by
      have e : (D : ℝ) / (θ / (2 * Γ)) = 2 * (Γ * ((D : ℝ) / θ)) := by
        field_simp
      rw [e]; linarith
    have hbB : CF * ((D : ℝ) / (θ / (2 * Γ))) ^ AF ≤ R₀ := by
      rw [hR₀]; refine mul_le_mul_of_nonneg_left ?_ (by linarith)
      exact (pow_le_pow_left₀ (by positivity) hDθB AF).trans (pow_le_pow_right₀ hV1 hEAF)
    have hfu : (@Finset.filter (NumberField.RingOfIntegers K)
        (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈
          (Set.univ : Set (Fin (Module.finrank ℚ K) → ℝ)))
        (fun _ => Classical.propDecidable _) (omegaBox ω M)) = omegaBox ω M :=
      by
        ext x
        rw [@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _]
        exact ⟨fun h => h.1, fun h => ⟨h, Set.mem_univ _⟩⟩
    have hypB : θ / (2 * Γ) * ((omegaBox ω M).card : ℝ) ≤
        ‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈
            (Set.univ : Set (Fin (Module.finrank ℚ K) → ℝ)))
          (fun _ => Classical.propDecidable _) (omegaBox ω M),
          ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) D).toFinset,
            ((@ite ℝ (x ∈ I) (Classical.propDecidable _) (γ I / Γ) 0 : ℝ) : ℂ)
              * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ := by
      rw [hfu, ← hSγ, div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
      linarith
    obtain ⟨q, hq, hmaj⟩ := hFL M (θ / (2 * Γ)) D (fun I => γ I / Γ) Set.univ (by linarith)
      hθB hθB1 hD hcB convex_univ (hbB.trans hsmall) p₀ p₁ p₂ hypB
    exact ⟨q, hq.trans (hbB.trans hR₀T'), hmono q _ _ hmaj (hbB.trans hR₀T')⟩

theorem kai_ideal_class_reps (K : Type u) [Field K] [NumberField K] :
    ∃ ι : Finset (Ideal (NumberField.RingOfIntegers K)), ι.Nonempty ∧
      (∀ 𝔞 ∈ ι, 𝔞 ≠ ⊥ ∧ 1 ≤ Ideal.absNorm 𝔞 ∧
        ∃ 𝔟 : Ideal (NumberField.RingOfIntegers K), 𝔟 ≠ ⊥ ∧
          𝔞 * 𝔟 = Ideal.span {((Ideal.absNorm 𝔞 : ℕ) : NumberField.RingOfIntegers K)}) ∧
      ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ ⊥ →
        ∃ 𝔞 ∈ ι, Submodule.IsPrincipal (I * 𝔞) :=
by
  classical
  
  have hcof : ∀ 𝔞 : Ideal (NumberField.RingOfIntegers K), 𝔞 ≠ ⊥ →
      1 ≤ Ideal.absNorm 𝔞 ∧
        ∃ 𝔟 : Ideal (NumberField.RingOfIntegers K), 𝔟 ≠ ⊥ ∧
          𝔞 * 𝔟 = Ideal.span {((Ideal.absNorm 𝔞 : ℕ) : NumberField.RingOfIntegers K)} := by
    intro 𝔞 h𝔞
    have hN : Ideal.absNorm 𝔞 ≠ 0 := fun h => h𝔞 (Ideal.absNorm_eq_zero_iff.mp h)
    refine ⟨Nat.one_le_iff_ne_zero.mpr hN, ?_⟩
    have hle : Ideal.span {((Ideal.absNorm 𝔞 : ℕ) : NumberField.RingOfIntegers K)} ≤ 𝔞 :=
      (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.absNorm_mem 𝔞)
    obtain ⟨𝔟, h𝔟⟩ := Ideal.dvd_iff_le.mpr hle
    refine ⟨𝔟, ?_, h𝔟.symm⟩
    rintro rfl
    rw [Ideal.mul_bot, Ideal.span_singleton_eq_bot] at h𝔟
    exact hN (by exact_mod_cast h𝔟)
  
  let r : ClassGroup (NumberField.RingOfIntegers K) →
      ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :=
    fun c => Function.surjInv ClassGroup.mk0_surjective c⁻¹
  have hr : ∀ c, ClassGroup.mk0 (r c) = c⁻¹ := fun c =>
    Function.surjInv_eq ClassGroup.mk0_surjective c⁻¹
  have hnz : ∀ c, ((r c : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) :
      Ideal (NumberField.RingOfIntegers K)) ≠ ⊥ := by
    intro c
    have := mem_nonZeroDivisors_iff_ne_zero.mp (r c).2
    simpa [Submodule.zero_eq_bot] using this
  refine ⟨Finset.univ.image (fun c => ((r c : ↥(nonZeroDivisors
      (Ideal (NumberField.RingOfIntegers K)))) : Ideal (NumberField.RingOfIntegers K))),
    Finset.image_nonempty.mpr Finset.univ_nonempty, ?_, ?_⟩
  · intro 𝔞 h𝔞
    obtain ⟨c, -, rfl⟩ := Finset.mem_image.mp h𝔞
    exact ⟨hnz c, hcof _ (hnz c)⟩
  · intro I hI
    have hI' : I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      mem_nonZeroDivisors_iff_ne_zero.mpr (by simpa [Submodule.zero_eq_bot] using hI)
    set c := ClassGroup.mk0 ⟨I, hI'⟩ with hc
    refine ⟨((r c : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) :
      Ideal (NumberField.RingOfIntegers K)), Finset.mem_image_of_mem _ (Finset.mem_univ c), ?_⟩
    have hP := ((⟨I, hI'⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) * r c).2
    have : ClassGroup.mk0 ((⟨I, hI'⟩ : ↥(nonZeroDivisors
        (Ideal (NumberField.RingOfIntegers K)))) * r c) = 1 := by
      rw [map_mul, hr, ← hc, mul_inv_cancel]
    exact (ClassGroup.mk0_eq_one_iff hP).mp this

theorem kai_typeII_generator_set (K : Type u) [Field K] [NumberField K] :
    ∃ cb : ℝ, 1 ≤ cb ∧
      ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (k X : ℕ)
        (α : Ideal (NumberField.RingOfIntegers K) → ℝ), 𝔞 ≠ ⊥ →
        (∀ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          α I ≠ 0 → I ≠ ⊥ ∧ 2 ^ k ≤ Ideal.absNorm I ∧ Ideal.absNorm I < 2 ^ (k + 1) ∧
            Submodule.IsPrincipal (I * 𝔞)) →
        ∃ W : Finset (NumberField.RingOfIntegers K),
          (∀ w ∈ W, ∀ v : NumberField.InfinitePlace K,
            (((Ideal.absNorm 𝔞 * 2 ^ k : ℕ) : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K))
                ≤ cb * v ((w : NumberField.RingOfIntegers K) : K) ∧
            v ((w : NumberField.RingOfIntegers K) : K)
                ≤ cb * (((Ideal.absNorm 𝔞 * 2 ^ k : ℕ) : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K))) ∧
          (∀ w ∈ W, ∃ I : Ideal (NumberField.RingOfIntegers K), Ideal.span {w} = I * 𝔞) ∧
          (∀ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
            α I ≠ 0 → ∃ w ∈ W, Ideal.span {w} = I * 𝔞) :=
by
  classical
  have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
  
  obtain ⟨cK, hcK1, hBG⟩ : ∃ cK : ℝ, 1 ≤ cK ∧ ∀ w : NumberField.RingOfIntegers K, w ≠ 0 →
      ∃ u : (NumberField.RingOfIntegers K)ˣ, ∀ v : NumberField.InfinitePlace K,
        ((Algebra.norm ℤ w).natAbs : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K)
          ≤ cK * v ((((u : NumberField.RingOfIntegers K) * w :
              NumberField.RingOfIntegers K)) : K) ∧
        v ((((u : NumberField.RingOfIntegers K) * w : NumberField.RingOfIntegers K)) : K)
          ≤ cK * ((Algebra.norm ℤ w).natAbs : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) := by
    obtain ⟨R₀, hR₀⟩ :=
      (NumberField.mixedEmbedding.fundamentalCone.isBounded_normLeOne K).exists_norm_le
    obtain ⟨R, hR_def⟩ : ∃ R : ℝ, R = max R₀ 1 := ⟨_, rfl⟩
    have hR1 : 1 ≤ R := by rw [hR_def]; exact le_max_right _ _
    have hR0 : 0 ≤ R := by linarith
    refine ⟨R ^ Module.finrank ℚ K, one_le_pow₀ hR1, ?_⟩
    intro w hw
    obtain ⟨N, hN_def⟩ : ∃ N : ℝ, N = ((Algebra.norm ℤ w).natAbs : ℝ) := ⟨_, rfl⟩
    rw [← hN_def]
    have hnormne : Algebra.norm ℤ w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
    have hN1 : 1 ≤ N := by
      rw [hN_def]; exact_mod_cast Int.natAbs_pos.mpr hnormne
    have hN0 : 0 < N := by linarith
    obtain ⟨x, hx_def⟩ : ∃ x : NumberField.mixedEmbedding.mixedSpace K,
        x = NumberField.mixedEmbedding K (w : K) := ⟨_, rfl⟩
    have hxnorm : NumberField.mixedEmbedding.norm x = N := by
      rw [hx_def, NumberField.mixedEmbedding.norm_eq_norm, ← Algebra.coe_norm_int, hN_def]
      push_cast
      rw [Nat.cast_natAbs, Int.cast_abs]
    obtain ⟨u, hu⟩ := NumberField.mixedEmbedding.fundamentalCone.exists_unit_smul_mem
      (x := x) (by rw [hxnorm]; exact hN0.ne')
    refine ⟨u, fun v => ?_⟩
    have hux : u • x = NumberField.mixedEmbedding K
        (((u : NumberField.RingOfIntegers K) * w : NumberField.RingOfIntegers K) : K) := by
      rw [NumberField.mixedEmbedding.unitSMul_smul, hx_def, ← map_mul]
      rfl
    obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = N ^ ((1 : ℝ) / Module.finrank ℚ K) := ⟨_, rfl⟩
    rw [← hs_def]
    have hs0 : 0 < s := by rw [hs_def]; exact Real.rpow_pos_of_pos hN0 _
    have hsn : s ^ Module.finrank ℚ K = N := by
      rw [hs_def, one_div]; exact Real.rpow_inv_natCast_pow hN0.le hn.ne'
    obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = s⁻¹ := ⟨_, rfl⟩
    have ht0 : 0 < t := by rw [ht_def]; exact inv_pos.mpr hs0
    obtain ⟨y, hy_def⟩ : ∃ y : NumberField.mixedEmbedding.mixedSpace K, y = t • (u • x) :=
      ⟨_, rfl⟩
    have hycone : y ∈ NumberField.mixedEmbedding.fundamentalCone K := by
      rw [hy_def]
      exact NumberField.mixedEmbedding.fundamentalCone.smul_mem_of_mem hu ht0.ne'
    have hynorm : NumberField.mixedEmbedding.norm y = 1 := by
      rw [hy_def, NumberField.mixedEmbedding.norm_smul,
        NumberField.mixedEmbedding.norm_unit_smul, hxnorm, abs_of_pos ht0, ht_def, inv_pow,
        hsn]
      exact inv_mul_cancel₀ hN0.ne'
    have hyle : y ∈ NumberField.mixedEmbedding.fundamentalCone.normLeOne K :=
      NumberField.mixedEmbedding.fundamentalCone.mem_normLeOne.mpr ⟨hycone, hynorm.le⟩
    have hyR : ∀ v', NumberField.mixedEmbedding.normAtPlace v' y ≤ R := by
      intro v'
      have h1 : NumberField.mixedEmbedding.normAtPlace v' y ≤ ‖y‖ := by
        rw [NumberField.mixedEmbedding.norm_eq_sup'_normAtPlace]
        exact Finset.le_sup' (fun w => NumberField.mixedEmbedding.normAtPlace w y)
          (Finset.mem_univ v')
      exact h1.trans ((hR₀ y hyle).trans (by rw [hR_def]; exact le_max_left _ _))
    have hya : ∀ v', NumberField.mixedEmbedding.normAtPlace v' y
        = t * v' (((u : NumberField.RingOfIntegers K) * w : NumberField.RingOfIntegers K) : K) := by
      intro v'
      rw [hy_def, NumberField.mixedEmbedding.normAtPlace_smul, abs_of_pos ht0, hux,
        NumberField.mixedEmbedding.normAtPlace_apply]
    obtain ⟨a, ha_def⟩ : ∃ a : ℝ,
        a = v (((u : NumberField.RingOfIntegers K) * w : NumberField.RingOfIntegers K) : K) :=
      ⟨_, rfl⟩
    rw [← ha_def]
    have has : a = s * NumberField.mixedEmbedding.normAtPlace v y := by
      rw [hya, ht_def, ← mul_assoc, mul_inv_cancel₀ hs0.ne', one_mul, ha_def]
    have hup : a ≤ R * s := by
      rw [has, mul_comm]; exact mul_le_mul_of_nonneg_right (hyR v) hs0.le
    have hlow : 1 ≤ NumberField.mixedEmbedding.normAtPlace v y * R ^ Module.finrank ℚ K := by
      have hprod : ∏ v', NumberField.mixedEmbedding.normAtPlace v' y ^ v'.mult = 1 := by
        rw [← hynorm, NumberField.mixedEmbedding.norm_apply]
      have hle : ∏ v', NumberField.mixedEmbedding.normAtPlace v' y ^ v'.mult
          ≤ ∏ v', ((if v' = v then NumberField.mixedEmbedding.normAtPlace v y else 1)
              * R ^ v'.mult) := by
        apply Finset.prod_le_prod
        · intro i _
          exact pow_nonneg (NumberField.mixedEmbedding.normAtPlace_nonneg _ _) _
        · intro i _
          split_ifs with h
          · subst h
            obtain ⟨j, hj⟩ : ∃ j, i.mult = j + 1 :=
              ⟨i.mult - 1, by have := NumberField.InfinitePlace.mult_pos (w := i); omega⟩
            have hb0 := NumberField.mixedEmbedding.normAtPlace_nonneg i y
            have h1 : NumberField.mixedEmbedding.normAtPlace i y ^ j ≤ R ^ j :=
              pow_le_pow_left₀ hb0 (hyR i) j
            have h2 : R ^ j ≤ R ^ j * R := le_mul_of_one_le_right (pow_nonneg hR0 j) hR1
            have h3 := mul_le_mul_of_nonneg_left (h1.trans h2) hb0
            rw [hj, pow_succ, pow_succ]
            linarith
          · rw [one_mul]
            exact pow_le_pow_left₀ (NumberField.mixedEmbedding.normAtPlace_nonneg _ _) (hyR i) _
      rw [Finset.prod_mul_distrib, Finset.prod_ite_eq', if_pos (Finset.mem_univ _),
        Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at hle
      rw [← hprod]; exact hle
    have hRR : R ≤ R ^ Module.finrank ℚ K := le_self_pow₀ hR1 hn.ne'
    constructor
    · rw [has]
      have := mul_le_mul_of_nonneg_left hlow hs0.le
      linarith
    · have := mul_le_mul_of_nonneg_right hRR hs0.le
      linarith
  
  refine ⟨2 * cK, by linarith, ?_⟩
  intro 𝔞 k X α h𝔞 hsupp
  obtain ⟨Pn, hPn⟩ : ∃ Pn : ℕ, Pn = Ideal.absNorm 𝔞 * 2 ^ k := ⟨_, rfl⟩
  rw [← hPn]
  have hexp0 : (0 : ℝ) ≤ (1 : ℝ) / Module.finrank ℚ K := by positivity
  have hexp1 : (1 : ℝ) / Module.finrank ℚ K ≤ 1 := by
    rw [div_le_one (by exact_mod_cast hn)]
    exact_mod_cast hn
  have hex : ∀ I ∈ (Ideal.finite_setOf_absNorm_le
      (S := NumberField.RingOfIntegers K) X).toFinset.filter (fun I => α I ≠ 0),
      ∃ w : NumberField.RingOfIntegers K, Ideal.span {w} = I * 𝔞 ∧
        ∀ v : NumberField.InfinitePlace K,
          (Pn : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) ≤ 2 * cK * v (w : K) ∧
          v (w : K) ≤ 2 * cK * (Pn : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) := by
    intro I hI
    rw [Finset.mem_filter] at hI
    obtain ⟨hIb, hk1, hk2, hpr⟩ := hsupp I hI.1 hI.2
    obtain ⟨g, hg⟩ := hpr.principal
    have hg' : Ideal.span {g} = I * 𝔞 := hg.symm
    
    have hg0 : g ≠ 0 := by
      intro h0
      rw [h0, Ideal.span_singleton_eq_bot.mpr rfl] at hg'
      rcases Ideal.mul_eq_bot.mp hg'.symm with h | h
      · exact hIb h
      · exact h𝔞 h
    have hnormeq : (Algebra.norm ℤ g).natAbs = Ideal.absNorm I * Ideal.absNorm 𝔞 := by
      rw [← Ideal.absNorm_span_singleton, hg', map_mul]
    have hP1 : Pn ≤ (Algebra.norm ℤ g).natAbs := by
      rw [hnormeq, hPn, mul_comm (Ideal.absNorm I)]
      exact Nat.mul_le_mul_left _ hk1
    have hIle : Ideal.absNorm I ≤ 2 * 2 ^ k := by rw [pow_succ] at hk2; omega
    have hP2 : (Algebra.norm ℤ g).natAbs ≤ 2 * Pn := by
      rw [hnormeq, hPn]
      calc Ideal.absNorm I * Ideal.absNorm 𝔞 ≤ (2 * 2 ^ k) * Ideal.absNorm 𝔞 :=
            Nat.mul_le_mul_right _ hIle
        _ = 2 * (Ideal.absNorm 𝔞 * 2 ^ k) := by ring
    have hlowA : (Pn : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K)
        ≤ ((Algebra.norm ℤ g).natAbs : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) :=
      Real.rpow_le_rpow (by positivity) (by exact_mod_cast hP1) hexp0
    have h2e : (2 : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) ≤ 2 := by
      calc (2 : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) ≤ (2 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp1
        _ = 2 := Real.rpow_one 2
    have hupA : ((Algebra.norm ℤ g).natAbs : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K)
        ≤ 2 * (Pn : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) := by
      calc ((Algebra.norm ℤ g).natAbs : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K)
          ≤ ((2 : ℝ) * (Pn : ℝ)) ^ ((1 : ℝ) / Module.finrank ℚ K) :=
            Real.rpow_le_rpow (by positivity) (by exact_mod_cast hP2) hexp0
        _ = (2 : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K)
              * (Pn : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) :=
            Real.mul_rpow (by norm_num) (by positivity)
        _ ≤ 2 * (Pn : ℝ) ^ ((1 : ℝ) / Module.finrank ℚ K) :=
            mul_le_mul_of_nonneg_right h2e (by positivity)
    obtain ⟨u, hu⟩ := hBG g hg0
    refine ⟨(u : NumberField.RingOfIntegers K) * g, ?_, fun v => ?_⟩
    · rw [Ideal.span_singleton_mul_left_unit u.isUnit g, hg']
    · obtain ⟨hu1, hu2⟩ := hu v
      have ha0 : 0 ≤ v ((((u : NumberField.RingOfIntegers K) * g :
          NumberField.RingOfIntegers K)) : K) := by positivity
      have hcK0 : 0 ≤ cK := by linarith
      constructor
      · have := mul_nonneg hcK0 ha0
        linarith
      · have := mul_le_mul_of_nonneg_left hupA hcK0
        linarith
  choose f hf using hex
  refine ⟨((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset.filter
      (fun I => α I ≠ 0)).attach.image (fun I => f I.1 I.2), ?_, ?_, ?_⟩
  · intro w hw v
    obtain ⟨I, -, rfl⟩ := Finset.mem_image.mp hw
    exact (hf I.1 I.2).2 v
  · intro w hw
    obtain ⟨I, -, rfl⟩ := Finset.mem_image.mp hw
    exact ⟨I.1, (hf I.1 I.2).1⟩
  · intro I hIX hα
    have hI : I ∈ (Ideal.finite_setOf_absNorm_le
        (S := NumberField.RingOfIntegers K) X).toFinset.filter (fun I => α I ≠ 0) :=
      Finset.mem_filter.mpr ⟨hIX, hα⟩
    exact ⟨f I hI, Finset.mem_image.mpr ⟨⟨I, hI⟩, Finset.mem_attach _ _, rfl⟩, (hf I hI).1⟩

theorem kai_quad_major_coeff {ν : ℕ} (N q : ℕ) (T : ℝ) (p₀ : ℝ) (p₁ : Fin ν → ℝ)
    (p₂ : Fin ν → Fin ν → ℝ) (hN : 1 ≤ N) :
    (KaiQuadMajor ν N q T (kaiQuadPoly p₀ p₁ p₂) →
      1 ≤ q ∧ (∀ l, ∃ b : ℤ, |(q : ℝ) * p₁ l - b| ≤ T / N) ∧
      (∀ l l', ∃ a : ℤ, |(q : ℝ) * (p₂ l l' + p₂ l' l) - a| ≤ 2 * T / (N : ℝ) ^ 2)) ∧
    (1 ≤ q → 0 ≤ T → (∀ l, ∃ b : ℤ, |(q : ℝ) * p₁ l - b| ≤ T / N) →
      (∀ l l', ∃ a : ℤ, |(q : ℝ) * (p₂ l l' + p₂ l' l) - a| ≤ T / (N : ℝ) ^ 2) →
      KaiQuadMajor ν N (2 * q) (2 * T) (kaiQuadPoly p₀ p₁ p₂)) :=
by
  have hform : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ) (z : Fin ν → ℤ),
      kaiQuadPoly c β Γ z
        = c + ∑ l, β l * (z l : ℝ) + ∑ l, (z l : ℝ) * ∑ l', Γ l l' * (z l' : ℝ) := by
    intro c β Γ z
    unfold kaiQuadPoly
    congr 1
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun l' _ => ?_)
    ring
  have hev0 : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ),
      kaiQuadPoly c β Γ (fun _ => 0) = c := by
    intro c β Γ
    simp [kaiQuadPoly]
  have hev1 : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ) (l : Fin ν),
      kaiQuadPoly c β Γ (fun m => if m = l then 1 else 0) = c + β l + Γ l l := by
    intro c β Γ l
    rw [hform]
    simp [Int.cast_ite, mul_ite, ite_mul, Finset.sum_ite_eq']
  have hev2 : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ) (l l' : Fin ν),
      kaiQuadPoly c β Γ (fun m => (if m = l then 1 else 0) + (if m = l' then 1 else 0))
        = c + β l + β l' + (Γ l l + Γ l l' + Γ l' l + Γ l' l') := by
    intro c β Γ l l'
    rw [hform]
    simp [Int.cast_ite, mul_add, add_mul, Finset.sum_add_distrib, mul_ite, ite_mul,
      Finset.sum_ite_eq']
    ring
  have hNr : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hNpos : (0 : ℝ) < N := by linarith
  
  have s6 : ∀ (q : ℕ) (T : ℝ) (b : Fin ν → ℤ) (a : Fin ν → Fin ν → ℤ), 1 ≤ q →
      (∀ l, |p₁ l - (b l : ℝ) / q| ≤ T / ((q : ℝ) * N)) →
      (∀ l l', |p₂ l l' + p₂ l' l - 2 * (a l l' : ℝ) / q|
          ≤ 2 * (T / ((q : ℝ) * (N : ℝ) ^ 2))) →
      KaiQuadMajor ν N q T (kaiQuadPoly p₀ p₁ p₂) := by
    intro q T b a hq hb ha
    refine ⟨hq, p₀, b, a, fun l => p₁ l - (b l : ℝ) / q,
      fun l l' => (p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q, hb, ?_, ?_⟩
    · intro l l'
      show |(p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q| ≤ T / ((q : ℝ) * (N : ℝ) ^ 2)
      have e : (p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q
          = (p₂ l l' + p₂ l' l - 2 * (a l l' : ℝ) / q) / 2 := by ring
      rw [e, abs_div, abs_two]
      have := ha l l'
      linarith
    · intro z
      show kaiQuadPoly p₀ p₁ p₂ z = p₀
        + (∑ l, (b l : ℝ) * (z l : ℝ) + ∑ l, ∑ l', (a l l' : ℝ) * (z l : ℝ) * (z l' : ℝ)) / (q : ℝ)
        + ∑ l, (p₁ l - (b l : ℝ) / q) * (z l : ℝ)
        + ∑ l, ∑ l', ((p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q) * (z l : ℝ) * (z l' : ℝ)
      have hsym : ∑ l, ∑ l', p₂ l' l * (z l : ℝ) * (z l' : ℝ)
          = ∑ l, ∑ l', p₂ l l' * (z l : ℝ) * (z l' : ℝ) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun l' _ => ?_))
        ring
      have e1 : ∑ l, (p₁ l - (b l : ℝ) / q) * (z l : ℝ)
          = ∑ l, p₁ l * (z l : ℝ) - (∑ l, (b l : ℝ) * (z l : ℝ)) / q := by
        rw [Finset.sum_div, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        ring
      have e2 : ∑ l, ∑ l', ((p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q) * (z l : ℝ) * (z l' : ℝ)
          = (∑ l, ∑ l', p₂ l l' * (z l : ℝ) * (z l' : ℝ)) / 2
            + (∑ l, ∑ l', p₂ l' l * (z l : ℝ) * (z l' : ℝ)) / 2
            - (∑ l, ∑ l', (a l l' : ℝ) * (z l : ℝ) * (z l' : ℝ)) / q := by
        rw [Finset.sum_div, Finset.sum_div, Finset.sum_div, ← Finset.sum_add_distrib,
          ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [Finset.sum_div, Finset.sum_div, Finset.sum_div, ← Finset.sum_add_distrib,
          ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun l' _ => ?_)
        ring
      rw [e1, e2, hsym]
      unfold kaiQuadPoly
      ring
  constructor
  · 
    intro hmaj
    obtain ⟨hq, γ, b, a, η, θ, hη, hθ, hid⟩ := hmaj
    have hqr : (1 : ℝ) ≤ q := by exact_mod_cast hq
    have hqpos : (0 : ℝ) < q := by linarith
    have hqne : (q : ℝ) ≠ 0 := hqpos.ne'
    have hid' : ∀ z, kaiQuadPoly p₀ p₁ p₂ z = kaiQuadPoly γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') z := by
      intro z
      rw [hid z]
      simp only [kaiQuadPoly, add_div, Finset.sum_div, add_mul, Finset.sum_add_distrib,
        div_mul_eq_mul_div] <;> ring
    have hQ : ∀ l l', p₂ l l' + p₂ l' l
        = ((a l l' : ℝ) / q + θ l l') + ((a l' l : ℝ) / q + θ l' l) := by
      intro l l'
      have e2a := hev2 p₀ p₁ p₂ l l'
      have e2b := hev2 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l l'
      have e1a := hev1 p₀ p₁ p₂ l
      have e1b := hev1 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l
      have e1a' := hev1 p₀ p₁ p₂ l'
      have e1b' := hev1 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l'
      have e0a := hev0 p₀ p₁ p₂
      have e0b := hev0 γ (fun l => (b l : ℝ) / q + η l) (fun l l' => (a l l' : ℝ) / q + θ l l')
      have h2 := hid' (fun m => (if m = l then 1 else 0) + (if m = l' then 1 else 0))
      have h1 := hid' (fun m => if m = l then 1 else 0)
      have h1' := hid' (fun m => if m = l' then 1 else 0)
      have h0 := hid' (fun _ => 0)
      linarith
    have hL : ∀ l, p₁ l = (b l : ℝ) / q + η l := by
      intro l
      have e1a := hev1 p₀ p₁ p₂ l
      have e1b := hev1 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l
      have e0a := hev0 p₀ p₁ p₂
      have e0b := hev0 γ (fun l => (b l : ℝ) / q + η l) (fun l l' => (a l l' : ℝ) / q + θ l l')
      have h1 := hid' (fun m => if m = l then 1 else 0)
      have h0 := hid' (fun _ => 0)
      have hll := hQ l l
      linarith
    refine ⟨hq, fun l => ⟨b l, ?_⟩, fun l l' => ⟨a l l' + a l' l, ?_⟩⟩
    · have hc : (q : ℝ) * ((b l : ℝ) / q) = (b l : ℝ) := by field_simp
      have e : (q : ℝ) * p₁ l - (b l : ℝ) = (q : ℝ) * η l := by
        rw [hL l]; linear_combination hc
      rw [e, abs_mul, abs_of_pos hqpos]
      have hc2 : (q : ℝ) * (T / ((q : ℝ) * N)) = T / N := by
        rw [← mul_div_assoc, mul_div_mul_left _ _ hqne]
      calc (q : ℝ) * |η l| ≤ (q : ℝ) * (T / ((q : ℝ) * N)) :=
            mul_le_mul_of_nonneg_left (hη l) hqpos.le
        _ = T / N := hc2
    · have hc : (q : ℝ) * ((a l l' : ℝ) / q) = (a l l' : ℝ) := by field_simp
      have hc' : (q : ℝ) * ((a l' l : ℝ) / q) = (a l' l : ℝ) := by field_simp
      have e : (q : ℝ) * (p₂ l l' + p₂ l' l) - ((a l l' + a l' l : ℤ) : ℝ)
          = (q : ℝ) * (θ l l' + θ l' l) := by
        rw [hQ l l']; push_cast; linear_combination hc + hc'
      rw [e, abs_mul, abs_of_pos hqpos]
      have h1 := hθ l l'
      have h2 := hθ l' l
      have h3 := abs_add_le (θ l l') (θ l' l)
      have hc2 : (q : ℝ) * (2 * (T / ((q : ℝ) * (N : ℝ) ^ 2))) = 2 * T / (N : ℝ) ^ 2 := by
        field_simp
      calc (q : ℝ) * |θ l l' + θ l' l| ≤ (q : ℝ) * (2 * (T / ((q : ℝ) * (N : ℝ) ^ 2))) :=
            mul_le_mul_of_nonneg_left (by linarith) hqpos.le
        _ = 2 * T / (N : ℝ) ^ 2 := hc2
  · 
    intro hq hT hb ha
    choose b hb using hb
    choose a ha using ha
    have hqr : (1 : ℝ) ≤ q := by exact_mod_cast hq
    have hqpos : (0 : ℝ) < q := by linarith
    have hqne : (q : ℝ) ≠ 0 := hqpos.ne'
    have hNne : (N : ℝ) ≠ 0 := hNpos.ne'
    refine s6 (2 * q) (2 * T) (fun l => 2 * b l) a (by omega) (fun l => ?_) (fun l l' => ?_)
    · show |p₁ l - ((2 * b l : ℤ) : ℝ) / ((2 * q : ℕ) : ℝ)| ≤ 2 * T / (((2 * q : ℕ) : ℝ) * N)
      have e : p₁ l - ((2 * b l : ℤ) : ℝ) / ((2 * q : ℕ) : ℝ) = ((q : ℝ) * p₁ l - b l) / q := by
        push_cast; field_simp <;> ring
      have e2 : 2 * T / (((2 * q : ℕ) : ℝ) * N) = (T / N) / q := by
        push_cast; field_simp <;> ring
      rw [e, e2, abs_div, abs_of_pos hqpos]
      exact div_le_div_of_nonneg_right (hb l) hqpos.le
    · show |p₂ l l' + p₂ l' l - 2 * (a l l' : ℝ) / ((2 * q : ℕ) : ℝ)|
          ≤ 2 * (2 * T / (((2 * q : ℕ) : ℝ) * (N : ℝ) ^ 2))
      have e : p₂ l l' + p₂ l' l - 2 * (a l l' : ℝ) / ((2 * q : ℕ) : ℝ)
          = ((q : ℝ) * (p₂ l l' + p₂ l' l) - a l l') / q := by
        push_cast; field_simp <;> ring
      have e2 : 2 * (2 * T / (((2 * q : ℕ) : ℝ) * (N : ℝ) ^ 2)) = 2 * ((T / (N : ℝ) ^ 2) / q) := by
        push_cast; field_simp <;> ring
      rw [e, e2, abs_div, abs_of_pos hqpos]
      have h1 := div_le_div_of_nonneg_right (ha l l') hqpos.le
      have h2 : 0 ≤ (T / (N : ℝ) ^ 2) / q := by positivity
      linarith

theorem kai_lin_vinogradov_affine (ν : ℕ) :
    ∃ (Cl : ℝ) (Al : ℕ), 1 ≤ Cl ∧ 1 ≤ Al ∧
      ∀ (S : ℕ) (δ ε c : ℝ) (G : Finset (Fin ν → ℤ)) (lam : Fin ν → ℝ),
        1 ≤ S → 0 < δ → δ ≤ 1 → 0 ≤ ε → ε ≤ (δ / Cl) ^ Al → (Cl / δ) ^ Al ≤ (S : ℝ) →
        G ⊆ intBox ν S → δ * (((2 * S + 1 : ℕ) : ℝ) ^ ν) ≤ (G.card : ℝ) →
        (∀ z ∈ G, ∃ k : ℤ, |c + ∑ l, lam l * ((z l : ℤ) : ℝ) - (k : ℝ)| ≤ ε) →
        ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (Cl / δ) ^ Al ∧
          ∀ l, ∃ b : ℤ, |(q : ℝ) * lam l - (b : ℝ)| ≤ (Cl / δ) ^ Al * ε / (S : ℝ) :=
by
  classical
  refine ⟨(2 : ℝ) ^ (2 * ν + 6), ν * ν + 3, one_le_pow₀ (by norm_num), by omega, ?_⟩
  intro S δ ε c G lam hS hδ hδ1 hε hεb hSb hG hcard hgood
  
  obtain ⟨P, hP⟩ : ∃ P : ℝ, P = (2 : ℝ) ^ ν := ⟨_, rfl⟩
  have hP1 : 1 ≤ P := by rw [hP]; exact one_le_pow₀ (by norm_num)
  have hP0 : 0 < P := by linarith
  have hPne : P ≠ 0 := hP0.ne'
  have hδne : δ ≠ 0 := hδ.ne'
  have hP2 : 1 ≤ P ^ 2 := one_le_pow₀ hP1
  have hPP : P ≤ P ^ 2 := le_self_pow₀ hP1 (by norm_num)
  have hCl : (2 : ℝ) ^ (2 * ν + 6) = 64 * P ^ 2 := by rw [hP]; ring
  rw [hCl] at hεb hSb ⊢
  obtain ⟨X, hX⟩ : ∃ X : ℝ, X = 64 * P ^ 2 / δ := ⟨_, rfl⟩
  rw [← hX] at hSb ⊢
  have hSR : (1 : ℝ) ≤ (S : ℝ) := by exact_mod_cast hS
  have hSpos : (0 : ℝ) < (S : ℝ) := by linarith
  have hSne : (S : ℝ) ≠ 0 := hSpos.ne'
  have hX1 : 1 ≤ X := by rw [hX, le_div_iff₀ hδ]; linarith
  have hXpos : 0 < X := by linarith
  
  have k1 : 0 < δ / P := div_pos hδ hP0
  have k2 : δ / P ≤ 1 := by rw [div_le_one hP0]; linarith
  have hY0 : 0 ≤ δ / (64 * P ^ 2) := div_nonneg hδ.le (by positivity)
  have hY1 : δ / (64 * P ^ 2) ≤ 1 := by rw [div_le_one (by linarith)]; linarith
  have hεY : ε ≤ δ / (64 * P ^ 2) := hεb.trans (pow_le_of_le_one hY0 hY1 (by omega))
  have hYP : δ / (64 * P ^ 2) ≤ δ / P / 64 := by
    rw [div_div]
    exact div_le_div_of_nonneg_left hδ.le (by linarith) (by linarith)
  have k3 : 2 * ε ≤ δ / P / 32 := by linarith
  have hXS : X ^ 2 ≤ (S : ℝ) := (pow_le_pow_right₀ hX1 (by omega : 2 ≤ ν * ν + 3)).trans hSb
  have hXid : (δ / P) ^ 2 * X ^ 2 = 4096 * P ^ 2 := by
    rw [hX]; field_simp; ring
  have k4 : 32 ≤ (δ / P) ^ 2 * (4 * (S : ℝ) + 1) := by
    have h1 : (δ / P) ^ 2 * (4 * X ^ 2) ≤ (δ / P) ^ 2 * (4 * (S : ℝ) + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (sq_nonneg _)
    have h2 : (δ / P) ^ 2 * (4 * X ^ 2) = 4 * ((δ / P) ^ 2 * X ^ 2) := by ring
    rw [h2, hXid] at h1
    linarith
  have k5 : δ / P * (4 * (S : ℝ) + 1) ^ ν ≤ δ * (((2 * S + 1 : ℕ) : ℝ) ^ ν) := by
    have h1 : (4 * (S : ℝ) + 1) ^ ν ≤ (2 * (2 * (S : ℝ) + 1)) ^ ν :=
      pow_le_pow_left₀ (by positivity) (by linarith) ν
    rw [mul_pow, ← hP] at h1
    push_cast
    calc δ / P * (4 * (S : ℝ) + 1) ^ ν ≤ δ / P * (P * (2 * (S : ℝ) + 1) ^ ν) :=
          mul_le_mul_of_nonneg_left h1 k1.le
      _ = δ * (2 * (S : ℝ) + 1) ^ ν := by field_simp
  have h2X : 2 / (δ / P) ≤ X := by
    rw [hX, div_div_eq_mul_div]
    exact div_le_div_of_nonneg_right (by linarith) hδ.le
  have hpow : (2 / (δ / P)) ^ (ν * ν) ≤ X ^ (ν * ν) :=
    pow_le_pow_left₀ (div_nonneg (by norm_num) k1.le) h2X _
  have k6 : (2 / (δ / P)) ^ (ν * ν) ≤ X ^ (ν * ν + 3) :=
    hpow.trans (pow_le_pow_right₀ hX1 (by omega))
  have hDpos : 0 < (δ / P) ^ 2 * (4 * (S : ℝ) + 1) := mul_pos (pow_pos k1 2) (by positivity)
  have hE0 : 0 ≤ ε / (S : ℝ) := div_nonneg hε hSpos.le
  have hden : 8 * (2 * ε) / ((δ / P) ^ 2 * (4 * (S : ℝ) + 1)) ≤ X ^ 3 * (ε / (S : ℝ)) := by
    rw [div_le_iff₀ hDpos]
    have hX32 : X ^ 2 ≤ X ^ 3 := pow_le_pow_right₀ hX1 (by norm_num)
    have h1 : X ^ 2 * (ε / (S : ℝ)) * ((δ / P) ^ 2 * (4 * (S : ℝ)))
        ≤ X ^ 3 * (ε / (S : ℝ)) * ((δ / P) ^ 2 * (4 * (S : ℝ) + 1)) :=
      mul_le_mul (mul_le_mul_of_nonneg_right hX32 hE0)
        (mul_le_mul_of_nonneg_left (by linarith) (sq_nonneg _))
        (mul_nonneg (sq_nonneg _) (by positivity)) (mul_nonneg (pow_nonneg hXpos.le 3) hE0)
    have h2 : X ^ 2 * (ε / (S : ℝ)) * ((δ / P) ^ 2 * (4 * (S : ℝ)))
        = 4 * ((δ / P) ^ 2 * X ^ 2) * ε := by
      field_simp
    rw [h2, hXid] at h1
    have h3 : 1 * ε ≤ P ^ 2 * ε := mul_le_mul_of_nonneg_right hP2 hε
    linarith
  have k7 : ∀ q : ℝ, 0 ≤ q → q ≤ (2 / (δ / P)) ^ (ν * ν) →
      q * (8 * (2 * ε) / ((δ / P) ^ 2 * (4 * (S : ℝ) + 1))) ≤ X ^ (ν * ν + 3) * ε / (S : ℝ) := by
    intro q hq0 hq
    calc q * (8 * (2 * ε) / ((δ / P) ^ 2 * (4 * (S : ℝ) + 1)))
        ≤ X ^ (ν * ν) * (X ^ 3 * (ε / (S : ℝ))) :=
          mul_le_mul (hq.trans hpow) hden (div_nonneg (by linarith) hDpos.le)
            (pow_nonneg hXpos.le _)
      _ = X ^ (ν * ν + 3) * ε / (S : ℝ) := by rw [pow_add]; ring
  
  have hGpos : 0 < G.card := by
    have h1 : 0 < δ * (((2 * S + 1 : ℕ) : ℝ) ^ ν) := mul_pos hδ (pow_pos (by positivity) _)
    have h2 : (0 : ℝ) < (G.card : ℝ) := lt_of_lt_of_le h1 hcard
    exact_mod_cast h2
  obtain ⟨z₀, hz₀⟩ := Finset.card_pos.mp hGpos
  obtain ⟨D, hD⟩ : ∃ D : Finset (Fin ν → ℤ), D = G.image (fun z => z - z₀) := ⟨_, rfl⟩
  have hDcard : D.card = G.card := by
    rw [hD]; exact Finset.card_image_of_injective G (sub_left_injective)
  have hDsub : D ⊆ intBox ν (2 * S) := by
    intro h hh
    simp only [hD, Finset.mem_image] at hh
    obtain ⟨z, hz, rfl⟩ := hh
    have hz' := hG hz
    have hz₀' := hG hz₀
    simp only [intBox, Finset.mem_Icc, Pi.le_def] at hz' hz₀' ⊢
    obtain ⟨a1, a2⟩ := hz'
    obtain ⟨b1, b2⟩ := hz₀'
    refine ⟨fun i => ?_, fun i => ?_⟩
    · have := a1 i; have := b2 i; simp only [Pi.sub_apply]; push_cast; omega
    · have := a2 i; have := b1 i; simp only [Pi.sub_apply]; push_cast; omega
  have hDgood : ∀ h ∈ D, |(∑ l, lam l * ((h l : ℤ) : ℝ))
      - ((round (∑ l, lam l * ((h l : ℤ) : ℝ)) : ℤ) : ℝ)| ≤ 2 * ε := by
    intro h hh
    simp only [hD, Finset.mem_image] at hh
    obtain ⟨z, hz, rfl⟩ := hh
    obtain ⟨k, hk⟩ := hgood z hz
    obtain ⟨k₀, hk₀⟩ := hgood z₀ hz₀
    have hx : (∑ l, lam l * (((z - z₀) l : ℤ) : ℝ))
        = (∑ l, lam l * ((z l : ℤ) : ℝ)) - ∑ l, lam l * ((z₀ l : ℤ) : ℝ) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      simp only [Pi.sub_apply, Int.cast_sub]
      ring
    calc |(∑ l, lam l * (((z - z₀) l : ℤ) : ℝ))
          - ((round (∑ l, lam l * (((z - z₀) l : ℤ) : ℝ)) : ℤ) : ℝ)|
        ≤ |(∑ l, lam l * (((z - z₀) l : ℤ) : ℝ)) - ((k - k₀ : ℤ) : ℝ)| := round_le _ _
      _ = |(c + ∑ l, lam l * ((z l : ℤ) : ℝ) - (k : ℝ))
            - (c + ∑ l, lam l * ((z₀ l : ℤ) : ℝ) - (k₀ : ℝ))| := by
          rw [hx]; congr 1; push_cast; ring
      _ ≤ |c + ∑ l, lam l * ((z l : ℤ) : ℝ) - (k : ℝ)|
            + |c + ∑ l, lam l * ((z₀ l : ℤ) : ℝ) - (k₀ : ℝ)| := abs_sub _ _
      _ ≤ ε + ε := add_le_add hk hk₀
      _ = 2 * ε := by ring
  
  obtain ⟨q, hq1, hqle, hqa⟩ := kai_qwi_quadratic_denominator ν S (fun _ l' => lam l') (δ / P)
    (2 * ε) D hS k1 k2 (by linarith) k3 k4 hDsub (by rw [hDcard]; exact k5.trans hcard)
    (fun h hh _ => hDgood h hh)
  refine ⟨q, hq1, hqle.trans k6, fun l => ⟨round ((q : ℝ) * lam l), ?_⟩⟩
  exact (hqa l l).trans (k7 q (Nat.cast_nonneg q) hqle)

theorem kai_qv_popular_differences (ν S : ℕ) (δ : ℝ) (G : Finset (Fin ν → ℤ))
    (hδ : 0 < δ) (hG : G ⊆ intBox ν S)
    (hcard : δ * (((2 * S + 1 : ℕ) : ℝ) ^ ν) ≤ (G.card : ℝ)) :
    ∃ H : Finset (Fin ν → ℤ), H ⊆ intBox ν (2 * S) ∧
      δ ^ 2 / 2 ^ (ν + 1) * (4 * (S : ℝ) + 1) ^ ν ≤ (H.card : ℝ) ∧
      ∀ h ∈ H, ∃ Gh : Finset (Fin ν → ℤ), Gh ⊆ G ∧ (∀ z ∈ Gh, z + h ∈ G) ∧
        δ ^ 2 / 2 ^ (2 * ν + 1) * (4 * (S : ℝ) + 1) ^ ν ≤ (Gh.card : ℝ) :=
by
  
