                c j * (kaiTBUnitLog K (H j) v * e i v))
                = if j = i then c j else 0 := by
            intro j
            rw [← Finset.mul_sum, hD6 j i]
            by_cases hji : j = i
            · simp [hji]
            · simp [hji]
          rw [Finset.sum_congr rfl (fun j (_ : j ∈ Finset.univ) => h4 j)]
          simp
        rw [h1, Finset.sum_add_distrib, h2, h3, zero_add]
    obtain ⟨F, hFdef⟩ :
        ∃ F : Fin (NumberField.Units.rank K + 1) → (NumberField.InfinitePlace K → ℝ),
          F = Fin.cons (fun v : NumberField.InfinitePlace K => (v.mult : ℝ))
                (fun j => kaiTBUnitLog K (H j)) := ⟨_, rfl⟩
    have hF0 : ∀ v : NumberField.InfinitePlace K, F 0 v = (v.mult : ℝ) := by
      intro v; rw [hFdef, Fin.cons_zero]
    have hFs : ∀ (j : Fin (NumberField.Units.rank K)) (v : NumberField.InfinitePlace K),
        F j.succ v = kaiTBUnitLog K (H j) v := by
      intro j v; rw [hFdef, Fin.cons_succ]
    have hsplit : ∀ (g : Fin (NumberField.Units.rank K + 1) → ℝ)
        (v : NumberField.InfinitePlace K),
        (∑ k, g k • F k) v
          = g 0 * (v.mult : ℝ) + ∑ j, g j.succ * kaiTBUnitLog K (H j) v := by
      intro g v
      rw [Finset.sum_apply, Fin.sum_univ_succ]
      simp only [Pi.smul_apply, smul_eq_mul, hF0, hFs]
    have hli : LinearIndependent ℝ F := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      have hpt : ∀ v : NumberField.InfinitePlace K,
          (0 : ℝ) = g 0 * (v.mult : ℝ) + ∑ j, g j.succ * kaiTBUnitLog K (H j) v := by
        intro v
        have h := hsplit g v
        rw [hg] at h
        exact h
      obtain ⟨h1, h2⟩ := hkey (g 0) (fun j => g j.succ)
        (fun _ : NumberField.InfinitePlace K => (0 : ℝ)) hpt
      have hg0 : g 0 = 0 := by
        have h3 : g 0 * (Module.finrank ℚ K : ℝ) = 0 := by rw [h1]; simp
        exact (mul_eq_zero.mp h3).resolve_right hn
      intro k
      refine Fin.cases ?_ ?_ k
      · exact hg0
      · intro i
        have h4 := h2 i
        simpa using h4
    have hspan : Submodule.span ℝ (Set.range F) = ⊤ := by
      refine hli.span_eq_top_of_card_eq_finrank ?_
      rw [Fintype.card_fin, Module.finrank_fintype_fun_eq_card, hcard]
    have hymem : (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * Real.log (v y))
        ∈ Submodule.span ℝ (Set.range F) := by
      rw [hspan]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hymem
    have hcpt : ∀ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * Real.log (v y)
          = c 0 * (v.mult : ℝ) + ∑ j, c j.succ * kaiTBUnitLog K (H j) v := by
      intro v
      have h := hsplit c v
      rw [hc] at h
      exact h
    obtain ⟨hA, hB⟩ := hkey (c 0) (fun j => c j.succ)
      (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * Real.log (v y)) hcpt
    have hc0 : c 0
        = (1 / (Module.finrank ℚ K : ℝ)) * Real.log |(((Algebra.norm ℚ) y : ℚ) : ℝ)| := by
      rw [hnorm, ← hA]
      field_simp
    have hpair : ∀ j : Fin (NumberField.Units.rank K),
        c j.succ = kaiTBPair K (e j) y := by
      intro j
      rw [hB j]
      rfl
    have hmultne : (w.mult : ℝ) ≠ 0 := by
      have h5 : (0 : ℝ) < (w.mult : ℝ) := by
        exact_mod_cast (NumberField.InfinitePlace.mult_pos : 0 < w.mult)
      exact ne_of_gt h5
    have hshape : kaiTBShapeLog K H (fun j => kaiTBPair K (e j) y) w
        = ∑ j, kaiTBPair K (e j) y
            * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) := rfl
    have hunit : ∀ j : Fin (NumberField.Units.rank K),
        kaiTBUnitLog K (H j) w
          = (w.mult : ℝ)
              * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) := fun j => rfl
    have p2 : (∑ j, c j.succ * kaiTBUnitLog K (H j) w)
        = (w.mult : ℝ) * kaiTBShapeLog K H (fun j => kaiTBPair K (e j) y) w := by
      rw [hshape, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hpair j, hunit j]
      ring
    refine mul_left_cancel₀ hmultne ?_
    rw [hcpt w, hc0, p2]
    ring
  
  have hbpf : ∀ M : ℝ, {y : NumberField.RingOfIntegers K |
      ∀ w : NumberField.InfinitePlace K,
        w ((y : NumberField.RingOfIntegers K) : K) ≤ M}.Finite := by
    intro M
    have hT : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ M}.Finite :=
      NumberField.Embeddings.finite_of_norm_le K ℂ M
    have hinj : Function.Injective (fun y : NumberField.RingOfIntegers K => (y : K)) := by
      intro a b h
      exact NumberField.RingOfIntegers.ext h
    have hpre : ((fun y : NumberField.RingOfIntegers K => (y : K)) ⁻¹'
        {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ M}).Finite :=
      Set.Finite.preimage hinj.injOn hT
    refine hpre.subset ?_
    intro y hy
    refine ⟨y.isIntegral_coe, fun φ => ?_⟩
    have h := hy (NumberField.InfinitePlace.mk φ)
    rw [NumberField.InfinitePlace.apply] at h
    exact h
  
  obtain ⟨-, -, -, -, hD5, -, -, -, -, -⟩ := hdata
  have hHlog : ∀ j (v : NumberField.InfinitePlace K),
      |Real.log (v (((H j : NumberField.RingOfIntegers K)) : K))|
        ≤ B * (Ideal.absNorm q : ℝ) := by
    intro j v
    have h := hD5 j v
    have hu : kaiTBUnitLog K (H j) v
        = (v.mult : ℝ) * Real.log (v (((H j : NumberField.RingOfIntegers K)) : K)) := rfl
    rw [hu, abs_mul] at h
    have hm1 : (1 : ℝ) ≤ (v.mult : ℝ) := by
      exact_mod_cast (NumberField.InfinitePlace.mult_pos : 0 < v.mult)
    rw [abs_of_pos (by linarith : (0 : ℝ) < (v.mult : ℝ))] at h
    have := le_mul_of_one_le_left (abs_nonneg
      (Real.log (v (((H j : NumberField.RingOfIntegers K)) : K)))) hm1
    linarith
  set x' : ℝ := max x 1 with hx'def
  set M : ℝ := Real.exp (Real.log x' + ∑ j : Fin (NumberField.Units.rank K),
      ((|u j| + |u j + γ j|) * (B * (Ideal.absNorm q : ℝ)))) with hMdef
  refine (hbpf M).subset ?_
  intro π hP w
  simp only [Set.mem_setOf_eq, KaiTBMem] at hP
  obtain ⟨hprime, -, -, hnormx, hW, -⟩ := hP
  have hπ0 : π ≠ 0 := hprime.ne_zero
  have hπK : ((π : NumberField.RingOfIntegers K) : K) ≠ 0 := by simpa using hπ0
  have hs1 := hident ((π : NumberField.RingOfIntegers K) : K) hπK w
  have hnormQ : |(((Algebra.norm ℚ) ((π : NumberField.RingOfIntegers K) : K) : ℚ) : ℝ)|
      = ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) := by
    rw [← Algebra.coe_norm_int, Nat.cast_natAbs]
    push_cast
    rfl
  have hx'1 : (1 : ℝ) ≤ x' := le_max_right _ _
  have hlogN0 : (0:ℝ)
      ≤ Real.log |(((Algebra.norm ℚ) ((π : NumberField.RingOfIntegers K) : K) : ℚ) : ℝ)| := by
    rw [hnormQ]; exact Real.log_natCast_nonneg _
  have hlogNT :
      Real.log |(((Algebra.norm ℚ) ((π : NumberField.RingOfIntegers K) : K) : ℚ) : ℝ)|
        ≤ Real.log x' := by
    rw [hnormQ]
    rcases eq_or_lt_of_le (Nat.cast_nonneg
        ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs) :
        (0:ℝ) ≤ ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) with h0 | h0
    · rw [← h0, Real.log_zero]; exact Real.log_nonneg hx'1
    · exact Real.log_le_log h0 (hnormx.trans (le_max_left x 1))
  have hnpos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast (Module.finrank_pos : 0 < Module.finrank ℚ K)
  have hninv0 : (0:ℝ) ≤ 1 / (Module.finrank ℚ K : ℝ) := by positivity
  have hninv1 : 1 / (Module.finrank ℚ K : ℝ) ≤ 1 := by
    rw [div_le_one hnpos]
    exact_mod_cast (Module.finrank_pos : 0 < Module.finrank ℚ K)
  have hterm1 : (1 / (Module.finrank ℚ K : ℝ)) *
      Real.log |(((Algebra.norm ℚ) ((π : NumberField.RingOfIntegers K) : K) : ℚ) : ℝ)|
        ≤ Real.log x' := by
    nlinarith [hlogN0, hlogNT, hninv0, hninv1]
  have hshape : kaiTBShapeLog K H
      (fun j => kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)) w
        ≤ ∑ j : Fin (NumberField.Units.rank K),
            ((|u j| + |u j + γ j|) * (B * (Ideal.absNorm q : ℝ))) := by
    have hexp : kaiTBShapeLog K H
        (fun j => kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)) w
        = ∑ j : Fin (NumberField.Units.rank K),
            kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K) *
              Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) := rfl
    rw [hexp]
    refine le_trans (le_abs_self _) ?_
    refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
    refine Finset.sum_le_sum ?_
    intro j _
    rw [abs_mul]
    have hWj0 := hW j
    simp only [Set.mem_Ioc] at hWj0
    have hWj : |kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)|
        ≤ |u j| + |u j + γ j| := by
      rw [abs_le]
      constructor
      · have := neg_abs_le (u j)
        have := abs_nonneg (u j + γ j)
        linarith [hWj0.1]
      · have := le_abs_self (u j + γ j)
        have := abs_nonneg (u j)
        linarith [hWj0.2]
    exact mul_le_mul hWj (hHlog j w) (abs_nonneg _) (by positivity)
  have hlogw : Real.log (w ((π : NumberField.RingOfIntegers K) : K))
      ≤ Real.log x' + ∑ j : Fin (NumberField.Units.rank K),
          ((|u j| + |u j + γ j|) * (B * (Ideal.absNorm q : ℝ))) := by
    rw [hs1]; linarith
  have hwpos : (0:ℝ) < w ((π : NumberField.RingOfIntegers K) : K) :=
    NumberField.InfinitePlace.pos_iff.mpr hπK
  calc w ((π : NumberField.RingOfIntegers K) : K)
      = Real.exp (Real.log (w ((π : NumberField.RingOfIntegers K) : K))) :=
        (Real.exp_log hwpos).symm
    _ ≤ M := by rw [hMdef]; exact Real.exp_le_exp.mpr hlogw

theorem kai_tb_pair_bound (K : Type u) [Field K] [NumberField K]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e)
    (X : ℝ) (hX : 1 ≤ X) (x : NumberField.RingOfIntegers K) (hx : x ≠ 0)
    (hxX : ∀ w : NumberField.InfinitePlace K, w ((x : NumberField.RingOfIntegers K) : K) ≤ X)
    (j : Fin (NumberField.Units.rank K)) :
    |kaiTBPair K (e j) ((x : NumberField.RingOfIntegers K) : K)|
      ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
          * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X :=
by
  classical
  obtain ⟨-, -, -, -, -, -, -, he, -⟩ := hdata
  have hM : 0 ≤ Real.log X := Real.log_nonneg hX
  have hx' : ((x : NumberField.RingOfIntegers K) : K) ≠ 0 := by exact_mod_cast hx
  have hpos : ∀ w : NumberField.InfinitePlace K,
      0 < w ((x : NumberField.RingOfIntegers K) : K) := fun w => w.pos_iff.2 hx'
  have hm1 : ∀ w : NumberField.InfinitePlace K, (1 : ℝ) ≤ (w.mult : ℝ) := fun w => by
    exact_mod_cast w.mult_pos
  have hn : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ))
      = (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
  have hn1 : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) :=
    Nat.one_le_cast.mpr Module.finrank_pos
  have hup : ∀ w : NumberField.InfinitePlace K,
      Real.log (w ((x : NumberField.RingOfIntegers K) : K)) ≤ Real.log X :=
    fun w => Real.log_le_log (hpos w) (hxX w)
  have hsumlog : 0 ≤ ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * Real.log (w ((x : NumberField.RingOfIntegers K) : K)) := by
    have h1 : ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * Real.log (w ((x : NumberField.RingOfIntegers K) : K))
        = Real.log (∏ w : NumberField.InfinitePlace K,
            w ((x : NumberField.RingOfIntegers K) : K) ^ w.mult) := by
      rw [Real.log_prod (fun w _ => pow_ne_zero _ (hpos w).ne')]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [Real.log_pow]
    rw [h1, NumberField.InfinitePlace.prod_eq_abs_norm, ← Algebra.coe_norm_int]
    push_cast
    rw [Real.log_abs]
    exact Real.log_intCast_nonneg _
  have hcore : ∀ w₀ : NumberField.InfinitePlace K,
      |Real.log (w₀ ((x : NumberField.RingOfIntegers K) : K))|
        ≤ (Module.finrank ℚ K : ℝ) * Real.log X := by
    intro w₀
    have hf : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
        0 ≤ (w.mult : ℝ) * (Real.log X - Real.log (w ((x : NumberField.RingOfIntegers K) : K))) :=
      fun w _ => mul_nonneg (by linarith [hm1 w]) (by linarith [hup w])
    have hsingle := Finset.single_le_sum hf (Finset.mem_univ w₀)
    have hsum : ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (Real.log X - Real.log (w ((x : NumberField.RingOfIntegers K) : K)))
        = (Module.finrank ℚ K : ℝ) * Real.log X - ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * Real.log (w ((x : NumberField.RingOfIntegers K) : K)) := by
      rw [← hn, Finset.sum_mul, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      ring
    rw [hsum] at hsingle
    have h2 : Real.log X - Real.log (w₀ ((x : NumberField.RingOfIntegers K) : K))
        ≤ (w₀.mult : ℝ) * (Real.log X - Real.log (w₀ ((x : NumberField.RingOfIntegers K) : K))) :=
      le_mul_of_one_le_left (by linarith [hup w₀]) (hm1 w₀)
    have h3 : Real.log X ≤ (Module.finrank ℚ K : ℝ) * Real.log X :=
      le_mul_of_one_le_left hM hn1
    rw [abs_le]
    constructor
    · linarith
    · linarith [hup w₀]
  unfold kaiTBPair
  calc |∑ w : NumberField.InfinitePlace K, e j w * ((w.mult : ℝ)
          * Real.log (w ((x : NumberField.RingOfIntegers K) : K)))|
      ≤ ∑ w : NumberField.InfinitePlace K, |e j w * ((w.mult : ℝ)
          * Real.log (w ((x : NumberField.RingOfIntegers K) : K)))| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ w : NumberField.InfinitePlace K,
          B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
            * (Module.finrank ℚ K : ℝ) * Real.log X * (w.mult : ℝ) := by
        apply Finset.sum_le_sum
        intro w _
        have hmw : (0 : ℝ) < (w.mult : ℝ) := by linarith [hm1 w]
        rw [abs_mul, abs_mul, abs_of_pos hmw]
        have hD0 : 0 ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K :=
          (abs_nonneg _).trans (he j w)
        calc |e j w| * ((w.mult : ℝ) * |Real.log (w ((x : NumberField.RingOfIntegers K) : K))|)
            ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
                * ((w.mult : ℝ) * ((Module.finrank ℚ K : ℝ) * Real.log X)) :=
              mul_le_mul (he j w) (mul_le_mul_of_nonneg_left (hcore w) hmw.le)
                (by positivity) hD0
          _ = B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
                * (Module.finrank ℚ K : ℝ) * Real.log X * (w.mult : ℝ) := by ring
    _ = B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
          * (Module.finrank ℚ K : ℝ) * Real.log X * (Module.finrank ℚ K : ℝ) := by
        rw [← Finset.mul_sum, hn]
    _ = B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
          * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X := by ring

theorem kai_cell_sign_place_bound (K : Type u) [Field K] [NumberField K]
    (X : ℝ) (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hab : ∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ (0 ≤ a w ∨ b w ≤ 0))
    (hσ : ∀ p, σ p ≤ X)
    (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (hsgn : ∀ w, sgn w = true ↔ 0 ≤ a w)
    (x : K) (hx : x ≠ 0)
    (hmem : NumberField.mixedEmbedding K x ∈ kaiCell K a b ρ σ θ₁ θ₂) :
    (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        if sgn w then 0 < (NumberField.mixedEmbedding K x).1 w
        else (NumberField.mixedEmbedding K x).1 w < 0) ∧
    (∀ w : NumberField.InfinitePlace K, w x ≤ X) :=
by
  simp only [kaiCell, Set.mem_setOf_eq] at hmem
  obtain ⟨hR, hC⟩ := hmem
  have hreal : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      w.1 x = |(NumberField.mixedEmbedding K x).1 w| := by
    intro w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w.1 x,
      NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2, Real.norm_eq_abs]
  have hcplx : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsComplex),
      w x = ‖(NumberField.mixedEmbedding K x).2 ⟨w, hw⟩‖ := by
    intro w hw
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w x,
      NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw]
  refine ⟨fun w => ?_, fun w => ?_⟩
  · cases h : sgn w
    · have hna : ¬ (0 ≤ a w) := by
        intro h0
        have := (hsgn w).2 h0
        rw [h] at this
        exact Bool.false_ne_true this
      have hb : b w ≤ 0 := by
        rcases (hab w).2.2.2 with h1 | h1
        · exact absurd h1 hna
        · exact h1
      have hle : (NumberField.mixedEmbedding K x).1 w ≤ 0 := ((hR w).2).trans hb
      have hpos : 0 < w.1 x := (NumberField.InfinitePlace.pos_iff).2 hx
      rw [hreal w] at hpos
      have hne : (NumberField.mixedEmbedding K x).1 w ≠ 0 := abs_pos.mp hpos
      simp only [Bool.false_eq_true, if_false]
      exact lt_of_le_of_ne hle hne
    · have ha : 0 ≤ a w := (hsgn w).1 h
      simp only [if_true]
      exact lt_of_le_of_lt ha (hR w).1
  · rcases w.isReal_or_isComplex with hw | hw
    · have h1 := hreal ⟨w, hw⟩
      simp only at h1
      rw [h1]
      obtain ⟨hX1, -, hX2, -⟩ := hab ⟨w, hw⟩
      obtain ⟨hr1, hr2⟩ := hR ⟨w, hw⟩
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    · rw [hcplx w hw]
      exact ((hC ⟨w, hw⟩).2.1).trans (hσ ⟨w, hw⟩)

theorem kai_small_norm_budget (n r : ℕ) (hn : 1 ≤ n) (B Kq c₂ : ℝ)
    (hB : 1 ≤ B) (hKq : 0 ≤ Kq) (hc₂ : 0 < c₂) :
    ∃ c X₀ : ℝ, 0 < c ∧ 3 ≤ X₀ ∧
      ∀ X : ℝ, X₀ ≤ X →
        1 ≤ X ^ n * Real.exp (-2 * Real.sqrt (Real.log X)) ∧
        ∀ N : ℝ, 1 ≤ N → N ≤ Real.exp (Real.log X ^ ((1:ℝ)/4)) →
          (2 * (B * N ^ r * (n : ℝ) ^ 2 * Real.log X) + 5) ^ r * (3 * (Kq * N ^ r) + c₂)
              * (X ^ n * Real.exp (-2 * Real.sqrt (Real.log X)))
            ≤ c * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c) :=
by
  have hB0 : 0 ≤ B := by linarith
  have hBn : 0 ≤ 2 * B * (n : ℝ) ^ 2 := mul_nonneg (mul_nonneg (by norm_num) hB0) (sq_nonneg _)
  obtain ⟨A, hA_def⟩ : ∃ A : ℝ, A = (2 * B * (n : ℝ) ^ 2 + 5) ^ r * (3 * Kq + c₂) := ⟨_, rfl⟩
  obtain ⟨m, hm_def⟩ : ∃ m : ℝ, m = (r : ℝ) ^ 2 + 5 * (r : ℝ) := ⟨_, rfl⟩
  have hA : 0 < A := by
    rw [hA_def]
    exact mul_pos (pow_pos (by linarith) r) (by linarith)
  
  have factor : ∀ u N : ℝ, 1 ≤ u → 1 ≤ N → N ≤ Real.exp u →
      (2 * (B * N ^ r * (n : ℝ) ^ 2 * u ^ 4) + 5) ^ r * (3 * (Kq * N ^ r) + c₂)
        ≤ A * Real.exp (m * u) := by
    intro u N hu hN1 hNu
    have hE1 : 1 ≤ Real.exp u := by have := Real.add_one_le_exp u; linarith
    have huE : u ≤ Real.exp u := by have := Real.add_one_le_exp u; linarith
    have hM1 : 1 ≤ N ^ r := one_le_pow₀ hN1
    have hME : N ^ r ≤ Real.exp u ^ r := pow_le_pow_left₀ (by linarith) hNu r
    have hu4 : 1 ≤ u ^ 4 := one_le_pow₀ hu
    have hu4E : u ^ 4 ≤ Real.exp u ^ 4 := pow_le_pow_left₀ (by linarith) huE 4
    have hMu : 1 ≤ N ^ r * u ^ 4 := one_le_mul_of_one_le_of_one_le hM1 hu4
    have hMuE : N ^ r * u ^ 4 ≤ Real.exp u ^ r * Real.exp u ^ 4 :=
      mul_le_mul hME hu4E (by linarith) (by positivity)
    have hP0 : 0 ≤ 2 * (B * N ^ r * (n : ℝ) ^ 2 * u ^ 4) + 5 := by
      have := mul_nonneg (mul_nonneg (mul_nonneg hB0 (pow_nonneg (by linarith : (0:ℝ) ≤ N) r))
        (sq_nonneg (n : ℝ))) (by positivity : (0:ℝ) ≤ u ^ 4)
      linarith
    have hP : 2 * (B * N ^ r * (n : ℝ) ^ 2 * u ^ 4) + 5
        ≤ (2 * B * (n : ℝ) ^ 2 + 5) * Real.exp u ^ (r + 4) := by
      have h1 : 2 * (B * N ^ r * (n : ℝ) ^ 2 * u ^ 4) + 5
          ≤ (2 * B * (n : ℝ) ^ 2 + 5) * (N ^ r * u ^ 4) := by
        have e : 2 * (B * N ^ r * (n : ℝ) ^ 2 * u ^ 4) = 2 * B * (n : ℝ) ^ 2 * (N ^ r * u ^ 4) := by
          ring
        rw [e]
        nlinarith
      have h2 : (2 * B * (n : ℝ) ^ 2 + 5) * (N ^ r * u ^ 4)
          ≤ (2 * B * (n : ℝ) ^ 2 + 5) * Real.exp u ^ (r + 4) := by
        rw [pow_add]; exact mul_le_mul_of_nonneg_left hMuE (by linarith)
      linarith
    have hPr : (2 * (B * N ^ r * (n : ℝ) ^ 2 * u ^ 4) + 5) ^ r
        ≤ (2 * B * (n : ℝ) ^ 2 + 5) ^ r * Real.exp u ^ ((r + 4) * r) := by
      rw [pow_mul, ← mul_pow]; exact pow_le_pow_left₀ hP0 hP r
    have hEr1 : 1 ≤ Real.exp u ^ r := one_le_pow₀ hE1
    have hQ : 3 * (Kq * N ^ r) + c₂ ≤ (3 * Kq + c₂) * Real.exp u ^ r := by
      have h1 : Kq * N ^ r ≤ Kq * Real.exp u ^ r := mul_le_mul_of_nonneg_left hME hKq
      have h2 : c₂ ≤ c₂ * Real.exp u ^ r := le_mul_of_one_le_right hc₂.le hEr1
      nlinarith
    have hQ0 : 0 ≤ 3 * (Kq * N ^ r) + c₂ := by
      have := mul_nonneg hKq (pow_nonneg (by linarith : (0:ℝ) ≤ N) r)
      linarith
    have hR0 : 0 ≤ (2 * B * (n : ℝ) ^ 2 + 5) ^ r * Real.exp u ^ ((r + 4) * r) :=
      mul_nonneg (pow_nonneg (by linarith) r) (by positivity)
    calc (2 * (B * N ^ r * (n : ℝ) ^ 2 * u ^ 4) + 5) ^ r * (3 * (Kq * N ^ r) + c₂)
        ≤ ((2 * B * (n : ℝ) ^ 2 + 5) ^ r * Real.exp u ^ ((r + 4) * r))
            * ((3 * Kq + c₂) * Real.exp u ^ r) := mul_le_mul hPr hQ hQ0 hR0
      _ = A * Real.exp u ^ ((r + 4) * r + r) := by rw [hA_def, pow_add]; ring
      _ = A * Real.exp (m * u) := by
          rw [← Real.exp_nat_mul, hm_def]; congr 2; push_cast; ring
  have h5 : (5:ℝ) ≤ Real.exp 4 := by have := Real.add_one_le_exp (4:ℝ); linarith
  have hc1 : 1 ≤ A * Real.exp (m ^ 2 / 4) + 1 := by
    have := mul_pos hA (Real.exp_pos (m ^ 2 / 4)); linarith
  refine ⟨A * Real.exp (m ^ 2 / 4) + 1, Real.exp 4, by linarith, by linarith, ?_⟩
  intro X hX
  have hXpos : 0 < X := by linarith
  have hX1 : 1 ≤ X := by linarith
  obtain ⟨L, hL_def⟩ : ∃ L, L = Real.log X := ⟨_, rfl⟩
  rw [← hL_def]
  have hL4 : 4 ≤ L := by
    rw [hL_def]
    calc (4:ℝ) = Real.log (Real.exp 4) := (Real.log_exp 4).symm
      _ ≤ Real.log X := Real.log_le_log (Real.exp_pos 4) hX
  have hL0 : 0 ≤ L := by linarith
  obtain ⟨t, ht_def⟩ : ∃ t, t = Real.sqrt L := ⟨_, rfl⟩
  rw [← ht_def]
  have ht2 : 2 ≤ t := by
    rw [ht_def]; exact (Real.le_sqrt (by norm_num) hL0).2 (by linarith)
  have htt : t * t = L := by rw [ht_def]; exact Real.mul_self_sqrt hL0
  have h2t : 2 * t ≤ L := by nlinarith
  have hXL : Real.exp L = X := by rw [hL_def]; exact Real.exp_log hXpos
  have hXn : X ≤ X ^ n := le_self_pow₀ hX1 (by omega)
  have hXn0 : 0 ≤ X ^ n := by positivity
  have hD0 : 0 ≤ X ^ n * Real.exp (-2 * t) := by positivity
  constructor
  · calc (1:ℝ) = Real.exp (2 * t) * Real.exp (-2 * t) := by
          rw [← Real.exp_add, show 2 * t + -2 * t = 0 by ring, Real.exp_zero]
      _ ≤ X ^ n * Real.exp (-2 * t) := by
          apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
          calc Real.exp (2 * t) ≤ Real.exp L := Real.exp_le_exp.2 h2t
            _ = X := hXL
            _ ≤ X ^ n := hXn
  · intro N hN1 hNu
    obtain ⟨u, hu_def⟩ : ∃ u, u = L ^ ((1:ℝ)/4) := ⟨_, rfl⟩
    rw [← hu_def] at hNu
    have hu1 : 1 ≤ u := by rw [hu_def]; exact Real.one_le_rpow (by linarith) (by norm_num)
    have hu4 : u ^ 4 = L := by
      rw [hu_def, ← Real.rpow_natCast, ← Real.rpow_mul hL0]; norm_num
    have hu2 : u ^ 2 = t := by
      rw [hu_def, ht_def, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hL0]; norm_num
    have hf := factor u N hu1 hN1 hNu
    rw [hu4] at hf
    have habs : Real.exp (m * u) ≤ Real.exp (m ^ 2 / 4) * Real.exp t := by
      rw [← Real.exp_add]; apply Real.exp_le_exp.2; nlinarith [sq_nonneg (u - m / 2)]
    have ht0 : 0 ≤ t := by linarith
    have hexpc : Real.exp (-t) ≤ Real.exp (-t / (A * Real.exp (m ^ 2 / 4) + 1)) := by
      apply Real.exp_le_exp.2
      rw [neg_div, neg_le_neg_iff]
      exact div_le_self ht0 hc1
    have hcomb : Real.exp t * Real.exp (-2 * t) = Real.exp (-t) := by
      rw [← Real.exp_add]; congr 1; ring
    calc (2 * (B * N ^ r * (n : ℝ) ^ 2 * L) + 5) ^ r * (3 * (Kq * N ^ r) + c₂)
          * (X ^ n * Real.exp (-2 * t))
        ≤ A * Real.exp (m * u) * (X ^ n * Real.exp (-2 * t)) :=
          mul_le_mul_of_nonneg_right hf hD0
      _ ≤ A * (Real.exp (m ^ 2 / 4) * Real.exp t) * (X ^ n * Real.exp (-2 * t)) := by
          apply mul_le_mul_of_nonneg_right _ hD0
          exact mul_le_mul_of_nonneg_left habs hA.le
      _ = (A * Real.exp (m ^ 2 / 4)) * X ^ n * (Real.exp t * Real.exp (-2 * t)) := by ring
      _ = (A * Real.exp (m ^ 2 / 4)) * X ^ n * Real.exp (-t) := by rw [hcomb]
      _ ≤ (A * Real.exp (m ^ 2 / 4) + 1) * X ^ n * Real.exp (-t) := by
          apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
          apply mul_le_mul_of_nonneg_right _ hXn0
          linarith
      _ ≤ (A * Real.exp (m ^ 2 / 4) + 1) * X ^ n
            * Real.exp (-t / (A * Real.exp (m ^ 2 / 4) + 1)) := by
          apply mul_le_mul_of_nonneg_left hexpc
          exact mul_nonneg (by linarith) hXn0

theorem kai_lp_cell_small_norm (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ B c₂ : ℝ, 1 ≤ B → 0 < c₂ → ∃ c X₀ : ℝ, 0 < c ∧ 3 ≤ X₀ ∧
      ∀ X : ℝ, X₀ ≤ X →
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        (Ideal.absNorm q : ℝ) ≤ Real.exp (Real.log X ^ ((1:ℝ)/4)) →
      ∀ (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ) (wq : ℕ)
        (Rq : ℝ) (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ),
        KaiTBUnitData K B q H wq Rq e →
      ∀ α : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {α}) q →
      ∀ ε β : ℝ, |ε| ≤ 1 → (ε = 0 ∨ (1 / 2 ≤ β ∧ β < 1)) →
      (∀ x : ℝ, X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)) ≤ x →
        ∀ u γ : Fin (NumberField.Units.rank K) → ℝ, (∀ j, 0 < γ j ∧ γ j ≤ 1) →
        ∀ vv ϑ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ,
          (∀ p, 0 < ϑ p ∧ ϑ p ≤ 1) →
          |(∑' π : {π : NumberField.RingOfIntegers K //
                KaiTBMem K q H e α
                  (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w))
                  u γ vv ϑ x π},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            - (∏ j, γ j) * (∏ p, ϑ p) *
              (((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
                (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
                  (NumberField.classNumber K : ℝ) *
                  (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
                  NumberField.Units.regulator K)) * (x - ε * (x ^ β / β))|
            ≤ c₂ * x * Real.exp (-Real.sqrt (Real.log x) / c₂)) →
      ∀ (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
        (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
        (∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ Real.sqrt X ≤ b w - a w ∧
          ((0 ≤ a w ∧ 0 < (NumberField.mixedEmbedding K (α : K)).1 w) ∨
           (b w ≤ 0 ∧ (NumberField.mixedEmbedding K (α : K)).1 w < 0))) →
        (∀ w, 0 ≤ ρ w ∧ ρ w < σ w ∧ σ w ≤ X ∧ Real.sqrt X ≤ σ w - ρ w ∧
          -Real.pi ≤ θ₁ w ∧ θ₁ w ≤ θ₂ w ∧ θ₂ w ≤ Real.pi) →
        |kaiPrimePsi K q α (kaiCell K a b ρ σ θ₁ θ₂)
          - (∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
                  π - α ∈ q ∧
                  X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X))
                    < ((Algebra.norm ℤ π).natAbs : ℝ)},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
          ≤ c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) :=
by
  classical
  intro B c₂ hB hc₂
  have hR : (0:ℝ) < NumberField.Units.regulator K := NumberField.Units.regulator_pos K
  have hn : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hB0 : (0:ℝ) < B := lt_of_lt_of_le one_pos hB
  obtain ⟨Kq, hKqdef⟩ : ∃ Kq : ℝ,
      Kq = ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * B / NumberField.Units.regulator K :=
    ⟨_, rfl⟩
  have hKq : 0 ≤ Kq := by
    rw [hKqdef]; exact div_nonneg (mul_nonneg (Nat.cast_nonneg _) hB0.le) hR.le
  obtain ⟨c, X₀, hc, hX₀, hbud⟩ :=
    kai_small_norm_budget (Module.finrank ℚ K) (NumberField.Units.rank K) hn B Kq c₂ hB hKq hc₂
  refine ⟨c, X₀, hc, hX₀, ?_⟩
  intro X hX q hq hqN H wq Rq e hdata α hα ε β hε hεβ hTB a b ρ σ θ₁ θ₂ hab hρσ
  have hX1 : (1:ℝ) ≤ X := by linarith
  have hN1 : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    have h0 : Ideal.absNorm q ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hq
    exact_mod_cast Nat.pos_of_ne_zero h0
  obtain ⟨hT1, hfinal⟩ := hbud X hX
  have hfin2 := hfinal (Ideal.absNorm q : ℝ) hN1 hqN
  clear hfinal hbud
  
  set T : ℝ := X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)) with hTdef
  set sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool :=
    fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w) with hsgndef
  have hTpos : (0:ℝ) < T := by linarith
  
  have hsgn : ∀ w, sgn w = true ↔ 0 ≤ a w := by
    intro w
    show decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w) = true ↔ 0 ≤ a w
    rw [decide_eq_true_iff]
    obtain ⟨-, h2, -, -, h5⟩ := hab w
    constructor
    · intro h
      rcases h5 with h5 | h5
      · exact h5.1
      · linarith [h5.2]
    · intro h
      rcases h5 with h5 | h5
      · exact h5.2
      · linarith [h5.1]
  
  have hab4 : ∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ (0 ≤ a w ∨ b w ≤ 0) := by
    intro w
    obtain ⟨h1, h2, h3, -, h5⟩ := hab w
    exact ⟨h1, h2, h3, h5.imp (fun h => h.1) (fun h => h.1)⟩
  have hσX : ∀ p, σ p ≤ X := fun p => (hρσ p).2.2.1
  
  have hcellmem : ∀ π : NumberField.RingOfIntegers K, π ≠ 0 →
      NumberField.mixedEmbedding K ((π : NumberField.RingOfIntegers K) : K)
          ∈ kaiCell K a b ρ σ θ₁ θ₂ →
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if sgn w then
            0 < (NumberField.mixedEmbedding K ((π : NumberField.RingOfIntegers K) : K)).1 w
          else (NumberField.mixedEmbedding K ((π : NumberField.RingOfIntegers K) : K)).1 w < 0) ∧
      (∀ w : NumberField.InfinitePlace K,
          w ((π : NumberField.RingOfIntegers K) : K) ≤ X) := by
    intro π hπ hmem
    have hπK : ((π : NumberField.RingOfIntegers K) : K) ≠ 0 := by
      simpa using hπ
    exact kai_cell_sign_place_bound K X a b ρ σ θ₁ θ₂ hab4 hσX sgn hsgn _ hπK hmem
  
  have hbpf : ∀ M : ℝ, {x : NumberField.RingOfIntegers K |
      ∀ w : NumberField.InfinitePlace K,
        w ((x : NumberField.RingOfIntegers K) : K) ≤ M}.Finite := by
    intro M
    have hT' : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ M}.Finite :=
      NumberField.Embeddings.finite_of_norm_le K ℂ M
    have hinj : Function.Injective (fun x : NumberField.RingOfIntegers K => (x : K)) :=
      fun x y h => NumberField.RingOfIntegers.ext h
    refine (Set.Finite.preimage hinj.injOn hT').subset ?_
    intro x hx
    refine ⟨x.isIntegral_coe, fun φ => ?_⟩
    have h := hx (NumberField.InfinitePlace.mk φ)
    rwa [NumberField.InfinitePlace.apply] at h
  have hfin : {π : NumberField.RingOfIntegers K |
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
        π - α ∈ q}.Finite := by
    refine Set.Finite.subset (hbpf X) ?_
    rintro π ⟨hp, hm, -⟩
    exact (hcellmem π hp.ne_zero hm).2
  
  set ΔW : ℝ := B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K *
      (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X with hΔWdef
  have hL0 : (0:ℝ) ≤ Real.log X := Real.log_nonneg hX1
  have hΔW0 : (0:ℝ) ≤ ΔW := by
    rw [hΔWdef]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB0.le (pow_nonneg (Nat.cast_nonneg _) _))
      (sq_nonneg _)) hL0
  set N₀ : ℕ := ⌈ΔW⌉₊ + 1 with hN₀def
  have hN₀val : (N₀ : ℝ) = ((⌈ΔW⌉₊ : ℕ) : ℝ) + 1 := by rw [hN₀def]; push_cast; ring
  have hN₀R : ΔW + 1 ≤ (N₀ : ℝ) := by
    rw [hN₀val]; linarith [Nat.le_ceil ΔW]
  set gg : NumberField.RingOfIntegers K → (Fin (NumberField.Units.rank K) → ℤ) :=
    fun π j => ⌈kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)⌉ - 1 with hggdef
  set JJ : Finset (Fin (NumberField.Units.rank K) → ℤ) :=
    Fintype.piFinset (fun _ => Finset.Icc (-(N₀ : ℤ)) ((N₀ : ℤ))) with hJJdef
  have hIoc : ∀ (π : NumberField.RingOfIntegers K) (j : Fin (NumberField.Units.rank K)),
      kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
        ∈ Set.Ioc (((gg π j : ℤ) : ℝ)) (((gg π j : ℤ) : ℝ) + 1) := by
    intro π j
    simp only [hggdef, Set.mem_Ioc]
    constructor
    · push_cast
      linarith [Int.ceil_lt_add_one (kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K))]
    · push_cast
      linarith [Int.le_ceil (kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K))]
  have hgJ : ∀ π : NumberField.RingOfIntegers K, π ≠ 0 →
      (∀ w : NumberField.InfinitePlace K, w ((π : NumberField.RingOfIntegers K) : K) ≤ X) →
      gg π ∈ JJ := by
    intro π hπ hplaces
    rw [hJJdef, Fintype.mem_piFinset]
    intro j
    rw [Finset.mem_Icc]
    have hbd : |kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)| ≤ ΔW := by
      rw [hΔWdef]; exact kai_tb_pair_bound K B q H wq Rq e hdata X hX1 π hπ hplaces j
    rw [abs_le] at hbd
    obtain ⟨hlo, hhi⟩ := hIoc π j
    constructor
    · have hcast : -((N₀ : ℕ) : ℝ) ≤ ((gg π j : ℤ) : ℝ) := by linarith [hN₀R, hbd.1, hhi]
      exact_mod_cast hcast
    · have hcast : ((gg π j : ℤ) : ℝ) ≤ ((N₀ : ℕ) : ℝ) := by linarith [hN₀R, hbd.2, hlo]
      exact_mod_cast hcast
  set PP : (Fin (NumberField.Units.rank K) → ℤ) → NumberField.RingOfIntegers K → Prop :=
    fun k π => KaiTBMem K q H e α sgn (fun j => ((k j : ℤ) : ℝ)) (fun _ => (1:ℝ))
      (fun _ => (0:ℝ)) (fun _ => (1:ℝ)) T π with hPPdef
  have hPfin : ∀ k ∈ JJ, {π : NumberField.RingOfIntegers K | PP k π}.Finite := by
    intro k _
    exact kai_tb_box_finite K B q H wq Rq e hdata α sgn _ _ _ _ T
  have hgcover : ∀ π : NumberField.RingOfIntegers K, Prime π →
      NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ → π - α ∈ q →
      ((Algebra.norm ℤ π).natAbs : ℝ) ≤ T → gg π ∈ JJ ∧ PP (gg π) π := by
    intro π hp hm hcong hnorm
    have hπ0 : π ≠ 0 := hp.ne_zero
    obtain ⟨hsign, hplaces⟩ := hcellmem π hπ0 hm
    refine ⟨hgJ π hπ0 hplaces, ?_⟩
    simp only [hPPdef, KaiTBMem]
    refine ⟨hp, hcong, hsign, hnorm, fun j => ?_, ?_⟩
    · have h := hIoc π j
      simpa using h
    intro p
    refine ⟨⌈kaiTBTheta K H e p ((π : NumberField.RingOfIntegers K) : K)⌉ - 1, ?_⟩
    simp only [Set.mem_Ioc]
    constructor
    · push_cast
      linarith [Int.ceil_lt_add_one
        (kaiTBTheta K H e p ((π : NumberField.RingOfIntegers K) : K))]
    · push_cast
      linarith [Int.le_ceil (kaiTBTheta K H e p ((π : NumberField.RingOfIntegers K) : K))]
  
  have hbr : ∀ (p : NumberField.RingOfIntegers K → Prop)
      (Fp : Finset (NumberField.RingOfIntegers K)), (∀ x, x ∈ Fp ↔ p x) →
      (∑' x : {x : NumberField.RingOfIntegers K // p x},
          Real.log ((Algebra.norm ℤ (x : NumberField.RingOfIntegers K)).natAbs : ℝ))
        = ∑ x ∈ Fp, Real.log ((Algebra.norm ℤ x).natAbs : ℝ) := by
    intro p Fp hFp
    haveI : Fintype {x : NumberField.RingOfIntegers K // p x} := Fintype.ofFinset Fp hFp
    rw [tsum_fintype]
    exact (Finset.sum_subtype Fp hFp
      (fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ))).symm
  obtain ⟨Ψab, hΨab⟩ : ∃ v : ℝ, v = ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
                  π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ)},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) :=
    ⟨_, rfl⟩
  rw [← hΨab]
  have hF : ∀ x : NumberField.RingOfIntegers K, x ∈ hfin.toFinset ↔
      (Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
        x - α ∈ q) :=
