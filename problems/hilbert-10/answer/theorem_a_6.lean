  have htA : t ≤ 2 ^ A * L ^ A := by rw [ht, ← mul_pow]; exact pow_le_pow_left₀ hu0 hu2 A
  have haL : (a : ℝ) ≤ L := by linarith
  have ha0 : (0 : ℝ) ≤ a := Nat.cast_nonneg a
  refine (s2 t η C₁ a ht0 hη (by linarith)).trans ?_
  rw [Real.exp_le_exp]
  
  have hn₁ : ((2 * (a + a) * a : ℕ) : ℝ) = 4 * ((a : ℝ) * a) := by push_cast; ring
  have hn₂ : (((a + a) * ν + 1 : ℕ) : ℝ) = 2 * (a : ℝ) * ν + 1 := by push_cast; ring
  rw [hn₁, hn₂]
  have hν0 : (0 : ℝ) ≤ ν := Nat.cast_nonneg ν
  have hC0 : (0 : ℝ) ≤ C₄ := Nat.cast_nonneg C₄
  have h2A : (0 : ℝ) ≤ 2 ^ A := by positivity
  have hP1 : 1 ≤ L ^ A := one_le_pow₀ hL1
  have hR : L ^ (A + 2) = L ^ A * L * L := by ring
  have hS : L ^ (A + 3) = L ^ (A + 2) * L := by ring
  have hR1 : 1 ≤ L ^ (A + 2) := one_le_pow₀ hL1
  have hLR : L ≤ L ^ (A + 2) := by
    have := pow_le_pow_right₀ hL1 (show 1 ≤ A + 2 by omega)
    rwa [pow_one] at this
  have hS1 : 1 ≤ L ^ (A + 3) := one_le_pow₀ hL1
  have hLS : L ≤ L ^ (A + 3) := by
    have := pow_le_pow_right₀ hL1 (show 1 ≤ A + 3 by omega)
    rwa [pow_one] at this
  have hPS : L ^ A ≤ L ^ (A + 3) := pow_le_pow_right₀ hL1 (by omega)
  have hb : 2 + t ≤ (2 + 2 ^ A) * L ^ A := by nlinarith
  have haa : (a : ℝ) * a ≤ L * L := mul_le_mul haL haL ha0 (by linarith)
  have hc : 4 * ((a : ℝ) * a) * (2 + t) ≤ (8 + 4 * 2 ^ A) * L ^ (A + 2) := by
