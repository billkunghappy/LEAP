      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) := by
    intro s
    unfold kaiHeckeSeries
    refine tsum_congr (fun I => ?_)
    have hI0 : (I : Ideal (NumberField.RingOfIntegers K)) ≠ ⊥ := I.2
    have hχ : kaiZFPrincipalChar K ⊤ (I : Ideal (NumberField.RingOfIntegers K)) = 1 := by
