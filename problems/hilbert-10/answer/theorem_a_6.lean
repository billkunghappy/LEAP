  have hq₀1r : (1 : ℝ) ≤ q₀ := by exact_mod_cast hq₀1
  have hq0 : (0 : ℝ) ≤ q₀ := by linarith
  have hqq : (q₀ : ℝ) * q₀ ≤ T₀ * T₀ := mul_le_mul hq₀T hq₀T hq0 hT₀0
  have hTT : T₀ * T₀ ≤ T₀ ^ 3 := by nlinarith
  have hL36 : (L : ℝ) ^ 3 ≤ (L : ℝ) ^ 6 := pow_le_pow_right₀ hL1 (by norm_num)
  have hKM1 : 1 ≤ (2 * (ν : ℝ) + 1) * M := one_le_mul_of_one_le_of_one_le hK1 hM1
  have hMK : M ≤ (2 * (ν : ℝ) + 1) * M := le_mul_of_one_le_left (by linarith) hK1
  have hsmall : 8 * (2 * (ν : ℝ) + 1) * T₀ * ((q₀ : ℝ) * q₀) * ((L : ℝ) * L) ^ 3 < N := by
    have h1 : T₀ * ((q₀ : ℝ) * q₀) * ((L : ℝ) * L) ^ 3 ≤ T₀ ^ 3 * (L : ℝ) ^ 6 := by
