      calc (Ideal.absNorm q : ℝ) = (Ideal.absNorm q : ℝ) * 1 * 1 := by ring
        _ ≤ (Ideal.absNorm q : ℝ) * (1 + kaiHZInfSize K t l) * (2 + |s.im|) :=
            mul_le_mul (mul_le_mul_of_nonneg_left (by linarith) (by linarith))
