theorem kai_siegel_model_package (K : Type u) [Field K] [NumberField K] :
    ∃ ρ : ℝ, 0 < ρ ∧
      ∀ (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ
            (NumberField.RingOfIntegers K)),
        IsNormLengthCompatible C ω → ∀ B : ℕ,
        ∃ (c C₀ C_B : ℝ) (k : ℕ), 0 < c ∧ 1 ≤ C₀ ∧ 0 ≤ C_B ∧
          ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
            Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
            (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
            ∃ g : NumberField.RingOfIntegers K → ℝ,
              (∀ x ∈ omegaBox ω M, |g x| ≤ C₀ * Real.log M ^ k) ∧
              gowersU3Pow ω (fun x => g x - cramerModel K ρ (primorial m) x) M
                ≤ C_B / Real.log M ^ B ∧
              ∀ φ : (Fin (Module.finrank ℚ K) → ℤ) → ℝ,
                IsNil2Seq (Module.finrank ℚ K) (Real.log M ^ c)
                  (Real.exp (Real.log M ^ c)) φ →
                |∑ x ∈ omegaBox ω M, (vonMangoldtO x - g x) * φ (ω.equivFun x)|
                  ≤ C₀ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ c)) :=
by
  obtain ⟨ρ, hρ, D, hD, hSiegel, hStep⟩ := kai_siegel_datum_step0 K
  obtain ⟨cW, hcW, hs2⟩ := kai_siegel_cramer_U3_bound K
  obtain ⟨C_M, hC_M, hdens⟩ := kai_cramer_density_bound K
  refine ⟨ρ, hρ, ?_⟩
  intro C ω hω B
  obtain ⟨CW, kW, hCW, hU3⟩ := hs2 ρ hρ.le C ω hω
  obtain ⟨c₁, C₁, hc₁, hC₁, hH⟩ := hStep C ω hω
  obtain ⟨c, C₀', hc, hC₀', hC⟩ := kai_nil2_orthogonality_reduction K C ω hω ρ hρ D hD hSiegel
    c₁ C₁ hc₁ hC₁ hH cW CW kW hcW hCW
    (fun M m hM h1 h2 hψ => hU3 M m (D M m) hM h1 h2 (hD M m) hψ)
  obtain ⟨A, hA_def⟩ : ∃ A : ℕ, A = ⌈((B : ℝ) + kW) / cW⌉₊ := ⟨_, rfl⟩
  obtain ⟨cA, hcA, hsieg⟩ := hSiegel A
  have hCM0 : (0 : ℝ) ≤ C_M := by linarith
  refine ⟨c, max C₀' (2 * ρ * C_M ^ Module.finrank ℚ K), CW / cA ^ cW,
    Module.finrank ℚ K, hc, le_max_of_le_left hC₀',
    div_nonneg hCW (Real.rpow_nonneg hcA.le _), ?_⟩
  intro M m hM h1 h2
  
  have hMpos : (0 : ℝ) < M := by linarith
  have hℓ1 : 1 < Real.log M := by
    rw [Real.lt_log_iff_exp_lt hMpos]
    have := Real.exp_one_lt_d9
    linarith
  have hℓ0 : 0 ≤ Real.log M := by linarith
  have hℓpos : 0 < Real.log M := by linarith
  have hm0 : (0 : ℝ) < m := lt_of_lt_of_le (Real.exp_pos _) h1
  have hlogm : Real.log m ≤ Real.log M := by
    have hA1 : Real.log m ≤ Real.log ((m : ℝ) + 1) := Real.log_le_log hm0 (by linarith)
    have hB1 : Real.log ((m : ℝ) + 1) ≤ Real.log M ^ ((1 : ℝ) / 3) := by
      calc Real.log ((m : ℝ) + 1) ≤ Real.log (Real.exp (Real.log M ^ ((1 : ℝ) / 3))) :=
            Real.log_le_log (by linarith) h2
        _ = _ := Real.log_exp _
    have hC1 : Real.log M ^ ((1 : ℝ) / 3) ≤ Real.log M :=
      Real.rpow_le_self_of_one_le hℓ1.le (by norm_num)
    linarith
  have hmax : max 1 (Real.log m) ≤ Real.log M := max_le hℓ1.le hlogm
  have hF4 : ∀ x, 0 ≤ cramerModel K ρ (primorial m) x ∧
      cramerModel K ρ (primorial m) x
        ≤ ρ * C_M ^ Module.finrank ℚ K * Real.log M ^ Module.finrank ℚ K := by
    intro x
    have h0 : 0 ≤ (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ) := by
      positivity
    have hq : (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ)
