    have h1 : (∑ y ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)), X y) ^ 4 ≤
        (((omegaBox ω (2 * (⌊M⌋₊ : ℝ))).card : ℝ) * ((omegaBox ω M).card : ℝ) *
          (T * t) ^ 2) ^ 4 := by
      calc _ ≤ _ := hpm
        _ = _ := by rw [hsumX4, hUu, ← ht8]; ring
    exact le_of_pow_le_pow_left₀ (by norm_num)
      (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hb.le) (sq_nonneg _)) h1
  
  have hsumI : ‖S‖ ^ 2 ≤ Jst * (Q ^ 2 / 2) * ∑ y ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)), X y
      + ε ^ 2 * ∑ y ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)),
          ∑ x ∈ omegaBox ω M, |G (x + y) * G x| := by
    refine hS2.trans ?_
    calc _ ≤ ∑ y ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)),
