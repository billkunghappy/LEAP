            = Real.exp (t / (Module.finrank ℚ K : ℝ)) := by
          rw [← Real.exp_add]; congr 1; field_simp; ring
        have hs0 : 0 ≤ t / (2 * (Module.finrank ℚ K : ℝ)) :=
          div_nonneg h0 (by positivity)
        have hle : t / (2 * (Module.finrank ℚ K : ℝ)) + 1
            ≤ Real.exp (t / (2 * (Module.finrank ℚ K : ℝ))) := Real.add_one_le_exp _
        have hexp2 : (t / (2 * (Module.finrank ℚ K : ℝ))) ^ 2
            ≤ Real.exp (t / (Module.finrank ℚ K : ℝ)) := by
          rw [← hhalf]
          nlinarith [hs0, hle]
        have hid : (t / (2 * (Module.finrank ℚ K : ℝ))) ^ 2
            = t ^ 2 / (4 * (Module.finrank ℚ K : ℝ) ^ 2) := by
          field_simp; ring
        have h4n : (0:ℝ) < 4 * (Module.finrank ℚ K : ℝ) ^ 2 := by positivity
        have hsq : t ^ 2 ≤ 4 * (Module.finrank ℚ K : ℝ) ^ 2
            * Real.exp (t / (Module.finrank ℚ K : ℝ)) := by
          rw [hid, div_le_iff₀ h4n] at hexp2
          linarith
        have hb : e ^ 2 * t ^ 2 ≤ e ^ 2 * (4 * (Module.finrank ℚ K : ℝ) ^ 2
            * Real.exp (t / (Module.finrank ℚ K : ℝ))) :=
          mul_le_mul_of_nonneg_left hsq (sq_nonneg e)
        have hkey0 : 4 * (Module.finrank ℚ K : ℝ) ^ 2 *
            (e * (A * t) - e * (e * Real.exp (t / (Module.finrank ℚ K : ℝ))))
            ≤ 4 * (Module.finrank ℚ K : ℝ) ^ 2 *
              (A ^ 2 * (Module.finrank ℚ K : ℝ) ^ 2) := by
          nlinarith [sq_nonneg (2 * A * (Module.finrank ℚ K : ℝ) ^ 2 - e * t), hb]
        have hkey : e * (A * t) - e * (e * Real.exp (t / (Module.finrank ℚ K : ℝ)))
            ≤ A ^ 2 * (Module.finrank ℚ K : ℝ) ^ 2 := le_of_mul_le_mul_left hkey0 h4n
        have hfin : A * t - e * Real.exp (t / (Module.finrank ℚ K : ℝ))
            ≤ A ^ 2 * (Module.finrank ℚ K : ℝ) ^ 2 / e := by
          rw [le_div_iff₀ he]
          nlinarith [hkey]
        rw [hC₀]
        linarith
      · push_neg at h0
        have h1 : 0 < e * Real.exp (t / (Module.finrank ℚ K : ℝ)) :=
          mul_pos he (Real.exp_pos _)
        have h3 : A * t ≤ |A * t| := le_abs_self _
        have h4 : |A * t| = |A| * |t| := abs_mul _ _
        have h5 : |t| = -t := abs_of_neg h0
        have h6 : -θ ≤ |θ| := neg_le_abs θ
        have h7 : -t ≤ -θ := by linarith
        have h8 : |A| * |t| ≤ |A| * |θ| := by
          rw [h5]
          exact mul_le_mul_of_nonneg_left (le_trans h7 h6) (abs_nonneg A)
        rw [hC₀]
        linarith
    obtain ⟨φ, hφ⟩ : ∃ φ : ℝ → ℂ, φ = Set.indicator (Set.Ici θ)
        (fun t : ℝ => ((C * Real.exp (-t) : ℝ) : ℂ)) := ⟨_, rfl⟩
    have hφmeas : Measurable φ := by
      rw [hφ]
      refine Measurable.indicator ?_ measurableSet_Ici
      exact Complex.continuous_ofReal.measurable.comp
        ((Real.continuous_exp.comp continuous_neg).measurable.const_mul C)
    have hφint : MeasureTheory.Integrable φ MeasureTheory.volume := by
      rw [hφ, MeasureTheory.integrable_indicator_iff measurableSet_Ici]
      refine hIciIoi _ θ ?_
      have h1 : MeasureTheory.IntegrableOn (fun t : ℝ => Real.exp (-1 * t))
          (Set.Ioi θ) MeasureTheory.volume := exp_neg_integrableOn_Ioi θ one_pos
      have h2 : MeasureTheory.IntegrableOn (fun t : ℝ => C * Real.exp (-t))
          (Set.Ioi θ) MeasureTheory.volume := by
        simpa using h1.const_mul C
      exact h2.ofReal
    have hSmeas : MeasurableSet {u : NumberField.InfinitePlace K → ℝ |
        θ ≤ kaiMFLogNorm K u} := measurableSet_le measurable_const hLmeas
    have hdomint : MeasureTheory.IntegrableOn
        (fun u : NumberField.InfinitePlace K → ℝ => (1:ℂ) * φ (kaiMFLogNorm K u))
        (G ∩ {u : NumberField.InfinitePlace K → ℝ | θ ≤ kaiMFLogNorm K u})
        MeasureTheory.volume :=
      (hs1one φ hφmeas hφint).mono_set Set.inter_subset_left
    refine MeasureTheory.Integrable.mono' hdomint.norm
      ((hfmeas.mul (hWmeas γ)).aestronglyMeasurable) ?_
    rw [MeasureTheory.ae_restrict_iff' (hGm.inter hSmeas)]
    filter_upwards with u hu
    obtain ⟨huG, huS⟩ := hu
    have huS' : θ ≤ kaiMFLogNorm K u := huS
    have hRHS : ‖(1:ℂ) * φ (kaiMFLogNorm K u)‖ = C * Real.exp (-(kaiMFLogNorm K u)) := by
      rw [one_mul, hφ,
        Set.indicator_of_mem (show kaiMFLogNorm K u ∈ Set.Ici θ from huS')]
      rw [Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (mul_pos hC0 (Real.exp_pos _))]
    rw [hRHS, norm_mul]
    have hexpnorm : ‖Complex.exp ((∑ w : NumberField.InfinitePlace K, γ w)
          * ((kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ))‖
        = Real.exp (β * kaiMFLogNorm K u) := by
      rw [Complex.norm_exp]
      congr 1
      simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
      rw [hβ]; ring
    have hchiMγ : ‖Complex.exp (∑ w : NumberField.InfinitePlace K,
        γ w * ((u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ))‖ ≤ Mγ := by
      rw [hMγ]; exact hchib γ u huG
    have hWnorm : ‖kaiMFConeWeight K γ u‖ ≤ Mγ * Real.exp (β * kaiMFLogNorm K u) := by
      rw [hfact γ u, norm_mul, hexpnorm]
      exact mul_le_mul_of_nonneg_right hchiMγ (Real.exp_pos _).le
    have hfb := hfbound u ⟨huG, huS⟩
    have hcl : A * kaiMFLogNorm K u
        - e * Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)) ≤ C₀ :=
      hclaim _ huS'
    have hexple : Real.exp (-(e * Real.exp (kaiMFLogNorm K u
              / (Module.finrank ℚ K : ℝ))))
          * Real.exp (β * kaiMFLogNorm K u)
        ≤ Real.exp C₀ * Real.exp (-(kaiMFLogNorm K u)) := by
      rw [← Real.exp_add, ← Real.exp_add]
      refine Real.exp_le_exp.mpr ?_
