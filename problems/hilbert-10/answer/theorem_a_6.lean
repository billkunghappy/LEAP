    refine Continuous.comp' Complex.continuous_ofReal ?_
    refine Continuous.rexp ?_
    refine Continuous.neg ?_
    refine continuous_const.mul ?_
    refine continuous_finset_sum Finset.univ (fun w _ => ?_)
    exact ((continuous_apply w).rexp).mul continuous_const
  rw [continuous_iff_continuousAt]
  intro u₀
  have hVopen : IsOpen (⋂ w : NumberField.InfinitePlace K,
