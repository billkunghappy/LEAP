      (((hasDerivAt_id' (β : ℂ)).sub_const (β : ℂ)).pow 1).mul hg.differentiableAt.hasDerivAt
    rw [Filter.EventuallyEq.deriv_eq (f := fun w => (w - (β : ℂ)) ^ 1 * g w) ?_, hder.deriv]
    · simp
    · filter_upwards [hGg] with w hw
      simpa [smul_eq_mul] using hw
  refine ⟨dslope G (β : ℂ), ?_, ?_, ?_⟩
  · exact differentiableOn_univ.1
      ((Complex.differentiableOn_dslope Filter.univ_mem).2 hG.differentiableOn)
  · rw [dslope_same, hderβ]; exact hgβ
  · intro s
    have := sub_smul_dslope G (β : ℂ) s
    rw [smul_eq_mul, hGβ, sub_zero] at this
    exact this.symm

theorem kai_lp_logderiv (K : Type u) [Field K] [NumberField K]
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (h1 : lam 1 = 1)
    (hmul : ∀ I J : Ideal (NumberField.RingOfIntegers K), lam (I * J) = lam I * lam J)
    (hbd : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1)
    (E : ℕ) (G : ℂ → ℂ) (hG : Differentiable ℂ G)
    (hEG : ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s)
    (s : ℂ) (hs : 1 < s.re) :
    G s ≠ 0 ∧
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
        = -(deriv G s / G s) + (E : ℂ) / (s - 1) :=
by
  classical
  have hzeta := kai_ld_zeta_summable K
  have hΛ0 : ∀ I : Ideal (NumberField.RingOfIntegers K), 0 ≤ kaiZFVonMangoldt K I := by
    intro I
    unfold kaiZFVonMangoldt
    split
    · exact Real.log_natCast_nonneg _
    · exact le_refl 0
  have hΛle : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      kaiZFVonMangoldt K I ≤ Real.log (Ideal.absNorm I) := by
    intro I hI
    unfold kaiZFVonMangoldt
    split
    · rename_i h
      obtain ⟨k, -, -, hk, hIk⟩ := h.choose_spec
      have hI' : Ideal.absNorm I ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff, ← Submodule.zero_eq_bot]
        exact hI
      have hpow : Ideal.absNorm I = Ideal.absNorm h.choose ^ k :=
        (congrArg Ideal.absNorm hIk).trans (map_pow _ _ _)
      have hP0 : Ideal.absNorm h.choose ≠ 0 := by
        intro h0
        apply hI'
        rw [hpow, h0, zero_pow hk.ne']
      have hle : Ideal.absNorm h.choose ≤ Ideal.absNorm I := by
        rw [hpow]
        exact Nat.le_self_pow hk.ne' _
      apply Real.log_le_log
      · exact_mod_cast Nat.pos_of_ne_zero hP0
      · exact_mod_cast hle
    · exact Real.log_natCast_nonneg _
  have hΛdiv : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      ∀ D : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ J : Ideal (NumberField.RingOfIntegers K), J ∈ D ↔ J ∣ I) →
        ∑ J ∈ D, kaiZFVonMangoldt K J = Real.log (Ideal.absNorm I) := by
    intro I hI D hD
    rw [← kai_zf_log_norm_divisor_sum K I hI, ← Finset.tsum_subtype D (kaiZFVonMangoldt K)]
    exact Equiv.tsum_eq (Equiv.subtypeEquivRight hD)
      (fun J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I} =>
        kaiZFVonMangoldt K (J : Ideal (NumberField.RingOfIntegers K)))
  have hAne := kai_ld_series_ne_zero K lam h1 hmul hbd hzeta s hs
  have hs1 : s ≠ 1 := by
    intro h
    rw [h, Complex.one_re] at hs
    exact lt_irrefl _ hs
  have hwne : s - 1 ≠ 0 := sub_ne_zero.mpr hs1
  have hGeq : kaiHeckeSeries K lam s * (s - 1) ^ E = G s := hEG s hs
  have hGne : G s ≠ 0 := by
    rw [← hGeq]
    exact mul_ne_zero hAne (pow_ne_zero E hwne)
  obtain ⟨hdiff, hderiv⟩ := kai_ld_series_deriv K lam hbd hzeta s hs
  have hprod := kai_ld_logsum_mul K lam hmul hbd hzeta (kaiZFVonMangoldt K) hΛ0 hΛle hΛdiv s hs
  set D := (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) with hD
  have hLd : deriv (kaiHeckeSeries K lam) s = -(kaiHeckeSeries K lam s * D) := by
    rw [hderiv, hprod]
  have hU : {z : ℂ | 1 < z.re} ∈ nhds s :=
    IsOpen.mem_nhds (isOpen_lt continuous_const Complex.continuous_re) hs
  have hEv : (fun z => kaiHeckeSeries K lam z * (z - 1) ^ E) =ᶠ[nhds s] G :=
    Filter.eventually_of_mem hU (fun z hz => hEG z hz)
  have hw : HasDerivAt (fun z : ℂ => z - 1) 1 s := (hasDerivAt_id s).sub_const 1
  have hwE : HasDerivAt (fun z : ℂ => (z - 1) ^ E) ((E : ℂ) * (s - 1) ^ (E - 1) * 1) s :=
    hw.pow E
  have hpr := hdiff.hasDerivAt.mul hwE
  have hGd : deriv G s = deriv (kaiHeckeSeries K lam) s * (s - 1) ^ E
      + kaiHeckeSeries K lam s * ((E : ℂ) * (s - 1) ^ (E - 1) * 1) := by
    rw [← hEv.deriv_eq]
    exact hpr.deriv
  have h12 : kaiHeckeSeries K lam s * (s - 1) ^ E * ((E : ℂ) / (s - 1))
      = kaiHeckeSeries K lam s * ((E : ℂ) * (s - 1) ^ (E - 1) * 1) := by
    cases E with
    | zero => simp
    | succ k =>
      rw [pow_succ, Nat.add_sub_cancel]
      field_simp
  have hkey : deriv G s = G s * (-D + (E : ℂ) / (s - 1)) := by
    rw [hGd, hLd, ← h12, ← hGeq]
    ring
  have hdivv : deriv G s / G s = -D + (E : ℂ) / (s - 1) := by
    rw [hkey]
    exact mul_div_cancel_left₀ _ hGne
  refine ⟨hGne, ?_⟩
  rw [hdivv]
  ring

theorem kai_lp_smoothed_perron {K : Type u} [Field K] [NumberField K]
    (a : Ideal (NumberField.RingOfIntegers K) → ℂ) (F : ℂ → ℂ)
    (x T κ S : ℝ)
    (hx : 3 ≤ x) (hT : 3 ≤ T) (hκ1 : 1 < κ) (hκ2 : κ ≤ 2)
    (hF : ∀ s : ℂ, 1 < s.re →
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            a (I : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) = F s)
    (hS : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          ‖a (I : Ideal (NumberField.RingOfIntegers K))‖ *
            (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-κ)))
    (hSb : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ‖a (I : Ideal (NumberField.RingOfIntegers K))‖ *
            (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-κ)) ≤ S) :
    ‖(∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
           I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x},
         a (I : Ideal (NumberField.RingOfIntegers K)) *
           ((Real.log
               (x / (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) : ℝ) : ℂ))
       - (1 / (2 * (Real.pi : ℂ) * Complex.I)) *
           (∫ τ in (-T)..T, Complex.I * F ((κ : ℂ) + (τ : ℂ) * Complex.I) *
             (x : ℂ) ^ ((κ : ℂ) + (τ : ℂ) * Complex.I) /
               ((κ : ℂ) + (τ : ℂ) * Complex.I) ^ 2)‖
      ≤ 2 * S * x ^ κ / T :=
by
  have hx0 : (0 : ℝ) < x := by linarith
  have hT0 : (0 : ℝ) < T := by linarith
  have hκ0 : (0 : ℝ) < κ := by linarith
  
  have kernel_line : ∀ v : ℝ, 0 < v →
      (∫ τ : ℝ, (v : ℂ) ^ ((κ : ℂ) + (τ : ℂ) * Complex.I) /
          ((κ : ℂ) + (τ : ℂ) * Complex.I) ^ 2)
        = 2 * (Real.pi : ℂ) * ((max (Real.log v) 0 : ℝ) : ℂ) := by
    intro v hv
    have hκ : (0 : ℝ) < κ := hκ0
    have stepA : MeasureTheory.Integrable
        (fun y : ℝ => 1 / ((κ : ℂ) + (y : ℂ) * Complex.I) ^ 2) MeasureTheory.volume := by
      have hre : ∀ y : ℝ, ((κ : ℂ) + (y : ℂ) * Complex.I).re = κ := by
        intro y; simp
      have hz : ∀ y : ℝ, ((κ : ℂ) + (y : ℂ) * Complex.I) ≠ 0 := by
        intro y hy
        have h := hre y
        rw [hy] at h
        simp at h
        exact absurd h.symm (ne_of_gt hκ)
      have hnorm : ∀ y : ℝ, ‖1 / ((κ : ℂ) + (y : ℂ) * Complex.I) ^ 2‖ = (κ ^ 2 + y ^ 2)⁻¹ := by
        intro y
        rw [norm_div, norm_one, norm_pow, Complex.norm_add_mul_I,
          Real.sq_sqrt (by positivity : (0:ℝ) ≤ κ ^ 2 + y ^ 2), one_div]
      have hg : MeasureTheory.Integrable
          (fun y : ℝ => (κ ^ 2)⁻¹ * (1 + (y / κ) ^ 2)⁻¹) MeasureTheory.volume :=
        (integrable_inv_one_add_sq.comp_div (ne_of_gt hκ)).const_mul _
      have heq : ∀ y : ℝ, (κ ^ 2)⁻¹ * (1 + (y / κ) ^ 2)⁻¹ = (κ ^ 2 + y ^ 2)⁻¹ := by
        intro y
        rw [← mul_inv]
        congr 1
        field_simp
      have hcont : Continuous (fun y : ℝ => 1 / ((κ : ℂ) + (y : ℂ) * Complex.I) ^ 2) := by
        apply Continuous.div continuous_const
        · fun_prop
        · intro y; exact pow_ne_zero 2 (hz y)
      refine MeasureTheory.Integrable.mono'
        (g := fun y : ℝ => (κ ^ 2)⁻¹ * (1 + (y / κ) ^ 2)⁻¹) hg
        hcont.aestronglyMeasurable (Filter.Eventually.of_forall (fun y => ?_))
      show ‖1 / ((κ : ℂ) + (y : ℂ) * Complex.I) ^ 2‖ ≤ (κ ^ 2)⁻¹ * (1 + (y / κ) ^ 2)⁻¹
      rw [hnorm y, heq y]
