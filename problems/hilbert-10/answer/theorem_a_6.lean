  have hδapp : ∀ p k, δ p k = (p.1 k : ℤ) - (p.2 k : ℤ) := by intro p k; rw [hδ]
  obtain ⟨fib, hfib⟩ : ∃ fib : (Fin b → ℤ) → Finset ((Fin b → ℕ) × (Fin b → ℕ)),
