    · have hφ : (1 : ℝ) ≤ (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) := by
        exact_mod_cast hpos
      have hh : (1 : ℝ) ≤ (NumberField.classNumber K : ℝ) := by
        exact_mod_cast NumberField.classNumber_pos K
      have h2 : (1 : ℝ) ≤ 2 ^ NumberField.InfinitePlace.nrRealPlaces K :=
        one_le_pow₀ (by norm_num)
      have h1D : (1 : ℝ) ≤ 2 ^ NumberField.InfinitePlace.nrRealPlaces K *
