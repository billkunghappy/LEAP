            * (1 + 7 * (2 * (ν : ℝ) + 1) * 2 ^ (3 * ν + 1))) / δ) ^ (4 * ν * ν + 14) :=
by
  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = 5 * 2 ^ (2 * ν + 7) * (2 ^ (ν + 2)) ^ (ν * ν)
