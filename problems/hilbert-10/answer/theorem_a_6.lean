          _ ≤ ∑ S ∈ U.powerset, lam ^ R * (1 ^ S.card * ∏ p ∈ S, ((p : ℝ) ^ d / lam)) :=
              Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
                (fun S _ _ => mul_nonneg (pow_nonneg hlampos.le _) (mul_nonneg (by positivity)
                  (Finset.prod_nonneg (fun p _ => div_nonneg (by positivity) hlampos.le))))
          _ = lam ^ R * ∑ S ∈ U.powerset, (1 ^ S.card * ∏ p ∈ S, ((p : ℝ) ^ d / lam)) := by
              rw [Finset.mul_sum]
          _ ≤ lam ^ R * Real.exp (1 * ∑ p ∈ U, (p : ℝ) ^ d / lam) :=
              mul_le_mul_of_nonneg_left (rankin U (fun p : ℕ => (p : ℝ) ^ d / lam) hx 1
                zero_le_one) (pow_nonneg hlampos.le _)
          _ ≤ lam ^ R * Real.exp 1 := by
              apply mul_le_mul_of_nonneg_left _ (pow_nonneg hlampos.le _)
              apply Real.exp_le_exp.2
              rw [one_mul, ← Finset.sum_div, div_le_one hlampos]
              calc ∑ p ∈ U, (p : ℝ) ^ d ≤ ∑ p ∈ U, M ^ d :=
                    Finset.sum_le_sum (fun p hp => pow_le_pow_left₀ (Nat.cast_nonneg _) (hpM p hp) d)
                _ = U.card * M ^ d := by rw [Finset.sum_const, nsmul_eq_mul]
                _ ≤ (m + 1) * M ^ d := mul_le_mul_of_nonneg_right hUcard (by positivity)
                _ ≤ (2 * M) * M ^ d := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
                _ = lam := by rw [hlam_def]; ring
          _ = Real.exp 1 * lam ^ R := by ring
      have hT1 : ∑ S ∈ U.powerset.filter (fun S => S.card ≤ R),
            C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1)
          ≤ Real.exp 1 * 3 ^ (d - 1) * C * (N : ℝ) ^ d / ℓ ^ A := by
        have heq : ∑ S ∈ U.powerset.filter (fun S => S.card ≤ R),
              C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1)
            = C * ((N : ℝ) + 2) ^ (d - 1) *
                ∑ S ∈ U.powerset.filter (fun S => S.card ≤ R), ((∏ p ∈ S, p : ℕ) : ℝ) ^ d := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro S _; ring
        rw [heq, le_div_iff₀ hℓA]
        have hN2 : ((N : ℝ) + 2) ^ (d - 1) ≤ 3 ^ (d - 1) * (N : ℝ) ^ (d - 1) := by
          rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) (by linarith) _
        have hNd' : (N : ℝ) * (N : ℝ) ^ (d - 1) = (N : ℝ) ^ d := by
          rw [← pow_succ', Nat.sub_add_cancel hd]
        have hsum0 : 0 ≤ ∑ S ∈ U.powerset.filter (fun S => S.card ≤ R),
            ((∏ p ∈ S, p : ℕ) : ℝ) ^ d := Finset.sum_nonneg (fun S _ => by positivity)
        have hX0 : 0 ≤ Real.exp 1 * 3 ^ (d - 1) * C * (N : ℝ) ^ (d - 1) := by positivity
        calc C * ((N : ℝ) + 2) ^ (d - 1) *
              (∑ S ∈ U.powerset.filter (fun S => S.card ≤ R), ((∏ p ∈ S, p : ℕ) : ℝ) ^ d)
              * ℓ ^ A
            ≤ C * (3 ^ (d - 1) * (N : ℝ) ^ (d - 1)) * (Real.exp 1 * lam ^ R) * ℓ ^ A := by
              apply mul_le_mul_of_nonneg_right _ hℓA.le
              exact mul_le_mul (mul_le_mul_of_nonneg_left hN2 hC0) hT1sum hsum0
                (mul_nonneg hC0 (by positivity))
          _ = Real.exp 1 * 3 ^ (d - 1) * C * (N : ℝ) ^ (d - 1) * (lam ^ R * ℓ ^ A) := by ring
          _ ≤ Real.exp 1 * 3 ^ (d - 1) * C * (N : ℝ) ^ (d - 1) * N :=
              mul_le_mul_of_nonneg_left hlamRℓ hX0
          _ = Real.exp 1 * 3 ^ (d - 1) * C * (N : ℝ) ^ d := by rw [← hNd']; ring
      
      have hterm2 : ∀ S ∈ U.powerset.filter (fun S => S.card = R),
          (kaiBadResidueCount S c₀ c : ℝ)
            / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d
          ≤ Real.exp (-(R : ℝ)) * (Real.exp 1 ^ S.card * ∏ p ∈ S, ((4 * n : ℝ) / p)) := by
        intro S hS
        rw [Finset.mem_filter, Finset.mem_powerset] at hS
        have hSU := hS.1
        have hcardS := hS.2
        have hpos : ∀ p ∈ S, (0 : ℝ) < p := fun p hp => by
          exact_mod_cast (hUprime p (hSU hp)).pos
        have hq : (0 : ℝ) < ((∏ p ∈ S, p : ℕ) : ℝ) := by
          rw [Nat.cast_prod]; exact Finset.prod_pos hpos
        have hy := hloc S hSU
        rw [← hn_def] at hy
        rw [hcardS, ← Real.exp_nat_mul, ← mul_assoc, ← Real.exp_add,
          show -(R : ℝ) + R * 1 = 0 by ring, Real.exp_zero, one_mul,
          div_le_iff₀ (pow_pos hq d)]
        calc (kaiBadResidueCount S c₀ c : ℝ)
            ≤ ((∏ p ∈ S, 4 * n * p ^ (d - 1) : ℕ) : ℝ) := by exact_mod_cast hy
          _ = (∏ p ∈ S, ((4 * n : ℝ) / p)) * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d := by
            rw [Nat.cast_prod, Nat.cast_prod, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
            apply Finset.prod_congr rfl
            intro p hp
            have hp0 := (hpos p hp).ne'
            have hpd : (p : ℝ) ^ d = (p : ℝ) ^ (d - 1) * p := by
              rw [← pow_succ, Nat.sub_add_cancel hd]
            push_cast
            rw [hpd]
            field_simp
      have hT2sum : ∑ S ∈ U.powerset.filter (fun S => S.card = R),
          (kaiBadResidueCount S c₀ c : ℝ)
            / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d ≤ 1 / ℓ ^ A := by
        have hx : ∀ p ∈ U, 0 ≤ (fun p : ℕ => (4 * n : ℝ) / p) p :=
          fun p _ => by positivity
        calc _ ≤ ∑ S ∈ U.powerset.filter (fun S => S.card = R),
              Real.exp (-(R : ℝ)) * (Real.exp 1 ^ S.card * ∏ p ∈ S, ((4 * n : ℝ) / p)) :=
              Finset.sum_le_sum hterm2
          _ ≤ ∑ S ∈ U.powerset,
              Real.exp (-(R : ℝ)) * (Real.exp 1 ^ S.card * ∏ p ∈ S, ((4 * n : ℝ) / p)) :=
              Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
                (fun S _ _ => by positivity)
          _ = Real.exp (-(R : ℝ)) *
              ∑ S ∈ U.powerset, (Real.exp 1 ^ S.card * ∏ p ∈ S, ((4 * n : ℝ) / p)) := by
              rw [Finset.mul_sum]
          _ ≤ Real.exp (-(R : ℝ)) * Real.exp (Real.exp 1 * ∑ p ∈ U, ((4 * n : ℝ) / p)) :=
              mul_le_mul_of_nonneg_left
                (rankin U (fun p : ℕ => (4 * n : ℝ) / p) hx _ he0.le) (Real.exp_pos _).le
          _ ≤ Real.exp (-(R : ℝ)) * Real.exp (Real.exp 1 * (4 * n * (1 + u))) := by
              apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
              apply Real.exp_le_exp.2
              apply mul_le_mul_of_nonneg_left _ he0.le
              have hsplit : ∑ p ∈ U, ((4 * n : ℝ) / p) = 4 * n * ∑ p ∈ U, (1 : ℝ) / p := by
                rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro p _; ring
              rw [hsplit]
              apply mul_le_mul_of_nonneg_left _ (by positivity)
              linarith
          _ ≤ 1 / ℓ ^ A := by
              rw [← Real.exp_add, le_div_iff₀ hℓA]
              have hexp1 : -(R : ℝ) + Real.exp 1 * (4 * n * (1 + u)) ≤ -(3 * A * u) := by
                have h1 : Real.exp 1 * (4 * n * (1 + u)) ≤ 8 * Real.exp 1 * n * u := by
                  nlinarith [mul_nonneg (mul_nonneg he0.le hn0) (sub_nonneg.2 hu1)]
                have hκu' : κ * u = 8 * Real.exp 1 * n * u + 3 * A * u := by rw [hκ_def]; ring
                linarith
              calc Real.exp (-(R : ℝ) + Real.exp 1 * (4 * n * (1 + u))) * ℓ ^ A
                  ≤ Real.exp (-(3 * A * u)) * Real.exp (3 * A * u) :=
                    mul_le_mul (Real.exp_le_exp.2 hexp1) hℓAle hℓA.le (Real.exp_pos _).le
                _ = 1 := by rw [← Real.exp_add]; simp
      have hT2 : 2 * V * ∑ S ∈ U.powerset.filter (fun S => S.card = R),
          (kaiBadResidueCount S c₀ c : ℝ)
            / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d ≤ 2 ^ (d + 1) * (N : ℝ) ^ d / ℓ ^ A := by
        calc _ ≤ 2 * (2 * (N : ℝ)) ^ d * (1 / ℓ ^ A) :=
              mul_le_mul (mul_le_mul_of_nonneg_left hV (by norm_num)) hT2sum
                (Finset.sum_nonneg (fun S _ => by positivity)) (by positivity)
          _ = 2 ^ (d + 1) * (N : ℝ) ^ d / ℓ ^ A := by rw [mul_pow, pow_succ]; ring
      have hfin : Real.exp 1 * 3 ^ (d - 1) * C * (N : ℝ) ^ d / ℓ ^ A
          + 2 ^ (d + 1) * (N : ℝ) ^ d / ℓ ^ A
          ≤ (3 ^ d * κ₂ ^ (3 * A) + Real.exp 1 * 3 ^ (d - 1) * C + 2 ^ (d + 1))
              * (N : ℝ) ^ d / ℓ ^ A := by
        rw [← add_div]
        apply div_le_div_of_nonneg_right _ hℓA.le
        have h0 : 0 ≤ 3 ^ d * κ₂ ^ (3 * A) * (N : ℝ) ^ d := by positivity
        have e : (3 ^ d * κ₂ ^ (3 * A) + Real.exp 1 * 3 ^ (d - 1) * C + 2 ^ (d + 1))
              * (N : ℝ) ^ d = 3 ^ d * κ₂ ^ (3 * A) * (N : ℝ) ^ d
                + (Real.exp 1 * 3 ^ (d - 1) * C * (N : ℝ) ^ d + 2 ^ (d + 1) * (N : ℝ) ^ d) := by
          ring
        linarith
      exact hs.trans ((add_le_add hT1 hT2).trans hfin)

theorem kai_affEval_mem_omegaBox (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) (d : ℕ)
    (c₀ : NumberField.RingOfIntegers K) (c : Fin d → NumberField.RingOfIntegers K)
    (L N : ℝ) (hL : 0 ≤ L) (hN : 0 ≤ N)
    (hc : ∀ k, basisSupNorm ω (c k) ≤ L) (hc₀ : basisSupNorm ω c₀ ≤ L * N)
    (z : Fin d → ℤ) (hz : ∀ k, |((z k : ℤ) : ℝ)| ≤ N) :
    affEval c₀ c z ∈ omegaBox ω (((d : ℝ) + 1) * L * N) :=
by
  classical
  have hcoord : ∀ (y : NumberField.RingOfIntegers K) (j : Fin (Module.finrank ℚ K)),
      |((ω.repr y j : ℤ) : ℝ)| ≤ basisSupNorm ω y := by
    intro y j
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr y j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  have hformula : ∀ j, ω.repr (affEval c₀ c z) j
      = ω.repr c₀ j + ∑ k, z k * ω.repr (c k) j := by
    intro j
    unfold affEval
    rw [map_add, map_sum, Finsupp.add_apply, Finsupp.coe_finset_sum, Finset.sum_apply]
    congr 1
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_zsmul, Finsupp.smul_apply, smul_eq_mul]
  have hbound : ∀ j, |((ω.repr (affEval c₀ c z) j : ℤ) : ℝ)| ≤ ((d : ℝ) + 1) * L * N := by
    intro j
    rw [hformula j]
    push_cast
    have hsum : |∑ k, ((z k : ℤ) : ℝ) * ((ω.repr (c k) j : ℤ) : ℝ)|
        ≤ ∑ _k : Fin d, N * L := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      apply Finset.sum_le_sum
      intro k _
      rw [abs_mul]
      exact mul_le_mul (hz k) ((hcoord (c k) j).trans (hc k)) (abs_nonneg _) hN
    have h0 : |((ω.repr c₀ j : ℤ) : ℝ)| ≤ L * N := (hcoord c₀ j).trans hc₀
    have hc : ∑ _k : Fin d, N * L = (d : ℝ) * (N * L) := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    calc |((ω.repr c₀ j : ℤ) : ℝ) + ∑ k, ((z k : ℤ) : ℝ) * ((ω.repr (c k) j : ℤ) : ℝ)|
        ≤ |((ω.repr c₀ j : ℤ) : ℝ)| + |∑ k, ((z k : ℤ) : ℝ) * ((ω.repr (c k) j : ℤ) : ℝ)| :=
          abs_add_le _ _
      _ ≤ L * N + (d : ℝ) * (N * L) := by rw [← hc]; exact add_le_add h0 hsum
      _ = ((d : ℝ) + 1) * L * N := by ring
  have hint : ∀ j, -((⌊((d : ℝ) + 1) * L * N⌋₊ : ℕ) : ℤ) ≤ ω.repr (affEval c₀ c z) j ∧
      ω.repr (affEval c₀ c z) j ≤ ((⌊((d : ℝ) + 1) * L * N⌋₊ : ℕ) : ℤ) := by
    intro j
    have h1 : (((ω.repr (affEval c₀ c z) j).natAbs : ℕ) : ℝ) ≤ ((d : ℝ) + 1) * L * N := by
      rw [Nat.cast_natAbs, Int.cast_abs]; exact hbound j
    have h2 := Nat.le_floor h1
    omega
  unfold omegaBox
  rw [Finset.mem_image]
  refine ⟨ω.equivFun (affEval c₀ c z), ?_, LinearEquiv.symm_apply_apply _ _⟩
  unfold intBox
  rw [Finset.mem_Icc]
  constructor
  · intro j
    rw [Module.Basis.equivFun_apply]
    exact (hint j).1
  · intro j
    rw [Module.Basis.equivFun_apply]
    exact (hint j).2

theorem kai_large_N_thresholds (A₀ : ℝ) (k : ℕ) :
    ∃ N₁ : ℝ, 16 < N₁ ∧ ∀ N : ℝ, N₁ ≤ N →
      A₀ ≤ Real.log (Real.log N) ∧ 2 ≤ Real.log (Real.log N) ∧
      A₀ * Real.log N ^ k ≤ N ∧ A₀ * Real.log N ≤ N ∧
      ∃ m : ℕ, Real.log (Real.log N) ≤ (m : ℝ) ∧
        (m : ℝ) ≤ Real.exp (Real.log N ^ ((1:ℝ)/3)) ∧
        Real.log (m : ℝ) ≤ Real.log N ∧
        ∀ R : ℝ, N ≤ R → R ≤ N ^ 2 →
          Real.exp (Real.log R ^ ((1:ℝ)/100)) ≤ (m : ℝ) ∧
          (m : ℝ) + 1 ≤ Real.exp (Real.log R ^ ((1:ℝ)/3)) :=
by
  
  have gap : ∀ t : ℝ, (18:ℝ) ^ 300 ≤ t →
      Real.log t ≤ Real.exp ((2 * t) ^ ((1:ℝ)/100)) ∧
      Real.exp ((2 * t) ^ ((1:ℝ)/100)) + 2 ≤ Real.exp (t ^ ((1:ℝ)/3)) := by
    intro t ht
    have h18 : (0:ℝ) < (18:ℝ) ^ 300 := by positivity
    have htpos : 0 < t := lt_of_lt_of_le h18 ht
    obtain ⟨u, hu_def⟩ : ∃ u : ℝ, u = t ^ ((1:ℝ)/300) := ⟨_, rfl⟩
    have hupos : 0 < u := by rw [hu_def]; exact Real.rpow_pos_of_pos htpos _
    have hu18 : 18 ≤ u := by
      have h1 : ((18:ℝ) ^ 300) ^ ((1:ℝ)/300) ≤ u := by
        rw [hu_def]; exact Real.rpow_le_rpow h18.le ht (by norm_num)
      have h2 : ((18:ℝ) ^ 300) ^ ((1:ℝ)/300) = 18 := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 18)]
        norm_num
      rw [h2] at h1; exact h1
    have hu3 : u ^ 3 = t ^ ((1:ℝ)/100) := by
      rw [hu_def, ← Real.rpow_mul_natCast htpos.le]
      norm_num
    have hu100 : u ^ 100 = t ^ ((1:ℝ)/3) := by
      rw [hu_def, ← Real.rpow_mul_natCast htpos.le]
      norm_num
    have hlogt : Real.log t ≤ 300 * u := by
      have h1 : Real.log u = (1/300) * Real.log t := by
        rw [hu_def]; exact Real.log_rpow htpos _
      have h2 := Real.log_le_sub_one_of_pos hupos
      linarith only [h1, h2]
    obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = (2 * t) ^ ((1:ℝ)/100) := ⟨_, rfl⟩
    rw [← ha_def]
    have ha_lo : u ^ 3 ≤ a := by
      rw [hu3, ha_def]
      exact Real.rpow_le_rpow htpos.le (by linarith only [htpos]) (by norm_num)
    have ha_hi : a ≤ 2 * u ^ 3 := by
      rw [ha_def, Real.mul_rpow (by norm_num) htpos.le, hu3]
      have h2 : (2:ℝ) ^ ((1:ℝ)/100) ≤ 2 := by
        calc (2:ℝ) ^ ((1:ℝ)/100) ≤ 2 ^ (1:ℝ) :=
              Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)
          _ = 2 := Real.rpow_one 2
      exact mul_le_mul_of_nonneg_right h2 (Real.rpow_nonneg htpos.le _)
    have ha0 : 0 ≤ a := by
      rw [ha_def]; exact Real.rpow_nonneg (by linarith only [htpos]) _
    have hsq : (324:ℝ) ≤ u * u := by nlinarith only [hu18]
    have hcube : u ^ 3 = u * (u * u) := by ring
    have hu3ge : 300 * u ≤ u ^ 3 := by
      rw [hcube]; nlinarith only [hsq, hupos]
    constructor
    · have := Real.add_one_le_exp a
      linarith only [this, hlogt, hu3ge, ha_lo]
    · have h4 : u ^ 4 ≤ u ^ 100 := pow_le_pow_right₀ (by linarith only [hu18]) (by norm_num)
      have hu31 : 1 ≤ u ^ 3 := one_le_pow₀ (by linarith only [hu18])
      have h4' : u ^ 4 = u * u ^ 3 := by ring
      have h18u : 18 * u ^ 3 ≤ u * u ^ 3 :=
        mul_le_mul_of_nonneg_right hu18 (le_trans zero_le_one hu31)
      have h5 : 2 * u ^ 3 + 2 ≤ u ^ 4 := by rw [h4']; linarith only [h18u, hu31]
      have hstep : a + 2 ≤ t ^ ((1:ℝ)/3) := by
        rw [← hu100]; linarith only [h4, h5, ha_hi]
      have he2 : (3:ℝ) ≤ Real.exp 2 := by
        have := Real.add_one_le_exp (2:ℝ); linarith only [this]
      have hea : 1 ≤ Real.exp a := Real.one_le_exp ha0
      have h6 : Real.exp a + 2 ≤ Real.exp (a + 2) := by
        rw [Real.exp_add]
        have := mul_le_mul_of_nonneg_left he2 (le_trans zero_le_one hea)
        linarith only [this, hea]
      exact h6.trans (Real.exp_le_exp.2 hstep)
  
  have powexp : ∀ (A : ℝ) (j : ℕ) (t : ℝ), 0 ≤ t →
      |A| * ((j + 1).factorial : ℝ) ≤ t → A * t ^ j ≤ Real.exp t := by
    intro A j t ht hAt
    have hF : (0:ℝ) < ((j + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
    have h1 : A * t ^ j ≤ |A| * t ^ j :=
      mul_le_mul_of_nonneg_right (le_abs_self A) (pow_nonneg ht _)
    have h2 : |A| * t ^ j * ((j + 1).factorial : ℝ) ≤ t ^ (j + 1) := by
      calc |A| * t ^ j * ((j + 1).factorial : ℝ)
          = (|A| * ((j + 1).factorial : ℝ)) * t ^ j := by ring
        _ ≤ t * t ^ j := mul_le_mul_of_nonneg_right hAt (pow_nonneg ht _)
        _ = t ^ (j + 1) := by ring
    have h3 : |A| * t ^ j ≤ t ^ (j + 1) / ((j + 1).factorial : ℝ) := by
      rw [le_div_iff₀ hF]; exact h2
    have h4 := Real.pow_div_factorial_le_exp t ht (j + 1)
    linarith only [h1, h3, h4]
  
  obtain ⟨T, hT_def⟩ : ∃ T : ℝ, T = max (max 16 (Real.exp (max A₀ 2)))
      (max ((18:ℝ) ^ 300) (max (|A₀| * ((k + 1).factorial : ℝ))
        (|A₀| * ((1 + 1).factorial : ℝ)))) := ⟨_, rfl⟩
  have hT16 : 16 ≤ T := by
    rw [hT_def]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hTexp : Real.exp (max A₀ 2) ≤ T := by
    rw [hT_def]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hT18 : (18:ℝ) ^ 300 ≤ T := by
    rw [hT_def]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hTk : |A₀| * ((k + 1).factorial : ℝ) ≤ T := by
    rw [hT_def]
    exact le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))
  have hT1 : |A₀| * ((1 + 1).factorial : ℝ) ≤ T := by
    rw [hT_def]
    exact le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))
  refine ⟨Real.exp T, ?_, ?_⟩
  · have := Real.add_one_le_exp T; linarith only [this, hT16]
  intro N hN
  have hNpos : 0 < N := lt_of_lt_of_le (Real.exp_pos T) hN
  have hTt : T ≤ Real.log N := by
    have := Real.log_le_log (Real.exp_pos T) hN
    rwa [Real.log_exp] at this
  obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = Real.log N := ⟨_, rfl⟩
  rw [← ht_def] at hTt ⊢
  have hexpt : Real.exp t = N := by rw [ht_def]; exact Real.exp_log hNpos
  have ht16 : 16 ≤ t := le_trans hT16 hTt
  have ht0 : 0 ≤ t := by linarith only [ht16]
  have ht1 : 1 ≤ t := by linarith only [ht16]
  have hmaxle : max A₀ 2 ≤ Real.log t := by
    have h := Real.log_le_log (Real.exp_pos _) (le_trans hTexp hTt)
    rwa [Real.log_exp] at h
  refine ⟨le_trans (le_max_left _ _) hmaxle, le_trans (le_max_right _ _) hmaxle, ?_, ?_, ?_⟩
  · rw [← hexpt]; exact powexp A₀ k t ht0 (le_trans hTk hTt)
  · rw [← hexpt]
    have := powexp A₀ 1 t ht0 (le_trans hT1 hTt)
    rwa [pow_one] at this
  · obtain ⟨g1, g2⟩ := gap t (le_trans hT18 hTt)
    obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = (2 * t) ^ ((1:ℝ)/100) := ⟨_, rfl⟩
    rw [← ha_def] at g1 g2
    have ha0 : 0 ≤ a := by
      rw [ha_def]; exact Real.rpow_nonneg (by linarith only [ht0]) _
    obtain ⟨E, hE_def⟩ : ∃ E : ℝ, E = Real.exp a := ⟨_, rfl⟩
    rw [← hE_def] at g1 g2
    have hE1 : 1 ≤ E := by rw [hE_def]; exact Real.one_le_exp ha0
    have hceil1 : E ≤ (⌈E⌉₊ : ℝ) := Nat.le_ceil E
    have hceil2 : (⌈E⌉₊ : ℝ) < E + 1 := Nat.ceil_lt_add_one (by linarith only [hE1])
    refine ⟨⌈E⌉₊, ?_, ?_, ?_, ?_⟩
    · exact g1.trans hceil1
    · linarith only [hceil2, g2]
    · have hm0 : 0 < (⌈E⌉₊ : ℝ) := by linarith only [hE1, hceil1]
      have hmle : (⌈E⌉₊ : ℝ) ≤ Real.exp (t ^ ((1:ℝ)/3)) := by linarith only [hceil2, g2]
      have h1 := Real.log_le_log hm0 hmle
      rw [Real.log_exp] at h1
      have h2 : t ^ ((1:ℝ)/3) ≤ t := by
        calc t ^ ((1:ℝ)/3) ≤ t ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le ht1 (by norm_num)
          _ = t := Real.rpow_one t
      linarith only [h1, h2]
    · intro R hNR hRN2
      have hRpos : 0 < R := lt_of_lt_of_le hNpos hNR
      have hlo : t ≤ Real.log R := by rw [ht_def]; exact Real.log_le_log hNpos hNR
      have hhi : Real.log R ≤ 2 * t := by
        have h := Real.log_le_log hRpos hRN2
        rw [Real.log_pow] at h
        rw [ht_def]; push_cast at h; linarith only [h]
      constructor
      · have h1 : Real.log R ^ ((1:ℝ)/100) ≤ a := by
          rw [ha_def]; exact Real.rpow_le_rpow (by linarith only [hlo, ht0]) hhi (by norm_num)
        have h2 : Real.exp (Real.log R ^ ((1:ℝ)/100)) ≤ E := by
          rw [hE_def]; exact Real.exp_le_exp.2 h1
        exact h2.trans hceil1
      · have h1 : t ^ ((1:ℝ)/3) ≤ Real.log R ^ ((1:ℝ)/3) :=
          Real.rpow_le_rpow ht0 hlo (by norm_num)
        have h2 := Real.exp_le_exp.2 h1
        linarith only [hceil2, g2, h2]

theorem kai_crt_factorization (K : Type u) [Field K] [NumberField K] (d : ℕ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) (w : ℕ) :
    ((primorial w : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial w) : ℝ)) ^ 4
        * localDensity (primorial w) c₀ c = betaPartial w c₀ c :=
by
  classical
  
  have phimul : ∀ a b : ℕ, Nat.Coprime a b → phiK K (a * b) = phiK K a * phiK K b := by
    intro a b hab
    unfold phiK
    have hAB : Ideal.span {((a * b : ℕ) : NumberField.RingOfIntegers K)}
        = Ideal.span {((a : ℕ) : NumberField.RingOfIntegers K)}
          * Ideal.span {((b : ℕ) : NumberField.RingOfIntegers K)} := by
      rw [Ideal.span_singleton_mul_span_singleton, Nat.cast_mul]
    have hcop : IsCoprime (Ideal.span {((a : ℕ) : NumberField.RingOfIntegers K)})
        (Ideal.span {((b : ℕ) : NumberField.RingOfIntegers K)}) := by
      rw [Ideal.isCoprime_span_singleton_iff]
      have h := (Nat.isCoprime_iff_coprime.2 hab).map
        (Int.castRingHom (NumberField.RingOfIntegers K))
      simpa using h
    rw [hAB, Nat.card_congr ((Units.mapEquiv
      (Ideal.quotientMulEquivQuotientProd _ _ hcop).toMulEquiv).trans
        MulEquiv.prodUnits).toEquiv, Nat.card_prod]
  
  have copmul : ∀ (a b : ℕ) (x : NumberField.RingOfIntegers K),
      CoprimeToNat (a * b) x ↔ CoprimeToNat a x ∧ CoprimeToNat b x := by
    intro a b x
    unfold CoprimeToNat
    push_cast
    constructor
    · intro h
      exact ⟨fun p hp => h p (Ideal.mul_mem_right _ _ hp),
        fun p hp => h p (Ideal.mul_mem_left _ _ hp)⟩
    · rintro ⟨ha, hb⟩ p hp
      rcases p.isPrime.mem_or_mem hp with h | h
      · exact ha p h
      · exact hb p h
  
  have periodic : ∀ (W : ℕ) (e₀ : NumberField.RingOfIntegers K)
      (e : Fin d → NumberField.RingOfIntegers K) (z z' : Fin d → ℤ),
      (∀ k, (W : ℤ) ∣ z k - z' k) →
      (CoprimeToNat W (affEval e₀ e z) ↔ CoprimeToNat W (affEval e₀ e z')) := by
    intro W e₀ e z z' hz
    have key : ∀ I : Ideal (NumberField.RingOfIntegers K),
        ((W : ℕ) : NumberField.RingOfIntegers K) ∈ I →
        affEval e₀ e z - affEval e₀ e z' ∈ I := by
      intro I hI
      have hdiff : affEval e₀ e z - affEval e₀ e z' = ∑ k, (z k - z' k) • e k := by
        unfold affEval
        rw [add_sub_add_left_eq_sub, ← Finset.sum_sub_distrib]
        simp [sub_smul]
      rw [hdiff]
      refine Ideal.sum_mem _ (fun k _ => ?_)
      obtain ⟨m, hm⟩ := hz k
      rw [hm, zsmul_eq_mul]
      push_cast
      rw [mul_assoc]
      exact Ideal.mul_mem_right _ _ hI
    unfold CoprimeToNat
    constructor
    · intro h p hp hx'
      apply h p hp
      have := Ideal.add_mem _ hx' (key _ hp)
      simpa using this
    · intro h p hp hx
      apply h p hp
      have := Ideal.sub_mem _ hx (key _ hp)
      simpa using this
  
  have memBox : ∀ (W : ℕ) (z : Fin d → ℤ),
      z ∈ resBox d W ↔ ∀ k, 0 ≤ z k ∧ z k ≤ (W : ℤ) - 1 := by
    intro W z
    simp only [resBox, Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h k => ⟨h.1 k, h.2 k⟩, fun h => ⟨fun k => (h k).1, fun k => (h k).2⟩⟩
  have modBox : ∀ (W : ℕ), 1 ≤ W → ∀ z : Fin d → ℤ,
      (fun k => z k % (W : ℤ)) ∈ resBox d W := by
    intro W hW z
    rw [memBox]
    intro k
    have hW' : (0 : ℤ) < W := by exact_mod_cast hW
    have h1 := Int.emod_nonneg (z k) hW'.ne'
    have h2 := Int.emod_lt_of_pos (z k) hW'
    exact ⟨h1, by omega⟩
  have dvdMod : ∀ (W : ℕ) (x : ℤ), (W : ℤ) ∣ x - x % (W : ℤ) := by
    intro W x
    exact ⟨x / W, by rw [Int.emod_def]; ring⟩
  have cardBox : ∀ W : ℕ, (resBox d W).card = W ^ d := by
    intro W
    simp only [resBox, Pi.card_Icc, Int.card_Icc, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
    congr 1
    simp
  
  have crt : ∀ (a b : ℕ), 1 ≤ a → 1 ≤ b → Nat.Coprime a b →
      ∀ (P Q : (Fin d → ℤ) → Prop),
      (∀ z z' : Fin d → ℤ, (∀ k, (a : ℤ) ∣ z k - z' k) → (P z ↔ P z')) →
      (∀ z z' : Fin d → ℤ, (∀ k, (b : ℤ) ∣ z k - z' k) → (Q z ↔ Q z')) →
      ((resBox d (a * b)).filter (fun z => P z ∧ Q z)).card
        = ((resBox d a).filter P).card * ((resBox d b).filter Q).card := by
    intro a b ha hb hab P Q hP hQ
    have hab' : IsCoprime (a : ℤ) (b : ℤ) := Nat.isCoprime_iff_coprime.2 hab
    let f : (Fin d → ℤ) → (Fin d → ℤ) × (Fin d → ℤ) :=
      fun z => (fun k => z k % (a : ℤ), fun k => z k % (b : ℤ))
    have inj : ∀ z ∈ resBox d (a * b), ∀ z' ∈ resBox d (a * b), f z = f z' → z = z' := by
      intro z hz z' hz' hfz
      simp only [f, Prod.mk.injEq] at hfz
      obtain ⟨h1, h2⟩ := hfz
      funext k
      have e1 : z' k % (a : ℤ) = z k % (a : ℤ) := (congrFun h1 k).symm
      have e2 : z' k % (b : ℤ) = z k % (b : ℤ) := (congrFun h2 k).symm
      have d1 : (a : ℤ) ∣ z k - z' k := Int.ModEq.dvd e1
      have d2 : (b : ℤ) ∣ z k - z' k := Int.ModEq.dvd e2
      have d3 : (a : ℤ) * (b : ℤ) ∣ z k - z' k := hab'.mul_dvd d1 d2
      have b1 := (memBox _ z).1 hz k
      have b2 := (memBox _ z').1 hz' k
      push_cast at b1 b2
      have h0 : z k - z' k = 0 := by
        apply Int.eq_zero_of_abs_lt_dvd d3
        rw [abs_lt]
        constructor <;> linarith
      linarith
    have surjBox : ∀ u v, u ∈ resBox d a → v ∈ resBox d b →
        ∃ z ∈ resBox d (a * b), f z = (u, v) := by
      intro u v hu hv
      obtain ⟨z, hz, hzeq⟩ := Finset.surj_on_of_inj_on_of_card_le
        (s := resBox d (a * b)) (t := resBox d a ×ˢ resBox d b)
        (fun z _ => f z)
        (fun z _ => Finset.mem_product.2 ⟨modBox a ha z, modBox b hb z⟩)
        (fun z₁ z₂ h₁ h₂ h => inj z₁ h₁ z₂ h₂ h)
        (by rw [Finset.card_product, cardBox, cardBox, cardBox, mul_pow])
        (u, v) (Finset.mem_product.2 ⟨hu, hv⟩)
      exact ⟨z, hz, hzeq.symm⟩
    rw [← Finset.card_product]
    apply Finset.card_nbij f
    · intro z hz
      rw [Finset.mem_coe, Finset.mem_filter] at hz
      rw [Finset.mem_coe, Finset.mem_product, Finset.mem_filter, Finset.mem_filter]
      exact ⟨⟨modBox a ha z, (hP z _ (fun k => dvdMod a (z k))).1 hz.2.1⟩,
        ⟨modBox b hb z, (hQ z _ (fun k => dvdMod b (z k))).1 hz.2.2⟩⟩
    · intro z hz z' hz' h
      rw [Finset.mem_coe, Finset.mem_filter] at hz hz'
      exact inj z hz.1 z' hz'.1 h
    · rintro ⟨u, v⟩ huv
      rw [Finset.mem_coe, Finset.mem_product, Finset.mem_filter, Finset.mem_filter] at huv
      obtain ⟨z, hz, hfz⟩ := surjBox u v huv.1.1 huv.2.1
      refine ⟨z, ?_, hfz⟩
      simp only [f, Prod.mk.injEq] at hfz
      rw [Finset.mem_coe, Finset.mem_filter]
      refine ⟨hz, (hP z _ (fun k => dvdMod a (z k))).2 ?_,
        (hQ z _ (fun k => dvdMod b (z k))).2 ?_⟩
      · rw [hfz.1]; exact huv.1.2
      · rw [hfz.2]; exact huv.2.2
  
  have phi1 : phiK K 1 = 1 := by
    unfold phiK
    haveI : Subsingleton (NumberField.RingOfIntegers K ⧸
        Ideal.span {((1 : ℕ) : NumberField.RingOfIntegers K)}) :=
      Ideal.Quotient.subsingleton_iff.2 (by simp)
    rw [Nat.card_eq_one_iff_unique]
    exact ⟨⟨fun x y => Units.ext (Subsingleton.elim _ _)⟩, ⟨1⟩⟩
  have ld1 : localDensity 1 c₀ c = 1 := by
    unfold localDensity
    have h1 : ∀ x : NumberField.RingOfIntegers K, CoprimeToNat 1 x := by
      intro x p hp
      exact absurd ((Ideal.eq_top_iff_one _).2 (by simpa using hp)) p.isPrime.ne_top
    rw [Finset.filter_true_of_mem (fun z _ => fun i => h1 _), cardBox 1]
    simp
  
  have ldmul : ∀ a b : ℕ, 1 ≤ a → 1 ≤ b → Nat.Coprime a b →
      localDensity (a * b) c₀ c = localDensity a c₀ c * localDensity b c₀ c := by
    intro a b ha hb hab
    unfold localDensity
    have hc := crt a b ha hb hab
      (fun z => ∀ i : Fin 4, CoprimeToNat a (affEval (c₀ i) (c i) z))
      (fun z => ∀ i : Fin 4, CoprimeToNat b (affEval (c₀ i) (c i) z))
      (fun z z' h => forall_congr' (fun i => periodic a (c₀ i) (c i) z z' h))
      (fun z z' h => forall_congr' (fun i => periodic b (c₀ i) (c i) z z' h))
    have hfilt : (resBox d (a * b)).filter
          (fun z => ∀ i : Fin 4, CoprimeToNat (a * b) (affEval (c₀ i) (c i) z))
        = (resBox d (a * b)).filter
          (fun z => (∀ i : Fin 4, CoprimeToNat a (affEval (c₀ i) (c i) z)) ∧
            (∀ i : Fin 4, CoprimeToNat b (affEval (c₀ i) (c i) z))) := by
      apply Finset.filter_congr
      intro z _
      rw [← forall_and]
      exact forall_congr' (fun i => copmul a b _)
    have hcard : (((resBox d (a * b)).filter
          (fun z => ∀ i : Fin 4, CoprimeToNat (a * b) (affEval (c₀ i) (c i) z))).card : ℝ)
        = (((resBox d a).filter
            (fun z => ∀ i : Fin 4, CoprimeToNat a (affEval (c₀ i) (c i) z))).card : ℝ)
          * (((resBox d b).filter
            (fun z => ∀ i : Fin 4, CoprimeToNat b (affEval (c₀ i) (c i) z))).card : ℝ) := by
      rw [hfilt, ← Nat.cast_mul]
      congr 1
      convert hc
    convert congrArg (fun t : ℝ => t / ((a * b : ℕ) : ℝ) ^ d) hcard using 1
    push_cast
    rw [mul_pow, mul_div_mul_comm]
  
  let F : ℕ → ℝ := fun W =>
    ((W : ℝ) ^ Module.finrank ℚ K / (phiK K W : ℝ)) ^ 4 * localDensity W c₀ c
  have Fmul : ∀ a b : ℕ, 1 ≤ a → 1 ≤ b → Nat.Coprime a b → F (a * b) = F a * F b := by
    intro a b ha hb hab
    simp only [F]
    rw [ldmul a b ha hb hab, phimul a b hab]
    push_cast
    rw [show ((a : ℝ) * b) ^ Module.finrank ℚ K / ((phiK K a : ℝ) * phiK K b)
        = ((a : ℝ) ^ Module.finrank ℚ K / phiK K a) * ((b : ℝ) ^ Module.finrank ℚ K / phiK K b)
        by rw [mul_pow, mul_div_mul_comm]]
    ring
  have F1 : F 1 = 1 := by
    simp only [F]
    rw [phi1, ld1]
    simp
  have Fprod : ∀ S : Finset ℕ, (∀ p ∈ S, p.Prime) → F (∏ p ∈ S, p) = ∏ p ∈ S, F p := by
    intro S
    refine Finset.induction_on S (fun _ => by rw [Finset.prod_empty, Finset.prod_empty]; exact F1) ?_
    intro r T hr ih hS
    have hrp : r.Prime := hS r (Finset.mem_insert_self r T)
    have hT : ∀ p ∈ T, p.Prime := fun p hp => hS p (Finset.mem_insert_of_mem hp)
    rw [Finset.prod_insert hr, Finset.prod_insert hr]
    have hcop : Nat.Coprime r (∏ p ∈ T, p) := Nat.Coprime.prod_right
      (fun p hp => (Nat.coprime_primes hrp (hT p hp)).2 (fun h => hr (h ▸ hp)))
    have hM : 1 ≤ ∏ p ∈ T, p := Nat.one_le_iff_ne_zero.2
      (Finset.prod_ne_zero_iff.2 (fun p hp => (hT p hp).ne_zero))
    rw [Fmul r _ hrp.one_lt.le hM hcop, ih hT]
  
  have hS : ∀ p ∈ (Finset.range (w + 1)).filter Nat.Prime, p.Prime :=
    fun p hp => (Finset.mem_filter.1 hp).2
  have hfin := Fprod _ hS
  have hprim : primorial w = ∏ p ∈ (Finset.range (w + 1)).filter Nat.Prime, p := rfl
  rw [hprim]
  exact hfin

theorem kai_cramer_comparison (K : Type u) [Field K] [NumberField K] (d : ℕ) (hd : 1 ≤ d) :
    ∃ e₀ f₀ : ℝ, 0 < e₀ ∧ 0 < f₀ ∧
      ∀ (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ
            (NumberField.RingOfIntegers K)),
        IsNormLengthCompatible C ω →
        ∃ ρ : ℝ, 0 < ρ ∧ ∃ C₃ : ℝ, 0 ≤ C₃ ∧
          ∀ (c₀ : Fin 4 → NumberField.RingOfIntegers K)
            (c : Fin 4 → Fin d → NumberField.RingOfIntegers K),
            (∀ i j : Fin 4, i ≠ j →
                Finite (NumberField.RingOfIntegers K ⧸
                  Submodule.map (homMap (c i)) (LinearMap.ker (homMap (c j))))) →
            ∀ (N : ℕ) (Ω : Set (Fin d → ℝ)),
              16 < (N : ℝ) → MeasurableSet Ω → Convex ℝ Ω →
              Ω ⊆ realBox d (N : ℝ) →
              (∀ i : Fin 4, kaiFormNorm ω (c₀ i) (c i) (N : ℝ)
                  ≤ Real.log (Real.log (N : ℝ)) ^ e₀) →
              |kaiSum c₀ c Ω N - cramerSum ρ (kaiW (N : ℝ)) c₀ c Ω N|
                ≤ C₃ * (N : ℝ) ^ d / Real.log (Real.log (N : ℝ)) ^ f₀ :=
by
  classical
  have abs4 : ∀ (x₁ x₂ x₃ x₄ b₁ b₂ b₃ b₄ : ℝ), |x₁| ≤ b₁ → |x₂| ≤ b₂ → |x₃| ≤ b₃ →
      |x₄| ≤ b₄ → |x₁ + x₂ + x₃ + x₄| ≤ b₁ + b₂ + b₃ + b₄ := by
    intro x₁ x₂ x₃ x₄ b₁ b₂ b₃ b₄ h₁ h₂ h₃ h₄
    have e1 := abs_add_le (x₁ + x₂ + x₃) x₄
    have e2 := abs_add_le (x₁ + x₂) x₃
    have e3 := abs_add_le x₁ x₂
    linarith
  obtain ⟨ρ, hρ, hs1⟩ := kai_gowers_uniformity K
  obtain ⟨a, ha, hs9⟩ := kai_local_factor_bounds K d
  obtain ⟨C₂, hC₂, hs10⟩ := kai_coprime_model_count K d hd
  obtain ⟨C_M, hC_M, hs5⟩ := kai_cramer_density_bound K
  have hCM0 : (0 : ℝ) ≤ C_M := by linarith
  obtain ⟨e₀, he₀_def⟩ : ∃ e₀ : ℝ, e₀ = min 1 (1 / (2 * a)) := ⟨_, rfl⟩
  have he₀pos : 0 < e₀ := by rw [he₀_def]; exact lt_min one_pos (by positivity)
  have he₀1 : e₀ ≤ 1 := by rw [he₀_def]; exact min_le_left _ _
  have he₀a : e₀ ≤ 1 / (2 * a) := by rw [he₀_def]; exact min_le_right _ _
  refine ⟨e₀, 1 / 2, he₀pos, by norm_num, ?_⟩
  intro C ω hω
  have hn1 : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hC1 : 1 < C := hω.1
  have hlogC : 0 < Real.log C := Real.log_pos hC1
  obtain ⟨C_vN, hCvN, K₀, J, hs2⟩ := kai_von_neumann_U3 K d hd ω
  obtain ⟨C₁, hC₁, hs9'⟩ := hs9 ω
  have hC₁nn : 0 ≤ C₁ := by linarith
  obtain ⟨C_s, hCs, hs3⟩ := kai_sieve_large_modulus K d hd (4 * Module.finrank ℚ K + 1)
  obtain ⟨C_B, hCB, hs1'⟩ := hs1 C ω hω ((J + 1) * (4 * Module.finrank ℚ K + K₀ + 1))
  obtain ⟨A₀, hA₀_def⟩ : ∃ A₀ : ℝ, A₀ = max (max C_vN ((d : ℝ) + 1)) (4 * C₁ ^ 2) :=
    ⟨_, rfl⟩
  obtain ⟨N₁, hN₁16, hthr⟩ := kai_large_N_thresholds A₀ K₀
  obtain ⟨-, hy2₁, -, -, -⟩ := hthr N₁ le_rfl
  
  obtain ⟨cT, hcT_def⟩ : ∃ cT : ℝ,
      cT = (Module.finrank ℚ K : ℝ) * (Real.log C + 2) + ρ * C_M ^ Module.finrank ℚ K + 1 :=
    ⟨_, rfl⟩
  have hCMn : 0 ≤ C_M ^ Module.finrank ℚ K := pow_nonneg hCM0 _
  have hcT1 : 1 ≤ cT := by
    rw [hcT_def]
    have h1 : 0 ≤ (Module.finrank ℚ K : ℝ) * (Real.log C + 2) :=
      mul_nonneg (Nat.cast_nonneg _) (by linarith)
    have h2 : 0 ≤ ρ * C_M ^ Module.finrank ℚ K := mul_nonneg hρ.le hCMn
    linarith
  obtain ⟨KA, hKA_def⟩ : ∃ KA : ℝ, KA = C_vN * cT ^ 4 * 2 ^ d * (C_B + 1) := ⟨_, rfl⟩
  obtain ⟨KB, hKB_def⟩ : ∃ KB : ℝ,
      KB = ρ ^ 4 * C_M ^ (4 * Module.finrank ℚ K) * C_s := ⟨_, rfl⟩
  obtain ⟨AW, hAW⟩ : ∃ AW : ℕ, AW = 2 * (4 * Module.finrank ℚ K + d) + 1 := ⟨_, rfl⟩
  have hAW0 : AW ≠ 0 := by omega
  obtain ⟨KC, hKC_def⟩ : ∃ KC : ℝ, KC = ρ ^ 4 * C₂ * 3 ^ (d - 1) * (AW : ℝ) ^ AW := ⟨_, rfl⟩
  obtain ⟨KD, hKD_def⟩ : ∃ KD : ℝ, KD = 2 ^ d * ρ ^ 4 * (4 * C₁) := ⟨_, rfl⟩
  obtain ⟨L₁, hL₁_def⟩ : ∃ L₁ : ℝ, L₁ = Real.log (Real.log N₁) ^ e₀ := ⟨_, rfl⟩
  have hL₁1 : 1 ≤ L₁ := by rw [hL₁_def]; exact Real.one_le_rpow (by linarith) he₀pos.le
  obtain ⟨M₁, hM₁_def⟩ : ∃ M₁ : ℝ, M₁ = ((d : ℝ) + 1) * L₁ * N₁ := ⟨_, rfl⟩
  have hM₁1 : 1 ≤ M₁ := by
    rw [hM₁_def]
    have hd1 : (1 : ℝ) ≤ (d : ℝ) + 1 := by linarith [(Nat.cast_nonneg d : (0 : ℝ) ≤ d)]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hd1 hL₁1)
      (by linarith)
  obtain ⟨lam₁, hlam₁_def⟩ : ∃ lam₁ : ℝ,
      lam₁ = (Module.finrank ℚ K : ℝ) * Real.log (C * M₁) := ⟨_, rfl⟩
  have hlam₁ : 0 ≤ lam₁ := by
    rw [hlam₁_def]
    exact mul_nonneg (Nat.cast_nonneg _)
      (Real.log_nonneg (one_le_mul_of_one_le_of_one_le hC1.le hM₁1))
  obtain ⟨mu₁, hmu₁_def⟩ : ∃ mu₁ : ℝ,
      mu₁ = ρ * (C_M * max 1 (Real.log (Real.log N₁))) ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hmu₁ : 0 ≤ mu₁ := by
    rw [hmu₁_def]
    exact mul_nonneg hρ.le
      (pow_nonneg (mul_nonneg hCM0 (le_trans zero_le_one (le_max_left _ _))) _)
  obtain ⟨Ksm, hKsm_def⟩ : ∃ Ksm : ℝ, Ksm = (2 * N₁ + 1) ^ d * (lam₁ ^ 4 + mu₁ ^ 4) :=
    ⟨_, rfl⟩
  have hKsm : 0 ≤ Ksm := by
    rw [hKsm_def]
    exact mul_nonneg (pow_nonneg (by linarith) _) (by positivity)
  obtain ⟨Y₁, hY₁_def⟩ : ∃ Y₁ : ℝ, Y₁ = Real.log (Real.log N₁) ^ ((1 : ℝ) / 2) := ⟨_, rfl⟩
  have hY₁ : 0 ≤ Y₁ := by rw [hY₁_def]; exact Real.rpow_nonneg (by linarith) _
  have hKA : 0 ≤ KA := by
    rw [hKA_def]
    exact mul_nonneg (mul_nonneg (mul_nonneg hCvN (by positivity)) (by positivity))
      (by linarith)
  have hKB : 0 ≤ KB := by
    rw [hKB_def]
    exact mul_nonneg (mul_nonneg (by positivity) (pow_nonneg hCM0 _)) hCs
  have hKC : 0 ≤ KC := by
    rw [hKC_def]
    exact mul_nonneg (mul_nonneg (mul_nonneg (by positivity) hC₂) (by positivity))
      (by positivity)
  have hKD : 0 ≤ KD := by
    rw [hKD_def]
    exact mul_nonneg (by positivity) (by linarith)
  have hKsmY : 0 ≤ Ksm * Y₁ := mul_nonneg hKsm hY₁
  refine ⟨ρ, hρ, KA + KB + KC + KD + Ksm * Y₁, by linarith, ?_⟩
  intro c₀ c hCOK N Ω hN hΩm hΩc hΩbox hnorm
  
  have hNpos : (0 : ℝ) < N := by linarith
  have hN1 : (1 : ℝ) < N := by linarith
  have hNd : 0 ≤ (N : ℝ) ^ d := by positivity
  have htpos0 : 0 < Real.log (N : ℝ) := Real.log_pos hN1
  have hlog1 : 1 < Real.log (N : ℝ) := by
    rw [Real.lt_log_iff_exp_lt hNpos]
    have := Real.exp_one_lt_d9
    linarith
  have hcoef' : ∀ i k, basisSupNorm ω (c i k) ≤ Real.log (Real.log (N : ℝ)) ^ e₀ := by
    intro i k
    have h1 : basisSupNorm ω (c i k) ≤ ⨆ k, basisSupNorm ω (c i k) :=
      le_ciSup (f := fun k => basisSupNorm ω (c i k)) (Set.finite_range _).bddAbove k
    have h2 := hnorm i
    unfold kaiFormNorm at h2
    exact h1.trans ((le_max_right _ _).trans h2)
  have hcoef0' : ∀ i, basisSupNorm ω (c₀ i) ≤ Real.log (Real.log (N : ℝ)) ^ e₀ * N := by
    intro i
    have h2 := hnorm i
    unfold kaiFormNorm at h2
    have h3 := (le_max_left _ _).trans h2
    rwa [div_le_iff₀ hNpos] at h3
  have hmodel : ∀ M' : ℕ, cramerSum ρ (primorial M') c₀ c Ω N
