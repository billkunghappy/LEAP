      have hle : Real.log (k : ℝ) ≤ Real.log (((k + 1 : ℕ)) : ℝ) := by
        rcases Nat.eq_zero_or_pos k with hk | hk
        · subst hk; simp
        · exact Real.log_le_log (by exact_mod_cast hk) (by push_cast; linarith)
      rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.2 hle)]
      ring
  have hτV : ∀ Y : ℝ, ‖kaiTypeIForm ω M Φ (fun _ => 1)
      (D.filter (fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) ≤ V)) (fun 𝔡 => ((μ' 𝔡 : ℝ) : ℂ)) Y‖ ≤ τ :=
    fun Y => hI _ _ Y hIVsub hIVnorm
      (fun 𝔡 => by rw [Complex.norm_real, Real.norm_eq_abs]; exact hμ 𝔡)
  have hb2a : ‖∑ x ∈ omegaBox ω M, P2a x‖ ≤ 2 * Real.log Nmax * τ := by
    rw [hP2a]
    have hw : |(fun t : ℕ => Real.log (t : ℝ)) Nmax| + ∑ t ∈ Finset.range Nmax,
        |(fun t : ℕ => Real.log (t : ℝ)) t - (fun t : ℕ => Real.log (t : ℝ)) (t + 1)|
        ≤ 2 * Real.log Nmax := by
      show |Real.log (Nmax : ℝ)| + ∑ t ∈ Finset.range Nmax,
          |Real.log (t : ℝ) - Real.log (((t + 1 : ℕ)) : ℝ)| ≤ 2 * Real.log Nmax
      rw [htel, abs_of_nonneg (Real.log_natCast_nonneg Nmax)]
      linarith
    exact hTransfer (fun _ => 1) _ (fun 𝔡 => ((μ' 𝔡 : ℝ) : ℂ))
      (fun t => Real.log (t : ℝ)) (2 * Real.log Nmax) hτV hw
  
  have hb2b : ‖∑ x ∈ omegaBox ω M, P2b x‖ ≤ Real.log V * τ
      + T * Real.log V * ((D.filter (fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) ≤ V)).card : ℝ) := by
    rw [hP2b]
    exact hpunct _ (fun 𝔡 => μ' 𝔡 * Real.log (Ideal.absNorm 𝔡 : ℝ)) (Real.log V) hlogV
      hIVsub hIVnorm
      (fun 𝔡 h𝔡 => by
        obtain ⟨h𝔡D, h𝔡V⟩ := Finset.mem_filter.1 h𝔡
        have h1 := hN1 𝔡 h𝔡D
        have hl0 : 0 ≤ Real.log (Ideal.absNorm 𝔡 : ℝ) := Real.log_nonneg h1
        have hl : Real.log (Ideal.absNorm 𝔡 : ℝ) ≤ Real.log V :=
          Real.log_le_log (by linarith) h𝔡V
        show |μ' 𝔡 * Real.log (Ideal.absNorm 𝔡 : ℝ)| ≤ Real.log V
        rw [abs_mul, abs_of_nonneg hl0]
        calc |μ' 𝔡| * Real.log (Ideal.absNorm 𝔡 : ℝ) ≤ 1 * Real.log V :=
              mul_le_mul (hμ 𝔡) hl hl0 zero_le_one
          _ = Real.log V := one_mul _)
  
  have hb3 : ‖∑ x ∈ omegaBox ω M, P3 x‖ ≤ Real.log (U * V) * τ
      + T * Real.log (U * V) * ((D.filter (fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) ≤ U * V)).card : ℝ) := by
    rw [hP3]
    exact hpunct _ a (Real.log (U * V)) hlogUV hIUVsub hIUVnorm
      (fun 𝔣 h𝔣 => by
        obtain ⟨h𝔣D, h𝔣UV⟩ := Finset.mem_filter.1 h𝔣
        have h1 := hN1 𝔣 h𝔣D
        exact (ha 𝔣 (hD 𝔣 h𝔣D)).trans (Real.log_le_log (by linarith) h𝔣UV))
  
  have hTII : ∑ x ∈ omegaBox ω M, P4 x
      = kaiTypeIIForm ω M Φ (D.filter (fun 𝔡 => V < (Ideal.absNorm 𝔡 : ℝ)))
        (D.filter (fun 𝔡 => U < (Ideal.absNorm 𝔡 : ℝ)))
        (fun 𝔡 => ((μ' 𝔡 : ℝ) : ℂ)) (fun 𝔡 => ((γ 𝔡 : ℝ) : ℂ)) := by
    rw [hP4]
    unfold kaiTypeIIForm
    simp only [Finset.sum_filter, Complex.ofReal_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
    rw [Finset.sum_comm]
    by_cases h1 : V < (Ideal.absNorm 𝔡 : ℝ)
    · rw [if_pos h1]
      refine Finset.sum_congr rfl (fun 𝔪 _ => ?_)
      by_cases h2 : U < (Ideal.absNorm 𝔪 : ℝ)
      · rw [if_pos h2, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        by_cases h3 : Ideal.span {x} = 𝔡 * 𝔪
        · simp [h1, h3]
        · simp [h3]
      · rw [if_neg h2]
        refine Finset.sum_eq_zero (fun x _ => ?_)
        rw [hγ 𝔪 (not_lt.1 h2)]
        simp
    · rw [if_neg h1]
      refine Finset.sum_eq_zero (fun 𝔪 _ => Finset.sum_eq_zero (fun x _ => ?_))
      simp [h1]
  have hb4 : ‖∑ x ∈ omegaBox ω M, P4 x‖ ≤ τ := by rw [hTII]; exact hII
  
  have hdecomp : ∑ x ∈ omegaBox ω M, ((vonMangoldtO x : ℝ) : ℂ) * Φ x
      = ∑ x ∈ omegaBox ω M, P1 x + ∑ x ∈ omegaBox ω M, P2a x - ∑ x ∈ omegaBox ω M, P2b x
        - ∑ x ∈ omegaBox ω M, P3 x + ∑ x ∈ omegaBox ω M, P4 x := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib,
      ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl hpt
  have tri : ∀ a b c d e : ℂ, ‖a + b - c - d + e‖ ≤ ‖a‖ + ‖b‖ + ‖c‖ + ‖d‖ + ‖e‖ := by
    intro a b c d e
    have h1 := norm_add_le (a + b - c - d) e
    have h2 := norm_sub_le (a + b - c) d
    have h3 := norm_sub_le (a + b) c
    have h4 := norm_add_le a b
    linarith
  rw [hdecomp]
  refine (tri _ _ _ _ _).trans ?_
  linarith [hb1, hb2a, hb2b, hb3, hb4]

theorem kai_v_vaughan_reduction (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ (K₀ : ℝ) (k₀ : ℕ) (M₀ : ℝ), 1 ≤ K₀ ∧ 3 ≤ M₀ ∧
      ∀ (M : ℝ) (m : ℕ), M₀ ≤ M →
        Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
        (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
      ∀ (Dt : Ideal (NumberField.RingOfIntegers K) ×
          (NumberField.RingOfIntegers K → ℤ) × ℝ), IsSiegelDatum m Dt →
      ∀ (Φ : NumberField.RingOfIntegers K → ℂ) (T τ : ℝ), 0 ≤ T → 0 ≤ τ →
        (∀ x ∈ omegaBox ω M, ‖Φ x‖ ≤ T) →
        (∀ (I : Finset (Ideal (NumberField.RingOfIntegers K)))
            (A : Ideal (NumberField.RingOfIntegers K) → ℂ) (Y : ℝ),
            (∀ 𝔡 ∈ I, 𝔡 ≠ ⊥ ∧
              (Ideal.absNorm 𝔡 : ℝ) ≤ M ^ ((3 * (Module.finrank ℚ K : ℝ)) / 4)) →
            (∀ 𝔡, ‖A 𝔡‖ ≤ 1) →
            ‖kaiTypeIForm ω M Φ (fun _ => 1) I A Y‖ ≤ τ) →
        (∀ (I₁ I₂ : Finset (Ideal (NumberField.RingOfIntegers K)))
            (L T' : Ideal (NumberField.RingOfIntegers K) → ℂ),
            (∀ 𝔡 ∈ I₁, 𝔡 ≠ ⊥ ∧
              M ^ ((Module.finrank ℚ K : ℝ) / 4) ≤ (Ideal.absNorm 𝔡 : ℝ)) →
            (∀ 𝔡 ∈ I₂, 𝔡 ≠ ⊥ ∧
              M ^ ((Module.finrank ℚ K : ℝ) / 4) ≤ (Ideal.absNorm 𝔡 : ℝ)) →
            (∀ 𝔡, ‖L 𝔡‖ ≤ 1) →
            ∑ 𝔡 ∈ I₂, ‖T' 𝔡‖ ^ 2 / (Ideal.absNorm 𝔡 : ℝ) ≤ Real.log M ^ 8 →
            ‖kaiTypeIIForm ω M Φ I₁ I₂ L T'‖ ≤ τ) →
        ‖∑ x ∈ omegaBox ω M,
            ((vonMangoldtO x - cramerModel K ρ (primorial m) x : ℝ) : ℂ) * Φ x‖
          ≤ K₀ * Real.log M ^ k₀ * τ
            + K₀ * T * ((omegaBox ω M).card : ℝ)
                * Real.exp (-(Real.sqrt (Real.log M) / K₀)) ∧
        ((∀ (I : Finset (Ideal (NumberField.RingOfIntegers K)))
            (A : Ideal (NumberField.RingOfIntegers K) → ℂ) (Y : ℝ),
            (∀ 𝔡 ∈ I, 𝔡 ≠ ⊥ ∧
              (Ideal.absNorm 𝔡 : ℝ) ≤ M ^ ((3 * (Module.finrank ℚ K : ℝ)) / 4)) →
            (∀ 𝔡, ‖A 𝔡‖ ≤ 1) →
            ‖kaiTypeIForm ω M Φ (fun x => ((Dt.2.1 x : ℤ) : ℂ)) I A Y‖ ≤ τ) →
          ‖∑ x ∈ omegaBox ω M,
              ((vonMangoldtO x - siegelModel K ρ (primorial m) Dt.2.1 Dt.2.2 x : ℝ) : ℂ)
                * Φ x‖
            ≤ K₀ * Real.log M ^ k₀ * τ
              + K₀ * T * ((omegaBox ω M).card : ℝ)
                  * Real.exp (-(Real.sqrt (Real.log M) / K₀))) :=
by
  classical
  obtain ⟨C₅, hC₅, hcount⟩ := kai_ideal_count_bounds K
  obtain ⟨K₂, hK₂, hsmall⟩ := kai_small_norm_count K ω
  obtain ⟨M₁, hM₁, hbrun⟩ := kai_brun_coprime_decomp K ω
  obtain ⟨C_M, hC_M, hdens⟩ := kai_cramer_density_bound K
  have hn0 : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hn1 : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn0
  have hnne : (Module.finrank ℚ K : ℝ) ≠ 0 := by linarith
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hCM0 : (0 : ℝ) ≤ C_M := by linarith
  have hC₅0 : (0 : ℝ) ≤ C₅ := by linarith
  obtain ⟨Q, hQ_def⟩ : ∃ Q : ℝ, Q = ρ * C_M ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hQ0 : 0 ≤ Q := by rw [hQ_def]; exact mul_nonneg hρ.le (pow_nonneg hCM0 _)
  obtain ⟨KA, hKA_def⟩ : ∃ KA : ℝ,
      KA = 2 * (Module.finrank ℚ K : ℝ) * K₂ + (Module.finrank ℚ K : ℝ) * C₅ := ⟨_, rfl⟩
  have hKA0 : 0 ≤ KA := by
    rw [hKA_def]
    exact add_nonneg (mul_nonneg (by linarith) hK₂) (mul_nonneg (by linarith) hC₅0)
  obtain ⟨G, hG_def⟩ : ∃ G : ℝ,
      G = (4 : ℝ) ^ Module.finrank ℚ K * ((2 * Module.finrank ℚ K).factorial : ℝ) := ⟨_, rfl⟩
  have hfac0 : (0 : ℝ) < ((2 * Module.finrank ℚ K).factorial : ℝ) := by
    exact_mod_cast Nat.factorial_pos _
  have hfac1 : (1 : ℝ) ≤ ((2 * Module.finrank ℚ K).factorial : ℝ) := by
    exact_mod_cast Nat.factorial_pos _
  have hG1 : 1 ≤ G := by
    rw [hG_def]; exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num)) hfac1
  obtain ⟨K₀, hK₀_def⟩ : ∃ K₀ : ℝ,
      K₀ = 2 + 6 * (Module.finrank ℚ K : ℝ) + 3 * Q + (KA + 2 * Q) * G := ⟨_, rfl⟩
  have hKAQG : 0 ≤ (KA + 2 * Q) * G := mul_nonneg (by linarith) (by linarith)
  have hK₀2 : 2 ≤ K₀ := by rw [hK₀_def]; linarith
  obtain ⟨L₀, hL₀_def⟩ : ∃ L₀ : ℝ,
      L₀ = max 16 (max (Real.log C) (12 * (Module.finrank ℚ K : ℝ) ^ 3 * C₅)) := ⟨_, rfl⟩
  refine ⟨K₀, Module.finrank ℚ K, max (max 3 M₁) (Real.exp L₀), by linarith,
    le_max_of_le_left (le_max_left _ _), ?_⟩
  intro M m hM hm1 hm2 Dt hDt Φ T τ hT hτ hΦ hI hII
  have hM3 : 3 ≤ M := le_trans (le_max_of_le_left (le_max_left _ _)) hM
  have hMM₁ : M₁ ≤ M := le_trans (le_max_of_le_left (le_max_right _ _)) hM
  have hML : Real.exp L₀ ≤ M := le_trans (le_max_right _ _) hM
  have hMpos : 0 < M := by linarith
  have hM1 : 1 ≤ M := by linarith
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ, ℓ = Real.log M := ⟨_, rfl⟩
  have hMexp : M = Real.exp ℓ := by rw [hℓ, Real.exp_log hMpos]
  have hℓL : L₀ ≤ ℓ := by
    rw [hℓ]
    calc L₀ = Real.log (Real.exp L₀) := (Real.log_exp _).symm
      _ ≤ Real.log M := Real.log_le_log (Real.exp_pos _) hML
  have hℓ16 : 16 ≤ ℓ := le_trans (by rw [hL₀_def]; exact le_max_left _ _) hℓL
  have hℓC : Real.log C ≤ ℓ :=
    le_trans (by rw [hL₀_def]; exact le_trans (le_max_left _ _) (le_max_right _ _)) hℓL
  have hℓC₅ : 12 * (Module.finrank ℚ K : ℝ) ^ 3 * C₅ ≤ ℓ :=
    le_trans (by rw [hL₀_def]; exact le_trans (le_max_right _ _) (le_max_right _ _)) hℓL
  have hℓ1 : 1 ≤ ℓ := by linarith
  have hℓ0 : 0 ≤ ℓ := by linarith
  have hnℓ : 16 ≤ (Module.finrank ℚ K : ℝ) * ℓ := by
    have := mul_le_mul hn1 hℓ16 (by norm_num) (by linarith)
    linarith
  
  have hBcard : (omegaBox ω M).card = (2 * ⌊M⌋₊ + 1) ^ Module.finrank ℚ K := by
    have h1 : (omegaBox ω M).card = (intBox (Module.finrank ℚ K) ⌊M⌋₊).card :=
      Finset.card_image_of_injective _ ω.equivFun.symm.injective
    rw [h1]
    unfold intBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  obtain ⟨Bc, hBc_def⟩ : ∃ Bc : ℝ, Bc = ((omegaBox ω M).card : ℝ) := ⟨_, rfl⟩
  have hB0 : 0 ≤ Bc := by rw [hBc_def]; exact Nat.cast_nonneg _
  have hBexp : Real.exp ((Module.finrank ℚ K : ℝ) * ℓ) ≤ Bc := by
    rw [Real.exp_nat_mul, ← hMexp, hBc_def, hBcard]
    push_cast
    apply pow_le_pow_left₀ hMpos.le
    have h := Nat.lt_floor_add_one M
    have h0 : (0 : ℝ) ≤ (⌊M⌋₊ : ℝ) := Nat.cast_nonneg _
    linarith
  
  have hCM : 1 ≤ C * M := by nlinarith
  obtain ⟨Nmax, hNmax_def⟩ : ∃ N : ℕ, N = ⌊(C * M) ^ Module.finrank ℚ K⌋₊ := ⟨_, rfl⟩
  have hNmax1 : 1 ≤ Nmax := by
    rw [hNmax_def]; apply Nat.le_floor; push_cast; exact one_le_pow₀ hCM
  have hNmaxR : (1 : ℝ) ≤ (Nmax : ℝ) := by exact_mod_cast hNmax1
  have hNmaxle : (Nmax : ℝ) ≤ (C * M) ^ Module.finrank ℚ K := by
