    have n2 : ‖E' * (Hh - Hh') * (r : ℂ)‖ ≤ ‖Hh - Hh'‖ := by
      rw [norm_mul, norm_mul, hE', one_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg h0]
      exact mul_le_of_le_one_right (norm_nonneg _) h1
    have n3 : ‖E' * Hh' * ((r - r' : ℝ) : ℂ)‖ ≤ Q * |r - r'| := by
      rw [norm_mul, norm_mul, hE', one_mul, Complex.norm_real, Real.norm_eq_abs]
      exact mul_le_mul_of_nonneg_right hH' (abs_nonneg _)
    linarith
  
  obtain ⟨w, hw⟩ : ∃ w : Fin ν → Fin a → ℝ, ∀ l i, w l i = L * σ l i := ⟨_, fun _ _ => rfl⟩
  have hwb : ∀ l i, |w l i| ≤ W₀ := by
    intro l i; rw [hw, abs_mul, abs_of_pos hLpos, hL]; exact hσ l i
  obtain ⟨G, hG⟩ : ∃ G : (Fin ν → Fin Δ) → (Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ) → ℂ,
      ∀ ρ p, G ρ p = Complex.exp (2 * Real.pi * Complex.I * ((p (Sum.inl ()) : ℝ) : ℂ))
        * H (fun i => c' ρ i + ∑ l, T (p (Sum.inr (Sum.inr (Sum.inl l)))) * w l i)
            (fun j => p (Sum.inr (Sum.inl j)))
        * ((∏ l, P (p (Sum.inr (Sum.inr (Sum.inr l)))) : ℝ) : ℂ) := ⟨_, fun _ _ => rfl⟩
  obtain ⟨Ψ₀, hΨ₀⟩ : ∃ Ψ₀ : (Fin ν → Fin Δ) → Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ,
      ∀ ρ, Ψ₀ ρ = Sum.elim (fun _ => s₀ ρ) (Sum.elim (fun _ => 0)
        (Sum.elim (fun _ => 0) (fun l => -((ρ l : ℕ) : ℝ) / Δ))) := ⟨_, fun _ => rfl⟩
  obtain ⟨Ψ₁, hΨ₁⟩ : ∃ Ψ₁ : (Fin ν → Fin Δ) → Fin ν → Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ,
      ∀ ρ l', Ψ₁ ρ l' = Sum.elim (fun _ => s₁ ρ l') (Sum.elim (fun j => τ l' j)
        (Sum.elim (fun l => if l' = l then 1 / L else 0)
          (fun l => if l' = l then 1 / (Δ : ℝ) else 0))) := ⟨_, fun _ _ => rfl⟩
  obtain ⟨Ψ₂, hΨ₂⟩ : ∃ Ψ₂ : (Fin ν → Fin Δ) → Fin ν → Fin ν → Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ,
      ∀ ρ l l', Ψ₂ ρ l l' = Sum.elim (fun _ => s₂ ρ l l') (fun _ => 0) :=
    ⟨_, fun _ _ _ => rfl⟩
  have hPi : ∀ p : Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ,
      0 ≤ ∏ l, P (p (Sum.inr (Sum.inr (Sum.inr l)))) ∧
        ∏ l, P (p (Sum.inr (Sum.inr (Sum.inr l)))) ≤ 1 := fun p =>
    ⟨Finset.prod_nonneg (fun l _ => (hPb _).1),
      Finset.prod_le_one (fun l _ => (hPb _).1) (fun l _ => (hPb _).2)⟩
  refine ⟨G, Ψ₀, Ψ₁, Ψ₂, ?_, ?_, ?_, ?_⟩
  · 
    intro ρ p
    rw [hG, norm_mul, norm_mul, hE1, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (hPi p).1]
    calc ‖H _ _‖ * _ ≤ Q * 1 := mul_le_mul (hHb _ _) (hPi p).2 (hPi p).1 hQ
      _ = Q := mul_one Q
  · 
    intro ρ p γ
    rw [hG, hG]
    simp only [hTper, hPper, hEper]
    have hH := hHper (fun i => c' ρ i + ∑ l, T (p (Sum.inr (Sum.inr (Sum.inl l)))) * w l i)
      (fun j => p (Sum.inr (Sum.inl j))) (fun j => γ (Sum.inr (Sum.inl j)))
    simp only at hH
    rw [hH]
  · 
    intro ρ p p'
    have hX : ∀ q : Unit ⊕ (Fin d ⊕ (Fin ν ⊕ Fin ν)) → ℝ, ∀ i,
