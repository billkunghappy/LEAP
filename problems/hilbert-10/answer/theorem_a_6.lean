  have hyδ : Real.sqrt (Real.log X) / (4 * ((r:ℝ) + 1) * c₂) = δ * u ^ 2 := by
    rw [← hu2, hδ_def]; ring
  have hy0 : 0 ≤ Real.sqrt (Real.log X) / (4 * ((r:ℝ) + 1) * c₂) := by positivity
  obtain ⟨hl1, hlE, hl2⟩ := s1 _ hy0
  rw [← hl] at hl1 hlE hl2
  obtain ⟨hNr, hP, hDe, hDG⟩ := s3 N u hu0 hN1 hN
  rw [hu4, ← hA₀_def] at hP
  rw [← hD₀_def] at hDe hDG
  have hlE' : Real.exp (δ * u ^ 2) ≤ (l:ℝ) := by rw [← hyδ]; exact hlE
  obtain ⟨hΔ, hΔθ⟩ := s6 N u δ l D₀ hD₀_def hN1 hδ hu1 hu2δ huD hlE' hDe
  have hN0 : 0 ≤ N := by linarith
  have hW : 0 ≤ B * N ^ r * (n : ℝ) ^ 2 * Real.log X := by positivity
  have hbud := s5 (Real.sqrt (Real.log X)) (l:ℝ)
    (2 * (B * N ^ r * (n : ℝ) ^ 2 * Real.log X) + 5)
    (2 * (B * N ^ r * (n : ℝ) ^ 2 * Real.log X) + 4) (N ^ r)
    ((n : ℝ) * (r : ℝ) * (B * N) + 1) (X ^ n) (Real.exp (((r:ℝ) + 4) * u)) A₀ D₀
    hs0 hlE hl2 (by linarith) hP (by linarith) (by linarith) (by positivity) hNr
    (by positivity) hDG (Real.one_le_exp (by positivity)) hXn hA₀ hD₀
  rw [← hKs_def] at hbud
  have hGM : Real.exp (((r:ℝ) + 4) * u) ^ (r + 2) = Real.exp (M * u) := by
    rw [← Real.exp_nat_mul]; congr 1; rw [hM_def]; push_cast; ring
  rw [hGM, hyδ] at hbud
  have hgd := s4 M δ u (by linarith) hδ huM
  have hc2 : 2 / δ ≤ max (Ks + 1) (2 / δ) := le_max_right _ _
  have hcK : Ks ≤ max (Ks + 1) (2 / δ) := le_trans (by linarith) (le_max_left _ _)
  have hcpos : 0 < max (Ks + 1) (2 / δ) := lt_of_lt_of_le (by linarith) (le_max_left _ _)
  have hexp : Real.exp (-(δ / 2 * u ^ 2))
      ≤ Real.exp (-Real.sqrt (Real.log X) / max (Ks + 1) (2 / δ)) := by
    rw [Real.exp_le_exp, neg_div, neg_le_neg_iff, hu2]
    calc Real.sqrt (Real.log X) / max (Ks + 1) (2 / δ)
        ≤ Real.sqrt (Real.log X) / (2 / δ) :=
          div_le_div_of_nonneg_left hs0 (by positivity) hc2
