      exact_mod_cast congrArg (fun r : ℚ => (r : ℝ)) (hJnorm ν)
    rw [← hR, Real.mul_rpow (Nat.cast_nonneg _) hβpos.le, mul_comm]
  have hg0 : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      (0 : ℝ) ≤ ((FractionalIdeal.absNorm
            (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
              : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
          (-((3 : ℝ) / 2)) :=
    fun _ => mul_nonneg (Real.rpow_nonneg hβpos.le _)
      (Real.rpow_nonneg (Nat.cast_nonneg _) _)
  have hgsum : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
