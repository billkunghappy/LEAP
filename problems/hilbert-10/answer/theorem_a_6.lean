              kaiMFConeWeight K g u - 0‖
          ≤ e₀⁻¹ * Real.exp (-(e₀ *
              Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)))) :=
by
  classical
  
  have hSep : ∃ ε : ℝ, 0 < ε ∧ ∀ μ : ↥a,
