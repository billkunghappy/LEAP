          (Q * (2 + |s.im|)) ^
            max A₁ (A₁ * Real.exp (81 * Real.pi / 320 + 5 * A₁ ^ 2 / Real.pi)) :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hR1 (le_max_left _ _)) hA₀pos.le

theorem kai_ideal_four_fold_conv_nonneg (K : Type u) [Field K] [NumberField K]
    (lam₁ lam₂ : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hmul₁ : ∀ I J : Ideal (NumberField.RingOfIntegers K),
        lam₁ (I * J) = lam₁ I * lam₁ J)
    (hone₁ : lam₁ 1 = 1)
    (hval₁ : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        lam₁ I = 1 ∨ lam₁ I = -1 ∨ lam₁ I = 0)
    (hmul₂ : ∀ I J : Ideal (NumberField.RingOfIntegers K),
        lam₂ (I * J) = lam₂ I * lam₂ J)
    (hone₂ : lam₂ 1 = 1)
    (hval₂ : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        lam₂ I = 1 ∨ lam₂ I = -1 ∨ lam₂ I = 0) :
    ∃ aa : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ I, 0 ≤ aa I) ∧ aa 1 = 1 ∧
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        ((aa I : ℂ) =
          ∑' p : {p : Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) //
                   p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I},
            lam₁ p.val.2.1 * lam₂ p.val.2.2.1 *
              (lam₁ p.val.2.2.2 * lam₂ p.val.2.2.2))) :=
by
  classical
  obtain ⟨S, hS⟩ : ∃ S : Ideal (NumberField.RingOfIntegers K) → ℂ, ∀ M,
      S M = ∑' p : {p : Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) //
                   p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = M},
            lam₁ p.val.2.1 * lam₂ p.val.2.2.1 *
              (lam₁ p.val.2.2.2 * lam₂ p.val.2.2.2) := ⟨_, fun _ => rfl⟩
  
  have hdvd : ∀ M a b c d : Ideal (NumberField.RingOfIntegers K),
      a * b * c * d = M → a ∣ M ∧ b ∣ M ∧ c ∣ M ∧ d ∣ M := by
    intro M a b c d h
    exact ⟨⟨b * c * d, by rw [← h]; ring⟩, ⟨a * c * d, by rw [← h]; ring⟩,
      ⟨a * b * d, by rw [← h]; ring⟩, ⟨a * b * c, by rw [← h]; ring⟩⟩
  have hnz : ∀ M a b c d : Ideal (NumberField.RingOfIntegers K),
      a * b * c * d = M → M ≠ 0 → a ≠ 0 ∧ b ≠ 0 ∧ c ≠ 0 ∧ d ≠ 0 := by
    intro M a b c d h hM
    refine ⟨?_, ?_, ?_, ?_⟩ <;> (rintro rfl; apply hM; rw [← h]; simp)
  
  have hfin : ∀ M : Ideal (NumberField.RingOfIntegers K), M ≠ 0 →
      {p : Ideal (NumberField.RingOfIntegers K) ×
           Ideal (NumberField.RingOfIntegers K) ×
           Ideal (NumberField.RingOfIntegers K) ×
           Ideal (NumberField.RingOfIntegers K) |
         p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = M}.Finite := by
    intro M hM
    have hD : {J : Ideal (NumberField.RingOfIntegers K) | J ∣ M}.Finite := by
      have hft : Fintype {x : Ideal (NumberField.RingOfIntegers K) // x ∣ M} :=
        UniqueFactorizationMonoid.fintypeSubtypeDvd M hM
      have hfi : Finite {x : Ideal (NumberField.RingOfIntegers K) // x ∣ M} :=
        @Finite.of_fintype _ hft
      exact Set.finite_coe_iff.mp hfi
    refine Set.Finite.subset (hD.prod (hD.prod (hD.prod hD))) ?_
    rintro ⟨a, b, c, d⟩ hp
    simp only [Set.mem_setOf_eq] at hp
    obtain ⟨h1, h2, h3, h4⟩ := hdvd M a b c d hp
    exact ⟨h1, h2, h3, h4⟩
  
  have hconv : ∀ I J : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → J ≠ 0 →
      IsRelPrime I J → S (I * J) = S I * S J := by
    intro I J hI hJ hco
    have hIJ : I * J ≠ 0 := mul_ne_zero hI hJ
    have hpair : ∀ a a' b b' : Ideal (NumberField.RingOfIntegers K),
        a ∣ I → a' ∣ I → b ∣ J → b' ∣ J → a * b = a' * b' → a = a' ∧ b = b' := by
      intro a a' b b' ha ha' hb hb' h
      have ha0 : a ≠ 0 := by
        rintro rfl
        exact hI (zero_dvd_iff.mp ha)
      have h1 : a ∣ a' :=
        IsRelPrime.dvd_of_dvd_mul_right ((hco.of_dvd_left ha).of_dvd_right hb')
          (by rw [← h]; exact dvd_mul_right a b)
      have h2 : a' ∣ a :=
        IsRelPrime.dvd_of_dvd_mul_right ((hco.of_dvd_left ha').of_dvd_right hb)
          (by rw [h]; exact dvd_mul_right a' b')
      have haa : a = a' := dvd_antisymm h1 h2
      refine ⟨haa, ?_⟩
      subst haa
      exact mul_left_cancel₀ ha0 h
    have hsplit : ∀ r₁ r₂ r₃ r₄ : Ideal (NumberField.RingOfIntegers K),
        r₁ * r₂ * r₃ * r₄ = I * J →
        ∃ a₁ a₂ a₃ a₄ b₁ b₂ b₃ b₄ : Ideal (NumberField.RingOfIntegers K),
          a₁ * a₂ * a₃ * a₄ = I ∧ b₁ * b₂ * b₃ * b₄ = J ∧
            r₁ = a₁ * b₁ ∧ r₂ = a₂ * b₂ ∧ r₃ = a₃ * b₃ ∧ r₄ = a₄ * b₄ := by
      intro r₁ r₂ r₃ r₄ hr
      obtain ⟨c₁, c₂, c₃, c₄⟩ := hdvd (I * J) r₁ r₂ r₃ r₄ hr
      obtain ⟨a₁, b₁, ha₁, hb₁, he₁⟩ := exists_dvd_and_dvd_of_dvd_mul c₁
      obtain ⟨a₂, b₂, ha₂, hb₂, he₂⟩ := exists_dvd_and_dvd_of_dvd_mul c₂
      obtain ⟨a₃, b₃, ha₃, hb₃, he₃⟩ := exists_dvd_and_dvd_of_dvd_mul c₃
      obtain ⟨a₄, b₄, ha₄, hb₄, he₄⟩ := exists_dvd_and_dvd_of_dvd_mul c₄
      have hAB : a₁ * a₂ * a₃ * a₄ * (b₁ * b₂ * b₃ * b₄) = I * J := by
        rw [← hr, he₁, he₂, he₃, he₄]; ring
      have hrelA : IsRelPrime (a₁ * a₂ * a₃ * a₄) J :=
        (((hco.of_dvd_left ha₁).mul_left (hco.of_dvd_left ha₂)).mul_left
          (hco.of_dvd_left ha₃)).mul_left (hco.of_dvd_left ha₄)
      have hrelB : IsRelPrime (b₁ * b₂ * b₃ * b₄) I :=
        (((hco.symm.of_dvd_left hb₁).mul_left (hco.symm.of_dvd_left hb₂)).mul_left
          (hco.symm.of_dvd_left hb₃)).mul_left (hco.symm.of_dvd_left hb₄)
      have hAI : a₁ * a₂ * a₃ * a₄ ∣ I :=
        hrelA.dvd_of_dvd_mul_right ⟨b₁ * b₂ * b₃ * b₄, hAB.symm⟩
      have hBJ : b₁ * b₂ * b₃ * b₄ ∣ J :=
        hrelB.dvd_of_dvd_mul_left ⟨a₁ * a₂ * a₃ * a₄, by rw [← hAB]; ring⟩
      obtain ⟨s, hs⟩ := hAI
      obtain ⟨t, ht⟩ := hBJ
      have hcan : I * J * 1 = I * J * (s * t) := by
        rw [mul_one]
        calc I * J
            = a₁ * a₂ * a₃ * a₄ * s * (b₁ * b₂ * b₃ * b₄ * t) := by rw [← hs, ← ht]
          _ = a₁ * a₂ * a₃ * a₄ * (b₁ * b₂ * b₃ * b₄) * (s * t) := by ring
          _ = I * J * (s * t) := by rw [hAB]
      have hst : (1 : Ideal (NumberField.RingOfIntegers K)) = s * t :=
        mul_left_cancel₀ hIJ hcan
      have hs1 : s = 1 := by
        have hu : IsUnit s := isUnit_of_dvd_one ⟨t, hst⟩
        rw [Ideal.isUnit_iff] at hu
        rw [hu]
        exact Ideal.one_eq_top.symm
      have ht1 : t = 1 := by
        have hu : IsUnit t := isUnit_of_dvd_one ⟨s, by rw [hst]; ring⟩
        rw [Ideal.isUnit_iff] at hu
        rw [hu]
        exact Ideal.one_eq_top.symm
      rw [hs1, mul_one] at hs
      rw [ht1, mul_one] at ht
      exact ⟨a₁, a₂, a₃, a₄, b₁, b₂, b₃, b₄, hs.symm, ht.symm, he₁, he₂, he₃, he₄⟩
    haveI fI : Fintype {p : Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I} :=
      (hfin I hI).fintype
    haveI fJ : Fintype {p : Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = J} :=
      (hfin J hJ).fintype
    haveI fIJ : Fintype {p : Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I * J} :=
      (hfin (I * J) hIJ).fintype
    obtain ⟨W, hW⟩ : ∃ W : Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) → ℂ,
        ∀ x, W x = lam₁ x.2.1 * lam₂ x.2.2.1 * (lam₁ x.2.2.2 * lam₂ x.2.2.2) :=
      ⟨_, fun _ => rfl⟩
    have hEI : S I
        = ∑ p : {p : Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I},
            W p.val := by
      rw [hS, tsum_fintype]
      exact Finset.sum_congr rfl (fun p _ => (hW p.val).symm)
    have hEJ : S J
        = ∑ q : {p : Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = J},
            W q.val := by
      rw [hS, tsum_fintype]
      exact Finset.sum_congr rfl (fun p _ => (hW p.val).symm)
    have hEIJ : S (I * J)
        = ∑ r : {p : Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) //
              p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I * J},
            W r.val := by
      rw [hS, tsum_fintype]
      exact Finset.sum_congr rfl (fun p _ => (hW p.val).symm)
    have hmem : ∀ (p : {p : Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I})
        (q : {p : Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = J}),
        p.val.1 * q.val.1 * (p.val.2.1 * q.val.2.1) * (p.val.2.2.1 * q.val.2.2.1) *
            (p.val.2.2.2 * q.val.2.2.2) = I * J := by
      intro p q
      have hp : p.val.1 * p.val.2.1 * p.val.2.2.1 * p.val.2.2.2 = I := p.property
      have hq : q.val.1 * q.val.2.1 * q.val.2.2.1 * q.val.2.2.2 = J := q.property
      calc p.val.1 * q.val.1 * (p.val.2.1 * q.val.2.1) * (p.val.2.2.1 * q.val.2.2.1) *
              (p.val.2.2.2 * q.val.2.2.2)
          = p.val.1 * p.val.2.1 * p.val.2.2.1 * p.val.2.2.2 *
              (q.val.1 * q.val.2.1 * q.val.2.2.1 * q.val.2.2.2) := by ring
        _ = I * J := by rw [hp, hq]
    obtain ⟨Psi, hPsi⟩ : ∃ Psi : {p : Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I} ×
          {p : Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = J} →
          {p : Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
            Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I * J},
        ∀ pq, (Psi pq).val =
          (pq.1.val.1 * pq.2.val.1, pq.1.val.2.1 * pq.2.val.2.1,
            pq.1.val.2.2.1 * pq.2.val.2.2.1, pq.1.val.2.2.2 * pq.2.val.2.2.2) :=
      ⟨fun pq => ⟨(pq.1.val.1 * pq.2.val.1, pq.1.val.2.1 * pq.2.val.2.1,
          pq.1.val.2.2.1 * pq.2.val.2.2.1, pq.1.val.2.2.2 * pq.2.val.2.2.2),
          hmem pq.1 pq.2⟩, fun _ => rfl⟩
    have hdvdI : ∀ p : {p : Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = I},
        p.val.1 ∣ I ∧ p.val.2.1 ∣ I ∧ p.val.2.2.1 ∣ I ∧ p.val.2.2.2 ∣ I :=
      fun p => hdvd I p.val.1 p.val.2.1 p.val.2.2.1 p.val.2.2.2 p.property
    have hdvdJ : ∀ q : {p : Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) // p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = J},
        q.val.1 ∣ J ∧ q.val.2.1 ∣ J ∧ q.val.2.2.1 ∣ J ∧ q.val.2.2.2 ∣ J :=
      fun q => hdvd J q.val.1 q.val.2.1 q.val.2.2.1 q.val.2.2.2 q.property
    have hinj : Function.Injective Psi := by
      intro pq pq' hpq
      have h' : ((pq.1.val.1 * pq.2.val.1, pq.1.val.2.1 * pq.2.val.2.1,
            pq.1.val.2.2.1 * pq.2.val.2.2.1, pq.1.val.2.2.2 * pq.2.val.2.2.2) :
            Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K))
          = (pq'.1.val.1 * pq'.2.val.1, pq'.1.val.2.1 * pq'.2.val.2.1,
              pq'.1.val.2.2.1 * pq'.2.val.2.2.1, pq'.1.val.2.2.2 * pq'.2.val.2.2.2) := by
        rw [← hPsi pq, ← hPsi pq', hpq]
      obtain ⟨dp1, dp2, dp3, dp4⟩ := hdvdI pq.1
      obtain ⟨dp1', dp2', dp3', dp4'⟩ := hdvdI pq'.1
      obtain ⟨dq1, dq2, dq3, dq4⟩ := hdvdJ pq.2
      obtain ⟨dq1', dq2', dq3', dq4'⟩ := hdvdJ pq'.2
      obtain ⟨u1, v1⟩ := hpair _ _ _ _ dp1 dp1' dq1 dq1' (congrArg (fun z => z.1) h')
      obtain ⟨u2, v2⟩ := hpair _ _ _ _ dp2 dp2' dq2 dq2' (congrArg (fun z => z.2.1) h')
      obtain ⟨u3, v3⟩ := hpair _ _ _ _ dp3 dp3' dq3 dq3' (congrArg (fun z => z.2.2.1) h')
      obtain ⟨u4, v4⟩ := hpair _ _ _ _ dp4 dp4' dq4 dq4' (congrArg (fun z => z.2.2.2) h')
      exact Prod.ext (Subtype.ext (Prod.ext u1 (Prod.ext u2 (Prod.ext u3 u4))))
        (Subtype.ext (Prod.ext v1 (Prod.ext v2 (Prod.ext v3 v4))))
    have hsurj : Function.Surjective Psi := by
      intro r
      obtain ⟨a₁, a₂, a₃, a₄, b₁, b₂, b₃, b₄, hA, hB, g₁, g₂, g₃, g₄⟩ :=
        hsplit r.val.1 r.val.2.1 r.val.2.2.1 r.val.2.2.2 r.property
      refine ⟨(⟨(a₁, a₂, a₃, a₄), hA⟩, ⟨(b₁, b₂, b₃, b₄), hB⟩), Subtype.ext ?_⟩
      rw [hPsi]
      exact Prod.ext g₁.symm (Prod.ext g₂.symm (Prod.ext g₃.symm g₄.symm))
    have hbij : Function.Bijective Psi := ⟨hinj, hsurj⟩
    have hWmul : ∀ pq, W (Psi pq).val = W pq.1.val * W pq.2.val := by
      intro pq
      have l1 : W (Psi pq).val
          = lam₁ (pq.1.val.2.1 * pq.2.val.2.1) * lam₂ (pq.1.val.2.2.1 * pq.2.val.2.2.1) *
              (lam₁ (pq.1.val.2.2.2 * pq.2.val.2.2.2) *
                lam₂ (pq.1.val.2.2.2 * pq.2.val.2.2.2)) := by
        rw [hPsi]
        exact hW _
      rw [l1, hW pq.1.val, hW pq.2.val]
      simp only [hmul₁, hmul₂]
      ring
    rw [hEIJ, hEI, hEJ, ← Fintype.sum_bijective Psi hbij (fun pq => W (Psi pq).val)
      (fun r => W r.val) (fun _ => rfl), Fintype.sum_prod_type, Finset.sum_mul_sum]
    exact Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => hWmul (p, q)))
  
  have hprime : ∀ P : Ideal (NumberField.RingOfIntegers K), Prime P → ∀ e : ℕ,
      S (P ^ e) = ∑ k ∈ Finset.range (e + 1),
          (∑ i ∈ Finset.range (k + 1), lam₁ P ^ i) * lam₂ P ^ (e - k) *
            (∑ i ∈ Finset.range (e - k + 1), lam₁ P ^ i) := by
    intro P hP e
    have hP0 : P ≠ 0 := hP.ne_zero
    have hPe0 : P ^ e ≠ 0 := pow_ne_zero e hP0
    have hinj : Function.Injective (fun n : ℕ => P ^ n) :=
      pow_injective_of_not_isUnit hP.not_unit hP0
    have hcls : ∀ J : Ideal (NumberField.RingOfIntegers K), J ∣ P ^ e →
        ∃ i : ℕ, i ≤ e ∧ J = P ^ i := by
      intro J hJ
      obtain ⟨i, hi, hassoc⟩ := (dvd_prime_pow hP e).mp hJ
      exact ⟨i, hi, associated_iff_eq.mp hassoc⟩
    have hpow₁ : ∀ i : ℕ, lam₁ (P ^ i) = lam₁ P ^ i := by
      intro i
      induction i with
      | zero => rw [pow_zero, pow_zero, hone₁]
      | succ n ih => rw [pow_succ, hmul₁, ih, pow_succ]
    have hpow₂ : ∀ i : ℕ, lam₂ (P ^ i) = lam₂ P ^ i := by
      intro i
      induction i with
      | zero => rw [pow_zero, pow_zero, hone₂]
      | succ n ih => rw [pow_succ, hmul₂, ih, pow_succ]
    have hQfin := hfin (P ^ e) hPe0
    haveI hft : Fintype {p : Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) ×
          Ideal (NumberField.RingOfIntegers K) //
        p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = P ^ e} := hQfin.fintype
    have hbij : (∑ p : {p : Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) ×
                     Ideal (NumberField.RingOfIntegers K) //
                   p.1 * p.2.1 * p.2.2.1 * p.2.2.2 = P ^ e},
            lam₁ p.val.2.1 * lam₂ p.val.2.2.1 *
              (lam₁ p.val.2.2.2 * lam₂ p.val.2.2.2))
        = ∑ v ∈ (Finset.range (e + 1) ×ˢ Finset.range (e + 1) ×ˢ
              Finset.range (e + 1) ×ˢ Finset.range (e + 1)).filter
