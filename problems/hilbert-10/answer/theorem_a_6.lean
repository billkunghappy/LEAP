      rintro a ⟨ν, rfl⟩ c ⟨μ, rfl⟩ hG
      have hCU : KaiMFCongUnit K q ((ψ ν)⁻¹ * ψ μ) := (hGmem _).mp hG
      have hvK : ((((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) : K) * ((ν.1).1.1 : K) = ((μ.1).1.1 : K) := by
        rw [← hψ ν, ← hψ μ]
        have hu0 : (((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) *
            (ψ ν) : (NumberField.RingOfIntegers K)ˣ) = ψ μ :=
          (mul_comm ((ψ ν)⁻¹ * ψ μ) (ψ ν)).trans (mul_inv_cancel_left (ψ ν) (ψ μ))
        have hu : ((((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) : K) *
            (((ψ ν : NumberField.RingOfIntegers K)) : K)
            = (((ψ μ : NumberField.RingOfIntegers K)) : K) := by
          calc ((((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) :
                  NumberField.RingOfIntegers K) : K) *
                (((ψ ν : NumberField.RingOfIntegers K)) : K)
              = ((((((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) *
                  (ψ ν) : (NumberField.RingOfIntegers K)ˣ) :
                  NumberField.RingOfIntegers K)) : K) := by
                push_cast
                ring
            _ = (((ψ μ : NumberField.RingOfIntegers K)) : K) := by rw [hu0]
        rw [← mul_assoc, hu]
      have hkey : ∀ w : NumberField.InfinitePlace K,
          w (((μ.1).1.1 : K))
            = w (((((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) : K)) * w (((ν.1).1.1 : K)) := by
        intro w
        rw [← hvK, map_mul]
      have hshape := hRep1 (ν.1).1 (ν.1).2 (μ.1).1 (μ.1).2
        ((ψ ν)⁻¹ * ψ μ) hCU hkey
      have hxν0 : ((ν.1).1.1 : K) ≠ 0 := hRep0 (ν.1).1 (ν.1).2
      have hone : ∀ w : NumberField.InfinitePlace K,
