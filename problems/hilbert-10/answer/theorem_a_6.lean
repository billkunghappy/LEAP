    have hmaps : ∀ z ∈ X, Function.update z l 0 ∈ Finset.Icc lo hi := by
      intro z hz
      rw [hmemY]
      obtain ⟨hzB, -⟩ := (hmemX z).1 hz
      refine ⟨by simp, fun k hk => ?_⟩
      simp only [Function.update_apply, hk, if_false]
      exact (hbox z).1 hzB k
    rw [← Finset.sum_fiberwise_of_maps_to hmaps]
    refine (norm_sum_le _ _).trans ((Finset.sum_le_sum (g := fun _ => B) (fun y hy => ?_)).trans ?_)
    · obtain ⟨hyl, hyk⟩ := (hmemY y).1 hy
      obtain ⟨I, hI⟩ : ∃ I : Finset ℤ, I = (Finset.Icc (-(N : ℤ)) N).filter
          (fun t => (fun j => ((Function.update y l t j : ℤ) : ℝ)) ∈ Ω) := ⟨_, rfl⟩
      have hmemI : ∀ t, t ∈ I ↔ (-(N : ℤ) ≤ t ∧ t ≤ N) ∧
          (fun j => ((Function.update y l t j : ℤ) : ℝ)) ∈ Ω := by
        intro t; rw [hI, Finset.mem_filter, Finset.mem_Icc]
      have hfibsum : ‖∑ z ∈ X with Function.update z l 0 = y, f z‖
          = ‖∑ t ∈ I, f (Function.update y l t)‖ := by
        congr 1
        rw [← Finset.sum_image (fun t _ t' _ h => Function.update_injective y l h)]
        apply Finset.sum_congr _ (fun _ _ => rfl)
        ext z
        rw [Finset.mem_filter, Finset.mem_image]
        constructor
        · rintro ⟨hz, hzy⟩
          obtain ⟨hzB, hzΩ⟩ := (hmemX z).1 hz
