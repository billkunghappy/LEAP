theorem kai_lp_tb_char_orthogonality (K : Type u) [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0) :
    ∃ Ξ : Finset (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle),
      (1 : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) ∈ Ξ ∧
      Ξ.card = Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) ∧
      (∀ z : ((NumberField.RingOfIntegers K ⧸ q)ˣ), z ≠ 1 →
        (∑ ξ ∈ Ξ, (ξ z : ℂ)) = 0) ∧
      (∀ ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle, ξ ∈ Ξ) :=
by
  classical
  have hq' : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) := Ideal.finiteQuotientOfFreeOfNeBot q hq'
  haveI : Finite ((NumberField.RingOfIntegers K ⧸ q)ˣ) := inferInstance
  haveI : NeZero (Monoid.exponent ((NumberField.RingOfIntegers K ⧸ q)ˣ)) :=
    ⟨Monoid.exponent_ne_zero_of_finite⟩
  have e₁ : (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) ≃*
      (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circleˣ) :=
    MulEquiv.monoidHomCongrRight (toUnits : Circle ≃* Circleˣ)
  obtain ⟨e₂⟩ := CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity
    ((NumberField.RingOfIntegers K ⧸ q)ˣ) Circle
  have E := e₁.trans e₂
  haveI : Finite (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) :=
    Finite.of_equiv _ E.symm.toEquiv
  letI : Fintype (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) := Fintype.ofFinite _
  refine ⟨Finset.univ, Finset.mem_univ _, ?_, ?_, fun ξ => Finset.mem_univ _⟩
  · rw [Finset.card_univ, Fintype.card_eq_nat_card]
    exact Nat.card_congr E.toEquiv
  · intro z hz
    obtain ⟨φ, hφ⟩ := CommGroup.exists_apply_ne_one_of_hasEnoughRootsOfUnity
      ((NumberField.RingOfIntegers K ⧸ q)ˣ) Circle hz
    let f : (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) →* ℂ :=
      Circle.coeHom.comp (MonoidHom.eval z)
    have hf_apply : ∀ ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle,
        f ξ = ((ξ z : Circle) : ℂ) := fun ξ => rfl
    have hf : f ≠ 1 := by
      intro h
      apply hφ
      have h1 : f ((Units.coeHom Circle).comp φ) = 1 := by rw [h]; rfl
      rw [hf_apply] at h1
      have h2 : (((Units.coeHom Circle).comp φ) z : Circle) = 1 :=
        Circle.ext (by rw [h1, Circle.coe_one])
      exact Units.val_eq_one.mp h2
    have hsum := sum_hom_units_eq_zero f hf
    simpa only [hf_apply] using hsum

theorem kai_lp_tb_orbit_transversal (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e) :
    ∃ (M : ℕ) (v : Fin M → (NumberField.RingOfIntegers K)ˣ),
      0 < M ∧
      (M : ℝ) * NumberField.Units.regulator K
          = ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq ∧
      (∀ y : (NumberField.RingOfIntegers K)ˣ,
        ∃! p : Fin M × (Fin (NumberField.Units.rank K) → ℤ),
          y = v p.1 * ∏ j, (H j) ^ (p.2 j)) ∧
      ∀ (α : NumberField.RingOfIntegers K), IsUnit (Ideal.Quotient.mk q α) →
      ∀ (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (u γ : Fin (NumberField.Units.rank K) → ℝ), (∀ j, 0 < γ j ∧ γ j ≤ 1) →
      ∀ (vv ϑ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
        (∀ p, 0 < ϑ p ∧ ϑ p ≤ 1) →
      ∀ x : ℝ,
        (∑' π : {π : NumberField.RingOfIntegers K //
              KaiTBMem K q H e α sgn u γ vv ϑ x π},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
          = kaiLPGenTransSum K q H e α sgn (fun j => kaiLPBoxInd (u j) (γ j))
              (fun p => kaiLPBoxInd (vv p) (ϑ p)) M v x :=
by
  classical
  have hHc : ∀ j, KaiTBCongUnit K q (H j) := hdata.1
  have horth : ∀ i j, ∑ w : NumberField.InfinitePlace K,
      kaiTBUnitLog K (H i) w * e j w = if i = j then 1 else 0 := hdata.2.2.2.2.2.1
  
  have hgenfacts :
      (∀ P : Ideal (NumberField.RingOfIntegers K), Submodule.IsPrincipal P →
          Ideal.span {kaiGen P} = P) ∧
      (∀ π : NumberField.RingOfIntegers K, Prime π →
          (Ideal.span {π}).IsPrime ∧ Ideal.span {π} ≠ ⊥ ∧
            Submodule.IsPrincipal (Ideal.span {π}) ∧
            Ideal.absNorm (Ideal.span {π}) = (Algebra.norm ℤ π).natAbs) ∧
      (∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
          Submodule.IsPrincipal P →
            kaiGen P ≠ 0 ∧ Prime (kaiGen P) ∧
              (Algebra.norm ℤ (kaiGen P)).natAbs = Ideal.absNorm P) ∧
      (∀ (y : (NumberField.RingOfIntegers K)ˣ) (z : NumberField.RingOfIntegers K),
          (Algebra.norm ℤ ((y : NumberField.RingOfIntegers K) * z)).natAbs
            = (Algebra.norm ℤ z).natAbs) ∧
      (∀ (y : (NumberField.RingOfIntegers K)ˣ) (z : NumberField.RingOfIntegers K),
          Ideal.span {(y : NumberField.RingOfIntegers K) * z} = Ideal.span {z}) ∧
      (∀ a b : NumberField.RingOfIntegers K, Ideal.span {a} = Ideal.span {b} →
          ∃ y : (NumberField.RingOfIntegers K)ˣ,
            a = (y : NumberField.RingOfIntegers K) * b) := by
    have hA : ∀ P : Ideal (NumberField.RingOfIntegers K),
        Submodule.IsPrincipal P → Ideal.span {kaiGen P} = P := by
      intro P hP
      have hex : ∃ a : NumberField.RingOfIntegers K, P = Ideal.span {a} := hP.principal
      have hgen : kaiGen P = hex.choose := dif_pos hex
      rw [hgen]
      exact hex.choose_spec.symm
    refine ⟨hA, ?_, ?_, ?_, ?_, ?_⟩
    · intro π hπ
      refine ⟨(Ideal.span_singleton_prime hπ.ne_zero).mpr hπ, ?_, inferInstance,
        Ideal.absNorm_span_singleton π⟩
      exact fun h => hπ.ne_zero (Ideal.span_singleton_eq_bot.mp h)
    · intro P hPprime hPbot hPprin
      have hAP : Ideal.span {kaiGen P} = P := hA P hPprin
      have hg : kaiGen P ≠ 0 := fun h0 =>
        hPbot (hAP.symm.trans (Ideal.span_singleton_eq_bot.mpr h0))
      have hspan : (Ideal.span {kaiGen P}).IsPrime := by
        rw [hAP]; exact hPprime
      have hnorm : Ideal.absNorm (Ideal.span {kaiGen P}) = Ideal.absNorm P := by
        rw [hAP]
      exact ⟨hg, (Ideal.span_singleton_prime hg).mp hspan,
        (Ideal.absNorm_span_singleton (kaiGen P)).symm.trans hnorm⟩
    · intro y z
      have h1 : (Algebra.norm ℤ) ((y : NumberField.RingOfIntegers K) * z)
          = (Algebra.norm ℤ) (y : NumberField.RingOfIntegers K) * (Algebra.norm ℤ) z :=
        map_mul (Algebra.norm ℤ : NumberField.RingOfIntegers K →* ℤ)
          (y : NumberField.RingOfIntegers K) z
      have h2 : ((Algebra.norm ℤ) (y : NumberField.RingOfIntegers K)).natAbs = 1 :=
        Int.isUnit_iff_natAbs_eq.mp
          (IsUnit.map (Algebra.norm ℤ : NumberField.RingOfIntegers K →* ℤ)
            (Units.isUnit y))
      rw [h1, Int.natAbs_mul, h2, one_mul]
    · intro y z
      exact Ideal.span_singleton_mul_left_unit (Units.isUnit y) z
    · intro a b hab
      obtain ⟨u, hu⟩ := (Ideal.span_singleton_eq_span_singleton.mp hab).symm
      exact ⟨u, hu.symm.trans (mul_comm _ _)⟩
  
  have hcongAll : ∀ (α : NumberField.RingOfIntegers K)
      (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (m : Fin (NumberField.Units.rank K) → ℤ) (z : NumberField.RingOfIntegers K),
      kaiLPResSgn K q α sgn
          (((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) * z)
        = kaiLPResSgn K q α sgn z := by
    intro α sgn m z
    have hsmul : ∀ (x y : NumberField.RingOfIntegers K)
        (w : {w : NumberField.InfinitePlace K // w.IsReal}),
        (NumberField.mixedEmbedding K ((x * y : NumberField.RingOfIntegers K) : K)).1 w
          = (NumberField.mixedEmbedding K ((x : NumberField.RingOfIntegers K) : K)).1 w
            * (NumberField.mixedEmbedding K ((y : NumberField.RingOfIntegers K) : K)).1 w := by
      intro x y w
      rw [show ((x * y : NumberField.RingOfIntegers K) : K)
          = ((x : NumberField.RingOfIntegers K) : K) * ((y : NumberField.RingOfIntegers K) : K)
          from map_mul (algebraMap (NumberField.RingOfIntegers K) K) x y]
      simp only [map_mul, Prod.fst_mul, Pi.mul_apply]
    have hsone : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (NumberField.mixedEmbedding K ((1 : NumberField.RingOfIntegers K) : K)).1 w = 1 := by
      intro w
      rw [show ((1 : NumberField.RingOfIntegers K) : K) = 1
        from map_one (algebraMap (NumberField.RingOfIntegers K) K)]
      simp only [map_one, Prod.fst_one, Pi.one_apply]
    have hone : KaiTBCongUnit K q (1 : (NumberField.RingOfIntegers K)ˣ) := by
      refine ⟨?_, ?_⟩
      · rw [Units.val_one, sub_self]
        exact Ideal.zero_mem q
      · intro w
        rw [Units.val_one, hsone w]
        exact one_pos
    have hmulc : ∀ U V : (NumberField.RingOfIntegers K)ˣ,
        KaiTBCongUnit K q U → KaiTBCongUnit K q V → KaiTBCongUnit K q (U * V) := by
      intro U V hU hV
      obtain ⟨hU1, hUp⟩ := hU
      obtain ⟨hV1, hVp⟩ := hV
      refine ⟨?_, ?_⟩
      · have hid : ((U * V : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1
            = (U : NumberField.RingOfIntegers K) * ((V : NumberField.RingOfIntegers K) - 1)
              + ((U : NumberField.RingOfIntegers K) - 1) := by
          rw [Units.val_mul]; ring
        rw [hid]
        exact Ideal.add_mem q (Ideal.mul_mem_left q _ hV1) hU1
      · intro w
        rw [Units.val_mul, hsmul]
        exact mul_pos (hUp w) (hVp w)
    have hinvc : ∀ U : (NumberField.RingOfIntegers K)ˣ,
        KaiTBCongUnit K q U → KaiTBCongUnit K q U⁻¹ := by
      intro U hU
      obtain ⟨hU1, hUp⟩ := hU
      have hab : ((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
          * ((U : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) = 1 :=
        Units.inv_mul U
      refine ⟨?_, ?_⟩
      · have hid : ((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1
            = (-((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K))
              * (((U : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1) := by
          calc ((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1
              = ((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
                - ((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
                  * ((U : (NumberField.RingOfIntegers K)ˣ) :
                      NumberField.RingOfIntegers K) := by rw [hab]
            _ = (-((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K))
                  * (((U : (NumberField.RingOfIntegers K)ˣ) :
                      NumberField.RingOfIntegers K) - 1) := by ring
        rw [hid]
        exact Ideal.mul_mem_left q _ hU1
      · intro w
        have hp : (NumberField.mixedEmbedding K
              (((U⁻¹ : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) : K)).1 w
            * (NumberField.mixedEmbedding K
              (((U : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) : K)).1 w = 1 := by
          rw [← hsmul, hab, hsone]
        rw [eq_inv_of_mul_eq_one_left hp]
        exact inv_pos.mpr (hUp w)
    obtain ⟨G, hG⟩ : ∃ G : Subgroup (NumberField.RingOfIntegers K)ˣ,
        ∀ U : (NumberField.RingOfIntegers K)ˣ, U ∈ G ↔ KaiTBCongUnit K q U :=
      ⟨{ carrier := {U : (NumberField.RingOfIntegers K)ˣ | KaiTBCongUnit K q U}
         mul_mem' := fun {a b} ha hb => hmulc a b ha hb
         one_mem' := hone
         inv_mem' := fun {a} ha => hinvc a ha }, fun U => Iff.rfl⟩
    obtain ⟨hU1, hUp⟩ : KaiTBCongUnit K q (∏ j, (H j) ^ (m j)) :=
      (hG _).mp (G.prod_mem (fun j _ => G.zpow_mem ((hG (H j)).mpr (hHc j)) (m j)))
    have hmem : z * (((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
        NumberField.RingOfIntegers K) - 1) ∈ q := Ideal.mul_mem_left q z hU1
    have hres : ((((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
          NumberField.RingOfIntegers K) * z - α ∈ q)) ↔ (z - α ∈ q) := by
      constructor
      · intro h
        have e' : z - α = (((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) * z - α)
            - z * (((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) - 1) := by ring
        rw [e']
        exact Ideal.sub_mem q h hmem
      · intro h
        have e' : ((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) * z - α
            = (z - α) + z * (((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) - 1) := by ring
        rw [e']
        exact Ideal.add_mem q h hmem
    have hsgn : (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if sgn w then 0 < (NumberField.mixedEmbedding K
              (((((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) * z : NumberField.RingOfIntegers K) : K))).1 w
          else (NumberField.mixedEmbedding K
              (((((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) * z : NumberField.RingOfIntegers K) : K))).1 w < 0)
        ↔ (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if sgn w then 0 < (NumberField.mixedEmbedding K ((z : K))).1 w
          else (NumberField.mixedEmbedding K ((z : K))).1 w < 0) := by
      refine forall_congr' (fun w => ?_)
      rw [hsmul]
      by_cases hsw : sgn w = true
      · rw [if_pos hsw, if_pos hsw]
        exact mul_pos_iff_of_pos_left (hUp w)
      · rw [if_neg hsw, if_neg hsw]
        constructor
        · intro h
          by_contra hcon
          push_neg at hcon
          exact absurd h (not_lt.mpr (mul_nonneg (hUp w).le hcon))
        · intro h
          exact mul_neg_of_pos_of_neg (hUp w) h
    have hiff := and_congr hres hsgn
    by_cases hc : (z - α ∈ q ∧
        ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if sgn w then 0 < (NumberField.mixedEmbedding K ((z : K))).1 w
          else (NumberField.mixedEmbedding K ((z : K))).1 w < 0)
    · have h1 : kaiLPResSgn K q α sgn z = 1 := if_pos hc
      have h2 : kaiLPResSgn K q α sgn
          (((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) * z) = 1 := if_pos (hiff.mpr hc)
      rw [h1, h2]
    · have h1 : kaiLPResSgn K q α sgn z = 0 := if_neg hc
      have h2 : kaiLPResSgn K q α sgn
          (((∏ j, (H j) ^ (m j) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) * z) = 0 := if_neg (fun h => hc (hiff.mp h))
      rw [h1, h2]
  
  have hshift : ∀ (m : Fin (NumberField.Units.rank K) → ℤ)
      (z : NumberField.RingOfIntegers K), z ≠ 0 →
      (∀ j, kaiTBPair K (e j)
            (((((∏ i, (H i) ^ (m i) : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) * z) : NumberField.RingOfIntegers K) : K)
          = kaiTBPair K (e j) ((z : NumberField.RingOfIntegers K) : K) + (m j : ℝ)) ∧
      (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ∃ N : ℤ,
          kaiTBTheta K H e p
              (((((∏ i, (H i) ^ (m i) : (NumberField.RingOfIntegers K)ˣ) :
                  NumberField.RingOfIntegers K) * z) : NumberField.RingOfIntegers K) : K)
            = kaiTBTheta K H e p ((z : NumberField.RingOfIntegers K) : K) + (N : ℝ)) := by
    intro m z hz
    have hpdef : ∀ (f : NumberField.InfinitePlace K → ℝ) (s : K),
        kaiTBPair K f s
          = ∑ w : NumberField.InfinitePlace K, f w * ((w.mult : ℝ) * Real.log (w s)) :=
      fun _ _ => rfl
    have huldef : ∀ (u : (NumberField.RingOfIntegers K)ˣ) (w : NumberField.InfinitePlace K),
        kaiTBUnitLog K u w
          = (w.mult : ℝ) * Real.log (w (((u : NumberField.RingOfIntegers K)) : K)) :=
      fun _ _ => rfl
    have hxne : ∀ i, ((H i : NumberField.RingOfIntegers K) : K) ≠ 0 :=
      fun i => NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero (H i))
    have hZne : ((z : NumberField.RingOfIntegers K) : K) ≠ 0 :=
      NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hz
    have hcoe : (((∏ i, (H i) ^ (m i) : (NumberField.RingOfIntegers K)ˣ) :
          NumberField.RingOfIntegers K) : K)
        = ∏ i, ((H i : NumberField.RingOfIntegers K) : K) ^ (m i) := by
      have hΨ : ∀ u : (NumberField.RingOfIntegers K)ˣ,
          ((Units.coeHom K).comp
              (Units.map (algebraMap (NumberField.RingOfIntegers K) K).toMonoidHom) u)
            = ((u : NumberField.RingOfIntegers K) : K) := fun _ => rfl
      calc (((∏ i, (H i) ^ (m i) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) : K)
          = ((Units.coeHom K).comp
              (Units.map (algebraMap (NumberField.RingOfIntegers K) K).toMonoidHom))
                (∏ i, (H i) ^ (m i)) := (hΨ _).symm
        _ = ∏ i, ((Units.coeHom K).comp
              (Units.map (algebraMap (NumberField.RingOfIntegers K) K).toMonoidHom))
                ((H i) ^ (m i)) := map_prod _ _ _
        _ = ∏ i, (((Units.coeHom K).comp
              (Units.map (algebraMap (NumberField.RingOfIntegers K) K).toMonoidHom))
                (H i)) ^ (m i) := Finset.prod_congr rfl (fun i _ => map_zpow _ _ _)
        _ = ∏ i, ((H i : NumberField.RingOfIntegers K) : K) ^ (m i) :=
              Finset.prod_congr rfl (fun i _ => by rw [hΨ])
    have hC : ((((∏ i, (H i) ^ (m i) : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) * z : NumberField.RingOfIntegers K) : K)
        = (∏ i, ((H i : NumberField.RingOfIntegers K) : K) ^ (m i))
            * ((z : NumberField.RingOfIntegers K) : K) := by
      have hmul : ∀ a b : NumberField.RingOfIntegers K,
          ((a * b : NumberField.RingOfIntegers K) : K)
            = ((a : NumberField.RingOfIntegers K) : K) * ((b : NumberField.RingOfIntegers K) : K) :=
        fun a b => algebraMap.coe_mul a b
      rw [hmul, hcoe]
    have hpairprod : ∀ (f : NumberField.InfinitePlace K → ℝ) (t : K), t ≠ 0 →
        kaiTBPair K f ((∏ i, ((H i : NumberField.RingOfIntegers K) : K) ^ (m i)) * t)
          = (∑ i, (m i : ℝ) * kaiTBPair K f ((H i : NumberField.RingOfIntegers K) : K))
              + kaiTBPair K f t := by
      intro f t ht
      have hwx : ∀ (w : NumberField.InfinitePlace K) (i : Fin (NumberField.Units.rank K)),
          w ((H i : NumberField.RingOfIntegers K) : K) ≠ 0 :=
        fun w i => (map_ne_zero w).mpr (hxne i)
      have hwt : ∀ w : NumberField.InfinitePlace K, w t ≠ 0 :=
        fun w => (map_ne_zero w).mpr ht
      have hlog : ∀ w : NumberField.InfinitePlace K,
          Real.log (w ((∏ i, ((H i : NumberField.RingOfIntegers K) : K) ^ (m i)) * t))
            = (∑ i, (m i : ℝ) * Real.log (w ((H i : NumberField.RingOfIntegers K) : K)))
                + Real.log (w t) := by
        intro w
        have hwp : w (∏ i, ((H i : NumberField.RingOfIntegers K) : K) ^ (m i))
            = ∏ i, (w ((H i : NumberField.RingOfIntegers K) : K)) ^ (m i) := by
          rw [map_prod]
          exact Finset.prod_congr rfl (fun i _ => map_zpow₀ w _ _)
        have hwp0 : w (∏ i, ((H i : NumberField.RingOfIntegers K) : K) ^ (m i)) ≠ 0 := by
          rw [hwp]
          exact Finset.prod_ne_zero_iff.mpr (fun i _ => zpow_ne_zero (m i) (hwx w i))
        rw [map_mul, Real.log_mul hwp0 (hwt w), hwp,
          Real.log_prod (fun i _ => zpow_ne_zero (m i) (hwx w i))]
        congr 1
