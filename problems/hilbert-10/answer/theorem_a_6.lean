    · rw [Finset.card_image_of_injOn hinj]; exact hFcard
    · intro t ht
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ht
      obtain ⟨m, hm⟩ := hnear b (hFsub hb)
      refine ⟨m, ?_⟩
      have hterm : ∀ i, ((b i : ℤ) : ℝ) * β i = ((c i : ℤ) : ℝ) * β i
          + (if i = j then ((b j : ℤ) : ℝ) * β j else 0) := by
        intro i
        rw [← hFprop b hb]
        by_cases h : i = j
        · subst h; simp
        · simp [h]
      have hsum : ∑ i, ((b i : ℤ) : ℝ) * β i
          = ∑ i, ((c i : ℤ) : ℝ) * β i + ((b j : ℤ) : ℝ) * β j := by
        rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_add_distrib]
        simp
      show |∑ i, ((c i : ℤ) : ℝ) * β i + ((b j : ℤ) : ℝ) * β j - m| ≤ ε
      rw [← hsum]; exact hm
  
  intro ν R η ε β S hη0 hη1 hR hε0 hε1 hS hcard hnear
  have hη2 : 0 < η ^ 2 := by positivity
  have hκ : 6 ≤ η ^ 2 * R := by rw [div_le_iff₀ hη2] at hR; linarith
  have hR0 : 0 < R := by nlinarith
  have hP1 : 1 ≤ 2 / η := by rw [le_div_iff₀ hη0]; linarith
  have hδ : 0 ≤ 4 * ε / (η ^ 2 * R) := by positivity
  have hstep : ∀ j : Fin ν, ∃ q₁ : ℕ, 1 ≤ q₁ ∧ (q₁ : ℝ) ≤ 2 / η ∧
      ∃ m : ℤ, |(q₁ : ℝ) * β j - m| ≤ 4 * ε / (η ^ 2 * R) := by
    intro j
    obtain ⟨a, T, hT, hTcard, hTnear⟩ := lv_line_fibre ν j R η ε β S hη0 hR0.le hS hcard hnear
    obtain ⟨q₁, hq₁1, hq₁P, m₀, hm₀⟩ :=
      lv_small_gap R η ε a (β j) T hη0 hη1 hR hT hTcard hTnear
    have hTne : T.Nonempty := by
      have h1 : (0:ℝ) < η * (2 * R + 1) := by positivity
      have : (0:ℝ) < T.card := lt_of_lt_of_le h1 hTcard
      exact Finset.card_pos.mp (by exact_mod_cast this)
    obtain ⟨c, A, D, U, hTU, hsub, hA, hAD, hspread, hUnear⟩ :=
      lv_progression R ε a (β j) T q₁ m₀ hq₁1 hTne hT hTnear
    have hq₁r : (1:ℝ) ≤ q₁ := by exact_mod_cast hq₁1
    have hN0 : (0:ℝ) ≤ U.card := Nat.cast_nonneg _
    have hN1 : η ^ 2 * (2 * R + 1) / 2 ≤ (U.card : ℝ) := by
      have h1 : (q₁:ℝ) * U.card ≤ (2 / η) * U.card := mul_le_mul_of_nonneg_right hq₁P hN0
      have h2 : η * (2 * R + 1) ≤ (2 / η) * U.card := by linarith
      have h3 : η * (η * (2 * R + 1)) ≤ η * ((2 / η) * U.card) :=
        mul_le_mul_of_nonneg_left h2 hη0.le
      have h4 : η * ((2 / η) * U.card) = 2 * U.card := by field_simp
      nlinarith
    have hN2 : (U.card : ℝ) ≤ (D : ℝ) + 1 := by
      have h1 := Finset.card_le_card hsub
      rw [Int.card_Icc] at h1
      have e : A + (D:ℤ) + 1 - A = ((D + 1 : ℕ) : ℤ) := by push_cast; ring
      rw [e, Int.toNat_natCast] at h1
      exact_mod_cast h1
    have hD : (D : ℝ) ≤ 2 * R := by
      have := mul_le_mul_of_nonneg_right hq₁r (Nat.cast_nonneg D : (0:ℝ) ≤ D)
      linarith
    obtain ⟨γ, hγdef⟩ : ∃ γ : ℝ, γ = (q₁ : ℝ) * β j - (m₀ : ℝ) := ⟨_, rfl⟩
    rw [← hγdef] at hUnear hm₀
    have hDγ : ∃ z : ℤ, |(D:ℝ) * γ - z| ≤ 2 * ε := by
      obtain ⟨mA, hmA⟩ := hUnear A hA
      obtain ⟨mB, hmB⟩ := hUnear (A + D) hAD
      refine ⟨mB - mA, ?_⟩
      have : (D:ℝ) * γ - ((mB - mA : ℤ) : ℝ)
          = (c + ((A + D : ℤ) : ℝ) * γ - mB) - (c + (A:ℝ) * γ - mA) := by push_cast; ring
      rw [this]
      rw [abs_le] at hmA hmB ⊢
      constructor <;> linarith
    have hcount : γ ≠ 0 → (U.card : ℝ) ≤ ((D:ℝ) * |γ| + 2 * ε + 1) * (2 * ε / |γ| + 1) :=
      fun h => lv_count γ c ε A D U h hε0 hsub hUnear
    have hfin := lv_dichotomy η R ε γ D U.card hη0 hη1 hR hε0 hε1 hm₀ hN1 hN2 hD hDγ hcount
    rw [hγdef] at hfin
    exact ⟨q₁, hq₁1, hq₁P, m₀, hfin⟩
  choose q hq1 hqP hqβ using hstep
  obtain ⟨h1, h2, h3⟩ := lv_common_denom ν (2 / η) (4 * ε / (η ^ 2 * R)) q β hP1 hδ hq1 hqP hqβ
  exact ⟨∏ j, q j, h1, h2, h3⟩

theorem kai_v_ext_vinogradov_core (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C₆ : ℝ, 1 ≤ C₆ ∧ ∀ (w : Fin (Module.finrank ℚ K) → ℝ)
      (S : Finset (NumberField.RingOfIntegers K)) (R η ε : ℝ), 0 < η → η ≤ 1 →
      6 / η ^ 2 ≤ R → 0 ≤ ε → ε ≤ η ^ 2 / 200 → (∀ b ∈ S, basisSupNorm ω b ≤ R) →
      η * (2 * R + 1) ^ Module.finrank ℚ K ≤ (S.card : ℝ) →
      (∀ b ∈ S, ∀ i : Fin (Module.finrank ℚ K), ∃ z : ℤ,
        |∑ l, ((ω.repr (b * ω i) l : ℤ) : ℝ) * w l - z| ≤ ε) →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (2 / η) ^ (Module.finrank ℚ K ^ 2) ∧
        ∀ l : Fin (Module.finrank ℚ K), ∃ z : ℤ,
          |(q : ℝ) * w l - z| ≤ C₆ * (2 / η) ^ (Module.finrank ℚ K ^ 2 + Module.finrank ℚ K)
            * (4 * ε / (η ^ 2 * R)) :=
by
  classical
  
  have hbil : ∀ (w : Fin (Module.finrank ℚ K) → ℝ) (x y : NumberField.RingOfIntegers K),
      ∑ l, ((ω.repr (x * y) l : ℤ) : ℝ) * w l
        = ∑ j, ((ω.repr x j : ℤ) : ℝ) * ∑ l, ((ω.repr (ω j * y) l : ℤ) : ℝ) * w l := by
    intro w x y
    have hx : x * y = ∑ j, (ω.repr x j) • (ω j * y) := by
      conv_lhs => rw [← ω.sum_repr x]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [smul_mul_assoc]
    have hrepr : ∀ l, ω.repr (x * y) l = ∑ j, ω.repr x j * ω.repr (ω j * y) l := by
      intro l
      rw [hx, map_sum, Finsupp.finset_sum_apply]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_zsmul, Finsupp.smul_apply, smul_eq_mul]
    simp_rw [hrepr]
    push_cast
    simp_rw [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l _ => by ring))
  
  have hself : ∀ (w : Fin (Module.finrank ℚ K) → ℝ) (l : Fin (Module.finrank ℚ K)),
      ∑ l', ((ω.repr (ω l) l' : ℤ) : ℝ) * w l' = w l := by
    intro w l
    rw [Module.Basis.repr_self]
    simp [Finsupp.single_apply]
  
  have hcoord : ∀ (b : NumberField.RingOfIntegers K) (j : Fin (Module.finrank ℚ K)),
      |((ω.repr b j : ℤ) : ℝ)| ≤ basisSupNorm ω b := by
    intro b j
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr b j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  have hinj : Function.Injective
      (fun b : NumberField.RingOfIntegers K => fun j : Fin (Module.finrank ℚ K) => ω.repr b j) := by
    intro b b' h
    exact ω.ext_elem (fun j => congrFun h j)
  
  refine ⟨1 + ∑ j, |((ω.repr 1 j : ℤ) : ℝ)|,
    by have := Finset.sum_nonneg (fun j (_ : j ∈ (Finset.univ : Finset (Fin (Module.finrank ℚ K))))
        => abs_nonneg ((ω.repr 1 j : ℤ) : ℝ)); linarith, ?_⟩
  intro w S R η ε hη0 hη1 hR hε0 hε1 hSR hdens hnear
  
  have hRpos : 0 < R := lt_of_lt_of_le (by positivity) hR
  have h2η : 2 ≤ 2 / η := by rw [le_div_iff₀ hη0]; linarith
  have hP1 : 1 ≤ (2 / η) ^ Module.finrank ℚ K := one_le_pow₀ (by linarith)
  have hδ0 : 0 ≤ (2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R)) := by positivity
  
  have hstep : ∀ i : Fin (Module.finrank ℚ K), ∃ q : ℕ, 1 ≤ q ∧
      (q : ℝ) ≤ (2 / η) ^ Module.finrank ℚ K ∧ ∀ j, ∃ m : ℤ,
        |(q : ℝ) * (∑ l, ((ω.repr (ω j * ω i) l : ℤ) : ℝ) * w l) - m|
          ≤ (2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R)) := by
    intro i
    refine kai_v_linear_vinogradov (Module.finrank ℚ K) R η ε
      (fun j => ∑ l, ((ω.repr (ω j * ω i) l : ℤ) : ℝ) * w l)
      (S.image (fun b : NumberField.RingOfIntegers K =>
        fun j : Fin (Module.finrank ℚ K) => ω.repr b j))
      hη0 hη1 hR hε0 hε1 ?_ ?_ ?_
    · intro b' hb' j
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hb'
      exact (hcoord b j).trans (hSR b hb)
    · rw [Finset.card_image_of_injective _ hinj]
      exact hdens
    · intro b' hb'
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hb'
      obtain ⟨z, hz⟩ := hnear b hb i
      refine ⟨z, ?_⟩
      rw [hbil w b (ω i)] at hz
      exact hz
  choose q hq1 hqP hqβ using hstep
  
  have hQpos : 0 < ∏ i, q i := Finset.prod_pos (fun i _ => hq1 i)
  have hqR : ∀ i, (1 : ℝ) ≤ (q i : ℝ) := fun i => by exact_mod_cast hq1 i
  have hQle : ((∏ i, q i : ℕ) : ℝ) ≤ (2 / η) ^ (Module.finrank ℚ K ^ 2) := by
    rw [Nat.cast_prod]
    calc ∏ i, (q i : ℝ) ≤ ∏ _i : Fin (Module.finrank ℚ K), (2 / η) ^ Module.finrank ℚ K :=
          Finset.prod_le_prod (fun i _ => by have := hqR i; linarith) (fun i _ => hqP i)
      _ = (2 / η) ^ (Module.finrank ℚ K ^ 2) := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← pow_mul, sq]
  have hcommon : ∀ i j, ∃ m : ℤ,
      |((∏ i, q i : ℕ) : ℝ) * (∑ l, ((ω.repr (ω j * ω i) l : ℤ) : ℝ) * w l) - m|
        ≤ (2 / η) ^ (Module.finrank ℚ K ^ 2)
          * ((2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R))) := by
    intro i j
    obtain ⟨z, hz⟩ := hqβ i j
    have hsplit : ∏ k, q k = q i * ∏ k ∈ Finset.univ.erase i, q k :=
      (Finset.mul_prod_erase Finset.univ q (Finset.mem_univ i)).symm
    have hQi1 : (1 : ℝ) ≤ ((∏ k ∈ Finset.univ.erase i, q k : ℕ) : ℝ) := by
      have : 0 < ∏ k ∈ Finset.univ.erase i, q k := Finset.prod_pos (fun k _ => hq1 k)
      exact_mod_cast this
    have hQiQ : ((∏ k ∈ Finset.univ.erase i, q k : ℕ) : ℝ) ≤ ((∏ k, q k : ℕ) : ℝ) := by
      rw [hsplit, Nat.cast_mul]
      have := hqR i
      nlinarith
    refine ⟨((∏ k ∈ Finset.univ.erase i, q k : ℕ) : ℤ) * z, ?_⟩
    have heq : ((∏ k, q k : ℕ) : ℝ) * (∑ l, ((ω.repr (ω j * ω i) l : ℤ) : ℝ) * w l)
        - ((((∏ k ∈ Finset.univ.erase i, q k : ℕ) : ℤ) * z : ℤ) : ℝ)
        = ((∏ k ∈ Finset.univ.erase i, q k : ℕ) : ℝ)
          * ((q i : ℝ) * (∑ l, ((ω.repr (ω j * ω i) l : ℤ) : ℝ) * w l) - z) := by
      rw [hsplit]; push_cast; ring
    rw [heq, abs_mul, abs_of_nonneg (by linarith)]
    calc ((∏ k ∈ Finset.univ.erase i, q k : ℕ) : ℝ)
          * |(q i : ℝ) * (∑ l, ((ω.repr (ω j * ω i) l : ℤ) : ℝ) * w l) - z|
        ≤ ((∏ k ∈ Finset.univ.erase i, q k : ℕ) : ℝ)
          * ((2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R))) :=
          mul_le_mul_of_nonneg_left hz (by linarith)
      _ ≤ (2 / η) ^ (Module.finrank ℚ K ^ 2)
          * ((2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R))) :=
          mul_le_mul_of_nonneg_right (hQiQ.trans hQle) hδ0
  refine ⟨∏ i, q i, hQpos, hQle, ?_⟩
  
  intro l
  have hwl : w l = ∑ j, ((ω.repr 1 j : ℤ) : ℝ)
      * ∑ l', ((ω.repr (ω j * ω l) l' : ℤ) : ℝ) * w l' := by
    rw [← hbil w 1 (ω l), one_mul, hself w l]
  choose z hz using hcommon l
  refine ⟨∑ j, ω.repr 1 j * z j, ?_⟩
  have heq : ((∏ i, q i : ℕ) : ℝ) * w l - ((∑ j, ω.repr 1 j * z j : ℤ) : ℝ)
      = ∑ j, ((ω.repr 1 j : ℤ) : ℝ) * (((∏ i, q i : ℕ) : ℝ)
          * (∑ l', ((ω.repr (ω j * ω l) l' : ℤ) : ℝ) * w l') - z j) := by
    rw [hwl]
    push_cast
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun j _ => by ring)
  have hE0 : 0 ≤ (2 / η) ^ (Module.finrank ℚ K ^ 2)
      * ((2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R))) := by positivity
  rw [heq]
  calc |∑ j, ((ω.repr 1 j : ℤ) : ℝ) * (((∏ i, q i : ℕ) : ℝ)
          * (∑ l', ((ω.repr (ω j * ω l) l' : ℤ) : ℝ) * w l') - z j)|
      ≤ ∑ j, |((ω.repr 1 j : ℤ) : ℝ) * (((∏ i, q i : ℕ) : ℝ)
          * (∑ l', ((ω.repr (ω j * ω l) l' : ℤ) : ℝ) * w l') - z j)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ j, |((ω.repr 1 j : ℤ) : ℝ)| * ((2 / η) ^ (Module.finrank ℚ K ^ 2)
          * ((2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R)))) := by
        refine Finset.sum_le_sum (fun j _ => ?_)
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left (hz j) (abs_nonneg _)
    _ = (∑ j, |((ω.repr 1 j : ℤ) : ℝ)|) * ((2 / η) ^ (Module.finrank ℚ K ^ 2)
          * ((2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R)))) := by
        rw [Finset.sum_mul]
    _ ≤ (1 + ∑ j, |((ω.repr 1 j : ℤ) : ℝ)|) * ((2 / η) ^ (Module.finrank ℚ K ^ 2)
          * ((2 / η) ^ Module.finrank ℚ K * (4 * ε / (η ^ 2 * R)))) :=
        mul_le_mul_of_nonneg_right (by linarith) hE0
    _ = (1 + ∑ j, |((ω.repr 1 j : ℤ) : ℝ)|)
          * (2 / η) ^ (Module.finrank ℚ K ^ 2 + Module.finrank ℚ K)
          * (4 * ε / (η ^ 2 * R)) := by
        rw [pow_add]; ring

theorem kai_v_typeI_extrapolate (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ C_E : ℝ, 1 ≤ C_E ∧
      ∀ (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
        (p₁ : Fin (Module.finrank ℚ K) → Fin a → ℝ) (X₇ ηG R M : ℝ),
        1 ≤ X₇ → 0 < ηG → ηG ≤ 1 → 1 ≤ R → R ^ 4 ≤ M ^ 3 →
        Real.exp (C_E * ((a : ℝ) + 1) ^ 3 * (Real.log X₇ + Real.log (1 / ηG) + 1)) ^ 4 ≤ M →
      ∀ (G : Finset (Ideal (NumberField.RingOfIntegers K)))
        (e : Ideal (NumberField.RingOfIntegers K) → NumberField.RingOfIntegers K)
        (k : Ideal (NumberField.RingOfIntegers K) → Fin a → Fin a → ℤ),
        ηG * R ^ Module.finrank ℚ K ≤ (G.card : ℝ) →
        (∀ 𝔡 ∈ G, R ^ Module.finrank ℚ K ≤ (Ideal.absNorm 𝔡 : ℝ) ∧ e 𝔡 ∈ 𝔡 ∧ e 𝔡 ≠ 0 ∧
          basisSupNorm ω (e 𝔡) ≤ X₇ * R ∧
          (∀ m i, |((k 𝔡 m i : ℤ) : ℝ)| ≤ X₇) ∧ Nil2Isotropic Bc ξ (k 𝔡) ∧
          ∀ (m : Fin a) (y : NumberField.RingOfIntegers K), ∃ z : ℤ,
            |∑ l, ((ω.repr (e 𝔡 * y) l : ℤ) : ℝ) * ∑ i, ((k 𝔡 m i : ℤ) : ℝ) * p₁ l i - z|
              ≤ X₇ * basisSupNorm ω y * R / M) →
        ∃ k' : Fin a → Fin a → ℤ,
          (∀ m i, |((k' m i : ℤ) : ℝ)| ≤
            Real.exp (C_E * ((a : ℝ) + 1) ^ 3 * (Real.log X₇ + Real.log (1 / ηG) + 1))) ∧
          Nil2Isotropic Bc ξ k' ∧
          Nil2Smooth p₁ k'
            (Real.exp (C_E * ((a : ℝ) + 1) ^ 3 * (Real.log X₇ + Real.log (1 / ηG) + 1))) M :=
by
  classical
  obtain ⟨C₃, hC₃, hadj⟩ := kai_v_ext_adjugate K ω
  obtain ⟨C₄, κ, hC₄, hmult⟩ := kai_v_ext_ideal_multiplicity K
  obtain ⟨C₆, hC₆, hvin⟩ := kai_v_ext_vinogradov_core K ω
  obtain ⟨c₃, hc₃⟩ := pow_unbounded_of_one_lt C₃ (by norm_num : (1 : ℝ) < 2)
  obtain ⟨c₄, hc₄⟩ := pow_unbounded_of_one_lt C₄ (by norm_num : (1 : ℝ) < 2)
  obtain ⟨c₆, hc₆⟩ := pow_unbounded_of_one_lt C₆ (by norm_num : (1 : ℝ) < 2)
  obtain ⟨c₁, hc₁⟩ : ∃ c₁ : ℕ, c₁ = 3 * Module.finrank ℚ K + 3 + c₄
      + (1 + c₃ + Module.finrank ℚ K) * κ + 1 := ⟨_, rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : ℕ, J = c₁ * 2 + 3 := ⟨_, rfl⟩
  obtain ⟨E1, hE1⟩ : ∃ E : ℕ,
      E = c₃ + (Module.finrank ℚ K + 1) + J * (Module.finrank ℚ K + 1) := ⟨_, rfl⟩
  obtain ⟨E2, hE2⟩ : ∃ E : ℕ, E = 8 + 1 + c₁ * 2 := ⟨_, rfl⟩
  obtain ⟨E3, hE3⟩ : ∃ E : ℕ, E = c₆ + (c₁ + 1) * (Module.finrank ℚ K ^ 2
      + Module.finrank ℚ K) + 2 + c₁ * 2 := ⟨_, rfl⟩
  obtain ⟨E4, hE4⟩ : ∃ E : ℕ, E = (c₁ + 1) * Module.finrank ℚ K ^ 2 + 1 := ⟨_, rfl⟩
  obtain ⟨N₀, hN₀⟩ : ∃ N : ℕ, N = E1 + E2 + E3 + E4 := ⟨_, rfl⟩
  have hN₀0 : (0 : ℝ) ≤ (N₀ : ℝ) := Nat.cast_nonneg _
  refine ⟨(N₀ : ℝ) + 1, by linarith, ?_⟩
  intro a b Bc ξ p₁ X₇ ηG R M hX₇ hηG hηG1 hR hRM hΞM G e k hGcard hG
  obtain ⟨Λ, hΛ_def⟩ : ∃ Λ : ℝ, Λ = Real.log X₇ + Real.log (1 / ηG) + 1 := ⟨_, rfl⟩
  rw [← hΛ_def] at hΞM ⊢
  obtain ⟨Ξ, hΞ_def⟩ : ∃ Ξ : ℝ, Ξ = Real.exp (((N₀ : ℝ) + 1) * ((a : ℝ) + 1) ^ 3 * Λ) :=
    ⟨_, rfl⟩
  rw [← hΞ_def] at hΞM ⊢
  
  have hX₇0 : 0 < X₇ := by linarith
  have hlogX : 0 ≤ Real.log X₇ := Real.log_nonneg hX₇
  have hinvG : 1 ≤ 1 / ηG := by rw [le_div_iff₀ hηG]; linarith
  have hlogG : 0 ≤ Real.log (1 / ηG) := Real.log_nonneg hinvG
  have hΛ1 : 1 ≤ Λ := by rw [hΛ_def]; linarith
