theorem kai_qwi_param_bounds (ν : ℕ) (δ : ℝ) (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
    (1 : ℝ) ≤ 5 * 2 ^ (2 * ν + 7) * (2 ^ (ν + 2)) ^ (ν * ν)
        * (1 + 7 * (2 * (ν : ℝ) + 1) * 2 ^ (3 * ν + 1)) ∧
    (1 : ℝ) ≤ ((5 * 2 ^ (2 * ν + 7) * (2 ^ (ν + 2)) ^ (ν * ν)
        * (1 + 7 * (2 * (ν : ℝ) + 1) * 2 ^ (3 * ν + 1))) / δ) ^ (4 * ν * ν + 14) ∧
    ∀ N : ℕ, 1 ≤ N →
