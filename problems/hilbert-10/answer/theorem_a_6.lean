    refine ⟨1, by rw [Nat.cast_one]; exact hT1, le_rfl, p₀, fun l => round (p₁ l),
      fun l l' => round (p₂ l l'), fun l => p₁ l - ((round (p₁ l) : ℤ) : ℝ),
      fun l l' => p₂ l l' - ((round (p₂ l l') : ℤ) : ℝ), ?_, ?_, ?_⟩
    · intro l
      beta_reduce
      have h := abs_sub_round (p₁ l)
