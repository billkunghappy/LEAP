noncomputable def kaiLPGenTransSum (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (α : NumberField.RingOfIntegers K)
    (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (T : Fin (NumberField.Units.rank K) → ℝ → ℝ)
    (S : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ → ℝ)
    (M : ℕ) (v : Fin M → (NumberField.RingOfIntegers K)ˣ) (x : ℝ) : ℝ :=
  ∑ i : Fin M,
    ∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
        P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
