        * kaiGen (P : Ideal (NumberField.RingOfIntegers K))) (hzne i P)
    simp only [hF]
    rw [← hpull2, ← h6]
    ring
  have hFsum : ∀ (i : Fin M) (P : {P : Ideal (NumberField.RingOfIntegers K) //
        P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x}),
      Summable (fun ml : (Fin (NumberField.Units.rank K) → ℤ) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) => F i P ml) := by
    intro i P
    have hpt : ∀ (ml : (Fin (NumberField.Units.rank K) → ℤ) ×
          ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ))
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        ‖(((Real.log (Ideal.absNorm
              (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ)
            * ((∏ j, cT j (ml.1 j)) * (∏ p, cS p (ml.2 p))))
          * ((starRingEnd ℂ) ((ξ hα.unit : ℂ))
              * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                  if η w then (if sgn w then (1 : ℂ) else -1) else 1)
              * kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
                  ((v i : NumberField.RingOfIntegers K)
                    * kaiGen (P : Ideal (NumberField.RingOfIntegers K))))‖
          ≤ |Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K)))|
              * ‖(∏ j, cT j (ml.1 j)) * (∏ p, cS p (ml.2 p))‖ := by
      intro ml ξ η
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, hZnorm ξ, hAnorm η, one_mul]
      exact mul_le_of_le_one_right (by positivity)
        (hchinorm ml.1 ml.2 ξ η _ (hzne i P))
    refine Summable.of_norm_bounded
      (hCsum.mul_left ((Ξ.card : ℝ)
        * (Fintype.card ({w : NumberField.InfinitePlace K // w.IsReal} → Bool) : ℝ)
        * |Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K)))|))
      (fun ml => ?_)
    simp only [hF]
    refine le_trans (norm_sum_le _ _) (le_trans (Finset.sum_le_sum (fun ξ _ =>
      le_trans (norm_sum_le _ _) (Finset.sum_le_sum (fun η _ => hpt ml ξ η)))) ?_)
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    exact le_of_eq (by ring)
  have main : ∀ ml : (Fin (NumberField.Units.rank K) → ℤ) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
      (∑ i : Fin M, ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
          P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
          F i P ml)
        = (M : ℂ) * kaiLPFreqSum K q H e α sgn cT cS Ξ ml x := by
    intro ml
    have hsplit : ∀ (i : Fin M) (P : {P : Ideal (NumberField.RingOfIntegers K) //
          P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x})
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
            ((v i : NumberField.RingOfIntegers K)
              * kaiGen (P : Ideal (NumberField.RingOfIntegers K)))
          = kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
              ((v i : NumberField.RingOfIntegers K))
            * kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
                (kaiGen (P : Ideal (NumberField.RingOfIntegers K))) :=
      fun i P ξ η => (hs4 ml.1 ml.2 ξ η).2.1 _ _ (Units.ne_zero _) (hgP P)
    have htrans : ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        (∑ i : Fin M, kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
            ((v i : NumberField.RingOfIntegers K)))
          = (M : ℂ) * (if ∀ y : (NumberField.RingOfIntegers K)ˣ,
              kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
                ((y : NumberField.RingOfIntegers K)) = 1 then (1 : ℂ) else 0) := by
      intro ξ η
      have hchar := kai_lp_transversal_char_sum H v hv
        (fun y : (NumberField.RingOfIntegers K)ˣ =>
          kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
            ((y : NumberField.RingOfIntegers K)))
        (by simpa using (hs4 ml.1 ml.2 ξ η).1)
        (fun a b => by
          simpa using (hs4 ml.1 ml.2 ξ η).2.1 (a : NumberField.RingOfIntegers K)
            (b : NumberField.RingOfIntegers K) (Units.ne_zero a) (Units.ne_zero b))
        (fun j => kai_lp_twist_at_basis_unit K q H e hHcong horth ml.1 ml.2 ξ η j)
      by_cases htriv : ∀ y : (NumberField.RingOfIntegers K)ˣ,
          kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
            ((y : NumberField.RingOfIntegers K)) = 1
      · rw [if_pos htriv, mul_one]
        exact hchar.1 htriv
      · rw [if_neg htriv, mul_zero]
        exact hchar.2 (by push_neg at htriv; exact htriv)
    simp only [hF, kaiLPFreqSum]
    rw [hswap, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun ξ _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun η _ => ?_)
    have step1 : (∑ i : Fin M, ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
            P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
          (((Real.log (Ideal.absNorm
                (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ)
              * ((∏ j, cT j (ml.1 j)) * (∏ p, cS p (ml.2 p))))
            * ((starRingEnd ℂ) ((ξ hα.unit : ℂ))
                * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                    if η w then (if sgn w then (1 : ℂ) else -1) else 1)
                * kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
                    ((v i : NumberField.RingOfIntegers K)
                      * kaiGen (P : Ideal (NumberField.RingOfIntegers K)))))
        = (((∏ j, cT j (ml.1 j)) * (∏ p, cS p (ml.2 p)))
              * (starRingEnd ℂ) ((ξ hα.unit : ℂ))
              * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                  if η w then (if sgn w then (1 : ℂ) else -1) else 1))
            * ((∑ i : Fin M, kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
                  ((v i : NumberField.RingOfIntegers K)))
              * ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
                    P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                      (Ideal.absNorm P : ℝ) ≤ x},
                  kaiHeckeTwist K q (kaiLPFreqType K H e ml.1 ml.2) ml.2 ξ η
                      (kaiGen (P : Ideal (NumberField.RingOfIntegers K)))
                    * ((Real.log (Ideal.absNorm
                        (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ)) := by
      rw [← hfactor]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun P _ => ?_))
      rw [hsplit i P ξ η]
      ring
    rw [step1, htrans ξ η]
    simp only [kaiLPFreqTerm, dif_pos hα]
    rw [tsum_fintype]
    ring
  refine ⟨?_, ?_⟩
  · exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hFreqSumBd
      (hCsum.mul_left ((Ξ.card : ℝ)
        * (Fintype.card ({w : NumberField.InfinitePlace K // w.IsReal} → Bool) : ℝ)
        * ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
            |Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K)))|))
  · rw [div_mul_eq_mul_div, eq_div_iff hD, mul_comm, hGTS]
    have e2 : ∀ i : Fin M,
        ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)
            * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
          * (∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                (Ideal.absNorm P : ℝ) ≤ x}, ((aR i P : ℝ) : ℂ))
          = ∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
                ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
              ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                  (Ideal.absNorm P : ℝ) ≤ x}, F i P ml := by
      intro i
      calc ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)
              * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
            * (∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                  (Ideal.absNorm P : ℝ) ≤ x}, ((aR i P : ℝ) : ℂ))
          = ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                (Ideal.absNorm P : ℝ) ≤ x},
              ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)
                * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
                * ((aR i P : ℝ) : ℂ) := Finset.mul_sum _ _ _
        _ = ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                (Ideal.absNorm P : ℝ) ≤ x},
              ∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
                  ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ), F i P ml :=
            Finset.sum_congr rfl (fun P _ => key i P)
        _ = ∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
                ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
              ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                  (Ideal.absNorm P : ℝ) ≤ x}, F i P ml :=
            (Summable.tsum_finsetSum (fun P _ => hFsum i P)).symm
    calc ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)
            * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
          * ((∑ i : Fin M, ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                (Ideal.absNorm P : ℝ) ≤ x}, aR i P : ℝ) : ℂ)
        = ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)
            * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
          * ∑ i : Fin M, ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                (Ideal.absNorm P : ℝ) ≤ x}, ((aR i P : ℝ) : ℂ) := by
          simp only [Complex.ofReal_sum]
      _ = ∑ i : Fin M, ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)
              * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
            * ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                  (Ideal.absNorm P : ℝ) ≤ x}, ((aR i P : ℝ) : ℂ) :=
          Finset.mul_sum _ _ _
      _ = ∑ i : Fin M, ∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
              ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
            ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                (Ideal.absNorm P : ℝ) ≤ x}, F i P ml :=
          Finset.sum_congr rfl (fun i _ => e2 i)
      _ = ∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
              ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
            ∑ i : Fin M, ∑ P : {P : Ideal (NumberField.RingOfIntegers K) //
              P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧
                (Ideal.absNorm P : ℝ) ≤ x}, F i P ml :=
          (Summable.tsum_finsetSum
            (fun i _ => summable_sum (fun P _ => hFsum i P))).symm
      _ = ∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
              ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
            (M : ℂ) * kaiLPFreqSum K q H e α sgn cT cS Ξ ml x :=
          tsum_congr (fun ml => main ml)
      _ = (M : ℂ) * ∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
              ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
            kaiLPFreqSum K q H e α sgn cT cS Ξ ml x := tsum_mul_left

theorem kai_lp_twist_trivial_of_eq_one (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (htr : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0)
    (h1 : ∀ y : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q y) →
        kaiHeckeTwist K q t l ξ η y = 1) :
    t = 0 ∧ l = 0 ∧ η = (fun _ => false) ∧ ξ = 1 :=
by
  classical
  
  have hlat : ∃ R : ℝ, 0 < R ∧
      ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        ∃ y : NumberField.RingOfIntegers K,
          (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
              |(NumberField.mixedEmbedding K (y : K)).1 w - z.1 w| ≤ R) ∧
          (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ‖(NumberField.mixedEmbedding K (y : K)).2 p - z.2 p‖ ≤ R) := by
    have hS0 : (0:ℝ) ≤ ∑ i, ‖NumberField.mixedEmbedding.latticeBasis K i‖ :=
      Finset.sum_nonneg fun i _ => norm_nonneg _
    refine ⟨1 + ∑ i, ‖NumberField.mixedEmbedding.latticeBasis K i‖, by linarith, ?_⟩
    intro z
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp
      (ZSpan.floor (NumberField.mixedEmbedding.latticeBasis K) z).property
    obtain ⟨y, hy⟩ : ∃ y : NumberField.RingOfIntegers K,
        NumberField.mixedEmbedding K (y : K)
          = ((ZSpan.floor (NumberField.mixedEmbedding.latticeBasis K) z :
              NumberField.mixedEmbedding.mixedSpace K)) := by
      refine ⟨∑ i, c i • NumberField.RingOfIntegers.basis K i, ?_⟩
      rw [← hc]
      simp only [NumberField.RingOfIntegers.coe_eq_algebraMap, map_sum, map_zsmul,
        ← NumberField.integralBasis_apply,
        ← NumberField.mixedEmbedding.latticeBasis_apply]
    have hd : NumberField.mixedEmbedding K (y : K) - z
        = -(ZSpan.fract (NumberField.mixedEmbedding.latticeBasis K) z) := by
      rw [ZSpan.fract_apply, hy, neg_sub]
    have hglob : ‖NumberField.mixedEmbedding K (y : K) - z‖
        ≤ 1 + ∑ i, ‖NumberField.mixedEmbedding.latticeBasis K i‖ := by
      rw [hd, norm_neg]
      have h := ZSpan.norm_fract_le (NumberField.mixedEmbedding.latticeBasis K) z
      linarith
    refine ⟨y, ?_, ?_⟩
    · intro w
      have h1 : (NumberField.mixedEmbedding K (y : K)).1 w - z.1 w
          = (NumberField.mixedEmbedding K (y : K) - z).1 w := rfl
      rw [h1, ← Real.norm_eq_abs]
      exact le_trans (norm_le_pi_norm _ w) (le_trans (norm_fst_le _) hglob)
    · intro p
      have h1 : ‖(NumberField.mixedEmbedding K (y : K)).2 p - z.2 p‖
          = ‖(NumberField.mixedEmbedding K (y : K) - z).2 p‖ := rfl
      rw [h1]
      exact le_trans (norm_le_pi_norm _ p) (le_trans (norm_snd_le _) hglob)
  
  obtain ⟨R, hR0, hcov⟩ : ∃ R' : ℝ, 0 < R' ∧
      ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        ∃ x : NumberField.RingOfIntegers K, x - 1 ∈ q ∧
          (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
              |(NumberField.mixedEmbedding K (x : K)).1 w - z.1 w| ≤ R') ∧
          (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ‖(NumberField.mixedEmbedding K (x : K)).2 p - z.2 p‖ ≤ R') := by
    obtain ⟨R₀, hR₀, hcov0⟩ := hlat
    set m : ℕ := Ideal.absNorm q with hmdef
    have hmq : (m : NumberField.RingOfIntegers K) ∈ q := Ideal.absNorm_mem q
    have hm0 : 0 < m := by
      have hb : q ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
      exact Nat.pos_of_ne_zero (fun h => hb (Ideal.absNorm_eq_zero_iff.mp h))
    have hmRpos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm0
    have hmR : (m : ℝ) ≠ 0 := ne_of_gt hmRpos
    have hmC : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hm0.ne'
    refine ⟨(m : ℝ) * R₀, mul_pos hmRpos hR₀, ?_⟩
    intro z
    obtain ⟨y, hy1, hy2⟩ :=
      hcov0 ((fun w => (z.1 w - 1) / (m : ℝ)), (fun p => (z.2 p - 1) / (m : ℂ)))
    have hemb : NumberField.mixedEmbedding K
        ((1 + (m : NumberField.RingOfIntegers K) * y : NumberField.RingOfIntegers K) : K)
        = 1 + (m : NumberField.mixedEmbedding.mixedSpace K)
            * NumberField.mixedEmbedding K (y : K) := by
      have h1 : ((1 + (m : NumberField.RingOfIntegers K) * y :
          NumberField.RingOfIntegers K) : K) = 1 + (m : K) * (y : K) := by
        push_cast; ring
      rw [h1, map_add, map_mul, map_one, map_natCast]
    refine ⟨1 + (m : NumberField.RingOfIntegers K) * y, ?_, ?_, ?_⟩
    · rw [add_sub_cancel_left]
      exact Ideal.mul_mem_right y q hmq
    · intro w
      have hx : (NumberField.mixedEmbedding K
          ((1 + (m : NumberField.RingOfIntegers K) * y :
            NumberField.RingOfIntegers K) : K)).1 w
          = 1 + (m : ℝ) * (NumberField.mixedEmbedding K (y : K)).1 w := by
        rw [hemb]; simp
      rw [hx]
      have hid : 1 + (m : ℝ) * (NumberField.mixedEmbedding K (y : K)).1 w - z.1 w
          = (m : ℝ) * ((NumberField.mixedEmbedding K (y : K)).1 w
              - (z.1 w - 1) / (m : ℝ)) := by
        rw [mul_sub, mul_div_cancel₀ _ hmR]; ring
      rw [hid, abs_mul, abs_of_pos hmRpos]
      exact mul_le_mul_of_nonneg_left (hy1 w) hmRpos.le
    · intro p
      have hx : (NumberField.mixedEmbedding K
          ((1 + (m : NumberField.RingOfIntegers K) * y :
            NumberField.RingOfIntegers K) : K)).2 p
          = 1 + (m : ℂ) * (NumberField.mixedEmbedding K (y : K)).2 p := by
        rw [hemb]; simp
      rw [hx]
      have hid : 1 + (m : ℂ) * (NumberField.mixedEmbedding K (y : K)).2 p - z.2 p
          = (m : ℂ) * ((NumberField.mixedEmbedding K (y : K)).2 p
              - (z.2 p - 1) / (m : ℂ)) := by
        rw [mul_sub, mul_div_cancel₀ _ hmC]; ring
      rw [hid, norm_mul, Complex.norm_natCast]
      exact mul_le_mul_of_nonneg_left (hy2 p) hmRpos.le
  
  have hlogest : ∀ (ρ r x : ℝ), 0 < ρ → 0 ≤ r → 2 * r ≤ ρ → |x - ρ| ≤ r →
      |Real.log x - Real.log ρ| ≤ 2 * r / ρ := by
    intro ρ r x hρ hr h2 hx
    obtain ⟨hxlo, hxhi⟩ := abs_le.mp hx
    have hxpos : 0 < x := by linarith
    have h2x : ρ ≤ 2 * x := by linarith
    have hA : Real.log (x / ρ) ≤ x / ρ - 1 :=
      Real.log_le_sub_one_of_pos (div_pos hxpos hρ)
    have hB : Real.log (ρ / x) ≤ ρ / x - 1 :=
      Real.log_le_sub_one_of_pos (div_pos hρ hxpos)
    rw [Real.log_div hxpos.ne' hρ.ne', div_sub_one hρ.ne'] at hA
    rw [Real.log_div hρ.ne' hxpos.ne', div_sub_one hxpos.ne'] at hB
    have hAmul : (Real.log x - Real.log ρ) * ρ ≤ x - ρ := (le_div_iff₀ hρ).mp hA
    have hBmul : (Real.log ρ - Real.log x) * x ≤ ρ - x := (le_div_iff₀ hxpos).mp hB
    have hs8 : (Real.log x - Real.log ρ) * ρ ≤ 2 * r := by linarith
    have hs9 : (Real.log ρ - Real.log x) * ρ ≤ 2 * r := by
      by_cases hu : Real.log ρ - Real.log x ≤ 0
      · nlinarith [mul_nonneg (neg_nonneg.mpr hu) hρ.le]
      · push_neg at hu
        nlinarith [mul_le_mul_of_nonneg_left h2x hu.le]
    rw [abs_le]
    constructor
    · rw [neg_le, le_div_iff₀ hρ]
      linarith
    · rw [le_div_iff₀ hρ]
