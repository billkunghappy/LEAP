            MeasureTheory.volume := by
          have h := intervalIntegral.intervalIntegrable_rpow' (a := (0:ℝ)) (b := (1:ℝ))
            (r := s.re / 2 - 1) (by linarith)
          exact ((intervalIntegrable_iff_integrableOn_Ioc_of_le
            (zero_le_one : (0:ℝ) ≤ 1)).mp h).const_mul _
        have hcontOn : ContinuousOn
            (fun t : ℝ => t ^ (s.re - 1) * max (-(Real.log t)) 0) (Set.Ioc (0:ℝ) 1) := by
          have h1 : ContinuousOn (fun t : ℝ => t ^ (s.re - 1)) (Set.Ioc (0:ℝ) 1) :=
            ContinuousOn.rpow_const continuousOn_id (fun x hx => Or.inl (ne_of_gt hx.1))
          have hsub : Set.Ioc (0:ℝ) 1 ⊆ ({0} : Set ℝ)ᶜ := by
            intro x hx
            simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
            exact ne_of_gt hx.1
          have h2 : ContinuousOn (fun t : ℝ => -(Real.log t)) (Set.Ioc (0:ℝ) 1) :=
            (Real.continuousOn_log.mono hsub).neg
          have h3 : ContinuousOn (fun t : ℝ => max (-(Real.log t)) 0) (Set.Ioc (0:ℝ) 1) :=
