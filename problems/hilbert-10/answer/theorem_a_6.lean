    have intTo : IntervalIntegrable
        (fun u : ℝ => dslope f ((c : ℝ) : ℂ) ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I))
        MeasureTheory.volume a b := by
      apply ContinuousOn.intervalIntegrable
