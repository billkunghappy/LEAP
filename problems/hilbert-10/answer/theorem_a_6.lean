  have V3 : ∀ (u : ι → ℝ) (ρ : ℝ),
      max ((g (fun i => u i + ρ)).im) 0 = max ((g u).im) 0 := by
    intro u ρ; rw [hginv u ρ]
  have V4 : ∀ (u : ι → ℝ) (ρ : ℝ),
      max (-(g (fun i => u i + ρ)).im) 0 = max (-(g u).im) 0 := by
    intro u ρ; rw [hginv u ρ]
