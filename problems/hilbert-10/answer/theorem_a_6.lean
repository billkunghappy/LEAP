  push_neg at hNT
  obtain ⟨hσ0, hσ1, hε0, hεσ, hσN, hcardσ, hθbd, hq₀all⟩ := hbig N hN hNT
  have hG := kai_qwi_good_differences ν N δ Ω p₀ p₁ p₂ hN hδ hΩ hS
  obtain ⟨q₀, hq₀1, hq₀le, hq₀ap⟩ := kai_qwi_quadratic_denominator ν N
    (fun l l' => p₂ l l' + p₂ l' l) (δ ^ 2 / 2 ^ (ν + 1))
    (2 ^ ν / (δ ^ 2 * ((2 * N + 1 : ℕ) : ℝ)))
    (@Finset.filter (Fin ν → ℤ)
